<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PRO" style="id">- Biblica® Open Nepali Contemporary Version</book>
  
  <para style="h">हितोपदेश</para>
  <para style="toc1">हितोपदेशको पुस्तक</para>
  <para style="toc2">हितोपदेश</para>
  <para style="toc3">हितो</para>
  <para style="mt1">हितोपदेशको पुस्तक</para>
  <chapter number="1" style="c" sid="PRO 1" />
  <para style="ms1">उद्देश्य र विषय</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 1:1" />इस्राएलका राजा, दावीदका पुत्र, सोलोमनका हितोपदेशहरू:<verse eid="PRO 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 1:2" />बुद्धि र अनुशासन प्राप्‍त गर्नका निम्ति,</para>
  <para style="q2" vid="PRO 1:2">अन्‍तर्दृष्‍टिका वचनको समझ प्राप्‍त गर्नका निम्ति,<verse eid="PRO 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 1:3" />विवेकी आचरणको अनुशासन प्राप्‍त गर्नको निम्ति</para>
  <para style="q2" vid="PRO 1:3">जे धार्मिक, न्यायी र निष्पक्ष छ, त्यो गर्नको निम्ति,<verse eid="PRO 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 1:4" />सोझाहरूलाई<note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="ft" closed="false">मूल भाषामा प्रयोग गरिएको शब्द </char><char style="fq" closed="false">सोझा </char><char style="ft" closed="false">ले हितोपदेशमा सहजै बहकाउन सकिने, नैतिक दिशामा नभएको र दुष्‍टतातिर झुकेको व्यक्तिलाई जनाउँदछ।</char></note> समझदार,</para>
  <para style="q2" vid="PRO 1:4">जवानहरूलाई ज्ञान र स्वविवेक दिनका निम्ति—<verse eid="PRO 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 1:5" />बुद्धिमान्‌ले सुनोस् र तिनीहरूका ज्ञान बढाऊन्;</para>
  <para style="q2" vid="PRO 1:5">र विवेकशील व्यक्तिलाई अगुवाइ मिलोस्—<verse eid="PRO 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 1:6" />हितोपदेश र दृष्‍टान्तहरू,</para>
  <para style="q2" vid="PRO 1:6">बुद्धिमान्‌का भनाइ र गहिरा-गहिरा वचनहरू बुझ्नका निम्ति।<verse eid="PRO 1:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 1:7" />याहवेहको भय ज्ञानको सुरुवात हो,</para>
  <para style="q2" vid="PRO 1:7">तर मूर्खले<note caller="+" style="f"><char style="fr" closed="false">1:7 </char><char style="ft" closed="false">हितोपदेश र पुरानो करारका धेरै स्थानहरूमा अनुवाद गरिएको मूल शब्द </char><char style="fq" closed="false">मूर्ख </char><char style="ft" closed="false">ले नैतिकताको कमी भएको व्यक्तिलाई जनाउँदछ।</char></note> चाहिँ बुद्धि र अनुशासनलाई तुच्छ ठान्दछ।<verse eid="PRO 1:7" /></para>
  <para style="ms1">प्रस्तावना: बुद्धिलाई अँगाल्ने सल्‍लाह</para>
  <para style="s1">पापी मानिसका निमन्त्रणा विरुद्ध चेतावनी</para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 1:8" />हे मेरा छोराछोरी,<note caller="+" style="f"><char style="fr" closed="false">1:8 </char><char style="ft" closed="false">मूल भाषामा </char><char style="fqa" closed="false">छोरा</char></note> आफ्ना बुबाको शिक्षा सुन</para>
  <para style="q2" vid="PRO 1:8">र आफ्नी आमाको शिक्षालाई नत्याग।<verse eid="PRO 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 1:9" />ती तिम्रा शिरका निम्ति शोभायमान मुकुट</para>
  <para style="q2" vid="PRO 1:9">र तिम्रा गलामा सम्मानको हार हुन्।<verse eid="PRO 1:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 1:10" />हे मेरा छोराछोरी, यदि पापीहरूले तिमीहरूलाई उक्साए भने,</para>
  <para style="q2" vid="PRO 1:10">तिनीहरूसँग नलाग!<verse eid="PRO 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 1:11" />तिनीहरूले यसो भन्लान्, “हामीसित आऊ,</para>
  <para style="q2" vid="PRO 1:11">हामी निर्दोषको रक्तपात गर्न ढुकेर बसौँ,”</para>
  <para style="q2" vid="PRO 1:11">हामी कुनै निर्दोषलाई आक्रमण गरौँ;<verse eid="PRO 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 1:12" />हामी तिनीहरूलाई चिहानले जस्तै जिउँदै निलौँ;</para>
  <para style="q2" vid="PRO 1:12">र सबै पातालमा जानेहरूलाई जस्तै पूरै निलौँ,<verse eid="PRO 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 1:13" />हामी सबै किसिमका मूल्यवान् कुराहरू पाउनेछौँ;</para>
  <para style="q2" vid="PRO 1:13">र हाम्रा घरहरूलाई लुटका सामानहरूले भर्नेछौँ;<verse eid="PRO 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 1:14" />तिमी हाम्रो साझेदार बन,</para>
  <para style="q2" vid="PRO 1:14">यो धन हामी सबैको हुनेछ।<verse eid="PRO 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 1:15" />हे मेरो छोराछोरी, तिनीहरूसित नजाओ;</para>
  <para style="q2" vid="PRO 1:15">तिनीहरूका मार्गमा खुट्टै नटेक!<verse eid="PRO 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 1:16" />किनकि तिनीहरूका खुट्टा दुष्‍ट काम गर्न हतारिन्छन्,</para>
  <para style="q2" vid="PRO 1:16">तिनीहरू रक्तपात गर्न अग्रसर हुन्छन्।<verse eid="PRO 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 1:17" />चराहरूले देख्ने गरी</para>
  <para style="q2" vid="PRO 1:17">जाल बिछ्यानु कति निरर्थक हुन्छ!<verse eid="PRO 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 1:18" />यी मानिसहरू आफ्नै रगतको निम्ति ढुक्दछन्,</para>
  <para style="q2" vid="PRO 1:18">तिनीहरूले आफैँलाई पासो थाप्दछन्!<verse eid="PRO 1:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 1:19" />बेइमानीसित नाफा कमाउने सबैका मार्गहरू यस्तै हुन्छन्,</para>
  <para style="q2" vid="PRO 1:19">जसले यो लिन्छ, यसले तिनीहरू सबैको जीवन लिन्छ।<verse eid="PRO 1:19" /></para>
  <para style="s1">बुद्धिको हप्काइ</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 1:20" />बुद्धि बाहिर खुल्‍ला सडकमा चर्को सोरले कराउँछे;</para>
  <para style="q2" vid="PRO 1:20">त्यसले सार्वजनिक चोकहरूमा आफ्नो आवाज उचाल्छे;<verse eid="PRO 1:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 1:21" />व्यस्त सडकका अग्ला स्थानमा त्यसले पुकार्दछे;</para>
  <para style="q2" vid="PRO 1:21">सहरका मूलढोकाहरूमा त्यसले आफ्नो भाषण गर्छे।<verse eid="PRO 1:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 1:22" />तिमी सोझाहरूले कहिलेसम्म आफ्ना मूर्खतालाई प्रेम गरिरहन्छौ?</para>
  <para style="q2" vid="PRO 1:22">कहिलेसम्म गिल्‍ला गर्नेहरू गिल्‍ला गर्नमै रमाउँछौ?</para>
  <para style="q2" vid="PRO 1:22">र मूर्खहरूले ज्ञानलाई घृणा गरिरहन्छौ?<verse eid="PRO 1:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 1:23" />मेरो हप्काइ सुनेर पश्‍चात्ताप गर,</para>
  <para style="q2" vid="PRO 1:23">म आफ्ना विचारहरू तिमीहरूलाई खन्याउनेछु;</para>
  <para style="q2" vid="PRO 1:23">मेरा शिक्षाहरू तिमीहरूलाई बुझाउनेछु।<verse eid="PRO 1:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 1:24" />तर मैले बोलाउँदा तिमीहरूले मलाई सुन्‍न नचाहेकाले,</para>
  <para style="q2" vid="PRO 1:24">र मैले आफ्ना हातहरू फैलाउँदा कसैले ध्यान नदिएकाले,<verse eid="PRO 1:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 1:25" />तिमीहरूले मेरा सबै सल्‍लाहलाई तुच्छ ठानेका हुनाले</para>
  <para style="q2" vid="PRO 1:25">र मेरो हप्काइलाई स्वीकार नगरेका हुनाले,<verse eid="PRO 1:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 1:26" />यसको बदलामा तिमीहरूमाथि प्रकोप आउँदा म हाँस्‍नेछु;</para>
  <para style="q2" vid="PRO 1:26">विपत्तिले तिमीहरूलाई छोप्दा म खिल्‍ली उडाउनेछु;<verse eid="PRO 1:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 1:27" />विपत्तिले आँधीजस्तै तिमीहरूलाई उडाउँदा,</para>
  <para style="q2" vid="PRO 1:27">जब भुमरीजस्तै आपत्ति तिमीहरूमाथि मडारिएर आउँछ;</para>
  <para style="q2" vid="PRO 1:27">जब सङ्कष्‍ट र दुःखले तिमीहरूलाई डुबाउँछन्।<verse eid="PRO 1:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 1:28" />“तब तिनीहरूले मलाई पुकार्नेछन्, तर म जवाफ दिनेछैनँ;</para>
  <para style="q2" vid="PRO 1:28">तिनीहरूले मलाई खोज्नेछन्, तर मलाई भेट्टाउनेछैनन्।”<verse eid="PRO 1:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 1:29" />तिनीहरूले ज्ञानलाई घृणा गरेका हुनाले,</para>
  <para style="q2" vid="PRO 1:29">र याहवेहप्रति भय मान्‍न नचाहेका हुनाले;<verse eid="PRO 1:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 1:30" />तिनीहरूले मेरो सल्‍लाह ग्रहण नगरेका,</para>
  <para style="q2" vid="PRO 1:30">र मेरो हप्काइलाई तिरस्कार गरेका हुनाले,<verse eid="PRO 1:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 1:31" />तिनीहरूले आफ्ना कामको फलबाट खानेछन्</para>
  <para style="q2" vid="PRO 1:31">र आफ्ना कपटकै योजनाहरूका फलले तिनीहरू भरिनेछन्।<verse eid="PRO 1:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 1:32" />आफ्नै पथभ्रष्‍टताले गर्दा सोझाहरू मर्नेछन्,</para>
  <para style="q2" vid="PRO 1:32">र मूर्खहरूको आफ्नै लापर्बाहीले तिनीहरूलाई नाश गर्नेछ।<verse eid="PRO 1:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 1:33" />तर जजसले मेरो कुरामा ध्यान दिन्छन्, उनीहरू सुरक्षित रहनेछन्,</para>
  <para style="q2" vid="PRO 1:33">र विपत्तिको डरबाट ढुक्‍क भई रहनेछन्।<verse eid="PRO 1:33" /></para>
  <chapter eid="PRO 1" />
  <chapter number="2" style="c" sid="PRO 2" />
  <para style="s1">बुद्धिबाट प्राप्‍त हुने नैतिक लाभहरू</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 2:1" />हे मेरो छोरा, “यदि तिमीले मेरो वचन मान्यौ</para>
  <para style="q2" vid="PRO 2:1">र मेरा आज्ञाहरू आफूभित्र सावधानीसाथ राख्यौ भने,<verse eid="PRO 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 2:2" />आफ्नो कान बुद्धिका कुरामा फर्कायौ</para>
  <para style="q2" vid="PRO 2:2">र तिम्रो हृदयलाई समझशक्तितिर लगायौ भने,<verse eid="PRO 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 2:3" />साँच्‍चै, तिमीले अन्तर्दृष्‍टिको निम्ति आह्वान गर्‍यौ भने,</para>
  <para style="q2" vid="PRO 2:3">र समझशक्तिको निम्ति जोडसित पुकार्‍यौ भने,<verse eid="PRO 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 2:4" />र तिमीले त्यसलाई चाँदीझैँ चाहना गर्‍यौ भने,</para>
  <para style="q2" vid="PRO 2:4">अनि लुकाइएको गाडधनजस्तै त्यसलाई खोज्यौ भने,<verse eid="PRO 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 2:5" />तब तिमीले याहवेहप्रति भय मान्‍नुको अर्थ बुझ्नेछौ,</para>
  <para style="q2" vid="PRO 2:5">र परमेश्‍वरको ज्ञान प्राप्‍त गर्नेछौ।”<verse eid="PRO 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 2:6" />किनकि याहवेहले बुद्धि दिनुहुन्छ,</para>
  <para style="q2" vid="PRO 2:6">अनि उहाँकै मुखबाट ज्ञान र समझशक्तिका कुराहरू निस्कन्छन्।<verse eid="PRO 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 2:7" />उहाँले धर्मीहरूका निम्ति सफलता साँचेर राख्नुहुन्छ;</para>
  <para style="q2" vid="PRO 2:7">निर्दोष जीवन जिउनेहरूका निम्ति उहाँ ढाल हुनुहुन्छ,<verse eid="PRO 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 2:8" />किनकि उहाँले न्यायका मार्गको रक्षा गर्नुहुन्छ,</para>
  <para style="q2" vid="PRO 2:8">र उहाँले आफ्ना विश्‍वासयोग्य जनहरूका मार्ग सुरक्षित राख्नुहुन्छ।<verse eid="PRO 2:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 2:9" />तब तिमीले धार्मिकता, न्याय र निष्पक्षता के हो,</para>
  <para style="q2" vid="PRO 2:9">हो, असल मार्ग के हो, त्यो बुझ्नेछौ।<verse eid="PRO 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 2:10" />किनकि बुद्धि तिम्रो हृदयमा पस्‍नेछ,</para>
  <para style="q2" vid="PRO 2:10">र ज्ञानचाहिँ तिम्रो प्राणको निम्ति आनन्ददायक हुनेछ।<verse eid="PRO 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 2:11" />विवेकले तिमीलाई हेरचाह गर्नेछ,</para>
  <para style="q2" vid="PRO 2:11">र समझशक्तिले तिम्रो रक्षा गर्नेछ।<verse eid="PRO 2:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 2:12" />बुद्धिले तिमीलाई दुष्‍ट मानिसको मार्ग,</para>
  <para style="q2" vid="PRO 2:12">र भ्रष्‍ट कुरा गर्ने मानिसबाट जोगाउनेछ,<verse eid="PRO 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 2:13" />जसले अन्धकारका मार्गहरूमा हिँड्नका लागि</para>
  <para style="q2" vid="PRO 2:13">सीधा मार्गहरू त्यागेका छन्,<verse eid="PRO 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 2:14" />जो खराबी गर्नमा रमाउँछन्,</para>
  <para style="q2" vid="PRO 2:14">र दुष्‍टहरूका भ्रष्‍टतामा आनन्दित हुन्छन्,<verse eid="PRO 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 2:15" />जसका चालहरू टेढा,</para>
  <para style="q2" vid="PRO 2:15">र आफ्ना मार्गहरूमा कुटिल छन्।<verse eid="PRO 2:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 2:16" />बुद्धिले तिमीलाई व्यभिचारिणी स्त्रीबाट</para>
  <para style="q2" vid="PRO 2:16">र स्वेच्छाचारी स्त्रीका लोभ्याउने कुराहरूबाट जोगाउनेछ,<verse eid="PRO 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 2:17" />जुन स्त्रीले आफ्नो युवा अवस्थाको जीवन साथीलाई त्यागेकी छे,</para>
  <para style="q2" vid="PRO 2:17">र त्यसले परमेश्‍वरसित बाँधेको करारलाई इन्कार गरेकी छे।<verse eid="PRO 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 2:18" />निश्‍चय नै त्यसको घरले मृत्युतिर</para>
  <para style="q2" vid="PRO 2:18">र त्यसका मार्गहरूले मृतकहरूका आत्मातिर पुर्‍याउँछन्।<verse eid="PRO 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 2:19" />त्यससित जाने पुरुष फर्किआउँदैन,</para>
  <para style="q2" vid="PRO 2:19">न त जीवनको मार्ग नै प्राप्‍त गर्छ।<verse eid="PRO 2:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 2:20" />यसरी तिमी असल मानिसहरूका कदम अनुसरण गर्नेछौ,</para>
  <para style="q2" vid="PRO 2:20">र धर्मी मानिसको बाटोमा लागिरहनेछौ।<verse eid="PRO 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 2:21" />किनकि धर्मीहरू देशमा बास गर्नेछन्,</para>
  <para style="q2" vid="PRO 2:21">र निर्दोष मानिसहरू त्यहाँ रहिरहनेछन्,<verse eid="PRO 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 2:22" />तर दुष्‍टहरूचाहिँ देशबाट हटाइनेछन्,</para>
  <para style="q2" vid="PRO 2:22">र विश्‍वासघातीहरू त्यहाँबाट जरैसमेत उखालिनेछन्।<verse eid="PRO 2:22" /></para>
  <chapter eid="PRO 2" />
  <chapter number="3" style="c" sid="PRO 3" />
  <para style="s1">बुद्धिबाट प्राप्‍त हुने लाभहरू</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 3:1" />हे मेरो छोराछोरी, मेरो शिक्षालाई नबिर्स;</para>
  <para style="q2" vid="PRO 3:1">तर मेरा आज्ञाहरूलाई आफ्नो हृदयमा लुकाइराख;<verse eid="PRO 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 3:2" />किनकि यसले तिमीलाई दीर्घायु बनाउनेछ,</para>
  <para style="q2" vid="PRO 3:2">र तिम्रा लागि शान्ति र उन्‍नति ल्याउनेछ।<verse eid="PRO 3:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 3:3" />प्रेम र विश्‍वासयोग्यताले तिमीलाई कहिल्यै नछोडून्,</para>
  <para style="q2" vid="PRO 3:3">ती तिमीले आफ्नो गलामा बाँधिराख,</para>
  <para style="q2" vid="PRO 3:3">ती तिमीले आफ्नो हृदयको पाटीमा लेखिराख।<verse eid="PRO 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 3:4" />तब तिमीले परमेश्‍वर र मानिसहरूको दृष्‍टिमा</para>
  <para style="q2" vid="PRO 3:4">निगाह र असल नाम कमाउनेछौ।<verse eid="PRO 3:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 3:5" />तिम्रो सम्पूर्ण हृदयले याहवेहमाथि भरोसा राख</para>
  <para style="q2" vid="PRO 3:5">र तिम्रो आफ्नै समझशक्तिमाथि भर नपर!<verse eid="PRO 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 3:6" />आफ्ना सबै मार्गहरू उहाँलाई सुम्प,</para>
  <para style="q2" vid="PRO 3:6">र उहाँले तिम्रा मार्गहरू सीधा तुल्याइदिनुहुनेछ।<verse eid="PRO 3:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 3:7" />आफ्नै दृष्‍टिमा बुद्धिमान् नबन;</para>
  <para style="q2" vid="PRO 3:7">याहवेहको डर मान, र दुष्कर्मलाई त्याग!<verse eid="PRO 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 3:8" />यसले तिम्रो शरीरलाई स्वस्थ तुल्याउनेछ</para>
  <para style="q2" vid="PRO 3:8">र तिम्रा हड्डीहरूलाई पोषण दिनेछ।<verse eid="PRO 3:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 3:9" />आफ्ना धनसम्पत्ति</para>
  <para style="q2" vid="PRO 3:9">र आफ्ना सबै उब्जनीको अगौटे फलले याहवेहलाई आदर गर।<verse eid="PRO 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 3:10" />तब तिम्रा ढुकुटीहरू भरिएर पोखिनेछन्,</para>
  <para style="q2" vid="PRO 3:10">र तिम्रा घ्याम्पाहरू नयाँ दाखमद्यले भरिपूर्ण हुनेछन्।<verse eid="PRO 3:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 3:11" />हे मेरा छोराछोरी, याहवेहको अनुशासनलाई तुच्छ नठान,</para>
  <para style="q2" vid="PRO 3:11">र उहाँको हप्कीप्रति चित्त नदुःखाऊ;<verse eid="PRO 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 3:12" />किनकि जसलाई याहवेहले प्रेम गर्नुहुन्छ, उसलाई नै उहाँले अनुशासन गर्नुहुन्छ,</para>
  <para style="q2" vid="PRO 3:12">जसरी बुबाले आफ्नो प्यारो छोरालाई ताडना दिन्छन्।<verse eid="PRO 3:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 3:13" />त्यो मानिस धन्यको हो, जसले बुद्धि प्राप्‍त गर्छ,</para>
  <para style="q2" vid="PRO 3:13">र जसले समझशक्ति प्राप्‍त गर्छ,<verse eid="PRO 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 3:14" />किनकि यो चाँदीभन्दा लाभदायक हुन्छ,</para>
  <para style="q2" vid="PRO 3:14">र यसले सुनभन्दा उत्तम प्रतिफल दिन्छ।<verse eid="PRO 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 3:15" />बुद्धि माणिकहरूभन्दा पनि मूल्यवान् हुन्छ,</para>
  <para style="q2" vid="PRO 3:15">तिमीले इच्छा गरेका कुनै पनि थोक यससँग तुलना गर्न सकिँदैन।<verse eid="PRO 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 3:16" />यसको दाहिने हातमा दीर्घायु छ,</para>
  <para style="q2" vid="PRO 3:16">र यसको देब्रे हातमा धनसम्पत्ति र सम्मान छन्।<verse eid="PRO 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 3:17" />यसका मार्गहरू आनन्ददायक हुन्छन्,</para>
  <para style="q2" vid="PRO 3:17">र यसका सबै बाटाहरू शान्तिका हुन्छन्।<verse eid="PRO 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 3:18" />यसलाई पक्रिरहनेहरूका निम्ति यो जीवनको रूख हो,</para>
  <para style="q2" vid="PRO 3:18">यसलाई अपनाउनेहरूका लागि आशिष् हो।<verse eid="PRO 3:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 3:19" />बुद्धिद्वारा नै याहवेहले पृथ्वीको जग बसाल्नुभयो,</para>
  <para style="q2" vid="PRO 3:19">समझशक्तिद्वारा उहाँले स्वर्गहरूलाई ठिक ठाउँमा राख्नुभयो,<verse eid="PRO 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 3:20" />उहाँको ज्ञानद्वारा सागरका गहिराइहरू भाग-भाग भए,</para>
  <para style="q2" vid="PRO 3:20">र बादलहरूले शीत वृष्‍टि गरे।<verse eid="PRO 3:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 3:21" />हे मेरो छोरोछोरी, बुद्धि र समझशक्तिलाई तिम्रो दृष्‍टिबाट जान नदेऊ,</para>
  <para style="q2" vid="PRO 3:21">उचित न्याय र विवेकलाई जोगाइराख,<verse eid="PRO 3:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 3:22" />ती तिम्रा निम्ति जीवन,</para>
  <para style="q2" vid="PRO 3:22">र तिम्रा गलामा शोभायमान गहनाजस्तै हुनेछन्।<verse eid="PRO 3:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 3:23" />तब तिमी आफ्नो मार्गमा सुरक्षित भई हिँड्नेछौँ,</para>
  <para style="q2" vid="PRO 3:23">तब तिम्रा खुट्टाले ठेस खानेछैन।<verse eid="PRO 3:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 3:24" />जब तिमी ढल्किनेछौ, तब तिमीलाई डर लाग्नेछैन,</para>
  <para style="q2" vid="PRO 3:24">जब तिमी ढल्किनेछौ, तिमीलाई मिठो निद्रा लाग्नेछ।<verse eid="PRO 3:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 3:25" />तिमीलाई अचानक आउने विपत्तिको</para>
  <para style="q2" vid="PRO 3:25">अथवा दुष्‍टमाथि आइपर्ने विनाशको डर हुनेछैन।<verse eid="PRO 3:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 3:26" />किनकि याहवेह तिम्रो भरोसा हुनुहुनेछ,</para>
  <para style="q2" vid="PRO 3:26">र उहाँले तिम्रो खुट्टाहरूलाई पासोमा फस्‍नदेखि बचाउनुहुनेछ।<verse eid="PRO 3:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 3:27" />जसलाई भलाइ गर्नुपर्ने हो,</para>
  <para style="q2" vid="PRO 3:27">तिम्रो बल होउन्जेल त्यसलाई नरोक।<verse eid="PRO 3:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 3:28" />तिमीसित दिनलाई केही कुरा छ भने,</para>
  <para style="q2" vid="PRO 3:28">आफ्नो छिमेकीलाई “पछि आऊ,</para>
  <para style="q2" vid="PRO 3:28">म तिमीलाई भोलि दिनेछु” भनी नभन!<verse eid="PRO 3:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 3:29" />आफ्नो नजिकमा भरपर्दो गरी बस्‍ने छिमेकीको विरुद्धमा</para>
  <para style="q2" vid="PRO 3:29">षड्यन्त्र नरच।<verse eid="PRO 3:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 3:30" />कारणविना कुनै मानिसलाई दोष नलगाऊ,</para>
  <para style="q2" vid="PRO 3:30">जसले तिम्रो कुनै हानि गरेको छैन।<verse eid="PRO 3:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 3:31" />हिंसात्मक मानिसप्रति डाही नबन,</para>
  <para style="q2" vid="PRO 3:31">अथवा त्यसको कुनै पनि बाटो नरोज।<verse eid="PRO 3:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 3:32" />किनकि याहवेहले दुष्‍ट मानिसलाई घृणा गर्नुहुन्छ,</para>
  <para style="q2" vid="PRO 3:32">तर धर्मीहरूलाई आफ्नो विश्‍वासपात्र बनाउनुहुन्छ।<verse eid="PRO 3:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 3:33" />दुष्‍टको घरमा याहवेहको श्राप रहन्छ;</para>
  <para style="q2" vid="PRO 3:33">तर धर्मीको घरलाई उहाँले आशिष् दिनुहुन्छ।<verse eid="PRO 3:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 3:34" />गिल्‍ला गर्ने घमण्डीहरूलाई उहाँले गिल्‍ला गर्नुहुन्छ,</para>
  <para style="q2" vid="PRO 3:34">तर नम्र र पीडितहरूलाई उहाँले अनुग्रह दिनुहुन्छ।<verse eid="PRO 3:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 3:35" />बुद्धिमान्‌हरूले सम्मान प्राप्‍त गर्दछन्;</para>
  <para style="q2" vid="PRO 3:35">तर मूर्खहरूलाई उहाँले लाजमा पार्नुहुनेछ।<verse eid="PRO 3:35" /></para>
  <chapter eid="PRO 3" />
  <chapter number="4" style="c" sid="PRO 4" />
  <para style="s1">कुनै पनि मूल्यमा बुद्धि प्राप्‍त गर्नु</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 4:1" />हे मेरा छोराछोरीहरू हो, आफ्नो बुबाको अर्ती सुन,</para>
  <para style="q2" vid="PRO 4:1">यसमा ध्यान दिएर समझशक्ति प्राप्‍त गर।<verse eid="PRO 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 4:2" />म तिमीहरूलाई उचित कुरा सिकाउँछु,</para>
  <para style="q2" vid="PRO 4:2">यसकारण मेरो शिक्षालाई नत्याग!<verse eid="PRO 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 4:3" />किनभने म पनि आफ्नो बुबाको एक मात्र छोरो थिएँ,</para>
  <para style="q2" vid="PRO 4:3">मेरी आमाको कोमल र प्यारो छोरो थिएँ।<verse eid="PRO 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 4:4" />मेरा बुबाले मलाई यसो भनेर सिकाउनुभयो,</para>
  <para style="q2" vid="PRO 4:4">“तिम्रो पूरा हृदयले मेरो वचनहरू पक्रिराख,</para>
  <para style="q2" vid="PRO 4:4">मेरा आज्ञाहरू पालन गर, र तिमी जिउनेछौ।<verse eid="PRO 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 4:5" />बुद्धि प्राप्‍त गर, समझशक्ति प्राप्‍त गर;</para>
  <para style="q2" vid="PRO 4:5">मेरा वचनहरू नबिर्स, र तिनीहरूदेखि तर्किएर नजाऊ।<verse eid="PRO 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 4:6" />बुद्धिलाई नत्याग, र यसले तिमीलाई रक्षा गर्नेछ;</para>
  <para style="q2" vid="PRO 4:6">यसलाई प्रेम गर, र यसले तिमीलाई पहरा दिनेछ।<verse eid="PRO 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 4:7" />बुद्धि सर्वोच्‍च हो, यसकारण बुद्धि प्राप्‍त गर।</para>
  <para style="q2" vid="PRO 4:7">समझशक्तिको लागि तिमीसित भएका कुनै पनि मूल्य चुकाउनुपरे तापनि यसलाई प्राप्‍त गर।<verse eid="PRO 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 4:8" />बुद्धिलाई कदर गर, र यसले तिमीलाई उच्‍च पार्नेछ,</para>
  <para style="q2" vid="PRO 4:8">यसलाई ग्रहण गर, र यसले तिम्रो आदर गर्नेछ।<verse eid="PRO 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 4:9" />यसले तिम्रो शिरमा शोभायमान माला पहिर्‍याइदिनेछ,</para>
  <para style="q2" vid="PRO 4:9">र महिमामय मुकुट प्रदान गर्नेछ।”<verse eid="PRO 4:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 4:10" />हे मेरो छोराछोरी, सुन;</para>
  <para style="q2" vid="PRO 4:10">मैले भनेको कुरा स्वीकार गर, र तिम्रो जीवन दीर्घायु हुनेछ।<verse eid="PRO 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 4:11" />म तिमीलाई बुद्धिको मार्ग सिकाउँछु,</para>
  <para style="q2" vid="PRO 4:11">र तिमीलाई सीधा बाटोमा डोर्‍याउँछु।<verse eid="PRO 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 4:12" />तिमी हिँड्दा कुनै पनि कुराले तिम्रा पाइलाहरूलाई छेक्नेछैनन्,</para>
  <para style="q2" vid="PRO 4:12">अनि तिमी दगुर्दा तिमीलाई ठेस लाग्नेछैन।<verse eid="PRO 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 4:13" />अर्तीलाई पक्रिबस, यसलाई जान नदेऊ;</para>
  <para style="q2" vid="PRO 4:13">यसलाई जोगाइराख; किनकि यो तिम्रो जीवन हो।<verse eid="PRO 4:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 4:14" />दुष्‍टको मार्गमा पाइला नटेक</para>
  <para style="q2" vid="PRO 4:14">अथवा खराब मानिसहरूको चालमा नहिँड।<verse eid="PRO 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 4:15" />त्योदेखि टाढै बस, त्यस बाटोमा नहिँड,</para>
  <para style="q2" vid="PRO 4:15">त्यसबाट फर्क र आफ्नै बाटो लाग।<verse eid="PRO 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 4:16" />किनकि दुष्‍टहरू खराब काम नगरी सुत्नै सक्दैनन्;</para>
  <para style="q2" vid="PRO 4:16">कसैको खराबी नगरेसम्म तिनीहरूलाई निद्रै लाग्दैन।<verse eid="PRO 4:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 4:17" />तिनीहरूले दुष्‍टताको रोटी खान्छन्</para>
  <para style="q2" vid="PRO 4:17">र हिंसाको मद्य पिउँछन्।<verse eid="PRO 4:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 4:18" />धर्मीको चाल बिहानको पहिलो ज्योतिजस्तै हो,</para>
  <para style="q2" vid="PRO 4:18">त्यो मध्यदिन नहुन्जेल झन्-झन् चहकिलो हुँदैजान्छ।<verse eid="PRO 4:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 4:19" />तर दुष्‍टको चाल घोर अन्धकारजस्तै हो;</para>
  <para style="q2" vid="PRO 4:19">तिनीहरू कुन कुराले आफ्नो पतन हुँदैछ, सो जान्दैनन्।<verse eid="PRO 4:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 4:20" />हे मेरो छोराछोरी, मेरो कुरामा ध्यान देऊ;</para>
  <para style="q2" vid="PRO 4:20">मेरा वचनहरू ध्यानसित सुन।<verse eid="PRO 4:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 4:21" />ती तिम्रो दृष्‍टिदेखि अलग हुन नदेऊ;</para>
  <para style="q2" vid="PRO 4:21">ती तिम्रो हृदयभित्र राख,<verse eid="PRO 4:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 4:22" />किनकि तिनलाई पाउनेहरूका लागि ती जीवन हुन्,</para>
  <para style="q2" vid="PRO 4:22">र सारा शरीरको निम्ति स्वास्थ्य हो।<verse eid="PRO 4:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 4:23" />यी कुराहरूभन्दा बढी आफ्नो हृदयलाई नै सुरक्षित राख;</para>
  <para style="q2" vid="PRO 4:23">किनकि यो नै सारा जीवनको मूल हो।<verse eid="PRO 4:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 4:24" />तिम्रो मुखबाट भ्रष्‍टता टाढै रहोस्,</para>
  <para style="q2" vid="PRO 4:24">भ्रष्‍ट कुराकानी तिम्रो ओठदेखि टाढै रहोस्।<verse eid="PRO 4:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 4:25" />तिम्रा आँखाले सीधा अगिल्तिर हेरोस्,</para>
  <para style="q2" vid="PRO 4:25">तिम्रो अगिल्तिर सोझै एक टक लगाएर हेरोस्।<verse eid="PRO 4:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 4:26" />तिम्रा खुट्टाहरूका निम्ति समतल मार्ग बनाऊ,</para>
  <para style="q2" vid="PRO 4:26">र आफ्ना सबै मार्गहरूमा दृढ होऊ!<verse eid="PRO 4:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 4:27" />दाहिने अथवा देब्रेतिर नलाग;</para>
  <para style="q2" vid="PRO 4:27">सबै दुष्‍ट कुराबाट आफ्ना खुट्टाहरू अलग राख!<verse eid="PRO 4:27" /></para>
  <chapter eid="PRO 4" />
  <chapter number="5" style="c" sid="PRO 5" />
  <para style="s1">व्यभिचार विरुद्ध चेतावनी</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 5:1" />हे मेरो छोरा, मेरो बुद्धिमा ध्यान देऊ,</para>
  <para style="q2" vid="PRO 5:1">अन्‍तर्दृष्‍टिका मेरा वचनहरू ध्यानपूर्वक सुन,<verse eid="PRO 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 5:2" />ताकि तिमीले विवेकलाई कायम राख्न सक,</para>
  <para style="q2" vid="PRO 5:2">र तिम्रो ओठले ज्ञानको रक्षा गरोस्।<verse eid="PRO 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 5:3" />किनकि व्यभिचारिणी स्त्रीको ओठबाट मह चुहिन्छ,</para>
  <para style="q2" vid="PRO 5:3">र त्यसको बोली तेलभन्दा चिप्लो हुन्छ,<verse eid="PRO 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 5:4" />तापनि आखिरमा त्यो पित्तजस्तै तितो,</para>
  <para style="q2" vid="PRO 5:4">र दुईधारे तरवारजस्तै धारिलो हुन्छ।<verse eid="PRO 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 5:5" />त्यसका पाउहरू मृत्युको बाटोतिर लाग्छन्,</para>
  <para style="q2" vid="PRO 5:5">त्यसका पाइलाहरू सोझै पातालतिर लाग्छन्।<verse eid="PRO 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 5:6" />त्यसले जीवनको मार्गतिर वास्तै गर्दिन;</para>
  <para style="q2" vid="PRO 5:6">त्यसका मार्गहरू अस्थिर छन्, तापनि यो कुरा त्यसले थाहै गर्दिन।<verse eid="PRO 5:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 5:7" />अब, हे मेरा छोराहरू, मेरो कुरा सुन,</para>
  <para style="q2" vid="PRO 5:7">म जे भन्छु, त्यसबाट तर्किएर नजाओ!<verse eid="PRO 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 5:8" />त्यस्ती स्त्रीको मार्गदेखि टाढै बस,</para>
  <para style="q2" vid="PRO 5:8">त्यसको घरको ढोका नजिक जाँदै नजाओ!<verse eid="PRO 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 5:9" />नत्रता तिमीहरूले आफ्नो इज्जत अर्काका हातमा दिनेछौ,</para>
  <para style="q2" vid="PRO 5:9">र तिमीहरूको प्रतिष्‍ठा<note caller="+" style="f"><char style="fr" closed="false">5:9 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">वर्षहरू</char></note> निर्दयीको हातमा पर्नेछ,<verse eid="PRO 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 5:10" />अनि अरूले तिमीहरूको धनसम्पत्तिमा चैन गर्नेछन्,</para>
  <para style="q2" vid="PRO 5:10">र तिमीहरूका परिश्रमले अर्काको घरलाई समृद्ध तुल्याउनेछ।<verse eid="PRO 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 5:11" />जीवनको अन्तिम समयमा तिमीहरूले विलाप गर्नेछौ,</para>
  <para style="q2" vid="PRO 5:11">जब तिमीहरू गलेर हाड र छाला हुनेछौ।<verse eid="PRO 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 5:12" />तब तिमीहरूले भन्‍नेछौ, “हाय मैले कसरी अनुशासनलाई घृणा गरेँ,</para>
  <para style="q2" vid="PRO 5:12">र कसरी मेरो हृदयले सुधारलाई लत्यायो!<verse eid="PRO 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 5:13" />मैले मेरा शिक्षकहरूको आज्ञापालन गरिनँ,</para>
  <para style="q2" vid="PRO 5:13">र मलाई सिकाउनेहरूको कुरामा ध्यानै दिइनँ।<verse eid="PRO 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 5:14" />परमेश्‍वरका मानिसहरूको सभामा,</para>
  <para style="q2" vid="PRO 5:14">म पूरै सर्वनाशको खाडलमा आइपुगेको छु।”<verse eid="PRO 5:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 5:15" />आफ्नै भाँडाको पानी पिऊ,</para>
  <para style="q2" vid="PRO 5:15">र आफ्नै कुवाबाट बगेको पानी पिऊ!<verse eid="PRO 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 5:16" />के तिम्रा मुहानहरू सडकतिर,</para>
  <para style="q2" vid="PRO 5:16">र तिम्रा मुहानका पानी चोकहरूतिर बगेर जाऊन्?<verse eid="PRO 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 5:17" />त्यो तिम्रै निम्ति मात्र होस्,</para>
  <para style="q2" vid="PRO 5:17">त्यसको साझेदार पराईहरू हुन नपाऊन्।<verse eid="PRO 5:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 5:18" />तिम्रो मुहान धन्यको होस्;</para>
  <para style="q2" vid="PRO 5:18">र आफ्नो युवाअवस्थाकी पत्नीसित तिमी आनन्दित होऊ!<verse eid="PRO 5:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 5:19" />मायालु मृग, राम्री हरिणीजस्तै,</para>
  <para style="q2" vid="PRO 5:19">त्यसकै स्तनहरूले तिमीलाई सधैँ सन्तुष्‍ट राखून्,</para>
  <para style="q2" vid="PRO 5:19">तिमी सधैँ त्यसकै प्रेममा मोहित भइबस।<verse eid="PRO 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 5:20" />हे मेरो छोरा, तिमी किन अर्काकी पत्नीको मोहमा फस्छौ?</para>
  <para style="q2" vid="PRO 5:20">तिमी किन स्वेच्छाचारी स्त्रीलाई अँगालो हाल्छौ?<verse eid="PRO 5:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 5:21" />किनकि मानिसका चालहरू याहवेहमा छर्लङ्ग छन्;</para>
  <para style="q2" vid="PRO 5:21">र उहाँले त्यसका सबै मार्गहरूको जाँच गर्नुहुन्छ।<verse eid="PRO 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 5:22" />दुष्‍ट मानिसका अधर्मले त्यसलाई पासोमा फसाउँछ,</para>
  <para style="q2" vid="PRO 5:22">र आफ्नै पापको बन्धनमा त्यो जेलिन्छ।<verse eid="PRO 5:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 5:23" />अनुशासनको अभावमा तिनीहरू मर्नेछन्;</para>
  <para style="q2" vid="PRO 5:23">आफ्नै घोर मूर्खताले बहकिनेछन्।<verse eid="PRO 5:23" /></para>
  <chapter eid="PRO 5" />
  <chapter number="6" style="c" sid="PRO 6" />
  <para style="s1">मूर्खताको विरुद्धमा चेतावनी</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 6:1" />हे मेरो छोराछोरी, यदि तिमी आफ्नो छिमेकीका जमानी बसेका छौ भने,</para>
  <para style="q2" vid="PRO 6:1">वा पराईसँग वाचा बाँधेका छौ भने,<verse eid="PRO 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 6:2" />यदि आफूले बोलेको कुरामा तिमी फसेको छौ भने,</para>
  <para style="q2" vid="PRO 6:2">र आफ्नै मुखको वचनले पासोमा फस्यौ भने,<verse eid="PRO 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 6:3" />हे मेरो छोराछोरी, तिमी आफ्नो छिमेकीको पन्जामा परेको हुनाले;</para>
  <para style="q2" vid="PRO 6:3">आफूलाई मुक्त पार्न यसो गर:</para>
  <para style="q1" vid="PRO 6:3">जाऊ र आफूलाई नम्र पार,</para>
  <para style="q2" vid="PRO 6:3">र छिमेकीसँग खुरन्धार बिन्ती गर।<verse eid="PRO 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 6:4" />तिम्रा आँखाहरूलाई सुत्न नदेऊ,</para>
  <para style="q2" vid="PRO 6:4">र तिम्रा आँखाको पलकलाई निदाउन नदेऊ।<verse eid="PRO 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 6:5" />शिकारीको हातबाट हरिण उम्केजस्तै,</para>
  <para style="q2" vid="PRO 6:5">व्याधाको हातबाट चरा फुत्केजस्तै तिमीले आफूलाई मुक्त गर।<verse eid="PRO 6:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 6:6" />ए अल्छे, कमिलाकहाँ गएर त्यसको चालढङ्ग हेर्,</para>
  <para style="q2" vid="PRO 6:6">र बुद्धिमानी बन्!<verse eid="PRO 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 6:7" />त्यसको कोही सेनापति हुँदैन,</para>
  <para style="q2" vid="PRO 6:7">न त रेखदेख गर्ने शासक नै हुन्छ,<verse eid="PRO 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 6:8" />तरै पनि त्यसले ग्रीष्म ऋतुमा अन्‍नको भण्डार तयार गर्छ,</para>
  <para style="q2" vid="PRO 6:8">र कटनीको समयमा आफ्नो खानेकुरा जम्मा गर्छ।<verse eid="PRO 6:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 6:9" />ए अल्छे, कहिलेसम्म तँ त्यहाँ ढल्किरहन्छस्?</para>
  <para style="q2" vid="PRO 6:9">तँ आफ्नो निद्राबाट कहिले जाग्छस्?<verse eid="PRO 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 6:10" />एकैछिनको सुताइ, र एकैछिनको निन्द्राले,</para>
  <para style="q2" vid="PRO 6:10">हात बाँधेर एकैछिन मारिएको थकाइले,<verse eid="PRO 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 6:11" />तिमीमाथि गरिबी डाँकुजस्तै</para>
  <para style="q2" vid="PRO 6:11">र अभावचाहिँ हतियारधारीझैँ आइलाग्नेछ।<verse eid="PRO 6:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 6:12" />दुष्‍ट र उपद्रवी मानिस,</para>
  <para style="q2" vid="PRO 6:12">जो भ्रष्‍ट मुख लिएर यताउति गर्दै हिँड्छ,<verse eid="PRO 6:12" /></para>
  <para style="q2">
    <verse number="13" style="v" sid="PRO 6:13" />जसले आँखा झिम्काउँछ,</para>
  <para style="q2" vid="PRO 6:13">आफ्ना खुट्टाले इसारा गर्छ;</para>
  <para style="q2" vid="PRO 6:13">र औँलाले चलाउँछ,<verse eid="PRO 6:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="PRO 6:14" />आफ्नो छली हृदयमा त्यसले दुष्‍ट कुरा रच्दछ।</para>
  <para style="q2" vid="PRO 6:14">त्यसले सधैँ विवाद उत्पन्‍न गराउँछ।<verse eid="PRO 6:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 6:15" />यसकारण विपत्ति त्यसमाथि अचानक आइलाग्नेछ;</para>
  <para style="q2" vid="PRO 6:15">त्यो अचानक उपायविना नै नष्‍ट हुनेछ।<verse eid="PRO 6:15" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="16" style="v" sid="PRO 6:16" />यी छ वटा कुराहरू याहवेहले घृणा गर्नुहुन्छ,</para>
  <para style="li2" vid="PRO 6:16">सात वटा कुराहरू उहाँमा तुच्छ छन्:<verse eid="PRO 6:16" /></para>
  <para style="li3">
    <verse number="17" style="v" sid="PRO 6:17" />अहङ्कारी आँखा,</para>
  <para style="li3" vid="PRO 6:17">झूटो बोल्ने जिब्रो,</para>
  <para style="li3" vid="PRO 6:17">निर्दोषको रगत बगाउने हात,<verse eid="PRO 6:17" /></para>
  <para style="li3">
    <verse number="18" style="v" sid="PRO 6:18" />दुष्‍ट युक्ति रच्ने हृदय,</para>
  <para style="li3" vid="PRO 6:18">खराबी काम गर्न झट्टै अग्रसर हुने पाउहरू,<verse eid="PRO 6:18" /></para>
  <para style="li3">
    <verse number="19" style="v" sid="PRO 6:19" />असत्य थुपार्ने झूटो साक्षी</para>
  <para style="li3" vid="PRO 6:19">र समुदायको बीचमा कलह उठाउने मानिस।<verse eid="PRO 6:19" /></para>
  <para style="s1">व्यभिचारको विरुद्धमा चेतावनी</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 6:20" />हे मेरो छोरा, आफ्नो बुबाको आज्ञापालन गर;</para>
  <para style="q2" vid="PRO 6:20">र आफ्नी आमाको शिक्षालाई नत्याग।<verse eid="PRO 6:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 6:21" />त्यसलाई तिम्रो हृदयमा सधैँको लागि टाँसी राख,</para>
  <para style="q2" vid="PRO 6:21">त्यसलाई तिम्रो गलामा बाँधिराख।<verse eid="PRO 6:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 6:22" />जब तिमी हिँड्छौ, त्यसले तिमीलाई अगुवाइ गर्नेछ;</para>
  <para style="q2" vid="PRO 6:22">जब तिमी निदाउँछौ, त्यसले तिम्रो सुरक्षा गर्नेछ;</para>
  <para style="q2" vid="PRO 6:22">जब तिमी जाग्नेछौ, त्यसले तिमीलाई सल्‍लाह दिनेछ।<verse eid="PRO 6:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 6:23" />किनकि यो आज्ञा एउटा बत्ती हो,</para>
  <para style="q2" vid="PRO 6:23">र शिक्षाचाहिँ ज्योति हो;</para>
  <para style="q1" vid="PRO 6:23">अनि अनुशासनको सुधार</para>
  <para style="q2" vid="PRO 6:23">जीवनका मार्ग हुन्,<verse eid="PRO 6:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 6:24" />जसले तिमीलाई चरित्रहीन स्त्रीबाट,</para>
  <para style="q2" vid="PRO 6:24">स्वेच्छाचारी पत्नीको चिप्ले कुराबाट बचाउँछ।<verse eid="PRO 6:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 6:25" />तिम्रो हृदयमा त्यसको सुन्दरताको चाहना नगर;</para>
  <para style="q2" vid="PRO 6:25">त्यसका आँखाले तिमीलाई वशमा नपारोस्।<verse eid="PRO 6:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 6:26" />किनकि वेश्याले तिमीलाई रोटी समान बनाउँछे,</para>
  <para style="q2" vid="PRO 6:26">तर अर्काकी पत्नीले झन् तिम्रो जीवनलाई नै शिकार बनाउँछे।<verse eid="PRO 6:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 6:27" />के मानिसले आफ्नो काखमा आगो राख्यो भने</para>
  <para style="q2" vid="PRO 6:27">उसको लुगा डढ्दैन र?<verse eid="PRO 6:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 6:28" />के मानिस भुङ्ग्रोमाथि हिँड्यो भने</para>
  <para style="q2" vid="PRO 6:28">त्यसका पाउहरू जल्दैन र?<verse eid="PRO 6:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 6:29" />त्यसरी नै जो मानिस अर्काकी पत्नीसित सुत्छ,</para>
  <para style="q2" vid="PRO 6:29">त्यसलाई छुने कोही पनि दण्ड नपाई उम्कनेछैन।<verse eid="PRO 6:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 6:30" />भोकले मर्न लागेको चोरले आफ्नो भोक मेटाउनलाई</para>
  <para style="q2" vid="PRO 6:30">चोरी गरेकोमा कसैले त्यसलाई तुच्छ ठान्दैन।<verse eid="PRO 6:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 6:31" />तर यदि त्यो पक्राउ पर्‍यो भने त्यसले सात गुणा बढी तिर्नुपर्छ;</para>
  <para style="q2" vid="PRO 6:31">चाहे त्यो उसको घरको सम्पूर्ण धन नै किन नहोस्।<verse eid="PRO 6:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 6:32" />तर व्यभिचार गर्ने व्यक्तिसित विवेक हुँदैन;</para>
  <para style="q2" vid="PRO 6:32">यसो गर्ने सबैले आफूलाई नष्‍ट गर्छन्।<verse eid="PRO 6:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 6:33" />मुक्‍का र अपमान त्यसको भाग हुनेछ;</para>
  <para style="q2" vid="PRO 6:33">र त्यसको अपमान कहिल्यै मेटिनेछैन।<verse eid="PRO 6:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="PRO 6:34" />किनकि डाहले पतिको क्रोधलाई उत्तेजित गराउँछ,</para>
  <para style="q2" vid="PRO 6:34">र दयामाया नदेखाईकनै त्यसले बदला लिनेछ।<verse eid="PRO 6:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 6:35" />त्यसले कुनै क्षतिपूर्ति ग्रहण गर्नेछैन;</para>
  <para style="q2" vid="PRO 6:35">त्यसले जतिसुकै ठूलो घूसलाई पनि अस्वीकार गर्नेछ।<verse eid="PRO 6:35" /></para>
  <chapter eid="PRO 6" />
  <chapter number="7" style="c" sid="PRO 7" />
  <para style="s1">व्यभिचारिणी स्त्रीको विरुद्ध चेतावनी</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 7:1" />हे मेरो छोरा, मेरा वचनहरू पालन गर,</para>
  <para style="q2" vid="PRO 7:1">र मेरा आज्ञाहरूलाई आफूभित्र साँचिराख।<verse eid="PRO 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 7:2" />मेरा आज्ञाहरू पालन गर, र तिमी जिउनेछौ,</para>
  <para style="q2" vid="PRO 7:2">मेरा अर्तीहरूलाई आफ्नो आँखाको नानीजस्तै जोगाइराख।<verse eid="PRO 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 7:3" />तिनलाई तिम्रा औँलाहरूमा बाँधिराख,</para>
  <para style="q2" vid="PRO 7:3">तिनलाई आफ्नो हृदयको पाटीमा लेखिराख।<verse eid="PRO 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 7:4" />बुद्धिलाई भन, “तिमी मेरी बहिनी हौ,”</para>
  <para style="q2" vid="PRO 7:4">र समझशक्तिलाई चाहिँ “तिमी मेरो आफन्त हौ।”<verse eid="PRO 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 7:5" />तिनले तिमीलाई व्यभिचारिणी स्त्रीबाट</para>
  <para style="q2" vid="PRO 7:5">र स्वेच्छाचारी स्त्रीको चिप्ले कुराबाट बचाउनेछन्।<verse eid="PRO 7:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 7:6" />आफ्नो घरको झ्यालमा</para>
  <para style="q2" vid="PRO 7:6">त्यसको आँखीझ्यालबाट मैले बाहिर हेरेँ।<verse eid="PRO 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 7:7" />मैले सोझाहरूको बीचमा,</para>
  <para style="q2" vid="PRO 7:7">मैले जवान मानिसहरूमध्ये</para>
  <para style="q2" vid="PRO 7:7">विवेक नभएको एउटा जवानलाई देखेँ।<verse eid="PRO 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 7:8" />त्यो तल सडक छेउको त्यस स्त्रीको घरको कुनामा जाँदैथियो;</para>
  <para style="q2" vid="PRO 7:8">त्यो त्यसकै घरको कुनातिर हिँड्दैथियो।<verse eid="PRO 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 7:9" />दिन ढल्दै गरेको साँझको समय थियो,</para>
  <para style="q2" vid="PRO 7:9">रातको अन्धकार बढ्दै थियो।<verse eid="PRO 7:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 7:10" />तब एउटी स्त्री त्यसलाई भेट्न आई,</para>
  <para style="q2" vid="PRO 7:10">चरित्रहीन स्त्रीको जस्तै वस्त्र पहिरेकी र धूर्त नियत भएकी,<verse eid="PRO 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 7:11" />(त्यो चञ्चल र अभिमानी छे;</para>
  <para style="q2" vid="PRO 7:11">त्यसका पाउहरू कहिल्यै घरमा बास बस्दैनन्,<verse eid="PRO 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 7:12" />त्यो कहिले सडकमा त कहिले चोकहरूमा हुन्छे;</para>
  <para style="q2" vid="PRO 7:12">त्यो प्रत्येक कुनाकाप्चामा ढुकिबस्छे।)<verse eid="PRO 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 7:13" />तब त्यसले त्यसलाई समाती र चुम्बन गरी,</para>
  <para style="q2" vid="PRO 7:13">अनि लाजै नमानी त्यसले भनी:<verse eid="PRO 7:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 7:14" />“मैले घरमा मेलबलि चढाउनु परेको छ;</para>
  <para style="q2" vid="PRO 7:14">आज मैले आफ्नो भाकल पूरा गरेकी छु।<verse eid="PRO 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 7:15" />त्यसैले म तपाईंलाई भेट्न बाहिर आएकी हुँ,</para>
  <para style="q2" vid="PRO 7:15">मैले तपाईंलाई खोजेँ, र अहिले भेट्टाएकी छु!<verse eid="PRO 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 7:16" />मैले मेरो ओछ्यानमा</para>
  <para style="q2" vid="PRO 7:16">इजिप्टबाट ल्याएको मलमलको रङ्गीन तन्‍ना बिछ्याएकी छु।<verse eid="PRO 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 7:17" />मैले मेरो ओछ्यानमा</para>
  <para style="q2" vid="PRO 7:17">मूर्र, एलवा र दालचिनीको सुघन्धित अत्तर छर्केकी छु।<verse eid="PRO 7:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 7:18" />आउनुहोस्, हामी बिहानसम्मै प्रेमले तृप्‍त बनौँ,</para>
  <para style="q2" vid="PRO 7:18">हामी प्रेममा मस्त होऔँ!<verse eid="PRO 7:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 7:19" />मेरा पति घरमा हुनुहुन्‍न,</para>
  <para style="q2" vid="PRO 7:19">उहाँ लामो यात्रामा जानुभएको छ।<verse eid="PRO 7:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 7:20" />उहाँले आफ्नो थैलीभरि रकम लानुभएको छ,</para>
  <para style="q2" vid="PRO 7:20">र उहाँ पूर्णिमाको अगि घर फर्कनुहुन्‍न।”<verse eid="PRO 7:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 7:21" />लोभ्याउने वचनहरूले उसले त्यसलाई बहकाई;</para>
  <para style="q2" vid="PRO 7:21">उसले त्यसलाई मोहित कुराले फसाई।<verse eid="PRO 7:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 7:22" />मारिनका निम्ति लगिएको गोरुझैँ,</para>
  <para style="q2" vid="PRO 7:22">पासोमा फस्‍न लागेको मृगझैँ,</para>
  <para style="q1" vid="PRO 7:22">त्यो तुरुन्तै त्यस स्त्रीको पछि लाग्यो,<verse eid="PRO 7:22" /></para>
  <para style="q2">
    <verse number="23" style="v" sid="PRO 7:23" />काँडले त्यसको कलेजो नरोपिएसम्म,</para>
  <para style="q1" vid="PRO 7:23">एउटा चरा पासोमा पर्नलाई वेगसित उडिआए जस्तै,</para>
  <para style="q2" vid="PRO 7:23">त्यसलाई आफ्नो प्राण गुमाउनुपर्छ भन्‍ने थाहा हुँदैन।<verse eid="PRO 7:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 7:24" />अब हे मेरा छोराहरू हो, मेरो कुरा सुन,</para>
  <para style="q2" vid="PRO 7:24">म जे भन्छु, त्यसमा ध्यान देओ।<verse eid="PRO 7:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 7:25" />त्यस्ता स्त्रीतर्फ आफ्ना हृदय नफर्काओ,</para>
  <para style="q2" vid="PRO 7:25">न त त्यसका मार्गहरूतिर हिँड।<verse eid="PRO 7:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 7:26" />त्यसले धेरैलाई शिकार बनाएकी छे;</para>
  <para style="q2" vid="PRO 7:26">त्यसद्वारा नष्‍ट पारिएकाहरू असंख्य छन्।<verse eid="PRO 7:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 7:27" />त्यसको घर चिहानको राजमार्ग हो,</para>
  <para style="q2" vid="PRO 7:27">जसले मृत्युका कोठाहरूतिर पुर्‍याउँछ।<verse eid="PRO 7:27" /></para>
  <chapter eid="PRO 7" />
  <chapter number="8" style="c" sid="PRO 8" />
  <para style="s1">बुद्धिको आह्वान</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 8:1" />के बुद्धिले आह्वान गर्दैन?</para>
  <para style="q2" vid="PRO 8:1">के समझशक्तिले त्यसको आवाज उच्‍च पार्दैन?<verse eid="PRO 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 8:2" />गल्‍लीका उचाइहरूमा,</para>
  <para style="q2" vid="PRO 8:2">जहाँ बाटाहरूका मिलन हुन्छ, त्यसले त्यहाँ आफ्नो अडान लिन्छ,<verse eid="PRO 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 8:3" />सहरमा पुर्‍याउने मूलढोकाहरूको छेउमा,</para>
  <para style="q2" vid="PRO 8:3">प्रवेश द्वारहरूमा त्यो चर्को सोरले यसरी कराउँछ:<verse eid="PRO 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 8:4" />“हे मानिसहरू हो, म तिमीहरूलाई कराएर भन्छु;</para>
  <para style="q2" vid="PRO 8:4">म सारा मानव-जातिलाई आफ्नो आवाज सुनाउँछु।<verse eid="PRO 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 8:5" />तिमीहरू जो सोझा छौ, सक्षम होऊ।</para>
  <para style="q2" vid="PRO 8:5">तिमीहरू जो मूर्ख छौ, समझशक्ति प्राप्‍त गर्ने होऊ।<verse eid="PRO 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 8:6" />सुन, किनकि मसँग भन्‍नलाई काम लाग्ने कुराहरू छन्,</para>
  <para style="q2" vid="PRO 8:6">जे ठिक छ, त्यो भन्‍न म मेरो ओठ खोल्छु।<verse eid="PRO 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 8:7" />मेरो मुखले साँचो कुरा बोल्दछ;</para>
  <para style="q2" vid="PRO 8:7">किनकि मेरो ओठले दुष्‍टतालाई घृणा गर्छ।<verse eid="PRO 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 8:8" />मेरो मुखका सबै वचन न्यायसङ्गत छन्;</para>
  <para style="q2" vid="PRO 8:8">तीमध्ये एउटै पनि बाङ्गा-टिङ्गा अथवा भ्रष्‍ट छैन।<verse eid="PRO 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 8:9" />विवेकशील व्यक्तिका लागि मेरा वचन ठिक छन्,</para>
  <para style="q2" vid="PRO 8:9">ज्ञान हुने मानिसको निम्ति ती धार्मिक छन्।<verse eid="PRO 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 8:10" />मेरो अर्तीलाई चाँदीको सट्टामा,</para>
  <para style="q2" vid="PRO 8:10">र ज्ञानलाई उत्तम सुनको सट्टामा चुन;<verse eid="PRO 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 8:11" />किनकि बुद्धि माणिकहरूभन्दा मूल्यवान् हुन्छ,</para>
  <para style="q2" vid="PRO 8:11">र तिमीले इच्छा गरेको कुनै पनि कुरा त्यसको दाँजोमा आउँदैन।<verse eid="PRO 8:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 8:12" />“म, बुद्धि, विवेकसँग बसोबास गर्दछु,</para>
  <para style="q2" vid="PRO 8:12">मसँग ज्ञान र विवेक छन्।”<verse eid="PRO 8:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 8:13" />याहवेहप्रतिको भय दुष्‍टतालाई घृणा गर्नु हो,</para>
  <para style="q2" vid="PRO 8:13">अभिमान, अहङ्कार,</para>
  <para style="q2" vid="PRO 8:13">खराब चालचलन र भड्काउने कुराहरूलाई म घृणा गर्दछु।<verse eid="PRO 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 8:14" />परामर्श र उचित फैसला मद्वारा नै हुन्छन्;</para>
  <para style="q2" vid="PRO 8:14">मसित समझशक्ति छ, र मसित सामर्थ्य छ।<verse eid="PRO 8:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 8:15" />मद्वारा नै राजाहरूले शासन गर्छन्,</para>
  <para style="q2" vid="PRO 8:15">र शासकहरूले न्यायसङ्गत उर्दी जारी गर्छन्।<verse eid="PRO 8:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 8:16" />मद्वारा नै शासकहरूले राज्यव्यवस्था चलाउँछन्—</para>
  <para style="q2" vid="PRO 8:16">र पृथ्वीमा शासन गर्ने सबै शासकहरू।<note caller="+" style="f"><char style="fr" closed="false">8:16 </char><char style="ft" closed="false">केही प्राचीन पा.लि.हरूमा </char><char style="fqa" closed="false">सबै धार्मिक शासकहरू</char></note><verse eid="PRO 8:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 8:17" />मलाई प्रेम गर्नेहरूलाई म प्रेम गर्छु;</para>
  <para style="q2" vid="PRO 8:17">मेरो खोजी गर्नेहरूले मलाई भेट्टाउँछन्।<verse eid="PRO 8:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 8:18" />मसित धन र आदर,</para>
  <para style="q2" vid="PRO 8:18">रहिरहने सम्पत्ति र समृद्धि छन्।<verse eid="PRO 8:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 8:19" />मेरो फल असल सुनभन्दा राम्रो छ;</para>
  <para style="q2" vid="PRO 8:19">म जे पाउँछु, त्यो चुनिएको चाँदीभन्दा असल हुन्छ।<verse eid="PRO 8:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 8:20" />म धार्मिकताका बाटो हिँड्छु,</para>
  <para style="q2" vid="PRO 8:20">र न्यायको मार्गमा हिँड्छु,<verse eid="PRO 8:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 8:21" />मलाई प्रेम गर्नेहरूलाई म धनसम्पत्तिले भरिपूर्ण पार्छु</para>
  <para style="q2" vid="PRO 8:21">र म तिनीहरूका भण्डार भरिदिनेछु।<verse eid="PRO 8:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 8:22" />याहवेहले आफ्नो सृष्‍टिको सुरुमा नै,</para>
  <para style="q2" vid="PRO 8:22">उहाँका पुरातनका सबै कामहरूभन्दा पहिले नै मलाई सृजनुभयो,<verse eid="PRO 8:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 8:23" />परापूर्वकाल अगि नै,</para>
  <para style="q2" vid="PRO 8:23">अर्थात् संसारको सुरु हुनुभन्दा पहिलेदेखि नै मेरो सृष्‍टि भएको थियो।<verse eid="PRO 8:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 8:24" />सागरहरू हुनुभन्दा पहिले,</para>
  <para style="q2" vid="PRO 8:24">पानीले भरिएका मुहानहरू हुनुभन्दा अगि नै मेरो जन्म भएको थियो,<verse eid="PRO 8:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 8:25" />पर्वतहरू आ-आफ्ना स्थानमा स्थापित हुनुभन्दा पहिले नै,</para>
  <para style="q2" vid="PRO 8:25">पहाडहरूभन्दा पहिल्यै मेरो जन्म भएको थियो।<verse eid="PRO 8:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 8:26" />उहाँले पृथ्वी र त्यसका जमिनहरू,</para>
  <para style="q2" vid="PRO 8:26">वा पृथ्वीका धुलो बनाउनुभन्दा अगि नै म सृजिएको थिएँ।<verse eid="PRO 8:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 8:27" />जब उहाँले आकाशलाई स्थापित गर्नुभयो, म अस्तित्वमा थिएँ;</para>
  <para style="q2" vid="PRO 8:27">उहाँले महासागरमाथि क्षितिजले घेर्नुहुँदा, म त्यहाँ थिएँ।<verse eid="PRO 8:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 8:28" />जब उहाँले माथिका बादलहरू स्थापित गर्नुभयो;</para>
  <para style="q2" vid="PRO 8:28">जब पानीको मूललाई स्थिर गर्नुभयो;<verse eid="PRO 8:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 8:29" />जब पानीलाई उहाँको आज्ञा नाघेर बाहिर नजाओस् भनेर</para>
  <para style="q2" vid="PRO 8:29">उहाँले समुद्रको सिमाना तोकिदिनुभयो;</para>
  <para style="q1" vid="PRO 8:29">जब उहाँले पृथ्वीका जगहरू बसाल्नुभयो;<verse eid="PRO 8:29" /></para>
  <para style="q2">
    <verse number="30" style="v" sid="PRO 8:30" />त्यस समय म एक कारिगरजस्तै उहाँको छेउमा थिएँ।</para>
  <para style="q1" vid="PRO 8:30">म दिनहुँ हर्षले विभोर हुन्थेँ;</para>
  <para style="q2" vid="PRO 8:30">उहाँको उपस्थितिमा निरन्तर आनन्दित भइरहन्थेँ।<verse eid="PRO 8:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 8:31" />उहाँको सम्पूर्ण संसारमा म आनन्द मनाउँथे,</para>
  <para style="q2" vid="PRO 8:31">र मानव जातिमा प्रसन्‍न रहन्थेँ।<verse eid="PRO 8:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 8:32" />अब हे मेरा छोराछोरीहरू हो, मेरा कुरा सुन;</para>
  <para style="q2" vid="PRO 8:32">तिनीहरू धन्य हुन्, जसले मेरा मार्गहरू पछ्याउँछन्।<verse eid="PRO 8:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 8:33" />मेरा अर्तीहरू सुन र बुद्धिमान् होओ,</para>
  <para style="q2" vid="PRO 8:33">त्यसलाई बेवास्ता नगर,<verse eid="PRO 8:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 8:34" />त्यो मानिस धन्य हो, जसले मेरा वचन सुन्छ,</para>
  <para style="q2" vid="PRO 8:34">जो दिनदिनै मेरा ढोकाहरूमा नियालेर हेर्दै,</para>
  <para style="q2" vid="PRO 8:34">मेरो ढोकाको छेउमा पर्खिरहन्छ।<verse eid="PRO 8:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 8:35" />किनकि जसले मलाई भेट्टाउँछ, त्यसले जीवन पाउँछ,</para>
  <para style="q2" vid="PRO 8:35">र याहवेहबाट निगाह प्राप्‍त गर्छ।<verse eid="PRO 8:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PRO 8:36" />“तर जसले मलाई भेट्टाउन असफल हुन्छ, त्यसले आफूलाई नोक्सानी गर्छ,</para>
  <para style="q2" vid="PRO 8:36">मलाई घृणा गर्ने सबैले मृत्युलाई प्रेम गर्छन्।”<verse eid="PRO 8:36" /></para>
  <chapter eid="PRO 8" />
  <chapter number="9" style="c" sid="PRO 9" />
  <para style="s1">बुद्धि र मूर्खताको निम्तो</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 9:1" />बुद्धिले आफ्नो घर बनाएको छ;</para>
  <para style="q2" vid="PRO 9:1">त्यसले सात वटा खाँबो काटेर गाडेको छ।<verse eid="PRO 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 9:2" />त्यसले मासु पकाएको छ, र दाखमद्य तयार पारेको छ,</para>
  <para style="q2" vid="PRO 9:2">त्यसले आफ्नो टेबुल पनि ठिक पारेको छ।<verse eid="PRO 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 9:3" />त्यसले आफ्नो सेवकहरूलाई बाहिर पठाएको छ,</para>
  <para style="q2" vid="PRO 9:3">र सहरमा सबैभन्दा अग्लो ठाउँबाट बोलाउँछ।<verse eid="PRO 9:3" /></para>
  <para style="q2">
    <verse number="4" style="v" sid="PRO 9:4" />“सोझाहरू सबै मेरो घरभित्र आओ!”</para>
  <para style="q1" vid="PRO 9:4">ती समझ नभएकाहरूलाई त्यसले भन्छ:<verse eid="PRO 9:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="PRO 9:5" />“आओ, मसँग खाओ,</para>
  <para style="q2" vid="PRO 9:5">र मैले मिसाएको दाखमद्य पिओ।<verse eid="PRO 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 9:6" />आफ्ना सोझा चालहरू त्याग, र तिमीहरू बाँच्नेछौ।”</para>
  <para style="q2" vid="PRO 9:6">समझशक्तिको मार्गमा हिँड।<verse eid="PRO 9:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 9:7" />गिल्‍ला गर्नेलाई सुधार्नेले अपमान निम्त्याउँछ,</para>
  <para style="q2" vid="PRO 9:7">जसले दुष्‍टलाई हप्काउँछ, त्यसले दुर्व्यवहार बेहोर्नुपर्छ।<verse eid="PRO 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 9:8" />गिल्‍ला गर्नेलाई नहप्काऊ, नत्रता त्यसले तिमीलाई घृणा गर्नेछ;</para>
  <para style="q2" vid="PRO 9:8">बुद्धिमान् मानिसलाई हप्काऊ, र त्यसले तिमीलाई प्रेम गर्नेछ।<verse eid="PRO 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 9:9" />बुद्धिमान्‌लाई अर्ती देऊ, र ऊ अझ बुद्धिमान् हुनेछ;</para>
  <para style="q2" vid="PRO 9:9">धर्मी मानिसलाई शिक्षा देऊ, र उसले आफ्नो ज्ञान अझ बढाउँछ।<verse eid="PRO 9:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 9:10" />याहवेहको भय नै बुद्धिको सुरुवात हो,</para>
  <para style="q2" vid="PRO 9:10">र पवित्र परमेश्‍वरको ज्ञान नै समझशक्ति हो।<verse eid="PRO 9:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 9:11" />किनकि बुद्धिद्वारा नै तिमी दीर्घायु हुनेछौ,</para>
  <para style="q2" vid="PRO 9:11">र तिम्रो जीवनका वर्षहरू थपिनेछन्।<verse eid="PRO 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 9:12" />यदि तिमी बुद्धिमान् हौ भने तिमीलाई बुद्धिले इनाम दिनेछ;</para>
  <para style="q2" vid="PRO 9:12">यदि तिमी गिल्‍ला गर्ने हौ भने तिमीले दुःख मात्र पाउनेछौ।<verse eid="PRO 9:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 9:13" />अज्ञानी स्त्री कोलाहलपूर्ण हुन्छे;</para>
  <para style="q2" vid="PRO 9:13">त्यो सोझी र अज्ञानी हुन्छे।<verse eid="PRO 9:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 9:14" />त्यो आफ्नो घरको ढोकामा बस्छे,</para>
  <para style="q2" vid="PRO 9:14">सहरका सबैभन्दा अग्लो ठाउँमा बस्छे,<verse eid="PRO 9:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 9:15" />आफ्नो बाटो सरासर हिँडिरहेकाहरूलाई</para>
  <para style="q2" vid="PRO 9:15">त्यसले नजिकबाट बोलाउँछे।<verse eid="PRO 9:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="PRO 9:16" />“सोझाहरू सबै मेरो घरभित्र आओ!”</para>
  <para style="q1" vid="PRO 9:16">ती समझ नभएकाहरूलाई त्यसले भन्छे:<verse eid="PRO 9:16" /></para>
  <para style="q2">
    <verse number="17" style="v" sid="PRO 9:17" />“चोरीको पानी मिठो हुन्छ,</para>
  <para style="q2" vid="PRO 9:17">गुप्‍तमा खाएको भोजन स्वादिष्‍ठ हुन्छ!”<verse eid="PRO 9:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 9:18" />तर तिनीहरूले त्यहाँ मृतकहरू छन्,</para>
  <para style="q2" vid="PRO 9:18">र त्यसका पाहुनाहरू गहिरा चिहानभित्र छन् भन्‍ने कुरा जान्दैनन्।<verse eid="PRO 9:18" /></para>
  <chapter eid="PRO 9" />
  <chapter number="10" style="c" sid="PRO 10" />
  <para style="ms1">सोलोमनका हितोपदेश</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 10:1" />सोलोमनका हितोपदेश:</para>
  <para style="q1" vid="PRO 10:1">बुद्धिमान् छोराछोरीले आफ्ना बुबालाई खुशी तुल्याउँछन्,</para>
  <para style="q2" vid="PRO 10:1">तर मूर्ख छोराछोरीले आफ्नी आमालाई पिरोल्छन्।<verse eid="PRO 10:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 10:2" />अन्यायसँग कमाएको धन केही मूल्यको हुँदैन,</para>
  <para style="q2" vid="PRO 10:2">तर धार्मिकताले मृत्युबाट छुटाउँछ।<verse eid="PRO 10:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 10:3" />याहवेहले धर्मीहरूलाई भोकै राख्नुहुन्‍न;</para>
  <para style="q2" vid="PRO 10:3">तर उहाँले दुष्‍टको लालसालाई विफल पार्नुहुन्छ।<verse eid="PRO 10:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 10:4" />अल्छी हातहरूले मानिसलाई गरिब बनाउँछन्,</para>
  <para style="q2" vid="PRO 10:4">तर परिश्रमी हातहरूले सम्पत्ति आर्जन गर्छन्।<verse eid="PRO 10:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 10:5" />ग्रीष्म ऋतुमा अन्‍नको प्रबन्ध गर्ने छोराछोरी बुद्धिमान् हुन्;</para>
  <para style="q2" vid="PRO 10:5">तर कटनीको समयमा सुत्ने छोराछोरी शर्म लाग्दा हुन्।<verse eid="PRO 10:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 10:6" />धर्मीको शिरमाथि आशिष्‌हरूका मुकुट रहन्छन्,</para>
  <para style="q2" vid="PRO 10:6">तर दुष्‍ट मानिसको मुखमा हिंसा लुकेको हुन्छ।<verse eid="PRO 10:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 10:7" />धर्मीको नाम आशिष्‌मा<note caller="+" style="f"><char style="fr" closed="false">10:7 </char><char style="ft" closed="false">हेर्नुहोस् <char style="xt"><ref loc="GEN 48:20">उत्प 48:20</ref></char></char></note> प्रयोग गरिन्छ,</para>
  <para style="q2" vid="PRO 10:7">तर दुष्‍टको नामचाहिँ कुहिएर जानेछ।<verse eid="PRO 10:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 10:8" />हृदयमा बुद्धिमान् हुनेहरूले आज्ञाहरू ग्रहण गर्छन्,</para>
  <para style="q2" vid="PRO 10:8">तर बकबके मूर्खको विनाश हुन्छ।<verse eid="PRO 10:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 10:9" />इमानदार मानिस निर्धक्‍क भई जिउँछ;</para>
  <para style="q2" vid="PRO 10:9">तर टेढो मार्गमा हिँड्ने पक्राउ पर्नेछ।<verse eid="PRO 10:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 10:10" />कपटपूर्ण आँखा झिम्काउनेले शोक ल्याउँछ;</para>
  <para style="q2" vid="PRO 10:10">अनि बकबक गर्ने मूर्ख सर्वनाशमा पुग्छ।<verse eid="PRO 10:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 10:11" />धर्मीको मुख जीवनको फोहोरा हो,</para>
  <para style="q2" vid="PRO 10:11">तर दुष्‍टको मुखमा हिंसा लुकेको हुन्छ।<verse eid="PRO 10:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 10:12" />घृणाले फाटो उब्जाउँछ;</para>
  <para style="q2" vid="PRO 10:12">तर प्रेमले सबै अपराधहरू ढाक्दछ।<verse eid="PRO 10:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 10:13" />समझदार व्यक्तिका ओठमा बुद्धिका कुरा पाइन्छ;</para>
  <para style="q2" vid="PRO 10:13">तर विवेकहीनहरूका पिठिउँमा त छडी पर्छ।<verse eid="PRO 10:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 10:14" />बुद्धिमान् मानिसहरूले ज्ञान सञ्चय गर्छन्;</para>
  <para style="q2" vid="PRO 10:14">तर मूर्खको मुखले विनाश निम्त्याउँछ।<verse eid="PRO 10:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 10:15" />धनीको धन नै तिनीहरूका किल्‍ला भएको सहर हो,</para>
  <para style="q2" vid="PRO 10:15">तर दरिद्रता गरिबहरूको विनाश हो।<verse eid="PRO 10:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 10:16" />धर्मीको ज्याला तिनीहरूको जीवन हो,</para>
  <para style="q2" vid="PRO 10:16">तर दुष्‍टको कमाइ पाप र मृत्यु हो।<verse eid="PRO 10:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 10:17" />अनुशासन पालन गर्ने जीवनको बाटोमा जान्छ,</para>
  <para style="q2" vid="PRO 10:17">तर जसले सुधारलाई बेवास्ता गर्छ, त्यसले अरूलाई पथभ्रष्‍ट पार्छ।<verse eid="PRO 10:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 10:18" />जसले आफूमा घृणा लुकाएर राख्छ, उसको जिब्रो छली हुन्छ</para>
  <para style="q2" vid="PRO 10:18">र जसले निन्दा फैलाउँछ, त्यो मूर्ख हो।<verse eid="PRO 10:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 10:19" />जब बढ्ता बोलिन्छ, पापले बढी स्थान पाउँछ;</para>
  <para style="q2" vid="PRO 10:19">तर बुद्धिमान्‌ले आफ्नो जिब्रोमा लगाम लगाउँछ।<verse eid="PRO 10:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 10:20" />धर्मीको जिब्रो निखुर चाँदी हो;</para>
  <para style="q2" vid="PRO 10:20">तर दुष्‍टको हृदय भने केही मूल्यको हुँदैन।<verse eid="PRO 10:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 10:21" />धर्मीको ओठले धेरैलाई उत्साह दिन्छ,</para>
  <para style="q2" vid="PRO 10:21">तर मूर्खहरू विवेकको अभावले मर्छन्।<verse eid="PRO 10:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 10:22" />याहवेहको आशिष्‌ले धनसम्पत्ति ल्याउँछ;</para>
  <para style="q2" vid="PRO 10:22">अनि उहाँले यसमा दुःख थप्नुहुन्‍न।<verse eid="PRO 10:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 10:23" />मूर्खहरू दुष्‍ट चालमा आनन्दित हुन्छन्,</para>
  <para style="q2" vid="PRO 10:23">तर समझशक्ति भएको मानिस बुद्धिमा प्रसन्‍न हुन्छ।<verse eid="PRO 10:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 10:24" />तिनीहरूलाई त्रसित बनाउने कुरा नै दुष्‍टमाथि आइपर्नेछ;</para>
  <para style="q2" vid="PRO 10:24">धर्मीले जे इच्छा गर्छ, त्यो पूरा गरिनेछ।<verse eid="PRO 10:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 10:25" />आँधीबेहरी आएपछि दुष्‍टहरू सोहोरिएर गइहाल्छन्;</para>
  <para style="q2" vid="PRO 10:25">तर धर्मीचाहिँ अन्त्यसम्मै स्थिर रहन्छन्।<verse eid="PRO 10:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 10:26" />दाँतलाई सिर्का र आँखालाई धुवाँजस्तै,</para>
  <para style="q2" vid="PRO 10:26">अल्छे पनि त्यसलाई पठाउनेको निम्ति त्यस्तै हुन्।<verse eid="PRO 10:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 10:27" />याहवेहप्रति गरिएको श्रद्धाले जीवनको आयु लामो पार्छ;</para>
  <para style="q2" vid="PRO 10:27">तर दुष्‍टका आयुचाहिँ घटाइन्छ,<verse eid="PRO 10:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 10:28" />धर्मीका आशा आनन्दमय हुन्छ;</para>
  <para style="q2" vid="PRO 10:28">तर दुष्‍टहरूको आशा पूरा हुनेछैन।<verse eid="PRO 10:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 10:29" />याहवेहको मार्ग धर्मीहरूको निम्ति शरणस्थान हो;</para>
  <para style="q2" vid="PRO 10:29">तर दुष्‍ट काम गर्नेहरूको निम्ति त्यो विनाश हो।<verse eid="PRO 10:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 10:30" />धर्मी कहिल्यै उखेलिनेछैन;</para>
  <para style="q2" vid="PRO 10:30">तर दुष्‍ट पृथ्वीमा स्थिर रहनेछैन।<verse eid="PRO 10:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 10:31" />धर्मीको मुखबाट बुद्धिका कुरा निस्किन्छ,</para>
  <para style="q2" vid="PRO 10:31">तर भड्काउने जिब्रो काटिनेछ।<verse eid="PRO 10:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 10:32" />धर्मीका ओठले उचित कुरा जान्दछन्;</para>
  <para style="q2" vid="PRO 10:32">तर दुष्‍टको मुखले टेढामेढा कुराहरू मात्र जान्दछ।<verse eid="PRO 10:32" /></para>
  <para style="b" />
  <chapter eid="PRO 10" />
  <chapter number="11" style="c" sid="PRO 11" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 11:1" />छलको तराजु याहवेहले घृणा गर्नुहुन्छ,</para>
  <para style="q2" vid="PRO 11:1">तर ठिक ढकदेखि उहाँ प्रसन्‍न हुनुहुन्छ।<verse eid="PRO 11:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 11:2" />जब अहङ्कार आउँछ, तब बदनामी पनि आउँछ;</para>
  <para style="q2" vid="PRO 11:2">तर नम्रतासँग बुद्धि आउँछ।<verse eid="PRO 11:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 11:3" />धर्मीहरूको इमानदारीताले तिनीहरूलाई अगुवाइ गर्छ;</para>
  <para style="q2" vid="PRO 11:3">तर विश्‍वासघातीहरू आफ्नै कपटले नष्‍ट हुन्छन्।<verse eid="PRO 11:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 11:4" />क्रोधको दिनमा धनसम्पत्ति कुनै काम लाग्दैन;</para>
  <para style="q2" vid="PRO 11:4">तर धार्मिकताले मृत्युबाट छुटाउँछ।<verse eid="PRO 11:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 11:5" />निर्दोषहरूका धार्मिकताले तिनीहरूका मार्ग सोझो बनाउँछ,</para>
  <para style="q2" vid="PRO 11:5">तर दुष्‍टहरूचाहिँ तिनीहरूका आफ्नै दुष्‍टताले तल खसालिन्छन्।<verse eid="PRO 11:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 11:6" />सत्यनिष्‍ठहरूका धार्मिकताले तिनीहरूलाई छुटाउँछ,</para>
  <para style="q2" vid="PRO 11:6">तर विश्‍वासघातीहरू दुष्‍ट इच्छाहरूद्वारा पासोमा पर्छन्।<verse eid="PRO 11:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 11:7" />जब दुष्‍ट मानिस मर्छ, तब त्यसको आशा पनि नष्‍ट हुन्छ;</para>
  <para style="q2" vid="PRO 11:7">त्यसले आफ्नो शक्तिबाट राखेको आशा शून्यमा विलीन भइहाल्छ।<verse eid="PRO 11:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 11:8" />धार्मिक व्यक्ति सङ्कष्‍टबाट बचाइन्छ,</para>
  <para style="q2" vid="PRO 11:8">र त्यो दुष्‍टमाथि आइपर्छ।<verse eid="PRO 11:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 11:9" />ईश्‍वरविहीन मानिसको कुराले आफ्नै मुखले आफ्नो छिमेकीलाई नष्‍ट पार्छ,</para>
  <para style="q2" vid="PRO 11:9">तर धर्मीचाहिँ ज्ञानद्वारा उम्कनेछ।<verse eid="PRO 11:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 11:10" />धर्मीहरूको उन्‍नति हुँदा सहर रमाउँदछ;</para>
  <para style="q2" vid="PRO 11:10">तर दुष्‍टहरूको नाश हुँदा हर्षको ध्वनि सुनिन्छ।<verse eid="PRO 11:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 11:11" />धर्मीका आशिष्‌द्वारा सहर उच्‍च हुन्छ;</para>
  <para style="q2" vid="PRO 11:11">तर दुष्‍टको मुखबाट त्यो नष्‍ट हुन्छ।<verse eid="PRO 11:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 11:12" />विवेकहीनले आफ्नो छिमेकीको खिसी गर्छ;</para>
  <para style="q2" vid="PRO 11:12">तर विवेकीले आफ्नो जिब्रोलाई लगाम लगाउँछ।<verse eid="PRO 11:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 11:13" />कुराउटेले गोप्य भरोसामा आघात पुर्‍याउँछ;</para>
  <para style="q2" vid="PRO 11:13">तर विश्‍वासयोग्य मानिसले कुरा गोप्य राख्छ।<verse eid="PRO 11:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 11:14" />मार्गदर्शनको अभावमा देशको पतन हुन्छ;</para>
  <para style="q2" vid="PRO 11:14">तर धेरै सल्‍लाहकारको कारण विजय हुन्छ।<verse eid="PRO 11:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 11:15" />अरूको जमानी बस्‍नेले निश्‍चय नै दुःख भोग्नुपर्नेछ,</para>
  <para style="q2" vid="PRO 11:15">तर अर्काको नासोमा हात हाल्न इन्कार गर्ने व्यक्ति सुरक्षित रहनेछ।<verse eid="PRO 11:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 11:16" />दयालु हृदय भएकी स्त्रीले आदर पाउँछे,</para>
  <para style="q2" vid="PRO 11:16">तर निर्दयी मानिसहरूले धन मात्र कमाउँछन्।<verse eid="PRO 11:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 11:17" />दयालु मानिसले आफैँलाई लाभ पुर्‍याउँछ,</para>
  <para style="q2" vid="PRO 11:17">तर निर्दयी मानिसले आफूमाथि सङ्कष्‍ट निम्त्याउँछ।<verse eid="PRO 11:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 11:18" />दुष्‍ट मानिसले छलको ज्याला कमाउँछ,</para>
  <para style="q2" vid="PRO 11:18">तर जसले धार्मिकता छर्छ, त्यसले निश्‍चय नै प्रतिफलको कटनी गर्छ।<verse eid="PRO 11:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 11:19" />धर्मी मानिसले निश्‍चय नै जीवन प्राप्‍त गर्छ,</para>
  <para style="q2" vid="PRO 11:19">तर दुष्‍टताको पछि लाग्ने मानिस आफ्नै मृत्युमा पुग्छ।<verse eid="PRO 11:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 11:20" />याहवेहले भ्रष्‍ट हृदय भएकालाई घृणा गर्नुहुन्छ;</para>
  <para style="q2" vid="PRO 11:20">तर निर्दोष मार्गमा चल्नेहरूसित उहाँ प्रसन्‍न हुनुहुन्छ।<verse eid="PRO 11:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 11:21" />यो निश्‍चय जान: दुष्‍टले आवश्य दण्ड पाउनेछ,</para>
  <para style="q2" vid="PRO 11:21">तर धर्मीका सन्ततिले छुटकारा पाउनेछन्।<verse eid="PRO 11:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 11:22" />विवेकहीन सुन्दरीचाहिँ</para>
  <para style="q2" vid="PRO 11:22">सुँगुरको थुतुनोमा सुनको बुलाकी भएजस्तै हो।<verse eid="PRO 11:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 11:23" />धर्मीहरूका इच्छाहरूको अन्त्य असल नै हुन्छ;</para>
  <para style="q2" vid="PRO 11:23">तर दुष्‍टहरूका आशाको अन्त्य केवल क्रोधमा हुन्छ।<verse eid="PRO 11:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 11:24" />कसैले उदार चित्तले दिएर पनि अझ बढी लाभ गर्छन्;</para>
  <para style="q2" vid="PRO 11:24">तर कसैले चाहिँ कञ्जुसी गर्छ, र पनि त्यसमाथि दरिद्रता आउँछ।<verse eid="PRO 11:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 11:25" />उदार मानिसको उन्‍नति हुनेछ;</para>
  <para style="q2" vid="PRO 11:25">जसले अरूलाई उत्साह दिन्छ, ऊ आफैँ पनि उत्साहित हुनेछ।<verse eid="PRO 11:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 11:26" />अन्‍न लुकाएर थुपारी राख्नेलाई मानिसहरूले सराप्छन्,</para>
  <para style="q2" vid="PRO 11:26">तर ती खुशीसाथ बेच्नेलाई आशिष् दिन्छन्।<verse eid="PRO 11:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 11:27" />जसले असल खोज्छ, त्यसले निगाह पाउँछ,</para>
  <para style="q2" vid="PRO 11:27">तर दुष्‍टताको खोजी गर्नेहरूमा दुष्‍टता नै आउँछ।<verse eid="PRO 11:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 11:28" />जसले आफ्नो धनमाथि भरोसा राख्छ, त्यसको पतन हुन्छ;</para>
  <para style="q2" vid="PRO 11:28">तर धर्मी जनहरूचाहिँ हरियो पालुवाजस्तै लहलह मौलाउनेछन्।<verse eid="PRO 11:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 11:29" />जसले आफ्नो परिवारमा विपत्ति ल्याउँछ,</para>
  <para style="q2" vid="PRO 11:29">त्यसले पैतृक सम्पत्तिको रूपमा बतास मात्र प्राप्‍त गर्नेछ;</para>
  <para style="q2" vid="PRO 11:29">र मूर्खचाहिँ बुद्धिमान्‌को सेवक हुनेछ।<verse eid="PRO 11:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 11:30" />धर्मी जनको फल जीवनको रूख हो;</para>
  <para style="q2" vid="PRO 11:30">अनि बुद्धिमान्‌ले साथी पाउँदछ।<note caller="+" style="f"><char style="fr" closed="false">11:30 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">आत्मा जित्छ</char></note><verse eid="PRO 11:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 11:31" />यदि धर्मी जनले आफ्नो प्रतिफल यस संसारमा पाउँछ भने,</para>
  <para style="q2" vid="PRO 11:31">झन् अधर्मी र पापीहरूले त कति बढ्ता पाउनेछन्!<verse eid="PRO 11:31" /></para>
  <para style="b" />
  <chapter eid="PRO 11" />
  <chapter number="12" style="c" sid="PRO 12" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 12:1" />अनुशासनलाई प्रेम गर्नेले ज्ञानलाई प्रेम गर्छ,</para>
  <para style="q2" vid="PRO 12:1">तर सुधारलाई घृणा गर्ने व्यक्ति मूर्ख हो।<verse eid="PRO 12:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 12:2" />असल मानिसहरूले याहवेहबाट निगाह प्राप्‍त गर्छन्,</para>
  <para style="q2" vid="PRO 12:2">तर धूर्त मानिसहरूलाई याहवेहले दोषी ठहराउनुहुन्छ।<verse eid="PRO 12:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 12:3" />दुष्‍टताले कुनै मानिस स्थापित हुन सक्दैन,</para>
  <para style="q2" vid="PRO 12:3">तर धर्मी जनलाई उखेल्न सकिनेछैन।<verse eid="PRO 12:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 12:4" />चरित्रवान् पत्नी आफ्नो पतिको मुकुट हो,</para>
  <para style="q2" vid="PRO 12:4">तर अपमान ल्याउने पत्नीचाहिँ तिनका हड्डीको क्यान्सरजस्तै हो।<verse eid="PRO 12:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 12:5" />धर्मी जनका योजनाहरू न्यायसङ्गत हुन्छन्;</para>
  <para style="q2" vid="PRO 12:5">तर दुष्‍टका सल्‍लाह कपटपूर्ण हुन्छन्।<verse eid="PRO 12:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 12:6" />दुष्‍टका वचनहरूले रक्तपातको निम्ति ढुकिबस्छन्,</para>
  <para style="q2" vid="PRO 12:6">तर धर्मीको बोलीले तिनीहरूलाई उद्धार गर्छ।<verse eid="PRO 12:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 12:7" />दुष्‍टहरू पराजित हुन्छन् र लोप हुन्छन्;</para>
  <para style="q2" vid="PRO 12:7">तर धर्मी जनको घर दृढतासाथ खडा रहन्छ।<verse eid="PRO 12:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 12:8" />मानिसलाई त्यसको बुद्धिअनुसार प्रशंसा गरिन्छ,</para>
  <para style="q2" vid="PRO 12:8">तर बाङ्गाटेढा हृदय भएका मानिसहरू अपहेलित हुन्छन्।<verse eid="PRO 12:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 12:9" />खानको निम्ति भोजन नभए तापनि आफ्नै बढाइचढाइ गर्ने मानिसभन्दा</para>
  <para style="q2" vid="PRO 12:9">बरु साधारण मानिस भएर एक जना मालिकको मात्र सेवक हुनु उत्तम हो।<verse eid="PRO 12:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 12:10" />धर्मी मानिसले आफ्नो पशुहरूको वास्ता गर्छ;</para>
  <para style="q2" vid="PRO 12:10">तर दुष्‍ट मानिसको अति दयापूर्ण काम पनि निर्दयी हुन्छ।<verse eid="PRO 12:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 12:11" />आफ्नो जमिन खनजोत गर्नेसित प्रशस्त भोजन हुनेछ;</para>
  <para style="q2" vid="PRO 12:11">तर दिवासपनाको पछि दौडने मानिसहरू मूर्ख हुन्छन्।<verse eid="PRO 12:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 12:12" />दुष्‍टले खराब मानिसहरूको लुटको अभिलाषा गर्छ,</para>
  <para style="q2" vid="PRO 12:12">तर धर्मी जनको जरा रहिरहन्छ।<verse eid="PRO 12:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 12:13" />दुष्‍ट मानिस आफ्नै पापपूर्ण बोलीले पासोमा पर्छ;</para>
  <para style="q2" vid="PRO 12:13">तर धर्मी मानिस विपत्तिबाट उम्कन्छ।<verse eid="PRO 12:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 12:14" />आफ्ना ओठका फलबाट नै मानिस असल थोकहरूले भरिन्छ;</para>
  <para style="q2" vid="PRO 12:14">र आफ्नो हातका कामको प्रतिफल त्यसले निश्‍चय नै पाउँछ।<verse eid="PRO 12:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 12:15" />मूर्खको चाल त्यसकै लागि ठिक देखिन्छ,</para>
  <para style="q2" vid="PRO 12:15">तर बुद्धिमान् मानिसले अरूको सल्‍लाह सुन्छ।<verse eid="PRO 12:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 12:16" />मूर्खले आफ्नो रिस झट्टै देखाउँछ;</para>
  <para style="q2" vid="PRO 12:16">तर विवेकशील मानिसले अपमानको वास्तै गर्दैन।<verse eid="PRO 12:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 12:17" />साँचो साक्षीले सत्य बोल्छ,</para>
  <para style="q2" vid="PRO 12:17">तर झूटो साक्षीले झूटो कुरा बोल्छ।<verse eid="PRO 12:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 12:18" />विवेकहीनका वचनहरूले मानिसलाई तरवारलेझैँ रोप्छ,</para>
  <para style="q2" vid="PRO 12:18">तर बुद्धिमान्‌को जिब्रोले निको पार्छ।<verse eid="PRO 12:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 12:19" />सत्य बोल्ने ओठ सदा स्थिर रहन्छ;</para>
  <para style="q2" vid="PRO 12:19">तर झूटो बोल्ने जिब्रो केही समय मात्र रहन्छ।<verse eid="PRO 12:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 12:20" />खराब योजना रच्नेहरूका हृदयमा छलकपट हुन्छ;</para>
  <para style="q2" vid="PRO 12:20">तर शान्तिलाई प्रोत्साहन दिनेहरूको निम्ति आनन्द हुन्छ।<verse eid="PRO 12:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 12:21" />धर्मीमाथि हानिको कुनै प्रभाव हुँदैन,</para>
  <para style="q2" vid="PRO 12:21">तर दुष्‍टहरू सङ्कष्‍टले भरिएका हुन्छन्।<verse eid="PRO 12:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 12:22" />याहवेहले झूटो बोल्ने ओठलाई घृणा गर्नुहुन्छ;</para>
  <para style="q2" vid="PRO 12:22">तर भरोसायोग्य मानिसहरूसँग उहाँ प्रसन्‍न हुनुहुन्छ।<verse eid="PRO 12:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 12:23" />विवेकशील मानिसले आफ्नो ज्ञान आफूसितै राख्छ;</para>
  <para style="q2" vid="PRO 12:23">तर मूर्खहरूको हृदयबाट मूर्खता निस्किरहन्छ।<verse eid="PRO 12:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 12:24" />परिश्रमी हातले शासन गर्नेछ;</para>
  <para style="q2" vid="PRO 12:24">तर अल्छेपनाले दासत्वमा पुर्‍याउँछ।<verse eid="PRO 12:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 12:25" />चिन्तित हृदयले मानिसलाई कमजोर तुल्याउँछ,</para>
  <para style="q2" vid="PRO 12:25">तर दयालु वचनले त्यसलाई आनन्द दिन्छ।<verse eid="PRO 12:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 12:26" />धर्मी मानिस आफ्नो मित्रतामा सतर्क रहन्छ;</para>
  <para style="q2" vid="PRO 12:26">तर दुष्‍टको मार्गले तिनीहरूलाई बरालिदिन्छ।<verse eid="PRO 12:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 12:27" />अल्छे मानिसले आफ्नो शिकार पनि पकाउँदैन,</para>
  <para style="q2" vid="PRO 12:27">तर लगनशील मानिस आफ्नो शिकारको प्रशस्तताबाट खान्छ।<verse eid="PRO 12:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 12:28" />धार्मिकताको मार्गमा जीवन हुन्छ;</para>
  <para style="q2" vid="PRO 12:28">त्यही मार्गमा अमरत्व हुन्छ।<verse eid="PRO 12:28" /></para>
  <para style="b" />
  <chapter eid="PRO 12" />
  <chapter number="13" style="c" sid="PRO 13" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 13:1" />बुद्धिमान् छोराछोरीले आफ्ना बुबाको अनुशासनलाई स्वीकार गर्छ;</para>
  <para style="q2" vid="PRO 13:1">तर गिल्‍ला गर्नेले हप्कीलाई बेवास्ता गर्छ।<verse eid="PRO 13:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 13:2" />आफ्ना ओठका फलबाट नै मानिसले असल थोकहरू उपभोग गर्दछ;</para>
  <para style="q2" vid="PRO 13:2">तर विश्‍वासघातीहरू हिंसाकै चाहना गर्छन्।<verse eid="PRO 13:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 13:3" />आफ्नो ओठ जोगाउनेले आफ्नो जीवन जोगाउँछ,</para>
  <para style="q2" vid="PRO 13:3">तर जो उत्ताउलो भई बोल्छ, त्यो नष्‍ट हुन्छ।<verse eid="PRO 13:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 13:4" />अल्छेले उत्कट इच्छा गर्छ, र त्यसलाई केही पनि मिल्दैन;</para>
  <para style="q2" vid="PRO 13:4">तर परिश्रमीका इच्छाहरू पूर्ण रूपमा पूरा हुन्छन्।<verse eid="PRO 13:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 13:5" />धर्मीले झूटलाई घृणा गर्छ;</para>
  <para style="q2" vid="PRO 13:5">तर दुष्‍टले दुर्गन्ध फैलाउँछ,</para>
  <para style="q2" vid="PRO 13:5">र आफैँमा बदनाम ल्याउँछ।<verse eid="PRO 13:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 13:6" />धार्मिकताले निर्दोष मानिसलाई रक्षा गर्छ;</para>
  <para style="q2" vid="PRO 13:6">तर दुष्‍टताले पापीलाई नष्‍ट पार्छ।<verse eid="PRO 13:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 13:7" />कोही मानिस धनी भएको धाक लगाउँछ, र पनि त्यससित केही हुँदैन;</para>
  <para style="q2" vid="PRO 13:7">अर्कोले गरिब भएको बहाना गर्छ, र पनि त्यससित अपार सम्पत्ति हुन्छ।<verse eid="PRO 13:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 13:8" />कुनै मानिसको धनले त्यसको जीवनलाई छुटाउन सक्ला,</para>
  <para style="q2" vid="PRO 13:8">तर गरिब मानिसले जीवनको धम्कीको डर मान्‍नुपर्दैन।<verse eid="PRO 13:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 13:9" />धर्मी जनको ज्योति उज्यालो भई चम्कन्छ,</para>
  <para style="q2" vid="PRO 13:9">तर दुष्‍टको बत्ती निभाइन्छ।<verse eid="PRO 13:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 13:10" />अहङ्कारले झगडा मात्र उब्जाउँछ;</para>
  <para style="q2" vid="PRO 13:10">तर सरसल्‍लाह लिनेहरूले बुद्धि पाइन्छ।<verse eid="PRO 13:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 13:11" />बेइमानीसित कमाएको पैसा सकिन्छ;</para>
  <para style="q2" vid="PRO 13:11">तर परिश्रम गरी कमाएको पैसा बढ्दैजान्छ।<verse eid="PRO 13:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 13:12" />ढिलो भएको आशाले हृदय दुर्बल पार्छ,</para>
  <para style="q2" vid="PRO 13:12">तर पूरा भएको चाहना जीवनको रूख हो।<verse eid="PRO 13:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 13:13" />अर्तीलाई अपमान गर्नेले त्यसको मूल्य चुकाउनेछ;</para>
  <para style="q2" vid="PRO 13:13">तर आज्ञालाई आदर गर्नेले प्रतिफल पाउनेछ।<verse eid="PRO 13:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 13:14" />बुद्धिमान्‌को शिक्षा जीवनको मूल हो,</para>
  <para style="q2" vid="PRO 13:14">जसले मानिसलाई मृत्युको पासोबाट फर्काउँछ।<verse eid="PRO 13:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 13:15" />असल न्यायले निगाह प्राप्‍त गर्छ;</para>
  <para style="q2" vid="PRO 13:15">तर विश्‍वासघातीको मार्गले तिनीहरूलाई विनाशमा डोर्‍याउँछ।<verse eid="PRO 13:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 13:16" />हरेक विवेकशील मानिसले आफ्नो ज्ञानद्वारा काम गर्छ;</para>
  <para style="q2" vid="PRO 13:16">तर मूर्खले आफ्नो मूर्खता प्रकट गर्छ।<verse eid="PRO 13:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 13:17" />दुष्‍ट सन्देशवाहक जोखिममा पर्छ;</para>
  <para style="q2" vid="PRO 13:17">तर विश्‍वासयोग्य दूतले चङ्गाइ ल्याउँछ।<verse eid="PRO 13:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 13:18" />अनुशासनको बेवास्ता गर्नेमाथि गरिबी र शर्म आइपर्नेछन्;</para>
  <para style="q2" vid="PRO 13:18">तर सुधारमा ध्यान दिने व्यक्ति सम्मानित हुन्छ।<verse eid="PRO 13:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 13:19" />पूर्ण भएको चाहना प्राणको निम्ति मिठो हुन्छ;</para>
  <para style="q2" vid="PRO 13:19">तर मूर्खचाहिँ दुष्‍टताबाट फर्कन घृणा गर्छ।<verse eid="PRO 13:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 13:20" />बुद्धिमान्‌हरूसित हिँड्ने बुद्धिमान् नै हुनेछ;</para>
  <para style="q2" vid="PRO 13:20">तर मूर्खहरूको सङ्गत गर्नेले नोक्सानी भोग्नेछ।<verse eid="PRO 13:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 13:21" />पापीलाई विपत्तिले पछ्याउँछ;</para>
  <para style="q2" vid="PRO 13:21">तर धर्मीको प्रतिफलचाहिँ समृद्धि हो।<verse eid="PRO 13:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 13:22" />असल मानिसले आफ्ना नातिनातिनाहरूका निम्ति पैतृक धन छोडिराख्छ;</para>
  <para style="q2" vid="PRO 13:22">तर पापीको धन भने धर्मीको निम्ति नै साँचिएको हुन्छ।<verse eid="PRO 13:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 13:23" />गरिबको नजोतिएको जमिनले प्रशस्त अन्‍न फलाउन सक्ला;</para>
  <para style="q2" vid="PRO 13:23">तर अन्यायले त्यो खोसिदिन्छ।<verse eid="PRO 13:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 13:24" />आफ्ना छोराछोरीलाई छडी नलाउनेले तिनीहरूलाई घृणा गर्छ,</para>
  <para style="q2" vid="PRO 13:24">तर तिनीहरूलाई प्रेम गर्नेले त तिनीहरूलाई अनुशासनमा राख्दछ।<verse eid="PRO 13:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 13:25" />धर्मीले पेटभरि खान्छ;</para>
  <para style="q2" vid="PRO 13:25">तर दुष्‍टको पेट भोकभोकै हुन्छ।<verse eid="PRO 13:25" /></para>
  <para style="b" />
  <chapter eid="PRO 13" />
  <chapter number="14" style="c" sid="PRO 14" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 14:1" />बुद्धिमान् स्त्रीले आफ्नो घर निर्माण गर्छे;</para>
  <para style="q2" vid="PRO 14:1">तर मूर्ख स्त्रीले आफ्नै हातले आफ्नो घर भत्काउँछे।<verse eid="PRO 14:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 14:2" />याहवेहको डर मान्‍नेहरू सत्यतामा जिउँछन्,</para>
  <para style="q2" vid="PRO 14:2">तर उहाँलाई तुच्छ ठान्‍नेहरू कुमार्गमा हिँड्छन्।<verse eid="PRO 14:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 14:3" />मूर्खको बोलीले आफ्नै पिठिउँमा छडी निम्त्याउँछ;</para>
  <para style="q2" vid="PRO 14:3">तर बुद्धिमान्‌को ओठले तिनीहरूलाई बचाउँछ।<verse eid="PRO 14:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 14:4" />जहाँ गोरुहरू छैनन्, त्यहाँ गोठ खाली रहन्छ;</para>
  <para style="q2" vid="PRO 14:4">तर गोरुको बलबाट प्रशस्त फसल कटनी हुन्छ।<verse eid="PRO 14:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 14:5" />साँचो साक्षीले धोका दिँदैन;</para>
  <para style="q2" vid="PRO 14:5">तर झूटो साक्षीले असत्य कुराहरू पोख्छ।<verse eid="PRO 14:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 14:6" />गिल्‍ला गर्नेले बुद्धिको खोजी गर्छ, तर पाउँदैन;</para>
  <para style="q2" vid="PRO 14:6">तर विवेकशील व्यक्तिले सजिलैसित ज्ञान प्राप्‍त गर्छ।<verse eid="PRO 14:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 14:7" />मूर्ख मानिसबाट टाढै बस,</para>
  <para style="q2" vid="PRO 14:7">किनकि उसको ओठमा ज्ञानको कुरा पाइँदैन।<verse eid="PRO 14:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 14:8" />विवेकशील मानिसको बुद्धिले त्यसलाई सही मार्ग दिन्छ,</para>
  <para style="q2" vid="PRO 14:8">तर मूर्खहरूको मूर्खताचाहिँ धोका हो।<verse eid="PRO 14:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 14:9" />दोष मूर्खहरूका निम्ति ठट्ठाको विषय हो;</para>
  <para style="q2" vid="PRO 14:9">तर धर्मीहरूमा भने सद्भावना पाइन्छ।<verse eid="PRO 14:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 14:10" />प्रत्येक मनको तितोपनाले नै जान्दछ;</para>
  <para style="q2" vid="PRO 14:10">र कोही त्यसको आनन्दको सहभागी हुन सक्दैन।<verse eid="PRO 14:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 14:11" />दुष्‍टको घर भत्काइनेछ;</para>
  <para style="q2" vid="PRO 14:11">तर धर्मीको पालमा फलिफाप हुनेछ।<verse eid="PRO 14:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 14:12" />कुनै बाटो मानिसलाई ठिक लाग्ला,</para>
  <para style="q2" vid="PRO 14:12">तर अन्त्यमा त्यसले मृत्युमा पुर्‍याउँछ।<verse eid="PRO 14:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 14:13" />मुखमा हाँसो भए तापनि हृदयमा वेदना हुन सक्छ;</para>
  <para style="q2" vid="PRO 14:13">र हर्षको अन्तचाहिँ शोकमा हुन सक्छ।<verse eid="PRO 14:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 14:14" />विश्‍वासहीनहरूलाई तिनीहरूको चाल अनुसारको प्रतिफल दिइनेछ;</para>
  <para style="q2" vid="PRO 14:14">र असल मानिसले आफ्नो कामको प्रतिफल पाउनेछ।<verse eid="PRO 14:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 14:15" />सोझो मानिसले हरेक कुरामा विश्‍वास गर्छ;</para>
  <para style="q2" vid="PRO 14:15">तर विवेकशील मानिसले आफ्ना पाइलाहरूबारे विचार गर्छ।<verse eid="PRO 14:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 14:16" />बुद्धिमान् मानिसले याहवेहको डर मान्छ, र दुष्‍टतादेखि परै बस्छ;</para>
  <para style="q2" vid="PRO 14:16">तर मूर्खचाहिँ अहङ्कारी हुन्छ, विस्वस्त हुन्छ।<verse eid="PRO 14:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 14:17" />झट्टै रिसाउने मानिसले मूर्ख काम गर्छ;</para>
  <para style="q2" vid="PRO 14:17">र दुष्‍ट योजनाहरू रच्नेलाई घृणा गरिन्छ।<verse eid="PRO 14:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 14:18" />रिसाहाले मूर्खता कमाउँछन्,</para>
  <para style="q2" vid="PRO 14:18">तर विवेकशीलहरूले ज्ञानको मुकुट लगाउँछन्।<verse eid="PRO 14:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 14:19" />खराब मानिसहरू असल मानिसहरूका सामु,</para>
  <para style="q2" vid="PRO 14:19">र दुष्‍टहरू धर्मीहरूका मूलढोकाको सामु झुक्नेछन्।<verse eid="PRO 14:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 14:20" />गरिबहरू आफ्नै छिमेकीद्वारा त्यागिन्छन्;</para>
  <para style="q2" vid="PRO 14:20">तर धनीको धेरै मित्रहरू हुन्छन्।<verse eid="PRO 14:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 14:21" />आफ्नो छिमेकीलाई तुच्छ ठान्‍नेले पाप गर्छ;</para>
  <para style="q2" vid="PRO 14:21">तर त्यो मानिस धन्य हो, जसले अभावमा परेकाहरूमाथि दया देखाउँछ।<verse eid="PRO 14:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 14:22" />के दुष्‍ट योजना रच्नेहरू बरालिँदैनन् र?</para>
  <para style="q2" vid="PRO 14:22">तर असल योजना बनाउनेहरूले प्रेम र विश्‍वासयोग्यता प्राप्‍त गर्छन्।<verse eid="PRO 14:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 14:23" />सबै कठोर परिश्रमले लाभ ल्याउँछ;</para>
  <para style="q2" vid="PRO 14:23">तर कुरा मात्र गर्ने मानिसचाहिँ गरिबीमा पुग्छ।<verse eid="PRO 14:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 14:24" />बुद्धिमान्‌को धन तिनीहरूको मुकुट हो;</para>
  <para style="q2" vid="PRO 14:24">तर मूर्खहरूको मूर्खपनाले मूर्खता मात्र उत्पन्‍न गराउँछ।<verse eid="PRO 14:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 14:25" />साँचो साक्षीले जीवन बचाउँछ;</para>
  <para style="q2" vid="PRO 14:25">तर झूटो साक्षी छलपूर्ण हुन्छ।<verse eid="PRO 14:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 14:26" />याहवेहको डर मान्‍नेको किल्‍ला सुरक्षित रहन्छ;</para>
  <para style="q2" vid="PRO 14:26">र त्यसका छोराछोरीको लागि त्यो एक शरणस्थान हुनेछ।<verse eid="PRO 14:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 14:27" />याहवेहप्रतिको श्रद्धा जीवनको मूल हो,</para>
  <para style="q2" vid="PRO 14:27">जसले मानिसलाई मृत्युको पासोबाट फर्काउँछ।<verse eid="PRO 14:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 14:28" />ठूलो जनसंख्या राजाको महिमा हो;</para>
  <para style="q2" vid="PRO 14:28">तर प्रजाविनाको शासक नष्‍ट हुन्छ।<verse eid="PRO 14:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 14:29" />धैर्यवान् मानिसको समझशक्ति अपार हुन्छ,</para>
  <para style="q2" vid="PRO 14:29">तर झट्टै रिसाउनेले आफ्नो मूर्खतालाई प्रदर्शन गर्छ।<verse eid="PRO 14:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 14:30" />शान्त हृदयले शरीरलाई जीवन दिन्छ;</para>
  <para style="q2" vid="PRO 14:30">तर ईष्‍र्याचाहिँ हड्डीहरूका निम्ति क्यान्सरजस्तै हुन्छ।<verse eid="PRO 14:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 14:31" />गरिबलाई थिचोमिचो गर्नेले आफ्ना सृष्‍टिकर्ताप्रति अपमान दर्शाउँछ;</para>
  <para style="q2" vid="PRO 14:31">तर खाँचोमा परेकाहरूप्रति दयालु हुनेले परमेश्‍वरलाई सम्मान दिन्छ।<verse eid="PRO 14:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 14:32" />जब विपत्ति आउँछ, दुष्‍टहरूको पतन हुन्छ;</para>
  <para style="q2" vid="PRO 14:32">तर धर्मीले चाहिँ मृत्युमा पनि परमेश्‍वरको आश्रय पाउँछ।<verse eid="PRO 14:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PRO 14:33" />बुद्धिमान्‌को हृदयमा बुद्धिले बास गर्छ,</para>
  <para style="q2" vid="PRO 14:33">र मूर्खहरूको बीचमा पनि त्यसले आफूलाई प्रकट गराउँछ।<verse eid="PRO 14:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="PRO 14:34" />धार्मिकताले राष्ट्रलाई उच्‍च तुल्याउँछ;</para>
  <para style="q2" vid="PRO 14:34">तर पाप गर्नुचाहिँ कुनै पनि जातिको निम्ति कलङ्क हुन्छ।<verse eid="PRO 14:34" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="35" style="v" sid="PRO 14:35" />बुद्धिमान् सेवकसँग राजा प्रसन्‍न रहन्छन्;</para>
  <para style="q2" vid="PRO 14:35">तर शर्मलाग्दो सेवकले तिनको रिस जगाउँछ।<verse eid="PRO 14:35" /></para>
  <para style="b" />
  <chapter eid="PRO 14" />
  <chapter number="15" style="c" sid="PRO 15" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 15:1" />नम्र जवाफले क्रोधलाई शान्त पार्छ;</para>
  <para style="q2" vid="PRO 15:1">तर कठोर वचनले रिस उठाउँछ।<verse eid="PRO 15:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 15:2" />बुद्धिमान्‌को जिब्रोले ज्ञानको कुरा गर्छ;</para>
  <para style="q2" vid="PRO 15:2">तर मूर्खको मुखले मूर्खताकै कुरा पोख्छ।<verse eid="PRO 15:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 15:3" />याहवेहको नजर सर्वत्र रहन्छ;</para>
  <para style="q2" vid="PRO 15:3">उहाँले दुष्‍ट र सज्जन दुवैमाथि नजर राखिरहनुहुन्छ।<verse eid="PRO 15:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 15:4" />निको पार्ने जिब्रो जीवनको रूख हो;</para>
  <para style="q2" vid="PRO 15:4">तर छली जिब्रोले आत्मालाई चोट पुर्‍याउँछ।<verse eid="PRO 15:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 15:5" />मूर्खले आफ्नो बुबाको अनुशासनलाई लत्याउँछ;</para>
  <para style="q2" vid="PRO 15:5">तर सुधारलाई ध्यान दिनेले बुद्धिमानी देखाउँछ।<verse eid="PRO 15:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 15:6" />धर्मी जनको घरमा प्रशस्त धन हुन्छ;</para>
  <para style="q2" vid="PRO 15:6">तर दुष्‍टको कमाइले तिनीहरूमाथि विपत्ति ल्याउँछ।<verse eid="PRO 15:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 15:7" />बुद्धिमान्‌का ओठले ज्ञान फैलाउँछ;</para>
  <para style="q2" vid="PRO 15:7">तर मूर्खका हृदयले भने त्यस्तो गर्दैन।<verse eid="PRO 15:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 15:8" />दुष्‍टका बलिदानलाई याहवेहले घृणा गर्नुहुन्छ;</para>
  <para style="q2" vid="PRO 15:8">तर धर्मीका प्रार्थनाले उहाँलाई प्रसन्‍न तुल्याउँछ।<verse eid="PRO 15:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 15:9" />याहवेहले दुष्‍टको मार्गलाई घृणा गर्नुहुन्छ;</para>
  <para style="q2" vid="PRO 15:9">तर धार्मिकताको पछि लाग्नेहरूलाई उहाँले प्रेम गर्नुहुन्छ।<verse eid="PRO 15:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 15:10" />आफ्नो अनुशासनको मार्ग त्याग्नेले कठोर ताडना भोग्नुपर्छ;</para>
  <para style="q2" vid="PRO 15:10">जसले सुधारलाई घृणा गर्छ, त्यो मर्नेछ।<verse eid="PRO 15:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 15:11" />मृत्यु र विनाश<note caller="+" style="f"><char style="fr" closed="false">15:11 </char><char style="ft" closed="false">मूल भाषामा </char><char style="fqa" closed="false">सिओल र अबाडोन</char></note> दुवै याहवेहको सामु खुलस्त रहन्छन्;</para>
  <para style="q2" vid="PRO 15:11">मानिसको हृदय झन् कति खुलस्त होला!<verse eid="PRO 15:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 15:12" />गिल्‍ला गर्नेले सुधारलाई मन पराउँदैन;</para>
  <para style="q2" vid="PRO 15:12">त्यसैले तिनीहरू बुद्धिमान्‌लाई तिरस्कार गर्छन्।<verse eid="PRO 15:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 15:13" />हर्षित हृदयले अनुहार प्रसन्‍न पारिदिन्छ;</para>
  <para style="q2" vid="PRO 15:13">तर दुःखित हृदयले आत्मालाई चोट पुर्‍याउँछ।<verse eid="PRO 15:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 15:14" />विवेकशील हृदयले ज्ञानको खोजी गर्छ;</para>
  <para style="q2" vid="PRO 15:14">तर मूर्खको भोजन मूर्खता हो।<verse eid="PRO 15:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 15:15" />थिचोमिचोमा परेकाहरूका सबै दिन अति दुःखमय हुन्छ;</para>
  <para style="q2" vid="PRO 15:15">तर प्रसन्‍न हृदय सधैँ सुखी हुन्छ।<verse eid="PRO 15:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 15:16" />धेरै सम्पत्ति भएर चिन्तित हुनुभन्दा</para>
  <para style="q2" vid="PRO 15:16">याहवेहको भयको साथमा थोरै धन हुनु नै असल हो।<verse eid="PRO 15:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 15:17" />घृणाले भरिएको घरमा पोसाएको बहरको मासु खानुभन्दा</para>
  <para style="q2" vid="PRO 15:17">बरु प्रेमसित सागसब्जी खानु नै बेस हो।<verse eid="PRO 15:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 15:18" />तातो रिस भएको मानिसले झगडा उत्पन्‍न गराउँछ;</para>
  <para style="q2" vid="PRO 15:18">तर धैर्यवान् मानिसले कलह शान्त गराउँछ।<verse eid="PRO 15:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 15:19" />अल्छेको मार्ग काँडाले छेकेको हुन्छ;</para>
  <para style="q2" vid="PRO 15:19">तर धर्मीको मार्गचाहिँ राजमार्ग हो।<verse eid="PRO 15:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 15:20" />बुद्धिमान् छोराछोरीले आफ्नो बुबालाई हर्षित तुल्याउँछ,</para>
  <para style="q2" vid="PRO 15:20">तर मूर्ख मानिसले आफ्नी आमालाई तुच्छ ठान्छ।<verse eid="PRO 15:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 15:21" />विवेकहीन मानिसलाई मूर्खताले आनन्द दिन्छ;</para>
  <para style="q2" vid="PRO 15:21">तर समझशक्ति भएको मानिस सीधा बाटोमा हिँड्छ।<verse eid="PRO 15:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 15:22" />सल्‍लाहको अभावमा योजनाहरू असफल हुन्छन्;</para>
  <para style="q2" vid="PRO 15:22">तर धेरै सल्‍लाहकार छन् भने ती सफल हुन्छन्।<verse eid="PRO 15:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 15:23" />उचित जवाफ दिन पाउँदा मानिसलाई खुशी लाग्छ;</para>
  <para style="q2" vid="PRO 15:23">र ठिक समयमा भनिएको वचन कति असल हुन्छ!<verse eid="PRO 15:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 15:24" />समझदार मानिसलाई जीवनको बाटोले माथितिर डोर्‍याउँछ;</para>
  <para style="q2" vid="PRO 15:24">त्यसले उसलाई तल पातालतिर जानदेखि जोगाउँछ।<verse eid="PRO 15:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 15:25" />याहवेहले अहङ्कारी मानिसको घर भताभुङ्ग पारिदिनुहुन्छ,</para>
  <para style="q2" vid="PRO 15:25">तर उहाँले विधवाको सिमाना स्थिर राख्नुहुन्छ।<verse eid="PRO 15:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 15:26" />याहवेह दुष्‍टका विचारहरूलाई घृणा गर्नुहुन्छ;</para>
  <para style="q2" vid="PRO 15:26">तर शुद्ध वचन उहाँलाई मन पर्छ।<verse eid="PRO 15:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 15:27" />लोभीले आफ्नो परिवारमा विनाश ल्याउँछ;</para>
  <para style="q2" vid="PRO 15:27">तर जसले घूसलाई घृणा गर्छ, त्यो बाँच्नेछ।<verse eid="PRO 15:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 15:28" />धर्मीको हृदयले जवाफ दिन अगि त्यसलाई तौलिन्छ;</para>
  <para style="q2" vid="PRO 15:28">तर दुष्‍टको मुखले खराबी कुराहरू पोखिहाल्छ।<verse eid="PRO 15:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 15:29" />याहवेह दुष्‍टदेखि टाढै रहनुहुन्छ;</para>
  <para style="q2" vid="PRO 15:29">तर उहाँले धर्मीको प्रार्थना सुन्‍नुहुन्छ।<verse eid="PRO 15:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 15:30" />हँसिलो अनुहारले हृदयमा आनन्द ल्याउँछ;</para>
  <para style="q2" vid="PRO 15:30">र असल समाचारले हड्डीलाई हर्षित तुल्याउँछ।<verse eid="PRO 15:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 15:31" />जसले जीवन दिने हप्कीलाई सुन्छ,</para>
  <para style="q2" vid="PRO 15:31">त्यो बुद्धिमान्‌हरूका साथमा रहनेछ।<verse eid="PRO 15:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 15:32" />अनुशासनको वास्ता नगर्नेले आफूलाई घृणा गर्छ;</para>
  <para style="q2" vid="PRO 15:32">तर सुधारमा ध्यान दिनेले समझशक्ति प्राप्‍त गर्छ।<verse eid="PRO 15:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PRO 15:33" />याहवेहप्रतिको श्रद्धाले नै मानिसलाई बुद्धि सिकाउँछ;</para>
  <para style="q2" vid="PRO 15:33">अनि सम्मान पाउनुभन्दा अगि नम्रता आउँछ।<verse eid="PRO 15:33" /></para>
  <para style="b" />
  <chapter eid="PRO 15" />
  <chapter number="16" style="c" sid="PRO 16" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 16:1" />हृदयका योजनाहरू मानिसका हुन्;</para>
  <para style="q2" vid="PRO 16:1">तर जिब्रोको ठिक जवाफ भने याहवेहबाट नै आउँछ।<verse eid="PRO 16:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 16:2" />हरेक मानिसलाई आफ्ना मार्गहरू निर्दोष लाग्छ;</para>
  <para style="q2" vid="PRO 16:2">तर अभिप्रायहरू याहवेहबाट नै जाँचिएका हुन्छन्।<verse eid="PRO 16:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 16:3" />तिमीले गर्ने जुनसुकै कुरा याहवेहलाई सुम्पिदेऊ,</para>
  <para style="q2" vid="PRO 16:3">र उहाँले तिम्रा योजनाहरू सफल पार्नुहुनेछ।<verse eid="PRO 16:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 16:4" />याहवेहले हरेक कुरा आफ्नै उद्देश्यका निम्ति बनाउनुहुन्छ;</para>
  <para style="q2" vid="PRO 16:4">उहाँले दुष्‍टलाई समेत विनाशको दिनको निम्ति राख्नुभएको छ।<verse eid="PRO 16:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 16:5" />हृदयमा अहङ्कार भएका सबैलाई याहवेहले घृणा गर्नुहुन्छ;</para>
  <para style="q2" vid="PRO 16:5">यो निश्‍चित छ, तिनीहरू दण्ड नपाई छोडिनेछैनन्।<verse eid="PRO 16:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 16:6" />प्रेम र सत्यताद्वारा पापको प्रायश्‍चित हुन्छ;</para>
  <para style="q2" vid="PRO 16:6">याहवेहप्रतिको श्रद्धाद्वारा मानिस खराबीदेखि अलग रहन्छ।<verse eid="PRO 16:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 16:7" />जब कुनै मानिसको जीवन याहवेहको दृष्‍टिमा मनपर्दो हुन्छ,</para>
  <para style="q2" vid="PRO 16:7">उहाँले त्यसका शत्रुलाई पनि त्यससित मिलापमा ल्याउनुहुन्छ।<verse eid="PRO 16:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 16:8" />बेइमानी गरेर कमाएको प्रशस्त कमाइभन्दा,</para>
  <para style="q2" vid="PRO 16:8">धार्मिकताको साथमा थोरै भएको असल हुन्छ।<verse eid="PRO 16:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 16:9" />मानिसले हृदयमा आफ्नो योजना बनाउँछ;</para>
  <para style="q2" vid="PRO 16:9">तर त्यसका कदमहरू भने याहवेहले नै निर्धारण गर्नुहुन्छ।<verse eid="PRO 16:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 16:10" />राजाको ओठले ईश्‍वरवाणी बोल्दछ;</para>
  <para style="q2" vid="PRO 16:10">र तिनको मुखले न्यायलाई चोट पुर्‍याउनुहुँदैन।<verse eid="PRO 16:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 16:11" />ठिक तराजु र तौल याहवेहकै हुन्,</para>
  <para style="q2" vid="PRO 16:11">थैलोभित्रका सबै ढकहरू उहाँद्वारा नै बनिएका हुन्।<verse eid="PRO 16:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 16:12" />राजाहरूले कुकर्मलाई घृणा गर्दछन्,</para>
  <para style="q2" vid="PRO 16:12">किनकि धार्मिकताद्वारा नै सिंहासन स्थापित हुन्छ।<verse eid="PRO 16:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 16:13" />राजाहरूले इमानदार ओठलाई मन पराउँछन्;</para>
  <para style="q2" vid="PRO 16:13">सत्य बोल्ने मानिसलाई तिनीहरूले मन पराउँछन्।<verse eid="PRO 16:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 16:14" />राजाको क्रोध मृत्युको दूत हो,</para>
  <para style="q2" vid="PRO 16:14">तर बुद्धिमान् मानिसले त्यसलाई शान्त गराउँछ।<verse eid="PRO 16:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 16:15" />जब राजाको अनुहार उज्यालो हुन्छ, तब त्यसको अर्थ जीवन हुन्छ;</para>
  <para style="q2" vid="PRO 16:15">अनि तिनको निगाह बसन्त ऋतुका झरीको बादलजस्तै हो।<verse eid="PRO 16:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 16:16" />सुनभन्दा बुद्धि प्राप्‍त गर्नु,</para>
  <para style="q2" vid="PRO 16:16">र चाँदीभन्दा समझदारी रोज्नु कत्ति असल हो!<verse eid="PRO 16:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 16:17" />धर्मीको राजमार्ग खराबीदेखि अलग रहन्छ;</para>
  <para style="q2" vid="PRO 16:17">आफ्नो चालको रक्षा गर्नेहरूले आफ्नो जीवनको रक्षा गर्छन्।<verse eid="PRO 16:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 16:18" />विनाशको अगि अहङ्कार आउँछ,</para>
  <para style="q2" vid="PRO 16:18">र पतनको अगि घमण्डी आत्मा आउँछ।<verse eid="PRO 16:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 16:19" />अहङ्कारीहरूसित लुटको मालमा सहभागी हुनुभन्दा</para>
  <para style="q2" vid="PRO 16:19">आत्मामा नम्र भई थिचोमिचोमा परेकाहरूका बीचमा रहनु असल हो।<verse eid="PRO 16:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 16:20" />जसले निर्देशनलाई ध्यान दिन्छ, उसको उन्‍नति हुन्छ,</para>
  <para style="q2" vid="PRO 16:20">धन्य हो त्यो मानिस, जसले याहवेहमा भरोसा राख्दछ।<verse eid="PRO 16:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 16:21" />हृदयमा बुद्धिमान् हुनेहरूलाई विवेकशील भनिन्छन्,</para>
  <para style="q2" vid="PRO 16:21">र मिठा वचनहरूले अर्तीलाई उत्साहित पार्छन्।<verse eid="PRO 16:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 16:22" />समझशक्ति भएकाहरूका निम्ति त्यो जीवनको मूल हो,</para>
  <para style="q2" vid="PRO 16:22">तर मूर्खताले मूर्खहरूमाथि दण्ड ल्याउँछ।<verse eid="PRO 16:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 16:23" />बुद्धिमान् मानिसको हृदयले बुद्धि ल्याउँछ,</para>
  <para style="q2" vid="PRO 16:23">र त्यसका ओठले अर्तीलाई बढाउँछ।<verse eid="PRO 16:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 16:24" />मिठा वचनहरू महको चाकाजस्तै हुन्छन्,</para>
  <para style="q2" vid="PRO 16:24">जो प्राणको निम्ति मिठो र हड्डीलाई निको पार्ने हुन्छ।<verse eid="PRO 16:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 16:25" />कुनै बाटो मानिसलाई ठिक लाग्ला,</para>
  <para style="q2" vid="PRO 16:25">तर अन्त्यमा त्यसले मृत्युमा पुर्‍याउँछ।<verse eid="PRO 16:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 16:26" />परिश्रमीको पेटले त्यसलाई काम गर्न लगाउँछ;</para>
  <para style="q2" vid="PRO 16:26">त्यसको भोकले त्यसलाई काम गर्न लगाउँछ।<verse eid="PRO 16:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 16:27" />बदमासले दुष्‍ट युक्ति रच्दछ;</para>
  <para style="q2" vid="PRO 16:27">र त्यसका बोलीवचन भतभती पोल्ने आगोजस्तै हुन्छ।<verse eid="PRO 16:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 16:28" />भ्रष्‍ट मानिसले विवाद उत्पन्‍न गराउँछ,</para>
  <para style="q2" vid="PRO 16:28">र कुराउटेले घनिष्‍ठ मित्रहरूमा फाटो ल्याउँछ।<verse eid="PRO 16:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 16:29" />उपद्रवी मानिसले आफ्नो छिमेकीलाई लोभ्याउँछ,</para>
  <para style="q2" vid="PRO 16:29">र त्यसले उसलाई खराब मार्गतिर लैजान्छ।<verse eid="PRO 16:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 16:30" />आफ्नो आँखा झिम्काउनेले षड्यन्त्र रचेको हुन्छ;</para>
  <para style="q2" vid="PRO 16:30">आफ्ना ओठ लेब्र्याउनेले षड्यन्त्र रचेको हुन्छ।<verse eid="PRO 16:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 16:31" />फूलेको केश शोभाको मुकुट हो,</para>
  <para style="q2" vid="PRO 16:31">यो धर्मी जीवनबाट प्राप्‍त हुँदछ।<verse eid="PRO 16:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 16:32" />धैर्यवान् मानिस हुनु लडाइँका योद्धा हुनुभन्दा उत्तम हो,</para>
  <para style="q2" vid="PRO 16:32">आफ्नो आत्मा नियन्त्रण राख्नु सहर कब्जा गर्नुभन्दा बेस हो।<verse eid="PRO 16:32" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="33" style="v" sid="PRO 16:33" />चिट्ठा त हालिन्छ,</para>
  <para style="q2" vid="PRO 16:33">तर त्यसको हरेक निर्णय याहवेहबाट नै हुन्छ।<verse eid="PRO 16:33" /></para>
  <para style="b" />
  <chapter eid="PRO 16" />
  <chapter number="17" style="c" sid="PRO 17" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 17:1" />शान्ति र मौनसित निस्तो गाँस खानु</para>
  <para style="q2" vid="PRO 17:1">कलहले भरिएको घरमा भोज गर्नुभन्दा बेस हो।<verse eid="PRO 17:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 17:2" />विवेकी सेवकले अयोग्य छोरामाथि शासन गर्छ,</para>
  <para style="q2" vid="PRO 17:2">र त्यसले एउटा पुत्रको रूपमा परिवारमा पैतृक सम्पत्ति पाउनेछ।<verse eid="PRO 17:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 17:3" />चाँदी पगाल्ने भाँडो र सुन खार्ने भट्टी हुन्छ,</para>
  <para style="q2" vid="PRO 17:3">तर हृदयलाई जाँच्नुहुने याहवेह हुनुहुन्छ।<verse eid="PRO 17:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 17:4" />दुष्‍ट मानिसले दुष्‍ट कुरा सुन्छ;</para>
  <para style="q2" vid="PRO 17:4">झूटो बोल्नेले विनाशकारी जिब्रोमाथि ध्यान दिन्छ।<verse eid="PRO 17:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 17:5" />गरिबलाई गिल्‍ला गर्नेले उसका सृष्‍टिकर्तालाई अपमान गर्छ;</para>
  <para style="q2" vid="PRO 17:5">अरूका विपत्तिमा रमाउने जो कोही पनि दण्डबाट उक्‍कनेछैन।<verse eid="PRO 17:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 17:6" />नातिनातिनाहरू वृद्धहरूका मुकुट हुन्,</para>
  <para style="q2" vid="PRO 17:6">र छोराछोरीहरू तिनीहरूका आमाबुबाका गर्व हुन्।<verse eid="PRO 17:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 17:7" />भक्तिहीन मूर्खको बोली असुहाउँदो हुन्छ भने,</para>
  <para style="q2" vid="PRO 17:7">शासनको निम्ति झूटो बोल्ने ओठ त झन् कति असुहाउँदो हुन्छ!<verse eid="PRO 17:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 17:8" />घूस दिनेको लागि त्यो टुनामुनाजस्तै हो;</para>
  <para style="q2" vid="PRO 17:8">उसले जे गरे तापनि ऊ सफल हुन्छ भन्‍ने उसलाई लाग्छ।<verse eid="PRO 17:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 17:9" />अपराधलाई ढाकिदिनेले प्रेम जगाउँछ;</para>
  <para style="q2" vid="PRO 17:9">तर कुरा दोहोर्‍याउने जोसुकैले पनि घनिष्‍ठ मित्रहरूमा फाटो ल्याउँछ।<verse eid="PRO 17:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 17:10" />मूर्खलाई सय कोर्रा लगाउनुभन्दा त</para>
  <para style="q2" vid="PRO 17:10">बरु समझशक्ति भएको मानिसलाई एकै हप्कीले असर पार्छ।<verse eid="PRO 17:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 17:11" />खराब मानिसको झुकाव विद्रोहतिर मात्रै हुन्छ;</para>
  <para style="q2" vid="PRO 17:11">त्यसको विरुद्धमा एउटा निर्दयी अधिकृत पठाइनेछ।<verse eid="PRO 17:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 17:12" />मूर्खलाई त्यसको मूर्खतामा भेट्नुभन्दा त</para>
  <para style="q2" vid="PRO 17:12">बरु बच्‍चा खोसिएको भालु भेट्नु असल हो।<verse eid="PRO 17:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 17:13" />यदि मानिसले भलाइको साटो खराबी गर्छ भने,</para>
  <para style="q2" vid="PRO 17:13">त्यसको घर खराबीले कहिल्यै छोड्नेछैन।<verse eid="PRO 17:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 17:14" />झगडा सुरु हुनु पानीको बाँध फुट्नुजस्तै हो;</para>
  <para style="q2" vid="PRO 17:14">यसकारण झगडा बढ्नुभन्दा अगि नै त्यसलाई अन्त्य गरिदेऊ।<verse eid="PRO 17:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 17:15" />दोषीलाई छोडिदिने र निर्दोषलाई दण्ड दिने—</para>
  <para style="q2" vid="PRO 17:15">यी दुवैलाई याहवेहले घृणा गर्नुहुन्छ।<verse eid="PRO 17:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 17:16" />मूर्खको हातमा रकम के काम लाग्ला र?</para>
  <para style="q2" vid="PRO 17:16">किनकि त्यसमा बुद्धि प्राप्‍त गर्ने इच्छा नै हुँदैन।<verse eid="PRO 17:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 17:17" />मित्रले सबै समय प्रेम गर्छ,</para>
  <para style="q2" vid="PRO 17:17">र दाजुभाइचाहिँ दुःखको बेलाका निम्ति जन्मेका हुन्छन्।<verse eid="PRO 17:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 17:18" />विवेकहीन मानिसले भाकल गर्छ,</para>
  <para style="q2" vid="PRO 17:18">र आफ्नो छिमेकीको जमानी बस्छ।<verse eid="PRO 17:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 17:19" />झगडा रुचाउनेले पाप रुचाउँछ,</para>
  <para style="q2" vid="PRO 17:19">र जो घमण्डले धाक लगाउँछ, त्यो नाश हुनेछ।<verse eid="PRO 17:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 17:20" />भ्रष्‍ट हृदय भएको मानिसको उन्‍नति हुँदैन;</para>
  <para style="q2" vid="PRO 17:20">जसको जिब्रो छली छ, त्यो सङ्कष्‍टमा पर्छ।<verse eid="PRO 17:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 17:21" />मूर्ख छोराछोरीले सन्ताप ल्याउँछन्,</para>
  <para style="q2" vid="PRO 17:21">मूर्खको बुबालाई खुशी मिल्दैन।<verse eid="PRO 17:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 17:22" />प्रसन्‍न हृदय असल औषधी हो,</para>
  <para style="q2" vid="PRO 17:22">तर पेलिएको आत्माले हड्डीहरूलाई सुकाइदिन्छ।<verse eid="PRO 17:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 17:23" />दुष्‍ट मानिसले गुप्‍तमा घूस लिन्छ</para>
  <para style="q2" vid="PRO 17:23">र न्याय प्राणाली बिगारिदिन्छ।<verse eid="PRO 17:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 17:24" />विवेकी मानिसले आफ्नो दृष्‍टिमा बुद्धि राख्छ,</para>
  <para style="q2" vid="PRO 17:24">तर मूर्खको आँखा पृथ्वीको अन्त्यसम्म यताउता डुलिरहन्छ।<verse eid="PRO 17:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 17:25" />मूर्ख छोराछोरीले आफ्नो बुबालाई सन्ताप दिन्छन्,</para>
  <para style="q2" vid="PRO 17:25">र त्यसलाई जन्माउनेमाथि तितोपन ल्याउँछन्।<verse eid="PRO 17:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 17:26" />निर्दोष मानिसलाई दण्ड दिनु,</para>
  <para style="q2" vid="PRO 17:26">वा आफ्नो इमानदारीको खातिर कर्मचारीहरूलाई कोर्रा लगाउनु ठिक होइन।<verse eid="PRO 17:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 17:27" />समझदार मानिसले आफ्नो वचन होसियारीसाथ बोल्छ,</para>
  <para style="q2" vid="PRO 17:27">र समझशक्ति भएको मानिस ठण्डा मिजासको हुन्छ।<verse eid="PRO 17:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 17:28" />चुप लाग्ने मूर्ख पनि बुद्धिमान् ठानिन्छ,</para>
  <para style="q2" vid="PRO 17:28">र आफ्नो मुख बन्द राख्यो भने त्यो विवेकी मानिन्छ।<verse eid="PRO 17:28" /></para>
  <para style="b" />
  <chapter eid="PRO 17" />
  <chapter number="18" style="c" sid="PRO 18" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 18:1" />मित्रभाव नभएको मानिस स्वार्थको पछि लाग्छ;</para>
  <para style="q2" vid="PRO 18:1">त्यसले सबै उचित न्यायलाई चुनौती दिँदछ।<verse eid="PRO 18:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 18:2" />मूर्खले समझदारी मन पराउँदैन,</para>
  <para style="q2" vid="PRO 18:2">तर आफ्नै विचारमा धाक लगाउन प्रसन्‍न हुन्छ।<verse eid="PRO 18:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 18:3" />दुष्‍टता आउँदा घृणा पनि आउँछ;</para>
  <para style="q2" vid="PRO 18:3">र शर्मको साथमा अपमान आउँछ।<verse eid="PRO 18:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 18:4" />मानिसको मुखका वचनहरू गहिरा पानीजस्तै हुन्छन्;</para>
  <para style="q2" vid="PRO 18:4">तर बुद्धिको मुहानचाहिँ बग्दै गरेको खोलाजस्तै सफा हुन्छ।<verse eid="PRO 18:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 18:5" />दुष्‍टको पक्ष लिनु राम्रो होइन</para>
  <para style="q2" vid="PRO 18:5">अथवा निर्दोषलाई न्याय नदिनु उचित होइन।<verse eid="PRO 18:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 18:6" />मूर्खको ओठले त्यसलाई झगडामा पार्छ,</para>
  <para style="q2" vid="PRO 18:6">र त्यसको मुखले पिटाइ निम्त्याउँछ।<verse eid="PRO 18:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 18:7" />मूर्खको मुख नै त्यसको विनाश हो,</para>
  <para style="q2" vid="PRO 18:7">अनि त्यसको ओठचाहिँ आफ्नै जीवनका लागि पासो हुन्छ।<verse eid="PRO 18:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 18:8" />कुरौटेका बोलीहरू स्वादिष्‍ठ गाँसजस्तै हुन्छन्,</para>
  <para style="q2" vid="PRO 18:8">ती मानिसका भित्री भागहरूमा पुग्छन्।<verse eid="PRO 18:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 18:9" />आफ्नो काममा अल्छी गरिरहने व्यक्ति</para>
  <para style="q2" vid="PRO 18:9">सर्वनाश गर्नेको भाइ हो।<verse eid="PRO 18:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 18:10" />याहवेहको नाम किल्‍ला भएको सहरमा हो;</para>
  <para style="q2" vid="PRO 18:10">धर्मीहरू त्यहाँ दगुर्दै जान्छन्, र सुरक्षित रहन्छन्।<verse eid="PRO 18:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 18:11" />धनीको धन नै तिनीहरूका किल्‍ला भएको सहर हो;</para>
  <para style="q2" vid="PRO 18:11">तिनीहरूले त्यसलाई नाप्‍न नसकिने पर्खाल सम्झन्छन्।<verse eid="PRO 18:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 18:12" />आफ्नो पतन आउनुभन्दा अगि मानिसको हृदय घमण्डी हुन्छ,</para>
  <para style="q2" vid="PRO 18:12">तर सम्मानको अगि नम्रता आउँछ।<verse eid="PRO 18:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 18:13" />जसले सुन्‍न अगि नै जवाफ दिन्छ,</para>
  <para style="q2" vid="PRO 18:13">त्यो त्यसका निम्ति मूर्खता र शर्म हो।<verse eid="PRO 18:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 18:14" />मानिसको आत्माले त्यसलाई बिरामी अवस्थामा सम्हाल्छ,</para>
  <para style="q2" vid="PRO 18:14">तर टुटेको आत्मालाई कसले सहन सक्छ र?<verse eid="PRO 18:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 18:15" />विवेकीको हृदयले ज्ञान प्राप्‍त गर्छ,</para>
  <para style="q2" vid="PRO 18:15">बुद्धिमान्‌को कानले त्यो खोजी निकाल्छ।<verse eid="PRO 18:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 18:16" />उपहारले दाताको निम्ति बाटो खोलिदिन्छ,</para>
  <para style="q2" vid="PRO 18:16">र त्यसलाई महान् व्यक्तिहरूको उपस्थितिमा लैजान्छ।<verse eid="PRO 18:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 18:17" />दोस्रो व्यक्ति आएर प्रश्नहरू नगरुन्जेल,</para>
  <para style="q2" vid="PRO 18:17">मुद्दा हाल्ने पहिलो व्यक्ति नै ठिक देखा पर्छ।<verse eid="PRO 18:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 18:18" />चिट्ठा हालेर झगडा मिलाइन्छ,</para>
  <para style="q2" vid="PRO 18:18">र बलिया प्रतिद्वन्दीहरूलाई अलग राखिन्छ।<verse eid="PRO 18:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 18:19" />चित्त दुःखाएको भाइलाई मनाउनु किल्‍ला भएको सहर जित्नुभन्दा गाह्रो हुन्छ;</para>
  <para style="q2" vid="PRO 18:19">अनि विवादचाहिँ किल्‍लामा आग्ला लगाइएका ढोकाहरूजस्तै हुन्छन्।<verse eid="PRO 18:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 18:20" />मानिसको पेट त्यसको मुखको फलले भरिन्छ;</para>
  <para style="q2" vid="PRO 18:20">त्यसको ओठको कटनीद्वारा त्यो तृप्‍त हुन्छ।<verse eid="PRO 18:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 18:21" />जीवन र मृत्युको शक्ति जिब्रोमा हुन्छ;</para>
  <para style="q2" vid="PRO 18:21">त्यसलाई प्रेम गर्नेहरूले त्यसको फल खानेछन्।<verse eid="PRO 18:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 18:22" />पत्नी पाउनेले असल कुरा पाउँछ,</para>
  <para style="q2" vid="PRO 18:22">र त्यसले याहवेहबाट निगाह प्राप्‍त गर्छ।<verse eid="PRO 18:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 18:23" />गरिब मानिसले दयाको बिन्ती चढाउँछ,</para>
  <para style="q2" vid="PRO 18:23">तर धनी मानिसले रुखो जवाफ दिन्छ।<verse eid="PRO 18:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 18:24" />जसका साथीहरू अविश्‍वासयोग्य छन्; उसलाई उनीहरूले नोक्सानी पुर्‍याउन सक्छन्,</para>
  <para style="q2" vid="PRO 18:24">तर कुनै मित्रचाहिँ दाजुभाइभन्दा पनि नजिक हुन्छ।<verse eid="PRO 18:24" /></para>
  <para style="b" />
  <chapter eid="PRO 18" />
  <chapter number="19" style="c" sid="PRO 19" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 19:1" />भ्रष्‍ट ओठ भएको मानिसभन्दा त</para>
  <para style="q2" vid="PRO 19:1">निर्दोष जीवन भएको गरिब असल हो।<verse eid="PRO 19:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 19:2" />ज्ञानविनाको उत्साह असल हुँदैन;</para>
  <para style="q2" vid="PRO 19:2">हतार गर्नेले बाटो बिराउँछ।<verse eid="PRO 19:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 19:3" />मानिसको आफ्नै मूर्खताले त्यसको जीवन बरबादीमा पुर्‍याउँछ;</para>
  <para style="q2" vid="PRO 19:3">तरै पनि त्यसको हृदयले याहवेहको विरुद्धमा रिस प्रकट गर्छ।<verse eid="PRO 19:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 19:4" />धनले धेरै मित्रहरू बनाउँछ;</para>
  <para style="q2" vid="PRO 19:4">तर गरिबको सबैभन्दा नजिकको साथीले पनि तिनीहरूलाई त्यागिदिन्छ।<verse eid="PRO 19:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 19:5" />झूटो गवाही दिने दण्ड नपाई उम्कनेछैन,</para>
  <para style="q2" vid="PRO 19:5">र झूटो कुरा गर्ने मानिस स्वतन्त्र हुँदैन।<verse eid="PRO 19:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 19:6" />धेरैले शासकदेखि निगाह प्राप्‍त गर्न चाहन्छन्;</para>
  <para style="q2" vid="PRO 19:6">र सबै मानिसहरू उपहार दिनेको मित्र हुन्छन्।<verse eid="PRO 19:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 19:7" />गरिब मानिस आफ्नै नातेदारहरूद्वारा घृणा गरिन्छ,</para>
  <para style="q2" vid="PRO 19:7">त्यसका मित्रहरू झन् त्यसबाट कति टाढा रहलान्!</para>
  <para style="q1" vid="PRO 19:7">त्यसले बिन्तीभाउ गरी तिनीहरूका पछि लागे तापनि</para>
  <para style="q2" vid="PRO 19:7">तिनीहरू केही प्रतिक्रिया दिँदैनन्<note caller="+" style="f"><char style="fr" closed="false">19:7 </char><char style="ft" closed="false">मूल भाषामा यसको अर्थ अनिश्‍चित छ।</char></note>।<verse eid="PRO 19:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 19:8" />बुद्धि पाउनेले आफ्नै जीवनलाई प्रेम गर्छ;</para>
  <para style="q2" vid="PRO 19:8">समझशक्तिको कदर गर्ने व्यक्तिको फलिफाप हुन्छ।<verse eid="PRO 19:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 19:9" />झूटो गवाही दिने दण्ड नपाई उम्कनेछैन;</para>
  <para style="q2" vid="PRO 19:9">र झूटो कुरा गर्ने नष्‍ट हुनेछ।<verse eid="PRO 19:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 19:10" />मूर्खलाई विलासी भएर बस्‍न सुहाउँदैन;</para>
  <para style="q2" vid="PRO 19:10">दासलाई राजकुमारहरूमाथि शासन गर्न झन् पटक्‍कै सुहाउँदैन!<verse eid="PRO 19:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 19:11" />बुद्धिले मानिसलाई धैर्यता दिन्छ;</para>
  <para style="q2" vid="PRO 19:11">अपराध बेवास्ता गर्नुचाहिँ उसको लागि महिमा हुन्छ।<verse eid="PRO 19:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 19:12" />राजाको क्रोध सिंहको गर्जनजस्तै हुन्छ;</para>
  <para style="q2" vid="PRO 19:12">तर तिनको निगाहचाहिँ घाँसमाथि परेको शीतजस्तै हुन्छ।<verse eid="PRO 19:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 19:13" />मूर्ख छोराछोरी आफ्ना बुबाको लागि पतन हो;</para>
  <para style="q2" vid="PRO 19:13">र कचकचे पत्नीचाहिँ</para>
  <para style="q2" vid="PRO 19:13">तपतप चुहिरहने छानाजस्तै हो।<verse eid="PRO 19:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 19:14" />घर र सम्पत्ति आमाबुबाबाट आएका हुन्छन्,</para>
  <para style="q2" vid="PRO 19:14">तर विवेकी पत्नीचाहिँ याहवेहले मात्र दिन सक्नुहुन्छ।<verse eid="PRO 19:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 19:15" />अल्छेपनले घोर निद्रा ल्याउँछ,</para>
  <para style="q2" vid="PRO 19:15">र काम नगर्ने मानिस भोकै रहन्छ।<verse eid="PRO 19:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 19:16" />आज्ञापालन गर्नेले आफ्नो जीवनको रक्षा गर्छ,</para>
  <para style="q2" vid="PRO 19:16">तर तिनलाई तिरस्कार गर्नेहरू मर्नेछन्।<verse eid="PRO 19:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 19:17" />गरिबहरूप्रति दयालु हुनेले याहवेहलाई सापट दिन्छ,</para>
  <para style="q2" vid="PRO 19:17">र उहाँले तिनीहरूको कामको प्रतिफल फिर्ता दिनुहुनेछ।<verse eid="PRO 19:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 19:18" />आफ्नो छोराछोरीलाई अनुशासनमा राख; किनकि त्यसमा आशा हुन्छ,</para>
  <para style="q2" vid="PRO 19:18">तिनीहरूको मृत्युमा सहभागी नहोऊ।<verse eid="PRO 19:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 19:19" />रिसाहा मानिसले परिणाम भोग्नैपर्छ;</para>
  <para style="q2" vid="PRO 19:19">त्यसलाई उम्कन दियौ भने फेरि पनि तिमीले त्यसै गर्नुपर्नेछ।<verse eid="PRO 19:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 19:20" />सल्‍लाह सुन, र अनुशासनलाई ग्रहण गर,</para>
  <para style="q2" vid="PRO 19:20">र तिम्रो जीवनभरि तिमी बुद्धिमान् हुनेछौ।<verse eid="PRO 19:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 19:21" />मानिसका हृदयमा धेरै योजनाहरू हुन्छन्,</para>
  <para style="q2" vid="PRO 19:21">तर अन्ततः याहवेहकै उद्देश्य पूरा हुन्छ।<verse eid="PRO 19:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 19:22" />मानिसले अचुक प्रेमको इच्छा राख्छ<note caller="+" style="f"><char style="fr" closed="false">19:22 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">लोभ मानिसको शर्म हो।</char></note>;</para>
  <para style="q2" vid="PRO 19:22">झूटो बोल्ने हुनुभन्दा बरु गरिब हुनु नै बेस हो।<verse eid="PRO 19:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 19:23" />याहवेहप्रतिको श्रद्धाले जीवनमा पुर्‍याउँछ,</para>
  <para style="q2" vid="PRO 19:23">तब मानिस ढुक्‍कसँग रहन्छ; दुःखले त्यसलाई छुँदैन।<verse eid="PRO 19:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 19:24" />अल्छेले आफ्नो हात थालमा हाल्छ,</para>
  <para style="q2" vid="PRO 19:24">र त्यसले आफ्नो हात उठाएर मुखसम्म पनि ल्याउन चाहँदैन!<verse eid="PRO 19:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 19:25" />गिल्‍ला गर्नेलाई कोर्रा लगाऊ, यो देखेर सोझो मानिस चनाखो बन्‍नेछ;</para>
  <para style="q2" vid="PRO 19:25">विवेकशील मानिसहरूलाई हप्काऊ, र तिनीहरूले ज्ञान बढाउनेछन्।<verse eid="PRO 19:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 19:26" />आफ्ना बुबालाई लुट्ने र आफ्नी आमालाई</para>
  <para style="q2" vid="PRO 19:26">बाहिर निकाल्ने छोराछोरीले शर्म र कलङ्क ल्याउँदछन्।<verse eid="PRO 19:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 19:27" />हे मेरा छोराछोरी, अर्तीलाई सुन्‍न छोड्यौ भने,</para>
  <para style="q2" vid="PRO 19:27">तिमीहरू ज्ञानका वचनहरूदेखि बहकिनेछौ।<verse eid="PRO 19:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 19:28" />भ्रष्‍ट गवाहीले न्यायलाई खिसी गर्छ,</para>
  <para style="q2" vid="PRO 19:28">र दुष्‍टको मुखले दुष्‍टतालाई निल्छ।<verse eid="PRO 19:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 19:29" />खिसी गर्नेहरूका निम्ति दण्ड,</para>
  <para style="q2" vid="PRO 19:29">र मूर्खहरूका पिठिउँका निम्ति पिटाइ तयार पारिएका हुन्छन्।<verse eid="PRO 19:29" /></para>
  <para style="b" />
  <chapter eid="PRO 19" />
  <chapter number="20" style="c" sid="PRO 20" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 20:1" />दाखमद्य उपहास हो, र कडा मद्यपान हल्‍ला हो;</para>
  <para style="q2" vid="PRO 20:1">यी कुराहरूका लतमा लागेकाहरू बुद्धिमान् हुँदैनन्।<verse eid="PRO 20:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 20:2" />राजाको भय सिंहको गर्जनजस्तो हुन्छ;</para>
  <para style="q2" vid="PRO 20:2">तिनलाई रिस उठाउनेहरूले आफ्नो प्राण गुमाउँछन्।<verse eid="PRO 20:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 20:3" />झगडाबाट अलग्गै रहनु मानिसका निम्ति सम्मानको कुरा हो;</para>
  <para style="q2" vid="PRO 20:3">तर हरेक मूर्खचाहिँ झगडा मच्‍चाउनमा छिटो हुन्छ।<verse eid="PRO 20:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 20:4" />अल्छेले समयमै हलो जोत्दैन;</para>
  <para style="q2" vid="PRO 20:4">यसकारण कटनीको बेला त्यसले खोज्छ, तर केही पाउँदैन।<verse eid="PRO 20:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 20:5" />मानिसको हृदयका उद्देश्यहरू गहिरो पानीजस्तै हुन्छन्;</para>
  <para style="q2" vid="PRO 20:5">तर समझदार मानिसले त्यसलाई बाहिर निकाल्छ।<verse eid="PRO 20:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 20:6" />धेरै मानिसहरू आफूमा अचुक प्रेम भएको दाबी गर्छन्;</para>
  <para style="q2" vid="PRO 20:6">तर विश्‍वासयोग्य मानिस कसले पाउन सक्छ र?<verse eid="PRO 20:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 20:7" />धर्मी मानिसले निष्कलङ्क जीवन जिउँछ;</para>
  <para style="q2" vid="PRO 20:7">त्यसका पछि आउने सन्तानहरू धन्यका हुन्छन्।<verse eid="PRO 20:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 20:8" />जब राजा सिंहासनमा न्याय गर्न बस्छन्,</para>
  <para style="q2" vid="PRO 20:8">तब तिनले आफ्नै आँखाले सबै खराबीलाई केलाउँछन्।<verse eid="PRO 20:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 20:9" />कसले भन्‍न सक्छ, “मैले आफ्नो हृदय शुद्ध राखेको छु,</para>
  <para style="q2" vid="PRO 20:9">म सफा र पापरहित छु?”<verse eid="PRO 20:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 20:10" />असमान ढक र असमान नापहरू—</para>
  <para style="q2" vid="PRO 20:10">याहवेहले यी दुवैलाई घृणा गर्नुहुन्छ।<verse eid="PRO 20:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 20:11" />बालकको चरित्र शुद्ध र ठिक छ कि छैन भनी</para>
  <para style="q2" vid="PRO 20:11">उसको चालचलनबाट नै थाहा पाइन्छ।<verse eid="PRO 20:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 20:12" />सुन्‍ने कान र देख्ने आँखा—</para>
  <para style="q2" vid="PRO 20:12">यी दुवै याहवेहले नै बनाउनुभएको हो।<verse eid="PRO 20:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 20:13" />निद्रालाई प्रेम नगर, नत्रता यसले तिमीलाई गरिब बनाउनेछ;</para>
  <para style="q2" vid="PRO 20:13">जागा बस, र तिमीसित खानलाई प्रशस्त अन्‍न हुनेछ।<verse eid="PRO 20:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 20:14" />ग्राहकले भन्छ, “यो राम्रो छैन, यो राम्रो छैन!”</para>
  <para style="q2" vid="PRO 20:14">तब फर्कँदा आफ्नो किनाइमा त्यसले घमण्ड गर्छ।<verse eid="PRO 20:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 20:15" />सुन छ, र माणिकहरू प्रशस्त छन्;</para>
  <para style="q2" vid="PRO 20:15">तर ज्ञानका कुरा बोल्ने जिब्रो अमूल्य रत्नजस्तै हुन्छ।<verse eid="PRO 20:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 20:16" />परदेशीको जमानी बस्‍नेको लुगा लिइराख;</para>
  <para style="q2" vid="PRO 20:16">परदेशीको<note caller="+" style="f"><char style="fr" closed="false">20:16 </char><char style="ft" closed="false">केही प्राचीन पा.लि.हरूमा </char><char style="fqa" closed="false">यदि त्यसले स्वेच्छाचारी स्त्रीको</char></note> जमानी बसेको छ भने त्यो लुगा बन्धकको रूपमा लिइराख।<verse eid="PRO 20:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 20:17" />छलसित प्राप्‍त गरेको भोजन मानिसको लागि स्वादिष्‍ठ हुन्छ,</para>
  <para style="q2" vid="PRO 20:17">तर अन्त्यमा त्यो मुखमा रोडाजस्तै हुन्छ।<verse eid="PRO 20:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 20:18" />सरसल्‍लाहद्वारा योजनाहरू सफल हुन्छन्;</para>
  <para style="q2" vid="PRO 20:18">सल्‍लाह नलिई युद्ध गर्न नजाओ।<verse eid="PRO 20:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 20:19" />कुरौटेले गुप्‍त कुरा प्रकट गरिदिन्छ;</para>
  <para style="q2" vid="PRO 20:19">त्यसकारण धेरै बोल्ने मानिसदेखि अलग बस।<verse eid="PRO 20:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 20:20" />यदि कसैले आफ्ना बुबा वा आमालाई सराप्छ भने,</para>
  <para style="q2" vid="PRO 20:20">त्यसको बत्ती घोर अन्धकारमा निभाइनेछ।<verse eid="PRO 20:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 20:21" />सुरुमै हतारमा प्राप्‍त गरेको पैतृक सम्पत्ति</para>
  <para style="q2" vid="PRO 20:21">अन्त्यमा आशिषित हुँदैन।<verse eid="PRO 20:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 20:22" />यसो नभन, “म तिम्रो खराबीको बदला लिनेछु!”</para>
  <para style="q2" vid="PRO 20:22">याहवेहको प्रतीक्षा गर, र उहाँले तिम्रो प्रतिशोध लिनुहुनेछ।<verse eid="PRO 20:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 20:23" />असमान ढकहरू याहवेहले घृणा गर्नुहुन्छ;</para>
  <para style="q2" vid="PRO 20:23">र छलको तराजुले उहाँलाई प्रसन्‍न पार्दैन।<verse eid="PRO 20:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 20:24" />मानिसका पाइलाहरू याहवेहबाट नै निर्देशन गरिएका हुन्छन्;</para>
  <para style="q2" vid="PRO 20:24">यसकारण कसले आफ्नै मार्ग जान्‍न सक्छ र?<verse eid="PRO 20:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 20:25" />असावधानीपूर्वक केही कुरो अर्पण गरिसकेपछि मात्रै</para>
  <para style="q2" vid="PRO 20:25">आफ्नो भाकलबारे विचार गर्नु मानिसको लागि पासो हुनेछ।<verse eid="PRO 20:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 20:26" />बुद्धिमान् राजाले दुष्‍टहरूलाई पन्साउँछन्;</para>
  <para style="q2" vid="PRO 20:26">तिनले उनीहरूमाथि दाइँ गर्ने चक्‍का चलाउँछन्।<verse eid="PRO 20:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 20:27" />याहवेहको ज्योतिले मानिसको आत्मा<note caller="+" style="f"><char style="fr" closed="false">20:27 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">मानिसका वचनहरू</char></note> खोजी गर्दछ,</para>
  <para style="q2" vid="PRO 20:27">जसले उसको भित्री मनुष्यत्वलाई खोजी निकाल्छ।<verse eid="PRO 20:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 20:28" />प्रेम र विश्‍वासयोग्यताले राजालाई सुरक्षित राख्छन्;</para>
  <para style="q2" vid="PRO 20:28">प्रेमद्वारा नै तिनको सिंहासन सुरक्षित रहन्छ।<verse eid="PRO 20:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 20:29" />जवान मानिसहरूको गौरव तिनीहरूको बल हो;</para>
  <para style="q2" vid="PRO 20:29">वृद्धहरूको शोभा फुलेको केश हो।<verse eid="PRO 20:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 20:30" />मुक्‍का र चोटहरूले दुष्‍टता पखालिन्छ,</para>
  <para style="q2" vid="PRO 20:30">र पिटाइले भित्री मनुष्यत्व खारिन्छ।<verse eid="PRO 20:30" /></para>
  <para style="b" />
  <chapter eid="PRO 20" />
  <chapter number="21" style="c" sid="PRO 21" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 21:1" />राजाको हृदय याहवेहको हातमा हुन्छ;</para>
  <para style="q2" vid="PRO 21:1">उहाँले खोलाको पानीलाई आफ्नो मनपर्दो दिशातिर डोर्‍याएजस्तै, त्यसलाई डोर्‍याउनुहुन्छ।<verse eid="PRO 21:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 21:2" />मानिसलाई आफ्ना सबै चालहरू ठिक लाग्ला,</para>
  <para style="q2" vid="PRO 21:2">तर हृदय जाँच्नुहुने याहवेह नै हुनुहुन्छ।<verse eid="PRO 21:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 21:3" />ठिक र न्यायोचित काम गर्नुचाहिँ</para>
  <para style="q2" vid="PRO 21:3">याहवेहको सामु बलिदानभन्दा बढी ग्रहणयोग्य हुन्छ।<verse eid="PRO 21:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 21:4" />अहङ्कारी आँखा र अभिमानी हृदय</para>
  <para style="q2" vid="PRO 21:4">तथा दुष्‍टका नजोतिएका जमिनले पाप उब्जाउँछ।<verse eid="PRO 21:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 21:5" />परिश्रमीको योजनाले लाभ दिन्छ;</para>
  <para style="q2" vid="PRO 21:5">हतारले अवश्य नै गरिबीमा पुर्‍याउँछ।<verse eid="PRO 21:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 21:6" />झूटो जिब्रोद्वारा कमाएको धन</para>
  <para style="q2" vid="PRO 21:6">उडिजाने वाफ र घातक पासो हो।<note caller="+" style="f"><char style="fr" closed="false">21:6 </char><char style="ft" closed="false">केही प्राचीन पा.लि.हरूमा </char><char style="fqa" closed="false">मृत्यु खोज्नेहरूका निम्ति वाफ हो।</char></note><verse eid="PRO 21:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 21:7" />दुष्‍टहरूका हिंसाले नै तिनीहरूलाई पखाल्छ;</para>
  <para style="q2" vid="PRO 21:7">किनकि जे ठिक हो, त्यो गर्न तिनीहरूले अस्वीकार गर्दछन्।<verse eid="PRO 21:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 21:8" />दोषीको चाल बाङ्गो हुन्छ;</para>
  <para style="q2" vid="PRO 21:8">तर निर्दोषको चालचलन ठिक हुन्छ।<verse eid="PRO 21:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 21:9" />कचकचे पत्नीसित एउटै घरमा बस्‍नुभन्दा,</para>
  <para style="q2" vid="PRO 21:9">घरको कौसीको एउटा कुनामा बस्‍नु असल हो।<verse eid="PRO 21:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 21:10" />दुष्‍ट मानिसले दुष्‍टताको चाहना गर्छ;</para>
  <para style="q2" vid="PRO 21:10">त्यसको छिमेकीले त्यसबाट दया पाउँदैन।<verse eid="PRO 21:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 21:11" />गिल्‍ला गर्नेले दण्ड पाउँदा सोझाले बुद्धि प्राप्‍त गर्छ;</para>
  <para style="q2" vid="PRO 21:11">बुद्धिमान्‌लाई अर्ती दिँदा त्यसले ज्ञान प्राप्‍त गर्छ।<verse eid="PRO 21:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 21:12" />धर्मी जनले<note caller="+" style="f"><char style="fr" closed="false">21:12 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">परमेश्‍वर</char></note> दुष्‍टको घरलाई चिनिराख्छ;</para>
  <para style="q2" vid="PRO 21:12">तर परमेश्‍वरले दुष्‍टहरूलाई पतन गराउनुहुन्छ।<verse eid="PRO 21:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 21:13" />जसले गरिबको चीत्कार सुन्दैन,</para>
  <para style="q2" vid="PRO 21:13">त्यसले पनि पुकार गर्दा जवाफ पाउनेछैन।<verse eid="PRO 21:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 21:14" />गुप्‍तमा दिएको उपहारले क्रोधलाई शान्त गर्छ;</para>
  <para style="q2" vid="PRO 21:14">लुकाएर दिएको घूसले ठूलो क्रोध शान्त गर्छ।<verse eid="PRO 21:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 21:15" />उचित न्यायले धर्मी जनको हृदयमा आनन्द ल्याउँछ;</para>
  <para style="q2" vid="PRO 21:15">तर कुकर्मीहरू भने त्रसित हुन्छन्।<verse eid="PRO 21:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 21:16" />समझशक्तिदेखि कुमार्गतिर लाग्ने मानिस</para>
  <para style="q2" vid="PRO 21:16">मृतकहरूको साथमा विश्राम गर्न पुग्छ।<verse eid="PRO 21:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 21:17" />सुख-विलास मन पराउने गरिब हुनेछ;</para>
  <para style="q2" vid="PRO 21:17">दाखमद्य र विलासिता<note caller="+" style="f"><char style="fr" closed="false">21:17 </char><char style="ft" closed="false">मूल भाषामा </char><char style="fqa" closed="false">तेल</char></note> मन पराउने कहिल्यै धनी हुनेछैन।<verse eid="PRO 21:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 21:18" />दुष्‍टहरू धर्मीहरूको उद्धारको मोल,</para>
  <para style="q2" vid="PRO 21:18">र विश्‍वासघाती निर्दोषहरूको उद्धारको मोल हुनेछन्।<verse eid="PRO 21:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 21:19" />झगडालु र गनगने पत्नीसित बस्‍नुभन्दा त</para>
  <para style="q2" vid="PRO 21:19">बरु मरुभूमिमा बस्‍नु असल हुन्छ।<verse eid="PRO 21:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 21:20" />बुद्धिमान् मानिसको घरमा मनपर्दो धन र तेल हुन्छ;</para>
  <para style="q2" vid="PRO 21:20">तर मूर्ख मानिसले आफूसँग भएको सबै उडाउँछ।<verse eid="PRO 21:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 21:21" />धार्मिकता र प्रेमको पछि लाग्नेले</para>
  <para style="q2" vid="PRO 21:21">जीवन, उन्‍नति<note caller="+" style="f"><char style="fr" closed="false">21:21 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">धार्मिकता</char></note> र सम्मान पाउँछ।<verse eid="PRO 21:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 21:22" />बुद्धिमान् मानिसले पराक्रमीको सहरमा आक्रमण गर्छ,</para>
  <para style="q2" vid="PRO 21:22">र तिनीहरूले भरोसा गरेको किल्‍ला भत्काइदिन्छ।<verse eid="PRO 21:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 21:23" />आफ्नो मुख र जिब्रो सम्हाल्नेले</para>
  <para style="q2" vid="PRO 21:23">आफूलाई विपत्तिबाट जोगाउँछ।<verse eid="PRO 21:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 21:24" />अहङ्कारी र अभिमानी मानिसको नाम, “गिल्‍ला गर्ने” हो,</para>
  <para style="q2" vid="PRO 21:24">त्यसले अभिमानसाथ व्यवहार गर्दछ।<verse eid="PRO 21:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 21:25" />अल्छेको इच्छा त्यसकै मृत्यु हुनेछ;</para>
  <para style="q2" vid="PRO 21:25">किनकि त्यसका हातहरूले काम गर्न इन्कार गर्छन्।<verse eid="PRO 21:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 21:26" />दिनभरि नै त्यसले अझ बढी चाहना गर्छ,</para>
  <para style="q2" vid="PRO 21:26">तर धर्मीले नसाँचिकन उदारतापूर्वक दिन्छ।<verse eid="PRO 21:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 21:27" />दुष्‍टको बलिदान घिनलाग्दो हुन्छ;</para>
  <para style="q2" vid="PRO 21:27">त्यसले दुष्‍ट विचारले ल्याएको छ भने झन् कति बढी घृणित हुनेछ!<verse eid="PRO 21:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 21:28" />झूटो गवाही दिने नष्‍ट हुनेछ;</para>
  <para style="q2" vid="PRO 21:28">तर साँचो साक्षीलाई सधैँ सुनिनेछ।<verse eid="PRO 21:28" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="29" style="v" sid="PRO 21:29" />दुष्‍ट मानिसले आफ्नो अनुहारमा साहसीपना देखाउँछ;</para>
  <para style="q2" vid="PRO 21:29">तर धर्मी जीवन जिउनेहरूले आफ्ना चालहरूमा विचार पुर्‍याउँछन्।<verse eid="PRO 21:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 21:30" />कुनै पनि बुद्धि, अन्तर्दृष्‍टि र योजना,</para>
  <para style="q2" vid="PRO 21:30">याहवेहको विरुद्ध सफल हुन सक्दैन।<verse eid="PRO 21:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="PRO 21:31" />घोडा युद्धको निम्ति तयार राखिन्छ;</para>
  <para style="q2" vid="PRO 21:31">तर विजयचाहिँ याहवेहकै हातमा हुन्छ।<verse eid="PRO 21:31" /></para>
  <para style="b" />
  <chapter eid="PRO 21" />
  <chapter number="22" style="c" sid="PRO 22" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 22:1" />धेरै धनसम्पत्तिभन्दा असल नामको इच्छा गर्नु उत्तम हो;</para>
  <para style="q2" vid="PRO 22:1">सम्मान प्राप्‍त गर्नु चाँदी र सुनभन्दा असल हो।<verse eid="PRO 22:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 22:2" />धनी र गरिबमा एउटा कुरा समान छ:</para>
  <para style="q2" vid="PRO 22:2">याहवेहले नै तिनीहरू सबैलाई बनाउनुभएको हो।<verse eid="PRO 22:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 22:3" />विवेकशील व्यक्तिले जोखिमलाई देखेर शरण लिन्छ;</para>
  <para style="q2" vid="PRO 22:3">तर सोझाचाहिँ त्यतैतिर जान्छ, र परिणाम भोग्छ।<verse eid="PRO 22:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 22:4" />धन, सम्मान र दीर्घायु;</para>
  <para style="q2" vid="PRO 22:4">नम्रता र याहवेहप्रतिको श्रद्धाका प्रतिफल हुन्।<verse eid="PRO 22:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 22:5" />दुष्‍टको बाटोमा काँडा र पासाहरू हुन्छन्;</para>
  <para style="q2" vid="PRO 22:5">तर जसले आफ्नो प्राणको रक्षा गर्छ, त्यो त्यस्ता कुराहरूदेखि टाढै रहन्छ।<verse eid="PRO 22:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 22:6" />बालकलाई ठिक बाटोमा हिँड्ने तालिम देऊ;</para>
  <para style="q2" vid="PRO 22:6">र त्यो वृद्ध भएपछि पनि त्यसबाट तर्केर जानेछैन।<verse eid="PRO 22:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 22:7" />धनीले गरिबमाथि शासन जमाउँछ;</para>
  <para style="q2" vid="PRO 22:7">र ऋण लिनेचाहिँ ऋण दिनेको नोकर हुन्छ।<verse eid="PRO 22:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 22:8" />अन्याय छर्नेले विपत्ति कटनी गर्छ;</para>
  <para style="q2" vid="PRO 22:8">र त्यसका रिसको लहुरो भाँचिनेछ।<verse eid="PRO 22:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 22:9" />दयालु मानिस आफू पनि आशिषित हुनेछ;</para>
  <para style="q2" vid="PRO 22:9">किनकि त्यसले आफ्नो भोजन गरिबहरूसित बाँड्छ।<verse eid="PRO 22:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 22:10" />गिल्‍ला गर्नेलाई बाहिर निकालिदेऊ, तब झगडा हराउँछ;</para>
  <para style="q2" vid="PRO 22:10">कलह र अपमानको पनि अन्त्य हुनेछ।<verse eid="PRO 22:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 22:11" />जसले शुद्ध हृदय मन पराउँछ, र जसका बोलीवचन मिठो हुन्छ,</para>
  <para style="q2" vid="PRO 22:11">उसका लागि राजा पनि मित्र हुनेछ।<verse eid="PRO 22:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 22:12" />याहवेहको दृष्‍टिले ज्ञानको रक्षा गर्छ,</para>
  <para style="q2" vid="PRO 22:12">तर विश्‍वासघातीका वचनहरूलाई उहाँले विफल तुल्याउनुहुन्छ।<verse eid="PRO 22:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 22:13" />अल्छेले भन्छ, “बाहिर एउटा सिंह छ!</para>
  <para style="q2" vid="PRO 22:13">सडकमा गएँ भने त्यहीँ मेरो हत्या हुनेछ।”<verse eid="PRO 22:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 22:14" />व्यभिचारिणी स्त्रीको मुख एक गहिरो खाडल हो;</para>
  <para style="q2" vid="PRO 22:14">याहवेहको क्रोधमा पर्नेहरू त्यसमा खस्‍नेछन्।<verse eid="PRO 22:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 22:15" />बालकको हृदयमा मूर्खता हुन्छ,</para>
  <para style="q2" vid="PRO 22:15">तर अनुशासनको छडीले उसलाई त्यसबाट टाढो भगाइदिनेछ।<verse eid="PRO 22:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 22:16" />आफ्नो धन बढाउन गरिबमाथि अत्याचार गर्ने</para>
  <para style="q2" vid="PRO 22:16">र धनीलाई उपहारहरू दिने, दुवैमाथि दरिद्रता आउँछ।<verse eid="PRO 22:16" /></para>
  <para style="ms1">बुद्धिमान्‌का भनाइहरू</para>
  <para style="s2">भनाइ 1</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 22:17" />बुद्धिमान्‌का कुराहरू सुन, र त्यसमा ध्यान देऊ;</para>
  <para style="q2" vid="PRO 22:17">म जे सिकाउँछु, त्यसमा तिम्रो हृदय लगाऊ!<verse eid="PRO 22:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 22:18" />किनकि ती तिम्रा हृदयमा राख्यौ भने,</para>
  <para style="q2" vid="PRO 22:18">र आफ्ना ओठमा तयार राख्यौ भने त्यसले तिमीलाई आनन्द दिनेछ।<verse eid="PRO 22:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 22:19" />तिम्रो भरोसा याहवेहमाथि होस् भनेर</para>
  <para style="q2" vid="PRO 22:19">यो कुरा आज म तिमीलाई सिकाउँछु, हो, तिमीलाई।<verse eid="PRO 22:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 22:20" />के मैले तिम्रा लागि तीस वटा भनाइहरू साथमा</para>
  <para style="q2" vid="PRO 22:20">सल्‍लाह र ज्ञानका वचनहरू लेखिदिएको छैनँ र?<verse eid="PRO 22:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 22:21" />आफूलाई पठाउनेलाई तिमीले ठिक जवाफ दिन सक भनेर</para>
  <para style="q2" vid="PRO 22:21">मैले तिमीलाई सत्य विश्‍वसनीय वचनहरू</para>
  <para style="q2" vid="PRO 22:21">सिकाएको होइनँ र?<verse eid="PRO 22:21" /></para>
  <para style="s2">भनाइ 2</para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 22:22" />असहाय छन् भन्दैमा तिनीहरूलाई शोषण नगर,</para>
  <para style="q2" vid="PRO 22:22">न त खाँचोमा परेकाहरूलाई न्यायालयमा पेल;<verse eid="PRO 22:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 22:23" />किनकि तिनीहरूको मुद्दा याहवेहले नै लिनुहुनेछ,</para>
  <para style="q2" vid="PRO 22:23">र तिनीहरूलाई लुट्नेहरूलाई उहाँले पनि लुट्नुहुनेछ।<verse eid="PRO 22:23" /></para>
  <para style="s2">भनाइ 3</para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 22:24" />रिसाहा मानिसलाई मित्र नबनाऊ;</para>
  <para style="q2" vid="PRO 22:24">झट्टै रिसाउनेहरूसित सङ्गत नगर,<verse eid="PRO 22:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 22:25" />नत्रता त्यसको बानी तिमीले सिक्छौ</para>
  <para style="q2" vid="PRO 22:25">र आफूलाई पासोमा पार्छौ।<verse eid="PRO 22:25" /></para>
  <para style="s2">भनाइ 4</para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 22:26" />बन्धकमा आफ्नो हात नहाल,</para>
  <para style="q2" vid="PRO 22:26">अथवा अर्काको ऋणको जमानी नबस;<verse eid="PRO 22:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 22:27" />यदि तिमीसित तिर्ने साधन छैन भने,</para>
  <para style="q2" vid="PRO 22:27">तिमी सुतेको तिम्रो आफ्नै ओछ्यानसमेत खोसिनेछ।<verse eid="PRO 22:27" /></para>
  <para style="s2">भनाइ 5</para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 22:28" />प्राचीन साँधसिमानाको ढुङ्गो नहटाऊ,</para>
  <para style="q2" vid="PRO 22:28">जो तिम्रा पुर्खाहरूले खडा गरेका हुन्।<verse eid="PRO 22:28" /></para>
  <para style="s2">भनाइ 6</para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 22:29" />के तिमीले आफ्नो काममा निपूर्ण मानिस देखेका छौ?</para>
  <para style="q2" vid="PRO 22:29">तिनीहरूले राजाहरूका सामु सेवा गर्नेछन्,</para>
  <para style="q2" vid="PRO 22:29">तिनीहरूले तल्‍लो तहका अधिकारीहरूको सेवा गर्नेछैनन्।<verse eid="PRO 22:29" /></para>
  <chapter eid="PRO 22" />
  <chapter number="23" style="c" sid="PRO 23" />
  <para style="s2">भनाइ 7</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 23:1" />जब तिमी शासकसँग खान बस्छौ,</para>
  <para style="q2" vid="PRO 23:1">तिम्रो अगि के छ, त्यो राम्ररी याद गर।<verse eid="PRO 23:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 23:2" />यदि तिम्रो धेरै खाने बानी छ भने,</para>
  <para style="q2" vid="PRO 23:2">आफ्नो घाँटीमा छुरी राख।<verse eid="PRO 23:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 23:3" />तिनका स्वादिष्‍ठ भोजनहरूको लालसा नगर;</para>
  <para style="q2" vid="PRO 23:3">किनकि त्यो भोजन छलपूर्ण हुन्छ।<verse eid="PRO 23:3" /></para>
  <para style="s2">भनाइ 8</para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 23:4" />धनी बन्‍न आफूलाई धेरै नघोट;</para>
  <para style="q2" vid="PRO 23:4">उचित समयमा आफूलाई रोक्न बुद्धिमान् होऊ।<verse eid="PRO 23:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 23:5" />धनसम्पत्ति एकै छिनमा उडिजान्छन्;</para>
  <para style="q2" vid="PRO 23:5">किनकि यसका पखेटाहरू पलाउँछन्,</para>
  <para style="q2" vid="PRO 23:5">आकाशमा गरुडजस्तै, त्यो उडेर जानेछ।<verse eid="PRO 23:5" /></para>
  <para style="s2">भनाइ 9</para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 23:6" />लोभी मानिसको भोजन नखाऊ,</para>
  <para style="q2" vid="PRO 23:6">त्यसका स्वादिष्‍ठ भोजनको चाहना नगर;<verse eid="PRO 23:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 23:7" />किनभने त्यो त्यस्तो किसिमको मानिस हो,</para>
  <para style="q2" vid="PRO 23:7">जसले त्यसको दाम उठाउने बारेमा सधैँ सोचिरहेको हुन्छ;</para>
  <para style="q1" vid="PRO 23:7">त्यसले तिमीलाई “खानुहोस्, पिउनुहोस्” भनी भन्छ,</para>
  <para style="q2" vid="PRO 23:7">तर त्यसले मनबाट भनेको चाहिँ हुँदैन।<verse eid="PRO 23:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 23:8" />तिमीले अलिकति खाएको पनि उकेलिदिनेछौ,</para>
  <para style="q2" vid="PRO 23:8">र त्यसलाई तिमीले भनेका मधुर वचन त्यसै व्यर्थ जानेछ।<verse eid="PRO 23:8" /></para>
  <para style="s2">भनाइ 10</para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 23:9" />मूर्खसित नबोल;</para>
  <para style="q2" vid="PRO 23:9">किनकि त्यसले तिम्रा वचनहरूका ज्ञानलाई तिरस्कार गर्नेछ।<verse eid="PRO 23:9" /></para>
  <para style="s2">भनाइ 11</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 23:10" />प्राचीन साँधसिमानाको ढुङ्गा नहटाऊ,</para>
  <para style="q2" vid="PRO 23:10">अथवा टुहुरा-टुहुरीका खेतबारी नमिच,<verse eid="PRO 23:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 23:11" />किनकि तिनीहरूका रक्षक शक्तिशाली हुनुहुन्छ;</para>
  <para style="q2" vid="PRO 23:11">उहाँले तिम्रो विरुद्धमा तिनीहरूका मामिला लिनुहुनेछ।<verse eid="PRO 23:11" /></para>
  <para style="s2">भनाइ 12</para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 23:12" />तिम्रो हृदय अर्तीमा</para>
  <para style="q2" vid="PRO 23:12">र तिम्रा कानहरू ज्ञानका वचनहरूमा लगाऊ।<verse eid="PRO 23:12" /></para>
  <para style="s2">भनाइ 13</para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 23:13" />बालकलाई अनुशासनमा राख्न नरोक;</para>
  <para style="q2" vid="PRO 23:13">तिमीले तिनीहरूलाई छडी लगायौ भने तिनीहरू मर्नेछैनन्।<verse eid="PRO 23:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 23:14" />छडी लगाएर त्यसलाई सजाय देऊ,</para>
  <para style="q2" vid="PRO 23:14">र त्यसको प्राणलाई मृत्युबाट रक्षा गर।<verse eid="PRO 23:14" /></para>
  <para style="s2">भनाइ 14</para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 23:15" />हे मेरा छोराछोरी, यदि तिम्रो हृदय बुद्धिमान् छ भने,</para>
  <para style="q2" vid="PRO 23:15">मेरो हृदय पनि प्रसन्‍न हुनेछ,<verse eid="PRO 23:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 23:16" />तिम्रा ओठले ठिक कुरा बोल्दछ भने,</para>
  <para style="q2" vid="PRO 23:16">मेरो अन्तस्करण त्यसै समय रमाउनेछ।<verse eid="PRO 23:16" /></para>
  <para style="s2">भनाइ 15</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 23:17" />तिम्रो हृदयले पापीहरूलाई डाह गर्न नदेऊ;</para>
  <para style="q2" vid="PRO 23:17">तर याहवेहप्रतिको श्रद्धामा सधैँ जोशिलो होऊ।<verse eid="PRO 23:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 23:18" />निश्‍चय नै तिम्रा निम्ति भविष्यको आशा छ,</para>
  <para style="q2" vid="PRO 23:18">र तिम्रो आशा खोसिनेछैन।<verse eid="PRO 23:18" /></para>
  <para style="s2">भनाइ 16</para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 23:19" />हे मेरा छोराछोरी, सुन, र बुद्धिमान् होऊ;</para>
  <para style="q2" vid="PRO 23:19">अनि तिम्रो हृदय सत्य मार्गमा लगाऊ।<verse eid="PRO 23:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 23:20" />धेरै दाखमद्य पिउनेहरू,</para>
  <para style="q2" vid="PRO 23:20">अथवा मुखमा मासु हसुर्नेहरूसित सङ्गत नगर;<verse eid="PRO 23:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 23:21" />किनकि मतवाला र घिचुवाहरू गरिब हुनेछन्;</para>
  <para style="q2" vid="PRO 23:21">र नशाले तिनीहरूलाई थाङ्ने बनाउँछ।<verse eid="PRO 23:21" /></para>
  <para style="s2">भनाइ 17</para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 23:22" />तिमीलाई जीवन दिनुहुने बुबाका कुरा सुन,</para>
  <para style="q2" vid="PRO 23:22">र आफ्नी आमा वृद्ध हुँदा उनलाई हेला नगर।<verse eid="PRO 23:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 23:23" />सत्य किन, र त्यसलाई नबेच;</para>
  <para style="q2" vid="PRO 23:23">बुद्धि, अनुशासन र समझदारी प्राप्‍त गर।<verse eid="PRO 23:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 23:24" />धर्मी मानिसको बुबासित आनन्दित हुने कारण हुन्छ;</para>
  <para style="q2" vid="PRO 23:24">बुद्धिमान् सन्तान जन्माउनु आनन्दको कुरा हो!<verse eid="PRO 23:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 23:25" />तिम्रा बुबा र आमा प्रसन्‍न होऊन्,</para>
  <para style="q2" vid="PRO 23:25">तिमीलाई जन्म दिने आमाले रमाहट गरून्।<verse eid="PRO 23:25" /></para>
  <para style="s2">भनाइ 18</para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 23:26" />हे मेरो छोरो, तिम्रो हृदय मलाई देऊ,</para>
  <para style="q2" vid="PRO 23:26">र तिम्रा आँखाले मेरा चालहरू हेर्न रमाऊन;<verse eid="PRO 23:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 23:27" />किनकि व्यभिचारिणी स्त्रीचाहिँ एउटा गहिरो खाडल हो,</para>
  <para style="q2" vid="PRO 23:27">र भ्रष्‍ट पत्नी साँघुरो कुवा हो।<verse eid="PRO 23:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 23:28" />त्यो एउटा डाँकुजस्तै ढुकिरहन्‍छे,</para>
  <para style="q2" vid="PRO 23:28">र मानिसहरूका बीचमा विश्‍वासघाती पुरुषहरूको संख्या बढाउँछे।<verse eid="PRO 23:28" /></para>
  <para style="s2">भनाइ 19</para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 23:29" />कष्‍ट कसलाई हुन्छ? दुःख कसलाई हुन्छ?</para>
  <para style="q2" vid="PRO 23:29">को झगडा गरिरहन्छ? को गुनासो गरिरहन्छ?</para>
  <para style="q2" vid="PRO 23:29">कसलाई अनावश्यक चोटपटक लाग्छ? कसका आँखाहरू राता-राता हुन्छन्?<verse eid="PRO 23:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 23:30" />तिनीहरू नै, जो मद्यमै भुलिरहन्छन्;</para>
  <para style="q2" vid="PRO 23:30">जो मिश्रित मद्यको कचौरा चाख्न जान्छन्।<verse eid="PRO 23:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 23:31" />दाखमद्य रातो हुँदा,</para>
  <para style="q2" vid="PRO 23:31">जब यो कचौरामा हाल्दा फीँज उठ्छ,</para>
  <para style="q2" vid="PRO 23:31">जब यो बिस्तारै लिइन्छ त्यसतिर एक टक लगाएर नहेर।<verse eid="PRO 23:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 23:32" />अन्त्यमा यसले सर्पले जस्तै डस्छ,</para>
  <para style="q2" vid="PRO 23:32">र विषालु सर्पले जस्तै विषयुक्त पार्छ।<verse eid="PRO 23:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 23:33" />तिम्रा आँखाले अनौठा दृश्यहरू देख्नेछन्,</para>
  <para style="q2" vid="PRO 23:33">र तिम्रा मनले नचाहिँदा कुराहरूको कल्पना गर्नेछ।<verse eid="PRO 23:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 23:34" />महासमुद्रमा सुतिरहेझैँ तिमीलाई हुनेछ;</para>
  <para style="q2" vid="PRO 23:34">मस्तुलका डोरीको माथितिर झुण्डिरहेझैँ तिमी हुनेछौ।<verse eid="PRO 23:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 23:35" />तिमीले भन्‍नेछौ, “तिनीहरूले मलाई हिर्काए”, तर मलाई चोट लागेन!</para>
  <para style="q2" vid="PRO 23:35">तिनीहरूले मलाई पिट्छन्, तर मैले थाहै पाउँदिनँ!</para>
  <para style="q1" vid="PRO 23:35">“म कहिले बिउँझूँ,</para>
  <para style="q2" vid="PRO 23:35">अनि म फेरि अर्को मद्य पिऊँ?”<verse eid="PRO 23:35" /></para>
  <chapter eid="PRO 23" />
  <chapter number="24" style="c" sid="PRO 24" />
  <para style="s2">भनाइ 20</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 24:1" />दुष्‍ट मानिसहरूप्रति ईर्ष्या नगर,</para>
  <para style="q2" vid="PRO 24:1">तिनीहरूका सङ्गतको चाहना नगर;<verse eid="PRO 24:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 24:2" />किनकि तिनीहरूका हृदयले हिंसा रच्दछ,</para>
  <para style="q2" vid="PRO 24:2">र तिनीहरूका ओठले समस्या ल्याउने कुरा गर्दछ।<verse eid="PRO 24:2" /></para>
  <para style="s2">भनाइ 21</para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 24:3" />बुद्धिद्वारा घर बनाइन्छ,</para>
  <para style="q2" vid="PRO 24:3">र समझशक्तिद्वारा त्यसलाई स्थिर पारिन्छ;<verse eid="PRO 24:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 24:4" />ज्ञानद्वारा त्यसका कोठाहरू</para>
  <para style="q2" vid="PRO 24:4">मूल्यवान् र सुन्दर सामग्रीले भरिन्छन्।<verse eid="PRO 24:4" /></para>
  <para style="s2">भनाइ 22</para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 24:5" />बुद्धिमान् योद्धा शक्तिशाली हुन्छ;</para>
  <para style="q2" vid="PRO 24:5">र ज्ञानी मानिसले सामर्थ्य बढाउँछ।<verse eid="PRO 24:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 24:6" />निश्‍चय नै युद्ध गर्नलाई तिमीलाई मार्गदर्शन चाहिन्छ;</para>
  <para style="q2" vid="PRO 24:6">र विजय पाउनलाई धेरै सल्‍लाहकारहरू चाहिन्छ।<verse eid="PRO 24:6" /></para>
  <para style="s2">भनाइ 23</para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 24:7" />मूर्खको लागि बुद्धि धेरै उच्‍च हुन्छ;</para>
  <para style="q2" vid="PRO 24:7">मूलढोकामा भएको सभामा त्यसले आफ्नो मुख खोल्दैन।<verse eid="PRO 24:7" /></para>
  <para style="s2">भनाइ 24</para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 24:8" />जसले खराबी रच्दछ,</para>
  <para style="q2" vid="PRO 24:8">त्यो षड्यन्त्रकारीको नामद्वारा चिनिनेछ।<verse eid="PRO 24:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 24:9" />मूर्खताका षड्यन्त्रहरू पाप हुन्;</para>
  <para style="q2" vid="PRO 24:9">र मानिसहरूले गिल्‍ला गर्नेलाई घृणा गर्छन्।<verse eid="PRO 24:9" /></para>
  <para style="s2">भनाइ 25</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 24:10" />यदि विपत्तिको समयमा तिमीले हरेस खायौ भने,</para>
  <para style="q2" vid="PRO 24:10">तिम्रो बल कति थोरै रहेछ!<verse eid="PRO 24:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 24:11" />अन्यायपूर्ण मृत्युदण्डको लागि लगिएकाहरूलाई उद्धार गर;</para>
  <para style="q2" vid="PRO 24:11">मारिन लगिएकाहरू, जो लरबराउँदै गइरहेका छन्, तिनीहरूलाई रोक।<verse eid="PRO 24:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 24:12" />यदि तिमी भन्छौ, “तर हामीलाई त यसबारे केही थाहै पाएनौँ”,</para>
  <para style="q2" vid="PRO 24:12">तब हृदयका कुरा नाप्नुहुनेले के त्यो कुरा जान्‍नुहुन्‍न र?</para>
  <para style="q1" vid="PRO 24:12">तिम्रो जीवन सुरक्षित राख्नुहुनेले त्यो जान्‍नुहुन्‍न र?</para>
  <para style="q2" vid="PRO 24:12">के उहाँले हरेकलाई त्यसको कामअनुसार बदला लिनुहुनेछैन र?<verse eid="PRO 24:12" /></para>
  <para style="s2">भनाइ 26</para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 24:13" />हे मेरा छोराछोरी, मह खाऊ; किनकि त्यो असल हुन्छ;</para>
  <para style="q2" vid="PRO 24:13">चाकाबाट निकालिएको मह स्वादिष्‍ठ हुन्छ।<verse eid="PRO 24:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 24:14" />यो पनि जान, बुद्धि तिम्रो प्राणको लागि महजस्तै गुलियो हुन्छ;</para>
  <para style="q2" vid="PRO 24:14">तिमीले त्यो पायौ भने तिम्रा निम्ति भविष्यको आशा छ,</para>
  <para style="q2" vid="PRO 24:14">र तिम्रो आशा खोसिनेछैन।<verse eid="PRO 24:14" /></para>
  <para style="s2">भनाइ 27</para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 24:15" />चोरझैँ धर्मी मानिसको घरको विरुद्धमा ढुकेर नबस;</para>
  <para style="q2" vid="PRO 24:15">तिनको वासस्थान नलुट,<verse eid="PRO 24:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 24:16" />किनकि धर्मी मानिस सातपल्ट लड्यो भने तापनि फेरि उठ्छ;</para>
  <para style="q2" vid="PRO 24:16">तर दुष्‍टहरूचाहिँ विपत्तिले नष्‍ट हुनेछन्।<verse eid="PRO 24:16" /></para>
  <para style="s2">भनाइ 28</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 24:17" />तिम्रो शत्रुको पतन हुँदा रमाहट नगर,</para>
  <para style="q2" vid="PRO 24:17">तिनीहरूले ठेस खाँदा तिम्रो हृदय आनन्दित नहोस्;<verse eid="PRO 24:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 24:18" />नत्रता याहवेहले देख्नुहुनेछ र असहमति जनाउनुहुनेछ;</para>
  <para style="q2" vid="PRO 24:18">र उहाँको क्रोध तिनीहरूदेखि हटाउनुहुनेछ।<verse eid="PRO 24:18" /></para>
  <para style="s2">भनाइ 29</para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 24:19" />दुष्‍ट मानिसहरूका कारण चिन्ता नमान,</para>
  <para style="q2" vid="PRO 24:19">न त दुष्‍टहरूप्रति डाही बन।<verse eid="PRO 24:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 24:20" />किनकि दुष्‍ट मानिसको भविष्यको आशा हुँदैन,</para>
  <para style="q2" vid="PRO 24:20">र दुष्‍टको बत्ती निभाइनेछ।<verse eid="PRO 24:20" /></para>
  <para style="s2">भनाइ 30</para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 24:21" />हे मेरा छोराछोरी, याहवेहको र राजाको डर मान;</para>
  <para style="q2" vid="PRO 24:21">र विद्रोहीहरूसित नमिल;<verse eid="PRO 24:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 24:22" />किनकि तिनीहरूमाथि अचानक सर्वनाश आउनेछ;</para>
  <para style="q2" vid="PRO 24:22">दुवैले कस्ता विपत्तिहरू ल्याउनुहुने हो भनी कसलाई थाहा हुन्छ र?<verse eid="PRO 24:22" /></para>
  <para style="ms1">बुद्धिमान्‌का अन्य भनाइहरू</para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 24:23" />यी पनि बुद्धिमान्‌का भनाइहरू हुन्:</para>
  <para style="q1" vid="PRO 24:23">न्याय गर्दा पक्षपात गर्नु राम्रो होइन।<verse eid="PRO 24:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 24:24" />जसले दोषीलाई “तिमी निर्दोष छौ” भनी भन्छ,</para>
  <para style="q2" vid="PRO 24:24">मानिसहरूले त्यसलाई सराप्नेछन्, र राष्ट्रहरूले त्यसलाई घृणा गर्नेछन्।<verse eid="PRO 24:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 24:25" />तर दोषीलाई अपराधी ठहराउनेहरूलाई सबै असल नै हुनेछ,</para>
  <para style="q2" vid="PRO 24:25">र तिनीहरूले प्रशस्त आशिष्‌हरू प्राप्‍त गर्नेछन्।<verse eid="PRO 24:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 24:26" />इमानदार जवाफचाहिँ</para>
  <para style="q2" vid="PRO 24:26">ओठमाथि परेको चुम्बनजस्तै हो।<verse eid="PRO 24:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 24:27" />तिम्रो बाहिरको काम पूरा गर,</para>
  <para style="q2" vid="PRO 24:27">र तिम्रो खेतबारी तयार पार;</para>
  <para style="q2" vid="PRO 24:27">त्यसपछि आफ्नो घर बनाऊ।<verse eid="PRO 24:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 24:28" />तिम्रो छिमेकीका विरुद्धमा कारणविना साक्षी नदेऊ,</para>
  <para style="q2" vid="PRO 24:28">उसको विषयमा झूटो नबोल।<verse eid="PRO 24:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 24:29" />“मलाई त्यसले जस्तो व्यवहार गरेको छ, म पनि त्यसलाई त्यस्तै गर्नेछु,</para>
  <para style="q2" vid="PRO 24:29">म त्यसलाई बदला लिनेछु”, भनी नभन।<verse eid="PRO 24:29" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="30" style="v" sid="PRO 24:30" />म एउटा अल्छेको खेतबाट भएर गएँ;</para>
  <para style="q2" vid="PRO 24:30">म एउटा विवेकहीन मानिसको दाखबारीबाट भएर गएँ;<verse eid="PRO 24:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 24:31" />चारैतिर काँडाहरू उम्रेका थिए;</para>
  <para style="q2" vid="PRO 24:31">जमिन झारैझारले ढाकेको थियो,</para>
  <para style="q2" vid="PRO 24:31">अनि ढुङ्गाको पर्खाल भत्किएको थियो।<verse eid="PRO 24:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 24:32" />मैले देखेका कुरा हृदयमा विचार गरेँ;</para>
  <para style="q2" vid="PRO 24:32">र मैले देखेका ती कुराहरूबाट एउटा शिक्षा पाएँ:<verse eid="PRO 24:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 24:33" />एकैछिनको सुताइ, र एकैछिनको निन्द्राले,</para>
  <para style="q2" vid="PRO 24:33">हात बाँधेर एकैछिन मारिएको थकाइले,<verse eid="PRO 24:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 24:34" />तिमीमाथि गरिबी डाँकुजस्तै</para>
  <para style="q2" vid="PRO 24:34">र अभावचाहिँ हतियारधारीझैँ आइलाग्नेछ।<verse eid="PRO 24:34" /></para>
  <chapter eid="PRO 24" />
  <chapter number="25" style="c" sid="PRO 25" />
  <para style="ms1">सोलोमनका अरू हितोपदेशहरू</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 25:1" />सोलोमनका यी हितोपदेशहरू यहूदाका राजा हिजकियाका मानिसहरूले नक्‍कल गरे:<verse eid="PRO 25:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 25:2" />कुनै कुरा गोप्य राख्दा परमेश्‍वरको महिमा हुन्छ;</para>
  <para style="q2" vid="PRO 25:2">कुनै कुरा खोजी निकाल्दा राजाहरूको महिमा हुन्छ,<verse eid="PRO 25:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 25:3" />जसरी आकाशहरू उच्‍च छन् र पृथ्वी गहिरो,</para>
  <para style="q2" vid="PRO 25:3">त्यसरी नै राजाहरूका हृदय बुझ्न सकिँदैन।<verse eid="PRO 25:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 25:4" />चाँदीबाट अशुद्धता निकालिदेऊ,</para>
  <para style="q2" vid="PRO 25:4">ताकि त्यसबाट शिल्पकारले कुनै सामान बनाओस्।<verse eid="PRO 25:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 25:5" />राजाको उपस्थितिबाट दुष्‍ट अधिकारीहरूलाई निकालिदेऊ,</para>
  <para style="q2" vid="PRO 25:5">र तिनको सिंहासन धार्मिकतामाथि स्थापित हुनेछ।<verse eid="PRO 25:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 25:6" />राजाको उपस्थितिमा तिमीले आफूलाई उच्‍च नपार,</para>
  <para style="q2" vid="PRO 25:6">र महान् व्यक्तिहरूको बीचमा आफ्नो स्थानको दाबी नगर।<verse eid="PRO 25:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 25:7" />तिनले तिमीलाई भारदारहरूका सामु अनादर गर्नुभन्दा,</para>
  <para style="q2" vid="PRO 25:7">तिमीलाई “यहाँ माथितिर आऊ” भनिनुचाहिँ असल हुन्छ।</para>
  <para style="b" vid="PRO 25:7" />
  <para style="q1" vid="PRO 25:7">तिमीले आफ्नो आँखाले देखेका कुरा<verse eid="PRO 25:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="PRO 25:8" />झट्टै अदालतमा नलैजाऊ;</para>
  <para style="q1" vid="PRO 25:8">किनकि अन्त्यमा तिम्रो छिमेकीले तिमीलाई</para>
  <para style="q2" vid="PRO 25:8">शर्ममा पार्‍यो भने तिमी के गर्छौ?<verse eid="PRO 25:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 25:9" />आफ्नो छिमेकीसित बहस गर्दा,</para>
  <para style="q2" vid="PRO 25:9">अर्को मानिसको गोपनीयतामा विश्‍वासघात नगर,<verse eid="PRO 25:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 25:10" />नत्रता त्यो सुन्‍नेले तिमीलाई शर्ममा पार्नेछ,</para>
  <para style="q2" vid="PRO 25:10">र तिम्रो बदनाम कहिल्यै मेटिनेछैन।<verse eid="PRO 25:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 25:11" />ठिकसित बोलिएको वचन</para>
  <para style="q2" vid="PRO 25:11">चाँदीको डालोमा सुनका स्याउहरूजस्तै हुन्छन्।<verse eid="PRO 25:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 25:12" />सुन्‍ने कानलाई बुद्धिमान् मानिसको हप्की</para>
  <para style="q2" vid="PRO 25:12">सुनका लुर्का अथवा निखुर सुनका गहनाजस्तै हो।<verse eid="PRO 25:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 25:13" />कटनीको समयमा हिउँको चिसोजस्तै,</para>
  <para style="q2" vid="PRO 25:13">विश्‍वासयोग्य दूत उसलाई पठाउनेको निम्ति हुन्छ;</para>
  <para style="q2" vid="PRO 25:13">उसले आफ्ना मालिकको आत्मालाई उत्साहित तुल्याउँछ।<verse eid="PRO 25:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 25:14" />झरीविनाका बादल र बतासजस्तै,</para>
  <para style="q2" vid="PRO 25:14">आफूले नदिएको दानमा धाक लगाउने मानिस हुन्छ।<verse eid="PRO 25:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 25:15" />धैर्य गर्नाले शासकलाई मनाउन सकिन्छ;</para>
  <para style="q2" vid="PRO 25:15">र मिठो वचनले हड्डी तोडिदिन सक्छ।<verse eid="PRO 25:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 25:16" />मह भेट्टायो भने चाहिने जति मात्र खाऊ;</para>
  <para style="q2" vid="PRO 25:16">धेरै खायौ भने तिमीले बान्ता गर्नेछौ।<verse eid="PRO 25:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 25:17" />तिम्रो छिमेकीको घरमा कहिलेकाहीँ मात्र जाने गर;</para>
  <para style="q2" vid="PRO 25:17">घरी-घरी देख्दा त्यसले तिमीलाई घृणा गर्नेछ।<verse eid="PRO 25:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 25:18" />आफ्नो छिमेकीको विरुद्धमा झूटो साक्षी दिने मानिस</para>
  <para style="q2" vid="PRO 25:18">मुङ्ग्रो र तरवार वा तीखो काँडजस्तै हो।<verse eid="PRO 25:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 25:19" />विपत्तिको समयमा विश्‍वासघाती मानिसमाथि भरोसा गर्नु,</para>
  <para style="q2" vid="PRO 25:19">भाँचिएको दाँत अथवा भाँचिएको खुट्टाजस्तै हो।<verse eid="PRO 25:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 25:20" />दुःखी हृदय भएकालाई गीत सुनाइदिने मानिस,</para>
  <para style="q2" vid="PRO 25:20">जाडोको दिनमा लुगा खोस्‍ने मानिसजस्तै</para>
  <para style="q2" vid="PRO 25:20">अथवा घाउमा चूक हालेजस्तै हो।<verse eid="PRO 25:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 25:21" />यदि तिम्रो शत्रु भोकाएको छ भने त्यसलाई भोजन खान देऊ;</para>
  <para style="q2" vid="PRO 25:21">यदि त्यो तिर्खाएको छ भने त्यसलाई पानी पिउन देऊ।<verse eid="PRO 25:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 25:22" />यसो गर्नाले तिमीले त्यसको टाउकोमाथि बलिरहेका कोइलाहरू खन्याउनेछौ;</para>
  <para style="q2" vid="PRO 25:22">र याहवेहले तिमीलाई पुरस्कार दिनुहुनेछ।<verse eid="PRO 25:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 25:23" />उत्तरी बतासले अचानक पानी ल्याएजस्तै</para>
  <para style="q2" vid="PRO 25:23">धूर्त जिब्रोले रिसाएको अनुहारलाई ल्याउँछ।<verse eid="PRO 25:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 25:24" />कचकचे पत्नीसित एउटै घरमा बस्‍नुभन्दा</para>
  <para style="q2" vid="PRO 25:24">घरको कौसीको एउटा कुनामा बस्‍नु असल हो।<verse eid="PRO 25:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 25:25" />टाढा देशबाट आएको शुभ समाचार,</para>
  <para style="q2" vid="PRO 25:25">थाकेको प्राणको लागि चिसो पानीजस्तै हो।<verse eid="PRO 25:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 25:26" />दुष्‍ट मानिसको अगि झुक्ने धर्मी मानिस,</para>
  <para style="q2" vid="PRO 25:26">हिलो पानीको मूल अथवा दूषित कुवाजस्तै हो।<verse eid="PRO 25:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 25:27" />धेरै मह खानु असल होइन,</para>
  <para style="q2" vid="PRO 25:27">न त आफ्नै मान खोज्नु सम्मानजनक हो।<verse eid="PRO 25:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 25:28" />आत्मसंयम नभएका मानिस,</para>
  <para style="q2" vid="PRO 25:28">पर्खाल भत्काइएको सहरजस्तै हो।<verse eid="PRO 25:28" /></para>
  <chapter eid="PRO 25" />
  <chapter number="26" style="c" sid="PRO 26" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 26:1" />ग्रीष्मकालमा हिउँ र कटनीको समयमा पानी परेजस्तै,</para>
  <para style="q2" vid="PRO 26:1">मूर्खलाई सम्मान सुहाउँदैन।<verse eid="PRO 26:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 26:2" />भुर्र उड्ने भँगेरा र बेगले उड्ने गौँथलीजस्तै,</para>
  <para style="q2" vid="PRO 26:2">कारणविनाको श्राप पनि लाग्दैन।<verse eid="PRO 26:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 26:3" />घोडाको लागि कोर्रा, गधाको लागि लगाम,</para>
  <para style="q2" vid="PRO 26:3">र मूर्खहरूका पिठिउँमा छडी लगाउनुपर्छ!<verse eid="PRO 26:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 26:4" />मूर्खलाई त्यसको मूर्खताअनुसार जवाफ नदेऊ,</para>
  <para style="q2" vid="PRO 26:4">नत्रता तिमी आफू पनि त्योजस्तै हुनेछौ।<verse eid="PRO 26:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 26:5" />मूर्खलाई त्यसको मूर्खताअनुसार जवाफ देऊ,</para>
  <para style="q2" vid="PRO 26:5">नत्रता त्यो आफ्नै दृष्‍टिमा बुद्धिमान् हुनेछ।<verse eid="PRO 26:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 26:6" />मूर्खको हातमा समाचार पठाउनु भनेको</para>
  <para style="q2" vid="PRO 26:6">आफ्नो खुट्टा काट्नु वा विष पिउनुजस्तै हो।<verse eid="PRO 26:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 26:7" />मूर्खको मुखमा हितोपदेश</para>
  <para style="q2" vid="PRO 26:7">अपाङ्ग मानिसको झुण्डिएको खुट्टाजस्तै हो।<verse eid="PRO 26:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 26:8" />मूर्खलाई सम्मान दिनु</para>
  <para style="q2" vid="PRO 26:8">घुयेँत्रोमा ढुङ्गा बाँधेजस्तै हो।<verse eid="PRO 26:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 26:9" />मूर्खको मुखमा हितोपदेश</para>
  <para style="q2" vid="PRO 26:9">मतवालाको हातमा भएको काँडे झारजस्तै हो।<verse eid="PRO 26:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 26:10" />मूर्ख वा कुनै बटुवालाई ज्यालामा लगाउनु</para>
  <para style="q2" vid="PRO 26:10">धनुर्धारीले जथाभाबी काँड हानेर चोट लगाएजस्तै हो।<verse eid="PRO 26:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 26:11" />कुकुर आफ्नै बान्तामा फर्किआएजस्तै,</para>
  <para style="q2" vid="PRO 26:11">मूर्खले आफ्नो मूर्खता दोहोर्‍याउँछ।<verse eid="PRO 26:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 26:12" />के तिमी कुनै मानिसलाई आफ्नै दृष्‍टिमा बुद्धिमानी देख्छौ?</para>
  <para style="q2" vid="PRO 26:12">त्यसको भन्दा त बरु मूर्खको लागि धेरै आशा हुन्छ।<verse eid="PRO 26:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 26:13" />अल्छेले भन्छ, “बाटोमा सिंह छ,</para>
  <para style="q2" vid="PRO 26:13">एउटा डरलाग्दो सिंह गल्‍लीहरूमा डुलिरहेको छ।”<verse eid="PRO 26:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 26:14" />ढोका कब्जामा यताउता फर्केजस्तै,</para>
  <para style="q2" vid="PRO 26:14">अल्छे आफ्नो ओछ्यानमा यताउता पल्टिन्छ।<verse eid="PRO 26:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 26:15" />अल्छेले आफ्नो हात थालमा राख्छ,</para>
  <para style="q2" vid="PRO 26:15">तर त्यसले आफ्नो हात उठाएर मुखसम्म पनि पुर्‍याउन अल्छी मान्छ।<verse eid="PRO 26:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 26:16" />सात जना मानिसले बुद्धिपूर्वक जवाफ दिएकोभन्दा,</para>
  <para style="q2" vid="PRO 26:16">एक जना अल्छे आफ्नै दृष्‍टिमा बुद्धिमान् हुन्छ।<verse eid="PRO 26:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 26:17" />बाटो हिँड्ने मानिसले अर्काको झगडामा हस्तक्षेप गर्नु,</para>
  <para style="q2" vid="PRO 26:17">कुकुरलाई कानमा समात्नुजस्तै हो।<verse eid="PRO 26:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18-19" style="v" sid="PRO 26:18-19" />आफ्नो छिमेकीलाई छल गरिसकेपछि,</para>
  <para style="q2" vid="PRO 26:18-19">“मैले त ठट्टा मात्र गरेको हो!” भन्‍ने व्यक्ति</para>
  <para style="q1" vid="PRO 26:18-19">अगुल्टो वा घातक काँड हान्‍ने बौलाहाजस्तो हो।<verse eid="PRO 26:18-19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 26:20" />दाउराविना आगो निभ्छ;</para>
  <para style="q2" vid="PRO 26:20">कुरौटेविना झगडा शान्त हुन्छ।<verse eid="PRO 26:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 26:21" />भुङ्ग्राको लागि कोइला, र आगोको लागि दाउराजस्तै,</para>
  <para style="q2" vid="PRO 26:21">झगडा मच्च्याउनको लागि झगडालु मानिस हुन्छ।<verse eid="PRO 26:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 26:22" />कुरौटेका बोलीहरू स्वादिष्‍ठ गाँसजस्तै हुन्छन्,</para>
  <para style="q2" vid="PRO 26:22">ती मानिसका भित्री भागहरूमा पुग्छन्।<verse eid="PRO 26:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 26:23" />माटोको भाँडोमा चाँदीको जलप लगाएजस्तै,</para>
  <para style="q2" vid="PRO 26:23">दुष्‍ट हृदयका जोशिला ओठ हुन्छन्।<verse eid="PRO 26:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 26:24" />शत्रुले अरूप्रति आफ्नो घृणा मधुर शब्दहरूले लुकाउँछ,</para>
  <para style="q2" vid="PRO 26:24">तर त्यसको हृदयमा चाहिँ छल भरिएको हुन्छ।<verse eid="PRO 26:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 26:25" />त्यसको बोली मनमोहक भए तापनि त्यसमा विश्‍वास नगर;</para>
  <para style="q2" vid="PRO 26:25">किनकि त्यसको हृदय सात वटा घिनलाग्दा कुराले भरिएको हुन्छ।<verse eid="PRO 26:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 26:26" />त्यसको घृणा छलद्वारा ढाकिएको हुन्छ,</para>
  <para style="q2" vid="PRO 26:26">तर त्यसको दुष्‍टता सभामा प्रकट गरिनेछ।<verse eid="PRO 26:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 26:27" />कुनै मानिसले खाडल खन्यो भने त्यो आफैँ त्यसमा पर्नेछ;</para>
  <para style="q2" vid="PRO 26:27">कुनै मानिसले ढुङ्गा गुडायो भने त्यो गुडेर त्यसतर्फ फर्कनेछ।<verse eid="PRO 26:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 26:28" />झूटो बोल्ने जिब्रोले जसलाई चोट पार्छ, त्यसैलाई घृणा गर्छ,</para>
  <para style="q2" vid="PRO 26:28">र चापलुसी घस्‍ने मुखले विनाश ल्याउँछ।<verse eid="PRO 26:28" /></para>
  <para style="b" />
  <chapter eid="PRO 26" />
  <chapter number="27" style="c" sid="PRO 27" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 27:1" />भोलिको घमण्ड नगर;</para>
  <para style="q2" vid="PRO 27:1">किनकि त्यो कस्तो दिन हुनेछ, सो तिमी जान्दैनौ।<verse eid="PRO 27:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 27:2" />तिम्रो प्रशंसा आफ्नै मुखले होइन, तर अरू कसैबाट होस्;</para>
  <para style="q2" vid="PRO 27:2">कुनै अपरिचितबाट, तर तिम्रो ओठबाट होइन।<verse eid="PRO 27:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 27:3" />ढुङ्गा गह्रौँ र बालुवा ओजनदार हुन्छ,</para>
  <para style="q2" vid="PRO 27:3">तर मूर्खको क्रोध यी दुवैभन्दा गह्रौँ हुन्छ।<verse eid="PRO 27:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 27:4" />रिस निर्दयी र क्रोध बाढीझैँ हुन्छ;</para>
  <para style="q2" vid="PRO 27:4">तर डाहको अगि को खडा हुन सक्छ र?<verse eid="PRO 27:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 27:5" />गुप्‍तको प्रेमभन्दा</para>
  <para style="q2" vid="PRO 27:5">खुल्‍लमखुल्‍ला हप्की असल हुन्छ।<verse eid="PRO 27:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 27:6" />मित्रबाट पाएको चोट पत्यार गर्न सकिने हुन्छ;</para>
  <para style="q2" vid="PRO 27:6">तर शत्रुले चुम्बनको वर्षा गर्छ।<verse eid="PRO 27:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 27:7" />अघाएको पेटले मह रुचाउँदैन,</para>
  <para style="q2" vid="PRO 27:7">तर भोकाएकाहरूलाई तितो पनि मिठो हुन्छ।<verse eid="PRO 27:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 27:8" />घरदेखि टाढा बरालिएको मानिस,</para>
  <para style="q2" vid="PRO 27:8">आफ्नो गुँडदेखि टाढा भड्किरहेको चरोजस्तै हो।<verse eid="PRO 27:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 27:9" />अत्तर र धूपले हृदयमा आनन्द ल्याउँछ;</para>
  <para style="q2" vid="PRO 27:9">र मित्रको आनन्द त्यसको</para>
  <para style="q2" vid="PRO 27:9">आन्तरिक सल्‍लाहबाट आउँछ।<verse eid="PRO 27:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 27:10" />आफ्नो मित्र वा आफ्नो परिवारका मित्रलाई नत्याग,</para>
  <para style="q2" vid="PRO 27:10">तिमीलाई विपत्ति आइपर्दा आफ्नो दाजुभाइको घरमा नजाऊ;</para>
  <para style="q2" vid="PRO 27:10">किनकि टाढा बस्‍ने आफन्तभन्दा नजिक बस्‍ने छिमेकी असल हुन्छ।<verse eid="PRO 27:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 27:11" />हे मेरा छोराछोरी, बुद्धिमान् होऊ, र मेरो हृदयलाई आनन्दित बनाइदेऊ;</para>
  <para style="q2" vid="PRO 27:11">तब मलाई हेला गर्नेहरूलाई म जवाफ दिन सक्नेछु।<verse eid="PRO 27:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 27:12" />विवेकशील व्यक्तिले जोखिमलाई देखेर शरण लिन्छ;</para>
  <para style="q2" vid="PRO 27:12">तर सोझाचाहिँ त्यतैतिर जान्छ र परिणाम भोग्छ।<verse eid="PRO 27:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 27:13" />परदेशीको जमानी बस्‍नेको लुगा लिइराख;</para>
  <para style="q2" vid="PRO 27:13">परदेशीको जमानी बसेको छ भने त्यो लुगा बन्धकको रूपमा लिइराख।<verse eid="PRO 27:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 27:14" />कुनै मानिसले एकाबिहानै आफ्नो छिमेकीलाई चर्को सोरमा आशिष् दिन्छ भने,</para>
  <para style="q2" vid="PRO 27:14">त्यो त त्यसका निम्ति श्राप दिएजस्तो हुनेछ।<verse eid="PRO 27:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 27:15" />झगडालु पत्नी मुसलधारे पानी परेको दिन</para>
  <para style="q2" vid="PRO 27:15">तपतप चुहिरहने छानोजस्तै हो,<verse eid="PRO 27:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 27:16" />त्यसलाई वशमा राख्नु</para>
  <para style="q2" vid="PRO 27:16">बतासलाई वशमा राख्नुजस्तो हो, अथवा हातले तेललाई च्याप्प पक्रनुजस्तै हो।<verse eid="PRO 27:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 27:17" />फलामले फलामलाई धारिलो बनाएजस्तै,</para>
  <para style="q2" vid="PRO 27:17">एउटा मानिसले अर्को मानिसलाई तिखार्छ।<verse eid="PRO 27:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 27:18" />अञ्जीरको बोट स्याहार्नेले त्यसको फल खानेछ;</para>
  <para style="q2" vid="PRO 27:18">र आफ्ना मालिकको रेखदेख गर्ने व्यक्ति सम्मानित हुनेछ।<verse eid="PRO 27:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 27:19" />पानीमा अनुहार प्रतिविम्बित भएजस्तै,</para>
  <para style="q2" vid="PRO 27:19">मानिसको हृदयले व्यक्तित्वलाई प्रतिविम्बित पार्छ।<verse eid="PRO 27:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 27:20" />मृत्यु र विनाश<note caller="+" style="f"><char style="fr" closed="false">27:20 </char><char style="ft" closed="false">मूल भाषामा </char><char style="fqa" closed="false">शिओल र अबाडोन</char></note> कहिल्यै सन्तुष्‍ट हुँदैनन्,</para>
  <para style="q2" vid="PRO 27:20">न त मानिसका आँखा नै सन्तुष्‍ट हुन्छ।<verse eid="PRO 27:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 27:21" />चाँदी पगाल्ने भाँडो र सुन खार्ने भट्टी हुन्छ,</para>
  <para style="q2" vid="PRO 27:21">तर मानिसलाई चाहिँ त्यसले पाएको प्रशंसाद्वारा जाँचिएको हुन्छ।<verse eid="PRO 27:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 27:22" />मूर्खलाई ओखलीमा पिँधे तापनि</para>
  <para style="q2" vid="PRO 27:22">वा त्यसलाई जाँतोमा राखेर अन्‍नझैँ पिँधे तापनि</para>
  <para style="q2" vid="PRO 27:22">तिमीले त्यसको मूर्खता निकाल्न सक्नेछैनौ।<verse eid="PRO 27:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 27:23" />तिम्रा भेडाबाख्राहरूको अवस्था राम्ररी थाहा गर,</para>
  <para style="q2" vid="PRO 27:23">आफ्ना बगालप्रति सावधानीपूर्वक ध्यान देऊ;<verse eid="PRO 27:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 27:24" />किनकि धनसम्पत्ति सधैँ रहिरहँदैन;</para>
  <para style="q2" vid="PRO 27:24">र मुकुट पुस्ता-पुस्तासम्म सुरक्षित रहँदैन।<verse eid="PRO 27:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 27:25" />जब पराल हटाइन्छ, र नयाँ पालुवा देखा पर्छ,</para>
  <para style="q2" vid="PRO 27:25">अनि डाँडा-पाखाहरूबाट घाँस बटुलिन्छ,<verse eid="PRO 27:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 27:26" />तब भेडाहरूले तिमीलाई वस्त्रको प्रबन्ध गरिदिन्छन्;</para>
  <para style="q2" vid="PRO 27:26">र बाख्राहरूले जमिनको निम्ति पैसाको प्रबन्ध गरिदिन्छन्।<verse eid="PRO 27:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 27:27" />तिमीसित बाख्रीका दूध प्रशस्त हुनेछ, जसबाट तिमी र तिम्रो परिवारलाई खान पुग्नेछ,</para>
  <para style="q2" vid="PRO 27:27">र तिम्रा नोकर्नीहरूलाई पोषण हुनेछ।<verse eid="PRO 27:27" /></para>
  <para style="b" />
  <chapter eid="PRO 27" />
  <chapter number="28" style="c" sid="PRO 28" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 28:1" />कसैले नखेदे तापनि दुष्‍ट मानिस भाग्छ;</para>
  <para style="q2" vid="PRO 28:1">तर धर्मीचाहिँ सिंहजस्तै साहसी हुन्छ।<verse eid="PRO 28:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 28:2" />कुनै देश बागी भयो भने त्यसका धेरै शासकहरू हुन्छन्;</para>
  <para style="q2" vid="PRO 28:2">तर समझशक्ति र ज्ञान भएका शासकले सुख-शान्ति कायम राख्छ।<verse eid="PRO 28:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 28:3" />गरिबमाथि शोषण गर्ने शासक</para>
  <para style="q2" vid="PRO 28:3">अन्‍न नाश गर्ने मुसलधारे वृष्‍टिजस्तै हो।<verse eid="PRO 28:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 28:4" />व्यवस्था त्याग्नेहरूले दुष्‍टहरूका प्रशंसा गर्छन्;</para>
  <para style="q2" vid="PRO 28:4">तर व्यवस्था पालन गर्नेहरूले तिनीहरूको विरोध गर्छन्।<verse eid="PRO 28:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 28:5" />दुष्‍ट मानिसहरूले न्याय बुझ्दैनन्,</para>
  <para style="q2" vid="PRO 28:5">तर याहवेहलाई खोज्नेहरूले यसलाई सम्पूर्ण रूपले बुझ्दछन्।<verse eid="PRO 28:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 28:6" />धनी भएर भ्रष्‍ट जीवन जिउनुभन्दा</para>
  <para style="q2" vid="PRO 28:6">बरु गरिब भएर निर्दोष जीवन जिउनु असल हो।<verse eid="PRO 28:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 28:7" />विवेकी छोराछोरीले शिक्षामा ध्यान दिन्छन्;</para>
  <para style="q2" vid="PRO 28:7">तर घिचुवाहरूको सङ्गत गर्नेले आमाबुबालाई अपमान तुल्याउँछन्।<verse eid="PRO 28:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 28:8" />ब्याज लगाएर जसले आफ्नो सम्पत्ति बढाउँछ,</para>
  <para style="q2" vid="PRO 28:8">त्यसले कुम्ल्याएको धन गरिबमाथि दया राख्नेको हुनेछ।<verse eid="PRO 28:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 28:9" />यदि कसैले व्यवस्थाप्रति आफ्नो कान सुन्‍नदेखि बन्द गर्छ भने,</para>
  <para style="q2" vid="PRO 28:9">त्यसका प्रार्थनाहरू पनि घृणित हुन्छन्।<verse eid="PRO 28:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 28:10" />जसले धर्मी जीवन जिउनेलाई खराब बाटोतिर लैजान्छ,</para>
  <para style="q2" vid="PRO 28:10">त्यो आफ्नै पासोमा फस्‍नेछ;</para>
  <para style="q2" vid="PRO 28:10">तर निर्दोषले प्रशस्त अंश पाउनेछ।<verse eid="PRO 28:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 28:11" />धनी मानिस आफ्नै दृष्‍टिमा बुद्धिमान् हुन्छ;</para>
  <para style="q2" vid="PRO 28:11">तर समझशक्ति भएका गरिब मानिसले त्यसलाई ठिकसँग मूल्याङ्कन गर्छ।<verse eid="PRO 28:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 28:12" />धर्मी जनहरू विजय हुँदा ठूलो खुशीयाली हुन्छ;</para>
  <para style="q2" vid="PRO 28:12">तर दुष्‍टहरू उच्‍च पदमा पुग्दा मानिसहरू लुक्न थाल्छन्।<verse eid="PRO 28:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 28:13" />आफ्ना पापहरू लुकाउनेले उन्‍नति गर्दैन;</para>
  <para style="q2" vid="PRO 28:13">तर जसले ती स्वीकार गर्छ र त्याग्छ, त्यसले कृपा पाउँछ।<verse eid="PRO 28:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 28:14" />धन्य हो त्यो मानिस, जसले सधैँभरि याहवेहप्रति श्रद्धा राख्छ;</para>
  <para style="q2" vid="PRO 28:14">तर आफ्नो हृदय कठोर गर्ने व्यक्ति जोखिममा पर्छ।<verse eid="PRO 28:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 28:15" />असहाय मानिसहरूमाथि शासन गर्ने दुष्‍ट शासक</para>
  <para style="q2" vid="PRO 28:15">गर्जने सिंह र आक्रमक भालुजस्तै हुन्छ।<verse eid="PRO 28:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 28:16" />अत्याचारी शासकको विवेक हुँदैन;</para>
  <para style="q2" vid="PRO 28:16">तर जसले दुष्‍ट कमाइद्वारा पाएको लाभलाई घृणा गर्छ, उसले लामो शासनको आनन्द पाउनेछ।<verse eid="PRO 28:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 28:17" />हत्याको दोषले सताएको मानिस</para>
  <para style="q2" vid="PRO 28:17">चिहानमा शरण लिनेछ;</para>
  <para style="q2" vid="PRO 28:17">कसैले पनि त्यसलाई सहायता नगरोस्।<verse eid="PRO 28:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 28:18" />निर्दोष जीवन जिउने व्यक्ति सुरक्षित रहन्छ;</para>
  <para style="q2" vid="PRO 28:18">तर जसका मार्गहरू भ्रष्‍ट छन्, तिनीहरू अचानक पतन हुनेछन्।<verse eid="PRO 28:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 28:19" />आफ्नो जमिन खनजोत गर्नेसित प्रशस्त भोजन हुनेछ;</para>
  <para style="q2" vid="PRO 28:19">तर दिवासपनाको पछि दौडने मानिसहरू गरिबीले घेरिएका हुन्छन्।<verse eid="PRO 28:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 28:20" />विश्‍वासयोग्य मानिसले धेरै आशिष् पाउनेछ;</para>
  <para style="q2" vid="PRO 28:20">तर धनी हुने इच्छुक व्यक्ति दण्ड नपाई उम्कनेछैन।<verse eid="PRO 28:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 28:21" />पक्षपात गर्नु उचित होइन;</para>
  <para style="q2" vid="PRO 28:21">तापनि मानिसले एक टुक्रा रोटीको निम्ति पनि खराब काम गर्छ।<verse eid="PRO 28:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 28:22" />लोभी मानिस धनी हुने लालसा गर्छ;</para>
  <para style="q2" vid="PRO 28:22">र त्यसलाई दरिद्रताले पर्खिरहेको छ भन्‍ने त्यसलाई थाहै हुँदैन।<verse eid="PRO 28:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 28:23" />कुनै मानिसलाई हप्काउनेले अन्त्यमा</para>
  <para style="q2" vid="PRO 28:23">चापलुसी जिब्रो भएकोभन्दा बढी निगाह प्राप्‍त गर्नेछ।<verse eid="PRO 28:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 28:24" />आफ्नो बुबा वा आमालाई लुटेर</para>
  <para style="q2" vid="PRO 28:24">“यो त भूल होइन” भन्‍ने व्यक्ति</para>
  <para style="q2" vid="PRO 28:24">विनाशकारीको साझेदारजस्तै हो।<verse eid="PRO 28:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 28:25" />लोभी मानिसले फाटो ल्याउँछ;</para>
  <para style="q2" vid="PRO 28:25">तर याहवेहमा भरोसा राख्ने मानिसले उन्‍नति गर्छ।<verse eid="PRO 28:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 28:26" />आफूमाथि भरोसा राख्ने व्यक्ति मूर्ख हो;</para>
  <para style="q2" vid="PRO 28:26">तर बुद्धिको चालमा चल्ने सुरक्षित रहन्छ।<verse eid="PRO 28:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 28:27" />जसले गरिबलाई दिन्छ, उसलाई कुनै अभाव हुनेछैन;</para>
  <para style="q2" vid="PRO 28:27">तर तिनीहरूप्रति वास्ता नदेखाउनेले धेरै श्राप पाउँछ।<verse eid="PRO 28:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="PRO 28:28" />दुष्‍टको हातमा शासनको जिम्मा आयो भने मानिसहरू लुक्छन्;</para>
  <para style="q2" vid="PRO 28:28">तर जब दुष्‍टको सर्वनाश हुन्छ, धर्मी फस्टाउँछन्।<verse eid="PRO 28:28" /></para>
  <para style="b" />
  <chapter eid="PRO 28" />
  <chapter number="29" style="c" sid="PRO 29" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 29:1" />बारम्बार हप्की पाएर पनि अटेरी भई बस्‍ने मानिस,</para>
  <para style="q2" vid="PRO 29:1">अचानक नाश हुनेछ—उपाय नै नरहने गरी।<verse eid="PRO 29:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 29:2" />धर्मीको फलिफाप हुँदा मानिसहरू रमाउँछन्;</para>
  <para style="q2" vid="PRO 29:2">दुष्‍टले शासन गर्दा मानिसहरू सुस्केरा हाल्छन्।<verse eid="PRO 29:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 29:3" />बुद्धि मन पराउने मानिसले आफ्ना बुबालाई आनन्दित तुल्याउँछ;</para>
  <para style="q2" vid="PRO 29:3">तर वेश्याहरूसँग सङ्गत गर्नेले आफ्नो धनसम्पत्ति बेकाममा उडाउँछ।<verse eid="PRO 29:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 29:4" />राजाले न्यायद्वारा देशलाई स्थिर राख्छन्;</para>
  <para style="q2" vid="PRO 29:4">तर घूसको लोभ गर्नेले देशलाई सर्वनाश पार्छ।<verse eid="PRO 29:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 29:5" />जसले आफ्नो छिमेकीलाई फुर्काउँछ,</para>
  <para style="q2" vid="PRO 29:5">त्यसले त्यसका खुट्टामुनि जाल बिछ्याउँछ।<verse eid="PRO 29:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PRO 29:6" />दुष्‍ट मानिस त्यसका आफ्नै पापको कारण पासोमा पर्छ;</para>
  <para style="q2" vid="PRO 29:6">तर धर्मी आनन्दले चिच्याउँछ र खुशी हुन्छ।<verse eid="PRO 29:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 29:7" />धर्मीले गरिबको न्यायको वास्ता गर्छ;</para>
  <para style="q2" vid="PRO 29:7">तर दुष्‍टलाई चाहिँ त्यसबारे वास्तै हुँदैन।<verse eid="PRO 29:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 29:8" />गिल्‍ला गर्नेले सहरभरि हल्‍ला मच्‍चाउँछ;</para>
  <para style="q2" vid="PRO 29:8">तर बुद्धिमान् मानिसले रिस शान्त गराउँछ।<verse eid="PRO 29:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="PRO 29:9" />यदि बुद्धिमान् मानिस मूर्खसित अदालतमा गयो भने,</para>
  <para style="q2" vid="PRO 29:9">मूर्खको रिस र उपहासले त्यहाँ शान्ति हुँदैन।<verse eid="PRO 29:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 29:10" />रक्तपात गर्ने मानिसहरूले इमानदार मानिसलाई घृणा गर्छन्;</para>
  <para style="q2" vid="PRO 29:10">र धर्मीलाई मार्न खोज्छन्।<verse eid="PRO 29:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 29:11" />मूर्खले आफ्नो क्रोध पूर्ण रूपमा पोखाउँछ,</para>
  <para style="q2" vid="PRO 29:11">तर बुद्धिमान्‌ले यसलाई नियन्त्रणमा राख्छ।<verse eid="PRO 29:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="PRO 29:12" />यदि कुनै शासकले झूटो कुरा सुन्यो भने,</para>
  <para style="q2" vid="PRO 29:12">त्यसका सबै अधिकारीहरू दुष्‍ट हुनेछन्।<verse eid="PRO 29:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PRO 29:13" />गरिब र अत्याचारीमा यो कुरा समान हुन्छ:</para>
  <para style="q2" vid="PRO 29:13">याहवेहले तिनीहरू दुवैका आँखालाई उज्यालो पार्नुहुन्छ।<verse eid="PRO 29:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="PRO 29:14" />यदि राजाले गरिबहरूको ठिक न्याय गर्छन् भने,</para>
  <para style="q2" vid="PRO 29:14">तिनको सिंहासन सदाको निम्ति स्थापित रहनेछ।<verse eid="PRO 29:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 29:15" />सुधारको छडी र हप्कीले बुद्धि प्रदान गर्छ,</para>
  <para style="q2" vid="PRO 29:15">तर अनुशासनहीन छोराछोरीले आफ्नी आमाको बेइज्जत गर्छन्।<verse eid="PRO 29:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="PRO 29:16" />जब दुष्‍टको फलिफाप हुन्छ, तब पापको पनि फलिफाप हुन्छ;</para>
  <para style="q2" vid="PRO 29:16">तर धर्मीले तिनीहरूको पतन देख्नेछ।<verse eid="PRO 29:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 29:17" />आफ्ना छोराछोरीलाई अनुशासनमा राख, तिनीहरूले तिमीलाई शान्ति दिनेछन्;</para>
  <para style="q2" vid="PRO 29:17">तिमीले चाहेको खुशी तिनीहरूले ल्याउनेछन्।<verse eid="PRO 29:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PRO 29:18" />जहाँ दर्शन छैन, त्यहाँ मानिसहरू आफूखुशी गर्छन्;</para>
  <para style="q2" vid="PRO 29:18">तर त्यो मानिस धन्यको हो, जसले व्यवस्थालाई पालन गर्दछ।<verse eid="PRO 29:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="PRO 29:19" />दासहरूलाई वचनले मात्र सुधार्न सकिँदैन;</para>
  <para style="q2" vid="PRO 29:19">तिनीहरूले बुझे तापनि प्रतिउत्तर दिँदैनन्।<verse eid="PRO 29:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 29:20" />के हतारसित बोल्ने मानिसलाई देखेका छौ?</para>
  <para style="q2" vid="PRO 29:20">त्यसका निम्ति भन्दा त बरु एउटा मूर्खका निम्ति धेरै आशा हुन्छ।<verse eid="PRO 29:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="PRO 29:21" />मानिसले आफ्नो दासलाई बाल्यकालदेखि नै पुलपुलायो भने,</para>
  <para style="q2" vid="PRO 29:21">अन्त्यमा त्यो समस्या बन्‍नेछ।<verse eid="PRO 29:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="PRO 29:22" />क्रोधी मानिसले झगडा मच्‍चाउँछ,</para>
  <para style="q2" vid="PRO 29:22">अनि गरम मिजास भएका मानिसले धेरै पाप गर्छ।<verse eid="PRO 29:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="PRO 29:23" />मानिसको अहङ्कारले त्यसलाई पतन गराउँछ;</para>
  <para style="q2" vid="PRO 29:23">तर कोमल आत्मा भएको मानिसले सम्मान पाउँछ।<verse eid="PRO 29:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="PRO 29:24" />चोरको साझेदार हुने त्यसको आफैँ शत्रु हुन्छ;</para>
  <para style="q2" vid="PRO 29:24">त्यसले शपथ खाएर पनि साक्षी दिन आँटै गर्दैन।<verse eid="PRO 29:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="PRO 29:25" />मानिसको डर पासोमा प्रमाणित हुन्छ;</para>
  <para style="q2" vid="PRO 29:25">तर जसले याहवेहमाथि भरोसा राख्छ, ऊ सुरक्षित रहन्छ।<verse eid="PRO 29:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="PRO 29:26" />धेरैले शासकको निगाह प्राप्‍त गर्न चाहन्छन्;</para>
  <para style="q2" vid="PRO 29:26">तर मानिसले याहवेहबाट मात्र न्याय पाउँछ।<verse eid="PRO 29:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="PRO 29:27" />भ्रष्‍ट मानिसले धर्मीलाई घृणा गर्छ;</para>
  <para style="q2" vid="PRO 29:27">र दुष्‍टले धर्मी जीवन जिउनेलाई घृणा गर्छ।<verse eid="PRO 29:27" /></para>
  <chapter eid="PRO 29" />
  <chapter number="30" style="c" sid="PRO 30" />
  <para style="ms1">आगूरका भनाइहरू</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 30:1" />याकेका छोरा आगूरका वचन—एक ईश्‍वरवाणी:</para>
  <para style="q1" vid="PRO 30:1">यस मानिसले इतीएल र युकाललाई घोषणा गरेका हुन्:<verse eid="PRO 30:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="PRO 30:2" />निःसंदेह म एक जनावर हुँ, मानिस होइनँ;</para>
  <para style="q2" vid="PRO 30:2">मसँग मानवीय समझशक्ति छैन।<verse eid="PRO 30:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 30:3" />मैले बुद्धि सिकिनँ,</para>
  <para style="q2" vid="PRO 30:3">न त मसित पवित्र परमेश्‍वरको ज्ञान नै छ।<verse eid="PRO 30:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 30:4" />स्वर्गसम्म को उक्लेको छ, र तल ओर्लेर को आएको छ?</para>
  <para style="q2" vid="PRO 30:4">कसका हातले बतासलाई समातेको छ?</para>
  <para style="q1" vid="PRO 30:4">कसले पानीलाई वस्त्रमा बाँधेको छ?</para>
  <para style="q2" vid="PRO 30:4">कसले पृथ्वीका सबै छेउलाई स्थापित गरेको छ?</para>
  <para style="q1" vid="PRO 30:4">उहाँको नाम के हो, र उहाँको पुत्रको नाम के हो?</para>
  <para style="q2" vid="PRO 30:4">यदि तिमीलाई थाहा छ भने मलाई भन!<verse eid="PRO 30:4" /></para>
  <para style="b" />
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PRO 30:5" />“परमेश्‍वरका प्रत्येक वचन खोटरहित छ;</para>
  <para style="q2" vid="PRO 30:5">उहाँमा शरण लिनेहरू सबैका निम्ति उहाँ ढाल हुनुहुन्छ।<verse eid="PRO 30:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 30:6" />उहाँका वचनहरूमा केही नथप;</para>
  <para style="q2" vid="PRO 30:6">नत्रता उहाँले तिमीलाई हप्काउनुहुनेछ, र झूटो प्रमाणित गर्नुहुनेछ।<verse eid="PRO 30:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 30:7" />“हे याहवेह, तपाईंबाट म दुई कुराहरू माग्दछु;</para>
  <para style="q2" vid="PRO 30:7">म मर्नुभन्दा अगि ती मबाट इन्कार नगर्नुहोस्:<verse eid="PRO 30:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 30:8" />असत्य र झूटो कुरा मबाट टाढा राखिदिनुहोस्;</para>
  <para style="q2" vid="PRO 30:8">न मलाई गरिबी, न त धनसम्पत्ति नै दिनुहोस्;</para>
  <para style="q2" vid="PRO 30:8">तर मलाई केवल दैनिक भोजन दिनुहोस्।<verse eid="PRO 30:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 30:9" />नत्रता मसित प्रशस्त भएर मैले तपाईंलाई इन्कार गरुँला,</para>
  <para style="q2" vid="PRO 30:9">र भनुँला ‘याहवेह को हुनुहुन्छ र?’</para>
  <para style="q1" vid="PRO 30:9">अथवा म गरिब भएर चोरी गरुँला,</para>
  <para style="q2" vid="PRO 30:9">र मेरा परमेश्‍वरको नामको अनादर गरुँला।<verse eid="PRO 30:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PRO 30:10" />“कर्मचारीलाई त्यसको मालिकको सामु अपमान नगर्नू;</para>
  <para style="q2" vid="PRO 30:10">नत्रता त्यसले तिमीलाई सराप्ला र तिमीले नोक्सानी उठाउनुपर्नेछ।<verse eid="PRO 30:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PRO 30:11" />“यस्ताहरू पनि हुन्छन्, जसले आफ्ना बुबाहरूलाई सराप्छन्;</para>
  <para style="q2" vid="PRO 30:11">र आफ्ना आमाहरूलाई धन्यका ठान्दैनन्।<verse eid="PRO 30:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 30:12" />तिनीहरू, जो आफ्नै दृष्‍टिमा शुद्ध छन्,</para>
  <para style="q2" vid="PRO 30:12">र पनि आफ्ना अपवित्रताबाट चोख्याइएका छैनन्।<verse eid="PRO 30:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 30:13" />तिनीहरू, जसका आँखाहरू अति अहङ्कारी छन्!</para>
  <para style="q2" vid="PRO 30:13">जसका आँखीभौँ घमण्डले उठेका छन्,<verse eid="PRO 30:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 30:14" />तिनीहरू, जसका दाँतहरू तरवारहरू हुन्,</para>
  <para style="q2" vid="PRO 30:14">र जसका बङ्गाराहरू छुरीजस्तै छन्,</para>
  <para style="q1" vid="PRO 30:14">जसले गरिबलाई पृथ्वीबाट</para>
  <para style="q2" vid="PRO 30:14">र खाँचोमा परेकाहरूलाई मानव-जातिका माझमा निल्छन्।<verse eid="PRO 30:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="PRO 30:15" />“जुकाका दुई छोरीहरू छन्।</para>
  <para style="q2" vid="PRO 30:15">तिनीहरू ‘देऊ! देऊ!’ भनी कराउँछन्।</para>
  <para style="b" vid="PRO 30:15" />
  <para style="li1" vid="PRO 30:15">“तीन वटा कुराहरू छन्, जो कहिल्यै तृप्‍त हुँदैनन्;</para>
  <para style="li2" vid="PRO 30:15">चार वटा कुराहरू छन्, जो कहिल्यै पुग्यो भन्दैनन्!<verse eid="PRO 30:15" /></para>
  <para style="li3">
    <verse number="16" style="v" sid="PRO 30:16" />चिहान,</para>
  <para style="li3" vid="PRO 30:16">बाँझो गर्भ;</para>
  <para style="li3" vid="PRO 30:16">जमिन, जो कहिल्यै पानीदेखि तृप्‍त हुँदैन,</para>
  <para style="li3" vid="PRO 30:16">र आगो, जसले कहिल्यै ‘पुग्यो!’ भनी भन्दैन।<verse eid="PRO 30:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="PRO 30:17" />“त्यो आँखा, जसले बुबालाई खिसी गर्छ,</para>
  <para style="q2" vid="PRO 30:17">र आमाको आज्ञालाई तुच्छ ठान्छ,</para>
  <para style="q1" vid="PRO 30:17">त्यसलाई बेँसीका कागहरूले ठुँगेर बाहिर निकाल्नेछन्,</para>
  <para style="q2" vid="PRO 30:17">र गिद्धहरूले खानेछन्।<verse eid="PRO 30:17" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="18" style="v" sid="PRO 30:18" />“तीन वटा कुराहरू छन्, जो मेरा निम्ति धेरै अचम्मका छन्;</para>
  <para style="li2" vid="PRO 30:18">चार वटा, जो म बुझ्दिनँ:<verse eid="PRO 30:18" /></para>
  <para style="li3">
    <verse number="19" style="v" sid="PRO 30:19" />आकाशमा गरुडको चाल;</para>
  <para style="li3" vid="PRO 30:19">चट्टानमाथि सर्पको चाल,</para>
  <para style="li3" vid="PRO 30:19">महासमुद्रमा जहाजको चाल;</para>
  <para style="li3" vid="PRO 30:19">र स्त्रीसँग पुरुषको चाल।<verse eid="PRO 30:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 30:20" />“व्यभिचारिणी स्त्रीको चाल यस्तो हुन्छ:</para>
  <para style="q2" vid="PRO 30:20">त्यसले खान्छे र आफ्नो मुख पुछ्छे,</para>
  <para style="q2" vid="PRO 30:20">अनि त्यसपछि भन्छे, ‘मैले केही कुकर्म गरेकी छैनँ।’<verse eid="PRO 30:20" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="21" style="v" sid="PRO 30:21" />“तीन वटा कुराहरूमा पृथ्वी काम्छ;</para>
  <para style="li2" vid="PRO 30:21">चार वटा कुराहरू, जो त्यसले सहन सक्दैन:<verse eid="PRO 30:21" /></para>
  <para style="li3">
    <verse number="22" style="v" sid="PRO 30:22" />नोकर, जब राजा बन्छ,</para>
  <para style="li3" vid="PRO 30:22">मूर्खले पेटभरि भोजन खाएको,<verse eid="PRO 30:22" /></para>
  <para style="li3">
    <verse number="23" style="v" sid="PRO 30:23" />माया नपाएकी स्त्रीले विवाह गरेकी,</para>
  <para style="li3" vid="PRO 30:23">र नोकर्नी, जो आफ्नी मालिक्नीलाई पन्छाएर तिनको स्थानमा बस्छे।<verse eid="PRO 30:23" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="24" style="v" sid="PRO 30:24" />“पृथ्वीमा चार वटा कुराहरू साना छन्,</para>
  <para style="li2" vid="PRO 30:24">तापनि तिनीहरू अति बुद्धिमान् छन्:<verse eid="PRO 30:24" /></para>
  <para style="li2">
    <verse number="25" style="v" sid="PRO 30:25" />कमिलाहरू, जो थोरै बल भएका प्राणी हुन्,</para>
  <para style="li3" vid="PRO 30:25">तापनि तिनीहरूले ग्रीष्म ऋतुमा नै आफ्नो भोजनको सञ्चय गर्छन्,<verse eid="PRO 30:25" /></para>
  <para style="li2">
    <verse number="26" style="v" sid="PRO 30:26" />भिर खरायोहरू थोरै बल भएका प्राणी हुन्,</para>
  <para style="li3" vid="PRO 30:26">तापनि तिनीहरूले आफ्ना घर पहराहरूमा नै बनाउँछन्,<verse eid="PRO 30:26" /></para>
  <para style="li2">
    <verse number="27" style="v" sid="PRO 30:27" />सलहहरूका राजा हुँदैनन्,</para>
  <para style="li3" vid="PRO 30:27">तापनि तिनीहरू लहरै हुल बाँधेर अगि बढ्छन्।<verse eid="PRO 30:27" /></para>
  <para style="li2">
    <verse number="28" style="v" sid="PRO 30:28" />माउसुली, जसलाई हातले समात्न सक्छौँ,</para>
  <para style="li3" vid="PRO 30:28">तापनि त्यो राजाको महलहरूमा पाइन्छ।<verse eid="PRO 30:28" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="29" style="v" sid="PRO 30:29" />“तीन वटा कुरा छन्, जसका हिँडाइ रवाफिला छन्;</para>
  <para style="li2" vid="PRO 30:29">चार वटा कुरा छन्, जो शानसँग यताउता हिँड्छन्:<verse eid="PRO 30:29" /></para>
  <para style="li3">
    <verse number="30" style="v" sid="PRO 30:30" />सिंह, जो पशुहरूमध्ये बलवान् हुन्छ, जो कसैदेखि पछि हट्दैन,<verse eid="PRO 30:30" /></para>
  <para style="li3">
    <verse number="31" style="v" sid="PRO 30:31" />रवाफसित हिँड्ने भाले,</para>
  <para style="li3" vid="PRO 30:31">बोको;</para>
  <para style="li3" vid="PRO 30:31">अनि आफ्नो वरिपरि सेना राखेर हिँड्ने राजा।<verse eid="PRO 30:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 30:32" />“तिमी मूर्ख भएर आफूलाई उच्‍च पार्‍यौ भने,</para>
  <para style="q2" vid="PRO 30:32">अथवा तिमीले दुष्‍ट युक्ति रच्यौ भने,</para>
  <para style="q2" vid="PRO 30:32">तिम्रो मुखमाथि हात राख!<verse eid="PRO 30:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 30:33" />किनकि दूध मन्थन गरेर घिउ निस्केजस्तै,</para>
  <para style="q2" vid="PRO 30:33">र नाक बटार्दा रगत निस्केजस्तै,</para>
  <para style="q2" vid="PRO 30:33">रिसलाई चलाउँदा झगडा उत्पन्‍न हुन्छ।”<verse eid="PRO 30:33" /></para>
  <chapter eid="PRO 30" />
  <chapter number="31" style="c" sid="PRO 31" />
  <para style="ms1">राजा लमूएलका भनाइहरू</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 31:1" />राजा लमूएलका नीतिवचन, जुन तिनका आमाले तिनलाई सिकाएकी थिइन्—एक ईश्‍वरवाणी।<verse eid="PRO 31:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 31:2" />हे मेरा छोरा, सुन्! हे मेरा गर्भका छोरा, सुन्!</para>
  <para style="q2" vid="PRO 31:2">हे मेरो छोरा, प्रार्थनाहरूका जवाफ सुन्!<verse eid="PRO 31:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 31:3" />तेरो आफ्नो सम्पूर्ण बल<note caller="+" style="f"><char style="fr" closed="false">31:3 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">सम्पत्ति</char></note> स्त्रीहरूलाई दिएर नसक्;</para>
  <para style="q2" vid="PRO 31:3">तेरो शक्ति तिनीहरूलाई नदे, जसले राजाहरूलाई पतन गराउँछन्।<verse eid="PRO 31:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PRO 31:4" />यो कुरा राजाहरूका निम्ति होइन, हे लमूएल—</para>
  <para style="q2" vid="PRO 31:4">राजाहरूले मद्यपान गर्नुहुन्‍न,</para>
  <para style="q2" vid="PRO 31:4">शासकहरूले मदिराको लालसा गर्नुहुन्‍न,<verse eid="PRO 31:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 31:5" />कतै तिनीहरूले पिएर कानुनलाई बेवास्ता गर्लान्,</para>
  <para style="q2" vid="PRO 31:5">र थिचोमिचोमा परेकाहरूलाई तिनीहरूका अधिकारबाट वञ्चित गर्लान्।<verse eid="PRO 31:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 31:6" />तिनीहरूलाई मदिरा दे, जो नष्‍ट भइरहेका छन्; तिनीहरूलाई मद्यपान दे,</para>
  <para style="q2" vid="PRO 31:6">जो वेदनामा परेका छन्।<verse eid="PRO 31:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 31:7" />तिनीहरूले पिऊन् र आफ्नो गरिबी बिर्सून्,</para>
  <para style="q2" vid="PRO 31:7">अनि आफ्ना वेदना कहिल्यै नसम्झून्।<verse eid="PRO 31:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PRO 31:8" />आफ्ना निम्ति बोल्न नसक्नेहरूका निम्ति,</para>
  <para style="q2" vid="PRO 31:8">र दुःख पाएकाहरूका अधिकारको निम्ति बोलिदे।<verse eid="PRO 31:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 31:9" />आवाज उठा, र ठिकसित न्याय गर्,</para>
  <para style="q2" vid="PRO 31:9">गरिब र खाँचोमा परेकाहरूको अधिकारको रक्षा गर्!<verse eid="PRO 31:9" /></para>
  <para style="ms1">उपसंहार: असल चरित्र भएकी पत्नी</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 31:10" />
    <note caller="+" style="f">
      <char style="fr" closed="false">31:10 </char>
      <char style="ft" closed="false">
        <char style="xt" link-href="PRO 31:10‑31">
          <ref loc="PRO 31:10">10‑31</ref>
        </char> पदहरू एकरोस्टिक कविता हुन्, जसका पदहरू हिब्रू वर्णमालाका क्रमिक अक्षरहरूबाट सुरु हुन्छ।</char>
    </note> असल चरित्र भएकी पत्नी कसले पाउन सक्छ?</para>
  <para style="q2" vid="PRO 31:10">तिनी त माणिकहरूभन्दा बहुमूल्यकी हुन्छिन्।<verse eid="PRO 31:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 31:11" />तिनका पतिले तिनीमाथि पूर्ण भरोसा गर्छिन्;</para>
  <para style="q2" vid="PRO 31:11">र तिनलाई कुनै मूल्यवान् कुराको अभाव हुँदैन।<verse eid="PRO 31:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 31:12" />तिनले आफ्नो जीवनकालभरि नै खराब कुरा होइन,</para>
  <para style="q2" vid="PRO 31:12">तर असल कुरा दिन्छिन्।<verse eid="PRO 31:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 31:13" />तिनले ऊन र सनपाट चुन्छिन्,</para>
  <para style="q2" vid="PRO 31:13">र इच्छुक हातले काम गर्छिन्।<verse eid="PRO 31:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 31:14" />व्यापारीका जहाजहरूले जस्तै;</para>
  <para style="q2" vid="PRO 31:14">तिनले टाढाबाट भोजन ल्याउँछिन्।<verse eid="PRO 31:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 31:15" />मिरमिरे बिहान नहुँदै तिनी उठ्छिन्,</para>
  <para style="q2" vid="PRO 31:15">आफ्नो परिवारको निम्ति भोजन जुटाउँछिन्,</para>
  <para style="q2" vid="PRO 31:15">र आफ्नी सेविकाहरूलाई आ-आफ्नो भाग बाँडिदिन्छिन्।<verse eid="PRO 31:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 31:16" />तिनले विचार गरेर एउटा जमिन किन्छिन्,</para>
  <para style="q2" vid="PRO 31:16">र आफ्नो कमाईबाट एउटा दाखबारी लगाउँछिन्।<verse eid="PRO 31:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 31:17" />तिनले आफ्नो काम जोसका साथ गर्छिन्;</para>
  <para style="q2" vid="PRO 31:17">आफ्नो कामको निम्ति तिनले आफ्ना पाखुराहरू बलियो पार्छिन्।<verse eid="PRO 31:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 31:18" />तिनले आफ्नो कारोबारबाट लाभ भएको छ भनी देख्छिन्;</para>
  <para style="q2" vid="PRO 31:18">र राति तिनको बत्ती निभ्दैन।<verse eid="PRO 31:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 31:19" />तिनले आफ्नो हातले चर्खा चलाउँछिन्,</para>
  <para style="q2" vid="PRO 31:19">र आफ्नो औँलाले पिउरी समाउँछिन्।<verse eid="PRO 31:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 31:20" />तिनले गरिबका निम्ति आफ्नो मुट्ठी खोल्छिन्;</para>
  <para style="q2" vid="PRO 31:20">र खाँचोमा परेकाहरूको निम्ति सहायताको हात बढाउँछिन्।<verse eid="PRO 31:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 31:21" />हिउँ पर्दा आफ्नो परिवारको निम्ति तिनी डराउँदिनन्;</para>
  <para style="q2" vid="PRO 31:21">किनकि तिनीहरू सबैले सिन्दूरे रङ्गको वस्त्र पहिरेका हुन्छन्।<verse eid="PRO 31:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 31:22" />तिनी आफैँले ओछ्यान ढाक्ने तन्‍ना बनाउँछिन्;</para>
  <para style="q2" vid="PRO 31:22">तिनले असल सुती र बैजनी वस्त्र लगाएकी हुन्छिन्।<verse eid="PRO 31:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 31:23" />उनका पतिलाई सहरको मूलढोकामा आदर गरिन्छ,</para>
  <para style="q2" vid="PRO 31:23">जहाँ उनी देशका अगुवाहरूका बीचमा बस्छन्।<verse eid="PRO 31:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 31:24" />तिनले सुती कपडाका वस्त्रहरू बनाउँछिन् र ती बिक्री गर्छिन्;</para>
  <para style="q2" vid="PRO 31:24">र व्यापारीलाई पटुकाहरू उपलब्ध गराउँछिन्।<verse eid="PRO 31:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 31:25" />तिनी सामर्थ्य र सम्मानले सुशोभित हुन्छिन्;</para>
  <para style="q2" vid="PRO 31:25">भविष्यको निम्ति तिनी मुस्कुराउन सक्छिन्।<verse eid="PRO 31:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 31:26" />तिनी बुद्धिसित बोल्छिन्;</para>
  <para style="q2" vid="PRO 31:26">अनि तिनको जिब्रोमा विश्‍वासयोग्य अर्ती पाइन्छ।<verse eid="PRO 31:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 31:27" />तिनले आफ्नो घरानाको कामधन्धाको हेरविचार गर्छिन्,</para>
  <para style="q2" vid="PRO 31:27">र आलस्यपनको रोटी खाँदिनन्।<verse eid="PRO 31:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 31:28" />तिनका छोराछोरीले उठेर तिनलाई धन्यकी भन्छन्,</para>
  <para style="q2" vid="PRO 31:28">तिनका पतिले पनि यस्तो भन्दै तिनको प्रशंसा गर्छन्:<verse eid="PRO 31:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 31:29" />“धेरै स्त्रीहरूले असल काम गर्छन्;</para>
  <para style="q2" vid="PRO 31:29">तर तिनीहरू सबैलाई तिमीले जितेकी छौ।”<verse eid="PRO 31:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 31:30" />सौन्दर्य भ्रमात्मक हुन्छ, र सुन्दरता उडिजाने हुन्छ;</para>
  <para style="q2" vid="PRO 31:30">तर याहवेहको डर मान्‍ने स्त्रीको नै प्रशंसा हुनुपर्छ।<verse eid="PRO 31:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 31:31" />तिनले कमाएको इनाम तिनलाई नै देऊ;</para>
  <para style="q2" vid="PRO 31:31">र तिनका कामले सहरको ढोकामा नै तिनलाई प्रशंसा ल्याऊन्।<verse eid="PRO 31:31" /></para>
  <chapter eid="PRO 31" />
</usx>