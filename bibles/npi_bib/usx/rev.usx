<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="REV" style="id">- Biblica® Open Nepali Contemporary Version</book>
  
  <para style="h">प्रकाश</para>
  <para style="toc1">यूहन्‍नालाई भएको प्रकाश</para>
  <para style="toc2">प्रकाश</para>
  <para style="toc3">प्रका</para>
  <para style="mt1">यूहन्‍नालाई भएको प्रकाश</para>
  <chapter number="1" style="c" sid="REV 1" />
  <para style="s1">प्रस्तावना</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 1:1" />येशू ख्रीष्‍टको प्रकाश, जो परमेश्‍वरले चाँडै हुन आउने कुराहरू आफ्ना सेवकहरूलाई देखाउन उहाँलाई दिनुभयो। उहाँले आफ्ना दूत पठाएर यो आफ्नो सेवक यूहन्‍नालाई प्रकट गर्नुभयो; <verse eid="REV 1:1" /><verse number="2" style="v" sid="REV 1:2" />तिनैले परमेश्‍वरको वचनको लागि र येशू ख्रीष्‍टको गवाहीको लागि आफूले देखेका सबै थोकहरूको विवरण दिए। <verse eid="REV 1:2" /><verse number="3" style="v" sid="REV 1:3" />जसले यस अगमवाणीका वचनहरू ठूलो सोरमा पढेर सुनाउँछ, त्यो धन्यको हो; अनि यसलाई सुन्‍नेहरू र यसमा लेखिएका कुराहरू पालन गर्नेहरू धन्यका हुन्; किनकि समय नजिकै छ।<verse eid="REV 1:3" /></para>
  <para style="b" />
  <para style="s1">अभिवादन र स्तुति-प्रशंसा</para>
  <para style="po">
    <verse number="4" style="v" sid="REV 1:4" />यूहन्‍नाबाट,</para>
  <para style="po" vid="REV 1:4">एशिया<note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="ft" closed="false">एशियाको </char><char style="fqa" closed="false">प्रान्त </char><char style="ft" closed="false">वा </char><char style="fqa" closed="false">राज्य </char><char style="ft" closed="false">प्राचीन रोमी साम्राज्यका केही सहरहरू मिलेर बनेको थियो, जुन हाल आधुनिक टर्कीको पश्‍चिमी भागमा अवस्थित थियो।</char></note> प्रान्तमा भएका सात वटा मण्डलीहरूलाई यो पत्र लेख्दैछु:</para>
  <para style="po" vid="REV 1:4">उहाँबाट तिमीहरूमा अनुग्रह र शान्ति, जो हुनुहुन्छ, जो हुनुहुन्थ्यो, र जो हुनआउनुहुनेछ, र उहाँको सिंहासनको अगि भएका सात आत्माहरूबाट; <verse eid="REV 1:4" /><verse number="5" style="v" sid="REV 1:5" />अनि येशू ख्रीष्‍टबाट, जो विश्‍वसनीय साक्षी, मृतकहरूमध्ये पहिले जीवित हुनुभएका<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="fq" closed="false">जीवित हुनुभएका </char><char style="ft" closed="false">मूल भाषामा </char><char style="fqa" closed="false">जन्मनु</char></note> र पृथ्वीका राजाहरूका शासक हुनुहुन्छ।</para>
  <para style="b" vid="REV 1:5" />
  <para style="p" vid="REV 1:5">उहाँले हामीलाई प्रेम गर्नुहुन्छ, र उहाँले नै आफ्नो रगतले हाम्रा पापहरूबाट हामीलाई स्वतन्त्र पार्नुभयो; <verse eid="REV 1:5" /><verse number="6" style="v" sid="REV 1:6" />अनि उहाँका परमेश्‍वर र पितालाई सेवा गर्नलाई हामीलाई एउटा राज्य र पुजारी बनाउनुभयो; उहाँलाई नै महिमा र पराक्रम सदासर्वदा भइरहोस्! आमेन।<verse eid="REV 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="REV 1:7" />“हेर, उहाँ बादलहरूका साथमा आउँदैहुनुहुन्छ”;<note caller="+" style="f"><char style="fr" closed="false">1:7 </char><char style="ft" closed="false"><char style="xt"><ref loc="DAN 7:13">दानि 7:13</ref></char></char></note></para>
  <para style="q2" vid="REV 1:7">अनि “हरेक आँखाले उहाँलाई देख्नेछ,</para>
  <para style="q1" vid="REV 1:7">तिनीहरूले पनि, जसले उहाँलाई घोचेका थिए”</para>
  <para style="q2" vid="REV 1:7">अनि पृथ्वीका सबै जातिहरूले “उहाँको कारण विलाप गर्नेछन्।”<note caller="+" style="f"><char style="fr" closed="false">1:7 </char><char style="ft" closed="false"><char style="xt"><ref loc="ZEC 12:10">जक 12:10</ref></char></char></note></para>
  <para style="qc" vid="REV 1:7">यस्तै होस्! आमेन।<verse eid="REV 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 1:8" />सर्वशक्तिमान् परमप्रभु परमेश्‍वर भन्‍नुहुन्छ, “म नै अल्फा र ओमेगा<note caller="+" style="f"><char style="fr" closed="false">1:8 </char><char style="ft" closed="false">यी ग्रीक भाषाका पहिलो र अन्तिम अक्षर हुन्, जसको अर्थ </char><char style="fqa" closed="false">सुरु र अन्त्य </char><char style="ft" closed="false">हुन्छ।</char></note> हुँ” जो हुनुहुन्छ, जो हुनुहुन्थ्यो र जो हुनआउनुहुनेछ।<verse eid="REV 1:8" /></para>
  <para style="b" />
  <para style="s1">ख्रीष्‍टको बारेमा यूहन्‍नाको दर्शन</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 1:9" />म यूहन्‍ना, तिमीहरूका भाइ, येशूमा भएका हाम्रा कष्‍टमा, राज्यमा र धीरजपूर्वक लागिपर्ने सहकर्मी हुँ; परमेश्‍वरको वचन र येशूको गवाहीको कारण म पत्मोस टापुमा थिएँ। <verse eid="REV 1:9" /><verse number="10" style="v" sid="REV 1:10" />प्रभुको दिनमा म आत्मामा थिएँ, र मेरो पछिल्तिर मैले तुरहीको जस्तै एउटा चर्को आवाज सुनेँ, <verse eid="REV 1:10" /><verse number="11" style="v" sid="REV 1:11" />जसले यसो भन्यो: “तिमी जे देख्छौ, त्यो एउटा पुस्तकमा लेख, र त्यसलाई सातै वटा मण्डलीहरू अर्थात्, एफिसस, स्मुर्ना, पर्गामम, थिआटीरा, सार्डिस, फिलाडेल्फिया र लाउडिकियामा पठाऊ।”<verse eid="REV 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 1:12" />अनि मसित बोल्नेलाई हेरूँ भनेर म फर्केँ। जब म पछिल्तिर फर्केँ, तब मैले सुनका सात वटा सामदानहरू देखेँ; <verse eid="REV 1:12" /><verse number="13" style="v" sid="REV 1:13" />अनि सामदानहरूका बीचमा पाउसम्मै पुग्ने लामो पोशाक र छातीमा सुनौलो चौडा पेटी लाउनुभएको “मानिसको पुत्रजस्तै,”<note caller="+" style="f" category="dup"><char style="fr" closed="false">1:13 </char><char style="ft" closed="false"><char style="xt"><ref loc="DAN 7:13">दानि 7:13</ref></char></char></note> एक जनालाई देखेँ। <verse eid="REV 1:13" /><verse number="14" style="v" sid="REV 1:14" />उहाँको शिरको कपाल ऊनजस्ता सेता, हिउँजस्तै सेता, र उहाँका आँखाहरू आगोका ज्वालाजस्ता बलेका थिए। <verse eid="REV 1:14" /><verse number="15" style="v" sid="REV 1:15" />उहाँका पाउहरू आगोका भट्टीमा खारेर टल्काएका काँसाजस्तै चम्केका थिए, र उहाँको सोरचाहिँ बेगसित उर्लेको पानीको आवाजजस्तो थियो। <verse eid="REV 1:15" /><verse number="16" style="v" sid="REV 1:16" />अनि उहाँको दाहिने हातले सात वटा ताराहरू पक्रिराखेको थियो; अनि उहाँको मुखबाट एउटा धारिलो दुईधारे तरवार निस्केको थियो। उहाँको अनुहारचाहिँ पूरा तेजसित चम्केको सूर्यझैँ थियो।<verse eid="REV 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 1:17" />जब मैले उहाँलाई देखेँ, तब म मरेतुल्य भएर उहाँको पाउमा परेँ। तब उहाँले आफ्नो दाहिने हात ममाथि राखेर भन्‍नुभयो: “नडराऊ, आदि र अन्त्य म नै हुँ। <verse eid="REV 1:17" /><verse number="18" style="v" sid="REV 1:18" />जीवितचाहिँ म नै हुँ; म मरेको थिएँ, र हेर, म सदासर्वदाको लागि जीवित छु! अनि मसित मृत्यु र पातालका साँचाहरू छन्।<verse eid="REV 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 1:19" />“यसकारण तिमीले जे देखेका छौ, अहिले जे छ, र यसपछि के हुनेछ, सो लेख। <verse eid="REV 1:19" /><verse number="20" style="v" sid="REV 1:20" />तिमीले मेरो दाहिने हातमा देखेका सात वटा ताराहरू र सात वटा सुनका सामदानहरूको रहस्य यो हो: सात वटा ताराहरू सात मण्डलीका दूतहरू<note caller="+" style="f"><char style="fr" closed="false">1:20 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">सन्देश वाहकहरू</char></note> हुन्, र सात वटा सामदानहरू सात मण्डलीहरू हुन्।”<verse eid="REV 1:20" /></para>
  <chapter eid="REV 1" />
  <chapter number="2" style="c" sid="REV 2" />
  <para style="s1">एफिससमा भएको मण्डलीलाई सन्देश</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 2:1" />“एफिससमा भएको मण्डलीका दूतलाई लेख:</para>
  <para style="b" vid="REV 2:1" />
  <para style="pi1" vid="REV 2:1">यी उहाँका वचनहरू हुन्, जसले आफ्नो दाहिने हातमा सात वटा ताराहरू पक्रेर राख्नुभएको छ; अनि जो सात वटा सुनका सामदानहरूका बीचमा हिँड्नुहुन्छ।<verse eid="REV 2:1" /></para>
  <para style="b" />
  <para style="pi1">
    <verse number="2" style="v" sid="REV 2:2" />मलाई तिम्रा कामहरू, तिम्रो कठोर परिश्रम र लगनशीलता थाहा छ। मलाई यो पनि थाहा छ, तिमीले दुष्‍ट मानिसहरूलाई सहन सक्दैनौ; अनि जो प्रेरित होइनन्, तर प्रेरित हौँ भन्‍नेहरूलाई तिमीले जाँच्यौ, र तिनीहरू झूटा हुन् भनी पत्ता लगायौ। <verse eid="REV 2:2" /><verse number="3" style="v" sid="REV 2:3" />तिमीले लगनशील भएर मेरो नामको निम्ति दुःख सहेका छौ, तैपनि त्यागेका छैनौ।<verse eid="REV 2:3" /></para>
  <para style="pi1">
    <verse number="4" style="v" sid="REV 2:4" />तर तिम्रो विरुद्धमा मेरो यो गुनासो छ: तिमीले तिम्रो पहिलो प्रेम त्यागेका छौ। <verse eid="REV 2:4" /><verse number="5" style="v" sid="REV 2:5" />तिमी कहाँबाट खसेका छौ, सो स्मरण गर! पश्‍चात्ताप गर र तिमीले पहिले गरेका कामहरू गर। यदि तिमीले पश्‍चात्ताप गरेनौ भने म तिमीकहाँ आएर तिम्रो सामदान त्यसको ठाउँबाट हटाइदिनेछु। <verse eid="REV 2:5" /><verse number="6" style="v" sid="REV 2:6" />तर तिमीसँग एउटा राम्रो पक्ष छ: तिमीले निकोलाइटसहरूका कामहरूलाई घृणा गर्दछौ, जसलाई म पनि घृणा गर्दछु।<verse eid="REV 2:6" /></para>
  <para style="pi1">
    <verse number="7" style="v" sid="REV 2:7" />जसको कान छ, त्यसले सुनोस्, पवित्र आत्माले मण्डलीहरूलाई के भन्‍नुहुन्छ। जसले विजय हासिल गर्दछ, त्यसलाई म जीवनको त्यो रूखबाट खान दिनेछु, जुन परमेश्‍वरको स्वर्गलोकमा छ।<verse eid="REV 2:7" /></para>
  <para style="s1">स्मुर्नामा भएको मण्डलीलाई सन्देश</para>
  <para style="p">
    <verse number="8" style="v" sid="REV 2:8" />“स्मुर्नामा भएको मण्डलीका दूतलाई लेख:</para>
  <para style="b" vid="REV 2:8" />
  <para style="pi1" vid="REV 2:8">यी उहाँका वचनहरू हुन्, जो आदि र अन्त्य हुनुहुन्छ, जो मर्नुभएको थियो, र अहिले जीवित हुनुभएको छ।<verse eid="REV 2:8" /></para>
  <para style="b" />
  <para style="pi1">
    <verse number="9" style="v" sid="REV 2:9" />मलाई तिमीहरूको पीडा र गरिबी थाहा छ; तरै पनि तिमीहरू त धनी छौ! मलाई तिनीहरूले गरेको निन्दा थाहा छ, जो आफैँलाई यहूदीहरू हौँ भनी भन्छन्, तर होइनन्, तिनीहरू त शैतानका सभा हुन्। <verse eid="REV 2:9" /><verse number="10" style="v" sid="REV 2:10" />तिमीहरूले भोग्न लागेका कष्‍टहरूसित नडराओ। म तिमीहरूलाई भन्दछु, शैतानले तिमीहरूमध्ये कतिलाई जाँच्नलाई कैदमा लैजानेछ; अनि तिमीहरूले दश दिनसम्म सतावट भोग्नेछौ। मृत्युसम्मै विश्‍वासी होओ, र म तिमीहरूलाई जीवनको मुकुट दिनेछु।<verse eid="REV 2:10" /></para>
  <para style="pi1">
    <verse number="11" style="v" sid="REV 2:11" />जसको कान छ, त्यसले सुनोस्; पवित्र आत्माले मण्डलीहरूलाई के भन्‍नुहुन्छ। जसले जित्छ, त्यसलाई दोस्रो मृत्युले कुनै किसिमले हानि गर्नेछैन।<verse eid="REV 2:11" /></para>
  <para style="s1">पर्गामममा भएको मण्डलीलाई सन्देश</para>
  <para style="p">
    <verse number="12" style="v" sid="REV 2:12" />“पर्गामममा भएको मण्डलीका दूतलाई लेख:</para>
  <para style="b" vid="REV 2:12" />
  <para style="pi1" vid="REV 2:12">यी उहाँका वचनहरू हुन्, जससित धारिलो दुईधारे तरवार छ।<verse eid="REV 2:12" /></para>
  <para style="b" />
  <para style="pi1">
    <verse number="13" style="v" sid="REV 2:13" />म जान्दछु तिमी कहाँ बस्छौ, त्यहीँ नै जहाँ शैतानको आफ्नो सिंहासन छ। तरै पनि तिमी मेरो नामको निम्ति विश्‍वासयोग्य भइरह्‍यौ। तिमीले म प्रतिको तिम्रो विश्‍वासलाई शैतान बस्‍ने तिमीहरूका सहरमा मारिएका मेरा विश्‍वासयोग्य साक्षी एन्टिपासको समयमा पनि त्यागेनौ।<verse eid="REV 2:13" /></para>
  <para style="pi1">
    <verse number="14" style="v" sid="REV 2:14" />तैपनि तिम्रो विरुद्धमा मसित केही कुराहरू छन्: तिमीहरूमध्ये कोही यस्ता छन्, जसले बालामका शिक्षा मान्दछन्, जसले बालाकद्वारा इस्राएलीहरूलाई पाप गर्न उक्साए, जसले गर्दा तिनीहरूले मूर्तिहरूलाई चढाएको भोजन खाए, र व्यभिचार गरे। <verse eid="REV 2:14" /><verse number="15" style="v" sid="REV 2:15" />यसरी नै तिमीसँग निकोलाइटसको शिक्षा पालन गर्नेहरू पनि छन्। <verse eid="REV 2:15" /><verse number="16" style="v" sid="REV 2:16" />यसकारण पश्‍चात्ताप गर! नत्रता म चाँडै तिमीकहाँ आएर मेरो मुखको तरवारले तिनीहरूको विरुद्धमा लडाइँ गर्नेछु।<verse eid="REV 2:16" /></para>
  <para style="pi1">
    <verse number="17" style="v" sid="REV 2:17" />जसको कान छ, त्यसले सुनोस्, पवित्र आत्माले मण्डलीहरूलाई के भन्‍नुहुन्छ। जसले विजय हासिल गर्दछ, त्यसलाई म लुकाइराखेको मन्‍न दिनेछु। म त्यसलाई नयाँ नाम लेखिएको एउटा सेतो पत्थर पनि दिनेछु, जसलाई पाउनेले मात्र जान्‍नेछ।<verse eid="REV 2:17" /></para>
  <para style="s1">थिआटीरामा भएको मण्डलीलाई सन्देश</para>
  <para style="p">
    <verse number="18" style="v" sid="REV 2:18" />“थिआटीरामा भएको मण्डलीका दूतलाई लेख:</para>
  <para style="b" vid="REV 2:18" />
  <para style="pi1" vid="REV 2:18">यी परमेश्‍वरका पुत्रका वचनहरू हुन्, जसका आँखा आगोका ज्वालाझैँ, र जसका पाउहरू टल्काइराखेको काँसझैँ छन्।<verse eid="REV 2:18" /></para>
  <para style="b" />
  <para style="pi1">
    <verse number="19" style="v" sid="REV 2:19" />तिम्रा कामहरू, तिम्रो प्रेम र विश्‍वास, तिम्रो सेवा र लगनशीलता; अनि मलाई यो पनि थाहा छ, कि तिमीले पहिलेभन्दा अहिले बढी काम गर्दैछौ।<verse eid="REV 2:19" /></para>
  <para style="pi1">
    <verse number="20" style="v" sid="REV 2:20" />तैपनि तिम्रो विरुद्धमा मेरो यो गुनासो छ: तिमीले त्यस स्त्री ईजेबेललाई सहन्छौ, जसले आफूलाई अगमवादिनी हुँ भनी भन्दछे। आफ्ना शिक्षाहरूद्वारा त्यसले मेरा सेवकहरूलाई व्यभिचार गर्न र मूर्तिहरूलाई चढाएका भोजनहरू खान भनी गलत मार्गतिर डोर्‍याउँछे। <verse eid="REV 2:20" /><verse number="21" style="v" sid="REV 2:21" />मैले त्यसलाई आफ्नो यौन अनैतिकताबाट पश्‍चात्ताप गर्ने समय दिएँ, तर त्यसले पश्‍चात्ताप गर्नै चाहिन। <verse eid="REV 2:21" /><verse number="22" style="v" sid="REV 2:22" />यसकारण म त्यसलाई कष्‍टको ओछ्यानमा थला पारिदिनेछु, र त्यससित व्यभिचार गर्नेहरूले त्यसको मार्गदेखि पश्‍चात्ताप गरेनन् भने तिनीहरूलाई महा कष्‍ट दिनेछु। <verse eid="REV 2:22" /><verse number="23" style="v" sid="REV 2:23" />म त्यसका छोराछोरीहरूलाई मृत्युद्वारा नाश पारिदिनेछु। तब सबै मण्डलीहरूले जान्‍नेछन्, कि हृदय र मनको खोजी गर्ने म नै हुँ; अनि मैले नै तिमीहरू हरेकलाई आफ्ना कामअनुसारको प्रतिफल दिनेछु।<verse eid="REV 2:23" /></para>
  <para style="pi1">
    <verse number="24" style="v" sid="REV 2:24" />अब थिआटीरामा भएका बाँकीलाई म भन्दछु, तिमीहरू जसले त्यसको शिक्षा ग्रहण गरेका छैनौ, र शैतानका गहिरा भेदहरू सिकेका छैनौ, ‘म तिमीहरूमाथि अब अरू कुनै भार थप्दिनँ, <verse eid="REV 2:24" /><verse number="25" style="v" sid="REV 2:25" />तिमीहरूसित जे छ, म नआउन्जेल बलियो गरी पक्रिराख। म तिमीहरूलाई योभन्दा अरू दुःख दिन्‍नँ।’<verse eid="REV 2:25" /></para>
  <para style="pi1">
    <verse number="26" style="v" sid="REV 2:26" />त्यसकारण जसले विजय हासिल गर्दछ, र अन्त्यसम्म मेरो इच्छा पालन गर्दछ, जसरी मैले मेरा पिताबाट अधिकार पाएको छु, म त्यसलाई राष्ट्रहरूमाथि अधिकार दिनेछु। <verse eid="REV 2:26" /><verse number="27" style="v" sid="REV 2:27" />अनि ‘त्यसले तिनीहरूमाथि फलामको राजदण्डले शासन गर्नेछ; त्यसले तिनीहरूलाई माटाको भाँडा फुटाएझैँ फुटाउनेछ।’<note caller="+" style="f"><char style="fr" closed="false">2:27 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 2:9">भजन 2:9</ref></char></char></note> <verse eid="REV 2:27" /><verse number="28" style="v" sid="REV 2:28" />जसरी मैले मेरा पिताबाट अधिकार पाएको छु, म त्यसलाई बिहानको तारा पनि दिनेछु। <verse eid="REV 2:28" /><verse number="29" style="v" sid="REV 2:29" />जसको कान छ, त्यसले सुनोस्, पवित्र आत्माले मण्डलीहरूलाई के भन्‍नुहुन्छ।<verse eid="REV 2:29" /></para>
  <chapter eid="REV 2" />
  <chapter number="3" style="c" sid="REV 3" />
  <para style="s1">सार्डिसमा भएको मण्डलीलाई सन्देश</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 3:1" />“सार्डिसमा भएको मण्डलीका दूतलाई लेख:</para>
  <para style="b" vid="REV 3:1" />
  <para style="pi1" vid="REV 3:1">यी उहाँका वचनहरू हुन्, जसले परमेश्‍वरका सात आत्माहरू र सात ताराहरू पक्रनुभएको छ।</para>
  <para style="b" vid="REV 3:1" />
  <para style="pi1" vid="REV 3:1">मलाई तिम्रो काम थाहा छ; तिमी जीवित भनेर कहलिएका छौ, तर तिमी मरेका छौ। <verse eid="REV 3:1" /><verse number="2" style="v" sid="REV 3:2" />जागा होऊ, र मर्नै लागेका बाँकी कुराहरूलाई बलियो बनाओ; किनकि मैले मेरा परमेश्‍वरको सामु तिम्रा कामहरू अधुरो पाएको छु। <verse eid="REV 3:2" /><verse number="3" style="v" sid="REV 3:3" />यसकारण तिमीले जे पाएका र सुनेका छौ, त्यो स्मरण गर; त्यसलाई पालन गर र पश्‍चात्ताप गर। तर तिमी जागेनौ भने म चोरझैँ आउनेछु, र म तिमीकहाँ कुन बेला आउनेछु, सो तिमीले थाहा पाउनेछैनौ।<verse eid="REV 3:3" /></para>
  <para style="pi1">
    <verse number="4" style="v" sid="REV 3:4" />तैपनि सार्डिसमा केही यस्ता मानिसहरू छन्, जसले आफ्ना वस्त्रहरू बिटुलो पारेका छैनन्। तिनीहरू मसित सेता वस्त्रहरू पहिरेर हिँड्नेछन्; किनकि तिनीहरू योग्यका छन्। <verse eid="REV 3:4" /><verse number="5" style="v" sid="REV 3:5" />जसले विजय हासिल गर्दछ, उसलाई तिनीहरूलाई झैँ, सेतो वस्त्र पहिराइनेछ। म तिनीहरूका नाम जीवनको पुस्तकबाट कहिल्यै मेट्नेछैनँ, तर मेरा पिता र उहाँका दूतहरूको अगि स्वीकार गर्नेछु। <verse eid="REV 3:5" /><verse number="6" style="v" sid="REV 3:6" />जसको कान छ, त्यसले सुनोस्, पवित्र आत्माले मण्डलीहरूलाई के भन्‍नुहुन्छ।<verse eid="REV 3:6" /></para>
  <para style="s1">फिलाडेल्फियामा भएको मण्डलीलाई सन्देश</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 3:7" />“फिलाडेल्फियामा भएको मण्डलीका दूतलाई लेख:</para>
  <para style="b" vid="REV 3:7" />
  <para style="pi1" vid="REV 3:7">यी उहाँका वचनहरू हुन्, जो पवित्र र सत्य हुनुहुन्छ, जससित दावीदको साँचो छ। उहाँले जे खोल्नुहुन्छ, त्यो कसैले बन्द गर्न सक्दैन र उहाँले जे बन्द गर्नुहुन्छ, त्यो कसैले खोल्न सक्दैन।<verse eid="REV 3:7" /></para>
  <para style="b" />
  <para style="pi1">
    <verse number="8" style="v" sid="REV 3:8" />मलाई तिम्रा कामहरू थाहा छ। हेर, मैले तिम्रो अगाडि एउटा खुला ढोका राखेको छु, जसलाई कसैले बन्द गर्न सक्दैन। तिमीसित थोरै शक्ति छ भन्‍ने मलाई थाहा छ, तापनि तिमीले मेरा वचन पालन गरेका छौ र मेरो नामलाई इन्कार गरेका छैनौ। <verse eid="REV 3:8" /><verse number="9" style="v" sid="REV 3:9" />म शैतानका ती सभाघरकाहरूलाई, जो यहूदीहरू होइनन्, तर आफूलाई यहूदीहरू हौँ भनेर झूट बोल्छन्, म तिमीहरूको पाउमा दण्डवत् गर्न, र मैले तिमीलाई प्रेम गरेको छु भनेर स्वीकार गर्न लगाउनेछु। <verse eid="REV 3:9" /><verse number="10" style="v" sid="REV 3:10" />तिमीले धैर्यसाथ सहेर मेरा आज्ञापालन गरेको हुनाले, म पनि तिमीलाई त्यस परीक्षाको समयबाट बचाउनेछु, जुन संसारका सबै बासिन्दाहरूको परीक्षा लिन सारा पृथ्वीमाथि आउँदैछ।<verse eid="REV 3:10" /></para>
  <para style="pi1">
    <verse number="11" style="v" sid="REV 3:11" />हेर, म चाँडै आउनेछु। तिमीहरूसित जे छ, त्यसलाई पक्रिराख, ताकि तिम्रो मुकुट कसैले लैजान नपाओस्। <verse eid="REV 3:11" /><verse number="12" style="v" sid="REV 3:12" />जसले विजय हासिल गर्दछ, म मेरा पिताको मन्दिरमा एउटा खाँबो बनाउनेछु। उसले यसलाई कहिल्यै छोड्नेछैन। म उसमाथि मेरा परमेश्‍वरको नाम, मेरा परमेश्‍वरको स्वर्गबाट आइरहेको नयाँ सहर यरूशलेमको नाम लेखिदिनेछु; अनि म उसमाथि मेरो नयाँ नाम पनि लेखिदिनेछु। <verse eid="REV 3:12" /><verse number="13" style="v" sid="REV 3:13" />जसको कान छ, त्यसले सुनोस्, पवित्र आत्माले मण्डलीहरूलाई के भन्‍नुहुन्छ।<verse eid="REV 3:13" /></para>
  <para style="s1">लाउडिकियामा भएको मण्डलीलाई सन्देश</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 3:14" />“लाउडिकियामा भएको मण्डलीका दूतलाई लेख:</para>
  <para style="b" vid="REV 3:14" />
  <para style="pi1" vid="REV 3:14">यी वचनहरू आमेनका हुन्, जो विश्‍वासयोग्य अनि सत्य साक्षी, र परमेश्‍वरको सृष्‍टिका शासक हुनुहुन्छ।<verse eid="REV 3:14" /></para>
  <para style="b" />
  <para style="pi1">
    <verse number="15" style="v" sid="REV 3:15" />मलाई तिम्रा कामहरू थाहा छ, तिमी न चिसा न त ताता छौ। तिमी चिसो अथवा ताता भएका भए त हुनेथियो। <verse eid="REV 3:15" /><verse number="16" style="v" sid="REV 3:16" />यसकारण तिमी न तातो, न त चिसो, मनतातो भएकोले म तिमीलाई मेरो मुखबाट उकेल्न आँटेको छु। <verse eid="REV 3:16" /><verse number="17" style="v" sid="REV 3:17" />तिमी भन्छौ, ‘म धनी छु; मैले धेरै धनसम्पत्ति कमाएको छु, र मलाई कुनै थोकको खाँचो छैन।’ तर तिमीले यो थाहा गरेका छैनौ, कि तिमी गएगुज्रेको, दयनीय, गरिब, दृष्‍टिविहीन र नाङ्गा छौ। <verse eid="REV 3:17" /><verse number="18" style="v" sid="REV 3:18" />म तिमीलाई सल्‍लाह दिन्छु, मबाट आगोमा खारेको सुन किन; अनि धनी बन, र आफ्नो लाजमर्दो नग्नता ढाक्नलाई सेतो वस्त्र किन, र लगाऊ; अनि आँखामा लगाउने गाजल किन, ताकि तिमीले देख्न सक।<verse eid="REV 3:18" /></para>
  <para style="pi1">
    <verse number="19" style="v" sid="REV 3:19" />जसलाई म प्रेम गर्छु, तिनीहरूलाई म हप्काउँछु, र अनुशासनमा राख्छु। यसकारण उत्साहित होओ र पश्‍चात्ताप गर। <verse eid="REV 3:19" /><verse number="20" style="v" sid="REV 3:20" />म यहाँ छु! म ढोकामा उभिएर घचघच्याउँछु। यदि कसैले मेरो आवाज सुन्छ र ढोका खोल्छ भने म त्यसकहाँ भित्र आउनेछु; अनि त्यससित भोजन खानेछु, र त्यसले मसित खानेछ।<verse eid="REV 3:20" /></para>
  <para style="pi1">
    <verse number="21" style="v" sid="REV 3:21" />जसले विजय हासिल गर्दछ, म उसलाई मसित मेरो सिंहासनमा बस्‍ने अधिकार दिनेछु, जसरी मैले पनि जितेँ, र मेरो पिताको सिंहासनमा बसेको छु। <verse eid="REV 3:21" /><verse number="22" style="v" sid="REV 3:22" />जसको कान छ, त्यसले सुनोस्, पवित्र आत्माले मण्डलीहरूलाई के भन्‍नुहुन्छ।”<verse eid="REV 3:22" /></para>
  <chapter eid="REV 3" />
  <chapter number="4" style="c" sid="REV 4" />
  <para style="s1">स्वर्गमा भएको सिंहासन</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 4:1" />त्यसपछि मैले देखेँ, स्वर्गमा एउटा खुला ढोका थियो। मैले पहिले सुनेको सोर तुरहीको आवाजमा मसँग यसरी बोलिरहेको थियो, “यहाँ माथि आऊ, र यसपछि के हुनुपर्छ, सो म तिमीलाई देखाउनेछु।” <verse eid="REV 4:1" /><verse number="2" style="v" sid="REV 4:2" />म तुरुन्तै आत्मामा भएँ; अनि स्वर्गमा मेरो सामु कोही बसिरहनुभएको एउटा सिंहासन थियो। <verse eid="REV 4:2" /><verse number="3" style="v" sid="REV 4:3" />अनि त्यहाँ विराजमान हुनुहुनेको मुहार बिल्‍लौर र लालमणिझैँ देखिन्थ्यो। त्यहाँ पन्‍नाजस्तै चम्केको इन्द्रेणीले सिंहासनलाई घेरिराखेको थियो। <verse eid="REV 4:3" /><verse number="4" style="v" sid="REV 4:4" />त्यस सिंहासनका वरिपरि चौबीस वटा अरू सिंहासनहरू थिए; अनि यसमाथि सेता वस्त्र लगाएका र शिरमा सुनका मुकुट लगाएका चौबीसजना प्रधानहरू बसेका थिए। <verse eid="REV 4:4" /><verse number="5" style="v" sid="REV 4:5" />सिंहासनबाट बिजुलीको चमक, गड्याङ-गुडुङ र मेघ गर्जनको आवाज निस्किरहेको थियो। सिंहासनको सामु सात वटा बत्तीहरू बलिरहेका थिए, जुन परमेश्‍वरका सात आत्माहरू हुन्। <verse eid="REV 4:5" /><verse number="6" style="v" sid="REV 4:6" />सिंहासनको अगाडि स्फटिकझैँ पारदर्शी काँचको समुद्रजस्तो थियो।</para>
  <para style="p" vid="REV 4:6">सिंहासनको बीचमा चारैतिर चार वटा जीवित प्राणीहरू थिए, र तिनीहरूका अगाडि र पछाडि आँखाहरूले ढाकिएका थिए। <verse eid="REV 4:6" /><verse number="7" style="v" sid="REV 4:7" />पहिलो जीवित प्राणी सिंहजस्तै, दोस्रो गोरुजस्तै, तेस्रोको अनुहार मानिसको जस्तै, चौथोचाहिँ उडिरहेको गरुडजस्तै थियो। <verse eid="REV 4:7" /><verse number="8" style="v" sid="REV 4:8" />प्रत्येक जीवित प्राणीका छ वटा पखेटाहरू थिए; अनि ती चारैतिर, पखेटा भित्रपट्टि पनि आँखाहरूले ढाकिएका थिए। रातदिन तिनीहरूले नरोकीकन यसो भनिरहन्थे:</para>
  <para style="qc" vid="REV 4:8">“पवित्र, पवित्र, पवित्र,</para>
  <para style="qc" vid="REV 4:8">सर्वशक्तिमान् प्रभु परमेश्‍वर,</para>
  <para style="qc" vid="REV 4:8">जो हुनुहुन्थ्यो, जो हुनुहुन्छ, र जो हुनआउनुहुनेछ।”<note caller="+" style="f"><char style="fr" closed="false">4:8 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 6:3">यशै 6:3</ref></char></char></note><verse eid="REV 4:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="REV 4:9" />सिंहासनमा बस्‍नुहुने, र सदासर्वदा जिउनुहुनेलाई जब जीवित प्राणीहरूले महिमा, आदर र धन्यवाद चढाउँछन्, <verse eid="REV 4:9" /><verse number="10" style="v" sid="REV 4:10" />तब ती चौबीसजना प्रधानहरू सिंहासनमाथि बस्‍नुहुने अनि सदासर्वदा जिउनुहुनेको सामु घोप्टो पर्छन्, र दण्डवत् गर्छन्। तिनीहरूले आ-आफ्ना मुकुटहरू सिंहासनको सामु राखेर यसो भन्छन्:<verse eid="REV 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="REV 4:11" />“हाम्रा प्रभु र परमेश्‍वर,</para>
  <para style="q2" vid="REV 4:11">तपाईं महिमा, आदर र शक्ति ग्रहण गर्ने योग्यका हुनुहुन्छ;</para>
  <para style="q1" vid="REV 4:11">किनकि तपाईंले सबै थोक सृष्‍टि गर्नुभयो;</para>
  <para style="q2" vid="REV 4:11">अनि तपाईंको इच्छाद्वारा नै ती सृष्‍टि गरिए;</para>
  <para style="q2" vid="REV 4:11">अनि ती अस्तित्वमा आए।”<verse eid="REV 4:11" /></para>
  <chapter eid="REV 4" />
  <chapter number="5" style="c" sid="REV 5" />
  <para style="s1">चर्मपत्र र थुमा</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 5:1" />त्यसपछि मैले सिंहासनमा बस्‍नुहुनेको दाहिने हातमा एउटा चर्मपत्र देखेँ, जसको दुवैतिर लेखिएको थियो; र सात वटा मोहरहरूले बन्द गरिएको थियो। <verse eid="REV 5:1" /><verse number="2" style="v" sid="REV 5:2" />अनि मैले एउटा बलवान् स्वर्गदूतलाई देखेँ, जसले चर्को सोरले यसरी घोषणा गर्दैथिए, “यी मोहरहरू तोडेर चर्मपत्र खोल्ने योग्यको को छ?” <verse eid="REV 5:2" /><verse number="3" style="v" sid="REV 5:3" />तर स्वर्गमा अथवा पृथ्वीमा वा पृथ्वीमुनि भएका कसैले पनि त्यस चर्मपत्रलाई खोल्न र पढ्न सकेनन्। <verse eid="REV 5:3" /><verse number="4" style="v" sid="REV 5:4" />म रोइरहेँ किनकि त्यस चर्मपत्र खोल्ने र पढ्ने योग्यको कोही पनि पाइएन। <verse eid="REV 5:4" /><verse number="5" style="v" sid="REV 5:5" />तब धर्मगुरुहरूमध्ये एक जनाले मलाई भने, “नरोऊ! हेर, यहूदाको कुलको सिंह, दावीदको सिंहासनको उत्तराधिकारी<note caller="+" style="f"><char style="fr" closed="false">5:5 </char><char style="ft" closed="false">मूल भाषामा </char><char style="fqa" closed="false">दावीदको मूल</char></note> यो चर्मपत्र र यी सात वटा मोहरहरू खोल्न विजयी हुनुभएको छ।”<verse eid="REV 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 5:6" />तब मैले मारिनुभएको थुमाजस्तो कसैलाई सिंहासनको बीचमा उभिरहनुभएको देखेँ, जसको चारैतिर चार वटा जीवित प्राणीहरू र धर्मगुरुहरू थिए। थुमाका सात वटा सिङहरू अनि सात वटा आँखाहरू थिए; जुनचाहिँ संसारभरि पठाइएका परमेश्‍वरका सात आत्माहरू हुन्। <verse eid="REV 5:6" /><verse number="7" style="v" sid="REV 5:7" />थुमाले सिंहासनमा बस्‍नुहुनेको दाहिने हातबाट त्यो चर्मपत्र लिनुभयो। <verse eid="REV 5:7" /><verse number="8" style="v" sid="REV 5:8" />अनि जब त्यो लिनुभयो, तब ती चार वटा जीवित प्राणीहरू र चौबीसजना प्रधानहरू त्यस थुमाको सामु घोप्टो परे। प्रत्येकसित एउटा वीणा थियो, र तिनीहरूले धूपले भरिएका सुनका धुपौराहरू पक्रेका थिए, जुन सन्तहरूका प्रार्थना हुन्। <verse eid="REV 5:8" /><verse number="9" style="v" sid="REV 5:9" />अनि तिनीहरूले एउटा नयाँ गीत गाए:</para>
  <para style="q1" vid="REV 5:9">“तपाईं यो चर्मपत्र लिने</para>
  <para style="q2" vid="REV 5:9">र त्यसका छापहरू खोल्ने योग्यको हुनुहुन्छ;</para>
  <para style="q1" vid="REV 5:9">किनकि तपाईं मारिनुभएको थियो;</para>
  <para style="q2" vid="REV 5:9">अनि तपाईंको रगतद्वारा तपाईंले मानिसहरूलाई</para>
  <para style="q2" vid="REV 5:9">प्रत्येक कुल र भाषाबाट जातिहरूलाई</para>
  <para style="q2" vid="REV 5:9">र राष्ट्रहरूलाई परमेश्‍वरको निम्ति किन्‍नुभयो।<verse eid="REV 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="REV 5:10" />तपाईंले तिनीहरूलाई हाम्रा परमेश्‍वरको सेवा गर्नलाई</para>
  <para style="q2" vid="REV 5:10">राज्य र पुजारीहरू बनाउनुभयो;</para>
  <para style="q2" vid="REV 5:10">अनि तिनीहरूले संसारमा राज्य गर्नेछन्।”<verse eid="REV 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 5:11" />तब मैले दर्शनमा सिंहासन, जीवित प्राणीहरू र प्रधानहरूका वरिपरि असंख्य स्वर्गदूतहरूका सोर सुनेँ। तिनीहरूको संख्या लाखौँ र करोडौँ थियो। <verse eid="REV 5:11" /><verse number="12" style="v" sid="REV 5:12" />चर्को सोरमा तिनीहरूले यो गीत गाए:</para>
  <para style="q1" vid="REV 5:12">“मारिनुभएको थुमा,</para>
  <para style="q2" vid="REV 5:12">शक्ति, वैभव, बुद्धि, बल, आदर,</para>
  <para style="q2" vid="REV 5:12">महिमा र प्रशंसा पाउन योग्यका हुनुहुन्छ!”<verse eid="REV 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 5:13" />तब मैले स्वर्गमा, पृथ्वीमाथि, पृथ्वीमुनि र समुद्रमा भएका समस्त प्राणीहरूले यो गीत गाइरहेका सुनेँ:</para>
  <para style="q1" vid="REV 5:13">“सिंहासनमा विराजमान हुनुहुनेलाई र थुमालाई</para>
  <para style="q2" vid="REV 5:13">प्रशंसा, आदर, महिमा र शक्ति</para>
  <para style="qc" vid="REV 5:13">सदासर्वदा भइरहोस्!”<verse eid="REV 5:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="REV 5:14" />चार जीवित प्राणीहरूले भने, “आमेन,” अनि प्रधानहरूले घोप्टो परेर उहाँलाई आराधना गरे।<verse eid="REV 5:14" /></para>
  <chapter eid="REV 5" />
  <chapter number="6" style="c" sid="REV 6" />
  <para style="s1">छापहरू</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 6:1" />थुमाले सात वटा छापहरूमध्ये पहिलो छाप खोल्नुभएको मैले देखेँ। तब ती चार जीवित प्राणीहरूमध्ये एउटाले गर्जनझैँ आवाजमा यसो भनिरहेको सुनेँ, “आऊ!” <verse eid="REV 6:1" /><verse number="2" style="v" sid="REV 6:2" />अनि त्यहाँ मैले मेरो सामु एउटा सेतो घोडा देखेँ! त्यसमाथि सवारले एउटा धनु समातेको थियो, र उसलाई एउटा मुकुट दिइयो; अनि ऊ विजय गर्ने उद्देश्यले विजयीझैँ निस्क्यो।<verse eid="REV 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 6:3" />जब थुमाले दोस्रो छाप खोल्नुभयो, तब मैले दोस्रो जीवित प्राणीले यसो भनिरहेको सुनेँ, “आऊ!” <verse eid="REV 6:3" /><verse number="4" style="v" sid="REV 6:4" />अनि अर्को उज्ज्वल रातो घोडा आयो। उसलाई एउटा ठूलो तरवार दिइयो। त्यसको सवारलाई संसारदेखि शान्ति उठाइलैजाने र मानिसहरूले एक-अर्कालाई मारून् भन्‍ने अख्तियार दिइयो।<verse eid="REV 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 6:5" />जब थुमाले तेस्रो छाप खोल्नुभयो, तब मैले तेस्रो जीवित प्राणीले यसो भनिरहेको सुनेँ, “आऊ!” मैले हेरेँ, र मेरो सामु एउटा कालो घोडा थियो! त्यसको सवारको हातमा एउटा तराजु थियो। <verse eid="REV 6:5" /><verse number="6" style="v" sid="REV 6:6" />तब ती चार जीवित प्राणीहरूमध्ये एउटा आवाजले यसो भनिरहेको मैले सुनेँ, “एक दिनको ज्याला<note caller="+" style="f"><char style="fr" closed="false">6:6 </char><char style="ft" closed="false">मूल भाषामा </char><char style="fqa" closed="false">एक दिनार</char></note> एक किलो गहुँ र एक दिनको ज्याला, तीन किलो जौ; तेल र दाखमद्यलाई हानि नगर्नू!”<verse eid="REV 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 6:7" />जब थुमाले चौथो छाप खोल्नुभयो, मैले चौथो जीवित प्राणीले यसो भनिरहेको सोर सुनेँ, “आऊ!” <verse eid="REV 6:7" /><verse number="8" style="v" sid="REV 6:8" />मैले हेरेँ, मेरो सामु एउटा हल्का हरियो रङ्गको घोडा थियो! त्यसको सवारलाई मृत्यु भन्‍ने नाम दिइएको थियो, र पातालचाहिँ त्यसको पछि-पछि लागेको थियो। तिनीहरूलाई संसारको चौथाइ भागलाई तरवारले, कालले, रूढीले र संसारका जङ्गली जन्तुहरूले मार्ने शक्ति दिइएको थियो।<verse eid="REV 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 6:9" />जब थुमाले पाँचौँ छाप खोल्नुभयो, तब मैले वेदीको मुनि तिनीहरूका आत्माहरूलाई देखेँ, जो परमेश्‍वरको वचनको कारण र आफ्नो साक्षी कायम राखेको कारण मारिएका थिए। <verse eid="REV 6:9" /><verse number="10" style="v" sid="REV 6:10" />तिनीहरूले जोडसित यसो भने, “हे सार्वभौम, पवित्र र सत्य प्रभु, तपाईंले कहिलेसम्म संसारका बासिन्दाहरूमाथि न्याय गरेर हाम्रा रगतको बदला लिनुहुन्‍न र?” <verse eid="REV 6:10" /><verse number="11" style="v" sid="REV 6:11" />तब ती प्रत्येकलाई पाउसम्म लामो सेतो वस्त्र दिइयो; अनि तिनीहरूका सङ्गी-सेवकहरू र दाजुभाइ-दिदीबहिनीहरू पनि तिनीहरूझैँ मारिएर संख्यामा पूरा नभएसम्म केही समय पर्खिनू भनी तिनीहरूलाई भनियो।<verse eid="REV 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 6:12" />थुमाले छैटौँ छाप खोल्नुभएको मैले हेरेँ। तब एउटा ठूलो भुइँचालो गयो। सूर्यचाहिँ बाख्राको रौँले बनिएको भाङ्ग्राझैँ कालो भयो; अनि सम्पूर्ण चन्द्रमा रगतजस्तो रातो भयो; <verse eid="REV 6:12" /><verse number="13" style="v" sid="REV 6:13" />अनि आकाशका ताराहरूचाहिँ नपाकेका अञ्जीरहरू हावाले हल्‍लाइँदा झरेझैँ पृथ्वीमा झरे। <verse eid="REV 6:13" /><verse number="14" style="v" sid="REV 6:14" />आकाशचाहिँ पत्रको मुठाझैँ बेह्रिएर गयो; अनि प्रत्येक पहाड र टापुचाहिँ आफ्नो ठाउँबाट हटिगए।<verse eid="REV 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 6:15" />तब संसारका राजाहरू, राजकुमारहरू, सेनापतिहरू, धनीहरू, पराक्रमीहरू, प्रत्येक सेवक र स्वतन्त्र व्यक्ति, ओडार, चट्टान र पहाडहुँदो लुके। <verse eid="REV 6:15" /><verse number="16" style="v" sid="REV 6:16" />तिनीहरूले पहाड र चट्टानहरूलाई भने, “हामीमाथि खस र हामीलाई सिंहासनमाथि बस्‍नुहुनेको अनुहारदेखि र थुमाको क्रोधदेखि लुकाइदेओ!<note caller="+" style="f"><char style="fr" closed="false">6:16 </char><char style="ft" closed="false"><char style="xt"><ref loc="HOS 10:8">होशे 10:8</ref></char></char></note> <verse eid="REV 6:16" /><verse number="17" style="v" sid="REV 6:17" />किनकि उहाँहरूको<note caller="+" style="f"><char style="fr" closed="false">6:17 </char><char style="ft" closed="false">केही प्राचीन पा.लि.हरूमा </char><char style="fqa" closed="false">उहाँको</char></note> क्रोधको महा दिन आइपुगेको छ, र यसको सामना कसले गर्न सक्ला र?”<verse eid="REV 6:17" /></para>
  <chapter eid="REV 6" />
  <chapter number="7" style="c" sid="REV 7" />
  <para style="s1">1,44,000 लाई छाप लगाइएको</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 7:1" />यसपछि मैले चार जना स्वर्गदूतहरूलाई पृथ्वीको चार कुनामा उभिरहेका देखेँ, जसले जमिनमा, समुद्रमा अथवा कुनै रूखमा कतैबाट पनि बतास नचलोस् भनेर रोक्नलाई पृथ्वीका चारै वटा बतासलाई रोकिराखेका थिए। <verse eid="REV 7:1" /><verse number="2" style="v" sid="REV 7:2" />तब मैले जीवित परमेश्‍वरको छाप लिएर अर्को स्वर्गदूतलाई पूर्वबाट उक्लिरहेको देखेँ। उनले जमिन र समुद्रलाई हानि गर्ने अख्तियार पाएका चार जना स्वर्गदूतहरूलाई जोडसित भने, <verse eid="REV 7:2" /><verse number="3" style="v" sid="REV 7:3" />“जबसम्म हामीले परमेश्‍वरका सेवकहरूका निधारहरूमा छाप लगाइसक्दैनौँ, तबसम्म जमिन, समुद्र अथवा रूखहरूलाई हानि नगर्नू।” <verse eid="REV 7:3" /><verse number="4" style="v" sid="REV 7:4" />तब मैले छाप पाएकाहरूको संख्या सुनेँ, अर्थात् तिनीहरू इस्राएलका सबै कुलहरूबाट 1,44,000 थिए।<verse eid="REV 7:4" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="5" style="v" sid="REV 7:5" />यहूदाको कुलबाट 12,000 लाई छाप लगाइयो।</para>
  <para style="li1" vid="REV 7:5">रूबेनको कुलबाट 12,000 लाई,</para>
  <para style="li1" vid="REV 7:5">गादको कुलबाट 12,000 लाई,<verse eid="REV 7:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="REV 7:6" />आशेरको कुलबाट 12,000 लाई,</para>
  <para style="li1" vid="REV 7:6">नप्‍तालीको कुलबाट 12,000 लाई,</para>
  <para style="li1" vid="REV 7:6">मनश्शेको कुलबाट 12,000 लाई,<verse eid="REV 7:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="REV 7:7" />शिमियोनको कुलबाट 12,000 लाई,</para>
  <para style="li1" vid="REV 7:7">लेवीको कुलबाट 12,000 लाई,</para>
  <para style="li1" vid="REV 7:7">इस्साखारको कुलबाट 12,000 लाई,<verse eid="REV 7:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="REV 7:8" />जबूलूनको कुलबाट 12,000 लाई,</para>
  <para style="li1" vid="REV 7:8">योसेफको कुलबाट 12,000 लाई,</para>
  <para style="li1" vid="REV 7:8">बेन्यामीनको कुलबाट 12,000 लाई छाप लगाइयो।<verse eid="REV 7:8" /></para>
  <para style="s1">सेतो वस्त्र लगाएका ठूलो भीड</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 7:9" />त्यसपछि मैले प्रत्येक राष्ट्र, कुल, जाति र भाषाबाट कसैले गन्‍न नसक्ने एउटा ठूलो भीडलाई सिंहासनको र थुमाको सामु उभिरहेका देखेँ। तिनीहरूले पाउसम्मै लामो सेतो वस्त्र पहिरेका र हातमा खजूरका हाँगाहरू लिएका थिए। <verse eid="REV 7:9" /><verse number="10" style="v" sid="REV 7:10" />तिनीहरू चर्को सोरमा कराए:</para>
  <para style="q1" vid="REV 7:10">“सिंहासनमा विराजमान हुनुहुने,</para>
  <para style="q1" vid="REV 7:10">हाम्रा परमेश्‍वर र थुमामा मुक्ति छ।”<verse eid="REV 7:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="REV 7:11" />सबै स्वर्गदूतहरू सिंहासन, प्रधानहरू र चार वटा जीवित प्राणीहरूका वरिपरि उभिरहेका थिए। तिनीहरू सिंहासनको सामु घोप्टो परे, र यसो भन्दै परमेश्‍वरलाई आराधना गरे,<verse eid="REV 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="REV 7:12" />“आमेन!</para>
  <para style="q1" vid="REV 7:12">हाम्रा परमेश्‍वरलाई प्रशंसा,</para>
  <para style="q1" vid="REV 7:12">महिमा, बुद्धि, धन्यवाद,</para>
  <para style="q1" vid="REV 7:12">आदर, शक्ति र बल</para>
  <para style="q1" vid="REV 7:12">सदासर्वदा भइरहोस्।</para>
  <para style="q1" vid="REV 7:12">आमेन!”<verse eid="REV 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 7:13" />तब प्रधानहरूमध्ये एक जनाले मलाई सोधे, “यी सेता वस्त्र पहिरनेहरू को हुन् र कहाँबाट आएका हुन्?”<verse eid="REV 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 7:14" />तब मैले उत्तर दिएँ, “हजुर, तपाईं नै जान्‍नुहुन्छ।”</para>
  <para style="p" vid="REV 7:14">अनि तिनले भने, “यी तिनीहरू हुन्, जो महासङ्कष्‍टबाट निस्केर आएका छन्; तिनीहरूले आफ्ना वस्त्रहरू थुमाको रगतमा धोएर सेता बनाएका छन्। <verse eid="REV 7:14" /><verse number="15" style="v" sid="REV 7:15" />यसकारण,</para>
  <para style="q1" vid="REV 7:15">“तिनीहरू परमेश्‍वरको सिंहासनको सामु छन्;</para>
  <para style="q2" vid="REV 7:15">अनि तिनीहरू उहाँको मन्दिरमा दिनरात उहाँको सेवा गर्छन्;</para>
  <para style="q1" vid="REV 7:15">अनि सिंहासनमा बस्‍नुहुनेले</para>
  <para style="q2" vid="REV 7:15">आफ्नो उपस्थितिले तिनीहरूलाई शरण दिनुहुनेछ।<verse eid="REV 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="REV 7:16" />‘तिनीहरू फेरि कहिल्यै भोकाउने छैनन्;</para>
  <para style="q2" vid="REV 7:16">तिनीहरू फेरि कहिल्यै तिर्खाउनेछैनन्।</para>
  <para style="q1" vid="REV 7:16">तिनीहरूलाई सूर्यको प्रचण्ड तापले पोल्नेछैन।’<note caller="+" style="f"><char style="fr" closed="false">7:16 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 49:10">यशै 49:10</ref></char></char></note><verse eid="REV 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="REV 7:17" />किनकि सिंहासनको बीचमा हुनुहुने थुमा</para>
  <para style="q2" vid="REV 7:17">तिनीहरूका गोठाला हुनुहुनेछ;</para>
  <para style="q1" vid="REV 7:17">‘उहाँले तिनीहरूलाई जिउँदो पानीको स्रोतसम्म डोर्‍याउनुहुनेछ।’<note caller="+" style="f" category="dup"><char style="fr" closed="false">7:17 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 49:10">यशै 49:10</ref></char></char></note></para>
  <para style="q2" vid="REV 7:17">‘अनि परमेश्‍वर आफैँले तिनीहरूका आँखाहरूबाट सबै आँसुहरू पुछिदिनुहुनेछ।’<note caller="+" style="f"><char style="fr" closed="false">7:17 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 25:8">यशै 25:8</ref></char></char></note>”<verse eid="REV 7:17" /></para>
  <chapter eid="REV 7" />
  <chapter number="8" style="c" sid="REV 8" />
  <para style="s1">सातौँ मोहर र सुनको धुपौरो</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 8:1" />जब थुमाले सातौँ मोहर खोल्नुभयो, तब स्वर्गमा प्रायः आधा घण्टासम्म सन्‍नाटा छायो।<verse eid="REV 8:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 8:2" />अनि मैले परमेश्‍वरको सामु सात जना स्वर्गदूतहरूलाई उभिएको देखेँ; अनि तिनीहरूलाई सात वटा तुरहीहरू दिइयो।<verse eid="REV 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 8:3" />अर्का स्वर्गदूत, जससँग एउटा सुनको धुपौरो थियो, वेदीनिर आएर उभिए। तिनलाई सबै सन्तहरूको प्रार्थनासित सिंहासनको सामु भएको सुनको वेदीमा चढाउनलाई धेरै धूप दिइयो। <verse eid="REV 8:3" /><verse number="4" style="v" sid="REV 8:4" />स्वर्गदूतको हातबाट धूपको धुवाँ सन्तहरूका प्रार्थनासँगसँगै उँभो उठ्दै परमेश्‍वरको उपस्थितिमा गयो। <verse eid="REV 8:4" /><verse number="5" style="v" sid="REV 8:5" />तब ती स्वर्गदूतले धुपौरो लिएर त्यसमा वेदीको आगो भरे, र त्यसलाई पृथ्वीमाथि फ्याँकिदिए; अनि मेघ गर्जन, गड्याङ-गुडुङको आवाज, बिजुलीको चमक उत्पन्‍न भयो, र भुइँचालो गयो।<verse eid="REV 8:5" /></para>
  <para style="s1">तुरहीहरू</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 8:6" />तब सात वटा तुरहीहरू भएका ती सात स्वर्गदूतहरू तुरही फुक्न तयार भए।<verse eid="REV 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 8:7" />जब पहिलो स्वर्गदूतले आफ्नो तुरही फुके, तब त्यहाँ रगतमा मिसिएका असिना र आगो उत्पन्‍न भए, र पृथ्वीमाथि वर्षिए। पृथ्वीको एक तिहाइ भाग, रूखहरूको एक तिहाइ भाग र सबै हरिया घाँसहरू जलेर भस्म भयो।<verse eid="REV 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 8:8" />जब दोस्रो स्वर्गदूतले आफ्नो तुरही फुके, तब बल्दैगरेको एउटा ठूलो पहाडजस्तै कुनै वस्तु समुद्रमा फालियो; अनि समुद्रको एक तिहाइ भाग रगतमा परिणत भयो। <verse eid="REV 8:8" /><verse number="9" style="v" sid="REV 8:9" />समुद्रमा भएका जीवित प्राणीहरूको एक तिहाइ भाग मरे; अनि जहाजहरूको एक तिहाइ भाग नष्‍ट भयो।<verse eid="REV 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 8:10" />जब तेस्रो स्वर्गदूतले आफ्नो तुरही फुके, तब राँकोझैँ जलिरहेको एउटा ठूलो तारा आकाशबाट नदीहरूको एक तिहाइ भागमाथि र पानीका मुहानहरूमाथि खस्यो; <verse eid="REV 8:10" /><verse number="11" style="v" sid="REV 8:11" />त्यस ताराको नाम तितो<note caller="+" style="f"><char style="fr" closed="false">8:11 </char><char style="fq" closed="false">तितो </char><char style="ft" closed="false">मूल भाषामा </char><char style="fqa" closed="false">अप्सिन्थोस</char></note> हो। पानीको तेस्रो भाग तितो भयो, र तितो पानीका कारण धेरै मानिसहरू मरे।<verse eid="REV 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 8:12" />जब चौथो स्वर्गदूतले आफ्नो तुरही फुके, तब सूर्यको एक तिहाइ भागमाथि र चन्द्रमाको एक तिहाइ भागमाथि अनि ताराहरूको एक तिहाइ भागमाथि प्रहार भयो; जसद्वारा तिनीहरूको एक तिहाइ भाग अँध्यारो भयो। दिनको एक तिहाइ भाग र रातको एक तिहाइ भाग पनि ज्योतिविहीन भयो।<verse eid="REV 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 8:13" />जसरी मैले ध्यानसित हेरिरहेको थिएँ, आकाशको बीचमा उडिरहेको एउटा गरुडले चर्को सोरमा यसो भनिरहेको सुनेँ: “अरू तीन स्वर्गदूतहरूले फुक्न लागेका तुरहीका आवाजहरूको कारण पृथ्वीवासीहरूलाई आतङ्क! आतङ्क! आतङ्क!”<verse eid="REV 8:13" /></para>
  <chapter eid="REV 8" />
  <chapter number="9" style="c" sid="REV 9" />
  <para style="p">
    <verse number="1" style="v" sid="REV 9:1" />जब पाँचौँ स्वर्गदूतले आफ्नो तुरही फुके, तब मैले आकाशबाट पृथ्वीमा खसेको एउटा तारालाई देखेँ। तिनलाई अतल कुण्डको साँचो दिइएको थियो। <verse eid="REV 9:1" /><verse number="2" style="v" sid="REV 9:2" />तिनले जब त्यस कुण्डलाई खोले, तब त्यहाँबाट विशाल भट्टीबाटझैँ धुवाँ निस्क्यो। त्यस कुण्डबाट निस्केको धुवाँद्वारा सूर्य र आकाश अँध्यारो भए। <verse eid="REV 9:2" /><verse number="3" style="v" sid="REV 9:3" />अनि त्यस धुवाँबाट सलहहरू निस्के, र पृथ्वीमा आए; अनि पृथ्वीमा भएका बिच्छीहरूको झैँ तिनीहरूलाई शक्ति दिइयो। <verse eid="REV 9:3" /><verse number="4" style="v" sid="REV 9:4" />ती सलहहरूलाई पृथ्वीका घाँसहरू अथवा कुनै बोटबिरुवा अथवा रूखहरूलाई हानि नगर्नू, तर जुन मानिसहरूका निधारमा परमेश्‍वरको छाप छैन, तिनीहरूलाई मात्र हानि गर्नू भनियो। <verse eid="REV 9:4" /><verse number="5" style="v" sid="REV 9:5" />तिनीहरूलाई मार्ने अख्तियार दिइएन, तर पाँच महिनासम्म यातना दिनू भनियो। अनि बिच्छीले डस्दा जस्तो पीडा हुन्छ, त्यो त्यस्तै थियो। <verse eid="REV 9:5" /><verse number="6" style="v" sid="REV 9:6" />ती दिनहरूमा मानिसहरूले मृत्यु खोज्नेछन्, तर भेट्टाउनेछैनन्; तिनीहरू मर्ने इच्छा गर्नेछन्, तर मृत्यु तिनीहरूदेखि भाग्नेछ।<verse eid="REV 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 9:7" />ती सलहहरू लडाइँका निम्ति तयार गरिएका घोडाहरूजस्तै थिए। तिनीहरूले आफ्ना टाउकामा सुनका मुकुटहरूझैँ केही लगाएका थिए। अनि तिनीहरूका अनुहार मानिसहरूका जस्ता थिए। <verse eid="REV 9:7" /><verse number="8" style="v" sid="REV 9:8" />तिनीहरूका केश स्त्रीहरूका केशजस्तै थिए, र तिनीहरूका दाँत सिंहहरूका दाँतजस्ता थिए। <verse eid="REV 9:8" /><verse number="9" style="v" sid="REV 9:9" />तिनीहरूका छातीका कवचहरू फलामकाझैँ थिए; अनि तिनीहरूका पखेटाहरूका आवाज लडाइँ गर्न दगुरिरहेका धेरै घोडाहरू र रथहरूको गडगडाहटझैँ थियो। <verse eid="REV 9:9" /><verse number="10" style="v" sid="REV 9:10" />तिनीहरूका पुच्छरहरूमा बिच्छीहरूका जस्तै खीलहरू थिए, र तिनीहरूका पुच्छरहरूमा मानिसहरूलाई पाँच महिनासम्म यातना दिने शक्ति थियो। <verse eid="REV 9:10" /><verse number="11" style="v" sid="REV 9:11" />तिनीहरूका राजाका रूपमा अतल कुण्डको दूत थियो, जसको नाम हिब्रू भाषामा अबाडोन, ग्रीक भाषामा अपोल्‍लियोन<note caller="+" style="f"><char style="fr" closed="false">9:11 </char><char style="ft" closed="false">यो शब्दको अर्थ </char><char style="fqa" closed="false">विनाशकर्ता </char><char style="ft" closed="false">हुन्छ।</char></note> हो।<verse eid="REV 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 9:12" />पहिलो आतङ्क बितेर गयो; तर हेर, यसपछि अरू दुई आतङ्कहरू आउन बाँकी नै छन्!<verse eid="REV 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 9:13" />जब छैटौँ स्वर्गदूतले आफ्नो तुरही फुके, तब मैले परमेश्‍वरको सामु भएको सुनको वेदीका चार वटा सिङहरूबाट आएको आवाज सुनेँ। <verse eid="REV 9:13" /><verse number="14" style="v" sid="REV 9:14" />त्यो आवाजले तुरही बोकेका छैटौँ स्वर्गदूतलाई यसो भन्यो, “त्यस ठूलो नदी यूफ्रेटिसमा बाँधिराखेका चार जना स्वर्गदूतहरूलाई फुकाइदेऊ।” <verse eid="REV 9:14" /><verse number="15" style="v" sid="REV 9:15" />अनि मानिसहरूको एक तिहाइ भागलाई मारून् भनेर त्यस घडी, त्यस दिन, त्यस महिना र त्यस वर्षको निम्ति तयार पारिराखेका ती चार जना स्वर्गदूतहरूलाई छोडियो। <verse eid="REV 9:15" /><verse number="16" style="v" sid="REV 9:16" />मैले ती घोडसवार फौजको संख्या बीस करोड थियो भनेर सुनेँ।<verse eid="REV 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 9:17" />मैले मेरो दर्शनमा देखेका घोडाहरू र सवारहरू यस्ता थिए: तिनीहरूका छातीका कवचहरू आगोझैँ राता, गाढा, निला र गन्धकझैँ पहेँला थिए। ती घोडाहरूका शिर सिंहहरूका शिरझैँ थिए; तिनीहरूका मुखबाट आगो, धुवाँ र गन्धक निस्कन्थ्यो। <verse eid="REV 9:17" /><verse number="18" style="v" sid="REV 9:18" />तिनीहरूका मुखबाट निस्केका आगो, धुवाँ र गन्धकको तीन वटा रूढीहरूद्वारा मानिसहरूका एक तिहाइ भाग मारिए। <verse eid="REV 9:18" /><verse number="19" style="v" sid="REV 9:19" />ती घोडाहरूको शक्ति तिनीहरूका मुखमा र पुच्छरहरूमा थिए; किनकि तिनीहरूका पुच्छरहरू सर्पजस्ता थिए, जसमा टाउको पनि भएकाले चोट पुर्‍याउँथे।<verse eid="REV 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 9:20" />ती रूढीहरूले नमरेका बाँकी मानिस जातिले तिनीहरूका हातले गरेका दुष्‍ट कामहरूबाट अझ पनि पश्‍चात्ताप गरेनन्; तिनीहरूले देख्न नसक्ने, सुन्‍न नसक्ने र हिँड्न नसक्ने, भूतप्रेतहरू र सुन, चाँदी, काँसा, ढुङ्गा र काठका मूर्तिहरू पुज्न छाडेनन्। <verse eid="REV 9:20" /><verse number="21" style="v" sid="REV 9:21" />तिनीहरू आफूले गरेका हत्या, टुनामुना, अनैतिक यौन सम्बन्ध, र चोरीको लागि पश्‍चात्ताप गरेनन्।<verse eid="REV 9:21" /></para>
  <chapter eid="REV 9" />
  <chapter number="10" style="c" sid="REV 10" />
  <para style="s1">स्वर्गदूत र सानो चर्मपत्र</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 10:1" />तब मैले अर्को शक्तिशाली स्वर्गदूतलाई स्वर्गबाट तल आइरहेको देखेँ। तिनले बादल ओढेका थिए; तिनको शिरमाथि एउटा इन्द्रेणी थियो; अनि तिनको अनुहार सूर्यझैँ र पाउहरू आगोका खम्बाहरूजस्ता थिए। <verse eid="REV 10:1" /><verse number="2" style="v" sid="REV 10:2" />तिनले एउटा सानो चर्मपत्र समाइराखेका थिए, जुन तिनको हातमा खुल्‍लै थियो। तिनले आफ्नो दाहिने पाउ समुद्रमाथि र देब्रे पाउ जमिनमाथि राखेका थिए। <verse eid="REV 10:2" /><verse number="3" style="v" sid="REV 10:3" />अनि तिनी सिंह गर्जिएझैँ चर्को आवाजमा चिच्याए। जब तिनी चिच्याए, तब सात वटा मेघ गर्जनका आवाजहरूले बोले। <verse eid="REV 10:3" /><verse number="4" style="v" sid="REV 10:4" />अनि जब सात वटा मेघ गर्जनहरू बोले, तब मैले लेख्नै लागेको थिएँ; तर मैले स्वर्गबाट यसो भन्दै गरेको आवाज सुनेँ, “सात वटा गर्जनहरूले बोलेका कुराहरूमा छाप लगाऊ, र त्यसलाई नलेख।”<verse eid="REV 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 10:5" />तब मैले देखेका समुद्र र जमिनमा उभिरहेका ती स्वर्गदूतले आफ्नो दाहिने हात स्वर्गतिर उचाले। <verse eid="REV 10:5" /><verse number="6" style="v" sid="REV 10:6" />अनि तिनले उहाँको नाममा शपथ खाए, जो सदासर्वदा जिउनुहुन्छ, जसले स्वर्ग र त्यसमा भएका सबै थोक, जमिन र त्यसमा भएका सबै थोक र समुद्र, त्यसमा भएका सबै थोक सृजनुभयो र भन्‍नुभयो, “अब ढिलो हुनेछैन! <verse eid="REV 10:6" /><verse number="7" style="v" sid="REV 10:7" />तर जब सातौँ स्वर्गदूतले आफ्नो तुरही फुक्न लागेका दिनहरूमा, उहाँले आफ्ना सेवकहरू र अगमवक्ताहरूलाई भन्‍नुभएजस्तै गरी परमेश्‍वरको रहस्य पूरा हुनेछ।”<verse eid="REV 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 10:8" />तब स्वर्गबाट आएको आवाज मसित फेरि बोल्यो: “जाऊ, समुद्र र जमिनमाथि पाउ राखेका स्वर्गदूतको हातमा भएको खुल्‍ला चर्मपत्र लेऊ।”<verse eid="REV 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 10:9" />यसकारण म त्यस स्वर्गदूतकहाँ गएँ, र त्यो सानो चर्मपत्र मागेँ। तिनले मलाई भने, “यसलाई लेऊ, र खाऊ। यसले तिम्रो पेटलाई अमिलो बनाइदिनेछ, तर तिम्रो मुखभित्र यो महजस्तै गुलियो हुनेछ।”<note caller="+" style="f"><char style="fr" closed="false">10:9 </char><char style="ft" closed="false"><char style="xt"><ref loc="EZK 3:3">इज 3:3</ref></char></char></note> <verse eid="REV 10:9" /><verse number="10" style="v" sid="REV 10:10" />मैले त्यो सानो चर्मपत्र स्वर्गदूतको हातबाट लिएर त्यसलाई खाएँ। त्यो मेरो मुखमा महझैँ गुलियो भयो, तर जब मैले खाएँ, तब त्यो मेरो पेटमा अमिलो भयो। <verse eid="REV 10:10" /><verse number="11" style="v" sid="REV 10:11" />तब मलाई यसो भनियो, “तिमीले धेरै मानिसहरू, राष्ट्रहरू, भाषाहरू र राजाहरूको विषयमा फेरि अगमवाणी गर्नैपर्छ।”<verse eid="REV 10:11" /></para>
  <chapter eid="REV 10" />
  <chapter number="11" style="c" sid="REV 11" />
  <para style="s1">दुई साक्षीहरू</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 11:1" />मलाई एउटा नाप्‍ने लहुरोजस्तो निगालो दिइयो; र भनियो, “जाऊ, र परमेश्‍वरको मन्दिर र वेदीलाई नाप, र त्यहाँ आराधना गर्नेहरूलाई गन्ती गर। <verse eid="REV 11:1" /><verse number="2" style="v" sid="REV 11:2" />तर मन्दिरबाहिर रहेको चोकलाई चाहिँ ननाप; किनकि यो गैरयहूदीहरूलाई दिइएको छ। तिनीहरूले पवित्र सहरलाई बयालीस महिनासम्म कुल्चनेछन्। <verse eid="REV 11:2" /><verse number="3" style="v" sid="REV 11:3" />अनि म मेरा दुई जना साक्षीहरूलाई शक्ति दिनेछु, र तिनीहरूले भाङ्ग्राको वस्त्र लगाएर एक हजार दुई सय साठी दिनसम्म अगमवाणी बोल्नेछन्।” <verse eid="REV 11:3" /><verse number="4" style="v" sid="REV 11:4" />यिनीहरू “ती दुई जैतुनका रूखहरू” र दुई सामदानहरू हुन्, “जो पृथ्वीका प्रभुका सामु उभिन्छन्।”<note caller="+" style="f"><char style="fr" closed="false">11:4 </char><char style="ft" closed="false">हेर्नुहोस् <char style="xt"><ref loc="ZEC 4:3">जक 4:3</ref>, <ref loc="ZEC 4:11">11</ref>, <ref loc="ZEC 4:14">14</ref></char></char></note> <verse eid="REV 11:4" /><verse number="5" style="v" sid="REV 11:5" />यदि कसैले अगमवक्ताहरूलाई हानि गर्ने कोसिस गर्दछ भने तिनीहरूका मुखबाट आगो निस्केर ती शत्रुहरूलाई भस्म पारिदिनेछ। यसरी नै तिनीहरूलाई हानि गर्ने चेष्‍टा गर्नेहरू मर्नुपर्नेछ। <verse eid="REV 11:5" /><verse number="6" style="v" sid="REV 11:6" />यी अगमवक्ताहरूले अगमवाणी गरेका दिनहरूमा पानी नपरोस् भनेर आकाशलाई थुन्‍ने शक्ति हुनेछ; अनि पानीलाई रगतमा परिणत गर्ने तथा तिनीहरूले चाहेअनुसार पृथ्वीमा हरेक किसिमका रूढीले प्रहार गर्ने शक्ति हुनेछ।<verse eid="REV 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 11:7" />अब तिनीहरूले अगमवाणी<note caller="+" style="f"><char style="fr" closed="false">11:7 </char><char style="ft" closed="false">मूल भाषामा </char><char style="fqa" closed="false">गवाही</char></note> गरिसकेपछि अतल कुण्डबाट निस्केर आउने पशुले तिनीहरूलाई आक्रमण गरी वशमा ल्याएर मार्नेछ। <verse eid="REV 11:7" /><verse number="8" style="v" sid="REV 11:8" />तिनीहरूका लासहरू त्यस महान् सहरको सडकमा त्यसै छोडिएका हुनेछन्, जसलाई दृष्‍टान्तको रूपमा सदोम र इजिप्ट भनिन्छ, जहाँ तिनीहरूका प्रभु क्रूसमा टाँगिनुभएको थियो। <verse eid="REV 11:8" /><verse number="9" style="v" sid="REV 11:9" />साढे तीन दिनसम्म प्रत्येक जाति, कुल, भाषा र राष्ट्रबाट आएका मानिसहरूले तिनीहरूका शरीरलाई हेर्नेछन्, र गाड्न दिनेछैनन्। <verse eid="REV 11:9" /><verse number="10" style="v" sid="REV 11:10" />पृथ्वीका बासिन्दाहरूले तिनीहरूलाई रमिता मानेर हेर्नेछन्, र एक-अर्कालाई उपहार लेनदेन गर्दै खुशीयाली मनाउनेछन्; किनकि यी दुई अगमवक्ताहरूले ती पृथ्वीवासीहरूलाई यातना दिएका थिए।<verse eid="REV 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 11:11" />तर साढे तीन दिनपछि परमेश्‍वरबाट जीवनको सास<note caller="+" style="f"><char style="fr" closed="false">11:11 </char><char style="ft" closed="false">हेर्नुहोस् <char style="xt"><ref loc="EZK 37:5">इज 37:5</ref>, <ref loc="EZK 37:14">14</ref></char></char></note> तिनीहरूभित्र पस्यो, र तिनीहरू आफ्ना पाउमा उभिए; अनि तिनीहरूलाई देख्नेहरू डरले आतङ्कित भए। <verse eid="REV 11:11" /><verse number="12" style="v" sid="REV 11:12" />तब तिनीहरूले स्वर्गबाट ती दुईलाई यसो भन्दै गरेको एउटा चर्को सोर सुने, “यहाँ माथि आओ।” अनि तिनीहरूका शत्रुहरूले हेर्दाहेर्दै ती दुई बादलमा स्वर्गतिर उठाइए।<verse eid="REV 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 11:13" />ठिक त्यही समयमा एउटा ठूलो भुइँचालो गयो, र त्यस सहरको दशौँ भाग ढल्यो। सात हजार मानिसहरू भुइँचालोमा मारिए, र बाँचेकाहरू भयभीत भए; अनि स्वर्गका परमेश्‍वरलाई महिमा दिए।<verse eid="REV 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 11:14" />दोस्रो आतङ्क बित्यो; तेस्रो आतङ्क चाँडै आउँदैछ।<verse eid="REV 11:14" /></para>
  <para style="s1">सातौँ तुरही</para>
  <para style="p">
    <verse number="15" style="v" sid="REV 11:15" />जब सातौँ स्वर्गदूतले आफ्नो तुरही फुके, तब स्वर्गमा चर्का आवाजहरूले यसो भने:</para>
  <para style="q1" vid="REV 11:15">“संसारको राज्य</para>
  <para style="q2" vid="REV 11:15">हाम्रा प्रभुको र उहाँका ख्रीष्‍टको राज्य भएको छ,</para>
  <para style="q2" vid="REV 11:15">र उहाँले सदासर्वदा राज्य गर्नुहुनेछ।”<verse eid="REV 11:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="REV 11:16" />अनि परमेश्‍वरको अगाडि आ-आफ्ना सिंहासनहरूमा बस्‍ने ती चौबीस प्रधानहरूले घोप्टो परी परमेश्‍वरलाई आराधना गर्दै <verse eid="REV 11:16" /><verse number="17" style="v" sid="REV 11:17" />यसो भने:</para>
  <para style="q1" vid="REV 11:17">“हे सर्वशक्तिमान् परमप्रभु परमेश्‍वर, हामी तपाईंलाई धन्यवाद चढाउँछौँ,</para>
  <para style="q2" vid="REV 11:17">जो हुनुहुन्छ, जो हुनुहुन्थ्यो;</para>
  <para style="q1" vid="REV 11:17">किनकि तपाईंले आफ्नो महान् शक्ति लिनुभएको छ,</para>
  <para style="q2" vid="REV 11:17">र राज्य गर्न थाल्नुभएको छ।<verse eid="REV 11:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="REV 11:18" />राष्ट्रहरू क्रोधित भएका थिए,</para>
  <para style="q2" vid="REV 11:18">र तपाईंको क्रोध आइपुगेको छ।</para>
  <para style="q1" vid="REV 11:18">मरेकाहरूको न्याय हुने बेला आएको छ;</para>
  <para style="q2" vid="REV 11:18">अनि तपाईंका सेवक अगमवक्ताहरू,</para>
  <para style="q1" vid="REV 11:18">तपाईंका सन्तहरू र तिनीहरू जसले तपाईंको नामको डर मान्छन्;</para>
  <para style="q2" vid="REV 11:18">ठूला र सानाहरू दुवैलाई पुरस्कार दिने बेला आएको छ;</para>
  <para style="q1" vid="REV 11:18">अनि पृथ्वीलाई नाश गर्नेहरूलाई नष्‍ट गर्ने समय आएको छ।”<verse eid="REV 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 11:19" />तब स्वर्गमा भएको परमेश्‍वरको मन्दिर खोलियो; अनि त्यस मन्दिरभित्र करारको सन्दुक देखियो। अनि त्यहाँ बिजुलीका चमकहरू, मेघ गर्जन र गडगडाहटका आवाजहरू आए, र भुइँचालो गयो र ठूला-ठूला असिनाहरू परे।<verse eid="REV 11:19" /></para>
  <chapter eid="REV 11" />
  <chapter number="12" style="c" sid="REV 12" />
  <para style="s1">स्त्री र विशाल अजिङ्गर</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 12:1" />एउटा ठूलो र अचम्मको चिन्ह स्वर्गमा देखियो: सूर्य ओढेकी, पाउमुनि चन्द्र भएकी र शिरमाथि बाह्र वटा ताराहरूको मुकुट लगाएकी एउटी स्त्री देखा परिन्। <verse eid="REV 12:1" /><verse number="2" style="v" sid="REV 12:2" />उनी गर्भवती थिइन्, र सुत्केरी व्यथाको पीडाले गर्दा चिच्याइरहेकी थिइन्। <verse eid="REV 12:2" /><verse number="3" style="v" sid="REV 12:3" />तब स्वर्गमा अर्को चिन्ह देखा पर्‍यो: सात शिरहरू, दश सिङहरू भएको र शिरहरूमा सात वटा मुकुटहरू भएको एउटा विशाल रातो अजिङ्गर<note caller="+" style="f"><char style="fr" closed="false">12:3 </char><char style="ft" closed="false">त्यो </char><char style="fqa" closed="false">पखेटा भएको विशाल सर्प थियो र मुखबाट आगो निकाल्थ्यो।</char></note>। <verse eid="REV 12:3" /><verse number="4" style="v" sid="REV 12:4" />त्यसको पुच्छरले आकाशका ताराहरूको तेस्रो भागलाई सोहोरेर पृथ्वीमा फाल्यो; अनि बच्‍चा जन्माउन लागेकी स्त्रीले बालक जन्माउनसाथ त्यसलाई खाइहाल्न भनेर त्यो अजिङ्गर ती स्त्रीको सामु उभियो। <verse eid="REV 12:4" /><verse number="5" style="v" sid="REV 12:5" />ती स्त्रीले एउटा छोरालाई जन्म दिइन्, “जसले राष्ट्रहरूलाई फलामको राजदण्डले शासन गर्नेछ।”<note caller="+" style="f"><char style="fr" closed="false">12:5 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 2:9">भजन 2:9</ref></char></char></note> अनि तुरुन्तै तिनको बालक परमेश्‍वरकहाँ र उहाँको सिंहासन भएको ठाउँमा खोसेर लगियो। <verse eid="REV 12:5" /><verse number="6" style="v" sid="REV 12:6" />तब ती स्त्री परमेश्‍वरले एक हजार दुई सय साठी दिनसम्म तिनको हेरचाहको लागि तयार पारेर राखिदिनुभएको ठाउँ उजाडस्थानतिर भागिन्।<verse eid="REV 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 12:7" />तब स्वर्गमा लडाइँ सुरु भयो। स्वर्गदूत माइकल र तिनका दूतहरूले त्यस अजिङ्गरसित लडाइँ गरे, र अजिङ्गर र त्यसका दूतहरूले पनि तिनीहरूसँग लडाइँ गरे। <verse eid="REV 12:7" /><verse number="8" style="v" sid="REV 12:8" />तर त्यो अजिङ्गर त्यति बलियो थिएन; त्यसैले तिनीहरूले स्वर्गका आफ्ना ठाउँहरू हारे। <verse eid="REV 12:8" /><verse number="9" style="v" sid="REV 12:9" />त्यो विशाल अजिङ्गर तल फ्याँकियो। त्यो प्राचीन सर्प, जसलाई दियाबलस वा शैतान पनि भनिन्छ, जसले सारा पृथ्वीलाई बहकाउँछ। त्यो र त्यसका दूतहरू त्योसँगै पृथ्वीमा फ्याँकिए।<verse eid="REV 12:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 12:10" />तब मैले स्वर्गमा यसो भनेको ठूलो आवाज सुनेँ:</para>
  <para style="q1" vid="REV 12:10">“अब हाम्रा परमेश्‍वरको मुक्ति, शक्ति, राज्य</para>
  <para style="q2" vid="REV 12:10">र उहाँका ख्रीष्‍टको अख्तियार आएका छन्।</para>
  <para style="q1" vid="REV 12:10">किनकि हाम्रा दाजुभाइ-दिदीबहिनीहरूलाई दोष लगाउने,</para>
  <para style="q2" vid="REV 12:10">जसले परमेश्‍वरको सामु तिनीहरूलाई दिनरात दोष लगाउँछ,</para>
  <para style="q2" vid="REV 12:10">त्यो तल फ्याँकिएको छ।<verse eid="REV 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="REV 12:11" />तिनीहरूले त्यसलाई थुमाको रगतले</para>
  <para style="q2" vid="REV 12:11">र तिनीहरूका साक्षीको वचनले जितेका छन्;</para>
  <para style="q1" vid="REV 12:11">तिनीहरूले मृत्युसम्मै पनि</para>
  <para style="q2" vid="REV 12:11">आफ्ना जीवनलाई प्रेम गरेनन्।<verse eid="REV 12:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="REV 12:12" />यसकारण हे स्वर्गहरू</para>
  <para style="q2" vid="REV 12:12">र स्वर्गहरूमा बस्‍नेहरू हो, तिमीहरू रमाओ!</para>
  <para style="q1" vid="REV 12:12">तर पृथ्वी र समुद्रलाई धिक्‍कार!</para>
  <para style="q2" vid="REV 12:12">किनकि आफ्नो समय छोटो छ भन्‍ने थाहा पाएर</para>
  <para style="q1" vid="REV 12:12">दियाबलस ठूलो क्रोधसित</para>
  <para style="q2" vid="REV 12:12">तिमीहरूकहाँ तल आएको छ!”<verse eid="REV 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 12:13" />जब त्यस अजिङ्गरले आफूलाई पृथ्वीमा फालिएको देख्यो, तब त्यसले छोरा जन्माउने त्यस स्त्रीलाई खेद्न थाल्यो। <verse eid="REV 12:13" /><verse number="14" style="v" sid="REV 12:14" />ती स्त्रीलाई गरुडका दुई पखेटाहरू दिइयो, ताकि तिनी उजाडस्थानमा उडेर जान सकून्, जहाँ एक काल, दुई काल र आधा कालसम्मका<note caller="+" style="f"><char style="fr" closed="false">12:14 </char><char style="ft" closed="false">यहाँ भनिएको </char><char style="fqa" closed="false">कालले </char><char style="ft" closed="false">पद 6 मा भनिएको एक हजार दुई सय साठी दिनहरूलाई जनाउँछ, जुन चन्द्र पात्रोका अनुसार साढे तीन वर्ष हुन्छ</char></note> लागि त्यस सर्पको पहुँचबाट बाहिर उनको हेरचाह होस् भनेर तयार पारिएको थियो। <verse eid="REV 12:14" /><verse number="15" style="v" sid="REV 12:15" />तब ती स्त्रीलाई बाढीले बगाओस् भनेर त्यस सर्पले स्त्रीको पछि आफ्नो मुखबाट नदीझैँ पानी निकाल्यो। <verse eid="REV 12:15" /><verse number="16" style="v" sid="REV 12:16" />तर ती स्त्रीलाई सहायता गर्न पृथ्वीले आफ्नो मुख खोल्यो र त्यस अजिङ्गरले आफ्नो मुखबाट निकालेको नदीलाई निलिदियो। <verse eid="REV 12:16" /><verse number="17" style="v" sid="REV 12:17" />तर त्यो अजिङ्गर स्त्रीसित क्रोधित भयो, र उनका अरू सन्तानहरू जसले परमेश्‍वरका आज्ञाहरू पालन गर्छन्, र येशूको साक्षी दिन्छन्; तिनीहरूसित लडाइँ गर्न गयो। अनि त्यो अजिङ्गर समुद्रको किनारमा उभियो।<verse eid="REV 12:17" /></para>
  <chapter eid="REV 12" />
  <chapter number="13" style="c" sid="REV 13" />
  <para style="s1">समुद्रबाट आएको पशु</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 13:1" />तब मैले एउटा पशुलाई समुद्रबाट निस्कँदैगरेको देखेँ। त्यसका दश वटा सिङहरू र सात वटा शिरहरू थिए, र त्यसका सिङहरूमा दश वटा मुकुटहरू थिए; अनि प्रत्येक शिरमाथि एउटा ईश्‍वरनिन्दाको नाम लेखिएको थियो। <verse eid="REV 13:1" /><verse number="2" style="v" sid="REV 13:2" />मैले देखेको पशु चितुवाजस्तै थियो, तर त्यसका खुट्टाहरू भालुका जस्ता र मुखचाहिँ सिंहको जस्तो थियो। त्यस अजिङ्गरले आफ्नो शक्ति, आफ्नो सिंहासन र ठूलो अख्तियार त्यस पशुलाई दियो। <verse eid="REV 13:2" /><verse number="3" style="v" sid="REV 13:3" />त्यस पशुका शिरहरूमध्ये एउटामा प्राणघातक चोट लागेको जस्तो थियो; तर त्यो घातक चोट निको भएको थियो। सारा पृथ्वी छक्‍क पर्‍यो र त्यस पशुको पछि लाग्यो। <verse eid="REV 13:3" /><verse number="4" style="v" sid="REV 13:4" />मानिसहरूले त्यस अजिङ्गरको आराधना गरे; किनकि त्यसले नै त्यस पशुलाई अधिकार दिएको थियो, र तिनीहरूले त्यस पशुलाई पनि आराधना गरेर यसो भनी सोधे, “यो पशुजस्तो को छ र? यससित लडाइँ गर्न कसले सक्छ र?”<verse eid="REV 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 13:5" />त्यस पशुलाई अहङ्कारका शब्दहरू र ईश्‍वरनिन्दाहरू बोल्नलाई एउटा मुख र बयालीस महिनासम्म आफ्नो शक्ति चलाउने अख्तियार दिइयो। <verse eid="REV 13:5" /><verse number="6" style="v" sid="REV 13:6" />परमेश्‍वरको विरुद्धमा निन्दा गर्न, उहाँको नाम, उहाँको वासस्थान र स्वर्गमा बस्‍नेहरूसमेत सबैको निन्दा गर्न त्यसले आफ्नो मुख खोल्यो। <verse eid="REV 13:6" /><verse number="7" style="v" sid="REV 13:7" />त्यसलाई सबै सन्तहरूसित लडाइँ गर्ने र तिनीहरूलाई जित्ने शक्ति दिइयो। त्यसलाई प्रत्येक कुल, जाति, भाषा र राष्ट्रहरूमाथि अख्तियार दिइयो। <verse eid="REV 13:7" /><verse number="8" style="v" sid="REV 13:8" />अनि पृथ्वीमा बास गर्ने सबैले त्यस पशुको आराधना गर्नेछन्, अथवा तिनीहरूले, जसका नामहरू संसारको सृष्‍टिदेखि नै मारिनुभएको थुमाको जीवनको पुस्तकमा लेखिएका छैनन्।<verse eid="REV 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 13:9" />जसको कान छ, त्यसले सुनोस्।<verse eid="REV 13:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="REV 13:10" />“यदि कोही कैदका लागि छ भने,</para>
  <para style="q2" vid="REV 13:10">त्यो कैदमा जानेछ।</para>
  <para style="q1" vid="REV 13:10">यदि कसैलाई तरवारले मारिनुछ भने,</para>
  <para style="q2" vid="REV 13:10">त्यो तरवारले नै मारिनेछ।”<note caller="+" style="f"><char style="fr" closed="false">13:10 </char><char style="ft" closed="false"><char style="xt"><ref loc="JER 15:2">यर्मिया 15:2</ref></char></char></note></para>
  <para style="m" vid="REV 13:10">परमेश्‍वरका जनहरूको धैर्यशाली सहनशीलता र विश्‍वासयोग्यता यसैमा हुनुपर्छ।<verse eid="REV 13:10" /></para>
  <para style="s1">पृथ्वीबाट माथि आउने पशु</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 13:11" />तब मैले पृथ्वीबाट माथि निस्कँदैगरेको अर्को पशु देखेँ। त्यसका भेडाका जस्ता दुई सिङहरू थिए, तर त्यो अजिङ्गरले जस्तो बोल्थ्यो। <verse eid="REV 13:11" /><verse number="12" style="v" sid="REV 13:12" />त्यसले पहिलो पशुको पक्षमा त्यसको सारा अधिकार चलायो; अनि पृथ्वी र त्यसका बासिन्दाहरूलाई त्यसले त्यो प्राणघातक चोट निको भएको पहिलो पशुको आराधना गर्न लगायो। <verse eid="REV 13:12" /><verse number="13" style="v" sid="REV 13:13" />त्यसले अलौकिक चिन्हहरू देखायो, यहाँसम्म कि मानिसहरूले देख्ने गरी त्यसले आकाशबाट पृथ्वीमा आगोसमेत झार्‍यो। <verse eid="REV 13:13" /><verse number="14" style="v" sid="REV 13:14" />त्यस पहिलो पशुको पक्षमा प्रयोग गर्ने अधिकार पाएको अलौकिक चिन्हहरूद्वारा त्यसले पृथ्वीका बासिन्दाहरूलाई बहकायो। तरवारको चोट पाएर पनि त्यसले तिनीहरूलाई जीवित भएको त्यस पहिलो पशुको सम्मानमा मूर्ति बनाउनलाई हुकुम दियो। <verse eid="REV 13:14" /><verse number="15" style="v" sid="REV 13:15" />त्यस पहिलो पशुको मूर्तिले बोलोस् भनेर त्यसमा सास हाल्ने अनुमति त्यसलाई दिइयो, यस हेतुले कि त्यस मूर्तिलाई आराधना नगर्ने सबै मारिऊन्। <verse eid="REV 13:15" /><verse number="16" style="v" sid="REV 13:16" />त्यसले साना र ठूला, धनी र गरिब, स्वतन्त्र र सेवकहरू सबैलाई आफ्नो दाहिने हातमा अथवा निधारमा त्यसको छाप लगाउन कर लगायो। <verse eid="REV 13:16" /><verse number="17" style="v" sid="REV 13:17" />त्यो छापचाहिँ त्यस पहिलो पशुको नाम अथवा त्यसको नामको संख्या हो, यो छापबाहेक कसैले पनि किन्‍न वा बेच्न नपाउने भयो।<verse eid="REV 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 13:18" />बुद्धि चाहिने यस्तै बेला हो। जसको समझ छ, त्यसले त्यस पशुको संख्या गनोस्; किनकि यो मानिसको संख्या हो। अनि त्यसको संख्या छ सय छयसट्ठी हो।<verse eid="REV 13:18" /></para>
  <chapter eid="REV 13" />
  <chapter number="14" style="c" sid="REV 14" />
  <para style="s1">थुमा तथा 1,44,000 मानिसहरू</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 14:1" />तब मैले हेरेँ, र मेरो सामु सियोन पर्वतमा थुमालाई उभिरहनुभएको देखेँ। उहाँसँग 1,44,000 लाई देखेँ, जसको निधारमा उहाँ र उहाँका पिताको नाम लेखिएको थियो। <verse eid="REV 14:1" /><verse number="2" style="v" sid="REV 14:2" />तब मैले स्वर्गबाट जोडसित बग्दै गरेको पानी र ठूलो गर्जनजस्तो आवाज आइरहेको सुनेँ। मैले सुनेको आवाज वीणा वादकहरूले आफ्ना वीणाहरू बजाएको जस्तै थियो। <verse eid="REV 14:2" /><verse number="3" style="v" sid="REV 14:3" />तिनीहरूले सिंहासनको सामु ती चार वटा जीवित प्राणीहरूको र प्रधानहरूको सामु एउटा नयाँ गीत गाए। पृथ्वीबाट छुटकारा पाएका ती 1,44,000 ले बाहेक कसैले पनि त्यो गीत सिक्न सक्दैनथे। <verse eid="REV 14:3" /><verse number="4" style="v" sid="REV 14:4" />यी मानिसहरू ती हुन्, जो स्त्रीहरूसित बिटुलिएनन्; किनकि तिनीहरूले आफूलाई शुद्ध राखेका थिए। थुमा जहाँ जानुहुन्छ, तिनीहरूले उहाँलाई पछ्याउँछन्। तिनीहरू मानव जातिबाट किनिएका थिए; अनि परमेश्‍वर र थुमालाई पहिलो फलझैँ चढाइए। <verse eid="REV 14:4" /><verse number="5" style="v" sid="REV 14:5" />तिनीहरूका मुखमा कुनै झूट पाइएन; तिनीहरू निर्दोष छन्।<verse eid="REV 14:5" /></para>
  <para style="s1">तीन स्वर्गदूतहरू</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 14:6" />तब मैले बीच आकाशमा उडिरहेका अर्को स्वर्गदूतलाई देखेँ, र तिनीसित पृथ्वीमा बस्‍नेहरू, प्रत्येक राष्ट्र, कुल, भाषा र जातिहरूलाई घोषणा गर्नुपर्ने अनन्तको सुसमाचार थियो। <verse eid="REV 14:6" /><verse number="7" style="v" sid="REV 14:7" />तिनले चर्को सोरले भने, “परमेश्‍वरसित डराओ, र उहाँलाई महिमा देओ; किनकि उहाँको न्यायको बेला आएको छ। उहाँको आराधना गर, जसले स्वर्गहरू, पृथ्वी, समुद्र र पानीका मूलहरू बनाउनुभयो।”<verse eid="REV 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 14:8" />दोस्रो स्वर्गदूतले पनि आएर भने, “सबै राष्ट्रहरूलाई आफ्नो व्यभिचारी कामवासनाको मद्यको कचौरा पिउन लगाउने, ‘महान् सहर बेबिलोनको पतन भयो! पतन भयो!’<note caller="+" style="f"><char style="fr" closed="false">14:8 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 21:9">यशै 21:9</ref></char></char></note>”<verse eid="REV 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 14:9" />ती दुई स्वर्गदूतका पछि तेस्रो स्वर्गदूतले चर्को सोरले भने, “यदि कसैले त्यस पशु र त्यसको मूर्तिलाई आराधना गर्छ र त्यसको छाप निधारमा अथवा हातमा लगाउँछ भने, <verse eid="REV 14:9" /><verse number="10" style="v" sid="REV 14:10" />त्यसले पनि उहाँको क्रोधको कचौरामा केही नमिसाई तयार गरिएको परमेश्‍वरको क्रोधको कडा मद्य पिउनेछ। त्यसलाई पवित्र स्वर्गदूतहरू र थुमाको उपस्थितिमा बल्दैगरेको गन्धकमा यातना दिइनेछ। <verse eid="REV 14:10" /><verse number="11" style="v" sid="REV 14:11" />अनि तिनीहरूका यातनाको धुवाँ सदासर्वदा उँभोतिर उठिरहनेछ। जसले त्यो पशु र त्यसको मूर्तिको आराधना गर्छन् र जसले त्यसको नामको छाप लगाउँछन्, तिनीहरूले दिनरात आराम पाउनेछैनन्।” <verse eid="REV 14:11" /><verse number="12" style="v" sid="REV 14:12" />परमेश्‍वरका आज्ञाहरू पालन गर्ने, र येशूप्रति विश्‍वासयोग्य भइरहने परमेश्‍वरका जनहरूको धीरज र सहनशीलता यसैमा हुनुपर्छ।<verse eid="REV 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 14:13" />तब मैले स्वर्गबाट आएको एउटा आवाजले यसो भनिरहेको सुनेँ, “यो लेख: अब उसो प्रभुमा मर्नेहरू धन्यका हुन्।”</para>
  <para style="p" vid="REV 14:13">आत्मा भन्‍नुहुन्छ, “हो, तिनीहरूले परिश्रमबाट विश्राम पाउनेछन्; किनकि तिनीहरूका काम तिनीहरूका साथ लाग्नेछन्।”<verse eid="REV 14:13" /></para>
  <para style="s1">पृथ्वीको कटनी</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 14:14" />तब मैले हेरेँ, र मेरो सामु एउटा सेतो बादल थियो; त्यस बादलमा एक जना “मानिसको पुत्रजस्तै” बसिरहेको थियो,<note caller="+" style="f"><char style="fr" closed="false">14:14 </char><char style="ft" closed="false">हेर्नुहोस् <char style="xt"><ref loc="DAN 7:13">दानि 7:13</ref></char></char></note> जसको शिरमा सुनको मुकुट र हातमा एउटा धारिलो हँसिया थियो। <verse eid="REV 14:14" /><verse number="15" style="v" sid="REV 14:15" />तब मन्दिरबाट अर्का स्वर्गदूत आए, र बादलमा बसिरहनुहुनेलाई चर्को सोरले भने, “तपाईंको हँसिया लिएर कटनी गर्नुहोस्; किनकि कटनीको समय आएको छ, र पृथ्वीको बाली पाकिसकेको छ।” <verse eid="REV 14:15" /><verse number="16" style="v" sid="REV 14:16" />यसरी बादलमा बस्‍नुहुनेले आफ्नो हँसिया पृथ्वीमाथि चलाउनुभयो; अनि पृथ्वीमा कटनी भयो।<verse eid="REV 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 14:17" />स्वर्गमा भएको मन्दिरबाट अर्का स्वर्गदूत आए, तिनीसित पनि एउटा धारिलो हँसिया थियो। <verse eid="REV 14:17" /><verse number="18" style="v" sid="REV 14:18" />आगोको जिम्मेवारी पाएका अर्का स्वर्गदूत वेदीबाट आए, र धारिलो हँसिया हुनेलाई चर्को सोरमा भने, “तिम्रो हँसिया लिएर पृथ्वीको अङ्‌गुरका झुप्पाहरू बटुल; किनकि अङ्‌गुर पाकिसकेको छ।” <verse eid="REV 14:18" /><verse number="19" style="v" sid="REV 14:19" />त्यस स्वर्गदूतले आफ्नो हँसिया पृथ्वीमा चलाए, र त्यसमा भएका अङ्‌गुर बटुले; अनि तिनीहरूलाई परमेश्‍वरको क्रोधको ठूलो दाखको कोलमा फालिदिए। <verse eid="REV 14:19" /><verse number="20" style="v" sid="REV 14:20" />सहर बाहिरको दाखको कोलमा त्यो अङ्‌गुर कुल्चीमिल्ची गरियो, र दाखको कोलबाट रगत निस्केर आयो। त्यो रगत घोडाको लगामसम्म आयो, र त्यो 300 किलोमिटर<note caller="+" style="f"><char style="fr" closed="false">14:20 </char><char style="ft" closed="false">मूल भाषामा </char><char style="fqa" closed="false">1,600 स्टेडिया </char><char style="ft" closed="false">भनिन्छ।</char></note> सम्म फैलिएको थियो।<verse eid="REV 14:20" /></para>
  <chapter eid="REV 14" />
  <chapter number="15" style="c" sid="REV 15" />
  <para style="s1">सात स्वर्गदूतहरूसँग सात विपत्तिहरू</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 15:1" />मैले स्वर्गमा अर्को ठूलो र आश्‍चर्यजनक चिन्ह देखेँ: सात वटा अन्तिम विपत्तिहरू लिएका सात स्वर्गदूतहरू थिए। यी अन्तिम विपत्तिहरू हुन्; किनकि यी विपत्तिहरूसँगै परमेश्‍वरको क्रोध पूरा हुनेछ। <verse eid="REV 15:1" /><verse number="2" style="v" sid="REV 15:2" />अनि मैले आगोसित मिसिएको काँचको समुद्रझैँ देखेँ; अनि समुद्रको किनारमा त्यो पशु र त्यसको मूर्ति अनि त्यसको नामको संख्यामाथि विजयी भएकाहरूलाई देखेँ। तिनीहरूले परमेश्‍वरले दिनुभएका वीणाहरू लिएका थिए। <verse eid="REV 15:2" /><verse number="3" style="v" sid="REV 15:3" />तिनीहरूले परमेश्‍वरको सेवक मोशाको र थुमाको गीत गाए:</para>
  <para style="q1" vid="REV 15:3">“हे सर्वशक्तिमान् परमप्रभु परमेश्‍वर,</para>
  <para style="q2" vid="REV 15:3">तपाईंका कामहरू महान् र अचम्मका छन्।</para>
  <para style="q1" vid="REV 15:3">राष्ट्रहरूका राजा,</para>
  <para style="q2" vid="REV 15:3">तपाईंका मार्गहरू न्यायपूर्ण र सत्य छन्।<verse eid="REV 15:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="REV 15:4" />हे प्रभु, तपाईंको डर कसले मान्दैन?</para>
  <para style="q2" vid="REV 15:4">अनि तपाईंको नामको महिमा कसले गर्दैन र?</para>
  <para style="q1" vid="REV 15:4">किनकि तपाईं मात्र पवित्र हुनुहुन्छ।</para>
  <para style="q1" vid="REV 15:4">सबै राष्ट्रहरू आएर तपाईंको सामु</para>
  <para style="q2" vid="REV 15:4">दण्डवत् गर्नेछन्;</para>
  <para style="q1" vid="REV 15:4">किनकि तपाईंका धार्मिक कामहरू प्रकट भएका छन्।”<note caller="+" style="f"><char style="fr" closed="false">15:4 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 111:2">भजन 111:2</ref>, <ref loc="PSA 111:3">3</ref>; <ref loc="DEU 32:4">व्यव 32:4</ref>; <ref loc="JER 10:7">यर्मिया 10:7</ref>; <ref loc="PSA 86:9">भजन 86:9</ref>; <ref loc="PSA 98:2">98:2</ref></char></char></note><verse eid="REV 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 15:5" />त्यसपछि मैले स्वर्गमा मन्दिर उघारिएको देखेँ, जुनचाहिँ गवाहीको पाल हो। <verse eid="REV 15:5" /><verse number="6" style="v" sid="REV 15:6" />त्यस मन्दिरबाट सात स्वर्गदूतहरू सात विपत्तिहरू लिएर बाहिर आए। तिनीहरूले सफा र चम्किलो मलमलको वस्त्र पहिरेका थिए, र छातीमा सुनका पेटी बाँधेका थिए। <verse eid="REV 15:6" /><verse number="7" style="v" sid="REV 15:7" />तब ती चार जीवित प्राणीहरूमध्ये एक जनाले ती सात स्वर्गदूतहरूलाई सदासर्वदा जिउनुहुने परमेश्‍वरको क्रोधले भरिएका सात वटा सुनका कचौराहरू दिए। <verse eid="REV 15:7" /><verse number="8" style="v" sid="REV 15:8" />अनि परमेश्‍वरको महिमा र उहाँको शक्तिबाट आएको धुवाँले मन्दिर भरियो; अनि ती सात स्वर्गदूतहरूका सात विपत्तिहरू पूरा नभएसम्म कोही पनि मन्दिरभित्र पस्‍न सकेन।<verse eid="REV 15:8" /></para>
  <chapter eid="REV 15" />
  <chapter number="16" style="c" sid="REV 16" />
  <para style="s1">परमेश्‍वरको क्रोधका सात कचौराहरू</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 16:1" />तब मैले मन्दिरबाट सात स्वर्गदूतहरूलाई चर्को सोरले यसो भनिरहेको सुनेँ, “जाओ, र परमेश्‍वरको क्रोधका सात कचौराहरू पृथ्वीमाथि खन्याइदेओ।”<verse eid="REV 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 16:2" />तब पहिलो स्वर्गदूतले गएर आफ्नो कचौरा पृथ्वीमाथि खन्याइदिए; अनि त्यस पशुको छाप लागेका र त्यसको मूर्तिलाई पुज्ने मानिसहरूमा घिनलाग्दा र कष्‍टदायक घाउखटिरा निस्क्यो।<verse eid="REV 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 16:3" />जब दोस्रो स्वर्गदूतले आफ्नो कचौरा समुद्रमा खन्याए, तब त्यो मरेको मानिसको रगतझैँ भइहाल्यो; अनि समुद्रमा भएका प्रत्येक जीवित प्राणीको मृत्यु भयो।<verse eid="REV 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 16:4" />अनि तेस्रो स्वर्गदूतले आफ्नो कचौरा नदी र पानीका मूलहरूमा खन्याए; अनि ती रगत भइहाले। <verse eid="REV 16:4" /><verse number="5" style="v" sid="REV 16:5" />अनि पानीका अधिकारी स्वर्गदूतले यसो भनिरहेका मैले सुनेँ:</para>
  <para style="q1" vid="REV 16:5">तपाईं जो हुनुहुन्छ, र जो हुनुहुन्थ्यो, पवित्र परमेश्‍वर हुनुहुन्छ,</para>
  <para style="q2" vid="REV 16:5">“तपाईं यी न्यायहरूमा न्यायी हुनुहुन्छ;<verse eid="REV 16:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="REV 16:6" />किनकि तिनीहरूले तपाईंका सन्तहरू र अगमवक्ताहरूको रगत बगाएका छन्;</para>
  <para style="q2" vid="REV 16:6">अनि तपाईंले तिनीहरूलाई रगत पिउन दिनुभएको छ; तिनीहरू यसकै लायक छन्।”<verse eid="REV 16:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="REV 16:7" />अनि वेदीबाट कसैले यसरी उत्तर दिइरहेको मैले सुनेँ:</para>
  <para style="q1" vid="REV 16:7">“हो, सर्वशक्तिमान् परमप्रभु परमेश्‍वर,</para>
  <para style="q2" vid="REV 16:7">तपाईंका न्यायहरू सत्य र न्यायपूर्ण छन्।”<verse eid="REV 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 16:8" />जब चौथो स्वर्गदूतले आफ्नो कचौरा सूर्यमाथि खन्याए; तब सूर्यलाई यसको आगोले मानिसहरूलाई डढाउने अनुमति दिइयो। <verse eid="REV 16:8" /><verse number="9" style="v" sid="REV 16:9" />तिनीहरू प्रचण्ड तापले डढे, र तिनीहरूले यी विपत्तिहरूमाथि अधिकार भएका परमेश्‍वरलाई सरापे; तर तिनीहरूले पश्‍चात्ताप गर्न र उहाँलाई महिमा दिन इन्कार गरे।<verse eid="REV 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 16:10" />जब पाँचौँ स्वर्गदूतले त्यस पशुको सिंहासनमाथि आफ्नो कचौरा खन्याए, तब त्यसको राज्यमा अन्धकार छायो। मानिसहरूले कष्‍टमा आ-आफ्ना जिब्राहरू टोके, <verse eid="REV 16:10" /><verse number="11" style="v" sid="REV 16:11" />अनि खटिरा र वेदनाको कारण स्वर्गका परमेश्‍वरलाई सरापे, तर तिनीहरूले गरेका कामहरूको लागि पश्‍चात्ताप गरेनन्।<verse eid="REV 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 16:12" />जब छैटौँ स्वर्गदूतले आफ्नो कचौरा महानदी यूफ्रेटिसमाथि खन्याए; तब पूर्वका राजाहरूको लागि बाटो तयार होस् भनेर त्यसको पानी सुकिहाल्यो। <verse eid="REV 16:12" /><verse number="13" style="v" sid="REV 16:13" />तब मैले भ्यागुताहरूजस्ता देखिने दुष्‍ट आत्माहरूलाई त्यस अजिङ्गरको मुखबाट, त्यस पशुको मुखबाट र त्यस झूटा अगमवक्ताको मुखबाट निस्किरहेको देखेँ। <verse eid="REV 16:13" /><verse number="14" style="v" sid="REV 16:14" />तिनीहरू ती अलौकिक चिन्हहरू देखाउने दुष्‍ट आत्माहरू हुन्, तिनीहरू ती सारा संसारका राजाहरूलाई सर्वशक्तिमान् परमेश्‍वरको महान् दिनमा लडाइँ गर्न भेला गर्नलाई जान्छन्।<verse eid="REV 16:14" /></para>
  <para style="b" />
  <para style="mi">
    <verse number="15" style="v" sid="REV 16:15" />“हेर, म चोरजस्तो गरी आउनेछु! त्यो धन्यको हो, जो जागा रहन्छ, र जसले आफ्नो वस्त्रको रक्षा गर्छ, ताकि उसको नग्नताको शर्म नदेखियोस्।”<verse eid="REV 16:15" /></para>
  <para style="b" />
  <para style="m">
    <verse number="16" style="v" sid="REV 16:16" />तब ती दुष्‍ट आत्माहरूले राजाहरूलाई हिब्रू भाषामा आरमागेड्डोन भन्‍ने ठाउँमा भेला गराए।<verse eid="REV 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 16:17" />जब सातौँ स्वर्गदूतले आफ्नो कचौरा हावामा खन्याए; तब मन्दिरको सिंहासनबाट यसो भन्‍ने चर्को आवाज आयो, “अब सिद्धियो!” <verse eid="REV 16:17" /><verse number="18" style="v" sid="REV 16:18" />अनि त्यहाँ बिजुलीको चमक, गड्याङ-गुडुङ, मेघ गर्जन र ठूलो भुइँचालो गयो। त्यो भुइँचालो यति ठूलो थियो, कि पृथ्वीमा मानव-जाति भएदेखि यता त्यस्तो कहिल्यै गएको थिएन। <verse eid="REV 16:18" /><verse number="19" style="v" sid="REV 16:19" />त्यो महान् सहर तीन भागमा टुक्रियो, र सबै राष्ट्रहरूका सहरहरू ध्वंस भए। परमेश्‍वरले महान् बेबिलोनलाई सम्झनुभयो, र त्यसलाई आफ्नो भयानक क्रोधको मद्यले भरिएको कचौरा पिउन दिनुभयो। <verse eid="REV 16:19" /><verse number="20" style="v" sid="REV 16:20" />प्रत्येक टापु लोप भएर गए, र पहाडहरू हराएर गए। <verse eid="REV 16:20" /><verse number="21" style="v" sid="REV 16:21" />आकाशबाट पैँतालीस किलो तौल भएका ठूला-ठूला असिना मानिसहरूमाथि खसे; अनि विपत्ति निकै डरलाग्दो भएकाले असिनाको कारण मानिसहरूले परमेश्‍वरलाई सरापे।<verse eid="REV 16:21" /></para>
  <chapter eid="REV 16" />
  <chapter number="17" style="c" sid="REV 17" />
  <para style="s1">पशुमाथि बसेकी स्त्री</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 17:1" />सात वटा कचौराहरू भएका सात स्वर्गदूतहरूमध्ये एक जना आएर मलाई भने, “आऊ, म तिमीलाई धेरै पानीहरूमाथि बस्‍ने महावेश्याको दण्ड देखाइदिनेछु। <verse eid="REV 17:1" /><verse number="2" style="v" sid="REV 17:2" />त्यससित पृथ्वीका राजाहरूले व्यभिचार गरे, र त्यसको व्यभिचारको मद्यले पृथ्वीका बासिन्दाहरू मात्तिए।”<verse eid="REV 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 17:3" />तब ती स्वर्गदूतले मलाई आत्माद्वारा एउटा उजाडस्थानमा लगे। त्यहाँ मैले एउटी स्त्रीलाई ईश्‍वरनिन्दाहरूको नामले भरिएको, सात शिर र दश सिङहरू भएको एउटा रातो पशुमाथि बसिरहेकी देखेँ। <verse eid="REV 17:3" /><verse number="4" style="v" sid="REV 17:4" />त्यस स्त्रीले बैजनी र चहकिलो रातो वस्त्र पहिरेकी थिई; अनि सुन, रत्न र मोतीहरूले सिँगारिएकी थिई। त्यसले हातमा घिनलाग्दा कुरा अर्थात् त्यसका व्यभिचारका अशुद्ध कुराहरूले भरिएको एउटा सुनको प्याला पक्रिएकी थिई। <verse eid="REV 17:4" /><verse number="5" style="v" sid="REV 17:5" />त्यसको निधारमा लेखिएको नाम एउटा रहस्य थियो:</para>
  <para style="pc" vid="REV 17:5">पृथ्वीका वेश्याहरू</para>
  <para style="pc" vid="REV 17:5">र घृणित कुराहरूकी आमा,</para>
  <para style="pc" vid="REV 17:5">महान् बेबिलोन।<verse eid="REV 17:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="REV 17:6" />मैले त्यस स्त्रीलाई सन्तहरूको रगतले अर्थात् येशूको गवाही दिनेहरूका रगतले मात्तिएकी देखेँ।</para>
  <para style="p" vid="REV 17:6">त्यसलाई देखेर म साह्रै अचम्मित भएँ। <verse eid="REV 17:6" /><verse number="7" style="v" sid="REV 17:7" />तब ती स्वर्गदूतले मलाई भने: “तिमी किन चकित पर्छौ? म तिमीलाई त्यस स्त्री र त्यसलाई बोकेर हिँड्ने त्यो सात शिर र दश सिङ भएको पशुको रहस्य बताइदिनेछु। <verse eid="REV 17:7" /><verse number="8" style="v" sid="REV 17:8" />तिमीले देखेको त्यो पशु कुनै समय थियो, तर अहिले छैन, र विनाशमा जानलाई अतल कुण्डबाट माथि निस्केर आउनेछ। संसारको उत्पत्तिदेखि जीवनको पुस्तकमा नाम नहुने पृथ्वीका बासिन्दाहरूले त्यस पशुलाई देखेर अचम्म मान्‍नेछन्; किनकि त्यो कुनै समय थियो, अब छैन, तर फेरि पछि आउनेछ।<verse eid="REV 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 17:9" />“बुद्धि भएको दिमाग यस्तै बेला चाहिने हो। ती सात शिरहरू सात वटा पर्वतहरू हुन्, जसमाथि त्यो स्त्री बस्छे। <verse eid="REV 17:9" /><verse number="10" style="v" sid="REV 17:10" />तिनीहरू सात जना राजाहरू पनि हुन्। पाँच जनाको पतन भइसकेको छ, एक जना छँदैछ, अर्कोचाहिँ अझ आइपुगेको छैन; तर जब त्यो आउँछ, उसको शासन केही समयको लागि रहनुपर्छ। <verse eid="REV 17:10" /><verse number="11" style="v" sid="REV 17:11" />त्यो रातो पशु, जो एक समय थियो, र अहिले छैन, त्योचाहिँ आठौँ राजा हो। त्यो सातमध्येको एक जना हो, र त्यसको सर्वनाश हुनेछ।<verse eid="REV 17:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 17:12" />“तिमीले देखेका ती दश सिङहरू दश राजाहरू हुन्, जसले अझसम्म राज्य पाएका छैनन्, तर तिनीहरूले त्यस पशुसित एक घण्टाको निम्ति राजाको झैँ अख्तियार पाउनेछन्। <verse eid="REV 17:12" /><verse number="13" style="v" sid="REV 17:13" />तिनीहरूको लक्ष्य एउटै हुनेछ; अनि तिनीहरूले आफ्ना शक्ति र अख्तियार त्यस पशुलाई दिनेछन्। <verse eid="REV 17:13" /><verse number="14" style="v" sid="REV 17:14" />तिनीहरूले थुमाको विरुद्धमा लडाइँ गर्नेछन्, तर थुमाले तिनीहरूलाई जित्नुहुनेछ; किनकि उहाँ प्रभुहरूका प्रभु र राजाहरूका राजा हुनुहुन्छ; अनि उहाँसित उहाँद्वारा बोलाइएका र चुनिएका विश्‍वासयोग्य अनुयायीहरू हुनेछन्।”<verse eid="REV 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 17:15" />तब स्वर्गदूतले मलाई भने, “तिमीले देखेका ती पानीहरू, जसमाथि त्यो वेश्या बस्छे, त्यो भनेको मानिस जातिहरू, भीडहरू, राष्ट्रहरू र भाषाहरू हुन्। <verse eid="REV 17:15" /><verse number="16" style="v" sid="REV 17:16" />तिमीले देखेको त्यो पशु र दश सिङहरूले त्यस वेश्यालाई घृणा गर्नेछन्। तिनीहरूले त्यसलाई नष्‍ट गर्नेछन् र नाङ्गो पार्नेछन्; तिनीहरूले त्यसको मासु खानेछन् र आगोले जलाइदिनेछन्। <verse eid="REV 17:16" /><verse number="17" style="v" sid="REV 17:17" />उहाँको वचन पूरा नहोउन्जेल तिनीहरूले त्यस पशुलाई आफ्ना राजकीय अख्तियार देऊन् भनी परमेश्‍वरले तिनीहरूका हृदयमा हालिदिनुभयो। यो नै परमेश्‍वरको उद्देश्य पूरा हुनु हो। <verse eid="REV 17:17" /><verse number="18" style="v" sid="REV 17:18" />तिमीले देखेकी स्त्रीचाहिँ पृथ्वीका राजाहरूमाथि शासन गर्ने महानगरी हो।”<verse eid="REV 17:18" /></para>
  <chapter eid="REV 17" />
  <chapter number="18" style="c" sid="REV 18" />
  <para style="s1">बेबिलोनको पतन</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 18:1" />यसपछि मैले अर्को स्वर्गदूतलाई स्वर्गबाट तल आइरहेको देखेँ। तिनीसित ठूलो अख्तियार थियो; अनि तिनको वैभवले पृथ्वी उज्यालो भयो। <verse eid="REV 18:1" /><verse number="2" style="v" sid="REV 18:2" />तिनले ठूलो सोरमा यसो भनेर कराए:</para>
  <para style="q1" vid="REV 18:2">“ ‘पतन भयो! महान् सहर बेबिलोनको पतन भयो!’<note caller="+" style="f"><char style="fr" closed="false">18:2 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 21:9">यशै 21:9</ref></char></char></note></para>
  <para style="q2" vid="REV 18:2">त्यो भूतहरूको घर भएको छ;</para>
  <para style="q1" vid="REV 18:2">अनि प्रत्येक अशुद्ध आत्माको अड्डा,</para>
  <para style="q2" vid="REV 18:2">प्रत्येक अशुद्ध चराको अड्डा भएको छ।</para>
  <para style="q2" vid="REV 18:2">प्रत्येक अशुद्ध तथा घृणित जन्तुहरूको लुक्ने ठाउँ भएको छ।<verse eid="REV 18:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="REV 18:3" />किनकि सबै राष्ट्रहरूले</para>
  <para style="q2" vid="REV 18:3">त्यसको अशुद्ध कामवासनाको मद्य पिएर मातेका छन्।</para>
  <para style="q1" vid="REV 18:3">पृथ्वीका राजाहरूले त्यससित व्यभिचार गरेका छन्;</para>
  <para style="q2" vid="REV 18:3">अनि पृथ्वीका व्यापारीहरू त्यसको अत्याधिक विलासिताको प्रभावले धनी भएका छन्।”<verse eid="REV 18:3" /></para>
  <para style="s1">बेबिलोनको न्यायबाट उम्कन चेतावनी</para>
  <para style="p">
    <verse number="4" style="v" sid="REV 18:4" />तब मैले स्वर्गबाट यसो भनिरहेको अर्को आवाज सुनेँ:</para>
  <para style="q1" vid="REV 18:4">“ ‘हे मेरा मानिसहरू हो, त्यसबाट निस्केर आओ,’<note caller="+" style="f"><char style="fr" closed="false">18:4 </char><char style="ft" closed="false"><char style="xt"><ref loc="JER 51:45">यर्मिया 51:45</ref></char></char></note></para>
  <para style="q2" vid="REV 18:4">ताकि तिमीहरूले त्यसका पापहरूको सहभागी हुन नपरोस्;</para>
  <para style="q2" vid="REV 18:4">अनि तिमीहरूमा त्यसका कुनै विपत्ति पनि नआओस्;<verse eid="REV 18:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="REV 18:5" />किनकि त्यसका पापहरू आकाशसम्मै थुप्रो लागेका छन्;</para>
  <para style="q2" vid="REV 18:5">अनि परमेश्‍वरले त्यसका अपराधहरू सम्झनुभएको छ।<verse eid="REV 18:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="REV 18:6" />त्यसले जे गरेकी थिई, त्यसलाई त्यही फर्काइदेओ;</para>
  <para style="q2" vid="REV 18:6">त्यसले जे गरेकी छ, त्यो दोबर गरी त्यसलाई देओ।</para>
  <para style="q2" vid="REV 18:6">त्यसले कचौरामा जे मिसाएकी थिई, त्यसको दोबर हुने गरी त्यसलाई देओ।<verse eid="REV 18:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="REV 18:7" />त्यो आफूले जति महिमा र भोग-विलास लुटी,</para>
  <para style="q2" vid="REV 18:7">त्यत्तिकै यातना र सन्ताप त्यसलाई देओ।</para>
  <para style="q1" vid="REV 18:7">आफ्नो हृदयमा त्यसले यसरी घमण्ड गर्छे,</para>
  <para style="q2" vid="REV 18:7">‘म रानीझैँ बसेकी छु;</para>
  <para style="q1" vid="REV 18:7">म विधवा होइनँ,</para>
  <para style="q2" vid="REV 18:7">र म कहिल्यै शोक गर्नेछैनँ।’<note caller="+" style="f"><char style="fr" closed="false">18:7 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 47:7">यशै 47:7</ref>, <ref loc="ISA 47:8">8</ref></char></char></note><verse eid="REV 18:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="REV 18:8" />यसकारण एकै दिनमा त्यसमाथि विपत्तिहरू आउनेछन्:</para>
  <para style="q2" vid="REV 18:8">मृत्यु, शोक र अनिकाल।</para>
  <para style="q1" vid="REV 18:8">त्यो आगोद्वारा भस्म पारिनेछे;</para>
  <para style="q2" vid="REV 18:8">किनकि त्यसलाई न्याय गर्ने परमप्रभु परमेश्‍वर सर्वशक्तिमान् हुनुहुन्छ।<verse eid="REV 18:8" /></para>
  <para style="s1">बेबिलोनको पतनमा विलाप</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 18:9" />“जब त्यससित व्यभिचार गर्ने र त्यसको भोग-विलासमा सहभागी हुने पृथ्वीका राजाहरूले त्यो जल्दैगरेको धुवाँ देख्नेछन्, तब तिनीहरू त्यसको लागि रुनेछन् र विलाप गर्नेछन्। <verse eid="REV 18:9" /><verse number="10" style="v" sid="REV 18:10" />त्यसको यातनाद्वारा भयभीत भएर तिनीहरू टाढै उभिएर चिच्याउनेछन्:</para>
  <para style="q1" vid="REV 18:10">“ ‘हाय! हाय, हे महानगरी,</para>
  <para style="q2" vid="REV 18:10">हे शक्तिशाली सहर बेबिलोन!</para>
  <para style="q1" vid="REV 18:10">एकै घण्टामा नै तेरो विनाश आयो!’<verse eid="REV 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 18:11" />“पृथ्वीका व्यापारीहरू त्यसको निम्ति रुनेछन् र विलाप गर्नेछन्; किनकि अब फेरि कसैले पनि त्यसबाट मालसामान किन्‍नेछैन। <verse eid="REV 18:11" /><verse number="12" style="v" sid="REV 18:12" />सुन, चाँदी, बहुमूल्य पत्थर र मोतीहरू, मसिनो मलमलको कपडा; बैजनी, रेशम र चहकिलो रातो रङ्गका कपडाहरू, हरेक किसिमका सुगन्धित काठ, र हरेक किसिमका हस्तीदन्तका सामग्रीहरू, बहुमूल्य काठ, काँसा, फलाम र संगमरमरका सामग्रीहरू, <verse eid="REV 18:12" /><verse number="13" style="v" sid="REV 18:13" />दालचिनी र मसला, सुगन्धित धूप, मूर्र, लोबान र मद्य र जैतुनको तेल, मसिनो पिठो, गहुँ, गाईबस्तु र भेडाहरू, घोडाहरू, रथहरू, मानव शरीर र मानिसका जीवनहरू।<verse eid="REV 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 18:14" />“तिनीहरूले भन्‍नेछन्, ‘तैँले चाहेका फलहरू तँदेखि गएका छन्। तेरा सबै विलासिता र वैभवहरू कहिल्यै नपाउने गरी बिलाइहालेका छन्।’ <verse eid="REV 18:14" /><verse number="15" style="v" sid="REV 18:15" />यी चीजहरू बेचेर त्यसबाट धनसम्पत्ति कमाउने ती व्यापारीहरू त्यसको यातनामा भयभीत भएर टाढै उभिनेछन्। तिनीहरू रुँदै, विलाप गर्दै, <verse eid="REV 18:15" /><verse number="16" style="v" sid="REV 18:16" />र चिच्याउँदै यसो भन्‍नेछन्:</para>
  <para style="q1" vid="REV 18:16">“ ‘हाय! हाय, हे महानगरी,</para>
  <para style="q2" vid="REV 18:16">जसले मसिनो मलमलको कपडा, बैजनी र चहकिलो रातो रङ्गको वस्त्र लगाएर</para>
  <para style="q2" vid="REV 18:16">सुनको चमक, बहुमूल्य पत्थर र मोतीहरू पहिरेकी थिई!<verse eid="REV 18:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="REV 18:17" />एकै घण्टामा यति धेरै सम्पत्ति नष्‍ट भए!’</para>
  <para style="p" vid="REV 18:17">“जहाजको हरेक सेनापति, र जहाजबाट यात्रा गर्ने सबै यात्रीहरू, नाविकहरू र समुद्रबाट जीविका चलाउनेहरू टाढा उभिनेछन्। <verse eid="REV 18:17" /><verse number="18" style="v" sid="REV 18:18" />जब तिनीहरूले त्यो स्त्री जल्दैगरेको धुवाँ देखे, तब तिनीहरू विलाप गर्दै कराउनेछन्, ‘के यस्तो महान् सहरजस्तै अरू सहर कहिल्यै थियो र?’ <verse eid="REV 18:18" /><verse number="19" style="v" sid="REV 18:19" />तिनीहरूले आ-आफ्नो टाउकोमा धुलो हाल्नेछन्, र रुवाइ र विलापकासाथ यसरी कराउनेछन्:</para>
  <para style="q1" vid="REV 18:19">“ ‘हाय! हाय, हे महानगरी,</para>
  <para style="q2" vid="REV 18:19">जसका समुद्रमा जहाज भएकाहरू</para>
  <para style="q2" vid="REV 18:19">त्यस स्त्रीको धनले धनी भएका छन्!</para>
  <para style="q1" vid="REV 18:19">एकै घण्टामा त्यो भस्म भएकी छे!’<verse eid="REV 18:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="REV 18:20" />“हे स्वर्ग, त्यसमाथि रमाओ!</para>
  <para style="q2" vid="REV 18:20">हे परमेश्‍वरका जनहरू,</para>
  <para style="q2" vid="REV 18:20">प्रेरितहरू र अगमवक्ताहरू हो, रमाओ!</para>
  <para style="q1" vid="REV 18:20">तिमीहरूसित त्यसले जस्तो व्यवहार गरेकी थिई,</para>
  <para style="q2" vid="REV 18:20">त्यसरी नै परमेश्‍वरले त्यसको न्याय गर्नुभएको छ।”<verse eid="REV 18:20" /></para>
  <para style="s1">बेबिलोनको अन्तिम पतन</para>
  <para style="p">
    <verse number="21" style="v" sid="REV 18:21" />तब त्यस सामर्थ्यी स्वर्गदूतले ठूलो जाँतोजस्तै एउटा ढुङ्गा उठाए, र यसो भन्दै त्यसलाई समुद्रमा फ्याँकिदिए:</para>
  <para style="q1" vid="REV 18:21">“यसरी नै बेगसित</para>
  <para style="q2" vid="REV 18:21">महान् सहर बेबिलोन तल फालिनेछ,</para>
  <para style="q2" vid="REV 18:21">र त्यो कहिल्यै फेला पर्नेछैन।<verse eid="REV 18:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="REV 18:22" />सङ्गीतकारहरू, वीणा बजाउनेहरू, बाँसुरी बजाउनेहरू र तुरही बजाउनेहरूका सङ्गीत</para>
  <para style="q2" vid="REV 18:22">तँमा फेरि कहिल्यै सुनिनेछैन।</para>
  <para style="q1" vid="REV 18:22">तँमा फेरि कुनै व्यापारको शिल्पकार</para>
  <para style="q2" vid="REV 18:22">कहिल्यै पाइनेछैन।</para>
  <para style="q1" vid="REV 18:22">तँमा फेरि जाँतोको आवाज</para>
  <para style="q2" vid="REV 18:22">कहिल्यै सुनिनेछैन।<verse eid="REV 18:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="REV 18:23" />बत्तीको उज्यालो</para>
  <para style="q2" vid="REV 18:23">तँमा फेरि कहिल्यै चम्कनेछैन।</para>
  <para style="q1" vid="REV 18:23">दुलहा र दुलहीको सोर</para>
  <para style="q2" vid="REV 18:23">तँमा फेरि कहिल्यै सुनिनेछैन।</para>
  <para style="q1" vid="REV 18:23">तेरा व्यापारीहरू संसारका महान् व्यक्तिहरू थिए।</para>
  <para style="q2" vid="REV 18:23">तेरा तन्त्रमन्त्रले राष्ट्रहरू बहकिएका थिए।<verse eid="REV 18:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="REV 18:24" />त्यस स्त्रीमा अगमवक्ताहरू, परमेश्‍वरका पवित्र जनहरू,</para>
  <para style="q2" vid="REV 18:24">र पृथ्वीमा मारिएकाहरू सबैको रगत पाइएको थियो।”<verse eid="REV 18:24" /></para>
  <chapter eid="REV 18" />
  <chapter number="19" style="c" sid="REV 19" />
  <para style="s1">स्वर्गमा विजयका गीतहरू</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 19:1" />यसपछि मैले स्वर्गमा एउटा ठूलो भीडले यसरी चिच्याएको सोर सुनेँ:</para>
  <para style="q1" vid="REV 19:1">“हल्‍लेलूयाह!</para>
  <para style="q1" vid="REV 19:1">मुक्ति, महिमा र शक्ति हाम्रा परमेश्‍वरका हुन्;<verse eid="REV 19:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="REV 19:2" />किनकि उहाँका न्यायहरू सत्य र न्यायपूर्ण छन्।</para>
  <para style="q1" vid="REV 19:2">आफ्ना व्यभिचारद्वारा पृथ्वीलाई भ्रष्‍ट पार्ने</para>
  <para style="q2" vid="REV 19:2">त्यस महावेश्यालाई उहाँले दण्ड दिनुभएको छ।</para>
  <para style="q1" vid="REV 19:2">अनि परमेश्‍वरले त्यससित आफ्ना सेवकहरूका रगतको बदला लिइसक्नुभएको छ।”<verse eid="REV 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 19:3" />अनि तिनीहरू फेरि चिच्याए:</para>
  <para style="q1" vid="REV 19:3">“हल्‍लेलूयाह!</para>
  <para style="q1" vid="REV 19:3">त्यस स्त्रीबाट निस्केको न्यायको धुवाँ सदासर्वदाको लागि उँभोतिर गइरहन्छ।”<verse eid="REV 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 19:4" />ती चौबीस प्रधानहरू र ती चार जीवित प्राणीहरूले घोप्टो परेर सिंहासनमा बस्‍नुहुने परमेश्‍वरलाई आराधना गरे। अनि तिनीहरू यसो भन्दै कराए:</para>
  <para style="q1" vid="REV 19:4">“आमेन, हल्‍लेलूयाह!”<verse eid="REV 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 19:5" />तब सिंहासनबाट यसो भनिरहेको एउटा आवाज आयो:</para>
  <para style="q1" vid="REV 19:5">“हे उहाँका सबै सेवकहरू हो,</para>
  <para style="q2" vid="REV 19:5">तिमीहरू जो उहाँसित डराउँछौ,</para>
  <para style="q1" vid="REV 19:5">साना र ठूलाहरू दुवै,</para>
  <para style="q2" vid="REV 19:5">हाम्रा परमेश्‍वरलाई प्रशंसा गर।”<verse eid="REV 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 19:6" />तब एउटा ठूलो भीडको जस्तो, पानीको बेगजस्तो आवाज र मेघ गर्जनको आवाजजस्तो यसरी चिच्याएको मैले सुनेँ:</para>
  <para style="q1" vid="REV 19:6">“हल्‍लेलूयाह!</para>
  <para style="q2" vid="REV 19:6">किनकि हाम्रा सर्वशक्तिमान् परमप्रभु परमेश्‍वरले राज्य गर्नुहुन्छ,<verse eid="REV 19:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="REV 19:7" />हामी आनन्द मनाऔँ, खुशी होऔँ,</para>
  <para style="q2" vid="REV 19:7">र उहाँलाई महिमा दिऔँ!</para>
  <para style="q1" vid="REV 19:7">किनकि थुमाको विवाहको बेला आइपुगेको छ;</para>
  <para style="q2" vid="REV 19:7">अनि उहाँकी दुलहीले आफूलाई तयार पारेकी छिन्।<verse eid="REV 19:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="REV 19:8" />तिनलाई चहकिलो र स्वच्छ मलमलको कपडा</para>
  <para style="q2" vid="REV 19:8">पहिरनलाई दिइएको थियो।”</para>
  <para style="m" vid="REV 19:8">(मसिनो मलमलको कपडाले सन्तहरूको धार्मिक कार्यलाई जनाउँछ।)<verse eid="REV 19:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="REV 19:9" />अनि ती स्वर्गदूतले मलाई भने, “यो लेख: ‘थुमाको विवाहको भोजको निम्तो पाउनेहरू धन्यका हुन्!’ ” अनि तिनले अझ थपेर भने, “यी परमेश्‍वरका सत्य वचनहरू हुन्।”<verse eid="REV 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 19:10" />अनि म तिनको पाउमा दण्डवत् गर्नलाई घोप्टो परेँ। तर तिनले मलाई भने, “यसो नगर! म येशूको गवाही कायम राख्ने तिमी र तिम्रा दाजुभाइ-दिदीबहिनीहरूझैँ एक जना सङ्गी-सेवक हुँ। परमेश्‍वरको मात्र आराधना गर! किनकि अगमवाणीका आत्माले नै येशूको गवाही बोकेका छन्।”<verse eid="REV 19:10" /></para>
  <para style="s1">सेतो घोडामा सवार हुनुहुने</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 19:11" />मैले स्वर्ग उघ्रिएको देखेँ, र मेरो सामु एउटा सेतो घोडा थियो, जसको सवारलाई विश्‍वासयोग्य र सत्य भनिन्छ। उहाँले निष्पक्षसित न्याय र लडाइँ गर्नुहुन्छ। <verse eid="REV 19:11" /><verse number="12" style="v" sid="REV 19:12" />उहाँका आँखाहरू बल्दैगरेको आगोजस्ता छन्, र उहाँका शिरमा धेरै मुकुटहरू छन्। उहाँमा एउटा नाम लेखिएको छ, जो उहाँबाहेक अरू कसैले जान्दैन। <verse eid="REV 19:12" /><verse number="13" style="v" sid="REV 19:13" />उहाँले रगतमा चोपिएको एउटा पोशाक पहिरिनुभएको छ; अनि उहाँको नाम परमेश्‍वरको वचन हो। <verse eid="REV 19:13" /><verse number="14" style="v" sid="REV 19:14" />सेता घोडाहरूमा सवार भएका, मिहिन सेता र स्वच्छ मलमलको वस्त्र पहिरेका स्वर्गीय सेनाहरूले उहाँलाई पछ्याइरहेका थिए। <verse eid="REV 19:14" /><verse number="15" style="v" sid="REV 19:15" />राष्ट्रहरूलाई प्रहार गर्न उहाँको मुखबाट एउटा धारिलो तरवार निस्केको छ। “उहाँले फलामको राजदण्डले तिनीहरूमाथि शासन गर्नुहुनेछ।”<note caller="+" style="f"><char style="fr" closed="false">19:15 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 2:9">भजन 2:9</ref></char></char></note> उहाँले सर्वशक्तिमान् परमेश्‍वरको क्रोधको मद्यको कोल कुल्चनुहुनेछ। <verse eid="REV 19:15" /><verse number="16" style="v" sid="REV 19:16" />उहाँको वस्त्र र तिघ्रामा यो नाम लेखिएको छ:</para>
  <para style="pc" vid="REV 19:16">राजाहरूका राजा र प्रभुहरूका प्रभु।<verse eid="REV 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 19:17" />अनि मैले एक जना स्वर्गदूतलाई सूर्यमा उभिरहेका देखेँ, जसले आकाशको बीचमा उडिरहेका चराहरूलाई चर्को सोरमा भनिरहेका थिए, “आओ, परमेश्‍वरको ठूलो भोजको लागि एकसाथ भेला होओ; <verse eid="REV 19:17" /><verse number="18" style="v" sid="REV 19:18" />अनि तिमीहरूले राजाहरू, सेनापतिहरू, शक्तिशाली योद्धाहरू, घोडाहरू, त्यसका सवारहरू, स्वतन्त्र र सेवक-सेविकाहरू, ठूला-सानाहरू सबैका मासु खान पाउनेछौ।”<verse eid="REV 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 19:19" />तब मैले त्यो पशु, पृथ्वीका राजाहरू, र तिनीहरूका सेनाहरूलाई त्यस घोडामाथि सवार हुनुहुने र उहाँका सेनाहरूसित युद्ध गर्नलाई एकसाथ भेला भएको देखेँ। <verse eid="REV 19:19" /><verse number="20" style="v" sid="REV 19:20" />तर त्यो पशु पक्राउ पर्‍यो, र त्योसँगै त्यसको पक्षमा अचम्मका शक्तिशाली कामहरू गर्ने त्यो झूटा अगमवक्ता पनि, जसले यी अलौकिक चिन्हहरूद्वारा पशुको छाप लगाउने र त्यसको मूर्तिलाई आराधना गर्नेहरूलाई बहकाएको थियो। ती दुवै जलिरहेको गन्धकको अग्निकुण्डमा जिउँदै फालिए। <verse eid="REV 19:20" /><verse number="21" style="v" sid="REV 19:21" />अरू बाँकी रहेकाहरूचाहिँ घोडामा सवार हुनुहुनेको मुखबाट निस्केको तरवारद्वारा मारिए; अनि सबै चराहरूले तिनीहरूको मासु लुछ्दै खाए र अघाए।<verse eid="REV 19:21" /></para>
  <chapter eid="REV 19" />
  <chapter number="20" style="c" sid="REV 20" />
  <para style="s1">एक हजार वर्ष</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 20:1" />त्यसपछि मैले एक जना स्वर्गदूतलाई स्वर्गबाट निस्केर तल आइरहेको देखेँ। तिनको हातमा अतल कुण्डको साँचो र एउटा ठूलो साङ्लो थियो <verse eid="REV 20:1" /><verse number="2" style="v" sid="REV 20:2" />तिनले त्यस अजिङ्गर अर्थात् त्यो पुरानो सर्प, जो दियाबलस वा शैतान हो, त्यसलाई पक्रेर एक हजार वर्षसम्म बाँधेर राखे। <verse eid="REV 20:2" /><verse number="3" style="v" sid="REV 20:3" />तिनले त्यसलाई त्यस नरक कुण्डमा फालिदिए; अनि एक हजार वर्ष नबितुन्जेल राष्ट्रहरूलाई नछलोस् भनेर त्यो अतल कुण्ड बन्द गरी त्यसमाथि छाप लगाइदिए। त्यसपछि केही समयको लागि त्यसलाई फुक्‍का गरिनुपर्छ।<verse eid="REV 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 20:4" />तब मैले सिंहासनहरू देखेँ; अनि ती सिंहासनहरूमा मैले न्याय गर्ने अख्तियार पाएकाहरूलाई बसिरहेको देखेँ। अनि मैले येशूको गवाहीको निम्ति र परमेश्‍वरको वचनको निम्ति शिर काटिएकाहरूका आत्माहरूलाई देखेँ। तिनीहरूले त्यस पशु वा त्यसको मूर्तिको आराधना गरेका थिएनन्; अनि आफ्ना निधारहरू र हातहरूमा त्यसको छाप लगाएका थिएनन्। तिनीहरू फेरि जीवित भए, र ख्रीष्‍टसित एक हजार वर्षसम्म राज्य गरे। <verse eid="REV 20:4" /><verse number="5" style="v" sid="REV 20:5" />(अरू बाँकी मरेकाहरूचाहिँ एक हजार वर्ष नबितुन्जेल जीवित भएनन्।) यो पहिलो पुनरुत्थान हो। <verse eid="REV 20:5" /><verse number="6" style="v" sid="REV 20:6" />पहिलो पुनरुत्थानमा सहभागी हुनेहरू धन्य र पवित्र हुन्। तिनीहरूमाथि दोस्रो मृत्युको शक्तिले केही अधिकार गर्न सक्दैन, तर तिनीहरू परमेश्‍वरका र ख्रीष्‍टका पुजारीहरू हुनेछन्, र उहाँसित एक हजार वर्षसम्म राज्य गर्नेछन्।<verse eid="REV 20:6" /></para>
  <para style="s1">शैतानको अन्तिम सर्वनाश</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 20:7" />एक हजार वर्ष बितेपछि त्यो शैतानलाई त्यसको कैदबाट छोडिनेछ; <verse eid="REV 20:7" /><verse number="8" style="v" sid="REV 20:8" />अनि पृथ्वीका चारै दिशामा भएका राष्ट्रहरूलाई अर्थात् गोग र मागोगलाई लडाइँको लागि बहकाउन र भेला गर्न त्यो निस्केर जानेछ। संख्यामा तिनीहरू समुद्रको किनारमा भएका बालुवा जतिकै हुनेछन्। <verse eid="REV 20:8" /><verse number="9" style="v" sid="REV 20:9" />तिनीहरूले पृथ्वीको परिक्रमा गरेर परमेश्‍वरका जातिका छाउनी अर्थात् उहाँको प्रिय सहरलाई घेरा हाले। तर स्वर्गबाट आगो बर्सेर तिनीहरूलाई भस्म पार्‍यो। <verse eid="REV 20:9" /><verse number="10" style="v" sid="REV 20:10" />अनि तिनीहरूलाई ठग्ने त्यो दियाबलसलाई, गन्धक जल्दैगरेको अग्निकुण्डमा फालियो, जहाँ त्यो पशु र झूटा अगमवक्ता पनि फालिएका थिए। त्यहाँ तिनीहरूले दिनरात सदासर्वदा यातना भोग्नेछन्।<verse eid="REV 20:10" /></para>
  <para style="s1">मृतकहरूको न्याय</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 20:11" />तब मैले एउटा ठूलो सेतो सिंहासन र त्यसमाथि विराजमान हुनुहुनेलाई देखेँ। पृथ्वी र आकाश उहाँको उपस्थितिबाट बिलाएर गए; अनि तिनीहरू कतै पाइएनन्। <verse eid="REV 20:11" /><verse number="12" style="v" sid="REV 20:12" />अनि मैले ठूला र साना सबै मृतकहरूलाई सिंहासनको सामु उभिरहेका देखेँ, र पुस्तकहरू खोलिए। अर्को एउटा पुस्तक पनि खोलियो, जुनचाहिँ जीवनको पुस्तक हो। ती पुस्तकहरूमा लेखिएका तिनीहरूका कामका आधारमा मृतकहरूको न्याय गरियो। <verse eid="REV 20:12" /><verse number="13" style="v" sid="REV 20:13" />समुद्रले त्यससित भएका मुर्दाहरू दिइहाल्यो, र मृत्यु र पातालले पनि तिनीहरूमा भएका मुर्दाहरू दिइहाले; अनि प्रत्येकले गरेका कामअनुसार तिनीहरूलाई न्याय गरियो। <verse eid="REV 20:13" /><verse number="14" style="v" sid="REV 20:14" />मृत्यु र पाताल अग्निकुण्डमा फालिए। त्यो अग्निकुण्ड दोस्रो मृत्यु हो। <verse eid="REV 20:14" /><verse number="15" style="v" sid="REV 20:15" />जसको नाम जीवनको पुस्तकमा लेखिएको भेट्टाइएन, त्यसलाई अग्निकुण्डमा फालियो।<verse eid="REV 20:15" /></para>
  <chapter eid="REV 20" />
  <chapter number="21" style="c" sid="REV 21" />
  <para style="s1">नयाँ आकाश र नयाँ पृथ्वी</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 21:1" />तब मैले “एउटा नयाँ आकाश र एउटा नयाँ पृथ्वी देखेँ;”<note caller="+" style="f"><char style="fr" closed="false">21:1 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 65:17">यशै 65:17</ref></char></char></note> किनकि पहिलो आकाश र पहिलो पृथ्वी त बितिसकेका थिए; अनि त्यहाँ समुद्र पनि थिएन। <verse eid="REV 21:1" /><verse number="2" style="v" sid="REV 21:2" />अनि मैले पवित्र सहर अर्थात् नयाँ यरूशलेमलाई आफ्ना पतिको निम्ति दुलहीझैँ सिँगारिएर स्वर्गदेखि परमेश्‍वरबाट तल झरिरहेको देखेँ। <verse eid="REV 21:2" /><verse number="3" style="v" sid="REV 21:3" />तब मैले सिंहासनबाट चर्को सोरले यसो भनिरहेको सुनेँ, “हेर! अब परमेश्‍वरको बास मानिसहरूसित भएको छ, र उहाँ तिनीहरूसित बस्‍नुहुनेछ। तिनीहरू उहाँका प्रजा हुनेछन्, र परमेश्‍वर आफैँ नै तिनीहरूसित तिनीहरूका परमेश्‍वर हुनुहुनेछ। <verse eid="REV 21:3" /><verse number="4" style="v" sid="REV 21:4" />उहाँले तिनीहरूका आँखाबाट सबै आँसु पुछिदिनुहुनेछ। अब फेरि त्यहाँ न मृत्यु, न शोक, न विलाप अथवा न कष्‍ट नै हुनेछ; किनकि पुराना कुराहरू बितिसकेका छन्।”<note caller="+" style="f"><char style="fr" closed="false">21:4 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 25:8">यशै 25:8</ref></char></char></note><verse eid="REV 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 21:5" />सिंहासनमा विराजमान हुनुहुनेले भन्‍नुभयो, “म सबै थोक नयाँ बनाउँछु!” तब उहाँले भन्‍नुभयो, “यी वचनहरू लेख; किनकि यी वचनहरू विश्‍वासयोग्य र सत्य छन्।”<verse eid="REV 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 21:6" />उहाँले मलाई भन्‍नुभयो, “अब सिद्धियो। म नै अल्फा र ओमेगा हुँ; आदि र अन्त्य म नै हुँ। जो तिर्खाउँछ, म त्यसलाई जीवनको पानीको मूलबाट पिउनलाई सित्तैँमा दिनेछु। <verse eid="REV 21:6" /><verse number="7" style="v" sid="REV 21:7" />जो विजयी हुन्छन्, तिनीहरू सबैले उत्तराधिकार पाउनेछन्; अनि म तिनीहरूका परमेश्‍वर र तिनीहरू मेरा सन्तान हुनेछन्। <verse eid="REV 21:7" /><verse number="8" style="v" sid="REV 21:8" />तर डरपोकहरू, अविश्‍वासीहरू, घिनलाग्दा काम गर्नेहरू, हत्याराहरू, अनैतिक यौन सम्बन्ध राख्नेहरू, तन्त्रमन्त्र गर्नेहरू, मूर्तिपूजकहरू र सबै झूटाहरूको ठाउँ गन्धक जलिरहेको अग्निकुण्ड हुनेछ। यो दोस्रो मृत्यु हो।”<verse eid="REV 21:8" /></para>
  <para style="s1">नयाँ यरूशलेम, थुमाको दुलही</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 21:9" />सात वटा अन्तिम विपत्तिहरूले भरिएका सात वटा कचौरा लिएका सात स्वर्गदूतहरूमध्ये एक जनाले मकहाँ आएर यसो भने, “आऊ, म तिमीलाई थुमाकी पत्नी हुन गइरहेकी दुलहीलाई देखाउनेछु।” <verse eid="REV 21:9" /><verse number="10" style="v" sid="REV 21:10" />अनि तिनले मलाई आत्मामा एउटा ठूलो र अग्लो पर्वतमा लगे, र परमेश्‍वरबाट स्वर्गदेखि तल झरिरहेको पवित्र सहर यरूशलेम देखाए। <verse eid="REV 21:10" /><verse number="11" style="v" sid="REV 21:11" />त्यो परमेश्‍वरको महिमाले चम्किरहेको थियो; त्यसको चमक बहुमूल्य रत्नहरू, बिल्‍लौर र स्फटिकजस्तो सफा थियो। <verse eid="REV 21:11" /><verse number="12" style="v" sid="REV 21:12" />त्यसको विशाल र अग्लो पर्खाल थियो, जसमा बाह्र वटा मूलढोकाहरू थिए, र प्रत्येक ढोकामा एक-एक स्वर्गदूत थिए। ती प्रत्येक ढोकामा एक-एक कुलका नाम गरेर इस्राएलका बाह्र कुलका नाम लेखिएका थिए। <verse eid="REV 21:12" /><verse number="13" style="v" sid="REV 21:13" />पूर्वमा तीन वटा, उत्तरमा तीन वटा, दक्षिणमा तीन वटा र पश्‍चिममा तीन वटा ढोकाहरू थिए। <verse eid="REV 21:13" /><verse number="14" style="v" sid="REV 21:14" />सहरका पर्खालमा बाह्र वटा शिलाहरूका जग थिए, र तिनीहरूमा थुमाका बाह्र प्रेरितहरूका नामहरू थिए।<verse eid="REV 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 21:15" />मसित बोल्ने स्वर्गदूतसित सहर, ढोकाहरू र त्यसका पर्खालहरू नाप्‍ने सुनको लट्ठी थियो। <verse eid="REV 21:15" /><verse number="16" style="v" sid="REV 21:16" />त्यो सहर वर्गाकार थियो; त्यसको लम्बाइ र चौडाइ बराबर थियो। तिनले त्यस लट्ठीले सहरहरूलाई नापे, र त्यो दुई हजार दुई सय किलोमिटर पाए। त्यसको लम्बाइ, चौडाइ र उचाइ एकसमान थियो। <verse eid="REV 21:16" /><verse number="17" style="v" sid="REV 21:17" />स्वर्गदूतले मानिसको नापअनुसार त्यो पर्खाल पनि नापे; त्यो पैँसट्ठी मिटर मोटो थियो। <verse eid="REV 21:17" /><verse number="18" style="v" sid="REV 21:18" />त्यो पर्खाल बिल्‍लौरले बनिएको थियो; अनि सहरचाहिँ निखुर सुनले बनिएको थियो, जुनचाहिँ काँचजस्तै निखुर थियो। <verse eid="REV 21:18" /><verse number="19" style="v" sid="REV 21:19" />सहरको पर्खालका जगहरू प्रत्येक किसिमका बहुमूल्य पत्थरले सिँगारिएका थिए। पहिलो जग बिल्‍लौर, दोस्रो नीलमणि, तेस्रो लालमणि, चौथो पन्‍ना; <verse eid="REV 21:19" /><verse number="20" style="v" sid="REV 21:20" />पाँचौँ सार्डियसमणि, छैटौँ गोमेद, सातौँ पीतमणि, आठौँ फिरोजा, नवौँ पुष्पराग, दशौँ हरितमणि, एघारौँ धूम्रकान्त र बाह्रौँचाहिँ मर्तिसमणि थियो। <verse eid="REV 21:20" /><verse number="21" style="v" sid="REV 21:21" />ती बाह्र ढोकाहरू बाह्र मोती थिए; प्रत्येक ढोका एउटै मोतीले बनिएको थियो। सहरका ठूला सडकचाहिँ छर्लङ्गै देखिने काँचजस्तै निखुर सुनको थियो।<verse eid="REV 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="REV 21:22" />मैले सहरमा कुनै मन्दिर देखिनँ; किनकि सर्वशक्तिमान् परमप्रभु परमेश्‍वर र थुमा नै त्यसको मन्दिर हुनुहुन्छ। <verse eid="REV 21:22" /><verse number="23" style="v" sid="REV 21:23" />त्यस सहरमा उज्यालो दिनको लागि घाम र चन्द्रमाको आवश्यकता थिएन; किनकि परमेश्‍वरको महिमाले त्यसलाई प्रकाश दिन्छ, र थुमा नै त्यसको बत्ती हुनुहुन्छ। <verse eid="REV 21:23" /><verse number="24" style="v" sid="REV 21:24" />त्यहाँकै प्रकाशमा राष्ट्रहरू हिँड्‍डुल गर्नेछन्, र पृथ्वीका राजाहरू आफ्ना वैभवसहित त्यस सहरमा प्रवेश गर्नेछन्। <verse eid="REV 21:24" /><verse number="25" style="v" sid="REV 21:25" />त्यसका ढोकाहरू कहिल्यै बन्द हुनेछैनन्; किनकि त्यहाँ कहिल्यै रात हुनेछैन। <verse eid="REV 21:25" /><verse number="26" style="v" sid="REV 21:26" />सबै राष्ट्रहरूका महिमा र सम्मान त्यसमा ल्याइनेछन्। <verse eid="REV 21:26" /><verse number="27" style="v" sid="REV 21:27" />त्यसमा कुनै अशुद्ध कुरा पस्‍न पाउनेछैन, न त शर्मका र छलका काम गर्ने कोही पस्‍न पाउँनेछ; तर तिनीहरूले मात्र प्रवेश पाउनेछन्, जसको नाम थुमाको जीवनको पुस्तकमा लेखिएका छन्।<verse eid="REV 21:27" /></para>
  <chapter eid="REV 21" />
  <chapter number="22" style="c" sid="REV 22" />
  <para style="s1">जीवनको पानीको नदी</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 22:1" />तब त्यस स्वर्गदूतले मलाई परमेश्‍वर र थुमाको सिंहासनबाट बग्दै निस्केको स्फटिकजस्तो स्वच्छ जीवनको पानीको नदी देखाए, <verse eid="REV 22:1" /><verse number="2" style="v" sid="REV 22:2" />जुनचाहिँ सहरको मूल बाटोको बीचबाट बगिरहेको थियो। नदीका दुवैतिर प्रत्येक महिना बाह्र किसिमका फलहरू फलाउने जीवनको रूख थियो। ती रूखहरूका पातहरूचाहिँ राष्ट्रहरूलाई निको पार्नको लागि हुन्। <verse eid="REV 22:2" /><verse number="3" style="v" sid="REV 22:3" />त्यहाँ अब उप्रान्त श्राप हुनेछैन; किनभने त्यस सहरमा परमेश्‍वरको र थुमाको सिंहासन हुनेछ; अनि उहाँका सेवकहरूले उहाँको सेवा गर्नेछन्। <verse eid="REV 22:3" /><verse number="4" style="v" sid="REV 22:4" />तिनीहरूले उहाँको अनुहार देख्नेछन्, र उहाँको नाम तिनीहरूका निधारमा हुनेछ। <verse eid="REV 22:4" /><verse number="5" style="v" sid="REV 22:5" />अब उप्रान्त रात हुनेछैन। तिनीहरूलाई बत्तीको उज्यालो र सूर्यको उज्यालोको आवश्यकता पर्नेछैन; किनकि प्रभु परमेश्‍वरले नै तिनीहरूलाई उज्यालो दिनुहुनेछ। अनि तिनीहरूले सदासर्वदा राज्य गर्नेछन्।<verse eid="REV 22:5" /></para>
  <para style="s1">यूहन्‍ना र स्वर्गदूत</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 22:6" />ती स्वर्गदूतले मलाई भने, “यी वचनहरू विश्‍वासयोग्य र सत्य छन्। परमप्रभु, जो अगमवक्ताहरूका आत्माका परमेश्‍वर हुनुहुन्छ, उहाँले उहाँका सेवकहरूलाई अब चाँडै हुन आउने कुराहरू देखाउनलाई आफ्ना स्वर्गदूत पठाउनुभएको छ।”<verse eid="REV 22:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="REV 22:7" />“हेर, म चाँडै आउँदैछु! यस पुस्तकका अगमवाणीका वचनहरू पालन गर्नेहरू धन्यका हुन्।”<verse eid="REV 22:7" /></para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" sid="REV 22:8" />यी कुराहरू सुन्‍ने र देख्ने म, स्वयम् यूहन्‍ना हुँ। अनि जब मैले यी सुनेँ र देखेँ, तब यी कुराहरू मलाई देखाइरहने स्वर्गदूतलाई आराधना गर्न भनेर म तिनको पाउमा घोप्टो परेँ। <verse eid="REV 22:8" /><verse number="9" style="v" sid="REV 22:9" />तर ती स्वर्गदूतले मलाई भने, “यसो नगर! म त तिमीजस्तै एक सङ्गी-सेवक हुँ। म तिम्रा सङ्गी-अगमवक्ता र यस पुस्तकका वचनहरू पालन गर्नेहरूजस्तै हुँ। परमेश्‍वरलाई मात्र दण्डवत् गर!”<verse eid="REV 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 22:10" />तब स्वर्गदूतले मलाई भने, “यस पुस्तकका अगमवाणीका वचनहरूमा छाप नलगाऊ; किनकि अगमवाणी पूरा हुने समय नजिकै छ। <verse eid="REV 22:10" /><verse number="11" style="v" sid="REV 22:11" />जसले खराबी गर्छ, त्यसले खराबी नै गरिरहोस्; जो अश्लील छ, त्यो अश्लीलै रहोस्; जो ठिक छ, त्यसले ठिकै गरिरहोस्; अनि जो पवित्र छ, त्यो पवित्र नै भइरहोस्।”<verse eid="REV 22:11" /></para>
  <para style="b" />
  <para style="s1">उपसंहार: निमन्त्रणा र चेतावनी</para>
  <para style="p">
    <verse number="12" style="v" sid="REV 22:12" />“हेर, म चाँडै आउँदैछु! मेरो पुरस्कार मसित छ, र म प्रत्येकलाई उसले गरेको कामअनुसार दिनेछु। <verse eid="REV 22:12" /><verse number="13" style="v" sid="REV 22:13" />म नै अल्फा र ओमेगा, पहिलो र पछिल्‍लो, आदि र अन्त्य हुँ।<verse eid="REV 22:13" /></para>
  <para style="b" />
  <para style="p">
    <verse number="14" style="v" sid="REV 22:14" />“जीवनको रूखको अधिकार पाउन र सहरका ढोकाहरू भित्र पस्‍न पाऊँ भनेर आफ्ना वस्त्र शुद्ध<note caller="+" style="f"><char style="fr" closed="false">22:14 </char><char style="ft" closed="false">मूल भाषामा </char><char style="fqa" closed="false">धुनु</char></note> राख्नेहरू धन्यका हुन्। <verse eid="REV 22:14" /><verse number="15" style="v" sid="REV 22:15" />बाहिरचाहिँ कुकुरहरू; तन्त्रमन्त्र गर्नेहरू, अनैतिक यौन सम्बन्ध राख्नेहरू, हत्याराहरू, मूर्तिपूजकहरू र झूट मन पराउने र त्यसैअनुसार चल्नेहरू हुन्छन्।<verse eid="REV 22:15" /></para>
  <para style="b" />
  <para style="p">
    <verse number="16" style="v" sid="REV 22:16" />“म येशूले मण्डलीहरूलाई यो गवाही दिनू भनी मेरो दूतलाई तिमीकहाँ पठाएको छु। म दावीदको मूल र सन्तान, र बिहानको चहकिलो तारा हुँ।”<verse eid="REV 22:16" /></para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" sid="REV 22:17" />आत्मा र दुलही भन्‍नुहुन्छ, “आउनुहोस्!” अनि जसले सुन्छ, त्यसले भनोस्, “आउनुहोस्!” जो तिर्खाएको छ, त्यो आओस्; अनि जसले इच्छा गर्छ, त्यसले जीवनको पानी सित्तैँमा लेओस्।<verse eid="REV 22:17" /></para>
  <para style="b" />
  <para style="p">
    <verse number="18" style="v" sid="REV 22:18" />म यस पुस्तकमा भएका अगमवाणीका वचनहरू सुन्‍ने हरेकलाई चेतावनी दिन्छु: यदि कसैले यी वचनहरूमा केही थप्यो भने परमेश्‍वरले त्यसमाथि यस पुस्तकमा वर्णन गरिएका विपत्तिहरू थपिदिनुहुनेछ। <verse eid="REV 22:18" /><verse number="19" style="v" sid="REV 22:19" />यदि कसैले यस अगमवाणीका पुस्तकबाट वचनहरू हटाउँछ भने परमेश्‍वरले यस पुस्तकमा वर्णन गरिएका जीवनको रूखमा र पवित्र सहरमा भएको त्यसको भाग हटाइदिनुहुनेछ।<verse eid="REV 22:19" /></para>
  <para style="b" />
  <para style="p">
    <verse number="20" style="v" sid="REV 22:20" />यी सबै कुराहरूको साक्षी दिनुहुनेले भन्‍नुहुन्छ, “हेर, म चाँडै आउँदैछु!”</para>
  <para style="p" vid="REV 22:20">आमेन! आउनुहोस्, हे प्रभु येशू!<verse eid="REV 22:20" /></para>
  <para style="b" />
  <para style="p">
    <verse number="21" style="v" sid="REV 22:21" />प्रभु येशूको अनुग्रह परमेश्‍वरका सबै जनहरूसँग रहोस्! आमेन।<verse eid="REV 22:21" /></para>
  <chapter eid="REV 22" />
</usx>