<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JER" style="id">- Biblica® Open Nepali Contemporary Version</book>
  <para style="h">यर्मिया</para>
  <para style="toc1">यर्मियाको भविष्यवाणी</para>
  <para style="toc2">यर्मिया</para>
  <para style="toc3">यर्मिया</para>
  <para style="mt1">यर्मियाको भविष्यवाणी</para>
  <chapter number="1" style="c" sid="JER 1"/>
  <para style="p">
    <verse number="1" style="v" sid="JER 1:1"/>बेन्यामीनी प्रान्तको अनातोतमा बस्‍ने हिल्कियाह, जो पुजारीहरूमध्ये एक थिए; तिनका छोरा यर्मियाका वचनहरू यिनै हुन्। <verse eid="JER 1:1"/><verse number="2" style="v" sid="JER 1:2"/>यहूदाका राजा आमोनका छोरा योशियाहको शासनको तेह्रौँ वर्षमा याहवेहको वचन तिनीकहाँ आयो। <verse eid="JER 1:2"/><verse number="3" style="v" sid="JER 1:3"/>यहूदाका राजा योशियाहका छोरा यहोयाकीमको शासनकालदेखि योशियाहका अर्का छोरा सिदकियाहको एघारौँ वर्षको पाँचौँ महिनासम्म, अर्थात् यरूशलेमका मानिसहरू कैदमा लगिएको समयसम्म आइरह्‍यो।<verse eid="JER 1:3"/></para>
  <para style="b"/>
  <para style="s1">यर्मियाको बोलावट</para>
  <para style="p">
    <verse number="4" style="v" sid="JER 1:4"/>याहवेहको वचन मकहाँ आयो,<verse eid="JER 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 1:5"/>“मैले तँलाई गर्भमा सृष्‍टि गर्नुभन्दा अगि नै तँलाई चिनिसकेको<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">चुनेको</char></note> थिएँ;</para>
  <para style="q2" vid="JER 1:5">तँ जन्मनुभन्दा अगि नै मैले तँलाई अलग गरेँ;</para>
  <para style="q2" vid="JER 1:5">अनि मैले तँलाई जातिहरूका निम्ति अगमवक्ताको रूपमा नियुक्त गरेँ।”<verse eid="JER 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 1:6"/>तब मैले भनेँ, “हे प्रभु याहवेह, म बोल्न जान्दिनँ; किनभने म त बालकै छु।”<verse eid="JER 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 1:7"/>तर याहवेहले मलाई भन्‍नुभयो, “म बालकै छु भनी नभन्। मैले तँलाई पठाएका सबै मानिसहरूकहाँ तँ जानैपर्छ र मैले तँलाई जे-जे आज्ञा गर्छु, त्यो तैँले भन्‍नैपर्छ। <verse eid="JER 1:7"/><verse number="8" style="v" sid="JER 1:8"/>तिनीहरूसित नडरा, किनकि म तँसित छु र तँलाई छुटाउनेछु,” याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 1:9"/>त्यसपछि याहवेहले आफ्नो हात पसारेर मेरो मुख छुनुभयो र मलाई भन्‍नुभयो, “मैले मेरो वचन तेरो मुखमा हालिदिएको छु। <verse eid="JER 1:9"/><verse number="10" style="v" sid="JER 1:10"/>हेर्, उखेल्न र भत्काउन, नाश गर्न र भताभुङ्ग पार्न, निर्माण गर्न र रोप्न भनी आज म तँलाई राष्ट्रहरू र राज्यहरूमाथि नियुक्त गर्दछु।”<verse eid="JER 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 1:11"/>याहवेहको यो वचन मकहाँ आयो: “यर्मिया तँ के देख्दैछस्?”</para>
  <para style="p" vid="JER 1:11">मैले जवाफ दिएँ, “म हाडे-बदामका रूखको एउटा हाँगा देख्दैछु।”<verse eid="JER 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 1:12"/>याहवेहले मलाई भन्‍नुभयो, “तैँले ठिक देखेको छस्; किनकि म आफ्नो वचन पूरा भएको देख्दैछु।”<verse eid="JER 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 1:13"/>याहवेहको वचन फेरि मकहाँ आयो: “तँ के देख्दैछस्?”</para>
  <para style="p" vid="JER 1:13">तब मैले जवाफ दिएँ, “म एउटा उम्‍लिरहेको भाँडो देख्दैछु, जुन उत्तर दिशाबाट हामीतिर ढल्किरहेको छ।”<verse eid="JER 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 1:14"/>याहवेहले मलाई भन्‍नुभयो, “यस देशमा बस्‍ने सबै मानिसहरूमाथि उत्तर दिशाबाट विपत्ति खन्याइनेछ। <verse eid="JER 1:14"/><verse number="15" style="v" sid="JER 1:15"/>म उत्तरी राज्यहरूका सबै जातिहरूलाई भेला गराउन लागेको छु,” याहवेह घोषणा गर्नुहुन्छ।</para>
  <para style="q1" vid="JER 1:15">“तिनीहरूका राजाहरू आउनेछन्, र यरूशलेमका मूलढोकाहरूको मुखमा</para>
  <para style="q2" vid="JER 1:15">तिनीहरूले आफ्ना सिंहासनहरू स्थापित गर्नेछन्;</para>
  <para style="q1" vid="JER 1:15">तिनीहरू त्यसका चारैतिरका पर्खालहरूको विरुद्धमा</para>
  <para style="q2" vid="JER 1:15">र यहूदाका सबै नगरहरूको विरुद्धमा आउनेछन्।<verse eid="JER 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 1:16"/>म आफ्ना जातिहरूमाथि आफ्नो न्यायको घोषणा गर्नेछु;</para>
  <para style="q2" vid="JER 1:16">किनकि तिनीहरूले मलाई त्यागेर दुष्‍टता</para>
  <para style="q1" vid="JER 1:16">गरेका छन्; अनि आफ्नै हातले बनाएका</para>
  <para style="q2" vid="JER 1:16">अरू देवी-देवताहरूका अगि धूप बालेर पूजा गरेका छन्।<verse eid="JER 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 1:17"/>“यसकारण उठ्, र आफूलाई तयार गर्! मैले तँलाई आज्ञा गरेका सबै कुरा तिनीहरूलाई भन्। तिनीहरूसँग नडरा, नत्रता म तँलाई तिनीहरूको अगि भयभीत बनाउनेछु। <verse eid="JER 1:17"/><verse number="18" style="v" sid="JER 1:18"/>आज मैले तँलाई सम्पूर्ण देशको विरुद्धमा—यहूदाका राजाहरू, त्यसका हाकिमहरू, त्यसका पुजारीहरू र देशका मानिसहरूको विरुद्धमा खडा हुन फलामको खम्बा, काँसाको पर्खाल र एउटा बलियो किल्‍ला भएको सुरक्षित सहर बनाएको छु। <verse eid="JER 1:18"/><verse number="19" style="v" sid="JER 1:19"/>तिनीहरू तेरो विरुद्ध लडाइँ गर्नेछन्, तर तँलाई जित्न सक्नेछैनन्; किनकि म तँसित हुनेछु र तँलाई छुटाउनेछु,” याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 1:19"/></para>
  <chapter eid="JER 1"/>
  <chapter number="2" style="c" sid="JER 2"/>
  <para style="s1">इस्राएलले याहवेहलाई त्यागेको</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 2:1"/>याहवेहको वचन मकहाँ आयो: <verse eid="JER 2:1"/><verse number="2" style="v" sid="JER 2:2"/>“जा, र यरूशलेमका मानिसहरूले सुन्‍ने गरी घोषणा गर्:</para>
  <para style="b" vid="JER 2:2"/>
  <para style="p" vid="JER 2:2">“याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="JER 2:2">“ ‘तेरो युवा अवस्थाको भक्ति म सम्झना गर्छु;</para>
  <para style="q2" vid="JER 2:2">कसरी तैँले एउटी दुलहीले झैँ मलाई प्रेम गर्थिस्;</para>
  <para style="q1" vid="JER 2:2">अनि बिउ नछरिएको भूमिमा,</para>
  <para style="q2" vid="JER 2:2">मलाई मरुभूमिमा पछ्याइस्।<verse eid="JER 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 2:3"/>याहवेहका निम्ति इस्राएल पवित्र थियो;</para>
  <para style="q2" vid="JER 2:3">उहाँको फसलको पहिलो फल थियो;</para>
  <para style="q1" vid="JER 2:3">इस्राएललाई निल्नेहरू सबै दोषी ठहरिए;</para>
  <para style="q2" vid="JER 2:3">अनि तिनीहरूमाथि विपत्ति आइलाग्यो,’ ”</para>
  <para style="q2" vid="JER 2:3">याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 2:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="JER 2:4"/>हे याकोबका सन्तान, इस्राएलका सबै वंशहरू हो,</para>
  <para style="q2" vid="JER 2:4">याहवेहको वचन सुन।<verse eid="JER 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 2:5"/>याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="JER 2:5">“तिमीहरूका पितापुर्खाहरूले ममा के दोष भेट्टाए,</para>
  <para style="q2" vid="JER 2:5">र तिनीहरू मबाट यति धेरै टाढा भए?</para>
  <para style="q1" vid="JER 2:5">तिनीहरू काम नलाग्ने मूर्तिहरूका पछि लागेर</para>
  <para style="q2" vid="JER 2:5">तिनीहरू आफैँ काम नलाग्ने भए।<verse eid="JER 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 2:6"/>तिनीहरूले यसो भनी सोधेनन्, ‘याहवेह कहाँ हुनुहुन्छ?</para>
  <para style="q2" vid="JER 2:6">जसले हामीलाई इजिप्टबाट ल्याउनुभयो;</para>
  <para style="q1" vid="JER 2:6">र हामीलाई उजाडस्थानबाट</para>
  <para style="q2" vid="JER 2:6">मरुभूमिको ठाउँ र खाडलबाट,</para>
  <para style="q1" vid="JER 2:6">सुक्खा भूमि र घोर अन्धकार ठाउँबाट,</para>
  <para style="q2" vid="JER 2:6">कुनै मानिस नहिँडेको र कोही नबसेको देशबाट डोर्‍याउनुभयो?’<verse eid="JER 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 2:7"/>मैले तिमीहरूलाई मलिलो देशमा</para>
  <para style="q2" vid="JER 2:7">त्यसका फलहरू र असल उब्जनी खानका निम्ति ल्याएँ।</para>
  <para style="q1" vid="JER 2:7">तर तिमीहरू आयौ र मेरो देशलाई अशुद्ध पार्‍यौ;</para>
  <para style="q2" vid="JER 2:7">अनि मेरो उत्तराधिकारलाई घृणित बनायौ।<verse eid="JER 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 2:8"/>पुजारीहरूले,</para>
  <para style="q2" vid="JER 2:8">‘याहवेह कहाँ हुनुहुन्छ?’ भनी सोधेनन्;</para>
  <para style="q1" vid="JER 2:8">व्यवस्थाका काम गर्नेहरूले मलाई चिनेनन्;</para>
  <para style="q2" vid="JER 2:8">अगुवाहरूले मेरो विरुद्धमा विद्रोह गरे।</para>
  <para style="q1" vid="JER 2:8">काम नलाग्ने मूर्तिहरूका पछि लागेर,</para>
  <para style="q2" vid="JER 2:8">अगमवक्ताहरूले बाल-देवताको नाममा अगमवाणी गरे।<verse eid="JER 2:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="JER 2:9"/>“यसकारण म फेरि तिमीहरूको विरुद्धमा मुद्दा लगाउनेछु,”</para>
  <para style="q2" vid="JER 2:9">याहवेह घोषणा गर्नुहुन्छ।</para>
  <para style="q2" vid="JER 2:9">“अनि म तिमीहरू, तिमीहरूका छोराछोरी</para>
  <para style="q2" vid="JER 2:9">र नातिनातिनाहरूका विरुद्धमा मुद्दा लगाउनेछु।<verse eid="JER 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 2:10"/>कित्तीमको<note caller="+" style="f"><char style="fr" closed="false">2:10 </char><char style="ft" closed="false">साइप्रस र पश्‍चिमी किनारपारि</char></note> किनारपारि गएर हेर्,</para>
  <para style="q2" vid="JER 2:10">केदार<note caller="+" style="f"><char style="fr" closed="false">2:10 </char><char style="ft" closed="false">सिरिया-अरबी मरुभूमि</char></note> मरुभूमिमा पठा, र ध्यानपूर्वक हेर्;</para>
  <para style="q2" vid="JER 2:10">त्यहाँ यस्तो कहिल्यै भएको छ कि छैन, सो पत्ता लगा:<verse eid="JER 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 2:11"/>के कुनै राष्ट्रले आफ्ना देवी-देवताहरू बदली गरेका छन्?</para>
  <para style="q2" vid="JER 2:11">(यद्यपि तिनीहरू देवता नै होइनन्।)</para>
  <para style="q1" vid="JER 2:11">तर मेरो आफ्नै जातिले आफ्ना महिमित परमेश्‍वरलाई</para>
  <para style="q2" vid="JER 2:11">व्यर्थका मूर्तिहरूसित साटेका छन्।<verse eid="JER 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 2:12"/>हे आकाशमण्डल हो, तिमीहरू यस कुरामा चकित होओ;</para>
  <para style="q2" vid="JER 2:12">अनि भयानक डरले थरथर काम,”</para>
  <para style="q2" vid="JER 2:12">याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 2:13"/>“मेरा मानिसहरूले दुई वटा पापहरू गरेका छन्:</para>
  <para style="q1" vid="JER 2:13">तिनीहरूले मलाई त्यागेका छन्,</para>
  <para style="q2" vid="JER 2:13">जिउँदो पानीको मूललाई;</para>
  <para style="q1" vid="JER 2:13">अनि तिनीहरूले पानी नअडिने</para>
  <para style="q2" vid="JER 2:13">आफ्नै कुवाहरू खनेका छन्।<verse eid="JER 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 2:14"/>के इस्राएल एउटा सेवक, जन्मजात दास हो र?</para>
  <para style="q2" vid="JER 2:14">तब किन त्यो लुटिएको छ?<verse eid="JER 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 2:15"/>सिंहहरू गर्जेका छन्;</para>
  <para style="q2" vid="JER 2:15">तिनीहरूले इस्राएललाई झम्टेका छन्।</para>
  <para style="q1" vid="JER 2:15">तिनीहरूले त्यसको भूमिलाई उजाड पारिदिएका छन्;</para>
  <para style="q2" vid="JER 2:15">त्यसका सहरहरू जलाइएका र त्यागिएका छन्।<verse eid="JER 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 2:16"/>मेम्फिस र तहपनेसका मानिसहरूले पनि</para>
  <para style="q2" vid="JER 2:16">तिमीहरूका खप्परलाई कुच्याइदिएका छन्।”<verse eid="JER 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 2:17"/>जब तिमीहरूलाई याहवेह तिमीहरूका परमेश्‍वरले बाटोमा डोर्‍याउँदै हुनुहुन्थ्यो,</para>
  <para style="q2" vid="JER 2:17">तब उहाँलाई तिमीहरूले त्यागेर,</para>
  <para style="q2" vid="JER 2:17">यो कुरा आफैँमाथि ल्याएका होइनौ र?<verse eid="JER 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 2:18"/>अब नील<note caller="+" style="f"><char style="fr" closed="false">2:18 </char><char style="ft" closed="false">मूल भाषामा </char><char style="fqa" closed="false">शीहोर</char></note> नदीबाट पानी पिउन</para>
  <para style="q2" vid="JER 2:18">इजिप्टमा किन जान्छौ?</para>
  <para style="q1" vid="JER 2:18">अनि यूफ्रेटिस नदीबाट पानी पिउन</para>
  <para style="q2" vid="JER 2:18">अश्शूरमा किन जान्छौ?<verse eid="JER 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 2:19"/>तिमीहरूको दुष्‍टताले तिमीहरूलाई दण्ड दिनेछ;</para>
  <para style="q2" vid="JER 2:19">“तिमीहरूको धर्म-त्यागले तिमीहरूलाई हप्काउनेछ।</para>
  <para style="q1" vid="JER 2:19">तिमीहरूले याहवेह</para>
  <para style="q2" vid="JER 2:19">तिमीहरूका आफ्ना परमेश्‍वरलाई त्यागेर मेरो भय नराख्दा</para>
  <para style="q1" vid="JER 2:19">त्यो तिमीहरूका निम्ति कति दुष्‍टता</para>
  <para style="q2" vid="JER 2:19">र तितोपना हुनेछ भनी विचार गरेर जान,”</para>
  <para style="q2" vid="JER 2:19">सेनाहरूका याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 2:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="JER 2:20"/>“धेरै समयअगि नै तैँले आफ्नो जुवा भाँचिस्</para>
  <para style="q2" vid="JER 2:20">र आफ्ना बन्धनहरू फुकाइस्;</para>
  <para style="q2" vid="JER 2:20">तैँले भनिस्, ‘म तपाईंको सेवा गर्नेछैनँ!’</para>
  <para style="q1" vid="JER 2:20">अनि प्रत्येक अग्ला डाँडाहरूमाथि</para>
  <para style="q2" vid="JER 2:20">र हरेक झ्याम्म परेको रूखमुनि</para>
  <para style="q2" vid="JER 2:20">तँ वेश्याजस्तै ढल्किस्।<verse eid="JER 2:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 2:21"/>मैले तँलाई एक असल र भरपर्दो बोटबाट</para>
  <para style="q2" vid="JER 2:21">एउटा उत्तम दाखको बोटझैँ रोपेको थिएँ।</para>
  <para style="q1" vid="JER 2:21">तर कसरी तँ मेरो विरुद्धमा खडा भएर,</para>
  <para style="q2" vid="JER 2:21">भ्रष्‍ट जङ्गली दाखको बोट भइस्?<verse eid="JER 2:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 2:22"/>तैँले आफूलाई कडा साबुन</para>
  <para style="q2" vid="JER 2:22">र सोडाले धोए तापनि</para>
  <para style="q2" vid="JER 2:22">तेरो अपराधको दाग अझै पनि मेरो सामु रहेको छ,”</para>
  <para style="q2" vid="JER 2:22">प्रभु याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 2:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 2:23"/>“कसरी तैँले भन्‍न सक्छस्, ‘म अशुद्ध भएको छैनँ;</para>
  <para style="q2" vid="JER 2:23">म बाल-देवताहरूका पछि लागेको छैनँ?’</para>
  <para style="q1" vid="JER 2:23">हेर्, तैँले बेँसीमा कस्तो व्यवहार गरेको थिइस्;</para>
  <para style="q2" vid="JER 2:23">तैँले के गरेको थिइस्, सो विचार गर्।</para>
  <para style="q1" vid="JER 2:23">तँ त यताउता दौडिहिँड्ने</para>
  <para style="q2" vid="JER 2:23">उत्तेजित ऊँटजस्तै छस्,<verse eid="JER 2:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 2:24"/>उजाडस्थानमा रहने बानी भएकी, कामुक भएर</para>
  <para style="q2" vid="JER 2:24">हावा सुँघिहिँड्ने जङ्गली गधैनीजस्तै।</para>
  <para style="q2" vid="JER 2:24">त्यसको उन्मात कामुकतालाई कसले रोक्न सक्छ?</para>
  <para style="q1" vid="JER 2:24">त्यसलाई पछ्याउने गधाहरूले आफूलाई थकाउनुपर्दैन;</para>
  <para style="q2" vid="JER 2:24">कामवासनाको समयमा तिनीहरूले त्यसलाई भेट्टाइहाल्छन्।<verse eid="JER 2:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 2:25"/>तेरा खुट्टा नाङ्गो नभएसम्म</para>
  <para style="q2" vid="JER 2:25">र तेरो घाँटी तिर्खाले सुक्खा नहुन्जेल नकुद्।</para>
  <para style="q1" vid="JER 2:25">तर तैँले भनिस्, ‘म फर्कन सक्दिनँ!</para>
  <para style="q2" vid="JER 2:25">म विदेशी देवताहरूलाई प्रेम गर्छु;</para>
  <para style="q2" vid="JER 2:25">अनि मैले तिनीहरूलाई पछ्याउनैपर्छ।’<verse eid="JER 2:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="JER 2:26"/>“पक्राउ पर्दा चोर लज्जित भएझैँ,</para>
  <para style="q2" vid="JER 2:26">इस्राएलको घराना लज्जित भएको छ;</para>
  <para style="q1" vid="JER 2:26">अर्थात् तिनीहरू, आफ्ना राजाहरू र तिनीहरूका अधिकारीहरू,</para>
  <para style="q2" vid="JER 2:26">तिनीहरूका पुजारीहरू र तिनीहरूका अगमवक्ताहरू सबै लज्जित भएका छन्।<verse eid="JER 2:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JER 2:27"/>तिनीहरूले काठलाई भन्छन्, ‘तपाईं मेरा पिता हुनुहुन्छ,’</para>
  <para style="q2" vid="JER 2:27">अनि ढुङ्गालाई भन्छन्, ‘तपाईंले मलाई जन्माउनुभयो।’</para>
  <para style="q1" vid="JER 2:27">तिनीहरूले मतिर मुख होइन,</para>
  <para style="q2" vid="JER 2:27">तर आफ्नो पिठिउँ फर्काएका छन्;</para>
  <para style="q1" vid="JER 2:27">तापनि तिनीहरू विपत्तिमा पर्दा तिनीहरू भन्छन्,</para>
  <para style="q2" vid="JER 2:27">‘आएर हामीलाई बचाउनुहोस्!’<verse eid="JER 2:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JER 2:28"/>त्यसो भए तिमीहरूले आफ्ना निम्ति बनाएका देवी-देवताहरू चाहिँ कहाँ छन् त?</para>
  <para style="q2" vid="JER 2:28">तिमीहरू विपत्तिमा परेको बेला</para>
  <para style="q2" vid="JER 2:28">तिनीहरूले बचाउन सक्छन् भने तिनीहरू आऊन्!</para>
  <para style="q1" vid="JER 2:28">किनकि हे यहूदा, तँसित जति सहरहरू छन्,</para>
  <para style="q2" vid="JER 2:28">त्यति नै धेरै देवी-देवताहरू पनि छन्।<verse eid="JER 2:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="JER 2:29"/>“तिमीहरू मेरो विरुद्धमा किन अभियोग लगाउँछौ?</para>
  <para style="q2" vid="JER 2:29">तिमीहरू सबै मेरो विरुद्धमा बागी भएका छौ,”</para>
  <para style="q2" vid="JER 2:29">याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 2:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JER 2:30"/>“मैले व्यर्थैमा तिम्रा मानिसहरूलाई दण्ड दिएँ;</para>
  <para style="q2" vid="JER 2:30">किनकि तिनीहरूले सुध्रिन मानेनन्।</para>
  <para style="q1" vid="JER 2:30">तिमीहरूका तरवारले तिमीहरूका अगमवक्ताहरूलाई</para>
  <para style="q2" vid="JER 2:30">निलिहाल्ने शिकारी सिंहले जस्तै नाश गरेका छौ।<verse eid="JER 2:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JER 2:31"/>“यस पुस्ताका मानिसहरू, तिमीहरूले याहवेहको वचन विचार गर:</para>
  <para style="q1" vid="JER 2:31">“के म इस्राएलका निम्ति मरुभूमि</para>
  <para style="q2" vid="JER 2:31">अथवा घोर अन्धकारको देशजस्तै भएको छु?</para>
  <para style="q1" vid="JER 2:31">किन मेरा मानिसहरूले यसो भन्छन्, ‘हामी आफूखुशी गर्न स्वतन्त्र छौँ;</para>
  <para style="q2" vid="JER 2:31">हामी तपाईंकहाँ फेरि फर्केर आउनेछैनौँ?’<verse eid="JER 2:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JER 2:32"/>के एउटी कन्याले आफ्ना गरगहना, वा</para>
  <para style="q2" vid="JER 2:32">एउटी दुलहीले आफ्नो विवाहका गरगहनाहरू बिर्सन सक्छे र?</para>
  <para style="q1" vid="JER 2:32">तापनि मेरा मानिसहरूले,</para>
  <para style="q2" vid="JER 2:32">धेरै समयदेखि मलाई बिर्सेका छन्।<verse eid="JER 2:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="JER 2:33"/>तँ प्रेमिका पछि लाग्नलाई कति सिपालु छेस्!</para>
  <para style="q2" vid="JER 2:33">अति दुष्‍ट स्त्रीहरूले पनि तेरो चालहरूबाट सिक्न सक्छन्।<verse eid="JER 2:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="JER 2:34"/>तेरा लुगाहरूमा निर्दोष गरिबहरूको</para>
  <para style="q2" vid="JER 2:34">रगत भेटिन्छ,</para>
  <para style="q2" vid="JER 2:34">यद्यपि तैँले तिनीहरूले घर फोर्दै गरेको भेट्टाइनस्।</para>
  <para style="q1" vid="JER 2:34">तर यी सबै कुरा हुँदा-हुँदै पनि<verse eid="JER 2:34"/></para>
  <para style="q2">
    <verse number="35" style="v" sid="JER 2:35"/>तँ भन्छस्, ‘म त निर्दोष छु;</para>
  <para style="q2" vid="JER 2:35">उहाँ मसित रिसाउनुभएको छैन।’</para>
  <para style="q1" vid="JER 2:35">तर तैँले, ‘मैले पाप गरेकी छैनँ’</para>
  <para style="q2" vid="JER 2:35">भनेकै कारण म तेरो न्याय गर्नेछु।<verse eid="JER 2:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="JER 2:36"/>तँ किन आफ्ना मार्गहरू बदलेर,</para>
  <para style="q2" vid="JER 2:36">यताउता डुलिहिँड्छस्?</para>
  <para style="q1" vid="JER 2:36">अश्शूरले तँलाई निराश तुल्याएजस्तै</para>
  <para style="q2" vid="JER 2:36">तँ इजिप्टबाट पनि निराश हुनेछस्।<verse eid="JER 2:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="JER 2:37"/>तैँले त्यो ठाउँलाई पनि</para>
  <para style="q2" vid="JER 2:37">आफ्ना हात आफ्नै थाप्लोमा राखेर छाड्नेछस्;</para>
  <para style="q1" vid="JER 2:37">किनकि तैँले भरोसा राखेकाहरूलाई याहवेहले त्याग्नुभएको छ;</para>
  <para style="q2" vid="JER 2:37">तैँले तिनीहरूबाट सहायता पाउनेछैनस्।<verse eid="JER 2:37"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="JER 2"/>
  <chapter number="3" style="c" sid="JER 3"/>
  <para style="q1">
    <verse number="1" style="v" sid="JER 3:1"/>“यदि कुनै मानिसले आफ्नी पत्नीसँग सम्बन्ध-विच्छेद गर्‍यो</para>
  <para style="q2" vid="JER 3:1">र स्त्रीले त्यसलाई छोडेर अर्को मानिससित विवाह गरी भने,</para>
  <para style="q1" vid="JER 3:1">के त्यो पतिले त्यस स्त्रीलाई फेरि फर्काएर ल्याउँछ र?</para>
  <para style="q2" vid="JER 3:1">यसो गर्दा के देश पूर्ण रूपले अशुद्ध हुँदैन र?</para>
  <para style="q1" vid="JER 3:1">तर तँ धेरै प्रेमीहरूसित एक वेश्याझैँ बसेकी छेस्,</para>
  <para style="q2" vid="JER 3:1">अर्थात् के अब तँ मकहाँ फर्केर आउन सक्छेस्?”</para>
  <para style="q2" vid="JER 3:1">याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 3:2"/>“बाँझो पहाडहरूतिर आँखा उठाएर हेर्।</para>
  <para style="q2" vid="JER 3:2">के तैँले कुकर्म नगरेको कुनै ठाउँ छ?</para>
  <para style="q1" vid="JER 3:2">मरुभूमिमा डुलुवा बसेझैँ,</para>
  <para style="q2" vid="JER 3:2">तँ बाटोको छेउतिर प्रेमिकाहरूको प्रतीक्षामा बसिस्।</para>
  <para style="q1" vid="JER 3:2">तैँले देशलाई तेरो व्यभिचार र दुष्‍टताले भ्रष्‍ट पारेकी छेस्।<verse eid="JER 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 3:3"/>यसकारण झरी रोकिएको छ;</para>
  <para style="q2" vid="JER 3:3">अनि वसन्त ऋतुको वर्षा आएकै छैन।</para>
  <para style="q1" vid="JER 3:3">तापनि तँ लाज नभएकी वेश्याजस्तै देखिन्छेस्;</para>
  <para style="q2" vid="JER 3:3">तँ लाजले भुतुक्‍क हुँदिनस्।<verse eid="JER 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 3:4"/>के तैँले मलाई भर्खरै यसरी पुकारिनस्,</para>
  <para style="q2" vid="JER 3:4">‘मेरा पिता, मेरा युवावस्थादेखिको साथी,<verse eid="JER 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 3:5"/>के तपाईं सधैँ रिसाइरहनुहुनेछ?</para>
  <para style="q2" vid="JER 3:5">के तपाईंको क्रोध सदासर्वदा रहिरहनेछ?’</para>
  <para style="q1" vid="JER 3:5">तैँले यसरी कुरा गर्छेस्,</para>
  <para style="q2" vid="JER 3:5">तर तैँले सक्ने सबै दुष्‍ट्याइँ गर्छेस्।”<verse eid="JER 3:5"/></para>
  <para style="s1">विश्‍वासघाती इस्राएल</para>
  <para style="p">
    <verse number="6" style="v" sid="JER 3:6"/>राजा योशियाहको शासनकालमा याहवेहले मलाई भन्‍नुभयो, “इस्राएलले कस्तो विश्‍वासघाती काम गरेको छ, के तैँले देखेको छस्? इस्राएल प्रत्येक अग्लो डाँडा र हरेक झ्याम्म परेको रूखमुनि गएर त्यसले त्यहाँ व्यभिचार गरेकी छे। <verse eid="JER 3:6"/><verse number="7" style="v" sid="JER 3:7"/>इस्राएलले यी सबै कुरा गरेपछि मतिर फर्किन्छे होला भन्‍ने मैले सोचेको थिएँ, तर त्यो फर्किन। अनि त्यसकी अविश्‍वासी बहिनी यहूदाले यो कुरा देखी। <verse eid="JER 3:7"/><verse number="8" style="v" sid="JER 3:8"/>मैले अविश्‍वासी इस्राएललाई त्यसको सम्बन्ध-विच्छेदको त्यागपत्र दिएँ र त्यसको व्यभिचारको कारण त्यसलाई टाढा पठाइदिएँ। तापनि त्यसकी अविश्‍वासी बहिनी यहूदा डराइन; त्यो पनि गई र व्यभिचार गरी। <verse eid="JER 3:8"/><verse number="9" style="v" sid="JER 3:9"/>किनकि इस्राएलको अनैतिक चरित्र त्यसको निम्ति केहीजस्तो लागेन, त्यसले ढुङ्गा र काठसित व्यभिचार गरेर देशलाई बिटुलो पारेकी छे। <verse eid="JER 3:9"/><verse number="10" style="v" sid="JER 3:10"/>यी सबै कुरा भएर पनि त्यसकी विश्‍वासघाती बहिनी यहूदा मतिर सम्पूर्ण हृदयले होइन, तर त्यसले फर्केको बहाना मात्र गरेकी छे,” याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 3:11"/>याहवेहले मलाई भन्‍नुभयो, “अविश्‍वासी इस्राएल अविश्‍वासी यहूदाभन्दा बढी धर्मी छ। <verse eid="JER 3:11"/><verse number="12" style="v" sid="JER 3:12"/>जा, उत्तरतिर यो सन्देश घोषणा गर्:</para>
  <para style="q1" vid="JER 3:12">“याहवेह भन्‍नुहुन्छ: ‘अविश्‍वासी इस्राएल फर्की,</para>
  <para style="q2" vid="JER 3:12">म तँलाई फेरि रिसाएको आँखाले हेर्नेछैनँ;</para>
  <para style="q1" vid="JER 3:12">किनकि म विश्‍वासयोग्य छु,’ याहवेह घोषणा गर्नुहुन्छ,</para>
  <para style="q2" vid="JER 3:12">‘म सधैँभरि रिसाउनेछैनँ।<verse eid="JER 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 3:13"/>तैँले आफ्नो दोष मात्र स्वीकार गर्,</para>
  <para style="q2" vid="JER 3:13">तँ याहवेह तेरा परमेश्‍वरको विरुद्धमा विरोधी भएकी छेस्;</para>
  <para style="q1" vid="JER 3:13">अनि तैँले आफ्नो प्रेम हरेक झ्याम्म परेको रूखमुनि</para>
  <para style="q2" vid="JER 3:13">विदेशी देवी-देवताहरूलाई बाँडिदिएकी छेस्;</para>
  <para style="q2" vid="JER 3:13">अनि मेरा आज्ञापालन गरेकी छैनस्,’</para>
  <para style="q2" vid="JER 3:13">याहवेह घोषणा गर्नुहुन्छ।”<verse eid="JER 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 3:14"/>याहवेह घोषणा गर्नुहुन्छ, “हे अविश्‍वासी मानिसहरू हो, फर्क! किनकि म तिमीहरूको पति हुँ। म तिमीहरूलाई एउटा सहरबाट एक जनालाई र एउटा वंशबाट दुई जना गरेर छान्‍नेछु—अनि म तिमीहरूलाई सियोनमा ल्याउनेछु। <verse eid="JER 3:14"/><verse number="15" style="v" sid="JER 3:15"/>त्यसपछि म तिमीहरूलाई मेरो हृदयअनुसारको गोठालाहरू दिनेछु, जसले तिमीहरूलाई ज्ञान र समझकासाथ डोर्‍याउनेछन्। <verse eid="JER 3:15"/><verse number="16" style="v" sid="JER 3:16"/>ती दिनहरूमा, जब देशमा तिमीहरूको संख्या धेरै बढ्नेछ,” तब याहवेह घोषणा गर्नुहुन्छ, “मानिसहरूले ‘याहवेहको करारको सन्दुक’ भनेर फेरि कहिल्यै भन्‍नेछैनन्, न त फेरि कहिल्यै याद गर्नेछन्; त्यो तिनीहरूका मनमा सम्झनास्वरूप कहिल्यै आउनेछैन, न त त्योजस्तै फेरि अर्को कहिल्यै बनाइनेछ। <verse eid="JER 3:16"/><verse number="17" style="v" sid="JER 3:17"/>त्यस बेला मानिसहरूले यरूशलेमलाई याहवेहको सिंहासन भन्‍नेछन्; अनि सबै जातिका मानिसहरू याहवेहको नामलाई आदर गर्न यरूशलेममा भेला हुनेछन्। तिनीहरू फेरि आफ्ना दुष्‍ट हृदयको हठीपनाको पछि लाग्नेछैनन्। <verse eid="JER 3:17"/><verse number="18" style="v" sid="JER 3:18"/>ती दिनहरूमा यहूदाका घराना, इस्राएलको घरानासित मिल्नेछ; अनि तिनीहरू एकसाथ उत्तरी देशबाट मैले उत्तराधिकारको रूपमा तिमीहरूका पितापुर्खाहरूलाई दिएको देशमा आउनेछन्।<verse eid="JER 3:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 3:19"/>“म याहवेह आफैँले भनेको हुँ,</para>
  <para style="q1" vid="JER 3:19">“ ‘म कति खुशीसाथ तिमीहरूलाई मेरो छोराछोरीहरूजस्तै व्यवहार गर्नेथिएँ;</para>
  <para style="q2" vid="JER 3:19">अनि तिमीहरूलाई अति असल देश,</para>
  <para style="q2" vid="JER 3:19">मेरो राष्ट्रमा सबैभन्दा सुन्दर उत्तराधिकार दिनेथिएँ।’</para>
  <para style="q1" vid="JER 3:19">तिमीहरूले मलाई ‘पिता’ भनी बोलाउनेछौ,</para>
  <para style="q2" vid="JER 3:19">र मलाई पछ्याउन छोड्नेछैनौ भनी सोचेको थिएँ।<verse eid="JER 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 3:20"/>तर आफ्नो पतिप्रति अविश्‍वासी रहेकी पत्नीझैँ,</para>
  <para style="q2" vid="JER 3:20">हे इस्राएलका घराना हो, तिमीहरू मप्रति अविश्‍वासी भएका छौ,”</para>
  <para style="q2" vid="JER 3:20">याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 3:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="JER 3:21"/>नाङ्गा डाँडाहरूमा एउटा रोदन सुनिन्छ;</para>
  <para style="q2" vid="JER 3:21">इस्राएलका मानिसहरूका रुवाइ र दयाका निम्ति पुकाराको सोर,</para>
  <para style="q1" vid="JER 3:21">किनकि तिनीहरू कुबाटोतिर लागेका छन्;</para>
  <para style="q2" vid="JER 3:21">अनि याहवेह तिनीहरूका परमेश्‍वरलाई बिर्सेका छन्।<verse eid="JER 3:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="JER 3:22"/>“हे अविश्‍वासी मानिसहरू हो, फर्क!</para>
  <para style="q2" vid="JER 3:22">म तिमीहरूका विश्‍वासघाती हृदयलाई निको पार्नेछु।”</para>
  <para style="b" vid="JER 3:22"/>
  <para style="q1" vid="JER 3:22">“हजुर, हामी तपाईंकहाँ फर्केर आउनेछौँ;</para>
  <para style="q2" vid="JER 3:22">किनकि तपाईं नै याहवेह हाम्रा परमेश्‍वर हुनुहुन्छ।”<verse eid="JER 3:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 3:23"/>“निश्‍चय नै डाँडाहरूमा मूर्तिपूजाको होहल्‍ला छ,</para>
  <para style="q2" vid="JER 3:23">र पर्वत एउटा छल हो;</para>
  <para style="q1" vid="JER 3:23">निश्‍चय नै याहवेह हाम्रा परमेश्‍वरमा</para>
  <para style="q2" vid="JER 3:23">इस्राएलको निम्ति उद्धार छ।<verse eid="JER 3:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 3:24"/>हाम्रो जवान अवस्थाबाट नै लाजमर्दो देवी-देवताहरूले</para>
  <para style="q2" vid="JER 3:24">हाम्रा पितापुर्खाहरूका परिश्रमका फलहरू—</para>
  <para style="q1" vid="JER 3:24">अर्थात्, भेडाबाख्राका बगालहरू र गाईबस्तुका बथानहरू;</para>
  <para style="q2" vid="JER 3:24">अनि तिनीहरूका छोराछोरीहरू सबै कुरा निलिदिएको छ।<verse eid="JER 3:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 3:25"/>हामी आफ्नो लाजमा घोप्टो परौँ;</para>
  <para style="q2" vid="JER 3:25">अनि हाम्रा अपमानले हामीलाई ढाकोस्।</para>
  <para style="q1" vid="JER 3:25">हामीले याहवेह हाम्रा परमेश्‍वरको विरुद्धमा</para>
  <para style="q2" vid="JER 3:25">हामी र हाम्रा पितापुर्खाहरू दुवैले पाप गरेका छौँ;</para>
  <para style="q1" vid="JER 3:25">हाम्रो जवानी अवस्थादेखि आजको दिनसम्म</para>
  <para style="q2" vid="JER 3:25">हामीले याहवेह हाम्रा परमेश्‍वरको आज्ञापालन गरेका छैनौँ।”<verse eid="JER 3:25"/></para>
  <para style="b"/>
  <chapter eid="JER 3"/>
  <chapter number="4" style="c" sid="JER 4"/>
  <para style="q1">
    <verse number="1" style="v" sid="JER 4:1"/>“हे इस्राएल, यदि तिमीहरू फर्किआउन चाहन्छौ भने,</para>
  <para style="q2" vid="JER 4:1">मकहाँ फर्किआओ,” याहवेह घोषणा गर्नुहुन्छ।</para>
  <para style="q1" vid="JER 4:1">“यदि तिमीहरूले आफ्ना घिनलाग्दा मूर्तिहरू मेरो दृष्‍टिबाट टाढा राख्यौ</para>
  <para style="q2" vid="JER 4:1">र फेरि बरालिएनौ भने,<verse eid="JER 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 4:2"/>अनि तिमीहरूले सत्य, न्याय र धार्मिकतामा</para>
  <para style="q2" vid="JER 4:2">‘जीवित याहवेहलाई साक्षी’ राखेर शपथ खायौ भने,</para>
  <para style="q1" vid="JER 4:2">तब उहाँद्वारा जातिहरू आशिषित हुनेछन्;</para>
  <para style="q2" vid="JER 4:2">अनि तिनीहरूले उहाँमा नै गर्व गर्नेछन्।”<verse eid="JER 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 4:3"/>यरूशलेम र यहूदाका मानिसहरूलाई याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="JER 4:3">“तिमीहरूको बाँझो जमिनमा खनजोत गर,</para>
  <para style="q2" vid="JER 4:3">र काँडाहरूको बीचमा बिउ नछर।<verse eid="JER 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 4:4"/>हे यरूशलेम र यहूदाका मानिसहरू हो,</para>
  <para style="q2" vid="JER 4:4">याहवेहका निम्ति आ-आफ्नो खतना गर,</para>
  <para style="q2" vid="JER 4:4">तिमीहरूका आफ्नो हृदयको खतना गर।</para>
  <para style="q1" vid="JER 4:4">नत्रता तिमीहरूले गरेका दुष्‍टताको कारण</para>
  <para style="q2" vid="JER 4:4">मेरो क्रोध दन्केर निस्कनेछ, र आगोझैँ बल्नेछ,</para>
  <para style="q2" vid="JER 4:4">अर्थात् यसरी बल्नेछ, कि कसैले पनि निभाउन सक्नेछैन।<verse eid="JER 4:4"/></para>
  <para style="s1">उत्तर दिशाबाट विपत्ति</para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 4:5"/>“यहूदाका मानिसहरू र यरूशलेमका मानिसहरूलाई यसो भनेर घोषणा गर:</para>
  <para style="q2" vid="JER 4:5">‘देशभरि तुरही फुक!’</para>
  <para style="q1" vid="JER 4:5">चर्कोसँग कराएर भन:</para>
  <para style="q2" vid="JER 4:5">‘एकसाथ भेला होओ!</para>
  <para style="q2" vid="JER 4:5">हामी किल्‍ला भएका सुरक्षित सहरहरूतिर भागौँ।’<verse eid="JER 4:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 4:6"/>सियोनतिर जाने झण्डा उठाओ!</para>
  <para style="q2" vid="JER 4:6">ढिलो नगरी सुरक्षाको निम्ति भाग!</para>
  <para style="q1" vid="JER 4:6">किनकि म उत्तर दिशाबाट विपत्ति ल्याउँदैछु;</para>
  <para style="q2" vid="JER 4:6">अब डरलाग्दो सर्वनाश ल्याउनेछु।”<verse eid="JER 4:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="JER 4:7"/>एउटा सिंह, जो आफ्नो ओडारबाट निस्किआएको छ;</para>
  <para style="q2" vid="JER 4:7">राष्ट्रहरूलाई नाश गर्न एक जना निस्किसकेको छ।</para>
  <para style="q1" vid="JER 4:7">तिमीहरूको देशलाई सर्वनाश पार्न</para>
  <para style="q2" vid="JER 4:7">त्यो आफ्नो ठाउँबाट निस्किसकेको छ।</para>
  <para style="q1" vid="JER 4:7">तिमीहरूका सहरहरू नष्‍ट हुनेछन्,</para>
  <para style="q2" vid="JER 4:7">र त्यहाँ कोही पनि बसोबास गर्नेछैन।<verse eid="JER 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 4:8"/>यसकारण भाङ्ग्रा लगाएर</para>
  <para style="q2" vid="JER 4:8">विलाप गर र रोओ;</para>
  <para style="q1" vid="JER 4:8">किनकि याहवेहको डरलाग्दो क्रोध</para>
  <para style="q2" vid="JER 4:8">हामीबाट हटेको छैन।<verse eid="JER 4:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="JER 4:9"/>याहवेह घोषणा गर्नुहुन्छ, “त्यो दिन,</para>
  <para style="q2" vid="JER 4:9">राजा र अधिकारीहरू हताश हुनेछन्,</para>
  <para style="q1" vid="JER 4:9">र पुजारीहरू भयभीत हुनेछन्;</para>
  <para style="q2" vid="JER 4:9">अनि अगमवक्ताहरू चकित हुनेछन्।”<verse eid="JER 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 4:10"/>तब मैले भनेँ, “हे प्रभु याहवेह, ‘तिमीहरूलाई शान्ति हुनेछ’ भनेर यिनीहरू र यरूशलेमका मानिसहरूलाई पूर्ण रूपले कसरी धोका दिनुभएको छ; किनकि तरवार हाम्रा घाँटीसम्म नै छ!”<verse eid="JER 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 4:11"/>त्यस बेला यी मानिसहरू र यरूशलेमलाई यसो भनिनेछ, “मरुभूमिका अग्ला बाँझो ठाउँहरूबाट एउटा प्रचण्ड तातो बतास मेरा मानिसहरूतिर बहनेछ, तर त्यो बतास निफन्‍नलाई वा सफा पार्नलाई होइन; <verse eid="JER 4:11"/><verse number="12" style="v" sid="JER 4:12"/>किनकि मबाट आउने बतास अति शक्तिशाली हुनेछ। अब म यहूदाका मानिसहरूमाथि मेरो दण्ड घोषणा गर्नेछु।”<verse eid="JER 4:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 4:13"/>हेर! उहाँ बादलझैँ अगि बढ्नुहुन्छ,</para>
  <para style="q2" vid="JER 4:13">उहाँका रथहरू भुमरीझैँ आउँछन्;</para>
  <para style="q1" vid="JER 4:13">उहाँका घोडाहरू गरुडभन्दा तेज दगुर्छन्।</para>
  <para style="q2" vid="JER 4:13">हाय हामीलाई, किनकि हामीहरू बरबाद भयौँ!<verse eid="JER 4:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 4:14"/>हे यरूशलेम, तेरो हृदयबाट दुष्‍ट कुराहरू धोएर पखाल्, तब तँ बाँच्नेछेस्।</para>
  <para style="q2" vid="JER 4:14">तँ कहिलेसम्म दुष्‍ट विचारहरू पालिरहन्छेस्?<verse eid="JER 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 4:15"/>दानबाट एउटा आवाजले घोषणा गर्दैछ;</para>
  <para style="q2" vid="JER 4:15">एफ्राइमका डाँडाहरूबाट सर्वनाशको घोषणा हुँदैछ,<verse eid="JER 4:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 4:16"/>“यो कुरा राष्ट्रहरूलाई भन्,</para>
  <para style="q2" vid="JER 4:16">यरूशलेमलाई यो घोषणा गर्:</para>
  <para style="q1" vid="JER 4:16">‘यहूदाका सहरहरूको विरुद्धमा युद्धको ध्वनि सुनाउँदै,</para>
  <para style="q2" vid="JER 4:16">टाढा देशबाट घेरा हाल्ने सेनाहरू आउँदैछन्।<verse eid="JER 4:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 4:17"/>मानिसहरूले खेतको रक्षा गरेझैँ तिनीहरूले यरूशलेमलाई घेर्नेछन्;</para>
  <para style="q2" vid="JER 4:17">किनकि त्यसले मेरो विरुद्धमा विद्रोह गरेको छ,’ ”</para>
  <para style="q2" vid="JER 4:17">याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 4:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 4:18"/>“तेरा आफ्नै चाल र कामहरूले</para>
  <para style="q2" vid="JER 4:18">तँमाथि कष्‍ट ल्याएको हो।</para>
  <para style="q1" vid="JER 4:18">तेरो दण्ड यही हो।</para>
  <para style="q2" vid="JER 4:18">यो कस्तो तितो छ!</para>
  <para style="q2" vid="JER 4:18">त्यो कष्‍टले तेरो मुटुलाई नै छेड्छ!”<verse eid="JER 4:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="JER 4:19"/>हाय, मेरो पीडा! मेरो पीडा!</para>
  <para style="q2" vid="JER 4:19">म कष्‍टमा छटपटाउँछु!</para>
  <para style="q1" vid="JER 4:19">हाय, मेरो हृदयको वेदना!</para>
  <para style="q2" vid="JER 4:19">मेरो हृदय जोडसित धड्कन्छ!</para>
  <para style="q2" vid="JER 4:19">म चुपचाप रहन सक्दिनँ।</para>
  <para style="q1" vid="JER 4:19">किनकि मैले तुरहीको आवाज सुनेको छु;</para>
  <para style="q2" vid="JER 4:19">मैले युद्धको ध्वनि सुनेको छु।<verse eid="JER 4:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 4:20"/>विनाशपछि विनाश आउँछ;</para>
  <para style="q2" vid="JER 4:20">सम्पूर्ण देश ध्वस्त भएको अवस्थामा छ।</para>
  <para style="q1" vid="JER 4:20">अचानक मेरा पालहरू नष्‍ट हुन्छन्,</para>
  <para style="q2" vid="JER 4:20">एकै क्षणमै मेरो शरणस्थान नष्‍ट पारिन्छ;<verse eid="JER 4:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 4:21"/>मैले कहिलेसम्म लडाइँको झण्डा हेरिरहूँ,</para>
  <para style="q2" vid="JER 4:21">अनि तुरहीको आवाज सुनिरहूँ?<verse eid="JER 4:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="JER 4:22"/>“मेरा मानिसहरू मूर्ख छन्;</para>
  <para style="q2" vid="JER 4:22">तिनीहरूले मलाई चिन्दैनन्।</para>
  <para style="q1" vid="JER 4:22">तिनीहरू ज्ञान नभएका बालकहरूजस्ता हुन्;</para>
  <para style="q2" vid="JER 4:22">तिनीहरूको समझशक्ति छैन।</para>
  <para style="q1" vid="JER 4:22">तिनीहरू दुष्‍ट काम गर्न सिपालु छन्;</para>
  <para style="q2" vid="JER 4:22">तर तिनीहरूले भलाइ कसरी गर्ने भन्‍ने कुरा जान्दैनन्।”<verse eid="JER 4:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="JER 4:23"/>मैले पृथ्वीतिर हेरेँ,</para>
  <para style="q2" vid="JER 4:23">त्यो आकारविनाको र शून्य थियो;</para>
  <para style="q1" vid="JER 4:23">अनि आकाशतिर हेरेँ,</para>
  <para style="q2" vid="JER 4:23">र त्यहाँ उज्यालो थिएन।<verse eid="JER 4:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 4:24"/>मैले डाँडाहरूतिर हेरेँ,</para>
  <para style="q2" vid="JER 4:24">तिनीहरू काँपिरहेका थिए;</para>
  <para style="q2" vid="JER 4:24">सबै डाँडा हल्‍लिरहेका थिए।<verse eid="JER 4:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 4:25"/>मैले हेरेँ, र त्यहाँ कोही पनि मानिसहरू थिएनन्;</para>
  <para style="q2" vid="JER 4:25">आकाशका सबै चरा उडेर गइसकेका थिए।<verse eid="JER 4:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JER 4:26"/>मैले हेरेँ, र फलदायी जमिन मरुभूमि भएको थियो;</para>
  <para style="q2" vid="JER 4:26">त्यसका सबै सहर याहवेहको सामु</para>
  <para style="q2" vid="JER 4:26">उहाँको भयानक रिसमा नष्‍ट भएका थिए।<verse eid="JER 4:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JER 4:27"/>याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="JER 4:27">“मैले पृथ्वीलाई पूर्ण रूपले नाश नगरे तापनि</para>
  <para style="q2" vid="JER 4:27">सारा देश नष्‍ट हुनेछ।<verse eid="JER 4:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JER 4:28"/>यसकारण पृथ्वीले शोक गर्नेछ,</para>
  <para style="q2" vid="JER 4:28">र माथिको आकाश अँध्यारो हुनेछ;</para>
  <para style="q1" vid="JER 4:28">किनकि मैले बोलेको छु, र मेरो मन बदलिनेछैन;</para>
  <para style="q2" vid="JER 4:28">मैले निर्णय गरिसकेको छु, र मपछि हट्नेछैनँ।”<verse eid="JER 4:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="JER 4:29"/>घोडचढी र धनुर्धारीहरूको आवाज सुनेर</para>
  <para style="q2" vid="JER 4:29">सबै सहर भाग्नेछन्।</para>
  <para style="q1" vid="JER 4:29">तिनीहरू झाडीहरूतिर पस्‍नेछन्;</para>
  <para style="q2" vid="JER 4:29">अरूचाहिँ चट्टानमाथि उक्लनेछन्।</para>
  <para style="q1" vid="JER 4:29">सबै सहरहरू सुनसान हुनेछन्;</para>
  <para style="q2" vid="JER 4:29">ती सहरहरूमा कुनै मानिस बस्‍नेछैन।<verse eid="JER 4:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="JER 4:30"/>हे उजाड पारिएकी यरूशलेम, तँ के गर्दैछेस्?</para>
  <para style="q2" vid="JER 4:30">तैँले किन रातो वस्त्र पहिरहन्छेस्?</para>
  <para style="q2" vid="JER 4:30">र सुनको गहना लगाउँछेस्?</para>
  <para style="q1" vid="JER 4:30">तेरो आँखामा किन गाजल लगाउँछेस्?</para>
  <para style="q2" vid="JER 4:30">तँ व्यर्थमा आफूलाई सिङ्गार गर्छेस्।</para>
  <para style="q1" vid="JER 4:30">तेरा प्रेमीहरूले तँलाई घृणा गर्छन्;</para>
  <para style="q2" vid="JER 4:30">तिनीहरूले तँलाई मार्न खोज्दैछन्।<verse eid="JER 4:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="JER 4:31"/>म प्रसुती वेदनामा परेकी स्त्रीको रोदनजस्तै सुन्छु;</para>
  <para style="q2" vid="JER 4:31">पहिलो प्रसुती-वेदनाले छटपटाएको सुस्केरा,</para>
  <para style="q1" vid="JER 4:31">सास लिन गाह्रो परेकी सियोनकी छोरीको चीत्कार,</para>
  <para style="q2" vid="JER 4:31">आफ्नो हात पसारेर यसो भन्दै गरेकी,</para>
  <para style="q1" vid="JER 4:31">“हाय, म बेहोश हुँदैछु;</para>
  <para style="q2" vid="JER 4:31">मेरो जीवन हत्याराहरूको हातमा सुम्पिएको छ।”<verse eid="JER 4:31"/></para>
  <chapter eid="JER 4"/>
  <chapter number="5" style="c" sid="JER 5"/>
  <para style="s1">एक जना पनि इमानदार छैन</para>
  <para style="q1">
    <verse number="1" style="v" sid="JER 5:1"/>“यरूशलेमका सडकहरूहुँदो माथि र तल जा;</para>
  <para style="q2" vid="JER 5:1">चारैतिर हेर्, र विचार गर्।</para>
  <para style="q2" vid="JER 5:1">सहरका चोकहरूमा खोजी गर्।</para>
  <para style="q1" vid="JER 5:1">यदि तैँले इमानदारीसाथ चल्ने</para>
  <para style="q2" vid="JER 5:1">र सत्यको खोजी गर्ने एउटै मात्र व्यक्ति कतै भेट्टाइस् भने,</para>
  <para style="q2" vid="JER 5:1">म यस सहरलाई क्षमा गरिदिनेछु।<verse eid="JER 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 5:2"/>यद्यपि तिनीहरूले, ‘जीवित याहवेहलाई साक्षी राखेर’ भन्छन्,</para>
  <para style="q2" vid="JER 5:2">तर पनि तिनीहरूले झूटो शपथ खान्छन्।”<verse eid="JER 5:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="JER 5:3"/>हे याहवेह, के तपाईंका आँखाले सत्यतालाई खोज्दैन र?</para>
  <para style="q2" vid="JER 5:3">तपाईंले तिनीहरूलाई प्रहार गर्नुभयो, तर तिनीहरूले वास्तै गरेनन्;</para>
  <para style="q2" vid="JER 5:3">तपाईंले तिनीहरूलाई धुलोपिठो पार्नुभयो, तर तिनीहरूले सुध्रिन इन्कार गरे।</para>
  <para style="q1" vid="JER 5:3">तिनीहरूले आफ्ना अनुहार ढुङ्गाभन्दा कठोर पारे,</para>
  <para style="q2" vid="JER 5:3">र तिनीहरूले पश्‍चात्ताप गर्न इन्कार गरे।<verse eid="JER 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 5:4"/>मैले त सोचेको थिएँ,</para>
  <para style="q2" vid="JER 5:4">“यिनीहरूचाहिँ गरिब छन्, यिनीहरू मूर्ख छन्;</para>
  <para style="q1" vid="JER 5:4">किनकि यिनीहरूले याहवेहका मार्गहरू जान्दैनन्,</para>
  <para style="q2" vid="JER 5:4">यिनीहरूका परमेश्‍वरको आज्ञालाई बुझ्दैनन्।<verse eid="JER 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 5:5"/>यसकारण म तिनीहरूका अगुवाहरूकहाँ जानेछु,</para>
  <para style="q2" vid="JER 5:5">र तिनीहरूसँग कुरा गर्नेछु;</para>
  <para style="q1" vid="JER 5:5">अवश्य नै तिनीहरूले याहवेहका मार्गहरू जान्दछन्,</para>
  <para style="q2" vid="JER 5:5">तिनीहरूका परमेश्‍वरको आज्ञालाई बुझ्दछन्।”</para>
  <para style="q1" vid="JER 5:5">तर तिनीहरूले पनि एकसाथ मिलेर आफ्ना जुवाहरू भाँचेका थिए,</para>
  <para style="q2" vid="JER 5:5">र बन्धनहरू चुँडाएका थिए।<verse eid="JER 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 5:6"/>यसकारण जङ्गलबाट निस्केको सिंहले तिनीहरूलाई आक्रमण गर्नेछ;</para>
  <para style="q2" vid="JER 5:6">मरुभूमिबाट निस्केको ब्वाँसोले तिनीहरूलाई मार्नेछ;</para>
  <para style="q1" vid="JER 5:6">सहरबाट बाहिर निस्कने जो कोहीलाई पनि टुक्रा-टुक्रा पार्नेछन्,</para>
  <para style="q2" vid="JER 5:6">र चितुवा तिनीहरूका सहरहरू नजिकै ढुकिबस्‍नेछ;</para>
  <para style="q1" vid="JER 5:6">किनकि तिनीहरू धेरै बागी भएका छन्;</para>
  <para style="q2" vid="JER 5:6">अनि तिनीहरूका अपराधहरू धेरै छन्।<verse eid="JER 5:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="JER 5:7"/>“मैले तिमीहरूलाई किन क्षमा गरूँ?</para>
  <para style="q2" vid="JER 5:7">तिमीहरूका छोराछोरीहरूले मलाई त्यागेका छन्;</para>
  <para style="q2" vid="JER 5:7">अनि तिनीहरूले झूटा ईश्‍वरहरूका शपथ खाएका छन्, जो ईश्‍वर नै होइनन्।</para>
  <para style="q1" vid="JER 5:7">मैले तिनीहरूका सबै अभाव पूरा गरिदिएँ,</para>
  <para style="q2" vid="JER 5:7">तापनि तिनीहरूले व्यभिचार गरे,</para>
  <para style="q2" vid="JER 5:7">र वेश्याहरूका घरमा भीड लागे।<verse eid="JER 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 5:8"/>तिनीहरू पोसिएर कामवासनाले मातिएका घोडाहरूजस्तै छन्,</para>
  <para style="q2" vid="JER 5:8">जो हरेक छिमेकीका पत्नीको निम्ति हिनहिनाउँछन्।<verse eid="JER 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 5:9"/>के म यी पापहरूका निम्ति तिनीहरूलाई दण्ड नदिऊँ?”</para>
  <para style="q2" vid="JER 5:9">याहवेह घोषणा गर्नुहुन्छ।</para>
  <para style="q1" vid="JER 5:9">“के म यस राष्ट्रमाथि,</para>
  <para style="q2" vid="JER 5:9">मेरो बदला नलिऊँ?<verse eid="JER 5:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="JER 5:10"/>“यहूदाका दाखबारीहरूभित्र जा, र तिनीहरूलाई नाश गर्,</para>
  <para style="q2" vid="JER 5:10">तर तिनीहरूलाई पूर्ण रूपले चाहिँ नाश नगर्।</para>
  <para style="q1" vid="JER 5:10">त्यसका हाँगाहरू लाछिदे;</para>
  <para style="q2" vid="JER 5:10">किनकि यी मानिसहरू याहवेहका होइनन्।<verse eid="JER 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 5:11"/>इस्राएलको घराना र यहूदाको घराना</para>
  <para style="q2" vid="JER 5:11">मप्रति अति नै विश्‍वासघाती भएका छन्,”</para>
  <para style="q2" vid="JER 5:11">याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 5:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="JER 5:12"/>तिनीहरूले याहवेहको बारेमा झूटो बोलेका छन्;</para>
  <para style="q2" vid="JER 5:12">तिनीहरूले, “उहाँले केही गर्नुहुन्‍न!</para>
  <para style="q1" vid="JER 5:12">हामीमाथि कुनै हानि आइपर्नेछैन;</para>
  <para style="q2" vid="JER 5:12">हामीले तरवार र अनिकाल कहिल्यै देख्नेछैनौँ।<verse eid="JER 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 5:13"/>अगमवक्ताहरूले हावाका कुरा मात्रै गर्छन्,</para>
  <para style="q2" vid="JER 5:13">र तिनीहरूमा परमेश्‍वरको वचन छैन;</para>
  <para style="q2" vid="JER 5:13">त्यसैले तिनीहरूले जे भनेका छन्, तिनीहरूमाथि त्यस्तै गरिऊन्।”<verse eid="JER 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 5:14"/>यसकारण सेनाहरूका याहवेह परमेश्‍वर यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="JER 5:14">“यी मानिसहरूले यस्तो वचन बोलेका हुनाले,</para>
  <para style="q2" vid="JER 5:14">म मेरो वचनलाई तेरो मुखमा आगो बनाउनेछु,</para>
  <para style="q2" vid="JER 5:14">र यी मानिसहरूलाई चाहिँ दाउरालाई भस्म पारेजस्तै भस्म पार्नेछु।”<verse eid="JER 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 5:15"/>याहवेह घोषणा गर्नुहुन्छ, “हे इस्राएलको घराना,</para>
  <para style="q2" vid="JER 5:15">म तिमीहरूको विरुद्धमा टाढाको एउटा राष्ट्रलाई ल्याउँदैछु—</para>
  <para style="q1" vid="JER 5:15">एउटा प्राचीन र स्थायी राष्ट्रलाई,</para>
  <para style="q2" vid="JER 5:15">जसको भाषा तिमीहरूले जान्दैनौ,</para>
  <para style="q2" vid="JER 5:15">जसको बोली तिमीहरूले बुझ्दैनौ।<verse eid="JER 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 5:16"/>तिनीहरूको काँडका ठोक्रोहरू खुला चिहानजस्तो छन्;</para>
  <para style="q2" vid="JER 5:16">तिनीहरू सबै वीर योद्धाहरू हुन्।<verse eid="JER 5:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 5:17"/>तिनीहरूले तिमीहरूका फसल र खानेकुरा निल्नेछन्;</para>
  <para style="q2" vid="JER 5:17">तिमीहरूका छोराछोरीहरूलाई निल्नेछन्;</para>
  <para style="q1" vid="JER 5:17">तिनीहरूले तिमीहरूका भेडाबाख्राका बगालहरू र गाईबस्तुका बथानहरू निल्नेछन्;</para>
  <para style="q2" vid="JER 5:17">तिमीहरूका दाखका बोटहरू र नेभाराका रूखहरू नष्‍ट गरिदिनेछन्।</para>
  <para style="q1" vid="JER 5:17">तिमीहरूले भरोसा गरेका सुदृढ सहरहरूलाई,</para>
  <para style="q2" vid="JER 5:17">तिनीहरूका तरवारद्वारा नष्‍ट गरिदिनेछन्।<verse eid="JER 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 5:18"/>“ती दिनहरूमा पनि म तिमीहरूलाई पूर्ण रूपले नाश गर्नेछैनँ,” याहवेह घोषणा गर्नुहुन्छ। <verse eid="JER 5:18"/><verse number="19" style="v" sid="JER 5:19"/>“जब मानिसहरूले सोध्छन्, ‘याहवेह हाम्रा परमेश्‍वरले हामीलाई यो सबै किन गर्नुभएको होला?’ तैँले तिनीहरूलाई यस्तो जवाफ दिनू, ‘जसरी तिमीहरूले मलाई त्याग्यौ र तिमीहरूको आफ्नै देशमा विदेशी देवताहरूको सेवा गर्‍यौ, त्यसरी नै अब तिमीहरूले बिरानो देशमा विदेशीहरूको सेवा गर्नेछौ।’<verse eid="JER 5:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 5:20"/>“याकोबको घरानालाई यसो भन्,</para>
  <para style="q2" vid="JER 5:20">र यहूदाका मानिसहरूलाई यो कुरा घोषणा गर्:<verse eid="JER 5:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 5:21"/>यो कुरा सुन, हे मूर्ख र विवेकहीन मानिसहरू हो,</para>
  <para style="q2" vid="JER 5:21">जसका आँखा त छन्, तर देख्दैनन्,</para>
  <para style="q2" vid="JER 5:21">जसका कान त छन्, तर सुन्दैनन्:<verse eid="JER 5:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 5:22"/>के तिमीहरू मेरो भय मान्दैनौ?”</para>
  <para style="q2" vid="JER 5:22">याहवेह घोषणा गर्नुहुन्छ।</para>
  <para style="q2" vid="JER 5:22">“के तिमीहरू मेरो उपस्थितिमा काम्दैनौ?</para>
  <para style="q1" vid="JER 5:22">मैले बालुवालाई समुद्रको निम्ति सिमाना ठहराएको छु,</para>
  <para style="q2" vid="JER 5:22">समुद्रले सधैँका निम्ति नाघ्न नसक्ने सिमाना बनाएको छु।</para>
  <para style="q1" vid="JER 5:22">छालहरू उर्ले तापनि त्यस सिमानालाई नाघेर जान सक्दैनन्;</para>
  <para style="q2" vid="JER 5:22">तिनीहरू गर्जेलान्, तर त्यसलाई नाघ्न सक्दैनन्।<verse eid="JER 5:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 5:23"/>तर यी मानिसहरूको हृदय हठी र विद्रोही छ;</para>
  <para style="q2" vid="JER 5:23">तिनीहरू मबाट तर्केर अर्को बाटोतिर लागेका छन्।<verse eid="JER 5:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 5:24"/>तिनीहरू आफ्ना हृदयमा यसो भन्दैनन्,</para>
  <para style="q2" vid="JER 5:24">‘हामी याहवेह हाम्रा परमेश्‍वरको डर राखौँ,</para>
  <para style="q1" vid="JER 5:24">जसले ऋतुअनुसार हामीलाई शरद र बसन्तको झरी दिनुहुन्छ,</para>
  <para style="q2" vid="JER 5:24">जसले हामीलाई नियमित फसलका हप्‍ताहरू निश्‍चित गरिदिनुहुन्छ।’<verse eid="JER 5:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 5:25"/>तिमीहरूका अपराधले यी कुराहरू टाढा भएका छन्;</para>
  <para style="q2" vid="JER 5:25">तिमीहरूका कुकर्महरूले तिमीहरू असल कुराबाट बञ्चित भएका छौ।<verse eid="JER 5:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="JER 5:26"/>“मेरा मानिसहरूका बीचमा दुष्‍ट मानिसहरू छन्,</para>
  <para style="q2" vid="JER 5:26">जो चराहरूलाई पासो थाप्न ढुकिबस्‍ने मानिसहरूझैँ</para>
  <para style="q2" vid="JER 5:26">र मानिसहरू पक्रनलाई पासो थाप्नेहरूझैँ छन्।<verse eid="JER 5:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JER 5:27"/>चराहरूले भरिएको पिन्जराझैँ,</para>
  <para style="q2" vid="JER 5:27">तिनीहरूका घर कपटले भरिएका छन्;</para>
  <para style="q1" vid="JER 5:27">तिनीहरू धनी र सामर्थी भएका छन्;<verse eid="JER 5:27"/></para>
  <para style="q2">
    <verse number="28" style="v" sid="JER 5:28"/>अनि तिनीहरू मोटा र चिल्‍ला भएका छन्।</para>
  <para style="q1" vid="JER 5:28">तिनीहरूका दुष्‍ट कामहरूको सीमा नै छैन;</para>
  <para style="q2" vid="JER 5:28">तिनीहरूले न्याय खोज्दैनन्।</para>
  <para style="q1" vid="JER 5:28">तिनीहरूले अनाथहरूको मुद्दा लडिदिँदैनन्;</para>
  <para style="q2" vid="JER 5:28">तिनीहरूले गरिबहरूको अधिकारको रक्षा गर्दैनन्।<verse eid="JER 5:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JER 5:29"/>के म यी कामहरूका निम्ति तिनीहरूलाई दण्ड नदिऊँ?”</para>
  <para style="q2" vid="JER 5:29">याहवेह घोषणा गर्नुहुन्छ।</para>
  <para style="q1" vid="JER 5:29">“के म यस्तो राष्ट्रसँग</para>
  <para style="q2" vid="JER 5:29">बदला नलिऊँ?<verse eid="JER 5:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="JER 5:30"/>“देशमा एउटा डरलाग्दो र विचलित पार्ने</para>
  <para style="q2" vid="JER 5:30">कुरा भएको छ:<verse eid="JER 5:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JER 5:31"/>अगमवक्ताहरूले झूटो अगमवाणी गर्छन्;</para>
  <para style="q2" vid="JER 5:31">पुजारीहरू आफ्नै अधिकारद्वारा शासन गर्छन्;</para>
  <para style="q1" vid="JER 5:31">अनि मेरा मानिसहरूले पनि यस्तै मन पराउँछन्।</para>
  <para style="q2" vid="JER 5:31">तर अन्त्यमा तिमीहरू के गर्नेछौ?<verse eid="JER 5:31"/></para>
  <chapter eid="JER 5"/>
  <chapter number="6" style="c" sid="JER 6"/>
  <para style="s1">यरूशलेम घेरामा परेको</para>
  <para style="q1">
    <verse number="1" style="v" sid="JER 6:1"/>“हे बेन्यामीनीहरू हो, सुरक्षाको निम्ति</para>
  <para style="q2" vid="JER 6:1">यरूशलेमबाट भाग!</para>
  <para style="q1" vid="JER 6:1">तको सहरमा तुरही फुक!</para>
  <para style="q2" vid="JER 6:1">बेथ-हक्‍केरेममा खतराको सङ्केत देओ!</para>
  <para style="q1" vid="JER 6:1">किनकि उत्तर दिशाबाट विपत्ति,</para>
  <para style="q2" vid="JER 6:1">डरलाग्दो विनाश आउँदैछ।<verse eid="JER 6:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 6:2"/>सियोनकी छोरी, जो सुन्दरी र कोमल छे,</para>
  <para style="q2" vid="JER 6:2">म त्यसलाई नाश गर्नेछु।<verse eid="JER 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 6:3"/>गोठालाहरू आ-आफ्ना बगाल लिएर त्यसको विरुद्धमा आउनेछन्;</para>
  <para style="q2" vid="JER 6:3">तिनीहरूले यरूशलेमको चारैतिर आफ्ना पालहरू टाँग्नेछन्;</para>
  <para style="q2" vid="JER 6:3">हरेकले आफ्नै बगालको हेरचाह गर्नेछन्।”<verse eid="JER 6:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="JER 6:4"/>“यरूशलेमको विरुद्धमा लडाइँको तयारी गर!</para>
  <para style="q2" vid="JER 6:4">उठ, हामी मध्यदिनमा आक्रमण गरौँ!</para>
  <para style="q1" vid="JER 6:4">तर, हाय! दिन ढल्किँदैछ;</para>
  <para style="q2" vid="JER 6:4">अनि बेलुकीको छाया लामो हुँदैछ।<verse eid="JER 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 6:5"/>यसकारण उठ, हामी राति त्यसमाथि आक्रमण गरौँ,</para>
  <para style="q2" vid="JER 6:5">र यरूशलेमका किल्‍लाहरू नाश पारिदिऔँ!”<verse eid="JER 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 6:6"/>सेनाहरूका याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="JER 6:6">“रूखहरू काटेर ढालिदेओ,</para>
  <para style="q2" vid="JER 6:6">र यरूशलेमको विरुद्धमा घेरा-मचान बनाओ।</para>
  <para style="q1" vid="JER 6:6">यो सहरले दण्ड पाउनैपर्छ;</para>
  <para style="q2" vid="JER 6:6">यो सहर अत्याचारले भरिएको छ।<verse eid="JER 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 6:7"/>जसरी इनारबाट पानी निस्कन्छ,</para>
  <para style="q2" vid="JER 6:7">त्यसरी नै त्यसले आफ्नो दुष्‍टता निकाल्छे।</para>
  <para style="q1" vid="JER 6:7">त्यसभित्र हिंसा र विनाश गुञ्जिन्छ;</para>
  <para style="q2" vid="JER 6:7">त्यसका रोगहरू र चोटहरू सधैँ मेरा सामु छन्।<verse eid="JER 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 6:8"/>हे यरूशलेम यो चेतावनी सुन्,</para>
  <para style="q2" vid="JER 6:8">नत्रता म तँदेखि टाढा हुनेछु,</para>
  <para style="q1" vid="JER 6:8">र तेरो देशलाई उजाड पारिदिनेछु;</para>
  <para style="q2" vid="JER 6:8">अनि त्यहाँ कोही पनि बास गर्नेछैन।”<verse eid="JER 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 6:9"/>सेनाहरूका याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="JER 6:9">“तिनीहरूले इस्राएलका बाँकी रहेकाहरूलाई</para>
  <para style="q2" vid="JER 6:9">दाखको बोटमा छोडिएका फल नछोडी टिपेझैँ टिपून्;</para>
  <para style="q1" vid="JER 6:9">कुनै मानिसले अङ्‌गुरहरू बटुलेझैँ,</para>
  <para style="q2" vid="JER 6:9">आफ्नो हात फेरि ती दाखका हाँगाहरूमा लगा।”<verse eid="JER 6:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="JER 6:10"/>म कोसँग बोलूँ र कसलाई चेतावनी दिऊँ?</para>
  <para style="q2" vid="JER 6:10">मेरो कुरा कसले सुन्ला?</para>
  <para style="q1" vid="JER 6:10">तिनीहरूका कान बन्द<note caller="+" style="f"><char style="fr" closed="false">6:10 </char><char style="ft" closed="false">मूल भाषामा </char><char style="fqa" closed="false">बेखतना</char></note> भएका छन्।</para>
  <para style="q2" vid="JER 6:10">त्यसैले तिनीहरू सुन्‍न सक्दैनन्।</para>
  <para style="q1" vid="JER 6:10">याहवेहको वचन तिनीहरूलाई मन पर्दैन;</para>
  <para style="q2" vid="JER 6:10">तिनीहरू वचन सुन्‍नै चाहँदैनन्।<verse eid="JER 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 6:11"/>यसकारण म याहवेहको क्रोधले भरिएको छु;</para>
  <para style="q2" vid="JER 6:11">अनि म यसलाई थामिराख्न सक्दिनँ।</para>
  <para style="b" vid="JER 6:11"/>
  <para style="q1" vid="JER 6:11">“यसलाई सडकमा भएका केटाकेटीहरू</para>
  <para style="q2" vid="JER 6:11">र एकसाथ भेला भएका जवान मानिसहरूमाथि;</para>
  <para style="q1" vid="JER 6:11">पति र पत्नी दुवै,</para>
  <para style="q2" vid="JER 6:11">र वृद्धहरूमाथि खन्याइदेओ।<verse eid="JER 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 6:12"/>जब मेरो हात</para>
  <para style="q2" vid="JER 6:12">यस देशमा बाँचेकाहरूका विरुद्धमा बढाउँछु,</para>
  <para style="q1" vid="JER 6:12">तब तिनीहरूका घर, खेतबारी</para>
  <para style="q2" vid="JER 6:12">र पत्नीहरूसमेत अरू मानिसहरूलाई दिइनेछन्,”</para>
  <para style="q2" vid="JER 6:12">याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 6:13"/>“सबैभन्दा सानादेखि लिएर सबैभन्दा ठूलासम्म</para>
  <para style="q2" vid="JER 6:13">हरेक अनुचित धन कमाइको निम्ति लोभी छन्।</para>
  <para style="q1" vid="JER 6:13">अगमवक्ता र पुजारीहरू</para>
  <para style="q2" vid="JER 6:13">सबै छलका कुरा गर्छन्।<verse eid="JER 6:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 6:14"/>तिनीहरूले मेरा मानिसहरूका घाउहरूमा</para>
  <para style="q2" vid="JER 6:14">लापर्बाही तरिकाले मलमपट्टी बाँधिदिन्छन्।</para>
  <para style="q1" vid="JER 6:14">शान्ति नहुँदा पनि</para>
  <para style="q2" vid="JER 6:14">तिनीहरूले, ‘शान्ति, शान्ति’ भन्दछन्।<verse eid="JER 6:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 6:15"/>के तिनीहरू आफ्ना घृणित आचरणहरूप्रति लज्जित छन् र?</para>
  <para style="q2" vid="JER 6:15">अहँ, तिनीहरूलाई अलिकति पनि लाज लाग्दैन।</para>
  <para style="q2" vid="JER 6:15">तिनीहरू कसरी लाज मान्‍ने भन्‍ने पनि जान्दैनन्।</para>
  <para style="q1" vid="JER 6:15">यसकारण तिनीहरू पतन भएकाहरूसँग पतन हुनेछन्;</para>
  <para style="q2" vid="JER 6:15">जब म तिनीहरूलाई दण्ड दिन्छु, तब तिनीहरू नष्‍ट हुनेछन्,”</para>
  <para style="q2" vid="JER 6:15">याहवेह भन्‍नुहुन्छ।<verse eid="JER 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 6:16"/>याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="JER 6:16">“चौबाटोमा उभिएर हेर,</para>
  <para style="q2" vid="JER 6:16">र प्राचीन मार्गको बारेमा सोध;</para>
  <para style="q1" vid="JER 6:16">त्यो असल मार्ग कहाँ छ, सोध र त्यसैमा हिँड,</para>
  <para style="q2" vid="JER 6:16">तब तिमीहरूले आफ्नो आत्मामा विश्राम पाउनेछौ।</para>
  <para style="q2" vid="JER 6:16">तर तिमीहरूले भन्यौ, ‘हामी यस मार्गमा हिँड्नेछैनौँ।’<verse eid="JER 6:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 6:17"/>मैले तिमीहरूमाथि पहरेदारहरू नियुक्त गरेर भनेँ,</para>
  <para style="q2" vid="JER 6:17">‘तुरहीको आवाजलाई ध्यानसित सुन!’</para>
  <para style="q2" vid="JER 6:17">तर तिमीहरूले भन्यौ, ‘हामी सुन्‍नेछैनौँ।’<verse eid="JER 6:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 6:18"/>यसकारण हे राष्ट्रहरू हो, सुन;</para>
  <para style="q2" vid="JER 6:18">हे साक्षीहरू हो,</para>
  <para style="q2" vid="JER 6:18">तिनीहरूलाई के हुँदोरहेछ, सो ध्यानसित हेर।<verse eid="JER 6:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 6:19"/>हे पृथ्वी, सुन्;</para>
  <para style="q2" vid="JER 6:19">तिनीहरूकै योजनाको फलस्वरूप,</para>
  <para style="q2" vid="JER 6:19">म यस जातिमाथि विपत्ति ल्याउँदैछु;</para>
  <para style="q1" vid="JER 6:19">किनकि तिनीहरूले मेरा वचनहरू सुनेनन्,</para>
  <para style="q2" vid="JER 6:19">र मेरा व्यवस्थाहरूलाई इन्कार गरे।<verse eid="JER 6:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 6:20"/>शेबादेखि ल्याएको धूप</para>
  <para style="q2" vid="JER 6:20">अथवा टाढा देशबाट ल्याएको बोझो मलाई के मतलब छ र?</para>
  <para style="q1" vid="JER 6:20">तिमीहरूका होमबलिहरू ग्रहणयोग्य छैनन्;</para>
  <para style="q2" vid="JER 6:20">तिमीहरूका बलिदानहरू मेरा निम्ति मनपर्दा छैनन्।”<verse eid="JER 6:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JER 6:21"/>यसकारण याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="JER 6:21">“म यस जातिको सामु ठेस लाग्ने कुराहरू राखिदिनेछु।</para>
  <para style="q2" vid="JER 6:21">बुबा र छोराछोरीहरू एकसाथ ती कुरामा ठेस खानेछन्;</para>
  <para style="q2" vid="JER 6:21">छिमेकीहरू र मित्रहरू नष्‍ट हुनेछन्।”<verse eid="JER 6:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JER 6:22"/>याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="JER 6:22">“हेर, उत्तर देशबाट</para>
  <para style="q2" vid="JER 6:22">एक दल सेना आउँदैछ।</para>
  <para style="q1" vid="JER 6:22">पृथ्वीको अन्तिम सिमानाबाट</para>
  <para style="q2" vid="JER 6:22">एउटा ठूलो राष्ट्रलाई सुर्‍याइरहेको छ।<verse eid="JER 6:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 6:23"/>तिनीहरू धनु र भालाले सुसज्जित भएका छन्;</para>
  <para style="q2" vid="JER 6:23">तिनीहरू निर्दयी छन् र दया देखाउँदैनन्।</para>
  <para style="q1" vid="JER 6:23">तिनीहरू आफ्ना घोडाहरूमाथि सवार हुँदा</para>
  <para style="q2" vid="JER 6:23">तिनीहरूको आवाज समुद्रको गर्जनजस्तै सुनिन्छ;</para>
  <para style="q1" vid="JER 6:23">हे यरूशलेमकी छोरी, तँलाई आक्रमण गर्नका लागि</para>
  <para style="q2" vid="JER 6:23">तिनीहरू युद्धको पङ्‌क्ति बाँधेर आइरहेका छन्।”<verse eid="JER 6:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="JER 6:24"/>हामीले तिनीहरूको बारेमा खबर सुन्यौँ,</para>
  <para style="q2" vid="JER 6:24">र हाम्रा हातहरू लल्याकलुलुक भए।</para>
  <para style="q1" vid="JER 6:24">प्रसुती वेदनामा परेकी स्त्रीझैँ</para>
  <para style="q2" vid="JER 6:24">हामी छटपटिएका छौँ।<verse eid="JER 6:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 6:25"/>खेततिर काम गर्न नजाओ,</para>
  <para style="q2" vid="JER 6:25">न त सडकतिर हिँड्‍डुल गर;</para>
  <para style="q1" vid="JER 6:25">किनकि शत्रुसित तरवार छ,</para>
  <para style="q2" vid="JER 6:25">र चारैतिर डरैडर देखिँदैछ।<verse eid="JER 6:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JER 6:26"/>हे मेरा मानिसहरू हो, भाङ्ग्रा लगाओ;</para>
  <para style="q2" vid="JER 6:26">अनि खरानीमा लडीबुडी गर।</para>
  <para style="q1" vid="JER 6:26">एक मात्र छोराका निम्ति</para>
  <para style="q2" vid="JER 6:26">विलाप गरेझैँ शोक गर;</para>
  <para style="q1" vid="JER 6:26">किनकि विनाशकारी</para>
  <para style="q2" vid="JER 6:26">हामीमाथि अचानक आइलाग्नेछ।<verse eid="JER 6:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="JER 6:27"/>“मैले तँलाई धातु जाँच्ने वस्तु</para>
  <para style="q2" vid="JER 6:27">र मानिसहरूलाई कच्‍चा धातु बनाएको छु,</para>
  <para style="q1" vid="JER 6:27">ताकि तैँले तिनीहरूलाई ध्यानसित हेर्न</para>
  <para style="q2" vid="JER 6:27">र तिनीहरूका मार्गहरू जाँच गर्न सक्।<verse eid="JER 6:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JER 6:28"/>तिनीहरू सबै निन्दा गर्दै,</para>
  <para style="q2" vid="JER 6:28">यताउति डुलिहिँड्ने कठोर विद्रोहीहरू हुन्।</para>
  <para style="q1" vid="JER 6:28">तिनीहरू काँसा र फलाम हुन्;</para>
  <para style="q2" vid="JER 6:28">तिनीहरू सबै भ्रष्‍ट चालहरूमा चल्दछन्।<verse eid="JER 6:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JER 6:29"/>आरनमा सिसा जलाउनका लागि खूब जोडसित आगो फुकिन्छ,</para>
  <para style="q2" vid="JER 6:29">तर खार्ने काम व्यर्थै जान्छ;</para>
  <para style="q1" vid="JER 6:29">त्यसरी नै मेरा मानिसहरू यति दुष्‍ट छन्, कि</para>
  <para style="q2" vid="JER 6:29">तिनीहरूबाट दुष्‍ट्याइँ हटाउन सकिँदैन।<verse eid="JER 6:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JER 6:30"/>तिनीहरूलाई खोट लागेको चाँदी भनिन्छ;</para>
  <para style="q2" vid="JER 6:30">किनकि याहवेहले तिनीहरूलाई त्याग्नुभएको छ।”<verse eid="JER 6:30"/></para>
  <chapter eid="JER 6"/>
  <chapter number="7" style="c" sid="JER 7"/>
  <para style="s1">झूटो धर्मको व्यर्थता</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 7:1"/>यर्मियाकहाँ आएको याहवेहको वचन यही हो: <verse eid="JER 7:1"/><verse number="2" style="v" sid="JER 7:2"/>“याहवेहको भवनको मूलढोकामा उभिएर त्यहाँ यो सन्देश घोषणा गर्:</para>
  <para style="p" vid="JER 7:2">“ ‘याहवेहलाई आराधना गर्न यी मूलढोकाहरूबाट भित्र प्रवेश गर्ने हे यहूदाका सबै मानिसहरू हो, याहवेहको वचन सुन! <verse eid="JER 7:2"/><verse number="3" style="v" sid="JER 7:3"/>इस्राएलका परमेश्‍वर, सेनाहरूका याहवेह यसो भन्‍नुहुन्छ: तिमीहरूका जीवनशैली र कामहरू सुधार; अनि म तिमीहरूलाई यस ठाउँमा बस्‍न दिनेछु। <verse eid="JER 7:3"/><verse number="4" style="v" sid="JER 7:4"/>छली कुराहरूमा विश्‍वास गरेर यसो नभन, “यो याहवेहको भवन हो, याहवेहको भवन हो, याहवेहको भवन हो!” <verse eid="JER 7:4"/><verse number="5" style="v" sid="JER 7:5"/>यदि तिमीहरूले आफ्ना जीवनशैलीहरू र आफ्ना कामहरू साँच्‍चै परिवर्तन गर्‍यौ र एक-आपसमा न्यायसङ्गत व्यवहार गर्‍यौ भने, <verse eid="JER 7:5"/><verse number="6" style="v" sid="JER 7:6"/>यदि तिमीहरूले यस ठाउँमा विदेशीहरूमाथि, टुहुरा-टुहुरीहरूमाथि, र विधवाहरूमाथि अत्याचार गरेनौ भने वा निर्दोषहरूको रगत बगाएनौ भने, र आफ्नै खराबीका निम्ति अरू देवी-देवताहरूका पछि लागेनौ भने, <verse eid="JER 7:6"/><verse number="7" style="v" sid="JER 7:7"/>तब म तिमीहरूलाई यस देशमा बस्‍न दिनेछु, जुन देश मैले तिमीहरूका पितापुर्खाहरूलाई सदाका निम्ति दिएको थिएँ। <verse eid="JER 7:7"/><verse number="8" style="v" sid="JER 7:8"/>हेर, तिमीहरू व्यर्थका झूटा वचनहरूमा भरोसा गर्दैछौ।<verse eid="JER 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 7:9"/>“ ‘के तिमीहरू साँच्‍चै चोरी, हत्या, व्यभिचार गर्छौ, र झूटो शपथ खान्छौ; बाल-देवतालाई धूप बाल्छौ र तिमीहरूले नजानेका अरू देवी-देवताहरूलाई पछ्याउँछौ, <verse eid="JER 7:9"/><verse number="10" style="v" sid="JER 7:10"/>अनि आएर मेरो नाम बोकेको यस भवनमा मेरो सामु उभिएर भन्छौ, “हामी सुरक्षित छौँ!” हामी यी सबै घिनलाग्दा काम गर्न भनी ढुक्‍क छौँ? <verse eid="JER 7:10"/><verse number="11" style="v" sid="JER 7:11"/>के मेरो नाम बोकेको यो भवन तिमीहरूका निम्ति डाँकुहरूको ओडार भएको छ? तर मैले देखेको छु! याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 7:12"/>“ ‘अब शीलोको त्यो ठाउँमा जाओ, जहाँ मैले पहिले मेरो नामको निवासस्थान बनाएको थिएँ। मेरा प्रजा इस्राएलीको दुष्‍टताको कारण मैले त्यस ठाउँलाई के गरेको छु, त्यो हेर। <verse eid="JER 7:12"/><verse number="13" style="v" sid="JER 7:13"/>याहवेह घोषणा गर्नुहुन्छ, तिमीहरूले यी कुराहरू गरिरहँदा म तिमीहरूसँग बारम्बार बोलेँ, तर तिमीहरूले सुनेनौ। मैले तिमीहरूलाई बोलाएँ, तर तिमीहरूले जवाफै दिएनौ। <verse eid="JER 7:13"/><verse number="14" style="v" sid="JER 7:14"/>यसकारण मैले शीलोलाई जे गरेको थिएँ, अब म मेरो नाम बोकेको भवनलाई त्यही गर्नेछु, जसमा तिमीहरू भरोसा राख्दछौ, मैले त्यो ठाउँ तिमीहरू र तिमीहरूका पितापुर्खाहरूलाई दिएको थिएँ। <verse eid="JER 7:14"/><verse number="15" style="v" sid="JER 7:15"/>मैले एफ्राइमका मानिसहरू, तिमीहरूका दाजुभाइ इस्राएलीहरूलाई फ्याँकेझैँ, म तिमीहरूलाई आफ्नो उपस्थितिबाट फ्याँकिदिनेछु।’<verse eid="JER 7:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 7:16"/>“यसकारण यर्मिया यी मानिसहरूका निम्ति प्रार्थना नगर्, न त तिनीहरूका निम्ति कुनै बिलौना वा बिन्ती गर्। मसित अर्जबिन्ती नचढा; किनकि म तेरो कुरा सुन्‍नेछैनँ। <verse eid="JER 7:16"/><verse number="17" style="v" sid="JER 7:17"/>तिनीहरूले यहूदाका सहरहरूमा र यरूशलेमका सडकहरूमा के गरिरहेका छन्, के तैँले त्यो देख्दैनस्? <verse eid="JER 7:17"/><verse number="18" style="v" sid="JER 7:18"/>तिनीहरूका छोराछोरीले दाउरा बटुल्छन्, बुबाहरूले आगो बाल्छन्; अनि स्त्रीहरू स्वर्गकी रानीका निम्ति फुलौरा चढाउन पिठो मुछ्छन्। मलाई रिस उठाउनलाई तिनीहरूले अरू देवी-देवताहरूकहाँ अर्घबलि चढाउँछन्। <verse eid="JER 7:18"/><verse number="19" style="v" sid="JER 7:19"/>तर तिनीहरूले के मलाई उक्साइरहेका हुन् र? याहवेह भन्‍नुहुन्छ, के तिनीहरूले आफैँलाई लज्जित तुल्याइरहेका र आफूलाई नै खराबी गरिरहेका छैनन् र?<verse eid="JER 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 7:20"/>“ ‘यसकारण प्रभु याहवेह यसो भन्‍नुहुन्छ: मेरो रिस र मेरो क्रोध यस मन्दिरमाथि, मानिस र पशुहरूमाथि, खेतका रूख र भुइँका फसलहरूमाथि खन्याउनेछु। यो आगोझैँ बलिरहनेछ र कसैले निभाउन सक्नेछैन।<verse eid="JER 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JER 7:21"/>“ ‘सेनाहरूका याहवेह, इस्राएलका परमेश्‍वर यसो भन्‍नुहुन्छ: तिमीहरूका अरू बलिदानहरूमा होमबलिहरू थप, र त्यो मासुचाहिँ तिमीहरू आफैँले खाओ! <verse eid="JER 7:21"/><verse number="22" style="v" sid="JER 7:22"/>किनकि जब मैले तिमीहरूका पितापुर्खाहरूलाई इजिप्टबाट बाहिर निकालेर ल्याएँ, त्यस दिन जब म तिनीहरूसँग बोलेँ, तब मैले तिनीहरूलाई होमबलि र बलिदानहरूको विषयमा आज्ञा दिइनँ, <verse eid="JER 7:22"/><verse number="23" style="v" sid="JER 7:23"/>तर मैले तिनीहरूलाई यो आज्ञा दिएँ: मेरा आज्ञापालन गर, र म तिमीहरूका परमेश्‍वर हुनेछु; अनि तिमीहरू मेरा मानिसहरू हुनेछौ। मैले तिमीहरूलाई दिएको आज्ञाअनुसार सबै मार्गहरूमा हिँड, ताकि तिमीहरूको भलो होस्। <verse eid="JER 7:23"/><verse number="24" style="v" sid="JER 7:24"/>तर तिनीहरूले आज्ञापालन गरेनन्, न त ध्यान नै दिए। त्यसका सट्टामा तिनीहरू आफ्ना दुष्‍ट हृदयका हठी इच्छाअनुसार हिँडे। तिनीहरू मबाट धेरै टाढा गए, र तिनीहरूले आफ्ना पिठिउँ मतिर फर्काए। <verse eid="JER 7:24"/><verse number="25" style="v" sid="JER 7:25"/>तिमीहरूका पितापुर्खाहरूले इजिप्ट छोडेको समयदेखि आजसम्म, दिनहुँ बारम्बार मैले मेरा सेवक अगमवक्ताहरूलाई तिमीहरूकहाँ पठाएँ। <verse eid="JER 7:25"/><verse number="26" style="v" sid="JER 7:26"/>तर तिनीहरूले मेरा आज्ञाहरू पालन गरेनन्, न त ध्यान नै दिए। तिनीहरू हठी भए; अनि तिनीहरूले आफ्ना पितापुर्खाहरूले भन्दा बढी दुष्‍ट कामहरू गरे।’<verse eid="JER 7:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JER 7:27"/>“जब तैँले यहूदाका मानिसहरूलाई यी सबै कुरा भन्छस्, तब तिनीहरूले तेरा कुराहरू सुन्‍नेछैनन्; तैँले तिनीहरूलाई बोलाए तापनि तिनीहरूले तँलाई जवाफ दिनेछैनन्। <verse eid="JER 7:27"/><verse number="28" style="v" sid="JER 7:28"/>यसकारण तिनीहरूलाई यसो भन्, ‘यो राष्ट्र, जसले याहवेह आफ्ना परमेश्‍वरको आज्ञापालन गरेको छैन, अथवा सुधारलाई ग्रहण गरेको छैन। सत्यता नष्‍ट भइसकेको छ। तिनीहरूका ओठबाट सत्यता लोप भइसकेको छ।<verse eid="JER 7:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JER 7:29"/>“ ‘तेरो केश खौरेर टाढा फ्याँकिदे, र अग्ला नाङ्गा डाँडाहरूमा गएर विलाप गर्; किनकि उहाँको रिसमा याहवेहले यो पुस्तालाई पूर्ण रूपमा इन्कार गर्नुभएको छ।<verse eid="JER 7:29"/></para>
  <para style="s1">हत्याको बेँसी</para>
  <para style="p">
    <verse number="30" style="v" sid="JER 7:30"/>“ ‘यहूदाका मानिसहरूले मेरो दृष्‍टिमा दुष्‍ट काम गरेका छन्, याहवेह घोषणा गर्नुहुन्छ। तिनीहरूले मेरो नाम बोकेको मेरो भवनमा तिनीहरूका घिनलाग्दा मूर्तिहरू खडा गरेका छन् र भवनलाई अशुद्ध पारेका छन्। <verse eid="JER 7:30"/><verse number="31" style="v" sid="JER 7:31"/>तिनीहरूका छोराछोरीहरूलाई आगोमा जलाउनलाई बेन-हिन्‍नोमको बेँसी तोपेतमा अग्ला ठाउँहरू निर्माण गरेका छन्—जुन कुरा न मैले तिनीहरूलाई आज्ञा गरेको थिएँ, न त मैले मेरो मनमा सोचेको थिएँ। <verse eid="JER 7:31"/><verse number="32" style="v" sid="JER 7:32"/>यसकारण होसियार रहो, ती दिनहरू आउँदैछन्, याहवेह घोषणा गर्नुहुन्छ, जब मानिसहरूले यस बेँसीलाई तोपेत अथवा बेन-हिन्‍नोमको बेँसी होइन, तर हत्याको बेँसी भन्‍नेछन्, तब तिनीहरूले तोपेतमा कुनै ठाउँ नै नरहुन्जेल मृतकहरूलाई गाड्नेछन्। <verse eid="JER 7:32"/><verse number="33" style="v" sid="JER 7:33"/>तब मानिसहरूका मृत शरीरहरू आकाशका चराहरू र जमिनका पशुहरूका निम्ति आहारा हुनेछन्; अनि तिनीहरूलाई तर्साएर धपाउने कोही पनि हुनेछैनन्। <verse eid="JER 7:33"/><verse number="34" style="v" sid="JER 7:34"/>म यहूदाका सहरहरू र यरूशलेमका गल्‍लीहरूमा हर्ष र आनन्दको सोर, दुलहा र दुलहीको सोर अन्त्य गरिदिनेछु; किनकि देश उजाड हुनेछ।<verse eid="JER 7:34"/></para>
  <chapter eid="JER 7"/>
  <chapter number="8" style="c" sid="JER 8"/>
  <para style="p">
    <verse number="1" style="v" sid="JER 8:1"/>“ ‘याहवेह घोषणा गर्नुहुन्छ: त्यस बेला यहूदाका राजाहरू र अधिकारीहरू, पुजारीहरू र अगमवक्ताहरूका हड्डीहरू र यरूशलेमका मानिसहरूका हड्डीहरू तिनीहरूका चिहानहरूबाट हटाइनेछन्। <verse eid="JER 8:1"/><verse number="2" style="v" sid="JER 8:2"/>तिनीहरूका हड्डीहरू घाम, जुन र आकाशका ताराहरूमुनि फिँजाइनेछन्, जसलाई तिनीहरूले प्रेम गरेका थिए, सेवा गरेका थिए; अनि जसलाई तिनीहरूले पछ्याएका थिए, त्यससँग सल्‍लाह मागेका थिए र पूजा गरेका थिए। ती हड्डीहरू बटुलिने छैनन्, अथवा गाडिनेछैनन्, तर ती हड्डीहरू जमिनमा जनावरका मलजस्तै फिँजाइनेछन्। <verse eid="JER 8:2"/><verse number="3" style="v" sid="JER 8:3"/>म जहाँ-जहाँ तिनीहरूलाई निर्वासनमा पठाउँछु, यस दुष्‍ट जातिका बाँचेकाहरू सबैले जीवनभन्दा मृत्यु नै रुचाउनेछन्, सेनाहरूका याहवेह घोषणा गर्नुहुन्छ।’<verse eid="JER 8:3"/></para>
  <para style="s1">पाप र दण्ड</para>
  <para style="p">
    <verse number="4" style="v" sid="JER 8:4"/>“तिनीहरूलाई यो पनि भन्, ‘याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="JER 8:4">“ ‘जब मानिसहरू लड्दछन्, के तिनीहरू उठ्दैनन् र?</para>
  <para style="q2" vid="JER 8:4">जब कोही मानिस तर्केर जान्छ, के त्यो फेरि फर्कंदैन र?<verse eid="JER 8:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 8:5"/>त्यसो भए यी मानिसहरू किन तर्किगएका छन्?</para>
  <para style="q2" vid="JER 8:5">यरूशलेम किन सधैँ तर्किएर जान्छ?</para>
  <para style="q1" vid="JER 8:5">तिनीहरू झूटा कुराहरूमा अल्झिरहन्छन्;</para>
  <para style="q2" vid="JER 8:5">तिनीहरू फर्कन अस्वीकार गर्दछन्।<verse eid="JER 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 8:6"/>मैले ध्यानपूर्वक सुनेको छु,</para>
  <para style="q2" vid="JER 8:6">तर तिनीहरूले सही के हो, त्यो बोल्दैनन्।</para>
  <para style="q1" vid="JER 8:6">तिनीहरू, “मैले के गरेको छु र?” भन्दै,</para>
  <para style="q2" vid="JER 8:6">कसैले पनि आफ्नो दुष्‍टताको पश्‍चात्ताप गर्दैनन्।</para>
  <para style="q1" vid="JER 8:6">युद्धको निम्ति घोडा जाइलागेझैँ,</para>
  <para style="q2" vid="JER 8:6">तिनीहरू हरेक आफ्नै मार्गमा चलेका छन्।<verse eid="JER 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 8:7"/>आकाशका सारसले पनि</para>
  <para style="q2" vid="JER 8:7">आफ्नो तोकिएको ऋतुहरू जान्दछ;</para>
  <para style="q1" vid="JER 8:7">अनि ढुकुर, गौँथली र मैनाले पनि</para>
  <para style="q2" vid="JER 8:7">आफ्नो बसाइँ सर्ने समय जान्दछन्,</para>
  <para style="q1" vid="JER 8:7">तर मेरा मानिसहरूले</para>
  <para style="q2" vid="JER 8:7">याहवेहले आज्ञा गर्नुभएका कुराहरू पालन गर्न जान्दैनन्।<verse eid="JER 8:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="JER 8:8"/>“ ‘तिमीहरूले कसरी भन्‍न सक्छौ, “हामी बुद्धिमान् छौँ,</para>
  <para style="q2" vid="JER 8:8">किनकि हामीसँग याहवेहको व्यवस्था छ,”</para>
  <para style="q1" vid="JER 8:8">जबकि वास्तवमा शास्त्रीहरूको झूटो कलमले</para>
  <para style="q2" vid="JER 8:8">व्यवस्थालाई झूटो तुल्याएको छ?<verse eid="JER 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 8:9"/>बुद्धिमान्‌हरू शर्ममा पर्नेछन्;</para>
  <para style="q2" vid="JER 8:9">तिनीहरू हताश हुनेछन् र पासोमा पर्नेछन्।</para>
  <para style="q1" vid="JER 8:9">किनभने तिनीहरूले याहवेहको वचनलाई अस्वीकार गरेका छन्।</para>
  <para style="q2" vid="JER 8:9">तिनीहरूसँग कस्तो बुद्धि छ?<verse eid="JER 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 8:10"/>यसकारण म तिनीहरूका पत्नीहरू अरू मानिसहरूलाई</para>
  <para style="q2" vid="JER 8:10">र तिनीहरूका खेतहरू नयाँ मालिकलाई दिनेछु।</para>
  <para style="q1" vid="JER 8:10">सबैभन्दा सानादेखि लिएर सबैभन्दा ठूलासम्म</para>
  <para style="q2" vid="JER 8:10">हरेक अनुचित धन कमाइको निम्ति लोभी छन्।</para>
  <para style="q1" vid="JER 8:10">अगमवक्ताहरू र पुजारीहरूसमेत</para>
  <para style="q2" vid="JER 8:10">सबैले छल गर्दछन्।<verse eid="JER 8:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 8:11"/>तिनीहरूले मेरा मानिसहरूका घाउहरूमा</para>
  <para style="q2" vid="JER 8:11">लापर्बाही तरिकाले मलमपट्टी बाँधिदिन्छन्।</para>
  <para style="q1" vid="JER 8:11">शान्ति नहुँदा पनि,</para>
  <para style="q2" vid="JER 8:11">तिनीहरूले, “शान्ति, शान्ति,” भन्दछन्।<verse eid="JER 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 8:12"/>के तिनीहरू आफ्ना घृणित आचरणहरूप्रति लज्जित छन् र?</para>
  <para style="q2" vid="JER 8:12">अहँ, तिनीहरूलाई अलिकति पनि लाज लाग्दैन।</para>
  <para style="q2" vid="JER 8:12">तिनीहरू कसरी लाज मान्‍ने भन्‍ने पनि जान्दैनन्।</para>
  <para style="q1" vid="JER 8:12">यसकारण तिनीहरू पतन भएकाहरूसँग पतन हुनेछन्।</para>
  <para style="q2" vid="JER 8:12">जब म तिनीहरूलाई दण्ड दिन्छु, तब तिनीहरू नष्‍ट हुनेछन्,</para>
  <para style="q2" vid="JER 8:12">याहवेह भन्‍नुहुन्छ।<verse eid="JER 8:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JER 8:13"/>“ ‘याहवेह घोषणा गर्नुहुन्छ:</para>
  <para style="q2" vid="JER 8:13">म तिनीहरूका फसलहरू लैजानेछु।</para>
  <para style="q2" vid="JER 8:13">दाखका बोटहरूमा अङ्‌गुरहरू हुनेछैनन्।</para>
  <para style="q1" vid="JER 8:13">नेभाराको बोटमा फल हुनेछैन;</para>
  <para style="q2" vid="JER 8:13">अनि तिनीहरूका पातहरू ओइलाउनेछन्।</para>
  <para style="q1" vid="JER 8:13">मैले तिनीहरूलाई जे जति दिएको छु,</para>
  <para style="q2" vid="JER 8:13">ती तिनीहरूबाट खोसिनेछन्।’ ”<verse eid="JER 8:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="JER 8:14"/>हामी यहाँ किन चुप लागेर बसिरहेका छौँ?</para>
  <para style="q2" vid="JER 8:14">एकसाथ भेला होऔँ!</para>
  <para style="q1" vid="JER 8:14">हामी सुरक्षित सहरहरूतिर भागौँ</para>
  <para style="q2" vid="JER 8:14">र त्यहीँ नै नष्‍ट होऔँ!</para>
  <para style="q1" vid="JER 8:14">किनकि याहवेह हाम्रा परमेश्‍वरले हाम्रो विनाशको निर्णय गर्नुभएको छ;</para>
  <para style="q2" vid="JER 8:14">अनि हामीलाई विषालु पानी पिउनलाई दिनुभएको छ;</para>
  <para style="q2" vid="JER 8:14">किनकि हामीले उहाँको विरुद्धमा पाप गरेका छौँ।<verse eid="JER 8:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 8:15"/>हामीले शान्तिको आशा गरेका थियौँ,</para>
  <para style="q2" vid="JER 8:15">तर कुनै पनि असल कुरा भएको छैन।</para>
  <para style="q1" vid="JER 8:15">निको हुने आशा गरेका थियौँ,</para>
  <para style="q2" vid="JER 8:15">तर त्यहाँ आतङ्क मात्र भएको छ।<verse eid="JER 8:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 8:16"/>दानबाट शत्रुका घोडाहरूका आवाज</para>
  <para style="q2" vid="JER 8:16">सुनिँदैछ।</para>
  <para style="q1" vid="JER 8:16">तिनीहरूका घोडाहरूको हिनहिनाएको आवाजमा</para>
  <para style="q2" vid="JER 8:16">सारा देश थरथर काम्दछ।</para>
  <para style="q1" vid="JER 8:16">तिनीहरू देश र त्यसमा भएका हरेक कुराहरू,</para>
  <para style="q2" vid="JER 8:16">सहर र त्यहाँ बस्‍ने सबै मानिसहरूलाई</para>
  <para style="q2" vid="JER 8:16">नाश गर्न आएका छन्।<verse eid="JER 8:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="JER 8:17"/>“हेर, म तिमीहरूका बीचमा विषालु सर्पहरू पठाउनेछु।</para>
  <para style="q2" vid="JER 8:17">त्यस्ता सर्पहरू जसलाई वशमा पार्न सकिँदैन;</para>
  <para style="q2" vid="JER 8:17">अनि तिनीहरूले तिमीहरूलाई डस्‍नेछन्,”</para>
  <para style="q2" vid="JER 8:17">याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 8:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="JER 8:18"/>हे मेरा दुःखमा सान्त्वना दिने,</para>
  <para style="q2" vid="JER 8:18">मेरो हृदय मभित्र दुर्बल भएको छ।<verse eid="JER 8:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 8:19"/>टाढाबाट मेरा मानिसहरूको चिच्याहट,</para>
  <para style="q2" vid="JER 8:19">मेरा मानिसहरूका क्रन्दन सुन्‍नुहोस्:</para>
  <para style="q1" vid="JER 8:19">“के याहवेह सियोनमा हुनुहुन्‍न?</para>
  <para style="q2" vid="JER 8:19">के सियोनको राजा अब त्यहाँ हुनुहुन्‍न?”</para>
  <para style="b" vid="JER 8:19"/>
  <para style="q1" vid="JER 8:19">“किन तिनीहरूले तिनीहरूका कुँदिएका मूर्तिहरू र</para>
  <para style="q2" vid="JER 8:19">तिनीहरूका काम नलाग्ने विदेशी मूर्तिहरूले मलाई रिस उठाएका छन्?”<verse eid="JER 8:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="JER 8:20"/>“कटनीको समय बितिसकेको छ;</para>
  <para style="q2" vid="JER 8:20">ग्रीष्म ऋतु समाप्‍त भइसकेको छ,</para>
  <para style="q2" vid="JER 8:20">तर पनि हाम्रोचाहिँ उद्धार भएकै छैन।”<verse eid="JER 8:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="JER 8:21"/>मेरा मानिसहरू चकनाचुर पारिएका छन्; अनि म पनि चकनाचुर भएको छु।</para>
  <para style="q2" vid="JER 8:21">म शोकमा छु र पूर्ण रूपमा हताश भएको छु।<verse eid="JER 8:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 8:22"/>के गिलादमा निको पार्ने मलम छैन?</para>
  <para style="q2" vid="JER 8:22">के त्यहाँ कुनै वैद्यहरू छैनन्?</para>
  <para style="q1" vid="JER 8:22">त्यसो भए किन मेरा मानिसहरूको चोट</para>
  <para style="q2" vid="JER 8:22">निको भएको छैन?<verse eid="JER 8:22"/></para>
  <chapter eid="JER 8"/>
  <chapter number="9" style="c" sid="JER 9"/>
  <para style="q1">
    <verse number="1" style="v" sid="JER 9:1"/>अहो, यदि मेरो शिर पानीको मूल</para>
  <para style="q2" vid="JER 9:1">र मेरा आँखाहरू आँसुका फोहरा भएको भए!</para>
  <para style="q1" vid="JER 9:1">मेरा मारिएका मानिसहरूका निम्ति</para>
  <para style="q2" vid="JER 9:1">म दिनरात रुनेथिएँ।<verse eid="JER 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 9:2"/>अहो, मरुभूमिमा यात्रीहरूका निम्ति</para>
  <para style="q2" vid="JER 9:2">मसँग एउटा बास बस्‍ने ठाउँ भएको भए,</para>
  <para style="q1" vid="JER 9:2">म मेरा मानिसहरूलाई</para>
  <para style="q2" vid="JER 9:2">त्यहाँ राखेर तिनीहरूबाट टाढा जानेथिएँ;</para>
  <para style="q1" vid="JER 9:2">किनकि तिनीहरू सबै व्यभिचारी</para>
  <para style="q2" vid="JER 9:2">र विश्‍वासघाती मानिसहरूको भीड हो।<verse eid="JER 9:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="JER 9:3"/>“तिनीहरूले झूट बोल्नका लागि</para>
  <para style="q2" vid="JER 9:3">आफ्ना जिब्रा धनुजस्तै तयार गर्छन्;</para>
  <para style="q1" vid="JER 9:3">देशमा तिनीहरू सत्यताद्वारा</para>
  <para style="q2" vid="JER 9:3">विजयी भएका होइनन्।</para>
  <para style="q1" vid="JER 9:3">तर तिनीहरू एउटा पापपछि अर्को पाप गर्दै जान्छन्;</para>
  <para style="q2" vid="JER 9:3">तिनीहरूले मलाई जान्दैनन्,”</para>
  <para style="q2" vid="JER 9:3">याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 9:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 9:4"/>“तिमीहरूका साथीहरूदेखि होसियार होओ;</para>
  <para style="q2" vid="JER 9:4">आफ्ना वंशको कुनै पनि दाजुभाइहरूमाथि भरोसा नगर।</para>
  <para style="q1" vid="JER 9:4">किनकि हरेक दाजुभाइहरू छली छन्;</para>
  <para style="q2" vid="JER 9:4">अनि हरेक साथी निन्दक छन्।<verse eid="JER 9:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 9:5"/>एउटा मित्रले अर्को मित्रलाई छल गर्छ;</para>
  <para style="q2" vid="JER 9:5">अनि कसैले पनि सत्य कुरा बोल्दैन।</para>
  <para style="q1" vid="JER 9:5">तिनीहरूले आफ्नो जिब्रोलाई झूट बोल्न सिकाएका छन्;</para>
  <para style="q2" vid="JER 9:5">तिनीहरू पाप गरेर आफैँलाई थकित तुल्याउँछन्।<verse eid="JER 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 9:6"/>तँ छलीहरूको बीचमा बस्छस्;</para>
  <para style="q2" vid="JER 9:6">तिनीहरूको छलमा तिनीहरूले मलाई आफ्ना परमेश्‍वरको रूपमा स्वीकार गर्न मान्दैनन्,”</para>
  <para style="q2" vid="JER 9:6">याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 9:7"/>यसकारण सेनाहरूका याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="JER 9:7">“हेर, म तिनीहरूलाई खार्नेछु र तिनीहरूलाई जाँच्नेछु;</para>
  <para style="q2" vid="JER 9:7">किनकि मेरा मानिसहरूका पापको निम्ति</para>
  <para style="q2" vid="JER 9:7">म अरू के गर्न सक्छु र?<verse eid="JER 9:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 9:8"/>तिनीहरूका जिब्रा घातक काँड हुन्;</para>
  <para style="q2" vid="JER 9:8">ती जिब्राले छलको कुरा बोल्दछन्।</para>
  <para style="q1" vid="JER 9:8">तिनीहरू सबै आफ्ना छिमेकीहरूसँग मुखले मिठो कुरा गर्दछन्,</para>
  <para style="q2" vid="JER 9:8">तर आफ्ना हृदयमा भने छिमेकीको विरुद्धमा पासो थाप्छन्।”<verse eid="JER 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 9:9"/>याहवेह घोषणा गर्नुहुन्छ,</para>
  <para style="q2" vid="JER 9:9">“के म यस्तो पापका निम्ति तिनीहरूलाई दण्ड नदिऊँ?</para>
  <para style="q1" vid="JER 9:9">के यस्तो राष्ट्रसँग,</para>
  <para style="q2" vid="JER 9:9">म बदला नलिऊँ?”<verse eid="JER 9:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="JER 9:10"/>म पर्वतहरूका निम्ति रुनेछु र विलाप गर्नेछु;</para>
  <para style="q2" vid="JER 9:10">अनि मरुभूमिका खर्कहरूका निम्ति पनि विलाप गर्नेछु।</para>
  <para style="q1" vid="JER 9:10">ती खर्कहरू जलाएर भस्म पारिएका छन् र त्यहाँबाट कोही पनि हिँड्दैनन्;</para>
  <para style="q2" vid="JER 9:10">अनि त्यहाँ गाईबस्तुको आवाज पनि सुनिँदैन।</para>
  <para style="q1" vid="JER 9:10">आकाशका चराहरू सबै उडेर गइसकेका छन्</para>
  <para style="q2" vid="JER 9:10">र जनावरहरू पनि गइसकेका छन्।<verse eid="JER 9:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="JER 9:11"/>“म यरूशलेमलाई भग्नावशेषको थुप्रो</para>
  <para style="q2" vid="JER 9:11">र स्यालको ओडार बनाउनेछु;</para>
  <para style="q1" vid="JER 9:11">अनि यहूदाका सहरहरूमा कोही नबसून् भनेर</para>
  <para style="q2" vid="JER 9:11">म यहूदालाई उजाड पारिदिनेछु।”<verse eid="JER 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 9:12"/>व्यवस्थालाई बुझ्न सक्ने बुद्धिमान् मानिस को छ? याहवेहले कसलाई निर्देशन गर्नुभएको छ र व्यवस्थालाई व्याख्या गर्न सक्छ? देश किन विनाश गरिएको छ र कोही हिँड्न नसक्ने मरुभूमिजस्तै किन पारिएको छ?<verse eid="JER 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 9:13"/>याहवेहले भन्‍नुभयो, “मैले तिनीहरूका अगि राखिदिएको मेरो व्यवस्थालाई तिनीहरूले त्यागेका कारण यी सबै कुरा भएका हुन्; तिनीहरूले मेरो आज्ञापालन गरेनन्, न त मेरो व्यवस्था नै पालन गरे। <verse eid="JER 9:13"/><verse number="14" style="v" sid="JER 9:14"/>बरु तिनीहरू आफ्ना हृदयको हठीपनको पछि लागेका छन्; तिनीहरूका पितापुर्खाहरूले तिनीहरूलाई सिकाएझैँ, तिनीहरू बाल-देवताहरूका पछि लागेका छन्।” <verse eid="JER 9:14"/><verse number="15" style="v" sid="JER 9:15"/>यसकारण सेनाहरूका याहवेह, इस्राएलका परमेश्‍वर यसो भन्‍नुहुन्छ: “हेर, म यस जातिलाई तितो भोजन खान लगाउनेछु र विषालु पानी पिउन लगाउनेछु। <verse eid="JER 9:15"/><verse number="16" style="v" sid="JER 9:16"/>म तिनीहरूलाई, न तिनीहरूले, न त तिनीहरूका पितापुर्खाहरूले जानेका वा चिनेका जातिहरूको बीचमा छरपस्ट पारिदिनेछु। म तिनीहरूलाई तिनीहरूको विनाश नहोउन्जेलसम्म खेद्नेछु।”<verse eid="JER 9:16"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="17" style="v" sid="JER 9:17"/>सेनाहरूका याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="JER 9:17">“अब यी कुराहरू विचार गर! विलाप गर्ने स्त्रीहरूलाई बोलाओ;</para>
  <para style="q2" vid="JER 9:17">तिनीहरूमध्येका सबैभन्दा सिपालु स्त्रीहरूलाई ल्याओ।<verse eid="JER 9:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 9:18"/>तिनीहरू चाँडै आऊन्,</para>
  <para style="q2" vid="JER 9:18">र हाम्रा आँखाबाट आँसुका भलहरू</para>
  <para style="q1" vid="JER 9:18">र हाम्रा आँखाको परेलाबाट पानीको धारा नबगेसम्म</para>
  <para style="q2" vid="JER 9:18">हाम्रा निम्ति विलाप गरिदेऊन्।<verse eid="JER 9:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 9:19"/>सियोनबाट विलापको सोर सुनिँदैछ:</para>
  <para style="q2" vid="JER 9:19">हामी कसरी नष्‍ट भएका छौँ!</para>
  <para style="q2" vid="JER 9:19">हामी साह्रै लज्जित छौँ!</para>
  <para style="q1" vid="JER 9:19">हामीले आफ्नो देश छोड्नैपर्छ;</para>
  <para style="q2" vid="JER 9:19">किनकि हाम्रा घरहरू नष्‍ट भएका छन्।”<verse eid="JER 9:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="JER 9:20"/>तर हे स्त्रीहरू, याहवेहको वचन सुन;</para>
  <para style="q2" vid="JER 9:20">उहाँको मुखको वचन सुन्‍न आफ्ना कानहरू खोल।</para>
  <para style="q1" vid="JER 9:20">आफ्ना छोरीहरूलाई बिलौना गर्न सिकाओ;</para>
  <para style="q2" vid="JER 9:20">एक-अर्कालाई विलापको गीत सिकाइदेओ।<verse eid="JER 9:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 9:21"/>मृत्यु हाम्रा झ्यालहरूबाट चढेर आएको छ, र</para>
  <para style="q2" vid="JER 9:21">हाम्रा किल्‍लाहरूमा पसेको छ;</para>
  <para style="q1" vid="JER 9:21">यसले केटाकेटीहरूलाई बाटो-बाटोबाट</para>
  <para style="q2" vid="JER 9:21">र जवानहरूलाई चोक-चोकबाट नष्‍ट गरेको छ।<verse eid="JER 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JER 9:22"/>तैँले भन्, “याहवेह यसरी घोषणा गर्नुहुन्छ:</para>
  <para style="q1" vid="JER 9:22">“ ‘मानिसहरूका लासहरू खुला मैदानमा</para>
  <para style="q2" vid="JER 9:22">मलझैँ छरिएका हुनेछन्;</para>
  <para style="q1" vid="JER 9:22">तिनीहरू कटनी गर्नेले छोडेको अन्‍नझैँ हुनेछन्।</para>
  <para style="q2" vid="JER 9:22">ती छोडिएको अन्‍नहरू कसैले बटुल्ने छैन।’ ”<verse eid="JER 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JER 9:23"/>याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="JER 9:23">“बुद्धिमान् मानिसले आफ्नो बुद्धिको घमण्ड नगरोस्,</para>
  <para style="q2" vid="JER 9:23">बलवान् मानिसले आफ्नो बलको घमण्ड नगरोस्,</para>
  <para style="q2" vid="JER 9:23">र धनी मानिसले आफ्नो धनको घमण्ड नगरोस्;<verse eid="JER 9:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 9:24"/>तर जसले घमण्ड गर्छ, त्यसले यस विषयमा चाहिँ घमण्ड गरोस्:</para>
  <para style="q2" vid="JER 9:24">कि त्यससँग मलाई चिन्‍ने समझशक्ति छ;</para>
  <para style="q1" vid="JER 9:24">म याहवेह हुँ, जसले पृथ्वीमा दया,</para>
  <para style="q2" vid="JER 9:24">न्याय र धार्मिकताको व्यवहार गर्दछु;</para>
  <para style="q2" vid="JER 9:24">किनकि यिनै कुराहरूमा म प्रसन्‍न हुन्छु,”</para>
  <para style="q2" vid="JER 9:24">याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 9:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JER 9:25"/>याहवेह घोषणा गर्नुहुन्छ, “ती दिनहरू आउँदैछन्, जब म शरीरमा मात्रै खतना भएकाहरू सबैलाई दण्ड दिनेछु; <verse eid="JER 9:25"/><verse number="26" style="v" sid="JER 9:26"/>अर्थात् इजिप्ट, यहूदा, एदोम, अम्मोन, मोआब र टाढा मरुभूमिका सिमानाहरूमा बस्‍ने सबैलाई दण्ड दिनेछु।<note caller="+" style="f"><char style="fr" closed="false">9:26 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">कन्चटनेरको कपाल खौरनेहरू</char></note> किनकि यी सबै जातिहरू साँचो रूपमा खतना भएका छैनन्; अनि इस्राएलको सम्पूर्ण घरानाको पनि हृदयमा खतना भएको छैन।”<verse eid="JER 9:26"/></para>
  <chapter eid="JER 9"/>
  <chapter number="10" style="c" sid="JER 10"/>
  <para style="s1">परमेश्‍वर र मूर्तिहरू</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 10:1"/>हे इस्राएलका घराना हो, याहवेहले तिमीहरूलाई के भन्दै हुनुहुन्छ, सो सुन। <verse eid="JER 10:1"/><verse number="2" style="v" sid="JER 10:2"/>उहाँले तिमीहरूलाई यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="JER 10:2">“अरू राष्ट्रहरूका मार्गहरू नसिक,</para>
  <para style="q2" vid="JER 10:2">अथवा आकाशका चिन्हहरूद्वारा नआत्तिओ;</para>
  <para style="q2" vid="JER 10:2">यद्यपि ती राष्ट्रहरूचाहिँ ती चिन्हहरूद्वारा आत्तिन्छन्।<verse eid="JER 10:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 10:3"/>किनकि तिनीहरूका रीतिरिवाजहरू व्यर्थका छन्;</para>
  <para style="q2" vid="JER 10:3">तिनीहरूले जङ्गलबाट एउटा रूख काट्छन्;</para>
  <para style="q2" vid="JER 10:3">अनि शिल्पकारले आफ्नो हतियारले त्यसलाई आकार दिन्छ।<verse eid="JER 10:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 10:4"/>तिनीहरूले त्यसलाई चाँदी र सुनले सिँगार्छन्;</para>
  <para style="q2" vid="JER 10:4">हथौडाले काँटी ठोकेर तिनीहरूले त्यसलाई जोड्छन्,</para>
  <para style="q2" vid="JER 10:4">ताकि त्यो यताउता नहल्‍लिओस्।<verse eid="JER 10:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 10:5"/>काँक्राबारीमा काग धपाउन राखिएको पुत्लाझैँ,</para>
  <para style="q2" vid="JER 10:5">तिनीहरूका मूर्तिहरू बोल्न सक्दैनन्;</para>
  <para style="q1" vid="JER 10:5">किनकि ती हिँड्न सक्दैनन्।</para>
  <para style="q2" vid="JER 10:5">ती मूर्तिहरूलाई बोकेर लैजानुपर्छ।</para>
  <para style="q1" vid="JER 10:5">तिनीहरूदेखि नडराओ;</para>
  <para style="q2" vid="JER 10:5">तिनीहरूले कुनै पनि हानि गर्न सक्दैनन्,</para>
  <para style="q2" vid="JER 10:5">न त तिनीहरूले कुनै असल कुरा नै गर्न सक्छन्।”<verse eid="JER 10:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="JER 10:6"/>हे याहवेह, तपाईंजस्तो अरू कोही पनि छैन;</para>
  <para style="q2" vid="JER 10:6">तपाईं महान् हुनुहुन्छ;</para>
  <para style="q2" vid="JER 10:6">अनि तपाईंको नाम महान् र शक्तिशाली छ।<verse eid="JER 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 10:7"/>हे राष्ट्रहरूका राजा,</para>
  <para style="q2" vid="JER 10:7">तपाईंसँग कोचाहिँ डराउँदैन र?</para>
  <para style="q2" vid="JER 10:7">किनकि तपाईं आदरयोग्य हुनुहुन्छ।</para>
  <para style="q1" vid="JER 10:7">राष्ट्रहरूका सबै बुद्धिमान् मानिसहरू</para>
  <para style="q2" vid="JER 10:7">र तिनीहरूका सबै राज्यहरूमा</para>
  <para style="q2" vid="JER 10:7">तपाईंजस्तो अरू कोही छैन।<verse eid="JER 10:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="JER 10:8"/>तिनीहरू सबै विवेकहीन र मूर्ख छन्;</para>
  <para style="q2" vid="JER 10:8">तिनीहरू काम नलाग्ने काठका मूर्तिहरूद्वारा सिकाइएका छन्।<verse eid="JER 10:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 10:9"/>मूर्ति बनाउन तर्शीशबाट पिटिएको चाँदी र</para>
  <para style="q2" vid="JER 10:9">उपाजबाट सुन ल्याइन्छ।</para>
  <para style="q1" vid="JER 10:9">शिल्पकार र सुनारद्वारा त्यसलाई बनाइन्छ;</para>
  <para style="q2" vid="JER 10:9">अनि त्यसमा निलो र बैजनी रङ्गको लुगा लगाइन्छ।</para>
  <para style="q2" vid="JER 10:9">ती सबै थोक सिपालु कारिगरहरूद्वारा बनाइएका छन्।<verse eid="JER 10:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 10:10"/>तर याहवेह सत्य परमेश्‍वर हुनुहुन्छ;</para>
  <para style="q2" vid="JER 10:10">उहाँ जीवित र अनन्तसम्मका राजा हुनुहुन्छ।</para>
  <para style="q1" vid="JER 10:10">जब उहाँ रिसाउनुहुन्छ, पृथ्वी थरथर काँप्छ;</para>
  <para style="q2" vid="JER 10:10">राष्ट्रहरूले उहाँको क्रोध सहनै सक्दैनन्।<verse eid="JER 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 10:11"/>“तिनीहरूलाई यसो भन्: ‘यी देवताहरू, जसले स्वर्ग र पृथ्वी बनाएनन्, ती पृथ्वी र आकाशमुनिबाट नष्‍ट हुनेछन्।’ ”<verse eid="JER 10:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 10:12"/>तर परमेश्‍वरले पृथ्वी आफ्नो शक्तिद्वारा बनाउनुभयो;</para>
  <para style="q2" vid="JER 10:12">उहाँले संसारलाई आफ्नो बुद्धिले स्थापित गर्नुभयो;</para>
  <para style="q2" vid="JER 10:12">र उहाँले आकाशलाई आफ्नो समझशक्तिले फैलाउनुभयो।<verse eid="JER 10:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 10:13"/>जब उहाँ बोल्नुहुन्छ, तब आकाशमा पानीको गर्जन हुन्छ;</para>
  <para style="q2" vid="JER 10:13">उहाँले बादललाई पृथ्वीको अन्तिम छेउबाट उठाउनुहुन्छ।</para>
  <para style="q1" vid="JER 10:13">उहाँले झरीसँग बिजुली पठाउनुहुन्छ;</para>
  <para style="q2" vid="JER 10:13">अनि हावालाई उहाँको भण्डारहरूबाट निकाल्नुहुन्छ।<verse eid="JER 10:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="JER 10:14"/>हरेक मानिस विवेकहीन र ज्ञानहीन छ;</para>
  <para style="q2" vid="JER 10:14">हरेक सुनार आफ्नै मूर्तिहरूद्वारा शर्ममा पर्नेछ।</para>
  <para style="q1" vid="JER 10:14">किनकि त्यसले बनाएका मूर्तिहरू झूटा हुन्;</para>
  <para style="q2" vid="JER 10:14">तिनीहरूमा जीवनको सास हुँदैन।<verse eid="JER 10:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 10:15"/>ती मूर्तिहरू सबै व्यर्थका र ठट्टाका पात्र हुन्;</para>
  <para style="q2" vid="JER 10:15">जब तिनीहरूको न्याय आउँछ, तब तिनीहरू नष्‍ट हुनेछन्।<verse eid="JER 10:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 10:16"/>उहाँ, जो याकोबका अंश हुनुहुन्छ, उहाँ ती मूर्तिहरूजस्ता हुनुहुन्‍न;</para>
  <para style="q2" vid="JER 10:16">किनकि उहाँ सबै कुराहरूको सृष्‍टिकर्ता हुनुहुन्छ,</para>
  <para style="q1" vid="JER 10:16">जसमा इस्राएल, उहाँको उत्तराधिकारका मानिसहरू पनि सामेल छन्;</para>
  <para style="q2" vid="JER 10:16">सेनाहरूका याहवेह उहाँको नाम हो।<verse eid="JER 10:16"/></para>
  <para style="s1">आउन लागेको विनाश</para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 10:17"/>हे घेराउमा परेर बसेका यरूशलेमका बासिन्दाहरू हो,</para>
  <para style="q2" vid="JER 10:17">देश छोड्नलाई आफ्ना सरसामानहरू बटुल।<verse eid="JER 10:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 10:18"/>किनकि याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q2" vid="JER 10:18">“यसै समयमा म यस देशमा बस्‍नेहरूलाई</para>
  <para style="q2" vid="JER 10:18">झटारो हानेर निकालिदिनेछु;</para>
  <para style="q1" vid="JER 10:18">म तिनीहरूमाथि सङ्कष्‍ट ल्याउनेछु,</para>
  <para style="q2" vid="JER 10:18">ताकि तिनीहरू पक्राउ परून्।”<verse eid="JER 10:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="JER 10:19"/>मेरो चोटको खातिर मलाई धिक्‍कार छ!</para>
  <para style="q2" vid="JER 10:19">मेरो चोट निको नहुने किसिमको छ!</para>
  <para style="q1" vid="JER 10:19">तापनि मैले आफूलाई भनेँ,</para>
  <para style="q2" vid="JER 10:19">“यो मेरो रोग हो, र मैले यसलाई सहनैपर्छ।”<verse eid="JER 10:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 10:20"/>मेरो पाल भत्काइएको छ;</para>
  <para style="q2" vid="JER 10:20">पालका सबै डोरीहरू चुडाइएका छन्।</para>
  <para style="q1" vid="JER 10:20">मेरा छोराछोरीहरू मबाट गइसकेका छन् र अब कोही पनि छैन;</para>
  <para style="q2" vid="JER 10:20">अब मेरो पाल टाँगिदिने</para>
  <para style="q2" vid="JER 10:20">अथवा मेरो वासस्थान ठिक गरिदिने कोही पनि बाँकी छैन।<verse eid="JER 10:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 10:21"/>गोठालाहरू विवेकहीन भएका छन्,</para>
  <para style="q2" vid="JER 10:21">र तिनीहरू याहवेहको खोजी गर्दैनन्;</para>
  <para style="q1" vid="JER 10:21">यसैकारण तिनीहरू सफल हुँदैनन्;</para>
  <para style="q2" vid="JER 10:21">अनि तिनीहरूका सबै बगालहरू छरपस्ट भएका छन्।<verse eid="JER 10:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 10:22"/>सुन! यस्तो खबर आइरहेको छ,</para>
  <para style="q2" vid="JER 10:22">उत्तरको देशबाट एउटा ठूलो होहल्‍ला आइरहेछ!</para>
  <para style="q1" vid="JER 10:22">यसले यहूदाका सहरहरूलाई उजाड पार्नेछ,</para>
  <para style="q2" vid="JER 10:22">र स्यालहरूका ओडार बनाउनेछ।<verse eid="JER 10:22"/></para>
  <para style="s1">यर्मियाको प्रार्थना</para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 10:23"/>हे याहवेह, म जान्दछु, मानिसको जीवन उसको आफ्नो हातमा छैन;</para>
  <para style="q2" vid="JER 10:23">तिनीहरू आफैँले आफ्ना पाइलाहरूलाई निर्देशन गर्दैनन्।<verse eid="JER 10:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 10:24"/>हे याहवेह, मलाई सुधार्नुहोस्, तर तपाईंको न्यायअनुसार,</para>
  <para style="q2" vid="JER 10:24">तपाईंको रिसमा चाहिँ होइन;</para>
  <para style="q2" vid="JER 10:24">नत्रता तपाईंले मलाई भष्म पारिदिनुहुनेछ।<verse eid="JER 10:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 10:25"/>तपाईंको क्रोध ती राष्ट्रहरूमाथि खन्याइदिनुहोस्,</para>
  <para style="q2" vid="JER 10:25">जसले तपाईंलाई परमेश्‍वर भनी स्वीकार गर्दैनन्;</para>
  <para style="q2" vid="JER 10:25">ती मानिसहरूमाथि, जसले तपाईंको नाम पुकार्दैनन्।</para>
  <para style="q1" vid="JER 10:25">किनकि तिनीहरूले याकोबलाई निलेका छन्;</para>
  <para style="q2" vid="JER 10:25">तिनीहरूले तिनलाई सर्लक्‍कै निलेका छन्;</para>
  <para style="q2" vid="JER 10:25">अनि तिनको जन्मभूमिलाई उजाड पारिदिएका छन्।<verse eid="JER 10:25"/></para>
  <chapter eid="JER 10"/>
  <chapter number="11" style="c" sid="JER 11"/>
  <para style="s1">करार भङ्ग गरिएको</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 11:1"/>यर्मियाकहाँ आएको याहवेहको वचन यही हो: <verse eid="JER 11:1"/><verse number="2" style="v" sid="JER 11:2"/>“यस करारका शर्तहरू सुन्। अनि ती यहूदाका मानिसहरू र यरूशलेमका बासिन्दाहरूलाई भन्। <verse eid="JER 11:2"/><verse number="3" style="v" sid="JER 11:3"/>याहवेह इस्राएलका परमेश्‍वर यसो भन्‍नुहुन्छ भनी तिनीहरूलाई भन्: ‘यस करारका शर्तहरू पालन नगर्ने मानिस श्रापित होस्, <verse eid="JER 11:3"/><verse number="4" style="v" sid="JER 11:4"/>अर्थात् ती शर्तहरू, जुन मैले तिमीहरूका पितापुर्खाहरूलाई इजिप्टबाट, फलाम पगाल्ने भट्टीबाट निकालेर ल्याउँदा तिनीहरूलाई आज्ञा गरेको थिएँ।’ मैले भनेँ, ‘मलाई र मैले तिमीहरूलाई आज्ञा गरेका सबै कुराहरू पालन गर्‍यौ भने तिमीहरू मेरा मानिसहरू हुनेछौ, र म तिमीहरूका परमेश्‍वर हुनेछु। <verse eid="JER 11:4"/><verse number="5" style="v" sid="JER 11:5"/>तब तिमीहरूका पितापुर्खाहरूलाई दूध र मह बग्ने देश दिनेछु’ भनी मैले तिनीहरूसित शपथ खाएर बाँधेको प्रतिज्ञा पूरा गर्नेछु; त्यही देश, जुन आज तिमीहरूको अधिकारमा छ।”</para>
  <para style="p" vid="JER 11:5">मैले जवाफ दिएर भनेँ, “आमेन, याहवेह।”<verse eid="JER 11:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 11:6"/>याहवेहले मलाई भन्‍नुभयो, “यहूदाका सहरहरू र यरूशलेमका सडकहरूमा यी सबै वचनहरू घोषणा गर्: ‘करारका यी वचनहरू सुन र ती वचनहरू पालन गर। <verse eid="JER 11:6"/><verse number="7" style="v" sid="JER 11:7"/>“मेरो आज्ञापालन गर,” भनेर मैले तिमीहरूका पितापुर्खाहरूलाई इजिप्टबाट ल्याएको समयदेखि आजसम्म मैले तिनीहरूलाई बारम्बार चेतावनी दिँदैआएको छु। <verse eid="JER 11:7"/><verse number="8" style="v" sid="JER 11:8"/>तर तिनीहरूले सुनेनन्, अथवा ध्यानै दिएनन्; बरु तिनीहरू आफ्नै दुष्‍ट हृदयको हठीपनामा लागिरहे। त्यसैले तिनीहरूले पालन नगरेको हुनाले मैले तिनीहरूलाई पालन गर्नलाई दिएको करारका सबै सरापहरू तिनीहरूमाथि ल्याएँ।’ ”<verse eid="JER 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 11:9"/>तब याहवेहले मलाई भन्‍नुभयो, “यहूदाका मानिसहरू र यरूशलेममा बस्‍नेहरूले मेरो विरुद्धमा एउटा षड्यन्त्र रचेका छन्। <verse eid="JER 11:9"/><verse number="10" style="v" sid="JER 11:10"/>तिनीहरू आफ्ना पितापुर्खाहरूका पापमा फर्किगएका छन्, जसले मेरो वचन सुन्‍न इन्कार गरेका थिए। तिनीहरू अन्य देवताहरूका पछि लागेका छन् र तिनीहरूको सेवा गरेका छन्। मैले तिनीहरूका पितापुर्खाहरूसित बाँधेको करारलाई इस्राएल र यहूदा दुवैले भङ्ग गरेका छन्। <verse eid="JER 11:10"/><verse number="11" style="v" sid="JER 11:11"/>यसकारण याहवेह यसो भन्‍नुहुन्छ: ‘म तिनीहरू उम्कनै नसक्ने गरी तिनीहरूमाथि विपत्ति ल्याउनेछु। तिनीहरूले सहायताका निम्ति पुकार गरे तापनि म तिनीहरूको पुकार सुन्‍नेछैनँ। <verse eid="JER 11:11"/><verse number="12" style="v" sid="JER 11:12"/>तब यहूदाका र यरूशलेमका मानिसहरू जानेछन् र तिनीहरूले धूप बालेका देवताहरूकहाँ पुकार्नेछन्, तर विपत्ति आइपर्दा ती देवताहरूले कुनै पनि सहायता गर्न सक्दैनन्। <verse eid="JER 11:12"/><verse number="13" style="v" sid="JER 11:13"/>हे यहूदा, तँसित जति सहरहरू छन्, त्यति नै देवताहरू छन्; अनि तैँले त्यस लाजमर्दो बाल-देवताको निम्ति धूप बाल्न खडा गरेका वेदीहरू त्यति नै छन्, जति यरूशलेमका सडकहरू छन्।’<verse eid="JER 11:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 11:14"/>“यी मानिसहरूका निम्ति प्रार्थना नगर्, न त कुनै विलौना अथवा बिन्ती नै गर्; किनकि तिनीहरूको विपत्तिको समयमा तिनीहरूले सहायताका निम्ति मेरो पुकार गर्दा म सुन्‍नेछैनँ।<verse eid="JER 11:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 11:15"/>“मेरो मन्दिरमा मेरी प्रिय के गर्दैछे,</para>
  <para style="q2" vid="JER 11:15">जबकि त्यसले धेरैजनासँग कुकर्म गरिसकेकी छे?</para>
  <para style="q2" vid="JER 11:15">के अर्पण गरिएको मासुले तेरो दण्ड पन्साउन सक्छ र?</para>
  <para style="q1" vid="JER 11:15">जब तँ आफ्ना दुष्‍ट कर्महरूमा लाग्छेस्,</para>
  <para style="q2" vid="JER 11:15">तब तँ खुशी हुन्छेस्।”<verse eid="JER 11:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="JER 11:16"/>याहवेहले तँलाई मौलाएको</para>
  <para style="q2" vid="JER 11:16">असल फलहरूको जैतुनको रूख भन्‍नुभयो।</para>
  <para style="q1" vid="JER 11:16">तर शक्तिशाली आँधीबेहरीको गर्जनले</para>
  <para style="q2" vid="JER 11:16">उहाँले त्यसलाई आगो लगाइदिनुहुनेछ;</para>
  <para style="q2" vid="JER 11:16">अनि त्यसका हाँगाहरू पूर्ण रूपमा भाँचिनेछन्।<verse eid="JER 11:16"/></para>
  <para style="m">
    <verse number="17" style="v" sid="JER 11:17"/>सेनाहरूका याहवेह, जसले तँलाई रोप्नुभयो, उहाँले तेरो विरुद्धमा विपत्तिको आदेश दिनुभएको छ; किनकि इस्राएल र यहूदाका मानिसहरूले बाल-देवतालाई धूपहरू बालेर दुष्‍ट काम गरेका छन् र मलाई रिस उठाएका छन्।<verse eid="JER 11:17"/></para>
  <para style="s1">यर्मियाको विरुद्धमा षड्यन्त्र</para>
  <para style="p">
    <verse number="18" style="v" sid="JER 11:18"/>किनभने याहवेहले मलाई तिनीहरूको षड्यन्त्र प्रकट गरिदिनुभयो; अनि मैले त्यो थाहा पाएँ; किनकि त्यस बेला तिनीहरूले जे गरिरहेका थिए, उहाँले मलाई देखाउनुभयो। <verse eid="JER 11:18"/><verse number="19" style="v" sid="JER 11:19"/>तर म त मारिनलाई लगिएको एउटा सुधो थुमाजस्तो थिएँ; तिनीहरूले मलाई यसो भन्दै षड्यन्त्र रचेको मलाई थाहै थिएन,</para>
  <para style="q1" vid="JER 11:19">“हामी यस रूख र यसको फललाई नाश गरिदिऔँ;</para>
  <para style="q2" vid="JER 11:19">यसलाई जीवितहरूको देशबाट काटेर ढालिदिऔँ,</para>
  <para style="q2" vid="JER 11:19">ताकि यस रूखको नामको सम्झनाधरि नरहोस्।”<verse eid="JER 11:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 11:20"/>तर तपाईं सेनाहरूका याहवेह, जसले धार्मिकतासाथ न्याय गर्नुहुन्छ;</para>
  <para style="q2" vid="JER 11:20">अनि हृदय र मनलाई जाँच गर्नुहुन्छ;</para>
  <para style="q1" vid="JER 11:20">तिनीहरूमाथि तपाईंको बदला म देख्न पाऊँ;</para>
  <para style="q2" vid="JER 11:20">किनकि मैले मेरो मुद्दा तपाईंलाई सुम्पिदिएको छु।<verse eid="JER 11:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JER 11:21"/>यसकारण “याहवेहको नाममा अगमवाणी नगर्, नत्रता तँ हाम्रो हातबाट मर्नेछस्,” भन्दै तेरो प्राण लिन खोज्ने अनातोतका मानिसहरूको बारेमा याहवेह यसो भन्‍नुहुन्छ: <verse eid="JER 11:21"/><verse number="22" style="v" sid="JER 11:22"/>यसकारण सेनाहरूका याहवेह यसो भन्‍नुहुन्छ: “म तिनीहरूलाई दण्ड दिनेछु। तिनीहरूका जवान मानिसहरू तरवारले र तिनीहरूका छोरीहरूचाहिँ अनिकालले मर्नेछन्। <verse eid="JER 11:22"/><verse number="23" style="v" sid="JER 11:23"/>अनातोतका मानिसहरू कोही पनि बाँकी रहनेछैनन्; किनकि तिनीहरूलाई दण्ड दिने वर्षमा म अनातोतका मानिसहरूमाथि सर्वनाश ल्याउनेछु।”<verse eid="JER 11:23"/></para>
  <chapter eid="JER 11"/>
  <chapter number="12" style="c" sid="JER 12"/>
  <para style="s1">यर्मियाको गुनासो</para>
  <para style="q1">
    <verse number="1" style="v" sid="JER 12:1"/>जब म मेरो मुद्दा तपाईंकहाँ राख्दछु,</para>
  <para style="q2" vid="JER 12:1">तब याहवेह, तपाईं सदैव धर्मी हुनुहुन्छ।</para>
  <para style="q1" vid="JER 12:1">तापनि म तपाईंसँग तपाईंको न्यायको बारेमा कुरा गर्न चाहन्छु:</para>
  <para style="q2" vid="JER 12:1">किन दुष्‍ट मानिसहरू सफल हुन्छन्?</para>
  <para style="q2" vid="JER 12:1">किन सबै अधर्मीहरू सुखी जीवन जिउँछन्?<verse eid="JER 12:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 12:2"/>तपाईंले तिनीहरूलाई रोप्नुभयो र तिनीहरूले जरा हाले;</para>
  <para style="q2" vid="JER 12:2">तिनीहरू बढ्छन् र फल फलाउँछन्।</para>
  <para style="q1" vid="JER 12:2">तिनीहरूको मुखले त सधैँ तपाईंको नाम लिन्छन्,</para>
  <para style="q2" vid="JER 12:2">तर तिनीहरूका हृदयबाट भने तपाईं टाढा हुनुहुन्छ।<verse eid="JER 12:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 12:3"/>तर हे याहवेह, तपाईंले मलाई जान्‍नुहुन्छ;</para>
  <para style="q2" vid="JER 12:3">तपाईंले मलाई देख्नुहुन्छ र तपाईंप्रतिका मेरा विचारहरू जाँच्नुहुन्छ।</para>
  <para style="q1" vid="JER 12:3">तिनीहरूलाई काट्न लगिएका भेडालाई जस्तै तानेर लैजानुहोस्!</para>
  <para style="q2" vid="JER 12:3">तिनीहरूलाई मारिने दिनको निम्ति अलग गर्नुहोस्!<verse eid="JER 12:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 12:4"/>कहिलेसम्म देश उजाड अवस्थामा रहिरहने</para>
  <para style="q2" vid="JER 12:4">र मैदानको घाँस ओइलिरहने?</para>
  <para style="q1" vid="JER 12:4">किनकि त्यस ठाउँमा बस्‍नेहरू दुष्‍ट छन्;</para>
  <para style="q2" vid="JER 12:4">जनावरहरू र चराहरू नष्‍ट भएका छन्।</para>
  <para style="q1" vid="JER 12:4">यसबाहेक, मानिसहरूले यसो भनिरहेका छन्,</para>
  <para style="q2" vid="JER 12:4">“हामीमाथि के हुँदैछ, परमेश्‍वरले देख्नुहुनेछैन।”<verse eid="JER 12:4"/></para>
  <para style="s1">परमेश्‍वरको जवाफ</para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 12:5"/>“तँ मानिसहरूसँग दगुर्दा</para>
  <para style="q2" vid="JER 12:5">तिनीहरूले तँलाई थकाए भने,</para>
  <para style="q2" vid="JER 12:5">कसरी तँ घोडाहरूसित दगुर्न सक्छस्?</para>
  <para style="q1" vid="JER 12:5">यदि तँ सुरक्षित देशमा त ठेस खान्छस् भने,</para>
  <para style="q2" vid="JER 12:5">यर्दनका छेउछाउका काँढे झाडीहरूमा झन् के गर्छस्?<verse eid="JER 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 12:6"/>तेरा दाजुभाइहरू, तेरा आफ्नै परिवारका सदस्यहरू,</para>
  <para style="q2" vid="JER 12:6">तिनीहरूले समेत तँलाई धोका दिएका छन्;</para>
  <para style="q2" vid="JER 12:6">तिनीहरूले तेरो विरुद्धमा बोलेका छन्।</para>
  <para style="q1" vid="JER 12:6">तिनीहरूले तँसँग मिठा-मिठा कुरा गरेका छन्,</para>
  <para style="q2" vid="JER 12:6">तापनि तिनीहरूलाई विश्‍वास नगर्।<verse eid="JER 12:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="JER 12:7"/>“म आफ्नो घर इस्राएललाई त्यागिदिनेछु,</para>
  <para style="q2" vid="JER 12:7">म आफ्नो उत्तराधिकारलाई छोडिदिनेछु;</para>
  <para style="q1" vid="JER 12:7">मैले प्रेम गरेका मानिसहरूलाई</para>
  <para style="q2" vid="JER 12:7">म तिनीहरूका शत्रुहरूका हातमा सुम्पिदिनेछु।<verse eid="JER 12:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 12:8"/>मेरो उत्तराधिकारीहरू मेरा निम्ति</para>
  <para style="q2" vid="JER 12:8">जङ्गलको सिंहजस्तै भएका छन्।</para>
  <para style="q1" vid="JER 12:8">तिनीहरू मसित गर्जन्छन्;</para>
  <para style="q2" vid="JER 12:8">यसैकारण म तिनीहरूलाई घृणा गर्दछु।<verse eid="JER 12:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 12:9"/>के मेरो उत्तराधिकार, मेरा निम्ति</para>
  <para style="q2" vid="JER 12:9">शिकारी पक्षीहरूले वरिपरि घेरेर आक्रमण गरी</para>
  <para style="q2" vid="JER 12:9">चोट लागेको चराझैँ भएको छैन?</para>
  <para style="q1" vid="JER 12:9">जा, गएर सबै जङ्गली पशुहरूलाई भेला गर्;</para>
  <para style="q2" vid="JER 12:9">तिनीहरूलाई खान ती पशुहरूलाई लिएर आइज।<verse eid="JER 12:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 12:10"/>धेरै विदेशी शासकहरूले मेरो दाखबारीलाई नष्‍ट गर्नेछन्,</para>
  <para style="q2" vid="JER 12:10">र मेरो भूमि कुल्चीमिल्ची पार्नेछन्;</para>
  <para style="q1" vid="JER 12:10">तिनीहरूले मेरो सुन्दर भूमिलाई उजाड</para>
  <para style="q2" vid="JER 12:10">र बाँझो बनाइदिनेछन्।<verse eid="JER 12:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 12:11"/>त्यो भूमि मेरो सामु सुक्खा,</para>
  <para style="q2" vid="JER 12:11">उजाड र बाँझो बनाइनेछ;</para>
  <para style="q1" vid="JER 12:11">समस्त देश उजाड पारिनेछ;</para>
  <para style="q2" vid="JER 12:11">किनकि त्यसको हेरचाह गर्ने कोही पनि छैन।<verse eid="JER 12:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 12:12"/>मरुभूमिका सम्पूर्ण अग्ला नाङ्गा डाँडाहरूमाथि</para>
  <para style="q2" vid="JER 12:12">नाश गर्नेहरू हुल लागेर आउनेछन्;</para>
  <para style="q1" vid="JER 12:12">किनकि याहवेहको तरवारले देशको</para>
  <para style="q2" vid="JER 12:12">एक छेउदेखि अर्को छेउसम्म नाश गर्नेछ;</para>
  <para style="q2" vid="JER 12:12">कोही पनि सुरक्षित रहनेछैन।<verse eid="JER 12:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 12:13"/>तिनीहरूले गहुँ छर्नेछन्, तर काँडाहरूको कटनी गर्नेछन्;</para>
  <para style="q2" vid="JER 12:13">तिनीहरूले कडा परिश्रम गर्नेछन्, तर केही फाइदा हुनेछैन।</para>
  <para style="q1" vid="JER 12:13">याहवेहको डरलाग्दो रिसको कारण,</para>
  <para style="q2" vid="JER 12:13">तिनीहरू आफ्नो फसलमा लज्जित हुनेछन्।”<verse eid="JER 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 12:14"/>याहवेह यसो भन्‍नुहुन्छ: “मैले आफ्ना मानिस, इस्राएलीहरूलाई दिएको उत्तराधिकारमाथि हात लगाउने मेरा सबै दुष्‍ट छिमेकीहरूलाई, म तिनीहरूका देशबाट उखेल्नेछु, र म तिनीहरूका बीचबाट यहूदाका घरानालाई उखेल्नेछु। <verse eid="JER 12:14"/><verse number="15" style="v" sid="JER 12:15"/>तर तिनीहरूलाई उखेलेपछि म तिनीहरूमाथि फेरि दया देखाउनेछु; अनि तिनीहरू हरेकलाई तिनीहरूका आफ्नै उत्तराधिकारको भूमि र तिनीहरूका आफ्नै देशमा फर्काएर ल्याउनेछु। <verse eid="JER 12:15"/><verse number="16" style="v" sid="JER 12:16"/>यदि तिनीहरूले मेरा मानिसहरूका चालचलनहरू राम्रोसँग सिकेर, ‘जीवित याहवेहको नाममा भनेर शपथ’ खाए भने तिनीहरूले एक पटक मेरा मानिसहरूलाई बाल-देवताको नाममा शपथ खान सिकाएका भए तापनि तिनीहरू मेरा मानिसहरूको बीचमा स्थापित हुनेछन्। <verse eid="JER 12:16"/><verse number="17" style="v" sid="JER 12:17"/>तर यदि कुनै पनि राष्ट्रले वचन पालन गरेन भने म त्यसलाई सम्पूर्ण रूपले उखेलेर नाश गर्नेछु,” याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 12:17"/></para>
  <chapter eid="JER 12"/>
  <chapter number="13" style="c" sid="JER 13"/>
  <para style="s1">एउटा सुतीको पटुका</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 13:1"/>याहवेहले मलाई यसो भन्‍नुभयो: “जा, गएर एउटा सुतीको पटुका किन् र त्यसलाई आफ्नो कम्मरमा बाँध्, तर त्यसलाई पानीले भिज्न नदे।” <verse eid="JER 13:1"/><verse number="2" style="v" sid="JER 13:2"/>यसकारण याहवेहले हुकुम गर्नुभएझैँ मैले एउटा सुतीको पटुका किनेँ र आफ्नो कम्मरमा बाँधेँ।<verse eid="JER 13:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 13:3"/>तब याहवेहको वचन दोस्रो पल्ट मकहाँ आयो: <verse eid="JER 13:3"/><verse number="4" style="v" sid="JER 13:4"/>“तैँले किनेको तेरो कम्मरमा बाँधिराखेको पटुका लिएर अब परात<note caller="+" style="f"><char style="fr" closed="false">13:4 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">यूफ्रेटिस</char></note> नदीमा जा, र त्यसलाई त्यहाँ चट्टानको एउटा दुलोमा लुकाइराख्।” <verse eid="JER 13:4"/><verse number="5" style="v" sid="JER 13:5"/>यसकारण याहवेहले मलाई भन्‍नुभएझैँ म परातमा गएँ, र त्यस पटुकालाई चट्टानमा लुकाएँ।<verse eid="JER 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 13:6"/>केही दिनपछि याहवेहले मलाई भन्‍नुभयो, “परातमा जा, र मैले तँलाई लुकाउन लगाएको पटुका त्यहाँबाट लिएर आइज।” <verse eid="JER 13:6"/><verse number="7" style="v" sid="JER 13:7"/>यसकारण म परातमा गएँ, र मैले पटुकालाई लुकाइराखेको ठाउँबाट खनेर निकालेँ, तर त्यो पटुका मक्‍किएर कामै नलाग्ने भएको पाएँ।<verse eid="JER 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 13:8"/>तब याहवेहको वचन मकहाँ आयो: <verse eid="JER 13:8"/><verse number="9" style="v" sid="JER 13:9"/>“याहवेह यसो भन्‍नुहुन्छ: ‘ठिक यसरी नै म यहूदाको र यरूशलेमको घमण्डलाई नष्‍ट गर्नेछु। <verse eid="JER 13:9"/><verse number="10" style="v" sid="JER 13:10"/>यी दुष्‍ट मानिसहरू, जसले मेरा वचन सुन्‍न इन्कार गर्छन्; तिनीहरू आफ्ना हृदयलाई कठोर पार्दै अरू देवी-देवताको पूजा गर्न र सेवा गर्न जान्छन्। यस्ता मानिसहरू यही पटुकाजस्तै पूर्ण रूपले केही कामको हुँदैनन्! <verse eid="JER 13:10"/><verse number="11" style="v" sid="JER 13:11"/>किनकि मानिसले पटुका कम्मरमा बाँधेझैँ, मैले इस्राएलको र यहूदाको सम्पूर्ण घरानालाई मेरो ख्याति, प्रशंसा र सम्मानको निम्ति प्रजा हुनेछन् भनी मैले तिनीहरूलाई आफ्नो कम्मरमा बाँधेँ, तर तिनीहरूले मेरो आज्ञापालन गरेनन्,’ याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 13:11"/></para>
  <para style="s1">मशकहरूको दृष्‍टान्त</para>
  <para style="p">
    <verse number="12" style="v" sid="JER 13:12"/>“यसकारण तिनीहरूलाई भन्: ‘याहवेह इस्राएलका परमेश्‍वर यसो भन्‍नुहुन्छ: हरेक मशक दाखमद्यले भरिएको हुनुपर्छ।’ अनि तिनीहरूले यदि तँलाई, ‘प्रत्येक मशक दाखमद्यले भरिनुपर्छ भन्‍ने कुरा के हामीलाई थाहा छैन?’ भनी भनेछन् भने, <verse eid="JER 13:12"/><verse number="13" style="v" sid="JER 13:13"/>तब तिनीहरूलाई यसरी भन्, ‘याहवेह यसो भन्‍नुहुन्छ: दावीदको सिंहासनमा बस्‍ने राजाहरू, पुजारीहरू, अगमवक्ताहरू र यरूशलेममा बस्‍नेहरू सबैलाई र यस देशका बासिन्दाहरू सबैलाई म दाखमद्यले मताइदिनेछु। <verse eid="JER 13:13"/><verse number="14" style="v" sid="JER 13:14"/>म तिनीहरूलाई आमाबुबाहरू र छोराछोरीहरू समेतलाई एक-अर्काको विरुद्धमा जुधाइदिनेछु, याहवेह घोषणा गर्नुहुन्छ। मलाई दया, माया, कृपा अथवा कुनै पनि कुराले तिनीहरूलाई सर्वनाश गर्नबाट रोक्न सक्दैन।’ ”<verse eid="JER 13:14"/></para>
  <para style="s1">कैदमा लगिने धम्की</para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 13:15"/>सुन, र ध्यान देओ,</para>
  <para style="q2" vid="JER 13:15">अहङ्कारी नहोओ;</para>
  <para style="q2" vid="JER 13:15">किनकि याहवेहले बोल्नुभएको छ।<verse eid="JER 13:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 13:16"/>परमेश्‍वरले अन्धकार ल्याउन अगि,</para>
  <para style="q2" vid="JER 13:16">अँध्यारो डाँडाहरूमा</para>
  <para style="q1" vid="JER 13:16">तिमीहरूका खुट्टाहरू ठेस खानुभन्दा अगि,</para>
  <para style="q2" vid="JER 13:16">याहवेह तिमीहरूका परमेश्‍वरलाई महिमा देओ।</para>
  <para style="q1" vid="JER 13:16">तिमीहरू उज्यालोको आशा गर्दछौ,</para>
  <para style="q2" vid="JER 13:16">तर उहाँले ज्योतिलाई घोर अन्धकारमा बदली दिनुहुनेछ;</para>
  <para style="q2" vid="JER 13:16">अनि त्यसलाई गहिरो अन्धकार तुल्याइदिनुहुनेछ।<verse eid="JER 13:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 13:17"/>तर तिमीहरूले अझै पनि सुन्‍न इन्कार गर्‍यौ भने,</para>
  <para style="q2" vid="JER 13:17">तिमीहरूको घमण्डको कारणले</para>
  <para style="q2" vid="JER 13:17">म गुप्‍तमा रुनेछु;</para>
  <para style="q1" vid="JER 13:17">आँखामा आँसुको धारा बगाउँदै,</para>
  <para style="q2" vid="JER 13:17">म धुरुधुरु रुनेछु;</para>
  <para style="q2" vid="JER 13:17">किनकि याहवेहको बगाल कैदी भएर लगिनेछ।<verse eid="JER 13:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="JER 13:18"/>राजा र राजमातालाई भन्:</para>
  <para style="q2" vid="JER 13:18">“तपाईंहरूका सिंहासनबाट ओर्लनुहोस्;</para>
  <para style="q1" vid="JER 13:18">किनकि तपाईंहरूका गौरवशाली</para>
  <para style="q2" vid="JER 13:18">मुकुटहरू तपाईंहरूका शिरबाट खस्‍नेछन्।”<verse eid="JER 13:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 13:19"/>दक्षिणमा भएका सहरहरू घेरामा पर्नेछन्;</para>
  <para style="q2" vid="JER 13:19">अनि तिनीहरूलाई सहायता गर्ने कोही हुनेछैनन्।</para>
  <para style="q1" vid="JER 13:19">समस्त यहूदालाई निर्वासनमा लगिनेछ,</para>
  <para style="q2" vid="JER 13:19">तिनीहरू पूर्ण रूपले कैदी भएर लगिनेछन्।<verse eid="JER 13:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="JER 13:20"/>आफ्ना आँखा उठाएर</para>
  <para style="q2" vid="JER 13:20">उत्तर दिशाबाट आइरहेका शत्रुहरूलाई हेर्!</para>
  <para style="q1" vid="JER 13:20">तँलाई सुम्पिदिएको बगालहरू कहाँ छन्,</para>
  <para style="q2" vid="JER 13:20">त्यो बगाल, जसमा तैँले घमण्ड गर्थिस्?<verse eid="JER 13:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 13:21"/>तैँले विशेष मित्रझैँ मानेकोलाई नै,</para>
  <para style="q2" vid="JER 13:21">याहवेहले तँमाथि शासक नियुक्त गरिदिनुहुँदा अब तँ के भन्‍नेछस्?</para>
  <para style="q1" vid="JER 13:21">के यसो हुँदा तँ प्रसुती वेदनामा परेकी स्त्रीझैँ</para>
  <para style="q2" vid="JER 13:21">पीडाले तड्पिने छैनस् र?<verse eid="JER 13:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 13:22"/>अनि यदि तैँले “मलाई किन यस्तो भयो?”</para>
  <para style="q2" vid="JER 13:22">भनेर आफैँलाई सोधिस् भने,</para>
  <para style="q1" vid="JER 13:22">यो त तेरै पापको कारणले गर्दा</para>
  <para style="q2" vid="JER 13:22">तेरो फरिया च्यातिएको छ;</para>
  <para style="q2" vid="JER 13:22">अनि तेरो शरीरसँग दुर्व्यवहार गरिएको छ।<verse eid="JER 13:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 13:23"/>के कूशी<note caller="+" style="f"><char style="fr" closed="false">13:23 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">इथियोपियाली</char></note> मानिसले आफ्नो छाला</para>
  <para style="q2" vid="JER 13:23">अथवा चितुवाले आफ्नो थोप्ला बदली गर्न सक्छ?</para>
  <para style="q1" vid="JER 13:23">तेरो दुष्‍ट काम गर्ने बानी भएको हुँदा तैँले</para>
  <para style="q2" vid="JER 13:23">असल काम गर्न सक्नेछैनस्।<verse eid="JER 13:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="JER 13:24"/>“मरुभूमिको बतासले उडाइदिएको भुसजस्तै</para>
  <para style="q2" vid="JER 13:24">म तँलाई छरपस्ट पारिदिनेछु।<verse eid="JER 13:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 13:25"/>तेरो भाग यही हो,</para>
  <para style="q2" vid="JER 13:25">मैले आदेश दिएको तेरो हिस्सा,” याहवेहले घोषणा गर्नुहुन्छ;</para>
  <para style="q1" vid="JER 13:25">“किनकि तैँले मलाई बिर्सेर</para>
  <para style="q2" vid="JER 13:25">झूटा देवी-देवताहरूमाथि भरोसा गरेको छस्।<verse eid="JER 13:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JER 13:26"/>म तेरो फरिया उचालेर तेरो मुखमा पुर्‍याइदिनेछु,</para>
  <para style="q2" vid="JER 13:26">ताकि तेरो लाज देखियोस्—<verse eid="JER 13:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JER 13:27"/>तैँले गरेको व्यभिचार र तेरो कामुकताको हिनहिनाइ,</para>
  <para style="q2" vid="JER 13:27">र तेरो शर्मलाग्दो वेश्यावृत्ति!</para>
  <para style="q1" vid="JER 13:27">मैले अग्ला डाँडाहरूमा र मैदानहरूमा</para>
  <para style="q2" vid="JER 13:27">तेरा घिनलाग्दा वेश्यावृत्तिहरू देखेको छु।</para>
  <para style="q1" vid="JER 13:27">हे यरूशलेम, तँलाई धिक्‍कार छ!</para>
  <para style="q2" vid="JER 13:27">तँ कहिलेसम्म यसरी अशुद्ध भइरहनेछस्?”<verse eid="JER 13:27"/></para>
  <chapter eid="JER 13"/>
  <chapter number="14" style="c" sid="JER 14"/>
  <para style="s1">खडेरी, अनिकाल र तरवार</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 14:1"/>खडेरीको बारेमा यर्मियाकहाँ आएको याहवेहको वचन यही हो:<verse eid="JER 14:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 14:2"/>“यहूदा विलाप गर्छ,</para>
  <para style="q2" vid="JER 14:2">त्यसका सहरहरू कमजोर भएका छन्;</para>
  <para style="q1" vid="JER 14:2">तिनीहरू देशका निम्ति विलौना गर्छन्;</para>
  <para style="q2" vid="JER 14:2">अनि यरूशलेमका मानिसहरूको चीत्कार आकासिन्छ।<verse eid="JER 14:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 14:3"/>कुलिन मानिसहरूले आफ्ना नोकरहरूलाई पानी लिन पठाउँछन्;</para>
  <para style="q2" vid="JER 14:3">तिनीहरू कुवामा जान्छन्,</para>
  <para style="q2" vid="JER 14:3">तर पानी भेट्टाउँदैनन्।</para>
  <para style="q1" vid="JER 14:3">तिनीहरू आफ्ना गाग्राहरू रित्तै लिएर,</para>
  <para style="q2" vid="JER 14:3">लज्जित र हतोत्साहित भएर,</para>
  <para style="q2" vid="JER 14:3">आफ्ना शिरहरू ढाकेर फर्कन्छन्।<verse eid="JER 14:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 14:4"/>देशमा वर्षा नभएको कारण</para>
  <para style="q2" vid="JER 14:4">जमिन चर्केर चिरा-चिरा परेको छ;</para>
  <para style="q1" vid="JER 14:4">किसानहरू निराश भएका छन्,</para>
  <para style="q2" vid="JER 14:4">र तिनीहरूले आफ्ना शिर ढाकेका छन्।<verse eid="JER 14:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 14:5"/>घाँस नभएको कारणले</para>
  <para style="q2" vid="JER 14:5">मैदानको मुडुली मृगले समेत</para>
  <para style="q2" vid="JER 14:5">आफ्नो बच्‍चालाई छोडिदिन्छे।<verse eid="JER 14:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 14:6"/>जङ्गली गधाहरू अग्ला नाङ्गा डाँडाहरूमा उभिन्छन्</para>
  <para style="q2" vid="JER 14:6">र स्यालहरूजस्तै स्याँ-स्याँ गर्दै सास फेर्छन्;</para>
  <para style="q1" vid="JER 14:6">घाँस खान नपाएको कारण</para>
  <para style="q2" vid="JER 14:6">तिनीहरूले राम्रोसँग देख्न सक्दैनन्।”<verse eid="JER 14:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="JER 14:7"/>हाम्रा पापहरूले हाम्रा विरुद्धमा गवाही दिए तापनि</para>
  <para style="q2" vid="JER 14:7">हे याहवेह, तपाईंको नामको खातिर हामीलाई सहायता गर्नुहोस्।</para>
  <para style="q1" vid="JER 14:7">किनकि हामीले तपाईंको विरुद्धमा बारम्बार पाप गरेका छौँ;</para>
  <para style="q2" vid="JER 14:7">हामीले धेरै अपराधहरू गरेका छौँ।<verse eid="JER 14:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 14:8"/>हे याहवेह, तपाईं इस्राएलको आशा हुनुहुन्छ,</para>
  <para style="q2" vid="JER 14:8">सङ्कष्‍टको समयमा इस्राएलको उद्धारकर्ता,</para>
  <para style="q1" vid="JER 14:8">एक रातको लागि मात्र बास बस्‍ने यात्रीजस्तै,</para>
  <para style="q2" vid="JER 14:8">तपाईं किन यस देशमा एक परदेशीजस्तो हुनुहुन्छ?<verse eid="JER 14:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 14:9"/>तपाईं किन अचम्ममा परेको मानिसजस्तै,</para>
  <para style="q2" vid="JER 14:9">बचाउन नसक्ने शक्तिहीन योद्धाजस्तै हुनुहुन्छ?</para>
  <para style="q1" vid="JER 14:9">हे याहवेह, तपाईं हाम्रा बीचमा हुनुहुन्छ,</para>
  <para style="q2" vid="JER 14:9">र हामी तपाईंको नामले चिनिएका प्रजा हौँ;</para>
  <para style="q2" vid="JER 14:9">हामीलाई नत्याग्नुहोस्!<verse eid="JER 14:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 14:10"/>यस जातिको विषयमा याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="JER 14:10">“तिनीहरू बाटो बिराएर हिँड्न साह्रै मन पराउँछन्;</para>
  <para style="q2" vid="JER 14:10">तिनीहरूले आफ्ना खुट्टाहरूलाई वशमा राख्दैनन्।</para>
  <para style="q1" vid="JER 14:10">यसकारण याहवेहले तिनीहरूलाई स्वीकार गर्नुहुन्‍न;</para>
  <para style="q2" vid="JER 14:10">अब उहाँले तिनीहरूका दुष्‍टतालाई सम्झनुहुन्छ,</para>
  <para style="q2" vid="JER 14:10">र तिनीहरूका पापका निम्ति तिनीहरूलाई दण्ड दिनुहुनेछ।”<verse eid="JER 14:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 14:11"/>तब याहवेहले मलाई भन्‍नुभयो, “यी मानिसहरूको भलाइको निम्ति प्रार्थना नगर्। <verse eid="JER 14:11"/><verse number="12" style="v" sid="JER 14:12"/>तिनीहरूले उपवास बसे तापनि म तिनीहरूको विलौना सुन्‍नेछैन; तिनीहरूले होमबलि र अन्‍नबलि चढाए तापनि म खुशी हुनेछैन। त्यसको सट्टा म तिनीहरूलाई तरवार, अनिकाल र रूढीले नाश गर्नेछु।”<verse eid="JER 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 14:13"/>तर मैले भनेँ, “हे, प्रभु याहवेह! अगमवक्ताहरूले तिनीहरूलाई यसो भनिरहेका छन्, ‘तिमीहरूले तरवार र अनिकाल देख्नेछैनौ। अवश्य नै याहवेह परमेश्‍वरले तिमीहरूलाई यस ठाउँमा अनन्तको शान्ति दिनुहुनेछ।’ ”<verse eid="JER 14:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 14:14"/>तब याहवेहले मलाई भन्‍नुभयो, “ती अगमवक्ताहरूले मेरो नाममा झूटो अगमवाणी गरिरहेका छन्। मैले न तिनीहरूलाई पठाएको हुँ, न त नियुक्त नै गरेको हुँ, न त तिनीहरूसँग नै बोलेको छु। तिनीहरूले तिमीहरूसँग आफ्नै मनका झूटा दर्शनहरू, तन्त्रमन्त्रहरू, मूर्तिपूजाहरू र मनका भ्रमात्मक कुराहरू अगमवाणी गरिरहेका छन्। <verse eid="JER 14:14"/><verse number="15" style="v" sid="JER 14:15"/>यसकारण याहवेहले उहाँको नाममा झूटो अगमवाणी गर्ने अगमवक्ताहरूको विषयमा यसो भन्‍नुहुन्छ: मैले तिनीहरूलाई पठाएको होइनँ, तर पनि तिनीहरूले यसो भनिरहेका छन्, ‘यस देशलाई कुनै तरवारले अथवा अनिकालले छुनेछैन।’ यसकारण ती अगमवक्ताहरू तरवार र अनिकालले नाश हुनेछन्। <verse eid="JER 14:15"/><verse number="16" style="v" sid="JER 14:16"/>अनि ती झूटा अगमवक्ताहरूले अगमवाणी गरिरहेका मानिसहरू अनिकाल र तरवारको कारण यरूशलेमका सडकहरूमा फ्याँकिनेछन्। तिनीहरू, तिनीहरूका पत्नीहरू र छोराछोरीहरूलाई गाड्ने कोही पनि हुनेछैनन्। म तिनीहरूले भोग्नुपर्ने विपत्ति तिनीहरूमाथि खन्याइदिनेछु।<verse eid="JER 14:16"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="17" style="v" sid="JER 14:17"/>“तैँले तिनीहरूलाई यो वचन भन्‍नू:</para>
  <para style="q1" vid="JER 14:17">“ ‘मेरा आँखाबाट आँसुको धारा</para>
  <para style="q2" vid="JER 14:17">नथामियोस् र मेरो आँसु दिनरात बगिरहोस्;</para>
  <para style="q1" vid="JER 14:17">किनकि मेरो जातिको कुमारी छोरीलाई,</para>
  <para style="q2" vid="JER 14:17">गहिरो चोट लागेको छ, र</para>
  <para style="q2" vid="JER 14:17">ठूलो चोट लाग्ने प्रहार भएको छ।<verse eid="JER 14:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 14:18"/>यदि म देशभित्र गएँ भने,</para>
  <para style="q2" vid="JER 14:18">म तरवारद्वारा मारिएकाहरूलाई देख्छु;</para>
  <para style="q1" vid="JER 14:18">यदि म सहरभित्र गएँ भने,</para>
  <para style="q2" vid="JER 14:18">म अनिकालले पीडित मानिसहरूलाई देख्छु।</para>
  <para style="q1" vid="JER 14:18">अगमवक्ता र पुजारी दुवै,</para>
  <para style="q2" vid="JER 14:18">तिनीहरूले नचिनेको देशमा गएका छन्।’ ”<verse eid="JER 14:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="JER 14:19"/>हे परमेश्‍वर, के तपाईंले यहूदालाई पूर्ण रूपले त्याग्नुभएको छ?</para>
  <para style="q2" vid="JER 14:19">के तपाईंले सियोनलाई तुच्छ ठान्‍नुहुन्छ?</para>
  <para style="q1" vid="JER 14:19">किन तपाईंले हामीलाई निको नहुने गरी</para>
  <para style="q2" vid="JER 14:19">यति धेरै घाइते पार्नुभएको छ?</para>
  <para style="q1" vid="JER 14:19">हामीले शान्तिको आशा गरेका थियौँ,</para>
  <para style="q2" vid="JER 14:19">तर कुनै पनि असल कुरा भएको छैन;</para>
  <para style="q1" vid="JER 14:19">निको हुने आशा गरेका थियौँ,</para>
  <para style="q2" vid="JER 14:19">तर त्यहाँ आतङ्कित मात्र भएका छौँ।<verse eid="JER 14:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 14:20"/>हे याहवेह, हामी आफ्ना दुष्‍टता</para>
  <para style="q2" vid="JER 14:20">र हाम्रा पितापुर्खाहरूका अपराधहरू जान्दछौँ;</para>
  <para style="q2" vid="JER 14:20">साँच्‍चै नै हामीले तपाईंको विरुद्धमा पाप गरेका छौँ।<verse eid="JER 14:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 14:21"/>तर तपाईंको नामको खातिर हामीलाई घृणा नगर्नुहोस्;</para>
  <para style="q2" vid="JER 14:21">तपाईंको महिमित सिंहासनको अपमान नगर्नुहोस्।</para>
  <para style="q1" vid="JER 14:21">हामीसँग गर्नुभएको तपाईंको करार सम्झनुहोस्,</para>
  <para style="q2" vid="JER 14:21">र त्यस करारलाई नतोड्नुहोस्।<verse eid="JER 14:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 14:22"/>के जातिहरूका कामै नलाग्ने मूर्तिहरूले वर्षा ल्याउन सक्छन् र?</para>
  <para style="q2" vid="JER 14:22">के आकाशहरू आफैँले झरी पठाउन सक्छन् र?</para>
  <para style="q1" vid="JER 14:22">यस्तो हुन सक्दैन, हे याहवेह, अथवा हाम्रा परमेश्‍वर</para>
  <para style="q2" vid="JER 14:22">तपाईंले मात्र यस्तो गर्न सक्नुहुन्छ।</para>
  <para style="q2" vid="JER 14:22">यसकारण हाम्रो आशा तपाईंमा छ;</para>
  <para style="q2" vid="JER 14:22">किनकि यी सबै कुराहरू गर्नुहुने तपाईं नै हुनुहुन्छ।<verse eid="JER 14:22"/></para>
  <chapter eid="JER 14"/>
  <chapter number="15" style="c" sid="JER 15"/>
  <para style="p">
    <verse number="1" style="v" sid="JER 15:1"/>तब याहवेहले मलाई भन्‍नुभयो: “यदि मोशा र शमूएल नै मेरो सामु खडा भएर बिन्ती गरे तापनि यस जातिप्रति मेरो हृदय फर्कनेछैनँ। यी मानिसहरूलाई मेरो दृष्‍टिबाट टाढा पठाई दे! तिनीहरू जाऊन्! <verse eid="JER 15:1"/><verse number="2" style="v" sid="JER 15:2"/>अनि यदि तिनीहरूले तँलाई यसो भनेर सोधे भने, ‘हामी कता जाऔँ?’ तिनीहरूलाई भन्‍नू, ‘याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="JER 15:2">“ ‘मृत्युका निम्ति ठहराइएकाहरू मृत्युमा जाऊन्;</para>
  <para style="q1" vid="JER 15:2">तरवारका निम्ति ठहराइएकाहरू तरवारमा जाऊन्;</para>
  <para style="q1" vid="JER 15:2">अनिकालका निम्ति ठहराइएकाहरू, अनिकालमा जाऊन्;</para>
  <para style="q1" vid="JER 15:2">कैदका निम्ति ठहराइएकाहरू, कैदमा नै जाऊन्।’ ”<verse eid="JER 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 15:3"/>याहवेह घोषणा गर्नुहुन्छ, “म तिनीहरूका विरुद्धमा चार किसिमका विनाशहरू पठाउनेछु: तिनीहरूलाई मार्नलाई तरवार, घिसार्दै लैजानलाई कुकुरहरू; अनि निल्न र नाश गर्नलाई आकाशका चराहरू र जमिनका पशुहरू। <verse eid="JER 15:3"/><verse number="4" style="v" sid="JER 15:4"/>यहूदाका राजा हिजकियाका छोरा मनश्शेले यरूशलेममा जे गरेका थिए, त्यसैको कारणले म यहूदाका मानिसहरूलाई देख्ने पृथ्वीभरिका सबै राज्यहरू भयभीत हुने तुल्याइदिनेछु।<verse eid="JER 15:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 15:5"/>“हे यरूशलेम, तँलाई कसले दया देखाउला?</para>
  <para style="q2" vid="JER 15:5">तेरा निम्ति कसले विलाप गर्ला?</para>
  <para style="q2" vid="JER 15:5">तँ कस्तो छस् भनी सोध्न को रोकिएला?”<verse eid="JER 15:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 15:6"/>याहवेह घोषणा गर्नुहुन्छ,</para>
  <para style="q2" vid="JER 15:6">“यरूशलेम, तैँले मलाई त्यागेको छस्।</para>
  <para style="q2" vid="JER 15:6">तैँले मतिर आफ्नो पिठिउँ फर्काएको छस्।</para>
  <para style="q1" vid="JER 15:6">यसकारण म तेरो विरुद्धमा आफ्नो हात उठाउनेछु र तँलाई विनाश गर्नेछु;</para>
  <para style="q2" vid="JER 15:6">अब म तँप्रतिको रिस थाम्न सक्दिनँ।<verse eid="JER 15:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 15:7"/>देशका मूलढोकाहरूमा</para>
  <para style="q2" vid="JER 15:7">म तिनीहरूलाई नाङ्लोले निफनेझैँ निफन्‍नेछु।</para>
  <para style="q1" vid="JER 15:7">म मेरा मानिसहरूमाथि तिनीहरूका सन्तानको शोक र सर्वनाश ल्याउनेछु;</para>
  <para style="q2" vid="JER 15:7">किनकि तिनीहरूले आफ्ना मार्गहरू बदली गरेका छैनन्।<verse eid="JER 15:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 15:8"/>म तिनीहरूका विधवाहरूको संख्या</para>
  <para style="q2" vid="JER 15:8">समुद्रको बालुवाभन्दा धेरै बढाउनेछु।</para>
  <para style="q1" vid="JER 15:8">मध्यदिनको समयमा म तिनीहरूका जवान ठिटाहरूका</para>
  <para style="q2" vid="JER 15:8">आमाहरूको विरुद्धमा एक जना विनाशकर्तालाई ल्याउनेछु;</para>
  <para style="q1" vid="JER 15:8">म तिनीहरूमाथि एक्‍कासि</para>
  <para style="q2" vid="JER 15:8">सङ्कष्‍ट र त्रास ल्याउनेछु।<verse eid="JER 15:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 15:9"/>सात जनाकी आमा बेहोश हुनेछे,</para>
  <para style="q2" vid="JER 15:9">र त्यसले आफ्नो अन्तिम सास फेर्नेछे।</para>
  <para style="q1" vid="JER 15:9">दिन छँदै त्यसको सूर्य अस्ताउँछ;</para>
  <para style="q2" vid="JER 15:9">त्यो अपमानित हुनेछे र शर्ममा पर्नेछे।</para>
  <para style="q1" vid="JER 15:9">बाँचेकाहरूलाई चाहिँ</para>
  <para style="q2" vid="JER 15:9">म तिनीहरूका शत्रुहरूको सामु तरवारले मार्न दिनेछु,”</para>
  <para style="q2" vid="JER 15:9">याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 15:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="JER 15:10"/>यर्मियाले भने, हाय म कस्तो दुःखी मान्छे हुँ।</para>
  <para style="q2" vid="JER 15:10">मेरी आमाले मजस्तो मानिसलाई जन्माउनुभयो!</para>
  <para style="q2" vid="JER 15:10">एउटा यस्तो मानिस, जससँग सारा देशले झगडा र विवाद गर्छ!</para>
  <para style="q1" vid="JER 15:10">मैले तिनीहरूलाई न ऋण दिएको छु, न त ऋण नै लिएको छु,</para>
  <para style="q2" vid="JER 15:10">तर पनि सबै मानिसहरूले मलाई सराप्छन्।<verse eid="JER 15:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 15:11"/>याहवेहले भन्‍नुभयो,</para>
  <para style="q1" vid="JER 15:11">“निश्‍चय नै म तँलाई असल उद्देश्यले छुटाउनेछु;</para>
  <para style="q2" vid="JER 15:11">निश्‍चय नै म तेरा शत्रुहरूलाई दुःख र सङ्कष्‍टको समयमा,</para>
  <para style="q2" vid="JER 15:11">तँसित बिन्ती गर्न लगाउनेछु।<verse eid="JER 15:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="JER 15:12"/>“के कुनै मानिसले फलाम भाँच्न सक्छ,</para>
  <para style="q2" vid="JER 15:12">उत्तर दिशाको फलाम अथवा काँसालाई भाँच्न सक्छ?<verse eid="JER 15:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JER 15:13"/>“तिमीहरूले आफ्नो देशभरि</para>
  <para style="q2" vid="JER 15:13">गरेका पापहरूको कारणले</para>
  <para style="q1" vid="JER 15:13">तिमीहरूका सम्पत्ति र तिमीहरूका भण्डारहरू,</para>
  <para style="q2" vid="JER 15:13">लुटको मालसामानजस्तै, म सितैँमा अरूलाई दिनेछु।<verse eid="JER 15:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 15:14"/>तिमीहरूले नचिनेका देशमा</para>
  <para style="q2" vid="JER 15:14">तिमीहरूलाई आफ्नै शत्रुका दास तुल्याउनेछु;</para>
  <para style="q1" vid="JER 15:14">किनकि मेरो क्रोध आगोजस्तै दन्कनेछ,</para>
  <para style="q2" vid="JER 15:14">जुन तेरो विरुद्धमा दन्कनेछ।”<verse eid="JER 15:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="JER 15:15"/>तब यर्मियाले भने, हे याहवेह, तपाईंलाई सबै कुरा थाहा छ;</para>
  <para style="q2" vid="JER 15:15">मलाई सम्झनुहोस् र मेरो निम्ति काम गर्नुहोस्।</para>
  <para style="q2" vid="JER 15:15">मलाई सताउनेहरूलाई बदला लिनुहोस्।</para>
  <para style="q1" vid="JER 15:15">तपाईं धैर्यवान् हुनुहुन्छ। मलाई टाढा नलैजानुहोस्;</para>
  <para style="q2" vid="JER 15:15">मैले तपाईंका निम्ति कति अपमान सहेको छु, सो विचार गर्नुहोस्।<verse eid="JER 15:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 15:16"/>जब तपाईंका वचनहरू आए, मैले ती सबै निलेँ;</para>
  <para style="q2" vid="JER 15:16">ती वचनहरू मेरा निम्ति आनन्द र हृदयको निम्ति हर्षको स्रोत थिए;</para>
  <para style="q1" vid="JER 15:16">किनकि हे याहवेह सेनाहरूका परमेश्‍वर,</para>
  <para style="q2" vid="JER 15:16">मैले तपाईंको नाम बोकेको छु।<verse eid="JER 15:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 15:17"/>म मोजमज्जा गर्नेहरूको समूहमा कहिल्यै बसिनँ;</para>
  <para style="q2" vid="JER 15:17">तिनीहरूसँग कहिल्यै रमाइलो गरिनँ;</para>
  <para style="q1" vid="JER 15:17">म एकलै बसेँ, किनकि तपाईंको हात ममाथि थियो</para>
  <para style="q2" vid="JER 15:17">र तपाईंले मलाई रिसले भरिदिनुभएको थियो।<verse eid="JER 15:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 15:18"/>मेरो पीडाको अन्त्य किन हुँदैन,</para>
  <para style="q2" vid="JER 15:18">र मेरो घाउ किन पीडादायक र निको नहुने भएको छ?</para>
  <para style="q1" vid="JER 15:18">के तपाईं मेरा निम्ति सुकेर जाने खोल्साजस्तै हुनुहुन्छ,</para>
  <para style="q2" vid="JER 15:18">भर पर्न नसकिने मुहानजस्तै?<verse eid="JER 15:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 15:19"/>यसकारण याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="JER 15:19">“यदि तैँले पश्‍चात्ताप गरिस् भने म तँलाई पुनर्स्थापित गर्नेछु,</para>
  <para style="q2" vid="JER 15:19">र तँ मेरो सेवक बन्‍नेछस्;</para>
  <para style="q1" vid="JER 15:19">यदि तैँले व्यर्थको कुरा नगरेर मूल्यवान् कुराहरू मात्र बोलिस् भने,</para>
  <para style="q2" vid="JER 15:19">तँ मेरो अगमवक्ता हुनेछस्।</para>
  <para style="q1" vid="JER 15:19">यी मानिसहरू तँतिर फर्कून्,</para>
  <para style="q2" vid="JER 15:19">तर तँचाहिँ तिनीहरूतिर नफर्कनू।<verse eid="JER 15:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 15:20"/>म तँलाई यी मानिसहरूका निम्ति एउटा पर्खाल,</para>
  <para style="q2" vid="JER 15:20">काँसाको एउटा किल्‍ला बनाउनेछु;</para>
  <para style="q1" vid="JER 15:20">तिनीहरू तेरो विरुद्धमा लडाइँ गर्नेछन्,</para>
  <para style="q2" vid="JER 15:20">तर तँमाथि विजयी हुनेछैनन्;</para>
  <para style="q1" vid="JER 15:20">किनकि तँलाई विजय दिन र बचाउन</para>
  <para style="q2" vid="JER 15:20">म तेरो साथमा छु,”</para>
  <para style="q2" vid="JER 15:20">याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 15:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 15:21"/>“म तँलाई दुष्‍टहरूका हातबाट बचाउनेछु;</para>
  <para style="q2" vid="JER 15:21">अनि म तँलाई निर्दयीहरूका हत्केलाबाट छुटाउनेछु।”<verse eid="JER 15:21"/></para>
  <chapter eid="JER 15"/>
  <chapter number="16" style="c" sid="JER 16"/>
  <para style="s1">विपत्तिको दिन</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 16:1"/>फेरि याहवेहको यो वचन मकहाँ आयो: <verse eid="JER 16:1"/><verse number="2" style="v" sid="JER 16:2"/>“तैँले यस ठाउँमा विवाह गर्नु र छोराछोरीहरू जन्माउनुहुँदैन।” <verse eid="JER 16:2"/><verse number="3" style="v" sid="JER 16:3"/>किनकि यस ठाउँमा जन्मेका छोराछोरीहरूको बारेमा र तिनीहरूलाई जन्म दिने तिनीहरूका आमा र बुबाहरूको बारेमा याहवेह यसो भन्‍नुहुन्छ: <verse eid="JER 16:3"/><verse number="4" style="v" sid="JER 16:4"/>“तिनीहरू घातक रोगले मर्नेछन्। तिनीहरूका निम्ति शोक गरिनेछैन, तर तिनीहरू मैदानमा लडिरहने मलजस्तै हुनेछन्। तिनीहरू तरवार र अनिकालले नष्‍ट हुनेछन्; अनि तिनीहरूका लासहरू आकाशका चराहरू र जमिनका पशुहरूका निम्ति भोजन हुनेछन्।”<verse eid="JER 16:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 16:5"/>किनकि याहवेह यसो भन्‍नुहुन्छ: “मृत्यु भएको घरमा भोज खान नजा; अथवा शोक गर्न र सहानुभूति प्रकट गर्न पनि नजा; किनकि मैले यस जातिबाट मेरो आशिष्, मेरो प्रेम र मेरो दया फिर्ता लिइसकेको छु,” याहवेह घोषणा गर्नुहुन्छ। <verse eid="JER 16:5"/><verse number="6" style="v" sid="JER 16:6"/>“यस देशका धनी र गरिब सबै मानिसहरू मर्नेछन्। तिनीहरू गाडिनेछैनन् र तिनीहरूको निम्ति शोक गरिनेछैन; अनि कसैले पनि तिनीहरूका निम्ति आफ्नो शरीर काट्ने छैनन्, अथवा आफ्नो कपाल खौरनेछैनन्। <verse eid="JER 16:6"/><verse number="7" style="v" sid="JER 16:7"/>मरेकाहरूका निम्ति शोक गर्नेहरूलाई सान्त्वना दिन कसैले पनि भोजन दिनेछैन। तिनीहरूका बुबा र आमाका निम्ति शोक गर्नेलाई समेत कसैले तिनीहरूलाई सान्त्वनाको पानी दिनेछैन।<verse eid="JER 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 16:8"/>“यदि कुनै घरमा भोज भइरहेको छ भने तापनि तिनीहरूसित खान र पिउनलाई तँ नबस्। <verse eid="JER 16:8"/><verse number="9" style="v" sid="JER 16:9"/>किनकि सेनाहरूका याहवेह, इस्राएलका परमेश्‍वर यसो भन्‍नुहुन्छ: तिमीहरूका आँखाकै सामु र तिमीहरूकै समयमा यस ठाउँमा हर्ष र आनन्दको आवाज, दुलहा र दुलहीको सोर म बन्द गरिदिनेछु।<verse eid="JER 16:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 16:10"/>“जब तैँले यी मानिसहरूलाई यी सबै कुरा भन्‍नेछस्, र तिनीहरूले तँलाई सोध्नेछन्, ‘किन याहवेहले हाम्रो विरुद्धमा यति ठूलो विपत्ति जारी गर्नुभएको छ? हामीले के अपराध गरेका छौँ र? हामीले याहवेह हाम्रा परमेश्‍वरको विरुद्धमा के पाप गरेका छौँ र?’ <verse eid="JER 16:10"/><verse number="11" style="v" sid="JER 16:11"/>तब तिनीहरूलाई भन्, ‘किनभने तिमीहरूका पितापुर्खाहरूले मलाई त्यागेर अरू देवताहरूको पछि लागे; अनि तिनीहरूको सेवा गरे र तिनीहरूको पूजा गरे। तिनीहरूले मलाई त्यागे र मेरो व्यवस्थालाई पनि पालन गरेनन्। <verse eid="JER 16:11"/><verse number="12" style="v" sid="JER 16:12"/>तर तिमीहरू त तिमीहरूका पितापुर्खाहरूभन्दा बढी दुष्‍ट हृदयको हठीपनामा हिँडिरहेका छौ। <verse eid="JER 16:12"/><verse number="13" style="v" sid="JER 16:13"/>यसकारण म तिमीहरूलाई यस देशबाट निकालेर तिमीहरू र तिमीहरूका पितापुर्खाहरूले नचिनेको देशमा फ्याँकिदिनेछु; अनि तिमीहरूले त्यहाँ दिनरात अरू देवताहरूको सेवा गर्नेछौ; किनकि म तिमीहरूमाथि कुनै दया देखाउनेछैन।’<verse eid="JER 16:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 16:14"/>“यसकारण हेर, दिनहरू आउँदैछन्,” याहवेह घोषणा गर्नुहुन्छ, “जब मानिसहरूले फेरि यसो भनेर शपथ खानेछैनन्, ‘निश्‍चय नै जीवित याहवेहको नाममा, जसले इस्राएलीहरूलाई इजिप्टबाट निकालेर ल्याउनुभयो।’ <verse eid="JER 16:14"/><verse number="15" style="v" sid="JER 16:15"/>तर तिनीहरूले यसो भन्‍नेछन्, ‘निश्‍चय नै जीवित याहवेहको नाममा, जसले इस्राएलीहरूलाई उत्तरको देशबाट र उहाँले तिनीहरूलाई निर्वासनमा पठाउनुभएका सबै सहरहरूबाट निकालेर ल्याउनुभयो।’ किनकि मैले तिनीहरूका पितापुर्खाहरूलाई दिएको देशमा म तिनीहरूलाई पुनर्स्थापित गर्नेछु।<verse eid="JER 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 16:16"/>याहवेह घोषणा गर्नुहुन्छ, “तर अब हेर, म धेरै जालहारीहरूलाई पठाउनेछु, र तिनीहरूले मानिसहरूलाई पक्रनेछन्। त्यसपछि म धेरै शिकारीहरूलाई पठाउनेछु; अनि तिनीहरूले मानिसहरूलाई प्रत्येक अग्ला पर्वत, पहाड र चट्टानका ओडारहरूबाट खोजेर निकाल्नेछन्। <verse eid="JER 16:16"/><verse number="17" style="v" sid="JER 16:17"/>तिनीहरूका हरेक मार्गहरूमाथि मेरो दृष्‍टि छ; तिनीहरूका गतिविधिहरू मबाट लुकेका छैनन्, न त तिनीहरूका अपराधहरू मेरा आँखाबाट लुकेका छन्। <verse eid="JER 16:17"/><verse number="18" style="v" sid="JER 16:18"/>म तिनीहरूका दुष्‍टता र तिनीहरूका अपराधका निम्ति दोबर दण्ड दिनेछु; किनकि तिनीहरूले मेरो देशलाई तिनीहरूका घृणित मूर्तिहरूका निर्जीव आकृतिहरूले अशुद्ध पारेका छन्, र मेरो उत्तराधिकारको देशलाई आफ्ना घिनलाग्दा मूर्तिहरूले भरिदिएका छन्।”<verse eid="JER 16:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 16:19"/>हे याहवेह, मेरो बल र मेरो किल्‍ला,</para>
  <para style="q2" vid="JER 16:19">दुःखको दिनमा मेरो शरणस्थान,</para>
  <para style="q1" vid="JER 16:19">पृथ्वीका कुना कुनाबाट जातिहरू</para>
  <para style="q2" vid="JER 16:19">तपाईंकहाँ आएर भन्‍नेछन्,</para>
  <para style="q1" vid="JER 16:19">“हाम्रा पितापुर्खाहरूले झूटा देवताहरूबाहेक केही अधिकार गरेनन्;</para>
  <para style="q2" vid="JER 16:19">यस्ता काम नलाग्ने मूर्तिहरू, जसले तिनीहरूलाई केही फाइदा भएन।<verse eid="JER 16:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 16:20"/>के मानिसहरूले आफ्ना निम्ति देवी-देवताहरू आफैँ बनाउँछन् र?</para>
  <para style="q2" vid="JER 16:20">अँ! बनाउँछन्, तर तिनीहरू त ईश्‍वरहरू नै होइनन्!”<verse eid="JER 16:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="JER 16:21"/>“यसकारण म तिनीहरूलाई सिकाउनेछु;</para>
  <para style="q2" vid="JER 16:21">यस पटक म तिनीहरूलाई</para>
  <para style="q2" vid="JER 16:21">मेरो शक्ति र महानता देखाउनेछु।</para>
  <para style="q1" vid="JER 16:21">तब मेरो नाम याहवेह हो</para>
  <para style="q2" vid="JER 16:21">भनी तिनीहरूले जान्‍नेछन्।<verse eid="JER 16:21"/></para>
  <para style="b"/>
  <chapter eid="JER 16"/>
  <chapter number="17" style="c" sid="JER 17"/>
  <para style="q1">
    <verse number="1" style="v" sid="JER 17:1"/>“यहूदाका पापहरू फलामका हतियारले खोपिएका छन्;</para>
  <para style="q2" vid="JER 17:1">चकमके ढुङ्गाको टुप्पोले</para>
  <para style="q1" vid="JER 17:1">तिनीहरूका हृदयका पाटीमा</para>
  <para style="q2" vid="JER 17:1">र तिनीहरूका वेदीहरूका सिङहरूमा खोपिएका छन्।<verse eid="JER 17:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 17:2"/>तिनीहरूका छोराछोरीहरूले पनि</para>
  <para style="q2" vid="JER 17:2">झाँगिएका रूखहरू</para>
  <para style="q1" vid="JER 17:2">र अग्ला डाँडाहरूका छेउमा भएका</para>
  <para style="q2" vid="JER 17:2">अशेराका खम्बाहरू<note caller="+" style="f"><char style="fr" closed="false">17:2 </char><char style="ft" closed="false">अर्थात्, काठमा बनाइएका अशेरा देवीका आकृतिहरू</char></note> र वेदीहरूको सम्झना गर्छन्।<verse eid="JER 17:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 17:3"/>देशभरि नै तिमीहरूले गरेका आफ्ना पापको कारण</para>
  <para style="q2" vid="JER 17:3">म यस देशमा भएको मेरो पर्वत,</para>
  <para style="q1" vid="JER 17:3">तिमीहरूका धनसम्पत्ति र तिमीहरूका सबै भण्डारहरू</para>
  <para style="q2" vid="JER 17:3">साथै तिमीहरूका अग्ला ठाउँहरूसमेत</para>
  <para style="q2" vid="JER 17:3">सबै लुटको मालझैँ म लान दिनेछु।<verse eid="JER 17:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 17:4"/>तिमीहरूका आफ्नै गल्तीको कारण</para>
  <para style="q2" vid="JER 17:4">मैले तिमीहरूलाई दिएको अधिकार गुमाउनेछौ।</para>
  <para style="q1" vid="JER 17:4">तिमीहरूले नचिनेको देशमा</para>
  <para style="q2" vid="JER 17:4">म तिमीहरूलाई तिमीहरूकै शत्रुहरूको दास बनाउनेछु;</para>
  <para style="q1" vid="JER 17:4">किनकि तिमीहरूले मेरो रिसलाई दन्काएका छौ;</para>
  <para style="q2" vid="JER 17:4">अनि यो सधैँभरि जलिरहनेछ।”<verse eid="JER 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 17:5"/>याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="JER 17:5">“श्रापित होस् त्यो मानिस, जसले मानिसमाथि भरोसा राख्छ,</para>
  <para style="q2" vid="JER 17:5">जो आफ्नो शारीरिक शक्तिमा भर पर्छ;</para>
  <para style="q2" vid="JER 17:5">अनि जसको हृदय याहवेहबाट तर्किएर जान्छ।<verse eid="JER 17:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 17:6"/>त्यो मानिस उजाड ठाउँमा भएको झाडीजस्तै हुनेछ;</para>
  <para style="q2" vid="JER 17:6">समृद्धि हुँदा तिनीहरूले त्यो देख्नेछैनन्।</para>
  <para style="q1" vid="JER 17:6">तिनीहरू मरुभूमिका सुक्खा ठाउँहरूमा,</para>
  <para style="q2" vid="JER 17:6">कोही पनि नबस्‍ने नुनिलो भूमिमा बसोबास गर्नेछन्।<verse eid="JER 17:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="JER 17:7"/>“धन्य हो त्यो मानिस, जसले याहवेहमा भरोसा राख्दछ,</para>
  <para style="q2" vid="JER 17:7">जसको भरोसा उहाँमाथि हुन्छ।<verse eid="JER 17:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 17:8"/>तिनीहरू पानीको छेउमा रोपिएको रूखजस्तै हुनेछन्,</para>
  <para style="q2" vid="JER 17:8">जसका जराहरू खोलासम्म फैलिएका हुन्छन्।</para>
  <para style="q1" vid="JER 17:8">गर्मीका दिनहरू आउँदा पनि त्यसलाई डर हुँदैन;</para>
  <para style="q2" vid="JER 17:8">त्यसका पातहरू सधैँभरि हरिया रहन्छन्।</para>
  <para style="q1" vid="JER 17:8">खडेरीको वर्षमा त्यसलाई कुनै फिक्री हुँदैन,</para>
  <para style="q2" vid="JER 17:8">र त्यसले फल फलाउन कहिल्यै छोड्दैन।”<verse eid="JER 17:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="JER 17:9"/>मानिसको हृदय सबैभन्दा छली हुन्छ,</para>
  <para style="q2" vid="JER 17:9">र यो निको हुन नसक्ने किसिमको छ।</para>
  <para style="q2" vid="JER 17:9">हृदयलाई कसले बुझ्न सक्छ र?<verse eid="JER 17:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="JER 17:10"/>“म याहवेहले हृदयको खोजी गर्छु,</para>
  <para style="q2" vid="JER 17:10">र मनको जाँच गर्छु,</para>
  <para style="q1" vid="JER 17:10">मानिसहरूलाई तिनीहरूका जीवनका चालअनुसार</para>
  <para style="q2" vid="JER 17:10">र तिनीहरूका कामअनुसार प्रतिफल दिनेछु।”<verse eid="JER 17:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="JER 17:11"/>बेइमानीसाथ धन कमाउने मानिस</para>
  <para style="q2" vid="JER 17:11">आफूले नपारेको अण्डामा ओथ्रा बसेर चल्‍ला काढ्ने तित्रा चराजस्तै हुन्छ।</para>
  <para style="q1" vid="JER 17:11">जब तिनीहरूको आधा उमेर बितेर जान्छ,</para>
  <para style="q2" vid="JER 17:11">तब तिनीहरूको धनसम्पत्तिले तिनीहरूको साथ छोड्नेछ;</para>
  <para style="q1" vid="JER 17:11">अनि अन्त्यमा तिनीहरू मूर्ख ठहरिनेछन्।<verse eid="JER 17:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="JER 17:12"/>सुरुदेखिकै उच्‍च पारिएको तपाईंको महिमित सिंहासन,</para>
  <para style="q2" vid="JER 17:12">हाम्रो पवित्रस्थानको ठाउँ हो।<verse eid="JER 17:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 17:13"/>हे याहवेह, इस्राएलका आशा तपाईं नै हुनुहुन्छ;</para>
  <para style="q2" vid="JER 17:13">तपाईंलाई त्याग्नेहरू सबै लाजमा पर्नेछन्।</para>
  <para style="q1" vid="JER 17:13">तपाईंबाट तर्किएर जानेहरूको नाम धुलोमा लेखिनेछन्;</para>
  <para style="q2" vid="JER 17:13">किनकि तिनीहरूले याहवेह,</para>
  <para style="q2" vid="JER 17:13">जीवित पानीका मूललाई त्यागेका छन्।<verse eid="JER 17:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="JER 17:14"/>मलाई निको पार्नुहोस्, हे याहवेह, र म निको हुनेछु;</para>
  <para style="q2" vid="JER 17:14">मलाई बचाउनुहोस्, र म बाँच्नेछु;</para>
  <para style="q2" vid="JER 17:14">किनकि तपाईं मात्र हुनुहुन्छ, जसको म प्रशंसा गर्दछु।<verse eid="JER 17:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 17:15"/>हेर्नुहोस्, मानिसहरूले मलाई भनिरहन्छन्,</para>
  <para style="q2" vid="JER 17:15">“याहवेहको वचन कहाँ छ?</para>
  <para style="q2" vid="JER 17:15">तपाईंको वचन अहिले नै पूरा भइजाओस्!”<verse eid="JER 17:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 17:16"/>म तपाईंको सेवामा गोठालो हुनदेखि भागेर गएको छैन;</para>
  <para style="q2" vid="JER 17:16">तपाईंलाई थाहा छ, मैले निराशको दिन चाहेको छैन।</para>
  <para style="q2" vid="JER 17:16">मेरा ओठबाट निस्केका सबै कुरा तपाईंकै सामु छन्।<verse eid="JER 17:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 17:17"/>तपाईं मेरो त्रासको कारण नबन्‍नुहोस्;</para>
  <para style="q2" vid="JER 17:17">मेरो विपत्तिको दिनमा तपाईं नै मेरो शरणस्थान हुनुहुन्छ।<verse eid="JER 17:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 17:18"/>मलाई सताउनेहरू शर्ममा परून्,</para>
  <para style="q2" vid="JER 17:18">तर मलाईचाहिँ शर्ममा पर्नबाट जोगाउनुहोस्;</para>
  <para style="q1" vid="JER 17:18">तिनीहरू त्रसित होऊन्,</para>
  <para style="q2" vid="JER 17:18">तर मलाई त्रासबाट जोगाउनुहोस्।</para>
  <para style="q1" vid="JER 17:18">तिनीहरूमाथि विपत्तिको दिन ल्याइदिनुहोस्;</para>
  <para style="q2" vid="JER 17:18">तिनीहरूलाई दोबर विपत्तिले सर्वनाश गर्नुहोस्।<verse eid="JER 17:18"/></para>
  <para style="s1">शब्बाथ दिन पवित्र राख</para>
  <para style="p">
    <verse number="19" style="v" sid="JER 17:19"/>याहवेहले मलाई यसो भन्‍नुभयो: “जा, र यहूदाका राजाहरू भित्र र बाहिर गर्ने सेनाहरूको मूलढोकामा उभी; यरूशलेमका अरू सबै मूलढोकाहरूमा पनि उभी। <verse eid="JER 17:19"/><verse number="20" style="v" sid="JER 17:20"/>तिनीहरूलाई भन्, ‘हे यहूदाका राजाहरू र यहूदाका सबै मानिसहरू र यी मूलढोकाहरूबाट आउने यरूशलेमका सबै बासिन्दाहरू हो, याहवेहको वचन सुन। <verse eid="JER 17:20"/><verse number="21" style="v" sid="JER 17:21"/>याहवेह यसो भन्‍नुहुन्छ: शब्बाथ दिनमा कुनै भारी नबोक अथवा भारी बोकेर यरूशलेमका मूलढोकाहरू भित्र नल्याओ, यो कुरा होसियारीसाथ पालन गर। <verse eid="JER 17:21"/><verse number="22" style="v" sid="JER 17:22"/>शब्बाथ दिनमा कुनै भारी तिमीहरूका घरबाट बाहिर ननिकाल अथवा शब्बाथ दिनमा कुनै काम नगर; अनि मैले तिमीहरूका पितापुर्खाहरूलाई आज्ञा गरेझैँ शब्बाथ दिनलाई पवित्र राख। <verse eid="JER 17:22"/><verse number="23" style="v" sid="JER 17:23"/>तर तिनीहरूले यो कुरा सुनेनन् अथवा ध्यानै दिएनन्; तिनीहरू हठी थिए र तिनीहरूले न सुन्‍न चाहे न त अनुशासनमा नै ध्यान दिए। <verse eid="JER 17:23"/><verse number="24" style="v" sid="JER 17:24"/>याहवेह भन्‍नुहुन्छ, तर यदि तिमीहरूले मेरा आज्ञाहरू पालन गर्‍यौ भने, र शब्बाथ दिनमा यस सहरका मूलढोकाहरूबाट कुनै भारी ल्याएनौ र कुनै काम नगरी शब्बाथ दिनलाई पवित्र मान्यौ भने, <verse eid="JER 17:24"/><verse number="25" style="v" sid="JER 17:25"/>तब दावीदका सिंहासनमा बस्‍ने राजाहरू, यस सहरका मूलढोकाहरूबाट तिनीहरूका अधिकारीहरूसँग आउनेछन्। राजाहरू र तिनीहरूका अधिकारीहरू घोडाहरू र रथहरूमा सवार भएर यहूदा र यरूशलेमका मानिसहरूसहित आउनेछन्; अनि तिनीहरू यो यरूशलेम सहरमा सधैँका निम्ति बसोबास गर्नेछन्। <verse eid="JER 17:25"/><verse number="26" style="v" sid="JER 17:26"/>मानिसहरू यहूदाका सहरहरूबाट र यरूशलेमका वरिपरिका गाउँहरूबाट, बेन्यामीनका प्रान्तहरू र पश्‍चिमी तराई बेँसीहरूबाट, पहाडी मुलुक र दक्षिणबाट होमबलि र बलिदानहरू, अन्‍नबलिहरू, धूप र धन्यवादका भेटीहरू लिएर याहवेहको भवनमा आउनेछन्। <verse eid="JER 17:26"/><verse number="27" style="v" sid="JER 17:27"/>तर यदि तिमीहरू शब्बाथ दिनमा यरूशलेमका मूलढोकाहरूभित्र आउँदा, भारी बोक्यौ र शब्बाथ दिनलाई पवित्र राख्ने मेरो आज्ञापालन गरेनौ भने म यरूशलेमका मूलढोकाहरूमा निभाउन नसकिने आगो सल्काइदिनेछु, त्यस आगोले त्यसका किल्‍लाहरू भस्म पारिदिनेछ।’ ”<verse eid="JER 17:27"/></para>
  <chapter eid="JER 17"/>
  <chapter number="18" style="c" sid="JER 18"/>
  <para style="s1">कुमालेको घरमा</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 18:1"/>यर्मियाकहाँ आएको याहवेहको वचन यही हो: <verse eid="JER 18:1"/><verse number="2" style="v" sid="JER 18:2"/>“तल कुमालेको घरमा जा, र त्यहाँ म तँलाई मेरो सन्देश दिनेछु।” <verse eid="JER 18:2"/><verse number="3" style="v" sid="JER 18:3"/>यसकारण म कुमालेको घरमा गएँ; अनि मैले उसलाई आफ्नो चक्‍कामा काम गरिरहेको देखेँ। <verse eid="JER 18:3"/><verse number="4" style="v" sid="JER 18:4"/>तर उसले बनाइरहेको भाँडा, उसको हातमा बिग्रियो; यसकारण त्यस कुमालेले त्यसबाट आफूलाई मन लागेअनुसार फेरि त्यस्तै अर्को भाँडा बनायो।<verse eid="JER 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 18:5"/>तब याहवेहको वचन मकहाँ आयो। <verse eid="JER 18:5"/><verse number="6" style="v" sid="JER 18:6"/>उहाँले भन्‍नुभयो, “हे इस्राएलको घराना, यस कुमालेले माटोलाई गरेझैँ के म तँलाई गर्न सक्दिनँ र?” याहवेह घोषणा गर्नुहुन्छ। “सुन्, कुमालेको हातमा भएको माटोझैँ तँ इस्राएल पनि मेरो हातमा छस्; मलाई जे गर्न मन लाग्छ, तँसँग त्यस्तै गर्न सक्छु। <verse eid="JER 18:6"/><verse number="7" style="v" sid="JER 18:7"/>यदि कुनै समयमा मैले कुनै राष्ट्र अथवा राज्यलाई उखेलिदिन्छु; पतन र नाश गरिदिन्छु भनी घोषणा गरुँला, <verse eid="JER 18:7"/><verse number="8" style="v" sid="JER 18:8"/>तर यदि मैले चेतावनी दिएको त्यो राष्ट्रले आफ्नो दुष्‍ट कामबाट पश्‍चात्ताप गर्‍यो भने म मेरो मन बदल्नेछु र मैले त्यसमाथि विचार गरेको विपत्ति ल्याउनेछैनँ। <verse eid="JER 18:8"/><verse number="9" style="v" sid="JER 18:9"/>अनि अर्को समयमा कुनै राष्ट्र अथवा राज्यलाई पुनर्निर्माण र पुनर्स्थापित हुनेछ भनेर मैले घोषणा गरुँला, <verse eid="JER 18:9"/><verse number="10" style="v" sid="JER 18:10"/>तर यदि त्यस राष्ट्रले मेरो दृष्‍टिमा दुष्‍टता गर्छ र मेरो आज्ञापालन गर्दैन भने, तब मैले त्यसका निम्ति भलाइ गर्न चाहेको योजनामा म पुनर्विचार गर्नेछु।<verse eid="JER 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 18:11"/>“यसकारण अब यहूदाका मानिसहरू र यरूशलेममा बसोबास गर्ने मानिसहरूलाई भन्, ‘याहवेह यसो भन्‍नुहुन्छ: हेर! म तिमीहरूका निम्ति विपत्ति तयार गरिरहेछु, र तिमीहरूका विरुद्धमा योजना बनाउँदैछु। यसकारण तिमीहरू हरेक आफ्नो दुष्‍ट कामबाट फर्क; अनि तिमीहरूका चालहरू र तिमीहरूका कामहरू सुधार।’ <verse eid="JER 18:11"/><verse number="12" style="v" sid="JER 18:12"/>तर तिनीहरूले जवाफ दिनेछन्, ‘हामीलाई कुनै फाइदा छैन। हामी हाम्रा आफ्नै युक्तिमा लागिरहनेछौँ; हामी सबै आफ्नै हृदयको हठीपनाको पछि लागिरहनेछौ।’ ”<verse eid="JER 18:12"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="13" style="v" sid="JER 18:13"/>यसकारण याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="JER 18:13">“राष्ट्र-राष्ट्रहरूकहाँ गएर सोधपुछ गर:</para>
  <para style="q2" vid="JER 18:13">कसैले यस्तो कुरा कुनै दिन सुनेको छ?</para>
  <para style="q1" vid="JER 18:13">कुमारी इस्राएलले</para>
  <para style="q2" vid="JER 18:13">अति घृणित वा डरलाग्दो काम गरेकी छे।<verse eid="JER 18:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 18:14"/>के लेबनानको चट्टानी भिरमा</para>
  <para style="q2" vid="JER 18:14">कहिल्यै हिउँ बिलाउँछ र?</para>
  <para style="q1" vid="JER 18:14">के टाढाको मुहानबाट आएको चट्टानको चिसो पानी</para>
  <para style="q2" vid="JER 18:14">कहिल्यै बग्न छोड्छ र?<verse eid="JER 18:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 18:15"/>तर मेरा मानिसहरूले मलाई बिर्सेका छन्;</para>
  <para style="q2" vid="JER 18:15">तिनीहरू काम नलाग्ने मूर्तिहरूलाई धूप बाल्छन्,</para>
  <para style="q1" vid="JER 18:15">जसले तिनीहरूलाई तिनीहरूका मार्गहरूमा</para>
  <para style="q2" vid="JER 18:15">र तिनीहरूका पुराना मार्गहरूमा ठेस लाग्ने तुल्याएका छन्।</para>
  <para style="q1" vid="JER 18:15">ती मूर्तिहरूले मानिसहरूलाई अप्ठ्यारा गोरेटोहरूमा</para>
  <para style="q2" vid="JER 18:15">र नबनाइएका बाटोहरूमा हिँडाएका छन्।<verse eid="JER 18:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 18:16"/>तिनीहरूको देश उजाड पारिनेछ,</para>
  <para style="q2" vid="JER 18:16">र त्यो सदासर्वदा हाँसोको पात्र बन्‍नेछ;</para>
  <para style="q1" vid="JER 18:16">त्यसबाट भएर हिँड्ने सबै तर्सनेछन्,</para>
  <para style="q2" vid="JER 18:16">र तिनीहरूले आफ्ना टाउको हल्‍लाउनेछन्।<verse eid="JER 18:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 18:17"/>पूर्वबाट आएको बतासझैँ,</para>
  <para style="q2" vid="JER 18:17">म तिनीहरूलाई तिनीहरूका शत्रुहरूबीच छरपस्ट पारिदिनेछु;</para>
  <para style="q1" vid="JER 18:17">तिनीहरूका विपत्तिका दिनहरूमा</para>
  <para style="q2" vid="JER 18:17">म तिनीहरूतिर आफ्नो अनुहार होइन, तर आफ्नो पिठिउँ फर्काइदिनेछु।”<verse eid="JER 18:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 18:18"/>तिनीहरूले भने; “आओ, हामी यर्मियाको विरुद्धमा योजना बनाऔँ; किनकि न पुजारीद्वारा सिकाइने व्यवस्था न त बुद्धिमान्‌को सल्‍लाह, न त अगमवक्ताहरूबाट आउने वचनको नै अभाव हुनेछ। यसैले आओ हामी त्यसको विरुद्धमा युक्ति रचौँ, र त्यसले भनेको कुनै पनि कुरामा ध्यान नदिऔँ।”<verse eid="JER 18:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 18:19"/>हे याहवेह, मेरा कुरामा ध्यान दिनुहोस्;</para>
  <para style="q2" vid="JER 18:19">मेरा शत्रुहरूले के भनिरहेका छन्, सो कुरा सुन्‍नुहोस्!<verse eid="JER 18:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 18:20"/>के भलाइको सट्टा खराबी गरिन्छ?</para>
  <para style="q2" vid="JER 18:20">तर तिनीहरूले त मेरो निम्ति एउटा खाडल खनेका छन्।</para>
  <para style="q1" vid="JER 18:20">म तपाईंको सामु उभिएर,</para>
  <para style="q2" vid="JER 18:20">तिनीहरूबाट तपाईंको क्रोध हटाउनलाई</para>
  <para style="q2" vid="JER 18:20">तिनीहरूको पक्षमा मैले तपाईंको सामु बिन्ती गरेको कुरा स्मरण गर्नुहोस्।<verse eid="JER 18:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 18:21"/>यसकारण तिनीहरूका छोराछोरीहरूलाई अनिकालमा सुम्पिदिनुहोस्;</para>
  <para style="q2" vid="JER 18:21">तिनीहरूलाई तरवारको शक्तिमा सुम्पिदिनुहोस्।</para>
  <para style="q1" vid="JER 18:21">तिनीहरूका पत्नीहरू निःसन्तान र विधवा होऊन्;</para>
  <para style="q2" vid="JER 18:21">तिनीहरूका मानिसहरू लडाइँमा मारिऊन्;</para>
  <para style="q2" vid="JER 18:21">तिनीहरूका जवान मानिसहरू लडाइँमा तरवारद्वारा मारिऊन्।<verse eid="JER 18:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 18:22"/>जब तपाईंले तिनीहरूको विरुद्धमा अचानक आक्रमण गर्नेहरू ल्याउनुहुन्छ,</para>
  <para style="q2" vid="JER 18:22">तिनीहरूका घरहरूबाट चीत्कारको सोर सुनियोस्;</para>
  <para style="q1" vid="JER 18:22">किनकि तिनीहरूले मलाई फसाउन एउटा खाडल खनेका छन्;</para>
  <para style="q2" vid="JER 18:22">अनि मेरा खुट्टाहरूका निम्ति पासो थापेका छन्।<verse eid="JER 18:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 18:23"/>तर हे याहवेह,</para>
  <para style="q2" vid="JER 18:23">मलाई मार्ने तिनीहरूका सबै षड्यन्त्रहरू तपाईंलाई थाहा छ।</para>
  <para style="q1" vid="JER 18:23">तिनीहरूका अपराधहरू क्षमा नगर्नुहोस्,</para>
  <para style="q2" vid="JER 18:23">अथवा तपाईंको दृष्‍टिबाट तिनीहरूका पापहरू नमेटाउनुहोस्।</para>
  <para style="q1" vid="JER 18:23">तिनीहरू तपाईंको सामु परास्त होऊन्;</para>
  <para style="q2" vid="JER 18:23">तपाईंको क्रोधमा तिनीहरूसित उचित व्यवहार गर्नुहोस्।<verse eid="JER 18:23"/></para>
  <chapter eid="JER 18"/>
  <chapter number="19" style="c" sid="JER 19"/>
  <para style="p">
    <verse number="1" style="v" sid="JER 19:1"/>याहवेह यसो भन्‍नुहुन्छ: “तँ कुमालेकहाँ गएर माटोको एउटा भाँडो किन्। त्यसपछि मानिसहरूका पुजारीहरू र केही अगुवाहरू आफूसँग लिएर, <verse eid="JER 19:1"/><verse number="2" style="v" sid="JER 19:2"/>खपटाका मूलढोकाको नजिक भएको बेन-हिन्‍नोमको बेँसीमा जा। अनि मैले तँलाई भनेका वचनहरू त्यहाँ घोषणा गर्; <verse eid="JER 19:2"/><verse number="3" style="v" sid="JER 19:3"/>अनि यसो भन्, ‘हे यहूदाका राजाहरू र यरूशलेमका मानिसहरू हो, याहवेहको वचन सुन। सेनाहरूका याहवेह, इस्राएलका परमेश्‍वर यसो भन्‍नुहुन्छ: सुन! म यस ठाउँमा विपत्ति ल्याउनेछु, जसको बारेमा सुन्‍ने हरेकको कान झनझनाउनेछ। <verse eid="JER 19:3"/><verse number="4" style="v" sid="JER 19:4"/>किनकि तिनीहरूले मलाई त्यागेका छन् र यो ठाउँलाई विदेशी देवताहरूको ठाउँ बनाएका छन्; तिनीहरूले यस ठाउँमा देवताहरूलाई धूप बालेका छन्, जसलाई न तिनीहरूले, न तिनीहरूका पितापुर्खाहरूले, न त यहूदाका राजाहरूले कहिल्यै चिनेका थिए; अनि तिनीहरूले यस ठाउँलाई निर्दोष मानिसहरूका रगतले भरिदिएका छन्। <verse eid="JER 19:4"/><verse number="5" style="v" sid="JER 19:5"/>तिनीहरूले आफ्ना छोराछोरीहरू बाल-देवताको आगोमा बलिदान चढाउनलाई देवस्थानहरूमा बाल देवताका थानहरू बनाएका छन्, जुन कुरा मैले कहिल्यै आज्ञा दिएको थिइनँ, अथवा बताएको थिइनँ, न त यो कुरा कहिल्यै मेरो मनमै आएको थियो।’ <verse eid="JER 19:5"/><verse number="6" style="v" sid="JER 19:6"/>यसकारण होसियार रहो, याहवेह भन्‍नुहुन्छ, यस्ता दिनहरू आउँदैछन्, जब मानिसहरूले यस ठाउँलाई फेरि तोपेत अथवा बेन-हिन्‍नोमको बेँसी भन्‍नेछैनन्, तर हत्याको बेँसी भन्‍नेछन्।<verse eid="JER 19:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 19:7"/>“ ‘यस ठाउँमा म यहूदा र यरूशलेमका युक्तिहरू विफल पारिदिनेछु। म तिनीहरूलाई मार्न चाहने तिनीहरूका शत्रुहरूको तरवारको सामु राखिदिनेछु; अनि म तिनीहरूका मृत शरीरलाई आकाशका चराहरू र जमिनका पशुहरूको आहाराको निम्ति दिनेछु। <verse eid="JER 19:7"/><verse number="8" style="v" sid="JER 19:8"/>म यस सहरलाई ध्वस्त पार्नेछु र खिसीको पात्र बनाइदिनेछु; त्यसका सबै चोटहरूको कारण त्यसबाट भएर जाने सबै तर्सनेछन् र त्यसलाई गिल्‍ला गर्नेछन्। <verse eid="JER 19:8"/><verse number="9" style="v" sid="JER 19:9"/>म तिनीहरूलाई आफ्ना छोराछोरीहरूको मासु खान लाउनेछु; अनि तिनीहरूले एक-अर्काको मासु समेत खानेछन्; किनभने तिनीहरूका शत्रुहरूले तिनीहरूलाई नाश गर्नलाई घेरा हालेर धेरै कष्‍ट दिनेछन्।’<verse eid="JER 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 19:10"/>“त्यसपछि तँसित जाने मानिसहरूका सामु त्यो भाँडो फुटाइदिनू; <verse eid="JER 19:10"/><verse number="11" style="v" sid="JER 19:11"/>अनि तिनीहरूलाई भन्, ‘सेनाहरूका याहवेह यसो भन्‍नुहुन्छ: जसरी कुमालेले यस भाँडोलाई फुटाएपछि यो फेरि जोडिन सक्दैन, त्यसरी नै म यस जाति र यरूशलेम सहरलाई फेरि नजोडिने गरी टुक्रा-टुक्रा पारिदिनेछु। तिनीहरूले तोपेतमा कुनै ठाउँ नै नरहने गरी लासलाई गाड्नेछन्। <verse eid="JER 19:11"/><verse number="12" style="v" sid="JER 19:12"/>म यरूशलेम र यहाँ बस्‍ने मानिसहरूलाई यस्तै गर्नेछु, याहवेह घोषणा गर्नुहुन्छ। यस सहरलाई म तोपेतजस्तै बनाउनेछु। <verse eid="JER 19:12"/><verse number="13" style="v" sid="JER 19:13"/>यरूशलेमका घरहरू र यहूदाका राजाहरूका घरहरू तोपेतझैँ अशुद्ध पारिनेछन्, अर्थात् ती सबै घरहरू, जसमा तिनीहरूले आकाशका सारा तारामण्डलका निम्ति छानामा धूप बाले, र अरू आकाशको देवताहरूका निम्ति अर्घबलिहरू चढाए।’ ”<verse eid="JER 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 19:14"/>त्यसपछि यर्मिया तोपेतबाट फर्के, जहाँ तिनलाई याहवेहले अगमवाणी भन्‍न पठाउनुभएको थियो; अनि याहवेहको मन्दिरको चोकमा उभिए र सबै मानिसहरूलाई भने, <verse eid="JER 19:14"/><verse number="15" style="v" sid="JER 19:15"/>“सेनाहरूका याहवेह, इस्राएलका परमेश्‍वर यसो भन्‍नुहुन्छ: ‘सुन! म यो सहर र यसका चारैतिरका गाउँहरूमा मैले तिनीहरूको विरुद्धमा घोषणा गरेको हरेक विपत्ति ल्याउन लागेको छु; किनकि तिनीहरू ढीट भएका छन् र मेरो वचन पालन गरेका छैनन्।’ ”<verse eid="JER 19:15"/></para>
  <chapter eid="JER 19"/>
  <chapter number="20" style="c" sid="JER 20"/>
  <para style="s1">यर्मिया र पशहूर</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 20:1"/>जब इम्मेरका छोरा पुजारी पशहूर याहवेहको भवनका मुख्य अधिकारी थिए, तब यर्मियाले यी कुराहरू अगमवाणी गरिरहेका सुने; <verse eid="JER 20:1"/><verse number="2" style="v" sid="JER 20:2"/>तिनले अगमवक्ता यर्मियालाई पिटे र ठिँगुरोमा हालेर याहवेहको मन्दिरमा बेन्यामीनको माथिल्‍लो मूलढोकामा राख्न लगाए। <verse eid="JER 20:2"/><verse number="3" style="v" sid="JER 20:3"/>भोलिपल्ट बिहान, जब पशहूरले तिनलाई ठिँगुरोबाट निकाले, तब यर्मियाले तिनलाई भने, “याहवेहले तिम्रो नाम पशहूर होइन, तर मागोर-मिसाबीब<note caller="+" style="f"><char style="fr" closed="false">20:3 </char><char style="ft" closed="false">मूल भाषामा यसको अर्थ </char><char style="fqa" closed="false">चारैतिर आतङ्क</char></note> राख्नुभएको छ। <verse eid="JER 20:3"/><verse number="4" style="v" sid="JER 20:4"/>किनकि याहवेह यसो भन्‍नुहुन्छ: ‘म तँलाई तेरै निम्ति र तेरा सबै साथीहरूका निम्ति त्रसित तुल्याउनेछु। तेरा आफ्नै आँखाले तिनीहरूलाई तिनीहरूका शत्रुहरूका तरवारले मारेको देख्नेछस्। म समस्त यहूदालाई बेबिलोनको राजाको हातमा सुम्पिदिनेछु, जसले तिनीहरूलाई बेबिलोनमा लैजानेछन् र तरवारले मार्नेछन्। <verse eid="JER 20:4"/><verse number="5" style="v" sid="JER 20:5"/>म यरूशलेम सहरको सबै धनसम्पत्ति तिनीहरूका शत्रुहरूका हातमा सुम्पिदिनेछु, अर्थात् यस सहरका सबै फसल, सहरका सबै बहुमूल्य चीजहरू र यहूदाका राजाहरूका सबै भण्डारहरू शत्रुहरूलाई सुम्पिदिनेछु। तिनीहरूले सबै कुराहरूलाई लुटका मालसामानहरूजस्तै बेबिलोनमा लिएर जानेछन्। <verse eid="JER 20:5"/><verse number="6" style="v" sid="JER 20:6"/>अनि हे पशहूर, तँ र तेरो घरमा बस्‍ने सबै परिवारचाहिँ देशबाट निकालिएर बेबिलोनको कैदमा जानेछौ। तँ र तेरा सबै साथीहरू मर्नेछौ र त्यहीँ गाडिनेछौ, जसलाई तैँले झूटो अगमवाणी गरेको थिइस्।’ ”<verse eid="JER 20:6"/></para>
  <para style="s1">यर्मियाको गुनासो</para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 20:7"/>हे याहवेह, तपाईंले मलाई धोका दिनुभयो, र म धोकामा परेँ;</para>
  <para style="q2" vid="JER 20:7">तपाईंले मलाई जित्नुभयो, किनकि तपाईं मभन्दा बलियो हुनुहुन्छ।</para>
  <para style="q1" vid="JER 20:7">दिनभरि नै म हाँसोको पात्र बनेको छु;</para>
  <para style="q2" vid="JER 20:7">सबैले मलाई गिल्‍ला गर्छन्।<verse eid="JER 20:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 20:8"/>जब-जब म बोल्छु,</para>
  <para style="q2" vid="JER 20:8">तब-तब हिंसा र विनाश हुनेछ भनी घोषणा गर्दै चिच्याउँछु।</para>
  <para style="q1" vid="JER 20:8">यसकारण दिनभरि नै याहवेहको वचनले</para>
  <para style="q2" vid="JER 20:8">मेरा निम्ति अपमान ल्याएको छ।<verse eid="JER 20:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 20:9"/>तर यदि मैले, “म उहाँको वचन भन्दिनँ</para>
  <para style="q2" vid="JER 20:9">अथवा उहाँको नाममा अबदेखि बोल्दिनँ” भनी भन्छु भने,</para>
  <para style="q1" vid="JER 20:9">उहाँको वचन मेरो हृदयमा आगोजस्तै,</para>
  <para style="q2" vid="JER 20:9">अथवा मेरा हड्डीहरूभित्र बन्द गरेको आगोजस्तै हुन्छ।</para>
  <para style="q1" vid="JER 20:9">मैले वचनलाई भित्र रोकिराखेको कारण थकित भएको छु;</para>
  <para style="q2" vid="JER 20:9">वास्तवमा म यो थाम्नै सक्दिनँ।<verse eid="JER 20:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 20:10"/>धेरैले कानेखुसी गरेको म सुन्दछु,</para>
  <para style="q2" vid="JER 20:10">“त्रास चारैतिर छ!</para>
  <para style="q2" vid="JER 20:10">त्यसको निन्दा गरौँ! त्यसको विरुद्धमा खबर गरौँ!”</para>
  <para style="q1" vid="JER 20:10">मेरा सबै मित्रहरू</para>
  <para style="q2" vid="JER 20:10">यसो भन्दै मेरो पतन पर्खिरहेका छन्,</para>
  <para style="q1" vid="JER 20:10">“सायद त्यसले धोका खानेछ;</para>
  <para style="q2" vid="JER 20:10">तब हामी ऊमाथि विजयी हुनेछौँ,</para>
  <para style="q2" vid="JER 20:10">र हामी त्यसमाथि आफ्नो बदला लिनेछौँ।”<verse eid="JER 20:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="JER 20:11"/>तर याहवेह मसँग एक शक्तिशाली योद्धाझैँ हुनुहुन्छ;</para>
  <para style="q2" vid="JER 20:11">यसकारण मलाई सताउनेहरूले ठेस खाएर लड्नेछन्।</para>
  <para style="q1" vid="JER 20:11">तिनीहरू असफल हुनेछन् र अति लाजमा पर्नेछन्;</para>
  <para style="q2" vid="JER 20:11">तिनीहरूका अपमान कहिल्यै पनि बिर्सिइनेछैन।<verse eid="JER 20:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 20:12"/>हे सेनाहरूका याहवेह, तपाईं धर्मी जनहरूलाई जाँच्नुहुन्छ;</para>
  <para style="q2" vid="JER 20:12">अनि हृदय र अन्तस्करण जान्‍नुहुन्छ,</para>
  <para style="q1" vid="JER 20:12">तपाईंले तिनीहरूमाथि लिनुहुने बदला हेर्न पाऊँ;</para>
  <para style="q2" vid="JER 20:12">किनकि मैले मेरो मुद्दा तपाईंलाई सुम्पिदिएको छु।<verse eid="JER 20:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JER 20:13"/>याहवेहको स्तुति गाओ!</para>
  <para style="q2" vid="JER 20:13">याहवेहको प्रशंसा गर!</para>
  <para style="q1" vid="JER 20:13">उहाँले गरिब मानिसहरूका प्राणलाई</para>
  <para style="q2" vid="JER 20:13">दुष्‍टहरूका हातबाट छुटाउनुभएको छ।<verse eid="JER 20:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="JER 20:14"/>म जन्मेको दिन श्रापित होस्!</para>
  <para style="q2" vid="JER 20:14">मेरी आमाले मलाई जन्म दिनुभएको दिन आशिषित नहोस्!<verse eid="JER 20:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 20:15"/>त्यो मानिस श्रापित होस्, जसले मेरो बुबाकहाँ यो खबर ल्यायो,</para>
  <para style="q2" vid="JER 20:15">जसले तिनलाई “तपाईंको एउटा बालक, अर्थात् छोरा जन्मेको छ!”</para>
  <para style="q2" vid="JER 20:15">भन्‍ने खबरले अति खुशी तुल्यायो।<verse eid="JER 20:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 20:16"/>त्यो मानिस याहवेहले दया नगरी</para>
  <para style="q2" vid="JER 20:16">नष्‍ट गरिदिनुभएका ती सहरहरूजस्तै होस्।</para>
  <para style="q1" vid="JER 20:16">त्यस मानिसले बिहान विलाप</para>
  <para style="q2" vid="JER 20:16">र दिउँसो लडाइँको सोर सुनोस्।<verse eid="JER 20:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 20:17"/>किनकि त्यसले मलाई गर्भमा छँदै मारेन,</para>
  <para style="q2" vid="JER 20:17">नत्रता मेरी आमाको गर्भ नै मेरो चिहान हुनेथियो;</para>
  <para style="q2" vid="JER 20:17">अनि म सधैँका निम्ति उहाँकै कोखमा रहने थिएँ।<verse eid="JER 20:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 20:18"/>सङ्कष्‍ट र दुःख देख्न</para>
  <para style="q2" vid="JER 20:18">र अन्त्यमा शर्ममा परेर मर्नलाई</para>
  <para style="q2" vid="JER 20:18">म किन गर्भबाट बाहिर आएँ?<verse eid="JER 20:18"/></para>
  <chapter eid="JER 20"/>
  <chapter number="21" style="c" sid="JER 21"/>
  <para style="s1">परमेश्‍वरले सिदकियाहको बिन्ती अस्वीकार गर्नुभएको</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 21:1"/>याहवेहको यो वचन यर्मियाकहाँ त्यस बेला आयो, जब राजा सिदकियाहले मल्कियाहका छोरा पशहूर र मासेयाहका छोरा पुजारी सपन्याहलाई यर्मियाकहाँ पठाएका थिए। तिनीहरूले भने: <verse eid="JER 21:1"/><verse number="2" style="v" sid="JER 21:2"/>“बेबिलोनका राजा नबूकदनेसर हामीलाई आक्रमण गर्न आउँदैछन्; त्यसैले याहवेहसँग हाम्रा निम्ति सोधखोज गरिदिनुहोस्। सायद याहवेहले बितेका समयमा गरेझैँ, हाम्रा निम्ति अद्‌भुत कार्यहरू गर्नुहुनेछ, र नबूकदनेसर हामीबाट फिर्ता जानेछन्।”<verse eid="JER 21:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 21:3"/>तर यर्मियाले तिनीहरूलाई जवाफ दिए, “सिदकियाहलाई भन, <verse eid="JER 21:3"/><verse number="4" style="v" sid="JER 21:4"/>‘याहवेह इस्राएलका परमेश्‍वर यसो भन्‍नुहुन्छ: तिमीहरूका हातमा जुन हतियारहरू छन्, जसद्वारा पर्खालबाहिर तिमीहरूलाई घेरा हाल्ने बेबिलोनको राजा र बेबिलोनीहरूको विरुद्धमा तिमीहरू लडाइँ लड्छौ, ती हतियारहरूलाई तिमीहरूकै विरुद्धमा म फर्काउन लागेको छु। अब म तिनीहरूलाई यस सहरभित्र भेला गराउनेछु। <verse eid="JER 21:4"/><verse number="5" style="v" sid="JER 21:5"/>मेरो आफ्नै पसारिएको हात र शक्तिशाली पाखुराले भयानक रिस र प्रचण्ड क्रोधमा तिमीहरूको विरुद्धमा लडाइँ गर्नेछु। <verse eid="JER 21:5"/><verse number="6" style="v" sid="JER 21:6"/>म यस सहरमा बस्‍नेहरू: के मानिसहरू, के पशुहरू दुवैलाई प्रहार गर्नेछु; अनि तिनीहरू भयानक रूढीले मर्नेछन्। <verse eid="JER 21:6"/><verse number="7" style="v" sid="JER 21:7"/>त्यसपछि याहवेह घोषणा गर्नुहुन्छ, यहूदाका राजा सिदकियाह, त्यसका अधिकारीहरू र यस सहरका सबै मानिसहरू, जो विपत्ति, तरवार र अनिकालबाट बाँच्नेछन्, म तिनीहरूलाई बेबिलोनका राजा नबूकदनेसर र तिनीहरूका शत्रुहरूकहाँ सुम्पिदिनेछु। शत्रुहरूले तिनीहरूलाई तरवारले मार्नेछन्। यी मानिसहरूले तिनीहरूलाई कुनै दया, माया र करुणा देखाउनेछैनन्।’<verse eid="JER 21:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 21:8"/>“यी मानिसहरूलाई अझै भन्, ‘याहवेह यसो भन्‍नुहुन्छ: हेर, म तिमीहरूका निम्ति जीवनको बाटो र मृत्युको बाटो राख्दैछु। <verse eid="JER 21:8"/><verse number="9" style="v" sid="JER 21:9"/>यस सहरमा बस्‍ने सबै तरवार, अनिकाल र विपत्तिद्वारा मर्नेछन्। तर यस सहरबाट बाहिर निस्कने र तिमीहरूलाई घेरेर बसिरहेका बेबिलोनीहरूकहाँ आत्मसमर्पण गर्ने सबै बाँच्नेछन्। तिनीहरू आफ्नो ज्यान जोगाएर भाग्न सक्छन्। <verse eid="JER 21:9"/><verse number="10" style="v" sid="JER 21:10"/>मैले यस सहरलाई भलाइ होइन, तर हानि गर्ने निर्णय गरेको छु, याहवेह घोषणा गर्नुहुन्छ। यस सहरलाई बेबिलोनका राजा नबूकदनेसरको हातमा सुम्पिदिनेछु; अनि त्यसले यसलाई आगोले भस्म गर्नेछ।’<verse eid="JER 21:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 21:11"/>“यसबाहेक यहूदाको राजकीय घरानालाई यसो भन्, ‘याहवेहको वचन सुन! <verse eid="JER 21:11"/><verse number="12" style="v" sid="JER 21:12"/>हे दावीदका घराना, याहवेह तिमीहरूलाई यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="JER 21:12">“ ‘हरेक बिहान न्याय कायम गर;</para>
  <para style="q2" vid="JER 21:12">जो लुटिएको छ,</para>
  <para style="q2" vid="JER 21:12">त्यसलाई अत्याचारीहरूको हातबाट मुक्त गर्,</para>
  <para style="q1" vid="JER 21:12">नत्रता तैँले गरेको दुष्‍ट कामको कारण</para>
  <para style="q2" vid="JER 21:12">मेरो क्रोध आगोजस्तै दन्किनेछ;</para>
  <para style="q2" vid="JER 21:12">अनि त्यसलाई निभाउने कोही पनि हुनेछैन।<verse eid="JER 21:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 21:13"/>हे यरूशलेम, म तेरो विरुद्धमा छु;</para>
  <para style="q2" vid="JER 21:13">तँ, जो यस बेँसीको उच्‍च</para>
  <para style="q2" vid="JER 21:13">चट्टानमा बस्छस्, याहवेह घोषणा गर्नुहुन्छ,</para>
  <para style="q1" vid="JER 21:13">तँ भन्छस् कि, “तेरो विरुद्धमा को आउनसक्छ र?</para>
  <para style="q2" vid="JER 21:13">हाम्रो शरणस्थानमा को प्रवेश गर्न सक्छ?”<verse eid="JER 21:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 21:14"/>म तिमीहरूका कामहरूको फलअनुसार तिमीहरूलाई दण्ड दिनेछु,</para>
  <para style="q2" vid="JER 21:14">याहवेह घोषणा गर्नुहुन्छ।</para>
  <para style="q1" vid="JER 21:14">म तिमीहरूका जङ्गलहरूमा आगो लगाइदिनेछु,</para>
  <para style="q2" vid="JER 21:14">जसले तिमीहरूका चारैतिरका सबै थोकलाई भस्म पारिदिनेछ।’ ”<verse eid="JER 21:14"/></para>
  <chapter eid="JER 21"/>
  <chapter number="22" style="c" sid="JER 22"/>
  <para style="s1">दुष्‍ट राजाहरू विरुद्ध न्याय</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 22:1"/>याहवेह यसो भन्‍नुहुन्छ: “यहूदाका राजाको महलमा तल जा, र त्यहाँ यो वचन घोषणा गर्: <verse eid="JER 22:1"/><verse number="2" style="v" sid="JER 22:2"/>‘हे यहूदाका राजा, याहवेहको वचन सुन्, तँ दावीदको सिंहासनमा विराजमान हुने राजा, तँ, तेरा अधिकारीहरू र यी मूलढोकाहरूबाट आउने यरूशलेमका सबै मानिसहरूले सुन्। <verse eid="JER 22:2"/><verse number="3" style="v" sid="JER 22:3"/>याहवेह यसो भन्‍नुहुन्छ: जे न्यायसङ्गत र उचित छ, त्यही गर। जो लुटिएको छ, त्यसलाई अत्याचारीहरूको हातबाट मुक्त गर। विदेशी, टुहुरा-टुहुरी, विधवामाथि कुनै हानि अथवा अन्याय र अत्याचार नगर; अनि यस ठाउँमा निर्दोष मानिसहरूको रगत नबगाओ। <verse eid="JER 22:3"/><verse number="4" style="v" sid="JER 22:4"/>किनकि यदि तिमीहरूले यी आज्ञाहरू होसियारीसाथ पालन गर्‍यौ भने दावीदको सिंहासनमा बस्‍ने राजाहरू, रथहरू र घोडाहरूमा सवार भएर तिनीहरूका अधिकारीहरू र तिनीहरूका प्रजाहरूका साथमा यस राजमहलका मूलढोकाहरूबाट प्रवेश गर्नेछन्। <verse eid="JER 22:4"/><verse number="5" style="v" sid="JER 22:5"/>तर यदि तिमीहरूले यी आज्ञाहरू पालन गरेनौ भने याहवेह घोषणा गर्नुहुन्छ, म आफ्नै शपथ खाएर भन्छु, यो महल ध्वस्त हुनेछ।’ ”<verse eid="JER 22:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 22:6"/>किनकि यहूदाको राजमहलको बारेमा याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="JER 22:6">“तँ मेरा निम्ति गिलादझैँ</para>
  <para style="q2" vid="JER 22:6">र लेबनानको टाकुराझैँ भए तापनि</para>
  <para style="q1" vid="JER 22:6">निश्‍चय नै म तँलाई बसोबास नभएको निर्जन</para>
  <para style="q2" vid="JER 22:6">सहरहरूजस्तै उजाड पार्नेछु।<verse eid="JER 22:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 22:7"/>म तेरो विरुद्धमा विनाशकर्ताहरू पठाउनेछु,</para>
  <para style="q2" vid="JER 22:7">हरेकले आ-आफ्नो हतियार लिएर आउनेछन्;</para>
  <para style="q1" vid="JER 22:7">अनि तिनीहरूले तेरा असल देवदारुका काठका बीमहरू काट्नेछन्</para>
  <para style="q2" vid="JER 22:7">र तिनीहरूलाई आगोमा फ्याँकिदिनेछन्।<verse eid="JER 22:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 22:8"/>“धेरै देशका मानिसहरू यस सहरबाट जानेछन् र आपसमा सोध्नेछन्, ‘यस महान् सहरलाई याहवेहले किन यस्तो डरलाग्दो व्यवहार गर्नुभएको होला?’ <verse eid="JER 22:8"/><verse number="9" style="v" sid="JER 22:9"/>अनि जवाफ यस्तो हुनेछ: ‘किनकि तिनीहरूले याहवेह, तिनीहरूका परमेश्‍वरको करार त्यागेका छन्, र तिनीहरूले अरू देवताहरूलाई मानेका छन् र सेवा गरेका छन्।’ ”<verse eid="JER 22:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 22:10"/>मरिगएको राजाको निम्ति अथवा गइसकेका निम्ति शोक नगर;</para>
  <para style="q2" vid="JER 22:10">बरु निर्वासनमा लगिएकाहरूका निम्ति विलाप गर;</para>
  <para style="q1" vid="JER 22:10">किनकि त्यो फेरि फर्केर कहिल्यै आउनेछैन,</para>
  <para style="q2" vid="JER 22:10">न त त्यसले आफ्नो जन्मभूमि फेरि देख्नेछ।<verse eid="JER 22:10"/></para>
  <para style="m">
    <verse number="11" style="v" sid="JER 22:11"/>किनकि याहवेह यसो भन्‍नुहुन्छ, योशियाहका छोरा शल्‍लूम,<note caller="+" style="f"><char style="fr" closed="false">22:11 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">यहोआहाज</char></note> जो आफ्ना पितापछि यहूदाको राजा भएको थियो, तर ऊ यस ठाउँबाट गइसकेको छ: “त्यो कहिल्यै फर्केर आउनेछैन। <verse eid="JER 22:11"/><verse number="12" style="v" sid="JER 22:12"/>शत्रुहरूले त्यसलाई कैद गरेर लगेकै ठाउँमा त्यो मर्नेछ; त्यसले यस देशलाई फेरि कहिल्यै देख्नेछैन।”<verse eid="JER 22:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 22:13"/>“धिक्‍कार त्यसलाई, जसले अधर्मले आफ्नो महल बनाउँछ,</para>
  <para style="q2" vid="JER 22:13">जसले आफ्ना माथिल्‍ला कोठाहरू अन्यायले बनाउँछ;</para>
  <para style="q1" vid="JER 22:13">आफ्ना देशवासीहरूलाई तिनीहरूका परिश्रमको</para>
  <para style="q2" vid="JER 22:13">ज्याला नदिई सितैँमा काममा लगाउँछ।<verse eid="JER 22:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 22:14"/>त्यसले भन्छ, ‘म आफ्ना निम्ति माथिल्‍लो तलामा</para>
  <para style="q2" vid="JER 22:14">फराकिला कोठाहरू भएको एउटा ठूलो महल बनाउनेछु।’</para>
  <para style="q1" vid="JER 22:14">यसकारण त्यसले त्यस घरमा ठूला झ्यालहरू बनाउँछ,</para>
  <para style="q2" vid="JER 22:14">त्यसमा देवदारुका पल्‍लाहरू लगाउँछ;</para>
  <para style="q2" vid="JER 22:14">अनि त्यसलाई रातो रङ्गले रङ्गाउँछ।<verse eid="JER 22:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="JER 22:15"/>“के धेरै देवदारु बटुलेर महङ्गो घर बनाउँदैमा,</para>
  <para style="q2" vid="JER 22:15">तँ राजा हुन्छस् र?</para>
  <para style="q1" vid="JER 22:15">के तेरा पितासँग खाने र पिउने कुरो थिएन?</para>
  <para style="q2" vid="JER 22:15">जे उचित र न्यायसङ्गत थियो, त्यसले त्यही गर्‍यो।</para>
  <para style="q2" vid="JER 22:15">यसकारण त्यसलाई सबै कुरामा भलाइ नै भयो।<verse eid="JER 22:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 22:16"/>त्यसले गरिब र खाँचोमा परेकाहरूको पक्ष लियो;</para>
  <para style="q2" vid="JER 22:16">अनि त्यसको सबै कुरामा राम्रो भयो।</para>
  <para style="q1" vid="JER 22:16">के मलाई चिन्‍नुको अर्थ त्यही नै होइन र?”</para>
  <para style="q2" vid="JER 22:16">याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 22:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 22:17"/>“तर तेरा आँखा र तेरा हृदय</para>
  <para style="q2" vid="JER 22:17">त बेइमानीसाथ कमाउनेतिर,</para>
  <para style="q1" vid="JER 22:17">निर्दोष मानिसहरूको रगत बहाउनेतिर;</para>
  <para style="q2" vid="JER 22:17">अनि अत्याचार र हिंसातिर लागेका छन्।”<verse eid="JER 22:17"/></para>
  <para style="m">
    <verse number="18" style="v" sid="JER 22:18"/>यसकारण योशियाहका छोरा, यहूदाका राजा यहोयाकीमको बारेमा याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="JER 22:18">“तिनीहरू त्यसका निम्ति शोक गर्नेछैनन्;</para>
  <para style="q2" vid="JER 22:18">‘हाय, मेरा दाजु, हाय, मेरी बहिनी!’ भन्‍नेछैनन्।</para>
  <para style="q1" vid="JER 22:18">तिनीहरू त्यसका निम्ति शोक गर्नेछैनन्:</para>
  <para style="q2" vid="JER 22:18">‘हाय, मेरा मालिक, हाय, उहाँको गौरव!’ भन्‍नेछैनन्।<verse eid="JER 22:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 22:19"/>त्यसको दफन गधाको जस्तै हुनेछ;</para>
  <para style="q2" vid="JER 22:19">त्यसलाई घिस्याउँदै लगेर</para>
  <para style="q2" vid="JER 22:19">यरूशलेमको मूलढोकाको बाहिर फ्याँकिदिनेछन्।”<verse eid="JER 22:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="JER 22:20"/>“उक्लेर लेबनानसम्म जा, र चर्कोगरी करा,</para>
  <para style="q2" vid="JER 22:20">तेरो सोर बाशानसम्मै सुनिओस्;</para>
  <para style="q1" vid="JER 22:20">अबारीमबाट करा,</para>
  <para style="q2" vid="JER 22:20">किनकि तेरा सबै मित्रहरू नष्‍ट भएका छन्।<verse eid="JER 22:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 22:21"/>तैँले आफूलाई सुरक्षित महसुस गर्दा मैले तँलाई चेतावनी दिएँ,</para>
  <para style="q2" vid="JER 22:21">तर तैँले भनिस्, ‘म सुन्‍नेछैनँ!’</para>
  <para style="q1" vid="JER 22:21">यो त तेरो जवानीदेखिकै चाल भएको छ;</para>
  <para style="q2" vid="JER 22:21">तैँले मेरो आज्ञापालन गरेकै छैनस्।<verse eid="JER 22:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 22:22"/>हावाले तेरा सबै गोठालाहरूलाई उडाइदिनेछ;</para>
  <para style="q2" vid="JER 22:22">अनि तेरा मित्रहरू देशबाट कैदमा लगिनेछन्।</para>
  <para style="q1" vid="JER 22:22">तब तेरा सबै दुष्‍ट कामहरूको</para>
  <para style="q2" vid="JER 22:22">कारणले तँ लज्जित र अपमानित हुनेछस्।<verse eid="JER 22:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 22:23"/>हे लेबनानमा बस्‍नेहरू,</para>
  <para style="q2" vid="JER 22:23">तिमीहरू, जो देवदारुका भवनहरू बनाएर बसेका छौ,</para>
  <para style="q1" vid="JER 22:23">तिमीहरूमाथि जब पीडा आइपर्ला, तब तिमीहरू पीडाले चीत्कार गर्नेछौ,</para>
  <para style="q2" vid="JER 22:23">त्यो पीडा सुत्केरीको प्रसव वेदनाजस्तै हुनेछ!”<verse eid="JER 22:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 22:24"/>याहवेह घोषणा गर्नुहुन्छ, “म जीवित भएझैँ, हे यहूदाका राजा यहोयाकीमको छोरा यहोयाकीन,<note caller="+" style="f"><char style="fr" closed="false">22:24 </char><char style="fq" closed="false">यहोयाकीन, </char><char style="ft" closed="false">मूल भाषामा उनको अर्को नाम </char><char style="fqa" closed="false">कोनिया</char></note> तँ यदि मेरा दाहिने हातको छाप-औँठी नै भए तापनि म तँलाई फुकालेर फ्याँकिदिनेछु। <verse eid="JER 22:24"/><verse number="25" style="v" sid="JER 22:25"/>म तँलाई मार्न चाहने मानिसहरू, बेबिलोनको राजा नबूकदनेसर र बेबिलोनीहरूका हातमा तँलाई सुम्पिदिनेछु, जससँग तँ डराउँदछस्। <verse eid="JER 22:25"/><verse number="26" style="v" sid="JER 22:26"/>म तँलाई र तँलाई जन्माउने तेरी आमालाई अर्को देशमा फ्याँकिदिनेछु, जहाँ तिमीहरू कोही पनि जन्मेका थिएनौ; अनि तिमीहरू दुवै आमा छोराछोरीहरू त्यहीँ नै मर्नेछौ। <verse eid="JER 22:26"/><verse number="27" style="v" sid="JER 22:27"/>तिमीहरू जन्मभूमिमा फर्कन इच्छा गर्नेछौ, तर फर्केर यहाँ कहिल्यै आउनेछैनौ।”<verse eid="JER 22:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JER 22:28"/>के यो मानिस यहोयाकीन तुच्छ ठानिएको</para>
  <para style="q2" vid="JER 22:28">एउटा घृणित, फुटेको माटोको भाँडो हो?</para>
  <para style="q1" vid="JER 22:28">त्यो र त्यसका छोराछोरीहरूलाई निकालेर,</para>
  <para style="q2" vid="JER 22:28">तिनीहरूले नजानेको देशमा किन फ्याँकिनेछन्?<verse eid="JER 22:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JER 22:29"/>हे देश, हे देश, हे देश,</para>
  <para style="q2" vid="JER 22:29">याहवेहको वचन सुन्!<verse eid="JER 22:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JER 22:30"/>याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="JER 22:30">“यस मानिसलाई निःसन्तान भनी दर्ता गर्,</para>
  <para style="q2" vid="JER 22:30">यस्तो मानिस, जो जीवनकालभरि सफल हुनेछैन;</para>
  <para style="q1" vid="JER 22:30">किनकि त्यसको कुनै पनि सन्तान सफल हुनेछैन</para>
  <para style="q2" vid="JER 22:30">र कोही पनि दावीदको सिंहासनमा बस्‍नेछैन,</para>
  <para style="q2" vid="JER 22:30">अथवा यहूदामा फेरि कसैले पनि शासन गर्नेछैन।”<verse eid="JER 22:30"/></para>
  <chapter eid="JER 22"/>
  <chapter number="23" style="c" sid="JER 23"/>
  <para style="s1">धर्मी हाँगा</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 23:1"/>“धिक्‍कार ती गोठालाहरूलाई, जसले मेरा खर्कका भेडाहरूलाई नाश गर्दैछन् र छरपस्ट पार्दैछन्!” याहवेह घोषणा गर्नुहुन्छ। <verse eid="JER 23:1"/><verse number="2" style="v" sid="JER 23:2"/>यसकारण याहवेह इस्राएलका परमेश्‍वर आफ्ना भेडाहरूको हेरचाह गर्ने गोठालाहरूलाई यसो भन्‍नुहुन्छ: “तिमीहरूले मेरो बगाललाई छरपस्ट पारेर टाढा धपाइदिएका कारण र तिनीहरूको हेरचाह नगरेको कारण, तिमीहरूले गरेको दुष्‍ट कामका निम्ति म तिमीहरूलाई दण्ड दिनेछु,” याहवेह भन्‍नुहुन्छ। <verse eid="JER 23:2"/><verse number="3" style="v" sid="JER 23:3"/>“मैले तिनीहरूलाई धपाइदिएका सबै देशहरूबाट मेरा बगालका बाँचेकाहरूलाई म आफैँ भेला गर्नेछु र तिनीहरूलाई तिनीहरूकै खर्कमा फर्काएर ल्याउनेछु, जहाँ तिनीहरू फलवन्त हुनेछन् र संख्यामा वृद्धि हुँदै जानेछन्। <verse eid="JER 23:3"/><verse number="4" style="v" sid="JER 23:4"/>म तिनीहरूमाथि गोठालाहरू राखिदिनेछु, जसले तिनीहरूको हेरचाह गर्नेछन्; अनि तिनीहरू फेरि डराउनेछैनन् र त्रसित हुनेछैनन्, न त कोही हराउनेछन्,” याहवेह भन्‍नुहुन्छ।<verse eid="JER 23:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 23:5"/>याहवेह यसो भन्‍नुहुन्छ, “हेर, ती दिनहरू निश्‍चित रूपमा आउँदैछन्,</para>
  <para style="q2" vid="JER 23:5">जब म दावीदको निम्ति<note caller="+" style="f"><char style="fr" closed="false">23:5 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">दावीदको वंशबाट</char></note> एउटा धर्मी हाँगा खडा गर्नेछु;</para>
  <para style="q1" vid="JER 23:5">यस्तो राजा, जसले बुद्धिमान् भएर राज्य गर्नेछ;</para>
  <para style="q2" vid="JER 23:5">अनि देशमा जे न्याय र धार्मिक छ, त्यसले त्यही गर्नेछ।<verse eid="JER 23:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 23:6"/>त्यस राजाको समयमा यहूदा बचाइनेछ,</para>
  <para style="q2" vid="JER 23:6">र इस्राएल सुरक्षासाथ बास गर्नेछ।</para>
  <para style="q1" vid="JER 23:6">त्यो त्यही नाम हो, जसद्वारा उहाँलाई बोलाइनेछ:</para>
  <para style="q2" vid="JER 23:6">याहवेह हाम्रा धार्मिक उद्धारकर्ता।”<verse eid="JER 23:6"/></para>
  <para style="b"/>
  <para style="m">
    <verse number="7" style="v" sid="JER 23:7"/>“यसकारण अब यस्ता दिनहरू आउँदैछन्,” भनी याहवेह भन्‍नुहुन्छ, “अब उसो मानिसहरूले यसो भन्‍नेछैनन्, ‘याहवेह जीवित हुनुभएझैँ, जसले इस्राएलीहरूलाई इजिप्टबाट निकालेर ल्याउनुभयो।’ <verse eid="JER 23:7"/><verse number="8" style="v" sid="JER 23:8"/>तर तिनीहरूले भन्‍नेछन्, ‘याहवेह जीवित हुनुभएझैँ, जसले इस्राएलीहरूलाई उत्तरको देशबाट र उहाँले तिनीहरूलाई निर्वासनमा पठाउनुभएका सबै देशहरूबाट निकालेर ल्याउनुभयो।’ ”<verse eid="JER 23:8"/></para>
  <para style="s1">झूटा अगमवक्ताहरू</para>
  <para style="p">
    <verse number="9" style="v" sid="JER 23:9"/>अगमवक्ताहरूको विषयमा:</para>
  <para style="q1" vid="JER 23:9">मेरो हृदय मभित्रै टुटेको छ;</para>
  <para style="q2" vid="JER 23:9">मेरा सबै हड्डीहरू काप्छन्।</para>
  <para style="q1" vid="JER 23:9">याहवेह र उहाँको</para>
  <para style="q2" vid="JER 23:9">पवित्र वचनको कारणले</para>
  <para style="q1" vid="JER 23:9">मात्तिएको म एउटा मतवालाजस्तै भएको छु,</para>
  <para style="q2" vid="JER 23:9">दाखमद्यले लट्ठ मातेको मानिसजस्तै छु।<verse eid="JER 23:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 23:10"/>सारा देश व्यभिचारीहरूले भरिएको छ;</para>
  <para style="q2" vid="JER 23:10">श्रापको कारण देशका मानिसहरू शोक गर्दैछन्;</para>
  <para style="q2" vid="JER 23:10">अनि उजाडस्थानका खर्कहरू सुकेका छन्।</para>
  <para style="q1" vid="JER 23:10">तिनीहरूका अगमवक्ताहरू दुष्‍ट मार्ग पछ्याउँछन्,</para>
  <para style="q2" vid="JER 23:10">र तिनीहरूको शक्ति अन्यायको लागि प्रयोग गर्छन्।<verse eid="JER 23:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="JER 23:11"/>“अगमवक्ता र पुजारी दुवै ईश्‍वरहीन छन्;</para>
  <para style="q2" vid="JER 23:11">मेरो मन्दिरमा पनि म तिनीहरूको दुष्‍टता भेट्टाउँछु,”</para>
  <para style="q2" vid="JER 23:11">याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 23:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 23:12"/>“यसकारण तिनीहरूका बाटाहरू चिप्ला हुनेछन्;</para>
  <para style="q2" vid="JER 23:12">तिनीहरू अँध्यारोमा बाहिर फ्याँकिनेछन्,</para>
  <para style="q2" vid="JER 23:12">र तिनीहरू त्यसैमा ठेस खाएर लड्नेछन्।</para>
  <para style="q1" vid="JER 23:12">तिनीहरूले दण्ड पाउने वर्षमा,</para>
  <para style="q2" vid="JER 23:12">म तिनीहरूमाथि विपत्ति ल्याउनेछु,”</para>
  <para style="q2" vid="JER 23:12">याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 23:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JER 23:13"/>“सामरियाका अगमवक्ताहरूबीच</para>
  <para style="q2" vid="JER 23:13">मैले यी घिनलाग्दा कामहरू देखेँ:</para>
  <para style="q1" vid="JER 23:13">तिनीहरूले बाल-देवताको नाममा अगमवाणी गरे,</para>
  <para style="q2" vid="JER 23:13">र मेरो जाति इस्राएललाई गलत बाटोमा बहकाए।<verse eid="JER 23:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 23:14"/>अनि यरूशलेमका अगमवक्ताहरूका बीच</para>
  <para style="q2" vid="JER 23:14">मैले केही भयानक कुराहरू देखेँ:</para>
  <para style="q2" vid="JER 23:14">तिनीहरू व्यभिचार गर्छन् र झूटलाई पछ्याउँछन्।</para>
  <para style="q1" vid="JER 23:14">तिनीहरूले दुष्‍ट काम गर्ने मानिसहरूलाई प्रोत्साहित गर्छन्,</para>
  <para style="q2" vid="JER 23:14">ताकि कोही पनि तिनीहरूको दुष्‍टताबाट नफर्कून्।</para>
  <para style="q1" vid="JER 23:14">मेरा निम्ति तिनीहरू सबै सदोमजस्ता छन्;</para>
  <para style="q2" vid="JER 23:14">यरूशलेमका मानिसहरू गमोराका मानिसहरूजस्ता छन्।”<verse eid="JER 23:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 23:15"/>यसकारण अगमवक्ताहरूको बारेमा सेनाहरूका याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="JER 23:15">“हेर, म तिनीहरूलाई तितो भोजन खान लगाउनेछु,</para>
  <para style="q2" vid="JER 23:15">र विषालु पानी पिउन दिनेछु;</para>
  <para style="q1" vid="JER 23:15">किनभने यरूशलेमका अगमवक्ताहरूले</para>
  <para style="q2" vid="JER 23:15">देशभरि नै भक्तिहीनता फैलाएका छन्।”<verse eid="JER 23:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 23:16"/>सेनाहरूका याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="JER 23:16">“अगमवक्ताहरूले तिमीहरूलाई अगमवाणी गरेका कुराहरूमा ध्यान नदेओ;</para>
  <para style="q2" vid="JER 23:16">तिनीहरूले तिमीहरूलाई झूटो आशाले भरिदिन्छन्।</para>
  <para style="q1" vid="JER 23:16">तिनीहरूले याहवेहको मुखबाट होइन,</para>
  <para style="q2" vid="JER 23:16">तर आफ्नो मनबाट दर्शनहरू बताउँछन्।<verse eid="JER 23:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 23:17"/>मलाई घृणा गर्ने मानिसहरूलाई तिनीहरू यसो भनिरहन्छन्;</para>
  <para style="q2" vid="JER 23:17">‘याहवेह भन्‍नुहुन्छ, तिमीहरूलाई शान्ति हुनेछ।’</para>
  <para style="q1" vid="JER 23:17">अनि अटेरी गरेर आफ्नै हृदयका हठीपनको पछि लाग्नेहरूलाई</para>
  <para style="q2" vid="JER 23:17">तिनीहरू भन्छन्, ‘तिमीहरूलाई कुनै पनि हानि हुनेछैन।’<verse eid="JER 23:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 23:18"/>तर अगमवक्ताहरूमध्ये कोचाहिँ हेर्नलाई अथवा उहाँको वचन सुन्‍न भनी</para>
  <para style="q2" vid="JER 23:18">याहवेहको सभामा खडा भएको छ?</para>
  <para style="q2" vid="JER 23:18">उहाँको वचन कसले ध्यान दिएर सुनेको छ?<verse eid="JER 23:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 23:19"/>हेर, याहवेहको क्रोध</para>
  <para style="q2" vid="JER 23:19">आँधीबेहरीजस्तै फुटेर निस्कनेछ;</para>
  <para style="q1" vid="JER 23:19">त्यो दुष्‍टहरूका टाउकामाथि</para>
  <para style="q2" vid="JER 23:19">बतासको भुमरीको झोक्‍काझैँ बजारिनेछ।<verse eid="JER 23:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 23:20"/>याहवेहको रिस उहाँको हृदयका उद्देश्यहरू</para>
  <para style="q2" vid="JER 23:20">पूर्ण रूपमा पूरा नभएसम्म</para>
  <para style="q2" vid="JER 23:20">उहाँको रिस शान्त हुनेछैन।</para>
  <para style="q1" vid="JER 23:20">आउने न्यायका दिनहरूमा</para>
  <para style="q2" vid="JER 23:20">तिमीहरूले यो कुरा छर्लङ्ग बुझ्नेछौ।<verse eid="JER 23:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 23:21"/>मैले यी अगमवक्ताहरूलाई पठाएको होइनँ,</para>
  <para style="q2" vid="JER 23:21">तर पनि तिनीहरू आफ्नै सन्देश लिएर दौडिएका छन्;</para>
  <para style="q1" vid="JER 23:21">मैले तिनीहरूलाई कुनै सन्देश दिएको छैनँ,</para>
  <para style="q2" vid="JER 23:21">तापनि तिनीहरूले मेरो नाममा अगमवाणी गरेका छन्।<verse eid="JER 23:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 23:22"/>तर यदि तिनीहरू मेरो सभामा खडा भएका भए,</para>
  <para style="q2" vid="JER 23:22">र तिनीहरूले मेरा मानिसहरूलाई मेरो वचन घोषणा गरेका भए;</para>
  <para style="q1" vid="JER 23:22">तिनीहरूले तिनीहरूलाई आफ्ना दुष्‍ट चालहरूबाट</para>
  <para style="q2" vid="JER 23:22">र तिनीहरूका दुष्‍ट कामहरूबाट फर्काउनेथिए।”<verse eid="JER 23:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="JER 23:23"/>याहवेह घोषणा गर्नुहुन्छ,</para>
  <para style="q2" vid="JER 23:23">“के म नजिकमा मात्र रहने परमेश्‍वर हुँ र,</para>
  <para style="q2" vid="JER 23:23">अनि टाढाको परमेश्‍वरचाहिँ होइन र?”<verse eid="JER 23:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 23:24"/>याहवेह घोषणा गर्नुहुन्छ,</para>
  <para style="q2" vid="JER 23:24">“कसले आफूलाई गुप्‍त ठाउँहरूमा लुकाउन सक्छ,</para>
  <para style="q2" vid="JER 23:24">जहाँ म तिमीहरूलाई देख्न सक्दिनँ?</para>
  <para style="q1" vid="JER 23:24">के म स्वर्ग र पृथ्वी दुवै ठाउँमा देख्न सक्दिनँ र?”</para>
  <para style="q2" vid="JER 23:24">याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 23:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JER 23:25"/>“मेरो नाममा झूटो अगमवाणी गर्ने अगमवक्ताहरूले भनेको कुरा मैले सुनेको छु। तिनीहरू भन्दछन्, ‘मैले सपना देखेको छु! मैले सपना देखेको छु!’ <verse eid="JER 23:25"/><verse number="26" style="v" sid="JER 23:26"/>यो कहिलेसम्म झूटा अगमवक्ताहरूका हृदयमा रहला, जसले आफ्नो मनका भ्रामक कुराबाट अगमवाणी गर्छन्? <verse eid="JER 23:26"/><verse number="27" style="v" sid="JER 23:27"/>ती अगमवक्ताहरू सोच्दछन्, कि तिनीहरूले एक-आपसमा भनेका सपनाहरूले गर्दा, मेरा मानिसहरूले मेरो नाम बिर्सनेछन्, जसरी तिनीहरूका पितापुर्खाहरूले बाल-देवतालाई पूजा गरेर मेरो नाम बिर्सेका थिए। <verse eid="JER 23:27"/><verse number="28" style="v" sid="JER 23:28"/>सपना देख्ने अगमवक्ताले उसको सपना नै भनोस्, तर मेरो वचन पाउनेले विश्‍वासयोग्यतासाथ त्यही बोलोस्। किनकि अन्‍नसित परालको के तुलना हुन सक्छ र?” याहवेह घोषणा गर्नुहुन्छ। <verse eid="JER 23:28"/><verse number="29" style="v" sid="JER 23:29"/>“के मेरो वचन आगोजस्तै छैन र?” याहवेह घोषणा गर्नुहुन्छ, “अनि चट्टानलाई टुक्रा-टुक्रा पार्ने हथौडाजस्तै छैन र?”<verse eid="JER 23:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JER 23:30"/>याहवेह घोषणा गर्नुहुन्छ, “यसकारण म ती झूटा अगमवक्ताहरूको विरुद्धमा छु, जसले एक-अर्काबाट वचनहरू चोर्छन्, र मबाट आएको वचन हो भन्दै घोषणा गर्छन्।” <verse eid="JER 23:30"/><verse number="31" style="v" sid="JER 23:31"/>याहवेह घोषणा गर्नुहुन्छ, “हो, म ती अगमवक्ताहरूको विरुद्धमा छु, जसले आफ्नै जिब्रो चलाउँछन्, तर पनि भन्दछन्, ‘याहवेह घोषणा गर्नुहुन्छ।’ <verse eid="JER 23:31"/><verse number="32" style="v" sid="JER 23:32"/>हेर, म झूटो सपनाको अगमवाणी गर्ने अगमवक्ताहरूको विरुद्धमा छु,” याहवेह घोषणा गर्नुहुन्छ। “तिनीहरूले तिनीहरूका झूटा अगमवाणीहरू भन्दछन् र आफ्ना अहङ्कारी झूटा कुराहरूद्वारा मेरा मानिसहरूलाई बहकाइदिन्छन्। तर मैले तिनीहरूलाई पठाएको अथवा नियुक्त गरेकै होइनँ। तिनीहरूले यी मानिसहरूलाई कुनै फाइदा पुर्‍याउँदैनन्,” याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 23:32"/></para>
  <para style="s1">झूटो भविष्यवाणी</para>
  <para style="p">
    <verse number="33" style="v" sid="JER 23:33"/>“जब यी मानिसहरू अथवा अगमवक्ताहरू अथवा पुजारीहरूले ‘याहवेहको सन्देश के छ?’ भनी तँलाई सोध्दछन्, तब तिनीहरूलाई भन् ‘कस्तो सन्देश? म तिमीहरूलाई त्यागिदिनेछु, याहवेह घोषणा गर्नुहुन्छ।’ <verse eid="JER 23:33"/><verse number="34" style="v" sid="JER 23:34"/>यदि कुनै अगमवक्ता अथवा पुजारी अथवा कसैले ‘याहवेहको सन्देश यही हो’ भनी दाबी गर्छ भने म त्यो मानिस र त्यसको परिवारलाई दण्ड दिनेछु। <verse eid="JER 23:34"/><verse number="35" style="v" sid="JER 23:35"/>तिमीहरूमध्ये हरेकले आफ्ना साथीहरू वा अरू इस्राएलीहरू वा एक-अर्कालाई यसरी सोधिरहने गर्छौ: ‘याहवेहको जवाफ के छ? अथवा याहवेहले के बोल्नुभएको छ?’ <verse eid="JER 23:35"/><verse number="36" style="v" sid="JER 23:36"/>तर तिमीहरूले फेरि ‘यो याहवेहको सन्देश हो’ भनेर उल्‍लेख नगर्नू; किनभने हरेक मानिसको आफ्नै कुरा उसको ईश्‍वरवाणी हुन्छ। यसरी तिमीहरूले जीवित परमेश्‍वर, सेनाहरूका याहवेह हाम्रा परमेश्‍वरको वचनलाई बङ्ग्याउँछौ। <verse eid="JER 23:36"/><verse number="37" style="v" sid="JER 23:37"/>तिमीहरूले अगमवक्तालाई यसो भन्‍नू, ‘तिमीहरूलाई याहवेहको जवाफ के छ? अथवा याहवेहले के भन्‍नुभएको छ?’ <verse eid="JER 23:37"/><verse number="38" style="v" sid="JER 23:38"/>यद्यपि तिमीहरूले याहवेहको सन्देश यही हो भनेर दाबी गरे तापनि याहवेह यसो भन्‍नुहुन्छ: ‘तिमीहरूले यो याहवेहको सन्देश हो,’ भनेर दाबी नगर्नू भनेर मैले तिमीहरूलाई भने तापनि तिमीहरूले ‘यो याहवेहको सन्देश हो’ भनी दाबी गर्‍यौ। <verse eid="JER 23:38"/><verse number="39" style="v" sid="JER 23:39"/>यसकारण, निश्‍चय नै म तिमीहरूलाई बिर्सनेछु, र मैले तिमीहरू र तिमीहरूका पितापुर्खालाई दिएको सहरको साथसाथै, मैले तिमीहरूलाई मेरो उपस्थितिबाट पनि बाहिर निकालिदिनेछु। <verse eid="JER 23:39"/><verse number="40" style="v" sid="JER 23:40"/>म तिमीहरूमाथि अनन्तसम्म रहने यस्तो लाज र अनन्तको बदनामी ल्याउनेछु, कि त्यो कहिल्यै बिर्सिइनेछैन।”<verse eid="JER 23:40"/></para>
  <chapter eid="JER 23"/>
  <chapter number="24" style="c" sid="JER 24"/>
  <para style="s1">दुई डाला नेभाराहरू</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 24:1"/>यहूदाका राजा यहोयाकीमको छोरा, यहोयाकीन<note caller="+" style="f"><char style="fr" closed="false">24:1 </char><char style="fq" closed="false">यहोयाकीन, </char><char style="ft" closed="false">मूल भाषामा उनको अर्को नाम </char><char style="fqa" closed="false">कोनिया</char></note> र अधिकारीहरू, यहूदाका कारिगरहरू र शिल्पकारहरूलाई, बेबिलोनको राजा नबूकदनेसरले यरूशलेमबाट बेबिलोनको निर्वासनमा लगेपछि याहवेहले मलाई याहवेहको मन्दिरको सामु राखिएका दुई डाला नेभाराहरू देखाउनुभयो। <verse eid="JER 24:1"/><verse number="2" style="v" sid="JER 24:2"/>एउटा डालोमा पहिले पाकेका खूब असल नेभाराहरू थिए; अर्को डालोमा चाहिँ अति नराम्रा नेभाराहरू थिए। ती खानै नसकिने अति खराब थिए।<verse eid="JER 24:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 24:3"/>तब याहवेहले मलाई सोध्नुभयो, “यर्मिया, तँ के देख्दैछस्?”</para>
  <para style="p" vid="JER 24:3">मैले जवाफ दिएँ, “म नेभाराहरू देख्दैछु। राम्रा नेभाराहरू अति राम्रा छन्, तर नराम्राहरूचाहिँ खानै नसकिने खराब छन्।”<verse eid="JER 24:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 24:4"/>त्यसपछि याहवेहको वचन मकहाँ आयो: <verse eid="JER 24:4"/><verse number="5" style="v" sid="JER 24:5"/>“याहवेह, इस्राएलका परमेश्‍वर यसो भन्‍नुहुन्छ: ‘म यहूदाका मानिसहरूलाई यी असल नेभाराहरूजस्ता ठान्छु, जसलाई मैले यस ठाउँबाट बेबिलोनीहरूको देशमा निर्वासनमा पठाएको थिएँ। <verse eid="JER 24:5"/><verse number="6" style="v" sid="JER 24:6"/>तिनीहरूको भलाइका निम्ति म मेरो दृष्‍टि तिनीहरूमाथि लगाउनेछु, र म तिनीहरूलाई यस देशमा फर्काएर ल्याउनेछु। म तिनीहरूलाई निर्माण गर्नेछु, भत्काउनेछैनँ; म तिनीहरूलाई रोप्नेछु, उखेल्नेछैनँ। <verse eid="JER 24:6"/><verse number="7" style="v" sid="JER 24:7"/>म तिनीहरूलाई म नै याहवेह हुँ भनी जान्‍ने हृदय दिनेछु। तिनीहरू मेरा प्रजा हुनेछन्, र म तिनीहरूका परमेश्‍वर हुनेछु; किनभने तिनीहरू आफ्ना सम्पूर्ण हृदयले मतिर फर्कनेछन्।<verse eid="JER 24:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 24:8"/>“ ‘याहवेह घोषणा गर्नुहुन्छ, तर ती खानै नसकिने धेरै खराब नराम्रा नेभाराहरूजस्तै, म यहूदाको राजा सिदकियाह, त्यसका अधिकारीहरू र यरूशलेमबाट बाँचेकाहरूसँग ती नेभाराहरूलाई जस्तै व्यवहार गर्नेछु, चाहे तिनीहरू यस देशमा रहून्, अथवा इजिप्टमै रहून्। <verse eid="JER 24:8"/><verse number="9" style="v" sid="JER 24:9"/>म तिनीहरूलाई पृथ्वीका सबै राज्यहरूका निम्ति अति घृणित र अपमानित तुल्याउनेछु। मैले तिनीहरूलाई निकालेर जहाँ-जहाँ खेदे तापनि तिनीहरूलाई निन्दा, श्राप र गिल्‍लाको पात्र तुल्याउनेछु। <verse eid="JER 24:9"/><verse number="10" style="v" sid="JER 24:10"/>मैले तिनीहरू र तिनीहरूका पितापुर्खाहरूलाई दिएको देशबाट तिनीहरू पूरै नाश नभएसम्म म तिनीहरूको विरुद्धमा तरवार, अनिकाल र महामारी पठाउनेछु।’ ”<verse eid="JER 24:10"/></para>
  <chapter eid="JER 24"/>
  <chapter number="25" style="c" sid="JER 25"/>
  <para style="s1">सत्तरी वर्षको कैद</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 25:1"/>योशियाहका छोरा, यहूदाका राजा यहोयाकीमको शासनकालको चौथो वर्षमा, जुन बेबिलोनका राजा नबूकदनेसरको शासनकालको पहिलो वर्ष थियो; अनि यहूदाका सबै मानिसहरूका बारेमा यर्मियाकहाँ यो वचन आयो। <verse eid="JER 25:1"/><verse number="2" style="v" sid="JER 25:2"/>यसकारण अगमवक्ता यर्मियाले यहूदाका सबै मानिसहरू र यरूशलेममा बसोबास गर्ने सबैलाई भने: <verse eid="JER 25:2"/><verse number="3" style="v" sid="JER 25:3"/>यहूदाका राजा आमोनका छोरा, योशियाहको तेह्रौँ वर्षदेखि आजको दिनसम्म, तेईस वर्ष भयो—आजको दिनसम्म याहवेहको वचन मकहाँ आएको छ; अनि म तिमीहरूसित बारम्बार बोलिरहेको छु, तर तिमीहरूले ध्यान दिएर सुनेका छैनौ।<verse eid="JER 25:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 25:4"/>अनि याहवेहले आफ्ना सबै सेवकहरू अर्थात् अगमवक्ताहरूलाई तिमीहरूकहाँ बारम्बार पठाउनुभए तापनि तिमीहरूले सुनेका छैनौ, अथवा ध्यानै दिएका छैनौ। <verse eid="JER 25:4"/><verse number="5" style="v" sid="JER 25:5"/>अगमवक्ताहरूले भने, “तिमीहरू हरेक आफ्ना दुष्‍ट मार्गहरू र तिमीहरूका खराब चालचलनहरूबाट फर्क; अनि याहवेहले तिमीहरू र तिमीहरूका पितापुर्खाहरूलाई दिनुभएको देशमा तिमीहरू सदाकालको निम्ति बस्‍न पाउनेछौ। <verse eid="JER 25:5"/><verse number="6" style="v" sid="JER 25:6"/>तिमीहरू अन्य देवताहरूको सेवा गर्न र तिनीहरूलाई पुज्नलाई पछि नलाग; तिमीहरूका हातले बनाएका मूर्तिहरूको कारणले मेरो रिस नउठोस्। तब म तिमीहरूको हानि गर्नेछैनँ।”<verse eid="JER 25:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 25:7"/>याहवेह घोषणा गर्नुहुन्छ, “तर तिमीहरूले मेरो कुरा सुनेनौ र तिमीहरूले आफ्ना हातले बनाएका मूर्तिहरूले मलाई रिस उठायौ; यसरी तिमीहरूले आफूमाथि नोक्सानी ल्यायौ।”<verse eid="JER 25:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 25:8"/>यसकारण सेनाहरूका याहवेह यसो भन्‍नुहुन्छ: “तिमीहरूले मेरा कुरा नसुनेको हुनाले, <verse eid="JER 25:8"/><verse number="9" style="v" sid="JER 25:9"/>म उत्तरका सबै जातिहरूलाई र मेरो सेवक बेबिलोनका राजा नबूकदनेसरलाई बोलाउनेछु,” याहवेह घोषणा गर्नुहुन्छ, “अनि म तिनीहरूलाई यो देश र यस देशका बासिन्दाहरूको विरुद्धमा र वरिपरिका सबै राष्ट्रहरूको विरुद्धमा भेला गराउनेछु। म तिनीहरूलाई सम्पूर्ण रूपले सर्वनाश गर्नेछु; म तिनीहरूलाई त्रास, हाँसो र अनन्त विनाशको पात्र बनाउनेछु। <verse eid="JER 25:9"/><verse number="10" style="v" sid="JER 25:10"/>म तिनीहरूबाट हर्ष र आनन्दको सोर, दुलहा र दुलहीको आवाज, जाँतो पिँधेको आवाज र बत्तीको उज्यालोलाई हटाइदिनेछु। <verse eid="JER 25:10"/><verse number="11" style="v" sid="JER 25:11"/>यो समस्त देश उजाड र बाँझो भूमि हुनेछ; अनि यी राष्ट्रहरूले सत्तरी वर्षसम्म बेबिलोनको राजाको सेवा गर्नेछन्।<verse eid="JER 25:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 25:12"/>“तर जब सत्तरी वर्ष पूरा हुन्छ, तब म बेबिलोनको राजा र त्यसको राज्य बेबिलोनीहरूको देशलाई तिनीहरूको अपराधको कारण दण्ड दिनेछु; अनि त्यस देशलाई सधैँका निम्ति उजाड पारिदिनेछु,” याहवेह घोषणा गर्नुहुन्छ। <verse eid="JER 25:12"/><verse number="13" style="v" sid="JER 25:13"/>“म बेबिलोनमाथि मैले यसको विरुद्धमा बोलेका सबै कुराहरू, यस पुस्तकमा लेखिएका सबै कुराहरू र यर्मियाले राष्ट्रहरूको विरुद्धमा गरेका अगमवाणीहरू बेबिलोनमा ल्याउनेछु। <verse eid="JER 25:13"/><verse number="14" style="v" sid="JER 25:14"/>तिनीहरू आफैँ पनि धेरै राष्ट्रहरू र महान् राजाहरूद्वारा दास तुल्याइनेछन्; म तिनीहरूलाई तिनीहरूकै हातका कामहरू र कर्महरू अनुसार बदला लिनेछु।”<verse eid="JER 25:14"/></para>
  <para style="s1">परमेश्‍वरको क्रोधको कचौरा</para>
  <para style="p">
    <verse number="15" style="v" sid="JER 25:15"/>याहवेह, इस्राएलका परमेश्‍वरले मलाई यसो भन्‍नुभयो: “मेरो क्रोधको मद्यले भरिएको यो कचौरा मेरो हातबाट लि, र मैले तँलाई पठाएका सबै राष्ट्रहरूलाई यो पिउन दे। <verse eid="JER 25:15"/><verse number="16" style="v" sid="JER 25:16"/>जब तिनीहरूले यो पिउनेछन्, तब मैले तिनीहरूका बीचमा पठाउने तरवारको कारण तिनीहरू धरमराउनेछन् र बौलाहा हुनेछन्।” <verse eid="JER 25:16"/><verse number="17" style="v" sid="JER 25:17"/>यसकारण मैले त्यो कचौरा याहवेहको हातबाट लिएँ, र उहाँले मलाई पठाउनुभएका सबै जातिहरूलाई पिउन दिएँ:<verse eid="JER 25:17"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="18" style="v" sid="JER 25:18"/>सुरुमा मैले यरूशलेम र यहूदाका सहरहरू, त्यसका राजाहरू र अधिकारीहरूलाई त्रास र घृणा तथा सरापको पात्र बनाउनलाई कचौराबाट पिउन लगाएँ। तिनीहरू आज त्यस्तै अवस्थामा छन्;<verse eid="JER 25:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="JER 25:19"/>त्यसपछि इजिप्टका राजा फारो र त्यसका कर्मचारीहरू, त्यसका अधिकारीहरू र त्यसका सबै मानिसहरू; <verse eid="JER 25:19"/><verse number="20" style="v" sid="JER 25:20"/>अनि त्यहाँ रहेका सबै विदेशी मानिसहरू;</para>
  <para style="li1" vid="JER 25:20">अनि ऊज देशका सबै राजाहरू;</para>
  <para style="li1" vid="JER 25:20">पलिश्तीका सबै राजाहरू (अश्कलोन, गाजा, एक्रोन र अश्दोदमा छोडिएका सबै मानिसहरू);<verse eid="JER 25:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="JER 25:21"/>एदोम, मोआब र अम्मोन;<verse eid="JER 25:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="JER 25:22"/>टायर र सीदोनका सबै राजाहरू;</para>
  <para style="li1" vid="JER 25:22">भूमध्य सागरको किनारका सबै राजाहरू;<verse eid="JER 25:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="JER 25:23"/>ददान, तेमा, बूज र टाढा ठाउँहरूमा भएका सबै मानिसहरू<note caller="+" style="f"><char style="fr" closed="false">25:23 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">कन्चटनेरको कपाल खौरनेहरू</char></note>;<verse eid="JER 25:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="JER 25:24"/>अरब देशका सबै राजाहरू र मरुभूमिमा बस्‍ने विदेशी मानिसहरूका सबै राजाहरू;<verse eid="JER 25:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="JER 25:25"/>जिम्री, एलाम र मादीका सबै राजाहरू;<verse eid="JER 25:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="JER 25:26"/>अनि टाढा र नजिकमा रहेका उत्तरका सबै राजाहरू, एकपछि अर्कालाई—पृथ्वीमा भएका सबै राज्यहरूलाई पिउन दिएँ।</para>
  <para style="li1" vid="JER 25:26">अनि यी माथिका सबै राजाहरू र जातिहरूपछि शेशकका<note caller="+" style="f"><char style="fr" closed="false">25:26 </char><char style="fq" closed="false">शेशकका </char><char style="ft" closed="false">बेबिलोनको गुप्‍त नाम हुन सक्छ।</char></note> राजाले पनि त्यो कचौराबाट पिउनेछ।<verse eid="JER 25:26"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="27" style="v" sid="JER 25:27"/>“तब तिनीहरूलाई भन्, ‘सेनाहरूका याहवेह, इस्राएलका परमेश्‍वर यसो भन्‍नुहुन्छ: पिओ, मात र बान्ता गर! अनि मैले तिमीहरूका लागि पठाउन लागेको तरवारको कारण कहिल्यै उठ्न नसक्ने गरी लोट।’ <verse eid="JER 25:27"/><verse number="28" style="v" sid="JER 25:28"/>तर यदि तिनीहरूले तेरो हातका कचौराबाट पिउन इन्कार गरे भने तिनीहरूलाई भन्, ‘सेनाहरूका याहवेह यसो भन्‍नुहुन्छ: तिमीहरूले यो पिउनैपर्छ! <verse eid="JER 25:28"/><verse number="29" style="v" sid="JER 25:29"/>हेर, म मेरो नाम बोकेको सहरमाथि विपत्ति ल्याउने काम सुरु गर्दैछु; अनि के तिमीहरू दण्डविना उम्कन सक्छौ? तिमीहरू दण्डविना उम्कनेछैनौ; किनकि म यस पृथ्वीमा भएका सबै मानिसहरूमाथि तरवार पठाउँदैछु, सेनाहरूका याहवेह घोषणा गर्नुहुन्छ।’<verse eid="JER 25:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JER 25:30"/>“अब तिनीहरू सबैको विरुद्धमा अगमवाणी गर्, र तिनीहरूलाई भन्:</para>
  <para style="q1" vid="JER 25:30">“ ‘याहवेह उचाइबाट गर्जनुहुनेछ;</para>
  <para style="q2" vid="JER 25:30">उहाँ आफ्नो पवित्र वासस्थानबाट मेघ गर्जनजस्तै गर्जनुहुनेछ,</para>
  <para style="q2" vid="JER 25:30">र आफ्नो देशको विरुद्धमा अति जोडसँग गर्जनुहुनेछ।</para>
  <para style="q1" vid="JER 25:30">उहाँ पृथ्वीमा बस्‍ने सबै मानिसहरूको विरुद्धमा,</para>
  <para style="q2" vid="JER 25:30">अङ्‌गुर पेल्ने मानिसहरूजस्तो जोडसित चिच्याउनुहुनेछ।<verse eid="JER 25:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JER 25:31"/>मानिसहरूको होहल्‍लाको खैलाबैला पृथ्वीको पल्‍लो छेउहरूसम्म गुञ्जिनेछ;</para>
  <para style="q2" vid="JER 25:31">किनकि याहवेहले राष्ट्रहरूको विरुद्धमा अभियोग लगाउनुहुनेछ;</para>
  <para style="q1" vid="JER 25:31">उहाँले सबै मानव-जातिमाथि न्याय ल्याउनुहुनेछ,</para>
  <para style="q2" vid="JER 25:31">र दुष्‍टहरूलाई तरवारले मार्नुहुनेछ,’ ”</para>
  <para style="q2" vid="JER 25:31">याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 25:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JER 25:32"/>सेनाहरूका याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="JER 25:32">“हेर, एक राष्ट्रदेखि अर्को राष्ट्रसम्म</para>
  <para style="q2" vid="JER 25:32">विपत्ति फैलिनेछ;</para>
  <para style="q1" vid="JER 25:32">पृथ्वीको पल्‍लो छेउबाट</para>
  <para style="q2" vid="JER 25:32">एउटा शक्तिशाली आँधीबेहरी उठ्दैछ।”<verse eid="JER 25:32"/></para>
  <para style="m">
    <verse number="33" style="v" sid="JER 25:33"/>त्यस बेला याहवेहद्वारा मारिएकाहरूको मृत शरीर पृथ्वीको एक छेउबाट अर्को छेउसम्म चारैतिर हुनेछन्। तिनीहरूका निम्ति न त शोक गरिनेछ, न त तिनीहरू गाडिनेछन्, तर तिनीहरू भुइँमा छरिएको मलजस्तै हुनेछन्।<verse eid="JER 25:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="JER 25:34"/>हे गोठालाहरू हो, रोओ, विलाप गर;</para>
  <para style="q2" vid="JER 25:34">हे बगालका अगुवाहरू हो, धुलोमा लडीबुडी गर।</para>
  <para style="q1" vid="JER 25:34">किनकि तिमीहरूको मारिने समय आएको छ;</para>
  <para style="q2" vid="JER 25:34">तिमीहरू असल भेडा ढलेझैँ ढल्नेछौ,<note caller="+" style="f"><char style="fr" closed="false">25:34 </char><char style="ft" closed="false">बहुमूल्य भाँडोझैँ टुक्रा-टुक्रा हुनेछौ।</char></note><verse eid="JER 25:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="JER 25:35"/>गोठालाहरू भागेर जाने ठाउँ कहीँ पनि हुनेछैन;</para>
  <para style="q2" vid="JER 25:35">बगालका अगुवाहरू उम्कने ठाउँ कहीँ पनि हुनेछैन।<verse eid="JER 25:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="JER 25:36"/>गोठालाहरूको दुःखको बिलौना सुन,</para>
  <para style="q2" vid="JER 25:36">बगालका अगुवाहरूका विलाप सुन;</para>
  <para style="q2" vid="JER 25:36">किनकि याहवेहले तिनीहरूका खर्क नष्‍ट गर्नुहुँदैछ।<verse eid="JER 25:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="JER 25:37"/>याहवेहको भयानक क्रोधको कारण</para>
  <para style="q2" vid="JER 25:37">शान्तिपूर्ण चरनहरू उजाड हुनेछन्।<verse eid="JER 25:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="JER 25:38"/>उहाँले सिंहले झैँ आफ्नो ओडार छोड्नुहुनेछ;</para>
  <para style="q2" vid="JER 25:38">अत्याचारीको तरवारको<note caller="+" style="f"><char style="fr" closed="false">25:38 </char><char style="ft" closed="false">मूल भाषामा </char><char style="fqa" closed="false">रिस</char></note> कारण</para>
  <para style="q1" vid="JER 25:38">र याहवेहको भयानक क्रोधको कारण</para>
  <para style="q2" vid="JER 25:38">तिनीहरूको देश उजाड हुनेछ।<verse eid="JER 25:38"/></para>
  <chapter eid="JER 25"/>
  <chapter number="26" style="c" sid="JER 26"/>
  <para style="s1">यर्मियालाई मृत्युको धम्की</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 26:1"/>योशियाहका छोरा, यहूदाका राजा यहोयाकीमको शासनकालको सुरुका दिनहरूमा याहवेहबाट यो वचन आयो: <verse eid="JER 26:1"/><verse number="2" style="v" sid="JER 26:2"/>“याहवेह यसो भन्‍नुहुन्छ: याहवेहको भवनको चोकमा खडा हो, र याहवेहको भवनमा आराधना गर्न आउने यहूदाका सहरहरूका सबै मानिसहरूसित कुरा गर्। मैले तँलाई आज्ञा गरेको हरेक कुरा तिनीहरूलाई एक शब्द पनि नछोडी सुना। <verse eid="JER 26:2"/><verse number="3" style="v" sid="JER 26:3"/>सायद तिनीहरूले सुन्लान् र तिनीहरू हरेक आफ्ना दुष्‍ट चालहरूबाट फर्कलान्। तब म आफ्नो मन परिवर्तन गर्नेछु र तिनीहरूले गरेका दुष्‍टताको कारण तिनीहरूमाथि विपत्ति ल्याउनेछैनँ। <verse eid="JER 26:3"/><verse number="4" style="v" sid="JER 26:4"/>तिनीहरूलाई भन्‍नू, ‘याहवेह यसो भन्‍नुहुन्छ: यदि तिमीहरूले मेरा कुरा सुनेनौ र मैले तिमीहरूको सामु राखिदिएको मेरो व्यवस्था पालन गरेनौ भने, <verse eid="JER 26:4"/><verse number="5" style="v" sid="JER 26:5"/>र तिमीहरूले मेरा सेवक अगमवक्ताहरूका वचनहरू सुनेनौ भने जसलाई मैले तिमीहरूकहाँ बारम्बार पठाएको थिएँ, यद्यपि तिमीहरूले सुनेका छैनौ, <verse eid="JER 26:5"/><verse number="6" style="v" sid="JER 26:6"/>तब म यस भवनलाई शीलोजस्तै र यस सहरलाई पृथ्वीका सबै जातिहरूबीच एक सरापको पात्र तुल्याउनेछु।’ ”<verse eid="JER 26:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 26:7"/>पुजारीहरू, अगमवक्ताहरू र सबै मानिसहरूले याहवेहको भवनमा यर्मियाले भनेका यी वचनहरू सुने। <verse eid="JER 26:7"/><verse number="8" style="v" sid="JER 26:8"/>तर जब याहवेहले यर्मियालाई भन्‍नू भनी आज्ञा दिनुभएका सबै कुराहरू तिनले भनिसके, तब पुजारीहरू, अगमवक्ताहरू र सबै मानिसहरूले तिनलाई समातेर भने, “तँ अब मर्नैपर्छ! <verse eid="JER 26:8"/><verse number="9" style="v" sid="JER 26:9"/>यो भवन शीलोजस्तै हुनेछ, र यो सहरचाहिँ उजाड र रुखो हुनेछ भनी किन याहवेहको नाममा अगमवाणी गरिस्?” अनि याहवेहको भवनमा सबै मानिसहरूले यर्मियालाई घेरे।<verse eid="JER 26:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 26:10"/>जब यहूदाका अधिकारीहरूले यो कुरा सुने, तब तिनीहरू राजमहलबाट याहवेहको भवनमा गए, र याहवेहको नयाँ मूलढोकाको प्रवेशद्वारमा आ-आफ्ना ठाउँमा बसे। <verse eid="JER 26:10"/><verse number="11" style="v" sid="JER 26:11"/>तब पुजारीहरू र अगमवक्ताहरूले अधिकारीहरू र सबै मानिसहरूलाई भने, “यस मानिसलाई मृत्युदण्ड दिनुपर्छ; किनकि यसले यस सहरको विरुद्धमा अगमवाणी गरेको छ। तपाईंहरूले यो कुरा आफ्नै कानले सुन्‍नुभएको छ!”<verse eid="JER 26:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 26:12"/>तब यर्मियाले सबै अधिकारीहरू र सबै मानिसहरूलाई भने: “याहवेहले नै मलाई यस भवन र यस सहरको विरुद्धमा तपाईंहरूले सुनेका सबै कुराहरू अगमवाणी गर्नलाई पठाउनुभएको हो। <verse eid="JER 26:12"/><verse number="13" style="v" sid="JER 26:13"/>अब तपाईंहरूले आ-आफ्ना चाल र कामहरू सुधार्नुहोस्! अनि याहवेह तपाईंहरूका परमेश्‍वरको आज्ञापालन गर्नुहोस्। तब याहवेहले आफ्नो मन बदल्नुहुनेछ र उहाँले तपाईंहरूको विरुद्धमा घोषणा गर्नुभएको विपत्ति ल्याउनुहुनेछैन। <verse eid="JER 26:13"/><verse number="14" style="v" sid="JER 26:14"/>मेरो बारेमा भन्‍नुपर्दा, म त तपाईंहरूकै हातमा छु; तपाईंहरूलाई जे असल र उचित लाग्छ, त्यही मसित गर्नुहोस्। <verse eid="JER 26:14"/><verse number="15" style="v" sid="JER 26:15"/>तर यो कुरा जान्‍नुहोस्, कि तपाईंहरूले मलाई मार्नुभयो भने निश्‍चय तपाईंहरूले निर्दोष मानिसको रगतको दोष आफूमाथि, यस सहरमाथि र यस सहरमा बस्‍ने मानिसहरूमाथि पनि ल्याउनुहुनेछ; किनकि याहवेहले मलाई तपाईंहरूले सुन्‍ने गरी यी सबै वचनहरू तपाईंहरूलाई चेतावनी दिन पठाउनुभएको कुरा सत्य हो।”<verse eid="JER 26:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 26:16"/>तब ती अधिकारीहरू र मानिसहरूले पुजारीहरू र अगमवक्ताहरूलाई भने, “यो मानिस मृत्युदण्ड पाउन योग्य छैन! किनकि यसले याहवेह हाम्रा परमेश्‍वरको नाममा, उहाँको तर्फबाट हामीसित बोलेको छ।”<verse eid="JER 26:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 26:17"/>प्रधानहरूमध्ये केही मानिसहरू उठेर भेला भएका सम्पूर्ण समुदायलाई भने, <verse eid="JER 26:17"/><verse number="18" style="v" sid="JER 26:18"/>“मोरेशेतका मीकाले यहूदाका राजा हिजकियाहको समयमा अगमवाणी गरे। तिनले यहूदाका सबै मानिसहरूलाई भने, ‘सेनाहरूका याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="JER 26:18">“ ‘सियोन खेतजस्तै जोतिनेछ;</para>
  <para style="q2" vid="JER 26:18">यरूशलेम भग्नावशेषको थुप्रो हुनेछ,</para>
  <para style="q2" vid="JER 26:18">र मन्दिरको डाँडाचाहिँ झाडीले भरिएको ढिस्कोझैँ हुनेछ।’<note caller="+" style="f"><char style="fr" closed="false">26:18 </char><char style="ft" closed="false"><char style="xt"><ref loc="MIC 3:12">मीका 3:12</ref></char></char></note><verse eid="JER 26:18"/></para>
  <para style="m">
    <verse number="19" style="v" sid="JER 26:19"/>“के यहूदाका राजा हिजकियाह अथवा यहूदाका अरू कसैले मीकालाई मारे? के हिजकियाहले याहवेहसित डराएर उहाँको कृपा खोजेनन्? अनि के याहवेहले आफ्नो मन बदलेर उहाँले तिनीहरूको विरुद्धमा घोषणा गर्नुभएको विपत्तिदेखि आफ्नो मन बदल्नुभएन र? तर हामीले आफूमाथि एक डरलाग्दो विपत्ति ल्याउन लाग्दैछौँ!”<verse eid="JER 26:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 26:20"/>(किर्यत-यारीमबाट शमायाहका छोरा उरियाह नाम गरेका अर्का मानिस थिए, जसले याहवेहको नाममा अगमवाणी गरेका थिए; उरियाहले पनि यस सहर र यस देशको विरुद्धमा यर्मियाले झैँ अगमवाणी गरे। <verse eid="JER 26:20"/><verse number="21" style="v" sid="JER 26:21"/>जब राजा यहोयाकीम र तिनका सबै अधिकारीहरू र अधिकृतहरूले तिनका वचनहरू सुने, तब राजाले तिनलाई मार्न खोजेका थिए। तर जब उरियाहले यो कुरा सुने, तब तिनी डरले इजिप्टतिर भागे। <verse eid="JER 26:21"/><verse number="22" style="v" sid="JER 26:22"/>अनि राजा यहोयाकीमले उरियाहलाई पक्रन अक्बोरको छोरा एल्नातानलाई अरू केही मानिसहरूसहित इजिप्टमा पठाए। <verse eid="JER 26:22"/><verse number="23" style="v" sid="JER 26:23"/>तिनीहरूले उरियाहलाई इजिप्टबाट लिएर आए, र राजा यहोयाकीमकहाँ लगे, जसले तिनलाई तरवारले प्रहार गरेर मारे। अनि तिनको शरीरलाई सर्वसाधारण मानिसहरू गाडिने ठाउँमा फ्याँक्न लगाए)।<verse eid="JER 26:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 26:24"/>तर शापानका छोरा अहीकामले यर्मियालाई समर्थन गरे। त्यसैकारण तिनीहरूले यर्मियालाई पक्रेर मारिनका निम्ति मानिसहरूका हातमा दिएनन्।<verse eid="JER 26:24"/></para>
  <chapter eid="JER 26"/>
  <chapter number="27" style="c" sid="JER 27"/>
  <para style="s1">यहूदाले नबूकदनेसरको सेवा गर्ने</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 27:1"/>योशियाहका छोरा, यहूदाका राजा सिदकियाहको शासनकालको सुरुका दिनहरूमा याहवेहबाट यर्मियाकहाँ यो वचन आयो: <verse eid="JER 27:1"/><verse number="2" style="v" sid="JER 27:2"/>याहवेहले मलाई यसो भन्‍नुभयो: “छालाको डोरी र एउटा जुवा बना, र तेरो काँधमा राख्। <verse eid="JER 27:2"/><verse number="3" style="v" sid="JER 27:3"/>त्यसपछि एदोम, मोआब, टायर, अम्मोन र सीदोनका राजाहरूका राजदूतहरू, जो यरूशलेममा यहूदाको राजा सिदकियाहलाई भेट्न आएका छन्, ती राजदूतहरूद्वारा राजाकहाँ समाचार पठा। <verse eid="JER 27:3"/><verse number="4" style="v" sid="JER 27:4"/>तिनीहरूका राजाहरूका निम्ति यो सन्देश दिएर भन्, ‘सेनाहरूका याहवेह, इस्राएलका परमेश्‍वर यसो भन्‍नुहुन्छ: “तिमीहरूका मालिकहरूलाई यो सन्देश भन्‍नू: <verse eid="JER 27:4"/><verse number="5" style="v" sid="JER 27:5"/>मैले आफ्नो महाशक्ति र बलवान् हातले पृथ्वी र त्यसमा भएका मानिसहरू र पशुप्राणीहरू बनाएँ; जसलाई इच्छा लाग्छ त्यसैलाई म यो दिन्छु। <verse eid="JER 27:5"/><verse number="6" style="v" sid="JER 27:6"/>अब म तिमीहरूका सबै देशहरू मेरो सेवक बेबिलोनको राजा नबूकदनेसरको हातमा सुम्पिदिनेछु; म जङ्गली जनावरहरूलाई पनि त्यसको अधीनमा राखिदिनेछु। <verse eid="JER 27:6"/><verse number="7" style="v" sid="JER 27:7"/>त्यस देशको पतनको समय नआइपुगेसम्म सबै जातिहरूले त्यसका छोरा र नातिको सेवा गर्नेछन्। त्यसपछि धेरै राष्ट्रहरू र महान् राजाहरूले त्यसलाई आफ्नो अधीनमा पार्नेछन्।<verse eid="JER 27:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 27:8"/>“ ‘ “तर यदि कुनै राष्ट्र अथवा राज्यले बेबिलोनको राजा नबूकदनेसरको सेवा गर्दैन अथवा त्यसको जुवामुनि निहुरिन चाहँदैन भने म त्यस राष्ट्रलाई नबूकदनेसरकै हातबाट नाश नभएसम्म, तिनीहरूलाई तरवार, अनिकाल र विपत्तिले दण्ड दिनेछु, याहवेह घोषणा गर्नुहुन्छ। <verse eid="JER 27:8"/><verse number="9" style="v" sid="JER 27:9"/>यसकारण तिमीहरूले आफ्ना अगमवक्ताहरू, जोखना हेर्नेहरू, सपनाको अर्थ खोल्नेहरू, टुनामुना गर्नेहरूका कुरा नसुन, जसले तिमीहरूलाई भन्‍नेछन्, ‘तिमीहरूले बेबिलोनको राजाको सेवा गर्नेछैनौ।’ <verse eid="JER 27:9"/><verse number="10" style="v" sid="JER 27:10"/>तिनीहरू झूटो अगमवाणी गर्छन्, जसले गर्दा तिमीहरूलाई आफ्नो देशबाट टाढा लैजाने काम मात्र गर्नेछ; म तिमीहरूलाई देशबाट निकालिदिनेछु र तिमीहरू नष्‍ट हुनेछौ। <verse eid="JER 27:10"/><verse number="11" style="v" sid="JER 27:11"/>तर यदि कुनै राष्ट्रले बेबिलोनको राजाको जुवामुनि निहुरेर त्यसको सेवा गर्छ भने म त्यस राष्ट्रलाई त्यसको आफ्नै देशमा खेती गर्न र बस्‍न दिनेछु, याहवेह घोषणा गर्नुहुन्छ।” ’ ”<verse eid="JER 27:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 27:12"/>मैले यही समाचार यहूदाका राजा सिदकियाहलाई दिएँ। मैले भनेँ, “बेबिलोनका राजाको जुवामुनि आफ्नो काँध राख्; त्यस राजाको र त्यसका मानिसहरूको सेवा गर्, तब तँ जीवित रहनेछस्। <verse eid="JER 27:12"/><verse number="13" style="v" sid="JER 27:13"/>किन याहवेहले बेबिलोनको राजाको सेवा नगर्ने जातिहरूका निम्ति दिनुभएको चेतावनीझैँ, तँ र तेरा मानिसहरू तरवार, अनिकाल र विपत्तिद्वारा मर्न चाहन्छौ? <verse eid="JER 27:13"/><verse number="14" style="v" sid="JER 27:14"/>तिमीहरूले अगमवक्ताहरूका कुरा नसुन, जसले तिमीहरूलाई, ‘तिमीहरूले बेबिलोनको राजाको सेवा गर्नेछैनौ’ भन्दछन्; किनकि तिनीहरूले तिमीहरूसँग झूटो अगमवाणी गरिरहेका छन्। <verse eid="JER 27:14"/><verse number="15" style="v" sid="JER 27:15"/>याहवेह घोषणा गर्नुहुन्छ, ‘मैले तिनीहरूलाई पठाएको होइनँ। तिनीहरूले मेरो नाममा झूटो अगमवाणी गरिरहेका छन्। यसकारण म तिमीहरू र तिमीहरूलाई अगमवाणी गर्ने अगमवक्ताहरू दुवैलाई देशबाट निकालिदिनेछु र तिमीहरू नाश हुनेछौ।’ ”<verse eid="JER 27:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 27:16"/>तब मैले पुजारीहरू र यी सबै मानिसहरूलाई भनेँ, “याहवेह यसो भन्‍नुहुन्छ: ‘अब चाँडै नै याहवेहको भवनका सामग्रीहरू बेबिलोनबाट फर्काएर ल्याइनेछ,’ भनेर अगमवाणी गर्ने अगमवक्ताहरूको कुरा नसुन। तिनीहरूले तिमीहरूसँग झूटो अगमवाणी गरिरहेका छन्। <verse eid="JER 27:16"/><verse number="17" style="v" sid="JER 27:17"/>तिनीहरूका कुरा नसुन। बेबिलोनका राजाको सेवा गर, र तिमीहरू जीवित रहनेछौ। किन यो सहरलाई नष्‍ट हुन दिने? <verse eid="JER 27:17"/><verse number="18" style="v" sid="JER 27:18"/>यदि तिनीहरू साँच्‍चै नै अगमवक्ताहरू हुन् र तिनीहरूसँग याहवेहको वचन छ भने याहवेहको भवनमा रहेका र यहूदाका राजाका महलमा र यरूशलेममा रहेका सामानहरू बेबिलोनमा नलगियोस् भनी तिनीहरूले सेनाहरूका याहवेहसँग बिन्ती गरून्। <verse eid="JER 27:18"/><verse number="19" style="v" sid="JER 27:19"/>किनकि यस सहरमा छोडिएका स्तम्भहरू, काँसाको विशाल खड्कुँलो, गुड्ने गाडाहरू र अरू सामग्रीहरूको विषयमा सेनाहरूका याहवेह यसो भन्‍नुहुन्छ, <verse eid="JER 27:19"/><verse number="20" style="v" sid="JER 27:20"/>जुन कुराहरू बेबिलोनका राजा नबूकदनेसरले यहोयाकीमका छोरा, यहूदाका राजा यहोयाकीनलाई यहूदा र यरूशलेमका मुख्य मनिसहरूसहित, यरूशलेमबाट बेबिलोनमा कैद गरेर लैजाँदा ती सामानहरू लगेका थिएनन्— <verse eid="JER 27:20"/><verse number="21" style="v" sid="JER 27:21"/>हो, याहवेहको भवनमा र यहूदाका राजाको महलमा र यरूशलेममा छोडिएका कुराहरूको विषयमा सेनाहरूका याहवेह, इस्राएलका परमेश्‍वर यसो भन्‍नुहुन्छ: <verse eid="JER 27:21"/><verse number="22" style="v" sid="JER 27:22"/>‘ती सामानहरू बेबिलोनमा लगिनेछन्; अनि म तिनीहरूका निम्ति केही नगरेसम्म ती त्यहीँ रहनेछन्,’ याहवेह घोषणा गर्नुहुन्छ। ‘त्यसपछि म तिनीहरूलाई यरूशलेममा फर्काएर ल्याउनेछु र तिनीहरूलाई यस ठाउँमा पुनर्स्थापित गर्नेछु।’ ”<verse eid="JER 27:22"/></para>
  <chapter eid="JER 27"/>
  <chapter number="28" style="c" sid="JER 28"/>
  <para style="s1">झूटो अगमवक्ता हनन्याह</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 28:1"/>त्यही वर्षको पाँचौँ महिनामा, यहूदाका राजा सिदकियाहको शासनकालको चौथो वर्षको सुरुवातमा गिबोनमा बस्‍ने अज्जूरको छोरा हनन्याह अगमवक्ताले याहवेहको भवनमा पुजारीहरू र मानिसहरूका उपस्थितिमा मलाई भने, <verse eid="JER 28:1"/><verse number="2" style="v" sid="JER 28:2"/>“सेनाहरूका याहवेह, इस्राएलका परमेश्‍वर यसो भन्‍नुहुन्छ: ‘म बेबिलोनको राजाको जुवा भाँचिदिनेछु। <verse eid="JER 28:2"/><verse number="3" style="v" sid="JER 28:3"/>बेबिलोनको राजा नबूकदनेसरले यस ठाउँबाट निकालेर बेबिलोनमा लगेका याहवेहको भवनका सबै सामग्रीहरू दुई वर्षभित्र नै म फर्काएर ल्याउनेछु। <verse eid="JER 28:3"/><verse number="4" style="v" sid="JER 28:4"/>यहोयाकीमका छोरा यहूदाको राजा यहोयाकीन र यहूदाबाट निकालिएर बेबिलोनमा लगिएका अरू सबै मानिसहरूलाई पनि म यस ठाउँमा फर्काएर ल्याउनेछु,’ याहवेह घोषणा गर्नुहुन्छ; ‘किनकि म बेबिलोनको राजाको जुवा भाँचिदिनेछु।’ ”<verse eid="JER 28:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 28:5"/>तब अगमवक्ता यर्मियाले अगमवक्ता हनन्याहलाई याहवेहको भवनमा उभिरहेका पुजारीहरू र सबै मानिसहरूको सामु जवाफ दिए। <verse eid="JER 28:5"/><verse number="6" style="v" sid="JER 28:6"/>तिनले भने, “आमेन! याहवेहले त्यसै गरून्! याहवेहको भवनका सबै सामग्रीहरू र निर्वासनमा लगिएका सबैलाई बेबिलोनबाट यस ठाउँमा फर्काएर ल्याउने भनेर, तिमीले गरेको अगमवाणीका वचनहरू याहवेहले पूरा गरिदेऊन्। <verse eid="JER 28:6"/><verse number="7" style="v" sid="JER 28:7"/>तापनि सुन, तिमी र सबै मानिसहरूले सुन्‍ने गरी म केही कुरा भन्‍न चाहन्छु सुन: <verse eid="JER 28:7"/><verse number="8" style="v" sid="JER 28:8"/>सुरुदेखि नै तिमी र मभन्दा अगिका अगमवक्ताहरूले धेरै देशहरू र ठूला राज्यहरूको विरुद्धमा लडाइँ, विपत्ति र रूढीको अगमवाणी गर्थे। <verse eid="JER 28:8"/><verse number="9" style="v" sid="JER 28:9"/>तर याहवेहको शान्तिको अगमवाणी गर्ने अगमवक्तालाई साँच्‍चै याहवेहले नै पठाउनुभएको हो भनेर तब मात्र चिनिन्छ, जब त्यसले भनेको अगमवाणीहरू पूरा हुन्छ।”<verse eid="JER 28:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 28:10"/>तब अगमवक्ता हनन्याहले अगमवक्ता यर्मियाको काँधबाट जुवा निकालेर त्यसलाई भाँचिदिए; <verse eid="JER 28:10"/><verse number="11" style="v" sid="JER 28:11"/>अनि तिनले सबै मानिसहरूको सामु भने, “याहवेह यसो भन्‍नुहुन्छ: ‘यसै गरी म दुई वर्षभित्र सबै राष्ट्रहरूका काँधबाट बेबिलोनको राजा नबूकदनेसरको जुवा भाँचिदिनेछु।’ ” त्यसपछि अगमवक्ता यर्मियाचाहिँ आफ्नो बाटो लागे।<verse eid="JER 28:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 28:12"/>अगमवक्ता हनन्याहले अगमवक्ता यर्मियाको काँधबाट जुवा निकालेर भाँचिदिएपछि यर्मियाकहाँ याहवेहको वचन आयो: <verse eid="JER 28:12"/><verse number="13" style="v" sid="JER 28:13"/>“जा, र हनन्याहलाई भन्, ‘याहवेह यसो भन्‍नुहुन्छ: तैँले काठको जुवा भाँचिस्, तर त्यसको ठाउँमा फलामको जुवा पाउनेछस्।’ <verse eid="JER 28:13"/><verse number="14" style="v" sid="JER 28:14"/>सेनाहरूका याहवेह, इस्राएलका परमेश्‍वर यसो भन्‍नुहुन्छ: ‘बेबिलोनको राजा नबूकदनेसरको सेवा गरून् भनेर म यी सबै राष्ट्रहरूका काँधमा फलामको जुवा राखिदिनेछु; अनि तिनीहरूले नबूकदनेसरको सेवा गर्नेछन्। म त्यसलाई जङ्गली जनावरहरूमाथि पनि अधिकार गर्नलाई दिनेछु।’ ”<verse eid="JER 28:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 28:15"/>तब अगमवक्ता यर्मियाले अगमवक्ता हनन्याहलाई भने, “सुन, हनन्याह! याहवेहले तिमीलाई पठाउनुभएको थिएन, तर पनि तिमीले यस राष्ट्रलाई झूटो अगमवाणीका कुराहरूमा विश्‍वास गर्न लगायौ। <verse eid="JER 28:15"/><verse number="16" style="v" sid="JER 28:16"/>यसकारण याहवेह यसो भन्‍नुहुन्छ: ‘म तँलाई पृथ्वीबाट हटाउन लागेको छु। तँ यही वर्ष नै मर्नेछस्; किनभने तैँले याहवेहको विरुद्धमा विद्रोहको प्रचार गरिस्।’ ”<verse eid="JER 28:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 28:17"/>अनि त्यही वर्षको सातौँ महिनामा अगमवक्ता हनन्याहको मृत्यु भयो।<verse eid="JER 28:17"/></para>
  <chapter eid="JER 28"/>
  <chapter number="29" style="c" sid="JER 29"/>
  <para style="s1">निर्वासनमा लगिएकाहरूलाई पत्र</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 29:1"/>नबूकदनेसरले यरूशलेमबाट कैद गरेर बेबिलोनमा लगेका मानिसहरूमध्ये बाँचेका प्रधानहरू, पुजारीहरू, अगमवक्ताहरू र अरू सबै मानिसहरूलाई यरूशलेमबाट यर्मियाले पठाएको पत्रको मूल सन्देश यही हो। <verse eid="JER 29:1"/><verse number="2" style="v" sid="JER 29:2"/>(योचाहिँ राजा यहोयाकीन र राजमाता, यहूदा र यरूशलेमका अदालतका अधिकारीहरू र अगुवाहरू, दक्ष कारिगरहरू र शिल्पकारहरू सबै यरूशलेमबाट निर्वासनमा गइसकेपछि पठाइएको पत्रको कुरा हो)। <verse eid="JER 29:2"/><verse number="3" style="v" sid="JER 29:3"/>तिनले यो पत्र शापानका छोरा एलासा र हिल्कियाहको छोरा गमर्याहलाई जिम्मा दिए, जुन पत्र यहूदाका राजा सिदकियाहले बेबिलोनमा राजा नबूकदनेसरकहाँ पठाएका थिए। त्यस पत्रमा यस्तो लेखिएको थियो:<verse eid="JER 29:3"/></para>
  <para style="pm">
    <verse number="4" style="v" sid="JER 29:4"/>मैले यरूशलेमबाट बेबिलोनमा निर्वासनमा लगेका सबै मानिसहरूलाई, सेनाहरूका याहवेह, इस्राएलका परमेश्‍वर, यसो भन्‍नुहुन्छ: <verse eid="JER 29:4"/><verse number="5" style="v" sid="JER 29:5"/>“तिमीहरू घरहरू बनाओ र बसोबास गर; बगैँचाहरू लगाओ र त्यहाँका उब्जनीहरू खाओ। <verse eid="JER 29:5"/><verse number="6" style="v" sid="JER 29:6"/>विवाह गर र छोराछोरीहरू जन्माओ; तिमीहरूका छोराहरूका निम्ति पत्नीहरू खोजिदेओ र आफ्ना छोरीहरूको विवाह गरिदेओ, र तिनीहरूका पनि छोराछोरीहरू होऊन्। तिमीहरू संख्यामा वृद्धि हुँदैजाओ, तर घटेर नजाओ। <verse eid="JER 29:6"/><verse number="7" style="v" sid="JER 29:7"/>मैले तिमीहरूलाई निर्वासनमा लगेको सहरको शान्ति र उन्‍नतिको निम्ति प्रार्थना गर। त्यस सहरको निम्ति याहवेहसित प्रार्थना गर; किनकि त्यस सहरको उन्‍नति भयो भने तिमीहरूको पनि उन्‍नति हुनेछ।” <verse eid="JER 29:7"/><verse number="8" style="v" sid="JER 29:8"/>हो, सेनाहरूका याहवेह, इस्राएलका परमेश्‍वर यसो भन्‍नुहुन्छ: “तिमीहरूका बीचमा भएका अगमवक्ताहरू र जोखना हेर्नेहरूले तिमीहरूलाई धोका नदेऊन्। तिमीहरूले देखेका सपनाहरूमा ध्यान नदेओ। <verse eid="JER 29:8"/><verse number="9" style="v" sid="JER 29:9"/>तिनीहरूले मेरो नाममा तिमीहरूलाई झूटो अगमवाणी गरिरहेका छन्। मैले तिनीहरूलाई पठाएको होइनँ,” याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 29:9"/></para>
  <para style="pm">
    <verse number="10" style="v" sid="JER 29:10"/>याहवेह यसो भन्‍नुहुन्छ: “जब बेबिलोनको निम्ति सत्तरी वर्ष पूरा हुन्छ, तब म तिमीहरूकहाँ आउनेछु र तिमीहरूलाई यस ठाउँमा फर्काएर ल्याउनेछु भनी तिमीहरूसँग गरेको मेरो असल प्रतिज्ञा पूरा गर्नेछु।” <verse eid="JER 29:10"/><verse number="11" style="v" sid="JER 29:11"/>किनकि जुन योजनाहरू मैले तिमीहरूको निम्ति बनाएको छु, ती म जान्दछु, याहवेह घोषणा गर्नुहुन्छ। “ती योजनाहरू तिमीहरूका उन्‍नतिका निम्ति हुन्, तिमीहरूको नोक्सानीको निम्ति होइनन्। तिमीहरूले आशा गरेअनुसारको असल भविष्य दिनलाई हो। <verse eid="JER 29:11"/><verse number="12" style="v" sid="JER 29:12"/>तब तिमीहरू मकहाँ आउनेछौ र प्रार्थना गर्नेछौ; अनि म तिमीहरूको कुरा सुन्‍नेछु। <verse eid="JER 29:12"/><verse number="13" style="v" sid="JER 29:13"/>जब तिमीहरूले मलाई आफ्नो सम्पूर्ण हृदयले खोज्नेछौ, तब तिमीहरूले मलाई भेट्टाउनेछौ।” <verse eid="JER 29:13"/><verse number="14" style="v" sid="JER 29:14"/>“मलाई तिमीहरूले भेट्टाउनेछौ, याहवेह घोषणा गर्नुहुन्छ; अनि म तिमीहरूलाई कैदबाट फर्काइल्याउनेछु। तिमीहरूलाई मैले धपाएर पठाएका सबै राष्ट्रहरू र ठाउँहरूबाट भेला गर्नेछु। अनि जुन ठाउँबाट मैले तिमीहरूलाई निर्वासनमा पठाएँ, त्यही ठाउँमा म तिमीहरूलाई फर्काएर ल्याउनेछु,” याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 29:14"/></para>
  <para style="pm">
    <verse number="15" style="v" sid="JER 29:15"/>तिमीहरूले भन्‍नेछौ, “याहवेहले हाम्रा निम्ति बेबिलोनमा अगमवक्ताहरू खडा गर्नुभएको छ,” <verse eid="JER 29:15"/><verse number="16" style="v" sid="JER 29:16"/>तर दावीदको सिंहासनमा विराजमान हुनुहुने राजा र यस सहरमा बाँकी रहेका सबै मानिसहरूको विषयमा, अर्थात् तिमीहरूका देशवासीहरू, जो तिमीहरूसित निर्वासनमा गएनन्, तिनीहरूको बारेमा याहवेह यसो भन्‍नुहुन्छ— <verse eid="JER 29:16"/><verse number="17" style="v" sid="JER 29:17"/>हेर, सेनाहरूका याहवेह भन्‍नुहुन्छ: “म तिनीहरूको विरुद्धमा तरवार, अनिकाल र रूढी पठाउनेछु; अनि म तिनीहरूलाई खानै नसकिने गरी कुहिएको नेभारा जस्तै बनाउनेछु। <verse eid="JER 29:17"/><verse number="18" style="v" sid="JER 29:18"/>म तिनीहरूलाई तरवार, अनिकाल र रूढीले खेद्नेछु। म तिनीहरूलाई पृथ्वीका सबै राज्यहरूका निम्ति अति घृणाको पात्र बनाउनेछु। मैले तिनीहरूलाई धपाएका सबै राष्ट्रहरूको बीचमा श्राप, त्रास, हाँसो र निन्दाको पात्र बनाउनेछु।” <verse eid="JER 29:18"/><verse number="19" style="v" sid="JER 29:19"/>“किनकि तिनीहरूले मेरा वचन सुनेनन्, याहवेह घोषणा गर्नुहुन्छ, अर्थात् मैले बारम्बार मेरा सेवक अगमवक्ताहरूद्वारा तिनीहरूकहाँ पठाएका वचनहरू तिमी निर्वासनमा गएकाहरूले पनि सुनेका छैनौ,” याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 29:19"/></para>
  <para style="pm">
    <verse number="20" style="v" sid="JER 29:20"/>यसकारण मैले यरूशलेमबाट बेबिलोनको कैदमा पठाएका सबै मानिसहरू हो, याहवेहको वचन सुन। <verse eid="JER 29:20"/><verse number="21" style="v" sid="JER 29:21"/>मेरो नाममा झूटो अगमवाणी गर्ने कोलायाहको छोरा आहाब र मासेयाहको छोरा सिदकियाहको बारेमा सेनाहरूका याहवेह, इस्राएलका परमेश्‍वर यसो भन्‍नुहुन्छ: “म तिनीहरूलाई बेबिलोनको राजा नबूकदनेसरको हातमा सुम्पिदिनेछु; अनि त्यसले तिनीहरूलाई तिमीहरूका आँखाकै सामु मार्नेछ।” <verse eid="JER 29:21"/><verse number="22" style="v" sid="JER 29:22"/>तिनीहरूको कारण बेबिलोनमा भएका यहूदाका कैदीहरू सबैले यसरी श्राप प्रयोग गरेर भन्‍नेछन्: “याहवेहले तिमीहरूलाई सिदकियाह र आहाबलाई गरेजस्तै गरून्, जसलाई बेबिलोनका राजाले आगोमा जलाएका थिए।” <verse eid="JER 29:22"/><verse number="23" style="v" sid="JER 29:23"/>“किनकि तिनीहरूले इस्राएलमा अति घृणित पापहरू गरेका छन्; तिनीहरूले आफ्ना छिमेकीका पत्नीहरूसित व्यभिचार गरेका छन्; अनि मेरो नाममा तिनीहरूले झूटा अगमवाणीहरू गरेका छन्—जुन कुरा गर्नु भनी मैले तिनीहरूलाई आज्ञा गरेको थिइनँ। म यो कुरा जान्दछु र म नै यस कुराको गवाही हुँ,” याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 29:23"/></para>
  <para style="s1">शमायाहलाई सन्देश</para>
  <para style="p">
    <verse number="24" style="v" sid="JER 29:24"/>नहेलामवासी शमायाहलाई यसो भन्, <verse eid="JER 29:24"/><verse number="25" style="v" sid="JER 29:25"/>“सेनाहरूका याहवेह, इस्राएलका परमेश्‍वर यसो भन्‍नुहुन्छ: तैँले यरूशलेमका सबै मानिसहरूलाई, मासेयाहको छोरा पुजारी सपन्याहलाई र अरू सबै पुजारीहरूलाई आफ्नै नाममा पत्रहरू पठाइस्। तैँले सपन्याहलाई भनिस्, <verse eid="JER 29:25"/><verse number="26" style="v" sid="JER 29:26"/>‘याहवेहले तिमीलाई यहोयादाको ठाउँमा याहवेहको भवनको जिम्मेवार पुजारी नियुक्त गर्नुभएको छ। तिमीले त्यहाँ अगमवाणीको नक्‍कल गर्ने जुनसुकै बौलाहाजस्तो अगमवक्तालाई ठिँगुरोमा हाल्नू र त्यसको घिच्रोमा फलामको साङ्लाले बाँधेर राख्नू। <verse eid="JER 29:26"/><verse number="27" style="v" sid="JER 29:27"/>यसकारण अब तिमीहरूले किन अनातोतको यर्मियालाई हप्काएका छैनौ, जसले तिमीहरूबीच अगमवाणी गरेजस्तो नक्‍कल गर्छ? <verse eid="JER 29:27"/><verse number="28" style="v" sid="JER 29:28"/>त्यसले हामीलाई बेबिलोनमा यो समाचार पठाएको छ: यो कैदको समय लामो हुनेछ: यसकारण तिमीहरूले घरहरू बनाओ र बसोबास गर; बगैँचा लगाओ र त्यसका उब्जनीहरू खाओ।’ ”<verse eid="JER 29:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JER 29:29"/>पुजारी सपन्याहले त्यो पत्र पढेर यर्मिया अगमवक्तालाई सुनाए। <verse eid="JER 29:29"/><verse number="30" style="v" sid="JER 29:30"/>तब याहवेहको वचन यर्मियाकहाँ आयो: <verse eid="JER 29:30"/><verse number="31" style="v" sid="JER 29:31"/>“यो सन्देश निर्वासनमा भएका सबै मानिसहरूकहाँ पठा: ‘नहेलामवासी शमायाहको बारेमा याहवेह यसो भन्‍नुहुन्छ: मैले शमायाहलाई नपठाए तापनि त्यसले तिमीहरूलाई अगमवाणी गरेर र तिमीहरूलाई झूटो कुरामा विश्‍वास गर्न लगायो, <verse eid="JER 29:31"/><verse number="32" style="v" sid="JER 29:32"/>यसकारण याहवेह यसो भन्‍नुहुन्छ, म नहेलामवासी शमायाह र त्यसका सन्तानलाई निश्‍चय नै दण्ड दिनेछु। यस जातिहरूको बीचमा त्यसको एक जना सन्तान पनि छोडिनेछैन, न त मैले आफ्नो जातिलाई गर्ने असल कुराहरू त्यसले देख्नेछ, याहवेह घोषणा गर्नुहुन्छ: किनभने त्यसले मेरो विरुद्धमा विद्रोह गर्न सिकाएको छ।’ ”<verse eid="JER 29:32"/></para>
  <chapter eid="JER 29"/>
  <chapter number="30" style="c" sid="JER 30"/>
  <para style="s1">इस्राएलको पुनर्स्थापन</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 30:1"/>यर्मियाकहाँ आएको याहवेहको वचन यही हो: <verse eid="JER 30:1"/><verse number="2" style="v" sid="JER 30:2"/>“याहवेह इस्राएलका परमेश्‍वर यसो भन्‍नुहुन्छ: ‘मैले तँलाई भनेका सबै कुराहरू एउटा पुस्तकमा लेख्। <verse eid="JER 30:2"/><verse number="3" style="v" sid="JER 30:3"/>हेर, दिनहरू आउँदैछन्,’ याहवेह घोषणा गर्नुहुन्छ, ‘जब म मेरो प्रजा इस्राएल र यहूदालाई कैदबाट फर्काएर ल्याउनेछु, तब मैले तिनीहरूका पितापुर्खाहरूलाई अधिकारमा दिएको देशमा तिनीहरूलाई पुनर्स्थापित गर्नेछु,’ याहवेह भन्‍नुहुन्छ।”<verse eid="JER 30:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 30:4"/>इस्राएल र यहूदाको बारेमा याहवेहले भन्‍नुभएको कुराहरू यिनै हुन्: <verse eid="JER 30:4"/><verse number="5" style="v" sid="JER 30:5"/>याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="JER 30:5">“डराएकाहरूका चीत्कार सुनिँदैछ—</para>
  <para style="q2" vid="JER 30:5">त्रासको चीत्कार, शान्तिको होइन।<verse eid="JER 30:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 30:6"/>अहिले सोध र हेर:</para>
  <para style="q2" vid="JER 30:6">के कुनै पुरुषले छोराछोरी जन्माउन सक्छ?</para>
  <para style="q1" vid="JER 30:6">त्यसो भए किन म हरेक बलियो पुरुषले</para>
  <para style="q2" vid="JER 30:6">सुत्केरी व्यथामा परेकी स्त्रीले जस्तै आफ्नो हात आफ्नो पेटमाथि राखेको,</para>
  <para style="q2" vid="JER 30:6">र हरेक अनुहार मरेको जस्तै पहेँलो भएको देख्छु?<verse eid="JER 30:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 30:7"/>हाय! त्यो दिन अति भयानक दिन हुनेछ!</para>
  <para style="q2" vid="JER 30:7">त्यस्तो अरू कुनै दिन पनि हुनेछैन।</para>
  <para style="q1" vid="JER 30:7">त्यो दिन याकोबका निम्ति सङ्कष्‍टको समय हुनेछ;</para>
  <para style="q2" vid="JER 30:7">तर ऊ त्यसबाट बचाइनेछ।<verse eid="JER 30:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="JER 30:8"/>“ ‘त्यस दिन,’ सेनाहरूका याहवेह घोषणा गर्नुहुन्छ,</para>
  <para style="q2" vid="JER 30:8">‘म तिनीहरूका काँधबाट जुवा भाँचिदिनेछु;</para>
  <para style="q1" vid="JER 30:8">अनि तिनीहरूका बन्धन फुकाइदिनेछु;</para>
  <para style="q2" vid="JER 30:8">अब फेरि तिनीहरूलाई विदेशीहरूले कमारा बनाउने छैनन्।<verse eid="JER 30:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 30:9"/>त्यसको सट्टामा तिनीहरूले याहवेह आफ्ना परमेश्‍वरको</para>
  <para style="q2" vid="JER 30:9">र तिनीहरूका राजा दावीदको सेवा गर्नेछन्,</para>
  <para style="q2" vid="JER 30:9">जसलाई म तिनीहरूका निम्ति खडा गर्नेछु।<verse eid="JER 30:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="JER 30:10"/>“ ‘यसकारण हे मेरो सेवक याकोब, नडरा;</para>
  <para style="q2" vid="JER 30:10">हे इस्राएल, हताश नहो,’</para>
  <para style="q2" vid="JER 30:10">याहवेह घोषणा गर्नुहुन्छ।</para>
  <para style="q1" vid="JER 30:10">‘म निश्‍चय नै तँलाई टाढाको ठाउँबाट र</para>
  <para style="q2" vid="JER 30:10">तेरा सन्तानहरूलाई बेबिलोनको कैदबाट बचाउनेछु।</para>
  <para style="q1" vid="JER 30:10">याकोब फेरि शान्ति र सुरक्षामा हुनेछ;</para>
  <para style="q2" vid="JER 30:10">अनि कसैले पनि इस्राएललाई भयभीत पार्न सक्नेछैन।<verse eid="JER 30:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 30:11"/>म तेरो साथमा छु, र तँलाई बचाउनेछु,’</para>
  <para style="q2" vid="JER 30:11">याहवेह घोषणा गर्नुहुन्छ।</para>
  <para style="q1" vid="JER 30:11">‘मैले तँलाई जुन राष्ट्रहरूको बीचमा छरपस्ट पारेँ,</para>
  <para style="q2" vid="JER 30:11">ती राष्ट्रहरूलाई सम्पूर्ण रूपले नाश गरे तापनि</para>
  <para style="q2" vid="JER 30:11">म तँलाईचाहिँ पूर्ण रूपले नाश गर्नेछैनँ।</para>
  <para style="q1" vid="JER 30:11">तर म तँलाई विनादण्ड चाहिँ छोड्नेछैनँ;</para>
  <para style="q2" vid="JER 30:11">म तँलाई न्यायपूर्वक दण्ड दिनेछु।’<verse eid="JER 30:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 30:12"/>“याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="JER 30:12">“ ‘तेरो चोट निको नहुने खालको छ;</para>
  <para style="q2" vid="JER 30:12">तेरो घाउ पीडादायी छ।<verse eid="JER 30:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 30:13"/>तेरो पक्षमा बोलिदिने कोही पनि छैन;</para>
  <para style="q2" vid="JER 30:13">तेरो घाउको निम्ति कुनै उपचार छैन;</para>
  <para style="q2" vid="JER 30:13">अनि तेरो निम्ति कुनै चङ्गाइ छैन।<verse eid="JER 30:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 30:14"/>तेरा सबै मित्रहरूले तँलाई बिर्सेका छन्;</para>
  <para style="q2" vid="JER 30:14">तिनीहरूले तेरो कुनै वास्ता गर्दैनन्।</para>
  <para style="q1" vid="JER 30:14">मैले तँलाई शत्रुले झैँ प्रहार गरेको छु;</para>
  <para style="q2" vid="JER 30:14">अनि निष्‍ठुरीले झैँ तँलाई दण्ड दिएको छु;</para>
  <para style="q1" vid="JER 30:14">किनकि तेरो अपराध अति ठूलो</para>
  <para style="q2" vid="JER 30:14">र तेरा पापहरू अति धेरै छन्।<verse eid="JER 30:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 30:15"/>तँ आफ्नो घाउले गर्दा</para>
  <para style="q2" vid="JER 30:15">र तेरो निको नहुने पीडाको निम्ति किन रुन्छस्?</para>
  <para style="q1" vid="JER 30:15">तेरो ठूलो अपराध र धेरै पापहरूका कारण</para>
  <para style="q2" vid="JER 30:15">मैले तँसँग यी कुराहरू गरेको हुँ।<verse eid="JER 30:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="JER 30:16"/>“ ‘तर तँलाई निल्नेहरू सबै अरूद्वारा निलिनेछन्;</para>
  <para style="q2" vid="JER 30:16">तेरा सबै शत्रुहरू निर्वासनमा जानेछन्।</para>
  <para style="q1" vid="JER 30:16">तँलाई लुट्नेहरू अरूद्वारा लुटिनेछन्;</para>
  <para style="q2" vid="JER 30:16">तँलाई बिगार्नेहरूलाई म बिगारिदिनेछु।<verse eid="JER 30:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 30:17"/>तर म तँलाई फेरि स्वस्थ तुल्याउनेछु,</para>
  <para style="q2" vid="JER 30:17">र तेरा घाउहरू निको पार्नेछु,’ याहवेह घोषणा गर्नुहुन्छ;</para>
  <para style="q1" vid="JER 30:17">‘किनकि तँलाई बहिष्कृत गरिएका भनिनेछ,</para>
  <para style="q2" vid="JER 30:17">सियोन, जसको कसैले वास्ता गर्दैन।’<verse eid="JER 30:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 30:18"/>“याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="JER 30:18">“ ‘हेर, म याकोबको पालको सुख-शान्ति पुनर्स्थापित गर्नेछु,</para>
  <para style="q2" vid="JER 30:18">र त्यसको वासस्थानमाथि दया देखाउनेछु;</para>
  <para style="q1" vid="JER 30:18">त्यो सहर त्यसकै भग्नावशेषमाथि पुनर्निर्माण हुनेछ;</para>
  <para style="q2" vid="JER 30:18">अनि राजमहल पहिलेकै आफ्नै स्थानमा खडा हुनेछ।<verse eid="JER 30:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 30:19"/>तिनीहरूबाट धन्यवादका स्तुतिगान</para>
  <para style="q2" vid="JER 30:19">र आनन्दको सोर निस्कनेछ।</para>
  <para style="q1" vid="JER 30:19">म तिनीहरूका संख्याको वृद्धि गर्नेछु;</para>
  <para style="q2" vid="JER 30:19">अनि तिनीहरू घट्नेछैनन्;</para>
  <para style="q1" vid="JER 30:19">म तिनीहरूलाई आदर दिनेछु;</para>
  <para style="q2" vid="JER 30:19">अनि तिनीहरू अपहेलित हुनेछैनन्।<verse eid="JER 30:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 30:20"/>तिनीहरूका छोराछोरीहरू पहिलेकै जस्तै हुनेछन्;</para>
  <para style="q2" vid="JER 30:20">अनि तिनीहरूको समुदाय मेरो सामु स्थापित गरिनेछ;</para>
  <para style="q2" vid="JER 30:20">तिनीहरूलाई थिचोमिचो गर्ने सबैलाई म दण्ड दिनेछु।<verse eid="JER 30:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 30:21"/>तिनीहरूको अगुवा तिनीहरूकै आफ्नै जातिबाट हुनेछ;</para>
  <para style="q2" vid="JER 30:21">तिनीहरूको शासक तिनीहरूमध्येबाट खडा हुनेछ।</para>
  <para style="q1" vid="JER 30:21">म त्यसलाई मेरो नजिक ल्याउनेछु र त्यो मेरो नजिक आउनेछ;</para>
  <para style="q2" vid="JER 30:21">किनकि आफैँले साहस गरेर</para>
  <para style="q2" vid="JER 30:21">को मेरो नजिक आउनसक्छ र?’</para>
  <para style="q2" vid="JER 30:21">याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 30:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 30:22"/>‘यसरी तिमीहरू मेरो प्रजा हुनेछौ;</para>
  <para style="q2" vid="JER 30:22">अनि म तिमीहरूले सेवा गर्ने परमेश्‍वर हुनेछु।’ ”<verse eid="JER 30:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="JER 30:23"/>हेर, याहवेहको रिस</para>
  <para style="q2" vid="JER 30:23">आँधीबेहरीजस्तै फुटेर निस्कनेछ;</para>
  <para style="q1" vid="JER 30:23">अनि दुष्‍टहरूका टाउकोमाथि</para>
  <para style="q2" vid="JER 30:23">त्यो बतासको भुमरी जोडसित बजारिनेछ।<verse eid="JER 30:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 30:24"/>जबसम्म याहवेहले उहाँको हृदयको उद्देश्यहरू</para>
  <para style="q2" vid="JER 30:24">पूर्ण रूपमा पूरा गर्नुहुन्‍न,</para>
  <para style="q2" vid="JER 30:24">तबसम्म उहाँको भयानक रिस शान्त हुनेछैन।</para>
  <para style="q1" vid="JER 30:24">आउने दिनहरूमा</para>
  <para style="q2" vid="JER 30:24">तिमीहरूले यो कुरा बुझ्नेछौ।<verse eid="JER 30:24"/></para>
  <chapter eid="JER 30"/>
  <chapter number="31" style="c" sid="JER 31"/>
  <para style="p">
    <verse number="1" style="v" sid="JER 31:1"/>याहवेह घोषणा गर्नुहुन्छ, “त्यस बेला म इस्राएलका सबै घरानाहरूका परमेश्‍वर हुनेछु, र तिनीहरू मेरा मानिसहरू हुनेछन्।”<verse eid="JER 31:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JER 31:2"/>याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="JER 31:2">“तरवारबाट बाँचेका मानिसहरूले</para>
  <para style="q2" vid="JER 31:2">मरुभूमिमा निगाह पाउनेछन्;</para>
  <para style="q2" vid="JER 31:2">म इस्राएललाई विश्राम दिनका लागि आउनेछु।”<verse eid="JER 31:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 31:3"/>बितेको समयमा याहवेह हामीकहाँ देखा पर्नुभयो र भन्‍नुभयो:</para>
  <para style="q1" vid="JER 31:3">“अनन्त प्रेमले मैले तँलाई प्रेम गरेको छु;</para>
  <para style="q2" vid="JER 31:3">अचुक कृपाले मैले तँलाई आकर्षित गरेको छु।<verse eid="JER 31:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 31:4"/>म तँलाई फेरि निर्माण गर्नेछु;</para>
  <para style="q2" vid="JER 31:4">अनि हे कन्या इस्राएल, तँ फेरि निर्माण गरिनेछस्।</para>
  <para style="q1" vid="JER 31:4">तँ फेरि आफ्नो खैँजडी लिएर</para>
  <para style="q2" vid="JER 31:4">आनन्दसाथ नाच्दै निक्लनेछस्।<verse eid="JER 31:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 31:5"/>तैँले फेरि सामरियाका डाँडाहरूमा</para>
  <para style="q2" vid="JER 31:5">दाखबारीहरू लगाउनेछस्;</para>
  <para style="q1" vid="JER 31:5">किसानहरूले दाखबारीहरू लगाउनेछन्,</para>
  <para style="q2" vid="JER 31:5">र तिनीहरूले आफ्ना फलहरूबाट आनन्द लिनेछन्।<verse eid="JER 31:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 31:6"/>यस्तो दिन आउनेछ, जब पहरेदारहरू</para>
  <para style="q2" vid="JER 31:6">एफ्राइमका डाँडाहरूमा यसरी कराउनेछन्,</para>
  <para style="q1" vid="JER 31:6">‘आओ, हामी याहवेह हाम्रा परमेश्‍वरकहाँ</para>
  <para style="q2" vid="JER 31:6">सियोनमा जाऔँ।’ ”<verse eid="JER 31:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 31:7"/>याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="JER 31:7">“याकोबका निम्ति आनन्दसाथ गाओ;</para>
  <para style="q2" vid="JER 31:7">राष्ट्रहरूका प्रमुखका निम्ति चर्को सोरले कराओ।</para>
  <para style="q1" vid="JER 31:7">उच्‍च सोरले प्रशंसा गरेर भन,</para>
  <para style="q2" vid="JER 31:7">‘हे याहवेह, तपाईंको जाति</para>
  <para style="q2" vid="JER 31:7">इस्राएलका बाँकी रहेकाहरूलाई बचाउनुहोस्।’<verse eid="JER 31:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 31:8"/>हेर, म तिनीहरूलाई उत्तरको देशबाट यहाँ फर्काएर ल्याउनेछु,</para>
  <para style="q2" vid="JER 31:8">र तिनीहरूलाई पृथ्वीको पल्‍लो छेउबाट एकसाथ भेला गर्नेछु।</para>
  <para style="q1" vid="JER 31:8">तिनीहरूका बीचमा अन्धा र लङ्गडा,</para>
  <para style="q2" vid="JER 31:8">गर्भवती आमाहरू र प्रसुती वेदनामा परेका स्त्रीहरू हुनेछन्;</para>
  <para style="q2" vid="JER 31:8">एउटा विशाल भीड फर्किनेछ।<verse eid="JER 31:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 31:9"/>तिनीहरू रुँदै-रुँदै फर्किआउनेछन्;</para>
  <para style="q2" vid="JER 31:9">मैले तिनीहरूलाई फर्काएर ल्याउँदा तिनीहरूले प्रार्थना गर्नेछन्।</para>
  <para style="q1" vid="JER 31:9">म तिनीहरूलाई पानीको मुहानका छेउबाट डोर्‍याउनेछु;</para>
  <para style="q2" vid="JER 31:9">समतल बाटोबाट, जहाँ तिनीहरूले ठेस खानेछैनन्;</para>
  <para style="q1" vid="JER 31:9">किनकि म इस्राएलका पिता हुँ,</para>
  <para style="q2" vid="JER 31:9">र एफ्राइम मेरो जेठा छोरा हो।<verse eid="JER 31:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="JER 31:10"/>“हे राष्ट्रहरू हो, याहवेहको वचन सुन;</para>
  <para style="q2" vid="JER 31:10">वचनलाई टाढा-टाढाका टापुसम्म घोषणा गर:</para>
  <para style="q1" vid="JER 31:10">‘इस्राएललाई छरपस्ट पार्नुहुनेले तिनीहरूलाई भेला गर्नुहुनेछ,</para>
  <para style="q2" vid="JER 31:10">र उहाँले आफ्नो बगाललाई गोठालोले झैँ हेरचाह गर्नुहुनेछ।’<verse eid="JER 31:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 31:11"/>किनकि याहवेहले याकोबलाई छुटाउनुहुनेछ,</para>
  <para style="q2" vid="JER 31:11">र तिनीहरूभन्दा बलिया शत्रुहरूका हातबाट तिनीहरूलाई मोल तिरेर छुटाउनुहुनेछ।<verse eid="JER 31:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 31:12"/>तिनीहरू आउनेछन् र सियोनका उच्‍च ठाउँहरूमा आनन्दसाथ गाउनेछन्;</para>
  <para style="q2" vid="JER 31:12">याहवेहबाट प्रशस्ततामा तिनीहरू आनन्दित हुनेछन्—</para>
  <para style="q1" vid="JER 31:12">अन्‍न, नयाँ दाखमद्य र जैतुनको तेल,</para>
  <para style="q2" vid="JER 31:12">भेडाबाख्राका पाठापाठी र गाईबस्तुका बाछाबाछीहरूका कारण रमाहट गर्नेछन्।</para>
  <para style="q1" vid="JER 31:12">तिनीहरू पानीले सिँचेको बगैँचाझैँ हुनेछन्,</para>
  <para style="q2" vid="JER 31:12">अनि तिनीहरू फेरि दुःखी हुनेछैनन्।<verse eid="JER 31:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 31:13"/>तब तरुणीहरू, जवानहरू, वृद्धहरू</para>
  <para style="q2" vid="JER 31:13">नाच्नेछन् र आनन्दित हुनेछन्।</para>
  <para style="q1" vid="JER 31:13">म तिनीहरूको शोकलाई आनन्दमा परिणत गरिदिनेछु;</para>
  <para style="q2" vid="JER 31:13">म तिनीहरूको शोकलाई सान्त्वना र आनन्दमा परिणत गरिदिनेछु।<verse eid="JER 31:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 31:14"/>म पुजारीहरूलाई प्रशस्त भोजनले तृप्‍त पारिदिनेछु;</para>
  <para style="q2" vid="JER 31:14">अनि मेरा मानिसहरू मेरो प्रशस्तताले भरिपूर्ण हुनेछन्,”</para>
  <para style="q2" vid="JER 31:14">याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 31:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 31:15"/>याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="JER 31:15">“रामामा एउटा सोर सुनियो,</para>
  <para style="q2" vid="JER 31:15">शोक र घोर विलापको सोर;</para>
  <para style="q1" vid="JER 31:15">राहेल आफ्ना बालबच्‍चाको निम्ति रोइरहेकी,</para>
  <para style="q2" vid="JER 31:15">र तिनले सान्त्वनालाई इन्कार गरेकी छिन्;</para>
  <para style="q2" vid="JER 31:15">किनकि तिनीहरू अब रहेनन्।”<verse eid="JER 31:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 31:16"/>याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="JER 31:16">“तेरो रोदनको सोरलाई</para>
  <para style="q2" vid="JER 31:16">र तेरो आँखाको आँसुलाई रोक्;</para>
  <para style="q1" vid="JER 31:16">किनकि तेरो कामको इनाम पाउनेछेस्,”</para>
  <para style="q2" vid="JER 31:16">याहवेह घोषणा गर्नुहुन्छ।</para>
  <para style="q2" vid="JER 31:16">“तिनीहरू शत्रुको देशबाट फर्कनेछन्।<verse eid="JER 31:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 31:17"/>याहवेह घोषणा गर्नुहुन्छ,</para>
  <para style="q2" vid="JER 31:17">“भविष्यको निम्ति तिमीहरूका सन्तानलाई आशा छ,</para>
  <para style="q2" vid="JER 31:17">तिमीहरूका छोराछोरीहरू तिनीहरूका आफ्नै देशमा फर्कनेछन्।<verse eid="JER 31:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="JER 31:18"/>“वास्तवमै मैले एफ्राइमको विलाप सुनेको छु:</para>
  <para style="q2" vid="JER 31:18">‘तपाईंले नसधाइएको बाछोलाई झैँ मलाई अनुशासन सिकाउनुभयो,</para>
  <para style="q2" vid="JER 31:18">र म अनुशासित भएको छु।</para>
  <para style="q1" vid="JER 31:18">मलाई पुनर्स्थापित गर्नुहोस्, र म फर्कनेछु;</para>
  <para style="q2" vid="JER 31:18">किनकि तपाईं याहवेह नै मेरा परमेश्‍वर हुनुहुन्छ।<verse eid="JER 31:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 31:19"/>म बरालिएर गएपछि</para>
  <para style="q2" vid="JER 31:19">मैले पश्‍चात्ताप गरेँ;</para>
  <para style="q1" vid="JER 31:19">मैले बुझेपछि</para>
  <para style="q2" vid="JER 31:19">मैले आफ्नो छाती पिटेँ।</para>
  <para style="q1" vid="JER 31:19">म लज्जित भएँ, र शिर झुकाएँ;</para>
  <para style="q2" vid="JER 31:19">किनकि मेरो युवावस्थाको अपमान मैले बोकेको थिएँ।’<verse eid="JER 31:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 31:20"/>याहवेह घोषणा गर्नुहुन्छ,</para>
  <para style="q2" vid="JER 31:20">के एफ्राइम मैले मन पराएको बालक,</para>
  <para style="q1" vid="JER 31:20">मेरो प्यारो छोरा होइन र?</para>
  <para style="q2" vid="JER 31:20">मैले त्यसको विरुद्धमा बोले तापनि</para>
  <para style="q1" vid="JER 31:20">म अझै पनि त्यसको याद गर्छु।</para>
  <para style="q2" vid="JER 31:20">यसकारण मेरो हृदय त्यसको निम्ति तड्पिन्छ;</para>
  <para style="q2" vid="JER 31:20">म त्यसलाई निश्‍चय नै दया देखाउनेछु।<verse eid="JER 31:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="JER 31:21"/>“बाटोको निम्ति सङ्केत चिन्हहरू बना;</para>
  <para style="q2" vid="JER 31:21">मार्गदर्शन गर्ने खम्बाहरू खडा गर्।</para>
  <para style="q1" vid="JER 31:21">तैँले हिँड्नलाई छानेको बाटो,</para>
  <para style="q2" vid="JER 31:21">त्यो राजमार्गतिर ध्यान लगा।</para>
  <para style="q1" vid="JER 31:21">हे कन्या इस्राएल, फर्की,</para>
  <para style="q2" vid="JER 31:21">तेरा आफ्नै सहरहरूमा फर्की।<verse eid="JER 31:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 31:22"/>ए अविश्‍वासी छोरी इस्राएल,</para>
  <para style="q2" vid="JER 31:22">तँ कहिलेसम्म बरालिन्छेस्?</para>
  <para style="q1" vid="JER 31:22">याहवेहले पृथ्वीमा एउटा नयाँ कुरा सृष्‍टि गर्नुहुनेछ—</para>
  <para style="q2" vid="JER 31:22">अब स्त्री पुरुषकहाँ फर्किनेछे।”<verse eid="JER 31:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JER 31:23"/>इस्राएलका परमेश्‍वर, सेनाहरूका याहवेह यसो भन्‍नुहुन्छ: “जब म तिनीहरूलाई कैदबाट फर्काएर ल्याउनेछु, तब यहूदाको देश र त्यसका सहरहरूमा भएका मानिसहरूले फेरि यी वचनहरू भन्‍नेछन्: ‘हे समृद्ध यरूशलेम, हे पवित्र पर्वत, याहवेहले तँलाई आशिष् देऊन्।’ <verse eid="JER 31:23"/><verse number="24" style="v" sid="JER 31:24"/>यहूदा र त्यसका सबै सहरहरूमा भएका मानिसहरू, किसानहरू र आफ्ना बगालहरू लिएर यताउता डुलिहिँड्नेहरू सबै एकसाथ बस्‍नेछन्। <verse eid="JER 31:24"/><verse number="25" style="v" sid="JER 31:25"/>थाकेकाहरूलाई म फेरि ताजा बनाउनेछु र मूर्च्छा परेकाहरूलाई तृप्‍त पार्नेछु।”<verse eid="JER 31:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JER 31:26"/>यतिकैमा म बिउँझेँ, र मैले चारैतिर हेरेँ। मेरो निन्द्रा मलाई मिठो लागेको थियो।<verse eid="JER 31:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JER 31:27"/>याहवेह घोषणा गर्नुहुन्छ, “हेर, यस्ता दिनहरू आउँछन्, जब म इस्राएल र यहूदाका मानिसहरूलाई तिनीहरूका सन्तान र पशुहरूका बच्‍चाहरूसमेत वृद्धि गर्नेछु। <verse eid="JER 31:27"/><verse number="28" style="v" sid="JER 31:28"/>जसरी मैले तिनीहरूलाई उखेल्न, च्यातचुत पार्न र फ्याँक्न, विनाश गर्न र विपत्ति ल्याउन नियालेर हेरेँ; त्यसरी नै म तिनीहरूलाई निर्माण गर्न र रोप्नलाई पनि नियालेर हेर्नेछु,” याहवेह घोषणा गर्नुहुन्छ। <verse eid="JER 31:28"/><verse number="29" style="v" sid="JER 31:29"/>“ती दिनहरूमा मानिसहरूले फेरि यसो कहिल्यै भन्‍नेछैनन्,</para>
  <para style="q1" vid="JER 31:29">‘अमिलो अङ्‌गुर खाने आमाबुबा;</para>
  <para style="q2" vid="JER 31:29">अनि दाँत कुँडिने छोराछोरीहरूको।’<verse eid="JER 31:29"/></para>
  <para style="m">
    <verse number="30" style="v" sid="JER 31:30"/>त्यसको सट्टामा, हरेक मानिस उसको आफ्नै पापको कारणले मर्नेछ; जसले अमिलो अङ्‌गुर खान्छ, त्यसकै दाँत कुँडिनेछ।<verse eid="JER 31:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JER 31:31"/>“हेर, यस्ता दिनहरू आउनेछन्,” याहवेह घोषणा गर्नुहुन्छ,</para>
  <para style="q2" vid="JER 31:31">“जब म इस्राएलका मानिसहरू</para>
  <para style="q1" vid="JER 31:31">र यहूदाका मानिसहरूसँग</para>
  <para style="q2" vid="JER 31:31">नयाँ करार स्थापित गर्नेछु।<verse eid="JER 31:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JER 31:32"/>यो त्यो करारजस्तै हुनेछैन,</para>
  <para style="q2" vid="JER 31:32">जुन मैले तिनीहरूका पुर्खाहरूसँग बाँधेँ;</para>
  <para style="q1" vid="JER 31:32">जब मैले तिनीहरूलाई हात समातेर,</para>
  <para style="q2" vid="JER 31:32">इजिप्टबाट डोर्‍याएर ल्याएको थिएँ;</para>
  <para style="q1" vid="JER 31:32">किनकि म तिनीहरूको पति भए तापनि</para>
  <para style="q2" vid="JER 31:32">तिनीहरूले मेरो करार भङ्ग गरे,”</para>
  <para style="q2" vid="JER 31:32">याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 31:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="JER 31:33"/>“त्यसपछि म इस्राएलका मानिसहरूसँग यो करार बाँध्नेछु,”</para>
  <para style="q2" vid="JER 31:33">याहवेह घोषणा गर्नुहुन्छ।</para>
  <para style="q1" vid="JER 31:33">“म आफ्नो व्यवस्था तिनीहरूका मनमा राखिदिनेछु,</para>
  <para style="q2" vid="JER 31:33">र त्यसलाई तिनीहरूका हृदयमा लेखिदिनेछु।</para>
  <para style="q1" vid="JER 31:33">म तिनीहरूका परमेश्‍वर हुनेछु;</para>
  <para style="q2" vid="JER 31:33">र तिनीहरू मेरा मानिसहरू हुनेछन्।<verse eid="JER 31:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="JER 31:34"/>अब उसो कुनै पनि मानिसले आफ्नो छिमेकीलाई</para>
  <para style="q2" vid="JER 31:34">अथवा एक-अर्कालाई, ‘याहवेहलाई चिन,’ भनी सिकाउनेछैन;</para>
  <para style="q1" vid="JER 31:34">किनकि सानादेखि लिएर</para>
  <para style="q2" vid="JER 31:34">ठूलासम्म सबैले मलाई चिन्‍नेछन्,”</para>
  <para style="q2" vid="JER 31:34">याहवेह घोषणा गर्नुहुन्छ।</para>
  <para style="q1" vid="JER 31:34">“किनकि म तिनीहरूका दुष्‍टता क्षमा गरिदिनेछु,</para>
  <para style="q2" vid="JER 31:34">र तिनीहरूका पापहरू फेरि सम्झनेछैनँ।”<verse eid="JER 31:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JER 31:35"/>याहवेह यसो भन्‍नुहुन्छ,</para>
  <para style="q1" vid="JER 31:35">जसले सूर्यलाई</para>
  <para style="q2" vid="JER 31:35">दिउँसो प्रकाश दिन नियुक्त गर्नुहुन्छ,</para>
  <para style="q1" vid="JER 31:35">जसले जुन र ताराहरूलाई</para>
  <para style="q2" vid="JER 31:35">राति चम्कनलाई आदेश दिनुहुन्छ,</para>
  <para style="q1" vid="JER 31:35">जसले समुद्रलाई हल्‍लाउनुहुन्छ,</para>
  <para style="q2" vid="JER 31:35">ताकि छालहरू गर्जून्;</para>
  <para style="q2" vid="JER 31:35">उहाँको नाम सेनाहरूका याहवेह हो:<verse eid="JER 31:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="JER 31:36"/>याहवेह घोषणा गर्नुहुन्छ,</para>
  <para style="q2" vid="JER 31:36">“जसरी मेरो दृष्‍टिबाट यी उर्दीहरू कहिल्यै रद्द हुँदैनन्,</para>
  <para style="q1" vid="JER 31:36">त्यसरी नै इस्राएल मेरो सामु</para>
  <para style="q2" vid="JER 31:36">सधैँभरि एक स्थिर राष्ट्र भई रहनेछ।”<verse eid="JER 31:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JER 31:37"/>याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="JER 31:37">“यदि माथिका आकाशहरू नाप्‍न सकिन्छ,</para>
  <para style="q2" vid="JER 31:37">र मुनि पृथ्वीका जगहरू खोजेर निकाल्न सकिन्छ भने मात्र,</para>
  <para style="q1" vid="JER 31:37">म इस्राएलले गरेका पापहरूको कारण</para>
  <para style="q2" vid="JER 31:37">तिनीहरूका सन्तानहरूलाई इन्कार गर्नेछु,”</para>
  <para style="q2" vid="JER 31:37">याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 31:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="JER 31:38"/>याहवेह घोषणा गर्नुहुन्छ, “यस्ता दिनहरू आउँदैछन्, जब हननेलको धरहरादेखि कुने मूलढोकासम्म यो सहर मेरा निम्ति पुनर्निर्माण हुनेछ। <verse eid="JER 31:38"/><verse number="39" style="v" sid="JER 31:39"/>नाप्‍ने डोरी त्यहाँबाट सीधा गारेबको डाँडामा पुगेर गोआसम्म जानेछ। <verse eid="JER 31:39"/><verse number="40" style="v" sid="JER 31:40"/>समस्त बेँसीमा लासहरू र खरानीहरू फ्याँकिनेछ। अनि यरूशलेमको पूर्वतिरको किद्रोन खोल्सामाथि भएका मृत्युका खेतहरू र घोडे-ढोकासम्म भएका सबै इलाका याहवेहका निम्ति पवित्र हुनेछन्। त्यो सहर फेरि कहिल्यै उखेलिनेछैन, न त भत्काइनेछ।”<verse eid="JER 31:40"/></para>
  <chapter eid="JER 31"/>
  <chapter number="32" style="c" sid="JER 32"/>
  <para style="s1">यर्मियाले एउटा खेत किनेका</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 32:1"/>यहूदाका राजा सिदकियाहको शासनकालको दशौँ वर्षमा, अर्थात् नबूकदनेसरको शासनकालको अठारौँ वर्षमा याहवेहको यो वचन यर्मियाकहाँ आयो। <verse eid="JER 32:1"/><verse number="2" style="v" sid="JER 32:2"/>त्यस बेला बेबिलोनका राजाका सेनाहरूले यरूशलेमलाई घेरिराखेका थिए। अनि यर्मिया अगमवक्तालाई चाहिँ यहूदाको राजकीय महलको पहरेदार चोकमा कैदमा राखिएको थियो।<verse eid="JER 32:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 32:3"/>यहूदाका राजा सिदकियाहले तिनलाई यसो भनेर त्यहाँ कैद गरेका थिए, “तैँले किन अगमवाणी गर्छस् र यसरी भन्छस्? याहवेह यसो भन्‍नुहुन्छ: ‘मैले यस सहरलाई बेबिलोनको राजाको हातमा सुम्पिदिन लागेको छु र त्यसले यसलाई कब्जा गर्नेछ। <verse eid="JER 32:3"/><verse number="4" style="v" sid="JER 32:4"/>यहूदाका राजा सिदकियाह बेबिलोनीहरूबाट<note caller="+" style="f"><char style="fr" closed="false">32:4 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">कल्दीहरू</char></note> उम्कनेछैन, तर निश्‍चय नै बेबिलोनको राजाको हातमा सुम्पिइनेछ। अनि बेबिलोनको राजासँग आफ्नै आँखाले आमने-सामने हेरेर कुरा गर्नेछ। <verse eid="JER 32:4"/><verse number="5" style="v" sid="JER 32:5"/>बेबिलोनको राजाले सिदकियाहलाई बेबिलोनमा लैजानेछ, जहाँ सिदकियाहलाई मैले उसको मामिलामा विचार नगरेसम्म ऊ त्यहीँ हुनेछ, याहवेह घोषणा गर्नुहुन्छ। यदि तिमीहरूले बेबिलोनीहरूको विरुद्धमा लडाइँ गर्‍यौ भने तिमीहरू सफल हुनेछैनौ भनेर तँ किन यसो भन्छस्।’ ”<verse eid="JER 32:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 32:6"/>तब यर्मियाले भने, “याहवेहको वचन मकहाँ आयो: <verse eid="JER 32:6"/><verse number="7" style="v" sid="JER 32:7"/>तेरा काका शल्‍लूमको छोरा हनमेल यसो भन्दै तँकहाँ भेट्न आउन लागेको छ, ‘बेन्यामीनको प्रान्तको अनातोतमा भएको मेरो जमिन किन्‍नुहोस्; किनकि तपाईं नजिकको नातेदार हुनुभएको कारण जमिन किन्‍ने अधिकार र कर्तव्य तपाईंको हो।’<verse eid="JER 32:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 32:8"/>“तब याहवेहले भन्‍नुभएझैँ मेरो भाइ हनमेल पहरेदारको चोकमा मकहाँ आएर मलाई भन्यो, ‘बेन्यामीनको प्रान्तको अनातोतमा भएको मेरो जमिन किन्‍नुहोस्। किनकि यस जमिनलाई मूल्य चुकाएर छुटाउने र अधिकार गर्ने हक तपाईंकै छ। यसकारण जमिनलाई तपाईंले नै किन्‍नुहोस्।’</para>
  <para style="p" vid="JER 32:8">“यो याहवेहको वचन हो भनी म जान्दछु; <verse eid="JER 32:8"/><verse number="9" style="v" sid="JER 32:9"/>यसकारण मैले आफ्नो भाइ हनमेलबाट अनातोतमा भएको त्यो जमिन किनेँ, र सत्र शेकेल चाँदी<note caller="+" style="f"><char style="fr" closed="false">32:9 </char><char style="ft" closed="false">लगभग 200 ग्राम</char></note> जोखेर त्यसलाई दिएँ। <verse eid="JER 32:9"/><verse number="10" style="v" sid="JER 32:10"/>मैले त्यस जमिनको तमसुकमा सही गरेर छाप लगाएँ। मैले साक्षीहरू राखेँ, र तराजुमा त्यो चाँदी जोखिदिएँ। <verse eid="JER 32:10"/><verse number="11" style="v" sid="JER 32:11"/>मैले जमिन किनेको तमसुक, अर्थात् शर्तहरू सहितको सहीछाप लगाइएको तमसुकको साथमा छाप नलगाइएको प्रतिलिपी पनि लिएँ। <verse eid="JER 32:11"/><verse number="12" style="v" sid="JER 32:12"/>अनि आफ्नो भाइ हनमेलको उपस्थिति र त्यस तमसुकमा सही गर्ने साक्षीहरू र पहरेदार चोकमा बसिरहेका सबै यहूदीहरूको उपस्थितिमा त्यस तमसुकलाई महसेयाहको नाति, नेरियाहको छोरा बारूकलाई दिएँ।<verse eid="JER 32:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 32:13"/>“ती मानिसहरूकै उपस्थितिमा मैले बारूकलाई यी आदेशहरू दिएँ: <verse eid="JER 32:13"/><verse number="14" style="v" sid="JER 32:14"/>‘सेनाहरूका याहवेह, इस्राएलका परमेश्‍वर यसो भन्‍नुहुन्छ: सहीछाप लगाइएको र नलगाइएको यी दुवै प्रतिलिपिहरू लिएर लामो समयसम्म सुरक्षित रहून् भनेर यिनीहरूलाई माटोको भाँडोमा राख्नू। <verse eid="JER 32:14"/><verse number="15" style="v" sid="JER 32:15"/>किनकि सेनाहरूका याहवेह, इस्राएलका परमेश्‍वर यसो भन्‍नुहुन्छ: यस देशमा फेरि घरहरू, जमिनहरू र दाखबारीहरू किनबेच गरिनेछन्।’<verse eid="JER 32:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 32:16"/>“मैले नेरियाहको छोरा बारूकलाई किनबेचको तमसुक दिइसकेपछि मैले याहवेहसँग प्रार्थना गरेँ:<verse eid="JER 32:16"/></para>
  <para style="pm">
    <verse number="17" style="v" sid="JER 32:17"/>“हे प्रभु याहवेह, तपाईंले आफ्नो महाशक्ति र बाहुबलले आकाश र पृथ्वीलाई बनाउनुभयो। तपाईंका निम्ति कुनै कुरा पनि कठिन छैन। <verse eid="JER 32:17"/><verse number="18" style="v" sid="JER 32:18"/>तपाईंले हजारौँ मानिसहरूमाथि प्रेम देखाउनुहुन्छ, तर बुबाआमाको अपराधहरूका दण्ड तिनीहरूपछि तिनीहरूका सन्तानहरूलाई दिनुहुन्छ। हे महान् र शक्तिशाली परमेश्‍वर, जसको नाम सेनाहरूका याहवेह हो; <verse eid="JER 32:18"/><verse number="19" style="v" sid="JER 32:19"/>तपाईंका उद्देश्यहरू महान् र तपाईंका कामहरू शक्तिशाली छन्। तपाईंका आँखा सबै मानव-जातिका चालहरूमाथि खुल्‍ला रहन्छन्; तपाईंले हरेक मानिसलाई तिनीहरूका चालहरू र तिनीहरूका कामअनुसारको इनाम दिनुहुन्छ। <verse eid="JER 32:19"/><verse number="20" style="v" sid="JER 32:20"/>तपाईंले इजिप्टमा अलौकिक चिन्हहरू र अद्‌भुत कार्यहरू गर्नुभयो। आजको दिनसम्म इस्राएल र सबै मानव-जाति दुवैका बीचमा ती प्रकट गरिरहनुभएको छ। अनि तपाईंले ख्याति प्राप्‍त गर्नुभएको छ, जुन आजको दिनसम्म पनि तपाईंकै हो। <verse eid="JER 32:20"/><verse number="21" style="v" sid="JER 32:21"/>तपाईंले आफ्नो जाति इस्राएललाई अलौकिक चिन्हहरू र अद्‌भुत कार्यहरूद्वारा तपाईंको शक्तिशाली हात र बाहुबलको ठूलो त्राससहित इजिप्टबाट निकालेर ल्याउनुभयो। <verse eid="JER 32:21"/><verse number="22" style="v" sid="JER 32:22"/>तपाईंले तिनीहरूका पितापुर्खाहरूसँग शपथ खाएर दिन्छु भनेर प्रतिज्ञा गर्नुभएको यो देश, जुन दूध र मह बग्ने देश हो, तिनीहरूलाई दिनुभयो। <verse eid="JER 32:22"/><verse number="23" style="v" sid="JER 32:23"/>इस्राएलीहरू देशभित्र आए, र देशलाई अधिकार गरे; तर तिनीहरूले तपाईं र तपाईंका आज्ञाहरू पालन गरेनन्। तपाईंले तिनीहरूलाई पालन गर्नू भनेर दिनुभएको आज्ञा तिनीहरूले पालन गरेनन्। यसैकारण तपाईंले तिनीहरूमाथि यी सबै विपत्तिहरू ल्याउनुभयो।<verse eid="JER 32:23"/></para>
  <para style="pm">
    <verse number="24" style="v" sid="JER 32:24"/>“हेर्नुहोस्, यस सहरलाई कब्जा गर्नलाई बेबिलोनीहरूले घेरा हाल्न कसरी मोर्चा बनाएका छन्। किनकि तरवार, अनिकाल र रूढीको कारणले यो सहर बेबिलोनीहरूको हातमा सुम्पिइनेछ, जसले यस सहरमाथि आक्रमण गरिरहेका छन्। तपाईंले जे भन्‍नुभयो, त्यो पूरा भइरहेको छ, जस्तो अहिले तपाईंले देख्दैहुनुहुन्छ। <verse eid="JER 32:24"/><verse number="25" style="v" sid="JER 32:25"/>अनि यो सहर यरूशलेमलाई बेबिलोनीहरूको हातमा सुम्पिने भए तापनि हे प्रभु याहवेह, तपाईंले मलाई भन्‍नुहुन्छ, ‘यस जमिनलाई चाँदीले किन र किनबेच गरिएको साक्षी राख।’ ”<verse eid="JER 32:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JER 32:26"/>तब याहवेहको वचन यर्मियाकहाँ आयो: <verse eid="JER 32:26"/><verse number="27" style="v" sid="JER 32:27"/>“म याहवेह सबै मानव-जातिका परमेश्‍वर हुँ। के मेरो निम्ति कुनै कुरा कठिन छ र? <verse eid="JER 32:27"/><verse number="28" style="v" sid="JER 32:28"/>यसकारण याहवेह यसो भन्‍नुहुन्छ: म यस सहरलाई बेबिलोनीहरू र बेबिलोनको राजा नबूकदनेसरको हातमा सुम्पिदिन लागेको छु, जसले यस सहरलाई कब्जा गर्नेछ। <verse eid="JER 32:28"/><verse number="29" style="v" sid="JER 32:29"/>यस सहरलाई आक्रमण गरिरहेका बेबिलोनीहरू सहरभित्र आउनेछन्, र यस सहरलाई आगो लगाइदिनेछन्। बाल देवताका छानाहरूमा धूप बालेर अरू देवताहरूलाई अर्घबलि चढाएर मलाई रिस उठाउने मानिसहरू बसेका घरहरूको साथमा यस सहरलाई पनि जलाइदिनेछन्।<verse eid="JER 32:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JER 32:30"/>“इस्राएल र यहूदाका मानिसहरूले तिनीहरूका जवानी अवस्थादेखि नै दुष्‍ट कामहरूबाहेक अरू केही पनि गरेका छैनन्। साँच्‍चै इस्राएलका मानिसहरूले तिनीहरूका हातले बनाएका मूर्तिहरूद्वारा मलाई रिस उठाउने कामबाहेक अरू केही गरेका छैनन्, याहवेह घोषणा गर्नुहुन्छ। <verse eid="JER 32:30"/><verse number="31" style="v" sid="JER 32:31"/>यो यरूशलेमको सहर बनिएको दिनदेखि आजको दिनसम्म यस सहरका मानिसहरूले मलाई रिस उठाएर क्रोधित तुल्याएका छन्। यसकारण मैले यस सहरलाई आफ्नो दृष्‍टिबाट हटाइदिनैपर्छ। <verse eid="JER 32:31"/><verse number="32" style="v" sid="JER 32:32"/>इस्राएल र यहूदाका मानिसहरू, तिनीहरू, तिनीहरूका राजाहरू र अधिकारीहरू, तिनीहरूका पुजारीहरू र अगमवक्ताहरू, यहूदाका मानिसहरू र यरूशलेमका मानिसहरूले सबै दुष्‍ट कामहरू गरेर मलाई क्रोधित तुल्याएका छन्। <verse eid="JER 32:32"/><verse number="33" style="v" sid="JER 32:33"/>तिनीहरूले मतिर तिनीहरूका अनुहार होइन, तर तिनीहरूका पीठ फर्काएका छन्; मैले तिनीहरूलाई घरी-घरी सिकाए तापनि तिनीहरूले सुनेनन् र अनुशासनलाई ग्रहण गरेनन्। <verse eid="JER 32:33"/><verse number="34" style="v" sid="JER 32:34"/>तिनीहरूले मेरो नाम बोकेको परमेश्‍वरको भवनमा तिनीहरूका घिनलाग्दा मूर्तिहरू खडा गरे र भवनलाई अपवित्र पारे। <verse eid="JER 32:34"/><verse number="35" style="v" sid="JER 32:35"/>तिनीहरूले आफ्ना छोराछोरीहरूलाई मोलेख देवतालाई बलिदान चढाउनलाई बेन-हिन्‍नोमको खोल्सामा बालको निम्ति अग्ला ठाउँ वा देवस्थानहरू बनाए। तिनीहरूले यस्ता घिनलाग्दा पापहरू गर्न, न त मैले तिनीहरूलाई कहिल्यै आज्ञा गरेको थिएँ, न त यस्तो कुरा मेरो मनमा नै थियो।<verse eid="JER 32:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JER 32:36"/>“तिमीहरू यस सहरको विषयमा यसरी भन्दैछौ, ‘तरवार, अनिकाल र रूढीद्वारा यो सहर बेबिलोनका राजाको हातमा दिइनेछ’; तर याहवेह, इस्राएलका परमेश्‍वर यसो भन्‍नुहुन्छ: <verse eid="JER 32:36"/><verse number="37" style="v" sid="JER 32:37"/>निश्‍चय नै म तिनीहरूलाई सबै देशहरूबाट जम्मा गर्नेछु, जहाँ मैले आफ्नो रिस र प्रचण्ड क्रोधमा तिनीहरूलाई धपाइदिएको थिएँ। म तिनीहरूलाई यस भूमिमा फर्काएर ल्याउनेछु र तिनीहरूलाई सुरक्षित भएर बस्‍न दिनेछु। <verse eid="JER 32:37"/><verse number="38" style="v" sid="JER 32:38"/>तिनीहरू मेरा मानिसहरू हुनेछन्, र म तिनीहरूका परमेश्‍वर हुनेछु। <verse eid="JER 32:38"/><verse number="39" style="v" sid="JER 32:39"/>म तिनीहरूलाई एउटै हृदय र एउटै उद्देश्य दिनेछु, ताकि तिनीहरूले आफ्ना र तिनीहरूका सन्तानको भलाइका निम्ति सधैँ मेरो डर मान्‍नेछन्। <verse eid="JER 32:39"/><verse number="40" style="v" sid="JER 32:40"/>म तिनीहरूसँग अनन्तको करार बाँध्नेछु। म तिनीहरूको भलाइ गर्न कहिल्यै छोड्नेछैनँ। अनि म तिनीहरूलाई मप्रति डर मान्‍ने बनाउनेछु। यसकारण तिनीहरू मबाट कहिल्यै तर्केर टाढा जानेछैनन्। <verse eid="JER 32:40"/><verse number="41" style="v" sid="JER 32:41"/>तिनीहरूको भलाइ गर्दा म आनन्दित हुनेछु; अनि मेरो सारा हृदयले र सारा प्राणले तिनीहरूलाई यस देशमा निश्‍चय नै स्थायी रूपमा स्थापित गर्नेछु।<verse eid="JER 32:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="JER 32:42"/>“याहवेह यसो भन्‍नुहुन्छ: जसरी मैले यस जातिमाथि यी सबै विपत्ति ल्याएको छु, त्यसरी नै मैले तिनीहरूलाई प्रतिज्ञा गरेका सबै असल थोकहरू म तिनीहरूलाई दिनेछु। <verse eid="JER 32:42"/><verse number="43" style="v" sid="JER 32:43"/>जुन देशको बारेमा तिमीहरू यसो भन्छौ, ‘यो त उजाड र काम नलाग्ने, मानिसहरू र पशुहरू केही नभएको उजाड भूमिजस्तो छ; किनकि यो देश बेबिलोनीहरूका हातमा दिइएको छ, तर यस देशमा फेरि जमिनहरू किनिनेछन्।’ <verse eid="JER 32:43"/><verse number="44" style="v" sid="JER 32:44"/>चाँदीको लागि जमिनहरू किनिनेछन्, र बेन्यामीनको इलाकामा, यरूशलेमका वरिपरिका गाउँहरूमा, यहूदाका सहरहरूमा, पश्‍चिमी पहाडको फेद र दक्षिणतिरको पहाडी इलाकाका सहरहरूमा किनबेचको तमसुकहरूमा हस्ताक्षर गरिनेछन्। सहीछाप लाएर तमसुकहरू साक्षीका निम्ति राखिनेछन्; किनकि म तिनीहरूको सुख-शान्ति फेरि फर्काइदिनेछु,<note caller="+" style="f"><char style="fr" closed="false">32:44 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">बेबिलोनको कैदबाट फर्काइल्याउनेछु।</char></note> याहवेह घोषणा गर्नुहुन्छ।”<verse eid="JER 32:44"/></para>
  <chapter eid="JER 32"/>
  <chapter number="33" style="c" sid="JER 33"/>
  <para style="s1">पुनर्स्थापनाको प्रतिज्ञा</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 33:1"/>यर्मिया पहरेदार चोकमा थुनिएको बेलामा याहवेहको वचन दोस्रो पल्ट तिनीकहाँ आयो: <verse eid="JER 33:1"/><verse number="2" style="v" sid="JER 33:2"/>“याहवेह यसो भन्‍नुहुन्छ, उहाँ, जसले पृथ्वी बनाउनुभयो, याहवेह जसले पृथ्वीको आकार बनाउनुभयो र पृथ्वीलाई स्थापित गर्नुभयो—उहाँको नाम याहवेह हो: <verse eid="JER 33:2"/><verse number="3" style="v" sid="JER 33:3"/>‘मलाई पुकार् र म तँलाई जवाफ दिनेछु; अनि तैँले नजानेका महान् र गुप्‍त कुराहरू म तँलाई बताउनेछु।’ <verse eid="JER 33:3"/><verse number="4" style="v" sid="JER 33:4"/>किनकि बेबिलोनीहरूको घेराबन्दी र तरवारको विरुद्धमा भएको प्रतिरोधको लडाइँमा भत्काइएका यस सहरका घरहरू र यहूदाका राजकीय महलहरूको बारेमा याहवेह, इस्राएलका परमेश्‍वर यसो भन्‍नुहुन्छ, <verse eid="JER 33:4"/><verse number="5" style="v" sid="JER 33:5"/>बेबिलोनीहरूसँगको लडाइँमा: ‘मैले आफ्नो रिस र क्रोधमा मारेका मानिसहरूका लासहरूले ती भवन र घरहरू भरिनेछन्। यस सहरका सबै दुष्‍टताको कारण म यस सहरबाट आफ्नो अनुहार लुकाउनेछु।<verse eid="JER 33:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 33:6"/>“ ‘तापनि म यस सहरमा फेरि स्वस्थता र चङ्गाइ ल्याउनेछु, र म मेरा मानिसहरूलाई फेरि निको पार्नेछु; अनि तिनीहरूलाई प्रशस्त शान्ति र सुरक्षा उपभोग गर्न दिनेछु। <verse eid="JER 33:6"/><verse number="7" style="v" sid="JER 33:7"/>म यहूदा र इस्राएललाई कैदबाट फर्काएर ल्याउनेछु, र तिनीहरूलाई पहिलेजस्तै फेरि म पुनर्निर्माण गर्नेछु। <verse eid="JER 33:7"/><verse number="8" style="v" sid="JER 33:8"/>तिनीहरूले मेरो विरुद्धमा गरेका सबै अपराधबाट म तिनीहरूलाई शुद्ध पार्नेछु। मेरो विरुद्धमा तिनीहरूले गरेका सबै पाप र विद्रोहहरूलाई क्षमा गर्नेछु। <verse eid="JER 33:8"/><verse number="9" style="v" sid="JER 33:9"/>तब यस यरूशलेम सहरको निम्ति मैले गरेका सबै भलाइका कुराहरू सुनेर यस पृथ्वीका सबै जातिहरूको सामु यस सहरले मलाई ख्याति, आनन्द, प्रशंसा र सम्मान ल्याउनेछ। अनि मैले यस यरूशलेमको निम्ति दिएको प्रशस्त उन्‍नति र शान्तिको कारण मानिसहरू डराएर थरथर काम्नेछन्।’<verse eid="JER 33:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 33:10"/>“याहवेह यसो भन्‍नुहुन्छ: ‘तिमीहरू यस ठाउँको बारेमा भन्दछौ, यो त कुनै मानिस र पशुप्राणीहरू नभएको उजाड ठाउँ हो। यद्यपि यरूशलेमका सडकहरू र यहूदाका सहरहरू, जो कुनै मानिस, कुनै बासिन्दा नभएका र त्यागिएका उजाड छन्, <verse eid="JER 33:10"/><verse number="11" style="v" sid="JER 33:11"/>एक पटक फेरि आनन्द र हर्षको सोर, दुलहा र दुलहीका आवाजहरू; अनि याहवेहको भवनमा धन्यवादको भेटी लिएर आउनेहरूका सोरहरू सुनिनेछन्, जसले यसो भन्‍नेछन्,</para>
  <para style="q1" vid="JER 33:11">“सेनाहरूका याहवेहलाई धन्यवाद चढाओ;</para>
  <para style="q2" vid="JER 33:11">किनकि सेनाहरूका याहवेह भलो हुनुहुन्छ;</para>
  <para style="q2" vid="JER 33:11">उहाँको अचुक प्रेम सदासर्वदा रहिरहन्छ।”</para>
  <para style="m" vid="JER 33:11">किनकि यस देशको सुख-शान्ति फेरि फर्काएर पहिलेको जस्तै म पुनर्निर्माण गरिदिनेछु,’ याहवेह यसो भन्‍नुहुन्छ।<verse eid="JER 33:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 33:12"/>“सेनाहरूका याहवेह यसो भन्‍नुहुन्छ: ‘यो उजाड ठाउँ मानिसहरू र पशुप्राणीहरू नभएको ठाउँमा—यस देशका सबै सहरमा गोठालाहरूका निम्ति तिनीहरूका बगालहरू विश्राम गर्ने खर्कहरू फेरि हुनेछन्। <verse eid="JER 33:12"/><verse number="13" style="v" sid="JER 33:13"/>यहूदाको सहरहरूमा, यरूशलेमका चारैपट्टिका गाउँहरूमा, बेन्यामीनका इलाकामा, पश्‍चिमी पहाडका तराई, बेँसी र दक्षिणका पहाडी इलाकाका सहरहरूमा गोठालाहरूले फेरि भेडाबाख्राहरूका बगालहरू गन्‍नेछन्, याहवेह यसो भन्‍नुहुन्छ।<verse eid="JER 33:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 33:14"/>“ ‘हेर, ती दिनहरू आउँदैछन्, याहवेह घोषणा गर्नुहुन्छ, ‘जब म इस्राएलको घराना र यहूदाको घरानासित मैले गरेका असल प्रतिज्ञाहरू पूरा गर्नेछु।<verse eid="JER 33:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 33:15"/>“ ‘ती दिनहरूमा र त्यस समयमा</para>
  <para style="q2" vid="JER 33:15">म दावीदको वंशबाट एउटा धार्मिकताको हाँगा उमार्नेछु;</para>
  <para style="q2" vid="JER 33:15">त्यसले देशमा जे न्यायसङ्गत र उचित छ, त्यही गर्नेछ।<verse eid="JER 33:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 33:16"/>ती दिनहरूमा यहूदा बचाइनेछ,</para>
  <para style="q2" vid="JER 33:16">र यरूशलेम सुरक्षितसाथ रहनेछ।</para>
  <para style="q1" vid="JER 33:16">तिनलाई यही नामद्वारा बोलाइनेछ:</para>
  <para style="q2" vid="JER 33:16">याहवेह, हाम्रा धार्मिक उद्धारकर्ता।’<verse eid="JER 33:16"/></para>
  <para style="m">
    <verse number="17" style="v" sid="JER 33:17"/>किनकि याहवेह यसो भन्‍नुहुन्छ: ‘इस्राएलको घरानाको सिंहासनमा बस्‍न दावीदलाई कुनै दिन पनि मानिसको अभाव हुनेछैन; <verse eid="JER 33:17"/><verse number="18" style="v" sid="JER 33:18"/>न त लेवी पुजारीहरूले होमबलि चढाउन, अन्‍नबलि जलाउन र बलिदानहरू चढाउन मेरो सामु खडा हुने मानिसको कहिल्यै अभाव हुनेछ।’ ”<verse eid="JER 33:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 33:19"/>याहवेहको वचन यर्मियाकहाँ आयो: <verse eid="JER 33:19"/><verse number="20" style="v" sid="JER 33:20"/>“याहवेह यसो भन्‍नुहुन्छ: ‘यदि तिमीहरूले दिन र रातसँग मेरो करार भङ्ग गर्न सक्यौ, र दिन र रात तिनीहरूको तोकिएको समयमा प्रकट भएनन् भने, <verse eid="JER 33:20"/><verse number="21" style="v" sid="JER 33:21"/>तब मात्र मेरो सेवक दावीदसँगको मेरो करार, लेवीहरू र पुजारीहरू, जो मेरो सामु रहेर सेवा गर्छन्, तिनीहरूसँगको मेरो करार भङ्ग हुन सक्छ; यहाँसम्म कि दावीदको सिंहासनमा शासन गर्नलाई उसको कुनै सन्तान हुनेछैन। <verse eid="JER 33:21"/><verse number="22" style="v" sid="JER 33:22"/>म आफ्नो सेवक दावीद र मेरो सामु सेवा गर्ने लेवीहरूका सन्तानहरूलाई आकाशका गन्‍न नसकिने ताराहरू र समुद्रका किनारमा भएका बालुवा जोखिन नसकिनेजस्तै बढाइदिनेछु।’ ”<verse eid="JER 33:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JER 33:23"/>याहवेहको वचन यर्मियाकहाँ आयो: <verse eid="JER 33:23"/><verse number="24" style="v" sid="JER 33:24"/>“के यी मानिसहरूले ‘याहवेहले आफूले चुन्‍नुभएका दुई राज्य<note caller="+" style="f"><char style="fr" closed="false">33:24 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">परिवारहरू</char></note> यहूदा र इस्राएललाई त्यागिदिनुभएको छ’ भनिरहेको कुरा के तैँले ख्याल गरेको छैनस्? यसकारण ती मानिसहरूले मेरा मानिसहरूलाई घृणा गर्छन् र तिनीहरूलाई एक राष्ट्रको रूपमा ठान्दैनन्। <verse eid="JER 33:24"/><verse number="25" style="v" sid="JER 33:25"/>याहवेह यसो भन्‍नुहुन्छ: ‘यदि मैले दिन र रातसँग आफ्नो करार स्थापित गरेको होइन भने साथै आकाश र पृथ्वीका नियमहरू तोकिदिएको होइन भने, <verse eid="JER 33:25"/><verse number="26" style="v" sid="JER 33:26"/>म याकोब र मेरो सेवक दावीदका सन्तानहरूलाई तिरस्कार गर्नेछु। अनि त्यसको सन्तानको कुनै पनि छोरालाई अब्राहाम, इसहाक र याकोबका सन्तानमाथि शासन गर्नलाई म चुन्‍नेछैनँ। तर म तिनीहरूलाई कैदबाट फर्काएर तिनीहरूको समृद्धि पनि फर्काइदिनेछु र तिनीहरूमाथि दया देखाउनेछु।’ ”<verse eid="JER 33:26"/></para>
  <chapter eid="JER 33"/>
  <chapter number="34" style="c" sid="JER 34"/>
  <para style="s1">सिदकियाहलाई चेताउनी</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 34:1"/>बेबिलोनका राजा नबूकदनेसर र तिनका सबै सेना, आफ्नो शासनको अधीनमा रहेका सबै राज्य र जातिहरूले यरूशलेम र त्यसका वरिपरिका सबै सहरको विरुद्धमा लडाइँ गरिरहेको बेला याहवेहबाट यर्मियाकहाँ यो वचन आयो: <verse eid="JER 34:1"/><verse number="2" style="v" sid="JER 34:2"/>“याहवेह, इस्राएलका परमेश्‍वर यसो भन्‍नुहुन्छ: यहूदाको राजा सिदकियाहकहाँ गएर त्यसलाई भन्, ‘याहवेह यसो भन्‍नुहुन्छ: मैले यस सहरलाई बेबिलोनको राजाको हातमा सुम्पिदिन लागेको छु, र त्यसले यस सहरलाई आगोले भस्म पार्नेछ। <verse eid="JER 34:2"/><verse number="3" style="v" sid="JER 34:3"/>तँ त्यसको हातबाट उम्कनेछैनस्। तँ निश्‍चय नै पक्राउ परेर त्यसको हातमा सुम्पिनेछस्। तैँले बेबिलोनको राजालाई आफ्नै आँखाले देख्नेछस्; अनि त्यसले तँसँग आमने-सामने कुरा गर्नेछ, र तँ बेबिलोनमा जानेछस्।<verse eid="JER 34:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 34:4"/>“ ‘तापनि हे यहूदाका राजा सिदकियाह, याहवेहको प्रतिज्ञा सुन्। तेरो बारेमा याहवेह यसो भन्‍नुहुन्छ: तँ तरवारद्वारा मारिनेछैनस्; <verse eid="JER 34:4"/><verse number="5" style="v" sid="JER 34:5"/>तर तँ शान्तिसित मर्नेछस्। जसरी मानिसहरूले तँभन्दा पहिलेका तेरा पुर्खाहरूका सम्मानका निम्ति अन्तिम संस्कारमा सुगन्धित धूप बालेका थिए, त्यसरी नै तिनीहरूले तेरो सम्मानको निम्ति पनि आगोमा धूप बाल्नेछन् र यसो भनेर विलाप गर्नेछन्, “हाय, हे मालिक!” म आफैँले यो प्रतिज्ञा गर्दछु, याहवेह घोषणा गर्नुहुन्छ।’ ”<verse eid="JER 34:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 34:6"/>तब यर्मिया अगमवक्ताले यरूशलेममा यहूदाका राजा सिदकियाहलाई यी सबै कुरा भने, <verse eid="JER 34:6"/><verse number="7" style="v" sid="JER 34:7"/>जुन बेला बेबिलोनका राजाका सेनाहरू यरूशलेम र यहूदाका बाँकी रहेका अरू सहरहरूलाई जित्न, लाकीश र अजेकाको विरुद्धमा लडाइँ गरिरहेका थिए। यहूदामा रहेका सहरहरूमध्ये पर्खालले घेरिएका यी दुई सहरहरू मात्र बाँकी थिए।<verse eid="JER 34:7"/></para>
  <para style="s1">दासहरूका निम्ति स्वतन्त्रता</para>
  <para style="p">
    <verse number="8" style="v" sid="JER 34:8"/>सिदकियाह राजाले यरूशलेममा बस्‍ने सबै मानिसहरूसँग दासहरूको स्वतन्त्रता घोषणा गरिदिने करार बाँधेपछि याहवेहको वचन यर्मियाकहाँ आयो। <verse eid="JER 34:8"/><verse number="9" style="v" sid="JER 34:9"/>हरेकले आ-आफ्ना हिब्रू दास-दासीलाई स्वतन्त्र गरिदिनुपर्थ्यो। कसैले पनि आफ्ना हिब्रू दाजुभाइहरूलाई बन्धनमा राख्न मिल्दैनथ्यो। <verse eid="JER 34:9"/><verse number="10" style="v" sid="JER 34:10"/>यसकारण यस करारमा सामेल हुने सबै अधिकारी र मानिसहरूले तिनीहरूका दास-दासीहरूलाई स्वतन्त्र गरिदिने र तिनीहरूलाई अब उसो दासत्वमा नराख्ने कुरामा राजी भए। तिनीहरू त्यो करारमा राजी भए र दास-दासीहरूलाई स्वतन्त्र गरिदिए। <verse eid="JER 34:10"/><verse number="11" style="v" sid="JER 34:11"/>तर पछिबाट तिनीहरूले आफ्ना मन बदले र तिनीहरूले स्वतन्त्र गरिदिएका दास-दासीहरूलाई फर्काइल्याएर फेरि दास-दासी बनाए।<verse eid="JER 34:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 34:12"/>तब याहवेहको वचन यर्मियाकहाँ आयो: <verse eid="JER 34:12"/><verse number="13" style="v" sid="JER 34:13"/>“याहवेह, इस्राएलका परमेश्‍वर यसो भन्‍नुहुन्छ: मैले तिमीहरूका पितापुर्खाहरूलाई इजिप्टबाट, अर्थात् दासत्वको देशबाट निकालेर ल्याउँदा तिनीहरूसँग एउटा करार बाँधेको थिएँ। मैले यसो भनेँ, <verse eid="JER 34:13"/><verse number="14" style="v" sid="JER 34:14"/>‘प्रत्येक सातौँ वर्षमा तिमीहरूकहाँ आफैँलाई बेचेका तिमीहरूका हिब्रू कमारा दाजुभाइहरूलाई तिमीहरू हरेकले स्वतन्त्र गरिदिनुपर्छ। तिमीहरूका कमारा कमारीहरूले छ वर्षसम्म तिमीहरूको सेवा गरिसकेपछि तिमीहरूले तिनीहरूलाई स्वतन्त्र गरिदिनैपर्छ।’ तापनि तिमीहरूका पितापुर्खाहरूले मेरा कुरामा ध्यानै दिएनन्, अथवा मेरो आज्ञापालन गरेनन्। <verse eid="JER 34:14"/><verse number="15" style="v" sid="JER 34:15"/>तिमीहरूले भर्खरै पश्‍चात्ताप गर्‍यौ र मेरो दृष्‍टिमा जे उचित छ, त्यही तिमीहरूले गर्‍यौ: तिमीहरू हरेकले आ-आफ्ना दाजुभाइहरूलाई स्वतन्त्रताको घोषणा गर्‍यौ। मेरो नाम बोकेको भवनमा मेरो सामु तिमीहरूले करार पनि बाँधेका थियौ। <verse eid="JER 34:15"/><verse number="16" style="v" sid="JER 34:16"/>तर अब फेरि तिमीहरू पछि हटेर मेरो नाम अशुद्ध पारेका छौ। तिमीहरूले कमारा-कमारीहरूलाई इच्छा लागेको ठाउँमा जान स्वतन्त्र गरिदिएका थियौ, तर अब फेरि तिमीहरू हरेकले तिनीहरूलाई फर्काएर ल्यायौ। तिमीहरूले तिनीहरूलाई आफ्ना कमारा-कमारी हुनलाई फेरि बाध्य बनायौ।<verse eid="JER 34:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 34:17"/>“यसकारण याहवेह यसो भन्‍नुहुन्छ: तिमीहरूले मेरो आज्ञापालन गरेनौ; तिमीहरूले आफ्ना दाजुभाइहरूलाई स्वतन्त्रताको घोषणा गरेनौ। यसकारण अब हेर, म तिमीहरूका निम्ति ‘स्वतन्त्रताको’ घोषणा गर्दछु, याहवेह घोषणा गर्नुहुन्छ—तरवार, अनिकाल र रूढीद्वारा नष्‍ट हुने स्वतन्त्रताको घोषणा। तिमीहरूको हालत यस्तो बनाइदिनेछु, कि पृथ्वीका सबै राज्यहरूले यो देखेर भयभीत हुनेछन्। <verse eid="JER 34:17"/><verse number="18" style="v" sid="JER 34:18"/>जजसले मेरो करार भङ्ग गरेका छन् र तिनीहरूले मेरो सामु गरेका करारका शर्तहरू पूरा गरेका छैनन्, म तिनीहरूसँग त्यही बाछालाई जस्तो व्यवहार गर्नेछु, जसलाई तिनीहरूले दुई टुक्रा पारेर ती टुक्राहरूका बीचबाट हिँडे। <verse eid="JER 34:18"/><verse number="19" style="v" sid="JER 34:19"/>यहूदा र यरूशलेमका अगुवाहरू, अदालतका पदाधिकारीहरू, पुजारीहरू र देशका सबै मानिसहरू, जो बाछाका यी टुक्राहरूका बीचबाट हिँडेका छन्, <verse eid="JER 34:19"/><verse number="20" style="v" sid="JER 34:20"/>म तिनीहरूलाई मार्न चाहने तिनीहरूका शत्रुहरूका हातमा सुम्पिदिनेछु। तिनीहरूका लासहरू आकाशका चराहरू र जङ्गली पशुहरूका निम्ति भोजन हुनेछन्।<verse eid="JER 34:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JER 34:21"/>“म यहूदाको राजा सिदकियाह र त्यसका अधिकारीहरूलाई मार्न चाहने तिनीहरूका शत्रुहरू, बेबिलोनको राजाको सेनाहरूका हातमा सुम्पिदिनेछु, जुन सेनाहरू तिमीहरूबाट पछि हटेका छन्। <verse eid="JER 34:21"/><verse number="22" style="v" sid="JER 34:22"/>याहवेह घोषणा गर्नुहुन्छ, म बेबिलोनी सेनाहरूलाई आदेश दिनेछु; अनि म तिनीहरूलाई यस सहरमा फर्काएर ल्याउनेछु। तिनीहरूले यस सहरको विरुद्धमा लडाइँ गर्नेछन्। यस सहरलाई कब्जा गर्नेछन् र आगो लगाएर भस्म पार्नेछन्। यसरी म यहूदाका सहरहरूलाई उजाड पारिदिनेछु, ताकि त्यहाँ कोही पनि बसोबास गर्न नपाओस्।”<verse eid="JER 34:22"/></para>
  <chapter eid="JER 34"/>
  <chapter number="35" style="c" sid="JER 35"/>
  <para style="s1">रेकाबीहरूको आज्ञाकारिता</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 35:1"/>यो त्यो वचन हो, जो यहूदाका राजा योशियाहका छोरा, यहोयाकीमको शासनकालको समयमा याहवेहबाट यर्मियाकहाँ आयो: <verse eid="JER 35:1"/><verse number="2" style="v" sid="JER 35:2"/>“रेकाबी परिवारकहाँ गएर तिनीहरूलाई याहवेहको भवनको एक छेउको कोठामा आउने निमन्त्रणा दे, र तिनीहरूलाई दाखमद्य पिउन दे।”<verse eid="JER 35:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 35:3"/>यसकारण म हबसिन्याहका नाति, यर्मियाका छोरा याजन्याह, उनका दाजुभाइहरू, र उनका सबै छोराहरू—रेकाबीहरूका सम्पूर्ण परिवारलाई लिन गएँ। <verse eid="JER 35:3"/><verse number="4" style="v" sid="JER 35:4"/>मैले तिनीहरूलाई याहवेहको भवनको कोठामा ल्याएँ, जुन कोठाचाहिँ यिग्दल्याहका छोरा परमेश्‍वरको अगमवक्ता हानानका छोराहरूको थियो, त्यहीँ कोठामा ल्याएँ। त्यो कोठाचाहिँ शल्‍लूमको छोरा मूलढोकाको पहरेदार मासेयाहको कोठामाथि अधिकारीहरूको कोठाको छेउमा थियो। <verse eid="JER 35:4"/><verse number="5" style="v" sid="JER 35:5"/>त्यसपछि मैले रेकाबी परिवारका मानिसहरूको सामु दाखमद्यले भरिएका भाँडाहरू र केही कचौराहरू राखिदिएँ; अनि तिनीहरूलाई भनेँ, “केही दाखमद्य पिउनुहोस्।”<verse eid="JER 35:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 35:6"/>तर तिनीहरूले जवाफ दिए, “हामी दाखमद्य पिउदैनौँ; किनकि रेकाबका छोरा, हाम्रा पुर्खा योनादाबले हामीलाई यो आज्ञा दिएका थिए: ‘तिमीहरू र तिमीहरूका सन्तान कसैले पनि कहिल्यै दाखमद्य नपिउनू। <verse eid="JER 35:6"/><verse number="7" style="v" sid="JER 35:7"/>अनि तिमीहरूले घरहरू नबनाउनू, बिउ नछर्नू अथवा दाखबारी नलगाउनू। तिमीहरूसँग यी कुनै पनि कुराहरू कहिल्यै नहोस्, तर तिमीहरू सधैँ पालहरूमा बस्‍नू। तिमीहरू प्रवासी भएर बसेको यस देशमा लामो समयसम्म बाँच्नेछौ।’ <verse eid="JER 35:7"/><verse number="8" style="v" sid="JER 35:8"/>हामीले हाम्रा पुर्खा रेकाबका छोरा योनादाबले हामीलाई आज्ञा दिएका हरेक कुरा पालन गरेका छौँ। न हामी आफैँले, न हाम्रा पत्नीहरूले, न त हाम्रा छोराछोरीहरूले कहिल्यै मद्य पिएका छौँ, <verse eid="JER 35:8"/><verse number="9" style="v" sid="JER 35:9"/>अथवा न त आफ्ना निम्ति बस्‍न घरहरू बनाएका छौँ, न आफ्ना दाखबारीहरू लगाएका छौँ, न त खेतबारी लगाएका छौँ, न अन्‍नहरू नै जम्मा गरेका छौँ। <verse eid="JER 35:9"/><verse number="10" style="v" sid="JER 35:10"/>हामी पालहरूमा बसेका छौँ, र हाम्रा पुर्खा योनादाबले हामीलाई आज्ञा दिएका हरेक कुरा पालन गरेका छौँ। <verse eid="JER 35:10"/><verse number="11" style="v" sid="JER 35:11"/>तर बेबिलोनका राजा नबूकदनेसरले यस देशमाथि आक्रमण गर्दा ‘हामीले भन्यौँ, आओ, बेबिलोनी र अरामी सेनाहरूबाट उम्कन हामी यरूशलेममा जाऔँ।’ यसरी हामी यरूशलेममै बस्दैछौँ।”<verse eid="JER 35:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 35:12"/>तब याहवेहको यो वचन यर्मियाकहाँ आयो: <verse eid="JER 35:12"/><verse number="13" style="v" sid="JER 35:13"/>“सेनाहरूका याहवेह, इस्राएलका परमेश्‍वर यसो भन्‍नुहुन्छ: गएर यहूदाका मानिसहरू र यरूशलेमका बासिन्दाहरूलाई भन्, ‘के तिमीहरूले पाठ सिक्दैनौ र मेरा कुराहरू पालन गर्दैनौ?’ सेनाहरूका याहवेह घोषणा गर्नुहुन्छ। <verse eid="JER 35:13"/><verse number="14" style="v" sid="JER 35:14"/>‘रेकाबको छोरा योनादाबले आफ्ना छोराहरूलाई दाखमद्य नपिउनू भनी आदेश दियो, र तिनीहरूले त्यस आज्ञालाई पालन गरेका छन्। आजको दिनसम्म तिनीहरू दाखमद्य पिउँदैनन्; किनकि तिनीहरूले आफ्ना पुर्खाको आज्ञापालन गर्छन्। तर मैले तिमीहरूलाई बारम्बार भन्दै आएको छु, तापनि तिमीहरूले मेरा आज्ञापालन गरेका छैनौ। <verse eid="JER 35:14"/><verse number="15" style="v" sid="JER 35:15"/>मैले घरी-घरी तिमीहरूकहाँ आफ्ना सेवक अगमवक्ताहरूलाई पठाएँ। तिनीहरूले भने, “तिमीहरू हरेकले तिमीहरूका दुष्‍ट चालहरूबाट फर्क! आफ्ना कामहरू सुधार! अन्य देवताहरूको सेवा गर्न तिनीहरूको पछि नलाग। तब मैले तिमीहरू र तिमीहरूका पितापुर्खाहरूलाई दिएको देशमा तिमीहरू बस्‍नेछौ।” तर तिमीहरूले मेरो वचनमा ध्यानै दिएनौ, अथवा मेरो कुरालाई सुनेनौ। <verse eid="JER 35:15"/><verse number="16" style="v" sid="JER 35:16"/>रेकाबको छोरा योनादाबका सन्तानहरूले आफ्ना पुर्खाले तिनीहरूलाई दिएका आज्ञाहरू पालन गरेका छन्, तर यी मानिसहरूले मेरो वचन पालन गरेका छैनन्।’<verse eid="JER 35:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 35:17"/>“यसकारण सेनाहरूका याहवेह, इस्राएलका परमेश्‍वर यसो भन्‍नुहुन्छ: ‘सुन! म यहूदा र यरूशलेममा बस्‍ने सबैमाथि मैले तिनीहरूको विरुद्धमा घोषणा गरेको सबै विपत्ति ल्याउँदैछु। मैले तिनीहरूसँग बोलेँ, तर तिनीहरूले ध्यानसँग सुनेनन्; मैले तिनीहरूलाई बोलाएँ, तर तिनीहरूले जवाफ पनि दिएनन्।’ ”<verse eid="JER 35:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 35:18"/>तब यर्मियाले रेकाबीहरूका परिवारलाई भने, “सेनाहरूका याहवेह, इस्राएलका परमेश्‍वर यसो भन्‍नुहुन्छ: ‘तिमीहरूले आफ्ना पुर्खा योनादाबको आज्ञापालन गरेका छौ र उसका सबै निर्देशनअनुसार चलेका छौ; अनि उसले आज्ञा गरेका सबै कुरा गरेका छौ।’ <verse eid="JER 35:18"/><verse number="19" style="v" sid="JER 35:19"/>यसकारण सेनाहरूका याहवेह, इस्राएलका परमेश्‍वर यसो भन्‍नुहुन्छ: ‘रेकाबको छोरा योनादाबको सन्तानमा मेरो सेवा गर्ने मानिसको अभाव हुनेछैन।’ ”<verse eid="JER 35:19"/></para>
  <chapter eid="JER 35"/>
  <chapter number="36" style="c" sid="JER 36"/>
  <para style="s1">यहोयाकीमले यर्मियाको चर्मपत्र जलाएका</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 36:1"/>यहूदाका राजा योशियाहका छोरा यहोयाकीमको शासनकालको चौथो वर्षमा याहवेहको वचन यर्मियाकहाँ आयो: <verse eid="JER 36:1"/><verse number="2" style="v" sid="JER 36:2"/>“योशियाहको शासनकालदेखि अहिलेसम्म इस्राएल, यहूदा र अरू सबै जातिहरूको विषयमा मैले तँसित कुरा गर्न थालेको दिनदेखि आजसम्म मैले भनेका प्रत्येक कुराहरू एउटा चर्मपत्र लिएर त्यसमा लेख्। <verse eid="JER 36:2"/><verse number="3" style="v" sid="JER 36:3"/>सायद मैले तिनीहरूमाथि ल्याउन लागेको हरेक विपत्तिको बारेमा जब यहूदाका मानिसहरूले सुन्लान्, र तिनीहरू हरेक आफ्नो दुष्‍ट मार्गहरूबाट फर्कलान्; तब म तिनीहरूका अपराध र पाप क्षमा गर्नेछु।”<verse eid="JER 36:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 36:4"/>यसकारण यर्मियाले नेरियाहका छोरा बारूकलाई बोलाए; अनि याहवेहले यर्मियालाई भन्‍नुभएका सबै कुरा तिनले भने; अनि बारूकले चाहिँ ती कुराहरू चर्मपत्रमा लेखे। <verse eid="JER 36:4"/><verse number="5" style="v" sid="JER 36:5"/>तब यर्मियाले बारूकलाई भने, “म थुनामा छु; मलाई याहवेहको मन्दिरमा जान अनुमति छैन। <verse eid="JER 36:5"/><verse number="6" style="v" sid="JER 36:6"/>यसकारण तिमी उपवासको दिन याहवेहको भवनमा जाऊ। मैले भनेको र तिमीले चर्मपत्रमा लेखेका कुराहरू मानिसहरूका निम्ति पढिदेऊ। ती वचनहरू सहरहरूबाट भित्र आएका यहूदाका ती सबै मानिसहरूले सुन्‍ने गरी पढिदेऊ। <verse eid="JER 36:6"/><verse number="7" style="v" sid="JER 36:7"/>सायद तिनीहरूले आफ्ना बिन्ती याहवेहको सामु ल्याऊलान् र प्रत्येक मानिस आ-आफ्नो दुष्‍ट मार्गहरूबाट फर्कलान्; किनकि याहवेहले आफ्ना मानिसहरूका विरुद्धमा घोषणा गर्नुभएको रिस र त्यो क्रोध अति भयानक छन्।”<verse eid="JER 36:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 36:8"/>यर्मिया अगमवक्ताले भनेअनुसार हरेक वचनहरू नेरियाहका छोरा बारूकले पढेर सुनाए; बारूकले त्यस चर्मपत्रबाट याहवेहका ती वचनहरू याहवेहको मन्दिरमा पढेर सुनाए। <verse eid="JER 36:8"/><verse number="9" style="v" sid="JER 36:9"/>यहूदाका राजा योशियाहका छोरा, यहोयाकीमको शासनकालको पाँचौँ वर्षको नवौँ महिनामा, यरूशलेमका सबै मानिसहरू र यहूदाका सहरहरूबाट आएका सबै मानिसहरूका निम्ति याहवेहको सामु उपवासको समय घोषणा गरियो। <verse eid="JER 36:9"/><verse number="10" style="v" sid="JER 36:10"/>मन्दिरको नयाँ मूलढोकाको प्रवेशद्वारको माथिल्‍लो चोकमा रहेको शापानका छोरा सचिव गमर्याहको कोठाबाट, बारूकले याहवेहको मन्दिरमा भएका सबै मानिसहरूको निम्ति यर्मियाले भनेका चर्मपत्रबाट वचनहरू पढे।<verse eid="JER 36:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 36:11"/>जब शापानका नाति, गमर्याहका छोरा मीकायाले चर्मपत्रबाट याहवेहका सबै वचनहरू सुने, <verse eid="JER 36:11"/><verse number="12" style="v" sid="JER 36:12"/>तब तिनी राजमहलमा भएको सचिवको कोठामा गए, जहाँ सबै अधिकारीहरू, अर्थात् सचिव एलिशामा, शमायाहका छोरा दलायाह, अक्बोरका छोरा एल्नातान, शापानका छोरा गमर्याह, हनन्याहका छोरा सिदकियाह, र अरू सबै अधिकारी बसिरहेका थिए। <verse eid="JER 36:12"/><verse number="13" style="v" sid="JER 36:13"/>बारूकले चर्मपत्रबाट मानिसहरूका निम्ति पढेर सुनाएका सबै कुरा मीकायाले मानिसहरूलाई सुनाएदिए। <verse eid="JER 36:13"/><verse number="14" style="v" sid="JER 36:14"/>तब सबै अधिकारीले कूशीका पनाति, शेलेम्याहका नाति, नतन्याहका छोरा येहूदीलाई बारूककहाँ यसो भन्‍नलाई पठाए, “तिमीले जुन चर्मपत्रबाट मानिसहरूलाई पढेर सुनायौ, त्यही चर्मपत्र लिएर आऊ।” यसकारण नेरियाहका छोरा बारूकले आफ्नो हातमा चर्मपत्र लिएर तिनीहरूकहाँ गए। <verse eid="JER 36:14"/><verse number="15" style="v" sid="JER 36:15"/>तिनीहरूले तिनलाई भने, “यहाँ बस, र हाम्रो निम्ति त्यो पढिदेऊ।”</para>
  <para style="p" vid="JER 36:15">यसकारण बारूकले तिनीहरूलाई त्यो पढेर सुनाइदिए। <verse eid="JER 36:15"/><verse number="16" style="v" sid="JER 36:16"/>जब तिनीहरूले ती सबै वचन सुने, तब तिनीहरू डरले एक-अर्कालाई हेराहेर गर्न लागे र बारूकलाई भने, “हामीले यी सबै कुरा राजालाई सुनाउनैपर्छ।” <verse eid="JER 36:16"/><verse number="17" style="v" sid="JER 36:17"/>तब तिनीहरूले बारूकलाई सोधे, “तिमीले यो सबै कुरा कसरी लेख्यौ? के यर्मियाले यी सबै कुरा लेख्न लगाएका हुन्?”<verse eid="JER 36:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 36:18"/>बारूकले जवाफ दिए, “हजुर, उहाँले नै यी सबै वचनहरू मलाई भन्‍नुभएको हो; अनि मैले ती वचनहरू यस चर्मपत्रमा मसीले लेखेँ।”<verse eid="JER 36:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 36:19"/>तब ती अधिकारीहरूले बारूकलाई भने, “तिमी र यर्मिया गएर लुकेर बस। तिमीहरू कहाँ छौ, सो कुरा कसैले पनि थाहा नपाओस्।”<verse eid="JER 36:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 36:20"/>अधिकारीहरूले त्यस चर्मपत्रलाई सचिव एलिशामाको कोठामा राखिछोडे, र चोकमा राजाकहाँ गएर यी सबै कुरा भनिदिए। <verse eid="JER 36:20"/><verse number="21" style="v" sid="JER 36:21"/>राजाले येहूदीलाई त्यो चर्मपत्र लिन पठाए, र येहूदीले सचिव एलिशामाको कोठाबाट त्यसलाई ल्याए। अनि राजा र तिनका छेउमा उभिरहेका सबै अधिकारीलाई पढेर सुनाइदिए। <verse eid="JER 36:21"/><verse number="22" style="v" sid="JER 36:22"/>त्यो नवौँ महिना थियो र राजा हिउँदमा बस्‍ने महलमा बसिरहेका थिए। अनि तिनको सामु मकलमा आगो बलिरहेको थियो। <verse eid="JER 36:22"/><verse number="23" style="v" sid="JER 36:23"/>जब येहूदीले चर्मपत्रका तीन चार पङ्‌क्ति मात्र पढेका थिए, तब राजाले कागज काट्ने छुरीले ती चर्मपत्रलाई काटेर पूरै जलेर भस्म नहुन्जेल मकलको आगोमा फालिदिए। <verse eid="JER 36:23"/><verse number="24" style="v" sid="JER 36:24"/>यी वचनहरू सुन्‍ने राजा र तिनका सबै सेवकहरू न डराए, न त तिनीहरूले आफ्ना वस्त्रहरू नै च्याते। <verse eid="JER 36:24"/><verse number="25" style="v" sid="JER 36:25"/>एल्नातान, दलायाह र गमर्याहले राजालाई त्यो चर्मपत्र नजलाउनु भनेर बिन्ती गरे, तर तिनले तिनीहरूको कुरा सुन्‍नै मानेनन्। <verse eid="JER 36:25"/><verse number="26" style="v" sid="JER 36:26"/>त्यसको सट्टा राजाले आफ्ना छोरा यरहमेल, अज्रीएलका छोरा सरायाह र अब्दीलका छोरा शेलेम्याहलाई शास्त्री बारूक र यर्मिया अगमवक्तालाई पक्रने आदेश दिए। तर याहवेहले तिनीहरूलाई लुकाउनुभएको थियो।<verse eid="JER 36:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JER 36:27"/>यर्मियाले लेख्न लगाएअनुसार बारूकले लेखेका चर्मपत्र राजाले जलाइदिएपछि याहवेहको यसो भन्‍ने वचन यर्मियाकहाँ आयो: <verse eid="JER 36:27"/><verse number="28" style="v" sid="JER 36:28"/>“अर्को एउटा चर्मपत्र लिएर पहिलो चर्मपत्रमा भएका सबै वचन लेख्, जसलाई यहूदाको राजा यहोयाकीमले जलाएको थियो। <verse eid="JER 36:28"/><verse number="29" style="v" sid="JER 36:29"/>यहूदाको राजा यहोयाकीमलाई यो पनि भन्‍नू, ‘याहवेह यसो भन्‍नुहुन्छ: तैँले त्यस चर्मपत्र जलाइस्, र भनिस्, “बेबिलोनको राजा निश्‍चय नै आउनेछ, यस देशलाई नष्‍ट गर्नेछ। अनि यस देशका मानिसहरू र पशुप्राणीहरू दुवैलाई नाश गर्नेछ भनेर तैँले त्यसमा किन लेखिस्?” <verse eid="JER 36:29"/><verse number="30" style="v" sid="JER 36:30"/>यसकारण यहूदाका राजा यहोयाकीमको बारेमा याहवेह यसो भन्‍नुहुन्छ: दावीदको सिंहासनमा बस्‍नका लागि त्यसको सन्तानबाट कोही पनि हुनेछैन। त्यसको शरीर बाहिर फ्याँकिनेछ र दिउँसोको गर्मी र रातको चिसो शीतमा छोडिनेछ। <verse eid="JER 36:30"/><verse number="31" style="v" sid="JER 36:31"/>म त्यसलाई, त्यसका छोराछोरीहरूलाई र त्यसका सेवकहरूलाई तिनीहरूका दुष्‍ट कामको निम्ति दण्ड दिनेछु। म तिनीहरूमाथि, र यरूशलेमका बासिन्दा र यहूदाका मानिसहरूमाथि तिनीहरूको विरुद्धमा मैले घोषणा गरेका हरेक विपत्ति ल्याउनेछु। किनकि तिनीहरूले मेरो चेतावनीमा कुनै ध्यान दिएका छैनन्।’ ”<verse eid="JER 36:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JER 36:32"/>यसकारण यर्मियाले अर्को चर्मपत्र लिए र नेरियाहका छोरा शास्त्री बारूकलाई त्यो दिए; अनि यर्मियाले भनेअनुसार बारूकले यहूदाका राजा यहोयाकीमले आगोमा जलाइदिएका चर्मपत्रमा भएका सबै वचनहरू फेरि लेखे। अनि ती वचनहरूसँग मिल्ने अरू यस्तै वचनहरू पनि त्यसमा थपिए।<verse eid="JER 36:32"/></para>
  <chapter eid="JER 36"/>
  <chapter number="37" style="c" sid="JER 37"/>
  <para style="s1">यर्मिया कैदमा</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 37:1"/>बेबिलोनका राजा नबूकदनेसरले योशियाहका छोरा सिदकियाहलाई यहूदाका राजा बनाएका थिए; तिनले यहोयाकीमका छोरा यहोयाकीनको<note caller="+" style="f"><char style="fr" closed="false">37:1 </char><char style="ft" closed="false">मूल भाषामा </char><char style="ft" closed="false">यहोयाकीमको अर्को नाम </char><char style="fqa" closed="false">कोनिया</char></note> सट्टामा राज्य गरे। <verse eid="JER 37:1"/><verse number="2" style="v" sid="JER 37:2"/>तर न तिनले, न तिनका सेवकहरूले, न त देशका मानिसहरूले नै यर्मिया अगमवक्ताद्वारा बोलिएका याहवेहका वचनहरू पालन गरे।<verse eid="JER 37:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 37:3"/>तापनि राजा सिदकियाहले शेलेम्याहका छोरा यहूकललाई, मासेयाहका छोरा पुजारी सपन्याहसँग यर्मिया अगमवक्ताकहाँ यो सन्देश पठाए, “कृपया, याहवेह हाम्रा परमेश्‍वरसँग हाम्रो निम्ति प्रार्थना गरिदिनुहोस्।”<verse eid="JER 37:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 37:4"/>त्यस बेला यर्मिया मानिसहरूका बीचमा आउजाउ गर्न स्वतन्त्र थिए; किनकि तिनलाई त्यस बेलासम्म झ्यालखानामा राखिएको थिएन। <verse eid="JER 37:4"/><verse number="5" style="v" sid="JER 37:5"/>फारोको सेना इजिप्टबाट मोर्चा बाँधेर निस्किसकेको थियो, जब यरूशलेमलाई घेरिराखेका बेबिलोनीहरूले तिनीहरूको बारेमा सुने, तब तिनीहरू यरूशलेमबाट पछि हटेर गए।<verse eid="JER 37:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 37:6"/>तब याहवेहको वचन यर्मिया अगमवक्ताकहाँ आयो: <verse eid="JER 37:6"/><verse number="7" style="v" sid="JER 37:7"/>“याहवेह, इस्राएलका परमेश्‍वर यसो भन्‍नुहुन्छ: यहूदाको राजा, जसले तँलाई मसँग सल्‍लाह लिन पठाएको छ, त्यसलाई भन्, ‘तँलाई सघाउनको निम्ति मोर्चा बाँधेर निस्किसकेका फारोका सेना त्यसको आफ्नै देश इजिप्टमा फर्किजानेछ। <verse eid="JER 37:7"/><verse number="8" style="v" sid="JER 37:8"/>तब बेबिलोनीहरू फर्कनेछन् र यस सहरलाई आक्रमण गर्नेछन्। तिनीहरूले यस सहरलाई कब्जा गर्नेछन् र आगोले जलाएर भस्म पार्नेछन्।’<verse eid="JER 37:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 37:9"/>“याहवेह यसो भन्‍नुहुन्छ: ‘बेबिलोनीहरूले हामीलाई निश्‍चय छोडिदिनेछन्,’ भन्‍ने सोचेर तिमीहरू आफैँलाई धोका नदेओ। तिनीहरूले छोडेर जानेछैनन्! <verse eid="JER 37:9"/><verse number="10" style="v" sid="JER 37:10"/>यदि तिमीहरूका विरुद्धमा आक्रमण गर्ने सम्पूर्ण बेबिलोनी सेनाहरूलाई परास्त गर्न तिमीहरू सफल भयौ भने तापनि तिनीहरूका पालहरूमा छोडिएका घाइते मानिसहरू बाहिर आएर यस सहरलाई जलाइदिनेछन्।”<verse eid="JER 37:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 37:11"/>फारोका सेनाको कारण बेबिलोनी सेना यरूशलेमबाट हटेर गयो। <verse eid="JER 37:11"/><verse number="12" style="v" sid="JER 37:12"/>तब यर्मिया बेन्यामीनको इलाकाका मानिसहरूबाट आफ्नो सम्पत्तिको भाग लिनलाई यरूशलेमबाट निस्के। <verse eid="JER 37:12"/><verse number="13" style="v" sid="JER 37:13"/>तर जब तिनी बेन्यामीन मूलढोकामा पुगे, तब अङ्गरक्षकका सेनापति जसको नाम यिरियाह थियो, जो हनन्याहका नाति शेलेम्याहका छोरा थिए; उनले यर्मियालाई पक्रेर भने, “तिमी भागेर बेबिलोनीहरूकहाँ जाँदैछौ!”<verse eid="JER 37:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 37:14"/>यर्मियाले जवाफ दिएर भने, “यो कुरा सत्य होइन! म भागेर बेबिलोनीहरूकहाँ गएको होइनँ।” तर यिरियाहले तिनको कुरा सुन्‍नै चाहेनन्। यसकारण उनले यर्मियालाई पक्रेर तिनलाई अधिकारीहरूकहाँ ल्याए। <verse eid="JER 37:14"/><verse number="15" style="v" sid="JER 37:15"/>तिनीहरू यर्मियासँग रिसाएर तिनलाई पिटे, र तिनलाई सचिव जोनाथनको घरमा कैद गरेर राखे; किनकि त्यस घरलाई तिनीहरूले झ्यालखाना बनाएका थिए।<verse eid="JER 37:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 37:16"/>तिनीहरूले यर्मियालाई एउटा अँध्यारो बन्दी कोठामा राखिदिए, जहाँ तिनी धेरै दिनसम्म रहे। <verse eid="JER 37:16"/><verse number="17" style="v" sid="JER 37:17"/>तब सिदकियाह राजाले तिनलाई ल्याउन लगाए, र तिनलाई राजमहलमा ल्याए, जहाँ तिनलाई गुप्‍तमा सोधे, “के याहवेहबाट केही सन्देश छ?”</para>
  <para style="p" vid="JER 37:17">यर्मियाले जवाफ दिए, “हजुर, छ। तपाईं बेबिलोनका राजाको हातमा सुम्पिइनुहुनेछ।”<verse eid="JER 37:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 37:18"/>तब यर्मियाले राजा सिदकियाहलाई भने, “मैले तपाईं, तपाईंका अधिकारीहरू र यी मानिसहरूको विरुद्धमा के अपराध गरेको छु, र तपाईंले मलाई झ्यालखानामा राख्नुभयो? <verse eid="JER 37:18"/><verse number="19" style="v" sid="JER 37:19"/>तपाईंका ती अगमवक्ताहरू कहाँ छन्, जसले तपाईंलाई, ‘बेबिलोनका राजाले तिनका सेनासँग तपाईं अथवा यस देशको विरुद्धमा आक्रमण गर्नेछैन’ भनेर अगमवाणी गरेका थिए? <verse eid="JER 37:19"/><verse number="20" style="v" sid="JER 37:20"/>तर अब हे मेरा मालिक राजा, दया गरी सुनिदिनुहोस्। मलाई मेरो बिन्ती तपाईंको अगि राख्न दिनुहोस्: मलाई सचिव जोनाथनको घरमा फर्काएर नपठाउनुहोस्, नत्रता म त्यहीँ मर्नेछु।”<verse eid="JER 37:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JER 37:21"/>तब राजा सिदकियाहको आदेशअनुसार यर्मिया पहरेदारको चोकमा राखिए; अनि सहरका सबै रोटी नसकुन्जेल बजारको पसलबाट दिनहुँ रोटी ल्याएर तिनलाई दिइन्थ्यो। यसरी यर्मिया पहरेदारको चोकमा रहन लागे।<verse eid="JER 37:21"/></para>
  <chapter eid="JER 37"/>
  <chapter number="38" style="c" sid="JER 38"/>
  <para style="s1">यर्मियालाई खाडलमा हालिएको</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 38:1"/>मत्तानका छोरा शपत्याह, पशहूरका छोरा गदल्याह, शेलेम्याहका छोरा येहूकल र मल्कियाहका छोरा पशहूरले यर्मियाले सबै मानिसहरूलाई यसो भनिरहेका सुने, <verse eid="JER 38:1"/><verse number="2" style="v" sid="JER 38:2"/>“याहवेह यसो भन्‍नुहुन्छ: ‘यस सहरमा जो बस्छ, त्यो तरवार, अनिकाल र रूढीले मर्नेछ; तर बेबिलोनी सेनाहरूकहाँ गएर आफैँलाई समर्पण गर्नेचाहिँ जीवित रहनेछ। त्यसले आफ्नो प्राण जोगाउनेछ र जीवित रहनेछ।’ <verse eid="JER 38:2"/><verse number="3" style="v" sid="JER 38:3"/>अनि याहवेह यसो भन्‍नुहुन्छ: ‘यो सहर निश्‍चय नै बेबिलोनको राजाका सेनाको हातमा दिइनेछ, जसले यस सहरलाई कब्जा गर्नेछ।’ ”<verse eid="JER 38:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 38:4"/>तब अधिकारीहरूले राजालाई भने, “यो मानिसलाई मार्नुपर्छ; किनकि यसले मानिसहरूलाई भनिरहेका कुराहरूले यस सहरमा बाँकी रहेका सेना र सबै मानिसहरूलाई समेत निरुत्साहित पार्दैछ। यस मानिसले यी मानिसहरूको भलाइ होइन, तर तिनीहरूको हानि गर्न चाहन्छ।”<verse eid="JER 38:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 38:5"/>तब राजा सिदकियाहले जवाफ दिए, “त्यो मानिस तिमीहरूकै हातमा छ। म तिमीहरूलाई रोक्न सक्दिनँ।”<verse eid="JER 38:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 38:6"/>यसकारण तिनीहरूले यर्मियालाई लगेर राजाको छोरा मल्कियाहको पानीको खाडलमा हालिदिए। त्यो खाडल पहरेदारको चोकमा थियो। तिनीहरूले यर्मियालाई डोरीबाट तल अँध्यारो बन्द खाडलभित्र झारिदिए; त्यस अँध्यारो खाडलमा पानी थिएन, तर हिलो मात्र थियो; यसकारण यर्मिया हिलोमा भासिए।<verse eid="JER 38:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 38:7"/>तर राजमहलका एक जना नपुंसक अधिकारी कूशी एबेद-मेलेकले तिनीहरूले यर्मियालाई बन्द खाडलमा हालेको कुरा सुने। त्यस बेला राजा बेन्यामीन ढोकामा बसिरहेका थिए। <verse eid="JER 38:7"/><verse number="8" style="v" sid="JER 38:8"/>तब एबेद-मेलेक महलबाट निस्केर गएर राजालाई यसो भने, <verse eid="JER 38:8"/><verse number="9" style="v" sid="JER 38:9"/>“मेरा प्रभु महाराजा, यी मानिसहरूले यर्मिया अगमवक्तालाई अति दुष्‍टतापूर्ण व्यवहार गरेका छन्। तिनीहरूले उनलाई खाडलभित्र खसालिदिएका छन्, जहाँ उनी भोकै मर्नेछन्; किनकि सहरमा अब केही खानेकुरा बाँकी छैन।”<verse eid="JER 38:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 38:10"/>तब राजाले कूशी एबेद-मेलेकलाई आज्ञा दिए, “यहाँबाट आफूसँग तीस जना मानिसहरू लैजाऊ र तिनी मर्नुभन्दा अगि नै यर्मिया अगमवक्तालाई त्यस खाडलबाट निकाल।”<verse eid="JER 38:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 38:11"/>यसकारण एबेद-मेलेकले आफूसँग ती मानिसहरू लिएर महलमा भएको भण्डारमुनिको कोठामा गए। तिनले त्यहाँबाट केही फाटेका र पुराना लुगाहरू लिए। अनि तिनले ती कपडाहरू डोरीमा बाँधेर खाडलभित्र यर्मिया अगमवक्ताकहाँ झारिदिए। <verse eid="JER 38:11"/><verse number="12" style="v" sid="JER 38:12"/>अनि कूशी एबेद-मेलेकले यर्मियालाई भने, “यी फाटेका र पुराना कपडाहरूलाई डोरीले नदुःखोस् भनेर तिम्रा काखीमुनि लगाऊ।” तब यर्मियाले त्यसै गरे। <verse eid="JER 38:12"/><verse number="13" style="v" sid="JER 38:13"/>अनि तिनीहरूले ती डोरीहरूको सहायताले यर्मियालाई खाडलबाट बाहिर निकाले। त्यसपछि यर्मिया पहरेदारको चोकमा रहन थाले।<verse eid="JER 38:13"/></para>
  <para style="s1">यर्मियालाई फेरि सिदकियाहको प्रश्न</para>
  <para style="p">
    <verse number="14" style="v" sid="JER 38:14"/>तब राजा सिदकियाहले यर्मिया अगमवक्तालाई बोलाउन पठाए, र तिनलाई याहवेहको मन्दिरको तेस्रो प्रवेशद्वारमा ल्याउन लगाए। राजाले यर्मियालाई भने, “म तिमीलाई केही कुरा सोध्न लागेको छु। मबाट केही कुरा पनि नलुकाऊ!”<verse eid="JER 38:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 38:15"/>यर्मियाले सिदकियाहलाई भने, “यदि मैले तपाईंलाई जवाफ दिएँ भने के तपाईंले मलाई मार्नुहुन्‍न र? यदि मैले तपाईंलाई सल्‍लाह दिएँ भने तापनि तपाईंले मेरो कुरा सुन्‍नुहुनेछैन।”<verse eid="JER 38:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 38:16"/>तर राजा सिदकियाहले यर्मियासँग गुप्‍तमा यो शपथ खाए: “हामीलाई सास दिनुहुने जीवित याहवेहको नाममा शपथ खाएर भन्छु, म तिमीलाई मार्नेछैनँ, न त तिमीलाई मार्न चाहनेहरूका हातमा नै तिमीलाई सुम्पिदिनेछु।”<verse eid="JER 38:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 38:17"/>तब यर्मियाले सिदकियाहलाई भने, “याहवेह सेनाहरूका परमेश्‍वर, इस्राएलका परमेश्‍वर यसो भन्‍नुहुन्छ: ‘यदि तैँले बेबिलोनको राजाका अधिकारीहरूको हातमा आफूलाई समर्पण गरिस् भने तँ जीवित रहनेछस्, र तिनीहरूले यो सहरलाई जलाएर भस्म पार्नेछैनन्; तेरो परिवारसहित तँ जीवित रहनेछस्। <verse eid="JER 38:17"/><verse number="18" style="v" sid="JER 38:18"/>तर यदि तैँले बेबिलोनका राजाका अधिकारीहरूको हातमा समर्पण गरिनस् भने यो सहर बेबिलोनीहरूका हातमा सुम्पिनेछ, र तिनीहरूले यस सहरलाई जलाएर भस्म पार्नेछन्; तँ आफैँ पनि तिनीहरूका हातबाट उम्कनेछैनस्।’ ”<verse eid="JER 38:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 38:19"/>राजा सिदकियाहले यर्मियालाई भने, “बेबिलोनीहरूकहाँ शरण लिन गएका यहूदीहरूसँग मलाई डर लागिरहेको छ; किनकि बेबिलोनीहरूले मलाई तिनीहरूका हातमा सुम्पिदेलान्, र तिनीहरूले मसँग दुर्व्यवहार गर्लान्।”<verse eid="JER 38:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 38:20"/>यर्मियाले जवाफ दिए, “तिनीहरूले तपाईंलाई सुम्पिनेछैनन्। मैले तपाईंलाई भनेका कुरा गरेर याहवेहको आज्ञापालन गर्नुहोस्। तब तपाईंको भलो हुनेछ, र तपाईं जीवित रहनुहुनेछ। <verse eid="JER 38:20"/><verse number="21" style="v" sid="JER 38:21"/>तर यदि तपाईंले समर्पण गर्न इन्कार गर्नुभयो भने याहवेहले मलाई यो कुरा प्रकट गर्नुभएको छ: <verse eid="JER 38:21"/><verse number="22" style="v" sid="JER 38:22"/>सुन्‍नुहोस्, यहूदाको राजाका महलमा छोडिएका ती सबै स्त्रीहरू बेबिलोनका अधिकारीहरूकहाँ बाहिर निकालेर ल्याइनेछन्। ती स्त्रीहरूले तपाईंलाई यसो भन्‍नेछन्:</para>
  <para style="q1" vid="JER 38:22">“ ‘तपाईंले भरोसा गरेका मित्रहरूले,</para>
  <para style="q2" vid="JER 38:22">तपाईंलाई धोका दिएर जिते।</para>
  <para style="q1" vid="JER 38:22">तपाईंका खुट्टाहरू हिलोमा डुबेका छन्;</para>
  <para style="q2" vid="JER 38:22">तपाईंका मित्रहरूले तपाईंलाई त्यागिदिएका छन्।’<verse eid="JER 38:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JER 38:23"/>“तपाईंका सबै पत्नीहरू र छोराछोरीहरू बेबिलोनीहरूकहाँ बाहिर निकालेर ल्याइनेछन्। तपाईं आफैँ पनि तिनीहरूका हातबाट उम्कनु हुनेछैन, तर बेबिलोनका राजाद्वारा कब्जामा पारिनुहुनेछ; अनि यो सहरचाहिँ आगोले जलेर भस्म पारिनेछ।”<verse eid="JER 38:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 38:24"/>तब सिदकियाहले यर्मियालाई भने, “यस कुराकानीको बारेमा अरू कसैलाई पनि केही नभन्‍नू, नत्रता तिमी मर्नेछौ। <verse eid="JER 38:24"/><verse number="25" style="v" sid="JER 38:25"/>यदि मैले तिमीसँग बातचित गरेको कुरा अधिकारीहरूले सुनेछन् भने, र तिनीहरू तिमीकहाँ आएर ‘तिमीले राजालाई के भन्यौ र राजाले तिमीलाई के भन्‍नुभयो हामीलाई भन; यो कुरा हामीबाट नलुकाऊ, नत्रता हामी तिमीलाई मार्नेछौँ,’ भनी भनेछन् भने, <verse eid="JER 38:25"/><verse number="26" style="v" sid="JER 38:26"/>तब तिनीहरूलाई भनिदेऊ, ‘मलाई मर्नका निम्ति जोनाथनको घरमा फर्काएर नपठाउनुहोस् भनेर म राजासँग बिन्ती गर्दैथिएँ।’ ”<verse eid="JER 38:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JER 38:27"/>ती सबै अधिकारीहरू यर्मियाकहाँ आए, र तिनलाई सोधे; अनि यर्मियाले राजाले अधिकारीहरूलाई जे भन्‍ने आदेश दिएका थिए, ती हरेक कुरा तिनीहरूलाई भनिदिए। यसकारण अधिकारीहरूले यर्मियालाई अरू केही भनेनन्; किनकि राजासित भएको तिनको कुराकानी कसैले पनि सुनेका थिएनन्।<verse eid="JER 38:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JER 38:28"/>अनि यरूशलेमको कब्जा हुने दिनसम्म नै यर्मिया राजमहलको पहरेदारको चोकमा नै रहे।</para>
  <para style="s1" vid="JER 38:28">यरूशलेमको पतन</para>
  <para style="p" vid="JER 38:28">यसरी यरूशलेमलाई कैदमा लगियो:<verse eid="JER 38:28"/></para>
  <chapter eid="JER 38"/>
  <chapter number="39" style="c" sid="JER 39"/>
  <para style="nb">
    <verse number="1" style="v" sid="JER 39:1"/>यहूदाका राजा सिदकियाहको शासनकालको नवौँ वर्षको दशौँ महिनामा, बेबिलोनका राजा नबूकदनेसर आफ्ना सम्पूर्ण सेना लिएर यरूशलेमको विरुद्धमा मोर्चा बाँधेर आए र त्यसलाई घेरा हाले। <verse eid="JER 39:1"/><verse number="2" style="v" sid="JER 39:2"/>अनि सिदकियाहको शासनकालको एघारौँ वर्षको चौथो महिनाको नवौँ दिनमा सहरको पर्खाल भत्काइयो। <verse eid="JER 39:2"/><verse number="3" style="v" sid="JER 39:3"/>तब बेबिलोनका राजाका सबै अधिकारीहरू भित्र आए, र बीचको मूलढोकामा बसे: समगरका नेर्गल-सरेसेर, मुख्य अधिकारी नबो-सर्कसीम, उच्‍च अधिकारी नेर्गल-सरेसेर र बेबिलोनका राजाका अरू सबै अधिकारीहरू पनि थिए। <verse eid="JER 39:3"/><verse number="4" style="v" sid="JER 39:4"/>जब यहूदाका राजा सिदकियाह र अरू सबै सेनाले बेबिलोनीहरूलाई देखे, तब तिनीहरू भागे; अनि तिनीहरू राजाको बगैँचाका दुई वटा पर्खालहरू बीचको मूलढोकाबाट निस्केर राति नै सहरबाट भागेर अराबातिर लागे।<verse eid="JER 39:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 39:5"/>तर बेबिलोनी सेनाहरूले तिनीहरूलाई खेदे, र सिदकियाहलाई यरीहोको मैदानमा भेट्टाए। तिनीहरूले तिनलाई पक्रे, र तिनलाई हमातको सहरमा भएको रिब्ला इलाकामा बेबिलोनका राजा नबूकदनेसरकहाँ लगे, जहाँ तिनले सिदकियाहलाई दण्डको आज्ञा सुनाए। <verse eid="JER 39:5"/><verse number="6" style="v" sid="JER 39:6"/>त्यहाँ रिब्ला इलाकामा बेबिलोनका राजाले सिदकियाहका छोराहरूलाई र यहूदाका सबै अधिकारीहरूलाई तिनकै आँखाको सामु मारे। <verse eid="JER 39:6"/><verse number="7" style="v" sid="JER 39:7"/>त्यसपछि तिनले सिदकियाहका आँखा निकालिदिए, र बेबिलोनमा लैजानलाई तिनलाई काँसाका साङ्लाहरूले बाँधे।<verse eid="JER 39:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 39:8"/>बेबिलोनीहरूले राजदरबार र मानिसहरूका घरहरूमा आगो लगाइदिए; अनि यरूशलेमका पर्खालहरू भत्काइदिए। <verse eid="JER 39:8"/><verse number="9" style="v" sid="JER 39:9"/>बेबिलोनका राजकीय अङ्गरक्षकका सेनापति नबूजरदानले सहरमा बचेका मानिसहरू र पहिले तिनीहरूकहाँ भागेर गइसकेका मानिसहरू र त्यहाँका अरू बाँकी मानिसहरूलाई कैद गरेर बेबिलोनमा लगे। <verse eid="JER 39:9"/><verse number="10" style="v" sid="JER 39:10"/>तर अङ्गरक्षकका सेनापति नबूजरदानले केही पनि नभएका मानिसहरूलाई यहूदामै छोडिदिए; अनि त्यस समय तिनले ती गरिबहरूलाई दाखबारी र खेतबारीहरू दिए।<verse eid="JER 39:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 39:11"/>अब बेबिलोनका राजा नबूकदनेसरले राजकीय अङ्गरक्षकका सेनापति नबूजरदानलाई यर्मियाको बारेमा यस्तो आदेश दिएका थिए: <verse eid="JER 39:11"/><verse number="12" style="v" sid="JER 39:12"/>“यर्मियालाई ल्याऊ र तिनलाई राम्ररी हेरचाह गर। तिनलाई हानि नगर्नू, तर तिनले जे चाहन्छन्, तिनका निम्ति त्यही गर्नू!” <verse eid="JER 39:12"/><verse number="13" style="v" sid="JER 39:13"/>यसकारण अङ्गरक्षकका सेनापति नबूजरदान, मुख्य अधिकारी नबूशजवान, उच्‍च अधिकारी नेर्गल-सरेसेर र बेबिलोनका राजाका अरू सबै अधिकारीहरूले मिलेर <verse eid="JER 39:13"/><verse number="14" style="v" sid="JER 39:14"/>मानिसहरू पठाए र यर्मियालाई पहरेदारको चोकबाट बाहिर निकालेर ल्याए। तिनीहरूले यर्मियालाई तिनको आफ्नै घरमा लैजान भनी शापानका नाति, अहीकामका छोरा गदल्याहलाई सुम्पिदिए। अनि यसरी तिनी आफ्नै मानिसहरूसँग रहे।<verse eid="JER 39:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 39:15"/>यर्मिया पहरेदार चोकमा कैदमा रहेको बेला याहवेहको वचन तिनीकहाँ आएको थियो: <verse eid="JER 39:15"/><verse number="16" style="v" sid="JER 39:16"/>“गएर कूशी एबेद-मेलेकलाई भन्, ‘सेनाहरूका याहवेह, इस्राएलका परमेश्‍वर यसो भन्‍नुहुन्छ: म यस सहरको विरुद्धमा मेरा वचनहरू पूरा गर्न लागेको छु; उन्‍नति गरेर होइन, तर विपत्ति ल्याएर। त्यस समयमा तेरा आँखाकै सामु ती सबै पूरा भएको देख्नेछस्, <verse eid="JER 39:16"/><verse number="17" style="v" sid="JER 39:17"/>याहवेह घोषणा गर्नुहुन्छ। तर त्यस दिन तँलाई म बचाउनेछु। तँ जुन मानिसहरूसँग डराउँछस्, तिनीहरूको हातमा सुम्पिइनेछैनस्। <verse eid="JER 39:17"/><verse number="18" style="v" sid="JER 39:18"/>म तँलाई बचाउनेछु। तँ तरवारद्वारा मारिनेछैनस्, तर तँ लुटको मालजस्तै जीवितै उम्कनेछस्; किनकि तैँले ममाथि भरोसा राखेको छस्, याहवेह घोषणा गर्नुहुन्छ।’ ”<verse eid="JER 39:18"/></para>
  <chapter eid="JER 39"/>
  <chapter number="40" style="c" sid="JER 40"/>
  <para style="s1">यर्मिया मुक्त भएका</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 40:1"/>राजकीय अङ्गरक्षकका सेनापति नबूजरदानले यर्मियालाई रामा सहरमा छोडिसकेपछि याहवेहको वचन यर्मियाकहाँ आयो। तिनले यर्मियालाई बेबिलोनमा कैद गरेर लगिन लागेका यरूशलेम र यहूदाका कैदीहरूसँग साङ्लाले बाँधिएको अवस्थामा भेट्टाएका थिए। <verse eid="JER 40:1"/><verse number="2" style="v" sid="JER 40:2"/>जब अङ्गरक्षकका सेनापति नबूजरदानले यर्मियालाई भेट्टाए, तब नबूजरदानले उनलाई भने, “याहवेह तपाईंका परमेश्‍वरले यस ठाउँमाथि यो विपत्ति ल्याउने घोषणा गर्नुभएको थियो। <verse eid="JER 40:2"/><verse number="3" style="v" sid="JER 40:3"/>अनि अहिले याहवेहले यो कुरा हुन दिनुभएको छ; उहाँले जे गर्छु भन्‍नुभएको थियो, त्यो गर्नुभएको छ। किनकि तपाईंहरूले याहवेहको विरुद्धमा पाप गर्नुभएको छ र उहाँको आज्ञापालन गर्नुभएको छैन। <verse eid="JER 40:3"/><verse number="4" style="v" sid="JER 40:4"/>तर आज म तपाईंलाई तपाईंका हातको साङ्लाबाट मुक्त गरिदिँदैछु। यदि तपाईंलाई इच्छा लाग्यो भने मसँग बेबिलोनमा आउनुहोस्, र म तपाईंको हेरचाह गर्नेछु; तर यदि तपाईं आउन चाहनुहुन्‍न भने नआउनुहोला। हेर्नुहोस्, सारा देश तपाईंको सामु छ, तपाईंलाई जहाँ जान ठिक लाग्छ, त्यहीँ जानुहोस्।” <verse eid="JER 40:4"/><verse number="5" style="v" sid="JER 40:5"/>अनि यर्मिया जान लाग्दा नबूजरदानले थपेर भने, “शापानका नाति, अहीकामका छोरा गदल्याहकहाँ फर्केर जानुहोस्, जसलाई बेबिलोनका राजाले यहूदाका सहरहरूमाथि राज्यपाल नियुक्त गर्नुभएको छ। अनि तिनीसँग मानिसहरूबीच तपाईं बस्‍न सक्नुहुन्छ, अथवा तपाईंलाई जहाँ जान ठिक लाग्छ, त्यहीँ जान सक्नुहुन्छ।”</para>
  <para style="p" vid="JER 40:5">तब सेनापतिले तिनलाई केही खानेकुराहरू र उपहार दिएर तिनलाई जान दिए। <verse eid="JER 40:5"/><verse number="6" style="v" sid="JER 40:6"/>यसकारण यर्मिया अहीकामका छोरा गदल्याहकहाँ मिस्पा सहरमा गए, र तिनीसँगै देशमा बाँकी रहेका मानिसहरूसँग बस्‍न लागे।<verse eid="JER 40:6"/></para>
  <para style="s1">गदल्याहको हत्या</para>
  <para style="p">
    <verse number="7" style="v" sid="JER 40:7"/>बेबिलोनका राजाले अहीकामका छोरा गदल्याहलाई त्यस देशका राज्यपाल नियुक्त गरेका छन्; र त्यहाँका मानिसहरू, स्त्रीहरू र केटाकेटीहरू, जो देशमा गरिब थिए, र तिनीहरूलाई बेबिलोनमा कैद गरेर लगिएको थिएन; अनि ती सबै तिनको जिम्मामा छन् भनेर जब त्यस बस्तीमा आत्मसमर्पण नगरी बसिरहेका सेनाका केही अधिकारीहरू र तिनीहरूका मानिसहरूले सुने, <verse eid="JER 40:7"/><verse number="8" style="v" sid="JER 40:8"/>तब तिनीहरू, नतन्याहका छोरा इश्माएल, कारेहका छोराहरू योहानान र जोनाथन, तन्हूमेतका छोरा सरायाह, नतोपाती एपैका छोराहरू, माकातीका छोरा याजन्याह,<note caller="+" style="f"><char style="fr" closed="false">40:8 </char><char style="fq" closed="false">याजन्याह </char><char style="ft" closed="false">मूल भाषामा उनको अर्को नाम हो </char><char style="fqa" closed="false">येजान्याह</char></note> र तिनीहरूका मानिसहरू मिस्पामा गदल्याहकहाँ आए। <verse eid="JER 40:8"/><verse number="9" style="v" sid="JER 40:9"/>शापानका नाति, अहीकामका छोरा गदल्याहले तिनीहरूलाई र तिनीहरूका मानिसहरूलाई आश्‍वासन दिन फेरि यो शपथ खाएर तिनले भने, “बेबिलोनीहरूको सेवा गर्न नडराओ। देशमा बसोबास गर, र बेबिलोनका राजाको सेवा गर, तब तिमीहरूको भलो हुनेछ। <verse eid="JER 40:9"/><verse number="10" style="v" sid="JER 40:10"/>म आफैँचाहिँ हामीहरूकहाँ आउने बेबिलोनीहरूका अगाडि तिमीहरूको प्रतिनिधित्व गरेर मिस्पामा बस्‍नेछु, तर तिमीहरूले चाहिँ दाखमद्यको निम्ति कालो अङ्‌गुर, ग्रीष्म ऋतुका फलहरू र जैतुन तेलका कटनी गरेर आफ्ना भाँडाहरूमा भण्डारण गर, र तिमीहरूले कब्जा गरेका सहरहरूमा बस।”<verse eid="JER 40:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 40:11"/>जब मोआब, अम्मोन, एदोम र अरू सबै प्रान्तहरूका यहूदीहरूले बेबिलोनका राजाले यहूदामा केही इस्राएलीहरूलाई रहन दिएका छन् र शापानका नाति, अहीकामका छोरा गदल्याहलाई तिनीहरूमाथि राज्यपाल नियुक्त गरिदिएका छन् भन्‍ने कुरा सुने; <verse eid="JER 40:11"/><verse number="12" style="v" sid="JER 40:12"/>तब तिनीहरू सबै छरपस्ट भएका प्रान्तहरूबाट यहूदाको देशमा गदल्याहकहाँ मिस्पामा फर्केर आए। अनि तिनीहरूले अङ्‌गुर र ग्रीष्म ऋतुका फलहरू प्रशस्त कटनी गरेर जम्मा गरे।<verse eid="JER 40:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 40:13"/>त्यसपछि कारेहका छोरा योहानान र खुल्‍ला मैदानमा भएका सेनाका सबै अधिकारीहरू मिस्पा सहरमा गदल्याहकहाँ आए; <verse eid="JER 40:13"/><verse number="14" style="v" sid="JER 40:14"/>अनि तिनलाई भने, “के अम्मोनीहरूका राजा बालीसले नतन्याहका छोरा इश्माएललाई तपाईंको ज्यान लिन पठाएका छन् भन्‍ने कुरा तपाईंलाई थाहा छैन?” तर अहीकामका छोरा, गदल्याहले तिनीहरूको कुरामा विश्‍वास नै गरेनन्।<verse eid="JER 40:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 40:15"/>तब कारेहका छोरा योहानानले मिस्पामा गदल्याहलाई एकान्तमा भने, “मलाई जान दिनुहोस्, र नतन्याहका छोरा इश्माएललाई मार्न दिनुहोस्; अनि कसैले पनि यो कुरा थाहा पाउनेछैन। त्यसलाई किन तपाईंको प्राण लिन दिने र तपाईंका वरिपरि भेला भएका यहूदीहरूलाई फेरि छरपस्ट हुन दिने र यहूदामा बाँकी रहेकाहरूलाई नष्‍ट हुन किन दिने?”<verse eid="JER 40:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 40:16"/>तर अहीकामका छोरा गदल्याहले कारेहका छोरा योहानानलाई भने, “तिमीले यस्तो काम नगर! तिमीले इश्माएलको बारेमा भनेको कुरा सत्य होइन।”<verse eid="JER 40:16"/></para>
  <chapter eid="JER 40"/>
  <chapter number="41" style="c" sid="JER 41"/>
  <para style="p">
    <verse number="1" style="v" sid="JER 41:1"/>सातौँ महिनामा एलीशामाका नाति, नतन्याहका छोरा इश्माएल, जो राज घरानाका र राजाका अफिसरहरूमध्येका एक थिए; तिनले दश जना मानिसहरू लिएर मिस्पामा अहीकामका छोरा गदल्याहकहाँ आए। जब तिनीहरू सबै एकैसाथ त्यहाँ भोजन खाइरहेका थिए, <verse eid="JER 41:1"/><verse number="2" style="v" sid="JER 41:2"/>तब तिनीहरूसँग भएका नतन्याहका छोरा इश्माएल र दश जना मानिसहरू उठे, र बेबिलोनका राजाले त्यस देशमाथि राज्यपाल नियुक्त गरेका व्यक्ति शापानका नाति, अहीकामका छोरा गदल्याहलाई तरवारले प्रहार गरेर मारे। <verse eid="JER 41:2"/><verse number="3" style="v" sid="JER 41:3"/>इश्माएलले मिस्पामा गदल्याहसँग भएका सबै यहूदी र त्यहाँ भएका बेबिलोनी सेनाहरूलाई पनि मारे।<verse eid="JER 41:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 41:4"/>गदल्याहको हत्याको भोलिपल्ट त्यस घटनाको बारेमा कसैले थाहा पाउनुअगि नै <verse eid="JER 41:4"/><verse number="5" style="v" sid="JER 41:5"/>शेकेम, शीलो र सामरियाबाट आफ्ना दाह्री खौरेका, आफ्ना लुगा च्यातेका र आफ्ना शरीरलाई चिरा-चिरा पारेर काटेका असी जना मानिसहरू आफूसँग अन्‍नबलि र धूप लिएर याहवेहको भवनमा आए। <verse eid="JER 41:5"/><verse number="6" style="v" sid="JER 41:6"/>नतन्याहका छोरा इश्माएल मिस्पाबाट तिनीहरूलाई भेट्न रुँदै आए। अनि तिनले उनीहरूलाई भेटेर भने, “अहीकामका छोरा गदल्याहकहाँ आओ।” <verse eid="JER 41:6"/><verse number="7" style="v" sid="JER 41:7"/>जब तिनीहरू सहरभित्र गए, तब नतन्याहका छोरा इश्माएल र तिनीसँग भएका दश जना मानिसहरूले तिनीहरूलाई मारे, र तिनीहरूलाई खाडलभित्र फ्याँकिदिए। <verse eid="JER 41:7"/><verse number="8" style="v" sid="JER 41:8"/>तर तिनीहरूमध्ये दश जनाले इश्माएललाई भने, “हामीलाई नमार्नुहोस्! हामीले खेतमा गहुँ, जौ, जैतुन तेल र मह लुकाइराखेका छौँ।” यसकारण तिनले तिनीहरूलाई छोडिदिए, र तिनीहरूलाई अरूसँगै मारेनन्। <verse eid="JER 41:8"/><verse number="9" style="v" sid="JER 41:9"/>जुन खाडलमा तिनले गदल्याहसँगै अरू मानिसहरूलाई पनि मारेर तिनीहरूका मृत शरीरहरू फ्याँकेका थिए, त्यो खाडल राजा आसाले इस्राएलका राजा बाशाको आक्रमणबाट बच्न भनी बनाएका थिए। तर नतन्याहका छोरा इश्माएलले त्यसलाई लासैलासले भरिदिए।<verse eid="JER 41:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 41:10"/>तब मिस्पामा भएका बाँकी रहेका मानिसहरू, राजाका छोरीहरू र त्यहाँ छोडिएका सबै मानिसहरू, जसमाथि राजकीय सेनापति नबूजरदानले अहीकामका छोरा गदल्याहलाई नियुक्त गरेका थिए, तिनीहरू सबैलाई इश्माएलले कैदी बनाए। नतन्याहका छोराले तिनीहरूलाई कैदी बनाएर अम्मोनीहरूको इलाकामा जानलाई हिँडे।<verse eid="JER 41:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 41:11"/>जब कारेहका छोरा योहानान र तिनीसँग भएका सेनाका सबै अधिकारीहरूले नतन्याहका छोरा इश्माएलले गरेका सबै अपराधहरूको बारेमा सुने; <verse eid="JER 41:11"/><verse number="12" style="v" sid="JER 41:12"/>तब तिनीहरूले आफ्ना सबै मानिसहरू लिएर नतन्याहका छोरा इश्माएलसँग लडाइँ गर्न गए। तिनीहरूले इश्माएललाई गिबोनमा भएको ठूलो पोखरीको नजिकै भेट्टाए। <verse eid="JER 41:12"/><verse number="13" style="v" sid="JER 41:13"/>जब इश्माएलसँग भएका सबै मानिसहरूले कारेहका छोरा योहानान र तिनीसँग भएका सबै सेनाका अधिकारीहरूलाई देखे, तब तिनीहरू आनन्दित भए। <verse eid="JER 41:13"/><verse number="14" style="v" sid="JER 41:14"/>इश्माएलले मिस्पाबाट कैद गरेर ल्याएका सबै मानिसहरू कारेहका छोरा योहानानतिर फर्केर गए। <verse eid="JER 41:14"/><verse number="15" style="v" sid="JER 41:15"/>तर नतन्याहका छोरा इश्माएल र तिनका आठ जना मानिसहरू योहानानबाट उम्केर अम्मोनीहरूको देशमा भागेर गए।<verse eid="JER 41:15"/></para>
  <para style="s1">इजिप्टतिर पलायन</para>
  <para style="p">
    <verse number="16" style="v" sid="JER 41:16"/>तब कारेहका छोरा योहानान र तिनीसँग भएका सेनाका सबै अधिकारीहरूले मिस्पाबाट बाँचेर आएका सबै मानिसहरूलाई फर्काएर लगे, जसलाई नतन्याहका छोरा इश्माएलले गदल्याहलाई मारेपछि बन्दी बनाएका थिए। इश्माएलबाट योहानानले तिनीहरूलाई छुटाएर ल्याएका थिए। ती मानिसहरू यिनै थिए: सेनाहरू र अहीकामले गिबोनबाट ल्याएका स्त्रीहरू, केटाकेटीहरू र अदालतका अधिकारीहरू। <verse eid="JER 41:16"/><verse number="17" style="v" sid="JER 41:17"/>अनि तिनीहरू बेबिलोनीहरूदेखि उम्कन इजिप्ट जाने बाटोमा बेथलेहेमको छेउमा गेरूत किमहाममा बास बसे। <verse eid="JER 41:17"/><verse number="18" style="v" sid="JER 41:18"/>तिनीहरू बेबिलोनीहरूसँग डराएका थिए; किनकि नतन्याहका छोरा इश्माएलले अहीकामका छोरा गदल्याहलाई मारेका थिए, जसलाई बेबिलोनका राजाले देशमाथि राज्यपाल नियुक्त गरेका थिए।<verse eid="JER 41:18"/></para>
  <chapter eid="JER 41"/>
  <chapter number="42" style="c" sid="JER 42"/>
  <para style="p">
    <verse number="1" style="v" sid="JER 42:1"/>तब सेनाका सबै अधिकारीहरू, कारेहका छोरा योहानान, होशायाहका छोरा याजन्याह, र साना दर्जादेखि लिएर ठूला दर्जासम्मका सबै मानिसहरू <verse eid="JER 42:1"/><verse number="2" style="v" sid="JER 42:2"/>अगमवक्ता यर्मियाकहाँ गएर तिनलाई भने, “कृपया, हाम्रो बिन्ती सुन्‍नुहोस् र हामी सबै बाँचेकाहरूका निम्ति याहवेह तपाईंका परमेश्‍वरसँग प्रार्थना गरिदिनुहोस्। किनकि तपाईं आफैँले अहिले देख्नुभएझैँ, हामी एक समयमा धेरै भए तापनि अहिले हामी सानो अवशेषको रूपमा छौँ। <verse eid="JER 42:2"/><verse number="3" style="v" sid="JER 42:3"/>याहवेह तपाईंका परमेश्‍वरले हामीलाई कुन बाटो हिँड्नुपर्ने हो, र हामीले के गर्नुपर्ने हो, सो कुरा बताइदेऊन् भनी प्रार्थना गरिदिनुहोस्।”<verse eid="JER 42:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 42:4"/>यर्मिया अगमवक्ताले जवाफ दिए, “मैले तिमीहरूका कुरा सुनेँ। निश्‍चय नै तिमीहरूले अनुरोध गरेझैँ म याहवेह तिमीहरूका परमेश्‍वरसँग प्रार्थना गर्नेछु। याहवेहले भन्‍नुभएको हरेक कुरा म तिमीहरूलाई बताउनेछु, र म तिमीहरूसँग कुनै पनि कुरा लुकाउनेछैनँ।”<verse eid="JER 42:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 42:5"/>तब तिनीहरूले यर्मियालाई भने, “यदि हामीले याहवेह तपाईंका परमेश्‍वरले तपाईंलाई भन्‍न पठाउनुभएको हरेक कुराअनुसार गरेनौँ भने याहवेह नै हाम्रा विरुद्धमा साँचो र विश्‍वासयोग्य साक्षी होऊन्। <verse eid="JER 42:5"/><verse number="6" style="v" sid="JER 42:6"/>याहवेह हाम्रा परमेश्‍वर, जसकहाँ हामी तपाईंलाई पठाइरहेका छौँ; उहाँको आज्ञा चाहे मनपर्ने होस् वा मन नपर्ने होस्, हामी सो पालन गर्नेछौँ, ताकि हाम्रो भलाइ होस्, किनकि हामी याहवेह हाम्रा परमेश्‍वरको आज्ञापालन गर्नेछौँ।”<verse eid="JER 42:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 42:7"/>अनि दश दिनपछि याहवेहको वचन यर्मियाकहाँ आयो। <verse eid="JER 42:7"/><verse number="8" style="v" sid="JER 42:8"/>यसकारण तिनले कारेहका छोरा योहानान र तिनीसँग भएका सेनाका सबै अधिकारीहरू र साना दर्जादेखि ठूला दर्जासम्मका सबै मानिसहरूलाई बोलाए। <verse eid="JER 42:8"/><verse number="9" style="v" sid="JER 42:9"/>यर्मियाले तिनीहरूलाई भने, “याहवेह इस्राएलका परमेश्‍वर यसो भन्‍नुहुन्छ, जसकहाँ तिमीहरूले मलाई आफ्ना बिन्ती चढाउन पठाएका थियौ: <verse eid="JER 42:9"/><verse number="10" style="v" sid="JER 42:10"/>‘यदि तिमीहरू यस देशमै रह्‍यौ भने म तिमीहरूलाई निर्माण गर्नेछु, तर तिमीहरूलाई भत्काउनेछैनँ। म तिमीहरूलाई रोप्नेछु, तर तिमीहरूलाई उखेल्नेछैनँ; किनकि मैले तिमीहरूमाथि ल्याएको ठूलो विपत्तिको कारण म दुःखित छु। <verse eid="JER 42:10"/><verse number="11" style="v" sid="JER 42:11"/>बेबिलोनको राजा, जससँग तिमीहरू अहिले डराउँछौ, त्यससँग नडराओ। याहवेह घोषणा गर्नुहुन्छ, बेबिलोनको राजादेखि नडराओ; किनकि म तिमीहरूको साथमा छु र म तिमीहरूलाई बचाउनेछु। अनि तिमीहरूलाई उसको हातबाट छुटाउनेछु। <verse eid="JER 42:11"/><verse number="12" style="v" sid="JER 42:12"/>म तिमीहरूमाथि दया देखाउनेछु, ताकि उसले तिमीहरूमाथि दया देखाउनेछ, र उसले तिमीहरूलाई तिमीहरूको देशमा पुनर्स्थापित गर्नेछ।’<verse eid="JER 42:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 42:13"/>“तापनि यदि तिमीहरूले यसो भन्यो भने, ‘हामी यस देशमा बस्‍नेछैनौँ;’ अनि यसरी याहवेह तिमीहरूका परमेश्‍वरको आज्ञापालन गरेनौ भने, <verse eid="JER 42:13"/><verse number="14" style="v" sid="JER 42:14"/>र यदि तिमीहरूले यसो भन्छौ भने, ‘होइन, हामी इजिप्टमा गएर बस्‍नेछौँ, जहाँ हामी युद्ध देख्नेछैनौँ, अथवा तुरहीको आवाज सुन्‍नेछैनौँ, अथवा रोटीको निम्ति भोको रहनेछैनौँ;’ <verse eid="JER 42:14"/><verse number="15" style="v" sid="JER 42:15"/>त्यसकारण हे यहूदाका बाँकिरहेका मानिसहरू हो, याहवेहको वचन सुन। सेनाहरूका याहवेह, इस्राएलका परमेश्‍वर यसो भन्‍नुहुन्छ: ‘यदि तिमीहरूले इजिप्टमा जान पक्‍का गरेका छौ र त्यहाँ बसोबास गर्न जान चाहन्छौ भने, <verse eid="JER 42:15"/><verse number="16" style="v" sid="JER 42:16"/>तब तिमीहरू डराएका ती तरवारले तिमीहरूलाई त्यस देशमा खेदेर भेट्टाउनेछ; अनि तिमीहरू डराएको अनिकालले तिमीहरूलाई इजिप्टसम्म पछ्याउनेछ, तब तिमीहरू त्यहीँ नै मर्नेछौ। <verse eid="JER 42:16"/><verse number="17" style="v" sid="JER 42:17"/>निश्‍चय नै इजिप्टमा गएर बसोबास गर्न चाहने सबै जना तरवार, अनिकाल र रूढीले मर्नेछन्। मैले तिनीहरूमाथि ल्याउने विपत्तिबाट तिनीहरूमध्ये एक जना पनि बाँच्नेछैन।’ <verse eid="JER 42:17"/><verse number="18" style="v" sid="JER 42:18"/>सेनाहरूका याहवेह, इस्राएलका परमेश्‍वर यसो भन्‍नुहुन्छ: ‘जसरी मेरो रिस र क्रोध यरूशलेममा बस्‍नेहरूमाथि खन्याइएको छ, त्यसरी नै तिमीहरू इजिप्टमा जाँदा मेरो क्रोध तिमीहरूमाथि खनिनेछ। तिमीहरू श्राप र त्रास, दोष र निन्दाका पात्रहरू बन्‍नेछौ। तिमीहरूले यो ठाउँ फेरि कहिल्यै पनि देख्नेछैनौ।’<verse eid="JER 42:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 42:19"/>“हे यहूदाका बाँकी रहेकाहरू हो, याहवेहले तिमीहरूलाई, ‘इजिप्टमा नजाओ,’ भन्‍नुभएको छ। तिमीहरूले यो कुरा स्पष्‍टसँग बुझिराख; आज म तिमीहरूलाई चेतावनी दिँदैछु; <verse eid="JER 42:19"/><verse number="20" style="v" sid="JER 42:20"/>किनकि तिमीहरूले मलाई याहवेह तिमीहरूका परमेश्‍वरकहाँ पठाएर ‘हाम्रा निम्ति याहवेह हाम्रा परमेश्‍वरसँग प्रार्थना गरिदिनुहोस्। उहाँले भन्‍नुभएको सबै कुरा हामीलाई बताइदिनुहोस्, र हामी त्यो पालन गर्नेछौँ,’ भनेर तिमीहरूले ठूलो भूल गरेका छौ। <verse eid="JER 42:20"/><verse number="21" style="v" sid="JER 42:21"/>उहाँले तिमीहरूलाई भन्‍नू भनेर मलाई पठाउनुभएका सबै कुराहरू आज मैले तिमीहरूलाई बताएको छु, तर तिमीहरूले याहवेह आफ्ना परमेश्‍वरको आज्ञा अझै पनि पालन गरेका छैनौ। <verse eid="JER 42:21"/><verse number="22" style="v" sid="JER 42:22"/>यसकारण अब यो पक्‍का गरी जानिराख: जुन ठाउँमा तिमीहरू गएर बसोबास गर्न चाहन्छौ, त्यस ठाउँमा तिमीहरू तरवार, अनिकाल र रूढीले मर्नेछौ।”<verse eid="JER 42:22"/></para>
  <chapter eid="JER 42"/>
  <chapter number="43" style="c" sid="JER 43"/>
  <para style="p">
    <verse number="1" style="v" sid="JER 43:1"/>जब यर्मियाले मानिसहरूलाई याहवेह तिनीहरूका परमेश्‍वरले तिनीहरूलाई भन्‍नू भनेर पठाउनुभएको प्रत्येक कुराहरू तिनले भनिसिद्ध्याए, <verse eid="JER 43:1"/><verse number="2" style="v" sid="JER 43:2"/>तब होशायाहका छोरा अजर्याह, कारेहका छोरा योहानान र सबै अहङ्कारी मानिसहरूले यर्मियालाई यसो भने, “तिमीले झूट बोलिरहेका छौ! याहवेह हाम्रा परमेश्‍वरले तिमीलाई ‘तिमीहरू इजिप्टमा बसोबास गर्नलाई जाँदै नजानू’ भनेर भन्‍न पठाउनुभएको होइन; <verse eid="JER 43:2"/><verse number="3" style="v" sid="JER 43:3"/>तर बेबिलोनीहरूले हामीलाई मारून् अथवा हामीलाई कैद गरेर बेबिलोनमा लैजाऊन् भनी नेरियाहका छोरा बारूकले तिमीलाई हाम्रो विरुद्धमा बेबिलोनीहरूको हातमा हामीलाई सुम्पिदिन उस्काउँदैछ।”<verse eid="JER 43:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 43:4"/>यसकारण कारेहका छोरा योहानान, सेनाका सबै अधिकारीहरू र सबै मानिसहरूले यहूदाको देशमै बस्‍नू भन्‍ने परमेश्‍वरको आज्ञापालन गरेनन्। <verse eid="JER 43:4"/><verse number="5" style="v" sid="JER 43:5"/>त्यसको सट्टा यहूदाका बाँकी रहेका सबै मानिसहरू, जो अरू देशमा तितरबितर भएका थिए; अनि अहिले यहूदामा बस्‍नलाई फर्केर आएका थिए, तिनीहरूलाई कारेहका छोरा योहानान र सेनाका सबै अधिकारीहरूले आफूसितै लगे। <verse eid="JER 43:5"/><verse number="6" style="v" sid="JER 43:6"/>राजकीय अङ्गरक्षकका सेनापति नबूजरदानले शापानका नाति अहीकामका छोरा गदल्याहको जिम्मामा छोडेकाहरू—पुरुषहरू, स्त्रीहरू, केटाकेटीहरू र राजाका छोरीहरू, यर्मिया अगमवक्ता र नेरियाहका छोरा बारूकसमेत सबै मानिसहरूसँगै तिनीहरूले लगे। <verse eid="JER 43:6"/><verse number="7" style="v" sid="JER 43:7"/>यसरी तिनीहरू याहवेहको आज्ञा उल्‍लङ्घन गर्दै इजिप्टमा प्रवेश गरे, र तहपनेससम्म पुगे।<verse eid="JER 43:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 43:8"/>तहपनेसमा याहवेहको वचन यर्मियाकहाँ आयो: <verse eid="JER 43:8"/><verse number="9" style="v" sid="JER 43:9"/>“यहूदीहरूले हेरिरहेका बेला, तैँले आफूसँग केही ठूला ढुङ्गाहरू लिनू, र तहपनेसमा भएको फारोको राजमहलको प्रवेशद्वारको बाटोमा छापेका इँटामुनिको माटोमा ती ढुङ्गालाई गाडिदिनू। <verse eid="JER 43:9"/><verse number="10" style="v" sid="JER 43:10"/>त्यसपछि तिनीहरूलाई यसो भन्‍नू, ‘सेनाहरूका याहवेह, इस्राएलका परमेश्‍वर यसो भन्‍नुहुन्छ: हेर, म मेरो सेवक बेबिलोनको राजा नबूकदनेसरलाई ल्याउनेछु र यस ठाउँमा पठाउनेछु; अनि म त्यसको सिंहासन मैले गाडेका यी ढुङ्गाहरूमाथि खडा गर्नेछु। त्यसले आफ्नो राजकीय मण्डप यसमाथि फैलाउनेछ। <verse eid="JER 43:10"/><verse number="11" style="v" sid="JER 43:11"/>तब त्यो आउनेछ र त्यसले इजिप्टमाथि आक्रमण गर्नेछ; अनि मृत्युको निम्ति छुट्याइएकाहरूमा मृत्यु नै आउनेछ, कैदको निम्ति छुट्याइएकाहरू कैदमा नै जानेछन्, र तरवारका निम्ति छुट्याइएकाहरू तरवारले काटिनेछन्। <verse eid="JER 43:11"/><verse number="12" style="v" sid="JER 43:12"/>त्यसले इजिप्टका देवताहरूका मन्दिरहरूमा आगो लगाइदिनेछ, र तिनीहरूका मन्दिरहरू जलाइदिनेछ; अनि तिनीहरूका देवताहरूलाई कैद गरेर लैजानेछ। जसरी गोठालाले आफ्नो लुगालाई सफा गर्न जुम्रा निकालेर फ्याँक्छ, त्यसरी नै त्यसले इजिप्टलाई निकालेर सफा गरेर सुरक्षितसाथ बाटो लाग्नेछ। <verse eid="JER 43:12"/><verse number="13" style="v" sid="JER 43:13"/>त्यहाँ इजिप्टमा भएको सूर्यको मन्दिरका पवित्र खम्बाहरूलाई ढालिदिनेछ; अनि इजिप्टका देवताहरूका मन्दिरहरूलाई आगोले भस्म पारिदिनेछ।’ ”<verse eid="JER 43:13"/></para>
  <chapter eid="JER 43"/>
  <chapter number="44" style="c" sid="JER 44"/>
  <para style="s1">मूर्तिपूजाको कारण विपत्ति</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 44:1"/>इजिप्टको तल्‍लो भाग मिग्दोल, तहपनेस र मेम्फिसमा र माथिल्‍लो इजिप्टमा बस्‍ने सबै यहूदीहरूको विषयमा याहवेहको यो वचन यर्मियाकहाँ आयो: <verse eid="JER 44:1"/><verse number="2" style="v" sid="JER 44:2"/>“सेनाहरूका याहवेह, इस्राएलका परमेश्‍वर यसो भन्‍नुहुन्छ: मैले यरूशलेम र यहूदाका सबै सहरहरूमाथि ल्याएको ठूलो विपत्ति तिमीहरूले देखेका छौ। आज ती उजाड र ध्वस्त अवस्थामा छन्। <verse eid="JER 44:2"/><verse number="3" style="v" sid="JER 44:3"/>तिमीहरूले गरेको दुष्‍टताको कारणले त्यो भएको थियो। किनकि न तिमीहरूले, न त तिमीहरूका पुर्खाहरूले कहिल्यै चिनेका वा जानेका अन्य देवताहरूका निम्ति धूप बालेर तिनीहरूलाई पुजेर तिनीहरूले मलाई क्रोधित तुल्याए। <verse eid="JER 44:3"/><verse number="4" style="v" sid="JER 44:4"/>मैले तिमीहरूकहाँ घरी-घरी मेरा सेवक अगमवक्ताहरूलाई पठाएँ, जसले तिमीहरूलाई भने, ‘मैले घृणा गर्ने यी घिनलाग्दा कामहरू नगर!’ <verse eid="JER 44:4"/><verse number="5" style="v" sid="JER 44:5"/>तर तिनीहरूले न मेरो कुरा सुने, न त ध्यान नै दिए; न तिनीहरू आफ्ना दुष्‍टताबाट फर्के, न अरू देवताहरूलाई धूप बाल्न नै छाडे। <verse eid="JER 44:5"/><verse number="6" style="v" sid="JER 44:6"/>यसकारण मेरो डरलाग्दो रिसको ज्वाला खनियो; यसले यहूदाका सहरहरू र यरूशलेमका सहरहरू भस्म पार्‍यो; अनि ती ठाउँहरूलाई उजाड र भस्म पारियो, जस्तो आजको दिनसम्म छँदैछ।<verse eid="JER 44:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 44:7"/>“यसकारण याहवेह सेनाहरूका परमेश्‍वर, इस्राएलका परमेश्‍वर, यसो भन्‍नुहुन्छ: किन तिमीहरू आफ्नो कुनै अवशेष नै नरहने गरी यहूदाबाट पुरुषहरू र स्त्रीहरू, केटाकेटीहरू र दुधे बालबालिकाहरूलाई नष्‍ट गरेर, आफूमाथि भयङ्कर विपत्ति ल्याउन चाहन्छौ? <verse eid="JER 44:7"/><verse number="8" style="v" sid="JER 44:8"/>तिमीहरू बस्‍न आएको इजिप्टमा आफ्नै हातले बनाएका मूर्तिहरूले अरू देवताहरूलाई धूप बालेर मलाई किन रिस उठाउँछौ? यसो गर्‍यौ भने तिमीहरूले आफूलाई सर्वनाश गर्नेछौ; अनि पृथ्वीमा सबै जातिहरूका बीचमा आफूलाई श्राप र घृणाको पात्र बनाउनेछौ। <verse eid="JER 44:8"/><verse number="9" style="v" sid="JER 44:9"/>के तिमीहरूले आफ्ना पितापुर्खाहरूले गरेका दुष्‍टता, यहूदाका राजा र रानीहरूले गरेका दुष्‍टता, तिमीहरूका पत्नीहरूले गरेका दुष्‍टता बिर्स्यौ, जुन यहूदाको देशमा र यरूशलेमका सडकहरूमा गरेका थिए? <verse eid="JER 44:9"/><verse number="10" style="v" sid="JER 44:10"/>आजको दिनसम्म तिनीहरूले आफूलाई विनम्र तुल्याएका छैनन्, अथवा मप्रति आदर देखाएका छैनन्, न त मैले तिमीहरू र तिमीहरूका पुर्खाहरूको अगि स्थापित गरेका व्यवस्था र विधिहरू नै तिनीहरूले पालन गरेका छन्।<verse eid="JER 44:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 44:11"/>“यसकारण सेनाहरूका याहवेह, इस्राएलका परमेश्‍वर, यसो भन्‍नुहुन्छ: हेर, मैले तिमीहरूमाथि विपत्ति ल्याउन र सम्पूर्ण यहूदालाई नाश गर्ने निर्णय लिएको छु। <verse eid="JER 44:11"/><verse number="12" style="v" sid="JER 44:12"/>इजिप्टमा गएर त्यहीँ बसोबास गर्ने निश्‍चय गरेका यहूदाका बाँकी रहेका मानिसहरू सबैलाई म नष्‍ट गर्नेछु। तिनीहरू सबै इजिप्टमा नष्‍ट हुनेछन्; तिनीहरू तरवारद्वारा ढल्नेछन् अथवा अनिकालले मर्नेछन्। सानादेखि लिएर ठूलासम्मका सबै मानिसहरू तरवार अथवा अनिकालले मर्नेछन्। तिनीहरू श्राप, त्रास र निन्दाको पात्र हुनेछन्। <verse eid="JER 44:12"/><verse number="13" style="v" sid="JER 44:13"/>जसरी मैले यरूशलेमलाई दण्ड दिएँ, त्यसरी नै म इजिप्टमा गएर बस्‍नेहरूलाई तरवार, अनिकाल र रूढी पठाएर दण्ड दिनेछु। <verse eid="JER 44:13"/><verse number="14" style="v" sid="JER 44:14"/>यहूदाका बाँकी रहेका मानिसहरू, जो इजिप्टमा बसोबास गर्नलाई गएका छन्; तिनीहरू कसैले यहूदाको मुलुकमा फर्केर बस्‍ने इच्छा गरे तापनि फर्कनेछैनन्; तिनीहरूमध्ये ती उम्केकाहरूबाहेक कोही पनि फर्कन पाउनेछैनन्।”<verse eid="JER 44:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 44:15"/>त्यसपछि आफ्ना पत्नीहरूले अरू देवताहरूलाई धूप बालेका थाहा पाउने मानिसहरू र त्यहाँ उपस्थित भएका अरू सबै स्त्रीहरू सहितको एउटा ठूलो जमात, तल्‍लो र माथिल्‍लो इजिप्टमा बस्‍ने सबै इस्राएलीहरूले यर्मियालाई भने, <verse eid="JER 44:15"/><verse number="16" style="v" sid="JER 44:16"/>“तिमीले याहवेहको नाममा हामीसँग बोलेको सन्देश हामी सुन्‍नेछैनौँ! <verse eid="JER 44:16"/><verse number="17" style="v" sid="JER 44:17"/>हामीले गर्छौँ भनेका सबै कुरा हामी अवश्य गर्नेछौँ: हामी र हाम्रा पितापुर्खाहरू, हाम्रा राजाहरू र हाम्रा अधिकारीहरूले यहूदाका सहरहरूमा र यरूशलेमका सडकहरूमा पहिले गरेझैँ, हामी स्वर्गकी रानीलाई धूप बाँल्नेछौँ र तिनलाई अर्घबलि चढाउनेछौँ। त्यस बेला हामीसँग प्रशस्त भोजन थियो र हामी सम्पन्‍न थियौँ; अनि हामीमाथि कुनै विपत्ति आएको थिएन। <verse eid="JER 44:17"/><verse number="18" style="v" sid="JER 44:18"/>तर हामीले स्वर्गकी रानीलाई धूप बाल्न र तिनलाई अर्घबलि चढाउन छोडेदेखि उसो, हामीलाई चाहिने कुरा हामीसँग केही पनि रहेन; अनि हामी तरवार र अनिकालले नष्‍ट भइरहेका छौँ।”<verse eid="JER 44:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 44:19"/>ती स्त्रीहरूले थप्दै यसो भने, “जब हामीले स्वर्गकी रानीलाई धूप बाल्दा र तिनलाई अर्घबलि चढाउँदा के हाम्रा पतीहरूले हामीले तिनको मूर्तिको आकारमा फुरौला बनाउँदैछौँ, र तिनलाई अर्घबलि चढाउँदैछौँ भन्‍ने कुरा जान्दैनथिए र?”<verse eid="JER 44:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 44:20"/>तब यर्मियालाई जवाफ दिने पुरुषहरू र स्त्रीहरू सबैलाई तिनले यसो भने, <verse eid="JER 44:20"/><verse number="21" style="v" sid="JER 44:21"/>“तिमीहरू, तिमीहरूका पितापुर्खाहरू, तिमीहरूका राजाहरू र तिमीहरूका अधिकारीहरूले यहूदाका सहरहरू र यरूशलेमका सडकहरूमा जलाएको धूपको बारेमा के याहवेहले बिर्सनुभएको छ अनि के यो कुरा उहाँलाई थाहा छैन र? <verse eid="JER 44:21"/><verse number="22" style="v" sid="JER 44:22"/>जब तिमीहरूले गरेका तिमीहरूका दुष्‍ट र घिनलाग्दा कामहरूलाई याहवेहले अझ सहन सक्नुभएन, तब तिमीहरूको देश श्रापित भयो र कुनै बासिन्दा नरहने गरी उजाड भयो, जुन आजको दिनसम्म त्यस्तै छ। <verse eid="JER 44:22"/><verse number="23" style="v" sid="JER 44:23"/>तिमीहरूले धूप बालेर याहवेहको विरुद्धमा पाप गरेका छौ, उहाँका आज्ञापालन गरेका छैनौ, र उहाँको व्यवस्थाका आदेशहरू अथवा उहाँका सल्‍लाहहरू अथवा नियमहरू पालन गरेका छैनौँ। यसकारण यो ठूलो विपत्ति तिमीहरूमाथि आएको छ, जुन विपत्ति आज तिमीहरू देख्दैछौ।”<verse eid="JER 44:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 44:24"/>त्यसपछि यर्मियाले सबै मानिसहरू र ती स्त्रीहरूलाई भने, “हे इजिप्टमा भएका सबै यहूदाका मानिसहरू हो, याहवेहको वचन सुन। <verse eid="JER 44:24"/><verse number="25" style="v" sid="JER 44:25"/>सेनाहरूका याहवेह, इस्राएलका परमेश्‍वर यसो भन्‍नुहुन्छ: तिमीहरू र तिमीहरूका पत्नीहरूले जे गर्छौ भनी शपथ खाएका थियौ, ‘हामी स्वर्गकी रानीलाई धूप बाल्नेछौँ र अर्घबलि चढाउनेछौँ भनी हामीले खाएको शपथ हामी अवश्य पूरा गर्नेछौँ।’</para>
  <para style="p" vid="JER 44:25">“त्यसैले तिमीहरू अगि बढ, तिमीहरूले प्रतिज्ञा गरेको कुरा गर! आफ्नो भाकल पूरा गर! <verse eid="JER 44:25"/><verse number="26" style="v" sid="JER 44:26"/>तर इजिप्टमा बस्‍ने हे सबै यहूदीहरू हो, तिमीहरूले याहवेहको वचन सुन: ‘म मेरो महान् नामको शपथ खान्छु,’ याहवेह भन्‍नुहुन्छ, ‘इजिप्टको कुनै पनि ठाउँमा बस्‍ने यहूदाबाटका मानिसहरू कसैलाई पनि मेरो नाममा, “जीवित प्रभु याहवेहको नाममा शपथ खान्छु” भनेर कहिल्यै पुकार्न दिनेछैन, अथवा शपथ खान दिनेछैन।’ <verse eid="JER 44:26"/><verse number="27" style="v" sid="JER 44:27"/>किनकि मैले तिनीहरूमाथि भलाइको निम्ति होइन, तर खराबीको निम्ति हेर्दैछु; तिनीहरू सबै पूरै नाश नभएसम्म इजिप्टमा रहेका यहूदीहरू तरवार र अनिकालले नष्‍ट हुनेछन्। <verse eid="JER 44:27"/><verse number="28" style="v" sid="JER 44:28"/>तरवारबाट उम्कने थोरै मानिसहरू मात्र इजिप्टबाट यहूदाको देशमा फर्कनेछन्। तब इजिप्टमा बसोबास गर्न आउने यहूदाका सबै बाँकी रहेका अवशेषहरूले कसको वचन अटल रहनेछ—मेरो वा तिनीहरूको भनी जान्‍नेछन्।<verse eid="JER 44:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JER 44:29"/>“ ‘तिमीहरूका निम्ति चिन्ह यो हुनेछ, यस ठाउँमा म तिमीहरूलाई दण्ड दिनेछु;’ याहवेह घोषणा गर्नुहुन्छ, ‘ताकि तिमीहरूको विरुद्धमा खराबी गर्ने मेरो धम्की निश्‍चय नै पूरा हुनेछ।’ <verse eid="JER 44:29"/><verse number="30" style="v" sid="JER 44:30"/>याहवेह यसो भन्‍नुहुन्छ: ‘जसरी मैले यहूदाका राजा सिदकियाह र उसलाई मार्न चाहने शत्रु बेबिलोनको राजा नबूकदनेसरको हातमा सुम्पिदिएँ, त्यसरी नै म इजिप्टको राजा फारो होप्रालाई पनि त्यसलाई मार्न चाहने शत्रुहरूका हातमा सुम्पिदिनेछु।’ ”<verse eid="JER 44:30"/></para>
  <chapter eid="JER 44"/>
  <chapter number="45" style="c" sid="JER 45"/>
  <para style="s1">बारूकका निम्ति सन्देश</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 45:1"/>जब नेरियाहका छोरा बारूकले यहूदाका राजा योशियाहका छोरा यहोयाकीमको शासनकालको चौथो वर्षमा यर्मियाले भनेका वचनहरू एउटा चर्मपत्रमा लेखे, तब यर्मिया अगमवक्ताले बारूकलाई यसो भने: <verse eid="JER 45:1"/><verse number="2" style="v" sid="JER 45:2"/>“याहवेह इस्राएलका परमेश्‍वरले, तिमीलाई यसो भन्‍नुहुन्छ, बारूक: <verse eid="JER 45:2"/><verse number="3" style="v" sid="JER 45:3"/>तैँले भनिस् ‘धिक्‍कार छ मलाई! याहवेहले मेरो दुःखमा पीडा थपिदिनुभएको छ; म सुस्केरा मार्दा-मार्दा थकित भएको छु र मलाई कतै पनि आराम छैनँ।’ ” <verse eid="JER 45:3"/><verse number="4" style="v" sid="JER 45:4"/>तर याहवेहले मलाई तिमीलाई यसो भन् भनेर भन्‍नुभएको छ, “याहवेह यसो भन्‍नुहुन्छ: ‘मैले जे बनाएको छु, त्यो म भत्काउनेछु, मैले देशभरि जे रोपेको छु, त्यो म उखेलिदिनेछु। <verse eid="JER 45:4"/><verse number="5" style="v" sid="JER 45:5"/>त्यसो भए के तैँलेचाहिँ आफ्नो निम्ति महान् कुराहरू खोज्दैछस्? ती कुराहरू नखोज्। याहवेह घोषणा गर्नुहुन्छ; किनकि म सबै मानिसहरूमाथि विपत्ति ल्याउनेछु, तर तँ जहाँ गए तापनि म तँलाई लुटको मालसरह जीवितै उम्कन दिनेछु।’ ”<verse eid="JER 45:5"/></para>
  <chapter eid="JER 45"/>
  <chapter number="46" style="c" sid="JER 46"/>
  <para style="s1">इजिप्टको बारेमा सन्देश</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 46:1"/>राष्ट्रहरूको बारेमा यर्मिया अगमवक्ताकहाँ आएको याहवेहको वचन यही हो:<verse eid="JER 46:1"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="2" style="v" sid="JER 46:2"/>इजिप्टको सम्बन्धमा:</para>
  <para style="b" vid="JER 46:2"/>
  <para style="p" vid="JER 46:2">यहूदाका राजा योशियाहका छोरा, यहोयाकीमको शासनकालको चौथो वर्षमा, बेबिलोनका राजा नबूकदनेसरद्वारा यूफ्रेटिस नदीको कर्कमीशमा पराजित भएका इजिप्टका राजा फारो नेकोका सेनाको विरुद्धमा आएको सन्देश यही हो:<verse eid="JER 46:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 46:3"/>“तेरा ठूला र साना दुवै ढालहरू तयार गर्;</para>
  <para style="q2" vid="JER 46:3">अनि युद्ध गर्नका निम्ति मोर्चा बाँधेर अगि बढ्!<verse eid="JER 46:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 46:4"/>घोडाहरूमा जीन-लगाम कस्,</para>
  <para style="q2" vid="JER 46:4">र घोडाहरूमाथि चढ्!</para>
  <para style="q1" vid="JER 46:4">लडाइँका टोप लगाएर</para>
  <para style="q2" vid="JER 46:4">आफ्नो पङ्‌क्तिमा खडा हो!</para>
  <para style="q1" vid="JER 46:4">आफ्ना भालाहरू टल्का;</para>
  <para style="q2" vid="JER 46:4">आफ्ना हातहतियारहरूले सुसज्जित हो!<verse eid="JER 46:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 46:5"/>तर म के देख्दैछु?</para>
  <para style="q2" vid="JER 46:5">ती इजिप्टियन सेनाहरू त्रसित भएका छन्;</para>
  <para style="q1" vid="JER 46:5">तिनीहरू पछि हट्दैछन्;</para>
  <para style="q2" vid="JER 46:5">तिनीहरूका योद्धाहरू हारेका छन्।</para>
  <para style="q1" vid="JER 46:5">तिनीहरू पछाडि नहेरी हतार-हतार भाग्दैछन्;</para>
  <para style="q2" vid="JER 46:5">अनि त्यहाँ चारैतिर त्रास नै त्रास फैलिएको छ,”</para>
  <para style="q2" vid="JER 46:5">याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 46:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 46:6"/>“चाँडो भाग्ने पनि भाग्न सक्दैन,</para>
  <para style="q2" vid="JER 46:6">न त योद्धाहरू नै उम्कन सक्छन्।</para>
  <para style="q1" vid="JER 46:6">उत्तर दिशामा यूफ्रेटिस नदीको किनारमा</para>
  <para style="q2" vid="JER 46:6">तिनीहरू ठक्‍कर खानेछन् र लड्नेछन्।<verse eid="JER 46:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="JER 46:7"/>“नील नदीजस्तै बढेर आउने,</para>
  <para style="q2" vid="JER 46:7">नदीहरूको बाढीझैँ उर्लेर आउने त्यो को हो?<verse eid="JER 46:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 46:8"/>नील नदीजस्तै बढेर आउने,</para>
  <para style="q2" vid="JER 46:8">पानीको नदीजस्तै उर्लेर आउने त्यो इजिप्ट हो।”</para>
  <para style="q1" vid="JER 46:8">इजिप्टले भन्छे, “म उठ्नेछु र पृथ्वीलाई ढाकिदिनेछु;</para>
  <para style="q2" vid="JER 46:8">म सहरहरू र तिनीहरूका मानिसहरूलाई नाश गरिदिनेछु।”<verse eid="JER 46:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 46:9"/>हे घोडाहरू हो, आक्रमण गर!</para>
  <para style="q2" vid="JER 46:9">हे रथ हाक्नेहरू हो, वेगसँग अगाडि बढ!</para>
  <para style="q1" vid="JER 46:9">हे योद्धाहरू हो, अगि बढ। ढाल बोक्ने कूश र पूतका मानिसहरू,</para>
  <para style="q2" vid="JER 46:9">धनु हान्‍न सिपालु लूदीमका मानिसहरू अगि बढ।<verse eid="JER 46:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 46:10"/>तर त्यो दिन प्रभु, सेनाहरूका याहवेहको दिन हो।</para>
  <para style="q2" vid="JER 46:10">बदलाको दिन, उहाँको शत्रुहरूमाथि बदला लिने दिन हो।</para>
  <para style="q1" vid="JER 46:10">तरवार सन्तुष्‍ट नभएसम्म त्यसले नाश गर्नेछ;</para>
  <para style="q2" vid="JER 46:10">रगतले तिर्खा नमेटेसम्म त्यो चल्नेछ।</para>
  <para style="q1" vid="JER 46:10">किनकि सेनाहरूका याहवेहले उत्तरको देशलाई</para>
  <para style="q2" vid="JER 46:10">यूफ्रेटिस नदीको किनारमा बलिदान चढाउनुहुनेछ।<verse eid="JER 46:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="JER 46:11"/>“हे इजिप्टकी कन्या छोरी,</para>
  <para style="q2" vid="JER 46:11">माथि गिलादमा गएर मलम ली,</para>
  <para style="q1" vid="JER 46:11">तर तैँले व्यर्थैमा धेरै औषधीहरू प्रयोग गरिस्;</para>
  <para style="q2" vid="JER 46:11">तँ निको हुनेछैनस्।<verse eid="JER 46:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 46:12"/>राष्ट्रहरूले तेरो अपमानको बारेमा सुन्‍नेछन्;</para>
  <para style="q2" vid="JER 46:12">तेरो रोदन पृथ्वीभरि सुनिनेछ।</para>
  <para style="q1" vid="JER 46:12">एउटा योद्धा अर्कोमाथि ठक्‍कर खानेछ;</para>
  <para style="q2" vid="JER 46:12">दुवै योद्धा एकसाथ जमिनमा लोट्नेछन्।”<verse eid="JER 46:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 46:13"/>बेबिलोनका राजा नबूकदनेसरले इजिप्टलाई आक्रमण गर्न आउने बारेमा याहवेहले यर्मिया अगमवक्तासँग बोल्नुभएको सन्देश यही हो:<verse eid="JER 46:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 46:14"/>“यो सन्देश इजिप्टमा भन्, र यसलाई मिग्दोलमा घोषणा गर्;</para>
  <para style="q2" vid="JER 46:14">यसलाई मेम्फिसमा र तहपनेसमा पनि घोषणा गर्:</para>
  <para style="q1" vid="JER 46:14">‘आफ्नो सुरक्षाको निम्ति आ-आफ्ना स्थानमा तयार होओ;</para>
  <para style="q2" vid="JER 46:14">किनकि तेरा चारैतिर भएकाहरूलाई तरवारले नाश गर्नेछ।’<verse eid="JER 46:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 46:15"/>तेरा योद्धाहरू किन सोत्तर हुनेछन्?</para>
  <para style="q2" vid="JER 46:15">तिनीहरू खडा हुन सक्दैनन्; किनकि याहवेहले तिनीहरूलाई जमिनमा ठेलिदिनुहुनेछ।<verse eid="JER 46:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 46:16"/>तिनीहरू घरी-घरी ठक्‍कर खानेछन्;</para>
  <para style="q2" vid="JER 46:16">तिनीहरू एक-अर्कामाथि लड्नेछन्।</para>
  <para style="q1" vid="JER 46:16">तिनीहरूले भन्‍नेछन्, ‘उठ, हामी शत्रुहरूका</para>
  <para style="q2" vid="JER 46:16">तरवारदेखि टाढा आफ्नै मानिसहरूकहाँ</para>
  <para style="q2" vid="JER 46:16">र आफ्नो जन्मभूमिमा फर्केर जाऔँ।’<verse eid="JER 46:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 46:17"/>त्यहाँ तिनीहरू चिच्याउनेछन्,</para>
  <para style="q2" vid="JER 46:17">‘इजिप्टका राजा फारो चर्को आवाज मात्र हो;</para>
  <para style="q2" vid="JER 46:17">फारोले आफ्नो मौका गुमाएको छ।’<verse eid="JER 46:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="JER 46:18"/>“म जीवित भएझैँ,” राजाले यसरी घोषणा गर्नुहुन्छ,</para>
  <para style="q2" vid="JER 46:18">जसको नाम सेनाहरूका याहवेह हो,</para>
  <para style="q1" vid="JER 46:18">पहाडहरूमध्ये उच्‍च तबोरजस्तै,</para>
  <para style="q2" vid="JER 46:18">समुद्रभन्दा उच्‍च कर्मेल पर्वतजस्तै एक जना शक्तिशाली आउनुहुनेछ।<verse eid="JER 46:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 46:19"/>हे इजिप्टमा बस्‍ने मानिसहरू हो,</para>
  <para style="q2" vid="JER 46:19">तिमीहरू कैदमा जान आ-आफ्ना सरसामानहरू पोको पार;</para>
  <para style="q1" vid="JER 46:19">किनकि मेम्फिस उजाड हुनेछ,</para>
  <para style="q2" vid="JER 46:19">र कोही पनि नबस्‍ने रुखो भग्नावशेष हुनेछ।<verse eid="JER 46:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="JER 46:20"/>“इजिप्ट एउटी सुन्दरी कोरली हो,</para>
  <para style="q2" vid="JER 46:20">तर त्यसको विरुद्धमा</para>
  <para style="q2" vid="JER 46:20">उत्तर दिशाबाट एउटा डाँस आउँदैछ।<verse eid="JER 46:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 46:21"/>त्यसका ज्यालादार सिपाहीहरू</para>
  <para style="q2" vid="JER 46:21">मोटाएर पोसिएका बाछाहरूजस्तै छन्।</para>
  <para style="q1" vid="JER 46:21">तिनीहरू एकसाथ पीठ फर्काएर भाग्नेछन्;</para>
  <para style="q2" vid="JER 46:21">तिनीहरू आफ्नो स्थानमा खडा भएर लड्दैनन्;</para>
  <para style="q1" vid="JER 46:21">किनकि तिनीहरूका निम्ति दण्ड पाउने समय आएको छ;</para>
  <para style="q2" vid="JER 46:21">तिनीहरूमाथि विपत्तिका दिनहरू आउँदैछन्।<verse eid="JER 46:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 46:22"/>जब शत्रुहरू अगि बढ्दै आउँछन्,</para>
  <para style="q2" vid="JER 46:22">तब भाग्ने सर्पझैँ सुलुलु आवाज इजिप्टले निकाल्नेछ;</para>
  <para style="q1" vid="JER 46:22">तिनीहरू त्यसको विरुद्धमा रूख काट्ने मानिसहरूझैँ</para>
  <para style="q2" vid="JER 46:22">बन्चरो लिएर आउनेछन्।”<verse eid="JER 46:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 46:23"/>याहवेह घोषणा गर्नुहुन्छ, “तिनीहरूका जङ्गलहरू जति नै बाक्लो भए तापनि</para>
  <para style="q2" vid="JER 46:23">तिनीहरूले ती काटेर ढालिदिनेछन्।</para>
  <para style="q1" vid="JER 46:23">तिनीहरू संख्यामा सलहभन्दा धेरै छन्,</para>
  <para style="q2" vid="JER 46:23">तिनीहरू अनगन्ती छन्।<verse eid="JER 46:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 46:24"/>इजिप्टकी छोरी शर्ममा पर्नेछे;</para>
  <para style="q2" vid="JER 46:24">त्यसलाई उत्तर दिशाबाट आएका शत्रुहरूका हातमा सुम्पिइनेछ।”<verse eid="JER 46:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JER 46:25"/>सेनाहरूका याहवेह, इस्राएलका परमेश्‍वर भन्‍नुहुन्छ: “म थेबेसको देवता अमोन, फारो, इजिप्ट र यसका देवताहरू र यसका राजाहरू र फारोमाथि भरोसा राख्नेहरूमाथि दण्ड ल्याउन लागेको छु। <verse eid="JER 46:25"/><verse number="26" style="v" sid="JER 46:26"/>म तिनीहरूलाई मार्न चाहनेहरूका हातमा—बेबिलोनको राजा नबूकदनेसर र त्यसका अधिकारीहरूको हातमा सुम्पिदिनेछु। त्यसपछि इजिप्टमा पहिलेजस्तै मानिसहरू बसोबास गर्नेछन्,” याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 46:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JER 46:27"/>“हे मेरो सेवक याकोब, तँ नडरा!</para>
  <para style="q2" vid="JER 46:27">हे इस्राएल निरुत्साहित नहो।</para>
  <para style="q1" vid="JER 46:27">म निश्‍चय नै तँलाई टाढाको ठाउँबाट</para>
  <para style="q2" vid="JER 46:27">तेरा सन्तानहरूलाई तिनीहरूका बेबिलोनको कैदबाट बचाउनेछु।</para>
  <para style="q1" vid="JER 46:27">याकोब फेरि शान्ति र सुरक्षामा बस्‍नेछ;</para>
  <para style="q2" vid="JER 46:27">अनि कसैले पनि इस्राएललाई डर देखाउन सक्नेछैन।<verse eid="JER 46:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JER 46:28"/>हे मेरो सेवक याकोब, तँ भयभीत नहो;</para>
  <para style="q2" vid="JER 46:28">किनकि म तँसँग छु,”</para>
  <para style="q2" vid="JER 46:28">याहवेह घोषणा गर्नुहुन्छ।</para>
  <para style="q1" vid="JER 46:28">“मैले तँलाई जुन राष्ट्रहरूको बीचमा छरपस्ट पारेँ,</para>
  <para style="q2" vid="JER 46:28">मैले ती राष्ट्रहरूलाई सम्पूर्ण रूपले नाश गरे तापनि</para>
  <para style="q2" vid="JER 46:28">तँलाईचाहिँ पूर्ण रूपले नाश गर्नेछैनँ।</para>
  <para style="q1" vid="JER 46:28">म तँलाई न्यायपूर्वक ताडना दिनेछु;</para>
  <para style="q2" vid="JER 46:28">तर म तँलाई विनादण्ड छोड्छैनँ।”<verse eid="JER 46:28"/></para>
  <chapter eid="JER 46"/>
  <chapter number="47" style="c" sid="JER 47"/>
  <para style="s1">पलिश्तीको बारेमा सन्देश</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 47:1"/>फारोले गाजा सहरमाथि आक्रमण गर्नुअगि पलिश्तीहरूको विषयमा यर्मिया अगमवक्ताकहाँ आएको याहवेहको वचन यही हो:<verse eid="JER 47:1"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="2" style="v" sid="JER 47:2"/>याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="JER 47:2">“हेर, उत्तर दिशामा पानीका छालहरू कसरी उठिरहेका छन्;</para>
  <para style="q2" vid="JER 47:2">तिनीहरू डुबाउने बाढीको भलजस्तै हुनेछन्।</para>
  <para style="q1" vid="JER 47:2">त्यसले जमिन र त्यसमा भएका सबै थोकलाई</para>
  <para style="q2" vid="JER 47:2">सहरहरू र त्यसमा बस्‍नेहरू सबैलाई डुबाउनेछ।</para>
  <para style="q1" vid="JER 47:2">मानिसहरू सहायताको निम्ति चिच्याउनेछन्;</para>
  <para style="q2" vid="JER 47:2">देशमा बस्‍नेहरू सबै विलाप गर्नेछन्,<verse eid="JER 47:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 47:3"/>दौडिरहेका घोडाहरूका खुरहरूको आवाजमा</para>
  <para style="q2" vid="JER 47:3">वेगसित दगुर्ने शत्रुहरूका</para>
  <para style="q2" vid="JER 47:3">रथहरूका चक्‍काका गडगडाहट सुनेर</para>
  <para style="q1" vid="JER 47:3">आमाबुबाहरू आफ्ना छोराछोरीलाई सहायता गर्न फर्केर हेर्नेछैनन्;</para>
  <para style="q2" vid="JER 47:3">तिनीहरूका हातहरू लुला हुनेछन्।<verse eid="JER 47:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 47:4"/>किनकि सबै पलिश्तीहरूलाई</para>
  <para style="q2" vid="JER 47:4">नाश गर्ने दिन आएको छ,</para>
  <para style="q1" vid="JER 47:4">टायर र सीदोनलाई सहायता दिन सक्ने</para>
  <para style="q2" vid="JER 47:4">बाँचेकाहरू सबैलाई नष्‍ट गर्ने दिन आएको छ।</para>
  <para style="q1" vid="JER 47:4">याहवेहले कप्‍तोरका<note caller="+" style="f"><char style="fr" closed="false">47:4 </char><char style="ft" closed="false">अर्थात्, क्रेट</char></note> किनारमा</para>
  <para style="q2" vid="JER 47:4">बाँकी रहेका सबै पलिश्तीहरूलाई नष्‍ट गर्न लाग्नुभएको छ।<verse eid="JER 47:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 47:5"/>गाजाले शोकमा आफ्नो कपाल खौरनेछ;</para>
  <para style="q2" vid="JER 47:5">अश्कलोन मौन हुनेछ।</para>
  <para style="q1" vid="JER 47:5">हे तराईका अवशेष हो,</para>
  <para style="q2" vid="JER 47:5">तँ कहिलेसम्म आफूलाई चोट पारिरहन्छस्?”<verse eid="JER 47:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="JER 47:6"/>रुँदै तैँले भन्‍नेछस्,</para>
  <para style="q2" vid="JER 47:6">“ ‘ओह, याहवेहको तरवार, तँ कहिले शान्त हुन्छस्?</para>
  <para style="q1" vid="JER 47:6">ए तरवार, तँ आफ्नो म्यानमा फर्किजा,</para>
  <para style="q2" vid="JER 47:6">र शान्तसँग बस्।’<verse eid="JER 47:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 47:7"/>तर यो कसरी शान्त बस्‍न सक्छ?</para>
  <para style="q2" vid="JER 47:7">किनकि याहवेहले यसलाई</para>
  <para style="q1" vid="JER 47:7">अश्कलोन र समुद्री किनारको विरोधमा</para>
  <para style="q2" vid="JER 47:7">आक्रमण गर्न आदेश दिनुभएको छ।”<verse eid="JER 47:7"/></para>
  <chapter eid="JER 47"/>
  <chapter number="48" style="c" sid="JER 48"/>
  <para style="s1">मोआबको विषयमा सन्देश</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 48:1"/>मोआबको विषयमा:</para>
  <para style="b" vid="JER 48:1"/>
  <para style="p" vid="JER 48:1">सेनाहरूका याहवेह, इस्राएलका परमेश्‍वर, यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="JER 48:1">“धिक्‍कार नेबोलाई! किनकि त्यो नष्‍ट हुनेछ,</para>
  <para style="q2" vid="JER 48:1">किर्यातैम अपमानित हुनेछ र कब्जा गरिनेछ;</para>
  <para style="q2" vid="JER 48:1">शत्रुहरूले तिनीहरूको बलियो गढ नष्‍ट गरेर चकनाचुर पार्नेछन्।<verse eid="JER 48:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 48:2"/>मोआबको प्रशंसा फेरि कहिल्यै हुनेछैन;</para>
  <para style="q2" vid="JER 48:2">हेश्बोनमा मानिसहरूले मोआबको विरुद्धमा पतनको षड्यन्त्र गर्दछन्:</para>
  <para style="q2" vid="JER 48:2">‘आओ, हामी त्यस राष्ट्रको अस्तित्व मेटिदिऔँ।’</para>
  <para style="q1" vid="JER 48:2">हे मदमेनका मानिसहरू, तँलाई पनि चुप गराइनेछ;</para>
  <para style="q2" vid="JER 48:2">तँलाई तरवारले खेद्नेछ।<verse eid="JER 48:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 48:3"/>होरोनैमबाट पीडाको चीत्कार उठ्नेछ,</para>
  <para style="q2" vid="JER 48:3">ठूलो विध्वंस र सर्वनाशको चीत्कार।<verse eid="JER 48:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 48:4"/>मोआब नष्‍ट हुनेछ;</para>
  <para style="q2" vid="JER 48:4">त्यसका बालकहरू चर्को सोरले रुनेछन्।<verse eid="JER 48:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 48:5"/>तिनीहरू दुःखी भएर रुँदै</para>
  <para style="q2" vid="JER 48:5">लूहीत सहरतिर जाने उकालोमा चढ्नेछन्;</para>
  <para style="q1" vid="JER 48:5">होरोनैमतिर झर्ने ओरालो बाटोमा</para>
  <para style="q2" vid="JER 48:5">सर्वनाशको कारण दर्दनाक चीत्कार सुनिन्छन्।<verse eid="JER 48:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JER 48:6"/>भाग! आफ्नो जीवन बचाउनलाई दौड;</para>
  <para style="q2" vid="JER 48:6">मरुभूमिमा भएको पोथ्राजस्तै होओ।<verse eid="JER 48:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 48:7"/>किनकि तिमीहरूले आफ्ना कामहरू र धनसम्पत्तिहरूमा भरोसा राखेका कारण,</para>
  <para style="q2" vid="JER 48:7">तिमीहरू पनि कैदमा लगिनेछौ;</para>
  <para style="q1" vid="JER 48:7">अनि कमोश देवता आफ्ना पुजारीहरू</para>
  <para style="q2" vid="JER 48:7">र अधिकारीहरूसँग निर्वासनमा जानेछ।<verse eid="JER 48:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 48:8"/>विनाशकर्ता प्रत्येक सहरको विरुद्धमा आउनेछ;</para>
  <para style="q2" vid="JER 48:8">अनि एउटै सहर पनि उम्कनेछैन।</para>
  <para style="q1" vid="JER 48:8">उपत्यका ध्वस्त हुनेछ,</para>
  <para style="q2" vid="JER 48:8">र बेँसी नष्‍ट पारिनेछ;</para>
  <para style="q2" vid="JER 48:8">किनकि याहवेहले भन्‍नुभएको छ।<verse eid="JER 48:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 48:9"/>मोआबमा नुन छरिदेओ;</para>
  <para style="q2" vid="JER 48:9">किनकि त्यो उजाड हुनेछ<note caller="+" style="f"><char style="fr" closed="false">48:9 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">मोआबलाई पखेटा देओ, ताकि उडेर टाढा जाओस्।</char></note>;</para>
  <para style="q1" vid="JER 48:9">त्यसका सहरहरू कोही पनि नबस्‍ने गरी</para>
  <para style="q2" vid="JER 48:9">उजाड हुनेछन्।<verse eid="JER 48:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="JER 48:10"/>“याहवेहको काममा लापर्बाही गर्ने व्यक्ति श्रापित होस्!</para>
  <para style="q2" vid="JER 48:10">तिनीहरूको तरवारलाई रक्तपात गर्न नदिने व्यक्ति श्रापित होस्!<verse eid="JER 48:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="JER 48:11"/>“मोआब त्यसको युवाअवस्थादेखि नै आराममा छ;</para>
  <para style="q2" vid="JER 48:11">एउटा भाँडाबाट अर्को भाँडामा नखन्याई</para>
  <para style="q1" vid="JER 48:11">भाँडामा छोडिराखेको दाखमद्यजस्तै,</para>
  <para style="q2" vid="JER 48:11">अर्थात् मोआब निर्वासनमा गएकी छैन।</para>
  <para style="q1" vid="JER 48:11">त्यसको स्वाद पहिलेको जस्तै छ;</para>
  <para style="q2" vid="JER 48:11">अनि त्यसको वासना बदलिएको छैन।”<verse eid="JER 48:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 48:12"/>यसकारण, “हेर, दिनहरू आउँदैछन्,” याहवेह घोषणा गर्नुहुन्छ,</para>
  <para style="q1" vid="JER 48:12">जब म मानिसहरू पठाउनेछु, जसले मशकबाट दाखमद्य खन्याउनेछन्,</para>
  <para style="q2" vid="JER 48:12">त्यसरी नै तिनीहरूले मोआबलाई पोखाइदिनेछन्;</para>
  <para style="q1" vid="JER 48:12">तिनीहरूले त्यसका मशकहरू रित्याइदिनेछन्,</para>
  <para style="q2" vid="JER 48:12">र त्यसका मशकहरू चकनाचुर पारिदिनेछन्।<verse eid="JER 48:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 48:13"/>जसरी इस्राएलीहरूले बेथेल झूटो देवतामाथि भरोसा गर्दा</para>
  <para style="q2" vid="JER 48:13">इस्राएलको घराना लाजमा परेको थियो,</para>
  <para style="q2" vid="JER 48:13">त्यसरी नै मोआब पनि कमोश देवताको कारण लज्जित हुनेछ।<verse eid="JER 48:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="JER 48:14"/>“तिमीहरूले कसरी भन्‍न सक्छौ,</para>
  <para style="q2" vid="JER 48:14">‘हामी लडाइँका वीर योद्धाहरू वा बहादुर मानिसहरू हौँ?’<verse eid="JER 48:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 48:15"/>मोआब नष्‍ट हुनेछ र त्यसका सहरहरूमा आक्रमण गरिनेछ;</para>
  <para style="q2" vid="JER 48:15">त्यसका अति असल जवानहरू शत्रुहरूले काटेर मर्नेछन्,”</para>
  <para style="q2" vid="JER 48:15">राजाले घोषणा गर्नुहुन्छ, जसको नाम सेनाहरूका याहवेह हो।<verse eid="JER 48:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 48:16"/>“मोआबको पतन नजिकै आइपुगेको छ;</para>
  <para style="q2" vid="JER 48:16">त्यसको विनाश चाँडै आउनेछ।<verse eid="JER 48:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 48:17"/>त्यसका वरिपरि बस्‍नेहरू,</para>
  <para style="q2" vid="JER 48:17">त्यसको ख्याति थाहा पाउनेहरू सबैले त्यसको निम्ति शोक गर;</para>
  <para style="q1" vid="JER 48:17">र यसो भन, ‘शक्तिशाली राजदण्ड कसरी तोडिएको छ,</para>
  <para style="q2" vid="JER 48:17">गौरवशाली राज्यको लहुरो कसरी भाँचिएको छ!’<verse eid="JER 48:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="JER 48:18"/>“हे दीबोन सहरकी छोरीहरू वा बासिन्दाहरू हो,</para>
  <para style="q2" vid="JER 48:18">तिमीहरूका गौरवको उचाइबाट ओर्लेर आओ,</para>
  <para style="q2" vid="JER 48:18">र सुक्खा धुलोमा बस;</para>
  <para style="q1" vid="JER 48:18">किनकि मोआबलाई विनाश गर्ने शत्रुहरू</para>
  <para style="q2" vid="JER 48:18">तिमीहरूको विरुद्धमा आउनेछन्,</para>
  <para style="q2" vid="JER 48:18">र तिमीहरूका सुरक्षित सहरहरू ध्वस्त पारिदिनेछन्।<verse eid="JER 48:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 48:19"/>हे अरोएरका बासिन्दाहरू हो,</para>
  <para style="q2" vid="JER 48:19">सडकको छेउमा खडा होओ र ध्यानसित हेर।</para>
  <para style="q1" vid="JER 48:19">भाग्दै गरेका मानिसहरू र उम्कँदै गरेकी स्त्रीहरूलाई सोध,</para>
  <para style="q2" vid="JER 48:19">तिनीहरूलाई, ‘के भयो?’ भनेर सोध।<verse eid="JER 48:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 48:20"/>मोआब अपमानित भएकी छे; किनकि ऊ चकनाचुर पारिएकी छे;</para>
  <para style="q2" vid="JER 48:20">विलाप गर र रोओ!</para>
  <para style="q1" vid="JER 48:20">अर्नोन नदीको छेउमा गएर बताइदेओ,</para>
  <para style="q2" vid="JER 48:20">मोआब नष्‍ट पारिएकी छे।<verse eid="JER 48:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 48:21"/>उच्‍च पठारमाथि न्याय आएको छ—</para>
  <para style="q2" vid="JER 48:21">अर्थात् होलोन, यहसा र मेपातमाथि,<verse eid="JER 48:21"/></para>
  <para style="q2">
    <verse number="22" style="v" sid="JER 48:22"/>दीबोन, नेबो र बेथ-दिब्लातैममाथि,<verse eid="JER 48:22"/></para>
  <para style="q2">
    <verse number="23" style="v" sid="JER 48:23"/>किर्यातैम, बेथ-गामूल र बेथ-मोनमाथि,<verse eid="JER 48:23"/></para>
  <para style="q2">
    <verse number="24" style="v" sid="JER 48:24"/>किर्योत र बोज्रामाथि—</para>
  <para style="q2" vid="JER 48:24">मोआबका टाढा र नजिकका सबै सहरहरूमाथि न्याय आएको छ।<verse eid="JER 48:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 48:25"/>मोआबको सिङ<note caller="+" style="f"><char style="fr" closed="false">48:25 </char><char style="fq" closed="false">सिङ </char><char style="ft" closed="false">यहाँ शक्ति भन्‍ने जनाउँछ।</char></note> काटियो;</para>
  <para style="q2" vid="JER 48:25">त्यसको पाखुरा भाँचिएको छ,”</para>
  <para style="q2" vid="JER 48:25">याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 48:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="JER 48:26"/>“मोआबलाई दाखमद्यले मताओ;</para>
  <para style="q2" vid="JER 48:26">किनकि त्यसले याहवेहको विरुद्धमा विद्रोह गरेको छ।</para>
  <para style="q1" vid="JER 48:26">मोआबलाई त्यसकै बान्तामा लडीबुडी गर्न देओ;</para>
  <para style="q2" vid="JER 48:26">मोआबलाई हाँसोको पात्र हुन देओ।<verse eid="JER 48:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JER 48:27"/>ए मोआब, के तैँले इस्राएलको हाँसो उडाएको थिइनस् र?</para>
  <para style="q2" vid="JER 48:27">के त्यो चोरहरूसँग पक्राउ परेकी थिई,</para>
  <para style="q1" vid="JER 48:27">त्यसको बारेमा कुरा गर्दा</para>
  <para style="q2" vid="JER 48:27">त्यसको ठट्टा गर्दै तैँले आफ्नो टाउको हल्‍लाउने गर्थिस्?<verse eid="JER 48:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JER 48:28"/>ए मोआबमा बस्‍नेहरू हो, तिमीहरूले आफ्ना सहरहरू छोडेर</para>
  <para style="q2" vid="JER 48:28">चट्टानको ओडारहरूमा बस।</para>
  <para style="q1" vid="JER 48:28">तिमीहरू ओडारको मुखमा</para>
  <para style="q2" vid="JER 48:28">आफ्नो गुँड बनाउने ढुकुरजस्तै होओ।<verse eid="JER 48:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="JER 48:29"/>“हामीले मोआबको घमण्डको बारेमा सुनेका छौँ—</para>
  <para style="q2" vid="JER 48:29">त्यसको घमण्ड अति ठूलो छ!</para>
  <para style="q1" vid="JER 48:29">त्यसको अहङ्कार, त्यसको घमण्ड र अभिमान;</para>
  <para style="q2" vid="JER 48:29">अनि त्यसका हृदयको सेखीको बारेमा सुनेका छौँ।<verse eid="JER 48:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JER 48:30"/>‘म त्यसको अहङ्कार जान्दछु,</para>
  <para style="q2" vid="JER 48:30">तर त्यसको अहङ्कार व्यर्थको छ,’ याहवेह घोषणा गर्नुहुन्छ;</para>
  <para style="q2" vid="JER 48:30">अनि त्यसको घमण्डले केही गर्न सक्दैन।<verse eid="JER 48:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JER 48:31"/>यसकारण म मोआबको निम्ति बिलौना गर्छु;</para>
  <para style="q2" vid="JER 48:31">किनकि म सम्पूर्ण मोआबको निम्ति रुन्छु;</para>
  <para style="q2" vid="JER 48:31">म कीर-हरेशेतका मानिसहरूका निम्ति विलाप गर्छु।<verse eid="JER 48:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JER 48:32"/>म याजेरको निम्ति भन्दा तेरो निम्ति धेरै रुन्छु;</para>
  <para style="q2" vid="JER 48:32">हे सिब्माका दाखका बोटहरू,</para>
  <para style="q1" vid="JER 48:32">तेरा हाँगाहरू समुद्रसम्म पुगेका छन्;</para>
  <para style="q2" vid="JER 48:32">ती हाँगाहरू याजेरसम्मै पुगेका छन्।</para>
  <para style="q1" vid="JER 48:32">विनाशकर्ताहरू</para>
  <para style="q2" vid="JER 48:32">तेरा पाकेका फलहरू र अङ्‌गुरहरूमाथि आइलागेका छन्।<verse eid="JER 48:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="JER 48:33"/>मोआबका बगैँचाहरू र खेतबारीहरूबाट</para>
  <para style="q2" vid="JER 48:33">आनन्द र खुशीयाली गइसकेका छन्।</para>
  <para style="q1" vid="JER 48:33">मैले कोलहरूबाट रस बग्न बन्द गरिदिएको छु;</para>
  <para style="q2" vid="JER 48:33">कसैले पनि आनन्दको आवाजसँग ती पेल्दैनन्।</para>
  <para style="q1" vid="JER 48:33">यद्यपि त्यहाँ चर्को आवाजमा कराइरहेका छन्,</para>
  <para style="q2" vid="JER 48:33">तर ती आवाजहरू खुशीका होइनन्।<verse eid="JER 48:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="JER 48:34"/>“हेश्बोनदेखि एलाले र यहससम्म</para>
  <para style="q2" vid="JER 48:34">सोअरदेखि टाढा होरोनैम र एग्लत-शलीशियाहसम्म नै</para>
  <para style="q1" vid="JER 48:34">तिनीहरूको चीत्कारको आवाज सुनिन्छ;</para>
  <para style="q2" vid="JER 48:34">किनकि निम्रीमको पानीसमेत सुकिसकेको छ।<verse eid="JER 48:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="JER 48:35"/>म मोआबका अग्ला-अग्ला ठाउँहरूमा भेटी चढाउनेहरू</para>
  <para style="q2" vid="JER 48:35">र तिनीहरूका देवताहरूलाई धूप बाल्नेहरूको</para>
  <para style="q2" vid="JER 48:35">अन्त्य गरिदिनेछु,” याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 48:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="JER 48:36"/>“यसकारण मोआबका निम्ति मेरो हृदयले बाँसुरीको सोरजस्तै विलाप गर्छ;</para>
  <para style="q2" vid="JER 48:36">यसले कीर-हरेशेतका मानिसहरूको निम्ति बाँसुरीजस्तै विलाप गर्छ।</para>
  <para style="q2" vid="JER 48:36">तिनीहरूले आर्जन गरेका धनसम्पत्ति सबै नष्‍ट भएको छ।<verse eid="JER 48:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="JER 48:37"/>हरेक मानिसको कपाल खौरिएको छ,</para>
  <para style="q2" vid="JER 48:37">र हरेक मानिसको दाह्री काटिएको छ;</para>
  <para style="q1" vid="JER 48:37">हरेक हात ताछिएको छ,</para>
  <para style="q2" vid="JER 48:37">र हरेक कम्मरमा भाङ्ग्रा बेरिएको छ।<verse eid="JER 48:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="JER 48:38"/>मोआबका सबै छानाहरूमा</para>
  <para style="q2" vid="JER 48:38">र सबै सार्वजनिक चोकहरूमा</para>
  <para style="q1" vid="JER 48:38">मानिसहरूको विलापबाहेक त्यहाँ अरू केही छैन;</para>
  <para style="q2" vid="JER 48:38">किनकि मैले मोआबलाई कसैले मन नपराएको</para>
  <para style="q2" vid="JER 48:38">भाँडालाई जस्तै फुटाइदिएको छु,” याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 48:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="JER 48:39"/>“मोआब कति छरपस्ट भएको छ! तिनीहरू कसरी विलाप गर्दैछन्!</para>
  <para style="q2" vid="JER 48:39">मोआब लाजले कसरी आफ्नो पिठिउँ फर्काउँछ!</para>
  <para style="q1" vid="JER 48:39">मोआब एक हाँसोको पात्र भएको छ,</para>
  <para style="q2" vid="JER 48:39">त्यसको वरिपरि भएका सबै राष्ट्रहरूका निम्ति एक त्रासको पात्र बनेको छ।”<verse eid="JER 48:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JER 48:40"/>याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="JER 48:40">“हेर! एउटा चील आफ्ना पखेटा फैलाएर</para>
  <para style="q2" vid="JER 48:40">मोआबमाथि वेगसित आउँदैछ।<verse eid="JER 48:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="JER 48:41"/>किर्योत सहर कब्जा गरिनेछ,</para>
  <para style="q2" vid="JER 48:41">र बलिया किल्‍लाहरू लिइनेछन्।</para>
  <para style="q1" vid="JER 48:41">त्यस दिन मोआबका योद्धाहरूका हृदय</para>
  <para style="q2" vid="JER 48:41">प्रसव-वेदनामा परेकी स्त्रीको हृदयजस्तै हुनेछ।<verse eid="JER 48:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="JER 48:42"/>मोआब राष्ट्र नाश हुनेछ;</para>
  <para style="q2" vid="JER 48:42">किनकि त्यसले याहवेहको अवहेलना गरेको छ।<verse eid="JER 48:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="JER 48:43"/>हे मोआबका मानिसहरू हो,</para>
  <para style="q2" vid="JER 48:43">तिमीहरूलाई त्रास, खाडल र पासोले पर्खिरहेका छन्,”</para>
  <para style="q2" vid="JER 48:43">याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 48:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="JER 48:44"/>“जो आतङ्कबाट भाग्छ,</para>
  <para style="q2" vid="JER 48:44">त्यो खाडलमा खस्‍नेछ;</para>
  <para style="q1" vid="JER 48:44">जो खाडलबाट बाहिर निस्कन्छ,</para>
  <para style="q2" vid="JER 48:44">त्यो पासोमा पर्नेछ;</para>
  <para style="q1" vid="JER 48:44">किनकि म मोआबमाथि</para>
  <para style="q2" vid="JER 48:44">त्यसको दण्डको वर्ष ल्याउनेछु,”</para>
  <para style="q2" vid="JER 48:44">याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 48:44"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="45" style="v" sid="JER 48:45"/>“हेश्बोनका छायामा</para>
  <para style="q2" vid="JER 48:45">भाग्नेहरू असहाय भएर उभिन्छन्;</para>
  <para style="q1" vid="JER 48:45">किनकि हेश्बोनबाट आगोबाहिर निस्केको छ;</para>
  <para style="q2" vid="JER 48:45">सीहोनको बीचबाट ज्वाला निस्केको छ;</para>
  <para style="q1" vid="JER 48:45">यसले मोआबका निधारहरू,</para>
  <para style="q2" vid="JER 48:45">दुःख दिने अहङ्कारीहरूका थाप्लाहरू जलाइदिनेछ।<verse eid="JER 48:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="JER 48:46"/>हे मोआब, तँलाई धिक्‍कार छ!</para>
  <para style="q2" vid="JER 48:46">कमोश देवताका मानिसहरू नष्‍ट भएका छन्;</para>
  <para style="q1" vid="JER 48:46">तिमीहरूका छोराहरू निर्वासनमा</para>
  <para style="q2" vid="JER 48:46">र तिमीहरूका छोरीहरू कैदी बनाएर दासत्वमा लगिनेछ।<verse eid="JER 48:46"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="47" style="v" sid="JER 48:47"/>“तरै पनि पछिल्‍ला दिनहरूमा</para>
  <para style="q2" vid="JER 48:47">म मोआबको सुख-शान्ति फर्काइल्याउनेछु,”</para>
  <para style="q2" vid="JER 48:47">याहवेह घोषणा गर्नुहुन्छ।</para>
  <para style="p" vid="JER 48:47">मोआबको न्यायको बारेमा यर्मियाले गरेका अगमवाणी यहीँ समाप्‍त हुन्छ।<verse eid="JER 48:47"/></para>
  <para style="b"/>
  <chapter eid="JER 48"/>
  <chapter number="49" style="c" sid="JER 49"/>
  <para style="s1">अम्मोनको बारेमा सन्देश</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 49:1"/>अम्मोनीहरूको विषयमा:</para>
  <para style="b" vid="JER 49:1"/>
  <para style="p" vid="JER 49:1">याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="JER 49:1">“के इस्राएलका छोराहरू छैनन्?</para>
  <para style="q2" vid="JER 49:1">के त्यसका उत्तराधिकारीहरू छैनन्?</para>
  <para style="q1" vid="JER 49:1">त्यसो भए किन मोलेखले<note caller="+" style="f"><char style="fr" closed="false">49:1 </char><char style="ft" closed="false">अर्थात् </char><char style="fqa" closed="false">तिनीहरूका राजा</char></note> गादमाथि अधिकार जमाएको छ?</para>
  <para style="q2" vid="JER 49:1">उहाँका मानिसहरू किन त्यसका सहरहरूमा बस्छन्?<verse eid="JER 49:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 49:2"/>तर दिनहरू आउँदैछन्,” याहवेह घोषणा गर्नुहुन्छ।</para>
  <para style="q1" vid="JER 49:2">“जब म अम्मोनीहरूका रब्बाको</para>
  <para style="q2" vid="JER 49:2">विरुद्धमा युद्धको ध्वनि सुनाउनेछु;</para>
  <para style="q1" vid="JER 49:2">अनि त्यो एउटा भग्नावशेषको थुप्रो हुनेछ,</para>
  <para style="q2" vid="JER 49:2">र त्यसका चारैतिरका गाउँहरूमा आगो लगाइनेछ।</para>
  <para style="q1" vid="JER 49:2">तब जसले इस्राएललाई धपाएका थिए,</para>
  <para style="q2" vid="JER 49:2">तिनीहरूलाई इस्राएलले धपाउनेछ,”</para>
  <para style="q2" vid="JER 49:2">याहवेह भन्‍नुहुन्छ।<verse eid="JER 49:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 49:3"/>“हे हेश्बोन, विलाप गर्; किनकि ऐ नाश भएको छ!</para>
  <para style="q2" vid="JER 49:3">हे रब्बाका छोरीहरू हो, चर्कोगरी रोओ!</para>
  <para style="q1" vid="JER 49:3">भाङ्ग्रा लगाएर शोक गर;</para>
  <para style="q2" vid="JER 49:3">पर्खालभित्र यताउता दगुर;</para>
  <para style="q1" vid="JER 49:3">किनकि मोलेख आफ्ना पुजारीहरू</para>
  <para style="q2" vid="JER 49:3">र अधिकारीहरूसँग कैदमा जानेछ।<verse eid="JER 49:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 49:4"/>तँ किन आफ्ना उपत्यकाहरूमा घमण्ड गर्छस्?</para>
  <para style="q2" vid="JER 49:4">तँ आफ्ना फलदायक उपत्यकाका निम्ति किन घमण्ड गर्छस्?</para>
  <para style="q1" vid="JER 49:4">हे विश्‍वासीघाती आमोनका छोरी,</para>
  <para style="q2" vid="JER 49:4">तँ आफ्ना धनसम्पत्तिमा भरोसा राख्छेस् र भन्छेस्,</para>
  <para style="q2" vid="JER 49:4">‘हामीलाई कसले आक्रमण गर्ला?’<verse eid="JER 49:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 49:5"/>म तेरा चारैतिरबाट</para>
  <para style="q2" vid="JER 49:5">तँमाथि आतङ्क ल्याउनेछु,”</para>
  <para style="q2" vid="JER 49:5">प्रभु सेनाहरूका याहवेह घोषणा गर्नुहुन्छ।</para>
  <para style="q1" vid="JER 49:5">“तिमीहरू हरेक धपाइनेछौ;</para>
  <para style="q2" vid="JER 49:5">अनि भागेर जानेहरूलाई कसैले पनि भेला गर्नेछैन।<verse eid="JER 49:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="JER 49:6"/>“अनि त्यसपछि म अम्मोनीहरूको सुख-शान्ति फर्काइदिनेछु,”</para>
  <para style="q2" vid="JER 49:6">याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 49:6"/></para>
  <para style="s1">एदोमको बारेमा सन्देश</para>
  <para style="p">
    <verse number="7" style="v" sid="JER 49:7"/>एदोमको विषयमा:</para>
  <para style="b" vid="JER 49:7"/>
  <para style="p" vid="JER 49:7">सेनाहरूका याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="JER 49:7">“के अब तेमानमा बुद्धि छैन?</para>
  <para style="q2" vid="JER 49:7">के बुद्धिमान्‌हरूबाट परामर्श नष्‍ट भएर गएको छ?</para>
  <para style="q2" vid="JER 49:7">के तिनीहरूको बुद्धि भ्रष्‍ट भएकै हो?<verse eid="JER 49:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 49:8"/>हे ददानमा बस्‍नेहरू हो, भाग, फर्केर जाओ!</para>
  <para style="q2" vid="JER 49:8">र गहिरा ओडारहरूमा गएर लुक;</para>
  <para style="q1" vid="JER 49:8">किनकि एसावलाई दण्ड दिने समयमा</para>
  <para style="q2" vid="JER 49:8">म एसावमाथि विपत्ति ल्याउनेछु।<verse eid="JER 49:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 49:9"/>यदि तँकहाँ अङ्‌गुर टिप्नेहरू आए भने,</para>
  <para style="q2" vid="JER 49:9">के तिनीहरूले केही अङ्‌गुरहरू छोड्दैनन् र?</para>
  <para style="q1" vid="JER 49:9">यदि रातको समयमा चोरहरू आए भने,</para>
  <para style="q2" vid="JER 49:9">के तिनीहरूले आफूलाई चाहिए जति मात्र चोर्दैनन् र?<verse eid="JER 49:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 49:10"/>तर म एसावलाई पूर्ण रूपमा नाङ्गो बनाइदिनेछु;</para>
  <para style="q2" vid="JER 49:10">म त्यसका लुक्ने ठाउँहरू उदाङ्गो पारिदिनेछु,</para>
  <para style="q2" vid="JER 49:10">ताकि त्यसले आफूलाई लुकाउन नसकोस्।</para>
  <para style="q1" vid="JER 49:10">त्यसका हतियारधारीहरू</para>
  <para style="q2" vid="JER 49:10">र त्यसका छोराछोरी, आफन्तहरू र छिमेकीहरू नष्‍ट हुनेछन्;</para>
  <para style="q2" vid="JER 49:10">यसकारण यसो भन्‍ने मान्छे कोही पनि हुनेछैन,<verse eid="JER 49:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JER 49:11"/>‘तिमीहरूका टुहुरा-टुहुरीहरूलाई छोडिराख्; म तिनीहरूको हेरचाह गर्नेछु।</para>
  <para style="q2" vid="JER 49:11">तिमीहरूका विधवाहरूले पनि ममाथि भरोसा राखून्।’ ”<verse eid="JER 49:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 49:12"/>याहवेह यसो भन्‍नुहुन्छ: “यदि कोही कचौराबाट पिउन योग्यको नभए तापनि त्यसले पिउनैपर्छ भने, के तँ दण्ड नपाई उम्कनेछस् र? दण्डबाट तँ उम्कनेछैनस्, तर तैँले दण्डको कचौराबाट पिउनैपर्छ। <verse eid="JER 49:12"/><verse number="13" style="v" sid="JER 49:13"/>म आफ्नै नाममा शपथ खान्छु,” याहवेह घोषणा गर्नुहुन्छ, “बोज्रा ध्वस्त हुनेछ; त्यो त्रास, निन्दा र सरापको पात्र हुनेछ; अनि त्यसका सबै सहरहरू सदाका निम्ति ध्वस्त हुनेछन्।”<verse eid="JER 49:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 49:14"/>मैले याहवेहबाट एउटा सन्देश सुनेको छु;</para>
  <para style="q2" vid="JER 49:14">राष्ट्रहरूलाई यसो भन्‍ने एक जना दूत पठाइयो,</para>
  <para style="q1" vid="JER 49:14">“आफ्ना सेनाहरू युद्धको निम्ति भेला गर!</para>
  <para style="q2" vid="JER 49:14">एदोमसँग लडाइँ गर्नका निम्ति तयार होओ!<verse eid="JER 49:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="JER 49:15"/>“हेर्, अब म तँलाई राष्ट्रहरूमध्ये सबैभन्दा सानो तुल्याउनेछु;</para>
  <para style="q2" vid="JER 49:15">तँ मानव-जातिहरू बीच घृणित हुनेछस्।<verse eid="JER 49:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 49:16"/>तेरो डरलाग्दो व्यवहार</para>
  <para style="q2" vid="JER 49:16">र तेरो हृदयको घमण्डले तँलाई धोका दिएको छ;</para>
  <para style="q1" vid="JER 49:16">हे चट्टानका दरारहरूमा बस्‍ने,</para>
  <para style="q2" vid="JER 49:16">हे डाँडाका अग्ला-अग्ला ठाउँहरू ओगट्ने,</para>
  <para style="q1" vid="JER 49:16">तैँले चीलको गुँड झैँ अग्लो ठाउँमा बास बनाए तापनि</para>
  <para style="q2" vid="JER 49:16">म तँलाई त्यहाँबाट तल झारिदिनेछु,”</para>
  <para style="q2" vid="JER 49:16">याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 49:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JER 49:17"/>“एदोम त्रासको पात्र हुनेछ;</para>
  <para style="q2" vid="JER 49:17">त्यसका सबै घाउहरूका कारण</para>
  <para style="q2" vid="JER 49:17">त्यसका छेउबाट भएर जाने हरेक तर्सनेछ, र त्यसलाई खिसी गर्नेछ।<verse eid="JER 49:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 49:18"/>जसरी सदोम र गमोरा तिनीहरूका छेउछाउका</para>
  <para style="q2" vid="JER 49:18">सहरहरूसहित नष्‍ट भएका थिए,” याहवेह भन्‍नुहुन्छ,</para>
  <para style="q1" vid="JER 49:18">“त्यसरी नै त्यहाँ कोही पनि बस्‍नेछैन;</para>
  <para style="q2" vid="JER 49:18">त्यहाँ कोही पनि बसोबास गर्नेछैन।<verse eid="JER 49:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="JER 49:19"/>“हेर, यर्दन नदीका झाडीहरूबाट</para>
  <para style="q2" vid="JER 49:19">हरियो खर्कबाट निस्केर आइरहेको सिंहझैँ, म निस्कनेछु;</para>
  <para style="q1" vid="JER 49:19">र म एदोमलाई झट्टै त्यसकै देशबाट खेद्नेछु।</para>
  <para style="q2" vid="JER 49:19">यस देशको निम्ति जसलाई चुन्छु, उसैलाई नियुक्त गर्नेछु।</para>
  <para style="q1" vid="JER 49:19">मजस्तो को छ र? मलाई कसले चुनौती दिन सक्छ?</para>
  <para style="q2" vid="JER 49:19">अनि कुनचाहिँ गोठालो मेरो विरुद्धमा खडा हुन सक्छ?”<verse eid="JER 49:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="JER 49:20"/>यसकारण एदोमको विरुद्धमा याहवेहको योजना,</para>
  <para style="q2" vid="JER 49:20">र तेमानमा बस्‍नेहरूको विरुद्धमा उहाँको उद्देश्य के छ, त्यो कुरा सुन:</para>
  <para style="q1" vid="JER 49:20">बगालका कलिला पाठाहरूलाई घिसारेर लगिनेछ;</para>
  <para style="q2" vid="JER 49:20">तिनीहरूको खर्क पूर्ण रूपमा उजाड हुनेछ।<verse eid="JER 49:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 49:21"/>तिनीहरूको पतनको आवाजले पृथ्वी थरथर काँप्‍नेछ;</para>
  <para style="q2" vid="JER 49:21">तिनीहरूको चीत्कार लाल समुद्रसम्म गुञ्जिनेछ।<verse eid="JER 49:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 49:22"/>हेर! एउटा चील आफ्ना पखेटा फैलाउँदै वेगसित</para>
  <para style="q2" vid="JER 49:22">बोज्रामाथि झम्टेर आउनेछ।</para>
  <para style="q1" vid="JER 49:22">त्यस दिन एदोमका योद्धाहरूका हृदय</para>
  <para style="q2" vid="JER 49:22">प्रसव-वेदनामा परेकी स्त्रीको हृदयजस्तै हुनेछ।<verse eid="JER 49:22"/></para>
  <para style="s1">दमस्कसको बारेमा सन्देश</para>
  <para style="p">
    <verse number="23" style="v" sid="JER 49:23"/>दमस्कसको विषयमा:</para>
  <para style="q1" vid="JER 49:23">“हमात र अर्पाद हतोत्साहित भएका छन्;</para>
  <para style="q2" vid="JER 49:23">किनकि तिनीहरूले खराब समाचार सुनेका छन्।</para>
  <para style="q1" vid="JER 49:23">तिनीहरू निराश भएका छन्,</para>
  <para style="q2" vid="JER 49:23">अशान्त समुद्रजस्तै विचलित भएका छन्।<verse eid="JER 49:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 49:24"/>दमस्कसका मानिसहरू कमजोर भएका छन्;</para>
  <para style="q2" vid="JER 49:24">तिनीहरू भाग्नलाई पछि फर्केका छन्,</para>
  <para style="q2" vid="JER 49:24">र तिनीहरूलाई त्रासले समातेको छ;</para>
  <para style="q1" vid="JER 49:24">कष्‍ट र वेदनाले तिनीहरूलाई पक्रेको छ,</para>
  <para style="q2" vid="JER 49:24">प्रसव-वेदनामा परेकी स्त्रीको जस्तै पीडाले पक्रेको छ।<verse eid="JER 49:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 49:25"/>त्यो प्रसिद्ध सहर कसरी त्यागिएको छैन;</para>
  <para style="q2" vid="JER 49:25">त्यो सहर जसमा म प्रसन्‍न हुन्छु?<verse eid="JER 49:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JER 49:26"/>निश्‍चय नै तिनीहरूका जवान मानिसहरू सडकहरूमा ढल्नेछन्;</para>
  <para style="q2" vid="JER 49:26">त्यस दिन त्यसका सबै सेनाहरू मारिनेछन्,”</para>
  <para style="q2" vid="JER 49:26">सेनाहरूका याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 49:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JER 49:27"/>“म दमस्कसका पर्खालहरूमा आगो लगाइदिनेछु;</para>
  <para style="q2" vid="JER 49:27">त्यो आगोले बेन-हददको किल्‍लालाई भस्म पारिदिनेछ।”<verse eid="JER 49:27"/></para>
  <para style="s1">केदार र हासोरको बारेमा सन्देश</para>
  <para style="p">
    <verse number="28" style="v" sid="JER 49:28"/>बेबिलोनका राजा नबूकदनेसरले आक्रमण गरेका केदार र हासोरका राज्यहरूको बारेमा:</para>
  <para style="b" vid="JER 49:28"/>
  <para style="p" vid="JER 49:28">याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="JER 49:28">“उठ र केदारलाई आक्रमण गर,</para>
  <para style="q2" vid="JER 49:28">र पूर्वका मानिसहरूलाई नाश गर।<verse eid="JER 49:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JER 49:29"/>तिनीहरूका पालहरू र तिनीहरूका बगालहरू लगिनेछन्;</para>
  <para style="q2" vid="JER 49:29">तिनीहरूका ओत लाग्ने छाप्राहरू,</para>
  <para style="q2" vid="JER 49:29">तिनीहरूका सबै मालसामानहरू र ऊँटहरूसमेत लगिनेछन्।</para>
  <para style="q1" vid="JER 49:29">मानिसहरूले तिनीहरूलाई भन्‍नेछन्,</para>
  <para style="q2" vid="JER 49:29">‘चारैतिर त्रासै-त्रास छ!’<verse eid="JER 49:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="JER 49:30"/>“छिटो टाढा भाग!</para>
  <para style="q2" vid="JER 49:30">हे हासोरमा बस्‍नेहरू हो, तिमीहरू गहिरा ओडारहरूमा बस,”</para>
  <para style="q2" vid="JER 49:30">याहवेह घोषणा गर्नुहुन्छ।</para>
  <para style="q1" vid="JER 49:30">बेबिलोनको राजा नबूकदनेसरले तिमीहरूको विरुद्धमा षड्यन्त्र रचेको छ;</para>
  <para style="q2" vid="JER 49:30">त्यसले तिमीहरूको विरुद्धमा एउटा योजना बनाएको छ।<verse eid="JER 49:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="JER 49:31"/>“उठ र शान्तिमा रहेको राष्ट्रलाई आक्रमण गर,</para>
  <para style="q2" vid="JER 49:31">जो आरामसँग ढुक्‍क भएर बसेको छ,”</para>
  <para style="q2" vid="JER 49:31">याहवेह घोषणा गर्नुहुन्छ।</para>
  <para style="q1" vid="JER 49:31">“एउटा राष्ट्र, जसका न मूलढोकाहरू, न त गजबारहरू नै छन्;</para>
  <para style="q2" vid="JER 49:31">त्यस राष्ट्रका मानिसहरू खतराबाट टाढा बस्छन्।<verse eid="JER 49:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JER 49:32"/>तिनीहरूका ऊँटहरू लुटका माल हुनेछन्;</para>
  <para style="q2" vid="JER 49:32">अनि तिनीहरूका ठूला-ठूला बथानहरू लुटिएका माल हुनेछन्।</para>
  <para style="q1" vid="JER 49:32">म टाढा ठाउँमा रहेकाहरूलाई बतासमा छरपस्ट पारिदिनेछु<note caller="+" style="f"><char style="fr" closed="false">49:32 </char><char style="ft" closed="false">अथवा </char><char style="fqa" closed="false">कन्चटनेरको कपाल खौरनेहरू।</char></note></para>
  <para style="q2" vid="JER 49:32">र म तिनीहरूमाथि चारैतिरबाट विपत्ति ल्याउनेछु,”</para>
  <para style="q2" vid="JER 49:32">याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 49:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="JER 49:33"/>“हासोर सहर स्यालको वासस्थान हुनेछ;</para>
  <para style="q2" vid="JER 49:33">सदाको निम्ति उजाडस्थान बन्‍नेछ।</para>
  <para style="q1" vid="JER 49:33">त्यहाँ कोही पनि बस्‍नेछैन;</para>
  <para style="q2" vid="JER 49:33">त्यहाँ कुनै पनि मानिस बसोबास गर्नेछैन।”<verse eid="JER 49:33"/></para>
  <para style="s1">एलामको बारेमा सन्देश</para>
  <para style="p">
    <verse number="34" style="v" sid="JER 49:34"/>यहूदाका राजा सिदकियाहको शासनकालको सुरुका समयमा एलामको बारेमा अगमवक्ता यर्मियाकहाँ आएको याहवेहको वचन यही हो:<verse eid="JER 49:34"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="35" style="v" sid="JER 49:35"/>सेनाहरूका याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="JER 49:35">“हेर, म एलामको धनु,</para>
  <para style="q2" vid="JER 49:35">तिनीहरूको शक्तिको मुख्य आधार भाँचिदिनेछु।<verse eid="JER 49:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="JER 49:36"/>म एलामको विरुद्धमा आकाशका चारै दिशाबाट</para>
  <para style="q2" vid="JER 49:36">चार वटा बतासहरू ल्याउनेछु;</para>
  <para style="q1" vid="JER 49:36">म तिनीहरूलाई चार वटा बतासहरूमा छरपस्ट पार्नेछु;</para>
  <para style="q2" vid="JER 49:36">अनि एलामबाट निर्वासनमा</para>
  <para style="q2" vid="JER 49:36">नगएको कुनै राष्ट्र हुनेछैन।<verse eid="JER 49:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="JER 49:37"/>म एलामलाई तिनीहरूका शत्रुहरूको सामु चकनाचुर पार्नेछु;</para>
  <para style="q2" vid="JER 49:37">तिनीहरूको शत्रुहरूको सामु, जसले तिनीहरूलाई मार्न चाहन्छन्;</para>
  <para style="q1" vid="JER 49:37">म मेरो भयानक क्रोधमा,</para>
  <para style="q2" vid="JER 49:37">तिनीहरूमाथि विनाश ल्याउनेछु,”</para>
  <para style="q2" vid="JER 49:37">याहवेह घोषणा गर्नुहुन्छ।</para>
  <para style="q1" vid="JER 49:37">“म तिनीहरूलाई पूर्ण रूपले नष्‍ट नपारुन्जेल,</para>
  <para style="q2" vid="JER 49:37">तिनीहरूलाई तरवार लिएर खेद्नेछु।<verse eid="JER 49:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="JER 49:38"/>म एलाममा आफ्नो सिंहासन खडा गर्नेछु;</para>
  <para style="q2" vid="JER 49:38">अनि त्यसका राजा र अधिकारीहरूलाई नाश गर्नेछु,”</para>
  <para style="q2" vid="JER 49:38">याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 49:38"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="39" style="v" sid="JER 49:39"/>“तापनि आउँदा दिनहरूमा</para>
  <para style="q2" vid="JER 49:39">म एलामको सुख-शान्ति फर्काइल्याउनेछु,”</para>
  <para style="q2" vid="JER 49:39">याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 49:39"/></para>
  <chapter eid="JER 49"/>
  <chapter number="50" style="c" sid="JER 50"/>
  <para style="s1">बेबिलोनको बारेमा सन्देश</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 50:1"/>बेबिलोन र बेबिलोनीहरूको देशको विषयमा यर्मिया अगमवक्ताद्वारा याहवेहले बोल्नुभएको वचन यही हो:<verse eid="JER 50:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 50:2"/>“राष्ट्रहरू बीचमा सूचना दे, र घोषणा गर्;</para>
  <para style="q2" vid="JER 50:2">झण्डा उठाएर यो घोषणा गर्;</para>
  <para style="q2" vid="JER 50:2">केही कुरा नलुकाई भनिदे,</para>
  <para style="q1" vid="JER 50:2">‘बेबिलोन कब्जा गरिनेछ;</para>
  <para style="q2" vid="JER 50:2">बेल शर्ममा पर्नेछ,</para>
  <para style="q2" vid="JER 50:2">मारोदक त्रासले भरिनेछ।</para>
  <para style="q1" vid="JER 50:2">त्यसका प्रतिमाहरू लाजमा पारिनेछन्,</para>
  <para style="q2" vid="JER 50:2">र त्यसका मूर्तिहरू त्रासले भरिनेछन्।’<verse eid="JER 50:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 50:3"/>उत्तर दिशाबाट एउटा राष्ट्रले त्यसलाई आक्रमण गर्नेछ,</para>
  <para style="q2" vid="JER 50:3">र त्यसलाई उजाड पारिदिनेछ।</para>
  <para style="q1" vid="JER 50:3">त्यहाँ कोही पनि बस्‍नेछैन;</para>
  <para style="q2" vid="JER 50:3">मानिसहरू र पशुहरू दुवै भागेर जानेछन्।<verse eid="JER 50:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="JER 50:4"/>“ती दिनहरूमा र त्यस समयमा,” याहवेह घोषणा गर्नुहुन्छ,</para>
  <para style="q1" vid="JER 50:4">“इस्राएलका र यहूदाका मानिसहरू एकसाथ</para>
  <para style="q2" vid="JER 50:4">याहवेह तिनीहरूका परमेश्‍वरलाई खोज्न रुँदै जानेछन्।<verse eid="JER 50:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 50:5"/>तिनीहरूले सियोन जाने बाटो सोध्नेछन्</para>
  <para style="q2" vid="JER 50:5">र आफ्ना अनुहार त्यस दिशातिर फर्काउनेछन्।</para>
  <para style="q1" vid="JER 50:5">तिनीहरू आउनेछन् र आफूलाई</para>
  <para style="q2" vid="JER 50:5">अनन्तको करारमा याहवेहसँग बाँध्नेछन्,</para>
  <para style="q2" vid="JER 50:5">जुन कहिल्यै बिर्सिइनेछैन।<verse eid="JER 50:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="JER 50:6"/>“मेरा मानिसहरू हराएका भेडाहरूजस्तै भएका छन्;</para>
  <para style="q2" vid="JER 50:6">तिनीहरूका गोठालाहरूले तिनीहरूलाई कुबाटोतिर लगाएका छन्,</para>
  <para style="q2" vid="JER 50:6">र पर्वततिर डुलिहिँड्ने बनाइदिएका छन्।</para>
  <para style="q1" vid="JER 50:6">तिनीहरू डाँडा र पहाडतिर बरालिएका छन्,</para>
  <para style="q2" vid="JER 50:6">र तिनीहरूले आफ्ना बासस्थानलाई बिर्सेका छन्।<verse eid="JER 50:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 50:7"/>जजसले तिनीहरूलाई भेट्टाए, तिनीहरूलाई निले;</para>
  <para style="q2" vid="JER 50:7">तिनीहरूका शत्रुहरूले भने, ‘हामी दोषी छैनौँ;</para>
  <para style="q1" vid="JER 50:7">किनकि तिनीहरूले याहवेह, तिनीहरूको साँचो खर्क,</para>
  <para style="q2" vid="JER 50:7">याहवेह, तिनीहरूका पितापुर्खाहरूका आशाको विरुद्धमा पाप गरेका छन्।’<verse eid="JER 50:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="JER 50:8"/>“बेबिलोनबाट भाग,</para>
  <para style="q2" vid="JER 50:8">बेबिलोनीहरूको देशलाई छोडेर भाग;</para>
  <para style="q2" vid="JER 50:8">अनि बगाललाई बाटो देखाउने बाख्राहरूजस्तै होओ।<verse eid="JER 50:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JER 50:9"/>किनकि हेर, म उत्तरको देशबाट महान् जातिहरूको जमातलाई</para>
  <para style="q2" vid="JER 50:9">सुर्‍याएर बेबिलोनको विरुद्धमा ल्याउनेछु।</para>
  <para style="q1" vid="JER 50:9">तिनीहरू त्यसको विरुद्धमा युद्धको निम्ति तयार हुनेछन्;</para>
  <para style="q2" vid="JER 50:9">अनि उत्तर दिशाबाट त्यसलाई कब्जा गर्नेछन्।</para>
  <para style="q1" vid="JER 50:9">तिनीहरूका काँडहरू सिपालु योद्धाहरूजस्ता हुनेछन्,</para>
  <para style="q2" vid="JER 50:9">जो रित्तो हात फर्कँदैनन्।<verse eid="JER 50:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JER 50:10"/>यसरी बेबिलोनिया लुटिनेछ;</para>
  <para style="q2" vid="JER 50:10">बेबिलोनलाई लुट्नेहरू सबैसँग प्रशस्त हुनेछ,”</para>
  <para style="q2" vid="JER 50:10">याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 50:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="JER 50:11"/>“मेरो उत्तराधिकारलाई लुट्ने तिमीहरू,</para>
  <para style="q2" vid="JER 50:11">आनन्दित भएर खुशी मनाएको कारण</para>
  <para style="q1" vid="JER 50:11">तिमीहरू अन्‍न दाइँ गर्दा खलामा हर्षले उफ्रने कोरलीजस्तै रमाएको कारण</para>
  <para style="q2" vid="JER 50:11">र घोडाजस्तै तिमीहरू हिनहिनाएको कारण,<verse eid="JER 50:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 50:12"/>तिमीहरूकी आमा ठूलो शर्ममा पर्नेछे;</para>
  <para style="q2" vid="JER 50:12">तिमीहरूलाई जन्म दिने आमा अपमानित हुनेछे।</para>
  <para style="q1" vid="JER 50:12">त्यो राष्ट्रहरूमा सबैभन्दा सानो हुनेछे—</para>
  <para style="q2" vid="JER 50:12">एउटा उजाडस्थान, रुखो जमिन र मरुभूमिजस्तै हुनेछे।<verse eid="JER 50:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 50:13"/>याहवेहको रिसको कारण त्यसमा कोही बसोबास गर्नेछैन,</para>
  <para style="q2" vid="JER 50:13">तर पूर्ण रूपमा सदाको निम्ति उजाड हुनेछ।</para>
  <para style="q1" vid="JER 50:13">बेबिलोनबाट भएर जानेहरू सबै चकित हुनेछन्;</para>
  <para style="q2" vid="JER 50:13">तिनीहरूले त्यसका चोटहरूमा खिसी गर्नेछन्।<verse eid="JER 50:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="JER 50:14"/>“हे सबै धर्नुधारीहरू हो,</para>
  <para style="q2" vid="JER 50:14">बेबिलोनको चारैतिर मोर्चा बाँध।</para>
  <para style="q1" vid="JER 50:14">त्यसलाई हान! एउटै काँड बाँकी नरहने गरी हान;</para>
  <para style="q2" vid="JER 50:14">किनकि त्यसले याहवेहको विरुद्धमा पाप गरेकी छे।<verse eid="JER 50:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JER 50:15"/>त्यसको विरुद्धमा चारैतिर युद्धको निम्ति कराओ!</para>
  <para style="q2" vid="JER 50:15">त्यसले आत्मसमर्पण गर्नेछे र त्यसका धरहराहरू ढल्नेछन्;</para>
  <para style="q2" vid="JER 50:15">त्यसका पर्खालहरू भत्काएर ढालिनेछन्।</para>
  <para style="q1" vid="JER 50:15">किनकि योचाहिँ याहवेहको बदला हो।</para>
  <para style="q2" vid="JER 50:15">त्यससँग बदला लेओ;</para>
  <para style="q2" vid="JER 50:15">त्यसले अरूलाई जस्तो गरेकी छे, त्यससँग पनि त्यस्तै गर।<verse eid="JER 50:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 50:16"/>बेबिलोनबाट छर्नेहरूलाई,</para>
  <para style="q2" vid="JER 50:16">र फसलमा हँसिया लिएर कटनी गर्नेहरूलाई नाश गर।</para>
  <para style="q1" vid="JER 50:16">आक्रमणकारीहरूका तरवारको कारण</para>
  <para style="q2" vid="JER 50:16">हरेक व्यक्ति आफ्नै मानिसहरूकहाँ फर्किएर जाऊन्,</para>
  <para style="q2" vid="JER 50:16">र हरेक व्यक्ति आफ्नै देशमा भागेर जाऊन्।<verse eid="JER 50:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="JER 50:17"/>“इस्राएल सिंहले खेदेर</para>
  <para style="q2" vid="JER 50:17">छरपस्ट भएको भेडाको बगालजस्तै छ।</para>
  <para style="q1" vid="JER 50:17">तिनीहरूलाई निल्ने पहिलो सिंहचाहिँ</para>
  <para style="q2" vid="JER 50:17">अश्शूरको राजा थियो;</para>
  <para style="q1" vid="JER 50:17">तिनीहरूको हड्डी चुर-चुर पार्ने अन्तिम सिंहचाहिँ</para>
  <para style="q2" vid="JER 50:17">बेबिलोनको राजा नबूकदनेसर थियो।”<verse eid="JER 50:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 50:18"/>यसकारण सेनाहरूका याहवेह, इस्राएलका परमेश्‍वर, यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="JER 50:18">“अश्शूरको राजालाई मैले दण्ड दिएझैँ,</para>
  <para style="q2" vid="JER 50:18">बेबिलोनको राजा र त्यसको देशलाई पनि म दण्ड दिनेछु।<verse eid="JER 50:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 50:19"/>तर म इस्राएललाई तिनीहरूको आफ्नै खर्कमा फर्काएर ल्याउनेछु;</para>
  <para style="q2" vid="JER 50:19">अनि त्यो कर्मेल र बाशानमा चर्नेछ;</para>
  <para style="q1" vid="JER 50:19">तिनीहरूको भोक एफ्राइम र गिलादका</para>
  <para style="q2" vid="JER 50:19">पहाडहरूमा तृप्‍त हुनेछ।<verse eid="JER 50:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JER 50:20"/>ती दिनहरूमा र त्यस समयमा,” याहवेह घोषणा गर्नुहुन्छ,</para>
  <para style="q1" vid="JER 50:20">“इस्राएलको अपराध खोजिनेछ,</para>
  <para style="q2" vid="JER 50:20">तर त्यहाँ एउटै पनि पाइनेछैन;</para>
  <para style="q1" vid="JER 50:20">अनि यहूदाका पापहरू पनि खोजिनेछ,</para>
  <para style="q2" vid="JER 50:20">तर केही पनि फेला पर्नेछैन;</para>
  <para style="q2" vid="JER 50:20">किनकि मैले बचाइराखेको बाँकी मानिसहरूलाई म क्षमा गर्नेछु।<verse eid="JER 50:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="JER 50:21"/>“मरातैमको देशलाई</para>
  <para style="q2" vid="JER 50:21">र पेकोदमा बस्‍नेहरूलाई आक्रमण गर।</para>
  <para style="q1" vid="JER 50:21">तिनीहरूलाई लखेट, मार र सम्पूर्ण रूपले नष्‍ट गर,”</para>
  <para style="q2" vid="JER 50:21">याहवेह घोषणा गर्नुहुन्छ।</para>
  <para style="q2" vid="JER 50:21">मैले तिमीहरूलाई आज्ञा गरेको सबै कुरा पूरा गर।<verse eid="JER 50:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 50:22"/>देशमा युद्धको हल्‍ला सुनिँदैछ,</para>
  <para style="q2" vid="JER 50:22">ठूलो विनाशको होहल्‍ला भएको छ!<verse eid="JER 50:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 50:23"/>हेर, सारा पृथ्वीको घन बेबिलोन</para>
  <para style="q2" vid="JER 50:23">कसरी टुक्रिएकी छे र चकनाचुर भएकी छे!</para>
  <para style="q1" vid="JER 50:23">राष्ट्रहरूका बीचमा</para>
  <para style="q2" vid="JER 50:23">बेबिलोन कति उजाड भएकी छे!<verse eid="JER 50:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JER 50:24"/>हे बेबिलोन, मैले तेरा लागि पासो थापेको छु;</para>
  <para style="q2" vid="JER 50:24">अनि तैँले थाहा पाउन अगि नै तँ पासोमा परिसकेकी छेस्;</para>
  <para style="q1" vid="JER 50:24">तँ फेला परिस् र कब्जामा परिस्;</para>
  <para style="q2" vid="JER 50:24">किनकि तँ याहवेहको विरोधमा खडा भइस्।<verse eid="JER 50:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 50:25"/>याहवेहले आफ्नो अस्त्रभण्डार खोल्नुभएको छ,</para>
  <para style="q2" vid="JER 50:25">र आफ्नो क्रोधका हतियारहरू निकाल्नुभएको छ;</para>
  <para style="q1" vid="JER 50:25">किनकि प्रभु सेनाहरूका याहवेहले</para>
  <para style="q2" vid="JER 50:25">बेबिलोनीहरूका देशमा आफ्नो काम गर्नुपर्नेछ।<verse eid="JER 50:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JER 50:26"/>टाढा देशबाट बेबिलोनको विरुद्धमा आओ।</para>
  <para style="q2" vid="JER 50:26">त्यसका अन्‍नका भण्डारहरू भत्काइदेओ;</para>
  <para style="q2" vid="JER 50:26">बेबिलोनलाई अन्‍नको थुप्रोझैँ थुपारी देओ।</para>
  <para style="q1" vid="JER 50:26">त्यसलाई पूर्ण रूपमा नाश गरिदेओ,</para>
  <para style="q2" vid="JER 50:26">र त्यसको लागि कसैलाई बाँकी नराख।<verse eid="JER 50:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JER 50:27"/>त्यसका सबै जवान साँढेहरूलाई मारिदेओ;</para>
  <para style="q2" vid="JER 50:27">तिनीहरू काटिने ठाउँमा जाऊन्!</para>
  <para style="q1" vid="JER 50:27">तिनीहरूलाई धिक्‍कार छ!</para>
  <para style="q2" vid="JER 50:27">किनकि तिनीहरूको समय आएको छ;</para>
  <para style="q1" vid="JER 50:27">तिनीहरूको दण्डको समय आएको छ।<verse eid="JER 50:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JER 50:28"/>बेबिलोनबाट भाग्नेहरू र शरण लिने मानिसहरूले</para>
  <para style="q2" vid="JER 50:28">सियोन पर्वतमा घोषणा गरिरहेका छन्, सो कुरा सुन,</para>
  <para style="q1" vid="JER 50:28">“याहवेह हाम्रा परमेश्‍वरले बेबिलोनीहरूलाई उहाँको मन्दिर भत्काएको कारण</para>
  <para style="q2" vid="JER 50:28">उहाँले कसरी बदला लिनुभएको छ।<verse eid="JER 50:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="JER 50:29"/>“धनुकाँड चलाउन सक्ने सबै सिपालु धनुर्धारीहरूलाई</para>
  <para style="q2" vid="JER 50:29">बेबिलोनको विरुद्धमा बोलाओ।</para>
  <para style="q1" vid="JER 50:29">त्यसका चारैतिर छाउनी बनाएर घेरा लगाओ;</para>
  <para style="q2" vid="JER 50:29">एउटै पनि भाग्न नपाओस्।</para>
  <para style="q1" vid="JER 50:29">त्यसले गरेका कामहरूको बदला लेओ;</para>
  <para style="q2" vid="JER 50:29">त्यसले जस्तो गरेकी छे, त्यसलाई त्यस्तै व्यवहार गर।</para>
  <para style="q1" vid="JER 50:29">किनकि त्यसले इस्राएलका याहवेह</para>
  <para style="q2" vid="JER 50:29">पवित्र परमेश्‍वरलाई घमण्डसाथ अवहेलना गरेकी छे।<verse eid="JER 50:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JER 50:30"/>यसकारण त्यसका जवान मानिसहरू सडकहरूमा ढल्नेछन्;</para>
  <para style="q2" vid="JER 50:30">त्यस दिन त्यसका सबै सेनाहरू मारिनेछन्,”</para>
  <para style="q2" vid="JER 50:30">याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 50:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JER 50:31"/>“हेर, हे अहङ्कारी बेबिलोन, म तेरो विरुद्धमा छु,”</para>
  <para style="q2" vid="JER 50:31">प्रभु, सेनाहरूका याहवेह घोषणा गर्नुहुन्छ;</para>
  <para style="q1" vid="JER 50:31">“किनकि तेरो दिन आएको छ,</para>
  <para style="q2" vid="JER 50:31">तेरो दण्ड पाउने समय आएको छ।<verse eid="JER 50:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JER 50:32"/>त्यो अहङ्कारी बेबिलोन ठक्‍कर खाएर लड्नेछे,</para>
  <para style="q2" vid="JER 50:32">र त्यसलाई कसैले पनि उठ्न सहायता गर्नेछैन;</para>
  <para style="q1" vid="JER 50:32">म त्यसका सहरहरूमा आगो लगाइदिनेछु,</para>
  <para style="q2" vid="JER 50:32">र त्यस आगोले त्यसका चारैतिर भएका अहङ्कारीहरू सबैलाई भस्म पारिदिनेछ।”<verse eid="JER 50:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JER 50:33"/>सेनाहरूका याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="JER 50:33">“इस्राएलका मानिसहरू थिचोमिचोमा परेका छन्;</para>
  <para style="q2" vid="JER 50:33">अनि यहूदाका मानिसहरू पनि थिचोमिचोमा छन्।</para>
  <para style="q1" vid="JER 50:33">तिनीहरू दुवैलाई कैद गरेर लैजानेहरू सबैले</para>
  <para style="q2" vid="JER 50:33">तिनीहरू दुवैलाई छोडिदिन इन्कार गर्छन्।<verse eid="JER 50:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="JER 50:34"/>तापनि तिनीहरूका उद्धारकर्ता शक्तिशाली हुनुहुन्छ;</para>
  <para style="q2" vid="JER 50:34">उहाँको नाम सेनाहरूका याहवेह हो।</para>
  <para style="q1" vid="JER 50:34">उहाँले तिनीहरूको पक्षमा लड्नुहुनेछ,</para>
  <para style="q2" vid="JER 50:34">ताकि उहाँले पृथ्वीमा भएका सबै मानिसहरूमाथि शान्ति ल्याउनुहुनेछ,</para>
  <para style="q2" vid="JER 50:34">तर बेबिलोनमा बस्‍ने मानिसहरूमा चाहिँ अशान्ति ल्याउनुहुनेछ।<verse eid="JER 50:34"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="35" style="v" sid="JER 50:35"/>“बेबिलोनीहरूको विरुद्धमा एउटा तरवार परेको छ!”</para>
  <para style="q2" vid="JER 50:35">याहवेह घोषणा गर्नुहुन्छ—</para>
  <para style="q1" vid="JER 50:35">“बेबिलोनमा बस्‍ने मनिसहरूको विरुद्धमा,</para>
  <para style="q2" vid="JER 50:35">त्यसका अधिकारीहरू र बुद्धिमान् मानिसहरूको विरुद्धमा!<verse eid="JER 50:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="JER 50:36"/>तिनीहरूका झूटा अगमवक्ताहरूको विरुद्धमा तरवार चलेको छ!</para>
  <para style="q2" vid="JER 50:36">तिनीहरू मूर्ख हुनेछन्।</para>
  <para style="q1" vid="JER 50:36">त्यसका योद्धाहरूको विरुद्धमा तरवार परेको छ!</para>
  <para style="q2" vid="JER 50:36">तिनीहरू त्रासले भरिनेछन्।<verse eid="JER 50:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="JER 50:37"/>त्यसका घोडाहरू, रथहरू</para>
  <para style="q2" vid="JER 50:37">र त्यसका साथमा रहेका सबै विदेशीहरूको विरुद्धमा तरवार चलेको छ!</para>
  <para style="q2" vid="JER 50:37">तिनीहरू स्त्रीहरूझैँ दुर्बल हुनेछन्।</para>
  <para style="q1" vid="JER 50:37">तिनीहरूका धनका भण्डारहरूको विरुद्धमा तरवार परेको छ!</para>
  <para style="q2" vid="JER 50:37">ती धनका भण्डारहरू लुटिनेछन्।<verse eid="JER 50:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="JER 50:38"/>देशका पानीका मुहानहरूमा खडेरी परोस्!</para>
  <para style="q2" vid="JER 50:38">त्यसका नदीहरू सबै सुकोस्।</para>
  <para style="q1" vid="JER 50:38">किनकि बेबिलोन मूर्तिहरूको देश हो,</para>
  <para style="q2" vid="JER 50:38">ती मूर्तिहरूले मानिसहरूलाई त्रसित बनाएका छन्।<verse eid="JER 50:38"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="39" style="v" sid="JER 50:39"/>“यसकारण त्यहाँ मरुभूमिका जङ्गली जनावर र हुँडारहरू बस्‍नेछन्;</para>
  <para style="q2" vid="JER 50:39">अनि त्यहाँ उल्‍लुहरू बास गर्नेछन्।</para>
  <para style="q1" vid="JER 50:39">त्यहाँ फेरि पुस्तादेखि पुस्तासम्म,</para>
  <para style="q2" vid="JER 50:39">मानिसहरूले फेरि कहिल्यै बास बस्‍नेछैनन्।<verse eid="JER 50:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="JER 50:40"/>जसरी मैले सदोम र गमोरालाई</para>
  <para style="q2" vid="JER 50:40">तिनीहरूका चारैतिरका सहरहरूसितै नाश गरेँ,”</para>
  <para style="q2" vid="JER 50:40">याहवेह घोषणा गर्नुहुन्छ,</para>
  <para style="q1" vid="JER 50:40">“त्यसरी नै त्यहाँ कोही पनि मानिस बास बस्‍नेछैन;</para>
  <para style="q2" vid="JER 50:40">त्यहाँ कुनै मानव-जाति बसोबास गर्नेछैन।<verse eid="JER 50:40"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="41" style="v" sid="JER 50:41"/>“हेर! उत्तरबाट एक दल सेना आउँदैछ;</para>
  <para style="q2" vid="JER 50:41">पृथ्वीको अन्तिम सिमानाबाट एउटा ठूलो राष्ट्रलाई</para>
  <para style="q2" vid="JER 50:41">र धेरै राजाहरूलाई सुर्‍याइरहेको छ।<verse eid="JER 50:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="JER 50:42"/>तिनीहरू धनु र भालाहरूले सुसज्जित छन्;</para>
  <para style="q2" vid="JER 50:42">तिनीहरू निष्‍ठुर र निर्दयी छन्।</para>
  <para style="q1" vid="JER 50:42">तिनीहरू आ-आफ्ना घोडाहरूमा सवार गर्दा</para>
  <para style="q2" vid="JER 50:42">तिनीहरूको घोडसवारको आवाज समुद्रको गर्जनझैँ सुनिन्छ;</para>
  <para style="q1" vid="JER 50:42">हे बेबिलोनकी छोरी, तिनीहरूले तिमीहरूलाई आक्रमण गर्न आउँदा</para>
  <para style="q2" vid="JER 50:42">लडाइँको मोर्चा बाँधेर तिनीहरू मानिसहरूझैँ आउनेछन्।<verse eid="JER 50:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="JER 50:43"/>बेबिलोनको राजाले तिनीहरूको बारेमा खबर सुनेको छ;</para>
  <para style="q2" vid="JER 50:43">अनि त्यसका हातहरू लल्याकलुलुक भएका छन्।</para>
  <para style="q1" vid="JER 50:43">प्रसव-वेदनामा परेकी स्त्रीलाई जस्तै</para>
  <para style="q2" vid="JER 50:43">पीडाले त्यसलाई पक्रेको छ।<verse eid="JER 50:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="JER 50:44"/>हेर, यर्दन नदीका झाडीहरूबाट</para>
  <para style="q2" vid="JER 50:44">हरियो खर्कबाट निस्केर आइरहेको सिंहझैँ म निस्कनेछु,</para>
  <para style="q1" vid="JER 50:44">र म बेबिलोनलाई झट्टै त्यसकै देशबाट खेद्नेछु;</para>
  <para style="q2" vid="JER 50:44">यस देशको निम्ति जसलाई चुन्छु, उसैलाई नियुक्त गर्नेछु।</para>
  <para style="q1" vid="JER 50:44">मजस्तो को छ र? कसले मलाई चुनौती दिन सक्छ?</para>
  <para style="q2" vid="JER 50:44">अनि कुनचाहिँ गोठालो मेरो विरुद्धमा खडा हुन सक्छ?”<verse eid="JER 50:44"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="45" style="v" sid="JER 50:45"/>यसकारण बेबिलोनको विरुद्धमा याहवेहले जे योजना गर्नुभएको छ,</para>
  <para style="q2" vid="JER 50:45">उहाँले बेबिलोनीहरूको देशको विरुद्धमा जे उद्देश्य राख्नुभएको छ, सुन:</para>
  <para style="q1" vid="JER 50:45">बगालका कलिला बालबालिकाहरू तानेर लगिनेछन्;</para>
  <para style="q2" vid="JER 50:45">तिनीहरूका खर्कहरू पूर्ण रूपमा सर्वनाश हुनेछन्।<verse eid="JER 50:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="JER 50:46"/>बेबिलोन कब्जा गरिएको आवाजले पृथ्वी थरथर काँप्‍नेछ;</para>
  <para style="q2" vid="JER 50:46">तिनीहरूको चीत्कार राष्ट्रहरूका बीचमा गुञ्जिनेछ।<verse eid="JER 50:46"/></para>
  <chapter eid="JER 50"/>
  <chapter number="51" style="c" sid="JER 51"/>
  <para style="p">
    <verse number="1" style="v" sid="JER 51:1"/>याहवेह यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="JER 51:1">“हेर, बेबिलोन र लेब-कमाईका मानिसहरूका विरुद्धमा</para>
  <para style="q2" vid="JER 51:1">म एक विनाश गर्ने आत्मालाई उक्साउनेछु।<verse eid="JER 51:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JER 51:2"/>म बेबिलोनलाई निफन्‍न र</para>
  <para style="q2" vid="JER 51:2">त्यस देशलाई नष्‍ट गर्नलाई विदेशीहरू पठाउनेछु;</para>
  <para style="q1" vid="JER 51:2">त्यसको विपत्तिको दिनमा</para>
  <para style="q2" vid="JER 51:2">शत्रुहरूले चारैतिरबाट त्यसको विरोध गर्नेछन्।<verse eid="JER 51:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JER 51:3"/>धनुर्धारीले आफ्नो धनुमा ताँदो नचढाओस्,</para>
  <para style="q2" vid="JER 51:3">न त त्यो आफ्नो कवच लगाएर खडा होस्।</para>
  <para style="q1" vid="JER 51:3">तिनीहरूका जवानहरूलाई बाँकी नराख;</para>
  <para style="q2" vid="JER 51:3">तिनीहरूका सेनाहरूलाई पूर्ण रूपले सर्वनाश गर।<verse eid="JER 51:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JER 51:4"/>तिनीहरू बेबिलोनका सडकहरूमा घाइते भएर लड्नेछन्,</para>
  <para style="q2" vid="JER 51:4">र तिनीहरू बेबिलोनमै मारिनेछन्।<verse eid="JER 51:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JER 51:5"/>किनकि इस्राएल र यहूदा तिनीहरूका परमेश्‍वर,</para>
  <para style="q2" vid="JER 51:5">सेनाहरूका याहवेहद्वारा त्यागिएका छैनन्;</para>
  <para style="q1" vid="JER 51:5">यद्यपि बेबिलोनीहरूको देश इस्राएलका</para>
  <para style="q2" vid="JER 51:5">पवित्र परमेश्‍वरको सामु अपराधले भरिएको छ।<verse eid="JER 51:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="JER 51:6"/>“बेबिलोनबाट भाग!</para>
  <para style="q2" vid="JER 51:6">आ-आफ्नो प्राण बचाउनलाई भाग!</para>
  <para style="q2" vid="JER 51:6">त्यसका पापहरूको कारण तिमीहरू नाश नहोओ।</para>
  <para style="q1" vid="JER 51:6">यो त याहवेहले बदला लिने समय हो;</para>
  <para style="q2" vid="JER 51:6">उहाँले त्यसलाई उचित दण्ड दिनुहुनेछ।<verse eid="JER 51:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JER 51:7"/>बेबिलोन याहवेहको हातमा एउटा सुनको कचौरा थियो;</para>
  <para style="q2" vid="JER 51:7">त्यसले सारा पृथ्वीलाई मतायो।</para>
  <para style="q1" vid="JER 51:7">राष्ट्रहरूले त्यसको मद्य पिएका छन्;</para>
  <para style="q2" vid="JER 51:7">यसकारण अहिले तिनीहरू पागल भएका छन्।<verse eid="JER 51:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JER 51:8"/>बेबिलोन एक्‍कासि पतन हुनेछ र टुक्रिनेछ।</para>
  <para style="q2" vid="JER 51:8">त्यसको निम्ति विलाप गर!</para>
  <para style="q1" vid="JER 51:8">त्यसको कष्‍टका निम्ति मलम ल्याओ;</para>
  <para style="q2" vid="JER 51:8">सायद त्यो निको हुन्छे कि!<verse eid="JER 51:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="JER 51:9"/>“हामी बेबिलोनलाई निको पार्नेथियौँ,</para>
  <para style="q2" vid="JER 51:9">तर त्यो निको हुन सक्दैन;</para>
  <para style="q1" vid="JER 51:9">त्यसलाई छोडिदियौँ र हामी आ-आफ्नो देशमा जाऔँ;</para>
  <para style="q2" vid="JER 51:9">किनकि त्यसको दण्ड आकाशसम्म पुगेको छ,</para>
  <para style="q2" vid="JER 51:9">त्यो स्वर्गसम्मै चुलिएको छ।<verse eid="JER 51:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="JER 51:10"/>“याहवेहले हामीलाई निर्दोष ठहराउनुभएको छ;</para>
  <para style="q2" vid="JER 51:10">आओ, हामी सियोनमा जाऔँ,</para>
  <para style="q2" vid="JER 51:10">र याहवेह हाम्रा परमेश्‍वरको काम बयान गरौँ।<verse eid="JER 51:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="JER 51:11"/>“धनुकाँडहरू तीखा पार!</para>
  <para style="q2" vid="JER 51:11">ढालहरू उठाओ!</para>
  <para style="q1" vid="JER 51:11">याहवेहले मादीका राजाहरूलाई उक्साउनुभएको छ;</para>
  <para style="q2" vid="JER 51:11">किनकि उहाँको उद्देश्य बेबिलोनलाई नष्‍ट गर्नु हो।</para>
  <para style="q1" vid="JER 51:11">याहवेहले बदला लिनुहुनेछ;</para>
  <para style="q2" vid="JER 51:11">उहाँको मन्दिर नष्‍ट गर्नेहरूलाई बदला लिनुहुनेछ।<verse eid="JER 51:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JER 51:12"/>बेबिलोनका पर्खालहरूको विरुद्धमा झण्डा उठाओ!</para>
  <para style="q2" vid="JER 51:12">पहरा-चौकी बलियो बनाओ;</para>
  <para style="q1" vid="JER 51:12">पहरेदारहरूलाई खटाओ,</para>
  <para style="q2" vid="JER 51:12">ढुकेर आक्रमण गर्नेहरूलाई तयार गर!</para>
  <para style="q1" vid="JER 51:12">याहवेहले आफ्नो उद्देश्य पूरा गर्नुहुनेछ;</para>
  <para style="q2" vid="JER 51:12">अनि बेबिलोनका मानिसहरूको विरुद्धमा उहाँले आफ्नो उर्दी पूरा गर्नुहुनेछ।<verse eid="JER 51:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JER 51:13"/>तँ बेबिलोन, जो धेरै नदीहरूको नजिक बस्छेस्</para>
  <para style="q2" vid="JER 51:13">र धेरै धनसम्पत्तिको भण्डारले पूर्ण भएकी छेस्,</para>
  <para style="q1" vid="JER 51:13">तर तेरो अन्त्य आएको छ।</para>
  <para style="q2" vid="JER 51:13">तेरो विनाशको समय आएको छ।<verse eid="JER 51:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JER 51:14"/>सेनाहरूका याहवेहले आफ्नै नामको शपथ खानुभएको छ:</para>
  <para style="q2" vid="JER 51:14">म निश्‍चय नै बेबिलोनलाई आक्रमण गर्न सलहको बथानझैँ सेनाहरूको भीडले भरिदिनेछु;</para>
  <para style="q2" vid="JER 51:14">अनि तिनीहरूले तँमाथि विजयी भएर जयजयकार गर्नेछन्।<verse eid="JER 51:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="JER 51:15"/>“याहवेहले पृथ्वी आफ्नो शक्तिद्वारा बनाउनुभयो;</para>
  <para style="q2" vid="JER 51:15">उहाँले संसारलाई आफ्नो बुद्धिले स्थापित गर्नुभयो</para>
  <para style="q2" vid="JER 51:15">र उहाँले आकाशलाई आफ्नो समझशक्तिले फैलाउनुभयो।<verse eid="JER 51:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JER 51:16"/>जब उहाँ बोल्नुहुन्छ, तब आकाशमा पानीको गर्जन हुन्छ;</para>
  <para style="q2" vid="JER 51:16">उहाँले बादललाई पृथ्वीको अन्तिम छेउबाट उठाउनुहुन्छ।</para>
  <para style="q1" vid="JER 51:16">उहाँले झरीसँग बिजुली पठाउनुहुन्छ,</para>
  <para style="q2" vid="JER 51:16">अनि हावालाई उहाँको भण्डारहरूबाट निकाल्नुहुन्छ।<verse eid="JER 51:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="JER 51:17"/>“हरेक मानिस विवेकहीन र ज्ञानहीन छ;</para>
  <para style="q2" vid="JER 51:17">हरेक सुनार आफ्नै मूर्तिहरूद्वारा शर्ममा पर्नेछ।</para>
  <para style="q1" vid="JER 51:17">किनकि त्यसले बनाएका मूर्तिहरू झूटा हुन्;</para>
  <para style="q2" vid="JER 51:17">तिनीहरूमा जीवनको सास हुँदैन।<verse eid="JER 51:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JER 51:18"/>ती मूर्तिहरू सबै व्यर्थका र ठट्टाका पात्र हुन्;</para>
  <para style="q2" vid="JER 51:18">जब तिनीहरूको न्याय आउँछ, तब तिनीहरू नष्‍ट हुनेछन्।<verse eid="JER 51:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JER 51:19"/>उहाँ, जो याकोबका अंश हुनुहुन्छ, उहाँ ती मूर्तिहरूजस्ता हुनुहुन्‍न;</para>
  <para style="q2" vid="JER 51:19">किनकि उहाँ सबै कुराहरूको सृष्‍टिकर्ता हुनुहुन्छ,</para>
  <para style="q1" vid="JER 51:19">जसमा उहाँको उत्तराधिकारका मानिसहरू पनि सामेल छन्;</para>
  <para style="q2" vid="JER 51:19">सेनाहरूका याहवेह उहाँको नाम हो।<verse eid="JER 51:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="JER 51:20"/>“तँ मेरो युद्धको मुङ्ग्रो,</para>
  <para style="q2" vid="JER 51:20">मेरो लडाइँका निम्ति हतियार होस्;</para>
  <para style="q1" vid="JER 51:20">तँद्वारा म राष्ट्रहरूलाई चकनाचुर पार्छु;</para>
  <para style="q2" vid="JER 51:20">र तँद्वारा नै म राज्यहरूलाई नष्‍ट गर्छु।<verse eid="JER 51:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JER 51:21"/>तँद्वारा म घोडा र घोडसवारहरूलाई टुक्रा-टुक्रा पार्छु;</para>
  <para style="q2" vid="JER 51:21">तँद्वारा म रथहरू र रथ-सवारहरूलाई चकनाचुर पार्छु।<verse eid="JER 51:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JER 51:22"/>तँद्वारा म पुरुषहरू र स्त्रीहरूलाई चकनाचुर पार्छु।</para>
  <para style="q2" vid="JER 51:22">तँद्वारा म वृद्ध मानिस र जवानलाई चकनाचुर पार्छु।</para>
  <para style="q2" vid="JER 51:22">तँद्वारा म जवान केटाहरू र कन्या केटीहरूलाई चकनाचुर पार्छु।<verse eid="JER 51:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JER 51:23"/>तँद्वारा म गोठाला र भेडाबाख्राको बगाललाई चकनाचुर पार्छु;</para>
  <para style="q2" vid="JER 51:23">तँद्वारा म किसान र गोरुहरूलाई चकनाचुर पार्छु।</para>
  <para style="q2" vid="JER 51:23">तँद्वारा म राज्यपालहरू र अधिकारीहरूलाई चकनाचुर पार्छु।<verse eid="JER 51:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 51:24"/>“तेरो आँखाको सामु म बेबिलोन र बेबिलोनमा बस्‍ने सबै मानिसहरूलाई सियोनमा तिनीहरूले गरेका सबै खराबीको निम्ति दण्ड दिनेछु,” याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 51:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JER 51:25"/>“हे, विनाशकारी पर्वत, म तेरो विरुद्धमा छु;</para>
  <para style="q2" vid="JER 51:25">तैँले सारा पृथ्वीलाई नष्‍ट गर्छस्,”</para>
  <para style="q2" vid="JER 51:25">याहवेह घोषणा गर्नुहुन्छ।</para>
  <para style="q1" vid="JER 51:25">“म तेरो विरुद्धमा मेरो हात पसार्नेछु,</para>
  <para style="q2" vid="JER 51:25">तँलाई भिरबाट तल गुडाइदिनेछु;</para>
  <para style="q2" vid="JER 51:25">अनि तँलाई एउटा डढेको उजाड पहाड तुल्याउनेछु।<verse eid="JER 51:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JER 51:26"/>तँबाट कुनाको निम्ति कुनै ढुङ्गा लिइनेछैन,</para>
  <para style="q2" vid="JER 51:26">न त जगको निम्ति कुनै ढुङ्गा लिइनेछ;</para>
  <para style="q2" vid="JER 51:26">किनकि तँ सदाको निम्ति उजाड रहनेछस्,” याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 51:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="JER 51:27"/>“देशमा एउटा झण्डा उठाओ!</para>
  <para style="q2" vid="JER 51:27">राष्ट्रहरूका बीचमा तुरही बजाओ!</para>
  <para style="q1" vid="JER 51:27">त्यसको विरुद्धमा लडाइँको निम्ति राष्ट्रहरूलाई तयार पार;</para>
  <para style="q2" vid="JER 51:27">यी राज्यहरूलाई त्यसको विरुद्धमा आक्रमण गर्नलाई बोलाओ:</para>
  <para style="q2" vid="JER 51:27">अरारात, मिन्‍नी र अश्कनजलाई बोलाओ।</para>
  <para style="q1" vid="JER 51:27">त्यसको विरुद्धमा एउटा सेनापति नियुक्त गर;</para>
  <para style="q2" vid="JER 51:27">सलहको बथानझैँ घोडाहरूलाई पठाओ।<verse eid="JER 51:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JER 51:28"/>त्यसको विरुद्धमा युद्ध गर्नलाई राष्ट्रहरूलाई तयार गर!</para>
  <para style="q2" vid="JER 51:28">मादीका राजाहरूलाई,</para>
  <para style="q1" vid="JER 51:28">तिनीहरूका राज्यपालहरूलाई र तिनीहरूका सबै अधिकारीहरूलाई,</para>
  <para style="q2" vid="JER 51:28">र तिनीहरूले शासन गर्ने देशहरूलाई तयार गर।<verse eid="JER 51:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JER 51:29"/>देश थरथर काम्छ र छटपटिन्छ;</para>
  <para style="q2" vid="JER 51:29">किनकि बेबिलोनको विरुद्धमा याहवेहको उद्देश्य अटल छ!</para>
  <para style="q1" vid="JER 51:29">बेबिलोनको देशलाई उजाड पार्नलाई,</para>
  <para style="q2" vid="JER 51:29">त्यहाँ कोही पनि नबसून्।<verse eid="JER 51:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JER 51:30"/>बेबिलोनका सेनाहरूले युद्ध गर्न बन्द गरेका छन्;</para>
  <para style="q2" vid="JER 51:30">तिनीहरू आफ्ना किल्‍लाहरूमा रहन्छन्।</para>
  <para style="q1" vid="JER 51:30">तिनीहरूको बल शिथिल भएको छ;</para>
  <para style="q2" vid="JER 51:30">तिनीहरू दुर्बल भएका छन्।</para>
  <para style="q1" vid="JER 51:30">त्यसका वासस्थानहरूमा आगो लगाइएका छन्;</para>
  <para style="q2" vid="JER 51:30">त्यसका मूलढोकाका गजबारहरू भत्काइएका छन्।<verse eid="JER 51:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JER 51:31"/>एक हुलाकी अर्को हुलाकीको पछि दौडन्छ;</para>
  <para style="q2" vid="JER 51:31">एक सन्देशवाहक अर्को सन्देशवाहकको पछि दौडन्छ।</para>
  <para style="q1" vid="JER 51:31">बेबिलोनको राजालाई यो खबर दिन</para>
  <para style="q2" vid="JER 51:31">उसको सम्पूर्ण सहर कब्जा गरिएका छन्;<verse eid="JER 51:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JER 51:32"/>अनि नदीका घाटहरूलाई कब्जा गरिएका छन्;</para>
  <para style="q2" vid="JER 51:32">धापहरूमा आगो लगाइएका छन्;</para>
  <para style="q2" vid="JER 51:32">अनि योद्धाहरू त्रसित भएका छन्।”<verse eid="JER 51:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JER 51:33"/>सेनाहरूका याहवेह, इस्राएलका परमेश्‍वर यसो भन्‍नुहुन्छ:</para>
  <para style="q1" vid="JER 51:33">“बेबिलोनकी छोरी दाइँ गर्ने समयमा</para>
  <para style="q2" vid="JER 51:33">कुल्चिएको खलाझैँ भएकी छे;</para>
  <para style="q2" vid="JER 51:33">त्यसको कटनी गर्ने समय चाँडै आउँदैछ।”<verse eid="JER 51:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="JER 51:34"/>“बेबिलोनको राजा नबूकदनेसरले हामीलाई निलेको छ;</para>
  <para style="q2" vid="JER 51:34">त्यसले हामीलाई अलमलमा पारिदिएको छ।</para>
  <para style="q2" vid="JER 51:34">त्यसले हामीलाई रित्तो भाँडाजस्तै बनाइदिएको छ।</para>
  <para style="q1" vid="JER 51:34">त्यसले हामीलाई अजिङ्गरले झैँ निलेको छ,</para>
  <para style="q2" vid="JER 51:34">र त्यसले हाम्रो स्वादिष्‍ठ भोजनले आफ्नो पेट भरेको छ;</para>
  <para style="q2" vid="JER 51:34">त्यसपछि हामीलाई बान्ता गरेर फ्याँकिदिएको छ।<verse eid="JER 51:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="JER 51:35"/>सियोनका बासिन्दाहरूले भन्छन्,</para>
  <para style="q2" vid="JER 51:35">हामी र हाम्रा छोराछोरीहरूमाथि जस्तो अत्याचार परेको छ,</para>
  <para style="q2" vid="JER 51:35">त्यस्तै बेबिलोनमाथि पनि परोस्”।</para>
  <para style="q1" vid="JER 51:35">यरूशलेमले भन्छ,</para>
  <para style="q2" vid="JER 51:35">“हाम्रो रगत बगाएको बदला बेबिलोनमा बस्‍ने मानिसहरूमाथि परोस्”।<verse eid="JER 51:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JER 51:36"/>यसकारण याहवेह भन्‍नुहुन्छ:</para>
  <para style="q1" vid="JER 51:36">“हेर, म तेरो पक्ष लिनेछु,</para>
  <para style="q2" vid="JER 51:36">र तेरो बदला लिनेछु;</para>
  <para style="q1" vid="JER 51:36">म त्यसको समुद्र सुकाइदिनेछु;</para>
  <para style="q2" vid="JER 51:36">अनि त्यसको पानीका मुहानहरू सुकाइदिनेछु।<verse eid="JER 51:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="JER 51:37"/>बेबिलोन भग्नावशेषको थुप्रो हुनेछ;</para>
  <para style="q2" vid="JER 51:37">स्यालहरूको ओडार हुनेछ;</para>
  <para style="q1" vid="JER 51:37">त्रास र गिल्‍लाको पात्र,</para>
  <para style="q2" vid="JER 51:37">कोही पनि नबस्‍ने एउटा उजाड ठाउँ हुनेछ।<verse eid="JER 51:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="JER 51:38"/>त्यसका मानिसहरू सबै सिंहझैँ गर्जन्छन्।</para>
  <para style="q2" vid="JER 51:38">तिनीहरू सिंहका डमरुझैँ ङुर्र-ङुर्र गर्छन्।<verse eid="JER 51:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="JER 51:39"/>तर जब तिनीहरू उत्तेजित हुन्छन्,</para>
  <para style="q2" vid="JER 51:39">म तिनीहरूका निम्ति भोज तयार पार्नेछु,</para>
  <para style="q2" vid="JER 51:39">र तिनीहरूलाई मताउनेछु,</para>
  <para style="q1" vid="JER 51:39">ताकि तिनीहरू हाँस्दै चिच्याउनेछन्;</para>
  <para style="q2" vid="JER 51:39">अनि सदाको निम्ति सुत्नेछन् र निन्द्राबाट कहिल्यै बिउँझनेछैनन्,”</para>
  <para style="q2" vid="JER 51:39">याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 51:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="JER 51:40"/>“म तिनीहरूलाई काटिनका निम्ति लगिएका</para>
  <para style="q2" vid="JER 51:40">थुमाहरू, भेडाहरू र बाख्राहरूझैँ तल लैजानेछु।<verse eid="JER 51:40"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="41" style="v" sid="JER 51:41"/>“शेशक<note caller="+" style="f"><char style="fr" closed="false">51:41 </char><char style="fq" closed="false">शेशक </char><char style="ft" closed="false">बेबिलोनको साङ्केतिक नाम हो।</char></note> कसरी कब्जा हुनेछ;</para>
  <para style="q2" vid="JER 51:41">सारा पृथ्वीको प्रशंसाको पात्र बेबिलोन कब्जा गरिनेछ!</para>
  <para style="q1" vid="JER 51:41">राष्ट्रहरूको बीचमा</para>
  <para style="q2" vid="JER 51:41">बेबिलोन एउटा भयानक दृश्य हुनेछ!<verse eid="JER 51:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="JER 51:42"/>बेबिलोनमाथि समुद्र उठ्नेछ;</para>
  <para style="q2" vid="JER 51:42">त्यसका गर्जने छालहरूले त्यसलाई छोपिदिनेछन्।<verse eid="JER 51:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="JER 51:43"/>त्यसका सहरहरू उजाड हुनेछन्,</para>
  <para style="q2" vid="JER 51:43">सुक्खा र मरुभूमिको देश,</para>
  <para style="q1" vid="JER 51:43">जहाँ कोही पनि नबस्‍ने देश,</para>
  <para style="q2" vid="JER 51:43">जुन देशबाट भएर कसैले पनि यात्रा गर्नेछैन।<verse eid="JER 51:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="JER 51:44"/>म बेबिलोनमा बेललाई दण्ड दिनेछु;</para>
  <para style="q2" vid="JER 51:44">अनि त्यसले जे निलेको छ, त्यो बान्ता गर्न लगाउनेछु।</para>
  <para style="q1" vid="JER 51:44">फेरि राष्ट्रहरू ताँती लगाएर आउनेछैनन्,</para>
  <para style="q2" vid="JER 51:44">र बेबिलोनको पर्खाल ढल्नेछ।<verse eid="JER 51:44"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="45" style="v" sid="JER 51:45"/>“हे मेरा मानिसहरू हो!</para>
  <para style="q2" vid="JER 51:45">आफ्ना प्राण बचाउनलाई भाग!</para>
  <para style="q2" vid="JER 51:45">याहवेहको भयानक क्रोधदेखि भाग।<verse eid="JER 51:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="JER 51:46"/>जब देशमा हल्‍ला सुन्छौ,</para>
  <para style="q2" vid="JER 51:46">तब हतोत्साही नहोओ, अथवा नडराओ;</para>
  <para style="q1" vid="JER 51:46">यस वर्ष एउटा हल्‍ला र अर्को वर्ष अर्कै हल्‍ला आउँछ;</para>
  <para style="q2" vid="JER 51:46">देशमा अत्याचारको हल्‍ला</para>
  <para style="q2" vid="JER 51:46">र शासकको विरुद्धमा शासक भएको हल्‍ला।<verse eid="JER 51:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="JER 51:47"/>किनकि हेर, समय निश्‍चय नै आउनेछ,</para>
  <para style="q2" vid="JER 51:47">जब म बेबिलोनका मूर्तिहरूलाई दण्ड दिनेछु;</para>
  <para style="q1" vid="JER 51:47">तब त्यसको सम्पूर्ण देश अपमानित हुनेछ,</para>
  <para style="q2" vid="JER 51:47">र त्यसका मारिएकाहरू सबै त्यसकै भूमिमा ढलिरहनेछन्।<verse eid="JER 51:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="JER 51:48"/>तब स्वर्ग, पृथ्वी र तिनीहरूमा भएका सबै</para>
  <para style="q2" vid="JER 51:48">बेबिलोनको यस्तो स्थितिमा रमाउनेछन्;</para>
  <para style="q1" vid="JER 51:48">किनकि उत्तर दिशातिरबाट</para>
  <para style="q2" vid="JER 51:48">विनाशकर्ताहरूले त्यसलाई आक्रमण गर्नेछन्,”</para>
  <para style="q2" vid="JER 51:48">याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 51:48"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="49" style="v" sid="JER 51:49"/>“बेबिलोनको कारण पृथ्वीभरि मानिसहरू मारिएझैँ,</para>
  <para style="q2" vid="JER 51:49">इस्राएलका मानिसहरूको हत्या गरिएको कारण</para>
  <para style="q2" vid="JER 51:49">बेबिलोनको पतन हुनैपर्छ।<verse eid="JER 51:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="JER 51:50"/>तिमीहरू, जो तरवारबाट उम्केछौ,</para>
  <para style="q2" vid="JER 51:50">ढिलो नगरी भागिहाल!</para>
  <para style="q1" vid="JER 51:50">टाढा देशबाट याहवेहलाई स्मरण गर;</para>
  <para style="q2" vid="JER 51:50">अनि यरूशलेमको बारेमा याद गर।”<verse eid="JER 51:50"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="51" style="v" sid="JER 51:51"/>“हामी लज्जित भएका छौँ;</para>
  <para style="q2" vid="JER 51:51">किनकि हामी बदनामी भएका छौँ,</para>
  <para style="q2" vid="JER 51:51">र हाम्रा अनुहार शर्मले ढाकिएका छन्;</para>
  <para style="q1" vid="JER 51:51">किनकि विदेशीहरू हाम्रा याहवेहको भवनका</para>
  <para style="q2" vid="JER 51:51">पवित्र ठाउँहरूमा प्रवेश गरेका छन्।”<verse eid="JER 51:51"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="52" style="v" sid="JER 51:52"/>“तर हेर, दिनहरू आउँदैछन्,” याहवेह घोषणा गर्नुहुन्छ।</para>
  <para style="q2" vid="JER 51:52">“जब म त्यसका मूर्तिहरूलाई दण्ड दिनेछु,</para>
  <para style="q1" vid="JER 51:52">तब त्यसको देशभरि नै</para>
  <para style="q2" vid="JER 51:52">घाइतेहरूले सुस्केरा हाल्नेछन्।<verse eid="JER 51:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="JER 51:53"/>यदि बेबिलोनले आकाशसम्मै पुगेर</para>
  <para style="q2" vid="JER 51:53">आफ्ना अग्ला किल्‍लाहरूलाई बलियो पारे तापनि</para>
  <para style="q2" vid="JER 51:53">म त्यसको विरुद्धमा विनाश गर्नेहरू पठाउनेछु,”</para>
  <para style="q2" vid="JER 51:53">याहवेह घोषणा गर्नुहुन्छ।<verse eid="JER 51:53"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="54" style="v" sid="JER 51:54"/>“बेबिलोनबाट चीत्कारको आवाज निस्कन्छ;</para>
  <para style="q2" vid="JER 51:54">बेबिलोनीहरूको देशबाट</para>
  <para style="q2" vid="JER 51:54">आएको ठूलो विनाशको आवाज।<verse eid="JER 51:54"/></para>
  <para style="q1">
    <verse number="55" style="v" sid="JER 51:55"/>याहवेहले बेबिलोनलाई नाश गर्नुहुनेछ;</para>
  <para style="q2" vid="JER 51:55">उहाँले त्यसको ठूलो होहल्‍लालाई बन्द गराउनुहुनेछ।</para>
  <para style="q1" vid="JER 51:55">शत्रुहरू समुद्रका विशाल छालहरूझैँ गर्जनेछन्;</para>
  <para style="q2" vid="JER 51:55">तिनीहरूका आवाजको गर्जन गुञ्जिनेछ।<verse eid="JER 51:55"/></para>
  <para style="q1">
    <verse number="56" style="v" sid="JER 51:56"/>बेबिलोनको विरुद्धमा एउटा विनाशकर्ता आउनेछ;</para>
  <para style="q2" vid="JER 51:56">त्यसका योद्धाहरू कब्जा गरिनेछन्;</para>
  <para style="q2" vid="JER 51:56">अनि तिनीहरूका धनुकाँडहरू भाँचिनेछन्।</para>
  <para style="q1" vid="JER 51:56">किनकि याहवेह उचित प्रतिफल दिनुहुने परमेश्‍वर हुनुहुन्छ;</para>
  <para style="q2" vid="JER 51:56">उहाँले पूर्ण रूपमा दण्ड दिनुहुनेछ।<verse eid="JER 51:56"/></para>
  <para style="q1">
    <verse number="57" style="v" sid="JER 51:57"/>म तिनीहरूका अधिकारीहरू, बुद्धिमान् मानिसहरूलाई मताइदिनेछु;</para>
  <para style="q2" vid="JER 51:57">त्यसका राज्यपालहरू, अधिकारीहरू र योद्धाहरू समेतलाई मताइदिनेछु;</para>
  <para style="q1" vid="JER 51:57">तिनीहरू सदाको निम्ति निदाउनेछन् र कहिल्यै पनि उठ्नेछैनन्,”</para>
  <para style="q2" vid="JER 51:57">राजा घोषणा गर्नुहुन्छ, “जसको नाम सेनाहरूका याहवेह हो।”<verse eid="JER 51:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="JER 51:58"/>सेनाहरूका याहवेह भन्‍नुहुन्छ:</para>
  <para style="q1" vid="JER 51:58">“बेबिलोनको चौडा पर्खाल समतल बनाइनेछ;</para>
  <para style="q2" vid="JER 51:58">अनि त्यसका अग्ला मूलढोकाहरूमा आगो लगाइनेछन्;</para>
  <para style="q1" vid="JER 51:58">मानिसहरू व्यर्थैमा थाकेर शिथिल हुन्छन्,</para>
  <para style="q2" vid="JER 51:58">र राष्ट्रको परिश्रमचाहिँ ज्वालाको निम्ति इन्धन मात्र हुनेछन्।”<verse eid="JER 51:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="JER 51:59"/>यहूदाका राजा सिदकियाहको शासनकालको चौथो वर्षमा महसेयाहका नाति, नेरियाहका छोरा प्रमुख अधिकारी सरायाहलाई, राजासित बेबिलोनमा जाँदा यर्मियाले तिनलाई दिएको सन्देश यही हो। <verse eid="JER 51:59"/><verse number="60" style="v" sid="JER 51:60"/>बेबिलोनमाथि आउने सबै विपत्तिहरूको बारेमा यर्मियाले एउटा चर्मपत्रमा लेखेका थिए—बेबिलोनको विषयमा सबै कुराहरू लेखे। <verse eid="JER 51:60"/><verse number="61" style="v" sid="JER 51:61"/>यर्मियाले सरायाहलाई भने, “जब तिमी बेबिलोनमा पुग्छौ, तब तिमीले यी सबै वचनहरू अवश्य चर्को आवाजमा मानिसहरूलाई पढेर सुनाउनू। <verse eid="JER 51:61"/><verse number="62" style="v" sid="JER 51:62"/>त्यसपछि यसो भन, ‘हे याहवेह, तपाईंले यस ठाउँलाई नाश गर्नेछु भन्‍नुभएको छ। यसमा न मानिस, न त पशु बसोबास गर्नेछ; यो सदाको निम्ति उजाड हुनेछ।’ <verse eid="JER 51:62"/><verse number="63" style="v" sid="JER 51:63"/>जब तिमीले यो चर्मपत्र पढिसक्छौ, तब यसमा एउटा ढुङ्गा बाँध र यसलाई यूफ्रेटिस नदीमा फालिदेऊ। <verse eid="JER 51:63"/><verse number="64" style="v" sid="JER 51:64"/>तब यसो भन, ‘मैले बेबिलोनमाथि ल्याउने विपत्तिको कारण यसरी नै बेबिलोन कहिल्यै नउठ्ने गरी डुब्नेछ। अनि त्यसका मानिसहरूको पतन हुनेछ।’ ”</para>
  <para style="b" vid="JER 51:64"/>
  <para style="b" vid="JER 51:64"/>
  <para style="p" vid="JER 51:64">यर्मियाको सन्देश यहीँ समाप्‍त हुन्छ।<verse eid="JER 51:64"/></para>
  <para style="b"/>
  <chapter eid="JER 51"/>
  <chapter number="52" style="c" sid="JER 52"/>
  <para style="s1">यरूशलेमको पतन</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 52:1"/>राजा हुँदा सिदकियाह एक्‍काइस वर्षका थिए। तिनले यरूशलेममा एघार वर्ष राज्य गरे। तिनकी आमाको नाम हमुतल थियो, जो यर्मियाकी छोरी थिइन्। तिनी लिब्ना निवासी थिइन्। <verse eid="JER 52:1"/><verse number="2" style="v" sid="JER 52:2"/>यहोयाकीमले गरेझैँ सिदकियाहले पनि याहवेहको दृष्‍टिमा जे कुरा खराब थियो, त्यही गरे। <verse eid="JER 52:2"/><verse number="3" style="v" sid="JER 52:3"/>याहवेहको क्रोधको कारणले नै यरूशलेम र यहूदामा यी सबै हुन आएका थिए। आखिरमा उहाँले तिनीहरूलाई आफ्ना उपस्थितिबाट निकालिदिनुभयो।</para>
  <para style="p" vid="JER 52:3">तब सिदकियाहले बेबिलोनका राजाको विरुद्धमा विद्रोह गरे।<verse eid="JER 52:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 52:4"/>यसकारण सिदकियाहको शासनकालको नवौँ वर्षको, दशौँ महिनाको दशौँ दिनमा, बेबिलोनका राजा नबूकदनेसर यरूशलेमको विरुद्धमा आफ्नो सम्पूर्ण सेना लिएर आए। तिनीहरूले सहरको बाहिर छाउनी हाले र त्यसका चारैतिर घेरा-मचान बनाए। <verse eid="JER 52:4"/><verse number="5" style="v" sid="JER 52:5"/>राजा सिदकियाहको एघारौँ वर्षसम्म सहर घेराबन्दीमा राखिएको थियो।<verse eid="JER 52:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 52:6"/>चौथो महिनाको नवौँ दिनसम्म सहरमा यस्तो घोर अनिकाल पर्‍यो कि देशका मानिसहरूका निम्ति केही खानेकुरा बाँकी रहेन। <verse eid="JER 52:6"/><verse number="7" style="v" sid="JER 52:7"/>तब सहरको पर्खाल भत्काइयो; अनि यरूशलेमका सम्पूर्ण सेनाहरू भागेर गए। बेबिलोनीहरूले सहरलाई घेरेर राखेको भए तापनि तिनीहरूले राजाको बगैँचाको छेउका दुई पर्खालको बीचमा भएको मूलढोकाबाट भएर राति नै सहरलाई छोडेर भागे। तिनीहरू अराबातिर<note caller="+" style="f"><char style="fr" closed="false">52:7 </char><char style="ft" closed="false">अर्थात् </char><char style="fqa" closed="false">यर्दनको बेँसीतिर</char></note> भागे; <verse eid="JER 52:7"/><verse number="8" style="v" sid="JER 52:8"/>तर बेबिलोनी सेनाले राजा सिदकियाहलाई खेदे, र तिनलाई यरीहोको मैदानमा फेला पारे। तिनका सबै सेना तिनीबाट अलग भएर छरपस्ट भएका थिए; <verse eid="JER 52:8"/><verse number="9" style="v" sid="JER 52:9"/>र तिनी पक्राउ परे।</para>
  <para style="p" vid="JER 52:9">तब तिनलाई बेबिलोनका राजाकहाँ हमातको सहर रिब्लामा लगियो, जहाँ बेबिलोनका राजाले सिदकियाहमाथि दण्डको घोषणा गरे। <verse eid="JER 52:9"/><verse number="10" style="v" sid="JER 52:10"/>त्यहाँ रिब्लामा बेबिलोनका राजाले सिदकियाहका छोराहरूलाई तिनकै आँखाको अगाडि मारे; तिनले यहूदाका सबै अधिकारीहरूलाई पनि मारे। <verse eid="JER 52:10"/><verse number="11" style="v" sid="JER 52:11"/>त्यसपछि तिनले सिदकियाहका आँखाहरू निकालिदिए; अनि तिनलाई काँसाको साङ्लाले बाँधेर बेबिलोनमा लगे, जहाँ तिनले सिदकियाहको मृत्यु नहोउन्जेलसम्म उनलाई झ्यालखानामा राखे।<verse eid="JER 52:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 52:12"/>बेबिलोनका राजा नबूकदनेसरको उन्‍नाइसौँ वर्षको पाँचौँ महिनाको दशौँ दिनमा, राजकीय अङ्गरक्षकहरूका सेनापति नबूजरदान जसले बेबिलोनका राजाको सेवा गर्थे, यरूशलेममा आए। <verse eid="JER 52:12"/><verse number="13" style="v" sid="JER 52:13"/>तिनले याहवेहको मन्दिर, राजमहल र यरूशलेमका सबै घरहरूमा आगो लगाइदिए। तिनले प्रत्येक मुख्य भवन जलाइदिए। <verse eid="JER 52:13"/><verse number="14" style="v" sid="JER 52:14"/>बेबिलोनका सम्पूर्ण फौजले राजकीय अङ्गरक्षकहरूका सेनापतिको अधीनमा यरूशलेमका चारैतिरका सबै पर्खालहरू भत्काइदिए। <verse eid="JER 52:14"/><verse number="15" style="v" sid="JER 52:15"/>अङ्गरक्षकहरूका सेनापति नबूजरदानले केही गरिब मानिसहरू र सहरमा बाँकी रहेकाहरू, साथै सिपालु कारिगरहरू र बेबिलोनका राजाको पछि लाग्ने मानिसहरूलाई कैदी बनाएर निर्वासनमा लगे। <verse eid="JER 52:15"/><verse number="16" style="v" sid="JER 52:16"/>तर नबूजरदानले देशमा बाँकी रहेका केही अति गरिब मानिसहरूचाहिँ दाखबारी र खेतबारीहरूमा काम गर्नलाई त्यहीँ छोडिदिए।<verse eid="JER 52:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 52:17"/>बेबिलोनीहरूले याहवेहको मन्दिरमा भएका काँसाका खम्बाहरू, ठेलागाडीहरू र काँसाका खड्कुँलो भत्काइदिए, र सबै काँसाचाहिँ तिनीहरूले बेबिलोनमा लगे। <verse eid="JER 52:17"/><verse number="18" style="v" sid="JER 52:18"/>तिनीहरूले भाँडाहरू, बेल्चाहरू, सलेदो काट्ने कैँचीहरू, छर्कने बाटाहरू, थाल बटुकाहरू र मन्दिरको सेवामा प्रयोग गरिने काँसाका सबै सरसामग्रीहरू लगे। <verse eid="JER 52:18"/><verse number="19" style="v" sid="JER 52:19"/>राजकीय अङ्गरक्षकका सेनापतिले बाटाहरू, धूपदानीहरू, छर्कने बाटाहरू, भाँडाहरू, सामदानहरू, थाल बटुकाहरू र अर्घबलिको निम्ति प्रयोग गरिने बाटाहरू—निखुर सुन र चाँदीले बनिएका सबै सामग्रीहरू तिनीहरूले लगे।<verse eid="JER 52:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 52:20"/>ती दुई स्तम्भहरू, खड्कुँलो र त्यसका मुन्तिर भएका काँसाका बाह्र वटा साँढेहरू र याहवेहको मन्दिरको निम्ति सोलोमन राजाले बनाएका गुड्ने आधारहरूबाट जम्मा गरिएका काँसाहरू जसको वजन जोखेर जोख्न नसकिने थिए। <verse eid="JER 52:20"/><verse number="21" style="v" sid="JER 52:21"/>प्रत्येक स्तम्भ अठार क्यूबिट अग्लो र त्यसको गोलाइ बाह्र क्यूबिटको<note caller="+" style="f"><char style="fr" closed="false">52:21 </char><char style="ft" closed="false">करिब 27 फिट अग्लो र 18 फिट परिधि</char></note> थियो। प्रत्येक खम्बा चार अङ्गुल बाक्लो मोटाइ र त्यो बीचमा खोक्रो थियो। <verse eid="JER 52:21"/><verse number="22" style="v" sid="JER 52:22"/>एउटा खम्बाको टुप्पोमा भएको काँसाको टुप्पो पाँच क्यूबिट<note caller="+" style="f"><char style="fr" closed="false">52:22 </char><char style="ft" closed="false">करिब 7 1⁄2 फिट</char></note> अग्लो थियो। अनि चारैतिर काँसाका जाली र दारिमको बुट्टाले वरिपरि सिँगारिएको थियो। अर्को खम्बा पनि त्यस्तै दारिम बुट्टाले सजिएको थियो। <verse eid="JER 52:22"/><verse number="23" style="v" sid="JER 52:23"/>त्यस खम्बाको छेउ-छेउमा छयानब्बे वटा दारिमको बुट्टाहरू थिए; चारैतिरका जालीमाथि भएका दारिमका बुट्टाहरूको संख्या एक सय थियो।<verse eid="JER 52:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 52:24"/>अङ्गरक्षकहरूका सेनापतिले मुख्य पुजारी सरायाह र दोस्रो दर्जाका पुजारी सपन्याह र तीन जना पहरेदारहरूलाई पनि कैद गरेर लगे। <verse eid="JER 52:24"/><verse number="25" style="v" sid="JER 52:25"/>सहरमा अझ रहेकाहरूमध्ये तिनले लडाकु मानिसहरूका अधिकृत र सात जना राजकीय सल्‍लाहकारहरूलाई पनि लगे। तिनले देशका मानिसहरूलाई सेनामा तयार गर्ने प्रमुख अधिकारी प्रधान सचिवसहित, सहरमा भेट्टाइएका साठी जना मानिसहरूलाई पनि लगे। <verse eid="JER 52:25"/><verse number="26" style="v" sid="JER 52:26"/>सेनापति नबूजरदानले तिनीहरू सबैलाई लगे, र बेबिलोनका राजाकहाँ रिब्लामा ल्याए। <verse eid="JER 52:26"/><verse number="27" style="v" sid="JER 52:27"/>त्यहाँ हमात देशको रिब्लामा राजाले तिनीहरूलाई मारे।</para>
  <para style="p" vid="JER 52:27">यसरी यहूदा आफ्नो देशबाट कैदमा लगियो।<verse eid="JER 52:27"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="28" style="v" sid="JER 52:28"/>नबूकदनेसरले निर्वासनमा लगेका मानिसहरूको संख्या यही हो:</para>
  <para style="b" vid="JER 52:28"/>
  <para style="li1" vid="JER 52:28">सातौँ वर्षमा,</para>
  <para style="li2" vid="JER 52:28">3,023 यहूदीहरू;<verse eid="JER 52:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="JER 52:29"/>नबूकदनेसरको शासनकालको अठारौँ वर्षमा यरूशलेमबाट</para>
  <para style="li2" vid="JER 52:29">832 मानिसहरू;<verse eid="JER 52:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="JER 52:30"/>तिनको शासनकालको तेईसौँ वर्षमा,</para>
  <para style="li2" vid="JER 52:30">राजकीय अङ्गरक्षका सेनापति नबूजरदानद्वारा 745 यहूदीहरू निर्वासनमा लगिए।</para>
  <para style="b" vid="JER 52:30"/>
  <para style="lf" vid="JER 52:30">त्यतिखेर जम्मा मानिसहरू 4,600 जना थिए।<verse eid="JER 52:30"/></para>
  <para style="s1">यहोयाकीन कैदबाट छुटेका</para>
  <para style="p">
    <verse number="31" style="v" sid="JER 52:31"/>यहूदाका राजा यहोयाकीनलाई निर्वासनमा लगिएको सैँतीसौँ वर्षमा, एबील-मरोदक बेबिलोनको राजा भएको वर्षमा तिनले बाह्रौँ महिनाको पच्‍चीसौँ दिनमा यहूदाका राजा यहोयाकीनलाई निकाले र झ्यालखानाबाट मुक्त गरिदिए। <verse eid="JER 52:31"/><verse number="32" style="v" sid="JER 52:32"/>तिनले उनीसित दयापूर्वक कुरा गरे, र आफूसित बेबिलोनमा भएका अरू राजाहरूभन्दा माथिल्‍लो दर्जाको सम्मानको आसन दिए। <verse eid="JER 52:32"/><verse number="33" style="v" sid="JER 52:33"/>यसकारण यहोयाकीनले आफ्ना कैदका वस्त्रहरू उतारे, र आफ्नो जीवनकालभरि नै राजाका टेबुलमा खाए। <verse eid="JER 52:33"/><verse number="34" style="v" sid="JER 52:34"/>बेबिलोनका राजाले यहोयाकीनको जीवनकालभरि तिनको मृत्यु नहुन्जेल दिन प्रतिदिन नियमित भत्ता दिए।<verse eid="JER 52:34"/></para>
  <chapter eid="JER 52"/>
</usx>
