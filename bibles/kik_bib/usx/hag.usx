<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HAG" style="id">- Biblica® Open Kikuyu Holy Word of God</book>
  
  <para style="h">Hagai</para>
  <para style="toc1">Hagai</para>
  <para style="toc2">Hagai</para>
  <para style="toc3">Hag</para>
  <para style="mt1">HAGAI</para>
  <chapter number="1" style="c" sid="HAG 1" />
  <para style="s1">Andũ kwĩrwo maake Nyũmba ya Jehova</para>
  <para style="p">
    <verse number="1" style="v" sid="HAG 1:1" />Na rĩrĩ, mwaka-inĩ wa keerĩ wa gũthamaka kwa Dario,<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">Mũthamaki Dario aathamakaga bũrũri wa Perisia mwaka-inĩ wa 522 nginya 486 mbere ya gũciarwo gwa Kristũ.</char></note> mũthenya wa mbere wa mweri wa gatandatũ, ndũmĩrĩri ya Jehova nĩyakinyĩire Zerubabeli mũrũ wa Shealitieli, mwathi wa bũrũri wa Juda, na kũrĩ Joshua mũrũ wa Jehozadaki, mũthĩnjĩri-Ngai ũrĩa mũnene, na kanua ka mũnabii Hagai makĩĩrwo atĩrĩ,<verse eid="HAG 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="HAG 1:2" />Jehova Mwene-Hinya-Wothe ekuuga atĩrĩ, “Andũ aya moigaga atĩrĩ, ‘Ihinda ti ikinyu rĩa gwakĩra Jehova nyũmba.’ ”<verse eid="HAG 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HAG 1:3" />Ningĩ ndũmĩrĩri ya Jehova ĩgĩũka na kanua ka mũnabii Hagai ĩkĩũria atĩrĩ, <verse eid="HAG 1:3" /><verse number="4" style="v" sid="HAG 1:4" />“Anga nĩ ihinda rĩanyu inyuĩ ene rĩa gũikara nyũmba iria ngʼemie na mbaũ rĩrĩa nyũmba ĩno yakwa ĩikarĩte ĩrĩ nyanangĩku?”<verse eid="HAG 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HAG 1:5" />Na rĩrĩ, Jehova Mwene-Hinya-Wothe ekuuga atĩrĩ, “Mwĩcũraniei wega ũrĩa mĩthiĩre yanyu ĩtariĩ. <verse eid="HAG 1:5" /><verse number="6" style="v" sid="HAG 1:6" />Mũhaandĩte irio nyingĩ, no mũkagetha o tũnini. Mũrĩĩaga no mũtihũũnaga. Mũnyuuaga no mũtinyootokaga. Mwĩhumbaga nguo no mũtiiguaga ũrugarĩ. Ningĩ ũrĩa ũthũkũmaga, aanyiita mũcaara wake awĩkagĩra mũhuko ũrĩ na marima.”<verse eid="HAG 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HAG 1:7" />Jehova Mwene-Hinya-Wothe ekuuga atĩrĩ, “Mwĩcũraniei wega ũrĩa mĩthiĩre yanyu ĩtariĩ. <verse eid="HAG 1:7" /><verse number="8" style="v" sid="HAG 1:8" />Ambatai irĩma-inĩ mũgĩĩre mbaũ, mũũke mũnjakĩre nyũmba, nĩgeetha niĩ ndĩmĩkenagĩre na nduĩke wa gũtĩĩagwo,” ũguo nĩguo Jehova ekuuga. <verse eid="HAG 1:8" /><verse number="9" style="v" sid="HAG 1:9" />Mwerĩgagĩrĩra uumithio mũingĩ, no rĩrĩ, mũkĩona o kĩndũ kĩnini. Kĩrĩa mwainũkirie, ngĩkĩũmbũra na mĩhũmũ yakwa. Jehova Mwene-Hinya-Wothe ekũũria atĩrĩ, “Ndeekire ũguo nĩkĩ? Ndeekire ũguo nĩ ũndũ wa nyũmba yakwa, ĩrĩa ĩikarĩte ĩrĩ nyanangĩku, rĩrĩa o ũmwe wanyu arahangʼĩra maũndũ ma nyũmba yake mwene. <verse eid="HAG 1:9" /><verse number="10" style="v" sid="HAG 1:10" />Nĩ ũndũ wanyu, igũrũ nĩrĩregete gũita ime, nayo thĩ ĩkarega na maciaro mayo. <verse eid="HAG 1:10" /><verse number="11" style="v" sid="HAG 1:11" />Nĩndatũmire bũrũri wage mbura mĩgũnda-inĩ na irĩma-inĩ, o na ngĩũmia ngano, na ngĩniina ndibei ya mũhihano na maguta na kĩrĩa gĩothe thĩ ĩciaraga, na ngĩnyiihia andũ na mahiũ, na ngĩthũkia wĩra wa moko manyu.”<verse eid="HAG 1:11" /></para>
  <para style="b" />
  <para style="p">
    <verse number="12" style="v" sid="HAG 1:12" />Ningĩ Zerubabeli mũrũ wa Shealitieli, na Joshua mũrũ wa Jehozadaki, mũthĩnjĩri-Ngai ũrĩa mũnene, na matigari mothe ma andũ, magĩathĩkĩra mũgambo wa Jehova Ngai wao, o na ndũmĩrĩri ya mũnabii Hagai, tondũ nĩ Jehova Ngai wao wamũtũmĩte. Nao andũ acio magĩĩtigĩra Jehova.<verse eid="HAG 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HAG 1:13" />Ningĩ Hagai mũtũmwo wa Jehova akĩheana ndũmĩrĩri ĩno ya Jehova kũrĩ andũ, akĩmeera atĩrĩ: Jehova ekuuga atĩrĩ, “Niĩ ndĩ hamwe na inyuĩ.” <verse eid="HAG 1:13" /><verse number="14" style="v" sid="HAG 1:14" />Nake Jehova akĩarahũra roho wa Zerubabeli mũrũ wa Shealitieli, mwathi wa Juda, na roho wa Joshua mũrũ wa Jehozadaki, mũthĩnjĩri-Ngai ũrĩa mũnene, o na roho wa andũ othe arĩa maatigarĩte, nao magĩũka, makĩambĩrĩria kũruta wĩra wa nyũmba ya Jehova Mwene-Hinya-Wothe, Ngai wao. <verse eid="HAG 1:14" /><verse number="15" style="v" sid="HAG 1:15" />Kwarĩ mũthenya wa mĩrongo ĩĩrĩ na ĩna, mweri wa gatandatũ, mwaka-inĩ wa keerĩ wa gũthamaka kwa Dario.<verse eid="HAG 1:15" /></para>
  <chapter eid="HAG 1" />
  <chapter number="2" style="c" sid="HAG 2" />
  <para style="s1">Riiri wa Nyũmba ĩyo Njerũ</para>
  <para style="p">
    <verse number="1" style="v" sid="HAG 2:1" />Na rĩrĩ, mũthenya wa mĩrongo ĩĩrĩ na ũmwe, mweri wa mũgwanja, ndũmĩrĩri ya Jehova nĩyakinyĩire mũnabii Hagai, akĩĩrwo atĩrĩ, <verse eid="HAG 2:1" /><verse number="2" style="v" sid="HAG 2:2" />“Arĩria Zerubabeli mũrũ wa Shealitieli, mwathi wa bũrũri wa Juda, na Joshua mũrũ wa Jehozadaki, mũthĩnjĩri-Ngai ũrĩa mũnene, na andũ othe arĩa matigaire, ũmoorie atĩrĩ, <verse eid="HAG 2:2" /><verse number="3" style="v" sid="HAG 2:3" />‘Nũũ wanyu ũtigarĩte wonire nyũmba ĩno na riiri wayo wa mbere? Mũrona ĩhaana atĩa rĩu? Githĩ mũtiramĩona ĩhaana ta kĩndũ gĩa tũhũ?’ <verse eid="HAG 2:3" /><verse number="4" style="v" sid="HAG 2:4" />Jehova ekuuga atĩrĩ, ‘Gĩa na hinya, wee Zerubabeli, na ũgĩe na hinya, wee Joshua mũrũ wa Jehozadaki, mũthĩnjĩri-Ngai ũrĩa mũnene, gĩai na hinya inyuĩ andũ othe a bũrũri, na mũrute wĩra, nĩgũkorwo ndĩ hamwe na inyuĩ.’ Ũguo nĩguo Jehova Mwene-Hinya-Wothe ekuuga. <verse eid="HAG 2:4" /><verse number="5" style="v" sid="HAG 2:5" />‘Ũguo nĩguo ndaarĩkanĩire na inyuĩ, rĩrĩa mwoimire bũrũri wa Misiri, na Roho wakwa egũtũũra thĩinĩ wanyu. Tigai gwĩtigĩra.’<verse eid="HAG 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HAG 2:6" />“Jehova Mwene-Hinya-Wothe ekuuga atĩrĩ; ‘Thuutha wa kahinda kanini nĩngathingithia igũrũ na thĩ rĩngĩ, na thingithie iria na thĩ nyũmũ. <verse eid="HAG 2:6" /><verse number="7" style="v" sid="HAG 2:7" />Nĩngathingithia ndũrĩrĩ ciothe, nake ũrĩa wĩriragĩrio nĩ ndũrĩrĩ ciothe nĩagooka, na niĩ nĩngaiyũria nyũmba ĩno riiri,’ ũguo nĩguo Jehova Mwene-Hinya-Wothe ekuuga. <verse eid="HAG 2:7" /><verse number="8" style="v" sid="HAG 2:8" />Jehova Mwene-Hinya-Wothe ekuuga atĩrĩ, ‘Betha nĩ yakwa, o na thahabu nĩ yakwa. <verse eid="HAG 2:8" /><verse number="9" style="v" sid="HAG 2:9" />Riiri wa nyũmba ĩno ũgaakorwo ũrĩ mũnene gũkĩra riiri wa nyũmba ĩrĩa ya mbere,’ ũguo nĩguo Jehova Mwene-Hinya-Wothe ekuuga. ‘Na handũ haha nĩngaheana thayũ,’ ũguo nĩguo Jehova Mwene-Hinya-Wothe ekuuga.”<verse eid="HAG 2:9" /></para>
  <para style="s1">Irathimo cia Andũ arĩa Marĩ na Thaahu</para>
  <para style="p">
    <verse number="10" style="v" sid="HAG 2:10" />Mũthenya wa mĩrongo ĩĩrĩ na ĩna, mweri wa kenda, mwaka wa keerĩ wa gũthamaka kwa Dario, ndũmĩrĩri ya Jehova nĩyakinyĩire mũnabii Hagai akĩĩrwo atĩrĩ, <verse eid="HAG 2:10" /><verse number="11" style="v" sid="HAG 2:11" />“Jehova Mwene-Hinya-Wothe ekuuga atĩrĩ, ‘Ũriai athĩnjĩri-Ngai ũrĩa watho ugĩte: <verse eid="HAG 2:11" /><verse number="12" style="v" sid="HAG 2:12" />Mũndũ angĩkuua nyama nyamũre ruuno-inĩ rwa nguo yake, naruo ruuno rũhutie mũgate, kana thubu, kana ndibei, kana maguta, o na kana irio ingĩ-rĩ, irio icio ciatuĩka nyamũre?’ ”</para>
  <para style="p" vid="HAG 2:12">Nao athĩnjĩri-Ngai magĩcookia atĩrĩ, “Aca.”<verse eid="HAG 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HAG 2:13" />Ningĩ Hagai akĩmooria atĩrĩ, “Mũndũ ũrĩ na thaahu nĩ ũndũ wa kũhutania na kĩimba, angĩhutia kĩndũ kĩmwe gĩa icio-rĩ, kĩndũ kĩu no kĩnyiitwo nĩ thaahu?”</para>
  <para style="p" vid="HAG 2:13">Nao athĩnjĩri-Ngai magĩcookia atĩrĩ, “Ĩĩ, no kĩnyiitwo nĩ thaahu.”<verse eid="HAG 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HAG 2:14" />Ningĩ Hagai akĩmeera atĩrĩ, “Jehova ekuuga atĩrĩ, ‘Ũguo noguo andũ aya na rũrĩrĩ rũrũ matariĩ maitho-inĩ makwa; ũrĩa wothe meekaga na kĩrĩa gĩothe marutaga kũu, kĩrĩ na thaahu.<verse eid="HAG 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HAG 2:15" />“ ‘Na rĩrĩ, mwĩcũraniei wega ũhoro ũyũ kuuma ũmũthĩ, mũtaranie ũrĩa maũndũ maatariĩ mbere ya rĩrĩa gũtaarĩ ihiga rĩaigĩrĩirwo igũrũ wa rĩngĩ mwako-inĩ wa hekarũ ĩno ya Jehova. <verse eid="HAG 2:15" /><verse number="16" style="v" sid="HAG 2:16" />Mũndũ o wothe angĩathiire hĩba-inĩ ya ngano ya ithimi mĩrongo ĩĩrĩ, aakoraga no ithimi ikũmi. Mũndũ o wothe angĩathiire itangi-inĩ rĩa ndibei erĩgĩrĩire gũtahia ithimi mĩrongo ĩtano, aakoraga o mĩrongo ĩĩrĩ. <verse eid="HAG 2:16" /><verse number="17" style="v" sid="HAG 2:17" />Ndathũkirie wĩra wothe wa moko manyu na mbaa, na mbuu na mbura ya mbembe,<note caller="+" style="f"><char style="fr" closed="false">2:17 </char><char style="ft" closed="false">Rũhuho rũhiũ na mbura ya mbembe ciatũmagĩrwo nĩ Ngai kũhũũra andũ nĩ ũndũ wa ũremi wao.</char></note> no inyuĩ mũtiigana kũnjookerera,’ ũguo nĩguo Jehova ekuuga. <verse eid="HAG 2:17" /><verse number="18" style="v" sid="HAG 2:18" />Kuuma ũmũthĩ na gũthiĩ na mbere, kuuma mũthenya ũyũ wa mweri mĩrongo ĩĩrĩ na inya, mweri wa kenda, mwĩcũraniei wega ũhoro wa mũthenya ũrĩa mũthingi wa hekarũ ya Jehova wakirwo. Ta mwĩcũraniei wega: <verse eid="HAG 2:18" /><verse number="19" style="v" sid="HAG 2:19" />Nĩ hakĩrĩ o na mbeũ ĩtigarĩte ikũmbĩ-inĩ? Nginyagia rĩu, mĩthabibũ, na mĩkũyũ, na mĩkomamanga, o na mĩtamaiyũ ndĩrĩ ĩragĩa na maciaro.</para>
  <para style="p" vid="HAG 2:19">“ ‘Kuuma ũmũthĩ nĩndĩrĩmũrathimaga.’ ”<verse eid="HAG 2:19" /></para>
  <para style="s1">Zerubabeli, Gĩcũhĩ kĩa Jehova</para>
  <para style="p">
    <verse number="20" style="v" sid="HAG 2:20" />Ningĩ ndũmĩrĩri ya Jehova nĩyakinyĩire Hagai hĩndĩ ya keerĩ, mweri mĩrongo ĩĩrĩ na inya wa mweri ũcio, akĩĩrwo atĩrĩ, <verse eid="HAG 2:20" /><verse number="21" style="v" sid="HAG 2:21" />“Arĩria Zerubabeli mwathi wa Juda, ũmwĩre atĩ nĩngathingithia igũrũ na thĩ. <verse eid="HAG 2:21" /><verse number="22" style="v" sid="HAG 2:22" />Nĩngangʼaũrania itĩ cia ũnene, na hehenje hinya wa mothamaki ma thĩ ngʼeni. Nĩngakurumania ngaari cia ita, na atwarithia a cio; na ndungumanie mbarathi hamwe na ahaici a cio, o mũndũ arũndwo na rũhiũ rwa njora rwa mũrũ wa nyina.<verse eid="HAG 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HAG 2:23" />“Jehova Mwene-Hinya-Wothe ekuuga atĩrĩ, ‘Mũthenya ũcio-rĩ, nĩngakwamũkĩra, wee ndungata yakwa Zerubabeli mũrũ wa Shealitieli,’ ũguo nĩguo Jehova ekuuga. ‘Ningĩ nĩngagũtua ta gĩcũhĩ gĩakwa gĩa kĩara, gĩkurure rũũri rwakwa, nĩgũkorwo nĩngũthuurĩte,’ ũguo nĩguo Jehova Mwene-Hinya-Wothe ekuuga.”<verse eid="HAG 2:23" /></para>
  <chapter eid="HAG 2" />
</usx>