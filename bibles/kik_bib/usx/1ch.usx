<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1CH" style="id">- Biblica® Open Kikuyu Holy Word of God</book>
  <para style="h">1 Maũndũ Ma Matukũ Ma Tene</para>
  <para style="toc1">1 Maũndũ Ma Matukũ Ma Tene</para>
  <para style="toc2">1 Maũndũ Ma Matukũ Ma Tene</para>
  <para style="toc3">1Maũ</para>
  <para style="mt1">IBUKU RĨA MBERE RĨA</para>
  <para style="mt1">MAŨNDŨ MA MATUKŨ MA TENE</para>
  <chapter number="1" style="c" sid="1CH 1"/>
  <para style="s1">Maandĩko ma Maũndũ ma Tene kuuma Adamu nginya Iburahĩmu</para>
  <para style="s3">Nginya Ariũ a Nuhu</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 1:1"/>Njiaro cia Adamu ciarĩ Sethi, na Enoshu, <verse eid="1CH 1:1"/><verse number="2" style="v" sid="1CH 1:2"/>na Kenani, na Mahalaleli, na Jaredi, <verse eid="1CH 1:2"/><verse number="3" style="v" sid="1CH 1:3"/>na Enoku, na Methusela, na Lameku, na Nuhu.<verse eid="1CH 1:3"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 1:4"/>Ariũ a Nuhu maarĩ:</para>
  <para style="li2" vid="1CH 1:4">Shemu, na Hamu, na Jafethu.<verse eid="1CH 1:4"/></para>
  <para style="s3">Ariũ a Jafethu</para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 1:5"/>Ariũ a Jafethu maarĩ:</para>
  <para style="li2" vid="1CH 1:5">Gomeri, na Magogu, na Madai, na Javani, na Tubali, na Mesheki, na Tirasi.<verse eid="1CH 1:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 1:6"/>Ariũ a Gomeri maarĩ:</para>
  <para style="li2" vid="1CH 1:6">Ashikenazu, na Difatha, na Togarima.<verse eid="1CH 1:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 1:7"/>Ariũ a Javani maarĩ:</para>
  <para style="li2" vid="1CH 1:7">Elisha, na Tarishishi, na Kitimu, na Rodanimu.<verse eid="1CH 1:7"/></para>
  <para style="s3">Ariũ a Hamu</para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 1:8"/>Ariũ a Hamu maarĩ:</para>
  <para style="li2" vid="1CH 1:8">Kushi, na Miziraimu, na Putu, na Kaanani.<verse eid="1CH 1:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 1:9"/>Ariũ a Kushi maarĩ:</para>
  <para style="li2" vid="1CH 1:9">Seba, na Havila, na Sabita, na Raama, na Sabiteka.</para>
  <para style="li1" vid="1CH 1:9">Ariũ a Raama maarĩ:</para>
  <para style="li2" vid="1CH 1:9">Sheba, na Dedani.<verse eid="1CH 1:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 1:10"/>Kushi nĩwe warĩ ithe wa</para>
  <para style="li2" vid="1CH 1:10">Nimurodi ũrĩa wakũrire agĩtuĩka njamba ya ita ĩrĩ hinya thĩinĩ wa thĩ.<verse eid="1CH 1:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 1:11"/>Miziraimu nĩwe warĩ ithe wa</para>
  <para style="li2" vid="1CH 1:11">andũ a Ludimu, na Anamini, na Lehabimu, na Nafituhimu, <verse eid="1CH 1:11"/><verse number="12" style="v" sid="1CH 1:12"/>na Pathirusimu, na Kasuluhimu (nĩwe warĩ kĩhumo kĩa Afilisti), o na Kafitorimu.<verse eid="1CH 1:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 1:13"/>Kaanani nĩwe warĩ ithe wa<verse eid="1CH 1:13"/></para>
  <para style="li2">
    <verse number="14" style="v" sid="1CH 1:14"/>Sidoni, mũriũ wake wa irigithathi, na Ahiti, na Ajebusi, na Aamori, na Agirigashi, <verse eid="1CH 1:14"/><verse number="15" style="v" sid="1CH 1:15"/>na Ahivi, na Aariki, na Asini, <verse eid="1CH 1:15"/><verse number="16" style="v" sid="1CH 1:16"/>na Aarivadi, na Azemari, na Ahamathi.<verse eid="1CH 1:16"/></para>
  <para style="s3">Ariũ a Shemu</para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 1:17"/>Ariũ a Shemu maarĩ:</para>
  <para style="li2" vid="1CH 1:17">Elamu, na Ashuri, na Arafakasadi, na Ludu, na Aramu.</para>
  <para style="li1" vid="1CH 1:17">Ariũ a Aramu maarĩ:</para>
  <para style="li2" vid="1CH 1:17">Uzu, na Hulu, na Getheru, na Mesheki.<verse eid="1CH 1:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 1:18"/>Arafakasadi nĩwe warĩ ithe wa Shela, nake Shela aarĩ ithe wa Eberi.<verse eid="1CH 1:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 1:19"/>Eberi aarĩ na ariũ eerĩ:</para>
  <para style="li2" vid="1CH 1:19">Ũmwe eetagwo Pelegu, tondũ hĩndĩ yake nĩrĩo thĩ yagayũkanirio; na mũrũ wa nyina eetagwo Jokitani.<verse eid="1CH 1:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 1:20"/>Jokitani nĩwe warĩ ithe wa</para>
  <para style="li2" vid="1CH 1:20">Alimodadi, na Shelefu, na Hazarimavethu, na Jera, <verse eid="1CH 1:20"/><verse number="21" style="v" sid="1CH 1:21"/>na Hadoramu, na Uzali, na Dikila, <verse eid="1CH 1:21"/><verse number="22" style="v" sid="1CH 1:22"/>na Ebali, na Abimaeli, na Sheba, <verse eid="1CH 1:22"/><verse number="23" style="v" sid="1CH 1:23"/>na Ofiri, na Havila, na Jobabu. Acio othe maarĩ ariũ a Jokitani.<verse eid="1CH 1:23"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 1:24"/>Shemu, na Arafakasadi, na Shela,<verse eid="1CH 1:24"/></para>
  <para style="li2">
    <verse number="25" style="v" sid="1CH 1:25"/>na Eberi, na Pelegu, na Reu,<verse eid="1CH 1:25"/></para>
  <para style="li2">
    <verse number="26" style="v" sid="1CH 1:26"/>na Serugu, na Nahoru, na Tera,<verse eid="1CH 1:26"/></para>
  <para style="li2">
    <verse number="27" style="v" sid="1CH 1:27"/>na Aburamu (na nĩwe Iburahĩmu).<verse eid="1CH 1:27"/></para>
  <para style="s2">Nyũmba ya Iburahĩmu</para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 1:28"/>Ariũ a Iburahĩmu maarĩ:</para>
  <para style="li2" vid="1CH 1:28">Isaaka na Ishumaeli.<verse eid="1CH 1:28"/></para>
  <para style="s3">Njiaro cia Hagari</para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 1:29"/>Ici nĩcio njiaro ciao:</para>
  <para style="li2" vid="1CH 1:29">Nebaiothu nĩwe warĩ irigithathi rĩa Ishumaeli, nao ariũ ake arĩa angĩ maarĩ Kedari, na Adibeeli, na Mibisamu, <verse eid="1CH 1:29"/><verse number="30" style="v" sid="1CH 1:30"/>na Mishima, na Duma, na Masa, na Hadadi, na Tema, <verse eid="1CH 1:30"/><verse number="31" style="v" sid="1CH 1:31"/>na Jeturu, na Nafishu, na Kedema. Acio nĩo maarĩ ariũ a Ishumaeli.<verse eid="1CH 1:31"/></para>
  <para style="s3">Njiaro cia Ketura</para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 1:32"/>Ariũ a Ketura, ũrĩa warĩ thuriya ya Iburahĩmu, maarĩ:</para>
  <para style="li2" vid="1CH 1:32">Zimirani, na Jokishani, na Medani, na Midiani, na Ishibaku, na Shua.</para>
  <para style="li1" vid="1CH 1:32">Ariũ a Jokishani maarĩ:</para>
  <para style="li2" vid="1CH 1:32">Sheba na Dedani.<verse eid="1CH 1:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 1:33"/>Ariũ a Midiani maarĩ:</para>
  <para style="li2" vid="1CH 1:33">Efa, na Eferi, na Hanoku, na Abida, na Elidaa.</para>
  <para style="li1" vid="1CH 1:33">Acio othe maarĩ a rũciaro rwa Ketura.<verse eid="1CH 1:33"/></para>
  <para style="s3">Njiaro cia Sara</para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 1:34"/>Iburahĩmu nĩwe warĩ ithe wa Isaaka.</para>
  <para style="li1" vid="1CH 1:34">Ariũ a Isaaka maarĩ:</para>
  <para style="li2" vid="1CH 1:34">Esaũ na Isiraeli.<verse eid="1CH 1:34"/></para>
  <para style="s2">Ariũ a Esaũ</para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 1:35"/>Ariũ a Esaũ maarĩ:</para>
  <para style="li2" vid="1CH 1:35">Elifazu, na Reueli, na Jeushu, na Jalamu, na Kora.<verse eid="1CH 1:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 1:36"/>Ariũ a Elifazu maarĩ:</para>
  <para style="li2" vid="1CH 1:36">Temani, na Omari, na Zefi, na Gatamu, na Kenazu;</para>
  <para style="li2" vid="1CH 1:36">na Amaleki, ũrĩa waciarirwo nĩ Timina.<verse eid="1CH 1:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 1:37"/>Ariũ a Reueli maarĩ:</para>
  <para style="li2" vid="1CH 1:37">Nahathu, na Zera, na Shama, na Miza.<verse eid="1CH 1:37"/></para>
  <para style="s2">Andũ a Seiru kũu Edomu</para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 1:38"/>Ariũ a Seiru maarĩ:</para>
  <para style="li2" vid="1CH 1:38">Lotani, na Shobali, na Zibeoni, na Ana, na Dishoni, na Ezeri, na Dishani.<verse eid="1CH 1:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 1:39"/>Ariũ a Lotani maarĩ:</para>
  <para style="li2" vid="1CH 1:39">Hori na Homamu.</para>
  <para style="li2" vid="1CH 1:39">Nake Timina aarĩ mwarĩ wa nyina na Lotani.<verse eid="1CH 1:39"/></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 1:40"/>Ariũ a Shobali maarĩ:</para>
  <para style="li2" vid="1CH 1:40">Alivani, na Manahathu, na Ebali, na Shefo, na Onamu.</para>
  <para style="li1" vid="1CH 1:40">Ariũ a Zibeoni maarĩ:</para>
  <para style="li2" vid="1CH 1:40">Aia na Ana.<verse eid="1CH 1:40"/></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 1:41"/>Mũriũ wa Ana aarĩ:</para>
  <para style="li2" vid="1CH 1:41">Dishoni.</para>
  <para style="li1" vid="1CH 1:41">Ariũ a Dishoni maarĩ:</para>
  <para style="li2" vid="1CH 1:41">Hemudani, na Eshibani, na Ithirani, na Kerani.<verse eid="1CH 1:41"/></para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 1:42"/>Ariũ a Ezeri maarĩ:</para>
  <para style="li2" vid="1CH 1:42">Bilihani, na Zaavani, na Akani.</para>
  <para style="li1" vid="1CH 1:42">Ariũ a Dishani maarĩ:</para>
  <para style="li2" vid="1CH 1:42">Uzu, na Arani.<verse eid="1CH 1:42"/></para>
  <para style="s3">Athamaki a Edomu</para>
  <para style="li1">
    <verse number="43" style="v" sid="1CH 1:43"/>Nao aya nĩo maarĩ athamaki arĩa maathamakaga Edomu mbere ya Isiraeli gũthamakĩrwo nĩ mũthamaki o na ũmwe:</para>
  <para style="li2" vid="1CH 1:43">Nĩ Bela mũrũ wa Beori, narĩo itũũra rĩake inene rĩetagwo Dinihaba.<verse eid="1CH 1:43"/></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 1:44"/>Rĩrĩa Bela aakuire, Jobabu mũrũ wa Zera wa kuuma Bozira agĩtuĩka mũthamaki ithenya rĩake.<verse eid="1CH 1:44"/></para>
  <para style="li1">
    <verse number="45" style="v" sid="1CH 1:45"/>Rĩrĩa Jobabu aakuire, Hushamu wa kuuma bũrũri wa Atemani agĩtuĩka mũthamaki ithenya rĩake.<verse eid="1CH 1:45"/></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 1:46"/>Rĩrĩa Hushamu aakuire, Hadadi mũrũ wa Bedadi ũrĩa wahootire Midiani kũu bũrũri wa Moabi, agĩtuĩka mũthamaki ithenya rĩake. Itũũra rĩake inene rĩetagwo Avithu.<verse eid="1CH 1:46"/></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 1:47"/>Rĩrĩa Hadadi aakuire, Samala wa kuuma Masereka agĩtuĩka mũthamaki ithenya rĩake.<verse eid="1CH 1:47"/></para>
  <para style="li1">
    <verse number="48" style="v" sid="1CH 1:48"/>Rĩrĩa Samala aakuire, Shauli wa kuuma Rehobothu kũu gũkuhĩ na Rũũĩ rwa Farati, agĩtuĩka mũthamaki ithenya rĩake.<verse eid="1CH 1:48"/></para>
  <para style="li1">
    <verse number="49" style="v" sid="1CH 1:49"/>Rĩrĩa Shauli aakuire, Baali-Hanani mũrũ wa Akibori agĩtuĩka mũthamaki ithenya rĩake.<verse eid="1CH 1:49"/></para>
  <para style="li1">
    <verse number="50" style="v" sid="1CH 1:50"/>Rĩrĩa Baali-Hanani aakuire, Hadadi agĩtuĩka mũthamaki ithenya rĩake. Itũũra rĩake inene rĩetagwo Pau, na mũtumia wake eetagwo Mehetabeli mwarĩ wa Matiredi, ũrĩa warĩ mwarĩ wa Me-Zahabu. <verse eid="1CH 1:50"/><verse number="51" style="v" sid="1CH 1:51"/>Hadadi o nake agĩkua.</para>
  <para style="b" vid="1CH 1:51"/>
  <para style="li1" vid="1CH 1:51">Anene a Edomu maarĩ:<verse eid="1CH 1:51"/></para>
  <para style="li2">
    <verse number="52" style="v" sid="1CH 1:52"/>Timina, na Aliva, na Jethethu, na Oholibama, na Ela, na Pinoni, <verse eid="1CH 1:52"/><verse number="53" style="v" sid="1CH 1:53"/>na Kenazu, na Temani, na Mibizaru, <verse eid="1CH 1:53"/><verse number="54" style="v" sid="1CH 1:54"/>na Magidieli, na Iramu. Acio nĩo maarĩ anene a Edomu.<verse eid="1CH 1:54"/></para>
  <chapter eid="1CH 1"/>
  <chapter number="2" style="c" sid="1CH 2"/>
  <para style="s1">Ariũ a Isiraeli</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 2:1"/>Aya nĩo maarĩ ariũ a Isiraeli:</para>
  <para style="li2" vid="1CH 2:1">Rubeni, na Simeoni, na Lawi, na Juda, na Isakaru, na Zebuluni, <verse eid="1CH 2:1"/><verse number="2" style="v" sid="1CH 2:2"/>na Dani, na Jusufu, na Benjamini, na Nafitali, na Gadi, na Asheri.<verse eid="1CH 2:2"/></para>
  <para style="s2">Juda</para>
  <para style="s3">Kũrĩ ariũ a Hezironi</para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 2:3"/>Ariũ a Juda maarĩ:</para>
  <para style="li2" vid="1CH 2:3">Eri, na Onani, na Shela. Acio atatũ maaciarĩirwo Juda nĩ mũtumia Mũkaanani, mwarĩ wa Shua. Eri, irigithathi rĩa Juda, aarĩ mwaganu maitho-inĩ ma Jehova; nĩ ũndũ ũcio Jehova akĩmũũraga. <verse eid="1CH 2:3"/><verse number="4" style="v" sid="1CH 2:4"/>Tamaru, mũtumia wa mũrũ wa Juda, akĩmũciarĩra Perezu na Zera. Ariũ othe a Juda maarĩ atano.<verse eid="1CH 2:4"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 2:5"/>Ariũ a Perezu maarĩ:</para>
  <para style="li2" vid="1CH 2:5">Hezironi na Hamula.<verse eid="1CH 2:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 2:6"/>Ariũ a Zera maarĩ:</para>
  <para style="li2" vid="1CH 2:6">Zimuri, na Ethani, na Hemani, na Kalikoli, na Darida; othe maarĩ atano.<verse eid="1CH 2:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 2:7"/>Mũriũ wa Karimi aarĩ:</para>
  <para style="li2" vid="1CH 2:7">Akaru, ũrĩa wareheire Isiraeli thĩĩna nĩ ũndũ wa kuuna watho na kuoya indo iria ciarĩ nyamũre.<verse eid="1CH 2:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 2:8"/>Mũriũ wa Ethani aarĩ:</para>
  <para style="li2" vid="1CH 2:8">Azaria.<verse eid="1CH 2:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 2:9"/>Ariũ arĩa maaciarĩrĩirwo Hezironi maarĩ:</para>
  <para style="li2" vid="1CH 2:9">Jerameeli, na Ramu, na Kalebu.<verse eid="1CH 2:9"/></para>
  <para style="s3">Ciana cia Ramu Mũrũ wa Hezironi</para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 2:10"/>Ramu nĩwe warĩ ithe wa</para>
  <para style="li2" vid="1CH 2:10">Aminadabu, nake Aminadabu aarĩ ithe wa Nahashoni, ũrĩa warĩ mũtongoria wa andũ a Juda. <verse eid="1CH 2:10"/><verse number="11" style="v" sid="1CH 2:11"/>Nahashoni nĩwe warĩ ithe wa Salimoni, nake Salimoni aarĩ ithe wa Boazu, <verse eid="1CH 2:11"/><verse number="12" style="v" sid="1CH 2:12"/>nake Boazu nĩwe warĩ ithe wa Obedi, ũria warĩ ithe wa Jesii.<verse eid="1CH 2:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 2:13"/>Jesii nĩwe warĩ ithe wa Eliabu, irigithathi rĩake; nake Abinadabu aarĩ wa keerĩ, na Shimea wa gatatũ, <verse eid="1CH 2:13"/><verse number="14" style="v" sid="1CH 2:14"/>na Nethaneli wa kana, nake Radai wa gatano, <verse eid="1CH 2:14"/><verse number="15" style="v" sid="1CH 2:15"/>na Ozemu wa gatandatũ, nake Daudi aarĩ wa mũgwanja. <verse eid="1CH 2:15"/><verse number="16" style="v" sid="1CH 2:16"/>Nao aarĩ a nyina maarĩ Zeruia na Abigaili. Ariũ a Zeruia maarĩ atatũ, na nĩo Abishai, na Joabu, na Asaheli. <verse eid="1CH 2:16"/><verse number="17" style="v" sid="1CH 2:17"/>Abigaili nĩwe warĩ nyina wa Amasa, na ithe wa Amasa aarĩ Jetheri ũrĩa Mũishumaeli.<verse eid="1CH 2:17"/></para>
  <para style="s3">Kalebu Mũrũ wa Hezironi</para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 2:18"/>Kalebu mũrũ wa Hezironi nĩagĩire ciana na mũtumia wake Azuba (o na ningĩ na Jeriothu). Ariũ a mũtumia ũcio maarĩ: Jesheri, na Shobabu, na Aridoni. <verse eid="1CH 2:18"/><verse number="19" style="v" sid="1CH 2:19"/>Hĩndĩ ĩrĩa Azuba aakuire, Kalebu akĩhikia Efiratha, ũrĩa wamũciarĩire Huru. <verse eid="1CH 2:19"/><verse number="20" style="v" sid="1CH 2:20"/>Huru nĩwe warĩ ithe wa Uri, nake Uri nĩwe warĩ ithe wa Bezaleli.<verse eid="1CH 2:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 2:21"/>Thuutha ũcio, Hezironi agĩkoma na mwarĩ wa Makiru ũrĩa warĩ ithe wa Gileadi (Hezironi aarĩ wa mĩaka mĩrongo ĩtandatũ akĩmũhikia), nake akĩmũciarĩra Segubu. <verse eid="1CH 2:21"/><verse number="22" style="v" sid="1CH 2:22"/>Segubu nĩwe warĩ ithe wa Jairu, ũrĩa warĩ na matũũra mĩrongo ĩĩrĩ na matatũ kũu Gileadi. <verse eid="1CH 2:22"/><verse number="23" style="v" sid="1CH 2:23"/>(No rĩrĩ, Geshuru na Aramu magĩtunyana matũũra ma Havothu-Jairu, o hamwe na Kenathu na ciikaro iria ciarĩthiũrũrũkĩirie, namo maarĩ matũũra mĩrongo ĩtandatũ.) Aya othe nĩo maarĩ njiaro cia Makiru, o we ithe wa Gileadi.<verse eid="1CH 2:23"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 2:24"/>Thuutha wa Hezironi gũkua arĩ kũu Kalebu-Efiratha-rĩ, Abija mũtumia wa Hezironi akĩmũciarĩra Ashuru, ithe wa Tekoa.<verse eid="1CH 2:24"/></para>
  <para style="s2">Jerameeli Mũrũ wa Hezironi</para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 2:25"/>Ariũ a Jerameeli, ũrĩa warĩ irigithathi rĩa Hezironi, maarĩ:</para>
  <para style="li2" vid="1CH 2:25">Ramu ũrĩa warĩ irigithathi rĩake, na Buna, na Oreni, na Ozemu, na Ahija. <verse eid="1CH 2:25"/><verse number="26" style="v" sid="1CH 2:26"/>Jerameeli aarĩ na mũtumia ũngĩ wetagwo Atara, nake nĩwe warĩ nyina wa Onamu.<verse eid="1CH 2:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 2:27"/>Ariũ a Ramu, ũrĩa warĩ irigithathi rĩa Jerameeli, maarĩ:</para>
  <para style="li2" vid="1CH 2:27">Maazu, na Jamini, na Ekeri.<verse eid="1CH 2:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 2:28"/>Ariũ a Onamu maarĩ:</para>
  <para style="li2" vid="1CH 2:28">Shamai na Jada.</para>
  <para style="li1" vid="1CH 2:28">Nao ariũ a Shamai maarĩ:</para>
  <para style="li2" vid="1CH 2:28">Nadabu na Abishuri.<verse eid="1CH 2:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 2:29"/>Mũtumia wa Abishuri eetagwo Abihaili, ũrĩa wamũciarĩire Ahabani na Molidi.<verse eid="1CH 2:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 2:30"/>Ariũ a Nadabu maarĩ:</para>
  <para style="li2" vid="1CH 2:30">Seledi na Apaimu. No rĩrĩ, Seledi aakuire atarĩ na ciana.<verse eid="1CH 2:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 2:31"/>Mũrũ wa Apaimu aarĩ:</para>
  <para style="li2" vid="1CH 2:31">Ishi, ũrĩa warĩ ithe wa Sheshani.</para>
  <para style="li2" vid="1CH 2:31">Nake Sheshani nĩwe warĩ ithe wa Ahalai.<verse eid="1CH 2:31"/></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 2:32"/>Ariũ a Jada, mũrũ wa nyina na Shamai, maarĩ:</para>
  <para style="li2" vid="1CH 2:32">Jetheri na Jonathani. Jetheri aakuire atarĩ na ciana.<verse eid="1CH 2:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 2:33"/>Ariũ a Jonathani maarĩ:</para>
  <para style="li2" vid="1CH 2:33">Pelethu na Zaza.</para>
  <para style="li1" vid="1CH 2:33">Acio nĩo maarĩ njiaro cia Jerameeli.<verse eid="1CH 2:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 2:34"/>Sheshani ndaarĩ na aanake, no airĩtu.</para>
  <para style="li2" vid="1CH 2:34">Aarĩ na ndungata ya kuuma Misiri yetagwo Jariha. <verse eid="1CH 2:34"/><verse number="35" style="v" sid="1CH 2:35"/>Sheshani akĩhe Jariha ndungata ĩyo yake mwarĩ ĩmũhikie, nake akĩgĩa mwana wetagwo Atai.<verse eid="1CH 2:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 2:36"/>Atai nĩwe warĩ ithe wa Nathani,</para>
  <para style="li2" vid="1CH 2:36">nake Nathani nĩwe warĩ ithe wa Zabadi,<verse eid="1CH 2:36"/></para>
  <para style="li2">
    <verse number="37" style="v" sid="1CH 2:37"/>nake Zabadi nĩwe warĩ ithe wa Efilali,</para>
  <para style="li2" vid="1CH 2:37">nake Efilali nĩwe warĩ ithe wa Obedi,<verse eid="1CH 2:37"/></para>
  <para style="li2">
    <verse number="38" style="v" sid="1CH 2:38"/>nake Obedi nĩwe warĩ ithe wa Jehu,</para>
  <para style="li2" vid="1CH 2:38">nake Jehu nĩwe warĩ ithe wa Azaria,<verse eid="1CH 2:38"/></para>
  <para style="li2">
    <verse number="39" style="v" sid="1CH 2:39"/>nake Azaria nĩwe warĩ ithe wa Helezu,</para>
  <para style="li2" vid="1CH 2:39">nake Helezu nĩwe warĩ ithe wa Eleasa,<verse eid="1CH 2:39"/></para>
  <para style="li2">
    <verse number="40" style="v" sid="1CH 2:40"/>nake Eleasa nĩwe warĩ ithe wa Sisimai,</para>
  <para style="li2" vid="1CH 2:40">nake Sisimai nĩwe warĩ ithe wa Shalumu,<verse eid="1CH 2:40"/></para>
  <para style="li2">
    <verse number="41" style="v" sid="1CH 2:41"/>nake Shalumu nĩwe warĩ ithe wa Jekamia,</para>
  <para style="li2" vid="1CH 2:41">nake Jekamia nĩwe warĩ ithe wa Elishama.<verse eid="1CH 2:41"/></para>
  <para style="s3">Mbarĩ cia Kalebu</para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 2:42"/>Ariũ a Kalebu, ũrĩa warĩ mũrũ wa nyina na Jerameeli, maarĩ:</para>
  <para style="li2" vid="1CH 2:42">Mesha irigithathi rĩake, na nĩwe warĩ ithe wa Zifu, na mũriũ Maresha ũrĩa warĩ ithe wa Hebironi.<verse eid="1CH 2:42"/></para>
  <para style="li1">
    <verse number="43" style="v" sid="1CH 2:43"/>Ariũ a Hebironi maarĩ:</para>
  <para style="li2" vid="1CH 2:43">Kora, na Tapua, na Rekemu, na Shema. <verse eid="1CH 2:43"/><verse number="44" style="v" sid="1CH 2:44"/>Shema nĩwe warĩ ithe wa Rahamu, na Rahamu nĩwe warĩ ithe wa Jorikeamu. Rekemu aarĩ ithe wa Shamai. <verse eid="1CH 2:44"/><verse number="45" style="v" sid="1CH 2:45"/>Mũrũ wa Shamai aarĩ Maoni, nake nĩwe warĩ ithe wa Bethi-Zuru.<verse eid="1CH 2:45"/></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 2:46"/>Nake Efa, thuriya ya Kalebu, nĩwe warĩ nyina wa Harani, na Moza, na Gazezi. Nake Harani nĩwe warĩ ithe wa Gazezi.<verse eid="1CH 2:46"/></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 2:47"/>Ariũ a Jahadai maarĩ:</para>
  <para style="li2" vid="1CH 2:47">Regemu, na Jothamu, na Geshani, na Peleti, na Efa, na Shaafu.<verse eid="1CH 2:47"/></para>
  <para style="li1">
    <verse number="48" style="v" sid="1CH 2:48"/>Nake Maaka, thuriya ya Kalebu, nĩwe warĩ nyina wa Sheberi na Tirihana. <verse eid="1CH 2:48"/><verse number="49" style="v" sid="1CH 2:49"/>Ningĩ nowe waciarire Shaafu ũrĩa warĩ ithe wa Madimana, na Sheva ithe wa Makibena na Gibea. Mwarĩ wa Kalebu eetagwo Akisa. <verse eid="1CH 2:49"/><verse number="50" style="v" sid="1CH 2:50"/>Acio nĩo maarĩ njiaro cia Kalebu.</para>
  <para style="b" vid="1CH 2:50"/>
  <para style="li1" vid="1CH 2:50">Ariũ a Huru, irigithathi rĩa Efiratha, maarĩ:</para>
  <para style="li2" vid="1CH 2:50">Shobali ithe wa Kiriathu-Jearimu, <verse eid="1CH 2:50"/><verse number="51" style="v" sid="1CH 2:51"/>na Salima ithe wa Bethilehemu, na Harefu ithe wa Bethi-Gaderi.<verse eid="1CH 2:51"/></para>
  <para style="li1">
    <verse number="52" style="v" sid="1CH 2:52"/>Njiaro cia Shobali, ithe wa Kiriathu-Jearimu, ciarĩ:</para>
  <para style="li2" vid="1CH 2:52">Haroe, na nuthu ya Amanahathi, <verse eid="1CH 2:52"/><verse number="53" style="v" sid="1CH 2:53"/>na mĩhĩrĩga ya Kiriathu-Jearimu ĩrĩa yatariĩ ta ũũ: Aithiri, na Aputhi, na Ashumathi, na Amishirai. Kuuma kũrĩ acio gũkĩgĩa njiaro cia Azorathi na Aeshitaoli.<verse eid="1CH 2:53"/></para>
  <para style="li1">
    <verse number="54" style="v" sid="1CH 2:54"/>Njiaro cia Salima ciarĩ:</para>
  <para style="li2" vid="1CH 2:54">Bethilehemu ũrĩa Mũnetofathi, na Aatirothu-Bethi-Joabu, na nuthu ya Amanahathi, na Azori, <verse eid="1CH 2:54"/><verse number="55" style="v" sid="1CH 2:55"/>na mĩhĩrĩga ya aandĩki-marũa arĩa maatũũraga Jabezu ĩrĩa yatariĩ ta ũũ: Atirathi, na Ashimeathi, na Asukathi. Aya nĩo Akeni arĩa moimĩte harĩ Hamathu, ithe wa nyũmba ya Rekabu.<verse eid="1CH 2:55"/></para>
  <chapter eid="1CH 2"/>
  <chapter number="3" style="c" sid="1CH 3"/>
  <para style="s3">Ariũ a Daudi</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 3:1"/>Aya nĩo maarĩ ariũ a Daudi arĩa maaciarĩirwo Hebironi:</para>
  <para style="li2" vid="1CH 3:1">Irigithathi rĩarĩ Amunoni mũrũ wa Ahinoamu wa kuuma Jezireeli;</para>
  <para style="li2" vid="1CH 3:1">nake wa keerĩ aarĩ Danieli mũrũ wa Abigaili wa kuuma Karimeli;<verse eid="1CH 3:1"/></para>
  <para style="li2">
    <verse number="2" style="v" sid="1CH 3:2"/>nake wa gatatũ aarĩ Abisalomu mũrũ wa Maaka mwarĩ wa Talimai mũthamaki wa Geshuru;</para>
  <para style="li2" vid="1CH 3:2">nake wa kana aarĩ Adonija mũrũ wa Hagithu;<verse eid="1CH 3:2"/></para>
  <para style="li2">
    <verse number="3" style="v" sid="1CH 3:3"/>nake wa gatano aarĩ Shefatia mũrũ wa Abitali;</para>
  <para style="li2" vid="1CH 3:3">nake wa gatandatũ aarĩ Ithireamu ũrĩa aaciarĩirwo nĩ mũtumia wake Egila.<verse eid="1CH 3:3"/></para>
  <para style="li2">
    <verse number="4" style="v" sid="1CH 3:4"/>Acio atandatũ maaciarĩirwo Daudi kũu Hebironi, kũrĩa aathamakĩire mĩaka mũgwanja na mĩeri ĩtandatũ.</para>
  <para style="m" vid="1CH 3:4">Daudi aathamakire arĩ Jerusalemu mĩaka mĩrongo ĩtatũ na ĩtatũ, <verse eid="1CH 3:4"/><verse number="5" style="v" sid="1CH 3:5"/>nacio ici nĩcio ciana ciake iria ciaciarĩirwo kũu:</para>
  <para style="li2" vid="1CH 3:5">Shimea, na Shobabu, na Nathani, na Solomoni. Acio ana maaciarirwo nĩ Bathisheba mwarĩ wa Amieli. <verse eid="1CH 3:5"/><verse number="6" style="v" sid="1CH 3:6"/>Ningĩ nĩ kwarĩ na Ibiharu, na Elishua, na Elifeleti, <verse eid="1CH 3:6"/><verse number="7" style="v" sid="1CH 3:7"/>na Noga, na Nefegu, na Jafia, <verse eid="1CH 3:7"/><verse number="8" style="v" sid="1CH 3:8"/>na Elishama, na Eliada, na Elifeleti; othe maarĩ kenda. <verse eid="1CH 3:8"/><verse number="9" style="v" sid="1CH 3:9"/>Acio othe maarĩ ariũ a Daudi, ariũ a thuriya ciake matatarĩtwo. Nake Tamaru nĩwe warĩ mwarĩ wa ithe wao.<verse eid="1CH 3:9"/></para>
  <para style="s3">Athamaki a Juda</para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 3:10"/>Mũriũ wa Solomoni eetagwo Rehoboamu,</para>
  <para style="li2" vid="1CH 3:10">nake mũriũ eetagwo Abija,</para>
  <para style="li2" vid="1CH 3:10">nake Asa aarĩ mũriũ wa Abija,</para>
  <para style="li2" vid="1CH 3:10">nake Jehoshafatu aarĩ mũriũ wa Asa,<verse eid="1CH 3:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 3:11"/>nake Jehoramu aarĩ mũriũ wa Jehoshafatu,</para>
  <para style="li2" vid="1CH 3:11">nake Ahazia aarĩ mũriũ wa Jehoramu,</para>
  <para style="li2" vid="1CH 3:11">nake Joashu aarĩ mũriũ wa Ahazia,<verse eid="1CH 3:11"/></para>
  <para style="li2">
    <verse number="12" style="v" sid="1CH 3:12"/>nake Amazia aarĩ mũriũ wa Joashu,</para>
  <para style="li2" vid="1CH 3:12">nake Azaria aarĩ mũriũ wa Amazia,</para>
  <para style="li2" vid="1CH 3:12">nake Jothamu aarĩ mũriũ wa Azaria,<verse eid="1CH 3:12"/></para>
  <para style="li2">
    <verse number="13" style="v" sid="1CH 3:13"/>nake Ahazu aarĩ mũriũ wa Jothamu,</para>
  <para style="li2" vid="1CH 3:13">nake Hezekia aarĩ mũriũ wa Ahazu,</para>
  <para style="li2" vid="1CH 3:13">nake Manase aarĩ mũriũ wa Hezekia,<verse eid="1CH 3:13"/></para>
  <para style="li2">
    <verse number="14" style="v" sid="1CH 3:14"/>nake Amoni aarĩ mũriũ wa Manase,</para>
  <para style="li2" vid="1CH 3:14">nake Josia aarĩ mũriũ wa Amoni.<verse eid="1CH 3:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 3:15"/>Ariũ a Josia maarĩ:</para>
  <para style="li2" vid="1CH 3:15">Johanani irigithathi rĩake,</para>
  <para style="li2" vid="1CH 3:15">nake wa keerĩ aarĩ Jehoiakimu,</para>
  <para style="li2" vid="1CH 3:15">nake wa gatatũ aarĩ Zedekia,</para>
  <para style="li2" vid="1CH 3:15">nake wa kana aarĩ Shalumu.<verse eid="1CH 3:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 3:16"/>Arĩa maathamakire thuutha wa Jehoiakimu maarĩ:</para>
  <para style="li2" vid="1CH 3:16">mũriũ Jekonia</para>
  <para style="li2" vid="1CH 3:16">na Zedekia.<verse eid="1CH 3:16"/></para>
  <para style="s3">Rũciaro rwa Nyũmba ya Ũthamaki thuutha wa Ithaamĩrio</para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 3:17"/>Njiaro cia Jekonia, ũrĩa watahĩtwo, ciarĩ:</para>
  <para style="li2" vid="1CH 3:17">Mũriũ Shealitieli, <verse eid="1CH 3:17"/><verse number="18" style="v" sid="1CH 3:18"/>na Malikiramu, na Pedaia, na Shenazaru, na Jekamia, na Hoshama, na Nedabia.<verse eid="1CH 3:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 3:19"/>Ariũ a Pedaia maarĩ:</para>
  <para style="li2" vid="1CH 3:19">Zerubabeli na Shimei.</para>
  <para style="li1" vid="1CH 3:19">Ariũ a Zerubabeli maarĩ:</para>
  <para style="li2" vid="1CH 3:19">Meshulamu na Hanania;</para>
  <para style="li2" vid="1CH 3:19">Shelomithu aarĩ mwarĩ wa nyina wao.<verse eid="1CH 3:19"/></para>
  <para style="li2">
    <verse number="20" style="v" sid="1CH 3:20"/>Nĩ kwarĩ na ariũ angĩ atano, nao nĩ:</para>
  <para style="li2" vid="1CH 3:20">Hashuba, na Oheli, na Berekia, na Hasadia, na Jushabu-Hesedi.<verse eid="1CH 3:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 3:21"/>Njiaro cia Hanania ciarĩ:</para>
  <para style="li2" vid="1CH 3:21">Pelatia, na Jeshaia, na ningĩ nĩ kwarĩ na ariũ a Rafaia, na a Arinani, na a Obadia, o na a Shekania.<verse eid="1CH 3:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 3:22"/>Njiaro cia Shekania ciarĩ:</para>
  <para style="li2" vid="1CH 3:22">Shemaia na ariũ ake:</para>
  <para style="li2" vid="1CH 3:22">Hatushu, na Igali, na Baria, na Nearia, na Shafati; othe maarĩ atandatũ.<verse eid="1CH 3:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 3:23"/>Ariũ a Nearia maarĩ:</para>
  <para style="li2" vid="1CH 3:23">Elioenai, na Hizikia, na Azirikamu; othe maarĩ atatũ.<verse eid="1CH 3:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 3:24"/>Ariũ a Elioenai maarĩ:</para>
  <para style="li2" vid="1CH 3:24">Hodavia, na Eliashibu, na Pelaia, na Akubu, na Johanani, na Delaia, na Anani; othe maarĩ mũgwanja.<verse eid="1CH 3:24"/></para>
  <chapter eid="1CH 3"/>
  <chapter number="4" style="c" sid="1CH 4"/>
  <para style="s3">Mĩhĩrĩga Ĩngĩ ya Juda</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 4:1"/>Njiaro cia Juda ciarĩ:</para>
  <para style="li2" vid="1CH 4:1">Perezu, na Hezironi, na Karimi, na Huru, na Shobali.<verse eid="1CH 4:1"/></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 4:2"/>Reaia mũrũ wa Shobali nĩwe warĩ ithe wa Jahathu, nake Jahathu nĩwe warĩ ithe wa Ahumai na Lahadi. Icio nĩcio ciarĩ mbarĩ cia Azorathi.<verse eid="1CH 4:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 4:3"/>Ariũ a Etamu maarĩ:</para>
  <para style="li2" vid="1CH 4:3">Jezireeli, na Ishima, na Idibasha.</para>
  <para style="li2" vid="1CH 4:3">Mwarĩ wa nyina wao eetagwo Hazeleliponi. <verse eid="1CH 4:3"/><verse number="4" style="v" sid="1CH 4:4"/>Penueli nĩwe warĩ ithe wa Gedori, nake Ezeri nĩwe warĩ ithe wa Husha.</para>
  <para style="li1" vid="1CH 4:4">Ici nĩcio ciarĩ njiaro cia Huru ũrĩa irigithathi rĩa Efiratha, na ithe wa Bethilehemu.<verse eid="1CH 4:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 4:5"/>Ashuri ithe wa Tekoa aarĩ na atumia eerĩ, nĩo Hela na Naara.<verse eid="1CH 4:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 4:6"/>Naara akĩmũciarĩra Ahuzamu, na Heferi, na Temeni, na Haahashatari. Icio nĩcio ciarĩ njiaro cia Naara.<verse eid="1CH 4:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 4:7"/>Ariũ a Hela maarĩ:</para>
  <para style="li2" vid="1CH 4:7">Zerethi, na Zoharu, na Ethinani, <verse eid="1CH 4:7"/><verse number="8" style="v" sid="1CH 4:8"/>na Kozu, ũrĩa warĩ ithe wa Anubu, na Hazobeba, na wa mĩhĩrĩga ya Ahariheli mũrũ wa Harumu.<verse eid="1CH 4:8"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="9" style="v" sid="1CH 4:9"/>Jabezu aarĩ mũtĩĩku mũno gũkĩra ariũ a nyina. Nyina nĩwe wamũtuire Jabezu, tondũ oigire atĩrĩ, “Ndaamũciarire na ruo.” <verse eid="1CH 4:9"/><verse number="10" style="v" sid="1CH 4:10"/>Nake Jabezu agĩkaĩra Ngai wa Isiraeli, akiuga atĩrĩ, “Naarĩ korwo wandathima na ũnjaramĩrie mĩhaka ya bũrũri wakwa! Reke guoko gwaku gũkorwo hamwe na niĩ, na ũngitĩre harĩ ũũru nĩguo ndikanakorwo na ruo.” Nake Ngai akĩigua ihooya rĩake. <note caller="+" style="f"><char style="fr" closed="false">4:10 </char><char style="ft" closed="false">Rĩĩtwa Jabezu rĩgĩtaũrwo na Kĩhibirania nĩ ta kuuga “Ruo” kana “Kũnyariirĩka.”</char></note><verse eid="1CH 4:10"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 4:11"/>Kelubu, mũrũ wa nyina na Shuha, nĩwe warĩ ithe wa Mehiru, ũrĩa warĩ ithe wa Eshitoni. <verse eid="1CH 4:11"/><verse number="12" style="v" sid="1CH 4:12"/>Eshitoni nĩwe warĩ ithe wa Bethi-Rafa, na Pasea, na Tehina ũrĩa warĩ ithe wa Iri-Nahashu. Acio nĩo maarĩ andũ a Reka.<verse eid="1CH 4:12"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 4:13"/>Ariũ a Kenazu maarĩ:</para>
  <para style="li2" vid="1CH 4:13">Othinieli na Seraia.</para>
  <para style="li1" vid="1CH 4:13">Ariũ a Othinieli maarĩ:</para>
  <para style="li2" vid="1CH 4:13">Hathathu, na Meonothai. <verse eid="1CH 4:13"/><verse number="14" style="v" sid="1CH 4:14"/>Meonothai nĩwe warĩ ithe wa Ofara.</para>
  <para style="li1" vid="1CH 4:14">Seraia nĩwe warĩ ithe wa Joabu</para>
  <para style="li2" vid="1CH 4:14">ũrĩa ithe wa andũ a Ge-Harashimu. Gwetagwo ũguo nĩ ũndũ andũ akuo maarĩ mabundi.<verse eid="1CH 4:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 4:15"/>Ariũ a Kalebu, mũrũ wa Jefune, maarĩ:</para>
  <para style="li2" vid="1CH 4:15">Iru, na Ela, na Naamu.</para>
  <para style="li1" vid="1CH 4:15">Mũriũ wa Ela eetagwo:</para>
  <para style="li2" vid="1CH 4:15">Kenazu.<verse eid="1CH 4:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 4:16"/>Ariũ a Jehaleleli maarĩ:</para>
  <para style="li2" vid="1CH 4:16">Zifu, na Zifa, na Tiria, na Asareli.<verse eid="1CH 4:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 4:17"/>Ariũ a Ezara maarĩ:</para>
  <para style="li2" vid="1CH 4:17">Jetheru, na Meredi, na Eferi, na Jaloni. Mũtumia ũmwe wa Meredi nĩwe waciarire Miriamu, na Shamai, na Ishiba ũrĩa warĩ ithe wa Eshitemoa. <verse eid="1CH 4:17"/><verse number="18" style="v" sid="1CH 4:18"/>(Mũtumia wake wa kuuma Judea agĩciara Jeredi ũrĩa ithe wa Gedori, na Heberi ithe wa Soko, na Jekuthieli ithe wa Zanoa.) Acio nĩo maarĩ ciana cia Bithia mwarĩ wa Firaũni ũrĩa wahikĩtio nĩ Meredi.<verse eid="1CH 4:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 4:19"/>Ariũ a mũtumia wa Hodia (mwarĩ wa nyina na Nahamu) maarĩ:</para>
  <para style="li2" vid="1CH 4:19">Ithe wa Keila ũrĩa Mũgarimi, na Eshitemoa ũrĩa Mũmaakathi.<verse eid="1CH 4:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 4:20"/>Ariũ a Shimoni maarĩ:</para>
  <para style="li2" vid="1CH 4:20">Amunoni, na Rina, na Beni-Hanani, na Tiloni.</para>
  <para style="li1" vid="1CH 4:20">Njiaro cia Ishi nĩ:</para>
  <para style="li2" vid="1CH 4:20">Zohethu na Beni-Zohethu.<verse eid="1CH 4:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 4:21"/>Nao ariũ a Shela mũrũ wa Juda maarĩ:</para>
  <para style="li2" vid="1CH 4:21">Eri ithe wa Leka, na Laada ithe wa Maresha, na mbarĩ cia arĩa maathondekaga gatani ĩrĩa njega<note caller="+" style="f"><char style="fr" closed="false">4:21 </char><char style="ft" closed="false">Andũ a nyũmba ĩmwe nĩmamenyekaga na wĩra ũrĩa warutagwo nĩ ithe wao.</char></note> kũu Bethi-Ashibea, <verse eid="1CH 4:21"/><verse number="22" style="v" sid="1CH 4:22"/>na Jokimu, na andũ a Kozeba, na Joashu na Sarafi arĩa maathanaga bũrũri wa Moabi, na Jashubi-Lehemu. (Ũhoro ũyũ ũrutĩtwo maandĩko-inĩ ma tene mũno.) <verse eid="1CH 4:22"/><verse number="23" style="v" sid="1CH 4:23"/>Acio nĩo moombaga indo cia rĩũmba, nao maatũũraga Netaimu na Gedera; maikaraga kũu, marutagĩre mũthamaki wĩra.<verse eid="1CH 4:23"/></para>
  <para style="s3">Njiaro cia Simeoni</para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 4:24"/>Njiaro cia Simeoni nĩ:</para>
  <para style="li2" vid="1CH 4:24">Nemueli, na Jamini, na Jaribu, na Zera, na Shauli;<verse eid="1CH 4:24"/></para>
  <para style="li2">
    <verse number="25" style="v" sid="1CH 4:25"/>Shalumu aarĩ mũriũ wa Shauli, nake Mibisamu aarĩ mũriũ wa Shalumu, nake Mishima aarĩ mũriũ wa Mibisamu.<verse eid="1CH 4:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 4:26"/>Njiaro cia Mishima ciarĩ:</para>
  <para style="li2" vid="1CH 4:26">Mũriũ Hamueli, na Zakuri mũriũ wa Hamueli, na Shimei mũriũ wa Zakuri.<verse eid="1CH 4:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 4:27"/>Shimei aarĩ na ariũ ikũmi na atandatũ na airĩtu atandatũ, no ariũ a nyina matiarĩ na ciana nyingĩ; nĩ ũndũ ũcio mbarĩ yao ndĩongererekire ta ya andũ a Juda. <verse eid="1CH 4:27"/><verse number="28" style="v" sid="1CH 4:28"/>Nao maatũũraga Birishiba, na Molada, na Hazari-Shuali, <verse eid="1CH 4:28"/><verse number="29" style="v" sid="1CH 4:29"/>na Biliha, na Ezemu, na Toladi, <verse eid="1CH 4:29"/><verse number="30" style="v" sid="1CH 4:30"/>na Bethueli, na Horoma, na Zikilagi, <verse eid="1CH 4:30"/><verse number="31" style="v" sid="1CH 4:31"/>na Bethi-Marikabothu, na Hazari-Susimu, na Bethi-Biri, na Shaaraimu. Macio nĩmo maarĩ matũũra mao nginya rĩrĩa Daudi aathamakaga. <verse eid="1CH 4:31"/><verse number="32" style="v" sid="1CH 4:32"/>Matũũra matano marĩa maamarigiicĩirie maarĩ: Etamu, na Aini, na Rimoni, na Tokenina Ashani, <verse eid="1CH 4:32"/><verse number="33" style="v" sid="1CH 4:33"/>na tũtũũra tũnini tũrĩa twarigiicĩirie matũũra macio o nginya Baalathu. Macio nĩmo maarĩ ũtũũro wao. Nao nĩmaigaga maandĩko ma njiarwa.<verse eid="1CH 4:33"/></para>
  <para style="b"/>
  <para style="li2">
    <verse number="34" style="v" sid="1CH 4:34"/>Meshobabu, na Jamuleki, na Josha mũrũ wa Amazia, <verse eid="1CH 4:34"/><verse number="35" style="v" sid="1CH 4:35"/>na Joeli; na Jehu mũrũ wa Joshibia, mũrũ wa Seraia, mũrũ wa Asieli; <verse eid="1CH 4:35"/><verse number="36" style="v" sid="1CH 4:36"/>o na Elioenai, na Jaakoba, na Jeshohaia, na Asaia, na Adieli, na Jesimieli, na Benaia; <verse eid="1CH 4:36"/><verse number="37" style="v" sid="1CH 4:37"/>na Ziza mũrũ wa Shifi, mũrũ wa Aloni, mũrũ wa Jedaia, mũrũ wa Shimuri, mũrũ wa Shemaia.<verse eid="1CH 4:37"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="38" style="v" sid="1CH 4:38"/>Andũ acio marĩĩtwa mao magwetetwo hau igũrũ nĩo maarĩ atongoria a mbarĩ ciao. Nyũmba ciao nĩciongererekire mũno, <verse eid="1CH 4:38"/><verse number="39" style="v" sid="1CH 4:39"/>nao magĩthiĩ mĩhaka-inĩ ya Gedori mwena wa irathĩro wa gĩtuamba kĩu gũcaria ũrĩithio wa mahiũ mao. <verse eid="1CH 4:39"/><verse number="40" style="v" sid="1CH 4:40"/>Nĩmoonire kũndũ kũnoru kũrĩ ũrĩithio mwega, bũrũri warĩ mwariĩ, ũrĩ na thayũ na ũkahoorera. Na rĩrĩ, andũ a Hamu<note caller="+" style="f"><char style="fr" closed="false">4:40 </char><char style="ft" closed="false">Andũ a Kaanani maarĩ njiaro cia Hamu.</char></note> amwe nĩo maatũũraga kuo mbere.<verse eid="1CH 4:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="1CH 4:41"/>Andũ arĩa marĩĩtwa mao maandĩkĩtwo mookĩte kuo matukũ-inĩ ma Hezekia mũthamaki wa Juda. Nao magĩtharĩkĩra andũ a Hamu ciikaro-inĩ cia andũ acio o na cia Ameunimu arĩa maatũũraga kuo, na makĩmaniina biũ o ta ũrĩa gũtariĩ nginya ũmũthĩ. Nao magĩtũũra ciikaro-inĩ cia andũ acio tondũ kwarĩ na ũrĩithio mwega wa mahiũ mao. <verse eid="1CH 4:41"/><verse number="42" style="v" sid="1CH 4:42"/>Nao andũ magana matano a nyũmba ya Simeoni, matongoretio nĩ Pelatia, na Nearia, na Refaia na Uzieli, ariũ a Ishi, magĩtharĩkĩra bũrũri ũrĩa ũrĩ irĩma wa Seiru. <verse eid="1CH 4:42"/><verse number="43" style="v" sid="1CH 4:43"/>Nao makĩũraga Aamaleki arĩa meetharĩte magatigara, nao matũire kuo nginya ũmũthĩ.<verse eid="1CH 4:43"/></para>
  <chapter eid="1CH 4"/>
  <chapter number="5" style="c" sid="1CH 5"/>
  <para style="s2">Njiaro cia Rubeni</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 5:1"/>Ariũ a Rubeni ũrĩa irigithathi rĩa Isiraeli (nĩwe warĩ irigithathi, no rĩrĩa aathaahirie ũrĩrĩ wa ithe, ũrigithathi wake waheirwo ariũ a Jusufu mũrũ wa Isiraeli; nĩ ũndũ ũcio, ndangĩandĩkirwo maandĩko-inĩ ma njiarwa kũringana na ũrigithathi wake, <verse eid="1CH 5:1"/><verse number="2" style="v" sid="1CH 5:2"/>o na gũtuĩka Juda nĩwe warĩ hinya gũkĩra ariũ a ithe, na mũtongoria oimĩte gwake-rĩ, ũrigithathi watuĩkire wa Jusufu); <verse eid="1CH 5:2"/><verse number="3" style="v" sid="1CH 5:3"/>ariũ a Rubeni, irigithathi rĩa Isiraeli, maarĩ:</para>
  <para style="li1" vid="1CH 5:3">Hanoku, na Palu, na Hezironi, na Karimi.<verse eid="1CH 5:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 5:4"/>Njiaro cia Joeli ciarĩ:</para>
  <para style="li2" vid="1CH 5:4">Mũriũ Shemaia, na mũriũ Gogu, na mũriũ Shimei, <verse eid="1CH 5:4"/><verse number="5" style="v" sid="1CH 5:5"/>na mũriũ Mika,</para>
  <para style="li2" vid="1CH 5:5">na mũriũ Reaia, na mũriũ Baali,<verse eid="1CH 5:5"/></para>
  <para style="li2">
    <verse number="6" style="v" sid="1CH 5:6"/>na mũriũ Beera, ũrĩa watahirwo agĩthaamio nĩ Tigilathu-Pileseru mũthamaki wa Ashuri. Beera nĩwe warĩ mũtongoria wa andũ a Rubeni.<verse eid="1CH 5:6"/></para>
  <para style="li2">
    <verse number="7" style="v" sid="1CH 5:7"/>Andũ ao kũringana na mbarĩ ciao, mandĩkĩtwo kũringana na maandĩko ma njiarwa ciao maarĩ aya:</para>
  <para style="li2" vid="1CH 5:7">Jeieli ũrĩa mũnene, na Zekaria, <verse eid="1CH 5:7"/><verse number="8" style="v" sid="1CH 5:8"/>na Bela mũrũ wa Azazi, mũrũ wa Shema, mũrũ wa Joeli. Maatũũraga rũgongo rũrĩa ruumĩte Aroeri nginya Nebo na Baali-Meoni. <verse eid="1CH 5:8"/><verse number="9" style="v" sid="1CH 5:9"/>Maikarire bũrũri mwena wa irathĩro nginya rũteere-inĩ rwa werũ ũrĩa ũtambũrũkĩte nginya Rũũĩ rwa Farati, tondũ mahiũ mao nĩmaingĩhire mũno marĩ kũu Gileadi.<verse eid="1CH 5:9"/></para>
  <para style="li2">
    <verse number="10" style="v" sid="1CH 5:10"/>Hĩndĩ ya wathani wa Saũlũ nĩmarũire na Ahagari,<note caller="+" style="f"><char style="fr" closed="false">5:10 </char><char style="ft" closed="false">Ahagari maarĩ njiaro cia Ishumaeli mũrũ wa Hagari, na Aarabu nĩ a rũciaro rwao.</char></note> na makĩmahoota; nao makĩĩnyiitĩra ciikaro cia Ahagari acio rũgongo-inĩ ruothe rwa mwena wa irathĩro wa Gileadi.<verse eid="1CH 5:10"/></para>
  <para style="s2">Njiaro cia Gadi</para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 5:11"/>Nao andũ a Gadi maatũũire mariganĩtie na andũ a Rubeni kũu bũrũri wa Bashani,<note caller="+" style="f"><char style="fr" closed="false">5:11 </char><char style="ft" closed="false">Bashani warĩ bũrũri wa irĩma wa mwena wa irathĩro rĩa Iria rĩa Galili.</char></note> o nginya Saleka:<verse eid="1CH 5:11"/></para>
  <para style="li2">
    <verse number="12" style="v" sid="1CH 5:12"/>Joeli nĩwe warĩ mũnene kũu Bashani, mũnini wake aarĩ Shafamu, akarũmĩrĩrwo nĩ Janai, na Shafati.<verse eid="1CH 5:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 5:13"/>Andũ ao kũringana na nyũmba ciao maarĩ:</para>
  <para style="li2" vid="1CH 5:13">Mikaeli, na Meshulamu, na Sheba, na Jorai, na Jakani, na Zia, na Eberi, othe maarĩ andũ mũgwanja.<verse eid="1CH 5:13"/></para>
  <para style="li2">
    <verse number="14" style="v" sid="1CH 5:14"/>Acio nĩo maarĩ ariũ a Abihaili mũrũ wa Huru, mũrũ wa Jaroa, mũrũ wa Gileadi, mũrũ wa Mikaeli, mũrũ wa Jeshishai, mũrũ wa Jahido, mũrũ wa Buzi.<verse eid="1CH 5:14"/></para>
  <para style="li2">
    <verse number="15" style="v" sid="1CH 5:15"/>Ahi mũrũ wa Abidieli, mũrũ wa Guni nĩwe warĩ mũtongoria wa nyũmba yao.<verse eid="1CH 5:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 5:16"/>Nao andũ a Gadi maatũũraga Gileadi, kũu Bashani na matũũra-inĩ marĩa maakuhĩrĩirie kuo, o na kũrĩa guothe ũrĩithio wa Sharoni wakinyĩte.<verse eid="1CH 5:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 5:17"/>Ũhoro ũyũ wothe nĩ wandĩkirwo maandĩko-inĩ ma njiarwa ciao hĩndĩ ĩrĩa Jothamu mũthamaki wa Juda na Jeroboamu mũthamaki wa Isiraeli maathamakaga.<verse eid="1CH 5:17"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="18" style="v" sid="1CH 5:18"/>Andũ a Rubeni, na a Gadi, na nuthu ya mũhĩrĩga wa Manase, maarĩ na andũ 44,760 mehaarĩirie gũthiĩ mbaara-inĩ: andũ marĩ na hinya wa mwĩrĩ, na mangĩahotire kũhũthĩra ngo, na rũhiũ rwa njora, na mooĩ gũikia mĩguĩ na ũta, na maarutĩtwo kũrũa mbaara. <verse eid="1CH 5:18"/><verse number="19" style="v" sid="1CH 5:19"/>Nao makĩhithũkĩra Ahagari, na Ajeturi, na Anafishi, na Anodabu. <verse eid="1CH 5:19"/><verse number="20" style="v" sid="1CH 5:20"/>Nĩmateithirio kũmahũũra, nake Ngai akĩneana Ahagari moko-inĩ mao, marĩ hamwe na arĩa othe maamateithagia, tondũ nĩmamũkaĩire marĩ mbaara-inĩ. Nĩamacookeirie mahooya mao, nĩ ũndũ nĩmamwĩhokete. <verse eid="1CH 5:20"/><verse number="21" style="v" sid="1CH 5:21"/>Magĩtaha mahiũ ma Ahagari acio: ngamĩĩra 50,000, na ngʼondu 250,000, na ndigiri 2,000, ningĩ nĩmatahire andũ 100,000, <verse eid="1CH 5:21"/><verse number="22" style="v" sid="1CH 5:22"/>na angĩ aingĩ makĩũragwo, tondũ Ngai nĩwe wamarũagĩrĩra. Nao magĩikara bũrũri ũcio o nginya hĩndĩ ĩrĩa maatahirwo rĩngĩ.<verse eid="1CH 5:22"/></para>
  <para style="s2">Nuthu ya Mũhĩrĩga wa Manase</para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 5:23"/>Andũ a nuthu ya mũhĩrĩga wa Manase maarĩ aingĩ mũno; maatũũrire bũrũri ũcio kuuma Bashani nginya Baali-Herimoni, ũguo nĩ kuuga nginya Seniru (nĩkĩo Kĩrĩma kĩa Herimoni).<verse eid="1CH 5:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 5:24"/>Aya nĩo maarĩ atongoria a nyũmba ciao: Eferi, na Ishi, na Elieli, na Azirieli, na Jeremia, na Hodavia, na Jahadieli. Maarĩ atongoria a nyũmba ciao, na njamba cia ita, na andũ marĩ igweta. <verse eid="1CH 5:24"/><verse number="25" style="v" sid="1CH 5:25"/>No matiarĩ ehokeku harĩ Ngai wa maithe mao, tondũ nĩmeheanĩte kũrĩ ngai cia andũ a bũrũri ũcio, arĩa Ngai aaniinĩte mehere mbere yao. <verse eid="1CH 5:25"/><verse number="26" style="v" sid="1CH 5:26"/>Nĩ ũndũ ũcio Ngai wa Isiraeli akĩarahũra roho wa Puli mũthamaki wa Ashuri (ũguo nĩ kuuga Tigilathu-Pileseru, mũthamaki wa Ashuri), ũrĩa watahire andũ a Rubeni, na andũ a Gadi, na nuthu ya mũhĩrĩga wa Manase, akĩmatwara ithaamĩrio. Akĩmathaamĩria Hala, na Habori, na Hara, na rũũĩ-inĩ rwa Gozani, kũrĩa matũire nginya ũmũthĩ.<verse eid="1CH 5:26"/></para>
  <chapter eid="1CH 5"/>
  <chapter number="6" style="c" sid="1CH 6"/>
  <para style="s2">Njiaro cia Lawi</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 6:1"/>Ariũ a Lawi maarĩ:</para>
  <para style="li2" vid="1CH 6:1">Gerishoni, na Kohathu, na Merari.<verse eid="1CH 6:1"/></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 6:2"/>Ariũ a Kohathu maarĩ:</para>
  <para style="li2" vid="1CH 6:2">Amuramu, na Iziharu, na Hebironi, na Uzieli.<verse eid="1CH 6:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 6:3"/>Ciana cia Amuramu ciarĩ:</para>
  <para style="li2" vid="1CH 6:3">Harũni, na Musa, na Miriamu.</para>
  <para style="li1" vid="1CH 6:3">Ariũ a Harũni maarĩ:</para>
  <para style="li2" vid="1CH 6:3">Nadabu, na Abihu, na Eleazaru, na Ithamaru.<verse eid="1CH 6:3"/></para>
  <para style="li2">
    <verse number="4" style="v" sid="1CH 6:4"/>Eleazaru nĩwe warĩ ithe wa Finehasi,</para>
  <para style="li2" vid="1CH 6:4">na Finehasi nĩwe warĩ ithe wa Abishua,<verse eid="1CH 6:4"/></para>
  <para style="li2">
    <verse number="5" style="v" sid="1CH 6:5"/>na Abishua nĩwe warĩ ithe wa Buki,</para>
  <para style="li2" vid="1CH 6:5">na Buki nĩwe warĩ ithe wa Uzi,<verse eid="1CH 6:5"/></para>
  <para style="li2">
    <verse number="6" style="v" sid="1CH 6:6"/>na Uzi nĩwe warĩ ithe wa Zerahia,</para>
  <para style="li2" vid="1CH 6:6">na Zerahia nĩwe warĩ ithe wa Meraiothu,<verse eid="1CH 6:6"/></para>
  <para style="li2">
    <verse number="7" style="v" sid="1CH 6:7"/>na Meraiothu nĩwe warĩ ithe wa Amaria,</para>
  <para style="li2" vid="1CH 6:7">na Amaria nĩwe warĩ ithe wa Ahitubu,<verse eid="1CH 6:7"/></para>
  <para style="li2">
    <verse number="8" style="v" sid="1CH 6:8"/>na Ahitubu nĩwe warĩ ithe wa Zadoku,</para>
  <para style="li2" vid="1CH 6:8">na Zadoku nĩwe warĩ ithe wa Ahimaazu,<verse eid="1CH 6:8"/></para>
  <para style="li2">
    <verse number="9" style="v" sid="1CH 6:9"/>na Ahimaazu nĩwe warĩ ithe wa Azaria,</para>
  <para style="li2" vid="1CH 6:9">na Azaria nĩwe warĩ ithe wa Johanani,<verse eid="1CH 6:9"/></para>
  <para style="li2">
    <verse number="10" style="v" sid="1CH 6:10"/>na Johanani nĩwe warĩ ithe wa Azaria (ũrĩa watungataga arĩ mũthĩnjĩri-Ngai thĩinĩ wa hekarũ ĩrĩa Solomoni aakire kũu Jerusalemu),<verse eid="1CH 6:10"/></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 6:11"/>na Azaria nĩwe warĩ ithe wa Amaria,</para>
  <para style="li2" vid="1CH 6:11">na Amaria nĩwe warĩ ithe wa Ahitubu,<verse eid="1CH 6:11"/></para>
  <para style="li2">
    <verse number="12" style="v" sid="1CH 6:12"/>na Ahitubu nĩwe warĩ ithe wa Zadoku,</para>
  <para style="li2" vid="1CH 6:12">na Zadoku nĩwe warĩ ithe wa Shalumu,<verse eid="1CH 6:12"/></para>
  <para style="li2">
    <verse number="13" style="v" sid="1CH 6:13"/>na Shalumu nĩwe warĩ ithe wa Hilikia,</para>
  <para style="li2" vid="1CH 6:13">na Hilikia nĩwe warĩ ithe wa Azaria,<verse eid="1CH 6:13"/></para>
  <para style="li2">
    <verse number="14" style="v" sid="1CH 6:14"/>na Azaria nĩwe warĩ ithe wa Seraia,</para>
  <para style="li2" vid="1CH 6:14">na Seraia nĩwe warĩ ithe wa Jehozadaku.<verse eid="1CH 6:14"/></para>
  <para style="li4">
    <verse number="15" style="v" sid="1CH 6:15"/>Jehozadaku nĩathaamirio hĩndĩ ĩrĩa Jehova aarekereirie andũ a Juda na a Jerusalemu matahwo nĩ Nebukadinezaru.<verse eid="1CH 6:15"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 6:16"/>Ariũ a Lawi maarĩ:</para>
  <para style="li2" vid="1CH 6:16">Gerishoni, na Kohathu, na Merari.<verse eid="1CH 6:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 6:17"/>Maya nĩmo marĩĩtwa ma ariũ a Gerishoni:</para>
  <para style="li2" vid="1CH 6:17">Libini na Shimei.<verse eid="1CH 6:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 6:18"/>Ariũ a Kohathu maarĩ:</para>
  <para style="li2" vid="1CH 6:18">Amuramu, na Iziharu, na Hebironi, na Uzieli.<verse eid="1CH 6:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 6:19"/>Ariũ a Merari maarĩ:</para>
  <para style="li2" vid="1CH 6:19">Mahili na Mushi.</para>
  <para style="li1" vid="1CH 6:19">Icio nĩcio mbarĩ cia Alawii ciandĩkĩtwo kũringana na maithe mao:<verse eid="1CH 6:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 6:20"/>Ariũ a Gerishoni maarĩ:</para>
  <para style="li2" vid="1CH 6:20">mũriũ Libini, nake Jehathu aarĩ mũriũ wa Libini,</para>
  <para style="li2" vid="1CH 6:20">nake Zima aarĩ mũriũ wa Jehathu, <verse eid="1CH 6:20"/><verse number="21" style="v" sid="1CH 6:21"/>nake Joa aarĩ mũriũ wa Zima,</para>
  <para style="li2" vid="1CH 6:21">nake Ido aarĩ mũriũ wa Joa, nake Zera aarĩ mũriũ wa Ido,</para>
  <para style="li2" vid="1CH 6:21">nake Jeatherai aarĩ mũriũ wa Zera.<verse eid="1CH 6:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 6:22"/>Njiaro cia Kohathu ciarĩ:</para>
  <para style="li2" vid="1CH 6:22">mũriũ Aminadabu, nake Kora aarĩ mũriũ wa Aminadabu,</para>
  <para style="li2" vid="1CH 6:22">nake Asiru aarĩ mũriũ wa Kora, <verse eid="1CH 6:22"/><verse number="23" style="v" sid="1CH 6:23"/>nake Elikana aarĩ mũriũ wa Asiru,</para>
  <para style="li2" vid="1CH 6:23">nake Ebiasafu aarĩ mũriũ wa Elikana, nake Asiru aarĩ mũriũ wa Ebiasafu,<verse eid="1CH 6:23"/></para>
  <para style="li2">
    <verse number="24" style="v" sid="1CH 6:24"/>nake Tahathu aarĩ mũriũ wa Asiru, nake Urieli aarĩ mũriũ wa Tahathu,</para>
  <para style="li2" vid="1CH 6:24">nake Uzia aarĩ mũriũ wa Urieli, nake Shauli aarĩ mũriũ wa Uzia.<verse eid="1CH 6:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 6:25"/>Njiaro cia Elikana ciarĩ:</para>
  <para style="li2" vid="1CH 6:25">Amasai na Ahimothu,<verse eid="1CH 6:25"/></para>
  <para style="li2">
    <verse number="26" style="v" sid="1CH 6:26"/>nake mũriũ aarĩ Elikana, nake Zofai aarĩ mũriũ wa Elikana,</para>
  <para style="li2" vid="1CH 6:26">nake Nahathu aarĩ mũriũ wa Zofai, <verse eid="1CH 6:26"/><verse number="27" style="v" sid="1CH 6:27"/>nake Eliabu aarĩ mũriũ wa Nahathu,</para>
  <para style="li2" vid="1CH 6:27">nake Jerohamu aarĩ mũriũ wa Eliabu, nake Elikana aarĩ mũriũ wa Jerohamu,</para>
  <para style="li2" vid="1CH 6:27">nake Samũeli aarĩ mũriũ wa Elikana.<verse eid="1CH 6:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 6:28"/>Ariũ a Samũeli maarĩ:</para>
  <para style="li2" vid="1CH 6:28">Joeli irigithathi,</para>
  <para style="li2" vid="1CH 6:28">na mũriũ wa keerĩ aarĩ Abija.<verse eid="1CH 6:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 6:29"/>Njiaro cia Merari ciarĩ:</para>
  <para style="li2" vid="1CH 6:29">Mahili, nake mũriũ aarĩ Libini,</para>
  <para style="li2" vid="1CH 6:29">nake Shimei aarĩ mũriũ wa Libini, nake Uza aarĩ mũriũ wa Shimei,<verse eid="1CH 6:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 6:30"/>nake Shimea aarĩ mũriũ wa Uza, nake Hagia aarĩ mũriũ wa Shimea,</para>
  <para style="li2" vid="1CH 6:30">nake Asaia aarĩ mũriũ wa Hagia.<verse eid="1CH 6:30"/></para>
  <para style="s1">Aini a Hekarũ</para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 6:31"/>Aya nĩo andũ arĩa Daudi aatuire arũgamĩrĩri a ũini nyũmba-inĩ ya Jehova thuutha wa ithandũkũ rĩa kĩrĩkanĩro gũkinya kũu. <verse eid="1CH 6:31"/><verse number="32" style="v" sid="1CH 6:32"/>Maatungataga na ũini Hema-inĩ-ya-Gũtũnganwo o nginya rĩrĩa Solomoni aakire hekarũ ya Jehova kũu Jerusalemu. Nao maarutaga wĩra wao kũringana na mawatho marĩa maatuĩtwo.<verse eid="1CH 6:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 6:33"/>Aya nĩo andũ arĩa maarutaga wĩra, hamwe na ariũ ao:</para>
  <para style="li1" vid="1CH 6:33">Kuuma kũrĩ Akohathu maarĩ:</para>
  <para style="li2" vid="1CH 6:33">Hemani ũrĩa mũini,</para>
  <para style="li2" vid="1CH 6:33">mũrũ wa Joeli, mũrũ wa Samũeli,<verse eid="1CH 6:33"/></para>
  <para style="li2">
    <verse number="34" style="v" sid="1CH 6:34"/>mũrũ wa Elikana, mũrũ wa Jerohamu,</para>
  <para style="li2" vid="1CH 6:34">mũrũ wa Elieli, mũrũ wa Toa,<verse eid="1CH 6:34"/></para>
  <para style="li2">
    <verse number="35" style="v" sid="1CH 6:35"/>mũrũ wa Zufu, mũrũ wa Elikana,</para>
  <para style="li2" vid="1CH 6:35">mũrũ wa Mahathu mũrũ wa Amasai,<verse eid="1CH 6:35"/></para>
  <para style="li2">
    <verse number="36" style="v" sid="1CH 6:36"/>mũrũ wa Elikana, mũrũ wa Joeli,</para>
  <para style="li2" vid="1CH 6:36">mũrũ wa Azaria, mũrũ wa Zefania,<verse eid="1CH 6:36"/></para>
  <para style="li2">
    <verse number="37" style="v" sid="1CH 6:37"/>mũrũ wa Tahathu, mũrũ wa Asiru,</para>
  <para style="li2" vid="1CH 6:37">mũrũ wa Ebiasafu, mũrũ wa Kora,<verse eid="1CH 6:37"/></para>
  <para style="li2">
    <verse number="38" style="v" sid="1CH 6:38"/>mũrũ wa Iziharu, mũrũ wa Kohathu,</para>
  <para style="li2" vid="1CH 6:38">mũrũ wa Lawi, mũrũ wa Isiraeli;<verse eid="1CH 6:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 6:39"/>na Asafu, mũthiritũ wa Hemani, ũrĩa watungataga mwena wake wa ũrĩo: Asafu aarĩ mũrũ wa Berekia, mũrũ wa Shimea,<verse eid="1CH 6:39"/></para>
  <para style="li2">
    <verse number="40" style="v" sid="1CH 6:40"/>mũrũ wa Mikaeli, mũrũ wa Baaseia,</para>
  <para style="li2" vid="1CH 6:40">mũrũ wa Malikija <verse eid="1CH 6:40"/><verse number="41" style="v" sid="1CH 6:41"/>mũrũ wa Ethini,</para>
  <para style="li2" vid="1CH 6:41">mũrũ wa Zera, mũrũ wa Adaia,<verse eid="1CH 6:41"/></para>
  <para style="li2">
    <verse number="42" style="v" sid="1CH 6:42"/>mũrũ wa Ethani, mũrũ wa Zima,</para>
  <para style="li2" vid="1CH 6:42">mũrũ wa Shimei, <verse eid="1CH 6:42"/><verse number="43" style="v" sid="1CH 6:43"/>mũrũ wa Jahathu,</para>
  <para style="li2" vid="1CH 6:43">mũrũ wa Gerishoni, mũrũ wa Lawi;<verse eid="1CH 6:43"/></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 6:44"/>na kuuma kũrĩ athiritũ ao, Amerari, arĩa maatungataga marĩ mwena wake wa ũmotho, maarĩ:</para>
  <para style="li2" vid="1CH 6:44">Ethani mũrũ wa Kishi, mũrũ wa Abudi,</para>
  <para style="li2" vid="1CH 6:44">mũrũ wa Maluku, <verse eid="1CH 6:44"/><verse number="45" style="v" sid="1CH 6:45"/>mũrũ wa Hashabia,</para>
  <para style="li2" vid="1CH 6:45">mũrũ wa Amazia, mũrũ wa Hilikia,<verse eid="1CH 6:45"/></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 6:46"/>mũrũ wa Amuzi, mũrũ wa Bani,</para>
  <para style="li2" vid="1CH 6:46">mũrũ wa Shemeri, <verse eid="1CH 6:46"/><verse number="47" style="v" sid="1CH 6:47"/>mũrũ wa Mahali,</para>
  <para style="li2" vid="1CH 6:47">mũrũ wa Mushi, mũrũ wa Merari,</para>
  <para style="li2" vid="1CH 6:47">mũrũ wa Lawi.<verse eid="1CH 6:47"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="48" style="v" sid="1CH 6:48"/>Alawii arĩa maarĩ a thiritũ yao maagaĩirwo mawĩra marĩa mangĩ mothe ma hema ĩrĩa nyamũre, o ĩyo nyũmba ya Ngai. <verse eid="1CH 6:48"/><verse number="49" style="v" sid="1CH 6:49"/>No Harũni na njiaro ciake nĩo maarutaga magongona kĩgongona-inĩ kĩa igongona rĩa njino, na kĩgongona-inĩ gĩa gũcinĩrwo ũbumba, na wĩra wothe warutagwo ũkonainie na Handũ-hau-Hatheru-Mũno, nĩ ũndũ wa kũhoroheria andũ a Isiraeli mehia, kũringana na ũrĩa Musa ndungata ya Ngai yaathanĩte.<verse eid="1CH 6:49"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="50" style="v" sid="1CH 6:50"/>Ici nĩcio njiaro cia Harũni:</para>
  <para style="li2" vid="1CH 6:50">Mũriũ aarĩ Eliazaru, nake mũriũ wake aarĩ Finehasi,</para>
  <para style="li2" vid="1CH 6:50">nake Abishua aarĩ mũriũ wa Finehasi, <verse eid="1CH 6:50"/><verse number="51" style="v" sid="1CH 6:51"/>nake Buki aarĩ mũriũ wa Abishua,</para>
  <para style="li2" vid="1CH 6:51">nake Uzi aarĩ mũriũ wa Buki, nake Zerahia aarĩ mũriũ wa Uzi,<verse eid="1CH 6:51"/></para>
  <para style="li2">
    <verse number="52" style="v" sid="1CH 6:52"/>nake Meraiothu aarĩ mũriũ wa Zerahia, nake Amaria aarĩ mũriũ wa Meraiothu,</para>
  <para style="li2" vid="1CH 6:52">nake Ahitubu aarĩ mũriũ wa Amaria, <verse eid="1CH 6:52"/><verse number="53" style="v" sid="1CH 6:53"/>nake Zadoku aarĩ mũriũ wa Ahitubu,</para>
  <para style="li2" vid="1CH 6:53">nake Ahimaazu aarĩ mũriũ wa Zadoku.<verse eid="1CH 6:53"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="54" style="v" sid="1CH 6:54"/>Na rĩrĩ, gũkũ nĩkuo kũndũ kũrĩa maagaĩirwo kũrĩ bũrũri wao (nakuo kwagaĩirwo njiaro cia Harũni iria ciarĩ cia mbarĩ ya Kohathu, tondũ igai rĩa mbere rĩarĩ rĩao):<verse eid="1CH 6:54"/></para>
  <para style="pi1">
    <verse number="55" style="v" sid="1CH 6:55"/>Maaheirwo Hebironi kũu Juda, o hamwe na ũrĩithio ũrĩa warigiicĩirie. <verse eid="1CH 6:55"/><verse number="56" style="v" sid="1CH 6:56"/>No mĩgũnda na matũũra marĩa maakuhĩrĩirie itũũra inene maaheirwo Kalebu mũrũ wa Jefune.<verse eid="1CH 6:56"/></para>
  <para style="pi1">
    <verse number="57" style="v" sid="1CH 6:57"/>Nĩ ũndũ ũcio njiaro cia Harũni ciaheirwo Hebironi (itũũra inene rĩa kũũrĩra) na Libina, na Jatiri, na Eshitemoa, <verse eid="1CH 6:57"/><verse number="58" style="v" sid="1CH 6:58"/>na Hileni, na Debiri, <verse eid="1CH 6:58"/><verse number="59" style="v" sid="1CH 6:59"/>na Ashani, na Juta, na Bethi-Shemeshu, hamwe na ũrĩithio wamo. <verse eid="1CH 6:59"/><verse number="60" style="v" sid="1CH 6:60"/>Na kuuma mũhĩrĩga wa Benjamini maaheirwo Gibeoni, na Geba, na Alemethu, na Anathothu, hamwe na ũrĩithio wamo.</para>
  <para style="pi1" vid="1CH 6:60">Matũũra marĩa maagaĩirwo mĩhĩrĩga ya Akohathu mothe maarĩ ikũmi na matatũ.<verse eid="1CH 6:60"/></para>
  <para style="p">
    <verse number="61" style="v" sid="1CH 6:61"/>Njiaro icio ingĩ cia Kohathu ciaheirwo matũũra ikũmi, kuuma kũrĩ nuthu ya mũhĩrĩga wa Manase.<verse eid="1CH 6:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="1CH 6:62"/>Njiaro cia Gerishoni, mbarĩ o mbarĩ ciagaĩirwo matũũra ikũmi na matatũ kuuma kũrĩ mũhĩrĩga wa Isakaru, na wa Asheri, na wa Nafitali, na kuuma kũrĩ gĩcunjĩ kĩa mũhĩrĩga wa Manase ũrĩa ũrĩ Bashani.<verse eid="1CH 6:62"/></para>
  <para style="p">
    <verse number="63" style="v" sid="1CH 6:63"/>Njiaro cia Merari, mbarĩ o mbarĩ, ciagaĩirwo matũũra ikũmi na meerĩ kuuma kũrĩ mũhĩrĩga wa Rubeni, na wa Gadi, na wa Zebuluni.<verse eid="1CH 6:63"/></para>
  <para style="p">
    <verse number="64" style="v" sid="1CH 6:64"/>Nĩ ũndũ ũcio andũ a Isiraeli makĩhe Alawii matũũra macio na ũrĩithio wamo. <verse eid="1CH 6:64"/><verse number="65" style="v" sid="1CH 6:65"/>Kuuma mũhĩrĩga wa Juda, na wa Simeoni, na wa Benjamini makĩmahe matũũra macio magwetetwo.<verse eid="1CH 6:65"/></para>
  <para style="p">
    <verse number="66" style="v" sid="1CH 6:66"/>Mbarĩ imwe cia Akohathu ciaheirwo matũũra nĩ mũhĩrĩga wa Efiraimu matuĩke bũrũri wao.<verse eid="1CH 6:66"/></para>
  <para style="pi1">
    <verse number="67" style="v" sid="1CH 6:67"/>Kuuma bũrũri ũrĩa ũrĩ irĩma wa Efiraimu maaheirwo Shekemu (itũũra rĩa kũũrĩra), na Gezeri, <verse eid="1CH 6:67"/><verse number="68" style="v" sid="1CH 6:68"/>na Jokimeamu, na Bethi-Horoni, <verse eid="1CH 6:68"/><verse number="69" style="v" sid="1CH 6:69"/>na Aijaloni, na Gathi-Rimoni, hamwe na ũrĩithio wamo.<verse eid="1CH 6:69"/></para>
  <para style="pi1">
    <verse number="70" style="v" sid="1CH 6:70"/>Na kuuma nuthu ya mũhĩrĩga wa Manase-rĩ, andũ a Isiraeli makĩheana matũũra ma Aneri na Bileamu, hamwe na ũrĩithio wamo, kũrĩ mbarĩ iria ingĩ cia Akohathu.<verse eid="1CH 6:70"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="71" style="v" sid="1CH 6:71"/>Agerishoni maagaĩirwo matũũra maya:</para>
  <para style="li1" vid="1CH 6:71">Kuuma nuthu ya mũhĩrĩga wa Manase makĩheo Golani kũu Bashani, o na Ashitarothu, hamwe na ũrĩithio wamo;<verse eid="1CH 6:71"/></para>
  <para style="li1">
    <verse number="72" style="v" sid="1CH 6:72"/>Kuuma mũhĩrĩga wa Isakaru</para>
  <para style="li2" vid="1CH 6:72">makĩheo Kadeshi, na Daberathu, <verse eid="1CH 6:72"/><verse number="73" style="v" sid="1CH 6:73"/>na Ramothu, na Anemu, hamwe na ũrĩithio wamo;<verse eid="1CH 6:73"/></para>
  <para style="li1">
    <verse number="74" style="v" sid="1CH 6:74"/>Kuuma mũhĩrĩga wa Asheri</para>
  <para style="li2" vid="1CH 6:74">makĩheo Mashali, na Abidoni, <verse eid="1CH 6:74"/><verse number="75" style="v" sid="1CH 6:75"/>na Hukoku, na Rehobu, hamwe na ũrĩithio wamo;<verse eid="1CH 6:75"/></para>
  <para style="li1">
    <verse number="76" style="v" sid="1CH 6:76"/>Na kuuma mũhĩrĩga wa Nafitali</para>
  <para style="li2" vid="1CH 6:76">makĩheo Kedeshi kũu Galili, na Hamoni, na Kiriathaimu, hamwe na ũrĩithio wamo.<verse eid="1CH 6:76"/></para>
  <para style="b"/>
  <para style="li4">
    <verse number="77" style="v" sid="1CH 6:77"/>Amerari (Alawii arĩa angĩ) maagaĩirwo matũũra maya:</para>
  <para style="li1" vid="1CH 6:77">Kuuma mũhĩrĩga wa Zebuluni</para>
  <para style="li2" vid="1CH 6:77">makĩheo Jokineamu, na Karita, na Rimono, na Taboru, hamwe na ũrĩithio wamo;<verse eid="1CH 6:77"/></para>
  <para style="li1">
    <verse number="78" style="v" sid="1CH 6:78"/>kuuma mũhĩrĩga wa Rubeni mũrĩmo wa Jorodani mwena wa irathĩro wa Jeriko,</para>
  <para style="li2" vid="1CH 6:78">makĩheo Bezeri werũ-inĩ, na Jahaza, <verse eid="1CH 6:78"/><verse number="79" style="v" sid="1CH 6:79"/>na Kedemothu, na Mefaathu, hamwe na ũrĩithio wamo;<verse eid="1CH 6:79"/></para>
  <para style="li1">
    <verse number="80" style="v" sid="1CH 6:80"/>na kuuma mũhĩrĩga wa Gadi</para>
  <para style="li2" vid="1CH 6:80">makĩheo Ramothu o kũu Gileadi, na Mahanaimu, <verse eid="1CH 6:80"/><verse number="81" style="v" sid="1CH 6:81"/>na Heshiboni, na Jazeri, hamwe na ũrĩithio wamo.<verse eid="1CH 6:81"/></para>
  <chapter eid="1CH 6"/>
  <chapter number="7" style="c" sid="1CH 7"/>
  <para style="s2">Njiaro cia Isakaru</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 7:1"/>Ariũ a Isakaru maarĩ:</para>
  <para style="li2" vid="1CH 7:1">Tola, na Pua, na Jashubu, na Shimuroni; othe maarĩ ana.<verse eid="1CH 7:1"/></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 7:2"/>Ariũ a Tola maarĩ:</para>
  <para style="li2" vid="1CH 7:2">Uzi, na Refaia, na Jerieli, na Jahamai, na Ibisamu, na Shemueli; nao maarĩ atongoria a nyũmba ciao. Hĩndĩ ya wathani wa Daudi, njiaro cia Tola iria ciaandĩkĩtwo maandĩko-inĩ ma njiarwa ciao marĩ andũ a kũrũa mbaara maarĩ 22,600.<verse eid="1CH 7:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 7:3"/>Mũriũ wa Uzi aarĩ:</para>
  <para style="li2" vid="1CH 7:3">Izirahia.</para>
  <para style="li1" vid="1CH 7:3">Ariũ a Izirahia maarĩ:</para>
  <para style="li2" vid="1CH 7:3">Mikaeli, na Obadia, na Joeli, na Ishia. Othe atano maarĩ anene a andũ ao. <verse eid="1CH 7:3"/><verse number="4" style="v" sid="1CH 7:4"/>Kũringana na maandĩko ma njiarwa cia nyũmba ciao, maarĩ na arũme mehaarĩirie kũrũa mbaara 36,000, nĩgũkorwo maarĩ na atumia aingĩ na ciana nyingĩ.<verse eid="1CH 7:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 7:5"/>Andũ ao arĩa maangĩarũire mbaara kuuma mĩhĩrĩga-inĩ yothe ya Isakaru, kũringana na maandĩko ma njiarwa ciao, maarĩ 87,000 marĩ othe.<verse eid="1CH 7:5"/></para>
  <para style="s2">Njiaro cia Benjamini</para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 7:6"/>Ariũ atatũ a Benjamini maarĩ:</para>
  <para style="li2" vid="1CH 7:6">Bela, na Bekeri, na Jediaeli.<verse eid="1CH 7:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 7:7"/>Ariũ a Bela maarĩ:</para>
  <para style="li2" vid="1CH 7:7">Eziboni, na Uzi, na Uzieli, na Jerimothu, na Iri; othe maarĩ atano, na maarĩ atongoria a nyũmba ciao. Maandĩko ma njiarwa ciao moonanagia arũme a kũrũa mbaara maarĩ 22,034.<verse eid="1CH 7:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 7:8"/>Ariũ a Bekeri maarĩ:</para>
  <para style="li2" vid="1CH 7:8">Zemira, na Joashu, na Eliezeri, na Elioenai, na Omuri, na Jeremothu, na Abija, na Anathothu, na Alemethu. Acio othe maarĩ ariũ a Bekeri. <verse eid="1CH 7:8"/><verse number="9" style="v" sid="1CH 7:9"/>Maandĩko ma njiarwa ciao moonanagia atongoria a nyũmba, na arũme a kũrũa mbaara 20,200.<verse eid="1CH 7:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 7:10"/>Mũriũ wa Jediaeli aarĩ:</para>
  <para style="li2" vid="1CH 7:10">Bilihani.</para>
  <para style="li1" vid="1CH 7:10">Ariũ a Bilihani maarĩ:</para>
  <para style="li2" vid="1CH 7:10">Jeushu, na Benjamini, na Ehudu, na Kenaana, na Zethani, na Tarishishi, na Ahishaharu. <verse eid="1CH 7:10"/><verse number="11" style="v" sid="1CH 7:11"/>Ariũ acio othe a Jediaeli maarĩ atongoria a nyũmba ciao. Nĩ kwarĩ na arũme 17,200 a kũrũa mehaarĩirie gũthiĩ mbaara-inĩ.<verse eid="1CH 7:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 7:12"/>Nao andũ a Shupimu na a Hupimu maarĩ a rũciaro rwa Iru, nao Ahushimu maarĩ a rũciaro rwa Aheri.<verse eid="1CH 7:12"/></para>
  <para style="s2">Njiaro cia Nafitali</para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 7:13"/>Ariũ a Nafitali maarĩ:</para>
  <para style="li2" vid="1CH 7:13">Jahazieli, na Guni, na Jezeri, na Shalumu; aya maarĩ a rũciaro rwa Biliha.<verse eid="1CH 7:13"/></para>
  <para style="s2">Njiaro cia Manase</para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 7:14"/>Njiaro cia Manase ciarĩ:</para>
  <para style="pi2" vid="1CH 7:14">Asirieli, ũrĩa aaciarĩirwo nĩ thuriya yake ĩrĩa yarĩ Mũaramiti. Ningĩ thuriya ĩyo ĩkĩmũciarĩra Makiru, ũrĩa warĩ ithe wa Gileadi. <verse eid="1CH 7:14"/><verse number="15" style="v" sid="1CH 7:15"/>Makiru aahikanirie kuuma kwa Ahupimu na Ashupimu. Mwarĩ wa nyina eetagwo Maaka.</para>
  <para style="pi2" vid="1CH 7:15">Ũrĩa ũngĩ wa rũciaro rwake eetagwo Zelofehadi, nake aaciarĩte o airĩtu.<verse eid="1CH 7:15"/></para>
  <para style="pi2">
    <verse number="16" style="v" sid="1CH 7:16"/>Mũtumia wa Makiru, Maaka nĩaciarire mwanake na akĩmũtua Pereshu. Mũrũ wa nyina na Pereshu eetagwo Shereshu, na ariũ a Shereshu maarĩ Ulamu na Rakemu.<verse eid="1CH 7:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 7:17"/>Mũriũ wa Ulamu eetagwo:</para>
  <para style="li2" vid="1CH 7:17">Bedani.</para>
  <para style="li2" vid="1CH 7:17">Acio nĩo maarĩ ariũ a Gileadi mũrũ wa Makiru, mũrũ wa Manase. <verse eid="1CH 7:17"/><verse number="18" style="v" sid="1CH 7:18"/>Mwarĩ wa nyina Hamolekethu nĩaciarire Ishihodi, na Abiezeri, na Mahala.<verse eid="1CH 7:18"/></para>
  <para style="li2">
    <verse number="19" style="v" sid="1CH 7:19"/>Ariũ a Shemida maarĩ:</para>
  <para style="li2" vid="1CH 7:19">Ahiani, na Shekemu, na Liki, na Aniamu.<verse eid="1CH 7:19"/></para>
  <para style="s2">Njiaro cia Efiraimu</para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 7:20"/>Njiaro cia Efiraimu ciarĩ:</para>
  <para style="li2" vid="1CH 7:20">Shuthela na mũriũ Beredi,</para>
  <para style="li2" vid="1CH 7:20">na Tahathu mũriũ wa Beredi, na Eleada mũriũ wa Tahathu,</para>
  <para style="li2" vid="1CH 7:20">na Tahathu mũriũ wa Eleada, na mũriũ Zabadi,</para>
  <para style="li2" vid="1CH 7:20">na Shuthela mũriũ wa Zabadi, <verse eid="1CH 7:20"/><verse number="21" style="v" sid="1CH 7:21"/>na Zabadi aarĩ mũriũ wa Tahathu,</para>
  <para style="li2" vid="1CH 7:21">nake Shuthela aarĩ mũriũ wa Zabadi.</para>
  <para style="pi2" vid="1CH 7:21">Ezeri na Eleadi mooragirwo nĩ andũ arĩa maaciarĩirwo Gathi hĩndĩ ĩrĩa maathiĩte gũtaha mahiũ mao. <verse eid="1CH 7:21"/><verse number="22" style="v" sid="1CH 7:22"/>Ithe wao Efiraimu nĩamacakaĩire mĩthenya mĩingĩ, nao andũ ao magĩũka kũmũhooreria. <verse eid="1CH 7:22"/><verse number="23" style="v" sid="1CH 7:23"/>Ningĩ agĩkoma na mũtumia wake rĩngĩ, nake akĩgĩa nda agĩciara kahĩĩ. Nake agĩgatua Beria, tondũ nĩ gwakoretwo na mũtino thĩinĩ wa nyũmba yake. <verse eid="1CH 7:23"/><verse number="24" style="v" sid="1CH 7:24"/>Mwarĩ wa Efiraimu eetagwo Sheera, ũrĩa waakire Bethi-Horoni ya kĩanda na ya rũgongo, na agĩaka Uzeni-Sheera.<verse eid="1CH 7:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 7:25"/>Refa aarĩ mũriũ wa Efiraimu, na mũriũ eetagwo Resefu,</para>
  <para style="li2" vid="1CH 7:25">na Tela mũriũ wa Resefu, na Tahani mũriũ wa Tela,<verse eid="1CH 7:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 7:26"/>na Ladani mũriũ wa Tahani, na Amihudu mũriũ wa Ladani,</para>
  <para style="li2" vid="1CH 7:26">na Elishama mũriũ wa Amihudu, <verse eid="1CH 7:26"/><verse number="27" style="v" sid="1CH 7:27"/>na Nuni mũriũ wa Elishama,</para>
  <para style="li2" vid="1CH 7:27">na Joshua mũriũ wa Nuni.<verse eid="1CH 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 7:28"/>Ithaka na ciikaro ciao ciarĩ Betheli, na matũũra marĩa maakũrigiicĩirie, na nĩ Naara mwena wa irathĩro, na Gezeri na matũũra makuo ma mwena wa ithũĩro, na Shekemu na matũũra makuo, nginya Gaza na matũũra makuo. <verse eid="1CH 7:28"/><verse number="29" style="v" sid="1CH 7:29"/>Kũrigania na mĩhaka ya Manase maarĩ na Bathi-Shani, na Taanaka, na Megido, na Dori, hamwe na matũũra makuo. Njiaro cia Jusufu mũrũ wa Isiraeli nĩcio ciaikaraga matũũra macio.<verse eid="1CH 7:29"/></para>
  <para style="s1">Njiaro cia Asheri</para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 7:30"/>Ariũ a Asheri maarĩ:</para>
  <para style="li2" vid="1CH 7:30">Imuna, na Ishiva, na Ishivi, na Beria. Mwarĩ wa nyina wao eetagwo Sera.<verse eid="1CH 7:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 7:31"/>Ariũ a Beria maarĩ:</para>
  <para style="li2" vid="1CH 7:31">Heberi na Malikieli ũrĩa warĩ ithe wa Birizaithu.<verse eid="1CH 7:31"/></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 7:32"/>Heberi nĩwe warĩ ithe wa Jefileti, na Shomeri, na Hothamu, na mwarĩ wa nyina wao eetagwo Shua.<verse eid="1CH 7:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 7:33"/>Ariũ a Jafileti maarĩ:</para>
  <para style="li2" vid="1CH 7:33">Pasaka, na Bimihali, na Ashavathu. Acio maarĩ ariũ a Jefileti.<verse eid="1CH 7:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 7:34"/>Ariũ a Shomeri maarĩ:</para>
  <para style="li2" vid="1CH 7:34">Ahi, na Rohaga, na Jehuba, na Aramu.<verse eid="1CH 7:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 7:35"/>Ariũ a mũrũ wa nyina na Helemu maarĩ:</para>
  <para style="li2" vid="1CH 7:35">Zofa, na Imuna, na Sheleshu, na Amali.<verse eid="1CH 7:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 7:36"/>Ariũ a Zofa maarĩ:</para>
  <para style="li2" vid="1CH 7:36">Sua, na Harineferi, na Shuali, na Beri, na Imura, <verse eid="1CH 7:36"/><verse number="37" style="v" sid="1CH 7:37"/>na Bezeri, na Hodi, na Shama, na Shilisha, na Ithirani, na Beera.<verse eid="1CH 7:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 7:38"/>Ariũ a Jetheri maarĩ:</para>
  <para style="li2" vid="1CH 7:38">Jefune, na Pisipa, na Ara.<verse eid="1CH 7:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 7:39"/>Ariũ a Ula maarĩ:</para>
  <para style="li2" vid="1CH 7:39">Ara, na Hanieli, na Rizia.<verse eid="1CH 7:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="1CH 7:40"/>Acio othe maarĩ njiaro cia Asheri; nĩo maarĩ atongoria a nyũmba ciao, na andũ athuure, na njamba cia ita, na atongoria arĩa maarĩ igweta. Mũigana wa andũ arĩa maangĩathiire mbaara kũringana na maandĩko ma njiarwa ciao maarĩ 26,000.<verse eid="1CH 7:40"/></para>
  <chapter eid="1CH 7"/>
  <chapter number="8" style="c" sid="1CH 8"/>
  <para style="s1">Maandĩko ma Njiarwa cia Saũlũ ũrĩa Mũbenjamini</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 8:1"/>Benjamini nĩwe warĩ ithe wa Bela, mũriũ wake wa irigithathi;</para>
  <para style="li2" vid="1CH 8:1">Ashibeli aarĩ mũriũ wa keerĩ, nake Ahara wa gatatũ,<verse eid="1CH 8:1"/></para>
  <para style="li2">
    <verse number="2" style="v" sid="1CH 8:2"/>nake Noha wa kana, nake Rafa wa gatano.<verse eid="1CH 8:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 8:3"/>Ariũ a Bela maarĩ:</para>
  <para style="li2" vid="1CH 8:3">Adari, na Gera, na Abihudi, <verse eid="1CH 8:3"/><verse number="4" style="v" sid="1CH 8:4"/>na Abishua, na Naamani, na Ahoa, <verse eid="1CH 8:4"/><verse number="5" style="v" sid="1CH 8:5"/>na Gera, na Shefufani, na Huramu.<verse eid="1CH 8:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 8:6"/>Aya nĩo maarĩ njiaro cia Ehudu, arĩa maarĩ atongoria a nyũmba cia arĩa maatũũraga Geba, na nĩo maathaamĩirio Manahathu:<verse eid="1CH 8:6"/></para>
  <para style="li2">
    <verse number="7" style="v" sid="1CH 8:7"/>Naamani, na Ahija, na Gera ũrĩa wamathaamirie, na nĩwe warĩ ithe wa Uza na Ahihudu.<verse eid="1CH 8:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 8:8"/>Shaharaimu nĩaciarĩirwo ciana kũu Moabi thuutha wa gũte atumia ake Hushimu na Baara. <verse eid="1CH 8:8"/><verse number="9" style="v" sid="1CH 8:9"/>Mũtumia wake Hodeshu akĩmũciarĩra ciana ici: Jobabu, na Zibia, na Mesha, na Malikamu, <verse eid="1CH 8:9"/><verse number="10" style="v" sid="1CH 8:10"/>na Jeuzu, na Shakia, na Mirima. Acio nĩo maarĩ ariũ ake, na maarĩ atongoria a nyũmba ciao. <verse eid="1CH 8:10"/><verse number="11" style="v" sid="1CH 8:11"/>Mũtumia wake Hushimu akĩmũciarĩra Ahitubu na Elipaali.<verse eid="1CH 8:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 8:12"/>Ariũ a Elipaali maarĩ:</para>
  <para style="li2" vid="1CH 8:12">Eberi, na Mishamu, na Shemedi (ũrĩa wakire Ono, o na Lodi na matũũra marĩa maakũrigiicĩirie), <verse eid="1CH 8:12"/><verse number="13" style="v" sid="1CH 8:13"/>na Beria, na Shema arĩa maarĩ atongoria a nyũmba cia arĩa maatũũraga Aijaloni, na nĩo maingatire andũ arĩa maatũũraga Gathu.<verse eid="1CH 8:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 8:14"/>Ahio, na Shashaka, na Jeremothu, <verse eid="1CH 8:14"/><verse number="15" style="v" sid="1CH 8:15"/>na Zebadia, na Aradi, na Ederi, <verse eid="1CH 8:15"/><verse number="16" style="v" sid="1CH 8:16"/>na Mikaeli, na Ishipa, na Joha maarĩ ariũ a Beria.<verse eid="1CH 8:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 8:17"/>Zebadia, na Meshulamu, na Hiziki, na Heberi, <verse eid="1CH 8:17"/><verse number="18" style="v" sid="1CH 8:18"/>na Ishimerai, na Izilia, na Jababu maarĩ ariũ a Elipaali.<verse eid="1CH 8:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 8:19"/>Jakimu, na Zikiri, na Zabedi, <verse eid="1CH 8:19"/><verse number="20" style="v" sid="1CH 8:20"/>na Elienai, na Zilethai, na Elieli, <verse eid="1CH 8:20"/><verse number="21" style="v" sid="1CH 8:21"/>na Adaia, na Beraia, na Shimirathu maarĩ ariũ a Shimei.<verse eid="1CH 8:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 8:22"/>Ishipani, na Eberi, na Elieli, <verse eid="1CH 8:22"/><verse number="23" style="v" sid="1CH 8:23"/>na Abidoni, na Zikiri, na Hanani, <verse eid="1CH 8:23"/><verse number="24" style="v" sid="1CH 8:24"/>na Hanania, na Elamu, na Anithothija, <verse eid="1CH 8:24"/><verse number="25" style="v" sid="1CH 8:25"/>na Ifĩdeia, na Penueli maarĩ ariũ a Shashaka.<verse eid="1CH 8:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 8:26"/>Shamusherai, na Sheharia, na Athalia, <verse eid="1CH 8:26"/><verse number="27" style="v" sid="1CH 8:27"/>na Jaareshia, na Elija, na Zikiri maarĩ ariũ a Jerohamu.<verse eid="1CH 8:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 8:28"/>Aya othe maarĩ atongoria a nyũmba o na anene, ta ũrĩa maandĩkĩtwo maandĩko-inĩ ma njiarwa ciao, na maaikaraga Jerusalemu.<verse eid="1CH 8:28"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 8:29"/>Jeieli ithe wa Gibeoni aatũũraga Gibeoni.</para>
  <para style="li2" vid="1CH 8:29">Mũtumia wake eetagwo Maaka, <verse eid="1CH 8:29"/><verse number="30" style="v" sid="1CH 8:30"/>na mũriũ wake wa irigithathi eetagwo Abidoni, akarũmĩrĩrwo nĩ Zuru, na Kishu, na Baali, na Neri, na Nadabu, <verse eid="1CH 8:30"/><verse number="31" style="v" sid="1CH 8:31"/>na Gedori, na Ahio, na Zekeri, <verse eid="1CH 8:31"/><verse number="32" style="v" sid="1CH 8:32"/>na Mikilothu ũrĩa warĩ ithe wa Shimea. O nao maaikaraga hakuhĩ na andũ ao kũu Jerusalemu.<verse eid="1CH 8:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 8:33"/>Neri aarĩ ithe wa Kishu, nake Kishu aarĩ ithe wa Saũlũ. Saũlũ aarĩ ithe wa Jonathani<verse eid="1CH 8:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 8:34"/>Mũriũ wa Jonathani:</para>
  <para style="li2" vid="1CH 8:34">eetagwo Meribu-Baali, na nĩwe warĩ ithe wa Mika.<verse eid="1CH 8:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 8:35"/>Ariũ a Mika maarĩ:</para>
  <para style="li2" vid="1CH 8:35">Pithoni, na Meleku, na Tarea, na Ahazu.<verse eid="1CH 8:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 8:36"/>Ahazu aarĩ ithe wa Jehoada, nake Jehoada aarĩ ithe wa Alemethu, na Azamavethu, na Zimuri; nake Zimuri aarĩ ithe wa Moza. <verse eid="1CH 8:36"/><verse number="37" style="v" sid="1CH 8:37"/>Moza aarĩ ithe wa Binea; nake Rafa aarĩ mũriũ wa Binea, nake Eleasa aarĩ mũriũ wa Rafa, nake Azeli aarĩ mũriũ wa Eleasa.<verse eid="1CH 8:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 8:38"/>Azeli aarĩ na ariũ atandatũ, na maya nĩmo marĩĩtwa mao:</para>
  <para style="li2" vid="1CH 8:38">Azirikamu, na Bokeru, na Ishumaeli, na Shearia, na Obadia, na Hanani. Acio nĩo maarĩ ariũ a Azeli.<verse eid="1CH 8:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 8:39"/>Ariũ a Esheku, mũrũ wa nyina, maarĩ:</para>
  <para style="li2" vid="1CH 8:39">Ulamu irigithathi rĩake, na Jeushu wa keerĩ, na Elifeleti wa gatatũ. <verse eid="1CH 8:39"/><verse number="40" style="v" sid="1CH 8:40"/>Ariũ a Ulamu maarĩ njamba cia ita, na nĩmamenyete gũtũmĩra ũta. Maarĩ na ariũ aingĩ o na ciana cia ciana ciao, na othe maarĩ 150.</para>
  <para style="li1" vid="1CH 8:40">Acio othe nĩo maarĩ njiaro cia Benjamini.<verse eid="1CH 8:40"/></para>
  <para style="b"/>
  <chapter eid="1CH 8"/>
  <chapter number="9" style="c" sid="1CH 9"/>
  <para style="p">
    <verse number="1" style="v" sid="1CH 9:1"/>Andũ a Isiraeli othe nĩmandĩkĩtwo maandĩko-inĩ ma njiarwa marĩa maarĩ mbuku-inĩ ya athamaki a Isiraeli.</para>
  <para style="s1" vid="1CH 9:1">Andũ arĩa maarĩ Jerusalemu</para>
  <para style="p" vid="1CH 9:1">Andũ a Juda nĩmatahĩtwo magatwarwo Babuloni nĩ ũndũ wa kwaga kwĩhokeka. <verse eid="1CH 9:1"/><verse number="2" style="v" sid="1CH 9:2"/>Na rĩrĩ, andũ arĩa maambire gũcooka gũikara mĩgũnda-inĩ yao o kũu matũũra-inĩ mao, maarĩ andũ amwe a Isiraeli, na athĩnjĩri-Ngai, na Alawii, na ndungata cia hekarũ.<verse eid="1CH 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 9:3"/>Andũ arĩa maatũũraga Jerusalemu kuuma Juda, na Benjamini, na Efiraimu, na Manase maarĩ:<verse eid="1CH 9:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 9:4"/>Uthai mũrũ wa Amihudu, mũrũ wa Omuri, mũrũ wa Imuri, mũrũ wa Bani wa rũciaro rwa Perezu mũrũ wa Juda.<verse eid="1CH 9:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 9:5"/>Andũ a Shiloni maarĩ:</para>
  <para style="li2" vid="1CH 9:5">Asaia ũrĩa warĩ irigithathi, na ariũ ake.<verse eid="1CH 9:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 9:6"/>Kuuma Zera aarĩ:</para>
  <para style="li2" vid="1CH 9:6">Jeueli.</para>
  <para style="li2" vid="1CH 9:6">Andũ othe a kuuma Juda maarĩ 690.<verse eid="1CH 9:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 9:7"/>Andũ a Benjamini maarĩ:</para>
  <para style="li2" vid="1CH 9:7">Salu mũrũ wa Meshulamu, mũrũ wa Hodavia, mũrũ wa Hasenua; <verse eid="1CH 9:7"/><verse number="8" style="v" sid="1CH 9:8"/>na Ibineia mũrũ wa Jerohamu; Ela mũrũ wa Uzi, mũrũ wa Mikiri; na Meshulamu mũrũ wa Shefatia, mũrũ wa Reueli, mũrũ wa Ibinija.<verse eid="1CH 9:8"/></para>
  <para style="li2">
    <verse number="9" style="v" sid="1CH 9:9"/>Andũ a kuuma Benjamini, ta ũrĩa maandĩkĩtwo maandĩko-inĩ ma njiarwa ciao, maarĩ 956. Arũme acio othe maarĩ atongoria a nyũmba ciao.<verse eid="1CH 9:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 9:10"/>Athĩnjĩri-Ngai maarĩ:</para>
  <para style="li2" vid="1CH 9:10">Jedaia, na Jehoiaribu, na Jakini;<verse eid="1CH 9:10"/></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 9:11"/>na Azaria mũrũ wa Hilikia, mũrũ wa Meshulamu, mũrũ wa Zadoku, mũrũ wa Meraiothu, mũrũ wa Ahitubu ũrĩa warĩ mũmenyereri mũnene wa nyũmba ya Ngai; <verse eid="1CH 9:11"/><verse number="12" style="v" sid="1CH 9:12"/>na Adaia mũrũ wa Jerohamu, mũrũ wa Pashuru, mũrũ wa Malikija; na Maasai mũrũ wa Adieli, mũrũ wa Jahazera, mũrũ wa Meshulamu, mũrũ wa Meshilemithu, mũrũ wa Imeri.<verse eid="1CH 9:12"/></para>
  <para style="li2">
    <verse number="13" style="v" sid="1CH 9:13"/>Athĩnjĩri-Ngai arĩa maarĩ atongoria a nyũmba ciao maarĩ 1,760. Maarĩ arũme maarĩ na ũhoti, na nĩ meehokeirwo gũtungata nyũmba-inĩ ya Ngai.<verse eid="1CH 9:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 9:14"/>Alawii maarĩ:</para>
  <para style="li2" vid="1CH 9:14">Shemaia mũrũ wa Hashubu, mũrũ wa Azirikamu, mũrũ wa Hashabia ũrĩa Mũmerari, <verse eid="1CH 9:14"/><verse number="15" style="v" sid="1CH 9:15"/>na Bakabakari, na Hereshi, na Galali, na Matania mũrũ wa Mika, mũrũ wa Zikiri, mũrũ wa Asafu; <verse eid="1CH 9:15"/><verse number="16" style="v" sid="1CH 9:16"/>na Obadia mũrũ wa Shemaia, mũrũ wa Galali, mũrũ wa Jeduthuni; na Berekia mũrũ wa Asa, mũrũ wa Elikana, arĩa maaikaraga matũũra-inĩ ma Anetofathi.<verse eid="1CH 9:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 9:17"/>Arangĩri a ihingo maarĩ:</para>
  <para style="li2" vid="1CH 9:17">Shalumu, na Akubu, na Talimoni, na Ahimani na ariũ a nyina, na Shalumu mũnene wao, <verse eid="1CH 9:17"/><verse number="18" style="v" sid="1CH 9:18"/>acio maigĩtwo kĩhingo-inĩ kĩa mũthamaki mwena wa irathĩro, nginya ihinda-inĩ rĩu. Acio nĩo maarĩ arangĩri a ihingo a gĩkundi kĩa Alawii. <verse eid="1CH 9:18"/><verse number="19" style="v" sid="1CH 9:19"/>Shalumu mũrũ wa Kore, mũrũ wa Ebiasafu, mũrũ wa Kora, na athiritũ ake arangĩri a ihingo kuuma nyũmba yake ya Akohathu. Acio nĩo meehokeirwo ũrangĩri wa itoonyero rĩa hema o ta ũrĩa maithe mao meehokeirwo ũrangĩri wa itoonyero rĩa Gĩikaro kĩa Jehova. <verse eid="1CH 9:19"/><verse number="20" style="v" sid="1CH 9:20"/>Mahinda ma mbere Finehasi mũrũ wa Eleazaru nĩwe warũgamagĩrĩra arangĩri a ihingo, nake Jehova aarĩ hamwe nake.<verse eid="1CH 9:20"/></para>
  <para style="li2">
    <verse number="21" style="v" sid="1CH 9:21"/>Zekaria mũrũ wa Meshelemia nĩwe warĩ mũrangĩri wa itoonyero rĩa Hema-ya-Gũtũnganwo.<verse eid="1CH 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 9:22"/>Arĩa othe maathuurĩtwo matuĩke arangĩri a ihingo maarĩ 212. Marĩĩtwa mao nĩmandĩkirwo maandĩko-inĩ ma njiarwa ciao, matũũra-inĩ mao. Arangĩri a ihingo maigirwo o mũndũ harĩa ehokeirwo nĩ Daudi na Samũeli ũrĩa muoni-maũndũ. <verse eid="1CH 9:22"/><verse number="23" style="v" sid="1CH 9:23"/>O ene na njiaro ciao nĩo maarũgamagĩrĩra ũrangĩri wa ihingo cia nyũmba ya Jehova, nyũmba ĩrĩa yetagwo Hema. <verse eid="1CH 9:23"/><verse number="24" style="v" sid="1CH 9:24"/>Arangĩri a ihingo maarĩ mĩena yothe ĩna: irathĩro, na ithũĩro, na gathigathini, na gũthini. <verse eid="1CH 9:24"/><verse number="25" style="v" sid="1CH 9:25"/>Ariũ a ithe wao a matũũra mao nĩmookaga rĩmwe na rĩmwe magateithania mawĩra nao ihinda rĩa mĩthenya mũgwanja. <verse eid="1CH 9:25"/><verse number="26" style="v" sid="1CH 9:26"/>No anene arĩa ana maaroraga arangĩri a ihingo, arĩa maarĩ Alawii, nĩmehokeirwo kũmenyerera tũnyũmba na igĩĩna cia nyũmba ya Ngai. <verse eid="1CH 9:26"/><verse number="27" style="v" sid="1CH 9:27"/>Maikaraga ũtukũ wothe hakuhĩ na nyũmba ya Ngai nĩgeetha mamĩrangagĩre; na nĩo maamenyagĩrĩra cabi ya kũmĩhingũra o rũciinĩ.<note caller="+" style="f"><char style="fr" closed="false">9:27 </char><char style="ft" closed="false">Arangĩri a hekarũ nĩo maigaga cabi nĩgũkorwo nĩyahingagwo ũtukũ.</char></note><verse eid="1CH 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 9:28"/>Amwe ao maarĩ amenyereri a indo iria ciatũmagĩrwo ũtungata-inĩ wa hekarũ; nĩmacitaraga ikĩrutwo na igĩcookio nyũmba thĩinĩ. <verse eid="1CH 9:28"/><verse number="29" style="v" sid="1CH 9:29"/>Angĩ maaheetwo wĩra wa kũmenyerera indo cia nyũmba na indo iria ingĩ ciothe ciakoragwo handũ-harĩa-haamũre, o hamwe na mũtu, na ndibei, na maguta, na ũbani, na mahuti marĩa manungi wega. <verse eid="1CH 9:29"/><verse number="30" style="v" sid="1CH 9:30"/>No athĩnjĩri-Ngai amwe nĩo maarutaga wĩra wa gũtukania mahuti macio manungi wega. <verse eid="1CH 9:30"/><verse number="31" style="v" sid="1CH 9:31"/>Mũlawii wetagwo Matithia, irigithathi rĩa Shalumu ũrĩa Mũkoora, nĩwe wehokeirwo wĩra wa gũthondeka mĩgate ya maruta. <verse eid="1CH 9:31"/><verse number="32" style="v" sid="1CH 9:32"/>Ariũ a ithe amwe ao a mũhĩrĩga wa Kohathu nĩo marũgamagĩrĩra ũthondeki wa mĩgate ya kũigĩrĩrwo metha-inĩ hĩndĩ ya thabatũ.<verse eid="1CH 9:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 9:33"/>Arĩa maarĩ aini, na atongoria a nyũmba cia Alawii, maaikaraga tũnyũmba-inĩ kũu hekarũ thĩinĩ na matiarutaga mawĩra mangĩ tondũ maarĩ a kũmenyerera wĩra ũcio wao mũthenya na ũtukũ.<verse eid="1CH 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 9:34"/>Acio othe maarĩ atongoria a nyũmba cia Alawii, na anene o ta ũrĩa maandĩkĩtwo ibuku-inĩ rĩa njiarwa ciao, nao maatũũraga Jerusalemu.<verse eid="1CH 9:34"/></para>
  <para style="s1">Njiarwa cia Saũlũ</para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 9:35"/>Jeieli ithe wa Gibeoni aatũũraga Gibeoni.</para>
  <para style="li2" vid="1CH 9:35">Mũtumia wake eetagwo Maaka, <verse eid="1CH 9:35"/><verse number="36" style="v" sid="1CH 9:36"/>na mũriũ wake wa irigithathi eetagwo Abidoni, akarũmĩrĩrwo nĩ Zuru, na Kishu, na Baali, na Neri, na Nadabu, <verse eid="1CH 9:36"/><verse number="37" style="v" sid="1CH 9:37"/>na Gedori, na Ahio, na Zekaria, na Mikilothu. <verse eid="1CH 9:37"/><verse number="38" style="v" sid="1CH 9:38"/>Mikilothu nĩwe warĩ ithe wa Shimeami. O nao maikaraga hakuhĩ na andũ ao kũu Jerusalemu.<verse eid="1CH 9:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 9:39"/>Neri aarĩ ithe wa Kishu, nake Kishu aarĩ ithe wa Saũlũ, nake Saũlũ aarĩ ithe wa Jonathani, na Maliki-Shua, na Abinadabu, na Eshi-Baali.<verse eid="1CH 9:39"/></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 9:40"/>Mũriũ wa Jonathani eetagwo Meribu-Baali, na nĩwe warĩ ithe wa Mika.<verse eid="1CH 9:40"/></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 9:41"/>Ariũ a Mika maarĩ:</para>
  <para style="li2" vid="1CH 9:41">Pithoni, na Meleku, na Taharea, na Ahazu.<verse eid="1CH 9:41"/></para>
  <para style="li2">
    <verse number="42" style="v" sid="1CH 9:42"/>Ahazu aarĩ ithe wa Jara, nake Jara aarĩ ithe wa Alemethu, na Azimavethu, na Zimuri, nake Zimuri aarĩ ithe wa Moza. <verse eid="1CH 9:42"/><verse number="43" style="v" sid="1CH 9:43"/>Moza aarĩ ithe wa Binea, nake Refaia aarĩ mũriũ wa Binea, nake Eleasa aarĩ mũriũ wa Refaia, nake Azeli aarĩ mũriũ wa Eleasa.<verse eid="1CH 9:43"/></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 9:44"/>Azeli aarĩ na ariũ atandatũ, na maya nĩmo marĩĩtwa mao:</para>
  <para style="li2" vid="1CH 9:44">Azirikamu, na Bokeru, na Ishumaeli, na Shearia, na Obadia, na Hanani.</para>
  <para style="li2" vid="1CH 9:44">Acio nĩo maarĩ ariũ a Azeli.<verse eid="1CH 9:44"/></para>
  <chapter eid="1CH 9"/>
  <chapter number="10" style="c" sid="1CH 10"/>
  <para style="s1">Saũlũ Kwĩyũraga</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 10:1"/>Na rĩrĩ, Afilisti nĩmarũire na Isiraeli; nao andũ a Isiraeli makĩmoorĩra, na aingĩ ao makĩũragĩrwo Kĩrĩma-inĩ kĩa Giliboa. <verse eid="1CH 10:1"/><verse number="2" style="v" sid="1CH 10:2"/>Afilisti makĩhatĩrĩria Saũlũ na ariũ ake mũno, na makĩũraga ariũ ake Jonathani, na Abinadabu, na Maliki-Shua. <verse eid="1CH 10:2"/><verse number="3" style="v" sid="1CH 10:3"/>Na rĩrĩ, mbaara nĩyaneneheire Saũlũ mũno, na hĩndĩ ĩrĩa aikia a mĩguĩ maamũkinyĩrire, makĩmũguraria.<verse eid="1CH 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 10:4"/>Nake Saũlũ akĩĩra mũkuui wa indo ciake cia mbaara atĩrĩ, “Comora rũhiũ rwaku rwa njora ũũthece naruo, nĩguo andũ aya mataruaga matigooke kũnyararithia.”</para>
  <para style="p" vid="1CH 10:4">No mũndũ ũcio mũkuui wa indo ciake cia mbaara agĩĩtigĩra mũno, akĩrega gwĩka ũguo; nĩ ũndũ ũcio Saũlũ akĩoya rũhiũ rwake rwa njora, akĩrũgwĩra. <verse eid="1CH 10:4"/><verse number="5" style="v" sid="1CH 10:5"/>Rĩrĩa mũkuui wa indo cia mbaara onire atĩ Saũlũ nĩakua, o nake akĩgwĩra rũhiũ rwake rwa njora, agĩkua. <verse eid="1CH 10:5"/><verse number="6" style="v" sid="1CH 10:6"/>Nĩ ũndũ ũcio Saũlũ na ariũ ake atatũ magĩkua, nao andũ othe a nyũmba yake magĩgĩkua o hamwe.<verse eid="1CH 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 10:7"/>Rĩrĩa andũ a Isiraeli othe arĩa maarĩ kĩanda moonire atĩ ita nĩrĩorĩte, na atĩ Saũlũ na ariũ ake nĩmakuĩte-rĩ, magĩtiganĩria matũũra mao, makĩũra; nao Afilisti magĩthiĩ magĩikara kuo.<verse eid="1CH 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 10:8"/>Mũthenya ũyũ ũngĩ, Afilisti magĩthiĩ gũcuuma ciimba, magĩkora Saũlũ na ariũ ake makuĩte kũu Kĩrĩma-inĩ kĩa Giliboa. <verse eid="1CH 10:8"/><verse number="9" style="v" sid="1CH 10:9"/>Makĩmũbora, na magĩkuua mũtwe wake, na indo ciake cia mbaara; magĩcooka magĩtũma andũ mathiĩ bũrũri wothe wa Afilisti makaanĩrĩre ũhoro ũcio kũrĩ mĩhianano yao ya kũhooywo, na kũrĩ andũ ao. <verse eid="1CH 10:9"/><verse number="10" style="v" sid="1CH 10:10"/>Makĩiga indo cia Saũlũ cia mbaara thĩinĩ wa hekarũ ya ngai ciao, naguo mũtwe wake makĩwoherera kũu hekarũ ya Dagoni.<verse eid="1CH 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 10:11"/>No rĩrĩa andũ a Jabeshi-Gileadi maaiguire ũhoro wa maũndũ marĩa mothe Afilisti meekĩte Saũlũ-rĩ, <verse eid="1CH 10:11"/><verse number="12" style="v" sid="1CH 10:12"/>njamba ciao cia ita igĩthiĩ, igĩkuua mĩĩrĩ ya Saũlũ na ya ariũ ake, ikĩmĩrehe Jabeshi. Magĩcooka magĩthika mahĩndĩ mao gĩtina-inĩ kĩa mũtĩ ũrĩa mũnene kũu Jabeshi, na makĩĩhinga kũrĩa irio mĩthenya mũgwanja.<verse eid="1CH 10:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 10:13"/>Saũlũ aakuire nĩ ũndũ ndaarĩ mwĩhokeku kũrĩ Jehova; ndaamenyereire kiugo kĩa Jehova, o na nĩahooire kĩrĩra kuuma kũrĩ mũragũri atĩ amũtongorie, <verse eid="1CH 10:13"/><verse number="14" style="v" sid="1CH 10:14"/>no ndahooire kĩrĩra kũrĩ Jehova. Nĩ ũndũ ũcio Jehova akĩmũũraga, na akĩneana ũthamaki kũrĩ Daudi mũrũ wa Jesii.<verse eid="1CH 10:14"/></para>
  <chapter eid="1CH 10"/>
  <chapter number="11" style="c" sid="1CH 11"/>
  <para style="s1">Daudi Gũtuĩka Mũthamaki wa Isiraeli</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 11:1"/>Hĩndĩ ĩyo andũ othe a Isiraeli magĩcookanĩrĩra harĩ Daudi kũu Hebironi, makĩmwĩra atĩrĩ, “Ithuĩ tũrĩ a mũthiimo na thakame yaku. <verse eid="1CH 11:1"/><verse number="2" style="v" sid="1CH 11:2"/>Ihinda rĩrĩa rĩhĩtũkĩte, o na Saũlũ arĩ o mũthamaki, wee nĩwe ũratongoragia Isiraeli mbaara-inĩ ciao. Nake Jehova Ngai waku agĩkwĩra atĩrĩ, ‘Nĩwe ũkaarĩithia andũ akwa Isiraeli, na nĩũgatuĩka mwathi wao.’ ”<verse eid="1CH 11:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 11:3"/>Nĩ ũndũ ũcio athuuri othe a Isiraeli magĩthiĩ Hebironi kũrĩ Mũthamaki Daudi, nake Daudi akĩgĩa na kĩrĩkanĩro nao mbere ya Jehova o kũu Hebironi, nao magĩitĩrĩria Daudi maguta mũtwe atuĩke mũthamaki wa Isiraeli, o ta ũrĩa Jehova eranĩire na kanua ga Samũeli.<verse eid="1CH 11:3"/></para>
  <para style="s1">Daudi Gũtooria Jerusalemu</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 11:4"/>Daudi hamwe na andũ a Isiraeli othe magĩthiĩ gũtharĩkĩra Jerusalemu, o kũu gwetagwo Jebusi. Nao Ajebusi arĩa maatũũraga kũu <verse eid="1CH 11:4"/><verse number="5" style="v" sid="1CH 11:5"/>makĩĩra Daudi atĩrĩ, “Ndũngĩtoonya gũkũ.” No rĩrĩ, Daudi nĩagĩtunyanire gĩikaro kĩu kĩairigĩirwo na thingo cia hinya gĩa Zayuni, Itũũra Inene rĩa Daudi.<note caller="+" style="f"><char style="fr" closed="false">11:5 </char><char style="ft" closed="false">Tene kĩrĩma kĩrĩa kĩarĩ mwena wa irathĩro wa Jerusalemu nĩkĩo kĩoĩkaine ta “Zayuni” no thuutha-inĩ rĩĩtwa rĩu rĩarũgamĩrĩire Jerusalemu yothe.</char></note><verse eid="1CH 11:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 11:6"/>Daudi oigĩte atĩrĩ, “Ũrĩa wothe ũgũtongoria mbaara ya kũhũũra Ajebusi nĩwe ũgaatuĩka mũnene wa thigari ciothe.” Joabu mũrũ wa Zeruia nĩwe waambire kwambata, na nĩ ũndũ ũcio nĩwe watuĩkire mũnene wa thigari.<verse eid="1CH 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 11:7"/>Daudi agĩgĩtũũra gĩikaro kĩu kĩairigĩirwo na rũthingo rwa hinya, na nĩ ũndũ ũcio gĩgĩtwo Itũũra Inene rĩa Daudi. <verse eid="1CH 11:7"/><verse number="8" style="v" sid="1CH 11:8"/>Nake agĩaka itũũra inene rĩthiũrũrũkĩirie gĩikaro kĩu, kuuma benji-inĩ nginya rũthingo-inĩ rũrĩa rwakĩrigiicĩirie, nake Joabu agĩcookereria mĩena ĩrĩa ĩngĩ ya itũũra rĩu inene. <verse eid="1CH 11:8"/><verse number="9" style="v" sid="1CH 11:9"/>Daudi agĩkĩrĩrĩria kũgĩa na ũhoti mũingĩ, tondũ Jehova Mwene-Hinya-Wothe aarĩ hamwe nake.<verse eid="1CH 11:9"/></para>
  <para style="s1">Andũ Njamba a Daudi</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 11:10"/>Aya nĩo maarĩ anene a andũ arĩa njamba a Daudi, o ene hamwe na andũ a Isiraeli othe, nĩmatirĩrĩire ũthamaki wake na hinya nĩguo ũtheereme bũrũri wothe, o ta ũrĩa Jehova eeranĩire. <verse eid="1CH 11:10"/><verse number="11" style="v" sid="1CH 11:11"/>Maya nĩmo marĩĩtwa ma andũ acio maarĩ njamba a Daudi:</para>
  <para style="p" vid="1CH 11:11">Jashobeamu ũrĩa Mũhakimoni nake aarĩ mũtongoria wa anene; nĩwe woire itimũ rĩake ahũũrane na andũ 300, nake akĩmooraga mbaara-inĩ ĩmwe.<verse eid="1CH 11:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 11:12"/>Mũnini wake eetagwo Eleazaru mũrũ wa Dodo ũrĩa Mũahohi, ũmwe wa andũ atatũ arĩa maarĩ njamba. <verse eid="1CH 11:12"/><verse number="13" style="v" sid="1CH 11:13"/>Nake aarĩ hamwe na Daudi kũu Pasi-Damimu hĩndĩ ĩrĩa Afilisti moonganĩte marũe nao. Maarĩ handũ haarĩ mũgũnda waiyũire cairi, nacio thigari ikĩũrĩra Afilisti. <verse eid="1CH 11:13"/><verse number="14" style="v" sid="1CH 11:14"/>No-o nĩmaregeire gatagatĩ ka mũgũnda ũcio. Makĩũgitĩra, na makĩũraga Afilisti, nake Jehova akĩmahe ũhootani mũnene.<verse eid="1CH 11:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 11:15"/>Anene atatũ a acio mĩrongo ĩtatũ, nĩmaikũrũkire magĩthiĩ kũrĩ Daudi ihiga-inĩ rĩrĩa rĩarĩ ngurunga-inĩ ya Adulamu, hĩndĩ ĩrĩa mbũtũ ya Afilisti yaambĩte hema Kĩanda kĩa Refaimu. <verse eid="1CH 11:15"/><verse number="16" style="v" sid="1CH 11:16"/>Hĩndĩ ĩyo Daudi aarĩ kĩĩhitho-inĩ kĩrũmu nayo mbũtũ ya Afilisti yarĩ Bethilehemu. <verse eid="1CH 11:16"/><verse number="17" style="v" sid="1CH 11:17"/>Daudi akĩĩrirĩria maaĩ, akiuga atĩrĩ, “Naarĩ korwo kũrĩ mũndũ ũngĩndehera maaĩ ma kũnyua kuuma gĩthima-inĩ kĩrĩa kĩrĩ hakuhĩ na kĩhingo kĩa Bethilehemu!” <verse eid="1CH 11:17"/><verse number="18" style="v" sid="1CH 11:18"/>Nĩ ũndũ ũcio andũ acio atatũ magĩtuĩkanĩria gatagatĩ ka ita rĩa Afilisti, magĩtaha maaĩ gĩthima-inĩ kĩu kĩarĩ hakuhĩ na kĩhingo kĩa Bethilehemu, na makĩmatwarĩra Daudi. No Daudi akĩrega kũmanyua; akĩmaita mbere ya Jehova. <verse eid="1CH 11:18"/><verse number="19" style="v" sid="1CH 11:19"/>Akiuga atĩrĩ, “Ngai arogiria njĩke ũguo! No ngĩnyue thakame ya andũ aya mathiĩrĩire ũgwati-inĩ wa gĩkuũ?” Tondũ nĩmathiĩrĩire ũgwati-inĩ wa gĩkuũ nĩguo mamarehe-rĩ, Daudi akĩrega kũmanyua.</para>
  <para style="p" vid="1CH 11:19">Maũndũ ta macio nĩmo meekagwo nĩ njamba icio ithatũ.<verse eid="1CH 11:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 11:20"/>Abishai mũrũ wa nyina na Joabu nĩwe warĩ mũnene wa acio Atatũ. Nake akĩoya itimũ rĩake, agĩtharĩkĩra andũ magana matatũ, akĩmooraga, nĩ ũndũ ũcio akĩgĩa igweta o ta acio Atatũ. <verse eid="1CH 11:20"/><verse number="21" style="v" sid="1CH 11:21"/>Nĩatĩĩkire mũno gũkĩra acio angĩ Atatũ na agĩtuĩka mwathi wao o na gũtuĩka ndaataranĩirio nao.<verse eid="1CH 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 11:22"/>Benaia mũrũ wa Jehoiada aarĩ mũrũi njamba wa kuuma Kabizeeli, ũrĩa wekire maũndũ manene ma ũcamba. Nĩooragire njamba nene igĩrĩ cia ita cia Moabi. Ningĩ nĩatoonyire irima mũthenya warĩ na tharunji, na akĩũraga mũrũũthi. <verse eid="1CH 11:22"/><verse number="23" style="v" sid="1CH 11:23"/>Na nĩooragire Mũmisiri warĩ wa ũraihu wa buti mũgwanja na nuthu.<note caller="+" style="f"><char style="fr" closed="false">11:23 </char><char style="ft" closed="false">nĩ ta mita igĩrĩ na robo (2:25)</char></note> O na gũtuĩka Mũmisiri ũcio nĩanyiitĩte itimũ rĩaiganaga ta mũtĩ wa mũtumi ngoora, Benaia akĩmũtharĩkĩra na njũgũma. Akĩhuria itimũ kuuma guoko-inĩ kwa Mũmisiri ũcio, na akĩmũũraga na itimũ rĩu rĩake. <verse eid="1CH 11:23"/><verse number="24" style="v" sid="1CH 11:24"/>Macio nĩmo maũndũ ma ũcamba marĩa mekirwo nĩ Benaia mũrũ wa Jehoiada. O nake aarĩ igweta o ta andũ arĩa atatũ maarĩ njamba. <verse eid="1CH 11:24"/><verse number="25" style="v" sid="1CH 11:25"/>Nĩatĩĩtwo gũkĩra arĩa Mĩrongo Ĩtatũ, no ndaataranĩirio na acio Atatũ. Nake Daudi akĩmũtua mũnene wa arĩa maamũrangagĩra.<verse eid="1CH 11:25"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 11:26"/>Andũ arĩa maarĩ njamba maarĩ:</para>
  <para style="li2" vid="1CH 11:26">Asaheli mũrũ wa nyina na Joabu,</para>
  <para style="li2" vid="1CH 11:26">na Elihanani mũrũ wa Dodo wa kuuma Bethilehemu,<verse eid="1CH 11:26"/></para>
  <para style="li2">
    <verse number="27" style="v" sid="1CH 11:27"/>na Shamothu ũrĩa Mũharori,</para>
  <para style="li2" vid="1CH 11:27">na Helezu ũrĩa Mũpeloni,<verse eid="1CH 11:27"/></para>
  <para style="li2">
    <verse number="28" style="v" sid="1CH 11:28"/>na Ira mũrũ wa Ikeshu kuuma Tekoa,</para>
  <para style="li3" vid="1CH 11:28">na Abiezeri kuuma Anathothu,<verse eid="1CH 11:28"/></para>
  <para style="li2">
    <verse number="29" style="v" sid="1CH 11:29"/>na Sibekai ũrĩa Mũhushathi,</para>
  <para style="li2" vid="1CH 11:29">na Ilai ũrĩa Mũahohi,<verse eid="1CH 11:29"/></para>
  <para style="li2">
    <verse number="30" style="v" sid="1CH 11:30"/>na Maharai ũrĩa Mũnetofathi,</para>
  <para style="li2" vid="1CH 11:30">na Helebu mũrũ wa Baana ũrĩa Mũnetofathi,<verse eid="1CH 11:30"/></para>
  <para style="li2">
    <verse number="31" style="v" sid="1CH 11:31"/>na Ithai mũrũ wa Ribai, wa kuuma Gibea kũu Benjamini,</para>
  <para style="li2" vid="1CH 11:31">na Benaia ũrĩa Mũpirathoni,<verse eid="1CH 11:31"/></para>
  <para style="li2">
    <verse number="32" style="v" sid="1CH 11:32"/>na Hurai kuuma tũrũũĩ-inĩ twa Gaashu,</para>
  <para style="li2" vid="1CH 11:32">na Abieli ũrĩa Mũaribathi,<verse eid="1CH 11:32"/></para>
  <para style="li2">
    <verse number="33" style="v" sid="1CH 11:33"/>na Azamavethu ũrĩa Mũbahurimu,</para>
  <para style="li2" vid="1CH 11:33">na Eliahaba ũrĩa Mũshaaliboni,<verse eid="1CH 11:33"/></para>
  <para style="li2">
    <verse number="34" style="v" sid="1CH 11:34"/>na ariũ a Hashemu ũrĩa Mũgizoni,</para>
  <para style="li2" vid="1CH 11:34">na Jonathani mũrũ wa Shage ũrĩa Mũharari,<verse eid="1CH 11:34"/></para>
  <para style="li2">
    <verse number="35" style="v" sid="1CH 11:35"/>na Ahiamu mũrũ wa Sakaru ũrĩa Mũharari,</para>
  <para style="li2" vid="1CH 11:35">na Elifali mũrũ wa Uri,<verse eid="1CH 11:35"/></para>
  <para style="li2">
    <verse number="36" style="v" sid="1CH 11:36"/>na Heferi ũrĩa Mũmekerathi,</para>
  <para style="li2" vid="1CH 11:36">na Ahija ũrĩa Mũpeloni,<verse eid="1CH 11:36"/></para>
  <para style="li2">
    <verse number="37" style="v" sid="1CH 11:37"/>na Hezoro ũrĩa Mũkarimeli,</para>
  <para style="li2" vid="1CH 11:37">na Naarai mũrũ wa Ezibai,<verse eid="1CH 11:37"/></para>
  <para style="li2">
    <verse number="38" style="v" sid="1CH 11:38"/>na Joeli mũrũ wa ithe na Nathani,</para>
  <para style="li2" vid="1CH 11:38">na Mibihari mũrũ wa Hagari,<verse eid="1CH 11:38"/></para>
  <para style="li2">
    <verse number="39" style="v" sid="1CH 11:39"/>na Zeleku ũrĩa Mũamoni,</para>
  <para style="li2" vid="1CH 11:39">na Naharai ũrĩa Mũberothi, ũrĩa wakuuagĩra Joabu mũrũ wa Zeruia indo cia mbaara,<verse eid="1CH 11:39"/></para>
  <para style="li2">
    <verse number="40" style="v" sid="1CH 11:40"/>na Ira ũrĩa Mũithiri,</para>
  <para style="li2" vid="1CH 11:40">na Garebu ũrĩa Mũithiri,<verse eid="1CH 11:40"/></para>
  <para style="li2">
    <verse number="41" style="v" sid="1CH 11:41"/>na Uria ũrĩa Mũhiti,</para>
  <para style="li2" vid="1CH 11:41">na Zabadi mũrũ wa Ahalai,<verse eid="1CH 11:41"/></para>
  <para style="li2">
    <verse number="42" style="v" sid="1CH 11:42"/>na Adina mũrũ wa Shiza ũrĩa Mũrubeni, ũrĩa warĩ mũnene wa Arubeni, arĩ na andũ mĩrongo ĩtatũ arĩa maarĩ nake,<verse eid="1CH 11:42"/></para>
  <para style="li2">
    <verse number="43" style="v" sid="1CH 11:43"/>na Hanani mũrũ wa Maaka,</para>
  <para style="li2" vid="1CH 11:43">na Joshafatu ũrĩa Mũmithini,<verse eid="1CH 11:43"/></para>
  <para style="li2">
    <verse number="44" style="v" sid="1CH 11:44"/>na Uzia ũrĩa Mũashiterathi,</para>
  <para style="li2" vid="1CH 11:44">na Shama na Jeieli, ariũ a Hothamu ũrĩa Mũaroeri,<verse eid="1CH 11:44"/></para>
  <para style="li2">
    <verse number="45" style="v" sid="1CH 11:45"/>na Jediaeli mũrũ wa Shimuri,</para>
  <para style="li2" vid="1CH 11:45">o na Joha mũrũ wa ithe ũrĩa Mũtizi,<verse eid="1CH 11:45"/></para>
  <para style="li2">
    <verse number="46" style="v" sid="1CH 11:46"/>na Elieli ũrĩa Mũmahavi,</para>
  <para style="li2" vid="1CH 11:46">na Jeribai na Joshavia, ariũ a Elinaamu,</para>
  <para style="li2" vid="1CH 11:46">na Ithima ũrĩa Mũmoabi,<verse eid="1CH 11:46"/></para>
  <para style="li2">
    <verse number="47" style="v" sid="1CH 11:47"/>na Elieli, na Obedi, na Jaasieli ũrĩa Mũmezobai.<verse eid="1CH 11:47"/></para>
  <chapter eid="1CH 11"/>
  <chapter number="12" style="c" sid="1CH 12"/>
  <para style="s1">Njamba cia Ita Kũnyiitana na Daudi</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 12:1"/>Aya nĩo andũ arĩa mookire kũrĩ Daudi arĩ kũu Zikilagi, hĩndĩ ĩrĩa aaingatĩtwo akehera maitho-inĩ ma Saũlũ mũrũ wa Kishu (maarĩ amwe a njamba cia ita iria ciamũteithirie mbaara-inĩ; <verse eid="1CH 12:1"/><verse number="2" style="v" sid="1CH 12:2"/>Nao maakuuaga mota na nĩmooĩ gũikia mĩguĩ, na gũikia mahiga na kĩgũtha, na guoko kwa ũrĩo kana kwa ũmotho; maarĩ a mbarĩ ĩmwe na Saũlũ kuuma mũhĩrĩga wa Benjamini), nao maarĩ:<verse eid="1CH 12:2"/></para>
  <para style="b"/>
  <para style="mi">
    <verse number="3" style="v" sid="1CH 12:3"/>Ahiezeri ũrĩa warĩ mũnene wao na Joashu, ariũ a Shemaa ũrĩa Mũgibea; na Jezieli, na Peleti, ariũ a Azimavethu; na Beraka, na Jehu ũrĩa Mũanathothu, <verse eid="1CH 12:3"/><verse number="4" style="v" sid="1CH 12:4"/>na Ishimaia ũrĩa Mũgibeoni, mũndũ warĩ njamba thĩinĩ wa andũ arĩa Mĩrongo Ĩtatũ, nake aarĩ mũtongoria ũmwe thĩinĩ wa acio Mĩrongo Ĩtatũ; na Jeremia, na Jahazieli, na Johanani, na Jozabadu ũrĩa Mũgederathi, <verse eid="1CH 12:4"/><verse number="5" style="v" sid="1CH 12:5"/>na Eluzai, na Jerimothu, na Bealia, na Shemaria, na Shefatia ũrĩa Mũharufi; <verse eid="1CH 12:5"/><verse number="6" style="v" sid="1CH 12:6"/>na Elikana, na Ishia, na Azareli, na Joezeru, na Jashobeamu arĩa maarĩ a mbarĩ ya Kora; <verse eid="1CH 12:6"/><verse number="7" style="v" sid="1CH 12:7"/>na Joela, na Zebadia, ariũ a Jerohamu kuuma Gedori.<verse eid="1CH 12:7"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="8" style="v" sid="1CH 12:8"/>Agadi amwe nĩmagarũrũkire magĩcooka mwena wa Daudi o kũu werũ-inĩ kĩĩhitho-inĩ gĩake. Maarĩ njamba cia ita irĩ ũrũme ciehaarĩirie gũthiĩ mbaara, na nĩmooĩ kũhũthĩra ngo na itimũ. Mothiũ mao maahaanaga ta mothiũ ma mĩrũũthi, na maarĩ ihenya ta thwariga irĩ irĩma-inĩ.<verse eid="1CH 12:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 12:9"/>Ezeri nĩwe warĩ mũnene wao,</para>
  <para style="li1" vid="1CH 12:9">na Obadia aarĩ mũnini wake; nake Eliabu aarĩ wa gatatũ,<verse eid="1CH 12:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 12:10"/>na Mishimana aarĩ wa kana, na Jeremia aarĩ wa gatano,<verse eid="1CH 12:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 12:11"/>na Atai aarĩ wa gatandatũ, na Elieli aarĩ wa mũgwanja,<verse eid="1CH 12:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 12:12"/>na Johanani aarĩ wa kanana, na Elizabadu aarĩ wa kenda,<verse eid="1CH 12:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 12:13"/>na Jeremia aarĩ wa ikũmi, na Makabanai aarĩ wa ikũmi na ũmwe.<verse eid="1CH 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 12:14"/>Agadi acio maarĩ anene a mbũtũ cia ita; ũrĩa warĩ mũnini mũno wao aarũaga mbaara ĩrĩa ĩngĩarũirwo nĩ andũ igana, nake ũrĩa warĩ mũnene mũno wao aarũaga mbaara ĩrĩa ĩngĩarũirwo nĩ andũ ngiri ĩmwe. <verse eid="1CH 12:14"/><verse number="15" style="v" sid="1CH 12:15"/>Nĩo maaringire Rũũĩ rwa Jorodani mweri wa mbere rĩrĩa rwaiyũrĩte nginya rũkoina hũgũrũrũ ciaruo ciothe, na makĩingatithia andũ arĩa othe maaikaraga cianda-inĩ cia mwena wa irathĩro na mwena wa ithũĩro.<verse eid="1CH 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 12:16"/>Andũ amwe a kuuma Benjamini na angĩ a kuuma Juda o nao magĩũka kũrĩ Daudi kũu kĩĩhitho-inĩ gĩake. <verse eid="1CH 12:16"/><verse number="17" style="v" sid="1CH 12:17"/>Daudi agĩthiĩ kũmatũnga, akĩmeera atĩrĩ, “Angĩkorwo mũrooka kũrĩ niĩ na thayũ kũndeithia-rĩ, nĩndĩhaarĩirie kũmwamũkĩra tũtuĩke kĩndũ kĩmwe; no angĩkorwo mũũkĩte kũngunyanĩra kũrĩ thũ ciakwa o rĩrĩa itarenda haaro-rĩ, Ngai wa maithe maitũ arorora ũndũ ũcio na amũtuĩre ciira.”<verse eid="1CH 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 12:18"/>Hĩndĩ ĩyo Roho agĩikũrũkĩra Amasai, mũnene wa arĩa Mĩrongo Ĩtatũ, akiuga atĩrĩ:</para>
  <para style="q1" vid="1CH 12:18">“Tũrĩ aku, wee Daudi!</para>
  <para style="q2" vid="1CH 12:18">Tũrĩ hamwe nawe, wee mũrũ wa Jesii!</para>
  <para style="q1" vid="1CH 12:18">Ũrogaacĩra, ũgaacĩre ki,</para>
  <para style="q2" vid="1CH 12:18">na arĩa magũteithagia marogaacĩra,</para>
  <para style="q3" vid="1CH 12:18">nĩgũkorwo Ngai waku nĩegũgũteithia.”</para>
  <para style="p" vid="1CH 12:18">Nĩ ũndũ ũcio Daudi akĩmaamũkĩra na akĩmatua atongoria a mbũtũ ciake cia gũtharĩkĩra thũ.<verse eid="1CH 12:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 12:19"/>Andũ amwe a Manase nĩmagarũrũkire magĩthiĩ mwena wa Daudi rĩrĩa aathiire na Afilisti kũhũũrana na Saũlũ. (Daudi na andũ ake matiateithirie Afilisti, tondũ thuutha wa kwaranĩria, aathani ao nĩmamũingatire. Maamwĩrire atĩrĩ, “Tũkaarĩha na mĩoyo iitũ angĩgatũtiganĩria acookerere mwathi wake Saũlũ.”) <verse eid="1CH 12:19"/><verse number="20" style="v" sid="1CH 12:20"/>Hĩndĩ ĩrĩa Daudi aathiire Zikilagi, aya nĩo andũ a Manase arĩa maagarũrũkire magĩthiĩ mwena wake: Adina, na Jozabadu, na Jediaeli, na Mikaeli, na Jozabadu, na Elihu, na Zilethai, atongoria a ikundi cia ngiri kũu Manase. <verse eid="1CH 12:20"/><verse number="21" style="v" sid="1CH 12:21"/>Nĩmateithirie Daudi kuuma kũrĩ mbũtũ iria ciamũtharĩkĩire, nĩgũkorwo othe maarĩ njamba cia ita irĩ ũrũme, na maarĩ anene a ita ciake. <verse eid="1CH 12:21"/><verse number="22" style="v" sid="1CH 12:22"/>Mũthenya o mũthenya andũ nĩmookaga gũteithia Daudi, o nginya akĩgĩa na mbũtũ nene, o ta mbũtũ ya Ngai.<verse eid="1CH 12:22"/></para>
  <para style="s1">Andũ arĩa angĩ Maanyiitaniĩre na Daudi kũu Hebironi</para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 12:23"/>Ũyũ nĩguo mũigana wa andũ arĩa meehaarĩirie gũthiĩ mbaara arĩa maathiire Hebironi kũrĩ Daudi nĩgeetha magarũre ũthamaki wa Saũlũ, maũnengere Daudi, o ta ũrĩa Jehova oigĩte:<verse eid="1CH 12:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 12:24"/>andũ a Juda arĩa meehaarĩirie kũrũa mbaara maakuĩte ngo na matimũ, maarĩ 6,800;<verse eid="1CH 12:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 12:25"/>andũ a Simeoni arĩa njamba cia ita meehaarĩirie kũrũa mbaara, maarĩ 7,100;<verse eid="1CH 12:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 12:26"/>andũ a Alawii maarĩ 4,600; <verse eid="1CH 12:26"/><verse number="27" style="v" sid="1CH 12:27"/>amwe ao maarĩ Jehoiada, mũtongoria wa nyũmba ya Harũni ũrĩa warĩ na andũ 3,700, <verse eid="1CH 12:27"/><verse number="28" style="v" sid="1CH 12:28"/>na Zadoku, mwanake mũnini warĩ njamba ya ita ĩrĩ ũrũme, ũrĩa warĩ na anene a thigari mĩrongo ĩĩrĩ na eerĩ kuuma nyũmba yake;<verse eid="1CH 12:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 12:29"/>andũ a Benjamini, na nĩo maarĩ a mbarĩ ĩmwe na Saũlũ, maarĩ 3,000; aingĩ ao maatũũrĩte maathĩkagĩra nyũmba ya Saũlũ, o nginya hĩndĩ ĩyo;<verse eid="1CH 12:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 12:30"/>andũ a Efiraimu, njamba cia ita irĩ ũrũme na irĩ ngumo mĩhĩrĩga-inĩ yao, maarĩ 20,800;<verse eid="1CH 12:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 12:31"/>andũ a nuthu ya mũhĩrĩga wa Manase, arĩa maagwetetwo na marĩĩtwa nĩguo mathiĩ matue Daudi mũthamaki, maarĩ 18,000;<verse eid="1CH 12:31"/></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 12:32"/>andũ a Isakaru, arĩa maarĩ na ũmenyo wa mahinda, na makamenya ũrĩa Isiraeli magĩrĩirwo nĩ gwĩka, maarĩ anene 200 arĩa maathaga andũ othe a nyũmba ciao;<verse eid="1CH 12:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 12:33"/>andũ a Zebuluni, thigari iria ciamenyerete mbaara, na nĩmehaarĩirie kũrũa mbaara me na mĩthemba yothe ya indo cia mbaara, nĩguo mateithie Daudi marĩ na ngoro ĩmwe, nao maarĩ 50,000;<verse eid="1CH 12:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 12:34"/>andũ a Nafitali maarĩ anene 1,000 hamwe na andũ 37,000 arĩa makuuĩte ngo na matimũ;<verse eid="1CH 12:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 12:35"/>andũ a Dani arĩa mehaarĩirie kũrũa mbaara, maarĩ 28,600;<verse eid="1CH 12:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 12:36"/>andũ a Asheri, thigari iria ciamenyerete mbaara na mehaarĩirie kũrũa mbaara, maarĩ 40,000;<verse eid="1CH 12:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 12:37"/>na kuuma mwena wa irathĩro wa Jorodani, andũ a Rubeni, na Gadi, na nuthu ya mũhĩrĩga wa Manase, marĩ na mĩthemba yothe ya indo cia mbaara, maarĩ 120,000.<verse eid="1CH 12:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="1CH 12:38"/>Acio othe maarĩ andũ a kũrũa arĩa meerutĩte gũtungata marĩ ita-inĩ. Magĩũka Hebironi marĩ na ngoro ĩmwe ya gũtua Daudi mũthamaki wa Isiraeli guothe. Andũ a Isiraeli arĩa angĩ othe o nao maarĩ na rĩciiria o rĩmwe rĩa gũtua Daudi mũthamaki. <verse eid="1CH 12:38"/><verse number="39" style="v" sid="1CH 12:39"/>Andũ acio maikarire kũu na Daudi mĩthenya ĩtatũ makĩrĩa na makĩnyua, nĩgũkorwo andũ a nyũmba ciao nĩmaheanĩte irio nĩ ũndũ wao. <verse eid="1CH 12:39"/><verse number="40" style="v" sid="1CH 12:40"/>O na ningĩ andũ arĩa maatũũraga hakuhĩ nao kuuma Isakaru, na Zebuluni, na Nafitali nĩmarehire irio ikuuĩtwo nĩ ndigiri, na ngamĩĩra, na nyũmbũ, na ndegwa. Nĩ kwarehetwo mũtu mũingĩ, na ngũmba cia ngũyũ na cia thabibũ nyũmũ, na ndibei, na maguta, na ngʼombe, na ngʼondu, nĩgũkorwo kwarĩ na gĩkeno kũu Isiraeli.<verse eid="1CH 12:40"/></para>
  <chapter eid="1CH 12"/>
  <chapter number="13" style="c" sid="1CH 13"/>
  <para style="s1">Gũcookia Ithandũkũ rĩa Kĩrĩkanĩro</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 13:1"/>Daudi nĩmagĩire ndundu na anene ake a ita, arĩa maathaga ikundi cia thigari ngiri na ikundi cia thigari igana. <verse eid="1CH 13:1"/><verse number="2" style="v" sid="1CH 13:2"/>Ningĩ agĩcooka akĩĩra kĩũngano gĩothe gĩa Isiraeli atĩrĩ, “Mũngĩona kwagĩrĩire na angĩkorwo nĩ kwenda kwa Jehova Ngai witũ, nĩ tũtũme ũhoro kũndũ na kũndũ kũrĩ ariũ a ithe witũ arĩa angĩ marĩ kũndũ guothe ngʼongo-inĩ cia Isiraeli, o na kũrĩ athĩnjĩri-Ngai na Alawii arĩa me hamwe nao matũũra-inĩ mao na ũrĩithio-inĩ wao, moke manyiitanĩre na ithuĩ. <verse eid="1CH 13:2"/><verse number="3" style="v" sid="1CH 13:3"/>Nĩtũrehei ithandũkũ rĩa kĩrĩkanĩro rĩa Ngai witũ tũrĩcookie kũrĩ ithuĩ, nĩgũkorwo tũtiatuĩragia ũhoro harĩ rĩo hĩndĩ ya ũthamaki wa Saũlũ.” <verse eid="1CH 13:3"/><verse number="4" style="v" sid="1CH 13:4"/>Kĩũngano gĩothe gĩgĩtĩkĩra gwĩka ũguo tondũ andũ othe nĩmoonire ũndũ ũcio nĩwagĩrĩire.<verse eid="1CH 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 13:5"/>Nĩ ũndũ ũcio Daudi agĩcookanĩrĩria andũ a Isiraeli othe kuuma Rũũĩ rwa Shihoru kũu Misiri nginya Lebo-Hamathu, makagĩĩre ithandũkũ rĩa Ngai kuuma Kiriathu-Jearimu. <verse eid="1CH 13:5"/><verse number="6" style="v" sid="1CH 13:6"/>Daudi na andũ a Isiraeli othe arĩa maarĩ nake magĩthiĩ Baala kũu Juda (nĩkuo Kiriathu-Jearimu) makagĩĩre ithandũkũ rĩa Jehova Ngai ũrĩa ũikarĩire gĩtĩ kĩa ũnene gatagatĩ ka makerubi, o ithandũkũ rĩu rĩĩtanĩtio na Rĩĩtwa rĩake.<verse eid="1CH 13:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 13:7"/>Makĩruta ithandũkũ rĩa Ngai kuuma nyũmba ya Abinadabu rĩkuuĩtwo na ikaari rĩerũ, rĩtongoretio nĩ Uza na Ahio. <verse eid="1CH 13:7"/><verse number="8" style="v" sid="1CH 13:8"/>Daudi na andũ a Isiraeli othe magĩkũngũĩra na hinya wao wothe marĩ mbere ya Ngai, makĩinaga na inanda cia mũgeeto na cia kĩnũbi, na tũhembe, na thaani iria ihũũrithanagio ikagamba, na tũrumbeta.<verse eid="1CH 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 13:9"/>Hĩndĩ ĩrĩa maakinyire kĩhuhĩro-inĩ kĩa ngano gĩa Kidoni, Uza agĩtambũrũkia guoko nĩguo anyiitĩrĩre ithandũkũ rĩu rĩa kĩrĩkanĩro, tondũ ndegwa nĩciahĩngirwo. <verse eid="1CH 13:9"/><verse number="10" style="v" sid="1CH 13:10"/>Na rĩrĩ, marakara ma Jehova nĩmakanĩire Uza, akĩmũgũtha, akĩgũa tondũ nĩanyiitire ithandũkũ rĩu na guoko. Nĩ ũndũ ũcio Uza agĩkuĩra o hau mbere ya Ngai.<verse eid="1CH 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 13:11"/>Nake Daudi akĩrakara tondũ mangʼũrĩ ma Jehova nĩmookĩrĩire Uza, nĩ ũndũ ũcio handũ hau hetagwo Perezu-Uza nginya ũmũthĩ.<verse eid="1CH 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 13:12"/>Daudi agĩĩtigĩra Ngai mũthenya ũcio, akĩũria atĩrĩ, “Ngaahota atĩa kũrehe ithandũkũ rĩĩrĩ rĩa Ngai kũrĩ niĩ?” <verse eid="1CH 13:12"/><verse number="13" style="v" sid="1CH 13:13"/>Tondũ ũcio Daudi ndaathiire na ithandũkũ rĩu Itũũra-inĩ Inene rĩa Daudi. Handũ ha ũguo, aarĩtwarire kwa Obedi-Edomu ũrĩa Mũgiiti. <verse eid="1CH 13:13"/><verse number="14" style="v" sid="1CH 13:14"/>Ithandũkũ rĩu rĩa Ngai rĩaikarire na andũ a nyũmba ya Obedi-Edomu gwake mũciĩ mĩeri ĩtatũ, nake Jehova akĩrathima andũ a mũciĩ wake, o na kĩrĩa gĩothe aarĩ nakĩo.<verse eid="1CH 13:14"/></para>
  <chapter eid="1CH 13"/>
  <chapter number="14" style="c" sid="1CH 14"/>
  <para style="s1">Nyũmba ya Daudi na Andũ Ake</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 14:1"/>Na rĩrĩ, Hiramu mũthamaki wa Turo, nĩatũmĩire Daudi andũ, marĩ na mĩgogo ya mĩtarakwa, na aaki a mahiga na a mbaũ, nĩguo mamwakĩre nyũmba ya ũthamaki. <verse eid="1CH 14:1"/><verse number="2" style="v" sid="1CH 14:2"/>Nake Daudi nĩamenyire atĩ Jehova nĩamũhaandĩte atuĩke mũthamaki wa Isiraeli, na atĩ ũthamaki wake nĩwatũũgĩrĩtio mũno nĩ ũndũ wa andũ ake a Isiraeli.<verse eid="1CH 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 14:3"/>Daudi nĩahikirie atumia angĩ arĩ kũu Jerusalemu, nake agĩtuĩka ithe wa aanake na airĩtu angĩ. <verse eid="1CH 14:3"/><verse number="4" style="v" sid="1CH 14:4"/>Maya nĩmo marĩĩtwa ma ciana ciake iria ciaciarĩirwo kũu: Shamua, na Shobabu, na Nathani, na Solomoni, <verse eid="1CH 14:4"/><verse number="5" style="v" sid="1CH 14:5"/>na Ibiharu, na Elishua, na Elipeleti, <verse eid="1CH 14:5"/><verse number="6" style="v" sid="1CH 14:6"/>na Noga, na Nefegu, na Jafia, <verse eid="1CH 14:6"/><verse number="7" style="v" sid="1CH 14:7"/>na Elishama, na Beeliada, na Elifeleti.<verse eid="1CH 14:7"/></para>
  <para style="s1">Daudi Kũhoota Afilisti</para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 14:8"/>Na rĩrĩa Afilisti maaiguire atĩ Daudi nĩaitĩrĩirio maguta agatuĩka mũthamaki wa Isiraeli guothe-rĩ, makĩambata, magĩthiĩ na mbũtũ ciao ciothe makamũcarie, nake Daudi aigua ũhoro ũcio akiumagara, agĩthiĩ akahũũrane nao. <verse eid="1CH 14:8"/><verse number="9" style="v" sid="1CH 14:9"/>Na rĩrĩ, Afilisti nĩmookĩte magatharĩkĩra Gĩtuamba kĩa Refaimu; <verse eid="1CH 14:9"/><verse number="10" style="v" sid="1CH 14:10"/>nĩ ũndũ ũcio Daudi agĩtuĩria ũhoro kũrĩ Ngai, akĩmũũria atĩrĩ, “Thiĩ ngatharĩkĩre Afilisti? Nĩũkũmaneana moko-inĩ makwa?”</para>
  <para style="p" vid="1CH 14:10">Nake Jehova akĩmũcookeria atĩrĩ, “Thiĩ, nĩngũmaneana moko-inĩ maku.”<verse eid="1CH 14:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 14:11"/>Nĩ ũndũ ũcio Daudi na andũ ake makĩambata, magĩthiĩ nginya Baali-Perazimu, na akĩmatooreria kuo. Nake akiuga atĩrĩ, “O ta ũrĩa maaĩ moinaga, noguo Ngai aharaganĩtie thũ ciakwa na guoko gwakwa.” Nĩ ũndũ ũcio handũ hau hagĩĩtwo Baali-Perazimu. <verse eid="1CH 14:11"/><verse number="12" style="v" sid="1CH 14:12"/>Afilisti magĩtiganĩria ngai ciao kũu, nake Daudi agĩathana ngai icio icinwo na mwaki.<verse eid="1CH 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 14:13"/>Afilisti nĩmatharĩkĩire Gĩtuamba kĩu rĩngĩ; <verse eid="1CH 14:13"/><verse number="14" style="v" sid="1CH 14:14"/>nĩ ũndũ ũcio Daudi agĩtuĩria ũhoro harĩ Ngai rĩngĩ, nake Ngai akĩmũcookeria atĩrĩ, “Tiga kwambata, no mathiũrũrũkĩrie, na ũmatharĩkĩre ũmarutĩtie na mbere ya mĩtĩ ya mĩkũngũgũ. <verse eid="1CH 14:14"/><verse number="15" style="v" sid="1CH 14:15"/>Rĩrĩa ũrĩigua mũkubio uumĩte igũrũ rĩa mĩtĩ ĩyo ya mĩkũngũgũ-rĩ, thiĩ ũkarũe, tondũ ũguo nĩkuonania atĩ Ngai arĩ mbere yaku akĩhũũra ita rĩa Afilisti.” <verse eid="1CH 14:15"/><verse number="16" style="v" sid="1CH 14:16"/>Nĩ ũndũ ũcio Daudi agĩĩka o ta ũrĩa Ngai aamwathĩte, nao makĩhũũra mbũtũ cia Afilisti, o kuuma Gibeoni nginya Gezeri.<verse eid="1CH 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 14:17"/>Nĩ ũndũ ũcio ngumo ya Daudi ĩkĩhunja o bũrũri o bũrũri, nake Jehova agĩtũma ndũrĩrĩ ciothe imwĩtigĩre.<verse eid="1CH 14:17"/></para>
  <chapter eid="1CH 14"/>
  <chapter number="15" style="c" sid="1CH 15"/>
  <para style="s1">Ithandũkũ rĩa Kĩrĩkanĩro Kũrehwo Jerusalemu</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 15:1"/>Daudi aarĩkia gwaka nyũmba ciake mwene kũu Itũũra Inene rĩa Daudi, nĩahaarĩirie handũ ha kũiga ithandũkũ rĩa Ngai, na akĩrĩambĩra hema. <verse eid="1CH 15:1"/><verse number="2" style="v" sid="1CH 15:2"/>Ningĩ Daudi akiuga atĩrĩ, “Gũtirĩ mũndũ ũngĩ wagĩrĩirwo nĩ gũkuua ithandũkũ rĩa Ngai tiga o Alawii, tondũ nĩo Jehova aathuurire makuuage ithandũkũ rĩu rĩa Jehova na mamũtungatagĩre nginya tene.”<verse eid="1CH 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 15:3"/>Daudi nĩacookanĩrĩirie andũ othe a Isiraeli hamwe kũu Jerusalemu nĩguo marehe ithandũkũ rĩa Jehova handũ harĩa aarĩthondekeire. <verse eid="1CH 15:3"/><verse number="4" style="v" sid="1CH 15:4"/>Nĩacookanĩrĩirie njiaro cia Harũni na Alawii ta ũũ:<verse eid="1CH 15:4"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 15:5"/>Kuuma kũrĩ njiaro cia Kohathu,</para>
  <para style="li2" vid="1CH 15:5">Urieli nĩwe warĩ mũtongoria, na andũ a nyũmba yao 120;<verse eid="1CH 15:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 15:6"/>kuuma kũrĩ njiaro cia Merari,</para>
  <para style="li2" vid="1CH 15:6">Asaia nĩwe warĩ mũtongoria, na andũ a nyũmba yao 220;<verse eid="1CH 15:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 15:7"/>kuuma kũrĩ njiaro cia Gerishoni,</para>
  <para style="li2" vid="1CH 15:7">Joeli nĩwe warĩ mũtongoria, na andũ a nyũmba yao 130;<verse eid="1CH 15:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 15:8"/>kuuma kũrĩ njiaro cia Elizafani,</para>
  <para style="li2" vid="1CH 15:8">Shemaia nĩwe warĩ mũtongoria, na andũ a nyũmba yao 200;<verse eid="1CH 15:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 15:9"/>kuuma kũrĩ njiaro cia Hebironi,</para>
  <para style="li2" vid="1CH 15:9">Elieli nĩwe warĩ mũtongoria, na andũ a nyũmba yao 80;<verse eid="1CH 15:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 15:10"/>kuuma kũrĩ njiaro cia Uzieli,</para>
  <para style="li2" vid="1CH 15:10">Aminadabu nĩwe warĩ mũtongoria, na andũ a nyũmba yao 112.<verse eid="1CH 15:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 15:11"/>Ningĩ Daudi agĩĩta Zadoku na Abiatharu arĩa athĩnjĩri-Ngai, na Urieli, na Asaia, na Joeli, na Shemaia, na Elieli, na Aminadabu arĩa Alawii. <verse eid="1CH 15:11"/><verse number="12" style="v" sid="1CH 15:12"/>Akĩmeera atĩrĩ, “Nĩ inyuĩ anene a nyũmba cia Alawii; inyuĩ ene na Alawii arĩa angĩ no nginya mwĩtherie na mwambatie ithandũkũ rĩa Jehova Ngai wa Isiraeli nginya handũ harĩa ndĩrĩthondekeire. <verse eid="1CH 15:12"/><verse number="13" style="v" sid="1CH 15:13"/>Nĩ ũndũ inyuĩ, Alawii, mũtiarĩambatirie ihinda rĩa mbere, nĩkĩo Jehova Ngai witũ aatũũkĩrĩire na marakara. Tũtiigana gũtuĩria ũhoro wa ũrĩa tũngĩekire kũrĩ we, kũringana na ũrĩa gwatuĩtwo.” <verse eid="1CH 15:13"/><verse number="14" style="v" sid="1CH 15:14"/>Nĩ ũndũ ũcio, athĩnjĩri-Ngai na Alawii magĩĩtheria nĩgeetha maambatie ithandũkũ rĩa Jehova, Ngai wa Isiraeli. <verse eid="1CH 15:14"/><verse number="15" style="v" sid="1CH 15:15"/>Nao Alawii magĩkuua ithandũkũ rĩa Ngai na mĩtĩ mĩraaya mamĩigĩrĩire ciande, o ta ũrĩa Musa aathanĩte kũringana na kiugo kĩa Jehova.<verse eid="1CH 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 15:16"/>Daudi akĩĩra atongoria a Alawii mathuure ariũ a ithe wao matuĩke aini, nao maine nyĩmbo cia gĩkeno makĩhũũraga inanda cia kĩnũbi, na cia mũgeeto, na thaani iria ihũũrithanagio ikagamba.<verse eid="1CH 15:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 15:17"/>Nĩ ũndũ ũcio Alawii magĩthuura Hemani mũrũ wa Joeli; kuuma harĩ ariũ a ithe, na magĩthuura Asafu mũrũ wa Berekia; na kuuma harĩ ariũ a ithe Amerari magĩthuura Ethani mũrũ wa Kushaia; <verse eid="1CH 15:17"/><verse number="18" style="v" sid="1CH 15:18"/>na ningĩ hamwe nao magĩthuura ariũ a ithe matuĩke anini ao wathani-inĩ. nao nĩ: Zekaria, na Jaazieli, na Shemiramothu, na Jehieli, na Uni, na Eliabu, na Benaia, na Maaseia, na Matithia, na Elifelehu, na Mikineia, na Obedi-Edomu, na Jeieli, arĩa arangĩri ihingo.<verse eid="1CH 15:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 15:19"/>Hemani, na Asafu na Ethani maarĩ aini na maahũũrithanagia thaani cia gĩcango; <verse eid="1CH 15:19"/><verse number="20" style="v" sid="1CH 15:20"/>Zekaria, na Azieli, na Shemiramothu, na Jehieli, na Uni, na Eliabu, na Maaseia, na Benaia maarĩ a kũhũũra inanda cia kĩnũbi, kũringana na Alamothu. <verse eid="1CH 15:20"/><verse number="21" style="v" sid="1CH 15:21"/>Nake Matithia, na Elifelehu, na Mikineia, na Obedi-Edomu, na Jeieli, na Azazia maarĩ a kũhũũra inanda cia mũgeeto, matongoretie kũringana na Sheminithu (ũguo nĩ ta kuuga mũgambo ũkũruruma). <verse eid="1CH 15:21"/><verse number="22" style="v" sid="1CH 15:22"/>Kenania ũrĩa mũtongoria wa Alawii nĩwe warũgamĩrĩire ũini; ũcio nĩguo warĩ wĩra wake tondũ aarĩ na ũũgĩ wa guo.<verse eid="1CH 15:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 15:23"/>Berekia na Elikana nĩo maarĩ a kũrangĩra mĩrango nĩ ũndũ wa ithandũkũ rĩu. <verse eid="1CH 15:23"/><verse number="24" style="v" sid="1CH 15:24"/>Athĩnjĩri-Ngai, nĩo Shebania, na Joshafatu, na Nethaneli, na Amasai, na Zekaria, na Benaia, na Eliezeri maarĩ a kũhuha tũrumbeta mbere ya ithandũkũ rĩa Ngai. Obedi-Edomu na Jehia o nao maarĩ arangĩri a mĩrango nĩ ũndũ wa ithandũkũ rĩu.<verse eid="1CH 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 15:25"/>Nĩ ũndũ ũcio Daudi na athuuri a Isiraeli, na anene a ikundi cia ngiri, magĩthiĩ kwambatia ithandũkũ rĩa kĩrĩkanĩro kĩa Jehova kuuma nyũmba ya Obedi-Edomu makenete. <verse eid="1CH 15:25"/><verse number="26" style="v" sid="1CH 15:26"/>Tondũ Ngai nĩateithĩtie Alawii arĩa maakuuaga ithandũkũ rĩa kĩrĩkanĩro kĩa Jehova-rĩ, ndegwa mũgwanja na ndũrũme mũgwanja nĩciarutirwo igongona. <verse eid="1CH 15:26"/><verse number="27" style="v" sid="1CH 15:27"/>Hĩndĩ ĩyo Daudi eehumbĩte nguo ya igũrũ ndaaya ya gatani ĩrĩa njega, na noguo Alawii othe arĩa makuuĩte ithandũkũ rĩu mehumbĩte, o na aini na Kenania ũrĩa warĩ mũtongoria wa ũini. O na ningĩ Daudi nĩehumbĩte ebodi ya gatani. <verse eid="1CH 15:27"/><verse number="28" style="v" sid="1CH 15:28"/>Nĩ ũndũ ũcio andũ othe a Isiraeli makĩambatia ithandũkũ rĩa kĩrĩkanĩro kĩa Jehova makĩanagĩrĩra, makĩhuhaga macoro na tũrumbeta, na makĩhũũrithanagia thaani iria ihũũrithanagio na ikagamba, na makĩhũũraga inanda cia kĩnũbi na cia mũgeeto.<verse eid="1CH 15:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 15:29"/>Hĩndĩ ĩrĩa ithandũkũ rĩa kĩrĩkanĩro kĩa Jehova rĩatoonyaga Itũũra Inene rĩa Daudi-rĩ, Mikali mwarĩ wa Saũlũ nĩacũthĩrĩirie arĩ ndirica-inĩ. Na rĩrĩa onire Mũthamaki Daudi akĩina akĩrũgarũgaga, akĩmũnyarara ngoro-inĩ yake.<verse eid="1CH 15:29"/></para>
  <chapter eid="1CH 15"/>
  <chapter number="16" style="c" sid="1CH 16"/>
  <para style="p">
    <verse number="1" style="v" sid="1CH 16:1"/>Alawii makĩrehe ithandũkũ rĩa Ngai, makĩrĩtoonyia thĩinĩ wa hema ĩrĩa yaambĩtwo nĩ Daudi nĩ ũndũ warĩo, na makĩrutĩra Ngai maruta ma njino na maruta ma ũiguano. <verse eid="1CH 16:1"/><verse number="2" style="v" sid="1CH 16:2"/>Daudi aarĩkia kũruta maruta ma njino na maruta ma ũiguano-rĩ, akĩrathima andũ acio thĩinĩ wa rĩĩtwa rĩa Jehova. <verse eid="1CH 16:2"/><verse number="3" style="v" sid="1CH 16:3"/>Ningĩ akĩhe andũ a Isiraeli othe, arũme na andũ-a-nja o mũndũ mũgate, na gĩcunjĩ kĩa nyama, na ngũmba ya thabibũ nyũmũ.<verse eid="1CH 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 16:4"/>Nĩathuurire Alawii amwe matungatage mbere ya ithandũkũ rĩa Jehova, na mathaithanagĩre andũ, na macookagie ngaatho, na magoocage Jehova, Ngai wa Isiraeli, nao nĩo: <verse eid="1CH 16:4"/><verse number="5" style="v" sid="1CH 16:5"/>Asafu ũrĩa warĩ mũnene wao, na mũnini wake aarĩ Zekaria, agacookwo nĩ Jeieli, na Shemiramothu, na Jehieli, na Matithia, na Eliabu, na Benaia, na Obedi-Edomu, na Jeieli. Acio maarĩ a kũhũũraga inanda cia kĩnũbi na inanda cia mũgeeto, nake Asafu agambagie thaani iria ihũũrithanagio ikagamba, <verse eid="1CH 16:5"/><verse number="6" style="v" sid="1CH 16:6"/>nao athĩnjĩri-Ngai, Benaia na Jahazieli, maarĩ a kũhuha tũrumbeta hĩndĩ ciothe marĩ mbere ya ithandũkũ rĩa kĩrĩkanĩro kĩa Ngai.<verse eid="1CH 16:6"/></para>
  <para style="s1">Thaburi ya Daudi ya Gũcookia Ngaatho</para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 16:7"/>Mũthenya ũcio ũndũ wa mbere, ũrĩa Daudi eekire nĩ kũnengera Asafu na athiritũ ake thaburi ĩno ya gũcookeria Jehova ngaatho:<verse eid="1CH 16:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="1CH 16:8"/>Cookeriai Jehova ngaatho, kaĩrai rĩĩtwa rĩake;</para>
  <para style="q2" vid="1CH 16:8">menyithaniai ndũrĩrĩ-inĩ ũrĩa ekĩte.<verse eid="1CH 16:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="1CH 16:9"/>Mũinĩrei, mũmũinĩre mũkĩmũgoocaga,</para>
  <para style="q2" vid="1CH 16:9">mũheane ũhoro wa ciĩko ciake ciothe cia magegania.<verse eid="1CH 16:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="1CH 16:10"/>Mwĩrahei nĩ ũndũ wa rĩĩtwa rĩake itheru;</para>
  <para style="q2" vid="1CH 16:10">ngoro cia arĩa marongoragia Jehova nĩ ikene.<verse eid="1CH 16:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 16:11"/>Mathaai Jehova o na hinya wake;</para>
  <para style="q2" vid="1CH 16:11">mũmaathage ũthiũ wake hĩndĩ ciothe.<verse eid="1CH 16:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="1CH 16:12"/>Ririkanai magegania marĩa ekĩte,</para>
  <para style="q2" vid="1CH 16:12">na ciama ciake, na matuĩro ma ciira marĩa atuĩte,<verse eid="1CH 16:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 16:13"/>inyuĩ njiaro cia Isiraeli ndungata yake,</para>
  <para style="q2" vid="1CH 16:13">o inyuĩ ciana cia Jakubu, inyuĩ andũ ake arĩa athuurĩte.<verse eid="1CH 16:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="1CH 16:14"/>Jehova nĩwe Ngai witũ;</para>
  <para style="q2" vid="1CH 16:14">matuĩro make ma ciira marĩ thĩ yothe.<verse eid="1CH 16:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="1CH 16:15"/>Nĩaririkanaga kĩrĩkanĩro gĩake nginya tene,</para>
  <para style="q2" vid="1CH 16:15">nĩkĩo kiugo kĩrĩa aathanire, kĩrũmagĩrĩrwo nĩ njiarwa ngiri,<verse eid="1CH 16:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="1CH 16:16"/>kĩrĩkanĩro kĩrĩa aarĩkanĩire na Iburahĩmu,</para>
  <para style="q2" vid="1CH 16:16">na noguo mwĩhĩtwa ũrĩa eehĩtire harĩ Isaaka.<verse eid="1CH 16:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="1CH 16:17"/>Nĩagĩĩkĩrire hinya harĩ Jakubu kĩrĩ kĩrĩra gĩake kĩa watho wa kũrũmagĩrĩrwo,</para>
  <para style="q2" vid="1CH 16:17">agĩgĩĩkĩra hinya kũrĩ Isiraeli kĩrĩ kĩrĩkanĩro gĩa gũtũũra tene na tene, akiuga atĩrĩ:<verse eid="1CH 16:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="1CH 16:18"/>“Wee nĩwe ngaahe bũrũri wa Kaanani,</para>
  <para style="q2" vid="1CH 16:18">ũtuĩke igai rĩrĩa ũkaagaya.”<verse eid="1CH 16:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="1CH 16:19"/>Hĩndĩ ĩrĩa maarĩ o anini magĩtarwo,</para>
  <para style="q2" vid="1CH 16:19">o anini biũ, na maarĩ ageni kuo-rĩ,<verse eid="1CH 16:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="1CH 16:20"/>moorũũraga kuuma rũrĩrĩ rũmwe nginya rũrĩa rũngĩ,</para>
  <para style="q2" vid="1CH 16:20">na kuuma ũthamaki-inĩ ũmwe nginya ũrĩa ũngĩ.<verse eid="1CH 16:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="1CH 16:21"/>Ndarĩ mũndũ o na ũmwe etĩkĩririe amanyariire;</para>
  <para style="q2" vid="1CH 16:21">nĩarũithirie athamaki nĩ ũndũ wao, akĩmeera atĩrĩ:<verse eid="1CH 16:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="1CH 16:22"/>“Mũtikanahutie andũ arĩa akwa aitĩrĩrie maguta;</para>
  <para style="q2" vid="1CH 16:22">mũtikaneke anabii akwa ũũru.”<verse eid="1CH 16:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="1CH 16:23"/>Inĩrai Jehova, inyuĩ andũ a thĩ yothe;</para>
  <para style="q2" vid="1CH 16:23">mũhunjagie ũhonokio wake mũthenya o mũthenya.<verse eid="1CH 16:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="1CH 16:24"/>Umbũrai riiri wake kũrĩ ndũrĩrĩ,</para>
  <para style="q2" vid="1CH 16:24">mumbũre mawĩko make ma magegania kũrĩ andũ othe.<verse eid="1CH 16:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="1CH 16:25"/>Nĩgũkorwo Jehova nĩ mũnene, na nĩ wa kũgoocwo mũno;</para>
  <para style="q2" vid="1CH 16:25">nĩwe wa gwĩtigĩrwo gũkĩra ngai ciothe.<verse eid="1CH 16:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="1CH 16:26"/>Nĩgũkorwo ngai ciothe cia ndũrĩrĩ nĩ mĩhianano,</para>
  <para style="q2" vid="1CH 16:26">no Jehova nĩwe wombire igũrũ.<verse eid="1CH 16:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="1CH 16:27"/>Riiri na ũnene irĩ mbere yake;</para>
  <para style="q2" vid="1CH 16:27">hinya na gĩkeno itũũraga gwake.<verse eid="1CH 16:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="1CH 16:28"/>Tũũgĩriai Jehova, inyuĩ mĩhĩrĩga ya ndũrĩrĩ,</para>
  <para style="q2" vid="1CH 16:28">mũtũũgĩrie Jehova nĩ ũndũ wa riiri na hinya wake,<verse eid="1CH 16:28"/></para>
  <para style="q2">
    <verse number="29" style="v" sid="1CH 16:29"/>Tũũgĩriai Jehova, nĩ ũndũ wa riiri ũrĩa wagĩrĩire rĩĩtwa rĩake.</para>
  <para style="q1" vid="1CH 16:29">Mũreherei maruta na mũũke mbere yake;</para>
  <para style="q2" vid="1CH 16:29">mũhooe Jehova thĩinĩ wa riiri wa ũtheru wake.<verse eid="1CH 16:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="1CH 16:30"/>Inainai mũrĩ mbere yake, inyuĩ andũ a thĩ yothe!</para>
  <para style="q2" vid="1CH 16:30">Thĩ ĩhaandĩtwo ĩkarũma; ndĩngĩenyenyeka.<verse eid="1CH 16:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="1CH 16:31"/>Igũrũ nĩ rĩkene, thĩ nĩĩcanjamũke;</para>
  <para style="q2" vid="1CH 16:31">nakuo ndũrĩrĩ-inĩ nĩ kuugwo atĩrĩ, “Jehova nĩwe ũthamakaga!”<verse eid="1CH 16:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="1CH 16:32"/>Iria nĩ rĩrurume, na indo iria ciothe irĩ thĩinĩ warĩo;</para>
  <para style="q2" vid="1CH 16:32">mĩgũnda nĩĩkenerũrũke na indo iria ciothe irĩ thĩinĩ wayo!<verse eid="1CH 16:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="1CH 16:33"/>Hĩndĩ ĩyo mĩtĩ ya mĩtitũ nĩĩkaina;</para>
  <para style="q2" vid="1CH 16:33">ĩine nĩ gũkena ĩrĩ mbere ya Jehova,</para>
  <para style="q2" vid="1CH 16:33">nĩgũkorwo nĩarooka gũciirithia thĩ.<verse eid="1CH 16:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="1CH 16:34"/>Cookeriai Jehova ngaatho, nĩgũkorwo nĩ mwega;</para>
  <para style="q2" vid="1CH 16:34">wendo wake ũtũũraga nginya tene.<verse eid="1CH 16:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="1CH 16:35"/>Anĩrĩrai muuge atĩrĩ, “Tũhonokie, Wee Ngai Mũhonokia witũ;</para>
  <para style="q2" vid="1CH 16:35">tũcookanĩrĩrie na ũtũkũũre kuuma kũrĩ ndũrĩrĩ,</para>
  <para style="q1" vid="1CH 16:35">nĩguo tũcookagĩrie rĩĩtwa rĩaku itheru ngaatho,</para>
  <para style="q2" vid="1CH 16:35">nĩgeetha twĩrahage nĩ ũndũ wa ũgooci waku.”<verse eid="1CH 16:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="1CH 16:36"/>Jehova arogoocwo, o we Ngai wa Isiraeli,</para>
  <para style="q2" vid="1CH 16:36">kuuma tene na tene, nginya tene na tene.</para>
  <para style="m" vid="1CH 16:36">Nao andũ othe makiuga atĩrĩ, “Ameni” na “Goocai Jehova.”<verse eid="1CH 16:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="1CH 16:37"/>Daudi agĩtiga Asafu na athiritũ ake hau mbere ya ithandũkũ rĩa kĩrĩkanĩro kĩa Jehova nĩguo matungatage kuo hĩndĩ ciothe, kũringana na mabata ma o mũthenya. <verse eid="1CH 16:37"/><verse number="38" style="v" sid="1CH 16:38"/>O na ningĩ agĩtiga Obedi-Edomu na athiritũ ake mĩrongo ĩtandatũ na anana matungatage hamwe nao. Obedi-Edomu mũrũ wa Jeduthuni marĩ na Hosa maarĩ arangĩri a kĩhingo.<verse eid="1CH 16:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="1CH 16:39"/>Daudi agĩtiga Zadoku ũrĩa mũthĩnjĩri-Ngai hamwe na athĩnjĩri-Ngai arĩa angĩ hau mbere ya hema ĩrĩa nyamũre,<note caller="+" style="f"><char style="fr" closed="false">16:39 </char><char style="ft" closed="false">Gĩikaro kĩa Jehova no kĩo Hema ĩrĩa yaakĩtwo werũ-inĩ harĩa magongona maarutagĩrwo.</char></note> kũndũ kũrĩa gũtũũgĩru kũu Gibeoni, <verse eid="1CH 16:39"/><verse number="40" style="v" sid="1CH 16:40"/>nĩguo marutagĩre Jehova maruta ma njino kĩgongona-inĩ kĩa maruta ma njino hĩndĩ ciothe, rũciinĩ na hwaĩ-inĩ, kũringana na ũrĩa kwandĩkĩtwo watho-inĩ wa Jehova ũrĩa aaheete andũ a Isiraeli. <verse eid="1CH 16:40"/><verse number="41" style="v" sid="1CH 16:41"/>Arĩa maarĩ hamwe nao nĩ Hemani na Jeduthuni, na arĩa angĩ maarĩ athuure na makagwetwo na marĩĩtwa nĩgeetha macookagĩrie Jehova ngaatho, makiugaga atĩrĩ, “Tondũ wendo wake ũtũũraga nginya tene.” <verse eid="1CH 16:41"/><verse number="42" style="v" sid="1CH 16:42"/>Hemani na Jeduthuni nĩo meehokeirwo kũhuha tũrumbeta, na kũhũũrithania thaani iria ihũũrithanagio ikagamba, o na kũhũũraga inanda iria ingĩ cia kũina rwĩmbo rwamũre. Ariũ a Jeduthuni nĩo maaheirwo wĩra wa kũrangĩra kĩhingo.<verse eid="1CH 16:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="1CH 16:43"/>Hĩndĩ ĩyo andũ othe magĩthiĩ o mũndũ gwake mũciĩ, nake Daudi agĩcooka mũciĩ akarathime andũ a nyũmba yake.<verse eid="1CH 16:43"/></para>
  <chapter eid="1CH 16"/>
  <chapter number="17" style="c" sid="1CH 17"/>
  <para style="s1">Kĩĩranĩro kĩa Ngai kũrĩ Daudi</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 17:1"/>Thuutha wa Daudi gũikara nyũmba yake ya ũthamaki kwa ihinda, akĩĩra mũnabii Nathani atĩrĩ, “Niĩ njikaraga nyũmba ya ũthamaki yakĩtwo na mĩtarakwa, o rĩrĩa ithandũkũ rĩa kĩrĩkanĩro kĩa Jehova rĩigĩtwo hema-inĩ.”<verse eid="1CH 17:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 17:2"/>Nathani agĩcookeria Daudi atĩrĩ, “Ũndũ ũrĩa ũreciiria gwĩka-rĩ, wĩke, nĩgũkorwo Ngai arĩ hamwe nawe.” <verse eid="1CH 17:2"/><verse number="3" style="v" sid="1CH 17:3"/>Ũtukũ ũcio kiugo kĩa Ngai gĩgĩkinyĩra Nathani, akĩĩrwo atĩrĩ:<verse eid="1CH 17:3"/></para>
  <para style="b"/>
  <para style="pm">
    <verse number="4" style="v" sid="1CH 17:4"/>“Thiĩ ũkeere ndungata yakwa Daudi atĩrĩ, ‘Jehova ekuuga ũũ: Wee tiwe wa kũnjakĩra nyũmba ya gũtũũra. <verse eid="1CH 17:4"/><verse number="5" style="v" sid="1CH 17:5"/>Niĩ ndirĩ ndatũũra nyũmba kuuma mũthenya ũrĩa ndaarutire andũ a Isiraeli kuuma bũrũri wa Misiri nginya ũmũthĩ. Ndũũraga hema-inĩ, thaamaga kuuma handũ hamwe ngathiĩ harĩa hangĩ, ngoima gĩikaro kĩmwe ngathiĩ kĩrĩa kĩngĩ. <verse eid="1CH 17:5"/><verse number="6" style="v" sid="1CH 17:6"/>Kũrĩa guothe ndaanathiĩ na andũ a Isiraeli othe-rĩ, ndĩ ndooria mũtongoria o na ũmwe wa arĩa ndaathire marĩithagie andũ akwa atĩrĩ, “Mwagĩte kũnjakĩra nyũmba ya mĩtarakwa nĩkĩ?” ’<verse eid="1CH 17:6"/></para>
  <para style="pm">
    <verse number="7" style="v" sid="1CH 17:7"/>“Na rĩrĩ, ĩra ndungata yakwa Daudi atĩrĩ, ‘Jehova Mwene-Hinya-Wothe ekuuga ũũ: Ndaakũrutire rũũru-inĩ, ngĩgũtigithia kũrũmĩrĩra mahiũ nĩguo ũtuĩke mwathi wa andũ akwa a Isiraeli. <verse eid="1CH 17:7"/><verse number="8" style="v" sid="1CH 17:8"/>Nĩngoretwo nawe kũrĩa guothe wanathiĩ, na ngakwehereria thũ ciaku ciothe ikehera mbere yaku. Rĩu nĩngũtũma rĩĩtwa rĩaku rĩtuĩke inene o ta marĩĩtwa ma andũ arĩa anene mũno a thĩ. <verse eid="1CH 17:8"/><verse number="9" style="v" sid="1CH 17:9"/>Na nĩngaahe andũ akwa a Isiraeli handũ na ndĩmahaande wega nĩgeetha magĩe na mũciĩ wao kĩũmbe, na matigacooka gũthĩĩnĩka. Andũ aaganu matigacooka kũmahinyĩrĩria rĩngĩ, ta ũrĩa meekaga kĩambĩrĩria-inĩ <verse eid="1CH 17:9"/><verse number="10" style="v" sid="1CH 17:10"/>na matũire meekaga kuuma rĩrĩa ndathuurire atongoria a gũtongoragia andũ akwa a Isiraeli. O na nĩngatooria thũ cianyu ciothe.</para>
  <para style="pm" vid="1CH 17:10">“ ‘Na ningĩ ngũkwĩra atĩ Jehova we mwene nĩwe ũgũgwakĩra nyũmba: <verse eid="1CH 17:10"/><verse number="11" style="v" sid="1CH 17:11"/>Hĩndĩ ĩrĩa matukũ maku magaathira nawe ũthiĩ ũgatũũranie na maithe manyu, nĩngarũgamia mũndũ wa rũciaro rwaku athamake ithenya rĩaku, agaakorwo arĩ ũmwe wa ariũ aku, na nĩngahaanda ũthamaki wake. <verse eid="1CH 17:11"/><verse number="12" style="v" sid="1CH 17:12"/>Ũcio nĩwe ũkaanjakĩra nyũmba, na nĩngahaanda gĩtĩ gĩake kĩa ũnene nginya tene. <verse eid="1CH 17:12"/><verse number="13" style="v" sid="1CH 17:13"/>Nĩngatuĩka ithe, nake nĩagatuĩka mũrũ wakwa. Ndikeheria wendo wakwa harĩ we, ta ũrĩa ndehereirie ũrĩa warĩ mbere yaku. <verse eid="1CH 17:13"/><verse number="14" style="v" sid="1CH 17:14"/>Nĩngamũtua mwathi wa nyũmba yakwa na ũthamaki wakwa nginya tene; gĩtĩ gĩake kĩa ũnene gĩkehaanda nginya tene.’ ”<verse eid="1CH 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 17:15"/>Nathani akĩmenyithia Daudi ũhoro wa ũguũrio ũcio wothe.<verse eid="1CH 17:15"/></para>
  <para style="s1">Ihooya rĩa Daudi</para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 17:16"/>Nake Mũthamaki Daudi agĩtoonya, agĩikara thĩ mbere ya Jehova, akiuga atĩrĩ:</para>
  <para style="b" vid="1CH 17:16"/>
  <para style="pm" vid="1CH 17:16">“Niĩ ndĩkĩrĩ ũ, Wee Jehova Ngai, nayo nyũmba yakwa-rĩ, ĩkĩrĩ kĩ, atĩ nĩkĩo ũnginyĩtie nginya haha? <verse eid="1CH 17:16"/><verse number="17" style="v" sid="1CH 17:17"/>Na ta ũndũ ũcio ũrĩ o mũnini maitho-inĩ maku, Wee Ngai-rĩ, nĩwarĩtie ũhoro wa matukũ marĩa magooka makoniĩ nyũmba ya ndungata yaku. Na rĩu Wee Jehova Ngai, ũnyonete ta ndĩ mũndũ ũmwe wa arĩa atũũgĩrie mũno.<verse eid="1CH 17:17"/></para>
  <para style="pm">
    <verse number="18" style="v" sid="1CH 17:18"/>“Nĩ atĩa ũngĩ Daudi angĩkwĩra nĩ ũndũ wa gũtĩĩa ndungata yaku? Nĩgũkorwo nĩũũĩ ndungata yaku, Wee Jehova. <verse eid="1CH 17:18"/><verse number="19" style="v" sid="1CH 17:19"/>Nĩ ũndũ wa ndungata yaku na kũringana na wendo waku-rĩ, nĩwĩkĩte ũndũ ũyũ mũnene na ũgatũma ciĩranĩro ici nene imenyeke.<verse eid="1CH 17:19"/></para>
  <para style="pm">
    <verse number="20" style="v" sid="1CH 17:20"/>“Gũtirĩ ũngĩ ũhaana tawe, Wee Jehova, na gũtirĩ Ngai ũngĩ tiga Wee, o ta ũrĩa tũiguĩte na matũ maitũ. <verse eid="1CH 17:20"/><verse number="21" style="v" sid="1CH 17:21"/>Na nũũ ũhaana ta andũ aku a Isiraeli, rũrĩrĩ rũmwe gũkũ thĩ rũrĩa Ngai waruo aakũũrire rũtuĩke andũ ake, nĩgeetha wĩgĩĩre igweta, na wĩke maũndũ manene na ma magegania ma gwĩtigĩrwo, nĩ ũndũ wa kũingata ndũrĩrĩ ciehere mbere ya andũ aku arĩa wakũũrire kuuma bũrũri wa Misiri? <verse eid="1CH 17:21"/><verse number="22" style="v" sid="1CH 17:22"/>Watũmire andũ aku a Isiraeli matuĩke andũ aku mwene nginya tene, nawe, Wee Jehova, nĩũtuĩkĩte Ngai wao.<verse eid="1CH 17:22"/></para>
  <para style="pm">
    <verse number="23" style="v" sid="1CH 17:23"/>“Na rĩrĩ, Jehova, tũma kĩĩranĩro kĩrĩa weranĩire gĩkoniĩ ndungata yaku na nyũmba yake kĩrũme nginya tene. Na wĩke o ta ũguo wĩranĩire, <verse eid="1CH 17:23"/><verse number="24" style="v" sid="1CH 17:24"/>nĩgeetha kĩĩranĩro kĩu kĩĩhaande, narĩo rĩĩtwa rĩaku rĩnenehe nginya tene. Ningĩ andũ nĩmakoiga atĩrĩ, ‘Jehova Mwene-Hinya-Wothe, Ngai wa Isiraeli, nĩwe Ngai wa andũ a Isiraeli!’ Na nyũmba ya ndungata yaku Daudi nĩĩkehaanda mbere yaku.”<verse eid="1CH 17:24"/></para>
  <para style="pm">
    <verse number="25" style="v" sid="1CH 17:25"/>“Wee Ngai wakwa, nĩũguũrĩirie ndungata yaku atĩ nĩũkamĩakĩra nyũmba. Nĩ ũndũ ũcio ndungata yaku nĩĩgĩĩte na ũmĩrĩru wa gũkũhooya. <verse eid="1CH 17:25"/><verse number="26" style="v" sid="1CH 17:26"/>Wee Jehova, nĩwe Ngai! Nĩwĩrĩire ndungata yaku maũndũ maya mega. <verse eid="1CH 17:26"/><verse number="27" style="v" sid="1CH 17:27"/>Rĩu nĩwonete kwagĩrĩire ũrathime nyũmba ya ndungata yaku, nĩgeetha ĩtũũre nginya tene maitho-inĩ maku; nĩgũkorwo, Wee Jehova nĩũmĩrathimĩte, na ĩgũtũũra ĩrĩ ndaathime nginya tene.”<verse eid="1CH 17:27"/></para>
  <chapter eid="1CH 17"/>
  <chapter number="18" style="c" sid="1CH 18"/>
  <para style="s1">Ũhootani wa Daudi</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 18:1"/>Thuutha wa mahinda macio, Daudi nĩatharĩkĩire Afilisti na akĩmatooria biũ, na agĩtunyana Gathu na matũũra marĩa maarĩrigiicĩirie kuuma watho-inĩ wa Afilisti.<verse eid="1CH 18:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 18:2"/>O na ningĩ Daudi nĩahootire andũ a Moabi, na magĩtuĩka a gwathwo nĩwe, makamũrutagĩra igooti.<verse eid="1CH 18:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 18:3"/>Ningĩ Daudi nĩahũũranire na Hadadezeri mũthamaki wa Zoba, akĩmũingata akĩmũkinyia Hamathu, rĩrĩa mũthamaki ũcio aathiiaga gũtũma wathani wake ũrũme wega ndwere-inĩ cia Rũũĩ rwa Farati. <verse eid="1CH 18:3"/><verse number="4" style="v" sid="1CH 18:4"/>Daudi akĩmũtunya ngaari ciake cia ita ngiri ĩmwe, na andũ a gũcitwara ngiri mũgwanja, na thigari cia magũrũ ngiri mĩrongo ĩĩrĩ. Nake agĩtemenga mbarathi icio cia mbaara magũrũ, agĩcithuithia ciothe tiga o igana rĩmwe.<verse eid="1CH 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 18:5"/>Rĩrĩa Asuriata a kuuma Dameski mookire gũteithia Hadadezeri mũthamaki wa Zoba, Daudi akĩũraga Asuriata 22,000. <verse eid="1CH 18:5"/><verse number="6" style="v" sid="1CH 18:6"/>Akĩiga mbũtũ ciake cia kũrangĩra ũthamaki wa Asuriata kũu Dameski, nao Asuriata magĩtuĩka a gwathagwo nĩwe na makamũrutagĩra igooti. Jehova nĩaheire Daudi ũhootani kũrĩa guothe aathiiaga.<verse eid="1CH 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 18:7"/>Daudi nĩatunyanire ngo cia thahabu iria ciarĩ na anene a Hadadezeri, na agĩcitwara Jerusalemu. <verse eid="1CH 18:7"/><verse number="8" style="v" sid="1CH 18:8"/>Kuuma matũũra ma Teba na Kuni marĩa maarĩ ma Hadadezeri, Daudi agĩtunyana gĩcango kĩingĩ mũno kĩrĩa Solomoni aahũthĩrire gũthondeka Karia ga gĩcango, na itugĩ, na mĩthemba mĩingĩ ya indo cia gĩcango.<verse eid="1CH 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 18:9"/>Rĩrĩa Tou, mũthamaki wa Hamathu, aiguire atĩ Daudi nĩahootete mbũtũ ciothe cia mbaara cia Hadadezeri mũthamaki wa Zoba-rĩ, <verse eid="1CH 18:9"/><verse number="10" style="v" sid="1CH 18:10"/>agĩtũma mũriũ Hadoramu kũrĩ Mũthamaki Daudi akamũgeithie na amũkũngũĩre nĩ ũndũ wa kũhoota Hadadezeri ũrĩa wakoretwo akĩrũa na Tou. Hadoramu agĩtwarĩra Daudi indo cia mĩthemba mĩingĩ ithondeketwo na thahabu na betha na gĩcango.<verse eid="1CH 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 18:11"/>Mũthamaki Daudi akĩamũrĩra Jehova indo icio o ta ũrĩa aamũrĩte betha na thahabu iria aatahĩte kuuma kũrĩ andũ a ndũrĩrĩ ici ciothe: Edomu, na Moabi, na kuuma kũrĩ Amoni na Afilisti, na Amaleki.<verse eid="1CH 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 18:12"/>Abishai mũrũ wa Zeruia nĩooragire andũ a Edomu 18,000 o kũu Gĩtuamba-inĩ gĩa Cumbĩ. <verse eid="1CH 18:12"/><verse number="13" style="v" sid="1CH 18:13"/>Nake akĩiga mbũtũ cia kũrangĩra kũu Edomu nao andũ a Edomu othe magĩtuĩka a gwathagwo nĩ Daudi. Jehova nĩaheire Daudi ũhootani kũrĩa guothe aathiiaga.<verse eid="1CH 18:13"/></para>
  <para style="s1">Ndungata cia Daudi</para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 18:14"/>Daudi nĩathamakire Isiraeli guothe, akahũthagĩra kĩhooto, na akahingĩria andũ ake othe maũndũ marĩa maagĩrĩire. <verse eid="1CH 18:14"/><verse number="15" style="v" sid="1CH 18:15"/>Joabu mũrũ wa Zeruia nĩwe warĩ mũnene wa ita, nake Jehoshafatu mũrũ wa Ahiludu nĩwe warĩ mwandĩki wa maũndũ ma ihinda rĩu. <verse eid="1CH 18:15"/><verse number="16" style="v" sid="1CH 18:16"/>Zadoku mũrũ wa Ahitubu, na Ahimeleku mũrũ wa Abiatharu maarĩ athĩnjĩri-Ngai, nake Shavisha nĩwe warĩ mwandĩki-marũa; <verse eid="1CH 18:16"/><verse number="17" style="v" sid="1CH 18:17"/>Benaia mũrũ wa Jehoiada nĩwe warĩ mũnene wa Akerethi na Apelethi; nao ariũ a Daudi nĩo maarĩ atongoria na anene a gũikaranagia na mũthamaki.<verse eid="1CH 18:17"/></para>
  <chapter eid="1CH 18"/>
  <chapter number="19" style="c" sid="1CH 19"/>
  <para style="s1">Mbaara ya Kũhũũrana na Aamoni</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 19:1"/>Thuutha wa mahinda macio-rĩ, Nahashu mũthamaki wa Aamoni agĩkua, nake mũriũ agĩtuĩka mũthamaki ithenya rĩake. <verse eid="1CH 19:1"/><verse number="2" style="v" sid="1CH 19:2"/>Nake Daudi agĩĩciiria atĩrĩ, “Nĩngwĩka Hanuni mũrũ wa Nahashu maũndũ mega ma ũtugi tondũ ithe nĩanjĩkire maũndũ mega ma ũtugi.” Nĩ ũndũ ũcio Daudi agĩtũma andũ kũrĩ Hanuni makamũcakaithie nĩ ũndũ wa gũkuĩrwo nĩ ithe.</para>
  <para style="p" vid="1CH 19:2">Rĩrĩa andũ acio maatũmĩtwo nĩ Daudi maakinyire kũrĩ Hanuni o kũu bũrũri wa Amoni nĩguo mamũcakaithie-rĩ, <verse eid="1CH 19:2"/><verse number="3" style="v" sid="1CH 19:3"/>andũ arĩa maarĩ igweta a Amoni makĩũria Hanuni atĩrĩ, “Ũreciiria Daudi nĩ thoguo aratĩĩa nĩ ũndũ wa gũgũtũmĩra andũ magũcakaithie? Githĩ andũ ake matiũkĩte kũrĩ we matuĩrie na mathigaane bũrũri nĩguo macooke maũtunyane?” <verse eid="1CH 19:3"/><verse number="4" style="v" sid="1CH 19:4"/>Nĩ ũndũ ũcio Hanuni akĩnyiitithia andũ acio a Daudi, akĩmenjithia nderu, nacio nguo ciao igĩtinio irima gatagatĩ ka njikarĩro, na akĩmaingata.<verse eid="1CH 19:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 19:5"/>Rĩrĩa mũndũ ũmwe aakinyĩirie Daudi ũhoro wa andũ acio-rĩ, Daudi agĩtũma andũ makamatũnge, tondũ andũ acio nĩmaconorithĩtio mũno. Mũthamaki akiuga atĩrĩ, “Ikarai kũu Jeriko nginya nderu cianyu ikũre, mũcooke mũũke.”<verse eid="1CH 19:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 19:6"/>Rĩrĩa andũ a Amoni maamenyire atĩ nĩmatuĩkĩte kĩndũ kĩnungu harĩ Daudi-rĩ, Hanuni na andũ a Amoni makĩneana betha taranda ngiri ĩmwe<note caller="+" style="f"><char style="fr" closed="false">19:6 </char><char style="ft" closed="false">nĩ ta tani 34</char></note> cia gũkombora ngaari cia ita na atwarithia a cio kuuma Mesopotamia, na Aramu-Maaka, na Zoba. <verse eid="1CH 19:6"/><verse number="7" style="v" sid="1CH 19:7"/>Magĩkombora ngaari cia ita ngiri mĩrongo ĩtatũ na igĩrĩ na atwarithia a cio, hamwe na mũthamaki wa Maaka na mbũtũ ciake, arĩa mookire makĩamba hema hakuhĩ na Medeba; hĩndĩ ĩyo andũ a Amoni nao magĩcookanĩrĩrio kuuma matũũra-inĩ mao, magĩthiĩ kũrũa mbaara.<verse eid="1CH 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 19:8"/>Nake Daudi aigua ũhoro ũcio-rĩ, agĩtũma Joabu na ita rĩothe rĩa mbaara. <verse eid="1CH 19:8"/><verse number="9" style="v" sid="1CH 19:9"/>Nao andũ a Amoni makiumagara, makĩarania mbũtũ cia mbaara kĩhingo-inĩ gĩa itũũra rĩao inene, nao athamaki arĩa mookĩte mbaara, magĩkorwo maarĩ oiki kũu werũ-inĩ.<verse eid="1CH 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 19:10"/>Joabu nĩonire atĩ thigari nĩciaranĩtio mbere yake o na thuutha wake; nĩ ũndũ ũcio agĩthuura mbũtũ imwe iria njega mũno kũu Isiraeli, agĩcitũma ikarũe na Asuriata. <verse eid="1CH 19:10"/><verse number="11" style="v" sid="1CH 19:11"/>Andũ acio angĩ akĩmaiga watho-inĩ wa Abishai mũrũ wa nyina. Nao akĩmatũma makarũe na andũ a Amoni. <verse eid="1CH 19:11"/><verse number="12" style="v" sid="1CH 19:12"/>Joabu akiuga atĩrĩ, “Asuriata mangĩngĩria hinya-rĩ, wee ũũke ũndeithie; no Aamoni mangĩgũkĩria hinya, nĩngagũteithia. <verse eid="1CH 19:12"/><verse number="13" style="v" sid="1CH 19:13"/>Wĩyũmĩrĩrie nĩgeetha tũrũe na ũcamba nĩ ũndũ wa andũ aitũ, na nĩ ũndũ wa matũũra manene ma Ngai witũ. Jehova nĩegwĩka ũrĩa ekuona kwagĩrĩire maitho-inĩ make.”<verse eid="1CH 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 19:14"/>Nake Joabu arĩ na mbũtũ ciake agĩtharĩkĩra Asuriata, nao makĩmũũrĩra. <verse eid="1CH 19:14"/><verse number="15" style="v" sid="1CH 19:15"/>Rĩrĩa Aamoni moonire atĩ Asuriata nĩmaroora-rĩ, o nao makĩũrĩra Abishai mũrũ wa nyina magĩtoonya itũũra thĩinĩ. Nĩ ũndũ ũcio Joabu agĩcooka Jerusalemu.<verse eid="1CH 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 19:16"/>Thuutha wa Asuriata kuona atĩ nĩmatoorio nĩ andũ a Isiraeli, magĩtũma andũ makarehithie Asuriata a kuuma mũrĩmo wa Rũũĩ rwa Farati matongoretio nĩ Shofaku ũrĩa warĩ mũnene wa mbũtũ cia ita cia Hadadezeri.<verse eid="1CH 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 19:17"/>Rĩrĩa Daudi eerirwo ũhoro ũcio, agĩcookanĩrĩria ita rĩa Isiraeli rĩothe, makĩringa Rũũĩ rwa Jorodani, nake akĩmakinyĩra na akĩiga mbũtũ ciake imangʼetheire. Daudi akĩhaarĩria mbũtũ ciake nĩguo itũngane na Asuriata acio mbaara-inĩ, nao Asuriata makĩrũa nake. <verse eid="1CH 19:17"/><verse number="18" style="v" sid="1CH 19:18"/>No rĩrĩ, Asuriata makĩũrĩra Isiraeli, nake Daudi akĩũraga atwarithia a ngaari ciao cia ita ngiri mũgwanja, na thigari ciao cia magũrũ ngiri mĩrongo ĩna. Ningĩ akĩũraga Shofaku, mũnene wa mbũtũ ciao.<verse eid="1CH 19:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 19:19"/>Hĩndĩ ĩrĩa ndungata cia Hadadezeri cionire atĩ nĩmahootwo nĩ Isiraeli-rĩ, magĩthondeka thayũ na Daudi, nao magĩtuĩka a gwathagwo nĩwe.</para>
  <para style="p" vid="1CH 19:19">Nĩ ũndũ ũcio Asuriata matiacookire gwĩtĩkĩra gũteithia Aamoni rĩngĩ.<verse eid="1CH 19:19"/></para>
  <chapter eid="1CH 19"/>
  <chapter number="20" style="c" sid="1CH 20"/>
  <para style="s1">Itũũra rĩa Raba Gũtunyanwo</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 20:1"/>Na rĩrĩ, hĩndĩ ya kĩmera yakinya, ihinda rĩrĩa athamaki maathiiaga mbaara, Joabu agĩtongoria mbũtũ cia ita. Nake akĩananga bũrũri wa Aamoni, na agĩthiĩ Raba akĩrĩrigiicĩria, no Daudi agĩtigwo Jerusalemu. Joabu agĩtharĩkĩra Raba agĩtiga aarĩananga. <verse eid="1CH 20:1"/><verse number="2" style="v" sid="1CH 20:2"/>Daudi akĩruta mũthamaki wao thũmbĩ mũtwe, nayo yarĩ na ũritũ wa taranda ĩmwe<note caller="+" style="f"><char style="fr" closed="false">20:2 </char><char style="ft" closed="false">nĩ ta kilo 34</char></note> ya thahabu, na nĩyagemetio na tũhiga twa goro, nayo ĩkĩigĩrĩrwo mũtwe wa Daudi. Nake agĩtaha indo nyingĩ mũno kuuma itũũra rĩu inene, <verse eid="1CH 20:2"/><verse number="3" style="v" sid="1CH 20:3"/>na akĩrutũrũra aikari akuo, akĩmahe wĩra wa gwatũra mbaũ na mĩthumeno, na kũruta wĩra na harũ cia igera na mathanwa. Ũguo nĩguo Daudi eekire matũũra mothe ma Amoni. Thuutha ũcio Daudi na mbũtũ ciake ciothe cia ita magĩcooka Jerusalemu.<verse eid="1CH 20:3"/></para>
  <para style="s1">Kũrũa na Afilisti</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 20:4"/>Mahinda macio-rĩ, gũkĩgĩa mbaara ya kũrũa na Afilisti kũu Gezeri. Hĩndĩ ĩyo Sibekai ũrĩa Mũhushathi akĩũraga Sipai, ũmwe wa njiaro cia Refai, nao Afilisti magĩtoorio biũ.<verse eid="1CH 20:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 20:5"/>Mbaara-inĩ ĩngĩ makĩrũa na Afilisti, nake Elihanani mũrũ wa Jairu akĩũraga Lahami mũrũ wa nyina na Goliathũ, ũrĩa Mũgiiti, ũrĩa warĩ na itimũ rĩarĩ na mũtĩ waiganaga ta mũtĩ wa mũtumi ngoora.<verse eid="1CH 20:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 20:6"/>Ningĩ mbaara-inĩ ĩngĩ ĩrĩa yarũĩirwo Gathu, kwarĩ na mũndũ mũnene mũno, warĩ na ciara ithathatũ o guoko, na ciara ithathatũ o kũgũrũ, ciothe ciarĩ ciara mĩrongo ĩĩrĩ na inya. O nake aarĩ wa rũciaro rwa Rafa. <verse eid="1CH 20:6"/><verse number="7" style="v" sid="1CH 20:7"/>Rĩrĩa aanyũrũririe andũ a Isiraeli, Jonathani mũrũ wa Shimea, mũrũ wa nyina na Daudi, akĩmũũraga.<verse eid="1CH 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 20:8"/>Acio nĩo maarĩ a rũciaro rwa Rafa wa kũu Gathu, nao makĩũragwo nĩ Daudi na andũ ake.<verse eid="1CH 20:8"/></para>
  <chapter eid="1CH 20"/>
  <chapter number="21" style="c" sid="1CH 21"/>
  <para style="s1">Daudi Gũtara Andũ a Mbaara</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 21:1"/>Na rĩrĩ, Shaitani nĩookĩrĩire andũ a Isiraeli, na akĩarahũra Daudi nĩguo atarithie andũ a Isiraeli. <verse eid="1CH 21:1"/><verse number="2" style="v" sid="1CH 21:2"/>Nĩ ũndũ ũcio Daudi akĩĩra Joabu na anene a mbũtũ cia ita atĩrĩ: “Thiĩi mũgatare andũ a Isiraeli kuuma Birishiba nginya Dani, mũcooke mũndehere ũhoro nĩguo menye ũrĩa maigana.”<verse eid="1CH 21:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 21:3"/>Nowe Joabu akĩmũcookeria atĩrĩ, “Jehova aroingĩhia mbũtũ ciake cia ita maita igana. Mwathi wakwa mũthamaki, githĩ othe matirĩ watho-inĩ waku? Nĩ kĩĩ gĩgũtũma mwathi wakwa ende gwĩka ũguo? Nĩ kĩĩ gĩgũtũma ahĩtithie Isiraeli?”<verse eid="1CH 21:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 21:4"/>No rĩrĩ, mũthamaki agĩkararia Joabu; nĩ ũndũ ũcio Joabu akiuma hau agĩthiĩ Isiraeli guothe, na agĩcooka Jerusalemu. <verse eid="1CH 21:4"/><verse number="5" style="v" sid="1CH 21:5"/>Joabu akĩmenyithia Daudi mũigana wa andũ arĩa maangĩarũire mbaara ta ũũ: Isiraeli guothe kwarĩ na andũ 1,100,000 arĩa maangĩahotire kũhũthĩra rũhiũ rwa njora, thĩinĩ wao haarĩ na andũ 470,000 kuuma Juda.<verse eid="1CH 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 21:6"/>No rĩrĩ, Joabu ndaatarire andũ a Lawi na a Benjamini, tondũ watho ũcio wa mũthamaki nĩwamũiguithĩtie ũũru mũno. <verse eid="1CH 21:6"/><verse number="7" style="v" sid="1CH 21:7"/>O na ningĩ watho ũcio warĩ mũũru maitho-inĩ ma Ngai; nĩ ũndũ ũcio akĩherithia Isiraeli.<verse eid="1CH 21:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 21:8"/>Hĩndĩ ĩyo Daudi akĩĩra Ngai atĩrĩ, “Nĩnjĩhĩtie mũno nĩ gwĩka ũndũ ũyũ. Rĩu ndagũthaitha ũnjehererie mahĩtia, niĩ ndungata yaku. Nĩnjĩkĩte ũndũ wa ũrimũ mũno.”<verse eid="1CH 21:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 21:9"/>Nake Jehova akĩĩra Gadi ũrĩa woonagĩra Daudi maũndũ atĩrĩ, <verse eid="1CH 21:9"/><verse number="10" style="v" sid="1CH 21:10"/>“Thiĩ ũkeere Daudi ũũ, ‘Jehova ekuuga atĩrĩ: Ũrĩ na maũndũ matatũ ma gũthuura. Nowe ũthuure ũmwe wamo ũrĩa ngũkũherithia naguo.’ ”<verse eid="1CH 21:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 21:11"/>Nĩ ũndũ ũcio Gadi agĩthiĩ kũrĩ Daudi, akĩmwĩra atĩrĩ, “Jehova ekuuga ũũ: ‘Thuura ũndũ ũmwe wa maya: <verse eid="1CH 21:11"/><verse number="12" style="v" sid="1CH 21:12"/>Ũthuure mĩaka ĩtatũ ya ngʼaragu, kana mĩeri ĩtatũ ya kũniinwo nĩ thũ ciaku igũthingatĩte na hiũ ciao cia njora, kana mĩthenya ĩtatũ ya rũhiũ rwa njora rwa Jehova, naguo nĩ atĩ kũgĩe na mĩthenya ya mũthiro bũrũri-inĩ, rĩrĩa mũraika wa Jehova akaaniinana Isiraeli guothe.’ Na rĩrĩ, tua itua ũnjĩĩre ũrĩa ngũthiĩ gũcookeria ũrĩa ũndũmĩte.”<verse eid="1CH 21:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 21:13"/>Daudi akĩĩra Gadi atĩrĩ, “Rĩu niĩ ndĩ na thĩĩna mũno. Nĩ kaba niĩ ngwe moko-inĩ ma Jehova, tondũ tha ciake nĩ nyingĩ mũno; no ndũkareke ngwe moko-inĩ ma andũ.”<verse eid="1CH 21:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 21:14"/>Nĩ ũndũ ũcio Jehova akĩrehera Isiraeli mũthiro, na andũ a Isiraeli 70,000 magĩkua. <verse eid="1CH 21:14"/><verse number="15" style="v" sid="1CH 21:15"/>Nake Ngai agĩtũma mũraika akanange Jerusalemu. No rĩrĩa mũraika ekaga ũguo-rĩ, Jehova akĩona ũndũ ũcio na akĩigua kĩeha nĩ ũndũ wa kĩnyariirĩko kĩu, nake akĩĩra mũraika ũcio wanangaga andũ atĩrĩ, “Tigĩra hau! Eheria guoko gwaku.” Hĩndĩ ĩyo mũraika ũcio wa Jehova aarũgamĩte kĩhuhĩro-inĩ kĩa ngano kĩa Arauna ũrĩa Mũjebusi.<verse eid="1CH 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 21:16"/>Nake Daudi akĩrora igũrũ akĩona mũraika wa Jehova arũngiĩ gatagatĩ ka igũrũ na thĩ acomorete rũhiũ rwa njora, arũnyiitĩte na guoko gwake gũtambũrũkĩirio Jerusalemu. Nake Daudi na athuuri, mehumbĩte nguo cia makũnia, makĩgũa magĩturumithia mothiũ mao thĩ.<verse eid="1CH 21:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 21:17"/>Daudi akĩũria Ngai atĩrĩ, “Githĩ ti niĩ ndaathanire atĩ arũi a mbaara matarwo? Niĩ nĩ niĩ njĩhĩtie o na ngeeka ũũru. Andũ aya matariĩ o ta ngʼondu. Nĩ atĩa mekĩte? Wee Jehova Ngai wakwa, reke guoko gwaku kũnjũkĩrĩre niĩ na nyũmba yakwa, no rĩrĩ, ndũkareke mũthiro ũyũ ũikare na andũ aku.”<verse eid="1CH 21:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 21:18"/>Nake mũraika wa Jehova agĩatha Gadi eere Daudi aambate athiĩ agaakĩre Jehova kĩgongona o kũu kĩhuhĩro-inĩ kĩa ngano kĩa Arauna ũrĩa Mũjebusi. <verse eid="1CH 21:18"/><verse number="19" style="v" sid="1CH 21:19"/>Nĩ ũndũ ũcio Daudi akĩambata agĩathĩkĩra kiugo kĩu Gadi aarĩtie thĩinĩ wa rĩĩtwa rĩa Jehova.<verse eid="1CH 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 21:20"/>Hĩndĩ ĩrĩa Arauna aakonyoraga ngano-rĩ, akĩĩhũgũra akĩona mũraika ũcio; nao ariũ ake ana arĩa maarĩ nake makĩĩhitha. <verse eid="1CH 21:20"/><verse number="21" style="v" sid="1CH 21:21"/>Nake Daudi agĩkuhĩrĩria, na rĩrĩa Arauna aarorire akĩmuona, akiuma kĩhuhĩro-inĩ kĩa ngano, akĩinamĩrĩria mũtwe wake mbere ya Daudi, na agĩturumithia ũthiũ thĩ.<verse eid="1CH 21:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 21:22"/>Daudi akĩmwĩra atĩrĩ, “Njĩtĩkĩria njakĩre Jehova kĩgongona haha kĩhuhĩro-inĩ gĩkĩ gĩaku kĩa ngano, nĩguo mũthiro ũyũ ũkorete andũ ũthire. Nyenderia o ũrĩa thogora wakĩo ũigana.”<verse eid="1CH 21:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 21:23"/>Arauna akĩĩra Daudi atĩrĩ, “Kĩoe! Reke mũthamaki mwathi wakwa eeke ũndũ ũrĩa ũngĩmũkenia. Na rĩrĩ, nĩngũkũhe ndegwa ici irutwo igongona rĩa njino, ihũũri ici cia ngano ituĩke ngũ, ngano nayo ĩtuĩke ya igongona rĩa mũtu. Icio ciothe nĩngũkũhe.”<verse eid="1CH 21:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 21:24"/>Nowe Mũthamaki Daudi agĩcookeria Arauna atĩrĩ, “Aca, no nginya ndĩhe thogora wakĩo ũrĩa ũigana. Ndingĩrutĩra Jehova kĩndũ gĩaku, kana ndute igongona rĩa njino na kĩndũ kĩrĩa itarutĩire thogora.”<verse eid="1CH 21:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 21:25"/>Nĩ ũndũ ũcio Daudi akĩrĩha Arauna cekeri magana matandatũ<note caller="+" style="f"><char style="fr" closed="false">21:25 </char><char style="ft" closed="false">nĩ ta kilo 7</char></note> cia thahabu nĩ ũndũ wa handũ hau. <verse eid="1CH 21:25"/><verse number="26" style="v" sid="1CH 21:26"/>Daudi agĩakĩra Jehova kĩgongona handũ hau, na akĩruta maruta ma njino na maruta ma ũiguano. Agĩkaĩra Jehova, nake Jehova akĩmwĩtĩka na njĩra ya mwaki uumĩte igũrũ, ũgĩakana kĩgongona-inĩ kĩu kĩa maruta ma njino.<verse eid="1CH 21:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 21:27"/>Ningĩ Jehova akĩarĩria mũraika ũcio nake agĩcookia rũhiũ rwake njora. <verse eid="1CH 21:27"/><verse number="28" style="v" sid="1CH 21:28"/>Hĩndĩ ĩyo, rĩrĩa Daudi onire atĩ Ngai nĩamũiguĩte arĩ kũu kĩhuhĩro-inĩ kĩa ngano kĩa Arauna ũcio Mũjebusi-rĩ, akĩrutĩra magongona hau. <verse eid="1CH 21:28"/><verse number="29" style="v" sid="1CH 21:29"/>Hema ya Jehova ĩrĩa nyamũre ĩrĩa Musa aathondekeire werũ-inĩ, na kĩgongona kĩa maruta ma njino, hĩndĩ ĩyo ciarĩ harĩa hatũũgĩru o kũu Gibeoni. <verse eid="1CH 21:29"/><verse number="30" style="v" sid="1CH 21:30"/>No rĩrĩ, Daudi ndangĩathiire mbere yakĩo gũtuĩria ũhoro harĩ Ngai tondũ nĩetigagĩra rũhiũ rwa njora rwa mũraika ũcio wa Jehova.<verse eid="1CH 21:30"/></para>
  <chapter eid="1CH 21"/>
  <chapter number="22" style="c" sid="1CH 22"/>
  <para style="p">
    <verse number="1" style="v" sid="1CH 22:1"/>Hĩndĩ ĩyo Daudi akiuga atĩrĩ, “Nyũmba ya Jehova Ngai ĩgaakwo haha, o na kĩgongona gĩa kũrutagĩrwo maruta ma njino nĩ Isiraeli.”<verse eid="1CH 22:1"/></para>
  <para style="s1">Kũhaarĩria Mwako wa Hekarũ</para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 22:2"/>Nĩ ũndũ ũcio Daudi agĩathana atĩ ageni othe arĩa maatũũraga Isiraeli<note caller="+" style="f"><char style="fr" closed="false">22:2 </char><char style="ft" closed="false">Ageni aya maarĩ njiaro cia andũ a Kaanani arĩa maatũũraga kuo mbere ya gũtoorio nĩ Aisiraeli.</char></note> macookanĩrĩrio, nake agĩthuura kuuma thĩinĩ wao mabundi a mahiga, nĩgeetha mahaarĩrie na maicũhie mahiga ma gwaka nyũmba ya Ngai. <verse eid="1CH 22:2"/><verse number="3" style="v" sid="1CH 22:3"/>Nake akĩruta igera nyingĩ cia gũthondeka mĩcumarĩ ya mĩrango ya ihingo na ya kũnyiitithania indo cia nyũmba thĩinĩ, na gĩcango kĩingĩ gĩtangĩthimĩka. <verse eid="1CH 22:3"/><verse number="4" style="v" sid="1CH 22:4"/>Ningĩ akĩruta mĩgogo ya mĩtarakwa ĩtangĩtarĩka, nĩgũkorwo andũ a Sidoni na a Turo nĩmareheire Daudi mĩgogo mĩingĩ.<verse eid="1CH 22:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 22:5"/>Daudi akiuga atĩrĩ, “Mũriũ wakwa Solomoni nĩ mwĩthĩ na ndarĩ na ũũgĩ wa kũigana, nayo nyũmba ĩrĩa ĩgwakĩrwo Jehova yagĩrĩirwo nĩgũkorwo ĩrĩ na ũthaka mũnene na ngumo na riiri maitho-inĩ ma ndũrĩrĩ ciothe. Nĩ ũndũ ũcio nĩ ngũhaarĩria mwako wayo.” Nĩ ũndũ ũcio Daudi akĩhaarĩria maũndũ ma mwako ũcio na njĩra nene atanakua.<verse eid="1CH 22:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 22:6"/>Ningĩ agĩĩta mũriũ Solomoni akĩmwatha aakĩre Jehova Ngai wa Isiraeli nyũmba. <verse eid="1CH 22:6"/><verse number="7" style="v" sid="1CH 22:7"/>Daudi akĩĩra Solomoni ũũ: “Mũrũ wakwa, ndũire nyendaga gwaka nyũmba ĩtanĩtio na rĩĩtwa rĩa Jehova Ngai wakwa. <verse eid="1CH 22:7"/><verse number="8" style="v" sid="1CH 22:8"/>No rĩrĩ, kiugo gĩkĩ kĩa Jehova gĩkĩnginyĩrĩra, ngĩĩrwo atĩrĩ, ‘Wee nĩũitĩte thakame nyingĩ na ũkarũa mbaara nyingĩ. Ndũgwaka nyũmba ĩtanĩtio na rĩĩtwa rĩakwa, nĩ ũndũ nĩũitithĩtie thakame nyingĩ gũkũ thĩ, maitho-inĩ makwa. <verse eid="1CH 22:8"/><verse number="9" style="v" sid="1CH 22:9"/>No nĩũkagĩa na mũriũ ũrĩa ũgaatuĩka mũndũ wa thayũ na wa kũhoorera, na nĩngamũhe ũhurũko kuuma kũrĩ thũ ciake mĩena yothe. Rĩĩtwa rĩake ageetwo Solomoni, na hĩndĩ ya ũthamaki wake nĩngaahe Isiraeli thayũ na ũhurũko. <verse eid="1CH 22:9"/><verse number="10" style="v" sid="1CH 22:10"/>Ũcio nĩwe ũgaaka nyũmba ĩtanĩtio na Rĩĩtwa rĩakwa. Agaatuĩka mũrũ wakwa, na niĩ nduĩke ithe. Ningĩ nĩngahaanda gĩtĩ kĩa ũnene wake kũu Isiraeli nginya tene.’<verse eid="1CH 22:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 22:11"/>“Na rĩrĩ, mũrũ wakwa, Jehova aroikara nawe, na ũrogaacĩra na wake nyũmba ya Jehova Ngai waku, ta ũrĩa oigire nĩũgeeka. <verse eid="1CH 22:11"/><verse number="12" style="v" sid="1CH 22:12"/>Jehova arokũhe ũbaarĩrĩri na ũmenyo rĩrĩa agaakũnengera ũthamaki wa Isiraeli, nĩgeetha ũrũmie watho wa Jehova Ngai waku. <verse eid="1CH 22:12"/><verse number="13" style="v" sid="1CH 22:13"/>Hĩndĩ ĩyo wee nĩũkagaacĩra, ũngĩgatuĩka wa kũmenyagĩrĩra kĩrĩra kĩa watho wake wa kũrũmĩrĩrwo o na watho ũrĩa Jehova aaheire Musa nĩ ũndũ wa Isiraeli. Gĩa na hinya na ũmĩrĩrie. Ndũgetigĩre kana ũkue ngoro.<verse eid="1CH 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 22:14"/>“Nĩndutĩte wĩra mũnene wa kũhaarĩria mwako wa hekarũ ya Jehova, ngaigithia taranda 100,000<note caller="+" style="f"><char style="fr" closed="false">22:14 </char><char style="ft" closed="false">nĩ ta tani 3,450</char></note> cia thahabu, na taranda 1,000,000<note caller="+" style="f"><char style="fr" closed="false">22:14 </char><char style="ft" closed="false">nĩ ta tani 34,500</char></note> cia betha, na icango nyingĩ na igera nyingĩ itangĩthimĩka, na mbaũ na mahiga. Nawe no wongerere ingĩ. <verse eid="1CH 22:14"/><verse number="15" style="v" sid="1CH 22:15"/>Ũrĩ na aruti wĩra aingĩ: aicũhia a mahiga, na aaki a mahiga, na aaki a mbaũ, o hamwe na andũ marĩ na ũũgĩ wa kũruta wĩra o wothe <verse eid="1CH 22:15"/><verse number="16" style="v" sid="1CH 22:16"/>wa thahabu na wa betha, na wa gĩcango na wa igera, na mabundi maingĩ makĩria. Rĩu kĩambĩrĩrie wĩra, nake Jehova aroikara hamwe nawe.”<verse eid="1CH 22:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 22:17"/>Hĩndĩ ĩyo Daudi agĩatha atongoria othe a Isiraeli mateithie mũriũ Solomoni. <verse eid="1CH 22:17"/><verse number="18" style="v" sid="1CH 22:18"/>Akĩmeera atĩrĩ, “Githĩ Jehova Ngai wanyu ndarĩ hamwe na inyuĩ? Na githĩ ndamũheete ũhurũko mĩena yothe? Nĩgũkorwo nĩaneanĩte atũũri a bũrũri ũyũ moko-inĩ makwa, na rĩu bũrũri ũrĩ watho-inĩ wa Jehova na andũ ake. <verse eid="1CH 22:18"/><verse number="19" style="v" sid="1CH 22:19"/>Rĩu mwĩheanei ngoro na muoyo mũcarie Jehova Ngai wanyu. Ambĩrĩriai gwaka handũ-harĩa-haamũre ha Jehova Ngai, nĩgeetha mũrehe ithandũkũ rĩa Jehova rĩa kĩrĩkanĩro na indo iria nyamũre cia Ngai itoonyio hekarũ ĩrĩa ĩgwakwo nĩ ũndũ wa Rĩĩtwa rĩa Jehova.”<verse eid="1CH 22:19"/></para>
  <chapter eid="1CH 22"/>
  <chapter number="23" style="c" sid="1CH 23"/>
  <para style="s1">Alawii</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 23:1"/>Na rĩrĩ, rĩrĩa Daudi aakũrire na agĩkorwo arĩ na mĩaka mĩingĩ-rĩ, agĩtua mũriũ Solomoni mũthamaki wa gũthamakĩra Isiraeli.<verse eid="1CH 23:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 23:2"/>Ningĩ agĩcookanĩrĩria atongoria othe a Isiraeli hamwe na athĩnjĩri-Ngai na Alawii. <verse eid="1CH 23:2"/><verse number="3" style="v" sid="1CH 23:3"/>Alawii arĩa maakinyĩtie mĩaka mĩrongo ĩtatũ kana makĩria magĩtarwo, nao arũme othe maarĩ 38,000. <verse eid="1CH 23:3"/><verse number="4" style="v" sid="1CH 23:4"/>Daudi akiuga atĩrĩ, “Thĩinĩ wa aya, 24,000 nĩ marũgamagĩrĩre wĩra wa hekarũ ya Jehova, nao 6,000 matuĩke anene na atuithania a ciira. <verse eid="1CH 23:4"/><verse number="5" style="v" sid="1CH 23:5"/>Nao andũ 4,000 matuĩke arangĩri a ihingo, nao acio angĩ 4,000 matuĩke a kũgoocaga Jehova marĩ na inanda cia ũini iria heanĩte nĩ ũndũ wa wĩra ũcio kĩũmbe.”<verse eid="1CH 23:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 23:6"/>Daudi nĩagayanirie Alawii acio ikundi kũringana na ariũ a Lawi na nĩo Gerishoni, na Kohathu, na Merari.<verse eid="1CH 23:6"/></para>
  <para style="s1">Andũ a Gerishoni</para>
  <para style="m">
    <verse number="7" style="v" sid="1CH 23:7"/>Ariũ a Gerishoni maarĩ:</para>
  <para style="li2" vid="1CH 23:7">Ladani na Shimei.<verse eid="1CH 23:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 23:8"/>Ariũ a Ladani maarĩ:</para>
  <para style="li2" vid="1CH 23:8">Jehieli na nĩwe warĩ mũtongoria wao, na Zethamu, na Joeli; othe maarĩ atatũ.<verse eid="1CH 23:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 23:9"/>Ariũ a Shimei maarĩ:</para>
  <para style="li2" vid="1CH 23:9">Shelomothu, na Hazieli, na Harani, othe maarĩ atatũ.</para>
  <para style="li2" vid="1CH 23:9">Acio nĩo maarĩ atongoria a nyũmba cia Ladani.<verse eid="1CH 23:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 23:10"/>Na ariũ a Shimei maarĩ:</para>
  <para style="li2" vid="1CH 23:10">Jahathu, na Ziza, na Jeushu, na Beria.</para>
  <para style="li2" vid="1CH 23:10">Acio nĩo maarĩ ariũ a Shimei; othe maarĩ ana.<verse eid="1CH 23:10"/></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 23:11"/>Jahathu nĩwe warĩ mũtongoria wao, nake Ziza aarĩ mũnini wake, no Jeushu na Beria matiarĩ na ariũ aingĩ; nĩ ũndũ ũcio maatarirwo ta maarĩ a nyũmba ĩmwe, na makĩheo wĩra ũmwe.<verse eid="1CH 23:11"/></para>
  <para style="s1">Andũ a Kohathu</para>
  <para style="m">
    <verse number="12" style="v" sid="1CH 23:12"/>Ariũ a Kohathu maarĩ:</para>
  <para style="li1" vid="1CH 23:12">Amuramu, na Iziharu, na Hebironi, na Uzieli: othe maarĩ ana.<verse eid="1CH 23:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 23:13"/>Ariũ a Amuramu maarĩ:</para>
  <para style="li2" vid="1CH 23:13">Harũni na Musa.</para>
  <para style="li2" vid="1CH 23:13">Harũni nĩamũrirwo hamwe na njiaro ciake nginya tene, nĩgeetha maamũrage indo iria theru mũno, na marutagĩre Jehova magongona, na mamũtungatagĩre, na marathimanage thĩinĩ wa rĩĩtwa rĩake nginya tene. <verse eid="1CH 23:13"/><verse number="14" style="v" sid="1CH 23:14"/>Ariũ a Musa, mũndũ wa Ngai, maataranĩirio na mũhĩrĩga wa Lawi.<verse eid="1CH 23:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 23:15"/>Ariũ a Musa maarĩ: Gerishomu na Eliezeri.<verse eid="1CH 23:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 23:16"/>Njiaro cia Gerishomu nĩ:</para>
  <para style="li2" vid="1CH 23:16">Shebueli nĩwe warĩ mũtongoria wao.<verse eid="1CH 23:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 23:17"/>Njiaro cia Eliezeri nĩ:</para>
  <para style="li2" vid="1CH 23:17">Rehabia na nĩwe warĩ mũtongoria wao.</para>
  <para style="li2" vid="1CH 23:17">Eliezeri ndaarĩ na ariũ angĩ, no ariũ a Rehabia maarĩ aingĩ mũno.<verse eid="1CH 23:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 23:18"/>Ariũ a Iziharu maarĩ:</para>
  <para style="li2" vid="1CH 23:18">Shelomithu na nĩwe warĩ mũtongoria wao.<verse eid="1CH 23:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 23:19"/>Ariũ a Hebironi maarĩ:</para>
  <para style="li2" vid="1CH 23:19">Jeria na nĩwe warĩ mũtongoria wao, na Amaria aarĩ wa keerĩ, na Jahazieli aarĩ wa gatatũ, na Jekameamu aarĩ wa kana.<verse eid="1CH 23:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 23:20"/>Ariũ a Uzieli maarĩ:</para>
  <para style="li2" vid="1CH 23:20">Mika na nĩwe warĩ mũtongoria wao, nake Ishia aarĩ mũnini wake.<verse eid="1CH 23:20"/></para>
  <para style="s1">Andũ a Merari</para>
  <para style="m">
    <verse number="21" style="v" sid="1CH 23:21"/>Ariũ a Merari maarĩ:</para>
  <para style="li2" vid="1CH 23:21">Mahali na Mushi.</para>
  <para style="li1" vid="1CH 23:21">Ariũ a Mahali maarĩ:</para>
  <para style="li2" vid="1CH 23:21">Eleazaru na Kishu.<verse eid="1CH 23:21"/></para>
  <para style="li2">
    <verse number="22" style="v" sid="1CH 23:22"/>Eleazaru aakuire atarĩ na aanake; aarĩ o na airĩtu. Makĩhikio nĩ ariũ a mũrũ wa nyina na ithe wao Kishu.<verse eid="1CH 23:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 23:23"/>Ariũ a Mushi maarĩ:</para>
  <para style="li2" vid="1CH 23:23">Mahali, na Ederi, na Jeremothu; othe maarĩ atatũ.<verse eid="1CH 23:23"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="24" style="v" sid="1CH 23:24"/>Acio nĩo maarĩ njiaro cia Lawi kũringana na nyũmba ciao: na nĩo maarĩ atongoria a nyũmba ciao ta ũrĩa marĩĩtwa mao maandĩkĩtwo, na maatarirwo mũndũ o mũndũ, ũguo nĩ kuuga aruti a wĩra arĩa maarĩ na ũkũrũ wa mĩaka mĩrongo ĩĩrĩ na makĩria, arĩa maatungataga hekarũ-inĩ ya Jehova. <verse eid="1CH 23:24"/><verse number="25" style="v" sid="1CH 23:25"/>Nĩgũkorwo Daudi nĩoigĩte atĩrĩ, “Kuona atĩ Jehova Ngai wa Isiraeli nĩaheete andũ ake ũhurũko, na nĩokĩte gũtũũra Jerusalemu nginya tene-rĩ, <verse eid="1CH 23:25"/><verse number="26" style="v" sid="1CH 23:26"/>Alawii matigũcooka kũbatario nĩgũkuuaga hema ĩrĩa nyamũre kana kĩndũ o nakĩ kĩa iria ihũthagĩrwo cia gũtungata thĩinĩ wayo.” <verse eid="1CH 23:26"/><verse number="27" style="v" sid="1CH 23:27"/>Kũringana na ciugo cia Daudi cia mũthia, Alawii arĩa maarĩ na ũkũrũ wa mĩaka mĩrongo ĩĩrĩ kana makĩria nĩmatarirwo.<verse eid="1CH 23:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 23:28"/>Wĩra wa Alawii warĩ wa gũteithia njiaro cia Harũni ũtungata-inĩ wa hekarũ ya Jehova ta ũũ: kũrũgamĩrĩra nja cia hekarũ na tũnyũmba twa ithaku-inĩ, na gũtherithia indo iria nyamũre, na kũruta mawĩra marĩa mangĩ thĩinĩ wa nyũmba ya Ngai. <verse eid="1CH 23:28"/><verse number="29" style="v" sid="1CH 23:29"/>Nĩo maarĩ arũgamĩrĩri a mĩgate ĩrĩa yaigagwo metha-inĩ, na maruta ma mũtu wa ngano, na tũmĩgate tũrĩa tũtarĩ na ndawa ya kũimbia, na wĩra wa gũkanda na kũruga mĩgate, na mawĩra mothe ma gũthima ũingĩ na mũigana wa indo. <verse eid="1CH 23:29"/><verse number="30" style="v" sid="1CH 23:30"/>Ningĩ marũgamage o rũciinĩ gũcookeria Jehova ngaatho na kũmũgooca. Ningĩ magekaga ũguo o hwaĩ-inĩ, <verse eid="1CH 23:30"/><verse number="31" style="v" sid="1CH 23:31"/>na rĩrĩa rĩothe maruta ma njino mangĩarutĩirwo Jehova, mĩthenya ya Thabatũ, na ciathĩ cia Karũgamo ka Mweri, na ciathĩ iria ingĩ ciathanĩtwo. No nginya matungatage mbere ya Jehova mahinda mothe marĩ mũigana ũrĩa ũtuĩtwo, ningĩ na njĩra ĩrĩa maathĩtwo marutage nayo.<verse eid="1CH 23:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 23:32"/>Na nĩ ũndũ ũcio Alawii magĩthiĩ na mbere kũruta wĩra ũrĩa mehokeirwo wa Hema-ya-Gũtũnganwo, na wa Handũ-harĩa-Hatheru, matongoretio nĩ ariũ a ithe wao a rũciaro rwa Harũni, nĩ ũndũ wa ũtungata wa hekarũ ya Jehova.<verse eid="1CH 23:32"/></para>
  <chapter eid="1CH 23"/>
  <chapter number="24" style="c" sid="1CH 24"/>
  <para style="s1">Ikundi Cia Athĩnjĩri-Ngai</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 24:1"/>Ici nĩcio ciarĩ ikundi cia ariũ a Harũni:</para>
  <para style="p" vid="1CH 24:1">Ariũ a Harũni maarĩ Nadabu, na Abihu, na Eleazaru, na Ithamaru. <verse eid="1CH 24:1"/><verse number="2" style="v" sid="1CH 24:2"/>No rĩrĩ, Nadabu na Abihu nĩmakuire ithe wao atakuĩte, na matiarĩ na ciana cia aanake; nĩ ũndũ ũcio Eleazaru na Ithamaru magĩtungata marĩ athĩnjĩri-Ngai. <verse eid="1CH 24:2"/><verse number="3" style="v" sid="1CH 24:3"/>Zadoku wa rũciaro rwa Eleazaru na Ahimeleku wa rũciaro rwa Ithamaru nĩo maateithĩrĩirie Daudi kũmagayania ikundi, nĩ ũndũ wa mũtaratara wa ũtungata ũrĩa maathuurĩirwo. <verse eid="1CH 24:3"/><verse number="4" style="v" sid="1CH 24:4"/>Atongoria arĩa aingĩ moimĩte njiaro-inĩ cia Eleazaru gũkĩra arĩa moimĩte njiaro-inĩ cia Ithamaru, nao makĩgayanio ta ũũ: kuuma njiaro-inĩ cia Eleazaru kwarĩ na atongoria a nyũmba ikũmi na atandatũ, na kuuma njiaro-inĩ cia Ithamaru kwarĩ na atongoria a nyũmba anana. <verse eid="1CH 24:4"/><verse number="5" style="v" sid="1CH 24:5"/>Maamagayanirie na kĩhooto na ũndũ wa gũcuuka mĩtĩ, nĩgũkorwo nĩ haarĩ na anene a handũ-harĩa-haamũre, na anene a nyũmba ya Ngai gatagatĩ-inĩ ka njiaro icio cia Eleazaru na cia Ithamaru.<verse eid="1CH 24:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 24:6"/>Shemaia mũrũ wa Nethaneli, ũrĩa mwandĩki-marũa Mũlawii, nĩandĩkire marĩĩtwa mao arĩ mbere ya mũthamaki na anene aya: Zadoku ũrĩa-mũthĩnjĩri-Ngai, na Ahimeleku mũrũ wa Abiatharu, na atongoria a nyũmba cia athĩnjĩri-Ngai na cia Alawii. Nyũmba ĩmwe ĩgathuurwo kuuma kũrĩ Eleazaru, na ĩrĩa ĩngĩ ĩgathuurwo kuuma kũrĩ Ithamaru.<verse eid="1CH 24:6"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 24:7"/>Mũtĩ wa mbere wagũire kũrĩ Jehoiaribu,</para>
  <para style="li1" vid="1CH 24:7">na wa keerĩ kũrĩ Jedaia,<verse eid="1CH 24:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 24:8"/>na wa gatatũ kũrĩ Harimu,</para>
  <para style="li1" vid="1CH 24:8">na wa kana kũrĩ Seroimu,<verse eid="1CH 24:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 24:9"/>na wa gatano kũrĩ Malikija,</para>
  <para style="li1" vid="1CH 24:9">na wa gatandatũ kũrĩ Mijamini,<verse eid="1CH 24:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 24:10"/>na wa mũgwanja kũrĩ Hakozu,</para>
  <para style="li1" vid="1CH 24:10">na wa kanana kũrĩ Abija,<verse eid="1CH 24:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 24:11"/>na wa kenda kũrĩ Jeshua,</para>
  <para style="li1" vid="1CH 24:11">na wa ikũmi kũrĩ Shekania,<verse eid="1CH 24:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 24:12"/>na wa ikũmi na ũmwe kũrĩ Eliashibu,</para>
  <para style="li1" vid="1CH 24:12">na wa ikũmi na ĩĩrĩ kũrĩ Jakimu,<verse eid="1CH 24:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 24:13"/>na wa ikũmi na ĩtatũ kũrĩ Hupa,</para>
  <para style="li1" vid="1CH 24:13">na wa ikũmi na ĩna kũrĩ Jeshebeabu,<verse eid="1CH 24:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 24:14"/>na wa ikũmi na ĩtano kũrĩ Biliga,</para>
  <para style="li1" vid="1CH 24:14">na wa ikũmi na ĩtandatũ kũrĩ Imeri,<verse eid="1CH 24:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 24:15"/>na wa ikũmi na mũgwanja kũrĩ Heziri,</para>
  <para style="li1" vid="1CH 24:15">na wa ikũmi na ĩnana kũrĩ Hapizezu,<verse eid="1CH 24:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 24:16"/>na wa ikũmi na kenda kũrĩ Pethahia,</para>
  <para style="li1" vid="1CH 24:16">na wa mĩrongo ĩĩrĩ kũrĩ Jehezekeli,<verse eid="1CH 24:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 24:17"/>na wa mĩrongo ĩĩrĩ na ũmwe kũrĩ Jakini,</para>
  <para style="li1" vid="1CH 24:17">na wa mĩrongo ĩĩrĩ na igĩrĩ kũrĩ Gamuli,<verse eid="1CH 24:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 24:18"/>na wa mĩrongo ĩĩrĩ na ĩtatũ kũrĩ Delaia,</para>
  <para style="li1" vid="1CH 24:18">na wa mĩrongo ĩĩrĩ na ĩna kũrĩ Maazia.<verse eid="1CH 24:18"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="19" style="v" sid="1CH 24:19"/>Ũyũ nĩguo warĩ mũtaratara wa ũtungata wao rĩrĩa maatoonya hekarũ ya Jehova, kũringana na watho ũrĩa maatuĩrĩirwo nĩ ithe wao Harũni, ta ũrĩa Jehova Ngai wa Isiraeli aamwathĩte.<verse eid="1CH 24:19"/></para>
  <para style="s1">Alawii arĩa Angĩ</para>
  <para style="m">
    <verse number="20" style="v" sid="1CH 24:20"/>Njiaro iria ingĩ cia Lawi ciarĩ:</para>
  <para style="li1" vid="1CH 24:20">kuuma kũrĩ ariũ a Amuramu: nĩ Shubaeli;</para>
  <para style="li2" vid="1CH 24:20">na kuuma kũrĩ ariũ a Shubaeli: nĩ Jehedeia.<verse eid="1CH 24:20"/></para>
  <para style="li2">
    <verse number="21" style="v" sid="1CH 24:21"/>Kuuma kũrĩ ariũ a Rehabia:</para>
  <para style="li2" vid="1CH 24:21">nĩ Ishia na nĩwe warĩ mũtongoria wao.<verse eid="1CH 24:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 24:22"/>Kuuma kũrĩ andũ a Iziharu: nĩ Shelomothu;</para>
  <para style="li2" vid="1CH 24:22">na kuuma ariũ a Shelomothu: nĩ Jahathu.<verse eid="1CH 24:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 24:23"/>Ariũ a Hebironi maarĩ: Jeria na nĩwe warĩ mũtongoria wao, Amaria aarĩ wa keerĩ, nake Jahazieli aarĩ wa gatatũ, na Jekameamu aarĩ wa kana.<verse eid="1CH 24:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 24:24"/>Mũrũ wa Uzieli: aarĩ Mika;</para>
  <para style="li2" vid="1CH 24:24">kuuma ariũ a Mika: nĩ Shamiru.<verse eid="1CH 24:24"/></para>
  <para style="li2">
    <verse number="25" style="v" sid="1CH 24:25"/>Mũrũ wa nyina na Mika: aarĩ Ishia;</para>
  <para style="li2" vid="1CH 24:25">kuuma ariũ a Ishia: nĩ Zekaria.<verse eid="1CH 24:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 24:26"/>Ariũ a Merari: maarĩ Mahali na Mushi.</para>
  <para style="li2" vid="1CH 24:26">Mũrũ wa Jaazia: aarĩ Beno.<verse eid="1CH 24:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 24:27"/>Ariũ a Merari:</para>
  <para style="li2" vid="1CH 24:27">kuuma kũrĩ Jaazia: maarĩ Beno, na Shohamu, na Zakuri, na Ibiri.<verse eid="1CH 24:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 24:28"/>kuuma kũrĩ Mahali: nĩ Eleazaru, ũrĩa ũtaarĩ na aanake.<verse eid="1CH 24:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 24:29"/>Kuuma kũrĩ Kishu: nĩ mũriũ Jerameeli.<verse eid="1CH 24:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 24:30"/>Nao ariũ a Mushi: maarĩ Mahali, na Ederi, na Jeremothu.</para>
  <para style="b" vid="1CH 24:30"/>
  <para style="p" vid="1CH 24:30">Acio nĩo maarĩ Alawii kũringana na nyũmba ciao. <verse eid="1CH 24:30"/><verse number="31" style="v" sid="1CH 24:31"/>O nao nĩmacuukire mĩtĩ o ta ũrĩa ariũ a ithe wao a rũciaro rwa Harũni meekire, marĩ mbere ya Mũthamaki Daudi o na mbere ya Zadoku, na Ahimeleku, na atongoria a nyũmba cia athĩnjĩri-Ngai na cia Alawii. Nyũmba cia mũrũ wa nyina ũrĩa mũkũrũ ciekirwo o ta ũrĩa nyũmba cia ũrĩa mũnini mũno ciekirwo.<verse eid="1CH 24:31"/></para>
  <chapter eid="1CH 24"/>
  <chapter number="25" style="c" sid="1CH 25"/>
  <para style="s1">Aini</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 25:1"/>Daudi arĩ hamwe na anene a mbũtũ cia ita nĩamũrire ariũ amwe a Asafu, na Hemani, na Jeduthuni marutage wĩra wa ũrathi makĩhũũraga inanda cia mũgeeto, na cia kĩnũbi, na thaani iria ihũũrithanagio ikagamba. Maya nĩmo marĩĩtwa ma andũ arĩa maarutaga wĩra ũyũ wa kũina:<verse eid="1CH 25:1"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 25:2"/>Kuuma kũrĩ ariũ a Asafu:</para>
  <para style="li2" vid="1CH 25:2">maarĩ Zakuri, na Jusufu, na Nethania, na Asarela. Ariũ a Asafu maarũgamagĩrĩrwo nĩ Asafu, ũrĩa warathaga ũhoro arũgamĩrĩirwo nĩ mũthamaki.<verse eid="1CH 25:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 25:3"/>Kuuma kũrĩ ariũ a Jeduthuni:</para>
  <para style="li2" vid="1CH 25:3">maarĩ Gedalia, na Zeri, na Jeshaia, na Shimei, na Hashabia, na Matithia; othe maarĩ atandatũ, marũgamĩrĩirwo nĩ ithe wao Jeduthuni, ũrĩa warathaga ũhoro, akĩhũũraga kĩnanda kĩa mũgeeto, agacookagĩria Jehova ngaatho na akamũgoocaga.<verse eid="1CH 25:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 25:4"/>Kuuma kũrĩ ariũ a Hemani:</para>
  <para style="li2" vid="1CH 25:4">maarĩ Bukia, na Matania, na Uzieli, na Shubaeli, na Jerimothu, na Hanania, na Hanani, na Eliatha, na Gidaliti, na Romamuti-Ezeri, na Joshibekasha, na Malothi, na Hothiru, na Mahaziothu. <verse eid="1CH 25:4"/><verse number="5" style="v" sid="1CH 25:5"/>Acio othe maarĩ ariũ a Hemani ũrĩa wonagĩra mũthamaki maũndũ. Maaheanĩtwo kũrĩ we kũringana na ciĩranĩro cia Ngai nĩguo mamũtũũgagĩrie. Ngai aaheete Hemani ariũ ikũmi na ana, na airĩtu atatũ.<verse eid="1CH 25:5"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="6" style="v" sid="1CH 25:6"/>Andũ aya othe maarũgamagĩrĩrwo nĩ maithe mao nĩguo mainage thĩinĩ wa hekarũ ya Jehova, marĩ na thaani iria ihũũrithanagio ikagamba, na inanda cia kĩnũbi, na inanda cia mũgeeto, nĩ ũndũ wa ũtungata wa nyũmba ya Ngai. Asafu, na Jeduthuni, na Hemani nao maarũgamagĩrĩrwo nĩ mũthamaki. <verse eid="1CH 25:6"/><verse number="7" style="v" sid="1CH 25:7"/>Hamwe na andũ a nyũmba ciao, arĩa othe maarutĩtwo na makagĩa na ũũgĩ wa kũinĩra Jehova, othe maarĩ andũ 288. <verse eid="1CH 25:7"/><verse number="8" style="v" sid="1CH 25:8"/>Andũ ethĩ na akũrũ ũndũ ũmwe, na arutani o na arutwo, nĩmacuukire mĩtĩ nĩguo magaĩrwo mawĩra mao.<verse eid="1CH 25:8"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 25:9"/>Mũtĩ wa mbere, ũrĩa warĩ wa Asafu, wagwĩrĩire Jusufu, na ariũ ake, na andũ a nyũmba yao, maarĩ andũ 12;</para>
  <para style="li1" vid="1CH 25:9">wa keerĩ wagwĩrĩire Gedalia, we na andũ a nyũmba yao, na ariũ ao, maarĩ andũ 12;<verse eid="1CH 25:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 25:10"/>wa gatatũ wagũĩrĩire Zakuri, na ariũ ake, na andũ a nyũmba yao, maarĩ andũ 12;<verse eid="1CH 25:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 25:11"/>wa kana wagũĩrĩire Iziri, na ariũ ake, na andũ a nyũmba yao, maarĩ andũ 12;<verse eid="1CH 25:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 25:12"/>wa gatano wagũĩrĩire Nethania, na ariũ ake, na andũ a nyũmba yao, maarĩ andũ 12;<verse eid="1CH 25:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 25:13"/>wa gatandatũ wagũĩrĩire Bukia, na ariũ ake, na andũ a nyũmba yao, maarĩ andũ 12;<verse eid="1CH 25:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 25:14"/>wa mũgwanja wagũĩrĩire Jesarela, na ariũ ake, na andũ a nyũmba yao, maarĩ andũ 12;<verse eid="1CH 25:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 25:15"/>wa kanana wagũĩrĩire Jeshaia, na ariũ ake, na andũ a nyũmba yao, maarĩ andũ 12;<verse eid="1CH 25:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 25:16"/>wa kenda wagũĩrĩire Matania, na ariũ ake, na andũ a nyũmba yao, maarĩ andũ 12;<verse eid="1CH 25:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 25:17"/>wa ikũmi wagũĩrĩire Shemei, na ariũ ake, na andũ a nyũmba yao, maarĩ andũ 12;<verse eid="1CH 25:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 25:18"/>wa ikũmi na ũmwe wagũĩrĩire Azareli, na ariũ ake, na andũ a nyũmba yao, maarĩ andũ 12;<verse eid="1CH 25:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 25:19"/>wa ikũmi na ĩĩrĩ wagũĩrĩire Hashabia, na ariũ ake, na andũ a nyũmba yao, maarĩ andũ 12;<verse eid="1CH 25:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 25:20"/>wa ikũmi na ĩtatũ wagũĩrĩire Shubaeli, na ariũ ake, na andũ a nyũmba yao, maarĩ andũ 12;<verse eid="1CH 25:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 25:21"/>wa ikũmi na ĩna wagũĩrĩire Matithia, na ariũ ake, na andũ a nyũmba yao, maarĩ andũ 12;<verse eid="1CH 25:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 25:22"/>wa ikũmi na ĩtano wagũĩrĩire Jerimothu, na ariũ ake, na andũ a nyũmba yao, maarĩ andũ 12;<verse eid="1CH 25:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 25:23"/>wa ikũmi na ĩtandatũ wagũĩrĩire Hanania, na ariũ ake, na andũ a nyũmba yao, maarĩ andũ 12;<verse eid="1CH 25:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 25:24"/>wa ikũmi na mũgwanja wagũĩrĩire Joshibekasha, na ariũ ake, na andũ a nyũmba yao, maarĩ andũ 12;<verse eid="1CH 25:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 25:25"/>wa ikũmi na ĩnana wagũĩrĩire Hanani, na ariũ ake, na andũ a nyũmba yao, maarĩ andũ 12;<verse eid="1CH 25:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 25:26"/>wa ikũmi na kenda wagũĩrĩire Malothi, na ariũ ake, na andũ a nyũmba yao, maarĩ andũ 12;<verse eid="1CH 25:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 25:27"/>wa mĩrongo ĩĩrĩ wagũĩrĩire Eliatha, na ariũ ake, na andũ a nyũmba yao, maarĩ andũ 12;<verse eid="1CH 25:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 25:28"/>wa mĩrongo ĩĩrĩ na ũmwe wagũĩrĩire Hothiru, na ariũ ake, na andũ a nyũmba yao, maarĩ andũ 12;<verse eid="1CH 25:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 25:29"/>wa mĩrongo ĩĩrĩ na ĩĩrĩ wagũĩrĩire Gidaliti, na ariũ ake, na andũ a nyũmba yao, maarĩ andũ 12;<verse eid="1CH 25:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 25:30"/>wa mĩrongo ĩĩrĩ na ĩtatũ wagũĩrĩire Mahaziothu, na ariũ ake, na andũ a nyũmba yao, maarĩ andũ 12;<verse eid="1CH 25:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 25:31"/>wa mĩrongo ĩĩrĩ na ĩna wagũĩrĩire Romamuti-Ezeri, na ariũ ake, na andũ a nyũmba yao, maarĩ andũ 12.<verse eid="1CH 25:31"/></para>
  <chapter eid="1CH 25"/>
  <chapter number="26" style="c" sid="1CH 26"/>
  <para style="s1">Arangĩri a Ihingo</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 26:1"/>Ikundi cia arangĩri a ihingo:</para>
  <para style="b" vid="1CH 26:1"/>
  <para style="li1" vid="1CH 26:1">kuuma kũrĩ andũ a Kora maarĩ: Meshelemia mũrũ wa Kore, ũmwe wa ariũ a Asafu.<verse eid="1CH 26:1"/></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 26:2"/>Ariũ a Meshelemia maarĩ:</para>
  <para style="li2" vid="1CH 26:2">Zekaria, na nĩwe warĩ wa irigithathi,</para>
  <para style="li2" vid="1CH 26:2">na Jediaeli aarĩ wa keerĩ,</para>
  <para style="li2" vid="1CH 26:2">na Zebadia aarĩ wa gatatũ,</para>
  <para style="li2" vid="1CH 26:2">na Jathinieli aarĩ wa kana,<verse eid="1CH 26:2"/></para>
  <para style="li2">
    <verse number="3" style="v" sid="1CH 26:3"/>na Elamu aarĩ wa gatano,</para>
  <para style="li2" vid="1CH 26:3">na Jehohanani aarĩ wa gatandatũ,</para>
  <para style="li2" vid="1CH 26:3">na Eliehoenai aarĩ wa mũgwanja.<verse eid="1CH 26:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 26:4"/>Ariũ a Obedi-Edomu maarĩ:</para>
  <para style="li2" vid="1CH 26:4">Shemaia, na nĩwe warĩ wa irigithathi,</para>
  <para style="li2" vid="1CH 26:4">na Jehozabadu aarĩ wa keerĩ,</para>
  <para style="li2" vid="1CH 26:4">na Joa aarĩ wa gatatũ,</para>
  <para style="li2" vid="1CH 26:4">na Sakaru aarĩ wa kana,</para>
  <para style="li2" vid="1CH 26:4">na Nethaneli aarĩ wa gatano,<verse eid="1CH 26:4"/></para>
  <para style="li2">
    <verse number="5" style="v" sid="1CH 26:5"/>na Amieli aarĩ wa gatandatũ,</para>
  <para style="li2" vid="1CH 26:5">na Isakaru aarĩ wa mũgwanja,</para>
  <para style="li2" vid="1CH 26:5">na Peulethai aarĩ wa kanana,</para>
  <para style="li2" vid="1CH 26:5">nĩgũkorwo Ngai nĩarathimĩte Obedi-Edomu.<verse eid="1CH 26:5"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 26:6"/>Mũriũ Shemaia o nake aarĩ na ariũ ake, arĩa maarĩ atongoria thĩinĩ wa nyũmba ya ithe wao, tondũ maarĩ andũ ehoti. <verse eid="1CH 26:6"/><verse number="7" style="v" sid="1CH 26:7"/>Ariũ a Shemaia maarĩ: Othini, na Refaeli, na Obedi, na Elizabadu, nao andũ a nyũmba yao, Elihu, na Semakia, maarĩ andũ ehoti. <verse eid="1CH 26:7"/><verse number="8" style="v" sid="1CH 26:8"/>Acio othe maarĩ a njiaro cia Obedi-Edomu; o hamwe na ariũ ao, na andũ a nyũmba yao maarĩ andũ ehoti, na maarĩ na hinya wa kũruta wĩra. Njiaro cia Obedi-Edomu othe maarĩ andũ 62.<verse eid="1CH 26:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 26:9"/>Meshelemia nĩ aarĩ na ariũ ake na andũ a nyũmba yao, arĩa maarĩ andũ ehoti, othe maarĩ andũ 18.<verse eid="1CH 26:9"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 26:10"/>Ariũ a Hosa ũrĩa Mũmerari maarĩ: Shimuri na nĩwe warĩ mũtongoria wao (o na gũtuĩka tiwe warĩ irigithathi, ithe nĩamũthuurĩte atuĩke mũtongoria wao), <verse eid="1CH 26:10"/><verse number="11" style="v" sid="1CH 26:11"/>Hilikia aarĩ wa keerĩ, nake Tabalia aarĩ wa gatatũ, na Zekaria aarĩ wa kana. Ariũ a Hosa na andũ a nyũmba yao othe maarĩ andũ 13.<verse eid="1CH 26:11"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="12" style="v" sid="1CH 26:12"/>Ikundi icio cia arangĩri a ihingo ciĩtanĩtio na anene ao, ciarĩ na mawĩra ma gũtungata thĩinĩ wa hekarũ ya Jehova o ta andũ arĩa angĩ a nyũmba yao. <verse eid="1CH 26:12"/><verse number="13" style="v" sid="1CH 26:13"/>Andũ ethĩ na andũ akũrũ o ũndũ ũmwe nĩmacuukĩire o kĩhingo mĩtĩ kũringana na nyũmba ciao.<verse eid="1CH 26:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 26:14"/>Mũtĩ wa Kĩhingo kĩa Irathĩro wagwĩrĩire Shelemia. Ningĩ magĩcuuka mĩtĩ nĩ ũndũ wa mũriũ Zekaria, ũrĩa warĩ mũheani kĩrĩra mũũgĩ, nake akĩgwĩrwo nĩ mũtĩ wa Kĩhingo gĩa Gathigathini. <verse eid="1CH 26:14"/><verse number="15" style="v" sid="1CH 26:15"/>Mũtĩ wa Kĩhingo gĩa Gũthini wagwĩrĩire Obedi-Edomu, naguo mũtĩ wa nyũmba-ya-kũigwo-indo ũkĩgwĩra ariũ ake. <verse eid="1CH 26:15"/><verse number="16" style="v" sid="1CH 26:16"/>Mĩtĩ ya Kĩhingo gĩa Ithũĩro, na Kĩhingo gĩa Shalekethu mwena wa njĩra ya rũgongo, yagwĩrĩire Shupimu na Hosa.</para>
  <para style="p" vid="1CH 26:16">Arangĩri maaikaraga metanĩrĩire. <verse eid="1CH 26:16"/><verse number="17" style="v" sid="1CH 26:17"/>O mũthenya gwakoragwo na Alawii atandatũ mwena wa irathĩro, na Alawii ana mwena wa gathigathini, na Alawii ana mwena wa gũthini, na Alawii eerĩ mahinda mothe nyũmba-inĩ ya kũigwo-indo. <verse eid="1CH 26:17"/><verse number="18" style="v" sid="1CH 26:18"/>Nayo nja ya mwena wa ithũĩro, Alawii ana maikaraga njĩra-inĩ, na Alawii eerĩ maikaraga kũu nja.<verse eid="1CH 26:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 26:19"/>Icio nĩcio ciarĩ ikundi cia arangĩri a ihingo arĩa maarĩ a njiaro cia Kora na Merari.<verse eid="1CH 26:19"/></para>
  <para style="s1">Aigi Kĩgĩĩna, na Anene arĩa Angĩ</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 26:20"/>Alawii arĩa angĩ nĩo maarũgamagĩrĩra igĩĩna cia nyũmba ya Ngai na igĩĩna cia indo iria nyamũre.<verse eid="1CH 26:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 26:21"/>Njiaro cia Ladani, arĩa maarĩ Agerishoni na ũndũ wa Ladani, na maarĩ atongoria a nyũmba cia Ladani ũcio Mũgerishoni, maarĩ: Jehieli, <verse eid="1CH 26:21"/><verse number="22" style="v" sid="1CH 26:22"/>na ariũ a Jehieli, na Zethamu, na mũrũ wa nyina Joeli. Acio nĩo maarũgamagĩrĩra igĩĩna cia hekarũ ya Jehova.<verse eid="1CH 26:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 26:23"/>Kuuma kũrĩ andũ a Amuramu, na Iziharu, na Hebironi, na Uzieli maarĩ:<verse eid="1CH 26:23"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 26:24"/>Shubaeli wa rũciaro rwa Gerishomu mũrũ wa Musa, na nĩwe warĩ mũnene wa kũrũgamĩrĩra igĩĩna. <verse eid="1CH 26:24"/><verse number="25" style="v" sid="1CH 26:25"/>Andũ a nyũmba yao kuuma kũrĩ Eliezeri: maarĩ mũriũ Rehabia, na Jeshia aarĩ mũriũ wa Rehabia, na Joramu aarĩ mũriũ wa Jeshia, na Zikiri aarĩ mũriũ wa Joramu, na Shelomithu aarĩ mũriũ wa Zikiri. <verse eid="1CH 26:25"/><verse number="26" style="v" sid="1CH 26:26"/>Shelomithu na andũ a nyũmba yao nĩo maarũgamagĩrĩra igĩĩna ciothe cia indo iria ciarĩ nyamũre nĩ Mũthamaki Daudi, na indo iria ciarĩ nyamũre nĩ atongoria a nyũmba arĩa maarĩ anene a ikundi cia ngiri ngiri na ikundi cia igana igana, na ikaamũrwo nĩ anene arĩa angĩ a mbũtũ cia ita. <verse eid="1CH 26:26"/><verse number="27" style="v" sid="1CH 26:27"/>Indo imwe cia iria ciatahĩtwo mbaara-inĩ maaciamũrĩire wĩra wa gũcookereria hekarũ ya Jehova. <verse eid="1CH 26:27"/><verse number="28" style="v" sid="1CH 26:28"/>Na rĩrĩ, indo ciothe iria ciaamũrĩtwo nĩ Samũeli ũrĩa muoni-maũndũ, na ikaamũrwo nĩ Saũlũ mũrũ wa Kishu, na Abineri mũrũ wa Neri, na Joabu mũrũ wa Zeruia, na indo iria ingĩ ciothe ciaamũrĩtwo-rĩ, ciamenyagĩrĩrwo nĩ Shelomithu na andũ a nyũmba yao.<verse eid="1CH 26:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 26:29"/>Kuuma kũrĩ andũ a Iziharu: Kenania na ariũ ake nĩmaheirwo mawĩra na kũu nja ya hekarũ matuĩke anene na aciirithania a Isiraeli.<verse eid="1CH 26:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 26:30"/>Kuuma kũrĩ andũ a Hebironi: maarĩ Hashabia na andũ a nyũmba yao, andũ ehoti 1,700; nĩo maarũgamĩrĩire wĩra wa Jehova wothe kũu Isiraeli mwena wa ithũĩro wa Jorodani, o na wĩra wa gũtungatĩra mũthamaki. <verse eid="1CH 26:30"/><verse number="31" style="v" sid="1CH 26:31"/>Kuuma kũrĩ andũ a Hebironi, Jeria nĩwe warĩ mũnene wao kũringana na maandĩko ma njiarwa cia nyũmba ciao. Mwaka wa mĩrongo ĩna wa ũthamaki wa Daudi nĩ gwatuĩririo maandĩko-inĩ, na gũkĩoneka thĩinĩ wao andũ ehoti o kũu Jazeri ya Gileadi. <verse eid="1CH 26:31"/><verse number="32" style="v" sid="1CH 26:32"/>Jeria aarĩ na andũ a nyũmba yao 2,700 arĩa maarĩ ehoti na maarĩ atongoria a nyũmba, nake Mũthamaki Daudi akĩmatua arũgamĩrĩri a andũ a Rubeni, na a andũ a Gadi, na nuthu ya mũhĩrĩga wa Manase maũndũ-inĩ mothe marĩa maakonainie na Ngai, o na marĩa maakonainie na ũhoro wa mũthamaki.<verse eid="1CH 26:32"/></para>
  <chapter eid="1CH 26"/>
  <chapter number="27" style="c" sid="1CH 27"/>
  <para style="s1">Ikundi cia Mbũtũ cia Ita</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 27:1"/>Ũyũ nĩguo mũtaratara wa andũ a Isiraeli arĩa maarĩ atongoria a nyũmba, na anene a ikundi cia o ngiri ngiri na ikundi cia o igana igana, na anene ao, arĩa maatungatagĩra mũthamaki maũndũ-inĩ mothe makoniĩ ikundi cia mbũtũ cia ita iria ciakoragwo wĩra-inĩ mweri o mweri, mwaka wothe. O gĩkundi kĩarĩ kĩa andũ 24,000.<verse eid="1CH 27:1"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 27:2"/>Mũrũgamĩrĩri wa gĩkundi kĩa mbere kĩa mweri wa mbere aarĩ Jashobeamu mũrũ wa Zabidieli. Gĩkundi gĩake kĩarĩ na andũ 24,000. <verse eid="1CH 27:2"/><verse number="3" style="v" sid="1CH 27:3"/>Nake aarĩ wa rũciaro rwa Perezu, na nĩwe warĩ mũnene wa anene othe a mbũtũ cia ita mweri wa mbere.<verse eid="1CH 27:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 27:4"/>Mũrũgamĩrĩri wa gĩkundi kĩa mweri wa keerĩ aarĩ Dodai ũrĩa Mũahohi; mũtongoria wa gĩkundi gĩake aarĩ Mikilothu. Gĩkundi gĩake kĩarĩ na andũ 24,000.<verse eid="1CH 27:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 27:5"/>Mũnene wa mbũtũ cia ita wa gatatũ, wa mweri wa ĩtatũ aarĩ Benaia mũrũ wa Jehoiada ũrĩa mũthĩnjĩri-Ngai. Nĩwe warĩ mũnene, na gĩkundi gĩake kĩarĩ na andũ 24,000. <verse eid="1CH 27:5"/><verse number="6" style="v" sid="1CH 27:6"/>Benaia ũcio nĩwe warĩ njamba mũno gatagatĩ-inĩ ka arĩa Mĩrongo Ĩtatũ na nĩwe warĩ mũnene wao. Gĩkundi gĩake kĩarũgamagĩrĩrwo nĩ mũriũ Amizabadi.<verse eid="1CH 27:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 27:7"/>Mũnene wa kana, wa mweri wa ĩna, aarĩ Asaheli mũrũ wa nyina na Joabu; mũriũ Zebadia nĩwe wacookire ithenya rĩake. Gĩkundi gĩake kĩarĩ na andũ 24,000.<verse eid="1CH 27:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 27:8"/>Mũnene wa gatano mweri wa ĩtano, aarĩ Shamuhuthu ũrĩa Mũizirahi. Gĩkundi gĩake kĩarĩ na andũ 24,000.<verse eid="1CH 27:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 27:9"/>Mũnene wa gatandatũ wa mweri wa ĩtandatũ, aarĩ Ira mũrũ wa Ikeshu ũrĩa Mũtekoa. Gĩkundi gĩake kĩarĩ na andũ 24,000.<verse eid="1CH 27:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 27:10"/>Mũnene wa mũgwanja wa mweri wa mũgwanja, aarĩ Helezu ũrĩa Mũpeloni, wa rũciaro rwa Efiraimu. Gĩkundi gĩake kĩarĩ na andũ 24,000.<verse eid="1CH 27:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 27:11"/>Mũnene wa kanana, wa mweri wa ĩnana, aarĩ Sibekai ũrĩa Mũhushathi wa rũciaro rwa Azerahi. Gĩkundi gĩake kĩarĩ na andũ 24,000.<verse eid="1CH 27:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 27:12"/>Mũnene wa kenda wa mweri wa kenda aarĩ Abiezeri ũrĩa Mũanathothu wa rũciaro rwa Abenjamini. Gĩkundi gĩake kĩarĩ na andũ 24,000.<verse eid="1CH 27:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 27:13"/>Mũnene wa ikũmi, wa mweri wa ikũmi, aarĩ Maharai ũrĩa Mũnetofathi wa rũciaro rwa Azerahi. Gĩkundi gĩake kĩarĩ na andũ 24,000.<verse eid="1CH 27:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 27:14"/>Mũnene wa ikũmi na ũmwe, wa mweri wa ikũmi na ũmwe, aarĩ Benaia ũrĩa Mũpirathoni wa rũciaro rwa Aefiraimu. Gĩkundi gĩake kĩarĩ na andũ 24,000.<verse eid="1CH 27:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 27:15"/>Mũnene wa ikũmi na eerĩ, mweri wa ikũmi na ĩĩrĩ, aarĩ Helidai ũrĩa Mũnetofathi, wa kuuma nyũmba ya Othinieli. Gĩkundi gĩake kĩarĩ na andũ 24,000.<verse eid="1CH 27:15"/></para>
  <para style="s1">Anene a Mĩhĩrĩga</para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 27:16"/>Anene arĩa maathaga mĩhĩrĩga ya Isiraeli maarĩ aya:</para>
  <para style="b" vid="1CH 27:16"/>
  <para style="li1" vid="1CH 27:16">mũnene wa mũhĩrĩga wa Rubeni aarĩ Eliezeri mũrũ wa Zikiri;</para>
  <para style="li1" vid="1CH 27:16">mũnene wa mũhĩrĩga wa Simeoni aarĩ Shefatia mũrũ wa Maaka;<verse eid="1CH 27:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 27:17"/>mũnene wa mũhĩrĩga wa Lawi aarĩ Hashabia mũrũ wa Kemueli;</para>
  <para style="li1" vid="1CH 27:17">mũnene wa mũhĩrĩga wa Harũni aarĩ Zadoku;<verse eid="1CH 27:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 27:18"/>mũnene wa mũhĩrĩga wa Juda aarĩ Elihu mũrũ wa ithe na Daudi;</para>
  <para style="li1" vid="1CH 27:18">mũnene wa mũhĩrĩga wa Isakaru aarĩ Omuri mũrũ wa Mikaeli;<verse eid="1CH 27:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 27:19"/>mũnene wa mũhĩrĩga wa Zebuluni aarĩ Ishimaia mũrũ wa Obadia;</para>
  <para style="li1" vid="1CH 27:19">mũnene wa mũhĩrĩga wa Nafitali aarĩ Jeremothu mũrũ wa Azirieli;<verse eid="1CH 27:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 27:20"/>mũnene wa mũhĩrĩga wa Aefiraimu aarĩ Hoshea mũrũ wa Azazia;</para>
  <para style="li1" vid="1CH 27:20">mũnene wa nuthu ĩmwe ya mũhĩrĩga wa Manase aarĩ Joeli mũrũ wa Pedaia;<verse eid="1CH 27:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 27:21"/>mũnene wa nuthu ĩrĩa ingĩ ya mũhĩrĩga wa Manase kũu Gileadi aarĩ Ido mũrũ wa Zekaria;</para>
  <para style="li1" vid="1CH 27:21">mũnene wa mũhĩrĩga wa Benjamini aarĩ Jaasieli mũrũ wa Abineri;<verse eid="1CH 27:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 27:22"/>mũnene wa mũhĩrĩga wa Dani aarĩ Azareli mũrũ wa Jerohamu;</para>
  <para style="p" vid="1CH 27:22">Acio nĩo maarĩ anene arĩa maathaga mĩhĩrĩga ya Isiraeli.<verse eid="1CH 27:22"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="23" style="v" sid="1CH 27:23"/>Daudi ndaatarire andũ a mĩaka mĩrongo ĩĩrĩ na arĩa mataakinyĩtie, tondũ Jehova nĩeranĩire atĩ nĩakaingĩhia Isiraeli matuĩke o ta njata cia matu-inĩ. <verse eid="1CH 27:23"/><verse number="24" style="v" sid="1CH 27:24"/>Joabu mũrũ wa Zeruia nĩambĩrĩirie gũtara andũ, no ndaarĩkirie. Mangʼũrĩ nĩmakinyĩire Isiraeli nĩ ũndũ wa itarana rĩu. Naguo mũigana wa itarana rĩu ndwandĩkirwo ibuku-inĩ rĩa maũndũ ma Mũthamaki Daudi.<verse eid="1CH 27:24"/></para>
  <para style="s1">Arori a Maũndũ ma Mũthamaki</para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 27:25"/>Azimavethu mũrũ wa Adieli nĩwe warũgamagĩrĩra nyũmba iria ciaigagwo indo cia ũthamaki.</para>
  <para style="p" vid="1CH 27:25">Jonathani mũrũ wa Uzia nĩwe warũgamagĩrĩra nyũmba cia kũigwo indo kũu ngʼongo-inĩ, na matũũra-inĩ, na tũtũũra-inĩ, o na mĩthiringo ĩrĩa mĩraihu na igũrũ ya arangĩri.<verse eid="1CH 27:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 27:26"/>Eziri mũrũ wa Kelubu nĩwe warũgamagĩrĩra andũ arĩa maarutaga wĩra wa kũrĩma mĩgũnda.<verse eid="1CH 27:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 27:27"/>Shimei ũrĩa Mũramathi nĩwe warũgamagĩrĩra mĩgũnda ya mĩthabibũ.</para>
  <para style="p" vid="1CH 27:27">Zabadi ũrĩa Mũshifimi nĩwe warũgamagĩrĩra maciaro ma mĩthabibũ matanekĩrwo mĩtũngi-inĩ.<verse eid="1CH 27:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 27:28"/>Baali-Hanani ũrĩa Mũgederi nĩwe warũgamagĩrĩra mĩtĩ ya mĩtamaiyũ na ya mĩborothandi magũrũ-inĩ ma irĩma cia mwena wa irathĩro.</para>
  <para style="p" vid="1CH 27:28">Joashu nĩwe warũgamagĩrĩra kũrĩa kwaigagwo maguta ma mĩtamaiyũ.<verse eid="1CH 27:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 27:29"/>Shitirai ũrĩa Mũsharoni nĩwe warũgamagĩrĩra ndũũru cia ngʼombe iria ciarĩithagio Sharoni.</para>
  <para style="p" vid="1CH 27:29">Shafati mũrũ wa Adilai nĩwe warũgamagĩrĩra ndũũru cia ngʼombe iria ciarĩ cianda-inĩ.<verse eid="1CH 27:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="1CH 27:30"/>Obili ũrĩa Mũishumaeli nĩwe warũgamagĩrĩra ngamĩĩra.</para>
  <para style="p" vid="1CH 27:30">Jehedeia ũrĩa Mũmeronothu nĩwe warũgamagĩrĩra ndigiri.<verse eid="1CH 27:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 27:31"/>Jazizi ũrĩa Mũhagari nĩwe warũgamagĩrĩra ndũũru cia mbũri.</para>
  <para style="p" vid="1CH 27:31">Acio othe nĩo maarĩ anene arĩa marũgamagĩrĩra indo ciothe cia Mũthamaki Daudi.<verse eid="1CH 27:31"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="32" style="v" sid="1CH 27:32"/>Jonathani mamawe wa Daudi aarĩ mũheani kĩrĩra, mũndũ mũmenyi maũndũ na mwandĩki-marũa. Nake Jehieli mũrũ wa Hakimoni nĩwe wamenyagĩrĩra ariũ a mũthamaki.<verse eid="1CH 27:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 27:33"/>Ahithofeli nĩwe waheaga mũthamaki kĩrĩra.</para>
  <para style="p" vid="1CH 27:33">Nake Hushai ũrĩa Mũariki aarĩ mũrata wa mũthamaki. <verse eid="1CH 27:33"/><verse number="34" style="v" sid="1CH 27:34"/>Jehoiada mũrũ wa Benaia na Abiatharu nĩo maacookire ithenya rĩa Ahithofeli.</para>
  <para style="p" vid="1CH 27:34">Joabu nĩwe warĩ mũnene wa mbũtũ cia ita cia mũthamaki.<verse eid="1CH 27:34"/></para>
  <chapter eid="1CH 27"/>
  <chapter number="28" style="c" sid="1CH 28"/>
  <para style="s1">Daudi Kũhaarĩria Mwako wa Hekarũ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 28:1"/>Daudi nĩatũmanĩire anene othe a Isiraeli moongane Jerusalemu, nao nĩo: anene arĩa maarũgamĩrĩire mĩhĩrĩga, na anene a ikundi iria ciatungatagĩra mũthamaki, na anene a ikundi cia o ngiri ngiri na anene a ikundi cia o igana igana, na anene arĩa maarũgamĩrĩire indo ciothe na mahiũ ma mũthamaki na ma ariũ ake o na anene a nyũmba ya ũthamaki, na andũ arĩa maarĩ njamba, na andũ othe arĩa maarĩ ũrũme wa kũrũa mbaara.<verse eid="1CH 28:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 28:2"/>Mũthamaki Daudi nĩarũgamire akĩmeera atĩrĩ: “Ta thikĩrĩriai, inyuĩ ariũ a baba na andũ akwa. Nĩndatuĩte na ngoro yakwa gwaka nyũmba ĩtuĩke handũ ha kũhurũkio ithandũkũ rĩa kĩrĩkanĩro kĩa Jehova, arĩ ho gaturwa ka makinya ma Ngai witũ, na ngĩĩhaarĩria kũmĩaka. <verse eid="1CH 28:2"/><verse number="3" style="v" sid="1CH 28:3"/>No Ngai akĩnjĩĩra atĩrĩ, ‘Wee ndũgwaka nyũmba ĩtanĩtio na Rĩĩtwa rĩakwa, tondũ wee ũrĩ mũndũ wa mbaara na nĩũitĩte thakame.’<verse eid="1CH 28:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 28:4"/>“No Jehova, Ngai wa Isiraeli, nĩathuurire kuuma kũrĩ nyũmba iitũ yothe nduĩke mũthamaki wa Isiraeli nginya tene. Nĩathuurire Juda atuĩke mũtongoria, na kuuma nyũmba ya Juda agĩthuura nyũmba ya baba, na kuuma kũrĩ ariũ a baba akĩona kwagĩrĩire aandue niĩ mũthamaki wa Isiraeli yothe. <verse eid="1CH 28:4"/><verse number="5" style="v" sid="1CH 28:5"/>Harĩ ariũ akwa othe, tondũ Jehova nĩaheete ariũ aingĩ-rĩ, nĩathuurĩte mũriũ wakwa Solomoni aikarĩre gĩtĩ kĩa ũthamaki wa Jehova, athamakĩre Isiraeli. <verse eid="1CH 28:5"/><verse number="6" style="v" sid="1CH 28:6"/>Aanjĩĩrire atĩrĩ: ‘Mũriũ waku Solomoni nĩwe ũgaaka nyũmba yakwa na nja ciakwa, nĩgũkorwo nĩndĩmũthuurĩte atuĩke mũriũ wakwa na niĩ nduĩke ithe. <verse eid="1CH 28:6"/><verse number="7" style="v" sid="1CH 28:7"/>Nĩngahaanda ũthamaki wake nginya tene angĩtũũra arũmĩtie maathani na mawatho makwa ta ũrĩa kũrekwo ihinda rĩĩrĩ.’<verse eid="1CH 28:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 28:8"/>“Nĩ ũndũ ũcio, rĩu ndamwatha o haha maitho-inĩ ma andũ a Isiraeli othe na kĩũngano gĩkĩ kĩa Jehova, o nake Ngai witũ akĩiguaga: Mũmenyerere, na mũrũmagĩrĩre maathani mothe ma Jehova Ngai wanyu, nĩgeetha mwĩgwatĩre bũrũri ũyũ mwega, na mũkaũtigĩra njiaro cianyu ũtuĩke igai rĩao nginya tene.<verse eid="1CH 28:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 28:9"/>“Nawe mũrũ wakwa Solomoni-rĩ, tũũra ũmenyete Ngai wa thoguo, na ũmũtungatagĩre wĩrutĩire na ngoro yaku yothe na kwĩyendera, nĩgũkorwo Jehova atuĩragia ngoro o yothe, na akamenya gĩtũmi o gĩothe kĩa meciiria ma cio. Ũngĩmũrongooria no ũmuone; no ũngĩmũtirika, agaakũrega nginya tene. <verse eid="1CH 28:9"/><verse number="10" style="v" sid="1CH 28:10"/>Gĩĩciirie rĩu, nĩgũkorwo Jehova nĩwe athuurĩte wa gwaka hekarũ ĩrĩ handũ hatheru. Gĩa na hinya na ũrute wĩra ũcio.”<verse eid="1CH 28:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 28:11"/>Hĩndĩ ĩyo Daudi akĩnengera mũriũ Solomoni mĩcoro ya mwako wa gĩthaku kĩa hekarũ, na nyũmba ciayo, na nyũmba cia kũigwo indo, na tũnyũmba twayo twa igũrũ, na tũnyũmba twa thĩinĩ, na handũ ha kũhoroherio mehia. <verse eid="1CH 28:11"/><verse number="12" style="v" sid="1CH 28:12"/>Akĩmũnengera mĩcoro ya mĩako yothe ĩrĩa Roho eekĩrĩte meciiria-inĩ make ĩkoniĩ nja cia hekarũ ya Jehova, na ya tũnyũmba tuothe tũrĩa twamĩthiũrũrũkĩirie na tũnyũmba twa kũigwo igĩĩna cia hekarũ ya Ngai, na gwa kũigwo igĩĩna cia indo iria nyamũre. <verse eid="1CH 28:12"/><verse number="13" style="v" sid="1CH 28:13"/>Ningĩ akĩmũtaarĩria wĩra wa ikundi cia athĩnjĩri-Ngai, na wa Alawii, na wĩra wothe wa ũtungata thĩinĩ wa hekarũ ya Jehova, o na wa indo ciothe cia kũhũthagĩrwo ũtungata-inĩ wayo. <verse eid="1CH 28:13"/><verse number="14" style="v" sid="1CH 28:14"/>Nake akĩheana mũigana wa ũritũ wa thahabu ya gũthondeka indo ciothe cia thahabu cia kũhũthagĩrwo ũtungata-inĩ wa mĩthemba o mĩthemba, na ũritũ wa betha ya gũthondeka indo ciothe cia betha cia kũhũthagĩrwo ũtungata-inĩ wa mĩthemba o mĩthemba, ta ũũ: <verse eid="1CH 28:14"/><verse number="15" style="v" sid="1CH 28:15"/>ũritũ wa thahabu ya gũthondeka mĩtĩ ya thahabu ya kũigĩrĩrwo matawa na matawa mayo, na ũritũ wa o mũtĩ na matawa maguo; na ũritũ wa betha ya gũthondeka o mũtĩ wa betha wa kũigĩrĩra tawa na matawa maguo, kũringana na ũrĩa mũtĩ wa kũigĩrĩra matawa wahũthagĩrwo: <verse eid="1CH 28:15"/><verse number="16" style="v" sid="1CH 28:16"/>ũritũ wa thahabu ya gũthondeka metha ya kũigĩrĩra mĩgate ĩrĩa mĩamũre; na ũritũ wa betha ya gũthondeka metha cia betha; <verse eid="1CH 28:16"/><verse number="17" style="v" sid="1CH 28:17"/>na ũritũ wa thahabu therie ya gũthondeka hũũma, na mbakũri cia kũminjaminjĩria, na nyũngũ, ũritũ wa thahabu ya gũthondeka o thaani ya thahabu; na ũritũ wa betha ya gũthondeka o thaani ya betha; <verse eid="1CH 28:17"/><verse number="18" style="v" sid="1CH 28:18"/>na ũritũ wa thahabu therie ya gũthondeka kĩgongona gĩa gũcinĩrwo ũbumba. O na ningĩ akĩmũnengera mũcoro wa ngaari ya ita, ũguo nĩ kuuga ya makerubi ma thahabu marĩa maatambũrũkĩtie mathagu makahumbĩra ithandũkũ rĩa kĩrĩkanĩro kĩa Jehova.<verse eid="1CH 28:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 28:19"/>Daudi akiuga atĩrĩ, “Maũndũ maya mothe ndĩmandĩkĩte ũrĩa ndatongoririo nĩ guoko kwa Jehova kũrĩ igũrũ rĩakwa, na akĩĩhe ũmenyo wa maũndũ mothe ma mũcoro ũyũ.”<verse eid="1CH 28:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 28:20"/>Ningĩ Daudi akĩĩra mũriũ Solomoni atĩrĩ, “Gĩa na hinya na wĩyũmĩrĩrie, na ũrute wĩra ũcio. Ndũgetigĩre na ndũgakue ngoro, tondũ Jehova Ngai, o we Ngai wakwa, arĩ hamwe nawe. Ndagagũtiganĩria kana agũtirike nginya rĩrĩa wĩra wothe ũrĩa ũkaarutwo nĩ ũndũ wa ũtungata wa hekarũ ya Jehova ũgaathira. <verse eid="1CH 28:20"/><verse number="21" style="v" sid="1CH 28:21"/>Ikundi cia athĩnjĩri-Ngai na Alawii, nĩciĩhaarĩrie nĩ ũndũ wa wĩra wothe wa hekarũ ya Ngai, na mũndũ o wothe ũrĩ na wendo na nĩoĩ wĩra wa ũbundi o wothe nĩagagũteithia wĩra-inĩ ũyũ. Anene na andũ othe nĩmarĩathĩkagĩra wathani waku wothe.”<verse eid="1CH 28:21"/></para>
  <chapter eid="1CH 28"/>
  <chapter number="29" style="c" sid="1CH 29"/>
  <para style="s1">Iheo cia Gwaka Hekarũ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 29:1"/>Ningĩ Mũthamaki Daudi akĩĩra kĩũngano kĩu gĩothe atĩrĩ: “Mũriũ wakwa Solomoni, ũrĩa Ngai athuurĩte, nĩ mwĩthĩ na ndarĩ na ũmenyo wa kũigana. Wĩra ũyũ nĩ mũnene, tondũ nyũmba ĩno ĩhaana ta ya ũthamaki ti ya mũndũ no nĩ ya Jehova Ngai. <verse eid="1CH 29:1"/><verse number="2" style="v" sid="1CH 29:2"/>Nĩnjigithĩtie indo na ũhoti wakwa wothe nĩ ũndũ wa hekarũ ya Ngai wakwa, ngaiga thahabu nĩ ũndũ wa gũthondeka indo cia thahabu, na betha nĩ ũndũ wa gũthondeka indo cia betha, na gĩcango nĩ ũndũ wa gũthondeka indo cia gĩcango, na kĩgera nĩ ũndũ wa gũthondeka indo cia kĩgera, na mbaũ nĩ ũndũ wa gũthondeka indo cia mbaũ, o na tũhiga tũrĩa twĩtagwo onigithi tũrĩa tũtheecagĩrĩrwo indo-inĩ, na tũhiga tũrĩa tũhenagia twa kũgemia nyũmba, na tũhiga twa rangi wa mĩthemba mĩingĩ, na tũhiga twa goro twa mĩthemba mĩingĩ, na mahiga ma nyaigĩ ma mũthemba ũrĩa mwega, indo icio ciothe ngaigithia irĩ nyingĩ mũno. <verse eid="1CH 29:2"/><verse number="3" style="v" sid="1CH 29:3"/>Makĩria ma ũguo, harĩ kwĩrutĩra gwakwa igũrũ rĩa hekarũ ya Ngai wakwa nĩngũheana kĩgĩĩna gĩakwa mwene gĩa thahabu na betha nĩ ũndũ wa hekarũ ya Ngai wakwa, na icio ngũciheana nyongerere kĩrĩa kĩngĩ njigithĩtie nĩ ũndũ wa hekarũ ĩno theru: <verse eid="1CH 29:3"/><verse number="4" style="v" sid="1CH 29:4"/>ngũheana taranda ngiri ithatũ<note caller="+" style="f"><char style="fr" closed="false">29:4 </char><char style="ft" closed="false">nĩ ta tani 100</char></note> cia thahabu, o thahabu ĩrĩa ya Ofiri, na taranda ngiri mũgwanja<note caller="+" style="f"><char style="fr" closed="false">29:4 </char><char style="ft" closed="false">nĩ ta tani 240</char></note> cia betha ĩrĩa therie nĩ ũndũ wa kũgemia thingo cia nyũmba, <verse eid="1CH 29:4"/><verse number="5" style="v" sid="1CH 29:5"/>o na nĩ ũndũ wa wĩra wa thahabu na indo cia wĩra wa betha ũrĩa wothe ũkaarutwo nĩ mabundi. Na rĩrĩ, nũũ ũkwĩĩamũrĩra Jehova ũmũthĩ na kwĩyendera?”<verse eid="1CH 29:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 29:6"/>Hĩndĩ ĩyo atongoria a nyũmba, na anene a mĩhĩrĩga ya Isiraeli, na anene a ikundi cia ngiri ngiri na anene a ikundi cia igana igana na anene arĩa maarũgamagĩrĩra wĩra wa mũthamaki makĩheana indo na kwĩyendera. <verse eid="1CH 29:6"/><verse number="7" style="v" sid="1CH 29:7"/>Nĩ ũndũ wa wĩra wa hekarũ ya Ngai nĩmaheanire taranda ngiri ithano,<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="ft" closed="false">nĩ ta tani 170</char></note> na dariki ngiri ikũmi<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="ft" closed="false">nĩ ta kilo 84</char></note> cia thahabu, na taranda ngiri ikũmi<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="ft" closed="false">nĩ ta tani 345</char></note> cia betha, na taranda ngiri ikũmi na inyanya<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="ft" closed="false">nĩ ta tani 620</char></note> cia gĩcango, na taranda ngiri igana rĩmwe<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="ft" closed="false">nĩ ta tani 3,450</char></note> cia kĩgera. <verse eid="1CH 29:7"/><verse number="8" style="v" sid="1CH 29:8"/>Mũndũ o wothe warĩ na tũhiga twa goro nĩatũheanire thĩinĩ wa kĩgĩĩna kĩa hekarũ ya Jehova kĩrĩa kĩamenyagĩrĩrwo nĩ Jehieli ũrĩa Mũgerishoni. <verse eid="1CH 29:8"/><verse number="9" style="v" sid="1CH 29:9"/>Andũ nĩmakenirio nĩ ũrĩa atongoria ao maamũkĩire ũhoro ũcio na kwĩyendera, tondũ nĩmarutĩire Jehova indo na ngoro yao yothe matekũringĩrĩrio. Mũthamaki Daudi o nake nĩakenire mũno.<verse eid="1CH 29:9"/></para>
  <para style="s1">Ihooya rĩa Daudi</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 29:10"/>Daudi nĩagoocire Jehova arĩ mbere ya kĩũngano kĩu gĩothe, akiuga atĩrĩ,</para>
  <para style="q1" vid="1CH 29:10">“Ũrogoocwo wee, o Wee Jehova,</para>
  <para style="q2" vid="1CH 29:10">Ngai wa ithe witũ Isiraeli,</para>
  <para style="q2" vid="1CH 29:10">kuuma tene nginya tene.<verse eid="1CH 29:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 29:11"/>Wee Jehova-rĩ, ũnene, na hinya,</para>
  <para style="q2" vid="1CH 29:11">na riiri, na wathani, na ũkengi nĩ ciaku,</para>
  <para style="q2" vid="1CH 29:11">nĩgũkorwo kĩndũ o gĩothe kĩrĩ igũrũ na thĩ nĩ gĩaku.</para>
  <para style="q1" vid="1CH 29:11">Wee Jehova, ũthamaki nĩ waku;</para>
  <para style="q2" vid="1CH 29:11">nĩũtũũgĩrĩtio, ũkanenehio gũkĩra indo ciothe.<verse eid="1CH 29:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="1CH 29:12"/>Ũtonga na gĩtĩĩo ciumaga kũrĩ we;</para>
  <para style="q2" vid="1CH 29:12">Wee nĩwe wathaga indo ciothe.</para>
  <para style="q1" vid="1CH 29:12">Hinya na ũhoti wa gũtũũgĩria</para>
  <para style="q2" vid="1CH 29:12">o na kũhe andũ othe hinya irĩ moko-inĩ maku.<verse eid="1CH 29:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 29:13"/>Na rĩrĩ, Ngai witũ, nĩtũgũgũcookeria ngaatho,</para>
  <para style="q2" vid="1CH 29:13">na tũkagooca rĩĩtwa rĩaku rĩrĩ riiri.<verse eid="1CH 29:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 29:14"/>“No niĩ ngĩrĩ ũ, nao andũ akwa-rĩ, makĩrĩ a, atĩ no tũhote kũheana na ũtaana ta ũyũ? Indo ciothe ciumaga kũrĩ we, na kĩrĩa twakũhe no kĩrĩa kiumĩte moko-inĩ maku. <verse eid="1CH 29:14"/><verse number="15" style="v" sid="1CH 29:15"/>Ithuĩ tũrĩ ageni na agendi maitho-inĩ maku, o ta ũrĩa maithe maitũ ma tene othe maatariĩ. Matukũ maitũ gũkũ thĩ matariĩ o ta kĩĩruru, na gũtirĩ mwĩhoko wa gũtũũra. <verse eid="1CH 29:15"/><verse number="16" style="v" sid="1CH 29:16"/>Wee Jehova Ngai witũ, ũingĩ wa indo ici twaruta cia gũgwakĩra hekarũ nĩ ũndũ wa Rĩĩtwa rĩaku Itheru ciumĩte guoko-inĩ gwaku, na ciothe no ciaku. <verse eid="1CH 29:16"/><verse number="17" style="v" sid="1CH 29:17"/>Niĩ nĩnjũũĩ atĩ Wee Ngai wakwa nĩũtuĩragia ngoro, na nĩũkenagio nĩ ũrũngĩrĩru wa ngoro. Indo ici ciothe ndĩciheanĩte na kwĩyendera na wĩhokeku. Na rĩu ndĩ na gĩkeno nĩ ũndũ wa kwĩonera ũrĩa andũ aya aku marĩ haha makũrutĩire indo na wendo. <verse eid="1CH 29:17"/><verse number="18" style="v" sid="1CH 29:18"/>Wee Jehova, Ngai wa maithe maitũ Iburahĩmu, na Isaaka na Isiraeli, tũũria wendo ũyũ ũrĩ ngoro-inĩ cia andũ aku nginya tene na ũtũme matũũre magwathĩkagĩra. <verse eid="1CH 29:18"/><verse number="19" style="v" sid="1CH 29:19"/>Na ũhotithie mũriũ wakwa Solomoni kwĩrutĩra na ngoro yake yothe, kũmenyagĩrĩra maathani maku, na maũndũ marĩa wee wendaga o na kĩrĩra gĩaku kĩa watho wa kũrũmĩrĩrwo, na ekage maũndũ mothe nĩguo aake mwako wa nyũmba ĩno ĩhaana ta nyũmba ya ũthamaki, ĩrĩa niĩ njigithĩirie indo ciayo.”<verse eid="1CH 29:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 29:20"/>Ningĩ Daudi akĩĩra kĩũngano gĩothe atĩrĩ, “Goocai Jehova Ngai wanyu.” Nĩ ũndũ ũcio andũ othe makĩgooca Jehova Ngai wa maithe mao; makĩinamĩrĩra, na makĩĩgũithia thĩ mbere ya Jehova na mbere ya mũthamaki.<verse eid="1CH 29:20"/></para>
  <para style="s1">Solomoni Kwamũkĩrwo ta Mũthamaki</para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 29:21"/>Mũthenya ũyũ ũngĩ makĩrutĩra Jehova magongona na makĩmũrutĩra maruta ma njino, ta ũũ: ndegwa ngiri ĩmwe, na ndũrũme ngiri ĩmwe na tũtũrũme ngiri ĩmwe, o hamwe na maruta mao ma indo cia kũnyuuo na magongona mangĩ maingĩ nĩ ũndũ wa andũ a Isiraeli othe. <verse eid="1CH 29:21"/><verse number="22" style="v" sid="1CH 29:22"/>Makĩrĩa na makĩnyua marĩ na gĩkeno kĩnene mũthenya ũcio marĩ hau mbere ya Jehova.</para>
  <para style="p" vid="1CH 29:22">Ningĩ makĩamũkĩra Solomoni mũrũ wa Daudi arĩ mũthamaki hĩndĩ ya keerĩ, na makĩmũitĩrĩria maguta mbere ya Jehova atuĩke wa kũmathamakĩra, nake Zadoku atuĩke mũthĩnjĩri-Ngai. <verse eid="1CH 29:22"/><verse number="23" style="v" sid="1CH 29:23"/>Nĩ ũndũ ũcio Solomoni agĩikarĩra gĩtĩ gĩa ũthamaki kĩa Jehova, na agĩtuĩka mũthamaki ithenya rĩa ithe Daudi. Nake akĩgaacĩra na agĩathĩkĩrwo Isiraeli guothe. <verse eid="1CH 29:23"/><verse number="24" style="v" sid="1CH 29:24"/>Anene othe, na andũ arĩa maarĩ njamba, hamwe na ariũ a Mũthamaki Daudi othe magĩtĩkĩra Mũthamaki Solomoni amaathage.<verse eid="1CH 29:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 29:25"/>Jehova agĩtũũgĩria Solomoni mũno maitho-inĩ ma andũ a Isiraeli othe, na akĩmũhe ũthamaki ũrĩ na riiri ũtaahetwo mũthamaki ũngĩ wa Isiraeli mbere ĩyo.<verse eid="1CH 29:25"/></para>
  <para style="s1">Gĩkuũ kĩa Daudi</para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 29:26"/>Daudi mũrũ wa Jesii aarĩ mũthamaki wa Isiraeli guothe. <verse eid="1CH 29:26"/><verse number="27" style="v" sid="1CH 29:27"/>Aathamakĩire Isiraeli mĩaka mĩrongo ĩna, mĩaka mũgwanja yayo agĩthamaka arĩ Hebironi, nayo mĩaka mĩrongo ĩtatũ na ĩtatũ agĩthamaka arĩ Jerusalemu. <verse eid="1CH 29:27"/><verse number="28" style="v" sid="1CH 29:28"/>Aakuire arĩ mũkũrũ mũno, arĩkĩtie gũkenera gũtũũra gwake matukũ maingĩ, na arĩ mũtongu, na agatĩĩo. Mũriũ Solomoni nĩwe wathamakire ithenya rĩake.<verse eid="1CH 29:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 29:29"/>Naho ha maũndũ marĩa makoniĩ wathani wa Mũthamaki Daudi kuuma kĩambĩrĩria nginya mũthia, nĩmandĩkĩtwo thĩinĩ wa maandĩko ma Samũeli ũrĩa warĩ muoni-maũndũ, na maandĩko-inĩ ma Nathani ũrĩa mũnabii na maandĩko-inĩ ma Gadi ũrĩa muoni-maũndũ, <verse eid="1CH 29:29"/><verse number="30" style="v" sid="1CH 29:30"/>hamwe na maũndũ mothe marĩa maakoniĩ ũthamaki wake na ũhoti ũrĩa aarĩ naguo, na ũrĩa maũndũ marĩa maamũthiũrũrũkĩirie maatariĩ na ma Isiraeli na mothamaki ma mabũrũri marĩa mangĩ mothe.<verse eid="1CH 29:30"/></para>
  <chapter eid="1CH 29"/>
</usx>
