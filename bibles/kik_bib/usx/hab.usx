<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HAB" style="id">- Biblica® Open Kikuyu Holy Word of God</book>
  
  <para style="h">Habakuku</para>
  <para style="toc1">Habakuku</para>
  <para style="toc2">Habakuku</para>
  <para style="toc3">Hab</para>
  <para style="mt1">HABAKUKU</para>
  <chapter number="1" style="c" sid="HAB 1" />
  <para style="p">
    <verse number="1" style="v" sid="HAB 1:1" />Ĩno nĩyo ndũmĩrĩri nditũ ĩrĩa yakinyĩrĩire mũnabii Habakuku.<verse eid="HAB 1:1" /></para>
  <para style="s1">Gũteta kwa Habakuku</para>
  <para style="q1">
    <verse number="2" style="v" sid="HAB 1:2" />Wee Jehova-rĩ, nĩ nginya rĩ ngũtũũra ngũkayagĩra ũndeithie,</para>
  <para style="q2" vid="HAB 1:2">no wee ũkaaga kũnjigua?</para>
  <para style="q1" vid="HAB 1:2">Githĩ ndigũkayagĩra ngiugaga, “Haaro! Haaro!”</para>
  <para style="q2" vid="HAB 1:2">no wee ũkaaga kũhonokania?<verse eid="HAB 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HAB 1:3" />Ũtũmaga ndĩrorere wagi wa kĩhooto nĩkĩ?</para>
  <para style="q2" vid="HAB 1:3">Ũkiragĩrĩria maũndũ mooru nĩkĩ?</para>
  <para style="q1" vid="HAB 1:3">Mwanangĩko na haaro irĩ mbere yakwa;</para>
  <para style="q2" vid="HAB 1:3">kũrĩ na njũgitano, nayo mbaara nĩ nyingĩ.<verse eid="HAB 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HAB 1:4" />Nĩ ũndũ ũcio, watho nĩmwagithie hinya,</para>
  <para style="q2" vid="HAB 1:4">na kĩhooto gĩtihootanaga.</para>
  <para style="q1" vid="HAB 1:4">Andũ arĩa aaganu marigiicaga arĩa athingu,</para>
  <para style="q2" vid="HAB 1:4">na nĩ ũndũ ũcio kĩhooto gĩkoogomio.<verse eid="HAB 1:4" /></para>
  <para style="s1">Icookia rĩa Jehova</para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 1:5" />“Atĩrĩrĩ, ta rorai ndũrĩrĩ na mwĩrorere ũhoro wacio,</para>
  <para style="q2" vid="HAB 1:5">na mũmake biũ.</para>
  <para style="q1" vid="HAB 1:5">Nĩgũkorwo matukũ-inĩ maku nĩngwĩka ũndũ</para>
  <para style="q2" vid="HAB 1:5">ũrĩa ũtangĩĩtĩkia o na ũngĩĩrwo.<verse eid="HAB 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HAB 1:6" />Nĩngwarahũra andũ a Babuloni,</para>
  <para style="q2" vid="HAB 1:6">andũ a haaro, na matarĩ tha,</para>
  <para style="q1" vid="HAB 1:6">arĩa matuĩkanagia thĩ yothe,</para>
  <para style="q2" vid="HAB 1:6">na makegwatĩra ciikaro itarĩ ciao.<verse eid="HAB 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 1:7" />Nĩ andũ a kũmakania, na a gwĩtigĩrwo;</para>
  <para style="q2" vid="HAB 1:7">nĩo meyathaga, na magetũũgĩria.<verse eid="HAB 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HAB 1:8" />Mbarathi ciao irĩ ihenya gũkĩra ngarĩ,</para>
  <para style="q2" vid="HAB 1:8">na nĩ ooru mũno gũkĩra njũũi iria icangacangaga kĩhwaĩ-inĩ.</para>
  <para style="q1" vid="HAB 1:8">Thigari ciao iria ithiiaga ihaicĩte mbarathi itengʼeraga ta ciũmbũkĩte;</para>
  <para style="q2" vid="HAB 1:8">ahaici acio a mbarathi moimaga kũndũ kũraya.</para>
  <para style="q1" vid="HAB 1:8">Mombũkaga ta nderi ĩgĩcuuhũkĩra gĩa kũrĩa;<verse eid="HAB 1:8" /></para>
  <para style="q2">
    <verse number="9" style="v" sid="HAB 1:9" />othe mokaga mehaarĩirie kũruta haaro.</para>
  <para style="q1" vid="HAB 1:9">Thigari icio ciao nyingĩ mũno ithiiaga ihaatĩte ta rũhuho rwa werũ-inĩ,</para>
  <para style="q2" vid="HAB 1:9">igathiĩ itahĩte andũ aingĩ mũno ta mũthanga.<verse eid="HAB 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HAB 1:10" />Manyararaga athamaki,</para>
  <para style="q2" vid="HAB 1:10">na makanyũrũria andũ arĩa maathanaga.</para>
  <para style="q1" vid="HAB 1:10">Mathekagĩrĩra matũũra mothe manene marĩa mairigĩre;</para>
  <para style="q2" vid="HAB 1:10">maakaga ihumbu cia tĩĩri, magatunyana matũũra macio.<verse eid="HAB 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HAB 1:11" />Ningĩ mahĩtũkagĩra kuo na ihenya o ta rũhuho mathiĩte na mbere:</para>
  <para style="q2" vid="HAB 1:11">andũ maagararaga watho, magatuĩka ehia,</para>
  <para style="q2" vid="HAB 1:11">magatua atĩ hinya wao nĩguo ngai yao.”<verse eid="HAB 1:11" /></para>
  <para style="s1">Gũteta gwa Keerĩ kwa Habakuku</para>
  <para style="q1">
    <verse number="12" style="v" sid="HAB 1:12" />Wee Jehova-rĩ, githĩ ndũtũũraga kuuma tene o na tene?</para>
  <para style="q2" vid="HAB 1:12">O Wee Ngai wakwa, ũrĩa wakwa mũtheru, tondũ ũcio tũtigakua.</para>
  <para style="q1" vid="HAB 1:12">Wee Jehova-rĩ, nĩwe ũthuurĩte andũ a Babuloni mahingie ituĩro rĩaku;</para>
  <para style="q2" vid="HAB 1:12">wee Rwaro rwa Ihiga-rĩ, ũkamaamũra matũherithie.<verse eid="HAB 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 1:13" />Maitho maku nĩ matheru mũno, matingĩĩrorera ũmaramari;</para>
  <para style="q2" vid="HAB 1:13">wee-rĩ, ndũngĩkirĩrĩria maũndũ mooru.</para>
  <para style="q1" vid="HAB 1:13">Ũgĩkiragĩrĩria andũ arĩa oingumania nĩkĩ?</para>
  <para style="q2" vid="HAB 1:13">Ũkiraga nĩkĩ rĩrĩa andũ arĩa aaganu</para>
  <para style="q2" vid="HAB 1:13">mekũmeria andũ arĩa athingu kũmakĩra?<verse eid="HAB 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HAB 1:14" />Ũtuĩte andũ ta thamaki cia iria,</para>
  <para style="q2" vid="HAB 1:14">ũkamatua ta ciũmbe cia iria-inĩ, iria itarĩ mũciathi.<verse eid="HAB 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HAB 1:15" />Thũ ĩyo njaganu ĩmaguucagia othe na ndwano,</para>
  <para style="q2" vid="HAB 1:15">ĩkamagwatia na wabu wayo,</para>
  <para style="q1" vid="HAB 1:15">ĩkamacookereria thĩinĩ wa mũtego wayo;</para>
  <para style="q2" vid="HAB 1:15">nĩ ũndũ ũcio ĩgakena na ĩgacanjamũka.<verse eid="HAB 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HAB 1:16" />Nĩ ũndũ ũcio, ĩrutagĩra wabu wayo igongona,</para>
  <para style="q2" vid="HAB 1:16">na ĩgacinĩra mũtego wayo ũbumba,</para>
  <para style="q1" vid="HAB 1:16">nĩgũkorwo wabu wayo nĩguo ũtũmaga ĩtũũre ĩĩkenagia,</para>
  <para style="q2" vid="HAB 1:16">na ĩkarĩĩaga irio iria njega mũno.<verse eid="HAB 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="HAB 1:17" />Ĩĩgũtũũra ĩtahaga na wabu wayo,</para>
  <para style="q2" vid="HAB 1:17">ĩkaniinaga ndũrĩrĩ ingĩ ĩtegũciguĩra tha?<verse eid="HAB 1:17" /></para>
  <para style="b" />
  <chapter eid="HAB 1" />
  <chapter number="2" style="c" sid="HAB 2" />
  <para style="q1">
    <verse number="1" style="v" sid="HAB 2:1" />Nĩngũrũgama handũ hakwa ha kũrangĩra,</para>
  <para style="q2" vid="HAB 2:1">na njikare o hau rũthingo igũrũ.</para>
  <para style="q1" vid="HAB 2:1">Njetereire njigue ũrĩa ekũnjĩĩra,</para>
  <para style="q2" vid="HAB 2:1">nĩguo menye ũrĩa ingĩcookia nĩ ũndũ wa iteta rĩĩrĩ.<verse eid="HAB 2:1" /></para>
  <para style="s1">Icookia rĩa Jehova</para>
  <para style="p">
    <verse number="2" style="v" sid="HAB 2:2" />Nake Jehova akĩnjookeria atĩrĩ,</para>
  <para style="q1" vid="HAB 2:2">“Andĩka ũguũrio ũyũ,</para>
  <para style="q2" vid="HAB 2:2">ũwandĩke wega ihengere-inĩ na ndemwa nene,</para>
  <para style="q1" vid="HAB 2:2">nĩgeetha ũthomeke wega,</para>
  <para style="q2" vid="HAB 2:2">o na mũndũ angĩkorwo atengʼerete.<verse eid="HAB 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HAB 2:3" />Nĩgũkorwo ũguũrio ũyũ wetereire ihinda rĩrĩa rĩtuĩtwo;</para>
  <para style="q2" vid="HAB 2:3">waragia ũhoro wa matukũ ma mũthia,</para>
  <para style="q2" vid="HAB 2:3">na ndũngĩtuĩka wa maheeni.</para>
  <para style="q1" vid="HAB 2:3">O na ũngĩikara mũno-rĩ, weterere.</para>
  <para style="q2" vid="HAB 2:3">Ti-itherũ nĩũkahingio, na ndũgatĩĩrio.<verse eid="HAB 2:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="HAB 2:4" />“Atĩrĩrĩ, mũndũ mwĩtĩĩi-rĩ,</para>
  <para style="q2" vid="HAB 2:4">merirĩria maake ti marũngĩrĩru;</para>
  <para style="q2" vid="HAB 2:4">no mũndũ ũrĩa mũthingu</para>
  <para style="q2" vid="HAB 2:4">agatũũra muoyo nĩ ũndũ wa gwĩtĩkia gwake;<verse eid="HAB 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 2:5" />ti-itherũ, mũndũ ũcio mwĩtĩĩi nĩakunyanagĩrwo nĩ ndibei;</para>
  <para style="q2" vid="HAB 2:5">nĩ mwĩtĩĩi na ndarĩ hĩndĩ ahurũkaga.</para>
  <para style="q1" vid="HAB 2:5">Tondũ akorokete ta mbĩrĩra,</para>
  <para style="q2" vid="HAB 2:5">na o ta ũrĩa gĩkuũ gĩtaiganagia,</para>
  <para style="q1" vid="HAB 2:5">o nake ndaiganagia;</para>
  <para style="q2" vid="HAB 2:5">acookanagĩrĩria ndũrĩrĩ ciothe harĩ we,</para>
  <para style="q2" vid="HAB 2:5">na agataha andũ a ndũrĩrĩ ciothe.<verse eid="HAB 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HAB 2:6" />“Githĩ andũ othe matikamũthekerera makĩmũnyũrũragia, na mamũnyarare, makiugaga atĩrĩ,</para>
  <para style="q1" vid="HAB 2:6">“ ‘Kaĩ mũndũ ũrĩa wĩigagĩra indo cia ũici,</para>
  <para style="q2" vid="HAB 2:6">na agetongia na indo cia ũtunyani arĩ na haaro-ĩ!</para>
  <para style="q2" vid="HAB 2:6">Egũtũũra ekaga ũguo nginya-rĩ?’<verse eid="HAB 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 2:7" />Andũ arĩa ũrĩ na thiirĩ wao githĩ matigagũũkĩrĩra o rĩmwe?</para>
  <para style="q2" vid="HAB 2:7">Githĩ matikaarahũka, na matũme ũinaine,</para>
  <para style="q2" vid="HAB 2:7">macooke makũnyamarie?<verse eid="HAB 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HAB 2:8" />Tondũ nĩũtahĩte ndũrĩrĩ nyingĩ indo ciao,</para>
  <para style="q2" vid="HAB 2:8">matigari ma ndũrĩrĩ icio, nĩmagagũtaha indo o nawe.</para>
  <para style="q1" vid="HAB 2:8">Nĩ ũndũ nĩũitĩte thakame ya andũ,</para>
  <para style="q2" vid="HAB 2:8">na ũkaananga mabũrũri, na matũũra manene, o na arĩa othe marĩ kuo.<verse eid="HAB 2:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="HAB 2:9" />“Mũndũ ũrĩa wakaga wathani wake,</para>
  <para style="q2" vid="HAB 2:9">na agetongia na uumithio ũtarĩ wa kĩhooto,</para>
  <para style="q1" vid="HAB 2:9">nĩgeetha aake nyũmba yake handũ igũrũ</para>
  <para style="q2" vid="HAB 2:9">nĩguo ehonokie ndakanyiitwo nĩ mwanangĩko,</para>
  <para style="q2" vid="HAB 2:9">kaĩ arĩ na haaro-ĩ!<verse eid="HAB 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HAB 2:10" />Wee wanaciirĩra kũniinwo kwa ndũrĩrĩ nyingĩ,</para>
  <para style="q2" vid="HAB 2:10">ũgaconorithia nyũmba yaku mwene,</para>
  <para style="q2" vid="HAB 2:10">na ũkoorwo nĩ muoyo waku.<verse eid="HAB 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HAB 2:11" />Mahiga ma rũthingo nĩmakanĩrĩra,</para>
  <para style="q2" vid="HAB 2:11">na mĩgamba ya mbaũ nĩĩkamũkĩria.<verse eid="HAB 2:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="HAB 2:12" />“Mũndũ ũrĩa wakithagia itũũra inene na ũiti wa thakame,</para>
  <para style="q2" vid="HAB 2:12">na akahaanda itũũra na njĩra cia ũmaramari, kaĩ arĩ na haaro-ĩ!<verse eid="HAB 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 2:13" />Githĩ Jehova Mwene-Hinya-Wothe ndatuĩte</para>
  <para style="q2" vid="HAB 2:13">atĩ wĩra wa andũ no ngũ cia gwakĩrĩria mwaki,</para>
  <para style="q2" vid="HAB 2:13">na atĩ ndũrĩrĩ ciĩnogagia o tũhũ?<verse eid="HAB 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HAB 2:14" />Nĩgũkorwo thĩ nĩĩkaiyũrwo nĩ ũmenyo wa riiri wa Jehova,</para>
  <para style="q2" vid="HAB 2:14">o ta ũrĩa maaĩ maiyũrĩte iria-inĩ.<verse eid="HAB 2:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="HAB 2:15" />“Mũndũ ũrĩa ũheaga andũ a itũũra rĩake njoohi,</para>
  <para style="q2" vid="HAB 2:15">akamatahĩria mondo-inĩ ya rũũa ya ndibei nginya makarĩĩo,</para>
  <para style="q2" vid="HAB 2:15">nĩgeetha erorere njaga yao, kaĩ arĩ na haaro-ĩ!<verse eid="HAB 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HAB 2:16" />Ũkaiyũrwo nĩ thoni, handũ ha kũgĩa na riiri.</para>
  <para style="q2" vid="HAB 2:16">Rĩĩrĩ nĩrĩo ihinda rĩaku!</para>
  <para style="q1" vid="HAB 2:16">Nyua, ũrĩĩo,</para>
  <para style="q2" vid="HAB 2:16">nayo njaga yaku yoneke!</para>
  <para style="q1" vid="HAB 2:16">Gĩkombe kuuma guoko-inĩ kwa ũrĩo kwa Jehova</para>
  <para style="q2" vid="HAB 2:16">nĩkĩragũkora, na njono nĩikũhumbĩra riiri waku.<verse eid="HAB 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="HAB 2:17" />Haaro ĩrĩa ũrutĩire Lebanoni-rĩ, nĩĩgakũhubĩkania,</para>
  <para style="q2" vid="HAB 2:17">na wanangi waku wa nyamũ-rĩ, nĩũgakũmakia mũno.</para>
  <para style="q1" vid="HAB 2:17">Nĩ ũndũ nĩũitĩte thakame ya andũ,</para>
  <para style="q2" vid="HAB 2:17">na ũkaananga mabũrũri, na matũũra manene, na arĩa othe marĩ kuo.<verse eid="HAB 2:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="HAB 2:18" />“Mũhianano mũicũhie nĩ wa bata ũrĩkũ mũndũ aarĩkia kũwacũhia?</para>
  <para style="q2" vid="HAB 2:18">O naguo mũhianano wa gũtwekio ũrĩa ũtũmaga andũ maheeneke nĩ wa bata ũrĩkũ?</para>
  <para style="q1" vid="HAB 2:18">Nĩgũkorwo ũrĩa ũũthondekaga ehokaga kĩrĩa ombĩte;</para>
  <para style="q2" vid="HAB 2:18">athondekaga mĩhianano ĩtaaragia.<verse eid="HAB 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="HAB 2:19" />Mũndũ ũrĩa wĩraga rũbaũ atĩrĩ, ‘Gĩa na muoyo!’</para>
  <para style="q2" vid="HAB 2:19">Kana akeera ihiga rĩtarĩ muoyo atĩrĩ, ‘Arahũka!’ Kaĩ arĩ na haaro-ĩ!</para>
  <para style="q1" vid="HAB 2:19">Indo ta icio ciakĩhota kuonia mũndũ njĩra?</para>
  <para style="q2" vid="HAB 2:19">Ihumbĩtwo thahabu na betha;</para>
  <para style="q2" vid="HAB 2:19">no itirĩ na mĩhũmũ thĩinĩ wacio.<verse eid="HAB 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="HAB 2:20" />No rĩrĩ, Jehova arĩ hekarũ-inĩ yake theru;</para>
  <para style="q2" vid="HAB 2:20">thĩ yothe nĩĩkire ki ĩrĩ mbere yake.”<verse eid="HAB 2:20" /></para>
  <chapter eid="HAB 2" />
  <chapter number="3" style="c" sid="HAB 3" />
  <para style="s1">Ihooya rĩa Habakuku</para>
  <para style="p">
    <verse number="1" style="v" sid="HAB 3:1" />Rĩrĩ nĩ ihooya rĩa mũnabii Habakuku, rĩa kũinwo ta rwĩmbo.<verse eid="HAB 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HAB 3:2" />Atĩrĩrĩ Jehova, nĩnjiguĩte ũhoro wa ngumo yaku,</para>
  <para style="q2" vid="HAB 3:2">nganyiitwo nĩ guoya nĩ ũndũ wa ciĩko ciaku.</para>
  <para style="q1" vid="HAB 3:2">Rurumũkia ciĩko ciaku matukũ-inĩ maya maitũ,</para>
  <para style="q2" vid="HAB 3:2">ũtũme imenyeke matukũ-inĩ maitũ;</para>
  <para style="q2" vid="HAB 3:2">o na hĩndĩ ĩrĩa ũrĩ mũrakaru, iguanagĩra tha.<verse eid="HAB 3:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="HAB 3:3" />Ngai ookire oimĩte Temani,</para>
  <para style="q2" vid="HAB 3:3">ũcio Mũtheru agĩũka oimĩte Kĩrĩma kĩa Parani.</para>
  <para style="q1" vid="HAB 3:3">Riiri wake ũkĩhumbĩra igũrũ,</para>
  <para style="q2" vid="HAB 3:3">naguo ũgooci wake ũkĩiyũra thĩ.<verse eid="HAB 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HAB 3:4" />Ũkengi wake wahaanaga ta riũa rĩkĩratha;</para>
  <para style="q2" vid="HAB 3:4">mĩrũri yahenũkaga kuuma guoko-inĩ gwake,</para>
  <para style="q2" vid="HAB 3:4">naho hau nĩho hinya wake wahithĩtwo.<verse eid="HAB 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 3:5" />Mũthiro nĩguo wamũtongoragia;</para>
  <para style="q2" vid="HAB 3:5">mũrimũ wa mũthiro ũkamuuma thuutha.<verse eid="HAB 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HAB 3:6" />Aarũgamire, agĩthingithia thĩ;</para>
  <para style="q2" vid="HAB 3:6">agĩcũthĩrĩria agĩtũma ndũrĩrĩ ciinaine.</para>
  <para style="q1" vid="HAB 3:6">Irĩma cia tene ikĩmumuthũka,</para>
  <para style="q2" vid="HAB 3:6">natuo tũrĩma twa tene tũkĩmomoka.</para>
  <para style="q2" vid="HAB 3:6">Mĩthiĩre yake-rĩ, nĩ ya tene na tene.<verse eid="HAB 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 3:7" />Nĩndonire andũ arĩa matũũraga hema cia Kushani marĩ na mĩnyamaro,</para>
  <para style="q2" vid="HAB 3:7">nao arĩa matũũraga Midiani maiyũrĩtwo nĩ ruo rũnene.<note caller="+" style="f"><char style="fr" closed="false">3:7 </char><char style="ft" closed="false">Andũ a Kushani na Midiani maarĩ Aarabu arĩa matũũraga gũkuhĩ na Edomu.</char></note><verse eid="HAB 3:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="HAB 3:8" />Wee Jehova-rĩ, nĩ njũũĩ warakarĩire?</para>
  <para style="q2" vid="HAB 3:8">Mangʼũrĩ maku-rĩ, nĩ tũrũũĩ mokĩrĩire?</para>
  <para style="q1" vid="HAB 3:8">Wee-rĩ, wokĩrĩire iria na mangʼũrĩ maku</para>
  <para style="q2" vid="HAB 3:8">rĩrĩa wahaicĩte mbarathi ciaku</para>
  <para style="q2" vid="HAB 3:8">na ngaari ciaku cia ũhootani cia ita?<verse eid="HAB 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HAB 3:9" />Nĩwarutire ũta waku, ũkĩwoya na igũrũ,</para>
  <para style="q2" vid="HAB 3:9">na ũgĩĩtia mĩguĩ mĩingĩ.<note caller="+" style="f"><char style="fr" closed="false">3:9 </char><char style="ft" closed="false">Mĩguĩ haha nĩ heni na marurumĩ iria Mwathani aahũthĩrire.</char></note></para>
  <para style="q1" vid="HAB 3:9">Nayo thĩ ũkĩmĩgayania na njũũĩ;<verse eid="HAB 3:9" /></para>
  <para style="q2">
    <verse number="10" style="v" sid="HAB 3:10" />irĩma ciakuonire ikĩĩnyogonda.</para>
  <para style="q1" vid="HAB 3:10">Kĩguũ kĩa maaĩ nakĩo gĩgĩtherera;</para>
  <para style="q2" vid="HAB 3:10">maaĩ ma kũrĩa kũriku makĩhũũyũka,</para>
  <para style="q2" vid="HAB 3:10">na makĩambararia makũmbĩ mamo na igũrũ taarĩ moko.<verse eid="HAB 3:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="HAB 3:11" />Riũa na mweri nĩciarũgamire o ro ũguo kũu igũrũ,</para>
  <para style="q2" vid="HAB 3:11">ciona ũtheri wa mĩguĩ yaku ĩkĩrathũka,</para>
  <para style="q2" vid="HAB 3:11">na ciona kũhenia gwa itimũ rĩaku rĩkĩmenũka.<verse eid="HAB 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HAB 3:12" />Watuĩkanĩirie thĩ na mangʼũrĩ,</para>
  <para style="q2" vid="HAB 3:12">na ũkĩhũũra ndũrĩrĩ ũrĩ na marakara.<verse eid="HAB 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 3:13" />Wokire kũhonokia andũ aku,</para>
  <para style="q2" vid="HAB 3:13">na ũhonokie ũrĩa waku mũitĩrĩrie maguta.</para>
  <para style="q1" vid="HAB 3:13">Wahehenjire kĩongo kĩa nyũmba ya waganu,</para>
  <para style="q2" vid="HAB 3:13">ũkĩmĩtharia nginya itina-inĩ ciayo.<verse eid="HAB 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HAB 3:14" />Wamũtheecire mũtwe na itimũ rĩake mwene,</para>
  <para style="q2" vid="HAB 3:14">rĩrĩa njamba ciake cia ita ciatũtharĩkĩire itũharaganie;</para>
  <para style="q2" vid="HAB 3:14">cigakenagĩrĩra ta igũtambuura athĩĩni arĩa mehithĩte.<verse eid="HAB 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HAB 3:15" />Wee wakinyire iria igũrũ na mbarathi ciaku,</para>
  <para style="q2" vid="HAB 3:15">ũgĩthuka maaĩ macio maingĩ, magĩtuĩka makũmbĩ manene.<verse eid="HAB 3:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="HAB 3:16" />Ndaiguire ũhoro ũcio,</para>
  <para style="q2" vid="HAB 3:16">ngoro yakwa ĩgĩtumatuuma,</para>
  <para style="q1" vid="HAB 3:16">nacio iromo ciakwa ikĩinaina nĩ mũgambo ũcio;</para>
  <para style="q2" vid="HAB 3:16">mahĩndĩ makwa makĩonja,</para>
  <para style="q2" vid="HAB 3:16">namo magũrũ makwa makĩinaina.</para>
  <para style="q1" vid="HAB 3:16">No niĩ nĩngweterera ngirĩrĩirie,</para>
  <para style="q2" vid="HAB 3:16">nginya mũthenya ũrĩa wa kũnyariirĩka ũgaakinya,</para>
  <para style="q2" vid="HAB 3:16">ũkore rũrĩrĩ rũrĩa rũtũtharĩkagĩra.<verse eid="HAB 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="HAB 3:17" />Atĩrĩrĩ, o na mũkũyũ ũngĩaga kũruta kĩro,</para>
  <para style="q2" vid="HAB 3:17">nayo mĩthabibũ yaage thabibũ,</para>
  <para style="q1" vid="HAB 3:17">o naguo mũtamaiyũ wage maciaro,</para>
  <para style="q2" vid="HAB 3:17">nayo mĩgũnda yaage irio;</para>
  <para style="q1" vid="HAB 3:17">o na kũngĩaga ngʼondu gĩcegũ</para>
  <para style="q2" vid="HAB 3:17">na kwage ngʼombe ciugũ-inĩ-rĩ,<verse eid="HAB 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="HAB 3:18" />niĩ no ndĩrĩkenagĩra Jehova,</para>
  <para style="q2" vid="HAB 3:18">njanjamũkage nĩ ũndũ wa Ngai Mũhonokia wakwa.<verse eid="HAB 3:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="HAB 3:19" />Mwathani Jehova nĩwe hinya wakwa,</para>
  <para style="q2" vid="HAB 3:19">atũmaga magũrũ makwa magĩe ihenya ta magũrũ ma thwariga,</para>
  <para style="q2" vid="HAB 3:19">nake aahotithagia kũhaica kũrĩa gũtũũgĩru.</para>
  <para style="b" vid="HAB 3:19" />
  <para style="q1" vid="HAB 3:19">Kũrĩ mũtongoria wa nyĩmbo. Rwĩmbo rũrũ nĩ rwa kũinwo na inanda cia mũgeeto.<verse eid="HAB 3:19" /></para>
  <chapter eid="HAB 3" />
</usx>