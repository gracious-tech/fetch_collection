<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PRO" style="id">- Biblica® Open Kikuyu Holy Word of God</book>
  <para style="h">Thimo</para>
  <para style="toc1">Thimo</para>
  <para style="toc2">Thimo</para>
  <para style="toc3">Thim</para>
  <para style="mt1">THIMO</para>
  <chapter number="1" style="c" sid="PRO 1"/>
  <para style="s1">Ciugo cia Kwambĩrĩria: Gĩtũmi na Muoroto</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 1:1"/>Ici nĩ thimo cia Solomoni mũrũ wa Daudi, ũrĩa warĩ mũthamaki wa Isiraeli:<verse eid="PRO 1:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 1:2"/>nĩ thimo cia gũtũma mũndũ agĩe na ũũgĩ, na ataarĩke;</para>
  <para style="q2" vid="PRO 1:2">nĩ cia gũtũma ahote gũtaũkĩrwo nĩ ciugo cia ũũgĩ;<verse eid="PRO 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 1:3"/>nĩ cia gũtũma mũndũ ataarĩke ahote kũbarĩrĩra mũtũũrĩre wake,</para>
  <para style="q2" vid="PRO 1:3">ekage maũndũ marĩa magĩrĩire, na ma kĩhooto, na marĩa mega;<verse eid="PRO 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 1:4"/>nĩ cia gũtũma ũrĩa ũtarĩ na ũũgĩ agĩe na ũmenyo,</para>
  <para style="q2" vid="PRO 1:4">na cia gũtũma mũndũ mwĩthĩ agĩe na ũmenyo na ũgereri:<verse eid="PRO 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 1:5"/>arĩa oogĩ-rĩ, nĩmathikĩrĩrie na mongerere wĩruti wao,</para>
  <para style="q2" vid="PRO 1:5">nao arĩa akũũrani maũndũ metĩkĩre gũtongorio.<verse eid="PRO 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 1:6"/>Ningĩ nĩ cia gũtũma mũndũ ataũkĩrwo nĩ thimo na ngerekano,</para>
  <para style="q2" vid="PRO 1:6">na ataũkĩrwo nĩ ciugo cia andũ arĩa oogĩ, na ndaĩ ciao.<verse eid="PRO 1:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 1:7"/>Kĩambĩrĩria kĩa ũmenyo nĩ gwĩtigĩra Jehova,</para>
  <para style="q2" vid="PRO 1:7">no arĩa akĩĩgu nĩ mathũire ũũgĩ na ũtaaro.<verse eid="PRO 1:7"/></para>
  <para style="s1">Mwĩmenyererei Kũheenererio</para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 1:8"/>Mũrũ wakwa, thikĩrĩria mataaro ma thoguo,</para>
  <para style="q2" vid="PRO 1:8">na ndũgatigane na ũrutani wa maitũguo.<verse eid="PRO 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 1:9"/>Maũndũ macio magaatuĩka ithaga rĩa kũgemia mũtwe waku,</para>
  <para style="q2" vid="PRO 1:9">na ta mũgathĩ wa kũgemia ngingo yaku.<verse eid="PRO 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 1:10"/>Mũrũ wakwa, ehia mangĩgakũheenereria-rĩ,</para>
  <para style="q2" vid="PRO 1:10">ndũkanetĩkanie nao.<verse eid="PRO 1:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 1:11"/>Mangĩgakwĩra atĩrĩ, “Ũka ũthiĩ hamwe na ithuĩ;</para>
  <para style="q2" vid="PRO 1:11">reke tuoherie mũndũ tũite thakame yake,</para>
  <para style="q2" vid="PRO 1:11">reke tũcemaceeme mũndũ o na ũtehĩtie;<verse eid="PRO 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 1:12"/>ningĩ reke tũmamerie marĩ muoyo, o ta ũrĩa mbĩrĩra ĩĩkaga,</para>
  <para style="q2" vid="PRO 1:12">na marĩ agima, o ta arĩa maharũrũkaga irima;<verse eid="PRO 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 1:13"/>Na ithuĩ-rĩ, tũkĩgĩe na indo cia goro cia mĩthemba yothe,</para>
  <para style="q2" vid="PRO 1:13">na tũiyũrie nyũmba ciitũ na indo cia ndaho;<verse eid="PRO 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 1:14"/>rutithania wĩra na ithuĩ,</para>
  <para style="q2" vid="PRO 1:14">tũkorwo na mũhuko ũmwe ithuothe”;<verse eid="PRO 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 1:15"/>mũrũ wakwa, tiga gũtwarana nao,</para>
  <para style="q2" vid="PRO 1:15">ndũkagerere njĩra ciao;<verse eid="PRO 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 1:16"/>nĩgũkorwo magũrũ mao mahanyũkaga mathiĩ mehia-inĩ,</para>
  <para style="q2" vid="PRO 1:16">nao mahiũhaga magaite thakame.<verse eid="PRO 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 1:17"/>Kaĩ nĩ wĩra wa tũhũ kũiga gĩkerenge</para>
  <para style="q2" vid="PRO 1:17">nyoni ciothe igĩkuonaga-ĩ!<verse eid="PRO 1:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 1:18"/>Andũ aya mohagĩria thakame yao ene;</para>
  <para style="q2" vid="PRO 1:18">maceemaga o mĩoyo yao ene!<verse eid="PRO 1:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 1:19"/>Ũcio nĩguo mũthia wa arĩa othe magĩaga na indo na njĩra ya ungumania;</para>
  <para style="q2" vid="PRO 1:19">indo icio iniinaga mĩoyo ya arĩa magĩaga nacio.<verse eid="PRO 1:19"/></para>
  <para style="s1">Mwĩmenyererei Mũtikarege Ũũgĩ</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 1:20"/>Ũũgĩ nĩ aretana anĩrĩire njĩra-inĩ,</para>
  <para style="q2" vid="PRO 1:20">ningĩ agakayũrũrũka arĩ ihaaro-inĩ cia mũingĩ;<verse eid="PRO 1:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 1:21"/>Aragũthũka na mũgambo mũnene arĩ magomano-inĩ ma njĩra kũu kũrĩ inegene,</para>
  <para style="q2" vid="PRO 1:21">o na itoonyero rĩa itũũra inene akoria atĩrĩ:<verse eid="PRO 1:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 1:22"/>“Inyuĩ mũtarĩ ũũgĩ-rĩ, nĩ nginya rĩ mũgũtũũra mwendete njĩra cianyu itarĩ cia ũũgĩ?</para>
  <para style="q2" vid="PRO 1:22">Nĩ nginya rĩ anyũrũrania megũtũũra makenagĩra kĩnyũrũri,</para>
  <para style="q2" vid="PRO 1:22">na arĩa akĩĩgu mathũire ũmenyo?<verse eid="PRO 1:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 1:23"/>Korwo nĩmwetĩkĩrire kũigua ũtaaro wakwa-rĩ,</para>
  <para style="q2" vid="PRO 1:23">nĩingĩamũhingũrĩire ngoro yakwa,</para>
  <para style="q2" vid="PRO 1:23">ndũme mũmenye meciiria makwa.<verse eid="PRO 1:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 1:24"/>No tondũ nĩmwaregire kũnjigua rĩrĩa ndetanire,</para>
  <para style="q2" vid="PRO 1:24">na gũtirĩ mũndũ werũmbũirie hĩndĩ ĩrĩa ndatambũrũkirie guoko gwakwa,<verse eid="PRO 1:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 1:25"/>na mũkĩagĩra mataaro makwa mothe bata,</para>
  <para style="q2" vid="PRO 1:25">na mũkĩaga gwĩtĩkĩra ikaanania rĩakwa-rĩ,<verse eid="PRO 1:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 1:26"/>niĩ na niĩ nĩngamũthekerera hĩndĩ yanyu ya mwanangĩko,</para>
  <para style="q2" vid="PRO 1:26">na ndĩmũnyũrũrie rĩrĩa mũgaakorererwo nĩ mũtino:<verse eid="PRO 1:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 1:27"/>ĩĩ hĩndĩ ĩrĩa guoya ũkaamũkorerera ta kĩhuhũkanio,</para>
  <para style="q2" vid="PRO 1:27">rĩrĩa mwanangĩko ũkaamũhaata ta rũhuho rwa kĩhuhũkanio,</para>
  <para style="q2" vid="PRO 1:27">rĩrĩa mũgaakinyĩrĩrwo nĩ mĩnyamaro na ruo rwa ngoro.<verse eid="PRO 1:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 1:28"/>“Hĩndĩ ĩyo nĩmakangaĩra, no ndikametĩka;</para>
  <para style="q2" vid="PRO 1:28">nĩmakanjetha na kĩyo, no matikanyona.<verse eid="PRO 1:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 1:29"/>Tondũ nĩmathũũrire ũmenyo,</para>
  <para style="q2" vid="PRO 1:29">na matiigana gũthuura gwĩtigĩra Jehova,<verse eid="PRO 1:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 1:30"/>tondũ matietĩkĩrire mataaro makwa,</para>
  <para style="q2" vid="PRO 1:30">na nĩmamenire ikaanania rĩakwa,<verse eid="PRO 1:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 1:31"/>makaarĩa maciaro ma mĩthiĩre yao,</para>
  <para style="q2" vid="PRO 1:31">na mahũũnio nĩ maciaro ma mathugunda mao.<verse eid="PRO 1:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 1:32"/>Nĩgũkorwo ũgenyũ wa arĩa matarĩ ũũgĩ nĩũkamooraga,</para>
  <para style="q2" vid="PRO 1:32">nakuo kwĩgangara kwa arĩa akĩĩgu nĩgũkamaniina;<verse eid="PRO 1:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 1:33"/>no ũrĩa wothe ũnjiguaga arĩtũũraga na thayũ,</para>
  <para style="q2" vid="PRO 1:33">na atũũre ahooreire, atarĩ ũgwati angĩĩtigĩra.”<verse eid="PRO 1:33"/></para>
  <chapter eid="PRO 1"/>
  <chapter number="2" style="c" sid="PRO 2"/>
  <para style="s1">Uumithio wa Ũũgĩ Mũtũũrĩre-inĩ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 2:1"/>Mũrũ wakwa, ũngĩtĩkĩra ciugo ciakwa,</para>
  <para style="q2" vid="PRO 2:1">na ũige maathani makwa ta mũthiithũ thĩinĩ waku,<verse eid="PRO 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 2:2"/>nakuo gũtũ gwaku ũgũtegere ũũgĩ,</para>
  <para style="q2" vid="PRO 2:2">na werekerie ngoro yaku kũgĩa na ũmenyi,<verse eid="PRO 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 2:3"/>na ũngĩgaakayũrũrũka na ũhooe gũkũũrana maũndũ,</para>
  <para style="q2" vid="PRO 2:3">na wĩtane wanĩrĩire ũheo ũtaũku,<verse eid="PRO 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 2:4"/>na ũngĩkawetha ta betha,</para>
  <para style="q2" vid="PRO 2:4">na ũũcarie ta kĩgĩĩna kĩhithe-rĩ,<verse eid="PRO 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 2:5"/>hĩndĩ ĩyo nĩũgataũkĩrwo nĩ ũhoro wa gwĩtigĩra Jehova,</para>
  <para style="q2" vid="PRO 2:5">na ũgĩe na ũmenyo wa Ngai.<verse eid="PRO 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 2:6"/>Nĩgũkorwo Jehova aheanaga ũũgĩ,</para>
  <para style="q2" vid="PRO 2:6">na kanua gake koimaga ũmenyo na ũtaũku.<verse eid="PRO 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 2:7"/>Andũ arĩa arũngĩrĩru amaigĩire ũhootani,</para>
  <para style="q2" vid="PRO 2:7">nĩwe ngo ya arĩa matarĩ ũcuuke mĩthiĩre-inĩ yao,<verse eid="PRO 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 2:8"/>nĩgũkorwo nĩarangagĩra njĩra cia arĩa marũmagĩrĩra kĩhooto,</para>
  <para style="q2" vid="PRO 2:8">na akagitĩra njĩra ya andũ ake arĩa ehokeku.<verse eid="PRO 2:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 2:9"/>Hĩndĩ ĩyo nĩũgakũũrana maũndũ marĩa magĩrĩire,</para>
  <para style="q2" vid="PRO 2:9">na ma kĩhooto, na marĩa mega: ũgĩkũũrane njĩra o yothe njega.<verse eid="PRO 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 2:10"/>Nĩgũkorwo ũũgĩ nĩũgatoonya ngoro yaku,</para>
  <para style="q2" vid="PRO 2:10">naguo ũmenyo ũkenagie muoyo waku.<verse eid="PRO 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 2:11"/>ũgereri nĩũrĩkũgitagĩra,</para>
  <para style="q2" vid="PRO 2:11">naguo ũtaũku ũkũrangagĩre.<verse eid="PRO 2:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 2:12"/>Ũũgĩ nĩũgakũhonokia kuuma njĩra-inĩ cia andũ arĩa aaganu,</para>
  <para style="q2" vid="PRO 2:12">ũkũhonokie kuuma kũrĩ andũ arĩa maaragia maũndũ ma waganu,<verse eid="PRO 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 2:13"/>o arĩa matigaga njĩra iria nũngĩrĩru,</para>
  <para style="q2" vid="PRO 2:13">magathiĩra njĩra cia nduma,<verse eid="PRO 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 2:14"/>arĩa makenaga magĩĩka ũũru,</para>
  <para style="q2" vid="PRO 2:14">na magakenagio nĩ ũũru wa waganu,<verse eid="PRO 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 2:15"/>na no-o arĩa njĩra ciao ciogomete,</para>
  <para style="q2" vid="PRO 2:15">na mĩthiĩre yao ĩrĩ ya ungumania.<verse eid="PRO 2:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 2:16"/>Ũũgĩ nĩũgakũhonokia kuuma harĩ mũtumia ũrĩa mũtharia,</para>
  <para style="q2" vid="PRO 2:16">ũkũhonokie harĩ ngʼenyũ ya mũtumia na ciugo ciake cia kũheenereria andũ,<verse eid="PRO 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 2:17"/>ũcio ũtigĩte mũratawe wa ũnini wake,</para>
  <para style="q2" vid="PRO 2:17">na agatiganĩria kĩrĩkanĩro kĩrĩa aarĩkanĩire na mũthuuriwe arĩ mbere ya Ngai.<verse eid="PRO 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 2:18"/>Nĩgũkorwo nyũmba yake ĩroragia andũ gĩkuũ-inĩ,</para>
  <para style="q2" vid="PRO 2:18">nacio njĩra ciake ikamerekeria kũrĩ maroho ma arĩa akuũ.<verse eid="PRO 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 2:19"/>Gũtirĩ mũndũ ũthiiaga harĩ we agacooka,</para>
  <para style="q2" vid="PRO 2:19">kana akegwatĩra njĩra cia muoyo.<verse eid="PRO 2:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 2:20"/>No rĩrĩ, wee nĩũrĩthiiaga na mĩthiĩre ya andũ arĩa ega,</para>
  <para style="q2" vid="PRO 2:20">na ũgeragĩre njĩra cia arĩa athingu.<verse eid="PRO 2:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 2:21"/>Nĩgũkorwo andũ arĩa arũngĩrĩru nĩo magaatũũra bũrũri-inĩ,</para>
  <para style="q2" vid="PRO 2:21">na arĩa matarĩ ũcuuke nĩo magaatigara kuo;<verse eid="PRO 2:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 2:22"/>no rĩrĩ, andũ arĩa aaganu nĩmakeeherio bũrũri-inĩ,</para>
  <para style="q2" vid="PRO 2:22">nao arĩa matarĩ ehokeku nĩmakamunywo maingatwo kuo.<verse eid="PRO 2:22"/></para>
  <chapter eid="PRO 2"/>
  <chapter number="3" style="c" sid="PRO 3"/>
  <para style="s1">Mauumithio mangĩ ma Ũũgĩ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 3:1"/>Mũrũ wakwa, ndũkariganĩrwo nĩ ũrutani wakwa,</para>
  <para style="q2" vid="PRO 3:1">no ngoro yaku nĩĩrũmagie maathani makwa,<verse eid="PRO 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 3:2"/>nĩgũkorwo nĩmagakuongerera matukũ ũtũũre mĩaka mĩingĩ,</para>
  <para style="q2" vid="PRO 3:2">na matũme ũgaacĩre.<verse eid="PRO 3:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 3:3"/>Ndũkanareke wendani na wĩhokeku ikweherere;</para>
  <para style="q2" vid="PRO 3:3">cioherere ngingo yaku,</para>
  <para style="q2" vid="PRO 3:3">ũciandĩke kĩhengere-inĩ kĩa ngoro yaku.<verse eid="PRO 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 3:4"/>Weka ũguo nĩũgeetĩkĩrĩka, na ũgĩe na rĩĩtwa rĩega</para>
  <para style="q2" vid="PRO 3:4">maitho-inĩ ma Ngai o na ma andũ.<verse eid="PRO 3:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 3:5"/>Wĩhoke Jehova na ngoro yaku yothe,</para>
  <para style="q2" vid="PRO 3:5">na ndũkanehoke ũmenyo waku mwene;<verse eid="PRO 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 3:6"/>mũmenyithagie mĩthiĩre yaku yothe,</para>
  <para style="q2" vid="PRO 3:6">na nĩarĩrũngaga njĩra ciaku.<verse eid="PRO 3:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 3:7"/>Tiga kwĩonaga ũrĩ mũũgĩ maitho-inĩ maku mwene;</para>
  <para style="q2" vid="PRO 3:7">wĩtigĩre Jehova na ũtheemage maũndũ marĩa mooru.<verse eid="PRO 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 3:8"/>Ũndũ ũcio nĩũrĩkũrehagĩra ũgima wa mwĩrĩ,</para>
  <para style="q2" vid="PRO 3:8">na mahĩndĩ maku makoragwo marĩ na hinya.<verse eid="PRO 3:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 3:9"/>Tĩĩaga Jehova na ũtonga waku,</para>
  <para style="q2" vid="PRO 3:9">ningĩ ũmũtĩĩage na maciaro mothe ma mbere ma irio ciaku cia mĩgũnda;<verse eid="PRO 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 3:10"/>namo makũmbĩ maku nĩmakaiyũrĩrĩra,</para>
  <para style="q2" vid="PRO 3:10">nayo mĩtũngi yaku ĩiyũrĩrĩre ndibei ya mũhihano.<verse eid="PRO 3:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 3:11"/>Mũrũ wakwa, tiga kũnyarara ihũũra rĩa Jehova,</para>
  <para style="q2" vid="PRO 3:11">na ndũgathũũre irũithia rĩake,<verse eid="PRO 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 3:12"/>nĩgũkorwo Jehova arũithagia arĩa endete,</para>
  <para style="q2" vid="PRO 3:12">o ta ũrĩa ithe wa mũndũ arũithagia mũriũ ũrĩa akenagĩra.<verse eid="PRO 3:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 3:13"/>Kũrathimwo-rĩ, nĩ mũndũ ũrĩa wonete ũũgĩ,</para>
  <para style="q2" vid="PRO 3:13">mũndũ ũcio wĩgĩĩrĩire na ũmenyo,<verse eid="PRO 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 3:14"/>nĩgũkorwo ũũgĩ nĩ wa bata mũno gũkĩra betha,</para>
  <para style="q2" vid="PRO 3:14">na ũciaraga uumithio ũkĩrĩte wa thahabu.<verse eid="PRO 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 3:15"/>Ũũgĩ ũrĩ goro gũkĩra ruru iria ndune;</para>
  <para style="q2" vid="PRO 3:15">kĩrĩa gĩothe ũngĩĩrirĩria gũtirĩ kĩngĩringithanio naguo.<verse eid="PRO 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 3:16"/>Guoko-inĩ gwake kwa ũrĩo harĩ ũingĩ wa matukũ;</para>
  <para style="q2" vid="PRO 3:16">guoko-inĩ gwake kwa ũmotho harĩ na ũtonga na gĩtĩĩo.<verse eid="PRO 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 3:17"/>Mĩthiĩre ya ũũgĩ nĩ mĩthiĩre ya kwendeka,</para>
  <para style="q2" vid="PRO 3:17">na njĩra ciaguo ciothe nĩ cia thayũ.<verse eid="PRO 3:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 3:18"/>Ũũgĩ nĩ mũtĩ wa muoyo kũrĩ arĩa maũhĩmbagĩria;</para>
  <para style="q2" vid="PRO 3:18">arĩa megĩagĩra naguo-rĩ, nĩmarĩrathimagwo.<verse eid="PRO 3:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 3:19"/>Jehova aahandire mĩthingi ya thĩ na ũũgĩ,</para>
  <para style="q2" vid="PRO 3:19">na akĩrũmia igũrũ na ũmenyo wake;<verse eid="PRO 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 3:20"/>ũmenyo wake nĩguo wagayanirie kũrĩa kũriku,</para>
  <para style="q2" vid="PRO 3:20">namo matu magatatagia ime.<verse eid="PRO 3:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 3:21"/>Mũrũ wakwa tũũria matua mega na ũkũũrani maũndũ,</para>
  <para style="q2" vid="PRO 3:21">ndũkanareke ciehere maitho-inĩ maku;<verse eid="PRO 3:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 3:22"/>nĩcio igaagũtũũria muoyo, na nĩ ithaga rĩa kũgemagia ngingo yaku.<verse eid="PRO 3:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 3:23"/>Ningĩ ũrĩthiiaga na njĩra yaku ũrĩ na thayũ,</para>
  <para style="q2" vid="PRO 3:23">na kũgũrũ gwaku gũtikahĩngwo;<verse eid="PRO 3:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 3:24"/>Wakoma-rĩ, ndũgetigĩra;</para>
  <para style="q2" vid="PRO 3:24">wakoma-rĩ, ũrĩkomaga toro mwega.<verse eid="PRO 3:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 3:25"/>Ndũgetigĩre mwanangĩko wa narua,</para>
  <para style="q2" vid="PRO 3:25">kana kĩhuhũkanio kĩrĩa gĩkoragĩrĩra andũ arĩa aaganu,<verse eid="PRO 3:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 3:26"/>nĩgũkorwo Jehova nĩwe ũgaatuĩka mwĩhoko waku,</para>
  <para style="q2" vid="PRO 3:26">na amenyagĩrĩre kũgũrũ gwaku gũtikanyiitwo nĩ mũtego.<verse eid="PRO 3:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 3:27"/>Ndũkanagirĩrĩrie ũndũ mwega ũkinyĩre arĩa maagĩrĩirwo nĩgũkinyĩrĩrwo nĩguo,</para>
  <para style="q2" vid="PRO 3:27">rĩrĩa ũrĩ na ũhoti wa kũhingia ũndũ ũcio.<verse eid="PRO 3:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 3:28"/>Ndũkaneere mũndũ wa itũũra rĩaku atĩrĩ,</para>
  <para style="q2" vid="PRO 3:28">“Thiĩ ũgooka rĩngĩ; kĩu ũrenda nĩngakũhe rũciũ,”</para>
  <para style="q2" vid="PRO 3:28">o rĩrĩa ũrĩ na kĩndũ kĩu hakuhĩ.<verse eid="PRO 3:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 3:29"/>Ndũkanaciirĩre gwĩka mũndũ wa itũũra rĩaku ũũru,</para>
  <para style="q2" vid="PRO 3:29">ũcio ũtũũraga hakuhĩ nawe akwĩhokete.<verse eid="PRO 3:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 3:30"/>Ndũkanarũithie mũndũ tũhũ,</para>
  <para style="q2" vid="PRO 3:30">rĩrĩa atarĩ ũndũ mũũru agwĩkĩte.<verse eid="PRO 3:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 3:31"/>Ndũkanacumĩkĩre maũndũ ma mũndũ wa ngũĩ,</para>
  <para style="q2" vid="PRO 3:31">kana ũthuure njĩra o na ĩmwe yake,<verse eid="PRO 3:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 3:32"/>nĩgũkorwo Jehova nĩathũire mũndũ mwaganu,</para>
  <para style="q2" vid="PRO 3:32">no nĩagĩĩaga ndundu na andũ arĩa arũngĩrĩru.<verse eid="PRO 3:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 3:33"/>Nyũmba ya arĩa aaganu ĩtũũraga na kĩrumi kĩa Jehova,</para>
  <para style="q1" vid="PRO 3:33">no mũciĩ wa arĩa athingu nĩaũrathimaga.<verse eid="PRO 3:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 3:34"/>Jehova nĩanyũrũragia andũ arĩa manyũrũranagia na mwĩtĩĩo,</para>
  <para style="q2" vid="PRO 3:34">no arĩa menyiihagia nĩamaheaga wega wake.<verse eid="PRO 3:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 3:35"/>Andũ arĩa oogĩ magayaga gĩtĩĩo,</para>
  <para style="q2" vid="PRO 3:35">no andũ arĩa akĩĩgu magayaga njono.<verse eid="PRO 3:35"/></para>
  <chapter eid="PRO 3"/>
  <chapter number="4" style="c" sid="PRO 4"/>
  <para style="s1">Ũũgĩ Ũkĩrĩte Indo Ciothe</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 4:1"/>Atĩrĩrĩ, inyuĩ ariũ akwa, ta thikĩrĩriai ũrũtani wa thoguo;</para>
  <para style="q2" vid="PRO 4:1">njiguai nĩguo mwĩgĩĩre na kũmenya maũndũ.<verse eid="PRO 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 4:2"/>Tondũ ngũmũhe ũrutani mwega,</para>
  <para style="q2" vid="PRO 4:2">nĩ ũndũ ũcio mũtigatirike ũrutani wakwa.<verse eid="PRO 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 4:3"/>Rĩrĩa ndaarĩ mwana nyũmba-inĩ ya baba,</para>
  <para style="q2" vid="PRO 4:3">ndĩ o mũndũ mwĩthĩ, na ndĩ mwana wa mũmwe wa maitũ-rĩ,<verse eid="PRO 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 4:4"/>baba nĩandutire, akĩnjĩĩra atĩrĩ,</para>
  <para style="q2" vid="PRO 4:4">“Wĩgwatĩre ciugo ciakwa na ngoro yaku yothe;</para>
  <para style="q2" vid="PRO 4:4">rũmia maathani makwa, na nĩũgũtũũra muoyo.<verse eid="PRO 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 4:5"/>Gĩa na ũũgĩ, gĩa na kũmenya maũndũ;</para>
  <para style="q2" vid="PRO 4:5">ndũkanariganĩrwo nĩ ciugo ciakwa, kana wahũke kuuma harĩ cio.<verse eid="PRO 4:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 4:6"/>Ndũkanatirike ũũgĩ, naguo nĩũrĩkũgitagĩra;<verse eid="PRO 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 4:7"/>Ũũgĩ ũkĩrĩte indo ciothe; nĩ ũndũ ũcio wĩgĩĩre na ũũgĩ.</para>
  <para style="q2" vid="PRO 4:7">Ĩĩ, kaba kũruta indo ciaku ciothe wĩgĩĩre na kũmenya maũndũ.<verse eid="PRO 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 4:8"/>Tũũgagĩria ũũgĩ mũno, naguo nĩũrĩkwambararagia;</para>
  <para style="q2" vid="PRO 4:8">ũhĩmbagĩrie, naguo nĩũrĩgũtĩĩithagia.<verse eid="PRO 4:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 4:9"/>Nĩũgagwĩkĩra ithaga rĩa ũtugi mũtwe waku,</para>
  <para style="q2" vid="PRO 4:9">na ũkũhe thũmbĩ thaka mũno.”<verse eid="PRO 4:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 4:10"/>Thikĩrĩria, wee mũrũ wakwa, na wĩtĩkĩre ũrĩa ngũkwĩra,</para>
  <para style="q2" vid="PRO 4:10">nĩgeetha mĩaka ya muoyo waku ĩingĩhe.<verse eid="PRO 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 4:11"/>Nguonetie njĩra ya ũũgĩ,</para>
  <para style="q2" vid="PRO 4:11">na ngagũtongoria njĩra-inĩ iria nũngarũ.<verse eid="PRO 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 4:12"/>Rĩrĩa ũgũthiĩ, makinya maku matikahĩngĩcwo;</para>
  <para style="q2" vid="PRO 4:12">rĩrĩa ũkũhanyũka-rĩ, ndũkahĩngwo.<verse eid="PRO 4:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 4:13"/>Rũmia ũrutani wakwa, na ndũkanareke ũkweherere;</para>
  <para style="q2" vid="PRO 4:13">ũgitagĩre wega, nĩgũkorwo nĩguo muoyo waku.<verse eid="PRO 4:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 4:14"/>Ndũkanagerere njĩra ya andũ arĩa aaganu,</para>
  <para style="q2" vid="PRO 4:14">kana ũthiĩre njĩra ya andũ arĩa ooru.<verse eid="PRO 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 4:15"/>Mĩĩtheemage, na ndũkanamĩgerere;</para>
  <para style="q2" vid="PRO 4:15">mĩhutatĩre, na wĩthiĩre na njĩra yaku.<verse eid="PRO 4:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 4:16"/>Nĩgũkorwo andũ arĩa aaganu matingĩkoma nginya meeke ũũru;</para>
  <para style="q2" vid="PRO 4:16">mooragwo nĩ toro nginya matũme mũndũ ahĩngwo, agwe.<verse eid="PRO 4:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 4:17"/>Marĩĩaga irio iria monete na ũmaramari,</para>
  <para style="q2" vid="PRO 4:17">na makanyua ndibei matunyanĩte na hinya.<verse eid="PRO 4:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 4:18"/>Mĩthiĩre ya andũ arĩa athingu ĩhaana ta ũtheri wa gũgĩkĩa,</para>
  <para style="q2" vid="PRO 4:18">ũrĩa ũthiiaga ũgĩthererũkaga nginya mũthenya barigici.<verse eid="PRO 4:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 4:19"/>No mĩthiĩre ya andũ arĩa aaganu ĩhaana ta nduma ndumanu;</para>
  <para style="q2" vid="PRO 4:19">o matimenyaga kĩrĩa kĩamahĩnga.<verse eid="PRO 4:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 4:20"/>Mũrũ wakwa, ta thikĩrĩria ũrĩa ngũkwĩra;</para>
  <para style="q2" vid="PRO 4:20">tega gũtũ ũigue ciugo ciakwa.<verse eid="PRO 4:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 4:21"/>Ndũkanareke ciehere maitho-inĩ maku,</para>
  <para style="q2" vid="PRO 4:21">ciigage ngoro-inĩ yaku;<verse eid="PRO 4:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 4:22"/>nĩgũkorwo nĩcio itũũragia arĩa maciĩgwatĩire muoyo,</para>
  <para style="q2" vid="PRO 4:22">na igekĩra mwĩrĩ wao wothe ũgima.<verse eid="PRO 4:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 4:23"/>Makĩria ya macio mothe, rangagĩra ngoro yaku,</para>
  <para style="q2" vid="PRO 4:23">nĩgũkorwo nĩyo gĩthima kĩrĩa gĩtherũkaga muoyo.<verse eid="PRO 4:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 4:24"/>Eheria rũnano kanua-inĩ gaku;</para>
  <para style="q2" vid="PRO 4:24">nacio ndeto cia ũmaramari-rĩ, nĩciikare kũraya na iromo ciaku.<verse eid="PRO 4:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 4:25"/>Maitho maku nĩmarorage na mbere,</para>
  <para style="q2" vid="PRO 4:25">ũcũthagĩrĩrie mbere yaku wega.<verse eid="PRO 4:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 4:26"/>Aragania njĩra iria magũrũ maku marĩthiiagĩra,</para>
  <para style="q2" vid="PRO 4:26">na ũthiiagĩre o njĩra iria ngiindĩrĩku.<verse eid="PRO 4:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 4:27"/>Ndũkanaahũke na mwena wa ũrĩo kana wa ũmotho;</para>
  <para style="q2" vid="PRO 4:27">eheria kũgũrũ gwaku kuuma ũũru-inĩ.<verse eid="PRO 4:27"/></para>
  <chapter eid="PRO 4"/>
  <chapter number="5" style="c" sid="PRO 5"/>
  <para style="s1">Ũtharia Gũkaananio</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 5:1"/>Mũrũ wakwa, thikĩrĩria ũũgĩ ũyũ wakwa,</para>
  <para style="q2" vid="PRO 5:1">tega gũtũ wega ũigue ciugo ciakwa cia ũtaũku,<verse eid="PRO 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 5:2"/>nĩguo ũtũũrie ũbaarĩrĩri,</para>
  <para style="q2" vid="PRO 5:2">nayo mĩromo yaku ĩtũũrie ũmenyo.<verse eid="PRO 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 5:3"/>Nĩgũkorwo mĩromo ya mũtumia mũtharia itaataga ũũkĩ,</para>
  <para style="q2" vid="PRO 5:3">na mĩario yake ĩnyorokete gũkĩra maguta;<verse eid="PRO 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 5:4"/>no marigĩrĩrio nĩmũrũrũ ta maaĩ ma nyongo,</para>
  <para style="q2" vid="PRO 5:4">nĩ mũũgĩ ta rũhiũ rwa njora rũrĩa rũũgĩ mbarĩ cierĩ.<verse eid="PRO 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 5:5"/>Magũrũ make maikũrũkaga gĩkuũ-inĩ;</para>
  <para style="q2" vid="PRO 5:5">makinya make mathiiaga merekeire o mbĩrĩra.<verse eid="PRO 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 5:6"/>Ndeciiragia ũhoro wa njĩra ya muoyo;</para>
  <para style="q2" vid="PRO 5:6">njĩra ciake nĩ njogomu, nowe ndooĩ ũguo.<verse eid="PRO 5:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 5:7"/>Atĩrĩrĩ, ariũ akwa, ta thikĩrĩriai;</para>
  <para style="q2" vid="PRO 5:7">mũtikanatiganĩrie ũrĩa ngũmwĩra.<verse eid="PRO 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 5:8"/>Thiiagĩrai njĩra ĩrĩ kũraya nake,</para>
  <para style="q2" vid="PRO 5:8">mũtigakuhĩrĩrie mũrango wa nyũmba yake,<verse eid="PRO 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 5:9"/>nĩguo mũtikaheane hinya wanyu mwega kũrĩ andũ angĩ,</para>
  <para style="q2" vid="PRO 5:9">na mĩaka yanyu kũrĩ mũndũ ũtarĩ tha,<verse eid="PRO 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 5:10"/>nĩguo ageni matikehũũnie na ũtonga wanyu,</para>
  <para style="q2" vid="PRO 5:10">na kĩrĩa ũnogeire gĩtongie mũciĩ wa mũndũ wa kũngĩ.<verse eid="PRO 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 5:11"/>Marigĩrĩrio-inĩ ma muoyo waku nĩũgacaaya,</para>
  <para style="q2" vid="PRO 5:11">hĩndĩ ĩrĩa nyama cia mwĩrĩ waku na mwĩrĩ waku igaakorwo ithirĩte hinya.<verse eid="PRO 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 5:12"/>Ũkoiga atĩrĩ, “Hĩ, kaĩ nĩndathũũrire gũtaarwo-ĩ!</para>
  <para style="q2" vid="PRO 5:12">Hĩ, kaĩ ngoro yakwa nĩyamenete kũrũithio-ĩ!<verse eid="PRO 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 5:13"/>Ndingĩathĩkĩire arutani akwa,</para>
  <para style="q2" vid="PRO 5:13">kana thikĩrĩrie ataarani akwa.<verse eid="PRO 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 5:14"/>Nĩnginyĩte hũgũrũrũ-inĩ cia mwanangĩko,</para>
  <para style="q2" vid="PRO 5:14">ndĩ o gatagatĩ-inĩ ga kĩũngano gĩothe.”<verse eid="PRO 5:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 5:15"/>Atĩrĩrĩ, nyuuaga maaĩ ma itangi rĩaku we mwene,</para>
  <para style="q2" vid="PRO 5:15">maaĩ marĩa mathereraga moimĩte gĩthima-inĩ gĩaku mwene.<verse eid="PRO 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 5:16"/>Nĩ kwagĩrĩire ithima ciaku ciunagĩre maaĩ barabara-inĩ,</para>
  <para style="q2" vid="PRO 5:16">kana tũrũũĩ twaku tuunagĩre ihaaro-inĩ cia mũingĩ?<verse eid="PRO 5:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 5:17"/>Nĩmagĩtũũre marĩ maku wiki,</para>
  <para style="q2" vid="PRO 5:17">matigatuĩke maku na mũndũ wa kũngĩ o na rĩ.<verse eid="PRO 5:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 5:18"/>Gĩthima gĩaku kĩrorathimwo,</para>
  <para style="q2" vid="PRO 5:18">nawe ũkenagĩre mũtumia wa ũnini waku.<verse eid="PRO 5:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 5:19"/>Athakarĩte ta thwariga ya mũgoma,</para>
  <para style="q2" vid="PRO 5:19">akaagĩra ta gathiiya ka mũgoma:</para>
  <para style="q2" vid="PRO 5:19">kĩiganagwo nĩ nyondo ciake hĩndĩ ciothe,</para>
  <para style="q2" vid="PRO 5:19">ũkenagio nĩ wendo wake hĩndĩ ciothe.<verse eid="PRO 5:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 5:20"/>Mũrũ wakwa, nĩ kĩĩ kĩngĩtũma ũkenio nĩ mũtumia mũtharia?</para>
  <para style="q2" vid="PRO 5:20">Nĩ kĩĩ kĩngĩtũma ũhĩmbĩrie gĩthũri kĩa mũtumia wa mũndũ ũngĩ?<verse eid="PRO 5:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 5:21"/>Nĩgũkorwo mĩthiĩre ya mũndũ nĩyonagwo nĩ Jehova,</para>
  <para style="q2" vid="PRO 5:21">nake nĩatuĩragia njĩra ciake ciothe.<verse eid="PRO 5:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 5:22"/>Ciĩko njũru cia mũndũ mwaganu nĩcio imũtegaga;</para>
  <para style="q2" vid="PRO 5:22">nga cia mehia make nĩcio imuohaga, ikamũrũmia biũ.<verse eid="PRO 5:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 5:23"/>Mũndũ ũcio nĩagaakua nĩ kwaga ũtaaro,</para>
  <para style="q2" vid="PRO 5:23">akoora nĩ ũndũ wa ũrimũ wake mũnene.<verse eid="PRO 5:23"/></para>
  <chapter eid="PRO 5"/>
  <chapter number="6" style="c" sid="PRO 6"/>
  <para style="s1">Gũkaania Andũ Kũrũmĩrĩra Ũrimũ</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 6:1"/>Mũrũ wakwa, ũngĩkorwo ũigĩte kĩndũ gĩa kũrũgamĩrĩra thiirĩ wa mũndũ wa itũũra rĩaku,</para>
  <para style="q2" vid="PRO 6:1">ũkorwo atĩ nĩwe ũtuĩkĩte wa kũmũrĩhĩra thiirĩ harĩ mũndũ ũngĩ-rĩ,<verse eid="PRO 6:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 6:2"/>ũngĩkorwo ũtegeetwo nĩ ũrĩa uugĩte,</para>
  <para style="q2" vid="PRO 6:2">ũkagwatithio nĩ ciugo cia kanua gaku-rĩ,<verse eid="PRO 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 6:3"/>gĩĩke atĩrĩ, mũrũ wakwa, nĩguo wĩteithũre,</para>
  <para style="q2" vid="PRO 6:3">kuona atĩ nĩũgwĩte moko-inĩ ma mũndũ wa itũũra rĩaku:</para>
  <para style="q1" vid="PRO 6:3">Thiĩ wĩnyiihie wee mwene;</para>
  <para style="q2" vid="PRO 6:3">mũthaithe mũno akuohere.<verse eid="PRO 6:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 6:4"/>Ndũkareke maitho maku mone toro,</para>
  <para style="q2" vid="PRO 6:4">kana ũreke imone ciaku icũnge.<verse eid="PRO 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 6:5"/>Wĩteithũre o ta ũrĩa thwariga ĩĩteithũraga kuuma moko-inĩ ma mũguĩmi,</para>
  <para style="q2" vid="PRO 6:5">o na kana ta ũrĩa nyoni ĩĩteithũraga kuuma mũtego-inĩ wa mũtegi.<verse eid="PRO 6:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 6:6"/>Thiĩ harĩ thigiriri, wee kĩgũũta gĩkĩ;</para>
  <para style="q2" vid="PRO 6:6">ũcũũranie mĩtugo yayo nĩguo ũũhĩge!<verse eid="PRO 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 6:7"/>Ndĩrĩ mũnene,</para>
  <para style="q2" vid="PRO 6:7">kana mũmĩrũgamĩrĩri,</para>
  <para style="q2" vid="PRO 6:7">o na kana mũmĩathi,<verse eid="PRO 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 6:8"/>no nĩĩigagĩra mũthiithũ wa irio hĩndĩ ya riũa,</para>
  <para style="q2" vid="PRO 6:8">na ĩgacookanĩrĩria irio ciayo hĩndĩ ya magetha.<verse eid="PRO 6:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 6:9"/>Ũgũkoma hau nginya-rĩ, wee kĩgũũta gĩkĩ?</para>
  <para style="q2" vid="PRO 6:9">Ũrĩũkĩra rĩ, ũtige toro waku?<verse eid="PRO 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 6:10"/>Komakoma gatoro kanini, na ũcũngacũnge hanini,</para>
  <para style="q2" vid="PRO 6:10">na ũkũnje moko hanini nĩguo ũhurũke;<verse eid="PRO 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 6:11"/>atĩrĩ, ũthĩĩni ũgaagũkorerera ta mũitũ,</para>
  <para style="q2" vid="PRO 6:11">ũkorererwo nĩ wagi ũhaana ta mũndũ wĩohete indo cia mbaara.<verse eid="PRO 6:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 6:12"/>Mũndũ kĩmaramari na mwaganu-rĩ,</para>
  <para style="q2" vid="PRO 6:12">ũrĩa ũthiiaga akĩaragia ndeto itarĩ nũngĩrĩru,<verse eid="PRO 6:12"/></para>
  <para style="q2">
    <verse number="13" style="v" sid="PRO 6:13"/>ũcio uunagĩra andũ riitho,</para>
  <para style="q2" vid="PRO 6:13">na akaheenereria andũ na makinya make,</para>
  <para style="q2" vid="PRO 6:13">o na akaheneria andũ na ciara ciake-rĩ,<verse eid="PRO 6:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 6:14"/>ũcio ũthugundaga ũũru arĩ na maheeni ngoro-inĩ yake:</para>
  <para style="q2" vid="PRO 6:14">ũcio hĩndĩ ciothe ahuraga maũndũ ma nyamũkano.<verse eid="PRO 6:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 6:15"/>Nĩ ũndũ ũcio mũtino ũkaamũhubanĩria o rĩmwe aterĩgĩrĩire;</para>
  <para style="q2" vid="PRO 6:15">mwanangĩko ũtarĩ kĩhonia nĩũkamũniina biũ.<verse eid="PRO 6:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 6:16"/>Kũrĩ maũndũ matandatũ mathũirwo nĩ Jehova,</para>
  <para style="q2" vid="PRO 6:16">ĩĩ, o na nĩ mũgwanja marĩa onaga marĩ magigi, nĩmo:<verse eid="PRO 6:16"/></para>
  <para style="li2">
    <verse number="17" style="v" sid="PRO 6:17"/>maitho ma mwĩtĩĩo,</para>
  <para style="li2" vid="PRO 6:17">na rũrĩmĩ rũrĩa rũheenanagia,</para>
  <para style="li2" vid="PRO 6:17">na moko marĩa maitaga thakame ya andũ matehĩtie,<verse eid="PRO 6:17"/></para>
  <para style="li2">
    <verse number="18" style="v" sid="PRO 6:18"/>na ngoro ĩrĩa ĩthugundaga maũndũ ma waganu,</para>
  <para style="li2" vid="PRO 6:18">na magũrũ marĩa matengʼeraga gũthiĩ gwĩka ũũru,<verse eid="PRO 6:18"/></para>
  <para style="li2">
    <verse number="19" style="v" sid="PRO 6:19"/>na mũira ũtarĩ wa ma ũrĩa ũthothoraga ndeto cia maheeni,</para>
  <para style="li2" vid="PRO 6:19">o na mũndũ ũrĩa ũrehaga nyamũkano gatagatĩ ka andũ a nyina ũmwe.<verse eid="PRO 6:19"/></para>
  <para style="s1">Gũkaanio ũtharia</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 6:20"/>Mũrũ wakwa, tũũra ũrũmĩtie maathani ma thoguo,</para>
  <para style="q2" vid="PRO 6:20">na ndũgatirike ũrutani wa maitũguo.<verse eid="PRO 6:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 6:21"/>Moherere ngoro-inĩ yaku nginya tene;</para>
  <para style="q2" vid="PRO 6:21">makundĩke marigiicĩrie ngingo yaku.<verse eid="PRO 6:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 6:22"/>Rĩrĩa ũgũthiĩ-rĩ, nĩmarĩgũtongoragia;</para>
  <para style="q2" vid="PRO 6:22">wakoma-rĩ, nĩmarĩkũmenyagĩrĩra;</para>
  <para style="q2" vid="PRO 6:22">na rĩrĩa warahũka-rĩ, nĩmarĩkwaragĩria.<verse eid="PRO 6:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 6:23"/>Nĩgũkorwo maathani maya nĩ tawa,</para>
  <para style="q2" vid="PRO 6:23">na ũrutani ũyũ nĩ ũtheri,</para>
  <para style="q2" vid="PRO 6:23">namo mataaro ma kũrũnga mũndũ-rĩ,</para>
  <para style="q2" vid="PRO 6:23">nĩmo njĩra ya muoyo,<verse eid="PRO 6:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 6:24"/>magakweheragia harĩ mũndũ-wa-nja ũcio mwaganu,</para>
  <para style="q2" vid="PRO 6:24">na magakũhonokia kuuma kũrĩ rũrĩmĩ rũnyoroku rwa mũtumia ũcio ngʼenyũ.<verse eid="PRO 6:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 6:25"/>Ndũkerirĩrie ũthaka wake ngoro-inĩ yaku,</para>
  <para style="q2" vid="PRO 6:25">kana ũreke akũguucĩrĩrie na maitho make,<verse eid="PRO 6:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 6:26"/>nĩgũkorwo mũmaraya atũmaga mũndũ athĩĩne nginya ahooyage kenyũ ka mũgate,</para>
  <para style="q2" vid="PRO 6:26">na mũtumia mũtharia aguĩmaga muoyo waku guo mwene.<verse eid="PRO 6:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 6:27"/>Mũndũ no atahĩre mwaki gĩthũri-inĩ gĩake,</para>
  <para style="q2" vid="PRO 6:27">na nguo ciake itihĩe?<verse eid="PRO 6:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 6:28"/>Mũndũ no agerere igũrũ rĩa makara marĩ na mwaki,</para>
  <para style="q2" vid="PRO 6:28">na makinya make matihĩe?<verse eid="PRO 6:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 6:29"/>Ũguo no taguo mũndũ ũrĩa ũkomaga na mũtumia wa mũndũ ũngĩ atariĩ;</para>
  <para style="q2" vid="PRO 6:29">gũtirĩ mũndũ ũngĩmũhutia na ndaherithio.<verse eid="PRO 6:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 6:30"/>Andũ matimenaga mũici angĩkorwo aiyĩte</para>
  <para style="q2" vid="PRO 6:30">nĩguo eniinĩre ngʼaragu rĩrĩa arĩ mũhũũtu.<verse eid="PRO 6:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 6:31"/>No rĩrĩ, angĩnyiitwo-rĩ, no nginya arĩhe maita mũgwanja,</para>
  <para style="q2" vid="PRO 6:31">o na angĩkorwo ekũrĩha na ũtonga wa nyũmba yake wothe.<verse eid="PRO 6:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 6:32"/>No mũndũ ũrĩa ũtharagia nĩagĩte wĩciirio;</para>
  <para style="q2" vid="PRO 6:32">ũrĩa wothe wĩkaga ũguo nĩwe mwene wĩyanangaga.<verse eid="PRO 6:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 6:33"/>Nguraro na kwĩnyararithia nĩcio igai rĩake,</para>
  <para style="q2" vid="PRO 6:33">na cio thoni icio ciake gũtirĩ hĩndĩ igaathario ithire;<verse eid="PRO 6:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 6:34"/>nĩgũkorwo ũiru nĩguo warahũraga mangʼũrĩ ma mũthuuri,</para>
  <para style="q2" vid="PRO 6:34">na ndakaigua tha akĩĩrĩhĩria.<verse eid="PRO 6:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 6:35"/>Ndagetĩkĩra irĩhi o na rĩrĩkũ;</para>
  <para style="q2" vid="PRO 6:35">nĩakaarega ihaki o na rĩrĩ inene atĩa.<verse eid="PRO 6:35"/></para>
  <chapter eid="PRO 6"/>
  <chapter number="7" style="c" sid="PRO 7"/>
  <para style="s1">Gũkaanio kũgĩa Ndũgũ na Mũndũ-wa-Nja Mũtharia</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 7:1"/>Mũrũ wakwa, tũũra ũrũmĩtie ciugo ciakwa,</para>
  <para style="q2" vid="PRO 7:1">na wĩigĩre maathani makwa thĩinĩ waku.<verse eid="PRO 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 7:2"/>Rũmia maathani makwa,</para>
  <para style="q2" vid="PRO 7:2">na nĩũgatũũra muoyo;</para>
  <para style="q2" vid="PRO 7:2">gitagĩra morutani makwa o ta kĩũma kĩa riitho rĩaku.<verse eid="PRO 7:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 7:3"/>Mohagĩrĩre ciara-inĩ ciaku;</para>
  <para style="q2" vid="PRO 7:3">ũmaandĩke kĩhengere-inĩ kĩa ngoro yaku.<verse eid="PRO 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 7:4"/>Ĩra ũũgĩ atĩrĩ, “Wee nĩwe mwarĩ wa maitũ,”</para>
  <para style="q2" vid="PRO 7:4">naguo ũtaũku ũwĩtage mũndũ wa nyũmba yanyu;<verse eid="PRO 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 7:5"/>nĩcirĩkweheragia harĩ mũndũ-wa-nja ũcio mũtharia,</para>
  <para style="q2" vid="PRO 7:5">o na kuuma kũrĩ mũtumia ũcio ũtarĩ mwĩhokeku,</para>
  <para style="q2" vid="PRO 7:5">hamwe na ciugo ciake cia kũheenanĩrĩria.<verse eid="PRO 7:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 7:6"/>Ndĩ ndirica-inĩ ya nyũmba yakwa-rĩ,</para>
  <para style="q2" vid="PRO 7:6">nĩndacũthĩrĩirie na nja kamwanya-inĩ,<verse eid="PRO 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 7:7"/>ngĩona kĩmwana gatagatĩ ka arĩa matarĩ oogĩ,</para>
  <para style="q2" vid="PRO 7:7">na ngĩkũũrana gatagatĩ ka aanake,</para>
  <para style="q2" vid="PRO 7:7">mũndũ mwĩthĩ ũtaarĩ na ũũgĩ wa gũkũũrana maũndũ.<verse eid="PRO 7:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 7:8"/>Aikũrũkaga na njĩra ĩrĩa yarĩ hakuhĩ na koine ya kwa mũndũ-wa-nja ũcio,</para>
  <para style="q2" vid="PRO 7:8">agĩthiĩ na njĩra ĩyo yerekeire na gwake mũciĩ,<verse eid="PRO 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 7:9"/>na kwarĩ na mairia o kahwaĩ-inĩ gũgĩtukatuka,</para>
  <para style="q2" vid="PRO 7:9">gũkĩambĩrĩria kũgĩa nduma ya ũtukũ.<verse eid="PRO 7:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 7:10"/>Na rĩrĩ, hagĩũka mũndũ-wa-nja kũmũtũnga,</para>
  <para style="q2" vid="PRO 7:10">wehumbĩte nguo ta mũmaraya, arĩ na wara ngoro-inĩ.<verse eid="PRO 7:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 7:11"/>(Nĩ mũnegeni na mũngʼathia,</para>
  <para style="q2" vid="PRO 7:11">na magũrũ make matikiragĩrĩria mũciĩ;<verse eid="PRO 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 7:12"/>rĩmwe arĩ njĩra-inĩ, na rĩrĩa rĩngĩ arĩ ihaaro-inĩ,</para>
  <para style="q2" vid="PRO 7:12">ehithagĩre andũ koine-inĩ ciothe cia njĩra.)<verse eid="PRO 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 7:13"/>Nake akĩnyiita mwanake ũcio, akĩmũmumunya,</para>
  <para style="q2" vid="PRO 7:13">na akĩmwĩra atĩrĩ ategũconoka,<verse eid="PRO 7:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 7:14"/>“Ndĩ na maruta ma ngwatanĩro mũciĩ,</para>
  <para style="q2" vid="PRO 7:14">tondũ ũmũthĩ nĩhingirie mĩĩhĩtwa yakwa.<verse eid="PRO 7:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 7:15"/>Nĩ ũndũ ũcio ndoimagara, ndooka gũgũtũnga;</para>
  <para style="q2" vid="PRO 7:15">ngũgũcarĩtie mũno, na rĩu nĩndakuona!<verse eid="PRO 7:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 7:16"/>Nĩnjarĩte ũrĩrĩ wakwa</para>
  <para style="q2" vid="PRO 7:16">na macuka ma gatani ma marangi kuuma Misiri.<verse eid="PRO 7:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 7:17"/>Ũrĩrĩ ũcio wakwa nĩndĩũitĩrĩirie indo nungi wega ta manemane,</para>
  <para style="q2" vid="PRO 7:17">na thubiri, o na mũndarathini.<verse eid="PRO 7:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 7:18"/>Ũka twĩhũũnie wendo nginya rũciinĩ;</para>
  <para style="q2" vid="PRO 7:18">reke twĩkenie na wendo!<verse eid="PRO 7:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 7:19"/>Mũthuuri wakwa ndarĩ mũciĩ;</para>
  <para style="q2" vid="PRO 7:19">nĩathiĩte rũgendo rũraihu.<verse eid="PRO 7:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 7:20"/>Nĩathiire na mũhuko wake ũiyũrĩte mbeeca,</para>
  <para style="q2" vid="PRO 7:20">na akainũka mũciĩ o rĩrĩa mweri ũkaiganana.”<verse eid="PRO 7:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 7:21"/>Agĩkĩmũheenereria na ciugo, akĩmũhĩtithia;</para>
  <para style="q2" vid="PRO 7:21">agĩkĩmuuha na mĩario yake mĩnyoroku.<verse eid="PRO 7:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 7:22"/>O rĩmwe akĩmũrũmĩrĩra ta ndegwa ĩgĩthiĩ gũthĩnjwo,</para>
  <para style="q2" vid="PRO 7:22">kana ta thwariga ĩgĩtoonya kĩana-inĩ kĩa mũtego,<verse eid="PRO 7:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 7:23"/>nginya akaaya gũtheecwo ini nĩ mĩguĩ,</para>
  <para style="q2" vid="PRO 7:23">akahaana ta nyoni ĩguthũkĩte mũtego-inĩ,</para>
  <para style="q2" vid="PRO 7:23">ĩtekũmenya o na hanini atĩ ũndũ ũcio no ũmĩrute muoyo.<verse eid="PRO 7:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 7:24"/>Atĩrĩrĩ, ariũ akwa, ta thikĩrĩriai;</para>
  <para style="q2" vid="PRO 7:24">tegai matũ mũigue ũrĩa ngũmwĩra.<verse eid="PRO 7:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 7:25"/>Mũtikanareke ngoro cianyu ĩrũmĩrĩre mĩthiĩre yake,</para>
  <para style="q2" vid="PRO 7:25">kana mũingĩre njĩra-inĩ ciake.<verse eid="PRO 7:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 7:26"/>Nĩ andũ aingĩ arĩkĩtie kũrũnda;</para>
  <para style="q2" vid="PRO 7:26">arĩa oragĩte nĩ kĩrĩndĩ kĩingĩ mũno.<verse eid="PRO 7:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 7:27"/>Nyũmba yake nĩ njĩra njariĩ ya gũthiĩ mbĩrĩra,</para>
  <para style="q2" vid="PRO 7:27">nayo yerekagĩria andũ nyũmba-inĩ cia gĩkuũ.<verse eid="PRO 7:27"/></para>
  <chapter eid="PRO 7"/>
  <chapter number="8" style="c" sid="PRO 8"/>
  <para style="s1">Ũũgĩ Gwĩtana</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 8:1"/>Githĩ ũũgĩ ndareetana?</para>
  <para style="q2" vid="PRO 8:1">Githĩ ũtaũku ndaranĩrĩra na mũgambo wake?<verse eid="PRO 8:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 8:2"/>Njĩra-inĩ kũrĩa gũtũũgĩru, na magomano-inĩ ma njĩra-rĩ,</para>
  <para style="q2" vid="PRO 8:2">nĩho ũũgĩ arũgamĩte;<verse eid="PRO 8:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 8:3"/>ningĩ hakuhĩ na ihingo iria cierekeire itũũra inene,</para>
  <para style="q2" vid="PRO 8:3">o hau matoonyero-inĩ-rĩ, nĩho araanĩrĩra akoiga atĩrĩ:<verse eid="PRO 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 8:4"/>“Inyuĩ andũ nĩ inyuĩ ndĩreeta;</para>
  <para style="q2" vid="PRO 8:4">ndĩraanĩrĩra na mũgambo wakwa kũrĩ andũ othe a thĩ.<verse eid="PRO 8:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 8:5"/>Inyuĩ arĩa mũtarĩ na ũũgĩ, gĩai na ũbaarĩrĩri,</para>
  <para style="q2" vid="PRO 8:5">inyuĩ arĩa akĩĩgu, gĩai na ũtaũku.<verse eid="PRO 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 8:6"/>Thikĩrĩriai, nĩgũkorwo ndĩ na maũndũ ma bata ngwaria;</para>
  <para style="q2" vid="PRO 8:6">ngũtumũra mĩromo yakwa njarie maũndũ marĩa magĩrĩire.<verse eid="PRO 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 8:7"/>Kanua gakwa kaaragia ũhoro wa ma,</para>
  <para style="q2" vid="PRO 8:7">nĩgũkorwo mĩromo yakwa nĩĩthũire waganu mũno ta kĩndũ kĩrĩ magigi.<verse eid="PRO 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 8:8"/>Ciugo ciothe cia kanua gakwa nĩ cia ũthingu;</para>
  <para style="q2" vid="PRO 8:8">gũtirĩ o na kiugo kĩmwe gĩacio kĩogomu kana gĩa kũhĩtithania.<verse eid="PRO 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 8:9"/>Kũrĩ arĩa makũũranaga maũndũ ciugo ciothe nĩciagĩrĩire;</para>
  <para style="q2" vid="PRO 8:9">itirĩ mahĩtia kũrĩ arĩa marĩ na ũmenyo.<verse eid="PRO 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 8:10"/>Thuurai mataaro makwa handũ ha betha,</para>
  <para style="q2" vid="PRO 8:10">mũthuure ũmenyo handũ ha thahabu ĩrĩa njega mũno,<verse eid="PRO 8:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 8:11"/>nĩgũkorwo ũũgĩ nĩ wa goro gũkĩra ruru iria ndune,</para>
  <para style="q2" vid="PRO 8:11">na gũtirĩ kĩndũ ũngĩĩrirĩria kĩngĩringithanio naguo.<verse eid="PRO 8:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 8:12"/>“Niĩ ũũgĩ-rĩ, ndũũranagia na ũbaarĩrĩri;</para>
  <para style="q2" vid="PRO 8:12">nĩndĩgwatĩire ũmenyo o na gũthugunda maũndũ mega.<verse eid="PRO 8:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 8:13"/>Gwĩtigĩra Jehova nĩgũthũũra ũũru;</para>
  <para style="q2" vid="PRO 8:13">nĩthũire mwĩtĩĩo na mwĩtũũgĩrio,</para>
  <para style="q2" vid="PRO 8:13">na mĩtugo mĩũru na mĩario ya waganu.<verse eid="PRO 8:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 8:14"/>Kĩrĩra na ũũgĩ wa gũkũũrana maũndũ nĩ ciakwa;</para>
  <para style="q2" vid="PRO 8:14">niĩ ndĩ na ũtaũku, na ndĩ na ũhoti.<verse eid="PRO 8:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 8:15"/>Athamaki mathamakaga nĩ ũndũ wa hinya wakwa</para>
  <para style="q2" vid="PRO 8:15">nao aathani magathondeka mawatho ma kĩhooto;<verse eid="PRO 8:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 8:16"/>anene mathamakaga nĩ ũndũ wa hinya wakwa,</para>
  <para style="q2" vid="PRO 8:16">o ũndũ ũmwe na arĩa othe marĩ igweta arĩa maathanaga gũkũ thĩ.<verse eid="PRO 8:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 8:17"/>Nĩnyendete arĩa manyendete,</para>
  <para style="q2" vid="PRO 8:17">nao arĩa manjaragia na kĩyo nĩmanyonaga.<verse eid="PRO 8:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 8:18"/>Ũtonga na gĩtĩĩo cionekaga harĩ niĩ,</para>
  <para style="q2" vid="PRO 8:18">o hamwe na ũtonga wa gũtũũra, na ũgaacĩru.<verse eid="PRO 8:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 8:19"/>Maciaro makwa nĩ mega gũkĩra thahabu ĩrĩa therie;</para>
  <para style="q2" vid="PRO 8:19">uumithio wakwa nĩũkĩrĩte betha ĩrĩa njega.<verse eid="PRO 8:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 8:20"/>Niĩ thiiaga na njĩra ya ũthingu,</para>
  <para style="q2" vid="PRO 8:20">ngathiĩra o njĩra-inĩ cia kĩhooto,<verse eid="PRO 8:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 8:21"/>ngĩheaga andũ arĩa manyendete ũtonga,</para>
  <para style="q2" vid="PRO 8:21">na ngaiyũragia igĩĩna ciao.<verse eid="PRO 8:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 8:22"/>“Jehova aanyũmbire o kĩambĩrĩria-inĩ kĩa wĩra wake,</para>
  <para style="q2" vid="PRO 8:22">mbere ya mawĩra make ma tene;<verse eid="PRO 8:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 8:23"/>ndaathuurirwo kuuma tene wa tene,</para>
  <para style="q2" vid="PRO 8:23">kuuma o kĩambĩrĩria, thĩ ĩtarĩ yagĩa.<verse eid="PRO 8:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 8:24"/>Rĩrĩa gũtaagĩte maria manene-rĩ, nĩguo ndaciarirwo,</para>
  <para style="q2" vid="PRO 8:24">o hĩndĩ ĩrĩa gũtaarĩ matherũkĩro maiyũrĩte maaĩ;<verse eid="PRO 8:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 8:25"/>ndaciarirwo irĩma itanahaandwo harĩa irĩ,</para>
  <para style="q2" vid="PRO 8:25">na tũrĩma tũtanagĩa,<verse eid="PRO 8:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 8:26"/>we atanoomba thĩ kana ithaka ciayo,</para>
  <para style="q2" vid="PRO 8:26">o na kana rũkũngũ o ruothe rwa thĩ.<verse eid="PRO 8:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 8:27"/>Niĩ ndaarĩ o kuo hĩndĩ ĩrĩa aathondekire igũrũ na akĩrĩiga handũ ha rĩo,</para>
  <para style="q2" vid="PRO 8:27">hĩndĩ ĩrĩa eekĩrire rũkiriri rwa kũrĩa kũriku,<verse eid="PRO 8:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 8:28"/>rĩrĩa aahaandire matu kũu igũrũ,</para>
  <para style="q2" vid="PRO 8:28">na akĩrũmia ithima cia kũrĩa kũriku wega,<verse eid="PRO 8:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 8:29"/>rĩrĩa eekĩrire mũhaka wa iria</para>
  <para style="q2" vid="PRO 8:29">nĩguo maaĩ matikanae kwagarara watho wake,</para>
  <para style="q1" vid="PRO 8:29">na rĩrĩa aahandire mĩthingi ya thĩ.<verse eid="PRO 8:29"/></para>
  <para style="q2">
    <verse number="30" style="v" sid="PRO 8:30"/>Hĩndĩ ĩyo ndaarĩ o hakuhĩ nake ndĩ ta mũbundi mũũgĩ.</para>
  <para style="q1" vid="PRO 8:30">Ndaaiyũrĩtwo nĩ gĩkeno mũthenya o mũthenya,</para>
  <para style="q2" vid="PRO 8:30">na ngakenaga hĩndĩ ciothe ndĩ mbere yake,<verse eid="PRO 8:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 8:31"/>ngakenagĩra thĩ yake yothe,</para>
  <para style="q2" vid="PRO 8:31">na ngakenagio nĩ andũ othe a thĩ.<verse eid="PRO 8:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 8:32"/>“Atĩrĩrĩ ariũ akwa, ta thikĩrĩriai;</para>
  <para style="q2" vid="PRO 8:32">kũrathimwo nĩ arĩa marũmagia njĩra ciakwa.<verse eid="PRO 8:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 8:33"/>Ta thikĩrĩriai mataaro makwa nĩguo mũhĩge;</para>
  <para style="q2" vid="PRO 8:33">mũtikamarege.<verse eid="PRO 8:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 8:34"/>Kũrathimwo nĩ mũndũ ũrĩa ũnjiguaga,</para>
  <para style="q2" vid="PRO 8:34">agacũthagĩrĩria mĩrango-inĩ yakwa o mũthenya,</para>
  <para style="q2" vid="PRO 8:34">akanjetagĩrĩra hingĩro-inĩ cia mĩrango yakwa.<verse eid="PRO 8:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 8:35"/>Nĩgũkorwo ũrĩa wothe ũgĩte na niĩ nĩ muoyo agĩte naguo,</para>
  <para style="q2" vid="PRO 8:35">nake akagĩa na agetĩkĩrĩka harĩ Jehova.<verse eid="PRO 8:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PRO 8:36"/>No ũrĩa wothe ũhĩtanĩtie na niĩ nĩ ũũru eĩkaga;</para>
  <para style="q2" vid="PRO 8:36">nao arĩa othe maathũire nĩ gĩkuũ mendete.”<verse eid="PRO 8:36"/></para>
  <chapter eid="PRO 8"/>
  <chapter number="9" style="c" sid="PRO 9"/>
  <para style="s1">Ũũgĩ na Ũkĩĩgu Gwĩtana</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 9:1"/>Ũũgĩ nĩakĩte nyũmba yake;</para>
  <para style="q2" vid="PRO 9:1">nĩaicũhĩtie itugĩ ciayo mũgwanja.<verse eid="PRO 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 9:2"/>Nĩahaarĩirie nyama, na akahaarĩria ndibei,<note caller="+" style="f"><char style="fr" closed="false">9:2 </char><char style="ft" closed="false">Ndibei nĩyatukanagio na indo ingĩ ta manemane nĩgeetha ĩcame wega.</char></note></para>
  <para style="q2" vid="PRO 9:2">o na akaara metha yake.<verse eid="PRO 9:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 9:3"/>Nĩatũmĩte ndungata ciake cia airĩtu nja,</para>
  <para style="q2" vid="PRO 9:3">na nĩaretana arĩ harĩa hatũũgĩru mũno itũũra-inĩ rĩrĩa inene, akoiga atĩrĩ:<verse eid="PRO 9:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 9:4"/>“Andũ arĩa othe matarĩ na ũũgĩ nĩmoke gũkũ!”</para>
  <para style="q2" vid="PRO 9:4">Ningĩ akeera andũ arĩa maagĩĩte ũtaũku atĩrĩ,<verse eid="PRO 9:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 9:5"/>Ũkai mũrĩe irio ciakwa,</para>
  <para style="q2" vid="PRO 9:5">na mũnyue ndibei ĩrĩa ndĩmũthondekeire.<verse eid="PRO 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 9:6"/>Tiganai na mĩthiĩre yanyu ĩtarĩ ya ũũgĩ, na nĩmũgũtũũra muoyo;</para>
  <para style="q2" vid="PRO 9:6">cookai gũthiiaga na njĩra ya ũtaũku.<verse eid="PRO 9:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 9:7"/>“Ũrĩa wothe ũtaaraga mũnyũrũrania eĩtagĩria irumi;</para>
  <para style="q2" vid="PRO 9:7">na ũrĩa wothe ũkaanagia mũndũ mwaganu egĩĩragĩra njono.<verse eid="PRO 9:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 9:8"/>Ndũkanataare mũnyũrũrania, nĩguo ndagagũthũũre;</para>
  <para style="q2" vid="PRO 9:8">kaania mũndũ mũũgĩ, nake nĩegũkwenda.<verse eid="PRO 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 9:9"/>Taara mũndũ mũũgĩ na nĩegũkĩrĩrĩria kũũhĩga;</para>
  <para style="q2" vid="PRO 9:9">mũndũ mũthingu mũrute, na nĩekuongerera ũũgĩ wake.<verse eid="PRO 9:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 9:10"/>“Kĩambĩrĩria kĩa ũũgĩ nĩ gwĩtigĩra Jehova,</para>
  <para style="q2" vid="PRO 9:10">na kũmenya Ũrĩa Mũtheru nĩkuo gũtaũkĩrwo.<verse eid="PRO 9:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 9:11"/>Nĩgũkorwo nĩ ũndũ wakwa matukũ maku nĩmakaingĩha,</para>
  <para style="q2" vid="PRO 9:11">na wongererwo mĩaka ya gũtũũra muoyo.<verse eid="PRO 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 9:12"/>Ũngĩkorwo ũrĩ mũũgĩ-rĩ, ũũgĩ waku nĩũgakũguna;</para>
  <para style="q2" vid="PRO 9:12">na ũngĩkorwo ũrĩ mũnyũrũrania-rĩ, we nowe ũkaanyariirĩka.”<verse eid="PRO 9:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 9:13"/>Mũndũ-wa-nja ũrĩa wĩtagwo Mũkĩĩgu nĩ wa inegene;</para>
  <para style="q2" vid="PRO 9:13">we ndarĩ mũtugo, na ndarĩ ũmenyo.<verse eid="PRO 9:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 9:14"/>Aikaraga thĩ mũrango-inĩ wa nyũmba yake,</para>
  <para style="q2" vid="PRO 9:14">agaikarĩra gĩtĩ harĩa hatũũgĩru mũno itũũra-inĩ rĩrĩa inene,<verse eid="PRO 9:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 9:15"/>ageetaga arĩa marehĩtũkĩra,</para>
  <para style="q2" vid="PRO 9:15">arĩa marethiĩra na njĩra ciao.<verse eid="PRO 9:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 9:16"/>Ameeraga atĩrĩ, “Andũ arĩa othe matarĩ na ũũgĩ nĩmoke gũkũ!”</para>
  <para style="q2" vid="PRO 9:16">Nao arĩa maagĩĩte ũtaũku akameera atĩrĩ:<verse eid="PRO 9:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 9:17"/>“Maaĩ ma kũiya marĩ mũrĩo;</para>
  <para style="q2" vid="PRO 9:17">o na irio iria irĩĩagĩrwo hitho-inĩ irĩ cama!”<verse eid="PRO 9:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 9:18"/>No andũ acio matikoragwo makĩmenya atĩ arĩa akuũ marĩ kũu,</para>
  <para style="q2" vid="PRO 9:18">na atĩ ageni ake marĩ o kũrĩa kũriku mbĩrĩra-inĩ.<verse eid="PRO 9:18"/></para>
  <chapter eid="PRO 9"/>
  <chapter number="10" style="c" sid="PRO 10"/>
  <para style="s1">Thimo cia Solomoni</para>
  <para style="p">Ici nĩ Thimo cia Solomoni:</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 10:1"/>Mwana mũũgĩ atũmaga ithe akene,</para>
  <para style="q2" vid="PRO 10:1">no mwana mũkĩĩgu atũũragia nyina na kĩeha.<verse eid="PRO 10:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 10:2"/>Mĩthiithũ yumanĩte na ungumania ndĩrĩ kĩguni,</para>
  <para style="q2" vid="PRO 10:2">no ũthingu ũkũũraga mũndũ kuuma kũrĩ gĩkuũ.<verse eid="PRO 10:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 10:3"/>Jehova ndarekagĩrĩria mũndũ mũthingu ahũte,</para>
  <para style="q2" vid="PRO 10:3">no nĩamarigagĩrĩria merirĩria ma mũndũ mwaganu.<verse eid="PRO 10:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 10:4"/>Moko ma kĩgũũta matũmaga mũndũ athĩĩne,</para>
  <para style="q2" vid="PRO 10:4">no moko ma mũndũ ũrĩ kĩyo marehaga ũtonga.<verse eid="PRO 10:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 10:5"/>Ũrĩa ũcookanagĩrĩria irio hĩndĩ ya riũa nĩ mwana mũũgĩ,</para>
  <para style="q2" vid="PRO 10:5">no ũrĩa ũkomaga hĩndĩ ya magetha nĩ mwana wa kũrehe thoni.<verse eid="PRO 10:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 10:6"/>Mũtwe wa mũndũ mũthingu ũikaraga ũhumbĩrĩtwo nĩ irathimo,</para>
  <para style="q2" vid="PRO 10:6">no kanua ka mũndũ mwaganu kaiyũraga ngũĩ.<verse eid="PRO 10:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 10:7"/>Kĩririkano kĩa mũndũ mũthingu gĩgatuĩka kĩrathimo,</para>
  <para style="q2" vid="PRO 10:7">no rĩĩtwa rĩa mũndũ mwaganu nĩrĩkabutha.<verse eid="PRO 10:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 10:8"/>Mũndũ ũrĩa ũrĩ na ũũgĩ wa ngoro nĩetĩkagĩra mawatho,</para>
  <para style="q2" vid="PRO 10:8">no mũndũ wa kũhũhũtĩka nĩakanangĩka.<verse eid="PRO 10:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 10:9"/>Mũndũ wa mĩthiĩre mĩrũngĩrĩru athiiaga ategwĩtigĩra ũgwati,</para>
  <para style="q2" vid="PRO 10:9">no mũndũ ũrĩa ũrĩ mĩthiĩre mĩogomu nĩakamenyeka.<verse eid="PRO 10:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 10:10"/>Mũndũ ũrĩa uunagĩra ũngĩ riitho na rũnano nĩarehage kĩeha,</para>
  <para style="q2" vid="PRO 10:10">na mwaria mũkĩĩgu nĩakanangĩka.<verse eid="PRO 10:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 10:11"/>Kanua ka mũndũ mũthingu nĩ gĩthima kĩa muoyo,</para>
  <para style="q2" vid="PRO 10:11">no kanua ka mũndũ mwaganu kaiyũraga ngũĩ.<verse eid="PRO 10:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 10:12"/>Rũmena rũrehaga nyamũkano,</para>
  <para style="q2" vid="PRO 10:12">no wendani ũhumbagĩra ũũru wothe.<verse eid="PRO 10:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 10:13"/>Ũũgĩ ũkoragwo mĩromo-inĩ ya mũndũ ũrĩa mũkũũrani maũndũ,</para>
  <para style="q2" vid="PRO 10:13">no mũndũ ũrĩa ũtooĩ gũkũũrana maũndũ aagĩrĩirwo nĩ rũthanju ciande-inĩ ciake.<verse eid="PRO 10:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 10:14"/>Andũ oogĩ meigagĩra ũmenyo,</para>
  <para style="q2" vid="PRO 10:14">no kanua ga kĩrimũ keĩtagĩria mwanangĩko.<verse eid="PRO 10:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 10:15"/>Indo cia itonga nĩ gĩtũũro kĩao kĩirigĩre na hinya,</para>
  <para style="q2" vid="PRO 10:15">no ũkĩa nĩguo mwanangĩko wa andũ arĩa athĩĩni.<verse eid="PRO 10:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 10:16"/>Mũcaara wa andũ arĩa athingu ũmarehagĩra muoyo,</para>
  <para style="q2" vid="PRO 10:16">no indo iria cionagwo nĩ andũ arĩa aaganu imarehagĩra iherithia.<verse eid="PRO 10:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 10:17"/>Mũndũ ũrĩa ũiguaga agĩtaarwo arĩ njĩra-inĩ ya muoyo,</para>
  <para style="q2" vid="PRO 10:17">no mũndũ ũrĩa ũregaga kũrũithio-rĩ, nĩahĩtithagia andũ arĩa angĩ.<verse eid="PRO 10:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 10:18"/>Mũndũ ũrĩa ũhithaga rũmena rwake aaragia na mĩromo ya maheeni,</para>
  <para style="q2" vid="PRO 10:18">na ũrĩa wothe ũcambanagia nĩ mũndũ mũkĩĩgu.<verse eid="PRO 10:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 10:19"/>Rĩrĩa ciugo ciaingĩha mehia matiagaga,</para>
  <para style="q2" vid="PRO 10:19">no mũndũ ũrĩa ũkiraga nĩ mũũgĩ.<verse eid="PRO 10:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 10:20"/>Rũrĩmĩ rwa mũndũ mũthingu nĩ betha njega,</para>
  <para style="q2" vid="PRO 10:20">no ngoro ya mũndũ mwaganu ndĩrĩ bata.<verse eid="PRO 10:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 10:21"/>Mĩromo ya arĩa athingu ĩhũnagia andũ aingĩ,</para>
  <para style="q2" vid="PRO 10:21">no andũ akĩĩgu makuaga nĩ kwaga gũkũũrana maũndũ.<verse eid="PRO 10:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 10:22"/>Kĩrathimo kĩa Jehova nĩkĩo kĩrehaga ũtonga,</para>
  <para style="q2" vid="PRO 10:22">na ndarĩ kĩeha onganagĩrĩria nakĩo.<verse eid="PRO 10:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 10:23"/>Mũndũ mũkĩĩgu akenagĩra mĩtugo mĩũru,</para>
  <para style="q2" vid="PRO 10:23">no mũndũ ũrĩ na ũtaũku akenagĩra ũũgĩ.<verse eid="PRO 10:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 10:24"/>Kĩrĩa mũndũ mwaganu etigagĩra nĩkĩo gĩkaamũkora,</para>
  <para style="q2" vid="PRO 10:24">na kĩrĩa mũndũ mũthingu eriragĩria nĩkĩo akaaheo.<verse eid="PRO 10:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 10:25"/>Kĩhuhũkanio kĩahĩtũka andũ arĩa aaganu maticookaga kuoneka,</para>
  <para style="q2" vid="PRO 10:25">no andũ arĩa athingu mehaandaga wega nginya tene.<verse eid="PRO 10:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 10:26"/>Ta ũrĩa thiki ĩgagatagĩra magego, na ndogo ĩkarũrĩra maitho-rĩ,</para>
  <para style="q2" vid="PRO 10:26">noguo kĩgũũta kĩhaana kũrĩ arĩa magĩtũmaga.<verse eid="PRO 10:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 10:27"/>Gwĩtigĩra Jehova-rĩ, kuongagĩrĩra mũndũ matukũ ma gũtũũra muoyo,</para>
  <para style="q2" vid="PRO 10:27">no mĩaka ya mũndũ mwaganu nĩkũnyiihio ĩnyiihagio.<verse eid="PRO 10:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 10:28"/>Itanya rĩa mũndũ mũthingu nĩ gĩkeno,</para>
  <para style="q2" vid="PRO 10:28">no kĩĩrĩgĩrĩro kĩa mũndũ mwaganu no gĩa tũhũ.<verse eid="PRO 10:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 10:29"/>Njĩra ya Jehova nĩ rĩũrĩro rĩa andũ arĩa athingu,</para>
  <para style="q2" vid="PRO 10:29">no nĩ mwanangĩko harĩ arĩa mekaga ũũru.<verse eid="PRO 10:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 10:30"/>Mũndũ ũrĩa mũthingu ndarĩ hĩndĩ akaamunywo,</para>
  <para style="q2" vid="PRO 10:30">no ũrĩa mwaganu ndagatũũra thĩinĩ wa bũrũri.<verse eid="PRO 10:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 10:31"/>Kanua ka mũndũ ũrĩa mũthingu karehaga ũũgĩ,</para>
  <para style="q2" vid="PRO 10:31">no rũrĩmĩ rwa ũtũrĩka nĩrũkaniinwo.<verse eid="PRO 10:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 10:32"/>Mĩromo ya mũndũ mũthingu nĩyũũĩ kwaria ndeto iria ciagĩrĩire,</para>
  <para style="q2" vid="PRO 10:32">no kanua ka ũrĩa mwaganu kaaragia o rũtũrĩko.<verse eid="PRO 10:32"/></para>
  <para style="b"/>
  <chapter eid="PRO 10"/>
  <chapter number="11" style="c" sid="PRO 11"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 11:1"/>Ratiri itarĩ cia ma nĩ kĩndũ kĩrĩ magigi harĩ Jehova,</para>
  <para style="q2" vid="PRO 11:1">no nĩakenagĩra mahiga ma gũthima marĩa maigananu.<verse eid="PRO 11:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 11:2"/>Rĩrĩa mwĩtĩĩo woka, ũrũmagĩrĩrwo nĩ thoni,</para>
  <para style="q2" vid="PRO 11:2">no kwĩnyiihia kũrehaga ũũgĩ.<verse eid="PRO 11:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 11:3"/>Ũrũngĩrĩru wa arĩa marũgamĩte wega nĩũmonagĩrĩria njĩra,</para>
  <para style="q2" vid="PRO 11:3">no andũ arĩa matarĩ ehokeku, nĩmanangagwo nĩ ũhinga wao.<verse eid="PRO 11:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 11:4"/>Ũtonga ndũrĩ kĩguni mũthenya wa mangʼũrĩ,</para>
  <para style="q2" vid="PRO 11:4">no ũthingu nĩũkũũraga mũndũ kuuma kũrĩ gĩkuũ.<verse eid="PRO 11:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 11:5"/>Ũthingu wa andũ arĩa matarĩ na ũcuuke ũmathondekagĩra njĩra nũngarũ,</para>
  <para style="q2" vid="PRO 11:5">no andũ arĩa aaganu magũithagio nĩ waganu wao ene.<verse eid="PRO 11:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 11:6"/>Ũthingu wa andũ arĩa arũngĩrĩru nĩũmahonokagia,</para>
  <para style="q2" vid="PRO 11:6">no andũ arĩa matarĩ ehokeku nĩmategagwo nĩ merirĩria mao mooru.<verse eid="PRO 11:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 11:7"/>Hĩndĩ ĩrĩa mũndũ mwaganu aakua, kĩĩrĩgĩrĩro gĩake nĩgũthira gĩthiraga;</para>
  <para style="q2" vid="PRO 11:7">kĩrĩa gĩothe eerĩgĩrĩire kuuma kũrĩ ũhoti wake gĩtuĩkaga o tũhũ.<verse eid="PRO 11:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 11:8"/>Mũndũ ũrĩa mũthingu nĩahonokagio kuuma thĩĩna-inĩ,</para>
  <para style="q2" vid="PRO 11:8">naguo ũgaacookerera ũrĩa mwaganu.<verse eid="PRO 11:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 11:9"/>Mũndũ ũtetigĩrĩte Ngai nĩanangaga mũndũ wa itũũra na kanua gake,</para>
  <para style="q2" vid="PRO 11:9">no arĩa athingu nĩmetharaga nĩ ũndũ wa ũmenyo.<verse eid="PRO 11:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 11:10"/>Rĩrĩa andũ arĩa athingu magaacĩra, itũũra nĩgũkena rĩkenaga;</para>
  <para style="q2" vid="PRO 11:10">rĩrĩa andũ arĩa aaganu maathira, nĩkũrũhio kũrũũhagio.<verse eid="PRO 11:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 11:11"/>Itũũra inene nĩrĩtũũgagĩrio nĩ ũndũ wa kĩrathimo kĩa andũ arĩa arũngĩrĩru,</para>
  <para style="q2" vid="PRO 11:11">no nĩrĩanangagwo nĩ kanua ka andũ arĩa aaganu.<verse eid="PRO 11:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 11:12"/>Mũndũ ũtarĩ ũũgĩ wa gũkũũrana maũndũ anyũrũragia mũndũ wa itũũra rĩake,</para>
  <para style="q2" vid="PRO 11:12">no mũndũ ũrĩ na ũtaũku nĩ gwĩkirĩra ekiragĩra.<verse eid="PRO 11:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 11:13"/>Mũndũ wa mũhuhu nĩoimagia ndeto cia ndundu nja,</para>
  <para style="q2" vid="PRO 11:13">no mũndũ mwĩhokeku nĩaigaga hitho.<verse eid="PRO 11:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 11:14"/>Bũrũri ũngĩaga ũtongoria mwega nĩkũgũa ũgũũaga,</para>
  <para style="q2" vid="PRO 11:14">no ataarani aingĩ matũmaga kũgĩe na ũhootani kũna.<verse eid="PRO 11:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 11:15"/>Mũndũ ũrĩa ũrũgamagĩrĩra thiirĩ wa mũndũ ũngĩ ti-itherũ nĩagathĩĩnĩka,</para>
  <para style="q2" vid="PRO 11:15">no mũndũ ũrĩa wothe wagaga kũrũgamĩrĩra mũndũ thiirĩ atũũraga na thayũ.<verse eid="PRO 11:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 11:16"/>Mũndũ-wa-nja mũtaana nĩegĩagĩra gĩtĩĩo,</para>
  <para style="q2" vid="PRO 11:16">no arũme arĩa matarĩ tha no ũtonga magĩaga naguo.<verse eid="PRO 11:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 11:17"/>Mũndũ mũtaana egunaga we mwene,</para>
  <para style="q2" vid="PRO 11:17">no mũndũ ũtarĩ tha erehagĩra thĩĩna we mwene.<verse eid="PRO 11:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 11:18"/>Mũndũ mwaganu athũkũmaga mũcaara wa kũmũheenia,</para>
  <para style="q2" vid="PRO 11:18">no ũrĩa ũhaandaga ũthingu nĩagethaga irĩhi rĩa ma.<verse eid="PRO 11:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 11:19"/>Mũndũ ũrĩa mũthingu kũna nĩagatũũra muoyo,</para>
  <para style="q2" vid="PRO 11:19">no mũndũ ũrĩa ũrũmagĩrĩra waganu nĩ gũkua agaakua.<verse eid="PRO 11:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 11:20"/>Andũ arĩa marĩ ngoro ya rũtũrĩko nĩ kĩndũ kĩrĩ magigi harĩ Jehova,</para>
  <para style="q2" vid="PRO 11:20">no nĩakenagio nĩ andũ arĩa njĩra ciao itarĩ ũcuuke.<verse eid="PRO 11:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 11:21"/>Ti-itherũ mũndũ mwaganu ndakaaga kũherithio,</para>
  <para style="q2" vid="PRO 11:21">no andũ arĩa athingu nĩmakahonokio.<verse eid="PRO 11:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 11:22"/>Mũndũ-wa-nja mũthaka ũtarĩ ũgereri</para>
  <para style="q2" vid="PRO 11:22">ahaana ta gĩcũhĩ gĩa thahabu kĩrĩ iniũrũ-inĩ rĩa ngũrwe.<verse eid="PRO 11:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 11:23"/>Wendi wa mũndũ mũthingu ũrĩkagĩrĩria o wega-inĩ,</para>
  <para style="q2" vid="PRO 11:23">no kĩĩrĩgĩrĩro kĩa mũndũ ũrĩa mwaganu kĩrĩĩkagĩrĩria mangʼũrĩ-inĩ.<verse eid="PRO 11:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 11:24"/>Kũrĩ mũndũ ũheanaga na ũtaana, nake agakĩrĩrĩria kũgĩa na indo;</para>
  <para style="q2" vid="PRO 11:24">ũngĩ atuĩkaga mũkarĩ mũno, no agathiĩ o na mbere gũthĩĩna.<verse eid="PRO 11:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 11:25"/>Mũndũ mũtaana nĩakagaacĩra;</para>
  <para style="q2" vid="PRO 11:25">ũrĩa ũnyootoraga arĩa angĩ o nake mwene nĩakanyootorwo.<verse eid="PRO 11:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 11:26"/>Mũndũ ũrĩa ũregaga kwenderia andũ mbembe iria aigĩte nĩarumagwo nĩ andũ,</para>
  <para style="q2" vid="PRO 11:26">no mũndũ ũrĩa ũciendagia, kĩrathimo kĩrĩkoragwo mũtwe-inĩ wake.<verse eid="PRO 11:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 11:27"/>Mũndũ ũrĩa ũcaragia maũndũ mega arĩonaga o wega,</para>
  <para style="q2" vid="PRO 11:27">no ũrĩa ũcaragia maũndũ mooru no mo marĩmũkoraga.<verse eid="PRO 11:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 11:28"/>Mũndũ ũrĩa wothe wĩhokaga ũtonga wake nĩkũgũa akaagũa,</para>
  <para style="q2" vid="PRO 11:28">no arĩa athingu makaagaacĩra ta ithangũ rĩrĩa iruru.<verse eid="PRO 11:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 11:29"/>Mũndũ ũrĩa ũnyamaragia mũciĩ wake akaagaya o rũhuho,</para>
  <para style="q2" vid="PRO 11:29">nake mũndũ mũkĩĩgu agaatuĩka ndungata ya ũrĩa mũũgĩ.<verse eid="PRO 11:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 11:30"/>Maciaro ma andũ arĩa athingu nĩ mũtĩ wa muoyo,</para>
  <para style="q2" vid="PRO 11:30">nake mũndũ ũrĩa mũũgĩ nĩaguucagĩrĩria ngoro cia andũ.<verse eid="PRO 11:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 11:31"/>Angĩkorwo andũ arĩa athingu nĩmarĩhagwo marĩ gũkũ thĩ-rĩ,</para>
  <para style="q2" vid="PRO 11:31">githĩ arĩa matetigĩrĩte Ngai na arĩa ehia matikarĩhwo makĩria!<verse eid="PRO 11:31"/></para>
  <para style="b"/>
  <chapter eid="PRO 11"/>
  <chapter number="12" style="c" sid="PRO 12"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 12:1"/>Mũndũ ũrĩa wothe wendete ũtaaro nĩendete ũmenyi,</para>
  <para style="q2" vid="PRO 12:1">no ũrĩa ũthũire gũkaanio nĩ mũndũ mũkĩĩgu.<verse eid="PRO 12:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 12:2"/>Mũndũ ũrĩa mwega nĩatugagwo nĩ Jehova,</para>
  <para style="q2" vid="PRO 12:2">no mũndũ mwara Jehova amũtuaga mũndũ mwĩhia.<verse eid="PRO 12:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 12:3"/>Mũndũ ndangĩhota kwĩhaanda na maũndũ ma waganu,</para>
  <para style="q2" vid="PRO 12:3">no ũrĩa mũthingu ndangĩenyenyeka.<verse eid="PRO 12:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 12:4"/>Mũtumia ũrĩa ngatha nĩwe thũmbĩ ya mũthuuri wake,</para>
  <para style="q2" vid="PRO 12:4">no mũtumia ũconorithagia mũthuuri wake atariĩ ta ũbuthu mahĩndĩ-inĩ make.<verse eid="PRO 12:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 12:5"/>Mĩbango ya andũ arĩa athingu nĩ ya kĩhooto,</para>
  <para style="q2" vid="PRO 12:5">no ũtaaro wa andũ arĩa aaganu nĩ wa maheeni.<verse eid="PRO 12:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 12:6"/>Ndeto cia andũ arĩa aaganu nĩ cia kuohia andũ mamaite thakame,</para>
  <para style="q2" vid="PRO 12:6">no mĩario ya andũ arĩa arũngĩrĩru nĩĩmahonokagia.<verse eid="PRO 12:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 12:7"/>Andũ aaganu mangʼaũranagio magathira biũ,</para>
  <para style="q2" vid="PRO 12:7">no nyũmba ya mũndũ ũrĩa mũthingu ĩtũũraga ĩrĩ nũmu.<verse eid="PRO 12:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 12:8"/>Mũndũ agaathagĩrĩrio kũringana na ũũgĩ wake,</para>
  <para style="q2" vid="PRO 12:8">no andũ marĩ meciiria mogomu nĩmamenagwo.<verse eid="PRO 12:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 12:9"/>Kaba mũndũ ũrĩa wonagwo ta atarĩ bata no nĩ arĩ ndungata,</para>
  <para style="q2" vid="PRO 12:9">gũkĩra ũrĩa wĩtuaga atĩ nĩ mũndũ wa bata, na ndarĩ gĩa kũrĩa.<verse eid="PRO 12:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 12:10"/>Mũndũ mũthingu nĩamenyagĩrĩra muoyo wa nyamũ yake,</para>
  <para style="q2" vid="PRO 12:10">no maũndũ marĩa ma tha ma ũrĩa mwaganu nĩ ma kũnyariirana.<verse eid="PRO 12:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 12:11"/>Mũndũ ũrĩa ũrĩmaga mũgũnda wake nĩarĩkoragwo na irio nyingĩ,</para>
  <para style="q2" vid="PRO 12:11">no ũrĩa ũhanyũkanagia na maũndũ ma tũhũ nĩagĩte gũkũũrana maũndũ.<verse eid="PRO 12:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 12:12"/>Arĩa aaganu meriragĩria indo iria itahĩtwo nĩ andũ arĩa ooru,</para>
  <para style="q2" vid="PRO 12:12">no mĩri ya arĩa athingu nĩĩgaacagĩra.<verse eid="PRO 12:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 12:13"/>Mũndũ mũũru ategagwo nĩ mĩario ya wĩhia wake,</para>
  <para style="q2" vid="PRO 12:13">no mũndũ mũthingu nĩahonokaga kuuma thĩĩna-inĩ.<verse eid="PRO 12:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 12:14"/>Mũndũ nĩaiyũragwo nĩ maciaro mega ma kanua gake,</para>
  <para style="q2" vid="PRO 12:14">ti-itherũ, o ta ũrĩa agunagwo nĩ wĩra wa moko make.<verse eid="PRO 12:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 12:15"/>Njĩra ya mũndũ mũkĩĩgu yonekaga yagĩrĩire harĩ we,</para>
  <para style="q2" vid="PRO 12:15">no mũndũ mũũgĩ nĩathikagĩrĩria mataaro.<verse eid="PRO 12:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 12:16"/>Mũndũ mũkĩĩgu onanagia marakara make o rĩmwe,</para>
  <para style="q2" vid="PRO 12:16">no mũndũ mũbaarĩrĩri aarumwo ndatindanagĩrĩra.<verse eid="PRO 12:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 12:17"/>Mũira wa ma arutaga o ũira wa ma,</para>
  <para style="q2" vid="PRO 12:17">no mũira ũtarĩ wa ma aaragia maheeni.<verse eid="PRO 12:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 12:18"/>Ciugo iteciirĩtio itheecaga ta rũhiũ rwa njora,</para>
  <para style="q2" vid="PRO 12:18">no rũrĩmĩ rwa mũndũ ũrĩa mũũgĩ nĩkũhonia rũhonagia.<verse eid="PRO 12:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 12:19"/>Mĩromo ĩrĩa yaragia ma ĩtũũraga nginya tene,</para>
  <para style="q2" vid="PRO 12:19">no rũrĩmĩ rwa maheeni nĩ rwa kahinda o kanini.<verse eid="PRO 12:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 12:20"/>Ngoro cia arĩa mathugundaga gwĩka ũũru ciyũrĩtwo nĩ maheeni,</para>
  <para style="q2" vid="PRO 12:20">no gĩkeno nĩ kĩa andũ arĩa matũmaga thayũ ũgaacĩre.<verse eid="PRO 12:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 12:21"/>Gũtirĩ ũũru ũngĩkora andũ arĩa athingu,</para>
  <para style="q2" vid="PRO 12:21">no arĩa aaganu maiyũrĩtwo nĩ thĩĩna.<verse eid="PRO 12:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 12:22"/>Mĩromo ĩrĩa ĩheenanagia nĩ kĩndũ kĩrĩ magigi harĩ Jehova,</para>
  <para style="q2" vid="PRO 12:22">no nĩakenagio nĩ andũ arĩa maaragia ma.<verse eid="PRO 12:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 12:23"/>Mũndũ mũbaarĩrĩri nĩahithaga ũmenyi wake,</para>
  <para style="q2" vid="PRO 12:23">no ngoro cia andũ arĩa akĩĩgu ĩmemerekagia ũrimũ.<verse eid="PRO 12:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 12:24"/>Moko ma mũndũ ũrĩ kĩyo nĩmo magaathana,</para>
  <para style="q2" vid="PRO 12:24">no kĩgũũta gĩkaarutithio wĩra wa ũkombo.<verse eid="PRO 12:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 12:25"/>Ũritũ wa ngoro nĩũhatagĩrĩria mũndũ,</para>
  <para style="q2" vid="PRO 12:25">no ciugo njega nĩitũmaga akene.<verse eid="PRO 12:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 12:26"/>Mũndũ mũthingu nĩataaraga arata ake,</para>
  <para style="q2" vid="PRO 12:26">no njĩra ya arĩa aaganu nĩ kũmahĩtithia ĩmahĩtithagia.<verse eid="PRO 12:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 12:27"/>Mũndũ kĩgũũta o na ndahĩhagia nyama cia ũguĩmi wake,</para>
  <para style="q2" vid="PRO 12:27">no mũndũ ũrĩ kĩyo onaga indo ciake irĩ cia goro.<verse eid="PRO 12:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 12:28"/>Muoyo wonekaga na njĩra ya ũthingu;</para>
  <para style="q2" vid="PRO 12:28">na njĩra-inĩ ĩyo-rĩ, kũrĩ muoyo ũtagaathira.<verse eid="PRO 12:28"/></para>
  <para style="b"/>
  <chapter eid="PRO 12"/>
  <chapter number="13" style="c" sid="PRO 13"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 13:1"/>Mwana mũũgĩ nĩathikagĩrĩria ũrutani wa ithe,</para>
  <para style="q2" vid="PRO 13:1">no mũnyũrũrania ndathikagĩrĩria agĩkaanio.<verse eid="PRO 13:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 13:2"/>Mũndũ nĩakenagĩra maciaro mega ma kuuma kanua gake,</para>
  <para style="q2" vid="PRO 13:2">no mũndũ ũrĩa ũtarĩ mwĩhokeku eeriragĩria haaro.<verse eid="PRO 13:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 13:3"/>Mũndũ ũrĩa ũmenyagĩrĩra kanua gake nĩ muoyo wake amenyagĩrĩra,</para>
  <para style="q2" vid="PRO 13:3">no ũrĩa ũhiũhaga kwaria nĩakanangĩka.<verse eid="PRO 13:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 13:4"/>Ngoro ya kĩgũũta ĩĩriragĩria na ndĩone kĩndũ,</para>
  <para style="q2" vid="PRO 13:4">no merirĩria ma mũndũ ũrĩ kĩyo nĩmakahingio.<verse eid="PRO 13:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 13:5"/>Mũndũ mũthingu nĩathũire ũhoro ũtarĩ wa ma,</para>
  <para style="q2" vid="PRO 13:5">no mũndũ mwaganu ekaga maũndũ ma thoni na ma njono.<verse eid="PRO 13:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 13:6"/>Ũthingu ũgitagĩra mũndũ ũrĩa mũrũngĩrĩru,</para>
  <para style="q2" vid="PRO 13:6">no waganu nĩũngʼaũranagia mũndũ mwĩhia.<verse eid="PRO 13:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 13:7"/>Kũrĩ mũndũ wĩtuaga gĩtonga, no ndarĩ kĩndũ;</para>
  <para style="q2" vid="PRO 13:7">kũrĩ ũngĩ wĩtuaga mũthĩĩni, no arĩ na ũtonga mũnene.<verse eid="PRO 13:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 13:8"/>Ũtonga wa mũndũ wahota gũkũũra muoyo wake,</para>
  <para style="q1" vid="PRO 13:8">no mũndũ mũthĩĩni ndaiguaga akĩĩhĩtĩrwo.<verse eid="PRO 13:8"/></para>
  <para style="b"/>
  <para style="q2">
    <verse number="9" style="v" sid="PRO 13:9"/>Ũtheri wa mũndũ mũthingu waaraga ũgacangarara,</para>
  <para style="q2" vid="PRO 13:9">no tawa wa mũndũ mwaganu nĩkũhorio ũhoragio.<verse eid="PRO 13:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 13:10"/>Mwĩtĩĩo ũciaraga njũgitano,</para>
  <para style="q2" vid="PRO 13:10">no ũũgĩ wonekaga harĩ arĩa metĩkagĩra gũtaarwo.<verse eid="PRO 13:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 13:11"/>Mbeeca itarĩ cia wĩhokeku ithiiaga igĩthiraga,</para>
  <para style="q2" vid="PRO 13:11">no ũrĩa ũcookanagĩrĩria mbeeca tũnini o tũnini nĩatũmaga ciongerereke.<verse eid="PRO 13:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 13:12"/>Ũndũ mũtaanye ũngĩikario mũno nĩũrwaragia mũndũ ngoro,</para>
  <para style="q2" vid="PRO 13:12">no kĩĩrĩgĩrĩro kĩhingĩtio gĩtuĩkaga ta mũtĩ wa muoyo.<verse eid="PRO 13:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 13:13"/>Mũndũ ũrĩa ũthũire ũrutani nĩeyũnũhaga,</para>
  <para style="q2" vid="PRO 13:13">no ũrĩa ũtĩĩaga maathani nĩakaheo kĩheo.<verse eid="PRO 13:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 13:14"/>Ũrutani wa mũndũ ũrĩa mũũgĩ nĩ gĩthima kĩa muoyo,</para>
  <para style="q2" vid="PRO 13:14">ũhũndũraga mũndũ kuuma mĩtego-inĩ ya gĩkuũ.<verse eid="PRO 13:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 13:15"/>Gũtaũkĩrwo wega nĩ maũndũ gũtũmaga mũndũ endeke,</para>
  <para style="q2" vid="PRO 13:15">no njĩra ya arĩa matarĩ ehokeku ti hũthũ.<verse eid="PRO 13:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 13:16"/>Mũndũ o wothe mwĩbaarĩrĩri ekaga maũndũ make na ũmenyi,</para>
  <para style="q2" vid="PRO 13:16">no mũndũ mũkĩĩgu aguũragia ũrimũ wake.<verse eid="PRO 13:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 13:17"/>Mũtũmwo mwaganu atoonyaga thĩĩna-inĩ,</para>
  <para style="q2" vid="PRO 13:17">no mũtũmwo mwĩhokeku nĩarehaga kĩhonia.<verse eid="PRO 13:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 13:18"/>Mũndũ ũrĩa ũregaga gũtaarwo anyiitagwo nĩ thĩĩna na thoni,</para>
  <para style="q2" vid="PRO 13:18">no mũndũ ũrĩa wĩtĩkagĩra gũkaanio atuĩkaga wa gũtĩĩo.<verse eid="PRO 13:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 13:19"/>Ũndũ mwĩrirĩrie wakinyanĩra ũiguithagia ngoro wega,</para>
  <para style="q2" vid="PRO 13:19">no andũ akĩĩgu monaga kũhutatĩra ũũru ta ũndũ ũrĩ magigi.<verse eid="PRO 13:19"/></para>
  <para style="b"/>
  <para style="q2">
    <verse number="20" style="v" sid="PRO 13:20"/>Mũndũ ũrĩa ũceeraga na arĩa oogĩ akĩragĩrĩria kũũhĩga,</para>
  <para style="q2" vid="PRO 13:20">no ũrĩa ũtwaranaga na mũndũ mũkĩĩgu onaga o ũũru.<verse eid="PRO 13:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 13:21"/>Mũtino ũthingataga mũndũ ũrĩa mwĩhia,</para>
  <para style="q2" vid="PRO 13:21">no ũgaacĩru nĩ kĩheo kĩa arĩa athingu.<verse eid="PRO 13:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 13:22"/>Mũndũ mwega atigagĩra ciana cia ciana ciake igai,</para>
  <para style="q2" vid="PRO 13:22">no ũtonga wa mũndũ mwĩhia ũigagĩrwo andũ arĩa athingu.<verse eid="PRO 13:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 13:23"/>Mũgũnda wa mũndũ mũthĩĩni no ũciare irio nyingĩ,</para>
  <para style="q2" vid="PRO 13:23">no kwaga kĩhooto gũciniinaga ciothe.<verse eid="PRO 13:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 13:24"/>Mũndũ ũrĩa ũigaga rũthanju thĩ nĩ mwana wake athũire,</para>
  <para style="q2" vid="PRO 13:24">no ũrĩa wendete mwana wake nĩamũherithagia.<verse eid="PRO 13:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 13:25"/>Andũ arĩa athingu marĩĩaga makahũũna,</para>
  <para style="q2" vid="PRO 13:25">no nda ya mũndũ mwaganu ĩikaraga o ĩhũtiĩ.<verse eid="PRO 13:25"/></para>
  <para style="b"/>
  <chapter eid="PRO 13"/>
  <chapter number="14" style="c" sid="PRO 14"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 14:1"/>Mũtumia mũũgĩ nĩ gwaka akaga nyũmba yake,</para>
  <para style="q2" vid="PRO 14:1">no mũtumia mũkĩĩgu nĩgũtharia atharagia nyũmba yake na moko make mwene.<verse eid="PRO 14:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 14:2"/>Mũndũ ũrĩa ũthiiaga na mĩthiĩre mĩrũngĩrĩru nĩwe mwĩtigĩri Jehova,</para>
  <para style="q2" vid="PRO 14:2">no ũrĩa mĩthiĩre yake ĩrĩ mĩhĩtanu nĩamũmenete.<verse eid="PRO 14:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 14:3"/>Mĩario ya mũndũ mũkĩĩgu nĩ rũthanju rwa kũmũhũũra,</para>
  <para style="q2" vid="PRO 14:3">no mĩromo ya arĩa oogĩ nĩĩmagitagĩra.<verse eid="PRO 14:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 14:4"/>Kũrĩa gũtarĩ ndegwa mĩharatĩ ĩkoragwo ĩrĩ mĩtheru,</para>
  <para style="q2" vid="PRO 14:4">no maciaro maingĩ moimanaga na hinya wa ndegwa.<verse eid="PRO 14:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 14:5"/>Mũira mwĩhokeku ndaheenanagia,</para>
  <para style="q2" vid="PRO 14:5">no mũira wa maheeni aaragia o maheeni.<verse eid="PRO 14:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 14:6"/>Mũnyũrũrania acaragia ũũgĩ na ndangĩwona,</para>
  <para style="q2" vid="PRO 14:6">no kũgĩa na ũmenyo nĩ ũhũthũ kũrĩ mũndũ ũrĩa ũkũũranaga maũndũ.<verse eid="PRO 14:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 14:7"/>Ikara kũraya na mũndũ mũkĩĩgu,</para>
  <para style="q2" vid="PRO 14:7">nĩgũkorwo ndũrĩ ũmenyo ũngĩona kuuma mĩromo-inĩ yake.<verse eid="PRO 14:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 14:8"/>Ũũgĩ wa arĩa abaarĩrĩri nĩũtũmaga mamenye ũhoro wa njĩra ciao,</para>
  <para style="q2" vid="PRO 14:8">no ũrimũ wa andũ arĩa akĩĩgu nĩũmahĩtithagia.<verse eid="PRO 14:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 14:9"/>Andũ arĩa akĩĩgu manyũrũragia horohio ya mehia,</para>
  <para style="q2" vid="PRO 14:9">no ũtugi wonekaga harĩ arĩa arũngĩrĩru.<verse eid="PRO 14:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 14:10"/>Ngoro o yothe nĩyũũĩ ũrũrũ wayo,</para>
  <para style="q2" vid="PRO 14:10">o na gĩkeno-inĩ kĩayo gũtirĩ mũndũ ũngĩnyiitanĩra nayo.<verse eid="PRO 14:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 14:11"/>Nyũmba ya mũndũ mwaganu nĩĩkanangwo,</para>
  <para style="q2" vid="PRO 14:11">no hema ya mũndũ mũrũngĩrĩru nĩĩkagaacĩra.<verse eid="PRO 14:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 14:12"/>Kũrĩ njĩra mũndũ onaga ta yagĩrĩire,</para>
  <para style="q2" vid="PRO 14:12">no marigĩrĩrio mayo yerekagĩria mũndũ o gĩkuũ-inĩ.<verse eid="PRO 14:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 14:13"/>O na hĩndĩ ya gũtheka ngoro no ĩkorwo ĩgĩtuura,</para>
  <para style="q2" vid="PRO 14:13">na gĩkeno no kĩrigĩrĩrie na kĩeha.<verse eid="PRO 14:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 14:14"/>Andũ arĩa matarĩ ehokeku nĩmakarĩhwo kũna nĩ ũndũ wa mĩthiĩre yao,</para>
  <para style="q2" vid="PRO 14:14">nake mũndũ mwega aheo kĩheo kũringana na mĩthiĩre yake.<verse eid="PRO 14:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 14:15"/>Mũndũ ũtarĩ ũũgĩ etĩkagia ũndũ o wothe,</para>
  <para style="q2" vid="PRO 14:15">no mũndũ mũbaarĩrĩri nĩacũũranagia ũhoro wa makinya make.<verse eid="PRO 14:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 14:16"/>Mũndũ mũũgĩ nĩetigagĩra Jehova na akeherera ũũru,</para>
  <para style="q2" vid="PRO 14:16">no mũndũ mũkĩĩgu ekaga maũndũ na kwĩgerera atekũmenyerera ũndũ.<verse eid="PRO 14:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 14:17"/>Mũndũ ũhiũhaga kũrakara ekaga maũndũ ma ũrimũ,</para>
  <para style="q2" vid="PRO 14:17">nake mũndũ mwara nĩamenagwo.<verse eid="PRO 14:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 14:18"/>Andũ arĩa matarĩ ũũgĩ magayaga ũrimũ,</para>
  <para style="q2" vid="PRO 14:18">no arĩa abaarĩrĩri mahumbagwo thũmbĩ ya ũmenyo.<verse eid="PRO 14:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 14:19"/>Andũ arĩa ooru nĩmakainamĩrĩra harĩ arĩa ega,</para>
  <para style="q2" vid="PRO 14:19">na arĩa aaganu mainamĩrĩre ihingo-inĩ cia arĩa athingu.<verse eid="PRO 14:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 14:20"/>Andũ arĩa athĩĩni mathũũragwo o na nĩ andũ a itũũra rĩao,</para>
  <para style="q2" vid="PRO 14:20">no itonga irĩ arata aingĩ.<verse eid="PRO 14:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 14:21"/>Mũndũ ũrĩa ũmenaga mũndũ wa itũũra rĩake nĩ kwĩhia ehagia,</para>
  <para style="q2" vid="PRO 14:21">no kũrathimwo nĩ ũrĩa ũiguagĩra athĩĩni tha.<verse eid="PRO 14:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 14:22"/>Andũ arĩa mathugundaga ũũru githĩ ti njĩra mahĩtagia?</para>
  <para style="q2" vid="PRO 14:22">No arĩa mabangaga maũndũ mega monaga ũtugi na wĩhokeku.<verse eid="PRO 14:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 14:23"/>Wĩra wothe wa hinya ũrehaga uumithio,</para>
  <para style="q2" vid="PRO 14:23">no mĩario mĩtheri ĩrehaga o ũthĩĩni.<verse eid="PRO 14:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 14:24"/>Ũtonga wa andũ arĩa oogĩ nĩguo thũmbĩ yao,</para>
  <para style="q2" vid="PRO 14:24">no ũrimũ wa andũ akĩĩgu ũciaraga ũrimũ.<verse eid="PRO 14:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 14:25"/>Mũira mwĩhokeku nĩahonokagia mĩoyo,</para>
  <para style="q2" vid="PRO 14:25">no mũira wa maheeni nĩ mũheenania.<verse eid="PRO 14:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 14:26"/>Mũndũ ũrĩa wĩtigagĩra Jehova arĩ na kĩĩhitho kĩrũmu,</para>
  <para style="q2" vid="PRO 14:26">o na ciana ciake nĩho irĩũragĩra.<verse eid="PRO 14:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 14:27"/>Gwĩtigĩra Jehova nĩ gĩthima kĩa muoyo,</para>
  <para style="q2" vid="PRO 14:27">kũhũndũraga mũndũ kuuma mĩtego-inĩ ya gĩkuũ.<verse eid="PRO 14:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 14:28"/>Ũingĩ wa andũ nĩguo riiri wa mũthamaki,</para>
  <para style="q2" vid="PRO 14:28">no mũnene ũtarĩ andũ a gwatha nĩ mwanangĩku.<verse eid="PRO 14:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 14:29"/>Mũndũ mũkirĩrĩria arĩ ũmenyo mũingĩ,</para>
  <para style="q2" vid="PRO 14:29">no mũndũ ũhiũhaga kũrakara onanagia ũrimũ.<verse eid="PRO 14:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 14:30"/>Ngoro ĩrĩ na thayũ ĩheaga mwĩrĩ muoyo,</para>
  <para style="q2" vid="PRO 14:30">no ũiru ũbuthagia mahĩndĩ.<verse eid="PRO 14:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 14:31"/>Mũndũ ũrĩa ũhinyagĩrĩria athĩĩni nĩkũnyarara anyararaga Ũrĩa wamombire,</para>
  <para style="q2" vid="PRO 14:31">no ũrĩa wothe ũiguagĩra athĩĩni tha, nĩ Ngai atĩĩaga.<verse eid="PRO 14:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 14:32"/>Rĩrĩa mũtino woka, arĩa aaganu matungumanagio thĩ,</para>
  <para style="q2" vid="PRO 14:32">no arĩa athingu, o na gĩkuũ-inĩ makoragwo marĩ na rĩũrĩro.<verse eid="PRO 14:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 14:33"/>Ũũgĩ nĩ ũikaraga ngoro-inĩ ya ũrĩa ũũĩ gũkũũrana maũndũ,</para>
  <para style="q2" vid="PRO 14:33">o na gatagatĩ ka irimũ nĩwĩmenyithanagia.<verse eid="PRO 14:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 14:34"/>Ũthingu nĩgũtũũgĩria ũtũũgagĩria rũrĩrĩ,</para>
  <para style="q2" vid="PRO 14:34">no mehia nĩ gĩconoko harĩ andũ o othe.<verse eid="PRO 14:34"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 14:35"/>Mũthamaki nĩakenagio nĩ ndungata njũgĩ,</para>
  <para style="q2" vid="PRO 14:35">no nĩangʼũrĩkagio nĩ ndungata ĩrĩa ĩmũconorithagia.<verse eid="PRO 14:35"/></para>
  <para style="b"/>
  <chapter eid="PRO 14"/>
  <chapter number="15" style="c" sid="PRO 15"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 15:1"/>Icookio rĩa ũhooreri nĩrĩeheragia mangʼũrĩ,</para>
  <para style="q2" vid="PRO 15:1">no kiugo kĩa ũũru kĩarahũraga marakara.<verse eid="PRO 15:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 15:2"/>Rũrĩmĩ rwa mũndũ ũrĩa mũũgĩ rũgaathagĩrĩria ũmenyo,</para>
  <para style="q2" vid="PRO 15:2">no kanua ka mũndũ mũkĩĩgu gathothokaga ũrimũ.<verse eid="PRO 15:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 15:3"/>Maitho ma Jehova marĩ kũndũ guothe,</para>
  <para style="q2" vid="PRO 15:3">magacũthagĩrĩria andũ arĩa aaganu o na arĩa eega.<verse eid="PRO 15:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 15:4"/>Rũrĩmĩ rũrĩa rũrehaga kĩhonia nĩ ta mũtĩ wa muoyo,</para>
  <para style="q2" vid="PRO 15:4">no rũrĩmĩ rwa maheeni rũthuthaga ngoro.<verse eid="PRO 15:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 15:5"/>Mũndũ mũkĩĩgu aregaga ũtaaro wa ithe,</para>
  <para style="q2" vid="PRO 15:5">no mũndũ ũrĩa wĩtĩkagĩra kũrũngwo onanagia ũbaarĩrĩri.<verse eid="PRO 15:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 15:6"/>Nyũmba ya mũndũ mũthingu ĩkoragwo na kĩgĩĩna kĩnene,</para>
  <para style="q2" vid="PRO 15:6">no uumithio wa andũ aaganu ũmarehagĩra thĩĩna.<verse eid="PRO 15:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 15:7"/>Mĩromo ya andũ arĩa oogĩ ĩtambagia o ũũgĩ,</para>
  <para style="q2" vid="PRO 15:7">no tiguo ngoro cia andũ arĩa akĩĩgu ciĩkaga.<verse eid="PRO 15:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 15:8"/>Igongona rĩa andũ arĩa aaganu nĩ kĩndũ kĩrĩ magigi harĩ Jehova,</para>
  <para style="q2" vid="PRO 15:8">no mahooya ma mũndũ ũrĩa mũrũngĩrĩru nĩamakenagĩrĩra.<verse eid="PRO 15:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 15:9"/>Njĩra cia andũ arĩa aaganu nĩ kĩndũ kĩrĩ magigi harĩ Jehova,</para>
  <para style="q2" vid="PRO 15:9">no nĩendete andũ arĩa mathingataga ũthingu.<verse eid="PRO 15:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 15:10"/>Iherithia rĩtarĩ rĩa tha rĩetereire mũndũ ũrĩa ũtigĩte njĩra,</para>
  <para style="q2" vid="PRO 15:10">na mũndũ ũrĩa ũthũire kũrũngwo nĩagaakua.<verse eid="PRO 15:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 15:11"/>Gĩkuũ na Mwanangĩko ciikaraga ciĩyanĩkĩte mbere ya Jehova,</para>
  <para style="q2" vid="PRO 15:11">ĩ nacio ngoro cia andũ-rĩ, ikĩĩanĩkĩte atĩa!<verse eid="PRO 15:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 15:12"/>Mũnyũrũrania nĩathũire kũrũngwo;</para>
  <para style="q2" vid="PRO 15:12">ndangĩhooya kĩrĩra kũrĩ ũrĩa mũũgĩ.<verse eid="PRO 15:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 15:13"/>Ngoro ngenu ĩtũmaga gĩthiithi gĩthere,</para>
  <para style="q2" vid="PRO 15:13">no ruo rwa ngoro rũthuthaga roho.<verse eid="PRO 15:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 15:14"/>Ngoro ĩrĩ na gũkũũrana maũndũ nĩĩmaathaga ũmenyo,</para>
  <para style="q2" vid="PRO 15:14">no kanua ka mũndũ mũkĩĩgu kehũũnagia na ũrimũ.<verse eid="PRO 15:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 15:15"/>Matukũ mothe ma andũ arĩa ahatĩrĩrie nĩ ma thĩĩna,</para>
  <para style="q2" vid="PRO 15:15">no ngoro ĩrĩa njanjamũku ĩkoragwo na ndĩa hĩndĩ ciothe.<verse eid="PRO 15:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 15:16"/>Nĩ kaba kĩndũ kĩnini hamwe na gwĩtigĩra Jehova,</para>
  <para style="q2" vid="PRO 15:16">gũkĩra ũtonga mũnene ũrĩ na kĩnyariirĩko.<verse eid="PRO 15:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 15:17"/>Nĩ kaba kũrĩa rwĩga rwa nyeni harĩa harĩ wendo,</para>
  <para style="q2" vid="PRO 15:17">gũkĩra kũrĩa njaũ noru harĩa harĩ na rũthũũro.<verse eid="PRO 15:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 15:18"/>Mũndũ ũhiũhaga kũrakara aarahũraga ngarari,</para>
  <para style="q2" vid="PRO 15:18">no mũndũ mũkirĩrĩria nĩkũhooreria ahooragĩria haaro.<verse eid="PRO 15:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 15:19"/>Njĩra ya kĩgũũta nĩkũhingwo ĩhingĩtwo na mĩigua,</para>
  <para style="q2" vid="PRO 15:19">no njĩra ya mũndũ mũrũngĩrĩru nĩ njĩra njariĩ.<verse eid="PRO 15:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 15:20"/>Mwana mũũgĩ atũmaga ithe akene,</para>
  <para style="q2" vid="PRO 15:20">no mũndũ mũkĩĩgu nĩ nyina anyararaga.<verse eid="PRO 15:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 15:21"/>Ũrimũ ũkenagia mũndũ ũrĩa ũtooĩ gũkũũrana maũndũ,</para>
  <para style="q2" vid="PRO 15:21">no mũndũ ũrĩa mũkuũku nĩarũngagĩrĩria mĩthiĩre yake.<verse eid="PRO 15:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 15:22"/>Mĩbango nĩĩthaataga nĩ kwaga kĩrĩra,</para>
  <para style="q2" vid="PRO 15:22">no kũrĩ na ataarani aingĩ mĩbango nĩĩgaacagĩra.<verse eid="PRO 15:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 15:23"/>Mũndũ nĩaiguaga gĩkeno agĩcookia ũhoro ũrĩa wagĩrĩire,</para>
  <para style="q2" vid="PRO 15:23">nakĩo kiugo kĩarĩtio ihinda rĩrĩa rĩagĩrĩire, kaĩ nĩ kĩega-ĩ!<verse eid="PRO 15:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 15:24"/>Harĩ mũndũ ũrĩa mũũgĩ njĩra ya muoyo ĩrorete na igũrũ,</para>
  <para style="q2" vid="PRO 15:24">ĩmũgirie gũikũrũka mbĩrĩra-inĩ.<verse eid="PRO 15:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 15:25"/>Jehova nĩamomoraga nyũmba ya mũndũ ũrĩa mwĩtĩĩi,</para>
  <para style="q2" vid="PRO 15:25">no nĩamenyagĩrĩra mĩhaka ya mũtumia wa ndigwa.<verse eid="PRO 15:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 15:26"/>Meciiria ma mũndũ mwaganu nĩ kĩndũ kĩrĩ magigi harĩ Jehova,</para>
  <para style="q2" vid="PRO 15:26">no meciiria ma andũ arĩa atheru nĩmamũkenagia.<verse eid="PRO 15:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 15:27"/>Mũndũ mũkoroku arehagĩra nyũmba yake thĩĩna,</para>
  <para style="q2" vid="PRO 15:27">no ũrĩa ũthũire mahaki nĩagatũũra muoyo.<verse eid="PRO 15:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 15:28"/>Ngoro ya mũndũ mũthingu nĩĩthimaga macookio mayo,</para>
  <para style="q2" vid="PRO 15:28">no kanua ka mũndũ mwaganu gathothokaga ũũru.<verse eid="PRO 15:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 15:29"/>Jehova aikaraga haraaya na andũ arĩa aaganu,</para>
  <para style="q2" vid="PRO 15:29">no nĩaiguaga mahooya ma andũ arĩa athingu.<verse eid="PRO 15:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 15:30"/>Gũtheria gĩthiithi nĩkũrehagĩra ngoro gĩkeno,</para>
  <para style="q2" vid="PRO 15:30">naguo ũhoro ũrĩa mwega nĩwĩkĩraga mahĩndĩ hinya.<verse eid="PRO 15:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 15:31"/>Mũndũ ũrĩa ũthikagĩrĩria ikaanania rĩrĩa rĩrehaga muoyo</para>
  <para style="q2" vid="PRO 15:31">nĩagatũũrania na andũ arĩa oogĩ.<verse eid="PRO 15:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 15:32"/>Mũndũ ũrĩa ũregaga kũigua agĩkaanio nĩ kwĩnyarara enyararaga we mwene,</para>
  <para style="q2" vid="PRO 15:32">no mũndũ ũrĩa wothe wĩtĩkagĩra kũrũngwo agĩĩaga na ũtaũku.<verse eid="PRO 15:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 15:33"/>Gwĩtigĩra Jehova nĩkuo kũheaga mũndũ ũũgĩ,</para>
  <para style="q2" vid="PRO 15:33">nakuo kwĩnyiihia gũtongoragia gĩtĩĩo.<verse eid="PRO 15:33"/></para>
  <para style="b"/>
  <chapter eid="PRO 15"/>
  <chapter number="16" style="c" sid="PRO 16"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 16:1"/>Mĩbango ya ngoro nĩ ya mũndũ,</para>
  <para style="q2" vid="PRO 16:1">no icookio rĩa rũrĩmĩ riumaga harĩ Jehova.<verse eid="PRO 16:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 16:2"/>Mũndũ onaga mĩthiĩre yake yothe ĩrĩ mĩega,</para>
  <para style="q2" vid="PRO 16:2">no Jehova nĩwe ũthimaga matanya.<verse eid="PRO 16:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 16:3"/>Rekagĩrĩria Jehova maũndũ mothe marĩa ũrĩĩkaga,</para>
  <para style="q2" vid="PRO 16:3">nayo mĩbango yaku nĩĩrĩgaacagĩra.<verse eid="PRO 16:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 16:4"/>Jehova ombire indo ciothe irĩ na gĩtũmi gĩacio,</para>
  <para style="q2" vid="PRO 16:4">ĩĩ-ni, o na arĩa aaganu aamoombire nĩ ũndũ wa mũthenya wa thĩĩna.<verse eid="PRO 16:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 16:5"/>Mũndũ wothe wa ngoro ya mwĩtĩĩo nĩ kĩndũ kĩrĩ magigi harĩ Jehova.</para>
  <para style="q2" vid="PRO 16:5">Menyai na ma atĩrĩ, ndakaaga kũherithio.<verse eid="PRO 16:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 16:6"/>Mehia nĩmahorohagĩrio nĩ wendo na wĩhokeku,</para>
  <para style="q2" vid="PRO 16:6">na nĩ ũndũ wa gwĩtigĩra Jehova-rĩ, mũndũ nĩeheragĩra ũũru.<verse eid="PRO 16:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 16:7"/>Rĩrĩa mĩthiĩre ya mũndũ yakenia Jehova-rĩ,</para>
  <para style="q2" vid="PRO 16:7">atũmaga o na thũ ciake itũũranie nake na thayũ.<verse eid="PRO 16:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 16:8"/>Kaba indo nini cionekete na njĩra ya ũthingu,</para>
  <para style="q2" vid="PRO 16:8">gũkĩra uumithio mũnene ũtarĩ wa kĩhooto.<verse eid="PRO 16:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 16:9"/>Mũndũ nĩabangaga na ngoro mũthiĩre wake,</para>
  <para style="q2" vid="PRO 16:9">no Jehova nĩwe ũroragia makinya make kũrĩa ekũgerera.<verse eid="PRO 16:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 16:10"/>Mĩromo ya mũthamaki yaragia ũhoro taarĩ ndũmĩrĩri,</para>
  <para style="q2" vid="PRO 16:10">na kanua gake gatiagĩrĩirwo kuogomia kĩhooto.<verse eid="PRO 16:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 16:11"/>Igeri na ratiri cia ma nĩ cia Jehova;</para>
  <para style="q2" vid="PRO 16:11">mahiga mothe ma gũthima marĩa marĩ mũhuko-rĩ, o namo no wĩra wake.<verse eid="PRO 16:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 16:12"/>Kũrĩ athamaki-rĩ, gwĩka ũũru nĩ ũndũ ũrĩ magigi,</para>
  <para style="q2" vid="PRO 16:12">nĩgũkorwo gĩtĩ kĩa ũnene kĩĩhaandaga nĩ ũndũ wa ũthingu.<verse eid="PRO 16:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 16:13"/>Athamaki nĩmakenagĩra mĩromo ĩrĩa yaragia ma;</para>
  <para style="q2" vid="PRO 16:13">nĩ marĩ bata na mũndũ waragia ũhoro wa ma.<verse eid="PRO 16:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 16:14"/>Mangʼũrĩ ma mũthamaki nĩ ta mũtũmwo wa gĩkuũ,</para>
  <para style="q2" vid="PRO 16:14">no mũndũ mũũgĩ nĩakamahooreria.<verse eid="PRO 16:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 16:15"/>Gũthererwo gĩthiithi nĩ mũthamaki nĩ muoyo;</para>
  <para style="q2" vid="PRO 16:15">ũtugi wake ũtariĩ ta itu rĩa mbura ĩrĩa ĩkũragia irio.<note caller="+" style="f"><char style="fr" closed="false">16:15 </char><char style="ft" closed="false">Mbura ĩno ya gũkũria irio nĩĩrehaga kũgaacĩra na gĩkeno.</char></note><verse eid="PRO 16:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 16:16"/>Hĩ! Kaĩ kũgĩa ũũgĩ nĩ kwega gũkĩra thahabu-ĩ,</para>
  <para style="q2" vid="PRO 16:16">gũthuura ũtaũku gũgakĩra kũgĩa na betha!<verse eid="PRO 16:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 16:17"/>Njĩra njariĩ ya arĩa arũngĩrĩru yeheragĩra ũũru;</para>
  <para style="q2" vid="PRO 16:17">mũndũ ũrĩa ũmenyagĩrĩra mĩthiĩre yake nĩ muoyo wake mwene agitagĩra.<verse eid="PRO 16:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 16:18"/>Mwĩtĩĩo ũrũmagĩrĩrwo nĩ mwanangĩko,</para>
  <para style="q2" vid="PRO 16:18">roho wa mwĩtũũgĩrio ũkarũmĩrĩrwo nĩ kũgũa.<verse eid="PRO 16:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 16:19"/>Nĩ kaba roho wa kwĩnyiihia na gũkorwo hamwe na arĩa ahinyĩrĩrie,</para>
  <para style="q2" vid="PRO 16:19">gũkĩra kũgayana indo cia ndaho na arĩa etĩĩi.<verse eid="PRO 16:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 16:20"/>Mũndũ ũrĩa ũrũmbũyagia mataaro nĩagaacagĩra,</para>
  <para style="q2" vid="PRO 16:20">na kũrathimwo nĩ mũndũ ũrĩa wĩhokaga Jehova.<verse eid="PRO 16:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 16:21"/>Arĩa oogĩ ngoro-inĩ metagwo akũũrani maũndũ,</para>
  <para style="q2" vid="PRO 16:21">na ciugo njega itũũgagĩria ũtaaro.<verse eid="PRO 16:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 16:22"/>Ũtaũku nĩ gĩthima kĩa muoyo kũrĩ arĩa marĩ naguo,</para>
  <para style="q2" vid="PRO 16:22">no ũrimũ ũrehaga iherithia kũrĩ andũ arĩa akĩĩgu.<verse eid="PRO 16:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 16:23"/>Ngoro ya mũndũ mũũgĩ nĩyo ĩtongoragia kanua gake,</para>
  <para style="q2" vid="PRO 16:23">nayo mĩromo yake ĩtũũgagĩria ũtaaro.<verse eid="PRO 16:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 16:24"/>Ndeto njega nĩ igua rĩa ũũkĩ,</para>
  <para style="q2" vid="PRO 16:24">irĩ mũrĩo ngoro-inĩ, na harĩ mahĩndĩ nĩ ũgima.<verse eid="PRO 16:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 16:25"/>Kũrĩ njĩra mũndũ onaga ta yagĩrĩire,</para>
  <para style="q2" vid="PRO 16:25">no marigĩrĩrio mayo yerekagĩra gĩkuũ-inĩ.<verse eid="PRO 16:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 16:26"/>Kũhũũta kwa mũruti wa wĩra nĩkuo kũmũteithagia,</para>
  <para style="q2" vid="PRO 16:26">ngʼaragu yake nĩyo ĩmũtindĩkaga.<verse eid="PRO 16:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 16:27"/>Kĩmaramari gĩthugundaga ũũru,</para>
  <para style="q2" vid="PRO 16:27">na mĩario yakĩo nĩ ta mwaki wa gũcina.<verse eid="PRO 16:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 16:28"/>Mũndũ mwaganu arehaga ngarari,</para>
  <para style="q2" vid="PRO 16:28">na mũhuhu ũtigithanagia andũ marĩ ũrata mũnene.<verse eid="PRO 16:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 16:29"/>Mũndũ wa haaro aheenagĩrĩria mũndũ wa itũũra rĩake,</para>
  <para style="q2" vid="PRO 16:29">akamũtongoria njĩra-inĩ ĩtarĩ njega.<verse eid="PRO 16:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 16:30"/>Mũndũ ũrĩa uunagĩra andũ riitho akoragwo agĩthugunda waganu,</para>
  <para style="q2" vid="PRO 16:30">ũrĩa ũtembanagia mĩromo akoragwo agĩthugunda ũũru.<verse eid="PRO 16:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 16:31"/>Mbuĩ nĩ thũmbĩ ya riiri;</para>
  <para style="q2" vid="PRO 16:31">cionekaga nĩ ũndũ wa mũtũũrĩre wa ũthingu.<verse eid="PRO 16:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 16:32"/>Nĩ kaba mũndũ mũkirĩrĩria gũkĩra njamba ya ita,</para>
  <para style="q2" vid="PRO 16:32">na nĩ kaba mũndũ ũrĩa ũrigagĩrĩria marakara make gũkĩra ũrĩa wĩnyiitagĩra itũũra inene.<verse eid="PRO 16:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 16:33"/>Mĩtĩ ĩcuukagĩrwo maru-inĩ,</para>
  <para style="q2" vid="PRO 16:33">no itua o rĩothe riumaga kũrĩ Jehova.<verse eid="PRO 16:33"/></para>
  <para style="b"/>
  <chapter eid="PRO 16"/>
  <chapter number="17" style="c" sid="PRO 17"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 17:1"/>Nĩ kaba kĩenyũ kĩũmũ kĩa mũgate kũndũ kũrĩ na thayũ na ũhooreri,</para>
  <para style="q2" vid="PRO 17:1">gũkĩra nyũmba ĩiyũrĩte ndĩa no ĩrĩ na ngũĩ.<verse eid="PRO 17:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 17:2"/>Ndungata ĩrĩ na ũũgĩ ĩgaatuĩka ya gwatha mũriũ wa mwene yo ũrĩa ũrehaga njono,</para>
  <para style="q2" vid="PRO 17:2">na nĩĩkegwatĩra igai ĩrĩ ta ũmwe wa ariũ a mwathi wayo.<verse eid="PRO 17:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 17:3"/>Nyũngũ nĩ ya gũthererio betha, na kĩrugutĩro nĩ gĩa gũthererio thahabu,</para>
  <para style="q2" vid="PRO 17:3">no Jehova nĩwe ũgeragia ngoro cia andũ.<verse eid="PRO 17:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 17:4"/>Mũndũ mwaganu athikagĩrĩria mĩromo ĩrĩa yaragia waganu;</para>
  <para style="q2" vid="PRO 17:4">nake mũndũ wa maheeni athikagĩrĩria rũrĩmĩ rũrĩa rwaragia maũndũ ma gũthũkia.<verse eid="PRO 17:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 17:5"/>Mũndũ ũrĩa ũthekagĩrĩra athĩĩni nĩkũmena amenaga Ũrĩa wamombire;</para>
  <para style="q2" vid="PRO 17:5">mũndũ ũrĩa ũkenagĩra mũtino ndakaaga kũherithio.<verse eid="PRO 17:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 17:6"/>Ciana cia ciana nĩ thũmbĩ harĩ andũ arĩa akũrũ,</para>
  <para style="q2" vid="PRO 17:6">nao aciari nĩo riiri wa ciana ciao.<verse eid="PRO 17:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 17:7"/>Mĩario ya bata ndĩagĩrĩire kanua ka mũndũ mũkĩĩgu,</para>
  <para style="q2" vid="PRO 17:7">na makĩria mĩario ya maheeni ndĩagĩrĩire mũndũ ũrĩa wathanaga!<verse eid="PRO 17:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 17:8"/>Ihaki rĩhaana ta ihiga rĩa kũrehe mũnyaka kũrĩ ũrĩa ũhakanaga;</para>
  <para style="q2" vid="PRO 17:8">kũrĩa guothe athiiaga nĩagaacagĩra.<verse eid="PRO 17:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 17:9"/>Mũndũ ũrĩa ũhumbagĩra ihĩtia nĩ wendo acaragia,</para>
  <para style="q2" vid="PRO 17:9">no ũrĩa ũcookagĩra ũhoro atigithanagia andũ marĩ ũrata mũnene.<verse eid="PRO 17:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 17:10"/>Kũrũithio nĩgũkenagia mũndũ ũrĩa ũkũũranaga maũndũ</para>
  <para style="q2" vid="PRO 17:10">gũkĩra iboko igana harĩ mũndũ mũkĩĩgu.<verse eid="PRO 17:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 17:11"/>Mũndũ mũũru arongooragia o ũremi;</para>
  <para style="q2" vid="PRO 17:11">nĩ ũndũ ũcio nĩagatũmĩrwo mũnene ũtarĩ tha amũũkĩrĩre.<verse eid="PRO 17:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 17:12"/>Nĩ kaba gũcemania na nduba ĩtunyĩtwo ciana ciayo</para>
  <para style="q2" vid="PRO 17:12">gũkĩra gũcemania na mũndũ mũkĩĩgu na ũrimũ wake.<verse eid="PRO 17:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 17:13"/>Mũndũ angĩrĩha wega na ũũru,</para>
  <para style="q2" vid="PRO 17:13">ũũru ndũkeehera nyũmba-inĩ yake.<verse eid="PRO 17:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 17:14"/>Kwambĩrĩria haaro nĩ ta kũhingũrĩra maaĩ mahingĩrĩrie;</para>
  <para style="q2" vid="PRO 17:14">nĩ ũndũ ũcio tiganaga na ũhoro ũcio ngarari itaanagĩa.<verse eid="PRO 17:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 17:15"/>Gũtuĩra mũndũ mwaganu atĩ ndehĩtie na gũtuĩra ũrĩa ũtehĩtie atĩ nĩ mwĩhia,</para>
  <para style="q2" vid="PRO 17:15">maũndũ macio meerĩ nĩ marĩ magigi harĩ Jehova.<verse eid="PRO 17:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 17:16"/>Mbeeca nĩ cia bata ũrĩkũ irĩ guoko-inĩ kwa mũndũ mũkĩĩgu,</para>
  <para style="q2" vid="PRO 17:16">na ndangĩhota kũgũra ũũgĩ, na ndarĩ ngoro ya kwenda gũtaũkĩrwo?<verse eid="PRO 17:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 17:17"/>Mũrata wa mũndũ amwendaga hĩndĩ ciothe,</para>
  <para style="q2" vid="PRO 17:17">nake mũrũ wa nyina na mũndũ aciaragwo nĩ ũndũ wa hĩndĩ ya thĩĩna.<verse eid="PRO 17:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 17:18"/>Mũndũ ũtooĩ gũkũũrana maũndũ atuĩkaga wa kũrĩha thiirĩ wa mũndũ ũngĩ</para>
  <para style="q2" vid="PRO 17:18">o na akaiga kĩndũ gĩa kũrũgamĩrĩra thiirĩ wa mũndũ wa itũũra rĩake.<verse eid="PRO 17:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 17:19"/>Mũndũ ũrĩa wendete haaro nĩ mehia endete;</para>
  <para style="q2" vid="PRO 17:19">na mũndũ ũrĩa wakaga kĩhingo kĩraihu na igũrũ eĩtagĩria wanangĩki.<verse eid="PRO 17:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 17:20"/>Mũndũ ũrĩ ngoro ya ũremi ndagaacagĩra;</para>
  <para style="q2" vid="PRO 17:20">nake mũndũ ũrĩa ũrĩ rũrĩmĩ rwa kũheenania agũũaga thĩĩna-inĩ.<verse eid="PRO 17:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 17:21"/>Kũgĩa na mũriũ mũkĩĩgu kũrehaga ihooru;</para>
  <para style="q2" vid="PRO 17:21">ithe wa mũndũ mũkĩĩgu ndarĩ hĩndĩ akenaga.<verse eid="PRO 17:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 17:22"/>Ngoro ngenu nĩ ndawa njega,</para>
  <para style="q2" vid="PRO 17:22">no roho mũthuthĩku ũngʼaragia mahĩndĩ.<verse eid="PRO 17:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 17:23"/>Mũndũ mwaganu amũkagĩra ihaki na hitho,</para>
  <para style="q2" vid="PRO 17:23">nĩguo ogomie ciira wa kĩhooto.<verse eid="PRO 17:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 17:24"/>Mũndũ ũkũũranaga maũndũ aikaraga arorete o ũũgĩ,</para>
  <para style="q2" vid="PRO 17:24">no maitho ma mũndũ mũkĩĩgu morũũraga nginya ituri cia thĩ.<verse eid="PRO 17:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 17:25"/>Mwana mũkĩĩgu arehagĩra ithe kĩeha,</para>
  <para style="q2" vid="PRO 17:25">na marũrũ kũrĩ nyina ũrĩa wamũciarire.<verse eid="PRO 17:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 17:26"/>Ti wega kũherithia mũndũ ũtekĩte mahĩtia,</para>
  <para style="q2" vid="PRO 17:26">kana kũhũũra anene nĩ ũndũ wa ũrũngĩrĩru wao.<verse eid="PRO 17:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 17:27"/>Mũndũ ũrĩ na ũmenyo aragia ciugo athimĩte,</para>
  <para style="q2" vid="PRO 17:27">nake mũndũ ũrĩ na ũtaũku aikaraga ahooreire.<verse eid="PRO 17:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 17:28"/>O na mũndũ mũkĩĩgu angĩkira nĩonagwo arĩ mũũgĩ,</para>
  <para style="q2" vid="PRO 17:28">na akoneka arĩ mũtaũku angĩtumia kanua.<verse eid="PRO 17:28"/></para>
  <para style="b"/>
  <chapter eid="PRO 17"/>
  <chapter number="18" style="c" sid="PRO 18"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 18:1"/>Mũndũ ũrĩa ũtendaga gũtũũrania na andũ arũmagĩrĩra o merirĩria make;</para>
  <para style="q2" vid="PRO 18:1">ningĩ areganaga na matua mothe ma ũũgĩ ũrĩa mũkinyanĩru.<verse eid="PRO 18:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 18:2"/>Mũndũ mũkĩĩgu ndakenagĩra ũtaũku,</para>
  <para style="q2" vid="PRO 18:2">no akenagĩra kwaria woni wake mwene.<verse eid="PRO 18:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 18:3"/>Rĩrĩa waganu woka, ũrehaga ũirano,</para>
  <para style="q2" vid="PRO 18:3">nacio njono irehaga thoni.<verse eid="PRO 18:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 18:4"/>Ciugo cia kanua ka mũndũ nĩ ta ndia ndiku,</para>
  <para style="q2" vid="PRO 18:4">no gĩthima kĩa ũũgĩ nĩ karũũĩ gatherũkaga.<verse eid="PRO 18:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 18:5"/>Ti wega gũtĩĩra andũ arĩa aaganu maũthĩ,</para>
  <para style="q2" vid="PRO 18:5">kana kuogomia kĩhooto kĩa arĩa matehĩtie.<verse eid="PRO 18:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 18:6"/>Mĩromo ya mũndũ mũkĩĩgu ĩmũrehagĩra ngũĩ,</para>
  <para style="q2" vid="PRO 18:6">nako kanua gake geetagia rũthanju.<verse eid="PRO 18:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 18:7"/>Kanua ka mũndũ mũkĩĩgu nĩko kamũthũkagĩria maũndũ,</para>
  <para style="q2" vid="PRO 18:7">nayo mĩromo yake nĩ mũtego wa ngoro yake.<verse eid="PRO 18:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 18:8"/>Ndeto cia mũndũ wa mũhuhu nĩ ta twenyũ twega twa irio;</para>
  <para style="q2" vid="PRO 18:8">tũmerũkaga nginya tũturi-inĩ twa nda tũrĩa tũrĩ thĩinĩ mũno.<verse eid="PRO 18:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 18:9"/>Mũndũ kĩgũũta wĩra-inĩ wake</para>
  <para style="q2" vid="PRO 18:9">nĩ wa nyina na ũrĩa wanangaga.<verse eid="PRO 18:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 18:10"/>Rĩĩtwa rĩa Jehova nĩ mũthiringo ũrĩ hinya;</para>
  <para style="q2" vid="PRO 18:10">arĩa athingu moragĩra ho, nao magaikara marĩ agitĩre.<verse eid="PRO 18:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 18:11"/>Ũtonga wa andũ arĩa atongu nĩguo itũũra rĩao rĩa hinya;</para>
  <para style="q2" vid="PRO 18:11">meciiragia nĩ rũthingo rũtangĩhaicĩka.<verse eid="PRO 18:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 18:12"/>Mbere ya mwanangĩko, ngoro ya mũndũ ĩkoragwo na mwĩtĩĩo,</para>
  <para style="q2" vid="PRO 18:12">no kwĩnyiihia nĩkuo gũtongoragia gĩtĩĩo.<verse eid="PRO 18:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 18:13"/>Mũndũ ũrĩa ũcookagia ũhoro mbere ya kũũthikĩrĩria,</para>
  <para style="q2" vid="PRO 18:13">ũndũ ũcio nĩ ũrimũ na thoni ciake.<verse eid="PRO 18:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 18:14"/>Roho wa mũndũ nĩguo ũmũũmagĩrĩria rĩrĩa arĩ mũrũaru,</para>
  <para style="q2" vid="PRO 18:14">no roho mũthuthĩku nũũ ũngĩhota kũwĩtiiria?<verse eid="PRO 18:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 18:15"/>Ngoro ya mũndũ mũkũũrani maũndũ nĩĩgĩagĩra ũmenyo;</para>
  <para style="q2" vid="PRO 18:15">matũ ma arĩa oogĩ nĩmaũcaragĩrĩria.<verse eid="PRO 18:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 18:16"/>Kĩheo mũndũ aheanĩte kĩmuonagia njĩra ya kũhĩtũkĩra,</para>
  <para style="q2" vid="PRO 18:16">gĩkamũkinyia harĩ andũ arĩa anene.<verse eid="PRO 18:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 18:17"/>Mũndũ ũrĩa ũrehaga ciira wake mbere onekaga taarĩ we na ma,</para>
  <para style="q2" vid="PRO 18:17">o nginya rĩrĩa mũndũ ũrĩa maraciira nake ooka kũmũũria ciũria.<verse eid="PRO 18:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 18:18"/>Ũcuuki wa mĩtĩ nĩũniinaga ngarari,</para>
  <para style="q2" vid="PRO 18:18">na ũgateithũrana andũ eerĩ njamba.<verse eid="PRO 18:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 18:19"/>Mũndũ mũrakarie nĩ mũrũ wa nyina nĩ hinya kwĩiguithania nake gũkĩra kwĩgwatĩra itũũra inene rĩirigĩre,</para>
  <para style="q2" vid="PRO 18:19">nacio ngarari nĩ ta mĩgĩĩko ĩrĩa ĩhingaga njeera.<verse eid="PRO 18:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 18:20"/>Nda ya mũndũ nĩĩhũũnagio nĩ maciaro ma kanua gake;</para>
  <para style="q2" vid="PRO 18:20">nĩaiganagwo nĩ magetha ma mĩromo yake.<verse eid="PRO 18:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 18:21"/>Rũrĩmĩ rũrĩ na hinya wa gwathĩrĩra mũndũ muoyo kana gĩkuũ,</para>
  <para style="q2" vid="PRO 18:21">no arĩa marwendete no marĩĩage maciaro maaruo.<verse eid="PRO 18:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 18:22"/>Mũndũ ũrĩa wĩgĩĩagĩra na mũtumia nĩegĩagĩra na kĩndũ kĩega,</para>
  <para style="q2" vid="PRO 18:22">na nĩgũtugwo atugĩtwo nĩ Jehova.<verse eid="PRO 18:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 18:23"/>Mũndũ mũthĩĩni athaithanaga aiguĩrwo tha,</para>
  <para style="q2" vid="PRO 18:23">no gĩtonga gĩcookagia ũhoro na ũũru.<verse eid="PRO 18:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 18:24"/>Mũndũ mũceeri na andũ aingĩ aahota kwĩyũnũhithia,</para>
  <para style="q2" vid="PRO 18:24">no nĩ kũrĩ mũrata ũnyiitanaga na mũndũ gũkĩra mũrũ wa nyina na mũndũ.<verse eid="PRO 18:24"/></para>
  <para style="b"/>
  <chapter eid="PRO 18"/>
  <chapter number="19" style="c" sid="PRO 19"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 19:1"/>Nĩ kaba mũndũ mũthĩĩni ũrĩa ũthiiaga na mĩthiĩre ĩtarĩ ũcuuke,</para>
  <para style="q2" vid="PRO 19:1">gũkĩra mũndũ mũkĩĩgu waragia waganu.<verse eid="PRO 19:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 19:2"/>Ti wega kũgĩa na kĩyo hatarĩ na ũmenyo,</para>
  <para style="q2" vid="PRO 19:2">ningĩ kũhĩkĩka mũno gũtũmaga mũndũ ahĩtie njĩra.<verse eid="PRO 19:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 19:3"/>Ũrimũ wa mũndũ nĩguo wanangaga muoyo wake,</para>
  <para style="q2" vid="PRO 19:3">nayo ngoro yake ĩtetagia Jehova.<verse eid="PRO 19:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 19:4"/>Ũtonga nĩwongagĩrĩra mũndũ arata aingĩ,</para>
  <para style="q2" vid="PRO 19:4">no mũndũ mũthĩĩni nĩeheragĩrwo nĩ mũratawe.<verse eid="PRO 19:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 19:5"/>Mũira wa maheeni ndakaaga kũherithio,</para>
  <para style="q2" vid="PRO 19:5">na ũrĩa ũitũrũraga maheeni ndageethara.<verse eid="PRO 19:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 19:6"/>Andũ aingĩ macaragia ũrĩa mangĩendwo nĩ mũnene,</para>
  <para style="q2" vid="PRO 19:6">na mũndũ mũheani iheo-rĩ, nĩ mũrata wa andũ othe.<verse eid="PRO 19:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 19:7"/>Angĩkorwo mũndũ mũthĩĩni nĩatiganagio nĩ andũ ao othe-rĩ,</para>
  <para style="q2" vid="PRO 19:7">ĩ nao arata ake mangĩkĩmwĩtheema atĩa!</para>
  <para style="q1" vid="PRO 19:7">O na angĩmathingata akĩmathaithaga,</para>
  <para style="q2" vid="PRO 19:7">nĩmethiĩrĩire, matirĩ ho.<verse eid="PRO 19:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 19:8"/>Mũndũ ũrĩa wĩgĩĩagĩra na ũũgĩ nĩ ngoro yake mwene endete;</para>
  <para style="q2" vid="PRO 19:8">ũrĩa ũkenagĩra ũtaũku nĩagaacagĩra.<verse eid="PRO 19:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 19:9"/>Mũira wa maheeni ndakaaga kũherithio,</para>
  <para style="q2" vid="PRO 19:9">na ũrĩa ũitũrũraga maheeni nĩakoorwo nĩ muoyo.<verse eid="PRO 19:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 19:10"/>Gũtiagĩrĩire mũndũ mũkĩĩgu gũikaraga egangarĩte;</para>
  <para style="q2" vid="PRO 19:10">gũkĩrĩ ũũru makĩria ngombo gwatha anene!<verse eid="PRO 19:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 19:11"/>Ũũgĩ wa mũndũ nĩũmũheaga ũkirĩrĩria,</para>
  <para style="q2" vid="PRO 19:11">riiri wake nĩkũrekera andũ arĩa angĩ mahĩtia mao.<verse eid="PRO 19:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 19:12"/>Marakara ma mũthamaki nĩ ta mũraramo wa mũrũũthi,</para>
  <para style="q2" vid="PRO 19:12">no ũtugi wake nĩ ta ime rĩrĩ nyeki-inĩ.<verse eid="PRO 19:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 19:13"/>Mwana mũkĩĩgu nĩ mwanangĩko harĩ ithe,</para>
  <para style="q2" vid="PRO 19:13">na mũtumia wa haaro ahaana ta maaĩ maratata mategũtigithĩria.<verse eid="PRO 19:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 19:14"/>Nyũmba na ũtonga igayagwo kuuma kũrĩ aciari,</para>
  <para style="q2" vid="PRO 19:14">no mũtumia mũbaarĩrĩri maũndũ oimaga kũrĩ Jehova.<verse eid="PRO 19:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 19:15"/>Ũgũũta ũrehaga toro mũnene,</para>
  <para style="q2" vid="PRO 19:15">na mũndũ gĩthayo arĩĩagwo nĩ ngʼaragu.<verse eid="PRO 19:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 19:16"/>Mũndũ ũrĩa wathĩkagĩra maathani-rĩ, nĩ muoyo wake amenyagĩrĩra,</para>
  <para style="q2" vid="PRO 19:16">no ũrĩa ũtoonaga bata wa kũmenyerera mĩthiĩre yake nĩagaakua.<verse eid="PRO 19:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 19:17"/>Mũndũ ũrĩa ũiguagĩra athĩĩni tha nĩ Jehova akombagĩra indo,</para>
  <para style="q2" vid="PRO 19:17">nake Jehova nĩakamũrĩha nĩ ũndũ wa ũrĩa ekĩte.<verse eid="PRO 19:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 19:18"/>Rũithagia mũrũguo hĩndĩ ĩrĩa kũrĩ na kĩĩrĩgĩrĩro;</para>
  <para style="q2" vid="PRO 19:18">tiga kwenda gũtũma akooragwo.<verse eid="PRO 19:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 19:19"/>Mũndũ wa marakara mahiũ no nginya aherithio;</para>
  <para style="q2" vid="PRO 19:19">ũngĩmũteithũra rĩmwe no nginya ũkaamũteithũra rĩngĩ.<verse eid="PRO 19:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 19:20"/>Thikĩrĩria mataaro na wĩtĩkĩre ũrutani,</para>
  <para style="q2" vid="PRO 19:20">marigĩrĩrio-inĩ nĩũgaatuĩka mũndũ mũũgĩ.<verse eid="PRO 19:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 19:21"/>Mĩbango ya ngoro ya mũndũ nĩ mĩingĩ,</para>
  <para style="q2" vid="PRO 19:21">no muoroto wa Jehova noguo ũkaahinga.<verse eid="PRO 19:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 19:22"/>Kĩrĩa mũndũ eriragĩria nĩ wendo ũrĩa ũtathiraga,</para>
  <para style="q2" vid="PRO 19:22">nĩ kaba gũthĩĩna gũkĩra mũndũ wa maheeni.<verse eid="PRO 19:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 19:23"/>Gwĩtigĩra Jehova gũkinyagia mũndũ muoyo-inĩ:</para>
  <para style="q2" vid="PRO 19:23">Hĩndĩ ĩyo mũndũ akahurũka aiganĩire, atarĩ na thĩĩna.<verse eid="PRO 19:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 19:24"/>Kĩgũũta kĩrikagia guoko gwakĩo thaani-inĩ;</para>
  <para style="q2" vid="PRO 19:24">gĩgakĩremwo o na nĩgũgũcookia kanua!<verse eid="PRO 19:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 19:25"/>Hũũra mũnyũrũrania, nao arĩa mateciiragia merute kũgĩa na ũbaarĩrĩri;</para>
  <para style="q2" vid="PRO 19:25">kaania mũkũũrani maũndũ, na nĩekuongerera ũmenyo.<verse eid="PRO 19:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 19:26"/>Mũndũ ũrĩa ũtunyaga ithe indo na akaingata nyina,</para>
  <para style="q2" vid="PRO 19:26">nĩ mwana wa kũrehe thoni na gĩconoko.<verse eid="PRO 19:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 19:27"/>Mũrũ wakwa, ũngĩtiga gũthikĩrĩria mataaro-rĩ,</para>
  <para style="q2" vid="PRO 19:27">nĩũkoora njĩra ũtigane na ciugo cia ũmenyo.<verse eid="PRO 19:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 19:28"/>Mũira wa kũhakwo anyũrũragia kĩhooto,</para>
  <para style="q2" vid="PRO 19:28">na kanua ka mũndũ mwaganu kameragia o ũũru.<verse eid="PRO 19:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 19:29"/>Maherithia maigĩirwo anyũrũrania,</para>
  <para style="q2" vid="PRO 19:29">nacio iboko ikaigĩrwo mĩgongo ya andũ arĩa akĩĩgu.<verse eid="PRO 19:29"/></para>
  <para style="b"/>
  <chapter eid="PRO 19"/>
  <chapter number="20" style="c" sid="PRO 20"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 20:1"/>Ndibei nĩ mũnyũrũrania, na njoohi nĩ mũndũ wa ngũĩ;</para>
  <para style="q2" vid="PRO 20:1">mũndũ ũrĩa ũhĩtithagio nĩcio ti mũũgĩ.<verse eid="PRO 20:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 20:2"/>Mangʼũrĩ ma mũthamaki nĩ ta mũraramo wa mũrũũthi;</para>
  <para style="q2" vid="PRO 20:2">ũrĩa ũmũrakaragia nĩ muoyo wake ateaga.<verse eid="PRO 20:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 20:3"/>Gwĩtheema ngũĩ kũrehagĩra mũndũ gĩtĩĩo,</para>
  <para style="q2" vid="PRO 20:3">no mũndũ o wothe mũkĩĩgu ahiũhaga kũũgitana.<verse eid="PRO 20:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 20:4"/>Kĩgũũta gĩticimbaga hĩndĩ ya irĩma;</para>
  <para style="q2" vid="PRO 20:4">nĩ ũndũ ũcio hĩndĩ ya magetha gĩathiĩ kũmaatha gĩtirĩ kĩndũ kĩonaga.<verse eid="PRO 20:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 20:5"/>Muoroto wa ngoro ya mũndũ nĩ ta maaĩ ma ndia ndiku,</para>
  <para style="q2" vid="PRO 20:5">no mũndũ ũrĩ na ũtaũku nĩamatahaga.<verse eid="PRO 20:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 20:6"/>Andũ aingĩ metuaga marĩ na wendo ũtangĩthira,</para>
  <para style="q2" vid="PRO 20:6">no mũndũ mwĩhokeku-rĩ, nũũ ũngĩmuona?<verse eid="PRO 20:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 20:7"/>Mũndũ mũthingu atũũraga mũtũũrĩre ũtarĩ ũcuuke;</para>
  <para style="q2" vid="PRO 20:7">kũrathimwo-rĩ, nĩ ciana ciake iria atigaga.<verse eid="PRO 20:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 20:8"/>Rĩrĩa mũthamaki aikarĩra gĩtĩ gĩake kĩa ũnene atue ciira,</para>
  <para style="q2" vid="PRO 20:8">maitho make mathũngũrũraga ũũru wothe.<verse eid="PRO 20:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 20:9"/>Nũũ ũngiuga atĩrĩ, “Nĩnjigĩte ngoro yakwa ĩrĩ theru;</para>
  <para style="q2" vid="PRO 20:9">ndĩ mũtheru, na ndirĩ na mehia”?<verse eid="PRO 20:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 20:10"/>Mahiga ma ratiri mataiganainie ũritũ, o na ithimi itaiganĩte:</para>
  <para style="q2" vid="PRO 20:10">cierĩ nĩ indo irĩ magigi harĩ Jehova.<verse eid="PRO 20:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 20:11"/>O na kaana kamenyekaga nĩ ũndũ wa ciĩko ciako,</para>
  <para style="q2" vid="PRO 20:11">gakamenyeka kana mĩtugo yako nĩ mĩtheru, na kana nĩ mĩagĩrĩru.<verse eid="PRO 20:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 20:12"/>Matũ marĩa maiguaga na maitho marĩa monaga-rĩ,</para>
  <para style="q2" vid="PRO 20:12">cierĩ nĩ Jehova waciũmbire.<verse eid="PRO 20:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 20:13"/>Tiga kwenda toro, ndũkae gũthĩĩna;</para>
  <para style="q2" vid="PRO 20:13">ikaraga wĩiguĩte, na nĩũrĩrĩĩaga irio ũkahũũna.<verse eid="PRO 20:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 20:14"/>Mũgũri akĩgũra oigaga atĩrĩ, “Kĩndũ gĩkĩ ti kĩega, ti kĩega!”</para>
  <para style="q2" vid="PRO 20:14">Agacooka agathiĩ akĩĩrahaga ũrĩa oĩ kũgũra.<verse eid="PRO 20:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 20:15"/>Thahabu nĩ kũrĩ, o na ruru no nyingĩ,</para>
  <para style="q2" vid="PRO 20:15">no mĩromo ĩrĩa yaragia ũmenyo nĩ ithaga rĩa goro rĩrĩa rĩtonekaga.<verse eid="PRO 20:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 20:16"/>Oya nguo ya mũndũ ũrĩa ũngĩrũgamĩrĩra thiirĩ wa mũndũ wa kũngĩ;</para>
  <para style="q2" vid="PRO 20:16">mĩige ĩrũgamĩrĩre thiirĩ ũcio wa mũndũ wa kũngĩ.<verse eid="PRO 20:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 20:17"/>Irio cionekete na njĩra ya kũheenania irĩ cama harĩ mũndũ,</para>
  <para style="q2" vid="PRO 20:17">no thuutha kanua gake kaiyũraga o mũthanga.<verse eid="PRO 20:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 20:18"/>Mĩbango ĩgaacagĩra nĩ ũndũ wa kũhooya kĩrĩra,</para>
  <para style="q2" vid="PRO 20:18">ũngĩtua gũthiĩ mbaara-inĩ, heo ũtaaro.<verse eid="PRO 20:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 20:19"/>Mũndũ wa mũhuhu nĩoimagia ndeto cia ndundu nja,</para>
  <para style="q2" vid="PRO 20:19">nĩ ũndũ ũcio wĩthemage mũndũ waragia mũno.<verse eid="PRO 20:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 20:20"/>Mũndũ angĩruma ithe kana nyina,</para>
  <para style="q2" vid="PRO 20:20">tawa wake ũkaahorera nduma-inĩ ĩrĩa ndumanu.<verse eid="PRO 20:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 20:21"/>Igai rĩrĩa rĩoneka narua kĩambĩrĩria-inĩ,</para>
  <para style="q2" vid="PRO 20:21">marigĩrĩrio-inĩ rĩtituĩkaga rĩa kĩrathimo.<verse eid="PRO 20:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 20:22"/>Ndũkoige atĩrĩ, “Nĩngerĩhĩria ũũru ũyũ!”</para>
  <para style="q2" vid="PRO 20:22">Eterera Jehova nake nĩegũkũhonokia.<verse eid="PRO 20:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 20:23"/>Mahiga ma ratiri mataiganainie ũritũ nĩ kĩndũ kĩrĩ magigi harĩ Jehova,</para>
  <para style="q2" vid="PRO 20:23">nacio ratiri itarĩ cia ma itimũkenagia.<verse eid="PRO 20:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 20:24"/>Makinya ma mũndũ matongoragio nĩ Jehova.</para>
  <para style="q2" vid="PRO 20:24">Mũndũ-rĩ, angĩkĩhota atĩa kũmenya njĩra yake mwene?<verse eid="PRO 20:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 20:25"/>Nĩ mũtego harĩ mũndũ kwamũrĩra Ngai kĩndũ na ihenya,</para>
  <para style="q2" vid="PRO 20:25">acooke gwĩcũũrania ũhoro wa mĩĩhĩtwa yake thuutha-inĩ.<verse eid="PRO 20:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 20:26"/>Mũthamaki mũũgĩ nĩathũngũrũraga andũ arĩa aaganu;</para>
  <para style="q2" vid="PRO 20:26">ageragĩria kĩgaragari gĩa gũkonyora ngano igũrũ rĩao.<verse eid="PRO 20:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 20:27"/>Roho wa mũndũ nĩ tawa wa Jehova,</para>
  <para style="q2" vid="PRO 20:27">ũthuthuuragia o nginya tũturi tũrĩa tũrĩ thĩinĩ mũno.<verse eid="PRO 20:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 20:28"/>Wendo na wĩhokeku nĩcigitagĩra mũthamaki;</para>
  <para style="q2" vid="PRO 20:28">ũtugi nĩũtũmaga gĩtĩ gĩake kĩa ũnene kĩrũme.<verse eid="PRO 20:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 20:29"/>Hinya wa andũ ethĩ nĩguo riiri wao,</para>
  <para style="q2" vid="PRO 20:29">nacio mbuĩ nĩcio riiri wa arĩa akũrũ.<verse eid="PRO 20:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 20:30"/>Mahũũra na nguraro nĩitheragia ũũru wa mũndũ,</para>
  <para style="q2" vid="PRO 20:30">nacio iboko itheragia o nginya tũturi twa thĩinĩ mũno.<verse eid="PRO 20:30"/></para>
  <para style="b"/>
  <chapter eid="PRO 20"/>
  <chapter number="21" style="c" sid="PRO 21"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 21:1"/>Ngoro ya mũthamaki ĩrĩ moko-inĩ ma Jehova;</para>
  <para style="q2" vid="PRO 21:1">amĩroragia o kũrĩa ekwenda, o ta ũrĩa maaĩ moinithagĩrio mĩtaro-inĩ.<verse eid="PRO 21:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 21:2"/>Mũndũ oonaga mĩthiĩre yake yothe ĩrĩ mĩega,</para>
  <para style="q2" vid="PRO 21:2">no Jehova athimaga ngoro.<verse eid="PRO 21:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 21:3"/>Gwĩka ũrĩa kwagĩrĩire na ũrĩa ũrĩ kĩhooto</para>
  <para style="q2" vid="PRO 21:3">nĩ gwĩtĩkagĩrwo nĩ Jehova gũkĩra kũruta igongona.<verse eid="PRO 21:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 21:4"/>Maitho ma mwĩtũũgĩrio na ngoro ya mwĩtĩĩo,</para>
  <para style="q2" vid="PRO 21:4">o icio tawa wa arĩa aaganu-rĩ, nĩ mehia!<verse eid="PRO 21:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 21:5"/>Mĩbango ya arĩa marĩ kĩyo nĩĩrehaga uumithio,</para>
  <para style="q2" vid="PRO 21:5">o ta ũrĩa ti-itherũ ihenya inene rĩrehaga ũthĩĩni.<verse eid="PRO 21:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 21:6"/>Kũgĩa na ũtonga na njĩra ya rũrĩmĩ rwa maheeni</para>
  <para style="q2" vid="PRO 21:6">nĩ kĩbii gĩa gũthira, na nĩ mũtego wa gĩkuũ.<verse eid="PRO 21:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 21:7"/>Haaro ya andũ arĩa aaganu ĩkaamakururia, ĩmeherie,</para>
  <para style="q2" vid="PRO 21:7">nĩgũkorwo nĩmaregaga gwĩka ũrĩa kwagĩrĩire.<verse eid="PRO 21:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 21:8"/>Njĩra ya mũndũ mũhĩtia nĩ njogomu,</para>
  <para style="q2" vid="PRO 21:8">no mĩthiĩre ya mũndũ ũrĩa ũtarĩ mahĩtia nĩ mĩrũngarũ.<verse eid="PRO 21:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 21:9"/>Nĩ kaba gũtũũra nyũmba-igũrũ, koine-inĩ,</para>
  <para style="q2" vid="PRO 21:9">gũkĩra gũtũũra nyũmba thĩinĩ na mũtumia wa haaro.<verse eid="PRO 21:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 21:10"/>Mũndũ ũrĩa mwaganu eriragĩria gwĩka o ũũru;</para>
  <para style="q2" vid="PRO 21:10">ndaiguuagĩra mũndũ wa itũũra rĩake tha.<verse eid="PRO 21:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 21:11"/>Hĩndĩ ĩrĩa mũnyũrũrania aaherithio, arĩa maagĩte ũũgĩ nĩmohĩgaga;</para>
  <para style="q2" vid="PRO 21:11">hĩndĩ ĩrĩa mũndũ mũũgĩ aataarwo nĩagĩĩaga na ũmenyo.<verse eid="PRO 21:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 21:12"/>Ũrĩa Mũthingu, o we Ngai, nĩonaga nyũmba ya ũrĩa mwaganu,</para>
  <para style="q2" vid="PRO 21:12">na akarehithĩria ũcio mwaganu mwanangĩko.<verse eid="PRO 21:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 21:13"/>Mũndũ angĩhinga matũ ndakaigue kĩrĩro kĩa arĩa athĩĩni-rĩ,</para>
  <para style="q2" vid="PRO 21:13">o nake agaakaya na ndone wa kũmwĩtĩka.<verse eid="PRO 21:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 21:14"/>Kĩheo kĩheanĩtwo na hitho nĩkĩhooreragia marakara,</para>
  <para style="q2" vid="PRO 21:14">na ihaki ihithe nguo-inĩ rĩhooreragia mangʼũrĩ manene.<verse eid="PRO 21:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 21:15"/>Ituĩro rĩa kĩhooto rĩatuuo, rĩrehaga gĩkeno kũrĩ andũ arĩa athingu,</para>
  <para style="q2" vid="PRO 21:15">no rĩrehaga kĩmako kũrĩ arĩa mekaga ũũru.<verse eid="PRO 21:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 21:16"/>Mũndũ ũrĩa ũtiganaga na njĩra ya ũũgĩ,</para>
  <para style="q2" vid="PRO 21:16">akaahurũkĩra kĩũngano-inĩ kĩa arĩa akuũ.<verse eid="PRO 21:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 21:17"/>Mũndũ ũrĩa mwendi ikeno nĩagathĩĩna;</para>
  <para style="q2" vid="PRO 21:17">ũrĩa wothe mwendi ndibei na maguta-rĩ, gũtirĩ hĩndĩ agaatonga.<verse eid="PRO 21:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 21:18"/>Mũndũ ũrĩa mwaganu atuĩkaga irĩhi rĩa gũkũũra ũrĩa mũthingu,</para>
  <para style="q2" vid="PRO 21:18">na ũrĩa ũtarĩ mwĩhokeku agatuĩka irĩhi rĩa gũkũũra ũrĩa mũrũngĩrĩru.<verse eid="PRO 21:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 21:19"/>Nĩ kaba gũtũũra werũ-inĩ,</para>
  <para style="q2" vid="PRO 21:19">gũkĩra gũtũũra na mũtumia wa haaro na kũrakara narua.<verse eid="PRO 21:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 21:20"/>Thĩinĩ wa nyũmba ya mũndũ mũũgĩ nĩ kũrĩ mĩthemba yothe ya irio njega o na maguta,</para>
  <para style="q2" vid="PRO 21:20">no mũndũ mũkĩĩgu arĩĩaga kĩrĩa gĩothe arĩ nakĩo.<verse eid="PRO 21:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 21:21"/>Mũndũ ũrĩa ũthingataga ũthingu na wendani</para>
  <para style="q2" vid="PRO 21:21">nĩagĩĩaga na muoyo, na ũgaacĩru, na gĩtĩĩo.<verse eid="PRO 21:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 21:22"/>Mũndũ mũũgĩ atharĩkagĩra itũũra inene rĩa andũ arĩa njamba,</para>
  <para style="q2" vid="PRO 21:22">na akamomora kĩĩhitho kĩa hinya kĩrĩa mehokete.<verse eid="PRO 21:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 21:23"/>Mũndũ ũrĩa ũmenyagĩrĩra kanua gake na rũrĩmĩ rwake</para>
  <para style="q2" vid="PRO 21:23">nĩeyeheragia mũtino-inĩ.<verse eid="PRO 21:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 21:24"/>Mũndũ mwĩtĩĩi na mwĩgereri, etagwo “Mũnyũrũria”;</para>
  <para style="q2" vid="PRO 21:24">ekaga maũndũ make na mwĩtĩĩo mũnene.<verse eid="PRO 21:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 21:25"/>Merirĩria ma mũndũ kĩgũũta nĩmo makaamũũraga,</para>
  <para style="q2" vid="PRO 21:25">tondũ moko make matiendaga kũruta wĩra.<verse eid="PRO 21:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 21:26"/>Mũthenya wothe eriragĩria o makĩria,</para>
  <para style="q2" vid="PRO 21:26">no arĩa athingu maheanaga mategũtara.<verse eid="PRO 21:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 21:27"/>Igongona rĩa mũndũ mwaganu nĩ kĩndũ kĩrĩ magigi:</para>
  <para style="q2" vid="PRO 21:27">ĩ rĩtikĩrĩ magigi makĩria hĩndĩ ĩrĩa rĩrehetwo na ũhinga ngoro-inĩ!<verse eid="PRO 21:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 21:28"/>Mũira wa maheeni nĩgũthira agaathira,</para>
  <para style="q2" vid="PRO 21:28">nake ũrĩa ũmũthikagĩrĩria akaanangwo nginya tene.<verse eid="PRO 21:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 21:29"/>Mũndũ mwaganu erũagĩrĩra na ũrũme,</para>
  <para style="q2" vid="PRO 21:29">no mũndũ mũrũngĩrĩru nĩeciiragia ũhoro wa mĩthiĩre yake.<verse eid="PRO 21:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 21:30"/>Gũtirĩ ũũgĩ, kana ũmenyi, kana kĩrĩra o na kĩrĩkũ</para>
  <para style="q2" vid="PRO 21:30">kĩngĩhota gũũkĩrĩra Jehova.<verse eid="PRO 21:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 21:31"/>Mbarathi nĩĩharagĩrio nĩ ũndũ wa mũthenya wa mbaara,</para>
  <para style="q2" vid="PRO 21:31">no ũhootani uumaga kũrĩ Jehova.<verse eid="PRO 21:31"/></para>
  <para style="b"/>
  <chapter eid="PRO 21"/>
  <chapter number="22" style="c" sid="PRO 22"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 22:1"/>Rĩĩtwa rĩega nĩrĩakwĩrirĩrio gũkĩra ũtonga mũnene;</para>
  <para style="q2" vid="PRO 22:1">gũtĩĩka nĩ kwega gũkĩra betha kana thahabu.<verse eid="PRO 22:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 22:2"/>Andũ arĩa atongu na arĩa athĩĩni harĩ ũndũ ũmwe ũmanyiitithanĩtie;</para>
  <para style="q2" vid="PRO 22:2">Jehova nĩwe Mũmbi wao othe.<verse eid="PRO 22:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 22:3"/>Mũndũ mũbaarĩrĩri onaga ũgwati akehitha,</para>
  <para style="q2" vid="PRO 22:3">no arĩa matarĩ ũũgĩ mathiiaga o na mbere nao magatoonya thĩĩna-inĩ.<verse eid="PRO 22:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 22:4"/>Kwĩnyiihia na gwĩtigĩra Jehova</para>
  <para style="q2" vid="PRO 22:4">kũrehaga ũtonga, na gĩtĩĩo, na muoyo.<verse eid="PRO 22:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 22:5"/>Njĩra cia andũ arĩa aaganu irĩ mĩigua na mĩtego,</para>
  <para style="q2" vid="PRO 22:5">no ũrĩa ũgitagĩra ngoro yake aikaraga kũraya nacio.<verse eid="PRO 22:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 22:6"/>Menyeria mwana njĩra ĩrĩa agĩrĩirwo nĩkũgera,</para>
  <para style="q2" vid="PRO 22:6">na ndarĩ hĩndĩ akaamiuma o na aakũra.<verse eid="PRO 22:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 22:7"/>Andũ arĩa atongu nĩ mathaga arĩa athĩĩni,</para>
  <para style="q2" vid="PRO 22:7">na ũrĩa ũkombaga nĩ ndungata ya mũmũkoomberi.<verse eid="PRO 22:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 22:8"/>Mũndũ ũrĩa ũhaandaga waganu agethaga thĩĩna,</para>
  <para style="q2" vid="PRO 22:8">naruo rũthanju rwa marakara make nĩrũkanangwo.<verse eid="PRO 22:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 22:9"/>Mũndũ mũtaana we mwene nĩakarathimwo,</para>
  <para style="q2" vid="PRO 22:9">tondũ nĩagayagĩra arĩa athĩĩni irio ciake.<verse eid="PRO 22:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 22:10"/>Ingata mũnyũrũrania, nayo ngũĩ nĩĩgũkweherera;</para>
  <para style="q2" vid="PRO 22:10">inegene na irumi o nacio nĩcigũthira.<verse eid="PRO 22:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 22:11"/>Mũndũ ũrĩa wendaga ngoro theru na akaaragia maũndũ ma ũtugi,</para>
  <para style="q2" vid="PRO 22:11">mũthamaki nĩagatuĩka mũrata wake.<verse eid="PRO 22:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 22:12"/>Maitho ma Jehova nĩmamenyagĩrĩra ũmenyo,</para>
  <para style="q2" vid="PRO 22:12">no nĩathaahagia ciugo cia ũrĩa ũtarĩ mwĩhokeku.<verse eid="PRO 22:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 22:13"/>Kĩgũũta kiugaga, “Nja kũrĩ na mũrũũthi!”</para>
  <para style="q2" vid="PRO 22:13">Kana gĩkoiga atĩrĩ, “Nĩngũũragĩrwo njĩra-inĩ!”<verse eid="PRO 22:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 22:14"/>Kanua ka mũtumia mũtharia nĩ irima iriku,</para>
  <para style="q2" vid="PRO 22:14">nake ũrĩa werekeirio mangʼũrĩ ma Jehova agũũaga thĩinĩ wa rĩo.<verse eid="PRO 22:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 22:15"/>Ngoro ya mwana yohanĩtio na ũrimũ,</para>
  <para style="q2" vid="PRO 22:15">no rũthanju rwa kũmũherithia nĩrũkaũingata kũraya nake.<verse eid="PRO 22:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 22:16"/>Mũndũ ũrĩa ũhinyagĩrĩria arĩa athĩĩni nĩguo eyongerere ũtonga,</para>
  <para style="q2" vid="PRO 22:16">na ũrĩa ũheaga itonga iheo, eerĩ nĩmagathĩĩna.<verse eid="PRO 22:16"/></para>
  <para style="s1">Mĩario ya arĩa Oogĩ</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 22:17"/>Tega matũ, na ũthikĩrĩrie mĩario ya andũ arĩa oogĩ;</para>
  <para style="q2" vid="PRO 22:17">nyiita na ngoro yaku maũndũ marĩa ngũrutana,<verse eid="PRO 22:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 22:18"/>tondũ nĩ ũndũ mwega hĩndĩ ĩrĩa ũkũmaiga ngoro-inĩ yaku,</para>
  <para style="q2" vid="PRO 22:18">na ũkoragwo namo mothe mĩromo-inĩ yaku.<verse eid="PRO 22:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 22:19"/>Ndaakũmenyithia mo nĩgeetha mwĩhoko waku ũkoragwo harĩ Jehova,</para>
  <para style="q2" vid="PRO 22:19">wee nĩwe ngũruta maũndũ macio ũmũthĩ, ĩĩ wee nĩwe ngũruta.<verse eid="PRO 22:19"/></para>
  <para style="q2">
    <verse number="20" style="v" sid="PRO 22:20"/>Githĩ ndikwandĩkĩire thimo mĩrongo ĩtatũ,</para>
  <para style="q2" vid="PRO 22:20">thimo cia ũtaarani na ũmenyo,<verse eid="PRO 22:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 22:21"/>ngakũruta ciugo cia ma na cia kwĩhokeka,</para>
  <para style="q2" vid="PRO 22:21">nĩgeetha ũkaahota kũhe</para>
  <para style="q2" vid="PRO 22:21">ũrĩa ũgũtũmĩte macookio mega?<verse eid="PRO 22:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 22:22"/>Ndũkanatunye arĩa athĩĩni indo ciao tondũ wa ũthĩĩni wao,</para>
  <para style="q2" vid="PRO 22:22">na ndũkanahinyĩrĩrie arĩa abatari ciira-inĩ,<verse eid="PRO 22:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 22:23"/>nĩgũkorwo Jehova nĩakamaciirĩrĩra,</para>
  <para style="q2" vid="PRO 22:23">na nĩagatunya arĩa mamatunyaga indo ciao.<verse eid="PRO 22:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 22:24"/>Ndũkanagĩe ũrata na mũndũ ũrĩa ũrĩ marakara mahiũ,</para>
  <para style="q2" vid="PRO 22:24">ndũkanagĩe thiritũ na mũndũ ũrĩa ũhiũhaga kũrakara,<verse eid="PRO 22:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 22:25"/>tondũ wahota kwĩruta mĩthiĩre yake,</para>
  <para style="q2" vid="PRO 22:25">na ũnyiitwo nĩ mũtego.<verse eid="PRO 22:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 22:26"/>Ndũgatuĩke mũndũ wa kũiga kĩndũ gĩa kũrũgamĩrĩra thiirĩ,</para>
  <para style="q2" vid="PRO 22:26">kana ũtuĩke wee nĩwe wa kũrũgamagĩrĩra mathiirĩ ma andũ angĩ;<verse eid="PRO 22:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 22:27"/>ũngĩkaaga kĩndũ gĩa kũrĩha nakĩo-rĩ,</para>
  <para style="q2" vid="PRO 22:27">ũgaatunywo ũrĩrĩ waku o ũũkomeire.<verse eid="PRO 22:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 22:28"/>Ndũkaneherie ihiga rĩa tene rĩa mũhaka</para>
  <para style="q2" vid="PRO 22:28">rĩrĩa rĩahaandirwo nĩ maithe manyu ma tene.<verse eid="PRO 22:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 22:29"/>Nĩwonaga mũndũ mũũgĩ na wĩra wake?</para>
  <para style="q2" vid="PRO 22:29">Ũcio agatungata o na mbere ya athamaki;</para>
  <para style="q2" vid="PRO 22:29">ndagatungata mbere ya andũ matooĩkaine.<verse eid="PRO 22:29"/></para>
  <chapter eid="PRO 22"/>
  <chapter number="23" style="c" sid="PRO 23"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 23:1"/>Rĩrĩa waikara thĩ kũrĩĩanĩra na mwathi wa bũrũri-rĩ,</para>
  <para style="q2" vid="PRO 23:1">wĩmenyerere nũũ ũcio mũrĩ nake;<verse eid="PRO 23:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 23:2"/>wĩigĩrĩre kahiũ mũmero</para>
  <para style="q2" vid="PRO 23:2">ũngĩkorwo ũrĩ mũndũ mũkoroku.<verse eid="PRO 23:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 23:3"/>Ndũkerirĩrie irio ciake irĩ mũrĩo,</para>
  <para style="q2" vid="PRO 23:3">nĩgũkorwo nĩ irio cia gũkũheenereria.<verse eid="PRO 23:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 23:4"/>Tiga kwĩnogia na kwenda gwĩtongia;</para>
  <para style="q2" vid="PRO 23:4">gĩa na ũũgĩ wa kũhota kwĩrigĩrĩria.<verse eid="PRO 23:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 23:5"/>No wone ũtonga, ũcooke ũbuĩrie,</para>
  <para style="q2" vid="PRO 23:5">nĩgũkorwo ti-itherũ ũtonga nĩwĩmeragia mathagu,</para>
  <para style="q2" vid="PRO 23:5">na ũkombũka ta nderi yerekeire matu-inĩ.<verse eid="PRO 23:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 23:6"/>Tiga kũrĩa irio cia mũndũ mũkarĩ,</para>
  <para style="q2" vid="PRO 23:6">ndũkerirĩrie irio ciake cia mũrĩo;<verse eid="PRO 23:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 23:7"/>tondũ nĩ mũndũ wa arĩa meciiragia o ũhoro wa thogora hĩndĩ ciothe.</para>
  <para style="q2" vid="PRO 23:7">Akwĩraga atĩrĩ, “Rĩa na ũnyue,”</para>
  <para style="q2" vid="PRO 23:7">no ngoro yake ndĩrĩ hamwe nawe.<verse eid="PRO 23:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 23:8"/>Nĩũgatahĩka kĩrĩa kĩnini ũgaakorwo ũrĩĩte,</para>
  <para style="q2" vid="PRO 23:8">nacio ngaatho ciaku nĩikoorĩra thĩ.<verse eid="PRO 23:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 23:9"/>Ndũkaarie na mũndũ mũkĩĩgu,</para>
  <para style="q2" vid="PRO 23:9">nĩgũkorwo we no anyararire ũũgĩ wa ciugo ciaku.<verse eid="PRO 23:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 23:10"/>Ndũkaneherie ihiga rĩa tene rĩa mũhaka,</para>
  <para style="q2" vid="PRO 23:10">kana ũhatĩke mĩhaka ya mĩgũnda ya ciana cia ngoriai,<verse eid="PRO 23:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 23:11"/>tondũ Mũgitĩri wacio nĩ arĩ na hinya;</para>
  <para style="q2" vid="PRO 23:11">nĩakamaciirĩrĩra agũũkĩrĩre.<verse eid="PRO 23:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 23:12"/>Ringĩrĩria ngoro yaku gũthikĩrĩria ũrutani,</para>
  <para style="q2" vid="PRO 23:12">na matũ maku kũigua ciugo cia ũmenyo.<verse eid="PRO 23:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 23:13"/>Ndũkanaage kũherithia mwana;</para>
  <para style="q2" vid="PRO 23:13">ũngĩmũhũũra na rũthanju-rĩ, ndangĩkua.<verse eid="PRO 23:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 23:14"/>Mũhũũrage na rũthanju</para>
  <para style="q2" vid="PRO 23:14">nĩguo ũhonokie muoyo wake kuuma kũrĩ gĩkuũ.<verse eid="PRO 23:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 23:15"/>Mũrũ wakwa, ngoro yaku ĩngĩgĩa na ũũgĩ-rĩ,</para>
  <para style="q2" vid="PRO 23:15">hĩndĩ ĩyo ngoro yakwa no ĩkene;<verse eid="PRO 23:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 23:16"/>ngoro yakwa nĩĩgacanjamũka</para>
  <para style="q2" vid="PRO 23:16">rĩrĩa mĩromo yaku ĩkaaria maũndũ marĩa magĩrĩire.<verse eid="PRO 23:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 23:17"/>Ndũkanareke ngoro yaku ĩiguĩre ehia ũiru,</para>
  <para style="q2" vid="PRO 23:17">no hĩndĩ ciothe gĩĩaga na kĩyo gĩa gwĩtigĩra Jehova.<verse eid="PRO 23:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 23:18"/>Tondũ ti-itherũ wee ũrĩ na kĩĩrĩgĩrĩro thuutha-inĩ,</para>
  <para style="q2" vid="PRO 23:18">na kĩĩrĩgĩrĩro gĩaku gĩtigaathira.<verse eid="PRO 23:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 23:19"/>Mũrũ wakwa, thikĩrĩria nĩgeetha ũgĩe na ũũgĩ,</para>
  <para style="q2" vid="PRO 23:19">na ũige ngoro yaku njĩra-inĩ ĩrĩa yagĩrĩire.<verse eid="PRO 23:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 23:20"/>Ndũkegwatanie na andũ arĩa manyuuaga njoohi,</para>
  <para style="q2" vid="PRO 23:20">kana arĩa makorokagĩra nyama,<verse eid="PRO 23:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 23:21"/>nĩgũkorwo arĩĩu na andũ arĩa akoroku matuĩkaga athĩĩni,</para>
  <para style="q2" vid="PRO 23:21">naguo ũgũũta ũtũmaga mũndũ ehumbe matangari.<verse eid="PRO 23:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 23:22"/>Thikagĩrĩria thoguo, we ũrĩa wagũciarire,</para>
  <para style="q2" vid="PRO 23:22">na ndũkanyarare maitũguo, o na aakorwo nĩ mũkũrũ.<verse eid="PRO 23:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 23:23"/>Wĩgũrĩre ũhoro ũrĩa wa ma na ndũkanawendie;</para>
  <para style="q2" vid="PRO 23:23">wĩgĩĩre na ũũgĩ, na ũtaaro, na ũtaũku.<verse eid="PRO 23:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 23:24"/>Ithe wa mwana mũthingu arĩ gĩkeno kĩnene mũno;</para>
  <para style="q2" vid="PRO 23:24">nake ũrĩa ũrĩ na mwana mũũgĩ nĩakenagio nĩwe.<verse eid="PRO 23:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 23:25"/>Thoguo na maitũguo marocanjamũka nĩ ũndũ waku;</para>
  <para style="q2" vid="PRO 23:25">mũtumia ũrĩa wagũciarire arokena!<verse eid="PRO 23:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 23:26"/>Mũrũ wakwa, heaga ngoro yaku,</para>
  <para style="q1" vid="PRO 23:26">na ũreke maitho maku marũmagĩrĩre njĩra ciakwa,<verse eid="PRO 23:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 23:27"/>nĩgũkorwo mũmaraya nĩ irima iriku,</para>
  <para style="q2" vid="PRO 23:27">nake mũtumia mũtharia nĩ gĩthima gĩkunderu.<verse eid="PRO 23:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 23:28"/>Oohagĩria andũ njĩra-inĩ o ta njangiri,</para>
  <para style="q2" vid="PRO 23:28">na nĩatũmaga kuongerereke andũ matarĩ ehokeku kĩrĩndĩ-inĩ.<verse eid="PRO 23:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 23:29"/>Nũũ ũrĩ na haaro? Nũũ ũrĩ na kĩeha?</para>
  <para style="q2" vid="PRO 23:29">Nũũ ũrĩ hatĩka-inĩ? Nũũ ũrĩ na mateta?</para>
  <para style="q2" vid="PRO 23:29">Nũũ ũgurarĩtio hatarĩ gĩtũmi? Nũũ ũtunĩhĩtie maitho?<verse eid="PRO 23:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 23:30"/>Nĩ arĩa matindaga marũmanĩrĩire na ndibei,</para>
  <para style="q2" vid="PRO 23:30">arĩa mathiiaga magĩcamaga mbakũri cia ndibei ĩrĩa ndukanie.<verse eid="PRO 23:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 23:31"/>Tiga kwĩrorera ndibei rĩrĩa ĩtunĩhĩte,</para>
  <para style="q2" vid="PRO 23:31">rĩrĩa ĩgũkenga ĩrĩ gĩkombe-inĩ,</para>
  <para style="q2" vid="PRO 23:31">rĩrĩa ĩkũmerũka wega!<verse eid="PRO 23:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 23:32"/>Mũthia-inĩ ĩrũmanaga ta nyoka,</para>
  <para style="q2" vid="PRO 23:32">ĩgagũtheeca na thumu ta nduĩra.<verse eid="PRO 23:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 23:33"/>Maitho maku makoonaga maũndũ mageni,</para>
  <para style="q2" vid="PRO 23:33">na meciiria maku meciirie maũndũ ma waganu.<verse eid="PRO 23:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 23:34"/>Ũgaatuĩka ta mũndũ ũkomete iria-inĩ rĩrĩa inene gatagatĩ,</para>
  <para style="q2" vid="PRO 23:34">o ta mũndũ ũkomete mũthia wa gĩtugĩ kĩa macua.<verse eid="PRO 23:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 23:35"/>Nĩũkoiga atĩrĩ, “Ngũthĩtwo, no ndinatiihio!</para>
  <para style="q2" vid="PRO 23:35">Nĩmahũũra, no ndinaigua ũndũ!</para>
  <para style="q1" vid="PRO 23:35">Ngokĩra-rĩ,</para>
  <para style="q2" vid="PRO 23:35">nĩguo ngacarie ĩngĩ ya kũnyua?”<verse eid="PRO 23:35"/></para>
  <chapter eid="PRO 23"/>
  <chapter number="24" style="c" sid="PRO 24"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 24:1"/>Tiga kũiguĩra andũ arĩa aaganu ũiru,</para>
  <para style="q2" vid="PRO 24:1">na ndũkanerirĩrie thiritũ yao,<verse eid="PRO 24:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 24:2"/>nĩgũkorwo ngoro ciao ithugundaga o haaro,</para>
  <para style="q2" vid="PRO 24:2">na mĩromo yao yaragia ũhoro wa kũrehere andũ thĩĩna.<verse eid="PRO 24:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 24:3"/>Nyũmba yakagwo na ũũgĩ,</para>
  <para style="q2" vid="PRO 24:3">naguo ũtaũku nĩguo ũtũmaga ĩĩhaande;<verse eid="PRO 24:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 24:4"/>ũmenyo nĩguo ũiyũragia tũnyũmba twayo,</para>
  <para style="q2" vid="PRO 24:4">ũgatũiyũria na indo cia bata, na ũtonga mwega.<verse eid="PRO 24:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 24:5"/>Mũndũ mũũgĩ arĩ ũhoti mũnene,</para>
  <para style="q2" vid="PRO 24:5">na mũndũ ũrĩ ũmenyo nĩakĩragĩrĩria kũgĩa na hinya;<verse eid="PRO 24:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 24:6"/>ũgĩthiĩ mbaara-inĩ nĩũbatarĩtio nĩgũtaarwo,</para>
  <para style="q2" vid="PRO 24:6">na nĩgeetha ũhootane nĩũbatarĩtio nĩ aheani kĩrĩra aingĩ.<verse eid="PRO 24:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 24:7"/>Ũũgĩ ũrĩ igũrũ mũno, ndũngĩkinyĩrĩka nĩ mũndũ mũkĩĩgu;</para>
  <para style="q2" vid="PRO 24:7">rĩrĩa kwagomanwo kĩhingo-inĩ, ndangĩona wa kuuga.<verse eid="PRO 24:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 24:8"/>Mũndũ ũrĩa ũthugundaga ũũru-rĩ,</para>
  <para style="q2" vid="PRO 24:8">andũ mamwĩtaga mungumania.<verse eid="PRO 24:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 24:9"/>Mathugunda ma ũrimũ nĩ mehia,</para>
  <para style="q2" vid="PRO 24:9">na mũnyũrũrania nĩ kĩndũ kĩrĩ magigi harĩ andũ.<verse eid="PRO 24:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 24:10"/>Ũngĩtuĩka wa kũũrwo nĩ hinya hĩndĩ ya thĩĩna,</para>
  <para style="q2" vid="PRO 24:10">hinya waku kaĩ nĩ mũnini-ĩ!<verse eid="PRO 24:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 24:11"/>Honokia arĩa maratwarĩrĩrio gĩkuũ-inĩ;</para>
  <para style="q2" vid="PRO 24:11">girĩrĩria arĩa maratũgũũga merekeire gĩthĩnjĩro.<verse eid="PRO 24:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 24:12"/>Ũngiuga atĩrĩ, “Ũhoro ũcio tũtiraũmenyete,”</para>
  <para style="q2" vid="PRO 24:12">githĩ ũrĩa ũthimaga ngoro tiwe ũmenyaga?</para>
  <para style="q1" vid="PRO 24:12">Ũrĩa ũrangagĩra muoyo waku-rĩ, githĩ ndooĩ kana nĩguo?</para>
  <para style="q2" vid="PRO 24:12">Githĩ ndakaarĩha o mũndũ kũringana na ũrĩa ekĩte?<verse eid="PRO 24:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 24:13"/>Mũrũ wakwa, rĩa ũũkĩ, nĩgũkorwo nĩ mwega;</para>
  <para style="q2" vid="PRO 24:13">ũũkĩ uumĩte magua-inĩ ũrĩ mũrĩo ũkĩũcama.<verse eid="PRO 24:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 24:14"/>Ningĩ menya atĩ ũũgĩ ũrĩ mũrĩo harĩ ngoro yaku;</para>
  <para style="q2" vid="PRO 24:14">ũngĩgĩa naguo, nĩũkagĩa na kĩĩrĩgĩrĩro,</para>
  <para style="q2" vid="PRO 24:14">na kĩĩrĩgĩrĩro gĩaku gĩtigaathira.<verse eid="PRO 24:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 24:15"/>Ndũkanoohie mũndũ mũthingu njĩra-inĩ ũtharĩkĩre nyũmba yake ta mũitũ,</para>
  <para style="q2" vid="PRO 24:15">ndũkanahithũkĩre gĩikaro gĩake;<verse eid="PRO 24:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 24:16"/>nĩgũkorwo mũndũ mũthingu o na angĩgũa maita mũgwanja, agũũaga o agĩũkagĩra,</para>
  <para style="q1" vid="PRO 24:16">no andũ arĩa aaganu marũndagwo nĩ mũtino.<verse eid="PRO 24:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 24:17"/>Hĩndĩ ĩrĩa thũ yaku yagũa-rĩ, ndũkanamĩkenerere;</para>
  <para style="q2" vid="PRO 24:17">hĩndĩ ĩrĩa yahĩngwo-rĩ, ndũkareke ngoro yaku ĩkene,<verse eid="PRO 24:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 24:18"/>nĩguo Jehova ndakone ũndũ ũcio arakare,</para>
  <para style="q2" vid="PRO 24:18">akĩhũndũre marakara make kuuma kũrĩ thũ ĩyo.<verse eid="PRO 24:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 24:19"/>Ndũkanathĩĩnĩke ngoro nĩ ũndũ wa andũ arĩa ooru,</para>
  <para style="q2" vid="PRO 24:19">kana wĩrirĩrie kũhaanana na arĩa aaganu,<verse eid="PRO 24:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 24:20"/>nĩgũkorwo mũndũ ũrĩa mũũru ndarĩ na mwĩhoko wa thuutha-inĩ,</para>
  <para style="q2" vid="PRO 24:20">na tawa wa ũrĩa mwaganu nĩũkahorio.<verse eid="PRO 24:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 24:21"/>Mũrũ wakwa, wĩtigĩre Jehova na wĩtigĩre mũthamaki,</para>
  <para style="q2" vid="PRO 24:21">na ndũkagĩe na ngwatanĩro na andũ arĩa aremi,<verse eid="PRO 24:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 24:22"/>nĩgũkorwo acio eerĩ no mamũrehithĩrie mwanangĩko wa narua,</para>
  <para style="q2" vid="PRO 24:22">na nũũ ũngĩmenya nĩ mĩtino ĩrĩkũ mangĩrehe?<verse eid="PRO 24:22"/></para>
  <para style="s1">Mĩario ĩngĩ ya arĩa Oogĩ</para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 24:23"/>O na ici no thimo cia andũ arĩa oogĩ:</para>
  <para style="q1" vid="PRO 24:23">Kwenda mwena ũmwe gũkĩra ũrĩa ũngĩ ciira-inĩ ti ũndũ mwega:<verse eid="PRO 24:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 24:24"/>Ũrĩa wothe wĩraga mũndũ ũrĩa ũrĩ na mahĩtia atĩrĩ, “Wee ndũrĩ na mahĩtia,”</para>
  <para style="q2" vid="PRO 24:24">kĩrĩndĩ nĩgĩkamũruma, na athũũrwo nĩ ndũrĩrĩ.<verse eid="PRO 24:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 24:25"/>No arĩa matuagĩra andũ arĩa aaganu ciira,</para>
  <para style="q2" vid="PRO 24:25">nĩmakona wega, na magĩe na kĩrathimo kĩega.<verse eid="PRO 24:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 24:26"/>Icookio rĩa wĩhokeku</para>
  <para style="q2" vid="PRO 24:26">nĩ ta kĩmumunyano kĩa mĩromo.<verse eid="PRO 24:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 24:27"/>Rĩĩkia wĩra wa gũtua mwako na nja,</para>
  <para style="q2" vid="PRO 24:27">na ũhaarĩrie mĩgũnda yaku;</para>
  <para style="q2" vid="PRO 24:27">thuutha ũcio cooka wĩakĩre nyũmba.<verse eid="PRO 24:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 24:28"/>Ndũkanarute ũira ũigĩrĩre mũndũ wa itũũra rĩaku kĩgeenyo,</para>
  <para style="q2" vid="PRO 24:28">kana ũheenanie na mĩromo yaku.<verse eid="PRO 24:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 24:29"/>Ndũkanoige atĩrĩ, “Ngũmwĩka o ta ũrĩa anjĩkĩte;</para>
  <para style="q2" vid="PRO 24:29">ngwĩrĩhĩria harĩ mũndũ ũcio kũringana na ũrĩa eekire.”<verse eid="PRO 24:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 24:30"/>Ndaahĩtũkĩire mũgũnda-inĩ wa kĩgũũta,</para>
  <para style="q2" vid="PRO 24:30">ngĩhĩtũkĩra mũgũnda-inĩ wa mĩthabibũ wa mũndũ ũtooĩ gũkũũrana maũndũ;<verse eid="PRO 24:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 24:31"/>na rĩrĩ, mĩigua yamerete kũndũ guothe,</para>
  <para style="q2" vid="PRO 24:31">na mũgũnda ũkaiyũra riya,</para>
  <para style="q2" vid="PRO 24:31">naruo rũthingo rwa mahiga rũkamomoka.<verse eid="PRO 24:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 24:32"/>Nĩndacũũranirie na ngoro yakwa maũndũ macio ndonire,</para>
  <para style="q2" vid="PRO 24:32">na ngĩĩruta ũndũ kuumana na ũrĩa ndonire:<verse eid="PRO 24:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 24:33"/>Mũtugo wa gũkoma hanini,</para>
  <para style="q2" vid="PRO 24:33">gũcooka toro hanini, gũkũnja moko hanini ũhurũke;<verse eid="PRO 24:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 24:34"/>naguo ũthĩĩni ũgaagũkorerera ta mũitũ,</para>
  <para style="q2" vid="PRO 24:34">na wagi ũgũkorerere ta mũndũ wĩohete indo cia mbaara.<verse eid="PRO 24:34"/></para>
  <chapter eid="PRO 24"/>
  <chapter number="25" style="c" sid="PRO 25"/>
  <para style="s1">Thimo Ingĩ cia Solomoni</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 25:1"/>Ici nĩ thimo ingĩ cia Solomoni, iria ciacookanĩrĩirio na ikĩandĩkwo nĩ andũ a Hezekia ũrĩa warĩ mũthamaki wa Juda:<verse eid="PRO 25:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 25:2"/>Kũhithĩrĩra ũndũ nĩ ũgooci wa Ngai;</para>
  <para style="q2" vid="PRO 25:2">nakuo gũtuĩria ũndũ nĩkuo kũgoocithagia athamaki.<verse eid="PRO 25:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 25:3"/>O ta ũrĩa igũrũ kũraihĩte na igũrũ, nakuo thĩ gũkarika mũno-rĩ,</para>
  <para style="q2" vid="PRO 25:3">ũguo noguo ngoro cia athamaki itangĩtuĩrĩka.<verse eid="PRO 25:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 25:4"/>Theria betha ĩthire gĩko,</para>
  <para style="q2" vid="PRO 25:4">na nĩhegũtigara kĩndũ kĩa mũturi wa betha;<verse eid="PRO 25:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 25:5"/>eheria andũ arĩa aaganu harĩ mũthamaki,</para>
  <para style="q2" vid="PRO 25:5">na gĩtĩ gĩake kĩa ũnene nĩgĩkũrũmio nĩ ũthingu.<verse eid="PRO 25:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 25:6"/>Ndũgetũũgĩrie harĩ mũthamaki,</para>
  <para style="q2" vid="PRO 25:6">na ndũkerũgamie gatagatĩ ka anene;<verse eid="PRO 25:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 25:7"/>kaba mũthamaki we mwene akwĩre, “Ambata, ũũke haha,”</para>
  <para style="q2" vid="PRO 25:7">gũkĩra agũconorithie mbere ya mũndũ ũrĩ igweta.</para>
  <para style="b" vid="PRO 25:7"/>
  <para style="q1" vid="PRO 25:7">Ũndũ ũrĩa wonete na maitho-rĩ,<verse eid="PRO 25:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="PRO 25:8"/>ndũkahiũhe kũũtwara igooti-inĩ,</para>
  <para style="q1" vid="PRO 25:8">tondũ-rĩ, ũgeeka atĩa marigĩrĩrio-inĩ,</para>
  <para style="q2" vid="PRO 25:8">mũndũ wa itũũra rĩaku angĩkaaruta ũira agũconorithie?<verse eid="PRO 25:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 25:9"/>Ciirai na mũndũ wa itũũra rĩaku we mwene,</para>
  <para style="q2" vid="PRO 25:9">nĩguo ndũkoimie ndundu ya mũndũ ũcio ũngĩ nja,<verse eid="PRO 25:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 25:10"/>kana ũiguuo nĩ mũndũ ũngĩ agũconore,</para>
  <para style="q2" vid="PRO 25:10">ũtũũre na ngumo njũru ĩtagagũthira.<verse eid="PRO 25:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 25:11"/>Kiugo kĩarĩtio hĩndĩ ĩrĩa yagĩrĩire</para>
  <para style="q2" vid="PRO 25:11">nĩ ta matunda ma thahabu marĩ thaani-inĩ ya betha.<verse eid="PRO 25:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 25:12"/>Gĩcũhĩ gĩa gũtũ gĩa thahabu, kana ithaga rĩa thahabu ĩrĩa therie,</para>
  <para style="q2" vid="PRO 25:12">nĩ taguo irũithia rĩa mũndũ mũũgĩ rĩtariĩ gũtũ-inĩ kwa mũndũ ũrĩa ũiguaga.<verse eid="PRO 25:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 25:13"/>Ta ũhehu wa tharunji hĩndĩ ya magetha,</para>
  <para style="q2" vid="PRO 25:13">no taguo mũtwari ndũmĩrĩri mwĩhokeku ahaana kũrĩ arĩa mamũtũmaga;</para>
  <para style="q2" vid="PRO 25:13">nĩatũmaga ngoro cia anene ake ikene.<verse eid="PRO 25:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 25:14"/>O ta ũrĩa matu na rũhuho matarĩ mbura ihaana,</para>
  <para style="q2" vid="PRO 25:14">no taguo mũndũ ahaana ũrĩa ũrahaga ũrĩa ekũheana iheo na ndaheane.<verse eid="PRO 25:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 25:15"/>Ũkirĩrĩria no ũguucĩrĩrie ũrĩa waathanaga etĩkĩre ũndũ,</para>
  <para style="q2" vid="PRO 25:15">naruo rũrĩmĩ ruororo no ruune ihĩndĩ.<verse eid="PRO 25:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 25:16"/>Ũngĩona ũũkĩ-rĩ, rĩa o wa gũkũigana,</para>
  <para style="q2" vid="PRO 25:16">ũngĩrĩa mũingĩ mũno nĩũgũtahĩka.<verse eid="PRO 25:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 25:17"/>Nyiihia gũthiiaga kwa mũndũ wa itũũra,</para>
  <para style="q2" vid="PRO 25:17">ũngĩthiĩ kaingĩ no anogio nĩwe agũthũũre.<verse eid="PRO 25:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 25:18"/>Mũndũ ũrĩa ũheanaga ũira wa maheeni agookĩrĩra mũndũ wa itũũra,</para>
  <para style="q2" vid="PRO 25:18">ahaana ta njũgũma, kana rũhiũ rwa njora, kana mũguĩ mũũgĩ.<verse eid="PRO 25:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 25:19"/>Kwĩhoka mũndũ ũtarĩ mwĩhokeku hĩndĩ ya thĩĩna,</para>
  <para style="q2" vid="PRO 25:19">no ta kwĩhoka igego ituĩku, kana kũgũrũ kũrathua.<verse eid="PRO 25:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 25:20"/>Ũrĩa ũinagĩra mũndũ ũrĩ na ngoro nditũ nyĩmbo,</para>
  <para style="q2" vid="PRO 25:20">no ta mũndũ kwĩruta nguo mũthenya wa heho,</para>
  <para style="q2" vid="PRO 25:20">kana gũitĩrĩria thiki igata-inĩ.<verse eid="PRO 25:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 25:21"/>Thũ yaku ĩngĩkorwo ĩhũtiĩ-rĩ, mĩhe irio ĩrĩe;</para>
  <para style="q2" vid="PRO 25:21">ĩngĩkorwo ĩnyootiĩ-rĩ, mĩhe maaĩ ĩnyue.<verse eid="PRO 25:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 25:22"/>Weka ũguo-rĩ, nĩũkũmĩigĩrĩra makara ma mwaki mũtwe,</para>
  <para style="q2" vid="PRO 25:22">nake Jehova nĩagakũrĩha.<verse eid="PRO 25:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 25:23"/>O ta ũrĩa rũhuho rwa gathigathini rũrehaga mbura,</para>
  <para style="q2" vid="PRO 25:23">noguo rũrĩmĩ rwa njuukũ rũrehaga ũhoro wa marakara.<verse eid="PRO 25:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 25:24"/>Nĩ kaba gũtũũra nyũmba-igũrũ koine-inĩ,</para>
  <para style="q2" vid="PRO 25:24">gũkĩra gũtũũrania nyũmba thĩinĩ na mũtumia wa haaro.<verse eid="PRO 25:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 25:25"/>O ta ũrĩa maaĩ mahehu manyootoraga mũndũ mũnyootu,</para>
  <para style="q2" vid="PRO 25:25">no taguo ũhoro mwega uumĩte bũrũri wa kũraya wĩkaga.<verse eid="PRO 25:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 25:26"/>O ta gĩthima kĩiyũrĩte ndaka, kana itherũkĩro rĩa maaĩ riunjuge,</para>
  <para style="q2" vid="PRO 25:26">ũguo nĩguo mũndũ mũthingu ahaanaga angĩĩrekereria harĩ andũ arĩa aaganu.<verse eid="PRO 25:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 25:27"/>Ti wega kũrĩa ũũkĩ mũingĩ mũno,</para>
  <para style="q2" vid="PRO 25:27">o na ti ũndũ wa gũtĩĩka mũndũ gwĩcarĩria gĩtĩĩo we mwene.<verse eid="PRO 25:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 25:28"/>Mũndũ ũtangĩhota gwatha ngoro yake</para>
  <para style="q2" vid="PRO 25:28">atariĩ ta itũũra inene rĩmomoku, na rĩtarĩ na thingo.<verse eid="PRO 25:28"/></para>
  <chapter eid="PRO 25"/>
  <chapter number="26" style="c" sid="PRO 26"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 26:1"/>O ta ũrĩa tharunji ĩtaagĩrĩire kũgĩa hĩndĩ ya riũa, kana mbura kuura hĩndĩ ya magetha-rĩ,</para>
  <para style="q2" vid="PRO 26:1">noguo gĩtĩĩo gĩtagĩrĩire mũndũ mũkĩĩgu.<verse eid="PRO 26:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 26:2"/>Ta kanyoni-ka-nja gekũbatabata, kana thũngũrũrũ ĩkũhiũka-hiũka,</para>
  <para style="q2" vid="PRO 26:2">noguo kĩrumi gĩtarĩ gĩtũmi gĩtarĩ ha kwĩgwatĩrĩra.<verse eid="PRO 26:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 26:3"/>Kĩboko nĩ kĩa mbarathi, matamu nĩ ma ndigiri,</para>
  <para style="q2" vid="PRO 26:3">na rũthanju nĩ rwa ciande cia andũ arĩa akĩĩgu!<verse eid="PRO 26:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 26:4"/>Ndũkanacookerie mũndũ mũkĩĩgu kũringana na ũrimũ wake,</para>
  <para style="q2" vid="PRO 26:4">ndũkae gũtuĩka take.<verse eid="PRO 26:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 26:5"/>Cookeria mũndũ mũkĩĩgu kũringana na ũrimũ wake,</para>
  <para style="q2" vid="PRO 26:5">nĩguo ndakeyone taarĩ mũndũ mũũgĩ maitho-inĩ make.<verse eid="PRO 26:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 26:6"/>Gũtũma ndũmĩrĩri na guoko kwa mũndũ mũkĩĩgu-rĩ,</para>
  <para style="q2" vid="PRO 26:6">nĩ ta gwĩtinia magũrũ, kana kũnyua haaro.<verse eid="PRO 26:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 26:7"/>O ta magũrũ ma gĩthua ũrĩa mathiiaga maniginĩte,</para>
  <para style="q2" vid="PRO 26:7">noguo thimo ĩhaana ĩkĩario nĩ kanua ka mũndũ mũkĩĩgu.<verse eid="PRO 26:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 26:8"/>Kũhe mũndũ mũkĩĩgu gĩtĩĩo</para>
  <para style="q2" vid="PRO 26:8">no ta kuoherera ihiga kĩgũtha-inĩ.<verse eid="PRO 26:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 26:9"/>Thimo ĩkĩario nĩ kanua ka mũndũ mũkĩĩgu</para>
  <para style="q2" vid="PRO 26:9">nĩ ta mũigua ũrĩ guoko-inĩ kwa mũrĩĩu.<verse eid="PRO 26:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 26:10"/>Mũndũ wandĩkaga mũndũ mũkĩĩgu kana mwĩhĩtũkĩri</para>
  <para style="q2" vid="PRO 26:10">nĩ ta ũrĩa ũikagia mĩguĩ o ro ũguo agatiihia andũ.<verse eid="PRO 26:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 26:11"/>Mũndũ mũkĩĩgu acookagĩra ũrimũ wake</para>
  <para style="q2" vid="PRO 26:11">o ta ũrĩa ngui ĩcookagĩrĩra matahĩko mayo.<verse eid="PRO 26:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 26:12"/>Wanona mũndũ wĩonaga arĩ mũũgĩ maitho-inĩ make?</para>
  <para style="q2" vid="PRO 26:12">Mũndũ mũkĩĩgu arĩ na kĩĩrĩgĩrĩro gũkĩra mũndũ ũcio.<verse eid="PRO 26:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 26:13"/>Kĩgũũta kiugaga atĩrĩ, “Njĩra-inĩ kũrĩ na mũrũũthi,</para>
  <para style="q2" vid="PRO 26:13">mũrũũthi mũrĩĩani ũrorũũra njĩra-inĩ cia itũũra!”<verse eid="PRO 26:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 26:14"/>Ta ũrĩa mũrango ũtindaga ũkĩgarũrũka ihocio-inĩ ciaguo,</para>
  <para style="q2" vid="PRO 26:14">noguo kĩgũũta gĩtindaga gĩkĩĩgarũra gĩkomete ũrĩrĩ-inĩ wakĩo.<verse eid="PRO 26:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 26:15"/>Kĩgũũta gĩikagia guoko gwakĩo o thaani-inĩ;</para>
  <para style="q2" vid="PRO 26:15">kĩnogagio nĩgũcooka gũkuoya gĩgũkinyie kanua-inĩ.<verse eid="PRO 26:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 26:16"/>Kĩgũũta kĩĩonaga kĩrĩ kĩũgĩ maitho-inĩ makĩo,</para>
  <para style="q2" vid="PRO 26:16">gũkĩra andũ mũgwanja arĩa macookagia ũhoro na ũũgĩ.<verse eid="PRO 26:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 26:17"/>Mwĩhĩtũkĩri wĩtoonyagia inegene-inĩ rĩtamũkoniĩ</para>
  <para style="q2" vid="PRO 26:17">no ta mũndũ ũkũnyiita ngui matũ.<verse eid="PRO 26:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 26:18"/>Ta mũgũrũki ũgũikia</para>
  <para style="q2" vid="PRO 26:18">icinga cia mwaki, kana agaikia mĩguĩ ya gĩkuũ,<verse eid="PRO 26:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 26:19"/>no taguo mũndũ ahaana ũrĩa ũheenagia mũndũ wa itũũra rĩake,</para>
  <para style="q2" vid="PRO 26:19">agacooka kũmwĩra atĩrĩ, “Nĩ itherũ nyuma narĩo!”<verse eid="PRO 26:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 26:20"/>Mwaki ũngĩaga ngũ no kũhora ũhoraga;</para>
  <para style="q2" vid="PRO 26:20">ngarari cingĩaga mũhuhu no gũthira ithiraga.<verse eid="PRO 26:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 26:21"/>O ta ũrĩa makara magwatagia marĩa mangĩ mwaki,</para>
  <para style="q2" vid="PRO 26:21">na o ta ũrĩa ngũ ciakanagia mwaki,</para>
  <para style="q2" vid="PRO 26:21">noguo mũndũ mũũgiti aakagĩrĩria haaro.<verse eid="PRO 26:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 26:22"/>Ndeto cia mũndũ wa mũhuhu nĩ ta twenyũ twega twa irio;</para>
  <para style="q2" vid="PRO 26:22">tũmerũkaga tũgathiĩ mwĩrĩ wa mũndũ o thĩinĩ biũ.<verse eid="PRO 26:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 26:23"/>Ta ũrĩa indo cia rĩũmba inyorokagio ikahenia na igũrũ,</para>
  <para style="q2" vid="PRO 26:23">no taguo mĩromo mĩnyoroku ĩhumbagĩra ngoro ĩrĩ na ũũru.<verse eid="PRO 26:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 26:24"/>Mũndũ wa rũmena aaragia ũhinga na mĩromo yake,</para>
  <para style="q2" vid="PRO 26:24">no thĩinĩ wa ngoro yake aiyũrĩtwo no maheeni.<verse eid="PRO 26:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 26:25"/>O na gũtuĩka mĩario yake nĩ ya gũkenania, ndũkanamwĩtĩkie,</para>
  <para style="q2" vid="PRO 26:25">nĩgũkorwo ngoro yake ĩiyũrĩte maũndũ mũgwanja marĩ magigi.<verse eid="PRO 26:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 26:26"/>Rũmena rwake no rũhithwo na maheeni,</para>
  <para style="q2" vid="PRO 26:26">no waganu wake ũkaaguũrio kĩũngano-inĩ.<verse eid="PRO 26:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 26:27"/>Mũndũ angĩenja irima, nĩwe ũkaagũa rĩo;</para>
  <para style="q2" vid="PRO 26:27">mũndũ angĩgaragaria ihiga, rĩkaagaragara rĩmũcookerere.<verse eid="PRO 26:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 26:28"/>Rũrĩmĩ rwa maheeni nĩkũmena rũmenete arĩa rũtuuragia,</para>
  <para style="q2" vid="PRO 26:28">nako kanua ga kwĩyendithĩrĩria karehaga mwanangĩko.<verse eid="PRO 26:28"/></para>
  <para style="b"/>
  <chapter eid="PRO 26"/>
  <chapter number="27" style="c" sid="PRO 27"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 27:1"/>Tiga kwĩraha nĩ ũndũ wa rũciũ,</para>
  <para style="q2" vid="PRO 27:1">nĩgũkorwo ndũũĩ kĩrĩa mũthenya ũngĩrehe.<verse eid="PRO 27:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 27:2"/>Reke mũndũ ũngĩ akũgaathĩrĩrie, no ti kanua gaku mwene;</para>
  <para style="q2" vid="PRO 27:2">mũndũ ũngĩ nĩakũgaathĩrĩrie, no ti mĩromo yaku mwene.<verse eid="PRO 27:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 27:3"/>Ihiga nĩ iritũ na mũthanga nĩ mũrigo,</para>
  <para style="q2" vid="PRO 27:3">no kũrakario nĩ mũndũ mũkĩĩgu nĩ kũritũ gũkĩra icio cierĩ.<verse eid="PRO 27:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 27:4"/>Marakara matirĩ tha, namo marũrũ moinaga ta mũiyũro;</para>
  <para style="q2" vid="PRO 27:4">no ũiru-rĩ, nũũ ũngĩhota kũwĩtiiria?<verse eid="PRO 27:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 27:5"/>Kaba kũrũithio nĩ mũndũ ũtekũhithĩrĩra ũndũ</para>
  <para style="q2" vid="PRO 27:5">gũkĩra wendo mũhithe.<verse eid="PRO 27:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 27:6"/>Nguraro cia gũtihio nĩ mũrata no ciĩhokwo,</para>
  <para style="q2" vid="PRO 27:6">no imumunyano nyingĩ cia mũgũthũũri ti cia kwĩhokwo.<verse eid="PRO 27:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 27:7"/>Mũndũ mũhũũnu athũũraga o na ũũkĩ,</para>
  <para style="q2" vid="PRO 27:7">no mũndũ mũhũũtu, o na kĩndũ kĩrũrũ aiguaga kĩrĩ mũrĩo.<verse eid="PRO 27:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 27:8"/>Mũndũ ũũrĩte gwake mũciĩ</para>
  <para style="q2" vid="PRO 27:8">ahaana ta nyoni ĩtiganĩirie gĩtara kĩayo.<verse eid="PRO 27:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 27:9"/>Maguta manungi wega na ũbumba irehagĩra ngoro ya mũndũ gĩkeno,</para>
  <para style="q2" vid="PRO 27:9">na noguo wega wa mũrata wa mũndũ wĩkaga akĩmũhe ũtaaro wake wa ma.<verse eid="PRO 27:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 27:10"/>Ndũkanateanĩrie mũrata waku kana mũrata wa thoguo,</para>
  <para style="q2" vid="PRO 27:10">na ndũgathiĩ kwa mũrũ wa maitũguo rĩrĩa mũtino wagũkora:</para>
  <para style="q2" vid="PRO 27:10">nĩ kaba mũndũ wa itũũra ũcio ũrĩ hakuhĩ, gũkĩra mũrũ wa nyina na mũndũ ũrĩ kũraya.<verse eid="PRO 27:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 27:11"/>Mũrũ wakwa, tuĩka mũndũ mũũgĩ, ũgĩkenagie ngoro yakwa;</para>
  <para style="q2" vid="PRO 27:11">na niĩ hotage gũcookagĩria mũndũ o wothe ũngĩĩnyarara.<verse eid="PRO 27:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 27:12"/>Mũndũ mũũgĩ oonaga ũgwati ũgĩũka akehitha,</para>
  <para style="q2" vid="PRO 27:12">no arĩa matarĩ ũũgĩ mathiiaga o na mbere, nao magatoonya thĩĩna-inĩ.<verse eid="PRO 27:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 27:13"/>Oya nguo ya mũndũ ũrĩa ũrũgamagĩrĩra thiirĩ wa mũndũ wa kũngĩ;</para>
  <para style="q2" vid="PRO 27:13">mĩige ĩrũgamĩrĩre thiirĩ ũcio wa mũndũ-wa-nja wa kũngĩ.<verse eid="PRO 27:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 27:14"/>Mũndũ angĩrathima mũndũ wa itũũra rĩake rũciinĩ tene anĩrĩire-rĩ,</para>
  <para style="q2" vid="PRO 27:14">ũndũ ũcio ũngĩtuĩka taarĩ kĩrumi.<verse eid="PRO 27:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 27:15"/>Mũtumia wa haaro ahaanaine</para>
  <para style="q2" vid="PRO 27:15">na maaĩ maratata mategũtigithĩria hĩndĩ ya mbura;<verse eid="PRO 27:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 27:16"/>kũgeria kũmũgirĩrĩria nĩ ta kũgeria kũgirĩrĩria rũhuho,</para>
  <para style="q2" vid="PRO 27:16">kana kũgeria gũkumbatĩria maguta na guoko.<verse eid="PRO 27:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 27:17"/>O ta ũrĩa kĩgera kĩnooraga kĩrĩa kĩngĩ,</para>
  <para style="q2" vid="PRO 27:17">no taguo mũndũ ohĩgagia ũrĩa ũngĩ.<verse eid="PRO 27:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 27:18"/>Mũndũ ũrĩa ũrĩmagĩra mũkũyũ nĩakaarĩa maciaro maguo,</para>
  <para style="q2" vid="PRO 27:18">na mũndũ ũrĩa ũtungataga mwathi wake nĩagatĩĩo.<verse eid="PRO 27:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 27:19"/>O ta ũrĩa mũndũ onaga ũthiũ wake maaĩ-inĩ,</para>
  <para style="q2" vid="PRO 27:19">no taguo ngoro ya mũndũ yonanagia ũrĩa mũndũ atariĩ.<verse eid="PRO 27:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 27:20"/>Gĩkuũ na Mwanangĩko itiiganagia,</para>
  <para style="q2" vid="PRO 27:20">na o namo maitho ma mũndũ matiiganagia.<verse eid="PRO 27:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 27:21"/>Nyũngũ nĩ ya gũthererio betha, na kĩrugutĩro nĩ gĩa gũthererio thahabu,</para>
  <para style="q2" vid="PRO 27:21">no mũndũ athimagwo na igweta rĩrĩa agwetagwo narĩo.<verse eid="PRO 27:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 27:22"/>O na ũngĩhũũrĩra mũndũ mũkĩĩgu ndĩrĩ-inĩ,</para>
  <para style="q2" vid="PRO 27:22">ũmũhũũre na mũũthĩ ta ngano-rĩ,</para>
  <para style="q2" vid="PRO 27:22">ndangiumwo nĩ ũrimũ wake.<verse eid="PRO 27:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 27:23"/>Thũũrimaga mahiũ maku na kĩyo,</para>
  <para style="q2" vid="PRO 27:23">ũmenyagĩrĩre wega ndũũru ciaku;<verse eid="PRO 27:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 27:24"/>nĩgũkorwo ũtonga ndũtũũraga nginya tene,</para>
  <para style="q2" vid="PRO 27:24">o nayo thũmbĩ ti ya gũkinyĩra njiarwa na njiarwa.<verse eid="PRO 27:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 27:25"/>Nyeki ĩrĩa nyũmũ rĩrĩa yatũgũtwo na nyeki njerũ ĩkunũke-rĩ,</para>
  <para style="q2" vid="PRO 27:25">nayo ĩrĩa ya irĩma-inĩ yũnganio na ĩinũkio-rĩ,<verse eid="PRO 27:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 27:26"/>hĩndĩ ĩyo tũgondu nĩtũgaatũma ũgĩe na nguo,</para>
  <para style="q2" vid="PRO 27:26">nacio mbũri itũme ũgĩe na gĩa kũgũra mũgũnda.<verse eid="PRO 27:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 27:27"/>Nĩũkagĩa na iria rĩingĩ rĩa mbũri</para>
  <para style="q2" vid="PRO 27:27">rĩa gũkũigana na rĩa kũnyuuo nĩ andũ a nyũmba yaku,</para>
  <para style="q2" vid="PRO 27:27">o na rĩa gũtũũria airĩtu aku a wĩra.<verse eid="PRO 27:27"/></para>
  <para style="b"/>
  <chapter eid="PRO 27"/>
  <chapter number="28" style="c" sid="PRO 28"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 28:1"/>Andũ arĩa aaganu moraga o na gũtarĩ mũndũ ũramathingata,</para>
  <para style="q1" vid="PRO 28:1">no arĩa athingu momagĩrĩria ta mũrũũthi.<verse eid="PRO 28:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 28:2"/>Bũrũri ũngĩĩhia, nĩũgĩaga na aathani aingĩ,</para>
  <para style="q2" vid="PRO 28:2">no mũndũ ũrĩ na ũtaũku na akagĩa na ũmenyo nĩatũmaga bũrũri ũkindĩrie.<verse eid="PRO 28:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 28:3"/>Mwathani ũrĩa ũhatagĩrĩria andũ arĩa athĩĩni</para>
  <para style="q2" vid="PRO 28:3">ahaana ta mbura ya rũhuho ĩrĩa ĩtatigagia irio.<verse eid="PRO 28:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 28:4"/>Andũ arĩa matirikaga watho magaathagĩrĩria andũ arĩa aaganu,</para>
  <para style="q2" vid="PRO 28:4">no arĩa marũmagia watho magianaga nao.<verse eid="PRO 28:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 28:5"/>Andũ arĩa ooru matiiguaga maũndũ ma kĩhooto,</para>
  <para style="q2" vid="PRO 28:5">no arĩa marongoragia Jehova nĩmataũkagĩrwo nĩ mo biũ.<verse eid="PRO 28:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 28:6"/>Nĩ kaba mũndũ mũthĩĩni ũrĩa ũthiiaga na mĩthiĩre ĩtarĩ ũcuuke,</para>
  <para style="q2" vid="PRO 28:6">gũkĩra gĩtonga gĩthiiaga na mĩthiĩre mĩogomu.<verse eid="PRO 28:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 28:7"/>Mũndũ ũrĩa ũrũmagia watho nĩ mwana ũrĩ na gũkũũrana,</para>
  <para style="q2" vid="PRO 28:7">no mwana ũrĩa ũthiiaga na thiritũ ya arĩa akoroku aconorithagia ithe.<verse eid="PRO 28:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 28:8"/>Mũndũ ũrĩa ũingĩhagia ũtonga wake na ũndũ wa gũkombithia mbeeca na gwĩtia uumithio mũkĩru</para>
  <para style="q2" vid="PRO 28:8">aũigagĩra mũndũ ũngĩ, ũrĩa ũkaiguĩra athĩĩni tha.<verse eid="PRO 28:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 28:9"/>Mũndũ ũrĩa ũregaga kũigua watho,</para>
  <para style="q2" vid="PRO 28:9">o na mahooya make nĩ kĩndũ kĩrĩ magigi.<verse eid="PRO 28:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 28:10"/>Mũndũ ũrĩa ũngĩhĩtithia andũ arĩa arũngĩrĩru nĩguo magere njĩra ya ũũru,</para>
  <para style="q2" vid="PRO 28:10">akaagũa mũtego-inĩ wake we mwene,</para>
  <para style="q2" vid="PRO 28:10">no ũrĩa ũtarĩ ũcuuke, wega nĩguo ũgaatuĩka igai rĩake.<verse eid="PRO 28:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 28:11"/>Mũndũ mũtongu no eyone taarĩ mũũgĩ maitho-inĩ make,</para>
  <para style="q2" vid="PRO 28:11">no mũndũ mũthĩĩni ũrĩa ũũĩ gũkũũrana maũndũ amuonaga o ũrĩa atariĩ.<verse eid="PRO 28:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 28:12"/>Hĩndĩ ĩrĩa arĩa athingu maatoorania, nĩkũgĩaga na ndũhiũ nene;</para>
  <para style="q2" vid="PRO 28:12">no rĩrĩa arĩa aaganu maatũũgĩra, andũ nĩ kwĩhitha mehithaga.<verse eid="PRO 28:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 28:13"/>Mũndũ ũrĩa ũhithaga mehia make ndagaacagĩra,</para>
  <para style="q2" vid="PRO 28:13">no ũrĩa ũmoimbũraga na agatigana namo nĩaiguagĩrwo tha.<verse eid="PRO 28:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 28:14"/>Kũrathimwo nĩ mũndũ ũrĩa wĩtigagĩra Jehova hĩndĩ ciothe,</para>
  <para style="q2" vid="PRO 28:14">no ũrĩa ũmagia ngoro yake nĩkũgũa agũũaga thĩĩna-inĩ.<verse eid="PRO 28:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 28:15"/>Mũndũ mwaganu agĩatha andũ matarĩ na ũhoti,</para>
  <para style="q2" vid="PRO 28:15">nĩ ta mũrũũthi ũkũrarama, kana nduba ĩgũticũka.<verse eid="PRO 28:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 28:16"/>Mũnene ũtarĩ na ũtaũku nĩahinyagĩrĩria andũ mũno,</para>
  <para style="q2" vid="PRO 28:16">no mũndũ ũrĩa ũthũire uumithio ũtagĩrĩire</para>
  <para style="q2" vid="PRO 28:16">nĩagakenera matukũ maingĩ ma muoyo wake.<verse eid="PRO 28:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 28:17"/>Mũndũ mũritũhĩre nĩ thakame ya mũndũ ooragĩte,</para>
  <para style="q2" vid="PRO 28:17">egũtũũra ehithaga nginya gũkua gwake;</para>
  <para style="q2" vid="PRO 28:17">mũndũ o na ũrĩkũ ndakanamũteithĩrĩrie.<verse eid="PRO 28:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 28:18"/>Mũndũ ũrĩa mĩthiĩre yake ĩtarĩ ũcuuke aikaraga arĩ mũgitĩre,</para>
  <para style="q2" vid="PRO 28:18">no mũndũ ũrĩa ũthiiaga na njĩra cia waganu akaagũa o rĩmwe, hubu!<verse eid="PRO 28:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 28:19"/>Mũndũ ũrĩa ũrĩmaga mũgũnda wake arĩĩkoragwo na irio nyingĩ,</para>
  <para style="q2" vid="PRO 28:19">no ũrĩa ũhanyũkanagia na maũndũ hatarĩ arĩhũũnaga o thĩĩna.<verse eid="PRO 28:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 28:20"/>Mũndũ mwĩhokeku arĩrathimagwo mũno,</para>
  <para style="q2" vid="PRO 28:20">no ũrĩa wĩriragĩria kũhiũha gũtonga ndakaaga kũherithio.<verse eid="PRO 28:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 28:21"/>Gũtĩĩra mũndũ maũthĩ ti wega:</para>
  <para style="q2" vid="PRO 28:21">no mũndũ no eke ũũru nĩ ũndũ wa kenyũ ka irio.<verse eid="PRO 28:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 28:22"/>Mũndũ mũkarĩ nĩeriragĩria mũno gũtonga,</para>
  <para style="q2" vid="PRO 28:22">na ndooĩ atĩ etereirwo nĩ ũthĩĩni.<verse eid="PRO 28:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 28:23"/>Mũndũ ũrĩa ũrũithagia ũngĩ nĩagatuĩka wa kwendwo nĩwe thuutha-inĩ,</para>
  <para style="q2" vid="PRO 28:23">gũkĩra mũndũ wa rũrĩmĩ rwa kwĩyendithĩrĩria.<verse eid="PRO 28:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 28:24"/>Mũndũ ũrĩa ũtunyaga ithe kana nyina kĩndũ kĩao,</para>
  <para style="q2" vid="PRO 28:24">agacooka akoiga atĩrĩ, “Ti ũũru ndeka,”</para>
  <para style="q2" vid="PRO 28:24">ũcio marĩ rũmwe na ũrĩa wanangaga.<verse eid="PRO 28:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 28:25"/>Mũndũ mũkoroku aarahũraga ngarari,</para>
  <para style="q2" vid="PRO 28:25">no mũndũ wĩhokete Jehova nĩakagaacĩra.<verse eid="PRO 28:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 28:26"/>Mũndũ ũrĩa wĩĩhokaga we mwene nĩ mũndũ mũkĩĩgu,</para>
  <para style="q2" vid="PRO 28:26">no ũrĩa ũthiiaga na njĩra cia ũũgĩ aikaraga arĩ mũgitĩre.<verse eid="PRO 28:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 28:27"/>Mũndũ ũrĩa ũheaga athĩĩni ndarĩ kĩndũ akaaga,</para>
  <para style="q2" vid="PRO 28:27">no mũndũ ũrĩa ũmahingagĩra maitho nĩarĩĩrumagwo kaingĩ.<verse eid="PRO 28:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 28:28"/>Rĩrĩa andũ arĩa aaganu maatuĩka a gwathana, andũ nĩ kwĩhitha mehithaga;</para>
  <para style="q2" vid="PRO 28:28">no rĩrĩa arĩa aaganu mathira, arĩa athingu nĩmatheeremaga.<verse eid="PRO 28:28"/></para>
  <para style="b"/>
  <chapter eid="PRO 28"/>
  <chapter number="29" style="c" sid="PRO 29"/>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 29:1"/>Mũndũ ũrĩa ũikaraga omĩtie ngingo thuutha wa kũrũithio maita maingĩ,</para>
  <para style="q2" vid="PRO 29:1">akaanangwo o rĩmwe, na aage kĩhonia.<verse eid="PRO 29:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 29:2"/>Rĩrĩa andũ arĩa athingu matheerema, andũ nĩmakenaga;</para>
  <para style="q2" vid="PRO 29:2">no rĩrĩa andũ arĩa aaganu maathana, andũ nĩgũcaaya macaayaga.<verse eid="PRO 29:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 29:3"/>Mũndũ ũrĩa wendete ũũgĩ atũũragia ithe na gĩkeno,</para>
  <para style="q2" vid="PRO 29:3">no mũndũ ũrĩa ũceeraga na maraya nĩgũitanga aitangaga ũtonga wake.<verse eid="PRO 29:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 29:4"/>Mũthamaki ũrĩ matuĩro ma kĩhooto aikaragia bũrũri ũrĩ mwĩkindĩru,</para>
  <para style="q2" vid="PRO 29:4">no ũrĩa ũkorokagĩra mahaki nĩ kwananga awanangaga.<verse eid="PRO 29:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 29:5"/>Mũndũ ũrĩa wĩyendithagĩrĩria harĩ mũndũ wa itũũra rĩake na maheeni,</para>
  <para style="q2" vid="PRO 29:5">nĩ wabu aambagĩra magũrũ make.<verse eid="PRO 29:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 29:6"/>Mũndũ mwaganu ategagwo nĩ mehia make we mwene,</para>
  <para style="q2" vid="PRO 29:6">no mũndũ mũthingu ainaga na agakena.<verse eid="PRO 29:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 29:7"/>Andũ arĩa athingu nĩmamenyagĩrĩra kĩhooto kĩa arĩa athĩĩni,</para>
  <para style="q2" vid="PRO 29:7">no arĩa aaganu matirũmbũyagia kĩhooto kĩao.<verse eid="PRO 29:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 29:8"/>Anyũrũrania matũmaga itũũra inene rĩrĩmbũke ta mwaki,</para>
  <para style="q2" vid="PRO 29:8">no andũ oogĩ nĩkũniina maniinaga marakara.<verse eid="PRO 29:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 29:9"/>Mũndũ mũũgĩ angĩthiĩ igooti-inĩ na mũndũ mũkĩĩgu,</para>
  <para style="q2" vid="PRO 29:9">mũndũ mũkĩĩgu arĩrĩmbũkaga nĩ marakara na akanyũrũrania, naguo thayũ ũkaaga.<verse eid="PRO 29:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 29:10"/>Andũ arĩa maitaga thakame nĩmathũire mũndũ mwĩhokeku,</para>
  <para style="q2" vid="PRO 29:10">no andũ arĩa arũngĩrĩru macaragia ũrĩa mangĩtiirĩrĩra muoyo wake.<verse eid="PRO 29:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 29:11"/>Mũndũ mũkĩĩgu aitũrũraga marakara make mothe,</para>
  <para style="q2" vid="PRO 29:11">no mũndũ mũũgĩ aikaraga amarigĩrĩirie, akahoorera.<verse eid="PRO 29:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 29:12"/>Mũndũ ũrĩa wathanaga angĩthikĩrĩria maheeni-rĩ,</para>
  <para style="q2" vid="PRO 29:12">anene ake othe matuĩkaga andũ aaganu.<verse eid="PRO 29:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 29:13"/>Mũndũ mũthĩĩni na mũndũ mũhinyanĩrĩria harĩ ũndũ ũmwe ũmahaananĩtie:</para>
  <para style="q2" vid="PRO 29:13">Jehova nĩwe ũtũmaga maitho mao eerĩ moone.<verse eid="PRO 29:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 29:14"/>Mũthamaki angĩtuĩra athĩĩni ciira na kĩhooto-rĩ,</para>
  <para style="q2" vid="PRO 29:14">gĩtĩ gĩake kĩa ũnene gĩtũũraga kĩrũmĩte nginya tene.<verse eid="PRO 29:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 29:15"/>Rũthanju na kũrũithio ciĩkagĩra mũndũ ũũgĩ,</para>
  <para style="q2" vid="PRO 29:15">no mwana wa kũrekererio aconorithagia nyina.<verse eid="PRO 29:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 29:16"/>Hĩndĩ ĩrĩa andũ aaganu matheerema, noguo mehia matheeremaga,</para>
  <para style="q2" vid="PRO 29:16">no andũ arĩa athingu nĩmakerorera igwa rĩao.<verse eid="PRO 29:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 29:17"/>Herithagia mũrũguo, na nĩagatũma ũgĩe na thayũ;</para>
  <para style="q2" vid="PRO 29:17">nĩagatũma ũgĩe na gĩkeno ngoro-inĩ.<verse eid="PRO 29:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 29:18"/>Kũrĩa gũtarĩ na ũguũrio, kĩrĩndĩ gĩticookaga kwĩrigĩrĩria;</para>
  <para style="q2" vid="PRO 29:18">no gũkena nĩ mũndũ ũrĩa ũrũmagia watho.<verse eid="PRO 29:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 29:19"/>Ndungata ndĩngĩhera nĩ kwarĩrio gũtheri;</para>
  <para style="q2" vid="PRO 29:19">o na ĩngĩtaũkĩrwo nĩ ũhoro ndĩngĩũrũmbũiya.<verse eid="PRO 29:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 29:20"/>Wanona mũndũ ũhiũhaga kwaria?</para>
  <para style="q2" vid="PRO 29:20">Mũndũ mũkĩĩgu arĩ na kĩĩrĩgĩrĩro kũmũkĩra.<verse eid="PRO 29:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 29:21"/>Mũndũ angĩnania ndungata yake kuuma wĩthĩ wayo,</para>
  <para style="q2" vid="PRO 29:21">marigĩrĩrio-inĩ nĩĩkamũrehera kĩeha.<verse eid="PRO 29:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 29:22"/>Mũndũ wa marakara aarahũraga ngarari,</para>
  <para style="q2" vid="PRO 29:22">nake mũndũ wa marũrũ agĩĩaga na mehia maingĩ.<verse eid="PRO 29:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 29:23"/>Mwĩtĩĩo wa mũndũ nĩũmũnyiihagia,</para>
  <para style="q2" vid="PRO 29:23">no mũndũ ũrĩa wa ngoro ya kwĩnyiihia nĩagatĩĩo.<verse eid="PRO 29:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 29:24"/>Mũndũ wa kũgĩa thiritũ na mũici nĩ muoyo wake mwene athũire;</para>
  <para style="q2" vid="PRO 29:24">ehĩtithagio na ndangĩruta ũira.<verse eid="PRO 29:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 29:25"/>Gwĩtigĩra mũndũ gũtuĩkaga mũtego,</para>
  <para style="q2" vid="PRO 29:25">no ũrĩa wĩhokaga Jehova aikaraga arĩ mũgitĩre.<verse eid="PRO 29:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 29:26"/>Andũ aingĩ nĩmacaragia kũiguuo nĩ mũnene,</para>
  <para style="q2" vid="PRO 29:26">no mũndũ oonaga kĩhooto kuuma kũrĩ Jehova.<verse eid="PRO 29:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 29:27"/>Andũ arĩa athingu monaga andũ arĩa matarĩ ehokeku ta kĩndũ kĩrĩ magigi;</para>
  <para style="q2" vid="PRO 29:27">nao andũ arĩa aaganu moonaga andũ arĩa arũngĩrĩru ta kĩndũ kĩrĩ magigi.<verse eid="PRO 29:27"/></para>
  <chapter eid="PRO 29"/>
  <chapter number="30" style="c" sid="PRO 30"/>
  <para style="s1">Mĩario ya Aguri</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 30:1"/>Ĩno nĩyo mĩario ya Aguri mũrũ wa Jake, na nĩ ndũmĩrĩri nditũ:</para>
  <para style="q1" vid="PRO 30:1">Mũndũ ũcio eerire Ithieli,</para>
  <para style="q2" vid="PRO 30:1">akĩĩra Ithieli na Ukali atĩrĩ:<verse eid="PRO 30:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 30:2"/>“Niĩ ndĩ mũndũ mũriitu gũkĩra andũ arĩa angĩ;</para>
  <para style="q2" vid="PRO 30:2">ndirĩ na ũtaũku ta wa mũndũ.<verse eid="PRO 30:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 30:3"/>Ndiĩrutĩte kũgĩa na ũũgĩ,</para>
  <para style="q2" vid="PRO 30:3">o na kana ngamenya Ũrĩa Mũtheru.<verse eid="PRO 30:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 30:4"/>Nũũ wanambata igũrũ na agacooka agaikũrũka gũkũ thĩ?</para>
  <para style="q2" vid="PRO 30:4">Nũũ wanacookereria rũhuho ngundi-inĩ ciake?</para>
  <para style="q1" vid="PRO 30:4">Maaĩ namo-rĩ, nũũ ũrĩ wamoohania na nguo yake ya igũrũ?</para>
  <para style="q2" vid="PRO 30:4">Nũũ wahaandire ituri ciothe cia thĩ?</para>
  <para style="q1" vid="PRO 30:4">Etagwo atĩa, nake mũriũ etagwo atĩa?</para>
  <para style="q2" vid="PRO 30:4">Akorwo nĩũũĩ-rĩ, ndũkĩnjĩĩre!<verse eid="PRO 30:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 30:5"/>“Kiugo gĩothe kĩa Ngai gĩtirĩ mahĩtia;</para>
  <para style="q2" vid="PRO 30:5">nĩwe ngo ya arĩa moragĩra harĩ we.<verse eid="PRO 30:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 30:6"/>Ndũkanongerere ciugo ciake,</para>
  <para style="q2" vid="PRO 30:6">ndakae gũkũrũithia wonekane ũrĩ wa maheeni.<verse eid="PRO 30:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 30:7"/>“Nĩngũkũhooya maũndũ meerĩ, Wee Jehova;</para>
  <para style="q2" vid="PRO 30:7">ndũkanarege kũhe mo mbere ya ngue:<verse eid="PRO 30:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 30:8"/>Atĩrĩrĩ, njehereria maũndũ matarĩ ma ma, na ma maheeni, cindaihĩrĩrie mũno;</para>
  <para style="q2" vid="PRO 30:8">ningĩ ndũkaahe ũthĩĩni kana ũtonga,</para>
  <para style="q2" vid="PRO 30:8">no ũũheage irio cia o mũthenya.<verse eid="PRO 30:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 30:9"/>Ndikaagĩe na indo nyingĩ mũno, ngũkaane,</para>
  <para style="q2" vid="PRO 30:9">njũũrie atĩrĩ, ‘Jehova nũũ?’</para>
  <para style="q1" vid="PRO 30:9">Kana thĩĩne mũno, njiye,</para>
  <para style="q2" vid="PRO 30:9">na nĩ ũndũ ũcio ngĩmenererie rĩĩtwa rĩa Ngai wakwa.<verse eid="PRO 30:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 30:10"/>“Ndũgacambie ndungata kũrĩ mũnene wayo,</para>
  <para style="q2" vid="PRO 30:10">ndĩgagĩkũrume, nawe ũrĩhio ũũru ũcio.<verse eid="PRO 30:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 30:11"/>“Nĩ kũrĩ andũ marumaga maithe mao</para>
  <para style="q2" vid="PRO 30:11">o na matangĩrathima manyina mao;<verse eid="PRO 30:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 30:12"/>kũrĩ andũ arĩa meyonaga marĩ atheru maitho-inĩ mao,</para>
  <para style="q2" vid="PRO 30:12">o rĩrĩa matathambĩtio gĩko kĩao;<verse eid="PRO 30:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 30:13"/>nĩ arĩa marĩ maitho ma mwĩtĩĩo,</para>
  <para style="q2" vid="PRO 30:13">o arĩa maroraga andũ manyiira;<verse eid="PRO 30:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 30:14"/>nĩo arĩa magego mao mahaana ta hiũ cia njora,</para>
  <para style="q2" vid="PRO 30:14">na ngambucu ciao ihaana ta tũhiũ</para>
  <para style="q1" vid="PRO 30:14">twa gũtambuura arĩa athĩĩni, mahuke thĩ,</para>
  <para style="q2" vid="PRO 30:14">na arĩa abatari, mathire andũ-inĩ.<verse eid="PRO 30:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 30:15"/>“Thambara ĩrĩ airĩtu eerĩ.</para>
  <para style="q2" vid="PRO 30:15">Matitigithagĩria kuuga, ‘Tũhei! Tũhei!’</para>
  <para style="b" vid="PRO 30:15"/>
  <para style="q1" vid="PRO 30:15">“Kũrĩ indo ithatũ itarĩ hĩndĩ ihũũnaga,</para>
  <para style="q2" vid="PRO 30:15">o na nĩ inya itarĩ hĩndĩ ingiuga, ‘Nĩndaigania!’<verse eid="PRO 30:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 30:16"/>Nacio nĩ mbĩrĩra, na nda thaata,</para>
  <para style="q2" vid="PRO 30:16">na thĩ tondũ ndĩrĩ hĩndĩ ĩiganagia maaĩ,</para>
  <para style="q2" vid="PRO 30:16">na mwaki tondũ ndũrĩ hĩndĩ uugaga, ‘Nĩndaigania!’<verse eid="PRO 30:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 30:17"/>“Riitho rĩa mũndũ ũrĩa ũnyũrũragia ithe,</para>
  <para style="q2" vid="PRO 30:17">na akarurũka kũiguaga nyina,</para>
  <para style="q1" vid="PRO 30:17">rĩgaakũũrwo nĩ mahuru ma kĩanda-inĩ,</para>
  <para style="q2" vid="PRO 30:17">na rĩkaarĩĩo nĩ nderi.<verse eid="PRO 30:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 30:18"/>“Kũrĩ maũndũ matatũ mangegagia mũno makĩria,</para>
  <para style="q2" vid="PRO 30:18">o na nĩ mana marĩa niĩ itakuũkagĩrwo nĩmo:<verse eid="PRO 30:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 30:19"/>namo nĩ mũthiĩre wa nderi rĩera-inĩ,</para>
  <para style="q2" vid="PRO 30:19">na mũthiĩre wa nyoka rwaro-inĩ rwa ihiga,</para>
  <para style="q1" vid="PRO 30:19">na mũthiĩre wa marikabu ĩrĩ iria-inĩ gatagatĩ,</para>
  <para style="q2" vid="PRO 30:19">na mũthiĩre wa mũndũ makĩendana na mũirĩtu.<verse eid="PRO 30:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 30:20"/>“Ũyũ nĩguo mũthiĩre wa mũndũ-wa-nja mũtharia:</para>
  <para style="q2" vid="PRO 30:20">Arĩĩaga na akehuura mĩromo,</para>
  <para style="q2" vid="PRO 30:20">akoiga atĩrĩ, ‘Ndirĩ ũndũ mũũru njĩkĩte.’<verse eid="PRO 30:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 30:21"/>“Kũrĩ maũndũ matatũ matũmaga thĩ ĩthingithe,</para>
  <para style="q2" vid="PRO 30:21">o na nĩ mana ĩtangĩĩtiiria:<verse eid="PRO 30:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 30:22"/>namo nĩ ndungata ĩtuĩkĩte mũthamaki,</para>
  <para style="q2" vid="PRO 30:22">na mũndũ mũkĩĩgu ahũũnĩte irio,<verse eid="PRO 30:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 30:23"/>na mũndũ-wa-nja ũtangĩendeka ahikĩte,</para>
  <para style="q2" vid="PRO 30:23">na ndungata ya mũirĩtu ĩtuĩkĩte mũtumia wa mũthuuri wa mũmĩathi.<verse eid="PRO 30:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 30:24"/>“Nĩ kũrĩ nyamũ inya nini gũkũ thĩ,</para>
  <para style="q2" vid="PRO 30:24">no nĩ njũgĩ mũno:<verse eid="PRO 30:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 30:25"/>Thigiriri-rĩ, nĩ ciũmbe itarĩ hinya,</para>
  <para style="q2" vid="PRO 30:25">no nĩciĩigagĩra mũthiithũ wa irio hĩndĩ ya riũa;<verse eid="PRO 30:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 30:26"/>ikami nĩ ciũmbe itarĩ ũhoti,</para>
  <para style="q2" vid="PRO 30:26">no nĩciĩthondekagĩra ciikaro ciacio ndwaro-inĩ cia mahiga;<note caller="+" style="f"><char style="fr" closed="false">30:26 </char><char style="ft" closed="false">Ikami nĩ mũthemba wa mbũkũ ciikaraga marima-inĩ ma irĩma irĩ ikundi.</char></note><verse eid="PRO 30:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 30:27"/>ngigĩ itirĩ mũthamaki wacio,</para>
  <para style="q2" vid="PRO 30:27">no nĩitwaranaga hamwe irĩ mbũtũ;<verse eid="PRO 30:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 30:28"/>njagathi no inyiitwo na rũhĩ,</para>
  <para style="q2" vid="PRO 30:28">no ĩtũũraga thĩinĩ wa nyũmba cia athamaki.<verse eid="PRO 30:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 30:29"/>“Kũrĩ indo ithatũ irĩ mũkinyũkĩrie mũgaacĩru,</para>
  <para style="q2" vid="PRO 30:29">o na nĩ inya ngaacĩru rĩrĩa igũthiĩ:<verse eid="PRO 30:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 30:30"/>nĩ mũrũũthi, arĩ guo ũrĩ hinya mũno gatagatĩ ka nyamũ iria ingĩ ciothe,</para>
  <para style="q2" vid="PRO 30:30">na ndũngĩeherera nyamũ ĩrĩkũ kana ĩrĩkũ njĩra;<verse eid="PRO 30:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 30:31"/>nĩ njamba ya ngũkũ ĩrĩa ĩkinyũkagia na nguthi, na thenge,</para>
  <para style="q2" vid="PRO 30:31">na mũthamaki mũthiũrũrũkĩrie nĩ mbũtũ ciake cia ita.<verse eid="PRO 30:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 30:32"/>“Angĩkorwo nĩwĩtuĩte mũndũ mũkĩĩgu, na ũgetũũgĩria,</para>
  <para style="q2" vid="PRO 30:32">kana ũkorwo nĩũthugundĩte gwĩka ũũru-rĩ,</para>
  <para style="q2" vid="PRO 30:32">humbĩra kanua gaku na rũhĩ!<verse eid="PRO 30:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 30:33"/>Nĩgũkorwo o ta ũrĩa iria rĩthũcagwo, rĩkoima thiagĩ,</para>
  <para style="q2" vid="PRO 30:33">na o ta ũrĩa iniũrũ rĩthioragwo rĩkoira thakame-rĩ,</para>
  <para style="q2" vid="PRO 30:33">ũguo noguo gũthogotha marakara kũrehaga ngũĩ.”<verse eid="PRO 30:33"/></para>
  <chapter eid="PRO 30"/>
  <chapter number="31" style="c" sid="PRO 31"/>
  <para style="s1">Mĩario ya Mũthamaki Lemueli</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 31:1"/>Ĩno nĩyo mĩario ya Mũthamaki Lemueli: nĩ ndũmĩrĩri nditũ ĩrĩa aarutirwo nĩ nyina:<verse eid="PRO 31:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 31:2"/>“Atĩrĩrĩ, wee mũrũ wakwa, ngũkwĩra atĩa, o wee mwana wa nda yakwa,</para>
  <para style="q2" vid="PRO 31:2">ngũkwĩra atĩa o wee mwana wa mĩĩhĩtwa yakwa,<verse eid="PRO 31:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 31:3"/>atĩrĩ, ndũkanaitange hinya waku na andũ-a-nja,</para>
  <para style="q2" vid="PRO 31:3">kana ũhe ũhoti waku acio manangaga athamaki.<note caller="+" style="f"><char style="fr" closed="false">31:3 </char><char style="ft" closed="false">Nyũmba ya ũthamaki nĩyakoragwo na andũ-a-nja aingĩ mũno arĩa rĩmwe na rĩmwe monũhaga athamaki.</char></note><verse eid="PRO 31:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 31:4"/>“Atĩrĩrĩ, wee Lemueli, athamaki matiagĩrĩirwo nĩkũnyua ndibei,</para>
  <para style="q2" vid="PRO 31:4">ti mũtugo wa athamaki kũnyua ndibei,</para>
  <para style="q2" vid="PRO 31:4">anene matiagĩrĩirwo nĩ kwĩrirĩria njoohi,<verse eid="PRO 31:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 31:5"/>nĩgeetha matikanyue mariganĩrwo nĩ ũrĩa watho uugaga,</para>
  <para style="q2" vid="PRO 31:5">nao magithie arĩa othe ahinyĩrĩrie kĩhooto kĩao.<verse eid="PRO 31:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 31:6"/>Heaga arĩa marathira njoohi,</para>
  <para style="q2" vid="PRO 31:6">na ndibei kũrĩ arĩa marĩ na ruo rũnene rwa ngoro;<verse eid="PRO 31:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 31:7"/>reke manyue mariganĩrwo nĩ ũthĩĩni wao,</para>
  <para style="q2" vid="PRO 31:7">na matige gũcooka kũririkana kĩeha kĩao.<verse eid="PRO 31:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 31:8"/>“Arĩrĩria arĩa matangĩhota kwĩyarĩrĩria,</para>
  <para style="q2" vid="PRO 31:8">warĩrĩrie kĩhooto kĩa arĩa othe anyamaarĩku.<verse eid="PRO 31:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 31:9"/>Maarĩrĩrie, na ũmatuĩre ciira na kĩhooto;</para>
  <para style="q2" vid="PRO 31:9">rũĩrĩra kĩhooto kĩa arĩa athĩĩni na arĩa abatari.”<verse eid="PRO 31:9"/></para>
  <para style="s1">Ciugo cia Kũrigĩrĩria: Mũtumia ũrĩa Ngatha</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 31:10"/>Mũtumia ngatha-rĩ, angĩoneka kũ?</para>
  <para style="q2" vid="PRO 31:10">Nĩgũkorwo thogora wake nĩũkĩrĩte mũno ũrĩa wa ruru iria ndune.<verse eid="PRO 31:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 31:11"/>Mũthuuri wake nĩamwĩhokete biũ,</para>
  <para style="q2" vid="PRO 31:11">na ndarĩ kĩndũ kĩa bata angĩaga.<verse eid="PRO 31:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 31:12"/>Mũtumia ũcio, matukũ mothe ma muoyo wake,</para>
  <para style="q2" vid="PRO 31:12">no maũndũ mega ekaga mũthuuriwe,</para>
  <para style="q2" vid="PRO 31:12">na ndangĩmwĩka ũũru.<verse eid="PRO 31:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 31:13"/>Ethaga guoya wa ngʼondu na ndigi cia ũguta,</para>
  <para style="q2" vid="PRO 31:13">agacirutĩra wĩra na kĩyo, na moko make.<verse eid="PRO 31:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 31:14"/>Ahaana ta marikabu cia wonjoria,</para>
  <para style="q2" vid="PRO 31:14">tondũ athũgũraga irio ciake kuuma kũraya.<verse eid="PRO 31:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 31:15"/>Okĩraga rũciinĩ kũrĩ o na nduma;</para>
  <para style="q2" vid="PRO 31:15">akahe andũ a nyũmba yake irio,</para>
  <para style="q2" vid="PRO 31:15">na akagaĩra ndungata ciake cia airĩtu mawĩra mao.<verse eid="PRO 31:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 31:16"/>Ecũũranagia ũhoro wa mũgũnda mũna, akaũgũra;</para>
  <para style="q2" vid="PRO 31:16">kuumana na ũthũkũmi wake, ahaandaga mũgũnda wa mĩthabibũ.<verse eid="PRO 31:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 31:17"/>Ehotoragĩra wĩra wake erutanĩirie;</para>
  <para style="q2" vid="PRO 31:17">moko make marĩ hinya wa kwĩrutĩra wĩra.<verse eid="PRO 31:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 31:18"/>Nĩatigagĩrĩra atĩ wonjoria wake nĩũrĩ na uumithio,</para>
  <para style="q2" vid="PRO 31:18">naguo tawa wake ũraaraga ũgĩakana.<verse eid="PRO 31:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 31:19"/>Anyiitaga mũtĩ wa kuogotha ndigi na guoko,</para>
  <para style="q2" vid="PRO 31:19">nakĩo gĩcũni kĩa ndigi agakĩnyiitĩrĩra na ciara ciake.<verse eid="PRO 31:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 31:20"/>Nĩataanahagĩra andũ arĩa athĩĩni,</para>
  <para style="q2" vid="PRO 31:20">nao arĩa abatari akamatambũrũkĩria moko make.<verse eid="PRO 31:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 31:21"/>Rĩrĩa tharunji yagũa-rĩ, we ndamakaga atĩ nĩĩgũthĩĩnia andũ a nyũmba yake;</para>
  <para style="q2" vid="PRO 31:21">nĩgũkorwo othe nĩahumbe nguo cia rangi mũtune.<verse eid="PRO 31:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 31:22"/>Nĩatumaga indo cia kwara ũrĩrĩ wake;</para>
  <para style="q2" vid="PRO 31:22">nake ehumbaga nguo cia gatani ĩrĩa njega, na cia rangi wa ndathi.<note caller="+" style="f"><char style="fr" closed="false">31:22 </char><char style="ft" closed="false">Gĩtambaya kĩa rangi wa ndathi kĩarĩ kĩa goro mũno, na kĩarĩ kĩonereria kĩa ũnene.</char></note><verse eid="PRO 31:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 31:23"/>Mũthuuri wake nĩaheagwo gĩtĩĩo kĩhingo-inĩ gĩa itũũra inene,</para>
  <para style="q2" vid="PRO 31:23">harĩa aikaraga marĩ na athuuri a bũrũri.<note caller="+" style="f"><char style="fr" closed="false">31:23 </char><char style="ft" closed="false">Kĩhingo-inĩ kĩa itũũra nĩho athuuri a itũũra maacemanagia.</char></note><verse eid="PRO 31:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 31:24"/>Mũtumia ũcio nĩatumaga nguo cia gatani agaciendia,</para>
  <para style="q2" vid="PRO 31:24">na agatwaragĩra onjoria mĩcibi.<verse eid="PRO 31:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 31:25"/>Hinya na ũtĩĩku nĩcio nguo iria ehumbaga;</para>
  <para style="q2" vid="PRO 31:25">nĩakenaga ategwĩtigĩra matukũ marĩa magooka.<verse eid="PRO 31:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 31:26"/>Aaragia ciugo cia ũũgĩ,</para>
  <para style="q2" vid="PRO 31:26">naruo rũrĩmĩ rwake rũrutanaga maũndũ ma ũtugi.<verse eid="PRO 31:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 31:27"/>Nĩarũmbũyagia maũndũ ma nyũmba yake,</para>
  <para style="q2" vid="PRO 31:27">na ndarĩĩaga irio atanogeire.<verse eid="PRO 31:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 31:28"/>Ciana ciake ciarahũkaga, cikoiga arorathimwo;</para>
  <para style="q2" vid="PRO 31:28">o nake mũthuuri wake nĩamũgaathagĩrĩria, akamwĩra atĩrĩ:<verse eid="PRO 31:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 31:29"/>“Andũ-a-nja aingĩ manatuĩka ngatha,</para>
  <para style="q2" vid="PRO 31:29">no wee nĩũmakĩrĩte othe.”<verse eid="PRO 31:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 31:30"/>Ngoga nĩ cia kũheenania, naguo ũthaka nĩ wa tũhũ;</para>
  <para style="q2" vid="PRO 31:30">no mũtumia ũrĩa mwĩtigĩri Jehova nĩ wa kũgaathĩrĩrio.<verse eid="PRO 31:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 31:31"/>Mũrĩhei mũcaara wa wĩra ũrĩa arutĩte,</para>
  <para style="q2" vid="PRO 31:31">naguo wĩra wake ũrekwo ũmũgaathĩrĩrie kĩhingo-inĩ gĩa itũũra rĩrĩa inene.<verse eid="PRO 31:31"/></para>
  <chapter eid="PRO 31"/>
</usx>
