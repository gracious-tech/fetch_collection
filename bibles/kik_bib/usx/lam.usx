<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="LAM" style="id">- Biblica® Open Kikuyu Holy Word of God</book>
  <para style="h">Macakaya</para>
  <para style="toc1">Macakaya</para>
  <para style="toc2">Macakaya</para>
  <para style="toc3">Maca</para>
  <para style="mt1">MACAKAYA</para>
  <chapter number="1" style="c" sid="LAM 1"/>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 1:1"/>Hĩ! Kaĩ itũũra rĩu inene nĩrĩikarĩte rĩtiganĩirio,</para>
  <para style="q2" vid="LAM 1:1">o rĩu rĩratũire rĩiyũrĩte andũ-ĩ!</para>
  <para style="q1" vid="LAM 1:1">Kaĩ rĩĩkũhaana o ta mũtumia wa ndigwa,</para>
  <para style="q2" vid="LAM 1:1">ũcio ũraarĩ mũnene gatagatĩ ka ndũrĩrĩ-ĩ!</para>
  <para style="q1" vid="LAM 1:1">O we ũratũire arĩ mũthamaki-mũndũ-wa-nja ngʼongo-inĩ cia bũrũri-rĩ,</para>
  <para style="q2" vid="LAM 1:1">rĩu atuĩkĩte ngombo.<verse eid="LAM 1:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 1:2"/>Ũtukũ araaraga akĩrĩra na ruo,</para>
  <para style="q2" vid="LAM 1:2">maithori makanyũrũrũkĩra makai-inĩ make.</para>
  <para style="q1" vid="LAM 1:2">Arĩa othe marendanĩte nake-rĩ,</para>
  <para style="q2" vid="LAM 1:2">hatirĩ o na ũmwe wa kũmũhooreria.</para>
  <para style="q1" vid="LAM 1:2">Arata ake othe nĩmamũkunyanĩire;</para>
  <para style="q2" vid="LAM 1:2">othe matuĩkĩte thũ ciake.<verse eid="LAM 1:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 1:3"/>Thuutha wa thĩĩna na mawĩra maritũ,</para>
  <para style="q2" vid="LAM 1:3">Juda nĩatwarĩtwo ithaamĩrio.</para>
  <para style="q1" vid="LAM 1:3">Atũũraga gatagatĩ ka ndũrĩrĩ;</para>
  <para style="q2" vid="LAM 1:3">agakĩaga handũ ha kũhurũka.</para>
  <para style="q1" vid="LAM 1:3">Arĩa othe mamũingatithagia nĩmamũkinyĩrĩire</para>
  <para style="q2" vid="LAM 1:3">arĩ hatĩka-inĩ ciake.<verse eid="LAM 1:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 1:4"/>Njĩra cia gũthiĩ Zayuni no macakaya,</para>
  <para style="q2" vid="LAM 1:4">nĩ ũndũ gũtirĩ andũ mookaga ciathĩ ciake iria njathane.</para>
  <para style="q1" vid="LAM 1:4">Matoonyero make mothe makirĩte ihooru,</para>
  <para style="q2" vid="LAM 1:4">athĩnjĩri-Ngai ake no gũcaaya maracaaya,</para>
  <para style="q1" vid="LAM 1:4">airĩtu ake no kũgirĩka,</para>
  <para style="q2" vid="LAM 1:4">nake arĩ na ruo rũnene.<verse eid="LAM 1:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 1:5"/>Amuku ake matuĩkĩte nĩo mamwathaga;</para>
  <para style="q2" vid="LAM 1:5">thũ ciake nĩcio igaacĩire.</para>
  <para style="q1" vid="LAM 1:5">Jehova nĩamũrehithĩirie kĩeha</para>
  <para style="q2" vid="LAM 1:5">nĩ ũndũ wa mehia make maingĩ.</para>
  <para style="q1" vid="LAM 1:5">Ciana ciake itahĩtwo igatwarwo bũrũri ũngĩ,</para>
  <para style="q2" vid="LAM 1:5">igatuĩka mĩgwate ya thũ.<verse eid="LAM 1:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 1:6"/>Mwarĩ wa Zayuni nĩehereirwo nĩ riiri wake.</para>
  <para style="q2" vid="LAM 1:6">Anene ake mahaanĩte ta thwariga ciagĩte ũrĩithio;</para>
  <para style="q1" vid="LAM 1:6">moorĩte matarĩ na hinya,</para>
  <para style="q2" vid="LAM 1:6">moimĩtwo thuutha nĩ arĩa mamaingatithĩtie.<verse eid="LAM 1:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 1:7"/>Matukũ-inĩ ma thĩĩna na kũũrũũra gwake-rĩ,</para>
  <para style="q2" vid="LAM 1:7">Jerusalemu aririkanaga igĩĩna ciothe</para>
  <para style="q2" vid="LAM 1:7">iria ciarĩ ciake matukũ ma tene.</para>
  <para style="q1" vid="LAM 1:7">Rĩrĩa andũ ake maagũire moko-inĩ ma thũ-rĩ,</para>
  <para style="q2" vid="LAM 1:7">gũtiarĩ mũndũ o na ũmwe wa kũmũteithia.</para>
  <para style="q1" vid="LAM 1:7">Thũ ciake ikĩmũrora,</para>
  <para style="q2" vid="LAM 1:7">igĩthekerera mwanangĩko wake.<verse eid="LAM 1:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 1:8"/>Jerusalemu nĩehĩtie mũno,</para>
  <para style="q2" vid="LAM 1:8">na nĩ ũndũ ũcio akanyiitwo nĩ thaahu.</para>
  <para style="q1" vid="LAM 1:8">Arĩa othe maamũtĩĩte-rĩ, rĩu nĩmamũnyararĩte,</para>
  <para style="q2" vid="LAM 1:8">nĩ ũndũ nĩmonete njaga yake;</para>
  <para style="q1" vid="LAM 1:8">we mwene no gũcaaya aracaaya,</para>
  <para style="q2" vid="LAM 1:8">na akamahutatĩra.<verse eid="LAM 1:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 1:9"/>Gĩko gĩake nĩkĩnyiitĩte nguo ciake;</para>
  <para style="q2" vid="LAM 1:9">nake ndaigana gwĩcũũrania mũtũũrĩre wake wa thuutha.</para>
  <para style="q1" vid="LAM 1:9">Kũgũa gwake kwarĩ gwa kũmakania;</para>
  <para style="q2" vid="LAM 1:9">gũtiarĩ mũndũ o na ũmwe wa kũmũhooreria.</para>
  <para style="q1" vid="LAM 1:9">“Wee Jehova, ta kĩone mathĩĩna makwa,</para>
  <para style="q2" vid="LAM 1:9">nĩgũkorwo thũ yakwa nĩhootanĩte.”<verse eid="LAM 1:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 1:10"/>Thũ ĩyo nĩyegwatĩire</para>
  <para style="q2" vid="LAM 1:10">igĩĩna-inĩ ciake ciothe;</para>
  <para style="q1" vid="LAM 1:10">nake akĩĩonera ndũrĩrĩ iria itooĩ Ngai</para>
  <para style="q2" vid="LAM 1:10">igĩtoonya handũ harĩa hake haamũre:</para>
  <para style="q1" vid="LAM 1:10">o arĩa wee wathanĩte</para>
  <para style="q2" vid="LAM 1:10">matikanatoonye kĩũngano-inĩ gĩaku.<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="ft" closed="false">Andũ a ndũrĩrĩ matietĩkĩrĩtio gũtoonya hekarũ matikamĩthaahie (Ezek 44:7-9).</char></note><verse eid="LAM 1:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 1:11"/>Andũ ake othe nĩgũcaaya maracaaya</para>
  <para style="q2" vid="LAM 1:11">magĩetha gĩa kũrĩa;</para>
  <para style="q1" vid="LAM 1:11">magagĩkũũrania igĩĩna ciao</para>
  <para style="q2" vid="LAM 1:11">na irio nĩguo matũũre muoyo.</para>
  <para style="q1" vid="LAM 1:11">“Wee Jehova, ta cũrania wone,</para>
  <para style="q2" vid="LAM 1:11">nĩgũkorwo ndĩ mũmeneku.”<verse eid="LAM 1:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 1:12"/>“Atĩrĩrĩ, inyuĩ mũrahĩtũka,</para>
  <para style="q2" vid="LAM 1:12">anga mũkuona ũndũ ũyũ ta ũtamũkoniĩ?</para>
  <para style="q1" vid="LAM 1:12">Ta rorai muone.</para>
  <para style="q2" vid="LAM 1:12">Nĩ kũrĩ thĩĩna ũiganaine na thĩĩna ũyũ wakwa,</para>
  <para style="q1" vid="LAM 1:12">thĩĩna ũrĩa njigĩrĩirwo,</para>
  <para style="q2" vid="LAM 1:12">o ũcio Jehova aandehithĩirie</para>
  <para style="q2" vid="LAM 1:12">mũthenya wa marakara make mahiũ?<verse eid="LAM 1:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 1:13"/>“We aandũmĩire mwaki uumĩte igũrũ,</para>
  <para style="q2" vid="LAM 1:13">akĩũikũrũkia, ũgĩtoonya nginya mahĩndĩ-inĩ makwa.</para>
  <para style="q1" vid="LAM 1:13">Aambĩire magũrũ makwa wabu wa kũmatega, akĩĩhũndũra.</para>
  <para style="q2" vid="LAM 1:13">Nake agĩtũma nyiitwo nĩ ihooru, ngĩkĩringĩka mũthenya wothe.<verse eid="LAM 1:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 1:14"/>“Mehia makwa mohanĩtio, magatuĩka icooki.</para>
  <para style="q2" vid="LAM 1:14">Moko make mamogothanĩtie hamwe.</para>
  <para style="q1" vid="LAM 1:14">Magagĩĩkĩrwo ngingo-inĩ yakwa,</para>
  <para style="q2" vid="LAM 1:14">nake Mwathani agakĩĩniina hinya.</para>
  <para style="q1" vid="LAM 1:14">Akaaneana moko-inĩ ma arĩa itangĩhota gwĩtiiria.<verse eid="LAM 1:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 1:15"/>“Mwathani nĩaregete</para>
  <para style="q2" vid="LAM 1:15">njamba ciothe cia ita iria ndĩ nacio,</para>
  <para style="q1" vid="LAM 1:15">akanjĩtĩra ita nĩguo rĩnjũkĩrĩre,</para>
  <para style="q2" vid="LAM 1:15">rĩmemende aanake akwa.</para>
  <para style="q1" vid="LAM 1:15">Kĩhihĩro-inĩ gĩake kĩa ndibei-rĩ,</para>
  <para style="q2" vid="LAM 1:15">Mwathani nĩarangĩrĩirie</para>
  <para style="q1" vid="LAM 1:15">Mwarĩ Gathirange wa Juda.<verse eid="LAM 1:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 1:16"/>“Maũndũ macio nĩmo maratũma ndĩre,</para>
  <para style="q2" vid="LAM 1:16">namo maitho makwa makanyũrũrũkia maithori.</para>
  <para style="q1" vid="LAM 1:16">Gũtirĩ mũndũ ũrĩ hakuhĩ wa kũũhooreria,</para>
  <para style="q2" vid="LAM 1:16">gũtirĩ mũndũ wa kũnyũmĩrĩria ngoro.</para>
  <para style="q1" vid="LAM 1:16">Ciana ciakwa ituĩkĩte cia kũnyamarĩka</para>
  <para style="q2" vid="LAM 1:16">tondũ thũ nĩyo ĩhootanĩte.”<verse eid="LAM 1:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 1:17"/>Zayuni atambũrũkĩtie moko,</para>
  <para style="q2" vid="LAM 1:17">no gũtirĩ mũndũ wa kũmũhooreria.</para>
  <para style="q1" vid="LAM 1:17">Jehova nĩathanĩte ũhoro wa Jakubu</para>
  <para style="q2" vid="LAM 1:17">atĩ arĩa mariganĩtie nake matuĩke thũ ciake;</para>
  <para style="q1" vid="LAM 1:17">Jerusalemu nĩatuĩkĩte</para>
  <para style="q2" vid="LAM 1:17">kĩndũ kĩrĩ thaahu gatagatĩ-inĩ kao.<verse eid="LAM 1:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 1:18"/>“Jehova nĩ mũthingu,</para>
  <para style="q2" vid="LAM 1:18">no rĩrĩ, nĩndaremeire watho wake.</para>
  <para style="q1" vid="LAM 1:18">Thikĩrĩriai, inyuĩ andũ othe,</para>
  <para style="q2" vid="LAM 1:18">na mũrore gũthĩĩnĩka gwakwa.</para>
  <para style="q1" vid="LAM 1:18">Aanake akwa na airĩtu akwa</para>
  <para style="q2" vid="LAM 1:18">nĩmatahĩtwo magatwarwo thĩ ngʼeni.<verse eid="LAM 1:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 1:19"/>“Ndaatũmanĩire arĩa twarĩ ngwatanĩro,</para>
  <para style="q2" vid="LAM 1:19">no-o makĩngunyanĩra.</para>
  <para style="q1" vid="LAM 1:19">Athĩnjĩri-Ngai akwa, na athuuri akwa</para>
  <para style="q2" vid="LAM 1:19">marakuĩrĩire itũũra-inĩ rĩu inene,</para>
  <para style="q1" vid="LAM 1:19">o magĩcaragia irio cia kũmatũũria muoyo.<verse eid="LAM 1:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 1:20"/>“Wee Jehova, ta rora wone ũrĩa ndĩ hatĩka-inĩ!</para>
  <para style="q2" vid="LAM 1:20">Nĩndĩratangĩka thĩinĩ wakwa,</para>
  <para style="q1" vid="LAM 1:20">na ngathĩĩnĩka thĩinĩ wa ngoro yakwa,</para>
  <para style="q2" vid="LAM 1:20">nĩ ũndũ ngoretwo ndĩ mũremi mũno.</para>
  <para style="q1" vid="LAM 1:20">Na kũu nja, hiũ cia njora nĩirooraga andũ,</para>
  <para style="q2" vid="LAM 1:20">nakuo thĩinĩ no gĩkuũ kũrĩ.<verse eid="LAM 1:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 1:21"/>“Andũ nĩmaiguĩte mũcaayo wakwa,</para>
  <para style="q2" vid="LAM 1:21">no gũtirĩ mũndũ o na ũmwe wa kũũhooreria.</para>
  <para style="q1" vid="LAM 1:21">Thũ ciakwa ciothe nĩciguĩte ũhoro wa hatĩka ciakwa,</para>
  <para style="q2" vid="LAM 1:21">nacio igakena nĩ ũndũ wa ũguo wĩkĩte.</para>
  <para style="q1" vid="LAM 1:21">Nawe gĩkinyie mũthenya ũrĩa wanĩrĩire</para>
  <para style="q2" vid="LAM 1:21">nĩguo nao mahaane ta niĩ.<verse eid="LAM 1:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 1:22"/>“Waganu wao wothe nĩũgĩkinye mbere yaku,</para>
  <para style="q2" vid="LAM 1:22">nawe ũmeke o ta ũrĩa ũnjĩkĩte</para>
  <para style="q1" vid="LAM 1:22">nĩ ũndũ wa mehia makwa mothe.</para>
  <para style="q1" vid="LAM 1:22">Mĩcaayo yakwa nĩ mĩingĩ,</para>
  <para style="q2" vid="LAM 1:22">nayo ngoro yakwa nĩĩringĩkĩte.”<verse eid="LAM 1:22"/></para>
  <chapter eid="LAM 1"/>
  <chapter number="2" style="c" sid="LAM 2"/>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 2:1"/>Hĩ! Kaĩ Mwathani nĩakĩhumbĩrĩte Mwarĩ wa Zayuni</para>
  <para style="q2" vid="LAM 2:1">na itu rĩa marakara make-ĩ!</para>
  <para style="q1" vid="LAM 2:1">Nĩatungumanĩtie riiri wa Isiraeli,</para>
  <para style="q2" vid="LAM 2:1">akaũharũrũkia kuuma igũrũ nginya thĩ;</para>
  <para style="q1" vid="LAM 2:1">ndaaririkanire gaturwa ka magũrũ make,</para>
  <para style="q2" vid="LAM 2:1">mũthenya ũrĩa aarakarire.<verse eid="LAM 2:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 2:2"/>Mwathani-rĩ, nĩameretie</para>
  <para style="q2" vid="LAM 2:2">itũũro ciothe cia Jakubu atarĩ na tha;</para>
  <para style="q1" vid="LAM 2:2">nĩamomorete ciĩhitho iria nũmu</para>
  <para style="q2" vid="LAM 2:2">cia Mwarĩ wa Juda arĩ na marakara.</para>
  <para style="q1" vid="LAM 2:2">Nĩagũithĩtie ũthamaki wa Mwarĩ wa Juda,</para>
  <para style="q2" vid="LAM 2:2">na akagũithia anene ake, akamaconorithia.<verse eid="LAM 2:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 2:3"/>Rũhĩa rwa Isiraeli ruothe</para>
  <para style="q2" vid="LAM 2:3">arũrengete arĩ na marakara mahiũ.</para>
  <para style="q1" vid="LAM 2:3">Nĩeheretie guoko gwake kwa ũrĩo,</para>
  <para style="q2" vid="LAM 2:3">gũkameeherera o rĩrĩa thũ ciamakuhĩrĩria.</para>
  <para style="q1" vid="LAM 2:3">Nĩgũcina acinĩte Jakubu ta mwaki ũkũrĩrĩmbũka,</para>
  <para style="q2" vid="LAM 2:3">ũrĩa ũcinaga kĩrĩa gĩothe kĩrĩ hakuhĩ naguo.<verse eid="LAM 2:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 2:4"/>Ageetete ũta wake o ta thũ;</para>
  <para style="q2" vid="LAM 2:4">guoko gwake kwa ũrĩo nĩ kwĩhaarĩirie.</para>
  <para style="q1" vid="LAM 2:4">Arĩa othe maatũire makenagia maitho-rĩ,</para>
  <para style="q2" vid="LAM 2:4">amooragĩte o ta marĩ thũ;</para>
  <para style="q1" vid="LAM 2:4">hema ya Mwarĩ wa Zayuni</para>
  <para style="q2" vid="LAM 2:4">amĩitĩrĩirie mangʼũrĩ make mahaana ta mwaki.<verse eid="LAM 2:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 2:5"/>Mwathani-rĩ, atuĩkĩte ta thũ;</para>
  <para style="q2" vid="LAM 2:5">nĩameretie Isiraeli.</para>
  <para style="q1" vid="LAM 2:5">Nĩameretie nyũmba ciake ciothe cia ũthamaki,</para>
  <para style="q2" vid="LAM 2:5">na akaananga ciĩhitho ciake iria nũmu.</para>
  <para style="q1" vid="LAM 2:5">Nĩaingĩhĩirie Mwarĩ wa Juda</para>
  <para style="q2" vid="LAM 2:5">gũcakaya na kũgirĩka.<verse eid="LAM 2:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 2:6"/>Nĩonũhĩte gĩikaro gĩake ta mũgũnda;</para>
  <para style="q2" vid="LAM 2:6">nĩanangĩte handũ hake ha gũtũnganĩrwo.</para>
  <para style="q1" vid="LAM 2:6">Jehova nĩatũmĩte Zayuni ariganĩrwo</para>
  <para style="q2" vid="LAM 2:6">nĩ ciathĩ ciake iria njathane, o hamwe na Thabatũ ciake;</para>
  <para style="q1" vid="LAM 2:6">nĩ ũndũ wa marakara make mahiũ-rĩ,</para>
  <para style="q2" vid="LAM 2:6">akanyarara mũthamaki, o hamwe na mũthĩnjĩri-Ngai.<verse eid="LAM 2:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 2:7"/>Mwathani nĩaregete kĩgongona gĩake,</para>
  <para style="q2" vid="LAM 2:7">na agatiganĩria handũ hake harĩa haamũre.</para>
  <para style="q1" vid="LAM 2:7">Nĩaneanĩte thingo cia nyũmba ciake cia ũthamaki kũrĩ thũ;</para>
  <para style="q2" vid="LAM 2:7">iraanĩrĩra irĩ thĩinĩ wa nyũmba ya Jehova,</para>
  <para style="q2" vid="LAM 2:7">o taarĩ mũthenya wa gĩathĩ kĩrĩa gĩathane.<verse eid="LAM 2:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 2:8"/>Jehova nĩatuire itua rĩa kũmomora</para>
  <para style="q2" vid="LAM 2:8">rũthingo rũrĩa rũthiũrũrũkĩirie Mwarĩ wa Zayuni.</para>
  <para style="q1" vid="LAM 2:8">Nĩatambũrũkirie rũrigi rwa gũthima,</para>
  <para style="q2" vid="LAM 2:8">na ndaagiririe guoko gwake gũtige kũrwananga.</para>
  <para style="q1" vid="LAM 2:8">Nĩatũmire njirigo na thingo icakaye;</para>
  <para style="q2" vid="LAM 2:8">o cierĩ igĩgĩtuĩka cia kwanangĩka.<verse eid="LAM 2:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 2:9"/>Ihingo ciakuo nĩihorokeire na thĩ;</para>
  <para style="q2" vid="LAM 2:9">mĩgĩĩko yacio nĩamiunangĩte, akamĩananga.</para>
  <para style="q1" vid="LAM 2:9">Mũthamaki na anene akuo nĩmatahĩtwo magatwarwo ndũrĩrĩ-inĩ,</para>
  <para style="q2" vid="LAM 2:9">watho rĩu ndũrutanagwo,</para>
  <para style="q1" vid="LAM 2:9">na anabii akuo nĩmatigire kuona cioneki</para>
  <para style="q2" vid="LAM 2:9">ciumĩte kũrĩ Jehova.<verse eid="LAM 2:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 2:10"/>Athuuri a kũu kwa Mwarĩ wa Zayuni</para>
  <para style="q2" vid="LAM 2:10">maikarĩte thĩ makirĩte ki;</para>
  <para style="q1" vid="LAM 2:10">nao nĩmehurĩirie rũkũngũ mĩtwe,</para>
  <para style="q2" vid="LAM 2:10">na makehumba nguo cia makũnia.</para>
  <para style="q1" vid="LAM 2:10">Airĩtu a Jerusalemu</para>
  <para style="q2" vid="LAM 2:10">mainamĩrĩire maturumithĩtie mĩtwe yao thĩ.<verse eid="LAM 2:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 2:11"/>Maitho makwa nĩmaroora nĩ kũrĩra,</para>
  <para style="q2" vid="LAM 2:11">ngatangĩka thĩinĩ wakwa,</para>
  <para style="q1" vid="LAM 2:11">naguo roho wakwa nĩũitũrũrĩirwo thĩ</para>
  <para style="q2" vid="LAM 2:11">nĩ ũndũ wa andũ akwa kwanangwo,</para>
  <para style="q1" vid="LAM 2:11">nĩgũkorwo twana na tũkenge</para>
  <para style="q2" vid="LAM 2:11">tũraringĩkĩra njĩra-inĩ cia itũũra rĩrĩa inene.<verse eid="LAM 2:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 2:12"/>Tũrooria manyina atĩrĩ,</para>
  <para style="q2" vid="LAM 2:12">“Irio na ndibei irĩ ha?”</para>
  <para style="q1" vid="LAM 2:12">o tũkĩringĩkaga ta andũ matiihĩirio</para>
  <para style="q2" vid="LAM 2:12">njĩra-inĩ cia itũũra rĩrĩa inene,</para>
  <para style="q1" vid="LAM 2:12">o mĩoyo yatuo ĩgĩthiragĩra</para>
  <para style="q2" vid="LAM 2:12">moko-inĩ ma manyina.<verse eid="LAM 2:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 2:13"/>Ingĩkiuga atĩa nĩ ũndũ waku?</para>
  <para style="q2" vid="LAM 2:13">Ingĩkũgerekania nakĩ,</para>
  <para style="q2" vid="LAM 2:13">wee Mwarĩ ũyũ wa Jerusalemu?</para>
  <para style="q1" vid="LAM 2:13">Ingĩkũhaanania nakĩ,</para>
  <para style="q2" vid="LAM 2:13">nĩguo ngũhoorerie,</para>
  <para style="q2" vid="LAM 2:13">wee Mwarĩ ũyũ Gathirange wa Zayuni?</para>
  <para style="q1" vid="LAM 2:13">Kĩronda gĩaku kĩrikĩte o ta iria.</para>
  <para style="q2" vid="LAM 2:13">Nũũ ũngĩhota gũkũhonia?<verse eid="LAM 2:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 2:14"/>Cioneki iria anabii aku moonaga</para>
  <para style="q2" vid="LAM 2:14">ciarĩ cia tũhũ na cia maheeni;</para>
  <para style="q1" vid="LAM 2:14">matiigana kũmũguũrĩria mehia manyu</para>
  <para style="q2" vid="LAM 2:14">nĩguo magirĩrĩrie gũtahwo kwanyu.</para>
  <para style="q1" vid="LAM 2:14">Ndũmĩrĩri iria maamũheire</para>
  <para style="q2" vid="LAM 2:14">ciarĩ cia maheeni, na cia kũmũhĩtithia.<verse eid="LAM 2:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 2:15"/>Ehĩtũkĩri othe mahũũraga hĩ;</para>
  <para style="q2" vid="LAM 2:15">mathekaga makĩinainagĩria Mwarĩ ũyũ wa Jerusalemu mĩtwe,</para>
  <para style="q1" vid="LAM 2:15">makĩũragia atĩrĩ:</para>
  <para style="q2" vid="LAM 2:15">“Ĩĩ rĩĩrĩ nĩrĩo itũũra inene rĩrĩa rĩetagwo</para>
  <para style="q1" vid="LAM 2:15">ũthaka ũrĩa mũkinyanĩru biũ,</para>
  <para style="q2" vid="LAM 2:15">na rĩgeetwo gĩkeno gĩa thĩ yothe?”<verse eid="LAM 2:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 2:16"/>Thũ ciaku ciothe</para>
  <para style="q2" vid="LAM 2:16">ciathamagia tũnua igũũkĩrĩre;</para>
  <para style="q1" vid="LAM 2:16">igũthekagĩrĩra na ikahagarania magego,</para>
  <para style="q2" vid="LAM 2:16">ikoiga atĩrĩ, “Ithuĩ nĩtũmũmeretie.</para>
  <para style="q1" vid="LAM 2:16">Ũyũ nĩguo mũthenya ũrĩa tũtũire twetereire,</para>
  <para style="q2" vid="LAM 2:16">na rĩu nĩtũwonete.”<verse eid="LAM 2:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 2:17"/>Jehova nĩarĩkĩtie gwĩka ũrĩa aathugundĩte;</para>
  <para style="q2" vid="LAM 2:17">we nĩahingĩtie kiugo gĩake,</para>
  <para style="q2" vid="LAM 2:17">kĩrĩa aathanire o matukũ ma tene.</para>
  <para style="q1" vid="LAM 2:17">Akũngʼaũranĩtie ategũkũiguĩra tha,</para>
  <para style="q2" vid="LAM 2:17">atũmĩte thũ igũkenerere,</para>
  <para style="q2" vid="LAM 2:17">rũhĩa rwa amuku aku nĩruo atũgĩrĩtie.<verse eid="LAM 2:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 2:18"/>Ngoro cia andũ nĩirakaĩra Mwathani.</para>
  <para style="q2" vid="LAM 2:18">Atĩrĩrĩ, wee rũthingo rũrũ rwa Mwarĩ wa Zayuni,</para>
  <para style="q1" vid="LAM 2:18">reke maithori maku manyũrũrũke ta rũũĩ</para>
  <para style="q2" vid="LAM 2:18">mũthenya na ũtukũ;</para>
  <para style="q1" vid="LAM 2:18">ndũkahurũke,</para>
  <para style="q2" vid="LAM 2:18">kana ũreke maitho maku mahurũke.<verse eid="LAM 2:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 2:19"/>Arahũka, ũkayũrũrũke ũtukũ,</para>
  <para style="q2" vid="LAM 2:19">rĩrĩa ũrangĩri wa ũtukũ wambagĩrĩria;</para>
  <para style="q1" vid="LAM 2:19">itũrũraga ngoro yaku ta maaĩ</para>
  <para style="q2" vid="LAM 2:19">mbere ya Mwathani.</para>
  <para style="q1" vid="LAM 2:19">Ambararia moko maku na igũrũ kũrĩ we</para>
  <para style="q2" vid="LAM 2:19">nĩ ũndũ wa mĩoyo ya ciana ciaku,</para>
  <para style="q1" vid="LAM 2:19">o icio iraringĩka nĩ ngʼaragu</para>
  <para style="q2" vid="LAM 2:19">magomano-inĩ ma njĩra ciothe.<verse eid="LAM 2:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 2:20"/>“Wee Jehova, ta rora, na ũcũũranie:</para>
  <para style="q2" vid="LAM 2:20">Nũũ ũngĩ wee ũrĩ weka ũguo?</para>
  <para style="q1" vid="LAM 2:20">Andũ-a-nja nĩmagĩrĩirwo nĩ kũrĩa maciaro mao,</para>
  <para style="q2" vid="LAM 2:20">o ciana iria marerete?</para>
  <para style="q1" vid="LAM 2:20">Mũthĩnjĩri-Ngai na mũnabii nĩmagĩrĩire</para>
  <para style="q2" vid="LAM 2:20">kũũragagĩrwo handũ-harĩa-haamũre ha Mwathani?<verse eid="LAM 2:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 2:21"/>“Andũ ethĩ o na arĩa akũrũ</para>
  <para style="q2" vid="LAM 2:21">makomete hamwe rũkũngũ-inĩ rwa njĩra,</para>
  <para style="q1" vid="LAM 2:21">aanake akwa na airĩtu</para>
  <para style="q2" vid="LAM 2:21">moragĩtwo na rũhiũ rwa njora.</para>
  <para style="q1" vid="LAM 2:21">Ũmoragĩte mũthenya ũrĩa ũrakarĩte;</para>
  <para style="q2" vid="LAM 2:21">ũmoragĩte ũtekũmaiguĩra tha.<verse eid="LAM 2:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 2:22"/>“O ta ũrĩa wĩtanaga mũthenya wa gĩathĩ-rĩ,</para>
  <para style="q2" vid="LAM 2:22">noguo ũnjĩtĩire maũndũ ma kũnguoyohia,</para>
  <para style="q1" vid="LAM 2:22">makandigiicĩria mĩena yothe</para>
  <para style="q2" vid="LAM 2:22">o taarĩ mũthenya wa gĩathĩ.</para>
  <para style="q1" vid="LAM 2:22">Mũthenya wa marakara ma Jehova-rĩ,</para>
  <para style="q2" vid="LAM 2:22">gũtirĩ mũndũ o na ũmwe wahonokire kana agĩtigara;</para>
  <para style="q1" vid="LAM 2:22">arĩa ndarũmbũirie na ngĩrera-rĩ,</para>
  <para style="q2" vid="LAM 2:22">thũ yakwa nĩĩmanangĩte.”<verse eid="LAM 2:22"/></para>
  <chapter eid="LAM 2"/>
  <chapter number="3" style="c" sid="LAM 3"/>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 3:1"/>Niĩ ndĩ mũndũ wonete thĩĩna</para>
  <para style="q2" vid="LAM 3:1">nĩ ũndũ wa kũhũũrwo na rũthanju rwa mangʼũrĩ make.<verse eid="LAM 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 3:2"/>Andwarĩte akangereria nduma-inĩ</para>
  <para style="q2" vid="LAM 3:2">handũ ha ũtheri-inĩ;<verse eid="LAM 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 3:3"/>ti-itherũ, atũmĩte guoko gwake kũnjũkĩrĩre</para>
  <para style="q2" vid="LAM 3:3">rĩngĩ na rĩngĩ, mũthenya wothe.<verse eid="LAM 3:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 3:4"/>Nĩatũmĩte nyama cia mwĩrĩ wakwa</para>
  <para style="q2" vid="LAM 3:4">na gĩkonde kĩaguo ihinyare,</para>
  <para style="q2" vid="LAM 3:4">na akoinanga mahĩndĩ makwa.<verse eid="LAM 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 3:5"/>Nĩandigiicĩirie, na agaathiũrũrũkĩria</para>
  <para style="q2" vid="LAM 3:5">na marũrũ, na thĩĩna.<verse eid="LAM 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 3:6"/>Atũmĩte ndũũre nduma-inĩ</para>
  <para style="q2" vid="LAM 3:6">o ta andũ arĩa maakuire tene.<verse eid="LAM 3:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 3:7"/>Nĩanjirigĩire na rũthingo nĩguo ndikae kũũra;</para>
  <para style="q2" vid="LAM 3:7">mĩnyororo yakwa nĩamĩritũhĩtie mũno.<verse eid="LAM 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 3:8"/>O na rĩrĩa ndetana kana ndakaya ngĩenda ũteithio-rĩ,</para>
  <para style="q2" vid="LAM 3:8">nĩ kũhingĩrĩria ahingagĩrĩria mahooya makwa.<verse eid="LAM 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 3:9"/>Nĩahingĩte njĩra yakwa na mahiga maicũhie;</para>
  <para style="q2" vid="LAM 3:9">atũmĩte tũcĩra twakwa tuogome.<verse eid="LAM 3:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 3:10"/>Kũrĩ niĩ aatuĩkĩte o ta nduba rĩrĩa yoheirie,</para>
  <para style="q2" vid="LAM 3:10">kana ta mũrũũthi rĩrĩa wĩhithĩte,<verse eid="LAM 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 3:11"/>akĩngururia kuuma gacĩra-inĩ,</para>
  <para style="q2" vid="LAM 3:11">akĩndambuura, akĩndiganĩria itarĩ na ũteithio.<verse eid="LAM 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 3:12"/>Ageetete ũta wake, akangereka,</para>
  <para style="q2" vid="LAM 3:12">nduĩke cabaa ya kũrathagwo nĩ mĩguĩ yake.<verse eid="LAM 3:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 3:13"/>Nĩatheecire ngoro yakwa</para>
  <para style="q2" vid="LAM 3:13">na mĩguĩ kuuma thiaka-inĩ wake.<verse eid="LAM 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 3:14"/>Ngĩgĩtuĩka wa gũthekagĩrĩrwo nĩ andũ akwa othe;</para>
  <para style="q2" vid="LAM 3:14">maanyũrũragia na rwĩmbo mũthenya wothe.<verse eid="LAM 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 3:15"/>Anjiyũrĩtie maũndũ marũrũ,</para>
  <para style="q2" vid="LAM 3:15">na akaahũũnia na maaĩ ma nyongo.<verse eid="LAM 3:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 3:16"/>Nĩangʼethũrangĩte magego makwa na kagoto;</para>
  <para style="q2" vid="LAM 3:16">anangĩrĩirie rũkũngũ-inĩ.<verse eid="LAM 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 3:17"/>Nĩnjagithĩtio thayũ;</para>
  <para style="q2" vid="LAM 3:17">nĩndiganĩirwo ũgaacĩru nĩ kĩĩ.<verse eid="LAM 3:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 3:18"/>Nĩ ũndũ ũcio nguuga atĩrĩ, “Riiri wakwa nĩũthirĩte,</para>
  <para style="q2" vid="LAM 3:18">o hamwe na maũndũ marĩa mothe ndũire njĩrĩgĩrĩire kuuma kũrĩ Jehova.”<verse eid="LAM 3:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 3:19"/>Nĩngũririkana thĩĩna wakwa, na kũũrũũra gwakwa,</para>
  <para style="q2" vid="LAM 3:19">na ngaririkana maũndũ marũrũ, o na maaĩ ma nyongo.<verse eid="LAM 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 3:20"/>Ngoro yakwa no ĩraririkana maũndũ macio,</para>
  <para style="q2" vid="LAM 3:20">nayo ĩkaringĩka thĩinĩ wakwa.<verse eid="LAM 3:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 3:21"/>O na gũtariĩ ũguo nĩndirikanaga ũndũ ũyũ,</para>
  <para style="q2" vid="LAM 3:21">na tondũ wa ũguo ngagĩa na kĩĩrĩgĩrĩro:<verse eid="LAM 3:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 3:22"/>Tondũ wa wendo mũnene wa Jehova, nĩkĩo tũtaniinĩtwo biũ,</para>
  <para style="q2" vid="LAM 3:22">nĩgũkorwo tha ciake itirĩ hĩndĩ ithiraga.<verse eid="LAM 3:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="LAM 3:23"/>Tha ciaku ikoragwo irĩ njerũ rũciinĩ o rũciinĩ,</para>
  <para style="q2" vid="LAM 3:23">wĩhokeku waku nĩ mũnene mũno.<verse eid="LAM 3:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="LAM 3:24"/>Ngoro yakwa yugaga atĩrĩ,</para>
  <para style="q2" vid="LAM 3:24">“Jehova nĩwe igai rĩakwa; tondũ ũcio nĩwe ndĩrĩetagĩrĩra.”<verse eid="LAM 3:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="LAM 3:25"/>Jehova nĩ mwega kũrĩ arĩa mamwĩhokaga,</para>
  <para style="q2" vid="LAM 3:25">kũrĩ ngoro ĩyo ĩmũrongoragia;<verse eid="LAM 3:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="LAM 3:26"/>nĩ wega mũndũ gweterera</para>
  <para style="q2" vid="LAM 3:26">ũhonokio wa Jehova o akirĩte.<verse eid="LAM 3:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="LAM 3:27"/>Nĩ wega mũndũ gũkuua icooki</para>
  <para style="q2" vid="LAM 3:27">hĩndĩ ĩrĩa arĩ mũnini.<verse eid="LAM 3:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="LAM 3:28"/>Nĩaikare arĩ wiki akirĩte,</para>
  <para style="q2" vid="LAM 3:28">nĩgũkorwo nĩ Jehova ũmũigĩrĩire rĩo.<verse eid="LAM 3:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="LAM 3:29"/>Nĩaturumithie ũthiũ wake rũkũngũ-inĩ,</para>
  <para style="q2" vid="LAM 3:29">no gũkorwo aahota kũgĩa na kĩĩrĩgĩrĩro.<verse eid="LAM 3:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="LAM 3:30"/>Nĩerekererie rũthĩa kũrĩ mũndũ ũrĩa ũkũmũgũtha,</para>
  <para style="q2" vid="LAM 3:30">na aiyũrwo nĩ thoni.<verse eid="LAM 3:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="LAM 3:31"/>Nĩgũkorwo Jehova</para>
  <para style="q2" vid="LAM 3:31">ndateanagĩria andũ nginya tene.<verse eid="LAM 3:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="LAM 3:32"/>O na gũtuĩka nĩarehaga kĩeha-rĩ, we nĩaiguanagĩra tha,</para>
  <para style="q2" vid="LAM 3:32">nĩgũkorwo wendo ũcio wake ũtathiraga nĩ mũnene mũno.<verse eid="LAM 3:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="LAM 3:33"/>Nĩgũkorwo ndarehagĩra andũ mĩnyamaro,</para>
  <para style="q2" vid="LAM 3:33">kana akarehere ciana cia andũ kĩeha akĩendaga.<verse eid="LAM 3:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="LAM 3:34"/>Rĩrĩa andũ a bũrũri arĩa othe mohetwo</para>
  <para style="q2" vid="LAM 3:34">maarangĩrĩrio na makinya-rĩ,<verse eid="LAM 3:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="LAM 3:35"/>rĩrĩa mũndũ aagithio kĩhooto gĩake</para>
  <para style="q2" vid="LAM 3:35">mbere ya Ũrĩa-ũrĩ-Igũrũ-Mũno-rĩ,<verse eid="LAM 3:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="LAM 3:36"/>o na rĩrĩa mũndũ atuĩrwo ciira hatarĩ kĩhooto-rĩ,</para>
  <para style="q2" vid="LAM 3:36">githĩ Mwathani ndonaga maũndũ macio?<verse eid="LAM 3:36"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="37" style="v" sid="LAM 3:37"/>Nũũ ũngĩaria na atũme ũndũ ũcio ũhinge,</para>
  <para style="q2" vid="LAM 3:37">Mwathani ataathanĩte gũtuĩke ũguo?<verse eid="LAM 3:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="LAM 3:38"/>Githĩ kanua-inĩ ka Ũrĩa-ũrĩ-Igũrũ-Mũno</para>
  <para style="q2" vid="LAM 3:38">tiho hoimaga maũndũ mooru, na hakoima maũndũ mega?<verse eid="LAM 3:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="LAM 3:39"/>Mũndũ o wothe ũrĩ muoyo-rĩ, atetaga nĩkĩ</para>
  <para style="q2" vid="LAM 3:39">rĩrĩa ekũherithio nĩ ũndũ wa mehia make?<verse eid="LAM 3:39"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="40" style="v" sid="LAM 3:40"/>Nĩtũthuthuurie-i mĩthiĩre iitũ na tũmĩtuĩrie,</para>
  <para style="q2" vid="LAM 3:40">tũcokerere Jehova.<verse eid="LAM 3:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="LAM 3:41"/>Nĩtwambararie ngoro ciitũ na moko maitũ na igũrũ</para>
  <para style="q2" vid="LAM 3:41">kũrĩ Mũrungu ũrĩa ũrĩ igũrũ, tuuge atĩrĩ:<verse eid="LAM 3:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="LAM 3:42"/>“Ithuĩ-rĩ, nĩtwĩhĩtie na tũgakũremera,</para>
  <para style="q2" vid="LAM 3:42">wee nawe ũkaaga gũtũrekera.<verse eid="LAM 3:42"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="43" style="v" sid="LAM 3:43"/>“Wee wĩhumbĩrĩte na marakara, ũgatũingatithia;</para>
  <para style="q2" vid="LAM 3:43">ũũraganĩte ũtekũiguanĩra tha.<verse eid="LAM 3:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="LAM 3:44"/>Wee wĩhumbĩrĩte na itu</para>
  <para style="q2" vid="LAM 3:44">nĩgeetha gũtikagĩe na ihooya rĩngĩgũkinyĩra.<verse eid="LAM 3:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="LAM 3:45"/>Wee ũtũmĩte tũtuĩke ta gĩko,</para>
  <para style="q2" vid="LAM 3:45">na ta mahuti gatagatĩ ka ndũrĩrĩ.<verse eid="LAM 3:45"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="46" style="v" sid="LAM 3:46"/>“Thũ ciitũ ciothe itwathamĩirie tũnua itũũkĩrĩre.<verse eid="LAM 3:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="LAM 3:47"/>Nĩtũkorereirwo nĩ kĩmako kĩnene, na tũkenjerwo marima,</para>
  <para style="q2" vid="LAM 3:47">tũgakorwo nĩ ũniinani, na mwanangĩko.”<verse eid="LAM 3:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="LAM 3:48"/>Maitho makwa maranyũrũrũkia tũrũũĩ twa maithori</para>
  <para style="q2" vid="LAM 3:48">nĩ ũndũ andũ akwa nĩmanangĩtwo.<verse eid="LAM 3:48"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="49" style="v" sid="LAM 3:49"/>Maitho makwa marĩnyũrũrũkagia maithori mategũtigithĩria,</para>
  <para style="q2" vid="LAM 3:49">magaikara o makĩnyũrũrũkaga,<verse eid="LAM 3:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="LAM 3:50"/>nginya rĩrĩa Jehova agaacũthĩrĩria arĩ igũrũ oone.<verse eid="LAM 3:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="LAM 3:51"/>Maũndũ marĩa ndĩrona nĩmaranjiguithia kĩeha ngoro,</para>
  <para style="q2" vid="LAM 3:51">tondũ wa andũ-a-nja othe a itũũra rĩakwa inene.<verse eid="LAM 3:51"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="52" style="v" sid="LAM 3:52"/>Andũ arĩa maatuĩkĩte thũ ciakwa hatarĩ gĩtũmi</para>
  <para style="q2" vid="LAM 3:52">nĩo maanguĩmaga ta nyoni.<verse eid="LAM 3:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="LAM 3:53"/>Maanjikirie irima makĩenda kũnjũraga,</para>
  <para style="q2" vid="LAM 3:53">na makĩĩhũũra na mahiga;<verse eid="LAM 3:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="LAM 3:54"/>ndaahubanĩirio nĩ maaĩ maingĩ,</para>
  <para style="q2" vid="LAM 3:54">magĩikũrũkĩra igũrũ rĩa mũtwe wakwa,</para>
  <para style="q2" vid="LAM 3:54">na niĩ ngĩĩciiria ndĩ hakuhĩ kũniinwo.<verse eid="LAM 3:54"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="55" style="v" sid="LAM 3:55"/>Ngĩkaĩra rĩĩtwa rĩaku Wee Jehova,</para>
  <para style="q2" vid="LAM 3:55">ndĩ kũu irima-inĩ rĩu iriku.<verse eid="LAM 3:55"/></para>
  <para style="q1">
    <verse number="56" style="v" sid="LAM 3:56"/>Na we ũkĩigua ithaithana rĩakwa, ngĩkwĩra atĩrĩ,</para>
  <para style="q2" vid="LAM 3:56">“Tiga kũhinga matũ maku ngĩgũkaĩra ũndeithie.”<verse eid="LAM 3:56"/></para>
  <para style="q1">
    <verse number="57" style="v" sid="LAM 3:57"/>Nawe ũkĩnguhĩrĩria rĩrĩa ndagũkaĩire,</para>
  <para style="q2" vid="LAM 3:57">ũkĩnjĩĩra atĩrĩ, “Tiga gwĩtigĩra.”<verse eid="LAM 3:57"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="58" style="v" sid="LAM 3:58"/>Wee Mwathani-rĩ, nĩwe wanjiirĩrĩire;</para>
  <para style="q2" vid="LAM 3:58">nawe ũgĩgĩkũũra muoyo wakwa.<verse eid="LAM 3:58"/></para>
  <para style="q1">
    <verse number="59" style="v" sid="LAM 3:59"/>Wee Jehova, nĩwonete ũũru ũrĩa njĩkĩtwo.</para>
  <para style="q2" vid="LAM 3:59">Tua ciira wakwa arĩ we!<verse eid="LAM 3:59"/></para>
  <para style="q1">
    <verse number="60" style="v" sid="LAM 3:60"/>Wee nĩwonete kwĩrĩhĩria kwao guothe,</para>
  <para style="q2" vid="LAM 3:60">o na mathugunda mao mothe ma kũnjũkĩrĩra.<verse eid="LAM 3:60"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="61" style="v" sid="LAM 3:61"/>Wee Jehova-rĩ, nĩũiguĩte irumi iria manumĩte nacio,</para>
  <para style="q2" vid="LAM 3:61">o na mathugunda mao mothe ma kũnjũkĩrĩra:<verse eid="LAM 3:61"/></para>
  <para style="q1">
    <verse number="62" style="v" sid="LAM 3:62"/>maũndũ marĩa thũ ciakwa ciaragia na mĩheehũ ikĩngʼungʼuanaga</para>
  <para style="q2" vid="LAM 3:62">injũkĩrĩre mũthenya wothe.<verse eid="LAM 3:62"/></para>
  <para style="q1">
    <verse number="63" style="v" sid="LAM 3:63"/>Ta kĩmarore! Magĩikara thĩ kana magĩũkĩra,</para>
  <para style="q2" vid="LAM 3:63">maanyũrũragia na nyĩmbo ciao.<verse eid="LAM 3:63"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="64" style="v" sid="LAM 3:64"/>Wee Jehova-rĩ, marĩhe kũringana na ũrĩa mekĩte,</para>
  <para style="q2" vid="LAM 3:64">kũringana na wĩra wa moko mao.<verse eid="LAM 3:64"/></para>
  <para style="q1">
    <verse number="65" style="v" sid="LAM 3:65"/>Ũmia ngoro ciao, nakĩo kĩrumi gĩaku kĩroikara nao!<verse eid="LAM 3:65"/></para>
  <para style="q1">
    <verse number="66" style="v" sid="LAM 3:66"/>Maingatithie ũrĩ na marakara,</para>
  <para style="q2" vid="LAM 3:66">na ũmaniine mathire gũkũ mũhuro wa igũrũ rĩa Jehova.<verse eid="LAM 3:66"/></para>
  <chapter eid="LAM 3"/>
  <chapter number="4" style="c" sid="LAM 4"/>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 4:1"/>Hĩ! Kaĩ thahabu ĩyo nĩĩthirĩte ũkengu wayo-ĩ,</para>
  <para style="q2" vid="LAM 4:1">thahabu ĩrĩa therie kaĩ ĩrĩ gũthita-ĩ!</para>
  <para style="q1" vid="LAM 4:1">Tũhiga twa goro tũrĩa twamũre</para>
  <para style="q2" vid="LAM 4:1">nĩtũhurunjĩtwo magomano-inĩ ma njĩra ciothe.<verse eid="LAM 4:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 4:2"/>Ariũ a Zayuni arĩa me bata,</para>
  <para style="q2" vid="LAM 4:2">arĩa rĩmwe mangĩaringithanirio na thogora wa thahabu,</para>
  <para style="q1" vid="LAM 4:2">kaĩ rĩu moonagwo ta nyũngũ cia rĩũmba-ĩ,</para>
  <para style="q2" vid="LAM 4:2">o ta wĩra wa moko ma mũũmbi!<verse eid="LAM 4:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 4:3"/>O na mbwe nĩciongithagia ciana ciacio,</para>
  <para style="q2" vid="LAM 4:3">no andũ akwa matuĩkĩte andũ matarĩ tha,</para>
  <para style="q2" vid="LAM 4:3">o ta nyaga cia werũ-inĩ.<verse eid="LAM 4:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 4:4"/>Rũrĩmĩ rwa gakenge</para>
  <para style="q2" vid="LAM 4:4">rũnyiitanĩte na karakara nĩ ũndũ wa kũnyoota;</para>
  <para style="q1" vid="LAM 4:4">twana tũhooyaga irio,</para>
  <para style="q2" vid="LAM 4:4">no gũtirĩ mũndũ ũtũheaga.<verse eid="LAM 4:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 4:5"/>Andũ arĩa rĩmwe maarĩĩaga irio njega,</para>
  <para style="q2" vid="LAM 4:5">rĩu maikaraga njĩra-inĩ mekonotete,</para>
  <para style="q1" vid="LAM 4:5">arĩa maarerirwo makĩhumbagwo nguo cia rangi wa ndathi-rĩ,</para>
  <para style="q2" vid="LAM 4:5">rĩu makomaga ciara-inĩ cia mũhu.<verse eid="LAM 4:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 4:6"/>Iherithia rĩa andũ akwa</para>
  <para style="q2" vid="LAM 4:6">nĩ inene gũkĩra rĩa itũũra rĩa Sodomu,</para>
  <para style="q1" vid="LAM 4:6">rĩrĩa rĩangʼaũranirio o rĩmwe,</para>
  <para style="q2" vid="LAM 4:6">gũtarĩ guoko kwarĩteithirie.<verse eid="LAM 4:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 4:7"/>Anene akuo maatherete gũkĩra tharunji,</para>
  <para style="q2" vid="LAM 4:7">na makeerũha gũkĩra iria,</para>
  <para style="q1" vid="LAM 4:7">maarĩ atune mĩĩrĩ gũkĩra ruru ĩrĩa ndune,</para>
  <para style="q2" vid="LAM 4:7">magakĩhaana ta kahiga ka goro karĩa getagwo yakuti.<verse eid="LAM 4:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 4:8"/>No rĩu mairĩte o na gũkĩra mbiro;</para>
  <para style="q2" vid="LAM 4:8">matikũũrĩkanaga marĩ njĩra-inĩ.</para>
  <para style="q1" vid="LAM 4:8">Ikonde cia mĩĩrĩ yao ciũmanĩrĩire na mahĩndĩ;</para>
  <para style="q2" vid="LAM 4:8">ciumĩte o ta rũthanju.<verse eid="LAM 4:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 4:9"/>Kaba arĩa mooragagwo na rũhiũ rwa njora,</para>
  <para style="q2" vid="LAM 4:9">kũrĩ arĩa makuuaga nĩ ngʼaragu;</para>
  <para style="q1" vid="LAM 4:9">matooragio nĩkũhũũta,</para>
  <para style="q2" vid="LAM 4:9">makamoca nĩ ũndũ wa kwaga irio cia kuuma mũgũnda.<verse eid="LAM 4:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 4:10"/>Moko ma andũ-a-nja arĩa marĩ tha</para>
  <para style="q2" vid="LAM 4:10">nĩmarugire ciana ciao ene,</para>
  <para style="q1" vid="LAM 4:10">igĩtuĩka irio ciao</para>
  <para style="q2" vid="LAM 4:10">hĩndĩ ĩyo andũ akwa manangirwo.<verse eid="LAM 4:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 4:11"/>Jehova nĩarekereirie mangʼũrĩ make biũ;</para>
  <para style="q2" vid="LAM 4:11">aitũrũrĩte marakara make mahiũ.</para>
  <para style="q1" vid="LAM 4:11">Nĩakĩtie mwaki kũu Zayuni</para>
  <para style="q2" vid="LAM 4:11">ũrĩa ũcinĩte mĩthingi yakuo.<verse eid="LAM 4:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 4:12"/>Athamaki a thĩ matingĩetĩkirie,</para>
  <para style="q2" vid="LAM 4:12">o na kana kĩrĩndĩ o na kĩmwe gĩa gũkũ thĩ,</para>
  <para style="q1" vid="LAM 4:12">atĩ thũ na amuku nĩmangĩahotire</para>
  <para style="q2" vid="LAM 4:12">gũtoonya ihingo cia Jerusalemu.<verse eid="LAM 4:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 4:13"/>No ũndũ ũcio wekĩkire nĩ ũndũ wa mehia ma anabii akuo,</para>
  <para style="q2" vid="LAM 4:13">na mawaganu ma athĩnjĩri-Ngai akuo</para>
  <para style="q1" vid="LAM 4:13">arĩa manaita thakame</para>
  <para style="q2" vid="LAM 4:13">ya andũ arĩa athingu kũu thĩinĩ.<verse eid="LAM 4:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 4:14"/>Rĩu maturuuraga njĩra-inĩ</para>
  <para style="q2" vid="LAM 4:14">ta andũ atumumu.</para>
  <para style="q1" vid="LAM 4:14">Mathaahĩtio nĩ thakame ũũ atĩ</para>
  <para style="q2" vid="LAM 4:14">gũtirĩ mũndũ o na ũmwe ũngĩgeria kũhutia nguo ciao.<verse eid="LAM 4:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 4:15"/>Andũ mamakayagĩrĩria, makoiga atĩrĩ,</para>
  <para style="q2" vid="LAM 4:15">“Thiĩi nakũu! Mũrĩ na thaahu! Thiĩi! Thiĩi! Mũtigatũhutie!”<note caller="+" style="f"><char style="fr" closed="false">4:15 </char><char style="ft" closed="false">Andũ arĩa maakoragwo na mangũ maanagĩrĩra nĩguo andũ matikamahutie tondũ maakoragwo na thaahu (Alaw 13:45).</char></note></para>
  <para style="q1" vid="LAM 4:15">Ningĩ moora na maatuĩka orũũri,</para>
  <para style="q2" vid="LAM 4:15">makeerwo atĩrĩ kũu ndũrĩrĩ-inĩ,</para>
  <para style="q2" vid="LAM 4:15">“Matingĩikara gũkũ rĩngĩ.”<verse eid="LAM 4:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 4:16"/>Jehova we mwene nĩwe ũmahurunjĩte;</para>
  <para style="q2" vid="LAM 4:16">nĩatigĩte kũmarũmbũiya.</para>
  <para style="q1" vid="LAM 4:16">Athĩnjĩri-Ngai matiheagwo gĩtĩĩo,</para>
  <para style="q2" vid="LAM 4:16">o na makarega gũtuga athuuri.<verse eid="LAM 4:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 4:17"/>Makĩria ma ũguo-rĩ, maitho maitũ nĩmathirire hinya,</para>
  <para style="q2" vid="LAM 4:17">o tũcũthĩrĩirie ũteithio ũrĩa tũtoonire;</para>
  <para style="q1" vid="LAM 4:17">kuuma mĩthiringo iitũ ĩrĩa mĩraihu-rĩ,</para>
  <para style="q2" vid="LAM 4:17">twetereire rũrĩrĩ rũtangĩahotire gũtũhonokia.<verse eid="LAM 4:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 4:18"/>Andũ maatũcemaga ikinya gwa ikinya,</para>
  <para style="q2" vid="LAM 4:18">nĩ ũndũ ũcio tũtingĩathiĩrĩire njĩra-inĩ ciitũ.</para>
  <para style="q1" vid="LAM 4:18">Ithirĩro riitũ rĩgĩkuhĩrĩria, namo matukũ maitũ maarĩ matare,</para>
  <para style="q2" vid="LAM 4:18">nĩgũkorwo ithirĩro riitũ nĩrĩakinyĩte.<verse eid="LAM 4:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 4:19"/>Andũ arĩa matũingatithĩtie-rĩ,</para>
  <para style="q2" vid="LAM 4:19">maarĩ na ihenya gũkĩra nderi irĩ rĩera-inĩ;</para>
  <para style="q1" vid="LAM 4:19">maatũhanyũkagĩria irĩma-inĩ,</para>
  <para style="q2" vid="LAM 4:19">na magatuoheria werũ-inĩ.<verse eid="LAM 4:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 4:20"/>Mũndũ ũrĩa mũitĩrĩrie maguta nĩ Jehova,</para>
  <para style="q2" vid="LAM 4:20">o we ũrĩa warĩ ta mĩhũmũ iitũ-rĩ,</para>
  <para style="q2" vid="LAM 4:20">nĩagwatirio nĩ mĩtego yao.</para>
  <para style="q1" vid="LAM 4:20">Tweciiragia atĩ tũrĩ kĩĩruru-inĩ gĩake-rĩ,</para>
  <para style="q2" vid="LAM 4:20">no tũtũũre gatagatĩ ka ndũrĩrĩ.<verse eid="LAM 4:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 4:21"/>Kena na ũcanjamũke, wee Mwarĩ wa Edomu,</para>
  <para style="q2" vid="LAM 4:21">o wee ũtũũraga bũrũri wa Uzu.</para>
  <para style="q1" vid="LAM 4:21">No rĩrĩ, o nawe gĩkombe gĩkĩ nĩgĩgagũkora;</para>
  <para style="q2" vid="LAM 4:21">ũgaakĩnyuĩra ũrĩĩo, na ũrutwo nguo, ũtigwo njaga.<verse eid="LAM 4:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 4:22"/>Wee Mwarĩ wa Zayuni-rĩ, iherithia rĩaku nĩrĩgathira;</para>
  <para style="q2" vid="LAM 4:22">ndakoongerera ihinda rĩaku rĩa gũikara ũrĩ mũtahe.</para>
  <para style="q1" vid="LAM 4:22">No wee, Mwarĩ wa Edomu-rĩ, nĩagakũherithĩria mehia maku</para>
  <para style="q2" vid="LAM 4:22">na aguũrie waganu waku.<verse eid="LAM 4:22"/></para>
  <chapter eid="LAM 4"/>
  <chapter number="5" style="c" sid="LAM 5"/>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 5:1"/>Wee Jehova-rĩ, ririkana maũndũ marĩa matũkorete;</para>
  <para style="q2" vid="LAM 5:1">ta rora wone gũconoka gwitũ.<verse eid="LAM 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 5:2"/>Igai riitũ nĩrĩneanĩtwo kũrĩ ageni,</para>
  <para style="q2" vid="LAM 5:2">nayo mĩciĩ iitũ ĩgakĩneanwo kũrĩ andũ a kũngĩ.<verse eid="LAM 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 5:3"/>Nĩtũtuĩkĩte ciana cia ngoriai na ciana itarĩ na maithe,</para>
  <para style="q2" vid="LAM 5:3">nao manyina maitũ magatuĩka ta atumia a ndigwa.<verse eid="LAM 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 5:4"/>Maaĩ marĩa tũnyuuaga no tũgũrire;</para>
  <para style="q2" vid="LAM 5:4">o na ngũ nĩkũgũra tũragũra.<verse eid="LAM 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 5:5"/>Arĩa matũingatithagia marĩ o magũrũ-inĩ maitũ;</para>
  <para style="q2" vid="LAM 5:5">nĩtũnogete, na tũkaaga ũhurũko.<verse eid="LAM 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 5:6"/>Twĩneanĩte kũrĩ andũ a Misiri na a Ashuri</para>
  <para style="q2" vid="LAM 5:6">nĩgeetha tuone irio cia gũtũigana.<verse eid="LAM 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 5:7"/>Maithe maitũ nĩmehirie na rĩu matirĩ ho,</para>
  <para style="q2" vid="LAM 5:7">na ithuĩ nĩ ithuĩ tũraherithio handũ hao.<verse eid="LAM 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 5:8"/>Ngombo nĩcio itwathaga,</para>
  <para style="q2" vid="LAM 5:8">na gũtirĩ mũndũ wa gũtũteithũra kuuma moko-inĩ ma cio.<verse eid="LAM 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 5:9"/>Tuonaga irio na ũndũ wa gũtwarĩrĩria mĩoyo iitũ ũgwati-inĩ,</para>
  <para style="q2" vid="LAM 5:9">nĩ ũndũ wa rũhiũ rwa njora rũrĩa rũrĩ werũ-inĩ.<verse eid="LAM 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 5:10"/>Gĩkonde giitũ kĩhiũhĩte o ta riiko rĩa kũruga mĩgate,</para>
  <para style="q2" vid="LAM 5:10">tũkainaina nĩ ũndũ wa kũhũũta.<verse eid="LAM 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 5:11"/>Andũ-a-nja nĩmanyiitĩtwo na hinya gũkũ Zayuni,</para>
  <para style="q2" vid="LAM 5:11">nao airĩtu gathirange makanyiitwo na hinya matũũra-inĩ ma Juda.<verse eid="LAM 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 5:12"/>Anene akuo nĩ macuurĩtio na moko mao;</para>
  <para style="q2" vid="LAM 5:12">athuuri nao matiheagwo gĩtĩĩo.<verse eid="LAM 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 5:13"/>Aanake marutithagio wĩra wa hinya ithĩi-inĩ;</para>
  <para style="q2" vid="LAM 5:13">tũmwana natuo tũtũgũũgaga nĩgũkuuithio mĩrigo ya ngũ.<verse eid="LAM 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 5:14"/>Athuuri nĩmatigĩte gũikara kĩhingo-inĩ gĩa itũũra inene;</para>
  <para style="q2" vid="LAM 5:14">aanake nao nĩmatigĩte kũina nyĩmbo ciao.<verse eid="LAM 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 5:15"/>Ngoro ciitũ nĩithirĩte gĩkeno;</para>
  <para style="q2" vid="LAM 5:15">ndũrũhĩ ciitũ igarũrũkĩte igatuĩka macakaya.<verse eid="LAM 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 5:16"/>Thũmbĩ ya ũnene<note caller="+" style="f"><char style="fr" closed="false">5:16 </char><char style="ft" closed="false">Thũmbĩ yonanagia riiri na gĩtĩĩo (Isa 28:1, 3).</char></note> nĩĩgwĩte, ĩgatuuma mũtwe,</para>
  <para style="q2" vid="LAM 5:16">kaĩ tũrĩ na haaro-ĩ, nĩgũkorwo nĩtwĩhĩtie!<verse eid="LAM 5:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 5:17"/>Tondũ ũcio ngoro ciitũ nĩiringĩkĩte;</para>
  <para style="q2" vid="LAM 5:17">na tondũ wa maũndũ macio maitho maitũ makaira,<verse eid="LAM 5:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 5:18"/>tondũ wa Kĩrĩma gĩa Zayuni, kĩrĩa gĩkirĩte ihooru,</para>
  <para style="q2" vid="LAM 5:18">nacio mbwe rĩu nĩkuo iceeraga.<verse eid="LAM 5:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 5:19"/>Wee Jehova-rĩ, wathanaga nginya tene;</para>
  <para style="q2" vid="LAM 5:19">gĩtĩ gĩaku kĩa ũnene gĩtũũraga kuuma njiarwa nginya njiarwa.<verse eid="LAM 5:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 5:20"/>Ũriganagĩrwo nĩ ithuĩ hĩndĩ ciothe nĩkĩ?</para>
  <para style="q2" vid="LAM 5:20">Ũtũtiganĩirie hĩndĩ ndaaya ũguo nĩkĩ?<verse eid="LAM 5:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 5:21"/>Wee Jehova-rĩ, tũcookererie harĩwe, nĩguo tũhote gũgũcookerera;</para>
  <para style="q2" vid="LAM 5:21">erũhia matukũ maitũ macooke o ta ũrĩa matariĩ tene,<verse eid="LAM 5:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 5:22"/>tiga ũkorirwo nĩũtũregeete biũ,</para>
  <para style="q2" vid="LAM 5:22">ũgagĩtũrakarĩra o mũno makĩria.<verse eid="LAM 5:22"/></para>
  <chapter eid="LAM 5"/>
</usx>
