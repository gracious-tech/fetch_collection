<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="GEN" style="id">- Biblica® Open Kikuyu Holy Word of God</book>
  
  <para style="h">Kĩambĩrĩria</para>
  <para style="toc1">Kĩambĩrĩria</para>
  <para style="toc2">Kĩambĩrĩria</para>
  <para style="toc3">Kĩam</para>
  <para style="mt1">KĨAMBĨRĨRIA</para>
  <chapter number="1" style="c" sid="GEN 1" />
  <para style="pi">
    <verse number="1" style="v" sid="GEN 1:1" />Kĩambĩrĩria-inĩ kĩa maũndũ mothe, Ngai nĩombire igũrũ na thĩ. <verse eid="GEN 1:1" /><verse number="2" style="v" sid="GEN 1:2" />Hĩndĩ ĩyo thĩ ndĩarĩ ũrĩa yatariĩ na ndĩarĩ na kĩndũ, nayo nduma yarĩ igũrũ rĩa kũrĩa kũriku, nake Roho wa Ngai aareerete igũrũ rĩa maaĩ.<verse eid="GEN 1:2" /></para>
  <para style="b" />
  <para style="li">
    <verse number="3" style="v" sid="GEN 1:3" />Nake Ngai agĩathana, akiuga atĩrĩ, “Nĩkũgĩe ũtheri,” na gũkĩgĩa ũtheri. <verse eid="GEN 1:3" /><verse number="4" style="v" sid="GEN 1:4" />Ngai akĩona atĩ ũtheri ũcio warĩ mwega, nake akĩgayũkania ũtheri na nduma. <verse eid="GEN 1:4" /><verse number="5" style="v" sid="GEN 1:5" />Ngai agĩĩta ũtheri ũcio “mũthenya,” nayo nduma akĩmĩĩta “ũtukũ.” Na gũkĩgĩa hwaĩ-inĩ, na gũkĩgĩa rũciinĩ. Ũcio ũgĩtuĩka mũthenya wa mbere.<verse eid="GEN 1:5" /></para>
  <para style="li">
    <verse number="6" style="v" sid="GEN 1:6" />Nake Ngai agĩathana, akiuga atĩrĩ, “Nĩkũgĩe wariĩ mũnene gatagatĩ ka maaĩ ũgayũkanie maaĩ na marĩa mangĩ.” <verse eid="GEN 1:6" /><verse number="7" style="v" sid="GEN 1:7" />Nĩ ũndũ ũcio Ngai agĩĩkĩra wariĩ ũcio na akĩgayũkania maaĩ marĩa maarĩ thĩ ya wariĩ ũcio na maaĩ marĩa maarĩ igũrũ rĩaguo. Na gũgĩtuĩka o ũguo. <verse eid="GEN 1:7" /><verse number="8" style="v" sid="GEN 1:8" />Ngai agĩĩta wariĩ ũcio “matu mairũ.” Na gũkĩgĩa hwaĩ-inĩ na gũkĩgĩa rũciinĩ. Ũcio ũgĩtuĩka mũthenya wa keerĩ.<verse eid="GEN 1:8" /></para>
  <para style="li">
    <verse number="9" style="v" sid="GEN 1:9" />Nake Ngai agĩathana, akiuga atĩrĩ, “Maaĩ marĩa marĩ thĩ ya matu mairũ nĩ mongane handũ hamwe na kũgĩe thĩ nyũmũ.” Na gũgĩtuĩka o ũguo. <verse eid="GEN 1:9" /><verse number="10" style="v" sid="GEN 1:10" />Ngai agĩĩta kũrĩa kũmũ “thĩ,” namo maaĩ marĩa maacookanĩrĩire akĩmeeta “maria.” Nake Ngai akĩona atĩ ũndũ ũcio warĩ mwega.<verse eid="GEN 1:10" /></para>
  <para style="pi">
    <verse number="11" style="v" sid="GEN 1:11" />Ningĩ Ngai agĩathana, akiuga atĩrĩ, “Thĩ nĩ ĩmere mĩmera: Mĩmera ĩrĩa ĩciaraga mbeũ, na mĩtĩ ĩrĩa ĩciaraga matunda marĩ na mbeũ thĩinĩ, kũringana na mĩthemba yayo.” Na gũgĩtuĩka o ũguo. <verse eid="GEN 1:11" /><verse number="12" style="v" sid="GEN 1:12" />Thĩ ĩkĩmera mĩmera: Mĩmera ĩgũciara mbeũ kũringana na mĩthemba yayo, na mĩtĩ ĩgũciara matunda marĩ na mbeũ thĩinĩ kũringana na mĩthemba yayo. Nake Ngai akĩona atĩ ũndũ ũcio warĩ mwega. <verse eid="GEN 1:12" /><verse number="13" style="v" sid="GEN 1:13" />Nakuo gũkĩgĩa hwaĩ-inĩ na gũkĩgĩa rũciinĩ. Ũcio ũgĩtuĩka mũthenya wa gatatũ.<verse eid="GEN 1:13" /></para>
  <para style="li">
    <verse number="14" style="v" sid="GEN 1:14" />Ningĩ Ngai agĩathana, akiuga atĩrĩ, “Nĩkũgĩe imũrĩ wariĩ-inĩ wa matu mairũ cia kũgayũkania mũthenya na ũtukũ, na irekwo ituĩke imenyithania cia imera, na mĩthenya na mĩaka. <verse eid="GEN 1:14" /><verse number="15" style="v" sid="GEN 1:15" />Na ituĩke imũrĩ wariĩ-inĩ ũcio wa matu mairũ, itũmage thĩ kũgĩage na ũtheri.” Na gũgĩtuĩka o ũguo. <verse eid="GEN 1:15" /><verse number="16" style="v" sid="GEN 1:16" />Ngai nĩombire imũrĩ igĩrĩ nene. Kĩmũrĩ kĩrĩa kĩnenanene, nĩkĩo riũa, kĩarage mũthenya; nakĩo kĩmũrĩ kĩrĩa kĩninanini, nĩkĩo mweri, kĩarage ũtukũ. O na ningĩ akĩũmba njata. <verse eid="GEN 1:16" /><verse number="17" style="v" sid="GEN 1:17" />Ngai agĩciiga wariĩ-inĩ wa matu mairũ itũmage thĩ kũgĩe ũtheri, <verse eid="GEN 1:17" /><verse number="18" style="v" sid="GEN 1:18" />ciarage mũthenya na ũtukũ, na igayũkanagie nduma na ũtheri. Nake Ngai akĩona atĩ ũndũ ũcio warĩ mwega. <verse eid="GEN 1:18" /><verse number="19" style="v" sid="GEN 1:19" />Na gũkĩgĩa hwaĩ-inĩ na gũkĩgĩa rũciinĩ. Ũcio ũgĩtuĩka mũthenya wa kana.<verse eid="GEN 1:19" /></para>
  <para style="li">
    <verse number="20" style="v" sid="GEN 1:20" />Ningĩ Ngai agĩathana, akiuga atĩrĩ: “Maaĩ nĩmaiyũrwo nĩ ciũmbe irĩ muoyo, nacio nyoni nĩciũmbũkagĩre igũrũ rĩa thĩ gũtuĩkania wariĩ wa matu mairũ.” <verse eid="GEN 1:20" /><verse number="21" style="v" sid="GEN 1:21" />Nĩ ũndũ ũcio Ngai akĩũmba ciũmbe iria nene cia iria-inĩ na kĩũmbe o gĩothe kĩrĩ muoyo na kĩongoyaga, ikĩiyũra maaĩ-inĩ kũringana na mĩthemba yacio, na nyoni o yothe ĩrĩ mathagu kũringana na mũthemba wayo. Nake Ngai akĩona atĩ ũndũ ũcio warĩ mwega. <verse eid="GEN 1:21" /><verse number="22" style="v" sid="GEN 1:22" />Ngai agĩcirathima akiuga atĩrĩ, “Ciaranai mũingĩhe, mũiyũre maaĩ-inĩ marĩa marĩ maria-inĩ, nacio nyoni nĩcingĩhe thĩ.” <verse eid="GEN 1:22" /><verse number="23" style="v" sid="GEN 1:23" />Na gũkĩgĩa hwaĩ-inĩ na gũkĩgĩa rũciinĩ. Ũcio ũgĩtuĩka mũthenya wa gatano.<verse eid="GEN 1:23" /></para>
  <para style="li">
    <verse number="24" style="v" sid="GEN 1:24" />Ningĩ Ngai agĩathana, akiuga atĩrĩ, “Thĩ nĩĩgĩe ciũmbe irĩ muoyo kũringana na mĩthemba yacio: mahiũ, na ciũmbe iria ithiiagĩra thĩ, na nyamũ cia gĩthaka, o nyamũ kũringana na mũthemba wayo.” Na gũgĩtuĩka o ũguo. <verse eid="GEN 1:24" /><verse number="25" style="v" sid="GEN 1:25" />Ngai akĩũmba nyamũ cia gĩthaka kũringana na mĩthemba yacio, na mahiũ kũringana na mĩthemba yamo, na ciũmbe ciothe iria ithiiagĩra thĩ kũringana na mĩthemba yacio. Nake Ngai akĩona atĩ ũndũ ũcio warĩ mwega.<verse eid="GEN 1:25" /></para>
  <para style="pi">
    <verse number="26" style="v" sid="GEN 1:26" />Ningĩ Ngai agĩathana, akiuga atĩrĩ, “Nĩtũũmbei andũ na mũhianĩre witũ, mahaanane na ithuĩ, nao maathage thamaki cia iria na nyoni cia rĩera-inĩ, na mahiũ ma thĩ yothe, na maathage ciũmbe ciothe iria ithiiagĩra thĩ.”<verse eid="GEN 1:26" /></para>
  <para style="qm1">
    <verse number="27" style="v" sid="GEN 1:27" />Nĩ ũndũ ũcio Ngai akĩũmba mũndũ</para>
  <para style="qm2" vid="GEN 1:27">na mũhianĩre wake mwene,</para>
  <para style="qm1" vid="GEN 1:27">akĩmũmba na mũhianĩre wa Ngai;</para>
  <para style="qm2" vid="GEN 1:27">akĩmomba marĩ mũndũ mũrũme na mũndũ-wa-nja.<verse eid="GEN 1:27" /></para>
  <para style="pi">
    <verse number="28" style="v" sid="GEN 1:28" />Ngai akĩmarathima, akĩmeera atĩrĩ, “Ciaranai mũingĩhe, mũiyũre thĩ na mũmĩtoorie. Athagai thamaki cia iria na nyoni cia rĩera-inĩ, na mwathage ciũmbe ciothe irĩ muoyo iria ithiiagĩra thĩ.”<verse eid="GEN 1:28" /></para>
  <para style="pi">
    <verse number="29" style="v" sid="GEN 1:29" />Ningĩ Ngai akiuga atĩrĩ, “Nĩndamũhe mĩmera yothe ya thĩ ĩrĩa ĩciaraga mbeũ, na mũtĩ o wothe ũrĩa ũciaraga matunda marĩ mbeũ thĩinĩ. Ĩyo ĩgũtuĩka irio cianyu. <verse eid="GEN 1:29" /><verse number="30" style="v" sid="GEN 1:30" />Na kũrĩ nyamũ ciothe cia gũkũ thĩ, na nyoni ciothe cia rĩera-inĩ, o na ciũmbe ciothe iria ithiiagĩra thĩ, na kĩndũ o gĩothe kĩrĩ mĩhũmũ ya muoyo-rĩ, ndaacihe mĩmera mĩruru yothe ĩtuĩke irio ciacio.” Na gũgĩtuĩka o ũguo.<verse eid="GEN 1:30" /></para>
  <para style="pi">
    <verse number="31" style="v" sid="GEN 1:31" />Ngai akĩona atĩ kĩndũ kĩrĩa gĩothe oombĩte kĩarĩ kĩega mũno. Nakuo gũkĩgĩa hwaĩ-inĩ na gũkĩgĩa rũciinĩ. Ũcio ũgĩtuĩka mũthenya wa gatandatũ.<verse eid="GEN 1:31" /></para>
  <para style="b" />
  <chapter eid="GEN 1" />
  <chapter number="2" style="c" sid="GEN 2" />
  <para style="pi">
    <verse number="1" style="v" sid="GEN 2:1" />Igũrũ na thĩ ikĩrĩka na ũgemu wacio wothe.<verse eid="GEN 2:1" /></para>
  <para style="b" />
  <para style="li">
    <verse number="2" style="v" sid="GEN 2:2" />Naguo mũthenya wa mũgwanja wakinya, Ngai agĩkorwo arĩkĩtie wĩra ũcio aarutaga; nĩ ũndũ ũcio Ngai akĩhurũka mũthenya ũcio wa mũgwanja kuuma wĩra-inĩ wake wothe. <verse eid="GEN 2:2" /><verse number="3" style="v" sid="GEN 2:3" />Nake Ngai akĩrathima mũthenya ũcio wa mũgwanja na akĩwamũra, tondũ nĩ mũthenya ũrĩa we aahurũkire kuuma wĩra-inĩ wothe ũrĩa aarutĩte wa ũũmbi.<verse eid="GEN 2:3" /></para>
  <para style="s1">Adamu na Hawa</para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 2:4" />Ũcio nĩguo ũhoro ũrĩa wĩgiĩ igũrũ na thĩ rĩrĩa ciombirwo.</para>
  <para style="b" vid="GEN 2:4" />
  <para style="p" vid="GEN 2:4">Rĩrĩa Jehova Ngai ombire thĩ na igũrũ-rĩ, <verse eid="GEN 2:4" /><verse number="5" style="v" sid="GEN 2:5" />gũtiarĩ kahinga o na kamwe ga gĩthaka koonekete thĩ kana mũmera wa gĩthaka ũkamera. Nĩ tondũ Jehova Ngai ndoirĩtie mbura thĩ na gũtiarĩ mũndũ wa kũrĩma mũgũnda, <verse eid="GEN 2:5" /><verse number="6" style="v" sid="GEN 2:6" />no tũrũũĩ twoimaga na thĩ na tũkaihũgia thĩ igũrũ guothe. <verse eid="GEN 2:6" /><verse number="7" style="v" sid="GEN 2:7" />Nake Jehova Ngai akĩũmba mũndũ kuuma rũkũngũ-inĩ rwa thĩ, na akĩmũhuhĩra mĩhũmũ ya muoyo maniũrũ-inĩ make, nake mũndũ ũcio akĩgĩa na muoyo.<verse eid="GEN 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 2:8" />Ningĩ Jehova Ngai nĩathondekete mũgũnda mwena wa irathĩro, o kũu Edeni; na kũu nĩkuo aigire mũndũ ũcio oombĩte. <verse eid="GEN 2:8" /><verse number="9" style="v" sid="GEN 2:9" />Nake Jehova Ngai agĩtũma thĩ ĩmere mĩtĩ ya mĩthemba yothe na ĩkũre. Yarĩ mĩtĩ mĩega ĩkĩoneka na maitho na yaciaraga matunda mega ma kũrĩa. Gatagatĩ ka mũgũnda ũcio nĩ haarĩ na mũtĩ wa muoyo, na mũtĩ wa ũmenyo wa gũkũũrana wega na ũũru.<verse eid="GEN 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 2:10" />Na nĩ kwarĩ rũũĩ rwathereraga ruumĩte Edeni rũkaihũgia mũgũnda ũcio; ruoima Edeni rũkagayũkana rũgatuĩka njũũĩ inya. <verse eid="GEN 2:10" /><verse number="11" style="v" sid="GEN 2:11" />Rũũĩ rwa mbere rwĩtagwo Pishoni; na nĩruo rũthiũrũrũkaga bũrũri wothe wa Havila, kũrĩa kũrĩ thahabu. <verse eid="GEN 2:11" /><verse number="12" style="v" sid="GEN 2:12" />(Thahabu ya bũrũri ũcio nĩ njega; ningĩ kũu no kũrĩ maguta manungi wega metagwo bendora, na tũhiga twa goro twĩtagwo onigithi.) <verse eid="GEN 2:12" /><verse number="13" style="v" sid="GEN 2:13" />Rũũĩ rwa keerĩ rwĩtagwo Gihoni; naruo rũthiũrũrũkaga bũrũri wothe wa Kushi.<note caller="+" style="f"><char style="fr" closed="false">2:13 </char><char style="ft" closed="false">Kushi thĩinĩ wa Kĩrĩkanĩro kĩrĩa Gĩkũrũ nĩ rĩĩtwa rĩa Kĩhibirania rĩa Sudani kana Ethiopia.</char></note> <verse eid="GEN 2:13" /><verse number="14" style="v" sid="GEN 2:14" />Rũũĩ rwa gatatũ rwĩtagwo Hidekela naruo rũgeragĩra mwena wa irathĩro wa bũrũri wa Ashuri. Naruo rũũĩ rwa kana rwĩtagwo Farati.<verse eid="GEN 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 2:15" />Jehova Ngai akĩoya mũndũ ũcio oombĩte, akĩmũiga mũgũnda-inĩ ũcio wa Edeni aũrĩmage na aũmenyagĩrĩre. <verse eid="GEN 2:15" /><verse number="16" style="v" sid="GEN 2:16" />Nake Jehova Ngai agĩatha mũndũ ũcio, akĩmwĩra atĩrĩ, “No ũrĩe maciaro ma mũtĩ o wothe ũrĩ mũgũnda ũyũ; <verse eid="GEN 2:16" /><verse number="17" style="v" sid="GEN 2:17" />no rĩrĩ, ndũkanarĩe maciaro ma mũtĩ ũrĩa wa ũmenyo wa gũkũũrana wega na ũũru, nĩgũkorwo rĩrĩa ũkaamarĩa, ti-itherũ no gũkua ũgaakua.”<verse eid="GEN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 2:18" />Ningĩ Jehova Ngai akiuga atĩrĩ, “Ti wega mũndũ ũyũ aikare arĩ wiki. Nĩngũmũmbĩra mũteithia ũrĩa ũmwagĩrĩire.”<verse eid="GEN 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 2:19" />Na rĩrĩ, Jehova Ngai nĩ oombĩte nyamũ ciothe cia gĩthaka na nyoni cia rĩera-inĩ kuuma tĩĩri-inĩ. Agĩcirehe kũrĩ mũndũ ũcio one marĩĩtwa marĩa egũcitua; na ũrĩa mũndũ ũcio aatuire kĩũmbe o gĩothe kĩ muoyo, rĩu rĩgĩtuĩka rĩĩtwa rĩakĩo. <verse eid="GEN 2:19" /><verse number="20" style="v" sid="GEN 2:20" />Nĩ ũndũ ũcio mũndũ ũcio akĩhe mahiũ mothe marĩĩtwa, o na nyoni cia rĩera-inĩ na nyamũ ciothe cia gĩthaka.</para>
  <para style="p" vid="GEN 2:20">No Adamu ndooneirwo mũteithia ũmwagĩrĩire. <verse eid="GEN 2:20" /><verse number="21" style="v" sid="GEN 2:21" />Nĩ ũndũ ũcio Jehova Ngai agĩtũma mũndũ ũcio akome toro mũnene mũno; na rĩrĩa aakomete, Jehova Ngai akĩruta rũbaru rũmwe rwa mũndũ ũcio na agĩcookia nyama hau rwarĩ. <verse eid="GEN 2:21" /><verse number="22" style="v" sid="GEN 2:22" />Hĩndĩ ĩyo Jehova Ngai akĩũmba mũndũ-wa-nja kuuma rũbaru rũrĩa aarutĩte kũrĩ mũndũ ũcio na akĩrehe mũndũ-wa-nja ũcio kũrĩ we.<verse eid="GEN 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 2:23" />Mũndũ ũcio akiuga atĩrĩ,</para>
  <para style="q1" vid="GEN 2:23">“Hĩ! Rĩu-rĩ, rĩĩrĩ nĩ ihĩndĩ kuuma mahĩndĩ makwa,</para>
  <para style="q2" vid="GEN 2:23">na nyama cia mwĩrĩ wakwa.</para>
  <para style="q1" vid="GEN 2:23">Arĩĩtagwo mũndũ-wa-nja,</para>
  <para style="q2" vid="GEN 2:23">tondũ aarutirwo kuuma kũrĩ mũndũ mũrũme.”<verse eid="GEN 2:23" /></para>
  <para style="m">
    <verse number="24" style="v" sid="GEN 2:24" />Gĩkĩ nĩkĩo gĩtũmaga mũndũ mũrũme atige ithe na nyina, na anyiitane na mũtumia wake, nao magatuĩka mwĩrĩ ũmwe.<verse eid="GEN 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 2:25" />Acio eerĩ, mũndũ ũcio na mũtumia wake, maarĩ njaga, na matiaconokaga.<verse eid="GEN 2:25" /></para>
  <chapter eid="GEN 2" />
  <chapter number="3" style="c" sid="GEN 3" />
  <para style="s1">Kũgũa kwa Mũndũ Mehia-inĩ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 3:1" />Na rĩrĩ, nyoka yarĩ na wara mũingĩ gũkĩra nyamũ ciothe cia gĩthaka iria Jehova Ngai oombĩte. Nyoka ĩyo ĩkĩũria mũndũ-wa-nja ũcio atĩrĩ, “Ti-itherũ Ngai nĩ oigire mũtikanarĩe maciaro kuuma mũtĩ o wothe wa mũgũnda ũyũ?”<verse eid="GEN 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 3:2" />Mũndũ-wa-nja ũcio agĩcookeria nyoka ĩyo atĩrĩ, “No tũrĩe matunda ma mĩtĩ ĩrĩa ĩrĩ mũgũnda ũyũ, <verse eid="GEN 3:2" /><verse number="3" style="v" sid="GEN 3:3" />no Ngai aatwĩrire atĩrĩ, ‘Mũtikanarĩe matunda ma mũtĩ ũrĩa ũrĩ gatagatĩ ka mũgũnda ũyũ, na mũtikanaũhutie, nĩguo mũtigakue.’ ”<verse eid="GEN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 3:4" />No nyoka ĩkĩĩra mũndũ-wa-nja ũcio atĩrĩ, “Ti-itherũ mũtingĩkua. <verse eid="GEN 3:4" /><verse number="5" style="v" sid="GEN 3:5" />No Ngai nĩoĩ atĩ rĩrĩa mũkaarĩa matunda macio, maitho manyu nĩmakahingũka, mũtuĩke o ta Ngai, mũmenyage wega na ũũru.”<verse eid="GEN 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 3:6" />Rĩrĩa mũndũ-wa-nja ũcio onire atĩ matunda ma mũtĩ ũcio maarĩ mega ma kũrĩa, na ma kwendeka makĩonwo na maitho, o na ma kwĩrirĩrio nĩ ũndũ wa kũũhĩgia mũndũ, agĩtua mamwe, akĩrĩa. Agĩcooka akĩhe mũthuuri wake, ũrĩa maarĩ nake, nake akĩrĩa. <verse eid="GEN 3:6" /><verse number="7" style="v" sid="GEN 3:7" />Hĩndĩ ĩyo maitho mao eerĩ makĩhingũka, nao makĩmenya atĩ maarĩ njaga; nĩ ũndũ ũcio magĩtumania mathangũ ma mũkũyũ, magĩĩthondekera kĩndũ gĩa kũhumbĩra njaga yao.<verse eid="GEN 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 3:8" />Hwaĩ-inĩ rĩrĩa riũa rĩarurĩte-rĩ, mũndũ ũcio na mũtumia wake makĩigua makinya ma Jehova Ngai agĩceera kũu mũgũnda-inĩ, nao makĩĩhitha mĩtĩ-inĩ ya mũgũnda nĩguo Jehova Ngai ndakamone. <verse eid="GEN 3:8" /><verse number="9" style="v" sid="GEN 3:9" />No Jehova Ngai agĩĩta mũndũ ũcio, akĩmũũria atĩrĩ, “Ũrĩ ha?”<verse eid="GEN 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 3:10" />Nake akĩmũcookeria atĩrĩ, “Niĩ ngũiguire ũgĩceera mũgũnda-inĩ ndeetigĩra tondũ nyuma njaga; nĩ ũndũ ũcio ndeehitha.”<verse eid="GEN 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 3:11" />Nake Jehova akĩmũũria atĩrĩ, “Nũũ ũkwĩrire atĩ ũrĩ njaga? Kaĩ ũrĩĩte matunda ma mũtĩ ũrĩa ndagwaathire ngĩkwĩra ndũkanaũrĩe?”<verse eid="GEN 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 3:12" />Mũndũ ũcio akiuga atĩrĩ, “Mũndũ-wa-nja ũrĩa waheire ndũũranie nake nĩwe ũũheire matunda mamwe ma mũtĩ ũcio, na niĩ ndarĩa.”<verse eid="GEN 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 3:13" />Nake Jehova Ngai akĩũria mũndũ-wa-nja ũcio atĩrĩ, “Atĩ nĩ atĩa wĩkĩte?”</para>
  <para style="p" vid="GEN 3:13">Mũndũ-wa-nja ũcio akiuga atĩrĩ, “Nĩ nyoka ĩheenirie na niĩ ndarĩa matunda macio.”<verse eid="GEN 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 3:14" />Nĩ ũndũ ũcio Jehova Ngai akĩĩra nyoka atĩrĩ, “Tondũ nĩwĩkĩte ũguo-rĩ,</para>
  <para style="q1" vid="GEN 3:14">“Wee ũrogwatwo nĩ kĩrumi gũkĩra mahiũ mothe</para>
  <para style="q2" vid="GEN 3:14">na gũkĩra nyamũ ciothe cia gĩthaka!</para>
  <para style="q1" vid="GEN 3:14">Ũrĩthiiaga na nda,</para>
  <para style="q2" vid="GEN 3:14">na ũrĩrĩĩaga rũkũngũ matukũ mothe ma muoyo waku.<verse eid="GEN 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="GEN 3:15" />Na nĩngũtũma kũgĩe ũthũ gatagatĩ gaku na mũndũ-wa-nja ũyũ,</para>
  <para style="q2" vid="GEN 3:15">na gatagatĩ ka rũciaro rwaku na rwake;</para>
  <para style="q1" vid="GEN 3:15">nake nĩagakũhehenja mũtwe,</para>
  <para style="q2" vid="GEN 3:15">nawe nĩũkamũgũtha ndiira ya kũgũrũ gwake.”<verse eid="GEN 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 3:16" />Ningĩ akĩĩra mũndũ-wa-nja ũcio atĩrĩ,</para>
  <para style="q1" vid="GEN 3:16">“Nĩngũkũingĩhĩria ruo mũno hĩndĩ ya gũciara;</para>
  <para style="q2" vid="GEN 3:16">ũrĩciaraga ciana na ruo.</para>
  <para style="q1" vid="GEN 3:16">Merirĩria maku marĩkoragwo marĩ harĩ mũthuuriguo,</para>
  <para style="q2" vid="GEN 3:16">nake nĩarĩgwathaga.”<verse eid="GEN 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 3:17" />Ningĩ Ngai akĩĩra Adamu atĩrĩ, “Tondũ nĩwathĩkĩire mũtumia waku, na warĩa matunda ma mũtĩ ũrĩa ndagwaathire, ngĩkwĩra atĩ, ‘Ndũkanarĩe,’</para>
  <para style="q1" vid="GEN 3:17">“Thĩ nĩyarumwo nĩ ũndũ waku;</para>
  <para style="q2" vid="GEN 3:17">ũrĩrĩĩaga irio ciayo na ruo rwa mĩnoga matukũ mothe ma muoyo waku.<verse eid="GEN 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="GEN 3:18" />Ĩrĩgũciaragĩra mĩigua na mahiũ ma nyeki-inĩ,</para>
  <para style="q2" vid="GEN 3:18">nawe ũrĩrĩĩaga mĩmera ya mũgũnda.<verse eid="GEN 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="GEN 3:19" />Ũrĩrĩĩaga irio cia thithino ya mĩnoga yaku,</para>
  <para style="q1" vid="GEN 3:19">o nginya rĩrĩa ũgaacooka tĩĩri-inĩ,</para>
  <para style="q2" vid="GEN 3:19">tondũ nokuo warutĩtwo;</para>
  <para style="q1" vid="GEN 3:19">tondũ wee ũrĩ rũkũngũ</para>
  <para style="q2" vid="GEN 3:19">na ũgaacooka o rũkũngũ-inĩ.”<verse eid="GEN 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 3:20" />Adamu agĩĩta mũtumia wake Hawa, tondũ nĩwe watuĩkire nyina wa arĩa othe matũũraga muoyo.<verse eid="GEN 3:20" /></para>
  <para style="s1">Ngai kũingata Adamu na Hawa kuuma Edeni</para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 3:21" />Jehova Ngai agĩthondekera Adamu na mũtumia wake nguo cia njũũa, akĩmahumba. <verse eid="GEN 3:21" /><verse number="22" style="v" sid="GEN 3:22" />Nake Jehova Ngai akiuga atĩrĩ, “Mũndũ ũyũ nĩatuĩkĩte o ta ũmwe witũ, akamenya wega na ũũru. Ndagĩrĩire gwĩtĩkĩrio atue matunda ma mũtĩ wa muoyo o namo, amarĩe nake atũũre nginya tene.” <verse eid="GEN 3:22" /><verse number="23" style="v" sid="GEN 3:23" />Nĩ ũndũ ũcio Jehova Ngai akĩmũingata kuuma Mũgũnda wa Edeni athiĩ akarĩmage tĩĩri-inĩ kũrĩa aarutĩtwo. <verse eid="GEN 3:23" /><verse number="24" style="v" sid="GEN 3:24" />Ngai aarĩkia kũrutũrũra mũndũ ũcio-rĩ, akĩiga akerubi mwena wa irathĩro wa Mũgũnda wa Edeni, o na rũhiũ rwa njora rwarĩrĩmbũkaga mwaki na rwahenagia mbarĩ ciothe, nĩ ũndũ wa kũgitĩra njĩra ya gũthiĩ mũtĩ-inĩ ũcio wa muoyo.<verse eid="GEN 3:24" /></para>
  <chapter eid="GEN 3" />
  <chapter number="4" style="c" sid="GEN 4" />
  <para style="s1">Kaini na Habili</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 4:1" />Nake Adamu agĩkoma na mũtumia wake Hawa, nake akĩgĩa nda, agĩciara Kaini. Nake akiuga atĩrĩ, “Ndĩkũgĩa na mwana wa kahĩĩ nĩ ũndũ wa gũteithio nĩ Jehova.” <verse eid="GEN 4:1" /><verse number="2" style="v" sid="GEN 4:2" />Thuutha ũcio agĩciara Habili, mũrũ wa nyina.</para>
  <para style="p" vid="GEN 4:2">Habili aarĩ mũrĩithi wa mbũri nake Kaini aarĩ mũrĩmi. <verse eid="GEN 4:2" /><verse number="3" style="v" sid="GEN 4:3" />Maikarĩte kwa ihinda-rĩ, Kaini akĩrehe maciaro mamwe ma mũgũnda marĩ igongona kũrĩ Jehova. <verse eid="GEN 4:3" /><verse number="4" style="v" sid="GEN 4:4" />No Habili akĩrehe marigithathi mamwe marĩa manoru ma rũũru rwake. Nake Jehova agĩkenio nĩ Habili na igongona rĩake, <verse eid="GEN 4:4" /><verse number="5" style="v" sid="GEN 4:5" />no ndaakenirio nĩ Kaini na igongona rĩake. Nĩ ũndũ ũcio Kaini akĩrakara mũno, na agĩtukia gĩthiithi.<verse eid="GEN 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 4:6" />Nake Jehova Ngai akĩũria Kaini atĩrĩ, “Ũrakarĩte nĩkĩ? Na nĩ kĩĩ gĩtũmĩte ũtukie gĩthiithi? <verse eid="GEN 4:6" /><verse number="7" style="v" sid="GEN 4:7" />Ũngĩka ũrĩa kwagĩrĩire-rĩ, no wage gwĩtĩkĩrĩka? No ũngĩaga gwĩka ũrĩa kwagĩrĩire-rĩ, mehia makuoheirie mũrango-inĩ waku makĩenda gũgwatha; no wee no nginya ũmatoorie.”<verse eid="GEN 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 4:8" />Thuutha ũcio Kaini akĩĩra mũrũ wa nyina Habili atĩrĩ, “Nĩtumagare tũthiĩ mũgũnda.” Na rĩrĩa maarĩ kũu mũgũnda, Kaini agĩtharĩkĩra mũrũ wa nyina Habili, akĩmũũraga.<verse eid="GEN 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 4:9" />Nake Jehova akĩũria Kaini atĩrĩ, “Arĩ ha mũrũ-wa-nyũkwa Habili?”</para>
  <para style="p" vid="GEN 4:9">Nake akĩmũcookeria atĩrĩ, “Niĩ ndiũĩ, kaĩ arĩ niĩ mũmenyereri wa mũrũ-wa-maitũ?”<verse eid="GEN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 4:10" />Jehova akĩmũũria atĩrĩ, “Nĩ atĩa wĩkĩte? Ta thikĩrĩria! Thakame ya mũrũ-wa-nyũkwa nĩĩrangaĩra ĩrĩ tĩĩri-inĩ. <verse eid="GEN 4:10" /><verse number="11" style="v" sid="GEN 4:11" />Na rĩrĩ, nĩũgwatĩtwo nĩ kĩrumi na ũkaingatwo mũgũnda ũrĩa waathamirie kanua kaguo kwamũkĩra thakame ya mũrũ-wa-nyũkwa kuuma guoko-inĩ gwaku. <verse eid="GEN 4:11" /><verse number="12" style="v" sid="GEN 4:12" />Rĩrĩa ũrĩũrĩmaga-rĩ, ndũgacooka gũgũciarĩra maciaro maguo. Ũgũtuĩka mũndũ ũtakindagĩria, wa kũũrũũraga gũkũ thĩ.”<verse eid="GEN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 4:13" />Nake Kaini akĩĩra Jehova atĩrĩ, “Iherithia rĩakwa nĩ inene gũkĩra ũrĩa ingĩhota gwĩtiiria. <verse eid="GEN 4:13" /><verse number="14" style="v" sid="GEN 4:14" />Ũmũthĩ ũyũ nĩũranyingata kuuma mũgũnda ũyũ na ndũũre hithĩtwo ũthiũ waku; ngũtuĩka mũndũ ũtakindagĩria, wa kũũrũũraga gũkũ thĩ, na ũrĩa wothe ũkaanyona nĩakanjũraga.”<verse eid="GEN 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 4:15" />No Jehova akĩmwĩra atĩrĩ, “Aca, ti ũguo; mũndũ o na ũrĩkũ angĩkooraga Kaini, nĩakarĩhio maita mũgwanja.” Jehova agĩcooka agĩĩkĩra Kaini rũũri nĩgeetha ũrĩa wothe ũngĩmuona ndakamũũrage! <verse eid="GEN 4:15" /><verse number="16" style="v" sid="GEN 4:16" />Nĩ ũndũ ũcio Kaini akĩehera akiuma harĩ Jehova, na agĩtũũra bũrũri-inĩ wa Nodu, mwena wa irathĩro rĩa Edeni.<verse eid="GEN 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 4:17" />Kaini agĩkoma na mũtumia wake, na akĩgĩa nda, agĩciara Enoku. Hĩndĩ ĩyo Kaini nĩakaga itũũra inene, na aarĩkia kũrĩaka, akĩrĩĩta Enoku o ta ũrĩa mũriũ eetagwo. <verse eid="GEN 4:17" /><verse number="18" style="v" sid="GEN 4:18" />Nake Enoku agĩciarĩrwo Iradu, nake Iradu aarĩ ithe wa Mehujaeli, nake Mehujaeli aarĩ ithe wa Methushaeli, nake Methushaeli aarĩ ithe wa Lameku.<verse eid="GEN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 4:19" />Lameku ũcio akĩhikia andũ-a-nja eerĩ, ũmwe eetagwo Ada na ũrĩa ũngĩ eetagwo Zila. <verse eid="GEN 4:19" /><verse number="20" style="v" sid="GEN 4:20" />Ada agĩciara Jabali; na nĩwe ithe wa andũ arĩa matũũraga hema-inĩ na marĩithagia mahiũ. <verse eid="GEN 4:20" /><verse number="21" style="v" sid="GEN 4:21" />Mũrũ-wa nyina eetagwo Jubali; nake nĩwe ithe wa andũ arĩa othe mahũũraga inanda cia mũgeeto na makahuha mĩtũrirũ. <verse eid="GEN 4:21" /><verse number="22" style="v" sid="GEN 4:22" />Zila o nake aarĩ na mũriũ, nake eetagwo Tubali-Kaini, na nĩwe waturaga indo cia mĩthemba yothe cia gĩcango na cia kĩgera. Tubali-Kaini aarĩ na mwarĩ wa nyina wetagwo Naama.<verse eid="GEN 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 4:23" />Lameku akĩĩra atumia ake atĩrĩ,</para>
  <para style="q1" vid="GEN 4:23">“Ada na Zila, taa thikĩrĩriai;</para>
  <para style="q2" vid="GEN 4:23">inyuĩ atumia a Lameku, ta iguai ciugo ciakwa.</para>
  <para style="q1" vid="GEN 4:23">Nĩnjũragĩte mũndũ nĩ ũndũ wa kũndiihia,</para>
  <para style="q2" vid="GEN 4:23">ngooraga mũndũ mwĩthĩ nĩ ũndũ wa kũnguraria.<verse eid="GEN 4:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="GEN 4:24" />Angĩkorwo Kaini arĩhagĩrio maita mũgwanja-rĩ,</para>
  <para style="q2" vid="GEN 4:24">Lameku nake akarĩhĩrio maita mĩrongo mũgwanja na mũgwanja.”<verse eid="GEN 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 4:25" />Nake Adamu agĩkoma na mũtumia wake rĩngĩ, nake agĩciara kaana ga kahĩĩ, na agĩgatua Sethi, akiuga atĩrĩ, “Ngai nĩaheete mwana ũngĩ handũ ha Habili, ũrĩa Kaini ooragire.” <verse eid="GEN 4:25" /><verse number="26" style="v" sid="GEN 4:26" />Sethi o nake aarĩ na mũriũ wake, nake akĩmũtua rĩĩtwa Enoshu.</para>
  <para style="p" vid="GEN 4:26">Hĩndĩ ĩyo nĩrĩo andũ mambĩrĩirie gũkaĩra rĩĩtwa rĩa Jehova.<verse eid="GEN 4:26" /></para>
  <chapter eid="GEN 4" />
  <chapter number="5" style="c" sid="GEN 5" />
  <para style="s1">Njiarwa cia Adamu</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 5:1" />Ũyũ nĩguo ũhoro ũrĩa wandĩkĩtwo wĩgiĩ njiarwa cia Adamu.</para>
  <para style="b" vid="GEN 5:1" />
  <para style="p" vid="GEN 5:1">Hĩndĩ ĩrĩa Ngai oombire mũndũ-rĩ, amũũmbire na mũhianĩre wa Ngai. <verse eid="GEN 5:1" /><verse number="2" style="v" sid="GEN 5:2" />Ngai aamoombire mũndũ mũrũme na mũndũ-wa-nja na akĩmarathima. Na aarĩkia kũmomba, akĩmeeta “mũndũ.”<verse eid="GEN 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 5:3" />Adamu aakinyia mĩaka igana na mĩrongo ĩtatũ-rĩ, akĩgĩa na mũriũ wamũtũkĩtie na wa mũhianĩre wake; nake akĩmũtua Sethi. <verse eid="GEN 5:3" /><verse number="4" style="v" sid="GEN 5:4" />Na thuutha wa Sethi gũciarwo-rĩ, Adamu agĩtũũra muoyo mĩaka ĩngĩ magana manana, na akĩgĩa na ciana ingĩ cia aanake na cia airĩtu. <verse eid="GEN 5:4" /><verse number="5" style="v" sid="GEN 5:5" />Mĩaka yothe ĩrĩa Adamu aatũũrire muoyo yarĩ mĩaka magana kenda na mĩrongo ĩtatũ, agĩcooka agĩkua.<verse eid="GEN 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 5:6" />Sethi aakinyia mĩaka igana na ĩtano-rĩ, akĩgĩa na mũriũ wetagwo Enoshu. <verse eid="GEN 5:6" /><verse number="7" style="v" sid="GEN 5:7" />Na thuutha wa Enoshu gũciarwo-rĩ, Sethi agĩtũũra muoyo mĩaka ĩngĩ magana manana na mũgwanja na akĩgĩa na ciana ingĩ cia aanake na cia airĩtu. <verse eid="GEN 5:7" /><verse number="8" style="v" sid="GEN 5:8" />Mĩaka yothe ĩrĩa Sethi aatũũrire muoyo yarĩ mĩaka magana kenda na ikũmi na ĩĩrĩ, agĩcooka agĩkua.<verse eid="GEN 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 5:9" />Enoshu aakinyia mĩaka mĩrongo kenda-rĩ, akĩgĩa na mũriũ wetagwo Kenani. <verse eid="GEN 5:9" /><verse number="10" style="v" sid="GEN 5:10" />Na thuutha wa Kenani gũciarwo-rĩ, Enoshu agĩtũũra muoyo mĩaka ĩngĩ magana manana na ikũmi na ĩtano, na akĩgĩa na ciana ingĩ cia aanake na cia airĩtu. <verse eid="GEN 5:10" /><verse number="11" style="v" sid="GEN 5:11" />Mĩaka yothe ĩrĩa Enoshu aatũũrire muoyo yarĩ mĩaka magana kenda na ĩtano, agĩcooka agĩkua.<verse eid="GEN 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 5:12" />Kenani aakinyia mĩaka mĩrongo mũgwanja-rĩ, akĩgĩa na mũriũ wetagwo Mahalaleli. <verse eid="GEN 5:12" /><verse number="13" style="v" sid="GEN 5:13" />Na thuutha wa Mahalaleli gũciarwo-rĩ, Kenani agĩtũũra muoyo mĩaka ĩngĩ magana manana na mĩrongo ĩna, na akĩgĩa na ciana ingĩ cia aanake na cia airĩtu. <verse eid="GEN 5:13" /><verse number="14" style="v" sid="GEN 5:14" />Mĩaka yothe ĩrĩa Kenani aatũũrire muoyo yarĩ mĩaka magana kenda na ikũmi, agĩcooka agĩkua.<verse eid="GEN 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 5:15" />Mahalaleli aakinyia mĩaka mĩrongo ĩtandatũ na ĩtano-rĩ, akĩgĩa na mũriũ wetagwo Jaredi. <verse eid="GEN 5:15" /><verse number="16" style="v" sid="GEN 5:16" />Na thuutha wa Jaredi gũciarwo-rĩ, Mahalaleli agĩtũũra muoyo mĩaka ĩngĩ magana manana na mĩrongo ĩtatũ, na akĩgĩa na ciana ingĩ cia aanake na cia airĩtu. <verse eid="GEN 5:16" /><verse number="17" style="v" sid="GEN 5:17" />Mĩaka yothe ĩrĩa Mahalaleli aatũũrire muoyo yarĩ mĩaka magana manana na mĩrongo kenda na ĩtano, agĩcooka agĩkua.<verse eid="GEN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 5:18" />Jaredi aakinyia mĩaka igana na mĩrongo ĩtandatũ na ĩĩrĩ-rĩ, akĩgĩa na mũriũ wetagwo Enoku. <verse eid="GEN 5:18" /><verse number="19" style="v" sid="GEN 5:19" />Na thuutha wa Enoku gũciarwo-rĩ, Jaredi agĩtũũra muoyo mĩaka ĩngĩ magana manana, na akĩgĩa na ciana ingĩ cia aanake na cia airĩtu. <verse eid="GEN 5:19" /><verse number="20" style="v" sid="GEN 5:20" />Mĩaka yothe ĩrĩa Jaredi aatũũrire muoyo yarĩ mĩaka magana kenda na mĩrongo ĩtandatũ na ĩĩrĩ, agĩcooka agĩkua.<verse eid="GEN 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 5:21" />Enoku aakinyia mĩaka mĩrongo ĩtandatũ na ĩtano-rĩ, akĩgĩa na mũriũ wetagwo Methusela. <verse eid="GEN 5:21" /><verse number="22" style="v" sid="GEN 5:22" />Na thuutha wa Methusela gũciarwo-rĩ, Enoku agĩtũũra atwaranaga na Ngai mĩaka magana matatũ, akĩgĩa na ciana ingĩ cia aanake na cia airĩtu. <verse eid="GEN 5:22" /><verse number="23" style="v" sid="GEN 5:23" />Mĩaka yothe ĩrĩa Enoku aatũũrire muoyo yarĩ mĩaka magana matatũ na mĩrongo ĩtandatũ na ĩtano. <verse eid="GEN 5:23" /><verse number="24" style="v" sid="GEN 5:24" />Enoku agĩtwarana na Ngai nginya akĩagwo tondũ Ngai nĩamuoire.<verse eid="GEN 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 5:25" />Methusela aakinyia mĩaka igana na mĩrongo ĩnana na mũgwanja-rĩ, akĩgĩa na mũriũ wetagwo Lameku. <verse eid="GEN 5:25" /><verse number="26" style="v" sid="GEN 5:26" />Na thuutha wa Lameku gũciarwo-rĩ, Methusela agĩtũũra muoyo mĩaka ĩngĩ magana mũgwanja na mĩrongo ĩnana na ĩĩrĩ, na akĩgĩa na ciana ingĩ cia aanake na cia airĩtu. <verse eid="GEN 5:26" /><verse number="27" style="v" sid="GEN 5:27" />Mĩaka yothe ĩrĩa Methusela aatũũrire muoyo yarĩ mĩaka magana kenda na mĩrongo ĩtandatũ na kenda, agĩcooka agĩkua.<verse eid="GEN 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 5:28" />Lameku aakinyia mĩaka igana na mĩrongo ĩnana na ĩĩrĩ-rĩ, akĩgĩa mwana wa kahĩĩ. <verse eid="GEN 5:28" /><verse number="29" style="v" sid="GEN 5:29" />Nake agĩgatua Nuhu, akiuga atĩrĩ, “Nĩarĩtũhooragĩria ruo rwa wĩra na mĩnoga ya moko maitũ rĩrĩa tũkũrĩma, tondũ Jehova nĩarumire thĩ.”<verse eid="GEN 5:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 5:30" />Thuutha wa Nuhu gũciarwo-rĩ, Lameku agĩtũũra muoyo mĩaka ĩngĩ magana matano na mĩrongo kenda na ĩtano, na akĩgĩa na ciana ingĩ cia aanake na cia airĩtu. <verse eid="GEN 5:30" /><verse number="31" style="v" sid="GEN 5:31" />Mĩaka yothe ĩrĩa Lameku aatũũrire muoyo yarĩ mĩaka magana mũgwanja na mĩrongo mũgwanja na mũgwanja, agĩcooka agĩkua.<verse eid="GEN 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 5:32" />Nuhu aakinyia ũkũrũ wa mĩaka magana matano-rĩ, akĩgĩa na ariũ ake na nĩo Shemu, na Hamu na Jafethu.<verse eid="GEN 5:32" /></para>
  <chapter eid="GEN 5" />
  <chapter number="6" style="c" sid="GEN 6" />
  <para style="s1">Mũiyũro wa Maaĩ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 6:1" />Rĩrĩa andũ maambĩrĩirie kũingĩha thĩ na magĩciarĩrwo airĩtu-rĩ, <verse eid="GEN 6:1" /><verse number="2" style="v" sid="GEN 6:2" />ariũ a Ngai makĩona atĩ airĩtu a andũ maarĩ athaka, nao makĩhikia o ũrĩa mũndũ ethuuragĩra. <verse eid="GEN 6:2" /><verse number="3" style="v" sid="GEN 6:3" />Nake Jehova akiuga atĩrĩ, “Roho wakwa ndegũtũũra agianaga na mũndũ nginya tene, tondũ mũndũ nĩ wa gũkua; matukũ make marĩkoragwo marĩ mĩaka igana na mĩrongo ĩĩrĩ.”<verse eid="GEN 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 6:4" />Na rĩrĩ, matukũ-inĩ macio, o na thuutha ũcio, rĩrĩa Anefili matũũraga gũkũ thĩ, nĩrĩo ariũ a Ngai maakomire na airĩtu a andũ na magĩciara ciana nao. Ciana icio nĩcio ciarĩ njamba cia tene na andũ arĩa maarĩ igweta.<verse eid="GEN 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 6:5" />Jehova akĩona ũrĩa waganu wa andũ waingĩhĩte gũkũ thĩ, na atĩ merirĩria ma meciiria ma ngoro ciao maarĩ mooru hĩndĩ ciothe. <verse eid="GEN 6:5" /><verse number="6" style="v" sid="GEN 6:6" />Jehova akĩnyiitwo nĩ kĩeha nĩ ũndũ wa kũũmba mũndũ gũkũ thĩ, na ngoro yake ĩkĩiyũrwo nĩ ruo. <verse eid="GEN 6:6" /><verse number="7" style="v" sid="GEN 6:7" />Nĩ ũndũ ũcio Jehova akiuga atĩrĩ, “Nĩngũniina andũ, o arĩa niĩ ndombire, mathire kuuma thĩ, andũ na nyamũ, na ciũmbe iria ithiiagĩra thĩ, o na nyoni cia rĩera-inĩ, nĩgũkorwo ndĩ na kĩeha nĩ ũndũ wa gũciũmba.” <verse eid="GEN 6:7" /><verse number="8" style="v" sid="GEN 6:8" />No Nuhu agĩĩtĩkĩrĩka maitho-inĩ ma Jehova.<verse eid="GEN 6:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="GEN 6:9" />Ũyũ nĩguo ũhoro wa Nuhu.</para>
  <para style="b" vid="GEN 6:9" />
  <para style="p" vid="GEN 6:9">Nuhu aarĩ mũndũ mũthingu, ũtaarĩ na ũcuuke kũrĩ andũ a hĩndĩ yake, na nĩatwaranaga na Ngai. <verse eid="GEN 6:9" /><verse number="10" style="v" sid="GEN 6:10" />Nuhu aarĩ na ariũ atatũ: nĩo Shemu, na Hamu na Jafethu.<verse eid="GEN 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 6:11" />Thĩ nayo yarĩ thũku maitho-inĩ ma Jehova na yaiyũrĩtwo nĩ maũndũ ma ũhinya. <verse eid="GEN 6:11" /><verse number="12" style="v" sid="GEN 6:12" />Ngai nĩonire ũrĩa thĩ yathũkĩte, nĩgũkorwo andũ othe a thĩ nĩmathũkĩtie mĩthiĩre yao. <verse eid="GEN 6:12" /><verse number="13" style="v" sid="GEN 6:13" />Nĩ ũndũ ũcio Jehova akĩĩra Nuhu atĩrĩ, “Nĩnduĩte itua kũniina andũ aya othe, nĩgũkorwo thĩ nĩ ĩiyũrĩtwo nĩ maũndũ ma ũhinya nĩ ũndũ wao. Ti-itherũ nĩngũmaniinanĩria hamwe na thĩ. <verse eid="GEN 6:13" /><verse number="14" style="v" sid="GEN 6:14" />Nĩ ũndũ ũcio-rĩ, wĩyakĩre thabina ya mĩtĩ ya mĩthithinda; na ũthondeke tũnyũmba thĩinĩ, na ũmĩhake rami thĩinĩ na nja. <verse eid="GEN 6:14" /><verse number="15" style="v" sid="GEN 6:15" />Na ũkũmĩaka ũũ: Ũraihu wa thabina ũkorwo ũrĩ buti magana mana na mĩrongo ĩtano, na wariĩ wa buti mĩrongo mũgwanja na ithano na buti mĩrongo ĩna na ithano, kũraiha na igũrũ.<note caller="+" style="f"><char style="fr" closed="false">6:15 </char><char style="ft" closed="false">nĩ ta mita 140 kũraiha, mita 23 kwarama, na mita 13.5 kũraiha na igũrũ.</char></note> <verse eid="GEN 6:15" /><verse number="16" style="v" sid="GEN 6:16" />Ũmĩgite igũrũ, no ũtigie buti ĩmwe na nuthu mwena wa igũrũ wa thingo. Wĩkĩre mũrango mwena-inĩ wa thabina, na ũmĩake ĩrĩ na ngoroba ya thĩ, na ya gatagatĩ, na ya igũrũ. <verse eid="GEN 6:16" /><verse number="17" style="v" sid="GEN 6:17" />Nĩngũrehe mũiyũro wa maaĩ gũkũ thĩ wa kũniina kĩndũ gĩothe kĩrĩ muoyo gũkũ thĩ, kĩũmbe o gĩothe kĩrĩ na mĩhũmũ ya muoyo thĩinĩ wakĩo. Indo ciothe irĩ thĩ nĩikũniinwo. <verse eid="GEN 6:17" /><verse number="18" style="v" sid="GEN 6:18" />No nĩngũthondeka kĩrĩkanĩro nawe. Wee nĩũgatoonya thabina, wee mwene na ariũ aku na mũtumia waku, na atumia a ariũ aku. <verse eid="GEN 6:18" /><verse number="19" style="v" sid="GEN 6:19" />Ningĩ nĩũkaingĩria ciũmbe cia mĩthemba yothe thĩinĩ wa thabina, o mũthemba ciũmbe igĩrĩ, wa njamba na wa nga, nĩguo itũũre muoyo, o hamwe nawe. <verse eid="GEN 6:19" /><verse number="20" style="v" sid="GEN 6:20" />O mũthemba wa nyoni, na o mũthemba wa nyamũ ciothe na ciũmbe ciothe iria ithiiagĩra thĩ, nĩigooka kũrĩ we igĩrĩ igĩrĩ nĩguo itũũre muoyo. <verse eid="GEN 6:20" /><verse number="21" style="v" sid="GEN 6:21" />Nĩũkamaatha mĩthemba yothe ya irio iria irĩĩagwo, ũciige irĩ irio ciaku na ciacio.”<verse eid="GEN 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 6:22" />Nuhu agĩĩka maũndũ mothe o ta ũrĩa Ngai aamwathĩte eeke.<verse eid="GEN 6:22" /></para>
  <chapter eid="GEN 6" />
  <chapter number="7" style="c" sid="GEN 7" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 7:1" />Ningĩ Jehova akĩĩra Nuhu atĩrĩ, “Toonya thabina thĩinĩ, wee na nyũmba yaku yothe, tondũ nĩnyonete ũrĩ mũthingu rũciaro-inĩ rũrũ. <verse eid="GEN 7:1" /><verse number="2" style="v" sid="GEN 7:2" />Na ũtoonye thĩinĩ na nyamũ mũgwanja mũgwanja cia mĩthemba yothe ĩrĩa ĩtarĩ thaahu, o njamba na nga yayo, na igĩrĩ igĩrĩ cia mĩthemba yothe ĩrĩa ĩrĩ thaahu, o njamba na nga yayo, <verse eid="GEN 7:2" /><verse number="3" style="v" sid="GEN 7:3" />o na ningĩ ũtoonye na nyoni mũgwanja mũgwanja cia mĩthemba yothe, o njamba na nga yayo, nĩgeetha mĩthemba yacio ĩtũũrio muoyo thĩ yothe. <verse eid="GEN 7:3" /><verse number="4" style="v" sid="GEN 7:4" />Thikũ mũgwanja kuuma rĩu, nĩnguuria mbura, yure gũkũ thĩ matukũ mĩrongo ĩna mũthenya na ũtukũ, na niine ciũmbe ciothe iria irĩ muoyo iria niĩ ndombire, ithire thĩ.”<verse eid="GEN 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 7:5" />Nake Nuhu agĩĩka ũrĩa wothe Mwathani aamwathĩte eeke.<verse eid="GEN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 7:6" />Nuhu aarĩ na mĩaka magana matandatũ rĩrĩa mũiyũro ũcio wa maaĩ waiyũrire thĩ. <verse eid="GEN 7:6" /><verse number="7" style="v" sid="GEN 7:7" />Nake Nuhu na ariũ ake na mũtumia wake na atumia a ariũ ake magĩtoonya thabina morĩre mũiyũro ũcio wa maaĩ. <verse eid="GEN 7:7" /><verse number="8" style="v" sid="GEN 7:8" />Nyamũ igĩrĩ igĩrĩ iria itarĩ thaahu na iria irĩ thaahu cia nyoni o na cia ciũmbe ciothe iria ithiiagĩra thĩ, <verse eid="GEN 7:8" /><verse number="9" style="v" sid="GEN 7:9" />njamba na nga-rĩ, igĩũka kũrĩ Nuhu igĩtoonya thabina, o ta ũrĩa Ngai aathĩte Nuhu. <verse eid="GEN 7:9" /><verse number="10" style="v" sid="GEN 7:10" />Na thuutha wa matukũ mũgwanja mũiyũro wa maaĩ ũkĩiyũra thĩ.<verse eid="GEN 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 7:11" />Na rĩrĩ, mũthenya wa ikũmi na mũgwanja, mweri wa keerĩ, mwaka ũrĩa Nuhu akinyirie mĩaka magana matandatũ-rĩ, mũthenya ũcio nĩguo ithima cia maaĩ ciothe cia kũrĩa kũriku ciatuthũkire, nacio ihingo cia mũiyũro wa igũrũ ikĩhingũrwo. <verse eid="GEN 7:11" /><verse number="12" style="v" sid="GEN 7:12" />Nayo mbura ĩkiura thĩ matukũ mĩrongo ĩna, mũthenya na ũtukũ.<verse eid="GEN 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 7:13" />Mũthenya o ro ũcio nĩguo Nuhu na ariũ ake, Shemu, na Hamu na Jafethu, hamwe na mũtumia wake na atumia a ariũ ake atatũ maatoonyire thabina. <verse eid="GEN 7:13" /><verse number="14" style="v" sid="GEN 7:14" />Nao maarĩ na mĩthemba yothe ya nyamũ cia gĩthaka, o nyamũ kũringana na mũthemba wayo, na mahiũ mothe kũringana na mĩthemba yamo, na ciũmbe ciothe iria ithiiagĩra thĩ kũringana na mĩthemba yacio, na nyoni ciothe kũringana na mĩthemba yacio, na kĩndũ gĩothe kĩrĩ mathagu. <verse eid="GEN 7:14" /><verse number="15" style="v" sid="GEN 7:15" />Ciũmbe ciothe iria irĩ mĩhũmũ ya muoyo igĩũka kũrĩ Nuhu igĩtoonya thabina igĩrĩ igĩrĩ. <verse eid="GEN 7:15" /><verse number="16" style="v" sid="GEN 7:16" />Nyamũ iria ciatoonyire thĩinĩ ciarĩ njamba na nga cia mĩthemba yothe ya indo iria irĩ muoyo, o ta ũrĩa Ngai aathĩte Nuhu. Nake Jehova akĩmũhingĩrĩria thĩinĩ.<verse eid="GEN 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 7:17" />Handũ ha matukũ mĩrongo ĩna, mũiyũro ũcio ũgĩthiĩ na mbere kuongerereka thĩ, na o ũrĩa maaĩ macio maingĩhaga makĩoya thabina ĩyo na igũrũ mũno na ĩkĩreera igũrũ rĩa maaĩ. <verse eid="GEN 7:17" /><verse number="18" style="v" sid="GEN 7:18" />Maaĩ macio makĩambatĩra na makĩongerereka mũno gũkũ thĩ, nayo thabina ĩkĩreera maaĩ igũrũ. <verse eid="GEN 7:18" /><verse number="19" style="v" sid="GEN 7:19" />Maaĩ macio makĩambatĩra mũno igũrũ wa thĩ, nacio irĩma ciothe iria ndaaya na igũrũ gũkũ mũhuro wa matu guothe ikĩhumbĩrwo nĩmo. <verse eid="GEN 7:19" /><verse number="20" style="v" sid="GEN 7:20" />Maaĩ macio maambatire makĩhumbĩra irĩma na makĩria ma buti mĩrongo ĩĩrĩ.<note caller="+" style="f"><char style="fr" closed="false">7:20 </char><char style="ft" closed="false">nĩ ta mita 7.</char></note> <verse eid="GEN 7:20" /><verse number="21" style="v" sid="GEN 7:21" />Kĩndũ gĩothe kĩarĩ muoyo na gĩathiiaga gũkũ thĩ gĩgĩkua, nyoni, na mahiũ na nyamũ cia gĩthaka, na ciũmbe ciothe iria ciahunjĩte thĩ, o na andũ othe. <verse eid="GEN 7:21" /><verse number="22" style="v" sid="GEN 7:22" />Kĩndũ gĩothe kĩarĩ thĩ nyũmũ na kĩarĩ na mĩhũmũ ya muoyo maniũrũ-inĩ makĩo gĩgĩkua. <verse eid="GEN 7:22" /><verse number="23" style="v" sid="GEN 7:23" />Kĩndũ gĩothe kĩarĩ muoyo gũkũ thĩ guothe gĩkĩniinwo biũ; andũ na nyamũ na ciũmbe iria ithiiagĩra thĩ na nyoni cia rĩera-inĩ ikĩniinwo ciothe gũkũ thĩ. No Nuhu watigarire hamwe na andũ arĩa maarĩ nake thĩinĩ wa thabina.<verse eid="GEN 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 7:24" />Maaĩ macio magĩikara mahumbĩrĩte thĩ matukũ igana rĩmwe na mĩrongo ĩtano.<verse eid="GEN 7:24" /></para>
  <chapter eid="GEN 7" />
  <chapter number="8" style="c" sid="GEN 8" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 8:1" />No rĩrĩ, Ngai nĩaririkanire Nuhu o hamwe na nyamũ ciothe cia gĩthaka o na mahiũ marĩa mothe aarĩ namo thĩinĩ wa thabina, na agĩtũma rũhuho rũhurutane gũkũ thĩ, namo maaĩ makĩambĩrĩria kũhũa. <verse eid="GEN 8:1" /><verse number="2" style="v" sid="GEN 8:2" />Nacio ithima cia kũrĩa kũriku na ihingo cia mũiyũro wa igũrũ ikĩhingwo, nayo mbura ĩgĩtiga kuura. <verse eid="GEN 8:2" /><verse number="3" style="v" sid="GEN 8:3" />Namo maaĩ magĩthiĩ makĩhũũaga, magĩthiraga thĩ. Thuutha wa matukũ igana na mĩrongo ĩtano-rĩ, maaĩ magĩkorwo manyihanyiihĩte, <verse eid="GEN 8:3" /><verse number="4" style="v" sid="GEN 8:4" />naguo mũthenya wa ikũmi na mũgwanja wa mweri wa mũgwanja, thabina ĩkĩrũgama irĩma-inĩ cia Ararati. <verse eid="GEN 8:4" /><verse number="5" style="v" sid="GEN 8:5" />Maaĩ macio magĩthiĩ na mbere na kũhũa o nginya mweri wa ikũmi, na mũthenya wa mbere wa mweri wa ikũmi-rĩ, tũcũmbĩrĩ twa irĩma tũkĩambĩrĩria kuoneka.<verse eid="GEN 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 8:6" />Na thuutha wa matukũ mĩrongo ĩna, Nuhu akĩhingũra ndirica ĩrĩa aakĩte thabina-inĩ, <verse eid="GEN 8:6" /><verse number="7" style="v" sid="GEN 8:7" />na akĩrekereria ihuru na nja, narĩo rĩgĩtũũra rĩũmbũkaga kũndũ na kũndũ o nginya rĩrĩa maaĩ maahũire thĩ. <verse eid="GEN 8:7" /><verse number="8" style="v" sid="GEN 8:8" />Ningĩ akĩrekereria ndutura ĩthiĩ ĩkarore kana maaĩ nĩmahũĩte gũkũ thĩ. <verse eid="GEN 8:8" /><verse number="9" style="v" sid="GEN 8:9" />No ndutura ĩyo ndĩonire handũ ha kũũmba tondũ thĩ yothe yaiyũrĩtwo nĩ maaĩ; nĩ ũndũ ũcio ĩgĩcooka thabina-inĩ kũrĩ Nuhu. Nake agĩtambũrũkia guoko akĩmĩoya, akĩmĩtoonyia thabina thĩinĩ kũu we aarĩ. <verse eid="GEN 8:9" /><verse number="10" style="v" sid="GEN 8:10" />Ningĩ agĩeterera matukũ mangĩ mũgwanja, na maathira akĩrekereria ndutura rĩngĩ yume nja ya thabina. <verse eid="GEN 8:10" /><verse number="11" style="v" sid="GEN 8:11" />Rĩrĩa ndutura ĩyo yamũcookereire hwaĩ-inĩ-rĩ, yakuuĩte ithangũ rĩa mũtamaiyũ na mũkanye wayo, rĩatuĩtwo o hĩndĩ ĩyo! Nuhu agĩkĩmenya atĩ maaĩ nĩmahũĩte thĩ. <verse eid="GEN 8:11" /><verse number="12" style="v" sid="GEN 8:12" />Nuhu agĩeterera matukũ mangĩ mũgwanja, agĩcooka akĩrekereria ndutura ĩyo yume nja rĩngĩ, no hĩndĩ ĩno ndĩigana kũmũcookerera.<verse eid="GEN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 8:13" />Na rĩrĩ, mũthenya wa mbere, mweri wa mbere wa mwaka ũrĩa Nuhu akinyirie mĩaka magana matandatũ na ũmwe-rĩ, mũthenya ũcio nĩguo maaĩ maahũire biũ gũkũ thĩ. Nake Nuhu akĩeheria kĩrĩa kĩagitĩte thabina, agĩkĩona atĩ thĩ nĩyaniarĩte. <verse eid="GEN 8:13" /><verse number="14" style="v" sid="GEN 8:14" />Gũgĩkinya mũthenya wa mĩrongo ĩĩrĩ na mũgwanja wa mweri wa keerĩ-rĩ, thĩ nĩyaniarĩte biũ.<verse eid="GEN 8:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 8:15" />Ningĩ Ngai akĩĩra Nuhu atĩrĩ, <verse eid="GEN 8:15" /><verse number="16" style="v" sid="GEN 8:16" />“Uma thabina, wee na mũtumia waku, na ariũ aku na atumia ao. <verse eid="GEN 8:16" /><verse number="17" style="v" sid="GEN 8:17" />Hingũrĩra mĩthemba yothe ya ciũmbe iria irĩ muoyo icio ũrĩ nacio: irĩ nyoni, na nyamũ, na ciũmbe iria ithiiagĩra thĩ, nĩgeetha ciongerereke thĩ, na iciarane cingĩhe gũkũ thĩ.”<verse eid="GEN 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 8:18" />Nĩ ũndũ ũcio Nuhu akiuma thabina hamwe na ariũ ake, na mũtumia wake, na atumia a ariũ ake. <verse eid="GEN 8:18" /><verse number="19" style="v" sid="GEN 8:19" />Nyamũ ciothe na ciũmbe ciothe iria ithiiagĩra thĩ, na nyoni ciothe, na kĩndũ o gĩothe gĩthiiagĩra gũkũ thĩ, ciothe cikiuma thabina, mũthemba o mũthemba.<verse eid="GEN 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 8:20" />Nake Nuhu agĩakĩra Jehova kĩgongona, na akĩoya nyamũ imwe cia iria ciothe itarĩ thaahu, na nyoni iria itarĩ thaahu, akĩrutĩra Ngai igongona rĩa njino ho.<note caller="+" style="f"><char style="fr" closed="false">8:20 </char><char style="ft" closed="false">Ihinda rĩĩrĩ norĩo iruta rĩa njino rĩcinĩtwo rĩrĩ rĩothe thĩinĩ wa Kĩrĩkanĩro.</char></note> <verse eid="GEN 8:20" /><verse number="21" style="v" sid="GEN 8:21" />Nake Jehova agĩkenio nĩ mũtararĩko ũcio, akiuga atĩrĩ na ngoro yake: “Ndirĩ hĩndĩ ngaacooka kũruma thĩ rĩngĩ nĩ ũndũ wa mũndũ, o na gũtuĩka merirĩria ma ngoro yake nĩ mooru kuuma ũnini-inĩ wake. Na ndirĩ hĩndĩ ngaacooka kũniina ciũmbe ciothe iria irĩ muoyo ta ũguo njĩkĩte.<verse eid="GEN 8:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="GEN 8:22" />“Mahinda mothe marĩa thĩ ĩgũtũũra-rĩ,</para>
  <para style="q1" vid="GEN 8:22">kũrĩkoragwo na hĩndĩ ya kũhaanda na ya magetha,</para>
  <para style="q1" vid="GEN 8:22">na hĩndĩ ya heho na ya ũrugarĩ,</para>
  <para style="q1" vid="GEN 8:22">na hĩndĩ ya themithũ na ya gathano,</para>
  <para style="q1" vid="GEN 8:22">na mũthenya na ũtukũ.”<verse eid="GEN 8:22" /></para>
  <chapter eid="GEN 8" />
  <chapter number="9" style="c" sid="GEN 9" />
  <para style="s1">Kĩrĩkanĩro kĩa Ngai na Nuhu</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 9:1" />Hĩndĩ ĩyo Ngai akĩrathima Nuhu na ariũ ake, akĩmeera atĩrĩ, “Ciaranai na mũingĩhe na mũiyũre thĩ. <verse eid="GEN 9:1" /><verse number="2" style="v" sid="GEN 9:2" />Nyamũ ciothe cia thĩ, na nyoni cia rĩera-inĩ, ciothe nĩ irĩmwĩtigagĩra na imakage nĩ inyuĩ, ciũmbe ciothe iria ithiiagĩra thĩ, na thamaki ciothe cia iria-inĩ; nĩndacineana moko-inĩ manyu. <verse eid="GEN 9:2" /><verse number="3" style="v" sid="GEN 9:3" />Kĩndũ gĩothe gĩtũũraga muoyo na gĩthiiaga-rĩ, gĩgũtuĩka irio cianyu. O ta ũrĩa ndamũheire mĩmera ĩrĩa mĩruru mũrĩĩage, rĩu nĩ ndamũhe indo ciothe ituĩke irio cianyu.<verse eid="GEN 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 9:4" />“No rĩrĩ, mũtikanarĩe nyama irĩ na thakame, tondũ thakame nĩyo muoyo. <verse eid="GEN 9:4" /><verse number="5" style="v" sid="GEN 9:5" />Na ti-itherũ nĩngarĩhanĩria gũitwo gwa thakame yanyu. Ndĩmĩrĩhanĩrie o na kuuma kũrĩ nyamũ o na ĩrĩkũ. Nake mũndũ angĩita thakame ya mũndũ ũngĩ, o nake nĩakarĩhio thakame ĩyo.<verse eid="GEN 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="GEN 9:6" />“Mũndũ o wothe ũgaita thakame ya mũndũ ũngĩ,</para>
  <para style="q2" vid="GEN 9:6">thakame yake o nayo ĩgaitwo nĩ mũndũ;</para>
  <para style="q1" vid="GEN 9:6">nĩgũkorwo Ngai ombire mũndũ na mũhianĩre wake.<verse eid="GEN 9:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="GEN 9:7" />No inyuĩ-rĩ, ciaranai na mũingĩhe; muongerereke thĩ na mũiyũre kuo.”<verse eid="GEN 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 9:8" />Ningĩ Ngai akĩĩra Nuhu hamwe na ariũ ake atĩrĩ, <verse eid="GEN 9:8" /><verse number="9" style="v" sid="GEN 9:9" />“Rĩu niĩ nĩngũthondeka kĩrĩkanĩro gĩakwa na inyuĩ, na njiaro cianyu iria igooka thuutha wanyu, <verse eid="GEN 9:9" /><verse number="10" style="v" sid="GEN 9:10" />o na hamwe na kĩũmbe gĩothe kĩrĩ muoyo kĩa iria mũraarĩ nacio; nĩcio nyoni, na mahiũ o na nyamũ cia gĩthaka ciothe iria cioimire thabina hamwe na inyuĩ, ici nĩcio ciũmbe ciothe irĩ muoyo gũkũ thĩ. <verse eid="GEN 9:10" /><verse number="11" style="v" sid="GEN 9:11" />Nĩndathondeka kĩrĩkanĩro gĩakwa na inyuĩ: Gũtirĩ hĩndĩ ĩngĩ muoyo wothe ũkaaniinwo na mũiyũro wa maaĩ; gũtirĩ hĩndĩ ĩngĩ gũkaagĩa mũiyũro wa maaĩ wa kũniina thĩ.”<verse eid="GEN 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 9:12" />Ningĩ Ngai akiuga atĩrĩ, “Gĩkĩ nĩkĩo kĩmenyithia gĩa kĩrĩkanĩro kĩrĩa ndĩrarĩkanĩra na inyuĩ na ciũmbe ciothe irĩ muoyo irĩ hamwe na inyuĩ, kĩrĩkanĩro kĩa njiarwa ciothe iria igooka: <verse eid="GEN 9:12" /><verse number="13" style="v" sid="GEN 9:13" />Nĩndekĩra mũkũnga-mbura wakwa matu-inĩ, na nĩguo ũgũtuĩka kĩmenyithia gĩa kĩrĩkanĩro gatagatĩ gakwa na andũ a thĩ. <verse eid="GEN 9:13" /><verse number="14" style="v" sid="GEN 9:14" />Hĩndĩ ĩrĩa yothe ngaarehe matu igũrũ rĩa thĩ, naguo mũkũnga-mbura woneke matu-inĩ macio, <verse eid="GEN 9:14" /><verse number="15" style="v" sid="GEN 9:15" />nĩndĩĩririkanaga kĩrĩkanĩro gĩakwa gatagatĩ kanyu na niĩ, na gatagatĩ ga ciũmbe cia mĩthemba yothe iria itũũraga muoyo. Gũtirĩ hĩndĩ ĩngĩ maaĩ magatuĩka mũiyũro wa kũniina mĩoyo yothe. <verse eid="GEN 9:15" /><verse number="16" style="v" sid="GEN 9:16" />Rĩrĩa rĩothe mũkũnga-mbura ũrĩonekaga itu-inĩ-rĩ, ndĩĩwonaga ngaririkana kĩrĩkanĩro kĩrĩa gĩa gũtũũra nginya tene gatagatĩ ka Ngai na ciũmbe cia mĩthemba yothe iria itũũraga muoyo gũkũ thĩ.”<verse eid="GEN 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 9:17" />Nĩ ũndũ ũcio Ngai akĩĩra Nuhu atĩrĩ, “Gĩkĩ nĩkĩo kĩmenyithia gĩa kĩrĩkanĩro kĩrĩa ndathondeka gatagatĩ gakwa na kĩndũ gĩothe kĩrĩ muoyo gũkũ thĩ.”<verse eid="GEN 9:17" /></para>
  <para style="s1">Ariũ a Nuhu</para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 9:18" />Ariũ a Nuhu arĩa moimire thabina maarĩ Shemu, na Hamu na Jafethu. (Hamu nĩwe warĩ ithe wa Kaanani). <verse eid="GEN 9:18" /><verse number="19" style="v" sid="GEN 9:19" />Acio atatũ nĩo maarĩ ariũ a Nuhu, na kuuma kũrĩ o gũkiuma andũ arĩa othe maahurunjirwo thĩ yothe.<verse eid="GEN 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 9:20" />Nuhu aarĩ mũrĩmi, na nĩahaandire mũgũnda wa mĩthabibũ. <verse eid="GEN 9:20" /><verse number="21" style="v" sid="GEN 9:21" />Rĩrĩa aanyuire ndibei ya mĩthabibũ ĩyo, akĩrĩĩo, na agĩkoma thĩinĩ wa hema yake atehumbĩrĩte. <verse eid="GEN 9:21" /><verse number="22" style="v" sid="GEN 9:22" />Hamu, ithe wa Kaanani, nĩonire njaga ya ithe, na akĩĩra ariũ a nyina eerĩ arĩa maarĩ nja. <verse eid="GEN 9:22" /><verse number="23" style="v" sid="GEN 9:23" />No Shemu na Jafethu makĩoya nguo makĩigĩrĩra ciande; magĩthiĩ na kĩĩhutaatĩ, makĩhumbĩra njaga ya ithe. Mothiũ mao maahũgũkĩte na kũngĩ nĩguo matikoone njaga ya ithe wao.<verse eid="GEN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 9:24" />Rĩrĩa Nuhu aarĩĩũkirwo na akĩmenya ũrĩa mũriũ wake ũrĩa mũnini aamwĩkĩte-rĩ, <verse eid="GEN 9:24" /><verse number="25" style="v" sid="GEN 9:25" />akiuga atĩrĩ,</para>
  <para style="q1" vid="GEN 9:25">“Kaanani aronyiitwo nĩ kĩrumi!</para>
  <para style="q2" vid="GEN 9:25">Agaatuĩka ngombo ya kũhinyĩrĩrio biũ nĩ ariũ a nyina.”<verse eid="GEN 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 9:26" />Ningĩ akiuga atĩrĩ,</para>
  <para style="q1" vid="GEN 9:26">“Jehova arogaathwo, o we Ngai wa Shemu!</para>
  <para style="q2" vid="GEN 9:26">Kaanani arotuĩka ngombo ya Shemu.<verse eid="GEN 9:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="GEN 9:27" />Ngai aroaramia mĩhaka ya Jafethu;</para>
  <para style="q2" vid="GEN 9:27">Jafethu arotũũra hema-inĩ cia Shemu,</para>
  <para style="q2" vid="GEN 9:27">na Kaanani arotuĩka ngombo yake.”<verse eid="GEN 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 9:28" />Thuutha wa mũiyũro wa maaĩ gũthira-rĩ, Nuhu aatũũrire muoyo mĩaka magana matatũ na mĩrongo ĩtano. <verse eid="GEN 9:28" /><verse number="29" style="v" sid="GEN 9:29" />Mĩaka yothe ĩrĩa Nuhu aatũũrire muoyo yarĩ mĩaka magana kenda na mĩrongo ĩtano, agĩcooka agĩkua.<verse eid="GEN 9:29" /></para>
  <chapter eid="GEN 9" />
  <chapter number="10" style="c" sid="GEN 10" />
  <para style="s1">Mũtaratara wa Ndũrĩrĩ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 10:1" />Ũyũ nĩguo ũhoro wa njiarwa cia Nuhu, nĩo Shemu, na Hamu, na Jafethu, arĩa o ene maagĩire na ariũ thuutha wa mũiyũro wa maaĩ.<verse eid="GEN 10:1" /></para>
  <para style="s2">Ariũ a Jafethu</para>
  <para style="li1">
    <verse number="2" style="v" sid="GEN 10:2" />Ariũ a Jafethu nĩ aya:</para>
  <para style="li2" vid="GEN 10:2">Gomeri, na Magogu, na Madai, na Javani, na Tubali, na Mesheki, na Tirasi.<verse eid="GEN 10:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="GEN 10:3" />Ariũ a Gomeri nĩ aya:</para>
  <para style="li2" vid="GEN 10:3">Ashikenazu, na Rifathu, na Togarima.<verse eid="GEN 10:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="GEN 10:4" />Ariũ a Javani nĩ aya:</para>
  <para style="li2" vid="GEN 10:4">Elishahu, na Tarishishi, na Kitimu, na Rodanimu. <verse eid="GEN 10:4" /><verse number="5" style="v" sid="GEN 10:5" />(Kuuma kũrĩ o gũkiuma andũ arĩa matũũraga ndwere-inĩ cia iria, o andũ na rũgongo rwao kũringana na mĩhĩrĩga yao, mabũrũri-inĩ mao, na o andũ na rũthiomi rwao.)<verse eid="GEN 10:5" /></para>
  <para style="s2">Ariũ a Hamu</para>
  <para style="li1">
    <verse number="6" style="v" sid="GEN 10:6" />Nao ariũ a Hamu nĩ aya:</para>
  <para style="li2" vid="GEN 10:6">Kushi, na Miziraimu, na Putu, na Kaanani.<note caller="+" style="f"><char style="fr" closed="false">10:6 </char><char style="ft" closed="false">Miziraimu nĩ bũrũri wa Misiri, Putu nakuo kwahoteka gũkorwo nĩ bũrũri wa Libia kana bũrũri wa Somalia ũmũthĩ.</char></note><verse eid="GEN 10:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="GEN 10:7" />Ariũ a Kushi nĩ aya:</para>
  <para style="li2" vid="GEN 10:7">Seba, na Havila, na Sabita, na Raama, na Sabiteka.</para>
  <para style="li1" vid="GEN 10:7">Nao ariũ a Raama nĩ:</para>
  <para style="li2" vid="GEN 10:7">Sheba, na Dedani.<note caller="+" style="f"><char style="fr" closed="false">10:7 </char><char style="ft" closed="false">Mabũrũri maya mũgwanja ma ariũ a Kushi maakoragwo Arabia.</char></note><verse eid="GEN 10:7" /></para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" sid="GEN 10:8" />Kushi nĩwe warĩ ithe wa Nimurodi, ũrĩa wakũrire agĩtuĩka njamba ya hinya ya ita gũkũ thĩ. <verse eid="GEN 10:8" /><verse number="9" style="v" sid="GEN 10:9" />Aarĩ mũguĩmi warĩ hinya mbere ya Jehova; na nĩkĩo kwĩragwo atĩrĩ, “O ta Nimurodi, mũguĩmi ũrĩ hinya mbere ya Jehova.” <verse eid="GEN 10:9" /><verse number="10" style="v" sid="GEN 10:10" />Matũũra ma mbere ma ũthamaki wake maarĩ Babeli, na Ereku, na Akadi na Kaline, kũu Shinaru.<note caller="+" style="f"><char style="fr" closed="false">10:10 </char><char style="ft" closed="false">Shinaru nĩ rĩĩtwa rĩa tene rĩa bũrũri wa Babuloni.</char></note> <verse eid="GEN 10:10" /><verse number="11" style="v" sid="GEN 10:11" />Kuuma bũrũri ũcio wa Shinaru agĩthiĩ bũrũri wa Ashuri, nakuo kũu agĩaka matũũra ma Nineve, na Rehobothu-Iru, na Kala, <verse eid="GEN 10:11" /><verse number="12" style="v" sid="GEN 10:12" />na Reseni, itũũra rĩrĩ gatagatĩ ka Nineve na Kala; rĩu nĩrĩo rĩarĩ itũũra inene.<verse eid="GEN 10:12" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="13" style="v" sid="GEN 10:13" />Nake Miziraimu nĩwe warĩ ithe wa</para>
  <para style="li2" vid="GEN 10:13">Aludi, na Aanami, na Alehabi, na Anafituhi, <verse eid="GEN 10:13" /><verse number="14" style="v" sid="GEN 10:14" />na Apathirusi, na Akasuluhi (Afilisti moimire kuuma harĩ o), na Akafitori.<verse eid="GEN 10:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="GEN 10:15" />Kaanani nĩwe warĩ ithe wa</para>
  <para style="li2" vid="GEN 10:15">Sidoni irigithathi rĩake, na Ahiti, <verse eid="GEN 10:15" /><verse number="16" style="v" sid="GEN 10:16" />na Ajebusi, na Aamori, na Agirigashi, <verse eid="GEN 10:16" /><verse number="17" style="v" sid="GEN 10:17" />na Ahivi, na Ariki, na Asiniti, <verse eid="GEN 10:17" /><verse number="18" style="v" sid="GEN 10:18" />na Aarivadi, na Azemari, na Ahamathi.</para>
  <para style="b" vid="GEN 10:18" />
  <para style="p" vid="GEN 10:18">Thuutha ũcio mĩhĩrĩga ya Kaanani ĩkĩhurunjũka, <verse eid="GEN 10:18" /><verse number="19" style="v" sid="GEN 10:19" />mĩhaka ya Akaanani yoimĩte Sidoni ĩrorete Gerari ĩgakinya Gaza, ningĩ ĩkarora Sodomu, na Gomora, na Adima, na Zeboimu, o nginya Lasha.<verse eid="GEN 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 10:20" />Acio nĩo ariũ a Hamu kũringana na mĩhĩrĩga yao, na thiomi ciao, marĩ ngʼongo ciao, na mabũrũri-inĩ mao.<verse eid="GEN 10:20" /></para>
  <para style="s2">Ashemu</para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 10:21" />Shemu o nake nĩaciarĩirwo ariũ ake. Mũrũ wa nyina na Shemu ũrĩa warĩ mũkũrũ eetagwo Jafethu. Shemu nĩwe warĩ ithe wa rũruka ruothe rwa ariũ a Eberi.<verse eid="GEN 10:21" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="22" style="v" sid="GEN 10:22" />Ariũ a Shemu nĩ aya:</para>
  <para style="li2" vid="GEN 10:22">Elamu, na Ashuri, na Arafakasadi, na Ludi, na Aramu.<verse eid="GEN 10:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="GEN 10:23" />Nao ariũ a Aramu nĩ aya:</para>
  <para style="li2" vid="GEN 10:23">Uzu, na Hulu, na Getheru, na Mesheki.<verse eid="GEN 10:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="GEN 10:24" />Arafakasadi nĩwe warĩ ithe wa Shela, nake Shela aarĩ ithe wa Eberi.<verse eid="GEN 10:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="GEN 10:25" />Eberi nake nĩaciarĩirwo ariũ eerĩ:</para>
  <para style="li2" vid="GEN 10:25">Ũmwe eetagwo Pelegu, tondũ hĩndĩ yake thĩ nĩyagayũkanire; mũrũ wa nyina eetagwo Jokitani.<verse eid="GEN 10:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="GEN 10:26" />Jokitani nĩwe warĩ ithe wa</para>
  <para style="li2" vid="GEN 10:26">Alimodadi, na Shelefu, na Hazarimavethu, na Jera, <verse eid="GEN 10:26" /><verse number="27" style="v" sid="GEN 10:27" />na Hadoramu, na Uzali, na Dikila, <verse eid="GEN 10:27" /><verse number="28" style="v" sid="GEN 10:28" />na Obali, na Abimaeli, na Sheba, <verse eid="GEN 10:28" /><verse number="29" style="v" sid="GEN 10:29" />na Ofiri, na Havila, na Jobabu. Acio othe nĩo maarĩ ariũ a Jokitani.<verse eid="GEN 10:29" /></para>
  <para style="b" />
  <para style="m">
    <verse number="30" style="v" sid="GEN 10:30" />Rũgongo rũrĩa maatũũraga ruoimĩte Mesha rũgathiĩ rũrorete Sefari, kũu mwena wa irathĩro wa bũrũri ũrĩa ũrĩ irĩma.<verse eid="GEN 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 10:31" />Acio nĩo ariũ a Shemu kũringana na mĩhĩrĩga yao, na thiomi ciao, marĩ ngʼongo ciao na mabũrũri-inĩ mao.<verse eid="GEN 10:31" /></para>
  <para style="b" />
  <para style="p">
    <verse number="32" style="v" sid="GEN 10:32" />Ĩyo nĩyo mĩhĩrĩga ya ariũ a Nuhu kũringana na njiaro ciao, marĩ mabũrũri-inĩ mao. Kuuma kũrĩ o, ndũrĩrĩ ikĩhurunjũka thĩ yothe thuutha wa mũiyũro wa maaĩ.<verse eid="GEN 10:32" /></para>
  <chapter eid="GEN 10" />
  <chapter number="11" style="c" sid="GEN 11" />
  <para style="s1">Mũthiringo wa Babeli</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 11:1" />Hĩndĩ ĩyo ya tene-rĩ, andũ othe a thĩ maarĩ na rũthiomi rũmwe na mwario o ũmwe. <verse eid="GEN 11:1" /><verse number="2" style="v" sid="GEN 11:2" />Na rĩrĩa andũ maathiiaga na mwena wa irathĩro, magĩkinya werũ-inĩ ũrĩa mwaraganu wa Shinaru, na magĩtũũra kuo.<verse eid="GEN 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 11:3" />Nao makĩĩrana atĩrĩ, “Ũkai tũũmbe maturubarĩ na tũmacine wega.” Magĩtũmĩra maturubarĩ handũ ha mahiga, na rami handũ ha thimiti. <verse eid="GEN 11:3" /><verse number="4" style="v" sid="GEN 11:4" />Ningĩ magĩcooka makiuga atĩrĩ, “Ũkai, rekei twĩyakĩre itũũra inene, rĩna mũthiringo mũraaya na igũrũ, ũkinye o matu-inĩ, nĩgeetha twĩgĩĩre igweta, na nĩguo tũtikaanahurunjwo thĩ yothe.”<verse eid="GEN 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 11:5" />No rĩrĩ, Jehova agĩikũrũka oke one itũũra rĩu na mũthiringo ũcio andũ acio maakaga. <verse eid="GEN 11:5" /><verse number="6" style="v" sid="GEN 11:6" />Jehova akiuga atĩrĩ na ngoro yake, “Angĩkorwo na ũndũ wa ũrũmwe wa kwaria rũthiomi rũmwe andũ aya nĩmambĩrĩria gwĩka ũũ-rĩ, gũtirĩ ũndũ makaabanga gwĩka ũkaamarema. <verse eid="GEN 11:6" /><verse number="7" style="v" sid="GEN 11:7" />Ũkai, tũikũrũke tũkahĩngĩcanie rũthiomi rwao, nĩgeetha matigacooke kũiguithania mĩario mũndũ na ũrĩa ũngĩ.”<verse eid="GEN 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 11:8" />Nĩ ũndũ ũcio, kuuma hau Jehova akĩmahurunja thĩ yothe, nao magĩtiga gwaka itũũra rĩu inene. <verse eid="GEN 11:8" /><verse number="9" style="v" sid="GEN 11:9" />Na nĩkĩo itũũra rĩu rĩetirwo Babeli,<note caller="+" style="f"><char style="fr" closed="false">11:9 </char><char style="ft" closed="false">Rĩĩtwa Babeli rĩgĩtaũrwo na rũthiomi rwa Kĩhibirania nĩ ta kuuga “kĩrigiicano.”</char></note> tondũ nĩkuo Jehova aahĩngĩcanĩirie rũthiomi rwa andũ a thĩ yothe. Kuuma kũu, Jehova akĩmahurunja thĩ yothe.<verse eid="GEN 11:9" /></para>
  <para style="s1">Njiarwa cia kuuma Shemu nginya Aburamu</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 11:10" />Ũyũ nĩguo ũhoro wa Shemu.</para>
  <para style="b" vid="GEN 11:10" />
  <para style="p" vid="GEN 11:10">Mĩaka ĩĩrĩ thuutha wa mũiyũro wa maaĩ-rĩ, rĩrĩa Shemu aarĩ na ũkũrũ wa mĩaka igana rĩmwe-rĩ, nĩguo aatuĩkire ithe wa Arafakasadi. <verse eid="GEN 11:10" /><verse number="11" style="v" sid="GEN 11:11" />Shemu aatũũrire muoyo mĩaka magana matano thuutha wa gũtuĩka ithe wa Arafakasadi, na akĩgĩa na ciana ingĩ cia aanake na cia airĩtu.<verse eid="GEN 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 11:12" />Nake Arafakasadi aakinyia mĩaka mĩrongo ĩtatũ na ĩtano, agĩtuĩka ithe wa Shela. <verse eid="GEN 11:12" /><verse number="13" style="v" sid="GEN 11:13" />Na thuutha wa gũtuĩka ithe wa Shela, Arafakasadi agĩtũũra muoyo mĩaka ĩngĩ magana mana na ĩtatũ, na akĩgĩa na ciana ingĩ cia aanake na cia airĩtu.<verse eid="GEN 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 11:14" />Nake Shela aakinyia mĩaka mĩrongo ĩtatũ, agĩtuĩka ithe wa Eberi. <verse eid="GEN 11:14" /><verse number="15" style="v" sid="GEN 11:15" />Na thuutha wa gũtuĩka ithe wa Eberi, Shela agĩtũũra muoyo mĩaka ĩngĩ magana mana na ĩtatũ, na akĩgĩa na ciana ingĩ cia aanake na cia airĩtu.<verse eid="GEN 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 11:16" />Nake Eberi aakinyia mĩaka mĩrongo ĩtatũ na ĩna, agĩtuĩka ithe wa Pelegu. <verse eid="GEN 11:16" /><verse number="17" style="v" sid="GEN 11:17" />Na thuutha wa gũtuĩka ithe wa Pelegu, Eberi agĩtũũra muoyo mĩaka ĩngĩ magana mana na mĩrongo ĩtatũ, na akĩgĩa na ciana ingĩ cia aanake na cia airĩtu.<verse eid="GEN 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 11:18" />Nake Pelegu aakinyia mĩaka mĩrongo ĩtatũ, agĩtuĩka ithe wa Reu. <verse eid="GEN 11:18" /><verse number="19" style="v" sid="GEN 11:19" />Na thuutha wa gũtuĩka ithe wa Reu, Pelegu agĩtũũra muoyo mĩaka ĩngĩ magana meerĩ na kenda na akĩgĩa na ciana ingĩ cia aanake na cia airĩtu.<verse eid="GEN 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 11:20" />Nake Reu aakinyia mĩaka mĩrongo ĩtatũ na ĩĩrĩ, agĩtuĩka ithe wa Serugu. <verse eid="GEN 11:20" /><verse number="21" style="v" sid="GEN 11:21" />Na thuutha wa gũtuĩka ithe wa Serugu, Reu agĩtũũra muoyo mĩaka ĩngĩ magana meerĩ na mũgwanja na akĩgĩa na ciana ingĩ cia aanake na cia airĩtu.<verse eid="GEN 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 11:22" />Nake Serugu aakinyia mĩaka mĩrongo ĩtatũ, agĩtuĩka ithe wa Nahoru. <verse eid="GEN 11:22" /><verse number="23" style="v" sid="GEN 11:23" />Na thuutha wa gũtuĩka ithe wa Nahoru, Serugu agĩtũũra muoyo mĩaka ĩngĩ magana meerĩ na akĩgĩa na ciana ingĩ cia aanake na cia airĩtu.<verse eid="GEN 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 11:24" />Nake Nahoru aakinyia mĩaka mĩrongo ĩĩrĩ na kenda, agĩtuĩka ithe wa Tera. <verse eid="GEN 11:24" /><verse number="25" style="v" sid="GEN 11:25" />Na thuutha wa gũtuĩka ithe wa Tera, Nahoru agĩtũũra muoyo mĩaka ĩngĩ igana na ikũmi na kenda, na akĩgĩa na ciana ingĩ cia aanake na cia airĩtu.<verse eid="GEN 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 11:26" />Thuutha wa Tera gũkinyia mĩaka mĩrongo mũgwanja, agĩtuĩka ithe wa Aburamu, na Nahoru na Harani.<verse eid="GEN 11:26" /></para>
  <para style="s1">Njiarwa cia Tera</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 11:27" />Ũyũ nĩguo ũhoro wa Tera.</para>
  <para style="b" vid="GEN 11:27" />
  <para style="p" vid="GEN 11:27">Tera nĩwe warĩ ithe wa Aburamu, na Nahoru na Harani. Nake Harani agĩtuĩka ithe wa Loti. <verse eid="GEN 11:27" /><verse number="28" style="v" sid="GEN 11:28" />Ithe wao Tera arĩ o muoyo-rĩ, Harani nĩakuire arĩ bũrũri-inĩ wa Uri-kwa-Akalidei, kũrĩa aaciarĩirwo. <verse eid="GEN 11:28" /><verse number="29" style="v" sid="GEN 11:29" />Aburamu na Nahoru o eerĩ nĩmahikanirie. Mũtumia wa Aburamu eetagwo Sarai, nake mũtumia wa Nahoru eetagwo Milika; Milika aarĩ mwarĩ wa Harani. Harani nĩwe warĩ ithe wa Milika na Isika. <verse eid="GEN 11:29" /><verse number="30" style="v" sid="GEN 11:30" />Na rĩrĩ, Sarai aarĩ thaata; ndaarĩ na ciana.<verse eid="GEN 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 11:31" />Nake Tera akĩoya mũriũ wake Aburamu, na Loti mũrũ wa mũrũwe Harani, na Sarai mũtumia wa mũriũ wake Aburamu; nao makiumagara hamwe moime bũrũri wa Uri-kwa-Akalidei mathiĩ Kaanani. No rĩrĩa maakinyire bũrũri wetagwo Harani,<note caller="+" style="f"><char style="fr" closed="false">11:31 </char><char style="ft" closed="false">Harani rĩarĩ itũũra thĩinĩ wa bũrũri wa Mesopotamia, na andũ akuo nĩmahooyaga mweri o ta ũrĩa andũ a Uri meekaga.</char></note> magĩtũũra kuo.<verse eid="GEN 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 11:32" />Tera agĩtũũra muoyo mĩaka ĩngĩ magana meerĩ na ĩtano, na agĩkuĩra kũu Harani.<verse eid="GEN 11:32" /></para>
  <chapter eid="GEN 11" />
  <chapter number="12" style="c" sid="GEN 12" />
  <para style="s1">Ngai gwĩta Aburamu</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 12:1" />Nake Jehova nĩeerĩte Aburamu atĩrĩ, “Thaama uume bũrũri wanyu na ũtige andũ anyu, na nyũmba ya thoguo, ũthiĩ bũrũri ũrĩa ngaakuonia.<verse eid="GEN 12:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="GEN 12:2" />“Niĩ nĩngagũtua rũrĩrĩ rũnene,</para>
  <para style="q2" vid="GEN 12:2">na nĩngakũrathima;</para>
  <para style="q1" vid="GEN 12:2">nĩngatũma rĩĩtwa rĩaku rĩgĩe igweta,</para>
  <para style="q2" vid="GEN 12:2">nawe nĩũgatuĩka kĩrathimo.<verse eid="GEN 12:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="GEN 12:3" />Nĩngarathima arĩa magaakũrathima,</para>
  <para style="q2" vid="GEN 12:3">na ũrĩa o wothe ũgaakũruma na niĩ nĩngatũma anyiitwo nĩ kĩrumi;</para>
  <para style="q1" vid="GEN 12:3">nao andũ othe a thĩ</para>
  <para style="q2" vid="GEN 12:3">nĩmakarathimwo nĩ ũndũ waku.”<verse eid="GEN 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 12:4" />Nĩ ũndũ ũcio Aburamu akiumagara agĩthiĩ, o ta ũrĩa Jehova aamwathĩte; nake Loti agĩthiĩ nake. Aburamu aarĩ na mĩaka mĩrongo mũgwanja na ĩtano rĩrĩa oimire Harani. <verse eid="GEN 12:4" /><verse number="5" style="v" sid="GEN 12:5" />Nake nĩathiire na mũtumia wake Sarai, na Loti, mũriũ wa mũrũ wa nyina, na indo ciothe iria maagĩte nacio, na andũ arĩa maagĩte nao kũu Harani, na makiumagara marorete bũrũri wa Kaanani, na magĩkinya kuo.<verse eid="GEN 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 12:6" />Aburamu agĩtuĩkanĩria bũrũri ũcio agĩkinya handũ haarĩ na mũtĩ mũnene wa More kũu Shekemu. Hĩndĩ ĩyo Akaanani nĩo maatũũraga bũrũri ũcio. <verse eid="GEN 12:6" /><verse number="7" style="v" sid="GEN 12:7" />Nake Jehova akiumĩrĩra Aburamu, akĩmwĩra atĩrĩ, “Bũrũri ũyũ nĩguo ngaahe rũciaro rwaku.” Nĩ ũndũ ũcio Aburamu agĩakĩra Jehova kĩgongona hau, o we Jehova ũcio wamuumĩrĩire.<verse eid="GEN 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 12:8" />Kuuma hau agĩthiĩ erekeire irĩma iria irĩ mwena wa irathĩro wa itũũra rĩa Betheli, na akĩamba hema yake, Betheli ĩgĩkorwo ĩrĩ mwena wa ithũĩro na itũũra rĩa Ai rĩrĩ mwena wa irathĩro. Hau nĩho aakĩire Jehova kĩgongona na agĩkaĩra rĩĩtwa rĩa Jehova. <verse eid="GEN 12:8" /><verse number="9" style="v" sid="GEN 12:9" />Thuutha-inĩ Aburamu akiumagara rĩngĩ agĩthiĩ na mbere na rũgendo arorete Negevu.<note caller="+" style="f"><char style="fr" closed="false">12:9 </char><char style="ft" closed="false">Rĩĩtwa Negevu rĩgĩtaũrwo nĩ kuuga “bũrũri mũũmũ”; ũyũ warĩ bũrũri mwaraganu watambũrũkĩte nginya Jerusalemu werekeire werũ-inĩ.</char></note><verse eid="GEN 12:9" /></para>
  <para style="s1">Aburamu gũthiĩ Misiri</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 12:10" />Na rĩrĩ, nĩ kwagĩire ngʼaragu bũrũri ũcio, nake Aburamu agĩikũrũka athiĩ Misiri agaikare kuo kwa ihinda, tondũ ngʼaragu nĩ yarĩ nene mũno.<note caller="+" style="f"><char style="fr" closed="false">12:10 </char><char style="ft" closed="false">Bũrũri wa Misiri ndwagĩire na ngʼaragu nĩ ũndũ wa ũrĩmi waguo wa kunithia maaĩ ma Rũũĩ rwa Nili.</char></note> <verse eid="GEN 12:10" /><verse number="11" style="v" sid="GEN 12:11" />Arĩ o hakuhĩ gũtoonya Misiri-rĩ, akĩĩra mũtumia wake Sarai atĩrĩ, “Nĩnjũũĩ atĩ ũrĩ mũndũ-wa-nja kĩĩrorerwa. <verse eid="GEN 12:11" /><verse number="12" style="v" sid="GEN 12:12" />Na rĩrĩ, andũ a Misiri makuona mekuuga atĩrĩ, ‘Ũyũ nĩ mũtumia wake,’ tondũ ũcio manjũrage no wee makũreke ũtũũre muoyo, makuoe. <verse eid="GEN 12:12" /><verse number="13" style="v" sid="GEN 12:13" />Nĩ ũndũ ũcio wee uga atĩ ũrĩ mwarĩ wa baba, nĩgeetha ũhonokie muoyo wakwa na manjĩke wega nĩ ũndũ waku.”<verse eid="GEN 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 12:14" />Rĩrĩa Aburamu aakinyire Misiri, andũ a Misiri makĩona atĩ mũtumia wake aarĩ kĩĩrorerwa biũ. <verse eid="GEN 12:14" /><verse number="15" style="v" sid="GEN 12:15" />Nao anene a Firaũni mamuona, makĩmũgaathĩrĩria kũrĩ Firaũni, na makĩmuoya makĩmũtwara nyũmba-inĩ yake ya ũthamaki. <verse eid="GEN 12:15" /><verse number="16" style="v" sid="GEN 12:16" />Nake Firaũni agĩtuga Aburamu nĩ ũndũ wa Sarai, na Aburamu akĩgĩa na mbũri na ngʼombe, na ndigiri cia njamba na cia nga, ndungata cia arũme na cia airĩtu, na ngamĩĩra.<verse eid="GEN 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 12:17" />No Jehova akĩnyamaria Firaũni na nyũmba yake na mĩrimũ mĩũru nĩ ũndũ wa Sarai, mũtumia wa Aburamu. <verse eid="GEN 12:17" /><verse number="18" style="v" sid="GEN 12:18" />Nĩ ũndũ ũcio Firaũni agĩtũmanĩra Aburamu akĩmũũria atĩrĩ, “Nĩ atĩa ũũ ũnjĩkĩte? Nĩ kĩĩ kĩagiririe ũnjĩĩre atĩ ũyũ nĩ mũtumia waku? <verse eid="GEN 12:18" /><verse number="19" style="v" sid="GEN 12:19" />Nĩ kĩĩ gĩatũmire uuge, ‘Ũyũ nĩ mwarĩ wa baba,’ na nĩkĩo ndaamuoire atuĩke mũtumia wakwa? Mũtumia waku nĩwe ũyũ! Muoye mũthiĩ!” <verse eid="GEN 12:19" /><verse number="20" style="v" sid="GEN 12:20" />Hĩndĩ ĩyo Firaũni agĩathana akĩĩra andũ ake ũrĩa megwĩka Aburamu, nao makĩmumagaria arĩ na mũtumia wake na indo ciothe iria aarĩ nacio.<verse eid="GEN 12:20" /></para>
  <chapter eid="GEN 12" />
  <chapter number="13" style="c" sid="GEN 13" />
  <para style="s1">Gũtigana kwa Aburamu na Loti</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 13:1" />Nĩ ũndũ ũcio Aburamu akĩambata akiuma Misiri agĩthiĩ Negevu, arĩ na mũtumia wake na indo ciothe iria aarĩ nacio, na Loti agĩthiĩ hamwe nake. <verse eid="GEN 13:1" /><verse number="2" style="v" sid="GEN 13:2" />Aburamu nĩatongete mũno na ũtonga wa mahiũ, na wa betha, na wa thahabu.<verse eid="GEN 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 13:3" />Kuuma kũu Negevu nĩathiire kũndũ na kũndũ o nginya agĩkinya Betheli, o harĩa aambĩte hema yake rĩa mbere gatagatĩ ka Betheli na Ai, <verse eid="GEN 13:3" /><verse number="4" style="v" sid="GEN 13:4" />na hau nĩho aakĩte kĩgongona ihinda rĩa mbere. Na Aburamu agĩkaĩra rĩĩtwa rĩa Jehova ho.<verse eid="GEN 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 13:5" />Na rĩrĩ, Loti, ũrĩa matwaranaga na Aburamu, o nake aarĩ na ndũũru cia mbũri, na cia ngʼombe, na ndungata nyingĩ. <verse eid="GEN 13:5" /><verse number="6" style="v" sid="GEN 13:6" />Nĩ ũndũ ũcio bũrũri ũcio ndũngĩahotire kũmaigania ũrĩithio marĩ hamwe, nĩ tondũ indo ciao ciarĩ nyingĩ mũno, ũndũ matangĩahotire gũikarania hamwe. <verse eid="GEN 13:6" /><verse number="7" style="v" sid="GEN 13:7" />Na nĩ kwagĩire ngũĩ gatagatĩ ka arĩithi a Aburamu na arĩithi a Loti. Akaanani na Aperizi o nao maatũũraga o bũrũri-inĩ ũcio hĩndĩ ĩyo.<verse eid="GEN 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 13:8" />Nĩ ũndũ ũcio Aburamu akĩĩra Loti atĩrĩ, “Nĩtũtige kũgĩa na ngũĩ gatagatĩ gaitũ nawe, kana gatagatĩ ka arĩithi aku na arĩithi akwa, nĩ tondũ tũrĩ andũ a nyũmba ĩmwe. <verse eid="GEN 13:8" /><verse number="9" style="v" sid="GEN 13:9" />Githĩ bũrũri ũyũ wothe ndũrĩ mbere yaku? Reke tũtigane. Wathiĩ mwena wa ũmotho, na niĩ ngũthiĩ mwena wa ũrĩo; wathiĩ mwena wa ũrĩo, na niĩ ngũthiĩ mwena wa ũmotho.”<verse eid="GEN 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 13:10" />Loti nĩatiirire maitho, akĩbaara, akĩona atĩ kĩaragana gĩothe kĩa Jorodani kĩarĩ na maaĩ maingĩ, gĩgakĩhaana o ta mũgũnda ũrĩa wa Jehova, na o ta bũrũri wa Misiri, ũrĩa ũngʼetheire Zoari. (Hĩndĩ ĩyo nĩ mbere ya Jehova kũnũha Sodomu na Gomora.) <verse eid="GEN 13:10" /><verse number="11" style="v" sid="GEN 13:11" />Nĩ ũndũ ũcio Loti agĩĩthuurĩra kĩaragana kĩa Jorodani gĩothe na akiumagara erekeire irathĩro. Andũ acio eerĩ magĩtigana: <verse eid="GEN 13:11" /><verse number="12" style="v" sid="GEN 13:12" />Aburamu agĩtũũra bũrũri wa Kaanani, nake Loti agĩtũũra matũũra-inĩ ma kĩaragana kĩu, akĩamba hema ciake hakuhĩ na Sodomu. <verse eid="GEN 13:12" /><verse number="13" style="v" sid="GEN 13:13" />Na rĩrĩ, andũ a Sodomu maarĩ aaganu, na makehagĩria Jehova mũno.<verse eid="GEN 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 13:14" />Aburamu na Loti maatigana-rĩ, Jehova akĩĩra Aburamu atĩrĩ, “Ta tiira maitho maku na igũrũ ũrĩ o hau ũrĩ, ũrore mwena wa gathigathini na gũthini, irathĩro na ithũĩro. <verse eid="GEN 13:14" /><verse number="15" style="v" sid="GEN 13:15" />Bũrũri ũrĩa wothe ũkuona nĩngũkũhe ũtuĩke waku, na wa rũciaro rwaku nginya tene. <verse eid="GEN 13:15" /><verse number="16" style="v" sid="GEN 13:16" />Nĩngaatũma rũciaro rwaku rũingĩhe o ta rũkũngũ rwa thĩ, na kũngĩkorwo kũrĩ mũndũ ũngĩhota gũtara rũkũngũ rwa thĩ-rĩ, o na rũciaro rwaku no rũgĩtarĩke. <verse eid="GEN 13:16" /><verse number="17" style="v" sid="GEN 13:17" />Ũkĩra ũthiĩ, ũtuĩkanie bũrũri ũyũ ũraihu waguo na wariĩ waguo, tondũ nĩngũkũhe guo.”<verse eid="GEN 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 13:18" />Nĩ ũndũ ũcio Aburamu akĩambũra hema ciake, agĩthiĩ gũtũũra hakuhĩ na mĩtĩ ĩrĩa mĩnene ya mĩgandi ya Mamure kũu Hebironi, na agĩakĩra Jehova kĩgongona hau.<verse eid="GEN 13:18" /></para>
  <chapter eid="GEN 13" />
  <chapter number="14" style="c" sid="GEN 14" />
  <para style="s1">Aburamu gũteithũra Loti</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 14:1" />Ihinda-inĩ rĩu, Amurafeli mũthamaki wa Shinaru, na Arioku mũthamaki wa Elasaru, na Kedorilaomeri mũthamaki wa Elamu, na Tidali mũthamaki wa Goimu, <verse eid="GEN 14:1" /><verse number="2" style="v" sid="GEN 14:2" />nĩmathiire ita kũrũa na Bera mũthamaki wa Sodomu, na Birisha mũthamaki wa Gomora, na Shinabu mũthamaki wa Adima, na Shemeberi mũthamaki wa Zeboimu na mũthamaki wa Bela (na nokuo Zoari). <verse eid="GEN 14:2" /><verse number="3" style="v" sid="GEN 14:3" />Athamaki acio othe a gĩkundi gĩa keerĩ nĩmacookanĩrĩire hamwe Gĩtuamba-inĩ gĩa Sidimu (na nokuo Iria rĩa Cumbĩ). <verse eid="GEN 14:3" /><verse number="4" style="v" sid="GEN 14:4" />Ihinda rĩa mĩaka ikũmi na ĩĩrĩ maatũire matungatagĩra Mũthamaki Kedorilaomeri, no mwaka-inĩ wa ikũmi na ĩtatũ makĩregana na watho wake.<verse eid="GEN 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 14:5" />Mwaka-inĩ wa ikũmi na ĩna-rĩ, Mũthamaki Kedorilaomeri na athamaki arĩa maarĩ hamwe nake magĩthiĩ makĩhoota Arefai<note caller="+" style="f"><char style="fr" closed="false">14:5 </char><char style="ft" closed="false">Arefai rĩgĩtaũrwo nĩ kuuga andũ anene mũno kĩũga.</char></note> kũu Ashiterothu-Karinaimu, na Azuzi kũu Hamu, na Aemi kũu Shave-Kiriathaimu, <verse eid="GEN 14:5" /><verse number="6" style="v" sid="GEN 14:6" />nao Ahori makĩmahootera bũrũri-inĩ wa irĩma wa Seiru, o nginya Eli-Parani gũkuhĩ na werũ. <verse eid="GEN 14:6" /><verse number="7" style="v" sid="GEN 14:7" />Ningĩ athamaki acio makĩgarũrũka, magĩthiĩ Eni-Mishipatu (na nokuo Kadeshi), magĩtooria rũgongo ruothe rwa Amaleki,<note caller="+" style="f"><char style="fr" closed="false">14:7 </char><char style="ft" closed="false">Amaleki maarĩ rũrĩrĩ rwa andũ maatũũraga Negevu na bũrũri ũrĩa ũrigiicĩirie Kĩrĩma gĩa Sinai.</char></note> o hamwe na Aamori arĩa maatũũraga kũu Hazazoni-Tamaru.<verse eid="GEN 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 14:8" />Ningĩ mũthamaki wa Sodomu, na mũthamaki wa Gomora, na mũthamaki wa Adima, na mũthamaki wa Zeboimu, na mũthamaki wa Bela (na nokuo Zoari) magĩthiĩ makĩhaarĩria ita rĩao rĩa mbaara o kũu Gĩtuamba-inĩ gĩa Sidimu, <verse eid="GEN 14:8" /><verse number="9" style="v" sid="GEN 14:9" />mahũũrane na Kedorilaomeri mũthamaki wa Elamu, na Tidali mũthamaki wa Goimu, na Amurafeli mũthamaki wa Shinaru, na Arioku mũthamaki wa Elasaru, athamaki acio ana mahũũrane na athamaki acio angĩ atano. <verse eid="GEN 14:9" /><verse number="10" style="v" sid="GEN 14:10" />Na rĩrĩ, Gĩtuamba kĩu gĩa Sidimu kĩaiyũrĩte marima ma rami, na rĩrĩa athamaki a Sodomu na Gomora mooraga-rĩ, andũ amwe ao makĩgũa kuo nao arĩa angĩ makĩũrĩra irĩma-inĩ. <verse eid="GEN 14:10" /><verse number="11" style="v" sid="GEN 14:11" />Athamaki acio ana magĩtunyana indo ciothe cia Sodomu na Gomora o na irio ciakuo ciothe; magĩcooka magĩĩthiĩra. <verse eid="GEN 14:11" /><verse number="12" style="v" sid="GEN 14:12" />Ningĩ magĩtaha Loti, mũriũ wa mũrũ wa nyina na Aburamu, na indo ciake, tondũ aatũũraga kũu Sodomu.<verse eid="GEN 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 14:13" />Na rĩrĩ, mũndũ ũmwe wahonokete gũtahwo-rĩ, agĩũka na akĩĩra Aburamu ũrĩa Mũhibirania ũhoro ũcio. Na rĩrĩ, Aburamu aatũũraga hakuhĩ na mĩtĩ ĩrĩa mĩnene ya mĩgandi ya Mamure ũrĩa Mũamori, mũrũ wa nyina na Eshikoli na Aneri, na othe maarĩ rũmwe na Aburamu. <verse eid="GEN 14:13" /><verse number="14" style="v" sid="GEN 14:14" />Rĩrĩa Aburamu aiguire atĩ mũndũ ũcio wao nĩanyiitĩtwo agatahwo-rĩ, agĩĩta andũ magana matatũ na ikũmi na anana arĩa maarutĩtwo kũrũa mbaara na maaciarĩirwo gwake mũciĩ, makĩingatithia thũ icio o nginya Dani. <verse eid="GEN 14:14" /><verse number="15" style="v" sid="GEN 14:15" />Ũtukũ-rĩ, Aburamu akĩgayania andũ ake mamatharĩkĩre, nake akĩmahoota na akĩmaingatithia nginya Hoba, itũũra rĩrĩ gathigathini wa Dameski. <verse eid="GEN 14:15" /><verse number="16" style="v" sid="GEN 14:16" />Aburamu agĩcookithia indo ciothe iria ciatahĩtwo, na Loti mũndũ ũcio wao, na indo ciake ciothe, hamwe na andũ-a-nja na andũ arĩa angĩ.<verse eid="GEN 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 14:17" />Aburamu acooka kuuma kũhoota Kedorilaomeri na athamaki arĩa maarĩ rũmwe nake-rĩ, mũthamaki wa Sodomu agĩthiĩ kũmũtũnga Gĩtuamba-inĩ gĩa Shave (na no kĩo gĩĩtagwo Gĩtuamba-kĩa-Mũthamaki).<verse eid="GEN 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 14:18" />Nake Melikisedeki mũthamaki wa Salemu<note caller="+" style="f"><char style="fr" closed="false">14:18 </char><char style="ft" closed="false">Kwahoteka atĩ Salemu nĩ rĩĩtwa rĩa tene rĩa Jerusalemu.</char></note> akĩrehe mĩgate na ndibei. We aarĩ mũthĩnjĩri wa Mũrungu Ũrĩa-ũrĩ-Igũrũ-Mũno. <verse eid="GEN 14:18" /><verse number="19" style="v" sid="GEN 14:19" />Na akĩrathima Aburamu, akiuga atĩrĩ,</para>
  <para style="q1" vid="GEN 14:19">“Aburamu arorathimwo nĩ Mũrungu Ũrĩa-ũrĩ-Igũrũ-Mũno,</para>
  <para style="q2" vid="GEN 14:19">o we Mũmbi wa igũrũ na thĩ.<verse eid="GEN 14:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="GEN 14:20" />Ningĩ Mũrungu Ũrĩa-ũrĩ-Igũrũ-Mũno arogaathwo,</para>
  <para style="q2" vid="GEN 14:20">o ũcio ũraneanire thũ ciaku moko-inĩ maku.”</para>
  <para style="m" vid="GEN 14:20">Nake Aburamu akĩhe Melikisedeki gĩcunjĩ gĩa ikũmi kĩa indo ciothe iria aatunyĩte athamaki arĩa ana.<verse eid="GEN 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 14:21" />Nake mũthamaki wa Sodomu akĩĩra Aburamu atĩrĩ, “Niĩ nengera o andũ tu, ũrigie na indo ituĩke ciaku.”<verse eid="GEN 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 14:22" />No Aburamu akĩĩra mũthamaki ũcio wa Sodomu atĩrĩ, “Nĩnyambararĩtie guoko gwakwa na igũrũ na ngehĩta na mwĩhĩtwa kũrĩ Jehova Mũrungu Ũrĩa-ũrĩ-Igũrũ-Mũno, Mũmbi wa igũrũ na thĩ, <verse eid="GEN 14:22" /><verse number="23" style="v" sid="GEN 14:23" />atĩ ndingĩĩtĩkĩra kuoya kĩndũ o na kĩmwe gĩaku, o na karũrigi kana kamũkwa ga kĩraatũ, nĩgeetha ndũkanoige atĩrĩ, ‘Nĩ niĩ ndatongirie Aburamu.’ <verse eid="GEN 14:23" /><verse number="24" style="v" sid="GEN 14:24" />Ndingĩĩtĩkĩra kuoya kĩndũ, o tiga kĩrĩa kĩrĩĩtwo nĩ andũ akwa, na igai rĩa andũ arĩa tũrathiĩte nao, na nĩo Aneri, na Eshikoli, na Mamure. Acio nĩmooe rũgai rwao.”<verse eid="GEN 14:24" /></para>
  <chapter eid="GEN 14" />
  <chapter number="15" style="c" sid="GEN 15" />
  <para style="s1">Kĩrĩkanĩro kĩa Ngai na Aburamu</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 15:1" />Thuutha wa maũndũ macio, ndũmĩrĩri ya Jehova ĩgĩkinyĩra Aburamu na kĩoneki, akĩmwĩra atĩrĩ:</para>
  <para style="q1" vid="GEN 15:1">“Aburamu, ndũgetigĩre.</para>
  <para style="q2" vid="GEN 15:1">Niĩ nĩ niĩ ngo yaku,</para>
  <para style="q2" vid="GEN 15:1">na nĩ niĩ kĩheo gĩaku kĩnene.”<verse eid="GEN 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 15:2" />No Aburamu akĩmũũria atĩrĩ, “Mwathani Jehova, hihi nĩ kĩĩ ũkũũhe, kuona atĩ ndirĩ mwana, na ũrĩa ũkaagaya mũciĩ ũyũ wakwa nĩ Eliezeri wa Dameski?” <verse eid="GEN 15:2" /><verse number="3" style="v" sid="GEN 15:3" />Ningĩ Aburamu akiuga atĩrĩ, “Nĩwagĩte kũũhe ciana; nĩ ũndũ ũcio ndungata ya mũciĩ wakwa nĩyo ĩkaangaya.”<verse eid="GEN 15:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 15:4" />Hĩndĩ ĩyo ndũmĩrĩri ya Jehova ĩgĩkinyĩra Aburamu, akĩĩrwo atĩrĩ, “Aca, Eliezeri tiwe ũgaakũgaya, no mũrũguo ũrĩa ũkoima mũthiimo waku nĩwe ũgaakũgaya.” <verse eid="GEN 15:4" /><verse number="5" style="v" sid="GEN 15:5" />Akiumia Aburamu nja, akĩmwĩra atĩrĩ, “Ta tiira maitho ũrore igũrũ na ũtare njata, angĩkorwo ti-itherũ no ũcitare.” Ningĩ akĩmwĩra atĩrĩ, “Ũguo nĩguo rũciaro rwaku rũkaigana.”<verse eid="GEN 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 15:6" />Aburamu agĩĩtĩkia Jehova. Nake Jehova agĩkenio nĩ wĩtĩkio ũcio, akĩmũtua mũthingu.<verse eid="GEN 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 15:7" />Ningĩ akĩmwĩra atĩrĩ, “Nĩ niĩ Jehova ũrĩa wakũrutire bũrũri wa Uri-kwa-Akalidei, nĩgeetha ngũhe bũrũri ũyũ ũtuĩke igai rĩaku.”<verse eid="GEN 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 15:8" />No Aburamu akĩmũũria atĩrĩ, “Mwathani Jehova, ũngĩĩmenyithia nakĩ atĩ nĩũgatuĩka igai rĩakwa?”<verse eid="GEN 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 15:9" />Nĩ ũndũ ũcio Jehova akĩmwĩra atĩrĩ, “Ta ndeehera moori, na mbũri, na ndũrũme, na o ĩmwe yacio ĩkorwo ĩrĩ na mĩaka ĩtatũ, o hamwe na ndutura, na gĩcui kĩa ndirahũgĩ.”<verse eid="GEN 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 15:10" />Aburamu akĩrehera Jehova indo icio ciothe, agĩciatũrania njatũ igĩrĩ, na agĩciara mũhari, o rwatũ rũkaringana na rwatũ rũrĩa rũngĩ; no nyoni-rĩ, aaciũraga ndaaciatũranirie.<note caller="+" style="f"><char style="fr" closed="false">15:10 </char><char style="ft" closed="false">Kĩrĩkanĩro o gĩothe kĩarĩkia kũiguithanĩrio nĩ kwarutagwo igongona rĩa nyamũ ĩrĩa yatinanagio maita meerĩ, nao arĩa maathondekaga kĩrĩkanĩro kĩu makagera gatagatĩ ga icunjĩ icio cierĩ.</char></note> <verse eid="GEN 15:10" /><verse number="11" style="v" sid="GEN 15:11" />Nacio nderi ikĩharũrũkĩra nyama icio, no Aburamu agĩcingata, agĩciũmbũra.<verse eid="GEN 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 15:12" />Riũa rĩgĩthũa-rĩ, Aburamu agĩkoma toro mũnene, nayo nduma nene na ya kũmakania ĩkĩmũnyiita. <verse eid="GEN 15:12" /><verse number="13" style="v" sid="GEN 15:13" />Ningĩ Jehova akĩmwĩra atĩrĩ, “Menya na ma atĩ njiaro ciaku nĩigatũũra irĩ ageni bũrũri ũtarĩ wacio, na nĩigatuuo ngombo na inyariirwo mĩaka magana mana. <verse eid="GEN 15:13" /><verse number="14" style="v" sid="GEN 15:14" />No nĩngaherithia rũrĩrĩ rũu igatungata irĩ ngombo, na thuutha ũcio nĩikoima kuo irĩ na ũtonga mũingĩ. <verse eid="GEN 15:14" /><verse number="15" style="v" sid="GEN 15:15" />No wee-rĩ, ũgaakua na thayũ, na ũgaathikwo ũrĩ na ũkũrũ mwega. <verse eid="GEN 15:15" /><verse number="16" style="v" sid="GEN 15:16" />Rũciaro-inĩ rwa kana-rĩ, njiaro ciaku nĩigacooka gũkũ, nĩgũkorwo mehia ma Aamori matikinyĩte harĩa ho.”<verse eid="GEN 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 15:17" />Na rĩrĩ, riũa rĩathũa na kwagĩa nduma-rĩ, hakĩoneka nyũngũ ya mwaki yatoogaga ĩrĩ na kĩmũrĩ gĩkĩrĩrĩmbũka gĩgĩtuĩkanĩria gatagatĩ ka njatũ icio. <verse eid="GEN 15:17" /><verse number="18" style="v" sid="GEN 15:18" />Mũthenya ũcio, Jehova akĩrĩĩkanĩra na Aburamu kĩrĩkanĩro, akĩmwĩra atĩrĩ, “Nĩndahe njiaro ciaku bũrũri ũyũ, kuuma rũũĩ rwa Misiri nginya rũũĩ rũrĩa rũnene rwa Farati: <verse eid="GEN 15:18" /><verse number="19" style="v" sid="GEN 15:19" />bũrũri wa Akeni, na wa Akenizi, na wa Akadimoni, <verse eid="GEN 15:19" /><verse number="20" style="v" sid="GEN 15:20" />na wa Ahiti, na wa Aperizi, na wa Arefai, <verse eid="GEN 15:20" /><verse number="21" style="v" sid="GEN 15:21" />na wa Aamori, na wa Akaanani, na wa Agirigashi, na wa Ajebusi.”<verse eid="GEN 15:21" /></para>
  <chapter eid="GEN 15" />
  <chapter number="16" style="c" sid="GEN 16" />
  <para style="s1">Hagari na Ishumaeli</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 16:1" />Na rĩrĩ, Sarai mũtumia wa Aburamu ndaamũciarĩire ciana. No nĩ aarĩ na mũirĩtu Mũmisiri wamũtungatagĩra wetagwo Hagari; <verse eid="GEN 16:1" /><verse number="2" style="v" sid="GEN 16:2" />tondũ ũcio Sarai akĩĩra Aburamu atĩrĩ, “Jehova nĩagirĩtie ngĩe na ciana. Thiĩ ũkome na ndungata yakwa ya mũirĩtu; hihi kwahoteka ngĩe na rũciaro nĩ ũndũ wake.”<note caller="+" style="f"><char style="fr" closed="false">16:2 </char><char style="ft" closed="false">Kwaga kũgĩa ciana kuonekaga taarĩ iherithia kuuma kũrĩ Ngai. Mũtugo wa mahinda macio nĩwetĩkĩrĩtie mũtumia athuurĩre mũthuuriwe mũtumia, no ciana iria maagĩa igakorwo irĩ cia mũtumia ũcio thata.</char></note></para>
  <para style="p" vid="GEN 16:2">Nake Aburamu agĩĩtĩkania na ũrĩa Sarai oigire. <verse eid="GEN 16:2" /><verse number="3" style="v" sid="GEN 16:3" />Nĩ ũndũ ũcio, thuutha wa Aburamu gũkorwo atũũrĩte Kaanani mĩaka ikũmi-rĩ, mũtumia wake Sarai akĩoya Hagari Mũmisiri ũrĩa warĩ ndungata yake ya mũirĩtu, akĩmũneana kũrĩ mũthuuriwe atuĩke mũtumia wake. <verse eid="GEN 16:3" /><verse number="4" style="v" sid="GEN 16:4" />Nake Aburamu agĩkoma na Hagari, nake akĩgĩa nda.</para>
  <para style="p" vid="GEN 16:4">Na rĩrĩa aamenyire atĩ nĩagĩĩte nda-rĩ, akĩambĩrĩria kũnyarara Sarai mwathi wake. <verse eid="GEN 16:4" /><verse number="5" style="v" sid="GEN 16:5" />Hĩndĩ ĩyo Sarai akĩĩra Aburamu atĩrĩ, “Ũũru ũyũ ũrathĩĩnia-rĩ, ũrogũcookerera arĩ we. Ndaneanire ndungata yakwa moko-inĩ maku, na rĩu tondũ nĩĩmenyete atĩ ĩrĩ na nda, no kũũnyarara. Jehova arotũtuithania niĩ nawe.”<verse eid="GEN 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 16:6" />Aburamu akĩmũcookeria atĩrĩ, “Ndungata yaku ĩrĩ moko-inĩ maku. Ĩka nayo ũrĩa ũkuona kwagĩrĩire.” Nake Sarai akĩnyamaria Hagari mũno; nĩ ũndũ ũcio Hagari akĩmũũrĩra.<verse eid="GEN 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 16:7" />Mũraika wa Jehova agĩkora Hagari hakuhĩ na handũ haatherũkaga maaĩ werũ-inĩ; gathima kau kaarĩ mũkĩra-inĩ wa njĩra ĩrĩa ya gũthiĩ Shuri. <verse eid="GEN 16:7" /><verse number="8" style="v" sid="GEN 16:8" />Mũraika akĩmũũria atĩrĩ, “Hagari ndungata ya Sarai, uuma kũ na wathiĩ kũ?”</para>
  <para style="p" vid="GEN 16:8">Hagari akĩmũcookeria atĩrĩ, “Nĩ kũũrĩra ndĩroorĩra Sarai ũrĩa mwathi wakwa.”<verse eid="GEN 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 16:9" />Ningĩ mũraika wa Jehova akĩmwĩra atĩrĩ, “Cooka kũrĩ mũtumia ũcio mwathi waku na ũmwĩnyiihĩrie.” <verse eid="GEN 16:9" /><verse number="10" style="v" sid="GEN 16:10" />Ningĩ mũraika agĩcooka akĩmwĩra atĩrĩ, “Nĩngaingĩhia njiaro ciaku ũndũ itagaatarĩka.”<verse eid="GEN 16:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 16:11" />Mũraika wa Jehova ningĩ akĩmwĩra atĩrĩ:</para>
  <para style="q1" vid="GEN 16:11">“Rĩu ũrĩ na nda,</para>
  <para style="q2" vid="GEN 16:11">na nĩũgaciara kaana ga kahĩĩ,</para>
  <para style="q1" vid="GEN 16:11">na ũgaagatua Ishumaeli.</para>
  <para style="q2" vid="GEN 16:11">Nĩgũkorwo Jehova nĩaiguĩte ũhoro wa mĩnyamaro yaku.<note caller="+" style="f"><char style="fr" closed="false">16:11 </char><char style="ft" closed="false">Rĩĩtwa Ishumaeli rĩgĩtaũrwo nĩ kuuga “Ngai nĩaiguaga.”</char></note><verse eid="GEN 16:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="GEN 16:12" />Mũrũguo agaatuĩka wa mbũrũrũ ta ndigiri ya gĩthaka;</para>
  <para style="q2" vid="GEN 16:12">guoko gwake gũgookagĩrĩra andũ othe,</para>
  <para style="q2" vid="GEN 16:12">nao andũ othe mamũũkagĩrĩre:</para>
  <para style="q1" vid="GEN 16:12">agaatũũra na ũthũ na ariũ a ithe othe.”<verse eid="GEN 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 16:13" />Nake Hagari akĩhe Jehova ũcio wamwarĩirie rĩĩtwa rĩĩrĩ: “Wee nĩwe Ngai ũrĩa ũnyonaga,” nĩgũkorwo oigire atĩrĩ, “Rĩu niĩ ndĩkuona Ũrĩa ũnyonaga.” <verse eid="GEN 16:13" /><verse number="14" style="v" sid="GEN 16:14" />Nĩkĩo gĩthima kĩu gĩetirwo Biri-Lahai-Roi, na kĩrĩ o ho, kũu gatagatĩ ga Kadeshi na Beredi.<verse eid="GEN 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 16:15" />Nĩ ũndũ ũcio Hagari agĩciarĩra Aburamu mwana wa kahĩĩ, nake Aburamu agĩtua kaana kau aaciarĩirwo Ishumaeli. <verse eid="GEN 16:15" /><verse number="16" style="v" sid="GEN 16:16" />Aburamu aarĩ wa mĩaka mĩrongo ĩnana na ĩtandatũ rĩrĩa Hagari aamũciarĩire Ishumaeli.<verse eid="GEN 16:16" /></para>
  <chapter eid="GEN 16" />
  <chapter number="17" style="c" sid="GEN 17" />
  <para style="s1">Kĩrĩkanĩro gĩa Kũrua</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 17:1" />Na rĩrĩ, rĩrĩa Aburamu aarĩ na ũkũrũ wa mĩaka mĩrongo kenda na kenda-rĩ, Jehova nĩamuumĩrĩire, akĩmwĩra atĩrĩ, “Niĩ nĩ niĩ Mũrungu Mwene-Hinya-Wothe; tũũra ũnjathĩkagĩra, na ũtarĩ na ũcuuke. <verse eid="GEN 17:1" /><verse number="2" style="v" sid="GEN 17:2" />Na niĩ nĩngũtũũria kĩrĩkanĩro gatagatĩ gakwa nawe, na nĩngaingĩhia mũigana waku mũno.”<verse eid="GEN 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 17:3" />Aburamu agĩturumithia ũthiũ wake thĩ, nake Ngai akĩmwĩra atĩrĩ, <verse eid="GEN 17:3" /><verse number="4" style="v" sid="GEN 17:4" />“Hakwa-rĩ, gĩkĩ nĩkĩo kĩrĩkanĩro gĩakwa nawe: Wee nĩũgatuĩka ithe wa ndũrĩrĩ nyingĩ. <verse eid="GEN 17:4" /><verse number="5" style="v" sid="GEN 17:5" />Ndũgũcooka gwĩtwo Aburamu; ũrĩĩtagwo Iburahĩmu, nĩgũkorwo nĩngũtuĩte ithe wa ndũrĩrĩ nyingĩ. <verse eid="GEN 17:5" /><verse number="6" style="v" sid="GEN 17:6" />Nĩngũtũma ũciare mũno; na ndũme ũtuĩke ithe wa ndũrĩrĩ nyingĩ, nao athamaki nĩmakoima thĩinĩ waku. <verse eid="GEN 17:6" /><verse number="7" style="v" sid="GEN 17:7" />Nĩngũthondeka kĩrĩkanĩro gĩakwa kĩrĩ kĩrĩkanĩro gĩa gũtũũra tene na tene gatagatĩ gakwa nawe na njiaro ciaku iria igooka thuutha waku, na nginya njiarwa ciaku cia thuutha, nĩguo nduĩke Ngai waku na Ngai wa njiaro iria igooka thuutha waku. <verse eid="GEN 17:7" /><verse number="8" style="v" sid="GEN 17:8" />Nĩngakũhe bũrũri ũyũ wothe wa Kaanani, kũrĩa ũrĩ mũgeni rĩu, ũtũũre ũrĩ igai rĩaku na rĩa njiaro ciaku iria igooka thuutha waku; na nĩngatuĩka Ngai wao.”<verse eid="GEN 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 17:9" />Ningĩ Ngai agĩcooka akĩĩra Iburahĩmu atĩrĩ, “Wee-rĩ, no nginya ũmenyagĩrĩre kĩrĩkanĩro gĩakwa, wee na njiaro iria igooka thuutha waku, harĩ njiarwa na njiarwa iria igooka. <verse eid="GEN 17:9" /><verse number="10" style="v" sid="GEN 17:10" />Gĩkĩ nĩkĩo kĩrĩkanĩro gĩakwa nawe na njiaro iria igooka thuutha waku, kĩrĩkanĩro kĩrĩa ũrĩmenyagĩrĩra: Arũme othe thĩinĩ wanyu nĩmarĩruaga. <verse eid="GEN 17:10" /><verse number="11" style="v" sid="GEN 17:11" />Mũrĩruaga nĩguo ũndũ ũcio ũtuĩke kĩmenyithia gĩa kĩrĩkanĩro gatagatĩ gakwa nawe. <verse eid="GEN 17:11" /><verse number="12" style="v" sid="GEN 17:12" />Harĩ njiarwa iria igooka thuutha, mũndũ mũrũme wothe thĩinĩ wanyu no nginya arue arĩ na ũkũrũ wa thikũ inyanya, kũrutia arĩa maciarĩtwo thĩinĩ wa nyũmba yaku kana arĩa magũrĩtwo na mbeeca kuuma kũrĩ andũ a kũngĩ-arĩa matarĩ a rũciaro rwaku. <verse eid="GEN 17:12" /><verse number="13" style="v" sid="GEN 17:13" />Mũndũ ũcio, wagũciarĩrwo nyũmba-inĩ yaku kana wakũgũrwo na mbeeca ciaku-rĩ, no nginya arue. Kĩrĩkanĩro gĩakwa kĩa mĩĩrĩ yanyu gĩgũtuĩka kĩrĩkanĩro gĩa gũtũũra tene na tene. <verse eid="GEN 17:13" /><verse number="14" style="v" sid="GEN 17:14" />Mũndũ mũrũme wothe ũtarĩ mũruu, ũrĩa ũtaruithĩtio mwĩrĩ wake-rĩ, nĩakeherio harĩ andũ ao; ũcio ndahingĩtie kĩrĩkanĩro gĩakwa.”<verse eid="GEN 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 17:15" />Ningĩ Ngai akĩĩra Iburahĩmu atĩrĩ, “Ha ũhoro wa Sarai mũtumia waku-rĩ, ndũgũcooka kũmwĩta Sarai; arĩĩtagwo Sara. <verse eid="GEN 17:15" /><verse number="16" style="v" sid="GEN 17:16" />Nĩngũmũrathima, na ti-itherũ nĩngũkũhe mwana wa kahĩĩ ũciarĩirwo nĩwe. Nĩngũmũrathima nĩguo atuĩke nyina wa ndũrĩrĩ; athamaki a ndũrĩrĩ makoima harĩwe.”<verse eid="GEN 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 17:17" />Iburahĩmu agĩturumithia ũthiũ wake thĩ, agĩcooka agĩtheka, akĩĩyũria na ngoro atĩrĩ, “Mũndũ ũrĩ na mĩaka igana nĩegũciara mwana wa kahĩĩ? Sara no aciare mwana arĩ na mĩaka mĩrongo kenda?” <verse eid="GEN 17:17" /><verse number="18" style="v" sid="GEN 17:18" />Nake Iburahĩmu akĩĩra Ngai atĩrĩ, “Naarĩ korwo Ishumaeli atũũra arathimagwo nĩwe!”<verse eid="GEN 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 17:19" />Nake Ngai akĩmũcookeria atĩrĩ, “Ĩĩ nĩguo, no mũtumia waku Sara nĩagagũciarĩra kahĩĩ, na nĩũgaagatua Isaaka. Nĩngathondeka kĩrĩkanĩro nake gĩa gũtũũra tene na tene harĩ njiaro ciake iria igooka thuutha wake. <verse eid="GEN 17:19" /><verse number="20" style="v" sid="GEN 17:20" />Na ha ũhoro wa Ishumaeli, nĩndakũigua: Ti-itherũ nĩngũmũrathima; nĩngũtũma aciarane, aingĩhe mũno. Nĩagatuĩka ithe wa aathani ikũmi na eerĩ, na nĩngamũtua rũrĩrĩ rũnene. <verse eid="GEN 17:20" /><verse number="21" style="v" sid="GEN 17:21" />No kĩrĩkanĩro gĩakwa ngaathondeka na Isaaka, ũrĩa Sara egũgũciarĩra mwaka ũyũ ũgũũka, ihinda-inĩ ta rĩĩrĩ tũrĩ.” <verse eid="GEN 17:21" /><verse number="22" style="v" sid="GEN 17:22" />Ngai aarĩkia kwaria na Iburahĩmu, akĩambata, akĩmũtiga.<verse eid="GEN 17:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 17:23" />Mũthenya o ro ũcio, Iburahĩmu akĩoya mũriũ wake Ishumaeli, na arĩa othe maciarĩirwo gwake, o na arĩa magũrĩtwo na mbeeca ciake, mũndũ mũrũme wothe wa nyũmba yake, akĩmaruithia, o ta ũrĩa Ngai aamwĩrĩte. <verse eid="GEN 17:23" /><verse number="24" style="v" sid="GEN 17:24" />Iburahĩmu aarĩ wa mĩaka mĩrongo kenda na kenda rĩrĩa aaruire, <verse eid="GEN 17:24" /><verse number="25" style="v" sid="GEN 17:25" />nake mũriũ wake Ishumaeli aarĩ wa mĩaka ikũmi na ĩtatũ. <verse eid="GEN 17:25" /><verse number="26" style="v" sid="GEN 17:26" />Iburahĩmu na mũriũ wake Ishumaeli maaruire hamwe mũthenya o ro ũcio. <verse eid="GEN 17:26" /><verse number="27" style="v" sid="GEN 17:27" />Na mũndũ mũrũme wothe thĩinĩ wa nyũmba ya Iburahĩmu, arĩa maciarĩirwo gwake, kana mũndũ wagũrĩtwo kuuma kũrĩ mũndũ wa kũngĩ, maaruanĩire hamwe nake.<verse eid="GEN 17:27" /></para>
  <chapter eid="GEN 17" />
  <chapter number="18" style="c" sid="GEN 18" />
  <para style="s1">Ageni arĩa Atatũ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 18:1" />Mũthenya ũmwe Jehova nĩ oimĩrĩire Iburahĩmu rĩrĩa aikarĩte mũromo-inĩ wa hema yake hakuhĩ na mĩtĩ ĩrĩa mĩnene ya mĩgandi ya Mamure, ihinda rĩa mĩaraho. <verse eid="GEN 18:1" /><verse number="2" style="v" sid="GEN 18:2" />Na rĩrĩ, Iburahĩmu aatiira maitho-rĩ, akĩona andũ atatũ marũgamĩte o hakuhĩ nake. Rĩrĩa aamoonire, akĩhiũha akiuma mũromo-inĩ wa hema yake, agĩthiĩ kũmatũnga, na agĩturumithia ũthiũ wake thĩ.<verse eid="GEN 18:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 18:3" />Akiuga atĩrĩ, “Mwathi wakwa, angĩkorwo nĩndetĩkĩrĩka maitho-inĩ maku, ndũkahĩtũke ndungata yaku. <verse eid="GEN 18:3" /><verse number="4" style="v" sid="GEN 18:4" />Reke tũũĩ tũnini tũrehwo, na inyuĩ inyuothe mwĩthambe magũrũ na mũhurũke kĩĩruru-inĩ kĩa mũtĩ ũyũ. <verse eid="GEN 18:4" /><verse number="5" style="v" sid="GEN 18:5" />Na niĩ thiĩ ndĩmũrehere kĩndũ gĩa kũrĩa, nĩgeetha mũcookwo nĩ hinya, kuona atĩ nĩmwagĩũka kwa ndungata yanyu, nĩguo mũcooke mwĩthiĩre.”</para>
  <para style="p" vid="GEN 18:5">Makĩmũcookeria atĩrĩ, “Nĩ wega mũno, ĩka o ũguo woiga.”<verse eid="GEN 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 18:6" />Nĩ ũndũ ũcio Iburahĩmu akĩhiũha agĩthiĩ hema-inĩ kũrĩ Sara, akĩmwĩra atĩrĩ, “Oya ibaba ithatũ<note caller="+" style="f"><char style="fr" closed="false">18:6 </char><char style="ft" closed="false">nĩ ta kilo 22.</char></note> cia mũtu ũrĩa mũhinyu wega, ũũkande na ũruge mĩgate naihenya.”<verse eid="GEN 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 18:7" />Ningĩ Iburahĩmu agĩtengʼera rũũru-inĩ, agĩthuura njaũ njega na njororo, akĩmĩnengera ndungata, nayo ĩkĩmĩthĩnja naihenya. <verse eid="GEN 18:7" /><verse number="8" style="v" sid="GEN 18:8" />Ningĩ Iburahĩmu akĩmarehera iria imata na iria rĩa mwĩtha, na nyama cia njaũ ĩyo yathĩnjĩtwo, agĩciiga hau mbere yao. Nake akĩrũgama hakuhĩ nao mũtĩ-inĩ rĩrĩa maarĩĩaga.<verse eid="GEN 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 18:9" />Maarĩkia kũrĩa makĩmũũria atĩrĩ, “Sara mũtumia waku-rĩ, arĩ kũ?”</para>
  <para style="p" vid="GEN 18:9">Iburahĩmu akĩmacookeria atĩrĩ, “Arĩ kũũrĩa hema thĩinĩ.”<verse eid="GEN 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 18:10" />Nake Jehova akiuga atĩrĩ, “Ti-itherũ nĩngooka kũrĩ we rĩngĩ hĩndĩ o ta ĩno mwaka ũyũ ũroka, na Sara mũtumia waku nĩagaciara kaana ga kahĩĩ.”</para>
  <para style="p" vid="GEN 18:10">Nake Sara nĩathikagĩrĩria arĩ hau mũromo-inĩ wa hema ĩrĩa yarĩ thuutha wa Iburahĩmu. <verse eid="GEN 18:10" /><verse number="11" style="v" sid="GEN 18:11" />Na rĩrĩ, Iburahĩmu na Sara maarĩ akũrũ na magatindĩka mĩaka yao ma, nake Sara akahĩtũkia mĩaka ya gũciara. <verse eid="GEN 18:11" /><verse number="12" style="v" sid="GEN 18:12" />Nĩ ũndũ ũcio, Sara agĩĩthekera, akĩĩyũria atĩrĩ, “Thuutha wa gũkũra ũũ-rĩ, na mwathi wakwa nĩ mũkũrũ-rĩ, no ngĩgĩe na gĩkeno kĩu?”<verse eid="GEN 18:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 18:13" />Nake Jehova akĩũria Iburahĩmu atĩrĩ, “Nĩ kĩĩ gĩatũma Sara atheke na eyũrie, ‘Ti-itherũ no ngĩe na mwana ndĩ mũkũrũ ũguo?’ <verse eid="GEN 18:13" /><verse number="14" style="v" sid="GEN 18:14" />Kaĩ kũrĩ ũndũ ũngĩrema Jehova? Mwaka ũyũ ũroka-rĩ, nĩngacooka ihinda rĩrĩa rĩamũre, nake Sara nĩagaciara kaana ga kahĩĩ.”<verse eid="GEN 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 18:15" />Sara agĩĩtigĩra mũno, nĩ ũndũ ũcio akĩheenania, akiuga atĩrĩ, “Niĩ ndinatheka.”</para>
  <para style="p" vid="GEN 18:15">Nowe Jehova akiuga atĩrĩ, “Nĩ ma nĩwatheka.”<verse eid="GEN 18:15" /></para>
  <para style="s1">Iburahĩmu Gũthaithanĩrĩra Sodomu</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 18:16" />Rĩrĩa andũ acio mookĩrire mathiĩ-rĩ, makĩerekera na Sodomu,<note caller="+" style="f"><char style="fr" closed="false">18:16 </char><char style="ft" closed="false">Itũũra rĩa Sodomu rĩrĩ o harĩa rĩarĩ mwena wa gũthini wa Iria rĩa Cumbĩ.</char></note> nake Iburahĩmu agĩtwarana nao amoimagarie. <verse eid="GEN 18:16" /><verse number="17" style="v" sid="GEN 18:17" />Hĩndĩ ĩyo Jehova akĩĩyũria atĩrĩ, “No hithe Iburahĩmu ũrĩa ndĩrenda gwĩka? <verse eid="GEN 18:17" /><verse number="18" style="v" sid="GEN 18:18" />Ti-itherũ Iburahĩmu nĩagatuĩka rũrĩrĩ rũnene na rwa hinya, na ndũrĩrĩ ciothe cia thĩ nĩikarathimwo nĩ ũndũ wake. <verse eid="GEN 18:18" /><verse number="19" style="v" sid="GEN 18:19" />Nĩgũkorwo nĩndĩmũthuurĩte nĩgeetha onagĩrĩrie ciana ciake, na nyũmba yake, na arĩa magooka thuutha wake, kũrũmagia mĩthiĩre ya Jehova na ũndũ wa gwĩkaga ũrĩa kwagĩrĩire, na kĩhooto, nĩgeetha Jehova akaahingĩria Iburahĩmu ũrĩa aamwĩrĩire.”<verse eid="GEN 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 18:20" />Ningĩ Jehova akiuga atĩrĩ, “Mũkayo wĩgiĩ Sodomu na Gomora nĩ mũnene mũno, naguo wĩhia wao nĩ mũũru mũno. <verse eid="GEN 18:20" /><verse number="21" style="v" sid="GEN 18:21" />Nĩ ũndũ ũcio niĩ nĩngũikũrũka thiĩ nyone kana ũũru ũrĩa mekĩte nĩũigana ikaya rĩrĩa rĩnginyĩire. Na aakorwo tiguo-rĩ, nĩngũmenya ũrĩa ngwĩka.”<verse eid="GEN 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 18:22" />Nĩ ũndũ ũcio andũ acio makiuma hau magĩthiĩ merekeire Sodomu, no Iburahĩmu agĩtigwo arũgamĩte mbere ya Jehova. <verse eid="GEN 18:22" /><verse number="23" style="v" sid="GEN 18:23" />Nake Iburahĩmu agĩkuhĩrĩria Jehova akĩmũũria atĩrĩ, “Andũ arĩa athingu ũkũmaniinanĩria hamwe na arĩa aaganu? <verse eid="GEN 18:23" /><verse number="24" style="v" sid="GEN 18:24" />Ĩ kũngĩkorwo kũrĩ na andũ mĩrongo ĩtano athingu itũũra-inĩ rĩu inene? Ti-itherũ no ũrĩniine na ndũrĩhonokie nĩ ũndũ wa andũ acio mĩrongo ĩtano athingu marĩ kuo? <verse eid="GEN 18:24" /><verse number="25" style="v" sid="GEN 18:25" />Ũroaga gwĩka ũndũ ta ũcio, wa kũũraganĩria arĩa athingu hamwe na arĩa aaganu, arĩa athingu na arĩa aaganu ũmataranĩrie ũndũ ũmwe. Ũroaga gwĩka ũndũ ta ũcio! Mũtuanĩri ciira wa thĩ yothe-rĩ, githĩ ndagĩrĩirwo nĩ gwĩka ũrĩa kwagĩrĩire?”<verse eid="GEN 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 18:26" />Nake Jehova akiuga atĩrĩ, “Ingĩkora andũ mĩrongo ĩtano athingu kũu itũũra rĩu inene rĩa Sodomu-rĩ, nĩngũhonokia kũndũ kũu guothe nĩ ũndũ wao.”<verse eid="GEN 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 18:27" />Ningĩ Iburahĩmu akĩaria rĩngĩ, akiuga atĩrĩ: “Rĩu tondũ nĩngĩĩũmĩrĩirie nginya ndaaria na Mwathani, o na gũtuĩka ndĩ o rũkũngũ na mũhu-rĩ, atĩrĩ, <verse eid="GEN 18:27" /><verse number="28" style="v" sid="GEN 18:28" />ĩ hangĩaga andũ atano a acio mĩrongo ĩtano athingu? Nĩ ũngĩniina itũũra rĩu inene rĩothe nĩ ũndũ wa kwaga acio atano?”</para>
  <para style="p" vid="GEN 18:28">Jehova akĩmwĩra atĩrĩ, “Ingĩkora andũ mĩrongo ĩna na atano kuo, ndikũrĩniina.”<verse eid="GEN 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 18:29" />O rĩngĩ Iburahĩmu akĩmwarĩria akĩmũũria atĩrĩ, “Ĩ ũngĩkora andũ mĩrongo ĩna tu kuo?”</para>
  <para style="p" vid="GEN 18:29">Nake akiuga atĩrĩ, “Nĩ ũndũ wa acio mĩrongo ĩna-rĩ, ndikũrĩniina.”<verse eid="GEN 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 18:30" />Ningĩ Iburahĩmu akiuga atĩrĩ, “Mwathani aroaga kũrakara, no areke njarie. Ĩ ũngĩkora andũ mĩrongo ĩtatũ kuo?”</para>
  <para style="p" vid="GEN 18:30">Nake akĩmũcookeria atĩrĩ, “Ndikũrĩniina ingĩkora andũ mĩrongo ĩtatũ kuo.”<verse eid="GEN 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 18:31" />Iburahĩmu akiuga atĩrĩ, “Rĩu tondũ nĩngĩĩũmĩrĩirie nginya ndaaria na Mwathani-rĩ, ĩ kũngĩoneka o andũ mĩrongo ĩĩrĩ kuo?”</para>
  <para style="p" vid="GEN 18:31">Nake Jehova akiuga atĩrĩ, “Nĩ ũndũ wa acio mĩrongo ĩĩrĩ, ndikũrĩniina.”<verse eid="GEN 18:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 18:32" />Ningĩ akiuga atĩrĩ, “Mwathani aroaga kũrakara no areke njarie rĩngĩ rĩmwe. Ĩ kũngĩoneka o andũ ikũmi kuo?”</para>
  <para style="p" vid="GEN 18:32">Nake Jehova agĩcookia, akiuga atĩrĩ, “Nĩ ũndũ wa acio ikũmi-rĩ, ndikũrĩniina.”<verse eid="GEN 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 18:33" />Rĩrĩa Jehova aarĩkirie kwaria na Iburahĩmu, agĩĩthiĩra, nake Iburahĩmu agĩcooka mũciĩ.<verse eid="GEN 18:33" /></para>
  <chapter eid="GEN 18" />
  <chapter number="19" style="c" sid="GEN 19" />
  <para style="s1">Kwanangwo gwa Sodomu na Gomora</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 19:1" />Nao araika acio eerĩ magĩkinya Sodomu hwaĩ-inĩ, nake Loti aikarĩte kĩhingo-inĩ gĩa itũũra rĩu inene. Rĩrĩa aamoonire-rĩ, agĩũkĩra nĩguo amatũnge, na agĩturumithia ũthiũ wake thĩ. <verse eid="GEN 19:1" /><verse number="2" style="v" sid="GEN 19:2" />Akĩmeera atĩrĩ, “Aathi akwa, ndamũthaitha ũkai mũtoonye nyũmba ya ndungata yanyu. No mwĩthambe magũrũ na mũraarĩrĩre, na rũciinĩ tene mũrooke gũthiĩ na mbere na rũgendo rwanyu.”</para>
  <para style="p" vid="GEN 19:2">No-o makĩmũcookeria atĩrĩ, “Aca, ithuĩ tũkũraara nja kĩhaaro-inĩ.”<verse eid="GEN 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 19:3" />Nowe Loti akĩmaringĩrĩria na hinya mũno mathiĩ gwake mũciĩ, nginya magĩtĩkĩra. Magĩthiĩ nake, magĩtoonya nyũmba gwake. Nake akĩmathondekera irio, akĩruga mĩgate ĩtaarĩ ndawa ya kũimbia, nao makĩrĩa. <verse eid="GEN 19:3" /><verse number="4" style="v" sid="GEN 19:4" />Matanathiĩ gũkoma-rĩ, arũme othe a kuuma ituri ciothe cia itũũra rĩu rĩa Sodomu, arĩa ethĩ na arĩa akũrũ, makĩrigiicĩria nyũmba ya Loti. <verse eid="GEN 19:4" /><verse number="5" style="v" sid="GEN 19:5" />Nao magĩĩta Loti, makĩmũũria atĩrĩ, “Andũ arĩa mookire gwaku ũtukũ ũyũ-rĩ, marĩ-kũ? Marehe na gũkũ nja, tũkome nao.”<verse eid="GEN 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 19:6" />Loti akiuma na nja amatũnge, na akĩhinga mũrango, <verse eid="GEN 19:6" /><verse number="7" style="v" sid="GEN 19:7" />akĩmeera atĩrĩ, “Aca, arata akwa; mũtigeke ũndũ ũcio wa waganu. <verse eid="GEN 19:7" /><verse number="8" style="v" sid="GEN 19:8" />Atĩrĩrĩ, ndĩ na airĩtu akwa eerĩ matarĩ maakoma na mũndũ mũrũme. Rekei ndĩmarehe na gũkũ nja, na inyuĩ mwĩke o ũrĩa mũkwenda nao. No mũtigeke ũndũ o na ũrĩkũ kũrĩ andũ aya, tondũ mokĩte gwakwa na no nginya ndĩmagitĩre.”<verse eid="GEN 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 19:9" />Nao makĩmũcookeria atĩrĩ, “Ehera.” Na makiuga atĩrĩ, “Mũndũ ũyũ ookire gũkũ arĩ mũgeni, na rĩu arenda gũtũciirithia! Wee nĩwe tũgwĩka ũũru gũkĩra acio!” Magĩkĩrĩrĩria kũhatĩrĩria Loti, na magĩkuhĩrĩria nĩguo moinange mũrango.<verse eid="GEN 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 19:10" />No ageni acio maarĩ thĩinĩ magĩtambũrũkia moko, makĩguucia Loti, makĩmũcookia nyũmba na makĩhinga mũrango. <verse eid="GEN 19:10" /><verse number="11" style="v" sid="GEN 19:11" />Magĩcooka makĩhũũra andũ acio maarĩ nja ya mũrango wa nyũmba, ethĩ na akũrũ, na ũtumumu nĩgeetha mage kuona mũrango.<verse eid="GEN 19:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 19:12" />Andũ acio eerĩ makĩũria Loti atĩrĩ, “Ũrĩ na andũ angĩ aku gũkũ, ta arĩa mahikĩtie airĩtu aku, aanake kana airĩtu aku, kana mũndũ ũngĩ waku o wothe ũrĩ itũũra-inĩ rĩĩrĩ inene? Moimagarie muume gũkũ, <verse eid="GEN 19:12" /><verse number="13" style="v" sid="GEN 19:13" />tondũ nĩtũkwananga kũndũ gũkũ. Mũkayo ũrĩa ũkaĩirwo Jehova okĩrĩre andũ a gũkũ nĩ mũnene mũno, na nĩatũtũmĩte tũũke tũrĩanange.”<verse eid="GEN 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 19:14" />Nĩ ũndũ ũcio Loti akiumagara, agĩthiĩ akĩaria na athoni ake, arĩa maarĩ mahikie airĩtu ake. Akĩmeera atĩrĩ, “Mwĩhĩkei muume kũndũ gũkũ, nĩ ũndũ Jehova arĩ hakuhĩ kwananga itũũra rĩĩrĩ inene!” No athoni ake magĩĩciiria nĩ itherũ aamaringaga.<verse eid="GEN 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 19:15" />Rũciinĩ ruoro rũgĩtema-rĩ, araika acio makĩhĩkahĩka Loti, makĩmwĩra atĩrĩ, “Wĩhĩke! Oya mũtumia waku na airĩtu aku eerĩ arĩa marĩ gũkũ, kana mũniinanĩrio na itũũra rĩĩrĩ rĩkĩherithio.”<verse eid="GEN 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 19:16" />Rĩrĩa Loti aahindahindire-rĩ, andũ acio makĩmũnyiita guoko, na moko ma mũtumia wake na ma airĩtu ake eerĩ, na makĩmoimagaria o wega nginya nja ya itũũra rĩu inene, nĩgũkorwo Jehova nĩamaiguĩrĩire tha. <verse eid="GEN 19:16" /><verse number="17" style="v" sid="GEN 19:17" />Na maarĩkia kũmaruta nja ya itũũra, ũmwe wao akĩmeera atĩrĩ, “Mwĩtharei mũhonokie mĩoyo yanyu! Mũtikehũgũre, na mũtikarũgame handũ o na ha gũkũ kĩaragana-inĩ gĩkĩ! Ũrĩrai irĩma-inĩ, kana mũniinwo!”<verse eid="GEN 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 19:18" />No Loti akĩmeera atĩrĩ, “Aca, aathi akwa, ndamũthaitha! <verse eid="GEN 19:18" /><verse number="19" style="v" sid="GEN 19:19" />Tondũ ndungata yanyu nĩ ĩtĩkĩrĩkĩte maitho-inĩ manyu, na nĩmũnyonetie ũtugi mũnene wa kũhonokia muoyo wakwa, no ndingĩhota kũũrĩra irĩma-inĩ; mwanangĩko ũyũ nĩũkũngorerera, na nĩngũkua. <verse eid="GEN 19:19" /><verse number="20" style="v" sid="GEN 19:20" />Ta rorai, haarĩa harĩ na itũũra rĩrĩ hakuhĩ ingĩũrĩra, na nĩ inini. Rekei njũrĩre kuo, nĩ itũũra inini mũno, githĩ tiguo? Naguo muoyo wakwa nĩũkũhonoka.”<verse eid="GEN 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 19:21" />Nake mũraika akĩmwĩra atĩrĩ, “Nĩ wega mũno, nĩngũkũiguĩra ihooya rĩu o narĩo; Ndikũharagania itũũra rĩu waria ũhoro warĩo. <verse eid="GEN 19:21" /><verse number="22" style="v" sid="GEN 19:22" />No rĩrĩ, ũrĩra kuo na ihenya, nĩ ũndũ gũtirĩ ũndũ ingĩĩka nginya ũkinye kuo.” (Nĩkĩo itũũra rĩu rĩĩtagwo Zoari.)<verse eid="GEN 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 19:23" />Loti agĩkinya Zoari-rĩ, riũa nĩrĩarĩkĩtie kũratha. <verse eid="GEN 19:23" /><verse number="24" style="v" sid="GEN 19:24" />Nake Jehova akiurĩria Sodomu na Gomora mwaki wa ũbiriti uumĩte igũrũ kũrĩ Jehova. <verse eid="GEN 19:24" /><verse number="25" style="v" sid="GEN 19:25" />Nake akĩharagania matũũra macio manene, na kĩaragana kĩu gĩothe, o hamwe na arĩa othe maatũire matũũra-inĩ macio manene, o na mĩmera yothe ya bũrũri ũcio. <verse eid="GEN 19:25" /><verse number="26" style="v" sid="GEN 19:26" />No mũtumia wa Loti nĩehũgũrire na thuutha, nake agĩtuĩka gĩtugĩ gĩa cumbĩ.<verse eid="GEN 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 19:27" />Mũthenya ũyũ ũngĩ rũciinĩ tene-rĩ, Iburahĩmu agĩũkĩra na agĩcooka handũ harĩa aarũgamĩte mbere ya Jehova. <verse eid="GEN 19:27" /><verse number="28" style="v" sid="GEN 19:28" />Agĩcũthĩrĩria mwena wa Sodomu na Gomora, bũrũri wothe wa kĩaragana kĩu, nake akĩona ndogo ndumanu yambatĩte na igũrũ kuuma bũrũri-inĩ ũcio, ĩhaana ta ndogo yumĩte icua-inĩ.<verse eid="GEN 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 19:29" />Nĩ ũndũ ũcio, rĩrĩa Jehova aanangire matũũra macio manene ma kĩaragana kĩu, nĩaririkanire Iburahĩmu, na akĩruta Loti mwanangĩko-inĩ ũcio waharaganirie matũũra macio manene kũrĩa Loti atũire.<verse eid="GEN 19:29" /></para>
  <para style="s1">Loti na Airĩtu ake</para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 19:30" />Thuutha ũcio Loti akiuma Zoari, agĩthiĩ gũtũũra kĩrĩma-inĩ arĩ hamwe na airĩtu ake eerĩ, tondũ nĩetigĩrire gũikara Zoari. We na airĩtu ake eerĩ magĩtũũra ngurunga-inĩ. <verse eid="GEN 19:30" /><verse number="31" style="v" sid="GEN 19:31" />Mũthenya ũmwe-rĩ, mũirĩtu ũrĩa warĩ mũkũrũ akĩĩra ũrĩa warĩ mũnini atĩrĩ, “Ithe witũ nĩ mũkũrũ, na gũtirĩ mũndũ mũrũme ũrĩ hakuhĩ wa gũkoma na ithuĩ, ta ũrĩa arĩ mũtugo kũndũ guothe gũkũ thĩ. <verse eid="GEN 19:31" /><verse number="32" style="v" sid="GEN 19:32" />Reke tũhe ithe witũ ndibei anyue nĩgeetha tũkome nake, na tũtũũrie rũciaro rwitũ na ũndũ wa ithe witũ.”<verse eid="GEN 19:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 19:33" />Ũtukũ ũcio magĩtũma ithe wao anyue ndibei, na mũirĩtu ũrĩa mũkũrũ agĩtoonya na agĩkoma nake. Nowe Loti ndaamenyire rĩrĩa mũirĩtu aakomire kana rĩrĩa ookĩrire.<verse eid="GEN 19:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 19:34" />Mũthenya ũyũ ũngĩ, mũirĩtu ũrĩa mũkũrũ akĩĩra ũrĩa mũnini atĩrĩ, “Hwaĩ ũtukũ nĩ niĩ ndĩrakomire na ithe witũ. Reke tũmũhe ndibei rĩngĩ anyue ũtukũ wa ũmũthĩ, nawe ũthiĩ ũkome nake, nĩgeetha tũtũũrie rũciaro rwitũ na ũndũ wa ithe witũ.” <verse eid="GEN 19:34" /><verse number="35" style="v" sid="GEN 19:35" />Nĩ ũndũ ũcio magĩtũma ithe wao anyue ndibei ũtukũ ũcio o naguo, nake mũirĩtu ũrĩa warĩ mũnini agĩtoonya agĩkoma nake. O rĩngĩ Loti ndaamenyire rĩrĩa mũirĩtu aakomire kana rĩrĩa ookĩrire.<verse eid="GEN 19:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 19:36" />Nĩ ũndũ ũcio airĩtu acio eerĩ a Loti makĩgĩa nda na ithe wao. <verse eid="GEN 19:36" /><verse number="37" style="v" sid="GEN 19:37" />Mũirĩtu ũrĩa mũkũrũ agĩciara kahĩĩ na agĩgatua Moabi, na nĩwe ithe wa andũ a Moabi gwata ũmũthĩ. <verse eid="GEN 19:37" /><verse number="38" style="v" sid="GEN 19:38" />Mũirĩtu ũrĩa mũnini o nake agĩciara kahĩĩ, nake agĩgatua Beni-Ami, na nĩwe ithe wa Aamoni arĩa marĩ kuo nginya ũmũthĩ.<verse eid="GEN 19:38" /></para>
  <chapter eid="GEN 19" />
  <chapter number="20" style="c" sid="GEN 20" />
  <para style="s1">Iburahĩmu na Abimeleku</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 20:1" />Na rĩrĩ, Iburahĩmu nĩoimire kũu aarĩ, agĩthiĩ mwena wa Negevu, na agĩtũũra gatagatĩ ga Kadeshi na Shuri. Gwa kahinda nĩatũũrire Gerari <verse eid="GEN 20:1" /><verse number="2" style="v" sid="GEN 20:2" />na arĩ kũu Iburahĩmu oigaga atĩrĩ ha ũhoro wa mũtumia wake Sara, “Ũyũ nĩ mwarĩ wa baba.” Tondũ ũcio Abimeleku mũthamaki wa Gerari agĩtũmanĩra Sara na akĩmuoya.<verse eid="GEN 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 20:3" />No rĩrĩ, Ngai akiumĩrĩra Abimeleku ũtukũ na kĩroto, akĩmwĩra atĩrĩ, “Wee-rĩ, no ta ũkuĩte tondũ mũndũ-wa-nja ũcio woete nĩ mũtumia wene.”<verse eid="GEN 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 20:4" />No Abimeleku ndaakoretwo akuhĩrĩirie Sara, nĩ ũndũ ũcio akĩũria atĩrĩ, “Mwathani, no wanange rũrĩrĩ rũtehĩtie? <verse eid="GEN 20:4" /><verse number="5" style="v" sid="GEN 20:5" />Githĩ ti we wanjĩĩrire, ‘Ũyũ nĩ mwarĩ wa baba?’ Na ningĩ o nake Sara githĩ ndoigire atĩrĩ, ‘Ũyũ nĩ mũrũ wa baba?’ Njĩkĩte ũndũ ũcio na ũrũngĩrĩru wa ngoro na moko matarĩ ũcuuke.”<verse eid="GEN 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 20:6" />Ningĩ Ngai akĩmwĩra atĩrĩ kĩroto-inĩ, “Ĩĩ, nĩnjũũĩ ũrekĩte ũguo na ũrũngĩrĩru wa ngoro, na nĩkĩo ndĩrakũgiririe ũnjĩhĩrie. Nĩkĩo itanareka ũmũhutie. <verse eid="GEN 20:6" /><verse number="7" style="v" sid="GEN 20:7" />Rĩu-rĩ, cookeria mũndũ ũcio mũtumia wake, nĩgũkorwo nĩ mũnabii, nake nĩegũkũhooera, na nĩũgũtũũra muoyo. No waga kũmũcookia-rĩ, ũmenye ti-itherũ wee nĩũgũkua, na andũ aku othe nĩmegũkua.”<verse eid="GEN 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 20:8" />Mũthenya ũyũ ũngĩ rũciinĩ tene, Abimeleku agĩtũmanĩra anene ake othe, na aarĩkia kũmeera maũndũ marĩa mothe meekĩkĩte, andũ acio magĩĩtigĩra mũno. <verse eid="GEN 20:8" /><verse number="9" style="v" sid="GEN 20:9" />Abimeleku agĩcooka agĩĩta Iburahĩmu na akĩmũũria atĩrĩ, “Nĩ atĩa ũguo ũtwĩkĩte? Nĩ atĩa ngwĩhĩirie, nĩguo ũndeherere niĩ na ũthamaki wakwa ũũru mũnene ũguo? Ũnjĩkĩte maũndũ mataagĩrĩire gwĩkwo.” <verse eid="GEN 20:9" /><verse number="10" style="v" sid="GEN 20:10" />Ningĩ Abimeleku akĩũria Iburahĩmu atĩrĩ, “Nĩ kĩĩ gĩatũmire wĩke ũguo?”<verse eid="GEN 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 20:11" />Iburahĩmu akĩmũcookeria atĩrĩ, “Ndeĩrire atĩrĩ, ‘Kũndũ gũkũ andũ matiĩtigĩrĩte Ngai, na nĩmekũnjũraga nĩ ũndũ wa mũtumia wakwa.’ <verse eid="GEN 20:11" /><verse number="12" style="v" sid="GEN 20:12" />O na kũrĩ ũguo, ti-itherũ nĩ mwarĩ wa-baba, mũirĩtu wa baba; no tũtirĩ a nyina ũmwe, nĩkĩo aatuĩkire mũtumia wakwa. <verse eid="GEN 20:12" /><verse number="13" style="v" sid="GEN 20:13" />Na rĩrĩa Ngai aandutire kuuma nyũmba-inĩ ya baba thiĩ ngorũũrage, ndeerire mũtumia wakwa atĩrĩ, ‘Ũũ nĩguo ũrĩnyonagia wendo waku: Kũrĩa guothe tũrĩthiiaga, uugage atĩrĩ ũhoro-inĩ ũnjĩgiĩ, “Ũyũ nĩ mũrũ wa baba.” ’ ”<verse eid="GEN 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 20:14" />Iburahĩmu aarĩkia kwaria, Abimeleku akĩruta ngʼondu na ngʼombe, na ngombo cia arũme na cia andũ-a-nja, na agĩcihe Iburahĩmu, na akĩmũcookeria Sara mũtumia wake. <verse eid="GEN 20:14" /><verse number="15" style="v" sid="GEN 20:15" />Ningĩ Abimeleku akĩmwĩra atĩrĩ, “Bũrũri wakwa ũrĩ mbere yaku; tũũra harĩa hothe ũngĩenda.”<verse eid="GEN 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 20:16" />Nake Abimeleku akĩĩra Sara atĩrĩ, “Nĩngũhe mũrũ-wa-thoguo cekeri 1,000 cia betha<note caller="+" style="f"><char style="fr" closed="false">20:16 </char><char style="ft" closed="false">nĩ ta kilo ikũmi na ĩmwe na nuthu (11.5).</char></note> ituĩke cia kũrĩhĩria ihĩtia rĩrĩa ũhĩtĩirio mbere ya andũ aya othe mũrĩ nao; we ndũrĩ ũũru wĩkĩte.”<verse eid="GEN 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 20:17" />Nake Iburahĩmu akĩhooya Ngai, nake Ngai akĩhonia Abimeleku, na mũtumia wake, na ngombo ciake cia airĩtu nĩguo mahote gũciara ciana rĩngĩ, <verse eid="GEN 20:17" /><verse number="18" style="v" sid="GEN 20:18" />nĩgũkorwo Jehova nĩahingĩte nda cia andũ-a-nja othe a nyũmba ya Abimeleku, makaaga kũgĩa ciana, nĩ ũndũ wa Abimeleku kuoya Sara mũtumia wa Iburahĩmu.<verse eid="GEN 20:18" /></para>
  <chapter eid="GEN 20" />
  <chapter number="21" style="c" sid="GEN 21" />
  <para style="s1">Gũciarwo kwa Isaaka</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 21:1" />Nake Jehova agĩtuga Sara o ta ũrĩa oigĩte, na Jehova akĩhingĩria Sara kĩrĩkanĩro kĩrĩa aamwĩrĩire. <verse eid="GEN 21:1" /><verse number="2" style="v" sid="GEN 21:2" />Sara akĩgĩa nda, na agĩciarĩra Iburahĩmu kaana ga kahĩĩ ũkũrũ-inĩ wake, o ihinda rĩrĩa Jehova aamwĩrĩte. <verse eid="GEN 21:2" /><verse number="3" style="v" sid="GEN 21:3" />Iburahĩmu agĩtua kaana kau ga kahĩĩ aaciarĩirwo nĩ Sara, Isaaka. <verse eid="GEN 21:3" /><verse number="4" style="v" sid="GEN 21:4" />Na rĩrĩa mũriũ ũcio wake Isaaka akinyirie thikũ inyanya-rĩ, Iburahĩmu akĩmũruithia, o ta ũrĩa Ngai aamwathĩte. <verse eid="GEN 21:4" /><verse number="5" style="v" sid="GEN 21:5" />Iburahĩmu aarĩ na mĩaka igana rĩmwe rĩrĩa mũriũ wake Isaaka aaciarirwo.<verse eid="GEN 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 21:6" />Sara akiuga atĩrĩ, “Ngai nĩatũmĩte theke, na mũndũ o wothe ũrĩiguaga ũhoro ũcio nĩarĩthekaga hamwe na niĩ.” <verse eid="GEN 21:6" /><verse number="7" style="v" sid="GEN 21:7" />Agĩcooka akiuga atĩrĩ, “Nũũ ũngĩerire Iburahĩmu atĩ Sara nĩakongithia ciana? No rĩrĩ, nĩndĩmũciarĩire kaana ga kahĩĩ ũkũrũ-inĩ wake.”<verse eid="GEN 21:7" /></para>
  <para style="s1">Hagari na Ishumaeli Kũingatwo</para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 21:8" />Nako kaana kau gagĩkũra na gagĩtigithio kuonga; naguo mũthenya ũrĩa Isaaka aatigithirio kuonga-rĩ, Iburahĩmu akĩrugithia iruga inene. <verse eid="GEN 21:8" /><verse number="9" style="v" sid="GEN 21:9" />No Sara akĩona atĩ mũriũ wa Hagari ũrĩa Mũmisiri aaciarĩire Iburahĩmu aarĩ na kĩnyũrũri. <verse eid="GEN 21:9" /><verse number="10" style="v" sid="GEN 21:10" />Nake akĩĩra Iburahĩmu atĩrĩ, “Ingata ngombo ĩno ya mũndũ-wa-nja hamwe na mũriũ, tondũ mũriũ ũcio wa ngombo ĩyo ya mũndũ-wa-nja ndakagayana igai na mũriũ wakwa Isaaka.”<verse eid="GEN 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 21:11" />Naguo ũhoro ũcio ũgĩthĩĩnia Iburahĩmu mũno tondũ wakoniĩ mũriũ. <verse eid="GEN 21:11" /><verse number="12" style="v" sid="GEN 21:12" />No Ngai akĩmwĩra atĩrĩ, “Tiga gũthĩĩnĩka mũno nĩ ũndũ wa kĩmwana kĩu, na ndungata ĩyo yaku ya mũndũ-wa-nja. Thikĩrĩria ũrĩa wothe Sara egũkwĩra, tondũ rũciaro rũrĩa rũgeetanio nawe rũkoima harĩ Isaaka. <verse eid="GEN 21:12" /><verse number="13" style="v" sid="GEN 21:13" />O na ningĩ nĩngatũma mũriũ wa ndungata ĩyo ya mũndũ-wa-nja atuĩke rũrĩrĩ rũnene, tondũ nĩ rũciaro rwaku.”<verse eid="GEN 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 21:14" />Mũthenya ũyũ ũngĩ rũciinĩ tene Iburahĩmu akĩoya irio na mondo ya rũũa ĩrĩ na maaĩ, na agĩcinengera Hagari. Akĩmũigĩrĩra ciande-inĩ ciake, agĩcooka akĩmumagaria hamwe na kĩmwana kĩu. Nake Hagari agĩĩthiĩra, na agĩturĩrwo nĩ njĩra arĩ kũu werũ-inĩ wa Birishiba.<verse eid="GEN 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 21:15" />Na rĩrĩa maaĩ marĩa maarĩ rũũa-inĩ maathirire-rĩ, Hagari akĩiga kĩmwana kĩu rungu rwa kĩhinga kĩmwe. <verse eid="GEN 21:15" /><verse number="16" style="v" sid="GEN 21:16" />Nake agĩthiiathiia, agĩikara thĩ handũ hataarĩ haraihu, ta ha rĩikia rĩa mũguĩ, tondũ eeciiririe atĩrĩ, “Ndingĩĩrorera kĩmwana gĩakwa gĩgĩkua.” Na aikarĩte hau hakuhĩ, akĩambĩrĩria kũgirĩka.<verse eid="GEN 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 21:17" />Nake Ngai akĩigua kĩmwana kĩu gĩkĩrĩra, nake mũraika wa Ngai agĩĩta Hagari arĩ kũu igũrũ akĩmũũria atĩrĩ, “Nĩ kĩĩ kĩragũthĩĩnia Hagari? Tiga gwĩtigĩra; Ngai nĩaiguĩte kĩrĩro gĩa kĩmwana kĩu kĩrĩ o hau kĩrĩ. <verse eid="GEN 21:17" /><verse number="18" style="v" sid="GEN 21:18" />Tiira kĩmwana kĩu na igũrũ, na ũkĩnyiitĩrĩre na guoko, nĩgũkorwo nĩngagĩtua rũrĩrĩ rũnene.”<verse eid="GEN 21:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 21:19" />Hĩndĩ ĩyo Ngai akĩmũhingũra maitho, nake akĩona gĩthima kĩa maaĩ. Agĩthiĩ ho, akĩiyũria rũũa maaĩ, na akĩhe kĩmwana kĩu kĩnyue.<verse eid="GEN 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 21:20" />Ngai nĩakorirwo hamwe na kĩmwana kĩu o ũrĩa gĩakũraga. Gĩatũũrire werũ-inĩ, na gĩgĩtuĩka mũrathi na ũta. <verse eid="GEN 21:20" /><verse number="21" style="v" sid="GEN 21:21" />Hĩndĩ ĩyo aatũũraga Werũ-inĩ wa Parani-rĩ, nyina akĩmwethera mũtumia kuuma Misiri.<verse eid="GEN 21:21" /></para>
  <para style="s1">Kĩrĩkanĩro kĩa Iburahĩmu na Abimeleku</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 21:22" />Ihinda-inĩ-rĩu Abimeleku na Fikolu mũnene wa mbũtũ ciake cia ita makĩĩra Iburahĩmu atĩrĩ, “Ngai arĩ hamwe nawe maũndũ-inĩ mothe marĩa wĩkaga. <verse eid="GEN 21:22" /><verse number="23" style="v" sid="GEN 21:23" />Rĩu-rĩ, wĩhĩte ũrĩ mbere ya Ngai atĩ ndũkanjuukanĩrĩra, kana ũcuukanĩre ciana ciakwa, o na kana njiaro ciakwa. Nyonagia ũtugi niĩ na bũrũri ũyũ we ũtũũraga ũrĩ mũgeni o ta ũrĩa niĩ nguonetie ũtugi.”<verse eid="GEN 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 21:24" />Iburahĩmu agĩcookia atĩrĩ, “Nĩndehĩta.”<verse eid="GEN 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 21:25" />Ningĩ Iburahĩmu agĩtetia Abimeleku nĩ ũndũ wa gĩthima kĩa maaĩ kĩrĩa ndungata cia Abimeleku ciamũtunyĩte. <verse eid="GEN 21:25" /><verse number="26" style="v" sid="GEN 21:26" />No Abimeleku akiuga atĩrĩ, “Ndiũĩ nũũ wĩkĩte ũndũ ũcio. Wee ndwanjĩĩrire, na ndaigua ũhoro ũcio ũmũthĩ.”<verse eid="GEN 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 21:27" />Nĩ ũndũ ũcio Iburahĩmu akĩrehe ngʼondu na ngʼombe akĩhe Abimeleku, nao andũ acio eerĩ makĩgĩa na kĩrĩkanĩro. <verse eid="GEN 21:27" /><verse number="28" style="v" sid="GEN 21:28" />Iburahĩmu akĩamũra mĩatĩ mũgwanja kuuma rũũru-inĩ rwake. <verse eid="GEN 21:28" /><verse number="29" style="v" sid="GEN 21:29" />Nake Abimeleku akĩũria Iburahĩmu atĩrĩ, “Mĩatĩ ĩno mũgwanja-rĩ, wamĩamũra kuuma rũũru-inĩ nĩkĩ?”<verse eid="GEN 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 21:30" />Iburahĩmu akĩmũcookeria atĩrĩ, “Ĩtĩkĩra kuoya mĩatĩ ĩno mũgwanja kuuma kũrĩ niĩ, ĩtuĩke ũira atĩ nĩ niĩ ndenjire gĩthima gĩkĩ.”<verse eid="GEN 21:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 21:31" />Tondũ ũcio handũ hau hagĩĩtwo Birishiba tondũ hau nĩ ho andũ acio eerĩ mehĩtĩire mwĩhĩtwa.<verse eid="GEN 21:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 21:32" />Thuutha wa kũrĩkanĩra kĩrĩĩko kĩu kũu Birishiba, Abimeleku na Fikolu mũnene wa mbũtũ ciake cia ita, magĩcooka bũrũri wa Afilisti. <verse eid="GEN 21:32" /><verse number="33" style="v" sid="GEN 21:33" />Nake Iburahĩmu akĩhaanda mũtĩ wa mũbinde kũu Birishiba, na agĩkaĩra rĩĩtwa rĩa Jehova, o we Mũrungu Ũrĩa-Ũtũũraga-Tene-na-Tene, arĩ handũ hau. <verse eid="GEN 21:33" /><verse number="34" style="v" sid="GEN 21:34" />Nake Iburahĩmu agĩikara bũrũri-inĩ ũcio wa Afilisti ihinda iraaya ma.<verse eid="GEN 21:34" /></para>
  <chapter eid="GEN 21" />
  <chapter number="22" style="c" sid="GEN 22" />
  <para style="s1">Kũgerio kwa Iburahĩmu</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 22:1" />Thuutha wa maũndũ macio-rĩ, Ngai nĩageririe Iburahĩmu. Ngai akĩmwĩta atĩrĩ, “Iburahĩmu!”</para>
  <para style="p" vid="GEN 22:1">Nake agĩcookia atĩrĩ, “Niĩ ũyũ haha.”<verse eid="GEN 22:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 22:2" />Nake Ngai akĩmwĩra atĩrĩ, “Oya mũriũ waku, o we ũrĩa wa mũmwe Isaaka, ũrĩa wendete, ũthiĩ rũgongo rwa Moria, na ũmũrute ta igongona rĩa njino kuo kĩrĩma-inĩ kĩmwe kĩa iria ngaakuonia.”<verse eid="GEN 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 22:3" />Nĩ ũndũ ũcio mũthenya ũyũ ũngĩ rũciinĩ tene, Iburahĩmu agĩũkĩra, agĩtandĩka ndigiri yake. Akĩoya ndungata ciake igĩrĩ na mũriũ wake Isaaka. Aarĩkia gwatũra ngũ cia kũigana igongona rĩa njino-rĩ, akiumagara erekeire handũ harĩa Ngai aamwĩrĩte. <verse eid="GEN 22:3" /><verse number="4" style="v" sid="GEN 22:4" />Mũthenya wa gatatũ, Iburahĩmu agĩtiira maitho na akĩona handũ hau harĩ o kũraya. <verse eid="GEN 22:4" /><verse number="5" style="v" sid="GEN 22:5" />Akĩĩra ndungata ciake atĩrĩ, “Ikaragai haha na ndigiri ĩno, na niĩ na kĩmwana gĩakwa tũthiĩ haarĩa tũkahooe Ngai, na tũcooke tũmũcookerere.”<verse eid="GEN 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 22:6" />Iburahĩmu agĩkĩoya ngũ icio cia igongona rĩa njino, agĩciigĩrĩra mũriũ wake Isaaka, nake agĩkuua mwaki na kahiũ. Na rĩrĩa o eerĩ mathiiaga hamwe, <verse eid="GEN 22:6" /><verse number="7" style="v" sid="GEN 22:7" />Isaaka akĩaria, agĩĩta ithe Iburahĩmu atĩrĩ, “Baba!”</para>
  <para style="p" vid="GEN 22:7">Iburahĩmu akĩmũcookeria atĩrĩ, “Niĩ ũyũ, mũrũ wakwa.”</para>
  <para style="p" vid="GEN 22:7">Isaaka akiuga atĩrĩ, “Ndĩrona tũrĩ na mwaki na ngũ! No rĩrĩ, gatũrũme ka igongona rĩa njino karĩ ha?”<verse eid="GEN 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 22:8" />Iburahĩmu agĩcookia atĩrĩ, “Mũrũ wakwa, Ngai we mwene nĩekũheana gatũrũme ka igongona rĩa njino.” Nao eerĩ magĩthiĩ na mbere marĩ hamwe.<verse eid="GEN 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 22:9" />Maakinya handũ harĩa Ngai aamwĩrĩte-rĩ, Iburahĩmu agĩaka kĩgongona ho na akĩara ngũ igũrũ rĩakĩo. Agĩcooka akĩoha mũriũ wake Isaaka na akĩmũkomia kĩgongona-inĩ kĩu igũrũ rĩa ngũ. <verse eid="GEN 22:9" /><verse number="10" style="v" sid="GEN 22:10" />Ningĩ akĩoya kahiũ, agĩtambũrũkia guoko gwake, oorage mũriũ. <verse eid="GEN 22:10" /><verse number="11" style="v" sid="GEN 22:11" />No mũraika wa Jehova akĩmwĩta kuuma igũrũ, akiuga atĩrĩ, “Iburahĩmu! Iburahĩmu!”</para>
  <para style="p" vid="GEN 22:11">Nake Iburahĩmu agĩcookia atĩrĩ, “Niĩ ũyũ haha.”<verse eid="GEN 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 22:12" />Akĩmwĩra atĩrĩ, “Ndũkahutie kĩmwana kĩu na guoko gwaku, na ndũgagĩĩke ũndũ o na ũrĩkũ. Rĩu nĩndamenya atĩ nĩwĩtigĩrĩte Ngai, tondũ ndũnarega kũruta mũrũguo, o we mũrũguo waku wa mũmwe, arĩ igongona.”<verse eid="GEN 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 22:13" />Nake Iburahĩmu agĩtiira maitho, na hau kĩhinga-inĩ akĩona ndũrũme ĩnyiitĩtwo hĩa nĩ mĩrita. Agĩthiĩ ho, akĩoya ndũrũme ĩyo na akĩmĩruta ĩrĩ igongona rĩa njino handũ ha mũriũ. <verse eid="GEN 22:13" /><verse number="14" style="v" sid="GEN 22:14" />Nĩ ũndũ ũcio Iburahĩmu agĩĩta handũ hau Jehova-Nĩarĩheanaga. Na nginya ũmũthĩ kuugagwo atĩrĩ, “Kĩrĩma-inĩ kĩa Jehova-rĩ, nĩarĩtũheaga.”<verse eid="GEN 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 22:15" />Nake mũraika wa Jehova arĩ igũrũ, agĩĩta Iburahĩmu hĩndĩ ya keerĩ, <verse eid="GEN 22:15" /><verse number="16" style="v" sid="GEN 22:16" />akĩmwĩra atĩrĩ, “Jehova ekuuga ũũ: Nĩndĩhĩtĩte na niĩ mwene, atĩ tondũ nĩwĩkĩte ũndũ ũyũ na ndũnarega kũndutĩra mũrũguo, o mũrũguo waku wa mũmwe-rĩ, <verse eid="GEN 22:16" /><verse number="17" style="v" sid="GEN 22:17" />ti-itherũ nĩngakũrathima na ndũme njiaro ciaku cingĩhe ta njata cia matu-inĩ na ta mũthanga ũrĩa ũrĩ hũgũrũrũ-inĩ cia iria. Njiaro ciaku nĩ ikegwatĩra matũũra marĩa manene ma thũ ciacio, <verse eid="GEN 22:17" /><verse number="18" style="v" sid="GEN 22:18" />na nĩ ũndũ wa rũciaro rwaku, ndũrĩrĩ ciothe cia thĩ nĩikarathimwo, tondũ wee nĩũnjathĩkĩire.”<verse eid="GEN 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 22:19" />Nake Iburahĩmu agĩcookerera ndungata ciake, magĩthiĩ hamwe marorete Birishiba. Nake Iburahĩmu agĩtũũra kũu Birishiba.<verse eid="GEN 22:19" /></para>
  <para style="s1">Ariũ a Nahoru</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 22:20" />Thuutha wa maũndũ macio Iburahĩmu agĩkinyĩrwo nĩ ũhoro, akĩĩrwo atĩrĩ, “Milika o nake nĩagĩĩte na ciana; nĩaciarĩire mũrũ-wa-nyũkwa Nahoru ciana: <verse eid="GEN 22:20" /><verse number="21" style="v" sid="GEN 22:21" />Uzu nĩwe wa irigithathi, na mũrũ wa nyina nĩ Buzu, na Kemueli (ithe wa Aramu), <verse eid="GEN 22:21" /><verse number="22" style="v" sid="GEN 22:22" />na Kesedu, na Hazo, na Pilidashu, na Jidilafu, na Bethueli.” <verse eid="GEN 22:22" /><verse number="23" style="v" sid="GEN 22:23" />Bethueli nĩwe watuĩkire ithe wa Rebeka. Acio nĩo ariũ arĩa anana Milika aaciarĩire Nahoru, mũrũ wa nyina na Iburahĩmu. <verse eid="GEN 22:23" /><verse number="24" style="v" sid="GEN 22:24" />Thuriya yake, ĩrĩa yetagwo Reuma, o nayo yarĩ na ariũ ake, nĩo Teba, na Gahamu, na Tahashu na Maaka.<verse eid="GEN 22:24" /></para>
  <chapter eid="GEN 22" />
  <chapter number="23" style="c" sid="GEN 23" />
  <para style="s1">Gĩkuũ gĩa Sara</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 23:1" />Sara aatũũrire muoyo agĩkinyia mĩaka igana rĩmwe na mĩrongo ĩĩrĩ na mũgwanja. <verse eid="GEN 23:1" /><verse number="2" style="v" sid="GEN 23:2" />Nake aakuĩrĩire Kiriathu-Ariba (na nokuo Hebironi), bũrũri-inĩ wa Kaanani; nake Iburahĩmu agĩthiĩ, agĩcakaĩra Sara na akĩmũrĩrĩra.<verse eid="GEN 23:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 23:3" />Ningĩ Iburahĩmu agĩũkĩra akiuma hau mwĩrĩ wa mũtumia wake warĩ, agĩthiĩ akĩarĩria Ahiti akĩmeera atĩrĩ, <verse eid="GEN 23:3" /><verse number="4" style="v" sid="GEN 23:4" />“Niĩ ndĩ mũgeni na mũgendi gũkũ kwanyu. Nyenderiai handũ gũkũ ha gũthikana nĩgeetha hote gũthika mũtumia wakwa ũrĩa ũkuĩte.”<verse eid="GEN 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 23:5" />Nao Ahiti magĩcookeria Iburahĩmu atĩrĩ: <verse eid="GEN 23:5" /><verse number="6" style="v" sid="GEN 23:6" />“Mũthuuri ũyũ, ta tũthikĩrĩrie. Wee ũrĩ mũthamaki ũrĩ hinya gatagatĩ-inĩ gaitũ. Thika mũtumia waku mbĩrĩra-inĩ ĩmwe ya iria njega ciitũ. Gũtirĩ mũndũ witũ ũngĩkũgiria mbĩrĩra ya gũthika mũtumia waku.”<verse eid="GEN 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 23:7" />Iburahĩmu agĩũkĩra akĩinamĩrĩra mbere ya Ahiti, andũ acio ene bũrũri. <verse eid="GEN 23:7" /><verse number="8" style="v" sid="GEN 23:8" />Akĩmeera atĩrĩ, “Angĩkorwo nĩmwĩtĩkĩrĩte thike mũtumia wakwa-rĩ, gĩĩthikĩrĩriei, na mũthaithanĩrĩre kũrĩ Efironi mũrũ wa Zoharu, <verse eid="GEN 23:8" /><verse number="9" style="v" sid="GEN 23:9" />nĩguo anyenderie ngurunga ya Makipela, ĩrĩa yake ĩrĩ mũthia-inĩ wa gĩthaka gĩake. Mũũriei anyenderie na thogora ũrĩa ũmĩigana, ĩtuĩke handũ hakwa ha gũthikana gũkũ kwanyu.”<verse eid="GEN 23:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 23:10" />Nake Efironi ũcio Mũhiti aikarĩte thĩ o hau gatagatĩ-inĩ ka andũ arĩa angĩ; tondũ ũcio agĩcookeria Iburahĩmu akĩiguagwo nĩ Ahiti othe arĩa mookĩte kĩhingo-inĩ gĩa itũũra rĩu rĩake. <verse eid="GEN 23:10" /><verse number="11" style="v" sid="GEN 23:11" />Akĩmwĩra atĩrĩ, “Aca, mwathi wakwa, thikĩrĩria; nĩndakũhe gĩthaka kĩu, na nĩndakũhe ngurunga ĩyo ĩrĩ thĩinĩ wakĩo. Ndakũhe andũ akwa makĩonaga. Thika mũtumia waku.”<verse eid="GEN 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 23:12" />O rĩngĩ Iburahĩmu akĩinamĩrĩra mbere ya andũ acio ene bũrũri, <verse eid="GEN 23:12" /><verse number="13" style="v" sid="GEN 23:13" />na akĩarĩria Efironi andũ acio makĩiguaga, akĩmwĩra atĩrĩ, “Ĩtĩkĩra gũũthikĩrĩria. Nĩngũrĩha thogora wa gĩthaka kĩu. Amũkĩra mbeeca kuuma kũrĩ niĩ, nĩgeetha hote gũthika mũtumia wakwa kuo.”<verse eid="GEN 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 23:14" />Efironi agĩcookeria Iburahĩmu atĩrĩ, <verse eid="GEN 23:14" /><verse number="15" style="v" sid="GEN 23:15" />“Ta thikĩrĩria, mwathi wakwa; gĩthaka kĩu kĩngiuma cekeri magana mana ma betha,<note caller="+" style="f"><char style="fr" closed="false">23:15 </char><char style="ft" closed="false">nĩ ta kilo inya na nuthu (4.5).</char></note> no rĩrĩ, kĩu nĩ kĩĩ gatagatĩ gaku na niĩ? Thiĩ ũthike mũtumia waku.”<verse eid="GEN 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 23:16" />Iburahĩmu agĩĩtĩkĩra thogora wa Efironi na akĩmũthimĩra betha iria aagwetete andũ a Ahiti othe makĩiguaga; cekeri magana mana cia betha cia mũigana wa gĩthimo kĩa onjorithia.<verse eid="GEN 23:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 23:17" />Nĩ ũndũ ũcio, gĩthaka kĩa Efironi kĩu kĩarĩ Makipela hakuhĩ na Mamure-gĩthaka na ngurunga ĩyo, na mĩtĩ yothe ĩrĩa yarĩ mĩhaka-inĩ ya gĩthaka kĩu ikĩgarũrĩrwo <verse eid="GEN 23:17" /><verse number="18" style="v" sid="GEN 23:18" />Iburahĩmu mbere ya Ahiti othe arĩa mookĩte kĩhingo-inĩ gĩa itũũra rĩu inene. <verse eid="GEN 23:18" /><verse number="19" style="v" sid="GEN 23:19" />Thuutha wa ũguo, Iburahĩmu agĩthika Sara mũtumia wake ngurunga-inĩ ĩyo yarĩ gĩthaka-inĩ kĩa Makipela hakuhĩ na Mamure (ĩrĩa ĩrĩ Hebironi), bũrũri-inĩ wa Kaanani. <verse eid="GEN 23:19" /><verse number="20" style="v" sid="GEN 23:20" />Nĩ ũndũ ũcio gĩthaka kĩu na ngurunga ĩyo yarĩ kuo ikĩgarũrĩrwo Iburahĩmu nĩ Ahiti irĩ handũ ha gũthikanaga.<verse eid="GEN 23:20" /></para>
  <chapter eid="GEN 23" />
  <chapter number="24" style="c" sid="GEN 24" />
  <para style="s1">Isaaka na Rebeka</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 24:1" />Na rĩrĩ, Iburahĩmu aarĩ mũkũrũ na agatindĩka mĩaka. Nake Jehova nĩamũrathimĩte maũndũ-inĩ make mothe. <verse eid="GEN 24:1" /><verse number="2" style="v" sid="GEN 24:2" />Nake akĩĩra ndungata ĩrĩa yarĩ nene mũciĩ-inĩ wake, o ĩrĩa yarũgamĩrĩire indo ciothe iria aarĩ nacio atĩrĩ, “Ta iga guoko gwaku rungu rwa kĩero gĩakwa. <verse eid="GEN 24:2" /><verse number="3" style="v" sid="GEN 24:3" />Nĩngwenda wĩhĩte na rĩĩtwa rĩa Jehova, o we Ngai wa igũrũ na Ngai wa thĩ, atĩ ndũgethera mũrũ wakwa mũtumia kuuma kũrĩ airĩtu a Akaanani aya ndũũraga thĩinĩ wao, <verse eid="GEN 24:3" /><verse number="4" style="v" sid="GEN 24:4" />no nĩũgathiĩ bũrũri-inĩ wakwa na kũrĩ andũ a nyũmba iitũ, na wethere mũrũ wakwa Isaaka mũtumia kũu.”<verse eid="GEN 24:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 24:5" />Ndungata ĩyo ĩkĩmũũria atĩrĩ, “Ĩ mũndũ-wa-nja ũcio angĩkaarega gũũka na niĩ bũrũri-inĩ ũyũ? Ngaacookia mũrũguo bũrũri ũrĩa woimire?”<verse eid="GEN 24:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 24:6" />Iburahĩmu akĩmwĩra atĩrĩ, “Menyerera, ndũkanacookie mũrũ wakwa kũu! <verse eid="GEN 24:6" /><verse number="7" style="v" sid="GEN 24:7" />Jehova, o we Ngai wa igũrũ ũrĩa wandutire kuuma nyũmba ya baba na kuuma bũrũri ũrĩa ndaciarĩirwo na akĩnjarĩria na akĩnjĩĩra na mwĩhĩtwa atĩrĩ, ‘Rũciaro rwaku nĩngarũhe bũrũri ũyũ’ we nĩwe ũgaatũma mũraika wake mbere yaku nĩguo ũkoonera mũrũ wakwa mũtumia kuuma kuo. <verse eid="GEN 24:7" /><verse number="8" style="v" sid="GEN 24:8" />Mũndũ-wa-nja ũcio angĩkaarega gũũka nawe-rĩ, ndũkoohwo nĩ mwĩhĩtwa ũyũ wakwa; no ndũkanacookie mũrũ wakwa kũu.” <verse eid="GEN 24:8" /><verse number="9" style="v" sid="GEN 24:9" />Nĩ ũndũ ũcio ndungata ĩyo ĩkĩiga guoko kwayo rungu rwa kĩero kĩa Iburahĩmu ũcio mwathi wayo, na ĩkĩĩhĩta na mwĩhĩtwa harĩ we kũringana na ũhoro ũcio.<verse eid="GEN 24:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 24:10" />Ndungata ĩyo ĩgĩcooka ĩkĩoya ngamĩĩra ikũmi cia mwathi wayo na ĩkiumagara ĩkuĩte mĩthemba yothe ya indo njega kuuma kũrĩ mwathi wayo. Ĩgĩthiĩ ĩgĩkinya itũũra rĩrĩa Nahoru aatũũraga mwena wa gathigathini-ithũĩro wa Mesopotamia. <verse eid="GEN 24:10" /><verse number="11" style="v" sid="GEN 24:11" />Nayo ĩgĩtũma ngamĩĩra ikome nja ya itũũra hakuhĩ na gĩthima kĩa maaĩ; kwarĩ kĩhwaĩ-inĩ rĩrĩa andũ-a-nja maathiiaga gũtaha maaĩ.<verse eid="GEN 24:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 24:12" />Ĩgĩcooka ĩkĩhooya, ĩkiuga atĩrĩ, “Wee Jehova, Ngai wa Iburahĩmu mwathi wakwa, tũma ngaacĩre ũmũthĩ na ũtuge mwathi wakwa Iburahĩmu. <verse eid="GEN 24:12" /><verse number="13" style="v" sid="GEN 24:13" />Rora, ndũgamĩte haha gĩthima-inĩ kĩa maaĩ, nao airĩtu a ene itũũra nĩ maroka gũtaha maaĩ. <verse eid="GEN 24:13" /><verse number="14" style="v" sid="GEN 24:14" />Kũrotuĩka atĩrĩ, atĩ rĩrĩa ndĩrĩĩra mũirĩtu atĩrĩ, ‘Ndakũhooya, he ndigithũ yaku nyue maaĩ,’ nake oige atĩrĩ, ‘Nyua na nĩngũtahĩra o na ngamĩĩra ciaku,’ reke ũcio atuĩke nĩwe ũthuurĩire ndungata yaku Isaaka. Na ũndũ ũcio ũtũme niĩ menye atĩ nĩũtugĩte mwathi wakwa.”<verse eid="GEN 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 24:15" />Ĩtanarĩkia kũhooya-rĩ, Rebeka agĩũka akuuĩte ndigithũ kĩande-inĩ. Aarĩ mũirĩtu wa Bethueli mũrũ wa Milika, ũrĩa warĩ mũtumia wa Nahoru mũrũ wa nyina na Iburahĩmu. <verse eid="GEN 24:15" /><verse number="16" style="v" sid="GEN 24:16" />Mũirĩtu ũcio aarĩ mũthaka mũno, mũirĩtu gathirange; gũtirĩ mũndũ mũrũme wakomete nake. Agĩikũrũka gĩthima-inĩ kĩa maaĩ, akĩiyũria ndigithũ yake maaĩ, agĩcooka akĩambata rĩngĩ.<verse eid="GEN 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 24:17" />Nayo ndungata ĩyo ĩkĩhiũha ĩkamũtũnge, na ĩkĩmwĩra atĩrĩ, “Ndagũthaitha, he tũũĩ tũnini twa kũnyua kuuma ndigithũ-inĩ yaku.”<verse eid="GEN 24:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 24:18" />Nake agĩcookia atĩrĩ, “Mwathi wakwa, nyua,” nake akĩruta ndigithũ mũtwe na ihenya, akĩmĩnyiita na moko, na akĩmũhe maaĩ.<verse eid="GEN 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 24:19" />Na aarĩkia kũmũhe maaĩ ma kũnyua, agĩcooka akiuga atĩrĩ, “Nĩngũtahĩra ngamĩĩra ciaku, o nacio o nginya ciiganie kũnyua.” <verse eid="GEN 24:19" /><verse number="20" style="v" sid="GEN 24:20" />Agĩkĩonoreria maaĩ marĩa maarĩ ndigithũ yake mũharatĩ-inĩ na ihenya, agĩcooka agĩtengʼera gĩthima-inĩ gũtaha maaĩ mangĩ, agĩtaha ma kũigana ngamĩĩra ciake ciothe. <verse eid="GEN 24:20" /><verse number="21" style="v" sid="GEN 24:21" />Mũndũ ũcio akĩmwĩrorera atekwaria, nĩguo amenye kana Jehova nĩagacĩrithĩtie rũgendo rwake kana ndaarũgacĩrithĩtie.<verse eid="GEN 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 24:22" />Rĩrĩa ngamĩĩra ciarĩkirie kũnyua maaĩ-rĩ, mũndũ ũcio akĩruta gĩcũhĩ kĩa iniũrũ gĩa thahabu kĩa ũritũ wa nuthu cekeri,<note caller="+" style="f"><char style="fr" closed="false">24:22 </char><char style="ft" closed="false">nĩ ta giramu ithano na nuthu (5:5).</char></note> na bangiri igĩrĩ cia thahabu cia ũritũ wa cekeri ikũmi,<note caller="+" style="f"><char style="fr" closed="false">24:22 </char><char style="ft" closed="false">nĩ ta giramu 110.</char></note> akĩmwĩkĩra. <verse eid="GEN 24:22" /><verse number="23" style="v" sid="GEN 24:23" />Agĩcooka akĩmũũria atĩrĩ, “Wee ũrĩ mwarĩ wa ũ? Ndagũthaitha ta njĩĩra atĩrĩ, mũciĩ gwa thoguo-rĩ, he handũ tũngĩrarĩrĩra?”<verse eid="GEN 24:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 24:24" />Nake akĩmũcookeria atĩrĩ, “Niĩ ndĩ mwarĩ wa Bethueli, mũriũ ũrĩa Milika aaciarĩire Nahoru.” <verse eid="GEN 24:24" /><verse number="25" style="v" sid="GEN 24:25" />Ningĩ akĩmwĩra atĩrĩ, “Tũrĩ na riya na nyeki nyingĩ, o na handũ wee ũngĩrarĩrĩra.”<verse eid="GEN 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 24:26" />Mũndũ ũcio akĩinamĩrĩra thĩ, akĩhooya Jehova, <verse eid="GEN 24:26" /><verse number="27" style="v" sid="GEN 24:27" />akiuga atĩrĩ, “Jehova arogaathwo, o we Ngai wa Iburahĩmu mwathi wakwa, o ũcio ũtatigĩte kuonania ũtugi na wĩhokeku wake kũrĩ mwathi wakwa. Hakwa-rĩ, Jehova nĩandongoretie rũgendo-inĩ, akanginyia kwa andũ a nyũmba ya mwathi wakwa.”<verse eid="GEN 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 24:28" />Nake mũirĩtu ũcio agĩtengʼera, agĩthiĩ akĩhe andũ a nyũmba ya nyina ndeto icio. <verse eid="GEN 24:28" /><verse number="29" style="v" sid="GEN 24:29" />Na rĩrĩ, Rebeka aarĩ na mũrũ wa nyina wetagwo Labani, nake akiumagara ahiũhĩte, agĩthiĩ kũrĩ mũndũ ũcio hau gĩthima-inĩ kĩa maaĩ. <verse eid="GEN 24:29" /><verse number="30" style="v" sid="GEN 24:30" />Rĩrĩa onire gĩcũhĩ kĩu kĩa iniũrũ na bangiri irĩ moko-inĩ ma mwarĩ wa nyina, na aigua Rebeka akiuga ũrĩa mũndũ ũcio aamwĩrĩte-rĩ, agĩthiĩ kũrĩ mũndũ ũcio, akĩmũkora arũgamĩte harĩ ngamĩĩra ciake hakuhĩ na gĩthima kĩa maaĩ. <verse eid="GEN 24:30" /><verse number="31" style="v" sid="GEN 24:31" />Akĩmwĩra atĩrĩ, “Ũka tũthiĩ mũciĩ, wee ũrathimĩtwo nĩ Jehova. Ũrũgamĩte haha nja nĩkĩ? Nĩhaarĩirie nyũmba yaku na handũ ha ngamĩĩra.”<verse eid="GEN 24:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 24:32" />Nĩ ũndũ ũcio mũndũ ũcio agĩtoonya nyũmba, nacio ngamĩĩra ikĩaũrwo mĩrigo. Ngamĩĩra ikĩreherwo riya na nyeki, nake mũndũ ũcio na andũ arĩa aarĩ nao makĩreherwo maaĩ ma gwĩthamba magũrũ. <verse eid="GEN 24:32" /><verse number="33" style="v" sid="GEN 24:33" />Ningĩ akĩreherwo irio, nowe akiuga atĩrĩ, “Niĩ ndingĩrĩa, itambĩte kũmwĩra ũndũ ũrĩa ũndehete gũkũ.”</para>
  <para style="p" vid="GEN 24:33">Nake Labani akĩmwĩra atĩrĩ, “Gĩtwĩre.”<verse eid="GEN 24:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 24:34" />Nake agĩkiuga atĩrĩ, “Niĩ ndĩ ndungata ya Iburahĩmu.” <verse eid="GEN 24:34" /><verse number="35" style="v" sid="GEN 24:35" />“Jehova nĩarathimĩte mwathi wakwa mũno, na nĩ atongete mũno. Nĩamũheete ngʼondu na ngʼombe, betha na thahabu, ndungata cia arũme na cia andũ-a-nja, na ngamĩĩra o na ndigiri. <verse eid="GEN 24:35" /><verse number="36" style="v" sid="GEN 24:36" />Nake Sara mũtumia wa mwathi wakwa nĩamũciarĩire kĩmwana arĩ o mũkũrũ, nake nĩakĩheete indo ciake ciothe. <verse eid="GEN 24:36" /><verse number="37" style="v" sid="GEN 24:37" />Nake mwathi wakwa agĩtũma ndĩĩhĩte akĩnjĩĩra atĩrĩ, ‘Ndũkanethere mũriũ wakwa mũtumia kuuma kũrĩ airĩtu a Akaanani, a gũkũ bũrũri ũyũ ndũũraga, <verse eid="GEN 24:37" /><verse number="38" style="v" sid="GEN 24:38" />no ũthiĩ kũrĩ nyũmba ya baba na kũrĩ mũhĩrĩga wakwa, na ũrutĩre mũriũ wakwa mũtumia kuo.’<verse eid="GEN 24:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="GEN 24:39" />“Ningĩ ngĩũria mwathi wakwa atĩrĩ, ‘Ĩ mũndũ-wa-nja ũcio angĩrega gũũka na niĩ?’<verse eid="GEN 24:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="GEN 24:40" />“Nake akĩnjookeria atĩrĩ, ‘Jehova ũrĩa ndũire thiiaga mbere yake, nĩagatũma mũraika wake athiĩ nawe, na atũme rũgendo rwaku rũgaacĩre, nĩgeetha ũkaarutĩra mũriũ wakwa mũtumia kuuma kũrĩ mũhĩrĩga wakwa na kuuma kũrĩ andũ a nyũmba ya baba. <verse eid="GEN 24:40" /><verse number="41" style="v" sid="GEN 24:41" />Ningĩ wathiĩ kũrĩ mũhĩrĩga wakwa-rĩ, nĩũkohorwo kuuma kũrĩ mwĩhĩtwa wakwa; o na mangĩkaarega kũmũnengerana kũrĩ we, nĩũkohorwo kuuma kũrĩ mwĩhĩtwa ũcio wakwa.’ ”<verse eid="GEN 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="GEN 24:42" />Agĩthiĩ na mbere, akiuga atĩrĩ, “Ũmũthĩ rĩrĩa nginyire gĩthima-inĩ kĩa maaĩ, njugire atĩrĩ, ‘Wee Jehova Ngai wa Iburahĩmu mwathi wakwa, ũngĩenda, ndagũthaitha, gaacĩrithia rũgendo rũrũ njũkĩte. <verse eid="GEN 24:42" /><verse number="43" style="v" sid="GEN 24:43" />Ta kĩone, nũngiĩ haha gĩthima-inĩ kĩa maaĩ; mũirĩtu angĩũka gũtaha maaĩ na niĩ ndĩmwĩre atĩrĩ, “Ĩtĩkĩra nyue tũũĩ tũnini kuuma ndigithũ-inĩ yaku,” <verse eid="GEN 24:43" /><verse number="44" style="v" sid="GEN 24:44" />nake angĩnjĩĩra atĩrĩ, “Nyua na nĩngũtahĩra ngamĩĩra ciaku o nacio,” nĩagĩtuĩke nĩwe mũndũ-wa-nja ũrĩa Jehova athuurĩire mũriũ wa mwathi wakwa.’<verse eid="GEN 24:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="GEN 24:45" />“Itanarĩkia kũhooya ũguo na ngoro-rĩ, Rebeka oka arĩ na ndigithũ yake kĩande. Nake aikũrũka gĩthima-inĩ kĩa maaĩ, aataha maaĩ na niĩ ndamwĩra atĩrĩ, ‘Ndagũthaitha he maaĩ nyue.’<verse eid="GEN 24:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="GEN 24:46" />“Aaruta ndigithũ yake kĩande o naihenya anjĩĩra atĩrĩ, ‘Nyua, na nĩngũnyuithia o na ngamĩĩra ciaku.’ Nĩ ũndũ ũcio ndanyua maaĩ na ahe ngamĩĩra o nacio.<verse eid="GEN 24:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="GEN 24:47" />“Na niĩ ndamũũria atĩrĩ, ‘Ũrĩ mwarĩ wa ũ?’</para>
  <para style="p" vid="GEN 24:47">“Nake anjookeria atĩrĩ, ‘Ndĩ mwarĩ wa Bethueli mũrũ wa Nahoru, ũrĩa Milika aamũciarĩire.’</para>
  <para style="p" vid="GEN 24:47">“Na niĩ ndakĩmwĩkĩra gĩcũhĩ iniũrũ, na bangiri moko, <verse eid="GEN 24:47" /><verse number="48" style="v" sid="GEN 24:48" />ndacooka ndainamĩrĩra ndahooya Jehova. Ndagatha Jehova, o we Ngai wa Iburahĩmu mwathi wakwa, ũrĩa ũndongoretie na njĩra ĩrĩa njagĩrĩru nyonere mũrũ wa mwathi wakwa mwarĩ wa mũriũ wa mũrũ wa nyina nake. <verse eid="GEN 24:48" /><verse number="49" style="v" sid="GEN 24:49" />Na rĩrĩ, angĩkorwo nĩ mũkuonania ũtugi na wĩhokeku kũrĩ mwathi wakwa, njĩĩrai; na angĩkorwo tiguo, mũnjĩĩre nĩgeetha na niĩ menye na kũrĩa ngũrora.”<verse eid="GEN 24:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="GEN 24:50" />Labani na Bethueli magĩcookia atĩrĩ, “Ũndũ ũyũ uumĩte kũrĩ Jehova; ithuĩ tũngĩgĩkwĩra atĩa? <verse eid="GEN 24:50" /><verse number="51" style="v" sid="GEN 24:51" />Rebeka nĩwe ũyũ; muoe mũthiĩ agatuĩke mũtumia wa mũriũ wa mwathi waku, o ta ũrĩa Jehova oigĩte.”<verse eid="GEN 24:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="GEN 24:52" />Rĩrĩa ndungata ya Iburahĩmu yaiguire ũrĩa moigire, ĩkĩinamĩrĩra, ĩgĩturumithia ũthiũ wayo thĩ mbere ya Jehova. <verse eid="GEN 24:52" /><verse number="53" style="v" sid="GEN 24:53" />Ningĩ ndungata ĩyo ĩkĩruta thahabu, na mathaga ma betha na nguo, na ĩgĩcihe Rebeka; ĩgĩcooka ĩkĩhe Labani mũrũ wa nyina, o na nyina, iheo cia goro. <verse eid="GEN 24:53" /><verse number="54" style="v" sid="GEN 24:54" />Ndungata ĩyo na andũ arĩa yarĩ nao makĩrĩa na makĩnyua, na makĩraara kũu ũtukũ ũcio.</para>
  <para style="p" vid="GEN 24:54">Na rĩrĩa mookĩrire mũthenya ũyũ ũngĩ rũciinĩ tene, ĩkiuga atĩrĩ, “Rekei ndĩthiĩre kũrĩ mwathi wakwa.”<verse eid="GEN 24:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="GEN 24:55" />No Labani mũrũ wa nyina na mũirĩtu, o na nyina, makiuga atĩrĩ, “Reke mũirĩtu ũyũ aikare na ithuĩ ta matukũ ikũmi; mũcooke mũthiĩ.”<verse eid="GEN 24:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="GEN 24:56" />No yo ĩkĩmeera atĩrĩ, “Tigai kũngiria thiĩ, kuona atĩ Jehova nĩagacĩrithĩtie rũgendo rwakwa. Rekei ndĩthiĩre kũrĩ mwathi wakwa.”<verse eid="GEN 24:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="GEN 24:57" />Nao makiuga atĩrĩ, “Rekei twĩte mũirĩtu tũmũũrie ũhoro ũcio.” <verse eid="GEN 24:57" /><verse number="58" style="v" sid="GEN 24:58" />Nĩ ũndũ ũcio magĩĩta Rebeka, makĩmũũria atĩrĩ, “Nĩũgũthiĩ na mũndũ ũyũ?”</para>
  <para style="p" vid="GEN 24:58">Nake akiuga atĩrĩ, “Nĩngũthiĩ.”<verse eid="GEN 24:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="GEN 24:59" />Nĩ ũndũ ũcio magĩtĩkĩria Rebeka mwarĩ wa nyina ũcio ethiĩre, hamwe na mũmũrori, na ndungata ya Iburahĩmu na andũ ake. <verse eid="GEN 24:59" /><verse number="60" style="v" sid="GEN 24:60" />Nao magĩkĩrathima Rebeka makĩmwĩra atĩrĩ,</para>
  <para style="q1" vid="GEN 24:60">“Mwarĩ wa maitũ,</para>
  <para style="q2" vid="GEN 24:60">ũroingĩha ũtuĩke nyina wa ngiri maita ngiri,</para>
  <para style="q1" vid="GEN 24:60">naruo rũciaro rwaku rũroĩgwatĩra ihingo cia thũ ciao.”<verse eid="GEN 24:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="GEN 24:61" />Nake Rebeka na ndungata ciake, cia andũ-a-nja, makĩĩhaarĩria na makĩhaica ngamĩĩra, na magĩthiĩ na mũndũ ũcio. Nĩ ũndũ ũcio ndungata ĩyo ĩkĩoya Rebeka ĩgĩĩthiĩra.<verse eid="GEN 24:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="GEN 24:62" />Na rĩrĩ, Isaaka nĩoimĩte Biri-Lahai-Roi, nĩ ũndũ aatũũraga Negevu. <verse eid="GEN 24:62" /><verse number="63" style="v" sid="GEN 24:63" />Hwaĩ-inĩ ũmwe-rĩ, nĩathiire na kũu mũgũnda-inĩ agecũũranganie, na aatiira maitho, akĩona ngamĩĩra ciũkĩte. <verse eid="GEN 24:63" /><verse number="64" style="v" sid="GEN 24:64" />O nake Rebeka agĩtiira maitho akĩona Isaaka. Akiuma ngamĩĩra igũrũ, <verse eid="GEN 24:64" /><verse number="65" style="v" sid="GEN 24:65" />na akĩũria ndungata ĩyo atĩrĩ, “Mũndũ ũrĩa ũrĩ kũũrĩa mũgũnda ũroka gũtũtũnga nũũ?”</para>
  <para style="p" vid="GEN 24:65">Ndungata ĩyo ĩgĩcookia atĩrĩ, “Nĩ mwathi wakwa.” Nake Rebeka akĩoya taama wake akĩĩhumbĩra.<verse eid="GEN 24:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="GEN 24:66" />Nayo ndungata ĩyo ĩkĩĩra Isaaka ũrĩa wothe yekĩte. <verse eid="GEN 24:66" /><verse number="67" style="v" sid="GEN 24:67" />Nake Isaaka agĩtoonyia Rebeka hema-inĩ ya nyina Sara, akĩmũhikia. Nĩ ũndũ ũcio agĩtuĩka mũtumia wake, na akĩmwenda; nake Isaaka akĩhoorerio ihooru rĩa gĩkuũ kĩa nyina.<note caller="+" style="f"><char style="fr" closed="false">24:67 </char><char style="ft" closed="false">Mĩaka ĩtatũ nĩyathirĩte kuuma Sara aakua (17:17; 23:1; 25:20).</char></note><verse eid="GEN 24:67" /></para>
  <chapter eid="GEN 24" />
  <chapter number="25" style="c" sid="GEN 25" />
  <para style="s1">Gĩkuũ kĩa Iburahĩmu</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 25:1" />Thuutha ũcio Iburahĩmu nĩ aahikirie mũtumia ũngĩ, wetagwo Ketura. <verse eid="GEN 25:1" /><verse number="2" style="v" sid="GEN 25:2" />Nake akĩmũciarĩra ariũ atandatũ, na nĩo Zimirani, na Jokishani, na Medani, na Midiani, na Ishibaku na Shua. <verse eid="GEN 25:2" /><verse number="3" style="v" sid="GEN 25:3" />Jokishani nĩwe warĩ ithe wa Sheba na Dedani; nacio njiaro cia Dedani nĩcio ciarĩ Aashuri, na Aletushi na Aleumi. <verse eid="GEN 25:3" /><verse number="4" style="v" sid="GEN 25:4" />Nao ariũ a Midiani maarĩ Efa, na Eferi, na Hanoku, na Abida na Elidaha. Acio othe maarĩ njiaro cia Ketura.<verse eid="GEN 25:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 25:5" />Nake Iburahĩmu akĩgaĩra Isaaka indo ciothe iria aarĩ nacio. <verse eid="GEN 25:5" /><verse number="6" style="v" sid="GEN 25:6" />No arĩ o muoyo-rĩ, akĩhe ariũ a thuriya<note caller="+" style="f"><char style="fr" closed="false">25:6 </char><char style="ft" closed="false">Thuriya yarĩ mũndũ-wa-nja ũtahikĩtio na mũtugo wa ndũire; aikaranagia na mũndũ mũrũme arĩ wa gwĩkenia nake, kana aheetwo nĩ mũtumia wake aciare nake ciana handũ ha mũtumia ũcio wake.</char></note> ciake iheo, agĩcooka akĩmeheranĩria na mũriũ Isaaka magĩthiĩ na kũu bũrũri wa irathĩro.<verse eid="GEN 25:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 25:7" />Mĩaka yothe ĩrĩa Iburahĩmu aatũũrire muoyo yarĩ mĩaka igana rĩmwe na mĩrongo mũgwanja na ĩtano. <verse eid="GEN 25:7" /><verse number="8" style="v" sid="GEN 25:8" />Iburahĩmu agĩtuĩkana na agĩkua arĩ mũthuuri mũniaru, arĩ mũkũrũ na akaingĩhia mĩaka, agĩthikwo hamwe na andũ ao arĩa maakuĩte. <verse eid="GEN 25:8" /><verse number="9" style="v" sid="GEN 25:9" />Nao ariũ ake, Isaaka na Ishumaeli, makĩmũthika ngurunga-inĩ ya Makipela hakuhĩ na Mamure, gĩthaka-inĩ kĩa Efironi mũrũ wa Zoharu ũrĩa Mũhiti, <verse eid="GEN 25:9" /><verse number="10" style="v" sid="GEN 25:10" />gĩthaka kĩrĩa Iburahĩmu aagũrĩte kuuma kũrĩ Ahiti. Hau nĩho Iburahĩmu aathikirwo hamwe na Sara mũtumia wake. <verse eid="GEN 25:10" /><verse number="11" style="v" sid="GEN 25:11" />Thuutha wa gĩkuũ kĩa Iburahĩmu-rĩ, Ngai nĩarathimire mũriũ Isaaka ũrĩa watũũraga hakuhĩ na Biri-Lahai-Roi.<verse eid="GEN 25:11" /></para>
  <para style="s1">Ariũ a Ishumaeli</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 25:12" />Ũyũ nĩguo ũhoro wa Ishumaeli mũrũ wa Iburahĩmu, ũrĩa waciarĩirwo Iburahĩmu nĩ Hagari ũrĩa Mũmisiri, ndungata ya Sara.<verse eid="GEN 25:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="GEN 25:13" />Maya nĩmo marĩĩtwa ma ariũ a Ishumaeli, maandĩkĩtwo kũringana na ũrĩa maarũmanĩrĩire gũciarwo: Irigithathi rĩa Ishumaeli rĩarĩ Nebaiothu, rĩkarũmĩrĩrwo nĩ Kedari, na Adubeeli, na Mibisamu, <verse eid="GEN 25:13" /><verse number="14" style="v" sid="GEN 25:14" />na Mishima, na Duma, na Masa, <verse eid="GEN 25:14" /><verse number="15" style="v" sid="GEN 25:15" />na Hadadi, na Tema, na Jeturu, na Nafishu, na Kedema. <verse eid="GEN 25:15" /><verse number="16" style="v" sid="GEN 25:16" />Acio nĩo maarĩ ariũ a Ishumaeli, na macio nĩmo marĩĩtwa ma aathani ikũmi na eerĩ a mĩhĩrĩga yao kũringana na kũrĩa maatũũraga na kambĩ ciao. <verse eid="GEN 25:16" /><verse number="17" style="v" sid="GEN 25:17" />Mĩaka yothe ĩrĩa Ishumaeli aatũũrire muoyo yarĩ mĩaka igana rĩmwe na mĩrongo ĩtatũ na mũgwanja. Agĩcooka agĩtuĩkana agĩkua, na agĩthikwo hamwe na andũ ao arĩa maakuĩte. <verse eid="GEN 25:17" /><verse number="18" style="v" sid="GEN 25:18" />Njiaro cia Ishumaeli igĩtũũra kuuma Havila nginya Shuri, gũkuhĩ na mũhaka wa Misiri werekeire bũrũri wa Ashuri. Nao magĩtũũra na rũmena na ariũ arĩa angĩ othe a ithe wao.<verse eid="GEN 25:18" /></para>
  <para style="s1">Jakubu na Esaũ</para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 25:19" />Ũyũ nĩguo ũhoro wa Isaaka mũrũ wa Iburahĩmu.</para>
  <para style="b" vid="GEN 25:19" />
  <para style="p" vid="GEN 25:19">Iburahĩmu nĩwe waciarire Isaaka, <verse eid="GEN 25:19" /><verse number="20" style="v" sid="GEN 25:20" />nake Isaaka aarĩ na mĩaka mĩrongo ĩna rĩrĩa aahikirie Rebeka, mwarĩ wa Bethueli ũrĩa Mũsuriata wa Padani-Aramu, na aarĩ mwarĩ wa nyina na Labani ũrĩa Mũsuriata.<verse eid="GEN 25:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 25:21" />Isaaka agĩthaitha Jehova nĩ ũndũ wa mũtumia wake tondũ aarĩ thaata. Nake Jehova akĩigua mahooya make, na Rebeka mũtumia wake akĩgĩa nda. <verse eid="GEN 25:21" /><verse number="22" style="v" sid="GEN 25:22" />Natuo twana tũu tũkĩgianĩra kũu nda yake, nake akĩĩyũria atĩrĩ, “Ũndũ ũyũ ũrekĩka kũrĩ niĩ nĩkĩ?” Nĩ ũndũ ũcio agĩthiĩ gũtuĩria ũhoro harĩ Jehova.<verse eid="GEN 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 25:23" />Nake Jehova akĩmwĩra atĩrĩ,</para>
  <para style="q1" vid="GEN 25:23">“Ndũrĩrĩ igĩrĩ irĩ nda yaku,</para>
  <para style="q2" vid="GEN 25:23">na andũ a mĩthemba ĩĩrĩ kuuma nda yaku nĩmagatigithanio;</para>
  <para style="q1" vid="GEN 25:23">gĩthemba kĩmwe nĩgĩgakĩria kĩrĩa kĩngĩ hinya,</para>
  <para style="q2" vid="GEN 25:23">na ũrĩa mũkũrũ nĩagatungatĩra ũrĩa mũnini.”<verse eid="GEN 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 25:24" />Na rĩrĩa ihinda rĩake rĩakinyire rĩa gũciara, agĩkorwo nĩ tũhĩĩ twa mahatha aarĩ natuo nda. <verse eid="GEN 25:24" /><verse number="25" style="v" sid="GEN 25:25" />Karĩa kaambire gũciarwo kaarĩ gatune na mwĩrĩ wako wothe wahaanaga ta nguo ya maguoya; tondũ ũcio magĩgatua Esaũ. <verse eid="GEN 25:25" /><verse number="26" style="v" sid="GEN 25:26" />Thuutha ũcio mũrũ wa nyina agĩciarwo guoko gwake kũnyiitĩte ndiira ya Esaũ; tondũ ũcio agĩtuuo Jakubu. Isaaka aarĩ na mĩaka mĩrongo ĩtandatũ rĩrĩa Rebeka aaciarire twana tũu.<verse eid="GEN 25:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 25:27" />Natuo tũmwana tũu tũgĩkũra, nake Esaũ agĩtuĩka mũguĩmi mũũgĩ, mũndũ wa werũ, no Jakubu aarĩ mũndũ mũhooreri, waikaraga hakuhĩ na mũciĩ. <verse eid="GEN 25:27" /><verse number="28" style="v" sid="GEN 25:28" />Isaaka eendete Esaũ tondũ nĩ eendete nyama cia ũguĩmi, no Rebeka eendete Jakubu.<verse eid="GEN 25:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 25:29" />Mũthenya ũmwe Jakubu nĩarugaga gĩtoero kĩa ndengũ ndune, nake Esaũ agĩũka kuuma werũ-inĩ ahũtiĩ mũno. <verse eid="GEN 25:29" /><verse number="30" style="v" sid="GEN 25:30" />Akĩĩra Jakubu atĩrĩ, “Ta he gĩtoero kĩu ũraruga! Ndĩ mũhũtu mũno!” (Nĩkĩo gĩatũmire acooke gwĩtwo Edomu.)<verse eid="GEN 25:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 25:31" />Jakubu akĩmũcookeria atĩrĩ, “Amba ũnyenderie ũrigithathi waku!”<verse eid="GEN 25:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 25:32" />Nake Esaũ akiuga atĩrĩ, “Ngirie gũkua, ũrigithathi ũyũ ũkaangʼuna na kĩ?”<verse eid="GEN 25:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 25:33" />No Jakubu akĩmwĩra atĩrĩ, “Amba wĩhĩte kũrĩ niĩ.” Nake akĩĩhĩta na mwĩhĩtwa, akĩenderia Jakubu ũrigithathi wake.<verse eid="GEN 25:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 25:34" />Nake Jakubu akĩhe Esaũ mũgate na gĩtoero kĩa ndengũ. Nake akĩrĩa na akĩnyua, agĩcooka agĩũkĩra agĩĩthiĩra.</para>
  <para style="p" vid="GEN 25:34">Tondũ ũcio Esaũ akĩnyarara ũrigithathi wake.<verse eid="GEN 25:34" /></para>
  <chapter eid="GEN 25" />
  <chapter number="26" style="c" sid="GEN 26" />
  <para style="s1">Isaaka na Abimeleku</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 26:1" />Na rĩrĩ, nĩ kwagĩire ngʼaragu ĩngĩ bũrũri-inĩ ũcio, tiga ĩrĩa ya mbere ya hĩndĩ ya Iburahĩmu, nake Isaaka agĩthiĩ Gerari kũrĩ Abimeleku mũthamaki wa Afilisti.<note caller="+" style="f"><char style="fr" closed="false">26:1 </char><char style="ft" closed="false">Ũyũ aarĩ Mũthamaki Abimeleku ũngĩ; Abimeleku wa hĩndĩ ya Iburahĩmu nĩakuĩte ta mĩaka mĩrongo ĩnana yahĩtũkĩte.</char></note> <verse eid="GEN 26:1" /><verse number="2" style="v" sid="GEN 26:2" />Jehova akiumĩrĩra Isaaka, akĩmwĩra atĩrĩ, “Ndũgaikũrũke ũthiĩ Misiri; tũũra bũrũri o ũrĩa ndĩrĩkwĩra ũtũũre. <verse eid="GEN 26:2" /><verse number="3" style="v" sid="GEN 26:3" />Ikara bũrũri-inĩ ũyũ kwa ihinda, na nĩngũkorwo hamwe nawe na nĩngũkũrathima. Nĩgũkorwo nĩwe na njiaro ciaku ngũhe mabũrũri maya mothe na hingie mwĩhĩtwa ũrĩa ndehĩtire kũrĩ thoguo Iburahĩmu. <verse eid="GEN 26:3" /><verse number="4" style="v" sid="GEN 26:4" />Nĩngatũma njiaro ciaku cingĩhe ta njata cia matu-inĩ na nĩngamahe mabũrũri maya mothe, na nĩ ũndũ wa rũciaro rwaku, ndũrĩrĩ ciothe cia thĩ nĩikarathimwo, <verse eid="GEN 26:4" /><verse number="5" style="v" sid="GEN 26:5" />tondũ Iburahĩmu nĩanjathĩkĩire na akĩrũmia ũrĩa ndendaga, akĩrũmĩrĩra maathani makwa, na matuĩro makwa ma kũrũmĩrĩrwo, na mawatho makwa.” <verse eid="GEN 26:5" /><verse number="6" style="v" sid="GEN 26:6" />Nĩ ũndũ ũcio Isaaka agĩikara o kũu Gerari.<verse eid="GEN 26:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 26:7" />Rĩrĩa andũ a kũu maamũririe ũhoro wa mũtumia wake-rĩ, we akiuga atĩrĩ, “Nĩ mwarĩ wa baba,” tondũ nĩetigĩrire kuuga, “Nĩ mũtumia wakwa.” Eeciiririe atĩrĩ, “Andũ a gũkũ mahota kũnjũraga nĩ ũndũ wa Rebeka, tondũ aarĩ mũthaka.”<verse eid="GEN 26:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 26:8" />Na thuutha wa Isaaka arĩkĩtie gũikara kũu kahinda karaihu-rĩ, Abimeleku mũthamaki wa Afilisti nĩacũthĩrĩirie nja na ndirica, nake akĩona Isaaka akĩhambata mũtumia wake Rebeka. <verse eid="GEN 26:8" /><verse number="9" style="v" sid="GEN 26:9" />Nĩ ũndũ ũcio Abimeleku agĩtũmanĩra Isaaka, akĩmũũria atĩrĩ, “Ti-itherũ ũyũ nĩ mũtumia waku! Nĩ kĩĩ gĩatũmire uuge atĩ, ‘Ũyũ nĩ mwarĩ wa baba’?”</para>
  <para style="p" vid="GEN 26:9">Isaaka akĩmũcookeria atĩrĩ, “Tondũ ndeciiririe ndahota kũũragwo nĩ ũndũ wake.”<verse eid="GEN 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 26:10" />Ningĩ Abimeleku akĩmũũria atĩrĩ, “Nĩ atĩa ũguo ũtwĩkĩte? Ĩ mũndũ mũrũme ũmwe wa gũkũ angĩrakorirwo akomete na mũtumia waku, nawe ũgĩtũme tũnyiitwo nĩ ihĩtia?”<verse eid="GEN 26:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 26:11" />Nĩ ũndũ ũcio Abimeleku akĩruta watho kũrĩ andũ othe, akiuga atĩrĩ, “Mũndũ o na ũrĩkũ ũngĩthĩĩnia mũndũ ũyũ kana mũtumia wake no kũũragwo akooragwo.”<verse eid="GEN 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 26:12" />Nake Isaaka akĩhaanda irio bũrũri ũcio, na mwaka o ro ũcio akĩgetha maita igana, tondũ Jehova nĩamũrathimire. <verse eid="GEN 26:12" /><verse number="13" style="v" sid="GEN 26:13" />Nake Isaaka agĩtonga, naguo ũtonga wake ũgĩthiĩ o ũkĩingĩhaga o nginya agĩtonga mũno. <verse eid="GEN 26:13" /><verse number="14" style="v" sid="GEN 26:14" />Aarĩ na ndũũru nyingĩ cia mbũri na cia ngʼombe, na ndungata nyingĩ, o nginya Afilisti makĩmũiguĩra ũiru. <verse eid="GEN 26:14" /><verse number="15" style="v" sid="GEN 26:15" />Tondũ ũcio, ithima iria ciothe ndungata cia ithe cienjete hĩndĩ ya ithe Iburahĩmu-rĩ, Afilisti magĩcithika, magĩciyũria tĩĩri.<verse eid="GEN 26:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 26:16" />Ningĩ Abimeleku akĩĩra Isaaka atĩrĩ, “Ũkĩra ũthiĩ, ũtweherere, tondũ nĩũgĩĩte na hinya mũno gũtũkĩra.”<verse eid="GEN 26:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 26:17" />Nĩ ũndũ ũcio Isaaka agĩthaama, akĩehera kũu, agĩthiĩ kwamba hema Gĩtuamba-inĩ kĩa Gerari, na agĩtũũra kuo. <verse eid="GEN 26:17" /><verse number="18" style="v" sid="GEN 26:18" />Isaaka agĩthikũria ithima iria cienjetwo hĩndĩ ya ithe Iburahĩmu, o icio Afilisti maathikĩte thuutha wa Iburahĩmu gũkua, na agĩciĩta marĩĩtwa o marĩa ithe aacihete.<verse eid="GEN 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 26:19" />Na rĩrĩ, ndungata cia Isaaka nĩcienjire kũu gĩtuamba-inĩ na igĩkora gĩthima kĩa maaĩ mega kuo. <verse eid="GEN 26:19" /><verse number="20" style="v" sid="GEN 26:20" />No rĩrĩ, arĩithi a Gerari makĩnegenania na arĩithi a Isaaka, makĩmeera atĩrĩ, “Maaĩ maya nĩ maitũ!” Nake agĩĩta gĩthima kĩu Eseku, tondũ nĩmakararanirie nake. <verse eid="GEN 26:20" /><verse number="21" style="v" sid="GEN 26:21" />Ningĩ ndungata icio ciake ikĩenja gĩthima kĩngĩ, no-o nakĩo makĩnegenanĩria, nake Isaaka agĩgĩĩta Sitina. <verse eid="GEN 26:21" /><verse number="22" style="v" sid="GEN 26:22" />Nake agĩthaama kũu, agĩthiĩ akĩenja gĩthima kĩngĩ, na matianegenanirie na mũndũ. Nake agĩgĩĩta Rehobothu, akiuga atĩrĩ, “Rĩu Jehova nĩatũheete ũikaro mũiganu, na nĩtũgũtheeremera bũrũri-inĩ ũyũ.”<verse eid="GEN 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 26:23" />Agĩcooka akiuma kũu, agĩthiĩ Birishiba. <verse eid="GEN 26:23" /><verse number="24" style="v" sid="GEN 26:24" />Ũtukũ ũcio aakinyire kũu, Jehova akĩmuumĩrĩra, akĩmwĩra atĩrĩ, “Nĩ niĩ Ngai wa thoguo Iburahĩmu. Ndũkanetigĩre, tondũ ndĩ hamwe nawe; nĩngũkũrathima na nyingĩhie njiaro ciaku nĩ ũndũ wa Iburahĩmu ndungata yakwa.”<verse eid="GEN 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 26:25" />Isaaka agĩaka kĩgongona kũu, na agĩkaĩra rĩĩtwa rĩa Jehova. Akĩamba hema yake o kũu, nacio ndungata ciake ikĩenja gĩthima o kuo.<verse eid="GEN 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 26:26" />Hĩndĩ ĩyo Abimeleku agĩthiĩ kũrĩ Isaaka oimĩte Gerari, marĩ na Ahuzathu ũrĩa wamũtaaraga, na Fikolu mũnene wa ita ciake. <verse eid="GEN 26:26" /><verse number="27" style="v" sid="GEN 26:27" />Isaaka akĩmooria atĩrĩ, “Muoka kũrĩ niĩ nĩkĩ, kuona atĩ nĩmwathũũrire na mũkĩnyingata?”<verse eid="GEN 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 26:28" />Nao makĩmũcookeria atĩrĩ, “Nĩtuonete hatarĩ nganja atĩ Jehova arĩ hamwe nawe, na nĩ ũndũ ũcio tuoiga atĩrĩ, ‘Nĩ kwagĩrĩire tũgĩe na mwĩhĩtwa wa ũiguano gatagatĩ gaitũ’: ĩĩ, gatagatĩ gaitũ nawe. Reke tũgĩe na kĩrĩkanĩro nawe, <verse eid="GEN 26:28" /><verse number="29" style="v" sid="GEN 26:29" />atĩ ndũgatwĩka ũũru, o ta ũrĩa o na ithuĩ tũtaagũthĩĩnirie, no hĩndĩ ciothe twagwĩkaga wega, na tũgĩkumagaria ũthiĩ na thayũ. Na rĩu nĩũrathimĩtwo nĩ Jehova.”<verse eid="GEN 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 26:30" />Isaaka akĩmarugithĩria iruga, nao makĩrĩa na makĩnyua. <verse eid="GEN 26:30" /><verse number="31" style="v" sid="GEN 26:31" />Mũthenya ũyũ ũngĩ, rũciinĩ tene, andũ acio na Isaaka makĩĩhĩtanĩra mwĩhĩtwa mũndũ na ũrĩa ũngĩ. Isaaka agĩcooka akĩmoimagaria, magĩĩthiĩra, makĩmũtiga na thayũ.<verse eid="GEN 26:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 26:32" />Mũthenya o ro ũcio maathiire, ndungata cia Isaaka igĩũka, ĩkĩmwĩra ũhoro wa gĩthima kĩrĩa cienjete, ikiuga atĩrĩ, “Nĩtwakinyĩra maaĩ!” <verse eid="GEN 26:32" /><verse number="33" style="v" sid="GEN 26:33" />Nake agĩĩta gĩthima kĩu Shiba, na nginya ũmũthĩ itũũra rĩu rĩtũũraga rĩĩtagwo Birishiba.<verse eid="GEN 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 26:34" />Esaũ aakinyia mĩaka mĩrongo ĩna, akĩhikia Judithi mwarĩ wa Beeri ũrĩa Mũhiti, o na ningĩ akĩhikia Basemathu mwarĩ wa Eloni ũrĩa Mũhiti. <verse eid="GEN 26:34" /><verse number="35" style="v" sid="GEN 26:35" />Nao magĩtuĩka kĩhumo gĩa kĩeha kũrĩ Isaaka na Rebeka.<verse eid="GEN 26:35" /></para>
  <chapter eid="GEN 26" />
  <chapter number="27" style="c" sid="GEN 27" />
  <para style="s1">Jakubu Kwĩgĩĩra na Irathimo cia Isaaka</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 27:1" />Rĩrĩa Isaaka aakũrire na maitho make makĩaga hinya ũndũ atangĩahotire kuona-rĩ, agĩtũmanĩra Esaũ mũriũ wake ũrĩa mũkũrũ, akĩmwĩra atĩrĩ, “Mũrũ wakwa.”</para>
  <para style="p" vid="GEN 27:1">Nake Esaũ akĩmũcookeria atĩrĩ, “Niĩ ũyũ haha.”<verse eid="GEN 27:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 27:2" />Isaaka akĩmwĩra atĩrĩ, “Rĩu niĩ ndĩ mũkũrũ na ndiũĩ mũthenya ũrĩa ingĩkua. <verse eid="GEN 27:2" /><verse number="3" style="v" sid="GEN 27:3" />Rĩu-rĩ, oya indo ciaku cia ũguĩmi; ũta na mĩguĩ yaku, na uumagare ũthiĩ werũ-inĩ ũkanguĩmĩre nyamũ cia gĩthaka. <verse eid="GEN 27:3" /><verse number="4" style="v" sid="GEN 27:4" />Thondekera irio njega iria nyendete na ũndehere ndĩe, nĩgeetha ngũrathime na kĩrathimo gĩakwa itanakua.”<verse eid="GEN 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 27:5" />Na rĩrĩ, Rebeka agĩkorwo nĩathikĩrĩirie Isaaka akĩhe mũriũ Esaũ ũhoro ũcio. Na rĩrĩa Esaũ aathiire werũ-inĩ kũguĩma nyamũ nĩguo amĩinũkie-rĩ, <verse eid="GEN 27:5" /><verse number="6" style="v" sid="GEN 27:6" />Rebeka akĩĩra mũriũ Jakubu atĩrĩ, “Nĩ ndaigua thoguo akĩĩra Esaũ mũrũ wa nyũkwa atĩrĩ, <verse eid="GEN 27:6" /><verse number="7" style="v" sid="GEN 27:7" />‘Ndehere nyamũ ya kũguĩma na ũthondekere irio njega ndĩe, nĩgeetha ngũrathime na kĩrathimo gĩakwa ndĩ mbere ya Jehova itanakua.’ <verse eid="GEN 27:7" /><verse number="8" style="v" sid="GEN 27:8" />Rĩu, wee mũrũ wakwa-rĩ, thikĩrĩria wega na wĩke ũrĩa ngũkwĩra: <verse eid="GEN 27:8" /><verse number="9" style="v" sid="GEN 27:9" />Thiĩ rũũru-inĩ rwa mbũri ũndehere tũũri twĩrĩ twa mbũri tũrĩa twega biũ, nĩguo thondekere thoguo irio njega, o ta ũrĩa endaga ithondekwo. <verse eid="GEN 27:9" /><verse number="10" style="v" sid="GEN 27:10" />Ũcooke ũcioe ũcitwarĩre thoguo arĩe nĩgeetha akũrathime na kĩrathimo gĩake atanakua.”<verse eid="GEN 27:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 27:11" />No Jakubu akĩĩra nyina Rebeka atĩrĩ, “Esaũ mũrũ wa maitũ nĩ wa mwĩrĩ ũrĩ guoya, na mwĩrĩ wakwa ndũrĩ guoya. <verse eid="GEN 27:11" /><verse number="12" style="v" sid="GEN 27:12" />Ĩĩ baba angĩĩhaambata? Ingĩonekana ngĩmũheenia na niĩ ndĩĩreherere kĩrumi handũ ha kĩrathimo.”<verse eid="GEN 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 27:13" />Nyina akĩmwĩra atĩrĩ, “Mũrũ wakwa, reke kĩrumi kĩu kĩnjookerere, wee ĩka o ũrĩa ndĩrakwĩra; thiĩ ũndehere tũũri tũu.”<verse eid="GEN 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 27:14" />Nĩ ũndũ ũcio Jakubu agĩthiĩ, akĩgĩĩra tũũri, na agĩtũrehere nyina, nake agĩthondeka irio njega o ta iria ithe eendete. <verse eid="GEN 27:14" /><verse number="15" style="v" sid="GEN 27:15" />Ningĩ Rebeka akĩoya nguo iria ciarĩ njega cia Esaũ mũriũ wake ũrĩa mũkũrũ iria aarĩ nacio nyũmba agĩcihumba Jakubu mũriũ wake ũrĩa mũnini. <verse eid="GEN 27:15" /><verse number="16" style="v" sid="GEN 27:16" />Agĩcooka akĩhumbĩra moko make na ngingo kũrĩa gũtaarĩ guoya na njũũa cia tũũri tũu. <verse eid="GEN 27:16" /><verse number="17" style="v" sid="GEN 27:17" />Agĩcooka akĩnengera Jakubu mũriũ wake irio icio ciarĩ njega na mũgate ũrĩa aathondekete.<verse eid="GEN 27:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 27:18" />Nake Jakubu agĩthiĩ kũrĩ ithe, akiuga atĩrĩ, “Baba.”</para>
  <para style="p" vid="GEN 27:18">Nake Isaaka agĩcookia atĩrĩ, “Niĩ ũyũ, mũrũ wakwa; wee nĩwe ũ?”<verse eid="GEN 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 27:19" />Jakubu akĩĩra ithe atĩrĩ, “Nĩ niĩ Esaũ mũriũ waku wa irigithathi. Njĩkĩte o ta ũrĩa ũnjĩĩrire. Ndagũthaitha wĩtiire ũrĩe nyama imwe cia ũguĩmi wakwa nĩgeetha ũndathime na kĩrathimo gĩaku.”<verse eid="GEN 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 27:20" />Nake Isaaka akĩũria mũriũ atĩrĩ, “Mũrũ wakwa, kaĩ waciona narua atĩa?”</para>
  <para style="p" vid="GEN 27:20">Nake akĩmũcookeria atĩrĩ, “Nĩ tondũ Jehova Ngai waku nĩaheire ũhootani.”<verse eid="GEN 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 27:21" />Ningĩ Isaaka akĩĩra Jakubu atĩrĩ, “Ta ũka hakuhĩ mũrũ wakwa, nĩguo ngũhambate menye kana ti-itherũ nĩwe Esaũ mũrũ wakwa kana tiguo.”<verse eid="GEN 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 27:22" />Nĩ ũndũ ũcio Jakubu agĩkuhĩrĩria ithe Isaaka, nake akĩmũhambata, akiuga atĩrĩ, “Mũgambo nĩ wa Jakubu, no moko nĩ ma Esaũ.” <verse eid="GEN 27:22" /><verse number="23" style="v" sid="GEN 27:23" />Na ndaigana kũmũkũũrana tondũ moko make maarĩ na guoya ta ma mũrũ wa nyina Esaũ; nĩ ũndũ ũcio akĩmũrathima. <verse eid="GEN 27:23" /><verse number="24" style="v" sid="GEN 27:24" />O rĩngĩ akĩmũũria atĩrĩ, “Ti-itherũ nĩwe mũrũ wakwa Esaũ?”</para>
  <para style="p" vid="GEN 27:24">Nake agĩcookia atĩrĩ, “Ĩĩ nĩ niĩ.”<verse eid="GEN 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 27:25" />Agĩcooka akĩmwĩra atĩrĩ, “Mũrũ wakwa ndehere nyama imwe cia ũguĩmi waku ndĩe nĩgeetha ngũrathime na kĩrathimo gĩakwa.”</para>
  <para style="p" vid="GEN 27:25">Jakubu akĩmũrehera nake akĩrĩa, na akĩmũrehera ndibei na akĩnyua. <verse eid="GEN 27:25" /><verse number="26" style="v" sid="GEN 27:26" />Ningĩ ithe Isaaka akĩmwĩra atĩrĩ, “Mũrũ wakwa, ũka haha ũũmumunye”.<verse eid="GEN 27:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 27:27" />Nake agĩthiĩ harĩ we na akĩmũmumunya. Rĩrĩa Isaaka aiguire kĩheera kĩa nguo ciake, akĩmũrathima, akiuga atĩrĩ,</para>
  <para style="q1" vid="GEN 27:27">“Hĩ, kĩheera kĩa mũrũ wakwa nĩ ta kĩheera gĩa gĩthaka</para>
  <para style="q2" vid="GEN 27:27">kĩrĩa kĩrathimĩtwo nĩ Jehova.<verse eid="GEN 27:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="GEN 27:28" />Ngai arokũhe ime rĩa igũrũ o na ũnoru wa thĩ,</para>
  <para style="q2" vid="GEN 27:28">na ũingĩ wa ngano na wa ndibei ya mũhihano.<verse eid="GEN 27:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="GEN 27:29" />Ndũrĩrĩ irogũtungatagĩra nayo mĩhĩrĩga ya andũ ĩkũinamagĩrĩre.</para>
  <para style="q1" vid="GEN 27:29">Tuĩka mwathi wa ariũ a thoguo,</para>
  <para style="q2" vid="GEN 27:29">nao ariũ a nyũkwa marokũinamagĩrĩra.</para>
  <para style="q1" vid="GEN 27:29">Arĩa mangĩkũruma na kĩrumi marocookererwo nĩkĩo,</para>
  <para style="q2" vid="GEN 27:29">nao arĩa magaakũrathima marorathimagwo.”<verse eid="GEN 27:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 27:30" />Na rĩrĩ, Isaaka aarĩkia kũmũrathima na Jakubu aarĩkia kuuma harĩ ithe o ro ũguo-rĩ, mũrũ wa nyina Esaũ agĩũka kuuma kũguĩma. <verse eid="GEN 27:30" /><verse number="31" style="v" sid="GEN 27:31" />O nake agĩthondeka irio njega na agĩcirehere ithe. Agĩcooka akĩmwĩra atĩrĩ, “Baba, wĩtiire ũrĩe nyama imwe cia ũguĩmi wakwa nĩgeetha ũndathime na kĩrathimo gĩaku.”<verse eid="GEN 27:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 27:32" />Nake ithe Isaaka akĩmũũria atĩrĩ, “We nĩwe ũ?”</para>
  <para style="p" vid="GEN 27:32">Nake akĩmũcookeria atĩrĩ, “Nĩ niĩ Esaũ, mũrũ waku wa irigithathi.”<verse eid="GEN 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 27:33" />Isaaka agĩkĩinaina mũno akĩũria atĩrĩ, “Nũũ ũcio ũngĩ ũkũguĩmĩte, na andehera nyama? Ndacirĩa o ro rĩu ũtanooka, na ndamũrathima, na ti-itherũ nĩ mũrathime.”<verse eid="GEN 27:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 27:34" />Rĩrĩa Esaũ aiguire ciugo cia ithe, agĩtumũka na kĩrĩro kĩnene na kĩa ruo, akĩĩra ithe atĩrĩ, “Ndaathima! O na niĩ baba ndaathima!”<verse eid="GEN 27:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 27:35" />No ithe akĩmwĩra atĩrĩ, “Mũrũ wa nyũkwa okire na wara, aheenia, na oya kĩrathimo gĩaku.”<verse eid="GEN 27:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 27:36" />Esaũ akiuga atĩrĩ, “Githĩ nĩ ma nĩkĩo etagwo Jakubu? Arĩ kũũheenia maita maya meerĩ;<note caller="+" style="f"><char style="fr" closed="false">27:36 </char><char style="ft" closed="false">Rĩĩtwa Jakubu rĩgĩtaũrwo nĩ ta kuuga “mũheenania.”</char></note> nĩoire ũrigithathi wakwa, na rĩu nĩoya kĩrathimo gĩakwa!” Agĩcooka akĩũria ithe atĩrĩ, “Ndũnandigĩria kĩrathimo o na kĩmwe?”<verse eid="GEN 27:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 27:37" />Isaaka agĩcookeria Esaũ atĩrĩ, “Ndĩmũtuire mwathi waku na andũ ao othe ndaamatua ndungata ciake, na ndamũhe ngano na ndibei ya mũhihano imũtũũragie. Nĩ ũndũ ũcio nĩ atĩa ingĩhota gũgwĩkĩra, mũrũ wakwa?”<verse eid="GEN 27:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 27:38" />Esaũ akĩũria ithe atĩrĩ, “Baba, ndũrĩ na kĩrathimo o na kĩmwe ũndigĩirie? Ndaathima o na niĩ, baba!” Na hĩndĩ ĩyo Esaũ akĩrĩra anĩrĩire.<verse eid="GEN 27:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="GEN 27:39" />Nake ithe Isaaka akĩmũcookeria atĩrĩ,</para>
  <para style="q1" vid="GEN 27:39">“Wee ũgaatũũraga kũraihu na ũnoru wa thĩ,</para>
  <para style="q2" vid="GEN 27:39">kũraihu na ime rĩrĩa riumaga igũrũ.<note caller="+" style="f"><char style="fr" closed="false">27:39 </char><char style="ft" closed="false">Bũrũri wa Edomu ũrĩa watũũragwo nĩ njiaro cia Esaũ warĩ wa mahiga, na ndwarĩ mũnoru ta bũrũri wa Kaanani.</char></note><verse eid="GEN 27:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="GEN 27:40" />Ũgaatũũragio nĩ rũhiũ rwa njora</para>
  <para style="q2" vid="GEN 27:40">na nĩũgatungataga mũrũ wa nyũkwa.</para>
  <para style="q1" vid="GEN 27:40">No rĩrĩ, rĩrĩa ũkaaremwo nĩgũkirĩrĩria-rĩ,</para>
  <para style="q2" vid="GEN 27:40">nĩũkeruta icooki rĩake ngingo, ũrĩte.”<verse eid="GEN 27:40" /></para>
  <para style="s1">Jakubu Kũũrĩra kwa Labani</para>
  <para style="p">
    <verse number="41" style="v" sid="GEN 27:41" />Esaũ agĩthũũra Jakubu nĩ ũndũ wa kĩrathimo kĩu aaheirwo nĩ ithe. Nake akiuga na ngoro atĩrĩ, “Matukũ ma gũcakaĩra baba makiriĩ gũkinya; maathira nĩguo ngooraga mũrũ wa maitũ Jakubu.”<verse eid="GEN 27:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="GEN 27:42" />Rĩrĩa Rebeka eerirwo ũrĩa Esaũ mũriũ ũcio wake mũkũrũ oigĩte, agĩtũmanĩra Jakubu mũriũ wake ũrĩa mũnini, akĩmwĩra atĩrĩ, “Esaũ mũrũ wa nyũkwa arehooreria marakara na gwĩciiria ũrĩa egũkũũraga. <verse eid="GEN 27:42" /><verse number="43" style="v" sid="GEN 27:43" />Rĩu mũrũ wakwa-rĩ, ĩka o ũrĩa ngũkwĩra. Thiĩ o ro rĩu ũũrĩre Harani, kwa mũrũ wa maitũ Labani. <verse eid="GEN 27:43" /><verse number="44" style="v" sid="GEN 27:44" />Nawe ũikare nake kwa ihinda nginya mangʼũrĩ ma mũrũ wa nyũkwa mahũahũe. <verse eid="GEN 27:44" /><verse number="45" style="v" sid="GEN 27:45" />Rĩrĩa mũrũ wa nyũkwa agaatiga gũkũrakarĩra, na ariganĩrwo nĩ ũrĩa wamwĩkire-rĩ, nĩngagũtũmanĩra ũcooke mũciĩ. Ingĩkĩũrwo nĩ inyuĩ mũrĩ eerĩ mũthenya o ro ũmwe nĩkĩ?”<verse eid="GEN 27:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="GEN 27:46" />Ningĩ Rebeka akĩĩra Isaaka atĩrĩ, “Nĩnogetio nĩ mũtũũrĩre nĩ ũndũ wa andũ-a-nja aya a Ahiti. Jakubu angĩhikania kuuma kũrĩ andũ-a-nja aya a Ahiti a bũrũri ũyũ-rĩ, ta andũ-a-nja aya Esaũ ahikĩtie-rĩ, hatirĩ bata wa gũtũũra muoyo.”<verse eid="GEN 27:46" /></para>
  <chapter eid="GEN 27" />
  <chapter number="28" style="c" sid="GEN 28" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 28:1" />Tondũ ũcio, Isaaka agĩĩta Jakubu akĩmũrathima na akĩmwatha, akĩmwĩra atĩrĩ, “Ndũkanahikie mũndũ-wa-nja wa kuuma gũkũ Kaanani. <verse eid="GEN 28:1" /><verse number="2" style="v" sid="GEN 28:2" />Ũkĩra ũthiĩ Padani-Aramu, kwa nyũmba ya Bethueli ithe wa nyũkwa. Wĩcarĩrie mũtumia kuuma kũrĩ airĩtu a Labani, mũrũ wa nyina na nyũkwa. <verse eid="GEN 28:2" /><verse number="3" style="v" sid="GEN 28:3" />Ngai Mwene-Hinya-Wothe arokũrathima na atũme ũciarane mũno na ũingĩhe o nginya ũgaatuĩka rũrĩrĩ rwa andũ aingĩ. <verse eid="GEN 28:3" /><verse number="4" style="v" sid="GEN 28:4" />Ngai arokũhe kĩrathimo kĩrĩa aaheire Iburahĩmu hamwe na njiaro ciaku, nĩgeetha wĩgwatĩre bũrũri ũyũ ũratũũra rĩu ũrĩ ta mũgeni, o bũrũri ũyũ Ngai eerĩire Iburahĩmu.” <verse eid="GEN 28:4" /><verse number="5" style="v" sid="GEN 28:5" />Isaaka akĩĩra Jakubu athiĩ, nake agĩthiĩ Padani-Aramu kwa Labani mũrũ wa Bethueli ũrĩa Mũsuriata, mũrũ wa nyina na Rebeka, nyina wa Jakubu na Esaũ.<verse eid="GEN 28:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 28:6" />Na rĩrĩ, Esaũ nĩamenyire atĩ Isaaka nĩarathimĩte Jakubu na akamũtũma Padani-Aramu akahikanie kuo, na atĩ rĩrĩa aamũrathimire nĩamwathire, akĩmwĩra atĩrĩ, “Ndũkanahikie mũndũ-wa-nja wa kuuma gũkũ Kaanani.” <verse eid="GEN 28:6" /><verse number="7" style="v" sid="GEN 28:7" />O na akĩmenya atĩ Jakubu nĩathĩkĩire ithe na nyina na nĩathiĩte Padani-Aramu. <verse eid="GEN 28:7" /><verse number="8" style="v" sid="GEN 28:8" />Ningĩ Esaũ agĩkũũrana atĩ andũ-a-nja acio a Ahiti matiakenagia ithe, Isaaka; <verse eid="GEN 28:8" /><verse number="9" style="v" sid="GEN 28:9" />nĩ ũndũ ũcio, agĩthiĩ gwa Ishumaeli na akĩhikia Mahalathu, mwarĩ wa nyina na Nebaiothu, mũirĩtu wa Ishumaeli mũriũ wa Iburahĩmu, akĩmuongerera harĩ atumia arĩa angĩ aarĩ nao.<verse eid="GEN 28:9" /></para>
  <para style="s1">Kĩroto kĩa Jakubu kũu Betheli</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 28:10" />Jakubu oima Birishiba aathiire erekeire Harani. <verse eid="GEN 28:10" /><verse number="11" style="v" sid="GEN 28:11" />Na aakinya handũ hana-rĩ, akĩraarĩrĩra ho tondũ riũa nĩ rĩathũĩte. Akĩoya ihiga rĩmwe hau, agĩĩtiira narĩo mũtwe nĩguo akome. <verse eid="GEN 28:11" /><verse number="12" style="v" sid="GEN 28:12" />Nake akĩroota, akĩona ngathĩ ĩturumĩte thĩ, na mũthia wayo ũgakinya igũrũ matu-inĩ, nao araika a Ngai mambataga magĩikũrũkaga nayo. <verse eid="GEN 28:12" /><verse number="13" style="v" sid="GEN 28:13" />Jakubu akĩona Jehova arũgamĩte igũrũ rĩa ngathĩ ĩyo akĩmwĩra atĩrĩ, “Nĩ niĩ Jehova, Ngai wa thoguo Iburahĩmu na Ngai wa Isaaka. Bũrũri ũyũ ũkomete nĩngakũhe, wee hamwe na njiaro ciaku. <verse eid="GEN 28:13" /><verse number="14" style="v" sid="GEN 28:14" />Njiaro ciaku ikaingĩha ta rũkũngũ rwa thĩ, na nĩũgatambũrũka na mwena wa ithũĩro, na mwena wa irathĩro, na wa gathigathini, o na wa gũthini. Andũ a mĩhĩrĩga yothe ya thĩ nĩmakarathimwo nĩ ũndũ waku, na nĩ ũndũ wa rũciaro rwaku. <verse eid="GEN 28:14" /><verse number="15" style="v" sid="GEN 28:15" />Na niĩ ndĩ hamwe nawe, na nĩndĩkũmenyagĩrĩra kũrĩa guothe ũrĩthiiaga, na nĩngagũcookia bũrũri ũyũ. Ndigagũtiganĩria nginya ngaahingia maũndũ marĩa ndakwĩrĩra.”<verse eid="GEN 28:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 28:16" />Rĩrĩa Jakubu ookĩrire, agĩĩciiria atĩrĩ, “Ti-itherũ Jehova arĩ handũ haha, na ndiikũũĩ.” <verse eid="GEN 28:16" /><verse number="17" style="v" sid="GEN 28:17" />Agĩkĩigua guoya, akiuga atĩrĩ, “Kaĩ handũ haha nĩ ha kũmakania-ĩ! Haha nĩho nyũmba ya Ngai; na gĩkĩ nĩkĩo kĩhingo kĩa igũrũ-kwa-Ngai.”<verse eid="GEN 28:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 28:18" />Mũthenya ũyũ ũngĩ rũciinĩ tene, Jakubu akĩoya ihiga rĩrĩa etiirĩte narĩo mũtwe, akĩrĩrũgamia ta gĩtugĩ, akĩrĩitĩrĩria maguta. <verse eid="GEN 28:18" /><verse number="19" style="v" sid="GEN 28:19" />Agĩcooka agĩĩta handũ hau Betheli, o na gũtuĩka mbere ĩyo itũũra rĩu rĩetagwo Luzu.<verse eid="GEN 28:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 28:20" />Ningĩ Jakubu akĩĩhĩta na mwĩhĩtwa, akiuga atĩrĩ, “Ngai angĩkorwo hamwe na niĩ, na aamenyerere rũgendo-inĩ rũrũ ndĩrathiĩ, na aaheage irio cia kũrĩa na nguo cia kwĩhumba, <verse eid="GEN 28:20" /><verse number="21" style="v" sid="GEN 28:21" />nĩguo ngaacooka nyũmba-inĩ ya baba na thayũ-rĩ, Jehova nĩagatuĩka Ngai wakwa, <verse eid="GEN 28:21" /><verse number="22" style="v" sid="GEN 28:22" />narĩo ihiga rĩĩrĩ ndaarũgamia ta gĩtugĩ rĩgaatuĩka nyũmba ya Ngai, na kĩrĩa o gĩothe ũkaahe, nĩngakũhe gĩcunjĩ gĩa ikũmi.”<verse eid="GEN 28:22" /></para>
  <chapter eid="GEN 28" />
  <chapter number="29" style="c" sid="GEN 29" />
  <para style="s1">Jakubu Gũkinya Padani-Aramu</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 29:1" />Thuutha ũcio Jakubu agĩthiĩ na mbere na rũgendo rwake, agĩkinya bũrũri wa andũ a mwena wa irathĩro. <verse eid="GEN 29:1" /><verse number="2" style="v" sid="GEN 29:2" />Na rĩrĩ, akĩona gĩthima werũ-inĩ, na ndũũru ithatũ cia mbũri ikomete hakuhĩ nakĩo, tondũ cianyuithagio maaĩ kuuma gĩthima-inĩ kĩu. Narĩo ihiga rĩrĩa rĩakunĩkĩte mũromo wa gĩthima kĩu rĩarĩ inene mũno. <verse eid="GEN 29:2" /><verse number="3" style="v" sid="GEN 29:3" />Na ndũũru ciothe ciarĩkia kũrũrũngana hau, arĩithi nao maagaragaragia ihiga rĩkeherio mũromo-inĩ wa gĩthima, makahe ndũũru maaĩ. Magacooka magacookia ihiga handũ harĩo mũromo-inĩ wa gĩthima.<verse eid="GEN 29:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 29:4" />Jakubu akĩũria arĩithi acio atĩrĩ, “Ariũ a baba, muumĩte kũ?”</para>
  <para style="p" vid="GEN 29:4">Nao makĩmũcookeria atĩrĩ, “Tuumĩte Harani.”<verse eid="GEN 29:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 29:5" />Akĩmooria atĩrĩ, “Nĩ mũũĩ Labani mũrũ wa Nahoru?”</para>
  <para style="p" vid="GEN 29:5">Nao magĩcookia “Ĩĩ, nĩ tũmũũĩ.”<verse eid="GEN 29:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 29:6" />Ningĩ Jakubu akĩmooria atĩrĩ, “No mwega?”</para>
  <para style="p" vid="GEN 29:6">Makiuga atĩrĩ, “Ĩĩ, nĩ mwega. Na rĩrĩ, mwarĩ Rakeli-rĩ, nĩwe ũũrĩa ũroka na ngʼondu.”<verse eid="GEN 29:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 29:7" />Nake Jakubu akĩmeera ũũ, “Atĩrĩrĩ, riũa rĩrĩ o igũrũ; na ti ihinda rĩa gũcookanĩrĩria ndũũru. Heei ngʼondu maaĩ, mũcooke mũthiĩ mũgacirĩithie.”<verse eid="GEN 29:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 29:8" />Nao makĩmũcookeria atĩrĩ, “Tũtingĩĩka ũguo o nginya ndũũru ciothe icookanĩrĩrio, narĩo ihiga rĩgaragario kuuma mũromo wa gĩthima, tũcooke tũhe ngʼondu maaĩ.”<verse eid="GEN 29:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 29:9" />O akĩmaragĩria-rĩ, Rakeli agĩkinya na ngʼondu cia ithe, tondũ aarĩ mũrĩithi. <verse eid="GEN 29:9" /><verse number="10" style="v" sid="GEN 29:10" />Rĩrĩa Jakubu onire Rakeli mwarĩ wa Labani, mũrũ wa nyina na nyina, na ngʼondu cia Labani, agĩthiĩ, akĩgaragaria ihiga, akĩrĩeheria mũromo-inĩ wa gĩthima na akĩhe ngʼondu cia mamawe maaĩ. <verse eid="GEN 29:10" /><verse number="11" style="v" sid="GEN 29:11" />Ningĩ Jakubu akĩmumunya Rakeli, na akĩrĩra anĩrĩire. <verse eid="GEN 29:11" /><verse number="12" style="v" sid="GEN 29:12" />Jakubu nĩeerĩte Rakeli atĩ nĩ metainwo na ithe, na atĩ aarĩ mũrũ wa Rebeka. Nĩ ũndũ ũcio Rakeli agĩtengʼera akĩĩra ithe ũhoro ũcio.<verse eid="GEN 29:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 29:13" />Labani aarĩkia kũigua ũhoro wa Jakubu, mũriũ wa mwarĩ wa nyina, akĩhiũha agĩthiĩ kũmũtũnga. Akĩmũhĩmbĩria akĩmũmumunya, na akĩmũtwara mũciĩ, na arĩ kũu mũciĩ Jakubu akĩhe Labani ũhoro ũcio wothe. <verse eid="GEN 29:13" /><verse number="14" style="v" sid="GEN 29:14" />Nake Labani akĩmwĩra atĩrĩ, “Ti-itherũ, ũrĩ wa mũthiimo wakwa na thakame yakwa.”</para>
  <para style="s1" vid="GEN 29:14">Jakubu Kũhikia Lea na Rakeli</para>
  <para style="p" vid="GEN 29:14">Thuutha wa Jakubu gũikara nake mweri mũgima, <verse eid="GEN 29:14" /><verse number="15" style="v" sid="GEN 29:15" />Labani akĩmũũria atĩrĩ, “Ũrĩndutagĩra wĩra o ũguo tũhũ tondũ ũrĩ wa mbarĩ ciitũ? Njĩĩra mũcaara ũrĩa ũkwenda.”<verse eid="GEN 29:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 29:16" />Na rĩrĩ, Labani aarĩ na airĩtu eerĩ; ũrĩa mũkũrũ eetagwo Lea, nake ũrĩa mũnini eetagwo Rakeli. <verse eid="GEN 29:16" /><verse number="17" style="v" sid="GEN 29:17" />Lea aarĩ na maitho mataarĩ na hinya, no Rakeli oombĩtwo arĩ kĩĩrorerwa na aarĩ mũthaka. <verse eid="GEN 29:17" /><verse number="18" style="v" sid="GEN 29:18" />Jakubu eendete Rakeli, nake akiuga atĩrĩ, “Nĩngũgũtungatĩra mĩaka mũgwanja, ũndĩhe na kũũhe Rakeli, mwarĩguo ũrĩa mũnini.”<note caller="+" style="f"><char style="fr" closed="false">29:18 </char><char style="ft" closed="false">Mũhikania aarĩhaga rũracio kũrĩ ithe wa mũirĩtu (34:12). Angĩakorirwo atarĩ na indo cia kũraacia, nĩangĩarĩhire rũracio na njĩra ya kũrutĩra ithe wa mũirĩtu wĩra.</char></note><verse eid="GEN 29:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 29:19" />Labani agĩcookia atĩrĩ, “Nĩ kaba ndĩmũheanĩte kũrĩ we gũkĩra ndĩmũhe mũndũ ũngĩ. Ikara gũkũ na niĩ, ũndungate.” <verse eid="GEN 29:19" /><verse number="20" style="v" sid="GEN 29:20" />Nĩ ũndũ ũcio Jakubu agĩtungata mĩaka mũgwanja nĩguo aheo Rakeli, no harĩ we yarĩ o ta matukũ manini nĩ ũndũ wa ũrĩa aamwendete.<verse eid="GEN 29:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 29:21" />Mĩaka ĩyo yathira Jakubu akĩĩra Labani atĩrĩ, “Rĩu kĩĩhe mũtumia wakwa ndĩmũhikie, tondũ nĩndĩrarĩkirie ihinda rĩakwa rĩa gũtungata.”<verse eid="GEN 29:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 29:22" />Nĩ ũndũ ũcio Labani agĩkĩũngania andũ a kũu othe, akĩmarugĩra iruga. <verse eid="GEN 29:22" /><verse number="23" style="v" sid="GEN 29:23" />No rĩrĩa hwaĩ-inĩ wakinyire-rĩ, akĩoya mwarĩ Lea, akĩmũnengera Jakubu, nake Jakubu agĩkoma nake. <verse eid="GEN 29:23" /><verse number="24" style="v" sid="GEN 29:24" />Ningĩ Labani akĩheana Zilipa, ndungata yake ya mũirĩtu kũrĩ mwarĩ ĩmũtungatagĩre.<verse eid="GEN 29:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 29:25" />Na gwakĩa rũciinĩ-rĩ, Jakubu akĩona atĩ aaheetwo Lea! Tondũ ũcio Jakubu akĩũria Labani atĩrĩ, “Hĩ nĩ atĩa ũũ wanjĩka? Githĩ ndiragũtungatagĩra nĩ ũndũ wa Rakeli? Ũũheenetie nĩkĩ?”<verse eid="GEN 29:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 29:26" />Labani akĩmũcookeria atĩrĩ, “Ti mũtugo witũ gũkũ kũheana mũirĩtu ũrĩa mũnini ahike mbere ya ũrĩa mũkũrũ: <verse eid="GEN 29:26" /><verse number="27" style="v" sid="GEN 29:27" />Rĩĩkia kiumia kĩa mũirĩtu ũyũ wahikia, na nĩtũgũcooka tũkũhe o na ũcio ũngĩ mũnini, nawe ũndutĩre wĩra mĩaka ĩngĩ mũgwanja.”<verse eid="GEN 29:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 29:28" />Nake Jakubu agĩĩka o ũguo. Akĩrĩkia kiumia kĩa Lea, nake Labani akĩmũnengera mwarĩ Rakeli atuĩke mũtumia wake. <verse eid="GEN 29:28" /><verse number="29" style="v" sid="GEN 29:29" />Labani akĩheana Biliha, ndungata yake ya mũirĩtu, kũrĩ Rakeli ĩmũtungatagĩre. <verse eid="GEN 29:29" /><verse number="30" style="v" sid="GEN 29:30" />Jakubu agĩkoma na Rakeli o nake, na akĩenda Rakeli gũkĩra Lea. Na akĩrutĩra Labani wĩra mĩaka ĩngĩ mũgwanja.<verse eid="GEN 29:30" /></para>
  <para style="s1">Ciana cia Jakubu</para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 29:31" />Rĩrĩa Jehova onire atĩ Lea ndendeetwo-rĩ, akĩhingũra nda yake, no Rakeli aarĩ thaata. <verse eid="GEN 29:31" /><verse number="32" style="v" sid="GEN 29:32" />Lea akĩgĩa nda na agĩciara kahĩĩ. Nake agĩgatua Rubeni, akiuga atĩrĩ, “Nĩ tondũ Jehova nĩonete mĩnyamaro yakwa. Ti-itherũ, rĩu mũthuuri wakwa nĩekũnyenda.”<verse eid="GEN 29:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 29:33" />Na akĩgĩa nda rĩngĩ, na rĩrĩa aaciarire kahĩĩ, akiuga atĩrĩ, “Tondũ Jehova nĩaiguire atĩ ndirĩ mwende-rĩ, nĩaheete gaka o nako.” Nake agĩgatua Simeoni.<verse eid="GEN 29:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 29:34" />O rĩngĩ akĩgĩa nda na rĩrĩa aaciarire kahĩĩ, akiuga atĩrĩ, “Ihinda rĩĩrĩ mũthuuri wakwa no ekwĩohania na niĩ tondũ nĩndĩmũciarĩire ihĩĩ ithatũ.” Nĩ ũndũ ũcio agĩgatua Lawi.<verse eid="GEN 29:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 29:35" />Agĩcooka akĩgĩa nda rĩngĩ, agĩciara kahĩĩ kangĩ, akiuga atĩrĩ, “Ihinda rĩĩrĩ nĩ ngũgooca Jehova.” Nĩ ũndũ ũcio agĩgatua Juda. Agĩcooka akĩrũgama kũgĩa ciana.<verse eid="GEN 29:35" /></para>
  <chapter eid="GEN 29" />
  <chapter number="30" style="c" sid="GEN 30" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 30:1" />Rĩrĩa Rakeli onire atĩ ndaraciarĩra Jakubu ciana-rĩ, akĩiguĩra mwarĩ wa nyina ũiru. Nĩ ũndũ ũcio akĩĩra Jakubu atĩrĩ, “He ciana kana ngue!”<verse eid="GEN 30:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 30:2" />Jakubu akĩrakario nĩ Rakeli akĩmũũria atĩrĩ, “Kaarĩ niĩ ndĩ ithenya rĩa Ngai ũrĩa ũkũimĩte ciana?”<verse eid="GEN 30:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 30:3" />Rakeli akĩmwĩra atĩrĩ, “Biliha ndungata yakwa ya mũirĩtu ĩrĩ haha; koma nayo nĩgeetha ĩnjiarĩre ciana, na niĩ ngĩe na nyũmba na ũndũ wayo.”<note caller="+" style="f"><char style="fr" closed="false">30:3 </char><char style="ft" closed="false">Mũtugo ũyũ woirwo nĩ mbarĩ ya Iburahĩmu kuuma kũrĩ mĩtugo ya ndũrĩrĩ cia tene.</char></note><verse eid="GEN 30:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 30:4" />Nĩ ũndũ ũcio akĩmũhe Biliha ndungata yake ya mũirĩtu ĩrĩ ta mũtumia wake. Jakubu agĩkoma nayo, <verse eid="GEN 30:4" /><verse number="5" style="v" sid="GEN 30:5" />nake Biliha akĩgĩa nda, akĩmũciarĩra kahĩĩ. <verse eid="GEN 30:5" /><verse number="6" style="v" sid="GEN 30:6" />Rakeli akiuga atĩrĩ, “Ngai nĩandĩhĩria na nĩaiguĩte gũthaithana gwakwa, na nĩaheete kahĩĩ.” Na tondũ ũcio, agĩgatua Dani.<verse eid="GEN 30:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 30:7" />Biliha ndungata ĩyo ya Rakeli ĩkĩgĩa nda ĩngĩ, na ĩgĩciarĩra Jakubu kahĩĩ ga keerĩ. <verse eid="GEN 30:7" /><verse number="8" style="v" sid="GEN 30:8" />Nake Rakeli akiuga atĩrĩ, “Nĩ ngoretwo na kũgiana kũnene na mwarĩ wa maitũ, na nĩ hootanĩte.” Nĩ ũndũ ũcio agĩgatua Nafitali.<verse eid="GEN 30:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 30:9" />Na rĩrĩa Lea onire atĩ nĩarũgamĩte kũgĩa ciana-rĩ, akĩoya Zilipa ndungata yake ya mũirĩtu akĩmĩhe Jakubu ĩrĩ ta mũtumia wake. <verse eid="GEN 30:9" /><verse number="10" style="v" sid="GEN 30:10" />Nake Zilipa, ndungata ĩyo ya Lea, ĩgĩciarĩra Jakubu kahĩĩ. <verse eid="GEN 30:10" /><verse number="11" style="v" sid="GEN 30:11" />Nake Lea akiuga atĩrĩ, “Hĩ, kaĩ ũyũ nĩ mũnyaka-ĩ!” Nĩ ũndũ ũcio agĩgatua Gadi.<verse eid="GEN 30:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 30:12" />Zilipa ndungata ĩyo ya Lea ĩgĩciarĩra Jakubu kahĩĩ ga keerĩ. <verse eid="GEN 30:12" /><verse number="13" style="v" sid="GEN 30:13" />Ningĩ Lea akiuga atĩrĩ, “Kaĩ ndĩ mũkenu-ĩ! Andũ-a-nja marĩnjĩtaga ‘mũkenu.’ ” Nĩ ũndũ ũcio agĩgatua Asheri.<verse eid="GEN 30:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 30:14" />Na rĩrĩ, hĩndĩ ya kũgetha ngano-rĩ, Rubeni agĩthiĩ mũgũnda-inĩ na akĩona mĩmera ya mandarĩki,<note caller="+" style="f"><char style="fr" closed="false">30:14 </char><char style="ft" closed="false">Matunda ma mandarĩki mahaana ndongu, na meeciiragĩrio atĩ nĩmongagĩrĩra hinya wa mũndũ ũhoro-inĩ wa gũciara.</char></note> na akĩrehera nyina Lea. Nake Rakeli akĩĩra Lea atĩrĩ, “Ndagũthaitha he mandarĩki mamwe ma mũrũguo.”<verse eid="GEN 30:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 30:15" />Nake Lea akĩmũcookeria atĩrĩ, “Kaĩ arĩ ũndũ mũnini kũndunya mũthuuri wakwa? Rĩu ningĩ nĩũkuoya mandarĩki ma mũriũ wakwa o namo?”</para>
  <para style="p" vid="GEN 30:15">Rakeli akĩmwĩra atĩrĩ, “He mandarĩki ma mũrũguo, nake Jakubu akome nawe ũmũthĩ.”<verse eid="GEN 30:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 30:16" />Na rĩrĩa Jakubu ookire hwaĩ-inĩ oimĩte mũgũnda-rĩ, Lea agĩthiĩ kũmũtũnga. Akĩmwĩra atĩrĩ, “No nginya ũkome na niĩ, tondũ nĩngũgũrire na mandarĩki ma mũriũ wakwa.” Nĩ ũndũ ũcio agĩkoma nake ũtukũ ũcio.<verse eid="GEN 30:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 30:17" />Nake Ngai akĩigua mahooya ma Lea, nake akĩgĩa nda na agĩciarĩra Jakubu kahĩĩ ga gatano. <verse eid="GEN 30:17" /><verse number="18" style="v" sid="GEN 30:18" />Ningĩ Lea akiuga atĩrĩ, “Ngai nĩaheete kĩheo nĩ ũndũ wa kũheana ndungata yakwa ya mũirĩtu kũrĩ mũthuuri wakwa.” Nĩ ũndũ ũcio agĩgatua Isakaru.<verse eid="GEN 30:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 30:19" />Lea agĩcooka akĩgĩa nda ĩngĩ, na agĩciarĩra Jakubu, kahĩĩ ga gatandatũ. <verse eid="GEN 30:19" /><verse number="20" style="v" sid="GEN 30:20" />Ningĩ Lea akiuga atĩrĩ, “Ngai ekũhe kĩheo kĩa goro mũno. Rĩu mũthuuri wakwa nĩarĩheeaga gĩtĩĩo tondũ ndĩmũciarĩire ihĩĩ ithathatũ.” Nĩ ũndũ ũcio agĩgatua Zebuluni.<verse eid="GEN 30:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 30:21" />Thuutha ũcio agĩciara mũirĩtu na akĩmũtua Dina.<verse eid="GEN 30:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 30:22" />Thuutha ũcio Ngai akĩririkana Rakeli, akĩmũigua, na akĩhingũra nda yake. <verse eid="GEN 30:22" /><verse number="23" style="v" sid="GEN 30:23" />Nake akĩgĩa nda na agĩciara kahĩĩ, akiuga atĩrĩ, “Ngai nĩanjehereria thoni.” <verse eid="GEN 30:23" /><verse number="24" style="v" sid="GEN 30:24" />Nake agĩgatua Jusufu, akiuga atĩrĩ, “Ngai arohe kahĩĩ kangĩ!”<verse eid="GEN 30:24" /></para>
  <para style="s1">Ndũũru cia Jakubu Kũingĩha</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 30:25" />Thuutha wa Rakeli gũciara Jusufu, Jakubu akĩĩra Labani atĩrĩ, “Ndekereria ndĩthiĩre, nĩguo njooke bũrũri witũ. <verse eid="GEN 30:25" /><verse number="26" style="v" sid="GEN 30:26" />Nengera atumia akwa na ciana ciakwa, arĩa ngũtungatĩire nĩ ũndũ wao, na niĩ ndĩthiĩre. Wee nĩũũĩ wĩra ũrĩa ngũrutĩire.”<verse eid="GEN 30:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 30:27" />No Labani akĩmwĩra atĩrĩ, “Angĩkorwo nĩnjĩtĩkĩrĩkĩte maitho-inĩ maku-rĩ, ndagũthaitha ikaranga. Nĩmenyete na ũndũ wa ũragũri atĩ Jehova nĩandathimĩte nĩ ũndũ waku.” <verse eid="GEN 30:27" /><verse number="28" style="v" sid="GEN 30:28" />Agĩthiĩ na mbere, akiuga atĩrĩ, “Njĩĩra mũcaara ũrĩa ũkwenda na nĩ ngũkũrĩha.”<verse eid="GEN 30:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 30:29" />Jakubu akĩmũcookeria atĩrĩ, “Wee nĩũũĩ ũrĩa ngũrutĩire wĩra na ũrĩa menyereire mahiũ maku nginya makaingĩha. <verse eid="GEN 30:29" /><verse number="30" style="v" sid="GEN 30:30" />Kĩrĩa kĩnini warĩ nakĩo itaanoka nĩkĩingĩhĩte mũno, nake Jehova nĩakũrathimĩte kũrĩa guothe ngoretwo. No rĩrĩ, ngeekĩra nyũmba yakwa ũndũ rĩ?”<verse eid="GEN 30:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 30:31" />Labani akĩmũũria atĩrĩ, “Ũkwenda ngũhe kĩ?”</para>
  <para style="p" vid="GEN 30:31">Jakubu akĩmũcookeria atĩrĩ, “Ndũkahe kĩndũ o na kĩ. Korwo no ũnjĩkĩre ũndũ ũyũ ũmwe tu, no thiĩ na mbere na kũrĩithia ndũũru ciaku na gũcimenyerera: <verse eid="GEN 30:31" /><verse number="32" style="v" sid="GEN 30:32" />Naguo ũndũ ũcio nĩ ũyũ: Njĩtĩkĩria thiĩ ndũũru-inĩ ciaku ciothe ũmũthĩ, na njeherie thĩinĩ wacio ngʼondu iria ciothe irĩ maara kana irĩ marooro, na ndũrũme ciothe iria njirũ na mbũri ciothe iria irĩ maara na irĩ maroro. Icio nĩcio igũtuĩka mũcaara wakwa. <verse eid="GEN 30:32" /><verse number="33" style="v" sid="GEN 30:33" />Naguo wĩhokeku wakwa nĩguo ũkaanjarĩrĩria thuutha-inĩ, rĩrĩa rĩothe ũngĩũka kuona mũcaara ũrĩa ũndĩhĩte. Mbũri o yothe ĩtarĩ maara kana maroro, kana ndũrũme o yothe ĩtarĩ njirũ, ingĩgaakorwo nacio, igaatuĩka nĩ cia ũici.”<verse eid="GEN 30:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 30:34" />Nake Labani akiuga atĩrĩ, “Nĩndetĩkĩra; reke gũtuĩke o ro ũguo woiga.” <verse eid="GEN 30:34" /><verse number="35" style="v" sid="GEN 30:35" />Mũthenya o ro ũcio-rĩ, Labani akĩeheria thenge ciothe iria ciarĩ maara na iria ciarĩ na maroro, na mĩgoma yothe ĩrĩa yarĩ maara na ĩrĩa yarĩ na marooro (iria ciothe ciarĩ na handũ herũ), na ndũrũme ciothe iria ciarĩ njirũ agĩcineana kũrĩ ariũ ake macirĩithagie. <verse eid="GEN 30:35" /><verse number="36" style="v" sid="GEN 30:36" />Ningĩ agĩcieheranĩria na iria ingĩ na ũraihu wa rũgendo rwa mĩthenya ĩtatũ gatagatĩ gake na Jakubu. Nake Jakubu agĩthiĩ na mbere kũrĩithia ndũũru iria ingĩ cia Labani ciatigarire.<verse eid="GEN 30:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 30:37" />No rĩrĩ, Jakubu agĩtema thanju njigũ cia mũribina, na mũrothi, na cia mũarimaũ, agĩciĩkĩra mĩcoora mĩerũ na ũndũ wa kũnũra igoko agatũma werũ wa thĩinĩ wa thanju icio wonekane. <verse eid="GEN 30:37" /><verse number="38" style="v" sid="GEN 30:38" />Agĩcooka akĩiga thanju icio oonũrĩte mĩtaro-inĩ yothe ĩrĩa yanyuuagĩrwo maaĩ, nĩgeetha ikoragwo irĩ mbere ya mbũri rĩrĩa cioka kũnyua maaĩ. Rĩrĩa ndũũru icio ciakorwo irĩ na mũrukĩ na cioka kũnyua maaĩ-rĩ, <verse eid="GEN 30:38" /><verse number="39" style="v" sid="GEN 30:39" />igakĩhaicanĩra hau mbere ya thanju icio. Thuutha ũcio igaciara tũũri tũrĩ na manyaga, kana maara, kana marooro. <verse eid="GEN 30:39" /><verse number="40" style="v" sid="GEN 30:40" />Jakubu akĩamũrania tũũri tũu kuuma rũũru-inĩ rwa Labani, na tũgetindia, no agatũma icio ingĩ ingʼethere iria ciarĩ na maroro na iria njirũ cia Labani. Nĩ ũndũ ũcio agĩĩthondekera ndũũru ciake mwene, na ndaacituranĩrire na cia Labani. <verse eid="GEN 30:40" /><verse number="41" style="v" sid="GEN 30:41" />Hĩndĩ ĩrĩa yothe mbũri iria ciarĩ na hinya ciagĩa na mũrukĩ-rĩ, Jakubu aigaga thanju icio mĩtaro-inĩ ya maaĩ mbere yacio, nĩgeetha cihaicanĩre hakuhĩ na thanju icio; <verse eid="GEN 30:41" /><verse number="42" style="v" sid="GEN 30:42" />no ingĩakorirwo nĩ iria itaarĩ na hinya, ndaigaga thanju icio ho. Nĩ ũndũ ũcio mbũri iria ciarĩ mocu igĩtuĩka cia Labani, na iria ciarĩ hinya igĩtuĩka cia Jakubu. <verse eid="GEN 30:42" /><verse number="43" style="v" sid="GEN 30:43" />Nĩ ũndũ wa gwĩka ũguo, mũndũ ũcio ti Jakubu agĩkĩrĩrĩria kũgĩa na indo nyingĩ, akĩgĩa na mahiũ maingĩ, na ndungata cia airĩtu na cia arũme, o na ngamĩĩra na ndigiri.<verse eid="GEN 30:43" /></para>
  <chapter eid="GEN 30" />
  <chapter number="31" style="c" sid="GEN 31" />
  <para style="s1">Jakubu Kũũrĩra Labani</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 31:1" />Jakubu nĩaiguire ariũ a Labani makiuga atĩrĩ, “Jakubu nĩoete indo iria ciothe iraarĩ cia baba na ũtonga ũrĩa wothe arĩ naguo eyoneire kuuma indo-inĩ cia baba.” <verse eid="GEN 31:1" /><verse number="2" style="v" sid="GEN 31:2" />Ningĩ Jakubu akĩona atĩ Labani ndaamwendete ta ũrĩa aamwendete mbere ĩyo.<verse eid="GEN 31:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 31:3" />Nake Jehova akĩĩra Jakubu atĩrĩ, “Cooka bũrũri wa maithe manyu na kũrĩ andũ anyu, na nĩndĩrĩkoragwo hamwe nawe.”<verse eid="GEN 31:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 31:4" />Nĩ ũndũ ũcio Jakubu agĩtũmanĩra Rakeli na Lea mathiĩ kũrĩ we kũu werũ-inĩ kũrĩa mahiũ make maarĩ. <verse eid="GEN 31:4" /><verse number="5" style="v" sid="GEN 31:5" />Nake akĩmeera atĩrĩ, “Nĩnyonete atĩ wendo wa thoguo harĩ niĩ ti ta ũrĩa ararĩ naguo hau mbere, no Ngai wa baba nĩakoretwo hamwe na niĩ. <verse eid="GEN 31:5" /><verse number="6" style="v" sid="GEN 31:6" />Inyuĩ eerĩ nĩmũũĩ atĩ ndutĩire thoguo wĩra na hinya wakwa wothe, <verse eid="GEN 31:6" /><verse number="7" style="v" sid="GEN 31:7" />no thoguo nĩaheenetie na akagarũra mũcaara wakwa maita ikũmi. No rĩrĩ, Ngai ndarĩ aamwĩtĩkĩria anjĩke ũũru. <verse eid="GEN 31:7" /><verse number="8" style="v" sid="GEN 31:8" />Thoguo angĩoigire atĩrĩ, ‘Mbũri iria irĩ maara nĩcio mũcaara waku,’ hĩndĩ ĩyo mahiũ mothe magaciara tũũri tũrĩ na maara; na angĩoigire atĩrĩ, ‘Iria irĩ marooro nĩcio mũcaara waku,’ namo mahiũ magaciara tũũri tũrĩ na marooro. <verse eid="GEN 31:8" /><verse number="9" style="v" sid="GEN 31:9" />Nĩ ũndũ ũcio, Ngai nĩatunyĩte thoguo mahiũ make na akamaheana kũrĩ niĩ.<verse eid="GEN 31:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 31:10" />“Ihinda rĩrĩa mahiũ maahaicanaga, rĩmwe nĩndarootire kĩroto na ndarora na igũrũ ngĩona atĩ thenge iria ciahaicaga mahiũ ciarĩ na manyaga, na ciarĩ na maara, o na ciarĩ na marooro. <verse eid="GEN 31:10" /><verse number="11" style="v" sid="GEN 31:11" />Nake mũraika wa Ngai akĩnjarĩria ndĩ kĩroto-inĩ, akĩnjĩĩra atĩrĩ, ‘Jakubu.’ Na niĩ ngĩcookia atĩrĩ, ‘Niĩ ũyũ haha.’ <verse eid="GEN 31:11" /><verse number="12" style="v" sid="GEN 31:12" />Nake akĩnjĩĩra atĩrĩ, ‘Ta tiira maitho na igũrũ wone atĩ thenge iria ciothe irahaica mahiũ nĩ iria irĩ na manyaga, na iria irĩ na maara, na iria irĩ na marooro; nĩgũkorwo nĩnyonete maũndũ marĩa mothe Labani agwĩkĩte. <verse eid="GEN 31:12" /><verse number="13" style="v" sid="GEN 31:13" />Nĩ niĩ Ngai wa Betheli, kũrĩa waitĩrĩirie gĩtugĩ maguta, na nokuo wehĩtĩire na mwĩhĩtwa nĩ ũndũ wakwa. Rĩu uma bũrũri ũyũ narua ũcooke bũrũri ũrĩa waciarĩirwo.’ ”<verse eid="GEN 31:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 31:14" />Nake Rakeli na Lea makĩmũcookeria atĩrĩ, “Ithuĩ-rĩ, no anga tũrĩ na kĩndũ kana igai indo-inĩ cia baba? <verse eid="GEN 31:14" /><verse number="15" style="v" sid="GEN 31:15" />Githĩ ndatũtuaga o ta tũrĩ andũ a kũngĩ? To gũtwendia aatwendirie, no rĩu nĩarĩkĩtie kũhũthĩra indo iria twagũrirwo nacio. <verse eid="GEN 31:15" /><verse number="16" style="v" sid="GEN 31:16" />Ti-itherũ ũtonga ũrĩa wothe Ngai atunyĩte baba nĩ witũ na ciana ciitũ. Nĩ ũndũ ũcio ĩka ũrĩa wothe Ngai akwĩrĩte wĩke.”<verse eid="GEN 31:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 31:17" />Nĩ ũndũ ũcio Jakubu akĩĩhaarĩria, akĩigĩrĩra ciana ciake na atumia ake igũrũ rĩa ngamĩĩra, <verse eid="GEN 31:17" /><verse number="18" style="v" sid="GEN 31:18" />na akiumagaria mahiũ make mothe mathiĩ mbere yake hamwe na indo ciake ciothe iria aagĩte nacio kũu Padani-Aramu, nĩguo athiĩ kũrĩ ithe Isaaka o kũu bũrũri wa Kaanani.<verse eid="GEN 31:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 31:19" />Hĩndĩ ĩyo, Labani aathiĩte kwenja ngʼondu ciake guoya-rĩ, Rakeli akĩiya ngai cia ithe cia mĩhianano. <verse eid="GEN 31:19" /><verse number="20" style="v" sid="GEN 31:20" />Nĩ ũndũ ũcio Jakubu akĩheenia Labani ũcio Mũsuriata tondũ ndaamwĩrire nĩ kũũra aroora. <verse eid="GEN 31:20" /><verse number="21" style="v" sid="GEN 31:21" />Nake akĩũra na kĩrĩa gĩothe arĩ nakĩo, na aringa Rũũĩ rwa Farati, akĩerekera bũrũri wa irĩma wa Gileadi.<verse eid="GEN 31:21" /></para>
  <para style="s1">Labani Kũingatana na Jakubu</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 31:22" />Mũthenya wa ĩtatũ kuuma Jakubu oora, Labani akĩĩrwo atĩ Jakubu nĩorĩte. <verse eid="GEN 31:22" /><verse number="23" style="v" sid="GEN 31:23" />Agĩkĩoya andũ a nyũmba yao, akĩingatana na Jakubu matukũ mũgwanja na akĩmũkinyĩra kũu bũrũri wa irĩma wa Gileadi. <verse eid="GEN 31:23" /><verse number="24" style="v" sid="GEN 31:24" />No Ngai akiumĩrĩra Labani ũcio Mũsuriata kĩroto-inĩ, akĩmwĩra atĩrĩ, “Menya wĩre Jakubu ũndũ o na ũrĩkũ, ũrĩ mwega kana ũrĩ mũũru.”<verse eid="GEN 31:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 31:25" />Na rĩrĩ, Jakubu aambĩte hema yake kũu bũrũri wa irĩma wa Gileadi rĩrĩa Labani aamũkinyĩrire, nake Labani na andũ a nyũmba yao makĩamba hema ciao kuo. <verse eid="GEN 31:25" /><verse number="26" style="v" sid="GEN 31:26" />Nake Labani akĩũria Jakubu atĩrĩ, “Nĩ atĩa ũũ wĩkĩte? Nĩũũheenetie, na ũgathiĩ na airĩtu akwa ta andũ matahĩtwo mbaara-inĩ. <verse eid="GEN 31:26" /><verse number="27" style="v" sid="GEN 31:27" />Nĩ kĩĩ gĩatũmire ũre na hitho, na ũũheenie? Waregire kũnjĩĩra nĩkĩ, nĩguo ngumagarie na gĩkeno na gũkũinĩra nyĩmbo na ihembe na inanda cia mũgeeto? <verse eid="GEN 31:27" /><verse number="28" style="v" sid="GEN 31:28" />O na ndwarekire mumunye ciana cia ciana ciakwa, kana njugĩre airĩtu akwa ũhoro. Nĩwĩkĩte ũndũ wa ũrimũ. <verse eid="GEN 31:28" /><verse number="29" style="v" sid="GEN 31:29" />Ndĩ na hinya wa gũkũgera ngero; no rĩrĩ, ũtukũ wa ira Ngai wa thoguo aranjĩĩrire atĩrĩ, ‘Menya wĩre Jakubu ũndũ, ũrĩ mwega kana ũrĩ mũũru.’ <verse eid="GEN 31:29" /><verse number="30" style="v" sid="GEN 31:30" />Rĩu-rĩ, nĩumagarĩte nĩ ũndũ nĩũrerirĩria gũcooka nyũmba-inĩ ya thoguo. No rĩrĩ, ũrakĩiyire ngai ciakwa nĩkĩ?”<verse eid="GEN 31:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 31:31" />Jakubu agĩcookeria Labani atĩrĩ, “Nĩndetigĩrire tondũ ndeciiririe wahota kũndunya airĩtu aku na hinya. <verse eid="GEN 31:31" /><verse number="32" style="v" sid="GEN 31:32" />No rĩrĩ, ũrĩa ũgũkora arĩ na ngai ciaku-rĩ, ndegũtũũra muoyo. Tuĩria wone kana kũrĩ kĩndũ gĩaku ndĩ nakĩo andũ aya aitũ marĩ ho; na wakĩona-rĩ, ũkĩoe.” No Jakubu ndooĩ atĩ Rakeli nĩaiyĩte ngai icio.<verse eid="GEN 31:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 31:33" />Nĩ ũndũ ũcio Labani agĩtoonya hema ya Jakubu, na hema ya Lea, o na hema ya ndungata iria igĩrĩ cia andũ-a-nja, no ndaigana kuona kĩndũ. Oima hema ya Lea, agĩtoonya ya Rakeli. <verse eid="GEN 31:33" /><verse number="34" style="v" sid="GEN 31:34" />Rakeli oete ngai icio cia mĩhianano na agacikia matandĩko-inĩ ma ngamĩĩra thĩinĩ na akamaikarĩra. Labani akiururia kĩrĩa gĩothe kĩarĩ hema-inĩ ĩyo na ndaigana kuona kĩndũ.<verse eid="GEN 31:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 31:35" />Nake Rakeli akĩĩra ithe atĩrĩ, “Mwathi wakwa, ndũkandakarĩre nĩ ũndũ ndinakũrũgamĩra; nĩgũkorwo nĩ maũndũ ma andũ-a-nja ndĩ namo.” Nĩ ũndũ ũcio akiururia no ndaigana kuona ngai icio.<verse eid="GEN 31:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 31:36" />Jakubu agĩkĩrakara na agĩtetia Labani, akĩmũũria atĩrĩ, “Ihĩtia rĩakwa nĩ rĩrĩkũ? Nĩ rĩhia rĩrĩkũ njĩkĩte rĩtũmĩte ũnyingatithie ũguo? <verse eid="GEN 31:36" /><verse number="37" style="v" sid="GEN 31:37" />Rĩu tondũ nĩwoiruria indo ciakwa ciothe-rĩ, nĩ kĩĩ wona kĩa indo cia gwaku mũciĩ? Kĩige haha mbere ya andũ aya anyu na mbere ya andũ akwa nĩguo matũtuithanie ciira.<verse eid="GEN 31:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 31:38" />“Ngũrutĩire wĩra mĩaka mĩrongo ĩĩrĩ. Ngʼondu ciaku na mbũri ciaku itirĩ ciahuna, na ndirĩ ndarĩa ndũrũme cia mahiũ maku. <verse eid="GEN 31:38" /><verse number="39" style="v" sid="GEN 31:39" />Ningĩ ndirĩ ndakũrehera iria ciatambuuragwo nĩ nyamũ cia gĩthaka; no nĩ niĩ ndaarĩhaga ngathiĩ hathara. Ningĩ-rĩ, nĩwandĩhagia ĩrĩa yothe yaiywo kũrĩ mũthenya kana kũrĩ ũtukũ. <verse eid="GEN 31:39" /><verse number="40" style="v" sid="GEN 31:40" />Ũguo nĩguo ndũũrĩte: Ndaarugagwo nĩ ũrugarĩ wa mũthenya na ngarĩĩo nĩ heho ya ũtukũ, naguo toro ũkĩnjũrĩra. <verse eid="GEN 31:40" /><verse number="41" style="v" sid="GEN 31:41" />Ũguo nĩguo ndũũrĩte gwaku mũciĩ handũ-inĩ ha mĩaka ĩyo mĩrongo ĩĩrĩ. Ndakũrutĩire wĩra mĩaka ikũmi na ĩna nĩ ũndũ wa airĩtu aku eerĩ, na mĩaka ĩtandatũ nĩ ũndũ wa mahiũ maku; no rĩrĩ, wagarũrire mũcaara wakwa maita ikũmi. <verse eid="GEN 31:41" /><verse number="42" style="v" sid="GEN 31:42" />Korwo Ngai wa baba, o we Ngai wa Iburahĩmu na nĩwe wĩtigĩrĩtwo nĩ Isaaka, ndaraakoragwo hamwe na niĩ-rĩ, ti-itherũ ũngĩranyumagaririe moko matheri. No Ngai nĩonete gũthĩĩnĩka gwakwa na wĩra wa moko makwa, na nĩkĩo arakũrũithirie ũtukũ wa ira.”<verse eid="GEN 31:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="GEN 31:43" />Nake Labani agĩcookeria Jakubu, akĩmwĩra atĩrĩ, “Atumia aya aku nĩ airĩtu akwa, ciana ici o nacio nĩ ciana ciakwa, namo mahiũ maya-rĩ, no mahiũ makwa. Kĩrĩa gĩothe ũroona nĩ gĩakwa. No rĩrĩ, nĩ atĩa ingĩhota gwĩka airĩtu aya akwa kana njĩke ciana ici maciarĩte ũmũthĩ? <verse eid="GEN 31:43" /><verse number="44" style="v" sid="GEN 31:44" />Rĩu gĩũke, reke tũgĩe na kĩrĩkanĩro niĩ nawe, na ũreke gĩtuĩke mũira gatagatĩ gaitũ.”<verse eid="GEN 31:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="GEN 31:45" />Nĩ ũndũ ũcio Jakubu akĩoya ihiga na akĩrĩhaanda ta gĩtugĩ. <verse eid="GEN 31:45" /><verse number="46" style="v" sid="GEN 31:46" />Akĩĩra andũ a nyũmba yake atĩrĩ, “Cookanĩrĩriai mahiga.” Nĩ ũndũ ũcio makĩũngania mahiga makĩmaiganĩrĩra hĩba, magĩcooka makĩrĩanĩra irio hau hakuhĩ na hĩba ĩyo. <verse eid="GEN 31:46" /><verse number="47" style="v" sid="GEN 31:47" />Labani akĩmĩĩta Jagari-Sahadutha, nake Jakubu akĩmĩĩta Galeedi.<verse eid="GEN 31:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="GEN 31:48" />Labani akiuga atĩrĩ, “Ũmũthĩ hĩba ĩno nĩ mũira gatagatĩ gakwa nawe.” Kĩu nĩkĩo gĩatũmire hetwo Galeedi. <verse eid="GEN 31:48" /><verse number="49" style="v" sid="GEN 31:49" />O na ningĩ hagĩĩtwo Mizipa, tondũ oigire atĩrĩ, “Jehova arotũmenyagĩrĩra rĩrĩa tũraihanĩrĩirie. <verse eid="GEN 31:49" /><verse number="50" style="v" sid="GEN 31:50" />Wee ũngĩgaathĩĩnia airĩtu akwa kana ũmahikĩrĩrie atumia angĩ, o na hangĩgakorwo hatarĩ mũndũ ũngĩ-rĩ, ririkana atĩ Ngai nĩwe mũira gatagatĩ gakwa nawe.”<verse eid="GEN 31:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="GEN 31:51" />Ningĩ Labani akĩĩra Jakubu atĩrĩ, “Ĩno nĩ hĩba, na gĩkĩ nĩ gĩtugĩ kĩrĩa ndahaanda gatagatĩ gaku na niĩ. <verse eid="GEN 31:51" /><verse number="52" style="v" sid="GEN 31:52" />Hĩba ĩno nĩ mũira, na gĩtugĩ gĩkĩ nĩ mũira, atĩ ndigakĩra hĩba ĩno njũke mwena waku ngũgere ngero, na atĩ nawe ndũgakĩra hĩba ĩno, kana ũkĩre gĩtugĩ gĩkĩ ũũke mwena wakwa ũngere ngero. <verse eid="GEN 31:52" /><verse number="53" style="v" sid="GEN 31:53" />Ngai wa Iburahĩmu, na Ngai wa Nahoru,<note caller="+" style="f"><char style="fr" closed="false">31:53 </char><char style="ft" closed="false">Nahoru aarĩ mũrũ wa nyina na Iburahĩmu (11:26), na aarĩ gukawe wa Labani (24:24, 29).</char></note> o we Ngai wa ithe wao-rĩ, arotũtuithania ciira.”</para>
  <para style="p" vid="GEN 31:53">Nĩ ũndũ ũcio Jakubu akĩĩhĩta na mwĩhĩtwa rĩĩtwa-inĩ rĩa ũcio Wĩtigĩrĩtwo nĩ ithe Isaaka. <verse eid="GEN 31:53" /><verse number="54" style="v" sid="GEN 31:54" />Jakubu akĩruta igongona kũu bũrũri-inĩ ũcio wa irĩma, na agĩĩta andũ a nyũmba yake marĩĩanĩre. Na marĩkia kũrĩa-rĩ, makĩraara o kũu.<verse eid="GEN 31:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="GEN 31:55" />Mũthenya ũyũ ũngĩ rũciinĩ tene, Labani akĩmumunya ciana cia ciana ciake o na airĩtu ake, akĩmoigĩra ũhoro na akĩmarathima. Agĩcooka akĩmatiga agĩcooka gwake mũciĩ.<verse eid="GEN 31:55" /></para>
  <chapter eid="GEN 31" />
  <chapter number="32" style="c" sid="GEN 32" />
  <para style="s1">Jakubu Kwĩhaarĩria Gũcemania na Esaũ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 32:1" />Jakubu nĩathiire na mbere na rũgendo rwake, na agĩtũngwo nĩ araika a Ngai. <verse eid="GEN 32:1" /><verse number="2" style="v" sid="GEN 32:2" />Na rĩrĩa Jakubu aamoonire, akiuga atĩrĩ, “Ĩno nĩ mbũtũ ya Ngai!” Nĩ ũndũ ũcio agĩĩta handũ hau Mahanaimu.<verse eid="GEN 32:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 32:3" />Ningĩ Jakubu agĩtũma andũ mathiĩ mbere yake kũrĩ mũrũ wa nyina Esaũ kũu Seiru, bũrũri-inĩ wa Edomu. <verse eid="GEN 32:3" /><verse number="4" style="v" sid="GEN 32:4" />Akĩmataara, akĩmeera atĩrĩ, “Ũũ nĩguo mũgũthiĩ kwĩra mwathi wakwa Esaũ: ‘Ndungata yaku Jakubu ĩkuuga atĩrĩ, ndĩraikaraga na Labani, na ngoretwo kuo nginya rĩu. <verse eid="GEN 32:4" /><verse number="5" style="v" sid="GEN 32:5" />Ndĩ na ngʼombe na ndigiri, na ngʼondu na mbũri, ndungata cia arũme na cia andũ-a-nja. Na rĩu ndagũtũmĩra ndũmĩrĩri, we mwathi wakwa, nĩgeetha njĩtĩkĩrĩke maitho-inĩ maku.’ ”<verse eid="GEN 32:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 32:6" />Rĩrĩa atũmwo maacookire kũrĩ Jakubu makĩmwĩra atĩrĩ, “Nĩtũrathiire kũrĩ mũrũ wa nyũkwa Esaũ, na rĩu nĩarooka gũgũtũnga, na arĩ na andũ magana mana.”<verse eid="GEN 32:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 32:7" />Jakubu akĩmaka mũno na akĩnyamarĩka, akĩgayania andũ arĩa aarĩ nao ikundi igĩrĩ, o na ndũũru cia mbũri na ndũũru cia ngʼombe o na ngamĩĩra nacio. <verse eid="GEN 32:7" /><verse number="8" style="v" sid="GEN 32:8" />Agĩĩciiria atĩrĩ, “Esaũ angĩũka atharĩkĩre gĩkundi kĩmwe-rĩ, gĩkundi kĩu kĩngĩ no kĩũre.”<verse eid="GEN 32:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 32:9" />Ningĩ Jakubu akĩhooya, akiuga atĩrĩ, “Wee Ngai wa baba Iburahĩmu, o Wee Ngai wa baba Isaaka, Wee Jehova ũrĩa wanjĩĩrire atĩrĩ, ‘Cooka bũrũri waku na wa andũ anyu, na nĩngatũma ũgaacĩre,’ <verse eid="GEN 32:9" /><verse number="10" style="v" sid="GEN 32:10" />ndirĩ mwagĩrĩru wa kuonio ũtugi ũyũ wothe na wĩhokeku ũrĩa ũnyonetie niĩ ndungata yaku. Ngĩringa Jorodani-rĩ, ndaarĩ o na rũthanju rwakwa rwiki, no rĩu nduĩkĩte ikundi igĩrĩ. <verse eid="GEN 32:10" /><verse number="11" style="v" sid="GEN 32:11" />Ndagũthaitha honokia kuuma moko-inĩ ma mũrũ wa maitũ Esaũ, nĩgũkorwo nĩndĩretigĩra ndagoke gũũtharĩkĩra, niĩ hamwe na ciana ici, na manyina maacio. <verse eid="GEN 32:11" /><verse number="12" style="v" sid="GEN 32:12" />No nĩ uugĩte atĩrĩ, ‘Ti-itherũ nĩngatũma ũgaacĩre na ndũme njiaro ciaku cingĩhe ta mũthanga wa iria-inĩ, ũrĩa ũtangĩtarĩka.’ ”<verse eid="GEN 32:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 32:13" />Akĩraara hau ũtukũ ũcio, na kuuma kũrĩ kĩrĩa aarĩ nakĩo, agĩthuurĩra mũrũ wa nyina Esaũ kĩheo gĩkĩ; <verse eid="GEN 32:13" /><verse number="14" style="v" sid="GEN 32:14" />mbũri magana meerĩ cia mĩgoma na thenge mĩrongo ĩĩrĩ, ngʼondu magana meerĩ na ndũrũme mĩrongo ĩĩrĩ, <verse eid="GEN 32:14" /><verse number="15" style="v" sid="GEN 32:15" />ngamĩĩra mĩrongo ĩtatũ cia mĩgoma na njaũ ciacio, ngʼombe mĩrongo ĩna na ndegwa ikũmi, na ndigiri mĩrongo ĩĩrĩ cia mĩgoma na ikũmi cia njamba. <verse eid="GEN 32:15" /><verse number="16" style="v" sid="GEN 32:16" />Agĩcinengera ndungata ciake, o rũũru mwanya, na akĩĩra ndungata icio ciake atĩrĩ, “Thiiagai mbere yakwa, na mũtigithũkanie rũũru na rũũru rũrĩa rũngĩ.”<verse eid="GEN 32:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 32:17" />Ningĩ agĩtaara ũrĩa wamatongoretie, akĩmwĩra atĩrĩ, “Rĩrĩa mũrũ wa maitũ Esaũ arĩgũtũnga na akũũrie atĩrĩ, ‘Wee ũrĩ waũ? Na wathiĩ kũ? Na ũhiũ ũyũ wothe ũrĩ mbere yaku nĩ waũ?’ <verse eid="GEN 32:17" /><verse number="18" style="v" sid="GEN 32:18" />Nawe nĩũrĩmũcookeria ũmwĩre atĩrĩ, ‘Nĩ cia ndungata yaku Jakubu. Nĩ kĩheo gĩa kũhe mwathi wakwa Esaũ, na Jakubu arĩ thuutha witũ agĩũka.’ ”<verse eid="GEN 32:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 32:19" />Agĩcooka agĩtaara wa keerĩ na wa gatatũ, na arĩa othe marũmagĩrĩra ndũũru icio, akĩmeera atĩrĩ, “Ũguo nĩguo mũrĩĩraga Esaũ mwamũtũnga. <verse eid="GEN 32:19" /><verse number="20" style="v" sid="GEN 32:20" />Na mũtikanaage kũmwĩra atĩrĩ, ‘Jakubu ndungata yaku arĩ thuutha witũ agĩũka.’ ” Tondũ eeciiririe atĩrĩ, “Ngũmũhooreria na iheo ici ngũtũma mbere yakwa; thuutha-inĩ ndamuona-rĩ, hihi ahota kũnyamũkĩra.” <verse eid="GEN 32:20" /><verse number="21" style="v" sid="GEN 32:21" />Nĩ ũndũ ũcio iheo icio Jakubu aaheanĩte igĩthiiaga mbere yake, nowe akĩraara kũu kambĩ ũtukũ ũcio.<verse eid="GEN 32:21" /></para>
  <para style="s1">Jakubu Kũgiana na Ngai</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 32:22" />Na ũtukũ o ro ũcio, Jakubu agĩũkĩra, akĩoya atumia ake eerĩ, na ndungata iria igĩrĩ cia andũ-a-nja, na ariũ ake ikũmi na ũmwe, na akĩmaringĩria iringĩro rĩa Jaboku. <verse eid="GEN 32:22" /><verse number="23" style="v" sid="GEN 32:23" />Aarĩkia kũmaringia, akĩringia indo iria ciothe aarĩ nacio. <verse eid="GEN 32:23" /><verse number="24" style="v" sid="GEN 32:24" />Nake Jakubu agĩtigwo arĩ o wiki, na hagĩũka mũndũ maagianire nake o nginya gũgĩthererũka. <verse eid="GEN 32:24" /><verse number="25" style="v" sid="GEN 32:25" />Na rĩrĩa mũndũ ũcio onire atĩ ndangĩmũhoota-rĩ, akĩmũhutia ihĩndĩ rĩa gĩtina gĩa kũgũrũ, nakuo kũgũrũ kwa Jakubu gũgĩthenyũkĩra hau gĩtina-inĩ, o makĩgianaga na mũndũ ũcio. <verse eid="GEN 32:25" /><verse number="26" style="v" sid="GEN 32:26" />Na mũndũ ũcio akĩmwĩra atĩrĩ, “Reke ndĩthiĩre tondũ nĩ gwathererũka.”</para>
  <para style="p" vid="GEN 32:26">No Jakubu akĩmũcookeria, akĩmwĩra atĩrĩ, “Ndingĩreka ũthiĩ ũtandathimĩte.”<verse eid="GEN 32:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 32:27" />Nake mũndũ ũcio akĩmũũria atĩrĩ, “Wĩtagwo atĩa?”</para>
  <para style="p" vid="GEN 32:27">Jakubu akĩmũcookeria atĩrĩ, “Njĩtagwo Jakubu.”<verse eid="GEN 32:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 32:28" />Ningĩ mũndũ ũcio akĩmwĩra atĩrĩ, “Ndũgũcooka gwĩtwo Jakubu, no ũrĩĩtagwo Isiraeli, tondũ nĩũgianĩte na Ngai o na andũ, na ũkahootana.”<verse eid="GEN 32:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 32:29" />Jakubu akĩmwĩra atĩrĩ, “Ndagũthaitha, njĩĩra rĩĩtwa rĩaku.”</para>
  <para style="p" vid="GEN 32:29">Nowe akĩmũcookeria atĩrĩ, “Ũranjũũria rĩĩtwa rĩakwa nĩkĩ?” Agĩcooka akĩmũrathima marĩ o hau.<verse eid="GEN 32:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 32:30" />Nĩ ũndũ ũcio Jakubu agĩĩta handũ hau Penieli, akiuga atĩrĩ, “Tondũ nĩnyonete Ngai ũthiũ kwa ũthiũ, na akahonokia muoyo wakwa.”<verse eid="GEN 32:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 32:31" />Narĩo riũa rĩkĩmũrathĩra akĩhĩtũka hau Penieli, na nĩathuaga nĩ ũndũ nĩathenyũkĩtwo nĩ ihĩndĩ rĩa gĩtina gĩa kũgũrũ. <verse eid="GEN 32:31" /><verse number="32" style="v" sid="GEN 32:32" />Nĩ tondũ ũcio, nginyagia ũmũthĩ ũyũ andũ a Isiraeli matirĩĩaga mũkiha ũrĩa ũnyiitanĩte na ihĩndĩ rĩa gĩtina gĩa kũgũrũ, tondũ ihĩndĩ rĩa gĩtina gĩa kũgũrũ kwa Jakubu rĩahutĩirio hakuhĩ na mũkiha ũcio.<verse eid="GEN 32:32" /></para>
  <chapter eid="GEN 32" />
  <chapter number="33" style="c" sid="GEN 33" />
  <para style="s1">Jakubu Gũtũngana na Esaũ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 33:1" />Na rĩrĩ, Jakubu agĩtiira maitho, akĩona Esaũ agĩũka arĩ na andũ ake magana mana; nĩ ũndũ ũcio akĩgayania ciana kũrĩ Lea na Rakeli na kũrĩ ndungata iria igĩrĩ cia andũ-a-nja. <verse eid="GEN 33:1" /><verse number="2" style="v" sid="GEN 33:2" />Akĩiga ndungata cia andũ-a-nja na ciana ciacio mbere, nake Lea na ciana ciake makĩrũmĩrĩra, nake Rakeli na Jusufu makĩrigia thuutha. <verse eid="GEN 33:2" /><verse number="3" style="v" sid="GEN 33:3" />Nake we mwene akĩmatongoria, na rĩrĩa aakuhĩrĩirie mũrũ wa nyina, akĩinamĩrĩra, agĩturumithia ũthiũ wake thĩ maita mũgwanja.<verse eid="GEN 33:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 33:4" />No Esaũ akĩhanyũka agatũnge Jakubu na akĩmũnyiita, akĩmũhĩmbĩria, akĩmũmumunya. Nao makĩrĩranĩra. <verse eid="GEN 33:4" /><verse number="5" style="v" sid="GEN 33:5" />Ningĩ Esaũ agĩtiira maitho akĩona atumia na ciana. Akĩũria Jakubu atĩrĩ, “Andũ aya mũrĩ nao nĩ a ũ?”</para>
  <para style="p" vid="GEN 33:5">Jakubu agĩcookia atĩrĩ, “Ici nĩ ciana iria Ngai aheete ndungata yaku nĩ ũndũ wa ũtugi wake.”<verse eid="GEN 33:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 33:6" />Hĩndĩ ĩyo ndungata icio cia andũ-a-nja na ciana ciacio igĩkuhĩrĩria na makĩinamĩrĩra. <verse eid="GEN 33:6" /><verse number="7" style="v" sid="GEN 33:7" />Lea na ciana ciake makĩrũmĩrĩra, magĩũka na makĩinamĩrĩra. Marigĩrĩrio, Jusufu na Rakeli magĩũka, o nao makĩinamĩrĩra.<verse eid="GEN 33:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 33:8" />Esaũ akĩũria atĩrĩ, “Nĩ kĩĩ gĩtũmi gĩa kũndũmĩra ikundi icio ndatũnga?”</para>
  <para style="p" vid="GEN 33:8">Nake Jakubu agĩcookia atĩrĩ, “Nĩgeetha njĩtĩkĩrĩke maitho-inĩ maku, wee mwathi wakwa.”<verse eid="GEN 33:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 33:9" />No Esaũ akiuga atĩrĩ, “Mũrũ wa maitũ, niĩ ndĩ na indo cia kũnjigana. Ikara na icio ũrĩ nacio wee mwene.”<verse eid="GEN 33:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 33:10" />Jakubu akiuga atĩrĩ, “Aca, ndagũthaitha! Angĩkorwo nĩnjĩtĩkĩrĩkĩte maitho-inĩ maku-rĩ, amũkĩra kĩheo gĩkĩ kuuma kũrĩ niĩ. Nĩ ũndũ kuona ũthiũ waku no ta kuona ũthiũ wa Ngai, tondũ nĩ wanyamũkĩra na gĩkeno. <verse eid="GEN 33:10" /><verse number="11" style="v" sid="GEN 33:11" />Ndagũthaitha ĩtĩkĩra kĩheo kĩu ũreheirwo, tondũ Ngai nĩanjĩkĩte wega, na ndĩ na indo cia kũnjigana.” Na tondũ Jakubu nĩamũringĩrĩirie-rĩ, Esaũ agĩciĩtĩkĩra.<verse eid="GEN 33:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 33:12" />Ningĩ Esaũ akĩmwĩra atĩrĩ, “Nĩtũthiĩ; nĩngũtwarana nawe.”<verse eid="GEN 33:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 33:13" />No Jakubu akĩmwĩra atĩrĩ, “Mwathi wakwa nĩoĩ atĩ twana tũtũ tũtirĩ na hinya, na no nginya menyerere ngʼondu na ngʼombe iria irongithia. Ingĩtwarwo na ihenya o na mũthenya ũmwe, nyamũ ciothe no ikue. <verse eid="GEN 33:13" /><verse number="14" style="v" sid="GEN 33:14" />Nĩ ũndũ ũcio mwathi wakwa nĩathiiage mbere ya ndungata yake, na niĩ thiĩ o kahora kũringana na mũthiĩre wa ikundi ici, o na wa ciana, nginya rĩrĩa ngaakinya kwa mwathi wakwa kũu Seiru.”<verse eid="GEN 33:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 33:15" />Esaũ akĩmwĩra atĩrĩ, “No kĩreke ngũtigĩre ndungata imwe ciakwa.”</para>
  <para style="p" vid="GEN 33:15">Jakubu akĩmũũria atĩrĩ, “Ũgwĩka ũguo nĩkĩ? Reke niĩ njĩtĩkĩrĩke maitho-inĩ ma mwathi wakwa.”<verse eid="GEN 33:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 33:16" />Nĩ ũndũ ũcio Esaũ akĩhũndũka mũthenya o ro ũcio agĩthiĩ arorete Seiru. <verse eid="GEN 33:16" /><verse number="17" style="v" sid="GEN 33:17" />Nowe Jakubu, agĩthiĩ Sukothu, kũrĩa eyakĩire nyũmba, na agĩthondeka ciugũ cia mahiũ make. Nĩkĩo handũ hau hetagwo Sukothu.<verse eid="GEN 33:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 33:18" />Thuutha wa Jakubu kuuma Padani-Aramu, agĩkinya o wega itũũra-inĩ rĩrĩa inene rĩa Shekemu kũu Kaanani, na akĩamba hema hakuhĩ na itũũra rĩu inene. <verse eid="GEN 33:18" /><verse number="19" style="v" sid="GEN 33:19" />Nake akĩgũra gĩcunjĩ kĩa mũgũnda na betha igana rĩmwe kuuma kũrĩ ariũ a Hamoru ithe wa Shekemu, harĩa aambire hema yake. <verse eid="GEN 33:19" /><verse number="20" style="v" sid="GEN 33:20" />Agĩaka kĩgongona handũ hau, na agĩgĩĩta Eli-Elohe-Isiraeli.<verse eid="GEN 33:20" /></para>
  <chapter eid="GEN 33" />
  <chapter number="34" style="c" sid="GEN 34" />
  <para style="s1">Dina na Andũ na Shekemu</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 34:1" />Na rĩrĩ, mũthenya ũmwe, Dina mũirĩtu ũrĩa Lea aaciarĩire Jakubu, nĩathiire gũceerera andũ-a-nja a bũrũri ũcio. <verse eid="GEN 34:1" /><verse number="2" style="v" sid="GEN 34:2" />Na rĩrĩa Shekemu mũrũ wa Hamoru ũrĩa Mũhivi, mũnene wa gĩcigo kĩu aamuonire, akĩmũnyiita, agĩkoma nake na hinya. <verse eid="GEN 34:2" /><verse number="3" style="v" sid="GEN 34:3" />Na ngoro yake ĩkĩguucĩrĩrio nĩ Dina mwarĩ ũcio wa Jakubu, na akĩenda mũirĩtu ũcio na akĩmwarĩria wega. <verse eid="GEN 34:3" /><verse number="4" style="v" sid="GEN 34:4" />Nake Shekemu akĩĩra ithe Hamoru atĩrĩ, “Njarĩrĩria harĩ ithe wa mũirĩtu ũyũ atuĩke mũtumia wakwa.”<verse eid="GEN 34:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 34:5" />Rĩrĩa Jakubu aiguire atĩ mwarĩ Dina nĩarĩkĩtie gũthũkio-rĩ, na tondũ ariũ ake maarĩ gĩthaka-inĩ na mahiũ make, agĩkira na ũhoro ũcio o nginya rĩrĩa mainũkire.<verse eid="GEN 34:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 34:6" />Hĩndĩ ĩyo Hamoru ithe wa Shekemu agĩthiĩ kwaria na Jakubu. <verse eid="GEN 34:6" /><verse number="7" style="v" sid="GEN 34:7" />Nao ariũ a Jakubu nĩmainũkĩte kuuma mĩgũnda-inĩ maigua ũrĩa gwekĩkĩte. Nao makĩiyũrwo nĩ kĩeha na mangʼũrĩ, tondũ Shekemu nĩekĩte ũndũ wa thoni thĩinĩ wa Isiraeli, nĩ gũkoma na mwarĩ wa Jakubu, ũndũ ũrĩa ũtagĩrĩirwo nĩ gwĩkwo.<verse eid="GEN 34:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 34:8" />No Hamoru akĩmeera atĩrĩ, “Ngoro ya mũrũ wakwa Shekemu nĩĩguucĩrĩirio nĩ mwarĩ wanyu. Ndamũthaitha ĩtĩkĩrai amũhikie atuĩke mũtumia wake. <verse eid="GEN 34:8" /><verse number="9" style="v" sid="GEN 34:9" />Rekei tũhikanagie; mũtũheage airĩtu anyu na inyuĩ tũkamũheaga airĩtu aitũ. <verse eid="GEN 34:9" /><verse number="10" style="v" sid="GEN 34:10" />Inyuĩ no mũtũũre hamwe na ithuĩ; bũrũri ũyũ gũtirĩ handũ mũrigĩrĩirio. Tũũrai kuo, mwonjorithagie kuo, na mwĩgĩĩre na indo ciaguo.”<verse eid="GEN 34:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 34:11" />Ningĩ Shekemu akĩĩra ithe wa Dina na ariũ a ithe atĩrĩ, “Rekei njĩtĩkĩrĩke maitho-inĩ manyu na nĩngũmũhe o kĩrĩa gĩothe mũngĩnjĩtia. <verse eid="GEN 34:11" /><verse number="12" style="v" sid="GEN 34:12" />Njĩtiai rũracio rwa mũhiki na kĩheo kĩrĩa ingĩrehe, o mũigana ũrĩa mũngĩenda, na nĩngũrĩha o kĩrĩa gĩothe mũngĩnjĩtia. No ndamũthaitha mũũhe mũirĩtu ũyũ atuĩke mũtumia wakwa.”<verse eid="GEN 34:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 34:13" />Na tondũ mwarĩ wa nyina Dina nĩarĩkĩtie gũthũkio-rĩ, ariũ a Jakubu rĩrĩa maaragia na Shekemu na ithe Hamoru, magĩcookia ũhoro ũcio na njĩra ya maheeni. <verse eid="GEN 34:13" /><verse number="14" style="v" sid="GEN 34:14" />Makĩmeera atĩrĩ, “Tũtingĩĩka ũndũ ta ũcio; tũtingĩheana mwarĩ witũ kũrĩ mũndũ ũtarĩ mũruu. Ũndũ ũcio no ũtuĩke wa gũtũnyararithia. <verse eid="GEN 34:14" /><verse number="15" style="v" sid="GEN 34:15" />Tũkũmwĩtĩkĩria tondũ wa gĩtũmi o kĩmwe tu; inyuĩ mũtuĩke ta ithuĩ na ũndũ wa kũruithia arũme anyu othe. <verse eid="GEN 34:15" /><verse number="16" style="v" sid="GEN 34:16" />Hĩndĩ ĩyo nĩmũrĩhikagia airĩtu aitũ na nĩtũrĩhikagia airĩtu anyu. Nĩtũgũtũũrania na inyuĩ na tũtuĩke andũ amwe. <verse eid="GEN 34:16" /><verse number="17" style="v" sid="GEN 34:17" />No angĩkorwo mũtigwĩtĩkĩra kũrua-rĩ, tũkuoya mwarĩ witũ twĩthiĩre.”<verse eid="GEN 34:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 34:18" />Ũhoro ũcio ũkĩoneka ũrĩ mwega nĩ Hamoru na mũriũ Shekemu. <verse eid="GEN 34:18" /><verse number="19" style="v" sid="GEN 34:19" />Tondũ nĩwe warĩ mũtĩĩe mũno kũrĩ andũ othe a nyũmba ya ithe, mwanake ũcio ndaateire ihinda rĩa gwĩka ũrĩa moigire, tondũ nĩakenetio nĩ mwarĩ wa Jakubu. <verse eid="GEN 34:19" /><verse number="20" style="v" sid="GEN 34:20" />Nĩ ũndũ ũcio Hamoru na mũriũ Shekemu magĩthiĩ kĩhingo-inĩ gĩa itũũra rĩao inene makaarie na andũ ao a itũũra rĩu.<note caller="+" style="f"><char style="fr" closed="false">34:20 </char><char style="ft" closed="false">Kĩhingo-inĩ gĩa itũũra nĩho athuuri maacemanagia.</char></note> <verse eid="GEN 34:20" /><verse number="21" style="v" sid="GEN 34:21" />Nao makiuga atĩrĩ, “Andũ aya nĩ arata aitũ; rekei matũũre bũrũri-inĩ witũ na monjorithagie kuo; bũrũri ũyũ nĩ mũnene wa kũmaigana. Ithuĩ no tũhikie airĩtu ao, nao no mahikie airĩtu aitũ. <verse eid="GEN 34:21" /><verse number="22" style="v" sid="GEN 34:22" />No andũ acio mangĩtĩkĩra gũtũũrania na ithuĩ ta rũrĩrĩ rũmwe angĩkorwo arũme aitũ othe nĩmekũrua, o ta ũrĩa o maruĩte. <verse eid="GEN 34:22" /><verse number="23" style="v" sid="GEN 34:23" />Githĩ mahiũ mao, na indo ciao ciothe, o na nyamũ iria ingĩ ciao ciothe itigũgĩtuĩka ciitũ? Nĩ ũndũ ũcio rekei tũmetĩkĩre, na nĩ megũtũũrania na ithuĩ.”<verse eid="GEN 34:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 34:24" />Arũme arĩa othe maathiĩte kĩhingo-inĩ gĩa itũũra rĩu inene magĩĩtĩkania na Hamoru na mũriũ Shekemu, na arũme othe a itũũra rĩu makĩrua.<verse eid="GEN 34:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 34:25" />Thuutha wa mĩthenya ĩtatũ, hĩndĩ ĩrĩa othe maarĩ na ruo ariũ eerĩ a Jakubu, Simeoni na Lawi, ariũ a nyina na Dina, makĩoya hiũ ciao cia njora magĩtharĩkĩra itũũra rĩu hĩndĩ ĩrĩa rĩtekũũaga makĩũraga arũme othe. <verse eid="GEN 34:25" /><verse number="26" style="v" sid="GEN 34:26" />Ningĩ makĩũraga Hamoru na mũriũ Shekemu na rũhiũ rwa njora, na makĩruta Dina nyũmba-inĩ ya Shekemu, magĩĩthiĩra. <verse eid="GEN 34:26" /><verse number="27" style="v" sid="GEN 34:27" />Ariũ arĩa angĩ a Jakubu magĩkinya kũu ciimba ciarĩ, na magĩĩtahĩra indo cia itũũra rĩu mwarĩ wa ithe wao aathũkĩirio. <verse eid="GEN 34:27" /><verse number="28" style="v" sid="GEN 34:28" />Nao magĩtaha ndũũru cia mbũri na cia ngʼombe na ndigiri, na indo iria ingĩ ciao ciothe iria ciarĩ itũũra-inĩ rĩu inene, na iria ciarĩ mĩgũnda-inĩ. <verse eid="GEN 34:28" /><verse number="29" style="v" sid="GEN 34:29" />Na magĩkuua ũtonga wothe wa itũũra, na atumia othe na ciana, magĩtaha indo ciothe iria ciarĩ nyũmba-inĩ icio.<verse eid="GEN 34:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 34:30" />Nake Jakubu akĩĩra Simeoni na Lawi atĩrĩ, “Nĩmwandehera thĩĩna nĩ ũndũ wa gũtũma menwo nĩ Akaanani na Aperizi, andũ arĩa matũũraga bũrũri ũyũ. Ithuĩ tũrĩ anini tũgĩtarwo, na mangĩnyiitana manjũkĩrĩre na matharĩkĩre-rĩ, niĩ na nyũmba yakwa no tũniinwo.”<verse eid="GEN 34:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 34:31" />Nao makĩmũcookeria atĩrĩ, “Nĩkũraagĩrĩire atue mwarĩ wa maitũ ta mũmaraya?”<verse eid="GEN 34:31" /></para>
  <chapter eid="GEN 34" />
  <chapter number="35" style="c" sid="GEN 35" />
  <para style="s1">Jakubu Gũcooka Betheli</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 35:1" />Thuutha wa ũguo Ngai akĩĩra Jakubu atĩrĩ, “Ambata, ũthiĩ Betheli ũgatũũre kuo, na wakĩre Ngai kĩgongona kuo, o we ũrĩa wakuumĩrĩire rĩrĩa woragĩra mũrũ wa nyũkwa Esaũ.”<verse eid="GEN 35:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 35:2" />Nĩ ũndũ ũcio Jakubu akĩĩra andũ a nyũmba yake, na arĩa othe maarĩ nao, atĩrĩ, “Eheriai ngai cia mĩhianano iria mũrĩ nacio, na mwĩtherie inyuĩ ene, na mwĩkĩre nguo ingĩ. <verse eid="GEN 35:2" /><verse number="3" style="v" sid="GEN 35:3" />Mũcooke mũũkĩre, mũreke tũthiĩ twambate Betheli, ngaakĩre Ngai kĩgongona kuo, ũrĩa wanjĩtĩkire mũthenya ũrĩa ndaarĩ thĩĩna-inĩ, na ũrĩa ũkoretwo na niĩ kũrĩa guothe ndanathiĩ.” <verse eid="GEN 35:3" /><verse number="4" style="v" sid="GEN 35:4" />Nĩ ũndũ ũcio makĩnengera Jakubu ngai cia mĩhianano iria maarĩ nacio, na irengeeri iria ciarĩ matũ mao,<note caller="+" style="f"><char style="fr" closed="false">35:4 </char><char style="ft" closed="false">Irengeeri cia matũ ciahũthagĩrwo irĩ ta njĩra ya kũgitĩra mũndũ.</char></note> nake Jakubu agĩcithika gĩtina-inĩ kĩa mũgandi kũu Shekemu. <verse eid="GEN 35:4" /><verse number="5" style="v" sid="GEN 35:5" />Nao makiumagara, magĩĩthiĩra, namo matũũra marĩa maamathiũrũrũkĩirie makĩnyiitwo nĩ guoya wa Ngai, nĩ ũndũ ũcio gũtirĩ o na ũmwe wamaingatithirie.<verse eid="GEN 35:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 35:6" />Jakubu na andũ arĩa othe aarĩ nao magĩkinya Luzu (na nĩkuo Betheli), bũrũri-inĩ wa Kaanani. <verse eid="GEN 35:6" /><verse number="7" style="v" sid="GEN 35:7" />Agĩaka kĩgongona kũu, na agĩĩta handũ hau Eli-Betheli, tondũ hau nĩho Ngai aamwĩguũrĩirie rĩrĩa ooragĩra mũrũ wa nyina.<verse eid="GEN 35:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 35:8" />Nake Debora mũreri wa Rebeka agĩkua na agĩthikwo gĩtina-inĩ kĩa mũgandi mũhuro wa Betheli. Nĩ ũndũ ũcio handũ hau hagĩĩtwo Aloni-Bakuthu.<verse eid="GEN 35:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 35:9" />Thuutha wa Jakubu gũcooka kuuma Padani-Aramu, Ngai akĩmuumĩrĩra rĩngĩ na akĩmũrathima. <verse eid="GEN 35:9" /><verse number="10" style="v" sid="GEN 35:10" />Ngai akĩmwĩra atĩrĩ, “Rĩĩtwa rĩaku nĩ Jakubu, no ndũgũcooka gwĩtwo Jakubu rĩngĩ; ũrĩĩtagwo Isiraeli.” Nĩ ũndũ ũcio akĩmwĩta Isiraeli.<verse eid="GEN 35:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 35:11" />Nake Ngai akĩmwĩra atĩrĩ, “Niĩ nĩ niĩ Ngai Mwene-Hinya-Wothe; ciaranai na mũingĩhe. Rũrĩrĩ na gĩkundi kĩa ndũrĩrĩ nĩikoima harĩwe, na athamaki nĩmakoima mwĩrĩ-inĩ waku. <verse eid="GEN 35:11" /><verse number="12" style="v" sid="GEN 35:12" />Bũrũri ũrĩa niĩ ndaheire Iburahĩmu na Isaaka, o nawe nĩngakũhe guo, na nĩngaheana bũrũri ũyũ kũrĩ njiaro ciaku iria igooka thuutha waku.” <verse eid="GEN 35:12" /><verse number="13" style="v" sid="GEN 35:13" />Hĩndĩ ĩyo Ngai akĩambata akĩmweherera kuuma handũ hau aamwaragĩria.<verse eid="GEN 35:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 35:14" />Jakubu akĩhaanda gĩtugĩ kĩa ihiga handũ hau Ngai aarĩtie nake, agĩgĩitĩrĩria ndibei; agĩcooka agĩgĩitĩrĩria maguta. <verse eid="GEN 35:14" /><verse number="15" style="v" sid="GEN 35:15" />Jakubu agĩĩta handũ hau Ngai aamwarĩirie Betheli.<verse eid="GEN 35:15" /></para>
  <para style="s1">Gĩkuũ kĩa Rakeli na kĩa Isaaka</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 35:16" />Thuutha ũcio Jakubu na andũ ake makiuma Betheli magĩthiĩ na mbere na rũgendo. Na matigairie hanini makinye Efiratha-rĩ, Rakeli akĩambĩrĩria kũrũmwo na agĩkorwo arĩ na thĩĩna mũingĩ mũno. <verse eid="GEN 35:16" /><verse number="17" style="v" sid="GEN 35:17" />Na tondũ aarĩ na thĩĩna mũingĩ mũno wa gũciara, mũmũciarithia akĩmwĩra atĩrĩ, “Tiga gwĩtigĩra, tondũ ũrĩ na kahĩĩ kangĩ.” <verse eid="GEN 35:17" /><verse number="18" style="v" sid="GEN 35:18" />Na atanatuĩkana, tondũ nĩ gũkua aakuaga, agĩtua kahĩĩ kau Beni-Oni. No ithe agĩgatua Benjamini.<verse eid="GEN 35:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 35:19" />Nĩ ũndũ ũcio Rakeli agĩkua na agĩthikwo mũkĩra-inĩ wa njĩra ya gũthiĩ Efiratha (na nokuo Bethilehemu.) <verse eid="GEN 35:19" /><verse number="20" style="v" sid="GEN 35:20" />Jakubu akĩhaanda gĩtugĩ igũrũ rĩa mbĩrĩra yake, na nginya ũmũthĩ ũyũ gĩtugĩ kĩu nĩkĩo kĩonanagia mbĩrĩra ya Rakeli.<verse eid="GEN 35:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 35:21" />Isiraeli agĩthiĩ o na mbere na rũgendo na akĩamba hema yake mwena ũrĩa ũngĩ wa Migidali-Ederi. <verse eid="GEN 35:21" /><verse number="22" style="v" sid="GEN 35:22" />Hĩndĩ ĩyo Isiraeli aatũũraga bũrũri ũcio-rĩ, Rubeni agĩthiĩ, agĩkoma na Biliha, thuriya ya ithe, nake Isiraeli akĩigua ũhoro ũcio.</para>
  <para style="b" vid="GEN 35:22" />
  <para style="m" vid="GEN 35:22">Jakubu aarĩ na ariũ ikũmi na eerĩ:<verse eid="GEN 35:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="GEN 35:23" />Ariũ a Lea maarĩ:</para>
  <para style="li2" vid="GEN 35:23">Rubeni irigithathi rĩa Jakubu,</para>
  <para style="li2" vid="GEN 35:23">na Simeoni, na Lawi, na Juda, na Isakaru, na Zebuluni.<verse eid="GEN 35:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="GEN 35:24" />Ariũ a Rakeli maarĩ:</para>
  <para style="li2" vid="GEN 35:24">Jusufu na Benjamini.<verse eid="GEN 35:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="GEN 35:25" />Ariũ a Biliha ndungata ya mũirĩtu ya Rakeli maarĩ:</para>
  <para style="li2" vid="GEN 35:25">Dani na Nafitali.<verse eid="GEN 35:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="GEN 35:26" />Ariũ a Zilipa ndungata ya mũirĩtu ya Lea maarĩ:</para>
  <para style="li2" vid="GEN 35:26">Gadi na Asheri.</para>
  <para style="p" vid="GEN 35:26">Acio nĩo maarĩ ariũ a Jakubu, arĩa aaciarĩirwo arĩ kũu Padani-Aramu.<verse eid="GEN 35:26" /></para>
  <para style="b" />
  <para style="p">
    <verse number="27" style="v" sid="GEN 35:27" />Na Jakubu agĩkinya mũciĩ kũrĩ ithe Isaaka kũu Mamure, hakuhĩ na Kiriathu-Ariba (nĩkuo Hebironi), kũrĩa Iburahĩmu na Isaaka maatũũrĩte. <verse eid="GEN 35:27" /><verse number="28" style="v" sid="GEN 35:28" />Isaaka aatũũrire muoyo mĩaka igana na mĩrongo ĩnana. <verse eid="GEN 35:28" /><verse number="29" style="v" sid="GEN 35:29" />Agĩcooka agĩtuĩkana agĩkua na agĩthikwo hamwe na andũ ao arĩa maakuĩte, arĩ mũkũrũ na arĩ na mĩaka mĩingĩ. Nao ariũ ake Esaũ na Jakubu makĩmũthika.<verse eid="GEN 35:29" /></para>
  <chapter eid="GEN 35" />
  <chapter number="36" style="c" sid="GEN 36" />
  <para style="s1">Njiaro cia Esaũ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 36:1" />Na rĩrĩ, ũyũ nĩguo ũhoro wa Esaũ (na nowe Edomu).<verse eid="GEN 36:1" /></para>
  <para style="b" />
  <para style="pi">
    <verse number="2" style="v" sid="GEN 36:2" />Esaũ ahikirie atumia ake kuuma kũrĩ andũ-a-nja a Kaanani: Ada aarĩ mwarĩ wa Eloni ũrĩa Mũhiti, na Oholibama mwarĩ wa Ana ũrĩa warĩ mwarĩ wa Zibeoni ũrĩa Mũhivi, <verse eid="GEN 36:2" /><verse number="3" style="v" sid="GEN 36:3" />o na ningĩ Basemathu ũrĩa warĩ mwarĩ wa Ishumaeli na mwarĩ wa nyina na Nebaiothu.<verse eid="GEN 36:3" /></para>
  <para style="pi">
    <verse number="4" style="v" sid="GEN 36:4" />Ada agĩciarĩra Esaũ Elifazu, na Basemathu agĩciara Reueli, <verse eid="GEN 36:4" /><verse number="5" style="v" sid="GEN 36:5" />nake Oholibama agĩciara Jeushu, na Jalamu na Kora. Acio nĩo maarĩ ariũ a Esaũ, arĩa aaciarĩirwo kũu Kaanani.<verse eid="GEN 36:5" /></para>
  <para style="pi">
    <verse number="6" style="v" sid="GEN 36:6" />Na rĩrĩ, Esaũ akĩoya atumia ake na ariũ ake na airĩtu ake na andũ othe a nyũmba yake, o na mahiũ make na nyamũ iria ingĩ ciake, na indo ciothe iria aagĩte nacio kũu Kaanani, na agĩthiĩ bũrũri waraihanĩrĩirie na mũrũ wa nyina Jakubu. <verse eid="GEN 36:6" /><verse number="7" style="v" sid="GEN 36:7" />Indo ciao ciarĩ nyingĩ mũno ũndũ matangĩahotire gũikarania hamwe; bũrũri ũrĩa maatũũraga ndũngĩahotire kũmaigana eerĩ nĩ ũndũ wa mahiũ mao. <verse eid="GEN 36:7" /><verse number="8" style="v" sid="GEN 36:8" />Nĩ ũndũ ũcio Esaũ (na nowe Edomu) agĩthiĩ gũtũũra bũrũri wa irĩma wa Seiru.<verse eid="GEN 36:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="GEN 36:9" />Ũyũ nĩguo ũhoro wa Esaũ ithe wa andũ a Edomu kũu bũrũri-inĩ wa irĩma wa Seiru.<verse eid="GEN 36:9" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="10" style="v" sid="GEN 36:10" />Maya nĩmo marĩĩtwa ma ariũ a Esaũ:</para>
  <para style="li2" vid="GEN 36:10">nĩ Elifazu, mũrũ wa Ada mũtumia wa Esaũ, na Reueli, mũrũ wa Basemathu mũtumia wa Esaũ.<verse eid="GEN 36:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="GEN 36:11" />Ariũ a Elifazu nĩ aya:</para>
  <para style="li2" vid="GEN 36:11">nĩ Temani, na Omari, na Zefo, na Gatamu, na Kenazu.<verse eid="GEN 36:11" /></para>
  <para style="li2">
    <verse number="12" style="v" sid="GEN 36:12" />Elifazu mũrũ wa Esaũ o nake nĩ aarĩ na thuriya yetagwo Timina, ĩrĩa yamũciarĩire Amaleki. Acio nĩo maarĩ ariũ a mũrũ wa Ada mũtumia wa Esaũ.<verse eid="GEN 36:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="GEN 36:13" />Ariũ a Reueli nĩ aya:</para>
  <para style="li2" vid="GEN 36:13">nĩ Nahathu, na Zera, na Shama, na Miza. Acio nĩo maarĩ ariũ a mũrũ wa Basemathu mũtumia wa Esaũ.<verse eid="GEN 36:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="GEN 36:14" />Ariũ a Esaũ arĩa aaciarĩirwo nĩ Oholibama mũtumia wake mwarĩ wa Ana ũrĩa warĩ mwarĩ wa Zibeoni:</para>
  <para style="li2" vid="GEN 36:14">nĩ Jeushu, na Jalamu, na Kora.<verse eid="GEN 36:14" /></para>
  <para style="b" />
  <para style="p">
    <verse number="15" style="v" sid="GEN 36:15" />Nao aya nĩo maarĩ anene thĩinĩ wa njiaro cia Esaũ:</para>
  <para style="li1" vid="GEN 36:15">Ariũ a Elifazu irigithathi rĩa Esaũ:</para>
  <para style="li2" vid="GEN 36:15">Anene maarĩ Temani, na Omari, na Zefo, na Kenazu, <verse eid="GEN 36:15" /><verse number="16" style="v" sid="GEN 36:16" />na Kora, na Gatamu, na Amaleki. Acio nĩo anene arĩa Elifazu aaciarĩire kũu Edomu; maarĩ a mũrũ wa Ada.<verse eid="GEN 36:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="GEN 36:17" />Ariũ a Reueli mũrũ wa Esaũ:</para>
  <para style="li2" vid="GEN 36:17">Anene maarĩ Nahathu, na Zera, na Shama, na Miza. Aya nĩo anene arĩa Reueli aaciarĩire kũu Edomu; maarĩ a mũrũ wa Basemathu mũtumia wa Esaũ.<verse eid="GEN 36:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="GEN 36:18" />Ariũ a Oholibama mũtumia wa Esaũ:</para>
  <para style="li2" vid="GEN 36:18">Anene maarĩ Jeushu, na Jalamu, na Kora. Aya nĩo anene arĩa maaciarirwo nĩ Oholibama mũtumia wa Esaũ mwarĩ wa Ana.<verse eid="GEN 36:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 36:19" />Aya nĩo maarĩ ariũ a Esaũ (na nowe Edomu), na acio nĩo maarĩ anene ao.<verse eid="GEN 36:19" /></para>
  <para style="b" />
  <para style="p">
    <verse number="20" style="v" sid="GEN 36:20" />Aya nĩo maarĩ ariũ a Seiru ũrĩa Mũhori arĩa maatũũraga bũrũri ũcio:</para>
  <para style="li2" vid="GEN 36:20">Lotani, na Shobali, na Zibeoni, na Ana, <verse eid="GEN 36:20" /><verse number="21" style="v" sid="GEN 36:21" />na Dishoni, na Ezeri, na Dishani. Ariũ acio a Seiru nĩo maarĩ anene a Ahori kũu Edomu.<verse eid="GEN 36:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="GEN 36:22" />Ariũ a Lotani maarĩ:</para>
  <para style="li2" vid="GEN 36:22">Hori, na Homani. Timina aarĩ mwarĩ wa nyina na Lotani.<verse eid="GEN 36:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="GEN 36:23" />Ariũ a Shobali maarĩ:</para>
  <para style="li2" vid="GEN 36:23">Alivani, na Manahathu, na Ebali, na Shefo, na Onamu.<verse eid="GEN 36:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="GEN 36:24" />Ariũ a Zibeoni maarĩ:</para>
  <para style="li2" vid="GEN 36:24">Aia, na Ana. Ũyũ nĩwe Ana ũrĩa wonire ithima cia maaĩ mahiũ werũ-inĩ rĩrĩa arĩithagia ndigiri cia ithe Zibeoni.<verse eid="GEN 36:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="GEN 36:25" />Ciana cia Ana ciarĩ:</para>
  <para style="li2" vid="GEN 36:25">Dishoni, na Oholibama mwarĩ wa Ana.<verse eid="GEN 36:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="GEN 36:26" />Ariũ a Dishoni maarĩ:</para>
  <para style="li2" vid="GEN 36:26">Hemudani, na Eshibani, na Itharani, na Cherani.<verse eid="GEN 36:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="GEN 36:27" />Ariũ a Ezeri maarĩ:</para>
  <para style="li2" vid="GEN 36:27">Bilihani, na Zaavani, na Akani.<verse eid="GEN 36:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="GEN 36:28" />Ariũ a Dishani maarĩ</para>
  <para style="li2" vid="GEN 36:28">Uzu, na Arani.<verse eid="GEN 36:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="GEN 36:29" />Aya nĩo maarĩ anene a Ahori:</para>
  <para style="li2" vid="GEN 36:29">nĩ Lotani, na Shobali, na Zibeoni, na Ana, <verse eid="GEN 36:29" /><verse number="30" style="v" sid="GEN 36:30" />na Dishoni, na Ezeri, na Dishani. Acio nĩo maarĩ anene a Ahori, kũringana na ikundi ciao kũu bũrũri wa Seiru.<verse eid="GEN 36:30" /></para>
  <para style="s1">Aathani a Edomu</para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 36:31" />Aya nĩo maarĩ athamaki arĩa maathamakaga Edomu o mbere ya Isiraeli gũtanagĩa na mũthamaki o na ũmwe:<verse eid="GEN 36:31" /></para>
  <para style="li2">
    <verse number="32" style="v" sid="GEN 36:32" />Bela mũrũ wa Beori nĩwe watuĩkire mũthamaki wa Edomu. Itũũra rĩake inene rĩetagwo Dinihaba.<verse eid="GEN 36:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="GEN 36:33" />Rĩrĩa Bela aakuire, Jobabu mũrũ wa Zera wa kuuma Bozira agĩtuĩka mũthamaki ithenya rĩake.<verse eid="GEN 36:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="GEN 36:34" />Rĩrĩa Jobabu aakuire, Hushamu wa kuuma bũrũri wa Atemani agĩtuĩka mũthamaki ithenya rĩake.<verse eid="GEN 36:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="GEN 36:35" />Rĩrĩa Hushamu aakuire, Hadadi mũrũ wa Bedadi, ũrĩa wahootire Midiani kũu bũrũri wa Moabi, agĩtuĩka mũthamaki ithenya rĩake. Itũũra rĩake inene rĩetagwo Avithu.<verse eid="GEN 36:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="GEN 36:36" />Rĩrĩa Hadadi aakuire, Samala wa kuuma Masereka agĩtuĩka mũthamaki ithenya rĩake.<verse eid="GEN 36:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="GEN 36:37" />Rĩrĩa Samala aakuire, Shauli wa kuuma Rehobothu, kũu gũkuhĩ na Rũũĩ rwa Farati, agĩtuĩka mũthamaki ithenya rĩake.<verse eid="GEN 36:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="GEN 36:38" />Rĩrĩa Shauli aakuire, Baali-Hanani mũrũ wa Akibori agĩtuĩka mũthamaki ithenya rĩake.<verse eid="GEN 36:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="GEN 36:39" />Rĩrĩa Baali-Hanani mũrũ wa Akibori aakuire, Hadadi agĩtuĩka mũthamaki ithenya rĩake. Itũũra rĩake inene rĩetagwo Pau, na mũtumia wake eetagwo Mehetabeli mwarĩ wa Matiredi, ũrĩa warĩ mwarĩ wa Mezahabu.<verse eid="GEN 36:39" /></para>
  <para style="b" />
  <para style="p">
    <verse number="40" style="v" sid="GEN 36:40" />Aya nĩo maarĩ anene kuuma kũrĩ njiaro cia Esaũ, kũringana na marĩĩtwa mao, na mĩhĩrĩga, na ngʼongo ciao:</para>
  <para style="mi" vid="GEN 36:40">Timina, na Aliva, na Jethethu, <verse eid="GEN 36:40" /><verse number="41" style="v" sid="GEN 36:41" />na Oholibama, na Ela, na Pinoni, <verse eid="GEN 36:41" /><verse number="42" style="v" sid="GEN 36:42" />na Kenazu, na Temani, na Mibizaru, <verse eid="GEN 36:42" /><verse number="43" style="v" sid="GEN 36:43" />na Magidieli, na Iramu. Acio nĩo maarĩ anene a Edomu, kũringana na kũrĩa maatũũraga bũrũri-inĩ ũrĩa watuĩkĩte wao.</para>
  <para style="b" vid="GEN 36:43" />
  <para style="p" vid="GEN 36:43">Esaũ ũcio nĩwe warĩ ithe wa andũ a Edomu.<verse eid="GEN 36:43" /></para>
  <chapter eid="GEN 36" />
  <chapter number="37" style="c" sid="GEN 37" />
  <para style="s1">Irooto cia Jusufu</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 37:1" />Jakubu nĩatũũrire bũrũri-inĩ ũrĩa ithe aaikarĩte, nĩguo bũrũri wa Kaanani.<verse eid="GEN 37:1" /></para>
  <para style="b" />
  <para style="p">
    <verse number="2" style="v" sid="GEN 37:2" />Ũyũ nĩguo ũhoro wa Jakubu.</para>
  <para style="b" vid="GEN 37:2" />
  <para style="p" vid="GEN 37:2">Jusufu arĩ mwanake mũnini wa mĩaka ikũmi na mũgwanja aarĩithagia mbũri marĩ na ariũ a ithe, na ariũ a Biliha, na ariũ a Zilipa, atumia a ithe, nake agĩtwarĩra ithe wao ũhoro mũũru ũkoniĩ ariũ a ithe.<verse eid="GEN 37:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 37:3" />Na rĩrĩ, Isiraeli nĩendeete Jusufu gũkĩra ariũ arĩa angĩ ake othe, tondũ aamũciarire arĩ mũkũrũ; na nĩamũtumithĩirie kanjũ ya goro ngʼemie wega mũno. <verse eid="GEN 37:3" /><verse number="4" style="v" sid="GEN 37:4" />Na rĩrĩa ariũ a ithe moonire atĩ ithe nĩamwendete kũmakĩra-rĩ, makĩmũmena na matingĩamwarĩirie kiugo o na kĩmwe kĩega.<verse eid="GEN 37:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 37:5" />Ũtukũ ũmwe Jusufu nĩarootire kĩroto, na rĩrĩa eerire ariũ a ithe ũhoro wakĩo, makĩmũmena makĩria. <verse eid="GEN 37:5" /><verse number="6" style="v" sid="GEN 37:6" />Akĩmeera atĩrĩ, “Thikĩrĩriai ũhoro wa kĩroto gĩkĩ ndootete: <verse eid="GEN 37:6" /><verse number="7" style="v" sid="GEN 37:7" />Tũrohaga itĩĩa cia ngano tũrĩ mũgũnda-inĩ, na o rĩmwe gĩtĩĩa gĩakwa kĩrehaanda na igũrũ, nacio itĩĩa cianyu irathiũrũrũkĩria gĩakwa, na irakĩinamĩrĩra.”<verse eid="GEN 37:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 37:8" />Ariũ a ithe makĩmũũria atĩrĩ, “Anga nĩũrenda gũtũthamakĩra? Anga ti-itherũ nĩũgatwatha?” Nao magĩkĩrĩrĩria kũmũmena nĩ ũndũ wa kĩroto kĩu gĩake, na nĩ ũndũ wa ciugo ciake.<verse eid="GEN 37:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 37:9" />Ningĩ Jusufu akĩroota kĩroto kĩngĩ, na akĩĩra ariũ a ithe ũhoro wakĩo. Akĩmeera atĩrĩ, “Thikĩrĩriai, nĩndĩrarootire kĩroto kĩngĩ, na ihinda rĩĩrĩ, ndĩrarootire riũa, na mweri, na njata ikũmi na ĩmwe ikĩnyinamĩrĩra.”<verse eid="GEN 37:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 37:10" />Rĩrĩa eerire ithe o na ariũ a ithe ũhoro ũcio, ithe akĩmũkũma, akĩmũũria atĩrĩ, “Nĩ kĩroto kĩa mũthemba ũrĩkũ kĩu ũrotete? Anga nyũkwa, na niĩ, na ariũ a thoguo nĩtũgooka, na tũinamĩrĩre thĩ mbere yaku?” <verse eid="GEN 37:10" /><verse number="11" style="v" sid="GEN 37:11" />Ariũ a ithe nĩmamũiguĩrĩire ũiru, no ithe agĩikara agĩĩciiragia ũhoro wa irooto icio.<verse eid="GEN 37:11" /></para>
  <para style="s1">Jusufu kwendio nĩ Ariũ a Ithe</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 37:12" />Na rĩrĩ, ariũ a ithe nĩmathiĩte kũrĩithia mbũri cia ithe wao gũkuhĩ na Shekemu, <verse eid="GEN 37:12" /><verse number="13" style="v" sid="GEN 37:13" />nake Isiraeli akĩĩra Jusufu atĩrĩ, “O ta ũrĩa ũũĩ, ariũ a thoguo nĩmararĩithia mbũri gũkuhĩ na Shekemu. Ũka, nĩngũgũtũma kũrĩ o.”</para>
  <para style="p" vid="GEN 37:13">Nake akĩmũcookeria, akĩmwĩra atĩrĩ, “Ũguo noguo.”<verse eid="GEN 37:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 37:14" />Nĩ ũndũ ũcio Isiraeli akĩmwĩra atĩrĩ, “Thiĩ ũkarore kana ariũ a thoguo marĩ o ho o wega, o ũndũ ũmwe na mbũri, na ũnjookerie ũhoro.” Nake akĩmũtũma kuuma Gĩtuamba-inĩ kĩa Hebironi.</para>
  <para style="p" vid="GEN 37:14">Rĩrĩa Jusufu aakinyire Shekemu, <verse eid="GEN 37:14" /><verse number="15" style="v" sid="GEN 37:15" />mũndũ ũmwe akĩmuona akĩũrũũra mĩgũnda-inĩ, akĩmũũria atĩrĩ, “Nĩ kĩĩ ũracaria?”<verse eid="GEN 37:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 37:16" />Nake Jusufu agĩcookia atĩrĩ, “Nĩ ariũ a baba ndĩracaria. No ũnjĩĩre kũrĩa mararĩithia mbũri ciao?”<verse eid="GEN 37:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 37:17" />Mũndũ ũcio akĩmũcookeria atĩrĩ, “Nĩmoimĩte gũkũ. Ndĩraiguire makiuga atĩrĩ, ‘Rekei tũthiĩ Dothani.’ ”</para>
  <para style="p" vid="GEN 37:17">Nĩ ũndũ ũcio Jusufu akĩrũmĩrĩra ariũ a ithe, na akĩmakora hakuhĩ na Dothani. <verse eid="GEN 37:17" /><verse number="18" style="v" sid="GEN 37:18" />No makĩmuona arĩ haraaya, na ataanakinya harĩa maarĩ, magĩciirĩra kũmũũraga.<verse eid="GEN 37:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 37:19" />Makĩĩrana atĩrĩ, “Mũroti ũrĩa nĩokĩte! <verse eid="GEN 37:19" /><verse number="20" style="v" sid="GEN 37:20" />Ũkai; rekei tũmũũrage na tũmũikie irima rĩmwe rĩa maya, na tuuge atĩ nĩ nyamũ njũru ĩmũrĩĩte. Nĩtũkĩone ũrĩa irooto icio ciake ikaahinga.”<verse eid="GEN 37:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 37:21" />No rĩrĩa Rubeni aiguire ũguo, akĩgeria kũhonokia Jusufu kuuma moko-inĩ mao. Akiuga atĩrĩ, “Rekei tũtige kũmũũraga. <verse eid="GEN 37:21" /><verse number="22" style="v" sid="GEN 37:22" />Mũtigaite thakame. Mũikiei irima-inĩ rĩĩrĩ rĩ gũkũ werũ-inĩ, no mũtikamwĩke ũũru.” Rubeni oigaga ũguo nĩgeetha amũhonokie kuuma kũrĩ o, nĩguo amũcookie kũrĩ ithe.<verse eid="GEN 37:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 37:23" />Na rĩrĩa Jusufu aakinyire harĩ ariũ a ithe, makĩmũruta kanjũ yake ĩrĩa eekĩrĩte, o ĩrĩa yarĩ ya goro na ngʼemie wega mũno. <verse eid="GEN 37:23" /><verse number="24" style="v" sid="GEN 37:24" />Makĩmũnyiita, makĩmũikia irima rĩu. Na rĩrĩ, irima rĩu rĩarĩ rĩũmũ; rĩtiarĩ na maaĩ.<verse eid="GEN 37:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 37:25" />Magĩcooka magĩikara thĩ kũrĩa irio ciao, magĩtiira maitho makĩona gĩkundi kĩnene kĩa Aishumaeli gĩgĩũka kiumĩte Gileadi. Ngamĩĩra ciao ciakuuithĩtio mahuti manungi wega, na ũbani, na ũũkĩ-wa-ngoma ũrĩa wĩtagwo manemane, na maikũrũkĩte mathiĩ matware indo icio Misiri.<verse eid="GEN 37:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 37:26" />Juda akĩĩra ariũ a ithe atĩrĩ, “Nĩ uumithio ũrĩkũ tũkuona tũngĩũraga mũrũ wa ithe witũ na tũhithe gĩkuũ gĩake? <verse eid="GEN 37:26" /><verse number="27" style="v" sid="GEN 37:27" />Rekei tũmwenderie Aishumaeli aya, no tũtikamwĩke ũũru na moko maitũ, tondũ ũyũ nĩ mũrũ wa ithe witũ, tũrĩ a mũthiimo ũmwe na thakame o ĩmwe.” Nao ariũ a ithe magĩtĩkĩra.<verse eid="GEN 37:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 37:28" />Nĩ ũndũ ũcio hĩndĩ ĩrĩa onjorithia acio Amidiani maahĩtũkagĩra hau, ariũ a ithe makĩruta Jusufu irima, na makĩmwendia cekeri mĩrongo ĩĩrĩ cia betha<note caller="+" style="f"><char style="fr" closed="false">37:28 </char><char style="ft" closed="false">nĩ ta giramu 220.</char></note> kũrĩ Aishumaeli acio, nao makĩmũtwara Misiri.<verse eid="GEN 37:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 37:29" />Rĩrĩa Rubeni aacookire irima-inĩ na akĩona atĩ Jusufu ndaarĩ ho, agĩtembũranga nguo ciake. <verse eid="GEN 37:29" /><verse number="30" style="v" sid="GEN 37:30" />Agĩcooka kũrĩ ariũ a ithe akĩmeera atĩrĩ, “Kamwana karĩa gatirĩ ho! Niĩ ngwĩka atĩa?”<verse eid="GEN 37:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 37:31" />Nao makĩoya kanjũ ya Jusufu, magĩthĩnja mbũri na magĩtobokia kanjũ ĩyo thĩinĩ wa thakame ĩyo. <verse eid="GEN 37:31" /><verse number="32" style="v" sid="GEN 37:32" />Magĩcooka makĩoya kanjũ ĩyo yagemetio, makĩmĩtwarĩra ithe wao makĩmwĩra atĩrĩ, “Kanjũ ĩno nĩ kũmĩona tũramĩonire. Mĩrore wega wone kana hihi nĩ kanjũ ĩrĩa ya mũrũguo.”<verse eid="GEN 37:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 37:33" />Nake akĩmĩmenya, akiuga atĩrĩ, “Nĩ kanjũ ya mũrũ wakwa! Nyamũ njũru nĩĩmũrĩĩte. Ti-itherũ Jusufu nĩarĩkĩtie kũũragwo, agatambuurwo icunjĩ.”<verse eid="GEN 37:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 37:34" />Ningĩ Jakubu agĩtembũranga nguo ciake, agĩĩkĩra nguo ya ikũnia, na agĩcakaĩra mũriũ matukũ maingĩ. <verse eid="GEN 37:34" /><verse number="35" style="v" sid="GEN 37:35" />Ariũ ake othe na airĩtu ake magĩũka kũmũhooreria, no akĩrega kũhoorerio, akiuga atĩrĩ, “Aca! Ngathiĩ mbĩrĩra kũrĩ mũrũ wakwa ngĩrĩraga.” Nĩ ũndũ ũcio ithe agĩthiĩ na mbere kũmũrĩrĩra.<verse eid="GEN 37:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 37:36" />Nao Amidiani acio makĩendia<note caller="+" style="f"><char style="fr" closed="false">37:36 </char><char style="ft" closed="false">Wonjoria wa kwendia ngombo nĩwekĩrĩirwo mũno nĩ andũ arĩa maatũũraga werũ-inĩ.</char></note> Jusufu kũu Misiri kũrĩ Potifaru, ũmwe wa anene a Firaũni, nake aarĩ mũrũgamĩrĩri wa arangĩri a Firaũni.<verse eid="GEN 37:36" /></para>
  <chapter eid="GEN 37" />
  <chapter number="38" style="c" sid="GEN 38" />
  <para style="s1">Juda na Tamaru</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 38:1" />Ihinda-inĩ rĩu-rĩ, Juda agĩtiga ariũ a ithe agĩikũrũka agĩthiĩ gũikara na mũndũ wa Adulamu wetagwo Hira. <verse eid="GEN 38:1" /><verse number="2" style="v" sid="GEN 38:2" />Juda arĩ kũu agĩcemania na mwarĩ wa Mũkaanani wetagwo Shua. Akĩmũhikia na agĩkoma nake; <verse eid="GEN 38:2" /><verse number="3" style="v" sid="GEN 38:3" />nake akĩgĩa nda na agĩciara kahĩĩ, gagĩtuuo Eri. <verse eid="GEN 38:3" /><verse number="4" style="v" sid="GEN 38:4" />Akĩgĩa nda ĩngĩ, agĩciara kahĩĩ kangĩ gagĩtuuo Onani. <verse eid="GEN 38:4" /><verse number="5" style="v" sid="GEN 38:5" />O na ningĩ agĩciara kahĩĩ kangĩ, agĩgatua Shela. Aagaciarĩire kũu Chezibu.<verse eid="GEN 38:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 38:6" />Maagimara Juda akĩgũrĩra Eri ũrĩa warĩ irigithathi rĩake, mũtumia wetagwo Tamaru. <verse eid="GEN 38:6" /><verse number="7" style="v" sid="GEN 38:7" />No Eri, irigithathi rĩa Juda, aarĩ mwaganu maitho-inĩ ma Jehova; nĩ ũndũ ũcio Jehova akĩmũũraga.<verse eid="GEN 38:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 38:8" />Nake Juda akĩĩra Onani atĩrĩ, “Koma na mũtumia wa mũrũ wa nyũkwa, ũmũhingĩrie ũrĩa wagĩrĩirwo nĩkũmwĩka ũrĩ mũrũ wa nyina na mũthuuri wake, nĩguo ũciarĩre mũrũ wa nyũkwa rũciaro.” <verse eid="GEN 38:8" /><verse number="9" style="v" sid="GEN 38:9" />Nake Onani nĩamenyaga atĩ rũciaro rũu rũtigatuĩka rwake; nĩ ũndũ ũcio o akoma na mũtumia wa mũrũ wa nyina, agaita mbeũ ya ũciari thĩ, nĩguo ndagaciarĩre mũrũ wa nyina rũciaro. <verse eid="GEN 38:9" /><verse number="10" style="v" sid="GEN 38:10" />Ũndũ ũcio eekire warĩ mũũru maitho-inĩ ma Jehova; nĩ ũndũ ũcio o nake akĩũragwo nĩ Jehova.<verse eid="GEN 38:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 38:11" />Juda akĩĩra Tamaru mũtumia wa mũriũ atĩrĩ, “Thiĩ ũtũũre ũrĩ wa ndigwa gwa thoguo mũciĩ nginya mũrũ wakwa Shela agimare.” Tondũ eeciiririe atĩrĩ, “O nake Shela ahota gũkua ta ariũ a nyina.” Nĩ ũndũ ũcio Tamaru agĩthiĩ gũtũũra mũciĩ gwa ithe.<verse eid="GEN 38:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 38:12" />Thuutha wa ihinda iraaya, mũtumia wa Juda, mwarĩ wa Shua, agĩkua. Na kahinda ka macakaya gaathira na Juda athirwo nĩ kĩeha, akĩambata agĩthiĩ Timina kũrĩ andũ arĩa meenjaga ngʼondu ciake guoya, na agĩthiĩ hamwe na mũrata wake, Hira wa Adulamu.<verse eid="GEN 38:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 38:13" />Na rĩrĩa Tamaru eerirwo atĩrĩ, “Ithe wa mũthuuriguo erekeire Timina kwenja ngʼondu ciake guoya,” <verse eid="GEN 38:13" /><verse number="14" style="v" sid="GEN 38:14" />akĩruta nguo ciake cia mũtumia wa ndigwa, akĩĩhumbĩra na taama nginya ũthiũ nĩguo ndakae kũmenyeka, agĩikara thĩ itoonyero-inĩ rĩa Enaimu, rĩrĩa rĩarĩ njĩra-inĩ ya gũthiĩ Timina. Nĩgũkorwo nĩonire atĩ, o na gũtuĩka Shela aarĩ mũndũ mũgima, Juda ndaheanĩte Tamaru kũrĩ we atuĩke mũtumia wake.<verse eid="GEN 38:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 38:15" />Rĩrĩa Juda aamuonire-rĩ, agĩĩciiria atĩ Tamaru aarĩ mũmaraya<note caller="+" style="f"><char style="fr" closed="false">38:15 </char><char style="ft" closed="false">Maraya maya maahũthagĩrwo mahooero-inĩ ma matukũ ma tene, na maakonainie na ngai ya ũciari.</char></note> tondũ nĩehumbĩrĩte ũthiũ. <verse eid="GEN 38:15" /><verse number="16" style="v" sid="GEN 38:16" />Na tondũ ndooĩ atĩ aarĩ mũtumia wa mũriũ, agĩthiĩ harĩ we mũkĩra-inĩ wa njĩra, akĩmwĩra atĩrĩ, “Ũka, ĩtĩkĩra ngome nawe.”</para>
  <para style="p" vid="GEN 38:16">Mũtumia ũcio akĩmũũria atĩrĩ, “Na nĩ kĩĩ ũkũũhe nĩguo ngome nawe?”<verse eid="GEN 38:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 38:17" />Juda akĩmũcookeria atĩrĩ, “Nĩngũgũtũmĩra koori kuuma rũũru-inĩ rwakwa.”</para>
  <para style="p" vid="GEN 38:17">Mũtumia ũcio akĩmũũria atĩrĩ, “Nĩũkũndigĩra kĩndũ gĩa kũrũgamĩrĩra kĩĩranĩro gĩaku nginya rĩrĩa ũgaakaneana?”<verse eid="GEN 38:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 38:18" />Juda akĩmũũria atĩrĩ, “Ũkwenda ngũtigĩre kĩĩ gĩa kũrũgamĩrĩra?”</para>
  <para style="p" vid="GEN 38:18">Mũtumia ũcio akĩmũcookeria atĩrĩ, “Ndigĩra gĩcũhĩ kĩa rũũri rwaku na rũrigi rwakĩo, o na rũthanju rũu rũrĩ guoko-inĩ gwaku.” Nĩ ũndũ ũcio Juda agĩtigĩra mũtumia ũcio indo icio na agĩkoma nake; na Tamaru akĩgĩa nda yake. <verse eid="GEN 38:18" /><verse number="19" style="v" sid="GEN 38:19" />Mũtumia ũcio aarĩkia gwĩthiĩra, akĩaũra taama wake, akĩĩhumba nguo ciake cia mũtumia wa ndigwa rĩngĩ.<verse eid="GEN 38:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 38:20" />Rĩrĩa Juda atũmire mũratawe ũcio wa kũu Adulamu na koori nĩgeetha acookerio indo icio cia kũrũgamĩrĩra kuuma kũrĩ mũtumia ũcio-rĩ, ndaamuonire. <verse eid="GEN 38:20" /><verse number="21" style="v" sid="GEN 38:21" />Nake akĩũria andũ arĩa maatũũraga kũu atĩrĩ, “Arĩ ha mũmaraya ũrĩa ũraarĩ haha mũkĩra-inĩ wa njĩra ya gũthiĩ Enaimu?”</para>
  <para style="p" vid="GEN 38:21">Nao magĩcookia atĩrĩ, “Haha hatirĩ hakorwo na mũmaraya.”<verse eid="GEN 38:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 38:22" />Nĩ ũndũ ũcio agĩcooka kũrĩ Juda, akĩmwĩra atĩrĩ, “Niĩ ndinamuona. Hamwe na ũguo-rĩ, andũ arĩa matũũraga hau moigire atĩrĩ, ‘Haha hatirĩ hakorwo na mũmaraya.’ ”<verse eid="GEN 38:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 38:23" />Nake Juda akiuga atĩrĩ, “Nĩakĩrekwo aikare na kĩrĩa arĩ nakĩo, kana tũtuĩke a gũthekererwo. Ningĩ-rĩ, nĩngũmũtũmĩire koori gaka, no ndũnamuona.”<verse eid="GEN 38:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 38:24" />Thuutha wa mĩeri ĩtatũ, Juda akĩĩrwo atĩrĩ, “Tamaru mũtumia wa mũrũguo nĩehĩtie, akahũũra ũmaraya, na nĩ ũndũ ũcio arĩ na nda.”</para>
  <para style="p" vid="GEN 38:24">Juda akiuga atĩrĩ, “Mumiei mũmũrehe, acinwo akue!”<verse eid="GEN 38:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 38:25" />Na rĩrĩa oimagio-rĩ, agĩtũma ndũmĩrĩri kũrĩ ithe wa mũthuuriwe, akĩmwĩra atĩrĩ, “Niĩ ndĩ na nda ya mũndũ ũrĩa mwene indo ici.” Agĩcooka akiuga atĩrĩ, “Ta rora kana no ũmenye nũũ mwene gĩcũhĩ gĩkĩ kĩ na mũhũũri, na rũrigi rũrũ, o na rũthanju rũrũ.”<verse eid="GEN 38:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 38:26" />Juda agĩcimenya, na akiuga atĩrĩ, “Mũtumia ũyũ nĩ mũthingu kũngĩra; ekĩte ũguo nĩgũkorwo ndiamũheanire kũrĩ mũrũ wakwa Shela.” Juda ndaacookire gũkoma nake rĩngĩ.<verse eid="GEN 38:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 38:27" />Rĩrĩa ihinda rĩake rĩakinyire rĩa gũciara-rĩ, kwarĩ na tũhĩĩ twĩrĩ twa mahatha nda yake. <verse eid="GEN 38:27" /><verse number="28" style="v" sid="GEN 38:28" />Na rĩrĩa aaciaraga-rĩ, kamwe gatuo gagĩcomora guoko; nake mũmũciarithia akĩoya uthi mũtune, akĩwoherera guoko-inĩ gwako, na akiuga atĩrĩ, “Ũyũ nĩwe woima mbere.” <verse eid="GEN 38:28" /><verse number="29" style="v" sid="GEN 38:29" />No rĩrĩa aacookirie guoko na thĩinĩ, mũrũ wa nyina akiuma, nake mũciarithania akiuga atĩrĩ, “Githĩ nĩguo weturĩra njĩra!” Nake agĩtuuo Perezu.<note caller="+" style="f"><char style="fr" closed="false">38:29 </char><char style="ft" closed="false">Perezu aarĩ ũmwe wa maithe ma tene ma Daudi.</char></note> <verse eid="GEN 38:29" /><verse number="30" style="v" sid="GEN 38:30" />Nake mũrũ wa nyina ũrĩa warĩ na uthi mũtune guoko-inĩ gwake akiuma, nake agĩtuuo Zera.<verse eid="GEN 38:30" /></para>
  <chapter eid="GEN 38" />
  <chapter number="39" style="c" sid="GEN 39" />
  <para style="s1">Jusufu na Mũtumia wa Potifaru</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 39:1" />Na rĩrĩ, Jusufu nĩaikũrũkirio o nginya bũrũri wa Misiri. Nake Potifaru, Mũmisiri ũmwe wa anene a Firaũni, na mũrũgamĩrĩri wa arangĩri a Firaũni, akĩmũgũra kuuma kũrĩ Aishumaeli arĩa maamũtwarĩte kũu.<verse eid="GEN 39:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 39:2" />Nake Jehova aarĩ hamwe na Jusufu, nake akĩgaacĩra, na agĩtũũra nyũmba-inĩ ya Mũmisiri ũcio mwathi wake. <verse eid="GEN 39:2" /><verse number="3" style="v" sid="GEN 39:3" />Na rĩrĩa mwathi wake onire atĩ Jehova aarĩ hamwe nake, na atĩ Jehova nĩatũmĩte Jusufu agaacĩre maũndũ-inĩ mothe marĩa ekaga-rĩ, <verse eid="GEN 39:3" /><verse number="4" style="v" sid="GEN 39:4" />Jusufu agĩĩtĩkĩrĩka maitho-inĩ make na agĩtuĩka wa kũmũtungatĩra. Potifaru akĩmũtua mũrori wa nyũmba yake na akĩmwĩhokera ũmenyereri wa kĩrĩa gĩothe aarĩ nakĩo. <verse eid="GEN 39:4" /><verse number="5" style="v" sid="GEN 39:5" />Kuuma hĩndĩ ĩrĩa aamũtuire mũrori wa nyũmba yake na kĩrĩa gĩothe aarĩ nakĩo, Jehova akĩrathima nyũmba ya Mũmisiri ũcio nĩ ũndũ wa Jusufu. Kĩrathimo kĩa Jehova kĩarĩ igũrũ wa indo ciothe cia Potifaru, iria ciarĩ nyũmba o na iria ciarĩ mũgũnda. <verse eid="GEN 39:5" /><verse number="6" style="v" sid="GEN 39:6" />Nĩ ũndũ ũcio agĩtigĩra Jusufu indo ciothe iria aarĩ nacio acimenyagĩrĩre; rĩrĩa rĩothe Jusufu aarĩ mũrũgamĩrĩri-rĩ, Potifaru ndarũmbũyanagia na kĩndũ o nakĩ tiga o irio iria aarĩĩaga.<note caller="+" style="f"><char style="fr" closed="false">39:6 </char><char style="ft" closed="false">Irio cia andũ a Misiri ciarĩ na ũtiganu na irio cia andũ a Isiraeli (43:32), na nĩ kwarĩ magongona maarutagwo rĩrĩa irio cia andũ a Misiri ciarugagwo.</char></note></para>
  <para style="p" vid="GEN 39:6">Na rĩrĩ, Jusufu aarĩ mũthaka na wa mwĩrĩ mwega, <verse eid="GEN 39:6" /><verse number="7" style="v" sid="GEN 39:7" />na thuutha wa ihinda, mũtumia wa mwathi wake akĩmwĩrirĩria, akĩmwĩra atĩrĩ, “Ũka ũkome na niĩ!”<verse eid="GEN 39:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 39:8" />No Jusufu akĩrega. Akĩmwĩra atĩrĩ, “Niĩ ndĩ mũrori-rĩ, mwathi wakwa ndarũmbũyanagia na kĩndũ o nakĩ kĩa nyũmba, indo iria ciothe arĩ nacio nĩanjĩĩhokeire ndĩcimenyagĩrĩre. <verse eid="GEN 39:8" /><verse number="9" style="v" sid="GEN 39:9" />Gũtirĩ mũndũ ũngĩ mũnene nyũmba ĩno ũngĩrĩte. Mwathi wakwa ndangirĩrĩirie kĩndũ o nakĩ, tiga wee wiki, tondũ ũrĩ mũtumia wake. Ndaakĩhota atĩa gwĩka ũndũ ta ũyũ wa waganu njĩhĩrie Ngai?” <verse eid="GEN 39:9" /><verse number="10" style="v" sid="GEN 39:10" />Na o na gũtuĩka nĩaringagĩrĩria Jusufu mũthenya o mũthenya akome nake-rĩ, Jusufu nĩaregire gũkoma nake o na kana gũkorwo hamwe nake.<verse eid="GEN 39:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 39:11" />No mũthenya ũmwe Jusufu nĩaingĩrire nyũmba kũruta wĩra wake, na gũtiarĩ ndungata o na ĩmwe ya nyũmba yarĩ kũu thĩinĩ. <verse eid="GEN 39:11" /><verse number="12" style="v" sid="GEN 39:12" />Mũtumia ũcio akĩnyiita nguo ya Jusufu, akĩmwĩra atĩrĩ, “Ũka ũkome na niĩ!” No Jusufu agĩtiga nguo yake guoko-inĩ kwa mũtumia ũcio, akiuma nyũmba akĩũra.<verse eid="GEN 39:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 39:13" />Na rĩrĩa mũtumia ũcio onire atĩ Jusufu nĩatiga nguo yake guoko-inĩ gwake na oora-rĩ, <verse eid="GEN 39:13" /><verse number="14" style="v" sid="GEN 39:14" />agĩĩta ndungata cia nyũmba yake, agĩciĩra atĩrĩ, “Ta kĩonei Mũhibirania ũyũ aarehirwo kũrĩ ithuĩ nĩgeetha atũnyarare! Egũũkĩte haha nĩguo akome na niĩ, na niĩ ndakaya. <verse eid="GEN 39:14" /><verse number="15" style="v" sid="GEN 39:15" />Na rĩrĩa aigua ngĩkaya ndeithio, aatiga nguo yake haha, oima nyũmba na oora.”<verse eid="GEN 39:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 39:16" />Nake agĩikara na nguo ĩyo nginya rĩrĩa mwathi wa Jusufu aainũkire. <verse eid="GEN 39:16" /><verse number="17" style="v" sid="GEN 39:17" />Nake mũtumia ũcio akĩmũhe rũgano rũu, akĩmwĩra atĩrĩ, “Ngombo ĩrĩa ya Mũhibirania, ĩrĩa watũreheire ĩgũũkĩte kũrĩ niĩ kũnyarara. <verse eid="GEN 39:17" /><verse number="18" style="v" sid="GEN 39:18" />No rĩrĩa njugire mbu ndeithio, yatiga nguo ĩno harĩ niĩ, yoima nyũmba na yora.”<verse eid="GEN 39:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 39:19" />Rĩrĩa mwathi wa Jusufu aiguire rũgano rũu aaheirwo nĩ mũtumia wake, rĩrĩa aamwĩrire, “Ũguo nĩguo ngombo yaku ĩnjĩkire,” agĩcinwo nĩ marakara. <verse eid="GEN 39:19" /><verse number="20" style="v" sid="GEN 39:20" />Nake mwathi wa Jusufu akĩnyiita Jusufu akĩmũikia njeera, kũndũ kũrĩa gwaikagio andũ arĩa oohe a mũthamaki.</para>
  <para style="p" vid="GEN 39:20">No hĩndĩ ĩyo Jusufu aarĩ kũu njeera-rĩ, <verse eid="GEN 39:20" /><verse number="21" style="v" sid="GEN 39:21" />Jehova aarĩ hamwe nake; akĩmũtuga na agĩtũma etĩkĩrĩke maitho-inĩ ma mũnene wa njeera. <verse eid="GEN 39:21" /><verse number="22" style="v" sid="GEN 39:22" />Nĩ ũndũ ũcio mũnene wa njeera agĩtua Jusufu mũrori wa arĩa othe moohetwo njeera, na agĩtuuo mũmenyereri wa maũndũ mothe marĩa meekagwo kũu. <verse eid="GEN 39:22" /><verse number="23" style="v" sid="GEN 39:23" />Mũnene ũcio wa njeera ndaarũmbũyagia ũndũ o na ũmwe wa marĩa maamenyagĩrĩrwo nĩ Jusufu, tondũ Jehova aarĩ hamwe na Jusufu na akĩmũhe ũgaacĩru maũndũ-inĩ mothe marĩa ekaga.<verse eid="GEN 39:23" /></para>
  <chapter eid="GEN 39" />
  <chapter number="40" style="c" sid="GEN 40" />
  <para style="s1">Mũheani Ndibei na Mũthondeki wa Mĩgate</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 40:1" />Thuutha ũcio-rĩ, mũndũ ũrĩa watwaragĩra mũthamaki ndibei, na mũndũ ũrĩa wathondekagĩra mũthamaki wa Misiri mĩgate-rĩ, makĩhĩtĩria mwathi wao, ũcio mũthamaki wa Misiri. <verse eid="GEN 40:1" /><verse number="2" style="v" sid="GEN 40:2" />Firaũni mũthamaki ũcio akĩrakario nĩ anene acio ake eerĩ, mũnene wa arĩa maamũtwaragĩra ndibei na mũnene wa arĩa maamũthondekagĩra mĩgate, <verse eid="GEN 40:2" /><verse number="3" style="v" sid="GEN 40:3" />na akĩmahingĩrithia nyũmba ya mũnene wa arĩa arangĩri njeera, o ĩrĩa Jusufu oheetwo. <verse eid="GEN 40:3" /><verse number="4" style="v" sid="GEN 40:4" />Mũnene wa arangĩri akĩmaneana kũrĩ Jusufu amarorage, nake Jusufu akĩmatungatĩra.</para>
  <para style="p" vid="GEN 40:4">Na thuutha wa gũikara kĩoho-inĩ kwa ihinda-rĩ, <verse eid="GEN 40:4" /><verse number="5" style="v" sid="GEN 40:5" />o ũmwe wa acio eerĩ, ũrĩa watwaragĩra mũthamaki ndibei na mũthondeki wa mĩgate ya mũthamaki wa Misiri, o acio maahingĩirwo njeera, makĩroota irooto ũtukũ ũmwe, na o kĩroto kĩarĩ na mũtaũrĩre wakĩo.<verse eid="GEN 40:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 40:6" />Rĩrĩa Jusufu aathiire kũrĩ o rũciinĩ rwa mũthenya ũyũ ũngĩ-rĩ, akĩona marĩ na kĩeha. <verse eid="GEN 40:6" /><verse number="7" style="v" sid="GEN 40:7" />Nĩ ũndũ ũcio akĩũria anene acio a Firaũni, o acio moohetwo hamwe nake nyũmba-inĩ ya mwathi wake, atĩrĩ, “Nĩ kĩĩ gĩtũmĩte mũtukie ithiithi cianyu ũmũthĩ?”<verse eid="GEN 40:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 40:8" />Nao makĩmũcookeria atĩrĩ, “Ithuĩ ithuerĩ nĩtũrotete irooto, na gũtirĩ mũndũ wa gũcitaũra.”</para>
  <para style="p" vid="GEN 40:8">Jusufu akĩmooria atĩrĩ, “Githĩ ũtaũri ti wa Ngai? Njĩĩrai irooto cianyu.”<verse eid="GEN 40:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 40:9" />Nĩ ũndũ ũcio mũnene wa arĩa maatwaragĩra mũthamaki ndibei akĩĩra Jusufu kĩroto gĩake. Akĩmwĩra atĩrĩ, “Kĩroto-inĩ gĩakwa ndĩronire mũthabibũ ũrĩ mbere yakwa, <verse eid="GEN 40:9" /><verse number="10" style="v" sid="GEN 40:10" />na ũraarĩ na honge ithatũ. Nacio iraaruta kĩro o ũguo iracanũka, nacio imanjĩka cia thabibũ irerua. <verse eid="GEN 40:10" /><verse number="11" style="v" sid="GEN 40:11" />Na niĩ ndĩrakorwo nyiitĩte gĩkombe kĩa Firaũni na guoko, ndĩrooya thabibũ icio, ndĩraacihihĩra gĩkombe-inĩ kĩa Firaũni, na ndĩramũnengera.”<verse eid="GEN 40:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 40:12" />Jusufu akĩmwĩra atĩrĩ, “Ũtaũri wakĩo nĩ ũyũ: Honge icio ithatũ nĩ mĩthenya ĩtatũ. <verse eid="GEN 40:12" /><verse number="13" style="v" sid="GEN 40:13" />Mĩthenya ĩtatũ ĩtanathira-rĩ, Firaũni nĩegũgũtũũgĩria na agũcookie wĩra-inĩ waku, na ũcooke kũnengagĩra Firaũni gĩkombe gĩake, o ta ũrĩa wekaga rĩrĩa warĩ mũmũhei ndibei. <verse eid="GEN 40:13" /><verse number="14" style="v" sid="GEN 40:14" />No rĩrĩa maũndũ maku makaagaacĩra-rĩ, ũkandirikana ũnjiguĩre tha, ũngweete harĩ Firaũni, ũndute gũkũ njeera. <verse eid="GEN 40:14" /><verse number="15" style="v" sid="GEN 40:15" />Tondũ nĩkũnyiitwo ndaanyiitirwo na hinya, ngĩrutwo bũrũri wa Ahibirania, na ningĩ o na gũkũ gũtirĩ ũndũ mũũru ndeekĩte wa gũtũma njikio njeera.”<verse eid="GEN 40:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 40:16" />Na rĩrĩa mũnene wa arĩa athondeki mĩgate onire atĩ Jusufu nĩataũra kĩroto kĩu wega-rĩ, akĩĩra Jusufu atĩrĩ, “O na niĩ nĩndĩrarootete: Ndĩrakuuĩte ikabũ ithatũ cia mĩgate na mũtwe. <verse eid="GEN 40:16" /><verse number="17" style="v" sid="GEN 40:17" />Gĩkabũ kĩrĩa kĩrarigĩtie igũrũ kĩraarĩ na mĩgate ya mĩthemba yothe ĩthondekeirwo Firaũni; no nacio nyoni iramĩrĩĩaga ĩrĩ o gĩkabũ-inĩ ndĩgĩkuuĩte na mũtwe.”<verse eid="GEN 40:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 40:18" />Jusufu akĩmwĩra atĩrĩ, “Ũtaũri wakĩo nĩ ũyũ: Ikabũ icio ithatũ nĩ mĩthenya ĩtatũ. <verse eid="GEN 40:18" /><verse number="19" style="v" sid="GEN 40:19" />Mĩthenya ĩtatũ ĩtanathira-rĩ, Firaũni nĩagagũtinithia mũtwe na akwambithie mũtĩ igũrũ. Nacio nyoni nĩikarĩa nyama cia mwĩrĩ waku.”<verse eid="GEN 40:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 40:20" />Na rĩrĩ, mũthenya wa gatatũ warĩ wa kũririkana gũciarwo kwa Firaũni, nake akĩrugithĩria anene ake iruga inene. Nake akĩririkana mũnene wa arĩa maamũtwaragĩra ndibei na mũnene wa arĩa maamũthondekagĩra mĩgate mbere ya anene arĩa angĩ ake: <verse eid="GEN 40:20" /><verse number="21" style="v" sid="GEN 40:21" />Agĩcookia mũnene wa arĩa maamũtwaragĩra ndibei wĩra-inĩ wake, nĩgeetha acooke gũtwarĩra Firaũni gĩkombe rĩngĩ. <verse eid="GEN 40:21" /><verse number="22" style="v" sid="GEN 40:22" />No rĩrĩ, mũnene wa arĩa maamũthondekagĩra mĩgate-rĩ, akĩmũcuria mũtĩ igũrũ o ta ũrĩa Jusufu aamerĩte ũtaũri-inĩ wake.<verse eid="GEN 40:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 40:23" />No mũnene ũcio wa arĩa maatwaragĩra Firaũni ndibei ndaigana kũririkana Jusufu; nĩariganĩirwo nĩwe.<verse eid="GEN 40:23" /></para>
  <chapter eid="GEN 40" />
  <chapter number="41" style="c" sid="GEN 41" />
  <para style="s1">Irooto cia Firaũni</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 41:1" />Na rĩrĩ, mĩaka ĩĩrĩ mĩgima yathira-rĩ, Firaũni akĩroota kĩroto: Akĩona arũgamĩte rũteere-inĩ rwa Rũũĩ rwa Nili; <verse eid="GEN 41:1" /><verse number="2" style="v" sid="GEN 41:2" />na rĩrĩ, gũkiumĩra ngʼombe mũgwanja njega na noru kuuma thĩinĩ wa rũũĩ rũu, na igĩitĩka kũrĩa nyeki ithanjĩ-inĩ. <verse eid="GEN 41:2" /><verse number="3" style="v" sid="GEN 41:3" />Thuutha wacio rĩ, hakiumĩra ngʼombe ingĩ mũgwanja, njongʼi na hĩnju, kuuma rũũĩ rũu rwa Nili, na ikĩrũgama mwena-inĩ harĩa icio ingĩ ciarũgamĩte hũgũrũrũ-inĩ cia rũũĩ. <verse eid="GEN 41:3" /><verse number="4" style="v" sid="GEN 41:4" />Na rĩrĩ, ngʼombe icio njongʼi na hĩnju ikĩrĩa ngʼombe iria mũgwanja njega na noru. Hĩndĩ ĩyo Firaũni akĩũrwo nĩ toro.<verse eid="GEN 41:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 41:5" />Ningĩ Firaũni agĩkoma rĩngĩ na akĩroota kĩroto gĩa keerĩ: Magira mũgwanja mega ma ngano, maiyũrĩte ngano, maakũraga kamũtĩ-inĩ kamwe ka ngano. <verse eid="GEN 41:5" /><verse number="6" style="v" sid="GEN 41:6" />Thuutha wamo gũgĩthethũka magira mangĩ mũgwanja ma ngano mahĩnju, mahaana ta macinĩtwo nĩ rũhuho rwa mwena wa irathĩro. <verse eid="GEN 41:6" /><verse number="7" style="v" sid="GEN 41:7" />Magira macio mahĩnju ma ngano makĩmeria magira marĩa mũgwanja maarĩ mega na maiyũrĩte ngano. Hĩndĩ ĩyo Firaũni akĩũrwo nĩ toro, agĩũkĩra agĩkora nĩ kũroota ekũrootaga.<verse eid="GEN 41:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 41:8" />Rũciinĩ agĩtangĩka meciiria, na nĩ ũndũ ũcio agĩtũmanĩra andũ-ago othe na andũ arĩa oogĩ a Misiri. Firaũni akĩmeera irooto ciake, no gũtirĩ wao o na ũmwe wahotire kũmũtaũrĩra.<verse eid="GEN 41:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 41:9" />Hĩndĩ ĩyo mũnene wa arĩa maamũtwaragĩra ndibei akĩĩra Firaũni atĩrĩ, “Ũmũthĩ nĩndaririkanio mahĩtia makwa. <verse eid="GEN 41:9" /><verse number="10" style="v" sid="GEN 41:10" />Hĩndĩ ĩmwe-rĩ, Firaũni nĩarakarĩtio nĩ ndungata ciake; na niĩ hamwe na mũnene wa arĩa athondeki mĩgate-rĩ, agĩtuohithia njeera nyũmba-inĩ ya mũnene wa arangĩri. <verse eid="GEN 41:10" /><verse number="11" style="v" sid="GEN 41:11" />Ũtukũ ũmwe-rĩ, o ũmwe witũ akĩroota kĩroto, na o kĩroto kĩarĩ na ũtaũri wakĩo mwanya. <verse eid="GEN 41:11" /><verse number="12" style="v" sid="GEN 41:12" />Na rĩrĩ, kũu njeera twarĩ na mwanake Mũhibirania, ndungata ya mũnene wa arangĩri. Na ithuĩ tũkĩmwĩra irooto ciitũ, nake agĩtũtaũrĩra; akĩhe o mũndũ ũtaũri wa kĩroto gĩake. <verse eid="GEN 41:12" /><verse number="13" style="v" sid="GEN 41:13" />Namo maũndũ magĩkĩka o ta ũrĩa aatũtaũrĩire. Niĩ ngĩcookio wĩra-inĩ wakwa, nake mũndũ ũcio ũngĩ agĩcuurio mũtĩ igũrũ.”<verse eid="GEN 41:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 41:14" />Nĩ ũndũ ũcio Firaũni agĩtũmanĩra Jusufu, nake akĩrutwo kũu njeera narua. Na aarĩkia kwĩyenja<note caller="+" style="f"><char style="fr" closed="false">41:14 </char><char style="ft" closed="false">Warĩ mũtugo wa andũ a Misiri kwenjwo njuĩrĩ na nderu, no Ahibirania matiekaga ũguo.</char></note> na kũruta nguo iria arĩ nacio na gwĩkĩra ingĩ-rĩ, agĩthiĩ mbere ya Firaũni.<verse eid="GEN 41:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 41:15" />Nake Firaũni akĩĩra Jusufu atĩrĩ, “Ndĩrarootire kĩroto na gũtirĩ mũndũ ũrahota gũgĩtaũra. No nĩnjiguĩte gũkĩĩrwo atĩrĩ, wee ũngĩĩrwo kĩroto no ũhote gũgĩtaũra.”<verse eid="GEN 41:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 41:16" />Jusufu agĩcookeria Firaũni atĩrĩ, “Niĩ mwene ndingĩhota, no Ngai nĩekũhe Firaũni macookio marĩa arenda.”<verse eid="GEN 41:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 41:17" />Hĩndĩ ĩyo Firaũni akĩĩra Jusufu atĩrĩ, “Kĩroto-inĩ gĩakwa-rĩ, ndĩrarũgamĩte hũgũrũrũ-inĩ cia Rũũĩ rwa Nili, <verse eid="GEN 41:17" /><verse number="18" style="v" sid="GEN 41:18" />rĩrĩa haroimĩrire ngʼombe mũgwanja njega na noru kuuma rũũĩ, na iraitĩka kũrĩa kũu ithanjĩ-inĩ. <verse eid="GEN 41:18" /><verse number="19" style="v" sid="GEN 41:19" />Thuutha wacio kũracooka kũroimĩra ngʼombe ingĩ mũgwanja hinyaru, njongʼi mũno na hĩnju. Ndirĩ ndona ngʼombe njongʼi ta icio bũrũri-inĩ wothe wa Misiri. <verse eid="GEN 41:19" /><verse number="20" style="v" sid="GEN 41:20" />Nacio ngʼombe icio hĩnju na njongʼi irarĩa ngʼombe iria mũgwanja noru iria iroimĩrĩte mbere. <verse eid="GEN 41:20" /><verse number="21" style="v" sid="GEN 41:21" />No rĩrĩ, o na ciarĩkia gũcirĩa-rĩ, gũtirĩ mũndũ ũngĩramenyire atĩ nĩirarĩĩte; tondũ ironekaga irĩ o njongʼi o ta mbere. Hĩndĩ ĩyo ndĩrokĩra.<verse eid="GEN 41:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 41:22" />“Ningĩ irooto-inĩ ciakwa-rĩ, nĩndĩronire magira mũgwanja mega ma ngano na maiyũrĩte ngano, magĩkũũra kamũtĩ-inĩ ka ngano. <verse eid="GEN 41:22" /><verse number="23" style="v" sid="GEN 41:23" />Thuutha wamo, magira mangĩ mũgwanja marathethũka, marĩ mahoohu na macinĩtwo nĩ rũhuho rwa mwena wa irathĩro. <verse eid="GEN 41:23" /><verse number="24" style="v" sid="GEN 41:24" />Namo magira macio mahĩnju marameria magira marĩa mũgwanja mega. Ndĩraheire andũ-ago ũhoro ũcio, no gũtirĩ o na ũmwe ũrahotire kũndaũrĩra irooto icio.”<verse eid="GEN 41:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 41:25" />Nake Jusufu akĩĩra Firaũni atĩrĩ, “Irooto cia Firaũni cierĩ no kĩroto kĩmwe. Ngai nĩaguũrĩirie Firaũni ũrĩa akiriĩ gwĩka. <verse eid="GEN 41:25" /><verse number="26" style="v" sid="GEN 41:26" />Ngʼombe iria mũgwanja njega nĩ mĩaka mũgwanja, na magira marĩa mũgwanja mega ma ngano nĩ mĩaka mũgwanja; kĩroto kĩu no kĩmwe. <verse eid="GEN 41:26" /><verse number="27" style="v" sid="GEN 41:27" />Nacio ngʼombe icio mũgwanja hĩnju na njongʼi iria cioimĩrire thuutha nĩ mĩaka mũgwanja, na no taguo magira marĩa mũgwanja matarĩ ngano macinĩtwo nĩ rũhuho rwa mwena wa irathĩro: ĩyo nĩ mĩaka mũgwanja ya ngʼaragu.<verse eid="GEN 41:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 41:28" />“Na o ta ũrĩa ndeera Firaũni: Ngai nĩ oneetie Firaũni ũrĩa akiriĩ gwĩka. <verse eid="GEN 41:28" /><verse number="29" style="v" sid="GEN 41:29" />Nĩgũgũkorwo na mĩaka mũgwanja ya bũthi mũnene bũrũri wothe wa Misiri, <verse eid="GEN 41:29" /><verse number="30" style="v" sid="GEN 41:30" />no nĩgũgũcooka kũrũmĩrĩrwo nĩ mĩaka mũgwanja ya ngʼaragu. Naguo bũthi ũcio wothe wa Misiri nĩũkariganĩra, nayo ngʼaragu nĩĩkananga bũrũri ũyũ. <verse eid="GEN 41:30" /><verse number="31" style="v" sid="GEN 41:31" />Bũthi wa bũrũri ndũkaririkanwo, tondũ ngʼaragu ĩrĩa ĩgacooka kũgĩa nĩĩgakorwo ĩrĩ nene mũno. <verse eid="GEN 41:31" /><verse number="32" style="v" sid="GEN 41:32" />Gĩtũmi kĩa Firaũni aheo kĩroto kĩu maita meerĩ, nĩ tondũ Ngai nĩatuĩte nĩegwĩka ũndũ ũcio, na ekũwĩka o narua.<verse eid="GEN 41:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 41:33" />“Rĩu Firaũni nĩacarie mũndũ ũũĩ gũkũũrana maũndũ na mũndũ mũũgĩ, amũtue mũrũgamĩrĩri wa bũrũri wa Misiri. <verse eid="GEN 41:33" /><verse number="34" style="v" sid="GEN 41:34" />O na ningĩ Firaũni nĩagĩthuure atabarĩri a bũrũri a kuoyaga gĩcunjĩ gĩa ithano kĩa magetha ma Misiri mĩaka-inĩ ĩyo mũgwanja ya bũthi. <verse eid="GEN 41:34" /><verse number="35" style="v" sid="GEN 41:35" />Nao nĩmacookanĩrĩrie irio icio ciothe cia mĩaka ĩyo mĩega ĩrooka, na ngano ĩyo ĩkorwo watho-inĩ wa Firaũni, ĩigwo matũũra-inĩ ĩrĩ irio. <verse eid="GEN 41:35" /><verse number="36" style="v" sid="GEN 41:36" />Nacio irio icio ciagĩrĩire kũigwo irĩ mũthiithũ wa bũrũri, ikaahũthĩrwo hĩndĩ ĩrĩa ya mĩaka mũgwanja ya ngʼaragu ĩrĩa ĩkaagĩa Misiri, nĩgeetha bũrũri ndũkanathũkio nĩ ngʼaragu ĩyo.”<verse eid="GEN 41:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 41:37" />Firaũni na anene ake makĩona mũbango ũcio ũrĩ mwega. <verse eid="GEN 41:37" /><verse number="38" style="v" sid="GEN 41:38" />Nĩ ũndũ ũcio Firaũni akĩmooria atĩrĩ, “No tuone mũndũ ũngĩ ta ũyũ, mũndũ ũrĩ na roho wa Ngai thĩinĩ wake?”<verse eid="GEN 41:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="GEN 41:39" />Firaũni agĩkĩĩra Jusufu atĩrĩ, “Kuona atĩ Ngai nĩakũmenyithĩtie maũndũ maya mothe-rĩ, gũtirĩ mũndũ ũngĩ ũngĩkũũrana maũndũ na mũũgĩ ta we. <verse eid="GEN 41:39" /><verse number="40" style="v" sid="GEN 41:40" />Wee nĩwe ũkũrũgamĩrĩra nyũmba yakwa ya ũthamaki, na andũ akwa othe marĩathĩkagĩra watho waku. Ũndũ ngũgũkĩra naguo no atĩrĩ, niĩ nĩ niĩ Mũthamaki.”<verse eid="GEN 41:40" /></para>
  <para style="s1">Jusufu Kũrũgamĩrĩra Misiri</para>
  <para style="p">
    <verse number="41" style="v" sid="GEN 41:41" />Nĩ ũndũ ũcio Firaũni akĩĩra Jusufu atĩrĩ, “Kuuma rĩu nĩndagũtua mũrũgamĩrĩri wa bũrũri wothe wa Misiri.” <verse eid="GEN 41:41" /><verse number="42" style="v" sid="GEN 41:42" />Ningĩ Firaũni akĩruta gĩcũhĩ gĩake kĩa mũhũũri kuuma kĩara gĩake agĩgĩĩkĩra kĩara-inĩ kĩa Jusufu.<note caller="+" style="f"><char style="fr" closed="false">41:42 </char><char style="ft" closed="false">Gĩcũhĩ gĩa guoko nĩkĩo kĩahũthagĩrwo nĩ athamaki kũhũũra mĩhũũri.</char></note> Agĩcooka akĩmũhumba nguo cia gatani njega, na kĩrengeeri gĩa thahabu ngingo. <verse eid="GEN 41:42" /><verse number="43" style="v" sid="GEN 41:43" />Ningĩ agĩtũma akuuo na ngaari yake ya ita, arĩ mũndũ wa keerĩ harĩ we wathani-inĩ, nao andũ magĩthiĩ makĩanagĩrĩra marĩ mbere yake atĩrĩ, “Eherai njĩra-inĩ!” Nĩ ũndũ ũcio Firaũni agĩtua Jusufu mũrũgamĩrĩri wa bũrũri wothe wa Misiri.<verse eid="GEN 41:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="GEN 41:44" />Ningĩ Firaũni akĩĩra Jusufu atĩrĩ, “Nĩ niĩ Firaũni, no rĩrĩ, hatarĩ na rũtha rwaku, gũtirĩ mũndũ ũgeeka ũndũ atarĩ na rũtha rwaku gũkũ Misiri guothe.” <verse eid="GEN 41:44" /><verse number="45" style="v" sid="GEN 41:45" />Nake Firaũni agĩĩta Jusufu Zafenathu-Panea, na akĩmũhe Asenathu mwarĩ wa Potifera, mũthĩnjĩri-ngai wa Onu, atuĩke mũtumia wake. Nake Jusufu agĩtuĩkania bũrũri wothe wa Misiri.<verse eid="GEN 41:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="GEN 41:46" />Jusufu aarĩ na mĩaka mĩrongo ĩtatũ rĩrĩa atoonyire ũtungata-inĩ wa Firaũni mũthamaki wa Misiri. Nake Jusufu akĩehera mbere ya Firaũni, agĩtuĩkania bũrũri wothe wa Misiri. <verse eid="GEN 41:46" /><verse number="47" style="v" sid="GEN 41:47" />Na rĩrĩ, ihinda rĩa mĩaka ĩyo mũgwanja ya bũthi, bũrũri ũcio ũgĩciara maciaro maingĩ mũno. <verse eid="GEN 41:47" /><verse number="48" style="v" sid="GEN 41:48" />Nake Jusufu agĩcookanĩrĩria irio ciothe cia bũrũri wa Misiri iria ciagĩire kuo mĩaka ĩyo mũgwanja ya bũthi, na agĩciigithia matũũra-inĩ marĩa manene. O itũũra inene akaiga irio iria ciakũragio mĩgũnda-inĩ ĩrĩa yarĩthiũrũrũkĩirie. <verse eid="GEN 41:48" /><verse number="49" style="v" sid="GEN 41:49" />Jusufu agĩkĩigithia ngano nyingĩ mũno, o ta mũthanga wa iria-inĩ; yarĩ nyingĩ mũno, o nginya agĩtiga kũiga maandĩko ma mũigana wayo tondũ ndĩngĩathimĩkire.<verse eid="GEN 41:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="GEN 41:50" />Mĩaka ya ngʼaragu ĩtaanakinya-rĩ, Jusufu nĩaciarĩirwo tũhĩĩ twĩrĩ nĩ Asenathu mwarĩ wa Potifera, mũthĩnjĩri-ngai wa Onu. <verse eid="GEN 41:50" /><verse number="51" style="v" sid="GEN 41:51" />Jusufu agĩĩta irigithathi rĩake Manase, akiuga atĩrĩ, “Nĩ tondũ Ngai nĩatũmĩte ndiganĩrwo nĩ thĩĩna wakwa wothe na nyũmba ya baba yothe.” <verse eid="GEN 41:51" /><verse number="52" style="v" sid="GEN 41:52" />Nako kahĩĩ ga keerĩ, agĩgeeta Efiraimu, akiuga atĩrĩ, “Nĩ tondũ Ngai nĩatũmĩte ngĩe na maciaro bũrũri-inĩ wa mĩnyamaro yakwa.”<verse eid="GEN 41:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="GEN 41:53" />Nayo mĩaka mũgwanja ya bũthi kũu Misiri ĩgĩthira, <verse eid="GEN 41:53" /><verse number="54" style="v" sid="GEN 41:54" />na mĩaka mũgwanja ya ngʼaragu ĩkĩambĩrĩria, o ta ũrĩa Jusufu oigĩte. Kwarĩ na ngʼaragu mabũrũri-inĩ marĩa mangĩ mothe, no bũrũri wa Misiri wothe warĩ na irio. <verse eid="GEN 41:54" /><verse number="55" style="v" sid="GEN 41:55" />Na rĩrĩa andũ a Misiri othe maambĩrĩirie kũigua ngʼaragu-rĩ, magĩkaĩra Firaũni amahe irio. Nake Firaũni akĩmeera atĩrĩ, “Thiĩi kũrĩ Jusufu na mwĩke ũrĩa ekũmwĩra.”<verse eid="GEN 41:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="GEN 41:56" />Rĩrĩa ngʼaragu yagĩire bũrũri wothe-rĩ, Jusufu akĩhingũra makũmbĩ ma irio, akĩenderia andũ a Misiri ngano, nĩgũkorwo ngʼaragu yarĩ nene mũno Misiri guothe. <verse eid="GEN 41:56" /><verse number="57" style="v" sid="GEN 41:57" />Namo mabũrũri mothe magĩũka Misiri kũrĩ Jusufu kũgũra ngano, tondũ ngʼaragu ĩyo yarĩ nene mũno thĩ yothe.<verse eid="GEN 41:57" /></para>
  <chapter eid="GEN 41" />
  <chapter number="42" style="c" sid="GEN 42" />
  <para style="s1">Ariũ a ithe na Jusufu Gũthiĩ Misiri</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 42:1" />Rĩrĩa Jakubu aamenyire atĩ Misiri nĩ kwarĩ na ngano, akĩĩra ariũ ake atĩrĩ, “Nĩ kĩĩ gĩtũmĩte mũikare o ro ũguo mũcũthanĩrĩirie?” <verse eid="GEN 42:1" /><verse number="2" style="v" sid="GEN 42:2" />Agĩthiĩ na mbere akĩmeera atĩrĩ, “Nĩnjiguĩte atĩ Misiri kũrĩ na ngano. Ikũrũkai kuo mũgatũgũrĩre irio, nĩgeetha tũtũũre muoyo tũtigakue.”<verse eid="GEN 42:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 42:3" />Nao ariũ ikũmi a ithe na Jusufu magĩikũrũka, magĩthiĩ kũgũra ngano Misiri. <verse eid="GEN 42:3" /><verse number="4" style="v" sid="GEN 42:4" />No Jakubu ndaatũmire Benjamini mũrũ wa nyina na Jusufu athiĩ na arĩa angĩ, tondũ nĩetigagĩra ndakone mũtino. <verse eid="GEN 42:4" /><verse number="5" style="v" sid="GEN 42:5" />Nĩ ũndũ ũcio ariũ a Isiraeli magĩthiĩ marĩ hamwe na arĩa angĩ maathiĩte kũgũra ngano Misiri, tondũ bũrũri wa Kaanani o naguo warĩ na ngʼaragu.<verse eid="GEN 42:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 42:6" />Na rĩrĩ, Jusufu nĩwe warĩ mwathi wa bũrũri wa Misiri na nĩwe wendagĩria andũ othe a bũrũri ngano. Nĩ ũndũ ũcio rĩrĩa ariũ a ithe maakinyire kuo-rĩ, makĩmũinamĩrĩra, magĩturumithia mothiũ mao thĩ. <verse eid="GEN 42:6" /><verse number="7" style="v" sid="GEN 42:7" />Na rĩrĩa Jusufu onire ariũ a ithe, o ro rĩmwe akĩmamenya, no agĩĩtua ndamooĩ na akĩmaarĩria arĩ na ũũru, akĩmooria atĩrĩ, “Mumĩte kũ?”</para>
  <para style="p" vid="GEN 42:7">Nao makĩmũcookeria atĩrĩ, “Tuumĩte bũrũri wa Kaanani tũgooka kũgũra irio.”<verse eid="GEN 42:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 42:8" />O na gũtuĩka Jusufu nĩamenyire ariũ a ithe-rĩ, o matiigana kũmũmenya. <verse eid="GEN 42:8" /><verse number="9" style="v" sid="GEN 42:9" />Ningĩ akĩririkana irooto ciake iria aarootete imakoniĩ, akĩmeera atĩrĩ, “Inyuĩ mũrĩ athigaani! Mũũkĩte kũrora bũrũri witũ kũrĩa ũtarĩ mũgitĩre.”<verse eid="GEN 42:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 42:10" />Nao makĩmũcookeria atĩrĩ, “Aca, mwathi witũ! Ndungata ciaku ciũkĩte o kũgũra irio tu. <verse eid="GEN 42:10" /><verse number="11" style="v" sid="GEN 42:11" />Ithuĩ ithuothe tũrĩ ariũ a mũthuuri ũmwe. Ithuĩ ndungata ciaku tũrĩ andũ ehokeku, tũtirĩ athigaani.”<verse eid="GEN 42:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 42:12" />Nake Jusufu akĩmeera atĩrĩ, “Aca! Mũũkĩte kũrora bũrũri witũ kũrĩa ũtarĩ mũgitĩre.”<verse eid="GEN 42:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 42:13" />No makĩmũcookeria atĩrĩ, “Ndungata ciaku ciarĩ andũ ikũmi na eerĩ, ariũ a mũthuuri ũmwe, ũrĩa ũtũũraga bũrũri wa Kaanani. Ũrĩa mũnini biũ nĩwe ũrĩ na baba rĩu, na ũmwe witũ ndarĩ ho.”<verse eid="GEN 42:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 42:14" />Jusufu akĩmeera atĩrĩ, “No ta ũrĩa ndamwĩra: Inyuĩ mũrĩ athigaani! <verse eid="GEN 42:14" /><verse number="15" style="v" sid="GEN 42:15" />Na ũũ nĩguo mũkũmenyeka atĩ mũrĩ andũ a ma: Ti-itherũ, o ta ũrĩa Firaũni atũũraga muoyo-rĩ, mũtingiuma kũndũ gũkũ nginya ũrĩa mũnini wanyu oke. <verse eid="GEN 42:15" /><verse number="16" style="v" sid="GEN 42:16" />Tũmai ũmwe wanyu athiĩ agĩĩre mũrũ wa thoguo ũcio ũngĩ; inyuĩ aya angĩ nĩ mũgũikio njeera nĩgeetha ciugo cianyu icio mwarĩtie irorwo kana nĩ ũhoro wa ma. Mũngĩkorwo ũguo muugĩte tiguo-rĩ, o ta ũrĩa Firaũni atũũraga muoyo, inyuĩ mũrĩ athigaani!” <verse eid="GEN 42:16" /><verse number="17" style="v" sid="GEN 42:17" />Nake akĩmaikia othe njeera, magĩikara kuo mĩthenya ĩtatũ.<verse eid="GEN 42:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 42:18" />Mũthenya wa ĩtatũ Jusufu akĩmeera atĩrĩ, “Tondũ ndĩ mwĩtigĩri Ngai-rĩ, ĩkai ũũ nĩguo mũtũũre muoyo: <verse eid="GEN 42:18" /><verse number="19" style="v" sid="GEN 42:19" />Angĩkorwo mũrĩ andũ ehokeku, ĩtĩkĩrai ũmwe wanyu aikare gũkũ njeera, na inyuĩ arĩa angĩ mũthiĩ mũtwarĩre andũ anyu ngano nĩ ũndũ wa ngʼaragu ĩrĩa marĩ nayo. <verse eid="GEN 42:19" /><verse number="20" style="v" sid="GEN 42:20" />No rĩrĩ, no nginya mũndehere mũrũ wa thoguo ũcio mũnini biũ, nĩgeetha ciugo cianyu ciĩtĩkĩrĩke kũna atĩ nĩ cia ma, na nĩguo mũtigakue.” Nao magĩĩka o ũguo.<verse eid="GEN 42:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 42:21" />Nao makĩĩrana atĩrĩ, “Ti-itherũ tũraherithio nĩ ũndũ wa mũrũ wa ithe witũ. Nĩtuonire ũrĩa aarĩ na thĩĩna rĩrĩa atũthaithaga tũhonokie muoyo wake, no tũkĩrega kũmũigua; na no kĩo tũnyiitĩtwo nĩ thĩĩna ũyũ.”<verse eid="GEN 42:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 42:22" />Rubeni akĩmacookeria atĩrĩ, “Githĩ ndiamwĩrire mũtikehĩrie kamwana kau? No inyuĩ mũkĩrega gũũthikĩrĩria! Rĩu no nginya tũrĩhio thakame yake.” <verse eid="GEN 42:22" /><verse number="23" style="v" sid="GEN 42:23" />No matiamenyaga atĩ Jusufu nĩaiguaga ũrĩa moigaga, tondũ we aatũmagĩra mũtabuti akĩmaarĩria.<verse eid="GEN 42:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 42:24" />Jusufu akĩmahutatĩra akĩmeherera, akĩambĩrĩria kũrĩra; ningĩ agĩcooka agĩthiĩ akĩmaarĩria rĩngĩ. Akĩnyiitithia Simeoni akĩeherio harĩo na akĩohwo makĩonaga.<verse eid="GEN 42:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 42:25" />Jusufu agĩathana makũnia mao maiyũrio ngano, na betha cia o mũndũ icookio ikũnia-inĩ rĩake, na maheo rĩĩgu wa rũgendo. Thuutha wa gwĩkĩrwo maũndũ macio, <verse eid="GEN 42:25" /><verse number="26" style="v" sid="GEN 42:26" />makĩigĩrĩra ndigiri ciao mĩrigo ĩyo ya ngano na makiumagara.<verse eid="GEN 42:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 42:27" />Harĩa maarũgamire mararĩrĩre-rĩ, ũmwe wao agĩtumũra ikũnia rĩake ahe ndigiri yake irio, nake akĩona betha ciake hau mũromo-inĩ wa ikũnia rĩake. <verse eid="GEN 42:27" /><verse number="28" style="v" sid="GEN 42:28" />Akĩĩra ariũ a ithe atĩrĩ, “Haiya, nĩnjookeirio betha ciakwa; ĩ ici haha ikũnia-inĩ rĩakwa.”</para>
  <para style="p" vid="GEN 42:28">Ngoro ciao ikĩnyiitwo nĩ ihooru na makĩrorana makĩinainaga, makĩũrania atĩrĩ, “Nĩ atĩa ũũ Ngai atwĩkĩte?”<verse eid="GEN 42:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 42:29" />Na rĩrĩa maakinyire kũrĩ ithe wao Jakubu kũu bũrũri wa Kaanani-rĩ, makĩmwĩra maũndũ marĩa mothe monete. Makĩmwĩra atĩrĩ, <verse eid="GEN 42:29" /><verse number="30" style="v" sid="GEN 42:30" />“Mũndũ ũrĩa mwathi wa bũrũri ũcio aatwarĩirie na ũũru mũingĩ na agĩtũtua ta twathiĩte gũthigaana bũrũri ũcio. <verse eid="GEN 42:30" /><verse number="31" style="v" sid="GEN 42:31" />No ithuĩ tũkĩmwĩra atĩrĩ, ‘Ithuĩ tũrĩ andũ ehokeku; tũtirĩ athigaani. <verse eid="GEN 42:31" /><verse number="32" style="v" sid="GEN 42:32" />Twarĩ andũ ikũmi na eerĩ, ariũ a mũthuuri ũmwe. Ũmwe ndarĩ ho, na ũrĩa mũnini biũ arĩ na ithe witũ kũu Kaanani.’<verse eid="GEN 42:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 42:33" />“Ningĩ mũndũ ũcio mwathi wa bũrũri agĩtwĩra atĩrĩ, ‘Gĩkĩ nĩkĩo gĩgũtũma menye kana mũrĩ andũ ehokeku: Ndigĩrai mũrũ wa thoguo ũmwe gũkũ, muoe irio mũthiĩ mũcitwarĩre andũ a nyũmba cianyu acio marĩ na ngʼaragu. <verse eid="GEN 42:33" /><verse number="34" style="v" sid="GEN 42:34" />No mũndehere mũrũ wa thoguo ũrĩa mũnini biũ na noguo ngaamenya atĩ mũtirĩ athigaani, mũrĩ andũ ehokeku. Hĩndĩ ĩyo nĩngamũcookeria mũrũ wa thoguo, na nĩmũgetĩkĩrio kuonjorithagia bũrũri-inĩ ũyũ.’ ”<verse eid="GEN 42:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 42:35" />Na rĩrĩa moonoragia makũnia mao-rĩ, o mũndũ agĩkora kĩohe kĩa betha ciake ikũnia-inĩ rĩake! Nao na ithe wao mona ciohe icio cia mbeeca, makĩmaka. <verse eid="GEN 42:35" /><verse number="36" style="v" sid="GEN 42:36" />Ithe wao Jakubu akĩmeera atĩrĩ, “Mũrĩ kũũniinĩra ciana ciakwa. Jusufu ndarĩ ho, na Simeoni ndarĩ ho, na rĩu mũrenda kuoya Benjamini. Maũndũ maya mothe nĩ niĩ mokĩrĩire!”<verse eid="GEN 42:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 42:37" />Hĩndĩ ĩyo Rubeni akĩĩra ithe atĩrĩ, “Nĩũkooraga ariũ akwa eerĩ ingĩkaaga gũcookia Benjamini harĩwe. Reke akorwo ũmenyereri-inĩ wakwa, na nĩngamũcookia.”<verse eid="GEN 42:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 42:38" />No Jakubu akiuga atĩrĩ, “Mũrũ wakwa ndegũikũrũka athiĩ na inyuĩ; mũrũ wa nyina nĩ mũkuũ na nowe wiki ũtigarĩte. Angĩnyiitwo nĩ mũtino mũna rũgendo-inĩ rũu mũrathiĩ-rĩ, mwatũma mbuĩ ici ciakwa ithiĩ mbĩrĩra-inĩ na kĩeha.”<verse eid="GEN 42:38" /></para>
  <chapter eid="GEN 42" />
  <chapter number="43" style="c" sid="GEN 43" />
  <para style="s1">Rũgendo rwa Keerĩ rwa Gũthiĩ Misiri</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 43:1" />Na rĩrĩ, ngʼaragu ĩyo ĩkĩneneha mũno bũrũri-inĩ wa Kaanani. <verse eid="GEN 43:1" /><verse number="2" style="v" sid="GEN 43:2" />Nĩ ũndũ ũcio rĩrĩa maarĩire ngano yothe ĩrĩa maagũrĩte Misiri ĩgĩthira-rĩ, ithe wao akĩmeera atĩrĩ, “Cookai Misiri rĩngĩ mũgatũgũrĩre irio ingĩ nini.”<verse eid="GEN 43:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 43:3" />No Juda akĩmwĩra atĩrĩ, “Mũndũ ũcio aatwĩhĩtĩire agĩtwĩra atĩrĩ, ‘Mũtikoona ũthiũ wakwa rĩngĩ tiga mũrũ wa thoguo ũcio ũngĩ akorirwo arĩ hamwe na inyuĩ.’ <verse eid="GEN 43:3" /><verse number="4" style="v" sid="GEN 43:4" />Akorwo nĩũgũtũtũma hamwe na mũrũ wa ithe witũ Benjamini, nĩtũgũikũrũka tũthiĩ tũkũgũrĩre irio. <verse eid="GEN 43:4" /><verse number="5" style="v" sid="GEN 43:5" />No akorwo ndũkũmũtũma na ithuĩ, tũtigũikũrũka, tondũ mũndũ ũcio aatwĩrire atĩrĩ, ‘Mũtikoona ũthiũ wakwa rĩngĩ tiga no mũrũ wa thoguo akorirwo arĩ hamwe na inyuĩ.’ ”<verse eid="GEN 43:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 43:6" />Nake Isiraeli akĩmooria atĩrĩ, Mwandehereire thĩĩna ũyũ nĩkĩ, na ũndũ wa kwĩra mũndũ ũcio atĩ nĩ mũrĩ na mũrũ wa ithe wanyu ũngĩ?<verse eid="GEN 43:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 43:7" />Makĩmũcookeria atĩrĩ, “Mũndũ ũcio aatũũragia ciũria itũkoniĩ ithuĩ ene o na cia nyũmba ciitũ abarĩrĩire mũno. Agĩtũũria atĩrĩ, ‘Ithe wanyu arĩ o muoyo? Nĩ mũrĩ na mũrũ wa thoguo ũngĩ?’ Ithuĩ no gũcookia twacookagia ciũria ciake. Tũngĩamenyire atĩa atĩ no oige, ‘Thiĩi mũrehe mũrũ wa thoguo gũkũ?’ ”<verse eid="GEN 43:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 43:8" />Ningĩ Juda akĩĩra Isiraeli ithe atĩrĩ, “Njĩtĩkĩria thiĩ na kamwana gaka, na nĩtũgũthiĩ o ro rĩmwe, nĩgeetha wee na ithuĩ na ciana ciitũ tũtũũre muoyo, na tũtigakue. <verse eid="GEN 43:8" /><verse number="9" style="v" sid="GEN 43:9" />Niĩ mwene nĩngũmũrũgamĩrĩra wega; na nĩ niĩ ũkooria ũhoro wake. Ingĩkaaga kũmũcookia kũrĩ wee, na ndĩmũrũgamie mbere yaku-rĩ, nĩ ngaacookererwo nĩ ihĩtia rĩu matukũ ma muoyo wakwa wothe. <verse eid="GEN 43:9" /><verse number="10" style="v" sid="GEN 43:10" />Ũrĩa kũrĩ nĩ atĩ, korwo tũtinatindĩrĩra ũhoro ũyũ tũngĩthiĩte rĩa keerĩ na tũgacooka.”<verse eid="GEN 43:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 43:11" />Nake Isiraeli, ithe wao akĩmeera atĩrĩ, “Kũngĩkorwo no nginya athiĩ-rĩ, ĩkai ũũ: Ĩkĩrai maciaro marĩa mega mũno ma bũrũri ũyũ mondo-inĩ cianyu, mũikũrũkĩrie mũndũ ũcio marĩ kĩheo, na mahuti manini marĩa manungi wega na kaũũkĩ kanini, na ũbani na ũũkĩ-wa-ngoma ũrĩa wĩtagwo manemane, na njothi na rothi. <verse eid="GEN 43:11" /><verse number="12" style="v" sid="GEN 43:12" />Na mũkuue betha maita meerĩ, tondũ no nginya mũcookie betha iria ciacooketio mĩromo-inĩ ya makũnia manyu. No gũkorwo ũndũ ũcio wekirwo na mahĩtia. <verse eid="GEN 43:12" /><verse number="13" style="v" sid="GEN 43:13" />Oyai mũrũ wa thoguo o nake, mũcooke kũrĩ mũndũ ũcio o narua. <verse eid="GEN 43:13" /><verse number="14" style="v" sid="GEN 43:14" />Nake Ngai Mwene-Hinya-Wothe arotũma mũiguĩrwo tha nĩ mũndũ ũcio, nĩgeetha etĩkĩre mũcooke na mũrũ wa thoguo wanyu ũcio ũngĩ o na Benjamini. Hakwa-rĩ, akorwo nĩ ngũkuĩrwo-rĩ, nĩ nguĩrwo.”<verse eid="GEN 43:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 43:15" />Nĩ ũndũ ũcio andũ acio makĩoya iheo icio na betha maita meerĩ, na magĩthiĩ na Benjamini. Magĩikũrũka na ihenya Misiri na makĩĩneana kũrĩ Jusufu. <verse eid="GEN 43:15" /><verse number="16" style="v" sid="GEN 43:16" />Rĩrĩa Jusufu onire Benjamini arĩ hamwe nao-rĩ, akĩĩra mũnene wa nyũmba yake atĩrĩ, “Twara andũ aya gwakwa mũciĩ, ũthĩnje na ũthondeke irio cia mĩaraho; tondũ nĩ mekũrĩanĩra na niĩ mĩaraho.”<verse eid="GEN 43:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 43:17" />Nake mũndũ ũcio agĩĩka o ta ũrĩa Jusufu aamwĩrĩte, na akĩmatwara kwa Jusufu mũciĩ. <verse eid="GEN 43:17" /><verse number="18" style="v" sid="GEN 43:18" />Nao andũ acio nĩmamakire maatwarwo gwake mũciĩ. Magĩĩciiria atĩrĩ, “Twarehwo gũkũ nĩ ũndũ wa betha iria ciacookirio makũnia-inĩ maitũ hĩndĩ ya mbere. Arenda gũtũtharĩkĩra atũtoorie na atũtue ngombo ciake, na oe ndigiri ciitũ.”<verse eid="GEN 43:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 43:19" />Tondũ ũcio makĩambata magĩthiĩ kũrĩ mũnene wa nyũmba ya Jusufu, makĩmwarĩria marĩ hau mũromo-inĩ wa nyũmba. <verse eid="GEN 43:19" /><verse number="20" style="v" sid="GEN 43:20" />Makĩmwĩra atĩrĩ, “Twagũthaitha mwathi witũ, nĩ tuokire gũkũ hĩndĩ ya mbere kũgũra irio. <verse eid="GEN 43:20" /><verse number="21" style="v" sid="GEN 43:21" />No harĩa twarũgamire tũrarĩrĩre-rĩ, twatumũra makũnia maitũ o mũndũ agĩkora betha yake, o ũrĩa yoheetwo ĩrĩ mũromo-inĩ wa ikũnia. Nĩ ũndũ ũcio nĩ twacooka nacio. <verse eid="GEN 43:21" /><verse number="22" style="v" sid="GEN 43:22" />Na ningĩ nĩtuoka na betha ingĩ cia kũgũra irio. Tũtiũĩ nũũ wekĩrire betha ciitũ makũnia-inĩ maitũ.”<verse eid="GEN 43:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 43:23" />Nake akĩmeera atĩrĩ, “Gũtirĩ na thĩĩna, tigai gwĩtigĩra. Ngai wanyu, o we Ngai wa ithe wanyu, nĩwe wamũheire kĩgĩĩna makũnia-inĩ manyu; betha cianyu nĩndacĩamũkĩire.” Agĩcooka akĩmarehera Simeoni.<verse eid="GEN 43:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 43:24" />Ningĩ mũnene ũcio wa nyũmba ya Jusufu akĩmatwara mũciĩ kwa Jusufu, akĩmahe maaĩ ma gwĩthamba magũrũ, na akĩhe ndigiri ciao gĩa kũrĩa. <verse eid="GEN 43:24" /><verse number="25" style="v" sid="GEN 43:25" />Nao makĩhaarĩria iheo ciao cia kũhe Jusufu ooka mĩaraho, tondũ nĩmaiguĩte atĩ nĩmekũrĩa irio kuo.<verse eid="GEN 43:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 43:26" />Rĩrĩa Jusufu ookire mũciĩ-rĩ, makĩmũhe iheo iria maarehete kũu nyũmba-inĩ, na makĩinamĩrĩra, magĩturumithia mothiũ mao thĩ mbere yake. <verse eid="GEN 43:26" /><verse number="27" style="v" sid="GEN 43:27" />Nake akĩmahooya ũhoro, akĩmooria, “Mũkũrũ ũrĩa mwaheire ũhoro wake-rĩ, nĩ mũhoro? Arĩ o muoyo?”<verse eid="GEN 43:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 43:28" />Makĩmũcookeria atĩrĩ, “Ndungata yaku ũcio ithe witũ arĩ o muoyo na ndarĩ na ũũru.” Nao makĩinamĩrĩra mamũhe gĩtĩĩo.<verse eid="GEN 43:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 43:29" />Na aaroranga akĩona mũrũ wa nyina Benjamini, ũrĩa maaciaranĩirwo nake; akĩmooria atĩrĩ, “Ũyũ nĩwe mũrũ wa thoguo ũrĩa mũnini biũ, ũrĩa mwaheire ũhoro wake?” Agĩcooka akĩmwĩra atĩrĩ, “Mũrũ wakwa, Ngai arogũtuga.” <verse eid="GEN 43:29" /><verse number="30" style="v" sid="GEN 43:30" />Na rĩrĩ, aigua ta ekumwo nĩ ngoro nĩ kuona mũrũ wa nyina Benjamini-rĩ, Jusufu agĩkiuma na ihenya agĩthiĩ gũcaria handũ angĩrĩrĩra. Nake agĩthiĩ kanyũmba gake ga thĩinĩ akĩrĩrĩra kuo.<verse eid="GEN 43:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 43:31" />Na aarĩkia gwĩthamba ũthiũ akiuma, akĩĩyũmĩrĩria, akiuga atĩrĩ, “Igai irio metha-inĩ.”<verse eid="GEN 43:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 43:32" />Makĩigĩra Jusufu irio ciake arĩ wiki, na ariũ a ithe marĩ oiki, nao andũ a Misiri marĩ oiki, tondũ andũ a Misiri matingĩarĩanĩire na Ahibirania tondũ warĩ thaahu harĩo. <verse eid="GEN 43:32" /><verse number="33" style="v" sid="GEN 43:33" />Andũ acio maaikarĩtio mbere yake kũringana na ũkũrũ wao, kuuma irigithathi nginya ũrĩa warĩ mũnini biũ; nao makĩrorana o mũndũ na mũndũ nĩ kũgega. <verse eid="GEN 43:33" /><verse number="34" style="v" sid="GEN 43:34" />Rĩrĩa maihũrĩirwo irio kuuma metha-inĩ ya Jusufu-rĩ, rwĩga rwa Benjamini rwarĩ maita matano gũkĩra rwa arĩa angĩ. Nao makĩrĩa na makĩnyuuanĩra nake mategwĩtigĩra.<verse eid="GEN 43:34" /></para>
  <chapter eid="GEN 43" />
  <chapter number="44" style="c" sid="GEN 44" />
  <para style="s1">Gĩkombe kĩa Betha Ikũnia-inĩ rĩa Benjamini</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 44:1" />Nake Jusufu agĩatha mũnene wa nyũmba yake, akĩmwĩra atĩrĩ, “Iyũria makũnia ma andũ aya irio nyingĩ o ta ũrĩa mangĩhota gũkuua, na wĩkĩre betha ya mũndũ o mũndũ mũromo-inĩ wa ikũnia rĩake. <verse eid="GEN 44:1" /><verse number="2" style="v" sid="GEN 44:2" />Ningĩ wĩkĩre gĩkombe gĩakwa kĩrĩa kĩa betha mũromo-inĩ wa ikũnia rĩa ũrĩa mũnini biũ wao, hamwe na betha cia ngano yake.” Nake mũnene ũcio agĩĩka o ũrĩa Jusufu aamwĩrire.<verse eid="GEN 44:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 44:3" />Rũciinĩ gwakĩa-rĩ, andũ acio makiumagario hamwe na ndigiri ciao. <verse eid="GEN 44:3" /><verse number="4" style="v" sid="GEN 44:4" />Matanathiĩ kũraya na itũũra rĩu inene-rĩ, Jusufu akĩĩra mũnene wa nyũmba yake atĩrĩ, “Rũmĩrĩra andũ acio o rĩu, na wamakinyĩra ũmoorie atĩrĩ, ‘Mwarĩha wega na ũũru nĩkĩ? <verse eid="GEN 44:4" /><verse number="5" style="v" sid="GEN 44:5" />Githĩ gĩkombe gĩkĩ tikĩo mwathi wakwa anyuuaga nakĩo na akaragũra nakĩo? Ũndũ ũyũ mwĩkĩte nĩ ũndũ mũũru mũno.’ ”<verse eid="GEN 44:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 44:6" />Na rĩrĩa aamakinyĩrire-rĩ, agĩcookera ciugo icio kũrĩ o. <verse eid="GEN 44:6" /><verse number="7" style="v" sid="GEN 44:7" />Nao makĩmũũria atĩrĩ, “Mwathi witũ ekwaria maũndũ ta macio nĩkĩ? Ithuĩ ndungata ciaku tũroaga gwĩka ũndũ ta ũcio! <verse eid="GEN 44:7" /><verse number="8" style="v" sid="GEN 44:8" />Ithuĩ o na nĩtũragũcookeirie betha iria twakorire mĩromo-inĩ ya makũnia maitũ kuuma bũrũri wa Kaanani; nĩ kĩĩ kĩngĩtũma tũiye betha kana thahabu kuuma nyũmba ya mwathi waku? <verse eid="GEN 44:8" /><verse number="9" style="v" sid="GEN 44:9" />Ndungata o na ĩmwe yaku yakorwo ĩrĩ nakĩo-rĩ, no ĩgũkua, na ithuĩ aya angĩ tũtuĩke ngombo cia mwathi witũ.”<verse eid="GEN 44:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 44:10" />Nake akiuga atĩrĩ, “Nĩ wega, nĩgũtuĩke o ũguo mwoiga. Ũrĩa ũgũkorwo nakĩo nĩwe ũgũtuĩka ngombo yakwa; inyuĩ arĩa angĩ mũtirĩ na ũcuuke.”<verse eid="GEN 44:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 44:11" />O mũndũ o mũndũ agĩikũrũkia ikũnia rĩake thĩ na ihenya na akĩrĩtumũra. <verse eid="GEN 44:11" /><verse number="12" style="v" sid="GEN 44:12" />Nake mũnene ũcio wa nyũmba ya Jusufu akĩambĩrĩria gũcaria gĩkombe, ambĩrĩirie harĩ ũrĩa mũkũrũ wao na akĩrĩkĩrĩria harĩ ũrĩa mũnini biũ. Nakĩo gĩkombe kĩu gĩkĩoneka ikũnia-inĩ rĩa Benjamini. <verse eid="GEN 44:12" /><verse number="13" style="v" sid="GEN 44:13" />Nao moona ũguo-rĩ, magĩtembũranga nguo ciao. Magĩcooka makĩhaicia mĩrigo yao ndigiri igũrũ magĩcooka na thuutha kũu itũũra-inĩ inene.<verse eid="GEN 44:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 44:14" />Jusufu aarĩ o kũu nyũmba rĩrĩa Juda na ariũ a ithe maatoonyire kuo. Nao makĩĩgũithia thĩ mbere yake. <verse eid="GEN 44:14" /><verse number="15" style="v" sid="GEN 44:15" />Jusufu akĩmooria atĩrĩ, “Nĩ ũndũ ũrĩkũ ũyũ mwĩkĩte? Kaĩ mũtooĩ atĩ mũndũ ta niĩ no ahote kũmenya maũndũ na njĩra ya ũragũri?”<verse eid="GEN 44:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 44:16" />Juda akĩmũcookeria atĩrĩ, “Nĩ atĩa tũngĩĩra mwathi witũ? Tũngiuga atĩa? Tũngĩhota atĩa kuonania atĩ tũtiĩhĩtie? Ngai nĩwe ũguũrĩtie mahĩtia ma ndungata ciaku. Rĩu ithuĩ tũrĩ ngombo cia mwathi witũ, ithuothe ũndũ ũmwe na ũrĩa ũkorirwo na gĩkombe kĩu.”<verse eid="GEN 44:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 44:17" />No Jusufu akiuga atĩrĩ, “Ndĩroaga gwĩka ũndũ ta ũcio! Mũndũ ũrĩa ũkorirwo na gĩkombe kĩu nowe ũgũtuĩka ngombo yakwa. Inyuĩ aya angĩ, cookai kũrĩ ithe wanyu na thayũ.”<verse eid="GEN 44:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 44:18" />No Juda agĩthiĩ harĩ we, akiuga atĩrĩ, “Ndagũthaitha mwathi wakwa, ĩtĩkĩria ndungata yaku yarĩrie mwathi wakwa. Ndũkarakarĩre ndungata yaku o na gũtuĩka ũiganaine na Firaũni we mwene. <verse eid="GEN 44:18" /><verse number="19" style="v" sid="GEN 44:19" />Mwathi wakwa, wee woririe ndungata ciaku atĩrĩ, ‘Nĩ mũrĩ ithe wanyu kana mũrũ wa thoguo wanyu ũngĩ?’ <verse eid="GEN 44:19" /><verse number="20" style="v" sid="GEN 44:20" />Na ithuĩ tũgĩgũcookeria atĩrĩ, ‘Tũrĩ na ithe witũ mũthuuri mũkũrũ mũno, na kũrĩ kamwana kanini aaciarĩirwo ũkũrũ-inĩ wake. Mũrũ-wa-nyina na kamwana kau nĩ mũkuũ, na nowe wiki wa ariũ a nyina ũtigarĩte, na ithe nĩamwendete mũno.’<verse eid="GEN 44:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 44:21" />“Hĩndĩ ĩyo ũkĩĩra ndungata ciaku atĩrĩ, ‘Thiĩi mũmũikũrũkie mũmũrehe ndĩmwĩonere.’ <verse eid="GEN 44:21" /><verse number="22" style="v" sid="GEN 44:22" />Na ithuĩ tũkĩĩra mwathi witũ atĩrĩ, ‘Kamwana kau gatingiuma harĩ ithe; kangiuma harĩ we, ithe no gũkua angĩkua.’ <verse eid="GEN 44:22" /><verse number="23" style="v" sid="GEN 44:23" />No wee werire ndungata ciaku atĩrĩ, ‘Tiga mũũkire na mũrũ wa thoguo ũcio mũnini biũ, mũtikoona ũthiũ wakwa rĩngĩ.’ <verse eid="GEN 44:23" /><verse number="24" style="v" sid="GEN 44:24" />Na twainũka kũrĩ ndungata yaku ũcio ithe witũ, tũkĩmwĩra ũrĩa wee mwathi witũ woigĩte.<verse eid="GEN 44:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 44:25" />“Ningĩ ithe witũ agĩtwĩra atĩrĩ, ‘Cookai, mũthiĩ mũgũre irio ingĩ nini.’ <verse eid="GEN 44:25" /><verse number="26" style="v" sid="GEN 44:26" />No ithuĩ tũkĩmwĩra atĩrĩ, ‘Tũtingĩikũrũka kuo. No gũkorirwo nĩtũgũthiĩ na mũriũ waku ũyũ mũnini biũ. Tũtingĩona ũthiũ wa mũndũ ũcio tiga mũriũ waku ũyũ akorirwo na ithuĩ.’<verse eid="GEN 44:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 44:27" />“Nayo ndungata yaku ũcio ithe witũ agĩtwĩra atĩrĩ, ‘Inyuĩ nĩmũũĩ atĩ mũtumia wakwa Rakeli aanjiarĩire ariũ eerĩ. <verse eid="GEN 44:27" /><verse number="28" style="v" sid="GEN 44:28" />Ũmwe wacio nĩathiire na ndacooke, na niĩ ngiuga atĩrĩ, “Ti-itherũ nĩatambuurĩtwo nĩ nyamũ!” Na kuuma hĩndĩ ĩyo ndirĩ ndamuona rĩngĩ. <verse eid="GEN 44:28" /><verse number="29" style="v" sid="GEN 44:29" />Mũngĩoya ũyũ ũngĩ nake akoone mũtino-rĩ, mwatũma mbuĩ ici ciakwa ithiĩ mbĩrĩra na kĩeha.’<verse eid="GEN 44:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 44:30" />“Na rĩrĩ, kamwana gaka kangĩaga gũthiĩ na niĩ tũgacooka kũrĩ ndungata yaku ũcio baba, o baba ũcio muoyo wake wohanĩtio na muoyo wa kamwana gaka-rĩ, <verse eid="GEN 44:30" /><verse number="31" style="v" sid="GEN 44:31" />oone atĩ kamwana gaka tũtirĩ nako, no gũkua agaakua. Ithuĩ ndungata ciaku tũgĩikũrũkie mbuĩ cia ithe witũ mbĩrĩra-inĩ na kĩeha. <verse eid="GEN 44:31" /><verse number="32" style="v" sid="GEN 44:32" />Niĩ ndungata yaku-rĩ, nĩnderutĩire kũrĩ baba gũkamenyerera. Ngiuga atĩrĩ, ‘Ingĩkaaga gũgacookia kũrĩ we-rĩ, nĩngacookererwo nĩ ihĩtia rĩĩrĩ ndĩ mbere ya baba, matukũ mothe ma muoyo wakwa!’<verse eid="GEN 44:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 44:33" />“Na rĩu ndagũthaitha ũreke niĩ ndungata yaku ndigwo gũkũ nduĩke ngombo ya mwathi wakwa handũ ha kamwana gaka, na wĩtĩkĩrie kamwana gaka kainũke na ariũ a ithe. <verse eid="GEN 44:33" /><verse number="34" style="v" sid="GEN 44:34" />Ingĩhota atĩa kũinũka kũrĩ baba itarĩ na kamwana gaka? Aca! Ndũkareke ngoone kĩeha kĩrĩa kĩngĩnyiita baba.”<verse eid="GEN 44:34" /></para>
  <chapter eid="GEN 44" />
  <chapter number="45" style="c" sid="GEN 45" />
  <para style="s1">Jusufu Kwĩmenyithia kũrĩ Ariũ a Ithe</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 45:1" />Hĩndĩ ĩyo Jusufu akĩremwo nĩ kwĩyũmĩrĩria mbere ya arĩa othe maamũtungataga, akĩanĩrĩra na mũgambo mũnene, akiuga atĩrĩ, “Andũ othe nĩmehere harĩ niĩ!” Tondũ ũcio, hatiarĩ mũndũ o na ũmwe warĩ na Jusufu rĩrĩa emenyithanirie kũrĩ ariũ a ithe. <verse eid="GEN 45:1" /><verse number="2" style="v" sid="GEN 45:2" />Na akĩrĩra anĩrĩire o nginya andũ a Misiri makĩmũigua, o na andũ a nyũmba ya Firaũni makĩigua ũhoro wa kĩrĩro kĩu.<verse eid="GEN 45:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 45:3" />Jusufu akĩĩra ariũ a ithe atĩrĩ, “Nĩ niĩ Jusufu! Baba arĩ o muoyo?” No ariũ a ithe matiahotire kũmũcookeria, nĩgũkorwo nĩmamakĩte mũno marĩ mbere yake.<verse eid="GEN 45:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 45:4" />Ningĩ Jusufu akĩĩra ariũ a ithe atĩrĩ, “Ta nguhĩrĩriai.” Meeka ũguo-rĩ, akĩmeera atĩrĩ, “Nĩ niĩ mũrũ wa thoguo Jusufu, ũrĩa mwendirie Misiri! <verse eid="GEN 45:4" /><verse number="5" style="v" sid="GEN 45:5" />Na rĩu, mũtigathĩĩnĩke kana mwĩrakarĩre nĩkũnyendia gũkũ, tondũ nĩ Ngai wandũmire njũke mbere yanyu nĩgeetha honokie mĩoyo. <verse eid="GEN 45:5" /><verse number="6" style="v" sid="GEN 45:6" />Handũ-inĩ ha mĩaka ĩĩrĩ rĩu gũkoretwo na ngʼaragu bũrũri-inĩ, na mĩaka ĩtano ĩgũũka gũtigũkorwo na kũrĩma kana kũgetha. <verse eid="GEN 45:6" /><verse number="7" style="v" sid="GEN 45:7" />No Ngai aandũmire mbere yanyu nĩguo ndũme matigari manyu matũũre gũkũ thĩ, na honokie mĩoyo yanyu na kũhonokania kũnene.<verse eid="GEN 45:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 45:8" />“Nĩ ũndũ ũcio-rĩ, ti inyuĩ mwandũmire gũkũ, no nĩ Ngai. Na nĩanduĩte ta ithe wa Firaũni, na mwathi wa nyũmba yake yothe o na mwathi wa bũrũri wothe wa Misiri. <verse eid="GEN 45:8" /><verse number="9" style="v" sid="GEN 45:9" />Na rĩu hiũhai mũcooke kũrĩ baba mũmwĩre atĩrĩ, ‘Ũũ nĩguo mũrũguo Jusufu ekuuga: Ngai nĩanduĩte mwathi wa bũrũri wa Misiri guothe. Ikũrũka ũũke kũrĩ niĩ; ndũgaikare. <verse eid="GEN 45:9" /><verse number="10" style="v" sid="GEN 45:10" />Ũgũtũũra bũrũri wa Gosheni<note caller="+" style="f"><char style="fr" closed="false">45:10 </char><char style="ft" closed="false">Bũrũri wa Gosheni warĩ mũthia-inĩ wa Rũũĩ rwa Nili na nĩ kũndũ kwarĩ kũnoru mũno.</char></note> na ũkorwo ũrĩ hakuhĩ na niĩ, wee na ciana ciaku, na ciana cia ciana ciaku, na ndũũru ciaku cia mbũri na cia ngʼombe, na kĩrĩa gĩothe ũrĩ nakĩo. <verse eid="GEN 45:10" /><verse number="11" style="v" sid="GEN 45:11" />Kũu nĩkuo ndĩrĩgũteithagĩria tondũ kũrĩ na mĩaka ĩngĩ ĩtano ya ngʼaragu ĩtigarĩte. Kwaga ũguo wee na nyũmba yaku na andũ arĩa othe makwĩgiĩ nĩmũgũtuĩka athĩĩnĩki.’<verse eid="GEN 45:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 45:12" />“Inyuĩ nĩmũreyonera, o na Benjamini mũrũ wa maitũ akeyonera, atĩ nĩ niĩ mwene ndĩramwarĩria. <verse eid="GEN 45:12" /><verse number="13" style="v" sid="GEN 45:13" />Na mwĩre baba ũhoro wa gĩtĩĩo kĩrĩa gĩothe heetwo gũkũ Misiri, na ũrĩa wothe mwĩoneire, na mũikũrũkie baba gũkũ narua.”<verse eid="GEN 45:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 45:14" />Ningĩ akĩhĩmbĩria mũrũ wa nyina Benjamini na akĩrĩra, o nake Benjamini akĩmũhĩmbĩria akĩrĩraga. <verse eid="GEN 45:14" /><verse number="15" style="v" sid="GEN 45:15" />Na akĩmumunya ariũ a ithe othe na akĩmahĩmbĩria akĩrĩraga. Thuutha ũcio ariũ a ithe makĩaranĩria nake.<verse eid="GEN 45:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 45:16" />Na rĩrĩa ũhoro ũcio waiguirwo nyũmba-inĩ ya ũthamaki ya Firaũni, atĩ ariũ a ithe na Jusufu nĩmokĩte-rĩ, Firaũni na anene ake othe magĩkena. <verse eid="GEN 45:16" /><verse number="17" style="v" sid="GEN 45:17" />Firaũni akĩĩra Jusufu atĩrĩ, “Ĩra ariũ a thoguo atĩrĩ, ‘Ĩkai ũũ: Igĩrĩrai nyamũ cianyu mĩrigo mũcooke bũrũri wa Kaanani, <verse eid="GEN 45:17" /><verse number="18" style="v" sid="GEN 45:18" />na mũndehere ithe wanyu na andũ a nyũmba cianyu. Na niĩ nĩngamũhe kũndũ kũrĩa kwega mũno bũrũri-inĩ wa Misiri, na mũkenagĩre ũnoru wa bũrũri ũyũ.’<verse eid="GEN 45:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 45:19" />“Ningĩ nĩwathĩrĩrio ũmeere atĩrĩ: ‘Ĩkai ũũ: Oyai makaari mamwe kuuma gũkũ Misiri nĩ ũndũ wa ciana na atumia anyu, mũgĩĩre ithe wanyu mũũke. <verse eid="GEN 45:19" /><verse number="20" style="v" sid="GEN 45:20" />Na mũtigatindanĩre na indo cianyu tondũ maũndũ mothe marĩa mega mũno ma Misiri megũtuĩka manyu.’ ”<verse eid="GEN 45:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 45:21" />Nĩ ũndũ ũcio ariũ a Isiraeli magĩĩka o ro ũguo. Jusufu akĩmahe makaari o ta ũrĩa Firaũni aathanĩte na agĩcooka akĩmahe rĩĩgu wa rũgendo rwao. <verse eid="GEN 45:21" /><verse number="22" style="v" sid="GEN 45:22" />Ningĩ akĩhe o mũndũ o mũndũ wao nguo njerũ, no Benjamini-rĩ, akĩmũhe betha magana matatũ,<note caller="+" style="f"><char style="fr" closed="false">45:22 </char><char style="ft" closed="false">nĩ ta kilo ithatũ na nuthu (3.5).</char></note> na nguo ithano cia kũgarũrĩra. <verse eid="GEN 45:22" /><verse number="23" style="v" sid="GEN 45:23" />Na indo ici nĩcio aatũmĩire ithe: Ndigiri ikũmi ikuuĩte indo iria njega mũno cia Misiri, na ndigiri ingĩ ikũmi cia mĩgoma ikuuĩte ngano na mĩgate na rĩĩgu wake wa rũgendo. <verse eid="GEN 45:23" /><verse number="24" style="v" sid="GEN 45:24" />Agĩcooka akiumagaria ariũ a ithe, na magĩthiĩ akĩmeera atĩrĩ, “Mũtikanegenanie mũrĩ njĩra-inĩ!”<verse eid="GEN 45:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 45:25" />Nĩ ũndũ ũcio makĩambata makiuma Misiri, magĩthiĩ magĩkinya kũrĩ ithe wao Jakubu kũu bũrũri-inĩ wa Kaanani. <verse eid="GEN 45:25" /><verse number="26" style="v" sid="GEN 45:26" />Nao makĩmwĩra atĩrĩ, “Jusufu arĩ o muoyo! Na nĩwe mwathi wa bũrũri wothe wa Misiri.” Jakubu akĩgegeara; akĩaga kũmetĩkia. <verse eid="GEN 45:26" /><verse number="27" style="v" sid="GEN 45:27" />No rĩrĩa maamwĩrire maũndũ marĩa mothe Jusufu aamerĩte, na rĩrĩa onire makaari marĩa Jusufu aatũmĩte ma kũmũkuua mamũtware Misiri-rĩ, roho wa Jakubu ithe wao ũkĩarahũka. <verse eid="GEN 45:27" /><verse number="28" style="v" sid="GEN 45:28" />Nake Isiraeli akiuga atĩrĩ, “Nĩndetĩkia! Mũrũ wakwa Jusufu arĩ o muoyo. Nĩngũthiĩ ngamuone itanakua.”<verse eid="GEN 45:28" /></para>
  <chapter eid="GEN 45" />
  <chapter number="46" style="c" sid="GEN 46" />
  <para style="s1">Jakubu Gũthiĩ Misiri</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 46:1" />Nĩ ũndũ ũcio Isiraeli akiumagara na indo ciothe iria aarĩ nacio, na aakinya Birishiba-rĩ, akĩrutĩra Ngai wa ithe Isaaka magongona.<verse eid="GEN 46:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 46:2" />Nake Ngai akĩarĩria Isiraeli na kĩoneki ũtukũ, akĩmwĩra atĩrĩ, “Jakubu! Jakubu!”</para>
  <para style="p" vid="GEN 46:2">Nake agĩcookia atĩrĩ, “Niĩ ũyũ haha.”<verse eid="GEN 46:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 46:3" />Ngai akiuga atĩrĩ, “Nĩ niĩ Ngai, Ngai wa thoguo. Ndũgetigĩre gũikũrũka ũthiĩ Misiri, tondũ nĩngagũtua rũrĩrĩ rũnene mũno kũu. <verse eid="GEN 46:3" /><verse number="4" style="v" sid="GEN 46:4" />O na nĩngũikũrũkania nawe kũu Misiri, na ti-itherũ nĩ ngagũcookia gũkũ rĩngĩ. Nakuo guoko kwa Jusufu kuo kwene nĩkuo gũgaakũhinga maitho wakua.”<verse eid="GEN 46:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 46:5" />Hĩndĩ ĩyo Jakubu akiuma Birishiba, nao ariũ a Isiraeli magĩkuua ithe wao Jakubu na ciana ciao na atumia ao na makaari marĩa Firaũni aatũmĩte ma kũmũkuua. <verse eid="GEN 46:5" /><verse number="6" style="v" sid="GEN 46:6" />O na ningĩ magĩthiĩ na mahiũ mao na indo iria ciothe maagĩĩte nacio marĩ kũu Kaanani, na Jakubu na rũciaro rwake ruothe magĩthiĩ Misiri. <verse eid="GEN 46:6" /><verse number="7" style="v" sid="GEN 46:7" />Aathiire Misiri na ariũ ake na tũmwana twa ariũ ake, agĩthiĩ na airĩtu ake na tũirĩtu twa airĩtu ake, ũguo nĩ kuuga rũciaro rwake ruothe.<verse eid="GEN 46:7" /></para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" sid="GEN 46:8" />Maya nĩmo marĩĩtwa ma ariũ a Isiraeli (Jakubu na njiaro ciake) arĩa maathiire Misiri:</para>
  <para style="b" vid="GEN 46:8" />
  <para style="li1" vid="GEN 46:8">Rubeni irigithathi rĩa Jakubu.<verse eid="GEN 46:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="GEN 46:9" />Ariũ a Rubeni maarĩ:</para>
  <para style="li2" vid="GEN 46:9">Hanoku, na Palu, na Hezironi, na Karimi.<verse eid="GEN 46:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="GEN 46:10" />Ariũ a Simeoni maarĩ:</para>
  <para style="li2" vid="GEN 46:10">Jemueli, na Jamini, na Ohadi, na Jakini, na Zoharu, na Shauli mũrũ wa mũtumia ũrĩa Mũkaanani.<verse eid="GEN 46:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="GEN 46:11" />Ariũ a Lawi maarĩ:</para>
  <para style="li2" vid="GEN 46:11">Gerishoni, na Kohathu, na Merari.<verse eid="GEN 46:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="GEN 46:12" />Ariũ a Juda maarĩ:</para>
  <para style="li2" vid="GEN 46:12">Eri, na Onani, na Shela, na Perezu, na Zera (no Eri na Onani nĩmakuĩrĩire bũrũri wa Kaanani.)</para>
  <para style="li2" vid="GEN 46:12">Nao ariũ a Perezu maarĩ:</para>
  <para style="li3" vid="GEN 46:12">Hezironi na Hamuli.<verse eid="GEN 46:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="GEN 46:13" />Ariũ a Isakaru maarĩ:</para>
  <para style="li2" vid="GEN 46:13">Tola, na Puya, na Jashubu, na Shimuroni.<verse eid="GEN 46:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="GEN 46:14" />Ariũ a Zebuluni maarĩ:</para>
  <para style="li2" vid="GEN 46:14">Seredi, na Eloni, na Jahaleeli.<verse eid="GEN 46:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 46:15" />Acio nĩo ariũ arĩa Lea aaciarĩire Jakubu kũu Padani-Aramu, hamwe na mwarĩ Dina. Ariũ acio na airĩtu ake othe maarĩ mĩrongo ĩtatũ na atatũ.<verse eid="GEN 46:15" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="16" style="v" sid="GEN 46:16" />Ariũ a Gadi maarĩ:</para>
  <para style="li2" vid="GEN 46:16">Zifioni, na Hagi, na Shuni, na Eziboni, na Eri, na Arodi, na Areli.<verse eid="GEN 46:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="GEN 46:17" />Nao Ariũ a Asheri maarĩ:</para>
  <para style="li2" vid="GEN 46:17">Imuna, na Ishiva, na Ishivi, na Beria.</para>
  <para style="li2" vid="GEN 46:17">Mwarĩ wa nyina aarĩ Sera.</para>
  <para style="li2" vid="GEN 46:17">Ariũ a Beria maarĩ:</para>
  <para style="li3" vid="GEN 46:17">Heberi na Malikieli.<verse eid="GEN 46:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 46:18" />Icio nĩcio ciana iria ciaciarĩirwo Jakubu nĩ Zilipa, ũrĩa Labani aaheete mwarĩ Lea; ciothe ciarĩ ciana ikũmi na ithathatũ.<verse eid="GEN 46:18" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="19" style="v" sid="GEN 46:19" />Ariũ a Rakeli mũtumia wa Jakubu maarĩ:</para>
  <para style="li2" vid="GEN 46:19">Jusufu na Benjamini. <verse eid="GEN 46:19" /><verse number="20" style="v" sid="GEN 46:20" />Nake Jusufu arĩ kũu Misiri, nĩaciarĩirwo Manase na Efiraimu nĩ Asenathu mwarĩ wa Potifera, mũthĩnjĩri-ngai wa Onu.<verse eid="GEN 46:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="GEN 46:21" />Nao ariũ a Benjamini maarĩ:</para>
  <para style="li2" vid="GEN 46:21">Bela, na Bekeri, na Ashibeli, na Gera, na Naamani, na Ehi, na Roshu, na Mupimu, na Hupimu, na Aradi.<verse eid="GEN 46:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 46:22" />Acio nĩo ariũ a Rakeli arĩa maaciarĩirwo Jakubu othe maarĩ andũ ikũmi na ana.<verse eid="GEN 46:22" /></para>
  <para style="b" />
  <para style="li">
    <verse number="23" style="v" sid="GEN 46:23" />Mũriũ wa Dani aarĩ:</para>
  <para style="li2" vid="GEN 46:23">Hushimu.<verse eid="GEN 46:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="GEN 46:24" />Nao Ariũ a Nafitali maarĩ:</para>
  <para style="li2" vid="GEN 46:24">Jahazeeli, na Guni, na Jezeri, na Shilemu.<verse eid="GEN 46:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 46:25" />Acio nĩo ariũ arĩa maaciarĩirwo Jakubu nĩ Biliha ũrĩa Labani aaheete mwarĩ Rakeli, othe maarĩ mũgwanja.<verse eid="GEN 46:25" /></para>
  <para style="b" />
  <para style="p">
    <verse number="26" style="v" sid="GEN 46:26" />Andũ othe arĩa maathiire na Jakubu Misiri, arĩa maarĩ a njiaro ciake tũtegũtara atumia a ariũ ake, maarĩ andũ mĩrongo ĩtandatũ na atandatũ. <verse eid="GEN 46:26" /><verse number="27" style="v" sid="GEN 46:27" />Hamwe na ariũ arĩa eerĩ a Jusufu arĩa aaciarĩire Misiri, andũ a nyũmba ya Jakubu arĩa maathiire Misiri maarĩ mĩrongo mũgwanja.<verse eid="GEN 46:27" /></para>
  <para style="b" />
  <para style="p">
    <verse number="28" style="v" sid="GEN 46:28" />Nake Jakubu agĩtũma Juda athiĩ mbere yake kũrĩ Jusufu nĩgeetha athĩrĩrwo njĩra ya gũthiĩ Gosheni. Rĩrĩa maakinyire bũrũri wa Gosheni, <verse eid="GEN 46:28" /><verse number="29" style="v" sid="GEN 46:29" />Jusufu akĩhaarĩria ngaari yake ya mbarathi, na agĩthiĩ Gosheni gũtũnga ithe Isiraeli. Na Jusufu aakinya o ũguo harĩ ithe, akĩmũhĩmbĩria na akĩrĩra ihinda inene.<verse eid="GEN 46:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 46:30" />Nake Isiraeli akĩĩra Jusufu atĩrĩ, “Rĩu no ngĩkue, kuona atĩ nĩndeyonera niĩ mwene atĩ ũrĩ o muoyo.”<verse eid="GEN 46:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 46:31" />Hĩndĩ ĩyo Jusufu akĩĩra ariũ a ithe na andũ a nyũmba ya ithe atĩrĩ, Nĩngwambata thiĩ njarie na Firaũni, ndĩmwĩre atĩrĩ, Ariũ a baba, na nyũmba ya baba, arĩa maratũũraga bũrũri wa Kaanani, nĩmokĩte kũrĩ niĩ. <verse eid="GEN 46:31" /><verse number="32" style="v" sid="GEN 46:32" />Andũ acio nĩ arĩithi; marĩithagia mahiũ, na mokĩte na ndũũru ciao cia mbũri na cia ngʼombe, na indo ciothe ciao. <verse eid="GEN 46:32" /><verse number="33" style="v" sid="GEN 46:33" />Na rĩrĩa Firaũni arĩmwĩta na amũũrie atĩrĩ, “Inyuĩ mũrutaga wĩra ũrĩkũ?” <verse eid="GEN 46:33" /><verse number="34" style="v" sid="GEN 46:34" />mwagĩrĩirwo mũmũcookerie atĩrĩ, “Ithuĩ ndungata ciaku tũtũũraga tũrĩithagia mahiũ kuuma ũnini witũ, o ta ũrĩa maithe maitũ meekaga.” Hĩndĩ ĩyo nĩmũgetĩkĩrio mũtũũre mwena wa Gosheni, tondũ arĩithi othe moonagwo marĩ thaahu nĩ andũ a Misiri.<verse eid="GEN 46:34" /></para>
  <chapter eid="GEN 46" />
  <chapter number="47" style="c" sid="GEN 47" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 47:1" />Jusufu agĩthiĩ akĩĩra Firaũni atĩrĩ, “Baba na ariũ a baba hamwe na ndũũru ciao cia mbũri na cia ngʼombe na indo ciao ciothe nĩmokĩte kuuma bũrũri wa Kaanani, na rĩu marĩ Gosheni.” <verse eid="GEN 47:1" /><verse number="2" style="v" sid="GEN 47:2" />Ningĩ agĩthuura ariũ a ithe atano na akĩmatwara mbere ya Firaũni.<verse eid="GEN 47:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 47:3" />Firaũni akĩmooria atĩrĩ, “Mũrutaga wĩra ũrĩkũ?”</para>
  <para style="p" vid="GEN 47:3">Nao magĩcookeria Firaũni atĩrĩ, “Ithuĩ ndungata ciaku tũrĩ arĩithi, o ta ũrĩa maithe maitũ maarĩ.” <verse eid="GEN 47:3" /><verse number="4" style="v" sid="GEN 47:4" />Ningĩ makĩmwĩra atĩrĩ, “Tũũkĩte gũikara gũkũ kwa ihinda, tondũ ngʼaragu ĩno nĩ nene kũu Kaanani, na ndũũru cia ndungata ciaku nĩ ciagĩte ũrĩithio. Nĩ ũndũ ũcio twagũthaitha wĩtĩkĩrie ndungata ciaku itũũre Gosheni.”<verse eid="GEN 47:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 47:5" />Firaũni akĩĩra Jusufu atĩrĩ, “Thoguo na ariũ a thoguo mokĩte kũrĩ we, <verse eid="GEN 47:5" /><verse number="6" style="v" sid="GEN 47:6" />na bũrũri wa Misiri ũrĩ mbere yaku; he thoguo na ariũ a thoguo mwena ũrĩa mwega mũno wa bũrũri ũyũ. Reke maikare Gosheni. Na rĩrĩ, angĩkorwo nĩũũĩ amwe ao marĩ na ũũgĩ wa mwanya-rĩ, matue arũgamĩrĩri a mahiũ makwa.”<verse eid="GEN 47:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 47:7" />Ningĩ Jusufu akĩrehe ithe Jakubu mbere ya Firaũni. Na Jakubu aarĩkia kũrathima Firaũni-rĩ, <verse eid="GEN 47:7" /><verse number="8" style="v" sid="GEN 47:8" />Firaũni akĩmũũria atĩrĩ, “Ũrĩ na mĩaka ĩigana?”<verse eid="GEN 47:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 47:9" />Nake Jakubu akĩĩra Firaũni atĩrĩ, “Mĩaka yakwa ya kũũrũũra nĩ igana rĩmwe na mĩrongo ĩtatũ. Mĩaka yakwa ĩkoretwo ĩrĩ mĩnini na ya mĩtangĩko, na ndĩigana mĩaka ya kũũrũũra kwa maithe makwa.” <verse eid="GEN 47:9" /><verse number="10" style="v" sid="GEN 47:10" />Jakubu agĩcooka akĩrathima Firaũni na akĩehera akiuma hau Firaũni aarĩ.<verse eid="GEN 47:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 47:11" />Nĩ ũndũ ũcio Jusufu akĩhe ithe na ariũ a ithe ũtũũro kũu Misiri na akĩmahe mĩgũnda mwena ũrĩa mwega mũno wa bũrũri ũcio, rũgongo rwa Ramesese o ta ũrĩa Firaũni aathanĩte. <verse eid="GEN 47:11" /><verse number="12" style="v" sid="GEN 47:12" />Ningĩ Jusufu nĩaheaga ithe na ariũ a ithe na andũ a nyũmba ya ithe othe irio kũringana na mũigana wa ciana ciao.<verse eid="GEN 47:12" /></para>
  <para style="s1">Jusufu na Ngʼaragu</para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 47:13" />Na rĩrĩ, gũtiarĩ irio mwena ũcio wothe, tondũ ngʼaragu yarĩ nene mũno; na Misiri na Kaanani cierĩ nĩ ciahinyĩrĩrĩkĩte nĩ ũndũ wa ngʼaragu ĩyo. <verse eid="GEN 47:13" /><verse number="14" style="v" sid="GEN 47:14" />Jusufu akĩũngania mbeeca iria ciothe ingĩonekire bũrũri wa Misiri na wa Kaanani, irĩ irĩhi rĩa ngano ĩrĩa andũ maagũraga, nake agĩcitwara nyũmba-inĩ ya ũthamaki ya Firaũni. <verse eid="GEN 47:14" /><verse number="15" style="v" sid="GEN 47:15" />Na rĩrĩa mbeeca cia andũ a Misiri na cia andũ a Kaanani ciathirire-rĩ, andũ a Misiri othe magĩthiĩ kũrĩ Jusufu, makĩmwĩra atĩrĩ, “Tũhe irio. Tũngĩgĩkua ũtwĩroreire nĩkĩ? Mbeeca ciitũ nĩithirĩte biũ.”<verse eid="GEN 47:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 47:16" />Nake Jusufu akĩmacookeria atĩrĩ, “Ndeherai mahiũ manyu, na nĩngũmwenderia irio nĩ ũndũ wa mo tondũ mbeeca nĩ thiru.” <verse eid="GEN 47:16" /><verse number="17" style="v" sid="GEN 47:17" />Nĩ ũndũ ũcio magĩtwarĩra Jusufu mahiũ mao, nake akĩmakũũranĩria irio na mbarathi ciao, na ngʼondu na mbũri ciao, na ngʼombe na ndigiri ciao. Nake Jusufu akĩmateithĩrĩria mwaka ũcio wothe na irio, magĩcikũũrania na mahiũ mao mothe.<verse eid="GEN 47:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 47:18" />Naguo mwaka ũcio wathira-rĩ, magĩũka kũrĩ we mwaka ũyũ ũngĩ, makĩmwĩra atĩrĩ, “Tũtingĩhota kũhitha mwathi witũ ũndũ, kuona atĩ mbeeca ciitũ nĩithirĩte, na mahiũ maitũ rĩu nĩ maku, na gũtirĩ kĩndũ gĩtigaire kĩa mwathi witũ tiga mĩĩrĩ iitũ na ithaka ciitũ. <verse eid="GEN 47:18" /><verse number="19" style="v" sid="GEN 47:19" />Tũngĩgĩkua ũtwĩroreire nĩkĩ, ithuĩ na ithaka ciitũ hamwe? Tũgũranĩrie hamwe na ithaka ciitũ, ũtũhe irio, na ithuĩ na ithaka ciitũ tũtuĩke ngombo cia Firaũni. Tũhe mbeũ nĩgeetha tũtũũre muoyo, tũtigakue, na nĩguo bũrũri witũ ndũkanangĩke.”<verse eid="GEN 47:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 47:20" />Nĩ ũndũ ũcio Jusufu akĩgũrĩra Firaũni bũrũri wothe wa Misiri. Nao andũ a Misiri makĩendia ithaka ciao, mũndũ o mũndũ, nĩ ũndũ ngʼaragu nĩyamahatĩrĩirie mũno. Naguo bũrũri wothe ũgĩtuĩka wa Firaũni. <verse eid="GEN 47:20" /><verse number="21" style="v" sid="GEN 47:21" />Nake Jusufu agĩgĩtua andũ ngombo kuuma mwena ũmwe wa Misiri nginya ũrĩa ũngĩ. <verse eid="GEN 47:21" /><verse number="22" style="v" sid="GEN 47:22" />No rĩrĩ, ndaigana kũgũra ithaka cia athĩnjĩri-ngai akuo, tondũ o maarĩ na igai maaheagwo nĩ Firaũni, na maarĩ na irio cia kũmaigana kuuma kũrĩ igai rĩu Firaũni aamaheaga. Kĩu nĩkĩo gĩatũmire mage kwendia ithaka ciao.<verse eid="GEN 47:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 47:23" />Nake Jusufu akĩĩra andũ acio atĩrĩ, “Rĩu tondũ ũmũthĩ nĩndamũgũra hamwe na ithaka cianyu mũtuĩke a Firaũni-rĩ, mbeũ cianyu nĩcio ici; oyai mũkahaande mĩgũnda. <verse eid="GEN 47:23" /><verse number="24" style="v" sid="GEN 47:24" />No rĩrĩa mũkaagetha, mũkaahe Firaũni gĩcunjĩ gĩa gatano. Icunjĩ icio ingĩ inya harĩ ithano no mwĩigĩre irĩ mbeũ cia kũhaanda na irio cianyu ene na cia nyũmba cianyu, na cia ciana cianyu.”<verse eid="GEN 47:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 47:25" />Nao makiuga atĩrĩ, “Nĩwahonokia mĩoyo iitũ. Tũroogĩtĩkĩrĩka maitho-inĩ ma mwathi witũ; ithuĩ tũgũtũũra tũrĩ ngombo cia Firaũni.”<verse eid="GEN 47:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 47:26" />Nĩ ũndũ ũcio Jusufu akĩruta watho ũkoniĩ ithaka cia Misiri, na nĩũtũire nginya ũmũthĩ, atĩ gĩcunjĩ gĩa gatano kĩa magetha nĩ kĩa Firaũni. No ithaka cia athĩnjĩri-ngai akuo itaatuĩkire cia Firaũni.<verse eid="GEN 47:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 47:27" />Nao andũ a Isiraeli magĩtũũra Misiri bũrũri-inĩ wa Gosheni. Makĩgĩa na indo kuo na magĩciarana, makĩingĩha mũno.<verse eid="GEN 47:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 47:28" />Jakubu aikarire Misiri mĩaka ikũmi na mũgwanja, nayo mĩaka yake ĩrĩa aatũũrire muoyo yarĩ mĩaka igana rĩmwe na mĩrongo ĩna na mũgwanja. <verse eid="GEN 47:28" /><verse number="29" style="v" sid="GEN 47:29" />Na rĩrĩa ihinda rĩa Isiraeli rĩa gũkua rĩakuhĩrĩirie-rĩ, agĩtũmanĩra mũriũ wake Jusufu, akĩmwĩra atĩrĩ, “Angĩkorwo nĩnjĩtĩkĩrĩkĩte maitho-inĩ maku-rĩ, iga guoko gwaku rungu rwa kĩero gĩakwa, na ũnjĩĩre atĩ nĩũkanjĩka maũndũ ma ũtugi na ma wĩhokeku. Ndũkanaathike gũkũ Misiri, <verse eid="GEN 47:29" /><verse number="30" style="v" sid="GEN 47:30" />no rĩrĩa ngaahurũka hamwe na maithe makwa, ũkanguua, ũndute Misiri, ũgaathike o harĩa mathikĩtwo.”</para>
  <para style="p" vid="GEN 47:30">Nake Jusufu akiuga atĩrĩ, “Nĩngeeka o ũguo woiga.”<verse eid="GEN 47:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 47:31" />Nake Isiraeli akĩmwĩra atĩrĩ, “Wĩhĩte na mwĩhĩtwa.” Nake Jusufu akĩĩhĩta harĩ we na mwĩhĩtwa, nake Isiraeli akĩhooya enyiitĩrĩire mũthĩgi wake.<verse eid="GEN 47:31" /></para>
  <chapter eid="GEN 47" />
  <chapter number="48" style="c" sid="GEN 48" />
  <para style="s1">Manase na Efiraimu</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 48:1" />Thuutha-inĩ ũcio Jusufu akĩĩrwo atĩrĩ, “Thoguo nĩ mũrũaru.” Nĩ ũndũ ũcio akĩoya ariũ ake eerĩ, Manase na Efiraimu, agĩthiĩ kũmũrora. <verse eid="GEN 48:1" /><verse number="2" style="v" sid="GEN 48:2" />Na rĩrĩa Jakubu eerirwo atĩrĩ, “Mũrũguo Jusufu nĩoka gũkuona,” Isiraeli akĩĩyũmĩrĩria, agĩikara thĩ ũrĩrĩ-inĩ.<verse eid="GEN 48:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 48:3" />Jakubu akĩĩra Jusufu atĩrĩ, “Ngai Mwene-Hinya-Wothe nĩanyumĩrĩire ndĩ Luzu bũrũri-inĩ wa Kaanani, na akĩndathima, <verse eid="GEN 48:3" /><verse number="4" style="v" sid="GEN 48:4" />akĩnjĩĩra atĩrĩ, ‘Nĩngatũma ũciarane na ũingĩhe. Nĩngagũtua kĩrĩndĩ kĩa andũ, na nĩngaheana bũrũri ũyũ kũrĩ njiaro ciaku iria igooka thuutha waku ũtuĩke wacio tene na tene.’<verse eid="GEN 48:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 48:5" />“Rĩu-rĩ, ariũ aku eerĩ arĩa maaciarĩirwo gũkũ Misiri itanooka kũrĩ we-rĩ, megũtuuo ta marĩ akwa; Efiraimu na Manase meegũtuĩka akwa, o ta ũrĩa Rubeni na Simeoni marĩ akwa. <verse eid="GEN 48:5" /><verse number="6" style="v" sid="GEN 48:6" />Ciana iria ingĩ ũngĩciarĩrwo thuutha wao nĩ ciaku; kũrĩa makagaya mageetanagio na marĩĩtwa ma ariũ a ithe wao. <verse eid="GEN 48:6" /><verse number="7" style="v" sid="GEN 48:7" />Na rĩrĩa ndacookaga kuuma Padani, ngĩnyiitwo nĩ kĩeha gĩa gũkuĩrwo nĩ Rakeli kũu bũrũri-inĩ wa Kaanani tũrĩ o rũgendo-inĩ, hakuhĩ na Efiratha. Nĩ ũndũ ũcio ngĩmũthika hau mũkĩra-inĩ wa njĩra ya gũthiĩ Efiratha” (na nokuo Bethilehemu).<verse eid="GEN 48:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 48:8" />Na rĩrĩa Isiraeli onire ariũ a Jusufu, akĩũria atĩrĩ, “Aya nĩ a?”<verse eid="GEN 48:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 48:9" />Jusufu akĩĩra ithe atĩrĩ, “Nĩ ariũ akwa arĩa Ngai aaheete ndĩ gũkũ”.</para>
  <para style="p" vid="GEN 48:9">Nake Isiraeli akiuga atĩrĩ, “Mareharehe harĩ niĩ ndĩmarathime.”<verse eid="GEN 48:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 48:10" />Na rĩrĩ, maitho ma Isiraeli nĩmoorĩte nĩ gũkũra, na ndoonaga wega. Jusufu agĩkĩrehe ariũ ake hakuhĩ na Isiraeli, nake Jakubu akĩmamumunya na akĩmahĩmbĩria.<verse eid="GEN 48:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 48:11" />Isiraeli akĩĩra Jusufu atĩrĩ, “Ndieciragia nĩngona ũthiũ waku rĩngĩ, na rĩu Ngai nĩanjĩtĩkĩrĩtie nyone o na ciana ciaku.”<verse eid="GEN 48:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 48:12" />Nake Jusufu akĩmaruta maru-inĩ ma Isiraeli, akĩinamĩrĩria ũthiũ akĩũturumithia thĩ. <verse eid="GEN 48:12" /><verse number="13" style="v" sid="GEN 48:13" />Jusufu akĩoya ariũ ake eerĩ, Efiraimu arĩ mwena wake wa ũrĩo aamwerekeirie guoko-inĩ kwa ũmotho gwa Isiraeli, na Manase arĩ mwena wake wa ũmotho aamwerekeirie guoko-inĩ kwa ũrĩo gwa Isiraeli, akĩmarehe hakuhĩ nake. <verse eid="GEN 48:13" /><verse number="14" style="v" sid="GEN 48:14" />No Isiraeli agĩtambũrũkia guoko gwake kwa ũrĩo agĩkũigĩrĩra mũtwe wa Efiraimu, o na gũtuĩka nĩwe warĩ mũnini, na akĩhĩtũkania moko make, akĩigĩrĩra guoko gwake kwa ũmotho mũtwe-inĩ wa Manase, o na gũtuĩka Manase nĩwe warĩ irigithathi.<verse eid="GEN 48:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 48:15" />Ningĩ akĩrathima Jusufu, akiuga atĩrĩ,</para>
  <para style="q1" vid="GEN 48:15">“Ngai ũrĩa maithe makwa Iburahĩmu na Isaaka maatungatagĩra,</para>
  <para style="q1" vid="GEN 48:15">Ngai ũrĩa ũkoretwo arĩ mũrĩithi wakwa mũtũũrĩre-inĩ wakwa wothe nginya ũmũthĩ,<verse eid="GEN 48:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="GEN 48:16" />na Mũraika ũrĩa ũũhonoketie kuuma mĩtino-inĩ yothe,</para>
  <para style="q2" vid="GEN 48:16">arorathima imwana ici.</para>
  <para style="q1" vid="GEN 48:16">Iroetanagio na rĩĩtwa rĩakwa,</para>
  <para style="q2" vid="GEN 48:16">na ciĩtanagio na marĩĩtwa ma maithe makwa, Iburahĩmu na Isaaka,</para>
  <para style="q1" vid="GEN 48:16">na maroingĩha mũno gũkũ thĩ.”<verse eid="GEN 48:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 48:17" />Na rĩrĩa Jusufu onire atĩ ithe aigĩrĩire guoko gwake kwa ũrĩo mũtwe-inĩ wa Efiraimu-rĩ, ndaakenire; akĩnyiita guoko gwa ithe akweherie kuuma mũtwe-inĩ wa Efiraimu, akũigĩrĩre mũtwe-inĩ wa Manase. <verse eid="GEN 48:17" /><verse number="18" style="v" sid="GEN 48:18" />Jusufu akĩmwĩra atĩrĩ, “Aca, baba ũyũ nĩwe irigithathi; mũigĩrĩre guoko gwaku kwa ũrĩo mũtwe.”<verse eid="GEN 48:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 48:19" />No ithe akĩrega, akiuga atĩrĩ, “Nĩnjũũĩ ũguo mũrũ wakwa, nĩnjũũĩ. O nake nĩagatuĩka rũrĩrĩ, na nĩakaneneha. No rĩrĩ, mũrũ wa nyina ũrĩa mũnini nĩakaneneha kũmũkĩra, nacio njiaro ciake ituĩke gĩkundi kĩa ndũrĩrĩ.” <verse eid="GEN 48:19" /><verse number="20" style="v" sid="GEN 48:20" />Akĩmarathima mũthenya ũcio, akiuga atĩrĩ,</para>
  <para style="q1" vid="GEN 48:20">“Isiraeli akaarathimanaga akĩgwetaga rĩĩtwa rĩaku akoiga atĩrĩ:</para>
  <para style="q2" vid="GEN 48:20">‘Ngai arotũma ũtuĩke o ta Efiraimu na Manase.’ ”</para>
  <para style="m" vid="GEN 48:20">Nĩ ũndũ ũcio akĩgweta Efiraimu mbere ya Manase.<verse eid="GEN 48:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 48:21" />Ningĩ Isiraeli akĩĩra Jusufu atĩrĩ, “Ndĩ hakuhĩ gũkua, no Ngai nĩegũkorwo hamwe na inyuĩ, na nĩakamũcookia bũrũri-inĩ wa maithe manyu. <verse eid="GEN 48:21" /><verse number="22" style="v" sid="GEN 48:22" />Nawe, ũrĩ ta mwathi wa ariũ a thoguo-rĩ, nĩndakũhe rũgongo rwa bũrũri ũrĩa ndaatunyire Aamori na rũhiũ rwakwa rwa njora na ũta wakwa.”<verse eid="GEN 48:22" /></para>
  <chapter eid="GEN 48" />
  <chapter number="49" style="c" sid="GEN 49" />
  <para style="s1">Jakubu Kũrathima ariũ Ake</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 49:1" />Ningĩ Jakubu agĩtũmanĩra ariũ ake, akĩmeera atĩrĩ: “Cookanĩrĩrai haha nĩgeetha ndĩmwĩre ũrĩa gũgekĩka kũrĩ inyuĩ matukũ-inĩ marĩa magooka.<verse eid="GEN 49:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="GEN 49:2" />“Ũnganai na mũthikĩrĩrie, inyuĩ ariũ a Jakubu;</para>
  <para style="q2" vid="GEN 49:2">thikĩrĩriai Isiraeli ithe wanyu.<verse eid="GEN 49:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="GEN 49:3" />“Rubeni, ũrĩ irigithathi rĩakwa,</para>
  <para style="q2" vid="GEN 49:3">ũhoti wakwa, kĩonithania kĩa mbere kĩa hinya wakwa;</para>
  <para style="q2" vid="GEN 49:3">ũkĩrĩte arĩa angĩ na gũtĩĩka, ũkamakĩra na hinya.<verse eid="GEN 49:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="GEN 49:4" />Wagagĩte ta maaĩ, na nĩ ũndũ ũcio ndũgũcooka gũkĩra arĩa angĩ,</para>
  <para style="q2" vid="GEN 49:4">tondũ nĩwahaicire ũrĩrĩ wa thoguo,</para>
  <para style="q2" vid="GEN 49:4">ũgĩthaahia ũrĩrĩ wakwa.<verse eid="GEN 49:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="GEN 49:5" />“Simeoni na Lawi nĩ a nyina ũmwe,</para>
  <para style="q2" vid="GEN 49:5">hiũ ciao cia njora nĩ indo cia mbaara cia ũhinya.<verse eid="GEN 49:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="GEN 49:6" />Ngoro yakwa ndũkanatoonye ndundu-inĩ yao,</para>
  <para style="q2" vid="GEN 49:6">ndũkananyiitane na kĩũngano kĩao,</para>
  <para style="q1" vid="GEN 49:6">nĩgũkorwo nĩmooragĩte andũ marakarĩte,</para>
  <para style="q2" vid="GEN 49:6">na magatemanga ndegwa magũrũ macithuithie o ũrĩa mangĩendire.<verse eid="GEN 49:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="GEN 49:7" />Marakara mao mahiũ mũno,</para>
  <para style="q2" vid="GEN 49:7">na mangʼũrĩ mao matarĩ tha, maronyiitwo nĩ kĩrumi.</para>
  <para style="q1" vid="GEN 49:7">Ngaamaharagania thĩinĩ wa Jakubu</para>
  <para style="q2" vid="GEN 49:7">na ndĩmahurunjĩre thĩinĩ wa Isiraeli.<verse eid="GEN 49:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="GEN 49:8" />“Juda, ariũ a thoguo nĩmagagũkumia;</para>
  <para style="q2" vid="GEN 49:8">nakuo guoko gwaku nĩgũgatooria thũ ciaku;</para>
  <para style="q2" vid="GEN 49:8">ariũ a thoguo nĩmagakũinamĩrĩra.<verse eid="GEN 49:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="GEN 49:9" />Juda, we ũrĩ kĩana kĩa mũrũũthi, mũrũ wakwa;</para>
  <para style="q2" vid="GEN 49:9">we ũcookaga kuuma ũguĩmi-inĩ ũhũũnĩte ũguĩmi waku.</para>
  <para style="q1" vid="GEN 49:9">O ta mũrũũthi-rĩ, ethunaga na agakoma thĩ,</para>
  <para style="q2" vid="GEN 49:9">o ta mũrũũthi wa mũgoma-rĩ, nũũ ũngĩthĩgĩrĩria kũmwarahũra?<verse eid="GEN 49:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="GEN 49:10" />Rũthanju rwa ũthamaki rũtikoima harĩ Juda,</para>
  <para style="q2" vid="GEN 49:10">o na kana rũthanju rwa ũnene rũthenge gatagatĩ-inĩ ka magũrũ make,</para>
  <para style="q1" vid="GEN 49:10">o nginya agooka ũrĩa mwene ruo,</para>
  <para style="q2" vid="GEN 49:10">o we ũrĩa ũgaathĩkagĩrwo nĩ thĩ.<verse eid="GEN 49:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="GEN 49:11" />Akoohagĩrĩra ndigiri yake mũthabibũ-inĩ,</para>
  <para style="q2" vid="GEN 49:11">nayo njaũ yake ya ndigiri amĩohagĩrĩre rũhonge-inĩ rũrĩa rwega mũno.</para>
  <para style="q1" vid="GEN 49:11">Agaathambagia nguo ciake na ndibei,</para>
  <para style="q2" vid="GEN 49:11">na kanjũ ciake na ũtune wa thabibũ.<verse eid="GEN 49:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="GEN 49:12" />Maitho make makaira gũkĩra ndibei,</para>
  <para style="q2" vid="GEN 49:12">namo magego make merũhe gũkĩra iria.<verse eid="GEN 49:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="GEN 49:13" />“Zebuluni agaatũũra hũgũrũrũ-inĩ cia iria,</para>
  <para style="q2" vid="GEN 49:13">na atuĩke handũ hega ha gũikaragwo nĩ marikabu;</para>
  <para style="q2" vid="GEN 49:13">mĩhaka yake ĩgaakinya o Sidoni.<verse eid="GEN 49:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="GEN 49:14" />“Isakaru nĩ ndigiri ĩrĩa ĩrĩ hinya ĩkomete gatagatĩ ka mĩrigo ĩĩrĩ.<verse eid="GEN 49:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="GEN 49:15" />Rĩrĩa akoona ũrĩa ũhurũko wake ũrĩ mwega,</para>
  <para style="q2" vid="GEN 49:15">na ũrĩa bũrũri wake wagĩrĩte-rĩ,</para>
  <para style="q1" vid="GEN 49:15">no rĩo akainamĩrĩria kĩande gĩake akuue mĩrigo,</para>
  <para style="q2" vid="GEN 49:15">na etĩkĩre kũruta wĩra ũtarĩ mũcaara.<verse eid="GEN 49:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="GEN 49:16" />“Dani agaaciirĩrĩra andũ ake na kĩhooto,</para>
  <para style="q2" vid="GEN 49:16">arĩ ta mũhĩrĩga ũmwe wa Isiraeli.<verse eid="GEN 49:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="GEN 49:17" />Dani agaatuĩka ta nyoka ĩrĩ mũkĩra-inĩ wa njĩra,</para>
  <para style="q2" vid="GEN 49:17">atuĩke ta nduĩra ĩrĩ gacĩra-inĩ,</para>
  <para style="q1" vid="GEN 49:17">ĩrĩa ĩrũmaga ndiira cia mbarathi,</para>
  <para style="q2" vid="GEN 49:17">na tondũ ũcio mũmĩtwarithia akagũa na ngara.<verse eid="GEN 49:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="GEN 49:18" />“Wee Jehova-rĩ, njetereire kũhonokania gwaku.<verse eid="GEN 49:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="GEN 49:19" />“Gadi nĩagatharĩkĩrwo nĩ ikundi cia atunyani,</para>
  <para style="q2" vid="GEN 49:19">nowe nĩagacitharĩkĩra aciingatithie.<verse eid="GEN 49:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="GEN 49:20" />“Irio cia Asheri nĩ cia kũguna mwĩrĩ;</para>
  <para style="q2" vid="GEN 49:20">na akaaheanaga irio njega ingĩkenia mũthamaki.<verse eid="GEN 49:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="GEN 49:21" />“Nafitali nĩ ta thiiya ya mũgoma ĩrekereirio,</para>
  <para style="q2" vid="GEN 49:21">ĩrĩa ĩciaraga tũthiiya tũthaka.<verse eid="GEN 49:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="GEN 49:22" />“Jusufu nĩ mũthabibũ ũrĩa ũciaraga,</para>
  <para style="q2" vid="GEN 49:22">mũthabibũ ũrĩa ũciaraga ũrĩ hakuhĩ na gĩthima,</para>
  <para style="q2" vid="GEN 49:22">ũrĩa honge ciaguo itambagĩrĩra rũthingo.<verse eid="GEN 49:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="GEN 49:23" />Aikia a mĩguĩ nĩmamũtharĩkĩire marĩ na marũrũ;</para>
  <para style="q2" vid="GEN 49:23">makĩmũikĩria mĩguĩ marĩ na ũũru mũingĩ.<verse eid="GEN 49:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="GEN 49:24" />No ũta wake ndwenyenyekire,</para>
  <para style="q2" vid="GEN 49:24">moko make marĩ hinya magĩikara merũmĩtie nĩ ũndũ wa guoko kwa Mwene-Hinya wa Jakubu, na nĩ ũndũ wa Mũrĩithi,</para>
  <para style="q2" vid="GEN 49:24">o we Ihiga rĩa Isiraeli,<verse eid="GEN 49:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="GEN 49:25" />nĩ ũndũ wa Ngai wa thoguo, ũrĩa ũgũteithagia,</para>
  <para style="q2" vid="GEN 49:25">na tondũ wa Mwene-Hinya-Wothe,</para>
  <para style="q1" vid="GEN 49:25">ũrĩa ũkũrathimaga na irathimo cia igũrũ,</para>
  <para style="q2" vid="GEN 49:25">na irathimo cia kũrĩa kũriku mũhuro wa thĩ,</para>
  <para style="q2" vid="GEN 49:25">o na irathimo cia nyondo na cia nda.<verse eid="GEN 49:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="GEN 49:26" />Irathimo cia thoguo nĩ makĩria ma irathimo cia irĩma iria cia tene,</para>
  <para style="q2" vid="GEN 49:26">na nĩ makĩria ma ũtonga wa tũrĩma tũrĩa tũkũrũ.</para>
  <para style="q1" vid="GEN 49:26">Ici ciothe nĩirekwo ihurũke mũtwe-inĩ wa Jusufu,</para>
  <para style="q2" vid="GEN 49:26">o thiithi-inĩ wa ũcio ũhaana ta mwana wa mũthamaki harĩ ariũ a ithe.<verse eid="GEN 49:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="GEN 49:27" />“Benjamini ahaana ta njũũi ĩrĩa ngoroku;</para>
  <para style="q2" vid="GEN 49:27">kĩroko-inĩ atambuuraga kĩrĩa aguĩmĩte,</para>
  <para style="q2" vid="GEN 49:27">hwaĩ-inĩ akagayania kĩrĩa atahĩte.”<verse eid="GEN 49:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 49:28" />Ĩyo yothe nĩyo mĩhĩrĩga ĩrĩa ikũmi na ĩĩrĩ ya Isiraeli, na ũguo nĩguo ithe wao aameerire rĩrĩa aamarathimaga, akĩhe o mũndũ kĩrathimo kĩrĩa kĩamwagĩrĩire.<verse eid="GEN 49:28" /></para>
  <para style="s1">Gĩkuũ kĩa Jakubu</para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 49:29" />Ningĩ Jakubu akĩmahe mawatho maya: “Ndĩ hakuhĩ gũkua. Mũgaathika harĩa maithe makwa mathikĩtwo, ngurunga-inĩ ĩrĩa ĩrĩ gĩthaka-inĩ kĩa Efironi ũrĩa Mũhiti, <verse eid="GEN 49:29" /><verse number="30" style="v" sid="GEN 49:30" />ngurunga ĩrĩa ĩrĩ gĩthaka-inĩ kĩa Makipela hakuhĩ na Mamure kũu Kaanani, ĩrĩa Iburahĩmu aagũranĩirie na gĩthaka kĩu, ĩrĩ handũ ha gũthikana, kuuma kũrĩ Efironi ũrĩa Mũhiti. <verse eid="GEN 49:30" /><verse number="31" style="v" sid="GEN 49:31" />Hau nĩho Iburahĩmu na mũtumia wake Sara maathikirwo, na no ho Isaaka na Rebeka mũtumia wake maathikirwo, na no ho ndaathikire Lea. <verse eid="GEN 49:31" /><verse number="32" style="v" sid="GEN 49:32" />Gĩthaka kĩu na ngurunga ĩyo ciagũrirwo kuuma kũrĩ Ahethi.”<verse eid="GEN 49:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 49:33" />Nake Jakubu aarĩkia kũhe ariũ ake ũhoro ũcio-rĩ, agĩthuna magũrũ make arĩ o gĩtanda-inĩ, agĩtuĩkana, agĩcookanĩrĩrio kũrĩ andũ ao arĩa maakuĩte.<verse eid="GEN 49:33" /></para>
  <chapter eid="GEN 49" />
  <chapter number="50" style="c" sid="GEN 50" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 50:1" />Nake Jusufu agĩkĩĩgũithia thĩ mbere ya ithe, akĩmũrĩrĩra na akĩmũmumunya. <verse eid="GEN 50:1" /><verse number="2" style="v" sid="GEN 50:2" />Ningĩ agĩcooka agĩatha athondekani arĩa maarĩ ndungata ciake mathondeke mwĩrĩ wa ithe Isiraeli nĩguo ndũkabuthe. Nĩ ũndũ ũcio athondekani makĩmũthondeka, <verse eid="GEN 50:2" /><verse number="3" style="v" sid="GEN 50:3" />handũ ha ihinda rĩa thikũ mĩrongo ĩna, tondũ rĩu nĩrĩo ihinda rĩrĩa rĩabatarainie rĩa kũũthondeka. Nao andũ a Misiri makĩmũcakaĩra matukũ mĩrongo mũgwanja.<verse eid="GEN 50:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 50:4" />Namo matukũ ma kũmũcakaĩra maathira-rĩ, Jusufu akĩĩra kĩama kĩa Firaũni atĩrĩ, “Angĩkorwo nĩnjĩtĩkĩrĩkĩte maitho-inĩ manyu-rĩ, njarĩrĩriai kũrĩ Firaũni. Mwĩrei atĩrĩ, <verse eid="GEN 50:4" /><verse number="5" style="v" sid="GEN 50:5" />‘Baba nĩatũmire ndĩĩhĩte na mwĩhĩtwa, akiuga atĩrĩ, “Ndĩ hakuhĩ gũkua; na ndakua ũgaathika mbĩrĩra-inĩ ĩrĩa niĩ mwene ndeyenjeire bũrũri-inĩ wa Kaanani.” Rĩu rekei nyambate thiĩ ngathike baba; na nĩngũcooka hũndũke.’ ”<verse eid="GEN 50:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 50:6" />Nake Firaũni akĩmũtũmanĩra, akĩmwĩra atĩrĩ, “Ambata, ũthiĩ ũgathike thoguo, o ta ũrĩa aatũmire wĩhĩte.”<verse eid="GEN 50:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 50:7" />Nĩ ũndũ ũcio Jusufu akĩambata agĩthiĩ gũthika ithe. Nao anene othe a Firaũni magĩthiĩ nake, andũ a gĩtĩĩo othe a kĩama kĩa Firaũni o na andũ arĩa atĩĩku a Misiri othe, <verse eid="GEN 50:7" /><verse number="8" style="v" sid="GEN 50:8" />o hamwe na andũ othe a nyũmba ya Jusufu, na ariũ a ithe, na arĩa othe maarĩ a nyũmba ya ithe. No ciana ciki na ndũũru ciao cia mbũri na cia ngʼombe ciatigĩtwo Gosheni. <verse eid="GEN 50:8" /><verse number="9" style="v" sid="GEN 50:9" />Thigari cia ngaari cia ita na cia mbarathi o na cio igĩthiĩ nake. Kĩarĩ gĩkundi kĩnene mũno kĩa andũ.<verse eid="GEN 50:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 50:10" />Nao maakinya ihuhĩro-inĩ rĩa ngano rĩa Atadi, hakuhĩ na Jorodani, makĩrĩra manĩrĩire marĩ na ruo; na hau Jusufu agĩcakaĩra ithe matukũ mũgwanja. <verse eid="GEN 50:10" /><verse number="11" style="v" sid="GEN 50:11" />Na rĩrĩa Akaanani arĩa maatũũraga kũu moonire macakaya macio hau ihuhĩro-inĩ rĩa ngano rĩa Atadi, makĩĩrana atĩrĩ, “Andũ a Misiri marĩ na igongona rĩa macakaya ma kĩeha.” Na nĩkĩo handũ hau hakuhĩ na Jorodani heetagwo Abeli-Miziraimu.<verse eid="GEN 50:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 50:12" />Nĩ ũndũ ũcio ariũ a Jakubu magĩĩka o ũrĩa aamaathĩte: <verse eid="GEN 50:12" /><verse number="13" style="v" sid="GEN 50:13" />Makĩmũkuua makĩmũtwara bũrũri wa Kaanani, na makĩmũthika ngurunga-inĩ ĩrĩa yarĩ gĩthaka-inĩ kĩa Makipela, hakuhĩ na Mamure, ĩrĩa Iburahĩmu aagũranĩirie na gĩthaka kĩu kĩrĩ handũ ha gũthikanwo kuuma kũrĩ Efironi ũrĩa Mũhiti. <verse eid="GEN 50:13" /><verse number="14" style="v" sid="GEN 50:14" />Thuutha wa gũthika ithe-rĩ, Jusufu agĩcooka Misiri hamwe na ariũ a ithe na arĩa othe maathiĩte nake gũthika ithe.<verse eid="GEN 50:14" /></para>
  <para style="s1">Jusufu Kũũmĩrĩria Ariũ a Ithe</para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 50:15" />Na rĩrĩa ariũ a ithe moonire atĩ ithe wao nĩakua, makiuga atĩrĩ, “Ĩ angĩkorwo Jusufu nĩatũũire atũiguagĩra ũũru, na atũrĩhie maũru marĩa mothe twamwĩkire?” <verse eid="GEN 50:15" /><verse number="16" style="v" sid="GEN 50:16" />Nĩ ũndũ ũcio magĩtũmana kũrĩ Jusufu makiuga atĩrĩ, “Thoguo atanakua nĩatigire oiga atĩrĩ: <verse eid="GEN 50:16" /><verse number="17" style="v" sid="GEN 50:17" />‘Ũũ nĩguo mũkeera Jusufu: ndagũthaitha ũrekere ariũ a thoguo mehia na mahĩtia marĩa meekire nĩ ũndũ nĩmagwĩkire ũũru mũno.’ Na rĩu twagũthaitha wohere ndungata cia Ngai wa thoguo mehia macio.” Na rĩrĩa ndũmĩrĩri yao yamũkinyĩire, Jusufu akĩrĩra.<verse eid="GEN 50:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 50:18" />Ariũ a ithe magĩcooka magĩthiĩ kũrĩ we, makĩĩgũithia thĩ mbere yake, makiuga atĩrĩ, “Tũrĩ ngombo ciaku.”<verse eid="GEN 50:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 50:19" />No Jusufu akĩmeera atĩrĩ, “Tigai gwĩtigĩra. Kaĩ niĩ akĩrĩ niĩ Ngai? <verse eid="GEN 50:19" /><verse number="20" style="v" sid="GEN 50:20" />Inyuĩ mwaciirĩte kũnjĩka ũũru, no Ngai aanjiirĩire ũndũ mwega nĩguo akinyanĩrie ũrĩa kũrekĩka rĩu, ũhoro wa kũhonokia mĩoyo ya andũ aingĩ. <verse eid="GEN 50:20" /><verse number="21" style="v" sid="GEN 50:21" />Nĩ ũndũ ũcio-rĩ, mũtigetigĩre. Nĩndĩĩmũheaga irio cianyu na cia ciana cianyu.” Nake akĩmomĩrĩria na akĩmarĩria wega.<verse eid="GEN 50:21" /></para>
  <para style="s1">Gĩkuũ kĩa Jusufu</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 50:22" />Jusufu agĩikara Misiri, hamwe na andũ othe a nyũmba ya ithe. Aatũũrire muoyo mĩaka igana rĩmwe na ikũmi, <verse eid="GEN 50:22" /><verse number="23" style="v" sid="GEN 50:23" />na akĩona rũciaro rwa gatatũ rwa ciana cia Efiraimu. O na ciana cia Makiru mũrũ wa Manase ciaciarwo nĩciaigĩrĩirwo maru-inĩ ma Jusufu.<verse eid="GEN 50:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 50:24" />Ningĩ Jusufu akĩĩra ariũ a ithe atĩrĩ, “Ndĩ hakuhĩ gũkua. No rĩrĩ, ti-itherũ Ngai nĩagooka kũmũrora amũteithie na amũrute kuuma bũrũri ũyũ, amũtware bũrũri ũrĩa erĩire Iburahĩmu, na Isaaka na Jakubu na mwĩhĩtwa.” <verse eid="GEN 50:24" /><verse number="25" style="v" sid="GEN 50:25" />Nake Jusufu agĩtũma ariũ a Isiraeli mehĩte na mwĩhĩtwa, akĩmeera atĩrĩ, “Ti-itherũ Ngai nĩagooka kũmũteithia, na hĩndĩ ĩyo yakinya no nginya mũgaakuua mahĩndĩ makwa kuuma kũndũ gũkũ.”<verse eid="GEN 50:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 50:26" />Nĩ ũndũ ũcio Jusufu agĩkua, arĩ na ũkũrũ wa mĩaka igana rĩmwe na ikũmi. Thuutha wa kũmũthondeka ndakabuthe, makĩmũiga ithandũkũ-inĩ rĩa gũthikwo narĩo o kũu Misiri.<verse eid="GEN 50:26" /></para>
  <chapter eid="GEN 50" />
</usx>