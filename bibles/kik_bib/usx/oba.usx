<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="OBA" style="id">- Biblica® Open Kikuyu Holy Word of God</book>
  
  <para style="h">Obadia</para>
  <para style="toc1">Obadia</para>
  <para style="toc2">Obadia</para>
  <para style="toc3">Obad</para>
  <para style="mt1">OBADIA</para>
  <chapter number="1" style="c" sid="OBA 1" />
  <para style="p">
    <verse number="1" style="v" sid="OBA 1:1" />Kĩoneki kĩa Obadia.</para>
  <para style="q1" vid="OBA 1:1">Mwathani Jehova ekuuga ũũ ũhoro ũkoniĩ Edomu:</para>
  <para style="b" vid="OBA 1:1" />
  <para style="q1" vid="OBA 1:1">Nĩtũiguĩte ũhoro uumĩte kũrĩ Jehova.</para>
  <para style="q2" vid="OBA 1:1">Mũtũmwo nĩatũmirwo kũrĩ ndũrĩrĩ oige atĩrĩ,</para>
  <para style="q1" vid="OBA 1:1">“Arahũkai, tũthiĩ tũmũũkĩrĩre, tũrũe nake”:<verse eid="OBA 1:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="OBA 1:2" />“Atĩrĩrĩ, nĩngakũnyiihia maitho-inĩ ma ndũrĩrĩ;</para>
  <para style="q2" vid="OBA 1:2">nawe nĩũkameneka biũ.<verse eid="OBA 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="OBA 1:3" />Mwĩtĩĩo wa ngoro yaku nĩũkũheenetie,</para>
  <para style="q2" vid="OBA 1:3">wee ũtũũraga kũu ngurunga-inĩ cia mahiga,</para>
  <para style="q2" vid="OBA 1:3">na ũgathondeka gĩikaro gĩaku kũrĩa gũtũũgĩru,</para>
  <para style="q1" vid="OBA 1:3">o wee wĩĩraga na ngoro atĩrĩ,</para>
  <para style="q2" vid="OBA 1:3">‘Nũũ ũngĩhota kũũharũrũkia andehe nginya thĩ?’<verse eid="OBA 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="OBA 1:4" />O na ũngĩkorwo ũmbũkaga na igũrũ ta nderi,</para>
  <para style="q2" vid="OBA 1:4">na ũgaaka gĩtara gĩaku o kũu njata irĩ,</para>
  <para style="q2" vid="OBA 1:4">nĩngakũharũrũkia thĩ ngũrute kuo,”</para>
  <para style="q4" vid="OBA 1:4">ũguo nĩguo Jehova ekuuga.<verse eid="OBA 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="OBA 1:5" />“Ũngĩkorwo nĩ aici,</para>
  <para style="q2" vid="OBA 1:5">o na kana ũkorwo nĩ atunyani ũtukũ-rĩ,</para>
  <para style="q1" vid="OBA 1:5">kaĩ mwanangĩko nĩũgwetereire-ĩ!</para>
  <para style="q2" vid="OBA 1:5">Githĩ matingĩiya o nginya maiganie?</para>
  <para style="q1" vid="OBA 1:5">Atui a thabibũ mangĩũka gwaku-rĩ,</para>
  <para style="q2" vid="OBA 1:5">githĩ to matigie tũthabibũ tũnini tũngĩhaarwo?<verse eid="OBA 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="OBA 1:6" />No kaĩ Esaũ nĩakongũrũrio-ĩ,</para>
  <para style="q2" vid="OBA 1:6">nakĩo kĩgĩĩna gĩake kĩrĩa kĩhithe gĩgĩtahwo-ĩ!<verse eid="OBA 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="OBA 1:7" />Andũ othe arĩa mũgwatanagĩra nao nĩmagakũingata nginya mũhaka-inĩ;</para>
  <para style="q2" vid="OBA 1:7">arata aku nĩmagakũheenia na magũtoorie;</para>
  <para style="q1" vid="OBA 1:7">arĩa marĩĩaga irio ciaku nĩmagakũigĩra mũtego,</para>
  <para style="q2" vid="OBA 1:7">no wee ndũkamenya.”<verse eid="OBA 1:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="OBA 1:8" />Jehova ekuuga atĩrĩ,</para>
  <para style="q2" vid="OBA 1:8">“Githĩ mũthenya ũcio ndikaananga andũ arĩa oogĩ a Edomu,</para>
  <para style="q2" vid="OBA 1:8">na nyanange andũ arĩa marĩ ũmenyo kũu irĩma-inĩ cia Esaũ?<verse eid="OBA 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="OBA 1:9" />Atĩrĩrĩ, wee Temani,<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="ft" closed="false">Rĩĩtwa Temani nĩ kuuga Edomu guothe, na rĩgĩtaũrwo nĩ kuuga “Gũthini.”</char></note> njamba ciaku cia ita nĩikaamaka,</para>
  <para style="q2" vid="OBA 1:9">na andũ othe arĩa matũũraga irĩma-inĩ cia Esaũ</para>
  <para style="q2" vid="OBA 1:9">mooragwo, maniinwo.<verse eid="OBA 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="OBA 1:10" />Nĩ ũndũ wa ngũĩ ya gũũkĩrĩra mũrũ wa nyũkwa Jakubu,</para>
  <para style="q2" vid="OBA 1:10">nĩũgaconorithio;</para>
  <para style="q2" vid="OBA 1:10">nĩũkaniinwo nginya tene.<verse eid="OBA 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="OBA 1:11" />Mũthenya ũrĩa wamũtiganĩirie,</para>
  <para style="q2" vid="OBA 1:11">rĩrĩa andũ a kũngĩ maatahire ũtonga wake,</para>
  <para style="q1" vid="OBA 1:11">nao ageni magĩtoonyera ihingo-inĩ ciake,</para>
  <para style="q2" vid="OBA 1:11">na magĩcuukĩra Jerusalemu mĩtĩ-rĩ,</para>
  <para style="q2" vid="OBA 1:11">we watariĩ o ta ũmwe wao.<verse eid="OBA 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="OBA 1:12" />No wee ndũngĩanyararire mũrũ wa nyũkwa</para>
  <para style="q2" vid="OBA 1:12">mũthenya wake wa mũtino,</para>
  <para style="q1" vid="OBA 1:12">kana ũkenerere andũ a Juda</para>
  <para style="q2" vid="OBA 1:12">mũthenya ũrĩa maaniinagwo,</para>
  <para style="q1" vid="OBA 1:12">o na kana wĩtĩĩe mũno</para>
  <para style="q2" vid="OBA 1:12">mũthenya ũrĩa maarĩ na thĩĩna.<verse eid="OBA 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="OBA 1:13" />Wee ndũngĩatuĩkanĩirie ihingo-inĩ cia andũ akwa</para>
  <para style="q2" vid="OBA 1:13">mũthenya wao wa mwanangĩko,</para>
  <para style="q1" vid="OBA 1:13">kana ũmanyarare hĩndĩ ĩrĩa maarĩ na mũnyarirĩko</para>
  <para style="q2" vid="OBA 1:13">mũthenya wao wa kwanangwo,</para>
  <para style="q1" vid="OBA 1:13">kana ũtahe ũtonga wao</para>
  <para style="q2" vid="OBA 1:13">mũthenya ũcio wa mwanangĩko.<verse eid="OBA 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="OBA 1:14" />Wee ndwagĩrĩirwo kũmooheria magomano-inĩ ma njĩra</para>
  <para style="q2" vid="OBA 1:14">nĩguo ũũrage arĩa mooraga,</para>
  <para style="q1" vid="OBA 1:14">kana ũneane matigari mao</para>
  <para style="q2" vid="OBA 1:14">mũthenya ũcio maarĩ na thĩĩna.<verse eid="OBA 1:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="OBA 1:15" />“Mũthenya wa Jehova ũrĩ hakuhĩ</para>
  <para style="q2" vid="OBA 1:15">gũkinyĩra ndũrĩrĩ ciothe.</para>
  <para style="q1" vid="OBA 1:15">O ũrĩa wĩkĩte, noguo nawe ũgeekwo;</para>
  <para style="q2" vid="OBA 1:15">ciĩko ciaku nĩigagũcookerera.<verse eid="OBA 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="OBA 1:16" />O ta ũrĩa inyuĩ mwanyuĩrĩire gĩkombe gĩakwa kĩa iherithia kũu kĩrĩma-inĩ gĩakwa gĩtheru-rĩ,</para>
  <para style="q2" vid="OBA 1:16">ũguo noguo ndũrĩrĩ ciothe igaakĩnyuĩra itegũtigithĩria.</para>
  <para style="q1" vid="OBA 1:16">Ikaanyua ikĩhũhũte,</para>
  <para style="q2" vid="OBA 1:16">ininũkio, nacio ihaane ta itarĩ ciakorwo kuo.<verse eid="OBA 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="OBA 1:17" />No rĩrĩ, kũu Kĩrĩma-inĩ gĩa Zayuni nĩgũgakorwo na ũhonokio;</para>
  <para style="q2" vid="OBA 1:17">nakĩo kĩrĩma kĩu gĩgaakorwo kĩrĩ gĩtheru,</para>
  <para style="q1" vid="OBA 1:17">nayo nyũmba ya Jakubu</para>
  <para style="q2" vid="OBA 1:17">nĩĩkegwatĩra igai rĩayo.<verse eid="OBA 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="OBA 1:18" />Nyũmba ya Jakubu ĩgaatuĩka ta mwaki,</para>
  <para style="q2" vid="OBA 1:18">nayo nyũmba ya Jusufu ĩtuĩke ta rũrĩrĩmbĩ;</para>
  <para style="q1" vid="OBA 1:18">nayo nyũmba ya Esaũ ĩgaatuĩka ta maragara ma mahuti,</para>
  <para style="q2" vid="OBA 1:18">na nĩmakamĩmundia mwaki, ũmĩniine biũ.</para>
  <para style="q1" vid="OBA 1:18">Gũtirĩ mũndũ ũgaatigara</para>
  <para style="q2" vid="OBA 1:18">wa kuuma nyũmba ya Esaũ.”</para>
  <para style="q4" vid="OBA 1:18">Jehova nĩwe uugĩte ũguo.<verse eid="OBA 1:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="OBA 1:19" />Andũ a Negevu nĩmagaikara</para>
  <para style="q2" vid="OBA 1:19">irĩma-inĩ cia Esaũ,</para>
  <para style="q1" vid="OBA 1:19">nao andũ arĩa maikaraga magũrũ-inĩ ma tũrĩma</para>
  <para style="q2" vid="OBA 1:19">megwatĩre bũrũri wa Afilisti.</para>
  <para style="q1" vid="OBA 1:19">Nĩmagaikara mĩgũnda-inĩ ya Efiraimu, na ya Samaria,</para>
  <para style="q2" vid="OBA 1:19">nake Benjamini egwatĩre Gileadi.<verse eid="OBA 1:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="OBA 1:20" />Gĩkundi kĩrĩa gĩatahĩtwo kĩa andũ a Isiraeli kĩrĩa kĩrĩ kũu Kaanani,</para>
  <para style="q2" vid="OBA 1:20">gĩkeegwatĩra bũrũri ũcio o nginya Zarefathu;<note caller="+" style="f"><char style="fr" closed="false">1:20 </char><char style="ft" closed="false">Zarefathu gwĩciiragĩrio nokuo Sefaradi, itũũra rĩa Asia Nini.</char></note></para>
  <para style="q1" vid="OBA 1:20">nao andũ arĩa maatahirwo kuuma Jerusalemu, acio marĩ kũu Sefaradi,</para>
  <para style="q2" vid="OBA 1:20">nĩo makegwatĩra matũũra ma Negevu.<verse eid="OBA 1:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="OBA 1:21" />Andũ a kũhonokania nĩmakambata Kĩrĩma-inĩ gĩa Zayuni</para>
  <para style="q2" vid="OBA 1:21">nĩguo maathanage kũu irĩma-inĩ cia Esaũ.</para>
  <para style="q2" vid="OBA 1:21">Naguo ũthamaki ũgaatuĩka wa Jehova.<verse eid="OBA 1:21" /></para>
  <chapter eid="OBA 1" />
</usx>