<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1TH" style="id">- Biblica® Open Kikuyu Holy Word of God</book>
  
  <para style="h">1 Athesalonike</para>
  <para style="toc1">1 Athesalonike</para>
  <para style="toc2">1 Athesalonike</para>
  <para style="toc3">1Athe</para>
  <para style="mt1">MARŨA MA MBERE MA PAŨLŨ KŨRĨ ATHESALONIKE</para>
  <chapter number="1" style="c" sid="1TH 1" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 1:1" />Nĩ ithuĩ Paũlũ na Sila, na Timotheo,</para>
  <para style="b" vid="1TH 1:1" />
  <para style="p" vid="1TH 1:1">Twandĩkĩra kanitha wa Athesalonike marũa maya ũrĩa ũrĩ thĩinĩ wa Ngai Ithe witũ o na Mwathani Jesũ Kristũ.</para>
  <para style="b" vid="1TH 1:1" />
  <para style="p" vid="1TH 1:1">Wega na thayũ wa Ngai irogĩa na inyuĩ.<verse eid="1TH 1:1" /></para>
  <para style="s1">Gũcookia Ngaatho nĩ ũndũ wa Wĩtĩkio wa Athesalonike</para>
  <para style="p">
    <verse number="2" style="v" sid="1TH 1:2" />Nĩtũcookagĩria Ngai ngaatho hĩndĩ ciothe nĩ ũndũ wanyu inyuothe, tũkĩmũgwetaga mahooya-inĩ maitũ. <verse eid="1TH 1:2" /><verse number="3" style="v" sid="1TH 1:3" />Rĩrĩa tũkũmũhoera tũrĩ mbere ya Ngai o we Ithe witũ-rĩ, nĩtũririkanaga tũtegũtigithĩria wĩra wanyu ũrĩa uumanĩte na gwĩtĩkia, na kwĩnogia kwanyu kũrĩa kũrehagwo nĩ wendani, o na gũkirĩrĩria kwanyu, kũrĩa kuumanĩte na kĩĩrĩgĩrĩro thĩinĩ wa Mwathani witũ Jesũ Kristũ.<verse eid="1TH 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1TH 1:4" />Nĩgũkorwo, ariũ na aarĩ a Ithe witũ inyuĩ mwendetwo nĩ Ngai, ithuĩ nĩtũũĩ atĩ nĩmwathuurirwo nĩwe, <verse eid="1TH 1:4" /><verse number="5" style="v" sid="1TH 1:5" />tondũ Ũhoro-ũrĩa-Mwega tũhunjagia, tũtiamũreheire ũrĩ o ciugo theri, no twamũreheire ũrĩ na hinya, na ũrĩ na Roho Mũtheru, o na ũrĩ na ihooto itangĩthanganio. Ningĩ inyuĩ nĩmũũĩ ũrĩa twaikaraga na inyuĩ nĩ ũndũ wa kũmũguna. <verse eid="1TH 1:5" /><verse number="6" style="v" sid="1TH 1:6" />Inyuĩ mwatuĩkire a kwĩgerekania na ithuĩ, o na mũgĩtuĩka a kwĩgerekania na Mwathani, o na gũtuĩka mwarĩ na mĩnyamaro mĩingĩ, nĩmwamũkĩrire ũhoro wake mũrĩ na gĩkeno kĩrĩa kĩheanagwo nĩ Roho Mũtheru. <verse eid="1TH 1:6" /><verse number="7" style="v" sid="1TH 1:7" />Na nĩ ũndũ ũcio mũgĩtuĩka kĩonereria kũrĩ andũ arĩa othe metĩkĩtie kũu Makedonia, o na Akaia. <verse eid="1TH 1:7" /><verse number="8" style="v" sid="1TH 1:8" />Naguo ũhoro wa Mwathani nĩwahunjire uumĩte kũrĩ inyuĩ, na to Makedonia na Akaia gwiki, no rĩrĩ, o na wĩtĩkio wanyu thĩinĩ wa Ngai nĩũmenyekete kũndũ guothe. Nĩ ũndũ ũcio tũtibataire kuuga ũndũ ũhoro-inĩ ũcio, <verse eid="1TH 1:8" /><verse number="9" style="v" sid="1TH 1:9" />nĩgũkorwo andũ o ene nĩo maheanaga ũhoro wa ũrĩa mwatũnyiitire ũgeni. Nĩmaheanaga ũhoro wa ũrĩa mwagarũrũkĩire Ngai, mũgĩtigana na mĩhianano nĩguo mũtungatagĩre Ngai ũrĩa ũrĩ muoyo na ũrĩa wa ma, <verse eid="1TH 1:9" /><verse number="10" style="v" sid="1TH 1:10" />na mwetagĩrĩre Mũriũ oime igũrũ, ũrĩa aariũkirie kuuma kũrĩ arĩa akuũ, nake nĩwe Jesũ, ũrĩa ũtũhonokagia kuuma kũrĩ mangʼũrĩ marĩa magooka.<verse eid="1TH 1:10" /></para>
  <chapter eid="1TH 1" />
  <chapter number="2" style="c" sid="1TH 2" />
  <para style="s1">Ũtungata wa Paũlũ kũu Thesalonike</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 2:1" />Inyuĩ ariũ na aarĩ a Ithe witũ, nĩmũũĩ atĩ gũũka gwitũ kũrĩ inyuĩ gũtiarĩ gwa tũhũ. <verse eid="1TH 2:1" /><verse number="2" style="v" sid="1TH 2:2" />Mbere ĩyo nĩtwathĩĩnirio na tũkĩrumwo rĩrĩa twarĩ kũu Filipi, o ta ũrĩa inyuĩ mũũĩ, no nĩ ũndũ wa gũteithio nĩ Ngai witũ, nĩtuomĩrĩirie na tũkĩmũhe Ũhoro-ũrĩa-Mwega, o na akorwo nĩtwakararirio mũno. <verse eid="1TH 2:2" /><verse number="3" style="v" sid="1TH 2:3" />Nĩgũkorwo gũthaithana gwitũ gũtiumanĩte na ihĩtia, kana matanya ma maũndũ ma waganu, o na kana ma wara. <verse eid="1TH 2:3" /><verse number="4" style="v" sid="1TH 2:4" />No rĩrĩ, ithuĩ nĩ kwaria twaragia ta andũ maamũrĩtwo nĩ Ngai a kwĩhokerwo Ũhoro-ũrĩa-Mwega. Ithuĩ ti andũ tũrageria gũkenia, no nĩ Ngai, o we ũgeragia ngoro ciitũ. <verse eid="1TH 2:4" /><verse number="5" style="v" sid="1TH 2:5" />Inyuĩ nĩmũũĩ atĩ ithuĩ ti ndeto cia kwĩyendereria twaragia, o na kana tũkahithĩrĩra ũhoro wa gũkorokera indo; Ngai nĩwe mũira witũ. <verse eid="1TH 2:5" /><verse number="6" style="v" sid="1TH 2:6" />Ithuĩ tũtiacaragia kũganwo nĩ andũ, arĩ inyuĩ kana mũndũ ũngĩ o wothe.</para>
  <para style="p" vid="1TH 2:6">Tondũ tũrĩ atũmwo a Kristũ-rĩ, nĩtũngĩatuĩkire mũrigo kũrĩ inyuĩ, <verse eid="1TH 2:6" /><verse number="7" style="v" sid="1TH 2:7" />no nĩtwaikarire na inyuĩ tũhooreire, o ta ũrĩa nyina wa ciana nini amenyagĩrĩra ciana ciake mwene. <verse eid="1TH 2:7" /><verse number="8" style="v" sid="1TH 2:8" />Nĩ tondũ wa ũrĩa twamwendete mũno, nĩtwakenagio nĩkũgwatanĩra na inyuĩ, na to Ũhoro-inĩ-ũrĩa-Mwega wa Ngai wiki, no nĩtwagwatanĩire mĩtũũrĩre-inĩ iitũ o nayo, tondũ nĩmwatuĩkĩte andũ twendete mũno. <verse eid="1TH 2:8" /><verse number="9" style="v" sid="1TH 2:9" />Ti-itherũ nĩmũkũririkana, inyuĩ ariũ na aarĩ a Ithe witũ, wĩra witũ wa hinya na kwĩnogia gwitũ; twarutaga wĩra ũtukũ na mũthenya nĩguo tũtigatuĩke mũrigo harĩ mũndũ o na ũrĩkũ hĩndĩ ĩrĩa twamũhunjagĩria Ũhoro-ũrĩa-Mwega wa Ngai.<verse eid="1TH 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1TH 2:10" />Inyuĩ mũrĩ aira, o na Ngai no mũira, ũrĩa twatũire na inyuĩ arĩa mwĩtĩkĩtie tũrĩ atheru, na tũrĩ athingu, na tũtarĩ na ũcuuke. <verse eid="1TH 2:10" /><verse number="11" style="v" sid="1TH 2:11" />Ningĩ nĩmũũĩ atĩ twekaga mũndũ o mũndũ wanyu o ta ũrĩa ithe wa ciana ekaga ciana ciake mwene, <verse eid="1TH 2:11" /><verse number="12" style="v" sid="1TH 2:12" />tũkamũmagĩrĩria, na tũkamũhooreragia, o na tũkamũringagĩrĩria mũtũũre mĩtũũrĩre yaganĩrĩire na ũrĩa Ngai endaga, o we ũmwĩtaga mũtoonye thĩinĩ wa ũthamaki wake, na mũgĩe na riiri wake.<verse eid="1TH 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 2:13" />O na ningĩ nĩtũcookagĩria Ngai ngaatho tũtegũtigithĩria tondũ rĩrĩa mwamũkĩrire kiugo kĩa Ngai, kĩrĩa mwaiguire kuuma kũrĩ ithuĩ, mũtiakĩamũkĩrire taarĩ kiugo kĩa andũ, no mwakĩamũkĩrire ta kiugo kĩa Ngai, na nĩ ma, ũguo nĩguo kĩrĩ, na nĩkĩo kĩrutaga wĩra thĩinĩ wanyu inyuĩ mwĩtĩkĩtie. <verse eid="1TH 2:13" /><verse number="14" style="v" sid="1TH 2:14" />Nĩgũkorwo inyuĩ, ariũ na aarĩ a Ithe witũ, nĩmwatuĩkire a kwĩgerekania na makanitha ma Ngai marĩa marĩ thĩinĩ wa Kristũ Jesũ kũrĩa Judea: Nĩmwanyamaririo nĩ andũ a bũrũri wanyu na mĩnyamaro o ĩrĩa andũ a makanitha macio maanyamaragio nayo nĩ Ayahudi, <verse eid="1TH 2:14" /><verse number="15" style="v" sid="1TH 2:15" />o arĩa mooragire Mwathani Jesũ, na makĩũraga anabii, o na ithuĩ magĩtũingata. Nĩmarakaragia Ngai, na nĩ marĩ ũthũ na andũ othe <verse eid="1TH 2:15" /><verse number="16" style="v" sid="1TH 2:16" />nĩ ũndũ wa kũgeria gũtũgiria tũtikahunjĩrie andũ-a-Ndũrĩrĩ ũhoro nĩgeetha mahonoke. Ũguo nĩguo meyongagĩrĩra mehia makamaiyũrĩrĩra. Namo mangʼũrĩ ma Ngai nĩmamakinyĩire.<verse eid="1TH 2:16" /></para>
  <para style="s1">Paũlũ Kwĩrirĩria kuona Athesalonike</para>
  <para style="p">
    <verse number="17" style="v" sid="1TH 2:17" />No rĩrĩ, ariũ na aarĩ a Ithe witũ, hĩndĩ ĩrĩa twatigithanirio na inyuĩ gwa kahinda kanini-rĩ, (ha ũhoro wa mwĩrĩ, no ti wa ngoro), nĩtwerutanĩirie na kĩyo kĩnene nĩgeetha tuonane na inyuĩ tondũ nĩtwamwĩriragĩria mũno. <verse eid="1TH 2:17" /><verse number="18" style="v" sid="1TH 2:18" />Nĩgũkorwo nĩtwendete mũno gũũka kũrĩ inyuĩ, na makĩria niĩ Paũlũ, nĩndageririe maita maingĩ no Shaitani nĩatũgiririe. <verse eid="1TH 2:18" /><verse number="19" style="v" sid="1TH 2:19" />Nĩ ũndũ-rĩ, kĩĩrĩgĩrĩro giitũ gĩkĩrĩ kĩrĩkũ, kana gĩkeno giitũ, kana thũmbĩ ĩrĩa tũngĩĩraha nayo mbere ya Mwathani witũ Jesũ rĩrĩa agooka? Githĩ ti inyuĩ? <verse eid="1TH 2:19" /><verse number="20" style="v" sid="1TH 2:20" />Ti-itherũ, inyuĩ nĩ inyuĩ riiri witũ na gĩkeno giitũ.<verse eid="1TH 2:20" /></para>
  <chapter eid="1TH 2" />
  <chapter number="3" style="c" sid="1TH 3" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 3:1" />Nĩ ũndũ ũcio, rĩrĩa twaremirwo nĩgũkirĩrĩria-rĩ, nĩtuonire arĩ wega tũtigwo tũrĩ ithuiki kũu Athene. <verse eid="1TH 3:1" /><verse number="2" style="v" sid="1TH 3:2" />Tũgĩgĩtũma Timotheo ũrĩa mũrũ wa Ithe witũ, na ndungata ya Ngai hamwe na ithuĩ ya kũhunjia Ũhoro-ũrĩa-Mwega wa Kristũ, nĩguo amwĩkĩre hinya, na amũũmĩrĩrie wĩtĩkio-inĩ wanyu, <verse eid="1TH 3:2" /><verse number="3" style="v" sid="1TH 3:3" />nĩguo gũtikagĩe mũndũ ũngĩagagio nĩ magerio macio. Inyuĩ nĩmũũĩ wega atĩ nĩmo twathĩrĩirio. <verse eid="1TH 3:3" /><verse number="4" style="v" sid="1TH 3:4" />Ti-itherũ o na hĩndĩ ĩrĩa twarĩ na inyuĩ nĩtwamwĩraga kaingĩ atĩ no nginya tũnyariirwo. O ta ũrĩa mũũĩ atĩ ũguo noguo gwacookire gũgĩtuĩka. <verse eid="1TH 3:4" /><verse number="5" style="v" sid="1TH 3:5" />Nĩ ũndũ ũcio, rĩrĩa ndaremirwo nĩgũkirĩrĩria rĩngĩ-rĩ, ngĩtũmana nĩguo menye ũhoro wa wĩtĩkio wanyu. Nĩgũkorwo nĩndetigagĩra gũtigakorwo atĩ hihi mũgerania nĩamũgeretie, naguo wĩra witũ ũtuĩke wa tũhũ.<verse eid="1TH 3:5" /></para>
  <para style="s1">Ndũmĩrĩri ya Timotheo ya Kũũmanĩrĩria</para>
  <para style="p">
    <verse number="6" style="v" sid="1TH 3:6" />No rĩrĩ, rĩu Timotheo nĩ okĩte kũrĩ ithuĩ oimĩte kũrĩ inyuĩ, na agatũrehere ũhoro mwega ũkoniĩ wĩtĩkio na wendani wanyu. Nĩatwĩrĩte atĩ nĩmũtũririkanaga hĩndĩ ciothe mũkenete, na atĩ nĩmwĩriragĩria gũtuona, o ta ũrĩa o na ithuĩ twĩriragĩria kũmuona. <verse eid="1TH 3:6" /><verse number="7" style="v" sid="1TH 3:7" />Nĩ ũndũ ũcio, ariũ na aarĩ a Ithe witũ-rĩ, o na tũrĩ na mĩnyamaro na mathĩĩna nĩtuomĩrĩirio twaigua ũhoro wanyu nĩ tondũ wa gwĩtĩkia kũu kwanyu. <verse eid="1TH 3:7" /><verse number="8" style="v" sid="1TH 3:8" />Nĩgũkorwo rĩu tũgũtũũra muoyo kũna, kuona atĩ nĩmwĩhaandĩte wega thĩinĩ wa Mwathani. <verse eid="1TH 3:8" /><verse number="9" style="v" sid="1TH 3:9" />Tũngĩhota atĩa gũcookeria Ngai ngaatho cia kũigana nĩ ũndũ wanyu, tondũ wa gĩkeno kĩrĩa gĩothe tũrĩ nakĩo mbere ya Ngai witũ nĩ ũndũ wanyu? <verse eid="1TH 3:9" /><verse number="10" style="v" sid="1TH 3:10" />Nĩtũhooyaga ũtukũ na mũthenya na kĩyo kĩingĩ nĩgeetha tũkoonana na inyuĩ rĩngĩ na tũmũrehere kĩrĩa mũtarĩ nakĩo ũhoro-inĩ wa gwĩtĩkia kwanyu.<verse eid="1TH 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TH 3:11" />Rĩu-rĩ, Ngai mwene, o Ithe witũ, na Mwathani witũ Jesũ, marotũhingũrĩra njĩra tũhote gũũka kũrĩ inyuĩ. <verse eid="1TH 3:11" /><verse number="12" style="v" sid="1TH 3:12" />Mwathani arotũma wendani wanyu wongerereke na ũiyũrĩrĩre harĩ o mũndũ na ũrĩa ũngĩ, na harĩ andũ arĩa angĩ othe, o ta ũrĩa o na ithuĩ tũmwendete. <verse eid="1TH 3:12" /><verse number="13" style="v" sid="1TH 3:13" />Ningĩ aroĩkĩra ngoro cianyu hinya nĩgeetha mũgaakorwo mũtarĩ na ũcuuke, na mũrĩ atheru mbere ya Ngai, o we Ithe witũ, hĩndĩ ĩrĩa Mwathani witũ Jesũ agooka hamwe na andũ ake arĩa atheru othe.<verse eid="1TH 3:13" /></para>
  <chapter eid="1TH 3" />
  <chapter number="4" style="c" sid="1TH 4" />
  <para style="s1">Mũtũũrĩre wa Gũkenia Ngai</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 4:1" />Naguo ũhoro wa kũrigĩrĩria, ariũ na aarĩ a Ithe witũ-rĩ, nĩ atĩ nĩtwamũrutire ũhoro wa mũtũũrĩre, ũrĩa ũkenagia Ngai, na noguo mũtũũraga mwĩkaga. Rĩu tũkũmũũria na tũkamũringĩrĩria thĩinĩ wa Mwathani Jesũ atĩ mũkĩragĩrĩrie gwĩkaga o ũguo. <verse eid="1TH 4:1" /><verse number="2" style="v" sid="1TH 4:2" />Nĩgũkorwo nĩmũũĩ maũndũ marĩa twamũtaarire namo, tũrĩ na ũhoti wa Mwathani Jesũ.<verse eid="1TH 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TH 4:3" />Tondũ rĩĩrĩ, ũndũ ũrĩa Ngai endete nĩ atĩ mũtuĩke andũ aamũre: atĩ mwĩtheemage ũmaraya; <verse eid="1TH 4:3" /><verse number="4" style="v" sid="1TH 4:4" />na atĩ o ũmwe wanyu amenye gwatha mwĩrĩ wake mwene ũikarage ũrĩ mũtheru na akĩũtĩĩaga, <verse eid="1TH 4:4" /><verse number="5" style="v" sid="1TH 4:5" />atarĩ na merirĩria ma mwĩrĩ ta andũ a ndũrĩrĩ arĩa matooĩ Ngai; <verse eid="1TH 4:5" /><verse number="6" style="v" sid="1TH 4:6" />na atĩ ha ũhoro wa maũndũ macio, gũtigakorwo mũndũ o na ũrĩkũ ũngĩhĩtĩria mũrũ na mwarĩ wa ithe, kana amwĩke ũũru. Mwathani nĩakaherithia andũ nĩ ũndũ wa mehia mothe ta macio, o ta ũrĩa tũrĩkĩtie kũmwĩra na tũkamũkaania. <verse eid="1TH 4:6" /><verse number="7" style="v" sid="1TH 4:7" />Tondũ Ngai ndatwĩtĩire maũndũ ma waganu, no aatwĩtire nĩguo tũtũũre mũtũũrĩre wa ũtheru. <verse eid="1TH 4:7" /><verse number="8" style="v" sid="1TH 4:8" />Nĩ ũndũ ũcio-rĩ, mũndũ ũrĩa ũkũregana na ũrutani ũyũ ti mũndũ araregana nake no nĩ Ngai, ũrĩa ũmũheaga inyuĩ Roho wake Mũtheru.<verse eid="1TH 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 4:9" />Na rĩu-rĩ, harĩ ũhoro wa kwendana na ariũ na aarĩ a Ithe witũ-rĩ, tũtibataire kũmwandĩkĩra nĩ ũndũ inyuĩ ene nĩmũrutĩtwo kwendanaga nĩ Ngai. <verse eid="1TH 4:9" /><verse number="10" style="v" sid="1TH 4:10" />Na ti-itherũ, nĩmwendete ariũ na aarĩ a Ithe witũ othe arĩa marĩ Makedonia guothe. No nĩtũkũmũringĩrĩria inyuĩ ariũ na aarĩ a Ithe witũ, atĩ mũkĩragĩrĩrie gwĩka ũguo makĩria.<verse eid="1TH 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TH 4:11" />Atĩrĩrĩ, mwĩrirĩriei gũtũũra mũtũũrĩre wa ũhooreri, na mũhangʼagĩre o maũndũ marĩa mamũkoniĩ, na mũrutage wĩra na moko manyu, o ta ũrĩa twamwĩrire, <verse eid="1TH 4:11" /><verse number="12" style="v" sid="1TH 4:12" />nĩgeetha mũtũũrĩre wanyu wa o mũthenya, ũtũme mũheagwo gĩtĩĩo nĩ andũ arĩa matarĩ a thiritũ yanyu, na nĩgeetha mũtigatuĩke mũrigo kũrĩ mũndũ o na ũrĩkũ.<verse eid="1TH 4:12" /></para>
  <para style="s1">Gũcooka kwa Mwathani</para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 4:13" />No rĩrĩ, ariũ na aarĩ a Ithe witũ, tũtikwenda mũikarage mũtooĩ ũhoro wa andũ arĩa makomete, kana mũigue kĩeha ta andũ arĩa angĩ matarĩ na kĩĩrĩgĩrĩro. <verse eid="1TH 4:13" /><verse number="14" style="v" sid="1TH 4:14" />Nĩtwĩtĩkĩtie atĩ Jesũ nĩakuire na akĩriũka, na nĩ ũndũ ũcio nĩtwĩtĩkĩtie atĩ Ngai nĩakarehanĩria Jesũ hamwe na andũ arĩa makomete marĩ thĩinĩ wake. <verse eid="1TH 4:14" /><verse number="15" style="v" sid="1TH 4:15" />Kũringana na kiugo kĩa Mwathani we mwene, tũkũmwĩra atĩ ithuĩ arĩa tũrĩ muoyo, arĩa tũtigĩtwo nginya rĩrĩa agacooka tũtigatongoria arĩa marĩkĩtie gũkoma. <verse eid="1TH 4:15" /><verse number="16-17" style="v" sid="1TH 4:16-17" />Thuutha wa ũguo, ithuĩ arĩa tũgaakorwo tũrĩ muoyo na tũtigaire-rĩ, nĩtũkoyanĩrio hamwe nao tũtwarwo matu-inĩ nĩguo tũgacemanie na Mwathani rĩera-inĩ. Na nĩ ũndũ ũcio tũgaatũũrania na Mwathani nginya tene. <verse eid="1TH 4:16-17" /><verse number="18" style="v" sid="1TH 4:18" />Nĩ ũndũ ũcio, ũmanagĩrĩriai mũndũ na ũrĩa ũngĩ na ciugo icio.<verse eid="1TH 4:18" /></para>
  <chapter eid="1TH 4" />
  <chapter number="5" style="c" sid="1TH 5" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 5:1" />Na rĩrĩ, ariũ na aarĩ a Ithe witũ, ũhoro wa mahinda na mĩthenya-rĩ, tũtirĩ na bata wa kũmwandĩkĩra, <verse eid="1TH 5:1" /><verse number="2" style="v" sid="1TH 5:2" />nĩgũkorwo nĩmũũĩ wega atĩ mũthenya wa Mwathani ũgooka o ta ũrĩa mũici okaga ũtukũ. <verse eid="1TH 5:2" /><verse number="3" style="v" sid="1TH 5:3" />O rĩrĩa andũ maroiga atĩrĩ, “Kũrĩ thayũ na ũgitĩri,” hĩndĩ ĩyo nĩguo magaakorererwo nĩ mwanangĩko o rĩmwe, o ta ũrĩa mũtumia ũrĩ nda akoragĩrĩrwo nĩ ruo rwa kũheo mwana, nao matikahonoka.<verse eid="1TH 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1TH 5:4" />No inyuĩ ariũ na aarĩ a Ithe witũ, mũtirĩ nduma-inĩ atĩ nĩguo mũthenya ũcio ũmũkorerere ta mũici. <verse eid="1TH 5:4" /><verse number="5" style="v" sid="1TH 5:5" />Inyuĩ inyuothe mũrĩ ciana cia ũtheri na ciana cia mũthenya. Ithuĩ tũtirĩ a ũtukũ kana a nduma. <verse eid="1TH 5:5" /><verse number="6" style="v" sid="1TH 5:6" />Nĩ ũndũ ũcio-rĩ, nĩtũtigei gũkoma ta acio angĩ, no nĩtũikarage twĩiguĩte na tũkerigagĩrĩria maũndũ. <verse eid="1TH 5:6" /><verse number="7" style="v" sid="1TH 5:7" />Nĩgũkorwo arĩa makomaga-rĩ, makomaga ũtukũ, na arĩa marĩĩagwo nĩ njoohi-rĩ, marĩĩagwo ũtukũ. <verse eid="1TH 5:7" /><verse number="8" style="v" sid="1TH 5:8" />No kuona atĩ ithuĩ tũrĩ a mũthenya-rĩ, nĩtũtuĩke a kwĩgirĩrĩria maũndũ, twĩhumbĩte gako ga kũgitĩra gĩthũri karĩa ka wĩtĩkio na ka wendani, na tũgekĩra ũhoro wa kwĩrĩgĩrĩra ũhonokio taarĩ ngũbia ya kĩgera ya kũgitĩra mũtwe. <verse eid="1TH 5:8" /><verse number="9" style="v" sid="1TH 5:9" />Nĩgũkorwo Ngai ndaatwamũrire nĩguo tũtuĩke a kũrakarĩrwo, no nĩtũtuĩke a kwamũkĩra ũhonokio thĩinĩ wa Mwathani witũ Jesũ Kristũ. <verse eid="1TH 5:9" /><verse number="10" style="v" sid="1TH 5:10" />We nĩatũkuĩrĩire nĩgeetha, twakorwo twĩiguĩte kana tũkomete-rĩ, tũgaatũũrania hamwe nake. <verse eid="1TH 5:10" /><verse number="11" style="v" sid="1TH 5:11" />Nĩ ũndũ ũcio-rĩ, ũmanagĩrĩriai mũndũ na ũrĩa ũngĩ na mwĩkĩranage hinya o ta ũrĩa mũreka rĩu.<verse eid="1TH 5:11" /></para>
  <para style="s1">Ũtaarani wa Mũthia</para>
  <para style="p">
    <verse number="12" style="v" sid="1TH 5:12" />Na rĩrĩ, ariũ na aarĩ a Ithe witũ, twamũthaitha mũtĩĩage andũ arĩa marutaga wĩra na kĩyo thĩinĩ wanyu, arĩa matuĩtwo arori anyu na makamũtaaraga thĩinĩ wa Mwathani. <verse eid="1TH 5:12" /><verse number="13" style="v" sid="1TH 5:13" />Mekagĩrĩrei mũno makĩria na mũmendage nĩ ũndũ wa wĩra ũcio marutaga. Tũũranagiai na thayũ mũndũ na ũrĩa ũngĩ. <verse eid="1TH 5:13" /><verse number="14" style="v" sid="1TH 5:14" />Na ningĩ nĩtũkũmũringĩrĩria, inyuĩ ariũ na aarĩ a Ithe witũ, mũkaanagie andũ arĩa igũũta, na mũũmagĩrĩrie arĩa marĩ guoya, na mũteithagie arĩa matarĩ hinya, na mũkiragĩrĩrie andũ othe. <verse eid="1TH 5:14" /><verse number="15" style="v" sid="1TH 5:15" />Menyagĩrĩrai gũtikagĩe mũndũ ũkũrĩhĩria ũũru na ũũru, no hĩndĩ ciothe geragiai gũtugana inyuĩ-ene, na mũtugage andũ arĩa angĩ othe.<verse eid="1TH 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1TH 5:16" />Kenagai hĩndĩ ciothe; <verse eid="1TH 5:16" /><verse number="17" style="v" sid="1TH 5:17" />hooyagai mũtegũtigithĩria; <verse eid="1TH 5:17" /><verse number="18" style="v" sid="1TH 5:18" />cookagĩriai Ngai ngaatho maũndũ-inĩ mothe, nĩgũkorwo ũguo nĩguo Ngai endaga harĩ inyuĩ thĩinĩ wa Kristũ Jesũ.<verse eid="1TH 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1TH 5:19" />Mũtikanahorie mwaki wa Roho; <verse eid="1TH 5:19" /><verse number="20" style="v" sid="1TH 5:20" />mũtikanaire ũhoro ũrĩa ũrathagwo. <verse eid="1TH 5:20" /><verse number="21" style="v" sid="1TH 5:21" />Roranagiai maũndũ mothe. Rũmagiai maũndũ marĩa mega. <verse eid="1TH 5:21" /><verse number="22" style="v" sid="1TH 5:22" />Theemagai ũndũ o wothe mũũru.<verse eid="1TH 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1TH 5:23" />Ngai we mwene, o we Ngai wa thayũ, aromũtheria o kũna. Namo maroho manyu, na ngoro cianyu, o na mĩĩrĩ yanyu, iroikaragio itarĩ na ũcuuke hĩndĩ ĩrĩa Mwathani witũ Jesũ Kristũ agaacooka. <verse eid="1TH 5:23" /><verse number="24" style="v" sid="1TH 5:24" />Ũrĩa ũmwĩtaga inyuĩ nĩ mwĩhokeku, na nĩakahingia ũhoro ũcio.<verse eid="1TH 5:24" /></para>
  <para style="b" />
  <para style="p">
    <verse number="25" style="v" sid="1TH 5:25" />Ariũ na aarĩ a Ithe witũ, tũhooyagĩrei. <verse eid="1TH 5:25" /><verse number="26" style="v" sid="1TH 5:26" />Geithiai ariũ na aarĩ a Ithe witũ othe na ngeithi theru cia kĩmumunyano. <verse eid="1TH 5:26" /><verse number="27" style="v" sid="1TH 5:27" />Nĩndamwatha ndĩ mbere ya Mwathani atĩ marũa maya mathomerwo ariũ na aarĩ a Ithe witũ othe.<verse eid="1TH 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1TH 5:28" />Wega wa Mwathani witũ Jesũ Kristũ ũrogĩa na inyuĩ.<verse eid="1TH 5:28" /></para>
  <chapter eid="1TH 5" />
</usx>