<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JOL" style="id">- Biblica® Open Kikuyu Holy Word of God</book>
  <para style="h">Joeli</para>
  <para style="toc1">Joeli</para>
  <para style="toc2">Joeli</para>
  <para style="toc3">Joel</para>
  <para style="mt1">JOELI</para>
  <chapter number="1" style="c" sid="JOL 1"/>
  <para style="p">
    <verse number="1" style="v" sid="JOL 1:1"/>Ĩno nĩyo ndũmĩrĩri ya Jehova, ĩrĩa yakinyĩrĩire Joeli mũrũ wa Pethueli.<verse eid="JOL 1:1"/></para>
  <para style="s1">Gũtharĩkĩrwo nĩ Ngigĩ</para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 1:2"/>Ta iguai ũhoro, inyuĩ athuuri;</para>
  <para style="q2" vid="JOL 1:2">o na inyuĩ inyuothe arĩa mũtũũraga bũrũri ũyũ thikĩrĩriai.</para>
  <para style="q1" vid="JOL 1:2">Kũrĩ gwekĩka ũndũ ta ũyũ matukũ-inĩ manyu,</para>
  <para style="q2" vid="JOL 1:2">o na kana matukũ-inĩ ma maithe manyu ma tene?<verse eid="JOL 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 1:3"/>Heei ciana cianyu ũhoro ũcio,</para>
  <para style="q2" vid="JOL 1:3">na mũreke ciana cianyu ciĩre ciana ciacio,</para>
  <para style="q2" vid="JOL 1:3">nacio ciana ciacio ikeera rũciaro rũrĩa rũkaarũmĩrĩra.<verse eid="JOL 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 1:4"/>Kĩndũ kĩrĩa gĩtigĩtio nĩ mũrumbĩ wa ngigĩ-rĩ,</para>
  <para style="q2" vid="JOL 1:4">nĩkĩrĩtwo nĩ ngigĩ iria nene;</para>
  <para style="q1" vid="JOL 1:4">kĩrĩa gĩtigĩtio nĩ ngigĩ iria nene-rĩ,</para>
  <para style="q2" vid="JOL 1:4">nĩkĩrĩtwo nĩ itono;</para>
  <para style="q1" vid="JOL 1:4">kĩrĩa itono icio itigĩtie-rĩ,</para>
  <para style="q2" vid="JOL 1:4">nĩkĩrĩtwo nĩ ngigĩ ingĩ.<verse eid="JOL 1:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 1:5"/>Arahũkai, inyuĩ arĩĩu aya mũrĩre!</para>
  <para style="q2" vid="JOL 1:5">Girĩkai, inyuothe anyui a ndibei;</para>
  <para style="q1" vid="JOL 1:5">girĩkai nĩ ũndũ wa ndibei ya mũhihano,</para>
  <para style="q2" vid="JOL 1:5">nĩgũkorwo nĩĩhurĩtio kuuma tũnua-inĩ twanyu.<verse eid="JOL 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 1:6"/>Harĩ rũrĩrĩ rũtharĩkĩire bũrũri wakwa,</para>
  <para style="q2" vid="JOL 1:6">rũrĩrĩ rũrĩ hinya na rũtangĩtarĩka;</para>
  <para style="q1" vid="JOL 1:6">rũrĩ na magego mahaana ta ma mũrũũthi,</para>
  <para style="q2" vid="JOL 1:6">magego manene ta ma mũrũũthi wa mũgoma.<verse eid="JOL 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 1:7"/>Nĩ rwanangĩte mĩthabibũ yakwa,</para>
  <para style="q2" vid="JOL 1:7">na rũgathũkia mĩkũyũ yakwa.</para>
  <para style="q1" vid="JOL 1:7">Nĩrũmĩũnũrĩte makoni rũkamate,</para>
  <para style="q2" vid="JOL 1:7">rũgatiga honge ciayo irĩ nyũnũre.<verse eid="JOL 1:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="JOL 1:8"/>Cakayai ta mũirĩtu gathirange ehumbĩte nguo ya ikũnia,</para>
  <para style="q2" vid="JOL 1:8">akĩrĩrĩra mũthuuriwe wa wĩthĩ wake.<verse eid="JOL 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 1:9"/>Maruta ma ngano, o na maruta ma kũnyuuo</para>
  <para style="q2" vid="JOL 1:9">nĩmatigĩte kũrehwo nyũmba-inĩ ya Jehova.</para>
  <para style="q1" vid="JOL 1:9">Athĩnjĩri-Ngai nĩmaracakaya,</para>
  <para style="q2" vid="JOL 1:9">o acio matungatagĩra Jehova.<verse eid="JOL 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 1:10"/>Mĩgũnda nĩmĩthũkie,</para>
  <para style="q2" vid="JOL 1:10">nayo thĩ ĩkooma;</para>
  <para style="q1" vid="JOL 1:10">ngano nĩnyanange,</para>
  <para style="q2" vid="JOL 1:10">ndibei ya mũhihano nĩĩniarĩte,</para>
  <para style="q2" vid="JOL 1:10">o namo maguta magathira.<verse eid="JOL 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 1:11"/>Ũrwoi nĩ hinya, inyuĩ arĩmi,</para>
  <para style="q2" vid="JOL 1:11">na mũgirĩke, inyuĩ arĩa mũkũragia mĩthabibũ;</para>
  <para style="q1" vid="JOL 1:11">mwĩthikĩrei nĩ ũndũ wa ngano na cairi,</para>
  <para style="q2" vid="JOL 1:11">tondũ magetha ma mĩgũnda nĩmanangĩtwo.<verse eid="JOL 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 1:12"/>Mĩthabibũ nĩyũmĩte,</para>
  <para style="q2" vid="JOL 1:12">nayo mĩkũyũ ĩkahooha;</para>
  <para style="q1" vid="JOL 1:12">mĩkomamanga, na mĩtende, na mĩcungwa:</para>
  <para style="q2" vid="JOL 1:12">ĩĩ, mĩtĩ yothe ya mũgũnda nĩyũmĩte.</para>
  <para style="q1" vid="JOL 1:12">Ti-itherũ gĩkeno kĩa andũ a thĩ nĩgĩthirĩte.<verse eid="JOL 1:12"/></para>
  <para style="s1">Andũ kwĩrwo Meerire</para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 1:13"/>Mwĩhumbei nguo cia makũnia, inyuĩ athĩnjĩri-Ngai, na mũcakae;</para>
  <para style="q2" vid="JOL 1:13">girĩkai, inyuĩ mũtungataga kĩgongona-inĩ.</para>
  <para style="q1" vid="JOL 1:13">Ũkai, mũraare mwĩhumbĩte nguo cia makũnia,</para>
  <para style="q2" vid="JOL 1:13">inyuĩ mũtungatagĩra Ngai wakwa;</para>
  <para style="q1" vid="JOL 1:13">nĩgũkorwo maruta ma ngano, na maruta ma kũnyuuo-rĩ,</para>
  <para style="q2" vid="JOL 1:13">nĩmagĩte gũtwarwo nyũmba-inĩ ya Ngai wanyu.<verse eid="JOL 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 1:14"/>Anĩrĩrai gĩathĩ kĩamũre gĩa kwĩhinga kũrĩa irio;</para>
  <para style="q2" vid="JOL 1:14">ĩtanai kĩũngano gĩtheru.</para>
  <para style="q1" vid="JOL 1:14">Tũmanĩrai athuuri</para>
  <para style="q2" vid="JOL 1:14">na andũ arĩa othe matũũraga bũrũri ũyũ</para>
  <para style="q1" vid="JOL 1:14">moke nyũmba ya Jehova Ngai wanyu,</para>
  <para style="q2" vid="JOL 1:14">nĩguo mũkaĩre Jehova.<verse eid="JOL 1:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 1:15"/>Wũi, kaĩ mũthenya ũcio ũrĩ na haaro-ĩ!</para>
  <para style="q2" vid="JOL 1:15">Nĩgũkorwo mũthenya wa Jehova<note caller="+" style="f"><char style="fr" closed="false">1:15 </char><char style="ft" closed="false">Mũthenya wa Jehova nĩ mũthenya ũrĩa Ngai agatooria thũ ciake, na rĩmwe ũtũmagĩrwo kuuga mũthenya ũrĩa Kristũ agaacooka thĩ.</char></note> ũrĩ hakuhĩ;</para>
  <para style="q1" vid="JOL 1:15">mũthenya ũcio ũgooka ta mwanangĩko</para>
  <para style="q2" vid="JOL 1:15">uumĩte kũrĩ Mwene-Hinya-Wothe.<verse eid="JOL 1:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 1:16"/>Githĩ irio itithirĩte</para>
  <para style="q2" vid="JOL 1:16">o tũkĩĩonagĩra na maitho maitũ:</para>
  <para style="q1" vid="JOL 1:16">gĩkeno na gũcanjamũka</para>
  <para style="q2" vid="JOL 1:16">igathira kuuma kũu nyũmba ya Ngai witũ?<verse eid="JOL 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 1:17"/>Mbeũ nĩkũbutha irabuthĩra</para>
  <para style="q2" vid="JOL 1:17">tĩĩri-inĩ kũrĩa ihaandĩtwo.</para>
  <para style="q1" vid="JOL 1:17">Nyũmba cia kũigwo indo nĩnyanange,</para>
  <para style="q2" vid="JOL 1:17">namo makũmbĩ ma irio makamomorwo,</para>
  <para style="q2" vid="JOL 1:17">nĩgũkorwo ngano nĩyũmĩte.<verse eid="JOL 1:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 1:18"/>Kaĩ ngʼombe nĩicaaĩte-ĩ.</para>
  <para style="q2" vid="JOL 1:18">Ndũũru cia ngʼombe iroorũũra o ũguo,</para>
  <para style="q1" vid="JOL 1:18">tondũ itirĩ na gwa kũrĩithio;</para>
  <para style="q2" vid="JOL 1:18">o nacio ndũũru cia ngʼondu nĩirathĩĩnĩka.<verse eid="JOL 1:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 1:19"/>Wee Jehova, nĩwe ndĩrakaĩra,</para>
  <para style="q2" vid="JOL 1:19">nĩgũkorwo mwaki nĩũniinĩte ũrĩithio wa werũ-inĩ,</para>
  <para style="q1" vid="JOL 1:19">nacio nĩnĩmbĩ igacina mĩtĩ yothe ya gĩthaka.<verse eid="JOL 1:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 1:20"/>O na nyamũ cia gĩthaka nĩirakwanĩria;</para>
  <para style="q2" vid="JOL 1:20">tũrũũĩ nĩtũhwĩte,</para>
  <para style="q2" vid="JOL 1:20">naguo mwaki nĩũniinĩte ũrĩithio wa werũ-inĩ.<verse eid="JOL 1:20"/></para>
  <chapter eid="JOL 1"/>
  <chapter number="2" style="c" sid="JOL 2"/>
  <para style="s1">Mbũtũ ya Ngigĩ</para>
  <para style="q1">
    <verse number="1" style="v" sid="JOL 2:1"/>Huhai karumbeta kũu Zayuni,</para>
  <para style="q2" vid="JOL 2:1">na muuge mbu kũu kĩrĩma-inĩ gĩakwa gĩtheru!</para>
  <para style="q1" vid="JOL 2:1">Andũ arĩa othe matũũraga bũrũri ũyũ nĩmainaine,</para>
  <para style="q2" vid="JOL 2:1">nĩgũkorwo mũthenya wa Jehova nĩũrooka.</para>
  <para style="q1" vid="JOL 2:1">Mũthenya ũcio nĩ ta mũkinyu:<verse eid="JOL 2:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="JOL 2:2"/>nĩ mũthenya wa nduma na wa mairia,</para>
  <para style="q2" vid="JOL 2:2">mũthenya wa matu na nduma ndumanu.</para>
  <para style="q1" vid="JOL 2:2">Mbũtũ nene na ĩrĩ hinya ya ngigĩ nĩĩroka</para>
  <para style="q2" vid="JOL 2:2">ta ruoro rũgĩtema irĩma-inĩ,</para>
  <para style="q1" vid="JOL 2:2">na gũtirĩ kwagĩa ĩngĩ tayo kuuma tene,</para>
  <para style="q2" vid="JOL 2:2">na gũtikagĩa ĩngĩ tayo matukũ marĩa magooka.<verse eid="JOL 2:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 2:3"/>Mbere yacio nĩ mwaki wa kũniina,</para>
  <para style="q2" vid="JOL 2:3">na thuutha wacio nĩ rũrĩrĩmbĩ rũracina bũrũri.</para>
  <para style="q1" vid="JOL 2:3">Bũrũri ũrĩa ũrĩ mbere yacio ũhaana ta mũgũnda wa Edeni,</para>
  <para style="q2" vid="JOL 2:3">no thuutha wacio ũgaatigwo ũhaana ta werũ mwanangĩku:</para>
  <para style="q2" vid="JOL 2:3">gũtirĩ kĩndũ kĩngĩĩhonokia harĩ cio.<verse eid="JOL 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 2:4"/>Mũhianĩre wacio nĩ ta wa mbarathi cia ita;</para>
  <para style="q2" vid="JOL 2:4">ihanyũkaga ta thigari ihaicĩte mbarathi.<verse eid="JOL 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 2:5"/>Irĩ na mũrurumo ta wa ngaari cia ita;</para>
  <para style="q2" vid="JOL 2:5">irũgaga tũcũmbĩrĩ twa irĩma</para>
  <para style="q1" vid="JOL 2:5">ta mwaki ũracarĩka ũgĩcina itira cia ngano,</para>
  <para style="q2" vid="JOL 2:5">ihaana ta mbũtũ ya ita ĩrĩ hinya ĩthagathagĩtwo nĩ ũndũ wa mbaara.<verse eid="JOL 2:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 2:6"/>Na rĩrĩa cionwo-rĩ, ndũrĩrĩ nĩinyiitagwo nĩ ruo rũnene;</para>
  <para style="q2" vid="JOL 2:6">andũ othe magatukia ithiithi.<verse eid="JOL 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 2:7"/>Itharĩkagĩra ta njamba cia ita;</para>
  <para style="q2" vid="JOL 2:7">ihaicaga thingo ta thigari.</para>
  <para style="q1" vid="JOL 2:7">Ithiiaga ciothe na mĩhari,</para>
  <para style="q2" vid="JOL 2:7">itekũhĩtia kũrĩa cierekeire.<verse eid="JOL 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOL 2:8"/>Itihatĩkanaga ĩmwe na ĩrĩa ĩngĩ;</para>
  <para style="q2" vid="JOL 2:8">o ĩmwe ĩthiiaga yerekeire mbere.</para>
  <para style="q1" vid="JOL 2:8">Itoonyaga kũrĩa kũgitĩre,</para>
  <para style="q2" vid="JOL 2:8">gũtirĩ kĩndũ kĩngĩcigiria.<verse eid="JOL 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 2:9"/>Iguthũkagĩra itũũra inene,</para>
  <para style="q2" vid="JOL 2:9">igatengʼerera rũthingo-inĩ.</para>
  <para style="q1" vid="JOL 2:9">Ikahaica, igatoonya nyũmba,</para>
  <para style="q2" vid="JOL 2:9">igatoonyera ndirica ta aici.<verse eid="JOL 2:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 2:10"/>Thĩ ĩthingithaga mbere yacio,</para>
  <para style="q2" vid="JOL 2:10">na igũrũ rĩkainaina,</para>
  <para style="q1" vid="JOL 2:10">riũa na mweri ikagĩa nduma,</para>
  <para style="q2" vid="JOL 2:10">na njata igatiga kwara.<verse eid="JOL 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 2:11"/>Jehova araruruma ta ngwa</para>
  <para style="q2" vid="JOL 2:11">atongoretie ita;</para>
  <para style="q1" vid="JOL 2:11">thigari ciake itingĩtarĩka,</para>
  <para style="q2" vid="JOL 2:11">arĩa maathĩkagĩra watho wake marĩ hinya.</para>
  <para style="q1" vid="JOL 2:11">Mũthenya wa Jehova nĩ mũnene,</para>
  <para style="q2" vid="JOL 2:11">na nĩ wa gwĩtigĩrwo.</para>
  <para style="q2" vid="JOL 2:11">Nũũ ũngĩkĩhota kũwĩtiiria?<verse eid="JOL 2:11"/></para>
  <para style="s1">Tembũrangai Ngoro Cianyu</para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 2:12"/>Jehova aroiga atĩrĩ,</para>
  <para style="q2" vid="JOL 2:12">“O na rĩu-rĩ, njokererai na ngoro cianyu ciothe,</para>
  <para style="q2" vid="JOL 2:12">mwĩhingĩte kũrĩa irio, mũkĩrĩraga na mũgĩcakayaga.”<verse eid="JOL 2:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 2:13"/>Tembũrangai ngoro cianyu</para>
  <para style="q2" vid="JOL 2:13">no ti nguo cianyu.</para>
  <para style="q1" vid="JOL 2:13">Cookererai Jehova Ngai wanyu,</para>
  <para style="q2" vid="JOL 2:13">nĩgũkorwo nĩ mũtugi na nĩ mũigua-tha,</para>
  <para style="q1" vid="JOL 2:13">ndahiũhaga kũrakara, na aiyũrĩtwo nĩ wendo,</para>
  <para style="q2" vid="JOL 2:13">na nĩericũkagwo, akaaga gwĩka andũ ũũru.<verse eid="JOL 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 2:14"/>Nũũ ũngĩmenya? Hihi no agarũrũke na aigue tha,</para>
  <para style="q2" vid="JOL 2:14">atige atũrathima:</para>
  <para style="q1" vid="JOL 2:14">atũhe indo iria irutagwo magongona ma mũtu,</para>
  <para style="q2" vid="JOL 2:14">na iria irutagwo magongona ma kũnyuuo,</para>
  <para style="q2" vid="JOL 2:14">cia kũrutĩrwo Jehova Ngai wanyu.<verse eid="JOL 2:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 2:15"/>Huhai karumbeta kũu Zayuni,</para>
  <para style="q2" vid="JOL 2:15">anĩrĩrai gĩathĩ kĩamũre gĩa kwĩhinga kũrĩa irio,</para>
  <para style="q2" vid="JOL 2:15">ĩtanai kĩũngano gĩtheru.<verse eid="JOL 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 2:16"/>Cookanĩrĩriai andũ,</para>
  <para style="q2" vid="JOL 2:16">amũrai kĩũngano kĩu;</para>
  <para style="q1" vid="JOL 2:16">rehei athuuri hamwe,</para>
  <para style="q2" vid="JOL 2:16">na mũcookanĩrĩrie ciana, o na tũkenge tũrĩa tũronga.</para>
  <para style="q1" vid="JOL 2:16">Mũhikania nĩoime kanyũmba gake,</para>
  <para style="q2" vid="JOL 2:16">nake mũhiki nĩoime kĩrĩrĩ gĩake.<verse eid="JOL 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 2:17"/>Athĩnjĩri-Ngai, arĩa matungataga mbere ya Jehova,</para>
  <para style="q2" vid="JOL 2:17">nĩmarĩrĩre gatagatĩ ga gĩthaku kĩa Hekarũ na kĩgongona.</para>
  <para style="q1" vid="JOL 2:17">Nĩmoige atĩrĩ, “Kĩhonokie andũ aku, Wee Jehova.</para>
  <para style="q2" vid="JOL 2:17">Ndũkareke igai rĩaku rĩtuĩke kĩndũ gĩa kũnyũrũrio,</para>
  <para style="q2" vid="JOL 2:17">kana tuunagwo thimo gatagatĩ-inĩ ka ndũrĩrĩ.</para>
  <para style="q1" vid="JOL 2:17">Nĩ kĩĩ kĩngĩtũma ndũrĩrĩ ciũranagie atĩrĩ,</para>
  <para style="q2" vid="JOL 2:17">‘Kaĩ Ngai wao akĩrĩ ha?’ ”<verse eid="JOL 2:17"/></para>
  <para style="s1">Icookia rĩa Jehova</para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 2:18"/>Ningĩ Jehova nĩakaigua ũiru nĩ ũndũ wa bũrũri wake,</para>
  <para style="q2" vid="JOL 2:18">na aiguĩre andũ ake tha.<verse eid="JOL 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JOL 2:19"/>Jehova nĩakamacookeria atĩrĩ:</para>
  <para style="q1" vid="JOL 2:19">“Nĩngũmũrehithĩria ngano, na ndibei ya mũhihano, na maguta,</para>
  <para style="q2" vid="JOL 2:19">indo cia kũmũigana biũ;</para>
  <para style="q1" vid="JOL 2:19">na ndigacooka kũreka mũtuĩke</para>
  <para style="q2" vid="JOL 2:19">kĩndũ gĩa kũnyũrũrio nĩ ndũrĩrĩ rĩngĩ.<verse eid="JOL 2:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 2:20"/>“Nĩngaingata mbũtũ ĩyo ya ita ya kuuma gathigathini ĩthiĩ kũraya na inyuĩ,</para>
  <para style="q2" vid="JOL 2:20">ndĩmĩtindĩkĩrĩrie bũrũri mũũmũ na mũhĩnju, ũtangĩgĩa irio.</para>
  <para style="q1" vid="JOL 2:20">Mbũtũ yao ĩrĩa ĩtoongoretie ndĩmĩitĩrĩre iria-inĩ rĩa mwena wa irathĩro,</para>
  <para style="q2" vid="JOL 2:20">na ĩrĩa ĩrĩ thuutha ndĩmĩitĩrĩre iria-inĩ rĩa mwena wa ithũĩro.</para>
  <para style="q1" vid="JOL 2:20">Nakĩo kĩheera gĩa ciimba ciayo kĩambate na igũrũ;</para>
  <para style="q2" vid="JOL 2:20">mũnungo wayo naguo ũiguĩke.”</para>
  <para style="b" vid="JOL 2:20"/>
  <para style="q1" vid="JOL 2:20">Ti-itherũ nĩekĩte maũndũ manene.<verse eid="JOL 2:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOL 2:21"/>Wee bũrũri, tiga gwĩtigĩra;</para>
  <para style="q2" vid="JOL 2:21">kena na ũcanjamũke.</para>
  <para style="q1" vid="JOL 2:21">Ti-itherũ Jehova nĩekĩte maũndũ manene.<verse eid="JOL 2:21"/></para>
  <para style="q2">
    <verse number="22" style="v" sid="JOL 2:22"/>Inyuĩ nyamũ cia gĩthaka, tigai gwĩtigĩra,</para>
  <para style="q2" vid="JOL 2:22">nĩgũkorwo ũrĩithio wa werũ-inĩ nĩũramera nyeki.</para>
  <para style="q1" vid="JOL 2:22">Mĩtĩ nĩĩraciara maciaro mayo,</para>
  <para style="q2" vid="JOL 2:22">nayo mĩkũyũ na mĩthabibũ ĩgaciara mũno.<verse eid="JOL 2:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOL 2:23"/>Inyuĩ andũ a Zayuni, canjamũkai,</para>
  <para style="q2" vid="JOL 2:23">mũkenere Jehova Ngai wanyu,</para>
  <para style="q1" vid="JOL 2:23">nĩgũkorwo nĩamũheete mbura ya mbere</para>
  <para style="q2" vid="JOL 2:23">nĩ ũndũ wa ũthingu wake.</para>
  <para style="q1" vid="JOL 2:23">Nĩamuurĩirie mbura nyingĩ</para>
  <para style="q2" vid="JOL 2:23">ya mbere na ya thuutha, o ta mbere.<verse eid="JOL 2:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOL 2:24"/>Nacio ihuhĩro cia ngano nĩikaiyũra ngano;</para>
  <para style="q2" vid="JOL 2:24">mĩtũngi nayo nĩĩkaiyũrĩrĩra</para>
  <para style="q1" vid="JOL 2:24">ndibei ya mũhihano na maguta.<verse eid="JOL 2:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="JOL 2:25"/>“Nĩngamũrĩha mĩaka ĩrĩa yothe irio cianyu ciarĩirwo nĩ ngigĩ:</para>
  <para style="q2" vid="JOL 2:25">ngigĩ iria nene, na itono cia ngigĩ,</para>
  <para style="q1" vid="JOL 2:25">na ngigĩ iria ingĩ, na mĩrumbĩ ya ngigĩ;</para>
  <para style="q2" vid="JOL 2:25">icio nĩ mbũtũ ciakwa nene cia ita iria ndaatũmĩte thĩinĩ wanyu.<verse eid="JOL 2:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOL 2:26"/>Nĩmũkagĩa na irio nyingĩ cia kũrĩa, o nginya mũhũũne,</para>
  <para style="q2" vid="JOL 2:26">na inyuĩ nĩmũkagoocaga rĩĩtwa rĩa Jehova Ngai wanyu,</para>
  <para style="q2" vid="JOL 2:26">ũrĩa ũmwĩkĩire maũndũ ma magegania;</para>
  <para style="q1" vid="JOL 2:26">andũ akwa matigacooka gũconorithio rĩngĩ.<verse eid="JOL 2:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOL 2:27"/>Hĩndĩ ĩyo nĩmũkamenya atĩ niĩ ndĩ thĩinĩ wa Isiraeli,</para>
  <para style="q2" vid="JOL 2:27">na atĩ niĩ nĩ niĩ Jehova Ngai wanyu,</para>
  <para style="q2" vid="JOL 2:27">na atĩ gũtirĩ ũngĩ;</para>
  <para style="q1" vid="JOL 2:27">andũ akwa matigacooka gũconorithio rĩngĩ.<verse eid="JOL 2:27"/></para>
  <para style="s1">Mũthenya wa Jehova</para>
  <para style="q1">
    <verse number="28" style="v" sid="JOL 2:28"/>“Na thuutha wa maũndũ macio-rĩ,</para>
  <para style="q2" vid="JOL 2:28">nĩngaitĩrĩria andũ othe Roho wakwa.</para>
  <para style="q1" vid="JOL 2:28">Ariũ anyu na airĩtu anyu nĩmakarathaga mohoro,</para>
  <para style="q2" vid="JOL 2:28">nao athuuri anyu nĩmakarootaga irooto,</para>
  <para style="q2" vid="JOL 2:28">nao aanake anyu monage cioneki.<verse eid="JOL 2:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOL 2:29"/>O na ningĩ ndungata ciakwa cia arũme, na cia andũ-a-nja,</para>
  <para style="q2" vid="JOL 2:29">nĩngaciitĩrĩria Roho wakwa matukũ-inĩ macio.<verse eid="JOL 2:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOL 2:30"/>Nĩngonania morirũ kũu igũrũ, o na gũkũ thĩ,</para>
  <para style="q2" vid="JOL 2:30">namo nĩ ma thakame, na ma mwaki,</para>
  <para style="q2" vid="JOL 2:30">o na ma ndogo ĩkwambata na igũrũ.<verse eid="JOL 2:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOL 2:31"/>Riũa nĩrĩkagarũrwo rĩtuĩke nduma,</para>
  <para style="q2" vid="JOL 2:31">naguo mweri ũtuĩke ta thakame,</para>
  <para style="q2" vid="JOL 2:31">mbere ya mũthenya ũcio mũnene na wa kũmakania wa Jehova ũtanakinya.<verse eid="JOL 2:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOL 2:32"/>Na nĩgũgakinya atĩrĩ,</para>
  <para style="q2" vid="JOL 2:32">atĩ mũndũ o wothe ũgaakaĩra rĩĩtwa rĩa Jehova nĩakahonoka;</para>
  <para style="q1" vid="JOL 2:32">nĩgũkorwo kĩrĩma-inĩ gĩa Zayuni na Jerusalemu</para>
  <para style="q2" vid="JOL 2:32">nĩgũgakorwo na ũhonokio,</para>
  <para style="q2" vid="JOL 2:32">o ta ũrĩa Jehova oigĩte,</para>
  <para style="q1" vid="JOL 2:32">atĩ gatagatĩ-inĩ ka matigari</para>
  <para style="q2" vid="JOL 2:32">nĩgũgakorwo na arĩa Jehova eĩtĩire.<verse eid="JOL 2:32"/></para>
  <chapter eid="JOL 2"/>
  <chapter number="3" style="c" sid="JOL 3"/>
  <para style="s1">Ndũrĩrĩ Gũtuĩrwo Ciira</para>
  <para style="q1">
    <verse number="1" style="v" sid="JOL 3:1"/>“Matukũ-inĩ macio, na ihinda rĩu,</para>
  <para style="q2" vid="JOL 3:1">rĩrĩa ngaacookeria Juda na Jerusalemu ũgaacĩru wacio-rĩ,<verse eid="JOL 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 3:2"/>nĩngacookanĩrĩria ndũrĩrĩ ciothe,</para>
  <para style="q2" vid="JOL 3:2">na ndĩciikũrũkie nginya Gĩtuamba kĩa Jehoshafatu.<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="ft" closed="false">Rĩĩtwa Jehoshafatu nĩ kuuga “Jehova nĩwe mũtuanĩri ciira”; Gĩtuamba kĩa Jehoshafatu no kĩo gĩĩtagwo gĩtuamba gĩa ituĩro (3:14).</char></note></para>
  <para style="q1" vid="JOL 3:2">Kũu nĩkuo ngaamatuĩra ciira ũkoniĩ igai rĩakwa,</para>
  <para style="q2" vid="JOL 3:2">nĩo andũ akwa a Isiraeli,</para>
  <para style="q1" vid="JOL 3:2">nĩgũkorwo nĩmahurunjire andũ akwa ndũrĩrĩ-inĩ,</para>
  <para style="q2" vid="JOL 3:2">na makĩgayana bũrũri wakwa.<verse eid="JOL 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 3:3"/>Nĩmacuukĩire andũ akwa mĩtĩ.</para>
  <para style="q2" vid="JOL 3:3">Maaheanire tũmwana twao tũrĩ irĩhi kũrĩ maraya;</para>
  <para style="q1" vid="JOL 3:3">na makĩendia airĩtu ndibei</para>
  <para style="q2" vid="JOL 3:3">nĩguo mamĩnyue.<verse eid="JOL 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JOL 3:4"/>“Na rĩrĩ, nĩ kĩĩ mũranjũria, inyuĩ Turo na Sidoni o na inyuĩ ngʼongo ciothe cia Filistia? Anga nĩmũkwĩrĩhĩria ũndũ ndanamwĩka? Akorwo nĩmũkwĩrĩhĩria-rĩ, na niĩ nĩngatũma mũcookererwo nĩ kwĩrĩhĩria kũu kwanyu o narua na ihenya. <verse eid="JOL 3:4"/><verse number="5" style="v" sid="JOL 3:5"/>Nĩgũkorwo nĩmuoire betha na thahabu ciakwa, na mũgĩkuua mĩthiithũ ya indo ciakwa iria njega mũno mũgĩcitwara hekarũ-inĩ cianyu. <verse eid="JOL 3:5"/><verse number="6" style="v" sid="JOL 3:6"/>Nĩmwendirie andũ a Juda na a Jerusalemu kũrĩ Ayunani nĩguo mũmatware kũndũ kũraya na bũrũri wao.<verse eid="JOL 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JOL 3:7"/>“Atĩrĩrĩ, nĩngũmarahũra moime kũndũ kũrĩa guothe mwamendirie, na nĩngamũcookereria ũndũ ũcio mwĩkĩte. <verse eid="JOL 3:7"/><verse number="8" style="v" sid="JOL 3:8"/>Niĩ nĩngendia ariũ anyu na airĩtu anyu kũrĩ andũ a Juda, nao mamenderie andũ a Sheba, rũrĩrĩ rwa kũraya mũno.” Nĩ Jehova warĩtie ũndũ ũcio.<verse eid="JOL 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 3:9"/>Hunjanĩriai ũhoro ũyũ ndũrĩrĩ-inĩ:</para>
  <para style="q2" vid="JOL 3:9">Mwĩhaarĩriei gũthiĩ mbaara-inĩ!</para>
  <para style="q1" vid="JOL 3:9">Arahũrai njamba cia ita!</para>
  <para style="q2" vid="JOL 3:9">Andũ othe a ita nĩmakuhĩrĩrie, matharĩkĩre.<verse eid="JOL 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 3:10"/>Turai mĩraũ yanyu ĩtuĩke hiũ cia njora,</para>
  <para style="q2" vid="JOL 3:10">o nacio hiũ cianyu cia gũceeha mĩtĩ ituĩke matimũ.</para>
  <para style="q1" vid="JOL 3:10">Mũndũ ũrĩa ũtarĩ hinya nĩoige atĩrĩ,</para>
  <para style="q2" vid="JOL 3:10">“Niĩ ndĩ na hinya!”<verse eid="JOL 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 3:11"/>Ũkai na ihenya, inyuĩ ndũrĩrĩ cia kũndũ guothe,</para>
  <para style="q2" vid="JOL 3:11">mũngane, mwĩcookanĩrĩrie hamwe.</para>
  <para style="b" vid="JOL 3:11"/>
  <para style="q1" vid="JOL 3:11">Wee Jehova, tũma njamba ciaku cia ita ciikũrũke kuo.<verse eid="JOL 3:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 3:12"/>“Ndũrĩrĩ nĩciarahũrwo;</para>
  <para style="q2" vid="JOL 3:12">nĩcithiĩ Gĩtuamba kĩa Jehoshafatu,</para>
  <para style="q1" vid="JOL 3:12">nĩgũkorwo kũu nĩkuo ngaikarĩra gĩtĩ,</para>
  <para style="q2" vid="JOL 3:12">nduĩre ndũrĩrĩ ciothe cia mĩena yothe ciira.<verse eid="JOL 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 3:13"/>Hiũria-i rũhiũ rwa kũgetha,</para>
  <para style="q2" vid="JOL 3:13">nĩgũkorwo magetha nĩ makinyu.</para>
  <para style="q1" vid="JOL 3:13">Ũkai, rangĩrĩriai thabibũ,</para>
  <para style="q2" vid="JOL 3:13">nĩgũkorwo kĩhihĩro kĩa ndibei nĩkĩiyũru,</para>
  <para style="q1" vid="JOL 3:13">na mĩtũngi ĩkaiyũra, ĩgaitĩkĩrĩra thĩ:</para>
  <para style="q2" vid="JOL 3:13">ũguo noguo waganu wao ũnenehete!”<verse eid="JOL 3:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 3:14"/>Gũgaakorwo irĩndĩ na irĩndĩ,</para>
  <para style="q2" vid="JOL 3:14">kũu gĩtuamba gĩa ituĩro!</para>
  <para style="q1" vid="JOL 3:14">Nĩgũkorwo mũthenya wa Jehova</para>
  <para style="q2" vid="JOL 3:14">wa gũkinya kũu gĩtuamba gĩa ituĩro ũrĩ hakuhĩ.<verse eid="JOL 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 3:15"/>Riũa na mweri nĩikaagĩa nduma,</para>
  <para style="q2" vid="JOL 3:15">nacio njata itigacooka kwara rĩngĩ.<verse eid="JOL 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 3:16"/>Jehova nĩakararama arĩ kũu Zayuni</para>
  <para style="q2" vid="JOL 3:16">na arurume ta ngwa arĩ Jerusalemu;</para>
  <para style="q2" vid="JOL 3:16">thĩ na igũrũ nĩikainaina.</para>
  <para style="q1" vid="JOL 3:16">No rĩrĩ, Jehova nĩwe ũgaatuĩka rĩũrĩro rĩa andũ ake,</para>
  <para style="q2" vid="JOL 3:16">na atuĩke kĩĩhitho kĩrũmu kĩa andũ a Isiraeli.<verse eid="JOL 3:16"/></para>
  <para style="s1">Irathimo cia Andũ a Ngai</para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 3:17"/>“Hĩndĩ ĩyo nĩguo mũkaamenya atĩ niĩ, Jehova Ngai wanyu,</para>
  <para style="q2" vid="JOL 3:17">ndũũraga Zayuni, kĩrĩma-inĩ gĩakwa kĩrĩa gĩtheru.</para>
  <para style="q1" vid="JOL 3:17">Narĩo itũũra rĩa Jerusalemu rĩgaakorwo rĩrĩ rĩamũre;</para>
  <para style="q2" vid="JOL 3:17">gũtirĩ hĩndĩ ĩngĩ andũ a kũngĩ magaacooka kũrĩtharĩkĩra.<verse eid="JOL 3:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 3:18"/>“Mũthenya ũcio-rĩ, irĩma-inĩ nĩgũgatataga ndibei ya mũhihano,</para>
  <para style="q2" vid="JOL 3:18">na tũrĩma-inĩ nĩgũgathereraga iria,</para>
  <para style="q2" vid="JOL 3:18">natuo tũrũũĩ tuothe twa Juda nĩtũgathereraga maaĩ.</para>
  <para style="q1" vid="JOL 3:18">Nakuo nyũmba ya Jehova nĩgũgakunũka gĩthima,</para>
  <para style="q2" vid="JOL 3:18">na maaĩ makĩo maikũrũkage o kũu Gĩtuamba gĩa Shitimu.<verse eid="JOL 3:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 3:19"/>No bũrũri wa Misiri nĩgũkira ũgaakira ihooru,</para>
  <para style="q2" vid="JOL 3:19">nakuo Edomu gũtuĩke werũ ũtarĩ kĩndũ,</para>
  <para style="q1" vid="JOL 3:19">nĩ ũndũ wa maũndũ ma ũhinya marĩa meekire andũ a Juda,</para>
  <para style="q2" vid="JOL 3:19">ma gũitithia thakame ĩtarĩ na ũũru kũu bũrũri wao.<verse eid="JOL 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 3:20"/>Juda gũgaatũũrwo tene na tene,</para>
  <para style="q2" vid="JOL 3:20">nakuo Jerusalemu gũtũũrwo njiarwa na njiarwa.<verse eid="JOL 3:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOL 3:21"/>Wĩhia wao wa ũiti wa thakame,</para>
  <para style="q2" vid="JOL 3:21">ũcio itarĩ ndaamarekera-rĩ, nĩngamarekera.”</para>
  <para style="b" vid="JOL 3:21"/>
  <para style="q4" vid="JOL 3:21">Jehova atũũraga Zayuni!<verse eid="JOL 3:21"/></para>
  <chapter eid="JOL 3"/>
</usx>
