<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JOB" style="id">- Biblica® Open Kikuyu Holy Word of God</book>
  <para style="h">Ayubu</para>
  <para style="toc1">Ayubu</para>
  <para style="toc2">Ayubu</para>
  <para style="toc3">Ayub</para>
  <para style="mt1">AYUBU</para>
  <chapter number="1" style="c" sid="JOB 1"/>
  <para style="s1">Ciugo cia Kwambĩrĩria</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 1:1"/>Bũrũri-inĩ wa Uzu nĩ kwarĩ mũndũ watũire kuo wetagwo Ayubu.<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">Bũrũri wa Uzu warĩ mwena wa irathĩro wa Rũũĩ rwa Jorodani; Ayubu ndaarĩ mũndũ wa Isiraeli.</char></note> Mũndũ ũcio ndaarĩ ũcuuke ningĩ aarĩ mũndũ mũrũngĩrĩru; nĩetigĩrĩte Ngai na agatheemaga maũndũ marĩa mooru. <verse eid="JOB 1:1"/><verse number="2" style="v" sid="JOB 1:2"/>Ayubu aarĩ na ariũ mũgwanja na airĩtu atatũ, <verse eid="JOB 1:2"/><verse number="3" style="v" sid="JOB 1:3"/>ningĩ nĩ aarĩ na ngʼondu 7,000, na ngamĩĩra 3,000, na ndegwa cia kũigana kuohwo macooki 500, na ndigiri 500, na nĩ aarĩ na ndungata nyingĩ mũno. Nĩwe warĩ mũndũ ũrĩa mũnene mũno kũrĩ andũ arĩa angĩ othe a mwena wa Irathĩro.<verse eid="JOB 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JOB 1:4"/>Ariũ ake nĩmagĩaga na iruga o mũndũ riita rĩake gwake mũciĩ, na nĩmetaga aarĩ a nyina acio atatũ nĩguo marĩĩanĩre na manyuuanĩre nao. <verse eid="JOB 1:4"/><verse number="5" style="v" sid="JOB 1:5"/>Na matukũ ma maruga maathira, Ayubu nĩamatũmanagĩra moke nĩguo amatherie. Nĩokagĩra rũciinĩ tene akaruta igongona rĩa njino nĩ ũndũ wa o ũmwe wao, tondũ eeciiragia atĩrĩ, “No gũkorwo ciana ciakwa nĩciĩhĩtie ikaruma Ngai na ngoro.” Ũcio nĩguo warĩ mũtũgo wa Ayubu wa mahinda mothe.<verse eid="JOB 1:5"/></para>
  <para style="s1">Kũgerio kwa Ayubu kwa Mbere</para>
  <para style="p">
    <verse number="6" style="v" sid="JOB 1:6"/>Na rĩrĩ, mũthenya ũmwe araika nĩmathiire kũrũgama mbere ya Jehova, na Shaitani o nake agĩthiĩ hamwe nao. <verse eid="JOB 1:6"/><verse number="7" style="v" sid="JOB 1:7"/>Nake Jehova akĩũria Shaitani atĩrĩ, “Uuma kũ?”</para>
  <para style="p" vid="JOB 1:7">Nake Shaitani agĩcookeria Jehova atĩrĩ, “Nyuma kũriũnga thĩ, o na gũcangacanga kuo kũndũ na kũndũ.”<verse eid="JOB 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JOB 1:8"/>Ningĩ Jehova akĩũria Shaitani atĩrĩ, “Nĩũcũũranĩtie ũhoro wa ndungata yakwa Ayubu? Ũkoona atĩ kũu thĩ gũtirĩ mũndũ ũngĩ ũhaana take; ndarĩ ũcuuke na nĩmũrũngĩrĩru, mũndũ mwĩtigĩri-Ngai na ũtheemaga maũndũ marĩa mooru?”<verse eid="JOB 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JOB 1:9"/>Shaitani agĩcookia atĩrĩ, “Kaĩ Ayubu agĩĩtigagĩra Ngai o ro ũguo tũhũ? <verse eid="JOB 1:9"/><verse number="10" style="v" sid="JOB 1:10"/>Githĩ wee ndũmũirigĩire na ũkamũrigiicĩria hamwe na nyũmba yake, o hamwe na maũndũ make mothe? Nĩũrathimĩte wĩra wa moko make, nĩ ũndũ ũcio ũhiũ wake na ndũũru ciake ciyũrĩte bũrũri wothe. <verse eid="JOB 1:10"/><verse number="11" style="v" sid="JOB 1:11"/>No rĩrĩ, ta tambũrũkia guoko gwaku ũhutie indo ciothe iria arĩ nacio, na ti-itherũ ndarĩ hĩndĩ ategũkũruma o ũthiũ-inĩ waku.”<verse eid="JOB 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JOB 1:12"/>Jehova akĩĩra Shaitani atĩrĩ, “No wega, indo ciothe iria arĩ nacio nĩndaciiga moko-inĩ maku, nowe mwene ndũkanamũhutie.”</para>
  <para style="p" vid="JOB 1:12">Nake Shaitani akiuma hau mbere ya Jehova.<verse eid="JOB 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JOB 1:13"/>Na rĩrĩ, mũthenya ũmwe hĩndĩ ĩrĩa ariũ na aarĩ a Ayubu maarĩĩaga na makanyua ndibei kwa mũrũ wa nyina wao ũrĩa mũkũrũ-rĩ, <verse eid="JOB 1:13"/><verse number="14" style="v" sid="JOB 1:14"/>mũkinyia-ũhoro agĩkora Ayubu, akĩmwĩra atĩrĩ, “Ndegwa nĩkũrĩma ikũrĩmaga na mĩraũ, nacio ndigiri ikũrĩĩaga o hau hakuhĩ, <verse eid="JOB 1:14"/><verse number="15" style="v" sid="JOB 1:15"/>nao andũ a Sabea<note caller="+" style="f"><char style="fr" closed="false">1:15 </char><char style="ft" closed="false">Andũ a Sabea maarĩ arĩithi arĩa morũũraga na mahiũ mao.</char></note> macitharĩkĩra na macitaha. Ndungata nacio maciũraga na rũhiũ rwa njora, na no niĩ nyiki ndahonoka, ndagĩũka gũkũrehere ũhoro!”<verse eid="JOB 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JOB 1:16"/>O akĩaragia-rĩ, mũkinyia-ũhoro ũngĩ agĩũka, akiuga atĩrĩ, “Mwaki wa Ngai uumire na igũrũ na wacina ngʼondu o na ndungata waniina biũ; no niĩ nyiki ndahonoka, ndagĩũka gũkũrehere ũhoro!”<verse eid="JOB 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JOB 1:17"/>O akĩaragia-rĩ, mũkinyia-ũhoro ũngĩ agĩũka, akiuga atĩrĩ, “Akalidei<note caller="+" style="f"><char style="fr" closed="false">1:17 </char><char style="ft" closed="false">Akalidei maarĩ arĩithi arĩa morũũraga na mahiũ mao. Maatũũraga Mesopotamia, na nĩo thuutha-inĩ maathondekire ũthamaki wa Babuloni.</char></note> meyũmba mbũtũ ithatũ, maatharĩkĩra ngamĩĩra ciaku na macitaha, maathiĩ nacio. Ndungata nacio maciũraga na rũhiũ rwa njora; na no niĩ nyiki ndahonoka, ndagĩũka gũkũrehere ũhoro!”<verse eid="JOB 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JOB 1:18"/>O akĩaragia-rĩ, mũkinyia-ũhoro o ũngĩ agĩũka, akiuga atĩrĩ, “Ariũ na aarĩ aku mekũrĩĩaga, makĩnyuuaga ndibei kwa mũrũ wa nyina wao ũrĩa mũkũrũ; <verse eid="JOB 1:18"/><verse number="19" style="v" sid="JOB 1:19"/>na rĩrĩ, o hĩndĩ ĩyo rũhuho rũnene rwahurutana ruumĩte werũ-inĩ, na ruo rwahũũra nyũmba ĩyo koine ciayo inya, yamomoka, yamagwĩra maakua; na no niĩ nyiki ndahonoka, ndagĩũka gũkũrehere ũhoro!”<verse eid="JOB 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JOB 1:20"/>Nake Ayubu aigua-ũhoro ũcio, akĩrũgama, agĩtembũranga nguo yake ya igũrũ, na akĩenjwo mũtwe. Agĩcooka akĩĩgũithia thĩ, akĩhooya Ngai, <verse eid="JOB 1:20"/><verse number="21" style="v" sid="JOB 1:21"/>akiuga atĩrĩ:</para>
  <para style="q1" vid="JOB 1:21">“Ndoimire nda ya maitũ ndĩ njaga,</para>
  <para style="q2" vid="JOB 1:21">na ngoima thĩ ĩno ndĩ njaga.</para>
  <para style="q1" vid="JOB 1:21">Nĩ Jehova waheanire, na nĩ Jehova wacookera:</para>
  <para style="q2" vid="JOB 1:21">rĩĩtwa rĩa Jehova rĩrogoocwo.”<verse eid="JOB 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JOB 1:22"/>Thĩinĩ wa maũndũ macio mothe-rĩ, Ayubu ndaigana kwĩhia na ũndũ wa gũtuĩra Ngai mahĩtia.<verse eid="JOB 1:22"/></para>
  <chapter eid="JOB 1"/>
  <chapter number="2" style="c" sid="JOB 2"/>
  <para style="s1">Kũgerio kwa Ayubu gwa keerĩ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 2:1"/>Ningĩ nĩ kwarĩ mũthenya ũngĩ araika maathiire kũrũgama mbere ya Jehova, na Shaitani o nake agĩthiĩ hamwe nao kũrũgama mbere yake. <verse eid="JOB 2:1"/><verse number="2" style="v" sid="JOB 2:2"/>Nake Jehova akĩũria Shaitani atĩrĩ, “Uuma kũ?”</para>
  <para style="p" vid="JOB 2:2">Nake Shaitani agĩcookeria Jehova atĩrĩ, “Nyuma kũriũnga thĩ o na gũcangacanga kuo kũndũ na kũndũ.”<verse eid="JOB 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JOB 2:3"/>Ningĩ Jehova akĩũria Shaitani atĩrĩ, “Nĩũcũũranĩtie ũhoro wa ndungata yakwa Ayubu? Ũkoona atĩ kũu thĩ gũtirĩ mũndũ ũhaana take; ndarĩ ũcuuke na nĩ mũrũngĩrĩru, mũndũ mwĩtigĩri-Ngai na ũtheemaga maũndũ marĩa mooru. Ningĩ no arũmĩtie wĩhokeku wake, o na gũtuĩka nĩwaningĩrĩirie ndĩmwanange hatarĩ gĩtũmi.”<verse eid="JOB 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JOB 2:4"/>Nake Shaitani agĩcookeria Jehova, akiuga atĩrĩ, “Gĩkonde kĩrĩhagwo na gĩkonde! Mũndũ no arute indo ciake ciothe nĩguo ahonokie muoyo wake. <verse eid="JOB 2:4"/><verse number="5" style="v" sid="JOB 2:5"/>No rĩrĩ, ta tambũrũkia guoko gwaku ũhutie mahĩndĩ na nyama cia mwĩrĩ wake, na ti-itherũ ndarĩ hĩndĩ ategũkũruma o ũthiũ-inĩ waku.”<verse eid="JOB 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JOB 2:6"/>Nake Jehova akĩĩra Shaitani atĩrĩ, “No wega, rĩu arĩ moko-inĩ maku; no ndũkahutie muoyo wake.”<verse eid="JOB 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JOB 2:7"/>Nĩ ũndũ ũcio Shaitani akiuma hau mbere ya Jehova, akĩnyamaria Ayubu na ironda ciarĩ na ruo mũno kuuma makinya ma magũrũ make nginya mũtwe. <verse eid="JOB 2:7"/><verse number="8" style="v" sid="JOB 2:8"/>Nake Ayubu akĩoya gacere ka nyũngũ ethũage nako, agĩikara thĩ harĩa haitagwo mũhu.<verse eid="JOB 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JOB 2:9"/>Nake mũtumia wake akĩmũũria atĩrĩ, “Anga no ũrũmĩtie wĩhokeku waku o na rĩu? Ruma Ngai wĩkuĩre!”<verse eid="JOB 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JOB 2:10"/>Nake Ayubu akĩmũcookeria atĩrĩ, “Wee ũraaria ta mũndũ-wa-nja mũkĩĩgu. Kaĩ turĩkĩamũkagĩra o maũndũ mega kuuma kũrĩ Ngai, na tũtiamũkĩre mathĩĩna?”</para>
  <para style="p" vid="JOB 2:10">Thĩinĩ wa maũndũ macio mothe-rĩ, Ayubu ndaigana kwĩhia thĩinĩ wa mĩario yake.<verse eid="JOB 2:10"/></para>
  <para style="s1">Arata Atatũ a Ayubu</para>
  <para style="p">
    <verse number="11" style="v" sid="JOB 2:11"/>Na rĩrĩ, hĩndĩ ĩrĩa arata atatũ a Ayubu, nĩo Elifazu ũrĩa Mũtemaani,<note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="ft" closed="false">Elifazu aarĩ wa kuuma Edomu.</char></note> na Bilidadi ũrĩa Mũshuhi, na Zofaru ũrĩa Mũnaamathi, maaiguire mathĩĩna marĩa mothe maakorete Ayubu-rĩ, makĩgĩa gĩathĩ, makiuma o mũndũ gwake na magĩcemania nĩguo mathiĩ makamũcakaithie o makĩmũhooreragia. <verse eid="JOB 2:11"/><verse number="12" style="v" sid="JOB 2:12"/>Rĩrĩa maamuonire marĩ o haraaya-rĩ, makĩrigwo nĩwe nĩ ũrĩa aahaanaga; makĩambĩrĩria kũrĩra maanĩrĩire, na magĩtembũranga nguo ciao, o na makĩĩhurĩria rũkũngũ mĩtwe. <verse eid="JOB 2:12"/><verse number="13" style="v" sid="JOB 2:13"/>Ningĩ magĩcooka magĩikara thĩ hamwe nake matukũ mũgwanja, mũthenya na ũtukũ, na gũtirĩ mũndũ wamwaragĩria kiugo o na kĩmwe, nĩgũkorwo nĩmoonire atĩ kũnyamarĩka gwake kwarĩ kũnene mũno.<verse eid="JOB 2:13"/></para>
  <chapter eid="JOB 2"/>
  <chapter number="3" style="c" sid="JOB 3"/>
  <para style="s1">Mĩario ya Ayubu</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 3:1"/>Thuutha wa matukũ macio, Ayubu agĩtumũra kanua, akĩruma mũthenya ũrĩa aaciarirwo. <verse eid="JOB 3:1"/><verse number="2" style="v" sid="JOB 3:2"/>Akiuga atĩrĩ:<verse eid="JOB 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 3:3"/>“Mũthenya ũrĩa niĩ ndaciarirwo ũroora,</para>
  <para style="q2" vid="JOB 3:3">o na ũtukũ ũcio kwerirwo atĩrĩ, ‘Mũtumia nĩaciara mwana wa kahĩĩ!’<verse eid="JOB 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 3:4"/>Mũthenya ũcio-rĩ, ũrotuĩka o nduma;</para>
  <para style="q2" vid="JOB 3:4">Ngai arĩ igũrũ aroaga kũũrũmbũiya;</para>
  <para style="q2" vid="JOB 3:4">mũthenya ũcio ũroaga gũthererwo nĩ ũtheri.<verse eid="JOB 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 3:5"/>Mũthenya ũcio ũrokĩĩnyiitĩrwo nĩ nduma nene na kĩĩruru gĩa gĩkuũ;</para>
  <para style="q2" vid="JOB 3:5">ũrohumbĩrwo nĩ itu;</para>
  <para style="q2" vid="JOB 3:5">nduma ĩrotooria ũtheri waguo.<verse eid="JOB 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 3:6"/>Ũtukũ ũcio-rĩ, ũronyiitwo nĩ nduma ndumanu;</para>
  <para style="q2" vid="JOB 3:6">ũroaga gũtaranĩrio na mĩthenya ĩrĩa ĩngĩ ya mwaka,</para>
  <para style="q2" vid="JOB 3:6">o na kana ũtarwo harĩ mweri o na ũrĩkũ.<verse eid="JOB 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 3:7"/>Ũtukũ ũcio ũrothaata;</para>
  <para style="q2" vid="JOB 3:7">o na gũtikanoigwo ngemi ũtukũ ũcio.<verse eid="JOB 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 3:8"/>Arĩa marumaga mĩthenya maroruma mũthenya ũcio,</para>
  <para style="q2" vid="JOB 3:8">o acio moĩ kwarahũra nyamũ ĩrĩa ĩĩtagwo Leviathani.<verse eid="JOB 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 3:9"/>Njata ciaguo cia rũciinĩ irotuĩka nduma;</para>
  <para style="q2" vid="JOB 3:9">ũroeterera ũtheri na wage kũwona,</para>
  <para style="q2" vid="JOB 3:9">o na ũroaga kuona ruoro rũgĩtema,<verse eid="JOB 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 3:10"/>nĩ ũndũ ndũigana kũhinga mĩrango ya nda ya maitũ,</para>
  <para style="q2" vid="JOB 3:10">na ndũigana kũgirĩrĩria maitho makwa kuona thĩĩna.<verse eid="JOB 3:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 3:11"/>“Ndaagire gũkua ngĩciarwo nĩkĩ?</para>
  <para style="q2" vid="JOB 3:11">Ndaagire gũkua ngiuma nda nĩkĩ?<verse eid="JOB 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 3:12"/>Ndaamũkĩrirwo maru-inĩ nĩkĩ?</para>
  <para style="q2" vid="JOB 3:12">Ndaamũkĩrirwo nyondo-inĩ atĩ nĩguo nyongithio nĩkĩ?<verse eid="JOB 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 3:13"/>Nĩgũkorwo rĩu ingĩkomete ndĩ na thayũ;</para>
  <para style="q2" vid="JOB 3:13">rĩu ingĩrĩ toro hurũkĩte<verse eid="JOB 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 3:14"/>hamwe na athamaki na aheani kĩrĩra a gũkũ thĩ</para>
  <para style="q2" vid="JOB 3:14">arĩa meeyakĩire kũndũ kũrĩa kwanangĩku rĩngĩ,<verse eid="JOB 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 3:15"/>o hamwe na aathani arĩa maarĩ na thahabu,</para>
  <para style="q2" vid="JOB 3:15">o arĩa maiyũrĩtie nyũmba ciao betha.<verse eid="JOB 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 3:16"/>Ningĩ-rĩ, nĩ kĩĩ kĩagiririe thikwo tĩĩri-inĩ ta kĩhuno</para>
  <para style="q2" vid="JOB 3:16">o na kana ta gakenge karĩa gatoonire ũtheri wa riũa?<verse eid="JOB 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 3:17"/>Kũu andũ arĩa aaganu nĩmatigĩte kũnyamarĩka,</para>
  <para style="q2" vid="JOB 3:17">na kũu arĩa anogu nĩmahurũkĩte.<verse eid="JOB 3:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 3:18"/>Kũu-rĩ, mĩgwate o nayo nĩĩkenagĩra kwaraha kwayo;</para>
  <para style="q2" vid="JOB 3:18">nĩĩtigĩte kũigua kĩgũthũko kĩa nyabaara ya ngombo.<verse eid="JOB 3:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 3:19"/>Andũ arĩa anini na arĩa anene othe marĩ kuo,</para>
  <para style="q2" vid="JOB 3:19">nayo ngombo nĩĩrekereirio kuuma kũrĩ mũmĩathi.<verse eid="JOB 3:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 3:20"/>“Nĩ kĩĩ gĩtũmaga andũ arĩa marĩ na mĩnyamaro maheo ũtheri,</para>
  <para style="q2" vid="JOB 3:20">naguo muoyo ũkaheo arĩa marĩ na ruo rwa ngoro,<verse eid="JOB 3:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 3:21"/>o acio meriragĩria gĩkuũ na gĩtingĩũka,</para>
  <para style="q2" vid="JOB 3:21">o arĩa magĩcaragia gũkĩra kĩndũ kĩa goro kĩrĩa kĩhithe,<verse eid="JOB 3:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 3:22"/>acio maiyũragwo nĩ gĩkeno</para>
  <para style="q2" vid="JOB 3:22">magakena maakinya mbĩrĩra?<verse eid="JOB 3:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 3:23"/>Nĩ kĩĩ gĩtũmaga muoyo ũheo mũndũ ũũrĩte njĩra,</para>
  <para style="q2" vid="JOB 3:23">o ũcio mũhingĩrĩrie nĩ Ngai?<verse eid="JOB 3:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 3:24"/>Nĩ ũndũ handũ ha ndĩe irio, no kuumwo nyumagwo nĩ ngoro;</para>
  <para style="q2" vid="JOB 3:24">nakuo gũcaaya gwakwa gũitĩkaga ta maaĩ.<verse eid="JOB 3:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 3:25"/>Ũndũ ũrĩa ndeetigagĩra nĩũngorete;</para>
  <para style="q2" vid="JOB 3:25">ũndũ ũrĩa wamakagia mũno nĩguo ũnginyĩrĩire.<verse eid="JOB 3:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 3:26"/>Ndionaga thayũ, o na kana ngahoorera;</para>
  <para style="q2" vid="JOB 3:26">ndionaga ũhurũko, no mĩnyamaro.”<verse eid="JOB 3:26"/></para>
  <chapter eid="JOB 3"/>
  <chapter number="4" style="c" sid="JOB 4"/>
  <para style="s1">Mĩario ya Elifazu</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 4:1"/>Nake Elifazu ũrĩa Mũtemaani agĩcookia, akĩmũũria atĩrĩ:<verse eid="JOB 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 4:2"/>“Mũndũ angĩgeria gũkũgwetera koigo kamwe-rĩ, hihi wamũkirĩrĩria?</para>
  <para style="q2" vid="JOB 4:2">No rĩrĩ, nũũ ũngĩhota kwĩgirĩrĩria kwaria?<verse eid="JOB 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 4:3"/>Ririkana ũrĩa wanataara andũ aingĩ,</para>
  <para style="q2" vid="JOB 4:3">na ũrĩa wanekĩra moko marĩa maregeru hinya.<verse eid="JOB 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 4:4"/>Ciugo ciaku cianatiirĩrĩra arĩa manahĩngwo makenda kũgũa;</para>
  <para style="q2" vid="JOB 4:4">nĩwe wanekĩra maru marĩa magondoku hinya.<verse eid="JOB 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 4:5"/>No rĩu-rĩ, nĩũkoretwo nĩ thĩĩna, nawe ũkoorwo nĩ hinya;</para>
  <para style="q2" vid="JOB 4:5">ũhũũrĩtwo, nawe ũkanyiitwo nĩ kĩmako.<verse eid="JOB 4:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 4:6"/>Githĩ wĩtigĩri Ngai waku tiguo wagĩrĩirwo gũtuĩka ũũmĩrĩru waku,</para>
  <para style="q2" vid="JOB 4:6">nayo mĩthiĩre yaku ĩtarĩ ũcuuke-rĩ, githĩ tiyo mwĩhoko waku?<verse eid="JOB 4:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 4:7"/>“Ta wĩcũũranie atĩrĩ: Nĩ mũndũ ũrĩkũ wanathĩĩnĩka atekĩte ũũru?</para>
  <para style="q2" vid="JOB 4:7">Nĩ kũ andũ arĩa arũngĩrĩru marĩ maniinwo?<verse eid="JOB 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 4:8"/>Niĩ ũrĩa nyonete-rĩ, nĩ atĩ andũ arĩa marĩmaga ũũru,</para>
  <para style="q2" vid="JOB 4:8">na arĩa mahaandaga thĩĩna-rĩ, maũndũ macio no mo magethaga.<verse eid="JOB 4:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 4:9"/>Manangagwo nĩ mĩhũmũ ya Ngai;</para>
  <para style="q2" vid="JOB 4:9">makaniinwo nĩ kĩhuhũkanio kĩa marakara make.<verse eid="JOB 4:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 4:10"/>Mĩrũũthi no ĩrume na ĩrarame,</para>
  <para style="q2" vid="JOB 4:10">no magego ma mĩrũũthi ĩyo mĩnene nĩmakoinangwo.<verse eid="JOB 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 4:11"/>Mũrũũthi nĩũkuaga nĩ kwaga gĩa kũguĩma,</para>
  <para style="q2" vid="JOB 4:11">nacio ciana cia mũrũũthi wa mũgoma ikahurunjũka.<verse eid="JOB 4:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 4:12"/>“Nĩ kũrĩ kohoro karanginyĩire na hitho,</para>
  <para style="q2" vid="JOB 4:12">namo matũ makwa marakaigua gakĩhehanwo.<verse eid="JOB 4:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 4:13"/>Ũtukũ ngĩĩcũũrania ũhoro wa cioneki cia kũmakania,</para>
  <para style="q2" vid="JOB 4:13">ũtukũ rĩrĩa andũ makoragwo marĩ toro mũnene,<verse eid="JOB 4:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 4:14"/>ngĩnyiitwo nĩ guoya na kũinaina,</para>
  <para style="q2" vid="JOB 4:14">namo mahĩndĩ makwa mothe magĩthingitha.<verse eid="JOB 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 4:15"/>O hĩndĩ ĩyo roho ũraahĩtũkĩra o ũthiũ-inĩ wakwa,</para>
  <para style="q2" vid="JOB 4:15">nacio njuĩrĩ cia mwĩrĩ wakwa irambarara.<verse eid="JOB 4:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 4:16"/>Roho ũcio ũrarũgama,</para>
  <para style="q2" vid="JOB 4:16">no ndinahota kũmenya ũrĩa ũratariĩ.</para>
  <para style="q1" vid="JOB 4:16">Mbere yakwa hararũgama mũhianĩre wa kĩndũ,</para>
  <para style="q2" vid="JOB 4:16">ndĩracooka ndĩraigua gũkĩario na mĩheehũ gũkĩũrio atĩrĩ,<verse eid="JOB 4:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 4:17"/>‘Mũndũ wa gũkua-rĩ, aahota gũtuĩka mũthingu gũkĩra Ngai?</para>
  <para style="q2" vid="JOB 4:17">Mũndũ aahota gũtuĩka mũtheru gũkĩra Mũmũũmbi?<verse eid="JOB 4:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 4:18"/>Angĩkorwo Ngai ndangĩhota kwĩhoka ndungata ciake-rĩ,</para>
  <para style="q2" vid="JOB 4:18">na angĩkorwo nĩonaga araika ake marĩ na mahĩtia-rĩ,<verse eid="JOB 4:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 4:19"/>githĩ to oone mahĩtia maingĩ mũno ma andũ arĩa matũũraga nyũmba cia ndoro,</para>
  <para style="q2" vid="JOB 4:19">acio mĩthingi yao ĩrĩ rũkũngũ-inĩ,</para>
  <para style="q2" vid="JOB 4:19">acio mamemendagwo na ihenya gũkĩra kĩĩhuruta!<verse eid="JOB 4:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 4:20"/>Kuuma rũciinĩ nginya hwaĩ-inĩ moinangagwo tũcunjĩ;</para>
  <para style="q2" vid="JOB 4:20">magathira tene na tene matekũrũmbũiyo.<verse eid="JOB 4:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 4:21"/>Githĩ mĩkanda ya hema yao ndĩmunyũrĩtwo,</para>
  <para style="q2" vid="JOB 4:21">nĩguo makue matarĩ na ũũgĩ?’<verse eid="JOB 4:21"/></para>
  <para style="b"/>
  <chapter eid="JOB 4"/>
  <chapter number="5" style="c" sid="JOB 5"/>
  <para style="q1">
    <verse number="1" style="v" sid="JOB 5:1"/>“Wenda gwĩtana, ĩtana, no rĩrĩ, nũũ ũngĩgwĩtĩka?</para>
  <para style="q2" vid="JOB 5:1">Nĩ ũrĩkũ wa arĩa atheru ũngĩũrĩra kũrĩ we?<verse eid="JOB 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 5:2"/>Rũngʼathio rũũragaga kĩrimũ,</para>
  <para style="q2" vid="JOB 5:2">naguo ũiru ũkooraga mũndũ ũrĩa mũkĩĩgu.<verse eid="JOB 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 5:3"/>Niĩ mwene nĩnyonete kĩrimũ gĩkĩgĩa na mĩri,</para>
  <para style="q2" vid="JOB 5:3">no-o rĩmwe nyũmba yakĩo ĩkĩrumwo.<verse eid="JOB 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 5:4"/>Ciana ciake nĩiraihanĩrĩirie na ũgitĩri,</para>
  <para style="q2" vid="JOB 5:4">ihatĩrĩirio igooti-inĩ itarĩ na mũndũ wa gũciciirĩrĩra.<verse eid="JOB 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 5:5"/>Ũrĩa mũhũtu arĩĩaga magetha make,</para>
  <para style="q2" vid="JOB 5:5">amoyaga o na marĩ mĩigua-inĩ,</para>
  <para style="q2" vid="JOB 5:5">nao arĩa anyootu makahũmagĩra ũtonga wao.<verse eid="JOB 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 5:6"/>Nĩgũkorwo hatĩka ndĩkunũkaga kuuma thĩ,</para>
  <para style="q2" vid="JOB 5:6">kana thĩĩna ũkamera tĩĩri-inĩ.<verse eid="JOB 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 5:7"/>No rĩrĩ, mũndũ aciaragwo arĩ wa kuonaga thĩĩna,</para>
  <para style="q2" vid="JOB 5:7">o ta ũrĩa na ma thandĩ cia mwaki irathũkaga na igũrũ.<verse eid="JOB 5:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 5:8"/>“No rĩrĩ, korwo nĩ niĩ ingĩthaitha Mũrungu;</para>
  <para style="q2" vid="JOB 5:8">ingĩneana ciira wakwa kũrĩ we.<verse eid="JOB 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 5:9"/>We ekaga maũndũ ma magegania marĩa mataangĩmenyeka,</para>
  <para style="q2" vid="JOB 5:9">na akaringa ciama itangĩtarĩka.<verse eid="JOB 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 5:10"/>Nĩwe uuragĩria thĩ mbura;</para>
  <para style="q2" vid="JOB 5:10">na nĩwe ũrehagĩra bũrũri maaĩ.<verse eid="JOB 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 5:11"/>Arĩa menyiihagia nĩwe ũmatũũgagĩria,</para>
  <para style="q2" vid="JOB 5:11">nao arĩa marĩ na kĩeha moyagwo na igũrũ makagitĩrwo.<verse eid="JOB 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 5:12"/>Nĩwe ũthaatagia mĩbango ya arĩa marĩ waara,</para>
  <para style="q2" vid="JOB 5:12">nĩgeetha moko mao matikagĩe na ũhootani.<verse eid="JOB 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 5:13"/>Nĩanyiitaga arĩa oogĩ waara-inĩ wao,</para>
  <para style="q2" vid="JOB 5:13">namo mathugunda ma arĩa oingumania akaameheria biũ.<verse eid="JOB 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 5:14"/>Nduma ĩmakoraga kũrĩ o mũthenya;</para>
  <para style="q2" vid="JOB 5:14">mũthenya barigici makahambataga taarĩ ũtukũ.<verse eid="JOB 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 5:15"/>Nĩahonokagia arĩa abatari kuuma kũrĩ rũhiũ rwa njora rũrĩa rũrĩ tũnua-inĩ twao;</para>
  <para style="q2" vid="JOB 5:15">amahonokagia moko-inĩ ma arĩa marĩ hinya.<verse eid="JOB 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 5:16"/>Nĩ ũndũ ũcio athĩĩni makagĩa na kĩĩrĩgĩrĩro,</para>
  <para style="q2" vid="JOB 5:16">naguo ciira ũtarĩ wa kĩhooto ũgatumia kanua.<verse eid="JOB 5:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 5:17"/>“Kũrathimwo nĩ mũndũ ũrĩa ũrũngagwo nĩ Ngai;</para>
  <para style="q2" vid="JOB 5:17">nĩ ũndũ ũcio ndũkamene irũithia rĩa Mwene-Hinya-Wothe.<verse eid="JOB 5:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 5:18"/>Nĩgũkorwo nĩaguraranagia, no rĩrĩ, acookaga akooha nguraro ĩyo wega;</para>
  <para style="q2" vid="JOB 5:18">nĩatiihanagia, no moko make no mo mahonanagia.<verse eid="JOB 5:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 5:19"/>Nĩagagũteithũra harĩ mĩtino ĩtandatũ;</para>
  <para style="q2" vid="JOB 5:19">o na ĩrĩ mũgwanja-rĩ, gũtirĩ ũũru ũgaagũkora.<verse eid="JOB 5:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 5:20"/>Hĩndĩ ya ngʼaragu nĩagagũkũũra kuuma kũrĩ gĩkuũ,</para>
  <para style="q2" vid="JOB 5:20">ningĩ hĩndĩ ya mbaara agũkũũre ndũkooragwo na rũhiũ rwa njora.<verse eid="JOB 5:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 5:21"/>Nĩũkagitĩrwo harĩ rũcamiũ rwa rũrĩmĩ,</para>
  <para style="q2" vid="JOB 5:21">na ndũgetigĩra hĩndĩ ĩrĩa mwanangĩko ũgooka.<verse eid="JOB 5:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 5:22"/>Nĩũgathekerera mwanangĩko na ngʼaragu,</para>
  <para style="q2" vid="JOB 5:22">na ndũgetigĩra nyamũ cia gũkũ thĩ.<verse eid="JOB 5:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 5:23"/>Nĩgũkorwo nĩũkagĩa na kĩrĩkanĩro na mahiga ma werũ-inĩ,</para>
  <para style="q2" vid="JOB 5:23">nacio nyamũ cia gĩthaka itũũre irĩ na thayũ nawe.<verse eid="JOB 5:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 5:24"/>Nawe ũikarage ũũĩ atĩ hema yaku nĩ ngitĩre;</para>
  <para style="q2" vid="JOB 5:24">nawe nĩũkooya ithabu rĩa indo ciaku ũkore hatirĩ kĩndũ kĩũrĩte.<verse eid="JOB 5:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 5:25"/>Nĩũkamenya atĩ ciana ciaku nĩikaingĩha,</para>
  <para style="q2" vid="JOB 5:25">nacio njiaro ciaku cingĩhe o ta nyeki ya gũkũ thĩ.<verse eid="JOB 5:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 5:26"/>Ũgaathiĩ mbĩrĩra-inĩ ũrĩ o na hinya,</para>
  <para style="q2" vid="JOB 5:26">ũhaana ta itĩĩa cia ngano ĩgethetwo hĩndĩ ya magetha.<verse eid="JOB 5:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 5:27"/>“Nĩtũtuĩrĩtie ũhoro ũyũ, na nĩ wa ma.</para>
  <para style="q2" vid="JOB 5:27">Nĩ ũndũ ũcio kĩũigue na ũũmenye wee mwene.”<verse eid="JOB 5:27"/></para>
  <chapter eid="JOB 5"/>
  <chapter number="6" style="c" sid="JOB 6"/>
  <para style="s1">Mĩario ya Ayubu</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 6:1"/>Ningĩ Ayubu agĩcookia atĩrĩ:<verse eid="JOB 6:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 6:2"/>“Naarĩ korwo ruo rũrũ ndĩ naruo rwathimwo,</para>
  <para style="q2" vid="JOB 6:2">nayo mĩnyamaro ĩno ndĩ nayo yothe ĩigĩrĩrwo ratiri igũrũ!<verse eid="JOB 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 6:3"/>Ti-itherũ yakorwo ĩrĩ mĩritũ gũkĩra mũthanga ũrĩa ũrĩ maria-inĩ marĩa manene;</para>
  <para style="q2" vid="JOB 6:3">na nĩkĩo ndĩrahiũhire kwaria.<verse eid="JOB 6:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 6:4"/>Mĩguĩ ya Mwene-Hinya-Wothe nĩĩndoonyete,</para>
  <para style="q2" vid="JOB 6:4">naguo roho wakwa nĩũranyua ũrũrũ wayo;</para>
  <para style="q2" vid="JOB 6:4">maũndũ ma kũmakania mũno ma Ngai nĩmerekeirio harĩ niĩ.<verse eid="JOB 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 6:5"/>Njagĩ ya werũ-inĩ-rĩ, nĩyaanagia rĩrĩa ĩrĩ na nyeki ya kũrĩa,</para>
  <para style="q2" vid="JOB 6:5">kana ndegwa ĩkaania rĩrĩa ĩtuĩrĩirwo?<verse eid="JOB 6:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 6:6"/>Irio itarĩ mũcamo nĩ irĩĩkaga itekĩrĩtwo cumbĩ?</para>
  <para style="q2" vid="JOB 6:6">Mũruru wa itumbĩ ũrĩa mwerũ-rĩ, nĩ urĩ mũrĩo?<verse eid="JOB 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 6:7"/>Niĩ ndingĩcihutia;</para>
  <para style="q2" vid="JOB 6:7">irio ta icio no itũme njire ngoro.<verse eid="JOB 6:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 6:8"/>“Naarĩ korwo ndaheo ũndũ ũrĩa ndĩrahooya,</para>
  <para style="q2" vid="JOB 6:8">korwo Ngai aahe ũndũ ũrĩa ndĩrerirĩria,<verse eid="JOB 6:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 6:9"/>naguo nĩ atĩ Ngai eetĩkĩre kũũmemenda,</para>
  <para style="q2" vid="JOB 6:9">arekererie guoko gwake kũũniine!<verse eid="JOB 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 6:10"/>Hĩndĩ ĩyo no ngĩe na ũndũ wa kũũhooreria,</para>
  <para style="q2" vid="JOB 6:10">ũndũ wa gĩkeno ruo-inĩ rũrũ rũtarathira,</para>
  <para style="q2" vid="JOB 6:10">atĩ niĩ ndikaanĩte ciugo cia Ũrĩa Mũtheru.<verse eid="JOB 6:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 6:11"/>“Ndĩ na hinya ũrĩkũ atĩ nĩguo njikare ndĩ na mwĩhoko?</para>
  <para style="q2" vid="JOB 6:11">Ndĩ na kĩĩrĩgĩrĩro kĩrĩkũ atĩ nĩguo ngirĩrĩrie?<verse eid="JOB 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 6:12"/>Niĩ ndĩ hinya ta ihiga?</para>
  <para style="q2" vid="JOB 6:12">Mwĩrĩ wakwa nĩ wa gĩcango?<verse eid="JOB 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 6:13"/>Niĩ ndĩ na hinya wa gwĩteithia,</para>
  <para style="q2" vid="JOB 6:13">kuona atĩ rĩu nĩndunyĩtwo ũhootani?<verse eid="JOB 6:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 6:14"/>“Mũndũ ũtarĩ na kĩĩrĩgĩrĩro aagĩrĩire gũteithio nĩ arata ake,</para>
  <para style="q2" vid="JOB 6:14">o na angĩkorwo nĩatiganĩirie ũhoro wa gwĩtigĩra Ũrĩa Mwene-Hinya-Wothe.<verse eid="JOB 6:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 6:15"/>No ariũ a baba maagĩte kwĩhokeka o ta tũrũũĩ tũrĩa tũhũaga,</para>
  <para style="q2" vid="JOB 6:15">ningĩ o ta tũrũũĩ tũrĩa tũiyũraga tũkoina,<verse eid="JOB 6:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 6:16"/>rĩrĩa tũirĩtio nĩ mbarabu ĩgĩtweka,</para>
  <para style="q2" vid="JOB 6:16">na tũkaiyũrwo nĩ tharunji ĩrĩa ĩratweka,<verse eid="JOB 6:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 6:17"/>no rĩrĩ, tũtithereraga rĩrĩa kwara,</para>
  <para style="q2" vid="JOB 6:17">na hĩndĩ ya ũrugarĩ tũkahũa mĩtaro-inĩ yatuo.<verse eid="JOB 6:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 6:18"/>Ikundi cia agendi nĩithaamaga njĩra ciacio,</para>
  <para style="q2" vid="JOB 6:18">ikambata werũ-inĩ, igathirĩra kuo.<verse eid="JOB 6:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 6:19"/>Ikundi cia agendi cia Tema icaragia maaĩ,</para>
  <para style="q2" vid="JOB 6:19">agendi a wonjoria a Sheba makamacaria marĩ na mwĩhoko.<verse eid="JOB 6:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 6:20"/>Magathĩĩnĩka, tondũ makoretwo marĩ na kĩĩrĩgĩrĩro;</para>
  <para style="q2" vid="JOB 6:20">no maakinya ho magakora hatirĩ kĩndũ.<verse eid="JOB 6:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 6:21"/>O na inyuĩ-rĩ, mũtuĩkĩte andũ matangĩheana ũteithio;</para>
  <para style="q2" vid="JOB 6:21">muonaga ũndũ wa kũmakania mũgetigĩra.<verse eid="JOB 6:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 6:22"/>Niĩ-rĩ, nĩ ndĩ ndoiga atĩrĩ: ‘Heanai kĩndũ nĩ ũndũ wakwa,</para>
  <para style="q2" vid="JOB 6:22">ngũũrai na indo cianyu,<verse eid="JOB 6:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 6:23"/>honokiai guoko-inĩ gwa thũ,</para>
  <para style="q2" vid="JOB 6:23">ngũũrai kuuma moko-inĩ ma arĩa matarĩ tha’?<verse eid="JOB 6:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 6:24"/>“Atĩrĩrĩ, ndutaai ũhoro na nĩngũkira;</para>
  <para style="q2" vid="JOB 6:24">nyonereriai harĩa hĩtĩtie.<verse eid="JOB 6:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 6:25"/>Kaĩ ciugo cia ma irĩ ruo-ĩ!</para>
  <para style="q2" vid="JOB 6:25">No rĩrĩ, ngarari cianyu nĩ kĩhooto kĩrĩkũ irarehe?<verse eid="JOB 6:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 6:26"/>Anga mũrenda kũruta mahĩtia ũrĩa njugĩte,</para>
  <para style="q2" vid="JOB 6:26">mũgatua ciugo cia mũndũ ũũmĩirwo tha taarĩ rũhuho?<verse eid="JOB 6:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 6:27"/>Inyuĩ o na no mũcuukĩre mwana wa ngoriai mĩtĩ,</para>
  <para style="q2" vid="JOB 6:27">na mwendie mũrata wanyu.<verse eid="JOB 6:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 6:28"/>“No rĩu-rĩ, ndamũthaitha mwĩtĩkĩre kũndora.</para>
  <para style="q2" vid="JOB 6:28">Anga no ngĩheenanie o maitho-inĩ manyu?<verse eid="JOB 6:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 6:29"/>Mwĩcũraniei nĩguo mũtikogomie kĩhooto;</para>
  <para style="q2" vid="JOB 6:29">njookererai, nĩgũkorwo wĩhokeku wakwa nĩguo ũraarũithio.<verse eid="JOB 6:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 6:30"/>Nĩ kũrĩ wĩhia ũrĩ mĩromo-inĩ yakwa?</para>
  <para style="q2" vid="JOB 6:30">Anga kanua gakwa gatingĩhota gũkũũrana maũndũ ma rũmena?<verse eid="JOB 6:30"/></para>
  <para style="b"/>
  <chapter eid="JOB 6"/>
  <chapter number="7" style="c" sid="JOB 7"/>
  <para style="q1">
    <verse number="1" style="v" sid="JOB 7:1"/>“Githĩ mũndũ ndakoragwo na ũtungata mũritũ gũkũ thĩ?</para>
  <para style="q2" vid="JOB 7:1">Githĩ matukũ make matihaana o ta ma mũndũ mwandĩke wĩra?<verse eid="JOB 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 7:2"/>O ta ngombo ĩkwĩrirĩria ciĩruru cia hwaĩ-inĩ,</para>
  <para style="q2" vid="JOB 7:2">o na kana ta mũndũ mwandĩke ũgũthethũkĩra mũcaara wake-rĩ,<verse eid="JOB 7:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 7:3"/>ũguo nĩguo niĩ ngaĩirwo mĩeri ya tũhũ,</para>
  <para style="q2" vid="JOB 7:3">na ngatuĩrwo atĩ ũtukũ ndaarage ndĩ na kĩeha.<verse eid="JOB 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 7:4"/>Rĩrĩa ndakoma ndĩyũragia atĩrĩ, ‘Ndĩrĩũkĩra rĩ?’</para>
  <para style="q2" vid="JOB 7:4">Ũtukũ ũkaraiha, na ngaraara ngĩĩgarũra nginya gũgakĩa.<verse eid="JOB 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 7:5"/>Mwĩrĩ wakwa ũiyũrĩtwo nĩ igunyũ na ngũcĩ,</para>
  <para style="q2" vid="JOB 7:5">nakĩo gĩkonde gĩakwa gĩatũkangĩte na gĩgatogota.<verse eid="JOB 7:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 7:6"/>“Matukũ makwa maraathira na ihenya rĩkĩrĩte rĩa kanyamũ karĩa gakonjithanagia uuthi ngoora ĩgĩtumwo,</para>
  <para style="q2" vid="JOB 7:6">magagĩkinya mũthia itarĩ na kĩĩrĩgĩrĩro.<verse eid="JOB 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 7:7"/>Wee Ngai-rĩ, ririkana atĩ muoyo wakwa no ta mĩhũmũ;</para>
  <para style="q2" vid="JOB 7:7">namo maitho makwa matigacooka kuona ũndũ mwega rĩngĩ.<verse eid="JOB 7:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 7:8"/>Riitho rĩrĩa rĩranyona rĩtigacooka kũnyona rĩngĩ;</para>
  <para style="q2" vid="JOB 7:8">mũkaanjaria, no ndigakorwo ho.<verse eid="JOB 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 7:9"/>O ta ũrĩa itu rĩthiiaga rĩkabuĩria,</para>
  <para style="q2" vid="JOB 7:9">ũguo noguo ũrĩa ũthiiaga mbĩrĩra-inĩ atacookaga kuoneka.<verse eid="JOB 7:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 7:10"/>Ndagacooka kũinũka gwake mũciĩ;</para>
  <para style="q2" vid="JOB 7:10">harĩa aaikaraga ndagacooka kuonwo ho.<verse eid="JOB 7:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 7:11"/>“Nĩ ũndũ ũcio-rĩ, ndigũkira;</para>
  <para style="q2" vid="JOB 7:11">ngwaria nĩ ũndũ wa ũrĩa roho wakwa ũrĩ na ruo,</para>
  <para style="q2" vid="JOB 7:11">ndĩtetere nĩ ũndũ wa ũrĩa ngoro yakwa ĩrĩ na marũrũ.<verse eid="JOB 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 7:12"/>Niĩ-rĩ, ndĩ iria rĩa maaĩ, kana nyamũ ĩrĩa nene ĩtũũraga iria thĩinĩ kũrĩa kũriku,</para>
  <para style="q2" vid="JOB 7:12">atĩ nĩkĩo nangagĩrwo?<verse eid="JOB 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 7:13"/>Rĩrĩa ngwĩciiria ũrĩrĩ wakwa nĩguo ũkũũhooreria,</para>
  <para style="q2" vid="JOB 7:13">na atĩ gĩtanda gĩakwa no kĩĩniinĩre gũteta-rĩ,<verse eid="JOB 7:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 7:14"/>o na hĩndĩ ĩyo ũũmakagia na irooto,</para>
  <para style="q2" vid="JOB 7:14">o na ũkanjiguithia guoya na cioneki,<verse eid="JOB 7:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 7:15"/>nĩ ũndũ ũcio ngathuura kaba gũitwo, na gĩkuũ,</para>
  <para style="q2" vid="JOB 7:15">handũ ha gũikara na mwĩrĩ ũyũ wakwa.<verse eid="JOB 7:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 7:16"/>Nĩthũire muoyo wakwa; ndikwenda gũtũũra nginya tene.</para>
  <para style="q2" vid="JOB 7:16">Tigana na niĩ tondũ matukũ makwa no ma tũhũ.<verse eid="JOB 7:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 7:17"/>“Mũndũ-rĩ, akĩrĩ kĩ, tondũ ũmwĩkĩrĩire ũguo,</para>
  <para style="q2" vid="JOB 7:17">na ũkamũrũmbũyia mũno ũguo,<verse eid="JOB 7:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 7:18"/>atĩ ũmũthuthuuragia ngoro o rũciinĩ,</para>
  <para style="q2" vid="JOB 7:18">na ũkamũgeragia mahinda mothe?<verse eid="JOB 7:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 7:19"/>Kaĩ gũtarĩ hĩndĩ ũgaatiga gũikara ũndorete,</para>
  <para style="q2" vid="JOB 7:19">kana ũtigane na niĩ o na kahinda kanini?<verse eid="JOB 7:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 7:20"/>Angĩkorwo nĩnjĩhĩtie-rĩ, nĩ atĩa niĩ ngwĩkĩte,</para>
  <para style="q2" vid="JOB 7:20">Wee mũrori wa andũ?</para>
  <para style="q1" vid="JOB 7:20">Nĩ kĩĩ gĩtũmĩte ũnjorote?</para>
  <para style="q2" vid="JOB 7:20">Kaĩ nduĩkĩte mũrigo harĩwe?<verse eid="JOB 7:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 7:21"/>Nĩ kĩĩ kĩragiria ũnjohere mahĩtia makwa</para>
  <para style="q2" vid="JOB 7:21">na ũndekere mehia makwa?</para>
  <para style="q1" vid="JOB 7:21">Nĩgũkorwo ndĩ hakuhĩ gũkoma tĩĩri-inĩ;</para>
  <para style="q2" vid="JOB 7:21">nawe nĩũkanjaria no ndigakorwo ho.”<verse eid="JOB 7:21"/></para>
  <chapter eid="JOB 7"/>
  <chapter number="8" style="c" sid="JOB 8"/>
  <para style="s1">Mĩario ya Bilidadi</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 8:1"/>Nake Bilidadi ũrĩa Mũshuhi agĩcookia, akĩũria atĩrĩ:<verse eid="JOB 8:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 8:2"/>“Nĩ nginya rĩ ũgũikara ũkĩaragia maũndũ ta macio?</para>
  <para style="q2" vid="JOB 8:2">Ciugo ciaku no ta inegene rĩa rũhuho rũkĩhurutana.<verse eid="JOB 8:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 8:3"/>Mũrungu-rĩ, nĩogomagia ciira wa kĩhooto?</para>
  <para style="q2" vid="JOB 8:3">Ũcio Mwene-Hinya-Wothe nĩogomagia ũndũ ũrĩa ũrĩ wa ma?<verse eid="JOB 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 8:4"/>Rĩrĩa ciana ciaku ciamwĩhĩirie-rĩ,</para>
  <para style="q2" vid="JOB 8:4">nĩacirekereirie iherithio nĩ ũndũ wa mehia ma cio.<verse eid="JOB 8:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 8:5"/>No rĩrĩ, wee ũngĩcũthĩrĩria Mũrungu</para>
  <para style="q2" vid="JOB 8:5">na wĩthaithanĩrĩre harĩ Ũcio Mwene-Hinya-Wothe,<verse eid="JOB 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 8:6"/>ũngĩkorwo ũrĩ mũtheru na mũrũngĩrĩru-rĩ,</para>
  <para style="q2" vid="JOB 8:6">o na rĩu no arahũke nĩ ũndũ waku</para>
  <para style="q2" vid="JOB 8:6">nĩguo agũcookie handũ harĩa hakwagĩrĩire.<verse eid="JOB 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 8:7"/>O na gũtuĩka kĩambĩrĩria gĩaku no kĩoneke kĩrĩ kĩnini,</para>
  <para style="q2" vid="JOB 8:7">thuutha-inĩ nĩũkagaacĩra mũno.<verse eid="JOB 8:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 8:8"/>“Ũria ũhoro harĩ njiarwa cia tene,</para>
  <para style="q2" vid="JOB 8:8">na ũtuĩrie maũndũ marĩa maithe mao meerutire,<verse eid="JOB 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 8:9"/>nĩgũkorwo ithuĩ tũraciarirwo o ro ira na tũtirĩ ũndũ tũũĩ,</para>
  <para style="q2" vid="JOB 8:9">namo matukũ maitũ ma gũikara gũkũ thĩ no ta kĩĩruru.<verse eid="JOB 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 8:10"/>Acio githĩ to makũrute na makũhe ũhoro?</para>
  <para style="q2" vid="JOB 8:10">Acio githĩ to maarie ũhoro marĩ na ũmenyo?<verse eid="JOB 8:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 8:11"/>Irura-rĩ, no rĩkũre handũ hatarĩ itomboya?</para>
  <para style="q2" vid="JOB 8:11">Ithanjĩ-rĩ, no rĩtheereme handũ hatarĩ maaĩ?<verse eid="JOB 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 8:12"/>Rĩngĩkũrĩra handũ hatarĩ maaĩ rĩũmaga narua gũkĩra nyeki,</para>
  <para style="q2" vid="JOB 8:12">o na rĩtakinyĩte rĩa gũtuuo.<verse eid="JOB 8:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 8:13"/>Ũcio nĩguo mũthia wa arĩa othe mariganagĩrwo nĩ Mũrungu;</para>
  <para style="q2" vid="JOB 8:13">ũguo no ta guo mwĩhoko wa arĩa matooĩ Ngai ũthiraga.<verse eid="JOB 8:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 8:14"/>Kĩrĩa ehokete no kĩndũ kĩhũthũ;</para>
  <para style="q2" vid="JOB 8:14">kĩrĩa egiritanagia nakĩo no ta rũrenda rwa mbũmbũĩ.<verse eid="JOB 8:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 8:15"/>Etiiranagia na rũrenda rwake, naruo rũgatuĩka;</para>
  <para style="q2" vid="JOB 8:15">akenyiitĩrĩra harĩ ruo, no rũtingĩmũtiirĩrĩra.<verse eid="JOB 8:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 8:16"/>Ahaana ta mũtĩ ũitĩrĩirio maaĩ wega ũrĩ riũa-inĩ,</para>
  <para style="q2" vid="JOB 8:16">ũtambũrũkĩtie thuuna ciaguo mũgũnda-inĩ;<verse eid="JOB 8:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 8:17"/>mĩri yaguo ĩĩthiororokeirie kĩhumbu kĩa mahiga,</para>
  <para style="q2" vid="JOB 8:17">na ĩcaragia ha kwĩgwatĩrĩra rwaro-inĩ rwa mahiga.<verse eid="JOB 8:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 8:18"/>No rĩrĩa wakũũrwo harĩa ũraarĩ-rĩ,</para>
  <para style="q2" vid="JOB 8:18">handũ hau hagakaana mũtĩ ũcio, hakoiga atĩrĩ, ‘Niĩ ndirĩ ndakuona.’<verse eid="JOB 8:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 8:19"/>Ti-itherũ muoyo waguo ũmaga ũgathira,</para>
  <para style="q2" vid="JOB 8:19">naho hau tĩĩri-inĩ ũcio hagakũra mĩtĩ ĩngĩ.<verse eid="JOB 8:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 8:20"/>“Ti-itherũ Mũrungu ndangĩrega mũndũ ũtarĩ ũcuuke,</para>
  <para style="q2" vid="JOB 8:20">kana ekĩre moko ma arĩa mekaga ũũru hinya.<verse eid="JOB 8:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 8:21"/>Na rĩrĩ, no arĩiyũria kanua gaku mĩtheko,</para>
  <para style="q2" vid="JOB 8:21">nayo mĩromo yaku yanĩrĩre nĩ gũkena.<verse eid="JOB 8:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 8:22"/>Thũ ciaku nĩikahumbwo thoni,</para>
  <para style="q2" vid="JOB 8:22">nacio hema cia arĩa aaganu itigacooka kuonwo.”<verse eid="JOB 8:22"/></para>
  <chapter eid="JOB 8"/>
  <chapter number="9" style="c" sid="JOB 9"/>
  <para style="s1">Mĩario ya Ayubu</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 9:1"/>Ningĩ Ayubu agĩcookia, akiuga atĩrĩ:<verse eid="JOB 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 9:2"/>“Ti-itherũ nĩnjũũĩ ũhoro ũcio nĩ wa ma.</para>
  <para style="q2" vid="JOB 9:2">No rĩrĩ, mũndũ angĩhota atĩa gũkorwo arĩ mũthingu mbere ya Mũrungu?<verse eid="JOB 9:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 9:3"/>O na korwo mũndũ enda gũkararania na Ngai-rĩ,</para>
  <para style="q2" vid="JOB 9:3">ndangĩhota kũmũcookeria kĩũria o na kĩmwe harĩ ciũria ngiri.<verse eid="JOB 9:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 9:4"/>Ũũgĩ wake nĩ mũingĩ mũno, na ũhoti wake nĩ mũnene.</para>
  <para style="q2" vid="JOB 9:4">Nũũ wanaregana nake akĩgaacĩra?<verse eid="JOB 9:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 9:5"/>Eeheragia irĩma itekũmenya,</para>
  <para style="q2" vid="JOB 9:5">na agacingʼaũrania nĩ kũrakara.<verse eid="JOB 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 9:6"/>Athingithagia thĩ ĩkoima handũ hayo,</para>
  <para style="q2" vid="JOB 9:6">na akainainia itugĩ ciayo.<verse eid="JOB 9:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 9:7"/>Aathaga riũa rĩkaaga kũratha;</para>
  <para style="q2" vid="JOB 9:7">nake agiragĩrĩria ũtheri wa njata.<verse eid="JOB 9:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 9:8"/>Nĩwe watambũrũkirie igũrũ arĩ o wiki,</para>
  <para style="q2" vid="JOB 9:8">na athiiaga agĩkinyangaga makũmbĩ ma iria.<verse eid="JOB 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 9:9"/>Nĩwe Mũũmbi wa njata iria ciĩtagwo Nduba, na Karaũ,</para>
  <para style="q2" vid="JOB 9:9">na Kĩrĩmĩra, o na ikundi cia njata cia mwena wa gũthini.<verse eid="JOB 9:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 9:10"/>Nĩekaga magegania matangĩmenyeka,</para>
  <para style="q2" vid="JOB 9:10">na akaringa ciama itangĩtarĩka.<verse eid="JOB 9:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 9:11"/>Rĩrĩa aahĩtũkĩra harĩa ndĩ, ndingĩmuona;</para>
  <para style="q2" vid="JOB 9:11">o na rĩrĩa aathiĩra harĩa ndĩ ndimenyaga.<verse eid="JOB 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 9:12"/>Angĩgutha kĩndũ-rĩ, nũũ ũngĩhota kũmũgiria?</para>
  <para style="q2" vid="JOB 9:12">Nũũ ũngĩmũũria atĩrĩ, ‘Nĩ atĩa ũreka?’<verse eid="JOB 9:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 9:13"/>Ngai ndahingagĩrĩria marakara make;</para>
  <para style="q2" vid="JOB 9:13">o na arĩa maateithagĩrĩria Rahabu nĩmamũinamagĩrĩra.<verse eid="JOB 9:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 9:14"/>“Niĩ-rĩ, ndaakĩhota atĩa kũmũkararia?</para>
  <para style="q2" vid="JOB 9:14">Ingĩruta kũ ciugo cia kũmũcookeria?<verse eid="JOB 9:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 9:15"/>O na korwo ndihĩtĩtie-rĩ, ndingĩhota kũmũcookeria ũndũ;</para>
  <para style="q2" vid="JOB 9:15">ũrĩa ingĩĩka no gũthaitha ingĩthaitha Mũnjiirithia anjiguĩre tha.<verse eid="JOB 9:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 9:16"/>O na ingĩamwĩtire nake anjĩtĩke-rĩ,</para>
  <para style="q2" vid="JOB 9:16">ndingĩĩtĩkia nĩangĩathikĩrĩirie.<verse eid="JOB 9:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 9:17"/>We angĩamemendire na kĩhuhũkanio,</para>
  <para style="q2" vid="JOB 9:17">na aingĩhie ironda ciakwa hatarĩ gĩtũmi.<verse eid="JOB 9:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 9:18"/>Ndarekaga njookererwo nĩ mĩhũmũ,</para>
  <para style="q2" vid="JOB 9:18">no nĩahatagĩrĩria na mathĩĩna.<verse eid="JOB 9:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 9:19"/>Korwo no ũhoro wa hinya-rĩ, we arĩ hinya mũno!</para>
  <para style="q2" vid="JOB 9:19">Na korwo no ũhoro wa ciira wa kĩhooto-rĩ, nũũ ũngĩmwĩta?<verse eid="JOB 9:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 9:20"/>O na korwo ndiahĩtĩtie-rĩ, kanua gakwa no kandue mũhĩtia;</para>
  <para style="q2" vid="JOB 9:20">korwo ndiarĩ na ũcuuke-rĩ, nĩkangĩanduire mũhĩtia.<verse eid="JOB 9:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 9:21"/>“O na gũtuĩka ndirĩ na ũcuuke-rĩ, ndikwĩrĩrĩra;</para>
  <para style="q2" vid="JOB 9:21">muoyo wakwa nĩndĩwagĩire kĩene.<verse eid="JOB 9:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 9:22"/>Ũhoro no ũrĩa ũmwe; nĩkĩo ndĩroiga atĩrĩ,</para>
  <para style="q2" vid="JOB 9:22">‘Aniinaga arĩa matarĩ ũcuuke o na akaniina arĩa aaganu.’<verse eid="JOB 9:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 9:23"/>Hĩndĩ ĩrĩa ihũũra rĩarehe gĩkuũ kĩa narua,</para>
  <para style="q2" vid="JOB 9:23">nĩathekagĩrĩra kũũrwo nĩ hinya kwa arĩa matarĩ na mahĩtia.<verse eid="JOB 9:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 9:24"/>Hĩndĩ ĩrĩa bũrũri wagĩa moko-inĩ ma andũ aaganu,</para>
  <para style="q2" vid="JOB 9:24">nĩahingaga aciirithania maitho.</para>
  <para style="q2" vid="JOB 9:24">Akorwo ti we-rĩ, nũũ wĩkaga ũguo?<verse eid="JOB 9:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 9:25"/>“Matukũ makwa marahanyũka gũkĩra mũkinyia-ũhoro;</para>
  <para style="q2" vid="JOB 9:25">mombũkaga matarĩ na gĩkeno o na kĩnini.<verse eid="JOB 9:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 9:26"/>Mahĩtũkaga na ihenya mũno ta tũtarũ twa irura,<note caller="+" style="f"><char style="fr" closed="false">9:26 </char><char style="ft" closed="false">Tũtarũ tũtaarĩ tũnene twa ithanjĩ twathondekagĩrwo Misiri.</char></note></para>
  <para style="q2" vid="JOB 9:26">kana ta nderi igũcuuhũkĩra kĩndũ gĩa kũrĩa.<verse eid="JOB 9:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 9:27"/>Ingiuga atĩrĩ, ‘Nĩngũriganĩrwo nĩ mateta makwa,</para>
  <para style="q2" vid="JOB 9:27">nĩngũtiga gũtukia gĩthiithi, ngene,’<verse eid="JOB 9:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 9:28"/>no ngeetigĩra mĩnyamaro yakwa yothe,</para>
  <para style="q2" vid="JOB 9:28">nĩgũkorwo nĩnjũũĩ ndũkandua atĩ ndiĩhĩtie.<verse eid="JOB 9:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 9:29"/>Kuona atĩ nĩndĩkĩtie gũtuuo mũhĩtia-rĩ,</para>
  <para style="q2" vid="JOB 9:29">nĩ kĩĩ gĩgũtũma ndĩĩnogie tũhũ?<verse eid="JOB 9:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 9:30"/>O na ingĩĩthamba na thabuni,</para>
  <para style="q2" vid="JOB 9:30">na ndĩĩthambe moko na igata-rĩ,<verse eid="JOB 9:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOB 9:31"/>no ũndikirie irima rĩa gĩcoro</para>
  <para style="q2" vid="JOB 9:31">nĩgeetha o na nguo ciakwa iithũũre.<verse eid="JOB 9:31"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="32" style="v" sid="JOB 9:32"/>“We ti mũndũ ta niĩ atĩ nĩguo ndĩmũcookerie,</para>
  <para style="q2" vid="JOB 9:32">nĩguo tũngʼethanĩre igooti-inĩ.<verse eid="JOB 9:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="JOB 9:33"/>Naarĩ korwo nĩ harĩ mũndũ ũngĩtũiguithania,</para>
  <para style="q2" vid="JOB 9:33">atũigĩrĩre guoko gwake ithuĩ eerĩ,<verse eid="JOB 9:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="JOB 9:34"/>mũndũ wa kũnjehereria rũthanju rwa Ngai,</para>
  <para style="q2" vid="JOB 9:34">nĩgeetha ndigacooke kũmakio nĩ itebeebania rĩake.<verse eid="JOB 9:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="JOB 9:35"/>Hĩndĩ ĩyo nĩingĩacooka kwaragia itekũmwĩtigĩra,</para>
  <para style="q2" vid="JOB 9:35">no ũrĩa ndariĩ rĩu-rĩ, ndingĩhota.<verse eid="JOB 9:35"/></para>
  <para style="b"/>
  <chapter eid="JOB 9"/>
  <chapter number="10" style="c" sid="JOB 10"/>
  <para style="q1">
    <verse number="1" style="v" sid="JOB 10:1"/>“Nĩthũire gũtũũra muoyo ũyũ;</para>
  <para style="q2" vid="JOB 10:1">nĩ ũndũ ũcio ndikũhingĩrĩria mateta makwa,</para>
  <para style="q2" vid="JOB 10:1">o na nĩ ngwaria nĩ ũndũ wa ũrĩa ngoro yakwa ĩrĩ na marũrũ.<verse eid="JOB 10:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 10:2"/>Ngwĩra Ngai atĩrĩ: Tiga kũndua mwĩhia,</para>
  <para style="q2" vid="JOB 10:2">no nyonia kĩrĩa ũrandũithĩria.<verse eid="JOB 10:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 10:3"/>Kaĩ ũkenagio nĩ kũũhinyĩrĩria,</para>
  <para style="q2" vid="JOB 10:3">ũgathũũra wĩra wa moko maku,</para>
  <para style="q2" vid="JOB 10:3">o rĩrĩa ũrakenera mathugunda ma andũ arĩa aaganu?<verse eid="JOB 10:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 10:4"/>Kaĩ maitho maku marĩ o ta maitho ma andũ?</para>
  <para style="q2" vid="JOB 10:4">Kaĩ muonere waku ũhaana o ta wa mũndũ?<verse eid="JOB 10:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 10:5"/>Kaĩ matukũ maku maigana ta ma andũ,</para>
  <para style="q2" vid="JOB 10:5">kana mĩaka yaku ĩkaigana o ta ya mũndũ,<verse eid="JOB 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 10:6"/>nĩguo ũcarĩrĩrie mahĩtia makwa,</para>
  <para style="q2" vid="JOB 10:6">o na ũtuĩragie mehia makwa,<verse eid="JOB 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 10:7"/>o na gũtuĩka wee nĩũũĩ atĩ ndiĩhĩtie,</para>
  <para style="q2" vid="JOB 10:7">na ũkamenya atĩ gũtirĩ mũndũ ũngĩhota kũũhonokia moko-inĩ maku?<verse eid="JOB 10:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 10:8"/>“Moko maku nĩmo maathondekire na makĩnyũmba.</para>
  <para style="q2" vid="JOB 10:8">Rĩu nĩũgũkĩgarũrũka ũnyanange?<verse eid="JOB 10:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 10:9"/>Ririkana atĩ wanyũũmbire ta rĩũmba.</para>
  <para style="q2" vid="JOB 10:9">Rĩu ũgũcooka ũndue rũkũngũ rĩngĩ?<verse eid="JOB 10:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 10:10"/>Githĩ ndwanjitire ta iria,</para>
  <para style="q2" vid="JOB 10:10">na ũgĩcooka ũkĩĩmatia ta maguta marĩo,<verse eid="JOB 10:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 10:11"/>ũkĩĩhumbĩra na nyama na gĩkonde,</para>
  <para style="q2" vid="JOB 10:11">na ũkĩohania mahĩndĩ na mĩkiha yakwa hamwe.<verse eid="JOB 10:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 10:12"/>Nĩwaaheire muoyo o na ũkĩnyonia ũtugi waku;</para>
  <para style="q2" vid="JOB 10:12">naguo ũmenyereri waku nĩguo ũtũirie roho wakwa.<verse eid="JOB 10:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 10:13"/>“No nĩwahithire maũndũ maya ngoro-inĩ yaku,</para>
  <para style="q2" vid="JOB 10:13">na nĩnjũũĩ no warĩ na ũndũ ũyũ meciiria-inĩ maku:<verse eid="JOB 10:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 10:14"/>Ingĩehirie wee nĩwanyonaga,</para>
  <para style="q2" vid="JOB 10:14">na ndũngĩagire kũũherithia nĩ ũndũ wa wĩhia wakwa.<verse eid="JOB 10:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 10:15"/>Kaĩ akorwo nĩnjĩhĩtie ndĩ na haaro-ĩ!</para>
  <para style="q2" vid="JOB 10:15">O na ingĩiguĩka ndiĩkĩte ũũru, ndingĩhota gũtiira mũtwe wakwa,</para>
  <para style="q1" vid="JOB 10:15">nĩgũkorwo njiyũrĩtwo nĩ thoni,</para>
  <para style="q2" vid="JOB 10:15">na ngarikĩra mathĩĩna-inĩ makwa.<verse eid="JOB 10:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 10:16"/>Ingĩtiira mũtwe wakwa-rĩ, wee ũnjeemaga o ta mũrũũthi,</para>
  <para style="q2" vid="JOB 10:16">na ningĩ ũkonania ũhoti waku mũnene wa kũnjũkĩrĩra.<verse eid="JOB 10:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 10:17"/>Nĩũndeheire aira angĩ manjũkĩrĩre,</para>
  <para style="q2" vid="JOB 10:17">na nĩwongereire marakara maku igũrũ rĩakwa;</para>
  <para style="q1" vid="JOB 10:17">mbũtũ ciaku ikanjũkĩrĩra o ta makũmbĩ ma maaĩ marũmanĩrĩire.<verse eid="JOB 10:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 10:18"/>“Nĩ kĩĩ gĩatũmire ũndute nda ya maitũ?</para>
  <para style="q2" vid="JOB 10:18">Naarĩ korwo ndakuire itoneetwo nĩ maitho ma mũndũ o na ũmwe.<verse eid="JOB 10:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 10:19"/>Naarĩ korwo ndiaciarirwo,</para>
  <para style="q2" vid="JOB 10:19">kana korwo ndaciarirwo njerekeirio mbĩrĩra!<verse eid="JOB 10:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 10:20"/>Githĩ matukũ makwa o na marĩ manini matikirie gũthira?</para>
  <para style="q2" vid="JOB 10:20">Tigana na niĩ nĩguo ngĩe na gĩkeno gwa kahinda kanini,<verse eid="JOB 10:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 10:21"/>kamũira thiĩte kũrĩa mũndũ athiiaga na ndacooke,</para>
  <para style="q2" vid="JOB 10:21">bũrũri wa nduma, o nduma nene ya gĩkuũ,<verse eid="JOB 10:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 10:22"/>o bũrũri ũrĩa ũtukũ wakuo ũrĩ mũtumanu mũno,</para>
  <para style="q2" vid="JOB 10:22">bũrũri wa nduma ya gĩkuũ, na ũtarĩ kĩhaarĩro,</para>
  <para style="q2" vid="JOB 10:22">kũrĩa o na ũtheri ũhaana o ta nduma.”<verse eid="JOB 10:22"/></para>
  <chapter eid="JOB 10"/>
  <chapter number="11" style="c" sid="JOB 11"/>
  <para style="s1">Mĩario ya Zofaru</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 11:1"/>Nake Zofaru ũrĩa Mũnaamathi agĩcookia, akĩũria atĩrĩ:<verse eid="JOB 11:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 11:2"/>“Ciugo icio ciothe-rĩ, nĩcikwaga gũcookio?</para>
  <para style="q2" vid="JOB 11:2">Mwaria ũyũ-rĩ, nĩegũgĩtuuo mwagĩrĩru?<verse eid="JOB 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 11:3"/>Mwĩraho ũcio waku-rĩ, nĩguo ũgũkiria andũ naguo?</para>
  <para style="q2" vid="JOB 11:3">No kwage mũndũ ũngĩgũkaania rĩrĩa ũranyũrũrania?<verse eid="JOB 11:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 11:4"/>Wee ũreera Ngai atĩrĩ, ‘Wĩtĩkio wakwa ndũrĩ ũcuuke,</para>
  <para style="q2" vid="JOB 11:4">o na niĩ ndĩ mũtheru maitho-inĩ maku.’<verse eid="JOB 11:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 11:5"/>Naarĩ korwo Ngai no aarie,</para>
  <para style="q2" vid="JOB 11:5">atumũre mĩromo yake agũũkĩrĩre,<verse eid="JOB 11:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 11:6"/>na akũguũrĩrie hitho cia ũũgĩ,</para>
  <para style="q2" vid="JOB 11:6">nĩ ũndũ ũũgĩ ũrĩa wa ma nĩ wa mĩena ĩĩrĩ.</para>
  <para style="q2" vid="JOB 11:6">Menya ũndũ ũyũ; atĩ Ngai ndakũherithĩtie kũringana na ũrĩa mehia maku maigana.<verse eid="JOB 11:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 11:7"/>“Wee no ũhote kũmenya maũndũ marĩa mahithe ma Ngai?</para>
  <para style="q2" vid="JOB 11:7">Kana no ũhote gũtuĩria kũna maũndũ ma Mwene-Hinya-Wothe?<verse eid="JOB 11:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 11:8"/>Maũndũ make nĩmatũũgĩru gũkĩra igũrũ, wee nĩ atĩa ũngĩka?</para>
  <para style="q2" vid="JOB 11:8">Nĩ mariku gũkĩra ũriku wa mbĩrĩra, wee nĩ atĩa ũngĩmenya?<verse eid="JOB 11:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 11:9"/>Gĩthimo kĩamo nĩ kĩraihu gũkĩra thĩ</para>
  <para style="q2" vid="JOB 11:9">na nĩ kĩaramu gũkĩra iria rĩrĩa inene.<verse eid="JOB 11:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 11:10"/>“Angĩũka agũikie njeera-rĩ,</para>
  <para style="q2" vid="JOB 11:10">acooke etane ciira-rĩ, nũũ ũngĩmũgiria?<verse eid="JOB 11:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 11:11"/>Ti-itherũ nĩoĩ andũ arĩa maheenanagia;</para>
  <para style="q2" vid="JOB 11:11">na rĩrĩa oona ũndũ mũũru-rĩ, githĩ ndaũmenyaga?<verse eid="JOB 11:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 11:12"/>No rĩrĩ, mũndũ ũtarĩ ũũgĩ ndangĩtuĩka mũũgĩ o na rĩ,</para>
  <para style="q2" vid="JOB 11:12">o ta ũrĩa njaũ ya ndigiri ya gĩthaka ĩtarĩ hĩndĩ ĩngĩciarwo ĩrĩ mũndũ.<verse eid="JOB 11:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 11:13"/>“No rĩrĩ, ũngĩneana ngoro yaku kũrĩ Ngai,</para>
  <para style="q2" vid="JOB 11:13">na ũtambũrũkie moko maku kũrĩ we,<verse eid="JOB 11:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 11:14"/>ũngĩeheria mehia marĩa marĩ guoko-inĩ gwaku,</para>
  <para style="q2" vid="JOB 11:14">na ũgirie ũũru ũikare thĩinĩ wa hema yaku-rĩ,<verse eid="JOB 11:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 11:15"/>hĩndĩ ĩyo no ũhote gũtiira ũthiũ waku na igũrũ ũtegũconoka;</para>
  <para style="q2" vid="JOB 11:15">no ũrũgame wega ũtarĩ na guoya.<verse eid="JOB 11:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 11:16"/>Ti-itherũ nĩũkariganĩrwo nĩ mathĩĩna maku,</para>
  <para style="q2" vid="JOB 11:16">ũmaririkanage o ta maaĩ marĩkĩtie gũtherera.<verse eid="JOB 11:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 11:17"/>Mũtũũrĩre waku nĩũgacangarara gũkĩra mũthenya barigici,</para>
  <para style="q2" vid="JOB 11:17">nayo nduma ĩgaatuĩka o ta rũciinĩ.<verse eid="JOB 11:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 11:18"/>Ũgũtũũra ũrĩ na mwĩhoko tondũ ũrĩ na ũgitĩri,</para>
  <para style="q2" vid="JOB 11:18">ũkehũgũraga harĩa ũrĩ, na ũkahurũka ũtarĩ na ũgwati.<verse eid="JOB 11:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 11:19"/>Nĩũgakomaga, gũtarĩ na mũndũ ũngĩtũma wĩtigĩre,</para>
  <para style="q2" vid="JOB 11:19">nao andũ aingĩ nĩmakeyendithagia harĩ we.<verse eid="JOB 11:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 11:20"/>No rĩrĩ, maitho ma andũ arĩa aaganu nĩmakaaga kuona,</para>
  <para style="q2" vid="JOB 11:20">na matikoona gwa kũũrĩra;</para>
  <para style="q1" vid="JOB 11:20">naguo ũndũ ũrĩa meriragĩria ũgaatuĩka mũcaayo wa gĩkuũ.”<verse eid="JOB 11:20"/></para>
  <chapter eid="JOB 11"/>
  <chapter number="12" style="c" sid="JOB 12"/>
  <para style="s1">Mĩario ya Ayubu</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 12:1"/>Ningĩ Ayubu agĩcookia atĩrĩ:<verse eid="JOB 12:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 12:2"/>“Hatirĩ nganja inyuĩ nĩ inyuĩ andũ,</para>
  <para style="q2" vid="JOB 12:2">naguo ũũgĩ ũgaathiranĩra na inyuĩ rĩrĩa mũgaakua!<verse eid="JOB 12:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 12:3"/>No rĩrĩ, ndĩ na ũmenyo o ta inyuĩ;</para>
  <para style="q2" vid="JOB 12:3">mũtirĩ oogĩ kũngĩra.</para>
  <para style="q2" vid="JOB 12:3">Nũũ ũtooĩ maũndũ macio mothe?<verse eid="JOB 12:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 12:4"/>“Nduĩkĩte mũndũ wa gũthekererwo nĩ arata akwa,</para>
  <para style="q2" vid="JOB 12:4">o na gũtuĩka nĩndakaĩire Ngai nake akĩnjigua:</para>
  <para style="q2" vid="JOB 12:4">niĩ nduĩkĩte mũndũ wa gũthekererwo,</para>
  <para style="q2" vid="JOB 12:4">o na gũtuĩka ndĩ mũthingu na ndirĩ ũcuuke!<verse eid="JOB 12:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 12:5"/>Andũ arĩa maikaraga megangarĩte manyũrũragia mũtino,</para>
  <para style="q2" vid="JOB 12:5">makona ta ũndũ ũcio ũkoraga o andũ arĩa magũrũ mao matenderũkaga.<verse eid="JOB 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 12:6"/>Hema cia atunyani nĩcio ciikaraga igaacĩire,</para>
  <para style="q2" vid="JOB 12:6">na andũ arĩa marakaragia Mũrungu nĩo maikaraga na thayũ,</para>
  <para style="q2" vid="JOB 12:6">o acio makuuaga ngai yao na moko.<verse eid="JOB 12:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 12:7"/>“No ta kĩũrie nyamũ, na nĩigũkũruta ũhoro,</para>
  <para style="q2" vid="JOB 12:7">kana ũrie nyoni cia rĩera-inĩ, na nĩigũkwĩra;<verse eid="JOB 12:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 12:8"/>kana warĩrie thĩ, na nĩĩgũkũruta ũhoro,</para>
  <para style="q2" vid="JOB 12:8">kana ũkĩarĩrie thamaki cia iria-inĩ, nacio nĩigũkũhe ũhoro.<verse eid="JOB 12:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 12:9"/>Nĩ irĩkũ cia icio ciothe itooĩ</para>
  <para style="q2" vid="JOB 12:9">atĩ nĩ guoko kwa Jehova gwĩkĩte ũndũ ũyũ?<verse eid="JOB 12:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 12:10"/>Mĩoyo ya ciũmbe ciothe ĩrĩ guoko-inĩ gwake,</para>
  <para style="q2" vid="JOB 12:10">o na mĩhũmũ ya andũ othe.<verse eid="JOB 12:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 12:11"/>Githĩ gũtũ gũtithuuranagia ciugo</para>
  <para style="q2" vid="JOB 12:11">o ta ũrĩa rũrĩmĩ rũcamaga irio?<verse eid="JOB 12:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 12:12"/>Githĩ ũũgĩ ndũkoragwo na andũ arĩa akũrũ?</para>
  <para style="q2" vid="JOB 12:12">Githĩ gũtũũra mũno gũtirehaga ũmenyo?<verse eid="JOB 12:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 12:13"/>“Ũũgĩ na hinya nĩ cia Ngai;</para>
  <para style="q2" vid="JOB 12:13">mataaro na ũmenyo nĩ ciake.<verse eid="JOB 12:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 12:14"/>Kĩrĩa amomoraga gĩtingĩakwo rĩngĩ;</para>
  <para style="q2" vid="JOB 12:14">mũndũ ũrĩa aahingĩra njeera gũtirĩ mũndũ ũngĩmuohora.<verse eid="JOB 12:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 12:15"/>Ahingagĩrĩria maaĩ, gũkaaga mbura;</para>
  <para style="q2" vid="JOB 12:15">ningĩ aamarekereria makaananga bũrũri.<verse eid="JOB 12:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 12:16"/>Hinya na ũtooria nĩ ciake;</para>
  <para style="q2" vid="JOB 12:16">mũheenio na mũheenania eerĩ no ake.<verse eid="JOB 12:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 12:17"/>Aheani kĩrĩra amatongoragia matarĩ nguo,</para>
  <para style="q2" vid="JOB 12:17">na agatua aciirithania irimũ.<verse eid="JOB 12:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 12:18"/>Nĩohoraga mĩnyororo ĩrĩa athamaki moohaga andũ nayo,</para>
  <para style="q2" vid="JOB 12:18">akamooha mũcibi njohero.<note caller="+" style="f"><char style="fr" closed="false">12:18 </char><char style="ft" closed="false">Nguo cia kuohera njohero ihumbĩre thoni no cio ngombo cietĩkĩrĩtio kwĩhumba.</char></note><verse eid="JOB 12:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 12:19"/>Athĩnjĩri-Ngai amatongoragia marutĩtwo nguo,</para>
  <para style="q2" vid="JOB 12:19">na akangʼaũrania andũ arĩa mehaandire tene.<verse eid="JOB 12:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 12:20"/>Nĩakiragia mĩromo ya aheani kĩrĩra arĩa meehoketwo,</para>
  <para style="q2" vid="JOB 12:20">nao athuuri akamatunya ũhoro wa gũkũũrana maũndũ.<verse eid="JOB 12:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 12:21"/>We nĩagagĩra arĩa atĩĩku bata,</para>
  <para style="q2" vid="JOB 12:21">nao arĩa marĩ na hinya nĩamatunyaga indo ciao cia mbaara.<verse eid="JOB 12:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 12:22"/>Nĩaguũragia maũndũ marĩa mariku ma nduma,</para>
  <para style="q2" vid="JOB 12:22">na nduma nene ya gĩkuũ akamiumĩria ũtheri-inĩ.<verse eid="JOB 12:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 12:23"/>Anenehagia ndũrĩrĩ, agacooka agaciananga;</para>
  <para style="q2" vid="JOB 12:23">aingĩhagia ndũrĩrĩ, agacooka agacihurunja.<verse eid="JOB 12:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 12:24"/>Nĩagaagagia meciiria ma atongoria a gũkũ thĩ;</para>
  <para style="q2" vid="JOB 12:24">akamaingata, morũũrage werũ-inĩ mũtheri ũtarĩ njĩra.<verse eid="JOB 12:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 12:25"/>Mahambaataga nduma-inĩ kũrĩa gũtarĩ ũtheri;</para>
  <para style="q2" vid="JOB 12:25">ningĩ atũmaga matũgũũge ta mũndũ mũrĩĩu.<verse eid="JOB 12:25"/></para>
  <para style="b"/>
  <chapter eid="JOB 12"/>
  <chapter number="13" style="c" sid="JOB 13"/>
  <para style="q1">
    <verse number="1" style="v" sid="JOB 13:1"/>“Atĩrĩrĩ, maitho makwa nĩmonete maũndũ macio mothe,</para>
  <para style="q2" vid="JOB 13:1">matũ makwa nĩmamaiguĩte na magataũkĩrwo nĩmo.<verse eid="JOB 13:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 13:2"/>Ũrĩa mũũĩ o na niĩ nĩnjũũĩ;</para>
  <para style="q2" vid="JOB 13:2">mũtirĩ oogĩ kũngĩra.<verse eid="JOB 13:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 13:3"/>No niĩ ndĩrenda kwaria na Mwene-Hinya-Wothe,</para>
  <para style="q2" vid="JOB 13:3">na ngerirĩria gũciira na Mũrungu.<verse eid="JOB 13:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 13:4"/>No inyuĩ-rĩ, mũranjigĩrĩra ndeto cia maheeni;</para>
  <para style="q2" vid="JOB 13:4">inyuothe mũrĩ athondekani a tũhũ!<verse eid="JOB 13:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 13:5"/>Naarĩ korwo mwakira ki!</para>
  <para style="q2" vid="JOB 13:5">Ũndũ ũcio ũngĩtuĩka ũũgĩ harĩ inyuĩ.<verse eid="JOB 13:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 13:6"/>Na rĩrĩ, thikĩrĩriai kĩhooto gĩakwa;</para>
  <para style="q2" vid="JOB 13:6">iguai gũthaithana kwa mĩromo yakwa.<verse eid="JOB 13:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 13:7"/>Kaĩ mũngĩaria ũũru mũkĩarĩrĩria Mũrungu?</para>
  <para style="q2" vid="JOB 13:7">Kaĩ mũngĩaria maheeni igũrũ rĩake?<verse eid="JOB 13:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 13:8"/>Kaĩ mũngĩmuonia kĩmenyano?</para>
  <para style="q2" vid="JOB 13:8">Kaĩ mũgũciirĩrĩra Mũrungu?<verse eid="JOB 13:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 13:9"/>Angĩmũtuĩria inyuĩ-rĩ, ũndũ ũcio no ũtuĩke mwega?</para>
  <para style="q2" vid="JOB 13:9">No mũmũheenie ta ũrĩa mũngĩheenia mũndũ?<verse eid="JOB 13:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 13:10"/>Ti-itherũ no amũrũithie</para>
  <para style="q2" vid="JOB 13:10">mũngĩtuĩka a kuonania kĩmenyano na hitho.<verse eid="JOB 13:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 13:11"/>Hĩ, riiri wake ndũngĩmũmakia?</para>
  <para style="q2" vid="JOB 13:11">Mũtingĩnyiitwo nĩ guoya nĩ ũndũ wake?<verse eid="JOB 13:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 13:12"/>Mĩario yanyu ya ũũgĩ nĩ thimo hũthũ o ta mũhu;</para>
  <para style="q2" vid="JOB 13:12">ihooto cianyu no ta kwĩgitĩra na rĩũmba.<verse eid="JOB 13:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 13:13"/>“Kirai ki, mũreke njarie;</para>
  <para style="q2" vid="JOB 13:13">o ũrĩa ndĩrĩona-rĩ, rekei nyone.<verse eid="JOB 13:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 13:14"/>Nĩ kĩĩ gĩgũtũma ndĩtoonyie ũgwati-inĩ</para>
  <para style="q2" vid="JOB 13:14">na ngaiga muoyo wakwa moko-inĩ makwa?<verse eid="JOB 13:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 13:15"/>O na angĩnjũraga-rĩ, niĩ nowe ndĩrĩĩhokaga;</para>
  <para style="q2" vid="JOB 13:15">na ti-itherũ nĩ ngatetera mĩthiĩre yakwa hau mbere yake.<verse eid="JOB 13:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 13:16"/>Ti-itherũ, ũndũ ũyũ noguo ũgaatuĩka wa kũũhonokia,</para>
  <para style="q2" vid="JOB 13:16">nĩgũkorwo mũndũ ũtooĩ Ngai ndangĩũmĩrĩria gũũka mbere yake!<verse eid="JOB 13:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 13:17"/>Thikĩrĩriai wega ũhoro wakwa;</para>
  <para style="q2" vid="JOB 13:17">matũ manyu nĩmakĩigue ũrĩa nguuga.<verse eid="JOB 13:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 13:18"/>Ti-itherũ nĩhaarĩirie ciira wakwa,</para>
  <para style="q2" vid="JOB 13:18">na nĩnjũũĩ nĩ nguoneka ndĩ wa kĩhooto.<verse eid="JOB 13:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 13:19"/>Nĩ kũrĩ mũndũ ũngĩhota gũũthitanga?</para>
  <para style="q2" vid="JOB 13:19">Angĩkorwo nĩ kũrĩ-rĩ, no gũkira ngũkira ngue.<verse eid="JOB 13:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 13:20"/>“Wee Ngai, ta kĩĩhe o maũndũ maya meerĩ,</para>
  <para style="q2" vid="JOB 13:20">na ndigũcooka gũkwĩhitha:<verse eid="JOB 13:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 13:21"/>Atĩrĩ, eheria guoko gwaku, gũikare kũraya na niĩ,</para>
  <para style="q2" vid="JOB 13:21">na ũtige kũũmakia na imakania ciaku.<verse eid="JOB 13:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 13:22"/>Ningĩ ũnjĩte na nĩngwĩtĩka,</para>
  <para style="q2" vid="JOB 13:22">kana ũkĩreke njarie, nawe ũnjookerie.<verse eid="JOB 13:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 13:23"/>Nĩ mahĩtia na mehia maigana niĩ njĩkĩte?</para>
  <para style="q2" vid="JOB 13:23">Nyonia ihĩtia na rĩĩhia rĩakwa.<verse eid="JOB 13:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 13:24"/>Ũraahitha ũthiũ waku nĩkĩ,</para>
  <para style="q2" vid="JOB 13:24">na ũkandua thũ yaku?<verse eid="JOB 13:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 13:25"/>Nĩũngĩnyamaria ithangũ rĩrahurutwo nĩ rũhuho?</para>
  <para style="q2" vid="JOB 13:25">Nĩũgũtengʼerania na maragara momũ?<verse eid="JOB 13:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 13:26"/>Nĩgũkorwo nĩ wandĩkĩte maũndũ marũrũ ma kũnjũkĩrĩra,</para>
  <para style="q2" vid="JOB 13:26">na ũkaangaĩra igai rĩa mehia ma ũnini wakwa.<verse eid="JOB 13:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 13:27"/>Wohaga magũrũ makwa na mĩnyororo;</para>
  <para style="q2" vid="JOB 13:27">ũrangagĩra njĩra ciakwa ciothe</para>
  <para style="q2" vid="JOB 13:27">na ũndũ wa gũcora njoro makinya ma magũrũ makwa.<verse eid="JOB 13:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 13:28"/>“Nĩ ũndũ ũcio mũndũ amocaga ta kĩndũ kĩbuthĩte,</para>
  <para style="q2" vid="JOB 13:28">agathira ta nguo ĩrĩĩtwo nĩ memenyi.<verse eid="JOB 13:28"/></para>
  <para style="b"/>
  <chapter eid="JOB 13"/>
  <chapter number="14" style="c" sid="JOB 14"/>
  <para style="q1">
    <verse number="1" style="v" sid="JOB 14:1"/>“Mũndũ ũciarĩtwo nĩ mũndũ-wa-nja-rĩ,</para>
  <para style="q2" vid="JOB 14:1">aikaraga o matukũ manini, namo makaiyũrwo nĩ mathĩĩna.<verse eid="JOB 14:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 14:2"/>Akũraga ta ihũa na agacooka akooma;</para>
  <para style="q2" vid="JOB 14:2">ahĩtũkaga na ihenya ta kĩĩruru, na ndatũũraga.<verse eid="JOB 14:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 14:3"/>Mũndũ ta ũcio wakĩmũkũũrĩra maitho?</para>
  <para style="q2" vid="JOB 14:3">Mũndũ ta ũcio wamũrehe mbere yaku aciirithio?<verse eid="JOB 14:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 14:4"/>Nũũ ũngĩhota kũruta kĩndũ gĩtheru kuuma harĩ kĩndũ kĩrĩa gĩtarĩ gĩtheru?</para>
  <para style="q2" vid="JOB 14:4">Gũtirĩ o na ũmwe!<verse eid="JOB 14:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 14:5"/>Matukũ ma mũndũ nĩ matare;</para>
  <para style="q2" vid="JOB 14:5">nĩũtuĩte mũigana wa mĩeri yake,</para>
  <para style="q2" vid="JOB 14:5">na nĩũmũigĩire mĩhaka ĩrĩa ataangĩkĩra.<verse eid="JOB 14:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 14:6"/>Nĩ ũndũ ũcio tiga kũmũrora, tigana nake,</para>
  <para style="q2" vid="JOB 14:6">nginya arĩĩkie mĩthenya yake ta mũthũkũmi.<verse eid="JOB 14:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 14:7"/>“Mũtĩ-rĩ, nĩwĩrĩgagĩrĩrwo atĩ ũngĩtemwo,</para>
  <para style="q2" vid="JOB 14:7">no ũthethũke rĩngĩ,</para>
  <para style="q2" vid="JOB 14:7">na atĩ mathethũka maguo matikaaga.<verse eid="JOB 14:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 14:8"/>O na mĩri yaguo ĩngĩkũrĩra thĩ</para>
  <para style="q2" vid="JOB 14:8">na gĩthukĩ kĩaguo kĩũmĩre tĩĩri-inĩ,<verse eid="JOB 14:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 14:9"/>ũngĩkaguucia maaĩ-rĩ, nĩũgathethũka</para>
  <para style="q2" vid="JOB 14:9">na ũrute honge ta mũtĩ wa kũhaandwo.<verse eid="JOB 14:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 14:10"/>No mũndũ akuuaga agathikwo;</para>
  <para style="q2" vid="JOB 14:10">aatuĩkana-rĩ, ndacookaga kuonwo rĩngĩ.<verse eid="JOB 14:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 14:11"/>O ta ũrĩa maaĩ mahũũaga kũu iria-inĩ,</para>
  <para style="q2" vid="JOB 14:11">na ta ũrĩa mũtaro wa rũũĩ ũngʼaraga ũkooma-rĩ,<verse eid="JOB 14:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 14:12"/>ũguo noguo mũndũ akomaga na ndacookaga gũũkĩra rĩngĩ;</para>
  <para style="q2" vid="JOB 14:12">o nginya rĩrĩa igũrũ rĩgaathira-rĩ,</para>
  <para style="q2" vid="JOB 14:12">andũ matirĩ hĩndĩ magookĩra kana maarahũrwo mookĩre.<verse eid="JOB 14:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 14:13"/>“Naarĩ korwo wahitha thĩinĩ wa mbĩrĩra,</para>
  <para style="q2" vid="JOB 14:13">na ũnjige hitho-inĩ nginya rĩrĩa marakara maku magaathira!</para>
  <para style="q1" vid="JOB 14:13">Naarĩ korwo wanduĩra gĩathĩ,</para>
  <para style="q2" vid="JOB 14:13">ũgaacooka kũndirikana hĩndĩ ĩyo.<verse eid="JOB 14:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 14:14"/>Mũndũ akua-rĩ, nĩagatũũra muoyo rĩngĩ?</para>
  <para style="q2" vid="JOB 14:14">Matukũ makwa mothe ma wĩra mũritũ-rĩ,</para>
  <para style="q2" vid="JOB 14:14">ngweterera ihinda rĩakwa rĩa kwerũhĩrio hinya rĩkinye.<verse eid="JOB 14:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 14:15"/>Wee ũgetana, na niĩ nĩngagwĩtĩka;</para>
  <para style="q2" vid="JOB 14:15">na nĩũkeerirĩria kĩũmbe gĩkĩ wombire na moko maku.<verse eid="JOB 14:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 14:16"/>Hĩndĩ ĩyo nĩũgatara makinya makwa,</para>
  <para style="q2" vid="JOB 14:16">no ndũkarũmbũiya mehia makwa.<verse eid="JOB 14:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 14:17"/>Mahĩtia makwa meekĩrĩtwo mondo-inĩ,</para>
  <para style="q2" vid="JOB 14:17">ĩkoohwo na ĩkahũũrwo mũhũũri; nĩũkahumbĩra mehia makwa.<verse eid="JOB 14:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 14:18"/>“No rĩrĩ, o ta ũrĩa kĩrĩma kĩenjekaga na gĩkamomoka,</para>
  <para style="q2" vid="JOB 14:18">na o ta ũrĩa rwaro rwa ihiga rũeheragio handũ ha ruo,<verse eid="JOB 14:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 14:19"/>na o ta ũrĩa maaĩ mamuthũraga mahiga,</para>
  <para style="q2" vid="JOB 14:19">na o ta ũrĩa mbura nene ĩtwaraga tĩĩri-rĩ,</para>
  <para style="q2" vid="JOB 14:19">ũguo noguo wanangaga kĩĩrĩgĩrĩro kĩa mũndũ.<verse eid="JOB 14:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 14:20"/>Wee ũmũtooragia o rĩmwe rĩa kũigana, nake agathira;</para>
  <para style="q2" vid="JOB 14:20">ũgarũraga gĩthiithi gĩake ũrĩa kĩhaana, na ũkamũingata.<verse eid="JOB 14:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 14:21"/>Ariũ ake mangĩheo gĩtĩĩo, ndangĩmenya ũhoro ũcio;</para>
  <para style="q2" vid="JOB 14:21">mangĩconorithio, we ndoonaga ũndũ ũcio.<verse eid="JOB 14:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 14:22"/>We no ruo rwa mwĩrĩ wake aiguaga,</para>
  <para style="q2" vid="JOB 14:22">nake atũũraga o ecaayagĩra.”<verse eid="JOB 14:22"/></para>
  <chapter eid="JOB 14"/>
  <chapter number="15" style="c" sid="JOB 15"/>
  <para style="s1">Mĩario ya Elifazu</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 15:1"/>Nake Elifazu ũrĩa Mũtemaani akĩũria atĩrĩ:<verse eid="JOB 15:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 15:2"/>“Mũndũ mũũgĩ no acookie ũhoro na kwĩgereria,</para>
  <para style="q2" vid="JOB 15:2">kana aiyũrie nda yake na rũhuho ruumĩte na irathĩro?<verse eid="JOB 15:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 15:3"/>No eciirĩrĩre na ciugo cia tũhũ,</para>
  <para style="q2" vid="JOB 15:3">kana na mĩario ĩtarĩ bata?<verse eid="JOB 15:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 15:4"/>No wee-rĩ, nĩũracambia ũhoro wa gwĩtigĩra Ngai,</para>
  <para style="q2" vid="JOB 15:4">na ũkagirĩrĩria ũhoro wa andũ kwĩrutĩra Mũrungu.<verse eid="JOB 15:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 15:5"/>Mehia maku nĩmo mataaraga kanua gaku;</para>
  <para style="q2" vid="JOB 15:5">nawe ũthuurĩte kwaria na rũrĩmĩ rwa mũndũ mwara.<verse eid="JOB 15:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 15:6"/>Kanua gaku wee mwene nĩko karagũtuĩra ciira, ti gakwa:</para>
  <para style="q2" vid="JOB 15:6">nayo mĩromo yaku wee mwene ĩkaaria ũira wa gũgũũkĩrĩra.<verse eid="JOB 15:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 15:7"/>“Wee nĩwe mũndũ wa mbere gũciarwo?</para>
  <para style="q2" vid="JOB 15:7">Wee-rĩ, waciarirwo mbere ya irĩma igĩe ho?<verse eid="JOB 15:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 15:8"/>Wee nĩũthikagĩrĩria ndundu ya Ngai?</para>
  <para style="q2" vid="JOB 15:8">Wee wiki-rĩ, nowe ũrigĩtie na ũũgĩ?<verse eid="JOB 15:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 15:9"/>Nĩ atĩa ũũĩ ithuĩ tũtooĩ?</para>
  <para style="q2" vid="JOB 15:9">Nĩ ũmenyo ũrĩkũ ũrĩ naguo ithuĩ tũtarĩ?<verse eid="JOB 15:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 15:10"/>Tũrĩ na athuuri marĩ na mbuĩ na arĩa akũrũ mũno,</para>
  <para style="q2" vid="JOB 15:10">andũ akũrũ o na gũkĩra thoguo.<verse eid="JOB 15:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 15:11"/>Ndũiganĩtwo nĩ ũhoorerania wa Mũrungu,</para>
  <para style="q2" vid="JOB 15:11">o na kana ũhoro ũcio warĩirio na ũhooreri?<verse eid="JOB 15:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 15:12"/>Ngoro yaku ĩgũteete nĩkĩ,</para>
  <para style="q2" vid="JOB 15:12">na nĩ kĩĩ kĩratũma ũikare ũkiunaga maitho,<verse eid="JOB 15:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 15:13"/>nĩguo werekerie marakara maku kũrĩ Mũrungu,</para>
  <para style="q2" vid="JOB 15:13">o na ũgaitũrũra ciugo ta icio kuuma kanua gaku?<verse eid="JOB 15:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 15:14"/>“Mũndũ akĩrĩ kĩ, atĩ no ahote gũtuĩka mũtheru,</para>
  <para style="q2" vid="JOB 15:14">o na mũndũ ũciarĩtwo nĩ mũndũ-wa-nja nake akĩrĩ kĩĩ,</para>
  <para style="q2" vid="JOB 15:14">atĩ no ahote gũtuĩka mũthingu?<verse eid="JOB 15:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 15:15"/>Angĩkorwo Ngai ndangĩhota kwĩhoka andũ arĩa ake aamũre-rĩ,</para>
  <para style="q2" vid="JOB 15:15">na kũngĩkorwo o na igũrũ ti gũtheru maitho-inĩ make-rĩ,<verse eid="JOB 15:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 15:16"/>mũndũ akĩrĩ kĩ atĩ amwĩhoke?</para>
  <para style="q2" vid="JOB 15:16">Mũndũ nĩ mwaganu na nĩ kĩmaramari, anyuuaga waganu ta maaĩ!<verse eid="JOB 15:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 15:17"/>“Wee ta thikĩrĩria na nĩngũgũtaarĩria;</para>
  <para style="q2" vid="JOB 15:17">reke ngwĩre ũrĩa nyonete,<verse eid="JOB 15:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 15:18"/>ngwĩre ũrĩa andũ arĩa oogĩ moigĩte,</para>
  <para style="q2" vid="JOB 15:18">matekũhitha ũndũ o na ũmwe wa ũhoro ũrĩa maaheirwo nĩ maithe mao,<verse eid="JOB 15:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 15:19"/>(o acio oiki maaheetwo bũrũri</para>
  <para style="q2" vid="JOB 15:19">hĩndĩ ĩrĩa gũtaarĩ mũndũ wa kũngĩ watuĩkanagia gatagatĩ-inĩ kao):<verse eid="JOB 15:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 15:20"/>Atĩrĩ, mũndũ mwaganu akoragwo na mĩnyamaro matukũ make mothe.</para>
  <para style="q2" vid="JOB 15:20">Matukũ mothe ma ũcio ũtarĩ tha-rĩ, maigĩirwo o mĩnyamaro.<verse eid="JOB 15:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 15:21"/>Aiguaga o mĩgambo ya kũmakania mũno;</para>
  <para style="q2" vid="JOB 15:21">hĩndĩ ĩrĩa maũndũ mothe moneka ta marĩ mega-rĩ,</para>
  <para style="q2" vid="JOB 15:21">atunyani makamũtharĩkĩra.<verse eid="JOB 15:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 15:22"/>Ndarĩ na kĩĩrĩgĩrĩro gĩa gwĩthara kuuma nduma-inĩ;</para>
  <para style="q2" vid="JOB 15:22">etereirio kũũragwo na rũhiũ rwa njora.<verse eid="JOB 15:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 15:23"/>Orũũraga agĩcaragia irio, oragie atĩrĩ, ‘Irĩ na kũ?’</para>
  <para style="q2" vid="JOB 15:23">Aikaraga amenyete atĩ mũthenya wa nduma ũrĩ o hakuhĩ.<verse eid="JOB 15:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 15:24"/>Mĩnyamaro na ruo rwa ngoro nĩcio imũmakagia;</para>
  <para style="q2" vid="JOB 15:24">imũtooragia taarĩ mũthamaki wĩhaarĩirie kũmũtharĩkĩra,<verse eid="JOB 15:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 15:25"/>nĩ ũndũ ainainagĩria Mũrungu ngundi,</para>
  <para style="q2" vid="JOB 15:25">na akangʼathĩria Mwene-Hinya-Wothe,<verse eid="JOB 15:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 15:26"/>akamũguthũkĩra angʼathĩtie,</para>
  <para style="q2" vid="JOB 15:26">arĩ na ngo yake mata ya hinya.<verse eid="JOB 15:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 15:27"/>“O na gũtuĩka ũthiũ wake nĩ mũnoru,</para>
  <para style="q2" vid="JOB 15:27">na njohero yake ĩkaneneha nĩ kũnora-rĩ,<verse eid="JOB 15:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 15:28"/>agaatũũraga matũũra maanangĩku,</para>
  <para style="q2" vid="JOB 15:28">na aikarage nyũmba itatũũragwo nĩ mũndũ,</para>
  <para style="q2" vid="JOB 15:28">nyũmba itigairie o kũmomoka ituĩke ihumbu cia mahiga.<verse eid="JOB 15:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 15:29"/>Ndagacooka gũkorwo arĩ mũtongu, naguo ũtonga wake ndũgatũũra,</para>
  <para style="q2" vid="JOB 15:29">o na kana indo ciake itheereme kũu bũrũri-inĩ.<verse eid="JOB 15:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 15:30"/>Ndakahota kũũrĩra nduma;</para>
  <para style="q2" vid="JOB 15:30">rũrĩrĩmbĩ nĩrũkahoohia thuuna ciake,</para>
  <para style="q2" vid="JOB 15:30">nayo mĩhũmũ ya kanua ka Ngai nĩĩkamweheria.<verse eid="JOB 15:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOB 15:31"/>Nĩatige kwĩheenia na ũndũ wa kwĩhoka maũndũ ma tũhũ,</para>
  <para style="q2" vid="JOB 15:31">nĩgũkorwo gũtirĩ kĩndũ makaamũrehere.<verse eid="JOB 15:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOB 15:32"/>Ihinda rĩake rĩtanakinya-rĩ, nĩakarĩhio mũigana wake wothe,</para>
  <para style="q2" vid="JOB 15:32">na honge ciake itikarura.<verse eid="JOB 15:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="JOB 15:33"/>Agaatuĩka ta mũthabibũ ũhũrũrĩtwo thabibũ ciaguo itarĩ njĩru,</para>
  <para style="q2" vid="JOB 15:33">ahaane ta mũtamaiyũ ũraita kĩro kĩaguo.<verse eid="JOB 15:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="JOB 15:34"/>Nĩgũkorwo andũ a thiritũ ya arĩa matooĩ Ngai matũũraga marĩ thaata,</para>
  <para style="q2" vid="JOB 15:34">na mwaki nĩũgaacina hema cia arĩa mendete mahaki.<verse eid="JOB 15:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="JOB 15:35"/>Magĩaga nda cia mathĩĩna, na magaciara waganu;</para>
  <para style="q2" vid="JOB 15:35">nda ciao ithugundaga o maheeni.”<verse eid="JOB 15:35"/></para>
  <chapter eid="JOB 15"/>
  <chapter number="16" style="c" sid="JOB 16"/>
  <para style="s1">Mĩario ya Ayubu</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 16:1"/>Ningĩ Ayubu agĩcookia atĩrĩ:<verse eid="JOB 16:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 16:2"/>“Nĩnjiguĩte maũndũ maingĩ ta macio;</para>
  <para style="q2" vid="JOB 16:2">inyuothe mũrĩ ahoorerania a kũnyamarania!<verse eid="JOB 16:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 16:3"/>Mĩario ĩyo yanyu mĩingĩ ya mũhũhũtĩko-rĩ, ndĩrĩĩthira?</para>
  <para style="q2" vid="JOB 16:3">Nĩ kĩĩ kĩramũthĩĩnia, gĩgatũma mũtinde mũgĩkararania?<verse eid="JOB 16:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 16:4"/>O na niĩ no njarie ta inyuĩ, korwo nĩ inyuĩ mũrĩ harĩa ndĩ;</para>
  <para style="q2" vid="JOB 16:4">niĩ no njarie mĩario mĩega ya kũmũciirithia na ndĩmũinainĩrie mũtwe.<note caller="+" style="f"><char style="fr" closed="false">16:4 </char><char style="ft" closed="false">Kũinainĩria mũndũ mũtwe kuonanagia kũnyarara mũndũ ũcio, na kũu kwarĩ kũmũruma.</char></note><verse eid="JOB 16:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 16:5"/>No rĩrĩ, kanua gakwa no kamũũmĩrĩrie;</para>
  <para style="q2" vid="JOB 16:5">ũhoorerania uumĩte mĩromo-inĩ yakwa no ũmũhoorerie.<verse eid="JOB 16:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 16:6"/>“No o na ndaaria-rĩ, ruo rwakwa rũtirathira;</para>
  <para style="q2" vid="JOB 16:6">o na ndegirĩrĩria kwaria-rĩ, rũtiranjeherera.<verse eid="JOB 16:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 16:7"/>Ti-itherũ, Wee Ngai nĩũũnogeetie;</para>
  <para style="q2" vid="JOB 16:7">nĩũharaganĩtie nyũmba yakwa yothe.<verse eid="JOB 16:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 16:8"/>Wee nĩũnjoheete, naguo ũndũ ũcio ũgatuĩka ũira;</para>
  <para style="q2" vid="JOB 16:8">ũhĩnju ũyũ ndĩ naguo nĩwambararĩte ũkaanyumbũra ũrĩa ndariĩ.<verse eid="JOB 16:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 16:9"/>Ngai nĩandooretie na akandembũranga nĩ ũrĩa arakarĩte,</para>
  <para style="q2" vid="JOB 16:9">akaahagaranĩria magego;</para>
  <para style="q2" vid="JOB 16:9">ũcio thũ yakwa nĩangũũrĩire maitho.<verse eid="JOB 16:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 16:10"/>Andũ nĩmathamĩtie tũnua twao maathekerere;</para>
  <para style="q2" vid="JOB 16:10">mangũthaga rũthĩa makĩĩnyũrũragia,</para>
  <para style="q2" vid="JOB 16:10">na makanyiitana hamwe manjũkĩrĩre.<verse eid="JOB 16:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 16:11"/>Mũrungu nĩandekereirie kũrĩ andũ arĩa ooru,</para>
  <para style="q2" vid="JOB 16:11">na akanjikia mĩtego-inĩ ya arĩa aaganu.<verse eid="JOB 16:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 16:12"/>Niĩ ndaikarĩte wega, nowe agĩĩthethera;</para>
  <para style="q2" vid="JOB 16:12">aanyiitire mũmero, akĩĩhehenja.</para>
  <para style="q1" vid="JOB 16:12">We anduĩte cabaa wake wa kũrathagwo;<verse eid="JOB 16:12"/></para>
  <para style="q2">
    <verse number="13" style="v" sid="JOB 16:13"/>aikia a mĩguĩ ake nĩmandigiicĩirie.</para>
  <para style="q1" vid="JOB 16:13">Aratheeca higo ciakwa atarĩ na tha,</para>
  <para style="q2" vid="JOB 16:13">na agaita maaĩ makwa ma nyongo thĩ.<verse eid="JOB 16:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 16:14"/>Aatharĩkagĩra maita maingĩ maingĩ;</para>
  <para style="q2" vid="JOB 16:14">anguthũkagĩra ta njamba ya ita.<verse eid="JOB 16:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 16:15"/>“Ndumĩire gĩkonde gĩakwa kĩa mwĩrĩ nguo ya ikũnia,</para>
  <para style="q2" vid="JOB 16:15">na ngahitha thiithi wakwa rũkũngũ-inĩ.<verse eid="JOB 16:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 16:16"/>Ũthiũ wakwa nĩũtunĩhĩte nĩkũrĩra,</para>
  <para style="q2" vid="JOB 16:16">nduma nene ĩgakĩhumbĩra maitho makwa;<verse eid="JOB 16:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 16:17"/>no rĩrĩ, moko makwa matirĩ ũndũ wa ũhinya mekĩte</para>
  <para style="q2" vid="JOB 16:17">namo mahooya makwa nĩ matheru.<verse eid="JOB 16:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 16:18"/>“Wee thĩ-rĩ, ndũkahumbĩre thakame yakwa;</para>
  <para style="q2" vid="JOB 16:18">kĩrĩro gĩakwa kĩroaga gũkaahuurũkio!<verse eid="JOB 16:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 16:19"/>O na rĩu-rĩ, mũira wakwa arĩ igũrũ;</para>
  <para style="q2" vid="JOB 16:19">ũcio mũnjiirĩrĩri arĩ o igũrũ.<verse eid="JOB 16:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 16:20"/>Mũũthaithanĩrĩri nĩ mũrata wakwa</para>
  <para style="q2" vid="JOB 16:20">rĩrĩa maitho makwa maraita maithori harĩ Ngai;<verse eid="JOB 16:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 16:21"/>nĩathaithanagĩrĩra mũndũ kũrĩ Ngai,</para>
  <para style="q2" vid="JOB 16:21">o ta ũrĩa mũndũ athaithanagĩrĩra mũratawe.<verse eid="JOB 16:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 16:22"/>“No mĩaka mĩnini ĩgũthira,</para>
  <para style="q2" vid="JOB 16:22">thiĩ rũgendo rũrĩa mũndũ athiiaga na ndacooke.<verse eid="JOB 16:22"/></para>
  <chapter eid="JOB 16"/>
  <chapter number="17" style="c" sid="JOB 17"/>
  <para style="q1">
    <verse number="1" style="v" sid="JOB 17:1"/>Roho wakwa nĩmũthuthĩku,</para>
  <para style="q2" vid="JOB 17:1">matukũ makwa nĩmathirĩte, mbĩrĩra nĩyo ĩnjetereire.<verse eid="JOB 17:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 17:2"/>Ti-itherũ thiũrũrũkĩirio nĩ andũ a kũũnyũrũria;</para>
  <para style="q2" vid="JOB 17:2">maitho makwa no nginya meerorere rũmena rwao.<verse eid="JOB 17:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 17:3"/>“Wee Ngai-rĩ, ta kĩĩhe kĩndũ gĩa kũrũgamĩrĩra thiirĩ wakwa kĩrĩa ũretia,</para>
  <para style="q2" vid="JOB 17:3">tondũ-rĩ, nũũ ũngĩ ũngĩĩtĩkĩra kũruta kĩndũ gĩake kĩĩndũgamĩrĩre?<verse eid="JOB 17:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 17:4"/>Wee nĩwaagithĩtie meciiria mao ũmenyo;</para>
  <para style="q2" vid="JOB 17:4">nĩ ũndũ ũcio ndũngĩmetĩkĩria mahootane.<verse eid="JOB 17:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 17:5"/>Mũndũ angĩkaana arata ake nĩ ũndũ wa kĩheo-rĩ,</para>
  <para style="q2" vid="JOB 17:5">maitho ma ciana ciake nĩmakoora.<verse eid="JOB 17:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 17:6"/>“Ngai nĩanduĩte mũndũ wa kuunwo thimo nĩ andũ othe,</para>
  <para style="q2" vid="JOB 17:6">nduĩkĩte mũndũ wa gũtuagĩrwo mata ũthiũ nĩ andũ.<verse eid="JOB 17:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 17:7"/>Maitho makwa nĩ maroora nĩ gwĩthikĩra;</para>
  <para style="q2" vid="JOB 17:7">ciĩga ciakwa ciothe ihũthĩte o ta kĩĩruru.<verse eid="JOB 17:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 17:8"/>Andũ arĩa arũngĩrĩru nĩmagegetio nĩ ũhoro ũcio;</para>
  <para style="q2" vid="JOB 17:8">andũ arĩa matarĩ na ũũru mekĩte nĩmarahũkĩte mokĩrĩre andũ arĩa matooĩ Ngai.<verse eid="JOB 17:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 17:9"/>O na kũrĩ ũguo-rĩ, arĩa athingu nĩmarĩrũmagia njĩra ciao,</para>
  <para style="q2" vid="JOB 17:9">nao arĩa marĩ moko matheru nĩmarĩongagĩrĩrwo hinya.<verse eid="JOB 17:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 17:10"/>“No rĩrĩ, ta gĩũkei inyuothe, geriai o rĩngĩ!</para>
  <para style="q2" vid="JOB 17:10">Niĩ ndirĩ ndĩrona mũndũ mũũgĩ gatagatĩ kanyu.<verse eid="JOB 17:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 17:11"/>Matukũ makwa nĩ mathiru, mĩbango yakwa nĩmĩharaganie,</para>
  <para style="q2" vid="JOB 17:11">o na merirĩria ma ngoro yakwa.<verse eid="JOB 17:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 17:12"/>Andũ aya magarũraga ũtukũ makaũtua mũthenya;</para>
  <para style="q2" vid="JOB 17:12">nduma yamakinyĩrĩra moigaga atĩrĩ, ‘Ũtheri ũrĩ o hakuhĩ.’<verse eid="JOB 17:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 17:13"/>Angĩkorwo mũciĩ ũrĩa njĩrĩgĩrĩire no mbĩrĩra,</para>
  <para style="q2" vid="JOB 17:13">angĩkorwo ingĩara ũrĩrĩ wakwa o nduma-inĩ-rĩ,<verse eid="JOB 17:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 17:14"/>angĩkorwo no njĩĩre ũhoro wa kũbutha atĩrĩ, ‘Wee nĩwe baba,’</para>
  <para style="q2" vid="JOB 17:14">na njĩĩre kĩgunyũ atĩrĩ, ‘Wee nĩwe maitũ’ kana ‘Nĩwe mwarĩ wa maitũ-rĩ’,<verse eid="JOB 17:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 17:15"/>mwĩhoko wakwa ũkĩrĩ kũ?</para>
  <para style="q2" vid="JOB 17:15">Nũũ ũngĩnyonera mwĩhoko?<verse eid="JOB 17:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 17:16"/>Na rĩrĩ, mwĩhoko nĩũharũrũkĩte nginya ihingo-inĩ cia gĩkuũ?</para>
  <para style="q2" vid="JOB 17:16">Nĩtũgũgĩikũrũkania hamwe rũkũngũ-inĩ?”<verse eid="JOB 17:16"/></para>
  <chapter eid="JOB 17"/>
  <chapter number="18" style="c" sid="JOB 18"/>
  <para style="s1">Mĩario ya Bilidadi</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 18:1"/>Ningĩ Bilidadi ũrĩa Mũshuhi agĩcookia, akĩũria atĩrĩ:<verse eid="JOB 18:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 18:2"/>“Ũrĩĩtiga kwaria mĩario ĩno rĩ?</para>
  <para style="q2" vid="JOB 18:2">Gĩa na ũũgĩ nĩguo o na ithuĩ tũhote kwaria.<verse eid="JOB 18:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 18:3"/>Nĩ kĩĩ kĩratũma ũtuone tũhaana ta ngʼombe,</para>
  <para style="q2" vid="JOB 18:3">na tũgatuuo irimũ maitho-inĩ maku?<verse eid="JOB 18:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 18:4"/>Wee ũrehanyũrũra nĩ ũndũ wa ũrĩa ũrakarĩte-rĩ,</para>
  <para style="q2" vid="JOB 18:4">thĩ no ĩthaamwo nĩ ũndũ waku?</para>
  <para style="q2" vid="JOB 18:4">Kana no nginya ndwaro cia mahiga cieherio harĩa itũire?<verse eid="JOB 18:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 18:5"/>“Tawa wa mũndũ mwaganu nĩmũhorie;</para>
  <para style="q2" vid="JOB 18:5">rũrĩrĩmbĩ rwa mwaki wake nĩrũtigĩte gwakana.<verse eid="JOB 18:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 18:6"/>Ũtheri ũrĩa ũrĩ thĩinĩ wa hema yake ũtuĩkĩte nduma;</para>
  <para style="q2" vid="JOB 18:6">naguo tawa ũrĩa ũrĩ hakuhĩ nake ũkahora.<verse eid="JOB 18:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 18:7"/>Hinya wa mũkinyũkĩrie wake nĩmũhũthie;</para>
  <para style="q2" vid="JOB 18:7">namo mathugunda make makamũgũithia thĩ.<verse eid="JOB 18:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 18:8"/>Makinya make mamũikagia wabu-inĩ,</para>
  <para style="q2" vid="JOB 18:8">nake akoorũraga thĩinĩ wa marima mayo.<verse eid="JOB 18:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 18:9"/>Mũtego ũmũnyiitĩire ndiira-inĩ ya kũgũrũ;</para>
  <para style="q2" vid="JOB 18:9">mũtego ũgakĩmũrũmia biũ.<verse eid="JOB 18:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 18:10"/>Ahithĩirwo kĩana kĩa rũrigi tĩĩri-inĩ,</para>
  <para style="q2" vid="JOB 18:10">akaambĩrwo mũtego njĩra-inĩ yake.<verse eid="JOB 18:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 18:11"/>Imakania imuumagĩrĩra na mĩena yothe,</para>
  <para style="q2" vid="JOB 18:11">na ikamũtengʼeragia harĩa hothe aagerera.<verse eid="JOB 18:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 18:12"/>Mũtino nĩũmũhũũtĩire;</para>
  <para style="q2" vid="JOB 18:12">mwanangĩko wetereire agwe.<verse eid="JOB 18:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 18:13"/>Mũtino ũrĩĩaga icunjĩ cia gĩkonde gĩake;</para>
  <para style="q2" vid="JOB 18:13">narĩo irigithathi rĩa gĩkuũ rĩgatambuuranga ciĩga ciake.<verse eid="JOB 18:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 18:14"/>Aguucĩtio, akarutwo ũgitĩri-inĩ wa hema yake,</para>
  <para style="q2" vid="JOB 18:14">na agatwarwo kũrĩ mũthamaki wa imakania.<verse eid="JOB 18:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 18:15"/>Mwaki nĩguo ũtũũraga hema-inĩ yake;</para>
  <para style="q2" vid="JOB 18:15">ũbiriti ũgwakana nĩũhurunjĩtwo gĩikaro gĩake.<verse eid="JOB 18:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 18:16"/>Mĩri yake yũmagĩra tĩĩri-inĩ,</para>
  <para style="q2" vid="JOB 18:16">nacio honge ciake ikahooha na igũrũ.<verse eid="JOB 18:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 18:17"/>Kĩririkano gĩake nĩ gĩgaathira thĩ;</para>
  <para style="q2" vid="JOB 18:17">ndarĩ rĩĩtwa bũrũri-inĩ.<verse eid="JOB 18:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 18:18"/>Akaarutũrũrwo ũtheri-inĩ atwarwo nduma-inĩ</para>
  <para style="q2" vid="JOB 18:18">na nĩakaingatwo oime thĩ ĩno.<verse eid="JOB 18:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 18:19"/>Ndarĩ ciana kana njiaro thĩinĩ wa andũ ao,</para>
  <para style="q2" vid="JOB 18:19">o na ndarĩ mũndũ wake ũgaatigara kũrĩa aatũũraga.<verse eid="JOB 18:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 18:20"/>Andũ a mwena wa ithũĩro nĩmakagegio nĩ maũndũ marĩa mamũkorete;</para>
  <para style="q2" vid="JOB 18:20">andũ a mwena wa irathĩro manyiitwo nĩ kĩmako.<verse eid="JOB 18:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 18:21"/>Ti-itherũ ũguo nĩguo gĩikaro kĩa mũndũ mwaganu gũkahaana;</para>
  <para style="q2" vid="JOB 18:21">kũndũ kwa mũndũ ũrĩa ũtooĩ Mũrungu-rĩ, gwake kũhaana ũguo.”<verse eid="JOB 18:21"/></para>
  <chapter eid="JOB 18"/>
  <chapter number="19" style="c" sid="JOB 19"/>
  <para style="s1">Mĩario ya Ayubu</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 19:1"/>Nake Ayubu akĩũria atĩrĩ:<verse eid="JOB 19:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 19:2"/>“Mũkũũnyariira nginya-rĩ,</para>
  <para style="q2" vid="JOB 19:2">mũkĩĩhehenjaga na ciugo?<verse eid="JOB 19:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 19:3"/>Rĩu mũrĩ kũndetia maita ikũmi;</para>
  <para style="q2" vid="JOB 19:3">mũũtharĩkĩire mũtarĩ na thoni.<verse eid="JOB 19:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 19:4"/>Angĩkorwo nĩ ma atĩ nĩhĩtĩtie njĩra,</para>
  <para style="q2" vid="JOB 19:4">ihĩtia rĩakwa rĩgũikara rĩrĩ thĩĩna wakwa.<verse eid="JOB 19:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 19:5"/>Mũngĩkorwo ti-itherũ nĩmũgwĩtũũgĩria igũrũ rĩakwa,</para>
  <para style="q2" vid="JOB 19:5">na mũgĩe na mweke wa kũnjũkĩrĩra nĩ ũndũ wa ũguo njonorithĩtio,<verse eid="JOB 19:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 19:6"/>no kĩmenyei atĩ Ngai nĩwe ũũhĩtĩirie,</para>
  <para style="q2" vid="JOB 19:6">akandigiicĩria na wabu wake.<verse eid="JOB 19:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 19:7"/>“O na gũtuĩka nĩngayaga ngoiga atĩrĩ, ‘Ndĩĩmũhĩtĩrie!’ Niĩ ndirĩ ũndũ njookagĩrio;</para>
  <para style="q2" vid="JOB 19:7">o na gũtuĩka nĩhooyaga ndeithio, gũtirĩ kĩhooto nyonaga.<verse eid="JOB 19:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 19:8"/>Nĩahingĩire njĩra na niĩ ndingĩhota kũhĩtũka;</para>
  <para style="q2" vid="JOB 19:8">tũcĩra twakwa nĩatwĩkĩrĩte nduma.<verse eid="JOB 19:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 19:9"/>Nĩanjaũrĩte gĩtĩĩo gĩakwa,</para>
  <para style="q2" vid="JOB 19:9">na akanduta thũmbĩ mũtwe.<verse eid="JOB 19:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 19:10"/>Andarũrangaga kuuma mbarĩ ciothe nginya ngathira;</para>
  <para style="q2" vid="JOB 19:10">amunyaga mwĩhoko wakwa o ta mũtĩ.<verse eid="JOB 19:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 19:11"/>Marakara make nĩmanjakanĩire;</para>
  <para style="q2" vid="JOB 19:11">andaraga hamwe na thũ ciake.<verse eid="JOB 19:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 19:12"/>Mbũtũ ciake cia ita injerekagĩra na hinya;</para>
  <para style="q2" vid="JOB 19:12">ciakaga ihumbu cia kũnjũkĩrĩra,</para>
  <para style="q2" vid="JOB 19:12">igathiũrũrũkĩria hema yakwa.<verse eid="JOB 19:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 19:13"/>“Nĩanyamũranĩtie na ariũ a baba makaahutatĩra;</para>
  <para style="q2" vid="JOB 19:13">andũ arĩa tũyaine nao nĩmeĩndigithĩtie biũ.<verse eid="JOB 19:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 19:14"/>Andũ a mbarĩ ciitũ nĩmathiĩte makandiga;</para>
  <para style="q2" vid="JOB 19:14">arata akwa nĩmariganĩirwo nĩ niĩ.<verse eid="JOB 19:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 19:15"/>Ageni akwa na ndungata ciakwa cia andũ-a-nja matuaga ta matanjũũĩ;</para>
  <para style="q2" vid="JOB 19:15">maanyonaga ta ndĩ mũndũ uumĩte kũndũ kũngĩ.<verse eid="JOB 19:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 19:16"/>Njĩtaga ndungata yakwa, no ndĩngĩnjĩtĩka,</para>
  <para style="q2" vid="JOB 19:16">o na ndĩmĩthaithĩte na kanua gakwa niĩ mwene.<verse eid="JOB 19:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 19:17"/>Mĩhũmũ ya kanua gakwa nĩmĩnungu harĩ mũtumia wakwa;</para>
  <para style="q2" vid="JOB 19:17">nduĩkĩte wa kũmenwo harĩ ariũ a maitũ.<verse eid="JOB 19:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 19:18"/>O na tũhĩĩ tũrĩa tũnini nĩtũũnyararĩte,</para>
  <para style="q2" vid="JOB 19:18">rĩrĩa ndatuumĩrĩra no gũũthekerera tũũthekagĩrĩra.<verse eid="JOB 19:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 19:19"/>Arata akwa arĩa manguhĩrĩirie othe nĩmathũire;</para>
  <para style="q2" vid="JOB 19:19">andũ arĩa nyendeete nĩmahutatĩire makaanjũkĩrĩra.<verse eid="JOB 19:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 19:20"/>Niĩ thirĩte ngatigara o gĩkonde na mahĩndĩ;</para>
  <para style="q2" vid="JOB 19:20">niĩ ndigarĩirwo no kĩni kĩa magego giiki.<verse eid="JOB 19:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 19:21"/>“Njiguĩrai tha, inyuĩ arata akwa, iguai tha,</para>
  <para style="q2" vid="JOB 19:21">nĩgũkorwo guoko kwa Ngai nĩkũngũthĩte.<verse eid="JOB 19:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 19:22"/>Mũthingatanaga na niĩ o ta ũrĩa Mũrungu aathingataga nĩkĩ?</para>
  <para style="q2" vid="JOB 19:22">Mũtirĩ mũraiganwo nĩ nyama ciakwa?<verse eid="JOB 19:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 19:23"/>“Naarĩ korwo ciugo ciakwa nĩciandĩkĩtwo,</para>
  <para style="q2" vid="JOB 19:23">igakĩandĩkwo ibuku-inĩ rĩa gĩkũnjo,<verse eid="JOB 19:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 19:24"/>igakarwo na karamu ga kĩgera igũrũ rĩa ngocorai,</para>
  <para style="q2" vid="JOB 19:24">kana igakururwo rwaro-inĩ rwa ihiga itũũre nginya tene!<verse eid="JOB 19:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 19:25"/>Nĩnjũũĩ atĩ Mũngũũri arĩ muoyo,</para>
  <para style="q2" vid="JOB 19:25">na atĩ marigĩrĩrio-inĩ nĩwe ũkaarũgama thĩ ĩno.<verse eid="JOB 19:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 19:26"/>Nakĩo gĩkonde gĩkĩ gĩakwa kĩarĩkia gũthira,</para>
  <para style="q2" vid="JOB 19:26">na mwĩrĩ ũyũ wa nyama ũkorwo ũtarĩ ho,</para>
  <para style="q2" vid="JOB 19:26">hĩndĩ ĩyo nĩ ngoona Ngai;<verse eid="JOB 19:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 19:27"/>niĩ mwene nĩngamwĩonera na maitho,</para>
  <para style="q2" vid="JOB 19:27">niĩ mwene, ti mũndũ ũngĩ.</para>
  <para style="q2" vid="JOB 19:27">Ĩ ngoro yakwa ndĩkĩrĩ na wendo mũnene!<verse eid="JOB 19:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 19:28"/>“Mũngiuga atĩrĩ, ‘Ĩ nĩtũthingatane nake,</para>
  <para style="q2" vid="JOB 19:28">kuona atĩ nĩwe kĩhumo gĩa thĩĩna ũyũ,’<verse eid="JOB 19:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 19:29"/>inyuĩ ene nĩmwagĩrĩirwo nĩ gwĩtigĩra rũhiũ rwa njora;</para>
  <para style="q2" vid="JOB 19:29">nĩgũkorwo mangʼũrĩ nĩmakarehithia kũherithanio na rũhiũ rwa njora,</para>
  <para style="q2" vid="JOB 19:29">na hĩndĩ ĩyo nĩmũkamenya atĩ nĩ kũrĩ ũtuanĩri wa ciira.”<verse eid="JOB 19:29"/></para>
  <chapter eid="JOB 19"/>
  <chapter number="20" style="c" sid="JOB 20"/>
  <para style="s1">Mĩario ya Zofaru</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 20:1"/>Nake Zofaru ũrĩa Mũnaamathi agĩcookia atĩrĩ:<verse eid="JOB 20:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 20:2"/>“Meciiria makwa nĩ mathĩĩnĩku, na nĩkĩo ngũcookia,</para>
  <para style="q2" vid="JOB 20:2">nĩ ũndũ nĩndangĩkĩte mũno.<verse eid="JOB 20:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 20:3"/>Ndĩraigua irũithia rĩa kũnjonorithia,</para>
  <para style="q2" vid="JOB 20:3">naguo ũmenyo wakwa nĩũranjĩkĩra hinya wa gũcookia.<verse eid="JOB 20:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 20:4"/>“Ti-itherũ nĩũũĩ ũrĩa gũtũire kuuma tene</para>
  <para style="q2" vid="JOB 20:4">rĩrĩa mũndũ aigirwo gũkũ thĩ ĩno,<verse eid="JOB 20:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 20:5"/>atĩ kũrũũhia kwa arĩa aaganu no gwa kahinda,</para>
  <para style="q2" vid="JOB 20:5">o nakĩo gĩkeno kĩa andũ arĩa matooĩ Ngai no gĩa kahinda kanini.<verse eid="JOB 20:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 20:6"/>O na gũtuĩka mwĩtĩĩo wake nĩ ũkinyaga o igũrũ,</para>
  <para style="q2" vid="JOB 20:6">naguo mũtwe wake ũkahutia matu-rĩ,<verse eid="JOB 20:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 20:7"/>agaathira nginya tene o ta mai make mwene;</para>
  <para style="q2" vid="JOB 20:7">arĩa manamuona mooragie atĩrĩ, ‘Kaĩ aathiire kũ?’<verse eid="JOB 20:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 20:8"/>Airagĩria ta kĩroto, akaaga kuoneka rĩngĩ,</para>
  <para style="q2" vid="JOB 20:8">akaingatwo ta kĩoneki kĩa ũtukũ.<verse eid="JOB 20:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 20:9"/>Riitho rĩrĩa rĩamuonaga rĩtikamuona rĩngĩ;</para>
  <para style="q2" vid="JOB 20:9">harĩa aaikaraga hatikamuona rĩngĩ.<verse eid="JOB 20:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 20:10"/>Ciana ciake ikaageragia kwĩiguithania na athĩĩni;</para>
  <para style="q2" vid="JOB 20:10">moko make mwene no nginya magaacookia ũtonga wake kũrĩa aaũrutire.<verse eid="JOB 20:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 20:11"/>Hinya wa wĩthĩ ũrĩa ũiyũrĩte mahĩndĩ-inĩ make</para>
  <para style="q2" vid="JOB 20:11">ũgaakoma hamwe nake rũkũngũ-inĩ.<verse eid="JOB 20:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 20:12"/>“O na gũtuĩka ũũru ũrĩ mũrĩo ũrĩ kanua gake,</para>
  <para style="q2" vid="JOB 20:12">na nĩaũhithaga rungu rwa rũrĩmĩ rwake,<verse eid="JOB 20:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 20:13"/>o na gũtuĩka ndangĩhota kũũrekia</para>
  <para style="q2" vid="JOB 20:13">na aũigaga kanua gake-rĩ,<verse eid="JOB 20:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 20:14"/>irio ciake nĩikarũra irĩ nda yake;</para>
  <para style="q2" vid="JOB 20:14">igaatuĩka ũrũrũ wa nduĩra thĩinĩ wake.<verse eid="JOB 20:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 20:15"/>Nĩagatahĩka ũtonga ũrĩa ameretie;</para>
  <para style="q2" vid="JOB 20:15">Mũrungu nĩagatũma aũtahĩke.<verse eid="JOB 20:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 20:16"/>Nĩakoonga thumu wa nyoka;</para>
  <para style="q2" vid="JOB 20:16">magego ma nyoka nĩmo makaamũũraga.<verse eid="JOB 20:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 20:17"/>Ndagakenera tũrũũĩ,</para>
  <para style="q2" vid="JOB 20:17">njũũĩ iria ithereraga ũũkĩ na ngorono.<verse eid="JOB 20:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 20:18"/>Kĩndũ kĩrĩa anogeire no nginya agagĩcookia atakĩrĩte;</para>
  <para style="q2" vid="JOB 20:18">ndagakenera uumithio wa wonjoria wake.<verse eid="JOB 20:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 20:19"/>Nĩgũkorwo nĩahinyĩrĩirie athĩĩni, akamatiga matarĩ na kĩndũ;</para>
  <para style="q2" vid="JOB 20:19">nĩatunyanĩte nyũmba iria ataakire.<verse eid="JOB 20:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 20:20"/>“Ti-itherũ merirĩria make matingĩthira;</para>
  <para style="q2" vid="JOB 20:20">ndangĩĩhonokia na indo iria eigĩire.<verse eid="JOB 20:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 20:21"/>Gũtirĩ kĩndũ atigĩirio gĩa kũrĩa;</para>
  <para style="q2" vid="JOB 20:21">ũtonga wake ndũgatũũra.<verse eid="JOB 20:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 20:22"/>Hĩndĩ ĩrĩa aiganĩire nĩ ũndũ wa kũingĩhia indo, mĩnyamaro nĩĩkamũnyiita;</para>
  <para style="q2" vid="JOB 20:22">ũkĩa nĩũkamũkora na nditi nene.<verse eid="JOB 20:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 20:23"/>Hĩndĩ ĩrĩa aiyũrĩtie nda yake-rĩ,</para>
  <para style="q2" vid="JOB 20:23">nĩguo Ngai akaarekereria marakara make mahiũ mamũkore</para>
  <para style="q2" vid="JOB 20:23">na amuurĩrie mahũũra make.<verse eid="JOB 20:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 20:24"/>O na angĩũrĩra indo cia mbaara cia kĩgera,</para>
  <para style="q2" vid="JOB 20:24">akaarathwo na mũguĩ wa gĩcango.<verse eid="JOB 20:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 20:25"/>Aũcomoraga kuuma ngʼongʼo wake,</para>
  <para style="q2" vid="JOB 20:25">mũtheece ũcio mũkengu akaũcomora kuuma ini-inĩ rĩake.</para>
  <para style="q1" vid="JOB 20:25">Imakania nĩikamũkorerera;<verse eid="JOB 20:25"/></para>
  <para style="q2">
    <verse number="26" style="v" sid="JOB 20:26"/>nduma nene nĩyetereire igĩĩna ciake.</para>
  <para style="q1" vid="JOB 20:26">Mwaki ũtarĩ mũhurutĩre nĩũkamũcina,</para>
  <para style="q2" vid="JOB 20:26">na ũniine kĩrĩa gĩtigaire thĩinĩ wa hema yake.<verse eid="JOB 20:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 20:27"/>Igũrũ nĩrĩkaguũria wĩhia wake;</para>
  <para style="q2" vid="JOB 20:27">thĩ nayo nĩĩkarahũka ĩmũũkĩrĩre.<verse eid="JOB 20:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 20:28"/>Kĩguũ nĩgĩgathereria nyũmba yake,</para>
  <para style="q2" vid="JOB 20:28">indo cia nyũmba yake ithererio nĩ kĩguũ mũthenya ũcio wa mangʼũrĩ ma Ngai.<verse eid="JOB 20:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 20:29"/>Ũcio nĩguo ũndũ ũrĩa Ngai agayagĩra arĩa aaganu,</para>
  <para style="q2" vid="JOB 20:29">igai rĩrĩa maathĩrĩirwo nĩ Mũrungu.”<verse eid="JOB 20:29"/></para>
  <chapter eid="JOB 20"/>
  <chapter number="21" style="c" sid="JOB 21"/>
  <para style="s1">Mĩario ya Ayubu</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 21:1"/>Ningĩ Ayubu agĩcookia atĩrĩ:<verse eid="JOB 21:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 21:2"/>“Thikĩrĩriai wega ciugo ciakwa;</para>
  <para style="q2" vid="JOB 21:2">rekei ũndũ ũyũ ũtuĩke nĩguo mũkũũhooreria naguo.<verse eid="JOB 21:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 21:3"/>Ngirĩrĩriai na niĩ njarie,</para>
  <para style="q2" vid="JOB 21:3">na ndaarĩkia kwaria-rĩ, mũgĩcooke mũũnyũrũrie.<verse eid="JOB 21:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 21:4"/>“Niĩ-rĩ, kaĩ mateta makwa meerekeirio mũndũ?</para>
  <para style="q2" vid="JOB 21:4">Ngũkĩaga kũremwo nĩ gũkirĩrĩria nĩkĩ?<verse eid="JOB 21:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 21:5"/>Ta ndorai mũgege;</para>
  <para style="q2" vid="JOB 21:5">mwĩnyiite tũnua twanyu na moko nĩ kũmaka.<verse eid="JOB 21:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 21:6"/>Ndĩciiragia ũhoro ũyũ ngamaka mũno;</para>
  <para style="q2" vid="JOB 21:6">ngethithimũkwo nĩ mwĩrĩ, ngambĩrĩria kũinaina.<verse eid="JOB 21:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 21:7"/>Atĩrĩ, andũ arĩa aaganu marekagwo matũũre muoyo nĩkĩ,</para>
  <para style="q2" vid="JOB 21:7">magakũra o na magakĩrĩrĩria kũgĩa na ũhoti?<verse eid="JOB 21:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 21:8"/>Nĩmeonagĩra ciana ciao ikĩgaacĩra kũu marĩ,</para>
  <para style="q2" vid="JOB 21:8">makoona rũciaro rwao rũkĩĩhaanda mbere ya maitho mao.<verse eid="JOB 21:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 21:9"/>Mĩciĩ yao ĩikaraga ĩgitĩirwo na ĩtarĩ na guoya;</para>
  <para style="q2" vid="JOB 21:9">naruo rũthanju rwa Ngai rũtimahũũraga.<verse eid="JOB 21:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 21:10"/>Ndegwa ciao itiagaga kũgwatia;</para>
  <para style="q2" vid="JOB 21:10">ngʼombe ciao iciaraga, na itihunaga.<verse eid="JOB 21:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 21:11"/>Moimagaragia twana twao tũingĩ o ta rũũru;</para>
  <para style="q2" vid="JOB 21:11">ciana icio ciao ikaina igĩtũrũhaga.<verse eid="JOB 21:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 21:12"/>Nao o ene mainaga makĩhũũraga tũhembe na inanda cia mũgeeto;</para>
  <para style="q2" vid="JOB 21:12">mekenagia na mũgambo wa mũtũrirũ.<verse eid="JOB 21:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 21:13"/>Matũũraga mĩaka yao magaacĩire,</para>
  <para style="q2" vid="JOB 21:13">na magathiĩ mbĩrĩra-inĩ marĩ na thayũ.<verse eid="JOB 21:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 21:14"/>Na no-o meeraga Mũrungu atĩrĩ, ‘Thiĩ! Tigana na ithuĩ!</para>
  <para style="q2" vid="JOB 21:14">Tũtikwenda kũmenya njĩra ciaku.<verse eid="JOB 21:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 21:15"/>Mwene-Hinya-Wothe nĩwe ũ, atĩ nĩguo tũmũtungatagĩre?</para>
  <para style="q2" vid="JOB 21:15">Tũkũgunĩka nakĩ tũngĩmũhooya?’<verse eid="JOB 21:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 21:16"/>No rĩrĩ, kũgaacĩra kwao gũtirĩ moko-inĩ mao ene,</para>
  <para style="q2" vid="JOB 21:16">nĩ ũndũ ũcio niĩ njikaraga haraaya na kĩrĩra kĩa andũ arĩa aaganu.<verse eid="JOB 21:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 21:17"/>“Na rĩrĩ, nĩ maita maigana tawa wa arĩa aaganu ũhoragio?</para>
  <para style="q2" vid="JOB 21:17">Nĩ maita maigana makoragwo nĩ mũtino,</para>
  <para style="q2" vid="JOB 21:17">na nĩ maita maigana Ngai amagayagĩra ruo nĩ kũmarakarĩra?<verse eid="JOB 21:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 21:18"/>Nĩ maita maigana matuĩkaga ta nyeki nyũmũ ĩkũhurutwo nĩ rũhuho,</para>
  <para style="q2" vid="JOB 21:18">o na kana ta maragara marĩa mombũragwo nĩ kĩhuhũkanio?<verse eid="JOB 21:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 21:19"/>Kuugagwo atĩrĩ, ‘Ngai aigagĩra ciana iherithia rĩa ithe wao.’</para>
  <para style="q2" vid="JOB 21:19">No rĩrĩ, nĩ kaba Ngai aherithie mũndũ ũcio we mwene,</para>
  <para style="q2" vid="JOB 21:19">nĩguo amenye nĩehĩtie!<verse eid="JOB 21:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 21:20"/>Maitho make nĩmeyonere mwanangĩko wake mwene;</para>
  <para style="q2" vid="JOB 21:20">nĩarekwo akunde mangʼũrĩ ma Mwene-Hinya-Wothe.<verse eid="JOB 21:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 21:21"/>Nĩ ũndũ-rĩ, anga no eetangaga ha ũhoro wa andũ ake</para>
  <para style="q2" vid="JOB 21:21">arĩa agaatiga na thuutha, matukũ make maathira?<verse eid="JOB 21:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 21:22"/>“Nĩ kũrĩ mũndũ o na ũmwe ũngĩhota kũruta Mũrungu atĩ nĩguo agĩe na ũmenyo,</para>
  <para style="q2" vid="JOB 21:22">kuona atĩ Mũrungu nĩwe ũtuanagĩra ciira, o na agatuĩra arĩa atũũgĩirie mũno?<verse eid="JOB 21:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 21:23"/>Nĩ kũrĩ mũndũ ũkuuaga arĩ na hinya wake wothe,</para>
  <para style="q2" vid="JOB 21:23">arĩ mũgitĩre wega biũ, na arĩ na thayũ,<verse eid="JOB 21:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 21:24"/>mwĩrĩ wake ũheetwo irio wega,</para>
  <para style="q2" vid="JOB 21:24">na mahĩndĩ ma mĩthiimo yake marĩ o maigũ.<verse eid="JOB 21:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 21:25"/>Mũndũ ũngĩ agakua arĩ na marũrũ ma ngoro,</para>
  <para style="q2" vid="JOB 21:25">atarĩ aakenera kĩndũ kĩega o na kĩ.<verse eid="JOB 21:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 21:26"/>Makomaga o ro ũndũ ũmwe tĩĩri-inĩ,</para>
  <para style="q2" vid="JOB 21:26">na eerĩ-rĩ, igunyũ ikamahumbĩra.<verse eid="JOB 21:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 21:27"/>“Niĩ nĩnjũũĩ wega ũrĩa mũreciiria,</para>
  <para style="q2" vid="JOB 21:27">ngamenya mathugunda manyu maakũhĩtĩria namo.<verse eid="JOB 21:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 21:28"/>Mũrooria atĩrĩ, ‘Rĩu nyũmba ya mũndũ ũrĩa mũnene ĩkĩrĩ ha,</para>
  <para style="q2" vid="JOB 21:28">na hema ĩrĩa andũ aaganu maratũũraga-rĩ, ĩkĩrĩ ha?’<verse eid="JOB 21:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 21:29"/>Kaĩ mũtarĩ muoria andũ arĩa mathiiaga ngʼendo?</para>
  <para style="q2" vid="JOB 21:29">Kaĩ mũtarũmbũyagia ũrĩa mamwĩraga:<verse eid="JOB 21:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 21:30"/>atĩ mũndũ ũrĩa mwaganu nĩ aiguagĩrwo tha mũthenya wa mũtino,</para>
  <para style="q2" vid="JOB 21:30">atĩ nĩahonokagio mũthenya wa mangʼũrĩ?<verse eid="JOB 21:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOB 21:31"/>Nũũ ũreganaga na mĩtugo ya mũndũ mwaganu maitho-inĩ make?</para>
  <para style="q2" vid="JOB 21:31">Nũũ ũmũrĩhagia kũringana na maũndũ marĩa aaneka?<verse eid="JOB 21:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOB 21:32"/>Atwaragwo mbĩrĩra-inĩ,</para>
  <para style="q2" vid="JOB 21:32">nayo mbĩrĩra yake ĩkarangagĩrwo.<verse eid="JOB 21:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="JOB 21:33"/>Tĩĩri wa gĩtuamba nĩũrĩ mũrĩo harĩ we;</para>
  <para style="q2" vid="JOB 21:33">andũ othe nĩwe marũmagĩrĩra,</para>
  <para style="q2" vid="JOB 21:33">na kĩrĩndĩ gĩtangĩtarĩka gĩgathiiaga mbere yake.<verse eid="JOB 21:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="JOB 21:34"/>“Mwakĩhota atĩa kũũhooreria na ndeto cia tũhũ?</para>
  <para style="q2" vid="JOB 21:34">Hatirĩ kĩndũ gĩtigaru harĩ macookio manyu tiga o maheeni!”<verse eid="JOB 21:34"/></para>
  <chapter eid="JOB 21"/>
  <chapter number="22" style="c" sid="JOB 22"/>
  <para style="s1">Mĩario ya Elifazu</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 22:1"/>Nake Elifazu ũrĩa Mũtemaani agĩcookia atĩrĩ:<verse eid="JOB 22:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 22:2"/>“Mũndũ aahota kũguna Mũrungu?</para>
  <para style="q2" vid="JOB 22:2">O na mũndũ mũũgĩ-rĩ, akĩhota kũmũguna?<verse eid="JOB 22:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 22:3"/>Nĩ gĩkeno kĩrĩkũ ũthingu waku ũngĩrehere Mwene-Hinya-Wothe?</para>
  <para style="q2" vid="JOB 22:3">Nĩ uumithio ũrĩkũ angĩgĩa naguo angĩkorwo mĩthiĩre yaku ndĩrĩ ũcuuke?<verse eid="JOB 22:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 22:4"/>“Arakũrũithia na agagũthitanga</para>
  <para style="q2" vid="JOB 22:4">nĩ ũndũ wa wĩtigĩri Ngai waku?<verse eid="JOB 22:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 22:5"/>Githĩ waganu waku ti mũnene?</para>
  <para style="q2" vid="JOB 22:5">Mehia maku-rĩ, makĩrĩ mũthia?<verse eid="JOB 22:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 22:6"/>Wetirie ũgitĩri kuuma kũrĩ ariũ a thoguo hatarĩ gĩtũmi;</para>
  <para style="q2" vid="JOB 22:6">nĩwaũrire andũ nguo, ũkĩmatiga njaga.<verse eid="JOB 22:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 22:7"/>Arĩa anogu ndwamaheire maaĩ,</para>
  <para style="q2" vid="JOB 22:7">na nĩwaimire arĩa ahũtu irio,<verse eid="JOB 22:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 22:8"/>o na gũtuĩka warĩ mũndũ ũrĩ hinya, ũrĩ na mĩgũnda:</para>
  <para style="q2" vid="JOB 22:8">mũndũ ũheetwo gĩtĩĩo, na watũũraga kuo.<verse eid="JOB 22:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 22:9"/>Nĩwaingatire atumia a ndigwa matarĩ na kĩndũ,</para>
  <para style="q2" vid="JOB 22:9">na ũkĩniina hinya wa arĩa matarĩ na maithe.<verse eid="JOB 22:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 22:10"/>Nĩkĩo ũthiũrũrũkĩirio nĩ mĩtego,</para>
  <para style="q2" vid="JOB 22:10">nĩkĩo thĩĩna wa narua ũkũmakagia,<verse eid="JOB 22:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 22:11"/>nĩkĩo ũtumanĩirwo nĩ nduma, ũkaremwo nĩkuona,</para>
  <para style="q2" vid="JOB 22:11">na nokĩo mũiyũro wa maaĩ ũkũhubanĩirie.<verse eid="JOB 22:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 22:12"/>“Githĩ Ngai ndarĩ o kũu igũrũ o igũrũ?</para>
  <para style="q2" vid="JOB 22:12">O na ta kĩone ũrĩa njata iria irĩ igũrũ mũno itũũgĩrĩte!<verse eid="JOB 22:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 22:13"/>No rĩrĩ, wee ũroiga atĩrĩ, ‘Mũrungu nĩ atĩa angĩmenya?</para>
  <para style="q2" vid="JOB 22:13">No atuanĩre ciira nduma-inĩ ta ĩno?<verse eid="JOB 22:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 22:14"/>Matu matumanu nĩmamũhumbĩrĩte,</para>
  <para style="q2" vid="JOB 22:14">nĩ ũndũ ũcio ndangĩtuona rĩrĩa egũceera kũu igũrũ gacũmbĩrĩ.’<verse eid="JOB 22:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 22:15"/>Ũgũtũũra ũgeraga o njĩra ya tene</para>
  <para style="q2" vid="JOB 22:15">ĩrĩa andũ aaganu managerera?<verse eid="JOB 22:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 22:16"/>Nĩmahuririo ihinda rĩao rĩtanakinya,</para>
  <para style="q2" vid="JOB 22:16">mĩthingi yao ĩgĩthererio nĩ mũiyũro wa maaĩ.<verse eid="JOB 22:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 22:17"/>Nao meerire Mũrungu atĩrĩ, ‘Tigana na ithuĩ!</para>
  <para style="q2" vid="JOB 22:17">Mwene-Hinya-Wothe-rĩ, angĩtwĩka atĩa?’<verse eid="JOB 22:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 22:18"/>No rĩrĩ, nĩwe waiyũririe nyũmba ciao na indo njega,</para>
  <para style="q2" vid="JOB 22:18">nĩ ũndũ ũcio niĩ njikaraga haraaya na kĩrĩra kĩa andũ arĩa aaganu.<verse eid="JOB 22:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 22:19"/>“Andũ arĩa athingu nĩmeyonagĩra mwanangĩko wa acio aaganu, magakena;</para>
  <para style="q2" vid="JOB 22:19">arĩa matarĩ na ũũru mekĩte mamanyũrũragia makiugaga atĩrĩ:<verse eid="JOB 22:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 22:20"/>‘Ti-itherũ thũ ciitũ nĩnyanange,</para>
  <para style="q2" vid="JOB 22:20">mwaki nĩũcinĩte ũtonga wao.’<verse eid="JOB 22:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 22:21"/>“Athĩkĩra Ngai ũikare ũrĩ na thayũ nake,</para>
  <para style="q2" vid="JOB 22:21">ũndũ ũyũ nĩguo ũgaakũrehere ũgaacĩru.<verse eid="JOB 22:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 22:22"/>Ĩtĩkĩra ũrutani wa kanua gake,</para>
  <para style="q2" vid="JOB 22:22">na ũige ciugo ciake ngoro-inĩ yaku.<verse eid="JOB 22:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 22:23"/>Ũngĩcookerera ũcio Mwene-Hinya-Wothe,</para>
  <para style="q2" vid="JOB 22:23">nĩegũkwamũkĩra; ũngĩeheria waganu kũraya na hema yaku,<verse eid="JOB 22:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 22:24"/>na ũte ngũmba ciaku cia thahabu rũkũngũ-inĩ,</para>
  <para style="q2" vid="JOB 22:24">na thahabu yaku ya Ofiri ũmĩte na kũu ndwaro-inĩ cia mahiga kũu mũkuru-inĩ,<verse eid="JOB 22:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 22:25"/>hĩndĩ ĩyo ũcio Mwene-Hinya-Wothe agaatuĩka thahabu yaku,</para>
  <para style="q2" vid="JOB 22:25">na atuĩke betha ĩrĩa njega mũno harĩ we.<verse eid="JOB 22:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 22:26"/>Ti-itherũ, hĩndĩ ĩyo nĩũkona gĩkeno thĩinĩ wa ũcio Mwene-Hinya-Wothe,</para>
  <para style="q2" vid="JOB 22:26">na nĩũgatiirĩra Ngai ũthiũ waku.<verse eid="JOB 22:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 22:27"/>Nĩũkamũhooya, nake nĩagakũigua,</para>
  <para style="q2" vid="JOB 22:27">nawe nĩũkahingia mĩĩhĩtwa yaku.<verse eid="JOB 22:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 22:28"/>Ũrĩa watua wĩkwo nĩguo ũrĩkagwo,</para>
  <para style="q2" vid="JOB 22:28">naguo ũtheri nĩ ũkaara njĩra-inĩ ciaku.<verse eid="JOB 22:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 22:29"/>Hĩndĩ ĩrĩa andũ angĩ manyiihio, nawe ũkoiga, ‘Nĩmatũũgĩrio!’</para>
  <para style="q2" vid="JOB 22:29">Hĩndĩ ĩyo nĩakahonokia arĩa makuĩte ngoro.<verse eid="JOB 22:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 22:30"/>Nĩakahonokia o na ũrĩa ũrĩ na ũcuuke,</para>
  <para style="q2" vid="JOB 22:30">ahonokio nĩ ũndũ wa ũtheru wa moko maku.”<verse eid="JOB 22:30"/></para>
  <chapter eid="JOB 22"/>
  <chapter number="23" style="c" sid="JOB 23"/>
  <para style="s1">Mĩario ya Ayubu</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 23:1"/>Ningĩ Ayubu agĩcookia atĩrĩ:<verse eid="JOB 23:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 23:2"/>“O na ũmũthĩ gũteta gwakwa no kũrũrũ;</para>
  <para style="q2" vid="JOB 23:2">guoko gwake nĩkũnditũhĩire o na ngĩcaayaga ũguo.<verse eid="JOB 23:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 23:3"/>Naarĩ korwo nĩnjũũĩ kũrĩa ingĩmuona;</para>
  <para style="q2" vid="JOB 23:3">Naarĩ korwo no hote gũthiĩ kũrĩa aikaraga!<verse eid="JOB 23:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 23:4"/>Ingĩĩyarĩrĩria harĩ we,</para>
  <para style="q2" vid="JOB 23:4">njiyũrie kanua gakwa ihooto.<verse eid="JOB 23:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 23:5"/>No nyende kũmenya ũrĩa angĩĩnjookeria,</para>
  <para style="q2" vid="JOB 23:5">ndĩcũũranie ũrĩa angĩnjĩĩra.<verse eid="JOB 23:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 23:6"/>No anjũkĩrĩre na ũhoti wake mũnene?</para>
  <para style="q2" vid="JOB 23:6">Aca, ndangĩhatĩrĩria na thitango.<verse eid="JOB 23:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 23:7"/>Hau-rĩ, mũndũ mũrũngĩrĩru no atware ciira wake mbere yake,</para>
  <para style="q2" vid="JOB 23:7">na niĩ njohorithio kuuma kũrĩ mũnjiirithia nginya tene.<verse eid="JOB 23:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 23:8"/>“No rĩrĩ, ingĩthiĩ mwena wa irathĩro, we ndarĩ kuo;</para>
  <para style="q2" vid="JOB 23:8">ingĩthiĩ mwena wa ithũĩro, ndiramuona.<verse eid="JOB 23:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 23:9"/>Hĩndĩ ĩrĩa arĩ wĩra-inĩ mwena wa gathigathini, ndimuonaga;</para>
  <para style="q2" vid="JOB 23:9">rĩrĩa athiĩ mwena wa gũthini, ndimuonaga o na hanini.<verse eid="JOB 23:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 23:10"/>Nowe-rĩ, nĩooĩ njĩra ĩrĩa ngeragĩra;</para>
  <para style="q2" vid="JOB 23:10">aarĩkia kũngeria, ngoima haana o ta thahabu.<verse eid="JOB 23:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 23:11"/>Magũrũ makwa moimĩte makinya make thuutha;</para>
  <para style="q2" vid="JOB 23:11">nũmagĩrĩra njĩra yake itekwahũka na mwena.<verse eid="JOB 23:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 23:12"/>Niĩ nditiganĩirie maathani ma mĩromo yake;</para>
  <para style="q2" vid="JOB 23:12">njĩkĩrĩire ciugo cia kanua gake gũkĩra irio ciakwa cia o mũthenya.<verse eid="JOB 23:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 23:13"/>“No rĩrĩ, arũgamaga arĩ o wiki; nũũ ũngĩhota kũregana nake?</para>
  <para style="q2" vid="JOB 23:13">Ekaga o ũrĩa ekwenda.<verse eid="JOB 23:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 23:14"/>Ahingagia ũndũ ũrĩa anduĩrĩire,</para>
  <para style="q2" vid="JOB 23:14">na arĩ o na mĩbango mĩingĩ ta ĩyo anjigĩire.<verse eid="JOB 23:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 23:15"/>Kĩu nĩkĩo gĩtũmĩte nyiitwo nĩ kĩmako ndĩ mbere yake;</para>
  <para style="q2" vid="JOB 23:15">ndeciiria maũndũ macio mothe-rĩ, ngamwĩtigĩra.<verse eid="JOB 23:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 23:16"/>Mũrungu nĩatũmĩte ngoro yakwa yũrwo nĩ hinya;</para>
  <para style="q2" vid="JOB 23:16">ũcio Mwene-Hinya-Wothe nĩatũmĩte nyiitwo nĩ guoya.<verse eid="JOB 23:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 23:17"/>No rĩrĩ, ndikirĩtio nĩ nduma,</para>
  <para style="q2" vid="JOB 23:17">ĩĩ nduma ĩyo ndumanu ĩhumbĩrĩte ũthiũ wakwa.<verse eid="JOB 23:17"/></para>
  <para style="b"/>
  <chapter eid="JOB 23"/>
  <chapter number="24" style="c" sid="JOB 24"/>
  <para style="q1">
    <verse number="1" style="v" sid="JOB 24:1"/>“Nĩ kĩĩ kĩgiragia Mwene-Hinya-Wothe araarĩrie mahinda ma ciira?</para>
  <para style="q2" vid="JOB 24:1">Nĩ kĩĩ gĩtũmaga arĩa mamũũĩ meterere mĩthenya ta ĩyo o tũhũ?<verse eid="JOB 24:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 24:2"/>Kũrĩ andũ meeheragia mahiga ma mũhaka,</para>
  <para style="q2" vid="JOB 24:2">na makarĩithia ndũũru cia mahiũ iria maiyĩte.<verse eid="JOB 24:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 24:3"/>Moyaga ndigiri ya mwana wa ngoriai,</para>
  <para style="q2" vid="JOB 24:3">na magakuua ndegwa ya mũtumia wa ndigwa ĩtuĩke ya kũrũgamĩrĩra thiirĩ wao.<verse eid="JOB 24:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 24:4"/>Nĩ meeheragia andũ arĩa abatari njĩra-inĩ,</para>
  <para style="q2" vid="JOB 24:4">na makahatĩrĩria athĩĩni othe a bũrũri magatũma mathiĩ makehithe.<verse eid="JOB 24:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 24:5"/>O ta njagĩ cia werũ,</para>
  <para style="q2" vid="JOB 24:5">noguo andũ arĩa athĩĩni marokagĩra wĩra wa kũhaara kĩndũ gĩa kũrĩa;</para>
  <para style="q2" vid="JOB 24:5">kũu bũrũri ũrĩa ũtagĩaga kĩndũ nĩkuo marutaga irio cia kũhe ciana ciao.<verse eid="JOB 24:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 24:6"/>Monganagia ngaragatha mĩgũnda-inĩ,</para>
  <para style="q2" vid="JOB 24:6">na makahaara matigari mĩgũnda ya mĩthabibũ ya arĩa aaganu.<verse eid="JOB 24:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 24:7"/>Maraaraga njaga nĩ kwaga nguo;</para>
  <para style="q2" vid="JOB 24:7">matirĩ kĩndũ gĩa kwĩhumbĩra rĩrĩa kwagĩa heho.<verse eid="JOB 24:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 24:8"/>Maconjoragio nĩ mbura ya irĩma-inĩ,</para>
  <para style="q2" vid="JOB 24:8">nao makenyiitĩrĩra mahiga nĩ ũndũ wa kwaga ha kwĩyũa.<verse eid="JOB 24:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 24:9"/>Mahuragia mwana wa ngoriai kuuma nyondo-inĩ;</para>
  <para style="q2" vid="JOB 24:9">nako gakenge ka mũthĩĩni gatahagwo nĩ ũndũ wa thiirĩ.<verse eid="JOB 24:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 24:10"/>Mathiiaga njaga nĩ kwaga nguo;</para>
  <para style="q2" vid="JOB 24:10">makuuaga itĩĩa cia ngano, no magatigwo marĩ o ahũtu.<verse eid="JOB 24:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 24:11"/>Mahihagĩra ndamaiyũ mĩtaro-inĩ;</para>
  <para style="q2" vid="JOB 24:11">nĩo makinyangaga ihihĩro cia ndibei o magĩkuaga nĩ nyoota.<verse eid="JOB 24:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 24:12"/>Mũcaayo wa arĩa marakua nĩũraiguuo ũkiuma itũũra inene,</para>
  <para style="q2" vid="JOB 24:12">nayo mĩoyo ya arĩa agurarie no gũkaya ĩrakaya ĩkĩenda ũteithio.</para>
  <para style="q2" vid="JOB 24:12">No Ngai gũtirĩ mũndũ aratuĩra ciira nĩ ũndũ wa gwĩka ũũru.<verse eid="JOB 24:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 24:13"/>“Nĩ kũrĩ andũ arĩa mareganaga na ũtheri,</para>
  <para style="q2" vid="JOB 24:13">na matiũĩ njĩra ciaguo,</para>
  <para style="q2" vid="JOB 24:13">o na kana magaikara tũcĩra-inĩ twaguo.<verse eid="JOB 24:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 24:14"/>Hĩndĩ ĩrĩa gwatuka-rĩ,</para>
  <para style="q2" vid="JOB 24:14">mũũragani ookagĩra akooraga athĩĩni na abatari;</para>
  <para style="q2" vid="JOB 24:14">ningĩ ũtukũ agatuĩka ta mũici.<verse eid="JOB 24:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 24:15"/>Riitho rĩa gĩtharia rĩetagĩrĩra kũgĩe mairia;</para>
  <para style="q2" vid="JOB 24:15">kĩĩraga atĩrĩ, ‘Gũtirĩ riitho o na rĩmwe rĩngĩnyona,’</para>
  <para style="q2" vid="JOB 24:15">na gĩgaikara kĩĩhithĩte ũthiũ.<verse eid="JOB 24:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 24:16"/>Rĩrĩa kũrĩ nduma-rĩ, nĩguo andũ matuaga nyũmba,</para>
  <para style="q2" vid="JOB 24:16">no mũthenya magatinda mehingĩire;</para>
  <para style="q2" vid="JOB 24:16">matiendaga ũndũ wa ũtheri.<verse eid="JOB 24:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 24:17"/>Nĩgũkorwo andũ acio othe-rĩ, nduma ĩrĩa ndumanu nĩyo rũciinĩ rwao;</para>
  <para style="q2" vid="JOB 24:17">magĩaga ũrata na imakania cia nduma.<verse eid="JOB 24:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 24:18"/>“No rĩrĩ, o nĩ mũhũũyũ ũrĩa ũrerete igũrũ rĩa maaĩ;</para>
  <para style="q2" vid="JOB 24:18">igai rĩao bũrũri-inĩ nĩ irume,</para>
  <para style="q2" vid="JOB 24:18">na nĩ ũndũ ũcio gũtirĩ mũndũ ũthiiaga mĩgũnda-inĩ ya mĩthabibũ.<verse eid="JOB 24:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 24:19"/>O ta ũrĩa riũa na ũrugarĩ iniinaga maaĩ ma tharunji-rĩ,</para>
  <para style="q2" vid="JOB 24:19">ũguo noguo mbĩrĩra ĩhuragia arĩa mehĩtie.<verse eid="JOB 24:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 24:20"/>Nayo nda ĩrĩa yamaciarire ĩkariganĩrwo nĩo,</para>
  <para style="q2" vid="JOB 24:20">igunyũ nacio ikamarĩa;</para>
  <para style="q1" vid="JOB 24:20">andũ arĩa aaganu maticookaga kũririkanwo,</para>
  <para style="q2" vid="JOB 24:20">no moinangagwo ta mũtĩ.<verse eid="JOB 24:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 24:21"/>Marĩĩaga indo cia mũtumia thaata na ũrĩa ũtarĩ kaana,</para>
  <para style="q2" vid="JOB 24:21">na matiiguagĩra mũtumia wa ndigwa tha.<verse eid="JOB 24:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 24:22"/>No Ngai, nĩ ũndũ wa ũhoti wake, nĩakururagia arĩa marĩ hinya;</para>
  <para style="q2" vid="JOB 24:22">o na mangĩĩhaanda wega-rĩ, matirĩ na mwĩhoko atĩ nĩmagatũũra muoyo.<verse eid="JOB 24:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 24:23"/>We no ametĩkĩrie maikare mahurũkĩte makĩĩiguaga ta matarĩ na ũgwati,</para>
  <para style="q2" vid="JOB 24:23">no maitho make nĩmacũthagĩrĩria njĩra ciao.<verse eid="JOB 24:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 24:24"/>Nĩgũkorwo matũũgagĩrio o kahinda kanini, magacooka makeehera;</para>
  <para style="q2" vid="JOB 24:24">maikũrũkagio na magakua o ta andũ arĩa angĩ othe;</para>
  <para style="q2" vid="JOB 24:24">makeeheragio o ta igira cia ngano.<verse eid="JOB 24:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 24:25"/>“Akorwo ũguo tiguo gũtariĩ-rĩ, nũũ ũngĩonania atĩ nĩndaheenania,</para>
  <para style="q2" vid="JOB 24:25">na agĩtue ciugo ciakwa cia tũhũ?”<verse eid="JOB 24:25"/></para>
  <chapter eid="JOB 24"/>
  <chapter number="25" style="c" sid="JOB 25"/>
  <para style="s1">Mĩario ya Bilidadi</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 25:1"/>Nake Bilidadi ũrĩa Mũshuhi agĩcookia atĩrĩ:<verse eid="JOB 25:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 25:2"/>“Wathani na gwĩtigĩrwo nĩ cia Ngai;</para>
  <para style="q2" vid="JOB 25:2">nĩwe ũhaandaga watho kũu igũrũ o igũrũ mũno.<verse eid="JOB 25:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 25:3"/>Mbũtũ ciake no itarĩke?</para>
  <para style="q2" vid="JOB 25:3">Nũũ ũtaaragĩrwo nĩ ũtheri wake?<verse eid="JOB 25:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 25:4"/>Mũndũ aakĩhota atĩa gũkorwo arĩ mũthingu mbere ya Mũrungu?</para>
  <para style="q2" vid="JOB 25:4">Mũndũ ũciarĩtwo nĩ mũndũ-wa-nja-rĩ, akĩhota atĩa gũtuĩka mũtheru?<verse eid="JOB 25:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 25:5"/>Angĩkorwo o na mweri ti mũcangararu,</para>
  <para style="q2" vid="JOB 25:5">na njata ti theru maitho-inĩ make-rĩ,<verse eid="JOB 25:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 25:6"/>mũndũ na no ta kĩgunyũ, o we mũrũ wa mũndũ-rĩ,</para>
  <para style="q2" vid="JOB 25:6">ndakĩrĩ mũnyiihĩre mũno makĩrĩa!”<verse eid="JOB 25:6"/></para>
  <chapter eid="JOB 25"/>
  <chapter number="26" style="c" sid="JOB 26"/>
  <para style="s1">Mĩario ya Ayubu</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 26:1"/>Ningĩ Ayubu agĩcookia atĩrĩ:<verse eid="JOB 26:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 26:2"/>“Kaĩ ũrĩ gũteithia ũrĩa ũtarĩ na ũhoti-ĩ!</para>
  <para style="q2" vid="JOB 26:2">Kaĩ ũrĩ kũhonokia guoko kũrĩa gũtarĩ na hinya-ĩ!<verse eid="JOB 26:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 26:3"/>Kaĩ ũrĩ gũtaara mũndũ ũtarĩ na ũũgĩ-ĩ!</para>
  <para style="q2" vid="JOB 26:3">Na atĩrĩ, kaĩ nĩwonanĩtie ũmenyo mũnene-ĩ!<verse eid="JOB 26:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 26:4"/>Nũũ wagũteithia kwaria ciugo icio?</para>
  <para style="q2" vid="JOB 26:4">Na nĩ roho waũ waria na kanua gaku?<verse eid="JOB 26:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 26:5"/>“Arĩa akuũ marĩ na ruo rũnene,</para>
  <para style="q2" vid="JOB 26:5">o acio marĩ rungu rwa maaĩ na kĩrĩa gĩothe gĩtũũraga kuo.<verse eid="JOB 26:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 26:6"/>Gĩkuũ nĩkĩguũranie mbere ya Ngai;</para>
  <para style="q2" vid="JOB 26:6">mwanangĩko ũikarĩte ũtarĩ mũhumbĩre.<verse eid="JOB 26:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 26:7"/>Atambũrũkagia matu ma mwena wa gathigathini igũrũ rĩa kũndũ gũtarĩ kĩndũ;</para>
  <para style="q2" vid="JOB 26:7">nayo thĩ ndarĩ kĩndũ amĩcunjurĩtie nakĩo.<verse eid="JOB 26:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 26:8"/>Athayaga maaĩ thĩinĩ wa matu make,</para>
  <para style="q2" vid="JOB 26:8">no matu macio matingĩtembũrwo nĩ ũritũ wamo.<verse eid="JOB 26:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 26:9"/>Ahumbagĩra ũthiũ wa mweri rĩrĩa waiganana,</para>
  <para style="q2" vid="JOB 26:9">agatambũrũkia matu make igũrũ rĩaguo.<verse eid="JOB 26:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 26:10"/>Nĩekĩrĩte rũkiriri igũrũ rĩa maaĩ,</para>
  <para style="q2" vid="JOB 26:10">rũkahakania ũtheri na nduma.<verse eid="JOB 26:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 26:11"/>Itugĩ iria itiirĩrĩire igũrũ nĩ ithingithaga,</para>
  <para style="q2" vid="JOB 26:11">ikagegearaga nĩ ũndũ wa ikũũmana rĩake.<verse eid="JOB 26:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 26:12"/>Nĩoirugire maaĩ ma iria na ũndũ wa hinya wake;</para>
  <para style="q2" vid="JOB 26:12">na nĩ ũndũ wa ũũgĩ wake nĩatinaangirie Rahabu tũcunjĩ.<verse eid="JOB 26:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 26:13"/>Mĩhũmũ yake nĩyo yathakaririe igũrũ;</para>
  <para style="q2" vid="JOB 26:13">guoko gwake nĩ gwatheecire nyoka ĩrĩa ĩnyororokaga na ihenya.<verse eid="JOB 26:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 26:14"/>Atĩrĩrĩ, ĩno no mĩthia ya mawĩra make;</para>
  <para style="q2" vid="JOB 26:14">kaĩ no kamũheehũ kanini tũiguaga ka ũhoro wake-ĩ!</para>
  <para style="q2" vid="JOB 26:14">Nũũ ũngĩgĩtaũkĩrwo nĩ marurumĩ ma ũhoti wake?”<verse eid="JOB 26:14"/></para>
  <chapter eid="JOB 26"/>
  <chapter number="27" style="c" sid="JOB 27"/>
  <para style="p">
    <verse number="1" style="v" sid="JOB 27:1"/>Nake Ayubu agĩthiĩ na mbere na mĩario yake, akiuga atĩrĩ:<verse eid="JOB 27:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 27:2"/>“Ti-itherũ o ta ũrĩa Mũrungu atũũraga muoyo, o we ũnyimĩte kĩhooto,</para>
  <para style="q2" vid="JOB 27:2">ũcio Mwene-Hinya-Wothe, ũrĩa ũtũmĩte ngĩe na ũrũrũ ngoro-inĩ-rĩ,<verse eid="JOB 27:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 27:3"/>hĩndĩ ĩrĩa yothe niĩ ngũtũũra muoyo,</para>
  <para style="q2" vid="JOB 27:3">nayo mĩhũmũ ya Ngai ĩrĩ maniũrũ-inĩ makwa,<verse eid="JOB 27:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 27:4"/>mĩromo yakwa ndĩkaaria maũndũ ma waganu,</para>
  <para style="q2" vid="JOB 27:4">na rũrĩmĩ rwakwa rũtikaaria maheeni.<verse eid="JOB 27:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 27:5"/>Niĩ ndigetĩkĩra atĩ nĩ inyuĩ mũrĩ na kĩhooto;</para>
  <para style="q2" vid="JOB 27:5">nginya rĩrĩa ngaakua, ndigakaana ũkindĩrĩku wakwa.<verse eid="JOB 27:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 27:6"/>Nĩngũtũũria ũthingu wakwa na ndikaũrekia;</para>
  <para style="q2" vid="JOB 27:6">thamiri yakwa ndĩkanjiirithia rĩrĩa rĩothe ngũtũũra muoyo.<verse eid="JOB 27:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 27:7"/>“Thũ ciakwa irogĩtuĩka ta arĩa aaganu,</para>
  <para style="q2" vid="JOB 27:7">arĩa marĩ muku na niĩ marotuĩka ta arĩa matarĩ kĩhooto!<verse eid="JOB 27:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 27:8"/>Tondũ-rĩ, kĩĩrĩgĩrĩro kĩa ũrĩa ũtarĩ mwĩtigĩri Ngai gĩkĩrĩ kĩrĩkũ akua,</para>
  <para style="q2" vid="JOB 27:8">hĩndĩ ĩrĩa Ngai ooya muoyo wake?<verse eid="JOB 27:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 27:9"/>Mũrungu nĩakĩiguaga gũkaya gwake</para>
  <para style="q2" vid="JOB 27:9">rĩrĩa akorwo nĩ mĩnyamaro?<verse eid="JOB 27:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 27:10"/>Nĩakenagĩra ũcio Mwene-Hinya-Wothe?</para>
  <para style="q2" vid="JOB 27:10">Nĩakayagĩra Ngai mahinda mothe?<verse eid="JOB 27:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 27:11"/>“Nĩngũmũruta ũhoro wĩgiĩ ũhoti wa Mũrungu;</para>
  <para style="q2" vid="JOB 27:11">ndikũhitha njĩra cia Mwene-Hinya-Wothe.<verse eid="JOB 27:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 27:12"/>Inyuothe nĩmwĩoneire maũndũ macio.</para>
  <para style="q2" vid="JOB 27:12">Ĩkĩrĩ yakĩ mĩario ĩno ĩtarĩ kĩene?<verse eid="JOB 27:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 27:13"/>“Ũũ nĩguo Mũrungu aathagĩrĩria arĩa aaganu,</para>
  <para style="q2" vid="JOB 27:13">na nĩrĩo igai rĩrĩa mũndũ ũrĩa ũtarĩ tha aamũkagĩra kuuma kũrĩ Mwene-Hinya-Wothe:<verse eid="JOB 27:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 27:14"/>O na ciana ciake ciaingĩha atĩa, ciathĩrĩirio rũhiũ rwa njora;</para>
  <para style="q2" vid="JOB 27:14">rũciaro rwake rũtikoona irio cia kũrũigana.<verse eid="JOB 27:14"/></para>
  <para style="q2">
    <verse number="15" style="v" sid="JOB 27:15"/>Mũthiro nĩguo ũkaaninũkia arĩa agaatiga thuutha wake,</para>
  <para style="q2" vid="JOB 27:15">na atumia ao a ndigwa matikamarĩrĩra.<verse eid="JOB 27:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 27:16"/>O na angĩonganĩrĩria betha ta rũkũngũ,</para>
  <para style="q2" vid="JOB 27:16">na agĩe na nguo nyingĩ ta hĩba cia rĩũmba,<verse eid="JOB 27:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 27:17"/>kĩrĩa egũcookanĩrĩria gĩkehumbwo nĩ ũrĩa mũthingu,</para>
  <para style="q2" vid="JOB 27:17">na arĩa matarĩ mahĩtia nĩo makaagayana betha yake.<verse eid="JOB 27:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 27:18"/>Nyũmba ĩrĩa aakaga no ta nyũmba ya kĩĩhuruta,</para>
  <para style="q2" vid="JOB 27:18">ningĩ no ta gĩthũnũ gĩakĩtwo nĩ mũrangĩri.<verse eid="JOB 27:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 27:19"/>Agaakoma arĩ mũtongu, no ndagacooka gwĩka ũguo rĩngĩ;</para>
  <para style="q2" vid="JOB 27:19">akaahingũra maitho akore gũtirĩ kĩndũ arĩ nakĩo.<verse eid="JOB 27:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 27:20"/>Imakania imũkoragĩrĩra ta mũiyũro wa maaĩ;</para>
  <para style="q2" vid="JOB 27:20">kĩhuhũkanio gĩkaamũhuria ũtukũ.<verse eid="JOB 27:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 27:21"/>Rũhuho rwa mwena wa Irathĩro rũmuoyaga akabuĩria;</para>
  <para style="q2" vid="JOB 27:21">rũmweheragia kũrĩa atũũraga.<verse eid="JOB 27:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 27:22"/>Rũmũhurutaga rũtarĩ na tha</para>
  <para style="q2" vid="JOB 27:22">o rĩrĩa aroorĩra hinya waruo.<verse eid="JOB 27:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 27:23"/>Rũhũũraga hĩ rũkamũkenerera,</para>
  <para style="q2" vid="JOB 27:23">na rũkagamba ta nyoka rũkamũruta kũrĩa atũũraga.”<verse eid="JOB 27:23"/></para>
  <chapter eid="JOB 27"/>
  <chapter number="28" style="c" sid="JOB 28"/>
  <para style="q1">
    <verse number="1" style="v" sid="JOB 28:1"/>“Nĩ kũrĩ handũ harĩa betha yenjagwo</para>
  <para style="q2" vid="JOB 28:1">o na nĩ harĩ handũ harĩa thahabu ĩtheragĩrio.<verse eid="JOB 28:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 28:2"/>Kĩgera kĩrutagwo kuuma tĩĩri-inĩ,</para>
  <para style="q2" vid="JOB 28:2">nakĩo gĩcango kĩrutagwo mahiga-inĩ gĩgatwekio.<verse eid="JOB 28:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 28:3"/>Mũndũ nĩkũniina aniinaga nduma;</para>
  <para style="q2" vid="JOB 28:3">acaragia mahiga macio nginya kũrĩa kũriku mũno,</para>
  <para style="q2" vid="JOB 28:3">o kũu nduma ĩrĩ ndumanu mũno.<verse eid="JOB 28:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 28:4"/>Mũndũ atũrĩkagia irima thĩ kũraya na kũrĩa andũ matũũraga,</para>
  <para style="q2" vid="JOB 28:4">agakinya kũndũ kũrĩa mũndũ aariganĩirwo nĩgũthiiaga;</para>
  <para style="q2" vid="JOB 28:4">kũu kũraihanĩrĩirie na andũ nĩkuo acunjuuraga akĩereeraga.<note caller="+" style="f"><char style="fr" closed="false">28:4 </char><char style="ft" closed="false">Enji a marima magĩcaria tũhiga twa goro maikaragĩra itĩ ciacunjuuragio na mĩkanda.</char></note><verse eid="JOB 28:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 28:5"/>Thĩ nĩkuo kuumaga irio,</para>
  <para style="q2" vid="JOB 28:5">no na kũu thĩinĩ mũhuro kũgarũrũkĩte gũkahaana ta gũcinĩtwo na mwaki;<verse eid="JOB 28:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 28:6"/>mahiga-inĩ ma thĩ nĩkuo kuumaga yakuti ĩrĩa ya bururu,</para>
  <para style="q2" vid="JOB 28:6">na mũthanga wayo ũkoragwo na ngũmba cia thahabu.<verse eid="JOB 28:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 28:7"/>Gũtirĩ nyoni ndĩa-nyama yũĩ gacĩra kau kahithe,</para>
  <para style="q2" vid="JOB 28:7">na gatirĩ konwo nĩ riitho rĩa hũngũ.<verse eid="JOB 28:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 28:8"/>Nyamũ iria ciĩtĩĩaga itirĩ ciagathiĩra,</para>
  <para style="q2" vid="JOB 28:8">o na gũtirĩ mũrũũthi ũkageragĩra.<verse eid="JOB 28:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 28:9"/>Guoko kwa mũndũ gũtharĩkagĩra gũkanyiita ihiga rĩa nyaigĩ,</para>
  <para style="q2" vid="JOB 28:9">na gũkaguũria itina cia irĩma.<verse eid="JOB 28:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 28:10"/>Enjaga mungu ũgatũrĩkia rwaro rwa ihiga;</para>
  <para style="q2" vid="JOB 28:10">maitho make makĩonaga igĩĩna ciaruo ciothe.<verse eid="JOB 28:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 28:11"/>Ethaga itwe cia njũũĩ,</para>
  <para style="q2" vid="JOB 28:11">na indo iria hithe agaciumĩria ũtheri-inĩ.<verse eid="JOB 28:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 28:12"/>“No ũũgĩ-rĩ, ũngĩoneka kũ?</para>
  <para style="q2" vid="JOB 28:12">Ũmenyo ũtũũraga kũ?<verse eid="JOB 28:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 28:13"/>Mũndũ ndangĩmenya thogora wa ũũgĩ;</para>
  <para style="q2" vid="JOB 28:13">ndũngĩoneka bũrũri wa arĩa marĩ muoyo.<verse eid="JOB 28:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 28:14"/>Kũrĩa kũriku mũno kuugaga atĩrĩ, ‘Ndũrĩ thĩinĩ wakwa’;</para>
  <para style="q2" vid="JOB 28:14">narĩo iria rĩkoiga atĩrĩ, ‘Ndũrĩ gũkũ gwakwa.’<verse eid="JOB 28:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 28:15"/>Ndũngĩgũrĩka na thahabu ĩrĩa therie mũno,</para>
  <para style="q2" vid="JOB 28:15">kana thogora waguo ũthimwo na betha.<verse eid="JOB 28:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 28:16"/>Ndũngĩgũrĩka na thahabu ya Ofiri,</para>
  <para style="q2" vid="JOB 28:16">kana ũgũrĩke na onigithi ĩrĩa ĩrĩ goro mũno,</para>
  <para style="q2" vid="JOB 28:16">o na kana yakuti ĩrĩa ya bururu.<verse eid="JOB 28:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 28:17"/>Thahabu kana icicio-rĩ, itingĩhota kũgerekanio naguo;</para>
  <para style="q2" vid="JOB 28:17">o na kana ũkũũranio na mathaga ma thahabu.<verse eid="JOB 28:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 28:18"/>Maricani kana ngenyekenyi iria cia goro itiagĩrĩire kũgwetanio naguo;</para>
  <para style="q2" vid="JOB 28:18">thogora wa ũũgĩ ũkĩrĩte wa ruru ĩrĩa ndune.<verse eid="JOB 28:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 28:19"/>Yakuti ya Kushi ndĩngĩigananio naguo;</para>
  <para style="q2" vid="JOB 28:19">o na ndũngĩgũrĩka na thahabu ĩrĩa therie mũno.<verse eid="JOB 28:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 28:20"/>“Hakĩrĩ ũguo-rĩ, ũũgĩ ũngĩkiuma nakũ?</para>
  <para style="q2" vid="JOB 28:20">Ũmenyo ũtũũraga kũ?<verse eid="JOB 28:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 28:21"/>Nĩmũhithe kũrĩ maitho ma ciũmbe ciothe iria itũũraga muoyo,</para>
  <para style="q2" vid="JOB 28:21">ũkahithwo o na nyoni cia rĩera-inĩ.<verse eid="JOB 28:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 28:22"/>Mwanangĩko na gĩkuũ ciugaga atĩrĩ,</para>
  <para style="q2" vid="JOB 28:22">‘No mũhuhu waguo ũkinyĩte matũ-inĩ maitũ.’<verse eid="JOB 28:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 28:23"/>Ngai nĩooĩ njĩra ya gũthiĩ kũrĩa ũrĩ,</para>
  <para style="q2" vid="JOB 28:23">na nowe wiki ũũĩ kũrĩa ũtũũraga,<verse eid="JOB 28:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 28:24"/>nĩgũkorwo nĩonaga mũthia wa thĩ,</para>
  <para style="q2" vid="JOB 28:24">na nĩonaga maũndũ marĩa mothe marĩ rungu rwa igũrũ.<verse eid="JOB 28:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 28:25"/>Rĩrĩa aathimĩire rũhuho nditi yaruo,</para>
  <para style="q2" vid="JOB 28:25">o na agĩthima maaĩ-rĩ,<verse eid="JOB 28:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 28:26"/>rĩrĩa aarutĩire mbura watho ĩrũmagĩrĩre,</para>
  <para style="q2" vid="JOB 28:26">na agĩtemera rũheni na marurumĩ njĩra-rĩ,<verse eid="JOB 28:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 28:27"/>nake nĩonire ũũgĩ na akĩũthima;</para>
  <para style="q2" vid="JOB 28:27">aũrũmirie na akĩũthuthuuria.<verse eid="JOB 28:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 28:28"/>Agĩcooka akĩĩra andũ atĩrĩ,</para>
  <para style="q2" vid="JOB 28:28">‘Gwĩtigĩra Mwathani-rĩ, ũcio nĩguo ũũgĩ,</para>
  <para style="q2" vid="JOB 28:28">Nakuo gũtheemaga ũũru nĩ ũmenyo.’ ”<verse eid="JOB 28:28"/></para>
  <chapter eid="JOB 28"/>
  <chapter number="29" style="c" sid="JOB 29"/>
  <para style="p">
    <verse number="1" style="v" sid="JOB 29:1"/>Ningĩ Ayubu nĩathiire na mbere kwaria, akiuga atĩrĩ:<verse eid="JOB 29:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 29:2"/>“Naarĩ korwo no haane ũrĩa ndaatariĩ mĩeri ĩrĩa ya tene,</para>
  <para style="q2" vid="JOB 29:2">matukũ-inĩ marĩa Ngai aamenyagĩrĩra,<verse eid="JOB 29:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 29:3"/>rĩrĩa tawa wake wamũrĩkaga igũrũ rĩa mũtwe wakwa,</para>
  <para style="q2" vid="JOB 29:3">na ũndũ wa ũtheri wake ngatuĩkanagĩria nduma-inĩ!<verse eid="JOB 29:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 29:4"/>Korwo ndariĩ ũrĩa ndatariĩ matukũ-inĩ marĩa ndagaacĩire biũ,</para>
  <para style="q2" vid="JOB 29:4">hĩndĩ ĩrĩa kuumĩrania ngoro na Ngai kwarathimaga nyũmba yakwa,<verse eid="JOB 29:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 29:5"/>rĩrĩa Mwene-Hinya-Wothe aarĩ hamwe na niĩ,</para>
  <para style="q2" vid="JOB 29:5">nacio ciana ciakwa ikandigiicĩria,<verse eid="JOB 29:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 29:6"/>rĩrĩa gacĩra gakwa kaihũgĩtio nĩ kĩrimũ kĩa iria,</para>
  <para style="q2" vid="JOB 29:6">naruo rwaro rwa ihiga rũgaatherũkagĩra tũrũũĩ twa maguta ma mũtamaiyũ!<verse eid="JOB 29:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 29:7"/>“Rĩrĩa ndaathiiaga kĩhingo-inĩ kĩa itũũra inene,</para>
  <para style="q2" vid="JOB 29:7">na ngaikarĩra gĩtĩ gĩakwa hau kĩaraho-inĩ-rĩ,<verse eid="JOB 29:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 29:8"/>aanake maanyonaga makeehera,</para>
  <para style="q2" vid="JOB 29:8">nao athuuri makarũgama,<verse eid="JOB 29:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 29:9"/>andũ arĩa anene maatigaga kwaria,</para>
  <para style="q2" vid="JOB 29:9">makahumbĩra tũnua twao na moko;<verse eid="JOB 29:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 29:10"/>mĩgambo ya andũ arĩa marĩ igweta ĩgakirio,</para>
  <para style="q2" vid="JOB 29:10">nacio nĩmĩ ciao ikanyiitana na karakara.<verse eid="JOB 29:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 29:11"/>Ũrĩa wothe wanjiguaga ngĩaria aaragia wega igũrũ rĩakwa,</para>
  <para style="q2" vid="JOB 29:11">nao arĩa maanyonaga makangaathĩrĩria,<verse eid="JOB 29:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 29:12"/>nĩ ũndũ nĩndahatũraga arĩa athĩĩni maakaya mateithio,</para>
  <para style="q2" vid="JOB 29:12">o na arĩa mataarĩ na maithe maagĩte mũndũ wa kũmateithia.<verse eid="JOB 29:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 29:13"/>Mũndũ agĩkua nĩandaathimaga;</para>
  <para style="q2" vid="JOB 29:13">nĩndatũmaga ngoro ya mũtumia wa ndigwa ĩine.<verse eid="JOB 29:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 29:14"/>Ndehumbaga ũthingu ta nguo;</para>
  <para style="q2" vid="JOB 29:14">ciira wa kĩhooto nĩguo warĩ nguo yakwa ya igũrũ, o na kĩremba gĩakwa.<verse eid="JOB 29:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 29:15"/>Nĩ niĩ ndaarĩ maitho ma arĩa atumumu,</para>
  <para style="q2" vid="JOB 29:15">na magũrũ ma arĩa ithua.<verse eid="JOB 29:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 29:16"/>Ndaarĩ ithe wa arĩa abatari;</para>
  <para style="q2" vid="JOB 29:16">nĩndaciiragĩrĩra o na mũndũ itooĩ.<verse eid="JOB 29:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 29:17"/>Ningĩ nĩndoinangaga magego ma arĩa aaganu,</para>
  <para style="q2" vid="JOB 29:17">na ngahuria arĩa maarĩ magego-inĩ mao.<verse eid="JOB 29:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 29:18"/>“Ndeciiragia atĩrĩ, ‘Niĩ ngaakuĩra gwakwa nyũmba,</para>
  <para style="q2" vid="JOB 29:18">matukũ makwa marĩ maingĩ ta mũthanga.<verse eid="JOB 29:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 29:19"/>Mĩri yakwa ĩgataamba ĩkinye maaĩ-inĩ,</para>
  <para style="q2" vid="JOB 29:19">narĩo ireera rĩkoragwo honge-inĩ ciakwa ũtukũ wothe.<verse eid="JOB 29:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 29:20"/>Riiri wakwa ũgũtũũra werũhagio thĩinĩ wakwa,</para>
  <para style="q2" vid="JOB 29:20">naguo ũta wakwa ũtũũre ũrĩ mwerũ guoko-inĩ gwakwa.’<verse eid="JOB 29:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 29:21"/>“Andũ maathikagĩrĩria marĩ na kĩĩrĩgĩrĩro,</para>
  <para style="q2" vid="JOB 29:21">meetagĩrĩra kĩrĩra gĩakwa makirĩte.<verse eid="JOB 29:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 29:22"/>Ndaarĩkia kwaria-rĩ, matiacookaga kwaria;</para>
  <para style="q2" vid="JOB 29:22">ciugo ciakwa ciatoonyaga matũ mao kahora ihooreire.<verse eid="JOB 29:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 29:23"/>Maanjetagĩrĩra ta andũ metereire mbura,</para>
  <para style="q2" vid="JOB 29:23">na makanyua ciugo ciakwa o ta mbura ĩrĩa ya kũrigĩrĩria.<verse eid="JOB 29:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 29:24"/>Ndaamathekathekagia moorĩtwo nĩ hinya makaaga gwĩtĩkia;</para>
  <para style="q2" vid="JOB 29:24">ũtheri wa ũthiũ wakwa warĩ wa bata mũno kũrĩ o.<verse eid="JOB 29:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 29:25"/>Nĩ niĩ ndamoonagia njĩra, ngaikaraga ta ndĩ mũnene wao;</para>
  <para style="q2" vid="JOB 29:25">ndatũũraga ta mũthamaki arĩ gatagatĩ ga ita rĩake;</para>
  <para style="q2" vid="JOB 29:25">ningĩ ndaatariĩ ta mũndũ ũrĩa ũhooragĩria arĩa maracakaya.<verse eid="JOB 29:25"/></para>
  <para style="b"/>
  <chapter eid="JOB 29"/>
  <chapter number="30" style="c" sid="JOB 30"/>
  <para style="q1">
    <verse number="1" style="v" sid="JOB 30:1"/>“No rĩu-rĩ, andũ ethĩ kũngĩra nĩmaanyũrũragia,</para>
  <para style="q2" vid="JOB 30:1">arĩa o na itangĩendire gũturanĩra maithe mao</para>
  <para style="q2" vid="JOB 30:1">na ngui ciakwa cia rũũru.<verse eid="JOB 30:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 30:2"/>Hinya wa moko mao ũngĩangʼunire nakĩ,</para>
  <para style="q2" vid="JOB 30:2">kuona atĩ hinya wao nĩwamehereire?<verse eid="JOB 30:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 30:3"/>Nĩmathĩnĩkĩte nĩ ũndũ wa wagi na ngʼaragu,</para>
  <para style="q2" vid="JOB 30:3">ũtukũ-rĩ, moorũũraga bũrũri mũngʼaru,</para>
  <para style="q2" vid="JOB 30:3">bũrũri mwanangĩku ũkirĩte ihooru.<verse eid="JOB 30:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 30:4"/>Maahaaraga nyeni cia mahuti ma cumbĩ kuuma ihinga-inĩ,</para>
  <para style="q2" vid="JOB 30:4">na irio ciao ciarĩ mĩri ya mũtĩ wa kĩhaato.<verse eid="JOB 30:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 30:5"/>Nĩmaingatirwo kuuma kũrĩ mũingĩ,</para>
  <para style="q2" vid="JOB 30:5">makiugĩrĩrio ta maarĩ aici.<verse eid="JOB 30:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 30:6"/>Nĩmahatĩrĩirio maikarage mĩkuru-inĩ ya tũrũũĩ tũhũu,</para>
  <para style="q2" vid="JOB 30:6">kũu ndwaro-inĩ cia mahiga na marima-inĩ marĩa marĩ thĩ.<verse eid="JOB 30:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 30:7"/>Maanagia ta nyamũ kũu ihinga-inĩ,</para>
  <para style="q2" vid="JOB 30:7">makahatĩkanagĩra kũu mahuti-inĩ.<verse eid="JOB 30:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 30:8"/>Rũciaro rũtarĩ kĩene na rũtarĩ rĩĩtwa,</para>
  <para style="q2" vid="JOB 30:8">nĩ rwarutũrũrirwo ruume kũu bũrũri-inĩ.<verse eid="JOB 30:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 30:9"/>“Na rĩu ariũ ao maraanyũrũria na rwĩmbo;</para>
  <para style="q2" vid="JOB 30:9">ngagĩtuĩka wa kuunagwo thimo nĩo.<verse eid="JOB 30:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 30:10"/>Nĩmathũire na magaikaraga haraihu na niĩ;</para>
  <para style="q2" vid="JOB 30:10">matiĩtigagĩra kũnduĩra mata ũthiũ.<verse eid="JOB 30:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 30:11"/>Nĩ ũndũ rĩu Ngai nĩaregeretie ũta wakwa,</para>
  <para style="q2" vid="JOB 30:11">na akandeehera mathĩĩna-rĩ,</para>
  <para style="q2" vid="JOB 30:11">matirĩ ũndũ merigagĩrĩria gwĩka marĩ harĩa ndĩ.<verse eid="JOB 30:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 30:12"/>Mwena wakwa wa ũrĩo kũrĩ rũrĩrĩ rũratharĩkĩra;</para>
  <para style="q2" vid="JOB 30:12">maigagĩra magũrũ makwa mĩtego,</para>
  <para style="q2" vid="JOB 30:12">na magaaka ihumbu ciao cia gũũtharĩkĩra.<verse eid="JOB 30:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 30:13"/>Maharaganagia njĩra yakwa;</para>
  <para style="q2" vid="JOB 30:13">mahotaga kũnyũnũha o na gũtarĩ na mũndũ ũramateithia.<verse eid="JOB 30:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 30:14"/>Mokĩte ta matoonyeire mwanya-inĩ mwariĩ;</para>
  <para style="q2" vid="JOB 30:14">mokĩire gatagatĩ ga kũu kwanangĩku, makaamomokera.<verse eid="JOB 30:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 30:15"/>Imakania nĩcihootete;</para>
  <para style="q2" vid="JOB 30:15">gĩtĩĩo gĩakwa kĩũmbũrĩtwo ta kĩhurutĩtwo nĩ rũhuho,</para>
  <para style="q2" vid="JOB 30:15">naguo ũgitĩri wakwa ũkabuĩria ta itu.<verse eid="JOB 30:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 30:16"/>“Na rĩu muoyo wakwa nĩũrathirĩrĩkĩra;</para>
  <para style="q2" vid="JOB 30:16">matukũ ma thĩĩna nĩmanyiitĩte.<verse eid="JOB 30:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 30:17"/>Ũtukũ ũtheecangaga mahĩndĩ makwa;</para>
  <para style="q2" vid="JOB 30:17">ruo rwa gũthegenya rũtindigithagĩria.<verse eid="JOB 30:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 30:18"/>Ngai angũnjakũnjaga ta nguo na ũndũ wa ũhoti wake mũnene;</para>
  <para style="q2" vid="JOB 30:18">aanyiitaga ta kanjũ yakwa ngingo-inĩ.<verse eid="JOB 30:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 30:19"/>Anjikĩtie ndoro-inĩ,</para>
  <para style="q2" vid="JOB 30:19">ngatuĩka ta rũkũngũ na ta mũhu.<verse eid="JOB 30:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 30:20"/>“Nĩwe ndĩrakaĩra, o Wee Ngai, no ndũranjĩtĩka;</para>
  <para style="q2" vid="JOB 30:20">ndĩrarũgama, no wee no kũndora ũrandora.<verse eid="JOB 30:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 30:21"/>Wee nĩũngarũrũkĩte ũtarĩ na tha;</para>
  <para style="q2" vid="JOB 30:21">ũtharĩkĩire na hinya wa guoko gwaku.<verse eid="JOB 30:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 30:22"/>Nĩũũhurĩtie, ũkaandindĩka mbere ya rũhuho;</para>
  <para style="q2" vid="JOB 30:22">ũũnyugutanĩtie kĩhuhũkanio-inĩ.<verse eid="JOB 30:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 30:23"/>Nĩnjũũĩ nĩũkanginyia o gĩkuũ-inĩ,</para>
  <para style="q2" vid="JOB 30:23">ũndware kũrĩa gwathĩrĩirwo arĩa othe marĩ muoyo.<verse eid="JOB 30:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 30:24"/>“Ti-itherũ gũtirĩ mũndũ ũũkagĩrĩra mũndũ ũthuthĩkĩte ngoro,</para>
  <para style="q2" vid="JOB 30:24">hĩndĩ ĩrĩa egũkaya ateithio arĩ mĩnyamaro-inĩ.<verse eid="JOB 30:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 30:25"/>Niĩ-rĩ, githĩ ndianarĩrio nĩ arĩa marĩ na thĩĩna?</para>
  <para style="q2" vid="JOB 30:25">Githĩ ngoro yakwa ndĩanaiguĩra arĩa athĩĩni kĩeha?<verse eid="JOB 30:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 30:26"/>No rĩrĩ, rĩrĩa ndeerĩgagĩrĩra wega, ũũru ũgĩũka;</para>
  <para style="q2" vid="JOB 30:26">rĩrĩa ndaacaragia ũtheri-rĩ, hĩndĩ ĩyo nduma ĩgĩũka.<verse eid="JOB 30:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 30:27"/>Nda yakwa ndĩtigaga kũruruma;</para>
  <para style="q2" vid="JOB 30:27">matukũ ma thĩĩna nĩmanginyĩire.<verse eid="JOB 30:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 30:28"/>Thiiaga njirĩte biũ, no ti ũndũ wa kũhĩa nĩ riũa;</para>
  <para style="q2" vid="JOB 30:28">ngarũgama kĩũngano-inĩ ngakaya ndeithio.<verse eid="JOB 30:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 30:29"/>Nduĩkĩte mũrũ wa nyina na mbwe,</para>
  <para style="q2" vid="JOB 30:29">ngatuĩka mũthiritũ wa ndundu.<verse eid="JOB 30:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 30:30"/>Gĩkonde gĩakwa nĩkĩgarũrũkĩte, gĩgathita na gĩkoonũka;</para>
  <para style="q2" vid="JOB 30:30">mwĩrĩ wakwa ũhiũhĩte nĩ ũrugarĩ.<verse eid="JOB 30:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOB 30:31"/>Kĩnanda gĩakwa kĩa mũgeeto kĩrutaga o mũgambo wa gũcakaya,</para>
  <para style="q2" vid="JOB 30:31">naguo mũtũrirũ wakwa ũkaruta o mũgambo wa kĩrĩro.<verse eid="JOB 30:31"/></para>
  <para style="b"/>
  <chapter eid="JOB 30"/>
  <chapter number="31" style="c" sid="JOB 31"/>
  <para style="q1">
    <verse number="1" style="v" sid="JOB 31:1"/>“Niĩ nĩtwarĩĩkanĩire na maitho makwa</para>
  <para style="q2" vid="JOB 31:1">ndikanarore mũirĩtu ndĩmwĩrirĩrie.<verse eid="JOB 31:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 31:2"/>Nĩ ũndũ-rĩ, kaĩ rũgai rwa mũndũ kuuma igũrũ kwa Ngai rũkĩrĩ kĩĩ?</para>
  <para style="q2" vid="JOB 31:2">Igai rĩake nĩ rĩrĩkũ kuuma kũrĩ ũcio Mwene-Hinya-Wothe ũrĩ igũrũ?<verse eid="JOB 31:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 31:3"/>Githĩ ti kwanangwo kwa arĩa aaganu,</para>
  <para style="q2" vid="JOB 31:3">na mũtino kũrĩ arĩa meekaga maũndũ mooru?<verse eid="JOB 31:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 31:4"/>Githĩ we ndonaga njĩra ciakwa,</para>
  <para style="q2" vid="JOB 31:4">na agatara o ikinya o ikinya rĩakwa?<verse eid="JOB 31:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 31:5"/>“Ingĩkorwo thiiaga na njĩra itarĩ cia ma-rĩ,</para>
  <para style="q2" vid="JOB 31:5">kana kũgũrũ gwakwa gũkahiũha thiĩ ngaheenanie-rĩ,<verse eid="JOB 31:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 31:6"/>Ngai nĩathime na ratiri cia kĩhooto,</para>
  <para style="q2" vid="JOB 31:6">nake nĩekũmenya atĩ niĩ ndirĩ ũcuuke;<verse eid="JOB 31:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 31:7"/>makinya makwa mangĩkorwo nĩmahũkĩte makoima njĩra-inĩ,</para>
  <para style="q2" vid="JOB 31:7">nayo ngoro yakwa ĩngĩkorwo nĩĩtongoretio nĩ maitho makwa,</para>
  <para style="q2" vid="JOB 31:7">kana moko makwa makorwo nĩmathaahĩtio-rĩ,<verse eid="JOB 31:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 31:8"/>hĩndĩ ĩyo kĩrĩa haandĩte kĩrorĩĩo nĩ andũ angĩ,</para>
  <para style="q2" vid="JOB 31:8">nacio irio cia mĩgũnda yakwa iromunywo.<verse eid="JOB 31:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 31:9"/>“Ngoro yakwa ĩngĩkorwo yanaheenererio nĩ mũndũ-wa-nja,</para>
  <para style="q2" vid="JOB 31:9">kana ngorwo ndanaceema mũrango-inĩ wa mũndũ wa itũũra,<verse eid="JOB 31:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 31:10"/>hĩndĩ ĩyo mũtumia wakwa arothĩa ngano ya mũndũ ũngĩ,</para>
  <para style="q2" vid="JOB 31:10">na arũme angĩ tiga niĩ marokoma nake.<verse eid="JOB 31:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 31:11"/>Nĩgũkorwo ũndũ ũcio nĩ ũmaramari wa thoni,</para>
  <para style="q2" vid="JOB 31:11">na nĩ rĩĩhia rĩa gũtuĩrwo ciira nĩ kĩama.<verse eid="JOB 31:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 31:12"/>Tondũ ũcio nĩ mwaki ũrĩa ũcinaga nginya ũkaananga;</para>
  <para style="q2" vid="JOB 31:12">na nĩũngĩamunyĩte magetha makwa mothe.<verse eid="JOB 31:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 31:13"/>“Ingĩkorwo nĩnyimĩte ndungata ciakwa cia arũme na cia andũ-a-nja kĩhooto</para>
  <para style="q2" vid="JOB 31:13">rĩrĩa manateta nĩ ũndũ wakwa-rĩ,<verse eid="JOB 31:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 31:14"/>niĩ ngeeka atĩa rĩrĩa Mũrungu akaanjũkĩrĩra?</para>
  <para style="q2" vid="JOB 31:14">Ngaacookia atĩa rĩrĩa ngeetwo ndĩĩtetere ũhoro-inĩ ũcio?<verse eid="JOB 31:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 31:15"/>Githĩ ũcio wanyũũmbire kũu nda ya maitũ to we wamoombire?</para>
  <para style="q2" vid="JOB 31:15">Githĩ tiwe watũthondekire tũrĩ kũu nda cia aa maitũ?<verse eid="JOB 31:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 31:16"/>“Ingĩkorwo ndanaima athĩĩni kĩrĩa maanerirĩria,</para>
  <para style="q2" vid="JOB 31:16">kana ngareka maitho ma mũtũmia wa ndigwa morwo nĩ hinya-rĩ,<verse eid="JOB 31:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 31:17"/>ingĩkorwo ndĩĩaga irio ciakwa nyiki,</para>
  <para style="q2" vid="JOB 31:17">ngaaga kũgayana na ũrĩa ũtarĩ ithe-rĩ,<verse eid="JOB 31:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 31:18"/>(no niĩ kuuma ũnini wakwa, mwana ta ũcio ndaamũreraga o ta ũrĩa angĩarerirwo nĩ ithe,</para>
  <para style="q2" vid="JOB 31:18">na kuuma gũciarwo gwakwa ndũire ndongoragia mũtumia wa ndigwa)<verse eid="JOB 31:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 31:19"/>ingĩkorwo ndanoona mũndũ agĩkua nĩ ũndũ wa kwaga nguo,</para>
  <para style="q2" vid="JOB 31:19">kana ngoona mũndũ mũbatari atarĩ kĩndũ gĩa kwĩhumba,<verse eid="JOB 31:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 31:20"/>na ngoro yake ndĩandathimire nĩ ũndũ wa kũmũiguithia ũrugarĩ</para>
  <para style="q2" vid="JOB 31:20">na guoya wa ngʼondu ciakwa-rĩ,<verse eid="JOB 31:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 31:21"/>ingĩkorwo ndanoya guoko gwakwa ngookĩrĩra mwana ũtarĩ ithe,</para>
  <para style="q2" vid="JOB 31:21">nĩkũmenya atĩ no nyone wa kũndeithia kwagĩa ciira igooti-inĩ-rĩ,<verse eid="JOB 31:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 31:22"/>hĩndĩ ĩyo guoko gwakwa kũroahũkĩra kĩande-inĩ kũgwe,</para>
  <para style="q2" vid="JOB 31:22">kũroinĩkĩra o irũngo-inĩ.<verse eid="JOB 31:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 31:23"/>Nĩ ũndũ nĩndetigagĩra mwanangĩko uumĩte kũrĩ Mũrungu,</para>
  <para style="q2" vid="JOB 31:23">na nĩ ũndũ wa gwĩtigĩra riiri wake, ndingĩekire maũndũ ta macio.<verse eid="JOB 31:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 31:24"/>“Ingĩkorwo nĩnjigĩte mwĩhoko wakwa harĩ thahabu,</para>
  <para style="q2" vid="JOB 31:24">kana ngeera thahabu ĩrĩa therie mũno atĩrĩ, ‘Wee nĩwe ũgitĩri wakwa,’<verse eid="JOB 31:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 31:25"/>ingĩkorwo ndanakenera ũtonga wakwa mũnene,</para>
  <para style="q2" vid="JOB 31:25">kana ngakenera uumithio ũrĩa moko makwa mecarĩirie-rĩ,<verse eid="JOB 31:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 31:26"/>ingĩkorwo ndanarũmbũiya riũa rĩarĩte,</para>
  <para style="q2" vid="JOB 31:26">kana mweri ũgĩthiĩ ũcangararĩte,<verse eid="JOB 31:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 31:27"/>na ngoro yakwa ĩkĩheenererio nĩcio na hitho,</para>
  <para style="q2" vid="JOB 31:27">kana guoko gwakwa gũgĩcikinyĩria kĩmumunyano gĩa gũcitĩĩa-rĩ,<verse eid="JOB 31:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 31:28"/>o na macio mangĩtuĩka mehia ma gũtuĩrwo ciira,</para>
  <para style="q2" vid="JOB 31:28">nĩgũkorwo ingĩtuĩkĩte mũndũ ũtarĩ mwĩhokeku harĩ Mũrungu ũrĩa ũrĩ igũrũ.<verse eid="JOB 31:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 31:29"/>“Ingĩkorwo ndaanakena nĩ thũ yakwa kuona mũtino,</para>
  <para style="q2" vid="JOB 31:29">kana ngĩmĩthekerera rĩrĩa thĩĩna wamĩkora,<verse eid="JOB 31:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 31:30"/>no niĩ ndirĩ ndetĩkĩra kanua gakwa keehie</para>
  <para style="q2" vid="JOB 31:30">na ũndũ wa kũhoera muoyo wayo kĩrumi,<verse eid="JOB 31:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOB 31:31"/>kũngĩkorwo andũ a nyũmba yakwa matirĩ moiga atĩrĩ,</para>
  <para style="q2" vid="JOB 31:31">‘Nũũ ũtarĩ warĩa nyama cia Ayubu akahũũna?’<verse eid="JOB 31:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOB 31:32"/>no gũtirĩ mũgeni wanaraara njĩra-inĩ,</para>
  <para style="q2" vid="JOB 31:32">nĩ ũndũ mũrango wa mũciĩ wakwa ũtũire ũhingũrĩirwo mũgendi,<verse eid="JOB 31:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="JOB 31:33"/>ingĩkorwo ndaanahitha mehia makwa, ta ũrĩa andũ meekaga,</para>
  <para style="q2" vid="JOB 31:33">na ũndũ wa kũhitha mahĩtia ngoro-inĩ yakwa<verse eid="JOB 31:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="JOB 31:34"/>tondũ wa gwĩtigĩra kĩrĩndĩ,</para>
  <para style="q2" vid="JOB 31:34">o na gwĩtigĩra kũmenwo nĩ mĩhĩrĩga</para>
  <para style="q2" vid="JOB 31:34">ngagĩkira ki na ndiume nja-rĩ,<verse eid="JOB 31:34"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="35" style="v" sid="JOB 31:35"/>(“Naarĩ korwo ndaarĩ na mũndũ wa kũnjigua!</para>
  <para style="q2" vid="JOB 31:35">Rĩu nĩndekĩra rũũri rwa kwĩyarĩrĩria:</para>
  <para style="q2" vid="JOB 31:35">reke Mwene-Hinya-Wothe anjookerie ũhoro;</para>
  <para style="q2" vid="JOB 31:35">reke mũũthitangi andĩke marũa ma thitango yake.<verse eid="JOB 31:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="JOB 31:36"/>Ti-itherũ marũa macio ingĩmaigĩrĩra kĩande,</para>
  <para style="q2" vid="JOB 31:36">ndĩmehumbe taarĩ thũmbĩ.<verse eid="JOB 31:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="JOB 31:37"/>Njooke ndĩmũhe ũhoro wakwa ikinya gwa ikinya;</para>
  <para style="q2" vid="JOB 31:37">ndĩmũkuhĩrĩrie ta ndĩ mũnene.)<verse eid="JOB 31:37"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="38" style="v" sid="JOB 31:38"/>“Korwo mũgũnda wakwa wakaya, ũnjũkĩrĩre,</para>
  <para style="q2" vid="JOB 31:38">nayo mĩtaro yaguo yothe ĩkorwo ĩkĩrĩra maithori,<verse eid="JOB 31:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="JOB 31:39"/>ingĩkorwo ndanarĩa maciaro maguo iteekũrĩha,</para>
  <para style="q2" vid="JOB 31:39">kana ngoraga ngoro cia ene guo-rĩ,<verse eid="JOB 31:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="JOB 31:40"/>hĩndĩ ĩyo congʼe ũrokũra kuo handũ ha ngano,</para>
  <para style="q2" vid="JOB 31:40">na riya handũ ha cairi.”</para>
  <para style="p" vid="JOB 31:40">Ndeto cia Ayubu nĩciathira.<verse eid="JOB 31:40"/></para>
  <chapter eid="JOB 31"/>
  <chapter number="32" style="c" sid="JOB 32"/>
  <para style="s1">Mĩario ya Elihu</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 32:1"/>Nĩ ũndũ ũcio andũ acio atatũ nĩmatigire gũcookeria Ayubu, nĩ ũndũ eeyonaga arĩ mũthingu. <verse eid="JOB 32:1"/><verse number="2" style="v" sid="JOB 32:2"/>No rĩrĩ, Elihu mũrũ wa Barakeli ũrĩa Mũbuzi, wa nyũmba ya Ramu, nĩarakaririo mũno nĩ Ayubu nĩ ũndũ wa gwĩtua aarĩ na kĩhooto gũkĩra Ngai. <verse eid="JOB 32:2"/><verse number="3" style="v" sid="JOB 32:3"/>Ningĩ nĩarakarĩtio nĩ arata acio atatũ tondũ nĩmagĩte ũndũ mangĩcookeria Ayubu, o na gũtuĩka nĩmamũtuĩrĩire ciira. <verse eid="JOB 32:3"/><verse number="4" style="v" sid="JOB 32:4"/>Na rĩrĩ, Elihu aambĩte gweterera acio angĩ maarie atanaaria na Ayubu, tondũ o maarĩ akũrũ kũmũkĩra. <verse eid="JOB 32:4"/><verse number="5" style="v" sid="JOB 32:5"/>No rĩrĩa onire atĩ andũ acio atatũ matiarĩ na ũndũ ũngĩ wa kuuga-rĩ, agĩakanwo nĩ marakara.<verse eid="JOB 32:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JOB 32:6"/>Nĩ ũndũ ũcio Elihu, mũrũ wa Barakeli ũcio Mũbuzi, akiuga atĩrĩ:</para>
  <para style="q1" vid="JOB 32:6">“Niĩ ndĩ na mĩaka mĩnini,</para>
  <para style="q2" vid="JOB 32:6">na inyuĩ mũrĩ akũrũ;</para>
  <para style="q1" vid="JOB 32:6">nĩkĩo ngwĩtigagĩra,</para>
  <para style="q2" vid="JOB 32:6">ngaaga ũũmĩrĩru wa kũmwĩra ũrĩa njũũĩ.<verse eid="JOB 32:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 32:7"/>Ndeciiragia atĩrĩ, ‘Ũkũrũ nĩwaagĩrĩire warie;</para>
  <para style="q2" vid="JOB 32:7">ũingĩ wa mĩaka nĩwaagĩrĩire kũrutana ũũgĩ.’<verse eid="JOB 32:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 32:8"/>No nĩ roho ũrĩa ũrĩ thĩinĩ wa mũndũ,</para>
  <para style="q2" vid="JOB 32:8">o yo mĩhũmũ ya Mwene-Hinya-Wothe, ũheaga mũndũ ũmenyo.<verse eid="JOB 32:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 32:9"/>To arĩa akũrũ oiki oogĩ,</para>
  <para style="q2" vid="JOB 32:9">na to arĩa akũrũ mamenyaga ũrĩa kwagĩrĩire.<verse eid="JOB 32:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 32:10"/>“Nĩ ũndũ ũcio nguuga atĩrĩ, ‘Thikĩrĩriai;</para>
  <para style="q2" vid="JOB 32:10">o na niĩ nĩngũmwĩra ũrĩa njũũĩ.’<verse eid="JOB 32:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 32:11"/>Nĩngwetereire rĩrĩa mũkwaragia,</para>
  <para style="q2" vid="JOB 32:11">ndathikĩrĩria ihooto cianyu;</para>
  <para style="q1" vid="JOB 32:11">rĩrĩa mũgũcaragia ciugo-rĩ,<verse eid="JOB 32:11"/></para>
  <para style="q2">
    <verse number="12" style="v" sid="JOB 32:12"/>nĩngũmũtegeire matũ biũ.</para>
  <para style="q1" vid="JOB 32:12">No gũtirĩ o na ũmwe wanyu wonanirie mahĩtia ma Ayubu;</para>
  <para style="q2" vid="JOB 32:12">gũtirĩ o na ũmwe wanyu ũmũcookeirie mĩario yake.<verse eid="JOB 32:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 32:13"/>Tigai kuuga atĩrĩ, ‘Nĩtũgĩĩte na ũũgĩ;</para>
  <para style="q2" vid="JOB 32:13">rekei Mũrungu amũkararie, no ti mũndũ.’<verse eid="JOB 32:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 32:14"/>No rĩrĩ, Ayubu ti niĩ ekwerekeirie ciugo ciake,</para>
  <para style="q2" vid="JOB 32:14">na niĩ ndikũmũcookeria kũringana na mĩario yanyu.<verse eid="JOB 32:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 32:15"/>“Nĩmamakĩte, na matirĩ na ũndũ ũngĩ mangiuga;</para>
  <para style="q2" vid="JOB 32:15">nĩmarigĩtwo nĩ atĩa mangiuga.<verse eid="JOB 32:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 32:16"/>no nginya njeterere, nĩ ũndũ rĩu nĩmakirĩte,</para>
  <para style="q2" vid="JOB 32:16">tondũ atĩ rĩu marũgamĩte hau matarĩ na macookio?<verse eid="JOB 32:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 32:17"/>O na niĩ nĩngwaria;</para>
  <para style="q2" vid="JOB 32:17">o na niĩ nĩnguuga ũrĩa njũũĩ.<verse eid="JOB 32:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 32:18"/>Nĩgũkorwo njiyũrĩtwo nĩ ciugo,</para>
  <para style="q2" vid="JOB 32:18">naguo roho ũrĩa ũrĩ thĩinĩ wakwa nĩũrandindĩkĩrĩria;<verse eid="JOB 32:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 32:19"/>thĩinĩ wakwa haana ta ndibei ĩrĩ cuba ngunĩke,</para>
  <para style="q2" vid="JOB 32:19">ngahaana ta mondo njerũ ya ndibei ĩkirie gũtuthũka.<verse eid="JOB 32:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 32:20"/>no nginya njarie hũũcũke,</para>
  <para style="q2" vid="JOB 32:20">no nginya ndumũre mĩromo yakwa njookie ũhoro.<verse eid="JOB 32:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 32:21"/>Ndigũtĩĩra mũndũ o na ũ maũthĩ,</para>
  <para style="q2" vid="JOB 32:21">kana ngaathĩrĩrie mũndũ o na ũrĩkũ tũhũ;<verse eid="JOB 32:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 32:22"/>nĩ ũndũ korwo ndĩ mwara na kũgaathĩrĩria,</para>
  <para style="q2" vid="JOB 32:22">Mũnyũũmbi no anjeherie narua.<verse eid="JOB 32:22"/></para>
  <para style="b"/>
  <chapter eid="JOB 32"/>
  <chapter number="33" style="c" sid="JOB 33"/>
  <para style="q1">
    <verse number="1" style="v" sid="JOB 33:1"/>“No rĩu Ayubu-rĩ, thikĩrĩria ciugo ciakwa;</para>
  <para style="q2" vid="JOB 33:1">tega matũ ũigue ũrĩa wothe nguuga.<verse eid="JOB 33:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 33:2"/>Ndĩ hakuhĩ gũtumũra kanua gakwa;</para>
  <para style="q2" vid="JOB 33:2">ciugo ciakwa irĩ o rũrĩmĩ-inĩ rwakwa.<verse eid="JOB 33:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 33:3"/>Ciugo ciakwa ciumĩte ngoro nũngĩrĩru;</para>
  <para style="q2" vid="JOB 33:3">mĩromo yakwa yaragia ĩtarĩ na ũhinga.<verse eid="JOB 33:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 33:4"/>Roho wa Mũrungu nĩwe ũnyũmbĩte;</para>
  <para style="q2" vid="JOB 33:4">mĩhũmũ ya Mwene-Hinya-Wothe nĩyo ĩĩheaga muoyo.<verse eid="JOB 33:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 33:5"/>Nawe njookeria, akorwo nĩũkũhota;</para>
  <para style="q2" vid="JOB 33:5">wĩhaarĩrie ũũngʼethere.<verse eid="JOB 33:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 33:6"/>Niĩ haana o tawe maitho-inĩ ma Mũrungu;</para>
  <para style="q2" vid="JOB 33:6">o na niĩ ndombirwo na rĩũmba.<verse eid="JOB 33:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 33:7"/>Kwĩĩndigĩra gũtigakũmakie,</para>
  <para style="q2" vid="JOB 33:7">kana guoko gwakwa gũkũritũhĩre.<verse eid="JOB 33:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 33:8"/>“No rĩrĩ, nĩuugĩte ngĩiguaga,</para>
  <para style="q2" vid="JOB 33:8">ngaigua ciugo icio ũkiuga atĩ,<verse eid="JOB 33:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 33:9"/>‘Ndĩ mũtheru na ndirĩ na mehia;</para>
  <para style="q2" vid="JOB 33:9">ndiĩkĩte ũũru, na ndirĩ na mahĩtia.<verse eid="JOB 33:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 33:10"/>No Ngai nĩanyonete na mahĩtia;</para>
  <para style="q2" vid="JOB 33:10">anduĩte thũ yake.<verse eid="JOB 33:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 33:11"/>Nĩanjohaga magũrũ na mĩnyororo;</para>
  <para style="q2" vid="JOB 33:11">arangagĩra njĩra ciakwa ciothe.’<verse eid="JOB 33:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 33:12"/>“No ngũkwĩra atĩrĩ, ũhoro-inĩ ũyũ wee ndũrĩ na kĩhooto,</para>
  <para style="q2" vid="JOB 33:12">nĩgũkorwo Ngai nĩ mũnene gũkĩra mũndũ.<verse eid="JOB 33:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 33:13"/>Ũramũtetia nĩkĩ,</para>
  <para style="q2" vid="JOB 33:13">atĩ ndacookagia kiugo kĩa mũndũ o na kĩmwe?<verse eid="JOB 33:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 33:14"/>Nĩgũkorwo Mũrungu nĩaaragia,</para>
  <para style="q2" vid="JOB 33:14">rĩmwe na njĩra ĩmwe, na rĩngĩ akaaria na njĩra ĩngĩ,</para>
  <para style="q2" vid="JOB 33:14">o na gũtuĩka mũndũ no aage gũkũũrana.<verse eid="JOB 33:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 33:15"/>Rĩmwe akaaragia kĩroto-inĩ na kĩoneki-inĩ gĩa ũtukũ,</para>
  <para style="q2" vid="JOB 33:15">rĩrĩa andũ mahĩtĩtwo nĩ toro mũnene marĩ ũrĩrĩ,<verse eid="JOB 33:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 33:16"/>no amaarĩrie matũ-inĩ mao,</para>
  <para style="q2" vid="JOB 33:16">na amamakie nĩguo amakaanie,<verse eid="JOB 33:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 33:17"/>nĩguo agarũre mũndũ atige kũhĩtia,</para>
  <para style="q2" vid="JOB 33:17">na atigane na mwĩtĩĩo,<verse eid="JOB 33:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 33:18"/>nĩguo agitĩre roho wake kuuma gĩkuũ-inĩ,</para>
  <para style="q2" vid="JOB 33:18">na agitĩre muoyo wake ndũkaniinwo na rũhiũ rwa njora.<verse eid="JOB 33:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 33:19"/>Ningĩ mũndũ no arũithio na gũkomio ũrĩrĩ wa ruo,</para>
  <para style="q2" vid="JOB 33:19">akorwo na thĩĩna wa mahĩndĩ ũtathiraga,<verse eid="JOB 33:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 33:20"/>o nginya ngoro yake ĩgathũũra irio,</para>
  <para style="q2" vid="JOB 33:20">na roho wake ũgathũũra irio iria njega mũno.<verse eid="JOB 33:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 33:21"/>Nyama cia mwĩrĩ wake ihĩnjaga igathirĩrĩkĩra,</para>
  <para style="q2" vid="JOB 33:21">na mahĩndĩ make marĩa mataroonekaga makoimĩra.<verse eid="JOB 33:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 33:22"/>Roho wake ũgakuhĩrĩria mbĩrĩra,</para>
  <para style="q2" vid="JOB 33:22">na muoyo wake ũgakuhĩrĩria arĩa mareehage gĩkuũ.<verse eid="JOB 33:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 33:23"/>“No rĩrĩ, angĩkorwo harĩ na mũraika mwena wake arĩ mũiguithania,</para>
  <para style="q2" vid="JOB 33:23">ũmwe harĩ ngiri, wa kwĩra mũndũ ũndũ ũrĩa ũmwagĩrĩire,<verse eid="JOB 33:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 33:24"/>nake amũkinyĩrie wega wake na oige atĩrĩ,</para>
  <para style="q2" vid="JOB 33:24">‘Mũhonokie ndagatuĩke wa gũikũrũka mbĩrĩra-inĩ;</para>
  <para style="q2" vid="JOB 33:24">nĩnyonete gĩa kũmũkũũra nakĩo,’<verse eid="JOB 33:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 33:25"/>hĩndĩ ĩyo nyama cia mwĩrĩ wake igeethĩha ta cia mwana;</para>
  <para style="q2" vid="JOB 33:25">igaacooka ta ũrĩa ciarĩ matukũ-inĩ ma wĩthĩ wake.<verse eid="JOB 33:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 33:26"/>Ahooyaga Ngai ageekwo wega nĩwe,</para>
  <para style="q2" vid="JOB 33:26">oonaga ũthiũ wa Ngai akaanĩrĩra nĩ gũkena;</para>
  <para style="q2" vid="JOB 33:26">agacookio ũthingu-inĩ wake nĩ Ngai.<verse eid="JOB 33:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 33:27"/>Nake agacooka agathiĩ kũrĩ andũ akameera atĩrĩ,</para>
  <para style="q2" vid="JOB 33:27">‘Nĩndehirie, na ngĩogomia ũndũ ũrĩa warĩ wa ma,</para>
  <para style="q2" vid="JOB 33:27">no ndiigana kũherithio ũrĩa ndaagĩrĩirwo nĩkũherithio.<verse eid="JOB 33:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 33:28"/>Nĩakũũrire roho wakwa ndũkaharũrũkio mbĩrĩra,</para>
  <para style="q2" vid="JOB 33:28">na niĩ ngũtũũra ngenagĩra ũtheri ũcio.’<verse eid="JOB 33:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 33:29"/>“Mũrungu nĩekaga mũndũ maũndũ macio mothe,</para>
  <para style="q2" vid="JOB 33:29">maita meerĩ o na kana matatũ,<verse eid="JOB 33:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 33:30"/>nĩguo agarũre roho wake ndũkaharũrũkio mbĩrĩra,</para>
  <para style="q2" vid="JOB 33:30">nĩgeetha ũtheri ũcio wa muoyo ũmũtherere.<verse eid="JOB 33:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="JOB 33:31"/>“Atĩrĩrĩ Ayubu, tega matũ na ũũthikĩrĩrie;</para>
  <para style="q2" vid="JOB 33:31">kira ki na niĩ njarie.<verse eid="JOB 33:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOB 33:32"/>Wakorwo ũrĩ na ũndũ wa kuuga-rĩ, njĩĩra;</para>
  <para style="q2" vid="JOB 33:32">aria, nĩgũkorwo ingĩenda woneke ndwĩhĩtie.<verse eid="JOB 33:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="JOB 33:33"/>No akorwo ti ũguo-rĩ, wee gĩthikĩrĩrie;</para>
  <para style="q2" vid="JOB 33:33">kira ki, na nĩngũkũruta ũũgĩ.”<verse eid="JOB 33:33"/></para>
  <chapter eid="JOB 33"/>
  <chapter number="34" style="c" sid="JOB 34"/>
  <para style="p">
    <verse number="1" style="v" sid="JOB 34:1"/>Ningĩ Elihu akiuga atĩrĩ:<verse eid="JOB 34:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 34:2"/>“Iguai ciugo ciakwa, inyuĩ andũ aya oogĩ;</para>
  <para style="q2" vid="JOB 34:2">thikĩrĩriai, inyuĩ amenyi a maũndũ.<verse eid="JOB 34:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 34:3"/>Nĩgũkorwo gũtũ gũthuuranagia ciugo</para>
  <para style="q2" vid="JOB 34:3">o ta ũrĩa rũrĩmĩ rũcamaga irio.<verse eid="JOB 34:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 34:4"/>Nĩtwĩkũũranĩrei ithuĩ ene ũndũ ũrĩa wagĩrĩire;</para>
  <para style="q2" vid="JOB 34:4">nĩtwĩrute tũrĩ hamwe ũndũ ũrĩa mwega.<verse eid="JOB 34:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 34:5"/>“Ayubu aroiga atĩrĩ, ‘Niĩ ndihĩtĩtie,</para>
  <para style="q2" vid="JOB 34:5">no Mũrungu nĩanjagithĩtie kĩhooto gĩakwa.<verse eid="JOB 34:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 34:6"/>O na gũtuĩka ndĩraria ũrĩa kũrĩ,</para>
  <para style="q2" vid="JOB 34:6">ndĩratuuo mũheenania;</para>
  <para style="q1" vid="JOB 34:6">o na gũtuĩka ndirĩ na mahĩtia,</para>
  <para style="q2" vid="JOB 34:6">mũguĩ wake ũngurarĩtie kĩronda gĩtangĩhona.’<verse eid="JOB 34:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 34:7"/>Nĩ mũndũ ũrĩkũ ũhaana ta Ayubu,</para>
  <para style="q2" vid="JOB 34:7">mũndũ ũnyuuaga kĩnyũrũri taarĩ maaĩ aranyua?<verse eid="JOB 34:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 34:8"/>Atwaranaga na andũ arĩa mekaga ũũru;</para>
  <para style="q2" vid="JOB 34:8">agĩĩaga thiritũ na andũ arĩa aaganu.<verse eid="JOB 34:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 34:9"/>Nĩgũkorwo oigaga atĩrĩ, ‘Gũtirĩ uumithio mũndũ onaga</para>
  <para style="q2" vid="JOB 34:9">rĩrĩa arageria gũkenia Ngai.’<verse eid="JOB 34:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 34:10"/>“Nĩ ũndũ ũcio gĩĩthikĩrĩriei, inyuĩ andũ aya mũrĩ na ũtaũku.</para>
  <para style="q2" vid="JOB 34:10">Ũhoro wa kwĩhia ũroaga kuoneka harĩ Mũrungu,</para>
  <para style="q2" vid="JOB 34:10">Mwene-Hinya-Wothe aroaga gwĩka ũũru.<verse eid="JOB 34:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 34:11"/>Arĩhaga mũndũ kũringana na ũrĩa ekĩte;</para>
  <para style="q2" vid="JOB 34:11">akamũrehere o kĩrĩa kĩringaine na mĩthiĩre yake.<verse eid="JOB 34:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 34:12"/>Gũtingĩhoteka atĩ Mũrungu no eeke mahĩtia,</para>
  <para style="q2" vid="JOB 34:12">atĩ ũrĩa Mwene-Hinya-Wothe no ogomie kĩhooto.<verse eid="JOB 34:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 34:13"/>Nũũ wamũtuire mũrori wa thĩ?</para>
  <para style="q2" vid="JOB 34:13">Nũũ wamũtuire mũrũgamĩrĩri wa thĩ yothe?<verse eid="JOB 34:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 34:14"/>Korwo aagĩa na muoroto</para>
  <para style="q2" vid="JOB 34:14">wa kweheria roho wake na mĩhũmũ-rĩ,<verse eid="JOB 34:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 34:15"/>andũ othe mangĩthiranĩra hamwe,</para>
  <para style="q2" vid="JOB 34:15">nake mũndũ acooke rũkũngũ-inĩ.<verse eid="JOB 34:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 34:16"/>“Akorwo ũrĩ mũndũ ũrĩ na ũtaũku-rĩ, igua ũhoro ũyũ;</para>
  <para style="q2" vid="JOB 34:16">thikĩrĩria ũrĩa nguuga.<verse eid="JOB 34:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 34:17"/>Mũndũ ũthũire kĩhooto-rĩ, no ahote gwathana?</para>
  <para style="q2" vid="JOB 34:17">Ũrĩa ũrĩ kĩhooto, o Ũcio kĩhoti-rĩ, no ũmũtue mwĩhia?<verse eid="JOB 34:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 34:18"/>Githĩ ti we wĩraga athamaki atĩrĩ, ‘Inyuĩ mũtirĩ kĩene,’</para>
  <para style="q2" vid="JOB 34:18">na akeera arĩa marĩ igweta atĩrĩ, ‘Inyuĩ mũrĩ aaganu,’<verse eid="JOB 34:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 34:19"/>o ũcio ũtatĩagĩra anene maũthĩ,</para>
  <para style="q2" vid="JOB 34:19">na ndendaga arĩa atongu gũkĩra arĩa athĩĩni,</para>
  <para style="q2" vid="JOB 34:19">nĩgũkorwo othe nĩ wĩra wa moko make?<verse eid="JOB 34:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 34:20"/>Makuuaga o rĩmwe, o ũtukũ gatagatĩ;</para>
  <para style="q2" vid="JOB 34:20">andũ mainainaga magakua;</para>
  <para style="q2" vid="JOB 34:20">arĩa marĩ hinya meeheragio matahutĩtio nĩ guoko kwa mũndũ.<verse eid="JOB 34:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 34:21"/>“Maitho make maikaraga macũthĩrĩirie mĩthiĩre ya andũ;</para>
  <para style="q2" vid="JOB 34:21">nĩonaga mĩthiĩre yao yothe.<verse eid="JOB 34:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 34:22"/>Gũtirĩ handũ harĩ nduma, kana handũ harĩ kĩĩruru kĩnene,</para>
  <para style="q2" vid="JOB 34:22">hangĩĩhithwo nĩ arĩa meekaga ũũru.<verse eid="JOB 34:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 34:23"/>Mũrungu ndabatairio nĩgũthuthuuria ndeto cia andũ makĩria,</para>
  <para style="q2" vid="JOB 34:23">atĩ nĩguo moke mbere yake maciirithio.<verse eid="JOB 34:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 34:24"/>Ahehenjaga arĩa marĩ ũhoti atekũũria mũndũ</para>
  <para style="q2" vid="JOB 34:24">na akarũgamia andũ angĩ ithenya rĩao.<verse eid="JOB 34:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 34:25"/>Tondũ we nĩamenyaga maũndũ marĩa meekaga,</para>
  <para style="q2" vid="JOB 34:25">amangʼaũranagia ũtukũ magathuthĩka.<verse eid="JOB 34:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 34:26"/>Amaherithagĩria waganu wao</para>
  <para style="q2" vid="JOB 34:26">makĩonagwo nĩ mũndũ o wothe,<verse eid="JOB 34:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 34:27"/>tondũ nĩmagarũrũkire magĩtiga kũmũrũmĩrĩra,</para>
  <para style="q2" vid="JOB 34:27">na matirũmbũyagia njĩra yake o na ĩrĩkũ.<verse eid="JOB 34:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 34:28"/>Nĩmatũmire kĩrĩro kĩa arĩa athĩĩni gĩkinye hau mbere yake,</para>
  <para style="q2" vid="JOB 34:28">nĩ ũndũ ũcio akĩigua kĩrĩro kĩa arĩa abatari.<verse eid="JOB 34:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 34:29"/>No rĩrĩ, angĩikara akirĩte-rĩ, nũũ ũngĩmũtua muhĩtia?</para>
  <para style="q2" vid="JOB 34:29">Angĩhitha ũthiũ wake-rĩ, nũũ ũngĩmuona?</para>
  <para style="q1" vid="JOB 34:29">Nowe arĩ igũrũ rĩa mũndũ na igũrũ rĩa rũrĩrĩ o ũndũ ũmwe,<verse eid="JOB 34:29"/></para>
  <para style="q2">
    <verse number="30" style="v" sid="JOB 34:30"/>nĩguo agirie mũndũ ũtarĩ na ũngai gwathana,</para>
  <para style="q2" vid="JOB 34:30">amũgirie kũigĩra kĩrĩndĩ mĩtego.<verse eid="JOB 34:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="JOB 34:31"/>“Korwo mũndũ no ere Mũrungu atĩrĩ,</para>
  <para style="q2" vid="JOB 34:31">‘Nĩnjĩhĩtie no ndikehia rĩngĩ.<verse eid="JOB 34:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOB 34:32"/>Nduta menye ũrĩa itarahota kuona;</para>
  <para style="q2" vid="JOB 34:32">ingĩkorwo nĩnjĩkĩte ũũru-rĩ, ndigacooka gwĩka ũguo rĩngĩ.’<verse eid="JOB 34:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="JOB 34:33"/>Ngai-rĩ, no agĩkũrĩhe kũringana na ũrĩa wee ũkwenda</para>
  <para style="q2" vid="JOB 34:33">rĩrĩa ũregete kwĩrira?</para>
  <para style="q1" vid="JOB 34:33">No nginya we ũtue itua, no ti niĩ;</para>
  <para style="q2" vid="JOB 34:33">nĩ ũndũ ũcio kĩnjĩĩre ũrĩa ũũĩ.<verse eid="JOB 34:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="JOB 34:34"/>“Andũ arĩa marĩ na ũtaũku maroiga atĩrĩ,</para>
  <para style="q2" vid="JOB 34:34">nao andũ acio oogĩ maiguĩte ngĩaria manjĩĩrĩte atĩrĩ,<verse eid="JOB 34:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="JOB 34:35"/>‘Ayubu aaragia atarĩ na ũmenyo;</para>
  <para style="q2" vid="JOB 34:35">ciugo ciake nĩciagĩte ũũgĩ.’<verse eid="JOB 34:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="JOB 34:36"/>Hĩ, naarĩ korwo Ayubu aagerio nginya mũthia,</para>
  <para style="q2" vid="JOB 34:36">nĩ ũndũ macookio make nĩ ta ma mũndũ mwaganu!<verse eid="JOB 34:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="JOB 34:37"/>Nĩongereire ũremi harĩ mehia make;</para>
  <para style="q2" vid="JOB 34:37">atũhũũragĩra hĩ cia kĩnyũrũri,</para>
  <para style="q2" vid="JOB 34:37">na akaingĩhia ciugo ciake cia gũũkĩrĩra Mũrungu.”<verse eid="JOB 34:37"/></para>
  <chapter eid="JOB 34"/>
  <chapter number="35" style="c" sid="JOB 35"/>
  <para style="s1">Mĩario ya Elihu</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 35:1"/>Ningĩ Elihu akiuga atĩrĩ:<verse eid="JOB 35:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 35:2"/>“Nĩũgwĩciiria ũhoro ũyũ nĩ wa kĩhooto?</para>
  <para style="q2" vid="JOB 35:2">Ũroiga atĩrĩ, ‘Mũrungu nĩekũnjarĩrĩria atue ndiĩhĩtie.’<verse eid="JOB 35:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 35:3"/>No rĩrĩ, wee no ũramũũria atĩrĩ, ‘Kũrĩ na uumithio ũrĩkũ harĩ niĩ,</para>
  <para style="q2" vid="JOB 35:3">na ngũgunĩka nakĩ ndaaga kwĩhia?’<verse eid="JOB 35:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 35:4"/>“No nyende gũgũcookeria ũhoro,</para>
  <para style="q2" vid="JOB 35:4">wee hamwe na arata aku.<verse eid="JOB 35:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 35:5"/>Ta rora igũrũ wone;</para>
  <para style="q2" vid="JOB 35:5">ta cũthĩrĩria matu macio marĩ igũrũ rĩaku kũraya mũno.<verse eid="JOB 35:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 35:6"/>Ũngĩĩhia-rĩ, ũndũ ũcio ũngĩhutia Ngai atĩa?</para>
  <para style="q2" vid="JOB 35:6">Mehia maku mangĩingĩha mũno-rĩ, ũndũ ũcio ũngĩmwĩka atĩa?<verse eid="JOB 35:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 35:7"/>Ũngĩkorwo ũrĩ mũthingu-rĩ, ũngĩmũhe kĩĩ,</para>
  <para style="q2" vid="JOB 35:7">kana nĩ kĩĩ aamũkagĩra kuuma guoko-inĩ gwaku?<verse eid="JOB 35:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 35:8"/>Waganu waku ũhutagia o mũndũ tawe,</para>
  <para style="q2" vid="JOB 35:8">na ũthingu waku ũkahutia o ciana cia andũ.<verse eid="JOB 35:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 35:9"/>“Andũ makayaga nĩ icooki rĩa kũhinyĩrĩrio;</para>
  <para style="q2" vid="JOB 35:9">mathaithanaga mateithũrwo guoko-inĩ kwa ũcio ũrĩ hinya mũingĩ.<verse eid="JOB 35:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 35:10"/>No gũtirĩ mũndũ uugaga atĩrĩ, ‘Ngai ũrĩa wanyũũmbire arĩ ha,</para>
  <para style="q2" vid="JOB 35:10">ũrĩa ũheaga mũndũ nyĩmbo ũtukũ,<verse eid="JOB 35:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 35:11"/>ũrĩa ũtũrutaga maũndũ gũkĩra ũrĩa arutaga nyamũ cia werũ-inĩ,</para>
  <para style="q2" vid="JOB 35:11">o na agatũhe ũũgĩ gũkĩra nyoni cia rĩera-inĩ?’<verse eid="JOB 35:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 35:12"/>Ndacookagia rĩrĩa andũ maakaya</para>
  <para style="q2" vid="JOB 35:12">nĩ ũndũ wa mwĩtũũgĩrio wa andũ arĩa aaganu.<verse eid="JOB 35:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 35:13"/>Ti-itherũ, Mũrungu ndathikagĩrĩria mathaithana mao ma tũhũ;</para>
  <para style="q2" vid="JOB 35:13">ũcio Mwene-Hinya-Wothe ndarũmbũyagia mathaithana macio.<verse eid="JOB 35:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 35:14"/>Githĩ ndakaaga gũthikĩrĩria mũno makĩria</para>
  <para style="q2" vid="JOB 35:14">rĩrĩa ũkuuga atĩ ndũramuona,</para>
  <para style="q1" vid="JOB 35:14">na atĩ ciira waku ũrĩ mbere yake,</para>
  <para style="q2" vid="JOB 35:14">na no nginya ũmweterere,<verse eid="JOB 35:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 35:15"/>na makĩria ma ũguo ũkoiga atĩ marakara make matiherithanagia</para>
  <para style="q2" vid="JOB 35:15">na ndarũmbũyagia waganu o na hanini!<verse eid="JOB 35:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 35:16"/>Nĩ ũndũ ũcio Ayubu atumũrĩte kanua gake akaaria ũhoro wa tũhũ;</para>
  <para style="q2" vid="JOB 35:16">nĩarĩĩtie ndeto nyingĩ atarĩ na ũmenyo.”<verse eid="JOB 35:16"/></para>
  <chapter eid="JOB 35"/>
  <chapter number="36" style="c" sid="JOB 36"/>
  <para style="p">
    <verse number="1" style="v" sid="JOB 36:1"/>Elihu agĩthiĩ na mbere kwaria, akiuga atĩrĩ:<verse eid="JOB 36:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 36:2"/>“Ngirĩrĩria hanini, na nĩngũkuonia</para>
  <para style="q2" vid="JOB 36:2">atĩ harĩ maũndũ mangĩ mangiugwo ma gũciirĩrĩra Ngai.<verse eid="JOB 36:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 36:3"/>Ũmenyo wakwa ndĩũrutĩte kũraihu;</para>
  <para style="q2" vid="JOB 36:3">niĩ ngũtũũgĩria kĩhooto kĩa ũcio Mũnyũũmbi.<verse eid="JOB 36:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 36:4"/>Menya wega atĩ ndeto ciakwa ti cia maheeni;</para>
  <para style="q2" vid="JOB 36:4">ũyũ mũrĩ nake arĩ na ũmenyo mũkinyanĩru.<verse eid="JOB 36:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 36:5"/>“Mũrungu nĩwe mwene hinya, no ndairaga andũ;</para>
  <para style="q2" vid="JOB 36:5">we nĩ mwene hinya, na nĩarũmagia muoroto wake.<verse eid="JOB 36:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 36:6"/>Ndatũũragia arĩa aaganu muoyo,</para>
  <para style="q2" vid="JOB 36:6">no nĩaheaga arĩa anyariire kĩhooto kĩao.<verse eid="JOB 36:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 36:7"/>Ndeheragia maitho make harĩ arĩa athingu;</para>
  <para style="q2" vid="JOB 36:7">amaikaragĩria gĩtĩ kĩa ũnene hamwe na athamaki,</para>
  <para style="q2" vid="JOB 36:7">na akamatũũgĩria nginya tene.<verse eid="JOB 36:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 36:8"/>No rĩrĩ, andũ mangĩkorwo mohetwo na mĩnyororo,</para>
  <para style="q2" vid="JOB 36:8">makanyiitio na mĩhĩndo ya mĩnyamaro,<verse eid="JOB 36:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 36:9"/>we nĩameeraga ũrĩa mekĩte,</para>
  <para style="q2" vid="JOB 36:9">atĩ mehĩtie na ũtũrĩka.<verse eid="JOB 36:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 36:10"/>We nĩatũmaga mathikĩrĩrie ũtaaro,</para>
  <para style="q2" vid="JOB 36:10">na akamaatha merire ũũru wao.<verse eid="JOB 36:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 36:11"/>Mangĩmwathĩkĩra na mamũtungatĩre,</para>
  <para style="q2" vid="JOB 36:11">megũtũũra matukũ mao marĩa matigaru magaacĩire,</para>
  <para style="q2" vid="JOB 36:11">na mĩaka yao o maiganĩire.<verse eid="JOB 36:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 36:12"/>No mangĩaga kũigua,</para>
  <para style="q2" vid="JOB 36:12">nĩmakaniinwo na rũhiũ rwa njora,</para>
  <para style="q2" vid="JOB 36:12">na makue matarĩ na ũmenyo.<verse eid="JOB 36:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 36:13"/>“Arĩa matarĩ na Ngai ngoro-inĩ meiigagĩra marakara;</para>
  <para style="q2" vid="JOB 36:13">o na rĩrĩa aramooha na mĩnyororo, matikayaga mateithio.<verse eid="JOB 36:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 36:14"/>Makuuaga marĩ ethĩ,</para>
  <para style="q2" vid="JOB 36:14">magakua hamwe na arũme arĩa maraya ma mahooero-inĩ.<verse eid="JOB 36:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 36:15"/>No arĩa mathĩĩnĩkaga, nĩamakũũraga kuuma thĩĩna-inĩ wao;</para>
  <para style="q2" vid="JOB 36:15">nĩamaragĩria marĩ mĩnyamaro-inĩ.<verse eid="JOB 36:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 36:16"/>“We-rĩ, nĩarakũguucĩrĩria uume magego-inĩ ma mĩnyamaro,</para>
  <para style="q2" vid="JOB 36:16">agũtware handũ haariĩ hatarĩ na ũkunderu,</para>
  <para style="q2" vid="JOB 36:16">na agũtware akũhurũkie metha-inĩ yaku ĩiyũrĩte irio iria njega.<verse eid="JOB 36:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 36:17"/>No rĩu-rĩ, ũtitikithĩtio ituĩro rĩrĩa rĩagĩrĩire arĩa aaganu;</para>
  <para style="q2" vid="JOB 36:17">ituĩro rĩa ciira na kĩhooto nĩcigũkumbatĩte.<verse eid="JOB 36:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 36:18"/>Wĩmenyerere mũndũ o na ũrĩkũ ndakanakũheenererie na ũtonga;</para>
  <para style="q2" vid="JOB 36:18">ndũgetĩkĩrie ihaki inene rĩkũhĩtithie njĩra.<verse eid="JOB 36:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 36:19"/>Ũtonga waku o na kana kĩyo gĩaku kĩnene-rĩ,</para>
  <para style="q2" vid="JOB 36:19">no ikũnyiitĩrĩre nĩguo ndũgatoonye mĩnyamaro-inĩ?<verse eid="JOB 36:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 36:20"/>Tiga kwĩrirĩria ũtukũ,</para>
  <para style="q2" vid="JOB 36:20">nĩguo ũguucũrũrie andũ kuuma kwao mĩciĩ.<verse eid="JOB 36:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 36:21"/>Wĩmenyerere ndũkeerekere ũũru-inĩ,</para>
  <para style="q2" vid="JOB 36:21">tondũ ũkuoneka taarĩ guo wendete gũkĩra gũthĩĩnĩka.<verse eid="JOB 36:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 36:22"/>“Mũrungu nĩatũgĩrĩtio nĩ ũndũ wa ũhoti wake.</para>
  <para style="q2" vid="JOB 36:22">Nũũ mũrutani take?<verse eid="JOB 36:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 36:23"/>Nũũ ũmwathĩrĩire njĩra ciake,</para>
  <para style="q2" vid="JOB 36:23">kana akamwĩra atĩrĩ, ‘Wee nĩwĩkĩte ũũru’?<verse eid="JOB 36:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 36:24"/>Ririkanaga gwĩkĩrĩra wĩra wake,</para>
  <para style="q2" vid="JOB 36:24">ũrĩa andũ manakumia na rwĩmbo.<verse eid="JOB 36:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 36:25"/>Andũ othe nĩmawonete;</para>
  <para style="q2" vid="JOB 36:25">andũ mawĩroragĩra marĩ o kũraya.<verse eid="JOB 36:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 36:26"/>Ĩ Mũrungu ndakĩrĩ mũnene; nĩ mũnene gũkĩra ũmenyi witũ!</para>
  <para style="q2" vid="JOB 36:26">Mũigana wa mĩaka yake ndũngĩtuĩrĩka.<verse eid="JOB 36:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 36:27"/>“Ambatagia matata ma maaĩ,</para>
  <para style="q2" vid="JOB 36:27">marĩa macookaga gũtaatĩra tũrũũĩ ta mbura;<verse eid="JOB 36:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 36:28"/>matu magaita ũigũ wamo,</para>
  <para style="q2" vid="JOB 36:28">nayo mbura nyingĩ ĩkoirĩra andũ.<verse eid="JOB 36:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 36:29"/>Nũũ ũngĩmenya ũrĩa atambũrũkagia matu,</para>
  <para style="q2" vid="JOB 36:29">kana ũhoro wa marurumĩ marĩa moimaga hema-inĩ yake?<verse eid="JOB 36:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 36:30"/>Kĩone ũrĩa ahurunjaga rũheni rwake rũkamũthiũrũrũkĩria,</para>
  <para style="q2" vid="JOB 36:30">agathambia iria kũrĩa kũriku.<verse eid="JOB 36:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOB 36:31"/>Ũũ nĩguo aathaga ndũrĩrĩ</para>
  <para style="q2" vid="JOB 36:31">na akaheana irio nyingĩ.<verse eid="JOB 36:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOB 36:32"/>Akumbatagĩria rũheni na moko make,</para>
  <para style="q2" vid="JOB 36:32">na akarwatha rũringe kĩrĩa kĩorotetwo.<verse eid="JOB 36:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="JOB 36:33"/>Marurumĩ make nĩmanagĩrĩra kĩhuhũkanio kĩrĩa kĩroka;</para>
  <para style="q2" vid="JOB 36:33">o na ngʼombe nĩimenyithanagia atĩ kũrĩ kĩhuhũkanio kĩroka.<verse eid="JOB 36:33"/></para>
  <para style="b"/>
  <chapter eid="JOB 36"/>
  <chapter number="37" style="c" sid="JOB 37"/>
  <para style="q1">
    <verse number="1" style="v" sid="JOB 37:1"/>“Ndaigua ũguo ngoro yakwa ĩgatumatuuma,</para>
  <para style="q2" vid="JOB 37:1">na ĩkambarara ĩkoima handũ hayo.<verse eid="JOB 37:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 37:2"/>Thikĩrĩria! Thikĩrĩria mũraramo wa mũgambo wake,</para>
  <para style="q2" vid="JOB 37:2">mũrurumo ũrĩa uumaga kanua gake.<verse eid="JOB 37:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 37:3"/>Arekagĩrĩria rũheni rwake rungu rwa igũrũ guothe</para>
  <para style="q2" vid="JOB 37:3">na akarũtũma nginya ituri cia thĩ.<verse eid="JOB 37:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 37:4"/>Thuutha waruo gũũkaga mũgambo wa mũraramo wake;</para>
  <para style="q2" vid="JOB 37:4">arurumaga na mũgambo wake mũkaru.</para>
  <para style="q1" vid="JOB 37:4">Hĩndĩ ĩrĩa mũgambo wake waiguuo-rĩ,</para>
  <para style="q2" vid="JOB 37:4">ndarigagĩrĩria heni.<verse eid="JOB 37:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 37:5"/>Mũgambo wa Mũrungu ũrurumaga na njĩra ya magegania;</para>
  <para style="q2" vid="JOB 37:5">ekaga maũndũ manene tũtangĩhota kũmenya.<verse eid="JOB 37:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 37:6"/>Eeraga tharunji atĩrĩ, ‘Gwa thĩ,’</para>
  <para style="q2" vid="JOB 37:6">nayo mbura ya rũthuthuũ akamĩĩra atĩrĩ, ‘Tuĩka mbura nene.’<verse eid="JOB 37:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 37:7"/>Nĩatigithagia mũndũ o wothe wĩra wake</para>
  <para style="q2" vid="JOB 37:7">nĩgeetha andũ othe ombĩte mamenye wĩra wake.<verse eid="JOB 37:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 37:8"/>Nyamũ nacio nĩciĩhithaga;</para>
  <para style="q2" vid="JOB 37:8">ciikaraga imamo-inĩ ciacio.<verse eid="JOB 37:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 37:9"/>Kĩhuhũkanio kiumaga gĩikaro gĩakĩo,</para>
  <para style="q2" vid="JOB 37:9">heho nayo ĩkoima rũhuho-inĩ rũkĩhurutana.<verse eid="JOB 37:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 37:10"/>Mĩhũmũ ya Mũrungu nĩĩthondekaga mbarabu,</para>
  <para style="q2" vid="JOB 37:10">namo maaĩ harĩa maaramĩire makanyiitana.<verse eid="JOB 37:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 37:11"/>Nĩaiyũragia matu na ũigũ;</para>
  <para style="q2" vid="JOB 37:11">ahurunjaga rũheni rũkamatũrĩkia.<verse eid="JOB 37:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 37:12"/>Mathiiaga magĩthiũrũrũkaga</para>
  <para style="q2" vid="JOB 37:12">o kũrĩa angĩmeerekeria thĩ yothe,</para>
  <para style="q2" vid="JOB 37:12">mageeke o ũrĩa wothe angĩmaatha.<verse eid="JOB 37:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 37:13"/>Arehaga matu macio nĩguo aherithie andũ,</para>
  <para style="q2" vid="JOB 37:13">kana aihũgie thĩ yake na onanie wendani wake.<verse eid="JOB 37:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 37:14"/>“Ayubu, thikĩrĩria ũhoro ũyũ;</para>
  <para style="q2" vid="JOB 37:14">tithĩria hau wĩcũũranie ũhoro wa magegania ma Mũrungu.<verse eid="JOB 37:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 37:15"/>Wee nĩũũĩ ũrĩa Ngai aathaga matu,</para>
  <para style="q2" vid="JOB 37:15">na ũrĩa atũmaga rũheni rwake rũhenũke?<verse eid="JOB 37:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 37:16"/>Wee nĩũũĩ ũrĩa matu macio macuurĩtio wega,</para>
  <para style="q2" vid="JOB 37:16">magegania macio ma ũrĩa ũrĩ ũmenyo mũkinyanĩru?<verse eid="JOB 37:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 37:17"/>Wee ũringĩkaga nĩ ũrugarĩ wa nguo ciaku</para>
  <para style="q2" vid="JOB 37:17">rĩrĩa bũrũri ũkirĩte ki hĩndĩ ya rũhuho rwa gũthini-rĩ,<verse eid="JOB 37:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 37:18"/>no ũhote kũruta wĩra nake ũhoro-inĩ wa gũtambũrũkia matu mairũ,</para>
  <para style="q2" vid="JOB 37:18">o macio momĩte o ta gĩcicio gĩa gĩcango?<verse eid="JOB 37:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 37:19"/>“Ta twĩre ũrĩa twagĩrĩirwo nĩ kũmwĩra;</para>
  <para style="q2" vid="JOB 37:19">tũtingĩhota gwĩciirĩra nĩ ũndũ wa nduma iitũ.<verse eid="JOB 37:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 37:20"/>Nĩagĩrĩire kwĩrwo atĩ nĩngwenda kwaria?</para>
  <para style="q2" vid="JOB 37:20">Nĩ kũrĩ mũndũ o na ũ ũngiuga amerio?<verse eid="JOB 37:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 37:21"/>Rĩu-rĩ, gũtirĩ mũndũ ũngĩhota kũrora riũa,</para>
  <para style="q2" vid="JOB 37:21">rĩcangararĩte kũu igũrũ</para>
  <para style="q2" vid="JOB 37:21">thuutha wakuo kũhaatwo nĩ rũhuho gũgathera.<verse eid="JOB 37:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 37:22"/>Okaga kuuma mwena wa gathigathini arĩ na riiri ukengeete ta wa thahabu;</para>
  <para style="q2" vid="JOB 37:22">Ngai okaga arĩ na ũkaru wa gwĩtigĩrwo.<verse eid="JOB 37:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 37:23"/>Ũcio Mwene-Hinya-Wothe-rĩ, tũtingĩhota kũmũkinyĩra,</para>
  <para style="q2" vid="JOB 37:23">nĩatũũgĩrĩtio nĩ ũndũ wa ũhoti wake;</para>
  <para style="q2" vid="JOB 37:23">tondũ wa ũrĩa arĩ wa kĩhooto na ũthingu mũnene-rĩ, ndahinyanagĩrĩria.<verse eid="JOB 37:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 37:24"/>Nĩ ũndũ ũcio andũ nĩmamũtĩĩte,</para>
  <para style="q2" vid="JOB 37:24">tondũ githĩ ndarũmbũyagia arĩa meyonaga ta marĩ oogĩ na ngoro ciao?”<verse eid="JOB 37:24"/></para>
  <chapter eid="JOB 37"/>
  <chapter number="38" style="c" sid="JOB 38"/>
  <para style="s1">Mĩario ya Jehova</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 38:1"/>Nake Jehova agĩcookeria Ayubu ũhoro arĩ kĩhuhũkanio-inĩ, akĩmwĩra atĩrĩ:<verse eid="JOB 38:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 38:2"/>“Nũũ ũyũ ũrekĩra kĩrĩra gĩakwa nduma</para>
  <para style="q2" vid="JOB 38:2">na ciugo itarĩ na ũmenyo?<verse eid="JOB 38:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 38:3"/>Wĩhotore ta mũndũ mũrũme;</para>
  <para style="q2" vid="JOB 38:3">nĩngũkũũria ciũria, nawe ũkĩnjookerie.<verse eid="JOB 38:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 38:4"/>“Warĩ kũ rĩrĩa ndaakire mũthingi wa thĩ?</para>
  <para style="q2" vid="JOB 38:4">Njĩĩra akorwo ũrĩ na ũũgĩ wa kũmenya.<verse eid="JOB 38:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 38:5"/>Nũũ wathimire mũigana wayo? Ti-itherũ wee nĩũũĩ!</para>
  <para style="q2" vid="JOB 38:5">Nũũ watambũrũkirie rũrigi rwa gũthima igũrũ rĩayo?<verse eid="JOB 38:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 38:6"/>Mĩthingi yayo yahandirwo igũrũ rĩa kĩĩ,</para>
  <para style="q2" vid="JOB 38:6">kana nũũ wahaandire ihiga rĩayo rĩa koine,<verse eid="JOB 38:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 38:7"/>hĩndĩ ĩrĩa njata cia rũciinĩ ciainire hamwe,</para>
  <para style="q2" vid="JOB 38:7">na araika othe makĩanĩrĩra nĩ gũkena?<verse eid="JOB 38:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 38:8"/>“Nũũ wahingĩrĩirie iria na mĩrango</para>
  <para style="q2" vid="JOB 38:8">rĩrĩa rĩatumũkire kuuma nda,<verse eid="JOB 38:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 38:9"/>rĩrĩa ndatuire matu nguo ciarĩo,</para>
  <para style="q2" vid="JOB 38:9">na ngĩrĩoha nduma nene ta taama warĩo,<verse eid="JOB 38:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 38:10"/>rĩrĩa ndarĩkĩrĩire mĩhaka, na ngĩrĩhingĩra na mĩrango yarĩo,</para>
  <para style="q2" vid="JOB 38:10">na ngĩĩkĩra mĩgĩĩko handũ hayo,<verse eid="JOB 38:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 38:11"/>rĩrĩa ndoigire atĩrĩ, ‘Ũkinyage o haha na ndũkanahakĩre;</para>
  <para style="q2" vid="JOB 38:11">makũmbĩ maku macio metĩĩi-rĩ, hau nĩho marĩĩkinyaga’?<verse eid="JOB 38:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 38:12"/>“Kuuma o kĩambĩrĩria-rĩ, ũrĩ waathana atĩ rũciinĩ rũgĩe ho,</para>
  <para style="q2" vid="JOB 38:12">kana ũkĩonereria ũtheri wa rũciinĩ harĩa ũkuumĩrĩra,<verse eid="JOB 38:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 38:13"/>nĩguo ũhote kũnyiita thĩ na mĩthia yaguo,</para>
  <para style="q2" vid="JOB 38:13">nao arĩa aaganu maribaribwo moime kuo?<verse eid="JOB 38:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 38:14"/>Thĩ ĩhaanaga ta rĩũmba rĩhũrĩtwo mũhũũri;</para>
  <para style="q2" vid="JOB 38:14">mũonekere wayo ũtariĩ ta mũhianĩre wa nguo.<verse eid="JOB 38:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 38:15"/>Andũ arĩa aaganu nĩmaimagwo ũtheri wao,</para>
  <para style="q2" vid="JOB 38:15">na guoko kwao kũrĩa kuoetwo na igũrũ gũkoinwo.<verse eid="JOB 38:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 38:16"/>“Ũrĩ wathiĩ rũgendo nginya kũrĩa iria rĩtherũkagĩra,</para>
  <para style="q2" vid="JOB 38:16">kana ũgaceera itwe-inĩ cia ndia kũrĩa kũriku mũno?<verse eid="JOB 38:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 38:17"/>Ũrĩ wonio ihingo cia gĩkuũ?</para>
  <para style="q2" vid="JOB 38:17">Ũrĩ wona ihingo cia kĩĩruru gĩa gĩkuũ?<verse eid="JOB 38:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 38:18"/>Ũrĩ wamenya ũnene wa wariĩ wa thĩ?</para>
  <para style="q2" vid="JOB 38:18">Njĩĩra akorwo nĩũũĩ maũndũ macio mothe.<verse eid="JOB 38:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 38:19"/>“Njĩra ya gũthiĩ kũrĩa ũtheri ũtũũraga nĩĩrĩkũ?</para>
  <para style="q2" vid="JOB 38:19">Nayo nduma ĩikaraga kũ?<verse eid="JOB 38:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 38:20"/>No ũcitware gwacio?</para>
  <para style="q2" vid="JOB 38:20">Nĩũũĩ tũcĩra twa gũthiĩ kũrĩa itũũraga?<verse eid="JOB 38:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 38:21"/>Ti-itherũ wee nĩũũĩ, nĩgũkorwo warĩ mũciare!</para>
  <para style="q2" vid="JOB 38:21">Wee-rĩ, nĩũtũũrĩte mĩaka mĩingĩ!<verse eid="JOB 38:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 38:22"/>“Ũrĩ watoonya makũmbĩ kũrĩa tharunji ĩigĩtwo,</para>
  <para style="q2" vid="JOB 38:22">kana ũkĩona makũmbĩ kũrĩa mbura ya mbembe ĩigĩtwo,<verse eid="JOB 38:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 38:23"/>o icio njigĩte nĩ ũndũ wa mahinda ma thĩĩna,</para>
  <para style="q2" vid="JOB 38:23">ngaciiga nĩ ũndũ wa matukũ ma mbaara na ma kũrũa.<verse eid="JOB 38:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 38:24"/>Njĩra ya gũthiĩ kũrĩa ũtheri ũgayanagĩrio nĩĩrĩkũ,</para>
  <para style="q2" vid="JOB 38:24">kana ya gũthiĩ kũrĩa rũhuho rwa irathĩro rũhurunjagĩrwo gũkũ thĩ?<verse eid="JOB 38:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 38:25"/>Nũũ wenjagĩra mbura ya kĩboboto mũtaro wa kũgerera,</para>
  <para style="q2" vid="JOB 38:25">kana agatemera mbura ya marurumĩ njĩra,<verse eid="JOB 38:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 38:26"/>nĩguo mbura yure bũrũri ũtatũũraga mũndũ,</para>
  <para style="q2" vid="JOB 38:26">na yure werũ kũrĩa gũtarĩ mũndũ,<verse eid="JOB 38:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 38:27"/>nĩguo ĩhũũnagie kũu gũtiganĩrie gũgakira ihooru,</para>
  <para style="q2" vid="JOB 38:27">na ĩtũme kũmere nyeki?<verse eid="JOB 38:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 38:28"/>Mbura nĩĩrĩ ithe?</para>
  <para style="q2" vid="JOB 38:28">Nũũ mũciari wa matata ma ime?<verse eid="JOB 38:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 38:29"/>Tharunji yumaga nda ya ũ?</para>
  <para style="q2" vid="JOB 38:29">Nũũ ũciaraga mbaa ĩrĩa yumaga igũrũ,<verse eid="JOB 38:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 38:30"/>rĩrĩa maaĩ momaga ta ihiga,</para>
  <para style="q2" vid="JOB 38:30">rĩrĩa maaĩ marĩa marĩ igũrũ wa iria magwatana?<verse eid="JOB 38:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="JOB 38:31"/>“Wee-rĩ, wahota kuohania njata iria thaka cia Kĩrĩmĩra?</para>
  <para style="q2" vid="JOB 38:31">Wahota kuohora mĩkanda ya njata iria ciĩtagwo Karaũ?<verse eid="JOB 38:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOB 38:32"/>Wahota kuumagaragia njata iria ciĩtagwo Mazarothu o mahinda maacio maakinya,</para>
  <para style="q2" vid="JOB 38:32">kana wahota gũtongoria Nduba na ciana ciayo?<verse eid="JOB 38:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="JOB 38:33"/>Nĩũũĩ mawatho ma igũrũ?</para>
  <para style="q2" vid="JOB 38:33">No ũhote kũhaanda wathani wa Ngai ũrũme gũkũ thĩ?<verse eid="JOB 38:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="JOB 38:34"/>“Wahota kwanĩrĩra nginya mũgambo waku ũkinye matu-inĩ</para>
  <para style="q2" vid="JOB 38:34">nĩguo kuure wĩhumbĩre na kĩguũ kĩa maaĩ?<verse eid="JOB 38:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="JOB 38:35"/>Wee nĩwe ũtũmaga heni ithiĩ na njĩra ciacio?</para>
  <para style="q2" vid="JOB 38:35">Nĩikũrehagĩra ũhoro igakwĩra atĩ, ‘Tũrĩ haha’?<verse eid="JOB 38:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="JOB 38:36"/>Nũũ waheire ngoro ũũgĩ,</para>
  <para style="q2" vid="JOB 38:36">kana akĩhe meciiria ũmenyo?<verse eid="JOB 38:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="JOB 38:37"/>Nũũ ũrĩ na ũũgĩ wa gũtara matu?</para>
  <para style="q2" vid="JOB 38:37">Nũũ ũngĩhota kũinamia ndigithũ cia maaĩ cia igũrũ<verse eid="JOB 38:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="JOB 38:38"/>rĩrĩa rũkũngũ rwatondora,</para>
  <para style="q2" vid="JOB 38:38">nayo ndoro ĩkooma ĩkanyiitana?<verse eid="JOB 38:38"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="39" style="v" sid="JOB 38:39"/>“Nĩwe ũguĩmagĩra mũrũũthi wa mũgoma wone gĩa kũrĩa,</para>
  <para style="q2" vid="JOB 38:39">kana nĩwe ũniinagĩra mĩrũũthi ngʼaragu<verse eid="JOB 38:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="JOB 38:40"/>rĩrĩa ĩkomereire imamo-inĩ ciayo,</para>
  <para style="q2" vid="JOB 38:40">kana rĩrĩa ĩikaraga yoheirie nyamũ ihinga-inĩ?<verse eid="JOB 38:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="JOB 38:41"/>Nũũ ũheaga ihuru irio</para>
  <para style="q2" vid="JOB 38:41">rĩrĩa tũcui twarĩo tũgũkaĩra Mũrungu</para>
  <para style="q2" vid="JOB 38:41">tũkĩũrũũraga nĩ kwaga irio?<verse eid="JOB 38:41"/></para>
  <para style="b"/>
  <chapter eid="JOB 38"/>
  <chapter number="39" style="c" sid="JOB 39"/>
  <para style="q1">
    <verse number="1" style="v" sid="JOB 39:1"/>“Wee nĩũũĩ rĩrĩa mbũri cia irĩma-inĩ iciaraga?</para>
  <para style="q2" vid="JOB 39:1">Wee nĩwĩroragĩra rĩrĩa thwariga ĩgũciara kaana kayo?<verse eid="JOB 39:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 39:2"/>Wee nĩũtaraga mĩeri ĩrĩa ciikaraga ingĩgaaciara?</para>
  <para style="q2" vid="JOB 39:2">Nĩũũĩ hĩndĩ ĩrĩa iciaraga?<verse eid="JOB 39:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 39:3"/>Ciĩthunaga igaciara twana twacio;</para>
  <para style="q2" vid="JOB 39:3">ruo rwacio rwa gũciara rũgathira.<verse eid="JOB 39:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 39:4"/>Twana twacio twagĩraga mwĩrĩ, tũgakũra tũrĩ na hinya o kũu gĩthaka-inĩ;</para>
  <para style="q2" vid="JOB 39:4">tũkinyaga ihinda rĩa kwehera na tũticookaga.<verse eid="JOB 39:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 39:5"/>“Nũũ warekereirie njagĩ ĩthiiage ĩtarĩ mũũria?</para>
  <para style="q2" vid="JOB 39:5">Nũũ wamĩohorire mĩhĩndo?<verse eid="JOB 39:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 39:6"/>Ndaamĩheire werũ ũtuĩke mũciĩ wayo,</para>
  <para style="q2" vid="JOB 39:6">naguo bũrũri wa cumbĩ ũtuĩke gĩtũũro kĩayo.<verse eid="JOB 39:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 39:7"/>Ĩthekagĩrĩra inegene rĩrĩ thĩinĩ wa itũũra;</para>
  <para style="q2" vid="JOB 39:7">ndĩiguaga mũkaĩrĩrio wa mũtwarithia.<verse eid="JOB 39:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 39:8"/>Ĩrimũthagĩra irĩma-inĩ ĩgĩetha gwa kũrĩa,</para>
  <para style="q2" vid="JOB 39:8">ĩkahaara kahuti o gothe karuru.<verse eid="JOB 39:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 39:9"/>“Mbogo ya njamba-rĩ, yetĩkĩra gũgũtungata?</para>
  <para style="q2" vid="JOB 39:9">No ĩkindĩrie mũharatĩ-inĩ waku ũtukũ?<verse eid="JOB 39:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 39:10"/>No ũhote kũmĩoha matandĩko ĩrĩme na mũraũ?</para>
  <para style="q2" vid="JOB 39:10">No ĩkuume thuutha ituamba-inĩ ĩkĩrĩmaga na mũraũ?<verse eid="JOB 39:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 39:11"/>No ũmĩĩhoke nĩ ũndũ atĩ ĩrĩ na hinya mũingĩ?</para>
  <para style="q2" vid="JOB 39:11">No ũmĩtigĩre wĩra waku mũritũ ĩrutage?<verse eid="JOB 39:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 39:12"/>No ũmĩĩhoke ĩkũrehere ngano yaku,</para>
  <para style="q2" vid="JOB 39:12">na ĩmĩcookanĩrĩrie kĩhuhĩro-inĩ gĩaku?<verse eid="JOB 39:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 39:13"/>“Mathagu ma nyaga mabatabataga nĩ gũkena,</para>
  <para style="q2" vid="JOB 39:13">no matingĩgerekanio na mathagu na njoya cia njũũ.<verse eid="JOB 39:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 39:14"/>Ĩrekagĩria matumbĩ mayo tĩĩri-inĩ</para>
  <para style="q2" vid="JOB 39:14">na ĩkamatiga mũthanga-inĩ magwate ũrugarĩ,<verse eid="JOB 39:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 39:15"/>ĩtegwĩciiria atĩ no makinywo na magũrũ makue,</para>
  <para style="q2" vid="JOB 39:15">kana marangwo nĩ nyamũ ya gĩthaka.<verse eid="JOB 39:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 39:16"/>Ĩĩkaga ciana ciayo ũũru ta itarĩ ciayo;</para>
  <para style="q2" vid="JOB 39:16">ndĩmakaga atĩ wĩra wayo no ũtuĩke wa tũhũ,<verse eid="JOB 39:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 39:17"/>nĩgũkorwo Ngai ndaamĩheire ũũgĩ</para>
  <para style="q2" vid="JOB 39:17">kana akĩmĩhe igai rĩa mwĩciirĩrie mwega.<verse eid="JOB 39:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 39:18"/>No rĩrĩ, rĩrĩa yatambũrũkia mathagu ĩhanyũke,</para>
  <para style="q2" vid="JOB 39:18">ĩthekagĩrĩra mbarathi na mũmĩhaici.<verse eid="JOB 39:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 39:19"/>“Wee nĩwe ũheaga mbarathi hinya wayo,</para>
  <para style="q2" vid="JOB 39:19">kana ũkamĩhumba ngingo na mũreera?<verse eid="JOB 39:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 39:20"/>Wee nĩwe ũtũmaga ĩrũũge ta ngigĩ,</para>
  <para style="q2" vid="JOB 39:20">ĩkahahũra andũ na mũtiihĩre wayo wa mwĩtĩĩo?<verse eid="JOB 39:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 39:21"/>Ĩhuragia thĩ na ũcamba ĩgĩkenagĩra hinya wayo,</para>
  <para style="q2" vid="JOB 39:21">ĩkaguthũka ĩtoonyete mbaara-inĩ.<verse eid="JOB 39:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 39:22"/>Ĩthekagĩrĩra guoya, ĩtarĩ ũndũ ĩngĩtigĩra;</para>
  <para style="q2" vid="JOB 39:22">ndĩmakagio nĩ rũhiũ rwa njora.<verse eid="JOB 39:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 39:23"/>Thiaka wa mũmĩhaici ũbocabocaga mbaru-inĩ ciayo,</para>
  <para style="q2" vid="JOB 39:23">hamwe na itimũ rĩkũhenia na mĩcengi.<verse eid="JOB 39:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 39:24"/>Irĩĩaga tĩĩri nĩ ũrũme;</para>
  <para style="q2" vid="JOB 39:24">ndĩngĩrũgama ĩkindĩirie hĩndĩ ĩrĩa karumbeta kagamba.<verse eid="JOB 39:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 39:25"/>Hĩndĩ ĩrĩa karumbeta kagamba ĩgatiiha, ‘Hĩ!’</para>
  <para style="q2" vid="JOB 39:25">Ĩnyiitaga thaaha wa mbaara ĩrĩ o haraaya,</para>
  <para style="q2" vid="JOB 39:25">na ĩkaigua kayũ ka anene a mbaara, o na mbugĩrĩrio ya mbaara.<verse eid="JOB 39:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 39:26"/>“Rwĩgĩ-rĩ, nĩwe ũrũhotithagia kũmbũka na ũũgĩ waku,</para>
  <para style="q2" vid="JOB 39:26">kana gũtambũrũkia mathagu maruo rwerekeire mwena wa gũthini?<verse eid="JOB 39:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 39:27"/>Nderi nĩwe ũmĩathaga yũmbũke na igũrũ,</para>
  <para style="q2" vid="JOB 39:27">na ĩkeyakĩra gĩtara kĩayo igũrũ mũno?<verse eid="JOB 39:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 39:28"/>Ĩtũũraga kĩharũrũka-inĩ kĩa ihiga, na nĩ ho ĩraaraga;</para>
  <para style="q2" vid="JOB 39:28">rũhĩa-inĩ rwa ihiga iraaya mũno nĩ ho mwĩgitio wayo.<verse eid="JOB 39:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 39:29"/>Ĩrĩ hau nĩguo ĩcaragĩria gĩa kũrĩa;</para>
  <para style="q2" vid="JOB 39:29">maitho mayo moonaga irio irĩ o kũraya.<verse eid="JOB 39:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 39:30"/>Tũcui twayo tũnyuuaga thakame,</para>
  <para style="q2" vid="JOB 39:30">na handũ harĩa arĩa moragĩtwo marĩ, hau nĩ ho ĩkoragwo.”<verse eid="JOB 39:30"/></para>
  <chapter eid="JOB 39"/>
  <chapter number="40" style="c" sid="JOB 40"/>
  <para style="p">
    <verse number="1" style="v" sid="JOB 40:1"/>Ningĩ Jehova akĩĩra Ayubu atĩrĩ:<verse eid="JOB 40:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 40:2"/>“Mũndũ ũrĩa ũrũaga na Mwene-Hinya-Wothe-rĩ, no amũrute mahĩtia?</para>
  <para style="q2" vid="JOB 40:2">Ũcio ũkararagia Ngai-rĩ, nĩakĩmũcookerie!”<verse eid="JOB 40:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JOB 40:3"/>Nake Ayubu agĩcookeria Jehova, akĩmwĩra atĩrĩ:<verse eid="JOB 40:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 40:4"/>“Niĩ ndiagĩrĩire o na hanini; ndaakĩhota atĩa gũgũcookeria?</para>
  <para style="q2" vid="JOB 40:4">Nĩndehumbĩra kanua na guoko.<verse eid="JOB 40:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 40:5"/>Nĩndaririe rĩmwe, no ndirĩ na macookio;</para>
  <para style="q2" vid="JOB 40:5">o na ngĩaria rĩa keerĩ, no ndirĩ na ũndũ ũngĩ nguuga.”<verse eid="JOB 40:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JOB 40:6"/>Ningĩ Jehova akĩarĩria Ayubu arĩ kĩhuhũkanio-inĩ, akĩmwĩra atĩrĩ:<verse eid="JOB 40:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 40:7"/>“Wĩhotore ta mũndũ mũrũme;</para>
  <para style="q2" vid="JOB 40:7">nĩngũkũũria ciũria, nawe ũkĩnjookerie.<verse eid="JOB 40:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 40:8"/>“Gũtua ciira gwakwa na kĩhooto-rĩ, githĩ no ũkũmenererie?</para>
  <para style="q2" vid="JOB 40:8">Githĩ no ũndue mwĩhia nĩgeetha wee ũtuĩke ndwĩhĩtie?<verse eid="JOB 40:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 40:9"/>Wee-rĩ, ũrĩ na guoko ta kwa Mũrungu?</para>
  <para style="q2" vid="JOB 40:9">Wee wahota kũruruma na mũgambo ta wake?<verse eid="JOB 40:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 40:10"/>Ta kĩĩgemie na riiri na ũkengi,</para>
  <para style="q2" vid="JOB 40:10">na wĩhumbe gĩtĩĩo na ũnene.<verse eid="JOB 40:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 40:11"/>Rekereria marakara mahiũ ma mangʼũrĩ maku,</para>
  <para style="q2" vid="JOB 40:11">wone mũndũ o wothe mwĩtĩĩi ũmũharũrũkie,<verse eid="JOB 40:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 40:12"/>rora mũndũ o wothe mwĩtĩĩi na ũmũnyiihie,</para>
  <para style="q2" vid="JOB 40:12">ũmemende andũ arĩa aaganu o harĩa marũngiĩ.<verse eid="JOB 40:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 40:13"/>Mathike othe hamwe tĩĩri-inĩ;</para>
  <para style="q2" vid="JOB 40:13">ũmoohe mothiũ na nduma kũu mbĩrĩra-inĩ.<verse eid="JOB 40:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 40:14"/>Hĩndĩ ĩyo niĩ mwene nĩngetĩkania nawe</para>
  <para style="q2" vid="JOB 40:14">atĩ guoko gwaku mwene kwa ũrĩo no gũkũhonokie.<verse eid="JOB 40:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 40:15"/>“Ta rora nyamũ ĩrĩa ĩtagwo Behemothu,<note caller="+" style="f"><char style="fr" closed="false">40:15 </char><char style="ft" closed="false">Ĩno yarĩ nyamũ ĩmwe ya iria ciatũũraga thĩ tene. (O na 41:1)</char></note></para>
  <para style="q2" vid="JOB 40:15">ĩyo ndoombire hamwe nawe,</para>
  <para style="q2" vid="JOB 40:15">na ĩrĩĩaga nyeki ta ndegwa.<verse eid="JOB 40:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 40:16"/>Nĩ hinya ũigana atĩa ĩrĩ naguo njohero,</para>
  <para style="q2" vid="JOB 40:16">na nĩ ũhoti mũnene atĩa ũrĩ mĩkiha-inĩ yayo ya nda!<verse eid="JOB 40:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 40:17"/>Ĩinagia mũtingʼoe wayo ta mũtarakwa;</para>
  <para style="q2" vid="JOB 40:17">nga cia ciero ciayo ciohanĩtio hamwe ta mĩhĩndo.<verse eid="JOB 40:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 40:18"/>Mahĩndĩ mayo mahaana ta mĩberethi ya gĩcango,</para>
  <para style="q2" vid="JOB 40:18">nacio ciĩga ciayo cihaana ta irungʼo cia kĩgera.<verse eid="JOB 40:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 40:19"/>Nĩyo nyamũ ya mbere harĩ ciũmbe cia Mũrungu,</para>
  <para style="q2" vid="JOB 40:19">no rĩrĩ, Mũũmbi wayo nowe ũngĩmĩkuhĩrĩria na rũhiũ rwake rwa njora.<verse eid="JOB 40:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 40:20"/>Irĩma ĩmĩheaga maciaro maacio,</para>
  <para style="q2" vid="JOB 40:20">na nyamũ ciothe cia gĩthaka itũũhagĩra gũkuhĩ na kũu.<verse eid="JOB 40:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 40:21"/>Ĩkomaga rungu rwa mahũa ma maaĩ-inĩ,</para>
  <para style="q2" vid="JOB 40:21">ĩĩhithĩte thĩinĩ wa ithanjĩ kũrĩa kũrĩ mũtondo.<verse eid="JOB 40:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 40:22"/>Mahũa macio ma maaĩ-inĩ makamĩhitha;</para>
  <para style="q2" vid="JOB 40:22">nakĩo kĩĩruru kĩa mĩtĩ ya irura hũgũrũrũ-inĩ cia karũũĩ gĩkamĩthiũrũrũkĩria.<verse eid="JOB 40:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 40:23"/>Rĩrĩa rũũĩ ruoka na nditi, ndĩmakaga;</para>
  <para style="q2" vid="JOB 40:23">nĩngitĩre, o na Rũũĩ rwa Jorodani rũngĩmĩiyũrĩrĩra nginya kanua.<verse eid="JOB 40:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 40:24"/>Kũrĩ mũndũ ũngĩhota kũmĩnyiita rĩrĩa ĩĩhũũgĩte,</para>
  <para style="q2" vid="JOB 40:24">kana amĩtege, amĩtũrĩkie iniũrũ na amĩĩkĩre kĩana kĩa rũrigi?<verse eid="JOB 40:24"/></para>
  <para style="b"/>
  <chapter eid="JOB 40"/>
  <chapter number="41" style="c" sid="JOB 41"/>
  <para style="q1">
    <verse number="1" style="v" sid="JOB 41:1"/>“No ũhote kũguucũrũria nyamũ ĩrĩa ĩĩtagwo Leviathani na ndwano,</para>
  <para style="q2" vid="JOB 41:1">kana wohe rũrĩmĩ rwayo na mũkanda?<verse eid="JOB 41:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 41:2"/>No ũhote kũmĩtoonyia rũrigi iniũrũ,</para>
  <para style="q2" vid="JOB 41:2">kana ũmĩtũrĩkanie rũthĩa na ndwano?<verse eid="JOB 41:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 41:3"/>No ĩtinde ĩgĩgũthaitha ũmĩiguĩre tha?</para>
  <para style="q2" vid="JOB 41:3">No ĩkwarĩrie na ciugo cia ũhooreri?<verse eid="JOB 41:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 41:4"/>No ĩrĩkanĩre nawe ũthiĩ nayo,</para>
  <para style="q2" vid="JOB 41:4">ĩtũũre ĩrĩ ngombo yaku nginya tene?<verse eid="JOB 41:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 41:5"/>No ũhote kũmĩhooreria ta nyoni,</para>
  <para style="q2" vid="JOB 41:5">kana ũmĩoherere handũ nĩguo airĩtu aku mamĩmeemagie?<verse eid="JOB 41:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 41:6"/>Onjoria no mamĩkũũranie na indo ciao?</para>
  <para style="q2" vid="JOB 41:6">No mamĩgayanie kũrĩ onjorithia?<verse eid="JOB 41:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOB 41:7"/>No ũhote gũtheecanga rũũa rwayo na mĩcengi,</para>
  <para style="q2" vid="JOB 41:7">kana ũtheecange mũtwe wayo na mĩcengi ĩrĩa ĩtegaga thamaki?<verse eid="JOB 41:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOB 41:8"/>Ũngĩmĩhutia na guoko,</para>
  <para style="q2" vid="JOB 41:8">ũngĩtũũra ũririkanaga kĩgiano kĩu, na ndũngĩgacookera!<verse eid="JOB 41:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOB 41:9"/>Mwĩrĩgĩrĩro wa atĩ no ũmĩtoorie nĩ kwĩheenia;</para>
  <para style="q2" vid="JOB 41:9">o kũmĩona tu nĩkũiganĩte gũtũma mũndũ amake, orwo nĩ hinya.<verse eid="JOB 41:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOB 41:10"/>Gũtirĩ mũndũ ũrĩ ũcamba mũiganu wa kũmĩarahũra.</para>
  <para style="q2" vid="JOB 41:10">Nũũ ũngĩkĩhota kwĩĩndiiria niĩ?<verse eid="JOB 41:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOB 41:11"/>Nũũ ũngĩnandũra kĩndũ atĩ nĩguo ndĩmũrĩhe?</para>
  <para style="q2" vid="JOB 41:11">Kĩndũ gĩothe kĩrĩ rungu rwa igũrũ nĩ gĩakwa.<verse eid="JOB 41:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="JOB 41:12"/>“Ndikwaga kwaria ũhoro wa ciĩga ciayo,</para>
  <para style="q2" vid="JOB 41:12">o na wa hinya wayo, na wa ũthaka wayo.<verse eid="JOB 41:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOB 41:13"/>Nũũ ũngĩhota kũmĩaũra nguo yayo ya igũrũ?</para>
  <para style="q1" vid="JOB 41:13">Nũũ ũngĩmĩkuhĩrĩria amĩĩkĩre matamu?<verse eid="JOB 41:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOB 41:14"/>Nũũ ũngĩũmĩrĩria kũmĩathamia kanua,</para>
  <para style="q2" vid="JOB 41:14">kau kaiyũrĩte magego ma kũmakania?<verse eid="JOB 41:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOB 41:15"/>Mũgongo wayo ũrĩ na ngo ciĩiganĩrĩire mĩhari,</para>
  <para style="q2" vid="JOB 41:15">ikomanĩire ikanyiitana;<verse eid="JOB 41:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOB 41:16"/>o ĩmwe ĩnyiitanĩte na ĩrĩa ĩngĩ,</para>
  <para style="q2" vid="JOB 41:16">ũũ atĩ gũtirĩ rĩera rĩngĩtoonyera gatagatĩ ga cio.<verse eid="JOB 41:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOB 41:17"/>Igwatanĩtio hamwe irĩ nũmu;</para>
  <para style="q2" vid="JOB 41:17">inyiitanĩte hamwe ũndũ itangĩtigithũkana.<verse eid="JOB 41:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOB 41:18"/>Gũtiiha kwayo kũmenũkagia ũtheri;</para>
  <para style="q2" vid="JOB 41:18">maitho mayo nĩ ta mĩrũri ya rũciinĩ gũgĩthererũka.<verse eid="JOB 41:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOB 41:19"/>Imũrĩ cia mwaki ciumaga kanua-inĩ kayo;</para>
  <para style="q2" vid="JOB 41:19">ĩrathũkagia thandĩ cia mwaki.<verse eid="JOB 41:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOB 41:20"/>Ĩrutaga ndogo na maniũrũ</para>
  <para style="q2" vid="JOB 41:20">taarĩ nyũngũ ĩratherũka ĩhagĩrĩtwo igũrũ rĩa mwaki wa ithanjĩ.<verse eid="JOB 41:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOB 41:21"/>Mĩhũmũ yayo ĩgwatagia makara mwaki,</para>
  <para style="q2" vid="JOB 41:21">naruo rũrĩrĩmbĩ rũkoima kanua kayo.<verse eid="JOB 41:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="JOB 41:22"/>Ngingo-inĩ yayo nĩho hinya wayo ũkoragwo,</para>
  <para style="q2" vid="JOB 41:22">ũrĩa ũmakagia kĩrĩa gĩothe gĩtũnganaga nayo.<verse eid="JOB 41:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOB 41:23"/>Mĩgũtha ya nyama ciayo nĩmĩnyiitanu mũno;</para>
  <para style="q2" vid="JOB 41:23">nĩ mĩrũmu ũũ atĩ ndĩngĩenyenyeka.<verse eid="JOB 41:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOB 41:24"/>Ngoro yayo yũmĩte ta ihiga,</para>
  <para style="q2" vid="JOB 41:24">ĩkooma ta ihiga rĩa gũthĩa rĩa na thĩ.<verse eid="JOB 41:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="JOB 41:25"/>Rĩrĩa yarahũka, arĩa marĩ hinya nĩmamakaga;</para>
  <para style="q2" vid="JOB 41:25">mooraga ĩtanamahũũra.<verse eid="JOB 41:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOB 41:26"/>Gũtirĩ rũhiũ rwa njora rũngĩmĩĩka ũndũ,</para>
  <para style="q2" vid="JOB 41:26">o na kana itimũ, kana mũguĩ, kana mĩcengi.<verse eid="JOB 41:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOB 41:27"/>Harĩ Leviathani-rĩ, kĩgera no ta nyeki nyũmũ,</para>
  <para style="q2" vid="JOB 41:27">nakĩo gĩcango no ta gĩcunjĩ kĩbuthu kĩa mũtĩ.<verse eid="JOB 41:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="JOB 41:28"/>Mĩguĩ ndĩngĩtũma yũre;</para>
  <para style="q2" vid="JOB 41:28">mahiga ma kĩgũtha no ta mũũngũ harĩ yo.<verse eid="JOB 41:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOB 41:29"/>Harĩ yo njũgũma no ta gacunjĩ ka rũnyeki rũmũ;</para>
  <para style="q2" vid="JOB 41:29">ĩthekagĩrĩra kũbĩrĩrĩka gwa itimũ.<verse eid="JOB 41:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOB 41:30"/>Nda yayo nĩ ta rũgĩo rũrĩ na mageca;</para>
  <para style="q2" vid="JOB 41:30">ĩtigaga ngururo ndaka-inĩ ta cia ngaari iria ikonyoraga ngano.<verse eid="JOB 41:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOB 41:31"/>Ĩtũmaga iria kũrĩa kũriku gũtherũke ta nyũngũ,</para>
  <para style="q2" vid="JOB 41:31">na ĩkoiruga iria ta nyũngũ ya maguta ma kwĩhaka.<verse eid="JOB 41:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOB 41:32"/>Harĩa yagerera ĩtigaga mũhari ũkũhenia;</para>
  <para style="q2" vid="JOB 41:32">mũndũ no eciirie atĩ ndia ĩrĩ na mbuĩ.<verse eid="JOB 41:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="JOB 41:33"/>Gũtirĩ kĩndũ kĩngĩigananio nayo gũkũ thĩ;</para>
  <para style="q2" vid="JOB 41:33">nĩ kĩũmbe gĩtarĩ guoya.<verse eid="JOB 41:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="JOB 41:34"/>Ĩnyũrũragia kĩrĩa gĩothe gĩĩtũũgagĩria;</para>
  <para style="q2" vid="JOB 41:34">nĩyo mũthamaki wa kĩrĩa gĩothe gĩĩtĩĩaga.”<verse eid="JOB 41:34"/></para>
  <chapter eid="JOB 41"/>
  <chapter number="42" style="c" sid="JOB 42"/>
  <para style="s1">Mĩario ya Ayubu</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 42:1"/>Ningĩ Ayubu agĩcookeria Jehova, akĩmwĩra atĩrĩ:<verse eid="JOB 42:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOB 42:2"/>“Nĩnjũũĩ atĩ wahota gwĩka maũndũ mothe;</para>
  <para style="q2" vid="JOB 42:2">gũtirĩ mũbango waku ũngĩgirĩrĩka.<verse eid="JOB 42:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOB 42:3"/>Nĩworirie atĩrĩ, ‘Nũũ ũyũ ũrahithania kĩrĩra gĩakwa nĩ kwaga ũmenyo?’</para>
  <para style="q2" vid="JOB 42:3">Ti-itherũ ndaaririe maũndũ itaamenyete,</para>
  <para style="q2" vid="JOB 42:3">maũndũ ma magegania itangĩmenya.<verse eid="JOB 42:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="JOB 42:4"/>“Woigire atĩrĩ, ‘Thikĩrĩria rĩu, na niĩ njarie;</para>
  <para style="q2" vid="JOB 42:4">nĩngũkũũria ciũria, nawe nĩũkũnjookeria.’<verse eid="JOB 42:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOB 42:5"/>Matũ makwa nĩmaiguĩte ũhoro waku</para>
  <para style="q2" vid="JOB 42:5">no rĩu maitho makwa nĩgũkuona makuonete.<verse eid="JOB 42:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOB 42:6"/>Nĩ ũndũ ũcio nĩngwĩmena niĩ mwene,</para>
  <para style="q2" vid="JOB 42:6">na ndĩrire, ndĩhurĩrie rũkũngũ na mũhu.”<verse eid="JOB 42:6"/></para>
  <para style="s1">Ndeto cia Kũrĩkĩrĩria</para>
  <para style="p">
    <verse number="7" style="v" sid="JOB 42:7"/>Thuutha wa Jehova kwĩra Ayubu maũndũ macio-rĩ, nĩerire Elifazu ũrĩa Mũtemaani atĩrĩ, “Nĩndakarĩtio nĩwe na arata aku eerĩ, tondũ mũtiarĩtie ũhoro wakwa ũrĩa wagĩrĩire, ta ũrĩa ndungata yakwa Ayubu ĩĩkĩte. <verse eid="JOB 42:7"/><verse number="8" style="v" sid="JOB 42:8"/>Nĩ ũndũ ũcio, rĩu oyai ndegwa mũgwanja na ndũrũme mũgwanja, mũthiĩ kũrĩ ndungata yakwa Ayubu, mũkarute igongona rĩa njino nĩ ũndũ wanyu inyuĩ ene. Ndungata yakwa Ayubu nĩĩkamũhoera, na niĩ nĩngetĩkĩra mahooya make, na ndikamwĩka kũringana na ũrimũ wanyu. Mũtiarĩtie ũhoro wakwa ũrĩa wagĩrĩire ta ũrĩa ndungata yakwa Ayubu ĩĩkĩte.” <verse eid="JOB 42:8"/><verse number="9" style="v" sid="JOB 42:9"/>Nĩ ũndũ ũcio Elifazu ũrĩa Mũtemaani, na Bilidadi ũrĩa Mũshuhi, na Zofaru ũrĩa Mũnaamathi magĩĩka o ta ũrĩa Jehova aameerire; nake Jehova nĩetĩkĩrire ihooya rĩa Ayubu.<verse eid="JOB 42:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JOB 42:10"/>Thuutha wa Ayubu kũhoera arata ake-rĩ, Jehova nĩamũcookeirie ũtonga wake na akĩmũhe maita meerĩ ma indo iria aarĩ nacio mbere. <verse eid="JOB 42:10"/><verse number="11" style="v" sid="JOB 42:11"/>Ariũ na aarĩ a nyina othe, na mũndũ o wothe wamũũĩ mbere, magĩũka makĩrĩĩanĩra nake mũciĩ gwake, nao makĩmũhooreria na makĩmũcakaithia nĩ ũndũ wa mathĩĩna marĩa mothe Jehova aamũreheire. Andũ acio o mũndũ akĩmũhe gĩcunjĩ kĩa betha na gĩcũhĩ gĩa thahabu.<verse eid="JOB 42:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JOB 42:12"/>Jehova nĩarathimire matukũ ma mũthia ma muoyo wa Ayubu gũkĩra marĩa ma mbere. Nĩaagĩire na ngʼondu 14,000, na ngamĩĩra 6,000, na ndegwa cia kuohwo macooki 1,000, na ndigiri 1,000. <verse eid="JOB 42:12"/><verse number="13" style="v" sid="JOB 42:13"/>Nĩacookire akĩgĩa na aanake mũgwanja na airĩtu atatũ. <verse eid="JOB 42:13"/><verse number="14" style="v" sid="JOB 42:14"/>Mwarĩ wa mbere aamũtuire Jemima, na wa keerĩ aamũtuire Kezia, nake wa gatatũ akĩmũtua Kereni-Hapuku. <verse eid="JOB 42:14"/><verse number="15" style="v" sid="JOB 42:15"/>Gũtirĩ handũ o na ha bũrũri-inĩ wothe hangĩonekire andũ-a-nja athaka ta airĩtu a Ayubu, nake ithe wao akĩmahe igai hamwe na ariũ a nyina.<verse eid="JOB 42:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JOB 42:16"/>Thuutha wa maũndũ macio-rĩ, Ayubu nĩatũũrire mĩaka igana rĩa mĩrongo ĩna; akĩona ciana ciake na akĩona ciana ciacio, nginya rũciaro rwa kana. <verse eid="JOB 42:16"/><verse number="17" style="v" sid="JOB 42:17"/>Nake agĩkua arĩ mũkũrũ, na arĩ na mĩaka mĩingĩ.<verse eid="JOB 42:17"/></para>
  <chapter eid="JOB 42"/>
</usx>
