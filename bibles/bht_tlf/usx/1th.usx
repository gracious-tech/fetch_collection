  <para style="h">1 थिस्सलुनीकियों</para>
  <para style="toc1">1 थिस्सलुनीकिया दे ना प्रेरित पौलुस दी पेहली चिठ्ठी</para>
  <para style="toc2">1 थिस्सलुनीकियों</para>
  <para style="toc3">1 थिस्स</para>
  <para style="mt">1 थिस्सलुनीकिया दे ना प्रेरित पौलुस दी पेहली चिठ्ठी</para>
  <para style="is">जानकारी</para>
  <para style="ip">पौलुसे नोए भरोसा करणे बालयां जो उत्साहित करणे तांई ऐ चिठ्ठी लिखियो थी, ताकि जड़े लोक मरी गियो थे उना दी अनन्त अवस्था दे बारे च उना जो “प्रभु दे आगमन” (अध्याय 4:15), याद दिलाणे तांई आश्वासन देई सकन। कने उना जो ईश्वरीय जिन्दगी तांई प्रेरित करणा। पौलुसे उना जो शांति ला रेणे दा आग्रह किता। कने उना “सारे हालातां च धन्यवाद” दिया (अध्याय 5:18). थेस्सालोनिकी (वर्तमान थेस्सालोनिकी, ग्रीस) मेसेडोनिया दी राजधानी थी। ऐ जरूरी व्यापारे दे रस्तयां पर था। पौलुस, दो बरी लेखक दे रूपे च पछाणया गिया (अध्याय 1:1-2:18) अपणी दुज्जी मिशनरी यात्रा पर थेस्सालोनिकी दा दौरा किता पर यहूदियां दे बिरोध दिया बजा ला पलायन करणे तांई मजबूर होई गिया। उना तिमुथि जो बडे पैमाने पर होर जातियां दे चर्च सोगी कम्म करणे तांई भेजया, कने तिमुथिऐ उना जो उना दे भरोसे (अध्याय 3:6) दी अच्छी खबर दिती। ऐ पौलुसे दिया पेहलिया चे इक चिठ्ठी है, शायद ई स 51 च लिखया है।</para>
  <para style="iot">रूप रेखा</para>
  <para style="io1">अभिवादन 1:1-3</para>
  <para style="io1">थिस्सलुनीकियों दा भरोसा कने उदाहरण 1:4-3:13</para>
  <para style="io1">इक जिन्दगी जड़ी परमेश्वरे जो खुश करदी है 4:1-12</para>
  <para style="io1">जालू परमेश्वर बापस मुड़ी ओए तां क्या उम्मीद करें 4:13-5:11</para>
  <para style="io1">आखरी निर्देश कने अभिवादन 5:12-28</para>
  <chapter number="1" style="c" sid="1TH 1" />
  <para style="s">अभिवादन</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 1:1" />ऐ चिठ्ठी मैं पौलुस, सिलवानुस कने तीमुथियुस दिया तरफा ला थिस्सलुनीकिया शेहर दिया कलीसिया दे ना लिखा दा है, जड़े पिता परमेश्वर कने प्रभु यीशु मसीह च न। मैं प्राथना करदा है की पिता परमेश्वर तुहांजो पर अपणा अनुग्रह कने तुहांजो शांति दे।<verse eid="1TH 1:1" /></para>
  <para style="s">थिस्स्लुनीकियां दा भरोसा</para>
  <para style="p">
    <verse number="2" style="v" sid="1TH 1:2" />असां अपणियां प्राथना च तुहांजो याद करदे कने हमेशा तुसां सबना दे बारे च परमेश्वरे दा धन्यवाद करदे न, <verse eid="1TH 1:2" /><verse number="3" style="v" sid="1TH 1:3" />कने जालू असां अपणे पिता परमेश्वरे ने प्राथना करदे न, तालू असां तुहाड़े उना कम्मा जो याद करदे न, जड़े तुसां भरोसे दिया बजा ला करदे न, कने जड़िया सकत मेहनता ने तुसां मसीह भाईयां दी सहायता करदे न क्योंकि तुसां उना ने प्यार करदे न कने दुख तकलिफा जो सेहन करदे न क्योंकि तुहांजो आस है, की प्रभु यीशु मसीह जल्दी बापस ओणे बाला है।<verse eid="1TH 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1TH 1:4" />हे मेरे मसीह भाईयो, तुहांजो ने परमेश्वर बड़ा प्यार करदा है, असां जाणदे न, की परमेश्वरे तुहांजो अपणे लोक होणे तांई चुणया है। <verse eid="1TH 1:4" /><verse number="5" style="v" sid="1TH 1:5" />क्योंकि प्रभु यीशु मसीह दा शुभसमाचार तुहाड़े बाल सिर्फ अखरां च ही नी पर पबित्र आत्मा दिया शक्तिया, कने पूरी मजबुतिया ने तुहाड़े बाल पूज्या है, तुहांजो पता है की तुहाड़े उद्धार तांई तुसां बिच साड़ा चाल चलन कदिया था।<verse eid="1TH 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TH 1:6" />तुसां बड़े भरी दुखां च थे पर तुसां पबित्र आत्मा दी दीतियो खुशिया सोगी शुभसमाचार जो अपनाई करी साड़े उदाहरण कने प्रभु दे उदाहरण दा अनुसरण किता। <verse eid="1TH 1:6" /><verse number="7" style="v" sid="1TH 1:7" />ऐथू दीकर की तुसां मकिदुनिया प्रदेश कने अखाया प्रदेशे दे सारे विश्वासियां तांई आदर्श बणी गे।<verse eid="1TH 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TH 1:8" />क्योंकि तुहाड़े ऐथू ला ना सिर्फ मकिदुनिया प्रदेश कने अखाया प्रदेशे च प्रभु दा बचन सुणाया, पर तुहाड़े भरोसे दी चर्चा हर पासे फेली गेई जड़ा परमेश्वरे पर है, हर जगा जिथू असां गे, ओथु सांझो लोक मिल्ले जिना सांझो तुहाड़े भरोसे दे बारे च दसया, जड़ा परमेश्वरे पर है, इस तांई सांझो तुहाड़े बारे च कुछ बोलणे दी जरूरत नी है। <verse eid="1TH 1:8" /><verse number="9" style="v" sid="1TH 1:9" />क्योंकि सै लोक अपु ही दुज्जयां जो दसदे न की तुसां साड़ा स्वागत किता जालू असां तुहाड़े बाल आऐ; कने तुसां कजो मूर्तियां ला दूर होईकरी परमेश्वरे बाल आये ताकि तुसां जिन्दे कने सच्चे परमेश्वरे दी सेबा करन। <verse eid="1TH 1:9" /><verse number="10" style="v" sid="1TH 1:10" />कने तुसां स्वर्गे ला परमेश्वरे दे पुत्रे दे ओणे दी आस रखा दे न, जिसयो परमेश्वरे मरयां चे जिन्दा किता, मतलब की यीशुऐ जो, जड़ा सांझो परमेश्वरे दे ओंणे बाले गुस्से ला बचादां है।<verse eid="1TH 1:10" /></para>
  <chapter eid="1TH 1" />
  <chapter number="2" style="c" sid="1TH 2" />
  <para style="s">पौलुस दे प्रचारे दा कम्म</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 2:1" />हे मसीह भाईयो, तुहांजो अपु ही पता है, साड़ा तुहाड़े बाल ओंणा फायदेमंद होया। <verse eid="1TH 2:1" /><verse number="2" style="v" sid="1TH 2:2" />तुसां अपु ही जाणदे न की तुहाड़े बाल ओणे ला पेला असां फिलिप्पी शेहरे च कितणे दुख झेले। फिर भी परमेश्वरे सांझो इतणी हिम्मत दिती, की तुहाड़े शेहरे दे लोकां ला साड़ा इतणा बिरोध होणे बाद भी असां परमेश्वरे दा शुभसमाचार तुहांजो सुणाया।<verse eid="1TH 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TH 2:3" />क्योंकि साड़ा उपदेश ना तां धोखा था, कने ना ही गलत इरादे ने, कने ना ही छलावा है। <verse eid="1TH 2:3" /><verse number="4" style="v" sid="1TH 2:4" />परमेश्वरे सांझो काबिल समझीकरी शुभसमाचार दितया है, इस तांई असां माणुआं जो नी, पर असां मना जो परखणे बाले परमेश्वरे जो खुश करणे तांई उपदेश दिन्दे न।<verse eid="1TH 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1TH 2:5" />तुहांजो पता है, की असां कदी भी चापलूसी दियां गल्लां नी करदे थे, क्योंकि असां ना ही कदी पैसे दे लालचे दे इरादे ने कुछ किता, परमेश्वर इसा गल्ला दा गबाह है की असां ऐसे नी थे। <verse eid="1TH 2:5" /><verse number="6" style="v" sid="1TH 2:6" />असां ना माणुऐ ला, ना ही तुहाड़े ला कने ना ही कुसी होरसी ला आदर नी चांदे थे। पर मसीह दे प्रेरित होणे दिया बजा ला तुसां ला सहायता मंगणा साड़ा हक था।<verse eid="1TH 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1TH 2:7" />पर जियां माता-पिता अपणे बचयां जो पालदे न, तियां ही असां भी तुहाड़े बिच रेई के इयुदी दीनता दसियो है। <verse eid="1TH 2:7" /><verse number="8" style="v" sid="1TH 2:8" />असां तुहांजो सोगी इतणा प्यार करदे न की सिर्फ परमेश्वरे दा शुभसमाचार सुणने तांई ही नी पर तुहाड़े तांई अपणी जान देंणे तांई भी तैयार थे। इस तांई की असां तुहाड़े सोगी बड़ा प्यार करदे थे। <verse eid="1TH 2:8" /><verse number="9" style="v" sid="1TH 2:9" />हे मसीह भाईयो, तुसां साड़ी मेहनत कने प्यारे जो याद रखदे न, की असां इस तांई रात दिन कम्म धंधे करदे होये परमेश्वरे दे शुभसमाचारे दा प्रचार तुहाड़े च किता, ताकि असां अपणी जरुरतां तांई तुसां कुसी पर भी कोई बोझ ना बणन।<verse eid="1TH 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1TH 2:10" />तुसां अपु भी कने परमेश्वर भी गबाह है, तुसां विश्वासियां सोगी साड़ा सभाव कितणा सच्चा, धर्मी कने निर्दोष था। <verse eid="1TH 2:10" /><verse number="11" style="v" sid="1TH 2:11" />तुहांजो पता है, की जियां पिता परमेश्वर अपणे बचयां सोगी बर्ताब करदा है, तियां ही असां भी तुसां सबना जो उपदेश, कने प्रोत्साहित करदे, कने समझांदे थे। <verse eid="1TH 2:11" /><verse number="12" style="v" sid="1TH 2:12" />की तुसां अपणी जिन्दगी इस तरीके ला जिया जड़ी परमेश्वरे जो खुश करे, जड़ा तुहांजो अपणे राज्य कने माहिमा च हिस्सेदार होणे तांई सददा है।<verse eid="1TH 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 2:13" />इस तांई असां भी हमेशा परमेश्वरे दा धन्यावाद करदे न; की जालू तुसां परमेश्वरे दा संदेश सुणया जड़ा असां प्रचार किता, तां तुसां उसयो माणुऐ दा नी पर परमेश्वरे दा सच्चा संदेश समझी के अपनाया, सै ही संदेश तुसां च कम्म करदा है, जड़े यीशु मसीह पर भरोसा रखदे न।<verse eid="1TH 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1TH 2:14" />हे मसीह भाईयो, इस तांई तुसां भी परमेश्वरे पर भरोसा करणे बाले लोकां सांई न, जड़े यहूदी प्रदेश च रेंदे न कने मसीह च न, क्योंकि तुहांजो भी अपणे लोकां ला तदिया ही दुख मिल्ला जदिया यहूदी मसीह लोकां जो यहूदियां ला मिल्ला था। <verse eid="1TH 2:14" /><verse number="15" style="v" sid="1TH 2:15" />उना यहूदियां जिना प्रभु यीशुऐ जो, कने परमेश्वरे दे संदेश देणेबालयां जो मारी दिता कने सांझो तंग किता, कने परमेश्वर उना ला खुश नी है, कने सै सारे माणुआं दा बिरोध करदे न। <verse eid="1TH 2:15" /><verse number="16" style="v" sid="1TH 2:16" />सै सांझो होर जातियां जो ऐ दसणे ला रोकणे दी कोशिश करा दे थे की परमेश्वर उना जो कियां बचाई सकदा है कने सै अपणे पाप पर पाप जोड़दे जांदे न; कने हुण अंत च परमेश्वर उना जो पक्का सजा देणेबाला है।<verse eid="1TH 2:16" /></para>
  <para style="s">कलीसिया ने मिलणे दी इच्छा</para>
  <para style="p">
    <verse number="17" style="v" sid="1TH 2:17" />हे मेरे प्यारे मसीह भाईयो, जालू असां थोड़ी देरा तांई मने ला नी पर, असां शारीरक रूप ला तुहाड़े सोगी नी थे, तां असां बड़ी इच्छा ला तिजो दिखणे तांई होर भी जादा कोशिश किती। <verse eid="1TH 2:17" /><verse number="18" style="v" sid="1TH 2:18" />इस तांई असां (मतलब की मैं पौलुसे) इक बरी नी, पर केई बरी तुहाड़े बाल औणे दी सोची, पर शैतान सांझो तुहाड़े बाल ओणे तांई रोकदा था। <verse eid="1TH 2:18" /><verse number="19" style="v" sid="1TH 2:19" />साड़ी आस, खुशी या बड़ाई दा मुकट कुण है? ऐ तुसां ही होणे जालू साड़े प्रभु यीशु मसीहे फिरी मुड़ी करी ओणा है। <verse eid="1TH 2:19" /><verse number="20" style="v" sid="1TH 2:20" />साड़ी बड़ाई कने खुशी तुसां ही न।<verse eid="1TH 2:20" /></para>
  <chapter eid="1TH 2" />
  <chapter number="3" style="c" sid="1TH 3" />
  <para style="s">तीमुथियुस दा भेजया जाणा</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 3:1" />आखरी च जालू असां तुहांजो मिलयो बिना नी रेई सके, तां मैं पौलुस कने सिलासे एथेंस शेहरे च किल्ले रेणे दा फेसला किता। <verse eid="1TH 3:1" /><verse number="2" style="v" sid="1TH 3:2" />कने असां तीमुथियुस जो जड़ा मसीह दे शुभसमाचारे च साड़ा भाई है, कने परमेश्वरे दा सेवक है, उसयो इस तांई तुहाड़े बाल भेजया की सै तुहांजो प्रोत्साहित करे कने तुहाड़े मसीह पर भरोसे जो मजबूत करे। <verse eid="1TH 3:2" /><verse number="3" style="v" sid="1TH 3:3" />ताकि कोई इना दुखां दिया बजा ला भरोसे च कमजोर ना होई जाऐ; क्योंकि तुसां अपु ही जाणदे न, की सांझो मसीह च दुख झेलणे पोणे न।<verse eid="1TH 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1TH 3:4" />जालू असां तुहाड़े ओथु रेंदे थे, उस बकत तुहांजो बोलदे थे कि, सांझो लोकां ला दुख झेलणे पोणे न, कने इयां ही होया, कने तुसां जाणदे भी हेन। <verse eid="1TH 3:4" /><verse number="5" style="v" sid="1TH 3:5" />इसा बजा ला जालू मिंजो ला तुहांजो मिलयो बिना नी रिया गिया, तां मैं तुसां लोकां दे भरोसे दा हाल जाणने तांई तीमुथियुस जो भेजया, क्योंकि असां डरदे थे, कुथी इयां ना हो की परिक्षा करणे बाले शैताने तुहाड़ी परिक्षा लेई हो, कने साड़ी मेहनत बेकार होई गेई हो।<verse eid="1TH 3:5" /></para>
  <para style="s">तीमुथियुस दे जरिये खबर मिलणा</para>
  <para style="p">
    <verse number="6" style="v" sid="1TH 3:6" />पर हुण तीमुथियुसे तुहाड़े बखे ला आई करी तुहाड़े भरोसे कने प्यार दा शुभसमाचार सुणाया। कने ऐ भी सुणाया, की तुसां हमेशा प्यारे ला मिंजो याद करदे न, कने सांझो दिखणे दी इच्छा रखदे न, जियां असां तुहांजो दिखणे दी इच्छा रखदे थे। <verse eid="1TH 3:6" /><verse number="7" style="v" sid="1TH 3:7" />इस तांई हे मसीह भाईयो, असां अपणी सारी दुख तकलिफां च जालू तीमुथियुस ला सुणया की तुसां भरोसे च मजबूत न, तां सांझो बड़ी शांति मिल्ली।<verse eid="1TH 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TH 3:8" />क्योंकि हुण तुसां प्रभु च टिकी रेंगे, तां इसला सांझो नोई जिंदगी मिलदी है। <verse eid="1TH 3:8" /><verse number="9" style="v" sid="1TH 3:9" />कने जदेई खुशी तुहाड़िया बजा ला सांझो अपणे परमेश्वरे सामणे है, इसा खुशिया तांई तुहाड़े बारे च असां कियां परमेश्वरे अग्गे धन्यावाद करन? <verse eid="1TH 3:9" /><verse number="10" style="v" sid="1TH 3:10" />असां लगातार ऐई प्राथना करदे रेंदे न, की तुहांजो सोगी दुबारा मिली सकन, कने जड़ा जरूरी है तुहांजो सिखाई सकन, ताकि तुसां पुरे तरीके ला प्रभु यीशु मसीह पर भरोसा करी सकन।<verse eid="1TH 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TH 3:11" />साड़ी ऐ प्राथना है, की साड़ा पिता परमेश्वर कने प्रभु यीशु मसीह, तुहाड़े ऐथू औणे तांई साड़ी सहायता करे की असां आई सकन। <verse eid="1TH 3:11" /><verse number="12" style="v" sid="1TH 3:12" />असां ऐ भी प्राथना करदे न की प्रभु यीशु मसीह ऐसा करे कि, जियां असां तुहांजो ने प्यार करदे न, तियां ही तुसां भी इक दुज्जे ने प्यार करा, कने सारयां लोकां सोगी तुहाड़ा प्यार होर भी बदे कने बददा ही जा, <verse eid="1TH 3:12" /><verse number="13" style="v" sid="1TH 3:13" />कने असां प्राथना करदे न ताकि सै तुहाड़े मना जो ऐसा मजबूत करे, की जालू साड़ा प्रभु यीशु अपणे सारे पबित्र लोकां सोगी बापस ओऐ, तां सै साड़े पिता परमेश्वरे सामणे पबित्रता च निर्दोष साबित होन।<verse eid="1TH 3:13" /></para>
  <chapter eid="1TH 3" />
  <chapter number="4" style="c" sid="1TH 4" />
  <para style="s">जिन्दगी जड़ी परमेश्वरे जो खुश करे</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 4:1" />आखरी च हे मेरे मसीह भाईयो, असां प्रभु यीशु मसीह दे नाऐ ला तुहांजो ला बिनती करदे न, की तुसां इस तरिके ला जिंदगी जिया, जड़ी परमेश्वरे जो खुश करे, जियां असां तुहांजो सिखाया, कने तुसां तियां जिंदगी जिंदे भी हेन कने असां तुहांजो ऐसा करणे तांई होर भी उत्साहित करदे न। <verse eid="1TH 4:1" /><verse number="2" style="v" sid="1TH 4:2" />तुसां जाणदे न कि प्रभु यीशु मसीहे सांझो जड़ा अधिकार दितया है, उदे जरिये असां तुहांजो निर्देश दितयो न।<verse eid="1TH 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TH 4:3" />परमेश्वरे दी इच्छा ऐ है, की तुसां पबित्र बणन कने व्यभिचार मत करा, <verse eid="1TH 4:3" /><verse number="4" style="v" sid="1TH 4:4" />तुसां चे हर इक माणु अपणे शरीरे पर काबू रखणा सीखी करी अपणे शरीरे जो पबित्र बणाई रखे कने उदी इज्जत करे। <verse eid="1TH 4:4" /><verse number="5" style="v" sid="1TH 4:5" />कने तुसां जो ऐ कम्म होर जातियां सांई वासना दी इच्छा ला नी करणे चाइदे, जड़ियां परमेश्वरे जो नी जाणदियां न। <verse eid="1TH 4:5" /><verse number="6" style="v" sid="1TH 4:6" />ऐसे कम्म करणे ला सै अपणे मसीह भाई दे खिलाफ पाप करदा है, कने ना ही कोई उस सोगी चलाकी करा, क्योंकि प्रभुये इना सारयां जो सजा देणी है, जड़े इयुदियां चीजां करदे न; जदिया असां तुहांजो पेहले भी बोलया कने समझाया था।<verse eid="1TH 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1TH 4:7" />क्योंकि परमेश्वरे सांझो अपबित्र जिन्दगी जिणे तांई नी पर पबित्र जिन्दगी जिणे तांई सदया है। <verse eid="1TH 4:7" /><verse number="8" style="v" sid="1TH 4:8" />इस तांई जड़ा इना हुकमा जो नी मनदा है, सै साड़े हुकमा जो नी, पर परमेश्वरे दे हुकमा जो नी मनदा है, जिनी अपणी पबित्र आत्मा तुहांजो दितियो है।<verse eid="1TH 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 4:9" />पर मसीह भाईयां दे प्यारे दे बारे च ऐ जरूरी नी है, कि मैं तुहांजो कुछ लिखें, क्योंकि इक दुज्जे सोगी प्यारे ला रेणा तुसां अपु ही परमेश्वरे ला सिखया है; <verse eid="1TH 4:9" /><verse number="10" style="v" sid="1TH 4:10" />कने सारे मकिदुनिया प्रदेशे दे मसीह भाईयां सोगी प्यार रखया है, पर हे मसीह भाईयो, असां तुहांजो ला ऐ बिनती करदे न की तुसां होर भी अग्गे बददे जा, <verse eid="1TH 4:10" /><verse number="11" style="v" sid="1TH 4:11" />कने जदिया असां तुहांजो समझाया है, तियां ही शान्ति ने जिन्दगी जिया कने ना ही दुज्जयां दे कम्मा च दखल दिया कने अपणे हथां ला कमाणे दी कोशिश करा। <verse eid="1TH 4:11" /><verse number="12" style="v" sid="1TH 4:12" />ताकि जड़े लोक यीशु मसीह पर भरोसा नी करदे, सै दिखी सकन की तुहाड़ा व्यवहार कदिया है, कने लोक तुहाड़ी इज्जत करन, कने तुहांजो कुसी भी जुरूरतां तांई दुजयां पर निर्भर ना होणा पोऐ।<verse eid="1TH 4:12" /></para>
  <para style="s">यीशु मसीह दा दुबारा बापस ओणा</para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 4:13" />हे मसीह भाईयो, असां चांदे न, की तुसां ऐ जाणी लिया की जड़े मसीह च मरी गियो न, इना सोगी क्या होणा; इयां नी हो की तुसां दुजयां सांई शोक करा जिना जो आस नी है की मरणे बाद भी जिन्दगी है। <verse eid="1TH 4:13" /><verse number="14" style="v" sid="1TH 4:14" />असां भरोसा करदे न की यीशु मरया, कने जिन्दा होया, तां तियां ही परमेश्वरे उना जो भी जड़े यीशु च सोई गियो न, यीशु मसीह सोगी बापस लेई ओणा है।<verse eid="1TH 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1TH 4:15" />असां प्रभु यीशु मसीह दे बचना दे अनुसार तुहांजो ऐ बोलदे न, की असां जड़े जिंदे न, कने प्रभु यीशु मसीहे दे बापस ओणे दीकर बची रेंगे, तां जड़े लोक पेहले यीशु मसीह च मरी गियो न, उना पेहले यीशु मसीह ने मिलणा।<verse eid="1TH 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1TH 4:16" />क्योंकि प्रभु यीशु मसीहे अपु ही स्वर्गे ला उतरणा; उस बकत प्रभु यीशुऐ जोरे ने हुकम देणा, कने प्रधान स्वर्गदूतां जोरे ला बोलणा, कने परमेश्वरे दी तुरही बजाणी; कने उस बकत जड़े पेहले यीशु मसीहे पर भरोसा करदे होए मरी गियो न, उना मरयां चे जी पोणा है। <verse eid="1TH 4:16" /><verse number="17" style="v" sid="1TH 4:17" />तालू इदे बाद असां जड़े जिन्दे कने बचयो रेंगे, उना सोगी बदला च चुकी लेई जाणे, ताकि बदलां च प्रभु यीशु मिलन, कने उस बकते ला असां हमेशा प्रभु सोगी रेणा। <verse eid="1TH 4:17" /><verse number="18" style="v" sid="1TH 4:18" />इना गल्लां ला इक दुज्जे जो दिलासा दिया करा।<verse eid="1TH 4:18" /></para>
  <chapter eid="1TH 4" />
  <chapter number="5" style="c" sid="1TH 5" />
  <para style="s">यीशु दे दुबारा ओणे तांई तैयार रेनयो</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 5:1" />हे मेरे मसीह भाईयो, तुहांजो ऐ दसणे दी जरूरत नी है, की प्रभु यीशु मसीहे कालू ओणा है। <verse eid="1TH 5:1" /><verse number="2" style="v" sid="1TH 5:2" />क्योंकि तुसां अपु जाणदे न की जियां राती जो चोर अचानक आई जांदा है, तियां ही प्रभु यीशु मसीहे दा आगमन भी अचानक होणा। <verse eid="1TH 5:2" /><verse number="3" style="v" sid="1TH 5:3" />जालू लोक बोलगे, ठीक ठाक है, कने कोई डर नी, तालू उना जो इकदम दुख तकलिफां दा सामणा करणा पोंणा है, जियां गर्भबती जो इकदम पीड़ पौंदी; तालू सै कुथी भी नठी नी सकदी, तियां ही सै उसा बड़िया मुसीबता ला कुसी भी तरीके ला नी बची सकणा।<verse eid="1TH 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1TH 5:4" />पर हे मसीह भाईयो, तुसां जड़े नेहरे च नी न कने सै दिन तुहाड़े पर चोरां सांई आई पोऐ जिस दिन यीशु मसीहे बापस ओणा। <verse eid="1TH 5:4" /><verse number="5" style="v" sid="1TH 5:5" />क्योंकि तुसां सारे जड़े ज्योति ने रिशता रखदे न, कने दिने दी ओलाद न, असां ना तां राती ने, कने ना ही नेहरे ने रिशता रखदे न। <verse eid="1TH 5:5" /><verse number="6" style="v" sid="1TH 5:6" />इस तांई सांझो अविश्वासियां सांई सोंदे नी रेन, पर जागदे कने सावधान रिया। <verse eid="1TH 5:6" /><verse number="7" style="v" sid="1TH 5:7" />क्योंकि जड़े सोंदे न, सै राती ही सोंदे न, कने जड़े मतवाले होंदे न, सै राती ही मतवाले होंदे न। <verse eid="1TH 5:7" /><verse number="8" style="v" sid="1TH 5:8" />पर असां तां दिने दी ओलाद न, इस तांई सांझो अपणे पर काबू रखणा चाईदा। साड़ी भरोसा कने प्यार साड़ी रक्षा करे जियां कबच इकी सिपाइये दी रक्षा करदा है, कने साड़े बाल उद्धारे दी आस है, कि असां हमेशा दिया सजा ला बची गियो न, जियां टोप सिपाइये जो बचादां है।<verse eid="1TH 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 5:9" />क्योंकि परमेश्वरे सांझो सजा देणे तांई नी चुणया है, पर इस तांई रखया की असां अपणे प्रभु यीशु मसीहे ला उद्धार पाई सकन। <verse eid="1TH 5:9" /><verse number="10" style="v" sid="1TH 5:10" />प्रभु यीशु मसीह साड़े तांई इस बजा ने मरया, की असां चाऐ जिन्दे रेन, या मरी जान, जालू प्रभु यीशु मसीहे बापस ओणा तालू असां हमेशा उदे सोगी रेई सकन। <verse eid="1TH 5:10" /><verse number="11" style="v" sid="1TH 5:11" />इसा बजा ने इक दुज्जे जो प्रोत्साहित करा, कने इक दुज्जे जो भरोसे च मजबूत होणे तांई सहायता करा, कने ऐसा तुसां करदे भी हेन।<verse eid="1TH 5:11" /></para>
  <para style="s">कलीसिया जो उपदेश</para>
  <para style="p">
    <verse number="12" style="v" sid="1TH 5:12" />हे मसीह भाईयो, असां तुसां ने विनती करदे न, की जड़े तुहांजो चे बड़ी मेहनत करदे न, कने प्रभु च तुहाड़े अगुवे न, कने तुहांजो शिक्षा दिन्दे न, उना दे हुकम मन्ना। <verse eid="1TH 5:12" /><verse number="13" style="v" sid="1TH 5:13" />क्योंकि जड़ा सै तुहाड़े तांई करदे न, उस तांई उना दी अच्छे ने इज्जत कने प्यार करा कने अपु चे मिली झुली की रिया।<verse eid="1TH 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1TH 5:14" />हे मसीह भाईयो, असां तुहांजो ने विनती करदे न, उना जो चेतावनी दिया, जड़े बड़े आलसी न, डरफोकां जो होंसला दिया, जड़े कमजोर न उना दी सहायता करा, सबना जो सेहनशीलता दस्सा। <verse eid="1TH 5:14" /><verse number="15" style="v" sid="1TH 5:15" />ऐ ध्यान रखा! कोई कुसी ने बुराईया दे बदले बुराई ना करे; तुसां हमेशा इक दुज्जे कने सारयां तांई भले कम्म करणे च लगी रिया।<verse eid="1TH 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1TH 5:16" />हमेशा खुश रिया। <verse eid="1TH 5:16" /><verse number="17" style="v" sid="1TH 5:17" />लगातार प्राथना करदे रिया। <verse eid="1TH 5:17" /><verse number="18" style="v" sid="1TH 5:18" />अपणे हर हालातां च परमेश्वरे दा धन्यावाद करा; क्योंकि यीशु मसीह च तुहाड़ी तांई परमेश्वरे दी ऐई इच्छा है।<verse eid="1TH 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1TH 5:19" />पबित्र आत्मा दे कम्मा जो लोकां दी जिन्दगी च होणे ला मत रोका। <verse eid="1TH 5:19" /><verse number="20" style="v" sid="1TH 5:20" />ऐ मत सोचा की जड़ियां भविष्यवाणियां परमेश्वरे अपणे लोकां जो दितियां सै कुसी कम्मे दियां नी न। <verse eid="1TH 5:20" /><verse number="21" style="v" sid="1TH 5:21" />पर हर इक गल्ला दी परख करा ऐ जाणने तांई की सै परमेश्वरे दा संदेश है की नी, जड़ियां गल्लां खरियां न उना गल्लां जो ही अपना। <verse eid="1TH 5:21" /><verse number="22" style="v" sid="1TH 5:22" />सारियां बुराईयां ला बची के रिया।<verse eid="1TH 5:22" /></para>
  <para style="s">आशीर्वाद</para>
  <para style="p">
    <verse number="23" style="v" sid="1TH 5:23" />परमेश्वर जड़ा शांति दिन्दा है, तुहांजो हर तरा ने पबित्र करे; कने तुहाड़ी आत्मा, प्राण कने शरीर साड़े प्रभु यीशु मसीह दे बापस ओणे दीकर पूरे निर्दोष कने ठीक रेन। <verse eid="1TH 5:23" /><verse number="24" style="v" sid="1TH 5:24" />तुहांजो सदणे बाला भरोसे दे काबिल है, क्योंकि सै तुहांजो पबित्र होणे तांई सददा है, कने उनी पबित्र बणने दे काबिल भी बणाणा है।<verse eid="1TH 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1TH 5:25" />हे मसीह भाईयो, साड़े तांई प्राथना करा।<verse eid="1TH 5:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1TH 5:26" />सारे मसीह भाईयां जो प्यारे ने नमस्ते करा।<verse eid="1TH 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1TH 5:27" />मैं तुहांजो प्रभु दा हुकम दिन्दा है, की ऐ चिठ्ठी सारे मसीह भाईयां जो पढ़ी करी सुणा।<verse eid="1TH 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1TH 5:28" />मैं प्राथना करदा है की साड़े प्रभु यीशु मसीह दा अनुग्रह हमेशा तुसां सारयां पर होंदा रे।<verse eid="1TH 5:28" /></para>
  <chapter eid="1TH 5" />
</usx>