  <para style="h">2 यूहन्ना</para>
  <para style="toc1">2 यूहन्ना दी दुज्जी चिठ्ठी</para>
  <para style="toc2">2 यूहन्ना</para>
  <para style="toc3">2 यूहन्ना</para>
  <para style="mt">2 यूहन्ना दी दुज्जी चिठ्ठी</para>
  <para style="is">जानकारी</para>
  <para style="ip">यूहन्ना इक मसीही जिन्दगी च प्यार दे महत्व दे बारे च दुबारा ला लिखदा है। सै दसदा है कि सत्य कने प्रेम जो सोगी चलणा पोंणा। सांझो ऐ भी मनणा चाईदा कि मसीह असल च माणु थे, कने इक दुज्जे ला प्रेम करणा चाईदा।</para>
  <para style="iot">रूप रेखा</para>
  <para style="io1">अभिवादन कने प्रार्थना (1-3)</para>
  <para style="io1">सत्य कने प्रेम (4-11)</para>
  <para style="io1">आखरी अभिवादन (12-13)</para>
  <chapter number="1" style="c" sid="2JN 1" />
  <para style="s">अभिवादन</para>
  <para style="p">
    <verse number="1" style="v" sid="2JN 1:1" />मैं यूहन्ना कलीसिया दा अगुवा, मैं ऐ चिठ्ठी उसा आदरणीय जनानिया जो कने उसा दे बच्चयों जो लिखा दा है, जिना जो परमेश्वरे चुणया है। मैं सच्ची तुहांजो ने प्यार करदा है, कने सिर्फ मैं ही नी पर सै सारे भी प्यार करदे न, जड़े परमेश्वरे दी सच्चाईया पर भरोसा रखदे न। <verse eid="2JN 1:1" /><verse number="2" style="v" sid="2JN 1:2" />असां तिजो ला इस तांई प्यार करदे क्योंकि सच्ची शिक्षा साड़े मना च बणियो है सै हमेशा साड़े सोगी बणी रेणी है।<verse eid="2JN 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2JN 1:3" />परमेश्वर पिता कने उदे पुत्र यीशु मसीह दिया तरफा ला अनुग्रह, दया कने शांति असां सारयां सोगी बणी रे। जड़े सच्च जो मंदे कने इक दुज्जे ने प्यार करदे न।<verse eid="2JN 1:3" /></para>
  <para style="s">सच्च कने प्यार</para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4" />मैं बड़ा खुश होया जालू मैं तेरे कुछ बचयां दे बारे च सुणया की सै सचाई ने जिन्दगी जी दे न, सै बिलकुल सै ही करा दे न जड़ा साड़े पिता परमेश्वरे करणे जो बोलया। <verse eid="2JN 1:4" /><verse number="5" style="v" sid="2JN 1:5" />हुण हे आदरनीय जनानी, मैं तिजो ला विनती करदा है, की सांझो इक दुज्जे ने हमेशा प्यार करणा चाईदा। ऐ कोई नोआ हुकम नी है पर सेई हुकम है जिसयो असां उस बकते ला जाणदे न जालू असां मसीह दे पिच्छे चलणा शुरू कितया था। <verse eid="2JN 1:5" /><verse number="6" style="v" sid="2JN 1:6" />सच्चा प्यार सै है जड़ा असां तालू करदे न जालू असां परमेश्वर दे हुकमा जो मंदे न, जालू ला असां मसीह दे पिच्छे चलणा शुरू कितया है, तालू ला असां सुणया है की परमेश्वरे तुहांजो हुकम दितया है की तुहांजो हमेशा इक दुज्जे ने प्यार करदे रेणा चाईदा।<verse eid="2JN 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2JN 1:7" />मैं ऐ इस तांई बोला दा है क्योंकि केई लोक न जड़े झूठे उपदेश दिन्दे न सै मतियां जगां च गियो न, सै बोलदे न की यीशु मसीह माणुऐ दे रुपे च इसा दुनिया च नी आया है। जड़ा कोई ऐ नी मंदा की यीशु माणुऐ दे रुपे इसा धरती च नी आया है तां सै माणु मसीह दा बिरोधी है कने लोकां जो हमेशा धोखा दिंदा है। <verse eid="2JN 1:7" /><verse number="8" style="v" sid="2JN 1:8" />इस तांई तुसां ऐ ध्यान रखा की ऐ लोक तुहांजो धोखा ना देन, ताकि परमेश्वरे दी सेबा तांई कितियो मेहनत बेकार ना होई जा कने परमेश्वरे तुहाड़ी सेबकाई तांई तुहांजो पूरा इनाम देणा।<verse eid="2JN 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2JN 1:9" />जड़े लोक सच्ची शिक्षा ला भटकी जांदे न कने मसीह दी शिक्षा जो नी मंदे न, सै परमेश्वरे सोगी संगती च नी न। जड़े लोक यीशु मसीह दी शिक्षा जो मंदे न सै परमेश्वरे सोगी कने उदे पुत्र यीशु सोगी संगती च न। <verse eid="2JN 1:9" /><verse number="10" style="v" sid="2JN 1:10" />अगर कोई तुहाड़े बाल आऐ कने कुछ सिखा दा है, जड़ा मसीह यीशु दी सिक्षा ला लग है। ना तां उदी मेहमान नबाजी करा, कने ना ही उसयो नमस्ते करा। <verse eid="2JN 1:10" /><verse number="11" style="v" sid="2JN 1:11" />क्योंकि जड़ा कोई ऐसे माणुआं दा स्वागत करदा है, सै उदे बुरे कम्मा च हिस्सेदार होंदा है जड़ा सै करदा है।<verse eid="2JN 1:11" /></para>
  <para style="s">आखरी अभिवादन</para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12" />मैं होर भी मतियां गल्लां तुहांजो दसणा चांदा है, पर मैं उना जो इयां चिठिया च नी लिखणा चांदा है, पर मिंजो आस है, की मैं तुहाड़े बाल ओंऐ, कने आमणे सामणे होईकरी गल्लां करे तालू असां पूरी तरा ला खुश होणा।<verse eid="2JN 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2JN 1:13" />ऐथू तुहाड़ियां बेंहणा दे बच्चे, जिना जो परमेश्वरे चुणयां है सै तुहांजो नमस्कार करा दे न।<verse eid="2JN 1:13" /></para>
  <chapter eid="2JN 1" />
</usx>