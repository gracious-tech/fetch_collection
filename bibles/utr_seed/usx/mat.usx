<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="MAT" style="id">- Etulo</book>
  <para style="h">iMatiu</para>
  <para style="toc1">Esɔ Osuse mi abɔ mgbi iMatiu</para>
  <para style="toc2">iMatiu</para>
  <para style="toc3">iMat</para>
  <para style="mt2">Esɔ Osuse mi abɔ mgbi</para>
  <para style="mt1">iMatiu</para>
  <chapter number="1" style="c" sid="MAT 1"/>
  <para style="s1">Etɔ mgbi iYesu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1"/>Odzɛ etɔ mgbi iYesu iKrestu Ongwɛ iDevedi, ongwɛ Abrahan.<verse eid="MAT 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 1:2"/>Abrahan li otsɔ Adziki, Adziki li otsɔ iJeko, iJeko li otsɔ iJuda bɛyi emi ongwunɔn, <verse eid="MAT 1:2"/><verse number="3" style="v" sid="MAT 1:3"/>iJuda li otsɔ iPeredzi bɛyi iDzera, onɔ ma li iTama, iPeredzi li otsɔ iHezrɔn, iHerizɔn li otsɔ iRama, <verse eid="MAT 1:3"/><verse number="4" style="v" sid="MAT 1:4"/>iRama li otsɔ Aminada, Aminada li otsɔ iNashɔn; iNashɔn li otsɔ iSamon, <verse eid="MAT 1:4"/><verse number="5" style="v" sid="MAT 1:5"/>iSamon li otsɔ iBoadzi, ongwu onɔn li iRaha, iBoadzi li otsɔ Obɛdi, ongwu onɔn li iRutu, Obɛdi li otsɔ iJese; <verse eid="MAT 1:5"/><verse number="6" style="v" sid="MAT 1:6"/>iJese li otsɔ Utɔ iDevedi; iDevedi li otsɔ iSolomu ongwu onɔn li owa Uria, <verse eid="MAT 1:6"/><verse number="7" style="v" sid="MAT 1:7"/>iSolomu li otsɔ iRehobuan, iRehobuan li otsɔ Abyija, Abyija li otsɔ Asa, <verse eid="MAT 1:7"/><verse number="8" style="v" sid="MAT 1:8"/>Asa li otsɔ iJehoshafa, iJehoshafa li otsɔ iJoran, iJoran li otsɔ Udzia; <verse eid="MAT 1:8"/><verse number="9" style="v" sid="MAT 1:9"/>Udzia li otsɔ iJotan, iJotan li otsɔ Ahadzi, Ahadzi li otsɔ iHedzekia; <verse eid="MAT 1:9"/><verse number="10" style="v" sid="MAT 1:10"/>iHedzekia li otsɔ iManase, iManase li otsɔ Amɔn, Amɔn li otsɔ iJosia, <verse eid="MAT 1:10"/><verse number="11" style="v" sid="MAT 1:11"/>iJosia li otsɔ iJekonia bɛyi emi ongwunɔn. Taman a kwu ma ofyɛɛ lu ɛsɛ iBabyilon. <verse eid="MAT 1:11"/><verse number="12" style="v" sid="MAT 1:12"/>Ngwi egbe mgbi ama mi iBabyilon wa ngyɛ nɛ; iJekonia mba iShetiɛ, iShetiɛ mba iDzerubabɛ, <verse eid="MAT 1:12"/><verse number="13" style="v" sid="MAT 1:13"/>iDzerubabɛ mba Abyidu, Abyidu mba Eliakin, Eliakin mba Azɔ; <verse eid="MAT 1:13"/><verse number="14" style="v" sid="MAT 1:14"/>Azɔ na di mba iDzadɔku, iDzadɔku mba Akin, Akin mba Elidu, <verse eid="MAT 1:14"/><verse number="15" style="v" sid="MAT 1:15"/>Elidu mba Eliadza, Eliadza mba iMatan, iMatan mba iJeko; <verse eid="MAT 1:15"/><verse number="16" style="v" sid="MAT 1:16"/>iJeko mba iJose oba iMeri; li iMeri ongwu nmba iYesu ongwu a li kwun di iKrestu nani.<verse eid="MAT 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17"/>Etɔ nwita mbi Abrahan nghataa kɛ mbi iDevedi li iwyodenɛ; Wita mbi iDevedi nghataa kɛ onɔ ngwi a gbe ma lu iBabyilon li etɔ iwyodenɛ yi onɔ ngwi a tɔ abɔ ofyɛɛ mi iBabyilon nghataa ba onɔ mgbi iMedzaya na kpaa li etɔ iwyodenɛ.<verse eid="MAT 1:17"/></para>
  <para style="s1">Ombaamba mgbi iYesu iKrestu</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18"/>Nɛnɛ li ngha ngwi ombaamba mgbi iYesu iKrestu dzɛ aani: Onɔn iMeri, ngwu iJose tsikwɔn dzɛ esɛ, kpaa duuse no kyon yɔ, a din yi ifewo mi mfye mgbi Onodzi Osaan. <verse eid="MAT 1:18"/><verse number="19" style="v" sid="MAT 1:19"/>Nghaduu iJose oban li inggisɛ osuse, i minan onun ayiwi mi ododa ba nɛ, o kye weka gbɛɛ ongwu ka gha yan fyɛɛ. <verse eid="MAT 1:19"/><verse number="20" style="v" sid="MAT 1:20"/>Dafi o le tsɛwodzɛ nɛ ngha nɛ, ongyesɔ mgbi Otsɛ wa tsetun mi elela, nyan gbɛɛ, &lt;&lt;IJose ongwɛ iDevedi, ka mio okyi kyelu iMeri lu udɛ abu gbɛɛ no li owa abu ba, ikyesinɛ ifu ngwi o byi na li mi Onodzi Osaan. <verse eid="MAT 1:20"/><verse number="21" style="v" sid="MAT 1:21"/>O ka wa mba ongwongyulɔ, ta abu ka kwun iyi gbɛɛ iYesu, lubana o ka dulu emidan tɔ mi ali ibwubwe mgbi ama.&gt;&gt;<verse eid="MAT 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22"/>Ungwɔ ntonɛ duu kyɔ ikye ombwo ondu odzɛɛdzɛ mgbi Otsɛ ongwi o gbɔ nyɛ mbi oyegbɔ gbɛɛ, <verse eid="MAT 1:22"/><verse number="23" style="v" sid="MAT 1:23"/>&lt;&lt;Ongwongyaa ibidrua ka wa byifu mba ongwongyulɔ, a ka kwun iyi di Imanue,&gt;&gt; itan gbɛɛ, &lt;&lt;Imgbasho dzɛ yi eyi nani.&gt;&gt;<verse eid="MAT 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24"/>Ngwi iJose kyɛ una nɛta, o kyɔ dafi ongyesɔ mgbi Otsɛ nyan mani, o kyi kyelu iMeri lu udɛ mgban yɛɛ owan. <verse eid="MAT 1:24"/><verse number="25" style="v" sid="MAT 1:25"/>Kpaa o gbewo yan ba nghataa iMeri wa mba ongwongyulɔ, o si kwun iyi gbɛɛ iYesu.<verse eid="MAT 1:25"/></para>
  <chapter eid="MAT 1"/>
  <chapter number="2" style="c" sid="MAT 2"/>
  <para style="s1">Ama oyodzɛ mi onosa</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1"/>Ngwi a mba iYesu mi iBɛtlɛhɛn mi iJudia duu nɛta, iHerude li utɔ mi onɔ nani, inggisɛ ama oyodzɛ mi onosa wa kaka iJerosalin, <verse eid="MAT 2:1"/><verse number="2" style="v" sid="MAT 2:2"/>le byita gbɛɛ, &lt;&lt;Ongwɛ ongwu a mba nli Utɔ mgbi emi iJuda nɛ, a kyon ladzɛ ole? Lubana eyi di mcɛ mgban mi onosa, ngwi eyi ba owa sunun aani.&gt;&gt;<verse eid="MAT 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3"/>Ngwi utɔ iHerude fwo odzɛ nɛ ngha nɛ, i kakan ewo bɛyi emi iJerosalin duu. <verse eid="MAT 2:3"/><verse number="4" style="v" sid="MAT 2:4"/>O kwu engyukwo ama ofifɛ mgbi Imgbasho bɛyi ama otso ola duu kwakye, o byi ma gbɛɛ li mi ole ngwi a ka mba iMedzaya ma? <verse eid="MAT 2:4"/><verse number="5" style="v" sid="MAT 2:5"/>A nyan gbɛɛ: &lt;&lt;Li mi iBɛtlɛhɛn mi iJudia, Lubana li ungwɔ ngwi oyegbɔ tsekise lɔ gbɛɛ:<verse eid="MAT 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6"/>&lt;&lt; &lt;Kpaa abu, iBɛtlɛhɛn,</para>
  <para style="q2" vid="MAT 2:6">mi ikpɛsɛ mgbi iJudia,</para>
  <para style="q1" vid="MAT 2:6">o ka yama li igeli oyɛyikpa mi iJudia ba;</para>
  <para style="q2" vid="MAT 2:6">lubana li mbi abu ngwi inggisɛ</para>
  <para style="q2" vid="MAT 2:6">ogbe inggisɛ teyi ka tɔ</para>
  <para style="q1" vid="MAT 2:6">nka ngyo emidani Israi.&gt; &gt;&gt;<verse eid="MAT 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7"/>Ta iHerude kwu ama oyodzɛ ntona ela daada di byi ma ita klɛklɛ ni ongwu ye onɔ ngwi mcɛ na tsetu ma mani. <verse eid="MAT 2:7"/><verse number="8" style="v" sid="MAT 2:8"/>O si nu ma ofɛ lu iBɛtlɛhɛn di nya ma gbɛɛ, &lt;&lt;Lu ka pitan saan na. Ni ema ka din taman yɛ wa nya ani, adzi ni ani kpaa ka su nun.&gt;&gt;<verse eid="MAT 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9"/>Ngwi a fwo odzɛ ngwi utɔ gbɔ nɛ, a tasɛ lu ta mcɛ ongwi a di mi onosa ma gbe ma teyi nghataa ka kwulɛsɛ mi imbe ngwi ongwɛ na ladzɛ mani. <verse eid="MAT 2:9"/><verse number="10" style="v" sid="MAT 2:10"/>Onɔ ngwi a di mcɛ na ma, a dzɛ yi atsa kwuba. <verse eid="MAT 2:10"/><verse number="11" style="v" sid="MAT 2:11"/>Ta ama oyodzɛ kaka ozu di ongwɛ yi onɔn iMeri, a kwɛsɛ su nun, nɛ a kwulu igbe mgbi ama dulu abashi, engyie ogbungbɛ yi iMire<note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="ft" closed="false">IMire li otse onu ungwɔ bwa ba.</char></note> gbe ghan umba. <verse eid="MAT 2:11"/><verse number="12" style="v" sid="MAT 2:12"/>Nɛ ama oyodzɛ ntona yɛ nyɛ ofɛ oka lu ɛsɛ udɛ ma, lubana Imgbasho tsekise woma elela kwo ma adɔ gbɛɛ nu ma ka yɛ nyɛ mbi iHerude wuba.<verse eid="MAT 2:12"/></para>
  <para style="s1">A tsinya lu Igyibiti</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13"/>Onɔ ngwi ama oyodzɛ lu dzita emi iMeri nɛ, ongyesɔ mgbi Otsɛ wa tsetu iJose mi elela owoowo nyan gbɛɛ: &lt;&lt;IHerude ka wa pita ongwɛ nɛ gbɛɛ ni ongwu ngwɔn. Nghanɛ kyato, kyelu ongwɛ yi onɔn tsinya lu Igyibiti, to ele na nghataa ni ani wa nya ema gbɛɛ ni ema kyɛɛ yɛ se.&gt;&gt; <verse eid="MAT 2:13"/><verse number="14" style="v" sid="MAT 2:14"/>IJose kyato una mi otu na, kyi kyelu ongwɛ yi onɔn, lu Igyibiti.<verse eid="MAT 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 2:15"/>O dzɛ ele nghataa ba onɔ ngwi iHerude wa kwulu. Ungwɔnɛ kyɔ ikye onu odzɛ ngwi Otsɛ Imgbasho gbɔ nyɛ mbi oyegbɔ gbɛɛ, &lt;&lt;Ani kwu Ongwani ela tasɛ mi Igyibiti,&gt;&gt; ma yɛɛ otsitsi.<verse eid="MAT 2:15"/></para>
  <para style="s1">Ɛngbɛ ongwɔɔngwɔ</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16"/>Onɔ ngwi iHerude difwi dafi ama oyodzɛ ntona kyɔn ikwangha ewo nɛ, eka kplɔkɔ lon. O noola gbɛɛ nu ma kye ngwɔlu ali ongwongyulɔ ama mmɛ onova efa yɛyikpa sini mi iBɛtlɛhɛn bɛyi agwɔ ama nwatse dɔn duu. O gbɔdzɛ nɛ mi ikye odzɛ ngwi ongwu fwo mbi ama oyodzɛ ntonani. <verse eid="MAT 2:16"/><verse number="17" style="v" sid="MAT 2:17"/>Ta odzɛ ngwi oyegbɔ iJeremia teyi gbɔ ma yɛɛ otsitsi gbɛɛ:<verse eid="MAT 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18"/>&lt;&lt;A fwo ela akwɔ mi iRama,</para>
  <para style="q2" vid="MAT 2:18">akwɔ ikwu otseetse kpakpa</para>
  <para style="q1" vid="MAT 2:18">iRacɛ le makwɔ ikye ɛngbɛ mgban,</para>
  <para style="q2" vid="MAT 2:18">o fwa onu ma gyilan,</para>
  <para style="q1" vid="MAT 2:18">ikyesinɛ a kwulu.&gt;&gt;<verse eid="MAT 2:18"/></para>
  <para style="s1">Oyɛ lu iNadzareti</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19"/>Ngwi iHerude kwulu nyɛ nɛ, ongyesɔ mgbi Otsɛ kɛ mbi iJose mi elela owoowo mi Igyibiti <verse eid="MAT 2:19"/><verse number="20" style="v" sid="MAT 2:20"/>ka gbɛɛ, &lt;&lt;kyato, kyelu ongwɛ yi onɔn, yɛ lu ɛsɛ Israi, ikyesinɛ ama nle fya ongwɔ ongwɛ nɛ ma kwulu wa.&gt;&gt;<verse eid="MAT 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 2:21"/>Man iJose kyato, kyi kyelu ongwɛ yi onɔn yɛ luba Israi.<verse eid="MAT 2:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 2:22"/>Nghaduu ngwi iJose fwo gbɛɛ Acelusi gyutɔ gbikye otsɔn iHerude mi iJudia nɛ, o wimio oka kaka ele, a di won elela kwon adɔ nɛman, o yɛ lu ayɛsɛ iGalalia <verse eid="MAT 2:22"/><verse number="23" style="v" sid="MAT 2:23"/>ka dzɛ igeli ngwi a kwun di iNadzareti nani. Nɛ odzɛ ngwi oyegbɔ tsekise gbɔgbɛɛ: &lt;&lt;A ka kwun di inggisɛ iNadzareti,&gt;&gt; na mbwumbwo.<verse eid="MAT 2:23"/></para>
  <chapter eid="MAT 2"/>
  <chapter number="3" style="c" sid="MAT 3"/>
  <para style="s1">Esɔ ogbɔɔgbɔ mgbi iJɔn okyɔ iBatisima</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1"/>Mi onɔ na iJɔn okyɔ iBatisima badzɛ okwɛsɛ mi iJudia le gbeesɔ.<verse eid="MAT 3:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 3:2"/>O gbɛɛ, &lt;&lt;Kyata mi ali ibwubwe mgbi ema na ikyekyɛ Esutɔ ongwi esho dzɛ kwɛkwɛ.&gt;&gt;<verse eid="MAT 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 3:3"/>IJɔn li ongwu oyegbɔ Adzaya tsekise gbɔdzan mi onɔ ngwi o gbɛɛ:</para>
  <para style="q1" vid="MAT 3:3">&lt;&lt;Inggisɛ le kweela mi okwɛsɛ gbɛɛ,</para>
  <para style="q2" vid="MAT 3:3">&lt;mɛlu ofɛ ikye Otsɛ,</para>
  <para style="q1" vid="MAT 3:3">no byi yɛyɛ na.&gt; &gt;&gt;<verse eid="MAT 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4"/>A mɛ angwuto mgbi iJɔn mi andu ilakwumyi; o kye okpa bwa oshi, ungwogye mgban li okpa yi enewo.<verse eid="MAT 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 3:5"/>Inggisɛ tɔkyɛ iJerosalin tole ba mbon bɛyi ali agwɔ mgbi iJudia yi ayɛsɛ nto kwɛkwɛ yi ekyoo mgbi iJodan duu.<verse eid="MAT 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 3:6"/>A fwi ali ibwubwe mgbi ama man iJɔn kyɔ ma iBatisima mi ekyoo iJodan.<verse eid="MAT 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7"/>Ngwi iJɔn di emi iFarasi yi emi iSadusi kwuba le ba mbon owa kyɔ iBatisima nɛ, o nya ma gbɛɛ: &lt;&lt;Ema engwɛ ogidzi ntonɛ! Li emɛ wɛ ema odzɛ gbɛɛ ni ema tsinya itingga mgbi Imgbasho nka wa ba na? <verse eid="MAT 3:7"/><verse number="8" style="v" sid="MAT 3:8"/>Wa owaawa ntso ambɛ itukwu okyata-kyata mani. <verse eid="MAT 3:8"/><verse number="9" style="v" sid="MAT 3:9"/>Dika tsɛwɛ gbɛɛ ema ka gbɔ yi ewema gbɛɛ, &lt;Abrahan li otseyi ba.&gt; Ani le nya ema gbɛɛ Imgbasho ka yagba kyata akwutsɛ ntonɛ nu ma yɛɛ etɔ mgbi Abrahan! <verse eid="MAT 3:9"/><verse number="10" style="v" sid="MAT 3:10"/>Onɛnɛ kpaa Imgbasho kye ika ladzɛ akpekwɔ le fɛ odzɛɛdzɛ, ali ekwɔ nwa owaawa osuse ba duu a ka kye dzɛlu ngwuta di kye wokɛ ola.<verse eid="MAT 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 3:11"/>&lt;&lt;Ani le kyɔ ema iBatisima yi eni otso ambɛ itukwu okyata-kyata. Kpaa ongwu nka wa ba mi iyikpa ani ma shewo ngha ani, ani mɛ ogben okpafɔ ba. O ka kyɔ ema iBatisima mi Onodzi Osaan bɛyi ola. <verse eid="MAT 3:11"/><verse number="12" style="v" sid="MAT 3:12"/>Okwuga mgban ofo ungwɔ byidzɛ abɔ, o ka folu etɔ mgban kyi gbelu osuse duu wokɛ oba, ikpaflo yɔ, o ka gbe toola mi ola nka myunu ba mani.&gt;&gt;<verse eid="MAT 3:12"/></para>
  <para style="s1">IJɔn kyɔ iYesu iBatisima</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13"/>Mi onɔ na iYesu kyɛ mi iGalalia wa kaka si ba mbi iJɔn mi ekyoo iJodan owa kyɔ iBatisima mbon. <verse eid="MAT 3:13"/><verse number="14" style="v" sid="MAT 3:14"/>Kpaa iJɔn fwa yan gbɛɛ, &lt;&lt;Li ani ngwu abu kika kyɔ ani iBatisima, ma kyɔnɛ ngwi abu ba mbi ani?&gt;&gt;<verse eid="MAT 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15"/>Nghaduu iYesu nun uka gbɛɛ, &lt;&lt;Onɛnɛ yɔ no dzɛ ngha; lubana li kyɛmɛ ngwi eyi ka kyɔ oweka mgbi Imgbasho.&gt;&gt; Man iJɔn gbela.<verse eid="MAT 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16"/>Ntunto ngwi iYesu kyɔ iBatisima di kyɛɛ mi eni nɛta, esho kwulu. Ta o di Onodzi Imgbasho kyɛ le ba dafi anyama wa dɔnkɛ ewo. <verse eid="MAT 3:16"/><verse number="17" style="v" sid="MAT 3:17"/>Ta ela tɔ mi esho gbɛɛ, &lt;&lt;Nɛnɛ li Ongwani, ongwi itukwu-itukwu; li mbon ngwi ani dzɛ yi atsa.&gt;&gt;<verse eid="MAT 3:17"/></para>
  <chapter eid="MAT 3"/>
  <chapter number="4" style="c" sid="MAT 4"/>
  <para style="s1">Igyila mgbi iYesu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1"/>Ta Onodzi Osaan kye iYesu lu okwɛsɛ ni iSatan ka mbadin. <verse eid="MAT 4:1"/><verse number="2" style="v" sid="MAT 4:2"/>Dafi iYesu tukwondu egbe ngwusefa yi otu ngwusefa nyɛ nɛ, enbwa dɔn. <verse eid="MAT 4:2"/><verse number="3" style="v" sid="MAT 4:3"/>Ta iSatan ba mbon wa nyan gbɛɛ, &lt;&lt;Kini abu li ongwɛ Imgbasho yɔ, wo akwutsɛ ntonɛ ola nu ma kyata yɛɛ ibredi.&gt;&gt;<verse eid="MAT 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4"/>Kpaa iYesu nun uka gbɛɛ: &lt;&lt;Afɛ lɔ gbɛɛ, inggisɛ ka dzɛ oshishe mi ibredi ta ba, kpaa li mi ali elodzɛ ntɔ mi ondu mgbi Imgbasho mani.&gt;&gt;<verse eid="MAT 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5"/>Ta iSatan di kyon lu ogalu osaan, kyon ka dɔkɛ ikyikye ozu osunu Imgbasho,<figure style="fig" alt="ISatan di mbadi iYesu" file="DN00405b.tif" size="col" loc="4;5" copy="DN00405b" ref="4:5">The temptation of Jesus</figure> <verse eid="MAT 4:5"/><verse number="6" style="v" sid="MAT 4:6"/>o nyan gbɛɛ, &lt;&lt;Ni abu li ongwɛ Imgbasho yɔ, bulu lu esɛ. Lubana Afɛ lɔ gbɛɛ,</para>
  <para style="q1" vid="MAT 4:6">&lt;&lt;Imgbasho ka wo engyesɔ mgban ola ikye abu,</para>
  <para style="q2" vid="MAT 4:6">a ka kye gbɛlu abu mi abɔ mgbi ama,</para>
  <para style="q1" vid="MAT 4:6">ikyegbɛɛ ni abu ka kye</para>
  <para style="q2" vid="MAT 4:6">afɔ tsɛ akwutsɛ ba.&gt;&gt;<verse eid="MAT 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7"/>IYesu nyan gbɛɛ, &lt;&lt;Afɛ di lɔ gbɛɛ, &lt;ka mbadi Otsɛ Imgbasho mgbi abu ba.&gt; &gt;&gt;<verse eid="MAT 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8"/>ISatan di kyon lu ka tɔkɛ unggwɔ nshigbo kpakpa di tson esutɔ mgbi ɛsɛ duu bɛyi okwɔkwɔ mgbi ɛsɛ. O nyan gbɛɛ: <verse eid="MAT 4:8"/><verse number="9" style="v" sid="MAT 4:9"/>&lt;&lt;Kini abu kwɛsɛ sunu ani yɔ, ungwɔ ntonɛ duu n ka gbe nu abu.&gt;&gt;<verse eid="MAT 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10"/>Nghaduu iYesu nyan gbɛɛ, &lt;&lt;Yɛ enggengga iSatan! Lubana Afɛ lɔ gbɛɛ: &lt;Sunu Otsɛ Imgbasho mgbi abu, di li ongwu ta kyɔn idɔ.&gt; &gt;&gt;<verse eid="MAT 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11"/>Ta iSatan lu dzanta, man engyesɔ mgbi Imgbasho ba wa tobyun.<verse eid="MAT 4:11"/></para>
  <para style="s1">IYesu wita ogbeesɔ</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12"/>Ngwi iYesu fwo gbɛɛ a kye iJɔn wokɛ obawi nɛ, o yɛ lu iGalalia. <verse eid="MAT 4:12"/><verse number="13" style="v" sid="MAT 4:13"/>O dzata iNadzareti si lu ka dzɛ iKapenahun ndzɛ mi ewuutɔ iGalalia mi ayɛ mgbi iDzebulun bɛyi iNaftali <verse eid="MAT 4:13"/><verse number="14" style="v" sid="MAT 4:14"/>ikye ombwumbwo odzɛ ngwi oyegbɔ Adzaya tsekise gbɔ mani gbɛɛ:<verse eid="MAT 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15"/>&lt;&lt;Ɛsɛ iDzebulun yi iNaftali,</para>
  <para style="q2" vid="MAT 4:15">ofɛ olu ekyoo okwukwo,</para>
  <para style="q1" vid="MAT 4:15">mi olu iJodan,</para>
  <para style="q2" vid="MAT 4:15">iGalalia mgbi emi agwɛsɛ<verse eid="MAT 4:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16"/>inggisɛ ama nlato iifu</para>
  <para style="q2" vid="MAT 4:16">a di osa okwukwo;</para>
  <para style="q1" vid="MAT 4:16">ama nlato iwulu ikwongye osa gbosa tu ma.&gt;&gt;<verse eid="MAT 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17"/>Wita mi onɔ na nghataa lu iyayi iYesu wita ogbeesɔ gbɛɛ &lt;&lt;kyata mi ali ibwubwe mgbi ema na, lubana esutɔ ongwi esho dzɛ kwɛkwɛ.&gt;&gt;<verse eid="MAT 4:17"/></para>
  <para style="s1">IYesu kwu engwafɔɔn emi ababɔ ela</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18"/>Dafi iYesu le kyikyɛ nyɛ ewekyoo okwukwo mgbi iGalalia nɛ, o di engwuneka nghi efa, iSaimɔn nli iPyita nani bɛyi ongwunɔn Andru. A tole ngwi ukɛ mi utɔ lubana a li ama okwu mmbweni. <verse eid="MAT 4:18"/><verse number="19" style="v" sid="MAT 4:19"/>IYesu nya ma gbɛɛ, &lt;&lt;Ba, wa kyɛdɔ ani na, ta ani ka kyata ema yɛɛ ama okwu inggisɛ.&gt;&gt; <verse eid="MAT 4:19"/><verse number="20" style="v" sid="MAT 4:20"/>A byakpa dzata ukɛ mgbi ama kyɛdɔn.<verse eid="MAT 4:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21"/>O gble kiyayi nɛ, o di engwunɔ angbeka efa, iJɛnsi bɛyi ongwunɔn iJɔn emi ongwɛ iDzebedi. A woto uwaa yi otsɔma, le mɛ akɛ. IYesu kwu ma ela, <verse eid="MAT 4:21"/><verse number="22" style="v" sid="MAT 4:22"/>plɛ nɛta a dzita otsɔma bɛyi uwaa si kyɛdɔn.<verse eid="MAT 4:22"/></para>
  <para style="s1">IYesu ngyɛlu emi ootse ootse</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23"/>IYesu kyikyɛ kpatsɛ iGalalia, le tso mi ozu okwakye mgbi emi iJuda, le gbɔ Esɔ Osuse mgbi esutɔ, dile ngyɛlu inggisɛ ootse idzidza-dzidza.<verse eid="MAT 4:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 4:24"/>Odzɛ mgban si gbɔfwɛ kpatsɛ ali imbe mi iSiria, ta inggisɛ gbe ama ndotse ita idzidza-dzidza ba mbon, ama nle gyadzɛ yi owulu-wulu, yi ama ngwu esɛ dɔ ma ikye, ama odzɛkwulu yi ama ogbyikye tukwu esɛ, kpaa iYesu ngyɛlu ma ele duu.<verse eid="MAT 4:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 4:25"/>Ijiji inggisɛ mi iGalalia yi iDekapoli yi iJerosalin yi iJudia bɛyi ayɛsɛ nto oyombo ekyoo iJodan duu kyɛdɔn.<verse eid="MAT 4:25"/></para>
  <chapter eid="MAT 4"/>
  <chapter number="5" style="c" sid="MAT 5"/>
  <para style="s1">Esɔ atsa</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1"/>Mi onɔ ngwi iYesu di ibyi inggisɛ nɛ, o tɔkɛ ewunggwɔ ka sɔkɛ esɛ. Engwafɔɔn ba mbon, <verse eid="MAT 5:1"/><verse number="2" style="v" sid="MAT 5:2"/>o si wita otso ma gbɛɛ:<verse eid="MAT 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 5:3"/>&lt;&lt;Atsa dzɛ yi ama ndzɛ adzɛ mi onodzi,</para>
  <para style="q1" vid="MAT 5:3">lubana esutɔ ongwi esho li mgbi ama.<verse eid="MAT 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4"/>Atsa dzɛ yi ama ndzɛ yi etse inɛ onɛnɛni,</para>
  <para style="q1" vid="MAT 5:4">lubana Imgbasho ka gyila ma!<verse eid="MAT 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5"/>Atsa dzɛ yi ama nsulu itukwu iyu,</para>
  <para style="q1" vid="MAT 5:5">lubana a ka gyokwudɛ ɛsɛ.<verse eid="MAT 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6"/>Atsa dzɛ yi ama enbwa dɔ ma ngwi ekweni di kwu ma ikye osaan mani,</para>
  <para style="q1" vid="MAT 5:6">lubana Imgbasho ka nu ma tolo.<verse eid="MAT 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7"/>Atsa dzɛ yi ama odi elela,</para>
  <para style="q1" vid="MAT 5:7">lubana Imgbasho ka di ma elela.<verse eid="MAT 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8"/>Atsa dzɛ yi ama itukwu gbosa mi ifun,</para>
  <para style="q1" vid="MAT 5:8">lubana a ka di Imgbasho.<verse eid="MAT 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9"/>Atsa dzɛ yi ama oba yi iyu,</para>
  <para style="q1" vid="MAT 5:9">lubana a ka kwu ma di engwɛ Imgbasho.<verse eid="MAT 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10"/>Atsa dzɛ yi ama nli gbiisɔ ikye osaan mani,</para>
  <para style="q1" vid="MAT 5:10">lubana esutɔ ongwi esho li mgbi ama.<verse eid="MAT 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11"/>&lt;&lt;Atsa dzɛ yi ema ngwu a fya ema ito di nu ema isɔ di mwonya ibwubwe bɛ ema ewo mi ikye ani mani. <verse eid="MAT 5:11"/><verse number="12" style="v" sid="MAT 5:12"/>Dzɛ yi atsa kpakpa na, ikyekyɛ umba mgbi ema shewo mi esho, bana li ngha ngwi a nu ama ogbɛɛsɛ ama nteyi ema ma kpaa isɔ aali.<verse eid="MAT 5:12"/></para>
  <para style="s1">Mmwaa yi osa</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13"/>&lt;&lt;Ema li mmwaa mgbi ɛsɛ. Kpaa kini mmwaa fyumfya wuba ma, a ka kyɔsinɛse non yɛ fyumfya? Ungwɔ ntishi ngwi a ka kyɔ yan yɔ, se li okye yangwuta ni inggisɛ kye afɔ dzin.<verse eid="MAT 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14"/>&lt;&lt;Ema li osa mgbi ɛsɛ. Ogalu okwukwo ndɔdzɛ undɔ ka yagba dzɛ daada ba. <verse eid="MAT 5:14"/><verse number="15" style="v" sid="MAT 5:15"/>Naadi inggisɛ ka kye ipitila dɔ di yile mgboko tukwun ba. Kpaa a ka kye dɔkɛ mi ododa, no nu osa mbi ali inggisɛ duu mi ifoozu. <verse eid="MAT 5:15"/><verse number="16" style="v" sid="MAT 5:16"/>Mi itɔ ofɛ nɛ yɛyɛ, ni osa mgbi ema gbosa mbi inggisɛ, ikye nu ma di okyɔɔkyɔ mgbi ema osuse diyɛ tsɛ Otsema ongwi esho.<verse eid="MAT 5:16"/></para>
  <para style="s1">Ola mbwumbwo</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17"/>&lt;&lt;Ka tsɛwɛ gbɛɛ ani ba owa ndɛlu Ola naadi elodzɛ mgbi emi Oyegbɔ ba; ani ba owa ndɛlu ma ba kpaa li owa nu ma mbwumbwo. <verse eid="MAT 5:17"/><verse number="18" style="v" sid="MAT 5:18"/>Ani nya ema otsitsi, esho yi esɛ ka nyɛ, kpaa ambɛ olɔ ungwɔ nnghao shanyɛ hona nghao yɛyikpa ngwi a lɔ mi Ola onyi kpaa ka byulu ba. Nghataa alungwɔ duu ka wa mbwumbwo. <verse eid="MAT 5:18"/><verse number="19" style="v" sid="MAT 5:19"/>Ali inggisɛ nfoola onyi nnghao shanyɛ mi ola ntonɛ diyɛ tso angbeka okyɔ ngha yɔ, a ka kwun di olɛlɛ mi esutɔ ongwi esho, kpaa ali inggisɛ nkyɔ mi ola diyɛ tso ola ntonɛ, a ka kwun di ogbagbadzidzi mi esutɔ ongwi esho. <verse eid="MAT 5:19"/><verse number="20" style="v" sid="MAT 5:20"/>Lubana ani nya ema gbɛɛ sede osaan mgbi ema ka ngha mgbi emi iFarasi bɛyi etsetse mgbi ola mgbi iMose bayɔ, ema kpaa ka kaka esutɔ ongwi esho na ba.<verse eid="MAT 5:20"/></para>
  <para style="s1">Inggisɛ ongwɔɔngwɔ</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21"/>&lt;&lt;Ema teyi fwo a gbɔ yi inggisɛ tugbe gbɛɛ, &lt;Ka ngwɔ inggisɛ ba, ma ali inggisɛ nngwɔ inggisɛ tayɔ a ka gbɔn ikwɔ.&gt; <verse eid="MAT 5:21"/><verse number="22" style="v" sid="MAT 5:22"/>Nghaduu ani le nya ema gbɛɛ inggisɛ nkyitingga yi ongwunɔn yɔ, mɛ ogbɔn ikwɔ. Ali inggisɛ ndi kwu ongwunɔn gbɛɛ, &lt;Imbuu,&gt; ka nu uka mi opiikwɔ okwukwo. Kpaa inggisɛ ta nkwu ongwunɔn gbɛɛ, &lt;Abu ikwangha inggisɛ yɔ!&gt; ka dzɛ inoola mgbi udola.<verse eid="MAT 5:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 5:23"/>&lt;&lt;Nghanɛ, ni abu le nu umba mi iwashi wa wɛ gbɛɛ ongwunabu dzɛ yi okakewo yi abu yɔ, <verse eid="MAT 5:23"/><verse number="24" style="v" sid="MAT 5:24"/>dzita umba na mi iwashi. Teyi lu ka yile ide gye yi ongwunabu; ta yɛ wa nu umba mgbi abu.<verse eid="MAT 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25"/>&lt;&lt;Yile ide gye plɛ yi ongyikyili mgbi abu ongwu nkye abu le kɛ opiikwɔ. Kyɔ ngha yan ngwi abu ka kyɛ yan mi ofɛ mani, bana o ka kye abu wo inggisɛ ogbiikwɔ abɔ, inggisɛ ogbiikwɔ na dika kye abu wo adruba abɔ, man o ka kye abu wokɛ obawi. <verse eid="MAT 5:25"/><verse number="26" style="v" sid="MAT 5:26"/>N nya abu otsitsi, abu ka tɔ ba sede abu ka kpa mkpa ngwi abu dzɛyan ma klɛklɛ olifo onyi kpaa ka sisi ba.<verse eid="MAT 5:26"/></para>
  <para style="s1">Amah</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27"/>&lt;&lt;Ema teyi fwo a gbɔgbɛɛ, &lt;Ka kyɔ amah ba.&gt; <verse eid="MAT 5:27"/><verse number="28" style="v" sid="MAT 5:28"/>Kpaa n nya ema gbɛɛ inggisɛ ta ndi ongyaa inɛ mbe anggwɔ yɔ, tsekise kyɔ amah yan mi itukwu mgban. <verse eid="MAT 5:28"/><verse number="29" style="v" sid="MAT 5:29"/>Kini inɛ mgbi abu abugye nu abu kyungwɔ obube, kyi todulu ngwuta. I tatase ni alewo mgbi abu onyi nyanya ngha onu ma kye ewo mgbi abu olɔlɔ ngwuta wokɛ udola. <verse eid="MAT 5:29"/><verse number="30" style="v" sid="MAT 5:30"/>Ni abɔ abugye mgbi abu di nu abu kyungwɔ obube yɔ, kye dzɛlu ngwuta. Bana ka tatase ni alewo mgbi abu onyi nyanya ngha onu ma kye ewo mgbi abu olɔlɔ ngwuta wokɛ udola.<verse eid="MAT 5:30"/></para>
  <para style="s1">Eba oghaagha</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31"/>&lt;&lt;A tsekise gbɔgbɛɛ, &lt;Ali inggisɛ nlɔ owan onya yɔ, li kyɛmɛ ngwi o ka nun afɛ ogheeba.&gt; <verse eid="MAT 5:31"/><verse number="32" style="v" sid="MAT 5:32"/>Nghaduu ani nya ema gbɛɛ inggisɛ ta nlɔ owan onya, ni li mi itɔdzɛ mgbi amah bayɔ, o non yɛɛ ongyaa amah, inggisɛ ndi kye ongyaa ngwu a lɔn onya kyɔ amah.<verse eid="MAT 5:32"/></para>
  <para style="s1">Ofaafa</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33"/>&lt;&lt;Ema di fwo a nya inggisɛ tugbe gbɛɛ, &lt;Ka ndɛlu ofaafa mgbi ema ba, kpaa ngyo ondu odzɛɛdzɛ ngwi ema dzɛ yi Otsɛ mani.&gt; <verse eid="MAT 5:33"/><verse number="34" style="v" sid="MAT 5:34"/>Kpaa n nya ema, ka fa ba duudu: ni li mi esho kpaa, lubana li itsuutɔ mgbi Imgbasho; <verse eid="MAT 5:34"/><verse number="35" style="v" sid="MAT 5:35"/>hona mi ikpɛsɛ, lubana li imbe okye atafɔ mgban dɔ ele; naadi mi iJerosalin, lubana li ogalu okwukwo mgbi Utɔ Ogbagbadzidzi. <verse eid="MAT 5:35"/><verse number="36" style="v" sid="MAT 5:36"/>Dika fa mi ikye mgbi abu ba, lubana abu ka yagba onu alotu onyi mi ikye mgbi abu kpaa yɛɛ onzundzɛ hona onbyinbyi ba. <verse eid="MAT 5:36"/><verse number="37" style="v" sid="MAT 5:37"/>Ungwɔ nli adzɛ bayɔ, &lt;Ɛɛn&gt; mgbi ema no li &lt;Ɛɛn,&gt; &lt;Ei,&gt; mgbi ema no li &lt;Ei&gt;; ungwɔ nnghaabɔ nɛ duu kyɛ mbi owapɛ olodu.<verse eid="MAT 5:37"/></para>
  <para style="s1">Inɛ yi inɛ</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38"/>&lt;&lt;Ema teyi fwo a gbɔgbɛɛ, &lt;Inɛ yi inɛ, aba yi aba.&gt; <verse eid="MAT 5:38"/><verse number="39" style="v" sid="MAT 5:39"/>Kpaa n nya ema, ka kpumkpa obube mi ikye obube ba. Kini inggisɛ ta abu afɛ mi atadɔ abugye, kyata agya oka na kpaa nun. <verse eid="MAT 5:39"/><verse number="40" style="v" sid="MAT 5:40"/>Ni inggisɛ di mina okwu abu elikwɔ kye gbɛlu angwuto mgbi abu owoowo ongwi ifun yɔ, kye angwuto mgbi abu ongwi esɛ kpaa bankɛ ele. <verse eid="MAT 5:40"/><verse number="41" style="v" sid="MAT 5:41"/>Kini inggisɛ si abu gbɛɛ ni abu kɛ afokyɛɛ onyi yan yɔ, kɛ yan afokyɛɛ efa. <verse eid="MAT 5:41"/><verse number="42" style="v" sid="MAT 5:42"/>Inggisɛ nbɔ abu ungwɔ nun, dika fashi iyikpa tsɛ inggisɛ nmina ogbɛ mkpa mbi abu ba.<verse eid="MAT 5:42"/></para>
  <para style="s1">Odi engyikyili kpitukwu</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43"/>&lt;&lt;Ema teyi fwo a gbɔgbɛɛ, &lt;Di inggisɛ nwotsuudɛ dɔ abu kpa abu itukwu yɛ di ongyikyili mgbi abu lanyi.&gt; <verse eid="MAT 5:43"/><verse number="44" style="v" sid="MAT 5:44"/>Nghaduu n nya ema: engyikyili mgbi ema nu ma kpa ema itukwu di bibɔ mi ikye ama nle nu ema isɔ, <verse eid="MAT 5:44"/><verse number="45" style="v" sid="MAT 5:45"/>adzi ni ema li engwɛ mgbi Otsema ongwi esho. O li nu onɔ mgban tsɛ emi obube yi emi osuse, di li kya mmbwo mbi emi osaan bɛyi emi ibwubwe kpaa. <verse eid="MAT 5:45"/><verse number="46" style="v" sid="MAT 5:46"/>Kini ema tso okpitukwu mbi ama nkpa ema itukwu ta ma, li ali oyabɔ ema ka tu? Li ali ngwi ama ogbɛ udza ifyɛɛ kpaa li kyɔ daabaa? <verse eid="MAT 5:46"/><verse number="47" style="v" sid="MAT 5:47"/>Ni ema di ta engwunema ta angba ma, idzidza mgbi ema yi inggisɛ angbeka li ekyɛ? Li ngha ngwi ama o sunu Imgbasho ba kpaa li kyɔ daabawɛ? <verse eid="MAT 5:47"/><verse number="48" style="v" sid="MAT 5:48"/>Wanɛ, dzɛ yɛyɛ na, dafi Otsema ongwi esho kpaa le yɛyɛ nɛni.<verse eid="MAT 5:48"/></para>
  <chapter eid="MAT 5"/>
  <chapter number="6" style="c" sid="MAT 6"/>
  <para style="s1">Onu emi abubɔ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1"/>&lt;&lt;Gbɛwɛbyi ka kyɔ ali osuse mgbi ema mi inɛ inggisɛ ikyegbɛɛ nu ma di ema ba. Ni ema kyɔ ngha, ema ka tu umba mbi Otsema ndzɛ esho na ba.<verse eid="MAT 6:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2"/>&lt;&lt;Nghanɛ ni abu gha inggisɛ abubɔ umba yɔ, ka fo agba mi ele dafi emi ikpala li kyɔ mi ozu okwakye mgbi emi iJuda bɛyi ingɔfɛ ikye ni inggisɛ nu ma mmwɛ na ba. N nya ema otsitsi, a kyi gbɛlu umba mgbi ama ngyɛ wa. <verse eid="MAT 6:2"/><verse number="3" style="v" sid="MAT 6:3"/>Ni abu gha inggisɛ abubɔ umba yɔ, ka nu abɔ abubɛ mgbi abu ye ungwɔ ngwi abugye le kyɔ ma ba. <verse eid="MAT 6:3"/><verse number="4" style="v" sid="MAT 6:4"/>Ikye ni umba mgbi abu oghaagha no dzɛ mi odaada. Ta Otsabu, ongwu nli di mi odaada na, ka yilen kpa abu.<verse eid="MAT 6:4"/></para>
  <para style="s1">Ibɔ obɔɔbɔ</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5"/>&lt;&lt;Ni ema di bibɔ yɔ, ka kyɔ dafi emi ikpala ba, lubana li kpa ma obibɔ kwuzunto mi ozu okwakye mgbi emi iJuda bɛyi mi okwokyiikwokyi mgbi ingɔfɛ ikye ni inggisɛ di ma. Ani nya ema otsitsi, a kyi gbɛlu umba mgbi ama ngyɛ wa. <verse eid="MAT 6:5"/><verse number="6" style="v" sid="MAT 6:6"/>Yeba ni abu ka bibɔ yɔ, lu ifoozu mgbi abu, kye ofɛ tukwu man bibɔ mbi Otsabu, ngwu a li din ba nani. Ta Otsabu, nli di mi odaada na, ka nu abu umba. <verse eid="MAT 6:6"/><verse number="7" style="v" sid="MAT 6:7"/>Nghaduu ni ema le bibɔ, ka kwondukwɔ dafi ama oye Imgbasho ba li kyɔ na ba, lubana a tsɛwɛ gbɛɛ li mi odzɛ mgbi ama ogbɔɔgbɔ kwuba ma ngwi a ka fwo ma aali. <verse eid="MAT 6:7"/><verse number="8" style="v" sid="MAT 6:8"/>Ka dzɛ dafi ama ba na, lubana Otsema teyi ye ungwɔ ama ngwi ema mina duuse ema wa bɔn.<verse eid="MAT 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 6:9"/>&lt;&lt;Nɛ, ka li ofɛ ngwi ema kale bibɔ aani:</para>
  <para style="q1" vid="MAT 6:9">&lt;&lt; &lt;Otseyi ndzɛ esho,</para>
  <para style="q2" vid="MAT 6:9">nu ma nu mmwɛ mi iyi mgbi abu,<verse eid="MAT 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10"/>esutɔ mgbi abu no ba,</para>
  <para style="q2" vid="MAT 6:10">nu ma kyɔ owitukwu mgbi abu</para>
  <para style="q1" vid="MAT 6:10">mi ɛsɛ nɛ dafi a li kyɔ mi esho mani.<verse eid="MAT 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11"/>Nu eyi ungwogye mgbi</para>
  <para style="q2" vid="MAT 6:11">eyi inɛ ongwi alegbe-alegbe.<verse eid="MAT 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12"/>Dzɛ eyi ta yi obube mgbi eyi,</para>
  <para style="q2" vid="MAT 6:12">dafi eyi kpaa li dzita ama</para>
  <para style="q2" vid="MAT 6:12">nkyɔ eyi obube mani.<verse eid="MAT 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13"/>Dika kye eyi kaka imbadi ba,</para>
  <para style="q2" vid="MAT 6:13">kpaa dulu eyi tɔ mi abɔ inggisɛ obube<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="ft" closed="false">Lubana esutɔ li mgbi abu yi mfye bɛyi okwɔkwɔ gyegwu. No dzɛ ngha.</char></note>.&gt;<verse eid="MAT 6:13"/></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 6:14"/>Lubana ni ema dzata inggisɛ nkyɔ ema obube yɔ, Otsema ongwi esho kpaa ka dzata ema. <verse eid="MAT 6:14"/><verse number="15" style="v" sid="MAT 6:15"/>Kpaa ni ema dzata inggisɛ yi obube bayɔ, Otsema kpaa ka dzata ema yi obube mgbi ema ba.<verse eid="MAT 6:15"/></para>
  <para style="s1">Ondu otukwu-tukwu</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16"/>&lt;&lt;Alonɔ ngwi ema tukwondu yɔ, ka mbiinɛ ikye dafi emi ikpala li kyɔ na ba, bana a li mbiinɛ ikye otso inggisɛ gbɛɛ ama le tukwondu. N nya ema otsitsi a kyi gbɛlu umba mgbi ama ngyɛ wa. <verse eid="MAT 6:16"/><verse number="17" style="v" sid="MAT 6:17"/>Nghaduu ni abu tukwondu yɔ, ngwunɛ di kye engyie juwo ikye. <verse eid="MAT 6:17"/><verse number="18" style="v" sid="MAT 6:18"/>Ikye ni inggisɛ ka difwi gbɛɛ abu le tukwondu ba, kpaa no li mbi Otsabu kyoon, ongwu a li din ba; Otsabu nli di mi odaada na, ka kpa abu mkpa.<verse eid="MAT 6:18"/></para>
  <para style="s1">Aludu mi esho</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19"/>&lt;&lt;Ka kye aludu mgbi ema da mi ɛsɛ nɛ ba! Mi ɛsɛ nɛ ewa yi mnkpe ka mbelu ma, emumyi dika gbobu kaka kye yili. <verse eid="MAT 6:19"/><verse number="20" style="v" sid="MAT 6:20"/>Kpaa kye aludu mgbi ema da mi esho, imbe ngwi ewa bɛyi mnkpe ka yagba mbe ba, ngwi emumyi kpaa ka yagba gbobu kaka kye yili ba nani. <verse eid="MAT 6:20"/><verse number="21" style="v" sid="MAT 6:21"/>Bana li imbe ngwi aludu mgbi abu dzɛ ma ngwi itukwu mgbi abu kpaa li dzɛ aali.<verse eid="MAT 6:21"/></para>
  <para style="s1">Osa mgbi ewo</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22"/>&lt;&lt;Inɛ li osa mgbi ewo. Ni inɛ mgbi abu tishi, ewo mgbi abu duu ka mbwo yi osa. <verse eid="MAT 6:22"/><verse number="23" style="v" sid="MAT 6:23"/>Kpaa ni inɛ mgbi abu tishi bayɔ, ewo mgbi abu duu ka mbwo yi iifu. Kini osa nwodzɛ mbi abu yifu yɔ, iifu na ka she saan!<verse eid="MAT 6:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24"/>&lt;&lt;Inggisɛ onyi ka kyɔ engyukwo efa idɔ ba. Kyayina o ka di oka lanyi, diyɛ di oka kpan itukwu, hona o ka nghao sunu oka di kwu oka shanyɛ. O ka yagba sunu Imgbasho yi awuya onɔ onyi ba.<verse eid="MAT 6:24"/></para>
  <para style="s1">Ka dzɛ yi okakewo ba</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25"/>&lt;&lt;Nghanɛ n nya ema, ka dzɛ yi okakewo mi oshishe mgbi ema mi ungwɔ ngwi ema ka gye hona wa naadi ewo mgbi ema mi ungwɔ ngwi ema ka wo ba. Oshishe dzɛ yi oyabɔ ngha ungwogye, ewo di dzɛ yi oyabɔ ngha angwuto baa? <verse eid="MAT 6:25"/><verse number="26" style="v" sid="MAT 6:26"/>Di mbi ingwunɔ emi esho, a li kya naadi shɛ hona gbe da mi oba ba, nghaduu kpaa Otsema mi esho li nu ma ungwogye. Ema dzɛ yi oyabɔ ngha ma bana? <verse eid="MAT 6:26"/><verse number="27" style="v" sid="MAT 6:27"/>Li ɛmɛ mbi ema mi itukwu ofeesho ka yagba ombwo ewon obyi onyi mi oshishe?<verse eid="MAT 6:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28"/>&lt;&lt;Nɛ kyɔsinɛ ngwi ema dzɛ yi okakewo mi odzɛ angwuto? Di onggaangga mgbi afutse dafi li she mani. A li kyidɔ naadi gbo angwuto ba. <verse eid="MAT 6:28"/><verse number="29" style="v" sid="MAT 6:29"/>Nghaduu n nya ema gbɛɛ iSolomu yi okwɔkwɔ mgban duu kpaa wo angwuto kwɔ dafi onyi mbi afutse ntonɛ ba. <verse eid="MAT 6:29"/><verse number="30" style="v" sid="MAT 6:30"/>Ni li ngha ngwi Imgbasho li to afutse nkwodzɛ mmɛnɛ inɛ ekeka a ka kye dzɛlu ngwuta wokɛ ola angwuto ma, kyɔsinɛse ngwi o ka nghao to ema angwuto ba? Ema ama oyɛyɛ sheema anyɛ nɛ? <verse eid="MAT 6:30"/><verse number="31" style="v" sid="MAT 6:31"/>Nghanɛ ka dzɛ yi itukwu ofeesho gbɛɛ, &lt;Li alungwɔ ngwi eyi ka gye?&gt; Naadi &lt;Li alungwɔ ngwi eyi ka wa?&gt; Hona &lt;Li alungwɔ ngwi eyi ka wo?&gt; Ba. <verse eid="MAT 6:31"/><verse number="32" style="v" sid="MAT 6:32"/>Lubana ama oye Imgbasho ba kpaa li le kyɛdɔ ungwɔ ntonɛni, kpaa Otsema ongwi esho ye gbɛɛ i wo ema yi ungwɔ ntonɛni. <verse eid="MAT 6:32"/><verse number="33" style="v" sid="MAT 6:33"/>Tatase teyi pita esutɔ mgbi Imgbasho yi osaan mgban, ta ungwɔ ntonɛ duu a ka gbe bɛ ema kɛ ele. <verse eid="MAT 6:33"/><verse number="34" style="v" sid="MAT 6:34"/>Dududu yɔ ka kye itukwu feesho mi ungwɔ ongwi ekeka ba, ni ekeka kye inɛ byi ewon. Alegbe dzɛ yi okakewo ngyɔ mi ikye ewon.<verse eid="MAT 6:34"/></para>
  <chapter eid="MAT 6"/>
  <chapter number="7" style="c" sid="MAT 7"/>
  <para style="s1">Ofwo angbeka ikwɔ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1"/>&lt;&lt;Ka fwikwɔ ba na, di ema kpaa a wa fwo ema ikwɔ. <verse eid="MAT 7:1"/><verse number="2" style="v" sid="MAT 7:2"/>Lubana li mi itɔ ofɛ ngwi ema fwo angbeka ikwɔ ma, ngwi ema kpaa a ka fwo ema ikwɔ, di li itɔ ofɛ ngwi ema kye ofwo angbeka ikwɔ ma, ngwi a ka kye fwo ema ikwɔ aali.<verse eid="MAT 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 7:3"/>&lt;&lt;Kyɔsinɛ ngwi abu di ofufu ekwɔ mi inɛ mbi ongwunabu kpaa ngwi abu gbɛwɛbyi otsokpla nwodzɛ inɛ mbi abu na ba? <verse eid="MAT 7:3"/><verse number="4" style="v" sid="MAT 7:4"/>Ka kyɔsinɛse abu ka nya ongwunabu gbɛɛ, &lt;Detse nin dulu abu ofufu ekwɔ mi inɛ,&gt; ngwi alonɔ duu otsokpla wodzɛ inɛ mbi abu? <verse eid="MAT 7:4"/><verse number="5" style="v" sid="MAT 7:5"/>Ema emi ikpala, ababɔ kyi dulu otsokpla nwodzɛ inɛ mbi abu, ta abu ka dinɛ saan odulu ofufu ekwɔ nwodzɛ inɛ mbi ongwunabu nani.<verse eid="MAT 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6"/>&lt;&lt;Ka kye ungwɔ nle saan nu obwe ba na, dika kye itagwude mgbi ema ngwuta la obyia ba, kini ema kyɔ ngha yɔ, a ka kye atafɔ tɔdɔ ma, di kyata kye ema kye nghalu ambulu-ambulu.<verse eid="MAT 7:6"/></para>
  <para style="s1">Bɔ, pita, tsaabɔ</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7"/>&lt;&lt;Bɔ ta a ka kye nu ema, pita ta ema ka tu, tsaabɔ ta a ka kwulu ema ofɛ. <verse eid="MAT 7:7"/><verse number="8" style="v" sid="MAT 7:8"/>Bana ali inggisɛ nbɔ duu li gbɛ, inggisɛ npita li tu, inggisɛ ndi tsaabɔ, ofɛ ka kwulu mi ikye mgban.<verse eid="MAT 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 7:9"/>&lt;&lt;Li emɛ mbi ema, kini ongwan bɔn ibredi, se o ka kye ikwutsɛ nun? <verse eid="MAT 7:9"/><verse number="10" style="v" sid="MAT 7:10"/>Naadi kini o bɔn mmbweni, ngwi o ka kye ifa nun? <verse eid="MAT 7:10"/><verse number="11" style="v" sid="MAT 7:11"/>Kini ema, ama nli obube, kpaa ye okye umba osuse nu engwɛ ema ma, ka kyɔsinɛse ngwi Otsema ongwi esho ka kye umba osuse nu ama nbɔn ba! <verse eid="MAT 7:11"/><verse number="12" style="v" sid="MAT 7:12"/>Nghanɛ mi alungwɔ duu, kyɔ yi inggisɛ angbeka dafi ema mina gbɛɛ a ki kyɔ yi ema mani, bana li mi ungwɔnɛ ngwi Ola bɛyi emi Oyegbɔ kwulu ngwuo aani.<verse eid="MAT 7:12"/></para>
  <para style="s1">Ofɛ okpenge yi ogbada</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13"/>&lt;&lt;Kaka onufɛ ogalu okpenge. Lubana onufɛ ogalu otsɛɛ yi ofɛ ogbada-gbada li ofɛ olu imbe odzili-dzili, inggisɛ kwuba le nyɛ ele. <verse eid="MAT 7:13"/><verse number="14" style="v" sid="MAT 7:14"/>Kpaa onufɛ ogalu ogyɛngyɛ yi ofɛ okpenge na le lu imbe oshishe, ma li inggisɛ gwee ta kpatsɛ ofɛ nani.<verse eid="MAT 7:14"/></para>
  <para style="s1">Ekwɔ yi owawan</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15"/>&lt;&lt;Gbɛwɛbyi oyegbɔ emi atsika. A li ba mbi ema kye okpa mmala tukwu ewo, kpaa mi idzidzɛ a li emi idukwlɛbɛ obube. <verse eid="MAT 7:15"/><verse number="16" style="v" sid="MAT 7:16"/>Mi owawa mgbi ama ema ka difwi ma. Inggisɛ ka yagba shɛ mntsa mi olumu, naadi shɛ olumu mi ato gbɛɛ? <verse eid="MAT 7:16"/><verse number="17" style="v" sid="MAT 7:17"/>Li ngha ngwi ekwɔ osuse duu li wa owawa osuse aali, kpaa ekwɔ obube yɔ li wa owawa obube. <verse eid="MAT 7:17"/><verse number="18" style="v" sid="MAT 7:18"/>Ekwɔ osuse ka yagba wa owawa obube ba, ekwɔ obube dika wa owawa osuse gbɛ ba. <verse eid="MAT 7:18"/><verse number="19" style="v" sid="MAT 7:19"/>Ali ekwɔ ta nwa owawa osuse bayɔ, a ka kye dzɛlu di kye ngwuta wokɛ ola. <verse eid="MAT 7:19"/><verse number="20" style="v" sid="MAT 7:20"/>Nghanɛ, li mi owawa mgbi ama ngwi ema ka difwi ma.<verse eid="MAT 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21"/>&lt;&lt;Li ali inggisɛ nkwu ani gbɛɛ, &lt;Otsɛ, Otsɛ,&gt; ta ka kaka esutɔ mgbi Imgbasho ba, kpaa sede li ongwu nkyɔ mi itukwu mgbi Otsani ongwu ndzɛ esho nani. <verse eid="MAT 7:21"/><verse number="22" style="v" sid="MAT 7:22"/>Inggisɛ kwuba ka nya ani mi egbe na gbɛɛ, &lt;Otsɛ, Otsɛ, eyi yegbɔ mi iyi mgbi abu, di lɔ onodzi emɛsɛ onya tɔ di kyungwɔ ama okwulewo angbeka kwuba mi iyi mgbi abu baa?&gt; <verse eid="MAT 7:22"/><verse number="23" style="v" sid="MAT 7:23"/>Ta ani ka nya ma mi ododa gbɛɛ, &lt;Ani ye ema ba. Lu enggengga na, ema emi ali ibwubwe ntonɛni!&gt;<verse eid="MAT 7:23"/></para>
  <para style="s1">Inggisɛ efa ama ombɛ ozu</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24"/>&lt;&lt;Nghanɛ ali inggisɛ nfwo elodzɛ mgbi ani ntonɛ di kyɔ mi ele dzɛ dafi inggisɛ okwiinɛ ngwu mbɛ ozu mgban mi ikye ikwutsɛ mani. <verse eid="MAT 7:24"/><verse number="25" style="v" sid="MAT 7:25"/>Mmbwo kya, akpeni kyɛɛ, awo di fa tsɛkɛ ozu nani, nghaduu i yagba gbobu ba, ikyesinɛ a wo itan mi ikye ikwutsɛ. <verse eid="MAT 7:25"/><verse number="26" style="v" sid="MAT 7:26"/>Nghaduu ali inggisɛ nfwo odzɛ mgbi ani ntonɛ di kyɔ mi ele bayɔ, o dzɛ dafi ikwangha inggisɛ ngwu mbɛ ozu mgban mi ikye mfyan mani. <verse eid="MAT 7:26"/><verse number="27" style="v" sid="MAT 7:27"/>Mmbwo kya, akpeni kyɛɛ, awo di fa tsɛkɛ ozu nani, i yulu tukwu esɛ.&gt;&gt;<verse eid="MAT 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28"/>Onɔ ngwi iYesu ngyɛlu ogbɔ ungwɔ ntonɛ nɛ, i kwulu ibyi inggisɛ ntona ewo mi otsootso mgban, <verse eid="MAT 7:28"/><verse number="29" style="v" sid="MAT 7:29"/>ikyesinɛ o tsungwɔ dafi inggisɛ ndzɛ yi mfye, li dafi mgbi etsetse mgbi ama, ama otso ola ba.<verse eid="MAT 7:29"/></para>
  <chapter eid="MAT 7"/>
  <chapter number="8" style="c" sid="MAT 8"/>
  <para style="s1">Inggisɛ otsoma</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1"/>Onɔ ngwi o tashulu mi ewunggwɔ nɛ, ibyi inggisɛ kyɛdɔn. <verse eid="MAT 8:1"/><verse number="2" style="v" sid="MAT 8:2"/>Ongyulɔ ndzɛ yi otsoma ba wa kwonkɛ iyayi si nyan gbɛɛ, &lt;&lt;Otsɛ, ni abu gbela yɔ, o ka nu ani yɛɛ saan.&gt;&gt;<verse eid="MAT 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3"/>IYesu naabɔ gbon ewo nyan gbɛɛ, &lt;&lt;Ani gbela, yɛɛ saan.&gt;&gt; Plɛ nɛta otsoma mgban gbosa. <verse eid="MAT 8:3"/><verse number="4" style="v" sid="MAT 8:4"/>Ta iYesu nyan gbɛɛ, &lt;&lt;Di gbɛɛ abu nya inggisɛ onyi kpaa ungwɔnɛ ba. Kpaa lu, ka kye ewabu tso mbi ama ofifɛ mgbi Imgbasho di nu umba ngwi iMose wo ema ola mani, otso obwɛndɛ mboma.&gt;&gt;<verse eid="MAT 8:4"/></para>
  <para style="s1">Oyɛyɛ onuunu mgbi ongyukwo <optbreak/> oblakwutsɛ</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5"/>Onɔ ngwi iYesu kaka iKapenahun nɛ, ongyukwo oblakwutsɛ ba mbon, wa mina oyabɔ. <verse eid="MAT 8:5"/><verse number="6" style="v" sid="MAT 8:6"/>O gbɛɛ, &lt;&lt;Otsɛ, ongbidɔ mgbi ani kwulu afɔ yi abɔ ladzɛ udɛ le gyadzɛ kpakpa.&gt;&gt;<verse eid="MAT 8:6"/></para>
  <para style="pi">
    <verse number="7" style="v" sid="MAT 8:7"/>IYesu nyan gbɛɛ, &lt;&lt;N ka kɛ ka ngyɛlun ootse.&gt;&gt;<verse eid="MAT 8:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8"/>Ta ongyukwo oblakwutsɛ na si gbɛɛ, &lt;&lt;Otsɛ, ani mɛ abu ka kaka iwulu endu mgbi ani ba. Gbɔɔgbɔ odzɛ ta, ewo mgbi ongbidɔ mgbi ani sika ngyɛ. <verse eid="MAT 8:8"/><verse number="9" style="v" sid="MAT 8:9"/>Lubana ani abuen li ongyulɔ nbyidzɛ abɔ mfye, yi ama oblakwutsɛ byito abɔ ani. Nin nya ongwunɛ gbɛɛ, &lt;Lu&gt;, O li lu, nin nya oka na gbɛɛ, &lt;kwa!&gt; O di li ba. Ani li gbɔ yi ongbidɔ mgbi ani gbɛɛ, &lt;Kyungwɔnɛni!&gt; O di li kyɔn.&gt;&gt;<verse eid="MAT 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10"/>Onɔ ngwi iYesu fwo odzɛ nɛ nɛ, i kwulun ewo man o si gbɔ yi ama nkyɛdɔn ntona gbɛɛ, &lt;&lt;N nya ema otsitsi, ani tu inggisɛ onyi kpaa mi Israi yi itɔ oyɛyɛ onuunu okɔtɔndzi nɛ ye ba. <verse eid="MAT 8:10"/><verse number="11" style="v" sid="MAT 8:11"/>N nya ema gbɛɛ inggisɛ kwuba ka kyɛ mi onosa yi onɔdɛ ba, dika kwu imbe mgbi ama mi oga yi Abrahan, Adziki bɛyi iJeko mi esutɔ ongwi esho. <verse eid="MAT 8:11"/><verse number="12" style="v" sid="MAT 8:12"/>Kpaa a ka lɔ ama esutɔ dzɛ ikye ma tasɛ lu iyifu, mi imbe ngwi ikwu otseetse yi aba ogyeegye ka dzɛ mani.&gt;&gt;<verse eid="MAT 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 8:13"/>Nɛ iYesu nya ongyukwo oblakwutsɛ na gbɛɛ, &lt;&lt;Lu! Ka dzɛ yɛyɛ dafi abu noyɛyɛ nani.&gt;&gt; Ta ootse ngyɛ lo ongbidɔ mgban na mi onɔ na yɛyɛ.<verse eid="MAT 8:13"/></para>
  <para style="s1">IYesu ngyɛlu ibyi inggisɛ ootse</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14"/>Ngwi iYesu kaka udɛ iPyita nɛ, o di awo bwa onowa iPyita ladzɛ akwulo. <verse eid="MAT 8:14"/><verse number="15" style="v" sid="MAT 8:15"/>O kye abɔ gbon ta awo ngyɛ lon, o si kyato wita ogbe ungwogye to ma.<verse eid="MAT 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16"/>Mi onɔnɔdɛ nɛ, a gbe inggisɛ kwuba ama esɛ dɔ ma ikye ba mbon, nɛ o lɔ onodzi ntona tɔ mi elodzɛ onyi ta di nu emi ootse duu yɛɛ saan. <verse eid="MAT 8:16"/><verse number="17" style="v" sid="MAT 8:17"/>Nɛnɛ li ombwumbwo odzɛ ngwi oyegbɔ Adzaya tsekise gbɔn mani gbɛɛ:</para>
  <para style="q1" vid="MAT 8:17">&lt;&lt;O kyi kyelu okakewo mgbi eyi</para>
  <para style="q2" vid="MAT 8:17">di kyi kyelu ootse mgbi eyi duu.&gt;&gt;<verse eid="MAT 8:17"/></para>
  <para style="s1">Ama nka mɛ okyɛdɔ iYesu</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18"/>Ngwi iYesu di ibyi inggisɛ ntona to yan nɛ, o nondu gbɛɛ nu ma foye utɔ lu agya oka. <verse eid="MAT 8:18"/><verse number="19" style="v" sid="MAT 8:19"/>Ta otsetse mgbi ola mgbi iMose oka ba mbon wa gbɛɛ, &lt;&lt;Otsetse, ani ka kyɛdɔ abu mi ali imbe ngwi abu le kɛ duu.&gt;&gt;<verse eid="MAT 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20"/>IYesu nyan gbɛɛ, &lt;&lt;Ogbalinya gbeka to yi ishɛ ingwunɔ emi esho kpaa to yi udɛ, nghaduu Ongwɛ Inggisɛ dzɛ yi imbe okye ikye da ba.&gt;&gt;<verse eid="MAT 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21"/>Ongwafɔ oka nyan gbɛɛ, &lt;&lt;Otsɛ, ungwɔ ongwi ababɔ yɔ, detse nin ka kye Otsani ndzi se.&gt;&gt;<verse eid="MAT 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22"/>Nghaduu iYesu nyan gbɛɛ, &lt;&lt;Kyɛdɔ ani, dzata emi ikwukwɔ nu ma ndzi ewoma.&gt;&gt;<verse eid="MAT 8:22"/></para>
  <para style="s1">IYesu nu akpeni kwulu</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23"/>IYesu si kaka uwaa man emi ongwafɔɔn kyɛdɔn. <verse eid="MAT 8:23"/><verse number="24" style="v" sid="MAT 8:24"/>Vla nɛta, onikyɔ awo gbokyɛɛ mi utɔ nani, nghanɛ akpeni le kadu yaokɛ uwaa. Nghaduu iYesu le nuna. <verse eid="MAT 8:24"/><verse number="25" style="v" sid="MAT 8:25"/>Emi ongwafɔɔn kɛ ka kyilen, nyan gbɛɛ, &lt;&lt;Otsɛ, dulu eyi tɔ! Di eyi le dzili!&gt;&gt;<verse eid="MAT 8:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26"/>O nya ma gbɛɛ, &lt;&lt;Ema ngwu oyɛyɛ onuunu mgbi ema shanyɛ nɛ, i kyɔsinɛ ema dzɛ yi imio kpakpa ngha?&gt;&gt; Ta o si kyato kyɔkyɔ yi awo bɛyi akpeni nani, i si kwulu tsiin.<verse eid="MAT 8:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27"/>I kwulu inggisɛ ntona ewo man a byita gbɛɛ, &lt;&lt;Nɛnɛ li ali itɔ inggisɛ dɛn? Ngwi awo yi akpeni kpaa li fwon!&gt;&gt;<verse eid="MAT 8:27"/></para>
  <para style="s1">Engyulɔ efa ama ndzɛ yi esɛ ikye</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28"/>Ngwi iYesu foye dɔkɛ ayɛsɛ iGadarene nɛ, engyulɔ efa ama nto yi esɛ ikye tɔkyɛ imbe endzi wa tun. A sulu imoga ewo nghanɛ inggisɛ onyi kpaa li nyɛ ofɛ na ba. <verse eid="MAT 8:28"/><verse number="29" style="v" sid="MAT 8:29"/>A kweela gbɛɛ, &lt;&lt;Li alungwɔ wo abu yi eyi, Ongwɛ Imgbasho? Abu ba owa nu eyi isɔ duuse ni onɔ ma wa gyɔɔ?&gt;&gt;<verse eid="MAT 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30"/>Ibyi obyia kwuto le gye ungwɔ, fyata yi ama gwee. <verse eid="MAT 8:30"/><verse number="31" style="v" sid="MAT 8:31"/>Emɛsɛ ntona tɛkyɛ yi iYesu gbɛɛ, &lt;&lt;Kini abu lɔlu eyi tɔ yɔ, nu eyi ofɛ ni eyi ka kaka ibyi obyia ntonani.&gt;&gt;<verse eid="MAT 8:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32"/>IYesu nya ma gbɛɛ, &lt;&lt;Lu!&gt;&gt; Ta a si tɔ lu ka kaka ibyi obyia ntonani, man obyia ntona duu tsinya ka ngwuta mi agobo yaokɛ utɔ si kwulu mi eni. <verse eid="MAT 8:32"/><verse number="33" style="v" sid="MAT 8:33"/>Ama ongyo obyia ntona si tsinya lu ka kaka igeli kye odzɛ nɛ gbɔfwɛ kpatsɛ duu yi ungwɔ nkyɔ yi engyulɔ ama nto yi esɛ ikye ntonani. <verse eid="MAT 8:33"/><verse number="34" style="v" sid="MAT 8:34"/>Nɛ emi igeli na duu tasɛ ka tu iYesu. Ngwi a din nɛ, a tɛkyɛ yan gbɛɛ non lu dzata ayɛsɛ mgbi ama.<verse eid="MAT 8:34"/></para>
  <chapter eid="MAT 8"/>
  <chapter number="9" style="c" sid="MAT 9"/>
  <para style="s1">IYesu ngyɛlu inggisɛ nkwulu <optbreak/> afɔ yi abɔ ootse</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1"/>IYesu kaka uwaa, foye luba igeli mgban. <verse eid="MAT 9:1"/><verse number="2" style="v" sid="MAT 9:2"/>Engyulɔ angbeka kye inggisɛ nkwulu afɔ yi abɔ ba mbon, ladzɛ amukwu. Ngwi iYesu di oyɛyɛ onuunu mgbi ama nɛ, o nya inggisɛ otummya na gbɛɛ, &lt;&lt;Ka teeyi ba, ongwani; a dzita abu yi ali ibwubwe.&gt;&gt;<verse eid="MAT 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3"/>Mi ungwɔnɛ nɛ, etsetse mgbi ola mgbi iMose angbeka gbɔ yi ewoma gbɛɛ, &lt;&lt;Inggisɛ nɛ le fya Imgbasho ito!&gt;&gt;<verse eid="MAT 9:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4"/>Ngwi iYesu ye ewodzɛ mgbi ama nɛ, o gbɛɛ, &lt;&lt;Kyɔsinɛ ngwi ema le tsɛwodzɛ ibwubwe mi itukwu nghaa? <verse eid="MAT 9:4"/><verse number="5" style="v" sid="MAT 9:5"/>Li ole nghao sunɔ ba: li ogbɛɛ, &lt;A dzita abu yi ali ibwubwe,&gt; naadi ogbɛɛ, &lt;Kyato kyikyɛ&gt;? <verse eid="MAT 9:5"/><verse number="6" style="v" sid="MAT 9:6"/>Kpaa li ikye ni ema ye gbɛɛ Ongwɛ Inggisɛ dzɛ yi mfye mi ɛsɛ nɛ odzɛ inggisɛ ta yi ali ibwubwe...&gt;&gt; Ta o nya inggisɛ ntummya ma gbɛɛ, &lt;&lt;Kyato, kye amukwu mgbi abu lu udɛ.&gt;&gt; <verse eid="MAT 9:6"/><verse number="7" style="v" sid="MAT 9:7"/>Ongyulɔ ma si kyato lu udɛ. <verse eid="MAT 9:7"/><verse number="8" style="v" sid="MAT 9:8"/>Ngwi ibyi inggisɛ ntona di ungwɔnɛ nɛ, imio wo ma; man a si tsɛ Imgbasho, ongwu nkye itɔ mfye na nu inggisɛ mani.<verse eid="MAT 9:8"/></para>
  <para style="s1">Ela okwu-kwu mgbi iMatiu</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9"/>Dafi iYesu dzata imbe na kiyayi nɛ, o di ongyulɔ ngwu a li kwun gbɛɛ iMatiu sɔdzɛ imbe mgbi ama ogbɛ udza ifyɛɛ. O nyan gbɛɛ &lt;&lt;Kyɛdɔ ani,&gt;&gt; ta iMatiu si kyato kyɛdɔn.<verse eid="MAT 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10"/>Ngwi iYesu le gye oga ongwi onɔdɛ mi udɛ iMatiu nɛ, ama ogbɛ udza ifyɛɛ gwuba yi &lt;&lt;emi ali ibwubwe&gt;&gt; ba wa gye ungwogye yan bɛyi engwafɔɔn. <verse eid="MAT 9:10"/><verse number="11" style="v" sid="MAT 9:11"/>Ngwi emi iFarasi di ungwɔnɛ nɛ, a byi engwafɔɔn gbɛɛ, &lt;&lt;Kyɔsinɛse otsetse mgbi ema le gye ungwogye yi ama ogbɛ udza ifyɛɛ bɛyi &lt;emi ali ibwubwe&gt;? &gt;&gt;<verse eid="MAT 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12"/>Ngwi iYesu fwo odzɛ nɛ nɛ, o gbɛɛ, &lt;&lt;Inggisɛ ama nle saan mina inggisɛ obwe ootse ba, kpaa li ama ndotse ta. <verse eid="MAT 9:12"/><verse number="13" style="v" sid="MAT 9:13"/>Nghaduu lu na ka kpayi ungwɔ ngwi odzɛ nɛ tso mani: &lt;Ani mina elela odiidi, yama li ifɛ ofɛ-fɛ ba.&gt; Ikyesinɛ ani ba owa kwu ama osaan ela ba, kpaa li emi ali ibwubwe.&gt;&gt;<verse eid="MAT 9:13"/></para>
  <para style="s1">A byi iYesu ita mi odzɛ <optbreak/> ondu otukwu-tukwu</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14"/>Nɛ engwafɔ iJɔn ba wa byi iYesu gbɛɛ, &lt;&lt;Kyɔsinɛ ngwi eyi yi emi iFarasi li tukwondu, kpaa engwafɔ abu li tukwondu ba?&gt;&gt;<verse eid="MAT 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15"/>IYesu nu uka gbɛɛ, &lt;&lt;Ka kyɔsinɛ ngwi ingyoga mgbi obongyaa ofufɛ ka kyelela ngwi o ka dzɛ yi ama? Onɔ ka wa ba ngwi a ka kyi kyelu obongyaa ofufɛ mboma; ta a ka tukwondu.<verse eid="MAT 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16"/>&lt;&lt;Inggisɛ onyi kpaa li kye ayɛ angwuto ofufɛ tukwu ishangli ba. Ikyesinɛ otukwu-tukwu na ka kwɔdzɛ vɔn. <verse eid="MAT 9:16"/><verse number="17" style="v" sid="MAT 9:17"/>Naadi inggisɛ li kye eneekwɔ ofufɛ yaokɛ ikpɔkpɔ eneekwɔ ogbugbe kpaa ba. Kini otsungwɔ kyɔ ngha, ikpɔkpɔ na ka gbobu, eneekwɔ na ka yangwuta man ikpɔkpɔ na ka nyanya. Ei, a li kye eneekwɔ ofufɛ yaokɛ ikpɔkpɔ ofufɛ man ama duu ka nyanya ba.&gt;&gt;<verse eid="MAT 9:17"/></para>
  <para style="s1">Ongwongyaa ikwukwɔ bɛyi ongyaa <optbreak/> ndotse</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18"/>Dafi iYesu le gbɔdzɛ nɛ, ongye ogbe inggisɛ teyi ba wa gbe akwafɔ kwɛsɛ mi iyayi mbon si gbɛɛ, &lt;&lt;Ongwani ongwu ongyaa kuma kwulu ta aani. Nghaduu ba wa kye abɔ mgbi abu gbon, ta o ka dzɛ oshishe.&gt;&gt; <verse eid="MAT 9:18"/><verse number="19" style="v" sid="MAT 9:19"/>IYesu si kyato yi engwafɔɔn kɛ yan.<verse eid="MAT 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20"/>Mi onɔ mata ongyaa nle yɛ eyi mɛ onova iwyodefa ba mi iyikpa mgbi iYesu wa kye abɔ gbon ondu angwuto. <verse eid="MAT 9:20"/><verse number="21" style="v" sid="MAT 9:21"/>O gbɔ yi ewon gbɛɛ, &lt;&lt;Ni ani kye abɔ gbon gbo-gbo angwuto kpata, ootse mgbi ani ka ngyɛ.&gt;&gt;<verse eid="MAT 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22"/>IYesu kyata din, si gbɛɛ, &lt;&lt;Fyumfye itukwu, ongwani; oyɛyɛ onuunu mgbi abu ngyɛlu abu ootse.&gt;&gt; Man ootse mgbi ongyaa na si ngyɛ mi onɔ nani.<verse eid="MAT 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23"/>Ngwi iYesu kaka udɛ ongye ogbe inggisɛ teyi wa di ama ofo elete yi ibyi inggisɛ tole wulu nɛ, <verse eid="MAT 9:23"/><verse number="24" style="v" sid="MAT 9:24"/>o gbɛɛ, &lt;&lt;Lu enggengga na, ongwongyaa nɛ kwulu ba kpaa o le nanuna.&gt;&gt; A si shan isha. <verse eid="MAT 9:24"/><verse number="25" style="v" sid="MAT 9:25"/>Ngwi a nu ibyi inggisɛ ntona tasɛ nɛ, iYesu kaka ifoozu ka byi ongwongyaa na mi abɔ, man o kyato. <verse eid="MAT 9:25"/><verse number="26" style="v" sid="MAT 9:26"/>Odzɛ nɛ si gbɔfwɛ kpatsɛ ayɛsɛ na duu.<verse eid="MAT 9:26"/></para>
  <para style="s1">IYesu kwulu obinɛ efa inɛ</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27"/>Dafi iYesu dzata imbe na le lu nɛ, obinɛ nghi efa kyɛdɔn, le kweela gbɛɛ, &lt;&lt;Di eyi elela, Ongwɛ iDevedi!&gt;&gt;<verse eid="MAT 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28"/>Ngwi o yɛ lu onufozu nɛ, obinɛ ntona si ba mbon, man o byi ma gbɛɛ, &lt;&lt;Ema noyɛyɛ gbɛɛ ani ka yagba kwulu ema inɛɛ?&gt;&gt; A gbɛɛ, &lt;&lt;Ɛɛn, Otsɛ.&gt;&gt;<verse eid="MAT 9:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29"/>Nɛ o kye abɔ gbo ma inɛ si gbɛɛ, &lt;&lt;No kyɔ dafi oyɛyɛ onuunu mgbi ema dzɛ mani&gt;&gt; <verse eid="MAT 9:29"/><verse number="30" style="v" sid="MAT 9:30"/>ta inɛ mgbi ama kwulu. IYesu kwo ma adɔ kpɔklɔɔ gbɛɛ, &lt;&lt;Di gbɛɛ ema nu inggisɛ onyi ye odzɛ mi ungwɔnɛ ba na.&gt;&gt; <verse eid="MAT 9:30"/><verse number="31" style="v" sid="MAT 9:31"/>Nghaduu a tasɛ ka kye odzɛ mgban gbɔ kpatsɛ ɛsɛ na duu.<verse eid="MAT 9:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32"/>Ngwi iYesu yi engwafɔɔn le tasɛ nɛ, a kye inggisɛ ngwu onodzi ibwubwe bwan non yɛɛ ikplima ba mbon. <verse eid="MAT 9:32"/><verse number="33" style="v" sid="MAT 9:33"/>IYesu lɔ onodzi emɛsɛ na onya tɔ ta, inggisɛ ikplima na si gbɔdzɛ. I kwulu ibyi inggisɛ ntona ewo ta a gbɛɛ, &lt;&lt;Nkonyonyi itɔ nɛ kpaa kyɔ mi ɛsɛ Israi ye waba.&gt;&gt;<verse eid="MAT 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34"/>Nghaduu emi iFarasi gbɛɛ, &lt;&lt;Li ongyukwo mgbi emɛsɛ nun mfye se ngwi o le dulu onodzi emɛsɛ tɔ aali.&gt;&gt;<verse eid="MAT 9:34"/></para>
  <para style="s1">Elela kyɔ iYesu wo inggisɛ ntonani</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35"/>IYesu kaka igeli yi agwudɛ duu le tsungwɔ mi ozu okwakye mgbi emi iJuda, le gbɔ Esɔ Osuse mgbi esutɔ dile ngyɛlu ali ootse yi ama ngwu i sisi loma ewo duu. <verse eid="MAT 9:35"/><verse number="36" style="v" sid="MAT 9:36"/>Ngwi o di ibyi inggisɛ nɛ, elela kyɔn wo ma, ikyekyɛ a dzɛ yi okakewo di yɛɛ elela, inggisɛ ogbe ma teyi dzɛma ba, dafi mmala ndzɛ yi inggisɛ ongyo ma ba mani. <verse eid="MAT 9:36"/><verse number="37" style="v" sid="MAT 9:37"/>Ta iYesu nya engwafɔɔn gbɛɛ, &lt;&lt;Etɔ oshɛ-shɛ le gwuba, kpaa emi idɔ le gwee ta. <verse eid="MAT 9:37"/><verse number="38" style="v" sid="MAT 9:38"/>Bɔ Otsɛ mgbi etɔ oshɛ-shɛ no gbe emi idɔ ba okwɔ mgban.&gt;&gt;<verse eid="MAT 9:38"/></para>
  <chapter eid="MAT 9"/>
  <chapter number="10" style="c" sid="MAT 10"/>
  <para style="s1">IYesu dɔ ama ogbikyon ntona esɔ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1"/>IYesu kwu ama ogbikyon iwyodefa ntona ela ba mbon si kye mfye nu ma gbɛɛ nu ma lɔ onodzi ibwubwe onya di ngyɛlu ali inggisɛ ngwu i sisi lon ewo yi ali itɔ ootse duu.<verse eid="MAT 10:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 10:2"/>Nɛnɛ li iyi mgbi ama ogbikyon iwyodefa ma aani: Ababɔ li, iSaimɔn (ongwu a li kwun di iPyita nani) yi ongwunɔn Andru bɛyi iJɛnsi ongwɛ iDzebedi yi ongwunɔn iJɔn <verse eid="MAT 10:2"/><verse number="3" style="v" sid="MAT 10:3"/>bɛyi iFyilipi yi iBatlomi yi iTɔmɔsu yi iMatiu inggisɛ ogbɛ udza ifyɛɛ bɛyi iJɛnsi ongwɛ Alfeɔ yi iTedusu <verse eid="MAT 10:3"/><verse number="4" style="v" sid="MAT 10:4"/>yi iSaimɔn Ogbodami bɛyi iJuda iSkarɔti ongwu nkye iYesu gya nani.<verse eid="MAT 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5"/>Emi iwyodefa ntonɛ iYesu dɔ ma esɔ wo ma ola ntonɛ gbɛɛ: &lt;&lt;Ka kɛ mbi Udzengye ba na dika kaka igeli mgbi emi iSamaria onyi ba. <verse eid="MAT 10:5"/><verse number="6" style="v" sid="MAT 10:6"/>Kpaa kɛ mbi mmala mgbi emi Israi nbyulu mani. <verse eid="MAT 10:6"/><verse number="7" style="v" sid="MAT 10:7"/>Ni ema kɛ yɔ, gbeesɔ nya ma gbɛɛ: &lt;Esutɔ ongwi esho ma dzɛ kwɛkwɛ wa.&gt; <verse eid="MAT 10:7"/><verse number="8" style="v" sid="MAT 10:8"/>Ngyɛlu ama ndotse duu ootse, kyile emi ikwukwɔ, nu emi otsoma yɛɛ saan na, dulu onodzi emɛsɛ tɔ. Ema gbɛ ayayi, di kye nu ayayi na. <verse eid="MAT 10:8"/><verse number="9" style="v" sid="MAT 10:9"/>Ka yama kye abashi naadi iyudza onyina-nyina naadi itigbla mi igbe mgbi ema ba; <verse eid="MAT 10:9"/><verse number="10" style="v" sid="MAT 10:10"/>ka kye igbe byi mi okyɛɛ nɛ ba, naadi angwuto oka hona okpafɔ naadi okwuta ba, ikyesinɛ inggisɛ idɔ mɛ ogye adzɛ mgban.<verse eid="MAT 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11"/>&lt;&lt;Ali igeli naadi agwudɛ ngwi ema kaka duu, pita inggisɛ ngwu mɛ di gbela ogbɛ ema dafi ingyoga mani, di dzɛ udan nghataa ni ema dzata imbe nani. <verse eid="MAT 10:11"/><verse number="12" style="v" sid="MAT 10:12"/>Onɔ ngwi ema kaka udɛ yɔ, kye angba kwu ma. <verse eid="MAT 10:12"/><verse number="13" style="v" sid="MAT 10:13"/>Ni udɛ ma gbɛ ema yɔ, ni iyu mgbi ema tila mi ele; non gbɛ ema bayɔ, iyu mgbi ema no yɛ lu mbi ema. <verse eid="MAT 10:13"/><verse number="14" style="v" sid="MAT 10:14"/>Ni inggisɛ onyi gbɛ ema naadi fwo elodzɛ mgbi ema bayɔ, gbolu onbulu mi afɔ mi onɔ ngwi ema dzata udɛ na hona igeli na mani. <verse eid="MAT 10:14"/><verse number="15" style="v" sid="MAT 10:15"/>N nya ema otsitsi, ka tatase lo iSodon yi iGomora mi egbe ikwɔ ma ngha igeli nani. <verse eid="MAT 10:15"/><verse number="16" style="v" sid="MAT 10:16"/>Ani le dɔ ema esɔ tasɛ dafi mmala mi idzidzɛ emi idukwlɛbɛ mani. Nghanɛ kwiinɛ dafi ifa dika dzɛ yi obube ba dafi anyama mani.<verse eid="MAT 10:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 10:17"/>&lt;&lt;Gbɛwɛbyi inggisɛ na, a ka gbe ema wo ama ogbiikwɔ abɔ di gbo ema ibe mi ozu okwakye mgbi ama. <verse eid="MAT 10:17"/><verse number="18" style="v" sid="MAT 10:18"/>Ikye odzɛ mgbi ani, a ka gbe ema ba wa kyɔ obwɛndɛ inai emi iGɔna yi emi utɔ bɛyi mbi emi Agwɛsɛ. <verse eid="MAT 10:18"/><verse number="19" style="v" sid="MAT 10:19"/>Kpaa onɔ ngwi a bwa ema ma, ka teeyi mi odzɛ ngwi ema ka gbɔ naadi dafi ema ka gbɔn ba. Mi onɔ na Imgbasho ka nu ema elodzɛ ngwi ema ka gbɔ mani. <verse eid="MAT 10:19"/><verse number="20" style="v" sid="MAT 10:20"/>Ikyekyɛ li ema kale gbɔdzɛ ba, kpaa li Onodzi mgbi Otsema kale gbɔdzɛ nyɛ mbi ema.<verse eid="MAT 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21"/>&lt;&lt;Inggisɛ ka kye ongwunɔn nu mi abɔ ikwongye nu ma ngwɔn, otsɔngwɛ kpaa dika kyɔ ngha yi ongwan; ɛngbɛ ka kye afɔ twɛɛsɛ yi otsɔma di nu ma tu ikwongye. <verse eid="MAT 10:21"/><verse number="22" style="v" sid="MAT 10:22"/>Inggisɛ duu ka di ema taanyi mi ikye ani, nghaduu inggisɛ nkwulɛsɛ kpɔklɔɔ ka dondu ma ka watɔ. <verse eid="MAT 10:22"/><verse number="23" style="v" sid="MAT 10:23"/>Ni a nu ema adzɛ mi imbe oka yɔ, tsinya lu imbe oka. N nya ema otsitsi, ema ka kpatsɛ ogalu ama nto ɛsɛ Israi duu bata Ongwɛ Inggisɛ ka yɛ.<verse eid="MAT 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24"/>&lt;&lt;Inggisɛ okpayi ungwɔ li ngha otsetse mgban ba, hona ongbidɔ li ngha ongyukwo mgban ba. <verse eid="MAT 10:24"/><verse number="25" style="v" sid="MAT 10:25"/>Ni inggisɛ okpayi ungwɔ wa yɛɛ dafi otsetse mgban yɔ, i gyɔ, ni ongbidɔ kpaa wa yɛɛ dafi ongyukwo mgban yɔ, i gyɔ. Ni otsungwudɛ kpaa a kwun gbɛɛ iBɛdzɛbu ma, emidan ma a ka kwu ma sinɛ tsatso!<verse eid="MAT 10:25"/></para>
  <para style="s1">Ongwu a ka mio</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26"/>&lt;&lt;Nghanɛ ka mio ma ba. Ungwɔ onyi ngwi a kye tukwu se ngwi a ka kye dɛsɛ ba dzɛma ba, naadi kye da ngwi a ka nu ma ye ba dzɛma ba. <verse eid="MAT 10:26"/><verse number="27" style="v" sid="MAT 10:27"/>Ungwɔ ngwi ani nya ema mi iyifu ma, gbɔn mi osa na; ungwɔ ngwi ani di nya ema mi odaada yɔ, dɔkɛ ikyendu gbɔn tasɛ na. <verse eid="MAT 10:27"/><verse number="28" style="v" sid="MAT 10:28"/>Ka mio ama nka ngwɔ ikpewo kpaa ka yagba ngwɔ oshishe ba na ba. Tatase, mio ongwu nka dzili oshishe bɛyi ikpewo mi udola nani. <verse eid="MAT 10:28"/><verse number="29" style="v" sid="MAT 10:29"/>A li kye ifyilo efa gya mi anini onyi baa? Nghaduu onyi mboma kpaa ka ngwuta ba esɛ ba sede li mi oweka mgbi Otsema. <verse eid="MAT 10:29"/><verse number="30" style="v" sid="MAT 10:30"/>Alotu mi ikye mgbi ema duu a ye umbwon. <verse eid="MAT 10:30"/><verse number="31" style="v" sid="MAT 10:31"/>Nghanɛ ka wimio ba; ema dzɛ yi oyabɔ ngha ifyilo.<verse eid="MAT 10:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32"/>&lt;&lt;Ali inggisɛ ngbela ani mi inɛ inggisɛ yɔ, ani kpaa ka gbelan mi inɛ Otsani ndzɛ esho nani. <verse eid="MAT 10:32"/><verse number="33" style="v" sid="MAT 10:33"/>Nghaduu ali inggisɛ nfwa ani mi inɛ inggisɛ yɔ, ani kpaa ka tangwan mi inɛ Otsani ndzɛ esho nani.<verse eid="MAT 10:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34"/>&lt;&lt;Ema tsɛwɛ gbɛɛ ani ba owa kye iyu ba ɛsɛɛ? Ani ba yi iyu ba, kpaa li okwusunkli. <verse eid="MAT 10:34"/><verse number="35" style="v" sid="MAT 10:35"/>Ani ba owa kyata</para>
  <para style="m" vid="MAT 10:35">&lt;&lt; &lt;ongyulɔ yile afɔ twɛsɛ yi otsɔn,</para>
  <para style="q1" vid="MAT 10:35">ongwongyaa oyile afɔ twɛsɛ yi onɔn</para>
  <para style="q2" vid="MAT 10:35">owongwɛ ka kye iga fyi yi onoban<verse eid="MAT 10:35"/></para>
  <para style="q2">
    <verse number="36" style="v" sid="MAT 10:36"/>engyikyili mgbi inggisɛ ka li mi etɔ mgban.&gt;<verse eid="MAT 10:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37"/>&lt;&lt;Ali inggisɛ ngwu otsɔn naadi onɔn kpan itukwu ngha ani yɔ, o mɛ oli ongwafɔ mgbi ani ba; ali inggisɛ ngwu ongwan ongyulɔ naadi ongyaa kpan itukwu ngha ani yɔ, o mɛ oli ongwafɔ mgbi ani ba; <verse eid="MAT 10:37"/><verse number="38" style="v" sid="MAT 10:38"/>ali inggisɛ ndi kye ekwatsi mgban kyɛdɔ ani bayɔ, o mɛ oli ongwafɔ mgbi ani ba. <verse eid="MAT 10:38"/><verse number="39" style="v" sid="MAT 10:39"/>Ali inggisɛ nfya odulu oshishe mgban tɔ, oshishe na ka byulu lon, inggisɛ ngwu oshishe mgban byulu lon mi ikye ani ma ka tun.<verse eid="MAT 10:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40"/>&lt;&lt;Inggisɛ ngbɛ ema yɔ gbɛ ani, ongwu ndi gbɛ ani gbɛ ongwu ndɔ ani esɔ mani. <verse eid="MAT 10:40"/><verse number="41" style="v" sid="MAT 10:41"/>Ali inggisɛ ngbɛ oyegbɔ ikyegbɛɛ o li oyegbɔ yɔ, ka gbɛ umba mgbi oyegbɔ, inggisɛ ndi gbɛ inggisɛ nle saan ikyegbɛɛ o le saan yɔ, ka gbɛ umba mgbi inggisɛ nle saan. <verse eid="MAT 10:41"/><verse number="42" style="v" sid="MAT 10:42"/>Ma ni inggisɛ kye eni oyuyu mi ibwɛ kpata kye nu onyi mbi ɛngbɛ ama oshilɛlɛ ntonɛ ikyegbɛɛ o li ongwafɔ mgbi ani yɔ, n nya ema otsitsi, umba mgban ka yama byulu lon ba duudu.&gt;&gt;<verse eid="MAT 10:42"/></para>
  <chapter eid="MAT 10"/>
  <chapter number="11" style="c" sid="MAT 11"/>
  <para style="s1">IYesu yi iJɔn okyɔ iBatisima</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1"/>Ngwi iYesu ngyɛlu owo ama ogbyikyon iwyodefa ola nɛ, o dzata imbe na lu le tsungwɔ dile gbeesɔ mi igeli emi iGalalia.<verse eid="MAT 11:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2"/>Dafi iJɔn fwo mi obawi ungwɔ ngwi iYesu le kyɔ nɛ, o dɔ engwafɔ mgban esɔ <verse eid="MAT 11:2"/><verse number="3" style="v" sid="MAT 11:3"/>oka byi iYesu gbɛɛ, &lt;&lt;Abu li ongwu nka ba ma naadi ni eyi kye inɛ byi inggisɛ oka idzidza?&gt;&gt;<verse eid="MAT 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4"/>IYesu nu uka gbɛɛ, &lt;&lt;Yɛ lu ka nya iJɔn ungwɔ ngwi ema fwo diyɛ di nɛni: <verse eid="MAT 11:4"/><verse number="5" style="v" sid="MAT 11:5"/>Ama nbinɛ le di, ama ntummya le kyikyɛ, ama ndzɛ yi otsoma, otsoma le ngyɛ loma, ama nkyadɔ le fwo, emi ikwukwɔ le kyɛɛ luba oshishe, a di gbɔ Esɔ Osuse nya emi adzɛ. <verse eid="MAT 11:5"/><verse number="6" style="v" sid="MAT 11:6"/>Imgbasho ka kye mse bɛ ali inggisɛ nfwa ani ba duu ewo mi ikye ungwɔ ngwi ani le kyɔ nɛni.&gt;&gt;<verse eid="MAT 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7"/>Dafi engwafɔ iJɔn le lu nɛ, iYesu si wita ogbɔdzɛ mgbi iJɔn nya inggisɛ ntona gbɛɛ: &lt;&lt;Li ekyɛ ngwi ema kɛ okwɛsɛ le ka di? Li atakwu ngwi awo le fan maa? <verse eid="MAT 11:7"/><verse number="8" style="v" sid="MAT 11:8"/>Ni li ngha ba ma, li ekyɛ ngwi ema tasɛ le ka di? Li inggisɛ nwo angwuto osusee? Ei, ama nwo angwuto osuse to udɛ emi utɔ ma. <verse eid="MAT 11:8"/><verse number="9" style="v" sid="MAT 11:9"/>Nɛ li ekyɛ ngwi ema tasɛ oka di? Li oyegbɔɔ? Ɛɛn, n nya ema, o nghaangha oyegbɔ. <verse eid="MAT 11:9"/><verse number="10" style="v" sid="MAT 11:10"/>Nɛnɛ li ongwu a lɔ mi ikyen gbɛɛ:</para>
  <para style="q1" vid="MAT 11:10">&lt;&lt; &lt;N ka dɔ ongyesɔ</para>
  <para style="q2" vid="MAT 11:10">mgbi ani teyi abu,</para>
  <para style="q1" vid="MAT 11:10">nka teyi ka mɛ abu ofɛ.&gt;<verse eid="MAT 11:10"/></para>
  <para style="m">
    <verse number="11" style="v" sid="MAT 11:11"/>N nya ema otsitsi: Mi idzidzɛ ama ngwu engyaa mba mi ɛsɛ nɛ duu, inggisɛ onyi kpaa shewo ngha iJɔn okyɔ iBatisima ba; nghaduu ongwu n yɛyikpa mi esutɔ ongwi esho ma, shewo nghan. <verse eid="MAT 11:11"/><verse number="12" style="v" sid="MAT 11:12"/>Kyɛ mi egbe mgbi iJɔn okyɔ iBatisima nghataa ba onɛnɛni, esutɔ ongwi esho gyadzɛ mi anglama, emi anglama di kye gbɛlu mi oglijo. <verse eid="MAT 11:12"/><verse number="13" style="v" sid="MAT 11:13"/>Ikyesinɛ Oyegbɔ duu yi Ola mgbi iMose yegbɔ nghataa ba onɔ mgbi iJɔn nani. <verse eid="MAT 11:13"/><verse number="14" style="v" sid="MAT 11:14"/>Ma ni ema dzɛ yi oweka ogbela yɔ, o li Elaija ongwu nkika ba mani. <verse eid="MAT 11:14"/><verse number="15" style="v" sid="MAT 11:15"/>Inggisɛ ndzɛ yi adɔ yɔ, no fwo.<verse eid="MAT 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16"/>&lt;&lt;Li ekyɛ ngwi ani ka kye inggisɛ ongwu onɛnɛ mba yan? A to dafi ɛngbɛ sɔto mi ifyidu dile kwu angbeka ela gbɛɛ:<verse eid="MAT 11:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="MAT 11:17"/>&lt;&lt; &lt;Eyi fo oca mi ikye ema kpaa ema shufwe ba,</para>
  <para style="q2" vid="MAT 11:17">eyi shashi ibɔ kpaa,</para>
  <para style="q1" vid="MAT 11:17">ema tsukwu ba.&gt;<verse eid="MAT 11:17"/></para>
  <para style="m">
    <verse number="18" style="v" sid="MAT 11:18"/>Lubana iJɔn ba le gye naadi le wa ba, nɛ a gbɛɛ, &lt;O dzɛ yi onodzi emɛsɛ.&gt; <verse eid="MAT 11:18"/><verse number="19" style="v" sid="MAT 11:19"/>Ongwɛ Inggisɛ ba le gye dile wa, nɛ a gbɛɛ, &lt;Inggisɛ nɛ li inggisɛ okyɔ nggwɔ di fyɛbyɛ, uka mgbi ama ogbɛ udza ifyɛɛ yi &lt;&lt;emi ali ibwubwe.&gt;&gt; &gt; Kpaa ozoyeye tso tɔ yɛyɛ mi okyɔɔkyɔ mgban.&gt;&gt;<verse eid="MAT 11:19"/></para>
  <para style="s1">Ikamba ikye ogalu ama nnoyɛyɛ ba</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20"/>Nɛ iYesu wita ogbɔdzɛ agya yi ogalu ama ngwi ongwu kyungwɔ okwulewo angbeka mi efu mani, ikyekyɛ a kyatitukwu ba. <verse eid="MAT 11:20"/><verse number="21" style="v" sid="MAT 11:21"/>&lt;&lt;Ahoo ikye abu, iKoradzin! Ahoo ikye abu, iBɛtsaida! Ni ungwɔ okwulewo ngwi a kyɔ mbi abu na ki li mi iTiru yi iSidon ngwi a kyɔn yɔ, a ki kyatitukwu gbegbe gbe ishangli wo ewo di mwa utɔ tukwu ewo. <verse eid="MAT 11:21"/><verse number="22" style="v" sid="MAT 11:22"/>Kpaa n nya ema Imgbasho ka di iTiru yi iSidon elela ngha ema mi egbe ikwɔ mani. <verse eid="MAT 11:22"/><verse number="23" style="v" sid="MAT 11:23"/>Ma abu, iKapenahun, a ka kyile abu esho wɛ? Ei, abu ka lu esɛ mi udola. Ungwɔ okwulewo ngwi a kyɔ mbi abu na, ki li mi iSodon yɔ, kika tila dzɛ nghataa ba inɛ. <verse eid="MAT 11:23"/><verse number="24" style="v" sid="MAT 11:24"/>Nghaduu n nya ema gbɛɛ Imgbasho ka nghao di iSodon elela ngha abu mi egbe ikwɔ mani.&gt;&gt;<verse eid="MAT 11:24"/></para>
  <para style="s1">Ba mbi ani wa tonya</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25"/>Mi onɔ na iYesu gbɛɛ, &lt;&lt;Ani tsɛ abu, Otsani, Otsɛ mgbi esho yi esɛ, ikyekyɛ abu kye ungwɔ ntonɛ da ama oyodzɛ yi ama okpayi afɛ, di kye ma tso ɛngbɛ ama oshilɛlɛ. <verse eid="MAT 11:25"/><verse number="26" style="v" sid="MAT 11:26"/>Ɛɛn, Otsɔ, li ngha ngwi abu mina gbɛɛ no dzɛ aali.<verse eid="MAT 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27"/>&lt;&lt;Alungwɔ duu Otsani kye wo ani abɔ. Inggisɛ onyi kpaa ye Ongwɛ ba li Otsɔn ta, inggisɛ onyi kpaa di ye Otsɔngwɛ ba se li Ongwɛ ta bɛyi ama ngwu Ongwɛ sadu okyon tso ma mani.<verse eid="MAT 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28"/>&lt;&lt;Ba mbi ani na, ema ama ngwu ndɛ ngwi okye di lo ema mani, ta n ka nu ema onya. <verse eid="MAT 11:28"/><verse number="29" style="v" sid="MAT 11:29"/>Kyelu onogblo mgbi ani di kpayi mbi ani na, ikyena ani le dumɔɔ di yile ewo esɛ mi itukwu, ta ema ka tu onya mi oshishe mgbi ema. <verse eid="MAT 11:29"/><verse number="30" style="v" sid="MAT 11:30"/>Ikyekyɛ onogblo mgbi ani sunɔ ba, okye mgbi ani kpaa le pee.&gt;&gt;<verse eid="MAT 11:30"/></para>
  <chapter eid="MAT 11"/>
  <chapter number="12" style="c" sid="MAT 12"/>
  <para style="s1">Otsɛ mgbi egbe otonyewo</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1"/>Mi onɔ na emi iYesu kyikyɛ nyɛ okwɔ ungwogyowe. Enbwa dɔ engwafɔɔn ta a sile wulɔ ekwu le ngwunu bukwu. <verse eid="MAT 12:1"/><verse number="2" style="v" sid="MAT 12:2"/>Ngwi emi iFarasi di ungwɔnɛ nɛ, a nyan gbɛɛ, &lt;&lt;Dii! Engwafɔ mgbi abu le kyungwɔ nli ola ba mi egbe otonyewo.&gt;&gt;<verse eid="MAT 12:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3"/>IYesu nu ma uka gbɛɛ, &lt;&lt;Ema gbɔ ungwɔ ngwi utɔ iDevedi kyɔ mi onɔ ngwi ongwu bɛyi ama nkyɛ yan ngwi enbwa dɔ ma na ye wa lo? <verse eid="MAT 12:3"/><verse number="4" style="v" sid="MAT 12:4"/>O ka kaka ozu Imgbasho, kyi kyelu ibredi ongwi a kye nu Imgbasho umba, nli ola gbɛɛ se li ama ofifɛ mgbi Imgbasho ta ka gye mani. Kye gye di kye nu ama nkyɛ yan ma duu. <verse eid="MAT 12:4"/><verse number="5" style="v" sid="MAT 12:5"/>Naadi ema gbɔ mi afɛ mgbi ola gbɛɛ mi egbe otonyewo ama ofifɛ mi ozu okwukwo osunu Imgbasho mi iJerosalin li kyidɔ kpaa ola li kye wuuta ba lo? <verse eid="MAT 12:5"/><verse number="6" style="v" sid="MAT 12:6"/>N nya ema ongwu nshewo ngha ozu okwukwo osunu Imgbasho mi iJerosalin na dzɛ mmɛnɛni. <verse eid="MAT 12:6"/><verse number="7" style="v" sid="MAT 12:7"/>Ni ema ki ye itɔ elodzɛ ngbɛɛ, &lt;N mina elela odiidi, yama li ifɛ ofɛ-fɛ ba,&gt; na yɔ, ema kika ngwɔ emi emyɛmyɛ ikwɔ ba. <verse eid="MAT 12:7"/><verse number="8" style="v" sid="MAT 12:8"/>Ikyena Ongwɛ Inggisɛ li Otsɛ mgbi egbe otonyewo.&gt;&gt;<verse eid="MAT 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9"/>IYesu dzita imbe na lu ka kaka ozu okwakye mgbi ama, <verse eid="MAT 12:9"/><verse number="10" style="v" sid="MAT 12:10"/>nɛ inggisɛ nwaawaa abɔ dzɛ imbe nani. Ngwi a le pita itɔdzɛ okye abɔ byi efu dulu ongwufabɔ mbi iYesu nɛ, a byun gbɛɛ, &lt;&lt;Li ola ongyɛlu inggisɛ ootse mi egbe otonyewoo?&gt;&gt;<verse eid="MAT 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11"/>IYesu nya ma gbɛɛ, &lt;&lt;Kini inggisɛ mgbi ema onyi dzɛ yi mmala, ma i gbɛsɛ wokɛ ishɛ mi egbe otonyewo ma, o ka dulun tɔ lo? <verse eid="MAT 12:11"/><verse number="12" style="v" sid="MAT 12:12"/>Nghanɛ inggisɛ nghao dzɛ yi oyabɔ ngha mmala! Li ola okyɔ osuse mi egbe otonyewo.&gt;&gt;<verse eid="MAT 12:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 12:13"/>Ta o nya inggisɛ na gbɛɛ, &lt;&lt;Na abɔ mgbi abu.&gt;&gt; Nɛ o na abɔ man i yɛɛ saan dafi oka nani. <verse eid="MAT 12:13"/><verse number="14" style="v" sid="MAT 12:14"/>Kpaa emi iFarasi tasɛ le ka tsɛwɛ dafi ama ka ngwɔ iYesu mani.<verse eid="MAT 12:14"/></para>
  <para style="s1">Ongbidɔ ngwu Imgbasho dulun</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15"/>Ngwi iYesu difwi ungwɔnɛ nɛ, o dzata imbe nani. Ibyi inggisɛ kyɛdɔn, o di ngyɛlu ama nto yi ootse duu ootse, <verse eid="MAT 12:15"/><verse number="16" style="v" sid="MAT 12:16"/>wo ma ola gbɛɛ nu ma ka gbɔdzɛ mgbi ongwu nya inggisɛ onyi ba. <verse eid="MAT 12:16"/><verse number="17" style="v" sid="MAT 12:17"/>Ungwɔnɛ li ombwumbwo odzɛ ntɔ ikpewo oyegbɔ Adzaya mani gbɛɛ,<verse eid="MAT 12:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18"/>&lt;&lt;Nɛnɛ li ongbidɔ mgbi ani ngwu ani dulun,</para>
  <para style="q2" vid="MAT 12:18">o kpa ani itukwu,</para>
  <para style="q1" vid="MAT 12:18">n di dzɛ yi atsa yan;</para>
  <para style="q2" vid="MAT 12:18">n kye Onodzi mgbi ani wokɛ mbon,</para>
  <para style="q1" vid="MAT 12:18">o dika gbɔ otsitsi nya ɛsɛ.<verse eid="MAT 12:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19"/>O ka shɔdzɛ hona feela ba;</para>
  <para style="q2" vid="MAT 12:19">inggisɛ onyi kpaa ka</para>
  <para style="q2" vid="MAT 12:19">fwo ela mgban mi ingɔfɛ ba.<verse eid="MAT 12:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20"/>O ka gbikye engga</para>
  <para style="q2" vid="MAT 12:20">nklɛ ba,</para>
  <para style="q1" vid="MAT 12:20">naadi andɛkwɔ nle diwu</para>
  <para style="q2" vid="MAT 12:20">ma kpaa, o ka myunun ba,</para>
  <para style="q1" vid="MAT 12:20">nghataa ngwi o ka nu emyɛmyɛ fwi tɔ.<verse eid="MAT 12:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="MAT 12:21"/>Mi iyi mgban ɛsɛ duu ka gbɛwɛbyi.&gt;&gt;<verse eid="MAT 12:21"/></para>
  <para style="s1">IYesu bɛyi iBɛdzɛbu</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22"/>Ta a kye inggisɛ ngwu esɛ dɔn ikye binɛ di li ikplima ba mbi iYesu, nɛ iYesu ngyɛlun ootse, man o gbɔdzɛ yɛ di. <verse eid="MAT 12:22"/><verse number="23" style="v" sid="MAT 12:23"/>I kwulu inggisɛ ntona duu ewo, a si gbɛɛ, &lt;&lt;Nɛnɛ ka li Ongwɛ iDevedi ma hoo?&gt;&gt;<verse eid="MAT 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24"/>Kpaa ngwi emi iFarasi fwo odzɛ nɛ mata, a si gbɛɛ, &lt;&lt;Li mi mfye mgbi iBɛdzɛbu utɔ emɛsɛ ta, ngwi inggisɛ nɛ lɔ onodzi emɛsɛ onya tɔ aali.&gt;&gt;<verse eid="MAT 12:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25"/>IYesu ye ewodzɛ mgbi ama, nɛ o gbɛɛ, &lt;&lt;Ali esutɔ n gha yi ewon ka bulu, ali ogalu hona etɔ ndi gha yi ewon ka yagba kwudzɛ ba. <verse eid="MAT 12:25"/><verse number="26" style="v" sid="MAT 12:26"/>Ni iSatan lɔ iSatan onya tɔ, o gha yi ewon. Nghanɛ ka kyɔnɛse esutɔ mgban ka kwudzɛ? <verse eid="MAT 12:26"/><verse number="27" style="v" sid="MAT 12:27"/>Nɛ ni ani lɔ onodzi emɛsɛ tɔ mi mfye mgbi iBɛdzɛbu ma, emidema ma, li lɔ mi ali mfye? Ngyɛse li ama ka fwo ema ikwɔ. <verse eid="MAT 12:27"/><verse number="28" style="v" sid="MAT 12:28"/>Kpaa ni ani lɔ onodzi emɛsɛ tɔ mi Onodzi mgbi Imgbasho yɔ, esutɔ mgbi Imgbasho ba mbi ema sewaani.<verse eid="MAT 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29"/>&lt;&lt;Naadi inggisɛ ka kyɔsinɛ ka kaka udɛ inggisɛ ɛnɛpɛ gbelun okye gbɛ, sede o ka bwa inggisɛ ɛnɛpɛ na adi baa? Duuse o ka gben okye.<verse eid="MAT 12:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30"/>&lt;&lt;Ongye ndzɛ yi ani bayɔ, kye afɔ twɛsɛ yi ani. Ongwu ndi gbe ngwikwo yi ani ba le bulu-bulu. <verse eid="MAT 12:30"/><verse number="31" style="v" sid="MAT 12:31"/>Nghanɛ n nya ema, alobube yi ito duu, a ka kye to inggisɛ mkpa, kpaa ito ofya Onodzi yɔ, a ka yama kye to inggisɛ mkpa ba. <verse eid="MAT 12:31"/><verse number="32" style="v" sid="MAT 12:32"/>Ali inggisɛ ngbɔdzɛ mi ikpewo Ongwɛ Inggisɛ duu, a ka dzanta yi obube. Kpaa ongwu ngbɔdzɛ mi ikpewo Onodzi Osaan yɔ, a ka yama dzanta yi obube ba, mi onɔ ongwi onɛnɛ yi onɔ ongwi iyayi kpaa.<verse eid="MAT 12:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33"/>&lt;&lt;Ekwɔ osuse li wa owawa osuse, ekwɔ obube di li wa owawa obube. A li difwi ekwɔ mi owawa mgban. <verse eid="MAT 12:33"/><verse number="34" style="v" sid="MAT 12:34"/>Ema emi ongwɛ ogidzi ntonɛ, ka kyɔsinɛ ngwi ema nli ibwubwe nɛ ka gbɔdzɛ osuse? Bana ewodzɛ ongwi itukwu li fwi tɔ mi ondu. <verse eid="MAT 12:34"/><verse number="35" style="v" sid="MAT 12:35"/>Inggisɛ osuse li tɔ yi ewodzɛ osuse mi itukwu mgban, inggisɛ obube di li tɔ yi ewodzɛ obube mi itukwu mgban. <verse eid="MAT 12:35"/><verse number="36" style="v" sid="MAT 12:36"/>Nghaduu n le nya ema gbɛɛ ali inggisɛ duu ka nu uka mi ali elodzɛ onbwaa ngwi a gbɔ ma mi egbe ikwɔ. <verse eid="MAT 12:36"/><verse number="37" style="v" sid="MAT 12:37"/>Bana mi elodzɛ mgbi abu o ka gye emyɛmyɛ, mi elodzɛ mgbi abu, a dika ngwɔ abu ikwɔ.&gt;&gt;<verse eid="MAT 12:37"/></para>
  <para style="s1">Ambɛ mgbi iJona</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38"/>Nɛta emi iFarasi angbeka yi etsetse mgbi ola nyan gbɛɛ, &lt;&lt;Otsetse, eyi mina odi ambɛ okwulewo mbi abu.&gt;&gt;<verse eid="MAT 12:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39"/>O nu uka gbɛɛ, &lt;&lt;Etɔ imbali yi etɔ amah li byita ambɛ okwulewo! Kpaa a ka nun onyi ba sede li ambɛ mgbi oyegbɔ iJona ta. <verse eid="MAT 12:39"/><verse number="40" style="v" sid="MAT 12:40"/>Dafi iJona nose la ifu mmbweni okwukwo egbe eta na, li ngha ngwi Ongwɛ Inggisɛ ka la mi ikpɛsɛ egbe eta aali. <verse eid="MAT 12:40"/><verse number="41" style="v" sid="MAT 12:41"/>Emi iNinive ka kyato mi egbe ikwɔ yi etɔ nɛ di ngwɔ ma ikwɔ; ikyesinɛ a kyatitukwu mi esɔ ogbɔɔgbɔ mgbi iJona, ma onɛnɛ ongwu nshewo ngha iJona dzɛ mmɛnɛni. <verse eid="MAT 12:41"/><verse number="42" style="v" sid="MAT 12:42"/>Apodza ongwi agwudu ka kyato mi egbe ikwɔ yi etɔ nɛ di ngwɔ ma ikwɔ; ikyena o tɔkyɛ imbe ngwi ɛsɛ dondu owa fwo ozoyeye mgbi iSolomu, ma onɛnɛ ongwu nshewo ngha iSolomu dzɛ mmɛnɛni.<verse eid="MAT 12:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43"/>&lt;&lt;Onɔ ngwi onodzi obube tɔ mbi inggisɛ ma, o li le ga mi imbe ongwɔngwɔ le pita imbe ngwi o ka tonya, kpaa non ka tu bayɔ, <verse eid="MAT 12:43"/><verse number="44" style="v" sid="MAT 12:44"/>o si li gbɛɛ, &lt;N ka yidɔ lu imbe mgbɛn ogbugbe.&gt; Ni o yɛ wa to, di ozu na la ayayi, a fyan di kye mɛlu saan yɔ. <verse eid="MAT 12:44"/><verse number="45" style="v" sid="MAT 12:45"/>O ka yɛ lu ka gbe angbeka ntimbali ngha ongwu nghi egyafa, man a ka ba wa sɔkɛ ele. Nghanɛ odzɛɛdzɛ mgbi inggisɛ na li timbi nghaabɔ ogbugbe. Li ngha nka dzɛ yi etɔ imbali nɛ aali.&gt;&gt;<verse eid="MAT 12:45"/></para>
  <para style="s1">Onɔ iYesu yi engwunɔn</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46"/>Ngwi iYesu kale gbɔdzɛ yi ibyi inggisɛ nɛ, onɔn yi engwunɔn kwudzɛ to esɛ, le mina ogbɔdzɛ yan. [<verse eid="MAT 12:46"/><verse number="47" style="v" sid="MAT 12:47"/>Inggisɛ oka nyan gbɛɛ, &lt;&lt;Onabu yi engwunabu to esɛ, a mina ogbɔdzɛ yi abu.&gt;&gt;]<note caller="+" style="f"><char style="fr" closed="false">12:47 </char><char style="ft" closed="false">Ambulu nɛ dzɛ mi olɔɔlɔ angbeka ba.</char></note><verse eid="MAT 12:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48"/>IYesu byita gbɛɛ, &lt;&lt;Li emɛ li onani, di li ele li emi ongwunani?&gt;&gt; <verse eid="MAT 12:48"/><verse number="49" style="v" sid="MAT 12:49"/>O tso abɔ mbi engwafɔɔn si gbɛɛ, &lt;&lt;Li onani yi engwunani aani. <verse eid="MAT 12:49"/><verse number="50" style="v" sid="MAT 12:50"/>Bana ali inggisɛ nkyɔ mi oweka mgbi Otsani ongwi esho yɔ, o li ongwunani ongwu ongyulɔ yi ongyaa bɛyi onani.&gt;&gt;<verse eid="MAT 12:50"/></para>
  <chapter eid="MAT 12"/>
  <chapter number="13" style="c" sid="MAT 13"/>
  <para style="s1">Utsa mgbi inggisɛ ofwe etɔ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1"/>Mi egbe na kpɔɔ iYesu tasɛ mi ozu dika sɔkɛ onduutɔ. <verse eid="MAT 13:1"/><verse number="2" style="v" sid="MAT 13:2"/>Ibyi inggisɛ kwuba kwutokɛ yan nɛ o kaka ka sisɛ mi ifu uwaa, ta inggisɛ angbeka duu tokɛ agobo. <verse eid="MAT 13:2"/><verse number="3" style="v" sid="MAT 13:3"/>Nghanɛ o gbɔdzɛ kwuba yi ama mi itaodzɛ gbɛɛ: &lt;&lt;Inggisɛ okwɔ tasɛ oka fwe etɔ mgban. <verse eid="MAT 13:3"/><verse number="4" style="v" sid="MAT 13:4"/>Dafi o le fwe etɔ nɛ, angbeka yangwuta mi ofɛ, man ingwunɔ ba wa kyi salu gye. <verse eid="MAT 13:4"/><verse number="5" style="v" sid="MAT 13:5"/>Angbeka yangwuta mi imbe akwutsɛ, mi imbe ngwi ekyɛ le kwuba ba. I lumbye vla, ikyekyɛ ekyɛ she mi ele ba. <verse eid="MAT 13:5"/><verse number="6" style="v" sid="MAT 13:6"/>Kpaa ngwi onɔ wa tsɛ nɛ, ungwogye ntona ndzili, ikyekyɛ a taakpa ba. <verse eid="MAT 13:6"/><verse number="7" style="v" sid="MAT 13:7"/>Etɔ angbeka yangwuta mi ato, ato she yi ama nu ma gbufyo. <verse eid="MAT 13:7"/><verse number="8" style="v" sid="MAT 13:8"/>Etɔ angbeka kpɔɔ di yangwuta mi ekyɛ osuse wa owawa ngha ongwu a teyi kya ma akpe ideli, ngwuseta naadi osudiwyo. <verse eid="MAT 13:8"/><verse number="9" style="v" sid="MAT 13:9"/>Inggisɛ ndzɛ yi adɔ yɔ, no fwo.&gt;&gt;<verse eid="MAT 13:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10"/>Ta engwafɔ mgban ba mbon wa byita gbɛɛ, &lt;&lt;Kyɔnɛse ngwi abu le gbɔdzɛ yi inggisɛ mi itaodzɛ nghaa?&gt;&gt;<verse eid="MAT 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11"/>IYesu nu uka gbɛɛ, &lt;&lt;Ozoyeye mgbi ungwɔ ama odaada mgbi esutɔ ongwi esho ma, a kye nu ema, kpaa ama yɔ, a kye nu ma ba. <verse eid="MAT 13:11"/><verse number="12" style="v" sid="MAT 13:12"/>Ali inggisɛ ndzɛyan yɔ, a ka mbwon mmbwo o dika dzɛyan kpakpa. Kpaa ali inggisɛ ndzɛ yi ungwɔ bayɔ, ogyɛngyɛ ngwi o dzɛyan ma kpaa a ka kye gbɛlu mbon. <verse eid="MAT 13:12"/><verse number="13" style="v" sid="MAT 13:13"/>Li ikyengha ngwi ani le gbɔdzɛ yi ama mi itaodzɛ aali,</para>
  <para style="pi" vid="MAT 13:13">&lt;&lt;Bana a le di, kpaa a le difwi ba;</para>
  <para style="pi" vid="MAT 13:13">a dile fwo kpaa, le gbosa loma ba.<verse eid="MAT 13:13"/></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 13:14"/>Ungwɔ ntonɛ mbwumbwo odzɛ ngwi oyegbɔ Adzaya gbɔ ma yɛyɛ gbɛɛ,</para>
  <para style="q1" vid="MAT 13:14">&lt;&lt; &lt;Ema kale fwo kpaa ka yama gbosa lo ema ba;</para>
  <para style="q2" vid="MAT 13:14">Ema kale di kpaa ema ka yama difwi ba.<verse eid="MAT 13:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15"/>Bana itukwu mgbi inggisɛ ntonɛ tiishu,</para>
  <para style="q2" vid="MAT 13:15">li fyima mfye ofwo mi adɔ mgbi ama kpaa,</para>
  <para style="q1" vid="MAT 13:15">a di kye inɛ mgbi ama kpaa tukwu.</para>
  <para style="q2" vid="MAT 13:15">Bana a ki di mi inɛ,</para>
  <para style="q1" vid="MAT 13:15">di fwo mi adɔ,</para>
  <para style="q2" vid="MAT 13:15">di difwi mi itukwu mgbi ama,</para>
  <para style="q1" vid="MAT 13:15">di kyata yɔ,</para>
  <para style="q2" vid="MAT 13:15">ani kika ngyɛlu ma ootse.&gt;<verse eid="MAT 13:15"/></para>
  <para style="m">
    <verse number="16" style="v" sid="MAT 13:16"/>Nghaduu mse dzɛ yi ema ikyekyɛ inɛ mgbi ema di, adɔ mgbi ema di fwo. <verse eid="MAT 13:16"/><verse number="17" style="v" sid="MAT 13:17"/>Bana n nya ema otsitsi, i mina oyegbɔ kwuba bɛyi inggisɛ ama osaan odi ungwɔ ama ema di nɛ, kpaa a di ba, odi nu ma fwo ungwɔ ngwi ema fwo ntonɛ kpaa, a fwo ba.<verse eid="MAT 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18"/>&lt;&lt;Nghanɛ gadɔ mi ungwɔ ngwi itaodzɛ mgbi inggisɛ ofwe etɔ nɛ tso mani: <verse eid="MAT 13:18"/><verse number="19" style="v" sid="MAT 13:19"/>Mi onɔ ngwi inggisɛ fwo esɔ mgbi esutɔ ma di difwi bayɔ, olodu li ba wa lafwa ungwɔ ngwi a kye kya mbon mani. Nɛnɛ li etɔ ngwi a fwe mi ondoofɛ ma aani. <verse eid="MAT 13:19"/><verse number="20" style="v" sid="MAT 13:20"/>Ongwu ngbɛ etɔ n yangwuta mi imbe akwutsɛ ma li inggisɛ nfwo elodzɛ na di gban vla yi atsa. <verse eid="MAT 13:20"/><verse number="21" style="v" sid="MAT 13:21"/>Kpaa ngwi o dzɛ yi akpa bayɔ, o la mi ongwonɔ gwee ta. Ngwi okakewo hona adzɛ ba mi ikye elodzɛ na man, o gbɛsɛ vla. <verse eid="MAT 13:21"/><verse number="22" style="v" sid="MAT 13:22"/>Ongwu ngbɛ etɔ ama n yangwuta mi ifu ato ma li inggisɛ nfwo elodzɛ na kpaa okakewo ongwi ɛsɛ nɛ bɛyi okpagyewo mgbi awuya loka wo elodzɛ na, non wa owawa wuba. <verse eid="MAT 13:22"/><verse number="23" style="v" sid="MAT 13:23"/>Nghaduu ongwu ngbɛ etɔ ama n yangwuta mi ekyɛ osuse ma li ongwu nfwo elodzɛ na di difwin. O wa owawa mɛ dafi ideli, ngwuseta naadi akpe osudiwyo mgbi ungwɔ ngwi a kye kya mani.&gt;&gt;<verse eid="MAT 13:23"/></para>
  <para style="s1">Utsa mgbi etɔ obube</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24"/>IYesu nya ma utsa oka gbɛɛ, &lt;&lt;Esutɔ ongwi esho dzɛ dafi inggisɛ nkye etɔ osuse ka kya mi okwɔ mgban. <verse eid="MAT 13:24"/><verse number="25" style="v" sid="MAT 13:25"/>Kpaa mi onɔ ngwi ali inggisɛ duu nuna mata, ongyikyili mgban ba wa kya etɔ obube mi ifu ekwu, si yɛ lu. <verse eid="MAT 13:25"/><verse number="26" style="v" sid="MAT 13:26"/>Mi onɔ ngwi ekwu na she dile fwɛ nɛta, etɔ obube ntona kpaa fwɛ.<verse eid="MAT 13:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 13:27"/>&lt;&lt;Engbidɔ mgbi otsungwɔ okwɔ na ba mbon wa gbɛɛ, &lt;Ongyukwo, li etɔ osuse ngwi abu kya mi okwɔ mgbi abu baa? Li mi ole ngwi etɔ obube ntona kyɛ se ba?&gt;<verse eid="MAT 13:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 13:28"/>&lt;&lt;O nu uka gbɛɛ, &lt;Li ongyikyili kyungwɔnɛni.&gt;</para>
  <para style="pi" vid="MAT 13:28">&lt;&lt;Engbidɔ ntona si byun gbɛɛ, &lt;I mina abu ni eyi ka kyi kwɔlu maa?&gt;<verse eid="MAT 13:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 13:29"/>&lt;&lt;O gbɛɛ, &lt;Ei, ikyekyɛ ni ema le kwɔ etɔ obube ntona, ema ka kwɔlu ekwu tablikyi yi ama. <verse eid="MAT 13:29"/><verse number="30" style="v" sid="MAT 13:30"/>Dzata ma duu nu ma she yi ewoma nghataa ba mi onɔ oshɛ-shɛ. Mi onɔ na se ani ka nya ama oshɛ etɔ gbɛɛ, &lt;Teyi kyi gbelu etɔ obube ntona kyi bwalu mi indinde gbe toola; di kyi gbelu ekwu ntona kwakye gbe wa wo ani kɛ oba.&gt; &gt;&gt;<verse eid="MAT 13:30"/></para>
  <para style="s1">Utsa inɛnɛ unkwodzi bɛyi okwuna</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31"/>IYesu di nya ama utsa oka gbɛɛ: &lt;&lt;Esutɔ ongwi esho dzɛ dafi inɛnɛ unkwodzi ngwi inggisɛ kye kya mi okwɔ mgban. <verse eid="MAT 13:31"/><verse number="32" style="v" sid="MAT 13:32"/>Ngwi le gyɛngyɛ ngha ali etɔ ungwɔ duu nɛ kpaa, no lumbye yɔ, li she ngha ali ekwɔ duu man li yɛɛ ekwɔ okwukwo, nghanɛ ingwunɔ emi esho li ba wa ludɛ mi abɔn.&gt;&gt;<verse eid="MAT 13:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33"/>O di nya ma utsa oka kpɔɔ gbɛɛ: &lt;&lt;Esutɔ ongwi esho dzɛ dafi okwuna ngwi ongyaa kye takye yi ofumbu ngwi ganyan kpatsɛ ele mani.&gt;&gt;<verse eid="MAT 13:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34"/>IYesu gbɔ ungwɔ ntonɛ duu nya ibyi inggisɛ mi utsa; ungwɔ onyi ngwi o nya ma mi utsa ba dzɛma ba. <verse eid="MAT 13:34"/><verse number="35" style="v" sid="MAT 13:35"/>Nghanɛ i mbwumbwo yɛyɛ mi ungwɔ ngwi a gbɔ nyɛ mbi oyegbɔ gbɛɛ:</para>
  <para style="q1" vid="MAT 13:35">&lt;&lt;N ka kwulu ondu mgbi ani gbɔdzɛ mi utsa,</para>
  <para style="q2" vid="MAT 13:35">n ka gbɔ ungwɔ ama nto daada wita kyɛ onɔ ngwi a ta ɛsɛ majo.&gt;&gt;<verse eid="MAT 13:35"/></para>
  <para style="s1">Osa mi utsa mgbi etɔ obube</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36"/>Ta o dzata ibyi inggisɛ di lu ifoozu. Engwafɔɔn ba mbon wa gbɛɛ, &lt;&lt;Nu eyi osa mi utsa mgbi etɔ obube mi okwɔ nɛni.&gt;&gt;<verse eid="MAT 13:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37"/>O gbɛɛ, &lt;&lt;Ongwu nkya etɔ osuse ma li Ongwɛ Inggisɛ. <verse eid="MAT 13:37"/><verse number="38" style="v" sid="MAT 13:38"/>Okwɔ na li ɛsɛ duu, etɔ osuse na kwudzɛ mi ikye mgbi emi ongwɛ esutɔ. Etɔ obube ntona li engwɛ mgbi onodzi ibwubwe, <verse eid="MAT 13:38"/><verse number="39" style="v" sid="MAT 13:39"/>ongyikyili ongwu nkya etɔ ntona ma li olodu. Onɔ oshɛ-shɛ na li egbe ngwi ɛsɛ ka ngyɛ, ama oshɛ etɔ ntona li engyesɔ.<verse eid="MAT 13:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 13:40"/>&lt;&lt;Dafi a kwɔlu etɔ obube ntona gbe toola na, li ngha nka dzɛ mi egbe ongwi olɛlɛ aali. <verse eid="MAT 13:40"/><verse number="41" style="v" sid="MAT 13:41"/>Ongwɛ Inggisɛ ka dɔ engyesɔ mgban esɔ tasɛ, man a ka wa kyi kwɔlu alungwɔ ama nle nu ungwɔ obube kyɔ bɛyi ama nle kyungwɔ ibwubwe duu tasɛ mi esutɔ mgban. <verse eid="MAT 13:41"/><verse number="42" style="v" sid="MAT 13:42"/>A ka ngwi ma wokɛ amoola, li imbe na ngwi a kale tsukwu diyɛ gyaaba aali. <verse eid="MAT 13:42"/><verse number="43" style="v" sid="MAT 13:43"/>Nɛta ama osaan ntona ka kwɔ dafi onɔ mi esutɔ mgbi Otsɔma. Inggisɛ ndzɛ yi adɔ yɔ, no fwo.<verse eid="MAT 13:43"/></para>
  <para style="s1">Utsa mgbi aludu odaada</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44"/>&lt;&lt;Esutɔ ongwi esho dzɛ dafi aludu da dzɛ okwɔ. Onɔ ngwi inggisɛ oka wa tu nɛta, o yilen kye da si yidɔ lu yi atsa ka gbelu ungwɔ mgban duu gbe gya, kye udza ma ka gyalu okwɔ nani.<verse eid="MAT 13:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45"/>&lt;&lt;Esutɔ ongwi esho di dzɛ dafi inggisɛ okyummya le pita itagwude ama osuse mani. <verse eid="MAT 13:45"/><verse number="46" style="v" sid="MAT 13:46"/>Ngwi o ka di ongwi ndzɛ yi oyabɔ kpakpa nɛta, o lu ka salu ungwɔ mgban duu gbe gya yile udza ma ka gyalu itagwude nani.<verse eid="MAT 13:46"/></para>
  <para style="s1">Utsa mgbi ukɛ</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47"/>&lt;&lt;Esutɔ ongwi esho di dzɛ dafi ukɛ ngwi a kye wo mi utɔ di kwu ali itɔ mmbweni duu mani. <verse eid="MAT 13:47"/><verse number="48" style="v" sid="MAT 13:48"/>Onɔ ngwi mmbwɛ mbwo ukɛ ma, ama otuntsɛ li kwon luba esɛ. Ta a li sisɛ salu mmbwɛ ama osuse gbe yaokɛ uya, kpaa ama obube ntona yɔ, a li gbe ma yangwuta. <verse eid="MAT 13:48"/><verse number="49" style="v" sid="MAT 13:49"/>Li ngha nka dzɛ mi onɔ ngwi ɛsɛ ka dondu aali. Engyesɔ ka ba wa ghalu emi imbali mbi emi osaan <verse eid="MAT 13:49"/><verse number="50" style="v" sid="MAT 13:50"/>di ngwi ma wokɛ amoola, imbe ngwi ikwu otseetse yi aba ogyeegye ka dzɛ mani.<verse eid="MAT 13:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51"/>IYesu byi engwafɔɔn gbɛɛ, &lt;&lt;Ema difwi ungwɔ ntonɛ duu wɛ?</para>
  <para style="pi" vid="MAT 13:51">A nu uka gbɛɛ, &lt;&lt;Ɛɛn.&gt;&gt;<verse eid="MAT 13:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52"/>O nya ma gbɛɛ, &lt;&lt;Nghanɛ ali otsetse mgbi ola ngwu a tson ungwɔ mgbi esutɔ ongwi esho dzɛ dafi otsungwudɛ ngbe ungwɔ ama ofufɛ yi ogbugbe mi oba mgban ba esɛ mani.&gt;&gt;<verse eid="MAT 13:52"/></para>
  <para style="s1">A kwu iYesu shanyɛ mi ogalu mgban</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53"/>Ngwi iYesu tsuutsa ntonɛ ngyɛ nɛ, o dzata imbe nani. <verse eid="MAT 13:53"/><verse number="54" style="v" sid="MAT 13:54"/>Ngwi o luba ogalu mgban nɛ, o wita otso inggisɛ ungwɔ mi ozu okwakye mgbi ama, i di kwulu ma ewo. Ta a gbɛɛ, &lt;&lt;Li mi ole ngwi inggisɛ nɛ tu ozoyeye yi mfye ama okwulewo ntonɛ ngha?&gt;&gt; <verse eid="MAT 13:54"/><verse number="55" style="v" sid="MAT 13:55"/>&lt;&lt;Nɛnɛ li ongwɛ inggisɛ ogbokwo ungwɔ nɛ lo? Li ongwu onɔn li iMeri, ngwu emi ongwunɔn li iJɛnsi yi iJose yi iSaimɔn bɛyi iJuda nɛ baa? <verse eid="MAT 13:55"/><verse number="56" style="v" sid="MAT 13:56"/>Emi ongwunɔn emi engyaa duu to yi eyi mmɛnɛ dɛn baa? Nghanɛ li mi ole ngwi inggisɛ nɛ tu ungwɔ ntonɛ duu nghaa?&gt;&gt; <verse eid="MAT 13:56"/><verse number="57" style="v" sid="MAT 13:57"/>Man i kpa ma yan wuba.</para>
  <para style="pi" vid="MAT 13:57">Nghaduu iYesu nya ma gbɛɛ, &lt;&lt;Oyegbɔ dzɛ yi mmwɛ mi igeli mgban bɛyi udɛ mgban ba.&gt;&gt;<verse eid="MAT 13:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="MAT 13:58"/>Ta o kyungwɔ ama okwulewo kwuba mi imbe na wuba ikyekyɛ a noyɛyɛ ba nghao.<verse eid="MAT 13:58"/></para>
  <chapter eid="MAT 13"/>
  <chapter number="14" style="c" sid="MAT 14"/>
  <para style="s1">A dzɛ iJɔn okyɔ iBatisima ikye</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1"/>Mi onɔ na iHerude utɔ mgbi emi iGalalia fwo odzɛ mgbi iYesu, <verse eid="MAT 14:1"/><verse number="2" style="v" sid="MAT 14:2"/>ta o nya emi idɔ mgban gbɛɛ, &lt;&lt;Nɛnɛ li iJɔn okyɔ iBatisima mani, o kyato mi ikwu! Li ngha ngwi mfye okyungwɔ okwulewo le tɔ mbon aani.&gt;&gt;<verse eid="MAT 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3"/>Lubana iHerude nu ma bwa iJɔn di bwan adi kyon wokɛ obawi<figure style="fig" alt="IJohn okyɔ iBatisima wodzɛ obawi" file="DN00420b.tif" size="col" loc="14;3" copy="DN00420b" ref="14:3">John the baptist in prison</figure> mi ikye mgbi iHerodia, owa ongwunɔn iFyilipi, <verse eid="MAT 14:3"/><verse number="4" style="v" sid="MAT 14:4"/>ikyena iJɔn teyi nyan gbɛɛ, &lt;&lt;Li ola ba onu abu kyon.&gt;&gt; <verse eid="MAT 14:4"/><verse number="5" style="v" sid="MAT 14:5"/>IHerude mina ongwɔ iJɔn, kpaa o mio ibyi inggisɛ, ikyekyɛ a kyon wuuta dafi oyegbɔ mani.<verse eid="MAT 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6"/>Ngwi egbe oga owɛ egbe ngwi a mba iHerude kwokyi nɛ, ongwɛ iHerodia ongwu ongyaa ba wa shufwe nu ma di man i kpa iHerude kpakpa <verse eid="MAT 14:6"/><verse number="7" style="v" sid="MAT 14:7"/>ta o zondu yɛ fa gbɛɛ alungwɔ ngwi ongwongyaa na mina duu ongwu ka kye nun. <verse eid="MAT 14:7"/><verse number="8" style="v" sid="MAT 14:8"/>Nghaduu onɔn tunwo, man o gbɛɛ, &lt;&lt;Kye ikye mgbi iJɔn okyɔ iBatisima mi akpɛtɛ wa nu ani mmɛnɛni.&gt;&gt; <verse eid="MAT 14:8"/><verse number="9" style="v" sid="MAT 14:9"/>I kaka utɔ iHerude ewo, kpaa ikyegbɛɛ o teyi zondu mi inɛ ingyoga mgban nɛ, o woola gbɛɛ nu ma kyɔ ngha <verse eid="MAT 14:9"/><verse number="10" style="v" sid="MAT 14:10"/>si nu ma ka dzɛlu iJɔn ikye mi obawi. <verse eid="MAT 14:10"/><verse number="11" style="v" sid="MAT 14:11"/>A kye ikye ma mi akpɛtɛ kaka wa nu ongwongyaa nani, o kyi kye ka nu onɔn. <verse eid="MAT 14:11"/><verse number="12" style="v" sid="MAT 14:12"/>Engwafɔ iJɔn ba wa kye ikwɔ mgban ka ndzi. Ta a lu ka nya iYesu.<verse eid="MAT 14:12"/></para>
  <para style="s1">IYesu nu inggisɛ idubu eda ungwogye</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13"/>Ngwi iYesu fwo ungwɔ nkyɔ nɛta, o dzata imbe na kaka uwaa lu imbe ndede ka dzɛ yuon. Ngwi ibyi inggisɛ fwo ungwɔnɛ nɛ, a tɔ mi ifu igeli mi afɛɛsɛ kyɛdɔn. <verse eid="MAT 14:13"/><verse number="14" style="v" sid="MAT 14:14"/>Ngwi iYesu ka kaka dili ibyi inggisɛ nɛ, elela kyɔn wo ma, o di ngyɛlu ma ootse.<verse eid="MAT 14:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15"/>Dafi onɔ dzɛ kwɛkwɛ ogbɛsɛ nɛ, engwafɔɔn ba mbon wa gbɛɛ, &lt;&lt;Imbe nɛ li ifoshɛ, onɔ di gbɛsɛ wa, nu ibyi inggisɛ ntonɛ ofɛ nu ma lu, zukwu nu ma lu emi agwudɛ ka gya ewoma ungwogye.&gt;&gt;<verse eid="MAT 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16"/>IYesu gbɛɛ, &lt;&lt;Dzɛ mbisɔ a ka lu ba. Nu ma ungwogye nu ma gye na.&gt;&gt;<verse eid="MAT 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17"/>A gbɛɛ, &lt;&lt;Eyi dzɛ yi ibredi nghi eda ta yi abatsa efa.&gt;&gt;<verse eid="MAT 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18"/>O gbɛɛ, &lt;&lt;Kye wa nin na.&gt;&gt; <verse eid="MAT 14:18"/><verse number="19" style="v" sid="MAT 14:19"/>Ta o woola ni ibyi ntona sisɛ mi oshɛ. O kyelu ibredi eda bɛyi abatsa efa ntona si kyile inɛ esho, ta Imgbasho angba man kye mwalu ibredi ntona kye nu engwafɔ mgban, engwafɔɔn si kye gha ibyi inggisɛ ntonani. <verse eid="MAT 14:19"/><verse number="20" style="v" sid="MAT 14:20"/>Ama duu gye tolo, engwafɔ iYesu di sa ambulu ama nsisi ma mi uya nghi iwyodefa. <verse eid="MAT 14:20"/><verse number="21" style="v" sid="MAT 14:21"/>Mmbwo inggisɛ ama ngye ungwogye ma mɛ dafi engyulɔ idubu eda hini, a kye engyaa yi ɛngbɛ wele ba.<verse eid="MAT 14:21"/></para>
  <para style="s1">IYesu kyikyɛ mi ikye eni</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22"/>Mina nɛta iYesu nu emi ongwafɔɔn kaka uwaa teyi ongwu fooye, ikye ni ongwu nu ibyi inggisɛ ntona ofɛ lu se. <verse eid="MAT 14:22"/><verse number="23" style="v" sid="MAT 14:23"/>Ngwi o wa nu ibyi inggisɛ ofɛ nyɛ nɛta, o tɔkɛ unggwɔ ongwu yuon oka bibɔ, ngwi onɔ wa gbɛsɛ nɛ, o dzɛ imbe na yuon, <verse eid="MAT 14:23"/><verse number="24" style="v" sid="MAT 14:24"/>Nghaduu uwaa teyi fyata yi agobo wa, akpeni le ngwin ikyekyɛ awo le fa shayɛ.<verse eid="MAT 14:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25"/>Mi ikyegbe nɛ, iYesu lu le ka tu ma, le kyikyɛ mi ikye eni. <verse eid="MAT 14:25"/><verse number="26" style="v" sid="MAT 14:26"/>Ngwi engwafɔɔn din le kyikyɛ mi ikye eni nɛ, i kwulu ma ewo. A gbɛɛ, &lt;&lt;Li onodzi ikwukwɔ,&gt;&gt; a si makwɔ tɔ yi imio.<verse eid="MAT 14:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27"/>Kpaa iYesu nya ma vla gbɛɛ: &lt;&lt;Fyumfye itukwu na! Li ani. Ka mio ba na.&gt;&gt;<verse eid="MAT 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28"/>Ta iPyita si kwun ela gbɛɛ, &lt;&lt;Otsɛ, ni li abu yɔ, nya ani nin kyikyɛ mi ikye eni ka tu abu.&gt;&gt;<verse eid="MAT 14:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29"/>O si gbɛɛ, &lt;&lt;Ba.&gt;&gt;</para>
  <para style="p" vid="MAT 14:29">Ta iPyita tasɛ mi uwaa, kyikyɛ mi ikye eni le ka tu iYesu. <verse eid="MAT 14:29"/><verse number="30" style="v" sid="MAT 14:30"/>Kpaa ngwi iPyita di awo nɛ, imio won man o wita osu lu iteeni, o makwɔ tɔ gbɛɛ, &lt;&lt;Otsɛ, dulin tɔ!&gt;&gt;<verse eid="MAT 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31"/>Mina ta iYesu na abɔ byun. O gbɛɛ, &lt;&lt;Abu ndzɛ yi oyɛyɛ onuunu gyɛngyɛ nɛ, kyɔnɛ ngwi itukwu dzɛ abu efefa ngha?&gt;&gt;<verse eid="MAT 14:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32"/>Ngwi a kaka uwaa mata, awo si kwulu. <verse eid="MAT 14:32"/><verse number="33" style="v" sid="MAT 14:33"/>Ta ama nwoto uwaa na sunun, le gbɛɛ, &lt;&lt;Otsitsi otsitsi abu li Ongwɛ Imgbasho.&gt;&gt;<verse eid="MAT 14:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34"/>Dafi a fooye nɛ, a kye afɔ dɔkɛ ikpɛsɛ iGenesareti. <verse eid="MAT 14:34"/><verse number="35" style="v" sid="MAT 14:35"/>Ngwi emi imbe na difwi iYesu nɛ, a dɛsɔ kpatsɛ imbe na duu. Ta inggisɛ gbe emidama ama ndotse duu ba mbon <verse eid="MAT 14:35"/><verse number="36" style="v" sid="MAT 14:36"/>di tɛkyɛ nun gbɛɛ no nu emi ootse ntona kye abɔ gbon ondu angwuto ta, nghanɛ ama nkye abɔ gbon duu, ootse gbosa loma.<verse eid="MAT 14:36"/></para>
  <chapter eid="MAT 14"/>
  <chapter number="15" style="c" sid="MAT 15"/>
  <para style="s1">Osaan bɛyi okpɛkpɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1"/>Ta emi iFarasi angbeka yi etsetse mgbi ola kyɛ mi iJerosalin ba mbi iYesu wa byin gbɛɛ, <verse eid="MAT 15:1"/><verse number="2" style="v" sid="MAT 15:2"/>&lt;&lt;Kyɔnɛ ngwi engwafɔ mgbi abu le mbelu aletɔ ngwi engyukwo tso eyi nghaa? A li sabɔ duuse gye ungwogye ba!&gt;&gt;<verse eid="MAT 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3"/>IYesu nu uka gbɛɛ, &lt;&lt;Kyɔnɛ ngwi ema li mbe ola mgbi Imgbasho mi ikye ungwɔ etɔ mgbi ema? <verse eid="MAT 15:3"/><verse number="4" style="v" sid="MAT 15:4"/>Bana Imgbasho gbɛɛ, &lt;Sunu otsabu yi onabu&gt; ma &lt;Ali inggisɛ nfya otsɔn yi onɔn ito yɔ, o ka kwulu kyɛmɛ.&gt; <verse eid="MAT 15:4"/><verse number="5" style="v" sid="MAT 15:5"/>Nghaduu ema li gbɛɛ li ayin ni inggisɛ nya ama omba ma gbɛɛ, &lt;Gyen aba, n ka yagba tobyi ema ba. Ikyesinɛ n tsekise zondu okye ungwɔ ngwi ani kika kye nu ema ma, nu Imgbasho.&gt; <verse eid="MAT 15:5"/><verse number="6" style="v" sid="MAT 15:6"/>Mi itɔ ofɛ nɛ ema li gbɛɛ, dzɛ mbisɔ ngwi a ka sunu ama omba ma ba. Nghanɛ ema kyi ndɛlu elodzɛ Imgbasho ikye aletɔ mgbi ema. <verse eid="MAT 15:6"/><verse number="7" style="v" sid="MAT 15:7"/>Ema emi ikpala ntonɛ! Oyegbɔ Adzaya teyi gbɔ ayin mi ikpewo ema gbɛɛ,<verse eid="MAT 15:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8"/>&lt;&lt; &lt;Inggisɛ ntonɛ li sunu ani</para>
  <para style="q2" vid="MAT 15:8">mi ikpondu mgbi ama ta,</para>
  <para style="q1" vid="MAT 15:8">kpaa itukwu mgbi ama yɔ,</para>
  <para style="q2" vid="MAT 15:8">dzɛ mbombo yi ani.<verse eid="MAT 15:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9"/>A le sunu ani ayayi;</para>
  <para style="q2" vid="MAT 15:9">bana otsootso mgbi ama duu kpaa li</para>
  <para style="q2" vid="MAT 15:9">ola mgbi inggisɛ ta.&gt; &gt;&gt;<verse eid="MAT 15:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10"/>IYesu kwu ibyi inggisɛ ela ba mbon wa nya ma gbɛɛ, &lt;&lt;Gadɔ no di gbosa lo ema na. <verse eid="MAT 15:10"/><verse number="11" style="v" sid="MAT 15:11"/>Li ungwɔ nkaka ondu mbi inggisɛ ma li nu otsungwɔn &lt;tsiidza&gt; ba, kpaa li ungwɔ ntasɛ mi ondu mbon ma, li non &lt;tsiidza&gt; aali.&gt;&gt;<verse eid="MAT 15:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12"/>Ta engwafɔɔn wa byun gbɛɛ, &lt;&lt;Abu ye dafi itukwu wulu emi iFarasi ntona ngwi a fwo odzɛ nɛ ma wɛ?&gt;&gt;<verse eid="MAT 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13"/>O nu uka gbɛɛ, &lt;&lt;Ali ekwɔ ngwi li Otsani ongwi esho kye ye ba duu, a ka kye todulu yi akpa. <verse eid="MAT 15:13"/><verse number="14" style="v" sid="MAT 15:14"/>Dzata ma; a li ama ogbe obinɛ teyi. Kini obinɛ kye obinɛ oka teyi yɔ, ama duu ka gbɛsɛ wokɛ ishɛ.&gt;&gt;<verse eid="MAT 15:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15"/>IPyita gbɛɛ, &lt;&lt;Nu eyi osa mi utsa nɛni.&gt;&gt;<verse eid="MAT 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16"/>IYesu byi ma gbɛɛ, &lt;&lt;Nghataa ba onɛnɛ kpaa ema difwi odzɛ nɛ wa lo? <verse eid="MAT 15:16"/><verse number="17" style="v" sid="MAT 15:17"/>Ema di dafi alungwɔ nkaka ondu li nyɛ lu ifu a di li kye nyalu ngwuta mi inɛnɛ ma baa? <verse eid="MAT 15:17"/><verse number="18" style="v" sid="MAT 15:18"/>Kpaa ungwɔ ama nli tɔ mi ondu ma li kyɛ mi itukwu, di li ungwɔ ntona li nu inggisɛ &lt;tsiidza&gt; aali. <verse eid="MAT 15:18"/><verse number="19" style="v" sid="MAT 15:19"/>Bana li mi itukwu ngwi ewodzɛ ibwubwe, ongwɔ inggisɛ yi amah okyɔɔkyɔ yi inɛ okyeekye yi mmyi yi obwɛndɛ atsika bɛyi ito li tɔ aali. <verse eid="MAT 15:19"/><verse number="20" style="v" sid="MAT 15:20"/>Li ungwɔ ntonɛ li nu inggisɛ &lt;tsiidza&gt; aali, kpaa osabɔ bata gye ungwogye, ka nu inggisɛ &lt;tsiidza&gt; ba dududu.&gt;&gt;<verse eid="MAT 15:20"/></para>
  <para style="s1">Oyɛyɛ onuunu mgbi ongyaa iKana</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21"/>Ngwi iYesu dzata imbe na nɛ, o lu ayɛsɛ mgbi iTiru yi iSidon. <verse eid="MAT 15:21"/><verse number="22" style="v" sid="MAT 15:22"/>Ta ongyaa iKana ndzɛ ayɛsɛ na ba mbon wa makwɔ gbɛɛ, &lt;&lt;Otsɛ, Ongwɛ iDevedi, di ani elela! Esɛ dɔ ongwani ongwu ongyaa ikye she.&gt;&gt;<verse eid="MAT 15:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23"/>IYesu gbɔ elodzɛ onyi ba. Nɛ engwafɔɔn ba mbon wa tɛkyɛ yan gbɛɛ, &lt;&lt;Nu ongyaa nɛ ofɛ no lu, bana o le makwɔ kyɛ eyi iyikpa.&gt;&gt;<verse eid="MAT 15:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24"/>O gbɛɛ, &lt;&lt;A dɔ ani esɔ mbi mmala mgbi Israi nbyulu ma kyoon.&gt;&gt;<verse eid="MAT 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25"/>Ongyaa ma ba wa kwɛsɛ mi iyayi mbon, o gbɛɛ, &lt;&lt;Otsɛ, ya ani abɔ!&gt;&gt;<verse eid="MAT 15:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26"/>IYesu nu uka gbɛɛ, &lt;&lt;Li ayin okye ungwogye mgbi engwɛ ngwuta to obwe ba.&gt;&gt;<verse eid="MAT 15:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27"/>Ongyaa na gbɛɛ, &lt;&lt;Ɛɛn, Otsɛ, obwe kpaa li gye ambulu ungwogye ama n yangwuta mi adinyatsɛ mgbi otsungwudɛ mani.&gt;&gt;<verse eid="MAT 15:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28"/>Man iYesu nu uka gbɛɛ, &lt;&lt;Ongyaa, oyɛyɛ onuunu mgbi abu shewo! Ungwɔ ngwi abu mina ma a kyɔ abu ele wa.&gt;&gt; Ta ewo gbosa lo ongwan ongwu ongyaa na mi obyi na yɛyɛ.<verse eid="MAT 15:28"/></para>
  <para style="s1">IYesu byi inggisɛ idubu enɛ enbwa</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29"/>Nɛ iYesu dzata imbe na yɛ lu ekyoo mgbi iGalalia. Ta o tɔkɛ unggwɔ ka sisɛ mi ele. <verse eid="MAT 15:29"/><verse number="30" style="v" sid="MAT 15:30"/>Man ibyi inggisɛ kpakpa ba mbon, yi inggisɛ ogbyikye tukwu esɛ yi obinɛ yi inggisɛ okwukwu yi ikplima bɛyi angbeka kwuba, gbe ma wa lakiyayi iYesu; man o ngyɛlu ma duu ootse. <verse eid="MAT 15:30"/><verse number="31" style="v" sid="MAT 15:31"/>I kwulu inggisɛ ntona ewo mi onɔ ngwi a di ikplima le gbɔdzɛ, inggisɛ okwukwu yɛɛ saan yi inggisɛ ogbyikye tukwu esɛ le kyikyɛ bɛyi obinɛ le dinɛ mani. A si tsɛ Imgbasho mgbi Israi.<verse eid="MAT 15:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32"/>Nghanɛ iYesu kwu engwafɔɔn ela ba mbon di gbɛɛ, &lt;&lt;Elela kyɔ ani wo inggisɛ ntonɛni; bana a to yi ani mɛ egbe eta waani yi unkonyi ogyeegye ba. N mina owo ma ofɛ lu yi enbwa ifu ba, adzi nu ma ka kwu anadza mi ofɛ ba mani.&gt;&gt;<verse eid="MAT 15:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33"/>Engwafɔ mgban nu uka gbɛɛ, &lt;&lt;Li mi ole eyi ka tu ibredi mi ifoshɛ nɛ mɛ obyi ibyi inggisɛ ntonɛ enbwa?&gt;&gt;<verse eid="MAT 15:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34"/>IYesu si byita gbɛɛ, &lt;&lt;Ema dzɛ yi ibredi eminɛ?&gt;&gt;</para>
  <para style="p" vid="MAT 15:34">A gbɛɛ, &lt;&lt;Li nghi egyafa bɛyi engwɛ abatsa bwee.&gt;&gt;<verse eid="MAT 15:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35"/>O nya ibyi inggisɛ nu ma sisɛ mi ombulu. <verse eid="MAT 15:35"/><verse number="36" style="v" sid="MAT 15:36"/>Ta o kyi kyelu ibredi egyafa yi engwɛ abatsa ntona, ngwi o ta Imgbasho angba nɛ, o kye mwalu di kye nu engwafɔ mgban, man a yilen kye gha ibyi inggisɛ ntonani. <verse eid="MAT 15:36"/><verse number="37" style="v" sid="MAT 15:37"/>Ama duu gye di tolo. Ngwi nyɛ nɛta, engwafɔɔn kyi gbelu ambulu ama nsisi ma mbwo uya egyafa. <verse eid="MAT 15:37"/><verse number="38" style="v" sid="MAT 15:38"/>Mmbwo inggisɛ ama ngye ungwogye ma li idubu enɛ, engyaa yi ɛngbɛ wele ba. <verse eid="MAT 15:38"/><verse number="39" style="v" sid="MAT 15:39"/>Ngwi iYesu wa nu ibyi inggisɛ ofɛ lu nɛta, o kaka uwaa lu ayɛsɛ iMagadan.<verse eid="MAT 15:39"/></para>
  <chapter eid="MAT 15"/>
  <chapter number="16" style="c" sid="MAT 16"/>
  <para style="s1">A mina ambɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1"/>Emi iFarasi yi emi iSadusi ba mbi iYesu wa mbadin, a byun gbɛɛ non tso ama ambɛ ongwi esho.<verse eid="MAT 16:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 16:2"/>Nghanɛ iYesu nu uka gbɛɛ, <note caller="+" style="f"><char style="fr" closed="false">16:2 </char><char style="ft" closed="false">Olɔɔlɔ angbeka emi ababɔ dzɛ yi ambulu efa yi eta nɛ ba.</char></note>&lt;&lt;Ni onɔ le gbɛsɛ ta, ema li gbɛɛ, &lt;Imbe ka kwulu, ikyekyɛ akpesho ma,&gt; <verse eid="MAT 16:2"/><verse number="3" style="v" sid="MAT 16:3"/>mi egbegbe ema li gbɛɛ, &lt;Inɛ mmbwo ka kya, ikyekyɛ akpesho ma i di yifu.&gt; Ema li yagba ogbɔ ambɛ mgbi akpesho, kpaa ema ka yagba difwi ambɛ mgbi odzɛɛdzɛ ongwi onɛnɛ ba. <verse eid="MAT 16:3"/><verse number="4" style="v" sid="MAT 16:4"/>Etɔ obube yi etɔ amah li le pita ambɛ okwulewo, nghaduu a ka nun onyi ba, se li ambɛ mgbi iJona na ta.&gt;&gt; IYesu si dzata ma lu.<verse eid="MAT 16:4"/></para>
  <para style="s1">Okwuna mgbi emi iFarasi <optbreak/> yi emi iSadusi</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5"/>Ngwi engwafɔ iYesu foye utɔ nɛ, a gblimɔ okye ibredi byi. <verse eid="MAT 16:5"/><verse number="6" style="v" sid="MAT 16:6"/>Nɛ iYesu nya ma gbɛɛ, &lt;&lt;Gbɛwɛbyi di ngyo ewoma mi okwuna mgbi emi iFarasi yi emi iSadusi na.&gt;&gt;<verse eid="MAT 16:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 16:7"/>A le gbɔ yi ewoma gbɛɛ, &lt;&lt;Li ikyegbɛɛ eyi kye ibredi onyi kpaa byi ba mani.&gt;&gt;<verse eid="MAT 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8"/>Ngwi iYesu ye ewodzɛ mgbi ama nɛ, o gbɛɛ, &lt;&lt;Ema ngwu oyɛyɛ onuunu shanyɛ mbi ema nɛ, kyɔnɛse ema le gbɔ yi ewema kyɛ gbɛɛ li ikyegbɛɛ ema dzɛ yi ibredi ba? <verse eid="MAT 16:8"/><verse number="9" style="v" sid="MAT 16:9"/>Ema difwi walo? Ema wɛ ibredi eda mi ikye inggisɛ idubu eda, yi ongwi ema gbe mbwo uya kwuba na lo? <verse eid="MAT 16:9"/><verse number="10" style="v" sid="MAT 16:10"/>Naadi ibredi nghi egyafa mi ikye inggisɛ idubu enɛ, yi ongwi ema gbe mbwo uya kwuba na lo? <verse eid="MAT 16:10"/><verse number="11" style="v" sid="MAT 16:11"/>Ani le gbɔdzɛ yi ema mi ikye ibredi ba, i wita sinɛ ngwi ema difwi ba? Kpaa ngyo ewema mi okwuna mgbi emi iFarasi yi emi iSadusi.&gt;&gt; <verse eid="MAT 16:11"/><verse number="12" style="v" sid="MAT 16:12"/>Ta a difwi gbɛɛ o le nya ama gbɛɛ ni ama ngyo ewoma mi ikye okwuna owo ibredi ba, nghaduu li ikye otsootso mgbi emi iFarasi yi emi iSadusi.<verse eid="MAT 16:12"/></para>
  <para style="s1">IPyita gbɔ odzɛɛdzɛ mgbi iYesu</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13"/>Dafi iYesu ba ayɛsɛ mgbi iSisiria iFyilipi nɛ, o byi engwafɔɔn gbɛɛ, &lt;&lt;Inggisɛ li gbɛɛ Ongwɛ Inggisɛ li emɛ?&gt;&gt;<verse eid="MAT 16:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14"/>A gbɛɛ, &lt;&lt;Angbeka gbɛɛ o li iJɔn okyɔ iBatisima, angbeka yɔ gbɛɛ o li Elaija, angbeka di gbɛɛ o li iJeremia hona onyi mbi ama ogbɛɛsɛ.&gt;&gt;<verse eid="MAT 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15"/>IYesu byita gbɛɛ, &lt;&lt;Nghanɛ ema ma, ema gbɛɛ ani li emɛ?&gt;&gt;<verse eid="MAT 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16"/>Nɛ iSaimɔn iPyita nu uka gbɛɛ, &lt;&lt;Abu li iMedzaya,<note caller="+" style="f"><char style="fr" closed="false">16:16 </char><char style="ft" closed="false">Ngwi li iKrestu mi ondu iGriki nani.</char></note> Ongwɛ Imgbasho oshishe.&gt;&gt;<verse eid="MAT 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17"/>IYesu nyan gbɛɛ, &lt;&lt;Mse no bɛ abu ewo, iSaimɔn ongwɛ iJona, bana li inggisɛ nya abu ungwɔnɛ ba, kpaa kyɛ mbi Otsani ongwi esho. <verse eid="MAT 16:17"/><verse number="18" style="v" sid="MAT 16:18"/>Nghanɛ n kwu abu gbɛɛ iPyita,<note caller="+" style="f"><char style="fr" closed="false">16:18 </char><char style="ft" closed="false">Iyi iPyita na itan di ikwutsɛ mi ondu iGriki.</char></note> ma li mi ikye ikwutsɛ nɛ n ka mbɛ okwakye mgbi emi iKrestu mgbi ani, ma onufozu udola ka yagba tukwu ofɛ ba. <verse eid="MAT 16:18"/><verse number="19" style="v" sid="MAT 16:19"/>N ka gbe ungwɔ okwulu ofɛ esutɔ ongwi esho duu nu abu; alungwɔ ngwi abu kyi bwalu mi esɛ nɛ duu, a ka kye bwalu mi esho, alungwɔ ngwi abu di kye shɛlu mi esɛ nɛ duu, a ka kye shɛlu mi esho.&gt;&gt; <verse eid="MAT 16:19"/><verse number="20" style="v" sid="MAT 16:20"/>Ta o kwo engwafɔɔn adɔ gbɛɛ nu ma ka nya inggisɛ onyi gbɛɛ ongwu li iMedzaya ma ba.<verse eid="MAT 16:20"/></para>
  <para style="s1">IYesu yegbɔ ikwu ewon</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21"/>Mi onɔ na lu iyayi iYesu wita onya engwafɔɔn gbɛɛ li kyɛmɛ ngwi ongwu ka kɛ iJerosalin ka gbiisɔ mi ungwɔ kwuba mi abɔ engyukwo emi Israi yi engyukwo ama ofifɛ bɛyi etsetse mgbi ola, a dika ngwɔ ongwu kyɛmɛ, nghaduu mi egbe ongwu ta ma ongwu ka kyɛɛ mi ikwu.<verse eid="MAT 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22"/>Nɛ iPyita kyon lu enggengga ka wita okyɔkyɔ yan gbɛɛ, &lt;&lt;Imgbasho no tukwu ofɛ nani, Otsɛ! Ungwɔnɛ ka yama kyɔ abu ba!&gt;&gt;<verse eid="MAT 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23"/>IYesu kyata yɛ nya iPyita gbɛɛ, &lt;&lt;Yɛ iyikpa mbi ani, iSatan! Abu li ungwɔ onu ani esɛ ogboogbo; bana abu kye ungwɔ ama nli mgbi Imgbasho ma wuuta ba, se li mgbi inggisɛ kyoon.&gt;&gt;<verse eid="MAT 16:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24"/>Ta iYesu nya engwafɔɔn gbɛɛ, &lt;&lt;Kini inggisɛ mina okyɛdɔ ani yɔ, li kyɛmɛ ngwi o ka tangwɛ ewon yɛ kye ekwatsi mgban kyɛdɔ ani. <verse eid="MAT 16:24"/><verse number="25" style="v" sid="MAT 16:25"/>Lubana ali inggisɛ nmina ona oshishe mgban tɔ yɔ, oshishe mgban ka byulu, kpaa inggisɛ nnu oshishe mgban byulu ikye ani duu ka tun. <verse eid="MAT 16:25"/><verse number="26" style="v" sid="MAT 16:26"/>Ni inggisɛ tu alungwɔ mi ɛsɛ duu kpaa ni oshishe mgban nyanya lon ma, oyabɔ li ekyɛ? Naadi li ekyɛ ngwi inggisɛ ka kye nu gbikye oshishe mgban? <verse eid="MAT 16:26"/><verse number="27" style="v" sid="MAT 16:27"/>Lubana Ongwɛ Inggisɛ ka wa ba mi okwɔkwɔ mgbi Otsɔn yi engyesɔ mgban, nɛ o ka nu ali inggisɛ umba mi okyɔɔkyɔ mgbi otsungwɔn. <verse eid="MAT 16:27"/><verse number="28" style="v" sid="MAT 16:28"/>N nya ema otsitsi, ema angbeka kwudzɛ mmɛnɛ ma, nka di ikwu inɛ ba nghataa wa di Ongwɛ Inggisɛ kyɛ le ba mi esutɔ mgban.&gt;&gt;<verse eid="MAT 16:28"/></para>
  <chapter eid="MAT 16"/>
  <chapter number="17" style="c" sid="MAT 17"/>
  <para style="s1">Okwɔkwɔ mgbi iYesu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1"/>Ngwi i wa nyɛ egbe egyin nɛ, iYesu kyelu iPyita yi iJɛnsi bɛyi ongwunɔn iJɔn, si teyi ma ofɛ lu ka dɔkɛ unggwɔ oshigbo to efu yuoma. <verse eid="MAT 17:1"/><verse number="2" style="v" sid="MAT 17:2"/>Mi imbe na a kyatan mi inai ma. Inɛ mgban kwɔkwɔ dafi onɔ, angwuto mgban tundzɛ kpledede dafi osa mani. <verse eid="MAT 17:2"/><verse number="3" style="v" sid="MAT 17:3"/>Labɔlabɔ nɛ iMose bɛyi Elaija mblegba tu ma, le gbɔdzɛ yi iYesu.<verse eid="MAT 17:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 17:4"/>Nɛ iPyita si nya iYesu gbɛɛ, &lt;&lt;Otsɛ, i tishi ni eyi dzɛ mmɛnɛni. Ni abu gbela yɔ, n ki klɛ afu nghi eta, onyi ikye abu, onyi ikye iMose oka ikye Elaija.&gt;&gt;<verse eid="MAT 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5"/>Dafi o kale kiyayi yi odzɛ ogbɔɔgbɔ nɛta, akpa okwɔkwɔ gbiiwulu tukwu ma, ela si tɔ mi akpa na gbɛɛ, &lt;&lt;Nɛnɛ li Ongwani itukwu-tukwu; i kpa Ani yan saan. Fwon na!&gt;&gt;<verse eid="MAT 17:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 17:6"/>Ngwi engwafɔ mgbi iYesu fwo ungwɔnɛ nɛ, a si lakɛ esɛ kye inɛ tukwu esɛ, yi imio. <verse eid="MAT 17:6"/><verse number="7" style="v" sid="MAT 17:7"/>Nɛta iYesu si ba wa kye abɔ gbo ma ewo. O nya ma gbɛɛ, &lt;&lt;Kyato, ka wimio ba na.&gt;&gt; <verse eid="MAT 17:7"/><verse number="8" style="v" sid="MAT 17:8"/>Ngwi a kyile inɛ esho nɛ, a yama di inggisɛ onyi wuba se iYesu ta.<verse eid="MAT 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9"/>Dafi a tashulu mi unggwɔ le luba esɛ nɛ, iYesu wo ma ola gbɛɛ, &lt;&lt;Ka yama gbɔ ungwɔ ngwi ema di nɛ nya inggisɛ onyi ba, nghataa se ni a wa kyile Ongwɛ Inggisɛ mi ikwu.&gt;&gt;<verse eid="MAT 17:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10"/>Engwafɔ mgbi iYesu byun gbɛɛ, &lt;&lt;Kyɔsinɛse ngwi etsetse mgbi ola lile gbɔgbɛɛ Elaija ka wa ba ababɔ kyɛmɛ?&gt;&gt;<verse eid="MAT 17:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11"/>Man iYesu nu uka gbɛɛ, &lt;&lt;Li otsitsi, Elaija ka ba wa yile alungwɔ mɛ dzɛkɛ yɛyɛ. <verse eid="MAT 17:11"/><verse number="12" style="v" sid="MAT 17:12"/>Nghaduu n nya ema, Elaija ba wa, kpaa a yama difwin ba nɛ a kyɔn alungwɔ ngwi a mina duu. Mi itɔ ofɛ na kpɔɔ Ongwɛ Inggisɛ ka wa gyadzɛ mi abɔ ma.&gt;&gt; <verse eid="MAT 17:12"/><verse number="13" style="v" sid="MAT 17:13"/>Ta engwafɔɔn si difwi gbɛɛ li iJɔn okyɔ iBatisima ngwi o le gbɔdzɛ mgban nya ama aali.<verse eid="MAT 17:13"/></para>
  <para style="s1">Ongwongyulɔ ngwu a dulun <optbreak/> onodzi emɛsɛ</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14"/>Dafi a yidɔ wa tu ibyi inggisɛ nɛ, ongyulɔ oka ba wa kwokiyayi iYesu. <verse eid="MAT 17:14"/><verse number="15" style="v" sid="MAT 17:15"/>O nyan gbɛɛ, &lt;&lt;Otsɛ, di ongwani ongwu ongyulɔ nɛ elela. O li dzɛkwulu pyiipyii mi onɔ ngwi i wa dzɛsin, o li gye onikyɔ adzɛ oshewo saan. O li gbɛsɛ tsɛkɛ ola hona mi eni alonɔ ngwi i dzɛsun duu. <verse eid="MAT 17:15"/><verse number="16" style="v" sid="MAT 17:16"/>N kyon ba mbi engwafɔ mgbi abu, kpaa a yagba ongyɛlun ootse nɛ ba.&gt;&gt;<verse eid="MAT 17:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17"/>Nɛ iYesu gbɛɛ, &lt;&lt;Kpei, etɔ ndzɛ yi oyɛyɛ onuunu ba di dzɛ kpɛnyɛ-kpɛnyɛ nɛ! Ka kye onɔ sinɛ ngwi ani ka dzɛ yi ema? Ka kye onɔ sinɛ ngwi ani ka kyungwɔ yi ema? Kye ongwongyulɔ ma ba mbi ani mmɛnɛni!&gt;&gt; <verse eid="MAT 17:17"/><verse number="18" style="v" sid="MAT 17:18"/>Ta iYesu kyɔkyɔ yi onodzi obube nani, man onodzi ma tasɛ mbi ongwongyulɔ nani, mi onɔ na jo ootse mgban ngyɛ.<verse eid="MAT 17:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19"/>Nɛ engwafɔ mgbi iYesu si ba mbon fyɛɛ wa byun gbɛɛ, &lt;&lt;Kyɔsinɛse ngwi eyi yagba lɔ onodzi obube nɛ onya tɔ gbɛ ba?&gt;&gt;<verse eid="MAT 17:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20"/>Man iYesu nya ma gbɛɛ, &lt;&lt;Li ikyegbɛɛ ema dzɛ yi oyɛyɛ onuunu shanyɛ mani. N nya ema otsitsi, kini ema dzɛ yi oyɛyɛ onuunu ndzɛ tsiklimbyi dafi inɛnɛ unkwodzi hini yɔ, ema ka nya unggwɔ gbɛɛ, &lt;Kyato mmɛnɛ lu mbo&gt; ka yagba kyɔ ngha. Nkonyi ka ndɛ ema okyɔɔkyɔ ba.&gt;&gt; <verse eid="MAT 17:20"/><verse number="21" style="v" sid="MAT 17:21"/>(Kpaa itɔ nɛ li yama tɔ ngha ba, sede li mi ibɔ bɛyi ondu otukwu-tukwu kpɔklɔɔ!)<note caller="+" style="f"><char style="fr" closed="false">17:21 </char><char style="ft" closed="false">Ambulu nɛ dzɛ mi olɔɔlɔ angbeka ba.</char></note><verse eid="MAT 17:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22"/>Ngwi a wa kwakye yi ewoma mi iGalalia nɛ, iYesu nya ma gbɛɛ, &lt;&lt;A ka wa kye Ongwɛ Inggisɛ wo inggisɛ kɛ abɔ. <verse eid="MAT 17:22"/><verse number="23" style="v" sid="MAT 17:23"/>A ka ngwɔn, ta mi egbe ongwu ta ma Imgbasho ka kyilen mi ikwu.&gt;&gt; Nɛta engwafɔɔn si yɛɛ elela.<verse eid="MAT 17:23"/></para>
  <para style="s1">Udza IDracama</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24"/>Ngwi iYesu yi engwafɔɔn wa kaka iKapenahun nɛ, ama ogbɛ udza IDracama<note caller="+" style="f"><char style="fr" closed="false">17:24 </char><char style="ft" closed="false">IDracama li udza ifyɛɛ mgbi ozu okwukwo osunu Imgbasho mi iJerosalin, ngwi ali ongyulɔ iJuda li kpaa akpe efa mi onova mani.</char></note> ba mbi iPyita wa byun gbɛɛ, &lt;&lt;Otsetse mgbi ema nɛ li kpa udza ifyɛɛ mgbi ozu okwukwo osunu Imgbasho mi iJerosalin lo?&gt;&gt;<verse eid="MAT 17:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25"/>O gbɛɛ, &lt;&lt;Ɛɛn, o li kpa.&gt;&gt; Ngwi iPyita wa kaka ozu nɛta, iYesu li inggisɛ ongwu ababɔ ogbɔdzɛ. O byita gbɛɛ, &lt;&lt;Abu tsɛwɛ sinɛ, iSaimɔn? Li mbi ele ngwi utɔ emi ɛsɛ li gbɛ udza ifyɛɛ, li mbi engwɛ ma engyulɔ naadi li mbi inggisɛ angbeka?&gt;&gt;<verse eid="MAT 17:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26"/>Nɛ iPyita nu uka gbɛɛ, &lt;&lt;Li mbi inggisɛ angbeka.&gt;&gt; Ta iYesu gbɛɛ, &lt;&lt;Ngyɛse emi ongwɛ ma wele ba.&gt;&gt; <verse eid="MAT 17:26"/><verse number="27" style="v" sid="MAT 17:27"/>&lt;&lt;Nghaduu ni eyi ka foola mgbi ama bayɔ, lu utɔ ka ngwi alii. Kye mmbweni ongwi ababɔ ngwi abu kwu ma; kwulun ondu ta o ka tu iwai awuya. Kyelu kye wa nu ma mi ikye udza ifyɛɛ mgbi ani yi abu.&gt;&gt;<verse eid="MAT 17:27"/></para>
  <chapter eid="MAT 17"/>
  <chapter number="18" style="c" sid="MAT 18"/>
  <para style="s1">Ongwu nshewo ngha mi esutɔ <optbreak/> ongwi esho</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1"/>Mi onɔ na engwafɔ iYesu ba mbon wa byun gbɛɛ, &lt;&lt;Li emɛni shewo ngha mi esutɔ ongwi esho?&gt;&gt;<verse eid="MAT 18:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 18:2"/>Nɛ iYesu kwu ongwɛ ogyɛngyɛ ela ba wa non dzɛkɛ mi idzidzɛ ma. <verse eid="MAT 18:2"/><verse number="3" style="v" sid="MAT 18:3"/>O gbɛɛ, &lt;&lt;N nya ema otsitsi, sede ni ema kyata di yɛɛ dafi ɛngbɛ ama oshilɛlɛ bayɔ, ema ka kaka esutɔ ongwi esho ba. <verse eid="MAT 18:3"/><verse number="4" style="v" sid="MAT 18:4"/>Nghanɛ, ali inggisɛ n yile ewon esɛ dafi ongwɛ nɛ yɔ, ka shewo ngha mi esutɔ ongwi esho.<verse eid="MAT 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 18:5"/>&lt;&lt;Ali inggisɛ ndi gbɛ ongwongbɛ dafi ongwu nɛ mi iyi mgbi ani yɔ, gbɛ ani. <verse eid="MAT 18:5"/><verse number="6" style="v" sid="MAT 18:6"/>Kpaa ni inggisɛ onyi nu onyi mbi ama oshilɛlɛ ntonɛ ngwu noyɛyɛ mbi ani nɛ kyɔ alobube yɔ, ka tatase nu ma kye onikyikwɔɔ okpinangwɔ shaan onbukwɔ kyen ka ngwuta mi ole ozunubyi mi idzidzɛ ekyoo okwukwo.<verse eid="MAT 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 18:7"/>&lt;&lt;Ahoo ikye ɛsɛ mi ikye ungwɔ nnu inggisɛ kyɔ alobube mani! Itɔ ungwɔ ntona ka wa dzɛ kyɛmɛ-kyɛmɛ, nghanɛ ikamba ka wa dzɛ mi ikye inggisɛ ngwu itɔ ungwɔ ntona ka kyɛ ikpewon ba mani! <verse eid="MAT 18:7"/><verse number="8" style="v" sid="MAT 18:8"/>Ni abɔ naadi afɔ mgbi abu nu abu kyungwɔ obube yɔ, kye dzɛlu ngwuta. Ka tatase ni abu kaka oshishe yi mmya otaata hona ogbyikye-gbyikye ngha onu abu dzɛ yi abɔ efa bɛyi afɔ efa nu ma kye abu ngwuta wokɛ ola nka gye gyegwu nani. <verse eid="MAT 18:8"/><verse number="9" style="v" sid="MAT 18:9"/>Kini inɛ mgbi abu nu abu kyungwɔ obube yɔ, kye todulu ngwuta. Ka tatase ni abu kaka oshishe yi inɛ onyi ngha odzɛ yi inɛ efa nu ma kye abu ngwuta wokɛ udola.<verse eid="MAT 18:9"/></para>
  <para style="s1">Utsa mgbi mmala nbyulu</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10"/>&lt;&lt;Ka di gbɛɛ ɛngbɛ ama oshilɛlɛ ntonɛ li unkaba ba na. Bana n nya ema gbɛɛ engyesɔ mgbi ama mi esho li di inɛ Otsani ongwi esho alonɔ duu. <verse eid="MAT 18:10"/><verse number="11" style="v" sid="MAT 18:11"/>(Bana Ongwɛ Inggisɛ ba owa nagbɛ inggisɛ ama nbyulu mani.)<note caller="+" style="f"><char style="fr" closed="false">18:11 </char><char style="ft" closed="false">Ambulu nɛ dzɛ mi olɔɔlɔ angbeka ba.</char></note><verse eid="MAT 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12"/>&lt;&lt;Ema tsɛwɛ sinɛ? Kini inggisɛ dzɛ yi mmala ideli onyi, ma onyi mi efu byulu lu mbeka ma, o ka dzata ngwusenɛ dɔn iwyo diwyegyanɛ ntona mi unggwɔ lu oka pita onyi nbyulu wooshɛ na baa? <verse eid="MAT 18:12"/><verse number="13" style="v" sid="MAT 18:13"/>Ki non ka kpakyon yɔ, n nya ema otsitsi, o ka tsatsa kpakpa ikye mmala onyi nbyulu na ngha ngwusenɛ dɔn iwyo diwyegyanɛ nbyulu wooshɛ ba ntonani.<figure style="fig" alt="Mmala nbyulu" file="DN00471b.tif" size="col" loc="18;13" copy="DN00471b" ref="18:13">The lost sheep</figure> <verse eid="MAT 18:13"/><verse number="14" style="v" sid="MAT 18:14"/>Mi itɔ ofɛ nɛ kpɔɔ Otsema ndzɛ esho dzɛ yi oweka gbɛɛ onyi mbi ɛngbɛ ama oshilɛlɛ ntonɛ nu ma byulu ba.<verse eid="MAT 18:14"/></para>
  <para style="s1">Ongwunɔ nkyɔ abu obube</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15"/>&lt;&lt;Kini ongwunabu kyɔ abu obube yɔ, kɛ ka non difwi obube mgban, mi idzidzɛ ema efa ta. Ki non gadɔ mi elodzɛ mgbi abu yɔ, abu yilen dzɛ ofɛ waali. <verse eid="MAT 18:15"/><verse number="16" style="v" sid="MAT 18:16"/>Nghaduu non yama gbela fwo bayɔ, kye inggisɛ onyi naadi efa bɛkɛ yɔɔ wafɔ kɛ mbon, ikyegbɛɛ nu ma yile odzɛ mɛ mi obwɛndɛ mgbi inggisɛ efa hona eta mani. <verse eid="MAT 18:16"/><verse number="17" style="v" sid="MAT 18:17"/>Ki non fwa ofwo ma yɔ, nya okwakye mgbi emi iKrestu, non di fwa ofwo okwakye mgbi emi iKrestu kpaa yɔ, kyɔ yan dafi abu kika kyɔ yi inggisɛ ola angwula naadi inggisɛ ogbɛ udza ifyɛɛ mani.<verse eid="MAT 18:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18"/>&lt;&lt;N nya ema otsitsi, alungwɔ ngwi ema kye bwalu mi ɛsɛ nɛ duu a teyi kye bwalu mi esho wa, alungwɔ ngwi ema di kye shɛlu mi ɛsɛ nɛ duu a teyi kye shɛlu mi esho wa.<verse eid="MAT 18:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19"/>&lt;&lt;N di nya ema gbɛɛ ni ema efa mi ɛsɛ bwondu bɔ ungwɔ yɔ, Otsani ndzɛ esho na ka kyɔ ema ele. <verse eid="MAT 18:19"/><verse number="20" style="v" sid="MAT 18:20"/>Bana imbe ngwi inggisɛ efa naadi eta kwakye mi iyi mgbi ani ma, Ani dzɛ ele yi ama.&gt;&gt;<verse eid="MAT 18:20"/></para>
  <para style="s1">Utsa mgbi ongbidɔ odi elela ba</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21"/>Ta iPyita wa byi iYesu gbɛɛ, &lt;&lt;Otsɛ, li akpe eminɛ ngwi ani ka dzata ongwunani ki non kyɔ ani obube? No li akpe egyafa hinii?&gt;&gt;<verse eid="MAT 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22"/>IYesu nyan gbɛɛ, &lt;&lt;N nya abu, akpe egyafa ta ba, kpaa li akpe ngwuseta dɔn iwyo diwyegyafa.<verse eid="MAT 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 18:23"/>&lt;&lt;Nghanɛ, esutɔ ongwi esho dzɛ dafi utɔ oka nkwu engbidɔ mgban ama ngbɛ mkpa mbon ela ba gbɛɛ nu ma nya ongwu mmbwo mkpa ngwi a dzɛ yi ongwu efu mani. <verse eid="MAT 18:23"/><verse number="24" style="v" sid="MAT 18:24"/>Dafi o wita okyungwɔnɛ nɛ, a kye ongyulɔ oka ba mbon ndzɛyan mkpa mɛ imiliɔn ibyibyi. <verse eid="MAT 18:24"/><verse number="25" style="v" sid="MAT 18:25"/>Ngwi o yagba okpa mkpa na gbɛ ba nɛ, ongyukwo na si noola gbɛɛ ongwu yi owan yi ɛngbɛ yi alungwɔ ngwi o dzɛyan tsatsadu ni a gbe ma gya kpa mkpa nani.<verse eid="MAT 18:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 18:26"/>&lt;&lt;Ongbidɔ na si gbe akwafɔ kwɛsɛ tɛkyɛ nun gbɛɛ, &lt;Shitukwu yi ani, n ka wa kpa abu alungwɔ duu.&gt; <verse eid="MAT 18:26"/><verse number="27" style="v" sid="MAT 18:27"/>Ongyukwo mgban si din elela. O dzanta yi mkpa nani di non lu.<verse eid="MAT 18:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28"/>&lt;&lt;Ta ongbidɔ na tasɛ lu esɛ, o ka kpatsɛ yi odon ongbidɔ oka ndzɛyan mkpa mɛ dafi idubu ngwusefa dɔn iwyo sini. O kpaklin kye abɔ fyin onbukwɔ gbɛɛ, &lt;Kpa ani mkpa ngwi abu dzɛ yi ani efu mani!&gt;<verse eid="MAT 18:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 18:29"/>&lt;&lt;Ongbidɔ odon na si gbe akwafɔ kwɛsɛ di tɛkyɛ nun gbɛɛ, &lt;Shitukwu yi ani, n ka wa yile udza mgbi abu kpa abu.&gt;<verse eid="MAT 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 18:30"/>&lt;&lt;Nghaduu o fwa. O kɛ ka nu ma bwa ongyulɔ na wokɛ obawi gbɛɛ sede no kpan mkpa. <verse eid="MAT 18:30"/><verse number="31" style="v" sid="MAT 18:31"/>Ngwi engbidɔ angbeka di ungwɔ nkyɔ nɛ, i wulu ma ewo saan man a kɛ ka nya ongyukwo mgbi ama ungwɔ nkiyayi duu.<verse eid="MAT 18:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 18:32"/>&lt;&lt;Ta ongyukwo ma kwu ongbidɔ na ela ba mbon nyan gbɛɛ, &lt;Abu ongbidɔ ndzɛ yi imbali nɛ, n dzita abu yi udza ngwi abu dzɛ yi ani ele duu ikyegbɛɛ abu tɛkyɛ nu ani. <verse eid="MAT 18:32"/><verse number="33" style="v" sid="MAT 18:33"/>Abu kpa ki di odo oka na elela dafi ani di abu na baa?&gt; <verse eid="MAT 18:33"/><verse number="34" style="v" sid="MAT 18:34"/>Ongyukwo na nyɛ yi itingga kyen wo ama odi mi obawi abɔ gbɛɛ nu ma nun adzɛ saan, nghataa se non yile mkpa ngwi o gye na kpa klɛklɛ.<verse eid="MAT 18:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35"/>&lt;&lt;Nɛ li ngha ngwi Otsani ongwi esho ka kyɔ yi ali inggisɛ mgbi ema, se ni ema dzita ongwunema yi obube itukwu onyi.&gt;&gt;<verse eid="MAT 18:35"/></para>
  <chapter eid="MAT 18"/>
  <chapter number="19" style="c" sid="MAT 19"/>
  <para style="s1">Eba oghaagha</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1"/>Ngwi iYesu ngyɛlu odzɛ ntonɛ ogbɔɔgbɔ bɛyi ama nɛ, o lu dzata iGalalia di kaka mi ayɛsɛ mgbi iJudia lu oyombo iJodan. <verse eid="MAT 19:1"/><verse number="2" style="v" sid="MAT 19:2"/>Ibyi inggisɛ tukwun iyikpa kyɛ, man o ngyɛlu ma ootse mi imbe nani.<verse eid="MAT 19:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3"/>Emi iFarasi angbeka ba mbon ikye owa mbadin. A byin gbɛɛ, &lt;&lt;Li ola ni ongyulɔ gheeba yi owan mi ali itɔdzɛ duu?&gt;&gt;<verse eid="MAT 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4"/>IYesu nu uka gbɛɛ, &lt;&lt;Ema gbɔ ye walo? Gbɛɛ mi owita-wita ma Atta &lt;ta ongyulɔ yi ongyaa,&gt; <verse eid="MAT 19:4"/><verse number="5" style="v" sid="MAT 19:5"/>di gbɛɛ, &lt;Mi itɔdzɛ nɛ, ongyulɔ ka dzita otsɔn bɛyi onɔn yɛ kwokyi yi owan, ta ama efa ka yɛɛ ikpewo onyi.&gt; <verse eid="MAT 19:5"/><verse number="6" style="v" sid="MAT 19:6"/>Nɛ a li efa wuba, kpaa a li onyi. Ikyenghanɛ ungwɔ ngwi Imgbasho kye kwokyi yi eka yɔ, ni inggisɛ onyi ka yama ghalu ma ba.&gt;&gt;<verse eid="MAT 19:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7"/>A byita gbɛɛ, &lt;&lt;Nghama kyɔsinɛ ngwi iMose woola gbɛɛ ongyulɔ no dzɛ afɛ ogheeba nu owan di lɔn onya lu?&gt;&gt;<verse eid="MAT 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8"/>IYesu gbɛɛ, &lt;&lt;iMose nose nu ema ofɛ ogheeba yi owema ikyegbɛɛ itukwu mgbi ema tiishu. Nghaduu li ngha ngwi i dzɛ mi owita-wita ma ba. <verse eid="MAT 19:8"/><verse number="9" style="v" sid="MAT 19:9"/>N nya ema gbɛɛ ali inggisɛ n gheeba yi owan, ni li ikye amah ba di kye ongyaa oka yɔ, kyɔ amah.&gt;&gt;<verse eid="MAT 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10"/>Ta engwafɔɔn nyan gbɛɛ, &lt;&lt;Ni li ngha ungwɔ dzɛ yi ongyulɔ yi owan yɔ, i tatase okye ongyaa ba.&gt;&gt;<verse eid="MAT 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11"/>Nghaduu iYesu gbɛɛ, &lt;&lt;Li ali inggisɛ duu ka gbela odzɛ nɛ ba, kpaa li ama ngwu a kye nu ma mata. <verse eid="MAT 19:11"/><verse number="12" style="v" sid="MAT 19:12"/>Lubana angbeka li adumongyaa ikyesinɛ li ngha ngwi a mba ma aali; angbeka li inggisɛ kyɔ ma nu ma yɛɛ ngha aali; angbeka di fwa okye ongyaa ikye esutɔ ongwi esho. Inggisɛ nka gbela yi odzɛ nɛ yɔ no gbela.&gt;&gt;<verse eid="MAT 19:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13"/>Nɛta a gbe ɛngbɛ ama oshilɛlɛ ba mbi iYesu gbɛɛ no kye abɔ gbo ma ewo di bibɔ wo ma. Kpaa engwafɔɔn kyɔkyɔ yi ama ngbe ma ba mani.<verse eid="MAT 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 19:14"/>IYesu gbɛɛ, &lt;&lt;Nu ɛngbɛ ama oshilɛlɛ ofɛ nu ma ba mbi ani, ka yama kwɔ ma ba, bana esutɔ ongwi esho dzɛ ikye itɔ ntonɛni.&gt;&gt; <verse eid="MAT 19:14"/><verse number="15" style="v" sid="MAT 19:15"/>Ngwi o kye abɔ gbo ma ewo nɛ, o lu dzata imbe nani.<verse eid="MAT 19:15"/></para>
  <para style="s1">Mmafa inggisɛ aludu</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16"/>Nghanɛ ongyulɔ oka ka ba mbi iYesu wa byita gbɛɛ, &lt;&lt;Otsetse, li alungwɔ osuse ngwi ani ka kyɔ kyɛmɛ se tu oshishe ogyegwu?&gt;&gt;<verse eid="MAT 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17"/>IYesu nyan gbɛɛ, &lt;&lt;I kyɔsinɛ ngwi abu byi ani ita ungwɔ nli osuse? Inggisɛ li Onyi ta nli osuse. Ni abu mina otu oshishe yɔ, ngyo ola duu.&gt;&gt;<verse eid="MAT 19:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18"/>Ongyulɔ na gbɛɛ, &lt;&lt;Li ole?&gt;&gt;</para>
  <para style="p" vid="MAT 19:18">IYesu gbɛɛ, &lt;&lt; &lt;Ka ngwɔ inggisɛ ba, ka kyɔ amah ba, ka yimi ba, ka kyɔ obwɛndɛ atsika ba, <verse eid="MAT 19:18"/><verse number="19" style="v" sid="MAT 19:19"/>sunu otsabu yi onabu, di di inggisɛ owatse dɔ abu kpa abu itukwu dafi ewabu mani.&gt; &gt;&gt;<verse eid="MAT 19:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20"/>Ongyulɔ mmafa na gbɛɛ, &lt;&lt;Ola ntonɛ duu n li ngyo ma. Li ekyɛ sisi ngwi ani ka kyɔ?&gt;&gt;<verse eid="MAT 19:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21"/>IYesu nyan gbɛɛ, &lt;&lt;Ni abu mina odzɛ nyaan yɔ, lu ka gbe alungwɔ ngwi abu dzɛyan duu gya kye udza ma nu emi adzɛ, ta o ka dzɛ yi aludu mi esho. Ta o si yɛ wa kyɛdɔ ani.&gt;&gt;<verse eid="MAT 19:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22"/>Ngwi ongyulɔ mmafa na fwo ungwɔnɛ nɛ, o lu yi mtse obaaba, ikyena o dzɛ yi aludu shewo.<verse eid="MAT 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23"/>Nghanɛ iYesu nya engwafɔɔn gbɛɛ, &lt;&lt;N nya ema otsitsi, ka fyumfye kpakpa ni inggisɛ udza kaka esutɔ ongwi esho. <verse eid="MAT 19:23"/><verse number="24" style="v" sid="MAT 19:24"/>N di nya ema, ka fyumfye ba onu ilakwumyi nyɛ tɔ ifeedi ngha onu inggisɛ udza kaka esutɔ mgbi Imgbasho.&gt;&gt;<verse eid="MAT 19:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25"/>Ngwi engwafɔ ntonɛ fwo ungwɔnɛ nɛ, i kwulu ma ewo kwuba ta a byita gbɛɛ, &lt;&lt;Li emɛ tsatso ka watɔ?&gt;&gt;<verse eid="MAT 19:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26"/>IYesu di ma inɛ si gbɛɛ, &lt;&lt;Mbi inggisɛ owamyɛ yɔ itɔ ungwɔnɛ ka kyɔ gbɛ ba, kpaa yi Imgbasho yɔ, alungwɔ duu li kyɛmɛ.&gt;&gt;<verse eid="MAT 19:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27"/>Nɛman iPyita gbɔ yan gbɛɛ, &lt;&lt;Eyi dzita alungwɔ duu kyɛdɔ abu! Nghanɛ li ekyɛ ka dzɛ ikye eyi?&gt;&gt;<verse eid="MAT 19:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28"/>IYesu nya ma gbɛɛ, &lt;&lt;N nya ema otsitsi, onɔ ngwi Ongwɛ Inggisɛ ka sɔkɛ itsuutɔ mgban okwɔkwɔ mi ɛsɛ ongwi iyayi ma, ema ama nkyɛdɔ ani duu ka sɔkɛ itsuutɔ iwyodefa, le gbɔ etɔ mgbi Israi iwyodefa ikwɔ. <verse eid="MAT 19:28"/><verse number="29" style="v" sid="MAT 19:29"/>Ali inggisɛ ndi dzata udɛ hona emi ongwunɔn engyulɔ yi engyaa naadi otsɔn yi onɔn hona ɛngbɛ bɛyi okwɔ mi ikye ani duu ka tun akpe ideli-ideli, a dika gyokwudɛ oshishe igyegwu. <verse eid="MAT 19:29"/><verse number="30" style="v" sid="MAT 19:30"/>Nghaduu emi ababɔ kwuba ka yɛɛ emi olɛlɛ, emi olɛlɛ ma ka yɛɛ ababɔ.<verse eid="MAT 19:30"/></para>
  <chapter eid="MAT 19"/>
  <chapter number="20" style="c" sid="MAT 20"/>
  <para style="s1">Utsa mgbi ama okyidɔ mi okwɔ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1"/>&lt;&lt;Lubana esutɔ ongwi esho dzɛ dafi otsungwɔ okwɔ ntasɛ mi egbegbeegbe oka gbe inggisɛ nu ma wa kyɔn idɔ mi okwɔ awawekwɔ mgban mani. <verse eid="MAT 20:1"/><verse number="2" style="v" sid="MAT 20:2"/>O si gbela okpa ma awuya ngwi a li kpa emi idɔ mi egbe olɔlɔ man nu ma lu okwɔ mgban ka wita idɔ.<verse eid="MAT 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 20:3"/>&lt;&lt;Mi obyi egyanɛ ongwi egbegbe o di tasɛ ka di angbeka gbeka to ifyidu le kyɔ unkonyi ba. <verse eid="MAT 20:3"/><verse number="4" style="v" sid="MAT 20:4"/>O nya ma gbɛɛ, &lt;Ema kpaa lu ka kyɔ ani idɔ mi okwɔ na, ta n ka kpa ema awuya ngwi i wogyɔ okpa mani.&gt; <verse eid="MAT 20:4"/><verse number="5" style="v" sid="MAT 20:5"/>Nɛta a si lu.</para>
  <para style="p" vid="MAT 20:5">&lt;&lt;O di wa tasɛ mi obyi iwyodefa yi obyi ongwu ta dika kyɔ ngha. <verse eid="MAT 20:5"/><verse number="6" style="v" sid="MAT 20:6"/>Ba obyi eda ongwi onɔdɛ, o tasɛ dika di angbeka kpɔɔ to imbe nani. O byi ma gbɛɛ, &lt;Kyɔsinɛ ngwi ema to mmɛnɛ kyɛ egbegbe le kyɔ unkaba?&gt;<verse eid="MAT 20:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 20:7"/>A nu uka gbɛɛ, &lt;&lt; &lt;Ikyekyɛ inggisɛ onyi kpaa kye eyi idɔ ba.&gt;</para>
  <para style="p" vid="MAT 20:7">&lt;&lt;O gbɔ yi ama gbɛɛ, &lt;Ema kpaa lu ka kyɔ ani idɔ mi okwɔ na.&gt;<verse eid="MAT 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8"/>&lt;&lt;Ngwi onɔ wa gbɛsɛ nɛ, otsungwɔ okwɔ ma nya inggisɛ nkye inɛ le byi emi idɔ mgbi ongwu ma gbɛɛ, &lt;Kwu emi idɔ ela kpa ma awuya mgbi ama, wita mbi ama ani kye ma idɔ olɛlɛ lu mbi emi ababɔ.&gt;<verse eid="MAT 20:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 20:9"/>&lt;&lt;Ama ngwu a kye ma idɔ mi obyi eda ma, a kpa ma udza idɔ mgbi egbe olɔlɔ. <verse eid="MAT 20:9"/><verse number="10" style="v" sid="MAT 20:10"/>Onɔ ngwi ama a kye ma idɔ ababɔ ba owa gbɛ awuya mgbi ama nɛ, a tsɛwɛ gbɛɛ ama ka nghao gbɛ. Nghaduu ama kpaa a kpa ma udza idɔ mgbi egbe olɔlɔ. <verse eid="MAT 20:10"/><verse number="11" style="v" sid="MAT 20:11"/>Ngwi a kye gbɛlu nɛ, a wita okwu otsungwɔ okwɔ ondukwɔ. <verse eid="MAT 20:11"/><verse number="12" style="v" sid="MAT 20:12"/>A gbɛɛ, &lt;Inggisɛ ama ngwu a kye ma idɔ olɛlɛ ntonɛ kyidɔ obyi onyi ta, ma abu kpa ma ungwonyi yi eyi ngwu tsigɛgɛ kyidɔ ni onɔ tsɛ eyi nghataa egbe olɔlɔ.&gt;<verse eid="MAT 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 20:13"/>&lt;&lt;Nghaduu o nu onyi mi ele uka gbɛɛ, &lt;Anɔ, ani kyɔ ema ogye ba. Ema gbela okyidɔ egbe olɔlɔ mi udza ngwi a teyi li kpa ma baa? <verse eid="MAT 20:13"/><verse number="14" style="v" sid="MAT 20:14"/>Kye awuya mgbi ema lu na. I mina ani okpa inggisɛ ngwu ani kyon idɔ olɛlɛ nɛ udza ungwonyi dafi ani kpa ema nɛni. <verse eid="MAT 20:14"/><verse number="15" style="v" sid="MAT 20:15"/>Ani dzɛ yi ofɛ okyungwɔ ani mina yi awuya mgbi ani baa? Naadi le wulu ema ewo ikyegbɛɛ di ani kyɔ osuse yi angbeka?&gt;<verse eid="MAT 20:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16"/>&lt;&lt;Nghanɛ emi olɛlɛ ka li ababɔ, emi ababɔ dika li olɛlɛ.&gt;&gt;<verse eid="MAT 20:16"/></para>
  <para style="s1">IYesu di gbɔdzɛ ikwu ewon</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17"/>Ngwi iYesu le kɛ iJerosalin nɛ, o gbe engwafɔ mgban iwyodefa ntona lu enggengga si nya ma gbɛɛ, <verse eid="MAT 20:17"/><verse number="18" style="v" sid="MAT 20:18"/>&lt;&lt;Eyi le lu iJerosalin, ma a ka kye Ongwɛ Inggisɛ wo engyukwo ama ofifɛ bɛyi etsetse mgbi ola abɔ. A ka ngwɔn ikwɔ ikwongye <verse eid="MAT 20:18"/><verse number="19" style="v" sid="MAT 20:19"/>dika yilon nu emi agwɛsɛ, a ka nyan agya di gbon onitse yɛ ngwɔn mi ekwatsi. Mi egbe ongwu ta ma a ka kyilen mi ikwu!&gt;&gt;<verse eid="MAT 20:19"/></para>
  <para style="s1">Imina mgbi onɔngwɛ</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20"/>Nɛ owa iDzebedi ba mbi iYesu yi emi ongwan engyulɔ, ngwi o gbe akwafɔ kwɛsɛ nɛ, o si mina abɔ oyaaya mbon.<verse eid="MAT 20:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21"/>IYesu byun gbɛɛ, &lt;&lt;Li ekyɛ ngwi abu mina?&gt;&gt;</para>
  <para style="p" vid="MAT 20:21">O gbɛɛ, &lt;&lt;Zondu yi ani gbɛɛ engwɛ ani efa ntonɛ, oka ka sɔ abu abugye oka dika sɔ abubɛ mi esutɔ mgbi abu.&gt;&gt;<verse eid="MAT 20:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22"/>Nghaduu iYesu nya ma gbɛɛ, &lt;&lt;Ema ye ungwɔ ngwi ema le bɔ ma ba. Ema ka wa mi ibwɛ ngwi ani ka wa ma gbɛɛ?&gt;&gt;</para>
  <para style="p" vid="MAT 20:22">A nu uka gbɛɛ, &lt;&lt;Eyi ka wa.&gt;&gt;<verse eid="MAT 20:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23"/>IYesu nya ma gbɛɛ, &lt;&lt;Ema ka wa mi ibwɛ mgbi ani otsitsi. Nghaduu osɔ mi abugye hona abubɛ mgbi ani yɔ, li idɔ mgbi ani onu ofɛ ba. Imbe ntonɛ dzɛ ikye mgbi ama ngwu Otsani mɛ ikye ma mani.&gt;&gt;<verse eid="MAT 20:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24"/>Onɔ ngwi iwyo ntona fwo ungwɔnɛ nɛ, a kyitingga yi engwuneka efa ntonani. <verse eid="MAT 20:24"/><verse number="25" style="v" sid="MAT 20:25"/>Man iYesu si kwu ma ela kwakye gbɛɛ, &lt;&lt;Ema ye ama ngwu a di gbɛɛ a mɛ ogbe Udzengye teyi li kyɔ mfye mboma, engyukwo ama oshewo mi idzidzɛ ma li kyɔ mfye mi ikpewo ma. <verse eid="MAT 20:25"/><verse number="26" style="v" sid="MAT 20:26"/>Dzɛ ngha yi ema ba. Tatase yɔ, ali inggisɛ nmina oyɛɛ angbodzi mi idzidzɛ ema yɔ, no li ongbidɔ mgbi ema kyɛmɛ-kyɛmɛ, <verse eid="MAT 20:26"/><verse number="27" style="v" sid="MAT 20:27"/>ali inggisɛ ndi mina oli ababɔ yɔ, no li ofyɛɛ mgbi ema kyɛmɛ-kyɛmɛ, <verse eid="MAT 20:27"/><verse number="28" style="v" sid="MAT 20:28"/>dafi Ongwɛ Inggisɛ kpaa ba gbɛɛ nu ma kyɔn idɔ ba, kpaa owa kyɔ-kyɔ inggisɛ idɔ, di kye oshishe mgban nu ikye odulu inggisɛ ibyibyi watɔ nɛni.&gt;&gt;<verse eid="MAT 20:28"/></para>
  <para style="s1">A kwulu obinɛ efa inɛ</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29"/>Ngwi emi iYesu le dzata iJeriko nɛ, ijiji inggisɛ kyɛdɔn. <verse eid="MAT 20:29"/><verse number="30" style="v" sid="MAT 20:30"/>Inggisɛ ama obinɛ efa sɔto ondoofɛ, ngwi a fwo gbɛɛ iYesu le nyɛ ofɛ na nɛ, a kweela gbɛɛ, &lt;&lt;Otsɛ, Ongwɛ iDevedi, di eyi elela!&gt;&gt;<verse eid="MAT 20:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31"/>Ijiji inggisɛ ntona kyɔkyɔ yi ama di nya ma gbɛɛ nu ma dede, kpaa a nghao kweela duu gbɛɛ, &lt;&lt;Otsɛ, Ongwɛ iDevedi, di eyi elela!&gt;&gt;<verse eid="MAT 20:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32"/>IYesu kwulɛsɛ di kwu ma ela, si byi ma gbɛɛ, &lt;&lt;Li alungwɔ mina ema gbɛɛ ni ani kyɔ ema ele?&gt;&gt;<verse eid="MAT 20:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33"/>A nu uka gbɛɛ, &lt;&lt;Otsɛ, i mina eyi odinɛ.&gt;&gt;<verse eid="MAT 20:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34"/>IYesu si di ma elela man kye abɔ gbo ma inɛ. Labɔlabɔ mata inɛ kwulu loma man a kyɛdɔn.<verse eid="MAT 20:34"/></para>
  <chapter eid="MAT 20"/>
  <chapter number="21" style="c" sid="MAT 21"/>
  <para style="s1">Okakaakaka onghaangha</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1"/>Ngwi iYesu yi engwafɔɔn dzɛ kwɛkwɛ yi iJerosalin wa kaka iBɛtifege mi Unggwɔ Olivi nɛ, iYesu si dɔ engwafɔɔn efa esɔ, <verse eid="MAT 21:1"/><verse number="2" style="v" sid="MAT 21:2"/>nya ma gbɛɛ, &lt;&lt;Kɛ ogalu ndzɛ ema iyayi nani, ni ema kaka jo ema ka di itaklimyi shadzɛ yi ongwan. Kyi shɛlu ma wa nin na. <verse eid="MAT 21:2"/><verse number="3" style="v" sid="MAT 21:3"/>Kini inggisɛ byi ema ita yɔ, nyan gbɛɛ odzɛ wo Otsɛ yi ama ta inggisɛ ma ka byakpa nu ema ofɛ ni ema kye shɛlu luba.&gt;&gt;<verse eid="MAT 21:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4"/>Ungwɔnɛ kiyayi ikye onu elodzɛ ngwi oyegbɔ gbɔ ma dondu yɛyɛ gbɛɛ:<verse eid="MAT 21:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5"/>&lt;&lt;Gbɔ nya ogalu mgbi iDzayɔn gbɛɛ,</para>
  <para style="q2" vid="MAT 21:5">&lt;Di utɔ mgbi abu,</para>
  <para style="q1" vid="MAT 21:5">nkyɛ le ba mbi abu na,</para>
  <para style="q2" vid="MAT 21:5">o le dumɔɔ di kyɛ le ba mi ikye itaklimyi,</para>
  <para style="q1" vid="MAT 21:5">mi ikye ongwɛ itaklimyi.&gt; &gt;&gt;<verse eid="MAT 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6"/>Engwafɔ ntonɛ ka kyɔ yɛyɛ dafi iYesu dɔ ma esɔ mani. <verse eid="MAT 21:6"/><verse number="7" style="v" sid="MAT 21:7"/>A kye itaklimyi yi ongwɛ itaklimyi ongyulɔ na ba, gbe angwuto mgbi ama tukwu ma kɛ ekpo man iYesu dɔkɛ ele. <verse eid="MAT 21:7"/><verse number="8" style="v" sid="MAT 21:8"/>Ibyi inggisɛ kwuba gbe angwuto mgbi ama takɛ ofɛ, angbeka dzɛ afutse gbe takɛ ofɛ. <verse eid="MAT 21:8"/><verse number="9" style="v" sid="MAT 21:9"/>Ibyi inggisɛ ama nteyin bɛyi ama nkyan iyikpa gbakwɔ gbɛɛ,</para>
  <para style="q1" vid="MAT 21:9">&lt;&lt;Osana, mbi Ongwɛ iDevedi!</para>
  <para style="q2" vid="MAT 21:9">Mse dzɛ yi ongwu nba</para>
  <para style="q2" vid="MAT 21:9">mi iyi mgbi Otsɛ mani!&gt;&gt;<verse eid="MAT 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10"/>Ngwi iYesu kaka iJerosalin nɛ, ogalu tsatsa yɛɛ yayaaya, a sile byita gbɛɛ, &lt;&lt;Nɛnɛ li emɛ lo?&gt;&gt;<figure style="fig" alt="IYesu kaka iJerosalin mi onghaangha" file="DN00487b.tif" size="col" loc="21;10" copy="DN00487b" ref="21:10">Triumphant Entry into Jerusalem</figure><verse eid="MAT 21:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 21:11"/>Ibyi inggisɛ ntona nu uka gbɛɛ, &lt;&lt;Nɛnɛ li iYesu, oyegbɔ nkyɛ iNadzareti mi iGalalia mani.&gt;&gt;<verse eid="MAT 21:11"/></para>
  <para style="s1">IYesu mi ifoozu okwukwo osunu Imgbasho <optbreak/> mi iJerosalin</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12"/>IYesu kaka ozu okwukwo osunu Imgbasho mi iJerosalin man kye lɔlu ama okyummya mi imbe na tasɛ. O kyi kyata adinyatsɛ mgbi ama onyinɛ awuya tukwukɛ esɛ, bɛyi itse otunto mgbi ama okye anyama gya. <verse eid="MAT 21:12"/><verse number="13" style="v" sid="MAT 21:13"/>O nya ma gbɛɛ, &lt;&lt;Afɛ lɔ gbɛɛ, &lt;Ozu mgbi ani ka li ozu ibɔ,&gt; kpaa ema kye kyata yɛɛ imbe mgbi &lt;ama ozoofɛ.&gt; &gt;&gt;<verse eid="MAT 21:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14"/>Emi obinɛ yi ama otummya ba mbon mi ozu okwukwo osunu Imgbasho mi iJerosalin, ta o ngyɛlu ma ootse. <verse eid="MAT 21:14"/><verse number="15" style="v" sid="MAT 21:15"/>Kpaa itingga kyɔ engyukwo ama ofifɛ yi etsetse mgbi ola ngwi a di ungwɔ ama okwulewo ngwi iYesu kyɔ di fwo ɛngbɛ tole gbakwɔ mi ozu okwukwo osunu Imgbasho mi iJerosalin gbɛɛ, &lt;&lt;Osana mbi Ongwɛ iDevedi mani.&gt;&gt;<verse eid="MAT 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 21:16"/>A byun gbɛɛ, &lt;&lt;Abu fwo odzɛ ngwi ɛngbɛ ntonɛ le gbɔ nɛ wɛ?&gt;&gt;</para>
  <para style="pi" vid="MAT 21:16">IYesu gbɛɛ, &lt;&lt;Ɛɛn, abu teyi gbɔ imbe ngwi Afɛ gbɛɛ,</para>
  <para style="pi" vid="MAT 21:16">&lt;&lt; &lt;Ɛngbɛ yi engweyeyi</para>
  <para style="pi" vid="MAT 21:16">kale shashi otsɛɛtsɛ na lo?&gt;&gt;<verse eid="MAT 21:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17"/>O si dzata ma tasɛ mi ogalu na lu ka la iBetani.<verse eid="MAT 21:17"/></para>
  <para style="s1">Andundu ngweeni</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18"/>Mi egbegbeegbe ngwi iYesu yɛ le luba ogalu nɛta enbwa dɔn. <verse eid="MAT 21:18"/><verse number="19" style="v" sid="MAT 21:19"/>O dili andundu mi ondoofɛ, si kɛ kwɛkwɛ kpaa tu unka mi ele ba sede afɛ ta. O si gbɔ yan gbɛɛ, &lt;&lt;Abu ka wa owawa wuba!&gt;&gt; Labɔlabɔ mata ekwɔ na ngweeni.<verse eid="MAT 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20"/>Ngwi engwafɔɔn dili ungwɔnɛ nɛ, ewo waa loma man a byita gbɛɛ, &lt;&lt;I kyɔsinɛse andundu nɛ ngweeni vla ngha?&gt;&gt;<verse eid="MAT 21:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21"/>IYesu nu uka gbɛɛ, &lt;&lt;N le nya ema otsitsi, ni ema noyɛyɛ di dzɛ yi itukwu efefa bayɔ, ema ka kyungwɔ ngwi a kyɔ yi ekwɔ andundu nɛ ta ba, kpaa ema ka yagba nya unggwɔ gbɛɛ, &lt;kye ewabu lu ka ngwuta wokɛ ekyoo okwukwo&gt; o dika kyɔ ngha yɛyɛ. <verse eid="MAT 21:21"/><verse number="22" style="v" sid="MAT 21:22"/>Alungwɔ ngwi ema bɔ mi ibɔ di noyɛyɛ yɔ, a ka nu ema.&gt;&gt;<verse eid="MAT 21:22"/></para>
  <para style="s1">A byita odzɛ mi odzɛ <optbreak/>mfye mgbi iYesu</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23"/>IYesu kaka akangga ozu okwukwo osunu Imgbasho mi iJerosalin, dafi o le tso nɛman engyukwo ama ofifɛ bɛyi engyukwo emi Israi ba mbon wa byun gbɛɛ, &lt;&lt;Li mi ali mfye ngwi abu le kyungwɔnɛ, li emɛ nu abu mfye nɛ?&gt;&gt;<verse eid="MAT 21:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24"/>IYesu gbɛɛ, &lt;&lt;Ani kpaa ka byi ema ita onyi. Ni ema nu ani uka yɔ, n ka nya ema mfye ngwi ani le kyungwɔ ntonɛ mani. <verse eid="MAT 21:24"/><verse number="25" style="v" sid="MAT 21:25"/>IBatisima mgbi iJɔn kyɛ mi ole? Li mi esho mbi Imgbasho naadi li mbi inggisɛ?&gt;&gt;</para>
  <para style="p" vid="MAT 21:25">A kponya yi ewoma mi odzɛ nɛ si gbɛɛ, &lt;&lt;Kini eyi gbɛɛ, &lt;Li mi esho yɔ,&gt; o ka byita gbɛɛ, &lt;Nghanɛ kyɔsinɛ ngwi ema nun oyɛyɛ ba?&gt; <verse eid="MAT 21:25"/><verse number="26" style="v" sid="MAT 21:26"/>Kpaa ni eyi gbɛɛ, &lt;Li mbi inggisɛ yɔ&gt; eyi le pyio inggisɛ, lubana inggisɛ duu gbela gbɛɛ iJɔn li oyegbɔ.&gt;&gt;<verse eid="MAT 21:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 21:27"/>Nghanɛ a si nu iYesu uka gbɛɛ, &lt;&lt;Eyi ye ba.&gt;&gt;</para>
  <para style="p" vid="MAT 21:27">O gbɛɛ, &lt;&lt;Ngyɛse ani kpaa ka nya ema mfye ngwi ani le kyungwɔ ntonɛ ba.&gt;&gt;<verse eid="MAT 21:27"/></para>
  <para style="s1">Utsa engwɛ nghi efa</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28"/>&lt;&lt;Ema tsɛwɛ sinɛ? Ongyulɔ oka nose dzɛ, o dzɛ yi engwengyulɔ efa. O kɛ mbi ongwu ongyukwo ka nyan gbɛɛ, &lt;Ongwani, lu ka kyidɔ inɛ mi okwɔ.&gt;<verse eid="MAT 21:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 21:29"/>&lt;&lt;O fwa gbɛɛ, &lt;N ka kɛ ba,&gt; nghaduu o wa kyatitukwu yɛ kɛ.<verse eid="MAT 21:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 21:30"/>&lt;&lt;Nɛ otsɔma yɛ kɛ mbi ongwan oka na dika nyan ngha yɛyɛ. O nya otsɔn gbɛɛ, &lt;N gbela, otsani,&gt; kpaa o kɛ wuba.<verse eid="MAT 21:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 21:31"/>&lt;&lt;Mi idzidzɛ ama efa ntonɛ ma, li ole kyɔ itukwu otsɔn?&gt;&gt;</para>
  <para style="p" vid="MAT 21:31">A gbɛɛ, &lt;&lt;Ongwu ongyukwo nani.&gt;&gt;</para>
  <para style="p" vid="MAT 21:31">IYesu nya ma gbɛɛ, &lt;&lt;N le nya ema otsitsi, ama ogbɛ udza ifyɛɛ yi owagbai engyaa ka kaka esutɔ mgbi Imgbasho kise ema. <verse eid="MAT 21:31"/><verse number="32" style="v" sid="MAT 21:32"/>Lubana iJɔn ba mbi ema owa tso ema ofɛ mgbi osaan, kpaa ema nun oyɛyɛ ba, nghaduu ama ogbɛ udza ifyɛɛ yi owagbai engyaa ntona nun oyɛyɛ. Ngwi ema di ungwɔ ntonɛ nɛ kpaa ema yagba kyata noyɛyɛ ba.<verse eid="MAT 21:32"/></para>
  <para style="s1">Utsa mgbi ama ogbiinɛ byi okwɔ <optbreak/> awawekwɔ</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33"/>&lt;&lt;Gadɔ mi utsa oka: Otsungwɔ ikpɛsɛ oka nose ye ekwɔ. O loka won, o tishɛ ogbe eni awawekwɔ, di ta otila ongyo okwɔ. O kye okwɔ ma wo emi okwɔ angbeka abɔ si lu agaba. <verse eid="MAT 21:33"/><verse number="34" style="v" sid="MAT 21:34"/>Ngwi onɔ oshɛɛtɔ wa dzɛ kwɛkwɛ nɛ, o dɔ engbidɔ mgban esɔ mbi ama ngwu o kye okwɔ wo ma abɔ ntona gbɛɛ nu ma ka gbɛ owawekwɔ mgban wa nun.<verse eid="MAT 21:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 21:35"/>&lt;&lt;Emi okwɔ ntona kye bwalu ɛngbɛ ntonɛ; a gbo oka ibe, ngwɔlu oka, di tsɛ ongwu ta ma ikwutsɛ. <verse eid="MAT 21:35"/><verse number="36" style="v" sid="MAT 21:36"/>Nghanɛ o diyɛ dɔ engbidɔ esɔ nghaabɔ ogbugbe, emi okwɔ ntona di kyɔ yi ama ngha yɛyɛ. <verse eid="MAT 21:36"/><verse number="37" style="v" sid="MAT 21:37"/>O dɔ ongwan abuon esɔ olɛlɛ, o gbɛɛ, &lt;a ka nu ongwani mmwɛ.&gt;<verse eid="MAT 21:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 21:38"/>&lt;&lt;Nghaduu ngwi emi okwɔ ntona dili ongwan nɛta, a gbɔ yi ewoma gbɛɛ, &lt;Nɛnɛ li ongwu nka gyokwudɛ ma aani, ba ni i tawon azukwu ni okwudɛ yɛɛ mgbi eyi.&gt; <verse eid="MAT 21:38"/><verse number="39" style="v" sid="MAT 21:39"/>A bwan kyon ngwi nyɛ ikyiishi mgbi okwɔ ekwɔ na lu esɛ di ngwɔn.<verse eid="MAT 21:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40"/>IYesu byi ma gbɛɛ, &lt;&lt;Itɔ ungwɔnɛ ma, ni otsungwɔ okwɔ na wa ba ma, o ka kyɔ yi emi okwɔ ntona sinɛ?&gt;&gt;<verse eid="MAT 21:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41"/>A nu uka gbɛɛ, &lt;&lt;O ka dzili emi imbali ntona mi ikwu elela, di yile okwɔ na wo emi okwɔ angbeka abɔ, ama nkale nun awawekwɔ mgban mi alonɔ oshɛɛtɔ duu mani.&gt;&gt;<verse eid="MAT 21:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42"/>IYesu gbɔ yi ama gbɛɛ, &lt;&lt;Ema gbɔ mi Afɛ ngbɛɛ,</para>
  <para style="pi" vid="MAT 21:42">&lt;&lt; &lt;Ikwutsɛ ngwi ama ombɛ ozu fwan ma li ongwu</para>
  <para style="pi" vid="MAT 21:42">yɛ kwulu ikye ozu mi esho na ye wa lo;</para>
  <para style="pi" vid="MAT 21:42">Ungwɔnɛ li ungwɔ ngwi Otsɛ kyɔ,</para>
  <para style="pi" vid="MAT 21:42">ma i kwulewo mi inɛ mgbi eyi badɛɛn&gt;?<verse eid="MAT 21:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43"/>&lt;&lt;Nghanɛ n le nya ema gbɛɛ a ka kyi kyelu esutɔ mgbi Imgbasho mbi ema yilen kye nu inggisɛ ama nka ba yi owawan mani. <verse eid="MAT 21:43"/><verse number="44" style="v" sid="MAT 21:44"/>(Inggisɛ ngyɛkɛ ikwutsɛ nɛ ka fwa ambulu-ambulu, kpaa ongwu ikwutsɛ nɛ gyan yɔ o ka jiyɛ.&gt;&gt;)<note caller="+" style="f"><char style="fr" closed="false">21:44 </char><char style="ft" closed="false">Olɔɔlɔ angbeka dzɛ yi ambulu nɛ na.</char></note><verse eid="MAT 21:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45"/>Onɔ ngwi engyukwo ama ofifɛ bɛyi emi iFarasi fwo utsa mgbi iYesu nɛ, a yeta gbɛɛ o le gbɔdzɛ nɛ ikye mgbi ama. <verse eid="MAT 21:45"/><verse number="46" style="v" sid="MAT 21:46"/>A pita ofɛ ni ama kpaklin, nghaduu a pyio ibyi inggisɛ ntonani, ikyekyɛ inggisɛ noyɛyɛ gbɛɛ o li oyegbɔ.<verse eid="MAT 21:46"/></para>
  <chapter eid="MAT 21"/>
  <chapter number="22" style="c" sid="MAT 22"/>
  <para style="s1">Utsa oga eba okwokyiikwokyi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1"/>IYesu diyɛ gbɔdzɛ yi ama mi utsa kpɔɔ gbɛɛ: <verse eid="MAT 22:1"/><verse number="2" style="v" sid="MAT 22:2"/>&lt;&lt;Esutɔ mgbi Imgbasho dzɛ dafi utɔ nwewo oga eba okwokyiikwokyi ikye ongwan ongyulɔ mani. <verse eid="MAT 22:2"/><verse number="3" style="v" sid="MAT 22:3"/>O dɔ engbidɔ mgban esɔ mbi ama ngwu a bɔ ma oga ma gbɛɛ nu ma ba, nghaduu a fwa obaaba.<verse eid="MAT 22:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 22:4"/>&lt;&lt;Nɛ o diyɛ dɔ engbidɔ angbeka esɔ kpɔɔ gbɛɛ, &lt;Nya ama ngwu ani bɔ ma oga ma gbɛɛ ani ngyɛlu ungwogye okyɔɔkyɔ wa: Mnda mgbi ani ongyulɔ yi mnda olubu-lubu a ngwɔ di kye fwalu ma wa, nɛ alungwɔ duu dzɛ le fɛ-fɛ. Ba oga eba okwokyiikwokyi na.&gt;<verse eid="MAT 22:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 22:5"/>&lt;&lt;Kpaa a nu itukwu mi ele ba di lu ungwɔ ma, oka lu okwɔ mgban, oka lu mmya mgban. <verse eid="MAT 22:5"/><verse number="6" style="v" sid="MAT 22:6"/>Angbeka ama nsisi ma kpali engbidɔ ntona nu ma isɔ di ngwɔlu ma. <verse eid="MAT 22:6"/><verse number="7" style="v" sid="MAT 22:7"/>Utɔ na si nyɛ yi itingga. O dɔ ogbakwu mgban esɔ ka dzili ama ongwɔ inggisɛ ntona di kye ma ogalu toola.<verse eid="MAT 22:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 22:8"/>&lt;&lt;Nɛman o nya engbidɔ mgban gbɛɛ, &lt;Oga eba okwokyiikwokyi nɛ gyɔ wa, ama ngwu ani bɔ ma ma, a mɛ oba ba. <verse eid="MAT 22:8"/><verse number="9" style="v" sid="MAT 22:9"/>Lu imbe ngwi ofɛ gha, ka bɔ ali inggisɛ ngwu ema tu duu oga nɛni.&gt; <verse eid="MAT 22:9"/><verse number="10" style="v" sid="MAT 22:10"/>Ta engbidɔ ntona tasɛ lu emi ingɔfɛ ka wulu inggisɛ ngwu ma tu duu, ama osuse yi obube wa yaokɛ, ozu oga byakpa flengba yi ingyoga.<verse eid="MAT 22:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11"/>&lt;&lt;Nghaduu ngwi utɔ ba owa kpadi ingyoga nɛta, o dili ongyulɔ oka n wo angwuto oga ba mi ele. <verse eid="MAT 22:11"/><verse number="12" style="v" sid="MAT 22:12"/>O byita gbɛɛ, &lt;Uka, abu nyɛ ole kaka mmɛnɛ ngwi abu wo angwuto oga ba?&gt; Ongyulɔ na byakpa ndɛ wifwɛ.<verse eid="MAT 22:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 22:13"/>&lt;&lt;Nɛ utɔ nya ama ogbe inɛ byi oga gbɛɛ, &lt;Bwalun abɔ yi afɔ, kyon ngwuta lu esɛ mi iifu, imbe ngwi ikwu otseetse bɛyi aba ogyeegye ka dzɛ mani.&gt;<verse eid="MAT 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 22:14"/>&lt;&lt;Lubana a bɔ inggisɛ kwuba, kpaa li gwee ta ngwi a sadu.&gt;&gt;<verse eid="MAT 22:14"/></para>
  <para style="s1">Okpa iSidza udza ifyɛɛ</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15"/>Nghanɛ emi iFarasi tasɛ ka tsɛwɛ ofɛ ngwi ama ka non gbo mi elodzɛ ni ama bwan. <verse eid="MAT 22:15"/><verse number="16" style="v" sid="MAT 22:16"/>A dɔ engwafɔ mgbi ama bɛyi emidi iHerude esɔ mbon. A gbɛɛ, &lt;&lt;Otsetse, eyi ye abu li inggisɛ oyɛyɛ, abu di li tso ofɛ mgbi Imgbasho mi otsitsi. Inggisɛ li yagba tu abu wo ba ikyekyɛ i kwokyi abu yi odzɛɛdzɛ mgbi ama ba. <verse eid="MAT 22:16"/><verse number="17" style="v" sid="MAT 22:17"/>Nya eyi ka, abu di sinɛ? Li ola ni eyi kpa iSidza udza ifyɛɛ naadi li ola ba?&gt;&gt;<verse eid="MAT 22:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18"/>Nghanɛ iYesu difwi owitukwu mgbi ama obube, nɛ o gbɛɛ, &lt;&lt;Ema emi ikpala ntonɛ, kyɔsinɛ ngwi ema le mina okya ani ukya? <verse eid="MAT 22:18"/><verse number="19" style="v" sid="MAT 22:19"/>Tso ani iwai awuya ngwi ema li kpa ifyɛɛ ele ma na.&gt;&gt; A kye ikobo mgbi ama ba wa tson, <verse eid="MAT 22:19"/><verse number="20" style="v" sid="MAT 22:20"/>O byi ma gbɛɛ, &lt;&lt;Li onodzi bɛyi olɔɔlɔ mgbi emɛ dɛn?&gt;&gt;<verse eid="MAT 22:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21"/>A nu uka gbɛɛ, &lt;&lt;Li mgbi iSidza.&gt;&gt;</para>
  <para style="p" vid="MAT 22:21">O si nya ma gbɛɛ, &lt;&lt;Kye ungwɔ nli mgbi iSidza nu iSidza, di kye ungwɔ mgbi Imgbasho nu Imgbasho.&gt;&gt;<verse eid="MAT 22:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22"/>Ngwi a fwo odzɛ nɛ mata ewo fwɛ loma. Man a dzatan lu imbe oka.<verse eid="MAT 22:22"/></para>
  <para style="s1">Okye ongyaa mi onɔ okyɛɛ mi ikwu</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23"/>Mi egbe na kpɔɔ, emi iSadusi, ama nli gbɛɛ okyɛɛ mi ikwu dzɛma ba ma, ba mbon yi ita. <verse eid="MAT 22:23"/><verse number="24" style="v" sid="MAT 22:24"/>A gbɛɛ, &lt;&lt;Otsetse, iMose nya eyi gbɛɛ ni ongyulɔ tu ongwɛ ba ta kwulu yɔ, ni ongwunɔn yile owakwadɛ na kyɛmɛ-kyɛmɛ mban ɛngbɛ. <verse eid="MAT 22:24"/><verse number="25" style="v" sid="MAT 22:25"/>Engwunɔ ewoma engyulɔ nghi egyafa to yi eyi. Ongwu ababɔ kye ongyaa kpaa kye okwudɛ dzɛ ba man kwulu dzata owan nu ongwu fan. <verse eid="MAT 22:25"/><verse number="26" style="v" sid="MAT 22:26"/>Ongwu na bɛyi ongwu ta nghataa lu mbi ongwu gyafa duu a tu ongwɛ ba. <verse eid="MAT 22:26"/><verse number="27" style="v" sid="MAT 22:27"/>Mi ongyɛɛngyɛ yɔ ongyaa na kpaa wa kwulu. <verse eid="MAT 22:27"/><verse number="28" style="v" sid="MAT 22:28"/>Nghanɛ mi onɔ okyɛɛ mi ikwu ma, o ka li owa emɛ yɛyɛ mi idzidzɛ ama egyafa na, ngwi ama duu kyon?&gt;&gt;<verse eid="MAT 22:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29"/>IYesu nu uka gbɛɛ, &lt;&lt;Ema le wɛndɛ, ikyekyɛ ema ye odzɛ ngwi Afɛ gbɔ hona mfye mgbi Imgbasho ba. <verse eid="MAT 22:29"/><verse number="30" style="v" sid="MAT 22:30"/>Mi onɔ okyɛɛ mi ikwu ma, inggisɛ ka kye ongyaa hona kye ongwɛ nu eba ba; a ka to dafi engyesɔ emi esho mani. <verse eid="MAT 22:30"/><verse number="31" style="v" sid="MAT 22:31"/>Kpaa mi odzɛ okyɛɛ mi ikwu yɔ, ema gbɔ ungwɔ ngwi Imgbasho nya ema ngwi o gbɛɛ, <verse eid="MAT 22:31"/><verse number="32" style="v" sid="MAT 22:32"/>&lt;Ani li Imgbasho ngwu Abrahan, Adziki, yi iJeko le sunun mani.&gt; O li Imgbasho mgbi emi ikwukwɔ ba kpaa mgbi emi oshishe.&gt;&gt;<verse eid="MAT 22:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33"/>Ngwi inggisɛ ntona fwo otsootso mgban nɛ, i kwulu ma ewo.<verse eid="MAT 22:33"/></para>
  <para style="s1">Ola onghaangha</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34"/>Ngwi emi iFarasi fwo gbɛɛ iYesu gbɔdzɛ dzɛ emi iSadusi umyɛ nɛ, a wa kwakye yi ewoma. <verse eid="MAT 22:34"/><verse number="35" style="v" sid="MAT 22:35"/>Onyi mboma, n ye Ola mgbi emi iJuda saan, mbadin yi ita nɛ gbɛɛ:<verse eid="MAT 22:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 22:36"/>&lt;&lt;Otsetse, li Ola ole nghaangha mi Ola duu?&gt;&gt; <verse eid="MAT 22:36"/><verse number="37" style="v" sid="MAT 22:37"/>IYesu nu uka gbɛɛ, &lt;&lt; &lt;Otsɛ Imgbasho mgbi abu no kpa abu yi eka mgbi abu duu, yi oshishe mgbi abu duu, bɛyi itukwu mgbi abu duu.&gt; <verse eid="MAT 22:37"/><verse number="38" style="v" sid="MAT 22:38"/>Nɛnɛ li ola ongwi ababɔ di nghaangha joni. <verse eid="MAT 22:38"/><verse number="39" style="v" sid="MAT 22:39"/>Ongwu fan ndzɛ dafi ongwunɛ yɔ, inggisɛ nwatse dɔ abu no kpa abu itukwu dafi ewabu mani. <verse eid="MAT 22:39"/><verse number="40" style="v" sid="MAT 22:40"/>Ola yi emi Oyegbɔ duu kye abɔ byi ola efa ntonɛni.&gt;&gt;<verse eid="MAT 22:40"/></para>
  <para style="s1">IKrestu ma li Ongwɛ emɛ</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41"/>Ngwi emi iFarasi kwakye to mbonyi nɛ, iYesu byi ma gbɛɛ, <verse eid="MAT 22:41"/><verse number="42" style="v" sid="MAT 22:42"/>&lt;&lt;Ema tsɛwɛ sinɛ mi odzɛ iMedzaya? O li ongwɛ emɛ?&gt;&gt;</para>
  <para style="pi" vid="MAT 22:42">A gbɛɛ, &lt;&lt;O li Ongwɛ iDevedi.&gt;&gt;<verse eid="MAT 22:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43"/>O gbɔ nya ma gbɛɛ, &lt;&lt;I wo sinɛ ngwi iDevedi nose le gbɔdzɛ mi Onodzi se kwun gbɛɛ &lt;Otsɛ&gt;? Bana o gbɛɛ,<verse eid="MAT 22:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44"/>&lt;&lt; &lt;Otsɛ Imgbasho gbɔ nya <note caller="+" style="f"><char style="fr" closed="false">22:44 </char><char style="ft" closed="false">Otsɛ ongwu fan nɛ li iMedzaya.</char></note>Otsɛ mgbi ani gbɛɛ:</para>
  <para style="q2" vid="MAT 22:44">&lt;&lt;Sɔkɛ abugye mgbi ani nghataa nin</para>
  <para style="q2" vid="MAT 22:44">wa nu engyikyili mgbi abu,</para>
  <para style="q1" vid="MAT 22:44">yɛɛ itse mgbi abu ogbe afɔ to ele.&gt;&gt; &gt;<verse eid="MAT 22:44"/></para>
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45"/>Ni iDevedi kwun di &lt;Otsɛ iMedzaya&gt; wali, kyɔsinɛ ngwi o dika li ongwan?&gt;&gt; <verse eid="MAT 22:45"/><verse number="46" style="v" sid="MAT 22:46"/>Inggisɛ onyi yagba dulu elodzɛ nun uka gbɛ ba, wita mi egbe na lu iyayi inggisɛ onyi fya-fya byun ita wuba.<verse eid="MAT 22:46"/></para>
  <chapter eid="MAT 22"/>
  <chapter number="23" style="c" sid="MAT 23"/>
  <para style="s1">Ikamba nghi egyafa</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1"/>Nɛta iYesu si nya ibyi inggisɛ ntona bɛyi engwafɔɔn gbɛɛ: <verse eid="MAT 23:1"/><verse number="2" style="v" sid="MAT 23:2"/>&lt;&lt;Etsetse mgbi ola ntonɛ bɛyi emi iFarasi li sisɛ mi itse mgbi iMose. <verse eid="MAT 23:2"/><verse number="3" style="v" sid="MAT 23:3"/>Nghanɛ ema ka kyɛdɔ elodzɛ mgbi ama, di kyungwɔ ngwi a nya ema gbɛɛ ni ema kyɔ duu. Kpaa ka kyɛdɔ okyɔɔkyɔ mgbi ama ba na, ikyekyɛ a li kyungwɔ ngwi ama li gbɔn ma ba. <verse eid="MAT 23:3"/><verse number="4" style="v" sid="MAT 23:4"/>A li kwu okye kpakpa dɔ inggisɛ ikye, kpaa ama abuoma li wewo okye ongwufabɔ gbo ele ba.<verse eid="MAT 23:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 23:5"/>&lt;&lt;Alungwɔ ngwi a kyɔ duu li ikyegbɛɛ ni inggisɛ di ama: A li lɔ ambulu ibyibyilo wokɛ ongwiimu kye bwakɛ ebeshu bɛyi alubɔ, a di li nu ondu angwuto mgbi ama tunto ikye ni inggisɛ di gbɛɛ di ama le sunu Imgbasho. <verse eid="MAT 23:5"/><verse number="6" style="v" sid="MAT 23:6"/>Li kpa ma osɔ imbe mmwɛ mi oga, bɛyi itse onghaangha mi ozu okwakye mgbi emi iJuda; <verse eid="MAT 23:6"/><verse number="7" style="v" sid="MAT 23:7"/>A li mina gbɛɛ a kile ta ama angba kyɛ ifyidu ni a di kwu ama gbɛɛ &lt;Etsetse okwukwo.&gt;<verse eid="MAT 23:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 23:8"/>&lt;&lt;Nghaduu tishi nu ma kwu ema di &lt;Etsetse okwukwo&gt; ba, lubana ema dzɛ yi ongyukwo onyi ta, ema duu li ongwunɔ ewema. <verse eid="MAT 23:8"/><verse number="9" style="v" sid="MAT 23:9"/>Dika kwu inggisɛ onyonyi mi ɛsɛ nɛ di &lt;Otsema&gt; ba, bana ema sulu Otsema Onyi ta, o dzɛ esho. <verse eid="MAT 23:9"/><verse number="10" style="v" sid="MAT 23:10"/>Li ayin ba nu ma kwu ema gbɛɛ &lt;otsetse,&gt; ikyena ema sulu Otsetse Onyi kyoon, o li iMedzaya. <verse eid="MAT 23:10"/><verse number="11" style="v" sid="MAT 23:11"/>Ongwu nshewo ngha mi idzidzɛ mgbi ema ma ka li ongbidɔ mgbi ema. <verse eid="MAT 23:11"/><verse number="12" style="v" sid="MAT 23:12"/>Lubana ali inggisɛ nkyile ewon esho yɔ a ka yilen esɛ, kpaa inggisɛ n yile ewon esɛ yɔ a ka kyilen esho.<verse eid="MAT 23:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13"/>&lt;&lt;Ikamba ikye ema etsetse mgbi ola bɛyi emi iFarasi, ema emi ikpala ntonɛni! Ema tukwu inggisɛ ofɛ okaka esutɔ ongwi esho, ema abuema kpaa kaka ba, ama nle fya okaka ma kpaa ema le nu ma ofɛ okaka ba.<verse eid="MAT 23:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 23:14"/>(&lt;&lt;Ahoo ikye ema, etsetse mgbi ola yi emi iFarasi, ema emi ikpala ntonɛni! Ema li kyɔ emi owakwadɛ ogye di tso osaan mi ibɔ obɔ tunto. Nghanɛ Imgbasho ka kwo ema adɔ kpakpa.&gt;&gt;)<note caller="+" style="f"><char style="fr" closed="false">23:14 </char><char style="ft" closed="false">Ambulu nɛ dzɛ mi olɔɔlɔ angbeka ba.</char></note><verse eid="MAT 23:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15"/>&lt;&lt;Ahoo ikye ema, etsetse mgbi ola yi emi iFarasi, ema emi ikpala ntonɛni! Ema li ga kwo ekyoo okwukwo yi ɛsɛ tsatsa ikye otu inggisɛ onyi ongwu nka kyɛdɔ ema, ni ema wa tun yɔ, ema di li non yɛɛ ongbɛ mgbi udola dzɛ ema wo akpe efa.&gt;&gt;<verse eid="MAT 23:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16"/>&lt;&lt;Ikamba ikye ema, obinɛ ama ngbe inggisɛ teyi! Ema li gbɛɛ, &lt;Ni inggisɛ fa yi ozu okwukwo osunu Imgbasho yɔ li itɔdzɛ ba; kpaa ni inggisɛ fa yi abashi mgbi ozu okwukwo osunu Imgbasho yɔ, o ka kyɔn kyɛmɛ-kyɛmɛ. <verse eid="MAT 23:16"/><verse number="17" style="v" sid="MAT 23:17"/>Ema ikwangha obinɛ ntonɛ! Li ole ngha: abashi, naadi ozu okwukwo osunu Imgbasho ngwi nu abashi yɛɛ saan na? <verse eid="MAT 23:17"/><verse number="18" style="v" sid="MAT 23:18"/>Ema di li gbɛɛ, &lt;Kini inggisɛ fa mi iwashi yɔ li itɔdzɛ ba; kpaa ni inggisɛ fa yi umba ndɔdzɛ ele na yɔ, o ka kyɔn kyɛmɛ-kyɛmɛ.&gt; <verse eid="MAT 23:18"/><verse number="19" style="v" sid="MAT 23:19"/>Ema obinɛ ntonɛ! Li ole ngha: umba na, naadi iwashi ngwi nu umba na yɛɛ saan na? <verse eid="MAT 23:19"/><verse number="20" style="v" sid="MAT 23:20"/>Nghanɛ, inggisɛ nfa yi iwashi yɔ, o fa yi iwashi bɛyi alungwɔ ndɔdzɛ ele duu. <verse eid="MAT 23:20"/><verse number="21" style="v" sid="MAT 23:21"/>Inggisɛ ndi fa yi ozu okwukwo osunu Imgbasho yɔ, o fa mi ele bɛyi Imgbasho ndzɛ ele na kpaa. <verse eid="MAT 23:21"/><verse number="22" style="v" sid="MAT 23:22"/>Inggisɛ nfa mi esho yɔ, o fa mi itsuutɔ mgbi Imgbasho bɛyi ongwu nsɔdzɛ ele nani.<verse eid="MAT 23:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23"/>&lt;&lt;Ahoo ikye ema, etsetse mgbi ola yi emi iFarasi, ema emi ikpala ntonɛni! Ema li nu onyi ikye iwyo mi alungwɔ ama nli nu ungwogye gbungbɛ duu. Nghaduu ema li kye ola nnghao wuuta ma wuuta ba, emyɛmyɛ yi elela odiidi oyɛyɛ okyɔɔkyɔ. Ema ki nghao le kyɔ ama nwuuta ntonɛ duuse angbeka ntonani. <verse eid="MAT 23:23"/><verse number="24" style="v" sid="MAT 23:24"/>Ema obinɛ ama ogbe inggisɛ teyi ntonɛ! Ema li sɛlu imatsɔ mi eni mgbi ema owaawa yangwuta kpaa kye ilakwumyi mbe.<verse eid="MAT 23:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25"/>&lt;&lt;Ikamba mi ikye ema, etsetse mgbi ola yi emi iFarasi, ema emi ikpala ntonɛ! Ema li salu ewo inumbɛɛ yi inunggaa, kpaa mi ifun yɔ li mbwo yi nggwɔ yi ofu. <verse eid="MAT 23:25"/><verse number="26" style="v" sid="MAT 23:26"/>Emi iFarasi ama obinɛ! Teyi kyi salu inumbɛɛ yi inunggaa mi ifun, ta esaan kpaa ka yɛɛ saan.<verse eid="MAT 23:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27"/>&lt;&lt;Ahoo ikye ema, etsetse mgbi ola yi emi iFarasi, ema emi ikpala ntonɛni! Ema dzɛ dafi endzi ngwi a gbon enotse onzundzɛ, ngwi i tishi odiidi mi esɛ kpaa mi ifun yɔ akpukpu mgbi emi ikwukwɔ li mbweele bɛyi alungwɔ ama okpɛkpɛ duu mani. <verse eid="MAT 23:27"/><verse number="28" style="v" sid="MAT 23:28"/>Mi itɔ ofɛ nɛ kpɔɔ, ema li tso inggisɛ gbɛɛ ema le saan kpaa mi idzidzɛ yɔ, ema mbwo yi oshu yi imbali.<verse eid="MAT 23:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29"/>&lt;&lt;Ahoo ikye ema, etsetse mgbi ola yi emi iFarasi, ema emi ikpala ntonɛni! Ema li mbɛ endzi mgbi ama ogbɛɛsɛ diyɛ mɛ endzi mgbi inggisɛ ama osuse ingwinda. <verse eid="MAT 23:29"/><verse number="30" style="v" sid="MAT 23:30"/>Ema di gbɛɛ, &lt;Ni ema ki dzɛ mi onɔ mgbi otsikyema tugbe mayɔ, ema kika wo abɔ mi ikwu mgbi ama ogbɛɛsɛ ba.&gt; <verse eid="MAT 23:30"/><verse number="31" style="v" sid="MAT 23:31"/>Nghanɛ ema kyɔ ewema obwɛndɛ obube dafi ema gbɛɛ di ema li engwiba mgbi ama nngwɔ ama ogbɛɛsɛ mani. <verse eid="MAT 23:31"/><verse number="32" style="v" sid="MAT 23:32"/>Kiyayi ngyɛlu ungwɔ ngwi emi otsikyema wita nani!<verse eid="MAT 23:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 23:33"/>&lt;&lt;Ema ifa! Emi ongwɛ ogidzi ntonɛ! Ema ka kyɔsinɛse ngwi a ka ngwɔ ema ikwɔ ni ema lu udola ba? <verse eid="MAT 23:33"/><verse number="34" style="v" sid="MAT 23:34"/>Nghanɛ ani le kye ama ogbɛɛsɛ yi ama oyodzɛ bɛyi etsetse dɛsɔ nu ema. Angbeka mboma ema ka ngwɔ di gbokwo ma; angbeka yɔ ema ka gbo ma onitse mi ozu okwakye mgbi emi iJuda dika lɔ ma tɔ mi igeli oka lu igeli oka. <verse eid="MAT 23:34"/><verse number="35" style="v" sid="MAT 23:35"/>Ikyenghanɛ, a ka bwa ema mi ikye ikwu mgbi inggisɛ ama osaan ngwu a ngwɔ mi ɛsɛ nɛ duu, wita mi ikwu inggisɛ osaan Ebɛl lu mi ikwu iDzakaria ongwɛ iBɛlɛkia ngwu ema ngwɔ mi idzidzɛ ozu okwukwo osunu Imgbasho bɛyi iwashi ofifɛ nani. <verse eid="MAT 23:35"/><verse number="36" style="v" sid="MAT 23:36"/>N nya ema otsitsi, ungwɔnɛ duu ka dɔ etɔ nɛ ikye.<verse eid="MAT 23:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37"/>&lt;&lt;Ekyi! iJerosalin, iJerosalin, abu nngwɔ ama ogbɛɛsɛ di tsɛ ama ngwu a dɔ ma esɔ mbi abu akwutsɛ nɛ, onɔ kɛ ngwi ani gbili ogbe emi ongwabu kwakye mbonyi dafi onogbi li kwulu engwaan wo asha nɛni, nghaduu abu gbela ba. <verse eid="MAT 23:37"/><verse number="38" style="v" sid="MAT 23:38"/>Dika, a dzata ozu okwukwo mgbi ema osunu Imgbasho yɛɛ okwudɛ waana. <verse eid="MAT 23:38"/><verse number="39" style="v" sid="MAT 23:39"/>Lubana n nya ema, ema ka din wuba se ni ema wa gbɛɛ, &lt;Mse dzɛ yi ongwu nba mi iyi mgbi Otsɛ na se.&gt; &gt;&gt;<verse eid="MAT 23:39"/></para>
  <chapter eid="MAT 23"/>
  <chapter number="24" style="c" sid="MAT 24"/>
  <para style="s1">Ambɛ mgbi ɛsɛ ongyɛɛngyɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1"/>IYesu dzata ozu okwukwo osunu Imgbasho mi iJerosalin le lu imbe oka man engwafɔ mgban gble tun ikye onyan odzɛ idabɔ mgbi ozu nani. <verse eid="MAT 24:1"/><verse number="2" style="v" sid="MAT 24:2"/>O byi ma gbɛɛ, &lt;&lt;Ema di ozu ntonɛ duu wɛ? N nya ema otsitsi a ka wa dzata akwutsɛ onyi kpaa dɔ ikye oka ba; a ka bulu ma duu kwutokɛ esɛ.&gt;&gt; <verse eid="MAT 24:2"/><verse number="3" style="v" sid="MAT 24:3"/>Dafi iYesu sɔdzɛ unggwɔ Olivi nɛ, engwafɔɔn ba mbon fyɛɛ, a gbɛɛ, &lt;&lt;Nya eyi, li alonɔ ngwi ungwɔnɛ ka kyɔ, ma li alungwɔ ka tso ambɛ mgbi obaaba mgbi abu yi mgbi ongyɛɛngyɛ ɛsɛ?&gt;&gt;<verse eid="MAT 24:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4"/>IYesu nu uka gbɛɛ, &lt;&lt;Gbɛwɛbyi saan na, ni inggisɛ wa kpagya ema wo ba. <verse eid="MAT 24:4"/><verse number="5" style="v" sid="MAT 24:5"/>Lubana inggisɛ kwuba ka ba mi iyi mgbi ani, le gbɛɛ, &lt;Ani li iMedzaya,&gt; a dika kpagya inggisɛ kwuba wo. <verse eid="MAT 24:5"/><verse number="6" style="v" sid="MAT 24:6"/>Ema ka fwo ika yi a gbɛɛ mgbi ika, kpaa ka tsaatsa ewo ba na. Itɔ ungwɔ ntonɛ ka kyɔ kyɛmɛ, nghaduu ongyɛɛngyɛ ka kyɛ iyayi. <verse eid="MAT 24:6"/><verse number="7" style="v" sid="MAT 24:7"/>Ɛsɛ oka ka kyɛɛ ika yi ɛsɛ oka, esutɔ oka ka kyɛɛ ika yi esutɔ oka. Obyoyanu (enbwa) yi ɛsɛ osuusu ka dzɛ mi imbe idzidza-dzidza. <verse eid="MAT 24:7"/><verse number="8" style="v" sid="MAT 24:8"/>Ungwɔ ntonɛ duu li owita-wita mgbi isɔ.<verse eid="MAT 24:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9"/>&lt;&lt;Nɛta a ka bwa ema lu ka nu ema isɔ di ngwɔ ema, ɛsɛ duu ka di ema lanyi mi ikye ani. <verse eid="MAT 24:9"/><verse number="10" style="v" sid="MAT 24:10"/>Mi onɔ na inggisɛ kwuba ka yɛyikpa mi oyɛyɛ onuunu yɛ kye ewoma dakwɔ diyɛ di ewoma lanyi, <verse eid="MAT 24:10"/><verse number="11" style="v" sid="MAT 24:11"/>oyegbɔ atsika kwuba ka tɔ di kpagya inggisɛ kwuba wo. <verse eid="MAT 24:11"/><verse number="12" style="v" sid="MAT 24:12"/>Ikyegbɛɛ ali ibwubwe ka wa gbɔfwɛ nɛ, okpitukwu mgbi inggisɛ kwuba ka yuyu, <verse eid="MAT 24:12"/><verse number="13" style="v" sid="MAT 24:13"/>nghaduu inggisɛ nkwulɛsɛ kpɔklɔɔ ba ongyɛɛngyɛ yɔ, o ka watɔ. <verse eid="MAT 24:13"/><verse number="14" style="v" sid="MAT 24:14"/>Esɔ Osuse mgbi esutɔ nɛ a ka gbɔn mi ɛsɛ tsatsa dafi obwɛndɛ mbi ayɛsɛ duu mani, taman ongyɛɛngyɛ mgbi ɛsɛ sika ba.<verse eid="MAT 24:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15"/>&lt;&lt;Onɔ ngwi ema di &lt;Ungwɔ Idza&gt; yɛ wa dzɛ mi ozu okwukwo osunu Imgbasho mi iJerosalin dafi oyegbɔ iDaniɛ teyi gbɔ na yɔ, inggisɛ ogbɔ afɛ no difwi <verse eid="MAT 24:15"/><verse number="16" style="v" sid="MAT 24:16"/>nɛ ama nto mi iJudia duu nu ma tsinya lu unggwɔ.<verse eid="MAT 24:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 24:17"/>Ni inggisɛ onyi ndɔdzɛ endoozu mgban tashulu o wa kye unkonyi tasɛ mi ozu ba. <verse eid="MAT 24:17"/><verse number="18" style="v" sid="MAT 24:18"/>Ni inggisɛ onyi mi okwɔ ka yidɔ kɛ iyikpa oka gbe angwuto mgban ba. <verse eid="MAT 24:18"/><verse number="19" style="v" sid="MAT 24:19"/>Egbe ntona ka li egbe obube kpakpa mbi engyaa emi ifu bɛyi enengwɛ ama nbyi engwɛ abɔ! <verse eid="MAT 24:19"/><verse number="20" style="v" sid="MAT 24:20"/>Bibɔ na, ni onɔ otsinya mgbi ema na no wa li owa hona egbe otonyewo ba. <verse eid="MAT 24:20"/><verse number="21" style="v" sid="MAT 24:21"/>Lubana onɔ na ka li onɔ adzɛ yi omani itɔ ngwi a ta ɛsɛ inose nghataa ba nɛnɛ lu iyayi kpaa a di ye waba mani. <verse eid="MAT 24:21"/><verse number="22" style="v" sid="MAT 24:22"/>Ni Imgbasho ki kye mwalu egbe ntona bayɔ, inggisɛ onyi ki watɔ ba, kpaa mi ikye ama ngwu a plɛ sadulu ma ma yɔ, Imgbasho ka kyi mwalu egbe ntonani. <verse eid="MAT 24:22"/><verse number="23" style="v" sid="MAT 24:23"/>Mi onɔ na ni inggisɛ nya abu gbɛɛ, &lt;Dii, iMedzaya dzana!&gt; Hona, &lt;O dzali!&gt; Ka noyɛyɛ mi ele ba. <verse eid="MAT 24:23"/><verse number="24" style="v" sid="MAT 24:24"/>Lubana Imedzaya atsika yi oyegbɔ emi atsika ka wa gbɔfwɛ di tso ambɛ okwukwo yi ungwɔ ama okwulewo ikye okpagya ama ngwu a sadu ma kpaa wo, ni li kyɛmɛ-kyɛmɛ yɔ. <verse eid="MAT 24:24"/><verse number="25" style="v" sid="MAT 24:25"/>Dika, n plɛ nya ema duuse ni onɔ ma wa gyɔ.<verse eid="MAT 24:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26"/>&lt;&lt;Nghanɛ ni inggisɛ nya ema gbɛɛ, &lt; O tɔ dzɛ imbe okplagada aali,&gt; ka tasɛ ba, hona, &lt;O wodzɛ ifoozu ana,&gt; ka noyɛyɛ mi ele ba. <verse eid="MAT 24:26"/><verse number="27" style="v" sid="MAT 24:27"/>Lubana dafi mmbwo li naabɔ mi onosa ngwi a li di to onɔdɛ nɛ, li ngha ngwi obaaba mgbi Ongwɛ Inggisɛ ka dzɛ aali. <verse eid="MAT 24:27"/><verse number="28" style="v" sid="MAT 24:28"/>Li imbe ngwi ikwɔ la ma ngwi mmpo li kwakye aali.<verse eid="MAT 24:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29"/>&lt;&lt;Ni egbe okakewo okwukwo wa nyɛ gwee taman,</para>
  <para style="pi" vid="MAT 24:29">&lt;&lt; &lt;onɔ ka yifu,</para>
  <para style="pi" vid="MAT 24:29">ofyia kpaa ka fya wuba,</para>
  <para style="pi" vid="MAT 24:29">mcɛ ka yangwuta mi esho,</para>
  <para style="pi" vid="MAT 24:29">a ka su mfye emi esho.&gt;<verse eid="MAT 24:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 24:30"/>&lt;&lt;Mi onɔ na ambɛ mgbi Ongwɛ Inggisɛ ka tɔ mi esho, man ali ayɛsɛ mi ɛsɛ nɛ duu ka nyɛ yi ikwu. A ka di Ongwɛ Inggisɛ kyɛ le ba mi akpa emi esho, yi mfye bɛyi okwɔkwɔ oshewo. <verse eid="MAT 24:30"/><verse number="31" style="v" sid="MAT 24:31"/>O dika dɔ engyesɔ mgban esɔ nu ma fo agba okwukwo kweela, a dika gbe emidan ama ngwu a teyi sa ma ma kwakye mi ayɛsɛ enɛ ntonɛ duu, mi owita-wita mgbi agya esho oka nghataa lu oka.<verse eid="MAT 24:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32"/>&lt;&lt;Onɛnɛ kpayi ozoyeye nɛ mbi andundu na: Labɔlabɔ ngwi abɔn kyinda ngwi afɛ tɔ mi ele mata, ema li ye gbɛɛ akyonova dzɛ kwɛkwɛ wa. <verse eid="MAT 24:32"/><verse number="33" style="v" sid="MAT 24:33"/>Nghanɛ, ni ema di ungwɔ ntonɛ duu, ema li ye gbɛɛ dzɛ kwɛkwɛ yi onufozu wa. <verse eid="MAT 24:33"/><verse number="34" style="v" sid="MAT 24:34"/>N nya ema otsitsi, etɔ nɛ ka nyɛ waba sede ungwɔ ntonɛ ka kyɔ se. <verse eid="MAT 24:34"/><verse number="35" style="v" sid="MAT 24:35"/>Esho yi esɛ ka nyɛ, kpaa elodzɛ mgbi ani ka yama nyɛ ba.<verse eid="MAT 24:35"/></para>
  <para style="s1">Inggisɛ onyi ye egbe hona<optbreak/> obyi ma ba</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36"/>&lt;&lt;Inggisɛ onyi ye odzɛ egbe hona onɔ ma ba, engyesɔ emi esho hona Ongwɛ kpaa ye ba sede li Imgbasho yuon. <verse eid="MAT 24:36"/><verse number="37" style="v" sid="MAT 24:37"/>Dafi ndzɛ nose mi egbe mgbi iNua mani, li ngha nka dzɛ mi obaaba mgbi Ongwɛ Inggisɛ kpaa aali. <verse eid="MAT 24:37"/><verse number="38" style="v" sid="MAT 24:38"/>Lubana duuse ni onikyɔ eni-ayɔ wa ba yɔ inggisɛ tole gye yɛ wa, le kye engyaa dile kye engwɛ nu eba, nghataa ba egbe ngwi iNua kaka uwaa mani; <verse eid="MAT 24:38"/><verse number="39" style="v" sid="MAT 24:39"/>a yama ye ungwɔ onyi nka ba ma esɛ ba nghataa onikyɔ eni-ayɔ wa kyi gbelu ma lu. Li ngha nka wa dzɛ mi obaaba mgbi Ongwɛ Inggisɛ aali. <verse eid="MAT 24:39"/><verse number="40" style="v" sid="MAT 24:40"/>Nɛ inggisɛ efa ka to okwɔ a ka kyi kyelu onyi lu dzata oka. <verse eid="MAT 24:40"/><verse number="41" style="v" sid="MAT 24:41"/>Engyaa efa kale kpinangwɔ mi ikwɔɔ, a ka kyi kyelu onyi lu dzata oka.<verse eid="MAT 24:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42"/>&lt;&lt;Nghanɛ ngyo le fɛ na, lubana ema yama ye egbe ngwi Otsɛ mgbi ema ka yɛ ma ba. <verse eid="MAT 24:42"/><verse number="43" style="v" sid="MAT 24:43"/>Ungwɔnɛ no gbosa lo ema; ni otsungwudɛ ki ye onɔ ngwi emumyi kyɛ le ba mi otu yɔ, o ki ngyo le fɛ, o kika gbela nu ma gbobun ozu kaka ba. <verse eid="MAT 24:43"/><verse number="44" style="v" sid="MAT 24:44"/>Nghanɛ abu kpaa ka wewo dzɛɛdzɛ kyɛmɛ, lubana Ongwɛ Inggisɛ ka yɛ mi onɔ ngwi abu tsɛwɛ ba mani.<verse eid="MAT 24:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45"/>&lt;&lt;Li emɛ tsatso li ongbidɔ oyɛyɛ di kwiinɛ? Li ongwu ongyukwo gbe engbidɔ mi udɛ mgban won abɔ gbɛɛ no le nu ma ungwogye mi onɔ yɛyɛ mani. <verse eid="MAT 24:45"/><verse number="46" style="v" sid="MAT 24:46"/>Ka tɔ tishi lo ongbidɔ na kini ongyukwo mgban yɛ wa tun le kyɔ ngha yɔ. <verse eid="MAT 24:46"/><verse number="47" style="v" sid="MAT 24:47"/>N nya ema otsitsi o ka gbe alungwɔ mgban duu dɔn ubɔ. <verse eid="MAT 24:47"/><verse number="48" style="v" sid="MAT 24:48"/>Kpaa kini ongbidɔ na timbali di nya ewon gbɛɛ, &lt;Ongyukwo mgbi ani ka dzɛ imbe na onɔ ka she,&gt; <verse eid="MAT 24:48"/><verse number="49" style="v" sid="MAT 24:49"/>man wita ogbo engbidɔ emidan ibe, le gye diyɛ wa yi ama ofyɛbyɛ yɔ, <verse eid="MAT 24:49"/><verse number="50" style="v" sid="MAT 24:50"/>Ongyukwo mgbi ongbidɔ na ka yidɔ mi egbe hona onɔ ngwi o ye ba mani. <verse eid="MAT 24:50"/><verse number="51" style="v" sid="MAT 24:51"/>O ka nun adzɛ di kyon wokɛ mbonyi yi emi ikpala, imbe ngwi ikwu otseetse yi aba ogyeegye ka dzɛ mani.<verse eid="MAT 24:51"/></para>
  <chapter eid="MAT 24"/>
  <chapter number="25" style="c" sid="MAT 25"/>
  <para style="s1">Utsa ibidrua iwyo</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1"/>Mi onɔ na esutɔ ongwi esho ka dzɛ dafi ibidrua engwengyaa iwyo ama nkye ipitila mgbi ama kɛ oka kpatsɛ obongyaa ofufɛ mani. <verse eid="MAT 25:1"/><verse number="2" style="v" sid="MAT 25:2"/>Eda mboma li imbuu eda diyɛ kwiinɛ. <verse eid="MAT 25:2"/><verse number="3" style="v" sid="MAT 25:3"/>Imbuu ntona gbe ipitila mgbi ama byi kpaa engyie yɔ a byi ba. <verse eid="MAT 25:3"/><verse number="4" style="v" sid="MAT 25:4"/>Kpaa ama okwiinɛ ntona gbe ipitila bɛyi engyie mi ikpɔkpɔ byi. <verse eid="MAT 25:4"/><verse number="5" style="v" sid="MAT 25:5"/>Obongyaa ofufɛ mbe onɔ obaaba kwuba, man a ndɛ sile mwuna. <verse eid="MAT 25:5"/><verse number="6" style="v" sid="MAT 25:6"/>&lt;&lt;Mi idzidzɛ otu nɛta a wita ogbaakwɔ gbɛɛ, obongyaa ofufɛ kaka wa! Tɔ wa kpatsan na!&gt; <verse eid="MAT 25:6"/><verse number="7" style="v" sid="MAT 25:7"/>Nɛman ibidrua ntona duu kyato una kyile ipitila mgbi ama esho. <verse eid="MAT 25:7"/><verse number="8" style="v" sid="MAT 25:8"/>Emi ikwangha ntona nya ama oyodzɛ gbɛɛ, &lt;Mwa engyie mgbi ema gwee nu eyi na; di ipitila mgbi eyi le myunu.&gt;<verse eid="MAT 25:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 25:9"/>A gbɛɛ, &lt;&lt; &lt;Ei, kaba ka mɛ eyi yi ema ba. Tatase kɛ mbi ama okye engyie gya ka gya mgbi ema na.&gt;<verse eid="MAT 25:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 25:10"/>&lt;&lt;Kpaa dafi a kale kɛɛkɛ ofɛ oka gya engyie nɛta, obongyaa ofufɛ si kaka. Ibidrua ama nwewo ntona si kaka ifun mi imbe oga eba okwokyiikwokyi ma yan. Man a si yile ofɛ tukwu. <verse eid="MAT 25:10"/><verse number="11" style="v" sid="MAT 25:11"/>&lt;&lt;Onɔ gwee ta angbeka ntona kpaa yidɔ. A gbɛɛ, &lt;Ongyukwo! Ongyukwo!&gt; Kwulu eyi ofɛ!&gt; <verse eid="MAT 25:11"/><verse number="12" style="v" sid="MAT 25:12"/>&lt;&lt;Nghaduu o nu uka gbɛɛ, &lt;N nya ema otsitsi, ani ye ema ba.&gt; <verse eid="MAT 25:12"/><verse number="13" style="v" sid="MAT 25:13"/>&lt;&lt;Nghanɛ ngyo le fɛ na, ikyena ema ye egbe hona onɔ ba.<verse eid="MAT 25:13"/></para>
  <para style="s1">Utsa mgbi iwai awuya</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14"/>&lt;&lt;Dika dzɛ dafi inggisɛ nle kɛ agaba, kwu engbidɔ mgban ela gbe okye mgban wo ma abɔ. <verse eid="MAT 25:14"/><verse number="15" style="v" sid="MAT 25:15"/>O nu onyi ma igbe efa yi isule iwyo, oka igbe onyi, oka ma o nun isule iwyo, ali inggisɛ duu dafi mmyɛ mgban mɛ mani. Ta o si lu agaba mgban. <verse eid="MAT 25:15"/><verse number="16" style="v" sid="MAT 25:16"/>Inggisɛ ngbɛ igbe efa yi isule iwyo ma lu akponyi ka kye mgban fashabɔ diyɛ tu igbe efa yi isule iwyo mbwokɛ ele. <verse eid="MAT 25:16"/><verse number="17" style="v" sid="MAT 25:17"/>Li ngha yɛyɛ ngwi ongwu ndzɛ yi igbe onyi na kpaa diyɛ tu onyi mbwokɛ ele aali. <verse eid="MAT 25:17"/><verse number="18" style="v" sid="MAT 25:18"/>Nghaduu ongwu ngbɛ isule iwyo na, ngwi o lu ma jo ka tishɛ mi esɛ kye udza mgbi ongyukwo mgban da mi ele. <verse eid="MAT 25:18"/><verse number="19" style="v" sid="MAT 25:19"/>Onɔ wa kɛ gblɔgɔdɔ nɛ ongyukwo mgbi engbidɔ ntona yɛ wa kyɔ okwakye yi ama mi odzɛ mmya mani. <verse eid="MAT 25:19"/><verse number="20" style="v" sid="MAT 25:20"/>Inggisɛ ngbɛ igbe efa yi isule iwyo na di kye igbe efa yi isule iwyo mbwokɛ ele wa gbɛɛ, &lt;Ongyukwo, abu nu ani oyɛyɛ yi igbe efa yi isule iwyo. Dii, n tu igbe efa yi isule iwyo mbwo ikyen aana.&gt; <verse eid="MAT 25:20"/><verse number="21" style="v" sid="MAT 25:21"/>&lt;&lt;Ongyukwo mgban gbɔ nyan gbɛɛ, &lt;N nuu abɔ, ongbidɔ osuse oyɛyɛ! Ngwi abu tso oyɛyɛ mi ungwɔ ogwee nɛ, n ka nu abu gbinɛbyi ani ungwɔ kwuba. Ba wa tsatsa yi ongyukwo mgbi abu!&gt; <verse eid="MAT 25:21"/><verse number="22" style="v" sid="MAT 25:22"/>&lt;&lt;Inggisɛ ngwu o nun igbe onyi na kpaa ba. O gbɛɛ, &lt;Ongyukwo, Abu nu ani oyɛyɛ yi igbe onyi; dii, n tu onyi mbwokɛ ele aana.&gt; <verse eid="MAT 25:22"/><verse number="23" style="v" sid="MAT 25:23"/>&lt;&lt;Ongyukwo mgban nyan gbɛɛ, &lt;N nuu abɔ, ongbidɔ osuse oyɛyɛ! Ngwi abu tso oyɛyɛ mi ungwɔ ogwee nɛ; n ka nu abu gbinɛbyi ani ungwɔ kwuba. Ba wa tsatsa yi ongyukwo mgbi abu!&gt; <verse eid="MAT 25:23"/><verse number="24" style="v" sid="MAT 25:24"/>&lt;&lt;Ta inggisɛ ongwu ngbɛ isule iwyo na ba. O gbɛɛ, &lt;Ongyukwo, ani teyi ye dafi abu li inggisɛ ofyumfye ali mani, abu li shɛ mi imbe ngwi abu kya ba di li gbe ngwikwo mi imbe ngwi abu fwe etɔ ba mani. <verse eid="MAT 25:24"/><verse number="25" style="v" sid="MAT 25:25"/>Nghanɛ ani mio tasɛ lu ka kye awuya mgbi abu da mi esɛ. Dii, ungwɔɔ dzani.&gt; <verse eid="MAT 25:25"/><verse number="26" style="v" sid="MAT 25:26"/>&lt;&lt;Ongyukwo mgban nun uka gbɛɛ, &lt;Abu ongbidɔ ntimbali di wo ewewa nɛ! Ngwi abu plɛ ye gbɛɛ ani li shɛ mi imbe ngwi ani kya ba, di li gbe ngwikwo mi imbe ngwi ani fwe etɔ ba nɛ, <verse eid="MAT 25:26"/><verse number="27" style="v" sid="MAT 25:27"/>i tishi se waali, abu ki kye ani udza da mi ozu awuya, ikyegbɛɛ nin wa yɛ yɔ, n ki dulu udza mgbɛn yi eni owaawa. <verse eid="MAT 25:27"/><verse number="28" style="v" sid="MAT 25:28"/>&lt;&lt; &lt;Gbɛlu isule iwyo na mbon na di yilen nu ongwu ndzɛ yi igbe efa yi isule iwyo nani. <verse eid="MAT 25:28"/><verse number="29" style="v" sid="MAT 25:29"/>Lubana ali inggisɛ nsulun yɔ a ka mbwon ele, o dika sulun dzii. Ali inggisɛ nsulun bayɔ, ungwɔ ngwi o sulun ma kpaa a ka kyi gbɛlun ele. <verse eid="MAT 25:29"/><verse number="30" style="v" sid="MAT 25:30"/>Di kye ayayi ongbidɔ na ngwuta lu esɛ, mi iifu, imbe ngwi ikwu otseetse yi aba ogyeegye ka dzɛ mani.&gt;<verse eid="MAT 25:30"/></para>
  <para style="s1">Mmala bɛyi mndɔ</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31"/>Onɔ ngwi Ongwɛ Inggisɛ ka ba mi okwɔkwɔ mgban yi engyesɔ duu yan ma, o ka sɔ itsuutɔ mgban mi okwɔkwɔ ongwi esho. <verse eid="MAT 25:31"/><verse number="32" style="v" sid="MAT 25:32"/>Ɛsɛ duu ka kwakye mi iyayi mbon, ta o ka kyi ghalu inggisɛ yi ewoma dafi inggisɛ ongyo ifyungwɔ li kyi ghalu mmala yi mndɔ nɛni. <verse eid="MAT 25:32"/><verse number="33" style="v" sid="MAT 25:33"/>O ka gbe mmala tokɛ abugye di gbe mndɔ tokɛ abubɛ. <verse eid="MAT 25:33"/><verse number="34" style="v" sid="MAT 25:34"/>&lt;&lt;Ta utɔ ka gbɔ yi ama nto mi abugye ma gbɛɛ, &lt;Ba na, ema ngwu Otsani kye mse bɛ ema ewo ntonɛni; gyokwudɛ mgbi ema na, esutɔ ngwi a kyi mɛlu dzɛkɛ ikye ema wita mi onɔ ngwi a ta ɛsɛ mani. <verse eid="MAT 25:34"/><verse number="35" style="v" sid="MAT 25:35"/>Lubana enbwa dɔ ani ema nin ungwɔ nin gye, ekweni kwin ema di nin ungwɔ nin wa, ani li ingyoga ema di gbɛ ani, <verse eid="MAT 25:35"/><verse number="36" style="v" sid="MAT 25:36"/>ibiba angwuto kwin ema ten angwuto, ootse dɛn ema gbeka byin, n wo obawi ema di wa kpadi ani.&gt; <verse eid="MAT 25:36"/><verse number="37" style="v" sid="MAT 25:37"/>Ta ama onyaan ka nun uka gbɛɛ, &lt;Otsɛ li engga ngwi eyi di abu dzɛ enbwa se byi abu enbwa, hona kwu ekweni di kye ungwɔ nu abu wa? <verse eid="MAT 25:37"/><verse number="38" style="v" sid="MAT 25:38"/>Li engga ngwi abu li ingyoga se eyi gbɛ abu, naadi dzɛ ibiba angwuto se to abu angwuto? <verse eid="MAT 25:38"/><verse number="39" style="v" sid="MAT 25:39"/>Li alonɔ ngwi eyi di abu dotse hona wo obawi se ka kpadi abu? <verse eid="MAT 25:39"/><verse number="40" style="v" sid="MAT 25:40"/>Utɔ na ka nu uka gbɛɛ, &lt;N nya ema otsitsi, alungwɔ ngwi ema kyɔ yi inggisɛ onyi ama ngwu i nghama ewo mi idzidzɛ emi ongwunani ntonɛ yɔ, li ani ngwu ema kyɔ yi ani. <verse eid="MAT 25:40"/><verse number="41" style="v" sid="MAT 25:41"/>Ta o sika nya ama nto mi abubɛ mgban ntona gbɛɛ, &lt;Noofɛ mmɛnɛ na, ema ama a wo ema ikamba nɛ, lu ifu ola ngwi a mɛwo ikye olodu yi engyesɔ mgban nani. <verse eid="MAT 25:41"/><verse number="42" style="v" sid="MAT 25:42"/>Lubana enbwa dɛn kpaa ema nin unkonyi nin gye ba, ekweni kwin kpaa ema nin unkonyi nin wa ba, <verse eid="MAT 25:42"/><verse number="43" style="v" sid="MAT 25:43"/>n li ingyoga kpaa ema gbɛn ba, ibiba angwuto kwin kpaa i ten angwuto ba, n dotse di wodzɛ obawi kpaa i gbeka byin ba.&gt; <verse eid="MAT 25:43"/><verse number="44" style="v" sid="MAT 25:44"/>&lt;&lt;Ama kpaa ka byita gbɛɛ, &lt;Otsɛ, li alonɔ ngwi eyi di enbwa naadi ekweni kwu abu, hona li ingyoga hona dzɛ ibiba angwuto naadi dotse hona wo obawi, se ya abu abɔ ba? <verse eid="MAT 25:44"/><verse number="45" style="v" sid="MAT 25:45"/>&lt;&lt;O ka nu uka gbɛɛ, &lt;N nya ema otsitsi, ekyɛɛkyɛ ngwi ema kyɔ yi inggisɛ onyi mi idzidzɛ ama ngwu i ngha ma ewo ntonɛ ba duu, li ani ngwu ema kyɔ yi ani ba aali. <verse eid="MAT 25:45"/><verse number="46" style="v" sid="MAT 25:46"/>&lt;&lt;Ta a sika yɛ atata lu mi adɔ okwookwo ogyegwu, nghaduu ama onyaan ntona sika kaka oshishe ogyegwu.&gt;&gt;<verse eid="MAT 25:46"/></para>
  <chapter eid="MAT 25"/>
  <chapter number="26" style="c" sid="MAT 26"/>
  <para style="s1">A wibu iYesu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1"/>Ngwi iYesu gbɔdzɛ ntonɛ ngyɛ duu nɛ, o nya engwafɔɔn gbɛɛ, <verse eid="MAT 26:1"/><verse number="2" style="v" sid="MAT 26:2"/>&lt;&lt;Dafi ema ye gbɛɛ oga owɛ owatɔ-watɔ mgbi emi Israi sisi egbe efa nɛ, a ka kye Ongwɛ Inggisɛ wo engyikyili abɔ nu ma gbokwon ngwɔn.&gt;&gt;<verse eid="MAT 26:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3"/>Nɛ engyukwo ama ofifɛ yi emi obɔtsɛ mgbi ama kwakye mi udɛ okwukwo inggisɛ ofifɛ, ngwu iyin di iKayafa mani, <verse eid="MAT 26:3"/><verse number="4" style="v" sid="MAT 26:4"/>a si tsɛwɛ obwa iYesu daada lu ka ngwɔn. <verse eid="MAT 26:4"/><verse number="5" style="v" sid="MAT 26:5"/>A gbɛɛ, &lt;&lt;nghaduu no ka li mi onɔ oga ba, kpakpana inggisɛ ntona ka kyɔ ablodzɛ.&gt;&gt;<verse eid="MAT 26:5"/></para>
  <para style="s1">A kye engyie kyi iYesu ikye mi iBetani</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6"/>Ngwi iYesu ka dzɛ iBetani mi udɛ iSaimɔn inggisɛ otsoma nɛ, <verse eid="MAT 26:6"/><verse number="7" style="v" sid="MAT 26:7"/>ongyaa ba mbon yi ikpɔkpɔ alabasta ogbungbɛ nfyumfyummya kpakpa, wa kye yawon ikye ngwi o kwodzɛ ongongo mi ewo adinyatsɛ.<verse eid="MAT 26:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 26:8"/>Dafi engwafɔ iYesu di ungwɔnɛ nɛ, itingga kyɔ ma. A byita gbɛɛ, &lt;&lt;Li ali engyie ombeembe ngha?&gt;&gt; <verse eid="MAT 26:8"/><verse number="9" style="v" sid="MAT 26:9"/>&lt;&lt;A ki kye engyie nɛ gya mi mmya okwukwo kye awuya na nu emi adzɛ.&gt;&gt;<verse eid="MAT 26:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10"/>Ngwi iYesu ye ungwɔnɛ nɛ, o gbɔ yi ama gbɛɛ, &lt;&lt;Kyɔnɛ ngwi ema le nu ongyaa nɛ okakewo? O kyungwɔ nsunse yi ani. <verse eid="MAT 26:10"/><verse number="11" style="v" sid="MAT 26:11"/>Emi adzɛ ka dzɛ yi ema alonɔ duu, kpaa ani ka dzɛ yi ema alonɔ duu ba. <verse eid="MAT 26:11"/><verse number="12" style="v" sid="MAT 26:12"/>Onɔ ngwi o kye engyie ogbungbɛ nɛ kyi ani ewo na, o kyɔn ikye omɛlu ani ni a wa kye ani ndzi. <verse eid="MAT 26:12"/><verse number="13" style="v" sid="MAT 26:13"/>N nya ema otsitsi, ali imbe ngwi a gbɔ Esɔ Osuse nɛ mi ɛsɛ olɔlɔ duu, ungwɔ ngwi o kyɔ nɛ kpaa a ka gbɔn, ikye owɛ odzɛ mgban.&gt;&gt;<verse eid="MAT 26:13"/></para>
  <para style="s1">IJuda gbela okye iYesu gya</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14"/>Nɛ onyi mbi emi iwyodefa ntona, ongwu a li kwun di iJuda Iskarɔti, kɛ mbi engyukwo ama ofifɛ <verse eid="MAT 26:14"/><verse number="15" style="v" sid="MAT 26:15"/>ka byita gbɛɛ, &lt;&lt;Ni ani kyon wo ema abɔ ma li ekyɛ ngwi ema weka onu ani?&gt;&gt; Nɛta a kyi gbɔlu isule osudiwyo kye nun. <verse eid="MAT 26:15"/><verse number="16" style="v" sid="MAT 26:16"/>Wita mi onɔ na iJuda le pita ofɛ ni ongwu kyon wo ma abɔ.<verse eid="MAT 26:16"/></para>
  <para style="s1">Ungwogye mgbi Otsɛ ongwi olɛlɛ</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17"/>Mi egbe ongwi ababɔ mgbi oga ibredi ngwi a kye okwuna wele ba ma, emi ongwafɔ iYesu ba mbon wa byita gbɛɛ, &lt;&lt;Li mi ole ngwi abu mina gbɛɛ ni eyi mɛ abu imbe ni abu wa gye oga owɛ owatɔ-watɔ mgbi emi Israi?&gt;&gt;<verse eid="MAT 26:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18"/>O nya ma gbɛɛ, &lt;&lt;Kɛ mbi inggisɛ oka mi ifu ogalu ka nyan gbɛɛ, &lt;Otsetse gbɛɛ: onɔ ngwi a kye dzɛ ani ma dzɛ kwɛkwɛ. N ka ka gye oga owɛ owatɔ-watɔ mgbi emi Israi mi udɛ abu yi engwafɔ mgbi ani.&gt; &gt;&gt; <verse eid="MAT 26:18"/><verse number="19" style="v" sid="MAT 26:19"/>Nghanɛ engwafɔ ntona si kyɔ dafi iYesu tso ma mani man a si wewo oga owɛ owatɔ-watɔ mgbi emi Israi.<verse eid="MAT 26:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20"/>Ngwi onɔ gbɛsɛ nɛ, iYesu kwo ongongo le gye ungwogye mi adinyatsɛ yi emidan iwyodefa ntonani. <verse eid="MAT 26:20"/><verse number="21" style="v" sid="MAT 26:21"/>Ngwi a le gye ungwogye nɛ, o gbɛɛ, &lt;&lt;N nya ema otsitsi, onyi mbi ema ka kye ani gya.&gt;&gt;<verse eid="MAT 26:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22"/>Engwafɔɔn si yɛɛ elela wita ogbɔ yan onyonyi gbɛɛ, &lt;&lt;Otsɛ, mi otsitsi li ani ba lɔ?&gt;&gt;<verse eid="MAT 26:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23"/>IYesu nu uka gbɛɛ, &lt;&lt;Li onyi mi idzidzɛ ema nle gye ungwogye yi ani nɛ ka kye ani gya. <verse eid="MAT 26:23"/><verse number="24" style="v" sid="MAT 26:24"/>Ongwɛ Inggisɛ ka lu dafi Afɛ lɔ ikyon ma yɛyɛ. Kpaa ahoo mi ikye inggisɛ nkye Ongwɛ Inggisɛ gya mani! Tatase a ki mban ba.&gt;&gt;<verse eid="MAT 26:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25"/>Nɛ iJuda nka kyon gya ma gbɛɛ, &lt;&lt;Otsetse, mi otsitsi li ani ba lɔ?&gt;&gt; IYesu nu uka gbɛɛ, &lt;&lt;O gbɔ wali.&gt;&gt;<verse eid="MAT 26:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26"/>Ngwi a le gye ungwogye nɛ, iYesu kyi kyelu ibredi, kye angba nu Imgbasho man kye mwalu, di kye nu engwafɔ mgban, gbɛɛ, &lt;&lt;Gbɛ gye na; nɛnɛ li ewo mgbi ani.&gt;&gt;<verse eid="MAT 26:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27"/>Nɛ o kyi kyelu ibwɛ yi eneekwɔ mi ele, kye angba nu Imgbasho di kye nu ma, si gbɛɛ, &lt;&lt;Ema duu, wa na. <verse eid="MAT 26:27"/><verse number="28" style="v" sid="MAT 26:28"/>Nɛnɛ li eyi mgbi ani mgbi ondu odzɛɛdzɛ, ngwi a kye kyi ikye okye ali ibwubwe ta ibyi inggisɛ mkpa. <verse eid="MAT 26:28"/><verse number="29" style="v" sid="MAT 26:29"/>N nya ema, wita onɛnɛ nghataa lu iyayi n ka weni awawa ekwɔ nɛ wuba nghataa ba egbe ngwi ani ka wa wan ofufɛ yi ema mi esutɔ mgbi Otsani mani.&gt;&gt;<verse eid="MAT 26:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30"/>Onɔ ngwi a shashi onyi otsɛ Imgbasho ngyɛ nɛ, a tasɛ lu unggwɔ olivi.<figure style="fig" alt="Ungwogye mgbi Otsɛ ongwi olɛlɛ" file="CN01803B.TIF" size="col" loc="26;30" copy="Cooks" ref="26:30">The last supper</figure><verse eid="MAT 26:30"/></para>
  <para style="s1">IYesu teyi gbɔ angwɛ ota-ta <optbreak/> mgbi iPyita</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31"/>Ta iYesu nya ma gbɛɛ, &lt;&lt;Mi otu inɛ nɛni ema duu ka yɛyikpa mi ikye odzɛ ani, lubana Afɛ lɔ gbɛɛ: &lt;&lt; &lt;N ka kwudɔwo inggisɛ ongyo ifyungwɔ, man ifyungwɔ mmala ka ganya.&gt;<verse eid="MAT 26:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 26:32"/>Nghaduu onɔ ani wa kyato yɔ, n ka teyi ema lu iGalalia.&gt;&gt;<verse eid="MAT 26:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33"/>IPyita nyan gbɛɛ, &lt;&lt;Ni inggisɛ duu yɛyikpa mi ikye odzɛ abu kpaa, ani ka yɛ ba.&gt;&gt;<verse eid="MAT 26:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34"/>IYesu gbɔ yi iPyita gbɛɛ, &lt;&lt;N nya abu otsitsi, mi otu inɛ nɛni, duuse ni ogbigbi teela, abu ka tangwɛ ani akpe eta.&gt;&gt;<verse eid="MAT 26:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35"/>Nghaduu iPyita biibɛ gbɛɛ, &lt;&lt;Yeba ni ani ka kwulu yi abu kpaa, n ka tangwɛ abu ba.&gt;&gt; Man engwafɔ angbeka ntona kpaa gbɔ elodzɛ onyi.<verse eid="MAT 26:35"/></para>
  <para style="s1">IYesu bibɔ mi iGesemani</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36"/>IYesu kɛ imbe ngwi a li kwun di iGesemani yi engwafɔ mgban, o si nya ma gbɛɛ, &lt;&lt;Sɔ mmɛnɛ na, ni ani kɛ mmana ka bibɔ.&gt;&gt; <verse eid="MAT 26:36"/><verse number="37" style="v" sid="MAT 26:37"/>O kye iPyita yi emi ongwɛ iDzebedi nghi efa wafɔ yan, o kyelela saan di dzɛ mi okakewo. <verse eid="MAT 26:37"/><verse number="38" style="v" sid="MAT 26:38"/>O nya ma gbɛɛ, &lt;&lt;Ani kyelela she jo kɛ ikwongye kpaa. Dzɛ mmɛnɛ, di ngyo yi ani na.&gt;&gt;<verse eid="MAT 26:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39"/>Ngwi o gblekɛ iyayi gwee nɛ, o lakɛ esɛ kye inɛ tukwu esɛ bibɔ gbɛɛ, &lt;&lt;Otsani, ni li kyɛmɛ yɔ, kyi kyelu ibwɛ adzɛ nɛ mbi ani. Nghaduu no ka li oweka mgbi ani ba, kpaa oweka mgbi abu no kyɔ.&gt;&gt;<verse eid="MAT 26:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40"/>Nɛ o yidɔ luba mbi engwafɔɔn si wa di ma le nuna. O byi iPyita gbɛɛ, &lt;&lt;Ema ka yagba ngyo yi ani mi obyi onyi kpaa lo? <verse eid="MAT 26:40"/><verse number="41" style="v" sid="MAT 26:41"/>&lt;&lt;Ngyo di bibɔ ikye ni ema ka gbɛsɛ mi imbadi ba mani. Onodzi le mina, kpaa ewo yɔ dzatsi.&gt;&gt;<verse eid="MAT 26:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42"/>O diyɛ lu akpe ongwu fan ka bibɔ gbɛɛ, &lt;&lt;Otsani, ni li kyɛmɛ okyelu ibwɛ adzɛ nɛ ba, se ni ani wan yɔ, owitukwu mgbi abu no kyɔ.&gt;&gt;<verse eid="MAT 26:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 26:43"/>Ngwi o di yɛ nɛ, o di tu ma le nuna, ikyekyɛ akwukwinɛ mgbi ama sundo. <verse eid="MAT 26:43"/><verse number="44" style="v" sid="MAT 26:44"/>Nghanɛ o diyɛ dzɛ ma ta kpɔɔ dika bibɔ akpe ongwu ta, le gbɔ elodzɛ na kpɔɔ.<verse eid="MAT 26:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 26:45"/>O yɛ ba mbi engwafɔ mgban di gbɔ yi ama gbɛɛ, &lt;&lt;Ema kale nuna dile tonya maa? Dii, obyi ma dzɛ kwɛkwɛ, ngwi a ka kye Ongwɛ Inggisɛ wo emi ibwubwe abɔ wa. <verse eid="MAT 26:45"/><verse number="46" style="v" sid="MAT 26:46"/>Kyato, i kɛ na! Inggisɛ nkye ani gya ma o dzɛ na!&gt;&gt;<verse eid="MAT 26:46"/></para>
  <para style="s1">A bwa iYesu</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47"/>Ngwi o kale gbɔdzɛ nɛ, iJuda, onyi mbi emi iwyodefa ntona, wa to. Ibyi inggisɛ byi okwusunkli bɛyi okwuta ama osundo kyɛ yan kyɛ, ngwi li engyukwo ama ofifɛ bɛyi emi obɔtsɛ mgbi ama dɔ ma esɔ. <verse eid="MAT 26:47"/><verse number="48" style="v" sid="MAT 26:48"/>IJuda nkyon gya na teyi bwondu yi ama gbɛɛ: &lt;&lt;Ongwu ani kye ondu kwon ataka ma li ongyulɔ ma aali; bwan na.&gt;&gt; <verse eid="MAT 26:48"/><verse number="49" style="v" sid="MAT 26:49"/>IJuda kwɔkɛ mbi iYesu akponyi, si gbɛɛ, &lt;&lt;N tangba, Otsetse!&gt;&gt; Man kye ondu kwon ataka.<verse eid="MAT 26:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50"/>IYesu nyan gbɛɛ, &lt;&lt;Oya, kyungwɔ abu ba ikyon mani.&gt;&gt; Ta inggisɛ ntona gbleba, dzɛ iYesu wo bwan. <verse eid="MAT 26:50"/><verse number="51" style="v" sid="MAT 26:51"/>Labɔlabɔ nɛta, emidi iYesu onyi kye ngwalu okwusunkli mgban kye kwɔdzɛ ongbidɔ mgbi okwukwo inggisɛ ofifɛ adɔ.<verse eid="MAT 26:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 26:52"/>IYesu nyan gbɛɛ, &lt;&lt;Yile okwusunkli mgbi abu wokɛ mbi ikwukwun, ikyesinɛ ama nngwa okwusunkli duu ka kwulu mi okwusunkli. <verse eid="MAT 26:52"/><verse number="53" style="v" sid="MAT 26:53"/>Ema tsɛwɛ gbɛɛ ani ka kwu Otsani ela, ta o ka byakpa gbe engyesɔ ngha obyi<note caller="+" style="f"><char style="fr" closed="false">26:53 </char><char style="ft" closed="false">Obyi ongyesɔ onyi li engyesɔ idubu egyin.</char></note> engyesɔ iwyodefa dɛsɔ nu ani lo? <verse eid="MAT 26:53"/><verse number="54" style="v" sid="MAT 26:54"/>Nghama ka kyɔsinɛse ngwi Afɛ ngbɛɛ ungwɔnɛ ka kyɔ mi itɔ ofɛ nɛ kyɛmɛ na mbwumbwo?&gt;&gt;<verse eid="MAT 26:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55"/>Mi onɔ na iYesu gbɔ yi ibyi inggisɛ ntona gbɛɛ, &lt;&lt;Ani gbe ama onghaadɔ teyi se, ngwi ema kyɛ yi okwusunkli bɛyi okwuta ama osundo owa bwa anii? Alegbe ani li sɔ akangga ozu okwukwo osunu Imgbasho mi iJerosalin le tsungwɔ kpaa ema bwa ani ba. <verse eid="MAT 26:55"/><verse number="56" style="v" sid="MAT 26:56"/>Nghaduu ungwɔnɛ kyɔ ikye ni ungwɔ ngwi ama ogbɛɛsɛ lɔ ma mbwumbwo.&gt;&gt; Nɛta engwafɔ mgbi iYesu duu dzanta tsinya lu.<verse eid="MAT 26:56"/></para>
  <para style="s1">IYesu mi inai okwakye</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57"/>Ama nbwa iYesu ma kyon kɛ mbi iKayafa, okwukwo inggisɛ ofifɛ, imbe ngwi etsetse mgbi ola bɛyi engyukwo kwakye mani. <verse eid="MAT 26:57"/><verse number="58" style="v" sid="MAT 26:58"/>Nghaduu iPyita kyan iyikpa mbombo, nghataa kaka ifyudɛ okwukwo inggisɛ ofifɛ. O kaka ka sisɛ yi ama ongyoongyo ntona ikye odi ungwɔ nka kiyayi mani.<verse eid="MAT 26:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="MAT 26:59"/>Engyukwo ama ofifɛ bɛyi okwakye duu le pita itɔdzɛ atsika ni ama kye abɔ byi ele ngwɔ iYesu. <verse eid="MAT 26:59"/><verse number="60" style="v" sid="MAT 26:60"/>Ama okyɔ obwɛndɛ atsika kwuba tɔ ba esɛ, nghaduu a tu itɔdzɛ onyi ba, owa ngyɛ-ngyɛ inggisɛ efa tɔ ba <verse eid="MAT 26:60"/><verse number="61" style="v" sid="MAT 26:61"/>wa gbɛɛ, &lt;&lt;Inggisɛ nɛ gbɛɛ, &lt;Ani ka yagba kyi gbobu ozu okwukwo osunu Imgbasho mi iJerosalin di yilen mbɛ mi egbe eta.&gt; &gt;&gt;<verse eid="MAT 26:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62"/>Nɛ okwukwo inggisɛ ofifɛ kyato di byi iYesu gbɛɛ, &lt;&lt;Abu ka nu uka mi odzɛ ngwi a le gbɔ kwu iyi abu nɛ lo?&gt;&gt; <verse eid="MAT 26:62"/><verse number="63" style="v" sid="MAT 26:63"/>Kpaa iYesu dzɛ shili. Okwukwo inggisɛ ofifɛ na nyan gbɛɛ, &lt;&lt;Ani gbabɔ nu abu mi iyi mgbi Imgbasho ndzɛ oshishe nani: Nya eyi ni abu li iMedzaya, Ongwɛ Imgbasho ma yɔ.&gt;&gt;<verse eid="MAT 26:63"/></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64"/>IYesu gbɛɛ, &lt;&lt;Ɛɛn, dafi abu gbɔ mani. Kpaa n nya ema duu gbɛɛ naa: Mi iyayi ema ka di Ongwɛ Inggisɛ sɔdzɛ abugye mgbi Ongwu nngha yi mfye kyɛ akpa mi esho.&gt;&gt;<verse eid="MAT 26:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65"/>Nɛta okwukwo inggisɛ ofifɛ na si fawa ewon angwuto di gbɛɛ, &lt;&lt;O fya Imgbasho ito! Kyɔsinɛ ngwi eyi dika mina obwɛndɛ angbeka? Dika, onɛnɛ ema fwo ito nɛni. <verse eid="MAT 26:65"/><verse number="66" style="v" sid="MAT 26:66"/>Ema tsɛwɛ sinɛ?&gt;&gt; A gbɛɛ, &lt;&lt;O mɛ ondu ikwongye.<verse eid="MAT 26:66"/></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67"/>Nɛta a kyanggwɔ kyin inɛ di gbon. Angbeka tan afɛ <verse eid="MAT 26:67"/><verse number="68" style="v" sid="MAT 26:68"/>di gbɛɛ, &lt;&lt;Yegbɔ nya eyi ka, abu iKrestu. Li emɛ kwudɔwo abu okwuta?&gt;&gt;<verse eid="MAT 26:68"/></para>
  <para style="s1">IPyita tangwɛ iYesu</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69"/>Mi onɔ na iPyita sɔdzɛ ifyudɛ utɔ, man ongwongyiidɔ ba mbon. O gbɛɛ, &lt;&lt;Abu kpaa li onyi mbi ama nkyɛ yi iYesu ongwi iGalalia.&gt;&gt;<verse eid="MAT 26:69"/></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70"/>Kpaa iPyita tangwɛ mi inai ma duu. O gbɛɛ, &lt;&lt;Ani ye odzɛ ngwi abu le gbɔ na ba.&gt;&gt;<verse eid="MAT 26:70"/></para>
  <para style="p">
    <verse number="71" style="v" sid="MAT 26:71"/>Nɛ o tasɛ lu onufoka, imbe ngwi ongwongyaa oka din di nya inggisɛ ama nto mmana ma gbɛɛ, &lt;&lt;Inggisɛ nɛ dzɛ yi iYesu ongwi iNadzareti.&gt;&gt;<verse eid="MAT 26:71"/></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72"/>O di tangwɛ, yi ofaafa gbɛɛ: &lt;&lt;Ani ye inggisɛ na ba!&gt;&gt;<verse eid="MAT 26:72"/></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73"/>I kye onɔ bwee nɛ, ama nto mmana ma kɛ mbi iPyita ka gbɛɛ, &lt;&lt;Mi otsitsi abu li onyi mboma, ikyesinɛ ela mgbi abu mi ikye kye abu gya.&gt;&gt;<verse eid="MAT 26:73"/></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74"/>Ta o si wita owo ewon ikamba di fa gbɛɛ, &lt;&lt;Ani ye inggisɛ na ba!&gt;&gt; Labɔlabɔ mata ogbigbi si teela. <verse eid="MAT 26:74"/><verse number="75" style="v" sid="MAT 26:75"/>Man iPyita wɛ elodzɛ ngwi iYesu teyi gbɔ yan mani gbɛɛ: &lt;&lt;Duuse ni ogbigbi teela, abu ka tangwɛ ani akpe eta.&gt;&gt; Ta o tasɛ ka tsukwu kpakpa.<verse eid="MAT 26:75"/></para>
  <chapter eid="MAT 26"/>
  <chapter number="27" style="c" sid="MAT 27"/>
  <para style="s1">IJuda kye ewon widɔkwɔ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1"/>Mi egbegbe byibyiibyi, engyukwo ama ofifɛ mgbi Imgbasho bɛyi engyukwo emi ɛsɛ na duu bwalu ondu okyi ngwɔlu iYesu. <verse eid="MAT 27:1"/><verse number="2" style="v" sid="MAT 27:2"/>A bwan adi, kyon lu ka nu mi abɔ mgbi iPlatu, iGɔna mani.<verse eid="MAT 27:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3"/>Mi onɔ ngwi iJuda, ongwu nkyon gya na, di gbɛɛ iYesu le lu ondu ikwu nɛ, itukwu mgban kyata man o yile isule osudiwyo na lu ka nu engyukwo ama ofifɛ bɛyi engyukwo mgbi emi iJuda. <verse eid="MAT 27:3"/><verse number="4" style="v" sid="MAT 27:4"/>O gbɛɛ, &lt;&lt;Ani kyungwɔ obube, dafi ani kye inggisɛ nkyɔ obube ye ba gya mani.&gt;&gt;</para>
  <para style="p" vid="MAT 27:4">A nun uka gbɛɛ, &lt;&lt;Mgbi eyi dikyɛ? Nana li okakewo mgbi abu,&gt;&gt;<verse eid="MAT 27:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5"/>Nghanɛ iJuda kye udza na fwe toma kɛ ozu okwukwo osunu Imgbasho mi iJerosalin man lu. Ta o si lu ka kye ewon widɔkwɔ.<verse eid="MAT 27:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6"/>Engyukwo ama ofifɛ mgbi Imgbasho kye salu isule ntonani si gbɛɛ, &lt;&lt;Li ola ba okye udza nɛ wokɛ imu mgbi eyi, bana li udza eyi.&gt;&gt; <verse eid="MAT 27:6"/><verse number="7" style="v" sid="MAT 27:7"/>Nghanɛ a gbela okye udza na gya ikpɛsɛ yi inggisɛ ombɛ ishe no li imbe ogbe ingyoga ndzi mi ele. <verse eid="MAT 27:7"/><verse number="8" style="v" sid="MAT 27:8"/>Li ikyengha ngwi a li kwu imbe na gbɛɛ ikpɛsɛ mgbi eyi nghataa ba inɛ aani. <verse eid="MAT 27:8"/><verse number="9" style="v" sid="MAT 27:9"/>Ta odzɛ ngwi Oyegbɔ iJeremia gbɔ ma mbwumbwo gbɛɛ: &lt;&lt;A kyi salu isule osudiwyo ntonani, mmya ngwi emi Israi gbela kpa mi ikye iYesu mani, <verse eid="MAT 27:9"/><verse number="10" style="v" sid="MAT 27:10"/>man a kye udza ma gya ikpɛsɛ yi inggisɛ ombɛ ishe, dafi Otsɛ Imgbasho teyi wo ani ola mani.&gt;&gt;<verse eid="MAT 27:10"/></para>
  <para style="s1">IPlatu byi iYesu ita</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11"/>Mi onɔ na iYesu kwudzɛ iyayi iGɔna, iGɔna si byun gbɛɛ, &lt;&lt;Abu li utɔ mgbi emi iJudaa?&gt;&gt; IYesu nyan gbɛɛ, &lt;&lt;Dafi abu gbɔ mani.&gt;&gt;<verse eid="MAT 27:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 27:12"/>Onɔ ngwi engyukwo ama ofifɛ mgbi Imgbasho bɛyi engyukwo mgbi emi iJuda maayi ban nɛ, o kwondu onyi ba. <verse eid="MAT 27:12"/><verse number="13" style="v" sid="MAT 27:13"/>Nɛ iPlatu byun gbɛɛ, &lt;&lt;Abu fwo obwɛndɛ ngwi a gbe ba mi ikye abu nɛ lo?&gt;&gt; <verse eid="MAT 27:13"/><verse number="14" style="v" sid="MAT 27:14"/>Kpaa iYesu kwondu ba, di nu uka mi itɔdzɛ onyi kpaa ba, i kwulu iGɔna ewo kpakpa.<verse eid="MAT 27:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15"/>Onɔ nɛ i teyi li aletɔ mgbi iGɔna mi onɔ oga owɛ owatɔ-watɔ mgbi emi Israi, odulu inggisɛ onyi mi obawi ongwu emi Israi gbela won mani. <verse eid="MAT 27:15"/><verse number="16" style="v" sid="MAT 27:16"/>Mi onɔ na a dzɛ yi ibwubwe inggisɛ oka mi obawi, iyin di iBaraba. <verse eid="MAT 27:16"/><verse number="17" style="v" sid="MAT 27:17"/>Dafi emi Israi kwakye duu nɛta, iPlatu byi ma gbɛɛ, &lt;&lt;Li emɛ ngwu ema mina gbɛɛ ni ani dulu nu ema; li iBaraba naadi iYesu ngwu a li kwun di iMedzaya na?&gt;&gt; <verse eid="MAT 27:17"/><verse number="18" style="v" sid="MAT 27:18"/>Lubana o ye dafi li mi ikyili ngwi a kye iYesu ba mbi ongwu mani.<verse eid="MAT 27:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19"/>Dafi iPlatu ka sɔdzɛ itse ogbiikwɔ nɛ, owan dɛsɔ nɛ gbɛɛ, &lt;&lt;Ka dzɛ yi unkonyi okyɔ yi inggisɛ ndzɛ yi obube ba nɛ ba, lubana ani gyadzɛ kwuba inɛ mi elela mi ikye mgban.&gt;&gt;<verse eid="MAT 27:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20"/>Nghaduu engyukwo ama ofifɛ bɛyi engyukwo mgbi emi iJuda tu ibyi inggisɛ ntona wo gbɛɛ nu ma bɔ iBaraba kpaa iYesu yɔ nu ma ka ngwɔn.<verse eid="MAT 27:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 27:21"/>IGɔna byi ma gbɛɛ, &lt;&lt;Li emɛ mi idzidzɛ inggisɛ efa ntonɛ ngwi ema mina gbɛɛ ni ani dulu nu ema?&gt;&gt;</para>
  <para style="p" vid="MAT 27:21">A wulu gbɛɛ, &lt;&lt;IBaraba.&gt;&gt;<verse eid="MAT 27:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22"/>IPlatu byi ma gbɛɛ, &lt;&lt;Nghanɛ nin kyɔsinɛ yi iYesu ngwu a li kwun di iMedzaya nɛ?&gt;&gt;</para>
  <para style="p" vid="MAT 27:22">Ama duu wulu gbɛɛ, &lt;&lt;Gbokwon mi ekwatsi.&gt;&gt;<verse eid="MAT 27:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23"/>IPlatu byita gbɛɛ, &lt;&lt;dikyɛ? Li alungwɔ obube ngwi o kyɔ?&gt;&gt;</para>
  <para style="p" vid="MAT 27:23">Kpaa a nghao feela okwukwo gbɛɛ, &lt;&lt;Gbokwon mi ekwatsi.&gt;&gt;<verse eid="MAT 27:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24"/>Ngwi iPlatu di gbɛɛ odzɛ mgbi ongwu le kaka ma adɔ ba, eye kpaa dile fya okyɛɛ nɛ, o mweni di sabɔ mi inai ma. O gbɛɛ, &lt;&lt;Ani dzɛ yi obube mi eyi mgbi inggisɛ nɛ ba, li idɔ mgbi ema!&gt;&gt;<verse eid="MAT 27:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25"/>Inggisɛ ntona duu nu uka gbɛɛ, &lt;&lt;Ni eyi mgban dikye eyi yi engwɛ eyi duu!&gt;&gt;<verse eid="MAT 27:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26"/>Ta o dulu iBaraba nu ma: Kpaa iYesu yɔ, o nu ma gbon onitse ngyɛ taman, kyon wo ma abɔ gbɛɛ nu ma ka gbokwon mi ekwatsi.<verse eid="MAT 27:26"/></para>
  <para style="s1">Eblakwutsɛ nya iYesu agya</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27"/>Ta ama oblakwutsɛ mgbi iGɔna na kye iYesu lu agya oka mi ifyudɛ utɔ di gbe obyi oblakwutsɛ duu kpakɛkɛ won. <verse eid="MAT 27:27"/><verse number="28" style="v" sid="MAT 27:28"/>A dulun angwuto di gbe awulu omuma jaan won ewo, <verse eid="MAT 27:28"/><verse number="29" style="v" sid="MAT 27:29"/>diyɛ fulu akata mi ato tukwun ikye. A di kye okwuta won kɛ abugye, yɛ kwɛsɛ mi iyayi mgban nyan agya gbɛɛ, &lt;&lt;Eyi ta abu angba, utɔ mgbi emi iJuda!&gt;&gt; <verse eid="MAT 27:29"/><verse number="30" style="v" sid="MAT 27:30"/>A kyanggwɔ kyin, di kye gbɛlu okwuta na mi abɔ mgban yilen gbon mi ikye dudɔ-dudɔ. <verse eid="MAT 27:30"/><verse number="31" style="v" sid="MAT 27:31"/>Ngwi a nyan addi ngyɛ nɛ, a kye dulun awulu na mi ewo yɛ gbe angwuto mgban won. Man a tawon lu oka gbokwon mi ekwatsi ngwɔn.<verse eid="MAT 27:31"/></para>
  <para style="s1">A gbokwo iYesu mi ekwatsi</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32"/>Dafi a le tasɛ nɛ, a kpatsɛ ongyulɔ ongwi iSirini, iyin di iSaimɔn, nɛman a siin gbɛɛ non kye ekwatsi nani. <verse eid="MAT 27:32"/><verse number="33" style="v" sid="MAT 27:33"/>A wa kaka imbe ngwi a li kwun gbɛɛ iGogota (Ngwi itan di idingbo nani.) <verse eid="MAT 27:33"/><verse number="34" style="v" sid="MAT 27:34"/>Mi imbe na a kye eneekwɔ ngwi a kye takye yi mcɛ nu iYesu gbɛɛ non wa, kpaa ngwi o mbadi nɛ, o fwa owan. <verse eid="MAT 27:34"/><verse number="35" style="v" sid="MAT 27:35"/>Ngwi a gbokwon mi ekwatsi nyɛ nɛ, a kye ghalu angwuto mgban mi efa ogboogbo.<verse eid="MAT 27:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 27:36"/>Man a sɔkɛ, le ngyon mmanani. <verse eid="MAT 27:36"/><verse number="37" style="v" sid="MAT 27:37"/>Mi onyɛ ikye mgban kɛ esho gwee, a kye itɔdzɛ ngwi a kye won ewo ma kyi lɔlu bɛkɛ ele gbɛɛ: NƐNƐ LI IYESU, UTƆ MGBI EMI IJUDA. <verse eid="MAT 27:37"/><verse number="38" style="v" sid="MAT 27:38"/>Emumyi ama ofofɛ nghi efa kpaa a gbokwo ma yan, onyi mi abugye mgban yi oka mi abubɛ mgban. <verse eid="MAT 27:38"/><verse number="39" style="v" sid="MAT 27:39"/>Ama nnyɛ kwɛkwɛ gbe ito tukwun ewo, dile ngwi ikye, <verse eid="MAT 27:39"/><verse number="40" style="v" sid="MAT 27:40"/>yɛ le gbɛɛ, &lt;&lt;Abu nka gbobu ozu okwukwo osunu Imgbasho mi iJerosalin di yilen mbɛ mi egbe eta ta nɛ, dulu ewabu tɔ! Tashulu mi ekwatsi, kini abu li Ongwɛ Imgbasho yɔ!&gt;&gt;<verse eid="MAT 27:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41"/>Li itɔ ofɛ nɛ kpɔɔ ngwi engyukwo mgbi ama ofifɛ mgbi Imgbasho yi etsetse mgbi ola mgbi iMose bɛyi engyukwo mgbi emi iJuda mwibwa nyan aali. <verse eid="MAT 27:41"/><verse number="42" style="v" sid="MAT 27:42"/>A gbɛɛ, &lt;&lt;O dulu angbeka tɔ kpaa o yagba dulu ewon ba! Non li utɔ mgbi emi Israi yɔ! Non tashulu mi ekwatsi, ta eyi ka nun oyɛyɛ. <verse eid="MAT 27:42"/><verse number="43" style="v" sid="MAT 27:43"/>O nu Imgbasho oyɛyɛ. Ni Imgbasho dulun onɛnɛni ki non kpan itukwu yɔ, lubana o gbɛɛ &lt;Ani li Ongwɛ Imgbasho.&gt; &gt;&gt; <verse eid="MAT 27:43"/><verse number="44" style="v" sid="MAT 27:44"/>Li itɔ ofɛ nɛ kpɔɔ ngwi emumyi ama ngwu a gbokwo ma yan mi ekwatsi ntona kpaa yawon ito aali.<verse eid="MAT 27:44"/></para>
  <para style="s1">Ikwu iYesu</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45"/>I wita mi obyi iwyodefa nghataa ba obyi eta ongwi onɔdɛ imbe yifu kpatsɛ ɛsɛ duu. <verse eid="MAT 27:45"/><verse number="46" style="v" sid="MAT 27:46"/>Dafi obyi eta hini iYesu makwɔ tasɛ mi ela okwukwo gbɛɛ, &lt;&lt;Elio, Elio, lama sabatani?&gt;&gt; -Itan gbɛɛ, &lt;&lt;Imgbasho mgbi ani, Imgbasho mgbi ani, kyɔnɛ ngwi abu dzani ta?&gt;&gt;<verse eid="MAT 27:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47"/>Onɔ ngwi angbeka nkwudzɛ mmana fwo akwɔ nɛ ma a gbɛɛ, &lt;&lt;O le kwu Elaija ela.&gt;&gt;<verse eid="MAT 27:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 27:48"/>Labɔlabɔ mata onyi mi idzidzɛ mgbi ama tsinya ka kye isoso. O kye tswokɛ eneekwɔ onunɔ, kye bwakɛ anggekwu, di kye nu iYesu gbɛɛ non wa. <verse eid="MAT 27:48"/><verse number="49" style="v" sid="MAT 27:49"/>Kpaa inggisɛ ama nsisi duu gbɛɛ, &lt;&lt;Kwulɛsɛ na, ni eyi di kana Elaija kyɛma ka wa dulun tɔ.&gt;&gt;<verse eid="MAT 27:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 27:50"/>Ngwi iYesu diyɛ makwɔ tɔ mi ela okwukwo nɛman, o si yulu.<verse eid="MAT 27:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51"/>Mi onɔ na mata angwuto ntsɛdzɛ ozu okwukwo osunu Imgbasho mi iJerosalin na gbua efa wita kyɛ esho nghataa to esɛ. Ikpɛsɛ suusu man unggwɔ kadzɛ. <verse eid="MAT 27:51"/><verse number="52" style="v" sid="MAT 27:52"/>Endzi gbeka kwulu lakɛ asisa man ikpewo mgbi inggisɛ ama osaan nteyi kwulu ma a kyile ma yɛɛ oshishe. <verse eid="MAT 27:52"/><verse number="53" style="v" sid="MAT 27:53"/>A tasɛ mi endzi, ngwi iYesu kyɛɛ mi ikwu nyɛ duu nɛ, a lu kaka ogalu osaan nani di tsetu inggisɛ ibyibyi.<verse eid="MAT 27:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54"/>Dafi okwukwo ogbakwu bɛyi ama nto yan le ngyo iYesu di ɛsɛ osuusu bɛyi ungwɔ ama nkyɔ duu nɛ, i kwulu ma ewo, a diyɛ gbɔ tɔ gbɛɛ, &lt;&lt;Otsitsi o li Ongwɛ Imgbasho!&gt;&gt;<verse eid="MAT 27:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55"/>Engyaa kwuba to imbe na, le di kɛ mbotunto. A kyɛdɔ iYesu kyɛ iGalalia ikye oyan abɔ mi imina mgban. <verse eid="MAT 27:55"/><verse number="56" style="v" sid="MAT 27:56"/>Mi idzidzɛ mgbi ama li iMeri iMagidalin, iMeri onɔ iJɛnsi yi iJose, bɛyi owa iDzebedi.<verse eid="MAT 27:56"/></para>
  <para style="s1">A ndzi iYesu</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57"/>Dafi onɔ le gbɛsɛ nɛ, inggisɛ aludu oka mi Arimatia, iyin di iJose, o teyi kye ewon yɛɛ ongwafɔ mgbi iYesu. <verse eid="MAT 27:57"/><verse number="58" style="v" sid="MAT 27:58"/>O kɛ mbi iPlatu ka bɔn ikwɔ mgbi iYesu, man iPlatu nondu gbɛɛ nu ma kye nun. <verse eid="MAT 27:58"/><verse number="59" style="v" sid="MAT 27:59"/>IJose kyelu ikwɔ nani, kye angwuto ofufɛ ndiwon, <verse eid="MAT 27:59"/><verse number="60" style="v" sid="MAT 27:60"/>kye ka ndzi mi endzi mgbi ongwu ofufɛ ngwi o cɛfo mi unggwɔ. O mulu ikwutsɛ okwukwo kye tukwukɛ ondendzi si di ofan nyɛ. <verse eid="MAT 27:60"/><verse number="61" style="v" sid="MAT 27:61"/>IMeri iMagidalin yi iMeri oka na sɔto fashi inɛ tsɛ endzi nani.<verse eid="MAT 27:61"/></para>
  <para style="s1">Inggisɛ ongyo endzi</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62"/>Tegblifan ma, li egbe otonyewo, engyukwo mgbi ama ofifɛ mgbi Imgbasho bɛyi emi iFarasi kɛ mbi iPlatu. <verse eid="MAT 27:62"/><verse number="63" style="v" sid="MAT 27:63"/>A gbɛɛ, &lt;&lt;Ongyukwo eyi wɛ gbɛɛ onɔ ngwi inggisɛ ogbatsika na ka dzɛ oshishe ma, o gbɛɛ, &lt;Ni i wa nyɛ egbe eta ani ka kyɛɛ mi ikwu.&gt; <verse eid="MAT 27:63"/><verse number="64" style="v" sid="MAT 27:64"/>Nghanɛ noola ikye nu ma ngyo endzi na saan nghataa ba egbe eta nani. Bana, emi ongwafɔɔn ka wa kye yili ikwɔ na diyɛ nya ibyi inggisɛ gbɛɛ o kyɛɛ mi ikwu. Okpagyewo ongwi olɛlɛ nɛ ka wa timbi ngha ongwi ababɔ.&gt;&gt;<verse eid="MAT 27:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65"/>IPlatu nya ma gbɛɛ, &lt;&lt;Kye ama ongyoongyo na, lu, ka ngyo endzi na dafi ema yagba mani.&gt;&gt; <verse eid="MAT 27:65"/><verse number="66" style="v" sid="MAT 27:66"/>Nghanɛ a lu ka kye kwobɛ ondendzi na mi ikwutsɛ nani di gbe ama ongyoongyo le ngyo.<verse eid="MAT 27:66"/></para>
  <chapter eid="MAT 27"/>
  <chapter number="28" style="c" sid="MAT 28"/>
  <para style="s1">Okyɛɛ-kyɛɛ mi ikwu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1"/>Ngwi egbe otonyidɔ wa nyɛ nɛ, mi egbegbe ototu mi egbe iladi, iMeri iMagidalin yi iMeri oka na kɛ oka di endzi.<verse eid="MAT 28:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 28:2"/>Vla nɛta ikpɛsɛ suusu kpakpa, ta Ongyesɔ mgbi Otsɛ tashulu kyɛ esho ba esɛ, wa munu ikwutsɛ na lu iyikpa di sɔkɛ ele. <verse eid="MAT 28:2"/><verse number="3" style="v" sid="MAT 28:3"/>Odzɛɛdzɛ mgban dzɛ dafi mmbwo onaabɔ, angwuto mgban di gbosa dafi ofufu itu. <verse eid="MAT 28:3"/><verse number="4" style="v" sid="MAT 28:4"/>Ama ongyoongyo ntona imio wo ma yan kpakpa man a shigakwu diyɛ gbɛsɛ lakɛ esɛ dafi a kwulu mani.<verse eid="MAT 28:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5"/>Ongyesɔ na nya engyaa ntona gbɛɛ, &lt;&lt;Ka mio ba na, lubana ani ye li iYesu ngwu a gbokwon mi ekwatsi na ngwi ema le pitan. <verse eid="MAT 28:5"/><verse number="6" style="v" sid="MAT 28:6"/>O dzɛ mmɛnɛ ba; o kyɛɛ mi ikwu, dafi o teyi gbɔ mani. Ba wa di imbe ngwi a kyon la ma na. <verse eid="MAT 28:6"/><verse number="7" style="v" sid="MAT 28:7"/>Nghanɛ yɛ lu plɛ-plɛ ka nya engwafɔɔn gbɛɛ: &lt;O kyɛɛ mi ikwu di teyi ema le lu iGalalia ma. Li mi imbe na ema ka din.&gt; Li ungwɔ ngwi ani ba owa nya ema aani.&gt;&gt;<verse eid="MAT 28:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8"/>Ta imio wo engyaa ntonani, nghaduu a dzɛ yi atsa kpakpa, man a dzata endzi tsinya lu plɛ-plɛ ka nya engwafɔɔn. <verse eid="MAT 28:8"/><verse number="9" style="v" sid="MAT 28:9"/>Vla nɛta iYesu kpatsɛ ma. O nya ma gbɛɛ, &lt;&lt;Iyu no dzɛ yi ema.&gt;&gt; A yɛ ba mbon, wa kpaklin afɔ di sunun. <verse eid="MAT 28:9"/><verse number="10" style="v" sid="MAT 28:10"/>IYesu si nya ma gbɛɛ, &lt;&lt;Ka mio ba na. Lu ka nya emidani nu ma lu iGalalia; a ka di ani mi imbe nani.&gt;&gt;<verse eid="MAT 28:10"/></para>
  <para style="s1">Odzɛ ogbɔɔgbɔ mgbi ama ongyo endzi</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11"/>Dafi engyaa ntona kpatsɛ ofɛ le lu nɛ, angbeka mi idzidzɛ mgbi ama ongyoongyo ntona kaka ifu ogalu ka gbɔ nya engyukwo ama ofifɛ mgbi Imgbasho alungwɔ nkyɔ duu. <verse eid="MAT 28:11"/><verse number="12" style="v" sid="MAT 28:12"/>Onɔ ngwi engyukwo ama ofifɛ kwakye yi engyukwo mgbi emi iJuda ma a tsɛwodzɛ si kye awuya kpakpa nu ama oblakwutsɛ, <verse eid="MAT 28:12"/><verse number="13" style="v" sid="MAT 28:13"/>nya ma gbɛɛ, &lt;&lt;Ema ka gbɔgbɛɛ, &lt;Engwafɔɔn ba mi otu wa kye yili ikwɔ mgban lu mi onɔ ngwi eyi le nuna mani.&gt; <verse eid="MAT 28:13"/><verse number="14" style="v" sid="MAT 28:14"/>Kini odzɛ nɛ to adɔ mgbi iGɔna yɔ, eyi ka nyan odzɛ nka man dika dulu ema tɔ mi okakewo mani.&gt;&gt; <verse eid="MAT 28:14"/><verse number="15" style="v" sid="MAT 28:15"/>Nghanɛ ama oblakwutsɛ ntona gbɛlu udza na di kyɔ dafi a nya ma ma yɛyɛ. Ta utsa nɛ a gbɔn kpatsɛ mbi emi iJuda nghataa ba inɛ.<verse eid="MAT 28:15"/></para>
  <para style="s1">Idɔ okwukwo</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16"/>Ta engwafɔ iwyodonyi ntona lu iGalalia, mi unggwɔ ngwi iYesu teyi nya ma gbɛɛ nu ma lu ele mani. <verse eid="MAT 28:16"/><verse number="17" style="v" sid="MAT 28:17"/>Ngwi a din nɛ, a sunun, kpaa angbeka tangwɛ. <verse eid="MAT 28:17"/><verse number="18" style="v" sid="MAT 28:18"/>Nɛ iYesu ba mboma wa gbɛɛ, &lt;&lt;Ali mfye mi esho yi esɛ duu a kye nu ani. <verse eid="MAT 28:18"/><verse number="19" style="v" sid="MAT 28:19"/>Nghanɛ lu dika nu inggisɛ mi ɛsɛ duu yɛɛ engwafɔ mgbi ani, kyɔ ma iBatisima mi iyi mgbi Otsɛ yi Ongwɛ bɛyi Onodzi Osaan, <verse eid="MAT 28:19"/><verse number="20" style="v" sid="MAT 28:20"/>di tso ma ongyo alungwɔ ngwi ani wo ema ola mi ele duu. N dika dzɛ yi ema alonɔ duu, nghataa kɛ ongyɛɛngyɛ ɛsɛ.&gt;&gt;<verse eid="MAT 28:20"/></para>
  <chapter eid="MAT 28"/>
</usx>
