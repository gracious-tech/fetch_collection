<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ACT" style="id">- Etulo</book>
  <para style="h">Okyɔɔkyɔ</para>
  <para style="toc1">Okyɔɔkyɔ mgbi ama ogbikye iYesu</para>
  <para style="toc2">Okyɔɔkyɔ</para>
  <para style="toc3">Okyɔ</para>
  <para style="mt1">Okyɔɔkyɔ</para>
  <para style="mt2">mgbi ama ogbikye iYesu</para>
  <chapter number="1" style="c" sid="ACT 1"/>
  <para style="s1">A kye iYesu lu esho</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 1:1"/>Otsungwudɛ iTiofyilɔ, mi olɔɔlɔ mgbi ani ongwi ababɔ ma, n lɔ alungwɔ ngwi iYesu wita okyɔɔkyɔ diyɛ tso <verse eid="ACT 1:1"/><verse number="2" style="v" sid="ACT 1:2"/>nghataa ba egbe ngwi a kyon lu esho, ngwi o wo ama ngwu o sadu ma li ama Ogbikyon ola mi mfye mgbi Onodzi Osaan ngyɛ mani. <verse eid="ACT 1:2"/><verse number="3" style="v" sid="ACT 1:3"/>Ngwi o gbiisɔ nyɛ nɛ, o kye ewon tso mbi inggisɛ ntonɛ di nu ma obwɛndɛ kwuba saan gbɛɛ ongwu dzɛ oshishe. O kye ewon tso ma mɛ egbe ngwusefa di gbɔdzɛ esutɔ mgbi Imgbasho nya ma. <verse eid="ACT 1:3"/><verse number="4" style="v" sid="ACT 1:4"/>Onoka ngwi o kwakye yi ama, le gye ungwogye yi ama nɛ, o nya ma gbɛɛ: &lt;&lt;Ka tasɛ dzata iJerosalin ba na, kpaa fɛ umba ngwi Otsani zondu, ngwi ema tsekise fwo ani gbɔdzɛ efu nani. <verse eid="ACT 1:4"/><verse number="5" style="v" sid="ACT 1:5"/>Bana iJɔn okyɔ iBatisima kyɔ iBatisima yi eni ta, nghaduu egbe sisi gwee ta a ka kyɔ ema iBatisima yi Onodzi Osaan.&gt;&gt;<verse eid="ACT 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 1:6"/>Ngwi a ka to yi ewoma nɛ, a byun gbɛɛ, &lt;&lt;Otsɛ, li mi onɔnɛ ngwi abu ka yile esutɔ mgbi emi Israi nu maa?&gt;&gt;<verse eid="ACT 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 1:7"/>Nɛ iYesu nya ma gbɛɛ: &lt;&lt;I wogyɔ ngwi ema ka ye egbe yi onɔ ngwi Otsani kye dzɛ mi mfye mgban ba. <verse eid="ACT 1:7"/><verse number="8" style="v" sid="ACT 1:8"/>Kpaa ema ka gbɛ mfye mi onɔ ngwi Onodzi Osaan ba mbi ema mani, ta ema ka yɛɛ emi obwɛndɛ mgbi ani mi iJerosalin yi iJudia yi iSamaria nghataa kpatsɛ ɛsɛ duu.&gt;&gt;<verse eid="ACT 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 1:9"/>Ngwi iYesu gbɔ ungwɔnɛ ngyɛ nɛta, a kyon mi inai ma lu esho, man akpa tukwu ma inɛ odin.<verse eid="ACT 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 1:10"/>A si kye inɛ fyakwu esho dafi o le lu mani, vla nɛta engyulɔ nghi efa wo angwuto onzundzɛ kwudzɛkɛ kwɛkwɛ yi ama. <verse eid="ACT 1:10"/><verse number="11" style="v" sid="ACT 1:11"/>Engyulɔ ntona gbɛɛ, &lt;&lt;Emi iGalalia, li ekyɛ ngwi ema to mmɛnɛ kye inɛ byi esho nghaa? iYesu ngwu a kyon inai ema lu esho nɛ, di li itɔ ofɛ nɛ kpɔɔ ngwi o dika yɛ ba ɛsɛ nɛni.&gt;&gt;<verse eid="ACT 1:11"/></para>
  <para style="s1">A dulu iMataya gbikye iJuda</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 1:12"/>Ta ama ogbikye iYesu si yidɔ mi iJerosalin mi Unggwɔ Olivi nani, ngwi mɛ dafi itsitsi imai okyɛɛ mi ele ba ogalu iJerosalin. <verse eid="ACT 1:12"/><verse number="13" style="v" sid="ACT 1:13"/>Ngwi a wa kaka iJerosalin nɛ, a lu ozeesho mi imbe ngwi a lato mani. Ama nto ma li iPyita, iJɔn, iJɛnsi, Andru, iFyilipi, iTɔmɔsu, iBatlomi, iMatiu, iJɛnsi ongwɛ Alfeɔ yi iSaimɔn ogbodami na bɛyi iJuda ongwɛ iJɛnsi. <verse eid="ACT 1:13"/><verse number="14" style="v" sid="ACT 1:14"/>Ama duu kwakye mbonyi le bibɔ alonɔ duu, angbeka nto bɛyi ama li engyaa yi iMeri onɔ iYesu bɛyi emi ongwunɔn.<verse eid="ACT 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 1:15"/>Mi egbe ntona iPyita kyato nto mi idzidzɛ mgbi ama onoyɛyɛ ntona (okwakye nmɛ mmbwo dafi ideli onyi dɔn osu sini) <verse eid="ACT 1:15"/><verse number="16" style="v" sid="ACT 1:16"/>si gbɛɛ, &lt;&lt;Emi ongwunani, i wogyɔ ngwi Afɛ ka mbwumbwo mi ungwɔ ngwi Onodzi Osaan tsekise gbɔ tɔ mi ondu iDevedi mi ikpewo iJuda, ongwu nmɛ ofɛ nu ma bwa iYesu nani. <verse eid="ACT 1:16"/><verse number="17" style="v" sid="ACT 1:17"/>Ongwu nose li onyi mi atɛ mgbi eyi di kyidɔ nɛ yi eyi kpaa.&gt;&gt;<verse eid="ACT 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 1:18"/>(Udza ngwi iJuda tu mi alobube mgban ma, o kye gya ikpɛsɛ, ngwi non kye ewon widɔkwɔ. Ikwɔ mgban mwɛ gbobu ɛfwɛɛ yangwuta. <verse eid="ACT 1:18"/><verse number="19" style="v" sid="ACT 1:19"/>Ali inggisɛ mi iJerosalin fwo ungwɔnɛni, nɛ a kwu imbe na mi ondudzɛ mgbi ama di Akedama, ngwi itan gbɛɛ, ikpɛsɛ eyi.)<verse eid="ACT 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 1:20"/>IPyita kiyayi gbɛɛ, &lt;&lt;Bana, a lɔ mi Afɛ mgbi iPaslami gbɛɛ,</para>
  <para style="q1" vid="ACT 1:20">&lt;&lt; &lt;Ni imbe mgban na la ayayi;</para>
  <para style="q2" vid="ACT 1:20">ni inggisɛ onyi kpaa ka dzɛ ele ba,&gt;</para>
  <para style="q1" vid="ACT 1:20">&lt;&lt; &lt;Ni inggisɛ oka di kyi kyelu</para>
  <para style="q2" vid="ACT 1:20">imbe idɔ mgban nani.&gt;<verse eid="ACT 1:20"/></para>
  <para style="m">
    <verse number="21" style="v" sid="ACT 1:21"/>Nghanɛ li kyɛmɛ-kyɛmɛ ngwi eyi ka dulu inggisɛ onyi mbi engyulɔ ama ntonɛ, ongwu nteyi le kyɛ yi eyi alonɔ duu ngwi Otsɛ iYesu ka dzɛ yi eyi mani, <verse eid="ACT 1:21"/><verse number="22" style="v" sid="ACT 1:22"/>eyi mina inggisɛ onyi nka kyɔ obwɛndɛ mgbi iYesu nɛ yi eyi. Ma dika li inggisɛ ndzɛ yi eyi wita mi onɔ ngwi iJɔn kyɔ iYesu iBatisima nghataa ba onɔ ngwi a kyi kyelu iYesu mbi eyi lu esho nani.&gt;&gt;<verse eid="ACT 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 1:23"/>Nɛ a si dulu engyulɔ efa ba iyayi: Onyi ma a li kwun di iJɔstusu ngwu iyin oka li iBasaba (iyin oka di li iTɔmɔsu) iyi oka ma li iMataya. <verse eid="ACT 1:23"/><verse number="24" style="v" sid="ACT 1:24"/>A si bibɔ gbɛɛ, &lt;&lt;Otsɛ Imgbasho, abu ye itukwu ali inggisɛ duu. Tso eyi inggisɛ ongwu abu sadu mi idzidzɛ inggisɛ efa ntonɛ <verse eid="ACT 1:24"/><verse number="25" style="v" sid="ACT 1:25"/>ongwu nka kyelu imbe idɔ mgbi ama ogbikye iYesu nɛ, ngwi iJuda dzanta lu imbe ndzɛ mi ikyon mani.&gt;&gt; <verse eid="ACT 1:25"/><verse number="26" style="v" sid="ACT 1:26"/>Ta a gbeefa, efa si kwu iMataya; man a kyon mbwokɛ yi iwyodonyi ntonani.<verse eid="ACT 1:26"/></para>
  <chapter eid="ACT 1"/>
  <chapter number="2" style="c" sid="ACT 2"/>
  <para style="s1">Obaaba mgbi Onodzi Osaan</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 2:1"/>Ngwi egbe iPɛntikɔsu<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="fk" closed="false">iPɛntikɔsu </char><char style="ft" closed="false">Li oga ngwi emi Israi li kyɔn mi onɔ ngwi oga owɛ owatɔ-watɔ mgbi emi Israi nyɛ egbe ngwusefa dɔn iwyo mani.</char></note> wa gyɔ nɛ, ama duu kwakye mbonyi. <verse eid="ACT 2:1"/><verse number="2" style="v" sid="ACT 2:2"/>Vla nɛta adu kyɛ esho dafi onikyawo wa yaokɛ ozu ngwi a sɔto mani. <verse eid="ACT 2:2"/><verse number="3" style="v" sid="ACT 2:3"/>A di ungwɔ ndzɛ dafi amoola ganya wa dɔkɛ ikye mgbi ama duu. <verse eid="ACT 2:3"/><verse number="4" style="v" sid="ACT 2:4"/>Ama duu si mbwo yi Onodzi Osaan man wita le gbɔ ondudzɛ angbeka dafi Onodzi kye ma teyi mani.<verse eid="ACT 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 2:5"/>Mi onɔ na, emi iJuda ama ndzɛ yi imio mgbi Imgbasho kyɛ mi ayɛsɛ duu wa kwakye mi iJerosalin. <verse eid="ACT 2:5"/><verse number="6" style="v" sid="ACT 2:6"/>Onɔ ngwi a fwo adu nɛ nɛ, ibyi inggisɛ kwakye. Nghaduu i kwulu ma ewo, ikyekyɛ ali inggisɛ fwo ma le gbɔ ondudzɛ mgbi ongwu. <verse eid="ACT 2:6"/><verse number="7" style="v" sid="ACT 2:7"/>I kwulu ma ewo kpakpa, a si byita gbɛɛ, &lt;&lt;Inggisɛ ama nle gbɔdzɛ ntonɛ duu li emi iGalalia baa? <verse eid="ACT 2:7"/><verse number="8" style="v" sid="ACT 2:8"/>Ma i kyɔsinɛse ngwi eyi fwo ama duu le gbɔ ondudzɛ mgbi eyi? <verse eid="ACT 2:8"/><verse number="9" style="v" sid="ACT 2:9"/>Emi iPatia, iMede yi Elami; iMesopotamia, iJudia bɛyi iKapadosia, iPontu yi Asia, <verse eid="ACT 2:9"/><verse number="10" style="v" sid="ACT 2:10"/>iFrijia yi iPamfyilia, Igyibiti bɛyi ayɛ mgbi iLibyia kwɛkwɛ yi iSereni, ingyoga mgbi iRoma <verse eid="ACT 2:10"/><verse number="11" style="v" sid="ACT 2:11"/>(yi emi iJuda bɛyi ama ngwu kyatitukwu yɛ le sunu Imgbasho mgbi emi iJuda duu), emi iKrete bɛyi emi Arabia, eyi fwo ma le gbɔ ungwɔ okwulewo mgbi Imgbasho mi ondudzɛ mgbi eyi!&gt;&gt; <verse eid="ACT 2:11"/><verse number="12" style="v" sid="ACT 2:12"/>I kwulu ma ewo a di wɛndɛ, a si byi ewoma gbɛɛ, &lt;&lt;Ungwɔnɛ tso sinɛ?&gt;&gt; <verse eid="ACT 2:12"/><verse number="13" style="v" sid="ACT 2:13"/>Angbeka gbɔ ibwa nya ama onoyɛyɛ ntona gbɛɛ, &lt;&lt;A wa ɛbyɛ le fya.&gt;&gt;<figure style="fig" alt="Obaaba mgbi Onodzi" file="DN00498b.tif" size="col" loc="2;13" copy="Dunhan" ref="2:13">The penticost</figure><verse eid="ACT 2:13"/></para>
  <para style="s1">IPyita gbɔdzɛ yi ibyi inggisɛ</para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 2:14"/>Nɛ iPyita kyato dzɛkunto yi iwyodonyi ntonani, kyile ela mgban gbɔdzɛ yi ibyi inggisɛ ntona gbɛɛ: &lt;&lt;Emidani emi iJuda bɛyi ema ama nto iJerosalin duu, detse nin gbɔfwɛ odzɛ nɛ nya ema; gadɔ saan mi odzɛ ngwi ani le nya ema nɛni. <verse eid="ACT 2:14"/><verse number="15" style="v" sid="ACT 2:15"/>Inggisɛ ntonɛ le fya ɛbyɛ, dafi ema tsɛwɛ na ba. Kwa li obyi egyanɛ mi egbegbe ta aani! <verse eid="ACT 2:15"/><verse number="16" style="v" sid="ACT 2:16"/>Ei, ungwɔnɛ li ungwɔ ngwi oyegbɔ iJowɛ tsekise gbɔn dzɛ esɛ gbɛɛ:<verse eid="ACT 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 2:17"/>&lt;&lt; &lt;Imgbasho gbɛɛ, mi egbe ongwi olɛlɛ,</para>
  <para style="q2" vid="ACT 2:17">ani ka kye Onodzi mgbi ani yaokɛ mbi ali inggisɛ duu.</para>
  <para style="q1" vid="ACT 2:17">Engwɛ ema engyulɔ yi engyaa kale yegbɔ,</para>
  <para style="q2" vid="ACT 2:17">ɛngbɛ mmafa mgbi ema kale di inɛ odiidi,</para>
  <para style="q1" vid="ACT 2:17">engyukwo mgbi ema kale woowo elela.<verse eid="ACT 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ACT 2:18"/>Mbi engbidɔ mgbi ani kpaa,</para>
  <para style="q2" vid="ACT 2:18">engyulɔ yi engyaa duu,</para>
  <para style="q1" vid="ACT 2:18">n ka kye Onodzi mgbi ani yaokɛ</para>
  <para style="q2" vid="ACT 2:18">mboma mi egbe ntonani,</para>
  <para style="q1" vid="ACT 2:18">man a ka yegbɔ.<verse eid="ACT 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ACT 2:19"/>N ka kyɔ ambɛ okwulewo mi esho</para>
  <para style="q2" vid="ACT 2:19">mbyoo bɛyi ungwɔ ama okwulewo mi iteesɛ,</para>
  <para style="q1" vid="ACT 2:19">otso gbɛɛ di ani dzɛ yi mfye.</para>
  <para style="q2" vid="ACT 2:19">N ka tiika mi ɛsɛ adzi ni inggisɛ ngwɔ ewoma,</para>
  <para style="q1" vid="ACT 2:19">ola dika gbimbe sɔ yi iwu.<verse eid="ACT 2:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ACT 2:20"/>A ka kyata onɔ yɛɛ iyifu,</para>
  <para style="q2" vid="ACT 2:20">di kyata ofyia yɛɛ eyi duuse ni egbe oshewo</para>
  <para style="q1" vid="ACT 2:20">bɛyi okwɔkwɔ mgbi Otsɛ no ba.<verse eid="ACT 2:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ACT 2:21"/>Nghanɛ ali inggisɛ nkwu mi iyi mgbi Otsɛ</para>
  <para style="q2" vid="ACT 2:21">duu ka tu owatɔ.&gt;<verse eid="ACT 2:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 2:22"/>&lt;&lt;Emi Israi, gadɔ mi odzɛ nɛ na; iYesu ongwi iNadzareti nose li inggisɛ ngwu Imgbasho gbela yan di kyɔ ambɛ okwulewo mbi ema nyɛ mbon, dafi ema abuema ye mani. <verse eid="ACT 2:22"/><verse number="23" style="v" sid="ACT 2:23"/>Inggisɛ nɛ a kyon wo ema abɔ mi owitukwu mgbi Imgbasho bɛyi oye-ye mgban; ma ema noofɛ ni emi imbali, gbokwon ngwɔn mi ekwatsi. <verse eid="ACT 2:23"/><verse number="24" style="v" sid="ACT 2:24"/>Nghaduu Imgbasho kyilon mi ikwu, dulun tɔ mi owulewo mgbi ikwongye, lubana li kyɛmɛ-kyɛmɛ ni ikwongye bwan adi ba. <verse eid="ACT 2:24"/><verse number="25" style="v" sid="ACT 2:25"/>IDevedi gbɔdzɛ mgban gbɛɛ:</para>
  <para style="q1" vid="ACT 2:25">&lt;&lt; &lt;Ani di Otsɛ dzɛ yi ani alonɔ duu.</para>
  <para style="q2" vid="ACT 2:25">Ikyegbɛɛ o dzɛ abugye mgbi ani nɛ,</para>
  <para style="q1" vid="ACT 2:25">ani ka teeyi ba.<verse eid="ACT 2:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 2:26"/>Nghanɛ itukwu mgbi ani shɛta</para>
  <para style="q2" vid="ACT 2:26">idɛ mgbi ani di dzɛ yi atsa;</para>
  <para style="q1" vid="ACT 2:26">ikpewo mgbi ani kpaa ka dzɛ mi ɛwɛ ogbebyi,<verse eid="ACT 2:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 2:27"/>lubana abu ka dzita ani mi endzi ba,</para>
  <para style="q2" vid="ACT 2:27">hona abu ka dzita</para>
  <para style="q2" vid="ACT 2:27">Ongwabu Osaan no bwa ba.<verse eid="ACT 2:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ACT 2:28"/>Abu nu ani ye ofɛ oshishe;</para>
  <para style="q2" vid="ACT 2:28">abu ka mbwo ani yi atsa mi</para>
  <para style="q2" vid="ACT 2:28">ifafɔ mgbi abu.&gt;<verse eid="ACT 2:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 2:29"/>&lt;&lt;Emi ongwunani, ani ka nya ema yi abɔ otsigɛgɛ gbɛɛ iDevedi nli ikye mgbi ema na kwulu a kyon ndzi, ma endzi mgban dzɛ mmɛnɛ nghataa ba inɛ. <verse eid="ACT 2:29"/><verse number="30" style="v" sid="ACT 2:30"/>Kpaa ongwu nose li oyegbɔ di ye dafi Imgbasho zondu yan kpɔklɔɔ gbɛɛ ongwu ka wa kye ongwiba mgban oka sɔkɛ itsuutɔ mgban mani. <verse eid="ACT 2:30"/><verse number="31" style="v" sid="ACT 2:31"/>Ngwi iDevedi di ungwɔ ndzɛ iyayi nɛ, o gbɔdzɛ okyɛɛ-kyɛɛ mi ikwu mgbi iMedzaya nani, gbɛɛ a dzanta mi endzi ba, naadi ikwɔ mgban bwa ba. <verse eid="ACT 2:31"/><verse number="32" style="v" sid="ACT 2:32"/>Imgbasho teyi kyile iYesu nɛ luba oshishe, ma eyi duu li obwɛndɛ mgbi otsitsi nɛni. <verse eid="ACT 2:32"/><verse number="33" style="v" sid="ACT 2:33"/>A kyilon esho sɔkɛ abugye mgbi Imgbasho, o gbɛ Onodzi Osaan ngwi Otsɔn zondu mani di kye ungwɔ ngwi ema le di diyɛ fwo onɛnɛ nɛ yaokɛ. <verse eid="ACT 2:33"/><verse number="34" style="v" sid="ACT 2:34"/>Lubana li iDevedi nose lu esho ba, nghaduu o gbɛɛ,</para>
  <para style="q1" vid="ACT 2:34">&lt;&lt; &lt;Otsɛ Imgbasho gbɔ yi Otsɛ mgbi ani gbɛɛ:</para>
  <para style="q2" vid="ACT 2:34">&lt;&lt;Sɔkɛ abugye mgbi ani<verse eid="ACT 2:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="ACT 2:35"/>nghatakata ni Ani nu engyikyili mgbi abu yɛɛ</para>
  <para style="q2" vid="ACT 2:35">itse mgbi abu ogbe afɔ dɔ ele.&gt;&gt; &gt;<verse eid="ACT 2:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 2:36"/>&lt;&lt;Ikyenghanɛ emi Israi duu nu ma ye ungwɔnɛni: Imgbasho nu iYesu, ngwu ema gbokwon mi ekwatsi nɛ, yɛɛ Otsɛ bɛyi iKrestu.&gt;&gt;<verse eid="ACT 2:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 2:37"/>Ngwi inggisɛ ntonɛ fwo odzɛ nɛ nɛ, eka dzɛ loma ta a byi iPyita bɛyi ama ogbikye iYesu angbeka ntona gbɛɛ, &lt;&lt;Emi ongwuneyi, eyi ka kyɔsinɛ?&gt;&gt;<verse eid="ACT 2:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 2:38"/>IPyita nu uka gbɛɛ, &lt;&lt;Kyatitukwu nu ma kyɔ ema iBatisima, mi iyi mgbi iYesu iKrestu mi ikye odzita ema yi ali ibwubwe. Ta ema ka gbɛ umba mgbi Onodzi Osaan. <verse eid="ACT 2:38"/><verse number="39" style="v" sid="ACT 2:39"/>Ondu odzɛɛdzɛ nɛ dzɛ ikye ema yi emi ongwɛ ema bɛyi ama nto mbombo ikye ama ngwu Otsɛ Imgbasho mgbi eyi ka kwu ma ela duu mani.&gt;&gt;<verse eid="ACT 2:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 2:40"/>O di kwo ma adɔ yi elodzɛ angbeka kwuba; di tɛkyɛ nu ma gbɛɛ, &lt;&lt;Dulu ewema tasɛ mi ungwɔ nka wa kyɔ etɔ obube nɛni.&gt;&gt; <verse eid="ACT 2:40"/><verse number="41" style="v" sid="ACT 2:41"/>Ama ngbɛ esɔ mgban ma a kyɔ ma iBatisima, i mɛ inggisɛ idubu eta mbwokɛ mbwo mgbi ama mi egbe nani.<verse eid="ACT 2:41"/></para>
  <para style="s1">Okwakye mgbi ama onoyɛyɛ</para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 2:42"/>A kye ewoma tswokɛ mi otsootso mgbi ama ogbikye iYesu bɛyi okwakye, ungwogye ogyeegye yi ewoma, ibredi oghaagha bɛyi ibɔ obɔɔbɔ. <verse eid="ACT 2:42"/><verse number="43" style="v" sid="ACT 2:43"/>I kwulu ali inggisɛ duu ewo, ama ogbikye iYesu ntona di kyɔ ambɛ ama okwulewo gwuba. <verse eid="ACT 2:43"/><verse number="44" style="v" sid="ACT 2:44"/>Ama onoyɛyɛ duu to yi eka di li kyɔ alungwɔ duu ungwonyi. <verse eid="ACT 2:44"/><verse number="45" style="v" sid="ACT 2:45"/>A kye ungwɔ ngwi ama dzɛyan bɛyi okye duu gya, di gha nu ali inggisɛ duu dafi okakewo mgbi otsungwɔn dzɛ mani. <verse eid="ACT 2:45"/><verse number="46" style="v" sid="ACT 2:46"/>Alegbe a li kiyayi okwakye yi ewoma mi ifyudɛ ozu okwukwo osunu Imgbasho mi iJerosalin. A li gha ibredi mi udɛ mgbi ama di li gye yi ewoma mi atsa yi itukwu onyi, <verse eid="ACT 2:46"/><verse number="47" style="v" sid="ACT 2:47"/>le tsɛ Imgbasho dile tu mgbede mbi inggisɛ duu. Nɛ Otsɛ Imgbasho sile mbwo ama ngwu o dulu ma watɔ ma mmbwo alegbe-alegbe.<verse eid="ACT 2:47"/></para>
  <chapter eid="ACT 2"/>
  <chapter number="3" style="c" sid="ACT 3"/>
  <para style="s1">IPyita kyile inggisɛ ngbikye tukwu esɛ <optbreak/> le bibɔ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 3:1"/>Egbe oka nɛ iPyita bɛyi iJɔn le kɛ ozu okwukwo osunu Imgbasho mi iJerosalin mi onɔ ibɔ mi obyi eta ngwi onɔ tashulu akpa. <verse eid="ACT 3:1"/><verse number="2" style="v" sid="ACT 3:2"/>Onɔ na inggisɛ oka ngwu gbikye tukwu esɛ kyɛ ifu, a li kyon ka sɔkɛ onufozu ozu okwukwo osunu Imgbasho mi iJerosalin ngwi a li kwun di osunse nani, le bɔ inggisɛ ama nle kaka ozu ungwɔ alegbe-alegbe. <verse eid="ACT 3:2"/><verse number="3" style="v" sid="ACT 3:3"/>Onɔ ngwi o di iPyita yi iJɔn le kaka nɛ, o bɔ ma awuya. <verse eid="ACT 3:3"/><verse number="4" style="v" sid="ACT 3:4"/>IPyita yi iJɔn kye inɛ byun yɛyɛ. IPyita si gbɛɛ &lt;&lt;Kye inɛ byi eyi!&gt;&gt; <verse eid="ACT 3:4"/><verse number="5" style="v" sid="ACT 3:5"/>Inggisɛ na si kye itukwu byikɛ mboma, le tsɛwɛ gbɛɛ ongwu ka tu ungwɔ mboma.<verse eid="ACT 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 3:6"/>Man iPyita gbɛɛ, &lt;&lt;N dzɛ yi iyudza onzundzɛ yi Abashi ba, kpaa ungwɔ ngwi ani dzɛyan ma, n ka kye nu abu. Mi iyi mgbi iYesu iKrestu ongwi iNadzareti kyato kyikyɛ.&gt;&gt; <verse eid="ACT 3:6"/><verse number="7" style="v" sid="ACT 3:7"/>Ngwi o byin mi abugye nɛ, o yan abɔ non kyato, labɔlabɔ nɛta afɔ mgbi inggisɛ na si fyumfye. <verse eid="ACT 3:7"/><verse number="8" style="v" sid="ACT 3:8"/>O ta yile afɔ dzɛkɛ esɛ man wita okyikyɛ. Nɛ o si lu yi ama mi ifyudɛ ozu okwukwo osunu Imgbasho mi iJerosalin, le kyikyɛ tablika dile tsɛ Imgbasho. <verse eid="ACT 3:8"/><verse number="9" style="v" sid="ACT 3:9"/>Ngwi inggisɛ duu din le kyikyɛ dile tsɛ Imgbasho nɛ, <verse eid="ACT 3:9"/><verse number="10" style="v" sid="ACT 3:10"/>a difwin dafi ka li inggisɛ nli sɔ le bibɔ mi onufozu ozu okwukwo osunu Imgbasho mi iJerosalin ngwi a li kwun di osunse nani, ta i kwulu ma ewo kpakpa mi ungwɔ nkyɔ yan mani.<verse eid="ACT 3:10"/></para>
  <para style="s1">IPyita gbɔdzɛ yi ama ntongwinɛ tole <optbreak/> di mani</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 3:11"/>Ngwi inggisɛ obɔ ungwɔ yɛ wa bɛkɛ yi iPyita yi iJɔn nɛ i kwulu inggisɛ ntona duu ewo ta a ba onyonya wa tu ma mi imbe ngwi a li kwun di iwulu onufɛ mgbi iSolomu nani. <verse eid="ACT 3:11"/><verse number="12" style="v" sid="ACT 3:12"/>Ngwi iPyita di nghanɛ, o nya ma gbɛɛ: &lt;&lt;Emi Israi, kyɔsinɛ ngwi ungwɔnɛ le kwulu ema ewo? Kyɔsinɛ ngwi ema le di eyi inɛ dafi li mfye naadi osaan mgbi eyi ngwi eyi nu inggisɛ nɛ kyikyɛ? <verse eid="ACT 3:12"/><verse number="13" style="v" sid="ACT 3:13"/>Imgbasho mgbi Abrahan, Adziki bɛyi iJeko; Imgbasho mgbi emi otseyi, kye okwɔkwɔ nu ongbidɔ mgban iYesu. Ema kyon nu gbɛɛ nu ma ngwɔn, di tangwan mi inai iPlatu, bana o mina odzanta non lu. <verse eid="ACT 3:13"/><verse number="14" style="v" sid="ACT 3:14"/>Ema tangwɛ Ongwu nle Saan dile Nyaan nani, di mina gbɛɛ a ki dulu inggisɛ ongwɔ inggisɛ nu ema. <verse eid="ACT 3:14"/><verse number="15" style="v" sid="ACT 3:15"/>Ema ngwɔ otsungwɔ oshishe, nghaduu Imgbasho kyilon mi ikwu. Eyi li obwɛndɛ mi ungwɔnɛni. <verse eid="ACT 3:15"/><verse number="16" style="v" sid="ACT 3:16"/>Li oyɛyɛ onuunu mi iyi mgbi iYesu ngwi inggisɛ ema di, di yon nɛ yɛɛ saan aani. Li iyi mgbi iYesu bɛyi oyɛyɛ onuunu nkyɛ mbon ma nu ootse ngyɛ lo inggisɛ nɛ saan, ngwi ema di nɛni.<verse eid="ACT 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 3:17"/>&lt;&lt;Onɛnɛ, emi ongwunani, ani ye ta gbɛɛ ema kyungwɔnɛ mi inɛ obuubu, dafi ama okye ema teyi kpaa tsekise kyɔ mani. <verse eid="ACT 3:17"/><verse number="18" style="v" sid="ACT 3:18"/>Nghaduu li itɔ ofɛ ngwi Imgbasho mbwumbwo ungwɔ ngwi ongwu tsekise gbɔn nyɛ mbi ama ogbɛɛsɛ aali, gbɛɛ iMedzaya mgbi ongwu ka wa gyadzɛ. <verse eid="ACT 3:18"/><verse number="19" style="v" sid="ACT 3:19"/>Kyatitukwu yidɔ luba mbi Imgbasho na, adzi ni Otsɛ dzɛ ema ta yi ali ibwubwe mgbi ema, onɔ onya otooto ka kyɛ mbi Otsɛ, <verse eid="ACT 3:19"/><verse number="20" style="v" sid="ACT 3:20"/>onɔ di kyɛma ngwi Otsɛ ka nu ema mfye ofufɛ. O ka kye iYesu dɛsɔ nu ema, iMedzaya mgban ngwu o dulu-dulu nani. <verse eid="ACT 3:20"/><verse number="21" style="v" sid="ACT 3:21"/>Li kyɛmɛ ngwi o ka tila dzɛ esho nghataa ngwi onɔ ka gyɔ ngwi Imgbasho ka yile alungwɔ duu sisɛ, dafi o zondu gbegbe nyɛ mbi oyegbɔ mgban ama osaan mani. <verse eid="ACT 3:21"/><verse number="22" style="v" sid="ACT 3:22"/>Ikyesinɛ iMose gbɛɛ, &lt;Otsɛ Imgbasho mgbi ema ka dulu oyegbɔ dafi ani mi idzidzɛ ema nu ema; li kyɛmɛ ema ka gadɔ mi alungwɔ ngwi o nya ema duu. <verse eid="ACT 3:22"/><verse number="23" style="v" sid="ACT 3:23"/>Ali inggisɛ ngwu gadɔ fwon ba duu a ka dulun mbi engwɛ Imgbasho dzɛkɛ enggengga.&gt;<verse eid="ACT 3:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 3:24"/>&lt;&lt;Mi otsitsi ama ogbɛɛsɛ wita mbi iSamue lu mbi angbeka duu, teyi gbɔdzɛ ungwɔ ama ntole kyɔ mi ɛsɛ ongwi onɛnɛ nɛni. <verse eid="ACT 3:24"/><verse number="25" style="v" sid="ACT 3:25"/>Nghanɛ ema li ama gyokwudɛ mgbi ama ogbɛɛsɛ bɛyi ondu odzɛɛdzɛ ngwi Imgbasho dzɛ yi otsema mani. O nya Abrahan gbɛɛ, &lt;Ikpewo etɔ mgbi abu inggisɛ mi ɛsɛ duu ka tu mse.&gt; <verse eid="ACT 3:25"/><verse number="26" style="v" sid="ACT 3:26"/>Onɔ ngwi Imgbasho dulu ongbidɔ mgban ma, o kyon dɛsɔ mbi ema ababɔ ikye okye mse bɛ ema ewo mi okyata ema mi imbali mgbi ema.&gt;&gt;<verse eid="ACT 3:26"/></para>
  <chapter eid="ACT 3"/>
  <chapter number="4" style="c" sid="ACT 4"/>
  <para style="s1">A kye iPyita yi iJɔn ba inɛ okwakye <optbreak/> mgbi emi iJuda</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 4:1"/>Ama ofifɛ mgbi Imgbasho yi inggisɛ ogbe obaka ama ongyo ozu okwukwo osunu Imgbasho mi iJerosalin teyi bɛyi emi iSadusi ba mbi iPyita yi iJɔn mi onɔ ngwi a kale gbɔdzɛ yi inggisɛ ntona mani. <verse eid="ACT 4:1"/><verse number="2" style="v" sid="ACT 4:2"/>I kaka ma ewo kpakpa ikyekyɛ ama ogbikye iYesu le tso inggisɛ ntona dile gbɔ okyɛɛ-kyɛɛ mi ikwu mgbi iYesu kpaa. <verse eid="ACT 4:2"/><verse number="3" style="v" sid="ACT 4:3"/>A bwa iPyita yi iJɔn, ma ikyegbɛɛ onɔ gbɛsɛ nɛ, a kye ma wokɛ obawi nghataa egbe fa. <verse eid="ACT 4:3"/><verse number="4" style="v" sid="ACT 4:4"/>Nghaduu ibyi inggisɛ ama nfwo esɔ na duu noyɛyɛ, nɛ mmbwo mgbi ama okyɛdɔ iYesu si she mɛ dafi idubu eda sini.<verse eid="ACT 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 4:5"/>Tegblifan nɛ, ama ogbe inggisɛ teyi, engyukwo bɛyi etsetse mgbi ola mgbi iMose kwakye mi iJerosalin. <verse eid="ACT 4:5"/><verse number="6" style="v" sid="ACT 4:6"/>Anna okwukwo inggisɛ ofifɛ na dzɛ mmanani, yi iKayafa, iJɔn, Alekidzanda bɛyi inggisɛ angbeka mi etɔ mgbi okwukwo inggisɛ ofifɛ nani. <verse eid="ACT 4:6"/><verse number="7" style="v" sid="ACT 4:7"/>A nu ma kye iPyita bɛyi iJɔn ba inai ma, si wita obyi ma gbɛɛ: &lt;&lt;Li mi ali mfye naadi ali iyi ngwi ema le kyungwɔnɛ?&gt;&gt;<verse eid="ACT 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 4:8"/>Nɛ iPyita, ngwu Onodzi Osaan shewo mbon na, nya ma gbɛɛ: &lt;&lt;Ema ama oteyi bɛyi engyukwo mgbi inggisɛ ntonɛnɛ! <verse eid="ACT 4:8"/><verse number="9" style="v" sid="ACT 4:9"/>Yeba ni a kwu eyi ela gbɛɛ ni eyi nu uka mi ikye ali osuse ngwi eyi kyɔ yi inggisɛ ngwu gbikye tukwu esɛ nɛ, di byita dafi a kyilon yɔ, <verse eid="ACT 4:9"/><verse number="10" style="v" sid="ACT 4:10"/>ngyɛse ye odzɛ nɛ na, ema yi emi Israi duu: Li mi iyi mgbi iYesu iKrestu ongwi iNadzareti, ongwu ema kyon gbokwo ekwatsi kpaa ngwu Imgbasho kyilon mi ikwu na, ngwi ootse mgbi inggisɛ nɛ ngyɛ ngwi o kwuzunto mi inai ema aani. <verse eid="ACT 4:10"/><verse number="11" style="v" sid="ACT 4:11"/>O li</para>
  <para style="q1" vid="ACT 4:11">&lt;&lt; &lt;Ikwutsɛ ngwi ema ama ombɛ ozu fwan,</para>
  <para style="q2" vid="ACT 4:11">ngwi i wa yɛɛ ikwutsɛ okwulu ikye ozu mani.&gt;<verse eid="ACT 4:11"/></para>
  <para style="m">
    <verse number="12" style="v" sid="ACT 4:12"/>Owatɔ dzɛ mbi inggisɛ oka ba, ikyesinɛ iyi oka dzɛma mi ɛsɛ nɛ ngwi a kye nu gbɛɛ inggisɛ ka watɔ kyɛmɛ ba.&gt;&gt;<verse eid="ACT 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 4:13"/>Ngwi okwakye di abɔ otsigɛgɛ mgbi iPyita bɛyi iJɔn di difwi gbɛɛ a kpayi afɛ ba, a li inggisɛ ama n ye unka ba nɛ, i kwulu ma ewo man a kwambɛ gbɛɛ inggisɛ ntonɛ nose dzɛ yi iYesu. <verse eid="ACT 4:13"/><verse number="14" style="v" sid="ACT 4:14"/>Nghaduu ngwi a di inggisɛ ongwu a ngyɛlun ootse na kwudzɛ yi ama nɛ, odzɛ onyi kpaa dzɛma ngwi a ka gbɔ ba. <verse eid="ACT 4:14"/><verse number="15" style="v" sid="ACT 4:15"/>Nghanɛ a nya ma gbɛɛ nu ma dzata okwakye, ta a si wita okponya yi ewoma. <verse eid="ACT 4:15"/><verse number="16" style="v" sid="ACT 4:16"/>A byita gbɛɛ, &lt;&lt;Li alungwɔ ngwi eyi ka kyɔ yi engyulɔ ntonɛ?&gt;&gt; &lt;&lt;Bana ali inggisɛ ndzɛ iJerosalin duu ye gbɛɛ a kyungwɔ okwulewo okwukwo, ma eyi ka tangwan gbɛ ba. <verse eid="ACT 4:16"/><verse number="17" style="v" sid="ACT 4:17"/>Kpaa onu ungwɔnɛ kwulɛsɛ mi ogbɔfwɛ kiyayi mi idzidzɛ inggisɛ yɔ, eyi ka wo inggisɛ ntonɛ ola kyɛmɛ gbɛɛ, nu ma ka gbɔdzɛ yi inggisɛ onyi kpaa mi iyi nɛ wuba.&gt;&gt;<verse eid="ACT 4:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 4:18"/>Nɛ a di kwu ma ela ba ifun si wo ma ola gbɛɛ, nu ma ka gbɔdzɛ hona tsungwɔ mi iyi mgbi iYesu wuba du. <verse eid="ACT 4:18"/><verse number="19" style="v" sid="ACT 4:19"/>Nghaduu iPyita yi iJɔn nu uka gbɛɛ, &lt;&lt;Tsɛwɛ abuema na ni i tishi mi inɛ Imgbasho gbɛɛ ni eyi fwo ema dzata Imgbasho yɔ. <verse eid="ACT 4:19"/><verse number="20" style="v" sid="ACT 4:20"/>Lubana eyi ka yagba sɔ shili mi ungwɔ ngwi eyi di diyɛ fwo gbɛ ba.&gt;&gt;<verse eid="ACT 4:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 4:21"/>Ngwi a di wo ma ola yɛɛyɛ nɛ, a nu ma lu. A yagba ye dafi ama ka kwo ma adɔ ba, ikyekyɛ ali inggisɛ duu le tsɛ Imgbasho mi ungwɔ nkyɔ nyɛ nani. <verse eid="ACT 4:21"/><verse number="22" style="v" sid="ACT 4:22"/>Ikyesinɛ inggisɛ ngwu a ngyɛlun ootse kwulewo na, ngha onova ngwusefa wa.<verse eid="ACT 4:22"/></para>
  <para style="s1">Ibɔ mgbi ama onoyɛyɛ</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 4:23"/>Ngwi a dzɛ ma ta ma; iPyita yi iJɔn yidɔ lu mbi emidama ka nya ma alungwɔ ngwi engyukwo ama ofifɛ yi emi obɔtsɛ gbɔ yi ama mani. <verse eid="ACT 4:23"/><verse number="24" style="v" sid="ACT 4:24"/>Onɔ ngwi a fwo odzɛ nɛ nɛ, a kyile ela mgbi ama esho yi eka mi ibɔ mbi Imgbasho. A gbɛɛ &lt;&lt;Otsɛ Imgbasho onghaangha, abu ta esho yi esɛ yi ekyoo okwukwo, yi alungwɔ nto efu duu. <verse eid="ACT 4:24"/><verse number="25" style="v" sid="ACT 4:25"/>Abu gbɔdzɛ mi Onodzi Osaan nyɛ ondu mgbi ongbidɔ mgbi abu, otseyi iDevedi gbɛɛ:</para>
  <para style="q1" vid="ACT 4:25">&lt;&lt; &lt;Kyɔnɛ ngwi Udzengye le kyitingga</para>
  <para style="q2" vid="ACT 4:25">ngwi inggisɛ dile tsɛwodzɛ ikwangha?<verse eid="ACT 4:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 4:26"/>Utɔ ongwi ɛsɛ nɛ li tsɛwɛ ika</para>
  <para style="q2" vid="ACT 4:26">man ama ogbe inggisɛ teyi li kwakye yi eka</para>
  <para style="q1" vid="ACT 4:26">kye afɔ twɛsɛ yi Otsɛ Imgbasho</para>
  <para style="q2" vid="ACT 4:26">bɛyi iMedzaya mgban kpaa.&gt;<verse eid="ACT 4:26"/></para>
  <para style="m">
    <verse number="27" style="v" sid="ACT 4:27"/>Mi otsitsi yɔ, iHerude yi iPontu iPlatu kye ewoma kwakye yi Udzengye bɛyi emi Israi mi ogalu nɛni ikye okye afɔ twɛsɛ yi ongbidɔ mgbi abu osaan iYesu, ongwu abu kye engyie kyun ikye nani. <verse eid="ACT 4:27"/><verse number="28" style="v" sid="ACT 4:28"/>A kyungwɔ ngwi mfye yi oweka mgbi abu teyi kye bwalu dzɛ esɛ gbɛɛ ka kyɔ mani. <verse eid="ACT 4:28"/><verse number="29" style="v" sid="ACT 4:29"/>Ngwi i dzɛ nghanɛ Otsɛ Imgbasho, di mi ega odzɛɛdzɛ mgbi ama di tobyi engbidɔ mgbi abu nu ma gbeesɔ mgbi abu yi abɔ otsigɛgɛ. <verse eid="ACT 4:29"/><verse number="30" style="v" sid="ACT 4:30"/>Na abɔ mgbi abu ikye ongyɛlu ootse di kyɔ ambɛ ama okwulewo yi ungwɔ okwulewo mi iyi mgbi ongbidɔ mgbi abu osaan iYesu.&gt;&gt;<verse eid="ACT 4:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 4:31"/>Ngwi a bibɔ ngyɛ nɛ, imbe ngwi a kwakye ma suusu. Ta ama duu a mbwo ma yi Onodzi Osaan man a si gbeesɔ Imgbasho yi abɔ otsigɛgɛ.<verse eid="ACT 4:31"/></para>
  <para style="s1">Ama onoyɛyɛ gha ungwɔ ngwi <optbreak/> ama dzɛyan</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 4:32"/>Ama onoyɛyɛ ntona duu dzɛ yi itukwu onyi. Onyi mboma kpaa li tso gbɛɛ ungwɔ ngwi ongwu dzɛyan li mgbi ongwu ba, kpaa a li kye ghalu alungwɔ ngwi a dzɛyan duu. <verse eid="ACT 4:32"/><verse number="33" style="v" sid="ACT 4:33"/>Yi mfye okwulewo ama ogbikye iYesu ntona kiyayi okyɔ obwɛndɛ mi okyɛɛ-kyɛɛ mgbi Otsɛ iYesu mi ikwu, elela mgbi Imgbasho di dzɛ yi ama kpakpa. <verse eid="ACT 4:33"/><verse number="34" style="v" sid="ACT 4:34"/>Ungwɔ kwo inggisɛ onyi kpaa oba mi idzidzɛ ma ba. Ikyesinɛ alonɔ duu ama ndzɛ yi ikpɛsɛ naadi ozu li kye gya, kye awuya ngwi a kye gya ma ba <verse eid="ACT 4:34"/><verse number="35" style="v" sid="ACT 4:35"/>wa nu ama ogbikye iYesu, ta a li gha nu ali inggisɛ dafi imina mgbi otsungwɔn dzɛ mani.<verse eid="ACT 4:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 4:36"/>IJose, inggisɛ iLevi kyɛ mi iSapru, ongwu ama ogbikye iYesu kwun di iBanabasi (ngwi itan gbɛɛ ongwɛ onu itukwu ofyumfye-fyumfye), <verse eid="ACT 4:36"/><verse number="37" style="v" sid="ACT 4:37"/>kye ikpɛsɛ mgban gya kyelu awuya ma ba wa lakiyayi ama ogbikye iYesu.<verse eid="ACT 4:37"/></para>
  <chapter eid="ACT 4"/>
  <chapter number="5" style="c" sid="ACT 5"/>
  <para style="s1">Anania yi iSafira</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 5:1"/>Nɛ inggisɛ ngwu iyin di Anania, bɛyi owan iSafira, kpaa kye ikpɛsɛ gya. <verse eid="ACT 5:1"/><verse number="2" style="v" sid="ACT 5:2"/>Yi oye-ye mgbi owan saan o kye mwalu awuya na da ikye ewon, man kye ongwi nsisi ma ba wa lakiyayi mgbi ama ogbikye iYesu.<verse eid="ACT 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 5:3"/>IPyita si gbɛɛ, &lt;&lt;Anania, kyɔsinɛ ngwi iSatan gbɛ abu itukwu sɔ nghaa, ngwi abu mwonya nya Onodzi Osaan di kye mwalu awuya ngwi abu kye ikpɛsɛ gya kye dzɛ ewabu kɛ? <verse eid="ACT 5:3"/><verse number="4" style="v" sid="ACT 5:4"/>I plɛ li mgbi abu duuse abu kye gya lo? Ma ngwi abu kye gya ma, awuya ma li mgbi abu baa? Li alungwɔ nu abu tsɛwɛ okyɔ itɔ ungwɔnɛ? Li inggisɛ ngwu abu mwonya nya ba, kpaa li Imgbasho.&gt;&gt;<verse eid="ACT 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 5:5"/>Ngwi Anania fwo odzɛ nɛ mata, o si gbɛsɛ kwulu. Nɛ imio wo ali inggisɛ nfwo ungwɔ nkyɔ na duu. <verse eid="ACT 5:5"/><verse number="6" style="v" sid="ACT 5:6"/>Nɛta ɛngbɛ mmafa tɔ ba wa kye ikwɔ mgban ndi wokɛ angwuto, kyon lu ka ndzi. <verse eid="ACT 5:6"/><verse number="7" style="v" sid="ACT 5:7"/>I nyɛ obyi eta man owan wa kaka, o ye ungwɔ nkyɔ waba. <verse eid="ACT 5:7"/><verse number="8" style="v" sid="ACT 5:8"/>IPyita byun gbɛɛ, &lt;&lt;Nya ani, li mmya ngwi abu yi Anania tu mi ikpɛsɛ na dɛɛn?&gt;&gt; O gbɛɛ, &lt;&lt;Ɛɛn, li mmya ma aani.&gt;&gt;<verse eid="ACT 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 5:9"/>IPyita nyan gbɛɛ, &lt;&lt;Kyɔsinɛse ngwi ema bwondu ombadi Onodzi mgbi Otsɛ Imgbasho? Di! Atafɔ mgbi inggisɛ ama nkye obabu ndzi to onufɛ aali, ma a dika kye abu kpaa tasɛ.&gt;&gt;<verse eid="ACT 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 5:10"/>Mi onɔ na mata o gbɛsɛ lakiyayi mgbi iPyita si kwulu. Nɛ ɛngbɛ mmafa ntona kaka ifun, ngwi a di gbɛɛ o kwulu nɛ, a kyon tasɛ lu ka ndzi mi ewo endzi mgbi oban. <verse eid="ACT 5:10"/><verse number="11" style="v" sid="ACT 5:11"/>Imio wo emi iKrestu kpakpa bɛyi ama nfwo ungwɔ nkyɔ na duu.<verse eid="ACT 5:11"/></para>
  <para style="s1">Ama ogbikye iYesu ngyɛlu ibyi <optbreak/> inggisɛ ootse</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 5:12"/>Ama ogbikye iYesu kyɔ ambɛ ama okwulewo ibyibyi yi ungwɔ ama okwulewo mi idzidzɛ inggisɛ ntonani. Ma ama onoyɛyɛ ntona duu li kwakye yi ewoma mi iwulu onufɛ mgbi iSolomu. <verse eid="ACT 5:12"/><verse number="13" style="v" sid="ACT 5:13"/>Dafi inggisɛ kye ma wuuta kpakpa nɛ kpaa, inggisɛ onyi li boofɛ ka kwakye yi ama ba. <verse eid="ACT 5:13"/><verse number="14" style="v" sid="ACT 5:14"/>Nghaduu, engyulɔ yi engyaa kwuba noyɛyɛ mbi Otsɛ di mbwo ma mmbwo. <verse eid="ACT 5:14"/><verse number="15" style="v" sid="ACT 5:15"/>Ikyenghanɛ, inggisɛ kye ama ndotse ba ondoofɛ wa lakɛ akwulo yi obutu gbɛɛ ni i ndɛndɛ kpaa onodzi mgbi iPyita no gbo tukwu angbeka mi ele mi onɔ ngwi o le nyɛ mani. <verse eid="ACT 5:15"/><verse number="16" style="v" sid="ACT 5:16"/>A gbe ibyi inggisɛ kyɛ igeli ama nto kwɛkwɛ wa kwakye mi iJerosalin, ama ndotse yi ama ngwu onodzi ibwubwe ngwunu ma, a si ngyɛlu ama duu ootse.<verse eid="ACT 5:16"/></para>
  <para style="s1">A nu ama ogbikye iYesu isɔ</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 5:17"/>Nɛ okwukwo inggisɛ ofifɛ bɛyi ama okyɛdɔn duu, ama nto mi ayɛ mgbi iSadusi ma, yɛɛ okyɔ ama ogbikye iYesu uwaba. <verse eid="ACT 5:17"/><verse number="18" style="v" sid="ACT 5:18"/>A bwa ama ogbikye iYesu ntona gbe ma wokɛ obawi ndzɛ ikye ali inggisɛ duu mani. <verse eid="ACT 5:18"/><verse number="19" style="v" sid="ACT 5:19"/>Nghaduu, mi otu ma ongyesɔ mgbi Otsɛ kyi kwulu onufɛ obawi gbe ma tasɛ. <verse eid="ACT 5:19"/><verse number="20" style="v" sid="ACT 5:20"/>O gbɛɛ, &lt;&lt;Lu na, ka kwudzɛkɛ mi ifyudɛ ozu okwukwo osunu Imgbasho mi iJerosalin, di nya inggisɛ ntona esɔ mgbi oshishe ofufɛ nɛ yɛɛyɛ.&gt;&gt;<verse eid="ACT 5:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 5:21"/>Ngwi egbe fa nɛ, a kaka imbe okwakye mi ozu okwukwo osunu Imgbasho mi iJerosalin, dafi a plɛ nya ma mani, si wita otso inggisɛ ntonani.</para>
  <para style="p" vid="ACT 5:21">Onɔ ngwi okwukwo inggisɛ ofifɛ yi ama okyɛdɔn wa to nɛ, a kwu ewoma ela okwakye bɛyi engyukwo emi Israi duu. Ta a dɛsɔ kɛ obawi gbɛɛ nu ma kye ama ogbikye iYesu ntona wa nu ma. <verse eid="ACT 5:21"/><verse number="22" style="v" sid="ACT 5:22"/>Nghaduu ngwi a ka to obawi nɛ, emi idɔ ntona di ma mmana ba. Nɛ a yidɔ ka nya ma gbɛɛ, <verse eid="ACT 5:22"/><verse number="23" style="v" sid="ACT 5:23"/>&lt;&lt;Eyi kɛ ka di obawi tukwu saan, yi ama ongyoongyo kwudzɛ to onufɛ; kpaa ngwi eyi kwulu onufɛ nɛ, eyi di inggisɛ onyi mi ifun ba.&gt;&gt; <verse eid="ACT 5:23"/><verse number="24" style="v" sid="ACT 5:24"/>Ngwi ongyukwo obaka mi ozu okwukwo osunu Imgbasho mi iJerosalin bɛyi engyukwo ama ofifɛ fwo esɔ nɛ ma i wo ma ɛndɛ, a le tsɛwɛ ungwɔ nkiyayi mani.<verse eid="ACT 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 5:25"/>Nɛ inggisɛ oka si ba wa gbɛɛ, &lt;&lt;Dika! Engyulɔ ngwu ema gbe ma wo obawi ntona, to ifyudɛ ozu okwukwo osunu Imgbasho mi iJerosalin le tsungwɔ ma.&gt;&gt; <verse eid="ACT 5:25"/><verse number="26" style="v" sid="ACT 5:26"/>Mi odzɛ na na, inggisɛ ogbe ama ongyo obawi teyi kɛ yi emi idɔ mgban ka kye ama ogbikye iYesu ntona luba. A kyɔ mi mfye ba, ikyekyɛ a mio gbɛɛ inggisɛ ntona wa tsɛ ama akwutsɛ.<verse eid="ACT 5:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 5:27"/>Ngwi a kye ama ogbikye iYesu ba nɛ, a nu ma ba inai okwakye adzi nii okwukwo inggisɛ ofifɛ byi ma ita. <verse eid="ACT 5:27"/><verse number="28" style="v" sid="ACT 5:28"/>O gbɛɛ, &lt;&lt;Eyi wo ema ola kpɔklɔɔ gbɛɛ ni ema ka tsungwɔ mi iyi nɛ ba. Nghaduu ema gbɔfwɛ otsootso mgbi ema mi iJerosalin wa, di mina onu eyi gye obube mi eyi mgbi inggisɛ nɛni.&gt;&gt;<verse eid="ACT 5:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 5:29"/>IPyita yi ama ogbikye iYesu angbeka ntona nu uka gbɛɛ: &lt;&lt;Li Imgbasho ngwu eyi ka kyɔ ola mgban kyɛmɛ aali li inggisɛ ba! <verse eid="ACT 5:29"/><verse number="30" style="v" sid="ACT 5:30"/>Imgbasho mgbi emi otseyi kyile iYesu mi ikwu, ongwu ema ngwɔn mi okyon gbokwo ekwatsi nani. <verse eid="ACT 5:30"/><verse number="31" style="v" sid="ACT 5:31"/>Imgbasho kyilon esho kyon dzɛkɛ abugye mgbi ongwu dafi Ongwuutɔ yi Onagbɛ mani, adzi non nu okyatitukwu bɛyi odzita inggisɛ yi ali ibwubwe mbi emi Israi. <verse eid="ACT 5:31"/><verse number="32" style="v" sid="ACT 5:32"/>Eyi li obwɛndɛ mgbi ungwɔ ntonɛni, bɛyi Onodzi Osaan ongwu Imgbasho kye nu ama osunun na kpaa.&gt;&gt;<verse eid="ACT 5:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 5:33"/>Onɔ ngwi emi okwakye ntonɛ fwo odzɛ nɛ ma, itukwu fu loma kpakpa a di mina okye ngwɔlu ma. <verse eid="ACT 5:33"/><verse number="34" style="v" sid="ACT 5:34"/>Nghaduu inggisɛ iFarasi ngwu a li kwun gbɛɛ iGamalie, otsetse mgbi ola mgbi iMose, ongwu inggisɛ ntona tsatsadu nun mmwɛ, kyato mi okwakye noola gbɛɛ ni a kye ama ogbikye iYesu ntona tokɛ esɛ mi onɔ gwee se. <verse eid="ACT 5:34"/><verse number="35" style="v" sid="ACT 5:35"/>Nɛ o si gbɔdzɛ yi ama gbɛɛ: &lt;&lt;Ema emi Israi, kyɔ dumɔɔ mi ungwɔ ngwi ema tsɛwɛ okyɔ yi engyulɔ ntonɛ nɛni. <verse eid="ACT 5:35"/><verse number="36" style="v" sid="ACT 5:36"/>Ongwɛ onɔ ngwi nyɛ ma iTeuda tɔ, le tso gbɛɛ ongwu li ungwɔ, nɛ inggisɛ mɛ ideli enɛ kyɛdɔn. A ngwɔn, ama okyɛdɔn duu ganya, ta alungwɔ duu yɛɛ mnana. <verse eid="ACT 5:36"/><verse number="37" style="v" sid="ACT 5:37"/>Ongwu nyɛ, iJuda ongwi iGalalia tɔ mi egbe olɔ umbwo man inggisɛ ibyibyi di kyɛdɔn. Ongwu kpaa a ngwɔn, ta ama okyɛdɔn duu ganya. <verse eid="ACT 5:37"/><verse number="38" style="v" sid="ACT 5:38"/>Inghawanɛ, mi odzɛ nɛ, ani le wɛ ema odzɛ gbɛɛ: dzata engyulɔ ntonɛ nu ma lu! Ikyesinɛ ni itɔdzɛ hona okyɔɔkyɔ mgbi ama tiita mbi inggisɛ owamyɛ yɔ, ka dondu. <verse eid="ACT 5:38"/><verse number="39" style="v" sid="ACT 5:39"/>Kpaa ni i kyɛ mbi Imgbasho yɔ, ema ka yagba ngha ma ba; ema ka di ewema kye afɔ twɛsɛ yi Imgbasho ta.&gt;&gt;<verse eid="ACT 5:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 5:40"/>A si gbɛ elodzɛ mgban, ta a kwu ama ogbikye iYesu ela si gbo ma ibe. Man wo ma ola gbɛɛ, nu ma ka gbɔdzɛ mi iyi mgbi iYesu wuba, si nu ma lu.<verse eid="ACT 5:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="ACT 5:41"/>Ama ogbikye iYesu ntona dzita okwakye, le tsatsa ikyekyɛ Imgbasho kye ama wuuta dafi ama gyadzɛ tu ayiwi mi ikye iyi mgbi iYesu mani. <verse eid="ACT 5:41"/><verse number="42" style="v" sid="ACT 5:42"/>Alegbe-alegbe, mi okwakye mi ozu okwukwo osunu Imgbasho mi iJerosalin bɛyi udɛ udɛ, a yama nya ole tso dile gbɔ Esɔ Osuse gbɛɛ iYesu li iMedzaya ba.<verse eid="ACT 5:42"/></para>
  <chapter eid="ACT 5"/>
  <chapter number="6" style="c" sid="ACT 6"/>
  <para style="s1">A sadu inggisɛ egyafa</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 6:1"/>Mi onɔ ngwi engwafɔ mgbi iYesu wale mbwo kpakpa nɛ, emi iJuda ama ogbɔ ondu iGriki le kwondukwɔ ikye ama ogbɔ ondu iHibru ikyekyɛ a kye owakwadɛ mgbi ama wuuta mi ungwogye ngwi a li gha alegbe-alegbe na ba. <verse eid="ACT 6:1"/><verse number="2" style="v" sid="ACT 6:2"/>Nghanɛ ama ogbikye iYesu iwyodefa ntona kwu ama onoyɛyɛ ntona duu kwakye si gbɛɛ, &lt;&lt;Ka li ayin ba kini eyi dzita idɔ mgbi elodzɛ Imgbasho yɛ le gha ungwogye yɔ. <verse eid="ACT 6:2"/><verse number="3" style="v" sid="ACT 6:3"/>Emi ongwunani, sadu engyulɔ egyafa mi idzidzɛ ema, ama ngwu ema ye gbɛɛ a dzɛ yi Onodzi saan yi ozoyeye mani. Eyi ka yile idɔ nɛ wo ma abɔ <verse eid="ACT 6:3"/><verse number="4" style="v" sid="ACT 6:4"/>ta eyi ka yile itukwu mgbi eyi nu mi ibɔ yi idɔ mgbi elodzɛ Imgbasho.&gt;&gt;<verse eid="ACT 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 6:5"/>Ewodzɛ nɛ kpa inggisɛ ntona duu. A sadu iStivin, inggisɛ ngwu mbwo yi oyɛyɛ onuunu bɛyi Onodzi Osaan; iFyilipi kpaa, iProkoru, iNikano, iTimɔn, iPamena, bɛyi iNikola ongwu nkyɛ mi Antiɔku, nkyata luba odzɛ Imgbasho mgbi emi iJuda nani. <verse eid="ACT 6:5"/><verse number="6" style="v" sid="ACT 6:6"/>A gbe inggisɛ ntona tso ama ogbikye iYesu, man a bibɔ woma di kye abɔ dɔ ma ikye.<verse eid="ACT 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 6:7"/>Nghanɛ elodzɛ Imgbasho gbɔfwɛ. Mmbwo mgbi engwafɔ iYesu mi iJerosalin she kpakpa, nɛ ama ofifɛ kwuba yɛɛ ama onoyɛyɛ.<verse eid="ACT 6:7"/></para>
  <para style="s1">A bwa iStivin</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 6:8"/>Nɛ iStivin, inggisɛ ngwu elela mgbi Imgbasho dzɛ mbon yi mfye kpakpa, kyungwɔ ama okwulewo yi ambɛ okwulewo mi idzidzɛ inggisɛ ntonani. <verse eid="ACT 6:8"/><verse number="9" style="v" sid="ACT 6:9"/>Nɛ, inggisɛ angbeka mi ozu okwakye mgbi ofyɛɛ ama a shɛ ma adi ta wita otangwodzɛ yi iStivin. A li emi iJuda ama nkyɛ iSirini yi Alekdzandra bɛyi ayɛsɛ mgbi iSilisia yi Asia. <verse eid="ACT 6:9"/><verse number="10" style="v" sid="ACT 6:10"/>Nghaduu a yagba kye afɔ twɛsɛ yi ozoyeye mgban hona Onodzi ndzɛ mbon ma ba.<verse eid="ACT 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 6:11"/>Nɛ a wɛ inggisɛ angbeka ɛwɛ daada ikye nu ma gbɛɛ, &lt;&lt;Eyi fwo iStivin gbɔ elodzɛ ofya iMose yi Imgbasho ito.&gt;&gt;<verse eid="ACT 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 6:12"/>Mi odzɛ nɛ, a kyile inggisɛ ntona angbi yi engyukwo bɛyi etsetse mgbi ola mgbi iMose. A bwa iStivin kyon ba okwakye. <verse eid="ACT 6:12"/><verse number="13" style="v" sid="ACT 6:13"/>A gbe ama omwonya angbeka ba, wa mwonya gbɛɛ, &lt;&lt;Inggisɛ nɛ nya ogbɔdzɛ obube ikpewo imbe osaan nɛ bɛyi ola waba. <verse eid="ACT 6:13"/><verse number="14" style="v" sid="ACT 6:14"/>Ikyesinɛ eyi fwon le gbɔgbɛɛ iYesu ongwi iNadzareti nɛ ka bulu imbe nɛ di nyinɛ aletɔ ngwi iMose kye wo eyi abɔ nɛni.&gt;&gt;<verse eid="ACT 6:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 6:15"/>Ama nsɔto okwakye duu kye inɛ fyakwu iStivin, man a di inɛ mgban dzɛ dafi inɛ mgbi ongyesɔ mani.<verse eid="ACT 6:15"/></para>
  <chapter eid="ACT 6"/>
  <chapter number="7" style="c" sid="ACT 7"/>
  <para style="s1">Elodzɛ mgbi iStivin mbi okwakye</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 7:1"/>Nɛ okwukwo inggisɛ ofifɛ byun gbɛɛ, &lt;&lt;Odzɛ ntonɛ li otsitsii?&gt;&gt;<verse eid="ACT 7:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 7:2"/>IStivin nu uka gbɛɛ: &lt;&lt;Emi ongwunani yi emi otsani, gadɔ mbi ani na! Imgbasho mgbi okwɔkwɔ tɔ tu otseyi Abrahan ngwi o ka dzɛ iMesopotamia mani, duuse o wa dzɛ iHaran. <verse eid="ACT 7:2"/><verse number="3" style="v" sid="ACT 7:3"/>Imgbasho gbɛɛ, &lt;Dzita ɛsɛ mgbi abu yi emidabu, lu ikpɛsɛ ngwi ani ka tso abu mani.&gt;<verse eid="ACT 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 7:4"/>&lt;&lt;Nghanɛ o dzita ikpɛsɛ mgbi emi iCadia lu ka sɔ iHaran. Ngwi otsɔn wa kwulu nyɛ nɛ, Imgbasho dɔn esɔ ba ikpɛsɛ ngwi ema todzɛ ele onɛnɛ nɛni. <verse eid="ACT 7:4"/><verse number="5" style="v" sid="ACT 7:5"/>Imgbasho nun okwudɛ onyi mmɛnɛ ba, atafɔ ikpɛsɛ onyi kpaa ba. Nghaduu Imgbasho zondu yan gbɛɛ ongwu yi etɔ mgban ka yɛɛ otsungwɔ ikpɛsɛ nɛni, nghataa gyegwu. Mi onɔ na Abrahan dzɛ yi ongwɛ waba. <verse eid="ACT 7:5"/><verse number="6" style="v" sid="ACT 7:6"/>Li odzɛ ngwi Imgbasho gbɔ yan aani: &lt;Etɔ mgbi ema ka li ingyoga mi ɛsɛ ngwi li mgbi ama ba, a ka kwu ma ofyɛɛ di nu ma adzɛ mi onova ideli enɛ. <verse eid="ACT 7:6"/><verse number="7" style="v" sid="ACT 7:7"/>Imgbasho gbɛɛ, nghaduu ani ka kwo ɛsɛ ngwi a to ele dafi ofyɛɛ ma adɔ, ngyɛduu a ka tasɛ mi ɛsɛ na wa sunu ani mi imbe nɛni.&gt; <verse eid="ACT 7:7"/><verse number="8" style="v" sid="ACT 7:8"/>Nɛ o nu Abrahan ondu odzɛɛdzɛ mgbi ikyɛ okyɛ-kyɛ. Man Abrahan yɛɛ otsɔ Adziki di kyan ikyɛ ngwi a mban nyɛ egbe egyata mani. Adziki wa yɛɛ otsɔ iJeko, iJeko di wa yɛɛ otsɔ iwyodefa emi otsikyeyi ntonani.<verse eid="ACT 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 7:9"/>&lt;&lt;Ikyegbɛɛ emi otsikyeyi ntona di iJose tanyi nɛ, a kyon gya dafi ofyɛɛ lu Igyibiti. Nghaduu Imgbasho dzɛyan <verse eid="ACT 7:9"/><verse number="10" style="v" sid="ACT 7:10"/>di dulun tɔ mi okakewo mgban duu. Imgbasho nu iJose ozoyeye di yan abɔ nu untsɛ osuse dɔn mbi iFaro utɔ mgbi emi Igyibiti; nghanɛ o non yɛɛ inggisɛ ogbe emi Igyibiti teyi yi udɛ mgbi ongwu duu.<verse eid="ACT 7:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 7:11"/>&lt;&lt;Nɛ omani wa dɔ mi Igyibiti yi iKana duu, kye adzɛ kpakpa ba, emi otseyi si tu ungwogye wuba. <verse eid="ACT 7:11"/><verse number="12" style="v" sid="ACT 7:12"/>Onɔ ngwi iJeko fwo gbɛɛ ungwogyowe dzɛ Igyibiti nɛ, o dɔ emi otseyi esɔ kɛ ele ababɔ. <verse eid="ACT 7:12"/><verse number="13" style="v" sid="ACT 7:13"/>Mi okɛɛkɛ mgbi ama ongwu fan ma, iJose nya emi ongwunɔn inggisɛ ngwu ongwu dzɛ mani, man iFaro si ye odzɛ etɔ mgbi iJose. <verse eid="ACT 7:13"/><verse number="14" style="v" sid="ACT 7:14"/>Ngwi ungwɔnɛ nyɛ nɛ, iJose dɛsɔ mbi otsɔn iJeko yi etɔ mgban duu, a li ngwuseta dɔn iwyo diwyeda duudu. <verse eid="ACT 7:14"/><verse number="15" style="v" sid="ACT 7:15"/>Nɛ iJeko si lu Igyibiti, li mi imbe na ngwi ama duu ka kwulu aali. <verse eid="ACT 7:15"/><verse number="16" style="v" sid="ACT 7:16"/>A yile ikwɔ mgbi ama luba iShekɛn wa ndzi mi endzi ngwi Abrahan gya nose mi abɔ mgbi emi ongwɛ iHamɔ mi awuya mani.<verse eid="ACT 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 7:17"/>&lt;&lt;Ngwi onɔ wa mba ngwi Imgbasho ka mbwo ondu odzɛɛdzɛ yi Abrahan nɛ, mmbwo mgbi emideyi mi Igyibiti she kpakpa. <verse eid="ACT 7:17"/><verse number="18" style="v" sid="ACT 7:18"/>Nɛ utɔ ofufɛ, ngwu ye unkonyi mi odzɛ mgbi iJose ba, yɛɛ utɔ mgbi Igyibiti. <verse eid="ACT 7:18"/><verse number="19" style="v" sid="ACT 7:19"/>O ngwunu emideyi di si emi otsikyeyi, gbɛɛ nu ma gbe engwengyulɔ eyeyi ngwuta adzi nu ma kwulu.<verse eid="ACT 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 7:20"/>&lt;&lt;Mi onɔ na a mba iMose, ma o li nngwadza mi inɛ mgbi Imgbasho. A gbɛwɛ byun mi udɛ otsɔn ofyia eta. <verse eid="ACT 7:20"/><verse number="21" style="v" sid="ACT 7:21"/>Ngwi a kyon tɔ dzata udɛ nɛ, ongwɛ iFaro ongwu ongyaa kyon si byun dafi ongwan mani. <verse eid="ACT 7:21"/><verse number="22" style="v" sid="ACT 7:22"/>A tso iMose ozoyeye mgbi emi Igyibiti tsatsa, o diyɛ datu mi elodzɛ yi okyɔɔkyɔ.<verse eid="ACT 7:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 7:23"/>&lt;&lt;Onɔ ngwi iMose li onova ngwusefa ma, itukwu kyɛɛ lon oka kpadi emi Israi emidan. <verse eid="ACT 7:23"/><verse number="24" style="v" sid="ACT 7:24"/>O di onyi mi ele ngwu inggisɛ Igyibiti le nun adzɛ, nghanɛ o kɛ oka tobyun di kpumkpa ikyon mi okyi ngwɔlu inggisɛ Igyibiti nani. <verse eid="ACT 7:24"/><verse number="25" style="v" sid="ACT 7:25"/>IMose tsɛwɛ gbɛɛ, emidongwu ka difwi gbɛɛ Imgbasho kye ongwu le kyidɔ ikye odulu ma tɔ, nghaduu kpaa a difwi ba. <verse eid="ACT 7:25"/><verse number="26" style="v" sid="ACT 7:26"/>Tegblifan iMose wa kpatsɛ yi emi Israi nghi efa tole gblibe. O fya oyile ma gyiide mi ogbɛɛ, &lt;Engyulɔ, ema li engwunɔ ewe kyɔsinɛ ngwi ema mina ota ewema mmya?&gt;<verse eid="ACT 7:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 7:27"/>&lt;&lt;Nghaduu ongwu nle kyɔ yi oka timbi ma tsamu iMose lu enggengga si gbɛɛ, &lt;Li emɛ nu abu mfye okye eyi teyi di gbɔ eyi ikwɔ? <verse eid="ACT 7:27"/><verse number="28" style="v" sid="ACT 7:28"/>I mina abu ongwɔ ani dafi abu ngwɔ inggisɛ Igyibiti edɛdɛ naa?&gt; <verse eid="ACT 7:28"/><verse number="29" style="v" sid="ACT 7:29"/>Ngwi iMose fwo odzɛ nɛ nɛ, o tsinya lu iMidian, imbe ngwi o ka dzɛ ingyoga di kye ongyaa mba ɛngbɛ efa.<verse eid="ACT 7:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 7:30"/>&lt;&lt;Ngwi i wa nyɛ onova ngwusefa nɛ, ongyesɔ mblegba tu iMose mi ambɛ mgbi oshɛ ogyola mi imbe okplagada kwɛkwɛ yi Unggwɔ iSinai. <verse eid="ACT 7:30"/><verse number="31" style="v" sid="ACT 7:31"/>Ngwi iMose di ungwɔnɛ nɛ, i kwulun ewo. Ngwi o gbo kɛ kwɛkwɛ oka di saan nɛ, o fwo ela mgbi Otsɛ Imgbasho gbɛɛ: <verse eid="ACT 7:31"/><verse number="32" style="v" sid="ACT 7:32"/>&lt;Ani li Imgbasho mgbi emi otsabu, Imgbasho mgbi Abrahan, Adziki yi iJeko.&gt; IMose tsaatsa yi imio di yagba kye inɛ byi ola na wuba.<verse eid="ACT 7:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 7:33"/>&lt;&lt;Nɛ Otsɛ Imgbasho si nyan gbɛɛ, &lt;Kyi dulu okpafɔ mgbi abu; ikyekyɛ imbe ngwi abu kwudzɛ nɛ li imbe osaan. <verse eid="ACT 7:33"/><verse number="34" style="v" sid="ACT 7:34"/>Ani di adzɛ mgbi emidani mi Igyibiti wa. Ani fwo andu omama mgbi ama di ba esɛ owa shɛ ma adi ta. Ba onɛnɛni, n ka dɔ abu esɔ yɛ kɛ Igyibiti.&gt;<verse eid="ACT 7:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 7:35"/>&lt;&lt;Nɛnɛ li iMose ngwu a teyi fwan yi elodzɛ gbɛɛ, &lt;Li emɛ nu abu li inggisɛ ogbe eyi teyi di gbɔ eyi ikwɔ?&gt; Li iMose nɛ kpɔɔ ngwu Imgbasho nyɛ mbi ongyesɔ mblegba tun ngwi oshɛ le gyola mani. Dɔn esɔ no ka li inggisɛ ogbe ma teyi di dulu ma tɔ. <verse eid="ACT 7:35"/><verse number="36" style="v" sid="ACT 7:36"/>O gbe ma tasɛ mi Igyibiti di kyungwɔ ama okwulewo yi emi ambɛ okwulewo mi Igyibiti, mi ekyoo omuma okwukwo yi imbe okplagada mi onova ngwusefa.<verse eid="ACT 7:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 7:37"/>&lt;&lt;Nɛnɛ li iMose ngwu nya emi Israi gbɛɛ, &lt;Imgbasho ka kye oyegbɔ ndzɛ dafi ani mi idzidzɛ ema dɛsɔ nu ema mani.&gt; <verse eid="ACT 7:37"/><verse number="38" style="v" sid="ACT 7:38"/>O wodzɛ okwakye mi imbe okplagada, yi ongyesɔ ngbɔdzɛ yan mi Unggwɔ ongwi iSinai, bɛyi emi otseyi; o di gbɛ elodzɛ oshishe okye wa gbɔ nya eyi.<verse eid="ACT 7:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 7:39"/>&lt;&lt;Nghaduu emi otsikyeyi gbela yan ba. A fwan, di mina gbɛɛ ama ki yɛ lu Igyibiti. <verse eid="ACT 7:39"/><verse number="40" style="v" sid="ACT 7:40"/>A nya Eron gbɛɛ, &lt;Mɛ eyi Imgbasho ama nka kye eyi teyi mani. Lubana iMose ngbe eyi tɔ mi Igyibiti nɛ, eyi ye ungwɔ nkyɔn ba!&gt; <verse eid="ACT 7:40"/><verse number="41" style="v" sid="ACT 7:41"/>Nana li onɔ nose ngwi a mɛ adagyɛ mi odzɛɛdzɛ mgbi ongwumnda mani. A gbe ifɛ ofɛ-fɛ ba ele di kyɔ oga osunu ungwɔ ngwi ama mɛ mi abɔ mgbi ama. <verse eid="ACT 7:41"/><verse number="42" style="v" sid="ACT 7:42"/>Nghanɛ Imgbasho fashi iyikpa tsɛ ma yile osusunu mgbi ama nu mcɛ mi esho. Ungwɔnɛ kwokyi yi ungwɔ ngwi a lɔ mi Afɛ mgbi ama ogbɛɛsɛ gbɛɛ:</para>
  <para style="q1" vid="ACT 7:42">&lt;&lt; &lt;Emi Israi! Li ani ngwu ema ngwɔ ifyungwɔ</para>
  <para style="q2" vid="ACT 7:42">di fifɛ nu mi onova ngwusefa mi imbe okplagadaa?<verse eid="ACT 7:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="ACT 7:43"/>Emi adagyɛ ngwi ema mɛ osunu nani,</para>
  <para style="q2" vid="ACT 7:43">ema kyile udɛ angwula ongwi iMoleki esho yi mcɛ</para>
  <para style="q2" vid="ACT 7:43">mgbi Imgbasho mgbi ema iRefanu.</para>
  <para style="q1" vid="ACT 7:43">Nghanɛ n ka lɔ ema onya lu anɔ oka&gt;</para>
  <para style="q2" vid="ACT 7:43">nyɛ-nyɛ iBabyilon kpaa.<verse eid="ACT 7:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 7:44"/>&lt;&lt;Emi otsikyeyi dzɛ yi iTabenako obwɛndɛ yi ama mi oshɛ. A man dafi Imgbasho tso iMose mi odzɛɛdzɛ ngwi o di mani. <verse eid="ACT 7:44"/><verse number="45" style="v" sid="ACT 7:45"/>Dafi a kyi gbɛlu iTabenako nɛ, emi otseyi kyi kyelu byi yi ama, mi onɔ ngwi iJoshua kye ma teyi kaka ɛsɛ ngwi Imgbasho kyi gbɛlu nu ma nani. I tila dzɛ ikpɛsɛ na nghataa ba onɔ mgbi iDevedi, <verse eid="ACT 7:45"/><verse number="46" style="v" sid="ACT 7:46"/>ngwu ikyese mgbi Imgbasho dɔn, o di bɔn ibɔ gbɛɛ ni ongwu mbɛ imbe ngwi Imgbasho mgbi iJeko ka dzɛ nani. <verse eid="ACT 7:46"/><verse number="47" style="v" sid="ACT 7:47"/>Kpaa li iSolomu mbaan ozu nani.<verse eid="ACT 7:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 7:48"/>&lt;&lt;Nghaduu, onghaangha na, li la ozu ngwi inggisɛ mbɛ ba. Dafi oyegbɔ gbɔgbɛɛ:<verse eid="ACT 7:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="ACT 7:49"/>&lt;&lt; &lt;Esho li esutɔ mgbi ani,</para>
  <para style="q2" vid="ACT 7:49">ɛsɛ li imbe mgbi ani ogbe afɔ dɔ.</para>
  <para style="q1" vid="ACT 7:49">Li ali itɔ ozu ngwi abu ka mbɛ ani ele?</para>
  <para style="q2" vid="ACT 7:49">Li ngha Imgbasho gbɔ aali.</para>
  <para style="q1" vid="ACT 7:49">Naadi li mi ole ngwi imbe</para>
  <para style="q2" vid="ACT 7:49">mgbi ani otonya ka dzɛ?<verse eid="ACT 7:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="ACT 7:50"/>Li abɔ mgbi ani mɛ</para>
  <para style="q2" vid="ACT 7:50">ungwɔ ntonɛ duu baa?&gt;<verse eid="ACT 7:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="ACT 7:51"/>&lt;&lt;Ema ama ndɔto ibiba dzɔgbɔ di kyiikyɛ mi itukwu yi adɔ ba nɛni! Ema to yɛyɛ dafi emi otsema mani: Ema li kye afɔ twɛsɛ yi Onodzi Osaan alonɔ duu! <verse eid="ACT 7:51"/><verse number="52" style="v" sid="ACT 7:52"/>Oyegbɔ teyi dzɛma ngwu emi otsikyema nose nun isɔ baa? A kye ngwɔlu ama ngbɔ obaaba mgbi ongwu nle saan na kpaa. Ma onɛnɛ ema kyon gya di ngwɔn wa. <verse eid="ACT 7:52"/><verse number="53" style="v" sid="ACT 7:53"/>Ema ama ngbɛ ola ngwi nyɛ abɔ ongyesɔ mgbi Imgbasho kpaa kyɔ mi ele ba nɛni.&gt;&gt;<verse eid="ACT 7:53"/></para>
  <para style="s1">A tsɛ iStivin akwutsɛ</para>
  <para style="p">
    <verse number="54" style="v" sid="ACT 7:54"/>Ngwi emi okwakye fwo odzɛ nɛ mi ondu mgban nɛ, a nyɛ yi itingga di kwolu inɛ ikye yan. <verse eid="ACT 7:54"/><verse number="55" style="v" sid="ACT 7:55"/>Kpaa iStivin, mbwo yi Onodzi Osaan, o ndinɛ kɛ esho si di okwɔkwɔ mgbi Imgbasho yi iYesu kwudzɛ abugye mgbi Imgbasho. <verse eid="ACT 7:55"/><verse number="56" style="v" sid="ACT 7:56"/>O gbɛɛ, &lt;&lt;Dika, ani di esho kwulu Ongwɛ Inggisɛ di kwudzɛ abugye mgbi Imgbasho.&gt;&gt;<verse eid="ACT 7:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="ACT 7:57"/>Mi odzɛ nɛ a kye abɔ tukwu adɔ mgbi ama, le kwu ela mi ela okwukwo, ama duu kyɛɛ tukwun, <verse eid="ACT 7:57"/><verse number="58" style="v" sid="ACT 7:58"/>kwon tasɛ mi ogalu si wita otsan akwutsɛ. Nghanɛ, emi obwɛndɛ gbe angwuto mgbi ama wa tokɛ iyayi mgbi ongwɛ mmafa ngwu a li kwun di iSol nani.<verse eid="ACT 7:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="ACT 7:59"/>Ngwi a le tsan akwutsɛ nɛ, iStivin bibɔ gbɛɛ, &lt;&lt;Otsɛ iYesu, kyi gbɛlu onodzi mgbi ani.&gt;&gt; <verse eid="ACT 7:59"/><verse number="60" style="v" sid="ACT 7:60"/>Nɛ o gbe akwafɔ kwokɛ esɛ makwɔ tɔ esɛ gbɛɛ, &lt;&lt;Otsɛ, ka wɛ alobube nɛ ikye ma ba.&gt;&gt; Ngwi o gbɔdzɛ nɛ mata, o si yulu.<verse eid="ACT 7:60"/></para>
  <chapter eid="ACT 7"/>
  <chapter number="8" style="c" sid="ACT 8"/>
  <para style="p">
    <verse number="1" style="v" sid="ACT 8:1"/>ISol dzɛ imbe nani di gbela ikwu iStivin.</para>
  <para style="s1" vid="ACT 8:1">ISol nu emi iKrestu isɔ</para>
  <para style="p" vid="ACT 8:1">Mi egbe na isɔ gbobu tɔ ikye emi iKrestu mi iJerosalin, nɛ ama duu ganya kpatsɛ iJudia yi iSamaria, i sisi ama ogbikye iYesu yuoma. <verse eid="ACT 8:1"/><verse number="2" style="v" sid="ACT 8:2"/>Emidi Imgbasho kye iStivin ndzi di tsukwu kpakpa ikyon. <verse eid="ACT 8:2"/><verse number="3" style="v" sid="ACT 8:3"/>Nghaduu iSol wita odzili emi iKrestu. O le kaka udɛ udɛ, le kwo ama onoyɛyɛ engyulɔ yi engyaa gbe ma wokɛ obawi.<verse eid="ACT 8:3"/></para>
  <para style="s1">IFyilipi gbeesɔ mi iBatlomi</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 8:4"/>Ama ngwu a ganya ma na, gbeesɔ nɛ mi ali imbe ngwi a kɛ duu. <verse eid="ACT 8:4"/><verse number="5" style="v" sid="ACT 8:5"/>IFyilipi kɛ ogalu oka mi iSamaria ka gbeesɔ mgbi iKrestu mi ele. <verse eid="ACT 8:5"/><verse number="6" style="v" sid="ACT 8:6"/>Ngwi ibyi ntona fwo iFyilipi di di ambɛ okwulewo ngwi o kyɔ nɛ, a nghao gbekabyi mi odzɛ ngwi o gbɔ mani. <verse eid="ACT 8:6"/><verse number="7" style="v" sid="ACT 8:7"/>Onodzi ama okpɛkpɛ tasɛ mbi inggisɛ ibyibyi yi ela ota-ta, ama ngwu alewo kwulu yi ama ngbikye tukwu esɛ kwuba a ngyɛlu ma ootse. <verse eid="ACT 8:7"/><verse number="8" style="v" sid="ACT 8:8"/>Man atsa si dzɛ ogalu na kpakpa.<verse eid="ACT 8:8"/></para>
  <para style="s1">ISaimɔn inggisɛ obudei</para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 8:9"/>Inggisɛ oka dzɛ ogalu na li kyɔ obudei onɔ kɛ, li kwulu emi iSamaria duu ewo kpakpa, a li kwun di iSaimɔn. O tsaabɔ igɛgɛ gbɛɛ ongwu li ongbodzi inggisɛ. <verse eid="ACT 8:9"/><verse number="10" style="v" sid="ACT 8:10"/>Ta ali inggisɛ, ama nshewo yi ama n yɛ esɛ duu, kye eka mgbi ama nu mbon si li wulu gbɛɛ, &lt;&lt;Inggisɛ nɛ li mfye mgbi Imgbasho ngwi a ye gbɛɛ li mfye ogbagbadzidzi mani.&gt;&gt; <verse eid="ACT 8:10"/><verse number="11" style="v" sid="ACT 8:11"/>A kyɛdɔn ikyekyɛ onɔ kɛ ngwi o le kyungwɔ okwulu ma ewo yi obudei mgban. <verse eid="ACT 8:11"/><verse number="12" style="v" sid="ACT 8:12"/>Kpaa ngwi a nu iFyilipi oyɛyɛ dafi o gbɔ Esɔ Osuse mgbi esutɔ mgbi Imgbasho bɛyi iyi mgbi iYesu iKrestu nɛ, a kyɔ ma iBatisima, engyulɔ yi engyaa duu. <verse eid="ACT 8:12"/><verse number="13" style="v" sid="ACT 8:13"/>ISaimɔn abuon noyɛyɛ ta a kyɔn iBatisima. O di kyɛdɔ iFyilipi mi ali imbe duu, i kwulun ewo mi ambɛ okwulewo kpakpa yi ungwɔ ama okwulewo ngwi o di ntonani.<verse eid="ACT 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 8:14"/>Onɔ ngwi ama ogbikye iYesu mi iJerosalin fwo gbɛɛ, emi iSamaria gbɛ Imgbasho nɛ, a dɔ iPyita yi iJɔn esɔ kɛ mboma. <verse eid="ACT 8:14"/><verse number="15" style="v" sid="ACT 8:15"/>Ngwi a ka to nɛ, a bibɔ wo ma ikyegbɛɛ nu ma gbɛ Onodzi Osaan, <verse eid="ACT 8:15"/><verse number="16" style="v" sid="ACT 8:16"/>ikyena Onodzi Osaan ba mbi inggisɛ mgbi ama onyi waba; a kyɔ ma iBatisima mi iyi mgbi Otsɛ iYesu kyoon. <verse eid="ACT 8:16"/><verse number="17" style="v" sid="ACT 8:17"/>Nɛ iPyita yi iJɔn kye abɔ dɔ ma ikye ta a si gbɛ Onodzi Osaan.<verse eid="ACT 8:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 8:18"/>Ngwi iSaimɔn di gbɛɛ li mi abɔ mgbi ama ogbikye iYesu okye dɔ ma ikye ta ngwi a kye Onodzi nu nɛ, o kye awuya ba mboma <verse eid="ACT 8:18"/><verse number="19" style="v" sid="ACT 8:19"/>si gbɛɛ, &lt;&lt;Nu ani kpaa mfye nɛni, adzi ni ali inggisɛ ngwu ani kye abɔ gbon duu no gbɛ Onodzi Osaan.&gt;&gt;<verse eid="ACT 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 8:20"/>IPyita nu uka gbɛɛ: &lt;&lt;Ni awuya mgbi abu dzili bɛyi abu duu, ikyesinɛ abu tsɛwɛ gbɛɛ abu ka gya umba mgbi Imgbasho yi awuya! <verse eid="ACT 8:20"/><verse number="21" style="v" sid="ACT 8:21"/>Abu dzɛ yi ayɛ hona umba mi idɔ nɛ ba, ikyekyɛ itukwu mgbi abu le saan mbi Imgbasho ba. <verse eid="ACT 8:21"/><verse number="22" style="v" sid="ACT 8:22"/>Kyatitukwu mi imbali nɛni di bibɔ mbi Otsɛ. Kpakpana o ka dzita abu mi odzɛ yi itɔ ewodzɛ ngwi abu dzɛyan mi itukwu mbi abu nɛni. <verse eid="ACT 8:22"/><verse number="23" style="v" sid="ACT 8:23"/>Ikyekyɛ ani di gbɛɛ abu mbwo yi unɔ bɛyi adi obwa-bwa mi alobube.&gt;&gt;<verse eid="ACT 8:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 8:24"/>Nɛ iSaimɔn nu uka gbɛɛ, &lt;&lt;Bɔ Otsɛ Imgbasho ibɔ ikye ani adzi ni ungwɔ ngwi abu gbɔ ntonɛ onyi kpaa no ka kyɔ ani ba mani.&gt;&gt;<verse eid="ACT 8:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 8:25"/>Onɔ ngwi a kyɔ obwɛndɛ di gbeesɔ mgbi Otsɛ ngyɛ nɛ, iPyita yi iJɔn yidɔ le lu iJerosalin, le gbɔ Esɔ Osuse mi agwɔ ibyibyi mi iSamaria.<verse eid="ACT 8:25"/></para>
  <para style="s1">IFyilipi yi inggisɛ iTiopia</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 8:26"/>Nɛ ongyesɔ mgbi Otsɛ nya iFyilipi gbɛɛ, &lt;&lt;Lu ofɛ atɛsɛ, ofɛ okplagada nkyɛ mi iJerosalin lu iGadza nani.&gt;&gt; <verse eid="ACT 8:26"/><verse number="27" style="v" sid="ACT 8:27"/>Nɛta o si tɔ ofɛ le lu, ngwi o le kɛ ofɛ nɛ, o kpatsɛ adumongyaa inggisɛ iTiopia, inggisɛ imɔ nle di mi awuya mgbi iKandase duu, Apodza mgbi emi iTiopia mani. Inggisɛ nɛ kɛ iJerosalin oka sunu Imgbasho, <verse eid="ACT 8:27"/><verse number="28" style="v" sid="ACT 8:28"/>ngwi o sɔdzɛ mmya yɛ le lu udɛ mgban nɛ, o le gbɔ afɛ mgbi oyegbɔ Adzaya. <verse eid="ACT 8:28"/><verse number="29" style="v" sid="ACT 8:29"/>Onodzi nya iFyilipi gbɛɛ, &lt;&lt;Kɛ ka kwudzɛkɛ kwɛkwɛ yi mmya nani.&gt;&gt;<verse eid="ACT 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 8:30"/>IFyilipi si tsinya kɛ kwɛkwɛ yi mmya na si fwo inggisɛ na le gbɔ afɛ mgbi oyegbɔ Adzaya. IFyilipi byita gbɛɛ, &lt;&lt;Ungwɔ ngwi abu gbɔ na gbosa lo abuu?&gt;&gt;<verse eid="ACT 8:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 8:31"/>O gbɛɛ, &lt;&lt;Ka gbosa lo ani sinɛ, sede inggisɛ oka ka kye gbɔfwɛ nya ani se lo?&gt;&gt; Nghanɛ o bɔ iFyilipi gbɛɛ no wa sɔ yan.<verse eid="ACT 8:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 8:32"/>Inggisɛ na le gbɔ imbe ngbɛɛ,</para>
  <para style="q1" vid="ACT 8:32">&lt;&lt;A kyon teyi dafi ongwummala</para>
  <para style="q2" vid="ACT 8:32">ngwi a kye le ka ngwɔ mani.</para>
  <para style="q1" vid="ACT 8:32">O di dzɛ shili dafi ongwummala</para>
  <para style="q2" vid="ACT 8:32">ngwi a dzan andu,</para>
  <para style="q1" vid="ACT 8:32">kpaa o kwondu ba mani.<verse eid="ACT 8:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="ACT 8:33"/>Mi ayiwi mgban yɔ,</para>
  <para style="q2" vid="ACT 8:33">a non gye emyɛmyɛ ba.</para>
  <para style="q1" vid="ACT 8:33">Li emɛ ka gbɔdzɛ etɔ mgban?</para>
  <para style="q2" vid="ACT 8:33">Lubana a kyi kyelun</para>
  <para style="q2" vid="ACT 8:33">oshishe mi ɛsɛ nɛni.&gt;&gt;<verse eid="ACT 8:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 8:34"/>Adumongyaa na byi iFyilipi gbɛɛ, &lt;&lt;Tsuutsu nya ani, li emɛ ngwu oyegbɔ le gbɔdzan, li mi ikye ongwu abuon naadi inggisɛ oka idzidza?&gt;&gt; <verse eid="ACT 8:34"/><verse number="35" style="v" sid="ACT 8:35"/>Ta iFyilipi si wita yi imbe mgbi Afɛ na yɛyɛ nyan Esɔ Osuse mgbi iYesu.<verse eid="ACT 8:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 8:36"/>Ngwi a le kɛ ofɛ nɛ, a wa to imbe ngwi eni dzɛ, ta adumongyaa na gbɛɛ, &lt;&lt;Dii, eni dzɛ aani. Kyɔnɛ ngwi a ka kyɔ ani iBatisima ba?&gt;&gt; [<verse eid="ACT 8:36"/><verse number="37" style="v" sid="ACT 8:37"/>IFyilipi gbɛɛ, &lt;&lt;Kini abu noyɛyɛ yi itukwu mgbi abu duu yɔ, a ka yagba kyɔ abu.&gt;&gt; Adumongyaa na si gbɛɛ, &lt;&lt;N noyɛyɛ gbɛɛ iYesu iKrestu li Ongwɛ Imgbasho.&gt;&gt;]<note caller="+" style="f"><char style="fr" closed="false">8:37 </char><char style="ft" closed="false">Ambulu nɛ dzɛ mi olɔɔlɔ angbeka ba.</char></note> <verse eid="ACT 8:37"/><verse number="38" style="v" sid="ACT 8:38"/>O byakpaa gbɛɛ nu ma kwulɛsɛ yi mmya. IFyilipi yi inggisɛ na tashulu kaka eni man iFyilipi kyɔn iBatisima. <verse eid="ACT 8:38"/><verse number="39" style="v" sid="ACT 8:39"/>Mi onɔ ngwi a tasɛ mi eni ma, Onodzi mgbi Otsɛ wa kyi kyelu iFyilipi lu akponyi, man adumongyaa na din wuba, kpaa lu ungwɔn le tsatsa. <verse eid="ACT 8:39"/><verse number="40" style="v" sid="ACT 8:40"/>IFyilipi ka tɔ mi Azotu le kyikyɛ kyɛ, le gbɔ Esɔ Osuse mi ali igeli duu nghataa ka kaka iSisiria.<verse eid="ACT 8:40"/></para>
  <chapter eid="ACT 8"/>
  <chapter number="9" style="c" sid="ACT 9"/>
  <para style="s1">ISol kyatitukwu</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 9:1"/>Mi ongwonɔ na, iSol kale pita ofɛ obube ongwɔ engwafɔ mgbi Otsɛ. O kɛ mbi okwukwo inggisɛ ofifɛ <verse eid="ACT 9:1"/><verse number="2" style="v" sid="ACT 9:2"/>ka bɔn gbɛɛ non lɔ afɛ kwuba kɛ mi ozu okwakye mgbi emi iJuda nto iDamasiko, ikyegbɛɛ kini ongwu tu inggisɛ nka dzɛ itɔ Ofɛ na yɔ, ni li ongyulɔ naadi ongyaa kpaa ni ongwu kwun ofyɛɛ luba iJerosalin. <verse eid="ACT 9:2"/><verse number="3" style="v" sid="ACT 9:3"/>Ngwi o dzɛ kwɛkwɛ okaka iDamasiko nɛta, osa tɔkyɛ esho wa dzanwo akponyi. <verse eid="ACT 9:3"/><verse number="4" style="v" sid="ACT 9:4"/>O gbɛsɛ lakɛ esɛ si fwo ela le nyan gbɛɛ, &lt;&lt;iSol, iSol, li ekyɛ ngwi abu le nu ani isɔ?&gt;&gt;<figure style="fig" alt="ISol kyatitukwu" file="WA03960b.tif" size="col" loc="9;4" copy="WA03960b" ref="9:4">The conversion of Saul</figure><verse eid="ACT 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 9:5"/>ISol byita gbɛɛ, &lt;&lt;Li abu emɛni Otsɛ?&gt;&gt;</para>
  <para style="p" vid="ACT 9:5">Ela na nu uka gbɛɛ, &lt;&lt;Li ani iYesu ngwu abu le nu ani isɔ mani. <verse eid="ACT 9:5"/><verse number="6" style="v" sid="ACT 9:6"/>Kyato onɛnɛ kaka ifu ogalu, ta a ka nya abu ungwɔ ngwi abu ka kyɔ kyɛmɛ-kyɛmɛ mani.&gt;&gt;<verse eid="ACT 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 9:7"/>Inggisɛ ama nkyɛ yi iSol na mmyɛ dzɛma; ikyesinɛ a fwo ela na kpaa a di inggisɛ ba. <verse eid="ACT 9:7"/><verse number="8" style="v" sid="ACT 9:8"/>ISol kyato mi esɛ, ngwi o kwulu inɛ nɛ, o yagba odinɛ wuba. Nɛ a byin abɔ kaka iDamasiko. <verse eid="ACT 9:8"/><verse number="9" style="v" sid="ACT 9:9"/>O binɛ dzɛ imbe na egbe eta, o gye ungwɔ hona wa ungwɔ kpaa ba.<verse eid="ACT 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 9:10"/>Mi iDamasiko ma ongwafɔ oka dzɛ ele iyin di Anania. Otsɛ kwun ela mi inɛ odiidi gbɛɛ, &lt;&lt;Anania!&gt;&gt;</para>
  <para style="p" vid="ACT 9:10">O gbela gbɛɛ, &lt;&lt;Uwoo, Otsɛ.&gt;&gt;<verse eid="ACT 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 9:11"/>Otsɛ nyan gbɛɛ, &lt;&lt;Lu ofɛ ngwi iyin gbɛɛ Byi yɛyɛ nani kɛ udɛ iJuda ka byita inggisɛ ongwi iTasu ngwu iyin di iSol, o le bibɔ mi abɔ ma. <verse eid="ACT 9:11"/><verse number="12" style="v" sid="ACT 9:12"/>O di inggisɛ ngwu a li kwun di Anania ba mi inɛ odiidi wa kye abɔ le dɔn ikye, ikye okwulun inɛ.&gt;&gt;<verse eid="ACT 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 9:13"/>Kpaa Anania gbɛɛ, &lt;&lt;Otsɛ, ani fwo inggisɛ ibyibyi le gbɔdzɛ ungwɔ obube ama inggisɛ nɛ kyɔ yi emi osaan mi iJerosalin. <verse eid="ACT 9:13"/><verse number="14" style="v" sid="ACT 9:14"/>Ma o di gbɛ mfye mbi engyukwo ama ofifɛ badzɛ owa bwa ali inggisɛ nle kwu mi iyi mgbi abu duu.&gt;&gt;<verse eid="ACT 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 9:15"/>Nghaduu Otsɛ nya Anania gbɛɛ, &lt;&lt;Kɛ! Inggisɛ nɛ li okyiidɔ ngwi ani dulun okye iyi ani kɛ mbi Udzengye yi utɔ mgbi ama bɛyi emi Israi duu. <verse eid="ACT 9:15"/><verse number="16" style="v" sid="ACT 9:16"/>Ma n ka tson dafi o ka gbiisɔ mi ikye iyi mgbi ani kyɛmɛ-kyɛmɛ mani.&gt;&gt;<verse eid="ACT 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 9:17"/>Ta Anania si lu ka kaka ozu mani, ngwi o kye abɔ dɔ iSol ikye nɛ, o gbɛɛ, &lt;&lt;Ongwunɛn iSol, Otsɛ iYesu ngwu tsetu abu mi ofɛ mi onɔ ngwi abu le ba mmɛnɛ nani, dɔ ani esɔ ikyegbɛɛ ni abu yɛ dinɛ diyɛ mbwo yi Onodzi Osaan.&gt;&gt; <verse eid="ACT 9:17"/><verse number="18" style="v" sid="ACT 9:18"/>Labɔlabɔ mata, ungwɔ dafi akwukwu mmbweni tɔ ngwuta mi inɛ mgbi iSol, ta o diyɛ le di. O kyato taman a kyɔn iBatisima, <verse eid="ACT 9:18"/><verse number="19" style="v" sid="ACT 9:19"/>ngwi o wa gye ungwogye nɛta o si yile ewo bɛsɛ.</para>
  <para style="s1" vid="ACT 9:19">ISol gbeesɔ mi iDamasiko <optbreak/> bɛyi iJerosalin</para>
  <para style="p" vid="ACT 9:19">ISol kye egbe gwee yi engwafɔ mgbi iYesu mi iDamasiko. <verse eid="ACT 9:19"/><verse number="20" style="v" sid="ACT 9:20"/>O byakpa wita ogbeesɔ mi ozu okwakye mgbi emi iJuda gbɛɛ iYesu li Ongwɛ Imgbasho. <verse eid="ACT 9:20"/><verse number="21" style="v" sid="ACT 9:21"/>Ama nfwon duu i kwulu ma ewo ta a byita gbɛɛ, &lt;&lt;Nɛnɛ li ongyulɔ nle nu ama nle kwu mi iyi nɛ isɔ mi iJerosalin ma baa? Ma o di ba mmɛnɛ owa bwa ma gbe ma lu ka nu engyukwo ama ofifɛ naadi?&gt;&gt; <verse eid="ACT 9:21"/><verse number="22" style="v" sid="ACT 9:22"/>Nghaduu esɔ ogbɔɔgbɔ mgbi iSol nghao fyumfye di non kwulu emi iJuda ama nto iDamasiko ewo mi otso gbɛɛ iYesu li iMedzaya.<verse eid="ACT 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 9:23"/>Ngwi i wa kɛ gɔɔ nɛ, emi iJuda wibu ongwɔn, <verse eid="ACT 9:23"/><verse number="24" style="v" sid="ACT 9:24"/>kpaa iSol difwi oweka mgbi ama. Otu yi onɔ a gbinɛbyi onufɛ ogalu le ngyo ikye ongwɔn. <verse eid="ACT 9:24"/><verse number="25" style="v" sid="ACT 9:25"/>Nghaduu ama okyɛdɔn kyen wokɛ uya mi otu kyon nyɛ ifo mi ewishi luba esɛ.<verse eid="ACT 9:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 9:26"/>Ngwi o wa kaka iJerosalin nɛ, o fya gbɛɛ ni ongwu kwakye yi engwafɔ mgbi iYesu, kpaa ama duu tsimion, a noyɛyɛ gbɛɛ o li ongwafɔ otsitsi ba. <verse eid="ACT 9:26"/><verse number="27" style="v" sid="ACT 9:27"/>Kpaa iBanabasi kyon ba mbi ama ogbikye iYesu. O nya ma dafi mi onɔ ngwi iSol le kɛ okyɛɛ ma o di Otsɛ iYesu, Otsɛ di gbɔdzɛ yan, dafi o di gbeesɔ mi iyi mgbi iYesu mi iDamasiko yi imio ba mani. <verse eid="ACT 9:27"/><verse number="28" style="v" sid="ACT 9:28"/>Nghanɛ iSol dzɛ yi ama mi iJerosalin shewota, le gbɔdzɛ yi abɔ otsigɛgɛ mi iyi mgbi Otsɛ. <verse eid="ACT 9:28"/><verse number="29" style="v" sid="ACT 9:29"/>O li gbɔdzɛ di tangwodzɛ yi emi iJuda ama ogbɔ ondu iGriki, kpaa a fya ongwɔn. <verse eid="ACT 9:29"/><verse number="30" style="v" sid="ACT 9:30"/>Ngwi ama onoyɛyɛ wa difwi nghanɛ, a kyon lu iSisiria, di kyon dɛsɔ lu iTasu.<verse eid="ACT 9:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 9:31"/>Ta ali okwakye mgbi emi iKrestu mi iJudia, iGalalia bɛyi iSamaria duu dzɛ mi iyu onɔ nani. Onodzi Osaan si ya ma abɔ nu ma fyumfye di she mi mmbwo, di dzɛ yi imio mgbi Otsɛ.<verse eid="ACT 9:31"/></para>
  <para style="s1">Odzɛ mgbi Aeni yi iDokasi</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 9:32"/>Dafi iPyita le dzagaba kpatsɛ ɛsɛ na duu nɛ, o kɛ oka kpadi emi osaan mi iLida. <verse eid="ACT 9:32"/><verse number="33" style="v" sid="ACT 9:33"/>Mi imbe na o tu inggisɛ ngwu a li kwun di Aeni, kwulu afɔ yi abɔ ladzɛ akwulo onova egyata. <verse eid="ACT 9:33"/><verse number="34" style="v" sid="ACT 9:34"/>IPyita nyan gbɛɛ, &lt;&lt;Aeni iYesu iKrestu ngyɛlu abu ootse. Kyato kyi kyelu akwulo mgbi abu.&gt;&gt; Aeni byakpa kyato akponyi. <verse eid="ACT 9:34"/><verse number="35" style="v" sid="ACT 9:35"/>Ama nto iLida bɛyi iSharon duu di Aeni man kyata yɛɛ ama okyɛdɔ Otsɛ.<verse eid="ACT 9:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 9:36"/>Ongwafɔ ongyaa oka dzɛ iJopa iyin di iTabyita (ngwi itan di iDokasi mi ondu iGriki), o li le kyungwɔ ama osuse di ya emi abubɔ abɔ alonɔ duu. <verse eid="ACT 9:36"/><verse number="37" style="v" sid="ACT 9:37"/>Mi itɔnɔ na o dotse si kwulu, a sho ikwɔ mgban ewo kye ka dɔ mi ozeesho. <verse eid="ACT 9:37"/><verse number="38" style="v" sid="ACT 9:38"/>ILida tunto yi iJopa ba; ngwi engwafɔ wa fwo gbɛɛ iPyita dzɛ iLida nɛ, a dɔ inggisɛ efa esɔ kɛ mbon gbɛɛ, &lt;&lt;Wafɔ yi eyi plɛ-plɛ!&gt;&gt;<verse eid="ACT 9:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 9:39"/>IPyita wafɔ yi ama, ngwi o ka to nɛ a kyon lu ozeesho. Engyaa owakwadɛ duu kyato tokɛ unto yan, le makwɔ di gbe abu yi angwuto angbeka ngwi iDokasi kwo nu ma mi onɔ ngwi o ka dzɛ oshishe ma tson.<verse eid="ACT 9:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 9:40"/>IPyita lɔ ma onya duu tɔ mi ifoozu; si kwɛsɛ bibɔ. Ngwi o kyata inɛ kɛ mbi ongyaa ikwukwɔ nɛ, o gbɛɛ, &lt;&lt;iTabyita, kyato.&gt;&gt; O kwulu inɛ, ngwi o di iPyita nɛta, o sɔkɛ unto. <verse eid="ACT 9:40"/><verse number="41" style="v" sid="ACT 9:41"/>O kye abɔ byun yan abɔ non kye afɔ dzɛkɛ esɛ. Nɛ o si kwu ama onoyɛyɛ ela bɛyi ewakwadɛ kyon nu ma oshishe. <verse eid="ACT 9:41"/><verse number="42" style="v" sid="ACT 9:42"/>Odzɛ nɛ gbɔfwɛ kpatsɛ iJopa duu, inggisɛ kwuba di noyɛyɛ mbi Otsɛ. <verse eid="ACT 9:42"/><verse number="43" style="v" sid="ACT 9:43"/>IPyita tila dzɛ iJopa kye onɔ kpakpa yi inggisɛ okyidɔ okpa okwookwo ngwu a li kwun di iSaimɔn.<verse eid="ACT 9:43"/></para>
  <chapter eid="ACT 9"/>
  <chapter number="10" style="c" sid="ACT 10"/>
  <para style="s1">IPyita yi iKɔnɛlu</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 10:1"/>Ongyulɔ oka dzɛ iSisiria a li kwun di iKɔnɛlu, o li okwukwo ogbakwu nle di mi obyi oblakwutsɛ mi Italia. <verse eid="ACT 10:1"/><verse number="2" style="v" sid="ACT 10:2"/>Ongwu yi etɔ mgban duu kye itukwu nu di li mio Imgbasho; o li gha emi abubɔ umba dzii di li bɔ Imgbasho ibɔ alonɔ duu. <verse eid="ACT 10:2"/><verse number="3" style="v" sid="ACT 10:3"/>Egbe oka dafi obyi eta ngwi onɔ tashulu akpa nɛ, o di inɛ odiidi. O di ongyesɔ mgbi Imgbasho saan, ba mbon wa gbɛɛ, &lt;&lt;IKɔnɛlu!&gt;&gt;<verse eid="ACT 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 10:4"/>IKɔnɛlu kye inɛ fyakwun yi imio. O byita gbɛɛ, &lt;&lt;Li ɛkyɛ, Otsɛ?&gt;&gt;</para>
  <para style="p" vid="ACT 10:4">Ongyesɔ na nu uka gbɛɛ, &lt;&lt;Ibɔ yi umba mgbi abu ogha emi abubɔ duu lu esho i yɛɛ ungwɔ Imgbasho kale wɛ abu. <verse eid="ACT 10:4"/><verse number="5" style="v" sid="ACT 10:5"/>Dɔ inggisɛ esɔ nu ma kɛ iJopa ka yile inggisɛ ngwu iyin di iSaimɔn ngwu a li kwun di iPyita na onɛnɛni. <verse eid="ACT 10:5"/><verse number="6" style="v" sid="ACT 10:6"/>O dzɛ yi iSaimɔn inggisɛ okyidɔ okpa, ngwu udɛ mgban dzɛ ondekyoo okwukwo nani.&gt;&gt;<verse eid="ACT 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 10:7"/>Onɔ ngwi ongyesɔ ngwu gbɔdzɛ yan na lu nɛ, iKɔnɛlu kwu engbidɔ mgban efa ela bɛyi inggisɛ oblakwutsɛ nli mio Imgbasho, di li onyi mbi ama ogban esɔ. <verse eid="ACT 10:7"/><verse number="8" style="v" sid="ACT 10:8"/>O nya ma alungwɔ nkyɔ duu man dɔ ma esɔ lu iJopa.<verse eid="ACT 10:8"/></para>
  <para style="s1">Inɛ odiidi mgbi iPyita</para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 10:9"/>Tegblifan ngwi onɔ dɔ idzidzɛ udɛ ngwi a le lu agaba ungwɔ ma di dzɛ kwɛkwɛ yi iJopa nɛ, iPyita dɔkɛ ikpendu<note caller="+" style="f"><char style="fr" closed="false">10:9 </char><char style="ft" closed="false">Mi ɛsɛ mgbi iPalisiti ikpendu mgbi ama li le pɛtɛ.</char></note> oka bibɔ. <verse eid="ACT 10:9"/><verse number="10" style="v" sid="ACT 10:10"/>Onyagleu dɔn o di mina ogye ungwogye. Ngwi a kale kyɔ ungwogye nɛ, o di inɛ odiidi. <verse eid="ACT 10:10"/><verse number="11" style="v" sid="ACT 10:11"/>O di esho kwulu a kye ungwɔ dafi akwukwɔ ogbada kye odi tsan mi okoko enɛ naan luba esɛ. <verse eid="ACT 10:11"/><verse number="12" style="v" sid="ACT 10:12"/>Mi ifun ali itɔ mmbwaba afɔ enɛ, yi ungwɔ ama okwo ifu esɛ bɛyi ali itɔ ingwunɔ emi esho duu woto ele. <verse eid="ACT 10:12"/><verse number="13" style="v" sid="ACT 10:13"/>Nɛ ela si nyan gbɛɛ, &lt;&lt;Kyato, iPyita. Ngwɔlu ma gye.&gt;&gt;<verse eid="ACT 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 10:14"/>IPyita nu uka gbɛɛ, &lt;&lt;Otsɛ mi otsitsi yɔ ungwɔ ka dzɛ ngha gbɛ ba. Lubana ani gye ungwɔ onyi ntsiidza naadi le kpɛkpɛ ye ba.&gt;&gt;<verse eid="ACT 10:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 10:15"/>Ela na diyɛ nyan gbɛɛ, &lt;&lt;Ka kwu ungwɔ onyonyi ngwi Imgbasho kye mɛlu saan gbɛɛ ungwɔ idza ba.&gt;&gt;<verse eid="ACT 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 10:16"/>Ungwɔnɛ kyɔ ngha akpe eta, man a byakpa kyi kyelu akwukwɔ na lu esho.<verse eid="ACT 10:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 10:17"/>Ngwi iPyita kale tsɛwɛ ungwɔ ngwi inɛ odiidi nɛ tso nɛ, inggisɛ ama ngwu iKɔnɛlu dɔ ma esɔ ntona ka ye imbe ngwi udɛ iSaimɔn dzɛ man kwulɛsɛ tokɛ onufoka. <verse eid="ACT 10:17"/><verse number="18" style="v" sid="ACT 10:18"/>A kwu ela, byita gbɛɛ ni ama ye ni iSaimɔn ngwu a li kwun di iPyita na ka dzɛ mmana mayɔ.<verse eid="ACT 10:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 10:19"/>Dafi iPyita kale tsɛwɛ mi inɛ odiidi nɛ, Onodzi nyan gbɛɛ, &lt;&lt;iSaimɔn, inggisɛ eta to esɛ le pita abu ma. <verse eid="ACT 10:19"/><verse number="20" style="v" sid="ACT 10:20"/>Nghanɛ tashulu lu ozu esɛ. Ka fwa owafɔ yi ama lu ba, ikyesinɛ li ani dɔ ma esɔ.&gt;&gt;<verse eid="ACT 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 10:21"/>IPyita tashulu ka nya ma gbɛɛ, &lt;&lt;Li ani li inggisɛ ngwu ema le pitan mani. Ema ba li ɛkyɛ?&gt;&gt;<verse eid="ACT 10:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 10:22"/>A gbɛɛ, &lt;&lt;iKɔnɛlu okwukwo ogbakwu dɔ eyi esɔ. O li inggisɛ osaan di li mio Imgbasho, ngwu emi iJuda duu li fwon. Ongyesɔ osaan nyan gbɛɛ no nu abu ba udɛ mgban adzi non fwo odzɛ ngwi abu ka gbɔ nyan mani.&gt;&gt; <verse eid="ACT 10:22"/><verse number="23" style="v" sid="ACT 10:23"/>Nɛ iPyita gbɛ ma kaka udɛ dafi ingyoga mgban mani.</para>
  <para style="s1" vid="ACT 10:23">IPyita kɛ udɛ iKɔnɛlu</para>
  <para style="p" vid="ACT 10:23">Tegblifan nɛ iPyita kyato okyɛɛ yi ama, ama onoyɛyɛ angbeka mi iJopa kpaa di wafɔ yi ama. <verse eid="ACT 10:23"/><verse number="24" style="v" sid="ACT 10:24"/>Ngwi egbe di fa nɛ, o kaka iSisiria. IKɔnɛlu kye inɛ kwo ofɛ le fɛ ma di kwu etɔ bɛyi abuge mgban duu kwakye. <verse eid="ACT 10:24"/><verse number="25" style="v" sid="ACT 10:25"/>Dafi iPyita wa to udɛ ma nɛ, iKɔnɛlu wa kwɛsɛ mi iyayi mbon di sunun. <verse eid="ACT 10:25"/><verse number="26" style="v" sid="ACT 10:26"/>Kpaa iPyita kye abɔ byun nyan gbɛɛ, &lt;&lt;kyato, ani kpaa li inggisɛ owamyɛ dafi abu.&gt;&gt;<verse eid="ACT 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 10:27"/>Ngwi iPyita kale gbɔdzɛ yan nɛ, iPyita lu idzidzɛ ozu ka di ibyi inggisɛ kwakye to. <verse eid="ACT 10:27"/><verse number="28" style="v" sid="ACT 10:28"/>O nya ma gbɛɛ: &lt;&lt;Ema ye saan ta gbɛɛ ola mgbi eyi fwa gbɛɛ inggisɛ emi iJuda no ka kwakye yi Udzengye hona kɛ ingyoga mi udan ba. Nghaduu Imgbasho tso ani gbɛɛ ni ani ka kwu inggisɛ owamyɛ gbɛɛ o le kpɛkpɛ hona tsiidza ba. <verse eid="ACT 10:28"/><verse number="29" style="v" sid="ACT 10:29"/>Nghanɛ ngwi ema dɛsɔ mbi ani ma, ani tsondu ba ani ba. Ema dɛsɔ mbi ani li ali itɔdzɛ?&gt;&gt;<verse eid="ACT 10:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 10:30"/>IKɔnɛlu nu uka gbɛɛ, &lt;&lt;Egbe enɛ inɛ waani ani wodzɛ ozu mbi ani le bibɔ mi obyi eta itɔ onɔ nɛni. Nɛta inggisɛ wo angwuto onzundzɛ kwɔkwɔ wa mblegba tu ani<verse eid="ACT 10:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 10:31"/>&lt;&lt;Si gbɛɛ, &lt;IKɔnɛlu Imgbasho fwo ibɔ mgbi abu di wɛ umba ngwi abu le gha emi adzɛ mani. <verse eid="ACT 10:31"/><verse number="32" style="v" sid="ACT 10:32"/>Nghanɛ dɛsɔ kɛ iJopa mbi iSaimɔn ngwu a li kwun di iPyita nani. O kɛdzɛ ingyoga mi udɛ iSaimɔn inggisɛ nli kyidɔ okpa, ndzɛ ondekyoo okwukwo nani.&gt; <verse eid="ACT 10:32"/><verse number="33" style="v" sid="ACT 10:33"/>Man ani byakpa dɛsɔ mbi abu, i tishi dafi abu di ba mani. Onɛnɛ eyi duu kwakye mmɛnɛni mi inai Imgbasho ikye ofwo alungwɔ ngwi Imgbasho wo abu ola gbɛɛ ni abu nya eyi mani.&gt;&gt;<verse eid="ACT 10:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 10:34"/>IPyita si wita ogbɔdzɛ gbɛɛ: &lt;&lt;Onɛnɛ ani difwi otsitsi gbɛɛ Imgbasho li tso osadu-sadu ba <verse eid="ACT 10:34"/><verse number="35" style="v" sid="ACT 10:35"/>kpaa li gbela yi inggisɛ mi ali agwɔ nli mion di kyungwɔ nli ayin mani. <verse eid="ACT 10:35"/><verse number="36" style="v" sid="ACT 10:36"/>Ema ye esɔ ngwi Imgbasho dɔ mbi emi Israi, onya ma Esɔ Osuse mgbi iyu ngwi nyɛ mbi iYesu iKrestu, ongwu nli Otsɛ mgbi alungwɔ duu nani. <verse eid="ACT 10:36"/><verse number="37" style="v" sid="ACT 10:37"/>Ema ye ungwɔ nkyɔ mi ikpɛsɛ iJudia duu, wita mi iGalalia mi onɔ ngwi iJɔn gbeesɔ mgbi iBatisima nyɛ <verse eid="ACT 10:37"/><verse number="38" style="v" sid="ACT 10:38"/>dafi Imgbasho kye engyie kyi iYesu ongwi iNadzareti ikye yi Onodzi Osaan bɛyi mfye, dafi o dile kyikyɛ kpatsɛ le kyungwɔ osuse dile ngyɛlu ama ngbeka woto abumfye mgbi onodzi ibwubwe duu ootse, ikyesinɛ Imgbasho dzɛ biyan.<verse eid="ACT 10:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 10:39"/>&lt;&lt;Eyi li obwɛndɛ mi alungwɔ ngwi o kyɔ mi ɛsɛ iJuda bɛyi iJerosalin duu. A ngwɔn mi okyon gbokwo ekwatsi, <verse eid="ACT 10:39"/><verse number="40" style="v" sid="ACT 10:40"/>nghaduu Imgbasho kyilon mi ikwu mi egbe ongwu ta mani di nu ma dun. <verse eid="ACT 10:40"/><verse number="41" style="v" sid="ACT 10:41"/>Li ali inggisɛ duu din ba, kpaa li ama Imgbasho sadulu ma mbi eyi ama ngye di wa yan mi onɔ ngwi o kyato mi ikwu ma li obwɛndɛ aali. <verse eid="ACT 10:41"/><verse number="42" style="v" sid="ACT 10:42"/>O wo eyi ola gbɛɛ ni eyi gbeesɔ nya inggisɛ di kyɔ obwɛndɛ gbɛɛ li ongwu ngwu Imgbasho dulu gbɛɛ ni ongwu li inggisɛ ogbɔ emi oshishe bɛyi emi ikwukwɔ ikwɔ. <verse eid="ACT 10:42"/><verse number="43" style="v" sid="ACT 10:43"/>Oyegbɔ duu kyɔ obwɛndɛ mi ikyon gbɛɛ ali inggisɛ nnun oyɛyɛ duu a zanta yi alobube mi iyi mgban.&gt;&gt;<verse eid="ACT 10:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 10:44"/>Ngwi iPyita kale gbɔ elodzɛ ntonɛ nɛ, Onodzi Osaan kaka mbi ali inggisɛ ama nfwo esɔ na duu. <verse eid="ACT 10:44"/><verse number="45" style="v" sid="ACT 10:45"/>I kwulu emi iJuda ama nkyiikyɛ di noyɛyɛ wafɔ yi iPyita ma ewo dafi umba mgbi Onodzi Osaan kpaa a kye nu Udzengye mani. <verse eid="ACT 10:45"/><verse number="46" style="v" sid="ACT 10:46"/>Lubana a fwo ma le gbɔ ondudzɛ angbeka dile tsɛ Imgbasho.</para>
  <para style="p" vid="ACT 10:46">Nɛta iPyita gbɛɛ, <verse eid="ACT 10:46"/><verse number="47" style="v" sid="ACT 10:47"/>&lt;&lt;Inggisɛ oka dzɛma nka fwa gbɛɛ nu ma ka kyɔ inggisɛ ntonɛ iBatisima mi eni ba gbɛɛ? Lubana a gbɛ Onodzi Osaan dafi eyi kpaa gbɛ nɛni.&gt;&gt; <verse eid="ACT 10:47"/><verse number="48" style="v" sid="ACT 10:48"/>IPyita nu ondu gbɛɛ nu ma kyɔ ma iBatisima mi iyi mgbi iYesu iKrestu. Nɛ a si nya iPyita gbɛɛ no dzɛ yi ama mi egbe gwee.<verse eid="ACT 10:48"/></para>
  <chapter eid="ACT 10"/>
  <chapter number="11" style="c" sid="ACT 11"/>
  <para style="s1">IPyita nu okwakye mgbi emi iKrestu mi <optbreak/> iJerosalin osa</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 11:1"/>Ama ogbikye iYesu bɛyi ama onoyɛyɛ angbeka mi iJudia duu fwo dafi Udzengye kpaa gbɛ elodzɛ Imgbasho mani. <verse eid="ACT 11:1"/><verse number="2" style="v" sid="ACT 11:2"/>Dafi iPyita wa kaka iJerosalin nɛta, ama nnoyɛyɛ kyiikyɛ kwun shanyɛ <verse eid="ACT 11:2"/><verse number="3" style="v" sid="ACT 11:3"/>gbɛɛ, &lt;&lt;Abu ka kaka udɛ ama okyiikyɛ ba gye ungwogye yi ama.&gt;&gt;<verse eid="ACT 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 11:4"/>IPyita wita di gbɔ alungwɔ duu nya ma klɛklɛ dafi i kyɔ mani: <verse eid="ACT 11:4"/><verse number="5" style="v" sid="ACT 11:5"/>&lt;&lt;Ani dzɛ igeli iJopa le bibɔ, ani nuna lu kpini si di inɛ odiidi. Ani di ungwɔ dafi akwukwɔ ogbada a kye odi tsan mi okoko enɛ kyɛ esho luba esɛ, di li imbe ani dzɛ ma yɛyɛ ngwi i ba. <verse eid="ACT 11:5"/><verse number="6" style="v" sid="ACT 11:6"/>Ani winɛ kɛ ifun man di mmbwaba ama owo afɔ enɛ, mmbwaba ama okwukwo, mmbwaba ama okwo ifu esɛ, bɛyi ingwunɔ emi esho. <verse eid="ACT 11:6"/><verse number="7" style="v" sid="ACT 11:7"/>Ta ani fwo ela le nya ani gbɛɛ, &lt;Kyato iPyita, ngwɔlu ma gye.&gt;<verse eid="ACT 11:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 11:8"/>&lt;&lt;Ani nu uka gbɛɛ, &lt;Otsɛ mi otsitsi yɔ ungwɔ ka dzɛ ngha gbɛ ba. Lubana ani gye ungwɔ onyi ntsiidza naadi le kpɛkpɛ ye ba.&gt;<verse eid="ACT 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 11:9"/>&lt;&lt;Ela na diyɛ nya ani gbɛɛ, &lt;Ka kwu ungwɔ onyonyi ngwi Imgbasho kye mɛlu saan gbɛɛ ungwɔ idza ba.&gt; <verse eid="ACT 11:9"/><verse number="10" style="v" sid="ACT 11:10"/>Ungwɔnɛ kyɔ ngha akpe eta, man a di kyi kwolu yɛ lu esho.<verse eid="ACT 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 11:11"/>&lt;&lt;Mi onɔ nata engyulɔ nghi eta ngwu a dɔ ma esɔ kyɛ iSisiria ba mbi ani wa kwulɛsɛ to udɛ ngwi ani ladzɛ mani. <verse eid="ACT 11:11"/><verse number="12" style="v" sid="ACT 11:12"/>Onodzi nya ani gbɛɛ ni ani ka kwagbini owafɔ lu yi ama ba. Ama onoyɛyɛ nghi egyin ntonɛ kpaa tawo ani, ka kaka udɛ inggisɛ nani. <verse eid="ACT 11:12"/><verse number="13" style="v" sid="ACT 11:13"/>O nya eyi dafi ongyesɔ mblegba tu ongwu mi ozu mgban di gbɛɛ, &lt;Dɛsɔ kɛ mbi iSaimɔn mi iJopa ngwu a li kwun di iPyita nani. <verse eid="ACT 11:13"/><verse number="14" style="v" sid="ACT 11:14"/>O ka nya abu esɔ ngwi abu yi etɔ mgbi abu duu ka watɔ mi ele mani.&gt;<verse eid="ACT 11:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 11:15"/>&lt;&lt;Dafi ani wita ogbɔdzɛ nɛ, Onodzi Osaan ba mboma dafi i teyi ba mbi eyi mi owita-wita nani. <verse eid="ACT 11:15"/><verse number="16" style="v" sid="ACT 11:16"/>Ta ani wɛ odzɛ ngwi Otsɛ nose gbɔ mani, gbɛɛ: &lt;iJɔn kyɔ iBatisima mi eni, kpaa a ka kyɔ ema iBatisima mi Onodzi Osaan.&gt; <verse eid="ACT 11:16"/><verse number="17" style="v" sid="ACT 11:17"/>Nghanɛ kini Imgbasho nu ma umba ungwonyi dafi o nu eyi ama nnoyɛyɛ mbi Otsɛ iYesu iKrestu nɛ ma, ani li emɛ mi onɔ na okye afɔ twɛsɛ fwa yi Imgbasho?&gt;&gt;<verse eid="ACT 11:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 11:18"/>Ngwi a fwo ungwɔnɛ nɛ, a kiyayi otangwodzɛ wuba man tsɛ Imgbasho, le gbɛɛ, &lt;&lt;Alima, Imgbasho gbela yi Udzengye kpaa odzita ma yi obube nu ma tu oshishe.&gt;&gt;<verse eid="ACT 11:18"/></para>
  <para style="s1">Adua mi Antiɔku</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 11:19"/>Ikyenghanɛ, ama onoyɛyɛ nganya ikye ikwu iStivin nɛ, tse lu iFonishia, iSapru, bɛyi Antiɔku, le gbeesɔ nya emi iJuda yuoma kyoon. <verse eid="ACT 11:19"/><verse number="20" style="v" sid="ACT 11:20"/>Angbeka mboma, dafi i dzɛ duu kpaa, a li emi iSapru bɛyi iSirini, lu Antiɔku ka wita ogbɔdzɛ yi emi iGriki kpaa, le nya ma Esɔ Osuse mgbi Otsɛ iYesu. <verse eid="ACT 11:20"/><verse number="21" style="v" sid="ACT 11:21"/>Abumfye mgbi Otsɛ dzɛ yi ama, nɛ inggisɛ kwuba noyɛyɛ di kyata luba mbi Otsɛ.<verse eid="ACT 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 11:22"/>Odzɛ nɛ kaka adɔ mgbi emi okwakye mgbi emi iKrestu mi iJerosalin, man a dɔ iBanabasi esɔ kɛ Antiɔku. <verse eid="ACT 11:22"/><verse number="23" style="v" sid="ACT 11:23"/>Ngwi o ka kaka di di dafi Imgbasho kye mse bɛ inggisɛ ntona ewo nɛ, atsa tsan o di fyuma mfye itukwu duu gbɛɛ nu ma kwulɛsɛ mi otsitsi mbi Otsɛ yi itukwu mgbi ama duu. <verse eid="ACT 11:23"/><verse number="24" style="v" sid="ACT 11:24"/>Lubana iBanabasi li inggisɛ osuse, di mbwo yi Onodzi Osaan bɛyi oyɛyɛ onuunu. Ikyenghanɛ inggisɛ kwuba luba mbi Otsɛ.<verse eid="ACT 11:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 11:25"/>Nɛ iBanabasi kɛ iTasu oka pita iSol, <verse eid="ACT 11:25"/><verse number="26" style="v" sid="ACT 11:26"/>ngwi o ka tun nɛ, o kyon luba Antiɔku. Mi onova na duu iBanabasi yi iSol li kwakye yi okwakye mgbi emi iKrestu di tso ibyi inggisɛ kpakpa ungwɔ. Li mi Antiɔku ababɔ ngwi a wita okwu ama okyɛdɔ iYesu di emi iKrestu.<verse eid="ACT 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 11:27"/>Mi onɔ nɛ oyegbɔ angbeka kyɛ iJerosalin bato Antiɔku. <verse eid="ACT 11:27"/><verse number="28" style="v" sid="ACT 11:28"/>Onyi mboma, ngwu iyin di Agabu, kyato gbɛɛsɛ nyɛ mi Onodzi gbɛɛ onikyenbwa ka gbo kpatsɛ ɛsɛ iRoma. (Ungwɔnɛ kyɔ mi onɔ ngwi iKladiɔsu li utɔ.) <verse eid="ACT 11:28"/><verse number="29" style="v" sid="ACT 11:29"/>Ama okyɛdɔ iYesu mi Antiɔku kye ali itɔ oyabɔ ngwi ama dzɛyan duu dɛsɔ nu emi ongwunɔ ma mi iJudia. <verse eid="ACT 11:29"/><verse number="30" style="v" sid="ACT 11:30"/>Ungwɔ ngwi a li kyɔ yɔ, a li kye umba mgbi ama dɛsɔ nyɛ mbi iBanabasi yi iSol kɛ mbi engyukwo mgbi ama mi iJerosalin.<verse eid="ACT 11:30"/></para>
  <chapter eid="ACT 11"/>
  <chapter number="12" style="c" sid="ACT 12"/>
  <para style="s1">IPyita tɔ mi obawi mi ofɛ okwulewo</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 12:1"/>Li mi itɔnɔ nɛ ngwi utɔ iHerude<note caller="+" style="f"><char style="fr" closed="false">12:1 </char><char style="fk">IHerude</char> nɛ li ongwiba mgbi iHerude ongwi ababɔ.</note> wita obwa emi iKrestu angbeka, yi oweka onu ma isɔ. <verse eid="ACT 12:1"/><verse number="2" style="v" sid="ACT 12:2"/>O teyi ngwɔ iJɛnsi ongwunɔ iJɔn mi okwusunkli. <verse eid="ACT 12:2"/><verse number="3" style="v" sid="ACT 12:3"/>Ngwi o di gbɛɛ i kpa emi iJuda nɛ, o kiyayi di bwa iPyita kpaa. Ungwɔnɛ kyɔ mi onɔ mgbi ibredi ngwi a li kye okwuna wele ba nani. <verse eid="ACT 12:3"/><verse number="4" style="v" sid="ACT 12:4"/>Dafi o bwan nɛ, o kyon wokɛ obawi di kyon dɔ ama ongyoongyo ubɔ, oblakwutsɛ eneenɛ mi otsa enɛ duu. IHerude dzɛ yi oweka owa dulun tɔ ba wa gbɔn ikwɔ mi ododa mi onɔ ngwi oga owɛ owatɔ-watɔ mgbi emi Israi ngyɛ mani.<verse eid="ACT 12:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 12:5"/>IPyita tila wodzɛ obawi, kpaa okwakye mgbi emi iKrestu yɔ le bibɔ mi itukwu onyi mbi Imgbasho ikyon.<verse eid="ACT 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 12:6"/>Mi obwi egbe ngwi iHerude ka kyon tɔ wa gbɔn ikwɔ ma, iPyita la le nuna mi idzidzɛ oblakwutsɛ nghi efa, a bwan adi agya efa, ama ongyoongyo di to onufɛ okakaakaka. <verse eid="ACT 12:6"/><verse number="7" style="v" sid="ACT 12:7"/>Plɛ nɛta ongyesɔ mgbi Otsɛ wa mblegba tu ma ta obawi si gbosa. O kye abɔ mu iPyita mi agya kyilen una, o nyan gbɛɛ, &lt;&lt;Kyato Plɛ!&gt;&gt; Man ashi ntona shɛ lon mi owashi abɔ yangwuta.<verse eid="ACT 12:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 12:8"/>Ongyesɔ na si nyan gbɛɛ, &lt;&lt;Gbe angwuto mgbi abu wo bɛyi okpafɔ.&gt;&gt; IPyita si kyɔ ngha. Ongyesɔ na di nyan gbɛɛ, kye angwuto ofu mgbi abu tukwu kyɛdɔ ani. <verse eid="ACT 12:8"/><verse number="9" style="v" sid="ACT 12:9"/>IPyita kyɛdɔn tasɛ mi obawi, kpaa i gbosa lon gbɛɛ ungwɔ ngwi ongyesɔ le kyɔ na li otsitsi ba, o tsɛwɛ gbɛɛ ongwu le woowo elela. <verse eid="ACT 12:9"/><verse number="10" style="v" sid="ACT 12:10"/>A nyɛ imbe ongyoongyo ongwi ababɔ bɛyi ongwu fan, di wa to onufɛ ashashi ntɔ lu ogalu nani. I kwulu ewon, man a nyɛ ele tasɛ. Ngwi a kyikyɛ lu byulu nɛ, ongyesɔ na byulu dzanta.<verse eid="ACT 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 12:11"/>Nɛta iPyita difwi di gbɛɛ, &lt;&lt;Onɛnɛ ani ye yɛyɛ gbɛɛ Otsɛ dɔ ongyesɔ mgban gbɛɛ no wa dulu ani tɔ mi abumfye mgbi iHerude bɛyi alungwɔ ngwi emi iJuda le tsɛwɛ ikye ani duu.&gt;&gt;<verse eid="ACT 12:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 12:12"/>Ngwi o wa difwi ungwɔnɛ nɛ, o lu udɛ iMeri onɔ iJɔn, ngwi a di li kwun gbɛɛ iMaki, imbe ngwi ibyi inggisɛ kwakye to dile bibɔ. <verse eid="ACT 12:12"/><verse number="13" style="v" sid="ACT 12:13"/>IPyita tsaabɔ mi onufɛ ongwi esɛ, man ongwongyiidɔ ngwu iyin di iRoda ba owa ye inggisɛ ndzɛ onufɛ mani. <verse eid="ACT 12:13"/><verse number="14" style="v" sid="ACT 12:14"/>Ngwi o difwi ela mgbi iPyita nɛ, atsa atsan nyɛsɛ o kwulu ofɛ wuba kpaa yɛ tsinya lu dile kwu-ela gbɛɛ, &lt;&lt;iPyita dzɛ onufɛ ma!&gt;&gt;<verse eid="ACT 12:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 12:15"/>Kpaa a nyan gbɛɛ, &lt;&lt;O dzɛ yi ikye yɛyɛ ba.&gt;&gt; Dafi o kale kiyayi gbɛɛ di li otsitsi nɛ, a nyan gbɛɛ, &lt;&lt;Ka li ongyesɔ mgban kyɛmɛ.&gt;&gt;<verse eid="ACT 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 12:16"/>Nghaduu iPyita yɔ kale tsaabɔ kpɔɔ ma, ngwi a wa kye kwulu ofɛ nɛ, a din man i kwulu ma ewo. <verse eid="ACT 12:16"/><verse number="17" style="v" sid="ACT 12:17"/>IPyita kyɔ ma abɔ gbɛɛ nu ma dede si tsuutsa dafi Otsɛ dulu ongwu tɔ mi obawi mani. O di gbɛɛ, &lt;&lt;Nya iJɛnsi bɛyi ama onoyɛyɛ odzɛ mi ungwɔnɛni.&gt;&gt; Nɛman o si lu imbe oka.<verse eid="ACT 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 12:18"/>Ngwi egbe fa nɛ, ɛndɛ olɛlɛ efu ba dzɛ mi idzidzɛ ama oblakwutsɛ mi ungwɔ nkyɔ yi iPyita nani. <verse eid="ACT 12:18"/><verse number="19" style="v" sid="ACT 12:19"/>Ngwi iHerude gbilin kpatsɛ din ba nɛ, o diyɛ kya mbi ama ongyoongyo ntonani si nu ondu gbɛɛ nu ma ngwɔ ma.</para>
  <para style="s1" vid="ACT 12:19">Ikwu iHerude</para>
  <para style="p" vid="ACT 12:19">Nɛ iHerude kyɛɛ mi iJudia lu iSisiria ka kye egbe gwee mi ele. <verse eid="ACT 12:19"/><verse number="20" style="v" sid="ACT 12:20"/>IHerude teyi dzɛ yi odzɛ oshiishi yi emi iTiru bɛyi iSidon; a yɛ kwakye yi ewoma di pita ofɛ ogbɔdzɛ yan. Ngwi a tu oyabɔ mgbi iBlastu, ongbidɔ mgbi utɔ yuon ngwu a nun oyɛyɛ nɛ, a kɛ mbi utɔ ka pita iyu, ikyekyɛ li ɛsɛ mgbi utɔ na li nu ma ungwogye.<verse eid="ACT 12:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 12:21"/>Mi egbe ngwi a kye dzɛ ma, iHerude gbe angwuto mgban mgbi utɔ wo ewo, sɔkɛ itsuutɔ mgban man gbɔdzɛ yi ama mi ododa. <verse eid="ACT 12:21"/><verse number="22" style="v" sid="ACT 12:22"/>A wulu gbɛɛ, &lt;&lt;Nɛnɛ li ela mgbi Imgbasho li mgbi inggisɛ ba.&gt;&gt; <verse eid="ACT 12:22"/><verse number="23" style="v" sid="ACT 12:23"/>Ikyegbɛɛ iHerude tsɛ Imgbasho ba nɛ, Ongyesɔ mgbi Otsɛ tan afɛ, ta o gbaangbi byakpa kwulu.<verse eid="ACT 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 12:24"/>Nghaduukpaa elodzɛ mgbi Imgbasho kiyayi osheeshe di gbɔfwɛ.<verse eid="ACT 12:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 12:25"/>Ngwi iBanabasi bɛyi iSol ngyɛlu ungwɔ ngwi a kɛ ma nɛ, a yɛ mi iJerosalin, a kye iJɔn ngwu a li kwun di iMaki na wafɔ yi ama.<verse eid="ACT 12:25"/></para>
  <chapter eid="ACT 12"/>
  <chapter number="13" style="c" sid="ACT 13"/>
  <para style="s1">A dɔ iBanabasi yi iSol esɔ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 13:1"/>Mi okwakye mgbi emi iKrestu mi Antiɔku ma, ama ogbɛɛsɛ yi etsetse to ele; li iBanabasi yi iSimiɔn ngwu a li kwun di iNaija bɛyi iLushɔ ongwi iSirini yi iMane (ongwu nshe bɛyi iHerude iGɔna<note caller="+" style="f"><char style="fr" closed="false">13:1 </char><char style="ft" closed="false">IHerude Antipa nɛ li ongwɛ iHerude ongwi ababɔ</char></note> nani) yi iSol. <verse eid="ACT 13:1"/><verse number="2" style="v" sid="ACT 13:2"/>Ngwi a tole sunu Otsɛ dile tukwondu nɛ, Onodzi Osaan gbɔ yi ama gbɛɛ, &lt;&lt;Dulu iBanabasi yi iSol dzɛkɛ idzidza mi ikye idɔ ngwi ani kwu ma ela ikyon mani. <verse eid="ACT 13:2"/><verse number="3" style="v" sid="ACT 13:3"/>Ngwi a tukwondu diyɛ bibɔ nɛta, a gbe abɔ dɔ ma ikye di wo ma ofɛ lu.<verse eid="ACT 13:3"/></para>
  <para style="s1">Mi iSapru</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 13:4"/>Ngwi Onodzi Osaan dɔ ma esɔ nɛ, iBanabasi yi iSol byi ofɛ abɔ lu ka kaka iSelushia si kaka uwaa dzɛkyo lu ibu ongwi iSapru. <verse eid="ACT 13:4"/><verse number="5" style="v" sid="ACT 13:5"/>Ngwi a wa to iSalami nɛ, a gbeesɔ mgbi Imgbasho mi ozu okwakye mgbi emi iJuda. IJɔn iMaki kyɛ yi ama le tobyi ma.<verse eid="ACT 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 13:6"/>A kyikyɛ kpatsɛ ibu na nghataa wa kaka iPafosu. Mi imbe nɛ a kpatsɛ yi inggisɛ iJuda otseefa di li oyegbɔ atsika ngwu iyin di iBa-iYesu, <verse eid="ACT 13:6"/><verse number="7" style="v" sid="ACT 13:7"/>nli kyɛ yi iSejiɔ iPaɔlɔsu iGɔna ongwi ibu nani. IGɔna na, li inggisɛ ndzɛ yi ozoyeye saan, o dɛsɔ mbi iBanabasi yi iSol ikyekyɛ o mina ofwo elodzɛ Imgbasho. <verse eid="ACT 13:7"/><verse number="8" style="v" sid="ACT 13:8"/>Kpaa Elimasi inggisɛ otseefa na (bana li ita iyi mgban aali) kaka ma idzidzɛ fwa yi iGɔna na gbɛɛ no ka noyɛyɛ mi odzɛ ngwi iBanabasi yi iSol le gbɔ na ba. <verse eid="ACT 13:8"/><verse number="9" style="v" sid="ACT 13:9"/>Nɛ iSol, ngwu iyin oka di iPol, nmbwo yi Onodzi Osaan na tongwinɛ byi Elimasi nyan gbɛɛ, <verse eid="ACT 13:9"/><verse number="10" style="v" sid="ACT 13:10"/>&lt;&lt;Abu ongwɛ owapɛ olodu nli ongyikyili mgbi alungwɔ osuse duu nɛ! Abu mbwo yi ali ɛwɛ yi okpagyewo duu. Abu ka nya ombe ofɛ mgbi Otsɛ nli ayin nɛ lo? <verse eid="ACT 13:10"/><verse number="11" style="v" sid="ACT 13:11"/>Nghanɛ abɔ mgbi Otsɛ kpakli abu wa. O ka binɛ, mi ongwonɔ gwee o ka di osa mgbi onɔ ba.&gt;&gt;</para>
  <para style="p" vid="ACT 13:11">Ntunto nɛta inɛ tuubu lon man o yɛɛ pwaapwa dile mina inggisɛ nka kwon abɔ tɔ mani. <verse eid="ACT 13:11"/><verse number="12" style="v" sid="ACT 13:12"/>Ngwi iGɔna di ungwɔ nkyɔ nɛ, o noyɛyɛ, bana i kwulun ewo mi otsootso odzɛ mgbi Otsɛ.<verse eid="ACT 13:12"/></para>
  <para style="s1">Mi iPisidia ongwi Antiɔku</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 13:13"/>IPol yi emi afokyɛɛ mgban kaka uwaa mi iPafosu luba iPega, igeli mi iPamfyilia, li imbe na ngwi iJɔn ngwu iyin oka di iMaki na dzita ma yɛ lu iJerosalin aali. <verse eid="ACT 13:13"/><verse number="14" style="v" sid="ACT 13:14"/>Mi iPega ma, a kyato lu Antiɔku ongwi iPisidia. Mi egbe otonyewo nɛ, a kaka ozu okwakye mgbi emi iJuda di sisɛ. <verse eid="ACT 13:14"/><verse number="15" style="v" sid="ACT 13:15"/>Onɔ ngwi a gbɔ mi afɛ mgbi Ola mgbi iMose bɛyi afɛ mgbi emi Oyegbɔ nyɛ nɛta, ama odi mi ozu okwakye mgbi emi iJuda na dɛsɔ mboma gbɛɛ, &lt;&lt;Emi ongwunani, ni ema dzɛ yi esɔ mgbi onu itukwu ofyumfye-fyumfye ikye inggisɛ ntonɛ yɔ, gbɔ na.&gt;&gt;<verse eid="ACT 13:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 13:16"/>IPol dzɛkunto kyɔ ma abɔ si gbɛɛ: &lt;&lt;Emi Israi bɛyi Udzengye ama osunu Imgbasho, gadɔ mbi ani na! <verse eid="ACT 13:16"/><verse number="17" style="v" sid="ACT 13:17"/>Imgbasho mgbi emi Israi dulu emi otseyi; o nu ma okiyayi mi onɔ ngwi a to Igyibiti mani, mi abumfye odatu o dulu ma tɔ mi ɛsɛ nani, <verse eid="ACT 13:17"/><verse number="18" style="v" sid="ACT 13:18"/>o shitukwu yi okyɔɔkyɔ mgbi ama mi afutse onova ngwusefa, <verse eid="ACT 13:18"/><verse number="19" style="v" sid="ACT 13:19"/>di dzili agwɛɛsɛ egyafa mi iKana kye ikpɛsɛ mgbi ama kye nu emidi ongwu no yɛɛ okwudɛ mgbi ama. <verse eid="ACT 13:19"/><verse number="20" style="v" sid="ACT 13:20"/>Ungwɔ ntonɛ duu kye mɛ onova ideli enɛ ngwusefa dɔn iwyo.</para>
  <para style="p" vid="ACT 13:20">&lt;&lt;Ngwi ungwɔnɛ kyɔ nyɛ nɛ, Imgbasho gbe ama ogbiikwɔ nu ma nghataa ba onɔ mgbi oyegbɔ iSamue. <verse eid="ACT 13:20"/><verse number="21" style="v" sid="ACT 13:21"/>Nɛ inggisɛ ntona si mina utɔ, man Imgbasho kye iSol ongwɛ iKish, mi udzɛ mgbi iBenjamin nu ma, o sɔ utɔ onova ngwusefa. <verse eid="ACT 13:21"/><verse number="22" style="v" sid="ACT 13:22"/>Ngwi o wa dulu iSol utɔ nɛ, o nu iDevedi yɛɛ utɔ mgbi ama. O kyɔ obwɛndɛ ikyon gbɛɛ: &lt;Ani tu iDevedi ongwɛ iJese inggisɛ ongwi itukwu mgbi ani, o ka kyɔ alungwɔ duu ngwi ani mina gbɛɛ no kyɔ mani.&gt;<verse eid="ACT 13:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 13:23"/>&lt;&lt;Mi etɔ mgbi inggisɛ nɛ, Imgbasho kye ongye Onagbɛ iYesu nu emi Israi, dafi o zondu mani. <verse eid="ACT 13:23"/><verse number="24" style="v" sid="ACT 13:24"/>Duuse ni iYesu wita idɔ yɔ, iJɔn gbeesɔ okyatitukwu bɛyi iBatisima nya ali inggisɛ duu mi Israi. <verse eid="ACT 13:24"/><verse number="25" style="v" sid="ACT 13:25"/>Ngwi iJɔn le ngyɛlu idɔ mgban nɛ, o byi ma gbɛɛ: &lt;Ema tsɛwɛ gbɛɛ ani li emɛ? Ani li ongwu ma ba. Ei, o kyɛma mi iyikpa ani, odi okpafɔ mgban kpaa ani mɛ oshɛ ba.&gt;<verse eid="ACT 13:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 13:26"/>&lt;&lt;Emi ongwunani, engwɛ Abrahan, bɛyi Udzengye ama omio Imgbasho, li ikye mgbi eyi ngwi a kye esɔ mgbi owatɔ-watɔ nɛ ba aani. <verse eid="ACT 13:26"/><verse number="27" style="v" sid="ACT 13:27"/>Inggisɛ emi iJerosalin bɛyi ama ogbe ma teyi difwi itɔ inggisɛ ngwu iYesu dzɛ ma ba, kpaa mi ongwɔn ikwɔ yɔ, a mbwumbwo ungwɔ ngwi ama ogbɛɛsɛ li tsekise gbɔ mi alegbe otonyewo mani. <verse eid="ACT 13:27"/><verse number="28" style="v" sid="ACT 13:28"/>Dafi a tu itɔdzɛ nmɛ ongwɔn ba nɛ kpaa, a nya iPlatu gbɛɛ no nu ondu nu ma ka ngwɔn. <verse eid="ACT 13:28"/><verse number="29" style="v" sid="ACT 13:29"/>Ngwi a kyi kyɔlu alungwɔ ngwi a lɔ ikpewon duu ma ngyɛ nɛ, a tashulun mi ekwatsi di kyon ndzi. <verse eid="ACT 13:29"/><verse number="30" style="v" sid="ACT 13:30"/>Nghaduu Imgbasho kyilon mi ikwongye, <verse eid="ACT 13:30"/><verse number="31" style="v" sid="ACT 13:31"/>egbe ibyibyi ama nwafɔ yan mi iGalalia kɛ iJerosalin ma din. A li obwɛndɛ mgban mbi emideyi onɛnɛni.<verse eid="ACT 13:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 13:32"/>&lt;&lt;Eyi le nya ema Esɔ Osuse nɛni: Li ungwɔ ngwi Imgbasho zondu yi emi otseyi <verse eid="ACT 13:32"/><verse number="33" style="v" sid="ACT 13:33"/>o mbwumbwo ikye eyi emi ongwama, mi okyile iYesu mi ikwongye. Dafi a tsekise lɔn mi afɛ mgbi ashi ongwu fan mani gbɛɛ:</para>
  <para style="p" vid="ACT 13:33">&lt;&lt; &lt;Abu li Ongwani;</para>
  <para style="pi" vid="ACT 13:33">inɛ nɛ ani yɛɛ Otsabu.&gt;<verse eid="ACT 13:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 13:34"/>Ikyegbɛɛ Imgbasho kyilen mi ikwu, dika non bwa ba nɛ kpaa, a lɔn mi elodzɛ ntonɛni gbɛɛ: &lt;&lt; &lt;N ka kye ondu odzɛɛdzɛ osaan bɛyi mse ingblimɔ ngwi ani teyi dzɛ yi iDevedi ma nu abu.&gt;<verse eid="ACT 13:34"/></para>
  <para style="m">
    <verse number="35" style="v" sid="ACT 13:35"/>Li ngha ngwi a lɔ imbe oka gbɛɛ:</para>
  <para style="q1" vid="ACT 13:35">&lt;&lt; &lt;Abu ka nu Ongwabu Osaan</para>
  <para style="q2" vid="ACT 13:35">mbee ba aali.&gt;<verse eid="ACT 13:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 13:36"/>&lt;&lt;Lubana ngwi iDevedi kyɔ oweka mgbi Imgbasho ngyɛ duu nɛ, o kwulu; a kyon ndzi yi emi otsɔn ikpewo mgban bwa. <verse eid="ACT 13:36"/><verse number="37" style="v" sid="ACT 13:37"/>Nghaduu ongwu Imgbasho kyilon mi ikwu na bwa ba.<verse eid="ACT 13:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 13:38"/>&lt;&lt;Ikyenghanɛ, emi ongwunani, i mina ani gbɛɛ ni ema ye gbɛɛ li ikpewo iYesu ngwi a gbeesɔ odzita inggisɛ yi ali ibwubwe nya ema aani. <verse eid="ACT 13:38"/><verse number="39" style="v" sid="ACT 13:39"/>Mi ikpewon ali inggisɛ ngwu noyɛyɛ duu gye emyɛmyɛ, ola mgbi iMose yagba kyungwɔnɛ ba. <verse eid="ACT 13:39"/><verse number="40" style="v" sid="ACT 13:40"/>Gbɛwɛbyi ni ungwɔ ngwi ama ogbɛɛsɛ gbɔ ntona no ka kyɔ ema ba ungwɔ ama ngbɛɛ:<verse eid="ACT 13:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="ACT 13:41"/>&lt;&lt; &lt;Dii, ema ama ogbɔ agya,</para>
  <para style="q2" vid="ACT 13:41">kwu Imgbasho shanyɛ ntonɛ,</para>
  <para style="q1" vid="ACT 13:41">ka kwulu ema ewo,</para>
  <para style="q2" vid="ACT 13:41">ema dika dzili.</para>
  <para style="q1" vid="ACT 13:41">Ani ka kyungwɔ mi egbe mgbi ema</para>
  <para style="q2" vid="ACT 13:41">ngwi ema ka noyɛyɛ ba yeba</para>
  <para style="q1" vid="ACT 13:41">ni inggisɛ nyaanya ema kpaa.&gt; &gt;&gt;<verse eid="ACT 13:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 13:42"/>Dafi iPol yi iBanabasi le dzita ozu okwakye mgbi emi iJuda nɛ, inggisɛ ntona bɔ ma gbɛɛ nu ma di wa gbɔdzɛ mi itɔdzɛ ntonɛ mi egbe otonyidɔ nkyɛ nɛni. <verse eid="ACT 13:42"/><verse number="43" style="v" sid="ACT 13:43"/>Onɔ ngwi a ngyɛlu okwakye nɛ, emi iJuda ibyibyi bɛyi ama nkyata le sunu odzɛ Imgbasho mgbi emi iJuda ma, kyɛdɔ iPol yi iBanabasi, a gbɔdzɛ yi ama di nu ma itukwu ofyumfye-fyumfye gbɛɛ nu ma kiyayi odzɛ mi elela mgbi Imgbasho.<verse eid="ACT 13:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 13:44"/>Mi egbe otonyidɔ ngbɔdɔ ma, i dzɛ dafi inggisɛ mi ogalu duu kwakye ikye ofwo elodzɛ mgbi Otsɛ mani. <verse eid="ACT 13:44"/><verse number="45" style="v" sid="ACT 13:45"/>Ngwi emi iJuda di ibyi inggisɛ ntona nɛ, a kaka uwaba dile fyito mi odzɛ ngwi iPol le gbɔ mani.<verse eid="ACT 13:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="ACT 13:46"/>Nɛ iPol yi iBanabasi nu ma uka yi abɔ otsigɛgɛ gbɛɛ: &lt;&lt;Dzɛ gyɔ ngwi eyi kika gbɔdzɛ Imgbasho nya ema ababɔ. Kpaa ngwi ema fwan di kye ewema wuuta otu oshishe igyegwu ba nɛ, eyi yile inɛ byi Udzengye onɛnɛni. <verse eid="ACT 13:46"/><verse number="47" style="v" sid="ACT 13:47"/>Lubana nɛnɛ li ungwɔ ngwi Otsɛ wo eyi ola mi ele aani gbɛɛ:</para>
  <para style="q1" vid="ACT 13:47">&lt;&lt; &lt;Ani nu abu li osa mbi Udzengye,</para>
  <para style="q2" vid="ACT 13:47">ikyegbɛɛ ni abu kye esɔ</para>
  <para style="q2" vid="ACT 13:47">mgbi owatɔ-watɔ kpatsɛ ɛsɛ.&gt; &gt;&gt;<verse eid="ACT 13:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 13:48"/>Onɔ ngwi Udzengye fwo odzɛ nɛ nɛ, ewo shɛta lo ma a di kye mmwɛ nu elodzɛ mgbi Otsɛ; ama ngwu a di sadu ma ikye oshishe igyegwu duu noyɛyɛ.<verse eid="ACT 13:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="ACT 13:49"/>Elodzɛ mgbi Otsɛ si gbɔfwɛ kpatsɛ ayɛsɛ na duu. <verse eid="ACT 13:49"/><verse number="50" style="v" sid="ACT 13:50"/>Nghaduu emi iJuda kaka mbi engyaa ama omio Imgbasho ama nle kpɔngɔ bɛyi inggisɛ ama ogbe inggisɛ teyi mi ogalu nani. A nu ma wita eye yi iPol bɛyi iBanabasi, di lɔ ma onya tɔ mi ayɛsɛ nani. <verse eid="ACT 13:50"/><verse number="51" style="v" sid="ACT 13:51"/>Nghanɛ a kyi gbolu ombulu mi afɔ mgbi ama dafi a gbela yi ama ba mani, ta a si lu iKonu. <verse eid="ACT 13:51"/><verse number="52" style="v" sid="ACT 13:52"/>Man engwafɔ si mbwo yi atsa bɛyi Onodzi Osaan.<verse eid="ACT 13:52"/></para>
  <chapter eid="ACT 13"/>
  <chapter number="14" style="c" sid="ACT 14"/>
  <para style="s1">IPol yi iBanabasi mi iKonu</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 14:1"/>IPol yi iBanabasi ka kaka ozu okwakye mgbi emi iJuda mi iKonu dafi a teyi li kyɔ mani. Mi ele ma a gbeesɔ saan ta mmbwo inggisɛ kwuba mi iJuda bɛyi Udzengye onoyɛyɛ. <verse eid="ACT 14:1"/><verse number="2" style="v" sid="ACT 14:2"/>Kpaa emi iJuda ama nfwa onoyɛyɛ ntona kwo Udzengye ntona wo nu ma kyitingga yi iPol bɛyi iBanabasi. <verse eid="ACT 14:2"/><verse number="3" style="v" sid="ACT 14:3"/>Nghanɛ iPol yi iBanabasi kye onɔ kpakpa mi ele, le gbɔdzɛ mgbi Otsɛ mi ododa. Otsɛ tso gbɛɛ esɔ mgbi elela mgban na li otsitsi mi onu ma mfye okyungwɔ bɛyi ambɛ ama okwulewo. <verse eid="ACT 14:3"/><verse number="4" style="v" sid="ACT 14:4"/>Emi ogalu na gheefa, angbeka yɛ agya mgbi emi iJuda, angbeka yɛ agya mgbi ama ogbikye iYesu. <verse eid="ACT 14:4"/><verse number="5" style="v" sid="ACT 14:5"/>Ta Udzengye yi emi iJuda bɛyi engyukwo mgbi ama duu, wibu onu iPol bɛyi iBanabasi adzɛ di tsɛ ma akwutsɛ. <verse eid="ACT 14:5"/><verse number="6" style="v" sid="ACT 14:6"/>Nghaduu ngwi a wa ye odzɛ ele nɛ a tsinya lu iLikonia igeli mgbi iListra bɛyi iDebe bɛyi ɛsɛ ama nkpakɛkɛ won, <verse eid="ACT 14:6"/><verse number="7" style="v" sid="ACT 14:7"/>dika gbeesɔ osuse mi imbe ntonani.<verse eid="ACT 14:7"/></para>
  <para style="s1">Mi iListra bɛyi iDebe</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 14:8"/>Inggisɛ oka dzɛ iListra waawaa afɔ, tummya kyɛ ifu di kyikyɛ ye ba. <verse eid="ACT 14:8"/><verse number="9" style="v" sid="ACT 14:9"/>O kye adɔ ge le fwo iPol dafi o le gbɔdzɛ mani. IPol kye inɛ byin yɛyɛ, difwi gbɛɛ o dzɛ yi oyɛyɛ onuunu ongyɛlun ootse, <verse eid="ACT 14:9"/><verse number="10" style="v" sid="ACT 14:10"/>si kwu ela tɔ gbɛɛ, &lt;&lt;Kyato dzɛkunto mi afɔ mgbi abu!&gt;&gt; Mi elodzɛ nɛ, inggisɛ na ta lu esho si wita okyikyɛ.<verse eid="ACT 14:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 14:11"/>Onɔ ngwi ibyi ntona di ungwɔ ngwi iPol kyɔ nɛ, a wulu mi ondu iLikonia gbɛɛ, &lt;&lt;Imgbasho gbeka ba mbi eyi mi odzɛɛdzɛ mgbi inggisɛ owamyɛ wa!&gt;&gt; <verse eid="ACT 14:11"/><verse number="12" style="v" sid="ACT 14:12"/>IBanabasi a kwun gbɛɛ iDzeu, a di kwu iPol gbɛɛ iHɛmɛ<note caller="+" style="f"><char style="fr" closed="false">14:12 </char><char style="ft" closed="false">iDzeu li iyi Imgbasho okwukwo mgbi emi iGriki. IHɛmɛ li Imgbasho ogbɔdzɛ mgbi iDzeu</char></note> ikyesinɛ o li inggisɛ oteyi odzɛ ogbɔɔgbɔ. <verse eid="ACT 14:12"/><verse number="13" style="v" sid="ACT 14:13"/>Ta inggisɛ ofifɛ mgbi imgbasho mgbi iDzeu, ngwu ozu ofifɛ mgban dzɛ kyila yi igeli okwukwo nani, ba yi engyulumnda bɛyi ofumbu wa to onufɛ ogalu igeli ikyesinɛ ongwu bɛyi ibyi inggisɛ ntona mina ofifɛ nu iPol bɛyi iBanabasi.<verse eid="ACT 14:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 14:14"/>Nghaduu ngwi iPol yi iBanabasi fwo ungwɔnɛ nɛ, a fawa angwuto mgbi ama tsinya kaka idzidzɛ ibyi inggisɛ, le weela gbɛɛ: <verse eid="ACT 14:14"/><verse number="15" style="v" sid="ACT 14:15"/>&lt;&lt;Engyulɔ, kyɔsinɛ ngwi ema le kyungwɔnɛ nghaa? Eyi kpaa li inggisɛ owamyɛ ta dafi ema mani. Eyi kye esɔ osuse nɛ le wa nu ema, le nya ema gbɛɛ ni ema kyata mi ayayi ungwɔ ntonɛni luba mbi Imgbasho oshishe, ongwu nta esho yi esɛ bɛyi ekyoo okwukwo bɛyi alungwɔ ama nto efu duu nani. <verse eid="ACT 14:15"/><verse number="16" style="v" sid="ACT 14:16"/>Tugbe ma, Imgbasho li nu ali ɛsɛ duu kyɔ owitukwu mgbi ama. <verse eid="ACT 14:16"/><verse number="17" style="v" sid="ACT 14:17"/>Nghaduu o li nya okye ewon tso ma ba. O tso ema mse mgban mi onu ema mmbwo di nu etɔ ungwogye she mi onɔ mgban; o nu ema ungwogye kpakpa di mbwo ema yi atsa mi itukwu.&gt;&gt; <verse eid="ACT 14:17"/><verse number="18" style="v" sid="ACT 14:18"/>Yi elodzɛ ntonɛ duu kpaa, i fyi ma mfye okwɔ ibyi inggisɛ ntona ofifɛ nu ma.<verse eid="ACT 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 14:19"/>Ta emi iJuda angbeka kyɛ mi Antiɔku bɛyi iKonu wa kwolu ibyi inggisɛ luba agya mgbi ama. Nɛ a tsɛ iPol akwutsɛ di kwon tasɛ mi ogalu nani, le tsɛwɛ gbɛɛ o kwulu. <verse eid="ACT 14:19"/><verse number="20" style="v" sid="ACT 14:20"/>Kpaa ngwi engwafɔ wa kpakɛkɛ won nɛ, o kyato diyɛ lu ogalu nani. Tegblifan ma ongwu bɛyi iBanabasi dzata imbe na lu iDebe.<verse eid="ACT 14:20"/></para>
  <para style="s1">A yidɔ lu Antiɔku mi iSiria</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 14:21"/>A gbeesɔ osuse mi igeli okwukwo nani di tu inggisɛ ama onoyɛyɛ kwuba. Man a yɛ lu iListra, iKonu bɛyi Antiɔku, <verse eid="ACT 14:21"/><verse number="22" style="v" sid="ACT 14:22"/>a yile engwafɔ dzɛ ofɛ di kwu ma ɛwɛwo gbɛɛ nu ma noyɛyɛ mi otsitsi. A di nya ma gbɛɛ, &lt;&lt;Eyi ka nyɛ mi adzɛ kpakpa ikye okaka esutɔ mgbi Imgbasho.&gt;&gt; <verse eid="ACT 14:22"/><verse number="23" style="v" sid="ACT 14:23"/>IPol bɛyi iBanabasi dulu engyukwo nu ma mi ali okwakye mgbi emi iKrestu duu, yi ibɔ obɔɔbɔ bɛyi ondu otukwu-tukwu, a kye ma dubɔ Otsɛ, ongwu a kye oyɛyɛ onuunu mgbi ama byi mbon nani. <verse eid="ACT 14:23"/><verse number="24" style="v" sid="ACT 14:24"/>A nyɛ ongwi iPisidia, a wa kaka iPamfyilia, <verse eid="ACT 14:24"/><verse number="25" style="v" sid="ACT 14:25"/>ngwi a gbeesɔ mi iPega ngyɛ nɛ, a kye ikye dɔ lu Atalia.<verse eid="ACT 14:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 14:26"/>Mi Atalia ma a dzɛkyo mi uwaa yidɔ lu Antiɔku, imbe ngwi a kye ma dubɔ elela mgbi Imgbasho mi ikye idɔ ngwi a kyɔ ngyɛ nani. <verse eid="ACT 14:26"/><verse number="27" style="v" sid="ACT 14:27"/>Ngwi a kaka imbe na ma, a gbe emi iKrestu kwakye mbonyi di nya ma alungwɔ ngwi Imgbasho kyɔ nyɛ mbi ama, dafi o di kwulu ofɛ mgbi oyɛyɛ onuunu mbi Udzengye kpaa mani. <verse eid="ACT 14:27"/><verse number="28" style="v" sid="ACT 14:28"/>A si dzɛ yi engwafɔ mi imbe na onɔ tunto.<verse eid="ACT 14:28"/></para>
  <chapter eid="ACT 14"/>
  <chapter number="15" style="c" sid="ACT 15"/>
  <para style="s1">Okwakye mgbi engyukwo <optbreak/> mi iJerosalin</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 15:1"/>Inggisɛ angbeka kyɛ mi iJudia wa kaka Antiɔku man le tso ama onoyɛyɛ ntona gbɛɛ: &lt;&lt;Sede a ka kyɛ ema ikyɛ mi otsootso mgbi iMose bayɔ, ema ka yagba otu owatɔ-watɔ ba.&gt;&gt; <verse eid="ACT 15:1"/><verse number="2" style="v" sid="ACT 15:2"/>Mi odzɛ nɛ iPol bɛyi iBanabasi si kaka angwodzɛ ota-ta yi ama kpakpa. Ta a si dulu iPol yi iBanabasi, bɛyi ama onoyɛyɛ angbeka, gbɛɛ nu ma lu iJerosalin ka di ama ogbikye iYesu bɛyi engyukwo mi odzɛ nɛni. <verse eid="ACT 15:2"/><verse number="3" style="v" sid="ACT 15:3"/>Opokwakye mgbi emi iKrestu dɔ ma esɔ nu ma byi ofɛ abɔ, dafi a kyikyɛ nyɛ iFonishia bɛyi iSamaria nɛ, a gbɔ dafi Udzengye kpaa kyata yɛ luba mbi Imgbasho mani. Elodzɛ nɛ nu ama onoyɛyɛ duu ewo oshɛta kpaakpaa. <verse eid="ACT 15:3"/><verse number="4" style="v" sid="ACT 15:4"/>Ngwi a wa kaka iJerosalin nɛ, okwakye mgbi emi iKrestu yi ama ogbikye iYesu bɛyi engyukwo duu gbɛ ma, nɛta a nya ma alungwɔ ngwi Imgbasho kyɔ nyɛ mbi ama duu.<verse eid="ACT 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 15:5"/>Ta ama onoyɛyɛ angbeka ama ndzɛ agya mgbi emi iFarasi ma kyɛɛ tokɛ unto si gbɔgbɛɛ, &lt;&lt;Li kyɛmɛ-kyɛmɛ ngwi a ka nu Udzengye kyiikyɛ, di ngyo ola mgbi iMose.&gt;&gt;<verse eid="ACT 15:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 15:6"/>Nghanɛ ama ogbikye iYesu bɛyi engyukwo kyi ikye kwokyi yi ewoma ikye odi mi odzɛ nɛni. <verse eid="ACT 15:6"/><verse number="7" style="v" sid="ACT 15:7"/>Ngwi a gbɔdzɛ kpakpa nɛ, iPyita kyɛɛ unto si gbɔdzɛ yi ama gbɛɛ, &lt;&lt;Emi ongwunani, ema ye dafi mi onɔ ama nyɛ ma Imgbasho dulu ani mi idzidzɛ ema ogbɔ Esɔ Osuse mi ondu mgbi ani ni Udzengye fwo di noyɛyɛ mani. <verse eid="ACT 15:7"/><verse number="8" style="v" sid="ACT 15:8"/>Imgbasho n ye itukwu mgbi inggisɛ duu ma, tso gbɛɛ di ongwu gbɛ Udzengye mi okye Onodzi Osaan nu ma, yɛyɛ dafi o kyɔ yi eyi nɛni. <verse eid="ACT 15:8"/><verse number="9" style="v" sid="ACT 15:9"/>O tso idzidza mgbi eyi yi ama ba, lubana o salu ma itukwu yɛɛ saan ikyekyɛ a noyɛyɛ. <verse eid="ACT 15:9"/><verse number="10" style="v" sid="ACT 15:10"/>Nghama, kyɔsinɛ ngwi ema le fya ombadi Imgbasho mi okye okye egyeegyɛ ngwi eyi naadi emi otseyi yagba okye ye ba kye dɔ engwafɔ ikye? <verse eid="ACT 15:10"/><verse number="11" style="v" sid="ACT 15:11"/>Ei! Eyi noyɛyɛ gbɛɛ li mi elela mgbi Otsɛ mgbi eyi iYesu ngwi a dulu eyi tɔ, dafi ama kpaa a dulu ma tɔ nani.&gt;&gt;<verse eid="ACT 15:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 15:12"/>Okwakye na duu zumyɛ le gadɔ mbi iPol bɛyi iBanabasi dafi a le nya ma odzɛ ungwɔ ama okwulewo bɛyi ambɛ ama ngwi Imgbasho kyɔ yi Udzengye nyɛ mbi ama mani. <verse eid="ACT 15:12"/><verse number="13" style="v" sid="ACT 15:13"/>Onɔ ngwi a ngyɛ nɛ, iJɛnsi gbɔdzɛ tɔ gbɛɛ: &lt;&lt;Engwunani, gadɔ mbi ani na. <verse eid="ACT 15:13"/><verse number="14" style="v" sid="ACT 15:14"/>ISaimɔn tsuutsa nya eyi dafi mi ababɔ ma Imgbasho tso oweka mgban mi odulu Udzengye angbeka nu ma yɛɛ emidan mani. <verse eid="ACT 15:14"/><verse number="15" style="v" sid="ACT 15:15"/>Elodzɛ mgbi ama ogbɛɛsɛ kpaa kwokyi yi ungwɔnɛ, dafi a lɔ mi Afɛ mani gbɛɛ:<verse eid="ACT 15:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ACT 15:16"/>&lt;&lt; &lt;Ni ungwɔnɛ nyɛ ani ka yidɔ</para>
  <para style="q2" vid="ACT 15:16">di yile esutɔ mgbi iDevedi sisɛ.</para>
  <para style="q1" vid="ACT 15:16">Ikpishi mgban ani ka yilen mbɛ,</para>
  <para style="q2" vid="ACT 15:16">dika non dzɛ mi odzɛɛdzɛ mgban,<verse eid="ACT 15:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 15:17"/>adzi ni inggisɛ owamyɛ ama nsisi duu pita Otsɛ,</para>
  <para style="q2" vid="ACT 15:17">bɛyi Udzengye ama ndzɛ yi</para>
  <para style="q2" vid="ACT 15:17">iyi mgbi ani duu,</para>
  <para style="q1" vid="ACT 15:17">li ngha ngwi Otsɛ nkyungwɔ</para>
  <para style="q2" vid="ACT 15:17">ntonɛnɛ gbɔ aali&gt;<verse eid="ACT 15:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ACT 15:18"/>ungwɔna a teyi yen mi owita-wita</para>
  <para style="q2" vid="ACT 15:18">mgbi ɛsɛ majo.<verse eid="ACT 15:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 15:19"/>&lt;&lt;Nghanɛ, ani le ngyɛlu gbɛɛ, ni eyi ka non yɛɛ okye mbi Udzengye ama nle kyata luba mbi Imgbasho ba. <verse eid="ACT 15:19"/><verse number="20" style="v" sid="ACT 15:20"/>Tatase ni eyi lɔ ma afɛ, nya ma nu ma dulu abɔ mi ungwogye ngwi a kye fifɛ nu angwula, mi amah idza, mi mmbwɛ mmbwaba ngwi a tsili-tsili ma onbukwɔ bɛyi mi ali eyi duu. <verse eid="ACT 15:20"/><verse number="21" style="v" sid="ACT 15:21"/>Lubana a gbɔ ola mgbi iMose mi ali ogalu onɔ kɛ di gbɔn mi imbe okwakye mgbi emi iJuda ali egbe otonyewo duu.&gt;&gt;<verse eid="ACT 15:21"/></para>
  <para style="s1">Okwakye lɔ afɛ mbi Udzengye <optbreak/> ama onoyɛyɛ</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 15:22"/>Ta ama ogbikye iYesu yi engyukwo, bɛyi okwakye mgbi emi iKrestu olɔlɔ duu, bwondu dulu emidama angbeka di dɔ ma esɔ lu Antiɔku yi iPol bɛyi iBanabasi. A dulu iJuda (ngwi a li kwun gbɛɛ iBasaba) bɛyi iSaila, inggisɛ efa ntonɛ a nu ma mmwɛ kpaakpaa mi idzidzɛ mgbi ama onoyɛyɛ. <verse eid="ACT 15:22"/><verse number="23" style="v" sid="ACT 15:23"/>A kye afɛ ntonɛ dɔ ma esɔ a lɔ mi ele gbɛɛ:</para>
  <para style="mi" vid="ACT 15:23">Ama ogbikye iYesu yi engyukwo, bɛyi emi engwunema, dɛsɔ angba mbi ema Udzengye emi engwuneeyi mi Antiɔku, iSiria, bɛyi iSilisia.<verse eid="ACT 15:23"/></para>
  <para style="pi">
    <verse number="24" style="v" sid="ACT 15:24"/>Eyi fwo gbɛɛ angbeka mbi eyi tɔ mi oye-ye mgbi eyi ba di nu ema okakewo, nu ema isɔ mi itukwu mi odzɛ ngwi a gbɔ mani. <verse eid="ACT 15:24"/><verse number="25" style="v" sid="ACT 15:25"/>Nghanɛ eyi duu gbela odulu inggisɛ angbeka yi emi okeyi ingblimɔ iBanabasi yi iPol di dɔ ma esɔ mbi ema. <verse eid="ACT 15:25"/><verse number="26" style="v" sid="ACT 15:26"/>Inggisɛ ntonɛ kye oshishe mgbi ama lasɛ mi ikye iyi mgbi Otsɛ mgbi eyi iYesu iKrestu. <verse eid="ACT 15:26"/><verse number="27" style="v" sid="ACT 15:27"/>Nghawanɛ eyi le dɔ iJuda yi iSaila esɔ nu ma ka kyɔ obwɛndɛ ongwi ondu mi ungwɔ ngwi eyi le lɔ ntonɛni.<verse eid="ACT 15:27"/></para>
  <para style="pi">
    <verse number="28" style="v" sid="ACT 15:28"/>I kpa Onodzi Osaan bɛyi eyi ombwo ema okye ngha ungwɔ ntonɛ ba, sede li ama ndzɛ kyɛmɛ-kyɛmɛ nɛni. <verse eid="ACT 15:28"/><verse number="29" style="v" sid="ACT 15:29"/>Ema ka gye ungwogye ngwi a kye fifɛ nu angwula ba, ungwɔ eyeeyi ba, ema dika gye mmbwɛ mmbwaba ngwi a tsili-tsili ma onbukwɔ ba, di dulu abɔ mi amah idza. Kini ema kyungwɔ ntonɛ bayɔ, li ayin seali.</para>
  <para style="m" vid="ACT 15:29">Kɛ saan na.<verse eid="ACT 15:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 15:30"/>Inggisɛ ntona kyɛɛ okyɛɛ lu Antiɔku, ka kwu emi iKrestu kwakye mbonyi kye afɛ ma nu ma. <verse eid="ACT 15:30"/><verse number="31" style="v" sid="ACT 15:31"/>Inggisɛ ntona gbɔ afɛ nani ewo di shɛta loma ikyesinɛ li esɔ okwu ma ɛwɛwo. <verse eid="ACT 15:31"/><verse number="32" style="v" sid="ACT 15:32"/>IJuda yi iSaila, ama abuoma li oyegbɔ, a gbɔdzɛ kpakpa okwu ama onoyɛyɛ ntona ɛwɛwo di yile ma dzɛ ofɛ. <verse eid="ACT 15:32"/><verse number="33" style="v" sid="ACT 15:33"/>Ngwi a kye egbe gwee mi ele nɛ, ama onoyɛyɛ ntona wo ma ofɛ mi iyu nu ma yidɔ lu ka tu ama ndɔ ma esɔ mani. <verse eid="ACT 15:33"/><verse number="34" style="v" sid="ACT 15:34"/>(Nghaduukpaa iSaila yɔ i kpan odzɛ imbe nani.)<note caller="+" style="f"><char style="fr" closed="false">15:34 </char><char style="ft" closed="false">Afɛ angbeka dzɛ yi ambulu nɛ ba</char></note> <verse eid="ACT 15:34"/><verse number="35" style="v" sid="ACT 15:35"/>Kpaa iPol bɛyi iBanabasi tila dzɛ Antiɔku, nɛ ama bɛyi inggisɛ angbeka kwuba tso diyɛ gbeesɔ mgbi Otsɛ mi ele.<verse eid="ACT 15:35"/></para>
  <para style="s1">IPol gha yi iBanabasi</para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 15:36"/>I wa la gwee nɛ iPol gbɔ yi iBanabasi gbɛɛ, &lt;&lt;Ba ni eyi yɛ ka kpadi emi ongwuneyi mi ali igeli ngwi eyi gbeesɔ mgbi Otsɛ mi ele duu, di di dafi a le kyɔ mani.&gt;&gt; <verse eid="ACT 15:36"/><verse number="37" style="v" sid="ACT 15:37"/>I mina iBanabasi okye iJɔn, ngwu a di li kwun gbɛɛ iMaki na, wafɔ yi ama, <verse eid="ACT 15:37"/><verse number="38" style="v" sid="ACT 15:38"/>kpaa iPol tsɛwɛ gbɛɛ li ayin ba okyon wafɔ yi ama, ikyesinɛ o tse dzamata mi iPamfyilia di nya okyidɔ yi ama. <verse eid="ACT 15:38"/><verse number="39" style="v" sid="ACT 15:39"/>A dzɛ yi angwodzɛ fyumfye kpakpa yi ewoma nɛman a gha okyɛɛ. IBanabasi kyelu iMaki fooye lu iSapru, <verse eid="ACT 15:39"/><verse number="40" style="v" sid="ACT 15:40"/>nghaduu iPol dulu iSaila lu yan, ngwi a le lu nɛ, ama onoyɛyɛ kye ma wokɛ iwulu abɔ mgbi Otsɛ. <verse eid="ACT 15:40"/><verse number="41" style="v" sid="ACT 15:41"/>O kyikyɛ kpatsɛ iSiria bɛyi iSilisia, le fyi okwakye mgbi emi iKrestu mfye itukwu.<verse eid="ACT 15:41"/></para>
  <chapter eid="ACT 15"/>
  <chapter number="16" style="c" sid="ACT 16"/>
  <para style="s1">Agaba mgbi iPol ongwu fan</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 16:1"/>IPol bɛyi iSaila kɛ iDebe, a di nyɛ kɛ iListra, imbe ngwi inggisɛ onoyɛyɛ ngwu a li kwun di iTimoti dzɛ, Onɔn li emi iJuda di noyɛyɛ. Nghaduu otsɔn li emi iGriki. <verse eid="ACT 16:1"/><verse number="2" style="v" sid="ACT 16:2"/>Ama onoyɛyɛ mi iListra bɛyi iKonu duu gbɔdzɛ osuse ikpewo iTimoti. <verse eid="ACT 16:2"/><verse number="3" style="v" sid="ACT 16:3"/>Nghanɛ i mina iPol okyon wafɔ kɛ agaba yan, ikyenghanɛ o kyan ikyɛ ikye mgbi emi iJuda ama nto imbe na mani, ikyena ama duu ye gbɛɛ otsɔn li emi iGriki. <verse eid="ACT 16:3"/><verse number="4" style="v" sid="ACT 16:4"/>Ngwi a le dzagaba mi igeli igeli kyɛ nɛ, a kye ewodzɛ ngwi ama ogbikye iYesu bɛyi engyukwo emi iJerosalin kye bwalu ma, gbɔ nya inggisɛ ntona ikyegbɛɛ nu ma sunu mi ele. <verse eid="ACT 16:4"/><verse number="5" style="v" sid="ACT 16:5"/>Nghanɛ ozu okwakye mgbi emi iKrestu duu fyumfye kpakpa mi oyɛyɛ onuunu dile mbwoombwo mi mmbwo mgbi ama alegbe-alegbe.<verse eid="ACT 16:5"/></para>
  <para style="s1">Ela okwuukwu mi iMasidonia</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 16:6"/>Akpe oka nɛ iPol bɛyi emidan dzagaba nyɛ iFrijia bɛyi iGalatia, ikyena Onodzi Osaan nya ma gbɛɛ nu ma ka yama gbeesɔ mi ayɛsɛ mgbi Asia ba. <verse eid="ACT 16:6"/><verse number="7" style="v" sid="ACT 16:7"/>Ngwi a wa to otsee iMisia nɛ, i mina ma okaka iBitinia, nghaduu Onodzi mgbi iYesu nu ma ofɛ nu ma kaka ba. <verse eid="ACT 16:7"/><verse number="8" style="v" sid="ACT 16:8"/>Nghanɛ ta a si wikye nyɛ ongwi iMisia lu iTroa.<verse eid="ACT 16:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 16:9"/>Mi otu na iPol si di inɛ odiidi. O di ongyulɔ mi iMasidonia, le tɛkyɛ yan gbɛɛ, &lt;&lt;Ba iMasidonia wa ya eyi abɔ.&gt;&gt; <verse eid="ACT 16:9"/><verse number="10" style="v" sid="ACT 16:10"/>Ngwi iPol di inɛ odiidi nyɛ nɛ, eyi si wewo akponyi lu iMasidonia. ikyekyɛ eyi kyi kye gbɛɛ, Imgbasho kwu eyi ela gbɛɛ ni eyi ka gbɔ Esɔ Osuse nya ma mi imbe nani.<verse eid="ACT 16:10"/></para>
  <para style="s1">ILedia mi iFyilipi noyɛyɛ mbi iYesu</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 16:11"/>Eyi kaka uwaa mi iTroa dzɛkyo dɔkɛ ibu iSamotre, tegblifan nɛ eyi bɛsɛ mi iNiapoli. <verse eid="ACT 16:11"/><verse number="12" style="v" sid="ACT 16:12"/>Mi imbe na eyi lu iFyilipi, ogalu ongwi ababɔ mi agwɔ iMasidonia nbyidzɛ abumfye mgbi iRoma nani; eyi la imbe na egbe ibyibyi.<verse eid="ACT 16:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 16:13"/>Mi egbe otonyewo nɛ, eyi tasɛ dzita onufɛ ogalu lu ondekyoo, imbe ngwi eyi tsɛwɛ gbɛɛ emi iJuda ka kwakye le bibɔ mani. Eyi sisɛ di wita ogbɔdzɛ yi engyaa angbeka ama nkwakye mi imbe na mani. <verse eid="ACT 16:13"/><verse number="14" style="v" sid="ACT 16:14"/>Onyi mi idzidzɛ ma nle fwo eyi ma li iLedia mi iTyatira, o li gbe angwuto ondlɛndlɛ gya. O li sunu Imgbasho, nɛ Otsɛ Imgbasho kwulun itukwu non gbela odzɛ ngwi iPol le gbɔ mani. <verse eid="ACT 16:14"/><verse number="15" style="v" sid="ACT 16:15"/>Ngwi a kyɔn iBatisima bɛyi emidan duu nɛ, o bɔ eyi gbɛɛ ni eyi ba udan. O gbɛɛ, &lt;&lt;Ni ema kye ani gbɛɛ ani noyɛyɛ mbi Otsɛ yɔ, ba wa la udɛ ani na.&gt;&gt; O biibɛ yi eyi, ta eyi si kɛ.<verse eid="ACT 16:15"/></para>
  <para style="s1">IPol bɛyi iSaila mi obawi</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 16:16"/>Egbe oka ngwi eyi le kɛ imbe obibɔ nɛ, eyi kpatsɛ yi ongwongyaa ofyɛɛ ngwu esɛ dɔn ikye di li ongye ogbɛɛsɛ. O li tseefa kwo awuya kpakpa nu emi otsidɔn. <verse eid="ACT 16:16"/><verse number="17" style="v" sid="ACT 16:17"/>Ongwongyaa nɛ kyɛdɔ iPol yi eyi le kwu-ela gbɛɛ, &lt;&lt;Inggisɛ ntonɛ li engbidɔ mgbi Imgbasho onghaangha, a le nya ema ofɛ ngwi ema ka watɔ mani.&gt;&gt; <verse eid="ACT 16:17"/><verse number="18" style="v" sid="ACT 16:18"/>O kiyayi ogbɔdzɛ nɛ alegbe-alegbe, nghataa itukwu wa wulu iPol man o kyata nya onodzi obube nwodzɛ mbon na gbɛɛ, &lt;&lt;N wo abu ola mi iyi mgbi iYesu iKrestu tasɛ mbon!&gt;&gt; Onodzi na si tɔ dzanta mi onɔ nani.<verse eid="ACT 16:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 16:19"/>Ngwi emi otsidɔ ofyɛɛ na difwi gbɛɛ ofɛ otu awuya mgbi ama tukwu nɛ, a si kpakli iPol yi iSaila kwo ma kpɛɛkpɛɛ lu ifyidu ka wo emi mfye abɔ. <verse eid="ACT 16:19"/><verse number="20" style="v" sid="ACT 16:20"/>A gbe ma ba mbi ama ogbiikwɔ wa gbɛɛ, &lt;&lt;Engyulɔ ntonɛ li emi iJuda, a le ba yi okakewo mi igeli mgbi eyi kpakpa. <verse eid="ACT 16:20"/><verse number="21" style="v" sid="ACT 16:21"/>A tole tso aletɔ nli ayin ba mbi eyi emi iRoma.&gt;&gt;<verse eid="ACT 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 16:22"/>Ibyi si yaokɛ okyɔ eye yi iPol bɛyi iSaila, ama ogbiikwɔ kyi nghalu ma angwuto di noola gbɛɛ nu ma gbo ma ibe. <verse eid="ACT 16:22"/><verse number="23" style="v" sid="ACT 16:23"/>Ngwi a gbo ma ibe saan nɛ, a gbe ma wokɛ obawi. A si wo ongye ongyoongyo na ola gbɛɛ no ngyo ma saan. <verse eid="ACT 16:23"/><verse number="24" style="v" sid="ACT 16:24"/>Ngwi a woola nghanɛ, inggisɛ ongyo obawi na si gbe ma wokɛ mi idzidzɛ obawi di ta ma itse mi afɔ.<verse eid="ACT 16:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 16:25"/>Mi idzidzɛ otu nɛ, iPol bɛyi iSaila tole bibɔ dile shashi mbi Imgbasho. Inggisɛ angbeka mi ifu obawi tole fwo ma dafi a le shashi mani.<figure style="fig" alt="IPol yi iSaila woto obawi" file="DN00509b.tif" size="col" loc="16;25" copy="DN00509b" ref="16:25">Paul and Silas in prison</figure> <verse eid="ACT 16:25"/><verse number="26" style="v" sid="ACT 16:26"/>Ntunto nɛ, ikpɛsɛ suusu kpakpa man itozu mgbi obawi suusu. Onufɛ obawi duu kwulu akponyi, ta itse ngwi a ta ama nwoto obawi duu shɛ. <verse eid="ACT 16:26"/><verse number="27" style="v" sid="ACT 16:27"/>Ngwi inggisɛ ongyo obawi wa gbokyato nɛta, o dili onufɛ obawi tsatsa lato asisa, o si kye ngwalu okwusunkli mgban ikye ongwɔ ewon, ikyekyɛ o tsɛwɛ gbɛɛ emi obawi duu tse lu. <verse eid="ACT 16:27"/><verse number="28" style="v" sid="ACT 16:28"/>Hininɛ iPol fan ela gbɛɛ, &lt;&lt;Ka yama ngwɔ ewoo ba! Eyi duu ka todzɛ aana!&gt;&gt;<verse eid="ACT 16:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 16:29"/>Ongye ongyo obawi kwu ela ola si maama lu ifun ka gbɛsɛ lakiyayi iPol bɛyi iSaila le shi adagba gbagbaagba. <verse eid="ACT 16:29"/><verse number="30" style="v" sid="ACT 16:30"/>O gbe ma tasɛ wa byi ma gbɛɛ, &lt;&lt;Engyukwo, li ekyɛ n ka kyɔ kyɛmɛ-kyɛmɛ se n ka watɔ?&gt;&gt;<verse eid="ACT 16:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 16:31"/>A nyan gbɛɛ, &lt;&lt;Nu oyɛyɛ mbi Otsɛ iYesu ta abu ka tu owatɔ-watɔ bɛyi udɛ mgbi abu duu.&gt;&gt; <verse eid="ACT 16:31"/><verse number="32" style="v" sid="ACT 16:32"/>Nɛta a si gbɔ elodzɛ mgbi Otsɛ iYesu nyan bɛyi ama nto udan duu. <verse eid="ACT 16:32"/><verse number="33" style="v" sid="ACT 16:33"/>Ngwi ka li otu mani, inggisɛ ongyo obawi na gbe ma ka sa ma ifwa mi ewo tsatsadu; ntunto mata a si kyɔn iBatisima bɛyi emidan duu. <verse eid="ACT 16:33"/><verse number="34" style="v" sid="ACT 16:34"/>Inggisɛ ongyo obawi na gbe ma tɔ luba udɛ mgban wa nu ma ungwogye, o mbwo yi atsa, ikyekyɛ o yɛɛ owa noyɛyɛ mbi Imgbasho, ongwu yi etɔ mgban duu.<verse eid="ACT 16:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 16:35"/>Ngwi egbe wa fa nɛ, ama ogbiikwɔ dɔ obaka mgbi ama esɔ mbi inggisɛ ongyo obawi na gbɛɛ: &lt;&lt;Nu inggisɛ ntona ofɛ nu ma lu.&gt;&gt; <verse eid="ACT 16:35"/><verse number="36" style="v" sid="ACT 16:36"/>Inggisɛ ngyo obawi nɛ si nya iPol gbɛɛ, &lt;&lt;Ama ogbiikwɔ ntona dɛsɔ gbɛɛ ni a dzita abu bɛyi iSaila. Onɛnɛ ema ka lu. Lu mi iyu na.&gt;&gt;<verse eid="ACT 16:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 16:37"/>Nghaduu iPol nya obaka ntona gbɛɛ: &lt;&lt;A gbo eyi ibe mi ododa ikwɔ kpaa a yama fwo eyi ba, dafi eyi li emi iRoma nɛ kpaa a di gbe eyi wo obawi. Nghama onɛnɛ a mina odzita eyi ni eyi lu ngha mgbanta imimaa? N fwa! Nya nu ma ba abuoma wa dulu eyi tasɛ.&gt;&gt;<verse eid="ACT 16:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 16:38"/>Obaka ntonɛ si yɛ lu ka nya ama ogbiikwɔ ntona ngha, dafi a ka fwo gbɛɛ iPol yi iSaila li emi iRoma nɛ, imio wo ma. <verse eid="ACT 16:38"/><verse number="39" style="v" sid="ACT 16:39"/>A lukwu ma kɛ obawi ka nu ma aba ogyeegye. A gbe ma tasɛ wa tɛkyɛ nu ma gbɛɛ nu ma lu dzita ogalu mgbi ama. <verse eid="ACT 16:39"/><verse number="40" style="v" sid="ACT 16:40"/>Nghaduu iPol bɛyi iSaila yidɔ luba udɛ iLedia, mmana a wa tu ama onoyɛyɛ angbeka, a di kwu ma ɛwɛ wo duuse a kwa lu dzita igeli nani.<verse eid="ACT 16:40"/></para>
  <chapter eid="ACT 16"/>
  <chapter number="17" style="c" sid="ACT 17"/>
  <para style="s1">IPol gbeesɔ mi iTesalonika</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 17:1"/>Ngwi iPol bɛyi emi okan dzagaba ka nyɛ ongwi Amfipoli yi Apolonia nɛ, a wa to iTesalonika, imbe na ozu okwakye mgbi emi iJuda dzɛ efu. <verse eid="ACT 17:1"/><verse number="2" style="v" sid="ACT 17:2"/>Dafi iPol teyi li kyɔ mani, o ka kaka ozu okwakye mgbi emi iJuda, man si kponya yi ama mi Afɛ mi egbe otonyewo nghi eta, <verse eid="ACT 17:2"/><verse number="3" style="v" sid="ACT 17:3"/>le nu ma osa diyɛ le tso ma ambɛ gbɛɛ iMedzaya ma ka gyadzɛ kyɛmɛ di kyɛɛ mi ikwongye. O gbɛɛ, &lt;&lt;IYesu ngwu ani le gbɔdzan nya ema nɛ li iMedzaya mani.&gt;&gt; <verse eid="ACT 17:3"/><verse number="4" style="v" sid="ACT 17:4"/>Emi iJuda angbeka noyɛyɛ di yɛɛ ama okyɛdɔ iPol bɛyi iSaila, dafi emi iGriki ibyibyi ama omio Imgbasho bɛyi engyaa imɔ angbeka kwuba kpaa kyɔ mani.<verse eid="ACT 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 17:5"/>Nghaduu emi iJuda angbeka kyoofu, nghanɛ a kwu ama ondeye angbeka kwakye mi ifyidu, a yɛɛ ondu onyi man si wita eye mi ogalu nani. A tsinya ka kaka udɛ iJasɔn le pita iPol bɛyi iSaila ikye okye ma luba esɛ wa nu ibyi inggisɛ. <verse eid="ACT 17:5"/><verse number="6" style="v" sid="ACT 17:6"/>Dafi a yama tu ma mi imbe na ba nɛ, a si kwo iJasɔn yi ama onoyɛyɛ angbeka gbe ma kɛ mbi engyukwo emi igeli, le kwu-ela gbɛɛ: &lt;&lt;Inggisɛ ama nle nu okakewo kpatsɛ ɛsɛ duu nɛ, bato mmɛnɛ onɛnɛni, <verse eid="ACT 17:6"/><verse number="7" style="v" sid="ACT 17:7"/>ma iJasɔn gbɛ ma kaka udɛ mgban. Ama duu tole foola ngwi iSidza wo, a tole gbɛɛ utɔ oka dzɛ ngwu a li kwun di iYesu.&gt;&gt; <verse eid="ACT 17:7"/><verse number="8" style="v" sid="ACT 17:8"/>Ngwi a fwo odzɛ nɛ ngha nɛ, igeli duu yɛɛ yaaya. <verse eid="ACT 17:8"/><verse number="9" style="v" sid="ACT 17:9"/>Ta a nu iJasɔn bɛyi angbeka ntona kpaa udza ogbɛ-abɔ se nu ma lu.<verse eid="ACT 17:9"/></para>
  <para style="s1">IPol bɛyi iSaila mi iBɛria</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 17:10"/>Mi otu na ama onoyɛyɛ kye iPol bɛyi iSaila dɛsɔ lu iBɛria. Ngwi a ka to imbe na nɛ, a kaka ozu okwakye mgbi emi iJuda. <verse eid="ACT 17:10"/><verse number="11" style="v" sid="ACT 17:11"/>Emi iBɛria dzɛ yi ali osuse ngha emi iTesalonika, lubana a gbɛ esɔ na yi atsa kpakpa dile kya mi Afɛ alegbe-alegbe ikye odi ni odzɛ ngwi iPol gbɔ na li otsitsi yɔ. <verse eid="ACT 17:11"/><verse number="12" style="v" sid="ACT 17:12"/>Emi iJuda ibyibyi noyɛyɛ, dafi ibyi engyaa imɔ emi iGriki bɛyi engyulɔ kpaa kyɔ nani.<verse eid="ACT 17:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 17:13"/>Nghaduu ngwi emi iJuda angbeka mi iTesalonika kwambɛ gbɛɛ iPol le gbɔ elodzɛ Imgbasho mi iBɛria nɛ, a lɔ kɛ imbe na ka teeye. <verse eid="ACT 17:13"/><verse number="14" style="v" sid="ACT 17:14"/>Nɛ ama onoyɛyɛ byakpa kye iPol dɛsɔ lu ondiiga, kpaa iSaila bɛyi iTimoti tila mi iBɛria. <verse eid="ACT 17:14"/><verse number="15" style="v" sid="ACT 17:15"/>Ama nwafɔ bɛyi iPol ntona tawon nghataa kɛ Atɛn, nɛ a si yidɔ lu iBɛria yi esɔ mbi iSaila bɛyi iTimoti gbɛɛ nu ma vla-vla ka tun.<verse eid="ACT 17:15"/></para>
  <para style="s1">IPol gbeesɔ mi Atɛn</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 17:16"/>Ngwi iPol kale dzɛgiyi ma mi Atɛn nɛ, eka kwowina lon kpakpa mi ikye angwula ama ngbiimbe mi ifu ogalu nani. <verse eid="ACT 17:16"/><verse number="17" style="v" sid="ACT 17:17"/>Nghanɛ o li kponya yi emi iJuda bɛyi emi iGriki ama omio Imgbasho mi ozu okwakye mgbi emi iJuda, bɛyi inggisɛ ama ngwu o tu ma mi ifyidu kpaa alegbe-alegbe. <verse eid="ACT 17:17"/><verse number="18" style="v" sid="ACT 17:18"/>IPol kaka angwɛ ota-ta yi obyi etsetse angbeka ngwu a li kwu ma gbɛɛ Epikuria yi iStɔki a li inggisɛ ama otsɛwodzɛ kpakpa. Angbeka mi ele byita gbɛɛ, &lt;&lt;Li ali odzɛ ngwi inggisɛ ntso gbɛɛ ongwu ye ngha duu nɛ le mina ogbɔ?&gt;&gt; Angbeka gbɛɛ, &lt;&lt;Dzɛ dafi o le gbɔdzɛ Imgbasho ongwi anengye mani.&gt;&gt; A gbɔdzɛ nɛ ngha ikyekyɛ iPol le gbɔ Esɔ Osuse mi odzɛ mgbi iYesu bɛyi okyɛɛ-kyɛɛ mgban mi ikwu. <verse eid="ACT 17:18"/><verse number="19" style="v" sid="ACT 17:19"/>Nɛ a kyon kɛ okwakye mgbi Ariopagu, mmana ma a byun gbɛɛ, &lt;&lt;Ni eyi ye li ali otsootso ofufɛ ngwi abu le tso kyɛ dɛn? <verse eid="ACT 17:19"/><verse number="20" style="v" sid="ACT 17:20"/>Abu le kye odzɛ angbeka ama nfyi eyi mfye ofwoofwo kpakpa ba, nghanɛ eyi mina oye itan.&gt;&gt; <verse eid="ACT 17:20"/><verse number="21" style="v" sid="ACT 17:21"/>(Emi Atɛn yi ingyoga mgbi ama ngwu lato yi ama duu, li kye onɔ okyɔ nkonyonyi wuba, kpaa a li le gbɔdzɛ di gadɔ mi odzɛ ama ofufɛ.)<verse eid="ACT 17:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 17:22"/>Nɛta iPol kyato dzɛkiyayi okwakye mgbi emi Ariopago si gbɛɛ: &lt;&lt;Ema emi Atɛn! N difwi gbɛɛ ema li sunu Imgbasho angbeka saan mi ali itɔ ofɛ duu. <verse eid="ACT 17:22"/><verse number="23" style="v" sid="ACT 17:23"/>Ikyena n kyikyɛ wodi agwɔ mgbi ema, n di ungwɔ ama ngwi ema le sunu ma mani, n di iwashi oka a lɔ ungwɔ mi efu gbɛɛ; <char style="sc">Ikyenghanɛ ungwɔ ngwi ema tole sunun dafi Imgbasho ngwu a yen ba na,</char> n ka gbɔdzan nya ema.<verse eid="ACT 17:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 17:24"/>&lt;&lt;Imgbasho nɛ li ongwu ta ɛsɛ bɛyi alungwɔ ama nto efu duu na, li Otsɛ mgbi esho yi esɛ, o li yama la ozu ngwi a mbɛ mi abɔ ba. <verse eid="ACT 17:24"/><verse number="25" style="v" sid="ACT 17:25"/>O mina unkonyi mi abɔ mgbi inggisɛ owamyɛ ba, ikyekyɛ i won yi unka ba, lubana li ongwu abuon li nu ali inggisɛ oshishe yi mmyɛ bɛyi ungwɔ angbeka duu aali. <verse eid="ACT 17:25"/><verse number="26" style="v" sid="ACT 17:26"/>Ikpewo inggisɛ onyi Imgbasho ta inggisɛ ama nto ɛsɛ tsatsadu, ikyegbɛɛ ɛsɛ duu no li mgbi ama; li ongwu di kye onɔ dzɛ ali inggisɛ duu bɛyi imbe ngwi a ka dzɛ yɛyɛ mani. <verse eid="ACT 17:26"/><verse number="27" style="v" sid="ACT 17:27"/>Imgbasho kyungwɔnɛ ngha ikye ni inggisɛ ye ongwu, pita ongwu di tu ongwu, nghaduu o dzɛ mbotunto yi eyi ba. <verse eid="ACT 17:27"/><verse number="28" style="v" sid="ACT 17:28"/>&lt;Lubana li mbon ngwi eyi dzɛ oshishe di li kyikyɛ kyɛ di dzɛ mi odzɛɛdzɛ mgbi eyi.&gt; Dafi ama olɔ ungwɔ mgbi abu angbeka gbɔ mani gbɛɛ, &lt;Eyi li etɔ mgban.&gt;<verse eid="ACT 17:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 17:29"/>&lt;&lt;Nghanɛ dafi eyi li etɔ mgbi Imgbasho nɛ, ni eyi ka tsɛwɛ gbɛɛ odzɛɛdzɛ mgban dzɛ dafi abashi naadi iyudza onzundzɛ okwɔkwɔ hona ikwutsɛ naadi ungwɔ okpaakpa ngwi inggisɛ kpa mi ozoyeye mgban ba. <verse eid="ACT 17:29"/><verse number="30" style="v" sid="ACT 17:30"/>Tugbe ma Imgbasho kye adɔ onghaangha itɔ nɛ wuuta ba, kpaa onɛnɛ yɔ o woola gbɛɛ ni ali inggisɛ mi ali imbe duu kyatitukwu mi ofɛ obube mgbi ama. <verse eid="ACT 17:30"/><verse number="31" style="v" sid="ACT 17:31"/>Lubana o kye egbe dzɛ ngwi o ka wa fwo ɛsɛ duu ikwɔ mi otsitsi mi abɔ mgbi iYesu ngwu o tsekise dulu nani. Imgbasho tsekise tso obwɛndɛ nɛ mbi ali inggisɛ duu mi okyile iYesu mi ikwu.&gt;&gt;<verse eid="ACT 17:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 17:32"/>Onɔ ngwi a fwo iPol gbɔdzɛ mgbi okyɛɛ-kyɛɛ mi ikwu nɛ, angbeka shan isha, kpaa angbeka gbɛɛ, &lt;&lt;I mina eyi odi fwo abu mi itɔdzɛ nɛ onoka.&gt;&gt; <verse eid="ACT 17:32"/><verse number="33" style="v" sid="ACT 17:33"/>Ngwi a gbɔdzɛ nɛ mata, iPol si lu dzata okwakye. <verse eid="ACT 17:33"/><verse number="34" style="v" sid="ACT 17:34"/>Nghaduu inggisɛ angbeka gbela kyɛdɔ iPol di yɛɛ ama onoyɛyɛ. Onyi mi idzidzɛ mgbi ama li iDiɔnasu, inggisɛ mi okwakye mgbi Ariopago, bɛyi iwata ngwu iyin di iDamari bɛyi angbeka kwuba.<verse eid="ACT 17:34"/></para>
  <chapter eid="ACT 17"/>
  <chapter number="18" style="c" sid="ACT 18"/>
  <para style="s1">IPol kɛ iKorinti</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 18:1"/>Ngwi ungwɔnɛ nyɛ nɛ, iPol dzita Atɛn lu iKorinti. <verse eid="ACT 18:1"/><verse number="2" style="v" sid="ACT 18:2"/>Li mmana ngwi o tu inggisɛ iJuda ngwu a li kwu iyin di Akwila, o li inggisɛ mi iPontu, o kwa kyɛ mi Itali yi owan iPrisila onɔ kɛ waba, ikyekyɛ utɔ iKladiɔsu woola gbɛɛ emi iJuda duu nu ma dzita iRoma. Nɛ iPol si kɛ oka di ma, <verse eid="ACT 18:2"/><verse number="3" style="v" sid="ACT 18:3"/>ma ikyegbɛɛ ongwu kpaa li inggisɛ otuo opo dafi ama kpaa li tuo nɛ, o tila dzɛ le kyidɔ yi ama. <verse eid="ACT 18:3"/><verse number="4" style="v" sid="ACT 18:4"/>Alegbe otonyewo duu o li ka kaka ozu okwakye mgbi emi iJuda, le fya ikye ni ongwu kyata emi iJuda bɛyi emi iGriki itukwu.<verse eid="ACT 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 18:5"/>Onɔ ngwi iSaila bɛyi iTimoti yidɔ mi iMasidonia nɛ, iPol kyelu onɔ mgban duu nu mi esɔ ogbɔɔgbɔ di kyɔ obwɛndɛ mbi emi iJuda gbɛɛ, &lt;&lt;IYesu li iMedzaya mani. <verse eid="ACT 18:5"/><verse number="6" style="v" sid="ACT 18:6"/>Kpaa ngwi emi iJuda gbela yi iPol wuba yidɔ le fyan ito nɛ, o gbo angwuto mgban otso ma gbɛɛ di a le tangwɛ Imgbasho di nya ma gbɛɛ, &lt;&lt;Eyi mgbi ema no dikye ema! Ani yɔ, ani kyidɔ mgbi ani saan. Wita onɛnɛ lu iyayi n le lu ka gbeesɔ nya Udzengye.&gt;&gt;<verse eid="ACT 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 18:7"/>Nɛ iPol si dzita ozu okwakye mgbi emi iJuda lu udɛ nwatse dɔn mani, udɛ iTaitusu iJɔstusu ongwu nli Udzengye li sunu Imgbasho nani. <verse eid="ACT 18:7"/><verse number="8" style="v" sid="ACT 18:8"/>IKrispu, ongyukwo mi ozu okwakye mgbi emi iJuda, bɛyi etɔ mgban olɔlɔ duu noyɛyɛ mbi Otsɛ iYesu; bɛyi emi iKorinti gwuba ama nfwo iPol noyɛyɛ a di kyɔ ma iBatisima. <verse eid="ACT 18:8"/><verse number="9" style="v" sid="ACT 18:9"/>Otu oka ma, Otsɛ iYesu gbɔdzɛ yi iPol mi inɛ odiidi gbɛɛ, &lt;&lt;Ka yama wo imio ba; kiyayi ogbɔɔgbɔ, dika tukwondu ba. <verse eid="ACT 18:9"/><verse number="10" style="v" sid="ACT 18:10"/>Ikyesinɛ n dzɛ bɛyi abu, ma inggisɛ onyonyi ka yama dzɛ abu wo di kyɔ abu ibli ba, ikyekyɛ ani to yi inggisɛ kwuba mi ogalu nɛni.&gt;&gt; <verse eid="ACT 18:10"/><verse number="11" style="v" sid="ACT 18:11"/>Nghanɛ iPol la imbe na onova onyi yi ofyia egyin le tso ma elodzɛ Imgbasho.<verse eid="ACT 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 18:12"/>Nghaduu onɔ ngwi iGalio gye iGɔna mgbi Akaya ma, emi iJuda dzɛ iPol wo bwan kyon lu opiikwɔ. <verse eid="ACT 18:12"/><verse number="13" style="v" sid="ACT 18:13"/>A gbɛɛ, &lt;&lt;Ongyulɔ nɛ, le fya okyata inggisɛ nu ma sunu Imgbasho mi ofɛ ngwi ola mgbi eyi gbela ba.&gt;&gt;<verse eid="ACT 18:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 18:14"/>Ngwi iPol kwa wewo ogbɔdzɛ nɛ, iGalio nya emi iJuda gbɛɛ, &lt;&lt;Ni ema emi iJuda kile kwondukwɔ mi ungwɔ obube hona alobube ntimbi kpakpa yɔ, n kika yagba kyungwɔ mi efu. <verse eid="ACT 18:14"/><verse number="15" style="v" sid="ACT 18:15"/>Kpaa ngwi i yɛɛ angwodzɛ mi ikye odzɛ ogbɔɔgbɔ yi iyi, bɛyi ola mgbi ema nɛ, yile odzɛ mgbi ema mɛ abuema na. N ka yama wo abɔ mi itɔ ntona ba.&gt;&gt; <verse eid="ACT 18:15"/><verse number="16" style="v" sid="ACT 18:16"/>Nɛman o lɔ ma onya tasɛ mi ozu ikwɔ. <verse eid="ACT 18:16"/><verse number="17" style="v" sid="ACT 18:17"/>Ta ama duu kpakli iSɔstɛnɛ nkye ozu okwakye mgbi emi iJuda teyi mani di gbon mi iyayi opiikwɔ. Nghaduu iGalio gbinɛ ngwuta i kakan ewo ba.<verse eid="ACT 18:17"/></para>
  <para style="s1">IPol yidɔ lu Antiɔku mi iSiria</para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 18:18"/>IPol la iKorinti egbe ibyibyi. Ta o dzita ama onoyɛyɛ, kye ikye dɔ onyɛ ongwi eni lu iSiria. O wafɔ yi iPrisila yi oban Akwila. Duuse non lu yɔ, o nyɛ wulɔ otu mi iSɛnkria, ikye ombwo ondu odzɛɛdzɛ ngwi o dzɛ mani. <verse eid="ACT 18:18"/><verse number="19" style="v" sid="ACT 18:19"/>A ka kaka Efesu, man iPol dzita iPrisila bɛyi Akwila. Ongwu abɔn kaka ozu okwakye mgbi emi iJuda ka kponya yi ama. <verse eid="ACT 18:19"/><verse number="20" style="v" sid="ACT 18:20"/>Ngwi a nyan gbɛɛ no la yi ama kpakpa nɛ, o fwa. <verse eid="ACT 18:20"/><verse number="21" style="v" sid="ACT 18:21"/>Ngwi o ka lu nɛ, o zondu gbɛɛ, &lt;&lt;N ka yidɔ ba mbi ema, ni li oweka mgbi Imgbasho yɔ.&gt;&gt; Nɛta o si kaka uwaa lu dzata Efesu. <verse eid="ACT 18:21"/><verse number="22" style="v" sid="ACT 18:22"/>Ngwi o kaka iSisiria nɛ, o ka ta emi iKrestu angba di nyɛ lu Antiɔku.<verse eid="ACT 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 18:23"/>Dafi o la Antiɔku kye egbe gwee nɛ, iPol kyato mi imbe na dzagaba kɛ imbe idzidza-dzidza kpatsɛ ayɛsɛ iGalatia bɛyi iFrijia, le kwu ama onoyɛyɛ ɛwɛ wo.<verse eid="ACT 18:23"/></para>
  <para style="s1">Apolo wita idɔ mgban</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 18:24"/>Nghanɛ inggisɛ iJuda ngwu iyin di Apolo, ngwu a mban mi ogalu Alekdzandra ba Efesu. O li ongyulɔ ngwu kpayi afɛ, di dzɛ yi ozoyeye mgbi Ibyibyilo saan. <verse eid="ACT 18:24"/><verse number="25" style="v" sid="ACT 18:25"/>A tson Ofɛ mgbi Otsɛ, ngwi o le fu mi onodzi nɛ, o gbɔdzɛ di tso odzɛ mgbi iYesu mi itukwu onyi, nghaduu o ye odzɛ iBatisima mgbi iJɔn kyoon ta. <verse eid="ACT 18:25"/><verse number="26" style="v" sid="ACT 18:26"/>O si wita odzɛ ogbɔɔgbɔ yi abɔ otsigɛgɛ mi ozu okwakye mgbi emi iJuda. Ngwi iPrisila bɛyi Akwila fwon nɛ, a kyon lu udɛ ama ka nun osa mi Ofɛ mgbi Otsɛ saan.<verse eid="ACT 18:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 18:27"/>Onɔ ngwi i wa wo Apolo okɛ Akaya nɛ, ama onoyɛyɛ fyonmfye itukwu, di lɔ afɛ mbi ama okyɛdɔ mi imbe na gbɛɛ nu ma gban abɔ efa. Okakaakaka mgban ma, o dzɛ yi abɔ oyaaya mbi ama Imgbasho nu ma noyɛyɛ mi elela mgban mani. <verse eid="ACT 18:27"/><verse number="28" style="v" sid="ACT 18:28"/>Ikyena o tangwodzɛ yi emi iJuda kpɔklɔɔ di ngha ma mi ododa, tso ma ambɛ mi Afɛ saan gbɛɛ iYesu li iMedzaya.<verse eid="ACT 18:28"/></para>
  <chapter eid="ACT 18"/>
  <chapter number="19" style="c" sid="ACT 19"/>
  <para style="s1">Agaba mgbi iPol ongwu ta</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 19:1"/>Ngwi Apolo ka dzɛ iKorinti nɛ, iPol nyɛ ongwi afɛɛsɛ wa kaka Efesu. Mmanana o tu ama onoyɛyɛ angbeka <verse eid="ACT 19:1"/><verse number="2" style="v" sid="ACT 19:2"/>di byi ma gbɛɛ, &lt;&lt;Ema gbɛ Onodzi Osaan onɔ ngwi ema noyɛyɛ ma wɛ?&gt;&gt;</para>
  <para style="p" vid="ACT 19:2">A gbɛɛ, &lt;&lt;Ei, eyi fwo kpaa gbɛɛ Onodzi Osaan dzɛ ma ba.&gt;&gt;<verse eid="ACT 19:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 19:3"/>Nɛ iPol byi ma gbɛɛ, &lt;&lt;Nghama li ali itɔ iBatisima ngwi a kyɔ ema?&gt;&gt;</para>
  <para style="p" vid="ACT 19:3">A nu uka gbɛɛ, &lt;&lt;IBatisima mgbi iJɔn.&gt;&gt;<verse eid="ACT 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 19:4"/>IPol si gbɔgbɛɛ, &lt;&lt;IBatisima mgbi iJɔn li iBatisima itukwu okyata-kyata. IJɔn nya inggisɛ ntona gbɛɛ nu ma noyɛyɛ mbi ongwu nka wa ba mi iyikpa ongwu mani, li iYesu waali.&gt;&gt; <verse eid="ACT 19:4"/><verse number="5" style="v" sid="ACT 19:5"/>Ngwi a fwo odzɛ nɛ nɛ, a kyɔ ma iBatisima mi iyi mgbi Otsɛ iYesu. <verse eid="ACT 19:5"/><verse number="6" style="v" sid="ACT 19:6"/>Dafi iPol kye abɔ dɔ ma ikye nɛ, Onodzi Osaan kaka mboma, a si gbɔ ondudzɛ angbeka di yegbɔ. <verse eid="ACT 19:6"/><verse number="7" style="v" sid="ACT 19:7"/>Mmbwo mgbi ama duu mɛ iwyodefa.<verse eid="ACT 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 19:8"/>IPol kaka ozu okwakye mgbi emi iJuda di gbɔdzɛ yi ama mi ododa nghataa ofyia eta, le tangwodzɛ di biibɛ yi ama mi ikye odzɛ esutɔ mgbi Imgbasho. <verse eid="ACT 19:8"/><verse number="9" style="v" sid="ACT 19:9"/>Nghaduu angbeka mi ifu ma fyumfye ikye di fwa onoyɛyɛ, di kwu Ofɛ mgbi Otsɛ fyito mi ododa. Nɛ iPol dzita ma di kyi gbelu ama onoyɛyɛ ntona wafɔ biyan lu kale tso ma alegbe mi ozu otsuungwɔ mgbi iTiranu. <verse eid="ACT 19:9"/><verse number="10" style="v" sid="ACT 19:10"/>Ungwɔnɛ kiyayi mɛ onova efa, nghataa emi iJuda bɛyi emi iGriki ama nto ayɛsɛ mgbi Asia duu fwo elodzɛ mgbi Otsɛ.<verse eid="ACT 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 19:11"/>Imgbasho nyɛ ikpewo iPol kyungwɔ ama okwulewo, <verse eid="ACT 19:11"/><verse number="12" style="v" sid="ACT 19:12"/>Nghanɛ gbaka ayangwuto ofwɔ inɛ bɛyi ishisha angwuto ngwi a kye gbo iPol ewo kpaa, ni a kye kɛ ni emi ootse kye abɔ gbo efu ootse mgbi ama li ngyɛ onodzi ibwubwe kpaa li tɔ dzamata.<verse eid="ACT 19:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 19:13"/>Emi iJuda angbeka ama ntole gaaga tsili kyɛ le lɔ onodzi ibwubwe onya, a fya okwu mi iyi mgbi Otsɛ iYesu mi ikye ama ngwu esɛ dɔ ma ikye gbɛɛ ni esɛ tɔ lu. A le gbɔgbɛɛ, &lt;&lt;Mi iyi iYesu, ongwu iPol li le gbeesɔ mgban na, tasɛ lu na.&gt;&gt; <verse eid="ACT 19:13"/><verse number="14" style="v" sid="ACT 19:14"/>Emi ongwɛ iSkeva, ongyukwo inggisɛ ofifɛ mgbi emi iJuda, nghi egyafa, tole kyungwɔnɛni. <verse eid="ACT 19:14"/><verse number="15" style="v" sid="ACT 19:15"/>Egbe oka nɛ onodzi ibwubwe nu ma uka gbɛɛ, &lt;&lt;iYesu ani yen, iPol kpaa ani ye odzan, nghama ema li ele?&gt;&gt; <verse eid="ACT 19:15"/><verse number="16" style="v" sid="ACT 19:16"/>Nghanɛ inggisɛ ndzɛ yi onodzi obube bulu gyɛ ma di ngha ma yi mfye. O sulu ma onikyibe, a si tsinya dzata udɛ mgban ibiba yi eyi mi ewo.<verse eid="ACT 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 19:17"/>Onɔ ngwi emi iJuda bɛyi emi iGriki nto Efesu wa ye ungwɔnɛ nɛ, imio wo ma, ta iyi mgbi Otsɛ iYesu si gye mmwɛ kpakpa. <verse eid="ACT 19:17"/><verse number="18" style="v" sid="ACT 19:18"/>Ibyi inggisɛ ama nnoyɛyɛ tɔ ba mi ododa wa fwi ali ibwubwe ngwi ama kyɔ mani. <verse eid="ACT 19:18"/><verse number="19" style="v" sid="ACT 19:19"/>Inggisɛ ibyibyi ama okyɔ obudei, gbe afɛ ofulu-fulu mgbi ama kwakye gbe toola mi inɛ ibyi inggisɛ. Ngwi a kyi gbɔlu mmya mgbi umbwo afɛ ntona nɛ, i mɛ iDracama idubu ngwusefa dɔn iwyo.<note caller="+" style="f"><char style="fr" closed="false">19:19 </char><char style="ft" closed="false">IDracama onyi li udza okpa idɔ mi egbe onyi</char></note> <verse eid="ACT 19:19"/><verse number="20" style="v" sid="ACT 19:20"/>Mi itɔ ofɛ nɛ elodzɛ mgbi Otsɛ gbɔfwɛ di nghao fyumfye.<verse eid="ACT 19:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 19:21"/>Ngwi ungwɔ ntonɛ duu kyɔ nyɛ nɛ, iPol wewo olu iJerosalin, o nyɛ ongwi iMasidonia bɛyi Acaya. O gbɛɛ, &lt;&lt;Ni ani ka kaka iJerosalin yɔ, n ka kɛ iRoma kpaa kyɛmɛ-kyɛmɛ.&gt;&gt; <verse eid="ACT 19:21"/><verse number="22" style="v" sid="ACT 19:22"/>O dɔ ama okyidɔ biyan nghi efa, iTimoti bɛyi Erastu, kɛ iMasidonia, ongwu yɔ tila dzɛ mi ayɛsɛ mgbi Asia ongwonɔ gwee se.<verse eid="ACT 19:22"/></para>
  <para style="s1">Onɔgbɛ tɔ mi Efesu</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 19:23"/>Mi itɔnɔ na onikyeeye gbokyɛɛ mi ikye Ofɛ mgbi Otsɛ iYesu. <verse eid="ACT 19:23"/><verse number="24" style="v" sid="ACT 19:24"/>Inggisɛ onda iyudza onzundzɛ okwɔkwɔ, iyin gbɛɛ iDemetriɔ, li ongwu mɛ ozoka Atemi, ungwɔnɛ li nu ma awuya ongyɛɛngyɛ ba, li mmya ongbungbɛ ba mbi ama onduufa. <verse eid="ACT 19:24"/><verse number="25" style="v" sid="ACT 19:25"/>O kwu ama onduufa kwakye, bɛyi ama ndzɛ mi itɔ ofɛ idɔ pita li ungwonyi mani, si gbɛɛ: &lt;&lt;Engyulɔ, ema ye li mi idabɔ nɛ ngwi eyi li tu aludu mgbi eyi. <verse eid="ACT 19:25"/><verse number="26" style="v" sid="ACT 19:26"/>Ema di diyɛ fwo, dafi iPol biibɛ yi ibyi inggisɛ mi Efesu mmɛnɛni wo ma ɛndɛ, sisi gwee ki li ayɛsɛ mgbi Asia duu. O gbɛɛ Imgbasho ama ngwu inggisɛ mɛ ma mɛɛmɛ mi abɔ ntonɛ duu, a yama li Imgbasho ba dududu. <verse eid="ACT 19:26"/><verse number="27" style="v" sid="ACT 19:27"/>Odzɛ obube dzɛ ana, yama li idabɔ mgbi eyi nɛta ngwi iyi mgban osuse ka byulu ba, kpaa ozoka mgbi imgbasho ongyaa oshewo Atemi kpaa ka yɛɛ ungwɔ onyadi, ongwu imgbasho ongyaa abɔn ngwu a li sunun kpatsɛ ayɛsɛ Asia yi ɛsɛ olɔlɔ duu na, a ka kye bulu ugabaidu mgban oshewo nani.&gt;&gt;<verse eid="ACT 19:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 19:28"/>Ngwi a fwo ungwɔnɛ nɛ, itukwu gyaabyi loma man a wita owulu gbɛɛ: &lt;&lt;Oshewo li Atemi mgbi emi Efesu!&gt;&gt; <verse eid="ACT 19:28"/><verse number="29" style="v" sid="ACT 19:29"/>Labɔlabɔ nɛta igeli yɛɛ onɔgbɛ-onɔgbɛ. Inggisɛ ntona kye bwalu iGayɔsu bɛyi Aristakɔ, ongwu li ongwɛ afokyɛɛ mgbi iPol kyɛ mi iMasidonia, a si wafɔ ondonyi dafi a li inggisɛ onyi mani kaka imbe okwakye okwukwo. <verse eid="ACT 19:29"/><verse number="30" style="v" sid="ACT 19:30"/>IPol mina okye ewon tɔ iyayi ibyi inggisɛ, kpaa ama okyɛdɔ gbelon ba. <verse eid="ACT 19:30"/><verse number="31" style="v" sid="ACT 19:31"/>Engyukwo emi idɔ angbeka mi ayɛsɛ na, ama nli oka iPol dɛsɔ tɛkyɛ nun gbɛɛ non ka yama lɛlɛ kye ewon kɛ imbe okwakye okwukwo na ba.<verse eid="ACT 19:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 19:32"/>Okwakye wɛndɛ. Angbeka tole wulu mi itɔdzɛ oka angbeka mi itɔdzɛ idzidza. Angbeka ye itɔdzɛ nkye ma kɛdzɛ imbe na ba. <verse eid="ACT 19:32"/><verse number="33" style="v" sid="ACT 19:33"/>Emi iJuda tsamu Alekidzanda dzɛkiyayi ibyi inggisɛ man angbeka mi ibyi inggisɛ tole nyan odzɛ ngwi o ka gbɔ mani. O si kyɔ ma abɔ gbɛɛ nu ma dzɛ shilididi ikye ni ongwu natsondu onagbɛ ewon, mi inai ma. <verse eid="ACT 19:33"/><verse number="34" style="v" sid="ACT 19:34"/>Ngwi a wa difwi gbɛɛ o li emi iJuda nɛ, ama duu wulu ondonyi mɛ dafi obyi efa hini gbɛɛ: &lt;&lt;Oshewo li Atemi mgbi emi Efesu!&gt;&gt;<verse eid="ACT 19:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 19:35"/>Ongye olɔɔlɔ mgbi ogalu okwukwo tukwu ma ondu, o nya ibyi inggisɛ gbɛɛ: &lt;&lt;Ema emi Efesu, li emɛ mi ɛsɛ ye gbɛɛ igeli mgbi Efesu li ogalu osunu angbodzi Imgbasho ongyaa Atemi ba di ye dafi onodzi mgban, nngwuta kyɛ esho ma dzɛ imbe nɛ ba? <verse eid="ACT 19:35"/><verse number="36" style="v" sid="ACT 19:36"/>Nghanɛ, dafi a ka tangwɛ otsitsi nɛ gbɛ ba nɛ, li ayin ni ema yile itukwu bɛsɛ di kyɔ unkonyi mi ikwangha ba. <verse eid="ACT 19:36"/><verse number="37" style="v" sid="ACT 19:37"/>Ema gbe engyulɔ ntonɛ ba mmɛnɛ, nghaduu a yama yi ozoka unkonyi hona kwu ashu mgbi eyi shanyɛ ba. <verse eid="ACT 19:37"/><verse number="38" style="v" sid="ACT 19:38"/>Nghanɛ, kini iDemetriɔ bɛyi ama okyidabɔ yan dzɛ yi okakewo yi inggisɛ yɔ, opiikwɔ lasisa, emi ola kpaa to. Nu ma ka kwelikwɔ mmanani. <verse eid="ACT 19:38"/><verse number="39" style="v" sid="ACT 19:39"/>Nghaduu ni odzɛ ka dzɛma ngwi ema mina okye ba yɔ, li kyɛmɛ ni a kye mɛlu mi okwakye ndzɛ mi ola mani. <verse eid="ACT 19:39"/><verse number="40" style="v" sid="ACT 19:40"/>Dafi i dzɛ nghanɛ, ungwɔ nkyɔ inɛ nɛ a ka yagba maayi bɛ eyi gbɛɛ di li eyi teeye. Eyi ka yagba tangwɛ mi ikye onɔgbɛ nɛ naadi nu itɔdzɛ nka mɛ ba.&gt;&gt; <verse eid="ACT 19:40"/><verse number="41" style="v" sid="ACT 19:41"/>Ngwi o gbɔdzɛ nɛ ngyɛ mata, o si nu okwakye ganya.<verse eid="ACT 19:41"/></para>
  <chapter eid="ACT 19"/>
  <chapter number="20" style="c" sid="ACT 20"/>
  <para style="s1">IPol nyɛ ongwi iMasidonia yi iGriki</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 20:1"/>Onɔ ngwi eye wa ngyɛ nɛ, iPol dɛsɔ mbi ama onoyɛyɛ, ngwi o fyuma mfye itukwu nɛ, o nya ma gbɛɛ se egbe oka man kye ofɛ dikye lu iMasidonia. <verse eid="ACT 20:1"/><verse number="2" style="v" sid="ACT 20:2"/>O si dzagaba nyɛ imbe nani, o nya ma elodzɛ kpakpa ofyuma mfye itukwu, mi olɛlɛ nɛ o ka kaka iGriki, <verse eid="ACT 20:2"/><verse number="3" style="v" sid="ACT 20:3"/>o la imbe na ofyia eta. Ikyekyɛ emi iJuda wibu okyɔn ungwɔ obube dafi o wewo okaka uwaa lu iSiria mani, nɛ o kyatitukwu yidɔ wikye ka nyɛ ongwi iMasidonia. <verse eid="ACT 20:3"/><verse number="4" style="v" sid="ACT 20:4"/>Ama ntawon li iSopata ongwɛ iPerusu ngwu kyɛ mi iBɛria, Aristakɔ bɛyi iSekundu yi iGayɔsu emi iTesalonika, mi iDebe, iTimoti kpaa, yi iTacikɔ bɛyi iTrofimu mi ayɛsɛ mgbi Asia. <verse eid="ACT 20:4"/><verse number="5" style="v" sid="ACT 20:5"/>Inggisɛ ntonɛ wikye lu ka dzɛ giyi eyi mi iTroa. <verse eid="ACT 20:5"/><verse number="6" style="v" sid="ACT 20:6"/>Nghaduu ngwi oga ibredi ongwi a kye okwuna wo efu ba wa nyɛ nɛ, eyi kaka uwaa mi iFyilipi kye egbe eda duuse kwa lu ka tu angbeka ntona mi iTroa, eyi la ele ikyidu olɔlɔ.<verse eid="ACT 20:6"/></para>
  <para style="s1">A kyile iYutuku mi ikwu mi iTroa</para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 20:7"/>Egbe ongwi ababɔ mi ikyidu<note caller="+" style="f"><char style="fr" closed="false">20:7 </char><char style="ft" closed="false">Egbe ongwi ababɔ mi ikyidu li egbe iladi mbi emi iJuda. Li egbe ngwi iYesu kyɛɛ mi ikwu man emi iKrestu kyata yɛɛ egbe osunu Imgbasho mani.</char></note> ma eyi kwakye ikye ogye oga. IPol gbɔdzɛ yi ama, ma ikyegbɛɛ o weka olu tegblifan nɛ, o kiyayi yi onya okpaaakpaa yi ama nghataa otu gheefa. <verse eid="ACT 20:7"/><verse number="8" style="v" sid="ACT 20:8"/>A gbe ola ipitila dɔto mi ifoozu ongwi esho imbe ngwi eyi kwakye mani. <verse eid="ACT 20:8"/><verse number="9" style="v" sid="ACT 20:9"/>Ongwongyulɔ mmafa ngwu a li kwun di iYutuku sɔdzɛ ofɛ awo le mwuna. Dafi iPol kale kiyayi yi odzɛ ogbɔɔgbɔ nɛ, una wa ngwɔn lu kpini, o si gbɛsɛ kyɛ esho wa zudɔwokɛ esɛ man a ka kyon ikwukwɔ tatso. <verse eid="ACT 20:9"/><verse number="10" style="v" sid="ACT 20:10"/>Nghaduu iPol tashulu luba esɛ, o tukwukɛ ikwɔ nani tsɛkwulun. O si nya ma gbɛɛ, &lt;&lt;Ka yama teeyi ba na, o dzɛ oshishe!&gt;&gt; <verse eid="ACT 20:10"/><verse number="11" style="v" sid="ACT 20:11"/>Ta o diyɛ tɔkɛ lu esho kye ghalu ibredi gye yi ama. Ngwi o gbɔdzɛ yi ama nghataa ni egbe fa nɛman, o si lu. <verse eid="ACT 20:11"/><verse number="12" style="v" sid="ACT 20:12"/>Inggisɛ ntona si kyi kyelu ongwongyulɔ mmafa nɛ lu udɛ oshishe itukwu di fyuma mfye kpakpa.<verse eid="ACT 20:12"/></para>
  <para style="s1">IPol nya engyukwo emi Efesu gbɛɛ <optbreak/> se egbe oka</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 20:13"/>IPol nya eyi gbɛɛ ni eyi nyɛ ongwi uwaa teyi ongwu lu Aso, ka kye ongwu mi imbe nani, ikyesinɛ o le lu imbe na mi afɛɛsɛ. <verse eid="ACT 20:13"/><verse number="14" style="v" sid="ACT 20:14"/>Ngwi o tu eyi mi Aso ma, eyi kyon wo uwaa lu iMitilene. <verse eid="ACT 20:14"/><verse number="15" style="v" sid="ACT 20:15"/>Tegblifan ma, eyi dzata imbe na dzɛkyo wa to kwɛkwɛ yi ibu iKio. Egbe oka nɛ eyi dzɛkyo dɔkɛ ibu iSamosi, di kaka iMiletu tegblifan. <verse eid="ACT 20:15"/><verse number="16" style="v" sid="ACT 20:16"/>IPol di wewo nu ma fan nyɛ ongwi eni lu dzata Efesu, ikye ombe onɔ mi ayɛsɛ mgbi Asia wuba, lubana i won okaka iJerosalin plɛ, duuse ni oga iPɛntikɔsu wa gyɔ. <verse eid="ACT 20:16"/><verse number="17" style="v" sid="ACT 20:17"/>Mi iMiletu ma, iPol dɛsɔ kɛ Efesu ikye engyukwo emi iKrestu gbɛɛ nu ma ba wa tu ongwu. <verse eid="ACT 20:17"/><verse number="18" style="v" sid="ACT 20:18"/>Ngwi a wa kaka nɛ, o gbɔ yi ama gbɛɛ: &lt;&lt;Ema ye odzɛɛdzɛ ngwi ani dzɛ mi onɔ ngwi ani dzɛ yi ema ma duu, wita mi egbe ongwi ababɔ ngwi ani ba ɛsɛ Asia mani. <verse eid="ACT 20:18"/><verse number="19" style="v" sid="ACT 20:19"/>N kyɔ Otsɛ idɔ mi ewo oyile esɛ bɛyi etse inɛ. N di shitukwu mi ali imbadi yi isɔ ngwi emi iJuda wibu ani mi ele duu. <verse eid="ACT 20:19"/><verse number="20" style="v" sid="ACT 20:20"/>Ema ye n yama yɛyikpa ogbɔ ungwɔ ndzɛ yi oyabɔ nya ema mi ododa ba, mi udɛ ema hona mbi ibyi inggisɛ kpaa. <verse eid="ACT 20:20"/><verse number="21" style="v" sid="ACT 20:21"/>Ani gbɔ nya emi iJuda bɛyi emi iGriki gbɛɛ li kyɛmɛ nu ma kyatitukwu luba mbi Imgbasho di dzɛ yi oyɛyɛ onuunu mbi Otsɛ mgbi eyi iYesu.<verse eid="ACT 20:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 20:22"/>&lt;&lt;Nghanɛ onɛnɛ, Onodzi Osaan si ani le lu iJerosalin, nghaduu n yama ye ungwɔ nka kiyayi yɛn mi imbe na ba. <verse eid="ACT 20:22"/><verse number="23" style="v" sid="ACT 20:23"/>Kpaa ungwɔ ngwi ani ye li onyi ta, ali ogalu ngwi ani kaka efu duu, Onodzi Osaan li le kwen adɔ gbɛɛ obawi bɛyi adzɛ ogyeegye dzɛ ani esɛ ma. <verse eid="ACT 20:23"/><verse number="24" style="v" sid="ACT 20:24"/>Nghaduukpaa n kye oshishe mgbɛn gbɛɛ li unkonyi ba, ni ani ki yagba ngyɛlu onya otse-tse bɛyi idɔ ngwi Otsɛ iYesu kye wo ani abɔ nɛ kpata idɔ okyɔ obwɛndɛ mi Esɔ Osuse mgbi elela mgbi Imgbasho nɛni.<verse eid="ACT 20:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 20:25"/>&lt;&lt;Onɛnɛ, n ye ta gbɛɛ inggisɛ onyonyi mi idzidzɛ ema ngwu ani gbeesɔ esutɔ mgbi Imgbasho nyan, ka yama di ani wuba. <verse eid="ACT 20:25"/><verse number="26" style="v" sid="ACT 20:26"/>Nghanɛ, n le nya ema mi ododa onɔngwunɛ gbɛɛ, n yama dzɛ yi obube mi odzili-dzili mgbi inggisɛ onyonyi ba. <verse eid="ACT 20:26"/><verse number="27" style="v" sid="ACT 20:27"/>Lubana ani fwijiwo onya ema oweka mgbi Imgbasho duu ba. <verse eid="ACT 20:27"/><verse number="28" style="v" sid="ACT 20:28"/>Gbɛwɛdzɛ ewema bɛyi ifyungwɔ ama Onodzi Osaan gbe wo ema abɔ gbɛɛ ni ema le di mboma mani. Li inggisɛ ama ongyo emi iKrestu mgbi Otsɛ<note caller="+" style="f"><char style="fr" closed="false">20:28 </char><char style="ft" closed="false">Otsɛ mmɛnɛ nɛ li Imgbasho mi olɔɔlɔ angbeka</char></note>, ngwu ongwu gyaagya yi eyi mgban ntonɛni. <verse eid="ACT 20:28"/><verse number="29" style="v" sid="ACT 20:29"/>Ani ye ta gbɛɛ ni ani wa dzita imbe nɛ yɔ, emi idukwlɛbɛ ibwubwe, ka ba idzidzɛ ema a ka yama dzita ifyungwɔ ba. <verse eid="ACT 20:29"/><verse number="30" style="v" sid="ACT 20:30"/>Mi idzidzɛ ema kpaa, angbeka ka tɔ nka kyata otsitsi, ikye otu ama okyɛdɔ ma. <verse eid="ACT 20:30"/><verse number="31" style="v" sid="ACT 20:31"/>Nghanɛ gbɛwɛbyi na! Wɛ na gbɛɛ mi onova eta n yama kwulɛsɛ okwo ali inggisɛ mgbi ema adɔ mi otu yi onɔ yi etse inɛ ba.<verse eid="ACT 20:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 20:32"/>Onɛnɛ n kye ema dɔ Imgbasho ubɔ yi esɔ mgbi elelan, nka nu ema she di nu ema okwudɛ mi idzidzɛ ama ngwu a kye ma kyi salu duu. <verse eid="ACT 20:32"/><verse number="33" style="v" sid="ACT 20:33"/>N yama mina iyudza onzundzɛ hona abashi naadi angwuto mgbi inggisɛ onyi ba. <verse eid="ACT 20:33"/><verse number="34" style="v" sid="ACT 20:34"/>Ema abuema duu ye gbɛɛ abɔ mgbi ani ntonɛ nu ani ungwɔ ngwi ani mina tsatsadu bɛyi imina mgbi ama okyɛ yi ani kpaa. <verse eid="ACT 20:34"/><verse number="35" style="v" sid="ACT 20:35"/>Alungwɔ ani kyɔ duu, ani tso ema dafi mi itɔ idɔ okwunewo nɛ eyi ka ya emi abubɔ yi emi ootse abɔ kyɛmɛ-kyɛmɛ, ole wɛ elodzɛ ama ngwi Otsɛ iYesu abuon gbɔ mani gbɛɛ: &lt;Mse dzɛ mi onuunu ngha ogbɛ-gbɛ.&gt; &gt;&gt;<verse eid="ACT 20:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 20:36"/>Ngwi iPol gbɔdzɛ nɛ ngyɛ nɛ, o si gbe akwafɔ kwɛsɛ yi ama duu bibɔ. <verse eid="ACT 20:36"/><verse number="37" style="v" sid="ACT 20:37"/>Nɛta ama duu si nyɛ yi ikwu otseetse, a tsɛkwulun di nyan gbɛɛ se egbe oka yi okpitukwu. <verse eid="ACT 20:37"/><verse number="38" style="v" sid="ACT 20:38"/>Ungwɔ nnghao nu eka kplɔkɔ lo ma yɔ, li elodzɛ ngwi o gbɛɛ a ka yama di ongwu wuba nani. Taman a si tawon ka kaka uwaa.<verse eid="ACT 20:38"/></para>
  <chapter eid="ACT 20"/>
  <chapter number="21" style="c" sid="ACT 21"/>
  <para style="s1">IPol kɛ iJerosalin</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 21:1"/>Ngwi o nya ma gbɛɛ se egbe oka duu nɛ, eyi si nyɛ ongwi eni byakpa lu iKosu yɛyɛ. Tegblifan ma eyi kɛ iRode di nyɛ lu iPatara. <verse eid="ACT 21:1"/><verse number="2" style="v" sid="ACT 21:2"/>Ngwi eyi tu uwaa ongwi nle lu iFonishia nɛ, eyi kaka si kyɛɛ okyɛɛ. <verse eid="ACT 21:2"/><verse number="3" style="v" sid="ACT 21:3"/>Dafi eyi di iSapru kɛ nɛ, eyi nyɛ ongwi atiisɛ mgban mi uwaa lu iSiria. Eyi ka bɛsɛ mi iTai, imbe ngwi iwudza mgbi eyi ka dulu okye mani. <verse eid="ACT 21:3"/><verse number="4" style="v" sid="ACT 21:4"/>Ka kpatsɛ yi ama onoyɛyɛ angbeka emi imbe nani, nɛ eyi la yi ama ikyidu onyi. Ama okyɛdɔ ntonɛ, mi ikpewo Onodzi Osaan yegbɔ gbɛɛ iPol no ka kɛ iJerosalin ba. <verse eid="ACT 21:4"/><verse number="5" style="v" sid="ACT 21:5"/>Nghaduu ngwi onɔ mgbi eyi wa ngyɛ nɛ, Eyi dzata imbe na wikye lu iyayi. Ama okyɛdɔ yi owama bɛyi ɛngbɛ duu tawo eyi tasɛ mi ifyigeli, nɛman eyi kwɛsɛ bibɔ mi ondiiga. <verse eid="ACT 21:5"/><verse number="6" style="v" sid="ACT 21:6"/>Ngwi eyi kyɔ eka se egbe oka ngyɛ nɛ, eyi kaka iwudza, man ama si yidɔ lu udɛ.<verse eid="ACT 21:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 21:7"/>Eyi kiyayi yi agaba mgbi eyi mi iTai ka bɛsɛ mi iPitolemai, imbe na eyi tangba yi ama onoyɛyɛ di dzɛ yi ama egbe onyi. <verse eid="ACT 21:7"/><verse number="8" style="v" sid="ACT 21:8"/>Tegblifan nɛ, eyi dzita ma wa kaka iSisiria di dzɛ udɛ iFyilipi inggisɛ ogbeesɔ, o li onyi mbi inggisɛ egyafa ngwu a dulu ma gbɛɛ nu ma gha ungwogye mi iJerosalin mani. <verse eid="ACT 21:8"/><verse number="9" style="v" sid="ACT 21:9"/>O dzɛ yi engwengyaa nghi enɛ ama nbongyulɔ waba li yegbɔ.<verse eid="ACT 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 21:10"/>Ngwi eyi la imbe na egbe ibyibyi nɛ, oyegbɔ oka ngwu a li kwun di Agabu kyɛ iJudia ba. <verse eid="ACT 21:10"/><verse number="11" style="v" sid="ACT 21:11"/>Ngwi o nyɛ ba mbi eyi nɛ, o kyi kyelu okpa obwa oshi mgbi iPol, kye bwa ewon afɔ bɛyi abɔ duu si gbɛɛ, &lt;&lt;Onodzi Osaan gbɔgbɛɛ, &lt;Li itɔ ofɛ nɛ emi iJuda ama nto iJerosalin ka bwa otsungwɔ okpa nɛ adi kyon wo Udzengye abɔ aali.&gt; &gt;&gt;<verse eid="ACT 21:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 21:12"/>Ngwi eyi fwo ungwɔnɛ nɛ, eyi bɛyi inggisɛ ama nto mmanana tɛkyɛ yi iPol gbɛɛ no ka kɛ iJerosalin ba. <verse eid="ACT 21:12"/><verse number="13" style="v" sid="ACT 21:13"/>Nghaduu iPol gbɛɛ, &lt;&lt;Kyɔnɛ ngwi ema le tsukwu dile gbua ani eka? Ani wewo ikye adi obwa-bwa ta ba, kpaa odi kwulu mi iJerosalin ikye iyi mgbi Otsɛ iYesu.&gt;&gt; <verse eid="ACT 21:13"/><verse number="14" style="v" sid="ACT 21:14"/>Dafi i yɛɛ gbɛɛ eyi ka kyɔkyɔ yan gbɛ ba nɛ, eyi si dzɛ abɔ ta nyan gbɛɛ, &lt;&lt;Ni oweka mgbi Imgbasho kyɔ.&gt;&gt;<verse eid="ACT 21:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 21:15"/>Ngwi egbe ntonɛ wa nyɛ nɛ, eyi kyi gbelu okye mgbi eyi si lu iJerosalin. <verse eid="ACT 21:15"/><verse number="16" style="v" sid="ACT 21:16"/>Ama okyɛdɔ angbeka mi iSisiria wafɔ yi eyi di kye eyi ba udɛ Mnasɔn, imbe ngwi i wo gbɛɛ eyi ka dzɛ mani. Ongwu nose li ongyulɔ nkyɛ mi iSapru di li onyi mbi ama okyɛdɔ emi ababɔ ntonani.<verse eid="ACT 21:16"/></para>
  <para style="s1">Okakaakaka mgbi iPol mi iJerosalin</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 21:17"/>Ngwi eyi kaka iJerosalin nɛ, ama onoyɛyɛ gbɛ eyi abɔ efa. <verse eid="ACT 21:17"/><verse number="18" style="v" sid="ACT 21:18"/>Tegblifan nɛ iPol bɛyi eyi angbeka duu kɛ oka di iJɛnsi, engyukwo emi iKrestu mi iJerosalin duu kpaa todzɛ ele. <verse eid="ACT 21:18"/><verse number="19" style="v" sid="ACT 21:19"/>IPol kye angba kwulu ma di kyatse odzɛ nya ma klɛklɛ ungwɔ ngwi Imgbasho kyɔ yi Udzengye mi ikpewo idɔ ngwi ongwu kyɔ mani.<verse eid="ACT 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 21:20"/>Ngwi a fwo ungwɔnɛ mata, a si tsɛ Imgbasho. Ta a nya iPol gbɛɛ: &lt;&lt;Anɔ, o di dafi umbwo inggisɛ idubu ibyibyi mi iJuda kyatitukwu, di dzɛ yi itukwu olola ongyo Ola mgbi iMose mani. <verse eid="ACT 21:20"/><verse number="21" style="v" sid="ACT 21:21"/>A nya ma gbɛɛ abu le tso emi iJuda ama nto idzidzɛ Udzengye gbɛɛ nu ma kyata dzita Ola iMose, le nya ma gbɛɛ nu ma ka kyɛ engwɛ ma ikyɛ ba hona kyɔ aletɔ mgbi eyi ba. <verse eid="ACT 21:21"/><verse number="22" style="v" sid="ACT 21:22"/>Li kyɛmɛ ngwi a ka fwo gbɛɛ abu badzɛ, nghanɛ li ekyɛ i ka kyɔ? <verse eid="ACT 21:22"/><verse number="23" style="v" sid="ACT 21:23"/>Ngyɛse kyungwɔ ngwi eyi nya abu mani. Engyulɔ enɛ to mmɛnɛ yi eyi ama nzondu yi Imgbasho. <verse eid="ACT 21:23"/><verse number="24" style="v" sid="ACT 21:24"/>Wafɔ yi ama, ni ema wewo lu mi ewo ofwɔ-fwɔ mgbi ama mani di kpa mi ungwɔ ngwi a kyɔ duu, adzi ni a kpalu ma otu. Ta ali inggisɛ ka ye gbɛɛ otsitsi dzɛ mi odzɛ ngwi a le gbɔ ikpewo abu nɛ ba, kpa i tso gbɛɛ abu abuabu gbela yi ola mgbi iMose. <verse eid="ACT 21:24"/><verse number="25" style="v" sid="ACT 21:25"/>Nghaduu mbi Udzengye ama onoyɛyɛ yɔ, eyi teyi lɔ oweka mgbi eyi kɛ mboma gbɛɛ nu ma dzɛ enggengga mi ungwogye ngwi a kye fifɛ nu angwula, yi eyi, yi mmbwɛ ngwi a ngwɔ mfyumfye bɛyi amah idza.&gt;&gt;<verse eid="ACT 21:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 21:26"/>Tegblifan nɛ, iPol kye Engyulɔ ntonɛ ka fwɔ ewo yi ama. Nɛ o si kɛ ozu okwukwo osunu Imgbasho mi iJerosalin oka nu ma ye egbe ngwi ewo ofwɔ-fwɔ nɛ ka dondu ngwi a dika nu umba ikye ali inggisɛ mgbi ama mani.<verse eid="ACT 21:26"/></para>
  <para style="s1">A bwa iPol</para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 21:27"/>Ngwi egbe egyafa ntona wa dzɛ kwɛkwɛ ongyɛɛngyɛ nɛ, emi iJuda angbeka mi ayɛsɛ mgbi Asia di iPol mi ozu okwukwo osunu Imgbasho mi iJerosalin. A si kyile etasɛ angbi man a bwan, <verse eid="ACT 21:27"/><verse number="28" style="v" sid="ACT 21:28"/>le teela gbɛɛ, &lt;&lt;Emi Israi, ya eyi abɔ na! Nɛnɛ li ongyulɔ nle tsungwɔ nli ayin ba kpatsɛ mi ikpewo eyi yi ola mgbi eyi bɛyi imbe nɛ mani. Ungwɔ oka nbɛ efu yɔ, o gbe emi iGriki kaka ifyudɛ ozu okwukwo osunu Imgbasho mi iJerosalin di kwo idza kaka imbe Osaan nɛni.&gt;&gt; <verse eid="ACT 21:28"/><verse number="29" style="v" sid="ACT 21:29"/>(Lubana a tsekise di iTrofimu inggisɛ emi Efesu yi iPol mi ogalu, a si kyi kyelu mi itukwu mgbi ama gbɛɛ iPol kyon kaka ifyudɛ ozu okwukwo osunu Imgbasho mi iJerosalin.)<verse eid="ACT 21:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 21:30"/>Ogalu na duu gbokyɛɛ, inggisɛ kyɛ onyonya mi ali agya duu. Ngwi a kpakli iPol nɛ, a kwon tɔ mi ozu okwukwo osunu Imgbasho mi iJerosalin, labɔlabɔ nɛta a gbe onufɛ gyɛtukwu. <verse eid="ACT 21:30"/><verse number="31" style="v" sid="ACT 21:31"/>Ngwi a le fya ongwɔn nɛ, akwɔ mgbi odzɛ nɛ kaka mbi agyegika mgbi oblakwutsɛ mgbi emi iRoma gbɛɛ ogalu iJerosalin duu yɛɛ kwutukwutu. <verse eid="ACT 21:31"/><verse number="32" style="v" sid="ACT 21:32"/>Akponyi man agyegika na gbe engyukwo oblakwutsɛ angbeka bɛyi ɛngbɛ oblakwutsɛ si tsinya lukwu ibyi inggisɛ. Onɔ ngwi emi ablodzɛ ntona dili agyegika bɛyi eblakwutsɛ mgban nɛ, a nya ogbo iPol ibe.<verse eid="ACT 21:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 21:33"/>Ta agyegika na ba wa bwa iPol di woola gbɛɛ nu ma bwan adi yi ashi efa. Nɛ o si byun itɔ inggisɛ ngwu o dzɛ bɛyi ungwɔ ngwi o kyɔ mani. <verse eid="ACT 21:33"/><verse number="34" style="v" sid="ACT 21:34"/>Mi idzidzɛ ibyi inggisɛ ntona angbeka tole gbɔ itɔdzɛ idzidza mi ela okwukwo, angbeka di li itɔdzɛ idzidza, ngwi i fyumfye gbɛɛ agyegika na no difwi otsitsi odzɛ mi ikye onɔgbɛ nɛ, o si woola nu ma kye iPol lu ogalu oblakwutsɛ. <verse eid="ACT 21:34"/><verse number="35" style="v" sid="ACT 21:35"/>Dafi iPol wa to afɔ otɔkɛ ozu nɛ, ablodzɛ mgbi ibyi inggisɛ ntona she nyɛsɛ i yɛɛ gbɛɛ oblakwutsɛ ntona ka kyon kye-kye. <verse eid="ACT 21:35"/><verse number="36" style="v" sid="ACT 21:36"/>Ibyi inggisɛ ama nkyɛ ma iyikpa ma tole wulu gbɛɛ, &lt;&lt;Ngyɛlu yan na!&gt;&gt;<verse eid="ACT 21:36"/></para>
  <para style="s1">IPol gbɔdzɛ yi ijiji inggisɛ</para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 21:37"/>Dafi ama oblakwutsɛ wewo okye iPol lu ogalu mgbi ama nɛ, o si byi agyegika gbɛɛ, &lt;&lt;Nin gbɔdzɛ yɔɔ lɔ?&gt;&gt;</para>
  <para style="p" vid="ACT 21:37">Agyegika na byun gbɛɛ, &lt;&lt;O li gbɔ iGriki wɛ? <verse eid="ACT 21:37"/><verse number="38" style="v" sid="ACT 21:38"/>Abu li inggisɛ Igyibiti ngwu wita eye di gbe ama ongwɔ inggisɛ idubu enɛ lu imbe okplagada onoka nose ma wɛ?&gt;&gt;<verse eid="ACT 21:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 21:39"/>IPol si nu uka gbɛɛ, &lt;&lt;Ani li emi iJuda, n kyɛ mi iTasu mi ogalu iSilisia, ogalu ingblimɔ. Tsuutsu nin gbɔdzɛ yi inggisɛ ntonɛni.&gt;&gt;<verse eid="ACT 21:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 21:40"/>Ngwi o gbɛ ofɛ mbi agyegika nɛ, iPol kwudzɛkɛ afɔ otɔkɛ ozu di kyɔ ibyi inggisɛ ntona abɔ. Ngwi a dede nɛ, o gbɔ yi ama mi ondu Aramai gbɛɛ:<verse eid="ACT 21:40"/></para>
  <chapter eid="ACT 21"/>
  <chapter number="22" style="c" sid="ACT 22"/>
  <para style="p">
    <verse number="1" style="v" sid="ACT 22:1"/>&lt;&lt;Emi ongwunani bɛyi emi otsani, gadɔ dafi ani ka natsondu ewen onɛnɛ nɛni.&gt;&gt; <verse eid="ACT 22:1"/><verse number="2" style="v" sid="ACT 22:2"/>Onɔ ngwi a fwon le gbɔdzɛ yi ama mi ondu Aramai nɛ, a si zumyɛ.</para>
  <para style="p" vid="ACT 22:2">Nɛta iPol gbɛɛ: <verse eid="ACT 22:2"/><verse number="3" style="v" sid="ACT 22:3"/>&lt;&lt;Ani li inggisɛ iJuda, a mba ani mi iTasu mi iSilisia, kpaa ani she mi igeli nɛni. Mi abɔ mgbi iGamalie a nyɛ ani klɛklɛ mi ola mgbi emi otseyi, n di fyumfye itukwu mbi Imgbasho yɛyɛ dafi ema kpaa dzɛ inɛ nɛni. <verse eid="ACT 22:3"/><verse number="4" style="v" sid="ACT 22:4"/>Ani nu ama okyɛdɔ Ofɛ nɛ isɔ nghataa kaka ikwongye mgbi ama, di bwa engyaa yi engyulɔ gbe ma wo obawi. <verse eid="ACT 22:4"/><verse number="5" style="v" sid="ACT 22:5"/>Okwukwo inggisɛ ofifɛ bɛyi engyukwo okwakye duu kpaa ka kyɔ obwɛndɛ. A di nu ani afɛ kɛ mbi emi ongwunɔma ama nto iDamasiko, ikye oka bwa ma dafi emi obawi mani, gbe ma ba iJerosalin wa kwo ma adɔ.<verse eid="ACT 22:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 22:6"/>&lt;&lt;Mi onɔ idzidzɛ udɛ ngwi ani dzɛ kwɛkwɛ okaka iDamasiko nɛta, osa tɔkyɛ esho wa dzaniwo akponyi. <verse eid="ACT 22:6"/><verse number="7" style="v" sid="ACT 22:7"/>Man ani gyɛkɛ esɛ si fwo ela le gbɔ yi ani gbɛɛ, &lt;ISol! iSol! Kyɔsinɛ ngwi abu le nu ani isɔ?&gt;<verse eid="ACT 22:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 22:8"/>Ani byun gbɛɛ, &lt;&lt; &lt;Li abu emɛ Otsɛ?</para>
  <para style="p" vid="ACT 22:8">O nya ani gbɛɛ, &lt;&lt; &lt;Ani li iYesu ongwi iNadzareti, ngwu abu le nun isɔ mani. <verse eid="ACT 22:8"/><verse number="9" style="v" sid="ACT 22:9"/>Ama nkyɛ yi ani di osa nani, kpaa a fwo ela mgbi ongwu nle gbɔdzɛ yi ani ma ba.<verse eid="ACT 22:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 22:10"/>Ani byun gbɛɛ, &lt;&lt; &lt;Li alungwɔ ngwi ani ka kyɔ?&gt;</para>
  <para style="p" vid="ACT 22:10">Otsɛ nya ani gbɛɛ, &lt;&lt; &lt;Kyato; lu iDamasiko. Mi imbe na a ka nya abu alungwɔ ngwi a kye dzɛ gbɛɛ abu ka kyɔ duu.&gt; <verse eid="ACT 22:10"/><verse number="11" style="v" sid="ACT 22:11"/>Ama nkyɛ yi ani ma byi ani abɔ kaka iDamasiko, ikyesinɛ osa na bulu ani inɛ.<verse eid="ACT 22:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 22:12"/>&lt;&lt;Ongyulɔ iyin gbɛɛ Anania ba owa di ani. O li ngyo ola saan di dzɛ yi mmwɛ mbi emi iJuda ama nto imbe na duu. <verse eid="ACT 22:12"/><verse number="13" style="v" sid="ACT 22:13"/>O kwulɛsɛ dzɛ ani kɛ agya si nya ani gbɛɛ, &lt;&lt;Ongwunani iSol, inɛ mgbi abu no kwulu!&gt;&gt; Mi onɔ na yɛyɛ ta ani yagba dun.<verse eid="ACT 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 22:14"/>&lt;&lt;O si nya ani gbɛɛ, &lt;Imgbasho mgbi emi otseyi dulu abu gbɛɛ ni abu ye oweka mgban di di Ongwu Nle Nyaan na diyɛ fwo odzɛ mi ondun. <verse eid="ACT 22:14"/><verse number="15" style="v" sid="ACT 22:15"/>Abu ka li obwɛndɛ mgban mbi inggisɛ duu mi ungwɔ ngwi abu di diyɛ fwo nɛni. <verse eid="ACT 22:15"/><verse number="16" style="v" sid="ACT 22:16"/>Ma li ekyɛ ngwi abu le fɛ onɛnɛ? Kyato, kwu mi iyi mgban nu ma kyɔ abu iBatisima di salu ali ibwubwe mgbi abu ngwuta.&gt;<verse eid="ACT 22:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 22:17"/>&lt;&lt;Ngwi ani yɛ luba iJerosalin dile bibɔ mi ozu okwukwo osunu Imgbasho nɛ, ani di inɛ odiidi <verse eid="ACT 22:17"/><verse number="18" style="v" sid="ACT 22:18"/>di di Otsɛ iYesu le gbɔdzɛ yi ani gbɛɛ, &lt;Lu dzata iJerosalin Plɛ, ikyesinɛ a ka gbela obwɛndɛ mgbi abu onuunu ikye ani ba.&gt;<verse eid="ACT 22:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 22:19"/>Nghaduu ani gbɛɛ, &lt;&lt; &lt;Otsɛ, inggisɛ ntonɛ ye ani dafi ani kyikyɛ mi ozu okwakye mgbi emi iJuda kpatsɛ, ikye ogbe ama nnoyɛyɛ mi iyi mgbi abu wo obawi di gbo ma ibe mani. <verse eid="ACT 22:19"/><verse number="20" style="v" sid="ACT 22:20"/>Onɔ ngwi a tsɛngwɔ iStivin ikyegbɛɛ o le kyɔ obwɛndɛ mi iyi mgbi abu ma, ani kwudzɛ ele di gbela yi ongwɔɔngwɔ mgban di ngyo angwuto mgbi ama nle ngwɔn mani.&gt;<verse eid="ACT 22:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 22:21"/>&lt;&lt;Ta Otsɛ iYesu si nya ani gbɛɛ, &lt;Lu, ani ka dɔ abu esɔ lu kpini mbi Udzengye.&gt; &gt;&gt;<verse eid="ACT 22:21"/></para>
  <para style="s1">IPol inggisɛ iRoma</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 22:22"/>Ibyi inggisɛ gadɔ mbi iPol nghataa o gbɔdzɛ nɛ ngyɛ. Man a kyile ela ondonyi gbɛɛ, &lt;&lt;Ngwɔn na, o mɛ odzɛ oshishe ba!&gt;&gt;<verse eid="ACT 22:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 22:23"/>Dafi a le wulu di fwadulu angwuto mgbi ama ngwuta dile tombulu kɛ esho nɛ, <verse eid="ACT 22:23"/><verse number="24" style="v" sid="ACT 22:24"/>agyegika nu ondu nu ma kye iPol kaka ogalu oblakwutsɛ. O nu ondu gbɛɛ nu ma gbon di byun ita, nu ma ye ungwɔ nkyɔ duuse ibyi inggisɛ tole fan ela ngha mani. <verse eid="ACT 22:24"/><verse number="25" style="v" sid="ACT 22:25"/>Dafi a nan lasɛ ogbon nɛ, iPol byi ongyukwo oblakwutsɛ nkwudzɛ mmana ma gbɛɛ, &lt;&lt;Li ola ni abu gbo inggisɛ iRoma ngwu a gbɔn ikwɔ di tun yi obube ba kpaa ibee?&gt;&gt;<verse eid="ACT 22:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 22:26"/>Ngwi ongyukwo na fwo ngha nɛ, o kɛ mbi okwukwo ogbakwu na ka kye tson gbɛɛ, &lt;&lt;Li ekyɛ abu le kyɔ? Inggisɛ nɛ li inggisɛ iRoma.&gt;&gt;<verse eid="ACT 22:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 22:27"/>Okwukwo ogbakwu na kɛ mbi iPol ka byun gbɛɛ, &lt;&lt;Nya ani n di abu li inggisɛ iRomaa?&gt;&gt;</para>
  <para style="pi" vid="ACT 22:27">O gbɛɛ, &lt;&lt;Ɛɛn, ani li inggisɛ iRoma.<verse eid="ACT 22:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 22:28"/>Nɛ okwukwo ogbakwu na gbɛɛ, &lt;&lt;Ani kpa udza she ikye oyɛɛ inggisɛ iRoma.&gt;&gt;</para>
  <para style="pi" vid="ACT 22:28">IPol nyan gbɛɛ, &lt;&lt;Nghaduu ani yɔ ani li imba mgbi iRoma.&gt;&gt;<verse eid="ACT 22:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 22:29"/>Ama nwewo obyin ita ma byakpa yɛyikpa. Okwukwo ogbakwu na abuon ewo waa lon onɔ ngwi o difwi gbɛɛ iPol li inggisɛ iRoma kpaa ongwu tan itse mani.<verse eid="ACT 22:29"/></para>
  <para style="s1">IPol kɛdzɛ inɛ okwakye mgbi <optbreak/> emi iJuda</para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 22:30"/>Tegblifan, ngwi i mina agyegika na oye itɔdzɛ yɛyɛ ngwi emi iJuda gbe odzɛ tukwu iPol ewo nɛ, o shan adi ta di nu ondu ni engyukwo ama ofifɛ bɛyi okwakye mgbi engyukwo duu kwakye. Ta o si kye iPol ba non dzɛkunto mi iyayi ma.<verse eid="ACT 22:30"/></para>
  <chapter eid="ACT 22"/>
  <chapter number="23" style="c" sid="ACT 23"/>
  <para style="p">
    <verse number="1" style="v" sid="ACT 23:1"/>IPol kye inɛ byi okwakye mgbi engyukwo emi iJuda yɛyɛ si gbɛɛ, &lt;&lt;Emi engwunani, ani kyidɔ mgbi ani mbi Imgbasho mi itukwu asisa nghataa ba inɛ.&gt;&gt; <verse eid="ACT 23:1"/><verse number="2" style="v" sid="ACT 23:2"/>Mi odzɛ nɛ okwukwo inggisɛ ofifɛ Anania nu ama nkwulɛsɛ to kwɛkwɛ yi iPol ondu gbɛɛ nu ma gbobun ondu. <verse eid="ACT 23:2"/><verse number="3" style="v" sid="ACT 23:3"/>Nɛ iPol nya Anania gbɛɛ, &lt;&lt;Imgbasho ka ta abu afɛ, abu inggisɛ ikpala nɛni! Abu sɔ mmana le gbɔ ani ikwɔ mi odzɛɛdzɛ mgbi Ola, nghaduu abu abuabu foola mi onu ondu gbɛɛ nu ma ta ani afɛ!&gt;&gt;<verse eid="ACT 23:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 23:4"/>Ama nkwudzɛ yi iPol ntona byun gbɛɛ, &lt;&lt;Abu shitukwu le fya okwukwo inggisɛ ofifɛ mgbi Imgbasho itoo?&gt;&gt;<verse eid="ACT 23:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 23:5"/>IPol gbɛɛ, &lt;&lt;Engwunani, ani yama ye gbɛɛ o li okwukwo inggisɛ ofifɛ ba, lubana a lɔ gbɛɛ, &lt;Ka gbɔdzɛ obube ikpewo inggisɛ ogbe emidabu teyi ba.&gt; &gt;&gt;<verse eid="ACT 23:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 23:6"/>Ngwi iPol ye gbɛɛ angbeka li emi iSadusi angbeka di li emi iFarasi nɛ, o makwɔ yi okwakye mgbi engyukwo ntona gbɛɛ, &lt;&lt;Emi ongwunani, ani li inggisɛ iFarasi, di li ongwɛ inggisɛ iFarasi. A le gbɔ ani ikwɔ ikyegbɛɛ ani kye eka byi okyɛɛ-kyɛɛ mi ikwongye.&gt;&gt; <verse eid="ACT 23:6"/><verse number="7" style="v" sid="ACT 23:7"/>Onɔ ngwi o gbɔdzɛ nɛ ngha nɛ, odzɛ oshiishi tɔ mi idzidzɛ mgbi emi iFarasi bɛyi emi iSadusi, man okwakye na gheefa. <verse eid="ACT 23:7"/><verse number="8" style="v" sid="ACT 23:8"/>(Emi iSadusi noyɛyɛ gbɛɛ okyɛɛ-kyɛɛ mi ikwu, bɛyi engyesɔ naadi emi onodzi dzɛma ba, kpaa emi iFarasi noyɛyɛ mi ungwɔ ntonɛ duu.)<verse eid="ACT 23:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 23:9"/>Odzɛ oshiishi yɛɛ okwukwo nɛman etsetse mgbi ola angbeka ama nli emi iFarasi tokɛ unto di tangwɛ kpɔklɔɔ gbɛɛ, &lt;&lt;Eyi tu unkonyi obube mbi inggisɛ nɛ ba,&gt;&gt; A byi ma gbɛɛ, &lt;&lt;Ni li onodzi hona ongyesɔ gbɔdzɛ yan ma yɛ?&gt;&gt; <verse eid="ACT 23:9"/><verse number="10" style="v" sid="ACT 23:10"/>Odzɛ oshiishi na yɛɛ eye man okwukwo ogbakwu na mio gbɛɛ a ka kyi fwalu iPol ambulu-ambulu. O woola gbɛɛ oblakwutsɛ nu ma ka kyen kyi gbɛlu mi abɔ mfye yilen luba ogalu oblakwutsɛ.<verse eid="ACT 23:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 23:11"/>Mi otu ongwi egbe na Otsɛ wa dzɛkɛ yi iPol nyan gbɛɛ, &lt;&lt;Fyumfye itukwu! Dafi abu gbɔdzɛ mgbi ani mi iJerosalin na, li ngha ngwi abu dika gbɔ kyɛmɛ mi igeli iRoma aali.&gt;&gt;<verse eid="ACT 23:11"/></para>
  <para style="s1">A wibu ongwɔ iPol</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 23:12"/>Mi egbegbe nɛ emi iJuda kwakye di bwalu ondu mi ofaafa gbɛɛ ama ka gye hona wa ungwɔ ba sede ama ngwɔlu iPol. <verse eid="ACT 23:12"/><verse number="13" style="v" sid="ACT 23:13"/>Inggisɛ ngha ngwusefa ama nwodzɛ mi ondu obwa-bwa nɛni. <verse eid="ACT 23:13"/><verse number="14" style="v" sid="ACT 23:14"/>A kɛ mbi engyukwo ama ofifɛ bɛyi engyukwo emi iJuda ka nya ma gbɛɛ, &lt;&lt;Eyi bwa mi ofaafa kpɔklɔɔ gbɛɛ eyi ka gye unkonyi ba sede eyi ngwɔlu iPol. <verse eid="ACT 23:14"/><verse number="15" style="v" sid="ACT 23:15"/>Nghawanɛ, ema yi okwakye mgbi engyukwo emi iJuda dɛsɔ mbi okwukwo ogbakwu mi ikpala no kyen ba mbi ema gbɛɛ, i mina ema ofwo itɔdzɛ saan mi odzɛ mgban. Eyi wewo ogbongwɔn duuse no wa to mmɛnɛni.&gt;&gt; <verse eid="ACT 23:15"/><verse number="16" style="v" sid="ACT 23:16"/>Kpaa ngwi ongwɛ ongwunɔ iPol fwo ngha nɛ, o lu ogalu oblakwutsɛ ka nya iPol. <verse eid="ACT 23:16"/><verse number="17" style="v" sid="ACT 23:17"/>Ta iPol kwu ongyukwo oblakwutsɛ ntona onyi ela nyan gbɛɛ, &lt;&lt;Kye ongwummafa nɛ kɛ mbi okwukwo ogbakwu, o dzɛ yi odzimɔ onyan.&gt;&gt; <verse eid="ACT 23:17"/><verse number="18" style="v" sid="ACT 23:18"/>Nghanɛ o kyon kɛ mbi okwukwo ogbakwu nani. O nyan gbɛɛ, &lt;&lt;IPol inggisɛ mi obawi na dɛsɔ mbi ani nya ani gbɛɛ ni ani kye mmafa nɛ ba mbi abu ikyekyɛ o dzɛ yi odzimɔ onya abu.&gt;&gt;<verse eid="ACT 23:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 23:19"/>Okwukwo ogbakwu na byi ongwongyulɔ mmafa na abɔ, kwon lu enggengga si byun gbɛɛ, &lt;&lt;Li ali odzɛ ngwi abu dzɛyan onya ani?&gt;&gt;<verse eid="ACT 23:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 23:20"/>O nyan gbɛɛ, &lt;&lt;Emi iJuda bwondu onya abu ni abu kye iPol ba okwakye mgbi engyukwo emi iJuda ekeka mi ɛwɛ gbɛɛ ama mina oye itɔdzɛ yɛyɛ mi odzɛ mgban. <verse eid="ACT 23:20"/><verse number="21" style="v" sid="ACT 23:21"/>Ka gbela yi ma ba, ikyesinɛ inggisɛ ngha ngwusefa da to oshɛ le fan. A fa gbɛɛ ama ka gye hona wa ungwɔ ba sede ama ngwɔ iPol. A wewo ngyɛ onɛnɛ le fɛ ogbela-gbela mgbi abu mi oweka mgbi ama.&gt;&gt;<verse eid="ACT 23:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 23:22"/>Okwukwo ogbakwu na wo ongyulɔ mmafa na ofɛ di kwon adɔ gbɛɛ, &lt;&lt;Ka nya inggisɛ onyi kpaa gbɛɛ di abu nya ani odzɛ nɛ loo.&gt;&gt;<verse eid="ACT 23:22"/></para>
  <para style="s1">A nyinɛ iPol lu iSidzaria</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 23:23"/>Ta o kwu engyukwo mgbi ama oblakwutsɛ efa ela si nu ma ondu gbɛɛ, &lt;&lt;Gbe oblakwutsɛ ideli efa yi ama otɔ mmya ngwuseta dɔn iwyo bɛyi emi ashɔ ideli efa nu ma wewo okɛ iSisiria mi obyi egyanɛ mi otu inɛ. <verse eid="ACT 23:23"/><verse number="24" style="v" sid="ACT 23:24"/>Di wewo yi mmya angbeka nka kye iPol kɛ mbi iGɔna iFelisi saan mani.&gt;&gt;<verse eid="ACT 23:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 23:25"/>O lɔ afɛ sini:<verse eid="ACT 23:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 23:26"/>IKladiɔsu iLisia, Ugabaidu, iGɔna iFelisi:</para>
  <para style="p" vid="ACT 23:26">N ta abu angba.<verse eid="ACT 23:26"/></para>
  <para style="pi">
    <verse number="27" style="v" sid="ACT 23:27"/>Inggisɛ nɛ emi iJuda bwan di wewo ongwɔn, kpaa ani ba yi ibyi oblakwutsɛ wa nagban, ikyekyɛ ani fwo gbɛɛ o li imba mgbi iRoma. <verse eid="ACT 23:27"/><verse number="28" style="v" sid="ACT 23:28"/>Ani mina oye ungwɔ ngwi a le gbe odzɛ tukwun ewo mani, nghanɛ ani kyon ba mbi okwakye mgbi engyukwo emi iJuda. <verse eid="ACT 23:28"/><verse number="29" style="v" sid="ACT 23:29"/>Man ani wa difwi gbɛɛ a le gbe odzɛ tukwun ewo mi ikye ola mgbi ama, nghaduu itɔdzɛ onyi ngwi a nu ngwi mɛ ongwɔn hona kyen wo obawi dzɛma ba. <verse eid="ACT 23:29"/><verse number="30" style="v" sid="ACT 23:30"/>Onɔ ngwi a nya ani ungwɔ ngwi a kye weka okyɔ yi inggisɛ nɛ mata, ani kyon dɛsɔ lu mbi abu akponyi. Ani di nu ondu gbɛɛ ama ngbe odzɛ tukwun ewo ntona nu ma gbɔ itɔdzɛ mgbi ama ma nya abu.<verse eid="ACT 23:30"/></para>
  <para style="m">
    <verse number="31" style="v" sid="ACT 23:31"/>Nghanɛ oblakwutsɛ ntona kyidɔ ngwi a nu ma ondu mani, a kye iPol wafɔ yi ama kyon lu byulu kaka Antipatri mi otu nani. <verse eid="ACT 23:31"/><verse number="32" style="v" sid="ACT 23:32"/>Tegblifan ma emi mmya tawon lu kpaa emi afɛɛsɛ yɔ yidɔ luba ogalu mgbi oblakwutsɛ. <verse eid="ACT 23:32"/><verse number="33" style="v" sid="ACT 23:33"/>Ngwi emi mmya ntona ka kaka iSisiria nɛ, a kye afɛ ma nu iGɔna di kye iPol kpaa won abɔ. <verse eid="ACT 23:33"/><verse number="34" style="v" sid="ACT 23:34"/>IGɔna gbɔ afɛ na si byita ayɛsɛ ngwi o kyɛ ele mani. Ngwi o difwi gbɛɛ o kyɛ mi iSilisia nɛ, <verse eid="ACT 23:34"/><verse number="35" style="v" sid="ACT 23:35"/>o gbɛɛ, &lt;&lt;Ani ka fwo odzɛ mgbi abu mi onɔ ngwi ama ngbe odzɛ tukwu abu ewo kaka mmɛnɛ mani.&gt;&gt; Ta o wo ma ola gbɛɛ nu ma kye iPol lu udɛ utɔ iHerude ka ngyon.<verse eid="ACT 23:35"/></para>
  <chapter eid="ACT 23"/>
  <chapter number="24" style="c" sid="ACT 24"/>
  <para style="s1">A fwo iPol ikwɔ mi inai iFelisi</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 24:1"/>Ngwi i kye egbe eda nɛ okwukwo inggisɛ ofifɛ Anania ba wa kaka iSidzaria yi engyukwo angbeka bɛyi inggisɛ oye ola iyin di iTetulɔ, a si gbe itɔdzɛ ngwi a le gbe odzɛ tukwu iPol ewo mi ele ma to iGɔna esɛ. <verse eid="ACT 24:1"/><verse number="2" style="v" sid="ACT 24:2"/>Ngwi a kwu iPol ela kaka ifun nɛ, iTetulɔ kye itɔdzɛ mgbi elikwɔ mgban tso iFelisi gbɛɛ, &lt;&lt;Eyi to mi iyu mi abɔ abu onɔ she, inɛ mgbi abu odiidi na di ba yi okiyayi mi ɛsɛ nɛni. <verse eid="ACT 24:2"/><verse number="3" style="v" sid="ACT 24:3"/>Ugabaidu iFelisi, mi ali imbe yi ali ofɛ duu, eyi gbela ungwɔnɛ di gbede nu abu kwuba. <verse eid="ACT 24:3"/><verse number="4" style="v" sid="ACT 24:4"/>Nghaduu ombe abu onɔ bayɔ, n le bɔ gbɛɛ o ki shitukwu diyɛ fwo eyi gwee.<verse eid="ACT 24:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 24:5"/>&lt;&lt;Eyi difwi gbɛɛ inggisɛ nɛ li inggisɛ oteeye, o li tu ola eye wo mi idzidzɛ mgbi emi iJuda mi ɛsɛ duu. O li inggisɛ ogbe emi iNadzareti teyi mi eye <verse eid="ACT 24:5"/><verse number="6" style="v" sid="ACT 24:6"/>o di fya okye ayiwi kaka ozu okwukwo osunu Imgbasho mi iJerosalin; nghanɛ eyi kpaklin. [Di mina ogbɔn ikwɔ mi ola mgbi eyi. <verse eid="ACT 24:6"/><verse number="7" style="v" sid="ACT 24:7"/>Kpaa agyegika iLisia ba mfyumfye wa kyon kyi lafwa mbi eyi, <verse eid="ACT 24:7"/><verse number="8" style="v" sid="ACT 24:8"/>kwu ama nkwun elikwɔ ntonɛ ela nu ma ba]<note caller="+" style="f"><char style="fr" closed="false">24:8 </char><char style="ft" closed="false">Ambulu nɛ dzɛ mi olɔɔlɔ angbeka ba.</char></note>, ni abu byi ma ita abuabu ta abu ka yagba otu otsitsi mi odzɛ ngwi eyi gbe le tukwun ewo ntonɛni.&gt;&gt;<verse eid="ACT 24:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 24:9"/>Emi iJuda ntona gbela wo odzɛ ngwi a gbe tukwun ewo ntonani, dile tso gbɛɛ odzɛ ntonɛ li otsitsi.<verse eid="ACT 24:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 24:10"/>Ngwi iGɔna kyɔ iPol abɔ gbɛɛ no gbɔdzɛ nɛ, o si wita ogbɔdzɛ gbɛɛ: &lt;&lt;Ani ye i kye onova ibyibyi ngwi abu li inggisɛ ogbiikwɔ mi ɛsɛ nɛni; nghanɛ n dzɛ yi atsa onatsondu ewen. <verse eid="ACT 24:10"/><verse number="11" style="v" sid="ACT 24:11"/>O ka yagba byi inggisɛ angbeka fwo i ngha egbe iwyodefa waba ngwi ani kɛ iJerosalin oka sunu. <verse eid="ACT 24:11"/><verse number="12" style="v" sid="ACT 24:12"/>Ama ogbe odzɛ tukwu ani ewo ntonɛ yama din le tangwodzɛ yi inggisɛ onyi mi ozu okwukwo osunu Imgbasho hona tu inggisɛ wo mi ozu okwakye mgbi emi iJuda naadi mbeka onyonyi mi ogalu ba. <verse eid="ACT 24:12"/><verse number="13" style="v" sid="ACT 24:13"/>A dika yagba nu osa mi odzɛ onyi ngwi a gbe le tukwu ani ewo nɛ ba. <verse eid="ACT 24:13"/><verse number="14" style="v" sid="ACT 24:14"/>Nghaduu, ani gbela dafi engyukwo mgbi ama tsɛwɛ gbɛɛ ofɛ mgbi Otsɛ ngwi ani le kyɛdɔ na li ayin ba mani. Kpaa ani kale sunu Imgbasho ngwi emi otsikyani sunu mani. Ani di noyɛyɛ mi alungwɔ ngwi a lɔ mi ola mgbi iMose bɛyi afɛ mgbi ama ogbɛɛsɛ duu <verse eid="ACT 24:14"/><verse number="15" style="v" sid="ACT 24:15"/>ani di dzɛ yi ɛwɛ ogbe byiibyi mbi Imgbasho ungwonyi dafi inggisɛ ntonɛni, gbɛɛ emi osaan bɛyi emi imbali duu ka kyɛɛ mi ikwu. <verse eid="ACT 24:15"/><verse number="16" style="v" sid="ACT 24:16"/>Nghanɛ ani li fya alonɔ ni itukwu mgbi ani dzɛ saan mi inɛ Imgbasho bɛyi inggisɛ.<verse eid="ACT 24:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 24:17"/>&lt;&lt;Ngwi ani wa dzɛma ba onova ibyibyi nɛ, n ba iJerosalin ikye okye umba wa nu emidɛn emi adzɛ di fifɛ nu Imgbasho. <verse eid="ACT 24:17"/><verse number="18" style="v" sid="ACT 24:18"/>Ani fwɔlu ewani yɛɛ saan mi onɔ ngwi a tu ani mi ifyudɛ ozu okwukwo osunu Imgbasho le kyungwɔnɛ mani. Ibyi inggisɛ to yi ani hona ani ndeye yi inggisɛ oka ba. <verse eid="ACT 24:18"/><verse number="19" style="v" sid="ACT 24:19"/>Nghaduu emi iJuda angbeka to ayɛsɛ mgbi Asia, ngwi i gbuo a ki to mmɛnɛ mi inai abu nu ma sulu obwɛndɛ obube ikpewo ani yɔ a ki kyɔ. <verse eid="ACT 24:19"/><verse number="20" style="v" sid="ACT 24:20"/>Hona ama nto mmɛnɛnɛ nu ma gbɔ ungwɔ obube ngwu ma tu mbi ani mi onɔ ngwi ani kwudzɛ mi inai okwakye mgbi engyukwo emi iJuda mani. <verse eid="ACT 24:20"/><verse number="21" style="v" sid="ACT 24:21"/>Li mi ikye ungwɔ onyi ngwi ani kyile ela esho onɔ ngwi ani kwudzɛ inai ma na ta: &lt;Li itɔdzɛ mgbi okyɛɛ mi ikwu ngwi abu le gbɔ ani ikwɔ inɛ aani.&gt; &gt;&gt; <verse eid="ACT 24:21"/><verse number="22" style="v" sid="ACT 24:22"/>Nghanɛ iFelisi n ye odzɛ Ofɛ mgbi Otsɛ saan nɛ, tsamu egbe ikwɔ lu iyayi. O gbɛɛ, &lt;&lt;Ni iLisia okwukwo ogbakwu wa ba ta n ka ngyɛlu ikwɔ mgbi abu nɛni.&gt;&gt; <verse eid="ACT 24:22"/><verse number="23" style="v" sid="ACT 24:23"/>O wo ongyukwo oblakwutsɛ ola gbɛɛ no nu ma ngyo iPol kpaa nu ma ka kyon tukwu ba di nu emi okan ofɛ nu ma tobyun mi imina mgban. <verse eid="ACT 24:23"/><verse number="24" style="v" sid="ACT 24:24"/>Ngwi egbe nyɛ gwee nɛ, iFelisi yi owan iDrusila, nli ongyaa emi iJuda na waba. O dɛsɔ nu ma kye iPol ba wa fwon dafi o le gbɔdzɛ oyɛyɛ onuunu mbi iYesu iKrestu mani. <verse eid="ACT 24:24"/><verse number="25" style="v" sid="ACT 24:25"/>Dafi iPol le tsuutsa mgbi odzɛ saan, yi obwa ewo fyii bɛyi ikwɔ ogbɔɔgbɔ nkyɛ iyayi nɛ, imio wo iFelisi man o gbɛɛ, &lt;&lt;I gyɔ ngha tsatso! O ka yagba lu. Nin wa tu onɔ ta, n ka dɛsɔ mbi abu.&gt;&gt; <verse eid="ACT 24:25"/><verse number="26" style="v" sid="ACT 24:26"/>Mi itɔnɔ na, iFelisi tsɛwɛ gbɛɛ iPol ka kye akwatsa wo ongwu ondu, nghanɛ o tonya odɛsɔ mbon ba.<verse eid="ACT 24:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 24:27"/>Ngwi i nyɛ onova efa nɛ, iPoshiɔ iFɛstusu dɔkɛ utɔ gbikye iFelisi, kpaa ikyegbɛɛ i mina iFelisi okyumse yi emi iJuda nɛ, o dzata iPol mi obawi.<verse eid="ACT 24:27"/></para>
  <chapter eid="ACT 24"/>
  <chapter number="25" style="c" sid="ACT 25"/>
  <para style="s1">IFɛstusu gbɔ iPol ikwɔ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 25:1"/>Ngwi iFɛstusu gyuutɔ kye egbe eta nɛ, o dzata iSisiria lu iJerosalin, <verse eid="ACT 25:1"/><verse number="2" style="v" sid="ACT 25:2"/>imbe na engyukwo ama ofifɛ bɛyi engyukwo emi iJuda ba mbon wa gbe itɔdzɛ obube mgbi iPol tonkɛ esɛ. <verse eid="ACT 25:2"/><verse number="3" style="v" sid="ACT 25:3"/>A si byakpa mina abɔ oyaaya mbi iFɛstusu gbɛɛ, no tobyi ama kye nyinɛ iPol luba iJerosalin maama, ali ma a le wewo owa kwo ofɛ ngwɔn. <verse eid="ACT 25:3"/><verse number="4" style="v" sid="ACT 25:4"/>IFɛstusu nu uka gbɛɛ, &lt;&lt;A kye iPol dzɛkɛ iSisiria, ma ani abuen kpaa n le kɛ ele dzikan-dzikan. <verse eid="ACT 25:4"/><verse number="5" style="v" sid="ACT 25:5"/>Yeba non kyɔ obube yɔ, ni ama ogbe ema teyi angbeka wafɔ yi ani ka gbɔ obube ngwi o kyɔ ma, mi imbe nani.<verse eid="ACT 25:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 25:6"/>Ngwi iFɛstusu kye egbe egyata naadi iwyo yi ama nɛ, o si lu iSisiria, tegblifan nɛ o kwu ela gbɛɛ nu ma kwakye mi opiikwɔ di noola gbɛɛ nu ma kye iPol ba mbi ongwu. <verse eid="ACT 25:6"/><verse number="7" style="v" sid="ACT 25:7"/>Ngwi iPol wa to nɛ, emi iJuda ama nkyɛ mi iJerosalin ba ma loka won, gbe odzɛ okwulewo ama nli otsitsi ba le tukwun ewo.<verse eid="ACT 25:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 25:8"/>Ta iPol si natsondu gbɛɛ: &lt;&lt;N kyungwɔ obube onyi mi ikpewo ola mgbi emi iJuda naadi ozu okwukwo osunu Imgbasho mi iJerosalin hona iSidza ba.&gt;&gt;<verse eid="ACT 25:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 25:9"/>Ngwi i mina iFɛstusu okyungwɔ gbɛɛ no kpa emi iJuda nɛ, o nya iPol gbɛɛ, &lt;&lt;O ka gbela okɛ iJerosalin azukwu ni ani ka fwo abu ikwɔ mi itɔdzɛ obube ntonɛ wɛ?&gt;&gt;<verse eid="ACT 25:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 25:10"/>IPol gbɛɛ: &lt;&lt;Ani kwudzɛ mi opiikwɔ mgbi iSidza onɛnɛni, li imbe ngbuo gbɛɛ a ka gbɔ ani ikwɔ aani. Abu abuabu ye saan n kyɔ emi iJuda obube onyi ba. <verse eid="ACT 25:10"/><verse number="11" style="v" sid="ACT 25:11"/>Kini ani kyɔ obube yɔ, n fwa okwulu ba. Kpaa ni odzɛ obube ngwi emi iJuda gbe tukwu ani ewo nɛ li otsitsi bayɔ, inggisɛ onyi sulu ofɛ okye ani wo ma abɔ ba. N tɛkyɛ ni iSidza abuon fwo ani ikwɔ!&gt;&gt;<verse eid="ACT 25:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 25:12"/>Ngwi iFɛstusu kye bwalu ondu yi ama osɔ ikwɔ yan nɛ, o nya iPol gbɛɛ: &lt;&lt;O tɛkyɛ nu iSidza nɛ li mbi iSidza o ka kɛ!&gt;&gt;<verse eid="ACT 25:12"/></para>
  <para style="s1">IFɛstusu tsɛwodzɛ yi Utɔ Agripa</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 25:13"/>I kye ongwɛ egbe gwee nɛ Utɔ Agripa yi iBɛnisi kaka iSisiria oka kye mmwɛ nu iFɛstusu. <verse eid="ACT 25:13"/><verse number="14" style="v" sid="ACT 25:14"/>Ngwi i yɛɛ gbɛɛ a ka la egbe ibyibyi mi imbe na nɛ, iFɛstusu kponya odzɛ mgbi iPol na yi utɔ. O gbɛɛ: &lt;&lt;Inggisɛ oka dzɛ mmɛnɛ ma ngwu iFelisi dzanta wo obawi. <verse eid="ACT 25:14"/><verse number="15" style="v" sid="ACT 25:15"/>Onɔ ngwi ani kɛ iJerosalin ma, engyukwo ama ofifɛ yi engyukwo mgbi emi iJuda gbe odzɛ obube tukwun ewo di gbɛɛ nu ma ngwɔn ikwɔ.<verse eid="ACT 25:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 25:16"/>N nya ma gbɛɛ yama li aletɔ mgbi emi iRoma okye inggisɛ nu ama ngbe odzɛ obube le tukwun ewo ba, sede a ka nun ofɛ no natsondu ewon mi odzɛ obube ngwi a gbe tukwun ewo mani. <verse eid="ACT 25:16"/><verse number="17" style="v" sid="ACT 25:17"/>Onɔ ngwi a ba mmɛnɛ yi ani ma, ani mbe onɔ yi ikwɔ na wuba, kpaa n byakpa kwu ela ni a kwakye mi ozu ikwɔ tegblifan si nu ma kyon ba. <verse eid="ACT 25:17"/><verse number="18" style="v" sid="ACT 25:18"/>Ngwi ama ogbe odzɛ tukwun ewo kyato ogbɔdzɛ nɛ, a yama kwu iyi ungwɔ obube ama ani tsɛwɛ ma ba. <verse eid="ACT 25:18"/><verse number="19" style="v" sid="ACT 25:19"/>Ungwɔ ngwi a yɛ kyɔ yɔ, a yɛ le gbɔ onɔgbɛ biyan mi ikye odzɛ Imgbasho mgbi ama bɛyi odzɛ mgbi inggisɛ ikwukwɔ ngwu a kwun di iYesu ngwu iPol le tso gbɛɛ o dzɛ oshishe nani. <verse eid="ACT 25:19"/><verse number="20" style="v" sid="ACT 25:20"/>I wo ani ɛndɛ dafi n ka kya mi itɔ ikwɔ nɛ mani; nghanɛ n yɛ byun ita ni o ka gbela kɛ iJerosalin nu ma ka kya mi itɔdzɛ ntonɛ yɔ. <verse eid="ACT 25:20"/><verse number="21" style="v" sid="ACT 25:21"/>Ngwi iPol tɛkyɛ gbɛɛ nu ma kye ongwu nu dafi oweka mgbi ongyufa dzɛ ma nɛ, n woola gbɛɛ nu ma kwunewo ongyon saan nghataa ba onɔ ngwi ani ka kyon kɛ mbi iSidza mani.&gt;&gt;<verse eid="ACT 25:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 25:22"/>Ta Agripa nya iFɛstusu gbɛɛ, &lt;&lt;I mina ani ofwo ongyulɔ nɛ abuen.&gt;&gt; O gbɛɛ, &lt;&lt;Ekeka ta o ka fwon.&gt;&gt;<verse eid="ACT 25:22"/></para>
  <para style="s1">IPol mi inai Agripa</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 25:23"/>Tegblifan nɛ, Agripa yi iBɛnisi wewo datu kaka ozu okwakye yi engyukwo oblakwutsɛ ama olɔngbɔ-lɔngbɔ bɛyi ama ogbe inggisɛ teyi mi ogalu nani. IFɛstusu si woola nu ma kye iPol kaka ifun. <verse eid="ACT 25:23"/><verse number="24" style="v" sid="ACT 25:24"/>IFɛstusu gbɛɛ: &lt;&lt;Utɔ Agripa yi ema ama nto mmɛnɛ yi eyi duu, ema di ongyulɔ nɛ lɔɔ! Emi iJuda duu biibɛ yi ani mi iJerosalin bɛyi iSidzaria mmɛnɛni, le feela gbɛɛ o mɛ ngwi o ki dzɛ oshishe wuba. <verse eid="ACT 25:24"/><verse number="25" style="v" sid="ACT 25:25"/>N difwi gbɛɛ o kyungwɔ mɛ ondu ikwu ba, kpaa ikyegbɛɛ o kye akwɔ mgban kɛ mbi ongyufa nɛ, n kye weka okyon dɛsɔ lu iRoma. <verse eid="ACT 25:25"/><verse number="26" style="v" sid="ACT 25:26"/>Nghaduu n sulu itɔdzɛ onyonyi ngwi n ka lɔ nu Ugabaidu ikye inggisɛ nɛ ba. Nɛ n kyon ba inai ema duu, onghaangha duu yɔ mbi abu utɔ Agripa, azukwu ni ema kyan di kana n ka tu itɔdzɛ ngwi n ka lɔ. <verse eid="ACT 25:26"/><verse number="27" style="v" sid="ACT 25:27"/>Lubana i tso ozoyeye ba, olɔ itɔdzɛ obube ikye inggisɛ obawi ba ta kyon dɛsɔ lu mbi Ugabaidu.&gt;&gt;<verse eid="ACT 25:27"/></para>
  <chapter eid="ACT 25"/>
  <chapter number="26" style="c" sid="ACT 26"/>
  <para style="p">
    <verse number="1" style="v" sid="ACT 26:1"/>Nɛ Agripa nya iPol gbɛɛ, &lt;&lt;N nu abu ofɛ gbɔdzɛ mgbi abu mani.&gt;&gt; Nɛta iPol kyɔ abɔ si wita ogbondu ewon gbɛɛ: <verse eid="ACT 26:1"/><verse number="2" style="v" sid="ACT 26:2"/>Utɔ Agripa ikyese dɛn okwudzɛ inai abu inɛ ogbondu ewani mi ungwɔ obube ngwi emi iJuda gbe tukwu ani ewo duu nɛni, <verse eid="ACT 26:2"/><verse number="3" style="v" sid="ACT 26:3"/>onghaangha duu ngwi abu ye aletɔ bɛyi angwodzɛ mgbi emi iJuda saan nɛni. Nghanɛ n tɛkyɛ nu abu shitukwu gen adɔ saan.<verse eid="ACT 26:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 26:4"/>&lt;&lt;Emi iJuda duu ye odzɛɛdzɛ mgbi ani kyɛ ongbɛ, mi okyɛɛ esɛ mgbi ani mi ɛsɛ mgbi ani, bɛyi iJerosalin kpaa. <verse eid="ACT 26:4"/><verse number="5" style="v" sid="ACT 26:5"/>A teyi ye ani onɔ kɛ onɛnɛni dika kyɔ obwɛndɛ, ni imina ma yɔ, ani li emi iFarasi ama ngwu nghao fyumfye mi odzɛ Imgbasho mgbi eyi nɛni. <verse eid="ACT 26:5"/><verse number="6" style="v" sid="ACT 26:6"/>Ikyenghanɛ li mi ikye ɛwɛ ogbe byiibyi mi ondu odzɛɛdzɛ ngwi Imgbasho dzɛ yi emi otseyi ma ngwi a le fwo ani ikwɔ inɛ aani. <verse eid="ACT 26:6"/><verse number="7" style="v" sid="ACT 26:7"/>Li ondu odzɛɛdzɛ ngwi agwɔ mgbi eyi iwyodefa le sunu Imgbasho onɔ yi otu gbɛɛ ni ama wa di dafi i ka ba mani. Utɔ dee, li ikye ɛwɛ ogbe byiibyi nɛ ngwi emi iJuda le dulu ongwufabɔ mbi ani aani. <verse eid="ACT 26:7"/><verse number="8" style="v" sid="ACT 26:8"/>Kyɔnɛse i fyi ema mfye onoyɛyɛ gbɛɛ Imgbasho li kyile inggisɛ mi ikwu?<verse eid="ACT 26:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 26:9"/>&lt;&lt;Ani abuani kpaa teyi gbela gbɛɛ i gbuo nin kyɔ alungwɔ ama ndzɛ kyɛmɛ duu ikye okye afɔ twɛsɛ yi iyi mgbi iYesu ongwi iNadzareti nɛni. <verse eid="ACT 26:9"/><verse number="10" style="v" sid="ACT 26:10"/>Di li ungwɔ ngwi ani kyɔ mi iJerosalin yɛyɛ kpaa aali. Mi ogbela-gbela mgbi engyukwo ama ofifɛ n gbe emi osaan kwuba wokɛ obawi, ani di li onyi mbi ama nwo abɔ ogbela gbɛɛ ni a gbɔ ma ikwɔ ngwɔ ma. <verse eid="ACT 26:10"/><verse number="11" style="v" sid="ACT 26:11"/>Onɔ ibyibyi n kyikyɛ mi ozu okwakye mgbi emi iJuda idzidza-dzidza ikye okwo ma adɔ, di li fya osi ma nu ma fya Imgbasho ito. Dafi itingga kyɔ ani yi ama ma, n lu anengye kpaa oka nu ma isɔ.<verse eid="ACT 26:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 26:12"/>N kyɛɛ okɛ itɔ agaba nɛ mi iDamasiko mi ondu onuunu yi ogbela-gbela mgbi engyukwo ama ofifɛ. <verse eid="ACT 26:12"/><verse number="13" style="v" sid="ACT 26:13"/>Utɔ dee, ngwi onɔ dɔ idzidzɛ udɛ ngwi ani kye ofɛ dikye le kɛ nɛ, ani di osa kyɛ esho, gbosa ngha onɔ, naabɔ yawo ani yi ama nwafɔ yi ani mani. <verse eid="ACT 26:13"/><verse number="14" style="v" sid="ACT 26:14"/>Eyi duu zudɔ wokɛ esɛ, man ani fwo ela le gbɔ yi ani mi ondu Aramiki<note caller="+" style="f"><char style="fr" closed="false">26:14 </char><char style="ft" closed="false">Hona iHibru</char></note> gbɛɛ, &lt;iSol, iSol, kyɔnɛ abu le nu ani isɔ ngha? Mnda ka yagba kye afɔ twɛsɛ yi okwuta ogbon ba.&gt;<verse eid="ACT 26:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 26:15"/>&lt;&lt;Ta ani byita gbɛɛ, &lt;Li abu emɛ, Otsɛ?&gt; Otsɛ nu uka gbɛɛ, &lt;&lt; &lt;Li ani iYesu ngwu abu le nu ani isɔ mani. <verse eid="ACT 26:15"/><verse number="16" style="v" sid="ACT 26:16"/>Onɛnɛ kyato dzɛkunto. Ani mblegba tu abu ikye okye abu yɛɛ ongbidɔ bɛyi obwɛndɛ mi ungwɔ ngwi abu di mbi ani bɛyi ungwɔ ani ka tso abu mani. <verse eid="ACT 26:16"/><verse number="17" style="v" sid="ACT 26:17"/>N ka nagbɛ abu mi abɔ emidabu yi abɔ Udzengye. N le dɔ abu esɔ mboma <verse eid="ACT 26:17"/><verse number="18" style="v" sid="ACT 26:18"/>ikye okwulu ma inɛ di kyata ma mi iyifu luba osa, bɛyi mfye mgbi iSatan luba abɔ mgbi Imgbasho, azukwu ni a dzita ma yi ali ibwubwe di gbe ma tokɛ mbonyi yi ama ngwu a salu ma yɛɛ saan mi oyɛyɛ onuunu mbi ani mani.&gt;<verse eid="ACT 26:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 26:19"/>&lt;&lt;Nghanɛ, utɔ Agripa, n yama nghaadɔ mi inɛ odiidi nkyɛ esho na ba. <verse eid="ACT 26:19"/><verse number="20" style="v" sid="ACT 26:20"/>N wita mi iDamasiko, luba iJerosalin yi iJudia duu, bɛyi Anengye kpaa. N gbeesɔ gbɛɛ nu ma kyata luba mbi Imgbasho nu ma di tso okyata-kyata mgbi ama mi okyɔɔkyɔ. <verse eid="ACT 26:20"/><verse number="21" style="v" sid="ACT 26:21"/>Li itɔdzɛ ngwi emi iJuda kpakli ani mi ifyudɛ ozu okwukwo osunu Imgbasho di fya ongwɔ ani ma aali. <verse eid="ACT 26:21"/><verse number="22" style="v" sid="ACT 26:22"/>Nghaduu n tu otobyi-tobyi mgbi Imgbasho nghataa ba inɛ, n di kwudzɛ mmɛnɛ ikye okyɔ obwɛndɛ nya ama nshewo bɛyi ama n yɛyikpa kpaa. Ani le gbɔdzɛ onyonyi ngha ungwɔ ngwi ama ogbɛɛsɛ bɛyi iMose gbɛɛ ka wa kyɔ ma ba <verse eid="ACT 26:22"/><verse number="23" style="v" sid="ACT 26:23"/>gbɛɛ iMedzaya ka gyadzɛ, ngwi o di li inggisɛ ongwu ababɔ owa kyɛɛ mi ikwu nɛ, o ka gbɔ osa nya emidan bɛyi Udzengye.&gt;&gt;<verse eid="ACT 26:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 26:24"/>Duuse ni iPol ngyɛlu ogbondu ewon yɔ, iFɛstusu dzan elodzɛ ondu, o gbɔ mi ela esho gbɛɛ, &lt;&lt;Eka kwagbɔdɔ loo iPol! Afɛ mgbɔɔ okpayi kwuba nɛ nu ikye kyata loo.&gt;&gt;<verse eid="ACT 26:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 26:25"/>IPol gbɛɛ, &lt;&lt;Ikye kyata lo ani ba, ugabaidu iFɛstusu,&gt;&gt; &lt;&lt;Odzɛ ngwi ani le gbɔ li otsitsi di li ingblimɔ. <verse eid="ACT 26:25"/><verse number="26" style="v" sid="ACT 26:26"/>Utɔ bɛ yi ungwɔ ntonɛni, n ka yagba gbɔdzɛ biyan itukwu asisa. N noyɛyɛ gbɛɛ ungwɔ ntonɛ onyi kpaa byulu lon mi ikye waba, ikyekyɛ a kyɔn mi odaada ba. <verse eid="ACT 26:26"/><verse number="27" style="v" sid="ACT 26:27"/>Utɔ Agripa, abu nu ama ogbɛɛsɛ oyɛyɛɛ? N ye o nu.&gt;&gt;<verse eid="ACT 26:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 26:28"/>Ta Agripa nya iPol gbɛɛ, &lt;&lt;Abu tsɛwɛ gbɛɛ mi ongwonɔ gwee nɛta elodzɛ mgbi abu ka yagba kyata ani yɛɛ inggisɛ iKrestuu?&gt;&gt;<verse eid="ACT 26:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 26:29"/>IPol nu uka gbɛɛ, ni li onɔ bwee hona onɔ gblɔgɔdɔ kpaa, N le bɔ Imgbasho ibɔ gbɛɛ, no wa li abu yuwoo ta ba kpaa ama nle fwo ani inɛ nɛ duu ki kyata dzɛ dafi ani sini, kpaa itse yɔ nu ma ka ta ema ba.&gt;&gt;<verse eid="ACT 26:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 26:30"/>Utɔ yi iGɔna yi iBɛnisi bɛyi ama nsɔto yi ama duu kyato. <verse eid="ACT 26:30"/><verse number="31" style="v" sid="ACT 26:31"/>A dzata ifoozu, ngwi a kyi ge ewoma nɛ a gbɛɛ, &lt;&lt;Inggisɛ nɛ le kyungwɔ onyonyi ngwi mɛ ondu ikwongye hona kaka obawi ba.&gt;&gt;<verse eid="ACT 26:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 26:32"/>Agripa nya iFɛstusu gbɛɛ, &lt;&lt;IPol ki teyi tɛkyɛ gbɛɛ ni iSidza gbɔn ikwɔ bayɔ, o mɛ odzanta.<verse eid="ACT 26:32"/></para>
  <chapter eid="ACT 26"/>
  <chapter number="27" style="c" sid="ACT 27"/>
  <para style="s1">IPol nyɛ ongwi uwaa kɛ iRoma</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 27:1"/>Ngwi ondu wa bwa gbɛɛ uwaa ka gbe eyi lu iTali nɛ, a kye iPol yi emi obawi angbeka wo ongyukwo oblakwutsɛ ongwu nli ikye odi mi obyi oblakwutsɛ mgbi ugabaidu ngwu a li kwun di iJuliyɔsu na abɔ. <verse eid="ACT 27:1"/><verse number="2" style="v" sid="ACT 27:2"/>Eyi kyɛɛ yi uwaa mi Adramatun eyi wewo obɛsɛ mi iga ama nto ondekyoo mi ayɛsɛ mgbi Asia di nyɛ kaka onekyoo. Aristaku, inggisɛ iMasidonia ngwu nkyɛ mi iTesalonika na, kyɛ yi eyi.<verse eid="ACT 27:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 27:3"/>Tegblifan nɛ, eyi bɛsɛ mi iSidon; nɛ iJuliyɔsu di iPol elela, nun ofɛ no kɛ mbi emi okan adzi nu ma nun ungwɔ ama nminan. <verse eid="ACT 27:3"/><verse number="4" style="v" sid="ACT 27:4"/>Mmana eyi diyɛ lu onekyoo di nyɛ kwɛkwɛ yi ibu ongwi iSapru ikyekyɛ awo gbeleyi wuba. <verse eid="ACT 27:4"/><verse number="5" style="v" sid="ACT 27:5"/>Ngwi eyi fa uwaa dzɛkyo onekyoo mi iga mgbi iSilisia yi iPamfyilia nɛ, eyi ka bɛsɛ mi iMira ongwi iLisia nani. <verse eid="ACT 27:5"/><verse number="6" style="v" sid="ACT 27:6"/>Mi imbe na ongyukwo oblakwutsɛ di iwudza ongwi Alekdzandra le lu Itali man gbe eyi wokɛ ele. <verse eid="ACT 27:6"/><verse number="7" style="v" sid="ACT 27:7"/>Eyi lu dumɔ-dumɔ mi egbe ibyibyi yi adzɛ kpakpa ka nyɛ kwɛkwɛ yi iSinidɔ. Ngwi awo gbela ni eyi kye inɛ byi imbe ngwi eyi le kɛ ma ba nɛ, eyi yɛ kye inɛ byi oyombo iSamɔ ikye ni ibu ongwi iKrete na tukwu eyi awo mani. <verse eid="ACT 27:7"/><verse number="8" style="v" sid="ACT 27:8"/>Eyi nyɛ ondiiga nɛ mi isɔ wa to imbe ngwi a kwun di iFɛ Hɛvun, kwɛkwɛ yi ogalu iLasia.<verse eid="ACT 27:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 27:9"/>Eyi mbe onɔ kpakpa nyɛ wa, ma okyɛɛ ongwi iwudza nɛ yɛɛ okakewo ikyesinɛ onɔ Oga otukwondu ngwi a li dzata inggisɛ yi alobube kpaa nyɛ wa. Nghanɛ iPol wɛ ma ewodzɛ gbɛɛ, <verse eid="ACT 27:9"/><verse number="10" style="v" sid="ACT 27:10"/>&lt;&lt;Engyulɔ, n le di gbɛɛ agaba nɛ ka ba yi eyi odzili-dzili dika nu iwudza yi okye bɛyi oshishe mgbi eyi kpaa nyanya.&gt;&gt; <verse eid="ACT 27:10"/><verse number="11" style="v" sid="ACT 27:11"/>Nghaduu ongyukwo oblakwutsɛ na gbela odzɛ owɛɛwɛ mgbi iPol ba kpaa kyɛdɔ elodzɛ mgbi inggisɛ ofa iwudza bɛyi otsungwɔ iwudza. <verse eid="ACT 27:11"/><verse number="12" style="v" sid="ACT 27:12"/>Dafi iga iFɛ Hɛvun na tishi ola ele nghataa ni ogba ngyɛ ba nɛ, inggisɛ kwuba gbela gbɛɛ ni eyi kiyayi yi okyɛɛ, ka la iFɔni nghataa ni ogba ngyɛ. Nɛnɛ li iga mi iKrete nkye inɛ byi okwokyiikwokyi mgbi aca yi onɔdɛ bɛyi agwudu yi onɔdɛ nani.<verse eid="ACT 27:12"/></para>
  <para style="s1">Onikyawo</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 27:13"/>Ngwi awo aca wita ofa fee nɛman, a tsɛwɛ gbɛɛ di ama tu ungwɔ ngwi ama mina ma wa; nɛ a takye ashi obwa iwudza kwulɛsɛ ngwuta wokɛ iwudza, si kye ondu agobo iKrete dikye. <verse eid="ACT 27:13"/><verse number="14" style="v" sid="ACT 27:14"/>Onɔ gwee nɛta awo okwokyiikwokyi mgbi agwudu yi onosa gbokyɛɛ mfyumfye kyɛ ibu wa fa eyi lu onekyoo. <verse eid="ACT 27:14"/><verse number="15" style="v" sid="ACT 27:15"/>Awo na wa tsɛkɛ iwudza ta eyi yagba fa iwudza kye inɛ byi awo wuba; nɛta eyi nya yi iwudza ofaafa nɛ awo kyi gbelu iwudza le lu. <verse eid="ACT 27:15"/><verse number="16" style="v" sid="ACT 27:16"/>Ngwi eyi nyɛ lu ongwɛ ibu ngwi a li kwun di iKauda nɛ, eyi fya kpakpa se wa yagba onu uwaa ongbungbɛ na gbobu ba. <verse eid="ACT 27:16"/><verse number="17" style="v" sid="ACT 27:17"/>Ngwi a kyi kyelu uwaa ongbungbɛ wokɛ ifun nɛ, a kye odi bwalu iwudza bɛkɛ. Ngwi a mio gbɛɛ di iwudza ka ka kwo esɛ mi mfyan mgbi iSati nɛ, a takye ashi obyi iwudza kwulɛsɛ ngwuta wokɛ eni ni iwudza le kwo lu dumɔ-dumɔ. <verse eid="ACT 27:17"/><verse number="18" style="v" sid="ACT 27:18"/>Tegblifan, dafi awo na kale fa nghaabɔ le gbobulu iwudza nɛ a wita omwa okye yangwuta mi eni. <verse eid="ACT 27:18"/><verse number="19" style="v" sid="ACT 27:19"/>Mi egbe ongwu ta nɛ, a kye abɔ mgbi ama abuoma shɛ okye iwudza angbeka yangwuta. <verse eid="ACT 27:19"/><verse number="20" style="v" sid="ACT 27:20"/>Ngwi onɔ hona ofyia kpaa eyi di ma wuba egbe ibyibyi, onikyawo kpaa kale fa nɛ, eyi gbɛwɛ ngwuta gbɛɛ eyi ka watɔ wuba.<verse eid="ACT 27:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 27:21"/>Dafi inggisɛ ntonɛ kyikyɛ onɔ tunto tu ungwogye gye ba nɛ, iPol kyato nya ma gbɛɛ: &lt;&lt;Engyulɔ, ema ki gbela odzɛ mgbi ani owɛ-wɛ mi iKrete gbɛɛ ni ema ka fa ba na yɔ; ungwɔ ama nnyanya di byulu lo ema ntonɛ kika kyɔ ba. <verse eid="ACT 27:21"/><verse number="22" style="v" sid="ACT 27:22"/>Nghaduu onɛnɛ, ani kwu ema ɛwɛ wo gbɛɛ ni ema kiyayi mi itukwu mgbi ema fyumfye-fyumfye, ikyekyɛ inggisɛ mgbi ema onyi kpaa ka byulu ba, sede li iwudza ta ka nyanya. <verse eid="ACT 27:22"/><verse number="23" style="v" sid="ACT 27:23"/>Mi otu ongwu dɛdɛ na, ongyesɔ mgbi Imgbasho mgbi ani ngwu ani li sunun na wa kwudzɛ kwɛkwɛ yi ani <verse eid="ACT 27:23"/><verse number="24" style="v" sid="ACT 27:24"/>si nya ani gbɛɛ, &lt;Ka wimio ba iPol, iSidza ka fwo abu ikwɔ kyɛmɛ; ma di li ikye mgbi abu Imgbasho ka dzata ama nwoto iwudza yi abu ntonɛ duu oshishe. <verse eid="ACT 27:24"/><verse number="25" style="v" sid="ACT 27:25"/>Nghanɛ fyumfye itukwu kpɔɔ na engyulɔ, lubana ani noyɛyɛ gbɛɛ ungwɔ ngwi Imgbasho gbɔ nɛ ka kyɔ ngha yɛyɛ. <verse eid="ACT 27:25"/><verse number="26" style="v" sid="ACT 27:26"/>Nghaduukpaa, iwudza mgbi eyi ka ka fatila dɔkɛ ibu mbeka.&gt;&gt;<verse eid="ACT 27:26"/></para>
  <para style="s1">Iwudza fatila</para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 27:27"/>Mi otu ongwi iwyodenɛ ma kpaa awo na ka kye eyi le ga kyɛ Onekyoo Adratiki, ngwi otu wa gheefa nɛ, ama ofa iwudza difwi gbɛɛ ama le dzɛ kwɛkwɛ yi ondikyi. <verse eid="ACT 27:27"/><verse number="28" style="v" sid="ACT 27:28"/>A mba okɛɛkɛ mgbi eni si di gbɛɛ li atafɔ ideli onyi dɔn osu. I kye onɔ gwee nɛ, a di mba tu atafɔ ngwusenɛ dɔn iwyo. <verse eid="ACT 27:28"/><verse number="29" style="v" sid="ACT 27:29"/>Ngwi eyi le mio gbɛɛ eyi ka wa gyɛkɛ akwutsɛ nɛ, a kyi takye iyudza obwa iwudza kwulɛsɛ nghi enɛ yaokɛ eni mi iyikpa di bibɔ gbɛɛ ni egbe fa. <verse eid="ACT 27:29"/><verse number="30" style="v" sid="ACT 27:30"/>Ngwi i mina ama ofa iwudza otse dzamata nɛ, a kyi shɛlu uwaa ongbungbɛ na wokɛ eni tole kyɔ ɛwɛ dafi ama takye iyudza okwu iwudza kwulɛsɛ le ngwuta wokɛ eni mi iyayi mani. <verse eid="ACT 27:30"/><verse number="31" style="v" sid="ACT 27:31"/>Ta iPol nya okwukwo ogbakwu bɛyi oblakwutsɛ ntona gbɛɛ, &lt;&lt;Ni inggisɛ ntonɛ tɔ dzata iwudza yɔ ema ka watɔ ba.&gt;&gt; <verse eid="ACT 27:31"/><verse number="32" style="v" sid="ACT 27:32"/>Nghanɛ oblakwutsɛ ntona kye dzɛlu odi ngwi a kye ongwuwaa na sha ele ma non fɛ lu.<verse eid="ACT 27:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 27:33"/>Duuse ni egbe fa nɛ, iPol tɛkyɛ yi ama duu gbɛɛ ni a gye ungwogye. O gbɛɛ, &lt;&lt;Egbe iwyodenɛ inɛ waani, itukwu kaka ema ewo jo ema gye unkonyi ba. <verse eid="ACT 27:33"/><verse number="34" style="v" sid="ACT 27:34"/>Kpaa onɛnɛ n tɛkyɛ nu ema gbɛɛ ni ema gye ungwogye adzi ni ema dzɛ oshishe. Lubana alotu onyi kpaa ka kwɔ mi ikye mgbi inggisɛ onyi ba. <verse eid="ACT 27:34"/><verse number="35" style="v" sid="ACT 27:35"/>Ngwi iPol gbɔdzɛ nɛ ngyɛ nɛ, o kyi gbelu ibredi angbeka si ta Imgbasho angba mi inai ma duu. Kyi mwalu wita ogyeegye. <verse eid="ACT 27:35"/><verse number="36" style="v" sid="ACT 27:36"/>Ama duu fyumfye itukwu di gye ungwogye abuoma. <verse eid="ACT 27:36"/><verse number="37" style="v" sid="ACT 27:37"/>Eyi ama nwoto iwudza duu li inggisɛ ideli efa ngwuseta dɔn iwyo diwyegyin. <verse eid="ACT 27:37"/><verse number="38" style="v" sid="ACT 27:38"/>Ngwi a gye ungwogye dafi a mina ma nɛ, a kyi gbelu ungwogyowe nsisi duu yangwuta mi onekyoo ikye okyi mwalu mlo mi iwudza.<verse eid="ACT 27:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 27:39"/>Ngwi egbe wa fa nɛ, ama ofa iwudza difwi agobo ma wuba, kpaa a di iga mfyan. Nghanɛ a tsɛwodzɛ gbɛɛ ni ama yagba yɔ, ama ka fa iwudza na nyɛ mfyan ka bɛkɛ esɛ. <verse eid="ACT 27:39"/><verse number="40" style="v" sid="ACT 27:40"/>Dafi a kye dzɛlu iyudza okwu iwudza kwulɛsɛ nɛ, a dzitama mi eni di kye shɛlu odi ama ntsɛ anghi ntona mi onɔ na kpɔɔ. Ta a kyile angwuto ogbaawo iwudza ikyegbɛɛ ni awo fa iwudza bɛkɛ iga. <verse eid="ACT 27:40"/><verse number="41" style="v" sid="ACT 27:41"/>Nghaduu iwudza kwo esɛ kye ikye shawokɛ mfyan kye inɛnɛ byi esho fatila yagba okiyayi wuba man akpeni gbobu iwudza mi iyikpa.<verse eid="ACT 27:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 27:42"/>Ama oblakwutsɛ tsɛwɛ okyi ngwɔlu emi obawi ntonani di a wa tsɛ eni lu agobo ka tsebyulu. <verse eid="ACT 27:42"/><verse number="43" style="v" sid="ACT 27:43"/>Nghaduu i mina okwukwo ogbakwu na odulu oshishe mgbi iPol watɔ, nɛ o kwɔ ma oweka mgbi ama ikyenghanɛ o wo ama n ye eni otsɛɛtsɛ ola gbɛɛ nu ma tsɛ eni lu agobo. <verse eid="ACT 27:43"/><verse number="44" style="v" sid="ACT 27:44"/>Ama nsisi ka gbe igɛgɛ tukwu otsokplekwɔ bɛyi ombwumbwu uwaa lu agobo. Li ngha ngwi eyi duu bɛsɛ saan aali.<verse eid="ACT 27:44"/></para>
  <chapter eid="ACT 27"/>
  <chapter number="28" style="c" sid="ACT 28"/>
  <para style="s1">Ibu ongwi iMɔta</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 28:1"/>Ngwi eyi wa bɛsɛ saan nɛ eyi difwi gbɛɛ li mi ibu ongwi iMɔta. <verse eid="ACT 28:1"/><verse number="2" style="v" sid="ACT 28:2"/>Emi ibu ntona tso eyi okpitukwu ngwi eyi din ye ba. A gbɛ eyi di mɛ ola wo eyi ikyekyɛ mmbwo le kya ofu dile yi. <verse eid="ACT 28:2"/><verse number="3" style="v" sid="ACT 28:3"/>IPol waa akyikye ekwɔ kwutokɛ, ngwi o le sa wokɛ ola nɛ, ogidzi ngwi olola non tasɛ ton tandri won abɔ. <verse eid="ACT 28:3"/><verse number="4" style="v" sid="ACT 28:4"/>Ngwi emi ibu di ifa na fatila kwodzɛ abɔ nɛ, a gbɔ yi ewoma gbɛɛ, &lt;&lt;Inggisɛ nɛ ka li inggisɛ ongwɔ inggisɛ kyɛmɛ-kyɛmɛ; lubana dafi o watɔ mi ekyoo okwukwo nɛ kpaa, obube mgban ka non dzɛ oshishe ba.&gt;&gt; <verse eid="ACT 28:4"/><verse number="5" style="v" sid="ACT 28:5"/>Kpaa iPol ngwi ifa na wokɛ ola unka di kyɔn ba. <verse eid="ACT 28:5"/><verse number="6" style="v" sid="ACT 28:6"/>Inggisɛ ntona kye ɛwɛ byi gbɛɛ o ka mwɛ ewo naadi tsɛɛsɛ kwulu ntunto. Nghaduu ngwi a fɛ onɔ kɛ di di unkonyi okakewo kyɔn ba nɛ, a kyatitukwu mgbi ama di gbɛɛ o li Imgbasho.<verse eid="ACT 28:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 28:7"/>Ogalu dzɛ kwɛkwɛ mi imbe na ngwi li mgbi iPobilu, utɔ mgbi ibu nani. O gbɛ eyi mi udan abɔ efa di kyɔ yi eyi saan egbe eta. <verse eid="ACT 28:7"/><verse number="8" style="v" sid="ACT 28:8"/>Otsɔn dotse ladzɛ esɛ, awo bwan o dile nya adama. IPol kaka ka din, ngwi o bibɔ won ngyɛ nɛ, o gbe abɔ dɔn ikye di ngyɛlun ootse. <verse eid="ACT 28:8"/><verse number="9" style="v" sid="ACT 28:9"/>Ngwi ungwɔnɛ kyɔ nyɛ nɛ, emi ootse angbeka mi ibu na duu ba, a di ngyɛlu ma ootse. <verse eid="ACT 28:9"/><verse number="10" style="v" sid="ACT 28:10"/>A nu eyi mmwɛ mi ofɛ idzidza-dzidza, ngwi eyi di wa wewo onyɛ ongwi eni lu nɛ, a nu eyi alungwɔ ngwi eyi mina mi ikye okyɛɛ nani.<verse eid="ACT 28:10"/></para>
  <para style="s1">IPol kaka iRoma</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 28:11"/>Ngwi i wa nyɛ ofyia eta nɛ, eyi kaka iwudza oka ngwi a dzanta mi ibu na owa olɔlɔ olu. Li iwudza ongwi Alekdzandra ngwi a kye ambɛ dzɛ ikyen gbɛɛ Imgbasho ongwefa.<note caller="+" style="f"><char style="fr" closed="false">28:11 </char><char style="ft" closed="false">Imgbasho ongwefa ntona, a li kwu ma gbɛɛ IKasto bɛyi iPolɔsu. A li emi ongwɛ iDzeu Imgbasho mgbi emi iGriki. A li di mbi ama okyikyɛ mi eni.</char></note> <verse eid="ACT 28:11"/><verse number="12" style="v" sid="ACT 28:12"/>Eyi wa bɛsɛ mi iSiraku, di la ele egbe eta. <verse eid="ACT 28:12"/><verse number="13" style="v" sid="ACT 28:13"/>Mi imbe na eyi di nyɛ ongwi eni ka kaka iRejun. Tegblifan man awo iwu gbokyɛɛ, ngwi i di fa egbe oka nɛ eyi to iPuteli. <verse eid="ACT 28:13"/><verse number="14" style="v" sid="ACT 28:14"/>Mi imbe na eyi tu ama okyɛdɔ iYesu angbeka, a bɔ eyi wa la yi ama ikyidu olɔlɔ. Man eyi si kyɛɛ wa kaka iRoma. <verse eid="ACT 28:14"/><verse number="15" style="v" sid="ACT 28:15"/>Ama okyɛdɔ iYesu emi imbe na teyi fwo gbɛɛ eyi kyɛma, man a lukwu eyi nghataa luba idu Apiɔ bɛyi imbe ngwi a kwun gbɛɛ Ozu eta mgbi ingyoga owa kpatsɛ eyi. Ngwi iPol dili ma nɛ, o ta Imgbasho angba itukwu di fyonmfye. <verse eid="ACT 28:15"/><verse number="16" style="v" sid="ACT 28:16"/>Ngwi eyi ka kaka iRoma ma, a nu iPol ofɛ gbɛɛ no la ozu yuon kpaa oblakwutsɛ nu ma ngyon.<verse eid="ACT 28:16"/></para>
  <para style="s1">IPol gbeesɔ mi iRoma ngwi a le ngyon</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 28:17"/>Ngwi i kye egbe eta nɛ, iPol kwu engyukwo emi iJuda kwakye, dafi a wa kwakye nɛ, iPol nya ma gbɛɛ: &lt;&lt;Emi ongwunani, ani kyɔ nkonyonyi ongha emideyi adɔ naadi aletɔ mgbi emi otsikyeyi ba, kpaa a bwa ani mi iJerosalin di kye ani wo emi iRoma abɔ. <verse eid="ACT 28:17"/><verse number="18" style="v" sid="ACT 28:18"/>A kya mi odzɛ mgbi ani di mina ma odzita ani ikyesinɛ ani kyungwɔ obube nmɛ ondu ikwongye ba. <verse eid="ACT 28:18"/><verse number="19" style="v" sid="ACT 28:19"/>Kpaa emi iJuda fwa, nghanɛ i yɛɛ kyɛmɛ ngwi ani ka tɛkyɛ nu ma yile ani luba mbi iSidza. Nghaduu ani dzɛ yi odzɛ onyi ogbe tukwu emidani ewo ba. <verse eid="ACT 28:19"/><verse number="20" style="v" sid="ACT 28:20"/>Li itɔdzɛ nɛ ngwi ani gbɛɛ ni ani di ema di gbɔdzɛ yi ema. Li mi ikye ɛwɛ ogbe byiibyi mgbi emi Israi ma ngwi a bwa ani adi mi ashi nɛ aani.&gt;&gt;<verse eid="ACT 28:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 28:21"/>A nun uka gbɛɛ, &lt;&lt;Eyi tu afɛ onyi nkyɛ mi iJudia mi ikye odzɛ mgbi abu ba, emi ongwuneyi onyi nkyɛ mi imbe na nya eyi hona gbɔdzɛ obube onyi mi ikpewo abu ba. <verse eid="ACT 28:21"/><verse number="22" style="v" sid="ACT 28:22"/>Nghaduu i mina eyi ofwo ɛwɛ otsɛɛtsɛ mgbi abu, lubana eyi ye dafi inggisɛ mi ali imbe duu le gbɔdzɛ osuse ba ikpewo ayɛ inggisɛ ntona mani.&gt;&gt;<verse eid="ACT 28:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 28:23"/>A kye egbe dzɛ owa kwakye yi iPol, di ba mi mmbwo kpakpa nghaabɔ ogbugbe mi imbe ngwi o dzɛ mani. O li gbɔdzɛ esutɔ mgbi Imgbasho nya ma mi egbegbe nghataa onɔ li gbɛsɛ dile biibɛ yi ama mi ola mgbi iMose bɛyi oyegbɔ gbɛɛ nu ma noyɛyɛ mbi iYesu. <verse eid="ACT 28:23"/><verse number="24" style="v" sid="ACT 28:24"/>Engyukwo angbeka mboma noyɛyɛ mi odzɛ ngwi o gbɔ mani, kpaa angbeka yɔ gbela ba. <verse eid="ACT 28:24"/><verse number="25" style="v" sid="ACT 28:25"/>Dafi angwodzɛ tɔ mi idzidzɛ mgbi ama nɛ, a wita oganya mi onɔ ngwi iPol ngyɛlu odzɛ nɛ ogbɔɔgbɔ mani gbɛɛ: &lt;&lt;Onodzi Osaan na gbɔdzɛ otsitsi mi ikye mgbi emi otsikyema mi onɔ ngwi o gbɔdzɛ nyɛ mbi oyegbɔ Adzaya mani gbɛɛ:<verse eid="ACT 28:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 28:26"/>&lt;&lt; &lt;Kɛ mbi inggisɛ ntonɛ dika nya ma gbɛɛ,</para>
  <para style="p" vid="ACT 28:26">&lt;&lt;Ema kale fwo alonɔ kpaa ka yama gbosa lo ema ba; ema kale di alonɔ kpaa ema ka yama difwi ba.&gt;&gt;<verse eid="ACT 28:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 28:27"/>Itukwu mgbi inggisɛ ntonɛ tiishu; a li fwo kpaa gbadikye, a di kye inɛ mgbi ama tukwu. Lubana a kika di yi inɛ mgbi ama, fwo mi adɔ mgbi ama, difwi mi itukwu mgbi ama di kyata ba mbi ani Imgbasho ta ani kika ngyɛlu ma ootse.&gt;<verse eid="ACT 28:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 28:28"/>&lt;&lt; &lt;Ikyenghanɛ ani mina ni ema ye gbɛɛ owatɔ-watɔ mgbi Imgbasho nɛ a kye dɛsɔ nu Udzengye, ama yɔ a ka kyi gbɛlu!&gt;&gt; <verse eid="ACT 28:28"/><verse number="29" style="v" sid="ACT 28:29"/>Ngwi iPol gbɔ elodzɛ ntonɛ ngyɛ nɛ, emi iJuda si lu kale tangwodzɛ yi ewoma kpakpa.<note caller="+" style="f"><char style="fr" closed="false">28:29 </char><char style="ft" closed="false">Ambulu nɛ dzɛ mi olɔɔlɔ angbeka ba</char></note> <verse eid="ACT 28:29"/><verse number="30" style="v" sid="ACT 28:30"/>IPol kwu ozu onova efa le gbɛ inggisɛ ama nba owa din duu. <verse eid="ACT 28:30"/><verse number="31" style="v" sid="ACT 28:31"/>Ngwi imbe fyin ba nɛ, o gbeesɔ mgbi esutɔ mgbi Imgbasho yi abɔ otsigɛgɛ di tsungwɔ mgbi Otsɛ iYesu iKrestu.<verse eid="ACT 28:31"/></para>
  <chapter eid="ACT 28"/>
</usx>
