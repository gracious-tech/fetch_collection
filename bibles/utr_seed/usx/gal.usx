<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="GAL" style="id">- Etulo</book>
  <para style="h">Emi iGalatia</para>
  <para style="toc1">Afɛ mgbi iPol mbi ama onoyɛyɛ Emi iGalatia</para>
  <para style="toc2">Emi iGalatia</para>
  <para style="toc3">iGal</para>
  <para style="mt2">Afɛ mgbi iPol mbi<optbreak/> ama onoyɛyɛ</para>
  <para style="mt1">Emi iGalatia</para>
  <chapter number="1" style="c" sid="GAL 1"/>
  <para style="p">
    <verse number="1" style="v" sid="GAL 1:1"/>Afɛ nɛ kyɛ mbi ani iPol nli onyi mbi ama ogbikye iYesu; ngwu ela okwu-kwu mgbi ani kyɛ mbi ibyi inggisɛ naadi owitukwu mgbi inggisɛ owamyɛ ba, kpaa li mi owitukwu mgbi iYesu iKrestu bɛyi Otsɛ Imgbasho, ongwu nkyile iYesu mi ikwongye nani. <verse eid="GAL 1:1"/><verse number="2" style="v" sid="GAL 1:2"/>Emi iKrestu ama nto yi ani duu kwakye okye angba dɛsɔ nu okwakye mgbi emi iKrestu ama nto iGalatia gbɛɛ:<verse eid="GAL 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GAL 1:3"/>Elela yi iyu mgbi Otseyi Imgbasho bɛyi Otsɛ iYesu iKrestu no dzɛ yi ema duu. <verse eid="GAL 1:3"/><verse number="4" style="v" sid="GAL 1:4"/>IYesu iKrestu nkye ewon fifɛ mi ikye odulu eyi watɔ mi ali ibwubwe mgbi eyi ongwi onɛnɛ, mi owitukwu mgbi Otseyi Imgbasho nani. <verse eid="GAL 1:4"/><verse number="5" style="v" sid="GAL 1:5"/>Okwɔkwɔ no dzɛ mbon gyegwu-gyegwu. No dzɛ ngha.<verse eid="GAL 1:5"/></para>
  <para style="s1">Esɔ Osuse li onyi ta</para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 1:6"/>I kwulu ani ewo kwuba gbɛɛ ema le kyata plɛ dzita ongwu nkwu ema ela mi elela ngwi o di ema ikpewo iKrestu le lu esɔ oka idzidza <verse eid="GAL 1:6"/><verse number="7" style="v" sid="GAL 1:7"/>ngwi li Esɔ Osuse ba du. Omwonya bayɔ, inggisɛ angbeka le wo ema ɛndɛ di mina okyata ema itukwu mi Esɔ Osuse mgbi iKrestu. <verse eid="GAL 1:7"/><verse number="8" style="v" sid="GAL 1:8"/>Nghaduu ni eyi abueyi hona ongyesɔ ongwi esho gbeesɔ oka idzidza yi ongwi eyi tsekise gbɔ nya ema na yɔ, ni inggisɛ na dzili gyegwu! <verse eid="GAL 1:8"/><verse number="9" style="v" sid="GAL 1:9"/>Dafi eyi tsekise gbɔ mani, onɛnɛ n dile gbɛɛ: Kini inggisɛ ta le gbeesɔ oka idzidza nya ema yi ongwi ema tsekise gbɛ na yɔ, ni inggisɛ na dzili gyegwu!<verse eid="GAL 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 1:10"/>Ani le kyungwɔ gbɛɛ no kpa inggisɛ naa Imgbasho? Ani le fya gbɛɛ nin tɔ iyi mbi inggisɛɛ? Ni ani kale fya okyɔ itukwu inggisɛ yɔ, n ka li ongbidɔ mgbi iKrestu wuba.<verse eid="GAL 1:10"/></para>
  <para style="s1">Imgbasho kwu iPol ela</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 1:11"/>Emi ongwunani, i mina ani ni ema ye gbɛɛ, Esɔ Osuse ngwi ani le gbɔ nɛ kyɛ mbi inggisɛ owamyɛ ba. <verse eid="GAL 1:11"/><verse number="12" style="v" sid="GAL 1:12"/>N gbɛ mbi inggisɛ owamyɛ onyi ba, hona inggisɛ onyi tso ani ba. Li iYesu iKrestu abuon kye tso ani mi inɛ odiidi.<verse eid="GAL 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 1:13"/>Lubana ema fwo odzɛɛdzɛ mgbi ani mi onɔ nose ngwi ani le kyɔ odzimgbasho mgbi emi iJuda mani, dafi ani nu emi iKrestu adzɛ kpakpa yi elela odiidi ba, di fya mi ofyaafya mgbɛn duu odzili ma mani. <verse eid="GAL 1:13"/><verse number="14" style="v" sid="GAL 1:14"/>Ani nose le shewo mi odzimgbasho mgbi emi iJuda ngha atsɛ ani ibyibyi di dzɛ yi ɛwɛ ogbebyi kwuba mi aletɔ mgbi emi otsani. <verse eid="GAL 1:14"/><verse number="15" style="v" sid="GAL 1:15"/>Nghaduu Imgbasho, dulu ani mi elela mgban duuse a wa mba ani di kwu ani ela gbɛɛ ni ani wa kyɔn idɔ mi onɔ ngwi i gyɔlon mani. <verse eid="GAL 1:15"/><verse number="16" style="v" sid="GAL 1:16"/>O kye ongwan tso ani ikye ni ani gbeesɔ mgban nya Udzengye. N kɛ ka gbɛ ewodzɛ mbi inggisɛ onyi, <verse eid="GAL 1:16"/><verse number="17" style="v" sid="GAL 1:17"/>naadi kɛ iJerosalin oka di ama nli ama ogbikye iYesu teyi ani na ba, kpaa n byakpa lu Arabia di wa yidɔ luba iDamasiko.<verse eid="GAL 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 1:18"/>Ta ngwi i wa nyɛ onova eta nɛ, n kɛ iJerosalin oka ye iPyita, n di la yan egbe iwyodeda. <verse eid="GAL 1:18"/><verse number="19" style="v" sid="GAL 1:19"/>N di ama ogbikye iYesu angbeka ntona ba, se li iJɛnsi ongwunɔ Otsɛ iYesu ta. <verse eid="GAL 1:19"/><verse number="20" style="v" sid="GAL 1:20"/>N le nya ema otsitsi mi inɛ Imgbasho gbɛɛ ungwɔ ngwi ani lɔ le kɛ mbi ema nɛ li atsika ba.<verse eid="GAL 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 1:21"/>Ngwi i wa nyɛ nɛ, n lu iSiria yi iSilisia. <verse eid="GAL 1:21"/><verse number="22" style="v" sid="GAL 1:22"/>Emi iKrestu mi iJudia duu ye ani ba.<verse eid="GAL 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GAL 1:23"/>A fwoofwo ta gbɛɛ: &lt;&lt;Ongyulɔ nose nle nu eyi isɔ ma yɛ le gbɔ oyɛyɛ onuunu ngwi nose o le fya odzilin mani.&gt;&gt; <verse eid="GAL 1:23"/><verse number="24" style="v" sid="GAL 1:24"/>Man a si tsɛ Imgbasho mi ikye ani.<verse eid="GAL 1:24"/></para>
  <chapter eid="GAL 1"/>
  <chapter number="2" style="c" sid="GAL 2"/>
  <para style="s1">Ama Ogbikye iYesu gbɛ iPol</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 2:1"/>Onova wa nyɛ iwyodenɛ man n diyɛ kɛ iJerosalin yi iBanabasi, n kye iTaitusu wafɔ yi ani. <verse eid="GAL 2:1"/><verse number="2" style="v" sid="GAL 2:2"/>N kɛ ikyegbɛɛ Imgbasho kye tso ani gbɛɛ ni ani kɛ dika kye Esɔ Osuse ngwi ani le gbɔ nya Udzengye (ama nli emi iJuda ba) ma tso engyukwo. Kpaa n kyungwɔnɛ daada mbi ama ndzɛ dafi li ama ogbe inggisɛ teyi mani, ikyegbɛɛ onya ngwi ani le tse hona tsekise tse ma, no ka labɔ ba. <verse eid="GAL 2:2"/><verse number="3" style="v" sid="GAL 2:3"/>Nghaduu iTaitusu nli Udzengye dzɛ yi ani nɛ kpaa, a siin gbɛɛ non kyiikyɛ ba.<verse eid="GAL 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GAL 2:4"/>Odzɛ nɛ tɔ ikyekyɛ emi iKrestu emi atsika angbeka wulɛ kaka idzidzɛ eyi oye eyi iba ngwi eyi dzɛyan mi iKrestu di nu eyi yɛɛ ofyɛɛ mgbi ola mgbi emi iJuda. <verse eid="GAL 2:4"/><verse number="5" style="v" sid="GAL 2:5"/>Eyi nu ma ofɛ gyɛngyɛ ba, ikyegbɛɛ ni otsitsi mgbi Esɔ Osuse tila dzɛ mbi ema.<verse eid="GAL 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 2:6"/>Mbi ama ndzɛ dafi ama ogbe inggisɛ teyi ntona, ungwɔ ngwi a dzɛ duu kyata unkonyi mbi ani ba; Imgbasho li di mi odzɛɛdzɛ mgbi inggisɛ mi ikpewo ba. Ɛdzɛ ntona mbwo ungwɔ onyi mi esɔ mgbɛn ba. <verse eid="GAL 2:6"/><verse number="7" style="v" sid="GAL 2:7"/>Nghaduu, a di gbɛɛ Imgbasho kye idɔ ogbɔ Esɔ Osuse nya Udzengye (ama nli emi iJuda ba) wo ani abɔ, yɛyɛ dafi o kye wo iPyita ogbɔ nya emi iJuda nani. <verse eid="GAL 2:7"/><verse number="8" style="v" sid="GAL 2:8"/>Bana Imgbasho nle kyidɔ nyɛ mbi iPyita kɛ mbi emi iJuda na, le kyidɔ nyɛ mbi ani kpaa dafi onyi mbi ama ogbikye iYesu kɛ mbi Udzengye (ama nli emi iJuda ba nani).<verse eid="GAL 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GAL 2:9"/>Dafi iJɛnsi yi iPyita bɛyi iJɔn, ama ngwu a ye ma gbɛɛ a li otlɛsɛ mgbi emi iKrestu, difwi elela ngwi Imgbasho kye nu ani nɛ, a gbela yi ani yi iBanabasi gbɛɛ ni eyi kyidɔ mbi Udzengye (ama nli emi iJuda ba) ni ama kyidɔ mbi emi iJuda. <verse eid="GAL 2:9"/><verse number="10" style="v" sid="GAL 2:10"/>Ungwɔ onyi ngwi a nghao mina gbɛɛ ni eyi kyɔ yɔ, ni eyi le wɛ emi adzɛ, nli ungwɔ nteyi wo ani itukwu okyɔɔkyɔ yɛyɛ aali.<verse eid="GAL 2:10"/></para>
  <para style="s1">IPol kyɔkyɔ odzɛ yi iPyita</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 2:11"/>Ngwi iPyita wa kaka Antiɔku nɛ, n fwa odzɛ yan mi ododa, bana o kyungwɔ nli ayin ba saan. <verse eid="GAL 2:11"/><verse number="12" style="v" sid="GAL 2:12"/>Duuse ni engyulɔ ama nkyɛ mbi iJɛnsi mi iJerosalin ma ba yɔ, o li le gye ungwogye yi Udzengye (ama nli emi iJuda ba). Nghaduu ngwi ɛdzɛ ntona wa kaka nɛ, o wita odulu abɔ dzɛ enggengga yi Udzengye (ama nli emi iJuda ba) ikyekyɛ o le mio emi iJuda ntonani. <verse eid="GAL 2:12"/><verse number="13" style="v" sid="GAL 2:13"/>Emi iJuda angbeka ntona kpaa bɛkɛ yan le kyɔ ikpala, ikyenghanɛ a nu iBanabasi kpaa boofɛ le kyɛdɔ ma mi ikpala mgbi ama.<verse eid="GAL 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GAL 2:14"/>Ngwi ani di gbɛɛ a le kyɔ ali ndzɛ mi otsitsi mgbi Esɔ Osuse ba nɛ, n nya iPyita mi inai ma duu gbɛɛ, &lt;&lt;Abu li inggisɛ iJuda, kpaa le kyungwɔ dafi Udzengye, ma kyɔsinɛse abu ka si Udzengye gbɛɛ nu ma kyɔ aletɔ mgbi emi iJuda?&gt;&gt;<verse eid="GAL 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 2:15"/>Ani yi abu a mba eyi li emi iJuda, eyi li &lt;emi ali ibwubwe dafi Udzengye ba&gt; <verse eid="GAL 2:15"/><verse number="16" style="v" sid="GAL 2:16"/>eyi ye gbɛɛ inggisɛ li gye emyɛmyɛ mi ongyo ola mgbi iMose ba, kpaa li mi oyɛyɛ onuunu mbi iYesu iKrestu. Nghanɛ eyi kpaa noyɛyɛ mbi iKrestu iYesu ikyegbɛɛ ni eyi gye emyɛmyɛ mi oyɛyɛ onuunu mbi iKrestu di li mi ongyoongyo mgbi ola mgbi iMose ba. Ikyesinɛ no li mi ola mgbi iMose ongyoongyo yɔ, inggisɛ onyi kpaa ka gye emyɛmyɛ mi inɛ Imgbasho ba.<verse eid="GAL 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 2:17"/>Ni i dzɛ gbɛɛ eyi emi iJuda mina ogye emyɛmyɛ mi inɛ Imgbasho ikpewo iKrestu yɔ, i tso gbɛɛ eyi kpaa li emi ali ibwubwe, taman li iKrestu nu eyi li emi ali ibwubwe wadaa? Onoka lo! <verse eid="GAL 2:17"/><verse number="18" style="v" sid="GAL 2:18"/>Ni ani yile ungwɔ ngwi ani teyi bulu mbɛ yɔ, i tso ambɛ gbɛɛ ani li inggisɛ ombe ola. <verse eid="GAL 2:18"/><verse number="19" style="v" sid="GAL 2:19"/>Bana mi ikpewo ola ani kwulu yi ola gbɛɛ n ki dzɛ oshishe ikye Imgbasho. <verse eid="GAL 2:19"/><verse number="20" style="v" sid="GAL 2:20"/>A gbokwo ani mi ekwatsi yi iKrestu ungwonyi; n dzɛ oshishe wuba, kpaa iKrestu dzɛ oshishe mbi ani. Oshishe ngwi ani dzɛ mi ewo onɛnɛ nɛ, n dzɛ li mi oyɛyɛ onuunu mbi Ongwɛ Imgbasho, ngwu ani kpaan itukwu di kye ewon nu mi ikye ani. <verse eid="GAL 2:20"/><verse number="21" style="v" sid="GAL 2:21"/>Ani kye elela mgbi Imgbasho dzɛkɛ enggengga ba, bana a ki li tu osaan mi ongyo ola yɔ, iKrestu kwulu mi itɔdzɛ ba!<verse eid="GAL 2:21"/></para>
  <chapter eid="GAL 2"/>
  <chapter number="3" style="c" sid="GAL 3"/>
  <para style="s1">Oyɛyɛ onuunu hona ongyo ola <optbreak/> mgbi iMose</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 3:1"/>Ikwangha inggisɛ emi iGalatia! Li emɛ ta ema untsɛ? Mi inɛ ema a kye iYesu iKrestu tso saan dafi a gbokwon mi ekwatsi mani. <verse eid="GAL 3:1"/><verse number="2" style="v" sid="GAL 3:2"/>I minɛn odifwi ungwɔ onyi ta mbi ema: Ema gbɛ Onodzi mgbi Imgbasho mi ikyegbɛɛ ema ngyo ola mgbi iMose naadi li ikye esɔ ngwi ema fwo diyɛ noyɛyɛ ma? <verse eid="GAL 3:2"/><verse number="3" style="v" sid="GAL 3:3"/>Ema yodzɛ ba nghadɛɛn? Ema wita yi Onodzi mgbi Imgbasho, ma onɛnɛ ema tsɛwɛ ongyɛlu mi ofyaafya mgbi emaa? <verse eid="GAL 3:3"/><verse number="4" style="v" sid="GAL 3:4"/>Ungwɔ ngwi ema gyadzɛ mi ele kpakpa nɛ li mi ayayi taa? Ema gyadzɛ labɔ ba. <verse eid="GAL 3:4"/><verse number="5" style="v" sid="GAL 3:5"/>Imgbasho nu ema Onodzi mgban di kyɔ ambɛ okwulewo mbi ema ikyegbɛɛ ema ngyo olaa? Ei yama li ngha ba! Li mi ikyegbɛɛ ema noyɛyɛ mi ungwɔ ngwi ema fwo mani.<verse eid="GAL 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 3:6"/>Li ngha Abrahan kpaa noyɛyɛ ngwi Imgbasho kwun gbɛɛ: &lt;&lt;O li inggisɛ osaan ikye oyɛyɛ onuunu mgban aali.&gt;&gt; <verse eid="GAL 3:6"/><verse number="7" style="v" sid="GAL 3:7"/>Nghanɛ, ye na gbɛɛ ali inggisɛ ndzɛ yi oyɛyɛ onuunu duu li ongwɛ Abrahan. <verse eid="GAL 3:7"/><verse number="8" style="v" sid="GAL 3:8"/>Lubana Afɛ mgbi Imgbasho teyi gbɔ dzɛsɛ gbɛɛ Imgbasho ka gbela yi Udzengye (ama nli emi iJuda ba) ikye oyɛyɛ onuunu mgbi ama, nɛ o teyi nya Abrahan dzɛsɛ gbɛɛ, &lt;&lt;Inggisɛ mi ali udzɛ duu ka gbumse mgbi ani mi ikpewo abu.&gt;&gt; <verse eid="GAL 3:8"/><verse number="9" style="v" sid="GAL 3:9"/>Nghanɛ ama ndzɛ yi oyɛyɛ onuunu duu Imgbasho nu ma mse ungwonyi yi Abrahan, inggisɛ onoyɛyɛ.<verse eid="GAL 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 3:10"/>Ama ngbeka dzɛ ongyo ola duu, a dzɛ yi ikamba ewo, bana a lɔ gbɛɛ: &lt;&lt;Ali inggisɛ ngwu ngyo ungwɔ ngwi a lɔ to Afɛ ola ba duu dzɛ yi ikamba.&gt;&gt; <verse eid="GAL 3:10"/><verse number="11" style="v" sid="GAL 3:11"/>Onɛnɛ i tso saan gbɛɛ inggisɛ onyi ka yagba gye emyɛmyɛ mbi Imgbasho mi ola ongyoongyo ba, ikyekyɛ &lt;&lt;Ama osaan ka dzɛ oshishe mi oyɛyɛ onuunu.&gt;&gt; <verse eid="GAL 3:11"/><verse number="12" style="v" sid="GAL 3:12"/>Ola li oyɛyɛ onuunu ba; nɛ, &lt;&lt;Inggisɛ ngwu ngyo ola ka dzɛ oshishe mi ele.&gt;&gt; <verse eid="GAL 3:12"/><verse number="13" style="v" sid="GAL 3:13"/>IKrestu dulu eyi tɔ mi ikamba mgbi ola mi ogbɛ ikamba mi ikye eyi, lubana Afɛ lɔ gbɛɛ: &lt;&lt;Ikamba no kwu ali inggisɛ ngwu a gbokwon mi ekwatsi.&gt;&gt; <verse eid="GAL 3:13"/><verse number="14" style="v" sid="GAL 3:14"/>O dulu eyi tɔ ikyegbɛɛ ni mse ngwi Imgbasho nu Abrahan na no ba mbi Udzengye kpaa mi ikpewo iKrestu iYesu, ikyegbɛɛ mi oyɛyɛ onuunu ni eyi gbɛ Onodzi ngwi Imgbasho zondu nani.<verse eid="GAL 3:14"/></para>
  <para style="s1">Ola bɛyi ondu odzɛɛdzɛ</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 3:15"/>Emi ongwunani, detse nin tso ema ambɛ mi odzɛɛdzɛ mgbi oshishe ongwi alegbe-alegbe. Dafi Inggisɛ onyi ka yagba kye mwalu hona mbwumbwo mi ondu odzɛɛdzɛ ntsekise dzɛsɛ ba nɛ, li ngha ngwi i dzɛ mi itɔdzɛ nɛ kpaa aali. <verse eid="GAL 3:15"/><verse number="16" style="v" sid="GAL 3:16"/>Ikyenghanɛ, Imgbasho nose zondu yi Abrahan bɛyi etɔ mgban. Afɛ lɔ gbɛɛ li &lt;&lt;Etɔ kwuba&gt;&gt; ba, kpaa ongwan onyi ta, nɛ i tso gbɛɛ li iKrestu joaali. <verse eid="GAL 3:16"/><verse number="17" style="v" sid="GAL 3:17"/>Ungwɔ n le gbɔ ma li ongwu aani: Ondu odzɛɛdzɛ ngwi Imgbasho teyi dzɛ yi Abrahan na, nyɛ mɛ onova ideli enɛ dɔn osudiwyo (430) duuse a wa kye ola nu iMose, nghanɛ ola ka yagba ndɛlu ondu odzɛɛdzɛ na ba. <verse eid="GAL 3:17"/><verse number="18" style="v" sid="GAL 3:18"/>Lubana ni okwudɛ ogyeegye li mi ola ongyoongyo yɔ, i tso gbɛɛ li mi ondu odzɛɛdzɛ wuba; kpaa Imgbasho mi elela mgban teyi kye nu Abrahan mi ondu odzɛɛdzɛ.<verse eid="GAL 3:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 3:19"/>Nghanɛ, oyabɔ mgbi ola li ekyɛ? A wa kye nu mi olɛlɛ ikye ali ibwubwe nghataa ba onɔ ngwi ongwɛ Abrahan ngwu a zondu ikyen na wa ba mani. Mi otsitsi, li engyesɔ kye ola nɛ nu iMose, se o kye nu inggisɛ. <verse eid="GAL 3:19"/><verse number="20" style="v" sid="GAL 3:20"/>Ongye okwabɔ odzɛ li kwudzɛ ikye inggisɛ agya onyi ba; nghaduu Imgbasho yɔ li onyi.<verse eid="GAL 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 3:21"/>Nghama ola mgbi iMose fwa ondu odzɛɛdzɛ mgbi Imgbashoo? Ei, lubadu! Ikyesinɛ ni ola ki li nu oshishe yɔ, osaan kika li mi ongyo ola. <verse eid="GAL 3:21"/><verse number="22" style="v" sid="GAL 3:22"/>Kpaa Afɛ gbɔ tɔ gbɛɛ inggisɛ owamyɛ duu woto obawi mgbi ali ibwubwe, ikyegbɛɛ ungwɔ ngwi a zondu okye nu mi oyɛyɛ onuunu ikpewo iYesu iKrestu ma, a ki kye nu ama onoyɛyɛ.<verse eid="GAL 3:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GAL 3:23"/>Duuse ni oyɛyɛ onuunu nɛ wa ba yɔ, ola gbe eyi tukwu mi obawi nghataa nu ma wa kye oyɛyɛ onuunu tsotɔ. <verse eid="GAL 3:23"/><verse number="24" style="v" sid="GAL 3:24"/>Nghanɛ a kye ola dzɛkɛ otso eyi ofɛ mbi iKrestu ikye ni eyi gye emyɛmyɛ mi oyɛyɛ onuunu. <verse eid="GAL 3:24"/><verse number="25" style="v" sid="GAL 3:25"/>Onɛnɛ dafi oyɛyɛ onuunu ba nɛ, eyi byidzɛ abɔ ola wuba.<verse eid="GAL 3:25"/></para>
  <para style="s1">Emi ongwɛ Imgbasho</para>
  <para style="p">
    <verse number="26" style="v" sid="GAL 3:26"/>Ema duu li emi ongwɛ Imgbasho mi oyɛyɛ onuunu mbi iYesu iKrestu, <verse eid="GAL 3:26"/><verse number="27" style="v" sid="GAL 3:27"/>bana ema ngwu a kyɔ ema iBatisima mbi iKrestu gbe iKrestu wo ewo dafi angwuto mani. <verse eid="GAL 3:27"/><verse number="28" style="v" sid="GAL 3:28"/>Idzidza dzɛ mbi emi iJuda naadi Udzengye wuba, ongwu nli ofyɛɛ hona ongwɛ ba, ongyulɔ naadi ongyaa ba, lubana ema duu li onyi mbi iYesu iKrestu. <verse eid="GAL 3:28"/><verse number="29" style="v" sid="GAL 3:29"/>Ni ema li mgbi iKrestu yɔ, ema li etɔ mgbi Abrahan, di li ama gyokwudɛ dafi a zondu mani.<verse eid="GAL 3:29"/></para>
  <chapter eid="GAL 3"/>
  <chapter number="4" style="c" sid="GAL 4"/>
  <para style="s1">Ɛngbɛ yi ama gyokwudɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 4:1"/>Odzɛ ngwi ani le gbɔ ma li ongwu aani, dafi alungwɔ duu li mgbi ongye gyokwudɛ nɛ kpaa ngwi o ka li ongbɛ jo, idzidza mgban yi ofyɛɛ dzɛma ba. <verse eid="GAL 4:1"/><verse number="2" style="v" sid="GAL 4:2"/>O ka byidzɛ abɔ ama odi mbon yi ama ongyon nghataa ba onɔ ngwi otsɔn kye dzɛ mani. <verse eid="GAL 4:2"/><verse number="3" style="v" sid="GAL 4:3"/>Li ngha ngwi i dzɛ yi eyi kpaa aali, onɔ ngwi eyi ka li ɛngbɛ mmafa ma, eyi wodzɛ adi mgbi ungwɔ ongwi ɛsɛ nɛni. <verse eid="GAL 4:3"/><verse number="4" style="v" sid="GAL 4:4"/>Kpaa ngwi onɔ wa gyɔ yɛyɛ nɛ, Imgbasho kye Ongwan dɛsɔ ni ongyaa wa mban, a mban mi abɔ ola mgbi iMose, <verse eid="GAL 4:4"/><verse number="5" style="v" sid="GAL 4:5"/>owa dulu ama nto mi abɔ ola na tɔ, ikye ni eyi tu ofɛ saan oyɛɛ engwɛ Imgbasho. <verse eid="GAL 4:5"/><verse number="6" style="v" sid="GAL 4:6"/>Ikyegbɛɛ ema li engwɛ nɛ, Imgbasho kye Onodzi mgbi Ongwan dɛsɔ wa kaka itukwu mgbi eyi, Onodzi nkwu ela gbɛɛ, &lt;&lt;Otsɔ, Otsani nani.&gt;&gt; <verse eid="GAL 4:6"/><verse number="7" style="v" sid="GAL 4:7"/>Nghanɛ abu li ofyɛɛ wuba, kpaa ongwɛ; ma dafi abu li ongwɛ nɛ, Imgbasho nu abu kpaa yɛɛ ongye gyokwudɛ.<verse eid="GAL 4:7"/></para>
  <para style="s1">Oweka mgbi iPol ikye emi iGalatia</para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 4:8"/>Tugbe ngwi ema ye Imgbasho waba ma, ema li ofyɛɛ mgbi onodzi emi otsitsi ba ntonani. <verse eid="GAL 4:8"/><verse number="9" style="v" sid="GAL 4:9"/>Nghaduu onɛnɛ ngwi ema wa ye Imgbasho, ngwi Imgbasho kpaa di ye ema nɛ, i kyɔnɛ ngwi ema dile kyata lu mbi onodzi ama oshɛshɛ ongwi ɛsɛ nɛ? Ema mina odi yɛɛ ofyan naadi? <verse eid="GAL 4:9"/><verse number="10" style="v" sid="GAL 4:10"/>Ema le nghao gbɛwɛdzɛ egbe yi ofyia bɛyi iyɛ ungwɔ yi onova! <verse eid="GAL 4:10"/><verse number="11" style="v" sid="GAL 4:11"/>Imio wo ani yi ema, i dzɛ dafi ofyaafya mgbi ani ikye ema duu weeni mani.<verse eid="GAL 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 4:12"/>Emi ongwunani, n tɛkyɛ nu ema, yɛɛ dafi ani na, bana ani yɛɛ dafi ema. Ema kyɔ ani obube onyonyi ba. <verse eid="GAL 4:12"/><verse number="13" style="v" sid="GAL 4:13"/>Dafi ema ye ma, ani dzɛ mi ootse onɔ ngwi ani gbɔ Esɔ Osuse nya ema ababɔ mani. <verse eid="GAL 4:13"/><verse number="14" style="v" sid="GAL 4:14"/>Ootse mgbi ani nose li undo mbi ema, nghaduu, ema di ani tsiidza hona fwa ani ba. Kpaa, ema gbɛ ani dafi ema kika gbɛ ongyesɔ mgbi Imgbasho mani; ema gbɛ ani dafi ani li iYesu iKrestu abuon. <verse eid="GAL 4:14"/><verse number="15" style="v" sid="GAL 4:15"/>Atsa ndzɛ ema nose ma kɔ onɛnɛ? N ka kyɔ obwɛndɛ gbɛɛ ni ema ki kyɔ ngha yɔ, ema kika todulu inɛ mgbi ema gbe nu ani. <verse eid="GAL 4:15"/><verse number="16" style="v" sid="GAL 4:16"/>Ani yɛɛ ongyikyili mgbi ema onɛnɛ ikyegbɛɛ di ani nya ema otsitsii?<verse eid="GAL 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 4:17"/>Inggisɛ ntona dzɛ yi oweka ogbe ema luba agya mboma, kpaa li mi mse ba. Ungwɔ ngwi a mina li ogha ema bɛyi eyi, ikyegbɛɛ ni ema kye itukwu byi mboma. <verse eid="GAL 4:17"/><verse number="18" style="v" sid="GAL 4:18"/>I tishi ofyumfye itukwu ni itɔdzɛ ma li osuse yɔ, odi dzɛ ngha alonɔ duu, no ka li onɔ ngwi ani dzɛ yi ema ta ba. <verse eid="GAL 4:18"/><verse number="19" style="v" sid="GAL 4:19"/>Emi ongwani osuse, dafi imba li wulu onɔngwɛ nɛ, li ngha ngwi i le wulu ani ikye ema aani, nghataa sede odzɛɛdzɛ mgbi iKrestu na ka gyutɔ mbi ema. <verse eid="GAL 4:19"/><verse number="20" style="v" sid="GAL 4:20"/>I dzɛ ani gbɛɛ ani ki dzɛ yi ema onɛnɛ di kyata ali yi ema, ikyekyɛ i kaka ani ewo mi odzɛ mgbi ema saan!<verse eid="GAL 4:20"/></para>
  <para style="s1">IHaga bɛyi iSara</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 4:21"/>Nya ani na, ema ama nmina odzɛ abɔ ola mgbi iMose mani, ema ye ungwɔ ngwi ola na gbɔ lo? <verse eid="GAL 4:21"/><verse number="22" style="v" sid="GAL 4:22"/>Bana a lɔ gbɛɛ Abrahan nose dzɛ yi engwengyulɔ efa, onyi mbi ongyaa nli ofyɛɛ, oka ma li mbi ongyaa nli owan yɛyɛ mani. <verse eid="GAL 4:22"/><verse number="23" style="v" sid="GAL 4:23"/>Ongwan mbi ofyɛɛ ma, a mban dafi ali inggisɛ mani; kpaa ongwan mbi owan yɛyɛ na, a mban mi ondu odzɛɛdzɛ mgbi Imgbasho.<verse eid="GAL 4:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="GAL 4:24"/>Ungwɔntonɛ li otso ambɛ ta, engyaa ntonɛ gbikye ondu odzɛɛdzɛ nghi efa. Ondu odzɛɛdzɛ oka kyɛ mi Unggwɔ mgbi iSinai imbe ngwi a kye ola mgbi iMose nu nani, emi ongwan duu li ofyɛɛ. Nana li ondu odzɛɛdzɛ mgbi iHaga joaali. <verse eid="GAL 4:24"/><verse number="25" style="v" sid="GAL 4:25"/>Nghanɛ iHaga dzɛ dafi Unggwɔ mgbi iSinai mi Arabia mani, o gbikye ogalu iJerosalin ongwi onɛnɛni, ikyekyɛ iJerosalin dzɛ mi ofyɛɛ yi ɛngbɛ mgban duu. <verse eid="GAL 4:25"/><verse number="26" style="v" sid="GAL 4:26"/>Nghaduu iJerosalin ongwi esho li ofyɛɛ ba, di li onɔ eyi aali. <verse eid="GAL 4:26"/><verse number="27" style="v" sid="GAL 4:27"/>Bana a lɔ mi Afɛ gbɛɛ:</para>
  <para style="q1" vid="GAL 4:27">&lt;&lt;Abu ongyaa ogyoma, dzɛ yi atsa,</para>
  <para style="q2" vid="GAL 4:27">abu mba engwɛ ba,</para>
  <para style="q1" vid="GAL 4:27">tsatsa mi ela okwukwo,</para>
  <para style="q2" vid="GAL 4:27">abu n ye owulewo mgbi imba ba nani;</para>
  <para style="q1" vid="GAL 4:27">ikyekyɛ ongyaa ndzɛ yi ɛngbɛ kwuba na dzɛ</para>
  <para style="q2" vid="GAL 4:27">yi isɔ ngha ongyaa ogyoma ndzɛ yi oban mani.&gt;&gt; <note caller="+" style="f"><char style="fr" closed="false">4:27 </char><char style="ft" closed="false">Di gbɔ mi: </char><char style="xt"><ref loc="ISA 54:1">Adza 54:1</ref></char>.</note><verse eid="GAL 4:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GAL 4:28"/>Nghanɛ emi ongwunani, dafi Adziki ongwɛ iSara li ongwɛ ondu odzɛɛdzɛ na, li ngha ngwi ema kpaa dzɛ onɛnɛ aani. <verse eid="GAL 4:28"/><verse number="29" style="v" sid="GAL 4:29"/>Mi onɔ na ongwɛ ngwi iHaga mba dafi inggisɛ owamyɛ ma nu ongwɛ ngwu a mba mi ondu odzɛɛdzɛ na isɔ kpakpa. Li ngha ndzɛ onɛnɛ kpaa aani. <verse eid="GAL 4:29"/><verse number="30" style="v" sid="GAL 4:30"/>Nghaduu li ekyɛ ngwi a lɔ mi Afɛ mgbi Imgbasho? &lt;&lt;Lɔ ongyaa ofyɛɛ na yi ongwan onya, lubana ongwɛ mgbi ofyɛɛ no ka gyokwudɛ yi ongwɛ mgbi ongyaa udɛ yɛyɛ na badu.&gt;&gt; <verse eid="GAL 4:30"/><verse number="31" style="v" sid="GAL 4:31"/>Ikyenghanɛ, emi ongwunani, eyi li engwɛ ongyaa ofyɛɛ ba, kpaa li mgbi ongyaa udɛ yɛyɛ.<verse eid="GAL 4:31"/></para>
  <chapter eid="GAL 4"/>
  <chapter number="5" style="c" sid="GAL 5"/>
  <para style="s1">Omyɛɛ-myɛɛ mi iKrestu</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 5:1"/>Li mi ikye omyɛɛ-myɛɛ ngwi iKrestu dulu eyi tɔ. Nghanɛ kwudzɛ kpɔklɔɔ, dika nu ewema yɛɛ ofyɛɛ mgbi ola mgbi iMose ba na.<verse eid="GAL 5:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="GAL 5:2"/>Gbɛwɛdzɛ odzɛ mgbi ani na, ani iPol nya ema gbɛɛ ni ema nu ma kyɛ ema ikyɛ yɔ, i tso gbɛɛ iKrestu dzɛ yi ema oyabɔ wuba du. <verse eid="GAL 5:2"/><verse number="3" style="v" sid="GAL 5:3"/>N di nya ali inggisɛ mi ododa gbɛɛ, inggisɛ nnu ma kyan ikyɛ yɔ, i yɛɛ kyɛmɛ ngwi o ka ngyo ola na duu. <verse eid="GAL 5:3"/><verse number="4" style="v" sid="GAL 5:4"/>Ema nle fya ongyo ola mgbi iMose duu ma, a gha ema yi iKrestu wa; ema ka tu elela mgbi Imgbasho ba. <verse eid="GAL 5:4"/><verse number="5" style="v" sid="GAL 5:5"/>Nghaduu Onodzi mgbi Imgbasho nu eyi ye saan gbɛɛ Imgbasho ka gbɛ eyi dafi emi onyaan mani, ikyekyɛ eyi noyɛyɛ mbi iKrestu. <verse eid="GAL 5:5"/><verse number="6" style="v" sid="GAL 5:6"/>Lubana mi ifu iYesu iKrestu yɔ, ikyɛ okyɛɛkyɛ hona ikyɛ okyɛɛkyɛ ba dzɛ yi oyabɔ onyi ba. Li oyɛyɛ onuunu nli tso ewon tɔ mi okpitukwu na ta dzɛ yi oyabɔ.<verse eid="GAL 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 5:7"/>Ema nose le kyɔ saan. Li emɛ wa kaka ema idzidzɛ ni ema le kyɔ otsitsi wuba? <verse eid="GAL 5:7"/><verse number="8" style="v" sid="GAL 5:8"/>Itɔ otuutuwo na kyɛ mbi Imgbasho ongwu nkwu ema ela na ba. <verse eid="GAL 5:8"/><verse number="9" style="v" sid="GAL 5:9"/>&lt;&lt;Ongwɛ okwuna gwee li gbɛ ofumbu sɔ.&gt;&gt; <verse eid="GAL 5:9"/><verse number="10" style="v" sid="GAL 5:10"/>Ani dzɛ yi abɔ otsigɛgɛ mbi Otsɛ iYesu gbɛɛ ema ka gbɛ ewodzɛ oka idzidza ba. Inggisɛ nle kye ema wɛndɛ ma a ka kwon adɔ, ki non li emɛmɛ kpaa. <verse eid="GAL 5:10"/><verse number="11" style="v" sid="GAL 5:11"/>Emi ongwunani, ni ani kale gbeesɔ mi odzɛ ikyɛ okyɛɛkyɛ nghataa ba onɛnɛ ma, kyɔnɛ ngwi a kale nu ani isɔ? Ki li ngha yɔ, esɔ ekwatsi ngwi ani le gbɔ ki ba yi ani okakewo ba. <verse eid="GAL 5:11"/><verse number="12" style="v" sid="GAL 5:12"/>I mina ani gbɛɛ ama nle kaka ema ewo ma, nu ma kiyayi owo ewoma elozu.<verse eid="GAL 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 5:13"/>Ema, emi ongwunani, a kwu ema ela gbɛɛ ni ema dzɛ myɛɛmyɛɛ. Kpaa ka kye omyɛɛ-myɛɛ mgbi ema yɛɛ okaka ungwɔ obube okyɔɔkyɔ ba; tatase yɔ kyɔ ewema idɔ mi okpitukwu. <verse eid="GAL 5:13"/><verse number="14" style="v" sid="GAL 5:14"/>Bana a kye bwalu ola duu yɛɛ onyi gbɛɛ: &lt;&lt;Di inggisɛ nwatse dɔ abu kpa abu itukwu dafi ewabu mani.&gt;&gt; <verse eid="GAL 5:14"/><verse number="15" style="v" sid="GAL 5:15"/>Ni ema le kiyayi ola ewema aba dile tangha ewema yɔ, gbɛwɛbyi na bana ema ka dzili ewema.<verse eid="GAL 5:15"/></para>
  <para style="s1">Oshishe ongwi Onodzi</para>
  <para style="p">
    <verse number="16" style="v" sid="GAL 5:16"/>Nghanɛ n gbɛɛ, ni Onodzi mgbi Imgbasho kye ema teyi, ta ema kale kyungwɔ ngwi imina ibwubwe mgbi mmbwɛ yi eyi mina ma wuba. <verse eid="GAL 5:16"/><verse number="17" style="v" sid="GAL 5:17"/>Bana imina ibwubwe mgbi ewo li gbela yi imina mgbi Onodzi mgbi Imgbasho ba, imina mgbi Onodzi na kpaa li gbela yi imina ibwubwe mgbi ewo ba. A li dzɛ gblɔgblɔ yi ewoma alonɔ duu, ikyegbɛɛ ni ema ka kyungwɔ ngwi ema mina ma ba. <verse eid="GAL 5:17"/><verse number="18" style="v" sid="GAL 5:18"/>Nghaduu kini Onodzi Imgbasho kye ema le teyi yɔ, ema byidzɛ abɔ ola ba.<verse eid="GAL 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 5:19"/>Okyɔɔkyɔ mgbi imina ibwubwe mgbi mmbwɛ yi eyi li ama aani: okyɔ amah yi ungwɔ ama okpɛkpɛ, ungwɔ ayiwi; <verse eid="GAL 5:19"/><verse number="20" style="v" sid="GAL 5:20"/>osunu angwula, okyɔ mtsɛ, okyili inggisɛ, ogblibe, okyɔ inggisɛ ogye, itingga okyɔɔkyɔ, oye ewabu yuwoo, odi ba yi ogbua-gbua, <verse eid="GAL 5:20"/><verse number="21" style="v" sid="GAL 5:21"/>okyoofu, ɛbyɛ ofyaafya, okwakye ngwi ungwɔ obube she mi ele bɛyi ungwɔ angbeka. N kwo ema adɔ, dafi ani teyi kyɔ mani, gbɛɛ ama nle kyɔ ngha ka gyokwudɛ esutɔ mgbi Imgbasho ba.<verse eid="GAL 5:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GAL 5:22"/>Kpaa owawa mgbi Onodzi mgbi Imgbasho li okpitukwu, atsa, iyu, itukwu oshiishi, itukwu osuse, okyɔ osuse, oyɛyɛ okyɔɔkyɔ, <verse eid="GAL 5:22"/><verse number="23" style="v" sid="GAL 5:23"/>odzɛ shilididi bɛyi obwalu ewo fyii. Ola fwa itɔ ungwɔ ntonɛ ba. <verse eid="GAL 5:23"/><verse number="24" style="v" sid="GAL 5:24"/>Ama nli mgbi iYesu iKrestu kye odzɛɛdzɛ atta ibwubwe mgbi ama yi nggwɔ yi imina duu gbokwo ekwatsi. <verse eid="GAL 5:24"/><verse number="25" style="v" sid="GAL 5:25"/>Dafi Onodzi mgbi Imgbasho nu eyi oshishe nɛ, ba ni eyi kyɛdɔ Onodzi na. <verse eid="GAL 5:25"/><verse number="26" style="v" sid="GAL 5:26"/>Ni eyi ka kyile ewo esho yi eka, naadi le nu eweyi itukwu owulu-wulu, hona kyoofu yi ewee ba.<verse eid="GAL 5:26"/></para>
  <chapter eid="GAL 5"/>
  <chapter number="6" style="c" sid="GAL 6"/>
  <para style="s1">Okyɔ osuse yi ali inggisɛ duu</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 6:1"/>Emi ongwunani, kini inggisɛ gbɛsɛ mi ungwɔ obube yɔ, ema ngwu dzɛ kpɔklɔɔ mi Onodzi mgbi Imgbasho ma yilen dzɛ ofɛ dumɔɔ. Nghaduu gbɛwɛbyi ewema na, bana ema kpaa wa gbɛsɛ mi imbadi. <verse eid="GAL 6:1"/><verse number="2" style="v" sid="GAL 6:2"/>Ya eka abɔ mi okakewo mgbi ewema na, mi itɔ ofɛ nɛ ema le kyɔ ola mgbi iKrestu. <verse eid="GAL 6:2"/><verse number="3" style="v" sid="GAL 6:3"/>Kini inggisɛ tsɛwɛ gbɛɛ ongwu li ungwɔ ngwi o li unkonyi bayɔ, o kpagya ewon wo. <verse eid="GAL 6:3"/><verse number="4" style="v" sid="GAL 6:4"/>Ali inggisɛ no mbadi okyɔɔkyɔ mgban. Ki non tishi yɔ, o ka dzɛ yi abɔ otsigɛgɛ di kye ewon mba yi inggisɛ oka badu, <verse eid="GAL 6:4"/><verse number="5" style="v" sid="GAL 6:5"/>lubana ali inggisɛ no kye okye mgban abuon.<verse eid="GAL 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 6:6"/>Ali inggisɛ ngwu a tson ungwɔ yɔ, li kyɛmɛ no gha ungwɔ osuse yi inggisɛ ntson nani.<verse eid="GAL 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 6:7"/>Ka kpagya ewema wo ba: Inggisɛ ka yagba nya Imgbasho agya ba. Inggisɛ li shɛ etɔ ngwi o kya mani. <verse eid="GAL 6:7"/><verse number="8" style="v" sid="GAL 6:8"/>Inggisɛ nkyɛdɔ imina ibwubwe mgbi mmbwɛ yi eyi yɔ, ka shɛ odzili-dzili; ongwu nkyɛdɔ Onodzi mgbi Imgbasho yɔ, mi Onodzi o ka shɛ oshishe ogyegwu. <verse eid="GAL 6:8"/><verse number="9" style="v" sid="GAL 6:9"/>Ni eyi ka ndɛ yi osuse okyɔɔkyɔ ba, bana eyi kawa shɛ etɔ osuse mi onɔ yɛyɛ ni eyi yɛyikpa bayɔ.<verse eid="GAL 6:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 6:10"/>Nghanɛ, dafi eyi tu ofɛ nɛ, ni eyi kyɔ osuse yi inggisɛ duu, onghaangha duu mbi ama ndzɛ mi etɔ mgbi ama onoyɛyɛ mani.<verse eid="GAL 6:10"/></para>
  <para style="s1">Li ikyɛ ba kpaa otaata ofufɛ</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 6:11"/>Di ambɛ olungwɔ gbadagbada ngwi ani lɔ mi abɔ mgbi ani kɛ mbi ema nɛni!<verse eid="GAL 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 6:12"/>Ama nmina okye ewoma tso mi ikpewo gbɛɛ ama li osuse ma, tole fya osi ema gbɛɛ ni ema kyiikyɛ. Itɔdzɛ ngwi a le kyungwɔnɛ ma li ikyegbɛɛ ni ama ka gbiisɔ ikye ekwatsi mgbi iKrestu ba. <verse eid="GAL 6:12"/><verse number="13" style="v" sid="GAL 6:13"/>Ama nkyiikyɛ kpaa ngyo ola tsatsa ba, nghaduu a mina gbɛɛ ni ema kyiikyɛ ikye ni ama tsaabɔ igɛgɛ mi ikpewo ema. <verse eid="GAL 6:13"/><verse number="14" style="v" sid="GAL 6:14"/>Nghaduu n ka yama tsaabɔ igɛgɛ mi unkonyi ba, sede mi ekwatsi mgbi Otsɛ iYesu iKrestu mgbi eyi ta. Mi odzɛ ekwatsi na yɔ, ɛsɛ kwulu ikye ani, ani kpaa kwulu ikye ɛsɛ. <verse eid="GAL 6:14"/><verse number="15" style="v" sid="GAL 6:15"/>Ikyɛ okyɛɛkyɛ hona ikyɛ okyɛɛkyɛ ba tso unkonyi ba; ungwɔ nwuuta li atta ofufɛ. <verse eid="GAL 6:15"/><verse number="16" style="v" sid="GAL 6:16"/>Iyu yi elela odiidi no dzɛ yi ama nkyɛdɔ ola nɛ bɛyi emidi Imgbasho duu.<verse eid="GAL 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 6:17"/>Ongyɛɛngyɛ yɔ, ni inggisɛ onyi ka ba yi ani okakewo ba, ikyena ani dzɛ yi ambɛ mgbi iYesu mi ewo.<verse eid="GAL 6:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 6:18"/>Emi ongwunani, ni elela mgbi Otsɛ mgbi eyi iYesu iKrestu dzɛ yi onodzi mgbi ema. No dzɛ ngha.<verse eid="GAL 6:18"/></para>
  <chapter eid="GAL 6"/>
</usx>
