<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1TH" style="id">- Etulo</book>
  <para style="h">1 Emi iTesalonika</para>
  <para style="toc1">Afɛ mgbi iPol ongwi ababɔ mbi ama onoyɛyɛ Emi iTesalonika</para>
  <para style="toc2">1 Emi iTesalonika</para>
  <para style="toc3">1EiTe</para>
  <para style="mt2">Afɛ mgbi iPol ongwi ababɔ<optbreak/> mbi ama onoyɛyɛ</para>
  <para style="mt1">Emi iTesalonika</para>
  <chapter number="1" style="c" sid="1TH 1"/>
  <para style="p">
    <verse number="1" style="v" sid="1TH 1:1"/>IPol yi iSaila bɛyi iTimoti lɔ Afɛ nɛ,</para>
  <para style="p" vid="1TH 1:1">Le kɛ mbi okwakye emi iKrestu mi iTesalonika, emidi Otsɛ Imgbasho bɛyi Otsɛ iYesu iKrestu:</para>
  <para style="p" vid="1TH 1:1">Ni elela bɛyi iyu dzɛ yi ema duu.<verse eid="1TH 1:1"/></para>
  <para style="s1">Angba ota-ta mi ikye oyɛyɛ onuunu <optbreak/> mgbi emi iTesalonika</para>
  <para style="p">
    <verse number="2" style="v" sid="1TH 1:2"/>Eyi li ta Imgbasho angba mi ikye ema alonɔ duu, di kwu iyi ema mi ibɔ mgbi eyi. <verse eid="1TH 1:2"/><verse number="3" style="v" sid="1TH 1:3"/>Eyi li le wɛ alonɔ mi inai Otseyi Imgbasho odzɛ idɔ ntɔ mi oyɛyɛ onuunu mgbi ema yi ongwi nkyɛ mi okpitukwu kpaa nani, bɛyi itukwu oshiishi mgbi ema ngwi ema tu mi eka ogbe byiibyi mbi Otseyi iYesu iKrestu nani.<verse eid="1TH 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1TH 1:4"/>Emi okani osuse, ema kpa Imgbasho itukwu, eyi di ye o dulu ema gbɛɛ ni ema li emidan, <verse eid="1TH 1:4"/><verse number="5" style="v" sid="1TH 1:5"/>ikyekyɛ Esɔ Osuse mgbi eyi ba mbi ema li mi elodzɛ ayayi ta ba, kpaa li mi mfye mgbi Imgbasho bɛyi Onodzi Osaan bɛyi okyata-kyata ongwi itukwu. Ema ye itɔ inggisɛ ngwu eyi dzɛ nose, bɛyi abɔ ngwi eyi ya ema mani. <verse eid="1TH 1:5"/><verse number="6" style="v" sid="1TH 1:6"/>Ema kye afɔ eyi bɛyi Otsɛ iYesu; dafi ema nose le gyadzɛ kpakpa nɛ kpaa, ema gbɛ esɔ nɛ yi atsa ongwi Onodzi Osaan kye nu ema mani. <verse eid="1TH 1:6"/><verse number="7" style="v" sid="1TH 1:7"/>Ma ema di yɛɛ ambɛ mbi ama onoyɛyɛ mi iMasidonia bɛyi Acaya duu. <verse eid="1TH 1:7"/><verse number="8" style="v" sid="1TH 1:8"/>Esɔ mgbi Imgbasho tɔ mbi ema gbɔfwɛ kpaa i tasɛ li mi iMasidonia yi Acaya ta ba, kpaa oyɛyɛ onuunu mgbi ema mbi Imgbasho yɛɛ ungwɔ ngwi a yen kpatsɛ ali imbe duu. Nghawanɛ eyi mina ogbɔdzɛ onyonyi mi efu ba, <verse eid="1TH 1:8"/><verse number="9" style="v" sid="1TH 1:9"/>lubana ama abuoma gbɔ itɔ ogbɛ-gbɛ ngwi ema gbɛ eyi mani. A gbɔ dafi ema kyata ba mbi Imgbasho dzata emi angwula ikye osunu Imgbasho oshishe yi otsitsi mani. <verse eid="1TH 1:9"/><verse number="10" style="v" sid="1TH 1:10"/>Ema di fɛ Ongwan ongwu nkyɛ mi adopo, ongwu o kyilen mi ikwu; nli iYesu, ongwu nnagbɛ eyi mi itingga nkyɛ le ba nani.<verse eid="1TH 1:10"/></para>
  <chapter eid="1TH 1"/>
  <chapter number="2" style="c" sid="1TH 2"/>
  <para style="s1">Idɔ mgbi iPol mi iTesalonika</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 2:1"/>Emi ongwunani, ema ye gbɛɛ okɛɛkɛ mgbi eyi mbi ema wɛɛsɛ ba. <verse eid="1TH 2:1"/><verse number="2" style="v" sid="1TH 2:2"/>Eyi teyi gyadzɛ di gbɛ ito mi iFyilipi, dafi ema ye nani, nghaduu yi abɔ oyaaya mgbi Imgbasho mgbi eyi yɔ, ngwi a fwa eyi kpakpa nɛ kpaa, eyi yɛyikpa onya ema Esɔ Osuse ba. <verse eid="1TH 2:2"/><verse number="3" style="v" sid="1TH 2:3"/>Lubana ekyɛ mgbi eyi otooto yi ema kyɛ mi ɛndɛ hona oweka obube naadi eyi le fya okyɔ ema ikwangha ewo kpaa ba. <verse eid="1TH 2:3"/><verse number="4" style="v" sid="1TH 2:4"/>Nghaduu eyi le gbɔdzɛ dafi ama ngwu Imgbasho sadu ma di kye Esɔ Osuse wo ma abɔ. Eyi le fya okyungwɔ okpa inggisɛ owamyɛ ba kpaa li Imgbasho, ongwu nli di itukwu mgbi eyi nani. <verse eid="1TH 2:4"/><verse number="5" style="v" sid="1TH 2:5"/>Ema ye, eyi le fyumfya ondu yi ema ba. Imgbasho li obwɛndɛ gbɛɛ eyi kyɔ nggwɔ ba. <verse eid="1TH 2:5"/><verse number="6" style="v" sid="1TH 2:6"/>Eyi le mina otsɛɛtsɛ mbi inggisɛ ba, mbi ema ba naadi inggisɛ oka mbeka kpaa ba.</para>
  <para style="p" vid="1TH 2:6">Dafi ama ogbikye iKrestu nɛ, eyi kika yɛɛ okye mbi ema, <verse eid="1TH 2:6"/><verse number="7" style="v" sid="1TH 2:7"/>nghaduu eyi kwu blii mi idzidzɛ ema, dafi onɔngwɛ li kyinɛbyi ɛngbɛ mgban ama oshilɛlɛ mani. <verse eid="1TH 2:7"/><verse number="8" style="v" sid="1TH 2:8"/>Ema kpa eyi itukwu kpakpa, nghanɛ eyi dzɛ yi atsa okye ghalu Esɔ Osuse mgbi Imgbasho yi oshishe mgbi eyi kpaa yi ema, ikyesinɛ ema yɛɛ abugye mgbi eyi itukwu-tukwu. <verse eid="1TH 2:8"/><verse number="9" style="v" sid="1TH 2:9"/>Emi ongwuneyi, otsitsi ema wɛ idɔ bɛyi adzɛ mgbi eyi mbi ema wulo? Eyi kyidɔ otu yi onɔ ikyegbɛɛ ni eyi ka yɛɛ okye mbi inggisɛ onyi ba mi onɔ ngwi eyi gbɔ Esɔ Osuse mgbi Imgbasho nya ema mani.<verse eid="1TH 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1TH 2:10"/>Ema li obwɛndɛ, di li ngha Imgbasho kpaa li obwɛndɛ, mi ofɛ ngwi eyi le saan, le nyaan, di dzɛ yi idza ewo ba mi onɔ ngwi eyi dzɛ yi ema ama onoyɛyɛ mani. <verse eid="1TH 2:10"/><verse number="11" style="v" sid="1TH 2:11"/>Lubana ema ye dafi eyi kyɔ yi ali inggisɛ mgbi ema dafi otsɔngwɛ li kyɔ yi emi ongwan mani. <verse eid="1TH 2:11"/><verse number="12" style="v" sid="1TH 2:12"/>Eyi le kwu ema ɛwɛ wo, le gyila ema di wɛ ema odzɛ gbɛɛ ni ema dzɛ mi oshishe nmɛ mbi Imgbasho, ongwu nkwu ema ela kaka esutɔ bɛyi okwɔkwɔ mgban nani.<verse eid="1TH 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 2:13"/>Ma eyi abueyi kpaa le kiyayi ota Imgbasho angba ikyesinɛ, onɔ ngwi ema fwo elodzimgbasho mbi eyi ma, ema gbela yan dafi elodzɛ nkyɛ mbi inggisɛ ba, kpaa mbi Imgbasho abuon, lubana li Imgbasho na le kyidɔ mbi ama nnoyɛyɛ aali. <verse eid="1TH 2:13"/><verse number="14" style="v" sid="1TH 2:14"/>Emi ongwuneyi, ema yɛɛ ama ogbama okwakye emi iKrestu mgbi Imgbasho mi iJudia, ama nto mbi iYesu iKrestu mani. Ema gyadzɛ mi abɔ emidi ema ungwonyi dafi okwakye emi iKrestu ntona gyadzɛ mi abɔ emi iJuda nani. <verse eid="1TH 2:14"/><verse number="15" style="v" sid="1TH 2:15"/>Emi iJuda ntona ngwɔ Otsɛ iYesu bɛyi ama ogbɛɛsɛ mgbi Imgbasho, diyɛ lɔ eyi onya tasɛ mi ɛsɛ mgbi ama. A kyungwɔ okpa Imgbasho ba, a di dzɛ yi anyi yi ali inggisɛ duu. <verse eid="1TH 2:15"/><verse number="16" style="v" sid="1TH 2:16"/>A di fya otukwu eyi ofɛ ogbɔ Esɔ Osuse mgbi owatɔ-watɔ nya Udzengye ikye nu ma ka watɔ mi itingga mgbi Imgbasho ba. Mi okyɔ nghanɛ, ali ibwubwe mgbi ama kɛ byulu. Onɛnɛ ikamba mgbi Imgbasho dɔ ma ikye.<verse eid="1TH 2:16"/></para>
  <para style="s1">IPol mina odi emi iTesalonika</para>
  <para style="p">
    <verse number="17" style="v" sid="1TH 2:17"/>Emi ongwunani, onɔ ngwi a wa gbua eyi yi ema mi ongwonɔ gwee ma, (li mi ewo ta, li mi ɛwɛ otsɛɛtsɛ ba), mi ofyaafya mgbi eyi, eyi fya mi ali ofɛ duu gbɛɛ ni eyi di ema. <verse eid="1TH 2:17"/><verse number="18" style="v" sid="1TH 2:18"/>Lubana eyi mina oba mbi ema; onghaangha duu yɔ, ani iPol, fya diyɛ fya, kpaa iSatan nu eyi ofɛ ba.<verse eid="1TH 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1TH 2:19"/>Lubana li ema li ɛwɛ ogbe byiibyi mgbi eyi, atsa mgbi eyi, bɛyi okpapyi ngwi eyi kawa kwɔ mi inɛ Otsɛ mgbi eyi iYesu mi onɔ ngwi o kawa ba ma baa? <verse eid="1TH 2:19"/><verse number="20" style="v" sid="1TH 2:20"/>Mi otsitsi yɔ, ema li okwɔkwɔ bɛyi atsa mgbi eyi.<verse eid="1TH 2:20"/></para>
  <chapter eid="1TH 2"/>
  <chapter number="3" style="c" sid="1TH 3"/>
  <para style="p">
    <verse number="1" style="v" sid="1TH 3:1"/>Ta ngwi eyi yagba okye afɔ twɛsɛ mi ele gbɛ wuba nɛ, eyi gbela abueyi tila tokɛ Atɛn yueyi. <verse eid="1TH 3:1"/><verse number="2" style="v" sid="1TH 3:2"/>Eyi dɔ iTimoti ongwuneyi esɔ mbi ema, o di li inggisɛ idɔ mgbi Imgbasho ogbɔfwɛ Esɔ Osuse mgbi iKrestu. Eyi dɔn esɔ no ka fyi ema mfyitukwu di kwu ema ɛwɛ wo mi oyɛyɛ onuunu mgbi ema, <verse eid="1TH 3:2"/><verse number="3" style="v" sid="1TH 3:3"/>ikyegbɛɛ ni itukwu ka sha inggisɛ onyi mgbi ema anyɛ ikye imbadi ntonɛ ba. Ema ye saan gbɛɛ okakewo ntona teyi to ikye eyi. <verse eid="1TH 3:3"/><verse number="4" style="v" sid="1TH 3:4"/>Odzimɔ, onɔ ngwi eyi to yi ema ma, eyi li le nya ema alonɔ gbɛɛ a kawa nu eyi isɔ, di li ngha yɛyɛ ngwi i wa dzɛ, dafi ema ye saan nɛni. <verse eid="1TH 3:4"/><verse number="5" style="v" sid="1TH 3:5"/>Ngwi ani yagba fwo mbi ema wuba nɛ, ani dɔ iTimoti esɔ oka kya di mi oyɛyɛ onuunu mgbi ema. Ani mio gbɛɛ kaba iSatan wa mbadi ema ta adzɛ mgbi eyi ka labɔ.<verse eid="1TH 3:5"/></para>
  <para style="s1">Esɔ okwɛwɛwo mgbi iTimoti</para>
  <para style="p">
    <verse number="6" style="v" sid="1TH 3:6"/>Nghanɛ iTimoti kwa yɛ mbi ema ba mbi eyi onɛnɛ aani, o di ba yi eyi elodzɛ osuse mgbi oyɛyɛ onuunu bɛyi okpitukwu mgbi ema. O nya eyi gbɛɛ alonɔ duu ema li le tsɛwɛ osuse mi ikye mgbi eyi dile mina odi eyi, yɛyɛ dafi eyi kpa mina odi ema nɛni. <verse eid="1TH 3:6"/><verse number="7" style="v" sid="1TH 3:7"/>Inghawanɛ, emi ongwunani, mi okakewo mgbi eyi bɛyi isɔ ngwi a nu eyi duu ema nu eyi abɔ otsigɛgɛ mi oyɛyɛ onuunu mgbi ema. <verse eid="1TH 3:7"/><verse number="8" style="v" sid="1TH 3:8"/>Lubana onɛnɛ itukwu bɛ eyi esɛ dafi ema kwudzɛ kpɔklɔɔ mbi Otsɛ iYesu nɛni. <verse eid="1TH 3:8"/><verse number="9" style="v" sid="1TH 3:9"/>Eyi ka ta Imgbasho angba mi ikye mgbi ema sinɛse ngwi ka gyɔ okpan mkpa mi atsa ngwi eyi dzɛyan mi inain ikye mgbi ema nɛ? <verse eid="1TH 3:9"/><verse number="10" style="v" sid="1TH 3:10"/>Otu yi onɔ eyi li bibɔ mi itukwu mgbi eyi onyi gbɛɛ eyi ki yɛ di ema ikye ombwo ema ungwɔ ama nkwoba mi oyɛyɛ onuunu mgbi ema.<verse eid="1TH 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1TH 3:11"/>Onɛnɛ ni Otseyi Imgbasho abuon bɛyi Otsɛ mgbi eyi iYesu kyi mɛlu eyi ofɛ oba mbi ema. <verse eid="1TH 3:11"/><verse number="12" style="v" sid="1TH 3:12"/>Otsɛ iYesu ki nu okpitukwu mgbi ema mbwo le fɛ ikye ewema yi inggisɛ angbeka duu, yɛyɛ dafi okpitukwu mgbi eyi dzɛ ikye ema nɛni. <verse eid="1TH 3:12"/><verse number="13" style="v" sid="1TH 3:13"/>O ki fyi ema mfyitukwu ikyegbɛɛ nu ma ka tu ungwɔ okye ondu kwo ema ewo ba, ni ema dile saan inai Otseyi Imgbasho yi onɔ ngwi Otsɛ mgbi eyi iYesu wa yɛ ba yi ama osaan mgban duu mani.<verse eid="1TH 3:13"/></para>
  <chapter eid="1TH 3"/>
  <chapter number="4" style="c" sid="1TH 4"/>
  <para style="s1">Oshishe okpa Imgbasho</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 4:1"/>Ongwikpa yɔ, emi ongwunani, eyi teyi wɛ ema odzɛ mi itɔ oshishe ngwi ema ka dzɛ se ka kpa Imgbasho mani, dafi ema le kyɔ nani. Onɛnɛ eyi le nya ema dile tu ema wo mbi Otsɛ iYesu gbɛɛ ni ema kiyayi ole kyɔ ngha. <verse eid="1TH 4:1"/><verse number="2" style="v" sid="1TH 4:2"/>Lubana ema ye ola ngwi eyi wo ema mi mfye mgbi Otsɛ iYesu mani.<verse eid="1TH 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1TH 4:3"/>Li owitukwu mgbi Imgbasho gbɛɛ ni ema le saan, ni ema nya yi amah okyɔɔkyɔ; <verse eid="1TH 4:3"/><verse number="4" style="v" sid="1TH 4:4"/>gbɛɛ ni ali inggisɛ mgbi ema non kpayi obwa ewon fyii mi ofɛ osaan di dzɛ yi mmwɛ, <verse eid="1TH 4:4"/><verse number="5" style="v" sid="1TH 4:5"/>no ka li mi ofɛ mgbi imina amah dafi ama nli emi iKrestu ba, di ye Imgbasho ba na ba. <verse eid="1TH 4:5"/><verse number="6" style="v" sid="1TH 4:6"/>Ma mi itɔdzɛ nɛ, inggisɛ onyi kpaa no ka kyɔ ongwunɔn obube naadi kyɔ ongwunɔn ogye ba. Otsɛ Imgbasho ka kwo ali inggisɛ duu adɔ mi itɔ ali ibwubwe ntonɛni, dafi eyi teyi nya ema di kwo ema adɔ mani. <verse eid="1TH 4:6"/><verse number="7" style="v" sid="1TH 4:7"/>Bana Imgbasho kwu eyi ela gbɛɛ ni eyi wa le kpɛkpɛ ba, kpaa ni eyi dzɛ mi oshishe osaan. <verse eid="1TH 4:7"/><verse number="8" style="v" sid="1TH 4:8"/>Ikyenghanɛ, inggisɛ nfwa otsootso nɛ, fwa ama ngwu tso ma ma ta ba kpaa li Imgbasho abuon, ongwu nnu ema Onodzi mgban Osaan nani.<verse eid="1TH 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 4:9"/>Mi odzɛ mgbi okpitukwu mgbi engwuneka yɔ, eyi di oyabɔ olɔ afɛ dɛsɔ nu ema mi ele ba, lubana ema abuema Imgbasho teyi tso ema dafi ema ka dzɛ yi okpitukwu mbi ewema mani. <verse eid="1TH 4:9"/><verse number="10" style="v" sid="1TH 4:10"/>Ma mi otsitsi yɔ, ema teyi dzɛ yi okpitukwu mbi ama okyɛdɔ iYesu kpatsɛ ɛsɛ iMasidonia duu. Nghaduu eyi kale gbɔ yi ema emi ongwuneyi, kiyayi mi okpitukwu na.<verse eid="1TH 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1TH 4:11"/>Fya mi ofyaafya mgbi ema odzɛ mi oshishe oshilididi, kye eka byi ungwɔ mgbi ema di kyidɔ mi abɔ mgbi ema, yɛyɛ dafi eyi teyi nya ema mani, <verse eid="1TH 4:11"/><verse number="12" style="v" sid="1TH 4:12"/>ikye ni odzɛɛdzɛ mgbi ema nu etasɛ nu ema mmwɛ, adzi ni ema ka kye inɛ byi mbi inggisɛ onyi ba mani.<verse eid="1TH 4:12"/></para>
  <para style="s1">Oyɛɛyɛ mgbi Otsɛ</para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 4:13"/>Emi ongwunani, eyi mina gbɛɛ ni ema ka li inzunubu mi odzɛ inggisɛ ama nteyi kwulu hona wulu itukwu dafi inggisɛ angbeka, ama ndzɛ yi eka ogbe byiibyi ba na ba. <verse eid="1TH 4:13"/><verse number="14" style="v" sid="1TH 4:14"/>Eyi noyɛyɛ gbɛɛ iYesu kwulu diyɛ kyɛɛ di li ngha ngwi eyi noyɛyɛ gbɛɛ Imgbasho ka yile ama nnuna mi ifu iKrestu ba yan aali. <verse eid="1TH 4:14"/><verse number="15" style="v" sid="1TH 4:15"/>Mi elodzɛ mgbi Otsɛ abuon ma, eyi nya ema gbɛɛ eyi ama nka to oshishe ngwu a dzita eyi nghataa ba oyɛɛyɛ mgbi Otsɛ iYesu ma, ka yagba oteyi ama nteyi nuna mbon na ba. <verse eid="1TH 4:15"/><verse number="16" style="v" sid="1TH 4:16"/>Lubana Otsɛ iYesu abuon ka kyɛ adopo ba esɛ, yi ola owoowo mi ela okwukwo, yi ela mgbi ongbodzi ongyesɔ bɛyi agba ofoofo mgbi Imgbasho, man ama nkwulu mi ifu iKrestu ka teyi kyato ababɔ. <verse eid="1TH 4:16"/><verse number="17" style="v" sid="1TH 4:17"/>Ta eyi ama nka to oshishe ngwu a di dzita eyi to ɛsɛ nɛ, a kawa gbe eyi ka kwakye yi ama mi akpa oka tu Otsɛ mi awo. Ma di li ngha ngwi eyi ka dzɛ yi Otsɛ iYesu gyegwu aali. <verse eid="1TH 4:17"/><verse number="18" style="v" sid="1TH 4:18"/>Inghawanɛ le kwu ewema ɛwɛ wo yi elodzɛ ntonɛ na.<verse eid="1TH 4:18"/></para>
  <chapter eid="1TH 4"/>
  <chapter number="5" style="c" sid="1TH 5"/>
  <para style="s1">Wewo mi oyɛɛyɛ mgbi Otsɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 5:1"/>Nghanɛ, emi ongwunani, mi odzɛ onɔ yi egbe oyɛɛyɛ yɔ, eyi di oyabɔ olungwɔ nya ema mi ele ba, <verse eid="1TH 5:1"/><verse number="2" style="v" sid="1TH 5:2"/>lubana ema ye saan gbɛɛ oyɛɛyɛ mgbi Otsɛ iYesu kale bwabwa dafi emumyi mi otu mani. <verse eid="1TH 5:2"/><verse number="3" style="v" sid="1TH 5:3"/>Onɔ ngwi inggisɛ kale gbɔgbɛɛ ama dzɛ mi iyu yi omyɛɛ-myɛɛ mani, odzili-dzili ka ba mboma bwabwa, dafi imba li kwu ongyaa ifu mani. Ta a ka watɔ gbɛ ba.<verse eid="1TH 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1TH 5:4"/>Nghaduu, emi ongwunani, ngwi ema to mi iyifu ba nɛ, egbe na ka tu ema bwabwa dafi emumyi ba. <verse eid="1TH 5:4"/><verse number="5" style="v" sid="1TH 5:5"/>Ema duu li emi ongwɛ osa di li kyikyɛ mi osa. Eyi li mgbi otu hona iyifu ba. <verse eid="1TH 5:5"/><verse number="6" style="v" sid="1TH 5:6"/>Nghanɛ, ni eyi kwasisa di kwu blii, ni eyi ka nuna dafi angbeka ntona ba. <verse eid="1TH 5:6"/><verse number="7" style="v" sid="1TH 5:7"/>Lubana ama ngwu nuna, nuna mi otu, ama ndi fyɛbyɛ, fyɛbyɛ mi otu. <verse eid="1TH 5:7"/><verse number="8" style="v" sid="1TH 5:8"/>Kpaa dafi eyi li emi ongwɛ osa nɛ, ni eyi bwa eweyi fyii di kye oyɛyɛ onuunu yi okpitukwu wo dafi abiika, odi kye eka ogbe byiibyi mgbi owatɔ-watɔ dafi angwikye ika mani. <verse eid="1TH 5:8"/><verse number="9" style="v" sid="1TH 5:9"/>Lubana Imgbasho dulu eyi gbɛɛ ni eyi gyadzɛ mi itingga mgban ba, kpaa ni eyi tu owatɔ-watɔ mbi Otsɛ mgbi eyi iYesu iKrestu. <verse eid="1TH 5:9"/><verse number="10" style="v" sid="1TH 5:10"/>O kwulu mi ikye mgbi eyi ikyegbɛɛ, kini eyi dzɛ oshishe naadi kwulu kpaa, mi onɔ oyɛɛyɛ mgban ma, ni eyi dzɛ oshishe biyan. <verse eid="1TH 5:10"/><verse number="11" style="v" sid="1TH 5:11"/>Inghawanɛ, kwu ewema ɛwɛ wo di fyi eka mfye itukwu, yɛyɛ dafi ema tsekise le kyɔ nani.<verse eid="1TH 5:11"/></para>
  <para style="s1">Ola ongwi olɛlɛ</para>
  <para style="p">
    <verse number="12" style="v" sid="1TH 5:12"/>Emi ongwuneyi, onɛnɛ eyi le nya ema gbɛɛ ni ema kye mmwɛ nu ama nkyidɔ kpɔklɔɔ mi idzidzɛ ema, ama nteyi ema mbi Otsɛ iYesu di li wɛ ema odzɛ mani. <verse eid="1TH 5:12"/><verse number="13" style="v" sid="1TH 5:13"/>Kye mmwɛ onghaangha nu ma mi okpitukwu mi ikye idɔ mgbi ama. Dzɛ mi iyu yi ewema. <verse eid="1TH 5:13"/><verse number="14" style="v" sid="1TH 5:14"/>Emi ongwuneyi, eyi dile nya ema gbɛɛ ni ema kwo emi okwulo adɔ, kwu ama nli wo imio ɛwɛ wo, ya ama oshɛshɛ abɔ di shitukwu yi ali inggisɛ duu. <verse eid="1TH 5:14"/><verse number="15" style="v" sid="1TH 5:15"/>Di gbɛɛ inggisɛ onyi kpaa kpumkpa alobube mi alobube ba, kpaa alonɔ kyɔ osuse yi ewema yi ali inggisɛ duu.<verse eid="1TH 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1TH 5:16"/>Dzɛ yi atsa alonɔ; <verse eid="1TH 5:16"/><verse number="17" style="v" sid="1TH 5:17"/>bibɔ alonɔ duu, <verse eid="1TH 5:17"/><verse number="18" style="v" sid="1TH 5:18"/>Ta Imgbasho angba mi alungwɔ nkyɔ duu, lubana li oweka mgbi Imgbasho mi ikye ema mbi iYesu iKrestu aani.<verse eid="1TH 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1TH 5:19"/>Ka kye myunu ola mgbi Onodzi ba; <verse eid="1TH 5:19"/><verse number="20" style="v" sid="1TH 5:20"/>ka kwu elodzɛ oyegbɔ mgbi Imgbasho shanyɛ ba. <verse eid="1TH 5:20"/><verse number="21" style="v" sid="1TH 5:21"/>Mbadi alungwɔ duu. Gbela yi osuse mani. <verse eid="1TH 5:21"/><verse number="22" style="v" sid="1TH 5:22"/>Dzɛ enggengga yi alobube duu.<verse eid="1TH 5:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1TH 5:23"/>N bibɔ gbɛɛ ni Imgbasho abuon, ongwu nli nu iyu na, kye ema dzɛ nyaan. Ni onodzi mgbi ema olɔlɔ yi oshishe bɛyi ewo duu dzɛ yi idza ba, mi onɔ oyɛɛyɛ mgbi Otsɛ mgbi eyi iYesu iKrestu mani. <verse eid="1TH 5:23"/><verse number="24" style="v" sid="1TH 5:24"/>Imgbasho nkwu ema ela na li wɛndɛ ba, o dika kyɔ ngha yɛyɛ.<verse eid="1TH 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1TH 5:25"/>Engwunɛn, bibɔ ikye eyi na. <verse eid="1TH 5:25"/><verse number="26" style="v" sid="1TH 5:26"/>Ta ama onoyɛyɛ angba di tsɛkwulu eka mi okpitukwu na. <verse eid="1TH 5:26"/><verse number="27" style="v" sid="1TH 5:27"/>Mi iyi mgbi Otsɛ iYesu, ani le tɛkyɛ nu ema gbɛɛ ni a gbɔ afɛ nɛ nya ama onoyɛyɛ duu.<verse eid="1TH 5:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1TH 5:28"/>Ni elela mgbi Otsɛ mgbi eyi iYesu iKrestu dzɛ yi ema.<verse eid="1TH 5:28"/></para>
  <chapter eid="1TH 5"/>
</usx>
