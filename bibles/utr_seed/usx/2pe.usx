<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2PE" style="id">- Etulo</book>
  <para style="h">2 iPyita</para>
  <para style="toc1">Afɛ ongwu fan mgbi iPyita</para>
  <para style="toc2">2 iPyita</para>
  <para style="toc3">2iPit</para>
  <para style="mt2">Afɛ ongwu fan mgbi</para>
  <para style="mt1">iPyita</para>
  <chapter number="1" style="c" sid="2PE 1"/>
  <para style="s1">Angba otaata</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 1:1"/>Afɛ nɛ kyɛ mbi ani iSaimɔn iPyita, ongbidɔ yi inggisɛ ogbikye iYesu iKrestu,</para>
  <para style="p" vid="2PE 1:1">Le kɛ mbi ama ngwu a kye oyɛyɛ onuunu nkwɔ dafi mgbi eyi nyɛ mi osaan mgbi Imgbasho mgbi eyi yi ongye Onagbɛ iYesu iKrestu nu ma nani gbɛɛ:<verse eid="2PE 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2PE 1:2"/>Elela yi iyu mgbi Imgbasho bɛyi mgbi iYesu Otsɛ mgbi eyi no dzɛ yi ema dzii dafi ema le she mi ozoyeye mgbi Imgbasho nɛni.<verse eid="2PE 1:2"/></para>
  <para style="s1">Onu ela okwuukwu yi osadu-sadu <optbreak/> mgbi eyi yɛɛ otsitsi</para>
  <para style="p">
    <verse number="3" style="v" sid="2PE 1:3"/>Eyi tu alungwɔ ngwi eyi mina duu ikye odzɛ mi oshishe nkpa Imgbasho. Eyi tu ungwɔ ntonɛ duu mi mfye mgbi Imgbasho, onɔ ngwi eyi wa difwi gbɛɛ, o bɔ eyi gbɛɛ ni eyi wa kaka mi okwɔkwɔ mgban yi ali osuse mani. <verse eid="2PE 1:3"/><verse number="4" style="v" sid="2PE 1:4"/>Mi ofɛ nɛ o kye angbodzi ondu odzɛɛdzɛ ama nsumse nu eyi, ikyegbɛɛ ni ema dzɛ mi odzɛɛdzɛ mgbi atta mgbi Imgbasho di tasɛ mi ombeembee mgbi ɛsɛ ngwi imina mgbi ali ibwubwe li ba yan nani.<verse eid="2PE 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2PE 1:5"/>Mi itɔdzɛ nɛ nɛ, fya mi ofyaafya mgbi ema duu ni ema mbwo mse okyɔɔkyɔ mi oyɛyɛ onuunu mgbi ema, di kye ozoyeye bɛkɛ yi mse okyɔɔkyɔ, <verse eid="2PE 1:5"/><verse number="6" style="v" sid="2PE 1:6"/>di kye obwa ewema fyii bɛkɛ yi ozoyeye, di kye ogbili-gbili bɛkɛ yi obwa ewema fyii, di kye odzɛɛdzɛ mgbi Imgbasho bɛkɛ yi ogbili-gbili, <verse eid="2PE 1:6"/><verse number="7" style="v" sid="2PE 1:7"/>di kye mse mgbi ongwuneka bɛkɛ yi odzɛɛdzɛ mgbi Imgbasho, diyɛ kye okpitukwu bɛkɛ yi mse mgbi ongwuneka nani. <verse eid="2PE 1:7"/><verse number="8" style="v" sid="2PE 1:8"/>Lubana ni ema kiyayi oshe mi itɔ ofɛ nɛ yɔ, ka tso gbɛɛ ungwɔ ngwi ema ye mi odzɛ mgbi Otsɛ mgbi eyi iYesu iKrestu nɛ, nu oshishe mgbi ema dzɛ yi oyabɔ di dzɛ mi itɔdzɛ kpaa. <verse eid="2PE 1:8"/><verse number="9" style="v" sid="2PE 1:9"/>Nghaduu inggisɛ ndzɛ yi ambɛ ntonɛ bayɔ, o li di puu di binɛ, di gblimɔ gbɛɛ a kye ongwu kyi salu mi ali ibwubwe mgban ogbugbe.<verse eid="2PE 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 1:10"/>Nghanɛ, emi ongwunani, kwunewo kpakpa ni ema nu ela ngwi a kwu ema bɛyi osadu-sadu ngwi a sadu ema nɛ yɛɛ otsitsi. Ikyekyɛ ni ema kyungwɔ ntonɛ yɔ, ema ka gbɛsɛ ba, <verse eid="2PE 1:10"/><verse number="11" style="v" sid="2PE 1:11"/>a dika kyɔ ema onɔ saan kaka esutɔ ogyegwu mgbi Otsɛ mgbi eyi yi ongye Onagbɛ iYesu iKrestu nani.<verse eid="2PE 1:11"/></para>
  <para style="s1">Okye itukwu nu mi Ibyibyilo</para>
  <para style="p">
    <verse number="12" style="v" sid="2PE 1:12"/>Nghanɛ ngwi ema teyi ye ma di kye afɔ kwulɛsɛ saan mi otsitsi ngwi a tso ema nɛ kpaa, n kale wɛ ema ungwɔ ntonɛ alonɔ duu. <verse eid="2PE 1:12"/><verse number="13" style="v" sid="2PE 1:13"/>Dzɛ ani gbɛɛ li ayin ni ani le wɛ ema odzɛ nɛni ngwi ani ka dzɛ oshishe nɛ tayɔ, <verse eid="2PE 1:13"/><verse number="14" style="v" sid="2PE 1:14"/>ikyekyɛ ani ye gbɛɛ ani ka kwulu dzikan-dzikan, dafi Otsɛ mgbi eyi iYesu iKrestu nya ani saan mani. <verse eid="2PE 1:14"/><verse number="15" style="v" sid="2PE 1:15"/>N dika fya mi ofyaafya mgbi ani odi gbɛɛ ni ani wa kwulu kpaa, ema ka yagba ole wɛ ungwɔ ntonɛ duu.<verse eid="2PE 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2PE 1:16"/>Onɔ ngwi eyi nya ema odzɛ mfye bɛyi obaaba mgbi Otsɛ mgbi eyi iYesu iKrestu ma, eyi yama kyɛdɔ mi utsa ngwi a du-du ba, kpaa eyi li obwɛndɛ inɛ-inɛ mi okwɔkwɔ oshewo mgban. <verse eid="2PE 1:16"/><verse number="17" style="v" sid="2PE 1:17"/>Lubana o gbɛ mmwɛ yi okwɔkwɔ mbi Imgbasho Otsɔn mi onɔ ngwi ela kyɛ mi okwɔkwɔ oshewo ba mbon gbɛɛ, &lt;&lt;Nɛnɛ li ongwani, o kpa ani itukwu, ani dzɛ yi atsa biyan saan mani.&gt;&gt; <verse eid="2PE 1:17"/><verse number="18" style="v" sid="2PE 1:18"/>Eyi abueyi fwo ela nkyɛ esho ba nɛ mi onɔ ngwi eyi dzɛyan mi unggwɔ Osaan nani.<figure style="fig" alt="Glory of God1" file="CN01728B.TIF" size="col" loc="1:18" copy="cook nt" ref="1:18">Okwɔkwɔ mgbi Imgbasho</figure><verse eid="2PE 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2PE 1:19"/>Ungwɔ ntonɛ duu nu eyi nghao noyɛyɛ mi elodzɛ mgbi ama ogbɛɛsɛ, ema dika kyɔ ayin ni ema gadɔ mi ele yɔ. Lubana elodzɛ mgbi ama dzɛ dafi ola nle gbɛ mi imbe iifu mani, nghataa ikyegbe adzi ni osa mgbi oshɛbɛ iKrestu gbɛ mi itukwu mgbi ema. <verse eid="2PE 1:19"/><verse number="20" style="v" sid="2PE 1:20"/>Onghaangha duu, li kyɛmɛ ni ema difwi gbɛɛ elodzɛ mgbi ama ogbɛɛsɛ mi Afɛ kyɛ mi odifwi-difwi mgbi ama ba. <verse eid="2PE 1:20"/><verse number="21" style="v" sid="2PE 1:21"/>Ikyesinɛ elodzɛ ongye ogbɛɛsɛ tiita mi oweka mgbi inggisɛ owamyɛ ba, kpaa inggisɛ le gbeesɔ mgbi Imgbasho dafi Onodzi Osaan kye ma teyi mani.<verse eid="2PE 1:21"/></para>
  <chapter eid="2PE 1"/>
  <chapter number="2" style="c" sid="2PE 2"/>
  <para style="s1">Etsetse emi atsika bɛyi odzili-dzili <optbreak/> mgbi ama</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 2:1"/>Nghaduu ama ogbɛɛsɛ atsika kpaa nose woto idzidzɛ inggisɛ ntonani, yɛyɛ dafi etsetse atsika kawa wo idzidzɛ ema mani. A ka kye otsootso odzili-dzili ba esɛ daada, di tangwɛ Otsɛ ngwu gya ma ma kpaa diyɛ dzili ewoma tsoli. <verse eid="2PE 2:1"/><verse number="2" style="v" sid="2PE 2:2"/>Inggisɛ ibyibyi ka kyɛdɔ ofɛ ayiwi mgbi ama dika nu inggisɛ kwu ofɛ otsitsi fyito. <verse eid="2PE 2:2"/><verse number="3" style="v" sid="2PE 2:3"/>Mi nggwɔ okyɔɔkyɔ mgbi etsetse ntonɛ, a ka kye ema yɛɛ ungwɔ okyummya. A teyi ngwɔ ma ikwɔ le fɛɛfɛ, odzili-dzili mgbi ama kpaa dika mboonɔ ba dududu.<verse eid="2PE 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2PE 2:4"/>Lubana Imgbasho di engyesɔ elela ba mi onɔ ngwi a kyɔ obube ma, kpaa gbe ma kwuokɛ udola, gbe ma wokɛ ikplishɛ le fɛ egbe ikwɔ. <verse eid="2PE 2:4"/><verse number="5" style="v" sid="2PE 2:5"/>O diyɛ di emi tugbe elela mi onɔ ngwi o nu eni tayɔ mbi ama n ye Imgbasho ba, kpaa dulu iNua, inggisɛ ogbeesɔ mgbi osaan, bɛyi angbeka nghi egyafa. <verse eid="2PE 2:5"/><verse number="6" style="v" sid="2PE 2:6"/>O di dzili ogalu iSodon yi iGomora mi okye ma toola yɛɛ utɔ, di nu ma yɛɛ ambɛ ungwɔ nkawa kyɔ ama n ye Imgbasho ba mani. <verse eid="2PE 2:6"/><verse number="7" style="v" sid="2PE 2:7"/>O di dulu iLoti inggisɛ nle saan, le gyadzɛ mi idzidzɛ inggisɛ ama n ye ola ba le kyɔ amah idza <verse eid="2PE 2:7"/><verse number="8" style="v" sid="2PE 2:8"/>(bana inggisɛ osaan na, wodzɛ idzidzɛ ma alegbe-alegbe, le gbisɔ mi ali ibwubwe ngwi o le di diyɛ fwo mani). <verse eid="2PE 2:8"/><verse number="9" style="v" sid="2PE 2:9"/>Dafi ungwɔnɛ dzɛ ngha nɛ, Otsɛ ye dafi ongwu ka dulu ama onoyɛyɛ mi imbadi di kwo emi ali ibwubwe adɔ ngwi a kale fɛ egbe ikwɔ nɛni. <verse eid="2PE 2:9"/><verse number="10" style="v" sid="2PE 2:10"/>Onghaangha duu, mbi ama nli kyɛdɔ imina mgbi ali ibwubwe mgbi atta di fwa mfye mgbi Imgbasho mani.</para>
  <para style="p" vid="2PE 2:10">A dzɛ yi abɔ otsigɛgɛ di li kyile ewo esho, a li mio ofya mfye ama okwulewo mi esho kpaa ito ba. <verse eid="2PE 2:10"/><verse number="11" style="v" sid="2PE 2:11"/>Nghanɛ engyesɔ abuoma dafi a nghao dzɛ yi ɛnɛpɛ di fyumfye kpakpa nɛ kpaa, a li fya mfye ntona ito mi inai Otsɛ ba. <verse eid="2PE 2:11"/><verse number="12" style="v" sid="2PE 2:12"/>Nghaduu inggisɛ ntonɛ li fyito mi odzɛ ngwi a ye itan ba. A dzɛ dafi mmbwaba ama ndzɛ yi ozoyeye ba mani, ama ndzɛ oshishe mi imina mgbi ama, ngwi a mba ma ikye okwu ma ta ngwɔ, ama kpaa a ka dzili ma dafi mmbwaba ntonani.<verse eid="2PE 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2PE 2:13"/>A kawa yile obube kpa ma ikye obube ngwi a teyi kyɔ mani. Li kpa ma okyungwɔ obube mi onɔ gede-gede. A li emi idza, ungwɔ ayiwi li kpa ma, ngwi a li gye ungwogye yi ema nɛ kpaa. <verse eid="2PE 2:13"/><verse number="14" style="v" sid="2PE 2:14"/>Amah mbwo ma inɛ, a li nya yi ungwɔ obube okyɔɔkyɔ ba, a li nu inggisɛ ama ndzɛ glagla gbɛsɛ mi amah, a bɛ mi nggwɔ okyɔɔkyɔ, a li etɔ ngwi a wo ma ikamba! <verse eid="2PE 2:14"/><verse number="15" style="v" sid="2PE 2:15"/>A teyi dzata ofɛ nbyi klididi mani yɛ kyɛdɔ ofɛ mgbi iBalan ongwɛ iBeo, ngwi umba otu mi alobube okyɔɔkyɔ li kpa ma nani. <verse eid="2PE 2:15"/><verse number="16" style="v" sid="2PE 2:16"/>Nghaduu Itaklimyi kyɔkyɔ yan mi ungwɔ ngwi o le kyɔ ayin ba nani, mmbwaba ndzɛ yi elodzɛ ba, gbɔdzɛ yi ela inggisɛ di kyɔkyɔ odzɛ ede yi inggisɛ ogbɛɛsɛ.<verse eid="2PE 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 2:17"/>Inggisɛ ntonɛ li ibuga ama ndzɛ yi eni ba bɛyi akpesho ntseto ngwi awo ganyan. A kye imbe n yifu kpini-kpini dzɛ ma. <verse eid="2PE 2:17"/><verse number="18" style="v" sid="2PE 2:18"/>A li gbɔ elodzɛ okyile ewo esho bɛyi elodzɛ ikwangha, di kye imina mgbi ɛsɛ kya ama nkwa le fya owatɔ mi idzidzɛ inggisɛ nto mi ɛndɛ ma ukya. <verse eid="2PE 2:18"/><verse number="19" style="v" sid="2PE 2:19"/>A zondu oshɛ ma adi ta, ngwi ama abuoma li ofyɛɛ mgbi odzili-dzili nɛni. Ikyesinɛ inggisɛ li ofyɛɛ mgbi alungwɔ ngyutɔ mbon duu. <verse eid="2PE 2:19"/><verse number="20" style="v" sid="2PE 2:20"/>Ni a dzidzɛ tɔ mi idza mgbi ɛsɛ nɛ mi oye Otsɛ mgbi eyi bɛyi Onagbɛ iYesu iKrestu diyɛ gbuokɛ efu yɛɛ ofyɛɛ ali ibwubwe yɔ, ongyɛɛngyɛ mgbi ama ka timbi ngha owita-wita. <verse eid="2PE 2:20"/><verse number="21" style="v" sid="2PE 2:21"/>Kika tatase loma nu ma ki ye ofɛ mgbi osaan ba, ngha onu ma ye di fashi iyikpa tsɛ ola osaan ngwi a kye nu ma nani. <verse eid="2PE 2:21"/><verse number="22" style="v" sid="2PE 2:22"/>Nghanɛ, a tso otsitsi mgbi itɔdzɛ ngbɛɛ: &lt;&lt;Obwe yile akpa mgban gye, Obyia ngwi a shon ewo yɛ lu ka myini mi amwa.&gt;&gt;<verse eid="2PE 2:22"/></para>
  <chapter eid="2PE 2"/>
  <chapter number="3" style="c" sid="2PE 3"/>
  <para style="s1">Egbe oyɛɛyɛ mgbi Otsɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 3:1"/>Emi okani osuse, nɛnɛ li afɛ mgbi ani ongwu fan ngwi ani lɔ kɛ mbi ema aani. N lɔ ma nghi efa duu ikye owɛ ema, kyile ema itukwu esho ikye ni ema le wɛ di dzɛ mi ɛwɛ otsɛɛtsɛ ingblimɔ. <verse eid="2PE 3:1"/><verse number="2" style="v" sid="2PE 3:2"/>I mina ani gbɛɛ ni ema wɛ odzɛ ogbugbe ngwi ama ogbɛɛsɛ ama osaan gbɔ mani bɛyi ola ngwi Otsɛ mgbi eyi yi Onagbɛ kye nu ema nyɛ mbi emidema ama ogbikye iYesu ntonani.<verse eid="2PE 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2PE 3:3"/>Ababɔ yɔ, ema ka difwi kyɛmɛ gbɛɛ mi egbe ongwi olɛlɛ ama otangwɛ iYesu ka ba, le kyɛdɔ ofɛ ibwubwe mgbi ama. <verse eid="2PE 3:3"/><verse number="4" style="v" sid="2PE 3:4"/>Dile gbɛɛ, &lt;&lt;Ondu ngwi o dzɛ gbɛɛ ongwu ka yɛ ma kɔ? Lubana kyɛ onɔ ngwi emi otseyi kwulu mani, alungwɔ duu kale kiyayi dafi i teyi dzɛ mi owita-wita ngwi a ta ɛsɛ mani.&gt;&gt; <verse eid="2PE 3:4"/><verse number="5" style="v" sid="2PE 3:5"/>A gblimɔ mi oshu gbɛɛ tugbe Imgbasho ta esho mi elodzɛ mgban di ta ikpɛsɛ mi ikpewo eni di kyɛ mi eni. <verse eid="2PE 3:5"/><verse number="6" style="v" sid="2PE 3:6"/>Li mi eni ntonɛ kpaa ngwi eni tayɔ, di dzili ɛsɛ tugbe aali. <verse eid="2PE 3:6"/><verse number="7" style="v" sid="2PE 3:7"/>Li mi elodzɛ na kpɔɔ, ngwi Imgbasho kye esho yi ɛsɛ ongwi onɛnɛ dzɛ le fɛ ola, ngwi o kye dzɛkɛ ikye egbe ikwɔ bɛyi odzili-dzili mgbi emi ali ibwubwe aani.<verse eid="2PE 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2PE 3:8"/>Nghaduu ka gblimɔ odzɛ onyi nɛ ba na, emi okani mgbi itukwu-itukwu: Mbi Otsɛ Imgbasho egbe onyi dzɛ dafi onova idubu onyi, onova idubu onyi di dzɛ dafi egbe onyi mani. <verse eid="2PE 3:8"/><verse number="9" style="v" sid="2PE 3:9"/>Otsɛ le dumɔɔ ombwo ondu odzɛɛdzɛ mgban dafi inggisɛ angbeka tsɛwɛ gbɛɛ o dzɛ na ba. O li kwu onyɔtsɛ yi ema, o mina gbɛɛ inggisɛ onyi kpaa no dzili ba, kpaa ali inggisɛ duu no kaka mi itukwu okyata-kyata.<verse eid="2PE 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 3:10"/>Nghaduu egbe mgbi Otsɛ oyɛɛyɛ ka ba bwabwa dafi emumyi mani. Esho ka tsagwudu kpakpa di nyɛ, a dika dzili ungwɔ ama nto ele yi ola, man ɛsɛ yi ungwɔ ama nle kyɔ mi ele duu a ka kye dɛɛsɛ.<verse eid="2PE 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2PE 3:11"/>Ngwi i dzɛ gbɛɛ a ka dzili alungwɔ duu mi itɔ ofɛ nɛ nɛ, li ali itɔ inggisɛ ngwi i wo gbɛɛ ema ka dzɛ? I wo gbɛɛ ema ka dzɛ mi oshishe nle saan bɛyi oshishe inggisɛ Imgbasho <verse eid="2PE 3:11"/><verse number="12" style="v" sid="2PE 3:12"/>dafi eyi kyinɛbyi egbe mgbi Imgbasho gbɛɛ no ba plɛ-plɛ nɛni. Egbe na ka ba yi odzili-dzili mgbi esho mi ola, ungwɔ ama nto ele tsatsa dika yilɛ mi olola. <verse eid="2PE 3:12"/><verse number="13" style="v" sid="2PE 3:13"/>Nghaduu ogbɛwɛbyi mi ondu odzɛɛdzɛ mgban yɔ, eyi gbinɛbyi esho yi ɛsɛ ofufɛ, udɛ mgbi osaan.<verse eid="2PE 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2PE 3:14"/>Nghanɛ, emi okani osuse, ngwi i yɛɛ gbɛɛ ema gbinɛbyi iyayi ikye ungwɔnɛ nɛ, fya mi ofyaafya mgbi ema duu nu ma ka tu ema boya ewo ba, yi obube ba di dzɛ mi iyu biyan. <verse eid="2PE 3:14"/><verse number="15" style="v" sid="2PE 3:15"/>Di wɛ gbɛɛ onyɔtsɛ okwu-kwu mgbi Otsɛ mgbi eyi li ikye onu inggisɛ onɔ gbɛɛ nu ma tu owatɔ-watɔ, yɛyɛ dafi ongwuneyi itukwu-tukwu iPol kpaa lɔ ema afɛ mi ozoyeye ngwi Imgbasho kye nun nani. <verse eid="2PE 3:15"/><verse number="16" style="v" sid="2PE 3:16"/>O lɔ afɛ mgban duu ungwonyi, le gbɔdzɛ mi ele mi itɔdzɛ ntonɛni. Ungwɔ to mi afɛ mgban nfyumfye odifwi-difwi, ngwi emi mnana bɛyi ama owɔɔwɔ li gbɔn ayin ba, dafi a li kyɔ mi Afɛ elodzɛ Imgbasho angbeka, odzili ewoma mani.<verse eid="2PE 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 3:17"/>Nghanɛ, emi okani ingblimɔ, dafi ema tsekise ye ungwɔnɛ nɛ, kwasisa na ikye ni ama n ye ola ba ntona ka kye ema wokɛ ɛndɛ di dzata okwu-kwu ngwi ema kwu fyii na ba. <verse eid="2PE 3:17"/><verse number="18" style="v" sid="2PE 3:18"/>Nghaduu she mi elela bɛyi ozoyeye mgbi Otsɛ mgbi eyi yi Onagbɛ iYesu iKrestu. Okwɔkwɔ no dzɛ biyan onɛnɛ nghataa gyegwu! No dzɛ ngha.<verse eid="2PE 3:18"/></para>
  <chapter eid="2PE 3"/>
</usx>
