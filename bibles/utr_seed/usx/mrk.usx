<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="MRK" style="id">- Etulo</book>
  <para style="h">iMaki</para>
  <para style="toc1">Esɔ Osuse mi abɔ mgbi iMaki</para>
  <para style="toc2">iMaki</para>
  <para style="toc3">iMak</para>
  <para style="mt2">Esɔ Osuse mi abɔ mgbi</para>
  <para style="mt1">iMaki</para>
  <chapter number="1" style="c" sid="MRK 1"/>
  <para style="s1">IJɔn okyɔ iBatisima mɛ ofɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1"/>Owita-wita mgbi Esɔ Osuse mi ikpewo iYesu iKrestu, Ongwɛ Imgbasho.<verse eid="MRK 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 1:2"/>A tsekise lɔ mi afɛ mgbi oyegbɔ Adzaya gbɛɛ:</para>
  <para style="q1" vid="MRK 1:2">&lt;&lt;N ka dɔ ongyesɔ mgbi ani no teyi abu,</para>
  <para style="q2" vid="MRK 1:2">ka mɛ abu ofɛ&gt;&gt;<verse eid="MRK 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MRK 1:3"/>&lt;&lt;Ela inggisɛ le kwu mi okwɛsɛ gbɛɛ,</para>
  <para style="q2" vid="MRK 1:3">&lt;Mɛ Otsɛ ofɛ,</para>
  <para style="q1" vid="MRK 1:3">man ofɛ no byi klididi.&gt; &gt;&gt;<verse eid="MRK 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 1:4"/>Ta iJɔn okyɔ iBatisima ba, le kyɔ iBatisima mi okwɛsɛ dile gbeesɔ mgbi iBatisima okyatitukwu nu ma dzata inggisɛ yi ali ibwubwe. <verse eid="MRK 1:4"/><verse number="5" style="v" sid="MRK 1:5"/>Ɛsɛ iJudia duu bɛyi inggisɛ emi iJerosalin tɔ kɛ mbon. Le fwi ali ibwubwe mgbi ama, iJɔn dile kyɔ ma iBatisima mi ekyoo mgbi iJodan. <verse eid="MRK 1:5"/><verse number="6" style="v" sid="MRK 1:6"/>IJɔn wo angwuto ngwi a mɛ mi andu ilakwumyi, yi okpa mmbwaba mi oshi mgban, ma o li gye okpa yi enewo. <verse eid="MRK 1:6"/><verse number="7" style="v" sid="MRK 1:7"/>Nɛnɛ li esɔ mgban nose aani: &lt;&lt;Inggisɛ oka kyɛ ani iyikpa, O fyumfye ngha ani, odi okpafɔ mgban kpaa ani mɛ oshɛ ba. <verse eid="MRK 1:7"/><verse number="8" style="v" sid="MRK 1:8"/>Ani le kyɔ ema iBatisima yi eni, nghaduu ongwu ka kyɔ ema iBatisima yi Onodzi Osaan.&gt;&gt;<verse eid="MRK 1:8"/></para>
  <para style="s1">Ibatisima yi igyila mgbi iYesu</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9"/>Egbe oka nɛ iYesu kyato mi igeli iNadzareti mi ayɛsɛ iGalalia wa to ta, iJɔn si kyɔn iBatisima mi ekyoo iJodan. <verse eid="MRK 1:9"/><verse number="10" style="v" sid="MRK 1:10"/>Dafi iYesu le kyato mi eni nɛ, o di esho kwulu man Onodzi kyɛ esho ba mbon dafi anyama mani. <verse eid="MRK 1:10"/><verse number="11" style="v" sid="MRK 1:11"/>Ta ela kyɛ esho gbɛɛ: &lt;&lt;Abu li Ongwɛ Ani mgbi itukwu-itukwu; i kpa ani yi abu saan.&gt;&gt;<figure style="fig" alt="A kyɔ iYesu iBatisima" file="CN01656b.TIF" size="col" loc="1;11" copy="Cook note" ref="1:11">Baptism of Jesus</figure><verse eid="MRK 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12"/>Onodzi byakpa kyon dɛsɔ lu okwɛsɛ akponyi, <verse eid="MRK 1:12"/><verse number="13" style="v" sid="MRK 1:13"/>o dzɛ okwɛsɛ egbe ngwusefa, ngwi iSatan le gyilan. O dzɛ yi emi mmbwaboshɛ, engyesɔ dile tobyun.<verse eid="MRK 1:13"/></para>
  <para style="s1">IYesu kwu engwafɔ emi ababɔ ela</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14"/>Ngwi a wa kye iJɔn wokɛ obawi nɛ, iYesu kaka ifu iGalalia, le gbɔ Esɔ Osuse mgbi Imgbasho. <verse eid="MRK 1:14"/><verse number="15" style="v" sid="MRK 1:15"/>O gbɛɛ, &lt;&lt;Onɔ ma gyɔ wa. Esutɔ mgbi Imgbasho dzɛ kwɛkwɛ. Kyatitukwu mi ali ibwubwe mgbi ema di noyɛyɛ mi Esɔ Osuse nɛ na!&gt;&gt;<verse eid="MRK 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16"/>Dafi IYesu nose le kyikyɛ mi ewuutɔ mgbi iGalalia nɛ, o di iSaimɔn yi Andru ongwunɔn le ngwi ukɛ mi utɔ, ikyena a li ama otuntsɛ. <verse eid="MRK 1:16"/><verse number="17" style="v" sid="MRK 1:17"/>O nya ma gbɛɛ, &lt;&lt;Kyɛdɔ ani na, ta n ka nu ema yɛɛ ama okwu inggisɛ, ka li mmbweni wuba.&gt;&gt; <verse eid="MRK 1:17"/><verse number="18" style="v" sid="MRK 1:18"/>Ntunto nɛta a dzata ukɛ mgbi ama kyɛdɔn.<verse eid="MRK 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 1:19"/>Ngwi o gblekɛ iyayi gwee nɛ, o di iJɛnsi ongwɛ iDzebedi bɛyi ongwunɔn iJɔn mi uwaa, tole mɛ ukɛ mgbi ama. <verse eid="MRK 1:19"/><verse number="20" style="v" sid="MRK 1:20"/>O mbe onɔ ba ta kwu ma ela, ta a dzata otsɔma mi uwaa yi ama ngwu a kye ma idɔ untsɛ si kyɛdɔ iYesu.<verse eid="MRK 1:20"/></para>
  <para style="s1">IYesu lɔ onodzi obube onya</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21"/>A lu iKapenahun, man ngwi egbe otonyidɔ wa ba nɛ, iYesu kaka ifoozu okwakye mgbi emi iJuda si wita otsungwɔ. <verse eid="MRK 1:21"/><verse number="22" style="v" sid="MRK 1:22"/>I kwulu inggisɛ ntona ewo mi ungwɔ otsootso mgban, ikyekyɛ o tso ma dafi inggisɛ ongwu ndzɛ yi mfye mani, dzɛ dafi mgbi etsetse mgbi ola ntona ba. <verse eid="MRK 1:22"/><verse number="23" style="v" sid="MRK 1:23"/>Mi onɔ ma ta, inggisɛ oka mi ozu okwakye mgbi emi iJuda ngwu esɛ dɔn ikye teela gbɛɛ, <verse eid="MRK 1:23"/><verse number="24" style="v" sid="MRK 1:24"/>&lt;&lt;Li alungwɔ ngwi abu mina yi eyi, iYesu ongwi iNadzareti? Abu ba owa dzili eyii? Ani ye inggisɛ ngwu abu dzɛ mani, Ongwɛ Osaan mgbi Imgbasho!&gt;&gt;<verse eid="MRK 1:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 1:25"/>IYesu kyɔkyɔ yan gbɛɛ, &lt;&lt;Yile ondu tukwu! Tasɛ mbon!&gt;&gt; <verse eid="MRK 1:25"/><verse number="26" style="v" sid="MRK 1:26"/>Onodzi obube na siin mfyumfye yi ela otaata man si tɔ dzanta.<verse eid="MRK 1:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 1:27"/>I kwulu inggisɛ ntona ewo kpakpa ta a byi ewoma gbɛɛ, &lt;&lt;Li ekyɛ dɛn? Otsootso ofufɛ nkyɛ yi mfye! O li wo onodzi ibwubwe kpaa ola ta a li fwon.&gt;&gt; <verse eid="MRK 1:27"/><verse number="28" style="v" sid="MRK 1:28"/>Odzɛ mgban si gbɔfwɛ vla kpatsɛ ayɛsɛ iGalalia duu.<verse eid="MRK 1:28"/></para>
  <para style="s1">IYesu ngyɛlu inggisɛ gwuba ootse</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29"/>Ngwi a dzata ozu okwakye mgbi emi iJuda mata, a lu yi iJɛnsi bɛyi iJɔn mi udɛ mgbi iSaimɔn yi Andru. <verse eid="MRK 1:29"/><verse number="30" style="v" sid="MRK 1:30"/>Awo bwa Onowa iSaimɔn ladzɛ esɛ, man a nya iYesu odzɛ mgban. <verse eid="MRK 1:30"/><verse number="31" style="v" sid="MRK 1:31"/>Nghanɛ o kɛ mbon, yan abɔ kyilen sɔkunto. Awo na dzanta man o si wita ogbe ungwogye nu ma.<verse eid="MRK 1:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32"/>Mi onɔdɛ na ngwi onɔ kaka esɛ nɛta, inggisɛ ntona gbe emi ootse bɛyi ama esɛ dɔ ma ikye ba mbi iYesu. <verse eid="MRK 1:32"/><verse number="33" style="v" sid="MRK 1:33"/>Emi igeli na duu kwakye mi onufɛ, <verse eid="MRK 1:33"/><verse number="34" style="v" sid="MRK 1:34"/>man iYesu ngyɛlu inggisɛ gwuba ootse idzidza-dzidza. O di lɔ onodzi emɛsɛ gwuba onya, kpaa o gbela ni onodzi emɛsɛ gbɔdzɛ ba ikyekyɛ a ye itɔ inggisɛ ngwu o dzɛ mani.<verse eid="MRK 1:34"/></para>
  <para style="s1">IYesu gbeesɔ mi iGalalia</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35"/>Mi egbegbe ototu ngwi imbe ka yifu nɛ, iYesu kyato dzata udɛ lu imbe ngwi o ka dzɛ yuon, bibɔ mi ele. <verse eid="MRK 1:35"/><verse number="36" style="v" sid="MRK 1:36"/>Nɛ iSaimɔn yi angbeka ntona lu le pitan, <verse eid="MRK 1:36"/><verse number="37" style="v" sid="MRK 1:37"/>ngwi a tun nɛ, a nyan gbɛɛ, &lt;&lt;Ali inggisɛ duu le pita abu!&gt;&gt;<verse eid="MRK 1:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38"/>Nɛ iYesu nya ma gbɛɛ, &lt;&lt;I kɛ agwɔ angbeka ama nto kwɛkwɛ nɛni, zukwu nin ka gbeesɔ mi ele kpaa, lubana li ikye ungwɔ ngwi ani ba ma aali.&gt;&gt; <verse eid="MRK 1:38"/><verse number="39" style="v" sid="MRK 1:39"/>Nghanɛ o dzagaba kpatsɛ iGalalia, le gbeesɔ mi ozu okwakye mgbi emi iJuda dile lɔ emi onodzi emɛsɛ tɔ.<verse eid="MRK 1:39"/></para>
  <para style="s1">IYesu ngyɛlu inggisɛ otsoma</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40"/>Inggisɛ ndotsoma ba mbi iYesu wa kwakwafɔ esɛ tɛkyɛ nun gbɛɛ, &lt;&lt;Ni abu mina yɔ, o ki nu ani yɛɛ saan.&gt;&gt;<verse eid="MRK 1:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41"/>Ngwi iYesu li di elela kpakpa nɛman o na abɔ mgban gbo inggisɛ na ewo di nyan gbɛɛ, &lt;&lt;Ani mina; yɛɛ saan!&gt;&gt; <verse eid="MRK 1:41"/><verse number="42" style="v" sid="MRK 1:42"/>Plɛ nɛta otsoma dzanta man ootse mgban ngyɛ.<verse eid="MRK 1:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 1:43"/>IYesu si byakpa nun ofɛ no lu di kwon adɔ saan gbɛɛ: <verse eid="MRK 1:43"/><verse number="44" style="v" sid="MRK 1:44"/>&lt;&lt;Di gbɛɛ abu nya inggisɛ onyi odzɛ nɛ ba. Kpaa lu ka kye ewabu tso inggisɛ ofifɛ mgbi Imgbasho di fifɛ dafi iMose nose woola ikye oyɛɛ saan mani, no li obwɛndɛ mboma.&gt;&gt; <verse eid="MRK 1:44"/><verse number="45" style="v" sid="MRK 1:45"/>Nghaduu o lu le ka gbɔdzɛ ele dzii, dile gbɔfwɛ utsa nani. Ikyenghanɛ, iYesu yagba kaka igeli na mi ododa wuba kpaa lu ka dzɛkɛ imbe oklii. Jokpaa inggisɛ ntona dile ba mbon mi ali agya duu.<verse eid="MRK 1:45"/></para>
  <chapter eid="MRK 1"/>
  <chapter number="2" style="c" sid="MRK 2"/>
  <para style="s1">IYesu kyile inggisɛ ngbikye tukwu esɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1"/>Ngwi egbe wa sisi gwee nɛ, iYesu si yidɔ lu iKapenahun, inggisɛ ntona si fwo gbɛɛ o yɛ kaka udɛ. <verse eid="MRK 2:1"/><verse number="2" style="v" sid="MRK 2:2"/>Ta inggisɛ kwuba kwakye mbonyi, nghanɛ imbe dzɛma wuba, onufɛ mi esɛ kpaa imbe dzɛ ba. IYesu sile gbeesɔ nya ma. <verse eid="MRK 2:2"/><verse number="3" style="v" sid="MRK 2:3"/>Ta inggisɛ angbeka nghi enɛ wa to, kye inggisɛ ngbikye tukwu esɛ le ba mbi iYesu. <verse eid="MRK 2:3"/><verse number="4" style="v" sid="MRK 2:4"/>Dafi a yagba kyon kaka mbi iYesu ba ikye ibyi inggisɛ nɛ, a ka flɛ ikpendu mi ikye mgbi iYesu yɛyɛ man kyon tashulu yi amukwu wa lakiyayi iYesu. <verse eid="MRK 2:4"/><verse number="5" style="v" sid="MRK 2:5"/>Ngwi iYesu di oyɛyɛ onuunu mgbi ama nɛ, o nya inggisɛ ngbikye tukwu esɛ na gbɛɛ, &lt;&lt;Ongwɛ, a dzita abu yi ali ibwubwe mgbi abu.&gt;&gt;<verse eid="MRK 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 2:6"/>Etsetse mgbi ola mgbi iMose angbeka sɔto mmanani, a le tsɛwɛ mi itukwu mgbi ama gbɛɛ, <verse eid="MRK 2:6"/><verse number="7" style="v" sid="MRK 2:7"/>&lt;&lt;Kyɔsinɛse inggisɛ nɛ gbɔdzɛ ngha? O le kwu Imgbasho shanyɛ! Li emɛ ka dzɛ inggisɛ ta yi obube se Imgbasho yuon ta baa?&gt;&gt;<verse eid="MRK 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8"/>Plɛ nɛta, iYesu ka ye mi onodzi mgban gbɛɛ li ungwɔ ngwi a le tsɛwɛ mi itukwu mgbi ama joaali, man o nya ma gbɛɛ, &lt;&lt;I kyɔsinɛ ngwi ema le tsɛwɛ itɔ ungwɔ ntonɛ? <verse eid="MRK 2:8"/><verse number="9" style="v" sid="MRK 2:9"/>Li ole nghao sunɔ ba: onya inggisɛ ngbikye tukwu esɛ na gbɛɛ, &lt;A dzɛ abu ta yi ali ibwubwe,&gt; naadi o gbɛɛ, &lt;Kyato, kyelu obutu mgbi abu kyikyɛ&gt;? <verse eid="MRK 2:9"/><verse number="10" style="v" sid="MRK 2:10"/>Nghaduu li onu ema ye gbɛɛ Ongwɛ Inggisɛ dzɛ yi mfye mi ɛsɛ nɛ odzɛ inggisɛ ta yi ali ibwubwe…&gt;&gt; O nya inggisɛ ogbikye tukwu esɛ na gbɛɛ, <verse eid="MRK 2:10"/><verse number="11" style="v" sid="MRK 2:11"/>&lt;&lt;N nya abu, kyato, kyelu obutu mgbi abu lu udɛ.&gt;&gt; <verse eid="MRK 2:11"/><verse number="12" style="v" sid="MRK 2:12"/>O kyato, kyelu obutu mgban si kyikyɛ mi inai ma duu. Ungwɔnɛ kwulu ali inggisɛ duu ewo man a si tsɛ Imgbasho, le gbɛɛ, &lt;&lt;Eyi yama di itɔ ungwɔnɛ ye ba!&gt;&gt;<verse eid="MRK 2:12"/></para>
  <para style="s1">IYesu kwu iLevi ela</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13"/>Nɛ iYesu di yidɔ kɛ ondu utɔ mgbi iGalalia. Ibyi inggisɛ ba mbon, ta o si wita otso ma. <verse eid="MRK 2:13"/><verse number="14" style="v" sid="MRK 2:14"/>Dafi o kyikyɛ le kɛ nɛ, o di inggisɛ ogbɛ udza ifyɛɛ, iLevi ongwɛ Alfeɔ sɔdzɛ opo ogbɛ udza ifyɛɛ. Man iYesu nyan gbɛɛ, &lt;&lt;Kyɛdɔ ani,&gt;&gt; ta iLevi kyato kyɛdɔn.<verse eid="MRK 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15"/>Dafi iYesu le gye ungwogye ongwi onɔdɛ mi udɛ iLevi nɛ, ama ogbɛ udza ifyɛɛ kwuba yi &lt;&lt;emi ali ibwubwe angbeka&gt;&gt; tole gye ungwogye biyan bɛyi engwafɔɔn, lubana inggisɛ kwuba kyɛdɔn. <verse eid="MRK 2:15"/><verse number="16" style="v" sid="MRK 2:16"/>Ngwi etsetse mgbi ola mgbi iMose ama nli emi iFarasi din le gye ungwogye yi &lt;&lt;emi ali ibwubwe&gt;&gt; yi ama ogbɛ udza ifyɛɛ nɛ, a byi engwafɔɔn gbɛɛ: &lt;&lt;Kyɔsinɛ ngwi ongyukwo mgbi ema le gye ungwogye yi ama ogbɛ udza ifyɛɛ yi &lt;emi ali ibwubwe&gt;? &gt;&gt;<verse eid="MRK 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 2:17"/>Ngwi IYesu fwo ungwɔnɛ nɛ, o nya ma gbɛɛ, &lt;&lt;Li ama nle saan ma li mina inggisɛ obwe ootse ba, kpaa li emi ootse. Ani ba owa kwu ama nle saan ela ba, kpaa li emi ali ibwubwe.&gt;&gt;<verse eid="MRK 2:17"/></para>
  <para style="s1">A byi iYesu ita mi odzɛ ondu <optbreak/> otukwu-tukwu</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18"/>Onɔ oka nɛ ama okyɛ yi iJɔn okyɔ iBatisima bɛyi emi iFarasi tole tukwondu. Inggisɛ angbeka si ba wa byi iYesu gbɛɛ, &lt;&lt;Kyɔsinɛse ngwi engwafɔ mgbi iJɔn okyɔ iBatisima bɛyi engwafɔ mgbi emi iFarasi tole tukwondu, kpaa engwafɔ mgbi abu le tukwondu ba?&gt;&gt;<verse eid="MRK 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19"/>IYesu nya ma gbɛɛ, &lt;&lt;Ingyoga emi oga mgbi eba ka tukwondu onɔ ngwi obongyaa dzɛ yi ama maa? Ungwɔ ka dzɛ ngha ba du. Ngwi a ka dzɛ yi obongyaa tayɔ, a ka yama tukwondu ba. <verse eid="MRK 2:19"/><verse number="20" style="v" sid="MRK 2:20"/>Nghaduu onɔ kyɛma ngwi a ka kyi kyelu obongyaa mi idzidzɛ ma ta a ka tukwondu.<verse eid="MRK 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21"/>&lt;&lt;Inggisɛ onyi li kye ayɛ angwuto ofufɛ kye tukwu ogbugbe ba. Ki non kyɔ ngha, ayɛ ofufɛ na ka kyi kwolu di fawa angwuto ogbugbe nani, dika nu ifo na yɛɛ vɔn. <verse eid="MRK 2:21"/><verse number="22" style="v" sid="MRK 2:22"/>Inggisɛ onyi dika kye eneekwɔ ofufɛ yaokɛ ikpɔkpɔ eneekwɔ ogbugbe ba, ikyekyɛ eneekwɔ na ka nu ikpɔkpɔ gbobu, man eneekwɔ bɛyi ikpɔkpɔ duu ka nyanya. Kyɛmɛ yɔ a ka kye eneekwɔ ofufɛ yaokɛ ikpɔkpɔ ofufɛ.&gt;&gt;<verse eid="MRK 2:22"/></para>
  <para style="s1">Otsɛ mgbi egbe otonyewo mgbi <optbreak/> emi iJuda</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23"/>Egbe otonyidɔ mgbi emi iJuda oka nɛ, iYesu le kyikyɛ nyɛ okwɔ ungwogyowe, dafi engwafɔɔn wafɔ yan le kɛ nɛ, a wita ole ngwunu ungwogyowe. <verse eid="MRK 2:23"/><verse number="24" style="v" sid="MRK 2:24"/>Emi iFarasi gbɔ yan gbɛɛ, &lt;&lt;Dika, kyɔsinɛ ngwi a le kyungwɔ nli ola ba mi egbe otonyewo ngha?&gt;&gt;<verse eid="MRK 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 2:25"/>IYesu si nya ma gbɛɛ, &lt;&lt;Ema gbɔ ungwɔ ngwi iDevedi yi emi ibugen nose kyɔ mi onɔ ngwi enbwa dɔ ma ngwi a di dzɛ mi imina na baa? <verse eid="MRK 2:25"/><verse number="26" style="v" sid="MRK 2:26"/>Mi onɔ ngwi Abiata nose li okwukwo inggisɛ ofifɛ mgbi Imgbasho mani, iDevedi kaka ozu mgbi Imgbasho ka gye ibredi ngwi a kye mse bɛ ele kye dzɛkɛ kyoon, ngwi ola gbɛɛ li ama ofifɛ mgbi Imgbasho ta ka gye mani. O di kye nu emi ibugen kpaa.&gt;&gt;<verse eid="MRK 2:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 2:27"/>Nɛ iYesu nya ma gbɛɛ, &lt;&lt;A ta egbe otonyewo mi ikye inggisɛ, li inggisɛ ngwi a ta mi ikye egbe otonyewo ba. <verse eid="MRK 2:27"/><verse number="28" style="v" sid="MRK 2:28"/>Nghanɛ Ongwɛ Inggisɛ li Otsɛ mgbi egbe otonyewo kpaa.&gt;&gt;<verse eid="MRK 2:28"/></para>
  <chapter eid="MRK 2"/>
  <chapter number="3" style="c" sid="MRK 3"/>
  <para style="s1">Inggisɛ nkwulu abɔ</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1"/>Onoka nɛ iYesu kɛ ozu okwakye mgbi emi iJuda, man inggisɛ nkwulu abɔ dzɛ ele. <verse eid="MRK 3:1"/><verse number="2" style="v" sid="MRK 3:2"/>Angbeka mi ele le pita itɔdzɛ ni ama kye abɔ byi efu nun obube, nghanɛ a gbe inɛ fyakwun ikye odi non ka ngyɛlu inggisɛ na ootse mi egbe otonyewo yɔ. <verse eid="MRK 3:2"/><verse number="3" style="v" sid="MRK 3:3"/>Nɛ iYesu nya inggisɛ okwulu abɔ na gbɛɛ, &lt;&lt;Kyato dzɛkunto mi inai ali inggisɛ duu.&gt;&gt;<verse eid="MRK 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 3:4"/>Ta iYesu byi ma gbɛɛ, &lt;&lt;Li ole nghao li ola mi egbe otonyewo: okyɔ osuse naadi okyɔ obube, odulu oshishe watɔ naadi ongwɔɔngwɔ?&gt;&gt; Kpaa a gbɔdzɛ onyi ba.<verse eid="MRK 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 3:5"/>O kyidi ma kpatsɛ yi itingga man i kakan ewo lu byulu mi itukwu otiishu mgbi ama nani, iYesu nya inggisɛ na gbɛɛ, &lt;&lt;Na abɔ mgbi abu.&gt;&gt; O nan tɔ, man abɔ mgban byakpa yɛɛ saan. <verse eid="MRK 3:5"/><verse number="6" style="v" sid="MRK 3:6"/>Man emi iFarasi ntona tasɛ lu ka tsɛwɛ yi emidi iHerude dafi ama ka kyɔ duse ngwɔ iYesu mani.<verse eid="MRK 3:6"/></para>
  <para style="s1">Ijiji inggisɛ kyɛdɔ iYesu</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7"/>Man iYesu tasɛ yi engwafɔɔn lu utɔ iGalalia, nɛ ibyi inggisɛ mi iGalalia kyɛdɔn. <verse eid="MRK 3:7"/><verse number="8" style="v" sid="MRK 3:8"/>Ngwi a fwo alungwɔ ngwi o le kyɔ nɛ, inggisɛ kwuba mi iJudia, iJerosalin, Idumia yi imbe angbeka mi oyombo ekyoo iJodan bɛyi imbe angbeka kwɛkwɛ yi ogalu iTire yi iSidon ba mbon. <verse eid="MRK 3:8"/><verse number="9" style="v" sid="MRK 3:9"/>Ikyegbɛɛ inggisɛ mbwo lamyɛ nɛ, iYesu nya engwafɔɔn gbɛɛ nu ma pita ongwuwaa dzɛ fɛɛfɛ ongwu, di a wa dzi ongwu bɛkɛ esɛ. <verse eid="MRK 3:9"/><verse number="10" style="v" sid="MRK 3:10"/>Lubana o ngyɛlu inggisɛ kwuba ootse, nghanɛ ama nto yi ootse idzidza-dzidza le na kiyayi ikye ni ama kye abɔ gbon. <verse eid="MRK 3:10"/><verse number="11" style="v" sid="MRK 3:11"/>Alonɔ ngwi onodzi okpɛkpɛ din yɔ, a li gbɛsɛ lakiyayi mbon dile makwɔ gbɛɛ, &lt;&lt;Abu li Ongwɛ Imgbasho.&gt;&gt; <verse eid="MRK 3:11"/><verse number="12" style="v" sid="MRK 3:12"/>Nghaduu o wo ma ola kpakpa gbɛɛ nu ma ka gbɔ nya inggisɛ onyi itɔ inggisɛ ngwi ongwu dzɛ ba.<verse eid="MRK 3:12"/></para>
  <para style="s1">IYesu sadu ama ogbikyon iwyodefa</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13"/>IYesu tɔ lu esho mi ewunggwɔ si kwu ama ongwu mina ma ela, ta a ba mbon. <verse eid="MRK 3:13"/><verse number="14" style="v" sid="MRK 3:14"/>Nɛ o sadu iwyodefa mboma gbɛɛ nu ma li ama ogbikye ongwu, ikyegbɛɛ nu ma dzɛ yi ongwu, ni ongwu di dɔ ma tasɛ ka gbeesɔ <verse eid="MRK 3:14"/><verse number="15" style="v" sid="MRK 3:15"/>odi dzɛ yi mfye ngyɛlu ootse di lɔ onodzi ibwubwe tɔ. <verse eid="MRK 3:15"/><verse number="16" style="v" sid="MRK 3:16"/>Ntonɛ li iwyodefa ama o sadu ma aani: iSaimɔn (ongwu o nun iyi di iPyita) <verse eid="MRK 3:16"/><verse number="17" style="v" sid="MRK 3:17"/>iJɛnsi ongwɛ iDzebedi bɛyi ongwunɔn iJɔn (mboma o nu ma iyi di iBonɛgɛ, ngwi itan gbɛɛ emi ongwɛ akpala), <verse eid="MRK 3:17"/><verse number="18" style="v" sid="MRK 3:18"/>Andru, iFyilipi, iBatlomi, iMatiu, iTɔmɔsu, iJɛnsi ongwɛ Alfeɔ, iTedusu yi iSaimɔn Ogbodami <verse eid="MRK 3:18"/><verse number="19" style="v" sid="MRK 3:19"/>bɛyi iJuda Iskarɔti, ongwu nkye iYesu gya nani.<verse eid="MRK 3:19"/></para>
  <para style="s1">IYesu bɛyi utɔ mgbi onodzi emɛsɛ</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20"/>Nɛ iYesu kaka udɛ, ta ibyi inggisɛ di kwakye kpɔɔ, man iYesu yi engwafɔɔn yagba ogye ungwogye kpaa gbɛ ba. <verse eid="MRK 3:20"/><verse number="21" style="v" sid="MRK 3:21"/>Onɔ ngwi etɔ mgban fwo odzɛ nɛ nɛ, a lu ikye oka gbekabyin, ikyekyɛ a gbɛɛ, &lt;&lt;O dzɛ mi odzɛɛdzɛ mgban wuba.&gt;&gt;<verse eid="MRK 3:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22"/>Man ama otso ola mgbi iMose nkyɛ mi iJerosalin gbɛɛ, &lt;&lt;Onodzi iBɛdzɛbu wodzɛ mbi inggisɛ nɛni! O dile lɔ onodzi emɛsɛ tɔ mi mfye nani.&gt;&gt;<verse eid="MRK 3:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23"/>Nghanɛ iYesu kwu ma ela gbɔdzɛ yi ama mi utsa gbɛɛ: &lt;&lt;ISatan ka lɔ iSatan onya tɔ sinɛ? <verse eid="MRK 3:23"/><verse number="24" style="v" sid="MRK 3:24"/>Ni esutɔ gha yi ewoma, esutɔ na ka yagba kwudzɛ gbɛ ba. <verse eid="MRK 3:24"/><verse number="25" style="v" sid="MRK 3:25"/>Ni udɛ gha yi ewoma, udɛ na ka yagba kwudzɛ gbɛ ba. <verse eid="MRK 3:25"/><verse number="26" style="v" sid="MRK 3:26"/>Ma ni iSatan kye afɔ twɛsɛ yi ewon di yɛ gha, o ka kwudzɛ gbɛ ba; ongyɛɛngyɛ mgban ba sewaali. <verse eid="MRK 3:26"/><verse number="27" style="v" sid="MRK 3:27"/>Mi odzimɔ yɔ, inggisɛ onyi kpaa ka yagba kaka udɛ inggisɛ mfye gben okye ba, sede o ka tsekise bwa inggisɛ mfye na adi. Duuse o ka gben okye. <verse eid="MRK 3:27"/><verse number="28" style="v" sid="MRK 3:28"/>N nya ema otsitsi, ali ibwubwe yi ito ngwi inggisɛ le fya Imgbasho duu a ka kye toma mkpa. <verse eid="MRK 3:28"/><verse number="29" style="v" sid="MRK 3:29"/>Nghaduu inggisɛ ta nkwu Onodzi Osaan fyito, a ka dzanta yi obube ba; ikyekyɛ o kyɔ alobube nli gyegwu.&gt;&gt; <verse eid="MRK 3:29"/><verse number="30" style="v" sid="MRK 3:30"/>IYesu gbɔdzɛ nɛ ikyekyɛ a le gbɛɛ, &lt;&lt;O dzɛ yi onodzi obube mbon.&gt;&gt;<verse eid="MRK 3:30"/></para>
  <para style="s1">Onɔ iYesu yi emi ongwunɔn</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31"/>Nɛ onɔ iYesu yi emi ongwunɔn wa to. A kwulɛsɛ mi esɛ si dɔ inggisɛ oka kɛ ifun oka kwun ela. <verse eid="MRK 3:31"/><verse number="32" style="v" sid="MRK 3:32"/>Ibyi inggisɛ sisɛ kpakɛkɛ won, a si nyan gbɛɛ, &lt;&lt;Onabu yi engwunabu to esɛ le pita abu.&gt;&gt;<verse eid="MRK 3:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 3:33"/>IYesu si byita gbɛɛ, &lt;&lt;Li angbele li emi onani yi engwunani?&gt;&gt;<verse eid="MRK 3:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 3:34"/>Ta o ndinɛ mbi ama nsɔ kpakɛkɛ won ma si gbɛɛ, &lt;&lt;Dii, ntonɛ li emi onani yi engwunani aani! <verse eid="MRK 3:34"/><verse number="35" style="v" sid="MRK 3:35"/>Ali inggisɛ nkyɔ owitukwu mgbi Imgbasho li ongwunani ongyulɔ yi ongyaa bɛyi onani.&gt;&gt;<verse eid="MRK 3:35"/></para>
  <chapter eid="MRK 3"/>
  <chapter number="4" style="c" sid="MRK 4"/>
  <para style="s1">Utsa mgbi inggisɛ ofwe etɔ</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1"/>IYesu di wita otso ma mi ondu utɔ. Ibyi ama nkpakɛkɛ won ma mbwo nyɛsɛ nɛta, o kaka sɔkɛ ifu uwaa nbɛdzɛ utɔ mani, inggisɛ ntona duu kwutokɛ agobo. <verse eid="MRK 4:1"/><verse number="2" style="v" sid="MRK 4:2"/>O tso ma ungwɔ kwuba mi utsa, mi otsootso mgban ma o gbɛɛ: <verse eid="MRK 4:2"/><verse number="3" style="v" sid="MRK 4:3"/>&lt;&lt;Gadɔ! Inggisɛ okwɔ tasɛ oka fwe etɔ. <verse eid="MRK 4:3"/><verse number="4" style="v" sid="MRK 4:4"/>Dafi o le fwe nɛta, angbeka ngwuta mi ofɛ, ingwunɔ wa kye salu gye. <verse eid="MRK 4:4"/><verse number="5" style="v" sid="MRK 4:5"/>Angbeka ngwuta mi akwutsɛ, imbe ngwi ekyɛ mɛ ma saan ba, a ndzili labɔ-labɔ, ikyekyɛ ekyɛ na le hilɛhilɛ. <verse eid="MRK 4:5"/><verse number="6" style="v" sid="MRK 4:6"/>Ngwi onɔ wa tsɛ nɛ, a gbufyo, kwulu ikyekyɛ a sulu akpa ba. <verse eid="MRK 4:6"/><verse number="7" style="v" sid="MRK 4:7"/>Etɔ angbeka yaokɛ ato, ato ntona she tukwu ma, man a yagba fwɛ ba. <verse eid="MRK 4:7"/><verse number="8" style="v" sid="MRK 4:8"/>Nghaduu etɔ angbeka yangwuta mi ekyɛ osuse, lu tɔ, i she diyɛ wa kwuba, ngha ongwi ababɔ na akpe osudiwyo, ngwuseta, hona akpe ideli kpaa.&gt;&gt;<verse eid="MRK 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 4:9"/>Ta IYesu gbɛɛ, &lt;&lt;Inggisɛ nsulu adɔ ofwoofwo yɔ, no fwo.&gt;&gt;<verse eid="MRK 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10"/>Ngwi o kwudzɛ yuon nɛ, emi iwyodefa bɛyi ama nkpakɛkɛ won ma byun ita mi utsa nani. <verse eid="MRK 4:10"/><verse number="11" style="v" sid="MRK 4:11"/>O nya ma gbɛɛ, &lt;&lt;A kye ungwɔ odaada mgbi esutɔ mgbi Imgbasho kye gbɔ nya ema. Kpaa ama nto esɛ yɔ, alungwɔ duu sede ka li mi utsa ngwi a ka gbɔn nya ma <verse eid="MRK 4:11"/><verse number="12" style="v" sid="MRK 4:12"/>ikye,</para>
  <para style="q1" vid="MRK 4:12">&lt;&lt; &lt;Nu ma di kpaa,</para>
  <para style="q2" vid="MRK 4:12">a ka sakwulun ba,</para>
  <para style="q1" vid="MRK 4:12">nu ma fwo kpaa,</para>
  <para style="q2" vid="MRK 4:12">ka gbosa loma ba;</para>
  <para style="q1" vid="MRK 4:12">kana a ka wa kyata</para>
  <para style="q2" vid="MRK 4:12">nu ma dzita ma yi ali ibwubwe!&gt; &gt;&gt;<verse eid="MRK 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13"/>Ta iYesu byi ma gbɛɛ, &lt;&lt;Utsa nɛ gbosa lo ema lo? Nghama ka kyɔsinɛ ngwi utsa oka ka gbosa lo ema? <verse eid="MRK 4:13"/><verse number="14" style="v" sid="MRK 4:14"/>Inggisɛ okwɔ kye elodzɛ Imgbasho fwe. <verse eid="MRK 4:14"/><verse number="15" style="v" sid="MRK 4:15"/>Inggisɛ angbeka to dafi etɔ n yangwuta mi ofɛ nani. Labɔlabɔ ngwi a fwo mata, iSatan wa kye gbɛlu elodzɛ ngwi a kye fwe mboma mani. <verse eid="MRK 4:15"/><verse number="16" style="v" sid="MRK 4:16"/>Angbeka to dafi etɔ n yangwuta mi imbe akwutsɛ mani, a fwo elodzɛ na akponyi ta a kye gbɛlu yi atsa. <verse eid="MRK 4:16"/><verse number="17" style="v" sid="MRK 4:17"/>Nghaduu ngwi a dzɛ yi akpa ba nɛ, a dzɛ onɔ gwee ta. Ngwi okakewo hona isɔ wa ba mi ikye elodzɛ na nɛta, a byakpa yɛ atata. <verse eid="MRK 4:17"/><verse number="18" style="v" sid="MRK 4:18"/>Angbeka di to dafi etɔ ngwi a fwe yaokɛ ato mani, a fwo elodzɛ nɛni; <verse eid="MRK 4:18"/><verse number="19" style="v" sid="MRK 4:19"/>kpaa okakewo mgbi ɛsɛ nɛ, okpagyewo mgbi aludu, yi imina mgbi ungwɔ angbeka wa kaka, di dzɛ elodzɛ nɛ mmyɛ, no wa wuba. <verse eid="MRK 4:19"/><verse number="20" style="v" sid="MRK 4:20"/>Angbeka to dafi etɔ ngwi a fwe mi ekyɛ osuse, a fwo elodzɛ na kye gbɛlu, i wa ngha ungwɔ ngwi a kye fwe na akpe osudiwyo, ngwuseta, ideli jokpaa.&gt;&gt;<verse eid="MRK 4:20"/></para>
  <para style="s1">IPitila mi ikye adinyatsɛ</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21"/>O di byi ma gbɛɛ, &lt;&lt;Ema li kye ipitila kaka ikye okye mgboko tukwun, hona kye wokɛ ifagwudoo? Li mi ikye adinyatsɛ ngwi ema li kye dɔkɛ baa? <verse eid="MRK 4:21"/><verse number="22" style="v" sid="MRK 4:22"/>Lubana ungwɔ ndzɛ mi odaada duu ka yɛɛ gedee, alungwɔ ngwi a di kye tukwulu kpaa ka dɔ esɛ mi ododa. <verse eid="MRK 4:22"/><verse number="23" style="v" sid="MRK 4:23"/>Inggisɛ ndzɛ yi adɔ ofwoofwo yɔ, no fwo.&gt;&gt;<verse eid="MRK 4:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24"/>O kiyayi gbɛɛ, &lt;&lt;Kye eka byi saan mi ungwɔ ngwi abu fwo mani, li ombaamba ngwi abu mba ma ngwi a ka mba nu abu aali, jo nghaangha kpaa. <verse eid="MRK 4:24"/><verse number="25" style="v" sid="MRK 4:25"/>Ali inggisɛ nsulun yɔ a ka yɛ mbwon, ongwu nsulun ba ma, ogwee ngwi o dzɛyan ma kpaa a ka kye gbɛlu mbon.&gt;&gt;<verse eid="MRK 4:25"/></para>
  <para style="s1">Utsa mgbi etɔ oshɛɛshɛ</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26"/>O diyɛ gbɛɛ, &lt;&lt;Esutɔ mgbi Imgbasho dzɛ sini: dzɛ dafi inggisɛ kye etɔ ungwɔ fwe mi ikpɛsɛ mani. <verse eid="MRK 4:26"/><verse number="27" style="v" sid="MRK 4:27"/>Otu yi onɔ, ki non lasisa hona le nuna kpaa, o ye dafi i kyɔ se etɔ na le she ba. <verse eid="MRK 4:27"/><verse number="28" style="v" sid="MRK 4:28"/>Li ikpɛsɛ li nu ungwogye lumbye, ababɔ itan li tɔ, man li wa ngwiidɛ, se wo inɛnɛ. <verse eid="MRK 4:28"/><verse number="29" style="v" sid="MRK 4:29"/>Labɔ-labɔ ngwi etɔ na myɛ mata, o li kye agɛbɛ dɔkɛ ele, ikyekyɛ onɔ ongwa etɔ gyɔ.&gt;&gt;<verse eid="MRK 4:29"/></para>
  <para style="s1">Utsa mgbi inɛnɛ unkwodzi</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30"/>IYesu diyɛ gbɛɛ, &lt;&lt;Li alungwɔ ngwi eyi ka gbɛɛ esutɔ mgbi Imgbasho lun, naadi li ali utsa ngwi eyi ka kye tso ambɛ mi ele? <verse eid="MRK 4:30"/><verse number="31" style="v" sid="MRK 4:31"/>Dzɛ dafi inɛnɛ unkwodzi, nshanyɛ ngha inɛnɛ ali ekwɔ ngwi abu kye ye mi ikpɛsɛ mani. <verse eid="MRK 4:31"/><verse number="32" style="v" sid="MRK 4:32"/>Nghaduu ni a kye ye, li she di yɛɛ gbagbadzidzi ngha ali ekwɔ mi okwɔ duu, li tsaabɔ okwukwo jo ingwunɔ emi esho kpaa li ba wa ludɛ mi abɔn.&gt;&gt;<verse eid="MRK 4:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33"/>Yi utsa mbitɔ ntonɛ, iYesu gbɔ elodzɛ nɛ yi ama, o gbɔn kwuba gyɔ nu ma difwi mani. <verse eid="MRK 4:33"/><verse number="34" style="v" sid="MRK 4:34"/>O li dzɛdzɛ gbɔdzɛ yi ama ba sede mi utsa. Nghaduu non wa tɔ yuon yi engwafɔ mgban yɔ, o li nu ma osa mi alungwɔ duu.<verse eid="MRK 4:34"/></para>
  <para style="s1">IYesu nu awo kwulu</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35"/>Onɔdɛ mi egbe nani, o nya engwafɔɔn gbɛɛ, &lt;&lt;I kɛ oyombo na.&gt;&gt; <verse eid="MRK 4:35"/><verse number="36" style="v" sid="MRK 4:36"/>Ngwi a dzata ibyi inggisɛ mi iyikpa nɛ, a kye iYesu wafɔ yi ama, mi uwaa ngwi o tsekise sɔdzɛ efu mani. Uwaa angbeka kpaa kyɛdɔn. <verse eid="MRK 4:36"/><verse number="37" style="v" sid="MRK 4:37"/>Onikyawo gbokyɛɛ, gbe akpeni le yaokɛ uwaa jo uwaa dzɛ kwɛkwɛ osulu. <verse eid="MRK 4:37"/><verse number="38" style="v" sid="MRK 4:38"/>IYesu ladzɛ ifu uwaa kye ikye dɔdzɛ ungwɔ okye ikye dɔ efu le nuna, engwafɔɔn kyilon, a byun gbɛɛ, &lt;&lt;Otsetse, ni eyi mbe eni kwulu kpaa li itɔdzɛ mbi abu ba lɔ?&gt;&gt;<verse eid="MRK 4:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 4:39"/>O gbokyɛɛ, feela yi awo diyɛ nya akpeni gbɛɛ, &lt;&lt;Dede! Dzɛ shilididi!&gt;&gt; Man awo kwulu, imbe yɛɛ tsiin!<verse eid="MRK 4:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 4:40"/>O nya engwafɔɔn gbɛɛ, &lt;&lt;Kyɔsinɛ ngwi ema tsimio ngha? Ema sulu oyɛyɛ onuunu walo?&gt;&gt;<verse eid="MRK 4:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 4:41"/>Idzidzi kwulu ma, a yɛ byi ewoma gbɛɛ, &lt;&lt;Nɛnɛ li emɛ? Ngwi awo bɛyi akpeni kpaa li fwon?&gt;&gt;<verse eid="MRK 4:41"/></para>
  <chapter eid="MRK 4"/>
  <chapter number="5" style="c" sid="MRK 5"/>
  <para style="s1">IYesu lɔ onodzi emɛsɛ tɔ mbi inggisɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1"/>A foyombo utɔ lu ayɛsɛ iGeraseni nani. <verse eid="MRK 5:1"/><verse number="2" style="v" sid="MRK 5:2"/>Ngwi iYesu tasɛ mi uwaa mata, ongyulɔ oka yi onodzi okpɛkpɛ tɔ mi imbe endzi wa tun. <verse eid="MRK 5:2"/><verse number="3" style="v" sid="MRK 5:3"/>Inggisɛ nɛ li la imbe endzi, inggisɛ onyi dzɛma nka bwan adi gbɛ ba, kwoba yi ashi kpaa. <verse eid="MRK 5:3"/><verse number="4" style="v" sid="MRK 5:4"/>Bana a li teyi bwan afɔ yi abɔ, kpaa o li byi ashi yi iyudza ntona kye gbɔdzɛ dulu afɔ tɔ. Inggisɛ onyi fyumfye mɛ osin bɛsɛ ba. <verse eid="MRK 5:4"/><verse number="5" style="v" sid="MRK 5:5"/>Otu yi onɔ mi imbe endzi bɛyi undɔ ntona o li le teela diyɛ dzɛ ewon ifwa mi akwutsɛ.<verse eid="MRK 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6"/>Ngwi o dili iYesu mbombo mata, o tsinya ka gbe akwafɔ kwokɛ esɛ mfyumfye mi iyayi iYesu. <verse eid="MRK 5:6"/><verse number="7" style="v" sid="MRK 5:7"/>O feela kpakpa, &lt;&lt;Li ekyɛ wo abu yi ani. IYesu, Ongwɛ Imgbasho ngwu ngha mi esho? Fa mbi Imgbasho gbɛɛ abu ka nu ani adzɛ ba!&gt;&gt; <verse eid="MRK 5:7"/><verse number="8" style="v" sid="MRK 5:8"/>Ikyesinɛ iYesu teyi nyan gbɛɛ, &lt;&lt;Abu onodzi ibwubwe tasɛ mbi inggisɛ nɛni!&gt;&gt;<verse eid="MRK 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9"/>Ta iYesu byun gbɛɛ, &lt;&lt;Iyi abu di emɛ?&gt;&gt;</para>
  <para style="p" vid="MRK 5:9">O nu uka gbɛɛ, &lt;&lt;Iyi ani gbɛɛ ibyibyi, ikyekyɛ eyi le kwuba.&gt;&gt; <verse eid="MRK 5:9"/><verse number="10" style="v" sid="MRK 5:10"/>O si tɛkyɛ diyɛ gbabɔ nu iYesu gbɛɛ, no ka lɔ ama onya dzata imbe nɛ ba.<verse eid="MRK 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11"/>Obyia ibyibyi tole gye ungwogye kwɛkwɛ mi undɔ mi imbe nani. <verse eid="MRK 5:11"/><verse number="12" style="v" sid="MRK 5:12"/>Onodzi ibwubwe ntona tɛkyɛ nu iYesu gbɛɛ, &lt;&lt;Lɔlu eyi kaka obyia ntonɛni; noofɛ ni eyi kaka mboma.&gt;&gt; <verse eid="MRK 5:12"/><verse number="13" style="v" sid="MRK 5:13"/>O nu ma ofɛ, man onodzi ibwubwe ntona tasɛ lu ka yaokɛ mbi obyia ntonani. Obyi obyia na mɛ dafi idubu efa sini, a tashulu mi agblo yaokɛ utɔ si dzili.<verse eid="MRK 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14"/>Ama ongyo obyia ntona tsinya lu ka gbɔ mi igeli bɛyi ayɛsɛ nani. Inggisɛ gbe ewoma tasɛ le wa di ungwɔ nkiyayi mani. <verse eid="MRK 5:14"/><verse number="15" style="v" sid="MRK 5:15"/>Ngwi a ba mbi iYesu nɛ, a si di inggisɛ ngwu esɛ gbeka dɔn ikye nani, sɔdzɛ mmana, wo angwuto, itukwu mgban yɛɛ saan, man a tsimio. <verse eid="MRK 5:15"/><verse number="16" style="v" sid="MRK 5:16"/>Ama ndi mani a gbɔ nya inggisɛ ungwɔ nkyɔ ongyulɔ ngwu esɛ dɔn ikye nani, bɛyi odzɛ mgbi obyia ntona kpaa. <verse eid="MRK 5:16"/><verse number="17" style="v" sid="MRK 5:17"/>Nghanɛ inggisɛ ntona wita otɛɛkyɛ nu iYesu gbɛɛ no dzata ayɛsɛ mgbi ama.<verse eid="MRK 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18"/>Dafi iYesu le kaka ifu uwaa nɛ, inggisɛ ngwu esɛ dɔn ikye na tɛkyɛ gbɛɛ ongwu ki lu yan. <verse eid="MRK 5:18"/><verse number="19" style="v" sid="MRK 5:19"/>IYesu gbela ba, kpaa o gbɛɛ, &lt;&lt;Lu udɛ mbi etɔ mgbi abu dika nya ma ungwɔ okwukwo ngwi Otsɛ Imgbasho kyɔ yi abu, bɛyi itɔ elela ngwi o di abu nɛni.&gt;&gt; <verse eid="MRK 5:19"/><verse number="20" style="v" sid="MRK 5:20"/>Inggisɛ na si lu ka wita le gbɔ mi iDekapoli (ogalu iwyo ntona) ungwɔ okwukwo ngwi iYesu kyɔ mi ikye mgbi ongwu nani. I si kwulu inggisɛ duu ewo.<verse eid="MRK 5:20"/></para>
  <para style="s1">Ongwongyaa Ikwukwɔ bɛyi <optbreak/>Ongyaa Odotse</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21"/>Onɔ ngwi iYesu diyɛ fa mi uwaa dɔkɛ oyombo utɔ nɛ, ibyi inggisɛ kwuba kpakɛkɛ won ngwi o kwudzɛ ondu utɔ mani. <verse eid="MRK 5:21"/><verse number="22" style="v" sid="MRK 5:22"/>Man onyi mi idzidzɛ mgbi ama oteyi mi ozu okwakye mgbi emi iJuda, iyin di iJaru badzɛ imbe nani, ngwi o dili iYesu nɛta o si lankɛ esɛ mi iyayi, <verse eid="MRK 5:22"/><verse number="23" style="v" sid="MRK 5:23"/>diyɛ tɛkyɛ nun saan gbɛɛ, &lt;&lt;Ongwani ongyaa ongwu ongbungbɛ le kwulu, tsuutsu ba wa kye abɔ mgbi abu gbon ewo azukwu ni ewo mgban gbosa no dzɛ oshishe.&gt;&gt; <verse eid="MRK 5:23"/><verse number="24" style="v" sid="MRK 5:24"/>Nghanɛ iYesu wafɔ yan.</para>
  <para style="p" vid="MRK 5:24">Ijiji inggisɛ kyan iyikpa kwuba, imbe flengba lon. <verse eid="MRK 5:24"/><verse number="25" style="v" sid="MRK 5:25"/>Ongyaa oka kpaa dzɛ mmana ngwu teka ogyiiyɛ onova iwyodefa. <verse eid="MRK 5:25"/><verse number="26" style="v" sid="MRK 5:26"/>O gyisɔ kwuba mi abɔ mgbi ama obwe ootse, di kye mbelu ungwɔ ngwi o sulun duu, ngwi ewo kika gbosa nɛ ootse nghao kɛɛkiyayi. <verse eid="MRK 5:26"/><verse number="27" style="v" sid="MRK 5:27"/>Ngwi o fwo odzɛ iYesu nɛ, o si gbuokɛ idzidzɛ inggisɛ wa kye abɔ gbon angwuto mi iyikpa, <verse eid="MRK 5:27"/><verse number="28" style="v" sid="MRK 5:28"/>ikyekyɛ o tsɛwɛ gbɛɛ, &lt;&lt;kini ani kye abɔ gbon angwuto kpaa ta, ootse mgbɛn ka ngyɛ.&gt;&gt; <verse eid="MRK 5:28"/><verse number="29" style="v" sid="MRK 5:29"/>Labɔlabɔ nɛ eyi odɛɛdɛ mgban dzɛ man o si difwi mi idzidzɛ ewo mgban dafi isɔ na gbosa mani.<verse eid="MRK 5:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 5:30"/>IYesu jakpa difwi akponyi dafi mfye tɔ lo ongwu mi ewo mani. O kyata inɛ byi ibyi inggisɛ ntona si byita gbɛɛ, &lt;&lt;li emɛ kye abɔ gbo ani angwuto?&gt;&gt;<verse eid="MRK 5:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31"/>Emi ongwafɔ mgban nun uka gbɛɛ, &lt;&lt;Abu di inggisɛ tsiibyi wo abu, kpaa abu dile byita gbɛɛ, &lt;Li emɛ kye abɔ gbo anii?&gt; &gt;&gt;<verse eid="MRK 5:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 5:32"/>Nghaduu iYesu kiyayi ondinɛ inggisɛ nkyɔ ngha mani. <verse eid="MRK 5:32"/><verse number="33" style="v" sid="MRK 5:33"/>Ngwi ongyaa na difwi ungwɔ nkyɔn nɛ, o si ba wa lakɛ esɛ mi iyayi iYesu, ewo le shiishi lon yi imio, o si nyan otsitsi ungwɔ ndzɛ duu. <verse eid="MRK 5:33"/><verse number="34" style="v" sid="MRK 5:34"/>O nyan gbɛɛ, &lt;&lt;Ongyaa, oyɛyɛ onuunu mgbi abu ngyɛlu abu ootse. Kɛ ise diyɛ tɔ mi isɔ mgbi abu nɛni.&gt;&gt;<verse eid="MRK 5:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35"/>Ngwi iYesu kale gbɔdzɛ nɛta, engyulɔ angbeka tɔkyɛ udɛ iJaru, inggisɛ oteyi mi ozu okwakye mgbi emi iJuda. A gbɛɛ, &lt;&lt;Ongwabu kwulu ma li ekyɛ ngwi abu kale kaka otsetse ewo?&gt;&gt;<verse eid="MRK 5:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 5:36"/>IYesu gbadikye mi odzɛ ngwi a gbɔ na man, O si nya ongye oteyi ozu okwakye mgbi emi iJuda na gbɛɛ, &lt;&lt;ka tsimio ba, noyɛyɛ ta i ngyɛ.&gt;&gt;<verse eid="MRK 5:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 5:37"/>O nu inggisɛ onyi kyan iyikpa ba sede iPyita, iJɛnsi yi iJɔn ongwunɔ iJɛnsi ta. <verse eid="MRK 5:37"/><verse number="38" style="v" sid="MRK 5:38"/>Ngwi a ba udɛ ongye oteyi ozu okwakye mgbi emi iJuda nɛ, iYesu di imbe yɛɛ yuu yi akwɔ bɛyi ikwu otseetse mi ela okwukwo. <verse eid="MRK 5:38"/><verse number="39" style="v" sid="MRK 5:39"/>O kaka ifun di nya ma gbɛɛ, &lt;&lt;I kyɔsinɛ ngwi ema nu imbe suusu yi ikwu otseetse ngha? Ongwɛ nɛ kwulu ba kpaa o nanuna ta.&gt;&gt; <verse eid="MRK 5:39"/><verse number="40" style="v" sid="MRK 5:40"/>Nghaduu a shan isha.</para>
  <para style="p" vid="MRK 5:40">Onɔ ngwi o nu ma tasɛ nɛman, o kyi kyelu ama omban bɛyi engwafɔ mgban nghi eta ntona kaka ifoozu imbe ngwi ongwɛ se ladzɛ mani. <verse eid="MRK 5:40"/><verse number="41" style="v" sid="MRK 5:41"/>O kpalun abɔ nyan gbɛɛ, &lt;&lt;Italita kumi!&gt;&gt; (Itan gbɛɛ, &lt;&lt;Ongwongyaa ongbungbɛ, ani le nya abu gbɛɛ, kyato!&gt;&gt;). <verse eid="MRK 5:41"/><verse number="42" style="v" sid="MRK 5:42"/>Labɔlabɔ nɛta ongwongyaa na kyɛɛ dzɛkunto le kyikyɛ yilili kpatsɛ (o li onova iwyodefa). Mi ungwɔnɛ i kwulu ma ewo saan. <verse eid="MRK 5:42"/><verse number="43" style="v" sid="MRK 5:43"/>O wo ma ola kpɔklɔɔ gbɛɛ nu ma ka nu inggisɛ onyi ye odzɛ ele ba, o diyɛ nya ma gbɛɛ nu ma nun ungwogye no gye.<verse eid="MRK 5:43"/></para>
  <chapter eid="MRK 5"/>
  <chapter number="6" style="c" sid="MRK 6"/>
  <para style="s1">A fwa iYesu mi iNadzareti</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1"/>IYesu dzata imbe na yɛ lu igeli mgban, emi ongwafɔɔn wafɔ yan. <verse eid="MRK 6:1"/><verse number="2" style="v" sid="MRK 6:2"/>Ngwi egbe otonyidɔ mgbi emi iJuda wa gyɔ nɛ, o wita otso mi ozu okwakye mgbi emi iJuda, i kwulu ibyi inggisɛ ama nfwo ma ewo.</para>
  <para style="p" vid="MRK 6:2">A byita gbɛɛ, &lt;&lt;Li mi ole ngwi ongyulɔ nɛ tu ungwɔ ntonɛ? O tu itɔ ozoyeye nɛ mi ole jo le kyungwɔ ama okwulewo nɛ ngha lo! <verse eid="MRK 6:2"/><verse number="3" style="v" sid="MRK 6:3"/>Nɛnɛ li inggisɛ ogbokwo ungwɔ nɛ baa? Ongwɛ iMeri ongwunɔ yi iJɛnsi, iJosisi, iJuda bɛyi iSaimɔn nɛ ba na? Emi ongwunɔn engyaa to yi eyi dɛn baa?&gt;&gt; Man itukwu wulu ma yan. <verse eid="MRK 6:3"/><verse number="4" style="v" sid="MRK 6:4"/>IYesu nya ma gbɛɛ, &lt;&lt;Oyegbɔ li dzɛ yi mmwɛ mi igeli, yi etɔ bɛyi udɛ mgban ba.&gt;&gt; <verse eid="MRK 6:4"/><verse number="5" style="v" sid="MRK 6:5"/>IYesu gbela kyungwɔ okwulewo mi imbe na wuba, sede li inggisɛ emi ootse gwee ta ngwi o kye abɔ gbo ma ewo nu ootse mgbi ama ngyɛ. <verse eid="MRK 6:5"/><verse number="6" style="v" sid="MRK 6:6"/>I kwulu iYesu ewo yi okwoba-kwoba oyɛyɛ onuunu mgbi ama nani.</para>
  <para style="s1" vid="MRK 6:6">IYesu dɔ engwafɔɔn iwyodefa <optbreak/> ntonɛ esɔ</para>
  <para style="p" vid="MRK 6:6">Ta iYesu kyikyɛ kpatsɛ le tso mi agwɔ agwɔ. <verse eid="MRK 6:6"/><verse number="7" style="v" sid="MRK 6:7"/>Ngwi o kwu iwyodefa ntona ela ba mbon nɛ, o si kwu ma bɛ efa efa dɔ ma esɔ, diyɛ nu ma mfye ongha onodzi ibwubwe.<verse eid="MRK 6:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 6:8"/>Li ola ama ngwi o woma aani: &lt;&lt;Mi agaba nɛ, ka kye unkonyi byi ba na, ibredi ba, igbe ba, awuya mi ashiko ba sede okwuta ta. <verse eid="MRK 6:8"/><verse number="9" style="v" sid="MRK 6:9"/>Gbe okpafɔ wo na, kpaa ka gbe abu nghi efa byi ba. <verse eid="MRK 6:9"/><verse number="10" style="v" sid="MRK 6:10"/>Ali udɛ ngwi ema ka kaka duu, dzɛ ele nghataa mbisɔ ngwi ema ka dzata igeli nani. <verse eid="MRK 6:10"/><verse number="11" style="v" sid="MRK 6:11"/>Ali imbe ngwi a gbɛ ema hona fwo ema bayɔ, kye gbolu ombulu mi afɔ mi onɔ ngwi ema le lu mani, no yɛɛ obwɛndɛ obube mi ikye ma.&gt;&gt;<verse eid="MRK 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12"/>A tasɛ ka gbeesɔ gbɛɛ inggisɛ nu ma kyatitukwu. <verse eid="MRK 6:12"/><verse number="13" style="v" sid="MRK 6:13"/>A lɔ emɛsɛ onya tɔ mbi inggisɛ kwuba, di kye engyie kyi inggisɛ ama ndotse kwuba ikye di ngyɛlu ma ootse.<verse eid="MRK 6:13"/></para>
  <para style="s1">A dzɛ iJɔn okyɔ iBatisima ikye</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14"/>Utɔ iHerude fwo odzɛ nɛni, dafi iyi mgbi iYesu gbɔfwɛ kpatsɛ mani. Angbeka tole gbɛɛ, &lt;&lt;IJɔn okyɔ iBatisima kyɛɛ mi ikwu, li ngha ngwi mfye ama okwulewo le kyidɔ nyɛ mbon aali.&gt;&gt;<verse eid="MRK 6:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 6:15"/>Angbeka gbɛɛ, &lt;&lt;O li Elaija.&gt;&gt;</para>
  <para style="p" vid="MRK 6:15">Angbeka kiyayi gbɛɛ, &lt;&lt;O li oyegbɔ, ndzɛ dafi onyi mi idzidzɛ oyegbɔ emi tugbe ntonani.&gt;&gt;<verse eid="MRK 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 6:16"/>Nghaduu ngwi iHerude fwo ungwɔnɛ nɛ, o gbɛɛ, &lt;&lt;IJɔn inggisɛ ngwu ani dzan ikye na, yɛ kyɛɛ mi ikwu!&gt;&gt;<verse eid="MRK 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 6:17"/>Bana iHerude abuon noola nu ma bwa iJɔn, nu ma bwan adi di kyon ka wokɛ obawi. O kyungwɔnɛ ngha mi ikye iHerodia, owa iFyilipi ongwunɔn ngwu o gbɛlun yɛɛ owan nani. <verse eid="MRK 6:17"/><verse number="18" style="v" sid="MRK 6:18"/>Bana iJɔn teyi le nya iHerude gbɛɛ, &lt;&lt;Li ola ba ni abu gbɛlu ongwunabu ongyaa.&gt;&gt; <verse eid="MRK 6:18"/><verse number="19" style="v" sid="MRK 6:19"/>Nɛman iHerodia sulu owitukwu obube yi iJɔn jo i minan ongwɔn kpaa o yagba ba, <verse eid="MRK 6:19"/><verse number="20" style="v" sid="MRK 6:20"/>ikyekyɛ iHerude le mio iJɔn dile ngyon, ikyesinɛ o yon dafi o li inggisɛ onyaan dile saan mani. Ngwi iHerude fwo iJɔn nɛta ewo fwɛ lon, jokpaa i kpan ole fwon.<verse eid="MRK 6:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21"/>Mi onggyɛɛnggyɛ nɛ onɔ osuse wa ba. Mi egbe ombaamba mgban, iHerude kyɔ oga mi ikye mgbi emi idɔ mgban ama okwukwo yi oblakwutsɛ ama onoola bɛyi engyulɔ ama oteyi ɛsɛ iGalalia. <verse eid="MRK 6:21"/><verse number="22" style="v" sid="MRK 6:22"/>Ngwi ongwɛ iHerodia ongwu ongyaa ba idzidzɛ wa shufwe nɛ, i nu iHerude bɛyi ingyoga oga mgban atsa.</para>
  <para style="p" vid="MRK 6:22">Utɔ nya ongwongyaa na gbɛɛ, &lt;&lt;Bɔ ani ungwɔ ngwi abu mina duu ani ka kye nu abu.&gt;&gt; <verse eid="MRK 6:22"/><verse number="23" style="v" sid="MRK 6:23"/>Man o zondu yan mi ofaafa gbɛɛ, &lt;&lt;Alungwɔ ngwi abu bɔ duu n ka nu abu, ka mɛ anggai esutɔ mgbi ani.&gt;&gt;<verse eid="MRK 6:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 6:24"/>Ongwongyaa tasɛ ka byi onɔn gbɛɛ, &lt;&lt;Li ekyɛ ngwi ani ka bɔ nu ma kye nu ani?&gt;&gt;</para>
  <para style="p" vid="MRK 6:24">Onɔn gbɛɛ, &lt;&lt;Ikye mgbi iJɔn okyɔ iBatisima.&gt;&gt;<verse eid="MRK 6:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 6:25"/>Ongwongyaa byakpa yewo lu ifun mbi utɔ yi ibɔ nani: &lt;&lt;Ani mina ikye mgbi iJɔn okyɔ iBatisima mi akpɛtɛ onɛnɛni.&gt;&gt;<verse eid="MRK 6:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 6:26"/>Itukwu wulu utɔ kpakpa, nghaduu, ikyegbɛɛ o teyi fa mi inai ingyoga mgban nɛ, o yagba kwɔn gbɛ ba. <verse eid="MRK 6:26"/><verse number="27" style="v" sid="MRK 6:27"/>O byakpa wo ongye ongwɔ inggisɛ ola gbɛɛ no ba yi ikye mgbi iJɔn akponyi. Inggisɛ na ka kye dzɛlu iJɔn ikye mi obawi, <verse eid="MRK 6:27"/><verse number="28" style="v" sid="MRK 6:28"/>si yɛ yi ikye ma mi akpɛtɛ. Wa nu ongwongyaa se, ta o kye ka nu onɔn. <verse eid="MRK 6:28"/><verse number="29" style="v" sid="MRK 6:29"/>Ngwi a fwo ungwɔnɛ nghanɛ, engwafɔ mgbi iJɔn wa kye ikwɔ mgban ka ndzi.<verse eid="MRK 6:29"/></para>
  <para style="s1">IYesu byi inggisɛ idubu eda enbwa</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30"/>Ama ogbikye iYesu yɛ wa kpakɛkɛ won le nyan ungwɔ ngwi ama kyɔ diyɛ tso tsatsa. <verse eid="MRK 6:30"/><verse number="31" style="v" sid="MRK 6:31"/>Nɛ ikyegbɛɛ ibyi inggisɛ angbeka tole ba ba angbeka tole lu lu ngwi a tu onɔ ogye ungwɔ kpaa ba nɛ, o nya ma gbɛɛ, &lt;&lt;Bakɛ yi ani mi imbe ndede ni ema ka tonya na.&gt;&gt;<verse eid="MRK 6:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 6:32"/>Nghanɛ a wafɔ yi ewoma mi uwaa dzɛkyo lu mbi imbe dede mani. <verse eid="MRK 6:32"/><verse number="33" style="v" sid="MRK 6:33"/>Nghaduu ibyi inggisɛ di dafi a le lu nɛ, a difwi ma di ye imbe ngwi a le kɛ mani ta a tsinya tɔ mi igeli duu kye mwaamwa teyi ma ka kaka. <verse eid="MRK 6:33"/><verse number="34" style="v" sid="MRK 6:34"/>Ngwi iYesu tasɛ mi uwaa diyɛ dili ibyi inggisɛ nɛ, elela kyɔn wo ma, ikyekyɛ a yɛɛ dafi mmala ama ndzɛ yi inggisɛ ongyo ma ba mani. Ta o di tso ma ungwɔ kwuba.<verse eid="MRK 6:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 6:35"/>Mi onɔ na, dafi onɔ le gbɛsɛ wa, nɛ engwafɔ mgban ba mbon, wa nyan gbɛɛ, &lt;&lt;Imbe nɛ li ifoshɛ, onɔ di kɛ byulu. <verse eid="MRK 6:35"/><verse number="36" style="v" sid="MRK 6:36"/>Nu inggisɛ ntonɛ ofɛ zukwu nu ma lu ogalu ama nto kwɛkwɛ ka gya ungwogye abuoma gye.&gt;&gt;<verse eid="MRK 6:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 6:37"/>Nghaduu o gbɛɛ, &lt;&lt;Ema kye ungwɔ nu ma gye na.&gt;&gt;</para>
  <para style="p" vid="MRK 6:37">A nyan gbɛɛ, &lt;&lt;Nana ka mɛ udza ofyia egyata mgbi inggisɛ idɔ onyi! Ni eyi ka mbe itɔ udza na kpakpa ogya ibredi nu ma gyee?&gt;&gt;<verse eid="MRK 6:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 6:38"/>O byita gbɛɛ, &lt;&lt;Ema sulu ibredi olɔlɔ nghi eminɛ? Kɛ ka kyidi na.&gt;&gt;</para>
  <para style="p" vid="MRK 6:38">Ngwi a kɛ ka kye gbɔlu nɛ, a gbɛɛ, &lt;&lt;IBredi olɔlɔ nghi eda yi abatsa efa.&gt;&gt;<verse eid="MRK 6:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 6:39"/>Nghanɛ iYesu nu ma elodzɛ gbɛɛ, nu ma nu inggisɛ ntonɛ duu sisɛ ibwi-ibwi mi oshɛ indinda nɛni. <verse eid="MRK 6:39"/><verse number="40" style="v" sid="MRK 6:40"/>Man a si sisɛ mi otsotsa, ideli ideli bɛyi ngwusefa dɔn iwyiwyo. <verse eid="MRK 6:40"/><verse number="41" style="v" sid="MRK 6:41"/>Ngwi o kyi kyelu ibredi eda yi abatsa efa ntona, di kyile inɛ esho nɛ, o kye angba nu Imgbasho man kye mwalu ibredi ntonani. Kye nu engwafɔɔn gbɛɛ nu ma kye gha ibyi inggisɛ ntonani. O di kye ghalu abatsa efa ntona gyaakye ma duu. <verse eid="MRK 6:41"/><verse number="42" style="v" sid="MRK 6:42"/>Ama duu gye tolo. <verse eid="MRK 6:42"/><verse number="43" style="v" sid="MRK 6:43"/>Engwafɔ mgban kye salu ambulu ibredi yi abatsa nsisi ma mbwo uya iwyodefa kyɛɛ-kyɛɛ. <verse eid="MRK 6:43"/><verse number="44" style="v" sid="MRK 6:44"/>Mmbwo engyulɔ ama ngye ma li idubu eda.<verse eid="MRK 6:44"/></para>
  <para style="s1">IYesu kyikyɛ mi ikye eni</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45"/>Ngwi iYesu le wo ibyi inggisɛ ntona ofɛ nɛ, o nu engwafɔɔn plɛ kaka uwaa teyun lu iBɛtsaida, <verse eid="MRK 6:45"/><verse number="46" style="v" sid="MRK 6:46"/>Ngwi iYesu dzata ma nɛ, o tɔkɛ lu ewunggwɔ le ka bibɔ.<verse eid="MRK 6:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="MRK 6:47"/>Mi oba onɔdɛ nɛ, uwaa kye ama ntona ka to idzidzɛ utɔ, ongwu tila dzɛ esɛ yuon. <verse eid="MRK 6:47"/><verse number="48" style="v" sid="MRK 6:48"/>O di engwafɔ mgban tole gbili yi akpeni, ikyekyɛ awo le nu ma okakewo, mi obyi enɛ ongwi ikyegbe o tɔ ka tu ma, le kyikyɛ mi ikye eni. O ba dafi o ka wa nyɛ ma mani, <verse eid="MRK 6:48"/><verse number="49" style="v" sid="MRK 6:49"/>kpa ngwi a di dafi o le kyikyɛ mi ikye eni nɛ, a tsɛwɛ gbɛɛ o li onodzi inggisɛ ikwukwɔ. Man a gbobakwɔ, <verse eid="MRK 6:49"/><verse number="50" style="v" sid="MRK 6:50"/>ikyekyɛ ama duu din tsimio.</para>
  <para style="p" vid="MRK 6:50">Mi onɔ nata, o si nya ma gbɛɛ, &lt;&lt;Fyumfye itukwu na! Ka yama mio ba na, li ani.&gt;&gt; <verse eid="MRK 6:50"/><verse number="51" style="v" sid="MRK 6:51"/>Nɛ o kaka uwaa yi ama man awo kwulɛsɛ akponyi. Ta ewo fwɛ loma tsatsa, <verse eid="MRK 6:51"/><verse number="52" style="v" sid="MRK 6:52"/>ikyesinɛ ungwɔ okwulewo mgbi ibredi na gbosa loma ba; lubana a kye itukwu tiishu.<verse eid="MRK 6:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53"/>Ngwi a dzɛkyo nɛ, a ka bɛɛsɛ mi iGenesareti di kye uwaa shadi mi ele. <verse eid="MRK 6:53"/><verse number="54" style="v" sid="MRK 6:54"/>Labɔlabɔ ngwi a tɔ mi uwaa nɛman inggisɛ byakpa dilifwi iYesu. <verse eid="MRK 6:54"/><verse number="55" style="v" sid="MRK 6:55"/>A wulu onya mi ayɛsɛ na duu gbe emi ootse mi obutu lukwun kɛ imbe ngwi a fwo gbɛɛ o dzɛ duu. <verse eid="MRK 6:55"/><verse number="56" style="v" sid="MRK 6:56"/>Ali imbe mi agwɔ ngwi o kɛ duu, igeli hona agya ɛsɛ, a li gbe emi ootse wa lakɛ ifyidu. A gbabɔ nun gbɛɛ o ki nu ama kye abɔ gbo-gbo ondu angwuto mgban kpaa ta, ama nkye abɔ gbon duu ewo gbosa loma.<verse eid="MRK 6:56"/></para>
  <chapter eid="MRK 6"/>
  <chapter number="7" style="c" sid="MRK 7"/>
  <para style="s1">Osaan bɛyi okpɛkpɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1"/>Emi iFarasi bɛyi etsetse mgbi ola mgbi iMose angbeka ama nkyɛ mi iJerosalin kpakɛkɛ wo iYesu man <verse eid="MRK 7:1"/><verse number="2" style="v" sid="MRK 7:2"/>a di engwafɔ iYesu angbeka le gye una yi abɔ &lt;&lt;oshimbi-shimbi&gt;&gt; ali ma, a sabɔ ba. <verse eid="MRK 7:2"/><verse number="3" style="v" sid="MRK 7:3"/>(Emi iFarasi yi emi iJuda duu a li dzɛ-dzɛ ta gye ungwogye ba, a li sabɔ mbisɔ ola mgbi ama ma se, okyɔ aletɔ mgbi ama. <verse eid="MRK 7:3"/><verse number="4" style="v" sid="MRK 7:4"/>Kini a yɛ yi ungwogye mi idu, a li nyɛ-nyɛ gye ba sede a ka san. A di li kyɔ aletɔ mgbi ama angbeka kwuba, dafi osa ibwɛ yi okye ama okyɔ ungwogye bɛyi emi uga sini.)<verse eid="MRK 7:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5"/>Nghanɛ emi iFarasi yi etsetse mgbi ola mgbi iMose byi iYesu ita gbɛɛ: &lt;&lt;Kyɔsinɛ ngwi engwafɔ mgbi abu li dzɛ mi aletɔ mgbi engyukwo ba, ngwi a li gye ungwɔ yi abɔ oshimbi-shimbi ngha?&gt;&gt;<verse eid="MRK 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6"/>O gbɛɛ: &lt;&lt;Adzaya gbɔ li ayin mi onɔ ngwi o gbɔ ela oyegbɔ mi odzɛ ɛwɛ mgbi ema; dafi a tsekise lɔ mani gbɛɛ:</para>
  <para style="q1" vid="MRK 7:6">&lt;&lt; &lt;Inggisɛ ntonɛ li nu ani mmwɛ</para>
  <para style="q2" vid="MRK 7:6">mi ikpɔkpondu ta,</para>
  <para style="q1" vid="MRK 7:6">nghaduu itukwu mgbi</para>
  <para style="q2" vid="MRK 7:6">ama dzɛ mbombo yi ani.<verse eid="MRK 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MRK 7:7"/>A li sunu ani li ayayi,</para>
  <para style="q2" vid="MRK 7:7">Otsootso mgbi ama</para>
  <para style="q2" vid="MRK 7:7">li ola mgbi inggisɛ owamyɛ.&gt;<verse eid="MRK 7:7"/></para>
  <para style="m">
    <verse number="8" style="v" sid="MRK 7:8"/>Ema kye ola mgbi Imgbasho ngwuta yile abɔ byikɛ ola etɔ mgbi inggisɛ owamyɛ.&gt;&gt;<verse eid="MRK 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9"/>Man iYesu nya ma gbɛɛ: &lt;&lt;Ema li dzɛ yi ofɛ nkpa ema okye abɔ byikɛ ele kye ola mgbi Imgbasho ngwuta yɛ kyɛdɔ otsootso mgbi ema! <verse eid="MRK 7:9"/><verse number="10" style="v" sid="MRK 7:10"/>Lubana iMose gbɛɛ: &lt;Nu otsabu yi onabu mmwɛ,&gt; ma &lt;Ali inggisɛ ndi fya otsɔn hona onɔn ito yɔ, nu ma ngwɔn kyɛmɛ.&gt; <verse eid="MRK 7:10"/><verse number="11" style="v" sid="MRK 7:11"/>Nghaduu ema li gbɛɛ li ayin ni inggisɛ nya ama omba ma gbɛɛ, &lt;Gyen aba, n ka yagba tobyi ema ba. Ikyesinɛ n tsekise zondu okye ungwɔ ngwi ani kika kye nu ema ma, nu Imgbasho, <verse eid="MRK 7:11"/><verse number="12" style="v" sid="MRK 7:12"/>nghanɛ ema li non kyɔ unkonyi kpaa mi ikye otsɔn naadi onɔn wuba. <verse eid="MRK 7:12"/><verse number="13" style="v" sid="MRK 7:13"/>Ikyenghanɛ ema kye ngwɔlu elodzɛ Imgbasho mi aletɔ mgbi ema ngwi ema gbeto emidema esɛ nani. Ema di li kyungwɔ kwuba itɔ nani.&gt;&gt;<verse eid="MRK 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14"/>IYesu diyɛ kwu ibyi inggisɛ ela ba mbon di gbɛɛ, &lt;&lt;Ema duu gadɔ mbi ani, di difwi ungwɔnɛ na. <verse eid="MRK 7:14"/><verse number="15" style="v" sid="MRK 7:15"/>Nkonyi nka kaka mbi inggisɛ se ka non tsiidza dzɛma ba. Kpaa li ungwɔ ama ntɔ mbi inggisɛ ba esɛ mani. Li ama li non tsiidza aali.&gt;&gt; <verse eid="MRK 7:15"/><verse number="16" style="v" sid="MRK 7:16"/>(Inggisɛ ndzɛ yi adɔ yɔ non fwo.)<note caller="+" style="f"><char style="fr" closed="false">7:16 </char><char style="ft" closed="false">Ambulu nɛ dzɛ mi olɔlɔ angbeka ba. Olɔlɔ angbeka kwuba kye dzɛkɛ enggengga.</char></note><verse eid="MRK 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17"/>Mi onɔ ngwi o dzita ibyi inggisɛ lu ka kaka ozu nɛ, engwafɔɔn byun ita odzɛ mi utsa nɛni. <verse eid="MRK 7:17"/><verse number="18" style="v" sid="MRK 7:18"/>IYesu byita gbɛɛ, &lt;&lt;Ema yama difwi odzɛ ani le gbɔ nɛ walo? Ema ye saan dafi ungwogye ngwi abu kyi gye lu ifu ka nu abu &lt;tsiidza&gt; ba lo? <verse eid="MRK 7:18"/><verse number="19" style="v" sid="MRK 7:19"/>Lubana li lu itukwu mgban ba kpaa li lu ifu, di li yidɔ tɔ mi ewo mgban luba esɛ.&gt;&gt; (Mi odzɛ ngwi iYesu gbɔ nɛ, o tso gbɛɛ ali ungwogye duu &lt;&lt;Mɛ ngwi a ka gye.&gt;&gt;)<verse eid="MRK 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20"/>O kiyayi gbɛɛ: &lt;&lt;Li ungwɔ ntɔ mbi inggisɛ ma li non &lt;tsiidza aali.&gt; <verse eid="MRK 7:20"/><verse number="21" style="v" sid="MRK 7:21"/>Lubana li mi itukwu mgbi inggisɛ mi idzidzɛ, li ba yi ɛwɛ otsɛɛtsɛ ibwubwe, amah-ibwubwe, mmyi, inggisɛ ongwɔɔngwɔ, amah, <verse eid="MRK 7:21"/><verse number="22" style="v" sid="MRK 7:22"/>nggwɔ, okye inggisɛ wo itukwu, okpagyewo, imina mgbi ali ibwubwe, odi tanyi, agya, ohaha bɛyi ikwangha. <verse eid="MRK 7:22"/><verse number="23" style="v" sid="MRK 7:23"/>Ungwɔ ibwubwe ntonɛ duu li mi itukwu ngwi a li tɔ di li nu inggisɛ &lt;yɛɛ kpɛkpɛ aali.&gt; &gt;&gt;<verse eid="MRK 7:23"/></para>
  <para style="s1">Oyɛyɛ onuunu mgbi ongyaa mi <optbreak/> iSarofonishia</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24"/>IYesu lu dzata imbe nani yɛ lu ewo igeli iTiru. O kaka ozu kpaa i minan gbɛɛ inggisɛ onyi no ka ye ba; nghaduu kpaa o yagba kye ewon da ba. <verse eid="MRK 7:24"/><verse number="25" style="v" sid="MRK 7:25"/>Dafi ongyaa ngwu ongwan dzɛ yi onodzi ibwubwe ka fwo odzɛ mgban nɛ, o ba wa gbɛsɛ lankɛ iyayi. <verse eid="MRK 7:25"/><verse number="26" style="v" sid="MRK 7:26"/>Ongyaa na li iGriki, a mban mi ayɛsɛ iSiafonishia mi iSiria. O tɛkyɛ nu iYesu gbɛɛ non lɔlu emɛsɛ na tɔ mbi ongwan ongwu ongyaa.<verse eid="MRK 7:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 7:27"/>Nghaduu iYesu nyan gbɛɛ, &lt;&lt;Ababɔ ni ɛngbɛ nu ma gye ungwogye dafi a mina duuse, lubana li ayin ba okye ungwogye ndzɛ mi ikye ɛngbɛ ngwuta nu obwe.&gt;&gt;<verse eid="MRK 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 7:28"/>Ongyaa na nun uka gbɛɛ, &lt;&lt;Ɛɛn, Otsɛ iYesu, obwe ama nlato ifo adinyatsɛ ogye ungwogye mgbi ɛngbɛ kpaa, li gye ambulu ama nngwuta mani.&gt;&gt;<verse eid="MRK 7:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 7:29"/>IYesu si nyan gbɛɛ, &lt;&lt;Mi itɔ uka ngwi abu nu ani nɛ, yɛ lu udɛ abu; emɛsɛ na dzita ongwabu ongwi ongyaa na wa.&gt;&gt;<verse eid="MRK 7:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 7:30"/>O lu udɛ ta o ka di ongwan ladzɛ akwulo, dafi emɛsɛ na teyi tɔ mbon lu wa.<verse eid="MRK 7:30"/></para>
  <para style="s1">IYesu ngyɛlu inggisɛ ikplima</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31"/>Ta iYesu dzata ewo igeli iTiru yɛ nyɛ iSidon, lu utɔ iGalalia tɔ lu ayɛsɛ mgbi iDekapoli, igeli iwyo ntonani.<verse eid="MRK 7:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 7:32"/>Inggisɛ angbeka kye inggisɛ nkyadɔ di li fyonmfye ogbɔdzɛ ba mbon, si tɛkyɛ nun gbɛɛ no kye abɔ gbon ewo.<verse eid="MRK 7:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 7:33"/>Nghanɛ o kyon lu enggengga, dzata ibyi inggisɛ ntonani, iYesu gbe ongwufabɔ wonkɛ adɔ. Man o kyanggwɔ tokɛ ongwufabɔ di kye bɛ inggisɛ na mi idɛ. <verse eid="MRK 7:33"/><verse number="34" style="v" sid="MRK 7:34"/>Ta iYesu ndinɛ kɛ esho diyɛ sandu man o nyan gbɛɛ, &lt;&lt;Efata!&gt;&gt; (Itan gbɛɛ, &lt;&lt;kwulu!&gt;&gt;). <verse eid="MRK 7:34"/><verse number="35" style="v" sid="MRK 7:35"/>Mi ungwɔ ngwi iYesu kyɔ nɛ, adɔ mgbi inggisɛ na kwulu, idɛ mgban di shɛta ta o wita ogbɔdzɛ tɔ saan.<verse eid="MRK 7:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 7:36"/>IYesu kwo ma adɔ gbɛɛ nu ma ka nya inggisɛ onyi ba. Nghaduu ngwi o le kwunewo okwo ma adɔ nɛ, a nghao le kiyayi ogbɔdzɛ mi ele. <verse eid="MRK 7:36"/><verse number="37" style="v" sid="MRK 7:37"/>Nɛ ama duu ungwɔ okwulewo na kyi gbɛlu ma sɔ. A gbɔgbɛɛ, &lt;&lt;O kyɔ alungwɔ duu saan, o nu ama okyadɔ fwo di nu emi ikplima gbɔdzɛ.&gt;&gt;<verse eid="MRK 7:37"/></para>
  <chapter eid="MRK 7"/>
  <chapter number="8" style="c" sid="MRK 8"/>
  <para style="s1">IYesu byi inggisɛ idubu enɛ enbwa</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1"/>Mi egbe ntona ibyi inggisɛ angbeka di kwakye. Dafi a dzɛ yi unkonyi kpaa ngwi a ka gye ba nɛ, IYesu kwu engwafɔɔn ela ba mbon si nya ma gbɛɛ, <verse eid="MRK 8:1"/><verse number="2" style="v" sid="MRK 8:2"/>&lt;&lt;Elela kyɔ ani wo inggisɛ ntonɛni; a to yi ani mmɛnɛ egbe eta waani, ma a dzɛ yi unkonyi ogyeegye ba. <verse eid="MRK 8:2"/><verse number="3" style="v" sid="MRK 8:3"/>Kini ani nu ma ofɛ gbɛɛ nu ma lu udɛ yi enbwa ifu yɔ, a ka kwanadza mi ofɛ, ikyesinɛ angbeka kyɛ imbe otunto.&gt;&gt;<verse eid="MRK 8:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4"/>Emi ongwafɔɔn byun gbɛɛ, &lt;&lt;Nghanɛ li mi ole mi ifoshɛ nɛ ngwi inggisɛ ka tu ibredi mɛ obyi ma enbwa?&gt;&gt;<verse eid="MRK 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 8:5"/>IYesu byi ma gbɛɛ, &lt;&lt;Li ibredi eminɛ ngwi ema dzɛyan?&gt;&gt; A gbɛɛ, &lt;&lt;Egyafa.&gt;&gt;<verse eid="MRK 8:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 8:6"/>O nya ibyi inggisɛ ntona gbɛɛ nu ma sisɛ mi ombulu. Ngwi o kye gbɛlu ibredi egyafa ntona di ta Imgbasho angba nɛ, o kye mwalu gbe nu engwafɔɔn gbɛɛ nu ma gha ibyi inggisɛ ntonani, a si kyɔ ngha. <verse eid="MRK 8:6"/><verse number="7" style="v" sid="MRK 8:7"/>A di dzɛ yi engwɛ abatsa kpaa gwee, iYesu di ta Imgbasho angba mi engwɛ abatsa ntonani di nya engwafɔɔn nu ma kye gha ma. <verse eid="MRK 8:7"/><verse number="8" style="v" sid="MRK 8:8"/>Inggisɛ ntona gye di tolo. Ngwi a gye nyɛ nɛ, engwafɔɔn kye salu ambulu ama nsisi ma mbwo uya egyafa.<verse eid="MRK 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 8:9"/>Inggisɛ mɛ dafi idubu enɛ to mi onɔ nani. Ngwi iYesu nu ma ofɛ nu ma lu nɛta, <verse eid="MRK 8:9"/><verse number="10" style="v" sid="MRK 8:10"/>o kaka uwaa yi engwafɔɔn lu ayɛsɛ iDamanuta.<verse eid="MRK 8:10"/></para>
  <para style="s1">Emi iFarasi mina ambɛ okwulewo</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11"/>Emi iFarasi ba mbi iYesu wa wita obyun ita. Ikye ombadin, a pita ambɛ ongwi esho mbon. <verse eid="MRK 8:11"/><verse number="12" style="v" sid="MRK 8:12"/>O sandu lu byulu si gbɛɛ, &lt;&lt;Kyɔsinɛ ngwi etɔ nɛ le mina ambɛ okwulewo? Otsitsi ani le nya ema, ambɛ onyi kpaa a ka kye nu ma ba.&gt;&gt; <verse eid="MRK 8:12"/><verse number="13" style="v" sid="MRK 8:13"/>Ta iYesu lu dzamata, yidɔ lu ka kaka uwaa si foyombo utɔ na lu agya oka.<verse eid="MRK 8:13"/></para>
  <para style="s1">Okwuna mgbi emi iFarasi yi iHerude</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14"/>Engwafɔ iYesu gblimɔ okye ibredi byi, sede li onyi ongwi a kyɛ yan mi uwaa mata. <verse eid="MRK 8:14"/><verse number="15" style="v" sid="MRK 8:15"/>IYesu kwo ma adɔ gbɛɛ, &lt;&lt;Gbɛwɛbyi ewema na. Gbinɛbyi okwuna mgbi emi iFarasi bɛyi mgbi iHerude nani.&gt;&gt;<verse eid="MRK 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16"/>A kponya odzɛ nɛ yi ewoma si gbɛɛ, &lt;&lt;Li ikyegbɛɛ eyi dzɛ yi ibredi ba mani.&gt;&gt;<verse eid="MRK 8:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 8:17"/>IYesu difwi odzɛ ngwi a tole gbɔ yi ewoma nɛ, o byi ma gbɛɛ: &lt;&lt;Kyɔsinɛse ngwi ema le gbɔdzɛ gbɛɛ ema dzɛ yi ibredi ba? Ema kale dinɛ ba naa kale gbosa lo ema ba maa? Itukwu mgbi ema tiishuu? <verse eid="MRK 8:17"/><verse number="18" style="v" sid="MRK 8:18"/>Ema dzɛ yi inɛ kpaa li yagba di lo, di dzɛ yi adɔ kpaa li yagba ofwo lo? Ema wɛ wulo? <verse eid="MRK 8:18"/><verse number="19" style="v" sid="MRK 8:19"/>Mi onɔ ngwi ani gha ibredi nghi eda mi ikye inggisɛ idubu eda ma, ema gbe ambulu mbwo uya eminɛ?&gt;&gt;</para>
  <para style="p" vid="MRK 8:19">A nun uka gbɛɛ, &lt;&lt;Iwyodefa.&gt;&gt;<verse eid="MRK 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20"/>&lt;&lt;Ngwi ani di gha ibredi nghi egyafa mi ikye inggisɛ idubu enɛ ma, li uya eminɛ ngwi ema gbe ambulu mbweele?&gt;&gt;</para>
  <para style="p" vid="MRK 8:20">A gbɛɛ, &lt;&lt;Egyafa.&gt;&gt;<verse eid="MRK 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 8:21"/>IYesu byi ma gbɛɛ, &lt;&lt;Kale gbosa lo ema ba maa?&gt;&gt;<verse eid="MRK 8:21"/></para>
  <para style="s1">IYesu kwulu ongyulɔ obinɛ inɛ <optbreak/> mi iBɛtisaida</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22"/>A ba iBɛtsaida, man inggisɛ angbeka kye ongyulɔ obinɛ ba wa tɛkyɛ nu iYesu gbɛɛ no kye abɔ gbon. <verse eid="MRK 8:22"/><verse number="23" style="v" sid="MRK 8:23"/>O byi ongyulɔ obinɛ na abɔ di kyon tasɛ dzata ogalu. Ngwi o kyanggwɔ kyin inɛ di kye abɔ ban nɛ, iYesu byun gbɛɛ, &lt;&lt;Abu di ungwɔɔ?&gt;&gt;<verse eid="MRK 8:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 8:24"/>Obinɛ na ndinɛ kɛ esho si gbɛɛ, &lt;&lt;Ani di ibyi inggisɛ, a to dafi ekwɔ mani le kyikyɛ kpatsɛ.&gt;&gt;<verse eid="MRK 8:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 8:25"/>IYesu diyɛ kye abɔ gbon inɛ. Ta inɛ mgban kwulu, inɛ mgban yɛ, man o di alungwɔ duu saan. <verse eid="MRK 8:25"/><verse number="26" style="v" sid="MRK 8:26"/>Nɛ iYesu won ofɛ lu udɛ, di won ola gbɛɛ, &lt;&lt;Ka yɛ kɛ ogalu na wuba.&gt;&gt;<verse eid="MRK 8:26"/></para>
  <para style="s1">IPyita fwi iKrestu</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27"/>IYesu yi engwafɔɔn lu kaka agwɔ ama nto kwɛkwɛ yi iSisiria iFyilipi. Mi ofɛ ma o byi ma gbɛɛ, &lt;&lt;Inggisɛ li kwu ani di emɛ?&gt;&gt;<verse eid="MRK 8:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28"/>A nyan gbɛɛ, &lt;&lt;Angbeka li gbɛɛ iJɔn okyɔ iBatisima, angbeka gbɛɛ Elaija; angbeka yɔ li gbɛɛ, onyi mi idzidzɛ ama ogbɛɛsɛ.&gt;&gt;<verse eid="MRK 8:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 8:29"/>Nɛ o byita gbɛɛ, &lt;&lt;Nghanɛ ema ma! Ema li kwu ani di emɛ?&gt;&gt;</para>
  <para style="p" vid="MRK 8:29">IPyita nun uka gbɛɛ, &lt;&lt;Abu li iKrestu mani.&gt;&gt;<verse eid="MRK 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 8:30"/>IYesu kwo ma adɔ gbɛɛ nu ma ka nya inggisɛ onyi odzɛ mgbi ongwu ba.<verse eid="MRK 8:30"/></para>
  <para style="s1">IYesu gbɔdzɛ ikwu ewon</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31"/>Ta iYesu wita otso emi ongwafɔɔn gbɛɛ Ongwɛ Inggisɛ ka gyadzɛ ungwɔ kwuba kyɛmɛ, engyukwo dika fwan, engyukwo ama ofifɛ, bɛyi etsetse mgbi ola mgbi iMose. A ka ngwɔn mi egbe ongwu ta o dika kyɛɛ mi ikwu. <verse eid="MRK 8:31"/><verse number="32" style="v" sid="MRK 8:32"/>O gbɔdzɛ nɛ mi ododa yi engwafɔɔn, man iPyita kyen lu enggengga sika wita okyɔkyɔ yan.<verse eid="MRK 8:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 8:33"/>Kpaa ngwi iYesu kyata inɛ di engwafɔɔn nɛ, o fwa yi iPyita. O nyan gbɛɛ, &lt;&lt;Kwlekɛ mmɛnɛni iSatan! Abu dzɛ yi ungwɔ mi itukwu ama nli mgbi Imgbasho ba, kpaa li mi ɛwɛ otsɛɛtsɛ mgbi inggisɛ.&gt;&gt;<verse eid="MRK 8:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34"/>Man o kwu ibyi inggisɛ ntona ela bɛyi emi ongwafɔɔn ba mbon si nya ma gbɛɛ: &lt;&lt;Ni i mina inggisɛ o kyɛdɔ ani yɔ, o ka tangwɛ ewon dika kye ekwatsi mgban kyɛdɔ ani. <verse eid="MRK 8:34"/><verse number="35" style="v" sid="MRK 8:35"/>Lubana ali inggisɛ nmina odulu oshishe mgban tɔ yɔ, ka byulu lon, kpaa ali inggisɛ nnu oshishe mgban byulu mi ikye ani yi Esɔ Osuse yɔ, ka dulu oshishe mgban tɔ. <verse eid="MRK 8:35"/><verse number="36" style="v" sid="MRK 8:36"/>Li ali oyabɔ inggisɛ ka tu kini a kye ɛsɛ duu nun, kpaa oshishe mgban nyanya? <verse eid="MRK 8:36"/><verse number="37" style="v" sid="MRK 8:37"/>Naadi li alungwɔ ngwi inggisɛ ka kye nu ikye onyinɛ yi oshishe mgban? <verse eid="MRK 8:37"/><verse number="38" style="v" sid="MRK 8:38"/>Kini inggisɛ kwayiwi ani yi esɔ mgbi ani mi ɛsɛ amah yi etɔ ali ibwubwe nɛ yɔ, Ongwɛ Inggisɛ kpaa ka kwayiwi otsungwɔn mi onɔ ngwi o ka ba mi okwɔkwɔ mgbi Otsɔn yi engyesɔ ama osaan mani.&gt;&gt;<verse eid="MRK 8:38"/></para>
  <chapter eid="MRK 8"/>
  <chapter number="9" style="c" sid="MRK 9"/>
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1"/>Ta iYesu nya ma gbɛɛ, &lt;&lt;Ani nya ema otsitsi, inggisɛ angbeka kwulɛsɛ to mmɛnɛni a ka kwulu ba nghataa a ka di obaaba mgbi esutɔ mgbi Imgbasho yi mfye.&gt;&gt;<verse eid="MRK 9:1"/></para>
  <para style="s1">Okwɔkwɔ mgbi iYesu</para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2"/>Ngwi i wa nyɛ egbe egyin nɛ, iYesu kyelu iPyita, iJɛnsi yi iJɔn wafɔ yan kye ma tɔkɛ lu unggwɔ mi esho, ka to ele yuoma. Mi imbe na odzɛɛdzɛ mgban kyata mi inai ma. <verse eid="MRK 9:2"/><verse number="3" style="v" sid="MRK 9:3"/>Angwuto mgban kyata tundzɛ kpledede, i tundzɛ ngha ngwi inggisɛ ka kye enotse san no dzɛ ngha gbɛ. <verse eid="MRK 9:3"/><verse number="4" style="v" sid="MRK 9:4"/>Ta Elaija yi iMose wa mblegba tu ma, sile kponya yi iYesu.<figure style="fig" alt="Okwɔkwɔ mgbi iYesu" file="CN01728B.TIF" size="col" loc="9;4" copy="Cn01728b" ref="9:4">The transfiguration</figure><verse eid="MRK 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 9:5"/>IPyita gbɔ yi iYesu gbɛɛ, &lt;&lt;Otsetse, i tishi ni eyi to mmɛnɛni. Ni eyi klɛ afu nghi eta, onyi ikye abu, onyi ikye iMose, oka ikye Elaija.&gt;&gt; <verse eid="MRK 9:5"/><verse number="6" style="v" sid="MRK 9:6"/>(O ye odzɛ ngwi o ka gbɔ ba, ikyena imio wo ma kpakpa.)<verse eid="MRK 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7"/>Ta akpa tɔ mi esho wa gbiiwulu tukwu ma, ela si tɔ mi iwulu na gbɛɛ: &lt;&lt;Nɛnɛ li Ongwani itukwu-itukwu. Gadɔ mbon na!&gt;&gt;<verse eid="MRK 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 9:8"/>Labɔlabɔ mata a ndinɛ kpatsɛ, kpaa a di inggisɛ onyi yi ama wuba se li iYesu yuon.<verse eid="MRK 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9"/>Dafi a le tashulu mi unggwɔ luba esɛ nɛ, iYesu wo ma ola gbɛɛ nu ma ka nya inggisɛ onyi ungwɔ ngwi a di nɛ ba nghataa se ni Ongwɛ Inggisɛ wa kyɛɛ mi ikwu. <verse eid="MRK 9:9"/><verse number="10" style="v" sid="MRK 9:10"/>A kye odzɛ nɛ da mi itukwu mgbi ama, a yɛ le kponya ungwɔ ngwi &lt;&lt;okyɛɛ mi ikwu&gt;&gt; tso mani.<verse eid="MRK 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 9:11"/>Ta a byun gbɛɛ, &lt;&lt;Kyɔsinɛ ngwi etsetse mgbi ola mgbi iMose gbɔgbɛɛ Elaija ka teyi iKrestu ba?&gt;&gt;<verse eid="MRK 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12"/>IYesu nu ma uka gbɛɛ, &lt;&lt;Mi otsitsi, Elaija teyi ba, wa yile alungwɔ duu mɛ le fɛ-fɛ. Kpaa li Afɛ ma kpɔɔ di teyi lɔ gbɛɛ Ongwɛ Inggisɛ ka gyadzɛ kpakpa a dika fwan baa? <verse eid="MRK 9:12"/><verse number="13" style="v" sid="MRK 9:13"/>Nghaduu ani le nya ema, Elaija teyi ba wa, kpaa a kyɔ yan dafi a mina, yɛyɛ dafi Afɛ lɔ ikyon mani.&gt;&gt;<verse eid="MRK 9:13"/></para>
  <para style="s1">IYesu dulu onodzi obube tɔ <optbreak/> mbi ongwongyulɔ</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14"/>Ngwi iYesu yi engwafɔɔn eta ntona yɛ wa tu angbeka ntona nɛ, a di ibyi inggisɛ kpakɛkɛ wo ma bɛyi etsetse mgbi ola mgbi iMose tole tangwodzɛ yi ama. <verse eid="MRK 9:14"/><verse number="15" style="v" sid="MRK 9:15"/>Ngwi inɛ mgbi inggisɛ ntona gbo yi iYesu nɛ, i kwulu ma ewo man a tsinya kɛ mbon ka tan angba.<verse eid="MRK 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 9:16"/>IYesu byi emi ongwafɔɔn gbɛɛ, &lt;&lt;Li alungwɔ ngwi ema le tangwɛ yi ama mi ele?&gt;&gt;<verse eid="MRK 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 9:17"/>Ongyulɔ oka mi ibyi na nun uka gbɛɛ, &lt;&lt;Otsetse, ani kye ongwani ongyulɔ ba mbi abu, o dzɛ yi onodzi obube li non gbɔdzɛ gbɛ ba. <verse eid="MRK 9:17"/><verse number="18" style="v" sid="MRK 9:18"/>Alonɔ ngwi i dzɛsin duu, li kyon ngwuta lakɛ esɛ. O li mbwuuvu ondu, le gyaaba, di li ngwafwa kpɔklɔɔ. Ani nya engwafɔ abu gbɛɛ nu ma lɔ onodzi na tɔ, kpaa a yagba ba.&gt;&gt;<verse eid="MRK 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19"/>IYesu gbɛɛ, &lt;&lt;Kpei, ema etɔ ama onoyɛyɛ ba ntonɛ, ani ka dzɛ yi ema onɔ ka tunto sinɛ? Ani ka shitukwu yi ema onɔ ka tunto sinɛ? Kye ongwɛ ma ba mbi ani.&gt;&gt;<verse eid="MRK 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 9:20"/>A si kyon ba mbon. Ngwi onodzi na di iYesu labɔlabɔ mata, o kye ongwɛ na gyɛsɛ le kwɔɔkwɔ. O gbɛsɛ lakɛ esɛ dile myini kpatsɛ, le tsuuvu ondu.<verse eid="MRK 9:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 9:21"/>IYesu byi otsɔngwɛ na gbɛɛ, &lt;&lt;I kye onɔ sinɛ ngwi o dzɛ ngha?&gt;&gt;</para>
  <para style="p" vid="MRK 9:21">O gbɛɛ, &lt;&lt;Kyɛ esɛ mgban. <verse eid="MRK 9:21"/><verse number="22" style="v" sid="MRK 9:22"/>Li kyon ngwuta wokɛ ola naadi eni ikye ongwɔn. Nghanɛ ni abu ka yagba kyungwɔ mi ele yɔ, di eyi elela ya eyi abɔ.&gt;&gt;<verse eid="MRK 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23"/>IYesu gbɛɛ, &lt;&lt;Li ungwɔ ogbɛɛ kini abu yagbaa? Alungwɔ duu ka yagba kyɔ kyɛmɛ mbi inggisɛ nnoyɛyɛ.&gt;&gt;<verse eid="MRK 9:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 9:24"/>Labɔlabɔ nɛ otsɔngwɛ na kweela gbɛɛ, &lt;&lt;Ani noyɛyɛ; tobyi ani ni ani kɛkiyayi mi oyɛyɛ onuunu.&gt;&gt;<verse eid="MRK 9:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25"/>Ngwi iYesu di gbɛɛ ibyi inggisɛ tsinya le wa di nɛ, o fwa yi onodzi obube na gbɛɛ, &lt;&lt;Abu onodzi okyadɔ bɛyi ikplima nɛ, ani wo abu ola, tasɛ mbon dika yɛ kaka mbon wuba.&gt;&gt;<verse eid="MRK 9:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 9:26"/>Onodzi na teela di nu ongwɛ na tsa si tɔ dzanta. Ongwɛ na lakɛ dafi inggisɛ ikwukwɔ man ali inggisɛ duu gbɛɛ, &lt;&lt;O kwulu.&gt;&gt; <verse eid="MRK 9:26"/><verse number="27" style="v" sid="MRK 9:27"/>Nghaduu iYesu byin abɔ kyilen esho ta o si dzɛkunto.<verse eid="MRK 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28"/>Onɔ ngwi iYesu wa kaka ifoozu nɛ, engwafɔɔn byin ita daada gbɛɛ, &lt;&lt;Kyɔsinɛse ngwi eyi yagba lɔn tɔ ba?&gt;&gt;<verse eid="MRK 9:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 9:29"/>O nya ma gbɛɛ, &lt;&lt;Itɔ nɛ ka tɔ mi ibɔ kyoon ta!&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">9:29 </char><char style="ft" closed="false">Olɔɔlɔ angbeka gbɛɛ li mi ibɔ yi ondu otukwu-tukwu.</char></note><verse eid="MRK 9:29"/></para>
  <para style="s1">IYesu di gbɔdzɛ mi ikye ikwu ewon</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30"/>A lu dzata imbe nani, nyɛ ifu iGalalia. IYesu mina gbɛɛ ni inggisɛ onyi kpaa ye imbe ngwi ama to ba, <verse eid="MRK 9:30"/><verse number="31" style="v" sid="MRK 9:31"/>ikyekyɛ o le tso engwafɔ mgban gbɛɛ, &lt;&lt;A ka wa kye Ongwɛ Inggisɛ gya mi abɔ inggisɛ. A ka ngwɔn, ni i wa nyɛ egbe eta ta o ka kyɛɛ mi ikwu.&gt;&gt; <verse eid="MRK 9:31"/><verse number="32" style="v" sid="MRK 9:32"/>Nghaduu a difwi owitukwu mgban ba, i di wo ma imio obyun ita mi ele.<verse eid="MRK 9:32"/></para>
  <para style="s1">Li emɛ shewo ngha?</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33"/>A ba iKapenahun. Onɔ ngwi o wodzɛ ozu nɛ, o byi ma gbɛɛ, &lt;&lt;Li alungwɔ ngwi ema le tangwɛ ikyen mi ofɛ?&gt;&gt; <verse eid="MRK 9:33"/><verse number="34" style="v" sid="MRK 9:34"/>Kpaa a kwondu ba ikyekyɛ mi ofɛ ma a teyi tangwodzɛ gbɛɛ li emɛ shewo ngha.<verse eid="MRK 9:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 9:35"/>IYesu si sɔkɛ esɛ, kwu iwyodefa ntona ela nya ma gbɛɛ, &lt;&lt;Kini inggisɛ mina oli ababɔ yɔ, li kyɛmɛ o ka li olɛlɛ dika li ongbidɔ mgbi angbeka duu.&gt;&gt;<verse eid="MRK 9:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 9:36"/>O nu ongwɛ ongbungbɛ wa kwudzɛkɛ idzidzɛ mgbi ama. O kye abɔ dɔn alubɔ, si nya ma gbɛɛ, <verse eid="MRK 9:36"/><verse number="37" style="v" sid="MRK 9:37"/>&lt;&lt;Inggisɛ ta ngbɛ onyi mi idzidzɛ ɛngbɛ ntonɛ mi iyi mgbi ani yɔ, o gbɛ ani; ma inggisɛ ta ngbɛ ani yɔ, gbɛ ani ta ba kpaa li ongwu ndɔ ani esɔ mani.&gt;&gt;<verse eid="MRK 9:37"/></para>
  <para style="s1">Inggisɛ nkyili eyi ba duu li emideyi</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38"/>IJɔn gbɛɛ, &lt;&lt;Otsetse, eyi di inggisɛ oka le lɔ onodzi emɛsɛ onya tɔ mi iyi mgbi abu kpaa eyi nyan gbɛɛ non nya, ikyekyɛ o li onyi mbi eyi ba.&gt;&gt;<verse eid="MRK 9:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 9:39"/>Nɛ iYesu gbɛɛ, &lt;&lt;Ka non nya ba, inggisɛ onyi nkyungwɔ okwulewo mi iyi mgbi ani se ka yɛ kyata gbɔdzɛ oka obube ikpewo ani dzɛma ba, <verse eid="MRK 9:39"/><verse number="40" style="v" sid="MRK 9:40"/>lubana ali inggisɛ nkye iga fyi yi eyi bayɔ dzɛ yi eyi. <verse eid="MRK 9:40"/><verse number="41" style="v" sid="MRK 9:41"/>N nya ema otsitsi, inggisɛ ta nnu abu eni mi ibwɛ mi iyi mgbi ani ikyegbɛɛ ema li emi iKrestu yɔ, li kyɛmɛ-kyɛmɛ umba mgban ka nyan ba.<verse eid="MRK 9:41"/></para>
  <para style="s1">Onu inggisɛ gbɛsɛ mi obube</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42"/>&lt;&lt;Ma kini inggisɛ onyi nu onyi mi itɔ ɛngbɛ ama oshilɛlɛ ama nnoyɛyɛ mbi ani ntonɛ gbɛsɛ mi alobube yɔ, ka tatase lon nu ma kye onikwɔɔ shan onbukwɔ kyon ngwuta wokɛ ekyoo okwukwo. <verse eid="MRK 9:42"/><verse number="43" style="v" sid="MRK 9:43"/>Kini abɔ mgbi abu onyi li nu abu le gbɛsɛ mi alobube yɔ, kye dzɛlu ngwuta. I tatase ni abu kaka oshishe yi mmya ngha onu abu kaka udola yi abɔ efa. <verse eid="MRK 9:43"/><verse number="44" style="v" sid="MRK 9:44"/>(Imbe ngwi awi mgbi ama li kwulu ba, ngwi ola na kpaa li gye myunu ba nani.)<note caller="+" style="f"><char style="fr" closed="false">9:44 </char><char style="ft" closed="false">Ambulu nɛ dzɛ mi olɔɔlɔ angbeka ba.</char></note> <verse eid="MRK 9:44"/><verse number="45" style="v" sid="MRK 9:45"/>Ma kini afɔ mgbi abu onyi nu abu gbɛsɛ mi alobube yɔ, kye dzɛlu ngwuta. I tatase ni abu kaka oshishe yi afɔ onyi odzɛɛdzɛ ngha ngwi abu ka dzɛ yi afɔ efa nu ma di kye abu ngwuta wokɛ udola mani. <verse eid="MRK 9:45"/><verse number="46" style="v" sid="MRK 9:46"/>(Imbe ngwi awi mgbi ama li kwulu ba, ngwi ola na kpaa li gye myunu ba nani.)<note caller="+" style="f"><char style="fr" closed="false">9:46 </char><char style="ft" closed="false">Ambulu nɛ kpaa dzɛ mi olɔɔlɔ angbeka ba. </char></note> <verse eid="MRK 9:46"/><verse number="47" style="v" sid="MRK 9:47"/>Ma kini inɛ mgbi abu li nu abu le gbɛsɛ mi alobube yɔ, kye todulu ngwuta. I tatase ni abu kaka esutɔ mgbi Imgbasho yi inɛ onyi ngha odzɛ yi inɛ efa nu ma kye abu ngwuta wokɛ udola, <verse eid="MRK 9:47"/><verse number="48" style="v" sid="MRK 9:48"/>imbe ngwi</para>
  <para style="q1" vid="MRK 9:48">&lt;&lt; &lt;awi mgbi ama li kwulu ba,</para>
  <para style="q2" vid="MRK 9:48">ngwi ola na kpaa li gye myunu ba nani.&gt;<verse eid="MRK 9:48"/></para>
  <para style="m">
    <verse number="49" style="v" sid="MRK 9:49"/>Ama nkyɛdɔ ani duu ka nyɛ mi isɔ dafi inggisɛ li kye mmwaa dzi ungwɔ ofifɛ mgbi ama se kye toola mani.<verse eid="MRK 9:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 9:50"/>&lt;&lt;Mmwaa tishi, nghaduu ni mmwaa dzɛ yi mfya wuba, ema ka kyɔsinɛse non yɛ dzɛ yi mfya? Fyumfya dafi mmwaa yi ewema, di dzɛ mi iyu yi ewema na.&gt;&gt;<verse eid="MRK 9:50"/></para>
  <chapter eid="MRK 9"/>
  <chapter number="10" style="c" sid="MRK 10"/>
  <para style="s1">IYesu tsungwɔ mi odzɛ eba oghaagha</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1"/>Nɛta iYesu si lu dzata imbe na ka kaka ayɛsɛ iJudia di fa ekyoo iJodan. Ibyi inggisɛ di ba mbon, ta dafi o teyi li kyɔ mani, o tso ma.<verse eid="MRK 10:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 10:2"/>Emi iFarasi angbeka ba wa mbadin yi ita gbɛɛ, &lt;&lt;Li ola ni ongyulɔ gheeba yi owaan?&gt;&gt;<verse eid="MRK 10:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3"/>IYesu byi ma gbɛɛ, &lt;&lt;iMose wo ema ola sinɛ?&gt;&gt;<verse eid="MRK 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4"/>A gbɔgbɛɛ, &lt;&lt;iMose gbela gbɛɛ ni ongyulɔ dzɛ afɛ ogheeba duuse lɔ ongyaa onya lu.&gt;&gt;<verse eid="MRK 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5"/>IYesu si nya ma gbɛɛ, &lt;&lt;IMose wo ema ola nɛ ikyekyɛ ema fyumfye nu ma tso ema ungwɔ. <verse eid="MRK 10:5"/><verse number="6" style="v" sid="MRK 10:6"/>Kpaa mi owita-wita mgbi ɛsɛ ma Imgbasho &lt;Mɛ ongyulɔ yi ongyaa kyoon.&gt; <verse eid="MRK 10:6"/><verse number="7" style="v" sid="MRK 10:7"/>&lt;Ikyenghanɛ ongyulɔ ka dzata otsɔn yi onɔn yidɔ kwokyi yi owan, <verse eid="MRK 10:7"/><verse number="8" style="v" sid="MRK 10:8"/>ta ama efa ka yɛɛ ikpewo onyi.&gt; Hininɛ a yama li ikpewo efa wuba, kpaa a yɛɛ ewo onyi. <verse eid="MRK 10:8"/><verse number="9" style="v" sid="MRK 10:9"/>Nghanɛ ungwɔ ngwi Imgbasho kye kwokyi yi eka yɔ, ni inggisɛ ka gha ma ba.&gt;&gt;<verse eid="MRK 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10"/>Ngwi a yidɔ lu ozu nɛ, emi ongwafɔ iYesu byun ita mi ikye ungwɔnɛni. <verse eid="MRK 10:10"/><verse number="11" style="v" sid="MRK 10:11"/>O nu uka gbɛɛ, &lt;&lt;Ali ongyulɔ ngheeba yi owan yɛ lu ka kye ongyaa oka yɔ, le kyɔ amah biyan. <verse eid="MRK 10:11"/><verse number="12" style="v" sid="MRK 10:12"/>Ma kini ongyaa tɔ mi udɛ oban yɛ lu ka bongyulɔ oka yɔ, o kyɔ amah.&gt;&gt;<verse eid="MRK 10:12"/></para>
  <para style="s1">Ɛngbɛ ama ogyɛngyɛ yi iYesu</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13"/>Ibyi inggisɛ gbe ɛngbɛ ama ogyɛngyɛ le ba mbi iYesu onon kye abɔ gbo ma ewo, nghaduu engwafɔɔn fwa yi ama. <verse eid="MRK 10:13"/><verse number="14" style="v" sid="MRK 10:14"/>Ngwi iYesu di ungwɔnɛ nɛ, o kyitingga. O nya ma gbɛɛ, &lt;&lt;Dzata ɛngbɛ ama oshilɛlɛ nu ma ba mbi ani, ka yama kwɔ ma ba, bana esutɔ mgbi Imgbasho dzɛ mi ikye ama ntonɛ sini. <verse eid="MRK 10:14"/><verse number="15" style="v" sid="MRK 10:15"/>N nya ema otsitsi, ali inggisɛ nka gbɛ esutɔ mgbi Imgbasho dafi ongwɛ ogyɛngyɛ bayɔ, ka yagba kaka ele ba.&gt;&gt; <verse eid="MRK 10:15"/><verse number="16" style="v" sid="MRK 10:16"/>Nɛ o si kyelu ɛngbɛ ama ogyɛngyɛ ntonɛ byikɛ abɔ mgban, kye abɔ dɔ ma kye mse bɛ ma ewo.<verse eid="MRK 10:16"/></para>
  <para style="s1">Mmafa inggisɛ awuya</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17"/>Dafi iYesu kye ofɛ dikye le lu nɛ, ongyulɔ oka tsinya kɛ mbon ka kye akwafɔ kwokɛ esɛ mi iyayin. O byita gbɛɛ, &lt;&lt;Otsetse osuse, li ekyɛ ngwi ani ka kyɔ kyɛmɛ-kyɛmɛ otu oshishe igyegwu?&gt;&gt;<verse eid="MRK 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 10:18"/>IYesu nyan gbɛɛ, &lt;&lt;Kyɔsinɛ ngwi abu kwu ani di osuse? Inggisɛ onyi yama li osuse ba sede li Imgbasho yuon ta. <verse eid="MRK 10:18"/><verse number="19" style="v" sid="MRK 10:19"/>Abu ye ola: &lt;Ka ngwɔ inggisɛ ba, gbaamah ba, ka yimi ba, ka yama kyɔ obwɛndɛ atsika ba, ka kyɔ inggisɛ ogye ba, sunu otsabu yi onabu.&gt; &gt;&gt;<verse eid="MRK 10:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20"/>O nya iYesu gbɛɛ, &lt;&lt;Otsetse, ungwɔ ntonɛ duu ani kyɔ ma nyɛ ngwi ani ka li ongbɛ mani.&gt;&gt;<verse eid="MRK 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21"/>Ta iYesu din inɛ si dzɛ yi okpitukwu mbon. O nyan gbɛɛ, &lt;&lt;Ungwɔ onyi sisi mbi abu, lu, ka kye alungwɔ ngwi abu dzɛyan duu gya kye awuya ma nu emi adzɛ, ta abu ka dzɛ yi aludu mi esho. Taman yɛ, ba wa kyɛdɔ ani.&gt;&gt;<verse eid="MRK 10:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 10:22"/>Mi elodzɛ nɛ inɛ mgbi inggisɛ na si kyata mi ikye yɛɛ tsikitsiki. O tasɛ yi mtse lu, ikyena o dzɛ yi aludu shewo kpakpa.<verse eid="MRK 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23"/>Nɛ iYesu si kyata inɛ kyidi nya emi ongwafɔɔn gbɛɛ, &lt;&lt;Ka fyumfye kpakpa ni inggisɛ aludu kaka esutɔ mgbi Imgbasho!&gt;&gt;<verse eid="MRK 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 10:24"/>I kwulu engwafɔɔn ewo mi elodzɛ mgban. Kpaa iYesu di yile odzɛ nɛ gbɔ gbɛɛ, &lt;&lt;Ɛngbɛ, dafi i sunɔ okaka esutɔ mgbi Imgbasho maa! <verse eid="MRK 10:24"/><verse number="25" style="v" sid="MRK 10:25"/>Ka nghao sunɔ ba onu ilakwumyi kaka ifo edi fatɔ ngha onu inggisɛ udza kaka esutɔ mgbi Imgbasho.&gt;&gt;<verse eid="MRK 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26"/>Nɛ i nghao kwulu emi ongwafɔɔn ewo, ta a gbɔ yi ewoma gbɛɛ, &lt;&lt;Nghama li emɛ tsatso ka watɔ?&gt;&gt;<verse eid="MRK 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27"/>IYesu di ma inɛ si gbɛɛ, &lt;&lt;Mbi inggisɛ yɔ ungwɔ ka yagba dzɛ ngha gbɛ ba, nghaduu mbi Imgbasho yɔ ka yagba dzɛ ngha; bana mbi Imgbasho yɔ alungwɔ duu dzɛ kyɛmɛ-kyɛmɛ.&gt;&gt;<verse eid="MRK 10:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28"/>IPyita si nyan gbɛɛ, &lt;&lt;Eyi dzata alungwɔ duu kyɛdɔ abu!&gt;&gt;<verse eid="MRK 10:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 10:29"/>IYesu nu uka gbɛɛ, &lt;&lt;N nya ema otsitsi, inggisɛ onyi ngwu dzata udɛ naadi emi ongwunɔn engyulɔ yi engyaa naadi onɔn yi otsɔn hona ɛngbɛ naadi okwɔ mi ikye ani bɛyi Esɔ Osuse yɔ, <verse eid="MRK 10:29"/><verse number="30" style="v" sid="MRK 10:30"/>ka yama ndan owa yidɔ tuun mi onɔ ngwi eyi wodzɛ ele nɛ bɛyi onɔ ongwi iyayi ba. <verse eid="MRK 10:30"/><verse number="31" style="v" sid="MRK 10:31"/>Nghaduu emi ababɔ gwuba ka wa yɛɛ emi olɛlɛ, emi olɛlɛ dika yɛɛ emi ababɔ.&gt;&gt;<verse eid="MRK 10:31"/></para>
  <para style="s1">IYesu di gbɔdzɛ ikwu ewon</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32"/>A kye ofɛ dikye le lu iJerosalin, iYesu teyi ofɛ, man i kwulu emi ongwafɔɔn ewo, ama nkyɛ ma iyikpa kpaa imio wo ma. Ta o di gblekɛ enggengga yi emi iwyodefa ntona nya ma ungwɔ nka wa kyɔ ongwu mani. <verse eid="MRK 10:32"/><verse number="33" style="v" sid="MRK 10:33"/>O gbɔgbɛɛ, &lt;&lt;Eyi le lu iJerosalin, nɛ a ka kye Ongwɛ Inggisɛ wo engyukwo ama ofifɛ yi etsetse mgbi ola abɔ. A ka ngwɔn ikwɔ ikwongye di kyon wo Udzengye abɔ, <verse eid="MRK 10:33"/><verse number="34" style="v" sid="MRK 10:34"/>a ka nyan agya di kyanggwɔ kyin yɛ gbon ibe di ngwɔn. Ni i wa mɛ egbe eta, o ka kyato mi ikwu.&gt;&gt;<verse eid="MRK 10:34"/></para>
  <para style="s1">Ibɔ mgbi iJɛnsi bɛyi iJɔn</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35"/>Ta iJɛnsi yi iJɔn, emi ongwɛ iDzebedi, ka ba mbi iYesu. A nyan gbɛɛ, &lt;&lt;Otsetse, eyi mina gbɛɛ abu ki kyɔ eyi alungwɔ ngwi eyi mina duu.&gt;&gt;<verse eid="MRK 10:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 10:36"/>IYesu byita gbɛɛ, &lt;&lt;Li ekyɛ ngwi ema mina gbɛɛ ni ani kyɔ ema ele?&gt;&gt;<verse eid="MRK 10:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 10:37"/>A gbɛɛ, &lt;&lt;Ni onyi mbi eyi sɔ abugye mgbi abu oka mi abubɛ mi okwɔkwɔ mgbi abu.&gt;&gt;<verse eid="MRK 10:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38"/>Nɛ iYesu gbɛɛ, &lt;&lt;Ema yama ye ungwɔ ngwi ema tole mina na ba. Ema ka yagba wa mi ibwɛ ngwi ani ka wa naadi kyɔ iBatisima ngwi a kyɔ ani ma gbɛɛ?&gt;&gt;<verse eid="MRK 10:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 10:39"/>A nu uka gbɛɛ, &lt;&lt;Eyi ka yagba.&gt;&gt; Man iYesu si nya ma gbɛɛ, &lt;&lt;Ema ka wa mi ibwɛ ngwi ani wa di kyɔ iBatisima ngwi ani kyɔ mani, <verse eid="MRK 10:39"/><verse number="40" style="v" sid="MRK 10:40"/>nghaduu osɔ abugye hona abubɛ mgbi ani yama li ani ka nu ofɛ ba. Imbe ntonɛ dzɛ mi ikye mgbi ama a kye dzɛ ma mani.&gt;&gt;<verse eid="MRK 10:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41"/>Ngwi iwyo ntona fwo ungwɔnɛ nɛ, itingga kyɔ ma kpakpa yi iJɛnsi bɛyi iJɔn. <verse eid="MRK 10:41"/><verse number="42" style="v" sid="MRK 10:42"/>Man iYesu si kwu ma ela kwakye gbɔgbɛɛ, &lt;&lt;Ema ye ama ngwu a di gbɛɛ a mɛ ogbe Udzengye teyi li kyɔ mfye mboma, engyukwo ama oshewo mi idzidzɛ ma li kyɔ mfye ikpewo ma. <verse eid="MRK 10:42"/><verse number="43" style="v" sid="MRK 10:43"/>Mbi ema yama li ngha ba. Kini inggisɛ onyi mbi ema mina oyɛɛ ongbodzi inggisɛ yɔ, li kyɛmɛ-kyɛmɛ no yɛɛ ongbidɔ mgbi angbeka, <verse eid="MRK 10:43"/><verse number="44" style="v" sid="MRK 10:44"/>ma ali inggisɛ nmina oli ongwi ababɔ yɔ, li kyɛmɛ-kyɛmɛ no yɛɛ ofyɛɛ mgbi ema duu. <verse eid="MRK 10:44"/><verse number="45" style="v" sid="MRK 10:45"/>Bana Ongwɛ Inggisɛ abuon ba ikyegbɛɛ nu ma wa kyɔn idɔ ba, kpaa owa kyɔɔkyidɔ, odi kye oshishe mgban nu ikye onagbɛ ibyi inggisɛ.&gt;&gt;<verse eid="MRK 10:45"/></para>
  <para style="s1">IYesu kwulu iBatimayɔ inɛ</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46"/>Nɛ a si luba iJeriko. Dafi iYesu yi engwafɔɔn yi ibyi inggisɛ wafɔ ungwonyi le tasɛ dzata igeli nɛ, inggisɛ obinɛ ngwu a li kwun di iBatimayɔ (itan di, Ongwɛ iTimayɔ), sɔdzɛ ewo ofɛ le bibɔ. <verse eid="MRK 10:46"/><verse number="47" style="v" sid="MRK 10:47"/>Ngwi o fwo gbɛɛ li iYesu ongwi iNadzareti nɛ, o wita okweela gbɛɛ, &lt;&lt;iYesu, Ongwɛ iDevedi, di ani elela!&gt;&gt;<verse eid="MRK 10:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 10:48"/>Ibyi inggisɛ kwɔn di nyan gbɛɛ non yile ondu tukwu shili-shili, kpaa o kweela nghaabɔ ogbugbe gbɛɛ, &lt;&lt;Ongwɛ iDevedi, di ani elela!&gt;&gt;<verse eid="MRK 10:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 10:49"/>Ta iYesu si kwulɛsɛ gbɔgbɛɛ, &lt;&lt;Kwun ela na.&gt;&gt; A si kwu obinɛ na ela gbɛɛ, &lt;&lt;Dzɛ yi atsa! Kyato nto! O le kwu abu ela.&gt;&gt; <verse eid="MRK 10:49"/><verse number="50" style="v" sid="MRK 10:50"/>O si gbe angwuto mgban ngwuta mi agya oka, kyato vla kɛ mbi iYesu.<verse eid="MRK 10:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 10:51"/>Nɛ iYesu byun gbɛɛ, &lt;&lt;Li alungwɔ ngwi abu mina gbɛɛ ni ani kyɔ abu ele?&gt;&gt;</para>
  <para style="p" vid="MRK 10:51">Inggisɛ obinɛ na gbɛɛ, &lt;&lt;Otsetse, ani mina gbɛɛ n ki dinɛ.&gt;&gt;<verse eid="MRK 10:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52"/>Ta iYesu gbɛɛ, &lt;&lt;Lu, oyɛyɛ onuunu mgbi abu ngyɛlu abu ootse.&gt;&gt; Vla-vla ma jo inɛ mgban kwulu o di diyɛ kyɛdɔ iYesu mi ofɛ le lu.<verse eid="MRK 10:52"/></para>
  <chapter eid="MRK 10"/>
  <chapter number="11" style="c" sid="MRK 11"/>
  <para style="s1">IYesu kaka iJerosalin mi onghaangha</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1"/>Dafi a dzɛ kwɛkwɛ okaka iJerosalin di ba iBɛtifege bɛyi iBetani mi Unggwɔ Olivi nɛ, iYesu dɔ engwafɔɔn efa esɔ, <verse eid="MRK 11:1"/><verse number="2" style="v" sid="MRK 11:2"/>o gbɔ yi ama gbɛɛ, &lt;&lt;Kɛ agwɔ ndzɛ ema iyayi nani, ni ema kaka ele yɔ, ema ka di ongwɛ itaklimyi shadzɛ ele, ngwi inggisɛ onyi tɔɔn ye waba. Shan kye ba mmɛnɛni. <verse eid="MRK 11:2"/><verse number="3" style="v" sid="MRK 11:3"/>Kini inggisɛ byi ema gbɛɛ, &lt;Kyɔsinɛ ngwi ema le kyungwɔnɛ ngha yɔ?&gt; Nyan gbɛɛ, &lt;Odzɛ wo Otsɛ iYesu mi ele o ka wa yilen mi onɔ gwee.&gt; &gt;&gt;<verse eid="MRK 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4"/>Ta a si kɛ ka tu ongwɛ itaklimyi shadzɛ onufɛ kye inɛ byi ofɛ. Dafi a le shan nɛta, <verse eid="MRK 11:4"/><verse number="5" style="v" sid="MRK 11:5"/>inggisɛ angbeka nkwulɛsɛ to imbe na byi ma gbɛɛ, &lt;&lt;Li alungwɔ ngwi ema le kyɔ, ema le shɛ ongwɛ itaklimyi nɛɛ?&gt;&gt; <verse eid="MRK 11:5"/><verse number="6" style="v" sid="MRK 11:6"/>Nɛ a nu uka dafi iYesu tsekise nya ma mani, man inggisɛ ntona si dzamata nu ma kye lu. <verse eid="MRK 11:6"/><verse number="7" style="v" sid="MRK 11:7"/>Ngwi a kye ongwɛ itaklimyi ma ba mbi iYesu nɛ, a kye angwuto mgbi ama tukwun ekpo man iYesu tɔdɔkɛ ele. <verse eid="MRK 11:7"/><verse number="8" style="v" sid="MRK 11:8"/>Ibyi inggisɛ gbe angwuto mgbi ama tasɛ mi ofɛ, angbeka dzɛ afɛ otse mi ondu okwɔ ngwuta tokɛ esɛ mi ofɛ. <verse eid="MRK 11:8"/><verse number="9" style="v" sid="MRK 11:9"/>Ama nteyi tole kiyayi yi ama nkyɛdɔ ma ma, kweela gbɛɛ,</para>
  <para style="q1" vid="MRK 11:9">&lt;&lt;Osana!<note caller="+" style="f"><char style="fr" closed="false">11:9 </char><char style="ft" closed="false">Osana li iyi mi ondu iHibru itan di Nagbɛ! I yɛɛ iyi ungwɔ otsɛɛtsɛ </char></note></para>
  <para style="q1" vid="MRK 11:9">Mse no dzɛ yi ongwu nba</para>
  <para style="q2" vid="MRK 11:9">mi iyi mgbi Otsɛ Imgbasho nɛni!&gt;&gt;<verse eid="MRK 11:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MRK 11:10"/>&lt;&lt;Mse no dzɛ yi</para>
  <para style="q2" vid="MRK 11:10">esutɔ mgbi otseyi iDevedi nka ba nani!</para>
  <para style="q1" vid="MRK 11:10">Osana mi onghaangha!&gt;&gt;<verse eid="MRK 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11"/>Nɛ iYesu wa kaka iJerosalin si lu mi ozu okwukwo osunu Imgbasho mi iJerosalin nani. O kyidi alungwɔ tsatsadu, nghaduu ngwi onɔ gbɛsɛ wa nɛ, o tasɛ lu iBetani yi iwyodefa ntonani.<verse eid="MRK 11:11"/></para>
  <para style="s1">IYesu lɔ inggisɛ onya <optbreak/> tɔ mi ozu okwukwo osunu Imgbasho <optbreak/> mi iJerosalin</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12"/>Tegblifan dafi a le dzata ogalu mgbi iBetani nɛ, enbwa dɔ iYesu. <verse eid="MRK 11:12"/><verse number="13" style="v" sid="MRK 11:13"/>O di andundu kwo mbombo yi afɛ mi efu yugu-yugu, o si kɛ oka kyidi kaba awawa to ele. Ngwi o ka to itan nɛ, o yama tu unkonyi ba se afɛ ta, ikyena li onɔ mgban owa owawa ba. <verse eid="MRK 11:13"/><verse number="14" style="v" sid="MRK 11:14"/>O si nya ekwɔ na gbɛɛ, &lt;&lt;Inggisɛ onyi ka yama tu awawa mbi abu gye wuba.&gt;&gt; Emi ongwafɔɔn fwo dafi o gbɔ ngha mani.<verse eid="MRK 11:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15"/>Ngwi a kaka iJerosalin nɛ, iYesu kaka ozu okwukwo osunu Imgbasho mi iJerosalin na man wita olɔ ama nle kyummya bɛyi ama nle gya mi imbe na onya tɔ. O tsamu adinyatsɛ mgbi ama nle nyinɛ udza bɛyi itse osɔ efu mgbi ama nle kye ingyakpa gya, <verse eid="MRK 11:15"/><verse number="16" style="v" sid="MRK 11:16"/>di nu inggisɛ onyi ofɛ gbɛɛ non kyummya mi idzidzɛ ozu okwukwo osunu Imgbasho na ba. <verse eid="MRK 11:16"/><verse number="17" style="v" sid="MRK 11:17"/>Man o si le tso ma ungwɔ, o gbɔgbɛɛ, &lt;&lt;Afɛ lɔ gbɛɛ:</para>
  <para style="q1" vid="MRK 11:17">&lt;&lt; &lt;A ka kwu ozu mgbi ani gbɛɛ</para>
  <para style="q2" vid="MRK 11:17">ozu ibɔ mgbi ɛsɛ duu baa&gt;?</para>
  <para style="m" vid="MRK 11:17">Nghaduu ema kyatan yɛɛ &lt;imbe mgbi emumyi ama oblofɛ.&gt; &gt;&gt;<verse eid="MRK 11:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18"/>Ngwi engyukwo ama ofifɛ bɛyi etsetse mgbi ola fwo ungwɔnɛ nɛta a si wita opita ofɛ ngwi a ka ngwɔn, bana a mion, ikyekyɛ le kwulu inggisɛ duu ewo mi otsootso mgban.<verse eid="MRK 11:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 11:19"/>Ngwi onɔ gbɛsɛ nɛ, a tɔ dzata ogalu.<verse eid="MRK 11:19"/></para>
  <para style="s1">Andundu ongwɔngwɔ</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20"/>Mi egbegbe, ngwi a le lu nɛ, a di andundu na ngwɔ wita kyɛ akpa lu ikyen. <verse eid="MRK 11:20"/><verse number="21" style="v" sid="MRK 11:21"/>Ta iPyita wɛ di nya iYesu gbɛɛ, &lt;&lt;Otsetse, dii! Ekwɔ andundu ngwi abu won ikamba nɛ ngwɔ!&gt;&gt;<verse eid="MRK 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22"/>IYesu si nyan gbɛɛ, &lt;&lt;Dzɛ yi oyɛyɛ onuunu mbi Imgbasho. <verse eid="MRK 11:22"/><verse number="23" style="v" sid="MRK 11:23"/>N nya ema otsitsi, yeba ni inggisɛ nya unggwɔ nɛ gbɛɛ, &lt;Lu, kye ewabu ka ngwuta mi ekyoo okwukwo,&gt; di yama dzɛ yi angwɛ mi itukwu ba di noyɛyɛ gbɛɛ ungwɔ ngwi ongwu gbɔ na ka kyɔ ngha yɔ, a ka kyɔn ele. <verse eid="MRK 11:23"/><verse number="24" style="v" sid="MRK 11:24"/>Nghanɛ n nya ema, alungwɔ ngwi ema bɔ mi ibɔ yɔ, noyɛyɛ gbɛɛ ema tun wa, ta dika li mgbi ema. <verse eid="MRK 11:24"/><verse number="25" style="v" sid="MRK 11:25"/>Mi onɔ ngwi ema kwulɛsɛ le bibɔ yɔ, dzata angbeka ama nkyɔ ema obube. Ta Otsema ndzɛ esho na ka dzita ema yi ali ibwubwe mgbi ema.&gt;&gt; [<verse eid="MRK 11:25"/><verse number="26" style="v" sid="MRK 11:26"/>kpaa ni abu dzata inggisɛ yi obube bayɔ, Otsabu ndzɛ esho kpaa ka dzita abu yi obube mgbi abu ba.]<note caller="+" style="f"><char style="fr" closed="false">11:26 </char><char style="ft" closed="false">Ambulu nɛ dzɛ mi olɔɔlɔ angbeka ba.</char></note><verse eid="MRK 11:26"/></para>
  <para style="s1">Ita mi odzɛ mfye mgbi iYesu</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27"/>A di ba wa kaka iJerosalin, ta ngwi iYesu le kyikyɛ kyɛ mi ayɛ ozu okwukwo osunu Imgbasho nɛ, engyukwo ama ofifɛ yi etsetse mgbi ola bɛyi engyukwo emi iJuda ba mbon. <verse eid="MRK 11:27"/><verse number="28" style="v" sid="MRK 11:28"/>A byita gbɛɛ, &lt;&lt;Li mi ali mfye ngwi abu le kyungwɔ ntonɛ? Di li emɛ nu abu mfye okyungwɔ ntonɛ?&gt;&gt;<verse eid="MRK 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 11:29"/>Nɛ iYesu si gbɛɛ, &lt;&lt;Ani kpaa ka byi ema ita onyi ta. Nu ani uka na, ta n ka nya ema imbe ngwi ani tu mfye le kyungwɔ ntonɛni. <verse eid="MRK 11:29"/><verse number="30" style="v" sid="MRK 11:30"/>Nyɛn na, iBatisima mgbi iJɔn nɛ tɔkyɛ mi esho naadi mbi inggisɛ?&gt;&gt;<verse eid="MRK 11:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31"/>A si gbɔ yi ewoma gbɛɛ, &lt;&lt;Kini eyi gbɛɛ, &lt;Kyɛ mi esho,&gt; o ka byita gbɛɛ, &lt;Ma kyɔsinɛ ngwi ema nun oyɛyɛ ba?&gt; <verse eid="MRK 11:31"/><verse number="32" style="v" sid="MRK 11:32"/>Kpaa ni eyi gbɛɛ, &lt;Kyɛ mbi inggisɛ yɔ&gt;....&gt;&gt; (A tsimio ibyi inggisɛ, bana ali inggisɛ ye jo gbɛɛ iJɔn li oyegbɔ.)<verse eid="MRK 11:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 11:33"/>Nɛ a nu iYesu uka gbɛɛ, &lt;&lt;Eyi ye imbe ngwi i tɔkyɛ ba.&gt;&gt;</para>
  <para style="p" vid="MRK 11:33">Man iYesu gbɔgbɛɛ, &lt;&lt;Ngyɛse ani kpaa ka nya ema itɔ mfye ngwi ani le kyungwɔ ntonɛ ba.&gt;&gt;<verse eid="MRK 11:33"/></para>
  <chapter eid="MRK 11"/>
  <chapter number="12" style="c" sid="MRK 12"/>
  <para style="s1">Utsa mgbi emi ibwubwe ngwu <optbreak/> a kye okwɔ wo ma abɔ</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1"/>O si wita ogbɔdzɛ yi ama mi utsa gbɛɛ: &lt;&lt;Inggisɛ shi okwɔ awawekwɔ<note caller="+" style="f"><char style="fr" closed="false">12:1 </char><char style="ft" closed="false">Ekwɔ nɛ li wa owawa ngwi emi Israi nose li kye mɛ ungwɔ owawa yan.</char></note>. O mbɛ ogalu kpakɛkɛ won, di tishɛ ogbe eni owawa ekwɔ di tuo otila ikye ongyo. Ta o kye okwɔ na wo emi okwɔ angbeka abɔ si lu agaba. <verse eid="MRK 12:1"/><verse number="2" style="v" sid="MRK 12:2"/>Mi onɔ oshɛ etɔ mani, o dɔ ongbidɔ mgban esɔ mbi ama ngwu o kye okwɔ wo ma abɔ ma gbɛɛ non ka gbɛ owawa ekwɔ ongwi okwɔ na mboma. <verse eid="MRK 12:2"/><verse number="3" style="v" sid="MRK 12:3"/>Kpaa a kpaklin, gbon lɔn onya lu abubɔ. <verse eid="MRK 12:3"/><verse number="4" style="v" sid="MRK 12:4"/>Ta o di dɔ ongbidɔ oka esɔ mboma; a kye ungwɔ zudɔn ikye onun ayiwi. <verse eid="MRK 12:4"/><verse number="5" style="v" sid="MRK 12:5"/>Otsungwɔ okwɔ na diyɛ dɔ oka, ongwu na a kyon kye ngwɔlu. O di dɔ angbeka kwuba, angbeka ma, a gbo ma, angbeka yɔ, a ngwɔ ma.<verse eid="MRK 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 12:6"/>&lt;&lt;Otsungwɔ okwɔ sisi yi inggisɛ onyi ta odɛsɔ, ongwan ongwu ongyulɔ, ongwu nkpan itukwu saan. O dɔnsɔ olɛlɛ gbɛɛ, &lt;A ka nu ongwani mmwɛ.&gt;<verse eid="MRK 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 12:7"/>&lt;&lt;Nghaduu ama odi mi okwɔ ntona gbɔ yi eka gbɛɛ, &lt;Nɛnɛ li ongwɛ nka gyokwudɛ ma aani. Ba na, ni eyi ngwɔlun, ta okwudɛ ka yɛɛ mgbi eyi.&gt; <verse eid="MRK 12:7"/><verse number="8" style="v" sid="MRK 12:8"/>Nɛ a si kyon kye ngwɔlu, di kye ikwɔ mgban ngwi tasɛ mi okwɔ.<verse eid="MRK 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9"/>&lt;&lt;Li alungwɔ ngwi otsungwɔ okwɔ na ka kyɔ? O ka ba wa ngwɔlu ama ngwu o kye okwɔ wo ma abɔ ntona di yile okwɔ nu angbeka. <verse eid="MRK 12:9"/><verse number="10" style="v" sid="MRK 12:10"/>Ema gbɔ Afɛ nɛ walo:</para>
  <para style="q1" vid="MRK 12:10">&lt;&lt; &lt;Akwutsɛ ngwi ama ombɛ ozu fwan ma</para>
  <para style="q2" vid="MRK 12:10">i yɛɛ okwulu ikye ozu;<verse eid="MRK 12:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MRK 12:11"/>li Otsɛ Imgbasho kyungwɔnɛni,</para>
  <para style="q2" vid="MRK 12:11">nɛkpaa li ungwɔ okwulewo mbi eyii&gt;?&gt;&gt;<verse eid="MRK 12:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12"/>Ta a pita ofɛ obwan ikyekyɛ a ye dafi o gbɔ utsa na ikye mgbi ama. Nghaduu a le mio ibyi inggisɛ; nɛ a si dzanta lu.<verse eid="MRK 12:12"/></para>
  <para style="s1">Okpa udza ifyɛɛ nu iSidza <optbreak/> (Utɔ mgbi emi iRoma)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13"/>A dɔ emi iFarasi angbeka esɔ mi iyikpa yi emi iHerude mbi iYesu ikye oka bwan mi elodzɛ mgban. <verse eid="MRK 12:13"/><verse number="14" style="v" sid="MRK 12:14"/>A ba mbon wa gbɛɛ, &lt;&lt;Otsetse, eyi ye abu li inggisɛ otsitsi. Abu li mio inggisɛ ba, ikyekyɛ abu li kye oshewo nu inggisɛ mi odzɛɛdzɛ mgbi ama ba; kpaa abu li tso ofɛ mgbi Imgbasho imbisɔn-mbisɔn yi otsitsi. Nɛ li ola ni eyi kpa udza ifyɛɛ nu iSidza naadi li ola ba? <verse eid="MRK 12:14"/><verse number="15" style="v" sid="MRK 12:15"/>Ni eyi kpa naadi ni eyi ka kpa ba?&gt;&gt;</para>
  <para style="p" vid="MRK 12:15">Nghaduu iYesu ye ɛwɛ mgbi ama, o nu ma uka gbɛɛ, &lt;&lt;Kyɔnɛ ngwi ema le mina okya ani ukya? Kye isule ma wa nin di.&gt;&gt; <verse eid="MRK 12:15"/><verse number="16" style="v" sid="MRK 12:16"/>A kye isule ma ba, man o byi ma gbɛɛ, &lt;&lt;Nɛnɛ li onodzi mgbi emɛ dɔdzɛ ele? Di li olɔɔlɔ mgbi emɛ?&gt;&gt;</para>
  <para style="p" vid="MRK 12:16">A gbɛɛ, &lt;&lt;Li mgbi iSidza.&gt;&gt;<verse eid="MRK 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 12:17"/>IYesu si nya ma gbɛɛ, &lt;&lt;Kye ungwɔ mgbi iSidza nu iSidza di kye mgbi Imgbasho nu Imgbasho.&gt;&gt;</para>
  <para style="p" vid="MRK 12:17">Man i kwulu ma ewo biyan.<verse eid="MRK 12:17"/></para>
  <para style="s1">Eba mi onɔ okyɛɛ mi ikwu</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18"/>Nghanɛ emi iSadusi, ama ngbɛɛ okyɛɛ-kyɛɛ mi ikwu dzɛma ba ma, ba mbi iYesu yi ita. <verse eid="MRK 12:18"/><verse number="19" style="v" sid="MRK 12:19"/>A gbɛɛ, &lt;&lt;Otsetse, iMose lɔ gbɛɛ ni ongwunɔ inggisɛ kwulu dzata ongyaa kpaa mba ɛngbɛ bayɔ, inggisɛ na no yile owakwadɛ na kyɛmɛ-kyɛmɛ di mba ɛngbɛ mi ikye ongwunɔ ongwu nkwulu nani. <verse eid="MRK 12:19"/><verse number="20" style="v" sid="MRK 12:20"/>Engwuneka nghi egyafa nose to. Ongwu ababɔ kye ongyaa kwulu dzata ongwɛ onyi ba. <verse eid="MRK 12:20"/><verse number="21" style="v" sid="MRK 12:21"/>Ongwu fan yile owakwadɛ na, kpaa o di kwulu dzata ongwɛ onyi ba. Ongwu ta kpaa li ngha. <verse eid="MRK 12:21"/><verse number="22" style="v" sid="MRK 12:22"/>Mi otsitsi, onyonyi mbi engyulɔ egyafa ntonɛ dzata etɔ onyi ba. Ongyɛɛngyɛ duu, ongyaa na kpaa wa kwulu. <verse eid="MRK 12:22"/><verse number="23" style="v" sid="MRK 12:23"/>Mi egbe ngwi inggisɛ ka kyɛɛ mi ikwu ma li emɛ ngwu ongyaa nɛ ka li owan, ngwi ama egyafa duu kyon?&gt;&gt;<verse eid="MRK 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24"/>IYesu nu uka gbɛɛ, &lt;&lt;Ema boofɛ ikyegbɛɛ di ema ye ungwɔ ngwi Afɛ lɔ ba di ye mfye mgbi Imgbasho kpaa ba. <verse eid="MRK 12:24"/><verse number="25" style="v" sid="MRK 12:25"/>Bana mi onɔ ngwi inggisɛ ka kyɛɛ mi ikwu mani, a ka kye ongyaa hona kye ongwɛ nu eba wuba; a ka to dafi engyesɔ emi esho mani. <verse eid="MRK 12:25"/><verse number="26" style="v" sid="MRK 12:26"/>Mi ikye odzɛ okyɛɛ mi ikwu nɛ, ema gbɔ mi Afɛ mgbi iMose, mi odzɛ mgbi oshɛ na walo? Dafi Imgbasho nyan gbɛɛ, &lt;Ani li Imgbasho mgbi Abrahan, Imgbasho mgbi Adziki di li Imgbasho mgbi iJeko ma baa&gt;? <verse eid="MRK 12:26"/><verse number="27" style="v" sid="MRK 12:27"/>O li Imgbasho mgbi emi ikwukwɔ ba, kpaa Imgbasho mgbi emi oshishe. Ema le boofɛ timbi saan!&gt;&gt;<verse eid="MRK 12:27"/></para>
  <para style="s1">Ola onghaangha</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28"/>Onyi mi etsetse mgbi ola mgbi iMose ba wa fwo ma le tangwodzɛ. Dafi o di gbɛɛ iYesu nu ma uka osuse nɛta, o si byun gbɛɛ, &lt;&lt;Mi ola duu ma, li ole nghao wuuta?&gt;&gt;<verse eid="MRK 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29"/>IYesu nu uka gbɛɛ, &lt;&lt;Ongwu nnghao wuuta ma, li ongwu aani: &lt;Fwo na, ema emi Israi, Otsɛ Imgbasho mgbi eyi, Otsɛ na li onyi. <verse eid="MRK 12:29"/><verse number="30" style="v" sid="MRK 12:30"/>Otsɛ Imgbasho mgbi abu no kpa abu itukwu yi itukwu mgbi abu duu yi oshishe mgbi abu duu bɛyi mfye mgbi abu duu.&gt; <verse eid="MRK 12:30"/><verse number="31" style="v" sid="MRK 12:31"/>Ongwu fan yɔ: &lt;Inggisɛ nwatse dɔ abu no kpa abu itukwu dafi ewabu mani.&gt; Ola oka dzɛma nshewo ngha ola ntonɛ ba.&gt;&gt;<verse eid="MRK 12:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32"/>Otsetse mgbi ola na nu iYesu uka gbɛɛ, &lt;&lt;Otsetse, abu gbɔ tishi. Abu li ayin ogbɔgbɛɛ Imgbasho li onyi oka dzɛma ba se ongwu ta mani. <verse eid="MRK 12:32"/><verse number="33" style="v" sid="MRK 12:33"/>Onon kpa abu itukwu, yi itukwu mgbi abu duu yi oyeye mgbi abu duu bɛyi mfye mgbi abu duu, inggisɛ ongwu nwatse dɔ abu no di kpa abu itukwu dafi ewabu na, li ungwɔ nwuuta ngha umba ama otoola bɛyi ama ofifɛ duu.&gt;&gt;<verse eid="MRK 12:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 12:34"/>Ngwi iYesu di gbɛɛ o nu uka mi ozoyeye nɛ, o nyan gbɛɛ, &lt;&lt;Abu dzɛ mbombo yi esutɔ mgbi Imgbasho ba.&gt;&gt; Ta mi onɔ na lu iyayi inggisɛ onyi kpaa yagba byun ita angbeka wuba.<verse eid="MRK 12:34"/></para>
  <para style="s1">IKrestu nɛ li Ongwɛ emɛ?</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35"/>Ngwi iYesu le tso mi ozu okwukwo osunu Imgbasho mi iJerosalin nɛ, o si byita gbɛɛ, &lt;&lt;Kyɔsinɛse ngwi etsetse mgbi ola mgbi iMose gbɔgbɛɛ Ongwu Imgbasho zondu gbɛɛ o ka wa dulu ɛsɛ watɔ (iKrestu) ma li Ongwɛ iDevedi? <verse eid="MRK 12:35"/><verse number="36" style="v" sid="MRK 12:36"/>Onodzi Osaan kye iDevedi abuon kpaa teyi non gbɛɛ:</para>
  <para style="q1" vid="MRK 12:36">&lt;&lt; &lt;Otsɛ Imgbasho nya Otsɛ mgbi ani gbɛɛ:</para>
  <para style="q2" vid="MRK 12:36">&lt;&lt;Sɔkɛ mi abugye mgbi ani</para>
  <para style="q1" vid="MRK 12:36">nghataa ni ani wa nu engyikyili mgbi abu</para>
  <para style="q2" vid="MRK 12:36">yɛɛ itse mgbi abu ogbe afɔ dɔ efu.&gt;&gt; &gt;<verse eid="MRK 12:36"/></para>
  <para style="m">
    <verse number="37" style="v" sid="MRK 12:37"/>IDevedi abuon kwun di &lt;Otsɛ.&gt; Nghanɛ ka kyɔsinɛse ngwi o ka li ongwan?&gt;&gt;</para>
  <para style="p" vid="MRK 12:37">Ibyi inggisɛ ntona fwo otsootso mgbi iYesu yi atsa mi itukwu mgbi ama.<verse eid="MRK 12:37"/></para>
  <para style="s1">IYesu kwo adɔ mi otsootso mgbi <optbreak/> etsetse mgbi ola</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 12:38"/>Mi otsootso mgbi iYesu ma, o gbɛɛ, &lt;&lt;Kye inɛ byi etsetse mgbi ola na. A li mina okyikyɛ yi angwuto owulu-wulu nu ma dile ta ma angba mi ifyidu, <verse eid="MRK 12:38"/><verse number="39" style="v" sid="MRK 12:39"/>odi sɔ itse ngwi a nghao kye wuuta mi ozu okwakye mgbi emi iJuda yi imbe okpɔngɔ mi oga. <verse eid="MRK 12:39"/><verse number="40" style="v" sid="MRK 12:40"/>A li gye mmgbe mi udɛ mgbi emi owakwadɛ di li bibɔ tunto otso gbɛɛ ama tishi. Itɔ inggisɛ ntona Imgbasho ka kwo ma adɔ she kpakpa.&gt;&gt;<verse eid="MRK 12:40"/></para>
  <para style="s1">Umba mgbi owakwadɛ</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41"/>Man iYesu sisɛ mi agya imbe ngwi a gbe umba le wokɛ, le di ibyi inggisɛ kye udza mgbi ama le wokɛ mi ashiko mgbi ozu okwukwo osunu Imgbasho mi iJerosalin. Ama odzɛ yi udza kwuba kpaa kye udza mgbi ama le wokɛ ele. <verse eid="MRK 12:41"/><verse number="42" style="v" sid="MRK 12:42"/>Nghaduu ongyaa owakwadɛ adzɛ ba wa nu anini efa, ngwi mɛ ikobo onyi ta.<verse eid="MRK 12:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 12:43"/>Nɛ iYesu si kwu engwafɔɔn ela ba mbon nya ma gbɛɛ, &lt;&lt;N nya ema otsitsi, ongyaa owakwadɛ adzɛ nɛ nghao kye wokɛ mi ashiko ngha angbeka duu. <verse eid="MRK 12:43"/><verse number="44" style="v" sid="MRK 12:44"/>Ama duu a nu mi odzɛɛdzɛ mgbi aludu mgbi ama; kpaa owakwadɛ nɛ yɔ, li mi adzɛ mgban ngwi o nu, li ungwɔ ngwi o dzɛ biyan duu onon dzɛ oshishe mani.&gt;&gt;<verse eid="MRK 12:44"/></para>
  <chapter eid="MRK 12"/>
  <chapter number="13" style="c" sid="MRK 13"/>
  <para style="s1">Ambɛ mgbi ɛsɛ ongyɛɛngyɛ</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1"/>Dafi iYesu le tasɛ mi ozu okwukwo osunu Imgbasho mi iJerosalin nɛta, onyi mbi engwafɔɔn nyan gbɛɛ, &lt;&lt;Dii, Otsetse! Li ali itɔ akwutsɛ osugbɔ-osugbɔ dɛn! Li ali itɔ ozu ogbosinɛ nghalo!&gt;&gt;<verse eid="MRK 13:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 13:2"/>IYesu nyan gbɛɛ, &lt;&lt;Abu di ozu ama oshewo ntonɛ wɛ? Ikwutsɛ onyi mmɛnɛ kpaa ka sisi dɔ ikye oka ba; ali ikwutsɛ duu a ka wa kye gbobu tukwu esɛ.&gt;&gt;<verse eid="MRK 13:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3"/>Ngwi iYesu sisɛ mi Unggwɔ Olivi mi agya ozu okwukwo osunu Imgbasho mi iJerosalin nɛ, iPyita yi iJɛnsi yi iJɔn bɛyi Andru byun daada gbɛɛ, <verse eid="MRK 13:3"/><verse number="4" style="v" sid="MRK 13:4"/>&lt;&lt;Nya eyi, li alonɔ ngwi ungwɔ ntonɛ ka wa kyɔ? Dika li ali ambɛ ka tso gbɛɛ ungwɔ ntonɛ le ka mbwumbwo?&gt;&gt;<verse eid="MRK 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5"/>IYesu nya ma gbɛɛ: &lt;&lt;Gbɛwɛbyi na, ka nu inggisɛ kpagya ema wo ba. <verse eid="MRK 13:5"/><verse number="6" style="v" sid="MRK 13:6"/>Inggisɛ kwuba ka ba mi iyi mgbi ani, le gbatsika gbɛɛ, &lt;Li ani li iKrestu mani,&gt; dika kpagya inggisɛ wo kwuba. <verse eid="MRK 13:6"/><verse number="7" style="v" sid="MRK 13:7"/>Mi onɔ ngwi ema fwo ika bɛyi odzɛ a gbɛɛ mgbi ika yɔ, ka teeyi ba na. Bana ungwɔ ntonɛ duu ka kyɔ kyɛmɛ-kyɛmɛ, kpaa li ongyɛɛngyɛ ɛsɛ wa daaba. <verse eid="MRK 13:7"/><verse number="8" style="v" sid="MRK 13:8"/>Ɛsɛ ka kyɛɛ ika bɛyi ɛsɛ oka, esutɔ ka kyɛɛ ika bɛyi esutɔ oka. Ɛsɛ osuusu ka dzɛ mi imbe idzidza-dzidza, bɛyi enbwa. Ungwɔ ntonɛ li owita-wita mgbi isɔ.<verse eid="MRK 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9"/>&lt;&lt;Gbɛwɛbyi ewema kyɛmɛ-kyɛmɛ na. A ka kye ema nu mi abɔ okwakye mgbi ama ogbiikwɔ nu ma gbo ema ibe mi ozu okwakye mgbi emi iJuda. Mi ikye mgbi ani a ka kye ema ba inɛ emi iGɔna yi emi utɔ dafi obwɛndɛ mboma. <verse eid="MRK 13:9"/><verse number="10" style="v" sid="MRK 13:10"/>Ma Esɔ Osuse nɛ a ka teyi gbɔn kyɛmɛ-kyɛmɛ mi ɛsɛ duu. <verse eid="MRK 13:10"/><verse number="11" style="v" sid="MRK 13:11"/>Kini a bwa ema kye ba owa gbɔ ema ikwɔ yɔ, itukwu no ka teyi kaka ema ewo mi odzɛ ngwi ema ka gbɔ ba. Nghaduu gbɔ ali odzɛ ngwi a kye ba mbi ema mi onɔ na mani, bana li ema kale gbɔdzɛ ba, elodzɛ mgbi ema ka kyɛ mbi Onodzi Osaan.<verse eid="MRK 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 13:12"/>&lt;&lt;Inggisɛ ka kye ongwunɔn nu ikwu, otsɔngwɛ kpaa ka kye ongwan nu. Ɛngbɛ ka ngha ama omba ma adɔ di nu ma kwikwu. <verse eid="MRK 13:12"/><verse number="13" style="v" sid="MRK 13:13"/>Inggisɛ duu ka kyili ema mi ikye ani, nghaduu inggisɛ nkwulɛsɛ kpɔklɔɔ ba ongyɛɛngyɛ ka watɔ.<verse eid="MRK 13:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14"/>&lt;&lt;Mi onɔ ngwi ema di ungwɔ &lt;idza nka nu odzili-dzili&gt; kwulɛsɛ dzɛ imbe ngwi i wogyɔ gbɛɛ ki dzɛ bayɔ, inggisɛ nle gbɔ ungwɔ olɔɔlɔ ma no difwi, nɛ ama nto iJudia nu ma tsinya lu unggwɔ. <verse eid="MRK 13:14"/><verse number="15" style="v" sid="MRK 13:15"/>Ni inggisɛ onyi ndɔdzɛ ikyendu mgban ka tashulu ba esɛ naadi kaka ozu oka kye ungwɔ onyi tasɛ ba. <verse eid="MRK 13:15"/><verse number="16" style="v" sid="MRK 13:16"/>Ni inggisɛ onyi nkɛdzɛ okwɔ kpaa yɛ ba udɛ owa gbe angwuto mgban ba. <verse eid="MRK 13:16"/><verse number="17" style="v" sid="MRK 13:17"/>Nghaduu odzɛ ka tu engyaa ama nto yi ifewo yi ama nle nu ɛngbɛ abɛ mi egbe ntonani! <verse eid="MRK 13:17"/><verse number="18" style="v" sid="MRK 13:18"/>Ema bibɔ gbɛɛ ungwɔnɛ no ka kyɔ mi owa ba, <verse eid="MRK 13:18"/><verse number="19" style="v" sid="MRK 13:19"/>ikyekyɛ egbe ntona ka li egbe adzɛ ngwi Imgbasho ta ɛsɛ jo itɔ adzɛ na yama dzɛ ngha ye ba, ma dika dzɛ ngha onɔ onyi kpaa wuba. <verse eid="MRK 13:19"/><verse number="20" style="v" sid="MRK 13:20"/>Kini Otsɛ Imgbasho kye mwalu egbe ntona bayɔ, inggisɛ onyi kika watɔ ba. Kpaa mi ikye ama ngwu o sadu mayɔ, o kye mwalu egbe nani. <verse eid="MRK 13:20"/><verse number="21" style="v" sid="MRK 13:21"/>Mi onɔ na kini inggisɛ nya ema gbɛɛ, &lt;Dii, Ongwu Imgbasho zondu gbɛɛ o ka dulu ɛsɛ watɔ ma (iKrestu) dzana!&gt; Hona, &lt;Dii, o dzɛ aali!&gt; Ka noyɛyɛ mi ele ba. <verse eid="MRK 13:21"/><verse number="22" style="v" sid="MRK 13:22"/>Bana emi iKrestu atsika bɛyi oyegbɔ emi atsika ka tole kyɔ ambɛ bɛyi ungwɔ ama okwukwo ikye okpagya ama a sadu ma ma wo, ki no li kyɛmɛ-kyɛmɛ yɔ. <verse eid="MRK 13:22"/><verse number="23" style="v" sid="MRK 13:23"/>Nghanɛ gbɛwɛbyi ewema na; ani teyi nya ema alungwɔ duuse ni onɔ na wa gyɔ.<verse eid="MRK 13:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24"/>&lt;&lt;Nghaduu ni adzɛ na wa nyɛ mata,</para>
  <para style="q1" vid="MRK 13:24">&lt;&lt; &lt;onɔ ka yifu,</para>
  <para style="q2" vid="MRK 13:24">ofyia dika tso osa mgban wuba;<verse eid="MRK 13:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="MRK 13:25"/>mcɛ ka yangwuta mi esho,</para>
  <para style="q2" vid="MRK 13:25">Imgbasho ka kyɔ mfye,</para>
  <para style="q1" vid="MRK 13:25">alungwɔ mi esho duu ka suusu.&gt;<verse eid="MRK 13:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 13:26"/>&lt;&lt;Mi onɔ na inggisɛ ka di Ongwɛ Inggisɛ kyɛ akpa mi esho yi mfye okwulewo bɛyi okwɔkwɔ. <verse eid="MRK 13:26"/><verse number="27" style="v" sid="MRK 13:27"/>Ta o ka dɔ engyesɔ mgban esɔ mi ayɛsɛ enɛ wa gbe ama ngwu o sadu mi odondu mgbi ɛsɛ nghataa lu mi odondu mgbi esho ma duu kwakye mbonyi.<verse eid="MRK 13:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28"/>&lt;&lt;Ikyenghanɛ kpayi ozoyeye nɛ mbi ekwɔ andundu na: Ni abɔn kyinda di baafɛ mata, ema li ye dafi li akyonova mani. <verse eid="MRK 13:28"/><verse number="29" style="v" sid="MRK 13:29"/>Nghaduukpaa, ni ema di ungwɔ ntonɛ le kyɔ yɔ, ye na gbɛɛ dzɛ kwɛkwɛ, jo okaka onufozu. <verse eid="MRK 13:29"/><verse number="30" style="v" sid="MRK 13:30"/>N le nya ema otsitsi, ungwɔ ntonɛ duu ka kyɔ se ɛsɛ nɛ ka ngyɛ. <verse eid="MRK 13:30"/><verse number="31" style="v" sid="MRK 13:31"/>Esho yi esɛ ka nyɛ, kpaa elodzɛ mgbi ani ka yagba nyɛ ba.<verse eid="MRK 13:31"/></para>
  <para style="s1">Inggisɛ ye egbe hona onɔ ma ba</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32"/>&lt;&lt;Inggisɛ onyi ye egbe hona onɔ ma ba, engyesɔ emi esho kpaa ye ba, naadi Ongwɛ, kpaa li Otsɛ Imgbasho yuon ye. <verse eid="MRK 13:32"/><verse number="33" style="v" sid="MRK 13:33"/>Kwasisa di ngyo na! Bana ema ye egbe ngwi onɔ na ka ba ba. <verse eid="MRK 13:33"/><verse number="34" style="v" sid="MRK 13:34"/>Dzɛ dafi inggisɛ le lu agaba: O dzata udɛ di gbe engbidɔ mgban tokɛ mi ungwɔ mgban duu, ali inggisɛ mgbi ama yɔ o nun idɔ mgban, di nya ongwu ndzɛ onufozu ma gbɛɛ non ngyo.<verse eid="MRK 13:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 13:35"/>&lt;&lt;Nghanɛ le ngyo na bana ema ye onɔ ngwi otsungwudɛ na ka yɛ ba, kyayina ka li mi onɔdɛ, naadi ka li mi idzidzɛ otu, hona mi onɔ ngwi ogbigbi ka teela, naadi ka li mi ikyegbe ho. <verse eid="MRK 13:35"/><verse number="36" style="v" sid="MRK 13:36"/>Ki non yɛ bwabwa kpaa, no ka tu ema le nuna ba. <verse eid="MRK 13:36"/><verse number="37" style="v" sid="MRK 13:37"/>Ungwɔ ngwi ani le nya ema nɛ, n le nya ali inggisɛ duu gbɛɛ: &lt;Ngyo na!&gt; &gt;&gt;<verse eid="MRK 13:37"/></para>
  <chapter eid="MRK 13"/>
  <chapter number="14" style="c" sid="MRK 14"/>
  <para style="s1">A kye engyie kyi iYesu ikye <optbreak/> mi iBetani</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1"/>I sisi mɛ egbe efa ngwi oga owɛ owatɔ-watɔ mgbi emi Israi bɛyi ibredi ngwi a kye okwuna wo efu ba ka wa gyɔ nɛta, engyukwo ama ofifɛ bɛyi etsetse mgbi ola mgbi iMose tole pita ofɛ mi oshu ngwi ama ka bwa iYesu di ngwɔn mani. <verse eid="MRK 14:1"/><verse number="2" style="v" sid="MRK 14:2"/>A gbɔgbɛɛ, &lt;&lt;Kpaa no ka li mi egbe oga ba, bana inggisɛ ka ndeye.&gt;&gt;<verse eid="MRK 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3"/>Mi onɔ ngwi iYesu dzɛ iBetani mani, o sisɛ ogye ungwogye mi udɛ inggisɛ ongwu a li kwun di iSaimɔn inggisɛ otsoma, ongyaa ba yi engyie ofyunfyummya mi ikpɔkpɔ alabasta<note caller="+" style="f"><char style="fr" closed="false">14:3 </char><char style="ft" closed="false">Alabasta na li ongwɛ ishe ngwi a li man tishi inɛ saan mi ikwutsɛ ngwi a li kwu di alabasta mi ondudzɛ mgbi ama</char></note>, engyie mgbi ekwɔ iNadi<note caller="+" style="f"><char style="fr" closed="false">14:3 </char><char style="ft" closed="false">Ekwɔ iNadi li ekwɔ ndzɛ ɛsɛ iDia ngwi a li kye kyɔ engyie ogbungbɛ yan.</char></note> yuon. O kye ikpɔkpɔ alabasta na ondun kye kwulu, kye engyie ma yawo iYesu ikye.<verse eid="MRK 14:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 14:4"/>Ama nto mi onɔ na ma, tole gbɔ mi itingga-itingga yi ewoma gbɛɛ, &lt;&lt;Nɛnɛ li engyie ombeembe dɛn lo? <verse eid="MRK 14:4"/><verse number="5" style="v" sid="MRK 14:5"/>A ki kye gya mɛ udza nngha udza idɔ onova onyi di kye udza ma gha emi adzɛ.&gt;&gt; A si kyɔkyɔ yi ongyaa na mi itingga-itingga.<verse eid="MRK 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 14:6"/>Nghaduu iYesu gbɛɛ, &lt;&lt;Ema dzanta na. Kyɔnɛ ngwi ema le kakan ewo ngha? O kyungwɔ nli osuse yi ani. <verse eid="MRK 14:6"/><verse number="7" style="v" sid="MRK 14:7"/>Bana emi adzɛ to yi ema alonɔ duu, ema ka ya ma abɔ alonɔ ngwi ema mina duu. Kpaa ani yɔ, ema ka tu ani alonɔ ba. <verse eid="MRK 14:7"/><verse number="8" style="v" sid="MRK 14:8"/>O kyungwɔ ngwi o yagba okyɔ. O kyi ani engyie mi ewo duuse ni onɔ ondzi ani wa gyɔ. <verse eid="MRK 14:8"/><verse number="9" style="v" sid="MRK 14:9"/>N nya ema otsitsi, mi ali imbe ngwi a le gbɔ Esɔ Osuse kpatsɛ ɛsɛ duu, ungwɔ ngwi o kyɔ nɛ a ka gbɔn, ikye ole wan.&gt;&gt;<verse eid="MRK 14:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10"/>Ta iJuda iSkarɔti, ongwu nli onyi mbi emi iwyodefa ntona, kɛ mbi engyukwo ama ofifɛ oka kye iYesu gya yi ama. <verse eid="MRK 14:10"/><verse number="11" style="v" sid="MRK 14:11"/>I kpa ma ofwo odzɛ nɛni a di zondu onun awuya. Nghanɛ o pita ofɛ okyon wo ma abɔ.<verse eid="MRK 14:11"/></para>
  <para style="s1">Ungwogye mgbi Otsɛ iYesu <optbreak/> ongwi olɛlɛ.</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12"/>Mi egbe ongwi ababɔ mgbi oga ibredi ngwi a kye okwuna wo efu ba, ngwi li ungwɔ etɔ mgbi ama ofifɛ yi mmala oga owɛ owatɔ-watɔ mgbi emi Israi nɛ, engwafɔ mgbi iYesu byun gbɛɛ, &lt;&lt;Li mi ole ngwi abu mina ni eyi kɛ ka mɛlu abu imbe ogye oga owɛ owatɔ-watɔ mgbi emi Israi nɛ?&gt;&gt;<verse eid="MRK 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 14:13"/>Nɛta o dɔ engwafɔɔn efa esɔ, nya ma gbɛɛ, &lt;&lt;Kaka ifu igeli na, ongyulɔ kye ishe eni dikye ka wa kpatsɛ ema. Kyɛdɔn na. <verse eid="MRK 14:13"/><verse number="14" style="v" sid="MRK 14:14"/>Imbe ngwi o kaka ma, nya otsungwudɛ ma gbɛɛ, &lt;Otsetse byita gbɛɛ: Ozu ingyoga mgbi ani, ngwi ani ka gye oga owɛ owatɔ-watɔ mgbi emi Israi yi emi ongwafɔ mgbi ani ma kɔ?&gt; <verse eid="MRK 14:14"/><verse number="15" style="v" sid="MRK 14:15"/>Ta o ka tso ema ozu okwukwo mi ozeesho, ngwi a gbe okye to ele le fɛɛfɛ. Kye mɛlu mi ikye eweyi na.&gt;&gt;<verse eid="MRK 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 14:16"/>Emi ongwafɔ ntona si lu ifu igeli ka di ungwɔ ntona yɛyɛ dafi iYesu nya ma mani. Nɛ a kye kyɔlu ungwogye oga owɛ owatɔ-watɔ mgbi emi Israi.<verse eid="MRK 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17"/>Onɔ wa gbɛsɛ nɛta, iYesu wa kaka bɛyi emi iwyodefa ntonani. <verse eid="MRK 14:17"/><verse number="18" style="v" sid="MRK 14:18"/>Ngwi a sisɛ kwongongo le gye ungwogye mi adinyatsɛ nɛta, o gbɔgbɛɛ, &lt;&lt;Ani le nya ema otsitsi, onyi mbi ema ka kye ani gya, o sɔ le gye ungwogye yi ani mmɛnɛ kpaa.&gt;&gt;<verse eid="MRK 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19"/>A si yɛɛ elela dile byun onyonyi gbɛɛ, &lt;&lt;Li ani ba lɔ?&gt;&gt;<verse eid="MRK 14:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 14:20"/>Nghaduu iYesu nya ma gbɛɛ, &lt;&lt;Li onyi mbi emi iwyodefa, ama nkye abɔ wo uga yi ani nɛni. <verse eid="MRK 14:20"/><verse number="21" style="v" sid="MRK 14:21"/>Ongwɛ Inggisɛ ka lu yɛyɛ dafi Afɛ lɔ mi ikyen mani. Kpaa ahoo mi ikye inggisɛ ongwu nkye Ongwɛ Inggisɛ gya mani! Ka tatase gbɛɛ a ki mban ba.&gt;&gt;<verse eid="MRK 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22"/>Ngwi a le gye ungwogye nɛ, iYesu kyelu ibredi, ta Imgbasho angba man kye mwalu, kye nu emi ongwafɔɔn gbɛɛ, &lt;&lt;Gbɛ na; nɛnɛ li ikpewo mgbi ani.&gt;&gt;<verse eid="MRK 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 14:23"/>O di kyi kyelu ibwɛ, ta Imgbasho angba di kye nu ma, ama duu wa mi efu.<verse eid="MRK 14:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 14:24"/>O nya ma gbɛɛ, &lt;&lt;Nɛnɛ li eyi mgbi ondu odzɛɛdzɛ mgbi ani, ongwi a kye yawo mi ikye ibyi inggisɛ. <verse eid="MRK 14:24"/><verse number="25" style="v" sid="MRK 14:25"/>Ani le nya ema otsitsi, n ka weni awawa ekwɔ nɛ wuba nghataa mi egbe ngwi n ka wan ofufɛ mi esutɔ mgbi Imgbasho mani.&gt;&gt;<verse eid="MRK 14:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26"/>Ngwi a shashi nɛta, a tasɛ lu Unggwɔ Olivi.<verse eid="MRK 14:26"/></para>
  <para style="s1">IYesu teyi gbɔ dafi iPyita ka wa <optbreak/> tangwɛ ongwu</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27"/>Ta iYesu si nya ma gbɛɛ, &lt;&lt;Ema duu ka tangwɛ ani, bana Afɛ lɔ gbɛɛ:</para>
  <para style="q1" vid="MRK 14:27">&lt;&lt; &lt;N ka gbo inggisɛ ongyo ifyungwɔ ta,</para>
  <para style="q2" vid="MRK 14:27">mmala ka ganya.&gt;<verse eid="MRK 14:27"/></para>
  <para style="m">
    <verse number="28" style="v" sid="MRK 14:28"/>Nghaduu ni ani wa kyato mi ikwu yɔ, n ka teyi ema kaka iGalalia.&gt;&gt;<verse eid="MRK 14:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 14:29"/>Kpaa iPyita gbɔ mi ododa gbɛɛ, &lt;&lt;Kini inggisɛ duu tangwɛ kpaa, ani ka tangwɛ ba.&gt;&gt;<verse eid="MRK 14:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 14:30"/>Man iYesu nyan gbɛɛ, &lt;&lt;N nya abu otsitsi, mi otu inɛ nɛni, duuse ni ogbigbi teela akpe efa yɔ, abu ka tangwɛ ani akpe eta.&gt;&gt;<verse eid="MRK 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 14:31"/>Nghaduu iPyita biibɛ mi ela mfye gbɛɛ, &lt;&lt;Kini li ikwu kpaa ani ka kwulu yi abu, n ka tangwɛ abu ba.&gt;&gt; Angbeka ntona duu kpaa gbɔ ngha.<verse eid="MRK 14:31"/></para>
  <para style="s1">IYesu mi iGesemani</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32"/>A kɛ imbe ngwi ali kwun di iGesemani, ta iYesu gbɔ yi emi ongwafɔɔn gbɛɛ, &lt;&lt;Sisɛ mmɛnɛ na nin ka bibɔ.&gt;&gt; <verse eid="MRK 14:32"/><verse number="33" style="v" sid="MRK 14:33"/>O kyi kyelu iPyita yi iJɛnsi bɛyi iJɔn lu yan, man o wita ogyadzɛ mi itukwu kpakpa i di kakan ewo. <verse eid="MRK 14:33"/><verse number="34" style="v" sid="MRK 14:34"/>Nɛ o nya ma gbɛɛ, &lt;&lt;Elela okyɔɔkyɔ gbɛlu oshishe mgbi ani duu sɔ nghataa kaka mi odzɛɛdzɛ mgbi ikwongye kpaa, nɛ dzɛ mmɛnɛ le ngyo na.&gt;&gt;<verse eid="MRK 14:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 14:35"/>O si kiyayi gwee ta, kwokɛ esɛ bibɔ gbɛɛ no li kyɛmɛ-kyɛmɛ yɔ, ni obyi nɛ nyɛ ongwu. <verse eid="MRK 14:35"/><verse number="36" style="v" sid="MRK 14:36"/>O si gbɔgbɛɛ, &lt;&lt;Baba, Otsani, alungwɔ dzɛ kyɛmɛ-kyɛmɛ mbi abu. Kyi kyelu ibwɛ adzɛ nɛ mbi ani. Kpaa no ka li mi owitukwu mgbi ani ba, no li mi owitukwu mgbi abu.&gt;&gt;<verse eid="MRK 14:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37"/>Ta o yidɔ wa tu engwafɔɔn tole nuna. O si nya iPyita gbɛɛ, &lt;&lt;iSaimɔn, abu le nunaa? Obyi onyi kpaa abu ka yagba ngyo lo? <verse eid="MRK 14:37"/><verse number="38" style="v" sid="MRK 14:38"/>Ngyo di bibɔ ikyegbɛɛ ni ema ka gbɛsɛ mi imbadi ba. Onodzi yɔ le dzɛ yi oweka, kpaa ewo dzatsi.&gt;&gt;<verse eid="MRK 14:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39"/>O diyɛ lu ka bɔ itɔ ibɔ ngwi o teyi bɔ mani. <verse eid="MRK 14:39"/><verse number="40" style="v" sid="MRK 14:40"/>Mi onɔ ngwi o yɛ mani, o diyɛ tu ma tole nuna, ikyekyɛ akwukwinɛ lo loma. A ye odzɛ ngwi a ka gbɔ nyan ba.<verse eid="MRK 14:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 14:41"/>Ngwi o yɛ akpe ongwu ta nɛ, o gbɔ yi ama gbɛɛ, &lt;&lt;Ema kale nuna dile tonya maa? I gyɔ ngha! Onɔ ma gyɔ wa! Dika, a kye Ongwɛ Inggisɛ wo emi ibwubwe abɔ wa. <verse eid="MRK 14:41"/><verse number="42" style="v" sid="MRK 14:42"/>Kyato i kɛ na! Inggisɛ nkye ani gya ma ba wa!&gt;&gt;<verse eid="MRK 14:42"/></para>
  <para style="s1">A bwa iYesu</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43"/>Ngwi o kale gbɔdzɛ nɛta, iJuda, onyi mbi iwyodefa ntona, ba wa to. Ibyi inggisɛ to yan, a sha okwusunkli yi itsitsi okwuta, ngwi li engyukwo ama ofifɛ bɛyi etsetse mgbi ola mgbi iMose yi emyinɛ dɔ ma esɔ.<verse eid="MRK 14:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="MRK 14:44"/>Mi itɔnɔ nɛ ongye okyon gya na wewo tso ma ambɛ duu gbɛɛ: &lt;&lt;Ongwu ani kye ondu kwon ataka ma li ongwu aali; bwan ngyon kyon lu na.&gt;&gt; <verse eid="MRK 14:44"/><verse number="45" style="v" sid="MRK 14:45"/>Vla nɛta iJuda kɛ mbi iYesu, o gbɔgbɛɛ, &lt;&lt;Otsetse!&gt;&gt; Man kye ondu kwon ataka. <verse eid="MRK 14:45"/><verse number="46" style="v" sid="MRK 14:46"/>Engyulɔ ntona si kpakli iYesu di bwan. <verse eid="MRK 14:46"/><verse number="47" style="v" sid="MRK 14:47"/>Ta onyi mi idzidzɛ mgbi ama nkwulɛsɛ to kwɛkwɛ na kye ngwalu okwusunkli mgban kye kwodzɛ adɔ onyi mgbi ongbidɔ mgbi okwukwo inggisɛ ofifɛ.<verse eid="MRK 14:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 14:48"/>Nɛ iYesu gbɛɛ, &lt;&lt;Ani li inggisɛ ogbe ama oblofɛ teyi se ngwi ema ba mbi ani yi okwusunkli yi itsitsi okwuta owa bwa anii? <verse eid="MRK 14:48"/><verse number="49" style="v" sid="MRK 14:49"/>Alegbe ani li dzɛ yi ema, le tso mi ozu okwukwo osunu Imgbasho mi iJerosalin, kpaa ema bwa ani ba. Nghaduu li kyɛmɛ ngwi Afɛ ka mbwumbwo.&gt;&gt; <verse eid="MRK 14:49"/><verse number="50" style="v" sid="MRK 14:50"/>Ta ali inggisɛ duu tangwan tsinya dzanta.<verse eid="MRK 14:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51"/>Ongwɛ mmafa oka, kye angwuto ondlɛndlɛ nghaama, le kyɛdɔ iYesu. Mi onɔ ngwi a bwan mani, <verse eid="MRK 14:51"/><verse number="52" style="v" sid="MRK 14:52"/>o tsinya dzata angwuto mgban mi iyikpa, lu ibiba.<verse eid="MRK 14:52"/></para>
  <para style="s1">A kye iYesu ba mbi ama odi mi ola</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53"/>Nɛ a kye iYesu kɛ mbi okwukwo inggisɛ ofifɛ, bɛyi engyukwo ama ofifɛ duu, yi engyukwo emi iJuda yi etsetse mgbi ola kwakye mbonyi. <verse eid="MRK 14:53"/><verse number="54" style="v" sid="MRK 14:54"/>IPyita si kyan iyikpa mbombo, nghataa ka kaka imbe ogbiikwɔ mgbi okwukwo inggisɛ ofifɛ. Mmana o sisɛ yi ama ongyoongyo dile wola. <verse eid="MRK 14:54"/><verse number="55" style="v" sid="MRK 14:55"/>Engyukwo ama ofifɛ bɛyi okwakye mgbi ama odi mi ola duu tole pita obwɛndɛ mi ikpewo iYesu ikyegbɛɛ nu ma ngwɔn, kpaa a tu onyi ba. <verse eid="MRK 14:55"/><verse number="56" style="v" sid="MRK 14:56"/>Bana inggisɛ kwuba gbɔ obwɛndɛ atsika mi ikpewon, kpaa elodzɛ mgbi ama kwokyi yi eka ba.<verse eid="MRK 14:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="MRK 14:57"/>Nɛ inggisɛ angbeka di kyato nu obwɛndɛ atsika mi ikpewon gbɛɛ: <verse eid="MRK 14:57"/><verse number="58" style="v" sid="MRK 14:58"/>&lt;&lt;Eyi fwon le gbɔgbɛɛ, &lt;N ka kye ozu okwukwo osunu Imgbasho mi iJerosalin ngwi inggisɛ mbɛ mi abɔ nɛ kye gbobu diyɛ mbɛ oka mi egbe eta, ongwi li abɔ mgbi inggisɛ mbɛ ba mani.&gt; &gt;&gt; <verse eid="MRK 14:58"/><verse number="59" style="v" sid="MRK 14:59"/>Nghaduukpaa obwɛndɛ mgbi ama na kwokyi ba.<verse eid="MRK 14:59"/></para>
  <para style="p">
    <verse number="60" style="v" sid="MRK 14:60"/>Ta okwukwo inggisɛ ofifɛ kyato mi inɛ mgbi ama si byi iYesu gbɛɛ, &lt;&lt;Abu ka nu uka lo? Li ali obwɛndɛ ngwi inggisɛ ntonɛ le kye ba ikpewo abu ngha?&gt;&gt; <verse eid="MRK 14:60"/><verse number="61" style="v" sid="MRK 14:61"/>Kpaa iYesu kwulu ondu nu ma uka ba. Okwukwo inggisɛ ofifɛ na di byun gbɛɛ, &lt;&lt;Abu li iKrestu, Ongwɛ Imgbasho Ongha yi mse naa?&gt;&gt;<verse eid="MRK 14:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="MRK 14:62"/>IYesu si gbɛɛ, &lt;&lt;Li ani ma aani. Ema dika wa di Ongwɛ Inggisɛ ka sɔ abugye mgbi Ongwu Nghaangha dika kyɛ akpa mi esho.&gt;&gt;<verse eid="MRK 14:62"/></para>
  <para style="p">
    <verse number="63" style="v" sid="MRK 14:63"/>Okwukwo inggisɛ ofifɛ na si kye nghalu angwuto mgban. O byita gbɛɛ, &lt;&lt;Kyɔnɛ ngwi eyi di mina obwɛndɛ angbeka?&gt;&gt; <verse eid="MRK 14:63"/><verse number="64" style="v" sid="MRK 14:64"/>&lt;&lt;Ema fwo ito ntonɛ ma, ema tsɛwɛ sinɛ?&gt;&gt;</para>
  <para style="p" vid="MRK 14:64">Ama duu nu iYesu obube gbɛɛ o gyɔ ondu ikwongye. <verse eid="MRK 14:64"/><verse number="65" style="v" sid="MRK 14:65"/>Ta angbeka wita okyanggwɔ kyin ewo; a kye ungwɔ bwan inɛ, kwon asa, di nyan gbɛɛ, &lt;&lt;Di yegbɔ ka!&gt;&gt; Ta inggisɛ ama ongyoongyo na byin di gbon ibe.<verse eid="MRK 14:65"/></para>
  <para style="s1">IPyita tangwɛ iYesu</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66"/>Mi onɔ ngwi iPyita ka dzɛ esɛ mi ifyudɛ nɛta, ongwongyaa onyi mi idzidzɛ engbidɔ mgbi okwukwo inggisɛ ofifɛ nani, ba wa kaka. <verse eid="MRK 14:66"/><verse number="67" style="v" sid="MRK 14:67"/>Ngwi o di iPyita le wola nɛta, o din inɛ si gblekɛ kwɛkwɛ yan.</para>
  <para style="p" vid="MRK 14:67">O nyan gbɛɛ, &lt;&lt;Abu kpaa li kyɛ yi iYesu ongwi iNadzareti.&gt;&gt;<verse eid="MRK 14:67"/></para>
  <para style="p">
    <verse number="68" style="v" sid="MRK 14:68"/>Nghaduu iPyita tangwɛ gbɛɛ, &lt;&lt;Ani yon hona difwi odzɛ ngwi abu le gbɔ nɛ kpaa ba,&gt;&gt; man o tasɛ mi onufɛ okakaakaka.<verse eid="MRK 14:68"/></para>
  <para style="p">
    <verse number="69" style="v" sid="MRK 14:69"/>Ngwi ongwongyiidɔ na din mmana nɛ, o di nya ama nkwudzɛ to ma gbɛɛ, &lt;&lt;Inggisɛ nɛ kpaa li onyi mboma.&gt;&gt; <verse eid="MRK 14:69"/><verse number="70" style="v" sid="MRK 14:70"/>IPyita di tangwɛ.</para>
  <para style="p" vid="MRK 14:70">I wa dzɛ gwee nɛta, ama nkwudzɛ to kwɛkwɛ na nya iPyita gbɛɛ, &lt;&lt;Li otsitsi abu li onyi mi idzidzɛ ma, bana abu li emi iGalalia.&gt;&gt;<verse eid="MRK 14:70"/></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71"/>Ta iPyita wita owo ewon ikamba di fa yi ama gbɛɛ, &lt;&lt;Ani ye inggisɛ ngwu ema le gbɔdzɛ kwu iyin nɛ ba.&gt;&gt;<verse eid="MRK 14:71"/></para>
  <para style="p">
    <verse number="72" style="v" sid="MRK 14:72"/>Mina nɛta ogbigbi teela akpe efa. Ta iPyita wɛ elodzɛ ongwi iYesu gbɔ yan gbɛɛ: &lt;&lt;Ogbigbi ka teela akpe efa waba ta, abu ka tangwɛ ani akpe eta mani.&gt;&gt; Man o si nyɛ yi ikwu otseetse.<verse eid="MRK 14:72"/></para>
  <chapter eid="MRK 14"/>
  <chapter number="15" style="c" sid="MRK 15"/>
  <para style="s1">A kye iYesu ba inai iPlatu</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1"/>Mi egbegbe ototu nɛta, engyukwo ama ofifɛ yi engyukwo mgbi emi iJuda bɛyi etsetse mgbi ola yi okwakye mgbi ama ogbiikwɔ gbela yi ewoma. A si bwalu iYesu kyon wa nu iPlatu (ongwu nli iGɔna mgbi emi iRoma nani).<verse eid="MRK 15:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 15:2"/>IPlatu si byi iYesu gbɛɛ, &lt;&lt;Abu li utɔ mgbi emi iJudaa?&gt;&gt;</para>
  <para style="p" vid="MRK 15:2">Nɛ iYesu nun uka gbɛɛ, &lt;&lt;Ɛɛn, dafi abu gbɔ mani.&gt;&gt;<verse eid="MRK 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3"/>Engyukwo ama ofifɛ du ongwufabɔ mbon mi itɔdzɛ kwuba. <verse eid="MRK 15:3"/><verse number="4" style="v" sid="MRK 15:4"/>Nɛ iPlatu diyɛ byun gbɛɛ, &lt;&lt;Abu ka nu ani uka lo? Di umbwo ungwɔ ngwi a le du ongwufabɔ mbi abu ikye ma nɛni.&gt;&gt;<verse eid="MRK 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 15:5"/>Nghaduu iYesu di nun uka ba kpɔɔ, ta i si kwulu iPlatu ewo.<verse eid="MRK 15:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6"/>Alonɔ oga owɛ owatɔ-watɔ mgbi emi Israi yɔ, iPlatu li dulu inggisɛ onyi mi obawi, ongwu emi iJuda mina mani. <verse eid="MRK 15:6"/><verse number="7" style="v" sid="MRK 15:7"/>Ongyulɔ oka ngwu a li kwun di iBaraba wodzɛ obawi. A bwalun yi inggisɛ angbeka ka wokɛ obawi ikyegbɛɛ a ngwɔ inggisɛ onɔ ngwi a le kyɔ ablodzɛ. <verse eid="MRK 15:7"/><verse number="8" style="v" sid="MRK 15:8"/>Ibyi inggisɛ wulu ba mbi iPlatu wa nyan gbɛɛ no kyɔ yi ama ungwɔ ngwi o li tsekise kyɔ mani.<verse eid="MRK 15:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 15:9"/>Man iPlatu byita gbɛɛ, &lt;&lt;Ema mina gbɛɛ ni ani dzata utɔ mgbi emi iJuda nu emaa?&gt;&gt; <verse eid="MRK 15:9"/><verse number="10" style="v" sid="MRK 15:10"/>Ikyesinɛ o ye dafi li uwaba ngwi engyukwo ama ofifɛ kye iYesu wa nun mani. <verse eid="MRK 15:10"/><verse number="11" style="v" sid="MRK 15:11"/>Kpaa engyukwo ama ofifɛ si fyi ibyi inggisɛ ntona mfye itukwu gbɛɛ nu ma nu iPlatu dzita iBaraba no ka li iYesu ba.<verse eid="MRK 15:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 15:12"/>IPlatu byi ma gbɛɛ, &lt;&lt;Li ekyɛ nin kyɔ yi ongwu ema kwun di utɔ mgbi emi iJuda nɛ?&gt;&gt;<verse eid="MRK 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 15:13"/>A wulu gbɛɛ, &lt;&lt;Ngwɔn mi ekwatsi!&gt;&gt;<verse eid="MRK 15:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 15:14"/>IPlatu byita gbɛɛ, &lt;&lt;Li alungwɔ obube ngwi o kyɔ?&gt;&gt;</para>
  <para style="p" vid="MRK 15:14">Kpaa a nghao gbɔ mi ela okwukwo gbɛɛ, &lt;&lt;Ngwɔn mi ekwatsi!&gt;&gt;<verse eid="MRK 15:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 15:15"/>Ngwi o mina okyɔ itukwu mgbi ibyi nɛ, iPlatu si dzata iBaraba nu ma. O nu ma gbo iYesu onitse ibyibyi si kyon nu ma oka ngwɔ mi ekwatsi.<verse eid="MRK 15:15"/></para>
  <para style="s1">Ama oblakwutsɛ nya iYesu agya.</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16"/>Ama oblakwutsɛ si kye iYesu lu udɛ iGɔna, mi imbe o li sɔ gbiikwɔ si kwu ewoma ela tsatsa kwakye. <verse eid="MRK 15:16"/><verse number="17" style="v" sid="MRK 15:17"/>A kye angwuto omuma shinishini won, di kyi shili akata ato kye tukwun ikye. <verse eid="MRK 15:17"/><verse number="18" style="v" sid="MRK 15:18"/>Ta a wita onyan agya gbɛɛ, &lt;&lt;Eyi ta abu angba utɔ mgbi emi iJuda!&gt;&gt; <verse eid="MRK 15:18"/><verse number="19" style="v" sid="MRK 15:19"/>A diyɛ kye okwuta le gbon mi ikye di kyanggwɔ kyin. Man a gbe akwafɔ kwɛsɛ diyɛ sunun. <verse eid="MRK 15:19"/><verse number="20" style="v" sid="MRK 15:20"/>Ngwi a nyan agya nɛ, a dulun angwuto omuma shinishini na kye mgban won. Ta a kyon tasɛ oka ngwɔ mi ekwatsi.<verse eid="MRK 15:20"/></para>
  <para style="s1">A gbokwo iYesu mi ekwatsi</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21"/>Ongyulɔ oka mi igeli iSirini, ngwu a li kwun di iSaimɔn, otsɔ Alekidzanda bɛyi iRufu, yɛ kyɛ ɛsɛ mgban nyɛ le lu. A siin gbɛɛ non kye ekwatsi nani. <verse eid="MRK 15:21"/><verse number="22" style="v" sid="MRK 15:22"/>Nɛ a kye iYesu ba imbe ngwi a li kwun di iGogota nani (ngwi itan di Imbe Ikpalikye). <verse eid="MRK 15:22"/><verse number="23" style="v" sid="MRK 15:23"/>Ta a kye eneekwɔ takye yi otse oyulu ungwɔ owulewo nun gbɛɛ no wa, kpaa o fwa owaawa. <verse eid="MRK 15:23"/><verse number="24" style="v" sid="MRK 15:24"/>Man a kyon gbokwo mi ekwatsi. A gbelun angwuto kye ghalu, a gbeefa ikye odi ungwɔ ngwi ali inggisɛ ka tu mani.<verse eid="MRK 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 15:25"/>Li obyi ongwu gyanɛ mi egbegbe ngwi a kyon gbokwo ekwatsi. <verse eid="MRK 15:25"/><verse number="26" style="v" sid="MRK 15:26"/>A lɔ ungwɔ ama ngwi a du ongwufabɔ mbon mi ele ma gbɛɛ: UTƆ MGBI EMI IJUDA. <verse eid="MRK 15:26"/><verse number="27" style="v" sid="MRK 15:27"/>A gbokwo ama ofoofɛ nghi efa biyan, onyi mi abugye mgban yi oka mi abubɛ. <verse eid="MRK 15:27"/><verse number="28" style="v" sid="MRK 15:28"/>(Nɛ Afɛ mbwumbwo odzɛ ngbɛɛ, &lt;&lt;A gbɔn wo umbwo yi ama ofoola.&gt;&gt;)<note caller="+" style="f"><char style="fr" closed="false">15:28 </char><char style="ft" closed="false">Ambulu nɛ dzɛ mi olɔɔlɔ angbeka ba.</char></note> <verse eid="MRK 15:28"/><verse number="29" style="v" sid="MRK 15:29"/>Ama nle nyɛ ofɛ gbe ito tukwun kpakpa, le ngwi ikye dile gbɛɛ, &lt;&lt;Oho! Abu ngbɛɛ o ka gbobu ozu okwukwo osunu Imgbasho mi iJerosalin diyɛ kyi mbɛlu mi egbe eta nɛ, <verse eid="MRK 15:29"/><verse number="30" style="v" sid="MRK 15:30"/>tashulu mi ekwatsi ba esɛ di dulu ewabu tɔ ka!&gt;&gt;<verse eid="MRK 15:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 15:31"/>Li ngha ngwi engyukwo ama ofifɛ bɛyi etsetse mgbi ola kpaa le nyan agya yi ewoma gbɛɛ, &lt;&lt;O li dulu angbeka tɔ, kpaa o yagba dulu ewon tɔ wuba! <verse eid="MRK 15:31"/><verse number="32" style="v" sid="MRK 15:32"/>Ni iKrestu, utɔ mgbi emi Israi nɛ, tashulu onɛnɛ mi ekwatsi ba esɛ, ni eyi di diyɛ noyɛyɛ.&gt;&gt; Ama ngwu a kye ma gbokwo ekwatsi biyan kpaa fan esɛ.<verse eid="MRK 15:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33"/>Mi onɔ idzidzɛ udɛ yɛyɛ nɛta ɛsɛ duu yifu nghataa ba obyi eta mi onɔdɛ. <verse eid="MRK 15:33"/><verse number="34" style="v" sid="MRK 15:34"/>Mi obyi ongwu ta mi onɔdɛ na, iYesu si makwɔ mi ela okwukwo gbɛɛ, &lt;&lt;Eli, Eli, lama sabatani?&gt;&gt; Ngwi itan gbɛɛ, &lt;&lt;Imgbasho mgbi ani, Imgbasho mgbi ani, li ekyɛ ngwi abu le dzanita?&gt;&gt;<verse eid="MRK 15:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35"/>Ngwi ama nkwulɛsɛ to kwɛkwɛ fwo ungwɔnɛ nɛ, a gbɔgbɛɛ, &lt;&lt;Gadɔ na, o le kwu Elaija ela.&gt;&gt;<verse eid="MRK 15:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 15:36"/>Ongyulɔ onyi mboma tsinya kɛ, kye isoso wokɛ eneekwɔ onunɔ, kye fakɛ ekwɔ si kyilen kye nu iYesu gbɛɛ no wa. Man o gbɔgbɛɛ, &lt;&lt;Dzanta na. Ni eyi di kyayina Elaija ka wa tashulun ba esɛ.&gt;&gt;<verse eid="MRK 15:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 15:37"/>IYesu gbobakwɔ mi ela okwukwo man o si yulu.<verse eid="MRK 15:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 15:38"/>Ta angwuto ngwi a kye tsɛ mi idzidzɛ ozu okwukwo osunu Imgbasho mi iJerosalin na gbua efa mi esho nghataa luba esɛ. <verse eid="MRK 15:38"/><verse number="39" style="v" sid="MRK 15:39"/>Ngwi agyegika mgbi ama oblakwutsɛ, ongwu nkwulɛsɛ mmana mi inai iYesu, fwo akwɔ mgban yɛ di dafi o kwulu nɛ, o gbɔgbɛɛ, &lt;&lt;Otsitsi inggisɛ nɛ li Ongwɛ Imgbasho!&gt;&gt;<verse eid="MRK 15:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40"/>Engyaa angbeka kwulɛsɛ mbombo le di ungwɔ nle kiyayi mani. Mi idzidzɛ ma li iMeri iMagidalin bɛyi iMeri onɔ iJɛnsi ongbungbɛ bɛyi iJosisi yi iSalomi. <verse eid="MRK 15:40"/><verse number="41" style="v" sid="MRK 15:41"/>Mi iGalalia engyaa ntonɛ nose li kyɛ yi iYesu dile yan abɔ kpaa. Engyaa angbeka kwuba nba biyan mi iJerosalin kpaa to imbe nani.<verse eid="MRK 15:41"/></para>
  <para style="s1">Ondziindzi mgbi iYesu</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42"/>Li egbe owewo (obwi egbe otonyewo). Ngwi onɔ le gbɛsɛ nɛ, <verse eid="MRK 15:42"/><verse number="43" style="v" sid="MRK 15:43"/>iJose ongwi Arimatia, inggisɛ okpɔngɔ mi idzidzɛ okwakye mgbi ama ogbiikwɔ, ongwu abuon le fɛ obaaba mgbi esutɔ mgbi Imgbasho. O kɛ yi imio ba mbi iPlatu ka bɔn ikwɔ mgbi iYesu. <verse eid="MRK 15:43"/><verse number="44" style="v" sid="MRK 15:44"/>Nɛ i kwulu iPlatu ewo ofwo gbɛɛ iYesu kwulu wa. O kwu ongyukwo mgbi ama oblakwutsɛ na ela, o byun ita ni iYesu kwulu wa yɔ. <verse eid="MRK 15:44"/><verse number="45" style="v" sid="MRK 15:45"/>Ngwi o wa fwo mi ondu ongyukwo mgbi ama oblakwutsɛ gbɛɛ dzɛ ngha nɛ, o kye ikwɔ na nu iJose. <verse eid="MRK 15:45"/><verse number="46" style="v" sid="MRK 15:46"/>Ta iJose gya angwuto ondlɛndlɛ, o kye sulu ikwɔ mgbi iYesu kye ndiwokɛ angwuto na man kyon ndzi mi endzi ngwi a cɛfo ikwutsɛ. Ta o tsamu ofishi tukwu ondendzi. <verse eid="MRK 15:46"/><verse number="47" style="v" sid="MRK 15:47"/>Nɛ iMeri iMagidalin bɛyi iMeri onɔ iJosisi di imbe ngwi a kyon ndzi mani.<verse eid="MRK 15:47"/></para>
  <chapter eid="MRK 15"/>
  <chapter number="16" style="c" sid="MRK 16"/>
  <para style="s1">Okyɛɛ-kyɛɛ mi ikwu</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1"/>Ngwi egbe otonyidɔ wa nyɛ nɛ, iMeri iMagidalin bɛyi iMeri onɔ iJɛnsi yi iSalomi gya engyie ogbungbɛ ikyegbɛɛ ni ama ka kye gyuwo ikwɔ mgbi iYesu. <verse eid="MRK 16:1"/><verse number="2" style="v" sid="MRK 16:2"/>Mi egbegbe byibyiibyi mi egbe ongwi ababɔ mi ikyidu (egbe iladi) ngwi onɔ le tɔ nɛni. A si tɔ ofɛ le lu endzi, <verse eid="MRK 16:2"/><verse number="3" style="v" sid="MRK 16:3"/>a byi eka ita mi ofɛ gbɛɛ, &lt;&lt;Li emɛ ka mulu eyi ofishi mi ondendzi nɛ?&gt;&gt;<verse eid="MRK 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 16:4"/>Kpaa ngwi a kyile ikye esho nɛ, a di gbɛɛ ofishi ngwi a kye tukwu ondendzi ma mulu. <verse eid="MRK 16:4"/><verse number="5" style="v" sid="MRK 16:5"/>Ngwi a kaka endzi nɛ, a di ongwongyulɔ mmafa wo angwuto onzundzɛ sɔdzɛ agya abugye mi endzi, ta i kwulu ma ewo.<verse eid="MRK 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 16:6"/>Ongyulɔ na nya ma gbɛɛ, &lt;&lt;Ka tsimio ba na. Ema le pita iYesu ongwi iNadzareti, ongwu a ngwɔn mi ekwatsi nani. O kyato mi ikwu! O dzɛ mmɛnɛ wuba. Di imbe ngwi a kyon la ma na. <verse eid="MRK 16:6"/><verse number="7" style="v" sid="MRK 16:7"/>Nghanɛ ema yɛ lu na ka nya engwafɔ mgban yi iPyita gbɛɛ, &lt;O teyi ema le lu iGalalia ma. Ema ka din mi imbe na, dafi o tsekise nya ema mani.&gt; &gt;&gt;<verse eid="MRK 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8"/>Engyaa ntona si tasɛ mi endzi tsinya. Ewo shi igakwu loma i di wo ma ɛndɛ. A gbɔdzɛ yi inggisɛ onyi kpaa wuba, ikyena imio wo ma.<verse eid="MRK 16:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9"/>[Ngwi iYesu kyato mi egbe iladi mi egbegbe nɛ, o kye ewon tso mbi iMeri iMagidalin ababɔ, ongwu o lɔ onodzi ibwubwe tɔ mbon nghi egyafa nani. <verse eid="MRK 16:9"/><verse number="10" style="v" sid="MRK 16:10"/>O si lu ka nya ama nkyɛ yan tole tsukwu dile makwɔ mani. <verse eid="MRK 16:10"/><verse number="11" style="v" sid="MRK 16:11"/>Ngwi a fwo gbɛɛ iYesu dzɛ oshishe, ongyaa na din nɛ kpaa, a noyɛyɛ mi ele ba.<verse eid="MRK 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12"/>Onɔ wa nyɛ nɛ, iYesu di kye ewon tso emi ongwafɔɔn angbeka nghi efa mi ofɛ oka idzidza onɔ ngwi a le kyikyɛ mi ɛsɛ na mani. <verse eid="MRK 16:12"/><verse number="13" style="v" sid="MRK 16:13"/>A si yɛ wa nya angbeka ntona; kpaa a nu ma oyɛyɛ ba.<verse eid="MRK 16:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14"/>Onɔ gwee nɛ, iYesu di mblegba to iwyodonyi ntona ngwi a le gye ungwogye; o shɔdzɛ yi ama mi oyɛyɛ onuunu ba bɛyi ikyegbɛɛ a fwa kye itukwu tiishu onoyɛyɛ mbi ama ndin onɔ ngwi o kyato mi ikwongye mani.<verse eid="MRK 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 16:15"/>Man o nya ma gbɛɛ, &lt;&lt;Lu ɛsɛ ka gbɔ Esɔ Osuse nɛ nya ali inggisɛ duu. <verse eid="MRK 16:15"/><verse number="16" style="v" sid="MRK 16:16"/>Ali inggisɛ nnoyɛyɛ ngwi a di kyɔn iBatisima yɔ, o ka watɔ, nghaduu inggisɛ nnoyɛyɛ bayɔ, o ka dzili. <verse eid="MRK 16:16"/><verse number="17" style="v" sid="MRK 16:17"/>Ambɛ ntonɛ dika kyɛdɔ ama nnoyɛyɛ: Mi iyi mgbi ani a ka lɔ onodzi ibwubwe tasɛ; a dika gbɔ ondudzɛ ofufɛ; <verse eid="MRK 16:17"/><verse number="18" style="v" sid="MRK 16:18"/>a ka kye abɔ byi ifa; ni a wa otse ikwongye kpaa unkonyi ka kyɔ ma ba du; a dika kye abɔ gbo ama ndotse ta ootse ka ngyɛ loma.&gt;&gt;<verse eid="MRK 16:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19"/>Ngwi Otsɛ iYesu gbɔdzɛ nɛ yi ama ngyɛ nɛta, Imgbasho kyon lu esho,<figure style="fig" alt="IYesu kyato mi ikwu" file="cn01884B.tif" size="col" loc="16;19" copy="Cn01883b" ref="16:19">The Resurrection</figure> o sika sɔkɛ abugye mgbi Imgbasho. <verse eid="MRK 16:19"/><verse number="20" style="v" sid="MRK 16:20"/>Nɛ emi ongwafɔɔn si tasɛ ka gbeesɔ mi ali imbe duu, ta Otsɛ Imgbasho kyidɔ yi ama dile mbwumbwo mi elodzɛ mgban yi ambɛ nkyɛdɔ mani.]<note caller="+" style="f"><char style="fr" closed="false">16:20 </char><char style="ft" closed="false">Ambulu ngwi wita mi egyanɛ lu osu dzɛ mi olɔɔlɔ tugbe mgbi ondu iGrikii ngwi a di nghao kye ma wuuta ma ba.</char></note><verse eid="MRK 16:20"/></para>
  <chapter eid="MRK 16"/>
</usx>
