<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2PE" style="id">Sowi aganebo Fida selelu</book>
  <para style="h">Aganebo Fida</para>
  <para style="toc1">Fidahe Sowi Aganebo Ewe Seleba Ufulu</para>
  <para style="toc2">2 Fida</para>
  <para style="toc3">2Fid</para>
  <para style="rem">First draft by the team in 2014?</para>
  <para style="rem">Advisor Check in November 2022 in Ukarumpa with Wabele Fuga, Yobe Maibi and Dickson Wadaga. Anne Stoppels present in Ukarumpa.</para>
  <para style="rem">Consultant check by correspondence - Paulus Jan Kieviet consultant.</para>
  <para style="mt">2 Fida</para>
  <para style="mt2">Fidahe Sowi Aganebo Ewe Seleba Ufulu</para>
  <para style="imt">Sulu samini alegaeyo</para>
  <para style="ip">Sowi selelu ewene maumo, ewe. Fidahe sigidubulu idele inolo haguguba saeyo hamefe. Masega walelo noolo sibaisasia, ine asigi ule ufulu amoda, ine mana nafulu amoda, woba dafolosine, ilihe ine sulu domesialene nafulumale. Sulu hilibaisi daalu inolohe ilifea saaba melu amone kiwigaaba fedoba semale. Sulu amo auba fedoba sefe amofea alefasia, ilihe Godeda, Saminilo Yesu Kelisoda, nafuluba fadaba asigiyobafe. Hilibaisi daalu ilihe Yesu molofemo ine si bisigia, Yesu ilifea walefemo ine koneni dubulu.</para>
  <para style="ip">Inolo noolohe selesia, “Yesu saabia no obegeba miyobafaleba” solu. Fidahe sowi ewehe selesia, “Miyobafaleba samabiyo. Aubale. Yesu miyobafe. Seale, E ogoba sisiba saabale. Auluso, ogoba sisiba saabale ewene maumo, ewe. Godehe inolo ulenoda afiyale hamebu. E alefasia, idele inolo sunia asigi besimesi hamebu. Aulune, E esebalo ligia, E aso yasiba labe.” (Lalolu 3.9 ami bamale.)</para>
  <para style="ip">
    <figure style="fig" alt="Separator Artwork for the Onobasulu NT - Waves" file="Separator1Onobasulu.tiff" size="span" loc="Between Book entry and text of the NT" copy="Johann Alberts, based on Onobasulu artwork" ref="1.0" /></para>
  <chapter number="1" style="c" sid="2PE 1" />
  <para style="p">
    <verse number="1" style="v" sid="2PE 1:1" />Na Saimono <char style="w" lemma="Fida - Saimono">Fida</char>. Yesu <char style="w" lemma="Keliso">Kelisone</char> <char style="w" lemma="Balu dabalu moloba ofolo faibe">dabalu moloba ofolo</char> ligia, Ene <char style="w" lemma="Hilibaisi daalu inolo">hilibaisi daalu</char> ulenomo, na lolu. Nahe,</para>
  <para style="b" vid="2PE 1:1" />
  <para style="p" vid="2PE 1:1">Sowi ewe seleba mebaisia, <char style="w" lemma="Asigi ule ufulu">asigi ule ufuluda</char> nafuluba sefia alebaibu gili amofea, seleba mebaisu. Yesu Keliso, E-mo nine Gode ligia, nini <char style="w" lemma="Gasiba dafelagoba dilo">gasiba dafelagoba dulu</char>. Ene mana isolu amo alefasia, gine asigi ule ufulu amo yogolelu ligia, nine asigi ule ufulu hamagulu labe.<verse eid="2PE 1:1" /></para>
  <para style="b" />
  <para style="p">
    <verse number="2" style="v" sid="2PE 1:2" />Gilihe Godedai, nine <char style="w">Saminilo</char> Yesudai, fadaba asigife amofea alefasia, Ehe kanululo manada, aeaba ofolo manada, gine libo usu, bulemesi moloba ufiyobafe. Ehe auba molomesi, na Edai sulu selaba lolu.<verse eid="2PE 1:2" /></para>
  <para style="s">Godehe ninimo Ene-ba molobebelelu</para>
  <para style="p">
    <verse number="3" style="v" sid="2PE 1:3" />Yesu, Ene <char style="w" lemma="Elalelu">elalelumo</char> alefasiada, Ene mana nafulu amo alefasiada, nini Ene idele inolo melesi welu. Nini E fadaba asigisi, Ene kiwigagalu amohe, ninifea nine miliyolu kiwigaaba ufiyone kegele sunia melu. Amosuale. Godene mana amone aiba daaba melesi sagoba ufiyone kegele amoda, ninifea melu. E Gode labene, auba moloyone kiwigagalumo E sebu. <verse eid="2PE 1:3" /><verse number="4" style="v" sid="2PE 1:4" />Kegele ninifea auba meyobafeba, Ehe ninifea <char style="w" lemma="Oloba huliale dabalu">oloba huliale</char> sulu saaba melu. Oloba huliale sulu amo bule koleba ligia, olaibo dobu. Wolu molobaiyeba mesegelo amohe, helefealu iwi kegele sunia sesenemesi moloba ofolo. Auluso, Godene oloba huliale sulu solu amofea alefasia, gili seseneyofealo amifia fisaba daafia ligia, Godedai dafifia, Ene mololo mana koleba ua diyobafe.<verse eid="2PE 1:4" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="5" style="v" sid="2PE 1:5" />Aulune, gili koleba, helegeba ligia,</para>
  <para style="li1" vid="2PE 1:5">
    <char style="w" lemma="Asigi ule ufulu">Asigi ule gili ufulu</char> amofea,</para>
  <para style="li2" vid="2PE 1:5">nafulu mololo mana gegoaba homale.</para>
  <para style="li1" vid="2PE 1:5">Aufia, nafulu mololo mana amofea,</para>
  <para style="li2" vid="2PE 1:5">dawalolo gegoaba homale.<verse eid="2PE 1:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="2PE 1:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1.6 </char>
      <char style="xt" closed="false">
        <ref loc="GAL 5:22-23">Gal 5.22-23</ref>
      </char>
    </note>Aufia, dawalolo amofea,</para>
  <para style="li2" vid="2PE 1:6">asigi uluba ado mana gegoaba homale.</para>
  <para style="li1" vid="2PE 1:6">Aufia, asigi uluba ado amofea,</para>
  <para style="li2" vid="2PE 1:6">kiwi sanefia afolale mana gegoaba homale.</para>
  <para style="li1" vid="2PE 1:6">Aufia, kiwi sanefia afolale mana amofea,</para>
  <para style="li2" vid="2PE 1:6">Gode kuliba ano mana gegoaba homale.<verse eid="2PE 1:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="2PE 1:7" />Aufia, Gode kuliba ano mana amofea,</para>
  <para style="li2" vid="2PE 1:7">gine damenefea hameseba ado mana gegoaba homale.</para>
  <para style="li1" vid="2PE 1:7">Aufia, gine damenefea hameseba ado mana amofea,</para>
  <para style="li2" vid="2PE 1:7">idele inolo sunia hamesesia fufuulu mana gegoaba homale.<verse eid="2PE 1:7" /></para>
  <para style="b" />
  <para style="m">
    <verse number="8" style="v" sid="2PE 1:8" />Mana amogulu gine miliyolu usu gegoaba ufulu ligia, sobosenaga, gili balu weaseyobafale. Aubale. Ausenaga, gilihe nine Saminilo Yesu Keliso asigife amofea alefasia, sebe helefeba ulufaba walefe. <verse eid="2PE 1:8" /><verse number="9" style="v" sid="2PE 1:9" />Auluso, inolo mana amoguluda malemo, ehe hago dobumo babiyodoluale, si kalalu labe. Enebamo, <char style="w" lemma="Wolu / Wolu mololo">wolu</char> e samini mololumo heefia galagololu moloba ufulu amo, asigi galiba dafulu labe.<verse eid="2PE 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 1:10" />Wae, ne nelewodali, ne nanodali, Godehe gili wefasia, Ene-ba koleba melesi molobebelelu. Aulugulu, gilihe Ene-ba koleba miliyo amone, helegeba melale. Auba molosenaga, gili hodobaisaeyobafale. <verse eid="2PE 1:10" /><verse number="11" style="v" sid="2PE 1:11" />Ausi, Yesu Kelisohe Saminilo ligia, Yasifia Luba Ligia ada ami, waagi suga malesi, kegele ulenohe gili kaeyobafale. Ninida <char style="w" lemma="Gasiba dafelagoba dilo">gasiba dafelagoba dulu</char> Yesu Keliso Ehe, nine Saminilo ligia, nini yasifia uluba alefalu miliyobafe.<verse eid="2PE 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2PE 1:12" />Seale koleba, gilihe kegele ewe hilisefasia, sulu seale sodomo difasia, gili amofea kalugaafia alebaibu. Auluso, gili kegele amone galiba damesialene, na gilifea saabia bu egeba saeyomo afiyale. <verse eid="2PE 1:12" /><verse number="13" style="v" sid="2PE 1:13" />Na aso helefealu iwi domalada ligia fogo ewemo, gili auba obegeba hiliseba melesine, nahe gili gilaba ofelesia, selabasu miliyobasu. Na gili auba gilaba ofelesenaga, amo nafulu. <verse eid="2PE 1:13" /><verse number="14" style="v" sid="2PE 1:14" /><note caller="-" style="x"><char style="xo" closed="false">1.14 </char><char style="xt" closed="false"><ref loc="2CO 5:1">2Kld 5.1</ref>; <ref loc="JHN 21:18-19">Yon 21.18-19</ref></char></note>Enebamo, na hilisesia, fogo wedino alefasia, ne domala afiyobasuba hilisebu. Nine Saminilo Yesu Kelisohe nafea auba saaba meso. <verse eid="2PE 1:14" /><verse number="15" style="v" sid="2PE 1:15" />Aulugulu, na olafia labi fogomo, kegele na gilifea saaba melumo, gili amo sunia saabia no haiba obegeba hiliseyodolu melesine, na aga helegeba molosu.<verse eid="2PE 1:15" /></para>
  <para style="s">Hilibaisi daalu ilihe, Godene yanemo Yesufea labi abulu</para>
  <para style="p">
    <verse number="16" style="v" sid="2PE 1:16" />Ninihe gilifea saaba melumo, nine Saminilo Yesu Keliso kiwigagaluda obegeba miyobafe amone solu. Ninihe gilifea auba saaba mesiamo, sadalu balu, inolone asigifea holobagagafe amone kuliba abia, saaba meluale. Aubale. Nine sihe, yaneda, Godene wabialelo kiwigagaluda, Efea holobagasi abulu amone sodo. <verse eid="2PE 1:16" /><verse number="17-18" style="v" sid="2PE 1:17-18" />Nini Yesudai <char style="w">muuba kalilu</char> galea aloiya fogo ami, Enao Gode alefasia, wabialelone yane <char style="w">elalelu</char> Efea holobagaso.<note caller="+" style="f"><char style="fr" closed="false">1.17-18 </char><char style="ft" closed="false">Sulu iwi solu amohe, Yesune domalamo noekene dedegeluba solu amone sadalu iminiba selefe. Sadalu amo ga Madiyu 17.1-13 ami bamale. Aufia, Maga 9.2-13 amida, Lugu 9.28-36 amida bamale.</char></note> Nini auba holobagasi bebeleba ligia, dobelesufalumo, Kiwigagalu Wasolu Elalelu amone mofe goo, <char style="w" lemma="Hebene">hebenefia</char> saaba dafogosia, Efea sulu eweguba selesi dubulu. “Ewe ne Naalo, E ne yaguso koleba! Na Efea bule koleba henesu.” <figure style="fig" alt="Father reading Scripture to family" file="05_De_06_01_RG.jpg" size="col" copy="Sweet Publishing" ref="1.19">Ninihe Godene sulu alegafia fedoba seyoba.</figure><verse eid="2PE 1:17-18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2PE 1:19" />Aufia, ninihe <char style="w" lemma="Saaba ofolo">saaba ofolone</char> sulu selelu dobu. Amo saaba ofalu sulu koleba dobu. Aulune, naafa uleno, nigiligagalu dobia ami, yaa neeba doweloguba, saaba ofolo ine sulu seleba ufulu amohe, gine libo usu aubasu yaa neeba doweyobafe. Yane amo neeba dowelabiasu abia, keafa hiliasi, sigabi Waale gine libo usu neeba ofelesi, eloyobafe. Aulune, gili saaba ufulu sulu amo nafuluba beaba melale. <verse eid="2PE 1:19" /><verse number="20" style="v" sid="2PE 1:20" />Auba beaba ligia, eweguba hilisema. Kegele gili fadaba asigiyo dobu amone, kegele olaibomo ewe. Saaba ofolo sulu Godene bugo selelu dobu aleba ami, sulu ulenoda inolo ene asigifeafia holobagalale. <verse eid="2PE 1:20" /><verse number="21" style="v" sid="2PE 1:21" /><note caller="-" style="x"><char style="xo" closed="false">1.21 </char><char style="xt" closed="false"><ref loc="2TI 3:16">2Dim 3.16</ref>; <ref loc="1PE 1:11-12">1Fid 1.11-12</ref></char></note>Mau enebamo, saaba ofa solu sulu uleno, inolo hamehe holobagasi sodale. Aubale. <char style="w" lemma="Asubane Noekene">Godene Asubane Noekenemo</char> alefasia, saaba ofolo ilihe, Godene sulu ilifea saaba mefe amone sodo.<verse eid="2PE 1:21" /></para>
  <chapter eid="2PE 1" />
  <chapter number="2" style="c" sid="2PE 2" />
  <para style="s">Masega walelo ilihe sese idele inolone asigi dabagalaba ofelefe</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 2:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2.1 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:11">Mad 24.11</ref>; <ref loc="JUD 1:4">Yud 1.4</ref></char>
    </note>Auluso, saminimo, masega saaba ofa walelo nooloda Isolaele mosomu aleba holobagagalu. Amogubasu, inolo nooloda gili aleba ugi holobagagafia, idele inolofea masega waleyobafe. Ili amo muguba ligia, masega sulu nokene nokeneba, gine asigi ule ufulu ogone woba dafiyone waleyobafe. Nine Biso Yesu Ehe, ili obegeba elegeba duluso, ili amohe E waaselaba bisigia, Efea faiso meyobafe. Ili amohe auba molosi, alebale hamagi, ine ilida woba dafiyobafe. <verse eid="2PE 2:1" /><verse number="2" style="v" sid="2PE 2:2" />Idele inolo wedinalemo, susugu moloyone libo degelo mana amone kuliba dedaleyobafe. Ausi, mana auba molofe amo bisigia, noolohe seale sodo eno amofea gaidaboba woba saeyobafe. <verse eid="2PE 2:2" /><verse number="3" style="v" sid="2PE 2:3" />Inolo ili ogohe, ine mesegelo mana amofea alefasia, inolo dofeleba sulu selesia, gine mole kegele sunia sigiba molaeyobafe. Auluso, ilida fadaba saafia osolaba dafiyobafeba, amo samini waagi ama iminiba ufulu dobu. Seale. Woba dafiyo hilia ilifea holobagaeyobafe amo, hanemia hanesiale yasifiasu labe. Godehe ili amo waagi wolu moloba melesi gadefaeyobafale.<verse eid="2PE 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2PE 2:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2.4 </char>
      <char style="xt" closed="false">
        <ref loc="JUD 1:6">Yud 1.6</ref>
      </char>
    </note>Gili asigibu, amakele koleba, hebene lagi, <char style="w" lemma="Godene sulu dia ano">sulu dia ano</char> noolohe wolu molosi, Godehe ilida waagi melesi gadefaluale.<note caller="+" style="f"><char style="fr" closed="false">2.4 </char><char style="ft" closed="false">Amakele koleba, Sedene eda Godene sulu dia ano alolu. Auluso, e Gode sisa miliyale adesia, ehe sulu dia ano noolo edai ene mosomu melesi sigilu. </char></note> Aubale. Ehe ili dofafia, hele kaleba ulumaluda male usu ami dafogolu. Nigili gagaiya ami dofafia ligia, ili auba dibolo ligiasu, Osolaeyo Hilia amone yasiba yaafia alebaibu.<verse eid="2PE 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2PE 2:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2.5 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 6-8">Stt 6–8</ref>; <ref loc="2PE 3:6">2Fid 3.6</ref></char>
    </note>Aufia, amakele helefealu asulu idele inolo ili Godefea faiso mesi, Ehe ilida waagi melesi gadefaluale. Aubale. Ehe helefealu sunia hano galuba gasiaguba ofelesi, idele inolo Efea faiso melu amo sunia daba dafalilu. Auluso, isolu manada walelu Noa amo, eda, ene damene domoba amoda, Ehe haguguba ufulu.<verse eid="2PE 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2PE 2:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2.6 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 19:24">Stt 19.24</ref>; <ref loc="JUD 1:7">Yud 1.7</ref></char>
    </note>Aufia, <char style="w" lemma="Sodomo">Sodomodai</char>, Gomoladai, Godehe osolaba dafelesia, woba dafelesia de subulune, defene kalemo ufia labe. Ausimo, dauno aida amofea auba mololumo, hagugusia dedeba mololu. Enebamo, Godefea faiso mefe idele inolo ili amofeada aubasu moloyone hagugusia dedeba mololu. <verse eid="2PE 2:6" /><verse number="7" style="v" sid="2PE 2:7" /><note caller="-" style="x"><char style="xo" closed="false">2.7 </char><char style="xt" closed="false"><ref loc="GEN 19:1-16">Stt 19.1-16</ref></char></note>Auluso, isolu inolo <char style="w">Lode</char>, Sodomo ami ligia, ehe eloda ofolale idele inolo susugu moloyone libo degelo mana nokene nokeneba molofe baafia, ene libo higinilu koleba. Ausi, Godehe e-mo Sodomofeafia gasiba disi, e woba dafuluale. <verse eid="2PE 2:7" /><verse number="8" style="v" sid="2PE 2:8" />Seale koleba, isolu inolo Lode amo, Sodomo ili aleba ligia, ine wolu molofemo beaba ligia, hilia sunia ili sulu wolu selefemo, e dobolaba alolu. Ene libo isolu ligia, ili muguli mana geleba molofe amofea haboba bisigia, ene libo nagafia haboba hiliselu.<verse eid="2PE 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2PE 2:9" />Amakele kegele mololumone awaba solu dofasia, nini eweguba asigibu. Godehe idele inolo Eda kuliba daaba labe ili amo, dedeba besabea amifia, gasiba dafelagoloba asigibu. Auluso, isoluale idele inolo ili amo, Ehe dibolo dafogosi, ili ami ufiasu ligia, Osolaeyo Hilia adefea ami, eloyobafe. Hilia ami, Ehe sabesia, ilifea naga meyobafe. <verse eid="2PE 2:9" /><verse number="10" style="v" sid="2PE 2:10" /><note caller="-" style="x"><char style="xo" closed="false">2.10 </char><char style="xt" closed="false"><ref loc="JUD 1:7-8">Yud 1.7-8</ref>, <ref loc="JUD 1:16">16</ref></char></note>Idele inolo ami naga diyobafe ili amone olaibomo, ili ewe. <char style="w">Helefealune huu</char> mesegelo mana kuliba abia, domalafealomo nugumalu mana molobaiyesia, wida solu labefea golaba bolo. Ili amo, eleliba yaafia, ine melebasu asigisia, hebene lagi <char style="w" lemma="Elalelu">elaleluda</char> alebailo amofea, gaidaboba woba saeyone sagilibale ado. <verse eid="2PE 2:10" /><verse number="11" style="v" sid="2PE 2:11" /><note caller="-" style="x"><char style="xo" closed="false">2.11 </char><char style="xt" closed="false"><ref loc="JUD 1:9">Yud 1.9</ref></char></note><char style="w">Godene sulu dia ano</char> ine kiwigagalu amohe, inolo ogone kiwigagalu suniafia, wasolu koleba labe. Auluso, sulu dia ano ilihe inolo ogo, <char style="w" lemma="Saminilo">Saminilone</char> si saabia fadaasiamo, ilifea gaidaboba woba sodale. <verse eid="2PE 2:11" /><verse number="12" style="v" sid="2PE 2:12" /><note caller="-" style="x"><char style="xo" closed="false">2.12 </char><char style="xt" closed="false"><ref loc="JUD 1:10">Yud 1.10</ref></char></note>Aubale. Auluso, inolo ili ogo, asigida male adesia, babeafia ligia, kegele ili dawalobuale amone gaidaboba sodo. Ili kelebulugulu asigida male ligia, domala balu ulubia ano. Kelebulu amo, inolohe ili sefia yasoba danemesi, seba dulu alebaibu. Amogubasu, inolo ili ogoda woba dafiyobafe.<verse eid="2PE 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2PE 2:13" />Sabesiamo, isoluale mana mololu amofea isoluale mana meyobafe. Ili ogo ine mana molobaiyelo amohe, nigilibasu sigilo adale. Aubale. Yaidada, ili muguba ofelesia yuabale ligia, sigilo gagaiyobasu ado. Ili amo, gili galiba naiyo bule ua naiyone kakainasiamo, ine gegelo mana amone libo degesia, gili aleba ugi, nugumalu yualu besabe. <verse eid="2PE 2:13" /><verse number="14" style="v" sid="2PE 2:14" />Hilia sunia susugu molobaiyeba hamelo amo, ine asigifea wasigafia labe. <char style="w" lemma="Wolu / Wolu mololo">Wolu</char> moloyo elosiale, mololabia daabasu ado. Kiwi sanefia alebaibu amo, ilihe wolu moloyone hahanosia seseasia sigilo. Molobaiyeba mesegelo mana amone, ilihe ine meleba dawaloba dulu labe. Aulune, ili amo kanoloda dobia ami alebaibu. <verse eid="2PE 2:14" /><verse number="15" style="v" sid="2PE 2:15" /><note caller="-" style="x"><char style="xo" closed="false">2.15 </char><char style="xt" closed="false"><ref loc="NUM 22:7">Nam 22.7</ref>; <ref loc="JUD 1:11">Yud 1.11</ref>; <ref loc="REV 2:14">MUU 2.14</ref></char></note>Ilihe eno isolufealo maiyomo afasia, elawaneba dedaleba labe. Ilihe Beone faibe Balamane mana amone kuliba dedalefe. Ehe isoluale mana molofe amone elebe diyo hamelu. <verse eid="2PE 2:15" /><verse number="16" style="v" sid="2PE 2:16" /><note caller="-" style="x"><char style="xo" closed="false">2.16 </char><char style="xt" closed="false"><ref loc="NUM 22:28-35">Nam 22.28-35</ref></char></note>Auluso, Balama ene <char style="w" lemma="Dofene dogi">dofene dogihe</char>, inolo sulu sodoguba, halaleba selesia, efea mana solu. Dogimo inolone sulu sodoguba sodale. Aubale. Auluso, Balama asigida male adesia, e heleba molofe amone kaeyofia, Gode Ehe dogifea sulu waagi saamesi gadefalu.<verse eid="2PE 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 2:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2.17 </char>
      <char style="xt" closed="false">
        <ref loc="JUD 1:12-13">Yud 1.12-13</ref>
      </char>
    </note>Inolo ili ogo, hano sugulo usuba dulu amogulu labe. Aufia, ili kene mogaifohe fuuba dafalilo amogulu labe. Nigili saooba daiya hele amo, ili ami melesi, madenefia diba dobu. <verse eid="2PE 2:17" /><verse number="18" style="v" sid="2PE 2:18" />Inolo ili ogohe sulu yogolelusu selesiaso, mofe baleleba masega sodo. Sigidubulu noolomo, heleba daaiya amifia hili obegeba dulu alebaibu. Wolu inolo ilihe, sigidubulu hili amone hahanosia, ine mesegelo mana amo kuliba abia, susugu mana molomesi sigilo. <verse eid="2PE 2:18" /><verse number="19" style="v" sid="2PE 2:19" />Inolo wolu ili amomo eweguba sodo. “Gilihe nini kuliba esenaga, gili kegele sunia gine hamefeguba moloyone beega miliyobafe.” Auba sodoso, ine ilimo, woba dafiyofealo dibolo inolo ligia, wolune <char style="w" lemma="Balu dabalu moloba ofolo faibe">balu dabalu moloba ofolo</char> labe. Enebamo, gada yasimesi waagi fogo melu amo e, ge biso adesi, ga-mo, ene dabalu balu molosia, ene dibolo inolo adefe.<verse eid="2PE 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2PE 2:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2.20 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 12:45">Mad 12.45</ref>
      </char>
    </note> Saminilo Yesu <char style="w">Keliso</char>, E, ninida <char style="w" lemma="Gasiba dafelagoba dilo">Gasiba Dafelagoba Dulu</char> amo labe. Idele inolo abehe, E fadaba asigifia adesenaga, helefealu ewene nugumalu amofeafia siba dafia, fisaba daalu labe. Auluso, ili obegeba daafia, nugumalu usu haiba no wadesenaga, helefealune manahe ili saabia dofasimo, ili dibolo miliyobafe. Saminimo, ili wolu aloluso, agamo ili amo wolune wolu koleba miliyobafe. <verse eid="2PE 2:20" /><verse number="21" style="v" sid="2PE 2:21" /><note caller="-" style="x"><char style="xo" closed="false">2.21 </char><char style="xt" closed="false"><ref loc="LUK 12:47-48">Lug 12.47-48</ref></char></note>Ilihe Gode molomesi hamelumo asigiba dulualebiaga, ili higinilu bule dibaiyale. Auluso, ilihe Godene molomalelu sulu noekenemo dofasia, faiso mefia, haiba egeisa dedalelune, higinilu bule koleba diyobafe. <verse eid="2PE 2:21" /><verse number="22" style="v" sid="2PE 2:22" /><note caller="-" style="x"><char style="xo" closed="false">2.22 </char><char style="xt" closed="false"><ref loc="PRO 26:11">Snd 26.11</ref></char></note>Kegele ili molofe ewemo, saaba ofa sulu ulenohe eweguba iminiba sodo.</para>
  <para style="b" vid="2PE 2:22" />
  <para style="q" vid="2PE 2:22">
    <char style="qt">Gesomo, isaba ofasia, ene haiba nolo. </char></para>
  <para style="b" vid="2PE 2:22" />
  <para style="m" vid="2PE 2:22">Aufia, sulu noda eweguba sodo.</para>
  <para style="b" vid="2PE 2:22" />
  <para style="q" vid="2PE 2:22">Dofenemo hano mulufasia, eda banaiba ada ami, haiba saabia banaiyo ano.<verse eid="2PE 2:22" /></para>
  <chapter eid="2PE 2" />
  <chapter number="3" style="c" sid="2PE 3" />
  <para style="s">Saminilo Yesumo seale obegeba miyobafe</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 3:1" />Ne yagusodali koleba, sowi na gilifea seleba mesu ewemo, sowi aganebo. Sowi aida ewehe, gili kegele sunia amone helegeba asigimesi, na gine asigi degeba ifoyo hamefe. Gili amone asigi galilosi. <verse eid="2PE 3:1" /><verse number="2" style="v" sid="2PE 3:2" /><note caller="-" style="x"><char style="xo" closed="false">3.2 </char><char style="xt" closed="false"><ref loc="JUD 1:17">Yud 1.17</ref></char></note>Na hamefemo, amo ewe. Gili koleba, Godene <char style="w">muuba kalilu</char> <char style="w">saaba ofolo</char> inolo ilihe dufia moloyobafemone sulu saaba ufulumo, gilihe asigiba obegemesi hamefe. Aufia, gili koleba, ninida <char style="w" lemma="Gasiba dafelagoba dilo">Gasiba Dafelagoba Dulu</char> Inolo amone molomalelu sulu amoda, hiliseba obegemale. <char style="w" lemma="Saminilo">Saminilone</char> molomalelu sulu amo, <char style="w">hilibaisi daalu inolo</char> gili labea milibailu amone mofeyofeafia, gili dubulu. <verse eid="2PE 3:2" /><verse number="3" style="v" sid="2PE 3:3" /><note caller="-" style="x"><char style="xo" closed="false">3.3 </char><char style="xt" closed="false"><ref loc="1TI 4:1">1Dim 4.1</ref>; <ref loc="JUD 1:18">Yud 1.18</ref></char></note>Kegele gili asigiyo dobumo amone olaibomo ewe. Aleba eloyo hilia hagoalesimo, gaidaboba saeyo inolo holobagagaeyobafe. Ili amo, ine mesegelo mana kuliba abia, wolu molobaiyesia, dedaleba yaeyobafe. Ili alefasia, eweguba gaidaboba saeyobafe. <verse eid="2PE 3:3" /><verse number="4" style="v" sid="2PE 3:4" /><note caller="-" style="x"><char style="xo" closed="false">3.4 </char><char style="xt" closed="false"><ref loc="MAT 24:48">Mad 24.48</ref></char></note>“Yesuhe sulu saaba ofa selesia, E saabia obegeba miyoba saaba ufulula? Aulugulu, E aga wagi labe? Aa! Ogo miyobafale. Bama. Saladegelu idele inolo, Yesu E ilifea auba saaba ufulu amo, aga daneba dulu. Helefealu moloiya amifia inigia, aga iwida, ene samini abulu hamagulu dedegeluale labe.”<verse eid="2PE 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2PE 3:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3.5 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 1:6-9">Stt 1.6-9</ref>
      </char>
    </note>Ili auba gaidaboba selesiamo, asigi ilifea dobuso, asigiyo habosia, elaba aafe. Asigi ilifea dobumo ewe. Amakele koleba, sulu Gode solumo alefasia, anakiwi holobagafia labe. Aufia, sulu E solumo alefasia, hano osolaba ofelesi, helefealumo hano aleba ami holobagafia labe. <verse eid="2PE 3:5" /><verse number="6" style="v" sid="2PE 3:6" /><note caller="-" style="x"><char style="xo" closed="false">3.6 </char><char style="xt" closed="false"><ref loc="GEN 7:11">Stt 7.11</ref>; <ref loc="2PE 2:5">2Fid 2.5</ref></char></note>Aufia dufia, helefealuda, anakiwida, fogo ami ufulu amo, hano galusia, hano amo alefasia sunia woba dafulu. <verse eid="2PE 3:6" /><verse number="7" style="v" sid="2PE 3:7" />Auluso, helefealuda, anakiwida, aga dobu ewe, sulu Gode solu hamagane alefasia, samolo haguguba diba ofologuba, Osolaeyo Hilia yasisia diba ufia labe. Hilia ami, dehe idele inolo Godefea faiso mefia alebaibu ili amo sunia woba dafiyobafe.<verse eid="2PE 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2PE 3:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3.8 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 90:4">Sng 90.4</ref>
      </char>
    </note>Ne yagusodali koleba, gilihe kegele uleno ewe galimabiyo. Saminilone asigimo, hilia ulemo, hamu daosene uleba sodo. Aufia, hamu daosene ulemo, hilia uleba sodo. <verse eid="2PE 3:8" /><verse number="9" style="v" sid="2PE 3:9" /><note caller="-" style="x"><char style="xo" closed="false">3.9 </char><char style="xt" closed="false"><ref loc="HAB 2:3">Hab 2.3</ref>; <ref loc="1TI 2:4">1Dim 2.4</ref></char></note>Saminilohe oloba huliale sulu saaba ofa selesia, E obegeba miyobafeba saaba ufulu. Auluso, noolo selesia, “Oloba huliale sulu saaba ufulu amo molobale labi, Saminilo yagelefeba” selefe. Auluso, ili auba selesenagada, hama, E yagelefale. Aubale. Ehe inolo uleno daba damesialesia, idele inolo sunia <char style="w" lemma="Asigi besiyo">asigi besiba</char> yaamesifia, Ehe gilifea esebalo esebaloba molosia, aso yasifia labe.<verse eid="2PE 3:9" /></para>
  <para style="s">Godehe helefealuda, anakiwida, hili moloyobafe</para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 3:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3.10 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 12:39">Lug 12.39</ref>; <ref loc="1TH 5:2">1Des 5.2</ref>; <ref loc="MAT 24:29">Mad 24.29</ref>, <ref loc="MAT 24:35">35</ref></char>
    </note>Nafuluba. Saminilone hilia holobagaeyobafemo, fadilo inolo hidigiba dafa anoguba, hidigiba dafa miyobafe. Hilia amoyamo, gala bule dafelesi, anakiwi asigilesia, afa maiyobafe. Auba ausi, haloda, aubeda, sigabida, amo sunia koleba halosi neesia, dadaba yaeyobafe. Ausi, helefealuda, kegele helefealu saabia mololu dobumo sunia amoda, ulufaba dobi babiyobafe.<note caller="+" style="f"><char style="fr" closed="false">3.10 </char><char style="fq" closed="false">Ulufaba dobi babiyobafe. </char><char style="ft" closed="false">Gili Baibolo selelu noolo alegasiamo, sulu nonoba selelu babiyobafe. Noolohe iwi selesiamo, helefealu asigileyobafeba selelu dobu. Lalolu ewemo, Giligi suluba nafuluba sawaba seleba ufuluale dobu. </char></note><verse eid="2PE 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2PE 3:11" />Kegele sunia, ine moloba waalebia amifia fisigasia, hodobaisaeyobafegulu, gili aga halaguba miliyobase? Gili Godedai <char style="w">muuba kalilu</char> ligia, Ene mana kuliba daabasu melale. <verse eid="2PE 3:11" /><verse number="12" style="v" sid="2PE 3:12" />Auba daabasu ligia, gili Godene hilia amo holobagamesisia, holobagaeyoda ami goayone, ogoba sisiba malale. Hilia amoyamo, anakiwi de waiya sobelesi, fisigasia hodobaiyobafe. Aufia, haloda, aubeda, sigabida, halosi neesia, dadaba yaeyobafe. <verse eid="2PE 3:12" /><verse number="13" style="v" sid="2PE 3:13" /><note caller="-" style="x"><char style="xo" closed="false">3.13 </char><char style="xt" closed="false"><ref loc="ISA 65:17">Ais 65.17</ref>; <ref loc="ISA 66:22">66.22</ref>; <ref loc="REV 21:1">MUU 21.1</ref>, <ref loc="REV 21:27">27</ref></char></note>Auluso, Godehe <char style="w" lemma="Oloba huliale dabalu">oloba huliale</char> sulu saaba dobumo alefasia, nini koleba, anakiwi hilida, helefealu hilida, holobagamesisia yasiba lolu. Amimo, isolu manasu ufiyobafe.<verse eid="2PE 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2PE 3:14" />Ne yagusodali koleba, gili kegele auba holobagamesi yasiba ligia, Godene si saabia heleba daalu ulenoda male ligia, galagololu miliyone helegeba molomale. Ausimo, gili Edai hilise ule ligia, <char style="w" lemma="Aealo - Aeaba Ofolo">aeaba</char> miliyobafe. <verse eid="2PE 3:14" /><verse number="15" style="v" sid="2PE 3:15" /><note caller="-" style="x"><char style="xo" closed="false">3.15 </char><char style="xt" closed="false"><ref loc="ROM 2:4">Lom 2.4</ref></char></note>Nine Saminilohe nini yasifia ligia, esebalo esebaloba moloba labe. Gili asigima. Ehe nini <char style="w" lemma="Gasiba dafelagoba dilo">gasiba dafelagoba</char> diyosia, auba esebaloba moloba ado. <char style="w">Folo</char>, nine nelewo hameselu amo, eda gilifea aubasu seleba melubiyo. E kegele amogulu saaba sulu seleba mesiamo, dawalolo Godehe efea melu amofea alefasia seleba melo. <verse eid="2PE 3:15" /><verse number="16" style="v" sid="2PE 3:16" />Ene sowi selelu usu ami, kegele dufia holobagaeyobafe amone sulu seleba melubiyo. Ene sulu selelu noolomo, asigiba diyo kolelu dobiyo. Ee, babealu inolo noolohe, ine asigi ule ufulufealomo kiwigaaba kalugaaluale ligia, ene sulu noolo besisia, aliliba solubiyo. Baibolo bugo selelu nooloda, ilihe auba aulo. Auba ausimo, ili ine meleba woba dafelefe.<verse eid="2PE 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 3:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3.17 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 13:33">Mag 13.33</ref>; <ref loc="1CO 10:12">1Kld 10.12</ref></char>
    </note>Ne yagusodali, doma. Kegele dufia holobagaeyobafemo, aso holobagabale labi, gili aga ama nafuluba fadaba asigibu. Aulugulu, gili gine meleba nafuluba yasiba melale. Elo ofolale inolo ilihe, gili heleba sigiba dia dedalesi, gilida kalugaaiya amifia hodobailosine, gili gine meleba yasifia ligia, enogele melale. <verse eid="2PE 3:17" /><verse number="18" style="v" sid="2PE 3:18" />Yesu <char style="w">Keliso</char> E nine Saminilo ligia, E ninida <char style="w">gasiba dafelagoba dilo</char> inolo labe. Ehe gilifea kanulusi, gili E fadaba asigilabia daabasu ligia, miliyolu sobobasu melale.</para>
  <para style="b" vid="2PE 3:18" />
  <para style="qc" vid="2PE 3:18">
    <char style="w" lemma="Elalelu">Elalelumo</char></para>
  <para style="qc" vid="2PE 3:18">agada, dufiada,</para>
  <para style="qc" vid="2PE 3:18">Efea alefalu miliyobafe.</para>
  <para style="qc" vid="2PE 3:18">
    <char style="sls">
      <char style="w">Amen</char>.</char> Amo seale koleba.</para>
  <para style="p" vid="2PE 3:18">
    <figure style="fig" alt="End of book bilas" file="EndOfBookOnobasulu_Epistles.tiff" size="span" loc="End of Book" ref="3.18" /><verse eid="2PE 3:18" /></para>
  <chapter eid="2PE 3" />
</usx>