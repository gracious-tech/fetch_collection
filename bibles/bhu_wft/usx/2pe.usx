<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2PE" style="id">- Bhumiya Standard Project</book>
  <para style="h">पतरस</para>
  <para style="toc3">2 पतरस</para>
  <para style="toc2">2 पतरस</para>
  <para style="toc1">2 पतरस कर चिट्ठी</para>
  <para style="mt2">2 पतरस की चिट्ठी</para>
  <para style="mt1">2 पतरस कर चिट्ठी</para>
  <para style="imt">परचा</para>
  <para style="ip">2 पतरस चिट्ठी कथै, कि हइ प्रेरित पतरस दवारा लिखे गय रथै, पय आज कइ दिमाक बाले इके सही नेहको मानथै, हइ सही हबै कि कउनो अउ इके पतरस के ओर लग लिखे होय। लेखक कथै कि ऊ यीसु के जीवन के अउ खास के रूपान्तरन <char style="xt"><ref loc="2PE 1:17-18">1:17-18</ref> </char>के गवाह रथै। अगर पतरस चिट्ठी लिखे रथै ता सही हबै, कि ऊ इके रोम सहर हे मसीह के पइदा के 65-69 साल के बीच मरे लग पहिले लिखे होय।</para>
  <para style="ip">पतरस इके अपन दूसर चिट्ठी <char style="xt"><ref loc="2PE 3:1">3:1</ref> </char>कथै, जउन 1 पतरस के चिट्ठी के बाद लिखे के तारिख रखथै। उन सगलू मसीहन के चिट्ठी के संबोधित करिस। पतरस हइ चिट्ठी बिस्वासिन के निक्खा जीवन जीय के निता प्रोत्साहन करै, अउ ठगरा सिक्छन के आदेस झइ मानै के चेतन्त देय के निता लिखे रथै। <char style="xt"><ref loc="2PE 2">2</ref></char> ऊ उनके उन मनसेन के अपेक्छा करै के निता प्रोत्साहन करिस, जउन कहत रहै कि यीसु के वापिस आय हे बोहत टेम लगथै। एखर बजय ऊ गुठेइस कि भगवान धीम नेहको हबै बलुक चाहथै कि हर कउ बचाय जाय। <char style="xt"><ref loc="2PE 3:8-9">2 पतरस 3:8-9</ref></char> हइ अक्ठी निक्खा जीवन जीय के अक्ठी कारन हबै। <char style="xt"><ref loc="2PE 3:14">3:14</ref></char></para>
  <para style="iot">रूप रेखा</para>
  <para style="io1">1. पतरस अपन परचा देथै अउ अपन पढै बालेन के संबोधित करथै। <char style="ior"><ref loc="2PE 1:1-2">1:1-2</ref> </char></para>
  <para style="io1">2. फेर ऊ उनके निक्खा जीवन जीय के सुरता दिलाथै काखे भगवान हमके सक्छम करे हबै। <char style="ior"><ref loc="2PE 1:3-21">1:3-21</ref></char></para>
  <para style="io1">3. एखर बाद ऊ ठगरा सिक्छन के खिलाप चेतन्त देथै अउ कथै कि आखरी हे ठगरा गुरून के का होही। <char style="ior"><ref loc="2PE 2:1-22">2:1-22</ref></char></para>
  <para style="io1">4. ओखर बाद पतरस बिस्वासिन के यीसु के दूसर आगमन के तइयारी के निता निक्खा जीवन जीय के निता प्रोत्साहन करत समापत करथै। <char style="ior"><ref loc="2PE 3:1-17">3:1-17</ref> </char></para>
  <chapter number="1" style="c" sid="2PE 1" />
  <para style="s">सोगत</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 1:1" />यीसु मसीह के हरवाह अउ चेला समोन पतरस के हइ चिट्ठी उन मनसेन के नाम हबै, जिनही हमर भगवान अउ मुकति करै बाले यीसु मसीह, के धरमी काम के दवारा हमर जसना बिस्वास के कीमती बरदान मिले हबै।<verse eid="2PE 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2PE 1:2" />तुम मनसेन के भगवान के अउ हमर परभु यीसु के पहिचान के दवारा अनुगरह किरपा अउ सान्ति तुम्हर हे बोहतायत लग पाउत रहा।<verse eid="2PE 1:2" /></para>
  <para style="s">भगवान कर बुलउवा अउ चुनाव</para>
  <para style="p">
    <verse number="3" style="v" sid="2PE 1:3" />भगवान के बडा सक्ति हमही ऊ सब दय हबै, जउन भक्ति के जीवन के निता जरूरी हबै अउ हमही ओखरे ग्यान पामै के ओग बनाय हबै, जउन हमही अपन महिमा अउ निक्खा काम करै के निता बुलाय हबै। <verse eid="2PE 1:3" /><verse number="4" style="v" sid="2PE 1:4" />उस महिमा के दवारा ऊ हमर निता अपन बडा अउ कीमती टीमा के पूर करे हबै, इहैमेर तै ऊ असक्ति लग बच गय, जउन बेकार वासना के कारन दुनिया हे बसे हबै अउ तै भगवान बेउहार के सहभागी बन गय हबस। <verse eid="2PE 1:4" /><verse number="5" style="v" sid="2PE 1:5" />इहैनिता तै पूर मेहनत लग परयास करत अपन बिस्वास हे अच्छा गुन अउ अच्छा ग्यान लग। <verse eid="2PE 1:5" /><verse number="6" style="v" sid="2PE 1:6" />तोर ग्यान संयम लग, तोर संयम धीर लग, तोर धीर सक्ति लग, <verse eid="2PE 1:6" /><verse number="7" style="v" sid="2PE 1:7" />अउ भक्ति हे भाईचारा के बिस्वास अउ भाईचारा के बिस्वास हे माया बढाउत जा। <verse eid="2PE 1:7" /><verse number="8" style="v" sid="2PE 1:8" />अगर हइ गुन तुम्हर हे मउजूद हबै, अउ बढत जथै, ता हइ हमर परभु यीसु मसीह के सगलू ग्यान पामै के निता तुमही निकम्मा नेहको होमैका पडही, अउ न फेल हुइहा। <verse eid="2PE 1:8" /><verse number="9" style="v" sid="2PE 1:9" />जउन मनसे हे हइ गुन मउजूत नेहको हबै ऊ अन्धरा हबै, ढटेवत फिरथै, काखे ऊ बिसर जथै, कि ओखर पुरान पाप धोबर के सुध्द हुइ चुके हबै।<verse eid="2PE 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 1:10" />इहैनिता भाई अउ बेहन तुम अपन बुलउवा अउ चुने जाय के साबित करै के निता पूर-पूर परयास करत रइहा, अगर तुम असना करत रइहा ता कबहुन रास्ता लग नेहको भटकिहा अउ न ठोकड खइहा। <verse eid="2PE 1:10" /><verse number="11" style="v" sid="2PE 1:11" />हइ मेर हमर परभु अउ मुकति करै बाले यीसु मसीह के सबरोज के राज हे तुमही परवेस दइके परभु अपन उदारता दिखाही।<verse eid="2PE 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2PE 1:12" />इहैनिता तुम हइ बात जानथा अउ पाय हर सत्य हे मजबूत बने रहा, तउभरमा मै एखर सुरता देवाउत रइहों। <verse eid="2PE 1:12" /><verse number="13" style="v" sid="2PE 1:13" />मै जब तक हइ देह हे मउजूद हबो, तुमही सुरता देबाय के चेतन्त रखैका अपन जिम्मेदारी समझथो। <verse eid="2PE 1:13" /><verse number="14" style="v" sid="2PE 1:14" />काखे मै जानथो कि मोके हरबी हइ देह छांडै के पडही, जसना कि हमर परभु यीसु मसीह मोके परगट करे हबै। <verse eid="2PE 1:14" /><verse number="15" style="v" sid="2PE 1:15" />मै एखर पूर धियान रखिहों, कि मोर कढ जाय के बाद तुम सगलू हइ बातन के सुरता रख सका।<verse eid="2PE 1:15" /></para>
  <para style="s">मसीह संगति के आंखी देखै गवाही</para>
  <para style="p">
    <verse number="16" style="v" sid="2PE 1:16" />जब हम तुमही अपन परभु यीसु मसीह के सक्ति अउ आमै के बारे हे बतायन, ता हम होंसियारी लग गढे हर किस्सन के मदत नेहको लयन, बलुक अपन आंखी लग ओखर महान काम के देखन। <verse eid="2PE 1:16" /><verse number="17" style="v" sid="2PE 1:17" />जब यीसु मसीह बाफ भगवान लग इज्जत अउ महिमा पाइस, प्रतापमय महिमा ओही आदर करत हइ गोहराइस, “हइ मोर पिरिया टोरवा हबै, मै एखर लग मगन हबो<note caller="+" style="x"><char style="xo" closed="false">1:17 </char><char style="xt" closed="false"><ref loc="PSA 2:7">भजन 2:7</ref>; <ref loc="ISA 42:1">यसा 42:1</ref></char></note>।” <verse eid="2PE 1:17" /><verse number="18" style="v" sid="2PE 1:18" />जब हम पवितर डोंगर हे ओखर संग रहन, ता हम खुदय बादर लग आउत हइ आरो सुने रहन<note caller="+" style="x"><char style="xo" closed="false">1:18 </char><char style="xt" closed="false"><ref loc="MAT 17:1-5">मत्ती 17:1-5</ref>; <ref loc="MRK 9:2-7">मरकुस 9:2-7</ref></char></note>।<verse eid="2PE 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2PE 1:19" />इहैनिता ग्यानी मनसेन के बचन अउ बोहत बिस्वासओग हुइ गय हबै, ओखर हे तुम्हर धियान अक जिघा करैका ठीक हबै, ओसनेन निक्खा हबै जसना जलत हर चिमनी हे धियान अक जिघा करैका, जब तक सुबेन्नेन झइ होय अउ तुम्हर हिरदय हे भिनसारे के तरइया नेहको निकडथै। <verse eid="2PE 1:19" /><verse number="20" style="v" sid="2PE 1:20" />पय सबले पहिले हइ समझ लेया कि पवितर किताब के कउनो आगू कर बात खुद ग्यानी मनसेन के अपन सोंच नेहको हबै। <verse eid="2PE 1:20" /><verse number="21" style="v" sid="2PE 1:21" />काखे मनसेन के इक्छा लग कबहुन आगू कर बात नेहको हुइस, बलुक पवितर आतमा लग प्रेरित हुइके मनसे भगवान के तरफ लग बोलत रहिन।<verse eid="2PE 1:21" /></para>
  <chapter eid="2PE 1" />
  <chapter number="2" style="c" sid="2PE 2" />
  <para style="s">ठगरा गुरू</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 2:1" />ठगरा ग्यानी मनसे इस्राएल देस हे परगट होय रहिन, ठीक उहैमेर तुम्हर बीच ठगरा गुरू हुइहीं, जउन लुके मेर लग आदेस ना मानै बाले भरमामै बाले जसना मेर परचार करही, उन स्वामी के नेहको मनही, जउन उनही खरीद लय हबै, अउ हइ मेर उन जलदी अपन नास के कारन बनही। <verse eid="2PE 2:1" /><verse number="2" style="v" sid="2PE 2:2" />बोहत मनसे उनखर जसना लुचपन के चाल चलन चलही, अउ उनखर कारन सत्य के रास्ता निन्दा करे जही<note caller="+" style="x"><char style="xo" closed="false">2:2 </char><char style="xt" closed="false"><ref loc="EZK 36:22">यहेज 36:22</ref>; <ref loc="ROM 2:24">रोमियो 2:24</ref></char></note>। <verse eid="2PE 2:2" /><verse number="3" style="v" sid="2PE 2:3" />उन लालच हे तुमही अपन मन गडन्त बातन हे फसाय के तुम्हर लग बेकार फायदा उठाही, उनखर निता नियाव सजा पहिले लग तय हुइ चुके हबै, अउ ऊ उनखर पाछू करत हबै, उनखर नास सोय हर नेहको हबै।<verse eid="2PE 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2PE 2:4" />जब भगवान उन पापी स्वरगदूतन के माफ नेहको करिस, बलुक उनही नरक के अंधियार कुन्ड हे नियाव के रोज के निता सांकड हे बांध दय हबै। <verse eid="2PE 2:4" /><verse number="5" style="v" sid="2PE 2:5" />जब ऊ पुरान युग के दुनिया के नेहको छांडिस, पय पानी के बाढ के दवारा पापिन दुनिया के नास करिस, पय ऊ नियाइपन धरमी काम करै बाले नूह अउ ओखर परवार सहित आठझन मनसेन के बचाइस<note caller="+" style="x"><char style="xo" closed="false">2:5 </char><char style="xt" closed="false"><ref loc="GEN 6:5-8">उत्पति 6:5-8</ref>; <ref loc="GEN 7:23">7:23</ref></char></note>, <verse eid="2PE 2:5" /><verse number="6" style="v" sid="2PE 2:6" />भगवान उन मनसेन के चेतावनी देय के निता, जउन भभिस्य हे पाप करैका सोचहीं, ता सदोम अउ अमोरा के सहर के भसम करके बिनास के सजा दइस, कि उन आमै बाले पापिन के निता उदाहरन बन जाय। असना सजा दयइस कि उनही नास करके राख के दइस<note caller="+" style="x"><char style="xo" closed="false">2:6 </char><char style="xt" closed="false"><ref loc="JOS 1:7">यहोसू 1:7</ref>; <ref loc="GEN 19:24">उत्पति 19:24</ref></char></note>, <verse eid="2PE 2:6" /><verse number="7" style="v" sid="2PE 2:7" />पय भगवान ऊ धरमी लूत के बचाइस, जउन उन दुस्ट मनसेन के गलत काम बेकार चाल चलन लग बोहत दुखी रहिस, उनखर लग मुकति दइस<note caller="+" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="GEN 19:12-15">उत्पति 19:12-15</ref></char></note>। <verse eid="2PE 2:7" /><verse number="8" style="v" sid="2PE 2:8" />लूत उन धरमी मनसेन के बीच हे रहत, उनखर रोज दिना गलत काम चाल चलन देखत अउ सुनत रहिस, इहैनिता ओही अन्तर आतमा हे दुख होत रहिस। <verse eid="2PE 2:8" /><verse number="9" style="v" sid="2PE 2:9" />हइ मेर हम देखथन कि परभु हइ जानथै कि धरमी मनसेन के कउन मेर परिक्छा लग निकाडथै, अउ कउन मेर पापिन के नियाव के रोज हे सजा देय के निता बचाय के रखे हबै। <verse eid="2PE 2:9" /><verse number="10" style="v" sid="2PE 2:10" />खास करके उन मनसेन के, जउन देह के असुध्द कामन हे लिप्त रथै अउ भोग बिलास हे जीवन गुजारत हबै, अउ सासक के बेकार समझथै, उन ढीठ, घमंडी मनसे अउ स्वरगी जन तक के निन्दा करै लग नेहको डेराय, <verse eid="2PE 2:10" /><verse number="11" style="v" sid="2PE 2:11" />जब कि स्वरगदूत तक, जउन इनखर लग कहुं बोहत सक्तिसाली अउ सक्ति हबै, परभु के आगू उनखर हे भला बुरा कहिके दोस नेहको लगाथै। <verse eid="2PE 2:11" /><verse number="12" style="v" sid="2PE 2:12" />हइ मनसे उन निरबुध्दि पसुन के जसना हबै, जिनखर पइदा असना पसुन के जसना होय हबै कि इनही पकरके इनही काटे जाय, उन असना बातन के निन्दा करथै, जेखर इनही कउनो ग्यान नेहको हबै, उन पसुन के मेर नास हुइ जइही, <verse eid="2PE 2:12" /><verse number="13" style="v" sid="2PE 2:13" />इन बेकार कामन के सजा भोगही, उन दिन दुपहरी भोग बिलास करै के पसंद करथै, उन कलंक अउ पापी हबै, अउ तुम्हर संग खात पियत हबै, ता अपन पार लग माया भोज करके एसो आराम करथै। <verse eid="2PE 2:13" /><verse number="14" style="v" sid="2PE 2:14" />उनखर आंखिन हे गलत कामन लग भररे हर हबै, अउ उन पाप करै लग नेहको चुकै, उन कमजोर आतमा बालेन के ललचोथै, उनखर मन लालच लग भररे हर हबै, उन सराप पाय हरन के लरका हबै, <verse eid="2PE 2:14" /><verse number="15" style="v" sid="2PE 2:15" />बओर के टोरवा बिलाम के जसना, जउन अधरम के कमाय हर पइसा के लालच करिस, यहों सच्चाई के सिध्धा रास्ता के छांड के भटक गइस<note caller="+" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="NUM 22:5-6">गिनती 22:5-6</ref></char></note>, <verse eid="2PE 2:15" /><verse number="16" style="v" sid="2PE 2:16" />पय उके अपन अपराध के डांट सुनै के पडिस, अक्ठी बउरा गदहा मनसेन के जसना बोलै लगिस अउ ऊ ग्यानी मनसे के पगलापन लग सम्भर गइस<note caller="+" style="x"><char style="xo" closed="false">2:16 </char><char style="xt" closed="false"><ref loc="NUM 22:26-31">गिनती 22:26-31</ref></char></note>।<verse eid="2PE 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 2:17" />उन मनसे सुखाय हर कुंवा अउ आंधी दवारा उडाय हर कोहिटा हबै, जिनखर निता गहिड अंधियार ठहराय गय हबै। <verse eid="2PE 2:17" /><verse number="18" style="v" sid="2PE 2:18" />उन घमंड लग भरे हर बेकार बातन लग उन मनसे देह के अभिलासा हे फसाय लेथै। जउन रास्ता लग भटके मनसेन मसे बाल-बाल बच के निकर आय हबै। <verse eid="2PE 2:18" /><verse number="19" style="v" sid="2PE 2:19" />ऊ उनके आजाद करै के टीमा तो करथै, पय खुद पाप के गुलाम हबै, काखे जउन मनसे जेखर लग हार गय हबै, ऊ ओखर हरवाह बन जथै। <verse eid="2PE 2:19" /><verse number="20" style="v" sid="2PE 2:20" />जउन मनसे हमर परभु यीसु मसीह अउ मुकतिदाता के सगलू ग्यान पाय के दुनिया के पापन लग बच गइस, उन अगर फेरै उहै हे फस के उनखर कबजा हे हुइ जथै, ता उनखर पहिले के दसा लग अउ बत्तर हुइ जथै। <verse eid="2PE 2:20" /><verse number="21" style="v" sid="2PE 2:21" />सही तो इहै होथै कि उन नियाइपन धरमी रास्ता के अहसास नेहको होय होतिस बजाय एखर लग कि ऊ ओही जानै के बाद, जउन पवितर आदेस उनही सउपे गय रथै ओखर लग उन मुंह मोडथै, <verse eid="2PE 2:21" /><verse number="22" style="v" sid="2PE 2:22" />उनखर चाल चलन हइ कहावत हे ठीक बइठथै, “कुकरा अपनेन ओछरे हर के फेरै खथै” अउ “नहवाय हर सुअरनी फेरै चिखला हे जाय के लोटथै<note caller="+" style="x"><char style="xo" closed="false">2:22 </char><char style="xt" closed="false"><ref loc="PRO 26:11">नीति 26:11</ref></char></note>।”<verse eid="2PE 2:22" /></para>
  <chapter eid="2PE 2" />
  <chapter number="3" style="c" sid="2PE 3" />
  <para style="s">परभु के आमै के रोज</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 3:1" />हे पिरिया भाई अउ बेहन मै तुमही दूसर बेर चिट्ठी लिखथो, इन चिट्ठी हे मै कुछ बातन के सुरता करवाय के तुम्हर साफ सुथरा दिमाक के सचेत करै चाहथो। <verse eid="2PE 3:1" /><verse number="2" style="v" sid="2PE 3:2" />तुम उन बात के जो पवितर ग्यानी मनसेन अउ परभु अउ मुकतिदाता के ऊ आदेस के सुरता रखिहा, जउन तुम्हर चेलन सुनाय रथै। <verse eid="2PE 3:2" /><verse number="3" style="v" sid="2PE 3:3" />तुम सबले पहिले हइ जान लेया कि आखरी रोज हे हसी ठट्ठा करै बाले आही, उन अपन इक्छा के जसना चलहिन। <verse eid="2PE 3:3" /><verse number="4" style="v" sid="2PE 3:4" />अउ कइहीं, “ओखर आमै के टीमा के काहिन हुइस? हमर पुरखन के मिरतू लग अब तक सब कुछु ओसनेन चलत हबै जसना दुनिया के सुरुवात लग रथै।” <verse eid="2PE 3:4" /><verse number="5" style="v" sid="2PE 3:5" />उन जान बूझ के हइ बिसर जथै कि दुनिया के सुरुवात हे अक्ठी बादर रथै अउ अक्ठी भुंइ, जउन भगवान के बचन के दवारा पानी मसे पानी के दवारा भुंइ के रचना हुइस<note caller="+" style="x"><char style="xo" closed="false">3:5 </char><char style="xt" closed="false"><ref loc="GEN 1:6-9">उत्पति 1:6-9</ref></char></note>। <verse eid="2PE 3:5" /><verse number="6" style="v" sid="2PE 3:6" />हइ उनखर ठट्ठा मजाक के परिनाम रहिस, कि ऊ टेम के दुनिया पानी के बाढ के दवारा बुड के मर गइन<note caller="+" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="GEN 7:11-21">उत्पति 7:11-21</ref></char></note>। <verse eid="2PE 3:6" /><verse number="7" style="v" sid="2PE 3:7" />भगवान के बचन अबे के बादर अउ दुनिया के आगी के निता रखे गय हबै, उनही नियाव के रोज तक के निता छांडे गय हबै, ऊ रोज पापी मनसेन के नास करे जही।<verse eid="2PE 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2PE 3:8" />हे पिरिया भाई अउ बेहन, हइ बात जरूर सुरता रखिहा की परभु के नजर हे अक रोज हजार साल के समान हबै अउ हजार साल अक रोज के जसना हबै<note caller="+" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="PSA 90:4">भजन 90:4</ref></char></note>। <verse eid="2PE 3:8" /><verse number="9" style="v" sid="2PE 3:9" />परभु अपन टीमा पूर करै हे देरी नेहको करथै, जसना की कुछ मनसे समझथै, पय ऊ तुम्हर बारे हे धीर धरथै अउ हइ नेहको चाहथै कोनो नास होंय, बलुक सब झन के अपन पाप लग मन बदलै के मउका मिलै<note caller="+" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="HEB 2:3-4">इब्रानिन 2:3-4</ref></char></note>।<verse eid="2PE 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 3:10" />परभु के रोज चोरटन मेर आय जही, ऊ रोज बादर गरजत तेज आरो करत नास हुइ जही, अउ तत्व जर के पिघल जइही अउ भुंइ अउ ओखर हे करे हर सगलू काम परगट हुइ जइही<note caller="+" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="HEB 10:34">इब्रानिन 10:34</ref></char></note>। <verse eid="2PE 3:10" /><verse number="11" style="v" sid="2PE 3:11" />जब इन सगलू चीज इहैमेर नास होमैके जरूरी हबै, ता तुम पवितर चाल चलन अउ भक्ति मेर जीवन जिया। <verse eid="2PE 3:11" /><verse number="12" style="v" sid="2PE 3:12" />जब तुम भगवान के ऊ रोज के निता ओरगा अउ उके जलदी लामै के परयास करा। बादर आगी लग नास के दय जही अउ बोहत तेज घाम के कारन तत्व पिघल जही। <verse eid="2PE 3:12" /><verse number="13" style="v" sid="2PE 3:13" />पय हम भगवान के टीमा के जसना हम अक्ठी नबा बादर अउ अक्ठी नबा दुनिया के ओरगे हबन, जिछो धरमी काम करै बाले निबास करही<note caller="+" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="ISA 60:21">यसा 60:21</ref>; <ref loc="ISA 65:22">65:22</ref></char></note>।<verse eid="2PE 3:13" /></para>
  <para style="s">जागत रइहा अउ तइयार रहा</para>
  <para style="p">
    <verse number="14" style="v" sid="2PE 3:14" />इहैनिता, हे पिरिया भाई अउ बेहन, जब तुम ऊ रोज के ओरगे हबा, ता परियास करा कि परभु के नजर हे पवितर अउ निरदोस पाय जा, अउ तुम्हर हे ओखर सान्ति के निबास होय। <verse eid="2PE 3:14" /><verse number="15" style="v" sid="2PE 3:15" />हमर परभु के धीर के मुकति समझा, ठीक जसना हमर पिरिया भाई पोलुस उनही दय गय ग्यान के जसना तुमही लिखे हबै। <verse eid="2PE 3:15" /><verse number="16" style="v" sid="2PE 3:16" />जसना ऊ अपन सगलू चिट्ठी हे इन बातन के चरचा करथै, उन चिट्ठी हे कुछ असना बात हबै, जउन समझै हे कठिन हबै, जउन अनपढ अउ हुसियार मनसे बिगाड देथै, हइ मेर अपन नास के लेथै।<verse eid="2PE 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 3:17" />हे प्रिजन भाई अउ बेहन, मै तुमही पहिले लग चेतन्त करे हबै, तुम सावधान रहा। कहुं असना झइ होय कि तुम उन दुस्टन के बहकाव हे आय के अउ अपन बिस्वास लग डगमगाय के गिर जा। <verse eid="2PE 3:17" /><verse number="18" style="v" sid="2PE 3:18" />तुम हमर परभु अउ मुकतिदाता यीसु मसीह के अनुगरह किरपा अउ ग्यान हे बढत रहा। ओखर महिमा अबे अउ जुगजुग होत रहै। ओसनेन होय।<verse eid="2PE 3:18" /></para>
  <chapter eid="2PE 3" />
</usx>