<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1TH" style="id">- Bhumiya Standard Project</book>
  <para style="h">थिस्स</para>
  <para style="toc3">1 थिस्स</para>
  <para style="toc2">1 थिस्स</para>
  <para style="toc1">1 थिस्सलुनीकियन मंडली के निता पोलुस कर चिट्ठी</para>
  <para style="mt2">1 थिस्सलुनीकियों कलीसिया के लिए पौलुस की चिट्ठी</para>
  <para style="mt1">1 थिस्सलुनीकियन मंडली के निता पोलुस कर चिट्ठी</para>
  <para style="imt">परचा</para>
  <para style="ip">थिस्सलुनीकियन के पहिला चिट्ठी चेला पोलुस <char style="xt"><ref loc="1TH 1:1">1:1</ref></char> दवारा लिखे गय रथै। हइ पहिला चिट्ठी हुइ सकथै जउन पोलुस लिखे रथै, जउन बाइबल के हिस्सा बन गइस अउ हइ यीसु के जनम के करीबन 51 साल बाद लिखे गय रथै। पोलुस कुरिन्थी सहर हे रथै जब ऊ थिस्सलुनीके के मंडली के हइ चिट्ठी लिखिस, अक्ठी मंडली जेही ऊ अपन दूसर सेबकाई यातरा हे स्थापित करे रथै। <char style="xt"><ref loc="ACT 17:1-10">प्रेरितो 17:1-10</ref></char> चेलन के काम किताब हे हइ कहे गय हबै, कि मंडली कुछ यहूदियन अउ कइठे यूनानियन लग बने रथै।</para>
  <para style="ip">मंडली के स्थापना के बादो पोलुस थिस्सलुनीके सहर हे रहै हे सक्छम नेहको रथै, इहैनिता ऊ बाद हे हइ चिट्ठी के उहां के बिस्वासिन के प्रोत्साहन करै के निता पठोथै। चिट्ठी हे कइठे बिसय के सामिल करे गय हबै, अउ बिस्वासिन के कइसन रहै चाही, एखर बारे हे कइठे अक जसना सिक्छा हबै। पोलुस मसीह के दूसर आगमन हे धियान देथै, सायद थिस्सलुनीकियन के मंडली के बिस्वासी ई बिसय हे बिसेस रूप लग रुचि रखथै। पोलुस मसीह के दूसर आगमन के भगवान के खुस करै बाले जीवन जीय के सीख के रूप हे निस्तार करिस। <char style="xt"><ref loc="1TH 5:6-8">5:6-8</ref></char></para>
  <para style="iot">रूप रेखा</para>
  <para style="io1">1. पोलुस हइ चिट्ठी के सुरुवात मंडली के सोगत करै अउ उनखर निता भगवान के धन्यबाद देय के दवारा करथै। <char style="ior"><ref loc="1TH 1">1</ref> </char></para>
  <para style="io1">2. फेर ऊ अपन काम अउ तीमुथियुस दवारा लाय गय खबर के बारे गुठेथै। <char style="ior"><ref loc="1TH 2-3">2—3</ref> </char></para>
  <para style="io1">3. आगू पोलुस सिक्छा देथै कि कइसन बिस्वासिन के यीसु के दूसर आगमन के उजियार हे रहै चाही। <char style="ior"><ref loc="1TH 4:1-5:15">4:1—5:15</ref></char></para>
  <para style="io1">4. पोलुस मंडली के फेरै लग नमस्ते करत अउ हइ निस्चित करै के निता कथै कि मंडली हे हर मनसे चिट्ठी के पढथै। <char style="ior"><ref loc="1TH 5:16-28">5:16-28</ref></char></para>
  <chapter number="1" style="c" sid="1TH 1" />
  <para style="s">सोगत</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 1:1" />पोलुस अउ सिलवानुस अउ तीमुथियुस,</para>
  <para style="p" vid="1TH 1:1">के पल्ला लग थिस्सलुनीके सहर के मंडली के नाम जउन भगवान बाफ अउ परभु यीसु मसीह हे हबै, अनुगरह किरपा अउ सान्ति तुमके मिलतै रहै।<verse eid="1TH 1:1" /></para>
  <para style="s">जीवन अउ बिस्वास</para>
  <para style="p">
    <verse number="2" style="v" sid="1TH 1:2" />हम अपन बिनती हे तुमही सुरता करत अउ हर रोज तुम सबके बारे हे भगवान के धन्यबाद करथन, <verse eid="1TH 1:2" /><verse number="3" style="v" sid="1TH 1:3" />हम हरमेसा हमर भगवान बाफ के आगू तुम्हर बिस्वास के काम, माया, मेहनत अउ हमर परभु यीसु मसीह हे तुम्हर मजबूत आसा के सुरता करथन <verse eid="1TH 1:3" /><verse number="4" style="v" sid="1TH 1:4" />हे भाई अउ बेहन भगवान के प्रिय मनसेन हम जानथन कि तुम चुने हर हबा। <verse eid="1TH 1:4" /><verse number="5" style="v" sid="1TH 1:5" />काखे हमर संदेस तुम्हर इहां सिबाय सब्द हे नेहको, पय सक्ति, पवितर आतमा अउ बडा बिस्वास के संग पहुंचाय गइस, जसना तुम जानथा, कि हम तुम्हर निता कइसन बन गय रहन। <verse eid="1TH 1:5" /><verse number="6" style="v" sid="1TH 1:6" />तुम हमर अउ परभु के आदेस के माने हबा, अउ बोहत परेसानी के सामना करत पवितर आतमा के प्रोत्साहन लग खुसी लग संदेस के स्वीकारे हबा। <verse eid="1TH 1:6" /><verse number="7" style="v" sid="1TH 1:7" />हइ मेर लग तुम मकिदुनिया परदेस अउ अखाया परदेस के सगलू बिस्वासिन के निता नमूना बन गय हबा। <verse eid="1TH 1:7" /><verse number="8" style="v" sid="1TH 1:8" />तुम्हर दवारा पठोय गइस परभु के संदेस मकिदुनिया परदेस हे नेहको, बलुक अखाया परदेस हे सुनाय गइस, अउ बढत गइस पय भगवान हे तुम्हर बिस्वास के पता चल गइस, एखर बाद कउनो जरूरत नेहको रह गइस कि हइ बारे हे अब हम कुछ कहै। <verse eid="1TH 1:8" /><verse number="9" style="v" sid="1TH 1:9" />मनसे खुदय हमके गुठेथै, कि तुम्हर इहां हमर कइसा सोगत हुइस अउ तुम कइसन मेर के देबी देउता के छांडके भगवान के लिघ्घो आयन, जेखर लग तुम सही अउ जिन्दा भगवान के सेबक बना। <verse eid="1TH 1:9" /><verse number="10" style="v" sid="1TH 1:10" />अउ ओखर टोरवा मतलब यीसु के ओरगा, जेही भगवान मरे हर मसे जिन्दा करिस अउ इहै स्वरग लग आही, मसीह यीसु जउन हमही आमै बाले गुस्सा लग बचाथै।<verse eid="1TH 1:10" /></para>
  <chapter eid="1TH 1" />
  <chapter number="2" style="c" sid="1TH 2" />
  <para style="s">थिस्सलुनीकियन हे पोलुस के सेबा काम</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 2:1" />हे भाई अउ बेहन तुम खुदय जानत हबा कि हमर तुम्हर लिघ्घो आमैके बेकार नेहको हुइस, <verse eid="1TH 2:1" /><verse number="2" style="v" sid="1TH 2:2" />तुम जानथा कि हम कुछ टेम पहिले फिलिप्पी सहर हे बेकार बेउहार अउ बेज्जती सहै का पडे रथै तउभरमा हम अपन भगवान के उप्पर बिस्वास रखके, बोहत बिरोध के सामना करत हिम्मत के संग तुम्हर बीच भगवान के संदेस के सुनायन। <verse eid="1TH 2:2" /><verse number="3" style="v" sid="1TH 2:3" />हमर सिक्छा न तो भरमा दे बाले रथै, अउ न असुध्द उदेस्य लग हबै, अउ न ओहमा कउनो छल कपट हबै। <verse eid="1TH 2:3" /><verse number="4" style="v" sid="1TH 2:4" />पय भगवान हमके काबिल समझ के संदेस के सउपे हबै, इहैनिता हम मनसे के खुस करै के निता नेहको, बलुक हमर मन के परखै बाले भगवान के खुस करै के निता सिक्छा देथन। <verse eid="1TH 2:4" /><verse number="5" style="v" sid="1TH 2:5" />जसना कि तुम जानथा कि हम न तो कबहुन चुगुलखोरी के बात करे करथन, अउ न ललचाय के निता बहाना करथन, हइ बात हे भगवान गवाह हबै। <verse eid="1TH 2:5" /><verse number="6" style="v" sid="1TH 2:6" />हम मनसेन लग कउनो आदर पामै का परयास नेहको करन, न तुम्हर लग अउ न कउनोन लग, मसीह के चेला होमै के कारन तुम्हर लग मदद पामै का हमर हक हबै। <verse eid="1TH 2:6" /><verse number="7" style="v" sid="1TH 2:7" />हम यीसु मसीह के चेला होमै के कारन हम तुम्हर उप्पर हक जमा सकत रहन, पय जउन मेर दाय अपन लरकन के पालन पोसन करथै, ओसनेन हमु तुम्हर बीच हे रहिके किरपा दिखाय हम। <verse eid="1TH 2:7" /><verse number="8" style="v" sid="1TH 2:8" />हम तुम्हर पल्ला ओसनेन माया के अहसास करे हबन, इहैनिता भगवान लग मिलै संदेस के नेहको, बलुक अपन-अपन परान देय के निता तइयार रहन, काखे तुम हमर पिरिया हुइ गय रहा। <verse eid="1TH 2:8" /><verse number="9" style="v" sid="1TH 2:9" />हे भाई अउ बेहन तुम हमर कठोर मेहनत के सुरता रखा, तुम्हर बीच भगवान के संदेस के परचार करे रहन, हम हर टेम दिन रात काम धंधा करत रहन, जेखर लग कउनो के उप्पर भार झइ रहै।<verse eid="1TH 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1TH 2:10" />तुम खुदय गवाह हबा अउ भगवानो गवाह हबै कि तुम बिस्वास करे बाले के बीच हे हमर माया कसना पवितर अउ बेकसूर रहन। <verse eid="1TH 2:10" /><verse number="11" style="v" sid="1TH 2:11" />तुमही इहो पता हबै कि बाफ के जसना हम कउन मेर तुम मसे हर अक्ठी के संदेस देत अउ तुमही खुस करत तुम्हर निता बिनती करत रहन, जसना बाफ अपन लरका के निता करथै। <verse eid="1TH 2:11" /><verse number="12" style="v" sid="1TH 2:12" />कि तुम्हर चाल चलन भगवान के काबिल होय, जउन तुमके अपन राज अउ महिमा हे बुलाथै।<verse eid="1TH 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 2:13" />इहैनिता हमु भगवान के धन्यबाद लगेतार करथन, कि जब हमर दवारा भगवान के संदेस के बचन तुम्हर लिघ्घो पहुंचिस, ता तुम उके मनसेन के बचन नेहको पय सहीमा भगवान के बचन समझ के स्वीकार करा, अउ ऊ बचन तुम्हर मन हे, जउन बिस्वास करथा ऊ सक्तिसाली होय। <verse eid="1TH 2:13" /><verse number="14" style="v" sid="1TH 2:14" />भाई अउ बेहन, तुम भगवान के उन मंडली के जसना जीवन जिया, जउन यहूदिया हे मसीह यीसु हे हबै, काखे तुमो अपन मनसेन लग ओसनेन दुख पाया, जसना उनो यहूदियन लग पाय रथै। <verse eid="1TH 2:14" /><verse number="15" style="v" sid="1TH 2:15" />जउन परभु यीसु के अउ ग्यानी मनसे के मार डारिन अउ हमु के सताइन, अउ भगवान उनखर लग खुस नेहको, अउ ऊ सगलू मनसेन के बिरोध करथै। <verse eid="1TH 2:15" /><verse number="16" style="v" sid="1TH 2:16" />अउ ऊ गैर यहूदी के मुकति के संदेस सुनामै लग हमही रोकै चाहथै, अउ हइ मेर ऊ अपन पाप के गघरी लगेतार भरत जथै, अउ अब भगवान के भयंकर गुस्सा उनखर लिघ्घो आय गय हबै।<verse eid="1TH 2:16" /></para>
  <para style="s">पोलुस मंडली लग मिलै के आसा</para>
  <para style="p">
    <verse number="17" style="v" sid="1TH 2:17" />हे भाई, जिहां तक हमर बात हबै, हम चुटु टेम के निता अलगे हुइ गय रहन, मन लग नेहको पय जीव लग, इहैनिता हम तुम्हर लग मिलै के बोहत होथन, हमर इक्छा अउ बढत हबै। <verse eid="1TH 2:17" /><verse number="18" style="v" sid="1TH 2:18" />इहैनिता हम, खास करके मै पोलुस, अक बेर नेहको पय बेर-बेर तुम्हर इहां आमैके चाहन, पय भुतवा हमर रास्ता रोक दइस। <verse eid="1TH 2:18" /><verse number="19" style="v" sid="1TH 2:19" />कउन हबै हमर आसा, खुसी या मगन के मुकुट? का हमर परभु यीसु मसीह के दुइबारा आमैके मउका हे ओखर उपस्थिति हे तुम नेहको रइहा? <verse eid="1TH 2:19" /><verse number="20" style="v" sid="1TH 2:20" />हमर बडाई अउ खुसी तो तुमिन हबा।<verse eid="1TH 2:20" /></para>
  <chapter eid="1TH 2" />
  <chapter number="3" style="c" sid="1TH 3" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 3:1" />इहैनिता जब हइ हमर निता सहै के बाहिर हुइ गइस, ता हम एन्थेस सहर हे अकेल्ले रहै के निस्चय करेन। <verse eid="1TH 3:1" /><verse number="2" style="v" sid="1TH 3:2" />अउ हम तीमुथियुस के जउन मसीह के संदेस हे हमर भाई अउ भगवान के सेबक हबै, इहैनिता पठोयों कि ऊ तुमके मजबूत करै अउ तुम्हर बिस्वास के बारे हे तुमके समझाय। <verse eid="1TH 3:2" /><verse number="3" style="v" sid="1TH 3:3" />कउ हइ दुख के कारन झइ डगमगाय, काखे तुम खुदय जानथा कि हम इनखरै निता ठहराय गय हम। <verse eid="1TH 3:3" /><verse number="4" style="v" sid="1TH 3:4" />तुम्हर इहां रहत टेम हम तोर लग कहे करथन कि समस्या हम हे आय पडही, अउ जसना कि तुम जानथा, उहै हुइस। <verse eid="1TH 3:4" /><verse number="5" style="v" sid="1TH 3:5" />इहैनिता जब मोर लग नेहको रहे गइस, ता तुम्हर बिस्वास के बारे हे जानै के निता तीमुथियुस के पठोयों, कि कहुं असना झइ होय कि परिक्छा करै बाले तुम्हर परिक्छा करे होय, अउ हमर मेहनत बेकार हुइ जाय।<verse eid="1TH 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TH 3:6" />तीमुथियुस अबे-अबे तुम्हर इछो लग लउटे हबै अउ तुम्हर बिस्वास अउ माया के बारे हे निक्खा संदेस लाय हबै, ऊ हमही गुठेथै कि तुम सबैरोज हमही माया लग सुरता करथा अउ हमही फेरै देखै के निता उतकै खुसी हबै, जेतका हमु तुमही देखै के निता। <verse eid="1TH 3:6" /><verse number="7" style="v" sid="1TH 3:7" />इहैनिता हे भाई, हम अपन पूर दुख अउ पीरा हे तुम्हर बिस्वास लग सान्ति पाय हबन। <verse eid="1TH 3:7" /><verse number="8" style="v" sid="1TH 3:8" />परभु हे तुम्हर मजबूत होय के संदेस हमर निता नबा जीवन के अगुवाई होय हबै। <verse eid="1TH 3:8" /><verse number="9" style="v" sid="1TH 3:9" />भगवान के आगू तुम्हर बारे हे ऊ बडा खुसी के निता हम भला भगवान के परति अउ कउन मेर के धन्यबाद परगट के सकथन, <verse eid="1TH 3:9" /><verse number="10" style="v" sid="1TH 3:10" />हम रात दिन बोहत भगवान लग बिनती करत रथन कि हम तुमही दुइबारा देख सकि, अउ तुम्हर बिस्वास हे जउन कमी रह गय हबै, उके पूर कर सकि।<verse eid="1TH 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TH 3:11" />अब हमर भगवान बाफ अउ हमर परभु यीसु हमर निता तुम्हर लिघ्घो पहुंचामै के रास्ता दिखाबै। <verse eid="1TH 3:11" /><verse number="12" style="v" sid="1TH 3:12" />अउ परभु असना करे कि जउन मेर हम तुम्हर लग माया करथन, ओसनेन तुम्हरो माया अक दूसर लग अउ सब के संग बढतै अउ उन्नत करत जा। <verse eid="1TH 3:12" /><verse number="13" style="v" sid="1TH 3:13" />ताकि जब हमर परभु यीसु दुइबारा अपन सगलू पवितर मनसेन के संग आबै, ता ऊ तुम्हर मन के हमर बाफ भगवान के आगू पवितर निरदोस ठहराय सकै।<verse eid="1TH 3:13" /></para>
  <chapter eid="1TH 3" />
  <chapter number="4" style="c" sid="1TH 4" />
  <para style="s">भगवान के खुस करै के जीवन</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 4:1" />हे भाई अउ बेहन, तुम हमर लग हइ सिक्छा लइ चुके हबा कि कउन मेर बेउहार करै के अउ भगवान के खुस करै के चाही, अउ तुम एखर मेर चलत हबा। आखरी हे हम परभु यीसु के नाम हे तुम्हर लग बिनती के संग समझामै के हबै कि तुम हइ बारे हे अउ आगू बढत जा। <verse eid="1TH 4:1" /><verse number="2" style="v" sid="1TH 4:2" />काखे तुम जानथा कि हम परभु यीसु के तरफ लग तुमही कउन-कउन आदेस दय रहन। <verse eid="1TH 4:2" /><verse number="3" style="v" sid="1TH 4:3" />भगवान के इक्छा हइ हबै, कि तुम पवितर बना अउ गलत काम लग बचे रइहा, <verse eid="1TH 4:3" /><verse number="4" style="v" sid="1TH 4:4" />तुम मसे सबझन अपन मन के काबू हे अउ देह के पवितर बनाय के रखा अउ ओखर इज्जत करा। <verse eid="1TH 4:4" /><verse number="5" style="v" sid="1TH 4:5" />अउ हइ काम अपन इक्छा लग नेहको, अउ न उन गैर यहूदी के जसना जउन भगवान के नेहको जानथै। <verse eid="1TH 4:5" /><verse number="6" style="v" sid="1TH 4:6" />कउनो भाई के मान मरयादा के बेज्जती झइ करै अपन साथी बिस्वासिन के तंग झइ करिहा, काखे इन सब के बारे हे खुद परभु बदला लेही, जसना कि हम तुमही साफ सब्द हे समझाय चुके हबन। <verse eid="1TH 4:6" /><verse number="7" style="v" sid="1TH 4:7" />काखे भगवान हमके असुध्द होमै के निता नेहको, पय पवितर होमै के निता बुलाय हबै। <verse eid="1TH 4:7" /><verse number="8" style="v" sid="1TH 4:8" />इहैनिता जउन हइ आदेस के मना करथै, ऊ मनसे के नेहको, बलुक भगवान के मना करथै जउन तुमही अपन पवितर आतमा देथै।<verse eid="1TH 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 4:9" />भाईचारा के माया के बारे हे मोके कुछु लिखे के जरूरत नेहको हबै, काखे खुद भगवान के दवारा तुमही सिक्छा दय गय हबै कि तुम आपस हे माया होय, <verse eid="1TH 4:9" /><verse number="10" style="v" sid="1TH 4:10" />अउ सगलू मकिदुनिया परदेस के बिस्वासिन भाई-बेहन के परति तुम्हर इहै इक्छा हबै, हे भाई, हमार तुम्हर लग इहै बिनती हबै कि तुम इहै हे अउ बोहत बढत जा। <verse eid="1TH 4:10" /><verse number="11" style="v" sid="1TH 4:11" />तुम हइ बात हे बडाई करा कि तुम सान्ति हे जीवन गुजारत हबा, अउ हर अक्ठी अपन-अपन काम हे लगे रथा, तुम मोर आदेस के जसना अपन हाथन लग अपन काम करा। <verse eid="1TH 4:11" /><verse number="12" style="v" sid="1TH 4:12" />हइ मेर बेउहार करै लग दूसर मनसे तोर इज्जत करही अउ तोही कउनो चीज के कमी नेहको होही।<verse eid="1TH 4:12" /></para>
  <para style="s">परभु फेरै आही</para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 4:13" />हे भाई, हम नेहको चाहथन कि तुम उनखर बारे हे अनचिन्हार रहा, जउन मर गय हबै, कहुं असना झइ होय कि तुम उन मनसेन के जसना दुखी बनाबा, जिनही कउनो आसा नेहको हबै। <verse eid="1TH 4:13" /><verse number="14" style="v" sid="1TH 4:14" />हमर बिस्वास हइ हबै कि जउन मेर यीसु के मिरतू हुइस अउ ऊ जी उठिस, उहै मेर भगवान उनखर संग उन सगलुन के फेरै जिन्दा कर देही, जउन यीसु हे मर गय हबै।<verse eid="1TH 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1TH 4:15" />जब परभु फेरै लग आही, ता हम जउन जिन्दा हबन अउ अबे हम इहां बचे हबन, उनखर लग आगू नेहको निकर पउब जउन मर चुके हमै। <verse eid="1TH 4:15" /><verse number="16" style="v" sid="1TH 4:16" />काखे जब आदेस दय जही अउ परधान स्वरगदूत के आरो अउ भगवान के तुरही सुनाई पडही, ता परभु खुदय स्वरग लग उतरही। जउन मसीह हे मरे गय हबै, उन पहिलेन जिन्दा हुइ जइही। <verse eid="1TH 4:16" /><verse number="17" style="v" sid="1TH 4:17" />एखर बाद हम, जउन जिन्दा हबन अउ जउन ऊ टेम तक बचे रइहीं, उन मनसेन के संग बादर हे उप्पर उठाय लय जइही अउ आसमान हे परभु लग मिलब। हइ मेर हम सबदिना परभु के संग रहबो। <verse eid="1TH 4:17" /><verse number="18" style="v" sid="1TH 4:18" />हइ बातन के दवारा अक दूसर के धीर अउ सान्ति दय करिहा।<verse eid="1TH 4:18" /></para>
  <chapter eid="1TH 4" />
  <chapter number="5" style="c" sid="1TH 5" />
  <para style="s">परभु यीसु फेरै आही इहैनिता तइयार रइहा</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 5:1" />हे भाई अउ बेहन, एखर कउनो जरूरी नेहको हबै कि तुमही टेम अउ कालन के बारे हे लिखे जाय, <verse eid="1TH 5:1" /><verse number="2" style="v" sid="1TH 5:2" />तुम अच्छी तरह जानथा कि परभु के रोज के आमै के ठीक ओसनेन अचनकै होही जसना रात हे चोरटन के, <verse eid="1TH 5:2" /><verse number="3" style="v" sid="1TH 5:3" />जब मनसे हइ कइहीं, “अब तो सान्ति अउ कउनो समस्या नेहको हबै,” तबै बिनास गरभबती के टेम दरद-पीरा के मेर, उनखर हे अचनकै आय पडही अउ उन ओखर लग नेहको बच पइहीं। <verse eid="1TH 5:3" /><verse number="4" style="v" sid="1TH 5:4" />हे भाई, तुम तो अंधियार हे नेहको हबा, कि ऊ दिन तोर उप्पर चोरटा के जसना अचनकै आय जही। <verse eid="1TH 5:4" /><verse number="5" style="v" sid="1TH 5:5" />तुम सब उजियार के लरका हबा अउ दिन के लरका हबा, हम न तो रात के हबन अउ न अंधियार के हबन। <verse eid="1TH 5:5" /><verse number="6" style="v" sid="1TH 5:6" />इहैनिता हम दूसर के जसना सोउत झइ रही, पय जागत अउ चेतन्त रही। <verse eid="1TH 5:6" /><verse number="7" style="v" sid="1TH 5:7" />जउन सोउत हबै उन रात हे सोउत हबै, अउ जउन दरुहा हबै ऊ रातै के दरुहा होथै। <verse eid="1TH 5:7" /><verse number="8" style="v" sid="1TH 5:8" />हम जउन दिन के हबन, बिस्वास अउ माया के कवच पहिन के अउ मुकति के आसा के टोपी पहिन के चेतन्त बने रही। <verse eid="1TH 5:8" /><verse number="9" style="v" sid="1TH 5:9" />भगवान हमही गुस्साय के निता नेहको, पय हम अपन परभु यीसु मसीह के दवारा मुकति पामै के निता ठहराय गय हबन। <verse eid="1TH 5:9" /><verse number="10" style="v" sid="1TH 5:10" />यीसु मसीह हमरे निता मरिस, जेखर लग हम चाहे जिन्दा रही, या मर गय होंय, ओखर संग जीवन बितइ। <verse eid="1TH 5:10" /><verse number="11" style="v" sid="1TH 5:11" />इहैनिता तुम जसना हइ टेम करतेन हबा, अक दूसर के सान्ति देया अउ अक दूसर के उन्नत करै हे लगे रइहा।<verse eid="1TH 5:11" /></para>
  <para style="s">आखरी सब्द अउ आसिरबाद</para>
  <para style="p">
    <verse number="12" style="v" sid="1TH 5:12" />हे भाइयो, हमर तुम्हर लग बिनती हबै कि तुम उन मनसेन के इज्जत करा जउन तुम्हर बीच मेहनत करथै, अउ परभु हे तुम्हर अगुवा हबै अउ तुमही सिक्छा देथै। <verse eid="1TH 5:12" /><verse number="13" style="v" sid="1TH 5:13" />उनखर मेहनत के धियान हे रखत उनही माया के संग इज्जत करा, अक दूसर लग मिलके रइहा।<verse eid="1TH 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1TH 5:14" />हे भाइयो, हम तुम्हर लग बिनती करथन कि जउन बिगड गय हबै, उनही डांटा जउन डेराय हबै, उनही हिम्मत देया जउन कमजोर हबै उनखर सहयोग करा अउ सबझन के संग धीर धरै बाले बने रइहा। <verse eid="1TH 5:14" /><verse number="15" style="v" sid="1TH 5:15" />तुम हइ बात के धियान देया, कि बुराई के बदला बुराई झइ करा, पय हरमेसा अक दूसर के अउ सब मनसेन के भलाई करै के परयास करा।<verse eid="1TH 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1TH 5:16" />हरमेसा खुस रहा। <verse eid="1TH 5:16" /><verse number="17" style="v" sid="1TH 5:17" />लगेतार पराथना बिनती करत रहा, <verse eid="1TH 5:17" /><verse number="18" style="v" sid="1TH 5:18" />हर बात हे भगवान के धन्यबाद देया, काखे तुम्हर निता मसीह यीसु हे भगवान के इहै इक्छा हबै।<verse eid="1TH 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1TH 5:19" />पवितर आतमा के झइ बुझवाबा। <verse eid="1TH 5:19" /><verse number="20" style="v" sid="1TH 5:20" />आगू कर बात करै बालेन के बेकार झइ समझा। <verse eid="1TH 5:20" /><verse number="21" style="v" sid="1TH 5:21" />सगलू बातन के परखा, जउन निक्खा बात हबै उके गरहन करा। <verse eid="1TH 5:21" /><verse number="22" style="v" sid="1TH 5:22" />सबैमेर के बुराइयन लग बचे रइहा।<verse eid="1TH 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1TH 5:23" />सान्ति के भगवान खुदय पूरी तरह लग पवितर करै, अउ तुम्हर आतमा अउ परान अउ देह हमर परभु यीसु मसीह के आमै तक पुरी तरह लग बेकसूर पाय जाय। <verse eid="1TH 5:23" /><verse number="24" style="v" sid="1TH 5:24" />भगवान हइ सब करही, काखे ऊ तुमही बोलाय हबै अउ ऊ बिस्वासओग हबै।<verse eid="1TH 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1TH 5:25" />हे भाइयो, तुमो हमर निता पराथना बिनती करिहा।<verse eid="1TH 5:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1TH 5:26" />सगलू भाई-बेहन के सान्ति के पवितर चुम्मा लग नमस्ते करा।<verse eid="1TH 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1TH 5:27" />परभु हे हमर हइ आदेस हबै कि हइ चिट्ठी सब भाई के आगू पढे जाय।<verse eid="1TH 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1TH 5:28" />हमर परभु यीसु मसीह के अनुगरह किरपा तुम्हर हे बने रहै।<verse eid="1TH 5:28" /></para>
  <chapter eid="1TH 5" />
</usx>