<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ECC" style="id">- Bhumiya Test Project</book>
  <para style="h">सभो</para>
  <para style="toc3">सभो</para>
  <para style="toc2">सभो</para>
  <para style="toc1">सभोपदेसक</para>
  <para style="mt2">सभोपदेशक के किताब</para>
  <para style="mt1">सभोपदेसक कर किताब</para>
  <para style="imt">परचा</para>
  <para style="ip">सभोपदेसक अक्ठी असना किताब हबै जउन जीवन कर निता दिमाक सिखाथै, किताब कर इबरानी सीरसक कर मतलब हबै, ऊ जउन मनसेन कर अकजिघा करथै, जादातर ग्यानवान मानथै, कि राजा सुलेमान सभोपदेसक कर लिखै बाले रथै, पय दूसर मनसे एखर लग सहमत नेहको हबै। अगर हइ किताब सुलेमान लिखथै, ता हइ 970-931 ईसा पूरव कर करीबन लिखे गय रथै, हइ तब के हबै जब ऊ जिन्दा रथै, दूसर ग्यानवान कर मानै के हबै, कि हइ कउनो अउ के दवारा लिखे गय रथै, काखे कबहुन-कबहुन एहमा राजा के बजाय हरवाह के भासा कर परयोग करे जथै। सभोपदेसक 5:8-9 उन बिदमान के मानै के हबै कि सभोपदेसक कर किताब सुलेमान कर टेम कर तुलना हे बोहत बाद हे लिखे गय रथै, करीबन 400 अउ 200 ईसा पूरव कर बीच।</para>
  <para style="ip">सभोपदेसक हइ कहिके सुरुवात करथै, कि सगलू कुछ अक्ठी सांस कर जसना हबै जउन हरबी भुलाय जथै। 1:2 हे एखर मतलब हइ हबै, कि हमर जीवन अउ हमर काम अस्थाई हबै अउ इके समझै के मुस्किल हबै, एहमा चुटु टेम कर बाद भुलाय दय जही। एखर बोहत भाग हमर कबजा लग बाहिर हबै, जीवन जसना हबै उके ओसनेन स्बीकार करबे, अउ जउन तोर लिघ्घो हबै ओहमा खुसी खोजै के निक्खा हबै, 9:9 जीवन कर सगलू परेसानी अउ खुसी हे बिचार करत किताब के सोंच बिचार, भगवान लग डर अउ ओखर आदेस के मानै के हबै ऊ सबले खास बात हबै। <char style="xt" closed="false"><ref loc="ECC 12:13">12:13</ref></char></para>
  <para style="iot">सभोपदेसक कर रूपरेखा</para>
  <para style="io1">सभोपदेसक कर किताब के लिखै बाले अउ ओखर जीवन के कुछ अनुभव कर परचा देथै। <char style="xt" closed="false"><ref loc="ECC 1:1-11">1:1-11</ref></char></para>
  <para style="io1">जीवन कर मतलब के चरचा करे गइस। <char style="xt" closed="false"><ref loc="ECC 1:12">1:12</ref>; <ref loc="ECC 6:9">6:9</ref></char></para>
  <para style="io1">आखरी हे सिक्छक के सलाह देथै। <char style="xt" closed="false"><ref loc="ECC 6:10">6:10</ref>; <ref loc="ECC 12:8">12:8</ref></char></para>
  <para style="io1">हइ कहिके किताब के खतम करथै, कि जीवन कर पूर उद्देस्य भगवान कर भय मानै के अउ ओखर आदेस के पालन करैके हबै। <char style="xt" closed="false"><ref loc="ECC 12:9-14">12:9-14</ref></char></para>
  <chapter number="1" style="c" sid="ECC 1" />
  <para style="s">जीवन बेकार हबै</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 1:1" />हइ दाऊद कर टोरवा उपदेसक कर बचन हबै, जउन यरुसलेम कर राजा रथै। <verse eid="ECC 1:1" /><verse number="2" style="v" sid="ECC 1:2" />उपदेसक कथै, “बेकार हबै, बेकार हबै, बिलकुन बेकार सब कुछ बेकार हबै।” <verse eid="ECC 1:2" /><verse number="3" style="v" sid="ECC 1:3" />मनसेन के अपन ऊ मेहनत लग काहिन फायदा होथै, जउन उन बेरा कर तरी मेहनत करथै। <verse eid="ECC 1:3" /><verse number="4" style="v" sid="ECC 1:4" />अक्ठी पीढी जथै, अउ दूसर पीढी आथै, पय भुंइ हरमेसा बने रथै। <verse eid="ECC 1:4" /><verse number="5" style="v" sid="ECC 1:5" />बेरा निकरथै अउ बुडथै, अउ अपन निकरै के दिसा के पल्ला जल्दी लउट जथै। <verse eid="ECC 1:5" /><verse number="6" style="v" sid="ECC 1:6" />हवा दक्खिन के पल्ला लग बहथै, अउ उत्तर छो घूम जथै ऊ घूमथै अउ बहत रथै, अउ अपन परिधि हे लउट आथै। <verse eid="ECC 1:6" /><verse number="7" style="v" sid="ECC 1:7" />सब नदिया समुन्दर हे मिलै हबै, ता समुन्दर नेहको भरथै जउन जिघा लग नदिया निकडे हबै उहै छो फेरै लउट जथै। <verse eid="ECC 1:7" /><verse number="8" style="v" sid="ECC 1:8" />सगलू बात मेहनत लग भरै हबै, मनसे एखर बिस्तार नेहको कर सकिन अउ आंखी देखके भरपूर नेहको होथै, अउ न कान सुनके संतुस्ट होथै। <verse eid="ECC 1:8" /><verse number="9" style="v" sid="ECC 1:9" />जउन हुइ चुके हबै ऊ फेरै होही, अउ जउन कुछ बन चुके हबै ऊ फेरै बनही, अउ हइ बेरा के तरी कउनो बात नवा नेहको हबै। <verse eid="ECC 1:9" /><verse number="10" style="v" sid="ECC 1:10" />का असना कुछ हबै जेखर बारे हे कउनो कहि सकिन, देखा? हइ कुछ नबा हबै, हइ इहां पहिले लग हबै, बोहत पहिले लग रथै अउ हइ हमर टेम लग आगू इहां रथै। <verse eid="ECC 1:10" /><verse number="11" style="v" sid="ECC 1:11" />पुरान बातन के कुछ सुरता नेहको रखथै, अउ इहां तक आमै बाले पीढिन के उन मनसेन कर दवारा सुरता नेहको करे जही, जउन उनखर अनुसरन करथै।<verse eid="ECC 1:11" /></para>
  <para style="s">दिमाक बेकार हबै</para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 1:12" />मै उपदेसक यरुसलेम हे इस्राएल कर राजा रथों। <verse eid="ECC 1:12" /><verse number="13" style="v" sid="ECC 1:13" />मै अपन मन लगायों कि जउन कुछ आकास कर तरी करे जथै, ओखर भेद दिमाक लग सोंच बिचार के मालुम करव, हइ बडा दुख कर काम हबै, जउन भगवान मनसेन कर निता ठहराय हबै कि ओहमा लगे। <verse eid="ECC 1:13" /><verse number="14" style="v" sid="ECC 1:14" />मै उन सगलू कामन के देखों जउन बेरा के तरी करे जथै, देखा उन सगलू बेकार अउ माना हवा के पकडे के हबै। <verse eid="ECC 1:14" /><verse number="15" style="v" sid="ECC 1:15" />जउन टेडका मनसे हबै, ऊ सिध्धा नेहको करे जाय सकथै, अउ जउन काम हबै, उके गिने नेहको जाय सकथै। <verse eid="ECC 1:15" /><verse number="16" style="v" sid="ECC 1:16" />मै मन हे कथो, “देख जउन मोर लग यरुसलेम हे राज करत रहिन, उनखर मसे मै बोहत दिमाक बाले हुइ गय हबन, मै बोहत सारे दिमाक अउ ग्यान कर अनुभव करे हव।” <verse eid="ECC 1:16" /><verse number="17" style="v" sid="ECC 1:17" />अउ मै अपन मन हइ जानै लग लगायों, कि दिमाक कर भेद काहिन हबै, अउ पागल पन अउ मूरख काहिन हबै, ता मोके जान पडिस कि हइ हवा के पकरै कर जसना हबै। <verse eid="ECC 1:17" /><verse number="18" style="v" sid="ECC 1:18" />काखे बोहत दिमाक के संग बोहत दुख होथै, अउ जउन अपन ग्यान बढाथै, ऊ अपन दुखो बढाथै।<verse eid="ECC 1:18" /></para>
  <chapter eid="ECC 1" />
  <chapter number="2" style="c" sid="ECC 2" />
  <para style="s">सुख सुभिधा बेकार हबै</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 2:1" />मै अपन मन हे कथो “रेंग मै तोके खुसी के दवारा जंचिहों, इहैनिता गदगद अउ खुसी हो।” पय देख उहो बेकार हबै। <verse eid="ECC 2:1" /><verse number="2" style="v" sid="ECC 2:2" />मै हसी के बारे हे कथो, हइ पगलाय हबै, अउ आनन्द के बारे हे उके काहिन मिलथै? <verse eid="ECC 2:2" /><verse number="3" style="v" sid="ECC 2:3" />मै दारू पीके खुद के खुस करैके परयास करेव अउ मूरखता के भेंट लगामै के परयास करेव, मोर दिमाक अबे तक मोके ग्यान के संग सही दरसन करत हबै, मै हइ देखय चाहथो कि अपन जीवन के कुछ दिन के दोरान मनसेन कर निता, बादर कर तरी काहिन करैके निक्खा हबै। <verse eid="ECC 2:3" /><verse number="4" style="v" sid="ECC 2:4" />मै बडे-बडे काम करेव, मै अपन निता घर बनवाय लयो, अउ अपन निता अंगूर कर बगिया लगवायों। <verse eid="ECC 2:4" /><verse number="5" style="v" sid="ECC 2:5" />मै अपन निता बगिया लगायों, उन बगिया हे कइनमेर के फडुहा बाले पउधा लगवायों। <verse eid="ECC 2:5" /><verse number="6" style="v" sid="ECC 2:6" />मै अपन निता तलवा खोदवाय लेयो, कि उनखर लग ऊ बगिया सिंचर जाय जेहमा पउधा लगाय जथै। <verse eid="ECC 2:6" /><verse number="7" style="v" sid="ECC 2:7" />मै हरवाह अउ हरवाहिन खरीद लेयो, अउ मोर घर हे हरवाह पइदा हुइस, अउ जेतका मोर लग आगू यरुसलेम हे रथै, उनखर लग कहुं जादा गइया-बइला गेडरा छीडिन के मालिक रहों। <verse eid="ECC 2:7" /><verse number="8" style="v" sid="ECC 2:8" />इनखर अलावा मै राजन अउ परदेसन के सोन, चांदी अउ डेरा अपन लिघ्घो अकजिघा कर रखेव, मोर दरबार हे कइठे गामै बाले गाइकी अउ गायक रथै, मोर लिघ्घो डउका कर दिल बहलामै बाले कइनठे डउकियो रथै। <verse eid="ECC 2:8" /><verse number="9" style="v" sid="ECC 2:9" />हइमेर मै यरुसलेम के पहिले के राजन लग जादा महान अउ धनड्ड हुइ गयों, तउ मोर दिमाक मोर हाथ नेहको छांडिस। <verse eid="ECC 2:9" /><verse number="10" style="v" sid="ECC 2:10" />जउन चीजन के देखै के मोके इक्छा हुइस, मै उनके भरपूर नजर लग देखों, मै कउनो मेर के खुसी भोगै लग अपन हिरदय वंचित नेहको रखथो, काखे मोर हिरदय मोर मेहनत के सगलू कामन हे खुसी लेथै, अउ इहै खुसी मोर सगलू मेहनत के इनाम रथै। <verse eid="ECC 2:10" /><verse number="11" style="v" sid="ECC 2:11" />ता मै अपन काम हे बिचार करेव, मै ऊ मेहनत हे सोंचा जउन मै उन कामन के करे रथों, मोके अनुभव हुइस, कि हइ सगलू बेकार हबै, इहै माना कि हवा के पकरै के जसना हबै, ई बेरा के तरी भुंइ हे मनसेन कर काम अउ दुनिया लग कुछु फायदा नेहको।<verse eid="ECC 2:11" /></para>
  <para style="s">दिमाक अउ मूरुख सब बेकार</para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 2:12" />फेर मै अपन मन के मोडो कि दिमाक अउ पागलपन अउ मूरख के कामन के देखहुं, काखे जउन मनसे राजा के पाछु आही, ऊ काहिन करी? सिबाय उहै जउन होउत चले आय हबै। <verse eid="ECC 2:12" /><verse number="13" style="v" sid="ECC 2:13" />ता मै देखों कि उजियार अंधियार लग जेतका बढिहा हबै, ओतकै दिमाक मूरख लग बढिहा हबै। <verse eid="ECC 2:13" /><verse number="14" style="v" sid="ECC 2:14" />जउन हुसियार हबै ओखर मूंड हे आंखी रथै, पय मूरख अंधियार हे चलथै, तबो मै जान लयो कि दुनो के दसा एकैमेर होथै। <verse eid="ECC 2:14" /><verse number="15" style="v" sid="ECC 2:15" />मै अपन मन हे कथो कि जउन दसा मूरख के होथै, उहै दसा मोरो होही, फेर मै एतका हुसियार काखे होयों? पय मै अपन हिरदय हे कथो, मूरख हुइके मतलब हुसियार हुइके बेकार हबै। <verse eid="ECC 2:15" /><verse number="16" style="v" sid="ECC 2:16" />काखे न हुसियार के मन अउ न मूरख कर सुरता सबरोज बने रही, पय भभिस्य हे सगलू कुछ भुलाय दय जही, हुसियार कसना मूरख के जसना मरथै।<verse eid="ECC 2:16" /></para>
  <para style="s">मेहनत बेकार</para>
  <para style="p">
    <verse number="17" style="v" sid="ECC 2:17" />इहैनिता मै अपन जीवन लग घिरना करथो, काखे जउन काम बेरा कर तरी करे जथै, मोके बेकार मालुम हुइस, काखे सगलू कुछ बेकार माना हवा के पकडै के हबै। <verse eid="ECC 2:17" /><verse number="18" style="v" sid="ECC 2:18" />मै अपन सगलू मेहनत कर परतिफल लग जेही मै बेरा कर तरी करे रथै, घिरना करिस, काखे जरूरी हबै कि मै ओखर फडुहा ऊ मनसे के निता छांड जहुं जउन मोर बाद आही। <verse eid="ECC 2:18" /><verse number="19" style="v" sid="ECC 2:19" />हइ कोनहर जानथै, कि ऊ मनसे हुसियार हुइ या मूरख तबो बेरा कर तरी जेतका मेहनत मै करेव, अउ ओखर निता दिमाक परयोग करिस ऊ सगलू के उहै साहेब होही, इहो बेकारो हबै। <verse eid="ECC 2:19" /><verse number="20" style="v" sid="ECC 2:20" />तब मै अपन मन हे ऊ सगलू मेहनत के बारे जउन मै बेरा कर तरी करे गय रथै, निरास हुइस, <verse eid="ECC 2:20" /><verse number="21" style="v" sid="ECC 2:21" />काखे असना मनसे हबै, जेखर काम मेहनत अउ दिमाक अउ ग्यान लग होथै, अउ सफल होथै, ता उके असना मनसे के निता छांड जाय के पडथै, जेही ओहमा कुछु मेहनत नेहको करे हुइ इहो बेकार अउ बोहत बुरा हबै। <verse eid="ECC 2:21" /><verse number="22" style="v" sid="ECC 2:22" />जउन मनसे बेरा के तरी मन लगाय-लगायके मेहनत करथै, ओखर लग उके काहिन फायदा होथै? <verse eid="ECC 2:22" /><verse number="23" style="v" sid="ECC 2:23" />ओखर सब रोज दुखन लग भरे रथै, अउ ओखर काम दुख के संग होथै, रात के ओखर मन चैन नेहको पाथै, उहो बेकारै हबै <verse eid="ECC 2:23" /><verse number="24" style="v" sid="ECC 2:24" />मनसे के निता खाय पीय अउ मेहनत करत हर अपन जीव के सुखी रखै के सिबाय अउ कुछु निक्खा नेहको, मै देखों कि हइ भगवान के पल्ला लग मिलथै। <verse eid="ECC 2:24" /><verse number="25" style="v" sid="ECC 2:25" />काखे ओखर बिगर कोनहर खाय सकथै अउ खुसी बनाय सकथै? <verse eid="ECC 2:25" /><verse number="26" style="v" sid="ECC 2:26" />जउन मनसे भगवान के नजर हे निक्खा हबै, उके ऊ दिमाक अउ ग्यान अउ खुसी देथै, पय पापी के ऊ दुख भर काम देथै, कि ऊ उके देय के निता इकठ्ठा करके ढेर लगाबै, जउन भगवान के नजर हे निक्खा होय, इहो बेकार अउ हवा के पकडै कर जसना हबै।<verse eid="ECC 2:26" /></para>
  <chapter eid="ECC 2" />
  <chapter number="3" style="c" sid="ECC 3" />
  <para style="s">सब कुछ कर निता अक्ठी टेम</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 3:1" />हर बात कर अक्ठी मउका हबै, अउ सगलू कामन के, जउन आकास कर तरी होथै, अक्ठी टेम हबै। <verse eid="ECC 3:1" /><verse number="2" style="v" sid="ECC 3:2" />जनम कर टेम, अउ मिरतू कर टेम, बोमै कर टेम, अउ बोय हर के उखालै कर टेम हबै। <verse eid="ECC 3:2" /><verse number="3" style="v" sid="ECC 3:3" />घात करै कर टेम, अउ निक्खा करै कर टेम, हतिया करै कर टेम, अउ बनामै कर टेम, <verse eid="ECC 3:3" /><verse number="4" style="v" sid="ECC 3:4" />रोय कर टेम, अउ हसै कर टेम, छाती पीटै कर टेम, अउ नाचै कर टेम, <verse eid="ECC 3:4" /><verse number="5" style="v" sid="ECC 3:5" />पथरा फेकै कर टेम, अउ पथरा बटोरै कर टेम, गले लगामै कर टेम, अउ गले गलामै लग रोकै कर टेम, <verse eid="ECC 3:5" /><verse number="6" style="v" sid="ECC 3:6" />खोजै कर टेम, अउ भुलवाय देय कर टेम, बचाय रखै कर टेम, अउ फटक देय कर टेम, <verse eid="ECC 3:6" /><verse number="7" style="v" sid="ECC 3:7" />फाडे कर टेम, अउ सियै कर टेम, चुप रहै कर टेम, अउ बोलै कर टेम हबै, <verse eid="ECC 3:7" /><verse number="8" style="v" sid="ECC 3:8" />माया करै कर टेम, अउ बैर करै कर टेम, लडाई करै कर टेम, अउ सान्ति कर टेम हबै। <verse eid="ECC 3:8" /><verse number="9" style="v" sid="ECC 3:9" />काम करै बाले के अपन मेहनत लग काहिन फायदा होथै? <verse eid="ECC 3:9" /><verse number="10" style="v" sid="ECC 3:10" />मै ऊ दुख भरे काम के देखे हव, जउन भगवान मनसेन कर निता ठहराय हबै कि उन ओहमा लगे रहै। <verse eid="ECC 3:10" /><verse number="11" style="v" sid="ECC 3:11" />ऊ हर चीज के अपन टेम हे जादा सूरत बनाइस, ऊ मनसे कर हिरदय हे अनंत काल स्थापित करिस फेर कउनो नेहको समझथै, कि भगवान सुरुवात लग आखरी तक काहिन करे हबै? <verse eid="ECC 3:11" /><verse number="12" style="v" sid="ECC 3:12" />मै जान लय हव कि मनसेन के निता मगन करै के अउ जीवन भर भलाई करै के सिबाय अउ कुछ निक्खा नेहको। <verse eid="ECC 3:12" /><verse number="13" style="v" sid="ECC 3:13" />अउ हइ भगवान कर दान हबै कि मनसे खाय-पिये अउ अपन सगलू मेहनत हे मगन रहे। <verse eid="ECC 3:13" /><verse number="14" style="v" sid="ECC 3:14" />मै जानथो कि जउन कुछ भगवान करथै ऊ सबरोज स्थिर रही, न ओहमा कुछ बढाय जाय सकथै, अउ न कुछ घटाय जाय सकथै, भगवान असना इहैनिता करथै कि मनसे ओखर भय मानै। <verse eid="ECC 3:14" /><verse number="15" style="v" sid="ECC 3:15" />जउन कुछ हुइस ऊ एखर लग पहिलेन हुइ चुकिस, जउन होय बाले हबै ऊ हुइ चुके हबै, अउ भगवान गुजरेहर बात के फेरै लग पूंछथै।<verse eid="ECC 3:15" /></para>
  <para style="s">दुनिया हे अनियाय</para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 3:16" />फेर मै बेरा कर तरी का देखों कि नियाव के जिघा हे दुस्टता होथै, अउ नेक काम के जिघा हे दुस्टता होथै। <verse eid="ECC 3:16" /><verse number="17" style="v" sid="ECC 3:17" />मै मन हे कथो, भगवान नेक अउ दुस्ट दुनो के नियाव करी, काखे ओखर इछो अक-अक्ठी बारे हे अउ अक-अक्ठी काम कर टेम हबै। <verse eid="ECC 3:17" /><verse number="18" style="v" sid="ECC 3:18" />मै मन हे कथो “हइ इहैनिता होथै कि भगवान मनसेन के जांचै अउ उन देख सकै कि उन पसु जसना हबै।” <verse eid="ECC 3:18" /><verse number="19" style="v" sid="ECC 3:19" />काखे जसना मनसेन के ओसनेन पसुन के दसा होथै, दुनो के उहै दसा होथै, जसना अक्ठी मरथै ओसनेन दूसरो मरथै, सगलुन के सांस अकमेर हबै, अउ मनसे पसु लग कुछ बढके नेहको, सगलू कुछ बेकार हबै। <verse eid="ECC 3:19" /><verse number="20" style="v" sid="ECC 3:20" />सब अक्ठिन जिघा हे जथै, सब माटी लग बने हबै, अउ सब माटी हे फेरै मिल जथै। <verse eid="ECC 3:20" /><verse number="21" style="v" sid="ECC 3:21" />का मनसे के परान उप्पर के पल्ला चढथै अउ पसुन के परान तरी के पल्ला जायके माटी हे मिल जथै, हइ कोनहर जानथै? <verse eid="ECC 3:21" /><verse number="22" style="v" sid="ECC 3:22" />इहैनिता मै हइ देखों कि एखर लग जादा कुछ निक्खा नेहको कि मनसे अपन कामन हे मगन रहै, काखे ओखर किस्मत इहै हबै, काखे उके कोनहर दिखाय सकथै, कि उनखर बाद काहिन होही?<verse eid="ECC 3:22" /></para>
  <chapter eid="ECC 3" />
  <chapter number="4" style="c" sid="ECC 4" />
  <para style="s">उत्पीडन मेहनत अउ संगी</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 4:1" />ता मै ऊ सगलू अंधियार देखों कि जउन बेरा के तरी होथै, अउ का देखों कि अंधियार सहैबाले के आंसू बहथै, अउ उनखर कोनो सान्ति देय बाले नेहको, अंधियार करै बाले के हाथ हे सक्ति रथै, पय उनके सान्ति देय बाले नेहको रथै। <verse eid="ECC 4:1" /><verse number="2" style="v" sid="ECC 4:2" />इहैनिता मै मरेहर के जउन मर चुके हबै, उन जिन्दा लग जउन अबे जिन्दा हबै जादा धन्य कथै, <verse eid="ECC 4:2" /><verse number="3" style="v" sid="ECC 4:3" />पय उन दुनो लग जादा निक्खा ऊ हबै जउन अबहुन होय नेहको हबै, अउ न हइ बेकार काम देखे जउन बेरा के तरी होथै।<verse eid="ECC 4:3" /></para>
  <para style="s">स्वारथी मेहनत के बेकार</para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 4:4" />ता मै सगलू मेहनत के कामन अउ सगलू सफल कामन के देखों जउन मनसे अपन परोसी लग जलन के कारन करथै, हइ बेकार हबै अउ हवा के पकरै के जसना हबै। <verse eid="ECC 4:4" /><verse number="5" style="v" sid="ECC 4:5" />मूरख छाती हे हाथ धरे रथै, अउ माना अपन खुदय के बरबाद करथै। <verse eid="ECC 4:5" /><verse number="6" style="v" sid="ECC 4:6" />चैन के संग अक मुट्ठी उन दुइ मुट्ठिन लग निक्खा हबै, जिनखर संग मेहनत अउ माना हवा के पकडै कर जसना हबै। <verse eid="ECC 4:6" /><verse number="7" style="v" sid="ECC 4:7" />फेर मै बेरा के तरी हइ बेकार बात देखों। <verse eid="ECC 4:7" /><verse number="8" style="v" sid="ECC 4:8" />अगर मनसे अकेल्ले हबै, ओखर टोरवा नेहको, भाई नेहको, अगर ऊ लगेतार कमाउत जथै, ओखर मेहनत के कउनो आखरी नेहको, ओखर आंखी धन डेरा लग भरपूर नेहको होथै, ऊ अपन खुद कबहुन पूंछथै नेहको, मै हइ सगलू मेहनत केखर निता करथो, अउ काखे खुद के सुख चैन लग वंचित करथो? हइ बेकार हबै, अउ हइ दुखत काम हबै। <verse eid="ECC 4:8" /><verse number="9" style="v" sid="ECC 4:9" />अकझन लग दुइठे मनसे निक्खा होथै, काखे उनही उनके मेहनत के निक्खा फडुहा मिलथै। <verse eid="ECC 4:9" /><verse number="10" style="v" sid="ECC 4:10" />अगर उनखर मसे अक्ठी गिरथै, ता दूसर उके उठाय सकथै, सोक उके जउन अकेल्ले हबै अगर ऊ गिर जाय ता उके कोनहर उठाही? <verse eid="ECC 4:10" /><verse number="11" style="v" sid="ECC 4:11" />अगर दुनो अक संग सोहीं ता गरम रइहिन पय अकेल्ले मनसे अपन के कसना गरम कर सकथै? <verse eid="ECC 4:11" /><verse number="12" style="v" sid="ECC 4:12" />अगर कउ अकेल्ले हे परबल होय, पय दुनो ओखर सामना कर सके, जउन डोरा तीन सूत लग बन्धे हर ऊ हरबी नेहको टूटथै। <verse eid="ECC 4:12" /><verse number="13" style="v" sid="ECC 4:13" />हुसियार जबान गरीब होय लग असना डोकरा अउ मूरख राजा लग निक्खा हबै, जउन सलाह नेहको मानथै। <verse eid="ECC 4:13" /><verse number="14" style="v" sid="ECC 4:14" />फेर चाहे जबान जेल लग राजगद्दी हे पहुंचे होय, चाहे ऊ अपन राज हे गरीब पइदा होय हुइ। <verse eid="ECC 4:14" /><verse number="15" style="v" sid="ECC 4:15" />मै देखों कि बेरा के तरी रहै बाले अउ चलै बाले सगलू मनसे राजा उतराधिकारी जबान के अनुसरन करथै। <verse eid="ECC 4:15" /><verse number="16" style="v" sid="ECC 4:16" />उन सगलू मनसे अनगिनत रथै, जिनखर हे ऊ परधान होय रथै, तबो भभिस्य हे होय बाले मनसे ओखर कारन मगन नेहको हुइहिन, निसंदेह हइ बेकार अउ हवा के पकडै कर जसना हबै।<verse eid="ECC 4:16" /></para>
  <chapter eid="ECC 4" />
  <chapter number="5" style="c" sid="ECC 5" />
  <para style="s">भगवान के परति अपन टीमा पूर करा</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 5:1" />जब तै भगवान के भवन हे जाय, ता सावधानी लग चलहे, सुनै के निता लिघ्घो जाबे, मूरखन के बलि चढामै लग निक्खा हबै, काखे उन नेहको जानथै कि बेकार करथै। <verse eid="ECC 5:1" /><verse number="2" style="v" sid="ECC 5:2" />बात करै हे उताबली झइ करबे, अउ न अपन मन हे कउनो बात उताबली लग भगवान के आगू निकारबे, काखे भगवान स्वरग हे हबै अउ तै भुंइ हे हवस, इहैनिता तोर बचन चुटु होय। <verse eid="ECC 5:2" /><verse number="3" style="v" sid="ECC 5:3" />काखे जसना काम के बहुतायत के कारन सपना देखे जथै, ओसनेन बोहत लग बातन के बोलै बाले मूरख ठहरथै। <verse eid="ECC 5:3" /><verse number="4" style="v" sid="ECC 5:4" />जब तै भगवान के निता मन्नत माने, ता ओखर पूर करै हे देरी झइ करबे, काखे ऊ मूरखन लग मगन नेहको होथै जउन मन्नत तै माने हवस उके पूर करबे। <verse eid="ECC 5:4" /><verse number="5" style="v" sid="ECC 5:5" />मन्नत मान के पूर नेहको करै लग मन्नत के न मानै ऊ निक्खा हबै। <verse eid="ECC 5:5" /><verse number="6" style="v" sid="ECC 5:6" />कउनो बचन कथै अपन पाप हे झइ फसिहा, अउ न भगवान के दूत के आगू कइहा, कि ऊ भूल लग होय हबै, भगवान काखे तोर बात सुन के न परसंद हुइ, अउ तोर हाथ के काम के नस्ट करी? <verse eid="ECC 5:6" /><verse number="7" style="v" sid="ECC 5:7" />काखे सपनन के जादा लग बेकार बात बोहत होथै, पय तै भगवान के भय मान।<verse eid="ECC 5:7" /></para>
  <para style="s">धन डेरा बेकार</para>
  <para style="p">
    <verse number="8" style="v" sid="ECC 5:8" />अगर तै कउनो सहर हे गरीब के अतियाचार होत देखथै, अउ उके नियाव अउ अधिकारन लग वंचित करे जथै, ता हइ बातन हे चकित झइ हो काखे अक्ठी अधिकारी हे कउनो ऊंच अधिकारी के नजर होथै, अउ उन दुनो हे दूसर अउ साहेब के नजर होथै। <verse eid="ECC 5:8" /><verse number="9" style="v" sid="ECC 5:9" />जमीन के उपज सब के निता हबै, पय खेत लग राजा के काम निकडथै। <verse eid="ECC 5:9" /><verse number="10" style="v" sid="ECC 5:10" />जउन पइसा लग माया करथै ओखर लिघ्घो कबहुन पूर नेहको होथै, अउ जउन डेरा लग माया करथै, ऊ अपन कमाई लग कबहुन संतुस्ट नेहको होथै, उहो बेकार हबै। <verse eid="ECC 5:10" /><verse number="11" style="v" sid="ECC 5:11" />जब डेरा बढथै, ता ओखर खाय बाले बढथै, तब ओखर मालिक के इके छांड अउ काहिन फायदा होथै, कि ऊ डेरा के अपन आंखी लग देखै? <verse eid="ECC 5:11" /><verse number="12" style="v" sid="ECC 5:12" />मेहनत करै बाले चाहे चुटु हस खाय, या बोहत, तबो ओखर नीद सुखदाई होथै पय धनी के डेरा बढै के कारन उके नीद नेहको आथै। <verse eid="ECC 5:12" /><verse number="13" style="v" sid="ECC 5:13" />बेरा के तरी भुंइ हे दुखद बुराई देखे हव, डेरा के मालिक अपन नुसकान के निता धरे हबस। <verse eid="ECC 5:13" /><verse number="14" style="v" sid="ECC 5:14" />अगर ओखर डेरा बेकार काम हे उडाय जथै, अउ ओखर घर हे टोरवा पइदा होथै, पय ओखर हाथ हे कुछु नेहको रथै। <verse eid="ECC 5:14" /><verse number="15" style="v" sid="ECC 5:15" />जसना ऊ अपन दाय के कोंख लग पइदा होय रथों, ओसनेन बिगर बन्डी के लउट जहुं, ऊ अपन हाथ हे अपन मेहनत के फडुहा नेहको लइ जाय सकही। <verse eid="ECC 5:15" /><verse number="16" style="v" sid="ECC 5:16" />हइ दुखद बुराई हबै, जसना ऊ आय रथै ठीक ओसनेन इहां लग लउट जही, उके अपन मेहनत लग काहिन फायदा होही? <verse eid="ECC 5:16" /><verse number="17" style="v" sid="ECC 5:17" />ऊ अपन पूर रोज अन्धकार हे बडी निरासा हे बडा पीरा अउ गुस्सा के संग भोजन करथै। <verse eid="ECC 5:17" /><verse number="18" style="v" sid="ECC 5:18" />देखा जउन निक्खा बात मै अनुभव करेव, अउ जउन उचित हबै, ऊ हइ हबै, मनसे के भगवान दवारा दय गइस अपन सगलू जीवन हे बेरा के तरी भुंइ हे खुसी लग मेहनत करै, खाय अउ पीय, काखे इहै ओखर भाग हबै। <verse eid="ECC 5:18" /><verse number="19" style="v" sid="ECC 5:19" />हर अक्ठी मनसे जेही भगवान डेरा दय हबै अउ उके भोगै के बल दय हबै ऊ अपन भाग के स्बीकार करे अउ खुसी लग मेहनत करेव, हइ भगवान कर बरदान हबै। <verse eid="ECC 5:19" /><verse number="20" style="v" sid="ECC 5:20" />हइ जीवन के रोज उके बोहत सुरता नेहको रही, काखे भगवान ओखर सुन सुनके ओखर मन के खुसी रखथै।<verse eid="ECC 5:20" /></para>
  <chapter eid="ECC 5" />
  <chapter number="6" style="c" sid="ECC 6" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 6:1" />अक्ठी बुराई जउन मै बेरा के तरी देखे हव, ऊ मनसेन के बोहत भारी लगथै। <verse eid="ECC 6:1" /><verse number="2" style="v" sid="ECC 6:2" />कउनो मनसे के भगवान धन डेरा अउ आदर इहां तक देथै, कि जउन कुछु ओखर मन चाहथै उके ओखर कुछु घटी नेहको होथै, तउमा भगवान ओही ओहमा लग खाय नेहको देथै, कउनो दूसर उके खाथै, हइ बेकार अउ बुराई कर बात हबै। <verse eid="ECC 6:2" /><verse number="3" style="v" sid="ECC 6:3" />अगर कउनो डउका के सव टोरवा होय, अउ ऊ बोहत साल जिन्दा रहै अउ ओखर उमर बढ जाय, पय न ओखर परान खुस रही, अउ न ओखर आखरी संसकार करे जाय, ता मै कथो कि असना मनसे लग मरेहर लरका के पइदा हुइके बढिहा हबै। <verse eid="ECC 6:3" /><verse number="4" style="v" sid="ECC 6:4" />काखे ऊ बेकार आइस अउ अन्धियार हे कढ गइस, अउ ओखर नाम अन्धियार हे लुक गइस, <verse eid="ECC 6:4" /><verse number="5" style="v" sid="ECC 6:5" />अउ न बेरा के देखिस, न कउनो चीज के जाने पाइस तउमा इके ऊ मनसे लग जादा चैन मिलिस। <verse eid="ECC 6:5" /><verse number="6" style="v" sid="ECC 6:6" />हव चाहे ऊ दुइ हजार साल जिन्दा रहै, अउ कुछ सुख भोगै नेहको पाइस, ता उके काहिन? का सगलू के सगलू अक्ठी जिघा हे नेहको जातै? <verse eid="ECC 6:6" /><verse number="7" style="v" sid="ECC 6:7" />मनसे के सगलू मेहनत ओखर लादा के निता होथै, तउमा ओखर मन नेहको भरथै। <verse eid="ECC 6:7" /><verse number="8" style="v" sid="ECC 6:8" />जउन हुसियार हबै ऊ मूरख लग कउन बात हे बढके हबै? अउ गरीब जउन हइ जानथै कि हइ जीवन हे कउन मेर लग चलै के चाही, उहो ओखर लग कउन बात हे बढके हबै। <verse eid="ECC 6:8" /><verse number="9" style="v" sid="ECC 6:9" />आंखी लग देख ले मन के हुसियारी लग बढिहा हबै इहो बेकार हबै अउ हवा के पकरै के जसना हबै। <verse eid="ECC 6:9" /><verse number="10" style="v" sid="ECC 6:10" />जउन कुछु सुरुवात हे हबै ओखर नाम आगुन दय जाय चुके हबै, अउ मनाउता काहिन हबै? हइ सुरता हुइ चुके हबै, कउनो असना मनसे लग मुकाबला नेहको कर सकथै जउन बलवान हबै। <verse eid="ECC 6:10" /><verse number="11" style="v" sid="ECC 6:11" />जीवन के बारे हे जेतका बिचार करा, ओतकै ऊ बेकार लगथै ता असना जीवन लग मनसे के काहिन फायदा? <verse eid="ECC 6:11" /><verse number="12" style="v" sid="ECC 6:12" />मनसे अपन चुटु जीवन परछाई के जसना गुजारे करथै, पय कोहर जानथै कि ओखर निता असना जीवन हे निक्खा हबै? मनसे के कोनहर गुठे सकथै कि ओखर मिरतू के बाद बेरा के तरी भुंइ हे काहिन होही?<verse eid="ECC 6:12" /></para>
  <chapter eid="ECC 6" />
  <chapter number="7" style="c" sid="ECC 7" />
  <para style="s">दिमाक</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 7:1" />निक्खा नाम मेहगा इतर लग अउ मिरतू कर रोज जनम कर रोज लग बढिहा हबै। <verse eid="ECC 7:1" /><verse number="2" style="v" sid="ECC 7:2" />भोज कर घर जाय लग दुख के घर जाय के बढिहा हबै, काखे सगलू मनसेन के आखरी मिरतू हबै। <verse eid="ECC 7:2" /><verse number="3" style="v" sid="ECC 7:3" />हंसी लग दुख बढिहा हबै, काखे मुंह कर सोक लग मन सुधरथै। <verse eid="ECC 7:3" /><verse number="4" style="v" sid="ECC 7:4" />हुसियारन के मन सोक करै बाले के घर के पल्ला लगे रथै, पय मूरखन के मन मगन करै बालेन के घर लगे रथै। <verse eid="ECC 7:4" /><verse number="5" style="v" sid="ECC 7:5" />मूरख के गाना सुनै लग निक्खा हबै हुसियार के डांट दपट सुनै के निक्खा हबै। <verse eid="ECC 7:5" /><verse number="6" style="v" sid="ECC 7:6" />काखे मूरख कर हंसी हांडी बरतन कर तरी जलथै हर कांटा चरचराहट कर जसना होथै उहो बेकार हबै। <verse eid="ECC 7:6" /><verse number="7" style="v" sid="ECC 7:7" />निस्चय अंधियार लग हुसियार बेकार हुइ जथै अउ घूंस लग दिमाक नस्ट होथै। <verse eid="ECC 7:7" /><verse number="8" style="v" sid="ECC 7:8" />कउनो काम के सुरू लग ओखर अंत निक्खा हबै, अउ धीरज बाले डउका घमंड लग अच्छा हबै। <verse eid="ECC 7:8" /><verse number="9" style="v" sid="ECC 7:9" />अपन मन हे उताबली लग गुस्सा झइ होबे, काखे गुस्सा मूरख कर हिरदय हे रथै। <verse eid="ECC 7:9" /><verse number="10" style="v" sid="ECC 7:10" />हइ न कहबे, गुजरे हर रोज इन लग काखे निक्खा रथै? काखे तै हुसियार लग काखे सबाल नेहको पूंछथस? <verse eid="ECC 7:10" /><verse number="11" style="v" sid="ECC 7:11" />दिमाक मिरास के संग निक्खा होथै, पय जिन्दा रहैबाले के निता लाभकारी हबै। <verse eid="ECC 7:11" /><verse number="12" style="v" sid="ECC 7:12" />दिमाक के आसरा डेरा के आसरा के जसना हबै, ग्यान लग हइ फायदा हबै, कि ऊ अपन दिमाक लग जीवन के सुरक्छित रखथै। <verse eid="ECC 7:12" /><verse number="13" style="v" sid="ECC 7:13" />भगवान के कामन हे बिचार करा, जेही भगवान टेढवा बनाय हबै, उके कउन सिध्धा कर सकथै? <verse eid="ECC 7:13" /><verse number="14" style="v" sid="ECC 7:14" />सुख के रोज खुसी बनाबा, पय दुख के रोज हे बिचार करा, काखे भगवान सुख अउ दुख दुनो के बनाय हबै, ताकि मनसे हइ बात के होय बाले भेद कर नेहको पाय सकिन। <verse eid="ECC 7:14" /><verse number="15" style="v" sid="ECC 7:15" />मै अपन बेकार जीवन हे हइ देखे हव, नेक मनसे अपन धारमिकता हे मरथै, पय दुरजन मनसे बुराई करत दीरघाय होथै। <verse eid="ECC 7:15" /><verse number="16" style="v" sid="ECC 7:16" />अपन के बोहत नेक झइ बना, अउ न अपन के जादा हुसियार बना तै काखे अपन नास के कारन हबस? <verse eid="ECC 7:16" /><verse number="17" style="v" sid="ECC 7:17" />बोहत जादा बेकार झइ बन, अउ न मूरख होय नहिता तै टेम के आगुन काखे मरिहे? <verse eid="ECC 7:17" /><verse number="18" style="v" sid="ECC 7:18" />निक्खा हइ हबै कि तै अक्ठी के पकरे रहा, अउ दूसर के अपन हाथन लग झइ निकरै देया, जउन मनसे भगवान कर डेर मानथै, ऊ हइ सगलू समस्या लग पार हुइ जही। <verse eid="ECC 7:18" /><verse number="19" style="v" sid="ECC 7:19" />दिमाक लग सहर के दसठे हाकिम के अपेक्छा हुसियार के जादा सक्ति मिलथै। <verse eid="ECC 7:19" /><verse number="20" style="v" sid="ECC 7:20" />निस्चित दुनिया हे कउनो असना नेक मनसे नेहको हबै जउन हरमेसा भलाई करथै अउ जेखर लग पाप नेहको हुइस। <verse eid="ECC 7:20" /><verse number="21" style="v" sid="ECC 7:21" />जेतका बात कहे जाय सब हे कान झइ लगाबे, असना झइ होय कि तै सुने कि तोर हरवाह तोके सराप देथै। <verse eid="ECC 7:21" /><verse number="22" style="v" sid="ECC 7:22" />काखे तै खुद जानथस कि तै बोहत बेर दूसर के सराप दय हवस। <verse eid="ECC 7:22" /><verse number="23" style="v" sid="ECC 7:23" />हइ सगलू मै दिमाक लग जांच लय हबै, मै कथो, मै हुसियार हुइ जहुं पय हइ मोर लग दुरिहां रहिस। <verse eid="ECC 7:23" /><verse number="24" style="v" sid="ECC 7:24" />ऊ जउन दुरिहां अउ अंतखोह गहिरा हबै, ओखर भेद कोनहर पाय सकथै? <verse eid="ECC 7:24" /><verse number="25" style="v" sid="ECC 7:25" />मै अपन मन लगायों कि दिमाक के बारे हे जान लयो, कि खोज निकारों अउ ओखर भेद जानो, अउ दुस्टता के मूरख अउ मूरखता जउन निरा पागलपन हबै। <verse eid="ECC 7:25" /><verse number="26" style="v" sid="ECC 7:26" />मै मिरतू लग जादा दुखदाई अक चीज पायों, मतलब ऊ डउकी जेखर मन फन्दा अउ जाला हबै, अउ जेखर हाथ हे हथकडिया हबै, अउ जउन डउका लग भगवान मगन हबै, उहै ओखर लग बची, पय पापी ओखर सिकार होही। <verse eid="ECC 7:26" /><verse number="27" style="v" sid="ECC 7:27" />देख, उपदेसक कथै, मै ग्यान के निता अलगे-अलगे बात मिलायके जांचही, अउ हइ बात निकारिस। <verse eid="ECC 7:27" /><verse number="28" style="v" sid="ECC 7:28" />जेही मोर मन अब खोजथै, पय नेहको पाथै, हजार मसे मै अक्कोठे डउकी नेहको पायों। <verse eid="ECC 7:28" /><verse number="29" style="v" sid="ECC 7:29" />देखा मै सिबाय हइ बात पाय हबै, कि भगवान मनसे के सिध्धा बनाइस, पय उन बोहत युक्ति निकारे हबै।<verse eid="ECC 7:29" /></para>
  <chapter eid="ECC 7" />
  <chapter number="8" style="c" sid="ECC 8" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 8:1" />हुसियार मनसे के जसना कोनहर हबै? अउ कउनो बात के मतलब कोहर लगाय सकथै? मनसे के दिमाक के कारन ओखर सकल चमकथै, अउ ओखर सकल के कठोरता दुरिहां हुइ जथै।<verse eid="ECC 8:1" /></para>
  <para style="s">राजा कर आदेस माना</para>
  <para style="p">
    <verse number="2" style="v" sid="ECC 8:2" />राजा के आदेस के पालन करा, अपन भगवान के किरिया के कारन झइ डेरा। <verse eid="ECC 8:2" /><verse number="3" style="v" sid="ECC 8:3" />ओखर आगू लग कढ जा, अगर ऊ कउनो बात लग खुस नेहको हबै ता तुम उहां झइ रुका काखे राजा जसना चाहथै ओसनेन करथै। <verse eid="ECC 8:3" /><verse number="4" style="v" sid="ECC 8:4" />काखे राजा के बचन हे सक्ति रथै, अउ कोहर ओखर लग कहि सकथै कि तै का करथस? <verse eid="ECC 8:4" /><verse number="5" style="v" sid="ECC 8:5" />जउन आदेस के मानथै, ऊ खतरा लग बची अउ हुसियार मनसे के मन टेम अउ नियाव के पोलपट्टी जानथै। <verse eid="ECC 8:5" /><verse number="6" style="v" sid="ECC 8:6" />काखे हरेक बारे के टेम अउ नियम होथै, पय मनसे के दुख ओखर निता बोहत भारी होथै। <verse eid="ECC 8:6" /><verse number="7" style="v" sid="ECC 8:7" />ऊ नेहको जानथै कि का होय बाले हबै, अउ कब होही? हइ ओही कोनहर गुठेय सकथै? <verse eid="ECC 8:7" /><verse number="8" style="v" sid="ECC 8:8" />असना कउनो मनसे नेहको जेखर बस परान हे चलै कि ऊ उके निकडत टेम रोक ले, अउ न कउनो मिरतू के रोज हे साहब होथै, अउ न उके झगडा लग छुट्टी मिल सकथै, अउ न दुस्ट मनसे अपन दुस्टता के कारन बच सकथै। <verse eid="ECC 8:8" /><verse number="9" style="v" sid="ECC 8:9" />जेतका काम बेरा के तरी छो करे जथै, उन सबके धियान पूरवक देखै हे हइ सब कुछ मै देखों, अउ हइ देखों कि अक्ठी मनसे दूसर मनसे हे साहेब हुइके अपन उप्पर नुसकान लाथै। <verse eid="ECC 8:9" /><verse number="10" style="v" sid="ECC 8:10" />फेर मै दुस्ट के गाडत टेम देखव, जउन पवितर जिघा हे आय जाय करथै अउ जउन सहर हे उन असना करथै, उहां उनखर सुरता नेहको रथै इहो बेकार हबै। <verse eid="ECC 8:10" /><verse number="11" style="v" sid="ECC 8:11" />बेकार काम के सजा के आदेस जल्दी लग नेहको दय जथै, हइ कारन मनसेन के मन बेकार काम करै के इक्छा लग भरे रथै। <verse eid="ECC 8:11" /><verse number="12" style="v" sid="ECC 8:12" />चाहे पापी सव बेर पाप करै अउ अपन रोज बढाबै, तउमा मोके निस्चित हबै कि जउन भगवान लग डरथै अउ उके अपन आगू जानके डेर लग चलथै उनखर भला होही। <verse eid="ECC 8:12" /><verse number="13" style="v" sid="ECC 8:13" />पय दुस्ट के भला नेहको हुइके, अउ न ओखर जीवनरूपी छाया लम्बा हुइ पाही, काखे भगवान के डेर नेहको मानथै। <verse eid="ECC 8:13" /><verse number="14" style="v" sid="ECC 8:14" />अक्ठी बेकार बात भुंइ हे होथै, मतलब असना नेक हबै जिनखर ऊ दसा होथै, जउन दुस्ट के होय चाही, अउ असना दुस्ट हबै जिनखर ऊ दसा होथै जउन नेक के होय चाही, मै कथो इहो बेकार हबै। <verse eid="ECC 8:14" /><verse number="15" style="v" sid="ECC 8:15" />तब मै मगन के सराहों, काखे बेरा तरी मनसे के निता खाय पीय अउ मगन करै के छांड अउ कुछु निक्खा नेहको, काखे इहै ओखर जीवन भर जउन भगवान ओखर निता भुंइ हे ठहराइस, ओखर मेहनत हे ओखर संग बने रही। <verse eid="ECC 8:15" /><verse number="16" style="v" sid="ECC 8:16" />जब मै दिमाक पायों अउ सब काम देखै के निता जउन भुंइ हे करे जथै अपन मन लगाइस, कि कसना मनसे रात दिन जागत रथै। <verse eid="ECC 8:16" /><verse number="17" style="v" sid="ECC 8:17" />ता मोके अनुभव हुइस कि भगवान के सगलू काम जउन बेरा के तरी हइ भुंइ हे होथै चाहे मनसे ओखर भेद जानै के निता केतका मेहनत काखे झइ करी, ऊ ओखर पता नेहको लगाय सकथै, अगर कउनो हुसियार मनसे उके जानै के दाबा करी, ता उहो ऊ ओखर पता नेहको लगाय सकथै।<verse eid="ECC 8:17" /></para>
  <chapter eid="ECC 8" />
  <chapter number="9" style="c" sid="ECC 9" />
  <para style="s">सब झन कर निता अक जसना मंजिल</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 9:1" />हइ सब मै मन लगायके सोंचा कि हइ सगलू बातन के भेद पाहुं, कि कउन मेर नेक अउ हुसियार मनसे अउ उनखर काम भगवान के हाथ हे हबै, मनसे के आगू सबमेर के बात हबै पय ऊ नेहको जानथै कि ऊ माया हबै या बैर। <verse eid="ECC 9:1" /><verse number="2" style="v" sid="ECC 9:2" />सगलू बात सब के निता एकै जसना होथै, नेक होय या बेकार, निक्खा, सुध्द या असुध्द बलि चढामै बाले या बलि नेहको चढामै बाले, जउन दसा निक्खा मनसे के हबै ऊ पापी मनसे हबै जउन अपन किरिया के पूर करथै ओखर दसा उहै हबै, जउन किरिया के उलंघन करथै। <verse eid="ECC 9:2" /><verse number="3" style="v" sid="ECC 9:3" />जउन कुछ बेरा के तरी छो करे जथै, ओहमा हइ अक्ठी दोस हबै, कि सगलू मनसेन के अक्ठिन दसा हबै, अउ मनसेन के मन हे बुराई भररे हबै, अउ जब तक उन जिन्दा रथै उनखर मन हे पगलाय रथै, एखर बाद उन मरेहर हे जाय मिलथै। <verse eid="ECC 9:3" /><verse number="4" style="v" sid="ECC 9:4" />पय जउन सब जिन्दा हे हबै, उके आसा हबै, काखे जिन्दा कुकरा मरेहर बघवा लग बढके हबै। <verse eid="ECC 9:4" /><verse number="5" style="v" sid="ECC 9:5" />काखे जिन्दा तो एतका जानथै कि उन मरहीं, पय मरेहर कुछु नेहको जानथै अउ न उनके कुछु अउ पलटा मिल सकथै, काखे उनखर सुरता मिट गय हबै। <verse eid="ECC 9:5" /><verse number="6" style="v" sid="ECC 9:6" />उनखर माया अउ बैर अउ उनखर जलन नास हुइ चुकिस, अउ जउन कुछ बेरा के तरी करे जथै ओहमा हरमेसा के निता उनखर अउ कउ हिस्सा नेहको होही। <verse eid="ECC 9:6" /><verse number="7" style="v" sid="ECC 9:7" />अपन रास्ता हे कढ जा, अपन रोटी खुसी लग खाय कर, अउ मन हे सुख मानके अपन अंगूर के रस पीय कर, काखे भगवान तोर कामन लग मगन हुइ चुके हबै। <verse eid="ECC 9:7" /><verse number="8" style="v" sid="ECC 9:8" />तुम्हर बन्डी हरमेसा साफ रहै, तुम्हर मूंड हे हरमेसा तेल लगे रहै। <verse eid="ECC 9:8" /><verse number="9" style="v" sid="ECC 9:9" />भगवान बेरा के तरी भुंइ हे बेकार जीवन के जेतका रोज दय हबै, ओहमा अपन पिरिय डउकी के संग जीवन के खुसी मना, काखे जीवन हे इहै तुम्हर हिस्सा हबै, जउन मेहनत तुम भुंइ हे करथा, ओहमा इहै तुम्हर हिस्सा हबै। <verse eid="ECC 9:9" /><verse number="10" style="v" sid="ECC 9:10" />तुम्हर हाथ हे जउन काम आबै, उके पूर सक्ति लग करा काखे अधलोक हे जिहां अपन मिरतू के बाद तुम जइहा, न काम हबै, न बिचार उछो न ग्यान हबै अउ न दिमाक हबै। <verse eid="ECC 9:10" /><verse number="11" style="v" sid="ECC 9:11" />फेर मै भुंइ हे देखों कि तै दउर हे तेज दउरै बाले अउ लडाई हे सूबीर जीतथै, न हुसियार मनसे रोटी पाथै न समझै बाले डेरा, अउ न परवीनन हे अनुगरह होथै, उन सब टेम अउ संयोग के वस हे हबै। <verse eid="ECC 9:11" /><verse number="12" style="v" sid="ECC 9:12" />काखे मनसे अपन टेम नेहको जानथै, जसना मछडी दुखदाई पानी हे अउ चिरइया जाला हे फसथै, ओसनेन मनसे दुखदाई टेम हे जउन उनखर हे अचानकै आय पडथै अउ फंस जथै।<verse eid="ECC 9:12" /></para>
  <para style="s">मूरख लग निक्खा दिमाक</para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 9:13" />मै बेरा के तरी हइमेर के दिमाक के बात देखे हबै, जउन मोके बडी जान पडथै। <verse eid="ECC 9:13" /><verse number="14" style="v" sid="ECC 9:14" />अक्ठी नान लग सहर रथै, जेहमा चुटु हस मनसे रथै, अउ कउनो बडा राजा उके चढाई करके उके घेर लेथै, अउ ओखर बिरुध्द बडा झगडा करथै। <verse eid="ECC 9:14" /><verse number="15" style="v" sid="ECC 9:15" />पय ओहमा अक्ठी दालिद हुसियार डउका पाय गइस, अउ ऊ उस सहर के अपन दिमाक के दवारा बचाइस, तउमा कउनो ऊ दालिद डउका के सुरता नेहको रखथै। <verse eid="ECC 9:15" /><verse number="16" style="v" sid="ECC 9:16" />तब मै कथो, अगर दालिद के दिमाक बेकार समझे जथै अउ ओखर बचन कउनो नेहको सुनथै तउमा पराकरम लग दिमाक निक्खा हबै। <verse eid="ECC 9:16" /><verse number="17" style="v" sid="ECC 9:17" />हुसियारन के बचन जउन धीम-धीम कहे जथै, उन मूरखन के बीच परभुता करै बालेन के चिल्लाय-चिल्लाय के कहै लग बोहत सुने जथै। <verse eid="ECC 9:17" /><verse number="18" style="v" sid="ECC 9:18" />झगडा के हथियारन लग दिमाक निक्खा हबै, पय अक्ठी पापी बोहत लग भलाई के नास करथै।<verse eid="ECC 9:18" /></para>
  <chapter eid="ECC 9" />
  <chapter number="10" style="c" sid="ECC 10" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 10:1" />मरेहर माछिन के कारन महकनी तेल सडै अउ बदबू आमै लागथै, अउ चुटु लग मूरख हुसियार अउ परतिस्ठा के घटाय देथै। <verse eid="ECC 10:1" /><verse number="2" style="v" sid="ECC 10:2" />हुसियार के मन सही बात के पल्ला रथै, पय मूरख के मन ओखर उल्टा रथै। <verse eid="ECC 10:2" /><verse number="3" style="v" sid="ECC 10:3" />पय मूरख रास्ता हे चलथै, तब ओखर समझ काम नेहको देथै, अउ ऊ सब लग कथै, मै मूरख हव। <verse eid="ECC 10:3" /><verse number="4" style="v" sid="ECC 10:4" />अगर सासन तोर लग गुस्सा होथै, ता अपन जिघा झइ छांड काखे धीरज धरे लग बडा-बडा अपराध सुधार देथै। <verse eid="ECC 10:4" /><verse number="5" style="v" sid="ECC 10:5" />बेरा के तरी अक्ठी बुराई देखे, हइ बुराई के जिम्मेदार सासन हबै। <verse eid="ECC 10:5" /><verse number="6" style="v" sid="ECC 10:6" />मूरख ऊंच जिघा हे बइठाय जथै, अउ धनड्ड मनसे तरी जिघा हे बइठथै। <verse eid="ECC 10:6" /><verse number="7" style="v" sid="ECC 10:7" />मै हरवाहन के घोडवन हे बइठ के जात देखों, अउ राहीसन के हरवाहन के जसना भुंइ हे रेंगत देखे हव। <verse eid="ECC 10:7" /><verse number="8" style="v" sid="ECC 10:8" />जउन खोदरा खोदथै ऊ ओहमा गिरी, अउ जउन बाडा टोरथै उके सपुवा चाबथै। <verse eid="ECC 10:8" /><verse number="9" style="v" sid="ECC 10:9" />जउन पथरा फोरी, ऊ ओखरै लग अधमरहा होही, अउ जउन लकडी काटी, उके उहै लग डर होही। <verse eid="ECC 10:9" /><verse number="10" style="v" sid="ECC 10:10" />अगर टंगिया भोतलाय होय, अउ मनसे ओखर धार के नेहको टेहीं, ता जादा बल लगामै के परी, पय सफल होय के निता दिमाक लग फायदा होथै। <verse eid="ECC 10:10" /><verse number="11" style="v" sid="ECC 10:11" />अगर मंतर लग आगुन सपुवा चाबै, ता मंतर पढैबाले के कुछु फायदा नेहको। <verse eid="ECC 10:11" /><verse number="12" style="v" sid="ECC 10:12" />हुसियार मनसे के बचन के कारन अनुगरह होथै, पय मूरख अपन सब्दन के दवारा नस्ट होथै। <verse eid="ECC 10:12" /><verse number="13" style="v" sid="ECC 10:13" />ओखर बात के सुरुवात मूरख के, अउ उनखर आखरी दुखदाई पागलपन होथै। <verse eid="ECC 10:13" /><verse number="14" style="v" sid="ECC 10:14" />मूरख बोहत बात बढायके बोलथै, तउमा कउनो मनसे गुठे सकथै कि ओखर बाद का होय बाले हबै? <verse eid="ECC 10:14" /><verse number="15" style="v" sid="ECC 10:15" />मूरख के मेहनत लग थकान होथै, इहां तक कि ऊ नेहको जानथै कि सहर छो कसना जइ। <verse eid="ECC 10:15" /><verse number="16" style="v" sid="ECC 10:16" />हे देस तोर हे हाय जब तोर राजा टोरवा हबै, अउ तोर हाकिम सुबेन्ने भोज करथै। <verse eid="ECC 10:16" /><verse number="17" style="v" sid="ECC 10:17" />हे देस तै धन्य हबस, जब तोर राजा कुलीन हबै, अउ तोर हाकिम टेम लग भोज करथै, अउ ऊ मतै के नेहको, पय बल बढामै के निता। <verse eid="ECC 10:17" /><verse number="18" style="v" sid="ECC 10:18" />आलस के कारन छत के लोहा दब जथै, अउ हाथन के सुस्ती लग घर चूथै। <verse eid="ECC 10:18" /><verse number="19" style="v" sid="ECC 10:19" />भोज हंसी खुसी के निता करे जथै, अउ अंगूर कर रस लग जीवन के खुसी मिलथै, अउ पइसा लग सब कुछ मिलथै। <verse eid="ECC 10:19" /><verse number="20" style="v" sid="ECC 10:20" />राजा के मन हे सराप झइ देबे, न धनड्ड के अपन सोबनहा कोठरी हे सराप देबे, काखे आकास के चिरइया तोर बोली के लइ जही, अउ कउनो उडै बाले जन्तु ऊ बात के परगट कर देही।<verse eid="ECC 10:20" /></para>
  <chapter eid="ECC 10" />
  <chapter number="11" style="c" sid="ECC 11" />
  <para style="s">कइठे उद्देस्यन हे बेपार करैके</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 11:1" />अपन रोटी पानी कर उप्पर डार देया, काखे बोहत रोज के बाद तै उके फेरै पइहे। <verse eid="ECC 11:1" /><verse number="2" style="v" sid="ECC 11:2" />सातठे पय आठ झन के हिस्सा दे, काखे तै नेहको जानथस कि भुंइ हे काहिन समस्या आ पडही। <verse eid="ECC 11:2" /><verse number="3" style="v" sid="ECC 11:3" />अगर बादर हे पानी भरे हबै, ता उके भुंइ हे पानी गिराही, अगर कउनो रूख गिरथै चाहे दहिना पार गिरै या टेटरा पार गिरै, ऊ उहै पडे रही जिहां ऊ गिरे हबै। <verse eid="ECC 11:3" /><verse number="4" style="v" sid="ECC 11:4" />जउन मनसे हबा देखथै, ऊ बिजहा नेहको बोय सकथै, अउ जउन बादर के देखथै ऊ उनहारी नेहको काट सकथै। <verse eid="ECC 11:4" /><verse number="5" style="v" sid="ECC 11:5" />जइसन तै हबा के चलै के नेहको जानथस, अउ कउनो मेर लग गरभबती के लादा हे लरका बढथै ओसनेन तै भगवान कर काम नेहको जानथस जउन सगलू कुछ करथै। <verse eid="ECC 11:5" /><verse number="6" style="v" sid="ECC 11:6" />इहैनिता सकरहा होत बिजहा बोमै के सुरू कर देया, अउ दिन बुडत तक काम झइ रोका, काखे तुम नेहको जानथा कि कोन बात तुमके धनवान बना देही हुइ सकथै, तुम जउन कुछ करा सब हे सफल होही।<verse eid="ECC 11:6" /></para>
  <para style="s">जबानी के टेम अपन बनामै बाले के सुरता रख</para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 11:7" />बेरा कर परकास निक्खा लागथै, घाम आंखी के सुकून पहुंचाथै। <verse eid="ECC 11:7" /><verse number="8" style="v" sid="ECC 11:8" />अगर मनसे अनेक साल तक जिन्दा रथै, ता उके चाही कि ऊ अपन उमर के सब साल हे जीवन के खुस रहै, पय ऊ सुरता रखै अंधियार के दिन कम नेहको होही, पय जउन कुछ होथै ऊ बेकार हबै। <verse eid="ECC 11:8" /><verse number="9" style="v" sid="ECC 11:9" />हे जबान अपन जबानी हे खुसी बना अउ अपन जबानी के दिनन हे खुस रह, अपन मनमानी कर अउ अपन आंखी के नजर के जसना चल, पय हइ जान रख कि ई सगलू बातन के बारे हे भगवान तोर नियाव करही। <verse eid="ECC 11:9" /><verse number="10" style="v" sid="ECC 11:10" />अपन मन लग खेद अउ अपन देह लग दुख कर, काखे लडकपन अउ जबानी दुनो बेकार हबै।<verse eid="ECC 11:10" /></para>
  <chapter eid="ECC 11" />
  <chapter number="12" style="c" sid="ECC 12" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 12:1" />अपन जबानी के दिनन हे बनाय बाले भगवान के सुरता रख, एखर लग पहिलेन हइ समस्या के दिन अउ ऊ साल आबै, जेहमा तै कइहे कि मोर मन एहमा नेहको लागथै। <verse eid="ECC 12:1" /><verse number="2" style="v" sid="ECC 12:2" />एखर पहिलेन कि बेरा अउ परकास अउ जोंधइया अउ तरइयां अंधियार हुइ जाय, अउ बरसा होय के बाद बादर फेरै घिराय, <verse eid="ECC 12:2" /><verse number="3" style="v" sid="ECC 12:3" />उन दिनन हे तोर रक्छा करै बाले हाथ कापै लगही, बल बाले गोडो झुक जही गिनती हे कम होय के कारन चकिया पीसै लग छांड देही, झरोकिया लग झांकै बाले आंखी धुंधलाय जही। <verse eid="ECC 12:3" /><verse number="4" style="v" sid="ECC 12:4" />रास्ता के खुलै बाले कान दुनो बन्द हुइ जही, चक्की के पीसै के आरो धीम पड जही, चिरइया के चहचहाय लग नींद लग उठ जही, तोर सब आरो धीम पड जही। <verse eid="ECC 12:4" /><verse number="5" style="v" sid="ECC 12:5" />चुटु हस उंचाई चढै हे तोके डर लगही, अउ रास्ता हे डेरावनी चीज माने जही, अउ बादाम के रूख फूलही, अउ टिड्डी बोहत लगी, अउ भूंख बढामै बाले फडुहा फेरै काम नेहको देही, काखे मनसे अपन हरमेसा कर घर छो जही, रोमै पीटै बाले सडकै सडक फिरहीं। <verse eid="ECC 12:5" /><verse number="6" style="v" sid="ECC 12:6" />ऊ टेम चांदी कर तार दुइठे खन्डा हुइ जही, अउ सोना कर खोरवा टुटही अउ सोते कर लिघ्घो गघरी फुटही, अउ कुन्ड कर लिघ्घो ढिकरी टुट जही। <verse eid="ECC 12:6" /><verse number="7" style="v" sid="ECC 12:7" />माटी जसना के तसना माटी हे मिल जही, अउ आतमा भगवान कर लिघ्घो जउन ऊ दय हबै लउट जही। <verse eid="ECC 12:7" /><verse number="8" style="v" sid="ECC 12:8" />उपदेसक कथै, सब बेकारै बेकार सब कुछ बेकार हबै।<verse eid="ECC 12:8" /></para>
  <para style="s">सगलू बातन के सार</para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 12:9" />उपदेसक जउन हुसियार रथै, ऊ परजा के ग्यान सिखाउत रथै, अउ धियान लगेतार अउ जांच परख करके बोहत लग नीतिबचन क्रम लग रखथै। <verse eid="ECC 12:9" /><verse number="10" style="v" sid="ECC 12:10" />उपदेसक मनभाव सब्द खोजा अउ सिधाई लग हइ सही बात लिख दइस। <verse eid="ECC 12:10" /><verse number="11" style="v" sid="ECC 12:11" />हुसियारन के बचन पैन कर जसना होथै, अउ सभा के परधान के बचन गाडी हुइ खीला के जसना हबै काखे एकै बरेदी के पल्ला मिलथै। <verse eid="ECC 12:11" /><verse number="12" style="v" sid="ECC 12:12" />हे मोर टोरवा इहै हे चवकसी सीख, बोहत किताबन के रचना के आखरी नेहको होथै, अउ बोहत पढैके देह के थकाय देथै। <verse eid="ECC 12:12" /><verse number="13" style="v" sid="ECC 12:13" />सब कुछ सुने गइस, आखरी के बात हइ हबै कि भगवान के भय मान अउ ओखर आदेसन के मानेकर काखे मनसे के पूर काम इहै हबै। <verse eid="ECC 12:13" /><verse number="14" style="v" sid="ECC 12:14" />काखे भगवान सगलू कामन के अउ सगलू छुपेहर बातन के चाहे ऊ निक्खा होय या बेकार, भगवान नियाव करी।<verse eid="ECC 12:14" /></para>
  <chapter eid="ECC 12" />
</usx>