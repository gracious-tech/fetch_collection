<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="SNG" style="id">- Bhumiya Test Project</book>
  <para style="h">स्रेस्ठ</para>
  <para style="toc3">स्रेस्ठ</para>
  <para style="toc2">स्रेस्ठ</para>
  <para style="toc1">स्रेस्ठ</para>
  <para style="mt2">स्रेस्ठगीत</para>
  <para style="mt1">स्रेस्ठगीत</para>
  <para style="imt">परचा</para>
  <para style="ip">स्रेस्ठगीत इजराइली माया गाना कर अक्ठी किताब हबै, सायद कइनठे लेखक दवारा। इब्रानी भासा हे, “स्रेस्ठगीत” सब्द हइ कहै के अक्ठी तरीका हबै कि हइ सबले महान गाना हबै, जसना सब्द “राजन कर राजा” के मतलब बडा राजा हबै। किताब कर सुरुवात राजा सुलेमान <char style="xt"><ref loc="SNG 1:1">1:1</ref></char> कर बिस्तार लग होथै, पय एखर मतलब हइ नेहको हबै कि ऊ इके लिखे हबै। हइ सरल हबै कि किताब सुलेमान के आदर करै के निता कउनो अउ लिखे होय।</para>
  <para style="ip">बुध्दिमानन के नेहको पता कि किताब कब लिखवरे रथै, पय हइ सुलेमान कर जीवनकाल (970-931 ईसा पूरब) के दउरान लिखे गय हुइ सकथै अउ बाद हे सुधार करे गय हुइ सकथै। स्रेस्ठगीत कल्पित माया कर परसंसा करथै। पूर किताब हे, अक्ठी डउका अउ अक्ठी डउकी अक-दूसर के निता अपन इक्छा जाहिर करथै। कबहुन-कबहुन उनखर सखा टिप्पनी करथै अउ उनखर कारिक्रम हे सामिल होथै <char style="xt"><ref loc="SNG 1:8">1:8</ref></char>। जादातर हुसियार हइ बात लग सहमत हबै कि किताब कर उच्चतम बिन्दु अध्याय <char style="xt"><ref loc="SNG 8:5-7">8:5-7</ref></char> हे पाय जथै। उछो डउकी कथै, कि माया मिरतू कर जसना सक्तिसाली हबै। माया सबले मजबूत चीज हबै जेही हम महसूस कर सकथन अउ इके रोक नेहको सकथै, जसना मिरतू। सायद इहै कारन हबै कि डउकी 3 बेर चेतन्त देथै, कि मनसेन के सही टेम लग पहिले माया के नेहको जगामै चाही <char style="xt"><ref loc="SNG 2:7">2:7</ref>; <ref loc="SNG 3:5">3:5</ref>; <ref loc="SNG 8:4">8:4</ref> </char>। स्रेस्ठगीत कर</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. हे किताब कर सीरसक दय गय हबै। <char style="ior"><ref loc="SNG 1:1">1:1</ref> </char></para>
  <para style="io1">2. सीरसक के बाद, पहिले गाना <char style="ior"><ref loc="SNG 1:2-2:7">1:2—2:7</ref></char></para>
  <para style="io1">3. दूसर गाना <char style="ior"><ref loc="SNG 2:8-3:5">2:8—3:5</ref></char></para>
  <para style="io1">4. तीसर गाना <char style="ior"><ref loc="SNG 3:6-5:1">3:6—5:1</ref></char></para>
  <para style="io1">5. चउथा गाना <char style="ior"><ref loc="SNG 5:2-6:3">5:2—6:3</ref></char></para>
  <para style="io1">6. पचमा गाना <char style="ior"><ref loc="SNG 6:4-8:4">6:4—8:4</ref></char></para>
  <para style="io1">7. आखरी हे, छठमा गाना <char style="ior"><ref loc="SNG 8:5-14">8:5—8:14</ref></char></para>
  <chapter number="1" style="c" sid="SNG 1" />
  <para style="p">
    <verse number="1" style="v" sid="SNG 1:1" />राजा सुलेमान दवारा लिखे हर स्रेस्ठ गाना।<note caller="+" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="1KI 4:32">1 राजा 4:32</ref> </char></note><verse eid="SNG 1:1" /></para>
  <para style="s">पहिला गाना</para>
  <para style="sp">दुलही</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 1:2" />तै मोके अपन मुंह के चुम्मा लग ढक ले,</para>
  <para style="q2" vid="SNG 1:2">काखे तोर माया अंगूर के रस लग जादा मीठ हबै।<verse eid="SNG 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 1:3" />तै कइ-कइठे महकनी तेल लगाय हबस,</para>
  <para style="q2" vid="SNG 1:3">उनखर महक केतका तेज हबै, तोर नाम माना उंडेले हर महकनी तेल हबै,</para>
  <para style="q2" vid="SNG 1:3">इहैनिता कुंवारिन तोर लग माया करथै।<verse eid="SNG 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 1:4" />मोके तीनले, हम तोर पाछु दउडब,</para>
  <para style="q2" vid="SNG 1:4">राजा मोके अपन कमरा हे लइ आने हबै,</para>
  <para style="q1" vid="SNG 1:4">हम तोर हे मगन अउ खुस हुइबे,</para>
  <para style="q2" vid="SNG 1:4">हम अंगूर रस लग जादा तोर माया कर चरचा करब,</para>
  <para style="q2" vid="SNG 1:4">उन निक्खा तोर लग माया करथै।<verse eid="SNG 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 1:5" />हे यरुसलेम कर टोरियन,</para>
  <para style="q2" vid="SNG 1:5">मै करिया तो हव पय सुंदर हव, केदार वंस के तम्बून के</para>
  <para style="q2" vid="SNG 1:5">अउ सुलेमान कर महल कर परदा कर जसना सुंदर हव।<verse eid="SNG 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 1:6" />मोके झइ घूर कि मै केतका सांवर पानी के हव,</para>
  <para style="q2" vid="SNG 1:6">बेरा मोके केतका कडिया कर दय हबै,</para>
  <para style="q1" vid="SNG 1:6">मोर दाय कर टोरवन मोर लग खुस नेहको रथै,</para>
  <para style="q2" vid="SNG 1:6">उन मोके अंगूर कर बगिया के देखरेख बनाइस,</para>
  <para style="q2" vid="SNG 1:6">पय मै अपन खुद कर बगिया के बारी के देखरेख नेहको करों।<verse eid="SNG 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 1:7" />मै तोके अपन पूरा आतमा लग माया करथो,</para>
  <para style="q2" vid="SNG 1:7">मोर जान मोके गुठे, तै अपन गेडरन कर झुंड कछो चराथस?</para>
  <para style="q1" vid="SNG 1:7">दुपहरी हे उनके कछो बइठाउथस?</para>
  <para style="q2" vid="SNG 1:7">मोके असना अक्ठी टोरिया के लिघ्घो नेहको,</para>
  <para style="q2" vid="SNG 1:7">जउन मूंड ढांकथै, जब ऊ तोर साथिन के गेडरन के लिघ्घो होथै।<verse eid="SNG 1:7" /></para>
  <para style="sp">दुलहा</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 1:8" />डउकिन मसे तै सुंदर हबस,</para>
  <para style="q1" vid="SNG 1:8">जा पाछु-पाछु कढ जा,</para>
  <para style="q2" vid="SNG 1:8">जिहां गेडरा अउ छेडिन के लरका जथै,</para>
  <para style="q2" vid="SNG 1:8">अपन गेडरन के तम्बू के लिघ्घो चरा।<verse eid="SNG 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 1:9" />हे मोर पिरिया, मै तोर बरोबरी फिरोन के रथ हे</para>
  <para style="q2" vid="SNG 1:9">जोते हर घोडवा लग करे हव।<verse eid="SNG 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 1:10" />गहना लग जुडे तोर गाल केतका संदुर लगथै,</para>
  <para style="q2" vid="SNG 1:10">तोर नटेरी हे मंहगा हार लटकत हबै।<verse eid="SNG 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 1:11" />हम तोर निता चांदी कर</para>
  <para style="q2" vid="SNG 1:11">फूलबाले सोना के सजावट बनउबे।<verse eid="SNG 1:11" /></para>
  <para style="sp">दुलही</para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 1:12" />जब राजा अपन गद्दी हे बइठे रथै,</para>
  <para style="q2" vid="SNG 1:12">मोर महकनी तेल के सुगंध फइलत रहै।<verse eid="SNG 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 1:13" />मोर माया करै बाले मोर निता गाद<note caller="+" style="f"><char style="fr" closed="false">1:13 </char><char style="ft" closed="false">कुरलू कर गाद (लोबान)</char></note> कर थइला के जसना हबै,</para>
  <para style="q2" vid="SNG 1:13">जउन मोर छाती के बीच हे पडे रथै।<verse eid="SNG 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 1:14" />मोर माया करै बाले मोर निता मेंहदी के फूलन के गुच्छा के जसना हबै,</para>
  <para style="q2" vid="SNG 1:14">जउन एनगदी<note caller="+" style="f"><char style="fr" closed="false">1:14 </char><char style="ft" closed="false">म्रतसागर के पस्चमी तक एनगदी हबै।</char></note> के अंगूर कर बगिया हे होथै।<verse eid="SNG 1:14" /></para>
  <para style="sp">दुलहा</para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 1:15" />तै मोर पिरिया, तै सुंदर हबस, तै केतका सुंदर हबस,</para>
  <para style="q2" vid="SNG 1:15">तोर आंखी परेवा कर जसना हबै।<verse eid="SNG 1:15" /></para>
  <para style="sp">दुलही</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 1:16" />हे मोर पिरिया, तै सुंदर अउ मनमोह बाले हबस,</para>
  <para style="q2" vid="SNG 1:16">अउ हमर हरियर चारा के डसना हबै,<verse eid="SNG 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 1:17" />हमर घर के खूंटा देवदार के लकडी कर हबै,</para>
  <para style="q2" vid="SNG 1:17">हमर छत के मलगा सनोवर रूख के हबै।<verse eid="SNG 1:17" /></para>
  <chapter eid="SNG 1" />
  <chapter number="2" style="c" sid="SNG 2" />
  <para style="q1">
    <verse number="1" style="v" sid="SNG 2:1" />मै सारोन कर गुलाब हव</para>
  <para style="q2" vid="SNG 2:1">अउ मै डोंगर के सोसन फूल हव।<verse eid="SNG 2:1" /></para>
  <para style="sp">दुलहा</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 2:2" />जसना सोसन फूल कांटा बाले रूखन कर बीच</para>
  <para style="q2" vid="SNG 2:2">ओसनेन मोर जान टोरियन के बीच हे हबै।<verse eid="SNG 2:2" /></para>
  <para style="sp">दुलही</para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 2:3" />जसना पतेरा कर रूख हे सेब</para>
  <para style="q2" vid="SNG 2:3">ओसनेन मोर जान टोरवन हे हबै,</para>
  <para style="q1" vid="SNG 2:3">मै ओखर छांया हे खुस हुइके बइठ गयों,</para>
  <para style="q2" vid="SNG 2:3">ओखर माया फडुहा कर सोद केतका मीठ हबै।<verse eid="SNG 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 2:4" />ऊ मोके खाना घर हे लइ आनिस,</para>
  <para style="q2" vid="SNG 2:4">ओखर जउन झन्डा मोर उप्पर फहिराथै ऊ माया रथै।<verse eid="SNG 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 2:5" />हे सखी, तुम किसमिस खबायके मोके बल देया,</para>
  <para style="q2" vid="SNG 2:5">सेब खबायके मोके ताजा करा,</para>
  <para style="q2" vid="SNG 2:5">काखे मै माया के जुनून लग कमजोर हव।<verse eid="SNG 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 2:6" />ओखर टेटरी हाथ मोर मूंड कर तरी रथै</para>
  <para style="q2" vid="SNG 2:6">अउ ऊ अपन दहिना हाथ लग मोके सहलाथै।<verse eid="SNG 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 2:7" />हे यरुसलेम कर टोरियन,</para>
  <para style="q2" vid="SNG 2:7">मै तुम्हर लग छिगरी अउ मइदान कर छिगरिन के किरिया धरायके कथो,</para>
  <para style="q2" vid="SNG 2:7">कि जब तक माया खुद लग न उठै, तब तक ओही न उकसाबा न जगाबा।<verse eid="SNG 2:7" /></para>
  <para style="s">दूसर गाना</para>
  <para style="sp">दुलही</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 2:8" />मोर जान कर आरो सुन पडथै,</para>
  <para style="q2" vid="SNG 2:8">देखा, ऊ डोंगर हे कुदत</para>
  <para style="q2" vid="SNG 2:8">अउ डोंगरन लग पार करत आथै।<verse eid="SNG 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 2:9" />मोर जान छिगरी कर जसना हबै,</para>
  <para style="q2" vid="SNG 2:9">ऊ तरुन हिरन हबै, देखा,</para>
  <para style="q1" vid="SNG 2:9">ऊ हमर दीबार कर पाछु ठाड हबै,</para>
  <para style="q2" vid="SNG 2:9">ऊ झकियन के पल्ला ताकथै,</para>
  <para style="q2" vid="SNG 2:9">ऊ जाली लग झांकथै।<verse eid="SNG 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 2:10" />मोर पिरिया मोर लग कहथै,</para>
  <para style="q2" vid="SNG 2:10">उठ, मोर पिरिया,</para>
  <para style="q2" vid="SNG 2:10">हे मोर सुंदरी उठके चले आ।<verse eid="SNG 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 2:11" />देख, सरद मउसम बीत गइस,</para>
  <para style="q2" vid="SNG 2:11">पानी गिर के कढ गइस,<verse eid="SNG 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 2:12" />भुंइ हे फूल खिलै लगिस,</para>
  <para style="q2" vid="SNG 2:12">गाना गामै के टेम आ गइस,</para>
  <para style="q2" vid="SNG 2:12">हमर देस हे परेवा कर आरो सुनाइ देथै।<verse eid="SNG 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 2:13" />अंजीर कर फडुहा पके लगे हबै,</para>
  <para style="q2" vid="SNG 2:13">अंजीर कर डगाइल फूलत हबै,</para>
  <para style="q1" vid="SNG 2:13">ऊ सुगंध बगराउत हबै,</para>
  <para style="q2" vid="SNG 2:13">ओ मोर पिरिया मोर सुंदरी, उठके चले आ।<verse eid="SNG 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 2:14" />हे मोर कबूतरी, डोंगर के दरार हे</para>
  <para style="q2" vid="SNG 2:14">टीलन के कुंज हे मोके अपन मुंह देखै दे,</para>
  <para style="q1" vid="SNG 2:14">मोके अपन बोली सुनै दे,</para>
  <para style="q2" vid="SNG 2:14">काखे तोर बोली मीठ अउ तोर मुंह बोहत सुंदर हबै।<verse eid="SNG 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 2:15" />जउन नान सिक्टा अंगूर के बगिया के बिगाडथै,</para>
  <para style="q2" vid="SNG 2:15">उनके पकड ले, काखे हमर अंगूर कर बगिया हे फूल लगे हबै।<verse eid="SNG 2:15" /></para>
  <para style="sp">दुलही</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 2:16" />मोर पिरिया मोर हबै, अउ मै ओखर हव,</para>
  <para style="q2" vid="SNG 2:16">ऊ पटपड के सोसन के बीच अपन झुंड के चराथै।<verse eid="SNG 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 2:17" />जब तक दिन नेहको बुढथै</para>
  <para style="q2" vid="SNG 2:17">अउ छांया लम्बा होत-होत मिट झइ जाय,</para>
  <para style="q1" vid="SNG 2:17">तब तक हे मोर पिरिया, ऊ छिगरी कर मेर ऊबड-खाबड डोंगर हे</para>
  <para style="q2" vid="SNG 2:17">तरुन हिरन के जसना लउट आबे।<verse eid="SNG 2:17" /></para>
  <chapter eid="SNG 2" />
  <chapter number="3" style="c" sid="SNG 3" />
  <para style="q1">
    <verse number="1" style="v" sid="SNG 3:1" />रात के टेम मै खटिया हे सोय रथो,</para>
  <para style="q2" vid="SNG 3:1">ऊ टेम मै अपन परान पिरिया के पामै चाहो,</para>
  <para style="q1" vid="SNG 3:1">मै उके खोजै लगो, पय ऊ मोके नेहको मिलिस,</para>
  <para style="q2" vid="SNG 3:1">मै ओही गोहरायों, पय ऊ जबाब नेहको दइस।<verse eid="SNG 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 3:2" />अब मै खटिया लग उठके सहर हे,</para>
  <para style="q2" vid="SNG 3:2">गली, चउराहा हे घूम-घूम के अपन परान पिरिया के खोजत रहों,</para>
  <para style="q2" vid="SNG 3:2">पय नेहको पायों।<verse eid="SNG 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 3:3" />मोके चउकीदार मिलिन, ऊ सहर हे घूम-घूम के पहिरा देत रहै,</para>
  <para style="q2" vid="SNG 3:3">मै उनखर लग पूंछो, “का तुम मोर पिरिया के देखे हबा?”<verse eid="SNG 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 3:4" />पहिरेदार बालेन लग मै चुटु दुरिहां गयों कि मोके मोर जान मिल गय,</para>
  <para style="q2" vid="SNG 3:4">मै उके पकड लयों अउ तब तक जाय नेहको दयों,</para>
  <para style="q1" vid="SNG 3:4">जब तक मै उके अपन दाय के घर हे नेहको लइ आनो,</para>
  <para style="q2" vid="SNG 3:4">मतलब ऊ डउकी के अपन कोठा हे नेहको लइ आनो,</para>
  <para style="q2" vid="SNG 3:4">तब तक उके नेहको जाय दयों।<verse eid="SNG 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 3:5" />हे यरुसलेम कर टोरिया, मै तुम्हर लग छिगरिन</para>
  <para style="q2" vid="SNG 3:5">अउ मइदान के छिगरिन के किरिया धरायके कथो,</para>
  <para style="q1" vid="SNG 3:5">कि जब तक माया खुद लग झइ उठै,</para>
  <para style="q2" vid="SNG 3:5">तब तक ओही न उकसाबा अउ न जगाबा। दुलही<verse eid="SNG 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 3:6" />हइ काहिन आय जउन कुहिरा कर खम्भा कर जसना,</para>
  <para style="q2" vid="SNG 3:6">गन्धरस अउ गाद लग खुसबू अउ ब्यापारी के सगलू मेर कर महकै बाले धूप</para>
  <para style="q2" vid="SNG 3:6">पउडर<note caller="+" style="f"><char style="fr" closed="false">3:6 </char><char style="ft" closed="false">बुकनी कर मतलब-सुगन्धित धूप पउडर</char></note> लगाय हर पतेरा लग निकड के आथै?<verse eid="SNG 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 3:7" />देखा, हइ तो राजा सुलेमान के डोली हबै,</para>
  <para style="q2" vid="SNG 3:7">इस्राएल के सेना चुने हर साठ योध्दा ओखर संग-संग चलथै।<verse eid="SNG 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 3:8" />उन सगलू सेना तलबार धरे रथै,</para>
  <para style="q2" vid="SNG 3:8">जउन युध्द हे मजबूत हबै,</para>
  <para style="q2" vid="SNG 3:8">रात के डर कर मारे हर मनसे कर बगल हे तलबार लटकथै।<verse eid="SNG 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 3:9" />राजा सुलेमान अपन निता लबानोन रूख के लकडी लग</para>
  <para style="q2" vid="SNG 3:9">अक्ठी डोली बनवाय लइस।<verse eid="SNG 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 3:10" />एखर खम्भा चांदी लग ढके हर हबै,</para>
  <para style="q2" vid="SNG 3:10">एखर उप्पर सोन लग कढाई करे हर कपडा हबै,</para>
  <para style="q1" vid="SNG 3:10">एखर कुसन बैजनी कपडा लग ढके हर हबै,</para>
  <para style="q2" vid="SNG 3:10">जेखर लग यरुसलेम के डउकिन माया लग बनाय हबै।<verse eid="SNG 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 3:11" />हे सिय्योन कर टोरिया, बाहिर आयके राजा सुलेमान के देखा,</para>
  <para style="q1" vid="SNG 3:11">ऊ उस मुकुट के पहिरे हर हबै,</para>
  <para style="q2" vid="SNG 3:11">जउन ओखर दाय ओखर काज के रोज</para>
  <para style="q2" vid="SNG 3:11">ओखर हिरदय के खुसी दिबस हे ओही पहिनाय रथै।<verse eid="SNG 3:11" /></para>
  <chapter eid="SNG 3" />
  <chapter number="4" style="c" sid="SNG 4" />
  <para style="sp">दुलहा</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 4:1" />हे मोर पिरिया, तै सुंदर हबस,</para>
  <para style="q1" vid="SNG 4:1">मुंह ढंकनहा कर भित्तर तोर आंखी परेवा कर जसना दिखथै,</para>
  <para style="q1" vid="SNG 4:1">तोर चूंदी गिलाद परदेस के ढाल लग तरी उतरत छेडिन</para>
  <para style="q2" vid="SNG 4:1">कर झुंड के जसना लगथै।<verse eid="SNG 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 4:2" />तोर दांत उन गेडरन कर जसना चरका हबै,</para>
  <para style="q2" vid="SNG 4:2">जउन अबे-अबे नहायके निकडे होय।</para>
  <para style="q1" vid="SNG 4:2">ऊ सगलू जोडधा छउना के जनम दय करथै,</para>
  <para style="q2" vid="SNG 4:2">अउ उनखर छउना नेहको मरे हबै।<verse eid="SNG 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 4:3" />तोर बिबडा बोहत सुन्दर लाल रंग के सूत के मेर हबै,</para>
  <para style="q2" vid="SNG 4:3">अउ तोर मुंह बोहत सुन्दर हबै,</para>
  <para style="q2" vid="SNG 4:3">तोर गाल ओढनी कर तरी अनार के आधा खंडा जसना दिखथै।<verse eid="SNG 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 4:4" />तोर नटेरी दाऊद के मीनार कर जसना हबै,</para>
  <para style="q2" vid="SNG 4:4">जउन हथियार के निता बने होय,</para>
  <para style="q2" vid="SNG 4:4">अउ जेखर उप्पर हजार ढाल टंगे हर होय, ऊ सगलू ढाल योध्दा कर आय।<verse eid="SNG 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 4:5" />तोर दोनो छाती छिगरी के दुइठे जोडधा लरकन के बरोबर हबै,</para>
  <para style="q2" vid="SNG 4:5">जउन सोसन फूलन के बीच हे चरत होंय।<verse eid="SNG 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 4:6" />मै गन्धरस कर डोंगर हे जइहों</para>
  <para style="q2" vid="SNG 4:6">अउ ऊ डोंगर हे जउन लोबान कर हबै,</para>
  <para style="q2" vid="SNG 4:6">जब दिन अपन आखरी सांस लेथै</para>
  <para style="q2" vid="SNG 4:6">अउ ओखर छांया बोहत लम्बा हुइके लुक जथै।<verse eid="SNG 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 4:7" />हे मोर जान, तै पूरा के पूरा सुंदर हबस,</para>
  <para style="q2" vid="SNG 4:7">तोर हे कउनो धब्बा नेहको आय।<verse eid="SNG 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 4:8" />हे मोर दुलही, तै मोर संग लबानोन डोंगर लग,</para>
  <para style="q2" vid="SNG 4:8">मोर संग लबानोन डोंगर लग चले आ,</para>
  <para style="q1" vid="SNG 4:8">जउन अमाना के डोंगर के फुंलगी लग,</para>
  <para style="q2" vid="SNG 4:8">सनीर डोंगर अउ हेर्मोन डोंगर के फुंलगी लग,</para>
  <para style="q1" vid="SNG 4:8">बघवा कर माडा लग,</para>
  <para style="q2" vid="SNG 4:8">चितुवा के डोंगर लग नजर लग।<verse eid="SNG 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 4:9" />हे मोर अति पिरिया, हे मोर दुलही,</para>
  <para style="q2" vid="SNG 4:9">तै मोर मन के चोर लय हबै,</para>
  <para style="q1" vid="SNG 4:9">तै अपन आंखी के अक्ठी नजर लग,</para>
  <para style="q2" vid="SNG 4:9">अउ अपन नटेरी के अक्ठी हीरा लग</para>
  <para style="q2" vid="SNG 4:9">मोर दिल के चोर लय हबै।<verse eid="SNG 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 4:10" />हे मोर साथी, हे मोर दुलही, तोर माया केतका मीठ हबै,</para>
  <para style="q2" vid="SNG 4:10">तोर माया अंगूर के रस लग निक्खा हबै,</para>
  <para style="q1" vid="SNG 4:10">अउ तोर महकनी तेल कर खुसबू सब मेर के मसालन के जादा खुसबू हबै।<verse eid="SNG 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 4:11" />हे मोर दुलही, तोर बिबडा लग सहद टपकथै,</para>
  <para style="q2" vid="SNG 4:11">तोर जीभ कर तरी सहद अउ दूध कर मिटास हबै,</para>
  <para style="q1" vid="SNG 4:11">तोर कपडा कर खुसबू माना कि लबानोन कर खुसबू हबै।<verse eid="SNG 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 4:12" />हे मोर संगी, हे मोर दुलही, तै असना हबस जसना कउनो लुके हर बगिया होय,</para>
  <para style="q2" vid="SNG 4:12">तै ओसनेन हबस, जसना कउनो रुके हर सोता होय या बंद करे हर झरना होय।<verse eid="SNG 4:12" /></para>
  <para style="q2">
    <verse number="13" style="v" sid="SNG 4:13" />तोर पउधा अच्छा फडुहा बाले अनार</para>
  <para style="q1" vid="SNG 4:13">कर बगिया के बरोबरी हबै,</para>
  <para style="q2" vid="SNG 4:13">जेहमा मेंहदी अउ महकै बाले तेल,<verse eid="SNG 4:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 4:14" />महकै बाले तेल अउ केसर, लोबान कर सगलू मेर के रूख,</para>
  <para style="q2" vid="SNG 4:14">मुस्क अउ दालचीनी, गन्धरस,</para>
  <para style="q1" vid="SNG 4:14">अगर हइ सगलू खास-खास सुगन्धित चीज हबै।<verse eid="SNG 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 4:15" />तै बगिया कर सोता हबस</para>
  <para style="q2" vid="SNG 4:15">फटत पानी कर कुंवा अउ</para>
  <para style="q2" vid="SNG 4:15">लबानोन डोंगर लग बहत धार हबै।<verse eid="SNG 4:15" /></para>
  <para style="sp">दुलही</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 4:16" />हे उतरी हवा आ,</para>
  <para style="q1" vid="SNG 4:16">तै उतरी हवा आ, मोर बगिया हे बह,</para>
  <para style="q2" vid="SNG 4:16">जेखर लग ओखर खुसबू फइलै,</para>
  <para style="q1" vid="SNG 4:16">मोर पिरिया अपन बगिया हे आइस,</para>
  <para style="q2" vid="SNG 4:16">अउ ओखर निक्खा-निक्खा फडुहा खाय।<verse eid="SNG 4:16" /></para>
  <chapter eid="SNG 4" />
  <chapter number="5" style="c" sid="SNG 5" />
  <para style="sp">दुलहा</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 5:1" />हे मोर साथी, हे मोर दुलही,</para>
  <para style="q2" vid="SNG 5:1">मै अपन बगिया हे आय हव,</para>
  <para style="q1" vid="SNG 5:1">मै अपन महकै बाले अउ बलसान चुन लयों,</para>
  <para style="q2" vid="SNG 5:1">मै अपन रसगंध अकजुट करों, मै अपन सगलू छाता खाय लयों,</para>
  <para style="q2" vid="SNG 5:1">मै अपन रस अउ अपन दूध पी चुकों।</para>
  <para style="sp" vid="SNG 5:1">सखी</para>
  <para style="q1" vid="SNG 5:1">हे दोस, तुमो खा, हे पिया,</para>
  <para style="q2" vid="SNG 5:1">मनमानी पिया।<verse eid="SNG 5:1" /></para>
  <para style="s">चउथा गाना</para>
  <para style="sp">दुलही</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 5:2" />मै सोउत रहों, पय मोर मन जागत रथै, सुन, मोर परेमी खटखटाथै,</para>
  <para style="q2" vid="SNG 5:2">अउ कथै, “हे मोर बेहन, हे मोर परेमी, हे मोर परेवा,</para>
  <para style="q1" vid="SNG 5:2">हे मोर निरमल मोर निता दूरा उघार, काखे मोर मूंड ओस लग भरे हबै,</para>
  <para style="q2" vid="SNG 5:2">अउ मोर लटा रात हे गिरे हर बूंदन लग फुले हबै।”<verse eid="SNG 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 5:3" />मै अपन कपडा उतार चुके रथो,</para>
  <para style="q2" vid="SNG 5:3">मै उके फेर कइसन पहिनों?</para>
  <para style="q1" vid="SNG 5:3">मै तो अपन गोड धो चुके रथो,</para>
  <para style="q2" vid="SNG 5:3">अब ओही कइसन मइल करों?<verse eid="SNG 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 5:4" />मोर परेमी अपन हाथ केवाड के छेद लग भित्तर डाल दय,</para>
  <para style="q2" vid="SNG 5:4">तब मोर हिरदय ओखर निता उमड उठिस।<verse eid="SNG 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 5:5" />मै अपन परेमी कर निता दूरा उघारै के उठिस,</para>
  <para style="q2" vid="SNG 5:5">अउ मोर हाथन लग गंधरस टपकिस,</para>
  <para style="q2" vid="SNG 5:5">अउ मोर अंगठी लग टपकत गंधरस केवाड कर सकरी कर कुन्डी हे पडिस।<verse eid="SNG 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 5:6" />मै अपन परेमी कर निता दूरा तो उघारो,</para>
  <para style="q2" vid="SNG 5:6">पय मोर परेमी पहिलेन कढ गय रहिस,</para>
  <para style="q1" vid="SNG 5:6">मै ओखर आरो सुनै के चाहत रहों, मै उके खोजो,</para>
  <para style="q1" vid="SNG 5:6">पय ऊ नेहको मिलिस, मै ओही गोहरायों,</para>
  <para style="q2" vid="SNG 5:6">पय कउनो जबाब नेहको मिलिस।<verse eid="SNG 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 5:7" />मै पहिरेदार कर हाथ हे पड गयों,</para>
  <para style="q2" vid="SNG 5:7">ऊ सहर हे घूम-घूमके पहरा देत रथै,</para>
  <para style="q1" vid="SNG 5:7">उन मोके मारिन अउ अधमरहा कर दइन,</para>
  <para style="q2" vid="SNG 5:7">सहरपनाह कर दीबार पहिरेदार मोर साल छांडय के मोके बिगर कपडा के कर दइन।<verse eid="SNG 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 5:8" />हे यरुसलेम के टोरिया, मै तुमके किरिया देथो,</para>
  <para style="q2" vid="SNG 5:8">अगर तुमके मोर परेमी मिलही,</para>
  <para style="q2" vid="SNG 5:8">ता तुम उके हइ जरूर गुठेइहा कि मै माया हे दिवानी हव।<verse eid="SNG 5:8" /></para>
  <para style="sp">सखी</para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 5:9" />हे डउकिन लग परम सुंदरी,</para>
  <para style="q2" vid="SNG 5:9">तोर परेमी दूसर परेमी लग कउन बात हे अलग हबै?</para>
  <para style="q1" vid="SNG 5:9">ओहमा काहिन खास हबै,</para>
  <para style="q2" vid="SNG 5:9">कि तै हमके काखे किरिया देथस?<verse eid="SNG 5:9" /></para>
  <para style="sp">दुलही</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 5:10" />मोर परेमी गोर अउ लाल जइसन हबै,</para>
  <para style="q2" vid="SNG 5:10">ऊ दस हजार हे निक्खा हबै।<verse eid="SNG 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 5:11" />ओखर मूंड चोख सुध्द सोन जइसन हबै,</para>
  <para style="q2" vid="SNG 5:11">ओखर लटकत हर बाल कउवा कर</para>
  <para style="q2" vid="SNG 5:11">जसना करिया हबै।<verse eid="SNG 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 5:12" />ओखर आंखी उन परेवा कर जसना हबै, जउन दूध हे नहायके नदिया कर टाठा हे,</para>
  <para style="q2" vid="SNG 5:12">अपन झुंड हे अक लाइनबार बइठे हर होय।<verse eid="SNG 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 5:13" />ओखर गाल असना सुन्दर जसना,</para>
  <para style="q2" vid="SNG 5:13">पूर भरे हर जडी बूटी अउ गंधरस कर बगिया हबै,</para>
  <para style="q1" vid="SNG 5:13">ओखर बिबडा सोसन कर फूल</para>
  <para style="q2" vid="SNG 5:13">अउ पिघले हर गंधरस टपकथै।<verse eid="SNG 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 5:14" />ओखर हाथ फिरोजा बनाय हर सोन के छड जसना हबै,</para>
  <para style="q2" vid="SNG 5:14">ओखर देह नीलम कर फूलन लग बनाय हर हाथी दांत के बने हबै।<verse eid="SNG 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 5:15" />ओखर गोड संगमरमर पथरा के खम्भा हबै,</para>
  <para style="q2" vid="SNG 5:15">जउन सुध्द सोना हे बइठाय गय हबै,</para>
  <para style="q1" vid="SNG 5:15">ओखर सकल लबानोन डोंगर कर जसना हबै,</para>
  <para style="q2" vid="SNG 5:15">सब लग निक्खा देवदार कर रूख कर जसना ऊ सुंदर हबै।<verse eid="SNG 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 5:16" />हां, यरुसलेम कर टोरिया,</para>
  <para style="q2" vid="SNG 5:16">मोर परेमी बोहत जादा सुंदर हबै,</para>
  <para style="q1" vid="SNG 5:16">सब लग मीठ ओखर आरो हबै,</para>
  <para style="q2" vid="SNG 5:16">असना हबै मोर परेमी, इहै मोर संगी हबै।<verse eid="SNG 5:16" /></para>
  <para style="sp">सखी</para>
  <chapter eid="SNG 5" />
  <chapter number="6" style="c" sid="SNG 6" />
  <para style="sp">सखी</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 6:1" />हे टोरिया परम सुंदरी,</para>
  <para style="q2" vid="SNG 6:1">तोर परेमी कछो गइस?</para>
  <para style="q1" vid="SNG 6:1">तोर परेमी कछो कढ गय कि</para>
  <para style="q2" vid="SNG 6:1">हम तोर संग ओही खोजै निकरै?<verse eid="SNG 6:1" /></para>
  <para style="sp">दुलही</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 6:2" />मोर परेमी अपन बगिया हे</para>
  <para style="q2" vid="SNG 6:2">अपन गेडरा छेडी चरामै के निता</para>
  <para style="q1" vid="SNG 6:2">सोस फूल चरै कर निता अपन बगिया हे गय हबै,</para>
  <para style="q2" vid="SNG 6:2">ऊ सोसन के फूल हे गय हबै।<verse eid="SNG 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 6:3" />मै अपन परेमी कर हव अउ ऊ मोर हबै,</para>
  <para style="q2" vid="SNG 6:3">जउन सोसन कर फूल हे अपन गेडरा छेडी चराथै।<verse eid="SNG 6:3" /></para>
  <para style="s">पचमा गीत</para>
  <para style="sp">दुलहा</para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 6:4" />हे मोर परेमी, तै तिर्सा सहर जसना सुंदरी हबै,</para>
  <para style="q2" vid="SNG 6:4">तै यरुसलेम कर जसना सुंदर हबै,</para>
  <para style="q2" vid="SNG 6:4">अउ झन्डा फहिराउत हर सेना कर बरोबर सक्तिसाली हबै।<verse eid="SNG 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 6:5" />अपन आंखी मोर पल्ला लग फेर ले,</para>
  <para style="q2" vid="SNG 6:5">काखे मै ओखर लग घबराथों,</para>
  <para style="q1" vid="SNG 6:5">तोर चूंदी असना छेडिन कर झुंड के जसना हबै,</para>
  <para style="q2" vid="SNG 6:5">जउन गिलाद डोंगर उतारू हे लेटे हर देख पडथै।<verse eid="SNG 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 6:6" />तोर दांत उन गेडरा कर जसना हबै,</para>
  <para style="q2" vid="SNG 6:6">जउन नहायके पानी लग बाहिर आय हबै,</para>
  <para style="q1" vid="SNG 6:6">जिनखर जोडधा लरका हबै,</para>
  <para style="q2" vid="SNG 6:6">उनखर मसे कउनो कर जोडधा नेहको मरे हबै।<verse eid="SNG 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 6:7" />तोर चूंदी कर तरी तोर गाल असना हबै जसना अनार कर दुइठे खंडा होय।<verse eid="SNG 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 6:8" />उहां साठ रानी, अस्सी रखेल</para>
  <para style="q2" vid="SNG 6:8">अउ नबा अनगिनत कुंवारी टोरिया हबै।<verse eid="SNG 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 6:9" />पय मोर परेवा, मोर निरमल,</para>
  <para style="q2" vid="SNG 6:9">उनखर मसे अकलउती टोरिया हबो,</para>
  <para style="q1" vid="SNG 6:9">जउन दाय उके पइदा करिस,</para>
  <para style="q2" vid="SNG 6:9">ऊ उस दाय कर पिरिया हबै,</para>
  <para style="q1" vid="SNG 6:9">टोरिया उके देखिस अउ उके सराहिस,</para>
  <para style="q2" vid="SNG 6:9">रानी अउ रखेल देखके ओखर बडाई करे रथै।<verse eid="SNG 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 6:10" />हइ कउन हबै, जेखर सोभा सुबन्ने कर जसना हबै,</para>
  <para style="q1" vid="SNG 6:10">जउन सुन्दर हे जोंधइया, अउ झन्डा फेहराउत ऊ टोरिया कोन हबै ऊ बिहान्ने कर जसना चमकथै, ऊ जोंधइया जसना सुंदर हबै,</para>
  <para style="q2" vid="SNG 6:10">ऊ एतका सक्तिसाली हबै जेतका बेरा, ऊ असना अदभुत हबै जसना बादर हे सिपाही।<verse eid="SNG 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 6:11" />मै बदाम कर बगिया हुइके उतर गयों,</para>
  <para style="q2" vid="SNG 6:11">कि मइदान कर फूल देखों,</para>
  <para style="q2" vid="SNG 6:11">अउ देखों कि डगाइल हे कलियां लगिस,</para>
  <para style="q2" vid="SNG 6:11">अउ अनारन के फूल खिलिस कि नेहको।<verse eid="SNG 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 6:12" />मोके पतो नेहको चलिस, कि मोर इक्छा मोर राजा कर रथ हे चढाय दइस।<verse eid="SNG 6:12" /></para>
  <para style="sp">सखी</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 6:13" />लउट आ, लउट आ, हे सूलेम्मिन टोरिया, लउट आ,</para>
  <para style="q2" vid="SNG 6:13">लउट आ, ताकि हम तोके देख सकि।</para>
  <para style="sp" vid="SNG 6:13">दुलही</para>
  <para style="q1" vid="SNG 6:13">का असना सूलेम्मिन टोरिया के हइ मेर देखिहा,</para>
  <para style="q2" vid="SNG 6:13">जसना कउनो दुइठे समूह कर नाच हबै?<verse eid="SNG 6:13" /></para>
  <chapter eid="SNG 6" />
  <chapter number="7" style="c" sid="SNG 7" />
  <para style="sp">दुलहा</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 7:1" />हे राजकुमारी, चफ्फल पहिने हर तोर गोड केतका सुंदर दिखथै,</para>
  <para style="q2" vid="SNG 7:1">तोर जांघन के गोलाई निपुन अगरिया के हाथ बनाय गय के जसना हबस।<verse eid="SNG 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 7:2" />तोर बोडरी सुन्दर खोरिया जसना हबै,</para>
  <para style="q2" vid="SNG 7:2">ऊ हरमेसा सहद लग हरमेसा भररे हर रथै।</para>
  <para style="q1" vid="SNG 7:2">तोर लादा गोंहू बोझवा कर ढेर कर जसना हबै,</para>
  <para style="q2" vid="SNG 7:2">जेखर चारो पार सोसन कर फूल होय।<verse eid="SNG 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 7:3" />तोर दुनो छातिन माना</para>
  <para style="q2" vid="SNG 7:3">छिगरी के दुइठे जोडधा लरका कर जसना हबै।<verse eid="SNG 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 7:4" />तोर नटेरी हाथीदांत के मीनार हबै,</para>
  <para style="q1" vid="SNG 7:4">तोर आंखी हेसबोन सहर के उन कुंडन कर जसना हबै,</para>
  <para style="q2" vid="SNG 7:4">जउन बतरब्बीम के फेरका कर लिघ्घो हबै,</para>
  <para style="q1" vid="SNG 7:4">तोर नाक अति सुन्दर लबानोन डोंगर के ऊंच मीनार के बरोबर हबै,</para>
  <para style="q2" vid="SNG 7:4">जेखर थुथना दमिस्क के पल्ला हबै।<note caller="+" style="f"><char style="fr" closed="false">7:4 </char><char style="ft" closed="false">हइ सम्भव सुलेमान राजा कर दवारा बनाय हाथीदांत कर मीनार रथै जेखर बरोबरी करे जथै।</char></note><verse eid="SNG 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 7:5" />तोर जीव हे करमेल डोंगर के मेर, तोर मूंड सोभा देथै,</para>
  <para style="q1" vid="SNG 7:5">तोर लहलहात लटा माना बैजनी परदा हबै,</para>
  <para style="q2" vid="SNG 7:5">इनके लटा हे राजा कैद हुइ गइस।<verse eid="SNG 7:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 7:6" />हे परेमी अउ मनमोहनी कुंवारी,</para>
  <para style="q2" vid="SNG 7:6">तै केतका सुंदर अउ केतका मनोहर हबै।<verse eid="SNG 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 7:7" />तोर ऊंचाई खजूर रूख जसना ऊंच हबै</para>
  <para style="q2" vid="SNG 7:7">अउ अंगूर कर गुच्छन के जइसन तोर छाती हबै।<verse eid="SNG 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 7:8" />मै सोचे हव, मै ई खजूर रूख हे चढिहों,</para>
  <para style="q2" vid="SNG 7:8">अउ ओखर डगाइल पकडिहों, हे परेमी,</para>
  <para style="q1" vid="SNG 7:8">अंगूर के गुच्छन के जसना लुभावना बने रहै,</para>
  <para style="q2" vid="SNG 7:8">अउ तोर सांस सेबन के जसना महकत रहै।<verse eid="SNG 7:8" /></para>
  <para style="q2">
    <verse number="9" style="v" sid="SNG 7:9" />अउ तोर चुम्मा निक्खा मधु कर जसना हबै,</para>
  <para style="sp" vid="SNG 7:9">दुलही</para>
  <para style="q2" vid="SNG 7:9">हइ सरलता लग बिबडा हे धीरे-धीरे बहि जथै।<verse eid="SNG 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 7:10" />मै अपन परेमी कर हव, अउ मोर इक्छा मोर पल्ला हरमेसा बने रथै।<verse eid="SNG 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 7:11" />हे मोर परेमी, आ, हम खेतन हे निकड जइ</para>
  <para style="q2" vid="SNG 7:11">अउ गांवन हे रात गुजारी।<verse eid="SNG 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 7:12" />हम बोहत हरबी उठी अउ अंगूर कर बगियन हे निकड जाय,</para>
  <para style="q2" vid="SNG 7:12">आ, हम उहां देखी कि अंगूर कर बेलन हे फूल खिलथै,</para>
  <para style="q2" vid="SNG 7:12">आ, हम देखी कि अंगूर फूल गय हबै,</para>
  <para style="q2" vid="SNG 7:12">उछो मै अपन माया तोके दिखाहुं।<verse eid="SNG 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 7:13" />दोदाफल<note caller="+" style="f"><char style="fr" closed="false">7:13 </char><char style="ft" closed="false">फूल कर गुरतुर खुसबू</char></note> लग खुसबू आथै,</para>
  <para style="q2" vid="SNG 7:13">अउ हमर दवारा सगलू मेर के निक्खा फडुहा हबै,</para>
  <para style="q1" vid="SNG 7:13">नबा अउ पुरान जउन, हे मोर परेमी,</para>
  <para style="q2" vid="SNG 7:13">मै तोर निता अकजुट कर रखे हव।<verse eid="SNG 7:13" /></para>
  <chapter eid="SNG 7" />
  <chapter number="8" style="c" sid="SNG 8" />
  <para style="q1">
    <verse number="1" style="v" sid="SNG 8:1" />अगर तै मोर भाई होत,</para>
  <para style="q2" vid="SNG 8:1">अउ तै मोर खुद के परवार कर अक मनसे होते,</para>
  <para style="q1" vid="SNG 8:1">ता मै तोके बाहिर चुम्मा दइ सकथो,</para>
  <para style="q2" vid="SNG 8:1">अउ कउ मोके दोसी नेहको ठहरातिन।<verse eid="SNG 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 8:2" />मै तोके अपन दाय के घर लइ जातों,</para>
  <para style="q2" vid="SNG 8:2">अपन दाय के कोठा हे लइतों,</para>
  <para style="q1" vid="SNG 8:2">मै तोके पीय के मसाला मिलाय के अंगूर कर रस</para>
  <para style="q2" vid="SNG 8:2">अउ अपन अनारन के रस पिलातों।<note caller="+" style="x"><char style="xo" closed="false">8:2 </char><char style="xt" closed="false"><ref loc="PRO 9:2">नीति 9:2</ref></char></note><verse eid="SNG 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 8:3" />कास, तोर टेटरा हाथ मोर मूंड के तरी रहितै,</para>
  <para style="q2" vid="SNG 8:3">अउ तै अपन दहिना हाथ लग मोके सहलाथै।<verse eid="SNG 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 8:4" />हे यरुसलेम कर टोरिया, मै तुमके किरिया धराउथों,</para>
  <para style="q2" vid="SNG 8:4">कि तुम मोर परेमी के झइ जगइहा जब तक ऊ खुद नेहको उठै चाहै।<verse eid="SNG 8:4" /></para>
  <para style="s">छठमा गाना</para>
  <para style="sp">सखी</para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 8:5" />हइ कोन आय जउन अपन परेमी हे टेक लगाय हर</para>
  <para style="q2" vid="SNG 8:5">बंजर भुंइ छो कढ आथै?</para>
  <para style="sp" vid="SNG 8:5">दुलही</para>
  <para style="q1" vid="SNG 8:5">सेब कर रूख कर तरी मै तोके जगायों,</para>
  <para style="q2" vid="SNG 8:5">उहां तोर दाय तोके पइदा करिस, उहां तोर दाय के पीरा उठिस।<verse eid="SNG 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 8:6" />मोके गहना कर जसना अपन हिरदय हे लगाय रख</para>
  <para style="q2" vid="SNG 8:6">अउ ताबीज कर जसना अपन बांह हे रख,</para>
  <para style="q1" vid="SNG 8:6">काखे माया मिरतू कर बरोबरी सक्ति हबै,</para>
  <para style="q2" vid="SNG 8:6">अउ डाह मरघटी कर जसना बेरहम हबै,</para>
  <para style="q1" vid="SNG 8:6">ओखर उजियार धंधकत आगी हबै</para>
  <para style="q2" vid="SNG 8:6">पय भगवान कर उजियार हबै।<verse eid="SNG 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 8:7" />माया कर आगी पानी नेहको बुझाय सकथै,</para>
  <para style="q2" vid="SNG 8:7">माया के बाढ नेहको बहाय सकथै,</para>
  <para style="q1" vid="SNG 8:7">अगर कउनो मनसे माया के घर के सगलू दइ डारै</para>
  <para style="q2" vid="SNG 8:7">ता ओखर कउनो बुराई नेहको करहिन।<verse eid="SNG 8:7" /></para>
  <para style="sp">दुलही कर भाई</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 8:8" />हमर अक्ठी नान बेहन हबै,</para>
  <para style="q2" vid="SNG 8:8">जेखर छाती अबे नेहको बढे हबै,</para>
  <para style="q1" vid="SNG 8:8">जउन रोज हमर बेहन के काज कर बात लगी,</para>
  <para style="q2" vid="SNG 8:8">ऊ रोज हम ओखर निता काहिन करी?<verse eid="SNG 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 8:9" />अगर ऊ सहर होतै</para>
  <para style="q2" vid="SNG 8:9">ता हम ओखर हे चांदी कर मीनार बनातन,</para>
  <para style="q1" vid="SNG 8:9">अउ अगर ऊ दूरा होतै</para>
  <para style="q2" vid="SNG 8:9">ता हम ओखर हे देवदार रूख कर लकडी के पटिया लगउतन।<verse eid="SNG 8:9" /></para>
  <para style="sp">दुलही</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 8:10" />मै सहरपनाह दीबार रथो</para>
  <para style="q2" vid="SNG 8:10">अउ मोर छाती ओखर मीनार कर जसना हबै,</para>
  <para style="q1" vid="SNG 8:10">तब मै अपन परेमी कर नजर हे</para>
  <para style="q2" vid="SNG 8:10">सान्ति लामैबाले कर जसना रथो।<note caller="+" style="x"><char style="xo" closed="false">8:10 </char><char style="xt" closed="false"><ref loc="EZK 16:7">यहेज 16:7</ref>; <ref loc="1KI 4:25">1 राजा 4:25</ref></char></note><verse eid="SNG 8:10" /></para>
  <para style="sp">दुलहा</para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 8:11" />बाल्हामोन सहर हे राजा सुलेमान कर</para>
  <para style="q2" vid="SNG 8:11">अक्ठी अंगूर के बगिया रथै,</para>
  <para style="q1" vid="SNG 8:11">ऊ अंगूर कर बगिया के किसानन के ठेका हे दइ देथै,</para>
  <para style="q2" vid="SNG 8:11">हर अक किसान ओखर फडुहा कर निता चांदी के अक हजार खोटन्ना देथै।<verse eid="SNG 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 8:12" />मोर खुद के अंगूर कर बगिया मोर निता हबै,</para>
  <para style="q2" vid="SNG 8:12">हे सुलेमान हजार खोटन्ना लइ ले, तोहिन के</para>
  <para style="q1" vid="SNG 8:12">अउ फडुहा तकइया किसानन के दुइ सव मिलै।<verse eid="SNG 8:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 8:13" />तै जउन बगिया हे रथस,</para>
  <para style="q2" vid="SNG 8:13">मोर साथी तोर आरो सुनै चाहथै उके मोके सुनै दे।<verse eid="SNG 8:13" /></para>
  <para style="sp">दुलही</para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 8:14" />हे मोर परेमी, तै अब हरबी कर,</para>
  <para style="q2" vid="SNG 8:14">महकै बाले के डोंगर हे तै अब छिगरी या सग्यान छिगरी के जसना बन जा।<verse eid="SNG 8:14" /></para>
  <chapter eid="SNG 8" />
</usx>