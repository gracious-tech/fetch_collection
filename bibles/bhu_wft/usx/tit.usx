<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="TIT" style="id">- Bhumiya Standard Project</book>
  <para style="h">तीतुस</para>
  <para style="toc3">तीतुस</para>
  <para style="toc2">तीतुस</para>
  <para style="toc1">तीतुस के निता पोलुस कर चिट्ठी</para>
  <para style="mt2">तीतुस के लिए पौलुस की चिट्ठी</para>
  <para style="mt1">तीतुस के निता पोलुस कर चिट्ठी</para>
  <para style="imt">परचा</para>
  <para style="ip">तीतुस के किताब पोलुस के चारठे चिट्ठी मसे अक्ठी हबै, जउन अक्ठी मंडली के बजाय अक्ठी मनसे के संबोधित करे जथै, अउ तीन चिट्ठी 1 तीमुथियुस, 2 तीमुथियुस अउ फिलेमोन हबै, पोलुस तीतुस के लिखथै, पय उन इहो लिखे रथै, कि चिट्ठी के मनसे के बीच हे जोर लग पढे जा सकथै, हइ हम जान सकथन, काखे ऊ अपन काबिल के अक्ठी चेला के रूप हे गुठेथै, कुछ असना जउन तीतुस के पहिलेन लग पता होही, पोलुस करीबन यीसु के जनम के 63-65 साल के बीच हइ चिट्ठी लिखे रथै।</para>
  <para style="ip">पोलुस तीतुस के क्रेते के दीप हे मंडली के काम करै काहिन निरदेस दय रथै, हइ चिट्ठी इहैनिता लिखिस ताकि तीतुस मंडली के सिक्छा अउ चुने हर अगुवन के निरदेस दे, ऊ अपन चिट्ठी हे इहै मेर निरदेस तीमुथियुस के दइस, उनखर चिट्ठी हे बताय गय हबै कि मंडली के नेतन के अक्ठी ऊंच गद्दी हे कइसन रखै जाय चाही, मंडलीन अउ मंडली के नेता के आज के काम हे जरूरी जिघा हे धियान दय चाही।</para>
  <para style="iot">रूप रेखा</para>
  <para style="io1">1. पोलुस तीतुस के धरमी नेता के नियुक्त करै काहिन निरदेस दइस। <char style="ior"><ref loc="TIT 1:1-16">1:1-16</ref></char></para>
  <para style="io1">2. फेर ऊ उन मनसेन के भगवान के जीवन जीय के निता सिक्छा दे काहिन निरदेस दइस। <char style="ior"><ref loc="TIT 2:1-3:11">2:1—3:11</ref></char></para>
  <para style="io1">3. आखरी हे, पोलुस अपन कुछ योजना के सामिल करके अउ सुभकामना पठोय के समापत करथै। <char style="ior"><ref loc="TIT 3:12-15">3:12-15</ref></char></para>
  <chapter number="1" style="c" sid="TIT 1"/>
  <para style="s">सोगत</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 1:1"/>हइ चिट्ठी, पोलुस के पल्ला जउन भगवान के हरवाह अउ यीसु मसीह के चेला हबै, मोके चुने गइस अउ भगवान के चुने हर मनसेन के बिस्वास के मदद करके अउ हमर धरमी काम के दवारा सिखाय गय सही के पल्ला जाय के निता पठोय गइस। <verse eid="TIT 1:1"/><verse number="2" style="v" sid="TIT 1:2"/>मै इहैनिता असना करथो कि भगवान के चुने हर मनसेन के सबरोज के जीवन के आसा मिलै, भगवान जउन कबहुन झूठ नेहको बोलथै, सुरू लग सबरोज के टीमा करे हबै। <verse eid="TIT 1:2"/><verse number="3" style="v" sid="TIT 1:3"/>पय अच्छी टेम हे अपन बचन के ऊ परचार के दवारा परगट करिस, जउन हमर मुकति करै बाले भगवान के आदेस के जसना मोके सउपे गइस।<verse eid="TIT 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="TIT 1:4"/>हमर सबरोज बिस्वास करे बाले के सहभागी के मोर सही टोरवा तीतुस, भगवान बाफ अउ हमर मुकति करै बाले मसीह यीसु के पल्ला लग तोके अनुगरह किरपा अउ सान्ति मिलत रहै।<verse eid="TIT 1:4"/></para>
  <para style="s">क्रेते सहर हे तीतुस कर काम</para>
  <para style="p">
    <verse number="5" style="v" sid="TIT 1:5"/>मै इहैनिता तोके क्रेते हे छांड आय रथो कि तै बचे हर बातन के सुधार, अउ मोर आदेस के जसना सहर-सहर सियानन के नियुक्त करै। <verse eid="TIT 1:5"/><verse number="6" style="v" sid="TIT 1:6"/>उनके नियुक्त तबय करै जाय जब उन बेकसूर होय अउ अक्ठी डउकी के डउका होय, जेखर लरका बिस्वास करै बाले होय, अउ उन हे अनुसासन के दोस झइ लगाय सकै अउ निरंकुस के दोस झइ होय। <verse eid="TIT 1:6"/><verse number="7" style="v" sid="TIT 1:7"/>काखे मुखिया के भगवान के भन्डारी होमै के कारन बेकसूर होमै चाही, न हठ्ठी करै बाले, न गुस्सा, न दरुहा, न लडाई करै बाले, अउ न गलत कमाई के लालची होय, <verse eid="TIT 1:7"/><verse number="8" style="v" sid="TIT 1:8"/>पय पोहनाई करै बाले, भलाई चाहै बाले, दया, धरमी मनसे, पवितर अउ अनुसासन हे रहै बाले होय, <verse eid="TIT 1:8"/><verse number="9" style="v" sid="TIT 1:9"/>उके बचन हे बिस्वास हे बने रहै चाही, जसना उके सिक्छा दय गय रहिस, ताकि मनसे के सही सिक्छा दइके उनही सिखाय सकै, अउ बचन के बिरोध हे बहस करै बाले के बिस्वास देबाय सकै।<verse eid="TIT 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="TIT 1:10"/>काखे बोहत मनसेन निरंकुस, बक-बक करै बाले अउ नरै बाले हबै, खास करके खतना<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="ft" closed="false">सुध्दिकरन करै के निता</char></note> बाले यहूदी। <verse eid="TIT 1:10"/><verse number="11" style="v" sid="TIT 1:11"/>असना मनसेन के मुंह बन्द के दे चाही, हइ मनसेन अपन फायदा के निता ऊ सगलू सिखाथै, अउ हइ मेर लग घर के घर बरबाद हुइ जथै। <verse eid="TIT 1:11"/><verse number="12" style="v" sid="TIT 1:12"/>उनखरै मसे अक्ठी झन ग्यानी मनसे कथै, “क्रेती टापू हे रहै बाले मनसे हरमेसा झूठ, दुस्ट पसु अउ आलसी अउ लदहा होथै।” <verse eid="TIT 1:12"/><verse number="13" style="v" sid="TIT 1:13"/>हइ बात सही गवाह हबै, इहैनिता उनके खराई लग डांटा, ताकि ऊ बिस्वास हे मजबूत हुइ जाय, <verse eid="TIT 1:13"/><verse number="14" style="v" sid="TIT 1:14"/>अउ यहूदियन के कथा किस्सा अउ उन मनसेन के आदेस हे मन झइ लगामै, जउन सही लग भटक चुके हमै। <verse eid="TIT 1:14"/><verse number="15" style="v" sid="TIT 1:15"/>जउन मनसेन सुध्द हबै, उनखर निता सगलू कुछु सुध्द हबै, पय जउन असुध्द अउ अबिस्वासी हबै, उनखर निता कुछु सुध्द नेहको, उनखर मन अउ सोच दोनो असुध्द हबै। <verse eid="TIT 1:15"/><verse number="16" style="v" sid="TIT 1:16"/>उन तो मुंह लग भगवान के जानै के दाबा करथै, पय अपन कामन लग ओही मना करथै, काखे ऊ सरापित अउ आदेस न मानै बाले हबै, अउ कउनो निक्खा काम के काबिल नेहको।<verse eid="TIT 1:16"/></para>
  <chapter eid="TIT 1"/>
  <chapter number="2" style="c" sid="TIT 2"/>
  <para style="s">अच्छी सिधान्त के सिक्छा</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 2:1"/>पय जउन बात सही सिक्छा के जसना हबै, तुम उहै के कहे करिहा। <verse eid="TIT 2:1"/><verse number="2" style="v" sid="TIT 2:2"/>सियान मनसेन के गंभीर अउ ईज्जत लग संयमी, बिस्वास अउ माया , धीर हे पक्का होय चाही। <verse eid="TIT 2:2"/><verse number="3" style="v" sid="TIT 2:3"/>उहै मेर सियान डउकी के आदत पवितर मनसेन लग होय, ऊ दोस लगामै बाले गुलाम बनामै बाले अउ दरुहा झइ होय, पय निक्खा बात सिखामै बाले होय, <verse eid="TIT 2:3"/><verse number="4" style="v" sid="TIT 2:4"/>ताकि उन जबान डउकिन के सिखामै कि अपन डउकन अउ लरकन लग माया करै बाले होय, <verse eid="TIT 2:4"/><verse number="5" style="v" sid="TIT 2:5"/>अउ संयमी, पवितर घर के कारोबार करै बाले, निक्खा अउ अपन-अपन डउका के बात के मानै बाले होय, ताकि भगवान के बचन के बुराई झइ होय।<verse eid="TIT 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="TIT 2:6"/>ओसनेन जबान मनसेन के समझामै के संयमी होय। <verse eid="TIT 2:6"/><verse number="7" style="v" sid="TIT 2:7"/>सगलू बातन हे खुद के निक्खा कामन के उदाहरन बना। सिक्छा हे इमानदारी, गंभीर, पवितर, <verse eid="TIT 2:7"/><verse number="8" style="v" sid="TIT 2:8"/>अउ सही बोल चाल होय, जेही कउ गलत झइ कहि सकै, ताकि तुम्हर बैरी सरमिन्दा होय, अउ तुम्हर पल्ला कहै के निता उनखर लिघ्घो कुछु सब्द झइ होय।<verse eid="TIT 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="TIT 2:9"/>हरवाह के समझा कि अपन-अपन मालिक के वस हे रहै, अउ सगलू बातन हे उनही खुस रखै, अउ बात के उलटा जबाब झइ दे, <verse eid="TIT 2:9"/><verse number="10" style="v" sid="TIT 2:10"/>चोरी झइ करै, पय बिस्वास के काबिल होय, ताकि हमर भगवान अउ मुकति करै बाले के सिक्छा के सान बढै।<verse eid="TIT 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="TIT 2:11"/>भगवान के अनुगरह किरपा लग सगलू मनसेन के मुकति के निता परगट हुइ गय हबै, <verse eid="TIT 2:11"/><verse number="12" style="v" sid="TIT 2:12"/>अउ हमही सिखाथै, कि हम दुस्टता अउ दुनिया के अभिलासा के छांडके गंभीर लग, खराई अउ भगवान के आदत के संग हइ पीढी हे जी। <verse eid="TIT 2:12"/><verse number="13" style="v" sid="TIT 2:13"/>अउ धन्य आसा मतलब भगवान अउ मुकति करै बाले यीसु मसीह जब दुबारा आही, अपन महिमा के संग ओही ओरगत रही <verse eid="TIT 2:13"/><verse number="14" style="v" sid="TIT 2:14"/>जउन खुद के हमर निता दय दइस, ताकि हमके सबैमेर के अधरम लग छंडाइस, अउ सुध्द करके अपन निता खास मनसेन के तइयार करै, जउन निक्खा काम करै के निता तइयार होय।<verse eid="TIT 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 2:15"/>हइ बातन के सिखाय करा, हिम्मत बढाबा, अउ पूर हक के संग डांटा अउ कउ तुमके बेकार झइ जान पामै।<verse eid="TIT 2:15"/></para>
  <chapter eid="TIT 2"/>
  <chapter number="3" style="c" sid="TIT 3"/>
  <para style="s">निक्खा काम करत रइहा</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 3:1"/>मनसेन के सुरता देबाबा कि राज करै बाले अउ सासक के वस हे रहै, अउ उनखर आदेस के मानै, अउ हर अकझन निक्खा काम करै के निता तइयार रहै, <verse eid="TIT 3:1"/><verse number="2" style="v" sid="TIT 3:2"/>कउनो के बुराई झइ करै, झगडा करै बाले झइ होय, पय कोमर आदत के होय अउ सगलू मनसेन के आगू बडा नमरता के संग आय, <verse eid="TIT 3:2"/><verse number="3" style="v" sid="TIT 3:3"/>हइ मै इहैनिता गुठेथो, काखे हमु पहिले मूरुख रहन, अउ आदेस न मानै बाले अउ भरम हे पडे हर अउ बोहत मेर के लालच अउ सुखबिलास हे फसे रहन, अउ छुवाछुत, अउ जलन करै हे जीवन जियत रहन, अउ घिनहा रहन, अउ अक दूसर लग इसात रहन। <verse eid="TIT 3:3"/><verse number="4" style="v" sid="TIT 3:4"/>पय जब हमर मुकति करै बाले भगवान के दया अउ मनसेन हे ओखर माया परगट हुइस, <verse eid="TIT 3:4"/><verse number="5" style="v" sid="TIT 3:5"/>ता भगवान हमर मुकति करिस, अउ हइ धरम के कामन के कारन नेहको, जउन हम खुद करन, पय अपन दया के जसना नवा जनम अउ नबा जीवन अउ पवितर आतमा के दवारा नबा बनाय जथन। <verse eid="TIT 3:5"/><verse number="6" style="v" sid="TIT 3:6"/>भगवान हमर उप्पर पवितर आतमा के हमर मुकति करै बाले यीसु मसीह के दवारा भरपूर लग उलदिस <verse eid="TIT 3:6"/><verse number="7" style="v" sid="TIT 3:7"/>अब भगवान हमके अपन अनुगरह किरपा लग धरमी ठहराइस ताकि जेखर हम आसा करत रहन, ऊ सबरोज के जीवन के आसा के पाय सकि। <verse eid="TIT 3:7"/><verse number="8" style="v" sid="TIT 3:8"/>हइ बात सही हबै, अउ मै चाहथो, कि तै हइ बातन के बारे हे हिम्मत लग बोल इहैनिता कि जिनही भगवान हे बिस्वास करे हबै, उन निक्खा-निक्खा कामन हे लगे रहै, हइ बात निक्खा हबै अउ मनसेन के निता फायदा हबै। <verse eid="TIT 3:8"/><verse number="9" style="v" sid="TIT 3:9"/>पय मूरुख के झगडा, अउ पुरखन अउ बिरोध अउ लडाइयन लग जउन बेवस्था के बारे हे होय ऊ बचे रहै, काखे ऊ आधा अउ बेकार हबै। <verse eid="TIT 3:9"/><verse number="10" style="v" sid="TIT 3:10"/>असना मनसे लग दुरिहां रहा, जउन अक दुइ बेर मना करै जाय बाद उहै काम करै। <verse eid="TIT 3:10"/><verse number="11" style="v" sid="TIT 3:11"/>हइ जानके कि असना मनसे रास्ता लग भटक गय हबै अउ खुद के दोसी मानके पाप करत रथै।<verse eid="TIT 3:11"/></para>
  <para style="s">व्यक्तिगत सलाह अउ नमस्ते</para>
  <para style="p">
    <verse number="12" style="v" sid="TIT 3:12"/>जब मै तोर लिघ्घो अरतिमास या तुखिकुस के पठोहूं ता मोर लिघ्घो निकुपुलिस सहर के आमै काहिन परयास करबे, काखे मै उहै जाड काटैके ठान लय हव। <verse eid="TIT 3:12"/><verse number="13" style="v" sid="TIT 3:13"/>जेनास गुरू अउ अपुल्लोस के उनखर यातरा हे हरबी पठोबा, ताकि उनके कउनो चीज के घाटा झइ होय <verse eid="TIT 3:13"/><verse number="14" style="v" sid="TIT 3:14"/>हमर मनसेन के सिखै चाही कि निक्खा कामन हे लगे रहै, ताकि जरुरत के पूर करै के निता निक्खा कामन हे लगे रहै के सिखै, ताकि उनखर जीवन ढिलवा झइ होय।<verse eid="TIT 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 3:15"/>मोर सब संगिन के तुमके नमस्ते। जउन बिस्वास के कारन हमर लग माया रखथै, उनके नमस्ते।</para>
  <para style="p" vid="TIT 3:15">भगवान के अनुगरह किरपा तुम सबके उप्पर होवत रहै।<verse eid="TIT 3:15"/></para>
  <chapter eid="TIT 3"/>
</usx>
