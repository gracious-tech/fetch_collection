<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="GAL" style="id">- Bhumiya Stantard Project</book>
  <para style="h">गलातियों</para>
  <para style="toc3">गलातियों</para>
  <para style="toc2">गलातियों</para>
  <para style="toc1">गलातियों के निता पोलुस कर चिट्ठी</para>
  <para style="mt2">गलातियों के लिए पौलुस की चिट्ठी</para>
  <para style="mt1">गलातियों के निता पोलुस कर चिट्ठी</para>
  <para style="imt">परचा</para>
  <para style="ip">गलातियों के किताब प्रेरित पोलुस <char style="xt"><ref loc="GAL 1:1">1:1</ref></char> दवारा लिखे गय रथै, हइ अक्ठी चिट्ठी रथै, जेही पोलुस गलातियों के मंडलिन के मसीह के पइदा 48-57 साल के बीच कोनो टेम लिखे रथै, गलातिया सायद रोमन परदेस गलातिया हे रहै बाले मनसे रथै। बिदमानन के बिस्वास नेहको हबै, कि जब पोलुस चिट्ठी लिखे रथै, ता ऊ कछो रथै, पय इफिसुस अउ कुरिन्थुस के सहर दुइठे संभावित जिघा हबै।</para>
  <para style="ip">पोलुस गलातिया के मंडलिन हे, यहूदी अउ गैर यहूदी दुनो मसीहिन के सम्बोधित करै के निता लिखथै, ऊ खास करके अक्ठी झूठी सिक्छा के जसना करै के निता लिखे रथै, जेहमा कहे रथै कि मसीहिन के पुरान नियम के यहूदी कनून के मानै के जरूरी हबै, खास रूप लग सुध्दिकरन। मसीहिन के बीच यहूदी नामक मनसेन के अक्ठी समूह रथै, जेही गैर यहूदी मसीहिन के सुध्दिकरन करामै के जरूरी रथै। जउन पोलुस के प्रेरित हक हे सबाल उठाथै पोलुस अपन कुछ किस्सा <char style="xt"><ref loc="GAL 1:11-2:14">1:11—2:14</ref></char> गुठेके अपन प्रेरित के बचाव करथै, कि मुकति सिबाय यीसु मसीह <char style="xt"><ref loc="GAL 2:16">2:16</ref></char> हे बिस्वास के दवारा मिलथै, हइ ऊ दयालु के परिनाम हबै जउन भगवान दिखाथै न कि मनसे जउन करथै।</para>
  <para style="iot">रूप रेखा</para>
  <para style="io1">1. पोलुस अपन चिट्ठी के सुरुवात गलातिया के मंडलिन के नमस्ते लग करथै। <char style="ior"><ref loc="GAL 1:1-5">1:1-5</ref> </char></para>
  <para style="io1">2. ता पोलुस अपन खुद के कुछ परचा के ब्याख्या करै के अपन हक के रक्छा करै के निता अउ हइ दिखामै के निता ऊ नियम के जसना जीय के परयास करथै, पय ऊ काम नेहको करथै। <char style="ior"><ref loc="GAL 1:6-2:21">1:6—2:21</ref></char></para>
  <para style="io1">3. आगू ऊ मुकति हे नियम अउ अनुगरह के भूमिका के आगू गुठेथै। <char style="ior"><ref loc="GAL 3-4">3—4</ref> </char></para>
  <para style="io1">4. फेर ऊ निक्खा मसीही जीवन के निता कुछ समान्य आदेस देथै। <char style="ior"><ref loc="GAL 5:1-6:10">5:1—6:10</ref></char></para>
  <para style="io1">5. पोलुस अपन चिट्ठी के अक्ठी नमस्ते अउ आखरी बिनती के संग हइ सुरता रखै के निता खतम करथै, कि भगवान दवारा अक्ठी नबा मनसे हे बदलै जाय बाहरी नियम लग कहुं जादा खास हबै जसना कि सुध्दिकरन करे जायके। <char style="ior"><ref loc="GAL 6:11-18">6:11-18</ref> </char></para>
  <chapter number="1" style="c" sid="GAL 1"/>
  <para style="s">सोगत</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 1:1"/>हइ चिट्ठी पोलुस के पार लग हबै, जउन अक्ठी चेला हबै, जउन न कउनो मनसेन के पार लग अउ न मनसे के दवारा, बलुक खुदय यीसु मसीह अउ भगवान बाफ मोके चेला ठहराय हबै, जउन यीसु के मरे हर मसे फेरै जिन्दा करिस। <verse eid="GAL 1:1"/><verse number="2" style="v" sid="GAL 1:2"/>मै अउ जेतका भाई बेहन मोर संग हबै, गलातिया परदेस के मंडली के सोगत करथन।<verse eid="GAL 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GAL 1:3"/>हमर बाफ भगवान अउ परभु यीसु मसीह तुमही अनुगरह अउ सान्ति दे।<verse eid="GAL 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GAL 1:4"/>मसीह हमर पापन के खातिर अपन खुद के दइ दइस, जेखर लग ऊ हमर बाफ भगवान के इक्छा के जसना हमके बरतमान पापमय युग दुनिया लग हमके छडाबै। <verse eid="GAL 1:4"/><verse number="5" style="v" sid="GAL 1:5"/>ओखर महिमा अउ बडाई सबरोज होवत रहै। ओसनेन होय।<verse eid="GAL 1:5"/></para>
  <para style="s">अउ कउनो दूसर संदेस नेहको</para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 1:6"/>मोके चकित होथै, कि एतका हरबी तुम यीसु मसीह लग जउन अपन बडे अनुगरह किरपा लग तुमके मुकति दय रथै, तुम मनसेन दूसर के संदेस के स्वीकारथा। <verse eid="GAL 1:6"/><verse number="7" style="v" sid="GAL 1:7"/>पय ऊ दूसर संदेस नेहको हबै, पय बात ई हबै कि केतका असना हबै जउन तुमके तकलीप देथै अउ मसीह के संदेस के बिगाडै चाहथै। <verse eid="GAL 1:7"/><verse number="8" style="v" sid="GAL 1:8"/>पय अगर हम या स्वरग लग कउ स्वरगदूत ऊ संदेस के छांड कउनो दूसर संदेस सुनामै ता ऊ सापित हबै, <verse eid="GAL 1:8"/><verse number="9" style="v" sid="GAL 1:9"/>जसना हम पहिले कहि चुके हवन, उहै दोहराथो जउन सुभ संदेस तोके मिले हबै, अगर कउ ओखर ले अलगे सुभ संदेस तोके सुनाही ता ऊ सापित हबै।<verse eid="GAL 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 1:10"/>अब मै का मनसेन के मानथो या भगवान के? का मै मनसेन के खुस करै चाहथो? अगर मै अब तक मनसेन के खुस करै चाहथो, ता मै मसीह के हरवाह नेहको होतो।<verse eid="GAL 1:10"/></para>
  <para style="s">मसीह कर सेबा करै बाले बना</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 1:11"/>पिरिया हे भाई, मै तुम मनसेन के बिस्वास देबाउथों, कि जउन संदेस मै सुनाय हव, ऊ कउनो मनसे के दिमाक के उपज नेहको हबै। <verse eid="GAL 1:11"/><verse number="12" style="v" sid="GAL 1:12"/>मै कउनो मनसे के हाथ लग उके न तो ग्रहन करेव अउ न सिखहों बलुक खुदय यीसु मसीह ओही मोर हे परगट करिस।<verse eid="GAL 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 1:13"/>यहूदी समाज हे जउन पहिले मोर चाल चलन रथै, ओखर बारे हे तुम सुन चुके हबा कि मै भगवान के मंडली के बोहत सताउत अउ बरबाद करत रहों। <verse eid="GAL 1:13"/><verse number="14" style="v" sid="GAL 1:14"/>अपन बोहत बेरादरी बालेन लग जउन मोर उमर के रथै, यहूदी समाज हे बोहत आगू रहन अउ अपन परदादन के रीति रिबाज हे बोहत आगू रथो।<verse eid="GAL 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 1:15"/>पय भगवान के जउन मोर दाय के लादा लग मोके ठहराइस अउ अपन अनुगरह लग बुलाइस<note caller="+" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="ISA 49:1-5">यसा 49:1-5</ref>; <ref loc="JER 1:5">इरमि 1:5</ref></char></note>, <verse eid="GAL 1:15"/><verse number="16" style="v" sid="GAL 1:16"/>जब इक्छा हुइस कि मोर हे अपन टोरवा परगट करिस, कि मै गैर यहूदी के ओखर संदेस सुनाई, ऊ टेम हरबी मै कउनो मनसे लग कउनो मेर के सलाह खून लग नेहको लयो। <verse eid="GAL 1:16"/><verse number="17" style="v" sid="GAL 1:17"/>अउ न मै उन मनसेन के लिघ्घो यरुसलेम गयों, जउन मोर लग पहिले चेला बन गय रथै, बलुक मै अरब इलाका के कढ गयों अउ फेर उहां लग दमिस्क लउट आयों। <verse eid="GAL 1:17"/><verse number="18" style="v" sid="GAL 1:18"/>फेर तीन साल के बाद मै पतरस कैफा लग जानकारी पावै के निता यरुसलेम गयों अउ ओखर लिघ्घो पंदरह रोज तक रहों। <verse eid="GAL 1:18"/><verse number="19" style="v" sid="GAL 1:19"/>पय उहां मै परभु के भाई याकूब के छांडके अउ कउनो दूसर चेला लग नेहको मिलो।<verse eid="GAL 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="GAL 1:20"/>जउन बात मै तुमके लिखथो, देखा, भगवान के उपस्थित जानके कथो, कि ऊ झूठ नेहको हबै।<verse eid="GAL 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 1:21"/>एखर बाद मै सीरिया अउ किलिकिया परदेस हे गयों। <verse eid="GAL 1:21"/><verse number="22" style="v" sid="GAL 1:22"/>पय यहूदिया के मंडली जउन मसीह के मानथै, मोके कबहुन नेहको देखे रथै। <verse eid="GAL 1:22"/><verse number="23" style="v" sid="GAL 1:23"/>पय इहै सुनै करत रथै कि जउन हमके पहिले सताय रथै, ऊ अब उहै बिस्वास के संदेस सुनाथै, जउन पहिले नास करै के परयास करथै। <verse eid="GAL 1:23"/><verse number="24" style="v" sid="GAL 1:24"/>अउ मंडली मोर बारे हे भगवान के महिमा करथै।<verse eid="GAL 1:24"/></para>
  <chapter eid="GAL 1"/>
  <chapter number="2" style="c" sid="GAL 2"/>
  <para style="s">सेबा करै बाले के दवारा पोलुस के मानता</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 2:1"/>चउदह साल के बाद मै बरनबास के संग फेरै यरुसलेम छो गयों अउ तीतुस के अपन संग लइ जथो। <verse eid="GAL 2:1"/><verse number="2" style="v" sid="GAL 2:2"/>भगवान के परकासन के जसना उछो गयों, ताकि मै उनखर आगू ऊ संदेस के सुना सको, जेही मै गैर यहूदी के परचार करे रथो, असना मै इज्जतदार मनसेन के संग अकेल्ले हे करे रथो, ताकि मोर मेहनत बेकार झइ होय। <verse eid="GAL 2:2"/><verse number="3" style="v" sid="GAL 2:3"/>पय तीतुस के जउन मोर संग रथै अउ जउन यूनानी हबै, खतना करामै के निता मजबूर नेहको करै गइस। <verse eid="GAL 2:3"/><verse number="4" style="v" sid="GAL 2:4"/>हइ सबाल उन ठगरा भाइन के कारन उठे रथै, जेही मंडली हे गुप्त रूप लग लाय गय रथै, जउन चुप्पेचाप घुस आथै, कि यीसु मसीह ले मिलेहर हमर आजाद के भेद लग अउ हमके गुलाम बनाय ले। <verse eid="GAL 2:4"/><verse number="5" style="v" sid="GAL 2:5"/>उनखर वस हे होमै के अक टेम भरो नेहको माना, काखे उनखर संदेस के सच्चाई तुम्हर हे बने रहै।<verse eid="GAL 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 2:6"/>एखर मोर निता कउनो महत्व नेहको कि उन जउन नामी रथै, पहिले काहिन रथै, भगवान कउनो के पक्छपात नेहको करथै, मोर संदेस हे उन नामी मनसेन के कउनो सहमति नेहको रथै<note caller="+" style="x"><char style="xo" closed="false">2:6 </char><char style="xt" closed="false"><ref loc="2CO 11:5">2 कुरि 11:5</ref>; <ref loc="DEU 10:17">बेवस्थाबिबरन 10:17</ref></char></note>। <verse eid="GAL 2:6"/><verse number="7" style="v" sid="GAL 2:7"/>पय एखर तरफ जब उन देखिस कि जसना सुध्दिकरन खतना करे हर मनसे के निता संदेस के काम पतरस के सउपे गइस, ओसनेन सुध्दिकरन के निता मोके संदेस सुनामै के निता सउपे गय हबै। <verse eid="GAL 2:7"/><verse number="8" style="v" sid="GAL 2:8"/>भगवान के सक्ति के दवारा मोके गैर यहूदी के निता चेला बनाय गय रथै, जसना कि पतरस खतना कराय के यहूदियन के निता चेला बनाय गय रथै। <verse eid="GAL 2:8"/><verse number="9" style="v" sid="GAL 2:9"/>मोके मिले अनुगरह के चिन्ह के याकूब कैफा अउ यूहन्ना जउन मंडली के खम्भा के रूप हे जाने जथै, बरनबास अउ मोर पल्ला सहभागी के दहिना हाथ बढाइस कि हम गैर यहूदी हे अउ उन खतना कराय हर यहूदिन के लिघ्घो जाय। <verse eid="GAL 2:9"/><verse number="10" style="v" sid="GAL 2:10"/>पय ऊ चाहथै कि हम गरीबन के धियान दइ अउ मै उहै करै के निता तइयार रथो।<verse eid="GAL 2:10"/></para>
  <para style="s">अन्ताकिया सहर हे पोलुस दवारा परतस के डांटिस</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 2:11"/>पय जब पतरस कैफा अन्ताकिया छो आथै, ता मै ओखर आगू बिरोध करेव, काखे ऊ दोसी रथै<note caller="+" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="GAL 2:14">गलातियों 2:14</ref></char></note>। <verse eid="GAL 2:11"/><verse number="12" style="v" sid="GAL 2:12"/>इहैनिता कि याकूब के पल्ला लग कुछ मनसेन के आय लग पहिले ऊ गैर यहूदी के संग खाना खाय करथै, पय जब ऊ उहां पहुंचिस ता खतना के नियम के मानै बाले मनसेन के डर लग ऊ खुदय के अलगे के लेथै<note caller="+" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="ACT 10:28">प्रेरितो 10:28</ref>; <ref loc="ACT 11:2-3">11:2-3</ref></char></note>। <verse eid="GAL 2:12"/><verse number="13" style="v" sid="GAL 2:13"/>दूसर यहूदी ओखर संग कपट हे पड जथै, इहां तक कि बरनबास धोखा हे पड जथै। <verse eid="GAL 2:13"/><verse number="14" style="v" sid="GAL 2:14"/>जब मै देखो कि उनखर चाल चलन संदेस के सही तरीका लग नेहको हबै, ता मै सब के आगू कैफा लग हइ कहेव, “जब तै जनम लग यहूदी हुइके, यहूदी के जसना नेहको बलुक तै गैर यहूदी के जसना बेउहार करथस, ता तै गैर यहूदिन के यहूदियन के जसना बेउहार करै के काखे मजबूर करथस?”<verse eid="GAL 2:14"/></para>
  <para style="s">यहूदी अउ गैर यहूदी बिस्वास लग धरमी मनसे ठहरथै</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 2:15"/>सही हे हम जनम लग यहूदी हवन, अउ गैर यहूदिन मसे नेहको, जेही पापी कथै। <verse eid="GAL 2:15"/><verse number="16" style="v" sid="GAL 2:16"/>तउभरमा हम जानथन कि कउनो मनसे के नियम मानै के कारन नेहको, बलुक यीसु मसीह हे बिस्वास के कारन धरमी मनसे ठहराय जथै, हम इहैनिता यीसु मसीह हे बिस्वास करे हबन ताकि हइ बिस्वास के कारन हम धरमी मनसे ठहराय जइ, न कि नियम लग कउनो धरमी मनसे होथै<note caller="+" style="x"><char style="xo" closed="false">2:16 </char><char style="xt" closed="false"><ref loc="ROM 3:20-22">रोमियो 3:20-22</ref>; <ref loc="PHP 3:9">फिलिप्पियन 3:9</ref></char></note>। <verse eid="GAL 2:16"/><verse number="17" style="v" sid="GAL 2:17"/>हम जउन मसीह हे धरमी मनसे ठहरे के चाहथन, अगर खुदय पापी निकरब ता का मसीह पाप के सेबक हबै? कबहुन नेहको। <verse eid="GAL 2:17"/><verse number="18" style="v" sid="GAL 2:18"/>मै जउन कुछु गिरा दयों अगर उहै के फेरै बनाथो, ता खुदय के अपराधी ठहराथो। <verse eid="GAL 2:18"/><verse number="19" style="v" sid="GAL 2:19"/>मै तो नियम के दवारा नियम के निता मसीह के संग क्रूस हे मर गयों, जेखर लग मै भगवान के निता जी सको। <verse eid="GAL 2:19"/><verse number="20" style="v" sid="GAL 2:20"/>मै मसीह के संग क्रूस हे टंगाय गयों, अब मै जिन्दा नेहको रहों, पय मसीह मोर हे जिन्दा हबै अउ मै देह हे अब जउन जिन्दा हव ता केबल ऊ बिस्वास लग जिन्दा हव, जउन भगवान कर टोरवा हे हबै, जउन मोर लग माया करिस अउ मोर निता खुदय के दइ दय हबै। <verse eid="GAL 2:20"/><verse number="21" style="v" sid="GAL 2:21"/>मै भगवान के अनुगरह के बेकार नेहको ठहराथो, काखे अगर नियम के दवारा नियाइपन होथै, ता मसीह के मरैके बेकार होथै।<verse eid="GAL 2:21"/></para>
  <chapter eid="GAL 2"/>
  <chapter number="3" style="c" sid="GAL 3"/>
  <para style="s">बरदान</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 3:1"/>हे मूरुख गलातिन, कोनहर तुमके मोह लय हबै? तुम सही के नेहको माना, यीसु मसीह तुम्हर आंखी के आगू क्रूस हे चढाय गय रहै, <verse eid="GAL 3:1"/><verse number="2" style="v" sid="GAL 3:2"/>मै तोर लग सिबाय हइ जानै चाहथो कि तै पवितर आतमा के नियम के कामन लग या बिस्वास के संदेस के दवारा पाय? <verse eid="GAL 3:2"/><verse number="3" style="v" sid="GAL 3:3"/>तुम एतका मूरुख कइसन हुइ सकथा, तुम भगवान के पवितर आतमा के रीति लग सुरू करके, का अब देह के रीति हे खतम करै के चाहथा<note caller="+" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="GAL 3:5">गलातियों 3:5</ref>; <ref loc="ACT 15:8-10">प्रेरितो 15:8-10</ref></char></note>? <verse eid="GAL 3:3"/><verse number="4" style="v" sid="GAL 3:4"/>का तै एतका दुख बेकार उठाय? पय मोके बिलकुन बेकार नेहको हबै। <verse eid="GAL 3:4"/><verse number="5" style="v" sid="GAL 3:5"/>जउन तुमके पवितर आतमा देथै अउ तुम्हर हे सक्ति के काम करथै, ऊ का नियम के कामन लग या संदेस हे बिस्वास लग असना करथै? <verse eid="GAL 3:5"/><verse number="6" style="v" sid="GAL 3:6"/>जसना कि अब्राहम के बारे हे किताब कथै, “अब्राहम भगवान हे बिस्वास करिस अउ हइ ओखर निता नियाइपन गिनै गइस<note caller="+" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="GEN 15:6">उत्पति 15:6</ref></char></note>।” <verse eid="GAL 3:6"/><verse number="7" style="v" sid="GAL 3:7"/>पय हइ जान लेया कि जउन बिस्वास करथै, उहै अब्राहम के टोरवा हबै। <verse eid="GAL 3:7"/><verse number="8" style="v" sid="GAL 3:8"/>अउ पवितर किताब पहिले लग हइ जानके कि भगवान गैर यहूदी के बिस्वास लग धरमी मनसे ठहराही, आगू लग अब्राहम के हइ संदेस सुनाय दय गय रहै कि “तोर लग सगलू मनसे आसीस पइहिन<note caller="+" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="GEN 12:3">उत्पति 12:3</ref></char></note>।” <verse eid="GAL 3:8"/><verse number="9" style="v" sid="GAL 3:9"/>इहैनिता जउन बिस्वास करै बाले हबै, ऊ बिस्वास करै बाले अब्राहम के संग आसीस पउत हबै।<verse eid="GAL 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 3:10"/>इहैनिता जेतना मनसे नियम के कामन हे बिस्वास करथै, ऊ सगलू सरापित के बस हे हबै, काखे लिखवरे हबै, “जउन कउ नियम के किताब हे लिखवरे सगलू बातन के नेहको मानथै, ऊ सरापित हबै<note caller="+" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="JAS 2:10-12">याकूब 2:10-12</ref>; <ref loc="DEU 27:26">बेवस्थाबिबरन 27:26</ref></char></note>।” <verse eid="GAL 3:10"/><verse number="11" style="v" sid="GAL 3:11"/>पय हइ बात परगट हबै कि नियम के दवारा भगवान के इछो कउ धरमी मनसे नेहको ठहरथै, काखे धरमी मनसे बिस्वास लग जिन्दा रइहिन। <verse eid="GAL 3:11"/><verse number="12" style="v" sid="GAL 3:12"/>पय नियम के बिस्वास लग कउनो मतलब नेहको हबै, काखे “जउन उनके मनही ऊ उनखर कारन जिन्दा रइहिन।”<verse eid="GAL 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 3:13"/>मसीह जउन हमर निता सरापित बनिस, हमके खरीदके नियम के सरापित लग बचाइस, काखे लिखवरे हबै, “जउन कउ क्रूस हे टंगाय जथै ऊ सरापित हबै।” <verse eid="GAL 3:13"/><verse number="14" style="v" sid="GAL 3:14"/>हइ इहैनिता होथै कि अब्राहम के आसीस मसीह यीसु हे दूसर जातन तक पहुंचै अउ हम बिस्वास के दवारा ऊ आतमा के पइ जेखर टीमा होय रथै।<verse eid="GAL 3:14"/></para>
  <para style="s">नियम अउ टीमा</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 3:15"/>हे भाई, मै मनसेन के आदत लग कथो, मनसे के टीमा जउन पक्का हुइ जथै, ता न कउ उके टारथै अउ न ओहमा कुछ जोडथै। <verse eid="GAL 3:15"/><verse number="16" style="v" sid="GAL 3:16"/>अब टीमा अब्राहम के बिरादरी के देय गय हबै। ऊ हइ नेहको कथै, “उनखर बिरादरी के” जसना बोहत झन के बारे हे कथै, पय जसना अक्ठी के बारे हे “तोर बिरादरी ऊ मसीह हबै<note caller="+" style="x"><char style="xo" closed="false">3:16 </char><char style="xt" closed="false"><ref loc="MAT 1:1">मत्ती 1:1</ref></char></note>।” <verse eid="GAL 3:16"/><verse number="17" style="v" sid="GAL 3:17"/>पय मै हइ कथो जउन टीमा भगवान आगू लग पक्का करे रथै, ओखर नियम चार सव तीस साल के बाद आयके नेहको टर सकही कि टीमा बेकार ठहरही<note caller="+" style="x"><char style="xo" closed="false">3:17 </char><char style="xt" closed="false"><ref loc="EXO 12:40">निरगमन 12:40</ref></char></note>। <verse eid="GAL 3:17"/><verse number="18" style="v" sid="GAL 3:18"/>काखे अगर मीरास नियम लग मिले हबै ता फेर टीमा लग नेहको, पय भगवान अब्राहम के टीमा के दवारा दय हबै।<verse eid="GAL 3:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 3:19"/>तब फेर मूसा कर नियम काखे दय गय हबै? ऊ ता अपराधन के कारन बाद हे दय गइस कि बिरादरी के आमै तक रहै, जेही टीमा दय गय रथै अउ ऊ स्वरगदूत के दवारा अक्ठी बीचबचाव ठहराय गइस। <verse eid="GAL 3:19"/><verse number="20" style="v" sid="GAL 3:20"/>बीचबचाव कम से कम दुइझन के बीच हे करे जथै, पय भगवान अक्ठी हबै।<verse eid="GAL 3:20"/></para>
  <para style="s">बेवस्था के मतलब</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 3:21"/>ता का नियम भगवान के टीमा के बिरोध हे हबै? कबहुन नेहको। अगर असना नियम दय जथै जउन जीवन दइ सकथै, ता सहीमा नियाइपन नियम लग होथै। <verse eid="GAL 3:21"/><verse number="22" style="v" sid="GAL 3:22"/>पय पवितर किताब सगलू के पाप के बस हे कर दय हबै, ताकि ऊ टीमा जेखर अधार यीसु मसीह हे बिस्वास करैके हबै, बिस्वास करै बाले के निता पूर हुइ जही।<verse eid="GAL 3:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GAL 3:23"/>पय बिस्वास के आमै लग पहिले नियम के बस हे हमर रखबाली होथै अउ ऊ बिस्वास के आमै तक जउन परगट होमै बाले रथै, हम उहै के कबजा हे रहन। <verse eid="GAL 3:23"/><verse number="24" style="v" sid="GAL 3:24"/>इहैनिता नियम मसीह तक पहुंचामै के निता धरमी ठहरिस।<verse eid="GAL 3:24"/></para>
  <para style="s">टोरवा अउ बिरादरी</para>
  <para style="p">
    <verse number="25" style="v" sid="GAL 3:25"/>पय जब बिस्वास आय चुकिस, ता हम अब गुरू के बस हे नेहको रहिन।<verse eid="GAL 3:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="GAL 3:26"/>काखे तुम सब कउ उहै बिस्वास के दवारा जउन मसीह यीसु हे हबै, भगवान कर टोरवा होय। <verse eid="GAL 3:26"/><verse number="27" style="v" sid="GAL 3:27"/>अउ तुम मसे जेतना मसीह हे पानी हे बतिस्मा लेय हबा, उन मसीह के ओढ लय हबै। <verse eid="GAL 3:27"/><verse number="28" style="v" sid="GAL 3:28"/>अब न कउ यहूदी रहिन अउ न यूनानी, न कउ हरवाह अउ न आजाद, न कउ डउका न डउकी, काखे तुम सब मसीह यीसु हे अक्ठी हबा। <verse eid="GAL 3:28"/><verse number="29" style="v" sid="GAL 3:29"/>अउ अगर तुम मसीह के हबा ता अब्राहम के बिरादरी अउ टीमा के जसना हकदार हबा।<verse eid="GAL 3:29"/></para>
  <chapter eid="GAL 3"/>
  <chapter number="4" style="c" sid="GAL 4"/>
  <para style="s">मसीह हे आजाद वंस</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 4:1"/>अब मै हइ कथो, जब तक वारिसदार लरका हबै, ऊ सगलू डेरा के मालिक होत भरमा हरवाह लग कउनो मेर के अलगे नेहको हबै। <verse eid="GAL 4:1"/><verse number="2" style="v" sid="GAL 4:2"/>पय दादा के ठहराय हर टेम तक दाय बाफ अउ देखरेख करै बालेन के बस हे रथै। <verse eid="GAL 4:2"/><verse number="3" style="v" sid="GAL 4:3"/>ओसनेन हम जब तक लरका रथन, तब तक दुनिया के आखरी सिक्छा के बस हे हुइके गुलाम बने हर रथन। <verse eid="GAL 4:3"/><verse number="4" style="v" sid="GAL 4:4"/>पय जब टेम पूर होथै ता भगवान अपन टोरवा के पठोइस, जउन डउकी लग पइदा हुइस अउ नियम के बस हे पइदा हुइस। <verse eid="GAL 4:4"/><verse number="5" style="v" sid="GAL 4:5"/>ताकि नियम के कब्जा हे रहै बालेन के खरीदके छंडाय सकै अउ हमके लेपालक होमै के पद मिल सकै।<verse eid="GAL 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 4:6"/>इहैनिता कि तुम बाफ के टोरवा ठहरा, उन हमर भित्तर अपन टोरवा के आतमा के पठोय दइस, जउन “बाफ” कहिके पुकारथै। <verse eid="GAL 4:6"/><verse number="7" style="v" sid="GAL 4:7"/>इहैनिता तै अब हरवाह नेहको, पय टोरवा हबा अउ जब टोरवा हबा, ता भगवान के दवारा हकदारो हबा।<verse eid="GAL 4:7"/></para>
  <para style="s">गलातियों के निता पोलुस के चिन्ता</para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 4:8"/>पहिले तुम जब भगवान के नेहको जानत रहा, ता तुम देउतन के हरवाह रथा, उन सही हे भगवान नेहको हबै<note caller="+" style="x"><char style="xo" closed="false">4:8 </char><char style="xt" closed="false"><ref loc="ISA 37:19">यसा 37:19</ref>; <ref loc="JER 2:11">इरमि 2:11</ref></char></note>। <verse eid="GAL 4:8"/><verse number="9" style="v" sid="GAL 4:9"/>पय अब जउन तुम भगवान के जान लेया ता भगवान तुमके जान लइस, ता उन ढिलवा अउ अदबिलोन सिक्छा के बातन के तरफ काखे फिरथा, जिनखर तुम फेरै लग गुलाम होमै चाहथा? <verse eid="GAL 4:9"/><verse number="10" style="v" sid="GAL 4:10"/>तुम खास दिन अउ महिना अउ सीजन के टेम अउ साल के मानै बाले बन गय हबा। <verse eid="GAL 4:10"/><verse number="11" style="v" sid="GAL 4:11"/>मोके संका हबै, कहुं असना झइ होय कि जउन मेहनत मै तुम्हर निता करे हव ऊ मेहनत बेकार ठहरै।<verse eid="GAL 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 4:12"/>हे भाई, मै तुम्हर लग बिनती करथो, तुम मोर जसना हुइ जा, काखे मै तुम्हर जसना हुइ गय हव, तुम मोर कुछु नेहको बिगाडे हबा। <verse eid="GAL 4:12"/><verse number="13" style="v" sid="GAL 4:13"/>पय तुम जानथा कि पहिले मै देह लग नंगहा होमै के कारन तुमके संदेस सुनाय रथो। <verse eid="GAL 4:13"/><verse number="14" style="v" sid="GAL 4:14"/>मोर देह हे मोके जउन नंगा के सहै के पडिस, तुम उके बेकार नेहको जाना, अउ न मजाक उडाया, पय मोके भगवान के दूत के रूप हे स्वीकार करा, इहां तक कि मोके मसीह यीसु के जसना समझा। <verse eid="GAL 4:14"/><verse number="15" style="v" sid="GAL 4:15"/>जउन धन्य के बारे हे तुम कथा, ऊ सगलू कुछु कछो हबै? इहैनिता कि मै तुम्हर बारे हे गवाह दय रथो, कि अगर लिखडी होथै, ता तुम अपन आंखी के निकाड के दइ दय होते। <verse eid="GAL 4:15"/><verse number="16" style="v" sid="GAL 4:16"/>ता का हइ कारन मै तुम्हर बैरी हुइ गय हव, काखे मै तुमके सही गुठेथो<note caller="+" style="x"><char style="xo" closed="false">4:16 </char><char style="xt" closed="false"><ref loc="AMO 5:10">अमोस 5:10</ref></char></note>।<verse eid="GAL 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 4:17"/>ऊ तुमही संगी बनामै तो चाहथै, पय अच्छाई लग नेहको, पय तुमही मोर लग अलगे करै चाहथै कि तुम उनही अपन संगी बना लेया, अउ जेखर लग तुम उनखर बात माना। <verse eid="GAL 4:17"/><verse number="18" style="v" sid="GAL 4:18"/>पय इहो निक्खा हबै कि निक्खा बात हे हर टेम संगी बनामै के परयास करे जाय, सिबाय उहै टेम तक नेहको जब तक मै तुम्हर बीच मउजूद हबो। <verse eid="GAL 4:18"/><verse number="19" style="v" sid="GAL 4:19"/>हे मोर टोरवा टोरिया, जब तक तुम्हर हे मसीह के रूप नेहको बन जाय, तब तक मै तुम्हर निता फेरै पीरा सहथों। <verse eid="GAL 4:19"/><verse number="20" style="v" sid="GAL 4:20"/>मै चाहथो कि अबे तुम्हर लिघ्घो अइतो जइतो अउ तुम्हर संग अलगे मेर लग बात करतों, काखे मै समझा नेहको पाथो, कि तुम्हर निता काहिन कहेव।<verse eid="GAL 4:20"/></para>
  <para style="s">सारा अउ हाजिरा के उदाहरन</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 4:21"/>मोके गुठेवा तुम जउन नियम के पालन करै के चाहथा, का नियम के नेहको सुनथा कि नियम काहिन कथै? <verse eid="GAL 4:21"/><verse number="22" style="v" sid="GAL 4:22"/>काखे इहो लिखवरे हबै कि अब्राहम के दुइठे टोरवा हुइस, अक्ठी हरवाहिन लग अउ अक्ठी खुद के डउकी लग<note caller="+" style="x"><char style="xo" closed="false">4:22 </char><char style="xt" closed="false"><ref loc="GEN 16:5">उत्पति 16:5</ref>; <ref loc="GEN 21:2">21:2</ref></char></note>, <verse eid="GAL 4:22"/><verse number="23" style="v" sid="GAL 4:23"/>पय जउन हरवाहिन लग हुइस, ऊ देह के मेर लग हुइस, अउ जउन आजाद डउकी लग हुइस, ऊ टीमा के जसना हुइस। <verse eid="GAL 4:23"/><verse number="24" style="v" sid="GAL 4:24"/>इन बातन हे अक्ठी किस्सा हबै, हइ डउकिन माना दुइठे टीमा हबै, अक्ठी ता सीनै डोंगर जेखर लग हरवाह हुइस, अउ ऊ हाजिरा हबै। <verse eid="GAL 4:24"/><verse number="25" style="v" sid="GAL 4:25"/>हाजिरा के सीनै डोंगर अरब देस हे हबै, पय हइ वरतमान यरुसलेम के दिखाथै, जउन अपन लरकन के संग जेल हे हबै। <verse eid="GAL 4:25"/><verse number="26" style="v" sid="GAL 4:26"/>पय उप्पर के यरुसलेम आजाद हबै, अउ ऊ हमर दाय हबै। <verse eid="GAL 4:26"/><verse number="27" style="v" sid="GAL 4:27"/>जसना लिखवरे हबै,</para>
  <para style="q1" vid="GAL 4:27">“हे बांझ डउकी तै जउन लरका पइदा करै हे कमजोर हबस,</para>
  <para style="q2" vid="GAL 4:27">खुसी होय तै जउन दरद पीरा लग अनचिन्हार हबस,</para>
  <para style="q1" vid="GAL 4:27">खुसी बनाबा काखे छांडे हर के लरका,</para>
  <para style="q2" vid="GAL 4:27">काज करे हर के लरका लग बोहत हबै।”<verse eid="GAL 4:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GAL 4:28"/>हे भाई हम इसहाक के जसना भगवान के टीमा के लरका हवन। <verse eid="GAL 4:28"/><verse number="29" style="v" sid="GAL 4:29"/>पय जसना ऊ टेम देह लग पइदा टोरवा आतमा लग पइदा टोरवा के सताय करथै, ओसनेन अबहुन होथै<note caller="+" style="x"><char style="xo" closed="false">4:29 </char><char style="xt" closed="false"><ref loc="GEN 21:9">उत्पति 21:9</ref></char></note>। <verse eid="GAL 4:29"/><verse number="30" style="v" sid="GAL 4:30"/>पय पवितर किताब काहिन कथै? “हरवाहिन अउ ओखर टोरवा के निकाड दे, काखे हरवाह के टोरवा आजाद डउकी के टोरवा के संग वारिसदार नेहको होही<note caller="+" style="x"><char style="xo" closed="false">4:30 </char><char style="xt" closed="false"><ref loc="GEN 21:10">उत्पति 21:10</ref></char></note>।” <verse eid="GAL 4:30"/><verse number="31" style="v" sid="GAL 4:31"/>इहैनिता हे भाई हम हरवाहिन के नेहको पय आजाद डउकी के टोरवा हबै।<verse eid="GAL 4:31"/></para>
  <chapter eid="GAL 4"/>
  <chapter number="5" style="c" sid="GAL 5"/>
  <para style="s">मसीह हे आजाद</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 5:1"/>जउन आजादी के निता मसीह हमही आजाद करे हबै ओहमा मजबूत लग बने रइहा, हरवाह के जुंवा हे बंधे रहैके झइ स्वीकार करा।<verse eid="GAL 5:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="GAL 5:2"/>सुनो, मै पोलुस तुम्हर लग कथो कि अगर खतना करइहा, ता मसीह लग तुमही कुछु फायदा नेहको होही। <verse eid="GAL 5:2"/><verse number="3" style="v" sid="GAL 5:3"/>फेर मै हर अक्ठी खतना करै बाले के गुठे देथो कि उके सगलू नियम के मानैके पडही। <verse eid="GAL 5:3"/><verse number="4" style="v" sid="GAL 5:4"/>अगर तै अपन धरमी के निता नियम हे निरभर रहै चाहथस, ता तै मसीह लग अपन रिस्ता टोर लय अउ भगवान के अनुगरह किरपा के खोय दय हबस। <verse eid="GAL 5:4"/><verse number="5" style="v" sid="GAL 5:5"/>काखे आतमा के दवारा हमर मुकति के सगलू फायदा आसा करे हर नियाइपन के ओरगथा जउन बिस्वास लग हबै। <verse eid="GAL 5:5"/><verse number="6" style="v" sid="GAL 5:6"/>न खतना बाले अउ न बिन खतना बाले मसीह यीसु हे कउनो मतलब नेहको हबै, ओहमा तो माया करै बाले बिस्वास के मतलब हबै।<verse eid="GAL 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 5:7"/>तुम मसीह हे परगति करथा, तुमके कोहर आगू बढै लग रोकिस तुम सत्य के झइ माना? <verse eid="GAL 5:7"/><verse number="8" style="v" sid="GAL 5:8"/>असना सीख तुम्हर बुलामै बाले के पार लग नेहको हबै। <verse eid="GAL 5:8"/><verse number="9" style="v" sid="GAL 5:9"/>सुरता रखा चुटु हस खमीर सगलू गुडरेहर आटा के खमीर के डारथै। <verse eid="GAL 5:9"/><verse number="10" style="v" sid="GAL 5:10"/>परभु हे बिस्वास करथो, कि तुम कउनो दूसर सिक्छा के झइ अपनइहा, जउन तुमही परेसान करथै, चाहे ऊ कउ होय ऊ सजा पइहीं।<verse eid="GAL 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 5:11"/>हे भाइयो अगर मै अब तक सुध्दिकरन खतना के परचार करत होतो, ता मोर उप्पर अब तक गलत बेउहार काखे करे जथै? अगर मै असना करतों, ता क्रूस के ठोकड जउन रुकावट होथै ऊ समापत हुइ जथै। <verse eid="GAL 5:11"/><verse number="12" style="v" sid="GAL 5:12"/>निक्खा इहै होथै कि जउन तोके परेसान करथै, ऊ खुद के नमरद बनाय लेथै।<verse eid="GAL 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 5:13"/>हे भाई, तुम आजाद होमै के निता बुलाय गय हबा, पय असना झइ होय कि हइ आजाद देह के कामन के निता मउका मिलै, पय माया लग अक-दूसर के सेबा करे बाले बना। <verse eid="GAL 5:13"/><verse number="14" style="v" sid="GAL 5:14"/>काखे सगलू नियम हइ अकठिन आदेस हे पूर हुइ जथै, “तै अपन परोसी लग अपन जसना माया करा<note caller="+" style="x"><char style="xo" closed="false">5:14 </char><char style="xt" closed="false"><ref loc="LEV 19:18">लयबेवस्था 19:18</ref>; <ref loc="MAT 5:40">मत्ती 5:40</ref></char></note>।” <verse eid="GAL 5:14"/><verse number="15" style="v" sid="GAL 5:15"/>पय अगर तुम अक दूसर के दांत लग काटथा अउ फाड खथा, ता चेतन्त रहा कि अक दूसर के नास झइ कर देया।<verse eid="GAL 5:15"/></para>
  <para style="s">पवितर आतमा दवारा लग अगुवाई</para>
  <para style="p">
    <verse number="16" style="v" sid="GAL 5:16"/>पय मै कथो, आतमा के जसना चला ता तुम देह के लालच कउनो मेर लग पूर नेहको कर पइहा। <verse eid="GAL 5:16"/><verse number="17" style="v" sid="GAL 5:17"/>काखे देह आतमा के बिरोध हे अउ आतमा देह के बिरोध हे इक्छा करथै, अउ हइ अक दूसर के बैरी हबै, इहैनिता कि जउन तुम चाहथा, उहै नेहको के पाथा। <verse eid="GAL 5:17"/><verse number="18" style="v" sid="GAL 5:18"/>अउ अगर तुम आतमा के चलाय चलत हबा ता नियम के बस हे नेहको हबा।<verse eid="GAL 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 5:19"/>देह के काम हइ सगलू हबै, मतलब, गलत काम, असुध्द काम, <verse eid="GAL 5:19"/><verse number="20" style="v" sid="GAL 5:20"/>मूरती पूजा, जादू टोना, बैर, झगडा, जलन, गुस्सा, बिरोध, फूट, अलगाव, <verse eid="GAL 5:20"/><verse number="21" style="v" sid="GAL 5:21"/>दरुहा, नसा अउ इनखर जसना अउ काम हबै, इनखर बारे हे मै तुम्हर लग जसना पहिले कह चुके हव, कि असना काम करै बाले भगवान कर राज के वारिस नेहको होही।<verse eid="GAL 5:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GAL 5:22"/>पय आतमा के फडुहा माया, खुसी, सान्ति, धीरज, किरपा, दया, बिस्वास, <verse eid="GAL 5:22"/><verse number="23" style="v" sid="GAL 5:23"/>नरम, अउ संयम हबै, असना कामन के बिरोध हे कउ नियम नेहको। <verse eid="GAL 5:23"/><verse number="24" style="v" sid="GAL 5:24"/>अउ जउन मसीह यीसु के हबै, उन देह के ओखर लालसा अउ अभिलासा समेत क्रूस हे चढा देय हबै। <verse eid="GAL 5:24"/><verse number="25" style="v" sid="GAL 5:25"/>अगर हम आतमा के दवारा जिन्दा जीवन मिले हबै, ता आतमा के जसना जीवन बितइ। <verse eid="GAL 5:25"/><verse number="26" style="v" sid="GAL 5:26"/>अउ न हम घमंडी बनी, न अक दूसर के छांडै, अउ न अक दूसर लग इसाह।<verse eid="GAL 5:26"/></para>
  <chapter eid="GAL 5"/>
  <chapter number="6" style="c" sid="GAL 6"/>
  <para style="s">अक दूसर के मदद करा</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 6:1"/>हे भाई बेहन अगर कउ मनसे कउनो अपराध हे पकडे जाय ता तुम जउन आतमिक हबा, सज्जन के संग असना के संमारै, अउ अपनो खयाल रखै कि तुमो परिक्छा हे झइ पडा। <verse eid="GAL 6:1"/><verse number="2" style="v" sid="GAL 6:2"/>तुम अक दूसर के भार उठाबा, अउ इहैमेर मसीह के नियम के पूर करा। <verse eid="GAL 6:2"/><verse number="3" style="v" sid="GAL 6:3"/>काखे अगर कउ खुदय के खास समझथै, पय ऊ खास नेहको हबै, ता ऊ खुदय के धोखा देथै। <verse eid="GAL 6:3"/><verse number="4" style="v" sid="GAL 6:4"/>पय हर कउ खुदय के परख ले, अउ काम करके देखै, तब उके कउनो दूसर के काम हे नेहको बलुक अपन काम हे खुस होमै के मउका मिलही। <verse eid="GAL 6:4"/><verse number="5" style="v" sid="GAL 6:5"/>काखे हर कउ मनसे के अपन भार उठामै के हबै।<verse eid="GAL 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 6:6"/>जेही भगवान के बचन सुनाय गय हबै, ऊ हर अक्ठी निक्खा चीज हे अपन गुरू के साझा बनामै।<verse eid="GAL 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 6:7"/>धोखा हे झइ रहा, भगवान मजाक हे नेहको उडाय जथै, काखे मनसे जउन कुछु बोथै उहै काटथै। <verse eid="GAL 6:7"/><verse number="8" style="v" sid="GAL 6:8"/>काखे जउन अपन देह के निता बोथै, ऊ देह के दवारा नास होही, अउ जउन पवितर आतमा के दवारा चलथै, ऊ पवितर आतमा के दवारा सबरोज के जीवन पाही। <verse eid="GAL 6:8"/><verse number="9" style="v" sid="GAL 6:9"/>इहैनिता हम निक्खा काम करत-करत हिम्मत झइ हार, काखे अगर मजबूत बने रहब ता टेम आय लग जरूर हमके फडुहा मिलही। <verse eid="GAL 6:9"/><verse number="10" style="v" sid="GAL 6:10"/>इहैनिता जब तक मउका मिलै हम सबझन के संग निक्खा करी, खासतोर करके बिस्वास करै बाले भाई के संग।<verse eid="GAL 6:10"/></para>
  <para style="s">आखरी चेतन्त अउ सोगत</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 6:11"/>देख, मै तुमही अपन हाथ लग केतका बडा-बडा अक्छर हे तुम्हर निता लिखे हव। <verse eid="GAL 6:11"/><verse number="12" style="v" sid="GAL 6:12"/>जउन मनसे देह दिखामै चाहथै ऊ तुम्हर खतना करवामै के निता दबाव देथै, सिबाय इहैनिता कि ऊ मसीह के क्रूस के कारन सताय झइ जाय। <verse eid="GAL 6:12"/><verse number="13" style="v" sid="GAL 6:13"/>काखे खतना करै बाले खुदय नियम हे नेहको चलथै, ऊ तुम्हर खतना इहैनिता करवामै चाहथै, ताकि देह के कारन घमंड के सकै। <verse eid="GAL 6:13"/><verse number="14" style="v" sid="GAL 6:14"/>पय असना झइ होय, कि परभु यीसु मसीह के क्रूस के छांडके कउनो अउ बात हे घमंड करेव, इहै मसीह के कारन मोर निता दुनिया क्रूस हे चढाय जाय चुके हबै अउ मै दुनिया के निता, <verse eid="GAL 6:14"/><verse number="15" style="v" sid="GAL 6:15"/>काखे न खतना अउ न खतना बाले मसीह हे एखर कुछु मतलब नेहको हबै, मतलब हइ बात के हबै कि हम पूरी तरह लग नबा जीवन बनत जइ। <verse eid="GAL 6:15"/><verse number="16" style="v" sid="GAL 6:16"/>जसना जेतना हइ नियम हे चलथै उनखर उप्पर भगवान के सान्ति अउ दया इस्राएल हे होवत रहै।<verse eid="GAL 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 6:17"/>हइ चिट्ठी के समापत करथो, अउ तुम्हर लग बिनती करथो, अब लग कउ मोके परेसान झइ करै, काखे मै अपन देह हे यीसु मसीह के घाव के लइके चलथो।<verse eid="GAL 6:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 6:18"/>हे भाई, हमर परभु यीसु मसीह के अनुगरह तुम्हार आतमा के संग बने रहै। ओसनेन होय।<verse eid="GAL 6:18"/></para>
  <chapter eid="GAL 6"/>
</usx>
