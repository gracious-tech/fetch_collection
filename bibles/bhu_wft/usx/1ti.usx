<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1TI" style="id">- Bhumiya Standard Project</book>
  <para style="h">तीमु</para>
  <para style="toc3">1 तीमु</para>
  <para style="toc2">1 तीमु</para>
  <para style="toc1">1 तीमुथियुस के निता पोलुस कर चिट्ठी</para>
  <para style="mt2">1 तीमुथियुस के लिए पौलुस की चिट्ठी</para>
  <para style="mt1">1 तीमुथियुस के निता पोलुस कर चिट्ठी</para>
  <para style="imt">परचा</para>
  <para style="ip">1 तीमुथियुस के किताब प्रेरित पोलुस दवारा अपन चेला तीमुथियुस के लिखे गय अक्ठी चिट्ठी हबै, 1 तीमुथियुस करीबन मसीह के पइदा के लगभग 62-64 साल बाद लिखे गय रथै, हइ पोलुस के जीवन के आखरी के निकट होथै, पोलुस तीमुथियुस के संग गहरी सबंध रथै, अउ ऊ उके कइ बेर टोरवा के रूप हे सहायता करिस। <char style="xt"><ref loc="PHP 2:22">फिलिप्पियन 2:22</ref></char> <char style="xt"><ref loc="1TI 1:2">1 तीमु 1:2</ref>; <ref loc="1TI 1:18">1:18</ref></char></para>
  <para style="ip">हइ पोलुस के चारठे चिट्ठी मसे अक्ठी हबै, जउन अक्ठी मंडली के बजाय अक्ठी मनसे के सम्बोधित करे जथै, तीन चिट्ठी 2 तीमुथियुस तीतुस अउ फिलेमोन हबै। 1 तीमुथियुस हे मंडली के आराधना <char style="xt"><ref loc="1TI 2:1-15">2:1-15</ref></char> मंडली के अगुवन के निता काबिल <char style="xt"><ref loc="1TI 3:1-13">3:1-13</ref></char> अउ ठगरा गुरून के खिलाफ चेतन्त। <char style="xt"><ref loc="1TI 1:3-11">1:3-11</ref>; <ref loc="1TI 4:1-5">4:1-5</ref>; <ref loc="1TI 6:2-5">6:2-5</ref></char> हइ दरसाथै कि कइसन पोलुस तीमुथियुस के मंडलिन हे अगुवा बनै के निता सिक्छा देत रथै, 1 तीमुथियुस हे कइ सिधान्त हबै जउन हमर दिनन हे मंडली के नेता के घरेलू मंडली के सेबकाई के परबन्ध करै हे मदद के सकथै।</para>
  <para style="iot">रूप रेखा</para>
  <para style="io1">1. पोलुस तीमुथियुस के सोगत करत सुरु करथै। <char style="ior"><ref loc="1TI 1:1-2">1:1-2</ref></char></para>
  <para style="io1">2. तब ऊ तीमुथियुस के ठगरा गुरू के बिरोध चेतन्त देथै। <char style="ior"><ref loc="1TI 1:3-11">1:3-11</ref></char></para>
  <para style="io1">3. पोलुस हइ गुठेत जारी रखथै कि ऊ यीसु मसीह के निता केतका अभारी हबै। <char style="ior"><ref loc="1TI 1:12-19">1:12-19</ref> </char></para>
  <para style="io1">4. एखर बाद ऊ तीमुथियुस के अराधना अउ मंडली के अगुवन के बारे हे निरदेस देथै। <char style="ior"><ref loc="1TI 2-3">2—3</ref></char></para>
  <para style="io1">5. पोलुस तीमुथियुस के कुछ आखरी निरदेस दइके अपन चिट्ठी समापत करिस। <char style="ior"><ref loc="1TI 4-6">4—6</ref></char></para>
  <chapter number="1" style="c" sid="1TI 1" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 1:1" />पोलुस के पल्ला लग जउन हमर मुकति करै बाले भगवान अउ हमार आसा मसीह यीसु के आदेस लग मसीह यीसु के चेला बनिस।<verse eid="1TI 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1TI 1:2" />तीमुथियुस के नाम जउन बिस्वास हे मोर सही टोरवा हबै, भगवान बाफ, अउ हमर परभु यीसु मसीह के तरफ लग, तोके अनुगरह अउ दया, अउ सान्ति मिलत रहै।</para>
  <para style="p" vid="1TI 1:2">भगवान अउ हमर परभु मसीह यीसु के पल्ला लग अनुगरह, अउ दया अउ सान्ति मिलत रहै।<verse eid="1TI 1:2" /></para>
  <para style="s">ठगरा गुरून के बिरोध चेतन्त</para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 1:3" />मै मकिदुनिया परदेस छो जात टेम तोके समझाय रहों, कि इफिसुस सहर हे रुक जाव, अउ कुछ बताय हर मनसे के चेतन्त करा कि उन ठगरा सिक्छा झइ दे। <verse eid="1TI 1:3" /><verse number="4" style="v" sid="1TI 1:4" />अउ उन किस्सन अउ अनन्त बिरादरी हे मन झइ लगाय, जेखर लग झगडा होथै, अउ भगवान के ऊ परबन्ध के ग्यान नेहको मिलथै, जउन बिस्वास हे आसरित हबै। <verse eid="1TI 1:4" /><verse number="5" style="v" sid="1TI 1:5" />हमर आदेस के उदेस्य हबै, निक्खा सुध्द मन, अउ बढिहा सोंच अउ निस्कपट बिस्वास लग माया पइदा होथै। <verse eid="1TI 1:5" /><verse number="6" style="v" sid="1TI 1:6" />कुछ असना मनसे हबै, जउन रास्ता लग भटक के बेकार संगति हे फस गय हबै। <verse eid="1TI 1:6" /><verse number="7" style="v" sid="1TI 1:7" />उन नियम के गुरू होय के दाबा करथै, हइ आदेस के उदेस्य ऊ माया हबै, जउन सुध्द हिरदय, निरदोस अन्त करन अउ निस्कपट बिस्वास लग उत्पन्न होथै।<verse eid="1TI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 1:8" />हमके हइ पता हबै कि निक्खा मेर लग नियम के काम लामै, ता नियम बढिहा हबै, अगर एखर निस्तार सही मेर लग करे जाय। <verse eid="1TI 1:8" /><verse number="9" style="v" sid="1TI 1:9" />हमके सुरता रहै कि हइ नियम धरमी जन के निता निरधारित नेहको होय हबै, बलुक अधरमी, निरंकुसो, भक्तिहीनो, पापिन, अपवितर अउ असुध्द मनसे, दाय दादा के घात करै बाले, या हत्यारों, <verse eid="1TI 1:9" /><verse number="10" style="v" sid="1TI 1:10" />चाल खराब बाले मनसे, डउका के डउका संग काज करैबाले, अउ मनसे के बेचै बाले, झूठ बोलै बाले अउ झूठी किरिया खाय बाले, अउ इनही छांड के खरा सिक्छा के सब बिरोधियन के निता ठहराय गय हबै।<verse eid="1TI 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 1:11" />इहै परम धन्य भगवान के महिमा ऊ संदेस के जसना हबै, जउन मोके दय गय हबै।<verse eid="1TI 1:11" /></para>
  <para style="s">पोलुस हे भगवान कर अनुगरह</para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 1:12" />मै हमर परभु यीसु मसीह के धन्यबाद करथो, मोके उहै सक्ति दय हबै, ऊ मोके बिस्वास के काबिल समझ के अपन सेबा के काम के निता चुने हबै। <verse eid="1TI 1:12" /><verse number="13" style="v" sid="1TI 1:13" />मै तो पहिले निन्दा करै बाले, बुराई करे बाले अउ गलत काम करे बाले, अउ अधरमी रथो, पय मोर उप्पर दया करे गय हबै, काखे अबिस्वास के कारन मै हइ नेहको जानत रहों कि मै का करथो। <verse eid="1TI 1:13" /><verse number="14" style="v" sid="1TI 1:14" />अउ परभु के अनुगरह मोके बोहत मिले हबै, अउ संग हे बिस्वास अउ माया जउन मसीह यीसु हे हबै बहुतायत लग हुइस। <verse eid="1TI 1:14" /><verse number="15" style="v" sid="1TI 1:15" />हइ बात सही हबै, अउ हर कउ स्वीकार करै का काबिल हबै, कि यीसु मसीह हइ दुनिया हे पापिन के मुकति करै के निता आइस, फेर मै तो सब लग बडा पापी हबो। <verse eid="1TI 1:15" /><verse number="16" style="v" sid="1TI 1:16" />मोर उप्पर दया इहैनिता करे गय हबै कि मै सबले बडा पापी यीसु मसीह सब लग पहिले मोके अपन पूर सहनसीलता परदरसित करिस, अउ उन मनसेन के निता अक्ठी उदाहरन परस्तुत करिस, जउन सबरोज जीवन पामै के निता बिस्वास करही, उनखर निता मै अक्ठी आदर्स बन। <verse eid="1TI 1:16" /><verse number="17" style="v" sid="1TI 1:17" />युगन के राजा, कबहुन न मरै बाले, कबहुन न दिखै बाले अउ असीम भगवान के इज्जत अउ महिमा जुगजुग होवत रहै ओसनेन होय।<verse eid="1TI 1:17" /></para>
  <para style="s">तीमुथियुस कर आदेस</para>
  <para style="p">
    <verse number="18" style="v" sid="1TI 1:18" />हे मोर टोरवा, तीमुथियुस, मै तोके आदेस तोर बारे हे पहिलेन लग करे गइस आगू कर बात जसना सउपथो, कि उनखर जसना तै निक्खा लडाई के लडत रह। <verse eid="1TI 1:18" /><verse number="19" style="v" sid="1TI 1:19" />बिस्वास अउ निक्खा सुध्द मन हुइके अच्छाई के लडाई के सकस, कुछ असना हबै, जिनखर अच्छा चेतना अउ बिस्वास रूपी जिहाज बुड गइस। <verse eid="1TI 1:19" /><verse number="20" style="v" sid="1TI 1:20" />उनखर मसे हुमिनयुस अउ सिकन्दर हबै, जिनके मै भुतवा के हाथ हे सउप दय हबो जेखर लग ऊ हइ ग्यान ले कि भगवान के बुराई करै के झइ सीखय।<verse eid="1TI 1:20" /></para>
  <chapter eid="1TI 1" />
  <chapter number="2" style="c" sid="1TI 2" />
  <para style="s">आराधना सबंधित निरदेस</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 2:1" />इहैनिता सब लग पहिले निबेदन हइ हबै कि सगलू के निता बिनती, पराथना, मनसेन के निता पराथना अउ धन्यबाद परस्तुत करे जाय। <verse eid="1TI 2:1" /><verse number="2" style="v" sid="1TI 2:2" />राजा अउ ऊंच पद बाले अधिकारिन के निबेदन अउ धन्यबाद अरपित करे जाय, ताकि हम भक्ति अउ मरयादा हे सान्ति भरपूर जीवन निस्तार कर सकि। <verse eid="1TI 2:2" /><verse number="3" style="v" sid="1TI 2:3" />हइ हमर मुकति करै बाले भगवान के खुस करै बाले हबै, हइ निक्खा हबै अउ गरहन के काबिल हबै। <verse eid="1TI 2:3" /><verse number="4" style="v" sid="1TI 2:4" />जउन हइ चाहथै कि सगलू मनसेन के मुकति होय, अउ उन सही के नीक नांगा चीन्ह ले<note caller="+" style="x"><char style="xo" closed="false">2:4 </char><char style="xt" closed="false"><ref loc="EZK 18:23">यहेज 18:23</ref></char></note>। <verse eid="1TI 2:4" /><verse number="5" style="v" sid="1TI 2:5" />केबल अक्ठी भगवान हबै अउ भगवान अउ मनसेन के बीच केबल अक्ठी बीचबचाव हबै, मतलब यीसु मसीह जउन खुदय मनसे हबै। <verse eid="1TI 2:5" /><verse number="6" style="v" sid="1TI 2:6" />जिनही खुद के सबके छुटकारे के निता दइ दय हबै, अउ ओखर गवाह ठीक टेम हे दय जाय। <verse eid="1TI 2:6" /><verse number="7" style="v" sid="1TI 2:7" />मै सही कथो, झूठ नेहको बोलथो, कि मै इहै उदेस्य लग परचारक अउ चेला अउ गैर यहूदिन के निता बिस्वास अउ सत्य के उपदेसक ठहराय गय हव।<verse eid="1TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 2:8" />इहैनिता मै चाहथो कि हर जिघा हे डउका, बेगैर गुस्सा के अउ बेगैर झगडा के, भगवान के पवितर हाथन के उठाय के बिनती करे करै। <verse eid="1TI 2:8" /><verse number="9" style="v" sid="1TI 2:9" />इहै मेर डउकी के खुरथा पइजामा पहिराय के टेम सालीनता के धियान दे, केबल बाल सजामै अउ सोना, चांदी मोती या मंहगी चीजन लग झइ सजामै। <verse eid="1TI 2:9" /><verse number="10" style="v" sid="1TI 2:10" />बलुक भगवान के भक्ति करै बाले डउकी के इहै निक्खा हबै, जउन खुदय उपास करथै, उनखर निता जरूरी हइ हबै कि ऊ खुदय के अच्छा काम लग सजाय। <verse eid="1TI 2:10" /><verse number="11" style="v" sid="1TI 2:11" />अक्ठी डउकी के चाही कि ऊ सान्त भाव लग भरपूर अधीनता हे सीखय चाही। <verse eid="1TI 2:11" /><verse number="12" style="v" sid="1TI 2:12" />मै कथो कि डउकी झइ परचार करै अउ न डउका हे हक चलामै, पय चुपचाप रहै। <verse eid="1TI 2:12" /><verse number="13" style="v" sid="1TI 2:13" />काखे आगू आदम के रचना हुइस ओखर बाद हे हब्बा के<note caller="+" style="x"><char style="xo" closed="false">2:13 </char><char style="xt" closed="false"><ref loc="1CO 11:8">1 कुरि 11:8</ref></char></note>। <verse eid="1TI 2:13" /><verse number="14" style="v" sid="1TI 2:14" />अउ आदम बहकाव हे नेहको पडिस, पय डउकी बहकाव हे आयके पाप करिस अउ अपराधिन हुइस<note caller="+" style="x"><char style="xo" closed="false">2:14 </char><char style="xt" closed="false"><ref loc="GEN 3:6">उत्पति 3:6</ref></char></note>। <verse eid="1TI 2:14" /><verse number="15" style="v" sid="1TI 2:15" />पय डउकी लरका पइदा करै के दवारा मुकति पाही, अगर ऊ संयम के संग बिस्वास, माया अउ पवितरता लग स्थिर रथै।<verse eid="1TI 2:15" /></para>
  <chapter eid="1TI 2" />
  <chapter number="3" style="c" sid="1TI 3" />
  <para style="s">मंडली हे अध्यक्छ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 3:1" />हइ बात सत्य हबै कि अगर कउ मुखिया बनै चाहथै, ता ऊ अक्ठी निक्खा काम के इक्छा रखथै। <verse eid="1TI 3:1" /><verse number="2" style="v" sid="1TI 3:2" />बिस्वास के भेद जउन परगट करे गय हबै, कि मुखिया निरदोस, अउ अक्ठिन डउकी के डउका अउ संयमी, सुसील, निक्खा मनसे, पहुनाई करै बाले अउ सिखामै हे निपुड होय। <verse eid="1TI 3:2" /><verse number="3" style="v" sid="1TI 3:3" />दरुहा या झगडा करै बाले झइ होय पय कोमर होय, अउ न झगडा करे बाले अउ न डेरा के लालची होय। <verse eid="1TI 3:3" /><verse number="4" style="v" sid="1TI 3:4" />अपन परवार के ऊ निक्खा परबन्धक होय अउ ओखर लरका ओखर कब्जा हे रहै, अउ ओखर पूर इज्जत करै। <verse eid="1TI 3:4" /><verse number="5" style="v" sid="1TI 3:5" />अगर कउ अपन घर के परबन्धक नेहको के सकथै, ता ऊ भगवान के मंडली के देखरेख कइसन के सकही? <verse eid="1TI 3:5" /><verse number="6" style="v" sid="1TI 3:6" />ऊ अक्ठी नबा चेला झइ होय चाही, ताकि ऊ घमंड लग भर झइ जाय, अउ उके भुतवा के जसना सजा के भागी झइ हुइ जाय। <verse eid="1TI 3:6" /><verse number="7" style="v" sid="1TI 3:7" />इहो जरूरी हबै कि मंडली के बाहिर ऊ ईज्जत के काबिल होय कि ऊ बदनामी अउ भुतवा के फान्दा हे झइ पड जाय।<verse eid="1TI 3:7" /></para>
  <para style="s">मंडली हे सेबक</para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 3:8" />इहै मेर मंडली के सेबकन के इज्जत के काबिल होमै चाही, जेखर सब्द हे बिस्वास करे जा सके, दारू हे ओखर मन झइ लगै चाही, बेकार रास्ता लग उके धन कमामै के लालची झइ होमै के चाही। <verse eid="1TI 3:8" /><verse number="9" style="v" sid="1TI 3:9" />उके तो सुध्द मन लग हमर बिस्वास के गरहन लग उनके थामे रखै चाही। <verse eid="1TI 3:9" /><verse number="10" style="v" sid="1TI 3:10" />अउ उनके हइ आगू परखे जाय, तब अगर बेकसूर निकरै के बाद ही धरम सेबा के काम करे। <verse eid="1TI 3:10" /><verse number="11" style="v" sid="1TI 3:11" />इहैमेर ले डउकीन के गंभीर होय चाही, दोस लगामै बाले झइ होय, पय सचेत अउ सगलू बातन हे बिस्वास करै बाले होय। <verse eid="1TI 3:11" /><verse number="12" style="v" sid="1TI 3:12" />मंडली के सेबक केबल अकठेन डउकी होय चाही अउ उके अपन लरकन अउ अपन परवार के अच्छा परबन्धक होय चाही। <verse eid="1TI 3:12" /><verse number="13" style="v" sid="1TI 3:13" />जउन धरम सेबा अपन सेबा काम अच्छा मेर लग करथै, ऊ इज्जत पाथै, अउ यीसु मसीह के बिस्वास के बारे हे ऊ दृढ निस्चय हबै।<verse eid="1TI 3:13" /></para>
  <para style="s">महान भेद</para>
  <para style="p">
    <verse number="14" style="v" sid="1TI 3:14" />मोके आसा हबै कि मै हरबी तुम्हर लिघ्घो आहुं, पय हइ चिट्ठी इहैनिता लिखथो। <verse eid="1TI 3:14" /><verse number="15" style="v" sid="1TI 3:15" />अगर मोर आमै हे देरी हुइ जइ, ता तुमके हइ बात पता रहै चाही कि भगवान के घर हे मनसेन के आदत कइसन होय के चाही, जिन्दा परवार भगवान के मंडली हबै, ऊ सही के खम्भा अउ मूल आधार हबै। <verse eid="1TI 3:15" /><verse number="16" style="v" sid="1TI 3:16" />धरम के हइ रहस्य बिना संका के बडा हबै,</para>
  <para style="q1" vid="1TI 3:16">मसीह देह के रूप हे परगट हुइस,</para>
  <para style="q2" vid="1TI 3:16">पवितर आतमा के दवारा सही परमानित हुइस,</para>
  <para style="q2" vid="1TI 3:16">अउ स्वरगदूत के दिखाई दइस,</para>
  <para style="q1" vid="1TI 3:16">दूसर जात हे ओखर परचार हुइस,</para>
  <para style="q2" vid="1TI 3:16">दुनिया भर के मनसे ओखर उप्पर बिस्वास करिन,</para>
  <para style="q2" vid="1TI 3:16">अउ ऊ महिमा हे उप्पर उठाय लय गइस।<verse eid="1TI 3:16" /></para>
  <chapter eid="1TI 3" />
  <chapter number="4" style="c" sid="1TI 4" />
  <para style="s">ठगरा गुरू लग सचेत</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 4:1" />पय पवितर आतमा सही कथै, कि आमै बाले टेम हे केतका मनसे भरमाय बाले आतमन, अउ भुतवा के सिक्छा पय मन लगाय के बिस्वास ले बहक जइहिन। <verse eid="1TI 4:1" /><verse number="2" style="v" sid="1TI 4:2" />हइ उन ठगरा मनसेन के कपट के कारन होही, जिनखर मन मरे पडे हबै, माना जरत हर लोहा लग आंके गय हबै, <verse eid="1TI 4:2" /><verse number="3" style="v" sid="1TI 4:3" />जउन काज करै लग रोके, अउ भोजन के कुछ चीजन ले परे रहै के आदेस दइहिन, जिनके भगवान इहैनिता रचे हबै कि बिस्वास करै बाले अउ सही के चीन्हे बाले उनके धन्यबाद के संग खाय<note caller="+" style="x"><char style="xo" closed="false">4:3 </char><char style="xt" closed="false"><ref loc="GEN 9:3">उत्पति 9:3</ref></char></note>। <verse eid="1TI 4:3" /><verse number="4" style="v" sid="1TI 4:4" />काखे भगवान के रचे हर अक्ठी चीज निक्खा हबै, अउ कउनो चीज अस्वीकार करै के जसना नेहको, पय हइ कि धन्यबाद के संग खाय जाय, <verse eid="1TI 4:4" /><verse number="5" style="v" sid="1TI 4:5" />काखे भगवान के बचन अउ बिनती के दवारा सुध्द हुइ जथै।<verse eid="1TI 4:5" /></para>
  <para style="s">मसीह यीसु के निक्खा सेबक</para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 4:6" />अगर तै बिस्वासी भाई बेहनन के हइ बातन के सुधि दय रही, ता मसीह यीसु के निक्खा सेबक ठहरही अउ बिस्वास अउ ऊ निक्खा परचारक के बातन ले, जउन तै मानत हबै, तोर पालन पोसन होत रही। <verse eid="1TI 4:6" /><verse number="7" style="v" sid="1TI 4:7" />पय असुध्द अउ डोकरिन के बनाय हर किस्सन लग दुरिहां रहा, अउ भक्ति के साधना के। <verse eid="1TI 4:7" /><verse number="8" style="v" sid="1TI 4:8" />काखे देह के अपन वस हे करै के फायदा होथै, पय भक्ति सब बातन के निता लाभदायक हबै, काखे ऊ टेम के आमै बाले जीवन के टीमा इहै के निता हबै। <verse eid="1TI 4:8" /><verse number="9" style="v" sid="1TI 4:9" />हइ बचन सही हबै अउ सबैमेर लग मानै के काबिल हबै। <verse eid="1TI 4:9" /><verse number="10" style="v" sid="1TI 4:10" />काखे हम मेहनत अउ परयास इहैनिता करथन, कि हमार आसा ऊ जिन्दा भगवान हे हबै, जउन सब मनसेन के अउ खुदय बिस्वास के मुकति करै बाले हबै।<verse eid="1TI 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 4:11" />हइ बातन के आदेस दे अउ सिखाउत रह। <verse eid="1TI 4:11" /><verse number="12" style="v" sid="1TI 4:12" />कउ तोर जबानी के बेकार झइ समझै पय बचन अउ चाल-चलन अउ माया अउ बिस्वास, अउ पवितरता हे बिस्वास करै बाले के निता आदर बन जा। <verse eid="1TI 4:12" /><verse number="13" style="v" sid="1TI 4:13" />जब तक मै नेहको आहुं, तब तक पढै अउ परचार करै अउ सिखामै हे लगे रइहा। <verse eid="1TI 4:13" /><verse number="14" style="v" sid="1TI 4:14" />ऊ बरदान के परति जउन तोर हे हबै, आगू कर बात गुठेमै बाले के दवारा सियानन के हाथ धरत टेम तोके मिले रथै, लपरवाह झइ रह। <verse eid="1TI 4:14" /><verse number="15" style="v" sid="1TI 4:15" />हइ बातन के सोचत रह अउ इहै हे अपन धियान लगाय रहबे, ता तोर उन्नत सब हे परगट होय। <verse eid="1TI 4:15" /><verse number="16" style="v" sid="1TI 4:16" />अपन अउ सिक्छा के चवकसी रख। हइ बातन हे स्थिर रहबे, काखे अगर असना करत रइहा, ता तै अपन अउ अपन सुनैबालेन के निता मुकति के कारन होही।<verse eid="1TI 4:16" /></para>
  <chapter eid="1TI 4" />
  <chapter number="5" style="c" sid="1TI 5" />
  <para style="s">बिस्वास करै बाले के परति जबाबदारी</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 5:1" />कउनो डोकरा के झइ गधार, पय उके दादा जानके समझाय दे, अउ जबानन के भाई जानके<note caller="+" style="x"><char style="xo" closed="false">5:1 </char><char style="xt" closed="false"><ref loc="LEV 19:32">लयबेवस्था 19:32</ref></char></note>, <verse eid="1TI 5:1" /><verse number="2" style="v" sid="1TI 5:2" />सियान डोकरा डउकी के दाय जानके अउ जबान डउकिन के पूरी पवितरता लग बेहन जानके समझाय दे।<verse eid="1TI 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 5:3" />उन बिधवन के, जउन सहीमा बिधवा हबै, आदर के, <verse eid="1TI 5:3" /><verse number="4" style="v" sid="1TI 5:4" />अगर कउनो बिधवा के लरका या नाती पोता होय, ता उन आगू अपन बिरादरी के संग भक्ति के बरताव करना, अउ अपन दाय बाफ आदि के उनखर हक देय के सीखय, काखे हइ भगवान के भाथै। <verse eid="1TI 5:4" /><verse number="5" style="v" sid="1TI 5:5" />जउन सहीमा बिधवा हबै, अउ ओखर कउनो नेहको, भगवान पय आसा रखथै, अउ रात दिन बिनती अउ पराथना हे लगे रहथै<note caller="+" style="x"><char style="xo" closed="false">5:5 </char><char style="xt" closed="false"><ref loc="JER 49:11">इरमि 49:11</ref></char></note>। <verse eid="1TI 5:5" /><verse number="6" style="v" sid="1TI 5:6" />पय जउन देह के भोग-विलासा के जीवन बिताय हबै, ऊ जियत हर मर चुके हबै। <verse eid="1TI 5:6" /><verse number="7" style="v" sid="1TI 5:7" />हइ बातन के आदेस दय के ताकि उन निरदोस रहै। <verse eid="1TI 5:7" /><verse number="8" style="v" sid="1TI 5:8" />अगर कउनो मनसे कि अउ खास करके अपन घराने कि मनसे अपन सगे कि खास करके अपन खुद बिरादरी के चिन्ता नेहको करे, ता ऊ बिस्वास ले मुके अउ बिस्वास नेहको करै बाले लग बेकार हबै।<verse eid="1TI 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TI 5:9" />उहै बिधवा के नाम लिखे जाय जउन साठ साल ले कम के झइ होय, अउ अकठेन डउका के डउकी रहे होय, <verse eid="1TI 5:9" /><verse number="10" style="v" sid="1TI 5:10" />अउ निक्खा काम हे सुनाम रही होय, लरकन के सेबा करे होय, पवितर मनसेन के गोड धोय होय, दुखियन मनसे के मदद करे होय, अउ हरेक काम हे मन लगाय होय। <verse eid="1TI 5:10" /><verse number="11" style="v" sid="1TI 5:11" />कम उमर के जबान बिधवन के नाम झइ लिखे जाय, कारन हइ हबै कि जब उनखर वासना उनके मसीह लग दुरिहां करथै, ता ऊ काज करै चाहथै। <verse eid="1TI 5:11" /><verse number="12" style="v" sid="1TI 5:12" />अउ हइ मेर अपन पहली बिस्वास के छांड दय हबै। <verse eid="1TI 5:12" /><verse number="13" style="v" sid="1TI 5:13" />एखर अलाबा ऊ आलसी रहै लागथै, अउ घर-घर घूमै करथै, ऊ न केबल आलसी रथै, पय बाकिन के कामन के बिगाडथै, अउ दूसर के बुराई करै हे मजा आथै, अउ ऊ बात बोलथै, जउन उके नेहको बोलै चाही। <verse eid="1TI 5:13" /><verse number="14" style="v" sid="1TI 5:14" />इहैनिता मै हइ चाहथो कि जबान बिधवा काज करै, अउ लरका पइदा करै अउ घर गिरस्ती संभालै, अउ कउनो बैरी के बुराई करै के मउका झइ दे। <verse eid="1TI 5:14" /><verse number="15" style="v" sid="1TI 5:15" />काखे कुछ बिधवा सही रास्ता लग भटक के भुतवा के पाछू चलै लग गय हबै। <verse eid="1TI 5:15" /><verse number="16" style="v" sid="1TI 5:16" />अगर कउनो बिस्वास करै बाले के इहां बिधवा हबै, ता उहै उनखर मदद करै कि मंडली हे भार झइ होय, ता ऊ उनखर मदद के सकै जउन सही हे बिधवा हबै।<verse eid="1TI 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 5:17" />जउन सियान मंडली के निक्खा अगुवाई करथै, ऊ दुइ गुना सम्मान के हकदार होय चाही, खासके ऊ जेखर काम संदेस देया का अउ पढामै का हबै। <verse eid="1TI 5:17" /><verse number="18" style="v" sid="1TI 5:18" />काखे पवितर किताब हे कहे गय हबै, “बइला के दांय फांदत टेम ओखर मुंह झइ बांधा,” अउ “मजदुरिहा के अपन मजदूरी पामै के पूर हक हबै<note caller="+" style="x"><char style="xo" closed="false">5:18 </char><char style="xt" closed="false"><ref loc="LEV 19:13">लयबेवस्था 19:13</ref>; <ref loc="DEU 25:4">बेवस्थाबिबरन 25:4</ref></char></note>।” <verse eid="1TI 5:18" /><verse number="19" style="v" sid="1TI 5:19" />कउनो दोस कउनो सियान हे लगाय जथै ता बगैर दुइ या तीन झन गवाह के उके स्वीकार झइ करा<note caller="+" style="x"><char style="xo" closed="false">5:19 </char><char style="xt" closed="false"><ref loc="DEU 17:16">बेवस्थाबिबरन 17:16</ref>; <ref loc="DEU 19:15">19:15</ref></char></note>। <verse eid="1TI 5:19" /><verse number="20" style="v" sid="1TI 5:20" />जउन हरमेसा पाप हे लगे रथै, उके सबझन के सामने दांका ताकि बाकी मनसे डेराय।<verse eid="1TI 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1TI 5:21" />मै भगवान, मसीह यीसु अउ चुने हर स्वरगदूतन के सामने तुमके हइ जबाबदारी सउपथो, कि बेगैर कउनो पक्छपात के हइ आदेसन के पालन करा, अउ कउनो काम पक्छपात लग झइ करा। <verse eid="1TI 5:21" /><verse number="22" style="v" sid="1TI 5:22" />तुम जरूरी बिचार करे बिना कउनो के उप्पर पक्छपात झइ करा, अउ दूसर के पाप के सहभागी झइ बना, अउ खुद के पवितर बनाय रखा।<verse eid="1TI 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1TI 5:23" />केबल पानी झइ पियत रहा, बलुक अपन पेट हजम करै के अउ बेर-बेर नांगा लग बचै के निता चुटु हस दारू पी लय करा।<verse eid="1TI 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1TI 5:24" />कुछ मनसेन के पाप सही रूप लग परगट हुइ जथै, अउ नियाव के निता उपस्थित करे जथै, पय कुछ मनसेन के पाप बाद हे दिखाई देथै। <verse eid="1TI 5:24" /><verse number="25" style="v" sid="1TI 5:25" />इहै मेर निक्खा काम सही रूप लग परगट हुइ जथै, पय जउन परगट नेहको होथै, उहो जादा टेम तक लुके नेहको रही सकथै।<verse eid="1TI 5:25" /></para>
  <chapter eid="1TI 5" />
  <chapter number="6" style="c" sid="1TI 6" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 6:1" />जउन मनसे हे गुलाम के जुंवा धरे हबै, ऊ अपन मालिक के सबैमेर के ईज्जत के काबिल समझे, जेखर लग भगवान के नाम अउ मंडली के उपदेस के बुराई झइ होय। <verse eid="1TI 6:1" /><verse number="2" style="v" sid="1TI 6:2" />जिनखर मालिक बिस्वासी हबै, ऊ अपन मालिक के बेज्जती झइ करै कि अब तो ऊ उनखर जसना बिस्वासी भाई हबै, ऊ अब उनखर सेबा अउ जादा मन लगाय के करै, काखे ऊ जउन सेबा लग फायदा उठाउत हबै, संगी बिस्वासी अउ पिरिया हबै, उनके इनही सिधान्त के सिक्छा अउ उपदेस दय करा।<verse eid="1TI 6:2" /></para>
  <para style="s">ठगरा सिक्छा अउ लालच</para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 6:3" />अगर कउ एखर लग अलगे सिक्छा देथै, अउ हमर परभु मसीह यीसु के मतलब संदेस अउ भगवान के महिमा के सिक्छा लग सहमत नेहको होथै, जउन भक्ति के जसना हबै। <verse eid="1TI 6:3" /><verse number="4" style="v" sid="1TI 6:4" />ता मै समझथो कि घमंड उके अंधरा बनाय दय हबै, ऊ कुछु नेहको समझथै अउ उके बाद, बिबाद अउ सब्द के लडाई के रोग हबै, हइ मेर के झगडा लग ईस फूट, निन्दा, दूसर हे बेकार संका। <verse eid="1TI 6:4" /><verse number="5" style="v" sid="1TI 6:5" />अउ लगेतार झगडा पइदा होथै, हइ सब असना मनसेन के काबिल हबै, जेखर मन बेकार अउ सही लग हट गय हबै, अउ हइ समझथै, कि महिमा फायदा के अक्ठी साधन हबै।<verse eid="1TI 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 6:6" />जरूर भगवान के सेबा भक्ति लग मनसे के फायदा हबै इहै बडी कमाई हबै। <verse eid="1TI 6:6" /><verse number="7" style="v" sid="1TI 6:7" />काखे हम ई दुनिया हे कुछु लइके नेहको आय हवन, इहैनिता इहां लग कुछु नेहको लइ जा सकथन<note caller="+" style="x"><char style="xo" closed="false">6:7 </char><char style="xt" closed="false"><ref loc="JOB 1:21">अयूब 1:21</ref>; <ref loc="PSA 49:17">भजन 49:17</ref></char></note>। <verse eid="1TI 6:7" /><verse number="8" style="v" sid="1TI 6:8" />अगर हमर लिघ्घो भोजन-कपडा हबै, ता हम एखर लग सन्तुस्ट रहै चाही। <verse eid="1TI 6:8" /><verse number="9" style="v" sid="1TI 6:9" />पय ऊ जउन धनड्ड बनै चाहथै, ऊ लालच हे पड के परिक्छा हे फस जथै, अउ उनके असना मूरख अउ बिनासकारी इक्छा घेर लेथै, जउन मनसे के पतन अउ बिनास के समुन्दर हे बुडोय देथै<note caller="+" style="x"><char style="xo" closed="false">6:9 </char><char style="xt" closed="false"><ref loc="PRO 23:4">नीति 23:4</ref>; <ref loc="PRO 15:27">15:27</ref></char></note>। <verse eid="1TI 6:9" /><verse number="10" style="v" sid="1TI 6:10" />काखे पइसा के लालच सगलू बुराई के जर हबै, इहै लालच हे पड के कइ मनसे बिस्वास के रास्ता लग भटक गय अउ उन अपन हिरदय के कइन मेर के दुख लग छलनी बनाय दय हबै।<verse eid="1TI 6:10" /></para>
  <para style="s">बिस्वास के बढिहा योध्दा</para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 6:11" />पय हे भगवान के मनसे, तै इन बातन ले भाग अउ धरमी, भक्ति, बिस्वास, माया, धीरज अउ नम्रता के पाछू के। <verse eid="1TI 6:11" /><verse number="12" style="v" sid="1TI 6:12" />बिस्वास के निक्खा कुस्ती लड अउ ऊ सबरोज के जीवन के धर ले, जेखर निता तै बुलाय गय हबस, अउ बोहत लग गवाहन के आगू स्वीकार करे हबा। <verse eid="1TI 6:12" /><verse number="13" style="v" sid="1TI 6:13" />भगवान के उपस्थित हे, जउन सब के जीवन परदान करथै अउ यीसु मसीह के उपस्थित हे, जेही राज्यपाल पुन्तियुस पिलातुस के लिघ्घो निक्खा गवाही दय हबै, मै तुमके हइ आदेस देथो। <verse eid="1TI 6:13" /><verse number="14" style="v" sid="1TI 6:14" />कि तै हमर परभु यीसु मसीह के परगट होमै तक हइ आदेस के बेकसूर अउ निरदोस रख, <verse eid="1TI 6:14" /><verse number="15" style="v" sid="1TI 6:15" />जउन ठीक टेम हे भगवान के दवारा पूर होही, भगवान, जउन धन्य या अकठेन अधिपति अउ राजा के राजा अउ परभु के परभु हबै<note caller="+" style="x"><char style="xo" closed="false">6:15 </char><char style="xt" closed="false"><ref loc="PSA 47:2">भजन 47:2</ref></char></note>। <verse eid="1TI 6:15" /><verse number="16" style="v" sid="1TI 6:16" />केबल उहै अनन्त काल हबै, जिनखर लिघ्घो अपार उजियार हे हबै, जिनके कउ कबहुन नेहको देखे हबै अउ न देख सकथै, उनखर महिमा अउ राज लगेतार होवत रहै, ओसनेन होय।<verse eid="1TI 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 6:17" />हइ बरतमान दुनिया के धनड्ड लग निबेदन करा कि ऊ घमंड झइ करै अउ नास होय बाले धन-डेरा हे नेहको, बलुक भगवान के उप्पर आसा रखा, जउन हमर निस्तार के सब चीज जादा मातरा हे देथै<note caller="+" style="x"><char style="xo" closed="false">6:17 </char><char style="xt" closed="false"><ref loc="PSA 62:10">भजन 62:10</ref></char></note>। <verse eid="1TI 6:17" /><verse number="18" style="v" sid="1TI 6:18" />उनके आदेस देया कि ऊ भलाई के काम करै, निक्खा कामन लग धनड्ड बना, खुस रहा अउ दूसरन के संग अपन चीज बांटा। <verse eid="1TI 6:18" /><verse number="19" style="v" sid="1TI 6:19" />हइ मेर ऊ ई डेरा के खरचा अपन आगू के निता अक्ठी बढिहा नीह डाले, कि ऊ सच्चे जीवन के वस हे के ले।<verse eid="1TI 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1TI 6:20" />हे तीमुथियुस, तोके जउन सउपे गय हबै, तै ओखर रक्छा के, अउ जउन ग्यान के ग्यान कहै के भूल हबै, ओखर असुध्द फालतू अउ बिरोध के बातन लग दुरिहां रहा। <verse eid="1TI 6:20" /><verse number="21" style="v" sid="1TI 6:21" />काखे कुछ मनसे उनके स्वीकार करत बिस्वास लग भटक गय हबै, भगवान के अनुगरह तुम्हर संग रहै।<verse eid="1TI 6:21" /></para>
  <chapter eid="1TI 6" />
</usx>