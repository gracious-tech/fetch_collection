<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EPH" style="id">- Bhumiya Standard Project</book>
  <para style="h">इफिसियों</para>
  <para style="toc3">इफिसियों</para>
  <para style="toc2">इफिसियों</para>
  <para style="toc1">इफिसियों के निता पोलुस कर चिट्ठी</para>
  <para style="mt2">इफिसियों के लिए पौलुस की चिट्ठी</para>
  <para style="mt1">इफिसियों के निता पोलुस कर चिट्ठी</para>
  <para style="imt">परचा</para>
  <para style="ip">इफिसियों के लिखे चिट्ठी लगभग उहै टेम लिखे गय रथै जब कुलु के मसीह के पइदा के 60 साल के बाद लिखे गय रथै। लेखक खुदय के प्रेरित पोलुस <char style="xt"><ref loc="EPH 1:1">1:1</ref> </char>के रूप हे पहिचान देथै। अधिकांस बिदमान हइ बात लग सहमत हबै कि पोलुस इफिसियों के लिखिस, भले ही एहमा कुलु हे पाय जाय बाले मनसे के नमस्ते के अभाव हबै। हइ कारन लग इके परदेस के कइ चरचा हे परसारित करै के सोंच हुइ सकथै। पोलुस इहो लिखिस कि जब ऊ चिट्ठी <char style="xt"><ref loc="EPH 3:1">3:1</ref>; <ref loc="EPH 4:1">4:1</ref> </char>अउ <char style="xt"><ref loc="EPH 6:20">6:20</ref></char> लिखे रथै। तब ऊ जेल हे रथै पोलुस तखिकुस के इफिसुस के मंडली के यातरा हे जाय के निता पठोथै। <char style="xt"><ref loc="EPH 6:21-22">6:21-22</ref> </char></para>
  <para style="ip">इफिसुस एसिया माइनर परदेस के निता बोहत बडा सहर अउ रोमन राजधानी रथै। इफिसुस अपन मंदिर के निता परसिध्द रथै जउन ग्रीक देबी आर्टेमिस के समरपित रथै, <char style="xt"><ref loc="ACT 19:23-31">प्रेरितो 19:23-31</ref></char> इफिसुस के मंडली अक्ठी बोहत मजबूत सुरुवात करथै पय बाद हे आत्मसंतुस्ट हुइ गइस। <char style="xt"><ref loc="REV 2:1-7">परकासितवाक्य 2:1-7</ref></char></para>
  <para style="ip">पोलुस हइ चिट्ठी के पहिले भाग हे समझाथै, कि कसना भगवान अपन मनसेन के चुनिस अउ उनके यीसु मसीह के दवारा उनही पाप लग बचाइस। ऊ मंडली के तुलना अक्ठी देह लग करथै जेहमा मसीह मूड के रूप हे हबै, अउ खास अधारसिला के रूप हे मसीह के संग अक्ठी इमारत के रूप हे हबै, किताब के दूसर भाग हे पोलुस मसीह जीवन के निरदेस देथै।</para>
  <para style="iot">रूप रेखा</para>
  <para style="io1">1. पोलुस अपन परचा देथै अउ इफिसियों के नमस्ते करथै। <char style="ior"><ref loc="EPH 1:1-2">1:1-2</ref> </char></para>
  <para style="io1">2. फेर ऊ मसीह के संग मंडली के सबंध के समझाथै। <char style="ior"><ref loc="EPH 1:3-3:21">1:3—3:21</ref></char></para>
  <para style="io1">3. तब पोलुस लिखथै कि मसीहिन के कउन मेर जाय चाही। <char style="ior"><ref loc="EPH 4:1-6:20">4:1-6—6:20</ref> </char></para>
  <para style="io1">4. आखरी हे पोलुस कुछ समापन टिप्पडी देथै। <char style="ior"><ref loc="EPH 6:21-24">6:21-24</ref></char></para>
  <chapter number="1" style="c" sid="EPH 1" />
  <para style="p">
    <verse number="1" style="v" sid="EPH 1:1" />पोलुस के पल्ला लग जउन भगवान के इक्छा लग यीसु मसीह के अक्ठी चेला हबै, उन पवितर अउ मसीह यीसु हे बिस्वास करै बाले मनसेन के नाम जउन इफिसुस सहर हे हबै।<verse eid="EPH 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EPH 1:2" />हमर बाफ भगवान अउ परभु यीसु मसीह के पल्ला लग तुमही अनुगरह अउ सान्ति मिलत रहै।<verse eid="EPH 1:2" /></para>
  <para style="s">मसीह हे आतमिक आसीस</para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 1:3" />हमर परभु यीसु मसीह के भगवान अउ बाफ के धन्यबाद होय, जउन हमही मसीह हे स्वरग छो सबैमेर के आतमिक आसीस दय हबै। <verse eid="EPH 1:3" /><verse number="4" style="v" sid="EPH 1:4" />जसना ऊ हमही दुनिया के बनै लग आगू चुन लइस, कि हम ओखर लिघ्घो माया हे पवितर, अउ बिना निरदोस के होय। <verse eid="EPH 1:4" /><verse number="5" style="v" sid="EPH 1:5" />हमर पल्ला भगवान के माया हबै, उहै के कारन ऊ यीसु मसीह के दवारा हमही अपन टोरवा के रूप हे स्वीकार करै जाय के निता ठहराइस, इहै ओखर इक्छा रथै अउ इहै ओखर उदेस्य रथै। <verse eid="EPH 1:5" /><verse number="6" style="v" sid="EPH 1:6" />ताकि ओखर महिमा अउ किरपा के बडाई होय, ऊ अनुगरह किरपा हमही ओखर पिरिया टोरवा के दवारा मिलिस, <verse eid="EPH 1:6" /><verse number="7" style="v" sid="EPH 1:7" />भगवान के अनुगरह किरपा केतका महान हबै, ऊ अपन टोरवा यीसु मसीह के खून के दवारा मुकति कराइस, मतलब हमर पाप छमा करे गइस, <verse eid="EPH 1:7" /><verse number="8" style="v" sid="EPH 1:8" />जउन ऊ सगलू ग्यान अउ समझ,</para>
  <para style="p" vid="EPH 1:8">सहित हमर उप्पर कुढाय हबै। <verse eid="EPH 1:8" /><verse number="9" style="v" sid="EPH 1:9" />कि ऊ अपन इक्छा के भेद ऊ भले काम के जसना हमके गुठे हबै, जेही ऊ खुद हे ठान लय रथै। <verse eid="EPH 1:9" /><verse number="10" style="v" sid="EPH 1:10" />भगवान के हइ इक्छा हबै कि सही टेम आमै लग स्वरग के अउ भुंइ के सगलू चीजन के मसीह हे अकजुट करै।<verse eid="EPH 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 1:11" />सगलू चीज भगवान के उदेस्य अउ फइसला के जसना करे जथै, भगवान हमही अपन खुदय के उदेस्य के कारन मसीह के संग अपन मनसेन के चुनिस, जउन सुरु लग कहे रथै। <verse eid="EPH 1:11" /><verse number="12" style="v" sid="EPH 1:12" />ताकि जउन पहिले लग मसीह हे आसरा रखे रथन, भगवान के महिमा होय।<verse eid="EPH 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EPH 1:13" />जब तुम ऊ सही के संदेस सुना जउन तुम्हर मुकति के संदेस रथै अउ जउन मसीह हे तुम बिस्वास करे रथा, ता जउन पवितर आतमा के टीमा करे रथै, मसीह के जरिये लग ओखर छाप तुम्हर उप्पर लगाय गय हबै। <verse eid="EPH 1:13" /><verse number="14" style="v" sid="EPH 1:14" />ऊ आतमा हमर वारिस के रूप हे जमानत के रूप हे ऊ टेम तक हे दइ दय गय हबै, जब तक कि ऊ हमही जउन ओखर अपन हबै पूर मेर लग मुकति नेहको दइ देथै, एखर कारन मनसे ओखर महिमा के बडाई करै।<verse eid="EPH 1:14" /></para>
  <para style="s">पोलुस कर बिनती</para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 1:15" />इहैनिता जब लग मै परभु यीसु मसीह हे तुम्हर बिस्वास अउ सगलू पवितर मनसेन के माया के बारे हे सुने हव, <verse eid="EPH 1:15" /><verse number="16" style="v" sid="EPH 1:16" />मै तुम्हर निता भगवान के धन्यबाद लगेतार करथो, अपन पराथना बिनती हे तुमही सुरता करथो। <verse eid="EPH 1:16" /><verse number="17" style="v" sid="EPH 1:17" />मै हइ बिनती करथो कि हमर परभु यीसु मसीह के भगवान महिमा के बाफ तुमही आतमिक ग्यान अउ उजियार अउ भगवान के ग्यान हे तुमही दिमाक अउ उजियार दे<note caller="+" style="x"><char style="xo" closed="false">1:17 </char><char style="xt" closed="false"><ref loc="ISA 11:2">यसा 11:2</ref></char></note>। <verse eid="EPH 1:17" /><verse number="18" style="v" sid="EPH 1:18" />मै बिनती करथो, कि तुम्हर मन के आंखी उघर जाय ताकि तुम जाना कि तुम्हर बुलाय जाय के आसा अउ पवितर मनसेन के निता ओखर महिमा सुरु लग ओखर डेरा हबै। <verse eid="EPH 1:18" /><verse number="19" style="v" sid="EPH 1:19" />अउ जउन बिस्वास करथै, ओहमा काम करै के ओखर सक्ति केतका बडा हबै, हमर भित्तर काम करै बाले सक्ति ओतकै बलवान हबै। <verse eid="EPH 1:19" /><verse number="20" style="v" sid="EPH 1:20" />जउन भगवान यीसु मसीह हे करिस कि यीसु के मरे हर मसे जिन्दा करके ऊ स्वरग के जिघा हे अपन दहिना पल्ला बइठाइस<note caller="+" style="x"><char style="xo" closed="false">1:20 </char><char style="xt" closed="false"><ref loc="HEB 10:22">इब्रानिन 10:22</ref>; <ref loc="PSA 110:1">भजन 110:1</ref></char></note>। <verse eid="EPH 1:20" /><verse number="21" style="v" sid="EPH 1:21" />अउ यीसु के अबहुन अउ आय बाले टेम के कउनो सासक, हक, सक्ति, प्रभुता अउ नाम के बोहत उप्पर ठहराइस। <verse eid="EPH 1:21" /><verse number="22" style="v" sid="EPH 1:22" />सगलू कुछु उनखर गोडन के तरी करके उनके खास ठहराय के मंडली के दइ दइस<note caller="+" style="x"><char style="xo" closed="false">1:22 </char><char style="xt" closed="false"><ref loc="COL 2:10">कुलुस्सियो 2:10</ref>; <ref loc="PSA 8:6">भजन 8:6</ref></char></note>। <verse eid="EPH 1:22" /><verse number="23" style="v" sid="EPH 1:23" />मंडली मसीह के देह हबै, जउन सगलू कुछु सब मेर लग अपन उपस्थिति लग जिघा के भर देथै।<verse eid="EPH 1:23" /></para>
  <chapter eid="EPH 1" />
  <chapter number="2" style="c" sid="EPH 2" />
  <para style="s">मिरतू लग जीवन के पल्ला</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 2:1" />अक टेम रथै, जब तुम उन अपराधन अउ पाप के निता आतमिक रूप लग मरे हर रथा। <verse eid="EPH 2:1" /><verse number="2" style="v" sid="EPH 2:2" />पिछले टेम हे तुम हइ दुनिया के चाल चलन बादर के हक जमामै बाले भुतवा के बस हे रथा, मतलब ऊ आतमा जउन अबे तक आदेस न मानै बाले हे काम करथै, उहै के जसना जीवन जियत रथन। <verse eid="EPH 2:2" /><verse number="3" style="v" sid="EPH 2:3" />एहमा हमु सबके सब आगू अपन देह के क्रोध के दिन बितात रथन अउ इन देह अउ मन के इक्छा पूर करथन अउ दूसर मनसेन के जसना आदत लग भगवान के सजा के लायक रथन।<verse eid="EPH 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 2:4" />पय भगवान जउन दया के धनी हबै, हम अपन पाप के कारन मरे गय रथन, पय भगवान हमर लग बोहत माया करिस। <verse eid="EPH 2:4" /><verse number="5" style="v" sid="EPH 2:5" />जब हम पाप के कारन मरे हर रथन, ता हमही मसीह के साथ जीवन मिलिस अउ अनुगरह लग तुम्हर मुकति होय हबै, <verse eid="EPH 2:5" /><verse number="6" style="v" sid="EPH 2:6" />भगवान यीसु मसीह के संग हमके फेरै लग जिन्दा करिस अउ उहै के संग स्वरग जिघा हे बइठाइस। <verse eid="EPH 2:6" /><verse number="7" style="v" sid="EPH 2:7" />ताकि आमै बाले टेम हे ऊ यीसु मसीह के दवारा जउन हमर निता पीढी हबै, ऊ खतम नेहको होय बाले अनुगरह हे बोहत डेरा के देखा सकै। <verse eid="EPH 2:7" /><verse number="8" style="v" sid="EPH 2:8" />काखे बिस्वास के दवारा अनुगरह लग तुम्हर मुकति होय हबै अउ हइ तुम्हर पल्ला लग नेहको, पय भगवान के बरदान हबै, <verse eid="EPH 2:8" /><verse number="9" style="v" sid="EPH 2:9" />हइ तुम्हर कउनो काम के कारन नेहको मिलथै, असना झइ होय कि कउ घमंड करै। <verse eid="EPH 2:9" /><verse number="10" style="v" sid="EPH 2:10" />भगवान हमही बनाइस, ऊ यीसु मसीह हे हमके बनाइस, जेखर लग हम ऊ निक्खा कामन के पूर करथन, जेही भगवान हमर निता पहिले तइयार करे हबै।<verse eid="EPH 2:10" /></para>
  <para style="s">मसीह हे अक्ठी</para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 2:11" />तुम पइदाइसी लग गैर यहूदी हबा अउ उन मनसेन दवारा बिना खतना बाले कहे जथै, जिनखर देह हे खतना करे गय हबै। <verse eid="EPH 2:11" /><verse number="12" style="v" sid="EPH 2:12" />तुम मनसे ऊ टेम मसीह लग अलगे रथा अउ इस्राएल समूह के बाहिर रथन अउ टीमा के बाचा लग, अनजान रथन अउ हइ दुनिया हे आसा के नेहको जानथन अउ भगवान लग दुरिहां रथन। <verse eid="EPH 2:12" /><verse number="13" style="v" sid="EPH 2:13" />पय यीसु हे तुम पहिले दुरिहां रथा, पय यीसु मसीह हे अक हुइके तुम अब मसीह के खून के दवारा लिघ्घो आ गय हबा। <verse eid="EPH 2:13" /><verse number="14" style="v" sid="EPH 2:14" />काखे उहै हमर मेल मिलाप करवाइस, उन यहूदी अउ गैर यहूदी के अक्ठी कर दय हबै, अउ दोनोन के बीच अलगे जउन फूट डाले बाले बैरी के भीठी रथै, उके यीसु अपन देह के बलिदान के दवारा गिराय दइस<note caller="+" style="x"><char style="xo" closed="false">2:14 </char><char style="xt" closed="false"><ref loc="GAL 3:28">गलातियों 3:28</ref></char></note>। <verse eid="EPH 2:14" /><verse number="15" style="v" sid="EPH 2:15" />जउन यहूदी किताब के नियम गैर यहूदी के यहूदी लग अलगे करके रखे रथै, ओही यीसु अपन मिरतू लग खतम के दइस, हइ दोनोन के बीच हे मिलाप करके अपन हे अक्ठी नबा मनसे बनाइस। <verse eid="EPH 2:15" /><verse number="16" style="v" sid="EPH 2:16" />ऊ क्रूस के दवारा दोनोन के अक्ठी देह हे, भगवान के संग मेल जोल कराइस अउ हइ मेर बैरी के नास के दइस। <verse eid="EPH 2:16" /><verse number="17" style="v" sid="EPH 2:17" />तब मसीह आयके सान्ति के संदेस सुनाइस जउन गैर यहूदी हुइके दुरिहां रथा अउ उन यहूदी मनसे के जउन लिघ्घो रथै<note caller="+" style="x"><char style="xo" closed="false">2:17 </char><char style="xt" closed="false"><ref loc="ACT 2:39">प्रेरितो 2:39</ref></char></note>। <verse eid="EPH 2:17" /><verse number="18" style="v" sid="EPH 2:18" />काखे उहै के दवारा हमही दोनोन के अक्ठी आतमा हे बाफ के लिघ्घो पहुंच सकथन।<verse eid="EPH 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EPH 2:19" />इहैनिता तुम अब परदेसी अउ मेहमान नेहको रहा, पय पवितर मनसेन के संगी नागरिक अउ भगवान के परवार के हुइ गय हबा।<verse eid="EPH 2:19" /></para>
  <para style="s">मसीह हमर कोन्टा के पथरा</para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 2:20" />तुम्हर रचना ऊ घर के जसना हबै, जउन चेला अउ ग्यानी मनसे के नीह हे ठाढ हबै अउ जेखर खुटान के पथरा खुद यीसु मसीह हबै<note caller="+" style="x"><char style="xo" closed="false">2:20 </char><char style="xt" closed="false"><ref loc="ISA 28:16">यसा 28:16</ref>; <ref loc="1CO 12:28">1 कुरि 12:28</ref></char></note>। <verse eid="EPH 2:20" /><verse number="21" style="v" sid="EPH 2:21" />यीसु हे पूर घर बने हबै अउ उहै हे बिस्वासी मनसे जुरके परभु हे अक्ठी पवितर मन्दिर बनत जथै। <verse eid="EPH 2:21" /><verse number="22" style="v" sid="EPH 2:22" />तुमो अक संग मिलके भगवान के निता अक्ठी असना रहै के निता भवन बनाय जथै, जिहां भगवान अपन आतमा के दवारा रथै।<verse eid="EPH 2:22" /></para>
  <chapter eid="EPH 2" />
  <chapter number="3" style="c" sid="EPH 3" />
  <para style="s">गैर यहूदियन हे पोलुस के परचार</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 3:1" />इहै कारन मै पोलुस जउन तुम गैर यहूदिन के भलाई के निता मसीह यीसु के कैदी हव, <verse eid="EPH 3:1" /><verse number="2" style="v" sid="EPH 3:2" />अगर तुम्हर भलाई के निता भगवान अनुगरह के संग जउन काम मोके सउपे हबै, ओखर बारे हे तुम जरूर सुने हबा। <verse eid="EPH 3:2" /><verse number="3" style="v" sid="EPH 3:3" />मतलब हइ कि भगवान के परकासन के दवारा परगट हुइस, जसना मै पहिले लग चुटु हस लिख चुके हव, <verse eid="EPH 3:3" /><verse number="4" style="v" sid="EPH 3:4" />उके पढ के तुम जान सकथा कि मै मसीह के गुन केतका समझथो। <verse eid="EPH 3:4" /><verse number="5" style="v" sid="EPH 3:5" />जसना आतमा दवारा उनखर पवितर चेला अउ ग्यानी मनसे हे परगट करे गय हबै, पहिले के टेम हे हइ गुन मनसेन हे परगट नेहको करे गय रथै। <verse eid="EPH 3:5" /><verse number="6" style="v" sid="EPH 3:6" />ऊ गुप्त बात हइ हबै कि संदेस के दवारा यहूदियन के संग गैर यहूदी मनसे अक्ठी बिरासत के हकदार हबै, अकठिन देह के अंग हबै अउ मसीह यीसु हे जउन टीमा हमके दय गय हबै ओहमा सामिल हबै।<verse eid="EPH 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 3:7" />मै भगवान के अनुगरह के ऊ बरदान के जसना, जउन ओखर सक्ति के परभाव के जसना मोके दय गइस, ऊ संदेस के सेबक बना। <verse eid="EPH 3:7" /><verse number="8" style="v" sid="EPH 3:8" />मै सगलू पवितर मनसेन मसे नान लग नान हव, मोके हइ अनुगरह मिलिस कि मै गैर यहूदी के मसीह के संदेस के बारे हे गुठे सको। <verse eid="EPH 3:8" /><verse number="9" style="v" sid="EPH 3:9" />अउ सगलू मनसेन के हइ दिखाय सको कि दुनिया के सुरु लग भगवान हे लुके हर सही के खासियत काहिन हबै, जिनही यीसु मसीह के दवारा सगलू कुछु बनाय रथै। <verse eid="EPH 3:9" /><verse number="10" style="v" sid="EPH 3:10" />ताकि अब मंडली के दवारा, भगवान के कइन मेर के सिक्छा उन सासक अउ साहबन हे जउन स्वरग के जिघा हे हबै, परगट करे जाय। <verse eid="EPH 3:10" /><verse number="11" style="v" sid="EPH 3:11" />जेही भगवान हमर परभु यीसु मसीह हे अपन पहिलेन लग अपन इक्छा के पूर करै के निता हमही ठहराय रथै। <verse eid="EPH 3:11" /><verse number="12" style="v" sid="EPH 3:12" />जेहमा हमही ओखर उप्पर बिस्वास करै लग हिम्मत अउ आसरा के संग भगवान के लिघ्घो जथन। <verse eid="EPH 3:12" /><verse number="13" style="v" sid="EPH 3:13" />इहैनिता मै तुम्हर लग बिनती करथो कि तुम्हर जउन दुख मोके हबै, उनखर कारन हिम्मत झइ हारा, काखे इहै तुम्हर निता महिमा के बात हबै।<verse eid="EPH 3:13" /></para>
  <para style="s">मसीह के माया</para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 3:14" />मै इहै कारन ऊ बाफ के आगू घुटवा टेकथो, <verse eid="EPH 3:14" /><verse number="15" style="v" sid="EPH 3:15" />जेखर दवारा स्वरग अउ भुंइ हे हर अक्ठी परवार कर नाम रखे जथै, <verse eid="EPH 3:15" /><verse number="16" style="v" sid="EPH 3:16" />कि उनखर महिमा के डेरा के जसना तुमके हइ दान दे कि तुम ओखर आतमा लग अपन भित्तर के सक्ति पाय बलवान होउत जा। <verse eid="EPH 3:16" /><verse number="17" style="v" sid="EPH 3:17" />अउ बिस्वास के दवारा तुम्हर हिरदय हे मसीह बसै, तुम्हर जर अउ नीह माया हे टिके रहै। <verse eid="EPH 3:17" /><verse number="18" style="v" sid="EPH 3:18" />ताकि सगलू भगवान के पवितर मनसेन के संग मिलके हइ समझै के सक्ति रखै, कि मसीह के माया केतका लम्बा अउ चउडा हबै, केतका ऊंच अउ गहिरा हबै? <verse eid="EPH 3:18" /><verse number="19" style="v" sid="EPH 3:19" />अउ मसीह के ऊ माया के जान सका जउन समझ लग बाहिर हबै, ताकि तुम भगवान के सगलू भरपूर हे हुइ जा।<verse eid="EPH 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 3:20" />अब जउन असना सक्ति हबै, कि हमर जीवन हे काम करै बाले सक्ति के दवारा हमर मांगै या सोचै लग कहुं जादा करै के काबिल हबै। <verse eid="EPH 3:20" /><verse number="21" style="v" sid="EPH 3:21" />ओखर महिमा मंडली हे अउ मसीह यीसु हे पुरखा लग पुरखा तक सबरोज होत रहै। ओसनेन होय।<verse eid="EPH 3:21" /></para>
  <chapter eid="EPH 3" />
  <chapter number="4" style="c" sid="EPH 4" />
  <para style="s">देह के एकता</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 4:1" />इहैनिता मै जउन परभु के होमै के कारन कैदी हव, तुम्हर लग बिनती करथो, कि तुमही अपन जीवन ओसनेन जीयेका चाही। <verse eid="EPH 4:1" /><verse number="2" style="v" sid="EPH 4:2" />मतलब सगलू सज्जन अउ नम्रता मेर अउ धीर धरके माया लग अक दूसर के सहि लेया, <verse eid="EPH 4:2" /><verse number="3" style="v" sid="EPH 4:3" />अउ मेल मिलाप के बंधन हे पवितर आतमा के एकता के बनाय रखैके परयास करा। <verse eid="EPH 4:3" /><verse number="4" style="v" sid="EPH 4:4" />अक्ठिन देह हबै अक्ठिन आतमा हबै अउ अक्ठिन आसा हबै, जेखर निता तुमही बोलाय गय हबै। <verse eid="EPH 4:4" /><verse number="5" style="v" sid="EPH 4:5" />अक्ठिन परभु हबै, अक्ठिन बिस्वास अउ अक्ठिन बतिस्मा हबै, <verse eid="EPH 4:5" /><verse number="6" style="v" sid="EPH 4:6" />अक्ठिन भगवान हबै जउन सबके बाफ हबै, जउन सबके उप्पर अउ सबके बीच हे अउ सब हे हबै।<verse eid="EPH 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 4:7" />पय हमर मसे हर अक्ठी के मसीह के दान के परिनाम के जसना अनुगरह मिले हबै। <verse eid="EPH 4:7" /><verse number="8" style="v" sid="EPH 4:8" />इहैनिता ऊ कथै,</para>
  <para style="q1" vid="EPH 4:8">“ऊ इटिल्ली हे चढिस,</para>
  <para style="q2" vid="EPH 4:8">अउ कैदी के बांध लइस,</para>
  <para style="q2" vid="EPH 4:8">अउ मनसेन के दान दइस।”<verse eid="EPH 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 4:9" />ऊ चढिस एखर मतलब हबै, कि ऊ पहिले भुंइ के तरी जिघा हे उतरिस<note caller="+" style="x"><char style="xo" closed="false">4:9 </char><char style="xt" closed="false"><ref loc="HEB 2:9">इब्रानिन 2:9</ref>; <ref loc="JHN 3:13">यूहन्ना 3:13</ref></char></note>। <verse eid="EPH 4:9" /><verse number="10" style="v" sid="EPH 4:10" />ऊ जउन तरी उतरिस ऊ उहै हबै, जउन बादर लग उप्पर कढ गइस, ताकि ऊ सगलू कुछु पूर कर सकै। <verse eid="EPH 4:10" /><verse number="11" style="v" sid="EPH 4:11" />ऊ यीसु रथै ऊ कुछ के चेला कुछ के ग्यानी मनसे, कुछ के संदेस के परचार करै बाले अउ गुरून के ठहराय के दइ दइस। <verse eid="EPH 4:11" /><verse number="12" style="v" sid="EPH 4:12" />ताकि पवितर मनसे सेबा के निता तइयार करे जाय अउ मसीह के देह मतलब मंडली के उन्नत होय। <verse eid="EPH 4:12" /><verse number="13" style="v" sid="EPH 4:13" />जब तक कि हम सबके सब बिस्वास अउ भगवान कर टोरवा के चीनारी हे, अक्ठी नेहको हुइ जइ अउ अक्ठी दिमाक बाले मनसे नेहको बन जइ अउ मसीह के पूर भुंइ अउ बादर तक नेहको बढ जइ। <verse eid="EPH 4:13" /><verse number="14" style="v" sid="EPH 4:14" />तब हम लरका नेहको रहिबे, जउन मनसे के नरै बाले नियम अउ चतुर लग उनखर भरमामै बाले सक्ति के अउ संदेस के हर अक्ठी झोका लग उछालै अउ इछो-उछो बहकाय झइ जउबे। <verse eid="EPH 4:14" /><verse number="15" style="v" sid="EPH 4:15" />पय माया के संग सही बोलत अउ मसीह के जसना जउन मंडली के मूड हबै, हर मेर लग बढत जा। <verse eid="EPH 4:15" /><verse number="16" style="v" sid="EPH 4:16" />जेखर लग सगलू देह हर अक्ठी जोड के मदद लग अक संग मिलके अउ अक संग बंधके, ऊ परभाव के जसना जउन हर अक्ठी अंग के निक्खा काम करै के दवारा ओहमा होथै, खुदय के बढाथै कि ऊ माया हे उन्नत करत जाय।<verse eid="EPH 4:16" /></para>
  <para style="s">मसीह हे नबा जीवन</para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 4:17" />इहैनिता मै हइ कथो अउ परभु हे बिनती करथो कि जसना गैर यहूदी मनसे अपन मन के बेकार नियम हे चलथै, तुम अब लग फेरै असना चाल झइ चला। <verse eid="EPH 4:17" /><verse number="18" style="v" sid="EPH 4:18" />काखे उनखर दिमाक अंधियार हुइ गय हबै अउ ऊ मन के कठोरता के कारन उन भगवान के जीवन लग अलगे करे गय हबै, <verse eid="EPH 4:18" /><verse number="19" style="v" sid="EPH 4:19" />उन सबैमेर लग सुन्न हुइ गय हबै, काखे उन गन्दा काम अउ लगेतार लालच गलत काम असुध्द उनखर मन हे आथै।<verse eid="EPH 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 4:20" />पय मसीह के बारे हे तुम जउन जाने हबा, उन असना नेहको हबै। <verse eid="EPH 4:20" /><verse number="21" style="v" sid="EPH 4:21" />मोके कउनो संका नेहको हबै, कि तुम ओखर बारे हे सुने हबा अउ ऊ सही जउन यीसु हे आथै, ओखर जसना तुमही ओखर चेला के रूप हे सिखाय गय हबा। <verse eid="EPH 4:21" /><verse number="22" style="v" sid="EPH 4:22" />अपन पुरान चाल चलन के जीवन के छांड दा जउन भरमामै बाले अउ अभिलासा धोखा के चाहत लग बिगडत हबै। <verse eid="EPH 4:22" /><verse number="23" style="v" sid="EPH 4:23" />अउ अपन मन के आतमा के आदत हे नबा बनत जा, <verse eid="EPH 4:23" /><verse number="24" style="v" sid="EPH 4:24" />अउ नबा जीवन के पहिन लेया जउन भगवान के रूप हे सही के नियाइपन अउ पवितरता हे बनाय गय हबा<note caller="+" style="x"><char style="xo" closed="false">4:24 </char><char style="xt" closed="false"><ref loc="COL 3:10">कुलुस्सियो 3:10</ref>; <ref loc="2CO 5:17">2 कुरि 5:17</ref></char></note>।<verse eid="EPH 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 4:25" />इहैनिता तुम झूठ बोलै के छांड के हर अक्ठी अपन परोसी लग सही बोला, काखे हम अपन हे अक दूसर के अंग हबन<note caller="+" style="x"><char style="xo" closed="false">4:25 </char><char style="xt" closed="false"><ref loc="ZEC 8:16">जकर 8:16</ref>; <ref loc="COL 3:9">कुलुस्सियो 3:9</ref>; <ref loc="ROM 12:10">रोमियो 12:10</ref></char></note>। <verse eid="EPH 4:25" /><verse number="26" style="v" sid="EPH 4:26" />गुस्सा ता करा, पय पाप झइ करा, बेरा बुडै लग पहिले तुम्हर गुस्सा कढ जाय<note caller="+" style="x"><char style="xo" closed="false">4:26 </char><char style="xt" closed="false"><ref loc="PSA 4:4">भजन 4:4</ref></char></note>, <verse eid="EPH 4:26" /><verse number="27" style="v" sid="EPH 4:27" />भुतवा के मउका झइ देया। <verse eid="EPH 4:27" /><verse number="28" style="v" sid="EPH 4:28" />जउन मनसे पहिले चोरी करे करथै, ऊ अब चोरी झइ करै, पय निक्खा धंधा हे अपन हाथन लग मेहनत करै, ताकि जरूरत मनसेन के देय के निता ओखर लिघ्घो कुछु होय। <verse eid="EPH 4:28" /><verse number="29" style="v" sid="EPH 4:29" />कउनो मेर के गन्दा बात तुम्हर मुंह लग झइ निकरै, पय उहै जउन निक्खा बात होय अउ उन्नत के निता फायदा होय, असना बात जउन सुनै बाले के अनुगरह होय, असना बात मुंह लग निकरै। <verse eid="EPH 4:29" /><verse number="30" style="v" sid="EPH 4:30" />तुम भगवान बाफ के पवितर आतमा के दुखी झइ करा, जेखर लग तुम्हर उप्पर मुकति के रोज के निता छाप दय गय हबै<note caller="+" style="x"><char style="xo" closed="false">4:30 </char><char style="xt" closed="false"><ref loc="ISA 65:10">यसा 65:10</ref>; <ref loc="EPH 1:13-14">इफिसियों 1:13-14</ref></char></note>। <verse eid="EPH 4:30" /><verse number="31" style="v" sid="EPH 4:31" />तुम सबैमेर के कडवाहट, जलजलाहट, गुस्सा, झगडा, बुरा बोलै बाले, निन्दा अउ चोट पहुंचामै बाले बात तुम्हर लग दुरिहां रहै। <verse eid="EPH 4:31" /><verse number="32" style="v" sid="EPH 4:32" />बलुक तुम तरस लग भरे रहा अउ किरपा करै बाले बना, जसना भगवान मसीह के कारन तुमही छमा करे हबै।<verse eid="EPH 4:32" /></para>
  <chapter eid="EPH 4" />
  <chapter number="5" style="c" sid="EPH 5" />
  <para style="s">उजियार के लरका बना</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 5:1" />इहैनिता पिरिया लरकन के जसना भगवान के बात मानै बाले बना, <verse eid="EPH 5:1" /><verse number="2" style="v" sid="EPH 5:2" />जउन मेर लग मसीह हमर लग माया करिस अउ खुदय के महकनी तेल के मेर भगवान के निता अक्ठी चढावा अउ बलि के रूप हे चढाय दइस, उहै मेर माया के जीवन जिया<note caller="+" style="x"><char style="xo" closed="false">5:2 </char><char style="xt" closed="false"><ref loc="JHN 13:34">यूहन्ना 13:34</ref>; <ref loc="GAL 2:20">गलातियों 2:20</ref></char></note>।<verse eid="EPH 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 5:3" />जसना पवितर मनसेन के निता जरूरी हबै, तुम्हर बीच हे गलत सबंध झइ होय, अउ कउनो मेर के असुध्द या लालच के जसना बात सुनै के झइ मिलै। <verse eid="EPH 5:3" /><verse number="4" style="v" sid="EPH 5:4" />अउ तुम्हर बीच गन्दा बात अउ बेवकूफी के बात, बेकार मजाक जउन जरूरी नेहको हबै, हइ बात सोभा नेहको देथै, बलुक अच्छी बात बोला अउ धन्यबाद देया। <verse eid="EPH 5:4" /><verse number="5" style="v" sid="EPH 5:5" />काखे तुम हइ जानथा कि कउनो गलत काम या असुध्द, लालची मनसे जउन मूरती पूजा के बरोबर हबै, मसीह अउ भगवान के राज के हकदार नेहको हुइ सकथै।<verse eid="EPH 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EPH 5:6" />कउ तुमके बेकार बातन लग धोखा झइ दे, काखे इन कामन के कारन भगवान के गुस्सा आदेस न मानै बाले के उप्पर भडकथै। <verse eid="EPH 5:6" /><verse number="7" style="v" sid="EPH 5:7" />इहैनिता तुम उन मनसेन के संगत झइ करा। <verse eid="EPH 5:7" /><verse number="8" style="v" sid="EPH 5:8" />काखे तुम पहिले अंधियार हे रहा, पय अब परभु हे उजियार हबा अउ उजियार के टोरवा के जसना चला, <verse eid="EPH 5:8" /><verse number="9" style="v" sid="EPH 5:9" />जछो उजियार हबै, उछो हर मेर के भलाई, नियाइपन धरमी काम अउ सच्चाई पइदा होथै। <verse eid="EPH 5:9" /><verse number="10" style="v" sid="EPH 5:10" />अउ हइ परखा कि परभु के काहिन भाउथे? <verse eid="EPH 5:10" /><verse number="11" style="v" sid="EPH 5:11" />अंधियार के बेकार कामन के सहभागी कउनो मेर साझा झइ रखबे, पय उनके सबके आगू परगट करिहा। <verse eid="EPH 5:11" /><verse number="12" style="v" sid="EPH 5:12" />काखे उन बातन के बारे हे जिनही ऊ लुके मेर करथै, मुंह लग कहै हे सरम आथै। <verse eid="EPH 5:12" /><verse number="13" style="v" sid="EPH 5:13" />पय ऊ सगलू बात जिनखर बारे हे गुठे जथै, उजियार हे आमै लग सब कुछु परगट हुइ जथै। <verse eid="EPH 5:13" /><verse number="14" style="v" sid="EPH 5:14" />इहैनिता कथै,</para>
  <para style="q1" vid="EPH 5:14">“तुम जउन सोथा, जग जा,</para>
  <para style="q2" vid="EPH 5:14">अउ मरे हर मसे जी जा,</para>
  <para style="q1" vid="EPH 5:14">ता मसीह के उजियार तुम्हर हे चमकही<note caller="+" style="x"><char style="xo" closed="false">5:14 </char><char style="xt" closed="false"><ref loc="ISA 7:1">यसा 7:1</ref>; <ref loc="ROM 13:11-12">रोमियो 13:11-12</ref></char></note>।”<verse eid="EPH 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 5:15" />इहैनिता सचेत रहा कि तुम कइसन रथा, बेवकूफ मनसेन के मेर झइ रहा, बलुक दिमाक बाले के जसना रहा। <verse eid="EPH 5:15" /><verse number="16" style="v" sid="EPH 5:16" />टेम के कीमती समझा, काखे दिन बेकार हबै<note caller="+" style="x"><char style="xo" closed="false">5:16 </char><char style="xt" closed="false"><ref loc="AMO 7:13">अमोस 7:13</ref>; <ref loc="COL 4:5">कुलुस्सियो 4:5</ref></char></note>। <verse eid="EPH 5:16" /><verse number="17" style="v" sid="EPH 5:17" />इहैनिता नदान झइ बना, पय धियान लग समझा कि परभु के इक्छा काहिन हबै।<verse eid="EPH 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EPH 5:18" />दारू लग दुरिहां रहा, काखे एखर लग जीवन बेकार हुइ जथै, पय पवितर आतमा लग भर जा<note caller="+" style="x"><char style="xo" closed="false">5:18 </char><char style="xt" closed="false"><ref loc="PRO 23:31-32">नीति 23:31-32</ref>; <ref loc="GAL 5:21-25">गलातियों 5:21-25</ref></char></note>, <verse eid="EPH 5:18" /><verse number="19" style="v" sid="EPH 5:19" />अउ आपस हे भजन अउ महिमा अउ आतमिक गीत गाय करिहा अउ अपन-अपन मन हे परभु के भजन करत रइहा<note caller="+" style="x"><char style="xo" closed="false">5:19 </char><char style="xt" closed="false"><ref loc="COL 3:16">कुलुस्सियो 3:16</ref>; <ref loc="1CO 14:26">1 कुरि 14:26</ref></char></note>। <verse eid="EPH 5:19" /><verse number="20" style="v" sid="EPH 5:20" />अउ हरमेसा सगलू बातन के निता हमर परभु यीसु मसीह के नाम लग भगवान बाफ के धन्यबाद करत रइहा।<verse eid="EPH 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 5:21" />मसीह के डर लग अक दूसर के वस हे रहा।<verse eid="EPH 5:21" /></para>
  <para style="s">डउका अउ डउकी</para>
  <para style="p">
    <verse number="22" style="v" sid="EPH 5:22" />हे डउकी अपन डउका के वस हे रहै, जसना परभु यीसु मसीह के<note caller="+" style="x"><char style="xo" closed="false">5:22 </char><char style="xt" closed="false"><ref loc="COL 3:18">कुलुस्सियो 3:18</ref>; <ref loc="1PE 3:1">1 पतरस 3:1</ref>; <ref loc="GEN 3:16">उत्पति 3:16</ref></char></note>। <verse eid="EPH 5:22" /><verse number="23" style="v" sid="EPH 5:23" />काखे डउका डउकी के मूड हबै जसना कि मसीह मंडली के मूड हबै, इहै देह के ऊ मुकति करै बाले हबै। <verse eid="EPH 5:23" /><verse number="24" style="v" sid="EPH 5:24" />पय जसना मंडली मसीह के वस हे हबै, ओसनेन डउकियो हर बात हे अपन डउका के बात मानै।<verse eid="EPH 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 5:25" />हे डउको अपन डउका लग माया करा जसना मसीह मंडली लग माया करके खुदय के ओखर निता दइ दइस। <verse eid="EPH 5:25" /><verse number="26" style="v" sid="EPH 5:26" />कि उके बचन के दवारा पानी लग सुध्द करके पवितर करै। <verse eid="EPH 5:26" /><verse number="27" style="v" sid="EPH 5:27" />अउ उके अक्ठी असना तेज मंडली बनाय के अपन लिघ्घो ठाढ करै, जेहमा न दाग, न झुर्री, न कउनो अउ असना चीज होय, बलुक पवितर अउ निरदोस होय। <verse eid="EPH 5:27" /><verse number="28" style="v" sid="EPH 5:28" />इहैमेर जरूरी हबै कि डउका अपन डउकी लग अपन देह के जसना माया करै। जउन अपन डउकी लग माया करथै, ऊ खुदय लग माया करथै। <verse eid="EPH 5:28" /><verse number="29" style="v" sid="EPH 5:29" />काखे कउनो कबहुन अपन देह लग बैर नेहको करथै, बलुक ओही पालन पोसन करथै, जसना मसीह मंडली के संग करथै। <verse eid="EPH 5:29" /><verse number="30" style="v" sid="EPH 5:30" />इहैनिता कि हम ओखर देह के अंग हबन। <verse eid="EPH 5:30" /><verse number="31" style="v" sid="EPH 5:31" />“हइ कारन मनसे अपन दाय-बाफ के छांड के अपन डउकी लग मिले रही, अउ ऊ दोनो अक्ठी तन हुइहीं<note caller="+" style="x"><char style="xo" closed="false">5:31 </char><char style="xt" closed="false"><ref loc="GEN 2:24">उत्पति 2:24</ref></char></note>।” <verse eid="EPH 5:31" /><verse number="32" style="v" sid="EPH 5:32" />हइ बात बडा हबै, पय मै इहै मसीह अउ मंडली के बारे हे कथो। <verse eid="EPH 5:32" /><verse number="33" style="v" sid="EPH 5:33" />पय तुम मसे हर अक्ठी अपन डउकी लग अपन जसना माया करै, अउ डउकी अपन डउका के आदर करा।<verse eid="EPH 5:33" /></para>
  <chapter eid="EPH 5" />
  <chapter number="6" style="c" sid="EPH 6" />
  <para style="s">लरका अउ दाय-बाफ</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 6:1" />हे लरका परभु हे अपन दाय-बाफ के आदेस के निक्खा माना, काखे हइ जरूरी हबै। <verse eid="EPH 6:1" /><verse number="2" style="v" sid="EPH 6:2" />“अपन दाय-बाफ के इज्जत करा हइ पहली आदेस हबै जेखर संग टीमा हबै, <verse eid="EPH 6:2" /><verse number="3" style="v" sid="EPH 6:3" />कि तोर भला होय, अउ तै भुंइ हे बोहत रोज जिन्दा रइहे<note caller="+" style="x"><char style="xo" closed="false">6:3 </char><char style="xt" closed="false"><ref loc="EXO 20:12">निरगमन 20:12</ref>; <ref loc="DEU 5:16">बेवस्थाबिबरन 5:16</ref></char></note>।”<verse eid="EPH 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 6:4" />हे बाफो, अपन लरकन के गुस्सा झइ देबाबा, बलुक परभु के सिक्छा अउ निरदेस देत उनखर पालन पोसन करा<note caller="+" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="DEU 6:7">बेवस्थाबिबरन 6:7</ref>; <ref loc="PRO 3:11-12">नीति 3:11-12</ref>; <ref loc="PRO 19:18">19:18</ref>; <ref loc="PRO 22:6">22:6</ref>; <ref loc="COL 3:2">कुलुस्सियो 3:2</ref></char></note>।<verse eid="EPH 6:4" /></para>
  <para style="s">मालिक अउ हरवाह</para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 6:5" />हे हरवाह, तुम अपन दुनिया के गुरू के आदेस साफ मन लग डर अउ इज्जत के संग उहै मेर माना जसना तुम मसीह के आदेस के मानथा। <verse eid="EPH 6:5" /><verse number="6" style="v" sid="EPH 6:6" />तुम मनसेन के खुस करै निता के उदेस्य लग देखामै के निता झइ करा, बलुक मसीह के हरवाहन के मेर असना करा, जउन सगलू मन लग भगवान के इक्छा पूर करथै। <verse eid="EPH 6:6" /><verse number="7" style="v" sid="EPH 6:7" />सच्चे मन लग मालिक के सेबा हइ मेर करत रहा माना मनसे के केबल नेहको, पय परभु के सेबा करत हबा। <verse eid="EPH 6:7" /><verse number="8" style="v" sid="EPH 6:8" />काखे तुम जानथा कि जउन कउ जइसन निक्खा काम करही, चाहे हरवाह हो चाहे या आजाद, अपन निक्खा कामन लग फडुहा परभु लग पाही।<verse eid="EPH 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 6:9" />जउन मालिक हबै, ऊ दास के संग असना बेउहार करै अउ उनके डरामै धमकामै के छांड दे, हइ धियान रखत कि तुम दोनो झन के मालिक स्वरग हे हबै, जेखर आदत हे कउनो मेर के पक्छपात नेहको हबै<note caller="+" style="x"><char style="xo" closed="false">6:9 </char><char style="xt" closed="false"><ref loc="LUK 6:33">लूका 6:33</ref>; <ref loc="LUK 6:31">6:31</ref>; <ref loc="DEU 10:17">बेवस्थाबिबरन 10:17</ref>; <ref loc="2CH 19:7">2 इति 19:7</ref></char></note>।<verse eid="EPH 6:9" /></para>
  <para style="s">आतमिक लडाई के हथियार</para>
  <para style="p">
    <verse number="10" style="v" sid="EPH 6:10" />इहैनिता परभु हे अउ ओखर सक्ति के परभाव हे बालवान बना। <verse eid="EPH 6:10" /><verse number="11" style="v" sid="EPH 6:11" />भगवान के सगलू हथियार बांध लेया कि तुम भुतवा के बेकार चाल के आगू ठाढ रह सका। <verse eid="EPH 6:11" /><verse number="12" style="v" sid="EPH 6:12" />काखे हमर झगडा खून अउ गूदा लग नेहको हबै, बलुक सासक, साहब, हइ अंधियार जुग के सक्ति अउ बादर के दुस्ट के आतमिक सक्ति के संग हबै। <verse eid="EPH 6:12" /><verse number="13" style="v" sid="EPH 6:13" />इहैनिता भगवान के सगलू हथियार बांध लेया कि तुम बुरे दिन हे सामना कर सका, अउ सब कुछ पूर करके ठाढ रही सका।<figure style="fig" alt="Roman soldier" file="lb00196c.tif" size="col" copy="Horace Knowles ©" ref="6:10">रोमन सिपाही</figure><verse eid="EPH 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 6:14" />इहैनिता अपन कनिहा सही लग कसके, नियाइपन के कपडा पहिने के ठाढ रहा<note caller="+" style="x"><char style="xo" closed="false">6:14 </char><char style="xt" closed="false"><ref loc="ISA 11:5">यसा 11:5</ref>; <ref loc="ISA 59:17">59:17</ref></char></note>। <verse eid="EPH 6:14" /><verse number="15" style="v" sid="EPH 6:15" />अउ गोड हे मेल के संदेस के तइयारी के बूट पहिन के<note caller="+" style="x"><char style="xo" closed="false">6:15 </char><char style="xt" closed="false"><ref loc="ISA 52:7">यसा 52:7</ref>; <ref loc="NAM 1:15">नहूम 1:15</ref></char></note>। <verse eid="EPH 6:15" /><verse number="16" style="v" sid="EPH 6:16" />हइ सब लग बडी बात हइ हबै, कि बिस्वास के ढाल के रूप हे लइ लेया, जेखर दवारा तुम भुतवा के उन सगलू जलत तीरन के बुझवा सका। <verse eid="EPH 6:16" /><verse number="17" style="v" sid="EPH 6:17" />एखर अलाबा मुकति के टोपी पहिन लेया अउ आतमा के तलबार मतलब भगवान के बचन स्वीकार करा<note caller="+" style="x"><char style="xo" closed="false">6:17 </char><char style="xt" closed="false"><ref loc="ISA 49:2">यसा 49:2</ref>; <ref loc="HEB 4:12">इब्रानिन 4:12</ref>; <ref loc="ISA 59:17">यसा 59:17</ref></char></note>। <verse eid="EPH 6:17" /><verse number="18" style="v" sid="EPH 6:18" />हर मेर के पराथना बिनती अउ निबेदन सहित आतमा के मदद लग हर मउका हे पराथना करत रहा, हइ लक्छ लग सगलू मेर के परयास करत रहा सचेत रहा, अउ सगलू पवितर सेबकन के निता पराथना करा। <verse eid="EPH 6:18" /><verse number="19" style="v" sid="EPH 6:19" />अउ मोरो निता पराथना करा, कि मोर मुंह बोलै लग मोके सुभ संदेस के भेद के हिम्मत के संग हिम्मत परदान करे जाय। <verse eid="EPH 6:19" /><verse number="20" style="v" sid="EPH 6:20" />इहै के निता मै सांकड हे बंधररे राजदूत के जसना सेबा करथो, पराथना करा कि मै, जउन मेर मोके बोलै चाही, उहै मेर हिम्मत के संग संदेस के परचार के सको।<verse eid="EPH 6:20" /></para>
  <para style="s">आखरी अभिवादन</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 6:21" />तुखिकुस, जउन परभु हे मोर पिरिया भाई अउ अक्ठी बिस्वास के काबिल सेबक हबै, तुमके मोर सगलू परेसानी अउ गति बिधि लग पहचान करा देही। <verse eid="EPH 6:21" /><verse number="22" style="v" sid="EPH 6:22" />ओही मै तुम्हर लिघ्घो इहैनिता पठोय हबो कि तुम हमर हालत के जाना, अउ ऊ तुम्हर मन के सान्ति दे।<verse eid="EPH 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EPH 6:23" />भगवान बाफ अउ परभु यीसु मसीह के पल्ला लग भाई बेहन के सान्ति अउ बिस्वास सहित माया मिलै। <verse eid="EPH 6:23" /><verse number="24" style="v" sid="EPH 6:24" />जउन हमर परभु यीसु मसीह लग माया करथै, उनखर उप्पर भगवान के अनुगरह होउत रहै।<verse eid="EPH 6:24" /></para>
  <chapter eid="EPH 6" />
</usx>