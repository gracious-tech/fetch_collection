<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2TH" style="id">- Bhumiya Standard Project</book>
  <para style="h">थिस्स</para>
  <para style="toc3">2 थिस्स</para>
  <para style="toc2">2 थिस्स</para>
  <para style="toc1">2 थिस्सलुनीकियन मंडली के निता पोलुस कर चिट्ठी</para>
  <para style="mt2">2 थिस्सलुनीकियों कलीसिया के लिए पौलुस की चिट्ठी</para>
  <para style="mt1">2 थिस्सलुनीकियन मंडली के निता पोलुस कर चिट्ठी</para>
  <para style="imt">परचा</para>
  <para style="ip">थिस्सलुनीकियन के दूसर चिट्ठी चेला पोलुस <char style="xt"><ref loc="2TH 1:1">1:1</ref> </char>के दवारा लिखे गय रथै, ऊ हइ चिट्ठी 1 थिस्सलुनीकियन के कुछ टेम बाद, मसीह के जनम के करीबन 51 साल बाद लिखे गय रथै, पोलुस अबहुन तक कुरिन्थी हे रथै, जब ऊ थिस्सलुनीके के मंडली के हइ चिट्ठी लिखथै, अक्ठी मंडली जिहां ऊ अपन दूसर सेबकाई यातरा हे स्थापित करे रथै। <char style="xt"><ref loc="ACT 17:1-10">प्रेरितो 17:1-10</ref></char> चेलन के काम के किताब हे हइ कहे गय हबै, कि मंडली कुछ यहूदियन अउ नबा यूनानियन लग बने रथै।</para>
  <para style="ip">थिस्सलुनीकियन के मंडली के सबंध आखरी के टेम अउ मसीह के दूसर आगमन लग रहे होही, काखे पोलुस थिस्सलुनीकियन के लिखे अपन दुनो चिट्ठन हे एखर बारे हे बोहत कुछ लिखे रथै। 2 थिस्सलुनीकियन मसे करीबन आधा आखरी टेम के बारे हे हबै। पोलुस आलसी मनसे के खिलाफ चेतन्त दइस, हर मनसे के अपन भोजन के निता काम करै चाही। <char style="xt"><ref loc="2TH 3:6-10">3:6-10</ref> </char></para>
  <para style="iot">रूप रेखा</para>
  <para style="io1">1. पोलुस अपन अउ अपन संगी के परचा देत सुरुवात करथै। <char style="ior"><ref loc="2TH 1:1-2">1:1-2</ref></char></para>
  <para style="io1">2. तब ऊ थिस्सलुनीके के मंडली के निता भगवान के धन्यबाद करथै अउ ओखर निता बिनती करथै। <char style="ior"><ref loc="2TH 1:3-12">1:3-12</ref> </char></para>
  <para style="io1">3. पोलुस आखरी के टेम के बारे हे बोलथै। <char style="ior"><ref loc="2TH 2">2</ref> </char></para>
  <para style="io1">4. तब ऊ आलसी अउ काम करै के जरुरत के बिरोध बोलथै। <char style="ior"><ref loc="2TH 3:1-15">3:1-15</ref></char></para>
  <para style="io1">5. पोलुस मंडली के फेरै लग नमस्ते करके समापत करथै। <char style="ior"><ref loc="2TH 3:16-18">3:16-18</ref></char></para>
  <chapter number="1" style="c" sid="2TH 1" />
  <para style="s">सोगत</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 1:1" />थिस्सलुनीकियन सहर के मंडली के, जउन बाफ भगवान अउ परभु यीसु मसीह हे हबै, पोलुस, सिलवानुस अउ तीमुथियुस के पल्ला लग।<verse eid="2TH 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2TH 1:2" />हमर बाफ भगवान अउ परभु यीसु मसीह के तरफ लग तुमही अनुगरह किरपा अउ सान्ति मिलत रहै।<verse eid="2TH 1:2" /></para>
  <para style="s">मसीह कर आमै के टेम नियाव</para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 1:3" />हे भाई अउ बेहन, तुम्हर बारे हे भगवान के हरमेसा धन्यबाद करैका चाही, अउ हइ जरूरी हबै काखे तुम्हर बिस्वास बोहत बढिहा मेर बढत हबै, अउ तुम सब हे अक दूसर लग माया बढत हबै। <verse eid="2TH 1:3" /><verse number="4" style="v" sid="2TH 1:4" />इहैनिता हम खुद भगवान के मंडली हे तुम्हर हे घमंड करथै, काखे उन सब हे तुम्हर धीर अउ बिस्वास परगट होथै, कि हर मेर के दुख तकलीप अउ पीरा सहत हबा।<verse eid="2TH 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 1:5" />हइ सब भगवान के सच्चे नियाव के फइसला के अक्ठी सही सबूत हबै, जेखर दवारा तुम भगवान कर राज के ओग समझे जइहा, जेखर निता तुम सब दुख भोगत हबा। <verse eid="2TH 1:5" /><verse number="6" style="v" sid="2TH 1:6" />इहैनिता भगवान के निता हइ सही हबै कि उनोन के दुख दे, जउन तुमही दुख देथै, <verse eid="2TH 1:6" /><verse number="7" style="v" sid="2TH 1:7" />अउ जउन तुमही परेसान करत हबै, उनोन को अराम दे, हइ तब होही जब परभु यीसु मसीह स्वरग लग अपन सक्तिसाली स्वरगदूतन के संग धंधकत आगी हे परगट होही, <verse eid="2TH 1:7" /><verse number="8" style="v" sid="2TH 1:8" />तब ऊ टेम उन मनसेन लग बदला लेही, जउन भगवान के नेहको जानथै अउ हमर परभु यीसु मसीह के संदेस के नेहको मानथै। <verse eid="2TH 1:8" /><verse number="9" style="v" sid="2TH 1:9" />असना मनसेन के सबरोज के निता नास करे जही, अउ परभु यीसु मसीह के आगू लग दुरिहां के दय जही। <verse eid="2TH 1:9" /><verse number="10" style="v" sid="2TH 1:10" />हइ ऊ रोज होही जब परभु अपन पवितर मनसेन के बीच महिमा के संग परगट होही अउ उन सब हे चकित के कारन बन जइही, जउन बिस्वास करे हबै, काखे तुम हमर गवाह हे बिस्वास करे हबा।<verse eid="2TH 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 1:11" />हम लगेतार तुम्हर निता पराथना बिनती करथन, हमार भगवान तुमही अपन बुलउवा के काबिल समझै, अउ तुम्हर हर निक्खा इक्छा अउ बिस्वास के हर अक्ठी काम के सक्ति लग पूर करत जा। <verse eid="2TH 1:11" /><verse number="12" style="v" sid="2TH 1:12" />हइ मेर हमर भगवान अउ परभु यीसु मसीह के अनुगरह किरपा के जसना तुम्हर हे हमर परभु यीसु मसीह के नाम तुम्हरे हे महिमा पाबै अउ तुम ओखर हे।<verse eid="2TH 1:12" /></para>
  <chapter eid="2TH 1" />
  <chapter number="2" style="c" sid="2TH 2" />
  <para style="s">नियम के नेहको मानै बाले मनसे</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 2:1" />हे भाई अउ बेहन, हमर परभु यीसु मसीह के आमै लग अउ ओखर आगू अकठ्ठा होमै के बारे हे तुम्हर लग बिनती करथन, <verse eid="2TH 2:1" /><verse number="2" style="v" sid="2TH 2:2" />कउनो आतमा, बचन या चिट्ठी के दवारा, जउन हमार तरफ लग जान पडही, तुम असानी लग हइ समझ के झइ परेसान हुइहा अउ न घबरइहा कि परभु के दिन आय चुके हबै। <verse eid="2TH 2:2" /><verse number="3" style="v" sid="2TH 2:3" />कउनो तुमही कउनो मेर लग झइ बहकाबै, काखे ऊ रोज तब तक नेहको आही जब तक पहिले लडाई झगडा नेहको हुइ जही अउ ऊ “अधरम डउका” परगट नेहको हुइ जही, जेखर बिनास जरूरी हबै। <verse eid="2TH 2:3" /><verse number="4" style="v" sid="2TH 2:4" />ऊ अपन घमंड हे उन सगलू के बिरोध करथै, अउ उनखर लग खुद के बडा मानथै, जउन देउता कहाथै, या पवितर समझे जथै, इहां तक कि ऊ भगवान के मन्दिर हे बइठके खुद के भगवान होयके दाबा करथै।<verse eid="2TH 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 2:5" />का तोके सुरता नेहको हबै कि जब मै तुम्हर इहां रहों, ता तुम्हर लग हइ बात कहे करथो? <verse eid="2TH 2:5" /><verse number="6" style="v" sid="2TH 2:6" />अब तुम हइ जानथा कि कउन सक्ति अबे उके रोके हबै, जेखर लग ऊ उदेस्य के निता अपन सही टेम लग परगट झइ होय। <verse eid="2TH 2:6" /><verse number="7" style="v" sid="2TH 2:7" />काखे अधरम के लुके हर बात अबे तक काम करथै, पय ऊ तब तक लुके रही, जब तक रोके बाले परगट नेहको हुइ जाय। <verse eid="2TH 2:7" /><verse number="8" style="v" sid="2TH 2:8" />तब ऊ “अधरम” परगट होही, जेखर लग परभु यीसु अपन मुंह के फूक लग नास करही अउ अपन आमै बाले हे अपन उपस्थित लग उके नास के देही। <verse eid="2TH 2:8" /><verse number="9" style="v" sid="2TH 2:9" />अधरम के परगट होमै लग भुतवा के काम के जसना सब मेर के झूठ सक्ति चकित चिन्हा के संग होही। <verse eid="2TH 2:9" /><verse number="10" style="v" sid="2TH 2:10" />नास होमै बाले मनसेन के हर मेर के अधरम भरम हे डारथै, काखे उन सही माया नेहको करिन, जउन उनही मुकति करै के निता सक्ति रथै। <verse eid="2TH 2:10" /><verse number="11" style="v" sid="2TH 2:11" />इहै कारन भगवान ओहमा अक्ठी भटकाय दे बाले सक्ति पठोही, काखे उन झूठ बात हे बिस्वास करथै। <verse eid="2TH 2:11" /><verse number="12" style="v" sid="2TH 2:12" />कि उन सगलू जउन कउ सही हे बिस्वास नेहको करे हबै, पय केबल अधरम हे खुस होथै, उन सब के सजा मिलही।<verse eid="2TH 2:12" /></para>
  <para style="s">तुम मुकति पामै के निता चुने गय हबा</para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 2:13" />हे भाई अउ बेहन, परभु तुम्हर लग माया करथै, हमके परभु भगवान के तुम्हर बारे हे लगेतार धन्यबाद दे चाही, भगवान के पहिला फडुहा के रूप हे तुमही चुने हबै, जेखर लग तुम पवितर करैबाले आतमा के दवारा अउ सत्य हे अपन बिस्वास दवारा मुकति पामै। <verse eid="2TH 2:13" /><verse number="14" style="v" sid="2TH 2:14" />उहै उदेस्य के निता ऊ हमर संदेस के परचार के दवारा तुमही बुलाय हबै, जेखर लग तुम हमर परभु यीसु मसीह के महिमा हे सामिल हुइ सका। <verse eid="2TH 2:14" /><verse number="15" style="v" sid="2TH 2:15" />इहैनिता हे भाई अउ बेहन, तुम बिस्वास हे मजबूत बने रहा, अउ रीति रिबाज के पालन करा जेखर ग्यान तुम्हे मउखिक रूप लग या चिट्ठी के दवारा हमर लग मिले हबै।<verse eid="2TH 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 2:16" />हमर परभु यीसु मसीह अउ हमर भगवान बाफ, जउन हमर लग माया करिस, अउ अनुगरह किरपा लग सबरोज के सान्ति अउ निक्खा आसा दय हबै, <verse eid="2TH 2:16" /><verse number="17" style="v" sid="2TH 2:17" />तुम्हर मन के खुसी दे अउ हर निक्खा बात हे जेही तुम कथा या करथा, तुमके मजबूत बनाय रखै।<verse eid="2TH 2:17" /></para>
  <chapter eid="2TH 2" />
  <chapter number="3" style="c" sid="2TH 3" />
  <para style="s">बिनती करिस</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 3:1" />हे भाई, आखरी हे हइ तुम हमर निता पराथना बिनती करा, जेखर लग परभु के बचन हरबी फइल जाय अउ महिमा पाबै सब जिघा इज्जत के संग स्वीकार करे जाय, जसना कि तुम्हर बीच हे हुइस। <verse eid="2TH 3:1" /><verse number="2" style="v" sid="2TH 3:2" />अउ हम टेढवा अउ बेकार मनसेन लग बच निकरी, काखे हर कउ परभु हे बिस्वास करे बाले नेहको होथै।<verse eid="2TH 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 3:3" />पय परभु बिस्वास के काबिल हबै, ऊ तुमके मजबूत बनाय रखही अउ बुराई लग तोके बचाय रखही। <verse eid="2TH 3:3" /><verse number="4" style="v" sid="2TH 3:4" />हमके परभु हे तुम्हर उप्पर पूर बिस्वास हबै कि जउन-जउन आदेस हम तुमके देथन, उनके तुम मानथा अउ मानत रइहा।<verse eid="2TH 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 3:5" />परभु तुम्हर मन के भगवान के माया अउ मसीह यीसु के धीर के पल्ला अगुवाई करै।<verse eid="2TH 3:5" /></para>
  <para style="s">मेहनत के रोटी</para>
  <para style="p">
    <verse number="6" style="v" sid="2TH 3:6" />हे भाई अउ बेहन परभु यीसु मसीह के नाम हे तुमके आदेस देथन कि तुम असना हर मनसे लग दुरिहां रहा, जउन रीति रिबाज हे नेहको चलथै, जउन हमर दवारा दय गय ग्यान के पालन नेहको करथै। <verse eid="2TH 3:6" /><verse number="7" style="v" sid="2TH 3:7" />हइ तुमके पता हबै कि तुम्हर निता हमर जसना चाल चलै का सही हबै, काखे तुम्हर बीच हे रहत हम ढिलवा नेहको रहन, <verse eid="2TH 3:7" /><verse number="8" style="v" sid="2TH 3:8" />एतका ही नेहको, हम कउनो के इहां पइसा दय बगैर खाना नेहको खायन, पय हम रात-दिन मेहनत करन अउ काम करत रहन कि हम तुम मसे कउनो के निता भार झइ बनी। <verse eid="2TH 3:8" /><verse number="9" style="v" sid="2TH 3:9" />असना नेहको कि हमके तुम्हर लग मदद ले का कउनो हक नेहको हबै, बलुक हम इहैनिता बोहत मेहनत करत रहन ताकि तुमो हमर जसना चाल चला। <verse eid="2TH 3:9" /><verse number="10" style="v" sid="2TH 3:10" />इहां तक कि जब हम तुम्हर बीच हे रहन, हम तुमके हइ आदेस दय करन कि कउनो ढिलवा मनसे के खाना नेहको दय जाय।<verse eid="2TH 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 3:11" />हमके सुनै काहिन मिलै हबै, कि कुछ मनसेन तुम्हर बीच हे आलसी के जीवन बिताथै, अउ कुछ काम नेहको करथै पय दूसरो के काम हे अडंगा डालथै। <verse eid="2TH 3:11" /><verse number="12" style="v" sid="2TH 3:12" />हम असना मनसेन के परभु यीसु मसीह के नाम हे आदेस देथन अउ उनखर लग बिनती करथन कि चुपचाप काम करत रहै अउ अपन कमाय हर रोटी खाय करै।<verse eid="2TH 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 3:13" />हे भाई अउ बेहन, निक्खा करै हे हिम्मत झइ हारा। <verse eid="2TH 3:13" /><verse number="14" style="v" sid="2TH 3:14" />अगर कउ हमार हइ चिट्ठी के बात नेहको मानही ता ओखर उप्पर नजर रखा, अउ ओखर संग रिस्ता टोर लेया, जेखर लग ऊ बेज्जती होय। <verse eid="2TH 3:14" /><verse number="15" style="v" sid="2TH 3:15" />तउभरमा तुम ओखर संग बैरी के जसना बेउहार झइ करिहा, बलुक भाई अउ बेहन के जसना समझाबा।<verse eid="2TH 3:15" /></para>
  <para style="s">आखरी सब्द के आसिरबाद</para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 3:16" />अब सान्ति के परभु खुदय तुमही हर टेम, हर मेर लग सान्ति देयत रहै, परभु तुम सबके संग रहै।<verse eid="2TH 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2TH 3:17" />मै पोलुस, अपन हाथ लग नमस्ते लिखथो। हइ मोर सब चिट्ठी के चिन्हा हबै, मै इहैमेर लिखथो।<verse eid="2TH 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2TH 3:18" />हमर परभु यीसु मसीह के अनुगरह किरपा तुम सबके उप्पर बने रहै।<verse eid="2TH 3:18" /></para>
  <chapter eid="2TH 3" />
</usx>