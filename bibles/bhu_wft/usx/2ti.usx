<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2TI" style="id">- Bhumiya Standard Project</book>
  <para style="h">तीमु</para>
  <para style="toc3">2 तीमु</para>
  <para style="toc2">2 तीमु</para>
  <para style="toc1">2 तीमुथियुस के निता पोलुस कर चिट्ठी</para>
  <para style="mt2">2 तीमुथियुस के लिए पौलुस की चिट्ठी</para>
  <para style="mt1">2 तीमुथियुस के निता पोलुस कर चिट्ठी</para>
  <para style="imt">परचा</para>
  <para style="ip">2 तीमुथियुस के किताब प्रेरित पोलुस के पल्ला लग अपन चेला तीमुथियुस के लिखे हर दूसर चिट्ठी हबै। 2 तीमुथियुस के पोलुस के जीवन के आखरी हे लिखे गय रथै। ऊ हइ टेम <char style="xt"><ref loc="2TI 1:16">1:16</ref></char> के दोरान रोम सहर हे जेल हे रथै। पोलुस तीमुथियुस के संग गहरा सबंध रथै अउ अक्सर उके अक्ठी टोरवा के रूप हे संदर्भित करथै। <char style="xt"><ref loc="PHP 2:22">फिलिप्पियन 2:22</ref>; <ref loc="1TI 1:2">1 तीमु 1:2</ref>; <ref loc="1TI 1:18">1:18</ref></char></para>
  <para style="ip">हइ पोलुस के चार चिट्ठी मसे अक्ठी रथै जउन अक्ठी मंडली के बजय अक्ठी मनसे संबोधित करे जथै। अउ दूसर तीन असना चिट्ठी 1 तीमुथियुस, तीतुस अउ फिलेमोन हबै। 2 तीमुथियुस के लिखे जाय के टेम, रोमन राज हे मसीहियन के सताय जात रहै। सायद इहै कारन रथै कि पोलुस जेल हे रथै अउ तीमुथियुस के कठिनाई सहै का उपदेस देथै। जसना कि 1 तीमुथियुस हे हबै, पोलुस तीमुथियुस के ठगरा गुरून के बारे हे कइन मेर के चेतन्त देथै, <char style="xt"><ref loc="1TI 1:16-18">1 तीमु 1:16-18</ref></char> ऊ तीमुथियुस लग इहो कथै कि आगू कठिन टेम होही। <char style="xt"><ref loc="2TI 3:1">3:1</ref></char></para>
  <para style="iot">रूप रेखा</para>
  <para style="io1">1. पोलुस तीमुथियुस के सोगत करै के अउ फेर ओही प्रोत्साहन करै के दवारा सुरुवात करथै। <char style="ior"><ref loc="2TI 1:1-18">1:1-18</ref></char></para>
  <para style="io1">2. फेर ऊ तीमुथियुस के धीर धरै के चुनउती देथै। <char style="ior"><ref loc="2TI 2:1-13">2:1-13</ref> </char></para>
  <para style="io1">3. एखर बाद ऊ उके कुछ अक जसना उपदेस देथै। <char style="ior"><ref loc="2TI 2:14-26">2:14-26</ref></char></para>
  <para style="io1">4. फेर ऊ उके आगू के घटनन अउ सोच बिचार सही तरीका के बारे हे चेतन्त देथै। <char style="ior"><ref loc="2TI 3:1-4:8">3:1—4:8</ref></char></para>
  <para style="io1">5. पोलुस तीमुथियुस के निता कुछ बेक्तिगत टिप्पडी के संग समापत करथै। <char style="ior"><ref loc="2TI 4:9-22">4:9-22</ref></char></para>
  <chapter number="1" style="c" sid="2TI 1" />
  <para style="s">सोगत</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 1:1" />पोलुस के पल्ला लग जउन, ऊ जीवन के टीमा के जसना मसीह यीसु हे हबै, भगवान के इक्छा लग मसीह यीसु के चेला हबै, <verse eid="2TI 1:1" /><verse number="2" style="v" sid="2TI 1:2" />पिरिया टोरवा तीमुथियुस के नाम, भगवान बाफ अउ हमर परभु यीसु मसीह के पल्ला लग तोके अनुगरह अउ दया अउ सान्ति मिलत रहै।<verse eid="2TI 1:2" /></para>
  <para style="s">तीमुथियुस कर प्रोत्साहन</para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 1:3" />मै रात दिन अपन पराथना हे तुमके सुरता करत भगवान के धन्यबाद देथो, जिनखर सेबा मै सुध्द मन लग उहै मेर करथो, जसना मोर परदादा करथै। <verse eid="2TI 1:3" /><verse number="4" style="v" sid="2TI 1:4" />तुम्हर आंसू के सुरता करत मोके तुम्हर लग मिलै के मन होथै, कि मोर खुसी पूर हुइ जाय। <verse eid="2TI 1:4" /><verse number="5" style="v" sid="2TI 1:5" />मोके तोर ऊ निस्कपट बिस्वास के सुरता हबै, जउन आगू तोर नानी लोइस अउ तोर दाय यूनीके हे रहिस, अउ मोके निस्चय हबै, कि उहै बिस्वास तोर हे हबै। <verse eid="2TI 1:5" /><verse number="6" style="v" sid="2TI 1:6" />इहै कारन मै तोके सुरता दिलाथों तै भगवान के ऊ बरदान के जउन मोर हाथ रखै के दवारा तोके मिले हबै बरत रहै। <verse eid="2TI 1:6" /><verse number="7" style="v" sid="2TI 1:7" />काखे भगवान हमके जउन आतमा दय हबै, ऊ हमके डरपोंक नेहको बनाथै, बलुक हमके माया, संयम, अउ सक्ति लग भर देथै।<verse eid="2TI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 1:8" />इहैनिता तै हमर परभु या मोर जउन ओखर निता बन्दी बने हबै, गवाह दे लग झइ लजा, बलुक तोके भगवान जउन सक्ति दय हबै, ओखर संदेस के निता मोर संग दुख उठा। <verse eid="2TI 1:8" /><verse number="9" style="v" sid="2TI 1:9" />जउन हमर मुकति करे हबै अउ पवितर जीवन जिये के निता बुलाय हबै, अउ हमर कामन के जसना नेहको, पय सबरोज लग मसीह यीसु हे हमर निता पहिले लग सउपे दय गय हबै। <verse eid="2TI 1:9" /><verse number="10" style="v" sid="2TI 1:10" />पय अब हमर मुकति करै बाले मसीह यीसु के परगट होय के दवारा हमर निता परकासित हुइस, जउन मिरतू के नास करे हबै अउ जीवन अउ अमर के संदेस के दवारा उजियार के दय हबै।<verse eid="2TI 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TI 1:11" />इहै संदेस के निता मोके अक्ठी परचारक, चेला, अउ गुरू के रूप हे चुने गय हव। <verse eid="2TI 1:11" /><verse number="12" style="v" sid="2TI 1:12" />अउ इहै कारन हबै जेखर लग मै हइ बातन के दुख उठाउत हव, अउ फेर लज्जित नेहको हव, काखे जेखर उप्पर बिस्वास करे हव, मै उके जानथो अउ मै हइ मानथो, कि ऊ मोके जउन सउपे हबै, ऊ ओखर रक्छा करै हे सक्ति हबै, <verse eid="2TI 1:12" /><verse number="13" style="v" sid="2TI 1:13" />जउन सही बात तै मोर लग सुने हबस उके ऊ बिस्वास अउ माया हे, जउन मसीह यीसु हे बसे हबै, अपन आदर्स बनाय के रख। <verse eid="2TI 1:13" /><verse number="14" style="v" sid="2TI 1:14" />अउ पवितर आतमा के दवारा जउन हमर भित्तर बसे हबै, निक्खा धरोहर के देखरेख कर।<verse eid="2TI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2TI 1:15" />तुमके हइ पता हबै कि आसिया परदेस के सगलू बिस्वासी मोर लग दुरिहां हुइ गय हबा, जेहमा फूगिलुस अउ हिरमुगिनेस हबै। <verse eid="2TI 1:15" /><verse number="16" style="v" sid="2TI 1:16" />उनेसिफुरुस के परवार हे परभु दया करै, काखे ऊ कइन मेर के मउका हे मोके सुख पहुंचाय हबै, अउ ऊ मोर जेल हे रहै सांकड लग लज्जित नेहको होय हबै। <verse eid="2TI 1:16" /><verse number="17" style="v" sid="2TI 1:17" />बलुक ऊ रोम सहर पहुंच के मोर पता लगामै का कस्ट करिस अउ ऊ मोर लग मिलै आइस। <verse eid="2TI 1:17" /><verse number="18" style="v" sid="2TI 1:18" />परभु उके हइ बरदान दे कि ऊ उस रोज परभु के दया मिलै, ऊ इफिसुस सहर हे केतका सेबा करे हबै, तै हइ अच्छी मेर लग जानथस।<verse eid="2TI 1:18" /></para>
  <chapter eid="2TI 1" />
  <chapter number="2" style="c" sid="2TI 2" />
  <para style="s">मसीह यीसु के निक्खा सिपाही</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 2:1" />इहैनिता हे मोर टोरवा, तै ऊ अनुगरह लग जउन मसीह यीसु हे हबै, बलवान हुइ जा, <verse eid="2TI 2:1" /><verse number="2" style="v" sid="2TI 2:2" />अउ जउन बात तै बोहत ले गवाहन के आगू मोर लग सुने हबस, उनके बिस्वास करे बाले मनसे के दइदे जउन दूसरन के सिखामै के काबिल होय।<verse eid="2TI 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 2:3" />मसीह यीसु के बढिहा योध्दा के जसना मोर संग दुख उठा <verse eid="2TI 2:3" /><verse number="4" style="v" sid="2TI 2:4" />जब कउनो पहलवान झगडा करे जथै, ता इहैनिता अपन भरती करै बाले के मगन करे, अपन खुद के दुनिया के कामन हे नेहको फसाथै। <verse eid="2TI 2:4" /><verse number="5" style="v" sid="2TI 2:5" />फेर अखाडे हे लडै बाले अगर नियम के जसना नेहको लडथै, ता मुकुट नेहको पाथै। <verse eid="2TI 2:5" /><verse number="6" style="v" sid="2TI 2:6" />जउन किसान मेहनत करथै, फडुहा के हिस्सा उके आगुन मिलय चाही। <verse eid="2TI 2:6" /><verse number="7" style="v" sid="2TI 2:7" />जउन मै कथो उके धियान दे, अउ परभु तोके सगलू बातन के दिमाक दइ।<verse eid="2TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 2:8" />यीसु मसीह के सुरता रख, जउन दाऊद के बिरादरी<note caller="+" style="f"><char style="fr" closed="false">2:8 </char><char style="ft" closed="false">वंस</char></note> लग हुइस अउ मरे हर मसे जिन्दा हुइ गइस, अउ हइ मोर संदेस के जसना हबै। <verse eid="2TI 2:8" /><verse number="9" style="v" sid="2TI 2:9" />जेखर निता मै कुकरमी के जसना दुख उठाथों, इहां तक कि बन्धन हे हव, पय भगवान के बचन बन्धन हे नेहको हबै। <verse eid="2TI 2:9" /><verse number="10" style="v" sid="2TI 2:10" />इहै कारन मै चुने हर मनसेन के निता सगलू कुछ सहथों, कि उनो ऊ मुकति के जउन मसीह यीसु हे सबरोज के महिमा संग पाय। <verse eid="2TI 2:10" /><verse number="11" style="v" sid="2TI 2:11" />हइ बात सच हबै,</para>
  <para style="q1" vid="2TI 2:11">कि अगर हम ओखर संग जियब,<verse eid="2TI 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="2TI 2:12" />अगर हम धीर लग सहत रहब,</para>
  <para style="q2" vid="2TI 2:12">ता ओखर संग राज करब,</para>
  <para style="q1" vid="2TI 2:12">अगर हम ओखर इन्कार करहिन,</para>
  <para style="q2" vid="2TI 2:12">ता ऊ हमर इन्कार करहिन,<verse eid="2TI 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="2TI 2:13" />अगर हम अबिस्वासी बने रथै,</para>
  <para style="q2" vid="2TI 2:13">तउभरमा ऊ बिस्वास के काबिल<note caller="+" style="f"><char style="fr" closed="false">2:13 </char><char style="ft" closed="false">बिस्वासओग</char></note> रथै,</para>
  <para style="q2" vid="2TI 2:13">काखे ऊ खुद के इन्कार नेहको कर सकथै<note caller="+" style="x"><char style="xo" closed="false">2:13 </char><char style="xt" closed="false"><ref loc="1TH 5:24">1 थिस्स 5:24</ref></char></note>।<verse eid="2TI 2:13" /></para>
  <para style="s">सिध्द कारीगर</para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 2:14" />हइ बातन के सुरता उनके दिला अउ परभु के आगू गुठे दे बातन हे बाद बिबाद झइ करै, जेखर लग कुछु फायदा नेहको होथै पय सुनै बाले बिगड जथै। <verse eid="2TI 2:14" /><verse number="15" style="v" sid="2TI 2:15" />अपन खुद के भगवान के ग्रहन ओग अउ असना काम करै बाले ठहरामै के परयास के, जउन सरमिन्दा नेहको होय पावय, अउ जउन सही के बचन के निक्खा मेर लग काम हे लानथै। <verse eid="2TI 2:15" /><verse number="16" style="v" sid="2TI 2:16" />पय असुध्द फालतू लग बचे रह, काखे असना मनसे अउ अभक्ति हे बढत जइहिन, <verse eid="2TI 2:16" /><verse number="17" style="v" sid="2TI 2:17" />अउ उनखर बचन सडे घाव के जसना बगरत जही। हुमिनयुस अउ फिलेतुस उनखरै मसे हबै, <verse eid="2TI 2:17" /><verse number="18" style="v" sid="2TI 2:18" />जउन हइ बताय के जिन्दा होय चुके हबै सही लग भटक गय हबै, अउ बोहत झन के बिस्वास के उलट पुलट के देथै। <verse eid="2TI 2:18" /><verse number="19" style="v" sid="2TI 2:19" />तउभरमा भगवान के निक्खा नीह बने रथै, अउ ओहमा हइ छाप लगे हबै, “परभु अपनो के चीनथै” अउ “जउन कउ परभु के नाम लेथै, ऊ अधरम लग बचे रहै<note caller="+" style="x"><char style="xo" closed="false">2:19 </char><char style="xt" closed="false"><ref loc="NAM 1:7">नहूम 1:7</ref></char></note>।”<verse eid="2TI 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2TI 2:20" />बडा घर हे केबल सोने चांदी के पय लकडी अउ माटी के भडवा होथै, कउ-कउ इज्जत अउ कउ अनादर के निता। <verse eid="2TI 2:20" /><verse number="21" style="v" sid="2TI 2:21" />अगर कउ अपन खुद के इनखर लग सुध्द करी, अउ स्वामी के काम आही, अउ हर निक्खा काम के निता तइयार होही। <verse eid="2TI 2:21" /><verse number="22" style="v" sid="2TI 2:22" />जबानी के लालच ले भाग, अउ जउन सुध्द मन ले परभु के नाम लेथै उनखर संग नियाइपन, अउ बिस्वास, अउ माया, अउ मेलमिलाप के पीछा के। <verse eid="2TI 2:22" /><verse number="23" style="v" sid="2TI 2:23" />पय मूरखता अउ अविद्दा के बिबादन लग अलग रह, काखे तै जानथस इनखर ले झगडा सुरुवात होथै। <verse eid="2TI 2:23" /><verse number="24" style="v" sid="2TI 2:24" />परभु के हरवाह के झगडालू नेहको होमै चाही, ऊ सबझन के संग कोमर अउ ग्यान हे निपुड अउ सहनसील होय। <verse eid="2TI 2:24" /><verse number="25" style="v" sid="2TI 2:25" />अउ बिरोधिन के नम्रता लग समझाथै, का जाने भगवान उनके मन बदलै के मन दे कि वहु सही के चीन्हे। <verse eid="2TI 2:25" /><verse number="26" style="v" sid="2TI 2:26" />अउ एखर दवारा ओखर इक्छा पूर करै के निता चेतन्त हुइके भुतवा के फान्दा लग छंडर जइ।<verse eid="2TI 2:26" /></para>
  <chapter eid="2TI 2" />
  <chapter number="3" style="c" sid="2TI 3" />
  <para style="s">आखरी रोज हे मनसे के चालचलन</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 3:1" />हइ समझ लेया कि आखरी दिन कठिन टेम आही। <verse eid="2TI 3:1" /><verse number="2" style="v" sid="2TI 3:2" />काखे मनसे मतलबी, लालची, डींगमार<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="ft" closed="false">खुद के बडाई करै बाले</char></note>, अभिमानी, निन्दा करै बाले, दाय दादा के आदेस न मानै बाले, दया न करे बाले, अपवितर, <verse eid="2TI 3:2" /><verse number="3" style="v" sid="2TI 3:3" />माया अउ दया न करे बाले, दोस लगामै बाले, असंयमी, कठोर, हर मेर के भलाई के बैरी, <verse eid="2TI 3:3" /><verse number="4" style="v" sid="2TI 3:4" />बिस्वासघाती, ढीठ<note caller="+" style="f"><char style="fr" closed="false">3:4 </char><char style="ft" closed="false">अपन बात हे अडे रइहा</char></note>, घमंडी, अउ भगवान के महिमा नेहको पय सुखबिलास के चाहे बाले हुइहिन। <verse eid="2TI 3:4" /><verse number="5" style="v" sid="2TI 3:5" />उन भक्ति के भेस धरहिन, पय ओखर सक्ति के नेहको मनहिन असना मनसेन लग बचे रइहा। <verse eid="2TI 3:5" /><verse number="6" style="v" sid="2TI 3:6" />हइ मनसे घर हे लुके-लुके घुस जथै, अउ उन मूरख डउकिन के अपन जाल हे फसाय हबै, जउन अपन पाप के भार लग दबाय के कइन मेर के अभिलासा के वस हे हबै। <verse eid="2TI 3:6" /><verse number="7" style="v" sid="2TI 3:7" />जउन हरमेसा सीखय चाहथै, पय सच्चाई के ग्यान तक पहुंचे नेहको पाथै। <verse eid="2TI 3:7" /><verse number="8" style="v" sid="2TI 3:8" />जसना यन्नेस अउ यम्ब्रेस मूसा कर बिरोध करे रथै, उहै मेर हइ मनसे सही के बिरोध करथै, इनखर दिमाक भ्रस्ट हुइ गय हबै, अउ इनखर बिस्वास असफल हबै<note caller="+" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="ACT 13:8">प्रेरितो 13:8</ref></char></note>। <verse eid="2TI 3:8" /><verse number="9" style="v" sid="2TI 3:9" />हइ सब जादा टेम तक नेहको चलही काखे उन दुनो के जसना उनखर मूरखता सबके आगू उजियार हे आय जही।<verse eid="2TI 3:9" /></para>
  <para style="s">तीमुथियुस के बिसेस निरदेस</para>
  <para style="p">
    <verse number="10" style="v" sid="2TI 3:10" />पय तै उपदेस चालचलन, मनसा, बिस्वास, सहनसीलता, माया, धीर, अउ सताय जाय अउ दुख उठामै हे मोर साथ दय। <verse eid="2TI 3:10" /><verse number="11" style="v" sid="2TI 3:11" />अउ असना सताव अउ परेसानी हे मोर साथ दय, जउन अन्ताकिया अउ इकुनियुम अउ लुस्तरा नगर हे मोर हे पडे रथै, अउ दूसर परेसानी हे जउन मै उठाय हव, पय परभु मोके उन सबले छंडाय लइस<note caller="+" style="x"><char style="xo" closed="false">3:11 </char><char style="xt" closed="false"><ref loc="PSA 34:19">भजन 34:19</ref></char></note>। <verse eid="2TI 3:11" /><verse number="12" style="v" sid="2TI 3:12" />पय जेतका मसीह यीसु हे भक्ति के संग जीवन बितामै चाहथै, उन सगलू सताय जइहिन। <verse eid="2TI 3:12" /><verse number="13" style="v" sid="2TI 3:13" />पय पापी अउ चतुर मनसे दूसर के अउ खुद के धोखा देत बत्तर होउत जइहिन। <verse eid="2TI 3:13" /><verse number="14" style="v" sid="2TI 3:14" />पय तै उन बातन हे जउन तै सीखे हबस अउ बिस्वास करे हबस, हइ जानके मजबूत बने रहा, कि उन बातन के तुम केखर लग सिखे हबा। <verse eid="2TI 3:14" /><verse number="15" style="v" sid="2TI 3:15" />इहो बचपन लग तुम पवितर किताब तोर जाने हर हबै, जउन तुम ऊ दिमाक दे हे सक्ति हबै, जेखर मसीह यीसु हे बिस्वास के दवारा मुकति मिलथै। <verse eid="2TI 3:15" /><verse number="16" style="v" sid="2TI 3:16" />सगलू पवितर किताब भगवान के अगुवाई लग लिखे गय हबै, हइ सिक्छा दे, गलत बिचार के बिरोध करै, दोस-सुधार अउ नियाइपन के सिक्छा के निता सही हबै। <verse eid="2TI 3:16" /><verse number="17" style="v" sid="2TI 3:17" />कि भगवान के मनसे पूरी तरह लग हर अक्ठी निक्खा काम के निता सुसज्जित पाय जाय।<verse eid="2TI 3:17" /></para>
  <chapter eid="2TI 3" />
  <chapter number="4" style="c" sid="2TI 4" />
  <para style="s">बचन परचार करै के निता तइयार रहा</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 4:1" />भगवान के साक्छी करके अउ मसीह यीसु के अपन साक्छी बनाय के जउन सगलू जिन्दा अउ जउन मर चुके हबै, उनखर नियाव करै बाले हबै, अउ काखे ओखर फेर आमै लग अउ ओखर राज लिघ्घो हबै, मै तोके सपथ पूरबक आदेस देथो। <verse eid="2TI 4:1" /><verse number="2" style="v" sid="2TI 4:2" />बचन परचार करत टेम निक्खा या बेकार हरमेसा तइयार रहा, बडा धीर लग अउ सिक्छा दे के उदेस्य लग मनसे के समझाबा, गधार अउ प्रोत्साहन करा। <verse eid="2TI 4:2" /><verse number="3" style="v" sid="2TI 4:3" />काखे अक्ठी असना टेम आही जब ऊ खरी सिक्छा के सह न सकहिन, ऊ अपन इक्छा पूर करै के निता असना गुरू के अकजुट करही, जउन उनही केबल कानन के निक्खा लगै बाले सिक्छा दइहिन। <verse eid="2TI 4:3" /><verse number="4" style="v" sid="2TI 4:4" />उन अपन कान के सही लग फेर लइहिन अउ किस्सा हे धियान दे लगहिन। <verse eid="2TI 4:4" /><verse number="5" style="v" sid="2TI 4:5" />पय तुम हइ सगलू बारे हे सचेत रहबे, परेसानी के सहि लइहा, भगवान के संदेस के परचार के काम करिहा, अपन सेबा के पूर करिहा।<verse eid="2TI 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 4:6" />मै परभु के अपन जीवन सउपथो, मोर दुनिया लग जाय के टेम आय गय हबै। <verse eid="2TI 4:6" /><verse number="7" style="v" sid="2TI 4:7" />मै अच्छी लडाई लड चुके हव अउ अपन दउर पूर कर चुके हव, अउ मै अब तक बिस्वास के सुरक्छित रखे हव। <verse eid="2TI 4:7" /><verse number="8" style="v" sid="2TI 4:8" />भभिस्य हे मोर निता नियाइपन धरमी पन के इनाम के मुकुट सुरक्छित हबै, जउन न्याय करैबाले परभु मोके ऊ रोज दइ, मोके बस नेहको पय उन सगलू कउ के जउन उनखर दुबारा आमै लग बडी आसा लग ओरगथै।<verse eid="2TI 4:8" /></para>
  <para style="s">व्यक्तिगत खबर</para>
  <para style="p">
    <verse number="9" style="v" sid="2TI 4:9" />तुम हरबी लग हरबी मोर लिघ्घो आमै का पूर परयास करा। <verse eid="2TI 4:9" /><verse number="10" style="v" sid="2TI 4:10" />काखे देमास बरतमान दुनिया के प्रिय जानके ऊ मोके छांडके थिस्सलुनीके सहर छो कढ गय हबै, क्रेसकेंस गलातिया परदेस छो कढ गइस, अउ तीतुस, दलमतिया परदेस छो। <verse eid="2TI 4:10" /><verse number="11" style="v" sid="2TI 4:11" />केबल लूका मोर लिघ्घो हबै, मरकुस के लिघ्घो जाय अउ जब तै अइहे, उके अपन संग लइ आनबे, काखे मोर सेबा हे ऊ मोर सहायक हुइ सकथै। <verse eid="2TI 4:11" /><verse number="12" style="v" sid="2TI 4:12" />तुखिकुस<note caller="+" style="f"><char style="fr" closed="false">4:12 </char><char style="ft" closed="false">मनसे के नाम</char></note> के मै इफिसुस सहर छो पठोय हव। <verse eid="2TI 4:12" /><verse number="13" style="v" sid="2TI 4:13" />जब तै आबे ता ऊ कोट के, जेही मै तरोआस सहर हे करपुस के घर छांड आय रथो, उके लइ आबे, मोर किताब, खासके चरम चिट्ठी के लइ आनबे।<figure style="fig" alt="Scrolls standing by ink well" file="hk00153c.tif" size="col" copy="Horace Knowles ©" ref="4:13">निक्खा मेर लग सियाही लगे हर किताब</figure><verse eid="2TI 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 4:14" />सिकन्दर ठठेरे मोर संग बोहत गलत करे हबै, परभु ओही ओखर काम के फल देही<note caller="+" style="x"><char style="xo" closed="false">4:14 </char><char style="xt" closed="false"><ref loc="PSA 28:4">भजन 28:4</ref>; <ref loc="ROM 12:19">रोमियो 12:19</ref></char></note>। <verse eid="2TI 4:14" /><verse number="15" style="v" sid="2TI 4:15" />तुम खुद ओखर लग सचेत रइहा काखे ऊ हमर सिक्छा के बोहत जादा बिरोध करे रथै।<verse eid="2TI 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 4:16" />मोर पहिली सुनवाइ के टेम कउ मोर संग नेहको रथै, सब कउ मोके छांड दय रथै, इनखर निता उनके हिसाब देय के झइ पडै। <verse eid="2TI 4:16" /><verse number="17" style="v" sid="2TI 4:17" />परभु मोर संग रथै अउ उन मोके सक्ति दय रथै कि मोर दवारा संदेस के घोसना पूरी तरह खतम हुइ जाय अउ सगलू दूसर जात के मनसे इके सुन सकै, मै बघवा के मुंह लग बचाय लय गय हव<note caller="+" style="x"><char style="xo" closed="false">4:17 </char><char style="xt" closed="false"><ref loc="PSA 22:21">भजन 22:21</ref>; <ref loc="DAN 6:21">दानि 6:21</ref></char></note>। <verse eid="2TI 4:17" /><verse number="18" style="v" sid="2TI 4:18" />परभु मोके हर बैरिन के फन्दा लग छांडही, ऊ मोके सुरक्छित रखही अउ अपन स्वरग राज हे मुकति करके पहुंचइ, ओखर महिमा जुगजुग होवत रहै, ओसनेन होय।<verse eid="2TI 4:18" /></para>
  <para style="s">आखरी नमस्ते</para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 4:19" />प्रिस्का<note caller="+" style="f"><char style="fr" closed="false">4:19 </char><char style="ft" closed="false">प्रिस्का नाम के डउकी</char></note> अउ अक्विला के अउ उनेसिफुरुस के परवार के नमस्ते कहबे। <verse eid="2TI 4:19" /><verse number="20" style="v" sid="2TI 4:20" />इरास्तुस कुरिन्थुस हे रह गइस, अउ तिरिफिमुस के मै मिलेतुस सहर हे नांगा के कारन छांड दय हव। <verse eid="2TI 4:20" /><verse number="21" style="v" sid="2TI 4:21" />जाड लग पहिले आमैके परयास करबे।</para>
  <para style="p" vid="2TI 4:21">यूबूलुस अउ पूदेंस, अउ लीनुस अउ कलउदिया, अउ सगलू भाइन के नमस्ते।<verse eid="2TI 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 4:22" />परभु तुम्हर आतमा के संग रहै, तुम्हर हे अनुगरह होवत रहै।<verse eid="2TI 4:22" /></para>
  <chapter eid="2TI 4" />
</usx>