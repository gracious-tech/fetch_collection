<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="3JN" style="id">- Bhumiya Standard Project</book>
  <para style="h">यूहन्ना</para>
  <para style="toc3">3 यूहन्ना</para>
  <para style="toc2">3 यूहन्ना</para>
  <para style="toc1">3 यूहन्ना कर चिट्ठी</para>
  <para style="mt2">3 यूहन्ना की चिट्ठी</para>
  <para style="mt1">3 यूहन्ना कर चिट्ठी</para>
  <para style="imt">परचा</para>
  <para style="ip">यूहन्ना के चिट्ठी प्रेरित यूहन्ना दवारा मसीह के पइदा के 50 लग 100 साल के बीच लिखे गय रथै। यूहन्ना खुद के लेखक के रूप हे नेहको चीनथै, बलुक खुद के सियान कथै। <char style="xt"><ref loc="3JN 1:1">1:1</ref></char> ऊ <char style="xt"><ref loc="2JN 1:1">2 यूहन्ना 1:1</ref></char> हे ओसनेन करथै। असना माने जथै कि यूहन्ना इफिसुस हे रथै, यूहन्ना अउ तीसर अक्छर 1 यूहन्ना, 2 यूहन्ना अउ 3 यूहन्ना के जसना संदेस लिखे रथै।</para>
  <para style="ip">यूहन्ना हइ चिट्ठी गयुस के नाम के अक्ठी बिस्वासी के लिखे रथै। ऊ गयुस के अक्ठी संगी के रूप हे संबोधित करथै, अउ उके मसीही भाई के निता पहुनाई करै के आदेस देथै, जउन उस इलाका हे यातरा करथै।</para>
  <para style="iot">रूप रेखा</para>
  <para style="io1">1. यूहन्ना अपन चिट्ठी के परचा देथै। <char style="ior"><ref loc="3JN 1:1">1:1</ref> </char></para>
  <para style="io1">2. फेर ऊ गयुस के प्रोत्साहन करथै अउ उके भाई के आसा दिखामै के आदेस देथै। <char style="ior"><ref loc="3JN 1:2-8">1:2-8</ref> </char></para>
  <para style="io1">3. एखर बाद ऊ दुइठे दूसर डउका दियुतिरफेस अउ दिमेतिरयुस के बात करथै। <char style="ior"><ref loc="3JN 1:9-12">1:9-12</ref> </char></para>
  <para style="io1">4. आखरी हे ऊ अपन चिट्ठी समापत करथै। <char style="ior"><ref loc="3JN 1:13-14">1:13-14</ref></char></para>
  <chapter number="1" style="c" sid="3JN 1" />
  <para style="s">सोगत</para>
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1" />मुझ सियान के पार लग, पिरिया संगी गयुस के नाम, जेखर लग मै सही माया करथो।<verse eid="3JN 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="3JN 1:2" />हे प्रिजन, मोर हइ पराथना हबै कि जसना तै आतमिक उन्नत करथस, ओसनेन तै सगलू बातन हे उन्नत के अउ ठीक ठाक रहा। <verse eid="3JN 1:2" /><verse number="3" style="v" sid="3JN 1:3" />काखे जब भाई-बेहन इछो आइन अउ उन तोर सही के बारे हे गवाही दइन अउ बताथै कि कउन मेर तै सही के रास्ता हे चलथस, ता मै बोहत खुस होयों। <verse eid="3JN 1:3" /><verse number="4" style="v" sid="3JN 1:4" />मोके अउ कउनो बात हे एतका खुसी नेहको हुइस, जेतका हइ बात सुनके कि मोर लरका सही के रास्ता हे चलथै।<verse eid="3JN 1:4" /></para>
  <para style="s">गयुस कर परसंसा</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5" />हे मोर पिरिया भाइयो, जउन तुम अनचिन्हार मनसेन के निता करथा, ऊ सगलू बिस्वास लग करथा, <verse eid="3JN 1:5" /><verse number="6" style="v" sid="3JN 1:6" />उन इछो के मंडली के आगू तुम्हर माया के गवाही दय हबै, अगर तुम उनखर आगू के यातरा के मदद करिहा, ता अउ निक्खा होही, एखर लग भगवान खुस होही। <verse eid="3JN 1:6" /><verse number="7" style="v" sid="3JN 1:7" />काखे ऊ मसीह के सेबा के निता यातरा हे ऊ नाम के निता निकरे हबै, अउ गैर यहूदी लग कुछु मदद नेहको लेथै। <verse eid="3JN 1:7" /><verse number="8" style="v" sid="3JN 1:8" />इहैनिता हमके असना बिस्वासिन के सोगत करै चाही, ताकि सही के फइलामै हे मदद मिलै।<verse eid="3JN 1:8" /></para>
  <para style="s">दियुतिरफेस अउ दिमेतिरयुस</para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9" />मै मंडली के अक्ठी चिट्ठी लिखे रहों, पय दियुतिरफेस जउन उहां के नेता बनै चाहथै, हमके अपनामै के निता तइयार नेहको हबै। <verse eid="3JN 1:9" /><verse number="10" style="v" sid="3JN 1:10" />इहैनिता मोर आमै लग मै ओखर कामन के सुरता देबाहुं जउन ऊ बेकार सब्द लग हमर निदरा करथै, ऊ एतका हे मन नेहको भरथै, ता ऊ अपन भाई के सोगत तक नेहको करथै, अउ न करै बालेन के करै देथै, बलुक उनही मंडली लग बाहिर के देथै।<verse eid="3JN 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11" />हे पिरिया संगी, बुराई के नेहको पय निक्खा करा, जउन निक्खा करथै, ऊ भगवान के पल्ला लग हबै, जउन बुराई करथै, ऊ भगवान के नेहको देखे हबै।<verse eid="3JN 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="3JN 1:12" />दिमेतिरयुस के सगलू कउ बडाई करथै, अउ हमु ओखर गवाह हबन, तुमही पता हबै कि हमर गवाही सही हबै।<verse eid="3JN 1:12" /></para>
  <para style="s">आखरी सोगत</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13" />तोके लिखे के निता मोर लिघ्घो बोहत बात हबै, पय सियाही अउ कलम लग लिखे के नेहको चाहथो। <verse eid="3JN 1:13" /><verse number="14" style="v" sid="3JN 1:14" />बलुक मोके आसा हबै कि तोर लग हरबी मुलाकात करिहों, तब हम आमने-सामने बात चीत कर सकब।<verse eid="3JN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="3JN 1:15" />तोके सान्ति मिलत रहै।</para>
  <para style="p" vid="3JN 1:15">इहां के दोस तोके नमस्ते कथै। उहां के संगिन लग नाम लइ लइके नमस्ते कइहा<note caller="+" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="2JN 1:12">2 यूहन्ना 1:12</ref></char></note>।<verse eid="3JN 1:15" /></para>
  <chapter eid="3JN 1" />
</usx>