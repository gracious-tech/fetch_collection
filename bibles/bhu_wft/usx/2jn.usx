<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2JN" style="id">- Bhumiya Standard Project</book>
  <para style="h">यूहन्ना</para>
  <para style="toc3">2 यूहन्ना</para>
  <para style="toc2">2 यूहन्ना</para>
  <para style="toc1">2 यूहन्ना कर चिट्ठी</para>
  <para style="mt2">2 यूहन्ना की चिट्ठी</para>
  <para style="mt1">2 यूहन्ना कर चिट्ठी</para>
  <para style="imt">परचा</para>
  <para style="ip">1 यूहन्ना के चिट्ठी प्रेरित यूहन्ना दवारा मसीह के पइदा के 50 लग 100 साल के बीच लिखे गय रथै, यूहन्ना खुद के लिखे बाले के रूप हे नेहको चीनथै, एखर बजाय ऊ खुद के सब लग बडा कथै। 2 यूहन्ना के बारे यूहन्ना के जसना संदेस हे मिलिस, अउ ओखर बारे हे बोहत जादा मिलत जुलत हबै। हइ खासके ऊ मेर लग साबित होथै, जउन मेर लग ऊ यीसु लग माया करै लग बरोबरी ओखर आदेस के पालन करै के संग करथै।</para>
  <para style="ip">
    <char style="xt">
      <ref loc="2JN 1:5-6">1:5-6</ref>
    </char> <char style="xt"><ref loc="JHN 15:9-10">यूहन्ना 15:9-10</ref></char> असना माने जथै कि यूहन्ना इफिसुस सहर हे रहत यूहन्ना अउ तीन अक्छर 1 यूहन्ना, 2 यूहन्ना अउ 3 यूहन्ना के जसना संदेस लिखे रथै। यूहन्ना हइ चिट्ठी के चुने हर डउकी अउ ओखर लरका के संकेत करिस, ऊ सब्द अक्ठी मंडली के बात करथै, हइ चिट्ठी के लिखे हे यूहन्ना के उदेस्य मंडली के प्रोत्साहन करै के अउ उनके ठगरा सिक्छा लग सचेत करै के रथै।</para>
  <para style="iot">रूप रेखा</para>
  <para style="io1">1. यूहन्ना हइ कहिके चिट्ठी के परचा देथै कि हइ केखर निता हबै अउ एखर पढे बालेन के सोगत करके परचा देथै। <char style="ior"><ref loc="2JN 1:1-3">1:1-3</ref> </char></para>
  <para style="io1">2. फेर ऊ मंडली के प्रोत्साहन करथै अउ उनके सब लग बडा आदेस के सुरता दिलाथै। <char style="ior"><ref loc="2JN 1:4-6">1:4-6</ref> </char></para>
  <para style="io1">3. एखर बाद ऊ उनके ठगरा सिक्छा के बारे हे चेतन्त करथै। <char style="ior"><ref loc="2JN 1:7-11">1:7-11</ref></char></para>
  <para style="io1">4. यूहन्ना अपन चिट्ठी के उस मंडली के बिस्वासिन लग जिहां ऊ रथै, सोगत करके समापत करथै। <char style="ior"><ref loc="2JN 1:12-13">1:12-13</ref> </char></para>
  <chapter number="1" style="c" sid="2JN 1"/>
  <para style="s">सोगत</para>
  <para style="p">
    <verse number="1" style="v" sid="2JN 1:1"/>मोके सियान के पल्ला लग, ऊ चुने हर डउकी अउ ओखर लरकन के नाम, जउन मै सही माया करथो, अउ सिबाय मै नेहको पय उन सगलू कउ माया करथै, जउन सही के जानथै, <verse eid="2JN 1:1"/><verse number="2" style="v" sid="2JN 1:2"/>ऊ सही के कारन जउन हमर भित्तर निबास करथै, अउ हरमेसा हमर संग रही।<verse eid="2JN 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2JN 1:3"/>भगवान बाफ, अउ ओखर टोरवा यीसु मसीह कर अनुगरह किरपा, दया, माया, सान्ति, सत्य हरमेसा हमर संग रही।<verse eid="2JN 1:3"/></para>
  <para style="s">सही अउ माया</para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4"/>मोके हइ बात हे खुसी हबै, कि मै कुछ लरकन के ऊ आदेस के जसना जउन हमके बाफ लग मिले रथै, सही के रास्ता हे चलथै। <verse eid="2JN 1:4"/><verse number="5" style="v" sid="2JN 1:5"/>अब हे डउकी, मै कउनो नबा आदेस नेहको, पय उहै जउन सुरू लग हमर लिघ्घो हबै, लिखथो अउ तोर लग बिनती करथो कि हम अक दूसर लग माया करी। <verse eid="2JN 1:5"/><verse number="6" style="v" sid="2JN 1:6"/>अउ माया के मतलब हइ हबै कि हम ओखर आदेस के जसना चली, हइ उहै आदेस हबै जउन तुम सुरू लग सुने हबा, अउ तुमही माया के रास्ता हे चलै चाही।<verse eid="2JN 1:6"/></para>
  <para style="s">मसीह बिरोधिन लग चेतन्न</para>
  <para style="p">
    <verse number="7" style="v" sid="2JN 1:7"/>काखे दुनिया हे बोहत भरमामै बाले आय गय हबै, जउन हइ नेहको मानथै कि यीसु मसीह देह हे हुइ के भुंइ हे मनसे के रूप हे आइस, भरमामै बाले अउ मसीह-बिरोधी इहै हबै। <verse eid="2JN 1:7"/><verse number="8" style="v" sid="2JN 1:8"/>खुद के चेतन्त करा, असना झइ होय कि जउन मेहनत हम करे हबन ओही तुम गवांदा, पय ओखर परतिफल पइहा।<verse eid="2JN 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2JN 1:9"/>जउन कउ मसीह के सिखाय हर बात लग दुरिहां हुइ गय हबै, अउ ओहमा नेहको बने रथै, ता ओखर लिघ्घो भगवान नेहको हबै, पय जउन कउ मसीह के सिखाय हर बात हे बने रथै, ओखर लिघ्घो बाफ अउ टोरवा दोनो हबै। <verse eid="2JN 1:9"/><verse number="10" style="v" sid="2JN 1:10"/>अगर कउ तुम्हर लिघ्घो आथै अउ हइ संदेस के नेहको देथै, ता अपन घर हे ओखर सोगत झइ करा, अउ न नमस्ते करा। <verse eid="2JN 1:10"/><verse number="11" style="v" sid="2JN 1:11"/>काखे जउन कउ असना मनसे के सोगत करथै, ऊ ओखर बेकार कामन हे सहभागी होथै।<verse eid="2JN 1:11"/></para>
  <para style="s">आखरी सोगत</para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12"/>मोके बोहत बात तुमके लिखे के हबै, पय कगदा अउ सियाही लग लिखे के नेहको चाहथो, पय आसा हबै कि मै तुम्हर लिघ्घो आहुं अउ आमने-सामने बइठ के बात चीत करहुं, जेखर लग तुम्हर खुसी पूर होय।<verse eid="2JN 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2JN 1:13"/>तोर चुने हर बेहन के टोरवा-टोरिया तुमही नमस्ते कथो<note caller="+" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="1JN 1:4">1 यूहन्ना 1:4</ref>; <ref loc="3JN 1:13">3 यूहन्ना 1:13</ref></char></note>।<verse eid="2JN 1:13"/></para>
  <chapter eid="2JN 1"/>
</usx>
