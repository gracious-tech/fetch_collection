<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JUD" style="id">- Bhumiya Standard Project</book>
  <para style="h">यहूदा</para>
  <para style="toc3">यहूदा</para>
  <para style="toc2">यहूदा</para>
  <para style="toc1">यहूदा कर चिट्ठी</para>
  <para style="mt2">यहूदा की चिट्ठी</para>
  <para style="mt1">यहूदा कर चिट्ठी</para>
  <para style="imt">परचा</para>
  <para style="ip">यहूदा नाम चिट्ठी एखर लेखक के नाम रखे गय हबै, यहूदा खुद के यीसु के भाई, याकूब के भाई के रूप हे चिनवाथै, इहैनिता उके यीसु के भाई मसे अक्ठी माने जथै, <char style="xt"><ref loc="JUD 1:1">1</ref></char> हम नेहको जानथन कि का हइ चिट्ठी अक्ठी बडा मंडली के निता रथै अउ पुरान नियम के संदर्भ के कारन, यहूदा के मूल पाठक करीबन यहूदियन लग बने रथै, इहैनिता ऊ अपन चिट्ठी के उन सगलू के संम्बोधित करथै, जउन बुलाय गय हबै, जउन बाफ भगवान हे माया करे जथै अउ यीसु मसीह के निता रखे जथै, <char style="xt"><ref loc="JUD 1:1">1</ref></char> हइ चिट्ठी करीबन यीसु के पइदा 60 साल के अगल बगल लिखे गय रथै।</para>
  <para style="ip">सगलू मसीही के चिट्ठी लिखे के ओखर उदेस्य उनके ठगरा सिक्छा दवारा गुमराह करे जाय के खिलाफ चेतन्त दे के हबै। यहूदा <char style="xt"><ref loc="JUD 1:4">4</ref> </char>ऊ अपन तरक के बल दे के निता पुरान नियम के घटना अउ व्रतान्त के संदर्भ देथै। हइ चिट्ठी 2 पतरस के संग कइ बिचारन के सामिल करथै, जेहमा ठगरा गुरू के खिलाफ चेतन्त <char style="xt"><ref loc="JUD 1:4">यहूदा 4</ref>; <ref loc="2PE 2:1">2 पतरस 2:1</ref></char> के संग-संग स्वरगदूतन अउ सदोम अउ अमोरा के संदर्भ सामिल हबै।</para>
  <para style="iot">रूप रेखा</para>
  <para style="io1">1. यहूदा पहिले अपन पढे बालेन के संबोधित करथै। <char style="ior"><ref loc="JUD 1:1-2">1:1-2</ref></char></para>
  <para style="io1">2. एखर बाद ऊ लिखे के अपन कारन गुठेथै जउन उनके ठगरा गुरून के खिलाफ चेतन्त देय के हबै। <char style="ior"><ref loc="JUD 1:3-4">1:3-4</ref></char></para>
  <para style="io1">3. ओखर बाद ऊ पुरान हे मनसेन अउ घटनन लग उदाहरन देथै। <char style="ior"><ref loc="JUD 1:5-16">1:5-16</ref></char></para>
  <para style="io1">4. फेर ऊ उनके गुठेथै कि चेतन्त के परति उनखर राय का होय चाही। <char style="ior"><ref loc="JUD 1:17-23">1:17-23</ref> </char></para>
  <para style="io1">5. आखरी हे ऊ भगवान के महिमा करत चिट्ठी के बन्द करथै। <char style="ior"><ref loc="JUD 1:24-25">1:24-25</ref></char></para>
  <chapter number="1" style="c" sid="JUD 1" />
  <para style="s">सोगत</para>
  <para style="p">
    <verse number="1" style="v" sid="JUD 1:1" />हइ चिट्ठी यीसु मसीह के हरवाह अउ याकूब के भाई यहूदा के पल्ला लग, उन बुलाय हर के नाम जउन भगवान बाफ के दवारा पवितर करे गय हबै, अउ यीसु मसीह के आमै के टेम हे सुरक्छित हबै।<verse eid="JUD 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JUD 1:2" />तुमके दया किरपा, सान्ति अउ माया तुमके बोहत मिलत रहै।<verse eid="JUD 1:2" /></para>
  <para style="s">ठगरा गुरून कर न्याय</para>
  <para style="p">
    <verse number="3" style="v" sid="JUD 1:3" />हे मोर पिरिया संगी, मै बोहत चाहथो कि तुमके ऊ मुकति के बारे हे लिखो, जेहमा हम सहभागी हबन, मै तुमके लिखे के अउ तुमके खुस करै के जरूरी समझो ताकि तुम ऊ बिस्वास के निता मेहनत करथा, जेही भगवान अपन पवितर सेबक के अक्कै बेर निता सउप दय हबै। <verse eid="JUD 1:3" /><verse number="4" style="v" sid="JUD 1:4" />काखे हमर मसे कुछ मनसे चुपके लग घुस आथै, हइ मनसेन के नियाव के बारे हे किताब हे बोहत पहिले आगू कर बात गुठे दय रहै, हइ मनसे भगवान बिहीन हबै। हइ मनसे भगवान के अनुगरह किरपा के बिलास के अक्ठी बहाना बना डारे हबै अउ हइ हमर परभु अक्ठी गुरू यीसु मसीह के नेहको मानथै।<verse eid="JUD 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JUD 1:5" />काखे जब तुम हइ सगला जानथा तबो मै तुमके सुरता दिलामै चाहथो कि परभु अक्कै बेर इस्राएलियन के मिस्र देस लग छंडाय रथै, पय बाद हे उन मनसे के नास के दइस जिनही बिस्वास नेहको करे रथै। <verse eid="JUD 1:5" /><verse number="6" style="v" sid="JUD 1:6" />फिर जउन स्वरगदूत अपन पद के बनाय नेहको रखिस, पय अपन निबास हक के छांड दइस, ऊ उनके ऊ भयानक नियाव के रोज के निता अंधियार हे जउन सबरोज के निता हबै बन्धन हे रखे हबै। <verse eid="JUD 1:6" /><verse number="7" style="v" sid="JUD 1:7" />इहै मेर मै तुमही हइ सुरता दिलामै चाहथो, कि सदोम अउ अमोरा अउ ओखर अगल-बगल के सहर हे हइ दूतन के जसना गलत काम हे फस गय रहै, अउ पराय देह के पाछू दउडत रहन, उनही अनन्त काल तक नेहको बुझै बाले आगी हे झपोय जाय के निता सजा दय गइस, ऊ हमर निता उदाहरन के रूप हे ठहरे हबै<note caller="+" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="GEN 19:4-25">उत्पति 19:4-25</ref>; <ref loc="DEU 29:23">बेवस्थाबिबरन 29:23</ref>; <ref loc="2PE 2:6">2 पतरस 2:6</ref></char></note>।<verse eid="JUD 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JUD 1:8" />उहै मेर लग हइ सपना देखे बाले अपन जीव के असुध्द करथै, अउ हक अउ सासक के बेकार जानथै, अउ ऊंच पद बाले मनसेन के बुराई करथै। <verse eid="JUD 1:8" /><verse number="9" style="v" sid="JUD 1:9" />जब परधान स्वरगदूत मीकाईल भुतवा लग झगडा करत मूसा कर लोथ के बारे हे बहस करथै, ता ऊ ओखर बिरोध बुराई बाले सब्द के निस्तार नेहको करिस, ऊ केबल एतकै कहिस, “परभु तोके डांटै।” <verse eid="JUD 1:9" /><verse number="10" style="v" sid="JUD 1:10" />पय हइ मनसे उन बातन के बुराई करथै, जिनके ऊ नेहको समझथै अउ जउन बात हइ नेहको समझे उनही पसुन मेर समझथै, इनखरै कारन उन नास हुइ जथै। <verse eid="JUD 1:10" /><verse number="11" style="v" sid="JUD 1:11" />हइ मनसेन के उप्पर लानत हबै, जउन कैन के रास्ता हे चलथै, हइ पइसा के लालच के कारन उन उहै गलती करिन जउन बिलाम करे रथै, अउ उहै मेर नास हुइन जउन मेर कोरह बिरोध करके नास हुइ गय रथै<note caller="+" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="GEN 4:3-8">उत्पति 4:3-8</ref>; <ref loc="NUM 16:19-35">गिनती 16:19-35</ref>; <ref loc="NUM 22:7">गिनती 22:7</ref>; <ref loc="2PE 2:15">2 पतरस 2:15</ref>; <ref loc="1JN 3:12">1 यूहन्ना 3:12</ref>; <ref loc="NUM 12:14">गिनती 12:14</ref></char></note>। <verse eid="JUD 1:11" /><verse number="12" style="v" sid="JUD 1:12" />हइ मनसे अपन बेसरमी इफाजत लग ऊ तुम्हर संगति के खाना गन्दा धब्बा के जसना हबै, केबल अपन धियान रखथै, हइ बादर के जसना हबै जउन हवा के संग लइ जथै, पय बरसा नेहको लाथै, ऊ उन रूख के जसना जेहमा फडुहा नेहको लगथै, इहां तक कि पतझडो हे रूख जउन जर के खींच लइ गय हबै, अउ पूरी तरह लग दुइ बेर मर चुके हबै<note caller="+" style="x"><char style="xo" closed="false">1:12 </char><char style="xt" closed="false"><ref loc="2PE 2:17">2 पतरस 2:17</ref>; <ref loc="EPH 4:14">इफिसियों 4:14</ref>; <ref loc="JHN 15:4-6">यूहन्ना 15:4-6</ref></char></note>। <verse eid="JUD 1:12" /><verse number="13" style="v" sid="JUD 1:13" />हइ समुन्दर के उछाल लेहरा के जसना हबै, जउन अपन लज्जा गेजरा के रूप हे उछलथै, हइ रास्ता लग भटकत तरइया हबै, जेखर निता हरमेसा के निता बोहत अंधियार हे छांड दय हबै<note caller="+" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="ISA 57:20">यसा 57:20</ref></char></note>।<verse eid="JUD 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JUD 1:14" />हनोक जउन आदम लग सतमा पीढी हे रथै, इनखर बारे हे हइ आगू कर बात करे रथै, देखो, परभु अपन हजारो पवितर दूत के संग आइस<note caller="+" style="x"><char style="xo" closed="false">1:14 </char><char style="xt" closed="false"><ref loc="DEU 33:2">बेवस्थाबिबरन 33:2</ref>; <ref loc="2TH 1:7-8">2 थिस्स 1:7-8</ref></char></note>। <verse eid="JUD 1:14" /><verse number="15" style="v" sid="JUD 1:15" />सगलू मनसेन के नियाव करै के निता आउत हबै, ताकि मनसे जउन बुरा काम करे हबै, ऊ उनखर निता अउ उन जउन पापी भगवान के बिरोध बुरा बचन बोले हबै, उनही हर अकझन के सजा दे।<verse eid="JUD 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JUD 1:16" />हइ उन मनसे हबै जउन कुडकुडाथै अउ अपन किसमत के कोसथै, अपन इक्छा के दास हबै अउ बडा बात करथै अउ फायदा के निता दूसर के बडाई करथै।<verse eid="JUD 1:16" /></para>
  <para style="s">चेतन्त अउ ग्यान</para>
  <para style="p">
    <verse number="17" style="v" sid="JUD 1:17" />पय हे पिरिया भाई, तुम ऊ बात के सुरता रखिहा जउन हमर परभु यीसु मसीह के चेला आगू कह चुके हबै। <verse eid="JUD 1:17" /><verse number="18" style="v" sid="JUD 1:18" />ऊ तुम्हर लग कहे कइहिन, आखरी टेम हे असना मनसे होही जउन भगवान लग जउन कुछ सबंधित होही ओखर मजाक उडाइहिन, अउ ऊ अपवितर इक्छा के पाछू-पाछू चले करही। <verse eid="JUD 1:18" /><verse number="19" style="v" sid="JUD 1:19" />हइ उन मनसे हबै जउन फूट डालथै, इन देह के मनसे हबै जिनखर हे आतमा नेहको हबै। <verse eid="JUD 1:19" /><verse number="20" style="v" sid="JUD 1:20" />पय हे प्रिजन, तुम अपन पवितर बिस्वास हे बढत अउ पवितर आतमा लग पराथना बिनती करत रइहा। <verse eid="JUD 1:20" /><verse number="21" style="v" sid="JUD 1:21" />भगवान कर माया हे मजबूत बने रहा अउ हमर परभु यीसु मसीह के दया के आसा करा जउन हरमेसा के जीवन के तरफ लइ जथै।<verse eid="JUD 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JUD 1:22" />कुछ मनसे बिस्वास हे संका हबै, उनखर उप्पर दया करै। <verse eid="JUD 1:22" /><verse number="23" style="v" sid="JUD 1:23" />कुछ मनसेन के आगी मसे निकरके उनखर मदद करा, पय कुछ मनसेन हे दया करत टेम खुद के सचेत करा, अउ इहां तक कि उनखर खुरथा पइजामा लग घिनाबा जउन देह लग कलंक हबै।<verse eid="JUD 1:23" /></para>
  <para style="s">आसिरबाद</para>
  <para style="p">
    <verse number="24" style="v" sid="JUD 1:24" />अब जउन तुमही ठोकड खाये लग बचा सकथै, अउ ओखर महिमा के उपस्थित हे तोके बडा खुसी के संग निरदोस करके परस्तुत के सकथै। <verse eid="JUD 1:24" /><verse number="25" style="v" sid="JUD 1:25" />जउन हमके हमर परभु यीसु मसीह के दवारा मुकति देथै, उहै अक्ठी भगवान कर महिमा, सक्ति, पराकरम अउ हक हरमेसा-हरमेसा लग अब तक अउ जुगजुग तक बने रहै। आमीन।<verse eid="JUD 1:25" /></para>
  <chapter eid="JUD 1" />
</usx>