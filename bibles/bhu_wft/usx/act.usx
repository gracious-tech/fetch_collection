<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ACT" style="id">- Bhumiya Standard Project</book>
  <para style="h">प्रेरितो</para>
  <para style="toc3">प्रेरितो</para>
  <para style="toc2">प्रेरितो</para>
  <para style="toc1">प्रेरितो कर काम</para>
  <para style="mt2">प्रेरितों कर काम</para>
  <para style="mt1">प्रेरितो कर काम</para>
  <para style="imt">परचा</para>
  <para style="ip">चेलन कर काम के किताब मंडली के सुरुवात के किस्सा हबै अउ हइ यरुसलेम लग यहूदिया, सामरिया अउ ओखर आगू तक कसना बगर गइस, जसना यीसु अपन चेलन के स्वरग छो जात टेम गुठेय रहिस। <char style="xt"><ref loc="ACT 1:8">1:8</ref></char> हइ किताब के लूका लिखे हबै, हइ संदेस के जसना लिखे गय रथै, ऊ अक्ठी गुनिया रथै अउ अक्ठी निक्खा घटना के लिखे हे बोहत सचेत रथै। उन अपन संदेस अउ चेलन कर काम के किताब ऊ थियोफिलुस के संबोधित करिस, जउन अक्ठी यूनानी रथै, पय किताब के मतलब सायद मसीही समाज कर निता रथै, जेहमा यूनानी अउ यहूदी दोनो झन सामिल रथै। <char style="xt"><ref loc="ACT 1:1">1:1</ref></char> चेलन कर काम सायद मसीह के पइदा के बाद 60-64 साल के बीच लिखे गय रथै, काखे हइ किताब जेल लग पोलुस के छंडाय लग पहिलेन समापत होथै।</para>
  <para style="ip">लूका, पोलुस कर संग यातरा करिस अउ सायद तबय अंताकिया के सहर हे चेलन के काम लिखे रथै, लूका कर संदेस के बातन के लगेतार रखे हबै, अउ यीसु के स्वरग छो जाय के बाद हे सुरु होथै, लूका कर मकसद इछो लिखे हर जउन बात हबै, ऊ ओखर पहिलेन लूका कर संदेस मिलत जुलत हबै, ऊ थियोफिलुस के चाहथै, संग-संग मसीहन के बढत संख्या जरूरी हबै, कि उनके काहिन सिखाय गय रथै, अउ इहैनिता लूका यीसु के जीवन अउ मसीही धरमी काम के परचार के सही किताब लिखिस।</para>
  <para style="ip">चेलन के किताब हमर निता सुरुवात मंडली के उदाहरन परदान करथै, हइ दिखाथै कि यीसु हे बिस्वास के संग कसना जियब। चेलन के उदाहरन हमके दिखथै कि दूसरन के संदेस फइलामै हे पवितर आतमा के सक्ति हे कसना बिस्वास करे जाय।</para>
  <para style="iot">रूप रेखा</para>
  <para style="io1">1. पहिले चेलन हे पवितर आतमा आथै अउ मंडली बढै के सुरुवात। <char style="ior"><ref loc="ACT 1:1-8:1">1:1—8:1</ref> </char></para>
  <para style="io1">2. एखर बाद मंडली हे बिरोध हुइस अउ यरुसलेम के बाहिर बगरय लगथै। <char style="ior"><ref loc="ACT 8:2-12:23">8:2—12:23</ref> </char></para>
  <para style="io1">3. ओखर बाद पोलुस अपन पहिली सेबा यातरा हे कढ जथै। <char style="ior"><ref loc="ACT 12:24-14:28">12:24—14:28</ref> </char></para>
  <para style="io1">4. तब यरुसलेम हे बइठक करके हइ तय करथै कि नबा बिस्वास करै बाले के काहिन जरूरत हबै। <char style="ior"><ref loc="ACT 15:1-35">15:1-35</ref></char></para>
  <para style="io1">5. पोलुस अपन दूसर सेबा यातरा हे कढ जथै। <char style="ior"><ref loc="ACT 15:36-18:22">15:36—18:22</ref> </char></para>
  <para style="io1">6. एखर बाद ऊ अपन तीसर सेबा यातरा हे कढ जथै। <char style="ior"><ref loc="ACT 18:23-20:38">18:23—20:38</ref> </char></para>
  <para style="io1">7. तब पोलुस के यरुसलेम हे पकडिन। <char style="ior"><ref loc="ACT 21-26">21—26</ref> </char></para>
  <para style="io1">8. आखरी हे उके रोम देस हे पहुंचाय जथै। <char style="ior"><ref loc="ACT 27-28">27—28</ref> </char></para>
  <chapter number="1" style="c" sid="ACT 1"/>
  <para style="s">परचा</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 1:1"/>हे पिरिया थियुफिलुस, मै अपन पहिली किताब उन सगलू बातन कर बारे हे लिखे हव, जिनके सुरु लग यीसु करिस अउ सिखाइस। <verse eid="ACT 1:1"/><verse number="2" style="v" sid="ACT 1:2"/>ऊ उस रोज तक पवितर आतमा के दवारा अपन चुने हर चेलन के आदेस दय जाय के बाद उके स्वरग छो उठाय नेहको लय गइस। <verse eid="ACT 1:2"/><verse number="3" style="v" sid="ACT 1:3"/>यीसु अपन मिरतू कर बाद ऊ अपन खुद के बोहत लग मजबूत सबूत कर संग उनखर आगू परगट करिस कि ऊ जिन्दा हबै, ऊ चालीस रोज तक उनही दिखाई देत रथै अउ उनखर लग भगवान कर राज के बारे हे बात करथै। <verse eid="ACT 1:3"/><verse number="4" style="v" sid="ACT 1:4"/>यीसु चेलन के संग भोजन करत टेम उनही आदेस दइस, कि उन “यरुसलेम नगर झइ छांडै बलुक बाफ जउन टीमा करे हबै, ओही ओरगत रहा ऊ कथै, मै तुमही ऊ टीमा कर बारे हे गुठे दय हबो। <verse eid="ACT 1:4"/><verse number="5" style="v" sid="ACT 1:5"/>यीसु कथै, यूहन्ना पानी हे बतिस्मा दय रथै, पय कुछ रोज के बाद तुमही पवितर आतमा लग बतिस्मा दय जही।”<verse eid="ACT 1:5"/></para>
  <para style="s">यीसु के स्वरग छो उठाय जायके</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 1:6"/>जब चेला यीसु के संग अक जिघा रथै, तब उन हइ सबाल करथै, “परभु का तै हइ टेम इस्राएल के राज फेरै स्थापित करही?” <verse eid="ACT 1:6"/><verse number="7" style="v" sid="ACT 1:7"/>यीसु जबाब दइस, “बाफ जउन काल अउ निस्चित टेम अपन खास हक हे धरे हबै, उनही जानै के तुम्हर काम नेहको हबै। <verse eid="ACT 1:7"/><verse number="8" style="v" sid="ACT 1:8"/>पय पवितर आतमा तुम्हर हे उतरी अउ तुमही बल देही अउ तुम यरुसलेम छो, सगलू यहूदिया अउ सामरिया परदेसन हे अउ भुंइ के आखरी छोर तक मोर गवाह हुइहा।” <verse eid="ACT 1:8"/><verse number="9" style="v" sid="ACT 1:9"/>एतका कहै के बाद यीसु उनखर देखत-देखत उप्पर उठाय लय गइस अउ अक्ठी बादर उन चेलन के आंखी के अंधियार कर दइस।<verse eid="ACT 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 1:10"/>ओखर जात टेम जब ऊ बादर कर पल्ला निहारत रथै, ता देखथै, दुइठे डउका चरका खुरथा पइजामा पहिरे हर, उनखर लिघ्घो आयके ठाढ होथै। <verse eid="ACT 1:10"/><verse number="11" style="v" sid="ACT 1:11"/>अउ उनखर लग कथै, “हे गलीली मनसे, तुम काखे ठाढ हुइके बादर के पल्ला निहारथा? इहै यीसु, जउन तुम्हर लिघ्घो लग स्वरग हे उठाय लय गय हबै, जउन मेर लग तुम उके स्वरग छो जात देखे हबा, उहै मेर लग फेरै लउटाही।”<verse eid="ACT 1:11"/></para>
  <para style="s">मत्तियाह कर यहूदा के पदवी मिलथै</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 1:12"/>फेर चेला जैतून नाम डोंगर लग जउन यरुसलेम लग करीबन अक कोस के दुरिहां हे हबै, यरुसलेम छो लउट आथै। <verse eid="ACT 1:12"/><verse number="13" style="v" sid="ACT 1:13"/>जब ऊ यरुसलेम सहर हे पहुंचिन तब उप्पर बाले पटउंहा हे गइन, जछो पतरस, यूहन्ना अउ याकूब अउ अन्द्रियास अउ फिलिप्पुस अउ थोमा अउ बरतुल्मै अउ मत्ती अउ हलफई कर टोरवा याकूब अउ समोन जेलोतेस अउ याकूब कर टोरवा यहूदा जिहां उन रुके रथै। <verse eid="ACT 1:13"/><verse number="14" style="v" sid="ACT 1:14"/>उनखर संग कुछ डउकी अउ यीसु कर दाय मरियम अउ ओखर भाई रथै, हइ सगलू खुदय के अक संग हुइके बिनती हे लगे रथै।<verse eid="ACT 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 1:15"/>कुछ रोज बाद पतरस बिस्वासी भाई के आराधनालय हे अक सव बीस मनसेन के संख्या करीबन रथै, पतरस ठाढ हुइके कहै लगिस। <verse eid="ACT 1:15"/><verse number="16" style="v" sid="ACT 1:16"/>“हे भाइयो,” जरूरी रहिस कि पवितर किताब के ऊ आगू कर बात पूर हुइ जाय, जउन पवितर आतमा दाऊद के मुंह लग यहूदा कर बारे हे करे रथै, यहूदा तो यीसु के पकरवामै बाले कर मुखिया बन गइस। <verse eid="ACT 1:16"/><verse number="17" style="v" sid="ACT 1:17"/>यहूदा हमर समूह के सदस्य रथै अउ सेबा हे ओखरो हाथ रथै।<verse eid="ACT 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 1:18"/>ऊ अपन बेकार कमाई लग अक्ठी खेत खरीदथै अउ ऊ मुन्डी के भार गिरथै अउ ओखर लादा फट जथै अउ ओखर सगलू आंटी पोटा बाहिर निकड आइस। <verse eid="ACT 1:18"/><verse number="19" style="v" sid="ACT 1:19"/>सगलू यरुसलेम के रहैबाले के पता चल जथै, इहैनिता उनखर भासा हे ऊ खेत के हकलदमा कथै, जेखर मतलब हबै, खून कर खेत।<verse eid="ACT 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 1:20"/>काखे भजन संहिता कर किताब हे लिखररे हबै,</para>
  <para style="q1" vid="ACT 1:20">कि ओखर घर उजड जाय अउ ओहमा कउ झइ रहै,</para>
  <para style="q2" vid="ACT 1:20">ओहमा असना लिखवरे हबै,</para>
  <para style="q1" vid="ACT 1:20">ओखर सेबा के जिघा कउ अउ के मिलै।<verse eid="ACT 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 1:21"/>इहैनिता जरूरी हबै कि जेतका टेम तक परभु यीसु हमर बीच आउत जात रहै। <verse eid="ACT 1:21"/><verse number="22" style="v" sid="ACT 1:22"/>मतलब यूहन्ना कर बतिस्मा लग लइके परभु के स्वरग छो जाय के रोज तक जउन मनसे बरोबर हमर संग रथै, उन मसे अक्ठी हमर संग परभु के फेरै जिन्दा होयके गवाह बनै।<verse eid="ACT 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 1:23"/>एखर बाद उन दुइठे मनसे के हाजिर करथै, यूसुफ के जउन बरसबा कहाथै अउ जेखर उपनाम यूसतुस रथै अउ मत्तियाह कर। <verse eid="ACT 1:23"/><verse number="24" style="v" sid="ACT 1:24"/>तब उन हइमेर बिनती करिस, “परभु तै सबके हिरदय जानथस, हइ परगट कर कि तै इन दुनो मसे केही चुने हबस, <verse eid="ACT 1:24"/><verse number="25" style="v" sid="ACT 1:25"/>ताकि ऊ उस सेबा अउ चेला पदवी के जिघा ग्रहन करे, जेखर लग पतित होय कि यहूदा अपन जिघा के कढ गइस।” <verse eid="ACT 1:25"/><verse number="26" style="v" sid="ACT 1:26"/>ऊ उन दुनो के निता चिट्ठी डालिस, चिट्ठी मत्तियाह कर नाम निकरिस अउ उन ग्यारह चेलन के संग सामिल कर लय गइस।<verse eid="ACT 1:26"/></para>
  <chapter eid="ACT 1"/>
  <chapter number="2" style="c" sid="ACT 2"/>
  <para style="s">पवितर आतमा उतरथै</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 2:1"/>जब आठै खाय के यहूदी तेउहार के पचासमा रोज आथै, ता सगलू चेला अक जिघा जुडथै, <verse eid="ACT 2:1"/><verse number="2" style="v" sid="ACT 2:2"/>ता अचनकै बडी बडेरा के जसना आरो बादर लग सुनाई दइस अउ सगलू घर जिहां उन बइठे हर रथै, गूंज उठिस। <verse eid="ACT 2:2"/><verse number="3" style="v" sid="ACT 2:3"/>अउ आगी के धांग के जसना फइलत अउ जीभ उहां फटत दिखाई देय लगथै, ऊ आगी के अलगे-अलगे जीभ हर अक झन के उप्पर आय ठहरिस। <verse eid="ACT 2:3"/><verse number="4" style="v" sid="ACT 2:4"/>उन सगलू पवितर आतमा लग भरपूर हुइ गइन अउ जउन आरो के बरदान पवितर आतमा उनही दइस, ओखर जसना कइन मेर भासा हे बोलै लगिन।<verse eid="ACT 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 2:5"/>बादर के तरी रहै बाले उन यरुसलेम हे दुनिया कर सगलू देसन लग आय हर यहूदी रहे करथै। <verse eid="ACT 2:5"/><verse number="6" style="v" sid="ACT 2:6"/>जब हइ आरो गरजथै, तब अक्ठी बडी भीड अक जिघा हुइ गइस, ऊ चकराय गइस काखे बिस्वास करै बाले भाइन के उन अपन खुदय के भासा बोलत सुनथै। <verse eid="ACT 2:6"/><verse number="7" style="v" sid="ACT 2:7"/>ऊ सगलू अचम्भित हुइके गुठेमै लग जथै, देखा, हइ जउन बोलथै का सगलू गलीली परान्त के नेहको? <verse eid="ACT 2:7"/><verse number="8" style="v" sid="ACT 2:8"/>फेर हमर लग हर अक झन हमर अपन बोली भासा हे बोलत कसना सुनथन? <verse eid="ACT 2:8"/><verse number="9" style="v" sid="ACT 2:9"/>हम पारथी, मेदी, एलामी, मेसोपोटामिया कर निबासी, यहूदिया अउ कप्पदूकिया, पुन्तुस अउ आसिया, <verse eid="ACT 2:9"/><verse number="10" style="v" sid="ACT 2:10"/>फ्रूगिया, पंफूलिया, मिस्र अउ लीबिया देस जउन कुरेने के अगल-बगल हबै, इन सब परदेसन के मनसे रोम लग आय हर यातरी जेहमा पइदाइसी रोमी रथै। <verse eid="ACT 2:10"/><verse number="11" style="v" sid="ACT 2:11"/>अउ यहूदी अच्छी धारन करैबाले मनसे क्रेती अउ “अरब कर रहैबाले हम सबझन भगवान कर चकित के काम के अपन-अपन भासा हे सुनथन” <verse eid="ACT 2:11"/><verse number="12" style="v" sid="ACT 2:12"/>उन सब मनसे चकित अउ सक हे पड जथै अउ अक दूसर लग पूछै लग जथै कि “हइ सब काहिन बात हबै?” <verse eid="ACT 2:12"/><verse number="13" style="v" sid="ACT 2:13"/>पय दूसर मनसे चेलन के मजाक उडाउत कथै, “इन सबझन बोहत दारू पी हबै।”<verse eid="ACT 2:13"/></para>
  <para style="s">पतरस कर बात</para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 2:14"/>फेर उन ग्यारह झन के संग पतरस ठाढ होथै अउ ऊंच आरो लग मनसेन के सम्बोधन करत कथै, हे यहूदी संगी अउ यरुसलेम के सगलू संगी मोर बात के धियान सुना अउ मोके हइ बात के मतलब गुठेमै देया। <verse eid="ACT 2:14"/><verse number="15" style="v" sid="ACT 2:15"/>ऊ मनसे नसा हे नेहको हमै, जसना तुम समझथा काखे अबे तो सकरहा कर नव बजे हबै। <verse eid="ACT 2:15"/><verse number="16" style="v" sid="ACT 2:16"/>पय ऊ बात हबै, जेखर बारे हे योएल नबी ग्यानी मनसे के दवारा गुठे रथै,<verse eid="ACT 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 2:17"/>भगवान हइ कथै, कि मै आखरी के रोज,</para>
  <para style="q2" vid="ACT 2:17">हे सगलू मनसे हे अपन आतमा दइहों,</para>
  <para style="q1" vid="ACT 2:17">ता तुम्हर टोरवा टोरिया आगू कर बात गुठेही,</para>
  <para style="q2" vid="ACT 2:17">अउ तुम्हर जबान दरसन देखही,</para>
  <para style="q2" vid="ACT 2:17">अउ तुम्हर सियान सपना देखही।<verse eid="ACT 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ACT 2:18"/>उन रोज हे अपन हरवाह,</para>
  <para style="q2" vid="ACT 2:18">अउ हरवाहिन हे अपन आतमा दइहों,</para>
  <para style="q2" vid="ACT 2:18">अउ उन आगू कर बात गुठेही।<verse eid="ACT 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ACT 2:19"/>अउ मै उप्पर बादर हे चकित कर काम,</para>
  <para style="q2" vid="ACT 2:19">अउ तरी भुंइ हे चिन्हा मतलब खून,</para>
  <para style="q1" vid="ACT 2:19">आगी अउ कुहिटा कर बादर दिखाहुं।<verse eid="ACT 2:19"/></para>
  <para style="q2">
    <verse number="20" style="v" sid="ACT 2:20"/>बेरा अंधियार,</para>
  <para style="q2" vid="ACT 2:20">अउ जोधइया खून कर जसना ललका हुइ जही,</para>
  <para style="q2" vid="ACT 2:20">परभु के महान अउ महिमा आमै के आगू लग।<verse eid="ACT 2:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ACT 2:21"/>जउन कउ परभु कर नाम लेही उके परभु बचाही।<verse eid="ACT 2:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 2:22"/>“हे इस्राएली भाई, मोर बातन के धियान लग सुना, भगवान यीसु नासरी के दवारा तुम्हर बीच केतका चकित के काम करे हबै अउ चिन्हा दय हबै, जउन भगवान तुम्हर बीच ओखर दवारा करके दिखाय हबै, एखर लग साबित होथै कि ऊ भगवान के तरफ लग आय हबै।” <verse eid="ACT 2:22"/><verse number="23" style="v" sid="ACT 2:23"/>ऊ यीसु के भगवान सही योजना अउ निस्चित ग्यान के जसना तुमही धराय गय हबै अउ तुम पापी मनसेन के सहयोग लग उके क्रूस हे टंगाय के मार डाला। <verse eid="ACT 2:23"/><verse number="24" style="v" sid="ACT 2:24"/>पय भगवान उके मरै के पीरा लग छंडाइस अउ फेरै लग जियाइस, मिरतू हे एतका सक्ति नेहको रथै, कि उके बन्दी बनाय के रखै। <verse eid="ACT 2:24"/><verse number="25" style="v" sid="ACT 2:25"/>काखे कि दाऊद ओखर बारे हे कथै,</para>
  <para style="q1" vid="ACT 2:25">मै परभु के सबरोज अपन आंखी हे देखत रहों,</para>
  <para style="q2" vid="ACT 2:25">काखे कि ऊ मोर दहिना पल्ला हबै, ता मै झइ हिलो।<verse eid="ACT 2:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 2:26"/>इहैनिता मोर मन मगन हबै,</para>
  <para style="q2" vid="ACT 2:26">अउ मोर जीभ मगन हबै,</para>
  <para style="q1" vid="ACT 2:26">मोर देह आसा हे जीय।<verse eid="ACT 2:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 2:27"/>काखे परान के नरक हे पवितर बिस्वास करैबाले,</para>
  <para style="q2" vid="ACT 2:27">सेबकन के मरघटी हे सरै नेहको देही।<verse eid="ACT 2:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ACT 2:28"/>तै मोके जीवन के पल्ला जाय के गली दिखाय हबै,</para>
  <para style="q2" vid="ACT 2:28">तै मोके अपन दरसन के दवारा मगन लग भर दइहे।<verse eid="ACT 2:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 2:29"/>हे मोर भाइयो, मै अपन पुरखा दाऊद राजा कर बारे हे तुम्हर लग हिम्मत के संग गुठे सकथों, कि ऊ तो मर गइस अउ गाडे गइस अउ ओखर मरघटी आज तक हमार इहां मउजूद हबै। <verse eid="ACT 2:29"/><verse number="30" style="v" sid="ACT 2:30"/>ऊ अक्ठी ग्यानी मनसे रहिस, ऊ जानथै कि भगवान मोर लग किरिया के संग हे उके टीमा दय कि ओखर पुरखन मसे कउनो अकझन के ओखर राजगद्दी हे बइठाही। <verse eid="ACT 2:30"/><verse number="31" style="v" sid="ACT 2:31"/>इहैनिता जउन मसीह के भभिस्य हे घटै बाले हबै, उके देखत दाऊद हइ कथै,</para>
  <para style="q1" vid="ACT 2:31">“ओहमा मिरतू दुनिया नरक हे नेहको छांडिस,</para>
  <para style="q2" vid="ACT 2:31">अउ न ओखर देह के मरघटी हे सरै दइ”<verse eid="ACT 2:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 2:32"/>इहै यीसु कर भगवान जिलाथै, जेखर हम सगलू झन हइ बात के गवाह हबन। <verse eid="ACT 2:32"/><verse number="33" style="v" sid="ACT 2:33"/>भगवान के दहिना हाथ लग ऊंच पदवी पाय के यीसु परम बाफ के टीमा के जसना पवितर आतमा पाइस, फेर ऊ हइ आतमा के हमर हे उडेल दइस, जेही अब तुम देखथा अउ सुनथा। <verse eid="ACT 2:33"/><verse number="34" style="v" sid="ACT 2:34"/>काखे कि दाऊद तो स्वरग हे नेहको गइस पय ऊ खुदय कथै,</para>
  <para style="q1" vid="ACT 2:34">परभु भगवान मोर परभु लग कथै,</para>
  <para style="q2" vid="ACT 2:34">मोर दहिना पल्ला बइठे रहा,<verse eid="ACT 2:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="ACT 2:35"/>जब तक कि मै तोर बैरी के तोर गोड तरी के चउकी नेहको बना देहुं।<verse eid="ACT 2:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 2:36"/>इहैनिता सगलू इस्राएल सही हे जान लेया कि भगवान हइ यीसु के तुम क्रूस हे लटकाय दय रथा, परभु अउ मसीह दुनो ठहराय रथै।<verse eid="ACT 2:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 2:37"/>मनसे जब हइ सुनथै ता उन चकित होथै पतरस अउ चेलन लग कथै, “हे भाइयो हमके काहिन करै चाही?” <verse eid="ACT 2:37"/><verse number="38" style="v" sid="ACT 2:38"/>तब पतरस उनखर लग कथै, “मन बदला अउ अपन पापन के छमा पामै के निता तुम्हर मसे हरेक झन के यीसु मसीह के नाम लग पानी हे बतिस्मा ले चाही अउ तुमही पवितर आतमा के बरदान मिलही। <verse eid="ACT 2:38"/><verse number="39" style="v" sid="ACT 2:39"/>काखे कि हइ टीमा तुम अउ तुम्हर लरका अउ ऊ सगलू दुरिहां कर मनसे के निता हबै, जिनही परभु हमर भगवान अपन लिघ्घो बुलाय हबै।”<verse eid="ACT 2:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 2:40"/>पतरस अउ बोहत लग बचन दवारा उनही चेतन्त करथै अउ बिनती के संग उनखर लग कथै, “हइ नास होमै बाले पुरखन लग अपन खुद के बचाय रखिहा।” <verse eid="ACT 2:40"/><verse number="41" style="v" sid="ACT 2:41"/>उनखर मसे बोहत झन ओखर बात के सुनके बिस्वास करिन अउ उनही पानी लग बतिस्मा दइस, हइमेर ऊ रोज उनखर संग करीबन तीन हजार मनसे जुड गइन।<verse eid="ACT 2:41"/></para>
  <para style="s">सुरुवात मसीही मनसेन के धरमी जीवन</para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 2:42"/>अउ बिस्वास करै बालेन के साझा जीवन चेलन लग दिमाक पामै अउ संगति रखै अउ रोटी टोरै अउ बिनती करै हे मगन रथै। <verse eid="ACT 2:42"/><verse number="43" style="v" sid="ACT 2:43"/>चेलन कर दवारा बोहत लग चकित के काम के चिन्हा परगट अउ हर अक्ठी मनसे चकित लग भर गइन। <verse eid="ACT 2:43"/><verse number="44" style="v" sid="ACT 2:44"/>अउ सगलू बिस्वास करैबाले लगेतार संगति हे रथै अउ उनखर लिघ्घो जउन कुछु रथै, उन उके अपनै हे बांटचोंट लेथै। <verse eid="ACT 2:44"/><verse number="45" style="v" sid="ACT 2:45"/>उन अपन धन डेरा अउ चीजन के बेच भांज के अउ ओखर लग मिलै बाले पइसा के हर अकझन के जेखर जसना जरूरत रथै बांट देथै। <verse eid="ACT 2:45"/><verse number="46" style="v" sid="ACT 2:46"/>उन सबरोज बिनती भवन हे अक संग मिलथै, उन अपन घर हे अक संग खाना बांटचोंट के अउ सच्चे मन लग मगन के संग मिलजुल के खाना खथै। <verse eid="ACT 2:46"/><verse number="47" style="v" sid="ACT 2:47"/>सगलू मनसे के अच्छी भावना के मगन लेत भगवान कर भजन करत जउन रोजदिन परभु के दवारा मुकति पाथै, उनखर संग जोड देथै।<verse eid="ACT 2:47"/></para>
  <chapter eid="ACT 2"/>
  <chapter number="3" style="c" sid="ACT 3"/>
  <para style="s">लेंगरा मनसे निक्खा होथै</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 3:1"/>अक रोज पतरस अउ यूहन्ना दुपहरी के तीन बजे बिनती करै के टेम बिनती भवन छो जथै। <verse eid="ACT 3:1"/><verse number="2" style="v" sid="ACT 3:2"/>कुछ मनसे अक्ठी मनसे के लइ जथै, जउन पइदाइस लग लेंगरा रथै, उन उके रोजदिना लान के बिनती भवन के सुन्दर नाम के दूरा के लिघ्घो छांड देथै, जेखर लग ऊ बिनती भवन के भित्तर जाय बालेन लग भीख मांग सकै। <verse eid="ACT 3:2"/><verse number="3" style="v" sid="ACT 3:3"/>जब ऊ पतरस अउ यूहन्ना के बिनती भवन छो जात देखथै, ता उनखर लग भीख मांगथै। <verse eid="ACT 3:3"/><verse number="4" style="v" sid="ACT 3:4"/>पतरस अउ यूहन्ना उके धियान लग देखथै, पतरस कथै, “हमर पल्ला देख।” <verse eid="ACT 3:4"/><verse number="5" style="v" sid="ACT 3:5"/>मतलब ऊ उनखर लग कुछु पामै के ओरगथै। <verse eid="ACT 3:5"/><verse number="6" style="v" sid="ACT 3:6"/>पय पतरस कथै, “मोर लिघ्घो चांदी अउ सोना तो नेहको हबै, पय जउन कुछु हबै मै तोके देथो, यीसु मसीह नासरी के नाम लग रेंग बाग।” <verse eid="ACT 3:6"/><verse number="7" style="v" sid="ACT 3:7"/>फेर ऊ ओखर दहिना हाथ पकरके उके ठाड करथै ऊ उहै टेम ठाड हुइ जथै अउ इछो उछो रेंगै बागै लग जथै। <verse eid="ACT 3:7"/><verse number="8" style="v" sid="ACT 3:8"/>ऊ खुसी लग अपन गोड हे ठाड हुइ जथै अउ इछो उछो रेंगै बागै लग जथै, फेर ऊ उनखर संग उछलत कूदत बिनती भवन हे गइस अउ भगवान कर भजन करत रथै। <verse eid="ACT 3:8"/><verse number="9" style="v" sid="ACT 3:9"/>अउ सगलू मनसे उके रेंगत बागत अउ भगवान कर भजन करत देखथै। <verse eid="ACT 3:9"/><verse number="10" style="v" sid="ACT 3:10"/>मनसे उके चीन्ह लेथै, कि हइ उहै हबै जउन सुन्दर नाम के बिनती भवन हे बइठके भीख मांगे करथै अउ ओखर संग जउन घटना घटिस, उके देखके चकित हुइ जथै।<verse eid="ACT 3:10"/></para>
  <para style="s">मन्दिर हे पतरस कर संदेस</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 3:11"/>जब ऊ पतरस अउ यूहन्ना कर संग रथै, इहैनिता सगलू मनसे बोहत चकराय के, सुलेमान नाम के अंगना कहाथै, उनखर लिघ्घो दउरे आथै। <verse eid="ACT 3:11"/><verse number="12" style="v" sid="ACT 3:12"/>हइ देखके पतरस मनसेन लग कथै, “हे इस्राएली भाइयो तुम काखे चकराथा अउ हमार पल्ला काखे आंखी काढ कर देखथा? लागथै कि हमिन अपन सक्ति अउ भक्ति लग हइ मनसे के रेंगै बागै के काबिल बनाय हबन।” <verse eid="ACT 3:12"/><verse number="13" style="v" sid="ACT 3:13"/>अब्राहम, इसहाक अउ याकूब कर भगवान हमर बाफ दादन के भगवान अपन सेबक यीसु के बडा महिमा परदान करिस, पय तुम उके साहबन के हाथ हे सउप दया अउ पिलातुस के आगू इन्कार करा, जब कि पिलातुस उके छांड देय के निस्चित करथै, <verse eid="ACT 3:13"/><verse number="14" style="v" sid="ACT 3:14"/>तुम ऊ पवितर अउ धरमी मनसे के नकारे हबै, एखर बदला हे पिलातुस लग मांग करै कि तुम्हर निता अक्ठी खून करै बाले के छांड दय जाय। <verse eid="ACT 3:14"/><verse number="15" style="v" sid="ACT 3:15"/>तुम जीवन के गली दिखामै बाले के मार डारे हबा, पय भगवान मरे हर मसे उके फेरै लग जिन्दा कर दइस अउ जेखर गवाह हबन। <verse eid="ACT 3:15"/><verse number="16" style="v" sid="ACT 3:16"/>काखे हम यीसु कर नाम हे बिस्वास करथन, इहैनिता हइ ओखर नाम हबै, जउन हइ लेंगरा मनसे के सक्ति दय हबै, जेही तुम देखथा अउ जानथा जेखर गोड हे बल दय हबै, उहै बिस्वास जउन यीसु लग मिलथै, तुम सबके आगू हइ मनसे के पूरी रीत लग निक्खा करे हबै।<verse eid="ACT 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 3:17"/>अउ हे भाइयो, मै जानथो कि हइ काम तुम अनजाने हे करे हबा, ओसनेन तुम्हर सरदार करे हबै। <verse eid="ACT 3:17"/><verse number="18" style="v" sid="ACT 3:18"/>पय जउन बातन के भगवान ग्यानी मनसे के आगू गुठे दय हबै, कि ओखर मसीह दुख उठाही अउ उनही ऊ इहैमेर लग पूर करथै। <verse eid="ACT 3:18"/><verse number="19" style="v" sid="ACT 3:19"/>इहैनिता मन बदला अउ भगवान के पल्ला लउट आबा तबय तुम्हर पाप के छमा करही। <verse eid="ACT 3:19"/><verse number="20" style="v" sid="ACT 3:20"/>ताकि आतमिक बल के टेम परभु भगवान कर पल्ला लग आबै अउ परभु तुम्हर निता मसीह के पठोबै, जेही ऊ तुम्हर निता उके पहिलेन लग चुन के रखे हबै। मतलब यीसु के, <verse eid="ACT 3:20"/><verse number="21" style="v" sid="ACT 3:21"/>जरूरी हबै कि ऊ स्वरग हे ऊ टेम तक रही, जब तक कि हइ सगलू बात पहिलेन जइसन सुधारे नेहको जही, बोहत पहिलेन लग जेखर बारे हे भगवान अपन पवितर ग्यानी मनसेन के दवारा गुठे हबै। <verse eid="ACT 3:21"/><verse number="22" style="v" sid="ACT 3:22"/>मूसा कथै, परभु भगवान तुम्हर भाई निता अपन मनसे मसे अक्ठी ग्यानी मनसे के पठोही अउ जउन कुछु करै के कहि तै उहै करबे। <verse eid="ACT 3:22"/><verse number="23" style="v" sid="ACT 3:23"/>पय जउन कउ मनसे ग्यानी मनसे कर बात नेहको मनही उके भगवान मनसे लग अलग करै अउ नास करे जही। <verse eid="ACT 3:23"/><verse number="24" style="v" sid="ACT 3:24"/>अउ समूएल नबी लग लइके ओखर बाद बाले तक जेतका ग्यानी मनसे बोलथै, हइ रोज के आदेस करे हबै। <verse eid="ACT 3:24"/><verse number="25" style="v" sid="ACT 3:25"/>तुम ग्यानी मनसे के लरका अउ टीमा के हिस्सा हबा, जेही भगवान तुम्हर बाफ दादन के संग करे रथै, जब ऊ अब्राहम लग कथै, तोर पीढी के दवारा दुनिया के सगलू घर भरेन के मनसे आसीस पइहिन। <verse eid="ACT 3:25"/><verse number="26" style="v" sid="ACT 3:26"/>“भगवान अपन सेबक के चुनथै, पहिलेन तुम्हर लिघ्घो पठोय दइस, ताकि तुमही तुम्हर सगलू रास्ता लग आसीस देही।”<verse eid="ACT 3:26"/></para>
  <chapter eid="ACT 3"/>
  <chapter number="4" style="c" sid="ACT 4"/>
  <para style="s">दरबार कर आगू पतरस अउ यूहन्ना</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 4:1"/>जब ऊ मनसेन लग हइ बात कथै, ता धरमी काम करै बाले अउ बिनती भवन के पुजारी अउ सदूकी<note caller="+" style="f"><char style="fr" closed="false">4:1 </char><char style="ft" closed="false">सदूकी हइ अक्ठी यहूदी धारमिक समूह रथै जउन मुख्य पुजारी के काम अउ अपन हक हे रखथै।</char></note> उनखर हे चढ आथै। <verse eid="ACT 4:1"/><verse number="2" style="v" sid="ACT 4:2"/>ऊ उनखर लग हइ बात हे चिडे रथै कि पतरस अउ यूहन्ना उन मनसेन के सिखाउत रथै, कि यीसु मरे हर मसे जी उठे हबै, इनखर लग हइ साबित करथै कि मरे हर जी उठ सकथै। <verse eid="ACT 4:2"/><verse number="3" style="v" sid="ACT 4:3"/>उन उके बन्दी बनाय लेथै, काखे कि ऊ टेम संझा हुइ चुके रथै, इहैनिता उनके जेल हे रखिन। <verse eid="ACT 4:3"/><verse number="4" style="v" sid="ACT 4:4"/>पय जउन ऊ संदेस सुनिन उनखर मसे बोहत झन ओखर हे बिस्वास करिन अउ हइमेर लग उनखर गिनती करीबन पांच हजार मनसे हुइ जथै।<verse eid="ACT 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 4:5"/>आने रोज यहूदी कर अगुवा, सरदार अउ नियम के गुरू यरुसलेम हे जुडथै। <verse eid="ACT 4:5"/><verse number="6" style="v" sid="ACT 4:6"/>महाजक हन्ना, कैफा, यूहन्ना, सिकन्दर अउ पुजारिन के घराना के सगलू मनसे पधारथै। <verse eid="ACT 4:6"/><verse number="7" style="v" sid="ACT 4:7"/>उन हइ चेलन के ठाड हुइके पूछै लग जथै, तुम केखर सक्ति अउ केखर नाम लग काम करथस? <verse eid="ACT 4:7"/><verse number="8" style="v" sid="ACT 4:8"/>फेर पवितर आतमा लग भर के पतरस उनखर लग कथै, “हे मनसेन के नेता सरदार सियानन कर नेता। <verse eid="ACT 4:8"/><verse number="9" style="v" sid="ACT 4:9"/>पय आज हमर लग अक्ठी लेंगरा मनसे के संग धरमी काम के बारे हे हइ पूछतांछ करे जथै, कि ऊ निक्खा हुइ गइस। <verse eid="ACT 4:9"/><verse number="10" style="v" sid="ACT 4:10"/>ता तुम सब के अउ इस्राएल के मनसेन के हइ पता होमैके चाही, कि हइ काम यीसु मसीह नासरी कर नाम लग हुइस, जेही तुम क्रूस हे टंगाया अउ जेही भगवान मरे हर मसे फेरै लग जिन्दा कर दइस। उहै के दवारा लग निक्खा हुइस, हइ मनसे तुम्हर आगू ठाड हबै।” <verse eid="ACT 4:10"/><verse number="11" style="v" sid="ACT 4:11"/>हइ यीसु उहै,</para>
  <para style="q1" vid="ACT 4:11">पथरा जउन तुम घर बनामै बाले मिसतिरी नकारे रथै,</para>
  <para style="q2" vid="ACT 4:11">उहै सब लग खास पथरा बन गइस।<verse eid="ACT 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 4:12"/>कउनो दूसर मनसे के दवारा मुकति नेहको हबै काखे स्वरग के तरी मनसेन हे कउ दूसर नाम नेहको दय गय हबै, जेखर दवारा हम मुकति पाय सकि।<verse eid="ACT 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 4:13"/>जब उन पतरस अउ यूहन्ना के हिम्मत देखथै अउ हइ जानथै, कि हइ अनपढ अउ सच्चे मनसे हबै, ता अचम्भित हे पड गइन, फेर उन उनही चीनथै कि हइ यीसु कर संग रह चुके हबै। <verse eid="ACT 4:13"/><verse number="14" style="v" sid="ACT 4:14"/>पय ऊ उस मनसे के जउन निक्खा होय रथै, उनखरै संग ठाड देखथै, इहैनिता उनखर लिघ्घो कहै के निता कुछु नेहको रथै। <verse eid="ACT 4:14"/><verse number="15" style="v" sid="ACT 4:15"/>उनही यहूदी आराधनालय लग निकाडे जाय के कथै अउ फेर ऊ अपनै हे सोच बिचार करै लगथै। <verse eid="ACT 4:15"/><verse number="16" style="v" sid="ACT 4:16"/>पय हइ मनसे कर संग काहिन करी? काखे यरुसलेम नगर के सगलू रहै बालेन हे परगट हबै, कि इनखर दवारा अक्ठी प्रसिध्द चिन्हा देखाय गय हबै, मनसे सोचै लगथै अउ हम इनही मना नेहको कर सकथन। <verse eid="ACT 4:16"/><verse number="17" style="v" sid="ACT 4:17"/>पय हम उनही चेताय दइ इहैनिता कि हइ बात मनसे हे अउ जादा झइ फइल जाय, उनही हइ नाम लग फेर कउनो मनसे लग बात झइ करै।<verse eid="ACT 4:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 4:18"/>ता उनके बुलवाथै अउ धमकी देखके हइ कथै, यीसु के नाम ले कुछु झइ गुठेइहा अउ झइ सिखइहा। <verse eid="ACT 4:18"/><verse number="19" style="v" sid="ACT 4:19"/>पय पतरस अउ यूहन्ना उनही जबाब दइन, “तुमिन नियाव करा कि भगवान के आगू हमर निता हइ जरूरी होही कि भगवान के आदेस न मानके तुम्हर आदेस मानी। <verse eid="ACT 4:19"/><verse number="20" style="v" sid="ACT 4:20"/>हम जउन कुछु देखे अउ सुने हबन, हम उके बताय लग नेहको चूकबो।” <verse eid="ACT 4:20"/><verse number="21" style="v" sid="ACT 4:21"/>फेर उनही ऊ बोहत हडकाय के छांड देथै, काखे उनही सजा देय के कउनो मेर के बहाना नेहको मिलिस, काखे जउन घटना घटे रथै, ओखर निता सगलू मनसे भगवान कर बडाई करथै। <verse eid="ACT 4:21"/><verse number="22" style="v" sid="ACT 4:22"/>अउ जेखर उप्पर हइ निक्खा करै के चिन्हा के काम देखाय गय रथै, ऊ चालीस साल लग जादो रथै।<verse eid="ACT 4:22"/></para>
  <para style="s">बिस्वास करै बाले मनसे के निता हिम्मत के बिनती</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 4:23"/>पतरस अउ यूहन्ना के छांड दय गइस, ऊ फेरै लग ऊ मनसे के समूह हे गइन अउ उनखर लग जउन कुछ खास याजक अउ सियान लग कथै, उनही सगलू बात गुठे देथै। <verse eid="ACT 4:23"/><verse number="24" style="v" sid="ACT 4:24"/>पय बिस्वास करै बाले हइ सुनिन ता मिलके बोहत आरो लग भगवान लग बिनती करै लगिन परभु तहिन हबस स्वरग, भुंइ, समुन्दर उनखर भित्तर जउन कुछ हबै, उनही बनाय हबै। <verse eid="ACT 4:24"/><verse number="25" style="v" sid="ACT 4:25"/>तै अपन पवितर आतमा के दवारा अपन सेबक, हमर पुरखा दाऊद के मुंह लग कहे रथस,</para>
  <para style="q1" vid="ACT 4:25">उन गैर यहूदी मनसे के पता नेहको काखे अपन घमंड दिखाथै?</para>
  <para style="q2" vid="ACT 4:25">अउ देस-देस के मनसे बेकार के साजिस बनाइन?<verse eid="ACT 4:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 4:26"/>परभु अउ ओखर मसीह के बैरी हे भुंइ के राजा ठाड होथै,</para>
  <para style="q2" vid="ACT 4:26">अउ राज करैबाले सरदार,</para>
  <para style="q2" vid="ACT 4:26">अकै संग अक जिघा होथै।<verse eid="ACT 4:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 4:27"/>हेरोदेस अउ पुन्तियुस पिलातुस हइ सहर हे गैर यहूदी अउ इस्राएली के मिलके तोर पवितर सेबक यीसु के बिरोध हे, जेही तै मसीह के सकल हे अभिसेक करे रथै, सही हे अकजुट हुइ जथै। <verse eid="ACT 4:27"/><verse number="28" style="v" sid="ACT 4:28"/>उन अक जिघा हुइन अउ ताकि तोर सक्ति अउ इक्छा के जसना जउन कुछु पहिलेन लग निहचित रथै, ऊ पूर हुइ सकै। <verse eid="ACT 4:28"/><verse number="29" style="v" sid="ACT 4:29"/>हे परभु उनखर उप्पर धियान दे अउ अपन सेबकन के हइ बरदान दे, कि तोर सब्द बडे हिम्मत लग सुनामै। <verse eid="ACT 4:29"/><verse number="30" style="v" sid="ACT 4:30"/>जब कि तै निक्खा करै के निता तै हाथ बढाय अउ चिन्हा अउ चकित कर काम तोर पवितर सेबक दवारा यीसु कर नाम लग करे जथै।<verse eid="ACT 4:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 4:31"/>जब ऊ बिनती कर चुकथै, ता ऊ जिघा जिहां ऊ अक जिघा रथै डोल जथै, अउ ऊ सगलू पवितर आतमा लग भर जथै अउ ऊ बिगर डरे भगवान कर बचन सुनामै लगिन।<verse eid="ACT 4:31"/></para>
  <para style="s">बिस्वास करै बाले कर सामुहिक जीवन</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 4:32"/>बिस्वास करै बाले कर समूह अक मन रथै, कउ हइ नेहको कहि सकथै, कि ओखर कउनो चीज ओखर आय, उनखर लिघ्घो जउन कुछु होथै, उन अपनै हे बांट लेथै। <verse eid="ACT 4:32"/><verse number="33" style="v" sid="ACT 4:33"/>अउ ऊ चेला सामुहिक सक्ति के संग परभु यीसु फेरै जी उठै के गवाही दय करथै, अउ उन सब हे बडा अनुगरह रथै। <verse eid="ACT 4:33"/><verse number="34" style="v" sid="ACT 4:34"/>ऊ समूह मसे कउनो के कउनो मेर के बात लग कमी नेहको रथै, काखे जेखर लिघ्घो खेत, या घर होथै, उनही बेच के जउन पइसा मिलथै ओही लानथै, <verse eid="ACT 4:34"/><verse number="35" style="v" sid="ACT 4:35"/>अउ चेलन के गोड तरी धर देथै अउ जिनही जउन मेर जरुरत होथै अउ मनसेन के जरुरत के जसना उनही दय रथै।<verse eid="ACT 4:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 4:36"/>अउ यूसुफ नाम के साइप्रस सहर हे पइदा हुइस अउ अक्ठी लेवी रथै, जेही चेला बरनबास कहिके पुकारथै, “मतलब सान्ति कर टोरवा” <verse eid="ACT 4:36"/><verse number="37" style="v" sid="ACT 4:37"/>ऊ अक्ठी खेत बेच दइस जेखर ऊ मलिक रथै, अउ ऊ पइसा के लानके चेलन के गोड तरी धर देथै।<verse eid="ACT 4:37"/></para>
  <chapter eid="ACT 4"/>
  <chapter number="5" style="c" sid="ACT 5"/>
  <para style="s">हनन्याह अउ सफीरा</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 5:1"/>हनन्याह नाम के अक्ठी मनसे अउ ओखर डउकी सफीरा मिलके अपन कुछ डेरा मसे अक्ठी खेत बेचथै। <verse eid="ACT 5:1"/><verse number="2" style="v" sid="ACT 5:2"/>अपन डउकी के जानकारी हे कुछ पइसा अपन लिघ्घो बचाय के रख लेथै अउ कुछ पइसा चेलन के दइ देथै। <verse eid="ACT 5:2"/><verse number="3" style="v" sid="ACT 5:3"/>पतरस उनखर लग कथै, “हे हनन्याह भुतवा तोर मन हे हइ बात काखे डाले हबै, कि तै पवितर आतमा लग झूठ बोले हबस अउ खेत के बेचे हर कुछ पइसा बचाय के रख लय? <verse eid="ACT 5:3"/><verse number="4" style="v" sid="ACT 5:4"/>जब तक तै बेचे नेहको रथस ऊ तोर नेहको रहिस, जब तै उके बेचे ता ओखर लग पइसा मिलिस उहो तोर हक हे रहिस, फेर तै अपन मन हे झूठ बोलय के काखे सोचे? तै मनसे लग झूठ नेहको बोले हबस, पय भगवान लग झूठ बोले हबस।” <verse eid="ACT 5:4"/><verse number="5" style="v" sid="ACT 5:5"/>हनन्याह हइ बात सुन के गिर जथै अउ ओखर परान निकड गइस, जउन कउ हइ बात के सुनिन उनखर हे डर अमा गइस। <verse eid="ACT 5:5"/><verse number="6" style="v" sid="ACT 5:6"/>कुछ जबान उके चरका कफन हे लपेटथै अउ बाहिर छो लइ जाय के गाड देथै।<verse eid="ACT 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 5:7"/>लगभग तीन घंटा के बाद ओखर डउकी भित्तर आथै, हइ घटना के बारे हे कुछु नेहको जानथै। <verse eid="ACT 5:7"/><verse number="8" style="v" sid="ACT 5:8"/>पतरस ओखर लग कथै, मोके बता तै अउ तोर डउका ऊ खेत एतकै हे बेचे रथै, ओखर डउकी कथै, हव एतकै हे बेचे रहन।<verse eid="ACT 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 5:9"/>पतरस ओखर लग कथै, “दोनो झन परभु के आतमा के परिक्छा लेय के निता सहमत हबा, देख तोर डउका के गाडै बाले दूरा हे ठाड हबै अउ उन तहु के उठाय के लइ जही।” <verse eid="ACT 5:9"/><verse number="10" style="v" sid="ACT 5:10"/>ऊ उहै टेम पतरस के गोड तरी गिरथै अउ मर जथै, जबान भित्तर आयके उके मरे हर पाथै अउ ऊ बाहिर लइ जाय के ओखर डउका के लिघ्घो गाड देथै। <verse eid="ACT 5:10"/><verse number="11" style="v" sid="ACT 5:11"/>एखर लग सगलू मंडली हे अउ जेतका मनसे हइ बातन के चरचा सुनथै उनखर हे बोहत डर समाय जथै।<verse eid="ACT 5:11"/></para>
  <para style="s">निसानी अउ अदभुत काम</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 5:12"/>चेलन के दवारा मनसेन के बीच बोहत लग चिन्हा अउ चकित के काम होथै, उन सब बिस्वास करै बाले सुलेमान के अंगना हे अक जिघा जुडथै। <verse eid="ACT 5:12"/><verse number="13" style="v" sid="ACT 5:13"/>ऊ समूह हे सामिल होमै के हिम्मत नेहको कर पाथै, पय मनसे उनखर बडाई करथै। <verse eid="ACT 5:13"/><verse number="14" style="v" sid="ACT 5:14"/>पय परभु हे बिस्वास करै बाले डउका अउ डउकी बोहत बढत जथै। <verse eid="ACT 5:14"/><verse number="15" style="v" sid="ACT 5:15"/>सही हइ हबै कि मनसे अपन नंगहन के लइके खटिया हे गलिन हे सोबाथै, ताकि जब पतरस उछो लग निकडही ता उनखर मसे कुछ हे ओखर छाय पड जाय। <verse eid="ACT 5:15"/><verse number="16" style="v" sid="ACT 5:16"/>यरुसलेम सहर के अगल-बगल के सहरन लग बोहत मनसे अक जिघा हुइ जात रहिन, उन अपन संग नंगहन अउ असुध्द आतमा के सताय हर मनसेन के लानथै अउ सगलू मनसे निक्खा हुइ जथै।<verse eid="ACT 5:16"/></para>
  <para style="s">चेलन कर सताव</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 5:17"/>हइ सब देख के पुजारी अउ ओखर सगलू संगी, जउन सदूकियन के समूह बोहत जादा जलन लग भर जथै। <verse eid="ACT 5:17"/><verse number="18" style="v" sid="ACT 5:18"/>उन चेलन के पकरके जेल हे बेड देथै। <verse eid="ACT 5:18"/><verse number="19" style="v" sid="ACT 5:19"/>पय ऊ रात के टेम हे परभु के अक्ठी स्वरगदूत जेल के दूरा उघार देथै, उनही बाहिर निकार के कथै, <verse eid="ACT 5:19"/><verse number="20" style="v" sid="ACT 5:20"/>जा बिनती भवन हे ठाड हुइके हइ नबा जीवन के सब बात मनसेन के सुनाबा। <verse eid="ACT 5:20"/><verse number="21" style="v" sid="ACT 5:21"/>उन हइ सुनके बडा सकरहा बिनती भवन हे जाय के सिक्छा देय लगिन,</para>
  <para style="p" vid="ACT 5:21">तब पुजारी अउ उनखर संगी उछो पहुंचिन, ता उन यहूदी अगुवा अउ इस्राएल सियानन सगलू पंचायत बुलवाथै अउ चेलन के लामै के निता सिपाहिन के जेल पठोथै। <verse eid="ACT 5:21"/><verse number="22" style="v" sid="ACT 5:22"/>पय जब सिपाही जेल हे पहुंचथै, ता चेलन के जेल हे नेहको पाथै, ता उन लउटके एखर संदेस देथै। <verse eid="ACT 5:22"/><verse number="23" style="v" sid="ACT 5:23"/>जब हम जेल हे पहुंचेन ता हम पायन कि जेल के सुरक्छा के तारा लगे हर रथै अउ दूरा हे पहरेदारन के ठाडे पायन पय दूरा खोलन ता भित्तर हमके कउनो नेहको मिलिन। <verse eid="ACT 5:23"/><verse number="24" style="v" sid="ACT 5:24"/>बिनती भवन के मुखिया के साहबन अउ परधान याजक हइ बात सुनिन, ता इन चकित हुइन कि उन चेलन के काहिन होय होही। <verse eid="ACT 5:24"/><verse number="25" style="v" sid="ACT 5:25"/>एतकै हे कउनो आयके उनही संदेस गुठेथै, “देखा जउन मनसेन के जेल हे बेड दय रहा, उन बिनती भवन हे ठाड हुइ के मनसेन के सिक्छा देथै।” <verse eid="ACT 5:25"/><verse number="26" style="v" sid="ACT 5:26"/>बिनती भवन के सुरक्छा करमी के मुखिया अपन सिपाहिन के संग उछो गइन, बिना बल ताकत के नेहको लानथै, काखे उनही डर रथै कि मनसे कहुं पथरा झइ मारै।<verse eid="ACT 5:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 5:27"/>उन चेलन के यहूदी महासभा के आगू ठाड करथै, फेर महायाजक उनखर लग पूछथै। <verse eid="ACT 5:27"/><verse number="28" style="v" sid="ACT 5:28"/>“का हम तुमही कडाइ लग चेताय नेहको रहन, कि हइ नाम लग सिक्छा झइ दइहा, पय तुम सगलू यरुसलेम अपन सिक्छा लग भर दय हबा अउ हइ मनसे के खून के अरोप हमर उप्पर लादत हबा।”<verse eid="ACT 5:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 5:29"/>हइ बात हे पतरस अउ दूसर चेला हइ जबाब देथै, “हमही मनसेन के आदेस लग जादा भगवान कर आदेस के मानैके चाही। <verse eid="ACT 5:29"/><verse number="30" style="v" sid="ACT 5:30"/>जेही तुम क्रूस हे खीला ठोकवाय के मार डारे रथा, पय हमर सियानन के भगवान यीसु के फेरै जिन्दा कर दय हबै। <verse eid="ACT 5:30"/><verse number="31" style="v" sid="ACT 5:31"/>भगवान उके मुख्य अउ मुकतिदाता के सबले ऊंच पद दइके अपन दहिना हाथ छो बइठाय हबै, कि ऊ इस्राएल के मन बदलै अउ पाप छमा करही। <verse eid="ACT 5:31"/><verse number="32" style="v" sid="ACT 5:32"/>इन बात के हम गवाह हबन अउ पवितर आतमा, जेही भगवान उन मनसेन के दय हबै, जउन ओखर आदेस के मानथै।”<verse eid="ACT 5:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 5:33"/>जब महासभा कर सदस्य हइ सुनथै ता उन बोहत गुस्सा हुइ जथै अउ उन चाहथै कि चेलन के मार डारी। <verse eid="ACT 5:33"/><verse number="34" style="v" sid="ACT 5:34"/>पय उनखर मसे अक्ठी फरीसी जेखर नाम गमलीएल रथै, जउन भला बुरा के गुरू रथै अउ सगलू मनसेन हे आदर के संग पंचायत हे ठाड होथै अउ आदेस देथै कि चेलन के चुटु टेम के निता बाहिर जाय के आदेस दइस। <verse eid="ACT 5:34"/><verse number="35" style="v" sid="ACT 5:35"/>तब पंचायत कर मनसेन लग हइ कथै, हे इस्राएली के मनसे तुम इनखर संग काहिन करै चाहथा, ओही सोच समझ के करिहा। <verse eid="ACT 5:35"/><verse number="36" style="v" sid="ACT 5:36"/>का तुमही सुरता हबै कुछ रोज पहिले अपन खुद बडा कहै बाले अक्ठी थियूदास परगट होय रहिस, लगभग चार सव मनसे ओखर पाछू चलथै, पय मारे गइस अउ ओखर बिस्वासी तितर-बितर हुइ गइन मतलब कुछु नेहको निकडिस। <verse eid="ACT 5:36"/><verse number="37" style="v" sid="ACT 5:37"/>एखर बाद नाम लिखामै कर रोज हे, गलीली सहर के रहै बाले यहूदा रथै, उहो कुछ मनसेन के अपन पाछू कर लेथै, उहो मारे गइस अउ ओखरो बिस्वासी इछो-उछो हुइ गइन। <verse eid="ACT 5:37"/><verse number="38" style="v" sid="ACT 5:38"/>इहैनिता हइ मामला के बारे हे मै तुम्हर लग कथो, इन मनसेन लग दुरिहां रइहा उनखर बारे हे कउ बिरोध झइ करा, उनही अकेल्ले छांड देया, पय इनखर हइ काम मनसेन के पल्ला लग होही, ता अपनै खुद खतम हुइ जही। <verse eid="ACT 5:38"/><verse number="39" style="v" sid="ACT 5:39"/>पय अगर हइ भगवान के तरफ लग होही, ता तुम इनही नेहको मिटा पइहा अउ हइ बोहत सम्भव हबै,</para>
  <para style="p" vid="ACT 5:39">कि तुम भगवान कर बिरोधी परमाडित हुइहा, पंचायत गमलीएल के बात मान लेथै। <verse eid="ACT 5:39"/><verse number="40" style="v" sid="ACT 5:40"/>उन चेलन के बुलाय के उनही कोडा लगवाथै अउ उनही आदेस देथै, कि यीसु के नाम के चरचा झइ करै अउ उनही छांड देथै। <verse eid="ACT 5:40"/><verse number="41" style="v" sid="ACT 5:41"/>काखे चेला असना समझथै कि यीसु नाम कर निता कम से कम मार सहै के काबिल ठहरन। <verse eid="ACT 5:41"/><verse number="42" style="v" sid="ACT 5:42"/>फेर बिनती भवन अउ घर-घर हे सब रोज लगेतार ऊ सिक्छा देथै अउ यीसु मसीह कर सुभ संदेस सुनाउत रहै।<verse eid="ACT 5:42"/></para>
  <chapter eid="ACT 5"/>
  <chapter number="6" style="c" sid="ACT 6"/>
  <para style="s">सातठे सेबकन के चुनथै</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 6:1"/>कुछ रोज बाद चेलन के गिनती बढथै ता यूनानी भासा बोलै बाले बिस्वासी अउ इब्रानी बोलै बाले यहूदी बिस्वासी हे अक्ठी झगडा हुइ जथै, काखे यूनानी बोलै बाले यहूदी बिस्वासी हइ दाबा करथै, उनखर सेबा हे बिधवन डउकिन कर रोज दिना के खाय पीय बाले चीजन हे अनदेखा करथै। <verse eid="ACT 6:1"/><verse number="2" style="v" sid="ACT 6:2"/>बारहठे चेला, चेलन के सगलू मंडली के अक जिघा बुलाय के कथै, हमर निता भगवान के बचन के सेबा के छांडके खाय पीय अउ पइसन के जुगाड करै के जरूरी नेहको आय। <verse eid="ACT 6:2"/><verse number="3" style="v" sid="ACT 6:3"/>इहैनिता भाई बेहन तुम अपन बीच लग सातठे डउकन के अपनै मसे चुन लेया, जउन पवितर आतमा अउ दिमाक ग्यान लग भरपूर होय, कि हम उनही हइ काम के निता जबाबदारी दइ। <verse eid="ACT 6:3"/><verse number="4" style="v" sid="ACT 6:4"/>पय हमर धियान बिनती हे अउ बचन के सेबा हे लगे रहिबे।<verse eid="ACT 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 6:5"/>हइ सलाह लग सगलू मंडली बोहत मगन हुइन, उन स्तिफनुस नाम के मनसे के अउ जउन बिस्वास अउ पवितर आतमा लग भरे रथै अउ फिलिप्पुस, प्रुखुरूस, नीकानोर, तीमोन, परमिनास, अन्ताकियावासी, नीकुलाउस के, जउन यहूदी धरमी काम करै बाले के अपनाय लेथै, उके चुन लेथै। <verse eid="ACT 6:5"/><verse number="6" style="v" sid="ACT 6:6"/>उनही चेलन के आगू ठाड करथै अउ उन बिनती करके उनखर हे अपन हाथ धरिन।<verse eid="ACT 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 6:7"/>अउ हइ मेर भगवान के बचन लगेतार फइले लगिस अउ यरुसलेम हे चेलन के गिनती बोहत बढ गइस, पुजारी के अक्ठी बडका समूहो हइ बिस्वास हे बढै लगिन।<verse eid="ACT 6:7"/></para>
  <para style="s">स्तिफनुस के पकरथै</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 6:8"/>स्तिफनुस अक्ठी असना मनसे रथै, अनुगरह अउ सक्ति लग भरपूर रथै, ऊ मनसेन के बीच बडा-बडा चकित के काम अउ चकित के चिन्हा परगट करे करथै। <verse eid="ACT 6:8"/><verse number="9" style="v" sid="ACT 6:9"/>पय आजाद करे हर यहूदी मनसे के मंडली कुछ मनसे जउन लिबिरतीनो कहाथै, कुरेनी अउ सिकन्दरिया अउ किलिकिया आसिया इलाका लग आय हर यहूदी रथै, उन स्तिफनुस के बिरोध हे बाद बिबाद करै लगिन। <verse eid="ACT 6:9"/><verse number="10" style="v" sid="ACT 6:10"/>पय ऊ आतमा जेखर लग बात करत रथै अउ ओखर दिमाक के आगू नेहको टिक पाथै। <verse eid="ACT 6:10"/><verse number="11" style="v" sid="ACT 6:11"/>फेर उन कुछ मनसेन के लालच दइके बुलवाइन, “हम मूसा अउ भगवान के बिरोध हे निन्दा के बात कहत सुने हबन।” <verse eid="ACT 6:11"/><verse number="12" style="v" sid="ACT 6:12"/>हइ मेर उन मनसेन के सियान नेतन के अउ यहूदी धरमी गुरुन के उकसाइन, फेर उन आयके उके पकर लइन अउ यहूदी पंचायत के आगू लानथै। <verse eid="ACT 6:12"/><verse number="13" style="v" sid="ACT 6:13"/>उन ऊ ठगरा गवाहन के लानिन जउन कथै, “हइ मनसे हइ पवितर जिघा अउ नियम के बिरोध हे बोलथै। <verse eid="ACT 6:13"/><verse number="14" style="v" sid="ACT 6:14"/>हम इके कहत सुने हबन यीसु नासरी हइ बिनती भवन के नास कर देही अउ हमर परम्परा के बदल दइ जेही हमके मूसा दय हबै।” <verse eid="ACT 6:14"/><verse number="15" style="v" sid="ACT 6:15"/>ता सगलू मनसे जउन पंचायत हे बइठे रथै, उके धियान लग देखथै, ता ओखर चेहरा स्वरगदूत के जसना दिखथै।<verse eid="ACT 6:15"/></para>
  <chapter eid="ACT 6"/>
  <chapter number="7" style="c" sid="ACT 7"/>
  <para style="s">स्तिफनुस कर बात</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 7:1"/>ता पुजारी कथै, “का हइ बात सही हबै?” <verse eid="ACT 7:1"/><verse number="2" style="v" sid="ACT 7:2"/>स्तिफनुस कथै, “हे भाइयो अउ सियानन मोर बात सुना, हरान हे बसै लग आगू जब हमर दादा अब्राहम मेसोपोटामिया हे रथै, ता महिमामय भगवान उके दरसन देथै।” <verse eid="ACT 7:2"/><verse number="3" style="v" sid="ACT 7:3"/>अउ कथै, तै अपन देस अउ अपन घरबार के छांड के ऊ देस छो जा जेही मै तोके दिखाहुं। <verse eid="ACT 7:3"/><verse number="4" style="v" sid="ACT 7:4"/>तब ऊ कसदियो के देस के छांड के हरान हे जाय के बसथै, जछो लग ओखर बाफ के मरै के बाद भगवान उके हइ सहर हे आमै के सिक्छा दइस जछो तुम रहत हबा। <verse eid="ACT 7:4"/><verse number="5" style="v" sid="ACT 7:5"/>पय भगवान ऊ बारिसदार हे कुछु नेहको दइस, इहां तक गोड धरै तक के जिघा नेहको दइस, पय ओखर कउनो लरका नेहको रथै, तउभरमा भगवान ओखर लग टीमा करथै कि हइ देस ऊ उके अउ ओखर बारिसदार के ओखर डेरा के जसना मेर दइहों। <verse eid="ACT 7:5"/><verse number="6" style="v" sid="ACT 7:6"/>भगवान हइ कथै, “तोर बारिसदार अनजान देस हे अनचिन्हार हुइ के रइहे अउ चार साल तक उनही गुलाम बनाय के उनखर संग बेकार बरताव करे जही।” <verse eid="ACT 7:6"/><verse number="7" style="v" sid="ACT 7:7"/>फेर भगवान कथै, हरवाह बनामै बाले ऊ जात के मै सजा दइहों अउ ऊ एखर बाद उन ऊ देस लग बाहिर आय जही अउ हइ जिघा हे उन मोर सेबा करही। <verse eid="ACT 7:7"/><verse number="8" style="v" sid="ACT 7:8"/>भगवान अब्राहम के सुध्दिकरन खतना के रिबाज लग निसानी लगा के टीमा देथै, अउ हइ मेर ऊ इसहाक कर बाफ बनिस, ओखर पइदा होय कर बाद आठै रोज ओखर सुध्दिकरन करथै, फेर इसहाक लग याकूब अउ याकूब लग बारहठे कुर लग डउका पइदा होथै।<verse eid="ACT 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 7:9"/>याकूब कर टोरवा अपन भाई यूसुफ लग इसाय करथै, उन उके मिस्र हे हरवाह बनाय के निता बेच देथै, पय भगवान ओखर संग रथै। <verse eid="ACT 7:9"/><verse number="10" style="v" sid="ACT 7:10"/>अउ ऊ उके सगलू दुख लग छंडाइस। भगवान यूसुफ के दिमाक दइस अउ ऊ उके हइ काबिल बनाइस जेही ऊ मिस्र के राजा फिरोन के अनुगरह के काबिल बन सकै, फिरोन ऊ मिस्र के राजपाल अउ अपन घरबार के साहब बनाथै। <verse eid="ACT 7:10"/><verse number="11" style="v" sid="ACT 7:11"/>फेर सगलू मिस्र अउ कनान देस हे भुखमरी पडथै, बडा दुख छाय गइस, हमर सियानन के खाय के निता कुछु नेहको रथै। <verse eid="ACT 7:11"/><verse number="12" style="v" sid="ACT 7:12"/>जब याकूब सुनथै कि मिस्र देस हे दाना हबै, ता ऊ अपन टोरवा हमर सियानन के मिस्र हे पठो, ऊ उनही मिस्र हे पहली बेर भेंट होथै। <verse eid="ACT 7:12"/><verse number="13" style="v" sid="ACT 7:13"/>दूसर बेर यूसुफ यातरा के टेम अपन भाई हे परगट करथै, तब फिरोन मिस्र राज के यूसुफ के परवार के बारे हे पता चलथै। <verse eid="ACT 7:13"/><verse number="14" style="v" sid="ACT 7:14"/>तब यूसुफ अपन बाफ याकूब अउ अपन घरबार के सगलू मनसे के बुलवामै के पठोथै, जउन पछत्तर झन रथै। <verse eid="ACT 7:14"/><verse number="15" style="v" sid="ACT 7:15"/>ता याकूब मिस्र देस हे आथै अउ ऊ उछो ओसनेन परान निकरथै जसना हमर सियानन के परान निकरे रथै। <verse eid="ACT 7:15"/><verse number="16" style="v" sid="ACT 7:16"/>उनखर लोथ उछो लग वापिस सकेम लइ जथै, उछो मरघटी हे धरथै अउ उहै मरघटी रथै जेही अब्राहम हमोर कर टोरवा के कुछ पइसा दइ के खरीदे रथै।<verse eid="ACT 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 7:17"/>जब भगवान अब्राहम के जउन बचन दय रथै, ऊ टीमा के पूर होय के टेम लिघ्घो आइस, ता मिस्र हे हमर मनसेन के गिनती बोहत जादा बड गइस। <verse eid="ACT 7:17"/><verse number="18" style="v" sid="ACT 7:18"/>आखरी हे मिस्र देस हे अक्ठी असना राजा के राज हुइस जउन यूसुफ के बारे हे कुछु नेहको जानथै। <verse eid="ACT 7:18"/><verse number="19" style="v" sid="ACT 7:19"/>ऊ हमर मनसेन के संग गुस्सामेर बेउहार करथै, ऊ सियानन के बडा आदेस के संग मजबूर करिन, कि उन अपन लरकन के बाहिर मरै के निता छांडिन, ताकि ऊ जिन्दा झइ रह पाबै। <verse eid="ACT 7:19"/><verse number="20" style="v" sid="ACT 7:20"/>ऊ टेम मूसा पइदा होथै, ऊ भगवान के नजर हे बोहत सुन्दर लरका रथै, ऊ तीन माह तक अपन बाफ के घर हे पाले पोसे गइस। <verse eid="ACT 7:20"/><verse number="21" style="v" sid="ACT 7:21"/>जब उके घर के बाहिर छांड दइन, ता फिरोन के टोरिया उके अपन टोरवा बनाय के उठाय लइ जथै अउ अपन टोरवा के मेर पालथै पोसथै। <verse eid="ACT 7:21"/><verse number="22" style="v" sid="ACT 7:22"/>मूसा कर मिस्रिन के सगलू पढाइ लिखाइ के सिक्छा दइस, ऊ बात करै हे अउ काम करै हे बोहत बलवान रथै।<verse eid="ACT 7:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 7:23"/>जब मूसा चालीस साल के होथै, ता ओखर मन हे आथै कि मै अपन इस्राएली भाई के लिघ्घो जाय के ठानिस। <verse eid="ACT 7:23"/><verse number="24" style="v" sid="ACT 7:24"/>जब अक बार ऊ देखथै कि ओखर मसे अक्ठी के संग गलत बेउहार करे गइस, ता ऊ उके बचाइस अउ मिस्री के मनसे के मार के ऊ मनसेन के बदला लइ लइस। <verse eid="ACT 7:24"/><verse number="25" style="v" sid="ACT 7:25"/>ऊ सोंचथै कि अपन भाई जान जही कि उनही छंडामै के निता भगवान ओखर हाथ लग उनखर मुकति करही, पय ऊ उके नेहको समझ पाइस। <verse eid="ACT 7:25"/><verse number="26" style="v" sid="ACT 7:26"/>बिहाने रोज जब उन अपन हे लडथै, ता ऊ उनखर लिघ्घो पहुंचथै अउ हइ कहत उनखर हे बीच बचाव करके मेलजोल करवाथै, हे भाई दोनो इस्राएली भाई हबा तुम अपन हे काखे झगडथा, काखे अक दूसर के नुसकान पहुंचामै चाहथा। <verse eid="ACT 7:26"/><verse number="27" style="v" sid="ACT 7:27"/>ऊ मनसे अपन परोसी लग झगडत रहिस, मूसा कर मारत कथै, हमर राजा के नियाव करे के निता कोहर मुखिया बनाय हबै। <verse eid="ACT 7:27"/><verse number="28" style="v" sid="ACT 7:28"/>जसना तुम कल ऊ मिस्री के मार डारे हबस, का ओसनेन तै मोके मार डालै के चाहथस। <verse eid="ACT 7:28"/><verse number="29" style="v" sid="ACT 7:29"/>मूसा हइ सुनथै ता उछो लग भाग जथै अउ मिद्दान देस हे अक्ठी अनचिन्हार के जसना रहै लग जथै, उछो ओखर दुइठे टोरवा पइदा होथै।<verse eid="ACT 7:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 7:30"/>जब पूर चालीस साल हुइ चुकथै, ता सीनै डोंगर के लिघ्घो अक्ठी जलत पुडरा हे धन्धकत के बीच हे ओखर आगू स्वरगदूत परगट हुइस। <verse eid="ACT 7:30"/><verse number="31" style="v" sid="ACT 7:31"/>मूसा हइ देखथै ता देखय के निता पुडरा के लिघ्घो गइस ता उके परभु के आरो सुनाई देथै। <verse eid="ACT 7:31"/><verse number="32" style="v" sid="ACT 7:32"/>मै तोर सियानन के भगवान हबो, अब्राहम के इसहाक के अउ याकूब के भगवान हबो, डर लग थरथराउत मूसा कुछु देखय के हिम्मत नेहको कर सकिस। <verse eid="ACT 7:32"/><verse number="33" style="v" sid="ACT 7:33"/>ता परभु ओखर लग कथै, अपन गोड लग बूट उतार काखे जउन जिघा हे ठाडे हबस, ऊ पवितर भुंइ हबै। <verse eid="ACT 7:33"/><verse number="34" style="v" sid="ACT 7:34"/>मै मिस्र हे अपन मनसेन के संग होत हबै अतियाचार के देखे हबो अउ उनखर पीरा अउ रोमै के आरो सुने हबो, इहैनिता उनही छंडामै के निता तरी छो उतरे हबो, आ अब तोके मै मिस्र देस छो पठोहूं।<verse eid="ACT 7:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 7:35"/>जउन मूसा कर उन हइ कहिके नकारे रथै, तोके कउन हमर हे साहब अउ नियाव बाले ठहराय हबै, उहै के भगवान ऊ स्वरगदूत के दवारा जउन ओखर निता पुडरा हे परगट होथै, राजा अउ मुकतिदाता के सकल हे पठोइस। <verse eid="ACT 7:35"/><verse number="36" style="v" sid="ACT 7:36"/>ऊ उनही मिस्र देस के भुंइ अउ ललका समुन्दर अउ पटउरा मसे चालीस साल तक चकित के काम करत अउ चिन्हा देखाउत ऊ बाहिर निकाड लाइस। <verse eid="ACT 7:36"/><verse number="37" style="v" sid="ACT 7:37"/>हइ उहै मूसा हबै, जउन इस्राएल के लरकन लग कहे रथै, तुम्हर भाइन मसे तुम्हर निता भगवान अक्ठी मेर जसना ग्यानी मनसे के पठोही। <verse eid="ACT 7:37"/><verse number="38" style="v" sid="ACT 7:38"/>हइ उहै हबै, जउन निरजन परदेस के मंडली हे ऊ स्वरगदूत के संग रथै, जउन सीनै डोंगर हे ओखर लग बात करिस, ऊ हमर सियानन के संगो रथै, भगवान लग जिन्दा बचन मिलथै, जेही हमर लिघ्घो तक पहुंचिस।<verse eid="ACT 7:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 7:39"/>पय हमर सियान मानै के निता मना कर देथै अउ अपन मन हे मिस्र के पल्ला लउट गइन। <verse eid="ACT 7:39"/><verse number="40" style="v" sid="ACT 7:40"/>उन हारुन लग कथै, हमर निता असना देउता के बनामै कि ऊ हमके रास्ता देखामै, काखे हम नेहको जानथन कि ऊ मूसा के काहिन हुइस, जउन हमके मिस्र देस लग निकाड लाइस? <verse eid="ACT 7:40"/><verse number="41" style="v" sid="ACT 7:41"/>उहै रोज उन अक्ठी बछवा के मूरती बनाइन अउ ओखर आगू बलि चढाथै अउ अपन हाथन के बनाय हर मूरती के निता मगन हुइन। <verse eid="ACT 7:41"/><verse number="42" style="v" sid="ACT 7:42"/>जब भगवान उनखर लग दुरिहां हुइ गइस अउ ऊ उनही बादर के तरइयन के उपास करै के निता छांड देथै, जसना कि ग्यानी मनसे के किताब हे लिखवरे हबै,</para>
  <para style="q1" vid="ACT 7:42">हे इस्राएल के मनसे का तुम पतेरा हे,</para>
  <para style="q2" vid="ACT 7:42">चालीस साल तक गोरू के बलि,</para>
  <para style="q2" vid="ACT 7:42">अउ दाना के बलि मोहिन के चढाउत रहा।<verse eid="ACT 7:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="ACT 7:43"/>तुम मोलेक के तम्बू के अउ अपन भगवान रिफान के तरइया के,</para>
  <para style="q2" vid="ACT 7:43">मतलब उन पुतलन के जेही तुम भजन करै के निता बनाय रथा,</para>
  <para style="q2" vid="ACT 7:43">इहैनिता मै मनसेन के बेबीलोन के ऊ पल्ला बसाहुं।<verse eid="ACT 7:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 7:44"/>गवाह के तम्बू ऊ वीराने हे हमर सियान के संग रथै, हइ तम्बू उहै निसानी हे बनाय गय हबै, जसना कि पुतलन के देखे रथै उहै के जसना उके बना। <verse eid="ACT 7:44"/><verse number="45" style="v" sid="ACT 7:45"/>हमर सियानन उके पाय के तबय उछो लग आथै, जब यहोसू के अगुवाई हे उन जातन हे हक पाइन, जेखर लग हमर सियान कर आगू भगवान निकाड के बाहिर करथै अउ दाऊद के टेम तक उहै रथै। <verse eid="ACT 7:45"/><verse number="46" style="v" sid="ACT 7:46"/>ओखर हे भगवान अनुगरह करिस, ऊ बिनती करथै कि याकूब के भगवान कर निता ऊ अक जिघा मन्दिर बनाबै। <verse eid="ACT 7:46"/><verse number="47" style="v" sid="ACT 7:47"/>पय सुलेमान भगवान कर निता मन्दिर बनवाथै।<verse eid="ACT 7:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 7:48"/>पय परम परधान हाथ के बनाय हर घरन हे नेहको रथै, जसना कि ग्यानी मनसे कथै।<verse eid="ACT 7:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="ACT 7:49"/>परभु कथै, स्वरग मोर राजगद्दी हबै,</para>
  <para style="q2" vid="ACT 7:49">अउ भुंइ मोर गोड के पिढवा हबै,</para>
  <para style="q1" vid="ACT 7:49">कउन मेर के तुम घर बनइहा?</para>
  <para style="q2" vid="ACT 7:49">अउ मोर सुत्ताय के जिघा कछो होही?<verse eid="ACT 7:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="ACT 7:50"/>का हइ सगलू मोर हाथ के बनाय हर नेहको हबै?<verse eid="ACT 7:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="ACT 7:51"/>स्तिफनुस आगू बोलतेन रहिस केतका तुम ढीठ हबा, मन अउ कान लग बिना सुध्दिकरन के हबा तुम अपन सियानन के जसना हबा, तुम सबदिना पवितर आतमा के बिरोध करे हबा। <verse eid="ACT 7:51"/><verse number="52" style="v" sid="ACT 7:52"/>उन तो ग्यानी मनसेन के मार डारिन जउन बोहत पहिलेन लग भगवान के धरमी मनसे के आदेस कर दइस, जेही तुम धोखा दइके पकरवाय के मारो डारा। <verse eid="ACT 7:52"/><verse number="53" style="v" sid="ACT 7:53"/>तुम उहै हबा जेही स्वरगदूतन के दवारा दय गइस भगवान के नियम बिधान के पाय तो गइन, पय ओखर हे नेहको चलिन।<verse eid="ACT 7:53"/></para>
  <para style="s">स्तिफनुस के पथरा मारथै</para>
  <para style="p">
    <verse number="54" style="v" sid="ACT 7:54"/>ओसनेन पंचायत के सदस्य स्तिफनुस के सुनके, बोहत गुस्साय उठथै अउ ओखर हे दांत जबामै लगिन। <verse eid="ACT 7:54"/><verse number="55" style="v" sid="ACT 7:55"/>पय स्तिफनुस पवितर आतमा लग भर के स्वरग छो निहारथै अउ भगवान कर महिमा के अउ भगवान कर दहिना पल्ला ठाडे यीसु के देखथै, <verse eid="ACT 7:55"/><verse number="56" style="v" sid="ACT 7:56"/>ऊ कथै देखा मै देखथो कि स्वरग उघरे हर हबै अउ मनसे कर टोरवा भगवान के दहिना पल्ला ठाड हबै।<verse eid="ACT 7:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="ACT 7:57"/>एतका हे उन बोहत चिरलाय के अपन कान मूंद लेथै अउ सब मिलके स्तिफनुस हे झपटथै। <verse eid="ACT 7:57"/><verse number="58" style="v" sid="ACT 7:58"/>अउ उके घसीटत नगर के बाहिर निकाड के उके पथरा मारै लग जथै, गवाह अपन बन्डी साऊल नाम के अक्ठी जबान के गोड कर लिघ्घो उतार के धर देथै। <verse eid="ACT 7:58"/><verse number="59" style="v" sid="ACT 7:59"/>जब मनसे स्तिफनुस हे पथरा मारथै, ता ऊ हइ बिनती करत रथै, “हे परभु यीसु मोर आतमा के स्वीकार कर।” <verse eid="ACT 7:59"/><verse number="60" style="v" sid="ACT 7:60"/>फेर घुटवा के बल गिर जथै, “हे परभु हइ पाप के उनखर हे झइ लगाबे।” एतका कहि के ऊ मर जथै।<verse eid="ACT 7:60"/></para>
  <chapter eid="ACT 7"/>
  <chapter number="8" style="c" sid="ACT 8"/>
  <para style="s">मंडली हे सताव</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 8:1"/>हइ मेर साऊल स्तिफनुस के मारै के सहयोग करथै, उहै रोज लग यरुसलेम के मंडली हे बोहत मारपीट सुरू हुइ जथै अउ चेलन के छांड के सगलू के सगलू बिस्वासी मनसे यहूदिया अउ सामरिया देस हे तितर-बितर हुइ जथै। <verse eid="ACT 8:1"/><verse number="2" style="v" sid="ACT 8:2"/>कुछ सेबक स्तिफनुस के मरघटी हे धरथै अउ ओखर निता रोथै।<verse eid="ACT 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 8:3"/>साऊल ऊ टेम मंडली के परेसान करथै अउ घर-घर हे घुस के डउका अउ डउकिन के किढलाउत जेल हे बेड दय करथै।<verse eid="ACT 8:3"/></para>
  <para style="s">सामरिया हे संदेस कर परचार</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 8:4"/>जउन बिस्वासी तितर-बितर हुइ जथै, उन सब जिघा घूम-घूम के संदेस कर परचार करथै। <verse eid="ACT 8:4"/><verse number="5" style="v" sid="ACT 8:5"/>फिलिप्पुस सामरिया सहर छो अक्ठी सहर हे गइन अउ उहां के मनसेन के मसीह के परचार करै लग जथै। <verse eid="ACT 8:5"/><verse number="6" style="v" sid="ACT 8:6"/>जब मनसे खुद फिलिप्पुस के बात सुनथै अउ ओखर दवारा करे गय, चकित चिन्हा के परगट करे करथै अउ जउन बातन के ऊ गुठेथै, ओहमा धियान देय लगथै। <verse eid="ACT 8:6"/><verse number="7" style="v" sid="ACT 8:7"/>बोहत मनसेन मसे जिनखर हे भुतवा समाय रथै, उन बोहत आरो लग चिरलाउत बाहिर निकडथै अउ बोहत लोकवा बिमारी अउ लेंगरा निक्खा हुइ गइन। <verse eid="ACT 8:7"/><verse number="8" style="v" sid="ACT 8:8"/>ऊ सहर हे बड्डे मगन ही मगन छाय गइस।<verse eid="ACT 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 8:9"/>समोन नाम के अक्ठी मनसे रथै, बोहत टेम लग जादू-टोना कर काम करथै अउ सामरिया के मनसेन के चकित करथै अउ अपन खुद के बड्डे डउका कहामै के दावा करथै। <verse eid="ACT 8:9"/><verse number="10" style="v" sid="ACT 8:10"/>नान लग लइके बड्डे तक सगलू मनसे ओखर बात मानथै अउ कथै, “हइ मनसे हे भगवान कर सक्ति हबै जउन महासक्ति कहाथै।” <verse eid="ACT 8:10"/><verse number="11" style="v" sid="ACT 8:11"/>ऊ बोहत रोज लग उनही अपन जादूगिरी दवारा मनसेन के चकित करके रखथै, इहैनिता उन ओखर बात मानथै। <verse eid="ACT 8:11"/><verse number="12" style="v" sid="ACT 8:12"/>पय जब उन फिलिप्पुस के बातन हे बिस्वास करथै, ऊ उनही भगवान कर राज अउ यीसु मसीह के नाम के संदेस कर परचार करथै, ता उन डउका-डउकी सब बतिस्मा लइन। <verse eid="ACT 8:12"/><verse number="13" style="v" sid="ACT 8:13"/>खुद समोन उनखर हे बिस्वास करथै अउ बतिस्मा लेय के बाद फिलिप्पुस के संग रहै लगथै, हइ चिन्हा अउ महान सक्ति के काम होवत देख के बडा चकित होथै।<verse eid="ACT 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 8:14"/>जब यरुसलेम सहर हे चेला हइ सुनथै कि सामरिया सहर मनसे भगवान कर बचन के स्वीकार करे हबै, ता उन पतरस अउ यूहन्ना के उनखर लिघ्घो पठोथै। <verse eid="ACT 8:14"/><verse number="15" style="v" sid="ACT 8:15"/>जब उन उछो पहुंचिन अउ उनखर निता बिनती करथै, कि पवितर आतमा पामै। <verse eid="ACT 8:15"/><verse number="16" style="v" sid="ACT 8:16"/>काखे अबे तक पवितर आतमा उनखर मसे कउनो हे नेहको उतरे रथै, उन तो केबल परभु यीसु के नाम हे पानी लग बतिस्मा दय रथै। <verse eid="ACT 8:16"/><verse number="17" style="v" sid="ACT 8:17"/>ता पतरस अउ यूहन्ना उनखर हे हाथ धरिन अउ उन पवितर आतमा पाय जथै।<verse eid="ACT 8:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 8:18"/>जब समोन हइ देखथै कि चेलन के हाथ धरै लग पवितर आतमा मिलथै, ता ऊ उनखर लिघ्घो पइसा लायके आथै, <verse eid="ACT 8:18"/><verse number="19" style="v" sid="ACT 8:19"/>“हइ सक्ति मोके दइदे, कि महुं जेखर हे हाथ धरो, ऊ पवितर आतमा पामै।”<verse eid="ACT 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 8:20"/>पतरस कथै, तोर पइसा तोर संग नास होय, कि तै भगवान के दान पइसा हे खरीद के सोचथस। <verse eid="ACT 8:20"/><verse number="21" style="v" sid="ACT 8:21"/>हमर कामन हे तोर काम अउ हीसा नेहको हबै काखे तोर मन भगवान के आगू सिध्धा नेहको हबै। <verse eid="ACT 8:21"/><verse number="22" style="v" sid="ACT 8:22"/>तै हइ बेकार बिचार लग मन बदला अउ परभु लग बिनती कर हुइ सकथै जउन तोर बेउहार हबै, ऊ बिचार के निता तोके छमा कर दय हबै। <verse eid="ACT 8:22"/><verse number="23" style="v" sid="ACT 8:23"/>काखे कि मै देखतो कि तै कडवाहट लग भररे हस अउ पाप के चुंगुल हे फसे हबस।<verse eid="ACT 8:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 8:24"/>समोन पतरस अउ यूहन्ना के जबाब देथै, किरपा करके खुद मोर निता “तुम परभु लग बिनती करा, ताकि जउन कुछु तुम कहे हबा ऊ मोर हे झइ होय।”<verse eid="ACT 8:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 8:25"/>अपन गवाही दइके परभु के संदेस सुन चुके हबा, तब उन यरुसलेम सहर छो लउट जथै, उन हइ यातरा कर दवारा सामरिया के बोहत लग गांवन हे संदेस सुनाथै।<verse eid="ACT 8:25"/></para>
  <para style="s">फिलिप्पुस अउ इफियोपिया के साहब</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 8:26"/>इन रोज हे परभु के अक्ठी स्वरगदूत फिलिप्पुस के कथै, “ठाड हो अउ दख्खिन के पल्ला जा, जउन यरुसलेम सहर लग गाजा छो जथै।” हइ पतेरा गली हबै। <verse eid="ACT 8:26"/><verse number="27" style="v" sid="ACT 8:27"/>ऊ तइयार हुइके कढ जथै, अउ टेम इथियोपिया देस के अक्ठी खोजा अउ कूसियन के रानी कन्दाके के खजाना के साहब रथै, ऊ आराधना के निता यरुसलेम छो गइस। <verse eid="ACT 8:27"/><verse number="28" style="v" sid="ACT 8:28"/>लउटत टेम अपन रथ हे बइठे यसायाह आगू कर बात गुठेमै बाले के किताब पढथै। <verse eid="ACT 8:28"/><verse number="29" style="v" sid="ACT 8:29"/>पवितर आतमा फिलिप्पुस लग कथै, “ऊ रथ के लिघ्घो जा अउ उहै ओखर लिघ्घो रुकबे।” <verse eid="ACT 8:29"/><verse number="30" style="v" sid="ACT 8:30"/>फिलिप्पुस जब ऊ रथ के लिघ्घो गइस, तब ऊ उके यसायाह आगू कर बात गुठेमै बाले के किताब पढत सुनथै अउ पूछथै, का तै जउन पढथस उके समझथस।<verse eid="ACT 8:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 8:31"/>साहब जबाब देथै, “जब तक कउ मोके नेहको समझाही, तब तक मै कइसन के समझ पइहों?” ऊ फिलिप्पुस लग बिनती करथै, कि ऊ रथ हे चढके ओखर संग बइठ जाय। <verse eid="ACT 8:31"/><verse number="32" style="v" sid="ACT 8:32"/>पवितर किताब के जउन पद के पढथै ऊ हइ रथै,</para>
  <para style="q1" vid="ACT 8:32">“ऊ मरै बाले गेडरा के जसना लइजात रहिन,</para>
  <para style="q2" vid="ACT 8:32">अउ गेडरा ऊन काटै बाले के जसना चुप्पेचाप रथै,</para>
  <para style="q2" vid="ACT 8:32">उहै मेर ऊ अपन मुंह नेहको खोलथै।<verse eid="ACT 8:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="ACT 8:33"/>असना दीन दसा हे नियाव लग दुरिहां करिन,</para>
  <para style="q2" vid="ACT 8:33">ओखर पुरखा के कोनहर चरचा करही?</para>
  <para style="q2" vid="ACT 8:33">काखे भुंइ हे ओखर जीवन खतम करे जथै।”<verse eid="ACT 8:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 8:34"/>साहब फिलिप्पुस लग पूछथै, “मै तोर लग बिनती करथो, हइ गुठे कि आगू कर बात गुठेमै बाले हइ केखर बारे हे कथै?” अपन बारे हे या कउनो दूसर के बारे हे? <verse eid="ACT 8:34"/><verse number="35" style="v" sid="ACT 8:35"/>फेर फिलिप्पुस पवितर किताब के हइ भाग लग सुरू करथै अउ हइ किताब ले लइके यीसु कर संदेस के सुनाथै। <verse eid="ACT 8:35"/><verse number="36" style="v" sid="ACT 8:36"/>यातरा करत-करत उन रास्ता हे अक जिघा पानी के लिघ्घो पहुंचथै, ऊ कथै, “इछो पानी हबै, अब मोके बतिस्मा ले हे काहिन देरी हबै।” <verse eid="ACT 8:36"/><verse number="37" style="v" sid="ACT 8:37"/><note caller="+" style="f"><char style="fr" closed="false">8:37 </char><char style="ft" closed="false">हइ बचन पुरानी हस्त लिपी हे नहको पाय जथै </char></note>फिलिप्पुस जबाब देथै, “अगर तै सगलू मन लग बिस्वास करथस, ता कोनो बाधा नेहको हबै।” ऊ कथै, “मै बिस्वास करथो कि यीसु मसीह भगवान कर टोरवा हबै।”<verse eid="ACT 8:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 8:38"/>ऊ रथ ठाड करै के आदेस देथै अउ फिलिप्पुस अउ साहब खोजा दुनोझन पानी हे उतरथै अउ फिलिप्पुस उके पानी लग बतिस्मा देथै। <verse eid="ACT 8:38"/><verse number="39" style="v" sid="ACT 8:39"/>जब उन पानी लग बाहिर आइन, ता परभु के आतमा के अगुवाई लग फिलिप्पुस दूसर रास्ता लग कढ जथै अउ खोजा उके फेर कबहुं नेहको देखथै अउ ऊ मगन करत अपन गली कढ जथै। <verse eid="ACT 8:39"/><verse number="40" style="v" sid="ACT 8:40"/>फिलिप्पुस अपन के अस्दोद सहर हे पाथै, जब तक ऊ कैसरिया हे पहुंचथै तब तक रास्ता हे संदेस सुनाय करथै।<verse eid="ACT 8:40"/></para>
  <chapter eid="ACT 8"/>
  <chapter number="9" style="c" sid="ACT 9"/>
  <para style="s">साऊल कर मन बदलथै</para>
  <para style="r">(<ref loc="ACT 22:6-16">प्रेरितो 22:6-16</ref>; <ref loc="ACT 26:12-18">26:12-18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 9:1"/>साऊल हे अबे परभु के चेलन के डरुहाउत अउ मार डारै के सुर हे रथै अउ महापुजारी के लिघ्घो जथै। <verse eid="ACT 9:1"/><verse number="2" style="v" sid="ACT 9:2"/>अउ दमिस्क के यहूदी मंडली आराधनालय के जिघा के नाम मांग के हक के निता चिट्ठी लिखथै, कि डउका होय या डउकी होय बन्दी बनाय के यरुसलेम छो ले आवा।<verse eid="ACT 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 9:3"/>जब साऊल यातरा करत-करत दमिस्क सहर के लिघ्घो पहुंचथै, ता अकदम बादर ले अक्ठी उजियार ओखर आंखी हे चमकथै। <verse eid="ACT 9:3"/><verse number="4" style="v" sid="ACT 9:4"/>अउ भुंइ हे गिर पडथै अउ हइ सब्द सुनथै, “हे साऊल-हे साऊल तै मोके काखे परेसान करथस।”<verse eid="ACT 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 9:5"/>साऊल कथै, हे परभु तै कोन हबस? ऊ कथै, “मै यीसु हबो, जेही तै परेसान करथस। <verse eid="ACT 9:5"/><verse number="6" style="v" sid="ACT 9:6"/>ठाड हो अउ सहर छो जा उहां तोके गुठे दे जही कि काहिन करै के हबै।”<verse eid="ACT 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 9:7"/>जउन मनसे ओखर संग यातरा करत रहिन, अक्का-बक्का हुइ जथै, उन आरो तो सुनथै पय कउनो के नेहको दिखथै। <verse eid="ACT 9:7"/><verse number="8" style="v" sid="ACT 9:8"/>साऊल भुंइ लग उठथै, पय जब ऊ अपन आंखी उघारथै ता ऊ कुछु नेहको देख पाथै, ता उन ओखर हाथ पकडके दमिस्क हे लइ जथै। <verse eid="ACT 9:8"/><verse number="9" style="v" sid="ACT 9:9"/>ऊ तीन रोज तक न तो देख पाथै अउ न खाय पाथै।<verse eid="ACT 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 9:10"/>दमिस्क हे हनन्याह नाम के अक्ठी बिस्वासी चेला रथै, परभु उके दरसन दइके कथै, “हे हनन्याह।”</para>
  <para style="p" vid="ACT 9:10">परभु मै इछो हबो, तोर सेबा हे हाजिर हबो।<verse eid="ACT 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 9:11"/>परभु ओखर लग कथै, “सिध्धा कहामै बाले गली हे जा अउ यहूदा के घर हे तरसुस निबासी साऊल नाम के अक्ठी मनसे के पता लगा, ऊ हइ टेम बिनती करथै। <verse eid="ACT 9:11"/><verse number="12" style="v" sid="ACT 9:12"/>ऊ अक्ठी दरसन हे देखथै कि हनन्याह नाम के अक्ठी मनसे घर हे आय के ओखर हे हाथ धरथै, ता ऊ फेरै लग देख सकै।”<verse eid="ACT 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 9:13"/>हनन्याह जबाब देथै, “हे परभु मै हइ मनसे के बारे हे बोहत झन लग सुने हबो, कि तोर पवितर मनसेन के संग हइ यरुसलेम सहर हे केतका बार सताय हबै। <verse eid="ACT 9:13"/><verse number="14" style="v" sid="ACT 9:14"/>अउ इछो हइ मुख्य पुजारी लग तोर नाम हे बिस्वास रखै बालेन के बन्दी बनामै के उके हक हबै।”<verse eid="ACT 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 9:15"/>पय परभु ओखर लग कथै, “तै जा काखे हइ मनसे के गैर यहूदी राजन अउ इस्राएल मनसेन के आगू मोर नाम लेमै के निता मै इके चुने हबो। <verse eid="ACT 9:15"/><verse number="16" style="v" sid="ACT 9:16"/>मै खुदय उके गुठेहूं कि ऊ मोर नाम के कारन केतका दुख भोगय के पडही।”<verse eid="ACT 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 9:17"/>तब हनन्याह कढ जथै अउ ऊ घर हे घुसथै ऊ साऊल हे हाथ धर के कथै, “हे भाई साऊल जउन परभु यीसु तोके इछो आउत टेम गली हे दरसन दय रथै, उहै मोके पठोय हबै, ताकि तै फेरै लग देख सकस अउ पवितर आतमा लग भर जा।” <verse eid="ACT 9:17"/><verse number="18" style="v" sid="ACT 9:18"/>फेर जल्दी ओखर आंखी लग छिलपा मेर गिरथै अउ ऊ फेरै देखय लग जथै, ऊ ठाड हुइके पानी लग बतिस्मा लेथै। <verse eid="ACT 9:18"/><verse number="19" style="v" sid="ACT 9:19"/>फेरै लग बल पाथै, दमिस्क चेलन के संग कुछ दिना तक रुके रथै।<verse eid="ACT 9:19"/></para>
  <para style="s">साऊल दमिस्क हे परचार</para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 9:20"/>अउ ऊ यहूदी मंडली हे यीसु के परचार करै लगथै, कि ऊ भगवान कर टोरवा हबै।<verse eid="ACT 9:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 9:21"/>सगलू सुनै बाले चकित हे पड के कथै, “का हइ ऊ मनसे नेहको हबै, जउन यरुसलेम सहर हे यीसु के नाम के महिमा करै बालेन के मारत रहिस? का ऊ इहैनिता तो नेहको आय हबै कि ऊ उनही बांध के महापुजारी के लिघ्घो लइ जाही?” <verse eid="ACT 9:21"/><verse number="22" style="v" sid="ACT 9:22"/>पय साऊल के परचार अउ सक्तिसाली होत गइस, हइ बात के परमाड दइ-दइ के यीसु मसीह इहै हबै, ऊ दमिस्क के रहै बाले यहूदी के मुंह बन्द करत रथै।<verse eid="ACT 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 9:23"/>बोहत रोज गुजर जाय के बाद यहूदी अक संग मिलके उके मार डारय के जुगाड बनाथै। <verse eid="ACT 9:23"/><verse number="24" style="v" sid="ACT 9:24"/>पय साऊल के उनखर मारै के पता पाय जथै, उन उनही मार डारै के मकसद लग उन सहरन के दूरन हे तकइया रात-दिन लगाय रथै। <verse eid="ACT 9:24"/><verse number="25" style="v" sid="ACT 9:25"/>पय साऊल के चेला ओही अक रात लइ गइन अउ उन साऊल के टोपरी हे बइठ के दिबार के उप्पर लग लटकाय के उके तरी छो उतार देथै।<verse eid="ACT 9:25"/></para>
  <para style="s">यरुसलेम छो साऊल</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 9:26"/>जब साऊल यरुसलेम सहर छो पहुंचथै, ता ऊ बिस्वासिन हे मिलै-जुलै के परयास करथै, पय उन सब बिस्वासी ओखर लग डरथै, काखे उनही बिस्वास नेहको होथै, कि ऊ सहीमा यीसु के चेला बन गय हबै। <verse eid="ACT 9:26"/><verse number="27" style="v" sid="ACT 9:27"/>तब बरनबास उके चेलन कर लिघ्घो लइ गइन अउ ऊ उनही बताथै, कि साऊल परभु के गली हे कउन मेर देखिस अउ परभु ओखर लग कसना बात करिस, दमिस्क हे कउन मेर ऊ बिना डरे लग यीसु के नाम के परचार करिस। <verse eid="ACT 9:27"/><verse number="28" style="v" sid="ACT 9:28"/>अउ साऊल यरुसलेम हे उनखर संग आमै जाय लगिस, अउ बिना डरे परभु के नाम के परचार करै लगिस। <verse eid="ACT 9:28"/><verse number="29" style="v" sid="ACT 9:29"/>ऊ यूनानी भासा यहूदियन लग बातचीत अउ बहस करे करथै, पय उन मनसे उके मार डारे चाहथै। <verse eid="ACT 9:29"/><verse number="30" style="v" sid="ACT 9:30"/>जब बिस्वास करै बालेन भाई बेहनन के एखर पता चलथै, ता उन साऊल के कैसरिया बन्दरगाह छो लइ गइन अउ उछो लग तरसुस सहर छो पठो देथै।<verse eid="ACT 9:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 9:31"/>इहैमेर सगलू यहूदिया, गलील अउ सामरिया कर मंडली के सान्ति हे दिन गुजारथै। ऊ मंडली सक्तिसाली होमय लगिस अउ पवितर आतमा के उतसुक पाय के सक्तिसाली हुइस अउ उन गिनती हे बढत गइन, काखे उन परभु के डेराय कर अपन जीवन बइतीत करथै।<verse eid="ACT 9:31"/></para>
  <para style="s">लुद्दा अउ याफा हे पतरस</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 9:32"/>पतरस चारो चउगिरदा फिरत अक रोज लुद्दा सहर हे भगवान कर पवितर मनसेन लग मिलय पहुंचथै। <verse eid="ACT 9:32"/><verse number="33" style="v" sid="ACT 9:33"/>उछो उके एनियास नाम के अक्ठी लोकवा नंगहा मनसे मिलथै, जउन आठ साल लग खटिया हे पडे रथै। <verse eid="ACT 9:33"/><verse number="34" style="v" sid="ACT 9:34"/>पतरस ओखर लग कथै, “एनियास यीसु मसीह तोके निक्खा करथै, ठाड हो अउ अपन जठना ठीक कर।” अउ ऊ उहै जल्दी ठाड हुइ जथै। <verse eid="ACT 9:34"/><verse number="35" style="v" sid="ACT 9:35"/>तब लुद्दा अउ सारोन के सगलू निबासी उके देखथै अउ उन परभु कर पल्ला फिरथै।<verse eid="ACT 9:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 9:36"/>याफा सहर हे तबीता नाम कर चेला तबीता के यूनानी अनुवाद दोरकास हबै, ऊ अपन धरमी काम करिस अउ निक्खा दिन गुजारत रथै। <verse eid="ACT 9:36"/><verse number="37" style="v" sid="ACT 9:37"/>उहै रोज ऊ नांगा हे मर गइस, मनसे उके नहुवाय के ओखर लोथ के अटारी बाले पटउंहा हे धर देथै। <verse eid="ACT 9:37"/><verse number="38" style="v" sid="ACT 9:38"/>लुद्दा याफा सहर के लिघ्घो हबै। जब चेला सुनथै कि पतरस उछो हबै, ता उन दुइठे मनसेन के पठोय के ओखर लग हइ बिनती करिन, कि तै हरबी हमर इछो आ। <verse eid="ACT 9:38"/><verse number="39" style="v" sid="ACT 9:39"/>तब पतरस उहै टेम उनखर संग चल देथै, जब ऊ याफा पहुंचथै, ता मनसे ओही अटारी के पटउंहा हे लइ गइन। उछो सगलू बिधवा डउकी रोउत ओखर चारो चउगिरदा आय के ठाड होथै अउ उन खुरथा पइजामा अउ बन्डी उनही देखामै लगिन, जेही दोरकास उनखर संग रहत टेम बनाय रथै। <verse eid="ACT 9:39"/><verse number="40" style="v" sid="ACT 9:40"/>पतरस सबझन के बाहिर छो करथै अउ घुटवा टेक के बिनती करथै, एखर बाद ऊ लोथ कर पल्ला मुड के कथै, “हे तबीता ठाड हुइ जा।” ओतकै टेम ओखर आंखी उघर जथै अउ पतरस के देखके ठाड हुइ जथै। <verse eid="ACT 9:40"/><verse number="41" style="v" sid="ACT 9:41"/>पतरस हाथ बढाय के पवितर मनसे अउ बिधवन के बुलाय के उनही उके जिन्दा सउप देथै। <verse eid="ACT 9:41"/><verse number="42" style="v" sid="ACT 9:42"/>हइ बात सगलू याफा हे बगर जथै अउ बोहत मनसे परभु हे बिस्वास करथै। <verse eid="ACT 9:42"/><verse number="43" style="v" sid="ACT 9:43"/>पतरस बोहत रोज तक याफा हे समोन नाम के कउनो खलरी के धंधा करै बालेन के इछो रथै।<verse eid="ACT 9:43"/></para>
  <chapter eid="ACT 9"/>
  <chapter number="10" style="c" sid="ACT 10"/>
  <para style="s">पतरस अउ कुरनेलियुस</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 10:1"/>कैसरिया हे कुरनेलियुस नाम के अक्ठी मनसे रथै, उछो रोमन सिपाही रथै, इतालियानी सिपाही गुट कहे जथै। <verse eid="ACT 10:1"/><verse number="2" style="v" sid="ACT 10:2"/>अउ ऊ हरवाह रहिस अउ अपन सगलू घर कर मनसे भगवान लग डरथै। अउ यहूदी गरीब मनसेन के बोहत दान देथै अउ बराबर भगवान लग बिनती करत रथै। <verse eid="ACT 10:2"/><verse number="3" style="v" sid="ACT 10:3"/>ऊ रोज के तीसर टेम के लिघ्घो दरसन हे सही रूप लग देखथै, कि भगवान कर अक्ठी स्वरगदूत ओखर लिघ्घो भित्तर आयके कथै, हे कुरनेलियुस<verse eid="ACT 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 10:4"/>कुरनेलियन डेरात अउ स्वरगदूत के पल्ला देखत कथै हे परभु काहिन हबै? ऊ ओखर लग कथै, तोर बिनती अउ तोर दान सुरता के निता भगवान कर आगू पहुंचथै। <verse eid="ACT 10:4"/><verse number="5" style="v" sid="ACT 10:5"/>अउ अब कुछ मनसेन के याफा पठोथै, समोन नाम कर मनसे के जउन पतरस कहाथै, उके बुलाइस। <verse eid="ACT 10:5"/><verse number="6" style="v" sid="ACT 10:6"/>ऊ खलरी के धंधा करै बाले समोन नाम के मनसे के इछो गउतरिहा बनाय के ठहराइस अउ ओखर घर समुन्दर के बगल हे हबै। <verse eid="ACT 10:6"/><verse number="7" style="v" sid="ACT 10:7"/>जब ऊ स्वरगदूत जउन ओखर लग बात करे रथै, कढ गइस ता ऊ दुइझन हरवाह अउ जउन ओखर लिघ्घो उपस्थित रथै, अपन खास सहपारटी मसे अक्ठी अच्छी भक्त सिपाही के बुलवाथै। <verse eid="ACT 10:7"/><verse number="8" style="v" sid="ACT 10:8"/>अउ उनही सगलू बात गुठेय के याफा के पठोथै।<verse eid="ACT 10:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 10:9"/>दूसर रोज जब ऊ रेंगत बागत नगर के लिघ्घो पहुंचथै, ता दुपहरी कर टेम पतरस छत हे बिनती करै चढ जथै। <verse eid="ACT 10:9"/><verse number="10" style="v" sid="ACT 10:10"/>उके भूख लगथै अउ कुछ खाय चाहथै, पय जब ऊ तइयारी करथै, तब पतरस सपना देखिस। <verse eid="ACT 10:10"/><verse number="11" style="v" sid="ACT 10:11"/>अउ ऊ देखथै, कि बादर उघरे हर हबै अउ अक्ठी बडा चदरा के जसना तरी छो उतरथै, उके चउगिरदा खुटान लग पकडके भुंइ हे उतारथै। <verse eid="ACT 10:11"/><verse number="12" style="v" sid="ACT 10:12"/>जेहमा भुंइ के सगलू मेर के चवपाई अउ रेंगै बाले जानबर अउ बादर कर चिरइया रथै। <verse eid="ACT 10:12"/><verse number="13" style="v" sid="ACT 10:13"/>फेर आरो सुनाई देथै, हे पतरस उठ अउ इके मार खा।<verse eid="ACT 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 10:14"/>पतरस कथै, “परभु कबहुन नेहको, काखे मै कबहुन असुध्द खाना नेहको खाय हव।”<verse eid="ACT 10:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 10:15"/>फेर दूसर बार उके आरो सुनाई देथै, जउन कुछ भगवान सुध्द ठहराय हबै, उके असुध्द झइ कह। <verse eid="ACT 10:15"/><verse number="16" style="v" sid="ACT 10:16"/>तीसर बार असना होथै, तब जल्दी ऊ चीज बादर हे उठाय लइ जथै।<verse eid="ACT 10:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 10:17"/>जब पतरस अपन मन हे दुबिधा हे रथै, कि हइ दरसन जउन मै देखे हबो, ऊ काहिन हुइ सकथै, ता देखा ऊ मनसे जिनही कुरनेलियुस पठोय रथै, समोन के घर छो पता लगाय के दूरा हे आयके ठाड होथै। <verse eid="ACT 10:17"/><verse number="18" style="v" sid="ACT 10:18"/>अउ ऊ ऊंच आरो लग पूछथै, का समोन जउन पतरस कहाथै, ऊ पहुना इहै घर छो ठहरे हबै? <verse eid="ACT 10:18"/><verse number="19" style="v" sid="ACT 10:19"/>पतरस अभिन्नो ऊ दरसन के बारे हे सोचथै, कि आतमा ओखर लग कथै, देख तीनठे मनसे तोके खोजथै। <verse eid="ACT 10:19"/><verse number="20" style="v" sid="ACT 10:20"/>पय उठके तरी छो जा अउ बिना डरे उनखर संग होय ले काखे मै उनही पठोय हव। <verse eid="ACT 10:20"/><verse number="21" style="v" sid="ACT 10:21"/>तब पतरस उतर के उन मनसेन लग कथै, देखा जेखर खोज तुम करथा ऊ मै हबो, तुम्हर आमैके काहिन मतलब हबै? <verse eid="ACT 10:21"/><verse number="22" style="v" sid="ACT 10:22"/>उन कथै, कुरनेलियुस सिपाही जउन मनसे भगवान लग डरथै अउ यहूदी हे बोहत धरमी आदर के काबिल मनसे हबै, ऊ अक्ठी पवितर स्वरगदूत लग हइ आदेस पाथै, कि तोके अपन घर बुलाय के तोर लग बचन संदेस सुनै। <verse eid="ACT 10:22"/><verse number="23" style="v" sid="ACT 10:23"/>हइ मेर पतरस उनही भित्तर बुलाइस अउ उहां रात बिताइन फेर आने रोज तइयार हुइके उनखर संग कढ गइस,</para>
  <para style="p" vid="ACT 10:23">अउ कुछ बिस्वासी भाई मसे याफा के रहै बाले हबै, ओखर संग हुइ लेथै।<verse eid="ACT 10:23"/></para>
  <para style="s">कुरनेलियुस के घर हे पतरस</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 10:24"/>दूसर रोज ऊ कैसरिया नगर छो पहुंचथै अउ कुरनेलियुस अपन बिरादरी अउ प्रिय साथिन के अक जिघा करके उनही ओरगथै। <verse eid="ACT 10:24"/><verse number="25" style="v" sid="ACT 10:25"/>जब पतरस भित्तर आथै, ता कुरनेलियुस ओखर मुलाखात करथै अउ ओखर गोड हे गिरके उके नमस्ते करथै। <verse eid="ACT 10:25"/><verse number="26" style="v" sid="ACT 10:26"/>पय पतरस उके उठाय के हइ कथै, महुं अक्ठी मनसे हव। <verse eid="ACT 10:26"/><verse number="27" style="v" sid="ACT 10:27"/>अउ ओखर संग बात चीत करत भित्तर छो जथै अउ बोहत मनसेन के अकठ्ठा पइस अउ देखिस, <verse eid="ACT 10:27"/><verse number="28" style="v" sid="ACT 10:28"/>ओखर लग कथै, तुम जानथा कि गैर यहूदी के संग उठक बइठक करना या ओखर इहां जाबे अउ यहूदी कर निता अधरम बेकार हबै, पय भगवान मोके गुठे हबै, कि कउनो मनसे के अपवितर या असुध्द मनसे नेहको गुठेहूं। <verse eid="ACT 10:28"/><verse number="29" style="v" sid="ACT 10:29"/>इहैनिता तोर बुलाय लग मै बिगर कउनो अपत्ति के इहां आय हबो अब मै पूछै चाहथो, कि तै मोके काखे बुलाय? <verse eid="ACT 10:29"/><verse number="30" style="v" sid="ACT 10:30"/>कुरनेलियुस कथै, इहै टेम पूर चार रोज हुइस, मै अपन घर हे मुरगोसा बिनती करथो, ता अचनकै अक्ठी डउका चमचमात खुरथा पइजामा ओढे हर मोर आगू आय के ठाढ हुइ गइस। <verse eid="ACT 10:30"/><verse number="31" style="v" sid="ACT 10:31"/>अउ कथै, कुरनेलियुस तोर बिनती सुन लय गय हबै अउ दीन दुखियन के दय गय तोर दान भगवान के आगू सुरता करे गय हबै। <verse eid="ACT 10:31"/><verse number="32" style="v" sid="ACT 10:32"/>इहैनिता कउनो के याफा नगर छो पठोय के समोन के जउन पतरस कहाथै बुला, ऊ समुन्दर के टाठा हे समोन खलरी के धंधा करै बाले के घर हे पहुना बनके ठहरे हबै। <verse eid="ACT 10:32"/><verse number="33" style="v" sid="ACT 10:33"/>इहैनिता इछो आय अउ बोहत निक्खा करे, इहैनिता परभु जउन आदेस दय हबै, अब हम सगलू इहां भगवान कर आगू हबन ता जउन कुछ भगवान तोर लग गुठे हबै उके सुना।<verse eid="ACT 10:33"/></para>
  <para style="s">पतरस कर बात</para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 10:34"/>तब पतरस कथै, अब मोके जरूरी हबै, कि भगवान कउनो के पक्छपात नेहको करथै। <verse eid="ACT 10:34"/><verse number="35" style="v" sid="ACT 10:35"/>बलुक मनसे कउनो जात के काखे न होय, पय मनसे भगवान लग डरथै अउ धरमी काम करथै, ऊ उके स्वीकार करथै। <verse eid="ACT 10:35"/><verse number="36" style="v" sid="ACT 10:36"/>इहै हबै, ऊ संदेस जउन अपन यीसु मसीह के दवारा जउन सब के परभु हबै, सान्ति के संदेस के उपदेस देत इस्राएल कर मनसेन के भगवान दय रथै। <verse eid="ACT 10:36"/><verse number="37" style="v" sid="ACT 10:37"/>नासरत के रहैबाले यीसु कर बारे हे अउ बात सगलू यहूदिया देस हे जउन होय हबै, उके तुम मनसे जानथा, ऊ सगलू गलील परदेस हे सुरु हुइस, ऊ बतिस्मा के बाद जेखर परचार यूहन्ना करे रथै। <verse eid="ACT 10:37"/><verse number="38" style="v" sid="ACT 10:38"/>भगवान उहै यीसु नासरी के पवितर आतमा अउ सक्ति लग अभिसेक करे रथै अउ ऊ चारो पल्ला घूम-घूम के निक्खा काम करथै अउ भुतवा के बस हे आय हर मनसेन के निक्खा करथै काखे भगवान उनखर संग रथै। <verse eid="ACT 10:38"/><verse number="39" style="v" sid="ACT 10:39"/>उन जउन कुछ यहूदिया परदेस अउ यरुसलेम हे करिस, ओखर गवाह हम हबन, उहै यीसु के मनसे क्रूस के लकडी हे चढाय के मार डारिन। <verse eid="ACT 10:39"/><verse number="40" style="v" sid="ACT 10:40"/>पय भगवान उके मिरतू मसे तीसर रोज जिन्दा करिस अउ परगट रूप लग दिखाई दइस। <verse eid="ACT 10:40"/><verse number="41" style="v" sid="ACT 10:41"/>सगलू मनसेन के नेहको बलुक उन गवाहन के जिनही भगवान आगू लग चुन लय रथै, ऊ गवाह हम हवन, मिरतू मसे ओखर जिन्दा होय कर बाद हम ओखर संग खायन पियन। <verse eid="ACT 10:41"/><verse number="42" style="v" sid="ACT 10:42"/>अउ ऊ हमही आदेस देथै, कि हम मनसेन हे परचार करी अउ गवाही दइ कि हइ उहै हबै, जेही भगवान जिन्दा अउ मिरतू के नियाव करै बाले नियुक्त करे हबै। <verse eid="ACT 10:42"/><verse number="43" style="v" sid="ACT 10:43"/>ओखर बारे हे सगलू ग्यानी मनसे गवाही देथै, कि जउन कउ यीसु हे बिस्वास करी, उके ओखर नाम के दवारा पापन के छमा मिलही।<verse eid="ACT 10:43"/></para>
  <para style="s">गैर यहूदियन हे पवितर आतमा उतरथै</para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 10:44"/>पतरस हइ बात कहत रहै कि पवितर आतमा उन सगलू हे उतर आइस, जउन ओखर संदेस सुनथै। <verse eid="ACT 10:44"/><verse number="45" style="v" sid="ACT 10:45"/>अउ जेतका सुध्दिकरन खतना करे हर पतरस के संग आय हर यहूदी बिस्वासी हइ देखके चकित रह गइन, कि पवितर आतमा के बरदान गैर यहूदिन हे उडेले गइस। <verse eid="ACT 10:45"/><verse number="46" style="v" sid="ACT 10:46"/>काखे उन गैर यहूदिन के अपन भासा हे बोलत अउ भगवान कर महिमा करत सुनथै, तब पतरस कथै। <verse eid="ACT 10:46"/><verse number="47" style="v" sid="ACT 10:47"/>हइ मनसे हमर जसना पवितर आतमा पाय हबै, ता का कउनो उके पानी के बतिस्मा देय लग मना कर सकथै? <verse eid="ACT 10:47"/><verse number="48" style="v" sid="ACT 10:48"/>अउ पतरस आदेस दइस कि उन यीसु मसीह के नाम हे बतिस्मा ले, ता उन पतरस लग हइ बिनती करिस, तै कुछ रोज हमर इहां रहबे।<verse eid="ACT 10:48"/></para>
  <chapter eid="ACT 10"/>
  <chapter number="11" style="c" sid="ACT 11"/>
  <para style="s">पतरस के यरुसलेम मंडली हे हिसाब किताब</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 11:1"/>चेला अउ यहूदिया परदेस के बिस्वासी भाई बेहन के पता चलिस, कि गैर यहूदी भगवान कर बचन स्वीकार कर लय हबै। <verse eid="ACT 11:1"/><verse number="2" style="v" sid="ACT 11:2"/>जब पतरस यरुसलेम पहुंचथै, जउन बिस्वासी सुध्दिकरन खतना बिरोध हे रथै, उन ओखर बिरोध करिन। <verse eid="ACT 11:2"/><verse number="3" style="v" sid="ACT 11:3"/>तै खतना रहित मनसे के संग, इहां जाय तै उनखर संग खाना खाय रहिन। <verse eid="ACT 11:3"/><verse number="4" style="v" sid="ACT 11:4"/>हइ बात हे पतरस सही हे सुरु लग जउन कुछु घटे रथै, उहै सुनिस अउ उके समझाउत कथै।<verse eid="ACT 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 11:5"/>मै याफा सहर छो बिनती करत आतमा लग भरे रहिस अउ अक्ठी दरसन देखिस, कि अक्ठी चीज भेजिस चदरा कर जसना चउगिरदा छोर लग लटकरे हर बादर लग उतर के मोर लिघ्घो आथै। <verse eid="ACT 11:5"/><verse number="6" style="v" sid="ACT 11:6"/>जब मै ओही धियान लग देखो, ता ओहमा भुंइ के चवपाई अउ बनपसु अउ रेंगय बाले जानबर अउ बादर कर चिरइया देखव, <verse eid="ACT 11:6"/><verse number="7" style="v" sid="ACT 11:7"/>अउ हइ आरो सुनथै, हे पतरस ठाड हो मार अउ खा। <verse eid="ACT 11:7"/><verse number="8" style="v" sid="ACT 11:8"/>पय मै कथो, परभु निस्चित रूप लग नेहको, काखे मै कबहुन कउनो के बेकार अउ असुध्द खाना के नेहको खायन। <verse eid="ACT 11:8"/><verse number="9" style="v" sid="ACT 11:9"/>दूसर बार फेरै बादर लग आरो सुनाई दइस, जेही भगवान सुध्द ठहराय हबै, उके तै असुध्द झइ समझ। <verse eid="ACT 11:9"/><verse number="10" style="v" sid="ACT 11:10"/>तीसर बार असना होथै, तब सगलू कुछ फेर बादर हे खींच लय जथै। <verse eid="ACT 11:10"/><verse number="11" style="v" sid="ACT 11:11"/>अउ देखा जल्दी तीनठे मनसे जउन कैसरिया ले मोर लिघ्घो पठोय गय रथै, ऊ घर हे जेहमा हम रहन, आयके ठाड रहिन। <verse eid="ACT 11:11"/><verse number="12" style="v" sid="ACT 11:12"/>आतमा मोर लग उनखर संग बिना डरे जायके कथै, हइ याफा के छह भाई मोर संग गइन अउ हम ऊ मनसे के घर के भित्तर गयन। <verse eid="ACT 11:12"/><verse number="13" style="v" sid="ACT 11:13"/>ऊ हमके गुठेइस, कि ऊ अक्ठी स्वरगदूत के अपन घर हे ठाडे देखव, जउन याफा नगर हे मनसे पठो कि समोन जउन पतरस कहलाथै, बुलवा। <verse eid="ACT 11:13"/><verse number="14" style="v" sid="ACT 11:14"/>ऊ तुम्हर लग असना बात गुठेही, जेखर दवारा तै अउ तोर सगलू बिरादरी मुकति पइहिन। <verse eid="ACT 11:14"/><verse number="15" style="v" sid="ACT 11:15"/>जब सुरु करिस, ता पवितर आतमा उनखर उप्पर उतर आइस, ओसनेन जसना सुरु लग हमर उप्पर उतरे रथै। <verse eid="ACT 11:15"/><verse number="16" style="v" sid="ACT 11:16"/>तब मोके परभु के ऊ बचन सुरता आथै, जउन ऊ गुठे रहिस, यूहन्ना तो पानी लग बतिस्मा दइस, पय तुम पवितर आतमा ले बतिस्मा पइहा। <verse eid="ACT 11:16"/><verse number="17" style="v" sid="ACT 11:17"/>मतलब जब भगवान गैर यहूदी के दान दय हबै, जउन हमके परभु यीसु मसीह हे बिस्वास करै लग मिले रहिस, ता मै कउनो होतो जउन भगवान के रोक सकथै? <verse eid="ACT 11:17"/><verse number="18" style="v" sid="ACT 11:18"/>हइ बात सुनके बुराई करै के बन्द कर देथै अउ भगवान के बडाई करके गुठेय लागथै, तब तो भगवान गैर यहूदिन के जीवन के निता मन बदलै के दान दय हबै।<verse eid="ACT 11:18"/></para>
  <para style="s">अन्ताकिया कर मंडली</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 11:19"/>जउन मनसे ऊ दुख के मारे जउन स्तिफनुस के जसना पडे रहिस, जउन बिस्वासी छिदिर बिदिर हुइ गय रथै, ऊ घूमत फीनीके अउ साइप्रस अउ अन्ताकिया हे पहुंचथै, पय यहूदी के छांडके कउनो अउ के संदेस नेहको सुनथै। <verse eid="ACT 11:19"/><verse number="20" style="v" sid="ACT 11:20"/>इहै बिस्वासी मसे कुछ साइप्रस अउ कुरेनी के रथै, इहैनिता जब ऊ अन्ताकिया छो आयके यूनानियन के परभु यीसु के संदेस के सुनामै लगिन। <verse eid="ACT 11:20"/><verse number="21" style="v" sid="ACT 11:21"/>परभु के सक्ति उनखर हे रथै अउ बोहत मनसे बिस्वास करके परभु के पल्ला फिरै।<verse eid="ACT 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 11:22"/>जब ओखर बात यरुसलेम नगर के मंडली के सुनै हे आथै, ता उन बरनबास के अन्ताकिया पठोथै। <verse eid="ACT 11:22"/><verse number="23" style="v" sid="ACT 11:23"/>उहां पहुंच के अउ भगवान कर अनुगरह के देखके मगन होथै अउ सगलू के सिक्छा देथै, कि तन मन लगाय के परभु लग लिपटे रइहा। <verse eid="ACT 11:23"/><verse number="24" style="v" sid="ACT 11:24"/>काखे बरनबास अक्ठी निक्खा मनसे रथै अउ पवितर आतमा अउ बिस्वास ले परिपून रथै अउ दूसर मनसे परभु हे आयके मिलथै।<verse eid="ACT 11:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 11:25"/>तब ऊ साऊल के खोजय के निता तरसुस छो पठोय देथै। <verse eid="ACT 11:25"/><verse number="26" style="v" sid="ACT 11:26"/>जब ऊ ओखर लग मिलथै, ता उके अन्ताकिया छो लानथै अउ असना होथै, कि ऊ अक साल तक मंडली के संग मिलथै अउ बोहत मनसेन के संदेस देत रथै अउ चेला सब लग आगुन अन्ताकिया हे मसीही कहलाथै।<verse eid="ACT 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 11:27"/>उहै रोज हे कइन झन ग्यानी मनसे यरुसलेम नगर ले अन्ताकिया छो आथै। <verse eid="ACT 11:27"/><verse number="28" style="v" sid="ACT 11:28"/>उनखर मसे अगबुस नाम अक्ठी मनसे ठाड हुइके पवितर आतमा के अगुवाई लग आगू कर बात गुठेथै, कि सगलू दुनिया हे बोहत भुखमरी होही, ऊ भुखमरी क्लोदियुस कर टेम हे हुइस। <verse eid="ACT 11:28"/><verse number="29" style="v" sid="ACT 11:29"/>ता चेला फइसला लेथै, कि सबझन अपन पइसा के जसना यहूदिया हे रहै बाले भाई के मदद के निता कुछ पठोमै के निस्चित करथै। <verse eid="ACT 11:29"/><verse number="30" style="v" sid="ACT 11:30"/>इहैनिता उन ओसनेन करिन अउ उन बरनबास अउ साऊल के हाथ अपन सियानन के लिघ्घो दान भेजिन।<verse eid="ACT 11:30"/></para>
  <chapter eid="ACT 11"/>
  <chapter number="12" style="c" sid="ACT 12"/>
  <para style="s">पतरस जेल लग छुटकारा</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 12:1"/>ऊ टेम हेरोदेस राजा मंडली के कइझन मनसेन के सतामै के सुरु करथै। <verse eid="ACT 12:1"/><verse number="2" style="v" sid="ACT 12:2"/>ऊ यूहन्ना कर भाई याकूब के तलबार लग मरवा डारिस। <verse eid="ACT 12:2"/><verse number="3" style="v" sid="ACT 12:3"/>जब ऊ देखथै, कि यहूदी मनसे एखर लग मगन होथै, ता ऊ पतरस के पकड लेथै। अउ ऊ रोज अखमीरी रोटी के तेउहार के दिनन के बात हबै। <verse eid="ACT 12:3"/><verse number="4" style="v" sid="ACT 12:4"/>ऊ उके पकड के जेल हे बेडथै अउ चार-चार सिपाही के चार पहर हे रखथै, ओखर उप्पर नियाव करै के निता तेउहार कर बाद उके मनसेन के आगू बाहिर लानै। <verse eid="ACT 12:4"/><verse number="5" style="v" sid="ACT 12:5"/>जेल हे पतरस के बेडे रथै, पय मंडली ओखर निता भगवान लग बिनती करत रथै।<verse eid="ACT 12:5"/></para>
  <para style="s">जेल लग पतरस के छंडाय जथै।</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 12:6"/>जब हेरोदेस राजा उके मनसेन कर आगू लामै के रथै, उहै रात पतरस दुइठे सांकड ले बंधररे हर दुइठे सिपाही के बीच हे सोउत रथै अउ सेबकन के दूरा हे जेल कर लिघ्घो सेना नायक देख-रेख करत रथै। <verse eid="ACT 12:6"/><verse number="7" style="v" sid="ACT 12:7"/>ता देखा परभु कर अक्ठी स्वरगदूत आयके ठाड होथै अउ अचानक जेल के कोठा हे, उजियार भर गइस अउ पतरस के पसली हे हाथ मारके उके जगाथै अउ कथै ठाड हो हरबी चल अउ ओखर हाथन लग सांकड उघर के गिर पडथै। <verse eid="ACT 12:7"/><verse number="8" style="v" sid="ACT 12:8"/>तब स्वरगदूत ओखर लग कथै, कमर बांध अउ अपन बूट पहिन ले। ऊ ओसनेन करथै, ऊ अपन खुरथा पइजामा पहिन के मोर पाछू होय ले। <verse eid="ACT 12:8"/><verse number="9" style="v" sid="ACT 12:9"/>ऊ निकरके ओखर पाछू हुइ लेथै, पय हइ नेहको जानथै, कि जउन कुछ स्वरगदूत करथै, ऊ सही हबै, मै हइ समझो कि सपना देखथो। <verse eid="ACT 12:9"/><verse number="10" style="v" sid="ACT 12:10"/>तब आगुन अउ दूसर पहर हे निकर के ऊ लोहा कर फेरका छो जथै, जउन सहर के पल्ला हबै, ऊ उनखर निता अपने अपन उघर जथै अउ ऊ निकरके अक्ठी गली हुइ के जथै अउ जल्दिन स्वरगदूत उके छाडके कढ जथै।<figure style="fig" alt="Chains embedded in prison wall" file="hk00204c.tif" size="col" copy="Horace Knowles ©" ref="12:7">जेलखाना के भीठी हे सांकड जकडे हर</figure><verse eid="ACT 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 12:11"/>फेर पतरस के जसना होस आइस, ऊ बोलिस “अब मोर समझ हे आय हबै, कि हइ सही हे सही हबै, कि परभु अपन स्वरगदूत के पठोय के हेरोदेस के सक्ति लग मोके छंडाय हबै अउ यहूदी मनसे मोर उप्पर जउन कुछु घटै के सोचथै, ओखर लग उहै मोके बचाय हबै।”<verse eid="ACT 12:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 12:12"/>हइ बात जानके ऊ यूहन्ना कर दाय मरियम के घर छो आथै, जउन मरकुस कहाथै, उहां बोहत लग मनसे अक जिघा हुइके बिनती करत रथै। <verse eid="ACT 12:12"/><verse number="13" style="v" sid="ACT 12:13"/>जब ऊ फेरका के कंवाड ठोकठोकाथै, ता रूदे नाम के अक्ठी हरवाहिन देखै के आथै। <verse eid="ACT 12:13"/><verse number="14" style="v" sid="ACT 12:14"/>पतरस के आरो चीन्ह के ऊ खुसी कर मारे फेरका के कंवाड नेहको उघारथै, पय दउडके भित्तर जथै अउ गुठेथै, कि पतरस दूरा हे ठाडे हबै। <verse eid="ACT 12:14"/><verse number="15" style="v" sid="ACT 12:15"/>उन ओखर लग बोलथै, “तय पगला गय हबस।” पय ऊ पूर बिस्वास रथै, कि हइ ओसनेन हबै हइ बात हे उन कथै, “ऊ ओखर स्वरगदूत होही।”<verse eid="ACT 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 12:16"/>उछो पतरस फेरका के कंवाड ठोकठोकाउत रथै, मतलब ऊ कंवाड उघारथै अउ उके देखके चकित रहि जथै। <verse eid="ACT 12:16"/><verse number="17" style="v" sid="ACT 12:17"/>तब ऊ उनही हाथ लग इसारा करथै, कि सान्त रइहा अउ उनही गुठेथै, कि परभु कउन मेर लग मोके जेल लग निकार लाय हबै, फेर कथै याकूब अउ बोहत बिस्वासी भाई के हइ बात गुठे देबे, तब निकर के दूसर जिघा कढ जथै।<verse eid="ACT 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 12:18"/>मुरगोसा सुपाहिन हे बोहत हलचल मच जथै, कि पतरस के काहिन हुइस? <verse eid="ACT 12:18"/><verse number="19" style="v" sid="ACT 12:19"/>एखर बाद हेरोदेस राजा पतरस के खोज करै के आदेस देथै, पय उके नेहको खोज पाथै, ता ऊ सिपाही लग पुछिन जानिन अउ उनही मार डालै के आदेस देथै।</para>
  <para style="p" vid="ACT 12:19">हेरोदेस राजा यहूदिया लग जायके कैसरिया हे रहै लागथै अउ उहां ऊ कुछ रोज गुजारिस।<verse eid="ACT 12:19"/></para>
  <para style="s">हेरोदेस राजा मर गइस</para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 12:20"/>हेरोदेस राजा सूर अउ सैदा के मनसेन लग बोहत गुस्साय रथै। ऊ अक्ठी समूह बनाय के ओखर लग मिलै आइन, राजा कर खास करमचारी बलास्तुस के समझाय के उन हेरोदेस लग सान्ति के बिनती करिन, काखे उनखर देस कर राजा के देस लग खाना खाय के मिलथै।<verse eid="ACT 12:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 12:21"/>अक्ठी निस्चित रोज हेरोदेस अपन राज खुरथा पइजामा पहिन के अपन राज गद्दी हे बइठिस अउ मनसेन के उपदेस देय लगथै। <verse eid="ACT 12:21"/><verse number="22" style="v" sid="ACT 12:22"/>ता मनसे चिल्लाथै, “हइ तो कउनो देउता के आरो हबै मनसेन कर नेहको।” <verse eid="ACT 12:22"/><verse number="23" style="v" sid="ACT 12:23"/>उहै टेम परभु के अक्ठी स्वरगदूत हरबी उके मारथै, काखे ऊ भगवान के महिमा नेहको देथै अउ ऊ किरवा पर के मर जथै।<verse eid="ACT 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 12:24"/>पय भगवान के बचन बढत अउ बगरत गइस।<verse eid="ACT 12:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 12:25"/>जब बरनबास अउ साऊल अपन सेबा पूर कर चुकथै, ता यूहन्ना के जउन मरकुस कहलाथै, संग लइके यरुसलेम नगर छो लउटथै।<verse eid="ACT 12:25"/></para>
  <chapter eid="ACT 12"/>
  <chapter number="13" style="c" sid="ACT 13"/>
  <para style="s">बरनबास पोलुस के चुनथै</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 13:1"/>अन्ताकिया के मंडली हे बोहत ग्यानी मनसे रथै, जसना बरनबास अउ समोन नीगर कहलाथै अउ लूकियुस कुरेनी अउ चवथाई देस के राजा हेरोदेस के निजी माना अउ साऊल। <verse eid="ACT 13:1"/><verse number="2" style="v" sid="ACT 13:2"/>जब ऊ उपास सहित परभु लग बिनती करथै, ता पवितर आतमा कथै, मोर निता बरनबास अउ साऊल के अक्ठी खास काम के निता बुलाय हबै, उके मोर निता अलगे करा।<verse eid="ACT 13:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 13:3"/>तब उन उपास अउ बिनती करके अउ साऊल हे हाथ धरके उनही बिदा करथै।<verse eid="ACT 13:3"/></para>
  <para style="s">साइप्रस हे पोलुस के पहली परचार यातरा</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 13:4"/>हइमेर पवितर आतमा के दवारा पठोय हर सिलूकिया बन्दरगाह छो जथै, अउ उहां ले जिहाज हे चढके साइप्रस दीप छो कढ जथै। <verse eid="ACT 13:4"/><verse number="5" style="v" sid="ACT 13:5"/>अउ सलमीस हे पहुंच के भगवान के सब्द यहूदी के मंडली हे सुनाथै, यूहन्ना, उनखर हरवाह रथै। <figure style="fig" alt="Front view of a synagogue" file="lb00246c.tif" size="col" copy="Horace Knowles ©" ref="13:5">अक्ठी मंडली के आगू के द्रस्य</figure><verse eid="ACT 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 13:6"/>उन पूर टापू के दउरा करै के बाद हे पाफुस आइन, उहां यीसु नाम के अक्ठी यहूदी जादूगर अउ ठगरा ग्यानी मनसेन लग उनखर मुलाखात हुइस, <verse eid="ACT 13:6"/><verse number="7" style="v" sid="ACT 13:7"/>ऊ हाकिम सिरगियुस पोलुस के संग रथै। जउन होसियार डउका रथै। ऊ बरनबास अउ साऊल के अपन लिघ्घो बुलाय के भगवान के बचन सुनामै चाहथै। <verse eid="ACT 13:7"/><verse number="8" style="v" sid="ACT 13:8"/>पय इलीमास टोनहा काखे कि इहै ओखर नाम के मतलब हबै, ओखर बिरोध करके राजपाल के बिस्वास के रोकै चाहथै। <verse eid="ACT 13:8"/><verse number="9" style="v" sid="ACT 13:9"/>तब साऊल जेखर नाम पोलुस हबै, पवितर आतमा ले परिपून हुइके, ओखर हे नजर लगाइस। <verse eid="ACT 13:9"/><verse number="10" style="v" sid="ACT 13:10"/>हे सगलू कपट अउ सगलू चतुराई ले भरे हर भुतवा कर टोरवा, तै हर अक्ठी निक्खा बात के बैरी हबस, काखे तै परभु के सिध्धा रास्ता के टेढवा करै के नेहको छांडही? <verse eid="ACT 13:10"/><verse number="11" style="v" sid="ACT 13:11"/>अब देख परभु के हाथ तोर बिरोध उठे हबै अउ कुछ टेम इलीमास अंधरा हुइहे अउ दिन के बेरा के नेहको देखहे,</para>
  <para style="p" vid="ACT 13:11">तब जल्दी धुंधलापन अउ अंधियार ओखर हे छाय जथै अउ ऊ इछो-उछो टटोलय लागथै, ताकि कउ ओखर हाथ पकरके उके लइ जाय। <verse eid="ACT 13:11"/><verse number="12" style="v" sid="ACT 13:12"/>तब हाकिम जउन होथै, उके देखके अउ परभु के उपदेस ले बोहत चकित हुइ के बिस्वास करथै।<verse eid="ACT 13:12"/></para>
  <para style="s">अन्ताकिया अउ पिसिदिया हे पोलुस</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 13:13"/>पोलुस अउ ओखर संगी पाफुस ले जिहाज रुके पंफूलिया के पिरगा छो आथै, अउ यूहन्ना उनही छाडके यरुसलेम नगर छो लउट जथै। <verse eid="ACT 13:13"/><verse number="14" style="v" sid="ACT 13:14"/>पिरगा ले आगुन बढके ऊ पिसिदिया के अन्ताकिया छो पहुंचथै, अउ सुस्ताय कर रोज यहूदी मंडली हे जाय के बइठ जथै। <verse eid="ACT 13:14"/><verse number="15" style="v" sid="ACT 13:15"/>नियम अउ ग्यानी मनसेन के किताब लग पढै के बाद यहूदी मंडली के सरदार उनखर लिघ्घो संदेस पठोथै, हे भाइयो यदि मनसे खुसी के निता तुम्हर मन हे कउनो बात हबै, ता गुठेवा। <verse eid="ACT 13:15"/><verse number="16" style="v" sid="ACT 13:16"/>हइ बात हे पोलुस ठाड होथै अउ अपन हाथ लग इसारा करके कथै,</para>
  <para style="p" vid="ACT 13:16">हे इस्राएल के मनसे अउ भगवान के महिमा करै बाले अउ डरै बाले गैर यहूदी सुना। <verse eid="ACT 13:16"/><verse number="17" style="v" sid="ACT 13:17"/>इस्राएल के भगवान हमही चुनिस, जब हमर मनसे मिस्र हे ठहरे रथै, ऊ उनही महान देस बनाथै अउ महासक्ति लग ऊ उके बाहिर छो निकाडथै। <verse eid="ACT 13:17"/><verse number="18" style="v" sid="ACT 13:18"/>ऊ चालीस साल तक पटउरा जिघा हे उन सहत रथै। <verse eid="ACT 13:18"/><verse number="19" style="v" sid="ACT 13:19"/>अउ कनान देस हे सातठे जातिन के नास करके धरती इस्राएल के मनसे के अधिकारी के रूप हे दइ देथै। <verse eid="ACT 13:19"/><verse number="20" style="v" sid="ACT 13:20"/>हइ सगलू कुछु करीबन साढे चार सव साल लगिस, एखर बाद समूएल ग्यानी मनसेन तक उनही नियाव करै बालेन के चुनिस। <verse eid="ACT 13:20"/><verse number="21" style="v" sid="ACT 13:21"/>फेर उन अक्ठी राजा के मांग करिस, तब भगवान चालीस साल के निता बिन्यामीन के कुर अक्ठी मनसे कीस कर टोरवा साऊल के चुनथै जउन राज करथै। <verse eid="ACT 13:21"/><verse number="22" style="v" sid="ACT 13:22"/>फेर भगवान उके हटाय के दाऊद के उनखर राजा बनाइस अउ उनखर बारे हे हइ गवाही दइस, मोके अपन मन के अनुरूप अक्ठी मनसे इसै कर टोरवा दाऊद मिल गइस, ऊ मोर सब इक्छा पूर करी। <verse eid="ACT 13:22"/><verse number="23" style="v" sid="ACT 13:23"/>भगवान अपन टीमा के जसना उके दाऊद के घराना हे इस्राएल के निता अक्ठी मुकति करै बाले मतलब यीसु के पइदा करिस। <verse eid="ACT 13:23"/><verse number="24" style="v" sid="ACT 13:24"/>यीसु के आमै ले आगुन यूहन्ना सगलू इस्राएल के सगलू परजा के मन बदलै के बतिस्मा के परचार करथै। <verse eid="ACT 13:24"/><verse number="25" style="v" sid="ACT 13:25"/>जब यूहन्ना अपन सेबा पूर करै बाले रथै, ता ऊ कथै, तुम मोके काहिन समझथा? मै ऊ नेहको पय देखा, मोर बाद अक्ठी आमै बाले हबै, जेखर गोड के बूट के डोरा के मै खोलै के काबिल नेहको हबो।<verse eid="ACT 13:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 13:26"/>हे इस्राएली भाइयो, अब्राहम कर टोरवा अउ सगलू भगवान के महिमा करै बाले अउ डरै बाले गैर यहूदिया मुकति कर संदेस हमर लिघ्घो पठोय गय हबै। <verse eid="ACT 13:26"/><verse number="27" style="v" sid="ACT 13:27"/>काखे कि यरुसलेम नगर के रहै बाले अउ उनखर मुखिया उके नेहको चीनथै अउ न ग्यानी मनसे के बात समझथै, जउन सुस्ताय कर रोज पढ के सुनाय जथै, इहैनिता उके दोसी ठहराय के हइ बातन के पूर करथै। <verse eid="ACT 13:27"/><verse number="28" style="v" sid="ACT 13:28"/>अउ उनही मिरतू के सजा देय के कारन नेहको मिलथै, तउ उन पिलातुस लग उके मरवा डारै के मांग करथै कि उके मार डारे जाय। <verse eid="ACT 13:28"/><verse number="29" style="v" sid="ACT 13:29"/>जब उन ओखर बारे हे पवितर किताब हे जउन लिखवरे हबै, ऊ सगलू बात पूर करथै, ता उके क्रूस ले उतार के मरघटी हे धर देथै। <verse eid="ACT 13:29"/><verse number="30" style="v" sid="ACT 13:30"/>पय भगवान यीसु के मिरतू के बाद फेरै लग जिन्दा करिस। <verse eid="ACT 13:30"/><verse number="31" style="v" sid="ACT 13:31"/>पय फेर ऊ बोहत रोज तक ऊ उनखर बीच हे परगट होत रहिस, जउन गलील लग यरुसलेम तक उनखर संग रथै अउ अब उहै इस्राएली मनसेन के निता उनखर गवाह हबै। <verse eid="ACT 13:31"/><verse number="32" style="v" sid="ACT 13:32"/>हम तुमके हइ संदेस सुनाथन, कि भगवान हमर सियानन लग जउन टीमा करे रथै। <verse eid="ACT 13:32"/><verse number="33" style="v" sid="ACT 13:33"/>यीसु के मर जाय के बाद फेरै जिन्दा करके उनखर लरकन के निता भगवान उहै टीमा के हमर निता पूर करिस, जसना कि भजन संहिता के दूसर भजन हे लिखवरे हबै,</para>
  <para style="q1" vid="ACT 13:33">तै मोर टोरवा हबस,</para>
  <para style="q2" vid="ACT 13:33">आज तोर बाफ बने हबो। <verse eid="ACT 13:33"/><verse number="34" style="v" sid="ACT 13:34"/>अउ ओखर हइ मेर लग मरे हर मसे जिन्दा करै के बारे हे कि ऊ देह कबहुन झइ सडही ऊ हइ कथै,</para>
  <para style="q1" vid="ACT 13:34">मै दाऊद हे पवितर अउ अटल आसीस देहुं,</para>
  <para style="q2" vid="ACT 13:34">जेखर टीमा मै दाऊद लग करे रहों। <verse eid="ACT 13:34"/><verse number="35" style="v" sid="ACT 13:35"/>इहैनिता ऊ अक्ठी अउ दूसर भजन हे गुठे हबै,</para>
  <para style="q1" vid="ACT 13:35">तै अपन पवितर जन के सरै नेहको दइहे।<verse eid="ACT 13:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 13:36"/>फेर दाऊद अपन टेम हे भगवान के मकसद के जसना अपन सेबा के काम पूर करके मरिस, ओखर पुरखा के संग गाडे गइस अउ ओखर देह सर गइस। <verse eid="ACT 13:36"/><verse number="37" style="v" sid="ACT 13:37"/>पय जेही भगवान फेरै जिन्दा करे हबै, ऊ सरै नेहको पाइस। <verse eid="ACT 13:37"/><verse number="38" style="v" sid="ACT 13:38"/>हे इस्राएली भाइयो तुम जान लेया उहै के दवारा ओखर उप्पर बिस्वास करथै, ऊ अपन पाप लग छमा पाथै। <verse eid="ACT 13:38"/><verse number="39" style="v" sid="ACT 13:39"/>हे इस्राएली भाइयो, तुमके जान लेय चाही कि यीसु के दवारा पापन के छमा के उपदेस तुमके दय गय हबै, अउ इहै के दवारा हर कउ जउन बिस्वास करथै, ऊ पाप लग मुकति पा सकथै, जउन मूसा कर नियम मुकति नेहको दइ सकथै। <verse eid="ACT 13:39"/><verse number="40" style="v" sid="ACT 13:40"/>इहैनिता सचेत रहा, जउन ग्यानी मनसे कहे रथै ऊ तुम्हर हे झइ घटै।<verse eid="ACT 13:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="ACT 13:41"/>हे बुराई करै बाले मनसे देखा, बोहत चकित हुइके मर जा,</para>
  <para style="q1" vid="ACT 13:41">काखे जउन आज मै करथो,</para>
  <para style="q2" vid="ACT 13:41">अउ तुमके समझाय,</para>
  <para style="q2" vid="ACT 13:41">भरमा बिस्वास नेहको करथा।<verse eid="ACT 13:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 13:42"/>जब पोलुस अउ बरनबास उहां लग जथै, ता मनसे आगू सुस्ताय कर रोज असना अउ बात गठेमै के बिनती करिन। <verse eid="ACT 13:42"/><verse number="43" style="v" sid="ACT 13:43"/>जब सभा खतम हुइस, ता बोहत गैर यहूदी मनसे भक्त पोलुस अउ बरनबास के पाछू हुइ लेथै, पोलुस अउ बरनबास उनखर लग बात चीत करत बिनती करिस कि भगवान कर अनुगरह हे लगेतार जीवन बिताबा।<verse eid="ACT 13:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 13:44"/>आगू सुस्ताय कर रोज के परभु के बचन सुनै के निता लगभग सगलू नगर उमड पडिन। <verse eid="ACT 13:44"/><verse number="45" style="v" sid="ACT 13:45"/>पय यहूदी भीड के देखके जलन लग भर जथै, पोलुस जउन कुछु कथै, ऊ बात हे बुराई करै लग जथै। <verse eid="ACT 13:45"/><verse number="46" style="v" sid="ACT 13:46"/>तब पोलुस अउ बरनबास निडर हुइके कथै, जरूरी रहिस कि भगवान कर बचन आगू तुमके सुनाय जथै, पय जब तुम उके दूर हटाथा अउ अपन के सबरोज कर जीवन के जसना नेहको ठहराथा, देखा हम गैर यहूदी के पल्ला फिरथन। <verse eid="ACT 13:46"/><verse number="47" style="v" sid="ACT 13:47"/>काखे कि परभु हमके हइ आदेस दय हबै,</para>
  <para style="q1" vid="ACT 13:47">मै तोके गैर यहूदी के निता ज्योति ठहराय हबो,</para>
  <para style="q2" vid="ACT 13:47">ताकि तै भुंइ के छोर तक मुकति के दूरा हबै।<verse eid="ACT 13:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 13:48"/>हइ बात सुनके गैर यहूदी खुस होथै अउ परभु के बचन के बडाई करै लग जथै, अउ जेतका अनन्त जीवन के निता ठहराय गय रथै, उन बिस्वास करथै।<verse eid="ACT 13:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="ACT 13:49"/>तब परभु के बचन ऊ सगलू देस हे बगरै लागथै। <verse eid="ACT 13:49"/><verse number="50" style="v" sid="ACT 13:50"/>हर रोज भगवान कर महिमा करै बाले यहूदिया डउकी अउ सहर के खास मनसे उकसाइन अउ पोलुस अउ बरनबास के बिरोध उपद्रव करवाय के उनही अपन सीमा ले निकाड देथै। <verse eid="ACT 13:50"/><verse number="51" style="v" sid="ACT 13:51"/>हे पोलुस अउ बरनबास उनखर बिरोध हे अपन गोड के धूधुर झार के इकुनियुम छो कढ जथै। <verse eid="ACT 13:51"/><verse number="52" style="v" sid="ACT 13:52"/>चेला मगन अउ पवितर आतमा लग भरपूर हुइ जथै।<verse eid="ACT 13:52"/></para>
  <chapter eid="ACT 13"/>
  <chapter number="14" style="c" sid="ACT 14"/>
  <para style="s">इकुनियुम हे पोलुस अउ बरनबास</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 14:1"/>इहैमेर असनेन घटना इकुनियुम हे घटिस, पोलुस अउ बरनबास इकुनियुम मंडली हे गइन, उन हइ मेर के बात करिन कि बोहत लग गिनती हे यहूदी अउ यूनानी बिस्वास करथै। <verse eid="ACT 14:1"/><verse number="2" style="v" sid="ACT 14:2"/>पय जउन यहूदी बिस्वास नेहको करथै, उन गैर यहूदिन के भडकाथै अउ उनखर मन हे बिस्वास करै बाले भाई बेहन के परति दोस भर देथै। <verse eid="ACT 14:2"/><verse number="3" style="v" sid="ACT 14:3"/>अउ बोहत रोज तक उहां रथै अउ परभु के भरोसा हे हियाव लग बात करथै, अउ ऊ उनखर हाथ ले चिन्हा अउ अदभुत काम करवाय के अपन अनुगरह के सब्द हे गवाही देथै। <verse eid="ACT 14:3"/><verse number="4" style="v" sid="ACT 14:4"/>पय सहर के मनसे हे फूट पड जथै, एखरै ले केतका तो यहूदी के पल्ला अउ केतका तो चेलन के पल्ला हुइ जथै।<verse eid="ACT 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 14:5"/>फेर जब गैर यहूदी सरदार अउ यहूदी अपन नेतन के संग मिलके उनखर संग बेकार बेउहार करै के अउ उनखर उप्पर पथरा मारै के चाल चलिन। <verse eid="ACT 14:5"/><verse number="6" style="v" sid="ACT 14:6"/>ता ऊ हइ बात के जान जथै, अउ लुकाउनिया के लुस्तरा अउ दिरबे नगर हे अउ अगल बगल के परदेस हे भाग जथै। <verse eid="ACT 14:6"/><verse number="7" style="v" sid="ACT 14:7"/>अउ यीसु कर सुभ संदेस के परचार करथै।<verse eid="ACT 14:7"/></para>
  <para style="s">लुस्तरा अउ निक्खा होमै</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 14:8"/>लुस्तरा हे अक्ठी मनसे बइठे हर रथै, ऊ अपन गोड लग लेंगरा रथै अउ पइदाइसी लग लेंगरा रथै, रेंगय-बागय के कबहुन नेहको पाइस। <verse eid="ACT 14:8"/><verse number="9" style="v" sid="ACT 14:9"/>अउ पोलुस के बात के बोलत सुनथै, ऊ ओखर पल्ला टकटकी लगाय के देखथै, कि उके निक्खा हुइ जाय के बिस्वास हबै। <verse eid="ACT 14:9"/><verse number="10" style="v" sid="ACT 14:10"/>अउ बोहत आरो लग कथै, अपन गोड के बल सीधा ठाड हुइ जा, तब ऊ उछल के रेंगै-बागै लागिस। <verse eid="ACT 14:10"/><verse number="11" style="v" sid="ACT 14:11"/>मनसे पोलुस के काम के देखके लुकाउनिया के भासा हे पुकार के कहे लगिस, देउता उनखर रूप हे हुइ के हमार लिघ्घो उतर आय हबै। <verse eid="ACT 14:11"/><verse number="12" style="v" sid="ACT 14:12"/>उन बरनबास के ज्यूस अउ पोलुस के हिरमेस कथै, काखे कि ऊ बात करै हे मुखिया रथै। <verse eid="ACT 14:12"/><verse number="13" style="v" sid="ACT 14:13"/>ज्यूस के ऊ मन्दिर के पुजारी जउन उनखर नगर के आगू रथै, बइला फूलन के माला फेरका हे लायके मनसेन के संग बलि करै चाहथै।<verse eid="ACT 14:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 14:14"/>पय चेला बरनबास अउ पोलुस हइ सुनिन ता उन अपन बन्डी चीर डारिन अउ ऊ बोहत आरो हे हइ कथै, भीड हे गुस जथै। <verse eid="ACT 14:14"/><verse number="15" style="v" sid="ACT 14:15"/>“हे संगी, तुम हइ काखे करथा? हमु उहै मनसे हबन, जसना तुमो हबा, इहां हम तुमके संदेस सुनामै आय हबन, ताकि हइ बेकार बातन लग मुडके ऊ जिन्दा भगवान के पल्ला लउटा जउन स्वरग, भुंइ, सागर अउ एहमा जउन कुछु हबै सगलू के बनाय हबै। <verse eid="ACT 14:15"/><verse number="16" style="v" sid="ACT 14:16"/>गुजरे हर टेम हे ऊ सगलू मनसेन के उनखर अपन-अपन रास्ता हे चल दइन। <verse eid="ACT 14:16"/><verse number="17" style="v" sid="ACT 14:17"/>पय तुमके ऊ अपन खुद अपन गवाह देय बिगर नेहको छांडिस। काखे ऊ तुम्हर संग भलाई करिस, ऊ बादर लग पानी दइस अउ मउसम के जसना फसल दइस, ऊ तुमही भोजन देथै अउ तुम्हर मन के खुसी लग भर देथै।” <verse eid="ACT 14:17"/><verse number="18" style="v" sid="ACT 14:18"/>हइ गुठे के उन मनसेन के बडी परेसानी लग रोकथै, कि उनखर निता बलि नेहको करै।<verse eid="ACT 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 14:19"/>पय कुछ यहूदी अन्ताकिया सहर अउ इकुनियुम लग आयके मनसेन के अपन पल्ला कर लेथै अउ पोलुस के पथरा मारथै, अउ मरे हर समझ के उके नगर के बाहिर छो किढलाय के लइ जथै। <verse eid="ACT 14:19"/><verse number="20" style="v" sid="ACT 14:20"/>पय जब चेला ओखर चउगिरदा पल्ला आयके ठाड होथै, ता ऊ उठके नगर छो लउट गइस अउ दूसर रोज बरनबास के संग दिरबे छो कढ गइस।<verse eid="ACT 14:20"/></para>
  <para style="s">सीरिया के अन्ताकिया छो लउटना</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 14:21"/>पोलुस अउ बरनबास ऊ सहर के मनसेन के संदेस सुनाय के अउ बोहत लग चेला बनाय के, लुस्तरा अउ इकुनियुम अउ अन्ताकिया छो लउट आथै। <verse eid="ACT 14:21"/><verse number="22" style="v" sid="ACT 14:22"/>अउ चेला के बिस्वास के स्थिर करत रथै अउ हइ उपदेस देथै, कि बिस्वास हे बने रहा अउ हइ कहत सिखाथै, हमके बोहत दुख उठाय के भगवान कर राज हे परवेस करै के होही। <verse eid="ACT 14:22"/><verse number="23" style="v" sid="ACT 14:23"/>उन हर मंडली हे सियानन के चुनिस अउ उपास सहित बिनती करके उनही परभु के हाथ हे सउप दइस जेहमा उन बिस्वास करे रथै।<verse eid="ACT 14:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 14:24"/>तब पिसिदिया परदेस पार करके पंफूलिया परदेस छो पहुंचथै। <verse eid="ACT 14:24"/><verse number="25" style="v" sid="ACT 14:25"/>फेर पिरगा नगर हे बचन सुनाय के अत्तलिया नगर छो आथै। <verse eid="ACT 14:25"/><verse number="26" style="v" sid="ACT 14:26"/>अउ उहां ले ऊ नाह जिहाज हे अन्ताकिया छो जथै, जिहां ऊ उस काम के निता जउन ऊ पूर करै रथै, भगवान कर अनुगरह हे सउपे गय रहै।<verse eid="ACT 14:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 14:27"/>जब ऊ अन्ताकिया पहुंचथै, ता उन मंडली के मनसेन के अकजुट करिन, जउन कुछ भगवान उनखर संग करे रथै, ओही सगलू बात के सुनाइन अउ भगवान घोसना करिस, कि भगवान गैर यहूदिन के निता बिस्वास के दूरा उघार दय हबै। <verse eid="ACT 14:27"/><verse number="28" style="v" sid="ACT 14:28"/>अउ उन चेला के संग बोहत रोज तक रथै।<verse eid="ACT 14:28"/></para>
  <chapter eid="ACT 14"/>
  <chapter number="15" style="c" sid="ACT 15"/>
  <para style="s">यरुसलेम हे बइठक</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 15:1"/>फेर कुछ मनसे यहूदिया ले आयके भाइयो के सिखामै लागथै, अगर मूसा कर रीति तुम्हर सुध्दिकरन नेहको होय ता तुम मुकति नेहको पाय सकथा। <verse eid="ACT 15:1"/><verse number="2" style="v" sid="ACT 15:2"/>जब पोलुस अउ बरनबास के उनखर लग बोहत झगडा अउ बाद बिबाद होथै, ता हइ नेहको ठहराय जथै कि पोलुस अउ बरनबास अउ उनखर मसे कुछ मनसे हइ बात के बारे हे चेला अउ सियानन के लिघ्घो यरुसलेम छो जाय।<verse eid="ACT 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 15:3"/>मंडली उहां लग कुछ दुरिहां तक पहुंचाथै अउ उन फीनीके अउ सामरिया ले होत गैर यहूदिन के मन फिरामै के संदेस सुनाउत जथै अउ सगलू भाई बोहत मगन होथै। <verse eid="ACT 15:3"/><verse number="4" style="v" sid="ACT 15:4"/>जब यरुसलेम छो पहुंचथै, ता मंडली अउ चेला सियान उनखर लग खुसी के संग मिलथै अउ उनही गुठेथै कि भगवान उनखर संग हुइके कसना काम करे रथै। <verse eid="ACT 15:4"/><verse number="5" style="v" sid="ACT 15:5"/>पय फरीसिन के पंथ मसे जउन बिस्वास करे रथै, उन मसे कुछ ठाड हुइके कथै, उनही सुध्दिकरन करामै अउ मूसा कर नियाव के आदेस देय के चाही।<verse eid="ACT 15:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 15:6"/>तब चेला अउ सियान हइ बात के बारे हे बिचार करै के निता अकजुट होथै। <verse eid="ACT 15:6"/><verse number="7" style="v" sid="ACT 15:7"/>तब पतरस बोहत बात बिबाद हुइ जाय के बाद ठाड हुइके उनखर ले कथै, हे भाइयो तुम जानथा कि बोहत रोज हुइस, भगवान तुम मसे मोके चुने हबै कि मोर मुंह ले गैर यहूदी संदेस के बचन सुनके बिस्वास करै। <verse eid="ACT 15:7"/><verse number="8" style="v" sid="ACT 15:8"/>मन के जांचै बाले भगवान उनही हमार जसना पवितर आतमा दइके उनही गवाही देथै। <verse eid="ACT 15:8"/><verse number="9" style="v" sid="ACT 15:9"/>अउ बिस्वास के दवारा उनखर मन सुध्द करके हमर हे अउ उनखर हे कुछु भेद नेहको रथै। <verse eid="ACT 15:9"/><verse number="10" style="v" sid="ACT 15:10"/>ता अब तुम काखे भगवान के परिक्छा करथा कि चेला के नटेरी हे जिम्मेदारी के जुंवा धरै के सक्ति रहिस, जेही न हमर दाय-बाफ उठाय सकिन अउ न हम उठाय सकथन। <verse eid="ACT 15:10"/><verse number="11" style="v" sid="ACT 15:11"/>हव हमार हइ बिस्वास हबै कि जउन रीति ले उन परभु यीसु के अनुगरह ले मुकति पइहिन उहै रीति ले हमु पाबो।<verse eid="ACT 15:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 15:12"/>तब सगलू सभा चुपचाप बरनबास अउ पोलुस के बात सुनै लागथै, कि भगवान उनखर दवारा गैर यहूदी हे कसना बडे चिन्हा अउ अदभुत काम दिखाय हबै। <verse eid="ACT 15:12"/><verse number="13" style="v" sid="ACT 15:13"/>जब ऊ चुप रथै ता याकूब गुठे लागथै, “हे भाइयो, मोर बात सुना। <verse eid="ACT 15:13"/><verse number="14" style="v" sid="ACT 15:14"/>समोन गुठेइस कि भगवान आगू पहले गैर यहूदी हे कसना किरपा दया हबै, कि उनखर मसे अपन नाम के निता अक्ठी मनसे बनाय लेया। <verse eid="ACT 15:14"/><verse number="15" style="v" sid="ACT 15:15"/>एखर लग ग्यानी मनसे के बात मिलथै, जसना कि लिखे हबै,”<verse eid="ACT 15:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ACT 15:16"/>एखर बाद मै फेर आयके,</para>
  <para style="q2" vid="ACT 15:16">दाऊद के गिरे हर जिघा उठाहुं,</para>
  <para style="q1" vid="ACT 15:16">अउ ओखर खंडहर के फेरै बनाहुं,</para>
  <para style="q2" vid="ACT 15:16">अउ उके ठाड करहुं।<verse eid="ACT 15:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 15:17"/>इहैनिता कि बचे हर मनसे मतलब सगलू,</para>
  <para style="q2" vid="ACT 15:17">गैर यहूदी जउन मोर नाम के कहाथै, परभु के खोजथै।<verse eid="ACT 15:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ACT 15:18"/>हइ उहै परभु गुठेथै, जउन जगत हे सुरुवात ले इन बातन के संदेस देत आय हबै।<verse eid="ACT 15:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 15:19"/>इहैनिता मोर बिचार हइ हबै कि गैर यहूदिन मसे जउन मनसे भगवान के पल्ला फिरथै, हम उनके दुख नेहको दइ, <verse eid="ACT 15:19"/><verse number="20" style="v" sid="ACT 15:20"/>पय उनही लिख के भेजथै, कि उन मूरती के असुध्द अउ गलत काम अउ गला घोटे हर के मांस ले अउ खून ले दुरिहां रहबे। <verse eid="ACT 15:20"/><verse number="21" style="v" sid="ACT 15:21"/>काखे प्राचीन काल ले नगर मूसा कर नियाव के परचार करै बाले चले आथै अउ ऊ हर सुस्ताय कर रोज मंडली हे पढे जथै।<verse eid="ACT 15:21"/></para>
  <para style="s">दूसर जात बिस्वास करै बालेन कर चिट्ठी</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 15:22"/>तब सगलू मंडली सहित चेला अउ सियान के निक्खा लागथै, कि अपन मसे कुछ मनसेन के चुनै, मतलब यहूदा जउन बरसब्बा कहाथै अउ सीलास के जउन भाइन मसे मुखिया रथै अउ उनही पोलुस अउ बरनबास के संग अन्ताकिया छो पठोथै। <verse eid="ACT 15:22"/><verse number="23" style="v" sid="ACT 15:23"/>उन उनखर हाथ हे लिख के पठोथै, “अन्ताकिया अउ सीरिया अउ किलिकिया के रहै बाले भाइन के जउन गैर यहूदी मसे हबै, चेला अउ सियान भाइन के नमस्ते। <verse eid="ACT 15:23"/><verse number="24" style="v" sid="ACT 15:24"/>हम सुने हबन कि हमर मसे कुछ मनसे उहां जाय के, तुमही अपन बातन ले धकपकाय देथै अउ तुम्हर मन उलट दय हबै, पय हम उनही आदेस नेहको देथै। <verse eid="ACT 15:24"/><verse number="25" style="v" sid="ACT 15:25"/>इहैनिता हम अकचित सही समझे कि चुने मनसेन के अपन पिरिया बरनबास अउ पोलुस के संग तुम्हर लिघ्घो पठोबै। <verse eid="ACT 15:25"/><verse number="26" style="v" sid="ACT 15:26"/>हइ असना मनसे हबै, जउन अपन जीवन हमार परभु यीसु मसीह के नाम के निता दिग्गत हे डाले हबै। <verse eid="ACT 15:26"/><verse number="27" style="v" sid="ACT 15:27"/>इहैनिता हम यहूदा अउ सीलास के पठोय हबै, जउन अपन मुंह लग हइ बात गुठे देबो। <verse eid="ACT 15:27"/><verse number="28" style="v" sid="ACT 15:28"/>पवितर आतमा के अउ हमके सही जान पडिस कि हइ जरूरी बात के छांड के तुम अउ चिन्ता हे झइ डालै। <verse eid="ACT 15:28"/><verse number="29" style="v" sid="ACT 15:29"/>तुम मूरतिन अउ बलि करे हर ले अउ खून ले अउ नटेरी घोटे हर के मास ले अउ गलत काम बाले डउकी ले दुरिहां रइहा। एखर ले दुरिहां रहा ता तुम्हर भला होही। आगू सुभ।”<verse eid="ACT 15:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 15:30"/>फेर उन बिदा हुइके अन्ताकिया पहुंचथै अउ बइठक के अक जिघा करके ऊ चिट्ठी उनही दइ देथै। <verse eid="ACT 15:30"/><verse number="31" style="v" sid="ACT 15:31"/>उन चिट्ठी पढ के ऊ उपदेस के बात ले अति मगन होथै। <verse eid="ACT 15:31"/><verse number="32" style="v" sid="ACT 15:32"/>यहूदा अउ सीलास जउन खुद ग्यानी मनसे रथै, बोहत बातन ले भाइन के सिक्छा दइके स्थिर करथै। <verse eid="ACT 15:32"/><verse number="33" style="v" sid="ACT 15:33"/>उन कुछ रोज रहके भाइन ले सान्ति के संग बिदा होथै, कि अपन पठोय बाले के लिघ्घो जाय। <verse eid="ACT 15:33"/><verse number="34" style="v" sid="ACT 15:34"/>पय सीलास उहां रहै के निक्खा लागथै।<verse eid="ACT 15:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 15:35"/>पय पोलुस अउ बरनबास अउ अन्ताकिया हे रह जथै, अउ दूसर बोहत ले मनसेन के संग परभु के बचन के उपदेस करत अउ संदेस सुनाउत रथै।<verse eid="ACT 15:35"/></para>
  <para style="s">पोलुस अउ बरनबास हे मतभेद</para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 15:36"/>कुछ रोज बाद पोलुस बरनबास लग कथै, जउन नगर हे हम परभु के बचन सुनाय रहन, आबा फेर ओहमा रेंगके अपन भाइन के देखी कि उन कसना हबै। <verse eid="ACT 15:36"/><verse number="37" style="v" sid="ACT 15:37"/>तब बरनबास यूहन्ना के जउन मरकुस कहाथै, संग लेय के बिचार करथै। <verse eid="ACT 15:37"/><verse number="38" style="v" sid="ACT 15:38"/>पय पोलुस उके जउन पंफूलिया हे उनखर ले अलगे हुइ जथै अउ काम उनखर संग नेहको करथै, संग लेय जाय का निक्खा नेहको समझथै। <verse eid="ACT 15:38"/><verse number="39" style="v" sid="ACT 15:39"/>मतलब असना बिबाद उठथै, कि उन अक दूसर लग अलगे हुइ जथै अउ बरनबास, मरकुस के लइके जिहाज हे साइप्रस छो कढ जथै। <verse eid="ACT 15:39"/><verse number="40" style="v" sid="ACT 15:40"/>पय पोलुस सीलास के चुन लेथै अउ भाइन ले परभु के अनुगरह हे सउपे जाय के उहां ले चल देथै। <verse eid="ACT 15:40"/><verse number="41" style="v" sid="ACT 15:41"/>अउ ऊ मंडली के ठाड करत सीरिया अउ किलिकिया लग होत निकरथै।<verse eid="ACT 15:41"/></para>
  <chapter eid="ACT 15"/>
  <chapter number="16" style="c" sid="ACT 16"/>
  <para style="s">तीमुथियुस अउ पोलुस सीलास के संग लेना</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 16:1"/>पोलुस दिरबे अउ लुस्तरा छो जथै। उहां तीमुथियुस नाम के अक्ठी चेला रथै, जउन कउनो बिस्वासी यहूदी दाय कर टोरवा रथै, पय ओखर बाफ यूनानी रथै। <verse eid="ACT 16:1"/><verse number="2" style="v" sid="ACT 16:2"/>ओखर लुस्तरा अउ इकुनियुम के भाइन हे निक्खा बोल चाल रथै। <verse eid="ACT 16:2"/><verse number="3" style="v" sid="ACT 16:3"/>पोलुस तीमुथियुस के अपन संग लइ जाय के चाहथै, इहैनिता उके अपन संग लइ आनथै, ऊ जिघा हे रहै बाले यहूदिन के कारन ओखर सुध्दिकरन करिन, काखे सगलू जानथै कि ओखर बाफ यूनानी हबै। <verse eid="ACT 16:3"/><verse number="4" style="v" sid="ACT 16:4"/>तब नगर हे जात हर उन नियाव के जउन यरुसलेम के चेला अउ सियान निस्चित करे रथै, कि उन मनसे ओखर पालन करै। <verse eid="ACT 16:4"/><verse number="5" style="v" sid="ACT 16:5"/>इहैमेर मंडली बिस्वास हे स्थिर होत गइस अउ संख्या हे रोजदिना बढत गइस।<verse eid="ACT 16:5"/></para>
  <para style="s">तरोआस नगर हे पोलुस के दरसन</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 16:6"/>पवितर आतमा पोलुस सीलास अउ तिमोथी के आसिया परदेस हे बचन के परचार करै लग मना करिस, इहैनिता उन फ्रूगिया अउ गलातिया परदेस के दउरा करिस। <verse eid="ACT 16:6"/><verse number="7" style="v" sid="ACT 16:7"/>उन मूसिया के लिघ्घो पहुंच के, बितूनिया इलाका हे जाय चाहथै, पय यीसु के आतमा उनही जाय नेहको देथै। <verse eid="ACT 16:7"/><verse number="8" style="v" sid="ACT 16:8"/>इहैनिता उन मूसिया ले हुइके तरोआस हे आथै। <verse eid="ACT 16:8"/><verse number="9" style="v" sid="ACT 16:9"/>उहां पोलुस रात के अक्ठी दरसन देखथै कि अक्ठी मकिदुनिया के डउका ठाढ होथै ओखर लग बिनती करके कथै, तै समुन्दर “पार के मकिदुनिया हे आ, अउ हमर मदद कर।” <verse eid="ACT 16:9"/><verse number="10" style="v" sid="ACT 16:10"/>हइ दरसन के तुरन्त बाद हइ रास्ता निकारत भगवान मनसेन के बीच संदेस के परचार करै के निता बुलाय हबै, हम मकिदुनिया जाय के ठान लयन।<verse eid="ACT 16:10"/></para>
  <para style="s">फिलिप्पी हे लुदिया के जीवन बदलथै</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 16:11"/>इहैनिता तरोआस लग हम समुन्दर यातरा सुरु करेन, हम जिहाज लग सिध्धा सुमातराके तक गयन अउ दूसर रोज नियापुलिस हे आयन। <verse eid="ACT 16:11"/><verse number="12" style="v" sid="ACT 16:12"/>उहां ले हम फिलिप्पी पहुंचिन, जउन मकिदुनिया प्रान्त के मुख्य नगर अउ रोमियो के बस्ती हबै अउ हम ऊ नगर हे कुछ रोज तक रहन। <verse eid="ACT 16:12"/><verse number="13" style="v" sid="ACT 16:13"/>सुस्ताय कर रोज हम सहर के फेरका के बाहिर नदिया के पाखा हइ समझ के जथन कि उहां बिनती करै के जिघा होही अउ बइठके उन डउकी लग जउन अक जिघा रथै, बात करै लागथै। <verse eid="ACT 16:13"/><verse number="14" style="v" sid="ACT 16:14"/>लुदिया नाम के थुआतीरा सहर के बैगनी कपडा बेचै बाले अउ भगवान कर आराधना करथै, ऊ डउकी हमर बात सुनत रथै। परभु ओखर मन के दूरा खोलथै कि ऊ पोलुस के बातन हे मन खुसी लग सुनै। <verse eid="ACT 16:14"/><verse number="15" style="v" sid="ACT 16:15"/>फेर अपन पूरे घराना सहित बतिस्मा लेय के बाद ऊ हमर लग हइ बिनती करथै, “कि तै मोके परभु के महिमा करै बाले बिस्वासी मानथस, ता आबा मोर घर हे रहा।” इहैनिता ऊ हमके जाय के निता तइयार कर लइस।<verse eid="ACT 16:15"/></para>
  <para style="s">पोलुस अउ सीलास जेल हे</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 16:16"/>जब हम बिनती करै के जिघा हे गयन, ता हमके अक्ठी जबान हरवाहिन मिलथै जेहमा आगू कर बात गुठे बाले<note caller="+" style="f"><char style="fr" closed="false">16:16 </char><char style="ft" closed="false">भावी</char></note> आतमा रथै अउ भभिस्य गुठेवै लग अपन मालिक कर निता बोहत कुछ कमाथै। <verse eid="ACT 16:16"/><verse number="17" style="v" sid="ACT 16:17"/>ऊ पोलुस अउ हमार पाछू आयके चिल्लाय लागथै, “हइ मनसे परम परधान भगवान के हरवाह हबै, जउन हमके मुकति के रास्ता गुठेथै।” <verse eid="ACT 16:17"/><verse number="18" style="v" sid="ACT 16:18"/>ऊ बोहत रोज तक असना करत रथै पय आखरी हे पोलुस परेसान हुइ गइस अउ मुडके उस आतमा लग कथै, “मै तोके यीसु मसीह के नाम लग आदेस देथो कि हइ मसे निकड जा।” अउ ऊ उहै टेम उस टोरिया मसे निकड गइस। <verse eid="ACT 16:18"/><verse number="19" style="v" sid="ACT 16:19"/>जब ओखर मालिक देखथै कि हमार कमाई के आसरा खतम हुइ गय, ता पोलुस अउ सीलास के पकडके चउक हे मुखिया के लिघ्घो खींच लइ जथै <verse eid="ACT 16:19"/><verse number="20" style="v" sid="ACT 16:20"/>अउ उनही सिपाहिन के लिघ्घो लइ जथै अउ कथै, “हइ मनसे हमर सहर हे असान्ति फइलाथै हइ यहूदी हबै। <verse eid="ACT 16:20"/><verse number="21" style="v" sid="ACT 16:21"/>अउ हइ रीति रिबाज के परचार करथै, जिनके ग्रहन करै के या मानैके हम रोमन अधिकारी के निता जरूरी नेहको हबै।” <verse eid="ACT 16:21"/><verse number="22" style="v" sid="ACT 16:22"/>तब भीड के मनसे ओखर बिरोध हे अक जिघा हुइ गइन, अउ सिपाही ओखर कपडा चीर डारिन अउ उनके डंडा मारै के आदेस देथै। <verse eid="ACT 16:22"/><verse number="23" style="v" sid="ACT 16:23"/>उन पोलुस अउ सीलास के डंडा लग बोहत मारथै अउ जेल हे बेड देथै अउ उन जेल के दारोगा के आदेस देथै, कि उनही सचेत लग उनखर देखरेख करै। <verse eid="ACT 16:23"/><verse number="24" style="v" sid="ACT 16:24"/>दारोगा असना आदेस पाके उनही जेल के भित्तर कोठा हे रखथै अउ भारी लकडी के कठवा हे गोड के बांध देथै।<verse eid="ACT 16:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 16:25"/>आधी रात के करीबन पोलुस अउ सीलास बिनती करत भगवान कर भजन गाउत जथै अउ जेलियर उनखर बात सुनत रथै। <verse eid="ACT 16:25"/><verse number="26" style="v" sid="ACT 16:26"/>एतका हे अक्ठी बोहत भुंइडोल आथै, इहां तक कि जेल के नीह डोल जथै अउ हरबी सगलू दूरा उघर जथै अउ सबके बन्धन छोरर जथै। <verse eid="ACT 16:26"/><verse number="27" style="v" sid="ACT 16:27"/>जेल के सिपाही जाग के देखिस ता कि जेल दूरा उघरे हबै, ता अपन तलबार निकाडिस अउ सोचिस कि कैदी भाग गय हबै अउ खुद के मारै बाले रथै, <verse eid="ACT 16:27"/><verse number="28" style="v" sid="ACT 16:28"/>पय पोलुस ऊंच आरो लग पुकार के कथै, “अपन खुद के नुसकान झइ पहुंचा, काखे कि हम सब इछो हबन।”<verse eid="ACT 16:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 16:29"/>तब ऊ चिमनी मंगवाय के भित्तर कांपत गइस अउ पोलुस अउ सीलास के गोड हे गिर जथै। <verse eid="ACT 16:29"/><verse number="30" style="v" sid="ACT 16:30"/>अउ उनके बाहिर लानके कथै, “हे सज्जनो, मुकति पामै के निता मै काहिन करव?”<verse eid="ACT 16:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 16:31"/>उन कथै, “परभु यीसु मसीह हे बिस्वास कर, ता तै अउ तोर बिरादरी मुकति पाही।” <verse eid="ACT 16:31"/><verse number="32" style="v" sid="ACT 16:32"/>अउ उन ओही अउ ओखर सगलू घर के मनसेन के परभु के बचन सुनाथै। <verse eid="ACT 16:32"/><verse number="33" style="v" sid="ACT 16:33"/>रात के उहै टेम ऊ उनके लइजाय के उनखर घाव धोबै, अउ ऊ अपन सगलू मनसे समेत हरबी बतिस्मा लइन। <verse eid="ACT 16:33"/><verse number="34" style="v" sid="ACT 16:34"/>तब ऊ उनके अपन घर हे लइ जाय के उनखर आगू भोजन रखथै, अउ सगलू बिरादरी भगवान के उप्पर बिस्वास करिन अउ सगलू बिरादरी के संग खुसी मनाथै।<verse eid="ACT 16:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 16:35"/>जब दिन होथै तब रोमन साहब लग अपन सिपाही के कहला पठोथै कि उन मनसेन के छांड देया।<verse eid="ACT 16:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 16:36"/>फेर जेल के अधिकारी हइ बात पोलुस लग कथै, “सिपाही तुमके छांड देय के आदेस लग पठोय देय हबै। इहैनिता अब निकरके सान्ति लग कढ जा।”<verse eid="ACT 16:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 16:37"/>पय पोलुस उनखर लग कथै, “उन हमके जउन रोमी मनसे हबै, दोसी ठहराय बिगर मनसेन के आगू मारथै अउ जेल हे बेड देथै। अब का हमके चुपके लग निकले हबै? असना झइ पय उन खुद आके हमके बाहिर निकारै।”<verse eid="ACT 16:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 16:38"/>सिपाही हइ बात सिपाही लग कथै अउ उन हइ सुनके कि रोमी हबै, बोहत डर जथै, <verse eid="ACT 16:38"/><verse number="39" style="v" sid="ACT 16:39"/>उन आयके उनखर लग छमा मांगिस अउ उन बाहिर छो लइ जाय के बिनती करिन कि उन सहर छांड के कढ जाय। <verse eid="ACT 16:39"/><verse number="40" style="v" sid="ACT 16:40"/>उन जेल लग निकरके लुदिया के इहां जथै अउ भाइन लग मुलाकात करके उनके सान्ति देथै अउ कढ जथै।<verse eid="ACT 16:40"/></para>
  <chapter eid="ACT 16"/>
  <chapter number="17" style="c" sid="ACT 17"/>
  <para style="s">थिस्सलुनीके सहर छो यहूदिन के बिरोध</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 17:1"/>फेर उन अम्फिपुलिस अउ अपुल्लोनिया सहर लग हुइके थिस्सलुनीके छो पहुंचथै, जिहां यहूदी कर अक्ठी मंडली रथै। <verse eid="ACT 17:1"/><verse number="2" style="v" sid="ACT 17:2"/>पोलुस अपन मेर के जसना उनखर लिघ्घो जथै, उन तीसर सुस्ताय कर रोज हे उनखर संग पवितर किताब लग बाद बिबाद करथै <verse eid="ACT 17:2"/><verse number="3" style="v" sid="ACT 17:3"/>अउ पवितर किताब लग लइके उनके समझाउत हइ सिध्द करथै, कि मसीह के समस्या झेलै के रथै अउ उके मरे हर मसे जी उठै के जरूरी रथै, ऊ कथै, “हइ यीसु हबै, जेखर मै तुम्हर बीच हे परचार करथो, मसीह हबै।” <verse eid="ACT 17:3"/><verse number="4" style="v" sid="ACT 17:4"/>उनखर मसे केतका झन अउ यूनानियन मसे बोहत लग भगवान भक्त, अउ बोहत कुलीन डउकी मान लेथै अउ पोलुस अउ सीलास के संग मिल जथै।<verse eid="ACT 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 17:5"/>पय यहूदी गुस्सा हे जरत रथै, उन कुछ केराय के गुन्डा के अकजुट करिस अउ अक्ठी समूह बनाय के सहर हे दंगा करवा दइन, उन यासोन के घर धावा बोल दइस अउ हइ परयास करै लगिन, कउनो मेर पोलुस अउ सीलास के मनसेन के लिघ्घो लइ आनै। <verse eid="ACT 17:5"/><verse number="6" style="v" sid="ACT 17:6"/>पय जब उनके नेहको पाइन ता उन यासोन के अउ कुछ दूसर भाई के सहर के अधिकारी कर आगू किढलाय के लानथै अउ चिल्लाथै, “हइ मनसे दुनिया हे उलट पुलट करथै, अब हमर सहर हे आय हबै। <verse eid="ACT 17:6"/><verse number="7" style="v" sid="ACT 17:7"/>अउ यासोन उनके अपन घर हे ठहराय हबै, हइ मनसे कैसर रोमन राजपाल के बिरोध हे करथै अउ कथै, अक्ठी दूसर राजा हबै, जेखर नाम यीसु हबै।” <verse eid="ACT 17:7"/><verse number="8" style="v" sid="ACT 17:8"/>जब भीड अउ सहर के अधिकारी हइ सुनिन ता ऊ भडक जथै। <verse eid="ACT 17:8"/><verse number="9" style="v" sid="ACT 17:9"/>इहैनिता उन यासोन अउ बाकी मनसेन लग जमानत लइके उनके छांड देथै।<verse eid="ACT 17:9"/></para>
  <para style="s">पोलुस अउ सिलास बिरिया छो</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 17:10"/>भाइयो ने हरबी रातो रात पोलुस अउ सीलास के बिरिया पठोय देथै अउ उन उहां पहुंच के यहूदी के मंडली हे जथै। <verse eid="ACT 17:10"/><verse number="11" style="v" sid="ACT 17:11"/>हइ मनसे तो थिस्सलुनीके के यहूदियन लग भले रहिस अउ उन बोहत लग बचन गरहन करिन अउ सबरोज पवितर किताब हे खोजथै, कि हइ बात योंही हबै कि नेहको। <verse eid="ACT 17:11"/><verse number="12" style="v" sid="ACT 17:12"/>इहैनिता उनखर हे बोहत झन अउ यूनानी कुलीन डउकिनो मसे अउ डउकन मसे बोहत बिस्वास करिन। <verse eid="ACT 17:12"/><verse number="13" style="v" sid="ACT 17:13"/>पय जब थिस्सलुनीके के यहूदी जान जथै, कि पोलुस बिरिया हे भगवान के बचन सुनाथै, ता उहां आथै, मनसेन के दंगा अउ भरमामै के सुरु कर देथै। <verse eid="ACT 17:13"/><verse number="14" style="v" sid="ACT 17:14"/>तब भाई हरबी पोलुस के बिदा करथै कि समुन्दर के टाठा हे कढ जथै पय सीलास अउ तीमुथियुस उहै ठहरे रथै। <verse eid="ACT 17:14"/><verse number="15" style="v" sid="ACT 17:15"/>पोलुस के लइ जाय बाले मनसेन एन्थेस पहुंचाय देथै अउ सीलास अउ तीमुथियुस के निता हइ आदेस देथै, कि ओखर लिघ्घो हरबी आ जाय उहै लग चल पडिन।<verse eid="ACT 17:15"/></para>
  <para style="s">एन्थेस नगर छो</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 17:16"/>जब पोलुस एन्थेस हे ओही ओरगथै, ता सहर के मूरती लग भररे हर देखके बोहत दुख हुइस। <verse eid="ACT 17:16"/><verse number="17" style="v" sid="ACT 17:17"/>इहैनिता हर रोज यहूदी मंडली हे यहूदी अउ भगवान के डरै बाले यूनानी लग बाद बिबाद करत रथै, एतना ही नेहको पय हर रोज बजार हे जउन मनसे अउत-जउत करथै, उनखर लग वाद-बिबाद करथै अउ बजारन हे जउन कउ होथै उनखरो लग वाद-बिबाद करथै। <verse eid="ACT 17:17"/><verse number="18" style="v" sid="ACT 17:18"/>तब इपिकूरी अउ स्तोईकी देखै बाले मसे ओखरो लग बाद बिबाद करै लागथै अउ कुछ कथै, “हइ बकवादी काहिन करै चाहथै?” पय दूसर कथै, “ऊ दूसर देउतन के परचार करैबाले पता चलथै” काखे पोलुस यीसु के जिन्दा हुइके संदेस सुनाथै। <verse eid="ACT 17:18"/><verse number="19" style="v" sid="ACT 17:19"/>तब उन उके अपन संग अरियुपगुस पय लइ जथै अउ पूछथै, “का हम जान सकथन कि हइ नवा भेद जउन तै सुनथस, काहिन हबै? <verse eid="ACT 17:19"/><verse number="20" style="v" sid="ACT 17:20"/>काखे तै अनोखी बात हमके सुनाथस, इहैनिता हम जानै चाहथन कि एखर मतलब काहिन हबै” <verse eid="ACT 17:20"/><verse number="21" style="v" sid="ACT 17:21"/>इहैनिता कि सगलू एथेसवासी अउ परदेसी जउन उहां रथै, नबा बात गुठेमै अउ सुनामै के सिबाय अउ कउनो काम हे टेम नेहको बिताथै।<verse eid="ACT 17:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 17:22"/>तब अरियुपगुस के बीच हे ठाड हुइके पोलुस कथै, “हे एन्थेस के मनसे मै देखथो कि अक्ठिन हर बात हे नियाइपन के बडा मानै बाले हबा। <verse eid="ACT 17:22"/><verse number="23" style="v" sid="ACT 17:23"/>काखे मै फिरथो तब तुम्हर पूजै के चीजन के देखत रहों, ता अक्ठी असना बेदी पायों, जेहमा लिखे रहै, अनजाने भगवान के निता इहैनिता जेही तुम बिगर जाने पूजथा, मै तुमके ओखर संदेस सुनाथों। <verse eid="ACT 17:23"/><verse number="24" style="v" sid="ACT 17:24"/>जउन भगवान दुनिया अउ ओखर सगलू चीजन के बनाइस, ऊ स्वरग अउ भुंइ के मालिक हुइके हाथ के बनाय हर मन्दिर हे नेहको रथै। <verse eid="ACT 17:24"/><verse number="25" style="v" sid="ACT 17:25"/>न कउनो चीज के जरुरत के कारन मनसेन के हाथन के सेबा लेथै, काखे ऊ खुद सब के जीवन अउ जीव अउ सांस अउ सगलू कुछ देथै। <verse eid="ACT 17:25"/><verse number="26" style="v" sid="ACT 17:26"/>ऊ अक्ठी मूल लग मनसेन के सगलू जाति सगलू भुंइ हे रहै बाले कर निता बनाय हबै अउ उनके ठहराय हर टेम अउ निबास के सीमन के इहैनिता बांधथै, <verse eid="ACT 17:26"/><verse number="27" style="v" sid="ACT 17:27"/>कि उन भगवान के खोजै, सहीमा उके टटोलके पामै, तउभरमा ऊ हम मसे कउनो लग दुरिहां नेहको हबै।” <verse eid="ACT 17:27"/><verse number="28" style="v" sid="ACT 17:28"/>काखे कि हम उहै हे जिन्दा रहथन अउ चलत फिरत अउ स्थिर रथन,</para>
  <para style="q1" vid="ACT 17:28">इहै मेर खुद तुम्हर लेखक कथै,</para>
  <para style="q1" vid="ACT 17:28">काखे हम उहै के लरका हबन।<verse eid="ACT 17:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 17:29"/>अउ काखे हम भगवान कर टोरवा हबन, इहैनिता हमके कबहुन नेहको सोचै चाही कि ऊ छाप अस्तित्व सोना, चांदी लग बने हर, या मिसतिरी लग बने कउनो मूरती जसना हबै। <verse eid="ACT 17:29"/><verse number="30" style="v" sid="ACT 17:30"/>बीते हर टेम हे भगवान हइ अग्यानता के धियान नेहको देथै, पय अब सगलू मनसेन के पाप लग मन बदलै के आदेस देथै। <verse eid="ACT 17:30"/><verse number="31" style="v" sid="ACT 17:31"/>ऊ अक रोज निस्चित करथै, जब ऊ अपन नियुक्त करे गइस, अक्ठी डउका के दवारा नियाव के संग दुनिया के निरनय करही, भगवान मरे हर मसे उके जिलायके ऊ हर कउनो के हइ बात के सबूत दय हबै।<verse eid="ACT 17:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 17:32"/>मरे हर के जिन्दा होय के बात सुनके कुछ मनसे तो मजाक करै लागथै अउ कुछ कथै, “हम हइ बारे हे फेरै लग तोर बचन के सुन के सुनब।” <verse eid="ACT 17:32"/><verse number="33" style="v" sid="ACT 17:33"/>पोलुस उनखर बीच मसे निकड जथै। <verse eid="ACT 17:33"/><verse number="34" style="v" sid="ACT 17:34"/>कुछ मनसेन बिस्वास के लइन अउ ओखर संग हुइ लइन। उनखर हे अरियुपगुस के सदस्य दियुनुसियुस अउ दमरिस नाम कर अक्ठी डउकी अउ कइठे मनसे उनखर संग रथै।<verse eid="ACT 17:34"/></para>
  <chapter eid="ACT 17"/>
  <chapter number="18" style="c" sid="ACT 18"/>
  <para style="s">कुरिन्थुस कर मंडली के स्थापना</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 18:1"/>एखर बाद पोलुस एन्थेस सहर के छांड के कुरिन्थुस सहर हे आथै। <verse eid="ACT 18:1"/><verse number="2" style="v" sid="ACT 18:2"/>उहां ऊ पुन्तुस के रहै बाले अक्विला नाम के अक्ठी यहूदी लग मिलथै, जउन हाल हे अपन डउकी प्रिसकिल्ला के संग इटली लग आय रथै, उन इटली इहैनिता छांडे रथै, कि क्लोदियुस सगलू यहूदिन के रोम लग निकड जाय के आदेस दय रथै, इहैनिता पोलुस उनखर लग मिलै गइस। <verse eid="ACT 18:2"/><verse number="3" style="v" sid="ACT 18:3"/>अउ उनखर संग रहै अउ काम करै लगिन, काखे उन अक्ठी काम करथै तम्बू बनामै के। <verse eid="ACT 18:3"/><verse number="4" style="v" sid="ACT 18:4"/>पोलुस सगलू सुस्ताय कर रोज हे मंडली हे लडाई झगडा करथै, अउ यहूदी अउ यूनानिन के समझामै के परयास करथै।<verse eid="ACT 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 18:5"/>जब सीलास अउ तीमुथियुस मकिदुनिया लग आथै, ता पोलुस बचन सुनामै के परयास हे यहूदी के गवाही देय लागथै कि यीसु ही मसीह हबै। <verse eid="ACT 18:5"/><verse number="6" style="v" sid="ACT 18:6"/>पय जब उन मनसे पोलुस कर बिरोध करै अउ बुराई करै लगिन, ता उन अपन बन्डी के धूधुर झार के उनखर लग हइ कथै, तुम्हर खून तुम्हर मूड पडे मोर अन्त करन सुध्द हबै, मै अब लग गैर यहूदिन के लिघ्घो जहुं। <verse eid="ACT 18:6"/><verse number="7" style="v" sid="ACT 18:7"/>हइ मेर पोलुस उहां लग चल पडथै, तीतुस अउ यूस्तुस नाम के अक्ठी मनसे के घर गइस ऊ भगवान कर उपास रथै ओखर घर यहूदी मंडली लग लगे हर रथै। <verse eid="ACT 18:7"/><verse number="8" style="v" sid="ACT 18:8"/>तब मंडली के सरदार क्रिसपुस अपन सगलू परवार समेत परभु हे बिस्वास करिन, अउ उन बोहत लग कुरिन्थवासी जछो पोलुस लग बचन सुने रथै, बिस्वास करके बतिस्मा लेथै।<verse eid="ACT 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 18:9"/>परभु अक रात दरसन के दवारा पोलुस लग कथै, “झइ डर, बलुक बोलत जा अउ चुप्पे झइ रह, <verse eid="ACT 18:9"/><verse number="10" style="v" sid="ACT 18:10"/>काखे कि मै तोर संग हव, अउ कउनो तोर पय चढाई करके तोर हानि नेहको करही काखे कि हइ सहर हे मोर बोहत लग मनसे हबै।” <verse eid="ACT 18:10"/><verse number="11" style="v" sid="ACT 18:11"/>इहैनिता ऊ उनही भगवान के बचन सिखाउत डेढ साल तक रथै।<verse eid="ACT 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 18:12"/>जब गल्लियन अखाया देस के हाकिम रथै, ता यहूदी मनसे अकठ्ठा करके पोलुस हे चढ आथै, अउ उके न्याय आसन के आगू लइ आनथै, <verse eid="ACT 18:12"/><verse number="13" style="v" sid="ACT 18:13"/>“हइ मनसेन के समझाथै कि भगवान के उपास असना मेर लग करै, जउन नियम के खिलाप हबै।”<verse eid="ACT 18:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 18:14"/>पोलुस अपन मुंह खोले बाले रथै, कि राजपाल गल्लियन के यहूदिन लग कथै, “हे यहूदिन, अगर हइ बारे हे कउनो अन्याय कउनो गंभीर अपराधन के होथै, ता तुम्हर बात मोर लाने कुछु कारन होथै। <verse eid="ACT 18:14"/><verse number="15" style="v" sid="ACT 18:15"/>पय यदि लडाई झगडा सब्दो अउ नामो अउ तुम्हर खुदय के नियम के बारे हे हबै, ता तुमिन जाना काखे कि मै इन बातन के नियाइपन नेहको बनै चाहथो।” <verse eid="ACT 18:15"/><verse number="16" style="v" sid="ACT 18:16"/>अउ ऊ यहूदियन के न्याय आसन के आगू लग निकाड देथै। <verse eid="ACT 18:16"/><verse number="17" style="v" sid="ACT 18:17"/>इहैनिता उन पंचायत के मुखिया सोस्थिनेस के धर दबोचा अउ न्याय आसन के आगू उके पीटे लागथै, पय गल्लियन उनखर उप्पर चुटको धियान नेहको दइन।<verse eid="ACT 18:17"/></para>
  <para style="s">अन्ताकिया छो लउटथै</para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 18:18"/>बोहत रोज कर बाद पोलुस बिस्वासी के संग रुके रथै, फेर भाई लग बिदा लइके ऊ जिहाज के रास्ता सीरिया छो आथै अउ ओखर संग प्रिसकिल्ला अउ अक्विला रथै, पोलुस किंख्रिया हे अपन मूड मुडवाइस, काखे ऊ अक्ठी मन्नत मांगे रथै। <verse eid="ACT 18:18"/><verse number="19" style="v" sid="ACT 18:19"/>ऊ इफिसुस छो पहुंचिस अउ पोलुस प्रिसकिल्ला अउ अक्विला के उहै छांड देथै अउ खुद मंडली हे जायके यहूदी लग झगडा करै लागथै। <verse eid="ACT 18:19"/><verse number="20" style="v" sid="ACT 18:20"/>जब उन पोलुस लग बिनती करथै, “हमार संग अउ कुछ रोज रह।” ता ऊ मना कर देथै। <verse eid="ACT 18:20"/><verse number="21" style="v" sid="ACT 18:21"/>पय जात टेम उनखर लग कथै, “अगर भगवान के इक्छा होही ता मै तुम्हर लिघ्घो फेरै आहुं।” फेर ऊ इफिसुस लग नाह जिहाज हे चढ के कढ जथै।<verse eid="ACT 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 18:22"/>अउ कैसरिया हे उतर के यरुसलेम छो जथै अउ मंडली के नमस्ते करके अन्ताकिया हे गइस। <verse eid="ACT 18:22"/><verse number="23" style="v" sid="ACT 18:23"/>कुछ टेम बितामै कर बाद ऊ बिदा लेथै, अउ गलातिया अउ फ्रूगिया के इलाका हे अक जिघा लग दूसर जिघा के यातरा करत सगलू बिस्वास करै बाले चेला अउ बढै लगिन।<verse eid="ACT 18:23"/></para>
  <para style="s">इफिसुस अउ अपुल्लोस हे पोलुस</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 18:24"/>ऊ टेम ऊ अपुल्लोस नाम कर अक्ठी यहूदी रथै, ऊ सिकन्दरिया के रहै बाले रथै, ऊ होसियार मनसे रथै अउ पवितर किताब के पूर ग्यान रथै अउ ऊ इफिसुस हे आथै। <verse eid="ACT 18:24"/><verse number="25" style="v" sid="ACT 18:25"/>ऊ परभु कर रास्ता के वरदान पाय रथै अउ मन लगाके यीसु के बचन के बडे साचेत कर संग जउन सही रथै, उहै सिखाथै पय ऊ केबल यूहन्ना के बतिस्मा के बात जानथै। <verse eid="ACT 18:25"/><verse number="26" style="v" sid="ACT 18:26"/>ऊ मंडली हे निडर हुइके बोलै लागथै, पय प्रिसकिल्ला अउ अक्विला ओखर बात सुनके उके अपन इहां लइ जथै अउ भगवान कर रास्ता के बारे हे पूर निक्खा लग समझाइन। <verse eid="ACT 18:26"/><verse number="27" style="v" sid="ACT 18:27"/>जब अपुल्लोस अखाया छो जायके चाहथै, ता भाई बिस्वास करे बाले उत्साहित करथै अउ उहां के चेलन के ओखर सोगत करै के निता चिट्ठी पठोथै, जब उहां पहुंचिस ता उहां के मनसेन कर निता बोहत मददगार होथै, जउन भगवान के अनुगरह लग बिस्वास कर लय रथै। <verse eid="ACT 18:27"/><verse number="28" style="v" sid="ACT 18:28"/>काखे कि ऊ पवितर किताब लग परमान दइके कि यीसु मसीह हबै, बडी परयास लग यहूदी के सबके आगू सबाल जबाब करथै।<verse eid="ACT 18:28"/></para>
  <chapter eid="ACT 18"/>
  <chapter number="19" style="c" sid="ACT 19"/>
  <para style="s">इफिसुस नगर छो पोलुस</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 19:1"/>ऊ टेम असना हुइस, कि जब अपुल्लोस कुरिन्थुस हे रथै, तब पोलुस भीतरी परदेसन लग यातरा करत इफिसुस हे पहुंचथै, उहां उके कुछ चेला मिलथै। <verse eid="ACT 19:1"/><verse number="2" style="v" sid="ACT 19:2"/>उनखर लग कथै, “का तुम बिस्वास करत टेम पवितर आतमा पाया?” उन ओखर लग कथै “हम तो पवितर आतमा के बात नेहको सुने हबन कि पवितर आतमा होथै।”<verse eid="ACT 19:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 19:3"/>पोलुस ओखर लग कथै, “ता फेर तुम केखर बतिस्मा लय हबा?” उन कथै, “यूहन्ना के बतिस्मा।”<verse eid="ACT 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 19:4"/>पोलुस कथै, “यूहन्ना मन बदलै के बतिस्मा देथै, उनखर लग कथै कि जउन मोर बाद आमै बाले हबै, ओखर मतलब यीसु हे बिस्वास करैके।”<verse eid="ACT 19:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 19:5"/>हइ सुनके उन परभु यीसु के नाम हे बतिस्मा लेथै। <verse eid="ACT 19:5"/><verse number="6" style="v" sid="ACT 19:6"/>जब पोलुस उनखर उप्पर हाथ धरथै, ता पवितर आतमा उनखर हे उतरथै अउ उन दूसर भासा बोलै अउ आगू कर बात करै लागथै। <verse eid="ACT 19:6"/><verse number="7" style="v" sid="ACT 19:7"/>उन कुल मिलाय के करीबन बारहठे डउका रथै।<verse eid="ACT 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 19:8"/>फेर पोलुस यहूदी मंडली हे कढ जथै अउ तीन महिना बिना डरे बोलत रथै, ऊ यहूदियन के संग लडाई झगडा करत उनखर भगवान कर राज के बारे हे समझाय करथै। <verse eid="ACT 19:8"/><verse number="9" style="v" sid="ACT 19:9"/>पय उनखर मसे कुछ मनसे ढीठ रथै, उन बिस्वास करै लग मना कर देथै अउ मनसेन समूह के आगू परभु के रास्ता के बेकार कहै लागथै, तब पोलुस बिस्वास करै बालेन के अपन संग लइस, उनके छांडके कढ गइस अउ चेलन के अलगे कर लइस अउ तुरतरुस के पाठसाला हे रोज दिन सिक्छा दे लगिस। <verse eid="ACT 19:9"/><verse number="10" style="v" sid="ACT 19:10"/>एखर बाद हइ होथै, कि दुइ साल तक असना ही चलत रथै, एखर बाद हइ होथै कि सगलू आसिया के रहै बाले यहूदी अउ यूनानी सब परभु कर बचन सुन लइन।<verse eid="ACT 19:10"/></para>
  <para style="s">सिकवा कर टोरवा</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 19:11"/>भगवान पोलुस के हाथ लग बोहत चकित के काम करत रथै। <verse eid="ACT 19:11"/><verse number="12" style="v" sid="ACT 19:12"/>इहां तक कि ओखर छुवै उरमाल अउ साफी के नंगहन के लिघ्घो लइ जाय करथै अउ उन नंगहा निक्खा हुइ जथै, अउ भुतवा उनखर मसे निकड जथै। <verse eid="ACT 19:12"/><verse number="13" style="v" sid="ACT 19:13"/>पय कुछ यहूदी मनसेन जउन भुतवा निकारत इछो-उछो घूमत बागत रथै, हइ कहै लग जथै, कि जिनखर हे भुतवा समाय रथै, उनखर उप्पर परभु यीसु के नाम लइके परयोग करथै अउ कथै, मै तुमके ऊ यीसु कर नाम हे जेखर परचार पोलुस करथै, आदेस देथो, <verse eid="ACT 19:13"/><verse number="14" style="v" sid="ACT 19:14"/>अक्ठी स्क्किवा नाम के अक्ठी यहूदी महा पुजारी के सातठे टोरवा रथै, जउन असनैन करथै।<verse eid="ACT 19:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 19:15"/>पय भुतवा उनही जबाब देथै, “यीसु के मै जानथो अउ पोलुस के चीनथो, पय तुम कउन हबा?” <verse eid="ACT 19:15"/><verse number="16" style="v" sid="ACT 19:16"/>अउ ऊ मनसे जेहमा भुतवा रथै, उनखर उप्पर झपटथै अउ लडाई लग काबू पाय के दोनो के हरा देथै, हइ मेर ऊ बिना कपडा के अधमरहा हुइके घर लग निकड के भाग गइस। <verse eid="ACT 19:16"/><verse number="17" style="v" sid="ACT 19:17"/>हइ बात इफिसुस के रहैबाले सगलू यहूदी अउ यूनानी जान जथै, अउ उन सब पर भय छाय जथै अउ परभु यीसु के नाम के बडाई करथै। <verse eid="ACT 19:17"/><verse number="18" style="v" sid="ACT 19:18"/>जउन बिस्वास करथै, उनखर मसे बोहत झन आयके अपन कामन के मान लेथै अउ परगट करिस। <verse eid="ACT 19:18"/><verse number="19" style="v" sid="ACT 19:19"/>जादू करै बाले मसे बोहत अपन किताब अक जिघा करके सबके आगू जराय देथै अउ जब उनखर दाम जोडे जथै, ता पचास हजार खोटन्ना के बरोबर रथै। <verse eid="ACT 19:19"/><verse number="20" style="v" sid="ACT 19:20"/>इहैमेर परभु के बचन बल पूरबक फइलथै अउ प्रबल होत जथै।<verse eid="ACT 19:20"/></para>
  <para style="s">इफिसुस हे दंगा</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 19:21"/>जब हइ बात होय चुकथै ता पोलुस आतमा हे ठानथै कि मकिदुनिया अउ अखाया लग हुइके यरुसलेम छो जहुं अउ कथै, “उहां जाय के बाद मोके रोम सहर के देखै के जरूरी हबै।” <verse eid="ACT 19:21"/><verse number="22" style="v" sid="ACT 19:22"/>उन अपन तीमुथियुस अउ इरास्तुस नाम कर दुइठे मतलब सेबा करै बालेन के मकिदुनिया पठो देथै, अउ खुदय आसिया हे कुछ टेम गुजारथै।<verse eid="ACT 19:22"/></para>
  <para style="s">इफिसुस हे बइमानी</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 19:23"/>अउ ऊ टेम परभु के हइ रास्ता के कारन इफिसुस हे बोहत गंभीर परेसानी हुइस। <verse eid="ACT 19:23"/><verse number="24" style="v" sid="ACT 19:24"/>ऊ देमेतरियुस नाम कर अक्ठी मनसे जउन चांदी के काम करै बाले सोनरा रथै, ऊ अरतिमिस देबी के चांदी के मन्दिर बनवाथै, जेखर लग मिसतिरिन के बोहत फायदा मिलथै। <verse eid="ACT 19:24"/><verse number="25" style="v" sid="ACT 19:25"/>ऊ उनही हइ काम लग जुडे हर दूसर मिसतिरिन के अक जिघा करथै, “हे मनसे, तुम जानथा कि हइ काम लग हमके केतका फायदा मिलथै। <verse eid="ACT 19:25"/><verse number="26" style="v" sid="ACT 19:26"/>तुम देख सकथा अउ सुन सकथा, हइ पोलुस न इफिसुस हे बलुक करीबन आसिया के दुरिहां के इलाका हे मनसेन के बहकाय के बदल देथै, ऊ कथै, मनसेन के हाथन लग बनाय हर देउता बिलकुन देउता नेहको हबै। <verse eid="ACT 19:26"/><verse number="27" style="v" sid="ACT 19:27"/>इनखर लग न सिबाय हइ बात के डर हबै, कि हमार काम धंधा बदनाम होही, बलुक बडा देबी अरतिमिस के बिनती भवन के मान सम्मान समापत हुइ जाय के डर रथै, अउ जउन देबी के उपास पूर आसिया अउ पूर दुनिया के दवारा करे जथै, ओखर ऊ गरिमा छिन जायके डर हबै।”<verse eid="ACT 19:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 19:28"/>उन हइ सुनके गुस्सा लग भर जथै अउ चिरलाय के गुठे लागथै, “इफिसियन के अरतिमिस देबी बडा हबै।” <verse eid="ACT 19:28"/><verse number="29" style="v" sid="ACT 19:29"/>सगलू सहर हे खलबली फइल गइस इहैनिता मनसे मकिदुनिया लग आइन, अउ पोलुस के यातरा करत गयुस अउ अरिस्तर्खुस के धर दबोचिस अउ उनके रंगसाला जिघा हे लइ आनिस। <verse eid="ACT 19:29"/><verse number="30" style="v" sid="ACT 19:30"/>जब पोलुस मनसेन के लिघ्घो भित्तर जाय चाहथै ता चेला उके नेहको जाय देथै। <verse eid="ACT 19:30"/><verse number="31" style="v" sid="ACT 19:31"/>कुछ इलाका के अधिकारी जउन ओखर संगी रथै, ओखर लग कहलवा पठोथै अउ बिनती करथै, कि उहां रंगसाला हे आमै के झइ सोचै। <verse eid="ACT 19:31"/><verse number="32" style="v" sid="ACT 19:32"/>सभा हे हल्ला मचे रथै, कउनो कुछ चिल्लात रथै। ता कउनो कुछ सब मनसे हइ नेहको जानथै कि उन काखे अक जिघा होय हबै। <verse eid="ACT 19:32"/><verse number="33" style="v" sid="ACT 19:33"/>तब यहूदी सिकन्दर के जेखर नाम भीड मसे जिम्मेदारी के रूप आगे के देथै, फेर अपन हाथन के हिलाय-हिलाय के सिकन्दर मनसेन आगू बचाव के प्रस्तुत करै के चाहिस। <verse eid="ACT 19:33"/><verse number="34" style="v" sid="ACT 19:34"/>पय जब उन जान गयन कि ऊ यहूदी हबै, ता सगलू कउ अक्ठी आरो लग दुइ घन्टा तक चिरलात<note caller="+" style="f"><char style="fr" closed="false">19:34 </char><char style="ft" closed="false">चिल्लाते</char></note> रथै, “इफिसियन के अरतिमिस, बडा हबै।”<verse eid="ACT 19:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 19:35"/>तब सहर के मन्तरी मनसेन के सान्त करके कथै, “हे इफिसुस के मनसेन, का दुनिया हे कउनो असना मनसे हबै, जउन हइ नेहको जानथै कि इफिसियन के सहर बडा देवी अरतिमिस अउ स्वरग लग गिरे हर पथरा के पवितर मूरती हबै। <verse eid="ACT 19:35"/><verse number="36" style="v" sid="ACT 19:36"/>जब कि इन बातन के मना नेहको कर सकथै, ता जरूरी हबै कि तुम सान्त रहा अउ बिगर सोचे समझे कुछु झइ करा। <verse eid="ACT 19:36"/><verse number="37" style="v" sid="ACT 19:37"/>काखे तुम हइ मनसेन के लाय हबा जउन न मन्दिर के लूटै बाले हबै अउ न हमार देवी के बुराई करे हबै। <verse eid="ACT 19:37"/><verse number="38" style="v" sid="ACT 19:38"/>अगर देमेतरियुस अउ ओखर संगी कारीगरन के कउनो लग झगडा हबै ता कचहरी खुले हबै अउ सिपाही भी हबै उनखर उप्पर अक दूसर हे मुकदमा चला सकथन। <verse eid="ACT 19:38"/><verse number="39" style="v" sid="ACT 19:39"/>पय तुम एखर लग बोहत कुछ जानै के चाहथा, ता एखर फइसला नागरिकन के कानूनी पंचायत हे बिचार करे जही। <verse eid="ACT 19:39"/><verse number="40" style="v" sid="ACT 19:40"/>अब जउन कुछु हबै, एखर जसना हमके हइ डर हबै, कि आज के उपद्रव के दोस हमर उप्पर झइ लगामै जाय, हइ दंगा के निता हमर लिघ्घो कउनो कारन नेहको, जेखर लग हम हइ बातन के सही ठहरा सकि।” <verse eid="ACT 19:40"/><verse number="41" style="v" sid="ACT 19:41"/>हइ गुठेके पंचायत के समापत करिस।<verse eid="ACT 19:41"/></para>
  <chapter eid="ACT 19"/>
  <chapter number="20" style="c" sid="ACT 20"/>
  <para style="s">मकिदुनिया, यूनान अउ तरोआस हे पोलुस</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 20:1"/>उनही बुलाय के उत्साहित के सब्दन लग बढाइस अउ पोलुस चेला के बुलाय के समझाथै, अउ उनखर लग बिदा लइके मकिदुनिया के पल्ला कढ जथै। <verse eid="ACT 20:1"/><verse number="2" style="v" sid="ACT 20:2"/>उनही संदेस के दवारा मनसेन के उत्साहित करत ऊ यूनान देस आ गइस। <verse eid="ACT 20:2"/><verse number="3" style="v" sid="ACT 20:3"/>जब तीसर महीना रहके उहां ले जिहाज हे सीरिया के पल्ला जाय रथै, ता यहूदी ओखर घात हे लगे रथै, इहैनिता ऊ हइ निस्चय करथै कि मकिदुनिया हुइके लउट जाय। <verse eid="ACT 20:3"/><verse number="4" style="v" sid="ACT 20:4"/>बिरिया के पुर्रुस कर टोरवा सोपतरुस, थिस्सलुनीके के रहै बाले अरिस्तर्खुस अउ सिकुन्दुस दिरबे के निबासी गयुस अउ तीमुथियुस अउ आसिया इलाका के तुखिकुस अउ तिरिफिमुस ओखर संग रथै। <verse eid="ACT 20:4"/><verse number="5" style="v" sid="ACT 20:5"/>ऊ मनसे पहिलेन कढ जथै अउ तरोआस हे ओरगथै। <verse eid="ACT 20:5"/><verse number="6" style="v" sid="ACT 20:6"/>अउ हम अखमीरी रोटी रोज के बाद फिलिप्पी ले जिहाज हे चढके पांच रोज हे, तरोआस हे ओखर लिघ्घो पहुंचथै अउ सात रोज तक उहै रहै।<verse eid="ACT 20:6"/></para>
  <para style="s">पोलुस के तरोआस हे आखरी मुलाकात</para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 20:7"/>हप्ता के रात जब हम रोटी टोरै के निता अक जिघा हुइन, ता पोलुस जउन दूसर रोज कढ जाय हे रथै, उनखर लग बात करिस अउ आधी रात तक बात करत रथै। <verse eid="ACT 20:7"/><verse number="8" style="v" sid="ACT 20:8"/>जउन पटउंहा हे अक्ठी कमरा रथै, जिहां हम अक जिघा अकजुट रथन उहां बोहत चिमनी बरत रथै। <verse eid="ACT 20:8"/><verse number="9" style="v" sid="ACT 20:9"/>अउ यूतुखुस नाम के अक्ठी जबान झरोकिया हे बइठे रथै, ऊ भारी नींद लग सोय रथै, काखे पोलुस लगेतार बोले जथै, इहैनिता उके भारी नींद आय जथै, इहैनिता ऊ तीसर मंजिल लग गिर जथै, जब उके उठाइन ता, ऊ मर चुके रथै। <verse eid="ACT 20:9"/><verse number="10" style="v" sid="ACT 20:10"/>पय पोलुस उतर के ओखर ले लिपट जथै अउ गले लगाय के कथै, “झइ डेरा काखे ऊ अभिन्नो जीवन हबै।” <verse eid="ACT 20:10"/><verse number="11" style="v" sid="ACT 20:11"/>फेर अटारी हे कढ जथै अउ उनखर लग रोटी टोर के बाटिस अउ खाइस, फेर ऊ उनखर संग बोहत देर बेरा निकरत टेम बात चीत करत रथै, फेर ऊ उनखर लग बिदा लेथै। <verse eid="ACT 20:11"/><verse number="12" style="v" sid="ACT 20:12"/>अउ ऊ जबान के घर छो जिन्दा लइ आनिस अउ उनके बोहत सान्ति मिलिस।<verse eid="ACT 20:12"/></para>
  <para style="s">तरोआस लग मिलेतुस के यातरा</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 20:13"/>हम नाह जिहाज छो पहिलेन पहुंच गयन अउ अस्सुस छो चल पडिन, उहां पोलुस के हम के जिहाज हे ले का रथै, काखे ऊ असना परयोजन बनाय रथै, कि ऊ उहां तक खुदय पइदल आमैके चाहथै। <verse eid="ACT 20:13"/><verse number="14" style="v" sid="ACT 20:14"/>जब पोलुस अस्सुस हे मिलिस, ता हम उके नाह जिहाज हे चढाय लयन अउ मितुलेने छो चल पडही। <verse eid="ACT 20:14"/><verse number="15" style="v" sid="ACT 20:15"/>उहां ले जिहाज खोलके हम दूसर रोज खियुस के आगू पहुंचथै, अउ अगले रोज सामुस हे जा लगे फेर मिलेतुस हे आथै। <verse eid="ACT 20:15"/><verse number="16" style="v" sid="ACT 20:16"/>काखे पोलुस जिहां तक हुइ सकै पिन्तेकुस्त के रोज तक यरुसलेम पहुंचै के हरबी करथै, ता निस्चय करथै, कि इफिसुस हे रुकिन अउ बिना रुके आगू चले जात रहै, जेखर ऊ आसिया हे टेम नेहको बितामै के पडै।<verse eid="ACT 20:16"/></para>
  <para style="s">इफिसुस के सियानन के निता पोलुस के बिदाई संदेस</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 20:17"/>ऊ मिलेतुस ले इफिसुस के मंडली के सियानन के संदेस पठोय के अपन लिघ्घो बुलवाइस। <verse eid="ACT 20:17"/><verse number="18" style="v" sid="ACT 20:18"/>जब ऊ ओखर लिघ्घो आथै, ता उनखर ले कथै, “तुम जानथा कि आगू रोज ले जब मै आसिया हे पहुंचथै, हर टेम तुम्हर संग कउन परकार हे रहिस, <verse eid="ACT 20:18"/><verse number="19" style="v" sid="ACT 20:19"/>मतलब बडी दीनता लग अउ आंसू बहाय के अउ उन परिक्छा हे जउन यहूदी के कारन मोर हे आय पडथै, मै परभु के सेबा करै रहों <verse eid="ACT 20:19"/><verse number="20" style="v" sid="ACT 20:20"/>अउ जउन बात तुम्हर लाभ के रहिस, उनही गुठेमै अउ मनसेन के आगू अउ घर-घर सिखामै लग कबहुन नेहको झिझकथै। <verse eid="ACT 20:20"/><verse number="21" style="v" sid="ACT 20:21"/>यहूदी अउ यूनानी के मै समान भाव लग मन बदलै के भगवान के पल्ला मोके कहत रथै, अउ हमर परभु यीसु हे बिस्वास के परति उनके सचेत करथो। <verse eid="ACT 20:21"/><verse number="22" style="v" sid="ACT 20:22"/>अउ पवितर आतमा के वस हुइ के मै यरुसलेम जथो, मै नेहको जानथो, कि मोर संग उहां काहिन घटही <verse eid="ACT 20:22"/><verse number="23" style="v" sid="ACT 20:23"/>केबल हइ कि पवितर आतमा हर सहर हे गवाही दइ के मोर लग कथै कि बन्धन अउ पीरा तोके ओरगथै। <verse eid="ACT 20:23"/><verse number="24" style="v" sid="ACT 20:24"/>पय मै अपन जीवन के कउनो कीमत नेहको, मै ऊ बस ऊ धूप के सेबा के पूर करे चाहथो, जेही मै परभु यीसु दय हबै, हइ भगवान के अनुगरह के संदेस के गवाही दय के।”<verse eid="ACT 20:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 20:25"/>अब देखा, मै जानथो कि तुम सब जेहमा मै भगवान कर राज के परचार करत फिरथै, मोर मुंह फेर नेहको देखिहा। <verse eid="ACT 20:25"/><verse number="26" style="v" sid="ACT 20:26"/>इहैनिता मै आज गवाही दइ के कथो, कि तुम्हर मसे कउनो के खून के दोसी मै नेहको हबै। <verse eid="ACT 20:26"/><verse number="27" style="v" sid="ACT 20:27"/>काखे मै भगवान के सगलू इक्छा के तुम के सब मेर लग गुठेमै के नेहको झिझकथै। <verse eid="ACT 20:27"/><verse number="28" style="v" sid="ACT 20:28"/>इहैनिता अपन अउ पूरे झुन्ड के चवकसी करा जेहमा पवितर आतमा तुमके मुखिया ठहराय हबै, कि तुम भगवान के मंडली के रखबाली करा, जेही ऊ अपन खून ले खरीद लय हबै। <verse eid="ACT 20:28"/><verse number="29" style="v" sid="ACT 20:29"/>मै जानथो कि मोर जाय के बाद फाडै बाले बिगवा तुम्हर बीच हे अइहिन अउ निक्खा समूह के नेहको छोडहिन। <verse eid="ACT 20:29"/><verse number="30" style="v" sid="ACT 20:30"/>इहां तक कि असना टेम आही, कि तुम्हर बीच मसे असना मनसेन ठाढ हुइहिन जउन चेलन के अपन पाछू होमै के बातन के घुमाय फिराय के संदेस करही। <verse eid="ACT 20:30"/><verse number="31" style="v" sid="ACT 20:31"/>इहैनिता जागत रहा अउ स्मरन करा कि मै तीन साल तक रात दिना आंसू बहाय के हर अक्ठी के चेतावनी देय के नेहको छोडिस।<verse eid="ACT 20:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 20:32"/>“अब मै तुम के भगवान अउ ओखर अच्छा संदेस के अनुगरह के हाथन हे सउपथो, उहै तुमके बनाय बाले हबै अउ तुमके उन मनसे के संग जेखर पवितर करे जा चुके हबै, उहै तुम्हर उतराधिकारी देवाय सकथै। <verse eid="ACT 20:32"/><verse number="33" style="v" sid="ACT 20:33"/>मै कउनो के चांदी, सोना या खुरथा पइजामा के लालच नेहको करथै। <verse eid="ACT 20:33"/><verse number="34" style="v" sid="ACT 20:34"/>तुम खुदय जानथा कि इहै हाथ मोर अउ मोर संगिन के सेबा अउ जरूरत पूर करिस। <verse eid="ACT 20:34"/><verse number="35" style="v" sid="ACT 20:35"/>मै तुमके सब कुछ करके दिखाथै कि इहैमेर ले मेहनत करत कमजोर के सम्भालना अउ परभु यीसु के बचन स्मरन रखै का जरूरी हबै, जउन ऊ खुदय कथै लेय लग दय धन्य हबै।”<verse eid="ACT 20:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 20:36"/>हइ गुठेय के बाद ऊ घुटवा टेक के अउ उन सब के संग बिनती करथै। <verse eid="ACT 20:36"/><verse number="37" style="v" sid="ACT 20:37"/>तब सबझन रोइन अउ पोलुस के गले लिपटे उके चूमै करै लागथै। <verse eid="ACT 20:37"/><verse number="38" style="v" sid="ACT 20:38"/>उन बिसेसकर हइ बात लग सोकित रथै जउन ऊ गुठे रहिस कि तुम मोर मुंह फेर नेहको देखिहा। तब उन उके नाह जिहाज तक छांड आथै।<verse eid="ACT 20:38"/></para>
  <chapter eid="ACT 20"/>
  <chapter number="21" style="c" sid="ACT 21"/>
  <para style="s">पोलुस यरुसलेम छो जथै</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 21:1"/>फेर हम उनखर लग बिदा हुइ के सागर हे अपन नाह जिहाज छोर दयन अउ सिध्धा रास्ता लग कोस हे आय गयन अउ फेर दूसर रोज रुदुस हे, फेर उहां ले हम पतरा के चले गयन। <verse eid="ACT 21:1"/><verse number="2" style="v" sid="ACT 21:2"/>उहां हम अक्ठी नाह जिहाज लयन जउन फीनीके परदेस छो जथै <verse eid="ACT 21:2"/><verse number="3" style="v" sid="ACT 21:3"/>जब साइप्रस दिखाई देथै, ता हम उके टेटरा पल्ला छांड के सीरिया छो मुड गइन, काखे नाह जिहाज सूर सहर उतारै के रथै अउ हमु उहां उतर गयन। <verse eid="ACT 21:3"/><verse number="4" style="v" sid="ACT 21:4"/>उछो हमके बिस्वासी मिलिन, जिनखर संग हम सात रोज तक रहन, अउ आतमा सक्ति लग चेला पोलुस के यरुसलेम जाय के निता रोकय चाहथै। <verse eid="ACT 21:4"/><verse number="5" style="v" sid="ACT 21:5"/>पय उहां रुकय के अपन टेम पूर करके हम बिदा लयन अउ अपन यातरा पूर करथै, अपन डउकी अउ अपन लरकन के लइके नगर के बाहिर आइस उहां सागर हे घुटवा के बल झुक के बिनती करन। <verse eid="ACT 21:5"/><verse number="6" style="v" sid="ACT 21:6"/>तब अक दूसर लग बिदा हुइके, हम तो नाह जिहाज हे चढिन अउ अपन घर लउट गइन।<verse eid="ACT 21:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 21:7"/>सूर लग नाव दवारा लगेतार यातरा के हम पतुलिमइस हे पहुंचन, अउ भाई के सोगत के उनखर संग अक रोज रथन। <verse eid="ACT 21:7"/><verse number="8" style="v" sid="ACT 21:8"/>अगले रोज हम उहां ले चलके कैसरिया हे आय, अउ फिलिप्पुस संदेस परचारक के घर हे जउन सातठे मसे अक्ठी रथै जाय के ओखर इहां रहै। <verse eid="ACT 21:8"/><verse number="9" style="v" sid="ACT 21:9"/>ओखर चार कुमारी टोरिया रथै, जउन आगू कर बात करथै। <verse eid="ACT 21:9"/><verse number="10" style="v" sid="ACT 21:10"/>जब हम उहां बोहत रोज तक रह चुकन, ता अगबुस नाम के अक्ठी ग्यानी मनसे यहूदिया लग आथै। <verse eid="ACT 21:10"/><verse number="11" style="v" sid="ACT 21:11"/>ऊ हमार लिघ्घो आयके पोलुस के कटिबन्ध लेथै अउ अपन हाथ गोड बांध के कथै, “पवितर आतमा हइ कथै, कि जउन मनसे के हइ खलरी के पट्टा हबै, ओही यरुसलेम हे यहूदी इहैमेर लग बांधहिन अउ दूसर जातन के हाथ हे सवपहिन।”<verse eid="ACT 21:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 21:12"/>जब हइ बात सुनन, ता अउ उहां के मनसे पोलुस ले बिनती करथन कि यरुसलेम छो झइ जाय। <verse eid="ACT 21:12"/><verse number="13" style="v" sid="ACT 21:13"/>पय पोलुस जबाब दइस, “तुम काहिन कथा रोय-रोय के मोर दिल दुख करे हबै? मै तो परभु यीसु के नाम के निता यरुसलेम हे न केबल बांधे जाय के निता बरन मरै के निता तइयार हबो।”<verse eid="ACT 21:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 21:14"/>जब ऊ बात मानथै ता हम हइ गुठे के चुप हुइ गयन, परभु के इक्छा पूर होय।<verse eid="ACT 21:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 21:15"/>कुछ रोज गुजरे के बाद हम अपन समान के बान्धन अउ यरुसलेम छो चल गइन। <verse eid="ACT 21:15"/><verse number="16" style="v" sid="ACT 21:16"/>कैसरिया ले कुछ चेला हमार संग हुइ लइन, अउ हमके मनासोन नाम के साइप्रस के अक्ठी पुरान चेला के इहां लग आथै, कि हम ओखर घर हे रही।<verse eid="ACT 21:16"/></para>
  <para style="s">पोलुस के याकूब लग मुलाकात</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 21:17"/>जब हम यरुसलेम छो पहुंचिन, ता उहां के बिस्वासी भाई हमर बडा सोगत करिन। <verse eid="ACT 21:17"/><verse number="18" style="v" sid="ACT 21:18"/>अगले रोज पोलुस हम के लइ के याकूब लग मिलै गइस, जिहां सब सियान अक जिघा रथै। <verse eid="ACT 21:18"/><verse number="19" style="v" sid="ACT 21:19"/>तब पोलुस उनके सोगत करिस, जउन काम भगवान ओखर सेबा के दवारा गैर यहूदी हे करे रथै, अक्ठी -अक्ठी करके सगलू गुठेथै। <verse eid="ACT 21:19"/><verse number="20" style="v" sid="ACT 21:20"/>उन हइ सुनके भगवान के महिमा करिन फेर ओखर लग कथै, “हे भाई पोलुस, तै तो देखथस, इहां केतका गैर यहूदी हबै, जउन बिस्वास के लय हबै अउ उन नियम किताब के परति धुन लगाय हबै। <verse eid="ACT 21:20"/><verse number="21" style="v" sid="ACT 21:21"/>उन तोर बारे हे कहे गय हबै, तै गैर यहूदी के बीच रहै बाले सगलू यहूदियन के मूसा कर सिक्छा के छांड के ग्यान देथै अउ ओखर लग कथै, कि नेहको मै अपन लरकन के सुध्दिकरन करवायो अउ न रीति रिबाजन हे चली। <verse eid="ACT 21:21"/><verse number="22" style="v" sid="ACT 21:22"/>ता फेर काहिन करे जाय? मनसे जरूरी सुनहिन तै आय हबस। <verse eid="ACT 21:22"/><verse number="23" style="v" sid="ACT 21:23"/>इहैनिता जउन हम तोर लग कथन, ऊ हमार इहां चार मनसे हबै जउन मन्नत माने हबै। <verse eid="ACT 21:23"/><verse number="24" style="v" sid="ACT 21:24"/>हइ मनसेन के लइ जा अउ उनखर संग सुध्दिकरन समूह हे मिल जा अउ उनखर खरचा दइ, ताकि ऊ अपन मूड के बाल मुडवा ले, एखर लग सगलू मनसेन जान जइहिन, कि उन तोर बारे हे सुने हबै, ओहमा कउनो सही नेहको हबै, बलुक तै तो खुदय नियम के जसना जीवन जिये। <verse eid="ACT 21:24"/><verse number="25" style="v" sid="ACT 21:25"/>पय उन गैर यहूदिन के बारे हे जउन बिस्वास करथै, हम हइ निरनय करी, लिखके पठोय हबन कि उन मूरतिन के आगू बलि करे हर मांस ले अउ खून ले अउ नटेरी घोटे हर मांस ले अउ गलत काम<note caller="+" style="f"><char style="fr" closed="false">21:25 </char><char style="ft" closed="false">बेभिचार</char></note> लग बचे रहै।”<verse eid="ACT 21:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 21:26"/>हइ मेर पोलुस उन मनसेन के अपन संग लइ आनथै अउ उन मनसेन के संग खुद के अगले रोज सुध्द कर लेथै, फेर ऊ बिनती भवन हे गइस, जिहां ऊ घोसना करिस, सुध्दिकरन के रोज कब पूर होही अउ हमर मनसे हर अकझन के निता बलि कब चढय जही।<verse eid="ACT 21:26"/></para>
  <para style="s">मन्दिर हे पोलुस के पकरथै</para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 21:27"/>जब ऊ सात रोज पूर होय पर रथै, ता आसिया इलाका के कुछ यहूदी पोलुस के बिनती भवन हे देख के सब मनसेन के भिडकाथै अउ चिरलाय के ओही पकर लेथै। <verse eid="ACT 21:27"/><verse number="28" style="v" sid="ACT 21:28"/>“हे इस्राएली, मदद कर हइ उहै मनसे हबै, जउन मनसेन के अउ नियम लग अउ हइ जिघा के बिरोध हे हर जिघा सब मनसेन के सिखाथस, इहां तक कि यूनानिन के बिनती भवन हे लइके ऊ पवितर स्थान के अपवितर करे हबै।” <verse eid="ACT 21:28"/><verse number="29" style="v" sid="ACT 21:29"/>इहैनिता कथै, कि तिरिफिमुस नाम के अक्ठी इफिसी सहर हे उन ओखर संग देखत असना समझाय रथै, कि पोलुस उके बिनती भवन हे लइ गय हबै।<verse eid="ACT 21:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 21:30"/>तब सगलू सहर हे हल्लागुल्ला मच जथै अउ मनसे दउडके अक जिघा होथै अउ पोलुस के पकरके बिनती भवन के बाहिर किढलाय लानथै अउ हरबी दूरा बन्द करे गइस। <verse eid="ACT 21:30"/><verse number="31" style="v" sid="ACT 21:31"/>ऊ उके मारै के सोचत रथै, कि रोमी सिपाही के सेना नायक के लिघ्घो हइ संदेस पहुंचिस कि सगलू यरुसलेम हे खलबली मच गइस। <verse eid="ACT 21:31"/><verse number="32" style="v" sid="ACT 21:32"/>ऊ हरबी बाद सिपाही अउ सेना के अधिकारिन के अपन संग लइस अउ पोलुस हे हमला करै बाले यहूदियन के पल्ला बढिन, यहूदियन जब ऊ सेना नायक अउ सिपाही के देखिस ता उन पोलुस के पीटै के बन्द के देथै। <verse eid="ACT 21:32"/><verse number="33" style="v" sid="ACT 21:33"/>तब सेना नायक पोलुस के लिघ्घो आइस अउ बन्दी बनाय लइस। ऊ उके दुइ सांकड हे बान्ध देय के आदेस देथै, फेर ऊ पूछथै, कि ऊ कउन हबै अउ ऊ काहिन करे हबै? <verse eid="ACT 21:33"/><verse number="34" style="v" sid="ACT 21:34"/>पय भीड मसे कउ कुछ चिल्लात रथै। जब हल्ला गुल्ला के मारे ऊ निक्खा सच्चाई नेहको जान सकथै, ता उके गढ हे लइ जाय के आदेस देथै। <verse eid="ACT 21:34"/><verse number="35" style="v" sid="ACT 21:35"/>जब पोलुस सीढी के लिघ्घो पहुंचथै, ता असना होथै कि भीड के दबाव के मारे सुपाहिन के उठाय के लइ जाय पडथै। <verse eid="ACT 21:35"/><verse number="36" style="v" sid="ACT 21:36"/>काखे मनसेन के भीड हइ चिरलात ओखर पाछू पडे रथै, “ओही मार डाला।”<verse eid="ACT 21:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 21:37"/>जब ऊ अंगना के भित्तर लइ जाय बाले रथै, कि पोलुस सेनापति के सरदार लग पूछथै, का तै यूनानी भासा जानथस? <verse eid="ACT 21:37"/><verse number="38" style="v" sid="ACT 21:38"/>तै मिस्री तो नेहको, जउन कुछ टेम पहिले बिद्रोह सुरु करवाय रहस अउ जउन हइ रेगिस्थान हे चार हजार अतंकवादी के मदद करथै।<verse eid="ACT 21:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 21:39"/>पोलुस कथै, “मै किलिकिया के तरसुस सहर के रहै बाले यहूदी यहों अउ अक्ठी परसिध्द सहर के रहै बाले यहों। मै तोर लग चाहथो, कि तै मोके इनखर बीच बोलन दे।”<verse eid="ACT 21:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 21:40"/>जब ऊ आदेस दिहिस, ता पोलुस सीढी हे ठाड हुइके मनसेन के हाथ ले इसारा करथै। जब उन चुप हुइ जथै ता ऊ इब्रानी भासा हे गुठे लागथै।<verse eid="ACT 21:40"/></para>
  <chapter eid="ACT 21"/>
  <chapter number="22" style="c" sid="ACT 22"/>
  <para style="s">भीड के आगू पोलुस के भासड</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 22:1"/>पोलुस कथै, “हे मोर यहूदी भाई अउ संगी जसना सज्जन मनसे मोर बचाव हे मोके जउन कुछु कहै का हबै उके सुना।” <verse eid="ACT 22:1"/><verse number="2" style="v" sid="ACT 22:2"/>उन हइ सुनिन कि ऊ हमर ले इब्रानी भासा हे कथै, ता उन चुप हुइ गइन, पोलुस कथै।<verse eid="ACT 22:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 22:3"/>मै अक्ठी यहूदी मनसे हबो, जउन किलिकिया के तरसुस हे मोर पइदाइस हुइस, पय हइ सहर हे गमलीएल के गोड लिघ्घो बइठ के हमर सियानन के नियमन के जसना बडी कडाइ के संग सिक्छा पाय हव, भगवान के परति मै बडा समरपित रहों, जसना आज तुम सबझन हबा। <verse eid="ACT 22:3"/><verse number="4" style="v" sid="ACT 22:4"/>मै डउका अउ डउकिन के बांध के अउ जेल हे डालके, इस परभु के रास्ता बाले के इहां तक सतायों कि उनके मरवाउ डालो। <verse eid="ACT 22:4"/><verse number="5" style="v" sid="ACT 22:5"/>खुदय महा पुजारी अउ सियानन के सगलू हइ बात के गवाह हबै, मै दमिस्क हे इनखर भाई के नाम उनखर लग चिट्ठी लयो, अउ परभु के रास्ता बाले समूह के उहां रहै बाले मनसेन के पके के बन्दी के रूप हे यरुसलेम लामै के निता मै गय रथो, ता उनही सजा दिलाय सको।<verse eid="ACT 22:5"/></para>
  <para style="s">पोलुस अपन हिरदय परिवरतन के बारे हे गुठेथै</para>
  <para style="r">(<ref loc="ACT 9:1-19">प्रेरितो 9:1-19</ref>; <ref loc="ACT 26:12-18">26:12-18</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 22:6"/>जब मै रेंगत-रेंगत दमिस्क के लिघ्घो पहुंचो, ता असना हुइस कि दुपहरी के टेम अक्ठी बडी उजियार बादर ले मोर चउगिरदा पल्ला चमकथै। <verse eid="ACT 22:6"/><verse number="7" style="v" sid="ACT 22:7"/>अउ मै भुंइ हे गिर पडो अउ हइ आरो सुना, हे साऊल, हे साऊल तै मोके काखे सताथस? <verse eid="ACT 22:7"/><verse number="8" style="v" sid="ACT 22:8"/>मै जबाब दयों, हे परभु तै कोहर आस ऊ मोके जबाब दिहिस, मै यीसु नासरी हबो, जेही तै सताथस। <verse eid="ACT 22:8"/><verse number="9" style="v" sid="ACT 22:9"/>मोर संगिन उजियार तो देखिन, पय जउन मोर लग गुठेथै ओखर सब्द के नेहको सुना। <verse eid="ACT 22:9"/><verse number="10" style="v" sid="ACT 22:10"/>तब मै कथो, हे परभु मै का करव? परभु मोर लग कथै, ठाढ हुइ जा अउ दमिस्क हे जा, उहां तोके सगलू बात गुठेही, जेही करै के निता चुने गय हबै। <verse eid="ACT 22:10"/><verse number="11" style="v" sid="ACT 22:11"/>जब ऊ उजियार के तेज के मारे मोके कुछु दिखाई नेहको देथै, ता मै अपन संगिन के हाथ पकरे हर दमिस्क हे आथै।<verse eid="ACT 22:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 22:12"/>उहां सहर हे हनन्याह नाम के अक्ठी मनसे रथै, ऊ नियम के पालन करै बाले अक्ठी भक्त रथै, उहां के रहै बाले सगलू यहूदिन के संग उनखर अच्छी बोल चाल रथै। <verse eid="ACT 22:12"/><verse number="13" style="v" sid="ACT 22:13"/>अउ ठाढ हुइके मोर ले कथै, हे भाई साऊल, फेर देखै लग, उहै टेम मोर आंखी उघर गइस अउ मै उके देखो। <verse eid="ACT 22:13"/><verse number="14" style="v" sid="ACT 22:14"/>तब ऊ कथै, हमार दादा के भगवान मोके इहैनिता चुने हबै, कि तै ओखर इक्छा के जानय, ऊ अक्ठिन धरमी के देखय अउ ओखर मुंह ले बात सुनय। <verse eid="ACT 22:14"/><verse number="15" style="v" sid="ACT 22:15"/>काखे तै ओखर तरफ ले सगलू मनसेन के आगू उन बातन के गवाह होही जउन तै देखे अउ सुने हबस। <verse eid="ACT 22:15"/><verse number="16" style="v" sid="ACT 22:16"/>इहैनिता तय, अब देर झइ के ठाढ हुइ जा, बतिस्मा लइ ले अउ ओखर नाम पुकारत अपन पाप के धोय डार।<verse eid="ACT 22:16"/></para>
  <para style="s">गैर यहूदी हे परचार के बिनती</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 22:17"/>“फेर असना हुइस कि जब मै यरुसलेम छो लउट के बिनती भवन हे बिनती करत रथो, तबय मै दरसन मै देखो। <verse eid="ACT 22:17"/><verse number="18" style="v" sid="ACT 22:18"/>अउ ओही देखथै कि ऊ मोर लग कथै, हरबी करके यरुसलेम ले हरबी निकर जा, काखे ऊ मोर बारे हे तोर गवाही नेहको मानही। <verse eid="ACT 22:18"/><verse number="19" style="v" sid="ACT 22:19"/>हे परभु ऊ तो खुदय जानथस कि मै तोर हे बिस्वास करय बाले के जेल हे बेडथै अउ यहूदी मंडली हे पिट लगवाथै। <verse eid="ACT 22:19"/><verse number="20" style="v" sid="ACT 22:20"/>जब तोर गवाह स्तिफनुस के खून बहोय जथै, तब मै समरथन करै के उहै ठाढ रथो, जउन ओखर खून करे रथै, मै ओखर बन्डी के देख रेख करत रहों। <verse eid="ACT 22:20"/><verse number="21" style="v" sid="ACT 22:21"/>अउ ऊ मोर ले कथै, कढ जा काखे मै तोर गैर यहूदिन के लिघ्घो दुरिहां पठोहूं।”<verse eid="ACT 22:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 22:22"/>हइ बात सुनत रहै, ता फेर ऊंच आरो हे पुकार के चिल्लाय उठिस, असना मनसे जिन्दा के काबिल नेहको एही भुंइ लग मिटा के, उके मार डारा। <verse eid="ACT 22:22"/><verse number="23" style="v" sid="ACT 22:23"/>जब ऊ चिरलात अउ बन्डी फेकै अउ बादर अउ आकास हे धूधुर उडाथै <verse eid="ACT 22:23"/><verse number="24" style="v" sid="ACT 22:24"/>तब सेनापति सरदार आदेस देथै, कि पोलुस के अकेले हे लइ जाय, ऊ कथै, कि कोडा लगाय-लगाय के ओखर लग पूछ तांछ करे जाय, ताकि पता होय कि ओखर उप्पर मनसेन के हइ मेर चिल्लाय का कारन हबै। <verse eid="ACT 22:24"/><verse number="25" style="v" sid="ACT 22:25"/>पय जब ऊ कोडा लगामै के निता बांधिन, तब उहां ठाढ सिपाही पोलुस लग कथै, “कउनो रोमी नागरिक के, जउन अपराधी नेहको पाय गय होय, कोडा लगामै का तुम्हार निता उचित हबै।”<verse eid="ACT 22:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 22:26"/>हइ सुनके अधिकारी सिपाही के लिघ्घो गइस अउ बोलिस, “तय के करथस? काखे हइ तो रोमी नागरिक हबै”<verse eid="ACT 22:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 22:27"/>तब पलटन के सरदार ओखर लिघ्घो आयके कथै, “मोके गुठे का तै रोमी हबस?” ऊ कथै, “हव।”<verse eid="ACT 22:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 22:28"/>हइ बात हे सिपाही जबाब देथै, हइ नागरिकता के पामै लग, मोके बोहत पइसा खरचा करै का पडे हबै, पोलुस कथै पय मै तो पइदाइसी रोमी नागरिक यहों।<verse eid="ACT 22:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 22:29"/>जउन मनसे ओखर पूछ तांछ करै के कथै, हरबी पाछू हट गइन अउ ऊ सिपाही हइ समझ के कि ऊ अक्ठी रोमी नागरिक हबै अउ ऊ उके बांधे हबै, बोहत डेराय गइन।<verse eid="ACT 22:29"/></para>
  <para style="s">यहूदी आगू पोलुस कर बात</para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 22:30"/>काखे ऊ सेनापति हइ बात के सही-सही पता लगामै चाहथै, कि यहूदियन पोलुस हे आरोप काखे लगाइन, इहैनिता ऊ अगले रोज ओखर बंधन खोल दइस। फेर खास परधान याजक अउ उच्च यहूदी पंचायत के बुलउवा पठोइस अउ पोलुस के उनखर आगू लायके टाड के दइस।<verse eid="ACT 22:30"/></para>
  <chapter eid="ACT 22"/>
  <chapter number="23" style="c" sid="ACT 23"/>
  <para style="p">
    <verse number="1" style="v" sid="ACT 23:1"/>पोलुस महासभा के पल्ला सिध्धा देखके कथै, हे भाइयो मै आज तक भगवान के निता बिलकुन निक्खा सोंच लग जीवन गुजारे हव। <verse eid="ACT 23:1"/><verse number="2" style="v" sid="ACT 23:2"/>एहमा महायाजक हनन्याह पोलुस के लिघ्घो ठाड मनसेन के आदेस देथै कि ओखर गाल हे अक झापड मारै। <verse eid="ACT 23:2"/><verse number="3" style="v" sid="ACT 23:3"/>तब पोलुस उनखर लग कथै, अगर चरका पोतररे हर भीठी तोर उप्पर भगवान के मार पडही, तै इहां जुगाड के नियम के जसना मोर कसना नियाव करै के बइठे हबस, कि तै नियम के बिरोध हे मोके झापड मारै के आदेस देथस।<verse eid="ACT 23:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 23:4"/>जउन पोलुस के लिघ्घो ठाड मनसेन लग कथै, भगवान के महायाजक बेज्जती करै के हिम्मत तोके कसके हुइस?<verse eid="ACT 23:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 23:5"/>पोलुस जबाब देथै, “मोर इस्राएली भाइयो मोके पता नेहको कि हइ महा पुजारी हबै। काखे किताब हे लिखवरे हबै, तै अपन परजा के सरदार के निता नेहको बोलै चाहे।”<verse eid="ACT 23:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 23:6"/>तब पोलुस के पता चलिस कि उनखर लग कुछ मनसे सदूकी हबै, अउ आधा फरीसी ता पंचायत के बीच ऊ बोहत आरो हे कहिस, हे भाई मै फरीसी यहों, अक्ठी फरीसी के टोरवा यहों, मिरतू के बाद फेरै लग जी उठै के परति मोर आसा के कारन मोर उप्पर केस चलाय गइस।<verse eid="ACT 23:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 23:7"/>ओखर असना कहै लग फरीसी अउ सदूकियन हे अक्ठी बिबाद खडा हुइ जथै अउ पंचायत के बीच फूट पडा। <verse eid="ACT 23:7"/><verse number="8" style="v" sid="ACT 23:8"/>सदूकी हइ कथै, कि फेरै लग जिन्दा नेहको होथै अउ न स्वरगदूत होथै अउ न ही आतमा, पय फरीसी हइ बिस्वास करथै। <verse eid="ACT 23:8"/><verse number="9" style="v" sid="ACT 23:9"/>तब बोहत हल्ला मच गइस, अउ कुछ गुरू जउन फरीसिन के समूह मसे कुछ धरमी मनसे उठिन अउ कडाइ बात कहै लगिस, “हइ मनसे हे हम कउनो गलती नेहको पाथन, अगर कउनो आतमा कउनो स्वरगदूत एखर लग बात करे हबै, ता एखर लग कह?”<verse eid="ACT 23:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 23:10"/>काखे हइ बिबाद सुरु हुइ चुकथै, ता एखर लग सेनापति के सरदार डर गइस कि कहुं ऊ पोलुस के खन्डा-खन्डा झइ के डारै, इहैनिता ऊ सिपाहिन के आदेस देथै, कि ऊ तरी जायके पोलुस के उनखर लग अलगे करके भित्तर छो लइ जाय।<verse eid="ACT 23:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 23:11"/>उहै रात परभु पोलुस के लिघ्घो ठाड हुइके कथै, हे पोलुस हिम्मत रख काखे जसना तै यरुसलेम हे मोर गवाही दय हबस, उहै मेर रोम हे मोर गवाही देय का होही।<verse eid="ACT 23:11"/></para>
  <para style="s">पोलुस के मारै के जुगाड</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 23:12"/>दूसर रोज सुबेन्नेन कुछ यहूदी अक्ठी साजिस बनाइस अउ उन किरिया लइन कि जब तक पोलुस के मार नेहको डारी, तब तक न कुछु खउब न पीयब। <verse eid="ACT 23:12"/><verse number="13" style="v" sid="ACT 23:13"/>जउन मनसे हइ जुगाड बनाथै, उन चालीस लग बोहत रथै। <verse eid="ACT 23:13"/><verse number="14" style="v" sid="ACT 23:14"/>ऊ खास याजक अउ सियानन के लिघ्घो गइन अउ बोलिन, अउ हम किरिया खाय हम कि जब तक पोलुस के मार नेहको डारी, तब न हम खउब न पीयब। <verse eid="ACT 23:14"/><verse number="15" style="v" sid="ACT 23:15"/>अब तुम अउ यहूदी पंचायत सेनापति लग कहा, कि उके तुम्हर लिघ्घो लइ आइन, हइ बहाना बनाउत तुम ओखर बारे हे अउ अच्छी तरह लग पूछ तांछ करै के चाहथा। एखर लग आगुन ऊ इछो पहुंचै, हम उके मार डारै के तइयार हबन।<verse eid="ACT 23:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 23:16"/>पय पोलुस के बेहन के टोरवा जब हइ साजिस के बारे हे सुनिस ता, किला हे जायके पोलुस के सगलू बात गुठे देथै। <verse eid="ACT 23:16"/><verse number="17" style="v" sid="ACT 23:17"/>इस पर पोलुस कउनो अक्ठी अधिकारी के बुलाय के ओखर लग कथै, हइ जबान के सिपाही के लिघ्घो लइ जा, काखे इके ओखर कुछु कहै के हबै। <verse eid="ACT 23:17"/><verse number="18" style="v" sid="ACT 23:18"/>इहैनिता ऊ उके सेनापति के लिघ्घो लइ गइस अउ बोलिस जेलर पोलुस मोके बुलाय के बिनती करिस कि हइ जबान के तोर लिघ्घो पहुंचामै के कथै, काखे ऊ तोर लग कहेके चाहथै।<verse eid="ACT 23:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 23:19"/>सिपाही ओखर हाथ पकरके अउ अलगे लइ जाय के पूछथै तै मोर ले काहिन गुठेमै चाहथस।<verse eid="ACT 23:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 23:20"/>ऊ कथै यहूदी साजिस बनाय हबै, कि तोर लग बिनती करै कि पोलुस के पंचायत हे लाय कि मानो ऊ अउ निक्खा ओखर जांच करै चाहथै। <verse eid="ACT 23:20"/><verse number="21" style="v" sid="ACT 23:21"/>काखे बोहत मनसे घात लगाय उके ओरगथै, उन हइ किरिया खाय हबै, कि जब तक उके मार न लइ तब तक न खाबे न पियब, बस तोर अनुमति के परतिक्छा हे उन बइठे हबै।<verse eid="ACT 23:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 23:22"/>फेर सिपाही जबान के हइ आदेस दइके पठोय देथै, तै हइ कउनो के झइ बताबे कि तै मोके एखर जानकारी दय हबस।<verse eid="ACT 23:22"/></para>
  <para style="s">पोलुस के फेलिक्स के लिघ्घो पठोथै</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 23:23"/>फेर सिपाही अपन सेना नायक के बुलाय के कथै, दुइ सव सिपाही, सत्तर घोडवा अउ दो सव भाला बालेन के कैसरिया जाय के निता तइयार रखा। रात के नव बजे निकरै के निता तइयार रहबे। <verse eid="ACT 23:23"/><verse number="24" style="v" sid="ACT 23:24"/>अउ पोलुस के सबारी के निता घोडवा तइयार रखा, कि उके फेलिक्स हाकिम के लिघ्घो सान्ति ले पहुंचा देय। <verse eid="ACT 23:24"/><verse number="25" style="v" sid="ACT 23:25"/>तब पोलुस सिपाही के अक्ठी चिट्ठी लिखिस। <verse eid="ACT 23:25"/><verse number="26" style="v" sid="ACT 23:26"/>महामहिम फेलिक्स हाकिम के क्लोदियुस लूसियास के नमस्ते। <verse eid="ACT 23:26"/><verse number="27" style="v" sid="ACT 23:27"/>हइ मनसे के यहूदी पके लेथै अउ ऊ उके मारै बाले रथै, कि मै हइ जानके कि हइ अक्ठी रोमी नागरिक हबै, ता अपन सिपाही के संग जायके छंडाय लायो। <verse eid="ACT 23:27"/><verse number="28" style="v" sid="ACT 23:28"/>मै जानै चाहत रहों कि ओखर कउन कारन दोस लगाथै इहैनिता उनखर महासभा हे लइ गइन। <verse eid="ACT 23:28"/><verse number="29" style="v" sid="ACT 23:29"/>तब मै जान लयो कि ऊ अपन नियम के बिबादन के बारे हे ओखर हे दोस लगाथै, पय मार डारै जाय या बांधे जाय के ओग ओहमा कउनो दोस नेहको। <verse eid="ACT 23:29"/><verse number="30" style="v" sid="ACT 23:30"/>फेर जब मोके जानकारी मिलिस कि उहां हइ मनसे के बिरोध हे अउ कउ साजिस रचे हबै, ता मै इके हरबी तोर लिघ्घो पठोय दय हव। अउ एखर उप्पर आरोप लगामै बालेन के हइ आदेस दइ देथै, कि एखर बिरोध लगाय गय अपन आरोप के तोर आगू रखै।<verse eid="ACT 23:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 23:31"/>मतलब जसना सिपाहिन के आदेस दय गय रथै, ओसनेन पोलुस के लइके रात हे अन्तिपतरिस हे लइ आनथै। <verse eid="ACT 23:31"/><verse number="32" style="v" sid="ACT 23:32"/>दूसर रोज ऊ घुडसवारन के पोलुस के संग जाय दइस अउ उन खुदय किला के लउट आथै। <verse eid="ACT 23:32"/><verse number="33" style="v" sid="ACT 23:33"/>उन कैसरिया पहुंचे हाकिम के चिट्ठी दइस अउ पोलुस के ओखर लिघ्घो ठाड करिस। <verse eid="ACT 23:33"/><verse number="34" style="v" sid="ACT 23:34"/>राजपाल चिट्ठी पढिस अउ पोलुस लग पूछिस कि कउन परदेस के रहै बाले हबै, जब उके पता चलिस कि ऊ किलिकिया के रहै बाले आय। <verse eid="ACT 23:34"/><verse number="35" style="v" sid="ACT 23:35"/>ता ऊ ओखर लग कथै, तोर उप्पर आरोप लगाय बाले जब आ जइहिन, मै तबै तोर सुनवाइ करहों, ऊ आदेस देथै कि पोलुस के सुरक्छा के भित्तर हेरोदेस के घर हे रखे जाय।<verse eid="ACT 23:35"/></para>
  <chapter eid="ACT 23"/>
  <chapter number="24" style="c" sid="ACT 24"/>
  <para style="s">पोलुस के बिरुध मुकदमा</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 24:1"/>पांच दिन बाद हनन्याह महा पुजारी कुछ सियान नेता अउ तिरतुल्लुस नाम के अक्ठी बकील के पंचायत लइके कैसरिया आइस ऊ राजपाल के आगू पोलुस के बिरुध निबेदन चिट्ठी परस्तुत करिस। <verse eid="ACT 24:1"/><verse number="2" style="v" sid="ACT 24:2"/>फेर फेलिक्स के आगू पोलुस के पेसी के कारवाही सुरु करत, तिरतुल्लुस नाम के अक्ठी बकील बोलिस, हे महोदय फेलिक्स तुम्हर कारन बडे सान्ति के संग जथै, अउ तुम्हर दुरिहां के कारन सेम हे बोहत लग कइठे सुधार होय हबै। <verse eid="ACT 24:2"/><verse number="3" style="v" sid="ACT 24:3"/>एही हम हर जिघा अउ हर मेर लग धन्यबाद के संग मानथन। <verse eid="ACT 24:3"/><verse number="4" style="v" sid="ACT 24:4"/>मै तुम्हर लग अउ बोहत टेम न लेत मोर बिनती हबै कि किरपा संछिप्त हे सुन ले। <verse eid="ACT 24:4"/><verse number="5" style="v" sid="ACT 24:5"/>हमर सोच हबै कि हइ मनसे संक्रामक नंगहा के जसना हबै, हइ दुनिया भर के सगलू यहूदिन हे आंदोलन करत फिरथै, अउ नासरी कुपंथ के मुखिया हबै। <verse eid="ACT 24:5"/><verse number="6" style="v" sid="ACT 24:6"/>ऊ बिनती भवन के अपवितर करै के चाहथै, पय हम इके पकरे हवन। हम उके अपन नियाव के जसना दंड दय होते <verse eid="ACT 24:6"/><verse number="7" style="v" sid="ACT 24:7"/>पय सेनापति लूसियास आयके इके बडी परेसानी लग हमर हाथ लग झटक लइस अउ हइमेर दोस लगामै बाले के आदेस दइस कि उन तोर आगू उपस्थित होय। <verse eid="ACT 24:7"/><verse number="8" style="v" sid="ACT 24:8"/>अउ हमके तोर आगू अपन आरोप परस्तुत होय के आदेस देथै, कि तै खुद स्थिति के जांच के हइ सगलू अरोपन लग सबंधित सच्चाई के जान सकै। <verse eid="ACT 24:8"/><verse number="9" style="v" sid="ACT 24:9"/>हइ अरोप हे यहूदी सामिल हुइ गइन, ऊ द्रढता के संग कथै, कि हइ सब बात सही हबै।<verse eid="ACT 24:9"/></para>
  <para style="s">फेलिक्स के लिघ्घो पोलुस कर बचाव</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 24:10"/>फेर राजपाल जब पोलुस के बोलै के लिता इसारा करिस ता ऊ जबाब देत कथै, तै बोहत साल लग हइ देस के न्यायधीस हबै, हइ जानथै कि मै खुसी के संग अपन बचाव प्रस्तुत करथो। <verse eid="ACT 24:10"/><verse number="11" style="v" sid="ACT 24:11"/>तै खुद जान सकथस कि तोर निता यरुसलेम हे अबे आराधना करै के निता यरुसलेम आयों, बारह रोज लग अधिक नेहको हुइस। <verse eid="ACT 24:11"/><verse number="12" style="v" sid="ACT 24:12"/>उहां बिनती भवन हे न आराधना हे, न सहर हे, अउ न मनसेन के भडकाउत पाय हबै। <verse eid="ACT 24:12"/><verse number="13" style="v" sid="ACT 24:13"/>अउ न तो उन बातन के, जेखर उन अब मोर हे दोस लगाथै, तोर आगू सही परमाडित नेहको के सकथै। <verse eid="ACT 24:13"/><verse number="14" style="v" sid="ACT 24:14"/>पय तोर आगू हइ स्वीकार करथो, कि मै अपन पुरखन के रास्ता हे चल के भगवान के सेबा करथो, मै ऊ बात हे बिस्वास करथो, जेही मूसा कर नियम बताथै अउ जउन ग्यानी मनसेन के किताब हे लिखवरे हर हबै। <verse eid="ACT 24:14"/><verse number="15" style="v" sid="ACT 24:15"/>अउ भगवान लग आसा हबै ओसनेन बिस्वास करथो, जसना हइ मनसे रथै, कि धरमी अउ बेकार दुनोन के मिरतू हे जिलाय जइहिन। <verse eid="ACT 24:15"/><verse number="16" style="v" sid="ACT 24:16"/>इहैनिता महुं भगवान अउ मनसेन के आगू सब रोज अपन सोंच के सुध्द बनाय रखै के निता परयास करत रथो।<verse eid="ACT 24:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 24:17"/>अउ बोहत साल के बाद मै यरुसलेम हे अपन गरीब मनसेन के दान पहुंचामै, अउ भेंट चढामै आय रहों। <verse eid="ACT 24:17"/><verse number="18" style="v" sid="ACT 24:18"/>आसिया के कुछ यहूदी मोके सुध्द दसा हे बिनती भवन के भित्तर हइ सब करत पाइस, मोर संग न कउनो भीड रथै अउ न उहां कउनो उपद्रव होथै। <verse eid="ACT 24:18"/><verse number="19" style="v" sid="ACT 24:19"/>आसिया लग आय कुछ यहूदी उहां मउजूद रथै, अगर मोर बिरुध उनखर लिघ्घो कुछु हबै ता उनके तोर आगू उपस्थित हुइके आरोप लगामै चाही। <verse eid="ACT 24:19"/><verse number="20" style="v" sid="ACT 24:20"/>या हइ मनसे जउन इहां हबै उन बतामै कि जब मै यहूदी महासभा के आगू ठाढ रथो, तब उन मोर हे का खोट पाइस। <verse eid="ACT 24:20"/><verse number="21" style="v" sid="ACT 24:21"/>हव अक्ठी बात जरूरी हुइस कि मै उनखर बीच ठाढ हुइके ऊंच आरो लग हइ कथै, मिरतू के फेरै जिन्दा के बारे हे आज तै मनसेन के आगू मोर हे मुकदमा चलाथस।<verse eid="ACT 24:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 24:22"/>फेलिक्स के हइ रास्ता के बारे हे अच्छी जानकारी रथै, ऊ सुनवाइ रोक देथै अउ यहूदी धरमी मनसे लग कथै, सेना नायक लूसियास के आय लग मै तुम मनसेन के मुकदमा के फइसला करहुं। <verse eid="ACT 24:22"/><verse number="23" style="v" sid="ACT 24:23"/>ऊ सिपाहिन के आदेस दइस कि पोलुस के पहरे हे धरे जाय, पय उनही कुछु आजाद रहै के अउ उनखर संगी हे कउनो उनखर सेबा परचार करै लग झइ रोके जाय।<verse eid="ACT 24:23"/></para>
  <para style="s">फेलिक्स अउ द्रुसिल्ला के आगू पोलुस</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 24:24"/>कुछ रोज के बाद फेलिक्स अपन डउकी द्रुसिल्ला के, जउन यहूदनी रथै, संग लइके आथै अउ पोलुस के बुलवाय के ऊ बिस्वास के बारे हे जउन मसीह यीसु हे हबै, बात सुनिस। <verse eid="ACT 24:24"/><verse number="25" style="v" sid="ACT 24:25"/>पय जब पोलुस नियाइपन अच्छाई, आत्म संयम अउ आय बाले नियाव के बारे हे बोलथै, ता फेलिक्स डर गइस अउ बोलिस, “हइ टेम तै कढ जा मउका मिलत हे मै तोके फेरै बुलइहो।” <verse eid="ACT 24:25"/><verse number="26" style="v" sid="ACT 24:26"/>उहै टेम उके हइ आसा रथै, कि पोलुस उके कुछु पइसा देही, इहैनिता फिलिक्स पोलुस लग बात चीत करै के निता बेर-बेर बुलाथै।<verse eid="ACT 24:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 24:27"/>दुइ साल असना बीत जाय के बाद फेलिक्स के जिघा पुरकियुस, फेस्तुस स्वीकार के लेथै, काखे फेलिक्स यहूदिन के खुस रखै के चाहथै, इहैनिता ऊ पोलुस के जेल हे बनाय के रख देथै।<verse eid="ACT 24:27"/></para>
  <chapter eid="ACT 24"/>
  <chapter number="25" style="c" sid="ACT 25"/>
  <para style="s">पोलुस के राजपाल के आगू परस्ताव</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 25:1"/>फेस्तुस ऊ परदेस हे पहुंचै के तीसर रोज बाद कैसरिया ले यरुसलेम के गइस। <verse eid="ACT 25:1"/><verse number="2" style="v" sid="ACT 25:2"/>उहां खास पुजारी अउ यहूदिया के मुखिया पोलुस के बिरुध लगाय गय आरोप ओखर आगू रखिन अउ ओखर लग बिनती करिन। <verse eid="ACT 25:2"/><verse number="3" style="v" sid="ACT 25:3"/>ऊ फेस्तुस लग हइ निबेदन करिस, कि ऊ पोलुस के यरुसलेम बुलामै के अनुगरह किरपा करै, काखे ऊ गली हे पोलुस के मार डालै के जुगाड बनाथै। <verse eid="ACT 25:3"/><verse number="4" style="v" sid="ACT 25:4"/>फेस्तुस जबाब देथै, “पोलुस कैसरिया हे बन्दी हबै अउ मै खुद हरबी उहां जाय बाले हबो।” <verse eid="ACT 25:4"/><verse number="5" style="v" sid="ACT 25:5"/>फेर कथै, “तुम्हर हे जउन हक रखथै उन संग चलै अउ अगर ऊ मनसे कउनो अपराध करे हबै, ता ऊ उहां ओखर उप्पर अरोप लगाय।”<verse eid="ACT 25:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 25:6"/>फेस्तुस कउ आठ दस रोज उनखर बीच हे रहिके कैसरिया छो कढ गइस, अउ अगले रोज अदालत हे नियाव सिहासन हे बइठके ऊ आदेस दइस कि पोलुस के ओखर आगू लाय जाय। <verse eid="ACT 25:6"/><verse number="7" style="v" sid="ACT 25:7"/>जब पोलुस उहां पहुंचथै, ता ऊ यहूदी जउन यरुसलेम लग आय रथै, यहूदी उके घेर के ठाड हुइ गइन, उन ओखर उप्पर बोहत आरोप लगाइन, पय ऊ साबित नेहको के सकिन। <verse eid="ACT 25:7"/><verse number="8" style="v" sid="ACT 25:8"/>पय पोलुस खुद के बचाव करत कथै, “मै यहूदिन के बिरोध हे कुछु अपराध नेहको करे यहों, न बिनती भवन के खिलाप हे अउ न कैसर के बिरोध हे।”<verse eid="ACT 25:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 25:9"/>पय फेस्तुस यहूदी साहबन के मगन करै चाहथै, इहैनिता जबाब हे ऊ पोलुस लग कथै, “का तै यरुसलेम जाय के चाहथस? ता मै उहां तोर उप्पर लगाय गय हइ आरोप के नियाव के सको।”<verse eid="ACT 25:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 25:10"/>पोलुस कथै, हइ टेम “मै कैसर रोमन राजपाल नियाव के आगू ठाड हव। मोर नियम इहां होयके चाही, मै यहूदिन के संग बुरा नेहको करे यहों, इके तै बोहत अच्छी मेर लग जानथस। <verse eid="ACT 25:10"/><verse number="11" style="v" sid="ACT 25:11"/>अगर मै कउनो अपराध के दोसी हव अउ मै कुछ असना करे हव, जेखर सजा मिरतू हबै ता मै मरै लग बचै नेहको चइहो, पय अगर हइ मनसे मोर उप्पर जउन आरोप लगाय गइस, ओहमा कउनो सही नेहको हबै, ता मोके कउनो उनके नेहको सउप सकथै। इहै कैसर रोमन राजपाल लग मोर बिनती हबै।”<verse eid="ACT 25:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 25:12"/>फेस्तुस अपन पंचायत सदस्यन लग सलाह लइस अउ जबाब देथै, “तै कैसर रोमन राजपाल लग फेरै बिनती करे हबस, इहैनिता तोके ओखर आगू लइ जाय जही।”<verse eid="ACT 25:12"/></para>
  <para style="s">पोलुस के अग्रिप्पा के आगू पेसी</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 25:13"/>कुछ रोज गुजरै के बाद अग्रिप्पा राजा अउ ओखर बेहन बिरनीके राजपाल फेस्तुस लग मुलाखात करै कैसरिया हे आइस। <verse eid="ACT 25:13"/><verse number="14" style="v" sid="ACT 25:14"/>जब ऊ उहां कइ रोज गुजर चुकिस, ता फेस्तुस राजा के आगू पोलुस के केस के हइ मेर समझाइस, “इहां अक्ठी असना मनसे हबै, जेही फेलिक्स जेलियर के रूप हे छांडे गय रथै। <verse eid="ACT 25:14"/><verse number="15" style="v" sid="ACT 25:15"/>जब मै यरुसलेम हे रथै, ता परधान पुजारी अउ यहूदी सियान ओखर बिरोध के मोके खबर देथै अउ निबेदन करिन कि उके सजा दय जाय। <verse eid="ACT 25:15"/><verse number="16" style="v" sid="ACT 25:16"/>पय रोमी हे असना नियम नेहको हबै कि कउनो मनसे के जब तक प्रतक्छय रूप लग आमने सामने न ठाड करे जाय अउ ओखर उप्पर लगाय गय अरोप लग उके बचै का मउका झइ दय जाय, उके सजा के निता सउपे जाय। <verse eid="ACT 25:16"/><verse number="17" style="v" sid="ACT 25:17"/>इहैनिता उन मनसे जब मोर संग इहां आइन ता मै बिगर देरी करे, अगले रोज न्याय आसन हे बइठ के ऊ मनसे के लामै के आदेस दयों। <verse eid="ACT 25:17"/><verse number="18" style="v" sid="ACT 25:18"/>जब ओखर उप्पर दोस लगामै बाले बोलै के ठाड हुइन ता उन ओखर उप्पर अइसन कउ दोस नेहको लगाइन, जसना कि मै सोचत रहों। <verse eid="ACT 25:18"/><verse number="19" style="v" sid="ACT 25:19"/>बलुक उन अपन धरमी के कुछ बातन हे अउ यीसु के नाम के अक्ठी मनसे हे जउन मर चुके हबै, उनखर हे कुछ बैर के चरचा करथै, पय पोलुस के दाबा हबै, कि ऊ जिन्दा हबै। <verse eid="ACT 25:19"/><verse number="20" style="v" sid="ACT 25:20"/>मोर समझ हे नेहको आइस कि हइ बातन के छानबीन कसके करे जाय इहैनिता मै पोलुस लग पूछो कि का तै यरुसलेम जाय चाहथस, जेखर लग उहां हइ बातन के बारे हे तुम्हर नियाव करे जाय। <verse eid="ACT 25:20"/><verse number="21" style="v" sid="ACT 25:21"/>पय पोलुस जब बिनती करी कि उके कैसर रोमन राजपाल के नियाव के निता उहां धरे जाय ता मै आदेस दयों, कि मै जब तक उके कैसर रोमन राजपाल के लिघ्घो नेहको पठोय देहुं उके इहै धरे जाय।”<verse eid="ACT 25:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 25:22"/>हइ बात हे अग्रिप्पा फेस्तुस लग कथै, हइ मनसे के सुनवाइ मै खुदय करै चाहथो, “फेस्तुस कथै, तै उके कल सुन लइहे।”<verse eid="ACT 25:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 25:23"/>इहैनिता अगले रोज अग्रिप्पा अउ बिरनीके बडी पहिन ओढ के संग आइस, अउ उन सेनापति के अउ सहर के खास मनसे के संग पंचायत भवन हे गइस। फेस्तुस आदेस देथै अउ पोलुस के उहां लग लइ गइन। <verse eid="ACT 25:23"/><verse number="24" style="v" sid="ACT 25:24"/>फेस्तुस कथै, राजा “अग्रिप्पा अउ सगलू इहां आय हर मनसे, तुम हइ मनसे के देखथा, जेखर बारे हे सगलू यहूदी समाज यरुसलेम हे अउ इहां मोर लग चिल्लाय-चिल्लाय के मांग करथै, कि इके अब अउ जिन्दा नेहको रहै चाही। <verse eid="ACT 25:24"/><verse number="25" style="v" sid="ACT 25:25"/>पय मै जांच करव कि हइ असना कुछु अपराध नेहको करे हबै, कि इके मिरतू के सजा दय जाय, काखे हइ खुदय रोमन राजपाल लग फेरै बिचार करै के बिनती करे हबै, इहैनिता मै इके उहां पठोमै के निरनय लय हव। <verse eid="ACT 25:25"/><verse number="26" style="v" sid="ACT 25:26"/>पय एखर बारे हे परभु राजपाल के लिघ्घो लिख पठोमै के मोर लिघ्घो कउनो निस्चित बात नेहको हबै, मै इके इहैनिता तुम्हर आगू खास रूप लग हे राजा अग्रिप्पा तुम्हर आगू लाय हबो ताकि हइ जांच पडताल के बाद लिखे के मोर लिघ्घो कुछु होय। <verse eid="ACT 25:26"/><verse number="27" style="v" sid="ACT 25:27"/>कुछु हुइ जाय मोके कउनो जेलियर के आरोप चिट्ठी तइयार करे बिगर उहां पठोय देबे, मोके फालतू लगथै।”<verse eid="ACT 25:27"/></para>
  <chapter eid="ACT 25"/>
  <chapter number="26" style="c" sid="ACT 26"/>
  <para style="s">अग्रिप्पा के आगू पोलुस के बचाव</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 26:1"/>राजा अग्रिप्पा पोलुस ले कथै, “तोके अपन बारे हे बोलै के आदेस हबै।” तब पोलुस अपन हाथ उठाइस अउ अपन बचाव हे बोलै के सुरु करथै,<verse eid="ACT 26:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 26:2"/>“हे राजा अग्रिप्पा, मै खुदय के भागय समझथो, कि यहूदिन मोर उप्पर जउन आरोप लगाय हबै, उन सगलू बातन के बचाव हे, मै तोके धन्य समझथो।” <verse eid="ACT 26:2"/><verse number="3" style="v" sid="ACT 26:3"/>बिसेस करके इहैनिता सही हबै कि तै यहूदिन के सब रिबाज अउ झगडा के जानथो। मतलब मै बिनती करथो, धीरज के संग मोर बात सुना।<verse eid="ACT 26:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 26:4"/>सगलू यहूदी जानथै, कि मै सुरु लग खुद अपन देस हे अउ यरुसलेम हे नान लग मै कसना चाल चलन के जीवन जिये हबो। <verse eid="ACT 26:4"/><verse number="5" style="v" sid="ACT 26:5"/>ऊ मोके बोहत टेम लग जानथै अउ अगर ऊ चाहथै, ता मोर बात के गवाही दइ सकथै, मै कइसन धरमी रीति रिबाज हे मै कट्टर जीवन अक्ठी फरीसी के जसना जीवन जिये हव। <verse eid="ACT 26:5"/><verse number="6" style="v" sid="ACT 26:6"/>पय अब मोर हे मुकदमा चलथै, काखे मोके ऊ टीमा के आसा हबै, जउन भगवान हमर पुरखन लग करे रथै। <verse eid="ACT 26:6"/><verse number="7" style="v" sid="ACT 26:7"/>उहै टीमा हबै जेखर आसा लगाय हम बारह कुर अपन बारे हे मन लग दिन रात महिमा करथन, अउ हे राजा इहै आसरा के कारन मोर उप्पर यहूदी आरोप लगाथै। <verse eid="ACT 26:7"/><verse number="8" style="v" sid="ACT 26:8"/>तुम मसे कउनो हइ बात बिस्वास के काबिल काखे नेहको लगथै, कि भगवान मरे हर के जिलाय देथै।<verse eid="ACT 26:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 26:9"/>“मै खुदय सोचत रहों, नासरी यीसु के नाम के बिरोध करै के निता जउन बने पडै ऊ बोहत कुछु करव। <verse eid="ACT 26:9"/><verse number="10" style="v" sid="ACT 26:10"/>अउ मै यरुसलेम हे असना करे रहों अउ परधान याजकन ले हक पाके बोहत ले पवितर मनसेन के जेल हे डालिस, अउ जब उन मार डारे जात रहिन ता मै उनखर बिरोध हे अपन सहमति दय रथो। <verse eid="ACT 26:10"/><verse number="11" style="v" sid="ACT 26:11"/>अउ यहूदी मंडली हे उनके सजा दय करथो अउ भगवान के बुराई ऊ बिस्वास के छांडै के निता दबाव के परयास करथो, उनखर पल्ला मोर गुस्सा एतका अधिक रथै कि उनके सतामै के निता बाहर के सहर तक गयों।<verse eid="ACT 26:11"/></para>
  <para style="s">पोलुस दवारा यीसु कर दरसन के बारे हे गुठेथै</para>
  <para style="r">(<ref loc="ACT 9:1-19">प्रेरितो 9:1-19</ref>; <ref loc="ACT 22:6-16">22:6-16</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 26:12"/>“इहै मकसद के संग दमिस्क के पल्ला जथो परधान याजकन के हक अउ आदेस चिट्ठी पाय के। <verse eid="ACT 26:12"/><verse number="13" style="v" sid="ACT 26:13"/>हे राजा, जब मै दुपहरी के टेम जब रास्ता हे रथो, तब मै बादर लग अक्ठी उजियार के उतरत देखथो, ओखर उजियार बेरा लग तेज रथै अउ मोर मनसेन के चउगिरदा पल्ला चमकिस। <verse eid="ACT 26:13"/><verse number="14" style="v" sid="ACT 26:14"/>जब हम सब भुंइ हे गिर पडेन, ता मै इब्रानी बोली हे, मोर ले हइ कहत अक्ठी सब्द सुनथै, हे साऊल हे साऊल, तै मोके काखे सताथस? कलिन्द्रा चाकू हे गिरै या चाकू कलिन्द्रा हे, पय कटै का कलिन्द्रा के हबै। <verse eid="ACT 26:14"/><verse number="15" style="v" sid="ACT 26:15"/>मै पूछो, हे परभु तै कोहर हबस? परभु कथै, मै यीसु हबो, जेही तै सताथस। <verse eid="ACT 26:15"/><verse number="16" style="v" sid="ACT 26:16"/>पय अब तै उठ, अपन गोड पर ठाढ हो काखे मै तो इहैनिता दरसन दय हव कि तोके अक्ठी हरवाह के रूप हे चुने हव, जउन कुछु देखे हस अउ उनके जिनखर निता मै तोके दरसन दइहों ओखर तै गवाह रइहे। <verse eid="ACT 26:16"/><verse number="17" style="v" sid="ACT 26:17"/>अउ मै तोके तोर मनसेन लग अउ गैर यहूदी लग बचाउत रइहों, जिनखर लिघ्घो मै तोके पठोथो। <verse eid="ACT 26:17"/><verse number="18" style="v" sid="ACT 26:18"/>कि तै उनखर आंखी उघार कि उन अंधियार लग उजियार के पल्ला अउ भुतवा के हक ले भगवान के पल्ला फिरै, कि पापन के छमा अउ उन मनसेन के संग जउन मोर हे बिस्वास करै लग पवितर करे गइन बरदान पामै।<verse eid="ACT 26:18"/></para>
  <para style="s">पोलुस कर काम</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 26:19"/>“हे राजा अग्रिप्पा, तब लग ऊ दरसन के आदेस के कबहुन मै उलंघन नेहको करव। <verse eid="ACT 26:19"/><verse number="20" style="v" sid="ACT 26:20"/>पय आगू दमिस्क के, फेर यरुसलेम के अउ तब यहूदिया के सगलू देस के रहैबालेन के, अउ गैर यहूदी के मै हइ परचार करव, कि उन पछताप करय, भगवान के पल्ला मुडै अउ मन बदलै के काबिल काम करै। <verse eid="ACT 26:20"/><verse number="21" style="v" sid="ACT 26:21"/>इहै कारन हबै कि जब मै बिनती भवन हे रहों, यहूदी मोके पके लइन अउ मोके मारै के परयास हे रथै। <verse eid="ACT 26:21"/><verse number="22" style="v" sid="ACT 26:22"/>पय मै भगवान के मदद लग मै आज तक बने हव अउ नान बडे सबके आगू गवाही देथो, अउ उन बातन के छांड कुछ नेहको कथो जउन मूसा आगू कर बात गुठे हबै, उनखर लग अधिक मै कुछु नेहको कथो। <verse eid="ACT 26:22"/><verse number="23" style="v" sid="ACT 26:23"/>कि मसीह के दुख उठामै काहिन होही अउ उहै सब ले आगुन मरे हर मसे जी उठके, अउ यहूदी अउ गैर यहूदी हे उजियार के संदेस दइ।”<verse eid="ACT 26:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 26:24"/>ऊ अपन बचाव हे जब हइ बातन के कहेन बाले रथै, ता फेस्तुस चिल्लाय के कथै, “पोलुस तोर दिमाक खराब हुइ गय हबै, तोर बोहत पढाइ तोके बइहा बनाथै।”<verse eid="ACT 26:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 26:25"/>पय पोलुस कथै, “हे फेस्तुस, मै बइहा नेहको यहों, पय सही अउ मुद्दे के बात करथो। <verse eid="ACT 26:25"/><verse number="26" style="v" sid="ACT 26:26"/>खुदय राजा हइ बातन के जानथै, मै निडर हुइके बोलथो, हइ बात जानथा अउ मोके बिस्वास हबै कि इन बातन मसे कउनो बात ओखर लग छुपे नेहको हबै, काखे हइ घटना कउनो कोन्टा हे नेहको हुइस। <verse eid="ACT 26:26"/><verse number="27" style="v" sid="ACT 26:27"/>हे राजा अग्रिप्पा, का तै ग्यानी मनसे के कहे हर बात हे बिस्वास करथस? मै जानथो, कि तै बिस्वास करथस।”<verse eid="ACT 26:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 26:28"/>हइ बात हे अग्रिप्पा पोलुस लग कथै, का तै हइ सोचथस कि इतनी लिखडी लग मसीही बनै के निता मनाय लेहे? <verse eid="ACT 26:28"/><verse number="29" style="v" sid="ACT 26:29"/>पोलुस जबाब देथै, “चुटु टेम या चाहे बोहत टेम हे भगवान लग मोर हइ बिनती हबै कि न सिबाय तै बलुक सगलू जउन आज लग मोर बात सुनथै, ओसनेन हुइ जइन, जसना मै हव, सिबाय हइ बंधन के।”<verse eid="ACT 26:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 26:30"/>तब राजा अग्रिप्पा राजपाल फेस्तुस अउ बिरनीके अउ उनखर संग बइठे हर मनसे उठ गइन। <verse eid="ACT 26:30"/><verse number="31" style="v" sid="ACT 26:31"/>उहां लग बाहिर निकरके ऊ अपन हे बात करत कहै लागथै, हइ मनसे कुछु नेहको करे हबै, जेही उके मिरतू के सजा या जेल हे बन्द रख सकि। <verse eid="ACT 26:31"/><verse number="32" style="v" sid="ACT 26:32"/>अग्रिप्पा फेस्तुस ले कथै, “अगर हइ मनसे कैसर रोमन राजपाल के आगू फेरै बिनती नेहको करे होते ता हइ मनसे के छांड दय जाय सकतिस।”<verse eid="ACT 26:32"/></para>
  <chapter eid="ACT 26"/>
  <chapter number="27" style="c" sid="ACT 27"/>
  <para style="s">पोलुस के रोम पठोथै</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 27:1"/>जब हइ निस्चित हुइ गइस कि हम जिहाज दवारा इटली जउबे, ता पोलुस अउ कुछ दूसर बन्दिन के यूलियुस नाम के सिपाही के हाथ दइ देथै। यूलियुस किला अवगुस्तुस के सेना के दल रथै। <verse eid="ACT 27:1"/><verse number="2" style="v" sid="ACT 27:2"/>हम आसिया परदेस के बन्दरगाह के जाय बाले अन्द्रमुत्तियुम नगर के अक्ठी नाह जिहाज हे बइठ के रवाना हुइ गयन, मकिदुनिया देस के थिस्सलुनीके नगर के रहै बाले अरिस्तर्खुस नाम अक्ठी बिस्वासी हमर संग रथै। <verse eid="ACT 27:2"/><verse number="3" style="v" sid="ACT 27:3"/>अगले रोज हम सैदा हे लंगर डालेन, इहां यूलियुस पोलुस के परति दया दिखाई अउ ऊ पोलुस के संगिन के इहां जाय अउ उनखर मदत करै के इजाजत दइ दइस। <verse eid="ACT 27:3"/><verse number="4" style="v" sid="ACT 27:4"/>उछो लग समुन्दर गली लग हुइ के कढ जथै, हम साइप्रस के आड हे हुइके चलत रहन काखे हबा हमर पल्ला रथै। <verse eid="ACT 27:4"/><verse number="5" style="v" sid="ACT 27:5"/>फेर हम किलिकिया, पंफूलिया के समुन्दर के पार करत लूसिया अउ मूरा पहुंचन। <verse eid="ACT 27:5"/><verse number="6" style="v" sid="ACT 27:6"/>ऊ सिपाही के सिकन्दरिया इटली जाय बाले अक्ठी नाह जिहाज मिलथै ओहमा हमही चढाय दइस।<verse eid="ACT 27:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 27:7"/>धीम-धीम परेसानी लग आगू बढत कनिदुस के आगू पहुंचेन, काखे बडेरा हमही आगू नेहको बढै देथै, ता हम सलमोने के आगू लग क्रेते के आड हे अपन नाह जिहाज के बढामै लगन। <verse eid="ACT 27:7"/><verse number="8" style="v" sid="ACT 27:8"/>क्रेते के टाठा-टाठा बडी परेसानी लग जिहाज के आगू बढाउत अक्ठी असना जिघा हे पहुंचन, जेखर नाम रथै सुरक्छित समान उतारै बाले जिघा ले लसया सहर लिघ्घो रथै।<verse eid="ACT 27:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 27:9"/>टेम बोहत गुजर जथै नाह जिहाज के आगू बढामै का खतरा रथै, काखे तब तक उपास के रोज गुजर जथै, इहैनिता पोलुस उनही सलाह देत कथै, <verse eid="ACT 27:9"/><verse number="10" style="v" sid="ACT 27:10"/>“हे भाई, मोके लागथै कि हमर समुन्दर के यातरा खतरा हबै, न केबल समान अउ नाह जिहाज बलुक हमर जीवन के।” <verse eid="ACT 27:10"/><verse number="11" style="v" sid="ACT 27:11"/>पय पोलुस जउन कथै ओखर हे धियान देय हे सेना सिपाही जिहाज के मालिक अउ नाह जिहाज चलामै बाले बिस्वास करिन। <verse eid="ACT 27:11"/><verse number="12" style="v" sid="ACT 27:12"/>ऊ बन्दरगाह अगहन के टेम रथै इहैनिता मनसे फीनिक्स पहुंच के उछो जाड उहै छो गुजारब, अउ निस्चय करिन कि फीनिक्स क्रेते असना माल उतारै बाले हबै, जेखर दख्खिन अउ दिन बुडती अउ उत्तर दिन बुडती दोनो के आगू पडथै।<verse eid="ACT 27:12"/></para>
  <para style="s">समुन्दर हे बडेरा</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 27:13"/>जब दख्खिन हबा चुटु-चुटु चलै लागथै, ता उन सोचिन जसना उन चाहथै ओसनेन रही ता उन लोहा के सांकड के उठाय के क्रेते के टाठा-टाठा पहुंच गइन। <verse eid="ACT 27:13"/><verse number="14" style="v" sid="ACT 27:14"/>पय अउ चुटु देर हे अक्ठी पानी लग घेररेहर टापू के पल्ला लग बोहत बडेरा आथै, जेही उत्तरी बडेरा कथै। <verse eid="ACT 27:14"/><verse number="15" style="v" sid="ACT 27:15"/>जिहाज बडेरा लग घेरर जथै, तब मुसकिल रथै कि बडेरा के चीरत जिहाज आगू बढथै, इहैनिता हम परयास करै के छांड दयन अउ बडेरा के संग नाह जिहाज के बोहै के निता छांड दयन। <verse eid="ACT 27:15"/><verse number="16" style="v" sid="ACT 27:16"/>तब कउदा नाम के अक्ठी नान ले टापू के आड हे बहत हम दिग्गत ले नाह जिहाज के वस हे के सकेन। <verse eid="ACT 27:16"/><verse number="17" style="v" sid="ACT 27:17"/>फेर मल्लाहन उके उठाय के दूसर जुगाड करके नाह जिहाज के तरी ले बांधथै, अउ सुरतिस के चोरबालू पर टिक जाय के डर ले पाल अउ सामान उतार के बहत चल देथै। <verse eid="ACT 27:17"/><verse number="18" style="v" sid="ACT 27:18"/>जब हम बडेरा ले बोहत हिलकोचे अउ धक्के खायन, ता दूसर रोज ऊ नाह जिहाज के माल फेकै लागथै <verse eid="ACT 27:18"/><verse number="19" style="v" sid="ACT 27:19"/>अउ तीसर रोज उन अपन हाथन ले नाह जिहाज के साज समान फटक देथै। <verse eid="ACT 27:19"/><verse number="20" style="v" sid="ACT 27:20"/>जब कइन रोज तक न बेरा, न तरइया दिखाई देथै अउ बडी बडेरा चलथै, ता आखिर हे हमार बचै के सगलू आसा बढाय गइस। <figure style="fig" alt="Ship being wrecked in a storm" file="lb00219c.tif" size="col" copy="Horace Knowles ©" ref="27:18">आंधी हे जिहाज नास हुइ गय</figure><verse eid="ACT 27:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 27:21"/>जब उन बोहत टेम लग कुछु नेहको खाय रथै, ता पोलुस उनके गोहदा हे ठाढ हुइके कथै, “हे मनसे चाही कि तुम मोर बात मानके क्रेते लग न नाह जिहाज खोलते अउ न हइ समस्या आतिस अउ न हइ नुसकान उठातेन। <verse eid="ACT 27:21"/><verse number="22" style="v" sid="ACT 27:22"/>पय अब मै तुमके समझाथो कि हिम्मत धरा, काखे तुम मसे कउनो के जीवन के दिग्गत नेहको होही, पय केबल नाह जिहाज नस्ट होही। <verse eid="ACT 27:22"/><verse number="23" style="v" sid="ACT 27:23"/>काखे भगवान जेखर मै हबो अउ जेखर सेबा करथो, ओखर स्वरगदूत आजय रात मोर लिघ्घो आयके कथै, <verse eid="ACT 27:23"/><verse number="24" style="v" sid="ACT 27:24"/>हे पोलुस, झइ डेराबा तोके कैसर रोमन राजपाल के आगू ठाढ होय का जरूरी हबै देख, भगवान सब के जउन तोर संग यातरा करथै, तोके दय हबै। <verse eid="ACT 27:24"/><verse number="25" style="v" sid="ACT 27:25"/>इहैनिता, हे सज्जनो, हिम्मत रख काखे मै भगवान हे बिस्वास करथो, कि जसना मोर लग गुठे गइस, ओसनेन होही। <verse eid="ACT 27:25"/><verse number="26" style="v" sid="ACT 27:26"/>पय हमके कउनो टापू हे जायके होही।”<verse eid="ACT 27:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 27:27"/>जब चउदमा रात आथै अउ हम अद्रिया समुन्दर हे भटकत रहन, ता आधी रात के केउंटा अनुमान करिस कि हम कउनो देस के लिघ्घो पहुंचथन। <verse eid="ACT 27:27"/><verse number="28" style="v" sid="ACT 27:28"/>थाह लेय हे उन बीस पुरसा दहार पानी पाथै, अउ चुटु आगू बढके फेर थाह लैथै ता पन्दरा पुरसा पाथै। <verse eid="ACT 27:28"/><verse number="29" style="v" sid="ACT 27:29"/>तब पथरहली जिघा ले टेकराय के डर ले उन जिहाज के पाछू पल्ला चार लंगर डालिन, अउ सुबेन्नेन होय के ओरगथै। <verse eid="ACT 27:29"/><verse number="30" style="v" sid="ACT 27:30"/>पय जब केउंटा नाह जिहाज पर ले भागै चाहथै, इहैनिता उन गलही लग लंगर डालै के बहाने नाह जिहाज समुन्दर हे उतार दिहिन, <verse eid="ACT 27:30"/><verse number="31" style="v" sid="ACT 27:31"/>ता पोलुस सिपाही अउ सिपाहिन ले कथै, “अगर हइ नाह जिहाज पर नेहको रहै, ता तुम नेहको बच सकथा।” <verse eid="ACT 27:31"/><verse number="32" style="v" sid="ACT 27:32"/>तब सिपाही डोरा काट के नाह जिहाज समुन्दर हे छांड देथै।<verse eid="ACT 27:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 27:33"/>जब सुब्बेन होय रथै तब पोलुस हइ कथै, सब के भोजन करै के निता समझाथै, “आज चउदह रोज हुइस कि तुम आस देखत भूखे रहा अउ कुछ भोजन नेहको करे। <verse eid="ACT 27:33"/><verse number="34" style="v" sid="ACT 27:34"/>इहैनिता तुमके समझाथो कि कुछ खाय लो, जेखर ले तुम्हर बचाव होय काखे तुम मसे कउनो के मूड के अक्ठी चूंदी नेहको गिरही।” <verse eid="ACT 27:34"/><verse number="35" style="v" sid="ACT 27:35"/>हइ गुठेके ऊ रोटी लइके सबके आगू भगवान के धन्यबाद करथै अउ टोर के खाय लागथै। <verse eid="ACT 27:35"/><verse number="36" style="v" sid="ACT 27:36"/>तब उन सब हिम्मत धरके भोजन करै लागथै। <verse eid="ACT 27:36"/><verse number="37" style="v" sid="ACT 27:37"/>हम सब मिलके नाह जिहाज पर दुइ सव छिहत्तर जन रहन। <verse eid="ACT 27:37"/><verse number="38" style="v" sid="ACT 27:38"/>जब उन भोजन करके अघाय गइन, ता गोहूं के समुन्दर हे फटक के नाह जिहाज हलका करै लागथै। <verse eid="ACT 27:38"/><verse number="39" style="v" sid="ACT 27:39"/>जब दिन उगथै ता उन ऊ देस के नेहको पहचानथै, पय अक्ठी खाडी देखथै जेखर पाखा चउडा रथै, अउ बिचार करथै कि अगर हुइ सकै ता इहै तट पर नाह जिहाज के टिकामै। <verse eid="ACT 27:39"/><verse number="40" style="v" sid="ACT 27:40"/>तब उन लंगर के खोलके समुन्दर हे छांड देथै अउ उहै टेम पतवारन के बन्धन छोर दिहिन, अउ हवा के आगू अगला पाल चढायके पाखा के पल्ला चलेन। <verse eid="ACT 27:40"/><verse number="41" style="v" sid="ACT 27:41"/>पय दुइठे समुन्दर के मिलन के जिघा पकरके उन नाह जिहाज के टिकाथै, अउ गलही लग लंगर तो धक्का खाय के गडरर जथै अउ नेहको टर सकथै पय पाछू लहर के बल लग टूटै लागथै।<verse eid="ACT 27:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 27:42"/>तब सिपाहिन के हइ बिचार होथै कि बन्दिन के मारे डालय, असना नेहको होय कि कउनो पइर के निकर भागय। <verse eid="ACT 27:42"/><verse number="43" style="v" sid="ACT 27:43"/>पय सिपाही पोलुस के कथै, कि जउन पइर सकथै, आगू कूदके पाखा हे निकर जाय <verse eid="ACT 27:43"/><verse number="44" style="v" sid="ACT 27:44"/>अउ बाकी कउ पटरन पर, अउ कउ नाह जिहाज के दूसर चीजन के सहारे निकर जाय। इहैमेर ले सब कउ भुंइ हे बच निकडथै।<verse eid="ACT 27:44"/></para>
  <chapter eid="ACT 27"/>
  <chapter number="28" style="c" sid="ACT 28"/>
  <para style="s">माल्टा हे पोलुस</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 28:1"/>जब हम बच निकरन। ता पता हुइस कि हइ व्दीप के नाम माल्टा हबै। <verse eid="ACT 28:1"/><verse number="2" style="v" sid="ACT 28:2"/>उहां के रहै बाले मनसे हमर संग संगी के जसना दया करिन काखे सरदी रथै अउ बरसा होमै लगथै, इहैनिता उन आगी जलाय के अउ हमर सबके सोगत करिस। <verse eid="ACT 28:2"/><verse number="3" style="v" sid="ACT 28:3"/>जब पोलुस लकडी के अक्ठी बोझवा बनाइस अउ ऊ जब लकडी के आगी हे धरथै, ताकि गरमी मिलै ता गरमी के कारन अक्ठी सपुवा निकरिस अउ ओखर हाथ हे लपट गइस। <verse eid="ACT 28:3"/><verse number="4" style="v" sid="ACT 28:4"/>उहां के रहै बाले जब ऊ सपुवा के ओखर हाथ हे लपटे हर देखथै, ता ऊ अपन हे कहे लागथै, जरूर इहै मनसे खुनहा हबै अउ हइ सागर लग बच गय हबै पय इके भगवान के नियाव जिन्दा नेहको रहै दइस। <verse eid="ACT 28:4"/><verse number="5" style="v" sid="ACT 28:5"/>तब पोलुस सपुवा के आगी हे फेक दइस अउ उके कुछ नुसकान नेहको हुइस। <verse eid="ACT 28:5"/><verse number="6" style="v" sid="ACT 28:6"/>ऊ मनसे ओरगत रथै कि ऊ फूल जही, या अचानक भुंइ हे गिरके मर जइही, पय बोहत देर लग ओरगै के बाद ऊ देखथै कि उके असाधरन रूप लग कुछु नेहको हुइस, ता उनखर सोच बदल गइस अउ उन कथै “हइ कउनो देउता हबै।”<verse eid="ACT 28:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 28:7"/>उस टापू के अगल बगल पुबलियुस मुखिया के जमीन रथै, ऊ अपन घर लइ जायके ऊ तीन रोज संगी के जसना सोगत सत्कार करिस। <verse eid="ACT 28:7"/><verse number="8" style="v" sid="ACT 28:8"/>पुबलियुस के बाफ बुखार अउ पेचिस लग नंगहा रथै। मतलब पोलुस ओखर लिघ्घो घर हे जाय के बिनती करथै अउ ओखर हे हाथ धरके उके निक्खा करथै। <verse eid="ACT 28:8"/><verse number="9" style="v" sid="ACT 28:9"/>हइ घटना के बाद ऊ दीप लग सगलू नंगहा उहां आइन अउ सगलू कउ निक्खा हुइ जथै। <verse eid="ACT 28:9"/><verse number="10" style="v" sid="ACT 28:10"/>उन हमार बोहत इज्जत करिन, अउ जब हम रेंगय लागेन ता जउन कुछ हमर निता जरूरी रहिस, जिहाज हे धर दिहिन।<verse eid="ACT 28:10"/></para>
  <para style="s">माल्टा व्दीप ले रोम के पल्ला</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 28:11"/>हम तीन माह के बाद हम सिकन्दरिया के अक्ठी नाह जिहाज पर गयन, जउन ऊ व्दीप हे जाड गुजारन अउ जेखर निसानी रथै, “दियुसकूरी।” <verse eid="ACT 28:11"/><verse number="12" style="v" sid="ACT 28:12"/>हम सुरकूसा हे लंगर डालके हम तीन रोज उछो रहन। <verse eid="ACT 28:12"/><verse number="13" style="v" sid="ACT 28:13"/>उहां लग हम घूमके रेगियुस हे आयन अउ अक रोज के बाद दख्खिन हबा चलिस, तब हम दूसर रोज पुतियुली बन्दरगाह छो पहुंचेन। <verse eid="ACT 28:13"/><verse number="14" style="v" sid="ACT 28:14"/>उहां हम के बिस्वासी भाई मिलिस, अउ उनखर गुठे लग हम उनखर इहां सात रोज तक रहन अउ इहैमेर हम रोम तक आय गइन। <verse eid="ACT 28:14"/><verse number="15" style="v" sid="ACT 28:15"/>उहां के भाई हमर समाचार सुनके अप्पियुस के चउक अउ तीन सराय तक हम भेंट करय के निकर गयन, देखके पोलुस भगवान के धन्यबाद दइस अउ ऊ खुस हुइस।<verse eid="ACT 28:15"/></para>
  <para style="s">रोम हे पोलुस</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 28:16"/>जब हम रोम हे पहुंचेन, ता पोलुस के अक्ठी सिपाही के संग जउन ओखर देख रेख करथै, अकेल्ले रहै के आदेस मिल गइस। <figure style="fig" alt="Street scene of The Roman city" file="hk00242c.tif" size="span" copy="Horace Knowles ©" ref="28:16">रोमन सहर के रस्ता के द्रस्य</figure><verse eid="ACT 28:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 28:17"/>तीसर रोज के बाद ऊ यहूदी के मुखिया मनसेन के बुलवाथै, अउ जब उन अक जिघा हुइन ता ऊ कथै “हे भाइयो, मै अपन मनसेन के या दाय-बाफ के बेउहार के बिरोध हे कुछ नेहको करव, तउमा बन्दी बनाय के यरुसलेम ले रोमन के हाथ सउपे गइस। <verse eid="ACT 28:17"/><verse number="18" style="v" sid="ACT 28:18"/>उन मोके जांच के छांड देय चाहथै, काखे मोर हे मरय के ओग कउनो गलती नेहको रथै। <verse eid="ACT 28:18"/><verse number="19" style="v" sid="ACT 28:19"/>पय यहूदी एखर बिरोध हे बोलय लागथै, ता मोके कैसर रोमन राजपाल के दुहाइ देयका पडिस, हइ नेहको कि मोके अपन मनसेन पर कउनो गलती थोपी। <verse eid="ACT 28:19"/><verse number="20" style="v" sid="ACT 28:20"/>इहैनिता मै तुमही बुलाथों कि तुम्हर लग मिलो अउ बात चीत करव काखे इस्राएल कि आसा के निता मै हइ सांकड ले बंधररे हर हबो।”<verse eid="ACT 28:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 28:21"/>उन ओखर ले कथै, “न हम तोर बारे हे यहूदिया ले चिट्ठी पायन, अउ न भाइन मसे कउनो आयके तोर बारे हे कुछ गुठेइन अउ न बुरा के। <verse eid="ACT 28:21"/><verse number="22" style="v" sid="ACT 28:22"/>पय तोर बिचार काहिन हबै? उहै हम तोर ले सुनय चाहथन, काखे हम जानथन कि हर जिघा हइ मत के बिरोध हे मनसे बात करथै।”<verse eid="ACT 28:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 28:23"/>तब उन ओखर निता अक रोज ठहराइन, अउ बोहत लग मनसे ओखर इहां अक जिघा हुइन, अउ ऊ भगवान कर राज कि गवाही देत अउ मूसा कर नियम अउ ग्यानी मनसे के किताब लग यीसु के बारे हे समझाय के भिनसरहा ले सांझ तक चरचा करत रथै। <verse eid="ACT 28:23"/><verse number="24" style="v" sid="ACT 28:24"/>तब कुछ मनसे उन बातन के मान लेथै अउ कुछ बिस्वास नेहको करथै। <verse eid="ACT 28:24"/><verse number="25" style="v" sid="ACT 28:25"/>जब उन अपने हे अक मत नेहको हुइन, ता पोलुस के हइ बात गुठे लग चले गइन, “पवितर आतमा यसायाह ग्यानी मनसे दवारा तुम्हर दाउ दादन लग सही गुठे हबै।” <verse eid="ACT 28:25"/><verse number="26" style="v" sid="ACT 28:26"/>जाय के इन मनसेन लग कहा,</para>
  <para style="q1" vid="ACT 28:26">कि सुनत तो रइहा,</para>
  <para style="q1" vid="ACT 28:26">पय नेहको समझिहा अउ देखत,</para>
  <para style="q2" vid="ACT 28:26">तो रइहा पय नेहको बूझिहा।<verse eid="ACT 28:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 28:27"/>काखे इन मनसेन के मन मोटा,</para>
  <para style="q2" vid="ACT 28:27">अउ उनखर कान भारी हुइ गय हबै,</para>
  <para style="q2" vid="ACT 28:27">अउ उन अपन आंखी बन्द करे हबै,</para>
  <para style="q1" vid="ACT 28:27">असना न होय कि,</para>
  <para style="q2" vid="ACT 28:27">उन कहुं आंखी लग देखय,</para>
  <para style="q2" vid="ACT 28:27">अउ कान लग सुनय,</para>
  <para style="q1" vid="ACT 28:27">अउ मन ले समझय,</para>
  <para style="q2" vid="ACT 28:27">अउ फेर मै उनके निक्खा करी।<verse eid="ACT 28:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 28:28"/>मतलब तुम जानथा, “कि भगवान के हइ मुकति के संदेस गैर यहूदी के लिघ्घो पठोय गय हबै अउ उन जरूर सुनही।” <verse eid="ACT 28:28"/><verse number="29" style="v" sid="ACT 28:29"/>जब ऊ कथै ता यहूदी अपनय हे बोहत झगडा करै लागथै अउ झगडा करत उहां लग कढ गइन।<verse eid="ACT 28:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 28:30"/>ऊ पूर दुइ साल अपन भाडे के घर हे रहिस, ऊ सब मनसेन के सोगत करथै जउन ओखर लग मिलै आथै। <verse eid="ACT 28:30"/><verse number="31" style="v" sid="ACT 28:31"/>अउ जउन ओखर लिघ्घो आथै, उन सबले मिलथै अउ बिगैर रोकटोक के बोहत निडर हुइके भगवान कर राज के परचार करथै अउ परभु यीसु मसीह के बारे हे सिक्छा देथै।<verse eid="ACT 28:31"/></para>
  <chapter eid="ACT 28"/>
</usx>
