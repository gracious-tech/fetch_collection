<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHM" style="id">- Bhumiya Standard Project</book>
  <para style="h">फिलेमोन</para>
  <para style="toc3">फिलेमोन</para>
  <para style="toc2">फिलेमोन</para>
  <para style="toc1">फिलेमोन के निता पोलुस कर चिट्ठी</para>
  <para style="mt2">फिलेमोन के लिए पौलुस की चिट्ठी</para>
  <para style="mt1">फिलेमोन के निता पोलुस कर चिट्ठी</para>
  <para style="iot">परचा</para>
  <para style="ip">फिलेमोन के नानहस किताब पोलुस चेला<char style="xt"><ref loc="PHM 1:1">1:1</ref></char> दवारा लिखे गय रथै, पोलुस जब जेल हे रथै तब ऊ हइ चिट्ठी के लिखे रथै, जेखर मतलब हबै, कि ऊ सायद रोम सहर लग लिखे रथै, इहैनिता ऊ रोम सहर हे रथै ता इके यीसु के जनम के करीबन अकसठ साल बाद लिखे गय होही, जउन टेम हे ऊ कुलुस्सियो के चिट्ठी लिखे होही।</para>
  <para style="ip">उन हइ चिट्ठी फिलेमोन नाम के अक्ठी मनसे के लिखे रथै, फिलेमोन मंडली के अक्ठी सदस्य रथै अउ अक्ठी दास के मालिको रथै, पोलुस उके हइ पूछै के निता लिखिस कि ऊ अपन दास उनेसिमुस के सजा झइ दे जउन फिलेमोन भाग गय रथै, रोमन नियम के जसना फिलेमोन उनेसिमुस के मउत के घाट उतारै के हक रथै, पोलुस, फिलेमोन कहुं अक्ठी मसीह भाई के रूप हे स्वीकार करै के निता, फिलेमोन के प्रोत्साहन करै के निता बिस्वास लग तरक के परयोग करथै, अउ इहो सलाह देथै कि उनेसिमुस के पोलुस <char style="xt"><ref loc="PHM 1:13-14">1:13-14</ref></char> के संग सेबा करै के आदेस दय जाय।</para>
  <para style="iot">रूप रेखा</para>
  <para style="io">1. पोलुस हे फिलेमोन के सोगत करथै। <char style="ior"><ref loc="PHM 1:1-3">1:1-3</ref> </char></para>
  <para style="io">2. तब पोलुस उनेसिमुस के पल्ला लग पूछथै कि फिलेमोन उके अक्ठी मसीह भाई के रूप हे स्वीकार करही। <char style="ior"><ref loc="PHM 1:4-21">1:4-21</ref> </char></para>
  <para style="io">3. पोलुस यातरा करै के इरादा घोसना करै के समापत करथै अउ सुभकामनाय पठोथै। <char style="ior"><ref loc="PHM 1:22-25">1:22-25</ref> </char></para>
  <chapter number="1" style="c" sid="PHM 1" />
  <para style="s">सोगत</para>
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1" />यीसु मसीह के निता कैदी पोलुस अउ हमर भाई तीमुथियुस<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">तीमुथियुस पोलुस के सहकरमी अउ दोस रथै</char></note> के पल्ला लग, हमर पिरिया संगी अउ संग-संग चले बाले फिलेमोन, <verse eid="PHM 1:1" /><verse number="2" style="v" sid="PHM 1:2" />हमर बेहन अफफिया अउ हमर संगी सिपाही अर्खिप्पुस अउ फिलेमोन के घर अकजुट होय बाले मंडली के नाम।<verse eid="PHM 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PHM 1:3" />हमर बाफ भगवान अउ परभु यीसु मसीह के पल्ला लग अनुगरह किरपा अउ सान्ति तुमके मिलत रहै।<verse eid="PHM 1:3" /></para>
  <para style="s">फिलेमोन कर माया अउ बिस्वास</para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4" />मै सबरोज भगवान के धन्यबाद करथो अउ अपन पराथना बिनती हे तोके सुरता करथो, <verse eid="PHM 1:4" /><verse number="5" style="v" sid="PHM 1:5" />काखे मै परभु मसीह यीसु अउ सगलू पवितर मनसेन के पल्ला तोर माया अउ बिस्वास के बारे हे सुनथो। <verse eid="PHM 1:5" /><verse number="6" style="v" sid="PHM 1:6" />मोर पराथना बिनती हइ हबै कि बिस्वास हे तोर संगति सक्रिय होय अउ तुमके हइ ग्यान मिलै कि हम मसीह के निता कोन-कोन निक्खा काम करै हे सक्ति हबै। <verse eid="PHM 1:6" /><verse number="7" style="v" sid="PHM 1:7" />काखे हे भाई, मोके तोर माया लग बोहत खुसी अउ प्रोत्साहन मिले हबै, इहैनिता कि तोर दवारा पवितर मनसेन के मन हरा भरा हुइ गय हबै।<verse eid="PHM 1:7" /></para>
  <para style="s">पोलुस कर दवारा निबेदन</para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8" />इहैनिता मोके मसीह हे तुमके हइ आदेस देय के हक हबै कि तोर काहिन करै के सही हबै। <verse eid="PHM 1:8" /><verse number="9" style="v" sid="PHM 1:9" />पय माया के आधार हे मै तुम्हर लग पराथना करै के निक्खा समझथो, मै पोलुस जउन अब डोकराय गय हव अउ यीसु मसीह के निता अब कैदी बन गय हव। <verse eid="PHM 1:9" /><verse number="10" style="v" sid="PHM 1:10" />ऊ उनेसिमुस<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="ft" closed="false">उनेसिमुस पोलुस के सेबक रथै </char></note> के बारे हे पराथना करथो, जउन तब मोर लरका बने रथै, जब मै जेल हे रथो। <verse eid="PHM 1:10" /><verse number="11" style="v" sid="PHM 1:11" />अक्ठी टेम रथै जब ऊ तोर कउनो काम के नेहको रथै, पय अब न तोर निता बलुक मोरो निता बोहत काम के हबै।<verse eid="PHM 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PHM 1:12" />मै अपन दिल के खन्डा के तोर लिघ्घो वापिस पठोथो। <verse eid="PHM 1:12" /><verse number="13" style="v" sid="PHM 1:13" />मै ओही अपन लिघ्घो रखैके चाहथो, ताकि संदेस के निता मोके कैदी के ऊ तोर पल्ला लग सेबा के सकै। <verse eid="PHM 1:13" /><verse number="14" style="v" sid="PHM 1:14" />पय मै तोर इक्छा बिना कुछु करै के नेहको चाहो, कि तोर हइ किरपा लग नेहको पय मगन लग होय।<verse eid="PHM 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHM 1:15" />उनेसिमुस सायद इहैनिता कुछ टेम तक तुम्हर लग लइ ले गय रथै कि ऊ तुमके सबरोज के निता मिल जाय। <verse eid="PHM 1:15" /><verse number="16" style="v" sid="PHM 1:16" />अब सेबक के रूप हे नेहको, बलुक हरवाह लग कहुं बढके पिरिया भाई के रूप हे, हइ मोके बोहत पिरिया हबै, पय अब देह हे अउ परभु हे तुमके कहुं जादा पिरिया होही।<verse eid="PHM 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17" />इहैनिता अगर मोके भाई समझता, ता इके उहै मेर अपनाबा जउन मेर मोके अपनाय हबा। <verse eid="PHM 1:17" /><verse number="18" style="v" sid="PHM 1:18" />अगर तुमके एखर लग कउनो घाटा होय हबै या एखर उप्पर तुम्हर कुछु करजा हबै, ता उके मोर खाता हे लिख लेया। <verse eid="PHM 1:18" /><verse number="19" style="v" sid="PHM 1:19" />मै पोलुस अपन हाथ लग लिखथो कि मै खुदय चुकाय देहुं, काहिन मै तोके सुरता देबाबा कि तुम्हरो उप्पर मोरो करजा हबै? तुम तो मोरेन हबा। <verse eid="PHM 1:19" /><verse number="20" style="v" sid="PHM 1:20" />हे भाई, परभु के नाम लग मोके तुम्हर लग कुछ तो फायदा होय, तुम मसीह के कारन मोर हिरदय खुसी लग भर देया।<verse eid="PHM 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PHM 1:21" />मै तोर उप्पर बिस्वास करत हइ चिट्ठी तुमके लिखथो, मै जानथो कि मै तोर लग जेतका कथो, तै ओखर लग कहुं जादा करबे। <verse eid="PHM 1:21" /><verse number="22" style="v" sid="PHM 1:22" />अक्ठी बात अउ तुम मोर रहै निता कमरा जुगाड करा, काखे मोके आसा हबै कि तुम्हर सगलू पराथना बिनती के कारन भगवान मोके तुम मनसेन के फेरै लउटाय देही।<verse eid="PHM 1:22" /></para>
  <para style="s">आखरी सोगत</para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23" />इपफ्रास, जउन मसीह यीसु के कारन मोर संग जेल हे हबै, <verse eid="PHM 1:23" /><verse number="24" style="v" sid="PHM 1:24" />अउ मोर संग-संग चले बाले मरकुस अउ अरिस्तर्खुस अउ देमास अउ लूका जउन मोर संगी हबै, तुमके नमस्ते कथन।<verse eid="PHM 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PHM 1:25" />तुम सबके उप्पर परभु यीसु मसीह के अनुगरह किरपा अउ आतमा के संग बने रहै।<verse eid="PHM 1:25" /></para>
  <chapter eid="PHM 1" />
</usx>