<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JAS" style="id">- Bhumiya Standard Project</book>
  <para style="h">याकूब</para>
  <para style="toc3">याकूब</para>
  <para style="toc2">याकूब</para>
  <para style="toc1">याकूब कर चिट्ठी</para>
  <para style="mt2">याकूब की चिट्ठी</para>
  <para style="mt1">याकूब कर चिट्ठी</para>
  <para style="imt">परचा</para>
  <para style="ip">याकूब के किताब याकूब नाम के कउनो मनसे दवारा लिखे गय रथै, हइ यीसु के भाई याकूब रथै, जउन सुरू के मंडली हे अक्ठी अगुवा रथै अउ यरुसलेम के परिसद के हिस्सा रथै, <char style="xt"><ref loc="ACT 15:13">प्रेरितो 15:13</ref></char> प्रेरित पोलुस उके <char style="xt"><ref loc="GAL 2:9">गलातियों 2:9</ref></char> हे मंडली के खम्भा कथै, दिमाक बाले के मानै के हबै कि याकूब के किताब यीसु के पइदा के करीबन 50 साल बाद लिखे गय रथै, पय याकूब यरुसलेम के मंडली के अगुवा रथै, ऊ सम्भव उहां रहत किताब लिखे रथै।</para>
  <para style="ip">याकूब अपन किताब के गैर यहूदी हे फइले हर बाराठे कुर<char style="xt"><ref loc="JAS 1:1">1:1</ref></char> के संकेत करथै। याकूब के पाठ सगलू मसीहन हे लागू होथै पय बारा कुर सबरोज के निस्तार लग हइ साबित हुइ जथै, कि याकूब सीधा यहूदी मसीही के लिखथै, पय हइ किताब पढै बाले के अक्ठी ब्यापक समूह तक पहुंचै के निता रथै, ई कइठे बिसय के संबोधित करथै, याकूब बिस्वास अउ काम के बीच सबंध हे धियान लगाथै, सही बिस्वास करवाय के दिखाय जही। <char style="xt"><ref loc="JAS 2:17">2:17</ref></char> ऊ धन्नड मनसे <char style="xt"><ref loc="JAS 2:14">2:14</ref></char> के परति पक्छपात दिखामै के खिलाफ चेतन्त करथै अउ हमके गुठेथै कि हम जउन कथन ओखर लग हुसियार रहा। <char style="xt"><ref loc="JAS 3:1-12">3:1-12</ref> </char></para>
  <para style="iot">रूप रेखा</para>
  <para style="io1">1. याकूब अपन किताब के पढै बालेन के सोगत करथै। <char style="ior"><ref loc="JAS 1:1">1:1</ref> </char></para>
  <para style="io1">2. एखर बाद ऊ मसीही के प्रोत्साहन करथै कि जब ऊ कस्ट सहै के मजबूत बने रहै। <char style="ior"><ref loc="JAS 1:2-27">1:2-27</ref> </char></para>
  <para style="io1">3. फेर ऊ कथै कि करम के दवारा बिस्वास के परगट होमै के कइसन जरूरी हबै? <char style="ior"><ref loc="JAS 2:1-26">2:1-26</ref></char></para>
  <para style="io1">4. ओखर बाद ऊ कथै कि मुंह लग निकरे सब्द केतका सक्तिसाली हुइ सकथै। <char style="ior"><ref loc="JAS 3:1-12">3:1-12</ref></char></para>
  <para style="io1">5. तब याकूब हबै कि कइसन भगवान के बुध्दि दुनिया के बुध्दि लग अगले हबै। <char style="ior"><ref loc="JAS 3:13-4:10">3:13—4:10</ref></char></para>
  <para style="io1">6. एखर बाद ऊ अपन पढै बाले के घमंड होमै के खिलाफ चेतन्त देथै। <char style="ior"><ref loc="JAS 4:11-5:6">4:11—5:6</ref></char></para>
  <para style="io1">7. याकूब कुछ सही निरदेस दइके अपन किताब हे समापत करथै। <char style="ior"><ref loc="JAS 5:7-20">5:7-20</ref></char></para>
  <chapter number="1" style="c" sid="JAS 1" />
  <para style="s">सोगत</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 1:1" />हइ चिट्ठी भगवान अउ परभु यीसु मसीह के हरवाह याकूब के पल्ला लग हबै, दुनिया भर हे फइले हर बाराठे कुर के नमस्ते।<verse eid="JAS 1:1" /></para>
  <para style="s">बिस्वास कर परिक्छा</para>
  <para style="p">
    <verse number="2" style="v" sid="JAS 1:2" />हे मोर भाई अउ बेहन, जब तुम्हर उप्पर कइन मेर के परिक्छा हे पडा, तब इके बडा खुसी के बात समझिहा। <verse eid="JAS 1:2" /><verse number="3" style="v" sid="JAS 1:3" />काखे तुम जानत हबा कि तुम्हर बिस्वास के परिक्छा होय के बाद धीरज पइदा होथै। <verse eid="JAS 1:3" /><verse number="4" style="v" sid="JAS 1:4" />धीर के अपन काम पूर करै देया कि तुम निरदोस अउ सिध्द हुइ जा, अउ तुम हे कउनो मेर के कमी झइ रहै। <verse eid="JAS 1:4" /><verse number="5" style="v" sid="JAS 1:5" />अगर तुम्हर मसे कउनो के दिमाक के कमी होय ता भगवान लग पराथना करा ता तुमही दिमाक मिलही, काखे भगवान खुले हाथ बाले अउ खुसी लग सब के देथै। <verse eid="JAS 1:5" /><verse number="6" style="v" sid="JAS 1:6" />पय उके बिस्वास के संग अउ बिना सक के पराथना करै चाही, काखे जउन सक करथै, ऊ समुन्दर के लहरा के जसना हबै, जउन हवा लग इछो-उछो उछलथै। <verse eid="JAS 1:6" /><verse number="7" style="v" sid="JAS 1:7" />असना मनसे हइ झइ समझै कि मोके परभु लग कुछु मिलही, <verse eid="JAS 1:7" /><verse number="8" style="v" sid="JAS 1:8" />असना मनसे सक्की मन के बजय लग अपन सगलू आदत हे स्थिर नेहको हबै।<verse eid="JAS 1:8" /></para>
  <para style="s">गरीबी अउ अमीर</para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 1:9" />तरी पद बाले भाई मसीही मनसे, अपन ऊंच पद हे खुस रहै। <verse eid="JAS 1:9" /><verse number="10" style="v" sid="JAS 1:10" />जउन धनी मनसे हबै, उनके खुस रहै चाही, काखे ऊ जंगली चारा के फूल मेर नास हुइ जही। <verse eid="JAS 1:10" /><verse number="11" style="v" sid="JAS 1:11" />जब बेरा निकरथै, अउ घांम तिपै लग चारा मुरझाय जथै अउ फूल झर जथै, अउ ओखर चमक नास हुइ जथै, इहैमेर धनी मनसे अपन रास्ता हे चलत-चलत अउ अपन तरीका लग जिन्दगी बिताउत अक रोज माटी हे मिल जइहिन<note caller="+" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="PSA 102:11">भजन 102:11</ref>; <ref loc="ISA 40:7-8">यसा 40:7-8</ref></char></note>।<verse eid="JAS 1:11" /></para>
  <para style="s">परिक्छा</para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 1:12" />धन्य हबै ऊ, जउन मनसे परिक्छा हे ठाड रथै काखे परिक्छा हे खरा उतरै हे उके जीवन के ऊ मुकुट मिलही, जेही परभु अपन सेबक के दे के टीमा अपन माया करै बाले लग करे हबै। <verse eid="JAS 1:12" /><verse number="13" style="v" sid="JAS 1:13" />परिक्छा हे पडे हर कउ हइ झइ कहै, कि भगवान मोके परिक्छा हे डाले हबै, काखे न तो भगवान के कउनो परिक्छा हे डाले जा सकथै, अउ न ऊ खुद कउनो के परिक्छा हे डालथै। <verse eid="JAS 1:13" /><verse number="14" style="v" sid="JAS 1:14" />पय हर मनसे अपनै अभिलासा हे फसके परिक्छा हे पड जथै <verse eid="JAS 1:14" /><verse number="15" style="v" sid="JAS 1:15" />फेर अभिलासा गरभबती हुइके पाप के पइदा करथै अउ पाप जब बढ जथै ता मिरतू के पइदा करथै।<verse eid="JAS 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JAS 1:16" />हे मोर पिरिया भाई अउ बेहन, तुम धोखा झइ खा। <verse eid="JAS 1:16" /><verse number="17" style="v" sid="JAS 1:17" />काखे हर अक्ठी निक्खा बरदान अउ निरदोस दान बाफ लग हबै, मतलब उजियार के बनामै बाले भगवान के पल्ला लग हबै, जेहमा न तो कउनो बदलाव हबै अउ न अदल-बदल हबै। <verse eid="JAS 1:17" /><verse number="18" style="v" sid="JAS 1:18" />भगवान अपनै इक्छा लग सही के बचन के दवारा हमके जीवन दय हबै, जेखर लग हम अक मेर लग ओखर बनाय हर पहिला फडुहा बनी।<verse eid="JAS 1:18" /></para>
  <para style="s">ओखर बचन सुना अउ ऊ रास्ता हे चला</para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 1:19" />हे मोर पिरिया भाई अउ बेहन, तुम हइ अच्छी तरह लग समझ लेया, हर मनसे सुनै के निता तइयार रहा, पय बोलैका अउ गुस्सा करै हे धीम रहा, <verse eid="JAS 1:19" /><verse number="20" style="v" sid="JAS 1:20" />काखे मनसे के गुस्सा भगवान के नियाइपन के निरवाह नेहको के सकथै। <verse eid="JAS 1:20" /><verse number="21" style="v" sid="JAS 1:21" />इहैनिता तुम्हर जिन्दगी हे जउन बुराई अउ गुस्सा हबै, उके दूर करके ऊ संदेस के नमरता लग अपनाउत जा, जउन तुम्हर मन हे बोय जथै, अउ तुम्हर आतमा के मुकति करै हे सक्ति हबै।<verse eid="JAS 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JAS 1:22" />पय बचन हे चले बाले बना, न कि सुनै बाले, जउन खुद के धोखा देथै। <verse eid="JAS 1:22" /><verse number="23" style="v" sid="JAS 1:23" />काखे अगर कउ बचन के सिक्छा केबल सुनै बाले हबै अउ पालन नेहको करथै, ऊ उस मनसे के जसना हबै, जउन अपन मुंह अइना हे देखथै। <verse eid="JAS 1:23" /><verse number="24" style="v" sid="JAS 1:24" />ऊ खुद के देख के कढ जथै, अउ उके सुरता नेहको रथै कि मोर सकल कइसन हबै। <verse eid="JAS 1:24" /><verse number="25" style="v" sid="JAS 1:25" />पय जउन मनसे भगवान के सिध्द इक्छा के जसना करै के नेहको बिसरथै, ओखर काम के परिनाम धन्य होही।<verse eid="JAS 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 1:26" />अगर कउ मनसे खुद के भक्त समझथै अउ फेर अपन जीभ हे रोक नेहको लगाथै, ऊ अपन मन के धोखा हे रखथै अउ ओखर महिमा बेकार हबै<note caller="+" style="x"><char style="xo" closed="false">1:26 </char><char style="xt" closed="false"><ref loc="PSA 34:13">भजन 34:13</ref>; <ref loc="PSA 141:3">141:3</ref></char></note>। <verse eid="JAS 1:26" /><verse number="27" style="v" sid="JAS 1:27" />हमर भगवान अउ बाफ के नजर हे बिलकुन सुध्द अउ निरदोस महिमा हइ हबै, परेसानी हे पडे अनाथ अउ बिधवा के सुधि ले अउ खुद के दुनिया के बेकार काम लग अलगे रखै।<verse eid="JAS 1:27" /></para>
  <chapter eid="JAS 1" />
  <chapter number="2" style="c" sid="JAS 2" />
  <para style="s">पक्छपात के बिरोध चेतन्त</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 2:1" />हे मोर भाई, तुम हमर महिमामय परभु यीसु मसीह हे बिस्वास करथा, इहैनिता पक्छपात चुगुलखोरी लग दुरिहां रइहा<note caller="+" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="JOB 34:19">अयूब 34:19</ref>; <ref loc="PSA 24:7-10">भजन 24:7-10</ref></char></note>। <verse eid="JAS 2:1" /><verse number="2" style="v" sid="JAS 2:2" />मान लेया कि तुम्हर मंडली हे सोन के मुदरी अउ मंहगा खुरथा पइजामा पहिने कउ मनसे घुसथै, अउ साथ हे फटहा पुरान कपडा पहिने कउ गरीब, <verse eid="JAS 2:2" /><verse number="3" style="v" sid="JAS 2:3" />अगर तुम मंहगा खुरथा पइजामा पहिने मनसे के मुंह देख के ओखर लग कइहा, “तै इछो निक्खा जिघा हे बइठा” अउ गरीब मनसे लग कइहे, “तै इछो ठाड रइहे” या “मोर गोड दबामै के लिघ्घो बइठ।” <verse eid="JAS 2:3" /><verse number="4" style="v" sid="JAS 2:4" />ता का अपन मन हे छुवाछूत नेहको करथै? अउ बेकार बिचार के जसना नियाव करै बाले नेहको ठहरिन।<verse eid="JAS 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 2:5" />हे मोर पिरिया भाई अउ बेहन, सुन लेया। का भगवान उन मनसेन के नेहको चुने हबै, जउन दुनिया के नजर हे गरीब हबै, ताकि उन बिस्वास के धन्नड हुइ जाय अउ ऊ राज के बारिसदार बनै, जउन ऊ अपन सेबकन के देय के निता टीमा करे हबै, जउन ओखर लग माया करथै? <verse eid="JAS 2:5" /><verse number="6" style="v" sid="JAS 2:6" />तउभरमा तुम ऊ गरीब मनसे के बेज्जती करे हबा, का धन्नड मनसे तुमही नेहको लूटिस अउ तुमही अदालत हे घसीट के नेहको लइ जथै? <verse eid="JAS 2:6" /><verse number="7" style="v" sid="JAS 2:7" />का उन ऊ निक्खा नाम के बुराई नेहको करथै? जेखर लग तुम गोहराय जथा।<verse eid="JAS 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JAS 2:8" />पवितर किताब के बचन जसना कथै, “तुम अपन परोसी के अपन जसना मेर माया करिहा” ता मूसा कर राज नियम के पूर करथा, ता तुम निक्खा करथा<note caller="+" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="LEV 19:18">लयबेवस्था 19:18</ref></char></note>। <verse eid="JAS 2:8" /><verse number="9" style="v" sid="JAS 2:9" />अगर तुम पक्छपात करत हबा, ता पाप करथा अउ मूसा कर नियम के जसना तुम दोसी ठहरत हबा<note caller="+" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="LEV 19:15">लयबेवस्था 19:15</ref></char></note>। <verse eid="JAS 2:9" /><verse number="10" style="v" sid="JAS 2:10" />अगर कउ मूसा कर नियम के पूरी तरह मानथै, पय ओखर अक्ठी नियम के चूक जही, ता ऊ सगलू नियम के परति पाप करथै, <verse eid="JAS 2:10" /><verse number="11" style="v" sid="JAS 2:11" />काखे जउन कथै, “गलत काम झइ करा” ऊ इहो कथै, “हत्या झइ करा।” इहैनिता अगर तुम गलत काम नेहको करथा, पय हत्या करत हबा, ता तुम नियम के दोसी हुइ गय हबा<note caller="+" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="EXO 20:13-14">निरगमन 20:13-14</ref>; <ref loc="DEU 5:17-18">बेवस्थाबिबरन 5:17-18</ref></char></note>। <verse eid="JAS 2:11" /><verse number="12" style="v" sid="JAS 2:12" />तुम्हर बातचीत अउ तुम्हर चाल चलन उन मनसेन के जसना होय, जिनखर नियाव आजाद मेर नियम के जसना करे जही। <verse eid="JAS 2:12" /><verse number="13" style="v" sid="JAS 2:13" />जउन दया नेहको देखाही, ओखर नियाव बगैर दया करे जही, पय दया नियाव हे जीत पाथै।<verse eid="JAS 2:13" /></para>
  <para style="s">बिस्वास अउ करम</para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 2:14" />हे मोर भाई, अगर कउनो हइ कथै कि मै बिस्वास करथो, पय ओखर मेर चाल चलन नेहको करथै, ता एखर लग का फायदा? का बिस्वास ओखर मुकति कर सकथै? <verse eid="JAS 2:14" /><verse number="15" style="v" sid="JAS 2:15" />अगर कउनो भाई या बेहन के लिघ्घो न पहिने के कपडा होय अउ न खाय के निता कुछ होय। <verse eid="JAS 2:15" /><verse number="16" style="v" sid="JAS 2:16" />अगर तुम्हर मसे कउनो उनखर लग कइहीं, “निक्खा जइहा, जाड हे गरम कपडा पहिरिहा अउ पेट भर खाना खइहा” जब तुम देह के जरूरत के चीज नेहको देथा, ता एखर लग काहिन फायदा? <verse eid="JAS 2:16" /><verse number="17" style="v" sid="JAS 2:17" />इहैमेर अगर ऊ बिस्वास, जेखर परमाड कामन के दवारा नेहको होथै, ता मरे हर हबै।<verse eid="JAS 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JAS 2:18" />अउ असना मनसेन लग कउ कहि सकथै, “तुम बिस्वास करत हबा, पय मै ओखर मेर चाल चलन चलथो। मोके अपन बिस्वास देखाबा जेहमा तुम नेहको चलथा, अउ महुं अपन चाल चलन के दवारा तुमही अपन बिस्वास के परमाड दइहों।” <verse eid="JAS 2:18" /><verse number="19" style="v" sid="JAS 2:19" />तुम बिस्वास करत हबा कि केबल अक्ठी भगवान हबै। ता निक्खा करथै। भूतो असना बिस्वास करथै अउ डेरात रथै। <verse eid="JAS 2:19" /><verse number="20" style="v" sid="JAS 2:20" />मूरुख, का तुम एखर परमाड चाहत हबा कि कामन के बिना बिस्वास बेकार हबै? <verse eid="JAS 2:20" /><verse number="21" style="v" sid="JAS 2:21" />का हमर बाफ अब्राहम अपन कामन के कारन धरमी मनसे नेहको ठहरिस, जब ऊ बेदी हे अपन टोरवा इसहाक के चढाथै<note caller="+" style="x"><char style="xo" closed="false">2:21 </char><char style="xt" closed="false"><ref loc="GEN 22:9">उत्पति 22:9</ref></char></note>? <verse eid="JAS 2:21" /><verse number="22" style="v" sid="JAS 2:22" />तुम देखत हबा कि ओखर बिस्वास ओखर कामो के संग बनै रथै, अउ ओखर कामो के दवारा अउ बिस्वास लग सबले अच्छी ठहराय गय रथै। <verse eid="JAS 2:22" /><verse number="23" style="v" sid="JAS 2:23" />इहैमेर पवितर किताब के हइ बचन पूर हुइस, “अब्राहम भगवान हे बिस्वास करिस, अउ एखरै लग ऊ धरमी मनसे माने गइस अउ भगवान के दोसी कहाइस<note caller="+" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="GEN 15:6">उत्पति 15:6</ref></char></note>।” <verse eid="JAS 2:23" /><verse number="24" style="v" sid="JAS 2:24" />तुम देखत हबा कि मनसे केबल बिस्वास लग नेहको, बकि काम लग धरमी मनसे ठहराय जथै।<verse eid="JAS 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JAS 2:25" />इहैमेर बेसिया राहाब अपन कामन लग धरमी मनसे ठहराय गइस, काखे ऊ अपन घर हे दूतन के सोगत करिस, अउ उनही दूसर गली लग बिदा करिस<note caller="+" style="x"><char style="xo" closed="false">2:25 </char><char style="xt" closed="false"><ref loc="HEB 11:31">इब्रानिन 11:31</ref></char></note>।<verse eid="JAS 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 2:26" />जउन मेर आतमा के बिगर देह मरे हर हबै, उहैमेर करम के बिगर बिस्वास मरे हर हबै।<verse eid="JAS 2:26" /></para>
  <chapter eid="JAS 2" />
  <chapter number="3" style="c" sid="JAS 3" />
  <para style="s">जीभ के बस हे करा</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 3:1" />हे मोर भाई, तुम्हर मसे बोहत झन गुरू झइ बनै, काखे तुम जानत हबा कि हम गुरूवन लग बोहत कडाइ लग हिसाब मांगे जही। <verse eid="JAS 3:1" /><verse number="2" style="v" sid="JAS 3:2" />हम सब बेर-बेर पाप करथन, सिध्द ऊ हबै, जेखर बचन हे कउनो मेर के भूल चूक नेहको होथै, ऊ अपन सगलू देह के काबिज हे रख सकथै। <verse eid="JAS 3:2" /><verse number="3" style="v" sid="JAS 3:3" />अगर हम घोडवा के वस हे रखै के निता ओखर मुंह हे लगाम लगाथै, ता ओखर सगलू देह के इछो-उछो घुमाय सकथै। <verse eid="JAS 3:3" /><verse number="4" style="v" sid="JAS 3:4" />देखा, नाह जिहाज के ऊ केतको बडा काखे न होय अउ बोहत तेज हवा लग भले बहाय जथै, तउभरमा ऊ चलामै बाले के इक्छा के जसना अक्ठी नान हस पतवार लग चलाय जथै। <verse eid="JAS 3:4" /><verse number="5" style="v" sid="JAS 3:5" />इहैमेर जीभ देह के अक्ठी नान हस अंग हबै, पय ऊ सक्तिसाली होमै के दाबा के सकथै। देखा, अक्ठी नान हस आगी के तिनगा लग बडा पतेरा आगी लग लेसर जही। <verse eid="JAS 3:5" /><verse number="6" style="v" sid="JAS 3:6" />जीभ अक्ठी आगी हबै, ओहमा अधरम के दुनिया भरे पडे हबै, हमर अंगन हे जीभ हबै जउन हमर सगलू देह के असुध्द के देथै, अउ नरक लग चमकदार हुइ के हमर जीवन काल हे आगी लगाय देथै। <verse eid="JAS 3:6" /><verse number="7" style="v" sid="JAS 3:7" />हर मेर के गोरू अउ चिरइया, रेंगै बाले जीव, अउ पानी हे रहै बाले जीव, सब के सब मनसेन के दवारा वस हे हुइ सकथै या वस हे हुइ गय हबै, <verse eid="JAS 3:7" /><verse number="8" style="v" sid="JAS 3:8" />पय जीभ के कउ मनसे अपन वस हे नेहको के सकथै, ऊ अक्ठी असना बुराई करै बाले हबै, जउन कबहुन सान्त नेहको रथै अउ परान के नास करे बाले बिस लग भररे हर हबै<note caller="+" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="PSA 140:3">भजन 140:3</ref></char></note>। <verse eid="JAS 3:8" /><verse number="9" style="v" sid="JAS 3:9" />हम ओखरै लग अपन परभु या बाफ के महिमा करथन, अउ ओखरै लग मनसेन के सरापथन, जउन भगवान के मेर बनाय गय हबन। <verse eid="JAS 3:9" /><verse number="10" style="v" sid="JAS 3:10" />अक्ठिन मुंह लग आसीस अउ सराप दुनो निकडथै, हे मोर भाई अउ बेहन हइ सही नेहको हबै। <verse eid="JAS 3:10" /><verse number="11" style="v" sid="JAS 3:11" />का अक्ठी पानी के झरना लग कडु अउ गुरतुर दुनो निकडथै? <verse eid="JAS 3:11" /><verse number="12" style="v" sid="JAS 3:12" />हे मोर भाई, का अंजीर के रूख लग जैतून के रूख लगही, या रूख के डगइल लग अंजीर लग सकथै? ओसनेन नुनछुर पानी झरना लग गुरतुर पानी नेहको निकडथै। <figure style="fig" alt="Rider on a horse" file="lb00035c.tif" size="col" copy="Horace Knowles ©" ref="3:3">घोडवा हे सवार</figure><verse eid="JAS 3:12" /></para>
  <para style="s">स्वरगी सिक्छा</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 3:13" />तुम्हर मसे जउन ग्यानी अउ समझदार कोन हबै? ऊ अपन चाल चलन के दवारा अपन कोवड या होसियारचंद बेउहार दवारा हइ बात के परमाड देया। <verse eid="JAS 3:13" /><verse number="14" style="v" sid="JAS 3:14" />अगर तुम्हर मन कडवा जलन अउ मतलब लग भररे हर हबै, ता एखर घमंड करत झूठ के सही बनाय के पेस झइ तो करा। <verse eid="JAS 3:14" /><verse number="15" style="v" sid="JAS 3:15" />हइ मेर के ग्यान भगवान लग नेहको आथै, पय सांसारिक, स्वभाविक देह अउ भुतवा हबै। <verse eid="JAS 3:15" /><verse number="16" style="v" sid="JAS 3:16" />जछो जलन अउ मतलबिहा हबै, उछो असान्ति अउ हर मेर के बुराई पाय जथै। <verse eid="JAS 3:16" /><verse number="17" style="v" sid="JAS 3:17" />पय जउन ग्यान भगवान के तरफ लग आथै ऊ निरदोस हबै, अउ ऊ सान्ति लग, सहै बाले, दया, करुना, निक्खा काम करै बाले, कउनो मेर के पक्छपात नेहको, मन हे कउनो मेर के कपट झइ होय<note caller="+" style="x"><char style="xo" closed="false">3:17 </char><char style="xt" closed="false"><ref loc="ISA 32:17">यसा 32:17</ref></char></note>। <verse eid="JAS 3:17" /><verse number="18" style="v" sid="JAS 3:18" />मेल जोल करामै बाले मनसे सान्ति के बिजहा बोमै के दवारा नियाइपन के उपज अक जिघा करथै।<verse eid="JAS 3:18" /></para>
  <chapter eid="JAS 3" />
  <chapter number="4" style="c" sid="JAS 4" />
  <para style="s">दुनिया मन के बारे हे चेतन्त</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 4:1" />तुम्हर बीच डाह अउ लडाई झगडा कछो लग आथै? का उन सुख बिलास तो नेहको, जउन तुम्हरे अंगन लग लडत भिडत हबै? <verse eid="JAS 4:1" /><verse number="2" style="v" sid="JAS 4:2" />तुम लालसा रखथा, इहैनिता हत्या करथा। तुम जउन चीज के निता डाह करथा, उके नेहको पाथा इहैनिता लडत भिडत हबा। तुम नेहको मांगथा इहैनिता तुमही कुछु नेहको मिलथै। <verse eid="JAS 4:2" /><verse number="3" style="v" sid="JAS 4:3" />जब तुम मंगतो हबा, इहैनिता नेहको पाउत हबा कि अच्छी तरह लग नेहको मांगथा, तुम अपन सुख बिलास के निता मांगथा। <verse eid="JAS 4:3" /><verse number="4" style="v" sid="JAS 4:4" />हे गलत काम करै बाले, का तुम हइ नेहको जानथा कि दुनिया लग माया रखै के मतलब हबै भगवान लग दुसमनी करना? जउन दुनिया के दोसी होमै चाहथै, ऊ भगवान के बैरी बन जथै<note caller="+" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="1JN 2:15-16">1 यूहन्ना 2:15-16</ref></char></note>। <verse eid="JAS 4:4" /><verse number="5" style="v" sid="JAS 4:5" />काहिन तुम समझत हबा कि पवितर किताब बेकार कथै, “जउन आतमा के भगवान हमर भित्तर बसाय हबै, ओही ऊ बडा माया लग चाहथै?” <verse eid="JAS 4:5" /><verse number="6" style="v" sid="JAS 4:6" />ऊ तो अबे सान्ति देथै, जसना कि पवितर किताब हे लिखवरे हबै, “भगवान घमंडिन के बिरोध करथै, पय नम्र मनसे हे अनुगरह किरपा करथै।”<verse eid="JAS 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 4:7" />तुम भगवान के अधीन रहा, भुतवा के सामना करिहा अउ ऊ तुम्हर लिघ्घो लग भाग जही। <verse eid="JAS 4:7" /><verse number="8" style="v" sid="JAS 4:8" />भगवान के लिघ्घो अइहा ता ऊ तुम्हरो लिघ्घो आही, हे पापियो, अपन हाथ सुध्द करा, अउ हे कपटी मनसे अपन मन पवितर करा<note caller="+" style="x"><char style="xo" closed="false">4:8 </char><char style="xt" closed="false"><ref loc="ZEC 1:3">जकर 1:3</ref>; <ref loc="MAL 3:7">मलाकी 3:7</ref></char></note>। <verse eid="JAS 4:8" /><verse number="9" style="v" sid="JAS 4:9" />अपन दुरदसा पहिचान के दुख मनाबा अउ आंसू बहाबा, अपन हसी दुख हे अउ अपन खुसी उदासी हे बदल डारा। <verse eid="JAS 4:9" /><verse number="10" style="v" sid="JAS 4:10" />परभु के आगू नम्र बनिहा ता ऊ तुमही सिरोमडी बनाही<note caller="+" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="PSA 147:6">भजन 147:6</ref></char></note>।<verse eid="JAS 4:10" /></para>
  <para style="s">भाई हे दोस लगाथै</para>
  <para style="p">
    <verse number="11" style="v" sid="JAS 4:11" />हे भाई अउ बेहन, अक दूसर के बुराई झइ करा। जउन अपन भाई या बेहन के बुराई करथै या अपन भाई या बेहन के नियाव करथै, ऊ मूसा कर नियम के बुराई अउ ओखर नियाव करथै। अगर तुम मूसा कर नियम के नियाव करत हबा, ता तुम ओखर नियम के पालन नेहको, बलकि सजा देय बाले बन बइठे हबा। <verse eid="JAS 4:11" /><verse number="12" style="v" sid="JAS 4:12" />केबल अक्ठिन नियम अउ अक्ठिन सजा देय बाले हबै, जउन बचामै अउ नास करै के सक्ति हबै। अपन परोसी के नियाव करै बाले तै कउन हबस?<verse eid="JAS 4:12" /></para>
  <para style="s">घमंड के बारे हे चेतन्त</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 4:13" />तुम जउन हइ कथा, “हम आज या कल हमु सहर जउबे, अक साल तक उछो रही के धन्धा करबे अउ पइसा कमाबो” मोर बात सुना। <verse eid="JAS 4:13" /><verse number="14" style="v" sid="JAS 4:14" />तुम नेहको जानथा कि कल तुम्हर का हालत होही। तुम्हर जीवन अक्ठी कोहिटा मेर हबा, ऊ अक घरी देखही फेर उजाय जही<note caller="+" style="x"><char style="xo" closed="false">4:14 </char><char style="xt" closed="false"><ref loc="PRO 27:1">नीति 27:1</ref></char></note>। <verse eid="JAS 4:14" /><verse number="15" style="v" sid="JAS 4:15" />तुमही हइ कहै चाही, “अगर परभु के इक्छा होही, ता हम जिन्दा रहबो अउ हइ या ऊ काम करब।” <verse eid="JAS 4:15" /><verse number="16" style="v" sid="JAS 4:16" />पय तुम अपन बडाई हे घमंड करत हबा, हइ घमंड पाप लग भरे हबै, <verse eid="JAS 4:16" /><verse number="17" style="v" sid="JAS 4:17" />जउन मनसे भलाई करै के जानथै, पय नेहको करथै उके पाप लगथै। <figure style="fig" alt="Customer, merchant with his wares" file="hk00172c.tif" size="col" copy="Horace Knowles ©" ref="4:13">गराहक अउ सेठ अपन सामान के संग</figure><verse eid="JAS 4:17" /></para>
  <chapter eid="JAS 4" />
  <chapter number="5" style="c" sid="JAS 5" />
  <para style="s">धन्नड मनसे के चेतन्त</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 5:1" />हे धन्नड मनसे, मोर बात के सुना, तुमही रोमैका अउ आंसू बहामै चाही, काखे परेसानी तुम्हर उप्पर आमै बाले हबै। <verse eid="JAS 5:1" /><verse number="2" style="v" sid="JAS 5:2" />तुम्हर धन सर गय हबै अउ तुम्हर बन्डी हे किरवा लग गय हबै। <verse eid="JAS 5:2" /><verse number="3" style="v" sid="JAS 5:3" />तुम्हर सोना-चांदी हे मुरचा लग गय हबै, ऊ मुरचा तुम्हर बिरोध गवाह देही, ऊ आगी के मेर तुम्हर देह के खाय जही, हइ दुनिया के आखरी टेम हबै अउ तुम डेरा जइजात बोहत जोड लय हबा। <verse eid="JAS 5:3" /><verse number="4" style="v" sid="JAS 5:4" />मजदुरिहा तुम्हर फसल के काटिन, अउ तुम उनखर मजदूरी नेहको दया, ऊ मजदुरिहा तुम्हर बिरोध गवाह देथै, फसल काटै बाले पुकारथै, उन मजदुरिहन के आरो सेनाओ के परभु तक पहुंच चुके हबै<note caller="+" style="x"><char style="xo" closed="false">5:4 </char><char style="xt" closed="false"><ref loc="LEV 19:13">लयबेवस्था 19:13</ref></char></note>। <verse eid="JAS 5:4" /><verse number="5" style="v" sid="JAS 5:5" />तुम भुंइ हे हर मेर के सुख अउ अपन इक्छा के जसना जीवन बिताय हबा, अउ बलि चढामै के रोज के निता खुद के मोटा ताजा बनाय लय हबा। <verse eid="JAS 5:5" /><verse number="6" style="v" sid="JAS 5:6" />तुम धरमी मनसेन के दोसी बनाय के मार डारे हबा, अउ उन तुम्हर कउनो बिरोध नेहको करिन।<verse eid="JAS 5:6" /></para>
  <para style="s">दुख हे धीर धरिहा</para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 5:7" />इहैनिता हे भाई, परभु के आमै तक धीर धरा। जसना किसान भुंइ के देख ले जउन खेत के मंगहा फसल के निता तब तक धीर धरथै जब तक ऊ सुरू के अउ आखरी बरसा नेहको देख ले<note caller="+" style="x"><char style="xo" closed="false">5:7 </char><char style="xt" closed="false"><ref loc="DEU 11:14">बेवस्थाबिबरन 11:14</ref></char></note>। <verse eid="JAS 5:7" /><verse number="8" style="v" sid="JAS 5:8" />तुमो धीर धरा, हिम्मत झइ हारा, काखे परभु के आमैके टेम लिघ्घो हबै।<verse eid="JAS 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 5:9" />हे भाई अउ बेहन अक दूसर के उप्पर दोस झइ लगाबा, जेखर लग तुम्हरो हे दोस नेहको लगाय जही, देखा, नियाव करै बाले जज दूरा हे ठाड हबै। <verse eid="JAS 5:9" /><verse number="10" style="v" sid="JAS 5:10" />हे भाई अउ बेहन, धीर के संग दुख उठामै के बारे हे उन ग्यानी मनसेन के सुरता करा, जउन परभु के नाम लग चेतन्त दय रथै। <verse eid="JAS 5:10" /><verse number="11" style="v" sid="JAS 5:11" />हम उनही धन्य समझथन, जउन धीर के संग रथै, तुम अय्यूब के धीर के बारे हे सुने हबा अउ तुम जानत हबा, कि परभु आखरी हे ओखर संग कइसन बेउहार करिस, काखे परभु दया के धन्नड हबै।<verse eid="JAS 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 5:12" />पय हे मोर भाई, सगलू बडा बात हइ हबै, कि तुम किरिया झइ खइहा, न स्वरग के, न भुंइ के, न कउनो चीज के, पय तुम्हर बातचीत हव के हव अउ नेहको के नेहको होय, कहुं असना झइ होय कि तुम सजा के काबिल हुइ जा।<verse eid="JAS 5:12" /></para>
  <para style="s">बिस्वास के पराथना</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 5:13" />अगर तुम्हर मसे कउनो दुख हे होंय, ता ऊ पराथना बिनती करै, अगर कउ खुस होंय, ता महिमा करै। <verse eid="JAS 5:13" /><verse number="14" style="v" sid="JAS 5:14" />अगर तुम्हर मसे कउ नंगहा हबै, ता मंडली के सियानन के बुलवामै, अउ ऊ परभु के नाम लग ओखर हे तेल मलके ओखर निता पराथना बिनती करै। <verse eid="JAS 5:14" /><verse number="15" style="v" sid="JAS 5:15" />ऊ बिस्वास के पराथना के दवारा रोगिया बच जही अउ परभु उके ठाड करही। अगर ऊ पाप करे हबै, ता उके छमा के दय जही। <verse eid="JAS 5:15" /><verse number="16" style="v" sid="JAS 5:16" />इहैनिता तुम अक दूसर के आगू अपन-अपन पापन के मान लेया, अउ अक दूसर के निता पराथना बिनती करिहा, जेखर लग तुम निक्खा हुइ जइहा, धरमी मनसे के पराथना के बल लग बोहत कुछु हुइ सकथै। <verse eid="JAS 5:16" /><verse number="17" style="v" sid="JAS 5:17" />आगू कर बात गुठेमै बाले एलिय्याह हमरेन मेर मनसे रथै, ऊ बिस्वास के संग पराथना बिनती करिस कि पानी झइ बरसै, अउ साढे तीन साल तक भुंइ हे पानी नेहको बरसिस<note caller="+" style="x"><char style="xo" closed="false">5:17 </char><char style="xt" closed="false"><ref loc="1KI 17:1">1 राजा 17:1</ref></char></note>। <verse eid="JAS 5:17" /><verse number="18" style="v" sid="JAS 5:18" />एलिय्याह फेरै पराथना बिनती करिस, ता बादर लग पानी बरसिस, अउ भुंइ हे दाना उपजिस<note caller="+" style="x"><char style="xo" closed="false">5:18 </char><char style="xt" closed="false"><ref loc="1KI 18:42-45">1 राजा 18:42-45</ref></char></note>।<verse eid="JAS 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 5:19" />मोर भाई अउ बेहन, अगर तुम्हर मसे कउ सही रास्ता लग भटक जइही अउ कउ दूसर उके फेर लनहीं, <verse eid="JAS 5:19" /><verse number="20" style="v" sid="JAS 5:20" />ता हइ समझही कि जउन कउनो भटके हर पापी के फेरै ले आनथै, ऊ ओखर आतमा के मिरतू लग बचाय हबै अउ बोहत पापन के मूंद देथै<note caller="+" style="x"><char style="xo" closed="false">5:20 </char><char style="xt" closed="false"><ref loc="PRO 10:12">नीति 10:12</ref></char></note>।<verse eid="JAS 5:20" /></para>
  <chapter eid="JAS 5" />
</usx>