<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="GEN" style="id">id GEN - Bhumiya Test Project</book>
  <para style="h">उत्पत्ति</para>
  <para style="toc3">उत्पत्ति</para>
  <para style="toc2">उत्पत्ति</para>
  <para style="toc1">उत्पत्ति कर किताब</para>
  <para style="mt2">उत्पत्ति के किताब</para>
  <para style="mt1">उत्पत्ति कर किताब</para>
  <para style="imt">परचा</para>
  <para style="ip">उत्पत्ति सब्द कर मतलब हबै “सुरुआत” अउ हइ बाइबल के पुरान नियम के पहली किताब हबै। मूल हिब्रू हइ सब्दन लग सुरू होथै “सुरुआत हे।” हइ दरसाथै कि सगलू कुछ कछो लग आइस, अउ बिसेस रूप लग मनसेन के संग भगवान कर बेउहार कसना सुरू हुइस। आज बिद्वमान के लिघ्घो ऊ मनसे या मनसेन के बारे हे कइठे सिद्धांत हबै, जउन उत्पत्ति लिखिस अउ हइ कि हइ कब लिखे गय रथै। कुछ मनसेन के माने के हबै, कि इके 5-6 वीं सताब्दी ईसा पूरव हे पुरान दस्ताबेजन लग संकलित करे गय होही। बेबीलोन हे, दूसर मनसे हइ पारंपरिक मानता के स्बीकार करथै, कि मूसा उत्पत्ति, संग ही निरगमन, लैव्यबेवस्था, गिनती अउ बेवस्थाविवरन लगभग 1300 या 1400 साल ईसा पूरव लिखे रथै। उत्पत्ति हे बोहत खास जानकारी हबै, जउन मसीहन के बाइबल के बाकी हिस्सन, पुरान अउ नबा नियम दोंनो के समझै हे मदत करथै। हइ हमके दिखाथै, कि पाप दुनिया हे कसना परबेस करिस, अउ मनसेन के अक्ठी मुकति करै बाले कर जरूरत हबै। हइ मनसेन के बचामै के निता भगवान कर योजना के परगट करथै। इके यीसु के बारे हे पहली आगू कर बात (उत्पत्ति 3:15) अउ इब्राहीम लग भुंइ हे सगलू देसन के आसीरवाद देय के भगवान कर टीमा (उत्पत्ति 12:3) लग देखे जाय सकथै।</para>
  <para style="iot">रूप रेखा</para>
  <para style="io1">1. जसना कि अध्याय 1 अउ 2 हे गुठे गय हबै, भगवान दुनिया अउ आदम अउ हब्बा कर रचना करिस।</para>
  <para style="io1">2. अध्याय 3 - 5 हे आदम अउ हब्बा, उनखर पाप अउ उनखर बिरादरी कर बिस्तार हबै।</para>
  <para style="io1">3. अध्याय 6 - 9 तक नूह अउ बडा बाढ के बारे हे गुठेबै।</para>
  <para style="io1">4. फेरै उत्पत्ति कर किताब अध्याय 10 अउ 11 हे बिस्तार करथै, कि नूह के टेम अउ अब्राहम के टेम के बीच काहिन हबै, जेहमा बाबेल कर मीनार सामिल हबै।</para>
  <para style="io1">5. अध्याय 12 - 50 अब्राहम, ओखर परवार अउ इस्राएल देस के सुरुआत के बारे हे हबै।</para>
  <para style="io1">ए. इब्राहीम अउ ओखर डउकी सारा कर जीवन अध्याय 12 लग 25 हे सामिल हबै।</para>
  <para style="io1">बी. इसहाक अउ ओखर डउकी रिबका कर जीवन अध्याय 21 - 28 हे बिस्तार हबै, अउ ओखर मिरतू कर बिस्तार अध्याय 35 हे करे गय हबै।</para>
  <para style="io1">सी. याकूब, ओखर टोरवन कर जीवन अउ कनान लग मिस्र तक उनखर स्थान्तरन अध्याय 25 - 50 हे सामिल हबै।</para>
  <para style="io1">डी. अध्याय 37 - 50 याकूब कर परसंद टोरवा यहोसू कर जीवन हे केंद्रित हबै अउ ऊ मिस्र हे कसना राजा बनिस।</para>
  <chapter number="1" style="c" sid="GEN 1" />
  <para style="s">भगवान दुनिया के बनाइस</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 1:1" />सुरु हे, भगवान आकास अउ भुंइ के बनाइस<note caller="+" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="HEB 1:10">इब्रानिन 1:10</ref>; <ref loc="HEB 11:3">11:3</ref></char></note> <verse eid="GEN 1:1" /><verse number="2" style="v" sid="GEN 1:2" />भुंइ बेढंग अउ सुनसान रथै, अउ गहीर पानी कर उप्पर अंधियार रथै, पय भगवान कर आतमा पानी के उप्पर मडराथै। <verse eid="GEN 1:2" /><verse number="3" style="v" sid="GEN 1:3" />तब भगवान कहिस, उजियार हुइ जा, ता उजियार हुइ गइस। <verse eid="GEN 1:3" /><verse number="4" style="v" sid="GEN 1:4" />अउ भगवान उजियार के देखिस ता कहिस निक्खा हबै, अउ भगवान उजियार के अंधियार लग अलगे करिस। <verse eid="GEN 1:4" /><verse number="5" style="v" sid="GEN 1:5" />अउ भगवान उजियार के दिन अउ अंधियार के रात कहिस, मतलब संझा हुइस फेर बिहन्ने हुइस, हइ मेर लग पहिले रोज हुइस। <verse eid="GEN 1:5" /><verse number="6" style="v" sid="GEN 1:6" />फेर भगवान कहिस, पानी कर बीच अक असना अन्तर हुइ जा कि पानी दुइ भाग हुइ जाय। <verse eid="GEN 1:6" /><verse number="7" style="v" sid="GEN 1:7" />तब भगवान अक अन्तर बनाय के ओखर तरी कर पानी अउ ओखर उप्पर कर पानी के अलगे-अलगे करिस, अउ ओसनेन हुइ गइस। <verse eid="GEN 1:7" /><verse number="8" style="v" sid="GEN 1:8" />अउ भगवान ऊ अन्तर के आकास कहिस, मतलब संझा हुइस फेर बिहन्ने हुइस, हइ मेर लग दूसर रोज हुइस। <verse eid="GEN 1:8" /><verse number="9" style="v" sid="GEN 1:9" />फेर भगवान कहिस, आकास कर तरी पानी अक जिघा अकजुट हुइ जाय अउ झूर भुंइ दिखाई दे, अउ ओसनेन हुइ गइस<note caller="+" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="2PE 3:5">2 पतरस 3:5</ref> </char></note> <verse eid="GEN 1:9" /><verse number="10" style="v" sid="GEN 1:10" />भगवान झुराय हर जमीन के भुंइ कहिस अउ जउन पानी अकजुट हुइस ओही समुन्दर कहिस अउ भगवान देखिस ता कहिस निक्खा हबै। <verse eid="GEN 1:10" /><verse number="11" style="v" sid="GEN 1:11" />फेर भगवान कहिस भुंइ लग हरियर चारा अउ बिजहा बाले नान-नान पउधा अउ फडुहा बाले रूख जिनखर बिजहा उनखरै हे अक-अक्ठी जात के जसना हबै, अउ भुंइ हे जमै अउ ओसनेन हुइ गइस<note caller="+" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="1CO 15:38">1 कुरि 15:38</ref></char></note>। <verse eid="GEN 1:11" /><verse number="12" style="v" sid="GEN 1:12" />हइ मेर भुंइ लग हरियर चारा, अउ नान-नान पउधा जउन अपन-अपन जात कर जसना बिजहा होथै, अउ फडुहा बाले जिनखर बिजहा अक-अक्ठी जात कर जसना उनखरै हे होथै अउ उगै अउ भगवान देखिस ता कथै निक्खा हबै। <verse eid="GEN 1:12" /><verse number="13" style="v" sid="GEN 1:13" />तब संझा हुइस फेर बिहन्ने हुइस, हइ मेर लग तीसर रोज हुइस। <verse eid="GEN 1:13" /><verse number="14" style="v" sid="GEN 1:14" />फेर भगवान कथै दिन के रात लग अलगे करै के निता आकास के अन्तर हे जोती होय, अउ चिन्हा अउ निस्चित टेम अउ दिन अउ साल के कारन होय। <verse eid="GEN 1:14" /><verse number="15" style="v" sid="GEN 1:15" />अउ ऊ जोती आकास के अन्तर हे भुंइ हे उजियार देय बाले ठहरै, अउ ओसनेन हुइ गइस। <verse eid="GEN 1:15" /><verse number="16" style="v" sid="GEN 1:16" />अउ भगवान दुइठे बडा-बडा जोती बनाइस, दिन हे राज करै के निता बेरा अउ रात हे राज करै के निता जोनइहा बनाइस, अउ तराइयन के बनाइस। <verse eid="GEN 1:16" /><verse number="17" style="v" sid="GEN 1:17" />भगवान उनही आकास के अन्तर हे इहैनिता रखिस कि ऊ भुंइ हे उजियार दे, <verse eid="GEN 1:17" /><verse number="18" style="v" sid="GEN 1:18" />तब दिन अउ रात हे राज करै, अउ उजियार के अंधियार लग अलगे करिस, अउ भगवान देखिस ता कहिस निक्खा हबै। <verse eid="GEN 1:18" /><verse number="19" style="v" sid="GEN 1:19" />तब संझा हुइस फेर बिहन्ने हुइस, हइ मेर लग चउथा रोज हुइस। <verse eid="GEN 1:19" /><verse number="20" style="v" sid="GEN 1:20" />तब भगवान कथै, “समुन्दर के जिन्दा परानी जलचरन लग भर जाय, अउ चिरइया भुंइ कर उप्पर आकास हे उडै।” <verse eid="GEN 1:20" /><verse number="21" style="v" sid="GEN 1:21" />इहैनिता भगवान बडा जीव बनाइस अउ सबैमेर के जिन्दा जीव के बनाइस जउन चलत फिरत हबै, अउ हर मेर के उडै बाले चिराइयन के बनाइस, अउ भगवान देखिस ता कहिस निक्खा हबै। <verse eid="GEN 1:21" /><verse number="22" style="v" sid="GEN 1:22" />अउ भगवान उनके आसीस दइस, फला-फूला, अउ समुन्दर कर पानी हे भर जा, अउ चिरइया भुंइ हे बढै। <verse eid="GEN 1:22" /><verse number="23" style="v" sid="GEN 1:23" />फेर संझा हुइस अउ बिहन्ने हुइस, हइ मेर लग पांच रोज हुइस। <verse eid="GEN 1:23" /><verse number="24" style="v" sid="GEN 1:24" />फेर भगवान कथै, भुंइ लग सबैमेर कर जिन्दा जीव, मतलब रखै बाले पसु, अउ रेंगै बाले जीव, अउ भुंइ के जंगली जानवर नान अउ बडा पइदा होय, अउ ओसनेन हुइ गइस। <verse eid="GEN 1:24" /><verse number="25" style="v" sid="GEN 1:25" />हइ मेर भगवान धरती के जात-जात के वन-पसु अउ जात-जात के घर हे रहै बाले पसुन के अउ जात-जात के भुंइ हे सब रेंगै बाले जीव के बनाइस, अउ भगवान देखिस कि ऊ निक्खा हबै। <verse eid="GEN 1:25" /><verse number="26" style="v" sid="GEN 1:26" />फेर भगवान कथै, मै मनसे के अपन जसना बनाहुं, अउ ऊ समुन्दर के मछडी, अउ आकास कर चिरइया, अउ रखै बाले पसु, अउ सगलू भुंइ हे अउ सगलू रेंगै बाले जीव हे जउन भुंइ हे रेंगथै, उनखर उप्पर हक होय<note caller="+" style="x"><char style="xo" closed="false">1:26 </char><char style="xt" closed="false"><ref loc="JAS 3:9">याकूब 3:9</ref></char></note> <verse eid="GEN 1:26" /><verse number="27" style="v" sid="GEN 1:27" />तब भगवान मनसे के अपन जसना रचिस। अउ ऊ उनही अपन जसना डउका डउकी करके बनाइस।<note caller="+" style="x"><char style="xo" closed="false">1:27 </char><char style="xt" closed="false"><ref loc="MAT 19:4">मत्ती 19:4</ref>; <ref loc="MRK 10:6">मरकुस 10:6</ref>; <ref loc="ACT 17:29">प्रेरितो 17:29</ref>; <ref loc="1CO 11:7">1 कुरि 11:7</ref>; <ref loc="COL 3:10">कुलुस्सियो 3:10</ref>; <ref loc="1TI 2:13">1 तीमु 2:13</ref></char></note> <verse eid="GEN 1:27" /><verse number="28" style="v" sid="GEN 1:28" />अउ भगवान उनही आसीस दइस, अउ उनखर लग कथै, फला-फूला, अउ भुंइ हे भर जा, अउ उनके अपन वस हे कर लेया, अउ समुन्दर कर मछडी, अउ आकास कर चिरइया, अउ भुंइ हे रेंगै बाले सगलू जीव हे हक होय<note caller="+" style="x"><char style="xo" closed="false">1:28 </char><char style="xt" closed="false"><ref loc="GEN 5:1-2">उत्पति 5:1-2</ref></char></note>। <verse eid="GEN 1:28" /><verse number="29" style="v" sid="GEN 1:29" />फेर भगवान उनखर लग कथै, सुना जेतका बीजबाले नान-नान रूख सगलू भुंइ के उप्पर हबै, अउ जेतका फडुहा हे बीज फरथै, उनके सगलू मै दइ दय हव, ऊ तुम्हर खाना खाय के निता हबै<note caller="+" style="x"><char style="xo" closed="false">1:29 </char><char style="xt" closed="false"><ref loc="ROM 14:2">रोमियो 14:2</ref></char></note>। <verse eid="GEN 1:29" /><verse number="30" style="v" sid="GEN 1:30" />अउ जेतका भुंइ कर पसु, अउ आकास कर चिरइया, अउ भुंइ कर जीव हबै, उनके सगलू खाय के निता मै हरियर-हरियर पउधा दय हव, अउ ओसनेन हुइ गइस<note caller="+" style="x"><char style="xo" closed="false">1:30 </char><char style="xt" closed="false"><ref loc="1TI 4:4">1 तीमु 4:4</ref></char></note>। <verse eid="GEN 1:30" /><verse number="31" style="v" sid="GEN 1:31" />तब भगवान जउन कुछ बनाय रथै, सगलू के देखिस, ता का देखिस, कि ऊ बोहत निक्खा हबै, तब संझा हुइस फेर बिहन्ने हुइस, हइ मेर लग छय रोज हुइ गइस।<verse eid="GEN 1:31" /></para>
  <chapter eid="GEN 1" />
  <chapter number="2" style="c" sid="GEN 2" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 2:1" />हइ मेर भुंइ, आकास अउ ओखर हर चीज बनाय हर पूर हुइस।<note caller="+" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="EXO 20:11">निरगमन 20:11</ref>; <ref loc="HEB 4:4-10">इब्रानिन 4:4-10</ref></char></note> <verse eid="GEN 2:1" /><verse number="2" style="v" sid="GEN 2:2" />अउ भगवान अपन काम जउन करथै, सतमा रोज पूर करिस, अउ ऊ अपन करे हर सगलू काम लग सतमा रोज सुस्ताइस।<note caller="+" style="x"><char style="xo" closed="false">2:2 </char><char style="xt" closed="false"><ref loc="HEB 4:4-10">इब्रानिन 4:4-10</ref></char></note> <verse eid="GEN 2:2" /><verse number="3" style="v" sid="GEN 2:3" />अउ भगवान सतमा रोज के आसीस दइस, अउ पवितर ठहराइस, काखे ऊ दुनिया के बनाइस, अउ सगलू काम करै के बाद सुस्ताइस<note caller="+" style="x"><char style="xo" closed="false">2:3 </char><char style="xt" closed="false"><ref loc="EXO 20:11">निरगमन 20:11</ref></char></note>। <verse eid="GEN 2:3" /><verse number="4" style="v" sid="GEN 2:4" />बादर अउ भुंइ के सुरुवात मतलब हइ हबै कि जब ऊ पइदा हुइस।</para>
  <para style="s" vid="GEN 2:4">अदन कर बगिया</para>
  <para style="p" vid="GEN 2:4">मतलब जउन रोज भगवान भुंइ अउ आकास के बनाइस। <verse eid="GEN 2:4" /><verse number="5" style="v" sid="GEN 2:5" />तब भुंइ हे कउनो पउधा नेहको रथै अउ खेत हे कुछ नेहको उगथै, काखे भगवान तब तक भुंइ हे बरिसा नेहको पठोय रथै अउ पउधन के देख-रेख करै बाले मनसे नेहको रथै। <verse eid="GEN 2:5" /><verse number="6" style="v" sid="GEN 2:6" />पय कोहिरा भुंइ लग उठै करथै, जेखर लग सगलू भुंइ सिंचरथै। <verse eid="GEN 2:6" /><verse number="7" style="v" sid="GEN 2:7" />तब भगवान मनसे के जमीन कर माटी लग बनाइस अउ ओखर नाक हे जीवन के सांस फूंकिस अउ मनसे अक्ठी जिन्दा परानी बन गइस।<note caller="+" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="1CO 15:45">1 कुरि 15:45</ref></char></note> <verse eid="GEN 2:7" /><verse number="8" style="v" sid="GEN 2:8" />अउ भगवान पूरब दिसा हे अक्ठी अदन कर बगिया लगाइस, अउ उहां आदम के जउन उके बनाय रथै, रख दइस। <verse eid="GEN 2:8" /><verse number="9" style="v" sid="GEN 2:9" />अउ भगवान हर अक्ठी निक्खा रूख अउ खाय के निता सगलू निक्खा रुखन के ऊ बगिया हे उगाइस, बगिया के बीच हे भगवान जीवन के रूख के रखिस अउ ऊ रूखो के रखिस जउन निक्खा अउ बुरा के जानकारी देथै।<note caller="+" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="REV 2:7">परकासितवाक्य 2:7</ref>; <ref loc="REV 22:14">परकासितवाक्य 22:14</ref></char></note> <verse eid="GEN 2:9" /><verse number="10" style="v" sid="GEN 2:10" />अदन लग हुइके अक्ठी नदिया बहथै अउ ऊ बगिया के पानी देथै, ऊ नदिया आगू जाय के चार नान नदिया बन गइस।<note caller="+" style="x"><char style="xo" closed="false">2:10 </char><char style="xt" closed="false"><ref loc="REV 22:2">परकासितवाक्य 22:2</ref></char></note> <verse eid="GEN 2:10" /><verse number="11" style="v" sid="GEN 2:11" />पहली नदिया कर नाम पीसोन हबै, हइ उहै नदिया हबै जउन हवीला देस कर चारो पार बहथै, जिहां सोना पाय जथै। <verse eid="GEN 2:11" /><verse number="12" style="v" sid="GEN 2:12" />ऊ देस कर सोना चोख्खा होथै, उहां मोती अउ सुलैमानी पथरो मिलथै। <verse eid="GEN 2:12" /><verse number="13" style="v" sid="GEN 2:13" />दूसर नदिया कर नाम गीहोन हबै, हइ उहै नदिया हबै जउन कूस के सगलू देस के चारो पार बहथै। <verse eid="GEN 2:13" /><verse number="14" style="v" sid="GEN 2:14" />अउ तीसर नदिया कर नाम हिद्देकेल हबै, हइ उहै हबै जउन अस्सूर कर पूरब पार बहथै, अउ चउथा नदिया कर नाम फरात हबै। <verse eid="GEN 2:14" /><verse number="15" style="v" sid="GEN 2:15" />तब भगवान आदम के लइके अदन के बगिया हे रख दइस, कि ऊ ओहमा काम करै अउ ओखर देखभाल करै। <verse eid="GEN 2:15" /><verse number="16" style="v" sid="GEN 2:16" />अउ भगवान आदम के हइ आदेस दइस, तै बगिया कर सगलू रूख कर फडुहा के खाय सकथस। <verse eid="GEN 2:16" /><verse number="17" style="v" sid="GEN 2:17" />पय निक्खा अउ बुरा के ग्यान के जउन रूख हबै, ओखर फडुहा तै कबहुन झइ खाबे, काखे जउन रोज तै ऊ फडुहा के खाबे ता उहै रोज जरूर मर जइहे। <verse eid="GEN 2:17" /><verse number="18" style="v" sid="GEN 2:18" />फेर भगवान कथै, आदम के अकेल्ले रहै का निक्खा नेहको आय, मै ओखर निता अक्ठी असना संगी बनाहुं जउन ऊ ओखर लग मेराय।<note caller="+" style="x"><char style="xo" closed="false">2:18 </char><char style="xt" closed="false"><ref loc="1CO 11:9">1 कुरि 11:9</ref></char></note> <verse eid="GEN 2:18" /><verse number="19" style="v" sid="GEN 2:19" />भगवान भुंइ के हर अक्ठी जानवर अउ आकास के हर चिराइयन के बनाइस, भगवान ई सगलू जीवन के मनसे के आगू लइ आइस अउ ऊ हर अक्ठी जानवर कर नाम धरिस। <verse eid="GEN 2:19" /><verse number="20" style="v" sid="GEN 2:20" />मनसे सब पोसे बाले पसु अउ आकास कर चिरइया अउ बन पसुन कर नाम धरिस, पय आदम के निता कउनो असना सहायक नेहको मिलिस जउन ओखर लग मेराय सकै। <verse eid="GEN 2:20" /><verse number="21" style="v" sid="GEN 2:21" />तब भगवान आदम के बोहत गहरी नींद हे सोबय देथै, अउ जब ऊ सोय गइस ता भगवान ओखर अक्ठी पसली निकार के ओखर जिघा हे मांस भर दइस।<note caller="+" style="x"><char style="xo" closed="false">2:21 </char><char style="xt" closed="false"><ref loc="1CO 11:8">1 कुरि 11:8</ref></char></note> <verse eid="GEN 2:21" /><verse number="22" style="v" sid="GEN 2:22" />अउ भगवान ऊ पसली के जउन ऊ आदम लग निकारे रथै, डउकी बनाय दइस, अउ ओही आदम कर लिघ्घो लइ आनथै।<note caller="+" style="x"><char style="xo" closed="false">2:22 </char><char style="xt" closed="false"><ref loc="1TI 2:13">1 तीमु 2:13</ref></char></note> <verse eid="GEN 2:22" /><verse number="23" style="v" sid="GEN 2:23" />तब आदम कथै, अब हइ मोर हाडा मसे हाडा अउ मोर मांस मसे मांस आय, इहैनिता एखर नाम डउकी होही, काखे हइ डउका मसे निकारे गय हबै। <verse eid="GEN 2:23" /><verse number="24" style="v" sid="GEN 2:24" />हइ कारन डउका अपन दाय-बाफ के छांड के अपन डउकी लग मिले रही, अउ ऊ अक्कै देह बने रइहिन।<note caller="+" style="x"><char style="xo" closed="false">2:24 </char><char style="xt" closed="false"><ref loc="MAT 19:5">मत्ती 19:5</ref>; <ref loc="MRK 10:7-8">मरकुस 10:7-8</ref>; <ref loc="EPH 5:31">इफिसियों 5:31</ref></char></note> <verse eid="GEN 2:24" /><verse number="25" style="v" sid="GEN 2:25" />आदम अउ ओखर डउकी दोनोझन बिना कपडा के रथै, पय नेहको लजात रहै।<verse eid="GEN 2:25" /></para>
  <chapter eid="GEN 2" />
  <chapter number="3" style="c" sid="GEN 3" />
  <para style="s">मनसे आदेस के नेहको मानै</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 3:1" />भगवान जेतका वन पसु बनाय रथै, उन मसे सपुवा चतुर रथै, ऊ डउकी लग कथै, “का सही भगवान कहे हबै, कि तै हइ बगिया के कउनो रूख के फडुहा के झइ खाबे?<note caller="+" style="x"><char style="xo" closed="false">3:1 </char><char style="xt" closed="false"><ref loc="REV 12:9">परकासितवाक्य 12:9</ref>; <ref loc="REV 20:2">20:2</ref></char></note>” <verse eid="GEN 3:1" /><verse number="2" style="v" sid="GEN 3:2" />डउकी सपुवा लग कथै, “हइ बगिया कर रूख कर फडुहा हम खाय सकथन,” <verse eid="GEN 3:2" /><verse number="3" style="v" sid="GEN 3:3" />पय भगवान कहे हबै, “जउन रूख बगिया कर बीच हे हबै, उके झइ खाबे अउ न तै ओही छिबे, नही ता मर जइहे।” <verse eid="GEN 3:3" /><verse number="4" style="v" sid="GEN 3:4" />तब सपुवा डउकी लग कथै, “तै नेहको मरिहे। <verse eid="GEN 3:4" /><verse number="5" style="v" sid="GEN 3:5" />भगवान जानथै कि जब तै उके खाबे ता तोर आंखी खुल जही, अउ निक्खा बेकार के जान जइहे अउ भगवान के जसना हुइ जइहे।” <verse eid="GEN 3:5" /><verse number="6" style="v" sid="GEN 3:6" />पय जब डउकी देखिस कि रूख कर फडुहा सुन्दर हबै, अउ मनभाउ दिखथै, खाय के निता निक्खा हबै अउ फडुहा उके दिमाकदार बनाही, तब डउकी रूख लग फडुहा के टोरिस अउ उके खाइस, अउ अपन डउका के देथै, अउ उहो उके खाइस।<note caller="+" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="1TI 2:14">1 तीमु 2:14</ref></char></note> <verse eid="GEN 3:6" /><verse number="7" style="v" sid="GEN 3:7" />तब उन दोनोझन के आंखी खुल गइस अउ उनही पता हुइस कि हम बिगर कपडा के हवन, इहैनिता उन अंजीर कर पत्ता के जोड-जोड के लंगोटिया बनाय लेथै। <verse eid="GEN 3:7" /><verse number="8" style="v" sid="GEN 3:8" />तब आदम अउ हब्बा सांझ के टेम हे भगवान के चलै के आरो सुनथै, ऊ बगिया के रुखवन के बीच हे लुक गइन। <verse eid="GEN 3:8" /><verse number="9" style="v" sid="GEN 3:9" />तब भगवान गोहराय के आदम लग पूंछथै, “तै कछो हबस?” <verse eid="GEN 3:9" /><verse number="10" style="v" sid="GEN 3:10" />आदम कथै, “मै तोर आरो सुनके डर गय रहों, काखे मै बिगर कपडा के रथो, इहैनिता लुक गय रहों।” <verse eid="GEN 3:10" /><verse number="11" style="v" sid="GEN 3:11" />भगवान पूंछथै, “कोन हर तोके कहिस कि तै लंगडा हवस? का तै ऊ रूख के फडुहा खाय हबस, जेही न खाय के निता मै तोके आदेस दय रथो?” <verse eid="GEN 3:11" /><verse number="12" style="v" sid="GEN 3:12" />आदम कथै, “जउन डउकी के तै मोर संग रहै के निता दय हबस, उहै ऊ रूख लग मोके फडुहा दइस अउ मै उके खायों।” <verse eid="GEN 3:12" /><verse number="13" style="v" sid="GEN 3:13" />तब भगवान डउकी लग कथै, “हइ तै काहिन करे हबस?” डउकी कथै, “सपुवा मोके बहकाइस अउ मै फडुहा के खाय लयों।<note caller="+" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="ROM 7:11">रोमियो 7:11</ref>; <ref loc="2CO 11:3">2 कुरि 11:3</ref>; <ref loc="1TI 2:14">1 तीमु 2:14</ref></char></note>”<verse eid="GEN 3:13" /></para>
  <para style="s">भगवान कर सजा</para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 3:14" />तब भगवान सपुवा लग कथै, “तै जउन हइ करे हबस, इहैनिता तै सगलू रखै बाले पसु अउ सगलू बन बाले जानवर लग बोहत सरापित हबस, तै लादा के बल हे रेंगै करिहे, अउ जीवन भर माटी चाटत रइहे। <verse eid="GEN 3:14" /><verse number="15" style="v" sid="GEN 3:15" />मै तोके अउ डउकी के अक दूसर के दुस्मन बनइहों, तुम्हर लरका अउ एखर लरका आपस हे दुस्मन हुइहिन, तै एखर एडी के चबहे अउ ऊ तोर मूंड के कुचर देही।” <verse eid="GEN 3:15" /><verse number="16" style="v" sid="GEN 3:16" />फेर डउकी लग कथै, मै तोर पीरा अउ तोर लादा हे होमै लग एतका पीरा बढाहूं, कि तै पीरा हे हुइके लरका पइदा करिहे, अउ तोर आसरा तोर डउका के तरफ होही, अउ ऊ तोर उप्पर राज करही।<note caller="+" style="x"><char style="xo" closed="false">3:16 </char><char style="xt" closed="false"><ref loc="1CO 11:3">1 कुरि 11:3</ref>; <ref loc="EPH 5:22">इफिसियों 5:22</ref>; <ref loc="COL 3:18">कुलुस्सियो 3:18</ref></char></note> <verse eid="GEN 3:16" /><verse number="17" style="v" sid="GEN 3:17" />अउ आदम लग ऊ कथै, तै जउन अपन डउकी के बात सुने हबस, अउ जउन रूख कर फडुहा के बारे हे मै तोके आदेस दय रहों कि तै ओही झइ खाबे, ओही तै खाय हबस, इहैनिता जमीन तोर कारन सरापित हबै, तै ओखर उपजाऊ जीवन भर दुख के संग खाय करहे। <verse eid="GEN 3:17" /><verse number="18" style="v" sid="GEN 3:18" />अउ ऊ तोर निता कांटा अउ किटिल्ली उगाही, अउ तै खेत के उपज खइहे। <verse eid="GEN 3:18" /><verse number="19" style="v" sid="GEN 3:19" />अउ अपन माथा के पसीना के रोटी खाय करहे, अउ आखरी हे माटी हे मिल जइहे काखे तै उहै मसे निकारे गय हबस, तै माटी तो हबस अउ माटी हे फेरै मिल जइहे। <verse eid="GEN 3:19" /><verse number="20" style="v" sid="GEN 3:20" />आदम अपन डउकी के नाम हव्वा धरिस, काखे जेतका मनसे जिन्दा हबै उन सगलू के आदिमाता उहै हबै। <verse eid="GEN 3:20" /><verse number="21" style="v" sid="GEN 3:21" />अउ भगवान आदम अउ ओखर डउकी के निता खलरी के बन्डी बनाय के उनके पेहराय दइस।<verse eid="GEN 3:21" /></para>
  <para style="s">आदम अउ हब्बा के बगिया लग निकाडथै</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 3:22" />फेर भगवान कथै, “मनसे हमर जसना हुइ गय हबै, मनसे निक्खा अउ बुरा जानथै अउ अब मनसे जीवन के रूख लग फडुहा लइ सकथै, अगर मनसे ऊ फडुहा के खाय लेही ता ऊ हरमेसा जिन्दा रइही।<note caller="+" style="x"><char style="xo" closed="false">3:22 </char><char style="xt" closed="false"><ref loc="REV 2:7">परकासितवाक्य 2:7</ref>; <ref loc="REV 22:14-19">22:14-19</ref>; <ref loc="GEN 3:24">उत्पति 3:24</ref></char></note>” <verse eid="GEN 3:22" /><verse number="23" style="v" sid="GEN 3:23" />इहैनिता भगवान उनके अदन के बगिया मसे निकार दइस, जउन माटी लग आदम बने रथै, ऊ जमीन हे आदम के बोहत मेहनत करै के पडिस। <verse eid="GEN 3:23" /><verse number="24" style="v" sid="GEN 3:24" />भगवान आदम के बगिया लग बाहिर कर दइस, तब भगवान करूब नाम स्वरगदूत<note caller="+" style="f"><char style="fr" closed="false">3:24 </char><char style="ft" closed="false">जेखर डेखना होथै</char></note> के अदन बगिया कर दूरा हे देख-रेख के निता रखिस, उहां अक्ठी आग के तलबारो रख दइस, हइ तलबार जीवन के रूख के रास्ता के देख-रेख करत चारो पार चमकत रथै।<verse eid="GEN 3:24" /></para>
  <chapter eid="GEN 3" />
  <chapter number="4" style="c" sid="GEN 4" />
  <para style="s">कैन अउ हाबिल</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 4:1" />जब आदम अपन डउकी हव्वा के लिघ्घो गइस, तब ऊ लादा हे हुइके कैन के पइदा करिस अउ कथै, “मै भगवान के पल्ला लग अक्ठी टोरवा के पाय हव।” <verse eid="GEN 4:1" /><verse number="2" style="v" sid="GEN 4:2" />एखर बाद हव्वा कैन के भाई हाबिल के पइदा करथै, हाबिल गेडरा के बरेदी बन गइस, पय कैन जमीन हे खेती करैबाले किसान बन गइस। <verse eid="GEN 4:2" /><verse number="3" style="v" sid="GEN 4:3" />कैन टेम आमै लग खेत कर उपज परभु के भेंट चढाइस<note caller="+" style="x"><char style="xo" closed="false">4:3 </char><char style="xt" closed="false"><ref loc="JHN 1:11">यूहन्ना 1:11</ref></char></note>। <verse eid="GEN 4:3" /><verse number="4" style="v" sid="GEN 4:4" />अउ हाबिलो अपन गेडरा छेडी मसे सब लग पहिले छउना के भेंट चढाइस अउ चरबियो भेंट चढाइस भगवान हाबिल अउ ओखर भेंट के स्बीकार करिस<note caller="+" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="HEB 11:4">इब्रानिन 11:4</ref></char></note>, <verse eid="GEN 4:4" /><verse number="5" style="v" sid="GEN 4:5" />पय कैन अउ ओखर भेंट के नेहको स्बीकारिस, तब कैन बोहत गुस्साइस, अउ ओखर चेहरा मुरझाय जथै। <verse eid="GEN 4:5" /><verse number="6" style="v" sid="GEN 4:6" />तब भगवान कैन लग कथै, तै काखे गुस्सा हबस? अउ तोर चेहरा काखे मुरझाय हबै? <verse eid="GEN 4:6" /><verse number="7" style="v" sid="GEN 4:7" />अगर तै निक्खा काम करहे ता तै मोर नजर हे निक्खा रहबे, तब मै तोके अपनइहों, पय अगर तै बेकार काम करहे ता ऊ पाप तोर जीवन हे रही। तोर पाप तोके अपन बस हे रखै के चाहथै, पय तोके अपन पाप के अपन बस हे रखै के होही। <verse eid="GEN 4:7" /><verse number="8" style="v" sid="GEN 4:8" />कैन अपन भाई हाबिल लग कथै, “आ पटाउरा हे चली।” इहैनिता कैन अउ हाबिल पटाउरा हे गइन, तब कैन अपन भाई हे हमला करिस अउ उके मार डारिस। <verse eid="GEN 4:8" /><verse number="9" style="v" sid="GEN 4:9" />तब भगवान कैन लग पूंछथै, “तोर भाई हाबिल कछो हबै?” ऊ कथै, “मै नेहको जानथो, का मै अपन भाई के देख-रेख करै बाले हव?” <verse eid="GEN 4:9" /><verse number="10" style="v" sid="GEN 4:10" />भगवान कथै, “हइ तै काहिन करे हबस? तोर भाई कर खून जमीन लग बोल-बोल के मोके पुकारथै।<note caller="+" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="HEB 12:24">इब्रानिन 12:24</ref></char></note> <verse eid="GEN 4:10" /><verse number="11" style="v" sid="GEN 4:11" />तै अपन भाई के खून करे हवस, भुंइ तोर हाथ लग ओखर खून लेय के निता खुल गय हबै, इहैनिता अब ऊ भुंइ सरापित हबै। <verse eid="GEN 4:11" /><verse number="12" style="v" sid="GEN 4:12" />चाहे तै जमीन हे खेती कर, तउभरमा ओखर पूर उपज तोके नेहको मिलही, अउ तै भुंइ हे भटकै बाले अउ भगाइला हुइहे। <verse eid="GEN 4:12" /><verse number="13" style="v" sid="GEN 4:13" />तब कैन भगवान लग कथै, हइ सजा एतका जादा हबै कि मै नेहको सह पइहों। <verse eid="GEN 4:13" /><verse number="14" style="v" sid="GEN 4:14" />मोर पार देख, तै मोके भुंइ हे खेत कर काम छांडै लग मजबूर कर दय हबस अउ अब मै तोर लिघ्घो नेहको रइहों, मोर घर नेहको होही अउ भुंइ हे मै नास हुइ जइहों अउ अगर कउनो मनसे मोके पाही ता मार डारही।” <verse eid="GEN 4:14" /><verse number="15" style="v" sid="GEN 4:15" />तब भगवान कैन लग कथै, “मै हइ नेहको होमै देहुं, अगर कउ तोके मारही ता मै ऊ मनसे लग सात गुना बदला लय जही।” तब भगवान कैन के उप्पर अक्ठी चिन्हा बनाइस, हइ चिन्हा ऊ गुठेथै कि कैन के कउ झइ मरै। <verse eid="GEN 4:15" /><verse number="16" style="v" sid="GEN 4:16" />अउ कैन भगवान के आगू लग कढ गइस, जउन अदन के पूरब दिसा हे हबै, ऊ देस हे रहै लगिस जउन भटकै बाले भगोडा कहाथै।<verse eid="GEN 4:16" /></para>
  <para style="s">कैन कर परवार</para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 4:17" />जब कैन अपन डउकी के लिघ्घो गइस तब ऊ लादा हे हुइस, अउ ऊ हनोक के पइदा करिस, फेर कैन अक्ठी सहर बसाइस अउ ऊ सहर के नाम अपन लरका कर नाम “हनोक सहर” धरिस। <verse eid="GEN 4:17" /><verse number="18" style="v" sid="GEN 4:18" />हनोक लग ईराद हुइस, अउ ईराद लग महूयाएल पइदा हुइस, महूयाएल लग मतूसाएल, अउ मतूसाएल लग लेमेक पइदा हुइस। <verse eid="GEN 4:18" /><verse number="19" style="v" sid="GEN 4:19" />लेमेक दुइठे डउकी लग काज कर लइस, जेखर लग अक्ठी कर नाम आदा, अउ दूसर कर नाम सिल्ला रथै। <verse eid="GEN 4:19" /><verse number="20" style="v" sid="GEN 4:20" />आदा याबाल के पइदा करिस, ऊ तम्बुवन हे रथै, अउ पसु के पालके अपन जीवन बिताथै। <verse eid="GEN 4:20" /><verse number="21" style="v" sid="GEN 4:21" />आदा कर दूसर टोरवा यूबालो रथै, यूबाल, याबाल कर भाई रथै। यूबाल उन मनसेन कर बाफ रथै, जउन बीडा अउ बंसुरी बजाथै। <verse eid="GEN 4:21" /><verse number="22" style="v" sid="GEN 4:22" />अउ सिल्लो तूबलकैन नाम के अक्ठी लरका के पइदा करिस, ऊ पीतर अउ लोहा के सगलू धारबाले हथियारन के गढैबाले हुइस, तूबलकैन कर बेहन नामा रथै। <verse eid="GEN 4:22" /><verse number="23" style="v" sid="GEN 4:23" />लेमेक अपन डउकिन लग कथै, हे आदा अउ सिल्ला मोर बात सुना, लेमेक के डउकी जउन बात मै कथै, सुना, अक्ठी डउका मोके चोंट पहुंचाइस, मै उके मार डाले हव, अक्ठी जबान मोके चोंट दइस, इहैनिता उहो के मै मार डाले हव। <verse eid="GEN 4:23" /><verse number="24" style="v" sid="GEN 4:24" />अगर कैन के बदला सात गुना हबै, ता लेमेक के सतहत्तर गुना होही।<verse eid="GEN 4:24" /></para>
  <para style="s">सेत अउ एनोस</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 4:25" />आदम अपन डउकी के लिघ्घो फेर गइस, अउ ऊ अक्ठी टोरवा के पइदा करिस, अउ ओखर नाम सेत रखिस, भगवान मोर निता हाबिल के बदला हे जेही कैन मार डारे रहै, इहैनिता भगवान हइ दूसर लरका दय हबै।<note caller="+" style="x"><char style="xo" closed="false">4:25 </char><char style="xt" closed="false"><ref loc="GEN 5:3-4">उत्पति 5:3-4</ref></char></note> <verse eid="GEN 4:25" /><verse number="26" style="v" sid="GEN 4:26" />सेत कर अक्ठी टोरवा हुइस, अउ ऊ ओखर नाम एनोस रखिस, उहै टेम लग मनसे भगवान लग बिनती करै लगिन।<verse eid="GEN 4:26" /></para>
  <chapter eid="GEN 4" />
  <chapter number="5" style="c" sid="GEN 5" />
  <para style="s">आदम कर परवार</para>
  <para style="r">(<ref loc="1CH 1:1-4">1 इति 1:1-4</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 5:1" />आदम कर परवार हइ मेर हबै, जब भगवान मनसे के बनाइस तब अपनै मेर ओही बनाइस।<note caller="+" style="x"><char style="xo" closed="false">5:1 </char><char style="xt" closed="false"><ref loc="MAT 1:1">मत्ती 1:1</ref>; <ref loc="1CO 11:7">1 कुरि 11:7</ref></char></note> <verse eid="GEN 5:1" /><verse number="2" style="v" sid="GEN 5:2" />ऊ डउका अउ डउकी करके मनसे के बनाइस अउ उनके आसिरवाद दइस, अउ उनके स्रस्टी के दिन उनखर नाम आदम रखिस।<note caller="+" style="x"><char style="xo" closed="false">5:2 </char><char style="xt" closed="false"><ref loc="MAT 19:4">मत्ती 19:4</ref>; <ref loc="MRK 10:6">मरकुस 10:6</ref></char></note> <verse eid="GEN 5:2" /><verse number="3" style="v" sid="GEN 5:3" />जब आदम अक सव तीस साल के हुइस, तब ओखर दवारा ओखरै जसना हे ओखर रूप कर जसना अक्ठी टोरवा हुइस। ऊ ओखर नाम “सेत” धरिस। <verse eid="GEN 5:3" /><verse number="4" style="v" sid="GEN 5:4" />सेत कर पइदा होय के बाद आदम आठ सव साल जिन्दा रहिस, अउ ओखर अउ टोरवा टोरिया पइदा हुइन। <verse eid="GEN 5:4" /><verse number="5" style="v" sid="GEN 5:5" />हइ मेर आदम कर कुल साल नव सव तीस साल के हुइस, एखर बाद ऊ मर गइस। <verse eid="GEN 5:5" /><verse number="6" style="v" sid="GEN 5:6" />जब सेत अक सव पांच साल के हुइस, तब एनोस के पइदा करिस। <verse eid="GEN 5:6" /><verse number="7" style="v" sid="GEN 5:7" />एनोस कर बाद सेत आठ सव साल जिन्दा रहिस, अउ ओखर बाद अउ टोरवा-टोरिया पइदा हुइन। <verse eid="GEN 5:7" /><verse number="8" style="v" sid="GEN 5:8" />हइ मेर सेत कुल नव सव बारह साल जिन्दा रहिस, एखर बाद ऊ मर गइस। <verse eid="GEN 5:8" /><verse number="9" style="v" sid="GEN 5:9" />जब एनोस नब्बे साल कर हुइस, तब केनान के पइदा करिस। <verse eid="GEN 5:9" /><verse number="10" style="v" sid="GEN 5:10" />केनान के बाद एनोस आठ सव पन्द्रा साल जिन्दा रहिस, अउ ओखर अउ टोरवा-टोरिया हुइन। <verse eid="GEN 5:10" /><verse number="11" style="v" sid="GEN 5:11" />हइ मेर एनोस नव सव पांच साल जिन्दा रहिस, एखर बाद ऊ मर गइस। <verse eid="GEN 5:11" /><verse number="12" style="v" sid="GEN 5:12" />जब केनान सत्तर साल के हुइस, तब ओखर लग महललेल पइदा हुइस। <verse eid="GEN 5:12" /><verse number="13" style="v" sid="GEN 5:13" />महललेल के पइदा होय के बाद केनान आठ सव चालीस साल जिन्दा रहिस, अउ ओखर टोरिया-टोरवा हुइन। <verse eid="GEN 5:13" /><verse number="14" style="v" sid="GEN 5:14" />हइ मेर केनान कुल नव सव दस साल जिन्दा रहिस, एखर बाद ऊ मर गइस। <verse eid="GEN 5:14" /><verse number="15" style="v" sid="GEN 5:15" />जब महललेल पैसठ साल के हुइस, तब ओखर लग येरेद के पइदा करिस। <verse eid="GEN 5:15" /><verse number="16" style="v" sid="GEN 5:16" />येरेद के पइदा होय के बाद महललेल आठ सव तीस साल जिन्दा रहिस, अउ ओखर अउ टोरवा-टोरिया पइदा हुइन। <verse eid="GEN 5:16" /><verse number="17" style="v" sid="GEN 5:17" />हइ मेर महललेल के कुल साल आठ सव पंचानबे साल हुइस, एखर बाद ऊ मर गइस। <verse eid="GEN 5:17" /><verse number="18" style="v" sid="GEN 5:18" />जब येरेद अक सव बासठ साल के हुइस, तब हनोक के पइदा करिस। <verse eid="GEN 5:18" /><verse number="19" style="v" sid="GEN 5:19" />हनोक कर बाद येरेद आठ सव साल जिन्दा रहिस अउ ओखर टोरवा-टोरिया हुइस। <verse eid="GEN 5:19" /><verse number="20" style="v" sid="GEN 5:20" />हइ मेर येरेद कर कुल साल नव सव बासठ के हुइस, एखर बाद ऊ मर गइस। <verse eid="GEN 5:20" /><verse number="21" style="v" sid="GEN 5:21" />जब हनोक पैसठ साल के हुइस, तब मतूसेलह के पइदा करिस। <verse eid="GEN 5:21" /><verse number="22" style="v" sid="GEN 5:22" />मतूसेलह कर बाद हनोक तीन सव साल तक भगवान के संग-संग चलत रथै, अउ ओखर टोरवा-टोरिया हुइन। <verse eid="GEN 5:22" /><verse number="23" style="v" sid="GEN 5:23" />हइमेर हनोक के कुल साल तीन सव पैसठ के हुइस। <verse eid="GEN 5:23" /><verse number="24" style="v" sid="GEN 5:24" />हनोक भगवान के संग-संग चलथै, फेर ऊ लुक गय काखे भगवान उके उठाय लइस।<note caller="+" style="x"><char style="xo" closed="false">5:24 </char><char style="xt" closed="false"><ref loc="HEB 11:5">इब्रानिन 11:5</ref></char></note> <verse eid="GEN 5:24" /><verse number="25" style="v" sid="GEN 5:25" />जब मतूसेलह अक सव सतासी साल के हुइस, तब लेमेक के पइदा करिस। <verse eid="GEN 5:25" /><verse number="26" style="v" sid="GEN 5:26" />लेमेक कर बाद मतूसेलह सात सव बयासी साल जिन्दा रहिस अउ ओखर टोरवा-टोरिया हुइन। <verse eid="GEN 5:26" /><verse number="27" style="v" sid="GEN 5:27" />हइ मेर मतूसेलह नव सव उनहत्तर साल जिन्दा रहिस, एखर बाद ऊ मर गइस। <verse eid="GEN 5:27" /><verse number="28" style="v" sid="GEN 5:28" />जब लेमेक अक सव बयासी साल के हुइस, तब ओखर लग अक्ठी टोरवा पइदा हुइस। <verse eid="GEN 5:28" /><verse number="29" style="v" sid="GEN 5:29" />ऊ हइ कहिके ओखर नाम नूह धरिस, “भगवान जउन भुंइ के सराप दय रहिस, ओहमा काम करत टेम हमर बोहत मेहनत हे हइ हमके आराम देही।” <verse eid="GEN 5:29" /><verse number="30" style="v" sid="GEN 5:30" />नूह के पइदा होय के बाद लेमेक पांच सव पंचानबे साल जिन्दा रहिस अउ ओखर टोरवा-टोरिया पइदा हुइन। <verse eid="GEN 5:30" /><verse number="31" style="v" sid="GEN 5:31" />हइ मेर लेमेक कुल सात सव सतहत्तर साल जिन्दा रहिस, एखर बाद ऊ मर गइस। <verse eid="GEN 5:31" /><verse number="32" style="v" sid="GEN 5:32" />जब नूह पांच सव साल के हुइस, अउ नूह लग सेम, अउ हाम, अउ येपेत पइदा हुइन।<verse eid="GEN 5:32" /></para>
  <chapter eid="GEN 5" />
  <chapter number="6" style="c" sid="GEN 6" />
  <para style="s">मनसे पापी हुइन</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 6:1" />फेर जब मनसे के संख्या भुंइ के उप्पर बोहत बढै लगिस अउ उनखर टोरिया हुइन, <verse eid="GEN 6:1" /><verse number="2" style="v" sid="GEN 6:2" />तब भगवान कर टोरवा मनसे के टोरियन के देखिन, कि ऊ सुन्दर हबै, अउ अपन इक्छा के जसना जेही चाहिन उनखर लग काज करिन। <verse eid="GEN 6:2" /><verse number="3" style="v" sid="GEN 6:3" />तब भगवान कथै, मनसे सरीरै आय, मै हरमेसा के निता इनखर लग अपन आतमा के परेसान नेहको होमै दइहों, मै उनके अक सव बीस साल तक जीवन दइहों। <verse eid="GEN 6:3" /><verse number="4" style="v" sid="GEN 6:4" />उन दिनन हे भुंइ हे नपीली मनसे रथै, अउ एखर बाद जब भगवान कर टोरवा मनसेन के टोरिया के लिघ्घो गइन, तब उनखर दवारा जउन टोरवा पइदा हुइन ऊ सूरबीर होथै, जिनखर सक्तिसाली परचीनकाल लग परचलित हबै। <verse eid="GEN 6:4" /><verse number="5" style="v" sid="GEN 6:5" />भगवान देखिस कि मनसेन के बुराई भुंइ हे बढ गय हबै, अउ उनखर मन के सोच हे जउन कुछ पइदा होथै ऊ लगेतार बुराई होथै।<note caller="+" style="x"><char style="xo" closed="false">6:5 </char><char style="xt" closed="false"><ref loc="PSA 53:2">भजन 53:2</ref></char></note> <verse eid="GEN 6:5" /><verse number="6" style="v" sid="GEN 6:6" />भगवान हइ बात हे दुख होथै, कि मै भुंइ हे मनसेन के बनाय के पछतायों इहै बात हे बोहत दुख हुइस। <verse eid="GEN 6:6" /><verse number="7" style="v" sid="GEN 6:7" />तब भगवान कथै, मै मनसे के जेही मै बनायों उनके भुंइ लग मिटाय देहुं, का मनसे, का पसु, का रेंगै बाले जीव, का आकास के चिरइया, सब के मिटाय देहुं, काखे मै उनही बनाय के पछताथों। <verse eid="GEN 6:7" /><verse number="8" style="v" sid="GEN 6:8" />पय भुंइ हे भगवान के खुस करै बाले अक्ठी मनसे रथै, ओखर नाम नूह रथै।<verse eid="GEN 6:8" /></para>
  <para style="s">नूह</para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 6:9" />हइ किस्सा नूह धरमी मनसे के परवार कर हबै, अपन पूरा जीवनकाल हे हरमेसा भगवान के संग चलथै। <verse eid="GEN 6:9" /><verse number="10" style="v" sid="GEN 6:10" />नूह कर तीनठे लरका रथै, सेम, हाम अउ येपेत। <verse eid="GEN 6:10" /><verse number="11" style="v" sid="GEN 6:11" />भगवान के नजर हे भुंइ हे बुराई झगडा बोहत बढ गय रथै, ऊ पाप लग भर गय रथै। <verse eid="GEN 6:11" /><verse number="12" style="v" sid="GEN 6:12" />अउ भगवान भुंइ हे जउन नजर लगाइस ता का देखिस कि ऊ बिगडे हबै, काखे सगलू परानी भुंइ हे अपन-अपन आदत बिगाड लय रथै। <verse eid="GEN 6:12" /><verse number="13" style="v" sid="GEN 6:13" />तब भगवान नूह लग कथै, “मै सोच लय हव, कि जेतका भुंइ हे जीव परानी हबै, उन सगलू के नास कर करिहों, काखे भुंइ हे बोहत पाप भर चुके हबै। <verse eid="GEN 6:13" /><verse number="14" style="v" sid="GEN 6:14" />तै गोपेर लकडी के जिहाज बनाबे, तै ओखर भित्तर कोठरिया बनइहे, अउ ओखर भित्तर बाहिर लार के पोत देबे। <verse eid="GEN 6:14" /><verse number="15" style="v" sid="GEN 6:15" />हइ मेर तै जिहाज बनाबे, ओखर नाप तीन सव हाथ लम्बाई पचास हाथ चउडाई तीस हाथ उंचाई रखबे। <verse eid="GEN 6:15" /><verse number="16" style="v" sid="GEN 6:16" />जिहाज हे अक्ठी झकिया बनाय लेबे, अउ अक हाथ उप्पर छानी बनाबे, जिहाज हे अक्ठी दूरा रखबे, तै जिहाज के तीन भाग हे बाट देबे, पहिला पटउंहा, दूसर पटउंहा, तीसर पटउंहा। <verse eid="GEN 6:16" /><verse number="17" style="v" sid="GEN 6:17" />तोके जउन गुठेथो उके समझ, मै भुंइ हे बडा पानी कर बाढ लइहों, आकास कर तरी सगलू जीवन के नास कर देहुं, भुंइ के सगलू जीव मर जइहिन। <verse eid="GEN 6:17" /><verse number="18" style="v" sid="GEN 6:18" />पय तोर संग मै अक्ठी बाचा बांधहुं इहैनिता तै अपन डउकी अपन टोरवन के अउ पुतउ के संग जिहाज हे आ जइहा। <verse eid="GEN 6:18" /><verse number="19" style="v" sid="GEN 6:19" />अउ सगलू जिन्दा परानी मसे दुइ-दुइ जोडी करके अपन संग जिहाज हे लइ आनबे जेखर लग ऊ तोर संग जिन्दा रइहिन। <verse eid="GEN 6:19" /><verse number="20" style="v" sid="GEN 6:20" />अक-अक्ठी जात के चिरइया अउ अक-अक्ठी जात के भुंइ हे रेंगै बाले पसु अउ परानी मसे तोर लिघ्घो आही, तै उनके जिन्दा रखबे। <verse eid="GEN 6:20" /><verse number="21" style="v" sid="GEN 6:21" />भुंइ के सगलू मेर के खाना जिहाज के भित्तर लइ अनबे, हइ खाना तुम्हर निता अउ सगलू पसु जानवर के निता होही।” <verse eid="GEN 6:21" /><verse number="22" style="v" sid="GEN 6:22" />नूह हइ सगलू कुछ करिस, नूह भगवान कर सगलू आदेस के मानिस।<verse eid="GEN 6:22" /></para>
  <chapter eid="GEN 6" />
  <chapter number="7" style="c" sid="GEN 7" />
  <para style="s">जल-परलय</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 7:1" />तब भगवान नूह लग कथै, मै देखे हव कि ई टेम के पापी मनसेन हे तहिन अक्ठी निक्खा मनसे हबस, इहैनिता तै अपन परवार के अकजुट कर अउ तुम सगलू जिहाज हे कढ जा। <verse eid="GEN 7:1" /><verse number="2" style="v" sid="GEN 7:2" />तै सगलू सुध्द पसु मसे नर-मादा करके सात जोडा अउ जउन असुध्द पसु नर-मादा मसे अक-अक्ठी जोडा लानबे। <verse eid="GEN 7:2" /><verse number="3" style="v" sid="GEN 7:3" />आकास कर चिरइया मसे नर-मादा करके सात जोडा लेबे, जेखर लग उनखर वंस बचके भुंइ हे जिन्दा रहै। <verse eid="GEN 7:3" /><verse number="4" style="v" sid="GEN 7:4" />काखे मै सात रोज के बाद चालीस रोज अउ चालीस रात भुंइ हे बरिसा करहुं अउ उन सगलू परानी के जेही मै बनाय हव, उन सगलू के मिटाय देहुं। <verse eid="GEN 7:4" /><verse number="5" style="v" sid="GEN 7:5" />नूह परभु के आदेस के जसना सगलू कुछ करिस। <verse eid="GEN 7:5" /><verse number="6" style="v" sid="GEN 7:6" />जब भुंइ हे आंधी बडेरा पानी गिरिस तब नूह छय सव साल के रथै। <verse eid="GEN 7:6" /><verse number="7" style="v" sid="GEN 7:7" />नूह जल परलय लग बचे के निता अपन डउकी टोरवन अउ पुतउन के संग जिहाज हे गइन। <verse eid="GEN 7:7" /><verse number="8" style="v" sid="GEN 7:8" />सुध्द अउ असुध्द पसु अउ चिराइयन के दुइ-दुइ जोडी, भुंइ हे रेंगै बाले जीव, <verse eid="GEN 7:8" /><verse number="9" style="v" sid="GEN 7:9" />दुइ-दुइ मतलब नर अउ नारी करके नूह जिहाज हे चढाइस, जसना भगवान नूह के आदेस दय रथै। <verse eid="GEN 7:9" /><verse number="10" style="v" sid="GEN 7:10" />सात रोज कर बाद पानी बरसै लागथै। <verse eid="GEN 7:10" /><verse number="11" style="v" sid="GEN 7:11" />जब नूह छय सव साल के हुइस, ता उहै साल के दूसर महिना के सतरा रोज आइस, उहै रोज समुन्दर के झिरना फुट जथै, बादर उघर गइस, <verse eid="GEN 7:11" /><verse number="12" style="v" sid="GEN 7:12" />अउ चालीस रोज अउ चालीस रात भुंइ हे पानी गिरत रथै। <verse eid="GEN 7:12" /><verse number="13" style="v" sid="GEN 7:13" />उहै रोज नूह अपन डउकी, अउ अपन टोरवा सेम, हाम, येपेत अउ तीनो पुतउ के संग जिहाज हे रथै। <verse eid="GEN 7:13" /><verse number="14" style="v" sid="GEN 7:14" />उनखर संग हर अक जात के सगलू जीव जन्तु, रखे बाले पसु, अउ रेंगै बाले जीव, अउ उडै बाले चिरइया जिहाज हे रथै। <verse eid="GEN 7:14" /><verse number="15" style="v" sid="GEN 7:15" />सगलू परानी मसे दुइ-दुइ जोडी, जेहमा जीवन के सांस रथै, नूह सगलू के जिहाज के भित्तर लइ जथै। <verse eid="GEN 7:15" /><verse number="16" style="v" sid="GEN 7:16" />नूह भगवान के आदेस के जसना करथै, तब भगवान दूरा के बन्द कर देथै। <verse eid="GEN 7:16" /><verse number="17" style="v" sid="GEN 7:17" />तब भुंइ हे चालीस दिन अउ चालीस रात तक पानी गिरथै, अउ पानी बहोत बढत जथै, जेखर लग जिहाज ऊंच उठ जथै। <verse eid="GEN 7:17" /><verse number="18" style="v" sid="GEN 7:18" />पानी भुंइ हे बोहत बढ जथै, कि जिहाज पानी हे पइरे लगथै। <verse eid="GEN 7:18" /><verse number="19" style="v" sid="GEN 7:19" />पानी जादा बढै के कारन इहां तक कि भुंइ के ऊंच-ऊंच डोंगर बुढ जथै। <verse eid="GEN 7:19" /><verse number="20" style="v" sid="GEN 7:20" />पानी पन्द्रा हाथ भुंइ लग बढ जथै, अउ सगलू डोंगर बुढ गइन। <verse eid="GEN 7:20" /><verse number="21" style="v" sid="GEN 7:21" />भुंइ हे जेतका रहैबाले चिरइया, रखे बाले पसु, बइला पसु, अउ रेंगै बाले परानी अउ मनसेन मतलब जेतका भुंइ हे परानी रथै, सगलू मर गइन। <verse eid="GEN 7:21" /><verse number="22" style="v" sid="GEN 7:22" />जउन-जउन भुंइ हे सांस लेय बाले रथै, सगलू मर गइन। <verse eid="GEN 7:22" /><verse number="23" style="v" sid="GEN 7:23" />परभु भुंइ हे सगलू रेंगै बाले परानी के नास कर देथै, मनसेन के पसु चिरइया के केबल उहै बचिन जउन नूह के संग जिहाज हे रथै। <verse eid="GEN 7:23" /><verse number="24" style="v" sid="GEN 7:24" />पानी भुंइ हे एक सव पचास दिन तक रथै।<verse eid="GEN 7:24" /></para>
  <chapter eid="GEN 7" />
  <chapter number="8" style="c" sid="GEN 8" />
  <para style="s">जल परलय के समापत</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 8:1" />भगवान नूह अउ सगलू वन पसु अउ रखै बाले पसु नूह के संग जिहाज हे रथै, भगवान सब के सुरक्छा करथै, अउ भगवान भुंइ हे हवा चलाथै, अउ पानी घटे लगथै, <verse eid="GEN 8:1" /><verse number="2" style="v" sid="GEN 8:2" />अउ भुंइ के पानी अउ समुन्दर लग जउन उप्पर उठके बादर लग आथै, सगलू बरसै का पानी बन्द हुइ जथै। <verse eid="GEN 8:2" /><verse number="3" style="v" sid="GEN 8:3" />अउ एक सव पचास रोज के बाद भुंइ लग पानी धीरे-धीरे करके घटे लागथै। <verse eid="GEN 8:3" /><verse number="4" style="v" sid="GEN 8:4" />अउ जिहाज सात महिना के सतरा रोज अरारत नाम के डोंगर हे जाय के टिक जथै। <verse eid="GEN 8:4" /><verse number="5" style="v" sid="GEN 8:5" />अउ दसमा महिना तक पानी धीरे-धीरे घटत रहिस, दसमा महिना के पहिले रोज डोंगरन के फुलइ दिखथै। <verse eid="GEN 8:5" /><verse number="6" style="v" sid="GEN 8:6" />नूह चालीस रोज के बाद जिहाज के खिडकी खोलथै, जेही ऊ खुद बनाय रथै, <verse eid="GEN 8:6" /><verse number="7" style="v" sid="GEN 8:7" />अउ नूह अक्ठी कउवा के उडवाथै, जब तक भुंइ सुखाय नेहको गइस तब तक कउवा इछो-उछो उडत रथै। <verse eid="GEN 8:7" /><verse number="8" style="v" sid="GEN 8:8" />एखर बाद नूह हइ देखै के निता अक्ठी परेबा के उडाथै, कि भुंइ लग पानी घटिस कि नेहको घटिस। <verse eid="GEN 8:8" /><verse number="9" style="v" sid="GEN 8:9" />पय परेबा के अपन गोड धरै के निता भुंइ हे जिघा नेहको मिलथै, काखे सगलू भुंइ हे पानी भररेहर रथै, अउ परेबा नूह के लिघ्घो जिहाज हे लउट आथै, नूह अपन हाथ बढाय के परेबा के पकड लेथै, अउ जिहाज के भित्तर अपन संग लइ जथै। <verse eid="GEN 8:9" /><verse number="10" style="v" sid="GEN 8:10" />तब अउ सात रोज तक रुके रथै, एखर बाद नूह फेरै अक्ठी परेबा के उडाथै, <verse eid="GEN 8:10" /><verse number="11" style="v" sid="GEN 8:11" />अउ संझा के टेम परेबा ओखर लिघ्घो लउट आथै, ओखर चोंच हे ताजा टोरे हर जैतून कर पत्ता रथै, एखर बाद नूह के पता हुइ जथै कि भुंइ लग पानी घट गय हबै। <verse eid="GEN 8:11" /><verse number="12" style="v" sid="GEN 8:12" />पय नूह सात रोज तक अउ रुके रथै, एखर बाद नूह परेबा के उडाथै, पय परेबा ओखर लिघ्घो लउटके नेहको आथै। <verse eid="GEN 8:12" /><verse number="13" style="v" sid="GEN 8:13" />जब नूह छय सव एक साल के होथै, ओखर पहिले महिना के पहिले रोज भुंइ के पानी सुखाय जथै, नूह जिहाज के छत के खोल के देखथै कि भुंइ सुखाय गय हबै। <verse eid="GEN 8:13" /><verse number="14" style="v" sid="GEN 8:14" />दूसर महिना के सत्ताइस रोज हे भुंइ पूरी तरह सुखाय जथै। <verse eid="GEN 8:14" /><verse number="15" style="v" sid="GEN 8:15" />तब भगवान नूह लग कथै, <verse eid="GEN 8:15" /><verse number="16" style="v" sid="GEN 8:16" />“तै अपन डउकी, टोरवन अउ पुतउवन के संग जिहाज लग बाहिर निकर। <verse eid="GEN 8:16" /><verse number="17" style="v" sid="GEN 8:17" />अउ तोर संग जउन जिन्दा परानी हबै, मतलब कि पसु चिरइया भुंइ हे रेंगै बाले जीव हबै, उनके सब के बाहिर निकार के ले आ जेखर लग भुंइ हे बहोत लरका पइदा करै, अउ उन फलै फुलै अउ भुंइ हे फइल जाय।” <verse eid="GEN 8:17" /><verse number="18" style="v" sid="GEN 8:18" />तब नूह अपन डउकी, टोरवा अउ पुतउ के संग जिहाज लग बाहिर आथै।<note caller="+" style="x"><char style="xo" closed="false">8:18 </char><char style="xt" closed="false"><ref loc="2PE 2:5">2 पतरस 2:5</ref></char></note> <verse eid="GEN 8:18" /><verse number="19" style="v" sid="GEN 8:19" />सगलू पसु, रेंगै बाले जीव, चिरइया अउ भुंइ हे सगलू चलै फिरै बाले जानवर अपन-अपन जात के संग जिहाज लग बाहिर निकर आइन।<verse eid="GEN 8:19" /></para>
  <para style="s">नूह बलि चढाथै</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 8:20" />नूह परभु के निता अक्ठी बेदी बनाथै, नूह सुध्द पसु अउ सुध्द पक्छी मसे कुछ के चुनथै अउ बेदी हे उनखर बलि चढाथै। <verse eid="GEN 8:20" /><verse number="21" style="v" sid="GEN 8:21" />जब परभु के बलि के खुसबू मिलथै तब भगवान अपन हिरदय हे सोचथै, “मनसेन के कारन मै भुंइ के अब सराप नेहको देहुं, मनसे बचपन लग जउन कुछ उनखर मन हे पइदा होथै ऊ बुराई पइदा होथै, जसना मै सगलू जीवन के अब मारे हव। ओसना उनके फेरै नेहको मरहुं।<note caller="+" style="x"><char style="xo" closed="false">8:21 </char><char style="xt" closed="false"><ref loc="2CO 2:15">2 कुरि 2:15</ref>; <ref loc="ISA 54:9">यसा 54:9</ref></char></note> <verse eid="GEN 8:21" /><verse number="22" style="v" sid="GEN 8:22" />जब तक दुनिया हबै, तब तक बोबाई कटाई के टेम आही, अउ हरमेसा सरदी, ठन्ड, घाम, बरसात, दिन, रात, कारतिक लगेतार होवत रही।”<verse eid="GEN 8:22" /></para>
  <chapter eid="GEN 8" />
  <chapter number="9" style="c" sid="GEN 9" />
  <para style="s">भगवान नूह के संग टीमा बांधथै</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 9:1" />भगवान नूह के अउ ओखर लरकन के आसिरवाद देथै अउ उनखर लग कथै, फला-फूला अउ भुंइ हे बगर जा। <verse eid="GEN 9:1" /><verse number="2" style="v" sid="GEN 9:2" />भुंइ के सगलू जानवर अउ बादर कर हर अक्ठी चिरइया तुम्हर इज्जत करहिन अउ तुम्हर लग डरहिन। भुंइ हे रेंगै बाले हर अक्ठी जीव अउ समुन्दर के हर अक्ठी मछडी तुम्हर इज्जत करहिन अउ तुम्हर लग डरहिन, तुम हइ सगलू के उप्पर अधिकार करिहा। <verse eid="GEN 9:2" /><verse number="3" style="v" sid="GEN 9:3" />सगलू रेंगै बाले जीव तुम्हर भोजन हुइहिन, जसना मै तुमके हरियर पउधा दय रथो, ओसनेन अब सब कुछ देथो। <verse eid="GEN 9:3" /><verse number="4" style="v" sid="GEN 9:4" />मै तुमके अक्ठी आदेस देथो, कि तुम कउनो जानवर के तब तक झइ खइहा, जब तक कि मास हे खून हबै।<note caller="+" style="x"><char style="xo" closed="false">9:4 </char><char style="xt" closed="false"><ref loc="LEV 7:26">लयबेवस्था 7:26</ref>; <ref loc="DEU 12:23">बेवस्थाबिबरन 12:23</ref>; <ref loc="1TI 4:3">1 तीमु 4:3</ref></char></note> <verse eid="GEN 9:4" /><verse number="5" style="v" sid="GEN 9:5" />काखे मै जरूर तुम्हर खून के बदला लइहों, मै हर पसु लग हर मनसेन लग बदला लइहों, मै हर मनसे लग ओखर भाई-बेहन के खून के बदला लइहों। <verse eid="GEN 9:5" /><verse number="6" style="v" sid="GEN 9:6" />भगवान मनसे के अपन रूप हे बनाय हबै, इहैनिता जउन कउ मनसे के खून बहाही, ओखर खून मनसे के दवारा बहाय जही। <verse eid="GEN 9:6" /><verse number="7" style="v" sid="GEN 9:7" />तुम फला-फूला, भुंइ हे बोहत बढत जा अउ अनगिनत मनसे हुइ जा। <verse eid="GEN 9:7" /><verse number="8" style="v" sid="GEN 9:8" />भगवान नूह अउ ओखर टोरवन लग कथै, <verse eid="GEN 9:8" /><verse number="9" style="v" sid="GEN 9:9" />“मै तुम्हर अउ तुम्हर बाद होय बाले तुम्हर लरका के संग, <verse eid="GEN 9:9" /><verse number="10" style="v" sid="GEN 9:10" />अउ सगलू जिन्दा परानी मतलब कि पक्छी, रखे बाले पसु, भुंइ के सगलू बन पसु अउ जिहाज लग निकरे बाले सगलू जीव के संग टीमा बांधथो। <verse eid="GEN 9:10" /><verse number="11" style="v" sid="GEN 9:11" />मै तुम्हर संग अपन हइ टीमा बांधथो कि फेर कबहुन पानी लग परानी नास नेहको हुइहिन, भुंइ के बरबाद करै निता फेरै कबहुन जल परलय नेहको होही।” <verse eid="GEN 9:11" /><verse number="12" style="v" sid="GEN 9:12" />भगवान फेरै कथै, मै तुम्हर संग अउ जेतका जिन्दा परानी तोर संग हबै, उन सगलू के संग जुग-जुग के निता टीमा बांधथो, भगवान के हइ चिन्हा हबै, <verse eid="GEN 9:12" /><verse number="13" style="v" sid="GEN 9:13" />मै बादर हे अपन दबोरा रखथो, ऊ मोर अउ भुंइ के बीच करे गय टीमा के चिन्हा होही। <verse eid="GEN 9:13" /><verse number="14" style="v" sid="GEN 9:14" />जब मै भुंइ के उप्पर बादर लइहों अउ उनखर बीच दबोरा दिखही, <verse eid="GEN 9:14" /><verse number="15" style="v" sid="GEN 9:15" />तब मोर जउन टीमा तुम्हर संग अउ सगलू जिन्दा परानी के संग बांधे हव, ओही मै सुरता करिहों, तब असना पानी फेरै नेहको बरसही जेखर लग सगलू परानी नास होय। <verse eid="GEN 9:15" /><verse number="16" style="v" sid="GEN 9:16" />जब बादर हे दबोरा दिखही तब उके देखके ऊ टीमा के सुरता करिहों, जउन मै भगवान अउ भुंइ के सगलू जिन्दा परानी के बीच बांधे हव। <verse eid="GEN 9:16" /><verse number="17" style="v" sid="GEN 9:17" />एखर बाद भगवान नूह लग कथै, “जउन टीमा मै अपन अउ भुंइ के सगलू परानी के बीच बांधे हव, ओखर इहै चिन्हा हबै।”<verse eid="GEN 9:17" /></para>
  <para style="s">नूह अउ ओखर टोरवा</para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 9:18" />जिहाज लग बाहिर निकरै बाले नूह के टोरवा, सेम, हाम अउ येपेत हबै, हाम कनान के बाफ रथै। <verse eid="GEN 9:18" /><verse number="19" style="v" sid="GEN 9:19" />हइ तीनोठे नूह के टोरवा रथै, अउ दुनिया के सगलू मनसे हइ तीनो लग पइदा हुइन। <verse eid="GEN 9:19" /><verse number="20" style="v" sid="GEN 9:20" />नूह खेती बारी करै का सुरुवात करिस, ऊ अंगूर कर अक्ठी बगिया लगाइस। <verse eid="GEN 9:20" /><verse number="21" style="v" sid="GEN 9:21" />नूह अक रोज अंगूर के दारू के पीके नसा हे भुत्त हुइ गय अउ अपन तम्बू हे बिगर कपडा के पसर गइस। <verse eid="GEN 9:21" /><verse number="22" style="v" sid="GEN 9:22" />तब कनान के बाफ हाम अपन बाफ नूह के लंगडा देखिस, अउ ऊ बाहिर आयके अपन दोनो भाइयन के गुठे देथै। <verse eid="GEN 9:22" /><verse number="23" style="v" sid="GEN 9:23" />तब सेम अउ येपेत अक्ठी कपडा अपन कांधा हे धरथै, अउ पछुत्ता चल के भित्तर गइन अउ उन अपन बाफ के ओढाय देथै, अउ उन अपन मुंह पाछू करे रथै, इहैनिता उन असना करथै, कि अपन बाफ के बिना कपडा के झइ देख सकै। <verse eid="GEN 9:23" /><verse number="24" style="v" sid="GEN 9:24" />जब नूह के नसा उतरथै तब ऊ जान जथै, कि ओखर सब लग नान लरका ओखर संग काहिन करे हबै। <verse eid="GEN 9:24" /><verse number="25" style="v" sid="GEN 9:25" />नूह उके सराप देथै, “कनान सापित हबै, ऊ अपन भाइयन के दासो के दास होय।” <verse eid="GEN 9:25" /><verse number="26" style="v" sid="GEN 9:26" />नूह फेरै कथै, “सेम के परभु भगवान धन्य हबै, कनान देस सेम के दास होय। <verse eid="GEN 9:26" /><verse number="27" style="v" sid="GEN 9:27" />भगवान येपेत के लरकन के फइलाबै, अउ येपेत सेम के तम्बू हे रहै, अउ कनान देस ओखर दास बनै।” <verse eid="GEN 9:27" /><verse number="28" style="v" sid="GEN 9:28" />जल परलय के बाद नूह तीन सव पचास साल तक जिन्दा रथै। <verse eid="GEN 9:28" /><verse number="29" style="v" sid="GEN 9:29" />हइ मेर लग नूह के कुल उमर नव सव पचास साल हुइस, एखर बाद नूह के मिरतू हुइ गइस।<verse eid="GEN 9:29" /></para>
  <chapter eid="GEN 9" />
  <chapter number="10" style="c" sid="GEN 10" />
  <para style="s">नूह कर खानदान<note caller="+" style="f"><char style="fr" closed="false">10:1 </char><char style="ft" closed="false">वंसावली</char></note></para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 10:1" />नूह कर टोरवा सेम, हाम अउ येपेत कर वंसावली हइ मेर हबै, जल परलय के बाद उनखर इन तीनोझन कर टोरवा पइदा होथै। <verse eid="GEN 10:1" /><verse number="2" style="v" sid="GEN 10:2" />येपेत कर टोरवा गोमेर, मागोग, मादै, यावान, तूबल, मेसेक अउ तीरास रथै। <verse eid="GEN 10:2" /><verse number="3" style="v" sid="GEN 10:3" />गोमेर कर टोरवा, असकनज, रीपत अउ तोगर्मा रथै। <verse eid="GEN 10:3" /><verse number="4" style="v" sid="GEN 10:4" />यावान कर टोरवा, एलीसा, तर्सीस, कित्ती अउ दोदानी मनसे रथै। <verse eid="GEN 10:4" /><verse number="5" style="v" sid="GEN 10:5" />इनखरै लग समुन्दर के लिघ्घो देसन हे रहै बाले जात पइलिन रहिन, इहै मनसेन अपन-अपन देसन हे अपन-अपन भासा, कुर अउ जात के जसना याफत के पुरखा रथै। <verse eid="GEN 10:5" /><verse number="6" style="v" sid="GEN 10:6" />हाम कर टोरवा, कूस, मिस्र, फूट अउ कनान रथै। <verse eid="GEN 10:6" /><verse number="7" style="v" sid="GEN 10:7" />कूस कर टोरवा, सेबा, हवीला, सबता, रामा अउ सबूतका रथै, रामा कर टोरवा, सेबा अउ ददान रथै। <verse eid="GEN 10:7" /><verse number="8" style="v" sid="GEN 10:8" />कूस कर अक्ठी रथै जेखर नाम निम्रोद रथै, जउन दुनिया के पहिला मनसे महा सक्तिसाली बिजेता रथै। <verse eid="GEN 10:8" /><verse number="9" style="v" sid="GEN 10:9" />ऊ परभु कर नजर हे बडा सिकारी रथै, इहैनिता ओखर बारे हे हइ किस्सा चले अउत हबै, परभु कर नजर हे निम्रोद, <verse eid="GEN 10:9" /><verse number="10" style="v" sid="GEN 10:10" />ओखर राज के सुरुवात बेबीलोन, एरेख, कलने अउ अक्कद लग हुइस। हइ सब सिनार देस हे हबै। <verse eid="GEN 10:10" /><verse number="11" style="v" sid="GEN 10:11" />ऊ उस देस लग निकर के अस्सूर देस हे आइस अउ उहां नीनवे, रहोबोतीर अउ कालह सहर के बसाइस। <verse eid="GEN 10:11" /><verse number="12" style="v" sid="GEN 10:12" />ऊ रेसेन नाम के सहर के बसाइस, जउन नीनवे अउ बडा सहर कालह के बीच के अक्ठी बडा सहर हबै। <verse eid="GEN 10:12" /><verse number="13" style="v" sid="GEN 10:13" />मिस्र डउकी लग लूदी, अनामी, लहाबी, नप्तूही, <verse eid="GEN 10:13" /><verse number="14" style="v" sid="GEN 10:14" />पतरूसी, कसलूही अउ कप्तोरी के पइदा करिस, कसलूही मनसे लग पलिस्ती मनसे निकरिस। <verse eid="GEN 10:14" /><verse number="15" style="v" sid="GEN 10:15" />कनान सीदोन के बाफ रथै, सीदोन कनान के पहिला लरका रथै फेर हित्ती लग पइदा होथै, <verse eid="GEN 10:15" /><verse number="16" style="v" sid="GEN 10:16" />अउ यबूसी, एमोरी, गिर्गासी, <verse eid="GEN 10:16" /><verse number="17" style="v" sid="GEN 10:17" />हिव्वी, अर्की, सीनी, <verse eid="GEN 10:17" /><verse number="18" style="v" sid="GEN 10:18" />अर्वदी, समारी अउ हमाती हुइन फेर कनानियन के जात फइल गइन। <verse eid="GEN 10:18" /><verse number="19" style="v" sid="GEN 10:19" />कनानियन मनसेन के इलाका सीदोन लग गरार के पल्ला<note caller="+" style="f"><char style="fr" closed="false">10:19 </char><char style="ft" closed="false">तरफ</char></note> गाजा तक अउ सदोम, अमोरा, अदमा अउ सबोयीम के पल्ला लासा तक रथै। <verse eid="GEN 10:19" /><verse number="20" style="v" sid="GEN 10:20" />हइ सगलू मनसे हाम के लरका रथै, उन सब परवार के अपन-अपन भासा अउ अपन-अपन परदेस रथै। <verse eid="GEN 10:20" /><verse number="21" style="v" sid="GEN 10:21" />सेम येपेत के बडा भाइ रथै, सेम के टोरवा पइदा हुइस, ऊ सगलू एबेर के मनसेन के बाफ रथै। <verse eid="GEN 10:21" /><verse number="22" style="v" sid="GEN 10:22" />सेम कर टोरवा, एलाम, अस्सूर, अर्पसद, लूद अउ अराम हुइस। <verse eid="GEN 10:22" /><verse number="23" style="v" sid="GEN 10:23" />अराम कर टोरवा, ऊस, हूल, गेतेर अउ मसे हुइस। <verse eid="GEN 10:23" /><verse number="24" style="v" sid="GEN 10:24" />अउ अर्पसद सेलह के बाफ रथै, सेलह एबेर कर बाफ रथै। <verse eid="GEN 10:24" /><verse number="25" style="v" sid="GEN 10:25" />एबेर कर दुइठे लरका हुइन, अक्ठी टोरवा कर नाम पेलेग रथै, उके हइ नाम इहैनिता दय गय रथै, काखे उन दिनन हे भुंइ के बांटा होय रथै, अउ दूसर भाई कर नाम योक्तान रथै। <verse eid="GEN 10:25" /><verse number="26" style="v" sid="GEN 10:26" />अउ योक्तान कर लरका, अल्मोदाद, अउ सेलेप, हसर्मावेत, येरह, <verse eid="GEN 10:26" /><verse number="27" style="v" sid="GEN 10:27" />यदोरवाम, ऊजाल दिक्ला, <verse eid="GEN 10:27" /><verse number="28" style="v" sid="GEN 10:28" />ओबाल, अबीमाएल, सेबा, <verse eid="GEN 10:28" /><verse number="29" style="v" sid="GEN 10:29" />ओपीर, हवीला अउ योबाब के पइदा करिस, इनै सब योक्तान के लरका रहिन। <verse eid="GEN 10:29" /><verse number="30" style="v" sid="GEN 10:30" />हइ मनसे मेसा अउ पूरब के अक्ठी डोंगर के बीच जमीन हे रथै, मेसा सपारा परदेस के तरफ रथै। <verse eid="GEN 10:30" /><verse number="31" style="v" sid="GEN 10:31" />उन मनसे सेम के घराना के रथै, अउ भासा, कुर, देस, जात के जसना अलगे-अलगे हुइ जथै। <verse eid="GEN 10:31" /><verse number="32" style="v" sid="GEN 10:32" />नूह के टोरवन लग चलै बाले घराना के हइ खानदान हबै, उन अपन-अपन देस हे बटर के रथै, जल परलय के बाद सगलू भुंइ हे फइले बाले मनसे नूह कर घराना लग निकरे हबै।<verse eid="GEN 10:32" /></para>
  <chapter eid="GEN 10" />
  <chapter number="11" style="c" sid="GEN 11" />
  <para style="s">भासा हे गडबडी</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 11:1" />बाढ के बाद सगलू मनसे दुनिया हे एकै भासा बोलथै, अउ सगलू मनसेन एकै बोली के परयोग करथै। <verse eid="GEN 11:1" /><verse number="2" style="v" sid="GEN 11:2" />जब मनसेन पूरब के पल्ला बढिन ता उनके सिनार देस हे अक्ठी मइदान मिलथै, मनसेन उहै रहै के निता रुक जथै। <verse eid="GEN 11:2" /><verse number="3" style="v" sid="GEN 11:3" />उन आपन हे सोचथै, कि हमके ईटा बनामै चाही अउ उके आगी हे पकामै के चाही, ताकि अउ ठोस बन सकै, इहैनिता मनसे अपन घर बनामै के निता पथरा के जिघा हे ईटा के परयोग करे लागथै, अउ चूना के जिघा हे माटी के गारा के परयोग करथै। <verse eid="GEN 11:3" /><verse number="4" style="v" sid="GEN 11:4" />एखर बाद मनसेन कथै, “हम अपन निता अक्ठी सहर बनइ अउ हम अक्ठी बोहत ऊंच इमारत बनउबे जउन बादर के छुवै, हइ मेर लग अपन नाम कमा लेब, अउ अगर असना करब ता पूरा भुंइ लग हमके अलगे होय के झइ पडै, हम अक जिघा अक संग रहब।” <verse eid="GEN 11:4" /><verse number="5" style="v" sid="GEN 11:5" />जउन सहर अउ इमारत के मनसे बनाउत रहै, भगवान उनही देखै के निता स्वरग लग उतर के तरी छो आइस। <verse eid="GEN 11:5" /><verse number="6" style="v" sid="GEN 11:6" />भगवान कथै, “हइ सगलू मनसे एकै भासा बोलथै अउ मै देखथो कि उन हइ काम के करै के निता अकजुट हबै, इन तो सब कुछु कर सकथै ओखर केबल सुरुवात हबै, जउन काम उन आगू करै के चाहथै, ऊ काम उनखर निता कठिन नेहको होही। <verse eid="GEN 11:6" /><verse number="7" style="v" sid="GEN 11:7" />इहैनिता आबा हम तरी छो चली अउ उनखर भासा हे गडबडी कर दइ, तब इन अक दूसर के बात के नेहको समझ पइहिन।” <verse eid="GEN 11:7" /><verse number="8" style="v" sid="GEN 11:8" />हइ मेर लग भगवान मनसेन के पूरी भुंइ हे फइलाय दइस, मनसे ऊ सहर के बनामै के काम पूर नेहको कर सकिन। <verse eid="GEN 11:8" /><verse number="9" style="v" sid="GEN 11:9" />इहै ऊ जिघा आय जिहां भगवान पूरी दुनिया के भासा के गडबड कर दय रहै, इहैनिता हइ जिघा के नाम बेबीलोन पडिस, हइ मेर लग भगवान ऊ जिघा लग मनसेन के भुंइ के सगलू देस हे फइलाइस।<verse eid="GEN 11:9" /></para>
  <para style="s">सेम कर पुरखा</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 11:10" />हइ सेम के परवार के किस्सा हबै, जल परलय के बाद जब सेम सव साल के होथै, ता ओखर लरका अर्पसद पइदा होथै। <verse eid="GEN 11:10" /><verse number="11" style="v" sid="GEN 11:11" />अर्पसद के पइदा होय के बाद सेम पांच सव साल जिन्दा रथै, ओखर कइठे टोरवा-टोरिया पइदा हुइन। <verse eid="GEN 11:11" /><verse number="12" style="v" sid="GEN 11:12" />जब अर्पसद पइतीस साल के होथै तब ऊ सेलह के पइदा करथै। <verse eid="GEN 11:12" /><verse number="13" style="v" sid="GEN 11:13" />सेलह के पइदा के बाद अर्पसद चार सव तीन साल जिन्दा रथै, इन दिनन हे ओखर कइनठे टोरवा-टोरिया पइदा हुइन। <verse eid="GEN 11:13" /><verse number="14" style="v" sid="GEN 11:14" />जब सेलह तीस साल के हुइस, तब ऊ एबेर के पइदा करिस। <verse eid="GEN 11:14" /><verse number="15" style="v" sid="GEN 11:15" />एबेर के पइदा के बाद सेलह चार सव तीन साल तक जिन्दा रथै, ओखरो कइनठे टोरवा-टोरिया पइदा हुइन। <verse eid="GEN 11:15" /><verse number="16" style="v" sid="GEN 11:16" />जब एबेर चउतिस साल के हुइस, तब ऊ पेलेग के पइदा करिस। <verse eid="GEN 11:16" /><verse number="17" style="v" sid="GEN 11:17" />पेलेग के पइदा के बाद एबेर चार सव तीस साल तक जिन्दा रथै, ओखरो कइनठे टोरवा-टोरिया पइदा हुइन। <verse eid="GEN 11:17" /><verse number="18" style="v" sid="GEN 11:18" />जब पेलेग तीस साल के हुइस तब ऊ रऊ के पइदा करथै। <verse eid="GEN 11:18" /><verse number="19" style="v" sid="GEN 11:19" />रऊ के पइदा के बाद पेलेग दुइ सव नव साल तक जिन्दा रथै, ओखरो कइनठे टोरवा-टोरिया पइदा हुइन। <verse eid="GEN 11:19" /><verse number="20" style="v" sid="GEN 11:20" />जब रऊ बत्तीस साल के हुइस तब ऊ सरुग के पइदा करिस। <verse eid="GEN 11:20" /><verse number="21" style="v" sid="GEN 11:21" />सरुग के पइदा के बाद रऊ दुइ सव सात साल तक जिन्दा रहिस, उनखरो कइठे टोरवा टोरिया पइदा हुइन। <verse eid="GEN 11:21" /><verse number="22" style="v" sid="GEN 11:22" />जब सरुग तीस साल के हुइस तब ऊ नाहोर के पइदा करिस। <verse eid="GEN 11:22" /><verse number="23" style="v" sid="GEN 11:23" />नाहोर के पइदा के बाद सरुग दुइ सव साल तक जिन्दा रहिस, उनखरो कइठे टोरवा-टोरिया पइदा हुइन। <verse eid="GEN 11:23" /><verse number="24" style="v" sid="GEN 11:24" />जब नाहोर उनतीस साल के हुइस तब ऊ तेरह के पइदा करिस। <verse eid="GEN 11:24" /><verse number="25" style="v" sid="GEN 11:25" />तेरह के पइदा के बाद नाहोर एक सव उन्नीस साल तक जिन्दा रहिस, ओखरो कइनठे टोरवा-टोरिया पइदा हुइन। <verse eid="GEN 11:25" /><verse number="26" style="v" sid="GEN 11:26" />जब तेरह सत्तर साल के हुइस तब ओखर टोरवा अब्राम, नाहोर अउ हारान के पइदा करथै।<verse eid="GEN 11:26" /></para>
  <para style="s">तेरह कर पुरखा</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 11:27" />हइ तेरह के परवार के किस्सा आय, तेरह अब्राम, नाहोर अउ हारान के पइदा करिस, हारान लूत के बाफ रथै। <verse eid="GEN 11:27" /><verse number="28" style="v" sid="GEN 11:28" />हारान के मिरतू ओखर बाफ तेरह के जियत हे कसदी जात के ऊर नाम के सहर हे हुइस, जउन ओखर पइदा के जिघा रथै। <verse eid="GEN 11:28" /><verse number="29" style="v" sid="GEN 11:29" />अब्राम अउ नाहोर दोनोझन काज करथै, अब्राम के डउकी सारै रथै, नाहोर के डउकी मिल्का रथै, मिल्का हारान के टोरिया रथै, हारान मिल्का अउ इस्का कर बाफ रथै। <verse eid="GEN 11:29" /><verse number="30" style="v" sid="GEN 11:30" />सारै के कउनो लरका नेहको रथै, काखे ऊ कउनो लरका पइदा करै के काबिल नेहको रथै। <verse eid="GEN 11:30" /><verse number="31" style="v" sid="GEN 11:31" />तेरह अपन टोरवा अब्राम, हारान कर टोरवा मतलब अपन नाती पोता लूत अउ अब्राम कर डउकी अउ अपन पुतउ सारै के संग लइके कसदी जात के ऊर सहर हे छांड देथै, ऊ कनान देस के पल्ला चल पडथै, पय जब ऊ हारान नाम देस हे पहुंचथै तब उहै बस जथै। <verse eid="GEN 11:31" /><verse number="32" style="v" sid="GEN 11:32" />तेरह दुइ सव पांच साल जिन्दा रहिस, तब ऊ हारान हे मर गइस।<verse eid="GEN 11:32" /></para>
  <chapter eid="GEN 11" />
  <chapter number="12" style="c" sid="GEN 12" />
  <para style="s">भगवान अब्राम के बुलाथै</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 12:1" />भगवान अब्राम लग कथै, “तै अपन देस अउ अपन घरबार के छांड दे, अपन बाफ के परवार के छांड के अउ ऊ देस छो जा जेही मै तोके दिखाहुं<note caller="+" style="x"><char style="xo" closed="false">12:1 </char><char style="xt" closed="false"><ref loc="ACT 7:2-3">प्रेरितो 7:2-3</ref>; <ref loc="HEB 11:8">इब्रानिन 11:8</ref> </char></note>। <verse eid="GEN 12:1" /><verse number="2" style="v" sid="GEN 12:2" />मै तोर लग अक्ठी बडा देस बनइहों, मै तोके आसीस देहुं, अउ तोर नाम के बडा बनइहों कि मनसेन के निता आसीस के कारन बनी। <verse eid="GEN 12:2" /><verse number="3" style="v" sid="GEN 12:3" />मै उन मनसेन के आसीस देहुं जउन मनसे तोके आसीस देइहिन, पय जउन कउ तोर संग बुरा करहिन, उनके मै सराप देहुं, दुनिया के सगलू मनसेन तोर दवारा मोर लग आसीस पइहिन।” <verse eid="GEN 12:3" /><verse number="4" style="v" sid="GEN 12:4" />अब्राम भगवान के आदेस के मानिस, ऊ हारान देस के छांड देथै, अउ अपन भतीज लूत के अपन संग लइ जथै, ऊ टेम अब्राम पछत्तर साल के रथै। <verse eid="GEN 12:4" /><verse number="5" style="v" sid="GEN 12:5" />जब अब्राम हारान देस के छांडिस ता ऊ अकेल्ले नेहको रथै, अब्राम अपन डउकी सारै, अउ अपन भतीज लूत के अउ हारान देस हे जउन कुछु उनखर लिघ्घो डेरा रथै, सगलू के धर लेथै अउ जउन हारान देस हे अब्राम के दास-दासी मिले रथै, उनोन के अपन संग लइके कनान देस के पल्ला चल पडिन, उन कनान देस हे परवेस करिन<note caller="+" style="x"><char style="xo" closed="false">12:5 </char><char style="xt" closed="false"><ref loc="ACT 7:4">प्रेरितो 7:4</ref>; <ref loc="HEB 11:8">इब्रानिन 11:8</ref></char></note> <verse eid="GEN 12:5" /><verse number="6" style="v" sid="GEN 12:6" />उन चलत-चलत अब्राम सकेम नाम के जिघा हे पहुंचथै, जिहां मोरे नाम के बडा बांझ रूख रथै, ऊ टेम कनानी मनसे ऊ देस हे रथै। <verse eid="GEN 12:6" /><verse number="7" style="v" sid="GEN 12:7" />जब भगवान अब्राम के आगू आइस तब अब्राम लग कथै, “मै हइ देस के तोर लरकन के दइहों।” भगवान अब्राम के आगू जउन जिघा हे परगट होय रथै, ऊ जिघा के अब्राम अक्ठी बेदी बनाइस<note caller="+" style="x"><char style="xo" closed="false">12:7 </char><char style="xt" closed="false"><ref loc="GAL 3:16">गलातियों 3:16</ref>; <ref loc="ACT 7:5">प्रेरितो 7:5</ref></char></note> <verse eid="GEN 12:7" /><verse number="8" style="v" sid="GEN 12:8" />एखर बाद अब्राम ऊ जिघा के छांड के बेतेल के पूरुब के पल्ला आई सहर हे पहुंचथै, उहां अब्राम अपन तम्बू बनाइस, डोंगर के पस्चिम हे बेतेल सहर रथै अउ हइ सहर पूरुब हे रथै, ऊ जिघा अब्राम भगवान के निता दूसर बेदी बनाइस अउ ऊ उहां पराथना करिस। <verse eid="GEN 12:8" /><verse number="9" style="v" sid="GEN 12:9" />एखर बाद अब्राम यातरा करत रथै, ऊ नेगव सहर के दख्खिन इलाका छो कढ गइन।<verse eid="GEN 12:9" /></para>
  <para style="s">अब्राम मिस्र देस हे आइस</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 12:10" />कनान देस हे बोहत अकाल पडथै अउ जमीन बहोत सुखाय जथै, बरसा नेहको होथै अउ कउनो चीज खाय के निता नेहको उगथै, इहैनिता अब्राम जिन्दा रहै के निता मिस्र देस हे कढ जथै, अउ उहां कुछ रोज तक रथै। <verse eid="GEN 12:10" /><verse number="11" style="v" sid="GEN 12:11" />जब अब्राम देखिस कि मोर डउकी सारै बोहत सुन्दर हबै, इहैनिता मिस्र देस पहुंचै लग पहिलेन अब्राम सारै लग कथै, “मै जानथो कि तै बोहत सुन्दर हबस। <verse eid="GEN 12:11" /><verse number="12" style="v" sid="GEN 12:12" />मिस्र के मनसे तोके देखहिन अउ उन कइहिन कि हइ ओखर डउकी आय, तब उन मोके मार डरहिन पय तोके जिन्दा रहै दइहिन।” <verse eid="GEN 12:12" /><verse number="13" style="v" sid="GEN 12:13" />इहैनिता तै मनसेन लग कहबे कि तै मोर बेहन हबस, तब उन मोके नेहको मरहिन उन मोर उप्पर दया करहिन, काखे उन समझहिन कि मै तोर भाइ यहों हइ मेर लग तै मोर जीवन बचइहे। <verse eid="GEN 12:13" /><verse number="14" style="v" sid="GEN 12:14" />जब अब्राम मिस्र देस हे परवेस करथै, तब उहां के मनसे देखथै कि ऊ डउकी बोहत सुन्दर हबै। <verse eid="GEN 12:14" /><verse number="15" style="v" sid="GEN 12:15" />कुछ मिस्र के अधिकारी ओही देखथै अउ उन फिरोन राजा लग कथै कि ऊ बोहत सुन्दर हबै। उन अधिकारी सारै के फिरोन राजा के घर लइ गइन। <verse eid="GEN 12:15" /><verse number="16" style="v" sid="GEN 12:16" />फिरोन राजा अब्राम के उप्पर दया करिस काखे ऊ समझथै कि ऊ सारै के भाई आय, फिरोन राजा अब्राम के गेडरा, गोरुवन, अउ गदहा-गदही दइस अब्राम के उंटवा के संग-संग मनसे अउ डउकी मतलब कि दास-दासी के रूप हे मिलिस। <verse eid="GEN 12:16" /><verse number="17" style="v" sid="GEN 12:17" />फिरोन राजा अब्राम के डउकी सारा के अपन लिघ्घो रोक लेथै, एखर लग भगवान फिरोन अउ ओखर घराना के मनसेन हे महामारी फइलाय देथै। <verse eid="GEN 12:17" /><verse number="18" style="v" sid="GEN 12:18" />इहैनिता फिरोन अब्राम के बुलाइस अउ कथै, “तै मोर संग हइ काहिन करे हबस? तै मोके काखे नेहको बताय कि सारै मोर डउकी आय? <verse eid="GEN 12:18" /><verse number="19" style="v" sid="GEN 12:19" />तै मोर लग काखे कहे रहस कि ऊ तोर बेहन आय? इहैनिता मै उके अपन डउकी बनामै के उद्देस्य लग लइ आयों, पय अब तै अपन डउकी के लइके कढ जा।” <verse eid="GEN 12:19" /><verse number="20" style="v" sid="GEN 12:20" />तब फिरोन अपन अधिकारी के आदेस देथै, कि अब्राम के मिस्र के बाहिर पहुंचाय दे, हइ मेर लग अब्राम अउ ओखर डउकी ऊ जिघा के छांडिन अउ उन सगलू डेरा के अपन संग लइ जथै जउन उनखर रथै।<verse eid="GEN 12:20" /></para>
  <chapter eid="GEN 12" />
  <chapter number="13" style="c" sid="GEN 13" />
  <para style="s">अब्राम अउ लूत अलगे हुइन</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 13:1" />अब्राम अपन डउकी अउ सगलू डेरा के संग मिस्र देस लग कनान देस दख्खिन इलाका लउटिन, लूतो उनखर संग रथै। <verse eid="GEN 13:1" /><verse number="2" style="v" sid="GEN 13:2" />हइ टेम अब्राम बोहत धनी रथै, ओखर लिघ्घो बोहत जानवर, बोहत चांदी अउ बोहत सोना रथै। <verse eid="GEN 13:2" /><verse number="3" style="v" sid="GEN 13:3" />अब्राम कनान देस दख्खिन इलाका लग आगू बढके बेतेल सहर के लउट जथै, ऊ बेतेल सहर अउ आई सहर के बीच के परदेस हे पहुंचथै, हइ उहै जिघा रथै जिहां अब्राम अउ ओखर परवार पहिले तम्बू बनाय के रुके रहै। <verse eid="GEN 13:3" /><verse number="4" style="v" sid="GEN 13:4" />हइ उहै जिघा हबै जिहां अब्राम अक्ठी बेदी बनाय रथै, इहैनिता अब्राम इहां भगवान लग पराथना करथै। <verse eid="GEN 13:4" /><verse number="5" style="v" sid="GEN 13:5" />हइ टेम लूतो अब्राम के संग चलथै, लूत के लिघ्घो बोहत गोरू छेडी, गेडरा अउ तम्बू रथै। <verse eid="GEN 13:5" /><verse number="6" style="v" sid="GEN 13:6" />ऊ देस हे एतका बडा चरामै के निता चारा के जिघा नेहको रथै कि अक संग रहि सकै, काखे उनखर लिघ्घो बोहत गोरू अउ डेरा रथै। <verse eid="GEN 13:6" /><verse number="7" style="v" sid="GEN 13:7" />अब्राम के गोरू के बरेदी अउ लूत के गोरू के बरेदी के बीच झगडा होमै लगिस, ऊ दिनन हे ऊ देस हे कनानी अउ परिज्जी जात के मनसे रथै। <verse eid="GEN 13:7" /><verse number="8" style="v" sid="GEN 13:8" />अब्राम लूत लग कथै, “हमर अउ तुम्हर बीच कउनो मेर के झगडा नेहको होमै के चाही, हमर अउ तुम्हर मनसेन के बीच झगडा झइ करै, हम सगलू भाई हबन। <verse eid="GEN 13:8" /><verse number="9" style="v" sid="GEN 13:9" />देख, सगलू देस तोर आगू हबै, तै मोर लग अलगे हुइ जा, अगर तै टेटरा<note caller="+" style="f"><char style="fr" closed="false">13:9 </char><char style="ft" closed="false">बांय तरफ</char></note> पल्ला जइहे ता मै दहिना पल्ला जइहों, अगर तै दहिना पल्ला जइहे ता मै टेटरा पल्ला जइहों।” <verse eid="GEN 13:9" /><verse number="10" style="v" sid="GEN 13:10" />जब लूत अपन नजर लग यरदन नदिया के घाटी के लूत देखथै कि उहां पानी बोहत हबै, हइ ऊ टेम के बात हबै, जब भगवान सदोम अउ अमोरा के नास नेहको करे रथै, ऊ टेम यरदन के नदिया के घाटी सोवर तक भगवान के बगइचा के जसना पूरा रास्ता हे फइले रथै, हइ परदेस मिस्र देस के जसना निक्खा रथै। <verse eid="GEN 13:10" /><verse number="11" style="v" sid="GEN 13:11" />इहैनिता लूत यरदन नदिया के घाटी हे रहै के सोच लेथै, हइ मेर लग दोनोझन अलगे हुइन अउ लूत पूरुब के पल्ला जाय के सुरु कर देथै। <verse eid="GEN 13:11" /><verse number="12" style="v" sid="GEN 13:12" />अब्राम कनान देस हे बस गइस, लूत यरदन के घाटी के सहर हे रहै लगिस, लूत सदोम सहर के लिघ्घो अपन तम्बू बनाइस। <verse eid="GEN 13:12" /><verse number="13" style="v" sid="GEN 13:13" />सदोम सहर के मनसे बोहत पापी रथै उन हरमेसा भगवान के बिरोध पाप करथै।<verse eid="GEN 13:13" /></para>
  <para style="s">अब्राहम के हेब्रोन के पल्ला गइस</para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 13:14" />जब लूत अब्राम लग अलगे हुइ गइस, तब भगवान ओखर लग कथै, “अपन चारो पल्ला देख, उत्तर, दख्खिन, पूरुब अउ पस्चिम के पल्ला देख। <verse eid="GEN 13:14" /><verse number="15" style="v" sid="GEN 13:15" />हइ सगलू जमीन जेही तै देखथस, मै तोके अउ तोर बाद हे आमै बाले लरकन के देथो, हइ जमीन हरमेसा के निता तोर हबै।<note caller="+" style="x"><char style="xo" closed="false">13:15 </char><char style="xt" closed="false"><ref loc="ACT 7:15">प्रेरितो 7:15</ref></char></note> <verse eid="GEN 13:15" /><verse number="16" style="v" sid="GEN 13:16" />मै तोर लरकन के भुंइ हे कुदरा<note caller="+" style="f"><char style="fr" closed="false">13:16 </char><char style="ft" closed="false">बालू</char></note> के जसना बढइहों, उनके कउ नेहको गिन पइहिन, अगर कउन भुंइ के कुदरा के गिन लइ, ता ऊ तोर लरकन के गिन लइ। <verse eid="GEN 13:16" /><verse number="17" style="v" sid="GEN 13:17" />इहैनिता जा, अपन जमीन हे रेंग बाग मै इके अब तोके देथो।” <verse eid="GEN 13:17" /><verse number="18" style="v" sid="GEN 13:18" />हइ मेर लग अब्राम अपन तम्बू के हटाइस, ऊ मम्रे के बांझ रूख के बीच जउन हेब्रोन सहर हे रथै आय के रहै लागथै, ऊ जिघा अब्राम भगवान कर अक्ठी बेदी बनाइस।<verse eid="GEN 13:18" /></para>
  <chapter eid="GEN 13" />
  <chapter number="14" style="c" sid="GEN 14" />
  <para style="s">अब्राम लूत के छंडाथै</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 14:1" />अम्रापेल सिनार के राजा रथै, अर्योक एल्लासार के राजा रथै, कदोर्लाओमेर एलाम के राजा रथै अउ तिदाल गोयीम के रथै, हइ राजकाल के घटना हबै। <verse eid="GEN 14:1" /><verse number="2" style="v" sid="GEN 14:2" />इन राजा मिलके सदोम के राजा बेरा, अमोरा के राजा बिर्सा, अउ अदमा के राजा सिनाब, सबोयीम के राजा सेमेबेर अउ बेला (बेला जउन सोवर कहाथै) मतलब कि सोवर के राजा के बिरोध अक्ठी लडाई लडिन। <verse eid="GEN 14:2" /><verse number="3" style="v" sid="GEN 14:3" />हइ पांच राजा सिद्दीम के घाटी मतलब म्रत सागर हे इकठ्ठा हुइन। <verse eid="GEN 14:3" /><verse number="4" style="v" sid="GEN 14:4" />हइ राजा कदोर्लाओमेर के सेबा बारह साल तक करे रथै, पय तेरहवां साल हे सगलू उनखर बिरोध हे हुइ गइन। <verse eid="GEN 14:4" /><verse number="5" style="v" sid="GEN 14:5" />इहैनिता चउदा साल हे कदोर्लाओमेर अउ ओखर संग उनखर लग लडै आइन, कदोर्लाओमेर अउ ओखर संग राजा रपाई मनसेन के असतरोत्कनम हे हराइन, उन हाम हे जूजी जात मनसेन के हराइन, उन एमि जात के मनसेन के सावे किर्यातैम हे हराइन। <verse eid="GEN 14:5" /><verse number="6" style="v" sid="GEN 14:6" />अउ उन होरियो मनसेन के सेईर के डोंगर परदेस लग हराय के एल्पारान के पल्ला भग गइन, एल्पारान मरुभूमि के लिघ्घो हबै। <verse eid="GEN 14:6" /><verse number="7" style="v" sid="GEN 14:7" />तब राजा कदोर्लाओमेर पाछू मुडिस अउ एन्मिसपात इलाका छो गइस, हइ कादेस कहलाथै, अउ सगलू अमालेकी मनसेन के हराइस, ऊ एमोरी मनसेन के हराइस, हइ मनसे हसासोन्तामार के जिघा हे रथै। <verse eid="GEN 14:7" /><verse number="8" style="v" sid="GEN 14:8" />ऊ दिनन हे सदोम के राजा, अमोरा के राजा, अदमा के राजा, सबोयीम के राजा, अउ बेला के राजा मतलब कि सोवर के राजा, सगलू एक्कै संग लडै के निता गइन। <verse eid="GEN 14:8" /><verse number="9" style="v" sid="GEN 14:9" />एलाम के राजा कदोर्लाओमेर, गोयीम के राजा तिदाल, सिनार के राजा अम्रापेल, अउ एल्लासार के राजा अर्योक लग लडिन, हइ मेर लग चारठे राजा पांच राजन लग लडथै। <verse eid="GEN 14:9" /><verse number="10" style="v" sid="GEN 14:10" />सिद्दीम के मइदान हे चिपचिपी माटी के बोहत गडहा रथै, जब सदोम अउ अमोरा के राजा भागिन तब उनखर बोहत सुपाही गडहा हे गिर पडथै, पय दूसर मनसे डोंगर हे भाग गइन। <verse eid="GEN 14:10" /><verse number="11" style="v" sid="GEN 14:11" />सदोम अउ अमोरा के लिघ्घो जउन कुछु रथै, उन उनखर सगलू खाय-पिये बाले चीजन के लूट लेथै अउ उहां लग कढ जथै। <verse eid="GEN 14:11" /><verse number="12" style="v" sid="GEN 14:12" />अब्राम के भाई के टोरवा लूत सदोम हे रथै, ओखर लिघ्घो जउन कुछु रथै ओखरो सब कुछ डेरा के लइ आनिन। <verse eid="GEN 14:12" /><verse number="13" style="v" sid="GEN 14:13" />अक्ठी मनसे जउन भाग के बच गय रथै, ऊ इब्रानी रथै, ऊ अब्राम के सगलू बात गुठेथै अब्राम पवितर बांझ रूख के पतेरा छो रथै, हइ पतेरा एमोरी मम्रे नाम के मनसे रथै, ऊ एस्कोल अउ आनेर के भाई रथै, हइ तीनोझन अब्राम के संगी रथै अउ उन अब्राम के मदद के निता अक्ठी टीमा<note caller="+" style="f"><char style="fr" closed="false">14:13 </char><char style="ft" closed="false">वाचा</char></note> बांधथै। <verse eid="GEN 14:13" /><verse number="14" style="v" sid="GEN 14:14" />जब अब्राम के पता चलथै कि लूत के पकड लय हबै, ता ऊ अपन पूरा परवार के अकजुट करथै, अउ उन मसे तीन सव अठारा सिक्छित सुपाही के लइके अब्राम दान सहर तक उनखर पीछा करथै। <verse eid="GEN 14:14" /><verse number="15" style="v" sid="GEN 14:15" />अब्राम रात हे अपन सेबकन के दल हे बांट देथै, अउ अपन सेबकन के संग हमला कराइस अउ दमिस्क सहर के उत्तर हे होबा सहर तक उनखर पीछा करथै। <verse eid="GEN 14:15" /><verse number="16" style="v" sid="GEN 14:16" />तब अब्राम उनखर दवारा लूटे हर सगलू चीज लइ आनिस, लूत अउ लूत के सगलू चीज के लूटे हर के वापिस लइ आनिस।<verse eid="GEN 14:16" /></para>
  <para style="s">मलिकिसिदक अब्राहम के आसीस दइस</para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 14:17" />कदोर्लाओमेर अउ ओखर संग सगलू राजा के हराय के बाद अब्राम अपन घर छो लउट आथै, तब सदोम के राजा, अब्राम लग भेंट करै के निता सावे किर्यातैम कर घाटी पहुंचथै, इके अब राजा के घाटी कथै। <verse eid="GEN 14:17" /><verse number="18" style="v" sid="GEN 14:18" />सालोम के राजा मलिकिसिदक अब्राम लग मिलै गइस, मलिकिसिदक, सब लग ऊंच भगवान के पुजारी रथै।<note caller="+" style="x"><char style="xo" closed="false">14:18 </char><char style="xt" closed="false"><ref loc="HEB 7:1-10">इब्रानिन 7:1-10</ref>; <ref loc="PSA 110:4">भजन 110:4</ref></char></note> <verse eid="GEN 14:18" /><verse number="19" style="v" sid="GEN 14:19" />मलिकिसिदक अब्राम के आसीस देथै अउ कथै, बादर अउ भुंइ के बनामै बाले भगवान अब्राम के आसीस दे। <verse eid="GEN 14:19" /><verse number="20" style="v" sid="GEN 14:20" />अउ हम सब लग बडा भगवान के महिमा होय, भगवान बैरी<note caller="+" style="f"><char style="fr" closed="false">14:20 </char><char style="ft" closed="false">दुस्मन</char></note> के हरामै हे तोर मदद करे हबै, तब अब्राम लडाई हे मिले हर चीज के दसमा हिस्सा मलिकिसिदक के दइस। <verse eid="GEN 14:20" /><verse number="21" style="v" sid="GEN 14:21" />तब सदोम के राजा अब्राम लग कथै, मोके केबल मोर मनसेन के दइ दे जउन बैरी उनके पकड के लइ गय रहै। <verse eid="GEN 14:21" /><verse number="22" style="v" sid="GEN 14:22" />अब्राम सदोम के राजा लग कथै, मै बादर अउ भुंइ के बनाय बाले भगवान के किरिया खाय हव, <verse eid="GEN 14:22" /><verse number="23" style="v" sid="GEN 14:23" />कि जउन तोर चीज आय ओहमा लग कुछु नेहको लेहूं, इहां तक कि जूता के डोरा धरै के जिघा तक नेहको लेहूं, मै हइ नेहको चाहथो कि तै असना कइहे कि मै अब्राम के धनी बनाय हबो। <verse eid="GEN 14:23" /><verse number="24" style="v" sid="GEN 14:24" />मै केबल ऊ भोजन के स्बीकारथो, जउन हमर जबान खाय हबै, पय तै दूसर मनसेन के उनखर हिस्सा दइ दे, हमर लडाई हे जीते हर चीज तै ले अउ एहमा लग कुछ आनेर, एस्कोल अउ मम्रे के दइ दे, हइ मनसे लडाई हे मोर मदद करे रथै।<verse eid="GEN 14:24" /></para>
  <chapter eid="GEN 14" />
  <chapter number="15" style="c" sid="GEN 15" />
  <para style="s">अब्राम के संग भगवान कर टीमा</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 15:1" />इन बातन के बाद अब्राम अक्ठी सपना देखथै, उके भगवान के अक्ठी संदेस मिलथै, “हे अब्राम झइ डेरा, मै तोर रक्छा करिहों अउ मै तोके अक्ठी बडा इनाम देहुं।” <verse eid="GEN 15:1" /><verse number="2" style="v" sid="GEN 15:2" />पय अब्राम कथै, “हे भगवान, हे परभु, तै मोके काहिन दइहे? मोर कउनो लरका नेहको आय, इहैनिता मोर हरवाह दमिस्क सहर के एलीएजेर मोर मरै के बाद सगलू कुछु पाही।” <verse eid="GEN 15:2" /><verse number="3" style="v" sid="GEN 15:3" />अब्राम कथै, “तै देख ले, तै मोके कउनो टोरवा नेहको दय हबस, इहैनिता मोर घर हे पइदा अक्ठी हरवाह मोर सगलू डेरा पाही।” <verse eid="GEN 15:3" /><verse number="4" style="v" sid="GEN 15:4" />तब भगवान कर हइ बचन अब्राम के लिघ्घो पहुंचिस, ऊ कथै, “तोर डेरा के तोर हरवाह नेहको पाही, तोर अक्ठी टोरवा होही अउ तोरै टोरवा तोर डेरा<note caller="+" style="f"><char style="fr" closed="false">15:4 </char><char style="ft" closed="false">सम्पत्ति</char></note> पाही।” <verse eid="GEN 15:4" /><verse number="5" style="v" sid="GEN 15:5" />तब भगवान अब्राम के बाहिर लइ जथै, ऊ कथै, “बादर के देख, कइन मेर के तराइयन के देख, हइ एतका हबै कि तै गिनो नेहको सकथस,” आमै बाले टेम हे “तोर घराना असनेन होही।”<note caller="+" style="x"><char style="xo" closed="false">15:5 </char><char style="xt" closed="false"><ref loc="ROM 4:18">रोमियो 4:18</ref>; <ref loc="HEB 11:12">इब्रानिन 11:12</ref></char></note> <verse eid="GEN 15:5" /><verse number="6" style="v" sid="GEN 15:6" />अब्राम भगवान के उप्पर बिस्वास करिस, भगवान ओखर बिस्वास के अक्ठी निक्खा काम मानिस।<note caller="+" style="x"><char style="xo" closed="false">15:6 </char><char style="xt" closed="false"><ref loc="ROM 4:3">रोमियो 4:3</ref>; <ref loc="GAL 3:6">गलातियों 3:6</ref>; <ref loc="JAS 2:23">याकूब 2:23</ref></char></note> <verse eid="GEN 15:6" /><verse number="7" style="v" sid="GEN 15:7" />भगवान अब्राम लग कथै, “मै उहै परभु यहों, जउन हइ देस तोर हक हे दे के निता तोके कसदी जात के ऊर सहर लग निकार लाय हव, हइ मै इहैनिता करे हव कि हइ परदेस मै तोके दइ सको, तै हइ परदेस के अपन वस हे कर सकस।” <verse eid="GEN 15:7" /><verse number="8" style="v" sid="GEN 15:8" />अब्राम भगवान लग पूंछथै, “हे परभु, हे भगवान, मोके कइसन बिस्वास होय कि हइ परदेस मोके मिलही?” <verse eid="GEN 15:8" /><verse number="9" style="v" sid="GEN 15:9" />भगवान ओही जबाब देथै, “हम अक्ठी टीमा बांधब, तै मोर निता तीन-तीन साल के अक्ठी बछिया, छेडी, गेडरा, पिन्डुक अउ अक्ठी परेबा के लरका मोर लिघ्घो लइ आनबे।” <verse eid="GEN 15:9" /><verse number="10" style="v" sid="GEN 15:10" />अब्राम हइ सगलू चीज भगवान के लिघ्घो लइ जथै, एखर बाद अब्राम इन परानिन के मार डारिस अउ हर अक्ठी के दुइ-दुइ खंडा कर देथै, अउ उन खंडा के आमने-सामने धरथै, पय ऊ चिराइयन के दुइ खंडा नेहको करिस। <verse eid="GEN 15:10" /><verse number="11" style="v" sid="GEN 15:11" />जब मांस खाय बाले चिरइया बेदी हे चढाय हर मांस के खाय के निता आय रथै, उनके अब्राम भगाय देथै। <verse eid="GEN 15:11" /><verse number="12" style="v" sid="GEN 15:12" />जब बेरा बुढे लगिस तब अब्राम के बोहत नींद आ जथै, अउ देखा बडा भय अउ अंधियार उके चारो पल्ला घेर लेथै, <verse eid="GEN 15:12" /><verse number="13" style="v" sid="GEN 15:13" />तब भगवान अब्राम लग कथै, “हइ बात जरूर जान ले तोर लरका अनचिन्हार देस हे जइहिन, जउन उनखर देस नेहको होही, उहां हरवाह बनके रइहिन अउ चार सव साल तक उनखर उप्पर दुख होत रही।<note caller="+" style="x"><char style="xo" closed="false">15:13 </char><char style="xt" closed="false"><ref loc="EXO 1:1-14">निरगमन 1:1-14</ref>; <ref loc="ACT 7:6">प्रेरितो 7:6</ref></char></note> <verse eid="GEN 15:13" /><verse number="14" style="v" sid="GEN 15:14" />पय जउन देस उनके हरवाह बनइहिन, उके मै सजा देहुं, एखर बाद उन बहोत धन के संग उहां लग निकर अइहिन।<note caller="+" style="x"><char style="xo" closed="false">15:14 </char><char style="xt" closed="false"><ref loc="EXO 12:36">निरगमन 12:36</ref>; <ref loc="EXO 12:40-41">12:40-41</ref>; <ref loc="ACT 7:7">प्रेरितो 7:7</ref></char></note> <verse eid="GEN 15:14" /><verse number="15" style="v" sid="GEN 15:15" />तै बोहत साल तक जिन्दा रइहे, तै सान्ति के संग मरिहे अउ तै अपन पुरखा के लिघ्घो गाडे जइहे। <verse eid="GEN 15:15" /><verse number="16" style="v" sid="GEN 15:16" />चार सव पीढी के बाद तुम्हर मनसेन हइ परदेस हे फेरै अइहिन, काखे एमोरी मनसे के निता सजा पामै के टेम नेहको आय हबै।” <verse eid="GEN 15:16" /><verse number="17" style="v" sid="GEN 15:17" />जब बेरा बुढ जथै, ता बोहत अंधियार छाय जथै, तब अक्ठी धुंवा बाले अंगठी अउ अक्ठी जलत मसाल उन खंडा के बीच हुइके गुजरिस। <verse eid="GEN 15:17" /><verse number="18" style="v" sid="GEN 15:18" />हइ मेर ऊ रोज भगवान अब्राम के बचन दइस अउ ओखर संग टीमा बांधिस, भगवान कथै, “मै हइ परदेस के तोर लरकन के दइहों, मै मिस्र के नदिया अउ बडा फरात के बीच के परदेस उनके देहुं। <verse eid="GEN 15:18" /><verse number="19" style="v" sid="GEN 15:19" />मतलब जिहां केनी, कनिज्जिया, कदमोनियन, <verse eid="GEN 15:19" /><verse number="20" style="v" sid="GEN 15:20" />हित्ती, परिज्जी, रपाई, <verse eid="GEN 15:20" /><verse number="21" style="v" sid="GEN 15:21" />एमोरी, कनानी, गिर्गासी अउ यबूसी मनसे रथै।”<verse eid="GEN 15:21" /></para>
  <chapter eid="GEN 15" />
  <chapter number="16" style="c" sid="GEN 16" />
  <para style="s">हाजिरा अउ इस्माइल</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 16:1" />अब्राम के डउकी सारा के कउनो लरका नेहको रथै, सारा के लिघ्घो अक्ठी मिस्र के हरवाहिन रथै, ओखर नाम हाजिरा रथै। <verse eid="GEN 16:1" /><verse number="2" style="v" sid="GEN 16:2" />सारा अब्राम लग कथै, “देख, भगवान मोके कउनो लरका नेहको दय हबै, इहैनिता मोर हरवाहिन के राख ले, मै ओखर लरका के अपन लरका मान लेहूं, अब्राम अपन डउकी के बात के मान लेथै।” <verse eid="GEN 16:2" /><verse number="3" style="v" sid="GEN 16:3" />जब अब्राम कनान देस हे दस साल रह चुकथै, तब सारा अपन मिस्री हाजिरा के दइ देथै, ताकि अब्राम के डउकी बनै। <verse eid="GEN 16:3" /><verse number="4" style="v" sid="GEN 16:4" />अब्राम हाजिरा के लिघ्घो गइस, तब हाजिरा लादा हे हुइस, जब हाजिरा देखथै कि लादा<note caller="+" style="f"><char style="fr" closed="false">16:4 </char><char style="ft" closed="false">गर्ववती</char></note> हे हव अउ हइ महसूस करे लागथै, कि मै अपन मालकिन सारा लग निक्खा हव। <verse eid="GEN 16:4" /><verse number="5" style="v" sid="GEN 16:5" />पय सारा अब्राम लग कथै, मोर हरवाहिन अब मोर लग घिनाथै इहैनिता मै तोके दोसी मानथो, मै ओही तोके दय रहों, ऊ लादा हे हुइस अउ तब ऊ महसूस करे लगिस, कि ऊ मोर लग निक्खा हबै, मै चाहथो कि भगवान सही नियाव करै। <verse eid="GEN 16:5" /><verse number="6" style="v" sid="GEN 16:6" />अब्राम सारा लग कथै, देख, तै हाजिरा के मालकिन हबस, तै ओखर संग जउन करै के चाहथस, ऊ कर, तब सारा हाजिरा के दुख देय लगिस इहैनिता हाजिरा उहां लग भाग जथै। <verse eid="GEN 16:6" /><verse number="7" style="v" sid="GEN 16:7" />भगवान के स्वरगदूत पतेरा हे पानी के झरना के लिघ्घो पाथै, हइ झरना सूर के पल्ला जाय बाले रास्ता हे रथै। <verse eid="GEN 16:7" /><verse number="8" style="v" sid="GEN 16:8" />परभु के दूत पूंछथै, “हाजिरा, तै सारा के हरवाहिन हवस, तै कछो लग आथस अउ कछो जथस?” हाजिरा कथै, “मै अपन मालकिन के इहां लग भाग के आय हबो।” <verse eid="GEN 16:8" /><verse number="9" style="v" sid="GEN 16:9" />भगवान के दूत ओखर लग कथै, “तै अपन मालकिन के घर जा अउ ओखर बात के मान।” <verse eid="GEN 16:9" /><verse number="10" style="v" sid="GEN 16:10" />भगवान के दूत ओखर लग इहो कहे रथै, “तोर लग बोहत लरका पइदा हुइहिन, हइ लरका एतका हुइ जइहिन, कि गिने नेहको जाय सके।” <verse eid="GEN 16:10" /><verse number="11" style="v" sid="GEN 16:11" />भगवान के दूत फेरै ओखर लग कथै, देख, तै लादा हे हबस, तै अक्ठी टोरवा के पइदा करिहे, तै ओखर नाम इस्माइल रखबे, काखे भगवान तोर परेसानी के सुने हबै अउ ऊ तोर मदद करही। <verse eid="GEN 16:11" /><verse number="12" style="v" sid="GEN 16:12" />ऊ मनसे इस्माइल पतेरा के गदहा के जसना आजाद होही, ओखर हाथ सब के बिरोध उठही, ऊ अक जिघा लग दूसर जिघा तक जही, ऊ अपन भाई के बिरोध निबास करही। <verse eid="GEN 16:12" /><verse number="13" style="v" sid="GEN 16:13" />तब भगवान हाजिरा लग बात करिस, ओखर बाद हाजिरा भगवान के अक्ठी नबा नाम लग पुकारिस, अत्ताएलरोई<note caller="+" style="f"><char style="fr" closed="false">16:13 </char><char style="ft" closed="false">सुनै बाले भगवान</char></note>, ऊ नाम इहैनिता धरिस, काखे हाजिरा खुदय कथै, “मै देखे हव कि ऊ मोर उप्पर नजर रखथै।” <verse eid="GEN 16:13" /><verse number="14" style="v" sid="GEN 16:14" />इहैनिता ऊ कुंवा के नाम लहैरोई रखे गइस, हइ कुंवा कादेस अउ बेरेद के बीच हे हबै। <verse eid="GEN 16:14" /><verse number="15" style="v" sid="GEN 16:15" />हाजिरा अब्राम के टोरवा के पइदा करिस, अउ ऊ टोरवा के नाम इस्माइल रखिस। <verse eid="GEN 16:15" /><verse number="16" style="v" sid="GEN 16:16" />अब्राम ऊ टेम छियासी साल के रथै, जब हाजिरा इस्माइल के पइदा करे रथै।<verse eid="GEN 16:16" /></para>
  <chapter eid="GEN 16" />
  <chapter number="17" style="c" sid="GEN 17" />
  <para style="s">खतना टीमा कर चिन्हा</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 17:1" />जब अब्राम निन्यानबे साल के हुइस, भगवान अब्राम लग सपना हे आय के कथै, मै सब लग सक्तिमान भगवान यहों, मोर निता हइ काम करा, मोर आदेस के माना अउ सही रास्ता हे चला। <verse eid="GEN 17:1" /><verse number="2" style="v" sid="GEN 17:2" />अगर तै हइ काम करिहा ता मै अपन अउ तोर बीच हे अक्ठी टीमा तइयार करिहों, मै तोर मनसेन के अक्ठी बडा देस बनामै के बचन देहुं। <verse eid="GEN 17:2" /><verse number="3" style="v" sid="GEN 17:3" />अब्राम अपन मूंड के जमीन हे झुकाइस तब भगवान ओखर लग बात करिस अउ कथै, <verse eid="GEN 17:3" /><verse number="4" style="v" sid="GEN 17:4" />“देख, तोर संग मोर हइ टीमा हबै, तै कइनठेन देस के बाफ बनिहे। <verse eid="GEN 17:4" /><verse number="5" style="v" sid="GEN 17:5" />मै तोर नाम के बदल दइहों, तोर नाम अब्राम नेहको रहि, अब लग तोर नाम अब्राहम होही, मै तोर नाम इहैनिता रखथो कि तै कइठे देस के बाफ बनिहे। <verse eid="GEN 17:5" /><verse number="6" style="v" sid="GEN 17:6" />मै तोके बोहत लरका दइहों, तोर लग नबा देस पइदा हुइहिन अउ तोर लग नबा राजा पइदा हुइहिन। <verse eid="GEN 17:6" /><verse number="7" style="v" sid="GEN 17:7" />मै अपन अउ तोर बीच अक्ठी टीमा बंधिहों, हइ टीमा सगलू लरकन के निता होही, मै तोर अउ तोर लरकन के बीच के भगवान रइहों, हइ टीमा हरमेसा के निता बने रही। <verse eid="GEN 17:7" /><verse number="8" style="v" sid="GEN 17:8" />अउ मै हइ परदेस तोके अउ तोर लरकन के दइहों, मै ऊ परदेस तोके देहुं जेखर लग तुम यातरा करत हबा, मै तोके कनान देस देहुं, मै तोके हइ परदेस हरमेसा के निता दइहों अउ मै तोर भगवान रइहों।”<note caller="+" style="x"><char style="xo" closed="false">17:8 </char><char style="xt" closed="false"><ref loc="ACT 7:5">प्रेरितो 7:5</ref></char></note> <verse eid="GEN 17:8" /><verse number="9" style="v" sid="GEN 17:9" />भगवान अब्राहम लग कथै, “अब टीमा के हइ तोर भाग हबै, मोर हइ टीमा के तै अउ तोर लरका पालन करहिन। <verse eid="GEN 17:9" /><verse number="10" style="v" sid="GEN 17:10" />हइ मोर टीमा हबै, जेखर पालन तोके करे के हबै, हइ टीमा मोर अउ तोर बीच अउ हइ तोर सगलू लरका के निता हबै, हर अक्ठी लरका जउन पइदा हुइहिन ओखर खतना<note caller="+" style="f"><char style="fr" closed="false">17:10 </char><char style="ft" closed="false">देह कर सुध्दिकरन करै के निता</char></note> जरूर होही।<note caller="+" style="x"><char style="xo" closed="false">17:10 </char><char style="xt" closed="false"><ref loc="ACT 7:8">प्रेरितो 7:8</ref>; <ref loc="ROM 4:11">रोमियो 4:11</ref></char></note> <verse eid="GEN 17:10" /><verse number="11" style="v" sid="GEN 17:11" />तै अपन खलरी के हइ जान के कटबे कि अपन अउ मोर बीच के टीमा हबै ओखर इहै चिन्हा होही। <verse eid="GEN 17:11" /><verse number="12" style="v" sid="GEN 17:12" />जब टोरवा आठ रोज के हुइ जाय, तब तै ओखर खतना करबे, हर अक्ठी टोरवा चाहे ऊ तोर घर के पइदा होय या परदेसी होय या पइसा दइके खरीदे गय होय, सब के खतना होय के जरूरी हबै। <verse eid="GEN 17:12" /><verse number="13" style="v" sid="GEN 17:13" />हइ मेर तोर देस के हर अक्ठी लरका के खतना होही, जउन टोरवा तोर घर हे पइदा होही या हरवाह के रूप हे खरीदे गय होय उन सगलुन के खतना होही। <verse eid="GEN 17:13" /><verse number="14" style="v" sid="GEN 17:14" />हइ मोर नियम हबै अउ मोर अउ तोर बीच के टीमा आय, जउन कउ के खलरी के खतना नेहको होही ऊ तुम्हर मनसेन लग अलगे कर दय जही, काखे ऊ मोर टीमा के टोरे हबै।<note caller="+" style="x"><char style="xo" closed="false">17:14 </char><char style="xt" closed="false"><ref loc="GEN 21:4">उत्पति 21:4</ref></char></note>”<verse eid="GEN 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 17:15" />भगवान अब्राहम लग कथै, “तै अपन डउकी सारय के सारय झइ कहबे, अब नबा नाम देहुं, ओखर नाम सारा होही। <verse eid="GEN 17:15" /><verse number="16" style="v" sid="GEN 17:16" />मै उके आसीस देहुं मै तोके ओखर दवारा अक्ठी टोरवा देहुं अउ तै बाफ कहाबे, अउ ऊ देस के दाय कहाही अउ कइठे राज के राजा ओखर लग पइदा हुइहिन।” <verse eid="GEN 17:16" /><verse number="17" style="v" sid="GEN 17:17" />अब्राहम अपन मूंड जमीन हे झुकाइस, पय ऊ हंसिस अउ अपन मन हे बोलथै, “का सव साल के डोकरा के लरका हुइ सकथै? का नब्बे साल सारा लादा हे हुइ सकथै?” <verse eid="GEN 17:17" /><verse number="18" style="v" sid="GEN 17:18" />अब्राहम भगवान लग कथै, हे परभु, “इस्माइल तोर नजर हे बने रहै, इहै बोहत हबै।” <verse eid="GEN 17:18" /><verse number="19" style="v" sid="GEN 17:19" />भगवान कथै, “तोर डउकी सारा तोर निता अक्ठी अउ टोरवा के पइदा करी, तै ओखर नाम इसहाक रखबे मै ओखर संग टीमा बंधिहों, हइ टीमा असना होही जउन ओखर सगलू लरका के संग हरमेसा बने रही।<note caller="+" style="x"><char style="xo" closed="false">17:19 </char><char style="xt" closed="false"><ref loc="GAL 4:7-8">गलातियों 4:7-8</ref></char></note> <verse eid="GEN 17:19" /><verse number="20" style="v" sid="GEN 17:20" />तै मोर लग इस्माइल के बारे हे पूंछे रहस अउ मै तोर बात के सुने हव, मै उके आसीस देहुं, ओखर बोहत लरका हुइहिन, ऊ बाराठे बडा राजन के बाफ होही, ओखर परवार अक्ठी बडा देस बनही। <verse eid="GEN 17:20" /><verse number="21" style="v" sid="GEN 17:21" />मै अपन टीमा इसहाक के संग बनइहों, इसहाक उ टोरवा होही जेही सारा पइदा करही, हइ टोरवा अगले साल इहै टेम हे पइदा होही।” <verse eid="GEN 17:21" /><verse number="22" style="v" sid="GEN 17:22" />जब भगवान अब्राहम लग बात करै के बन्द करै के बाद अब्राहम अकेल्ले रहि गय, भगवान ओखर लग दुरिहां स्वरग हे कढ जथै। <verse eid="GEN 17:22" /><verse number="23" style="v" sid="GEN 17:23" />अब्राहम अपन टोरवा इस्माइल के अउ अपन घर हे पइदा सगलू हरवाहन के बुलाइस, अउ जउन पइसा लग खरीद के लाय रथै, अब्राहम के घर के सगलू डउका अउ टोरवा के खतना उहै रोज भगवान के बचन के जसना उनखर खलरी के काट दय गइस। <verse eid="GEN 17:23" /><verse number="24" style="v" sid="GEN 17:24" />जब अब्राहम के खलरी के खतना करे गइस तब ऊ निन्यानबे साल के रथै। <verse eid="GEN 17:24" /><verse number="25" style="v" sid="GEN 17:25" />जब ओखर टोरवा इस्माइल के खलरी के खतना करे गइस तब ऊ तेरह साल के रथै। <verse eid="GEN 17:25" /><verse number="26" style="v" sid="GEN 17:26" />अब्राहम अउ ओखर टोरवा इस्माइल के खतना एक्कै रोज करे गइस। <verse eid="GEN 17:26" /><verse number="27" style="v" sid="GEN 17:27" />उहै रोज अब्राहम के घर के सगलू डउकन के खतना हुइस, अब्राहम के घर के पइदा या पइसा दइके खरीदे गय हर हरवाहन के खतना अक्कै रोज उनखर खलरी काट दय गय रहिन।<verse eid="GEN 17:27" /></para>
  <chapter eid="GEN 17" />
  <chapter number="18" style="c" sid="GEN 18" />
  <para style="s">इसहाक के पइदा होय के टीमा</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 18:1" />जब अब्राहम मम्रे नाम बांझ रूख के लिघ्घो दुपहरी के बहोत घाम हे अपन तम्बू के दूरा हे बइठे रथै, तब परभु ओखर आगू परगट होथै। <verse eid="GEN 18:1" /><verse number="2" style="v" sid="GEN 18:2" />अब्राहम अपन आंखी उठाय के देखथै, मोर आगू तीनठे डउका ठाढ हबै, जब अब्राहम उनके देखिस, अउ ऊ उनखर लिघ्घो गइस अउ उनके परनाम करिस। <verse eid="GEN 18:2" /><verse number="3" style="v" sid="GEN 18:3" />अब्राहम कथै, “हे परभु, तै अपन हइ सेबक के संग चुटु देर अउ रुक जा। <verse eid="GEN 18:3" /><verse number="4" style="v" sid="GEN 18:4" />मै तुम्हर निता गोड धोमै के निता पानी लाथो, तुम रूख के तरी बइठ जा। <verse eid="GEN 18:4" /><verse number="5" style="v" sid="GEN 18:5" />मै तुम्हर निता कुछ खाय के निता खाना लाथो, अउ तुमके जेतका खाय के होय, ओतका खा, एखर बाद तुम अपन यातरा सुरुवात कर सकथा। उन तीनो मनसे कथै, हइ बोहत अच्छा हबै, जसना तै चाहथस, ओसनेन कर।” <verse eid="GEN 18:5" /><verse number="6" style="v" sid="GEN 18:6" />अब्राहम हरबी तम्बू हे गइस, अउ सारा लग कथै, “हरबी तीनठे रोटियन के निता सोला किलो पिसान लगभग तइयार कर।” <verse eid="GEN 18:6" /><verse number="7" style="v" sid="GEN 18:7" />तब अब्राहम अपन गाय मवेसिन के लिघ्घो दउरिस, अउ ऊ सब लग अच्छा अक्ठी रकरा लइस, अब्राहम रकरा के हरवाहन के दइस, अउ उनखर लग कथै, कि रकरा के हरबी मारा अउ खाय के निता खाना तइयार करा। <verse eid="GEN 18:7" /><verse number="8" style="v" sid="GEN 18:8" />अब्राहम दूध अउ दही अउ पाले हर पसु के पके हर मांस तीनो डउकन के लिघ्घो पोरस देथै, जब तक उन खाना खात रथै, तब तक अब्राहम रूख कर तरी उनखर संग ठाढ रथै।<note caller="+" style="x"><char style="xo" closed="false">18:8 </char><char style="xt" closed="false"><ref loc="HEB 13:2">इब्रानिन 13:2</ref></char></note> <verse eid="GEN 18:8" /><verse number="9" style="v" sid="GEN 18:9" />उन मनसेन अब्राहम लग पूंछथै, “तोर डउकी सारा कछो हबै?” अब्राहम उनखर लग कथै, “ऊ तम्बू हे हबै।” <verse eid="GEN 18:9" /><verse number="10" style="v" sid="GEN 18:10" />तब भगवान कथै, “मै अगहन के मउसम हे फेरै आहुं, ऊ टेम तोर डउकी सारा अक्ठी टोरवा के पइदा करही,” जउन बात भगवान अब्राहम लग कथै, सारा तम्बू हे उन सगलू बात के सुनथै।<note caller="+" style="x"><char style="xo" closed="false">18:10 </char><char style="xt" closed="false"><ref loc="ROM 9:9">रोमियो 9:9</ref></char></note> <verse eid="GEN 18:10" /><verse number="11" style="v" sid="GEN 18:11" />अब्राहम अउ सारा दोनोझन बोहत डोकराय जथै, सारा पीरा के उमर के पार कर चुके रथै, ओखर मासिक धरम बन्द हुइ चुकथै।<note caller="+" style="x"><char style="xo" closed="false">18:11 </char><char style="xt" closed="false"><ref loc="ROM 4:9">रोमियो 4:9</ref></char></note> <verse eid="GEN 18:11" /><verse number="12" style="v" sid="GEN 18:12" />सारा मन हे हसिस अउ खुद लग कथै, “मै अउ मोर डउका दोनोझन डोकराय गय हवन, मै लरका पइदा करै के निता बोहत डोकरी हुइ गय हव।” <verse eid="GEN 18:12" /><verse number="13" style="v" sid="GEN 18:13" />तब भगवान अब्राहम लग कथै, “सारा काखे हसिस? ऊ काखे बोलिस, कि मै डोकरी हुइ गय हव, का लरका के पइदा कर सकिहों? <verse eid="GEN 18:13" /><verse number="14" style="v" sid="GEN 18:14" />का भगवान के निता कउनो काम मुस्किल हबै? मै आमै बाले टेम हे तोर लिघ्घो आहुं, अउ सारा कर लरका पइदा हुइ।” <verse eid="GEN 18:14" /><verse number="15" style="v" sid="GEN 18:15" />सारा अपन बात लग पलट जथै, काखे ऊ डर गय रथै, सारा कथै, “मै नेहको हसे यहों,” भगवान कथै, “नेहको तै जरूर हसे हवस।”<note caller="+" style="x"><char style="xo" closed="false">18:15 </char><char style="xt" closed="false"><ref loc="1PE 3:6">1 पतरस 3:6</ref></char></note><verse eid="GEN 18:15" /></para>
  <para style="s">सदोम सहर के निता बिनती</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 18:16" />तब उन डउका उहां लग उठथै, उन सदोम सहर के पल्ला देखथै, अउ उहै पल्ला चल पडथै, अब्राहम उनखर बिदा करै के निता उनखर संग कुछ दुरिहां तक संग गइस। <verse eid="GEN 18:16" /><verse number="17" style="v" sid="GEN 18:17" />परभु सोचथै, “मै जउन काम करै के जथो, का उके अब्राहम लग छुपाय रखो? <verse eid="GEN 18:17" /><verse number="18" style="v" sid="GEN 18:18" />अब्राहम लग अक्ठी बडा अउ सक्तिसाली देस बन जही, इहै कारन भुंइ के सगलू मनसेन आसीस पइहिन।<note caller="+" style="x"><char style="xo" closed="false">18:18 </char><char style="xt" closed="false"><ref loc="GEN 12:3">उत्पति 12:3</ref>; <ref loc="ACT 3:25">प्रेरितो 3:25</ref>; <ref loc="GAL 3:8">गलातियों 3:8</ref></char></note> <verse eid="GEN 18:18" /><verse number="19" style="v" sid="GEN 18:19" />मै अब्राहम के चुने हव कि ऊ अपन लरकन अउ परवार के, जउन ओखर बाद रइहिन, सिक्छा दे कि उन सही रास्ता अउ नियाव के काम करै अउ मोर रास्ता हे चलत रहै, तब मै ऊ बचन के पूर करिहों जउन भगवान अब्राहम के दय हव।” <verse eid="GEN 18:19" /><verse number="20" style="v" sid="GEN 18:20" />परभु कथै, “सदोम अउ अमोरा सहर के मनसेन बुराई, पाप बोहत बढ गय हबै। <verse eid="GEN 18:20" /><verse number="21" style="v" sid="GEN 18:21" />इहैनिता मै उहां जइहों अउ देखहुं, कि का हालत उतकै बेकार हबै जेतका मै सुने हव, तब मै सही-सही जान लइहों।” <verse eid="GEN 18:21" /><verse number="22" style="v" sid="GEN 18:22" />तब उन मनसे मुडिन अउ सदोम सहर छो चल पडथै, पय अब्राहम भगवान के आगू ठाढ रथै। <verse eid="GEN 18:22" /><verse number="23" style="v" sid="GEN 18:23" />तब अब्राहम भगवान लग कथै, “हे भगवान, का तै बेकार मनसेन के नास करै के संग निक्खा मनसेन के नास करै के बात सोचथस? <verse eid="GEN 18:23" /><verse number="24" style="v" sid="GEN 18:24" />अगर ऊ सहर हे पचास निक्खा मनसे हुइहिन ता का उनही तउभरमा तै सहर के नास कर दइहे? जरूर तै उहां रहै बाले पचास मनसे के निता ऊ सहर के नास नेहको करिहे। <verse eid="GEN 18:24" /><verse number="25" style="v" sid="GEN 18:25" />जरूर तै उस सहर के बचाय लइहे, बेकार मनसेन के मारै के निता तै निक्खा मनसेन के नास नेहको करिहे, अगर असना हुइस ता निक्खा अउ बेकार मनसे अक्कै हुइ जइहिन, दोनोझन के सजा मिलही, तै पूर भुंइ के न्याय करे बाले हबस, मै जानथो कि तै न्याय करबे।” <verse eid="GEN 18:25" /><verse number="26" style="v" sid="GEN 18:26" />तब भगवान कथै “अगर मोके सदोम सहर हे पचास निक्खा मनसे मिलहिन, ता उनखर कारन मै उहां के सगलू मनसेन के छमा कर देहुं।” <verse eid="GEN 18:26" /><verse number="27" style="v" sid="GEN 18:27" />तब अब्राहम कथै, “हे भगवान, तोर बरोबर हे मै केबल धूर अउ राख यहों, पय अपन गुरू लग बात करै के हिम्मत करथो। <verse eid="GEN 18:27" /><verse number="28" style="v" sid="GEN 18:28" />अगर पचास निक्खा मनसे लग कम होय ता का तै पांच कम होय जाय के कारन सगलू सहर के नास कर दइहे?” भगवान कथै, “अगर मोके उहां पइतालिस मनसे निक्खा मिलहिन ता मै उनही नास नेहको करहुं।” <verse eid="GEN 18:28" /><verse number="29" style="v" sid="GEN 18:29" />फेरै अब्राहम कथै, “अगर तोके उहां केबल चालीस निक्खा मनसे मिलहिन ता का तै सगलू सहर के नास कर दइहे?” तब भगवान कथै, “अगर मोके चालीस निक्खा मनसे उहां मिलहिन ता मै सहर के नास नेहको करहुं।” <verse eid="GEN 18:29" /><verse number="30" style="v" sid="GEN 18:30" />तब अब्राहम कथै, “हे भगवान किरपा करबे मोर उप्पर गुस्सा झइ होबे, मोके अउ पूंछय दे, अगर सहर हे केबल तीस निक्खा मनसेन हुइहिन ता का तै सगलू सहर के नास कर दइहे?” भगवान कथै, “अगर मोके तीस निक्खा मनसे उहां मिलहिन ता मै सहर के नास नेहको करिहों।” <verse eid="GEN 18:30" /><verse number="31" style="v" sid="GEN 18:31" />फेरै अब्राहम कथै, “हे भगवान, का मै तोके फेरै कास्ट देथो, अउ पूंछथो, कि अगर बीस निक्खा मनसेन उहां हुइहिन ता?” ता का ऊ सहर के नास कर देबे? भगवान कथै, “अगर मोके बीस निक्खा मनसेन उहां मिलहिन ता मै नास नेहको करिहों।” <verse eid="GEN 18:31" /><verse number="32" style="v" sid="GEN 18:32" />तब अब्राहम कथै, “हे भगवान तै मोर लग गुस्सा झइ होबे आखरी बेर कस्ट दे का मउका दे, अगर तोके उहां दस निक्खा मनसे मिलहिन ता तै काहिन करिहे?” भगवान कथै, “अगर सहर दस निक्खा मनसेन मिलहिन ता मै सहर नास नेहको करिहों।” <verse eid="GEN 18:32" /><verse number="33" style="v" sid="GEN 18:33" />एखर बाद भगवान अब्राहम लग बात करै का बन्द कर दइस, इहैनिता भगवान उहां लग कढ गइस अउ अब्राहम अपन घर छो लउट आथै।<verse eid="GEN 18:33" /></para>
  <chapter eid="GEN 18" />
  <chapter number="19" style="c" sid="GEN 19" />
  <para style="s">सदोम सहर के दुस्टता</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 19:1" />उन मसे दुइठे दूत संझा के टेम सदोम सहर हे पहुंचिन, लूत सदोम सहर के दूरा हे बइठे रथै, जब लूत उनके देखथै, तब ऊ उनखर सोगत के निता उठिस, लूत भुंइ हे मूंड के झुकके उनही नमस्कार करिस। <verse eid="GEN 19:1" /><verse number="2" style="v" sid="GEN 19:2" />लूत कथै, “मै तुम्हर लग बिनती करथो, तुम मोर घर चला, अउ अपन गोड धोय लेया, अउ तुम इहां रात रहि सकथा, तब आने रोज अपन यातरा हे जा सकथा।” स्वरगदूत कथै, “नही, हम चउकी हे रात बितउबे।” <verse eid="GEN 19:2" /><verse number="3" style="v" sid="GEN 19:3" />पय लूत अपन घर हे लइ जाय के निता उनही बेर-बेर कथै, हइ मेर लग स्वरगदूत ओखर घर हे जाय के निता तइयार हुइ जथै, जब उन घर पहुंचिन ता लूत उनखर निता पीय के निता पानी लइस, लूत उनखर निता रोटी बनाइस, अउ लूत के बनाय हर खाना के खाइन। <verse eid="GEN 19:3" /><verse number="4" style="v" sid="GEN 19:4" />तब उनखर सोय जाय के पहिले सदोम सहर के मनसेन लूत के घर के आयके चारो चउगिरदा लग घेर लेथै। <verse eid="GEN 19:4" /><verse number="5" style="v" sid="GEN 19:5" />उन लूत लग कथै, “आज रात के जउन मनसे तोर लिघ्घो आय हबै, उन दोनो डउका कछो हबै? उन डउकन के हमके दइ देया, हम उनखर संग गलत बेउहार करे चाहथन।” <verse eid="GEN 19:5" /><verse number="6" style="v" sid="GEN 19:6" />लूत बाहिर निकरिस अउ अपन पाछू लग ऊ केवाड के बन्द कर देथै। <verse eid="GEN 19:6" /><verse number="7" style="v" sid="GEN 19:7" />लूत उन मनसेन लग कथै, मै तुम्हर लग बिनती करथो, कि तुम बेकार काम झइ करा। <verse eid="GEN 19:7" /><verse number="8" style="v" sid="GEN 19:8" />देखा, मोर दुइठे टोरिया हबै, मै उनही तोर लिघ्घो बाहिर लाथो, जउन तुम्हर नजर निक्खा लगै ओसनेन उनखर संग करा, पय इन डउकन के कुछु झइ करा, काखे इन मोर घर हे आय हबै, अउ उनखर मदद जरूर करिहों। <verse eid="GEN 19:8" /><verse number="9" style="v" sid="GEN 19:9" />उन मनसेन कथै, “लूत हमर रास्ता लग हट जा,” “तै इहां रहै के निता आय हबस अउ अब न्याय करके जज बनै चाहथस, हम उनखर लग जादा तोर संग बुरा बेउहार करब,” उन मनसेन लूत के ढकेल देथै, अउ केवाड के टोरै के निता लिघ्घो आथै। <verse eid="GEN 19:9" /><verse number="10" style="v" sid="GEN 19:10" />पय उन स्वरगदूत हाथ बढाय के लूत के अपन लिघ्घो भित्तर तीन लेथै, अउ केवाड के ढांक देथै। <verse eid="GEN 19:10" /><verse number="11" style="v" sid="GEN 19:11" />दोनो स्वरगदूत केवाड के बाहिर के मनसेन के अंधरा कर देथै, हइ मेर लग घर हे घुसै बाले जबान, डोकरा सगलू अंधरा हुइ गइन अउ केवाड के खोजत-खोजत थक जथै।<note caller="+" style="x"><char style="xo" closed="false">19:11 </char><char style="xt" closed="false"><ref loc="2KI 6:18">2 राजा 6:18</ref></char></note><verse eid="GEN 19:11" /></para>
  <para style="s">लूत के सदोम लग बाहिर निकाडथै</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 19:12" />दोनो स्वरगदूत लूत लग कथै, “का हइ सहर हे असना मनसे हबै जउन तुम्हर परवार के होय? का तुम्हर दमांद, तोर टोरिया या दूसर कउ तुम्हर परवार के मनसे होय? अगर कउ दूसर हइ सहर हे तुम्हर परवार के हबै ता तै अभिन्नै सहर के छांडै के निता कहि दे। <verse eid="GEN 19:12" /><verse number="13" style="v" sid="GEN 19:13" />हम हइ सहर के नास करब, भगवान उन सगलू बुराइयन के सुन लय हबै, जउन हइ सहर हे हबै, इहैनिता भगवान हमही मनसेन के नास करै के निता पठोय हबै।” <verse eid="GEN 19:13" /><verse number="14" style="v" sid="GEN 19:14" />इहैनिता लूत बाहिर गइस अउ अपन टोरियन के काज करै बाले देमांदन लग बात करिस, लूत कथै, “हरबी करा अउ हइ सहर के छांड देया।” भगवान हइ सहर के नास करही, पय उन मनसेन समझथै कि लूत मजाक करथै।<note caller="+" style="x"><char style="xo" closed="false">19:14 </char><char style="xt" closed="false"><ref loc="LUK 17:28-29">लूका 17:28-29</ref></char></note> <verse eid="GEN 19:14" /><verse number="15" style="v" sid="GEN 19:15" />दूसर रोज के भिनसरहा<note caller="+" style="f"><char style="fr" closed="false">19:15 </char><char style="ft" closed="false">भोर</char></note> के टेम संदेस देय बाले दूत लूत लग हरबी करै के करथै, उन कथै, “देख हइ सहर के सजा मिलही, इहैनिता तै अपन डउकी अउ तुम्हर टोरिया जउन हबै, उनही लइके हइ जिघा के छांड दे, तब तै सहर के संग नास नेहको हुइहे।” <verse eid="GEN 19:15" /><verse number="16" style="v" sid="GEN 19:16" />पय लूत अउ देरी करथै, पय स्वरगदूत ओही अउ ओखर टोरिया के हाथ पकडके उनही सहर लग बाहिर लइ गइस, काखे भगवान लूत के उप्पर किरपा करथै। <verse eid="GEN 19:16" /><verse number="17" style="v" sid="GEN 19:17" />इहैनिता दोनोझन स्वरगदूत लूत अउ ओखर परवार के सहर के बाहिर पहुंचाय देथै, जब ऊ बाहिर हुइ गइस ता ऊ सहर मसे अकझन मनसे कथै, “अपन जीवन के बचामै के निता भागा, तब तक भागत रहा जब तक डोंगर हे न पहुंचा अगर तुम असना नेहको करिहा, ता तुम सहर के संग नास हुइ जइहा।” <verse eid="GEN 19:17" /><verse number="18" style="v" sid="GEN 19:18" />तब लूत दोनो स्वरगदूत लग कथै, “हे परभु, किरपा करके एतका दुरिहां दउरै का मजबूर झइ कर। <verse eid="GEN 19:18" /><verse number="19" style="v" sid="GEN 19:19" />तुम मोर जसना सेबक हे एतका जादा किरपा करे हबा, तुम मोके बचामै के निता किरपा करे हबा, पय मै डोंगर तक दउर नेहको सकथो, अपन जरूरत लग जादा दउरहों ता कुछ बुरा हुइ सकथै, अउ मै मर सकथो। <verse eid="GEN 19:19" /><verse number="20" style="v" sid="GEN 19:20" />देख इहां का ऊ नान हस सहर नेहको हबै? हमके ऊ सहर तक दउरन दे, तब हमर जीवन बच जही।” <verse eid="GEN 19:20" /><verse number="21" style="v" sid="GEN 19:21" />स्वरगदूत लूत लग कथै, “मै हइ सहर के बारे हे तुम्हर बिनती सुने हव, जउन सहर के बारे हे तै कहे हबस, ओही मै नास नेहको करिहों। <verse eid="GEN 19:21" /><verse number="22" style="v" sid="GEN 19:22" />पय उहां तक तेज दउर, मै तब तक सदोम सहर के नास नेहको करिहों। जब तक तुम ऊ सहर हे सुरक्छित नेहको पहुंच जा।” इहैनिता हइ सहर के नाम सोवर हबै, काखे हइ सहर नान हबै।<verse eid="GEN 19:22" /></para>
  <para style="s">सदोम अउ अमोरा के बिनास</para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 19:23" />जब लूत सोवर सहर हे घुसिस तब सुबेरे हुइस अउ बेरा निकर आइस <verse eid="GEN 19:23" /><verse number="24" style="v" sid="GEN 19:24" />अउ भगवान सदोम सहर अउ अमोरा सहर के नास करै भगवान आगी अउ जलत गंधक के बादर लग बरसाइस। <verse eid="GEN 19:24" /><verse number="25" style="v" sid="GEN 19:25" />हइ मेर लग भगवान उन सहरन के नास कर देथै, अउ पूर मइदान के सगलू जिन्दा मनसे अउ सगलू रूख के नास कर देथै। <verse eid="GEN 19:25" /><verse number="26" style="v" sid="GEN 19:26" />जब उन भागत रथै, ता लूत के डउकी पाछू मुडके सहर के देखथै, तब ऊ नून के खम्भा बन गइस।<note caller="+" style="x"><char style="xo" closed="false">19:26 </char><char style="xt" closed="false"><ref loc="LUK 17:32">लूका 17:32</ref></char></note> <verse eid="GEN 19:26" /><verse number="27" style="v" sid="GEN 19:27" />उहै रोज बोहत सकारे अब्राहम उठिस अउ ऊ जिघा हे गइस जिहां ऊ भगवान के आगू ठाढ होय करथै। <verse eid="GEN 19:27" /><verse number="28" style="v" sid="GEN 19:28" />अब्राहम सदोम अउ अमोरा सहर के नजर डालथै, ऊ परदेस लग बोहत कुहिरा के उठत देखथै, बडा भंयकर आगी जसना कुहिरा उप्पर उठत दिखथै। <verse eid="GEN 19:28" /><verse number="29" style="v" sid="GEN 19:29" />असना हुइस कि भगवान घाटी के सहरन के नास करिस, तब अब्राहम के सुरता आथै, जब भगवान उन सहरन के उलट-पुलट कर देथै, जिहां लूत रथै, तब बिनास के बीच लग लूत के निकार के दूसर सहर हे पठोय देथै।<verse eid="GEN 19:29" /></para>
  <para style="s">मोआबियन अउ अम्मोनियन के पइदा</para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 19:30" />लूत सोवर सहर हे लगेतार रहै लग डरथै, इहैनिता ऊ अउ ओखर दोनो टोरिया डोंगर हे गइन उन उहां अक्ठी गुफा हे रहै लगिन। <verse eid="GEN 19:30" /><verse number="31" style="v" sid="GEN 19:31" />अक रोज बडा टोरिया नान हस टोरिया लग कथै, “हमर बाफ डोकरा हबै, अउ इहां अक्को असना मनसे नेहको हमै जउन दुनिया के रीति रिवाज के जसना हमर लिघ्घो आमै अउ हम लरका पइदा करी। <verse eid="GEN 19:31" /><verse number="32" style="v" sid="GEN 19:32" />इहैनिता आ, हम अपन बाफ के दारू पियाके अउ ओखर संग सोउबे, जेखर लग हम अपन बाफ के दवारा ओखर वंस के बचाय सकी।” <verse eid="GEN 19:32" /><verse number="33" style="v" sid="GEN 19:33" />ऊ रात दोनो टोरिया अपन बाफ के लिघ्घो गइन अउ लूत के उन दारू पियाके नसा हे कर देथै, तब बडा टोरिया बाफ के जठना हे गइस, अउ ओखर संग सोइस, लूत बोहत नसा हे रथै, इहैनिता हइ नेहको जान सकिस कि ओखर संग कोन सोय हबै। <verse eid="GEN 19:33" /><verse number="34" style="v" sid="GEN 19:34" />दूसर रोज बडा टोरिया नान बेहन लग कथै, “पिछले बेर मै अपन बाफ के संग सोय रहों, आ हइ रात फेरै हम उके दारू पियाके नसा हे कर दइ, तब तै ओखर जेठना हे जाय सकथस, अउ ओखर संग सोय सकथस, हइ मेर लग हम अपन बाफ के निस्तार करके लरकन के पइदा करके अपन वंस के चलामै के निता करै चाही।” <verse eid="GEN 19:34" /><verse number="35" style="v" sid="GEN 19:35" />इहैनिता उन दोनो टोरिया अपन बाफ के दारू पियाके नसा हे कर देथै, तब नान बेहन ओखर जेठना हे गइस अउ ओखर लिघ्घो सोइस, लूत इहो बेर नेहको जान सकिस कि ओखर संग ओखर टोरिया सोय हबै। <verse eid="GEN 19:35" /><verse number="36" style="v" sid="GEN 19:36" />हइ मेर लग लूत के दोनो टोरिया अपन बाफ लग लादा हे हुइन अउ उनखर बाफ उनखर लरका के बाफ बन गइस। <verse eid="GEN 19:36" /><verse number="37" style="v" sid="GEN 19:37" />बडा टोरिया अक्ठी टोरवा के पइदा करिस, अउ ऊ टोरवा के नाम मोवाब रखिस, मोवाब उन सगलू मोवाबी जात मनसेन के बाफ हबै, जउन अब तक रहत हबै। <verse eid="GEN 19:37" /><verse number="38" style="v" sid="GEN 19:38" />नान बेहन टोरिया उहो अक्ठी टोरवा के पइदा करिस, इहो अपन टोरवा के नाम बेनम्मी रखिस, बेनम्मी अब उन सगलू अम्मोनी जात मनसेन के बाफ हबै जउन अब तक रहत हबै।<verse eid="GEN 19:38" /></para>
  <chapter eid="GEN 19" />
  <chapter number="20" style="c" sid="GEN 20" />
  <para style="s">अब्राहम अउ अबीमेलेक</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 20:1" />फेर अब्राहम उहां लग निकर के सूर कर बीच हे ठहरिस अउ कादेस गरार हे रहै लगिस। <verse eid="GEN 20:1" /><verse number="2" style="v" sid="GEN 20:2" />गरार सहर हे अब्राहम मनसेन लग कथै कि सारा मोर बेहन आय, गरार सहर के राजा अबीमेलेक हइ बात के सुनथै, तब अबीमेलेक राजा सारा के चाहे लागथै, इहैनिता ऊ हरवाहन के उके लामै के निता पठोथै।<note caller="+" style="x"><char style="xo" closed="false">20:2 </char><char style="xt" closed="false"><ref loc="GEN 12:13">उत्पति 12:13</ref>; <ref loc="GEN 26:7">26:7</ref></char></note> <verse eid="GEN 20:2" /><verse number="3" style="v" sid="GEN 20:3" />पय अक रात भगवान अबीमेलेक राजा लग सपना हे बात करिस, भगवान कथै, “देख, तै मर जइहे, जउन डउकी के तै लाय हबस ओखर काज हुइ चुके हबै।” <verse eid="GEN 20:3" /><verse number="4" style="v" sid="GEN 20:4" />पय अबीमेलेक राजा अब तक सारा के संग नेहको सोय रथै, इहैनिता अबीमेलेक कथै, “हे भगवान, मै दोसी नेहको यहों, का तै बेकसूर मनसे के मरिहे। <verse eid="GEN 20:4" /><verse number="5" style="v" sid="GEN 20:5" />अब्राहम मोर लग खुदय कहे हबै, हइ डउकी मोर बेहन आय, अउ इहो डउकी कहे हबै कि हइ डउका मोर भाई आय, मै बेकसूर हव मै नेहको जानथो कि मै काहिन करथो?” <verse eid="GEN 20:5" /><verse number="6" style="v" sid="GEN 20:6" />भगवान सपना हे अबीमेलेक के जबाब देथै, “हां, मै जानथो कि तै बेकसूर हबस, मै तोके मोर बिरोध पाप करै लग बचाय हव, अउ तोके उके छुवै नेहको दयों। <verse eid="GEN 20:6" /><verse number="7" style="v" sid="GEN 20:7" />इहैनिता अब्राहम के ओखर डउकी लउटाय दे, अब्राहम अक्ठी अक्किल बाले हबै, ऊ तोर निता बिनती करही अउ तै जिन्दा रइहे, अगर तै ऊ डउकी के नेहको लउटइहे, ता जान ले, मै तोके सराप देहुं कि तै अउ तोर सहर के सगलू मनसेन मर जइहिन।” <verse eid="GEN 20:7" /><verse number="8" style="v" sid="GEN 20:8" />तब अबीमेलेक सुबेन्ने उठके अपन सगलू हरवाहन के बुलाइस, अबीमेलेक राजा सपना हे होय हर बात उनही सगलू बताइस, हरवाह बोहत डर जथै। <verse eid="GEN 20:8" /><verse number="9" style="v" sid="GEN 20:9" />तब अबीमेलेक अब्राहम के बुलाइस अउ ओखर लग कथै, “तै हमर संग असना काखे करे? मै तोर काहिन बिगाडे रहों? तै हइ झूठ काखे बोले कि ऊ तोर बेहन आय, तै हमर सहर हे बोहत बडा पाप लाद दय हबस, हइ बात तोके मोर संग नेहको करै चाही? <verse eid="GEN 20:9" /><verse number="10" style="v" sid="GEN 20:10" />फेर अबीमेलेक अब्राहम लग पूंछथै? तै हइ काम केखर बजह लग करे हबस?” <verse eid="GEN 20:10" /><verse number="11" style="v" sid="GEN 20:11" />तब अब्राहम कथै, “मै डरत रहों, काखे मै सोचे रहों कि इहां कउ भगवान के भय नेहको मानथै, मै सोचे रहों कि सारा के पामै के निता मोके मार डरहिन। <verse eid="GEN 20:11" /><verse number="12" style="v" sid="GEN 20:12" />ऊ मोर डउकी आय, पय ऊ मोर बेहन हबै, ऊ मोर बाफ के टोरिया आय पय मोर दाय के टोरिया नेहको आय। <verse eid="GEN 20:12" /><verse number="13" style="v" sid="GEN 20:13" />भगवान मोके बाफ के घर लग दुरिहां पहुंचाइस, भगवान कइन मेर के अलगे-अलगे परदेस हे मोके पठोइस, जब असना हुइस ता मै सारा लग कहे रहों, मोर निता कुछु कर, मनसेन लग कहबे कि तै मोर भाई हबै।” <verse eid="GEN 20:13" /><verse number="14" style="v" sid="GEN 20:14" />तब अबीमेलेक राजा गेडरा-छेडी गाय गोरू अउ हरवाहन के अब्राहम के दइ दइस अउ ओखर डउकी सारा के लउटाय दइस। <verse eid="GEN 20:14" /><verse number="15" style="v" sid="GEN 20:15" />अबीमेलेक राजा कथै, “तै चारो पल्ला देख ले, हइ मोरै देस परदेस आय, तै जउन जिघा रहै का चाहथस, उहां रहि सकथस।” <verse eid="GEN 20:15" /><verse number="16" style="v" sid="GEN 20:16" />अबीमेलेक सारा लग कथै, “देख मै तोर भाई के एक हजार चांदी के खोटन्ना दय हव, जउन मनसेन तुम्हर संग हबै, उन सगलू के नजर हे तै सही हबस, अउ तै बेकसूर हबस, सगलू मनसेन के आगू तोर संग न्याय होय हबै।” <verse eid="GEN 20:16" /><verse number="17" style="v" sid="GEN 20:17" />तब अब्राहम भगवान लग बिनती करिस, अउ भगवान अबीमेलेक के डउकी अउ हरवाहिन के निक्खा कर देथै, उनखर फेर लरका होय लगिन। <verse eid="GEN 20:17" /><verse number="18" style="v" sid="GEN 20:18" />काखे भगवान अब्राहम के डउकी सारा के कारन अबीमेलेक के घर के सगलू डउकिन के कोखन के पूर मेर लग बन्द कर दय रथै।<verse eid="GEN 20:18" /></para>
  <chapter eid="GEN 20" />
  <chapter number="21" style="c" sid="GEN 21" />
  <para style="s">इसहाक कर पइदा</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 21:1" />भगवान सारा लग हइ बचन दय रथै कि ऊ सारा के उप्पर किरपा करही, ऊ अपन बचन के जसना ओखर उप्पर दया करिस।<note caller="+" style="x"><char style="xo" closed="false">21:1 </char><char style="xt" closed="false"><ref loc="HEB 11:11">इब्रानिन 11:11</ref></char></note> <verse eid="GEN 21:1" /><verse number="2" style="v" sid="GEN 21:2" />सारा लादा हे हुइस अउ डोकरी हे अब्राहम के निता अक्ठी लरका पइदा करिस, सही टेम हे जसना भगवान बचन दय रहै, ओसनेन हुइस। <verse eid="GEN 21:2" /><verse number="3" style="v" sid="GEN 21:3" />सारा टोरवा के पइदा करिस अउ अब्राहम ओखर नाम इसहाक रखिस।<note caller="+" style="x"><char style="xo" closed="false">21:3 </char><char style="xt" closed="false"><ref loc="MAT 1:2">मत्ती 1:2</ref>; <ref loc="LUK 3:34">लूका 3:34</ref></char></note> <verse eid="GEN 21:3" /><verse number="4" style="v" sid="GEN 21:4" />भगवान के आदेस के जसना अब्राहम आठ रोज होय के बाद इसहाक के खतना करिस।<note caller="+" style="x"><char style="xo" closed="false">21:4 </char><char style="xt" closed="false"><ref loc="ACT 7:8">प्रेरितो 7:8</ref></char></note> <verse eid="GEN 21:4" /><verse number="5" style="v" sid="GEN 21:5" />अब्राहम सव साल के रथै, जब ओखर टोरवा इसहाक पइदा हुइस। <verse eid="GEN 21:5" /><verse number="6" style="v" sid="GEN 21:6" />सारा कथै, “भगवान मोके खुस कर दय हबै, अउ हर अक्ठी मनसे जउन ई बारे हे सुनहिन ता मोर लग खुस हुइहिन। <verse eid="GEN 21:6" /><verse number="7" style="v" sid="GEN 21:7" />कउ हइ नेहको सोचथै, कि सारा अब्राहम के निता डोकरी हे उके अक्ठी टोरवा दइ सकही, पय मै डोकरी हे अक्ठी टोरवा दय हव।” <verse eid="GEN 21:7" /><verse number="8" style="v" sid="GEN 21:8" />ऊ टोरवा बडा हुइ गइस अउ ओखर दूध के छांडय गइस, तब जउन रोज इसहाक के दूध छांडय गइस, ऊ रोज अब्राहम खाना पीना रखिस।<note caller="+" style="x"><char style="xo" closed="false">21:8 </char><char style="xt" closed="false"><ref loc="GAL 4:22">गलातियों 4:22</ref>; <ref loc="HEB 11:11">इब्रानिन 11:11</ref></char></note><verse eid="GEN 21:8" /></para>
  <para style="s">हाजिरा अउ इस्माएल के निकारे जथै</para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 21:9" />बीते टेम हे मिस्री दासी हाजिरा अक्ठी टोरवा के पइदा करिस, अब्राहम ऊ टोरवा के बाफ रथै, सारा हाजिरा के टोरवा के खेलत देखिस। <verse eid="GEN 21:9" /><verse number="10" style="v" sid="GEN 21:10" />इहैनिता सारा अब्राहम लग कथै, “हाजिरा अउ ओखर लरका के इहां लग पठोय दे, जब हम मरब ता हमर सगलू डेरा इसहाक के मिलही, मै नेहको चाहथो कि ओखर लरका इसहाक के संग उन डेरन के बटवारा होय।” <verse eid="GEN 21:10" /><verse number="11" style="v" sid="GEN 21:11" />हइ सगलू बात अब्राहम के बोहत दुख कर देथै, ऊ अपन टोरवा इस्माएल के निता दुखी रथै।<note caller="+" style="x"><char style="xo" closed="false">21:11 </char><char style="xt" closed="false"><ref loc="GAL 4:29-30">गलातियों 4:29-30</ref></char></note> <verse eid="GEN 21:11" /><verse number="12" style="v" sid="GEN 21:12" />पय भगवान अब्राहम लग कथै, “ऊ टोरवा के बारे हे जादा दुख झइ हो, अउ हाजिरा के बारे दुख झइ हो, जउन सारा चाहथै, तै उहै कर, तोर लरका इसहाक कर लरका लग चलही।<note caller="+" style="x"><char style="xo" closed="false">21:12 </char><char style="xt" closed="false"><ref loc="ROM 9:7">रोमियो 9:7</ref>; <ref loc="HEB 11:18">इब्रानिन 11:18</ref></char></note> <verse eid="GEN 21:12" /><verse number="13" style="v" sid="GEN 21:13" />पय मै तोर हाजिरा के लरका के आसीस देहुं, काखे ऊ तोर लरका आय, इहैनिता मै ओखर परवार के अक्ठी बडा देस बनइहों।” <verse eid="GEN 21:13" /><verse number="14" style="v" sid="GEN 21:14" />दूसर रोज अब्राहम बोहत सुबेन्ने उठिस अउ कुछ खाना अउ खलरी के थइला हे पानी हाजिरा के दइ दइस, हाजिरा उन चीजन के धरिस अउ अपन लरका के संग उहां लग कढ गइस, हाजिरा ऊ जिघा के छांडिस अउ ऊ बेरसेबा के पतेरा हे भटके लगिस। <verse eid="GEN 21:14" /><verse number="15" style="v" sid="GEN 21:15" />कुछ टेम बाद हाजिरा के सगलू पानी बढाय जथै, पीय के निता कुछु पानी नेहको बचाथै, इहैनिता हाजिरा अपन लरका के अक्ठी पुडरा के तरी धर देथै। <verse eid="GEN 21:15" /><verse number="16" style="v" sid="GEN 21:16" />हाजिरा उहां लग कुछ दुरिहां गइस, तब ऊ रुकथै अउ बइठ जथै, हाजिरा सोचथै कि मोर लरका मर जइ काखे उहां पानी नेहको रथै, ऊ अपन टोरवा के मरत नेहको देखै चाहथै, अउ ऊ बोहत रोमै लग जथै। <verse eid="GEN 21:16" /><verse number="17" style="v" sid="GEN 21:17" />भगवान लरका के रोमै के आरो के सुनिस, भगवान अपन दूत के पठोथै हाजिरा के लिघ्घो, अउ ओखर लग पूंछथै, तोके का हुइ गय हबै? झइ डर, जिहां तोर लरका हबै, उहां लग भगवान ओखर आरो के सुने हबै। <verse eid="GEN 21:17" /><verse number="18" style="v" sid="GEN 21:18" />उठ अपन हाथ लग लरका के सम्भार, काखे मै उके बोहत मनसेन के बाफ बनइहों। <verse eid="GEN 21:18" /><verse number="19" style="v" sid="GEN 21:19" />तब भगवान ओखर आंखी के हइ मेर लग उंघारथै, कि ऊ अक्ठी पानी के कुंवा देख सकै, इहैनिता हाजिरा कुंवा कर लिघ्घो गइस, अउ अपन थइला के पानी लग भर के पिलाइस। <verse eid="GEN 21:19" /><verse number="20" style="v" sid="GEN 21:20" />अउ भगवान ओखर संग रथै, जब तक ऊ बढ नेहको गइस, अउ ऊ पतेरा हे रहत-रहत धनही चलामै के सिख जथै। <verse eid="GEN 21:20" /><verse number="21" style="v" sid="GEN 21:21" />ओखर दाय मिस्र लग ओखर निता दुलही लइस, उन पारान नाम के पतेरा हे रहै लागथै।<verse eid="GEN 21:21" /></para>
  <para style="s">अब्राहम अउ अबीमेलेक राजा के बीच टीमा</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 21:22" />तब अबीमेलेक अउ सुपाही पीकोल अब्राहम लग बात करिस, पीकोल अबीमेलेक राजा के सुपाही रथै, “तै जउन कुछु करथस, भगवान तोर संग रथै।<note caller="+" style="x"><char style="xo" closed="false">21:22 </char><char style="xt" closed="false"><ref loc="GEN 26:26">उत्पति 26:26</ref></char></note> <verse eid="GEN 21:22" /><verse number="23" style="v" sid="GEN 21:23" />इहैनिता तै भगवान के आगू किरिया खा, हइ किरिया खा कि तै मोर अउ मोर लरका के निता सही रइहे, तै हइ किरिया खा कि तै मोर पार जिहां कही रइहे ऊ देस के पार दया बाले मनसे रइहे, तै हइ किरिया खा कि मै तोर पल्ला जेकता दया बाले रहों, उतकै तै मोर उप्पर दया बाले रइहे।” <verse eid="GEN 21:23" /><verse number="24" style="v" sid="GEN 21:24" />अब्राहम कथै, “मै किरिया खइहों।” <verse eid="GEN 21:24" /><verse number="25" style="v" sid="GEN 21:25" />तब अब्राहम अबीमेलेक लग सिकायत करिस, ऊ इहैनिता सिकायत करिस कि अबीमेलेक के नोकर पानी के अक्ठी कुंवा के हथियाय लेथै। <verse eid="GEN 21:25" /><verse number="26" style="v" sid="GEN 21:26" />अबीमेलेक कथै, “एखर बारे हे मै हइ नेहको जानथो, मोके नेहको पता, कि हइ कोन करे हबै, अउ तहुं एखर बारे हे मोर लग कबहुन बात नेहको करे।” <verse eid="GEN 21:26" /><verse number="27" style="v" sid="GEN 21:27" />इहैनिता अब्राहम अउ अबीमेलेक राजा अक्ठी टीमा बांधिन, अउ अब्राहम छेडी-गेडरा गोरू अबीमेलेक के दइस। <verse eid="GEN 21:27" /><verse number="28" style="v" sid="GEN 21:28" />अब्राहम गेडरा के सातठे छउनन के अलगे करके रखिस। <verse eid="GEN 21:28" /><verse number="29" style="v" sid="GEN 21:29" />अबीमेलेक राजा अब्राहम लग पूंछथै, “हइ सात गेडरा के छउना के जउन तै अलगे करके रखे हबस, एखर काहिन मतलब हबै?” <verse eid="GEN 21:29" /><verse number="30" style="v" sid="GEN 21:30" />अब्राहम कथै, “जब तै हइ सातठे छउना के लरका के लइहे ता हइ सबूत होही कि हइ कुंवा के मै खने हव।” <verse eid="GEN 21:30" /><verse number="31" style="v" sid="GEN 21:31" />इहैनिता एखर बाद हे ऊ कुंवा बेरसेबा<note caller="+" style="f"><char style="fr" closed="false">21:31 </char><char style="ft" closed="false">सातठे गेडरा कर कुंवा</char></note> कहाइस, जिहां उन अक दूसर लग टीमा बांधे रथै।<note caller="+" style="x"><char style="xo" closed="false">21:31 </char><char style="xt" closed="false"><ref loc="GEN 26:33">उत्पति 26:33</ref></char></note> <verse eid="GEN 21:31" /><verse number="32" style="v" sid="GEN 21:32" />हइ मेर लग अब्राहम अउ अबीमेलेक बेरसेबा के टीमा बंधे रथै, तब अबीमेलेक राजा अउ ओखर सुपाही पीकोल दोनोझन पलिस्तियन के परदेस हे लउट जथै। <verse eid="GEN 21:32" /><verse number="33" style="v" sid="GEN 21:33" />अब्राहम बेरसेबा हे झाउ नाम के रूख लगाइस, अउ उहां भगवान लग भजन करिस। <verse eid="GEN 21:33" /><verse number="34" style="v" sid="GEN 21:34" />अउ अब्राहम पलिस्तियन के देस हे बोहत दिन तक परदेसी हुइके रहिस।<verse eid="GEN 21:34" /></para>
  <chapter eid="GEN 21" />
  <chapter number="22" style="c" sid="GEN 22" />
  <para style="s">परभु कर आदेस अउ अब्राहम कर परिक्छा</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 22:1" />इन बातन के बाद भगवान अब्राहम के बिस्वास के परिक्छा लेय का सोचिस, तब भगवान अब्राहम लग कथै, “अब्राहम” तब ऊ जबाब देथै, “हां परभु।<note caller="+" style="x"><char style="xo" closed="false">22:1 </char><char style="xt" closed="false"><ref loc="HEB 11:17">इब्रानिन 11:17</ref></char></note>” <verse eid="GEN 22:1" /><verse number="2" style="v" sid="GEN 22:2" />भगवान कथै, “तै अपन टोरवा, अपन अक्ठिन टोरवा इसहाक लग माया करथस, तै ओही लइके मोरिय्याह देस छो जा, तै ऊ डोंगर हे जइहे जिहां मै तोके दिखाहुं, उहां तै अपन टोरवा के मरिहे अउ ओही बलि के रूप हे मोके चढाइहे।” <verse eid="GEN 22:2" /><verse number="3" style="v" sid="GEN 22:3" />तब अब्राहम सुबेन्ने उठिस, अउ ऊ अपन गदहा के तइयार करिस, अब्राहम इसहाक अउ दुइठे हरवाहन के अपन संग लइस, अब्राहम बलि चढामै के निता लकडी काट के धरिस, तब उन ऊ जिघा गइन जिहां भगवान जाय के निता कहे रथै। <verse eid="GEN 22:3" /><verse number="4" style="v" sid="GEN 22:4" />उनखर तीन रोज यातरा के बाद अब्राहम दुरिहां लग ऊ जिघा के देखथै जिहां उनही जाय के रथै। <verse eid="GEN 22:4" /><verse number="5" style="v" sid="GEN 22:5" />तब अब्राहम अपन हरवाहन लग कथै, तुम गदहा के संग इहै रुका, मै अपन टोरवा के ऊ जिघा लइ जइहों, अउ महिमा करिहों, तब फेर तुम्हर लिघ्घो लउट अउब। <verse eid="GEN 22:5" /><verse number="6" style="v" sid="GEN 22:6" />अब्राहम बलि चढामै के निता लकडी के इसहाक के पिठार हे लाद देथै, अउ अपन हाथ हे आगी अउ छूरा लेथै, उन दोनो एक्कै संग चलथै। <verse eid="GEN 22:6" /><verse number="7" style="v" sid="GEN 22:7" />इसहाक अपन बाफ लग कथै, “बाफ जी” अब्राहम जबाब देथै, “हां टोरवा।” इसहाक कथै, “मै लकडी अउ आगी के देखथो पय ऊ गेडरा कछो हबै, जेही हम बलि के रूप हे चढाउबे?” <verse eid="GEN 22:7" /><verse number="8" style="v" sid="GEN 22:8" />अब्राहम ओखर लग कथै, भगवान बलि चढामै के निता गेडरा खुदय खोज लइ, हइ मेर लग ऊ अउ ओखर टोरवा दोनोझन संग-संग चलथै। <verse eid="GEN 22:8" /><verse number="9" style="v" sid="GEN 22:9" />उन दोनो ऊ जिघा पहुंचिन जिहां भगवान जाय का कहे रथै, उहां अब्राहम अक्ठी बलि के बेदी बनाइस, अउ ऊ बेदी हे लकडी मढाइस, तब ऊ अपन टोरवा इसहाक के हाथ के बांधिस अउ उके लकडी के उप्पर बेदी हे सोबय देथै।<note caller="+" style="x"><char style="xo" closed="false">22:9 </char><char style="xt" closed="false"><ref loc="JAS 2:21">याकूब 2:21</ref></char></note> <verse eid="GEN 22:9" /><verse number="10" style="v" sid="GEN 22:10" />तब अब्राहम अपन टोरवा के मारै के निता अक्ठी छूरा निकारथै। <verse eid="GEN 22:10" /><verse number="11" style="v" sid="GEN 22:11" />पय भगवान के दूत स्वरग लग पुकारके कथै, “अब्राहम, अब्राहम” अब्राहम जबाब देथै, “हां मै इछो हव।” <verse eid="GEN 22:11" /><verse number="12" style="v" sid="GEN 22:12" />दूत कथै, अपन टोरवा के झइ मार अउ ओही कुछु खारोच झइ पहुंचा, अब मै जान गय हव कि तै भगवान के आदेस के मानथस, मै देखो कि तै अपन अक्ठिन टोरवा के मोर निता मारै के निता तइयार हुइ गय। <verse eid="GEN 22:12" /><verse number="13" style="v" sid="GEN 22:13" />अब्राहम अपन नजर डालिस कि ता अक्ठी छिगरी के देखिस, छिगरी के सींग अक्ठी पुडरा हे फंस गय रथै, इहैनिता ऊ गइस, अउ ओही पकडके मार डारिस, अब्राहम छिगरी के अपन टोरवा के जिघा बलि चढाइस। <verse eid="GEN 22:13" /><verse number="14" style="v" sid="GEN 22:14" />इहैनिता अब्राहम ऊ जिघा के नाम इरे रखिस, इरे के मतलब भगवान देखथै, आजो मनसे कथै, “हइ डोंगर हे भगवान के देखे जा सकथै।” <verse eid="GEN 22:14" /><verse number="15" style="v" sid="GEN 22:15" />भगवान के स्वरगदूत स्वरग लग अब्राहम के दूसर बेर पुकारथै। <verse eid="GEN 22:15" /><verse number="16" style="v" sid="GEN 22:16" />भगवान कथै, “तै मोर निता अपन टोरवा के मारै के निता तइयार रथस, हइ तोर अक्ठिन टोरवा रथै, तै मोर निता असना करे हबस, इहैनिता मै तोके किरिया खथो कि,<note caller="+" style="x"><char style="xo" closed="false">22:16 </char><char style="xt" closed="false"><ref loc="HEB 6:13-14">इब्रानिन 6:13-14</ref></char></note> <verse eid="GEN 22:16" /><verse number="17" style="v" sid="GEN 22:17" />मै तोके जरूर आसीस देहुं, मै तोके एतका लरका दइहों जेतका बादर के तराइया हबै, हइ एतका मनसे हुइहिन जेतका समुन्दर के कुदरा हबै अउ तोर लरका सगलू बैरिन के हराइहिन।<note caller="+" style="x"><char style="xo" closed="false">22:17 </char><char style="xt" closed="false"><ref loc="HEB 11:12">इब्रानिन 11:12</ref></char></note> <verse eid="GEN 22:17" /><verse number="18" style="v" sid="GEN 22:18" />दुनिया के सगलू देस तोर घराना लग आसीस पइहिन, मै हइ इहैनिता करिहों काखे तै मोर बात के माने हबस।” <verse eid="GEN 22:18" /><verse number="19" style="v" sid="GEN 22:19" />तब अब्राहम अपन हरवाहन के लिघ्घो लउट अइस, उन बेरसेबा इलाका छो यातरा करिन अउ अब्राहम उहै रहै लगथै।<verse eid="GEN 22:19" /></para>
  <para style="s">नाहोर कर खानदान</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 22:20" />एखर बाद अब्राहम के हइ संदेस मिलथै, “तोर भाई नाहोर अउ ओखर डउकी मिल्का के अब लरका हबै।” <verse eid="GEN 22:20" /><verse number="21" style="v" sid="GEN 22:21" />पहिले टोरवा कर नाम ऊस हबै, दूसर टोरवा कर नाम बूज हबै, तीसर टोरवा कर नाम अराम अउ अराम कर बाफ कमूएल हबै। <verse eid="GEN 22:21" /><verse number="22" style="v" sid="GEN 22:22" />एखर बाद ओखर लरका केसेद, हजो, पिल्दास, इदलाप अउ बतूएल हबै। <verse eid="GEN 22:22" /><verse number="23" style="v" sid="GEN 22:23" />बतूएल, रिबका के बाफ रथै, मिल्का हइ आठठे टोरवन के दाय रथै, अउ नाहोर बाफ रथै, नाहोर अब्राहम के भाई रथै। <verse eid="GEN 22:23" /><verse number="24" style="v" sid="GEN 22:24" />नाहोर के चारठे लरका रथै ओखर अक्ठी रखेल डउकी रूमा रथै ओखर चारठे लरका रथै, अउ उनखर नाम तेबह, गहम, तहस, माका रथै।<verse eid="GEN 22:24" /></para>
  <chapter eid="GEN 22" />
  <chapter number="23" style="c" sid="GEN 23" />
  <para style="s">सारा कर मिरतू अउ आखरी किरिया करम</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 23:1" />सारा एक सव सत्ताइस साल तक जिन्दा रहिस। <verse eid="GEN 23:1" /><verse number="2" style="v" sid="GEN 23:2" />एखर बाद सारा कनान परदेस के किर्यतर्बा हेब्रोन सहर हे मर गइस, अब्राहम बोहत दुखी हुइस अउ सारा के निता उहां रोइस। <verse eid="GEN 23:2" /><verse number="3" style="v" sid="GEN 23:3" />तब अब्राहम अपन मरेहर डउकी के छांडिस अउ हित्ती मनसेन लग बात करै के निता गइस, <verse eid="GEN 23:3" /><verse number="4" style="v" sid="GEN 23:4" />अब्राहम कथै, “मै अनचिन्हार अउ परदेस हबो, मै केबल अक्ठी यातरी यहों, इहैनिता मोर लिघ्घो अपन डउकी के गाडै के निता जिघा नेहको हबै, मै तुम्हर लग चुटु हस जमीन मांगथो, जेखर लग मै अपन डउकी के गाड सको।<note caller="+" style="x"><char style="xo" closed="false">23:4 </char><char style="xt" closed="false"><ref loc="HEB 11:9">इब्रानिन 11:9</ref>,<ref loc="HEB 11:13">13</ref></char></note>” <verse eid="GEN 23:4" /><verse number="5" style="v" sid="GEN 23:5" />हित्ती मनसे अब्राहम लग कथै, <verse eid="GEN 23:5" /><verse number="6" style="v" sid="GEN 23:6" />“हे गुरू, तै हमर बीच हे भगवान के खास मनसे हबस, तै अपन मरेहर डउकी के गाडे के निता सब लग निक्खा जिघा जउन हमार लिघ्घो हबै, तै लइ सकथस, हम मसे कउ तोके तोर डउकी के गाडे लग नेहको रोके।” <verse eid="GEN 23:6" /><verse number="7" style="v" sid="GEN 23:7" />अब्राहम उठिस अउ हित्ती मनसेन के पल्ला जउन ऊ देस निवासी रथै, अपन मूंड के झुकाइस। <verse eid="GEN 23:7" /><verse number="8" style="v" sid="GEN 23:8" />अब्राहम उनखर लग कथै, “अगर तुम सही हे मोर मरेहर डउकी के गाडै हे मोर मदद करै चाहथा ता सोहर के टोरवा एप्रोन लग मोर निता बात करा। <verse eid="GEN 23:8" /><verse number="9" style="v" sid="GEN 23:9" />मै मकपेला नाम के गुफा के खरीदै चाहथो, एप्रोन एखर मालिक हबै हइ ओखर खेत के मेड हबै, मै एखर पूरा पइसा दइहों, मै चाहथो कि तुम हइ बात के गवाह रइहा, कि मै हइ जमीन के मरघटी के रूप हे खरीदे हव।” <verse eid="GEN 23:9" /><verse number="10" style="v" sid="GEN 23:10" />एप्रोन उहै हित्ती मनसे के बीच हे बइठे रथै, इहैनिता जेतका हित्ती ओखर सहर के फाटक लग हुइ के भित्तर जथै, उन सभा के आगू एप्रोन अब्राहम के जबाब देथै, <verse eid="GEN 23:10" /><verse number="11" style="v" sid="GEN 23:11" />“हां, गुरू जी, मै तोके जमीन दइहों, मै तोके गुफा दइहों, मै तोके इहैनिता दइहों कि तै एहमा अपन डउकी के गाड सकस।” <verse eid="GEN 23:11" /><verse number="12" style="v" sid="GEN 23:12" />तब अब्राहम हित्ती मनसेन के आगू अपन मूंड के झुकाइस। <verse eid="GEN 23:12" /><verse number="13" style="v" sid="GEN 23:13" />अब्राहम सगलू मनसेन के आगू एप्रोन लग कथै, “पय मै तो खेत के पूरा पइसा देय का चाहथो, मोर पइसा लेय के निता तइयार हुइ जा, मै अपन मरेहर डउकी के एहमा गाड सको।”<verse eid="GEN 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 23:14" />एप्रोन अब्राहम के जबाब देथै, <verse eid="GEN 23:14" /><verse number="15" style="v" sid="GEN 23:15" />“गुरू जी, मोर बात सुन, ऊ जमीन के कीमत चार सव चांदी के खोटन्ना हबै, पय ऊ तोर अउ मोर बीच हे का मतलब रखथस? जमीन ले अउ अपन मरेहर डउकी के गाड दे।” <verse eid="GEN 23:15" /><verse number="16" style="v" sid="GEN 23:16" />अब्राहम समझिस कि एप्रोन उके जमीन के कीमत बताय हबै, इहैनिता हित्ती मनसेन के मानके अब्राहम चार सव चांदी के खोटन्ना एप्रोन के निता तउलिस, अब्राहम पइसा के ऊ बनिया के दइ देथै, जउन हइ जमीन के बेचय के काम करथै। <verse eid="GEN 23:16" /><verse number="17" style="v" sid="GEN 23:17" />हइ मेर एप्रोन के जमीन, जउन मम्रे के लिघ्घो मकपेला के इलाका हे रथै, ऊ गुफा सहित अउ उन सगलू रूख सहित जउन जमीन हे अउ चारो पार मेड हे रथै, <verse eid="GEN 23:17" /><verse number="18" style="v" sid="GEN 23:18" />सहर के दूरा हे आय बाले सगलू हित्ती मनसेन के उपस्थिति हे अब्राहम के हक हे कर दय गइस। <verse eid="GEN 23:18" /><verse number="19" style="v" sid="GEN 23:19" />एखर बाद अब्राहम अपन डउकी सारा के मम्रे कनान परदेस हे (हेब्रोन) के लिघ्घो ऊ मकपेला खेत के गुफा हे गाड दइस। <verse eid="GEN 23:19" /><verse number="20" style="v" sid="GEN 23:20" />अब्राहम ऊ खेत अउ ओखर गुफा के हित्ती मनसेन लग खरीदिस, हइ ओखर डेरा हुइ गइस, अउ अब्राहम एखर निस्तार मरघटी के रूप हे करिस।<verse eid="GEN 23:20" /></para>
  <chapter eid="GEN 23" />
  <chapter number="24" style="c" sid="GEN 24" />
  <para style="s">इसहाक कर काज के वरनन</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 24:1" />अब्राहम डोकरा हुइ गय रहिस तउभरमा जिन्दा रहिस, भगवान उके आसीस दय रथै, अउ ओखर हर काम हे आसीस दइस। <verse eid="GEN 24:1" /><verse number="2" style="v" sid="GEN 24:2" />अब्राहम के अक्ठी बोहत पुरान हरवाह रथै, अब्राहम के जउन कुछु रथै, ओखर परबंधक रथै, अब्राहम ऊ हरवाह के अपन लिघ्घो बुलाइस अउ कथै, “अपन हाथ मोर जांघ के तरी धर। <verse eid="GEN 24:2" /><verse number="3" style="v" sid="GEN 24:3" />अब मै चाहथो कि तै मोके अक्ठी बचन दे, भुंइ अउ बादर के भगवान के आगू तै बचन दे कि तै कनान देस के कउनो टोरियन लग मोर टोरवा के काज नेहको होय दइहे, हम उनखर बीच हे रथन, पय अक्ठी कनानी टोरिया लग उके काज झइ करन दय। <verse eid="GEN 24:3" /><verse number="4" style="v" sid="GEN 24:4" />तै मोर देस अउ मोर अपन मनसे हे लउट जा, उहां मोर टोरवा इसहाक के निता अक्ठी दुलही खोजबे, तब उके इहां इसहाक के लिघ्घो ला।” <verse eid="GEN 24:4" /><verse number="5" style="v" sid="GEN 24:5" />हरवाह ओखर लग कथै, अगर टोरिया मोर संग हइ देस हे नेहको आही ता तब का मै तोर टोरवा के ऊ देस हे जिहां लग तै आय हबस, उके लइ जा सकथो? <verse eid="GEN 24:5" /><verse number="6" style="v" sid="GEN 24:6" />अब्राहम ओखर लग कथै, नेहको, तै मोर टोरवा के ऊ देस हे झइ लइ जाबे।<verse eid="GEN 24:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 24:7" />स्वरग के भगवान मोर पइदाइसी जिघा लग इहां लइके आय हबै, ऊ देस मोर बाफ अउ मोर परवार रथै, पय भगवान हइ बचन दय रथै, कि ऊ नबा परदेस मोर परवार बाले हुइहिन, भगवान अपन अक्ठी स्वरगदूत के तोर आगू पठोही जेखर लग तै मोर टोरवा के निता दुलही लइ अनबे। <verse eid="GEN 24:7" /><verse number="8" style="v" sid="GEN 24:8" />पय अगर टोरिया तोर संग आमै लग मना करही, ता तै मोर बचन लग छुटकारा पाय जइहे, पय तै मोर टोरवा के ऊ देस हे वापिस झइ ले जाबे। <verse eid="GEN 24:8" /><verse number="9" style="v" sid="GEN 24:9" />हइ मेर हरवाह अपन मालिक अब्राहम के जांघ के तरी अपन हाथ मढाय के बचन दइस। <verse eid="GEN 24:9" /><verse number="10" style="v" sid="GEN 24:10" />हरवाह अब्राहम के उंटवा मसे दसठे उंटवा छांट के लइस अउ ऊ जिघा लग कढ गइस, हरवाह कइन मेर के निक्खा भेंट अपन संग लइ गइस, ऊ नाहोर के सहर मेसोपोटामिया देस छो गइस। <verse eid="GEN 24:10" /><verse number="11" style="v" sid="GEN 24:11" />ऊ सहर के दूरा हे पहुंच के अक्ठी कुंवा के लिघ्घो अपन उंटवा के बइठाइस, संझा के टेम रथै, असना टेम हे टोरिया कुंवा लग पानी भरै निकरथै। <verse eid="GEN 24:11" /><verse number="12" style="v" sid="GEN 24:12" />हरवाह कथै, “हे परभु, तै मोर मालिक के भगवान हबस, आज तै ओखर टोरवा के निता मोके अक्ठी दुलही मिलवाय दे, किरपा मोर मालिक अब्राहम हे हइ दया कर। <verse eid="GEN 24:12" /><verse number="13" style="v" sid="GEN 24:13" />मै इहां हइ पानी के कुंवा के लिघ्घो ठाढ हव अउ पानी भरै के निता सहर के टोरिया आथै। <verse eid="GEN 24:13" /><verse number="14" style="v" sid="GEN 24:14" />अब असना होय कि जउन टोरिया लग मै कइहों, किरपा करके अपन गघरी तरी कर अउ मोके पानी पिया अउ ऊ जबाब दे, तै पानी पीले, अउ मै तोर उंटवा के पानी पियाइहों, ता ऊ उहै टोरिया होय जेही तै अपन सेबक इसहाक के निता चुने हबस, एखर लग मै जान जइहों कि तै मोर मालिक हे किरपा करे हबस।” <verse eid="GEN 24:14" /><verse number="15" style="v" sid="GEN 24:15" />ऊ हरवाह जसना बोलै के बन्द करिस, कि रिबका अपन खांधा हे गघरी धरे बाहिर आइस, अउ ऊ अब्राहम के भाई नाहोर अउ ओखर डउकी मिल्का के टोरवा बतूएल के टोरिया रथै। <verse eid="GEN 24:15" /><verse number="16" style="v" sid="GEN 24:16" />टोरिया बोहत सुन्दर रथै, अउ ऊ कुंवारी रथै, ओखर काज नेहको होय रथै, ऊ अपन गघरी भरै के निता कुंवा के लिघ्घो आइस। <verse eid="GEN 24:16" /><verse number="17" style="v" sid="GEN 24:17" />तब हरवाह ओखर लिघ्घो दउर के गइस, अउ कथै, “किरपा करके अपन गघरी लग पानी पिय के निता चुटुहस पानी दइ दे।” <verse eid="GEN 24:17" /><verse number="18" style="v" sid="GEN 24:18" />रिबका कथै, “हे मोर परभु, ले पी ले,” हरबी खांधा लग गघरी के तरी उतारिस अउ उके पानी पियाइस। <verse eid="GEN 24:18" /><verse number="19" style="v" sid="GEN 24:19" />जब हरवाह के पानी पिलाय चुकथै, तब कथै, जब तक तोर उंटवा पानी न पीले, तब तक मै उनखर निता पानी भरिहों। <verse eid="GEN 24:19" /><verse number="20" style="v" sid="GEN 24:20" />इहैनिता रिबका हरबी गघरी के सगलू पानी उंटवन के निता बने डोडा हे कुढाय देथै, तब ऊ अउ पानी लामै के निता कुंवा छो दउर गइस अउ ऊ सगलू उंटवा के पानी पिया दइस। <verse eid="GEN 24:20" /><verse number="21" style="v" sid="GEN 24:21" />हरवाह उके चुप्पेचाप धियान लग देखथै, ऊ सोचथै कि भगवान सायद बात मान लय हबै, अउ मोर यातरा के सफल बनाय दय हबै। <verse eid="GEN 24:21" /><verse number="22" style="v" sid="GEN 24:22" />जब उंटवा पानी पी चुकिन, तब हरवाह आधा तोला सोना कर अक्ठी फुलिया निकार के ओही दइस, अउ दस तोला सोना के कंगन ओखर हाथ हे पेहराय दइस। <verse eid="GEN 24:22" /><verse number="23" style="v" sid="GEN 24:23" />हरवाह ओखर लग पूंछथै, “तोर बाफ कोन आय? का तोर बाफ के घर हे हमर निता रुके के निता जिघा हबै?” <verse eid="GEN 24:23" /><verse number="24" style="v" sid="GEN 24:24" />ऊ कथै, “मोर बाफ बतूएल के टोरिया हबो, जउन मिल्का अउ नाहोर के टोरवा हबै।” <verse eid="GEN 24:24" /><verse number="25" style="v" sid="GEN 24:25" />तब ऊ कथै, अउ हां हमर लिघ्घो तोर उंटवा के निता चारा हबै अउ तोर सोमै के निता जिघा हबै। <verse eid="GEN 24:25" /><verse number="26" style="v" sid="GEN 24:26" />हरवाह मूंड के झुकाइस अउ भगवान के धन्यवाद दइस। <verse eid="GEN 24:26" /><verse number="27" style="v" sid="GEN 24:27" />हरवाह कथै, “मोर मालिक अब्राहम अउ भगवान के किरपा हबै, ऊ हमर मालिक के उप्पर किरपा करथै, ऊ मोके अपन मालिक के टोरवा के निता सही दुलही दय हबै।” <verse eid="GEN 24:27" /><verse number="28" style="v" sid="GEN 24:28" />तब रिबका दउडत अउ जउन कुछु होय रथै, ऊ अपन घर के मनसेन के गुठेइस। <verse eid="GEN 24:28" /><verse number="29" style="v" sid="GEN 24:29" />तब लाबान जउन रिबका भाई रथै, बाहिर कुंवा के लिघ्घो ऊ डउका के लिघ्घो दउडत गइस। <verse eid="GEN 24:29" /><verse number="30" style="v" sid="GEN 24:30" />अउ असना हुइस कि जब ऊ नथनी अउ अपन बेहन रिबका के हाथ हे कंगन के देखिस, अउ ओखर इहो बात सुनिस कि ऊ डउका मोर लग असना बात कहे हबै, तब ऊ हरवाह के लिघ्घो गइस अउ ऊ कुंवा के लिघ्घो उंटवा के संग ठाढ देखथै। <verse eid="GEN 24:30" /><verse number="31" style="v" sid="GEN 24:31" />लाबान कथै, “हे परभु, तै इछो आय हबस, तोर सोगत हबै, तोके इछो बाहिर ठाढ रहै के नेहको हबै, मै तोर उंटवा के निता रहै के अक जिघा बनाय दय हव, अउ तोर सोमै के निता अक्ठी कमरा ठीक कर दय हव।” <verse eid="GEN 24:31" /><verse number="32" style="v" sid="GEN 24:32" />इहैनिता अब्राहम के हरवाह घर हे गइस, लाबान उंटवा के उप्पर गोनिया हे रखथै अउ ओखर मदद करथै, अउ उंटवा के खाय के निता चारा दइस, तब लाबान पानी दइस, जेखर लग ऊ मनसे अउ ओखर संग आय बाले दूसर हरवाह अपन गोड धोय सकै। <verse eid="GEN 24:32" /><verse number="33" style="v" sid="GEN 24:33" />तब लाबान खाय के खाना देथै, पय हरवाह खाय लग मना कर देथै, हरवाह कथै, “मै तब तक खाना नेहको खइहों जब तक मै हइ बात नेहको गुठे दो, कि मै इहां कउन काम लग आय हव,” इहैनिता लाबान कथै, “तब तै हमही बता।” <verse eid="GEN 24:33" /><verse number="34" style="v" sid="GEN 24:34" />हरवाह कथै, “मै अब्राहम के हरवाह यहों। <verse eid="GEN 24:34" /><verse number="35" style="v" sid="GEN 24:35" />भगवान मोर मालिक के एतका आसीस दय हबै कि ऊ बोहत धनी हुइ गय हबै, परभु उके गेडरा छेडी, गाय गोरू, सोना-चांदी, हरवाह, उंटवा, गदहा दय हबै। <verse eid="GEN 24:35" /><verse number="36" style="v" sid="GEN 24:36" />सारा मोर मालिक के डउकी रथै, जब ऊ बोहत डोकराय गइस, तब ओखर अक्ठी टोरवा के पइदा करिस, अउ हमर मालिक अपन सगलू डेरा के अपन टोरवा के दइ दय हबै।” <verse eid="GEN 24:36" /><verse number="37" style="v" sid="GEN 24:37" />मोर मालिक मोके अक्ठी बचन दय हबै, मोर मालिक मोर लग कहे हबै, तै मोर टोरवा के निता कनान देस लग कउनो टोरियन लग काज नेहको करन दइहे, हम उनखर बीच हे रथन, पय मै नेहको चाहथो कि ऊ कउनो कनानी टोरिया लग काज करै। <verse eid="GEN 24:37" /><verse number="38" style="v" sid="GEN 24:38" />इहैनिता तोके बचन देय के होही कि तै मोर बाफ के देस जइहे, मोर परवार हे जा अउ मोर टोरवा के निता अक्ठी दुलही खोज। <verse eid="GEN 24:38" /><verse number="39" style="v" sid="GEN 24:39" />मै अपन मालिक लग कहे रथो, हइ हुइ सकथै कि ऊ दुलही मोर संग हइ देस हे झइ आबै। <verse eid="GEN 24:39" /><verse number="40" style="v" sid="GEN 24:40" />पय मोर मालिक कथै, मै भगवान के सेबा करथो, अउ भगवान तोर संग अपन स्वरगदूत के पठोही अउ तोर मदद करही, तोके उहां मोर मनसे मोर टोरवा के निता अक्ठी दुलही मिलही। <verse eid="GEN 24:40" /><verse number="41" style="v" sid="GEN 24:41" />पय अगर तै मोर बाफ के देस जथस, अउ उन मनसेन मोर टोरवा के निता दुलही देय लग मना करथै, ता तै मोर किरिया लग मुकति पाय जइहे। <verse eid="GEN 24:41" /><verse number="42" style="v" sid="GEN 24:42" />“आज मै कुंवा के लिघ्घो गयों, अउ मै कथो, हे स्वामी अब्राहम कर भगवान मोर मालिक के भगवान किरपा कर मोर यातरा सफल बनाय दे।” <verse eid="GEN 24:42" /><verse number="43" style="v" sid="GEN 24:43" />मै कुंवा के लिघ्घो ठाढ रइहों, अब असना होय कि पानी भरै के निता आय बाले टोरिया जेखर लग मै कइहों, किरपा मोके “अपन गघरी मसे चुटुहस पानी पिलाय दे” <verse eid="GEN 24:43" /><verse number="44" style="v" sid="GEN 24:44" />अउ ऊ मोके जबाब देही, पीले, “मै तोर उंटवा के निता पानी भरिहों, ता ऊ उहै टोरिया होय जेही परभु मोर मालिक के टोरवा निता चुने हबै।” <verse eid="GEN 24:44" /><verse number="45" style="v" sid="GEN 24:45" />मोर बात पूर होय लग पहिलेन रिबका कुंवा हे पानी भरै आइस, गघरी ऊ अपन खांधा हे रखे रथै, ऊ कुंवा तक गइस, अउ ऊ पानी भरिस मै एखर लग कहों, “किरपा करके मोके पानी दे। <verse eid="GEN 24:45" /><verse number="46" style="v" sid="GEN 24:46" />ऊ हरबी खांधा लग गघरी के झुकाइस अउ मोर निता पानी डालिस अउ कथै, पीले, मै तोर उंटवा के पियाइहों, इहैनिता मै पानी पियों, अउ अपन उंटवा के पानी पिलायों। <verse eid="GEN 24:46" /><verse number="47" style="v" sid="GEN 24:47" />तब मै ओखर लग पूंछो, तोर बाफ कोन आय? ऊ कथै, मै तो नाहोर के जन्माय मिल्का के टोरवा बतूएल के टोरिया आंव।” तब मै ओखर नाक हे ऊ फुलिया अउ ओखर हाथ हे उन चुरिया पहिराय दइन। <verse eid="GEN 24:47" /><verse number="48" style="v" sid="GEN 24:48" />ऊ टेम मै अपन मूंड के झुकायों अउ भगवान के धन्यवाद दयों, मै अपन मालिक अब्राहम के भगवान किरपा करे बाले आय कहों, मै उके धन्य कइहों, काखे ऊ सीधा मोर मालिक के भाई के नतिनिया तक मोके पहुंचाय हबै। <verse eid="GEN 24:48" /><verse number="49" style="v" sid="GEN 24:49" />अब अगर तुम मोर मालिक लग पूरी तरह लग किरपा अउ सही के बेउहार करे चाहथा, ता मोके बताबा अगर नेहको, ता ओसनेन मोर लग कहा, जेखर मै निस्चय कर सको कि मोके काहिन करै चाही। <verse eid="GEN 24:49" /><verse number="50" style="v" sid="GEN 24:50" />तब लाबान अउ बतूएल जबाब देथै, “हम हइ देखथन कि हइ भगवान के पल्ला लग हबै, इके हम नेहको कहि सकथन। <verse eid="GEN 24:50" /><verse number="51" style="v" sid="GEN 24:51" />रिबका तुम्हर आय, उके ला अउ लइ जा, अपन मालिक के टोरवा लग इके काज करै दा, इहै हबै जेही भगवान चाहथै।” <verse eid="GEN 24:51" /><verse number="52" style="v" sid="GEN 24:52" />अब्राहम के हरवाह हइ सुनिस अउ ऊ भगवान के आगू जमीन हे झुक गइस। <verse eid="GEN 24:52" /><verse number="53" style="v" sid="GEN 24:53" />तब ऊ रिबका के भेंट दइस जउन ऊ अपन संग लाय रथै, ऊ रिबका के सोना अउ चांदी गहिने अउ बोहत सुन्दर कपडा दइस, ऊ ओखर भाई अउ ओखर दाय के बोहत मंहगा भेंट दइस। <verse eid="GEN 24:53" /><verse number="54" style="v" sid="GEN 24:54" />तब ऊ अउ ओखर संगी खाइन पियन, अउ उन रात उहै बिताइन, जब उन सुबेन्ने सोय के उठथै तब हरवाह कथै, अब मोके अपन मालिक के लिघ्घो जाय के आदेस देया। <verse eid="GEN 24:54" /><verse number="55" style="v" sid="GEN 24:55" />रिबका के भाई अउ दाय कथै, टोरिया के कुछु टेम तक, कम से कम तक दस रोज हमर लिघ्घो रहै दे, ओखर बाद ऊ जाय सकथै। <verse eid="GEN 24:55" /><verse number="56" style="v" sid="GEN 24:56" />पय हरवाह उनखर लग कथै, “मोके झइ ओरगाबा, भगवान मोर यातरा के सफल करे हबै, अब मोके अपन मालिक के लिघ्घो लउटन देया।” <verse eid="GEN 24:56" /><verse number="57" style="v" sid="GEN 24:57" />रिबका के भाई अउ दाय कथै, “हम रिबका के बुलाथै अउ ओखर लग पूंछथन कि ऊ काहिन चाहथै?” <verse eid="GEN 24:57" /><verse number="58" style="v" sid="GEN 24:58" />उन रिबका के बुलवाइन अउ ओखर लग कथै, “का तै हइ मनसे के संग अबे जाय चाहथस?” ऊ कथै, “हां, मै जइहों।” <verse eid="GEN 24:58" /><verse number="59" style="v" sid="GEN 24:59" />इहैनिता उन रिबका के अब्राहम के हरवाह अउ ओखर संगी के संग जाय दइन, रिबका के दाय उनखर संग गइस। <verse eid="GEN 24:59" /><verse number="60" style="v" sid="GEN 24:60" />उन रिबका के आसिरवाद देत कथै, हे हमर बेहन, तै हजारो-लाखो टोरवा-टोरिया के दाय बन, तोर लरका अपन बैरी के सहर हे अधिकार करै। <verse eid="GEN 24:60" /><verse number="61" style="v" sid="GEN 24:61" />तब रिबका अउ दाय उंटवा हे चढिन अउ हरवाह अउ ओखर संगी के पाछू चले लगिन, हइ मेर लग रिबका के संग लइन अउ घर छो लउटै के यातरा सुरु करिन। <verse eid="GEN 24:61" /><verse number="62" style="v" sid="GEN 24:62" />इसहाक नेगेब इलाका हे रथै, ऊ लहैरोई नाम कुंवा लग हुइके चले आथै। <verse eid="GEN 24:62" /><verse number="63" style="v" sid="GEN 24:63" />ऊ संझा के टेम खुले मइदान हे बिनती करै के निकलिस, जब ऊ अपन आंखी के उठाइस ता दुरिहां लग उंटवा के अउत देखथै। <verse eid="GEN 24:63" /><verse number="64" style="v" sid="GEN 24:64" />रिबका नजर डालिस अउ इसहाक के देखिस, तब ऊ उंटवा लग उतर जथै। <verse eid="GEN 24:64" /><verse number="65" style="v" sid="GEN 24:65" />ऊ हरवाह लग पूंछथै, “हमर लग मिलै के निता खेतवा हे घूमै बाले ऊ डउका कोन आय?” हरवाह कथै, “हइ मोर मालिक के टोरवा आय।” इहैनिता रिबका अपन मुंह के दुपट्टा लग छुपाय लेथै। <verse eid="GEN 24:65" /><verse number="66" style="v" sid="GEN 24:66" />हरवाह इसहाक के सगलू बात गुठेथै जउन हुइ चुके रथै। <verse eid="GEN 24:66" /><verse number="67" style="v" sid="GEN 24:67" />इसहाक टोरिया के अपन दाय सारा के तम्बू हे लइ गइस, उहै रोज इसहाक रिबका लग काज कर लेथै, इसहाक ओखर लग बोहत माया करथै, हइ मेर लग इसहाक के ओखर दाय के मिरतू के बाद सान्ति पाइस।<verse eid="GEN 24:67" /></para>
  <chapter eid="GEN 24" />
  <chapter number="25" style="c" sid="GEN 25" />
  <para style="s">अब्राहम कर दूसर खानदान</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 25:1" />अब्राहम अक्ठी अउ डउकी लग काज करिस, जेखर नाम कतूरा रथै।<note caller="+" style="x"><char style="xo" closed="false">25:1 </char><char style="xt" closed="false"><ref loc="1CH 1:32">1 इति 1:32</ref>,<ref loc="1CH 1:33">33</ref></char></note> <verse eid="GEN 25:1" /><verse number="2" style="v" sid="GEN 25:2" />कतूरा जिम्रान, योकछान, मदना, मिद्यान, इसबाक अउ सहै के पइदा करिस। <verse eid="GEN 25:2" /><verse number="3" style="v" sid="GEN 25:3" />योकछान लग सेबा अउ ददान के हुइस, ददान के लरका अस्सूर लतूसी अउ लुम्मी मनसे हुइन। <verse eid="GEN 25:3" /><verse number="4" style="v" sid="GEN 25:4" />मिद्यान कर टोरवा एपा, एपेर, हनोक, अबीदा अउ एल्दा हुइन, हइ सगलू टोरवा अब्राहम अउ कतूरा लग पइदा हुइन। <verse eid="GEN 25:4" /><verse number="5" style="v" sid="GEN 25:5" />अब्राहम अपन सब कुछ इसहाक के सउप देथै। <verse eid="GEN 25:5" /><verse number="6" style="v" sid="GEN 25:6" />पय अपन रखेल डउकी लग पइदा टोरवा के सिबाय भेंट दइके अपन जियत हे अपन टोरवा इसहाक लग दुरिहां, पूरब दिसा छो पठोय देथै।<verse eid="GEN 25:6" /></para>
  <para style="s">अब्राहम कर मिरतू</para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 25:7" />अब्राहम एक सव पचहत्तर साल तक जिन्दा रहिस। <verse eid="GEN 25:7" /><verse number="8" style="v" sid="GEN 25:8" />अब्राहम धीरे-धीरे कमजोर होत गइस, अउ ऊ पूर जीवन जिइस अउ मर गइस, ऊ लम्बा जीवन जिइस, अउ अपन पुरखन के संग गाडे गइस। <verse eid="GEN 25:8" /><verse number="9" style="v" sid="GEN 25:9" />ओखर टोरवा इसहाक अउ इस्माइल उके मकपेला के गुफा हे गाडिन, हइ गुफा हित्ती सोहर के टोरवा एप्रोन के खेत हे हबै, हइ मम्रे के पूरब हे रथै। <verse eid="GEN 25:9" /><verse number="10" style="v" sid="GEN 25:10" />हइ उहै गुफा हबै, जेही अब्राहम हित्ती मनसेन लग खरीदे रथै, अब्राहम के ओखर डउकी सारा के संग गाडे गइस। <verse eid="GEN 25:10" /><verse number="11" style="v" sid="GEN 25:11" />अब्राहम के मरै के बाद भगवान इसहाक के आसीस दइस अउ इसहाक लहैरोई नाम के कुंवा के लिघ्घो रहै लगिस। <verse eid="GEN 25:11" /><verse number="12" style="v" sid="GEN 25:12" />अब्राहम कर टोरवा इस्माइल जउन सारा के मिस्री हरवाहिन हाजिरा लग पइदा होय रथै, ओखर हइ खानदान हबै। <verse eid="GEN 25:12" /><verse number="13" style="v" sid="GEN 25:13" />इस्माइल कर टोरवन के नाम पहिला टोरवा कर नाम नबायोत रथै, तब ओखर बाद केदार, अदबेल, मिबसाम हुइस। <verse eid="GEN 25:13" /><verse number="14" style="v" sid="GEN 25:14" />मिस्मा, दूमा, मस्सा, <verse eid="GEN 25:14" /><verse number="15" style="v" sid="GEN 25:15" />हदद, तेमा, यतूर, नापीस अउ केदमा हुइन। <verse eid="GEN 25:15" /><verse number="16" style="v" sid="GEN 25:16" />हइ इस्माइल कर टोरवन के नाम रथै, इनखर नाम के जसना इनखर गांव अउ गढ के नाम हुइस, इहै बारह अपन-अपन इलाका के मुखिया बनिन। <verse eid="GEN 25:16" /><verse number="17" style="v" sid="GEN 25:17" />जब इस्माइल एक सव तीस साल के हुइस, तब ऊ आखरी सांस लइके मर गइस, ऊ अपन पूरवजन के संग माटी हे मिल गइस। <verse eid="GEN 25:17" /><verse number="18" style="v" sid="GEN 25:18" />इस्माइल के मनसे हवीला लग सूर तक, जउन मिस्र देस के पूरब हे अउ अस्सूर के रास्ता हे हबै, उहां उन रहत रहिन, हर मनसे अपन भाई-बेहन के बिरोध बसे हर रथै।<verse eid="GEN 25:18" /></para>
  <para style="s">याकूब अउ इसहाक के पइदा</para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 25:19" />हइ अब्राहम कर टोरवा इसहाक के परवार के किस्सा हबै, अब्राहम इसहाक के पइदा करे रथै। <verse eid="GEN 25:19" /><verse number="20" style="v" sid="GEN 25:20" />जब इसहाक चालीस साल के हुइस ता ऊ रिबका लग काज हुइस, रिबका पद्दनराम के रहै बाले रथै, ऊ अरामी बतूएल के टोरिया रथै, अउ लाबान के बेहन रथै। <verse eid="GEN 25:20" /><verse number="21" style="v" sid="GEN 25:21" />इसहाक के डउकी के लरका नेहको होथै, इहैनिता इसहाक भगवान लग बिनती करिस, अउ भगवान इसहाक के बिनती के सुन लेथै तब रिबका लादा हे रथै। <verse eid="GEN 25:21" /><verse number="22" style="v" sid="GEN 25:22" />जब रिबका लादा हे हुइस तब ऊ अपन लरका लग बोहत परेसान हुइस, लरका ओखर लादा हे आपस हे लडथै, रिबका भगवान लग बिनती करिस अउ कथै, “मोर संग असना काखे होथै।” <verse eid="GEN 25:22" /><verse number="23" style="v" sid="GEN 25:23" />भगवान ओखर लग कथै, “तोर लादा हे दुइठे देस हबै, अउ दुइ परवार के राजा तोर लग पइदा हुइहिन<note caller="+" style="f"><char style="fr" closed="false">25:23 </char><char style="ft" closed="false">होंगे</char></note> अउ ऊ दुइ जात हे बट जइहिन, अक्ठी टोरवा दूसर टोरवा लग बलवान होही, बडा टोरवा नान टोरवा के सेबा करही।” <verse eid="GEN 25:23" /><verse number="24" style="v" sid="GEN 25:24" />अउ जब टेम पूरा हुइस ता रिबका जुडवा लरका के पइदा करिस। <verse eid="GEN 25:24" /><verse number="25" style="v" sid="GEN 25:25" />पहिला लरका लाल रथै, ओखर सगलू सरीर कम्बल के जसना रोमा रथै, इहैनिता ओखर नाम एसाव धरिन। <verse eid="GEN 25:25" /><verse number="26" style="v" sid="GEN 25:26" />जब दूसरा टोरवा पइदा हुइस, ऊ एसाव के एडी के पकडे रथै, इहैनिता ऊ लरका के नाम याकूब धरथै, इसहाक के उमर ऊ टेम साठ साल रथै, जब याकूब अउ एसाव के पइदा होय रथै। <verse eid="GEN 25:26" /><verse number="27" style="v" sid="GEN 25:27" />जब दोनो लरका बडा हुइस तब एसाव पतेरा हे रहैबाले चतुर सिकारी बनिस, पय याकूब सीधा साधा मनसे रथै, ऊ अपन तम्बू हे रथै।<verse eid="GEN 25:27" /></para>
  <para style="s">एसाव दवारा जेठ टोरवा होय के हक के बेचिस</para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 25:28" />इसहाक एसाव लग माया करथै, काखे ऊ एसाव सिकार के मांस खाय करथै, रिबका नान टोरवा याकूब लग माया करथै। <verse eid="GEN 25:28" /><verse number="29" style="v" sid="GEN 25:29" />एक बेर एसाव पतेरा लग लउटिस, ऊ बोहत थके रथै, अउ भुखाय रथै, अउ याकूब कुछ दार के पकाउत रहै। <verse eid="GEN 25:29" /><verse number="30" style="v" sid="GEN 25:30" />इहैनिता एसाव याकूब लग कथै, “मै भूंख लग कमजोर होउथो, तै ऊ लाल दार मसे कुछु खाये के दे।” इहै कारन हबै कि मनसे उके एदोम कथै। <verse eid="GEN 25:30" /><verse number="31" style="v" sid="GEN 25:31" />पय याकूब कथै, “तै पहिले लरका होमै का हक<note caller="+" style="f"><char style="fr" closed="false">25:31 </char><char style="ft" closed="false">पहिलउठा, मतलब अधिकार बाफ के मरै के बाद बाफ के बोहत लग बोहत धन डेरा पहिले टोरवा के मिलथै, बडा टोरवा परवार कर नबा हकदार होथै।</char></note> मोके आज देय के होही।” <verse eid="GEN 25:31" /><verse number="32" style="v" sid="GEN 25:32" />एसाव कथै, “मै भूंख लग मरे जथो, हइ हक मोर निता काहिन फायदा होही?” <verse eid="GEN 25:32" /><verse number="33" style="v" sid="GEN 25:33" />याकूब कथै, पहिले मोर लग किरिया खा, अउ एसाव ओखर लग किरिया खाइस, अउ ऊ अपन बडा भाई होय के हक खोय देथै। <verse eid="GEN 25:33" /><verse number="34" style="v" sid="GEN 25:34" />एखर बाद याकूब एसाव के रोटी अउ चूर हर मसरी कर दार देथै, ऊ खाइस पीइस अउ उठके कढ गइस, हइ मेर एसाव हइ दिखाइस कि ऊ पहिले टोरवा होमै के अपन हक के परवाह नेहको करिस।<verse eid="GEN 25:34" /></para>
  <chapter eid="GEN 25" />
  <chapter number="26" style="c" sid="GEN 26" />
  <para style="s">इसहाक गरार हे निवास</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 26:1" />एक बेर अकाल पडिस, हइ अकाल ओसना रथै जसना अब्राहम के टेम हे पडे रथै, इहैनिता इसहाक गरार सहर हे पलिस्तियन के राजा अबीमेलेक राजा के लिघ्घो गइस। <verse eid="GEN 26:1" /><verse number="2" style="v" sid="GEN 26:2" />भगवान इसहाक लग बात करिस, भगवान इसहाक लग हइ बात करिस, “मिस्र देस छो झइ जा, उहै देस हे रह जेहमा रहै के आदेस तोके मै दय हव। <verse eid="GEN 26:2" /><verse number="3" style="v" sid="GEN 26:3" />उहै देस हे रह अउ मै तोर संग रइहों, मै तोके आसीस दइहों, मै तोके अउ तोर परवार के हइ सगलू परदेस दइहों, मै उहै करिहों जउन मै तोर बाफ अब्राहम के बचन दय हव। <verse eid="GEN 26:3" /><verse number="4" style="v" sid="GEN 26:4" />मै तोर परवार के बादर के तराइया के मेर बोहत बढइहों अउ मै सगलू परदेस तोर परवार के दइहों, भुंइ के सगलू देस तोर परवार के कारन मोर आसीस पइहिन। <verse eid="GEN 26:4" /><verse number="5" style="v" sid="GEN 26:5" />मै इहैनिता करिहों कि तोर बाफ अब्राहम मोर बात के माने हबै, अउ मै जउन कुछु कहे हव, ऊ करे हबै, अब्राहम मोर आदेसन नियम के माने हबै।” <verse eid="GEN 26:5" /><verse number="6" style="v" sid="GEN 26:6" />इसहाक रुकिस अउ गरार सहर हे रहै लगिस। <verse eid="GEN 26:6" /><verse number="7" style="v" sid="GEN 26:7" />इसहाक के डउकी रिबका बोहत सुन्दर रथै, ऊ जिघा के मनसेन इसहाक लग रिबका के बारे हे पूंछथै, इसहाक कथै, “हइ मोर बेहन आय।” इसहाक मोर डउकी कहे लग डरथै, काखे उहां के मनसे ओखर डउकी के पामै के निता ओही मार डरहिन।<note caller="+" style="x"><char style="xo" closed="false">26:7 </char><char style="xt" closed="false"><ref loc="GEN 12:13">उत्पति 12:13</ref>; <ref loc="GEN 20:2">20:2</ref></char></note> <verse eid="GEN 26:7" /><verse number="8" style="v" sid="GEN 26:8" />जब इसहाक के उहां रहत बोहत टेम बीत गय, तब अक रोज पलिस्तियन के राजा अबीमेलेक झकिया लग देखथै, कि इसहाक अपन डउकी रिबका के संग छेडखानी करथै। <verse eid="GEN 26:8" /><verse number="9" style="v" sid="GEN 26:9" />अबीमेलेक राजा इसहाक के बुलाथै अउ कथै, “हइ टोरिया तोर डउकी आय, तै हमर लग काखे कहे कि हइ मोर बेहन आय।” इसहाक ओखर लग कथै, “मै डरत रहों कि तै ओही पामै के निता मोके मार डरहे।” <verse eid="GEN 26:9" /><verse number="10" style="v" sid="GEN 26:10" />अबीमेलेक राजा कथै, “तै हमर संग बुरा करे हबस, हमर मनसे कउनो डउका तोर डउकी के संग सोय सकथै, तब ऊ बडा पाप के दोसी होतै।” <verse eid="GEN 26:10" /><verse number="11" style="v" sid="GEN 26:11" />इहैनिता अबीमेलेक राजा सगलू मनसे के चेतन्त करथै, “हइ डउकी के कउ बुरा करथै, अगर कउ इनके चोंट पहुंचाथै, ता ऊ मनसे के जान लग मार दय जही।” <verse eid="GEN 26:11" /><verse number="12" style="v" sid="GEN 26:12" />इसहाक ऊ देस हे जमीन हे खेती करिस अउ उहै साल सव गुना दाना पइस, भगवान उके आसीस दइस। <verse eid="GEN 26:12" /><verse number="13" style="v" sid="GEN 26:13" />इसहाक धनी हुइ गइस, ऊ जादा लग जादा धन इकठ्ठा करिस जब तक ऊ धनी नेहको हुइ गइस। <verse eid="GEN 26:13" /><verse number="14" style="v" sid="GEN 26:14" />ओखर लिघ्घो गेडरा<note caller="+" style="f"><char style="fr" closed="false">26:14 </char><char style="ft" closed="false">भेंड</char></note> छेडी, गोरू अउ बोहत सेबक-सेबिका रथै, पय पलिस्ती मनसे ओखर लग इसाय लागथै। <verse eid="GEN 26:14" /><verse number="15" style="v" sid="GEN 26:15" />जउन कुंवा के इसहाक के बाफ अब्राहम के सेबक ओखर जियत हे खोदे रथै, ओही पलिस्ती मनसे माटी लग पाट देथै। <verse eid="GEN 26:15" /><verse number="16" style="v" sid="GEN 26:16" />अबीमेलेक राजा इसहाक लग कथै, तै हमर लिघ्घो लग कढ जा, काखे तै हमर लग बोहत सक्तिसाली बन गय हबस। <verse eid="GEN 26:16" /><verse number="17" style="v" sid="GEN 26:17" />इहैनिता इसहाक ऊ जिघा के छांडिस अउ गरार के नान हस नदिया के लिघ्घो जाय के तम्बू खडा करके उहै रहै लगिस। <verse eid="GEN 26:17" /><verse number="18" style="v" sid="GEN 26:18" />जउन कुंवा ओखर बाफ अब्राहम के जियत हे खोदे गय रथै, उके इसहाक फेरै खोदिस, काखे पलिस्ती मनसे अब्राहम के मिरतू के बाद उन कुंवन के माटी लग पाट दय रथै, इसहाक उन कुंवन के उहै नाम धरथै जउन ओखर बाफ धरे रहै। <verse eid="GEN 26:18" /><verse number="19" style="v" sid="GEN 26:19" />जब इसहाक के हरवाह नान हस नदिया के लिघ्घो कुंवा खोदिन, ता ऊ कुंवा लग अक्ठी पानी के झिरना मिलथै। <verse eid="GEN 26:19" /><verse number="20" style="v" sid="GEN 26:20" />तब गरार के बरेदी इसहाक के बरेदी लग लडै लग जथै, उन कथै, हइ पानी हमर हबै। फेर इसहाक ऊ कुंवा के नाम एसेक धरिन, काखे उन इसहाक लग झगडा करे रथै। <verse eid="GEN 26:20" /><verse number="21" style="v" sid="GEN 26:21" />इसहाक के हरवाह दूसर कुंवा खोदथै, उहां के मनसे ऊ कुंवा के निता झगडा करिन, इहैनिता इसहाक ऊ कुंवा के नाम सितरा धरिस। <verse eid="GEN 26:21" /><verse number="22" style="v" sid="GEN 26:22" />इसहाक उहां लग हटिस अउ दूसर कुंवा खोदिस, ऊ कुंवा के निता झगडा करै के निता कउनो मनसे नेहको आइन, इहैनिता इसहाक ऊ कुंवा के नाम रहोबोत धरिस, ऊ कथै, “भगवान इहां हमके जिघा दय हबै, हम इहां बढब अउ इहै जमीन हे सफल हुइबे।” <verse eid="GEN 26:22" /><verse number="23" style="v" sid="GEN 26:23" />ऊ जिघा लग इसहाक बेरसेबा छो गइस। <verse eid="GEN 26:23" /><verse number="24" style="v" sid="GEN 26:24" />भगवान उहै रात इसहाक लग कथै, “मै तोर बाफ अब्राहम के भगवान यहों<note caller="+" style="f"><char style="fr" closed="false">26:24 </char><char style="ft" closed="false">हूं</char></note>, झइ डेरा, मै तोर संग हव, अउ मै तोके आसीस दइहों, मै तोर परवार के बडा बनइहों, मै अपन हरवाह अब्राहम के कारन हइ करिहों।” <verse eid="GEN 26:24" /><verse number="25" style="v" sid="GEN 26:25" />इहैनिता इसहाक ऊ जिघा हे भगवान लग पराथना करै के निता उहां अक्ठी बेदी बनाइस, इसहाक उहां अपन तम्बू गाडिस, ओखर हरवाह उहां अक्ठी कुंवा के खोदिन।<verse eid="GEN 26:25" /></para>
  <para style="s">इसहाक अउ अबीमेलेक</para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 26:26" />अबीमेलेक राजा गरार लग इसहाक के देखै के निता आइस, अबीमेलेक राजा अपन संग मन्तरी अहुज्जत अउ सुपाही पीकोल के लाइस।<note caller="+" style="x"><char style="xo" closed="false">26:26 </char><char style="xt" closed="false"><ref loc="GEN 21:22">उत्पति 21:22</ref></char></note> <verse eid="GEN 26:26" /><verse number="27" style="v" sid="GEN 26:27" />इसहाक उनखर लग कथै, तुम मोर लिघ्घो काखे आय हबा? तै तो मोके बैरी मानथस, तै मोके अपन देस लग निकार दय रहस। <verse eid="GEN 26:27" /><verse number="28" style="v" sid="GEN 26:28" />उन जबाब देथै, “हम देखे हबन कि भगवान तोर संग हबै, हम चाहथन कि तोर संग टीमा बंधी, अउ तै हमके अक्ठी बचन दे। <verse eid="GEN 26:28" /><verse number="29" style="v" sid="GEN 26:29" />हम तोके चोंट नेहको पहुंचाय हबन, हम अब तोके हइ बचन दे कि तै हमके चोंट नेहको पहुंचइहे, हम तोके सान्ति लग पठोय रहन, अब साफ हबै कि भगवान तोके आसीस दय हबै।” <verse eid="GEN 26:29" /><verse number="30" style="v" sid="GEN 26:30" />इहैनिता इसहाक उनखर निता खाना बनवाय रथै, अउ सगलू झन खाइन पियन। <verse eid="GEN 26:30" /><verse number="31" style="v" sid="GEN 26:31" />दूसर रोज सुबेन्ने उठिन, उन आपस हे बचन दइन अउ किरिया खाइन, तब इसहाक उनके सान्ति लग बिदा करिस, अउ उन खुसी लग ओखर लिघ्घो लग कढ जथै। <verse eid="GEN 26:31" /><verse number="32" style="v" sid="GEN 26:32" />उहै रोज इसहाक के हरवाह आयके अक्ठी कुंवा के बारे हे बताइस जेही उन खोदे रथै, उन इसहाक लग कथै, हमके पानी मिल गय हबै। <verse eid="GEN 26:32" /><verse number="33" style="v" sid="GEN 26:33" />इहैनिता इसहाक ऊ कुंवा के नाम सिबा धरिस, अउ ऊ सहर अबहुंन बेरसेबा कहाथै।<verse eid="GEN 26:33" /></para>
  <para style="s">एसाव के बिदेसी डउकी</para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 26:34" />जब एसाव चालीस साल के हुइस, ऊ हित्ती डउकी लग काज करिस, अक्ठी बैरी कर टोरिया यहूदीत रथै, दूसर एलोन कर टोरिया बासमत रथै। <verse eid="GEN 26:34" /><verse number="35" style="v" sid="GEN 26:35" />दोनो पुतउ<note caller="+" style="f"><char style="fr" closed="false">26:35 </char><char style="ft" closed="false">बहु</char></note> के कारन इसहाक अउ रिबका के मन के दुखी होथै।<verse eid="GEN 26:35" /></para>
  <chapter eid="GEN 26" />
  <chapter number="27" style="c" sid="GEN 27" />
  <para style="s">याकूब इसहाक लग आसिरवाद पाइस</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 27:1" />जब इसहाक डोकरा हुइ गइस ता ओखर आंखी अंधिरियाय<note caller="+" style="f"><char style="fr" closed="false">27:1 </char><char style="ft" closed="false">अंधा</char></note> जथै, जेखर लग इसहाक साफ-साफ नेहको देख सकथै, अक रोज ऊ अपन बडा टोरवा एसाव के बुलाथै, इसहाक कथै, टोरवा, ऊ कथै, “हां बाफ।” <verse eid="GEN 27:1" /><verse number="2" style="v" sid="GEN 27:2" />इसहाक कथै, “देख, मै डोकरा हुइ गय हव, हुइ सकथै कि मै हरबी मर जांव। <verse eid="GEN 27:2" /><verse number="3" style="v" sid="GEN 27:3" />अब तै अपन धनही बिट्टा लइके पतेरा छो जा, मोर निता खाय के निता सिकार मार के ला। <verse eid="GEN 27:3" /><verse number="4" style="v" sid="GEN 27:4" />मोर निता खास खाना बना, जउन मोके सब खाना लग जादा पसंद हबै, उके मोर लिघ्घो ला, अउ मै इके खइहों, तब मै मरै लग पहिले तोके आसीस दइहों।” <verse eid="GEN 27:4" /><verse number="5" style="v" sid="GEN 27:5" />जब एसाव सिकार करै के निता कढ गइस, रिबका ऊ बात के सुन लेथै, जउन इसहाक अपन टोरवा एसाव लग कहे रथै। <verse eid="GEN 27:5" /><verse number="6" style="v" sid="GEN 27:6" />रिबका अपन टोरवा याकूब लग कथै, “सुन, मै तोर बाफ के तोर भाई एसाव लग बात करत सुने हव। <verse eid="GEN 27:6" /><verse number="7" style="v" sid="GEN 27:7" />तोर बाफ कहे हबै, मोर खाय के निता सिकार मार के ला, अउ मोर निता खाना बना अउ मै उके खइहों, तब मै मरै लग पहिले तोके भगवान कर आगू आसीस दइहों। <verse eid="GEN 27:7" /><verse number="8" style="v" sid="GEN 27:8" />अब, मोर टोरवा, मोर बात सुन, जसना मै तोर लग कथो, ओसनेन कर। <verse eid="GEN 27:8" /><verse number="9" style="v" sid="GEN 27:9" />तै छेडिन के गोहदा हे जा, अउ दुइठे छेडी<note caller="+" style="f"><char style="fr" closed="false">27:9 </char><char style="ft" closed="false">बकरी</char></note> लइके आ, मै उके ओसना बनइहों, जसना तोर बाफ के पसंद हबै। <verse eid="GEN 27:9" /><verse number="10" style="v" sid="GEN 27:10" />तब तै ऊ खाना के अपन बाफ के लिघ्घो लइ जइहे अउ ऊ मरै लग पहिले तोके आसीस देही।” <verse eid="GEN 27:10" /><verse number="11" style="v" sid="GEN 27:11" />पय याकूब अपन दाय रिबका लग कथै, “मोर भाई रोमादार एसाव हबै अउ मै ओखर मेर रोमादार नेहको यहों। <verse eid="GEN 27:11" /><verse number="12" style="v" sid="GEN 27:12" />अगर मोर बाफ मोके छिही, ता जान जही कि मै एसाव नेहको यहों, तब ऊ मोके आसीस नेहको देही, ऊ सराप दइ काखे मै ओखर संग चाल‍ चलै के परयास करे हव।” <verse eid="GEN 27:12" /><verse number="13" style="v" sid="GEN 27:13" />हइ बात हे ओखर दाय कथै, “अगर कउनो परेसानी होही ता मै अपन उप्पर सराप लइ लइहों, जउन मै कथो, ऊ कर, अउ जा मोर निता छेडी लइके आ।” <verse eid="GEN 27:13" /><verse number="14" style="v" sid="GEN 27:14" />तब याकूब बाहिर गइस अउ ऊ दुइठे छेडी के पकडिस अउ अपन दाय के लिघ्घो लइ आनिस, ओखर दाय इसहाक के पसंद के जसना खाना बनाइस। <verse eid="GEN 27:14" /><verse number="15" style="v" sid="GEN 27:15" />तब रिबका अपन पहिले टोरवा एसाव के सुन्दर कपडा जउन ओखर लिघ्घो रथै, कपडा के लइके अपन नान टोरवा याकूब के पहिनाय देथै। <verse eid="GEN 27:15" /><verse number="16" style="v" sid="GEN 27:16" />रिबका छेडी के खलरी के लइस अउ याकूब के हाथ हे अउ नटेरी<note caller="+" style="f"><char style="fr" closed="false">27:16 </char><char style="ft" closed="false">गला</char></note> हे बांध देथै। <verse eid="GEN 27:16" /><verse number="17" style="v" sid="GEN 27:17" />तब रिबका अपन पकाय हर खाना के उठाइस अउ उके याकूब के दइ दइस। <verse eid="GEN 27:17" /><verse number="18" style="v" sid="GEN 27:18" />याकूब अपन बाफ के लिघ्घो गइस, अउ कथै, “बाफ।” अउ ओखर बाफ ओखर लग पूंछथै, “हां टोरवा, तै कोन हबस?” <verse eid="GEN 27:18" /><verse number="19" style="v" sid="GEN 27:19" />याकूब कथै, “मै तोर बडा टोरवा एसाव यहों, तै जउन कहे रथस, ऊ मै कर दय हव, इहैनिता उठ अउ बइठ, मोर सिकार करे हर खाना खा, तब तै मोके आसीस दइ सकस।” <verse eid="GEN 27:19" /><verse number="20" style="v" sid="GEN 27:20" />इसहाक अपन टोरवा लग कथै, “तै एतका हरबी सिकार कइसन करे हबस?” याकूब जबाब देथै, “काखे तोर भगवान मोके हरबी सिकार के दइ दइस।” <verse eid="GEN 27:20" /><verse number="21" style="v" sid="GEN 27:21" />तब इसहाक याकूब लग कथै, “मोर टोरवा मोर लिघ्घो आ जेखर लग मै तोके छि सको, अगर मै तोके छि सकिहों ता मै हइ जान जइहों कि तै सही हे मोर टोरवा एसाव हबस।” <verse eid="GEN 27:21" /><verse number="22" style="v" sid="GEN 27:22" />याकूब अपन बाफ के लिघ्घो गइस, इसहाक उके छिथै अउ कथै, “तोर आरो याकूब के आरो जसना हबै, पय तोर बांह एसाव के रोमादार बांह के जसना हबै।” <verse eid="GEN 27:22" /><verse number="23" style="v" sid="GEN 27:23" />इसहाक हइ नेहको जान पाइस कि हइ याकूब हबै, काखे ओखर बांह एसाव के बांह के जसना हबै, इहैनिता इसहाक याकूब के आसीस देथै। <verse eid="GEN 27:23" /><verse number="24" style="v" sid="GEN 27:24" />इसहाक कथै, “का सही हे तै मोर टोरवा एसाव हबस?” याकूब कथै, “हां, मै एसाव यहों।” <verse eid="GEN 27:24" /><verse number="25" style="v" sid="GEN 27:25" />इसहाक कथै, ता मोके खाना पोरस, मै अपन टोरवा के सिकार के खइहों जेखर लग मै अपन आतमा लग तोके आसीस दइहों, ऊ खाना पोरसिस, इसहाक खाना खाइस, ऊ ओखर निता रस लइस, अउ इसहाक उहो के पीइस। <verse eid="GEN 27:25" /><verse number="26" style="v" sid="GEN 27:26" />तब इसहाक ओखर लग कथै, “मोर टोरवा, मोर लिघ्घो आ, अउ मोके चूम ले।” <verse eid="GEN 27:26" /><verse number="27" style="v" sid="GEN 27:27" />इहैनिता याकूब अपन बाफ के लिघ्घो गइस, अउ उके चूमिस, इसहाक एसाव के कपडा के गन्ध पइस अउ ओही आसीस दइस, अउ कथै, देख, मोर टोरवा के गन्ध आय, हइ ऊ खेतवा के गन्ध के जसना हबै जेही भगवान आसीस दय हबै।<note caller="+" style="x"><char style="xo" closed="false">27:27 </char><char style="xt" closed="false"><ref loc="HEB 11:20">इब्रानिन 11:20</ref></char></note> <verse eid="GEN 27:27" /><verse number="28" style="v" sid="GEN 27:28" />भगवान तोके बोहत बरिसा दे, जेखर तोके बोहत दाना अउ अंगूर फसल मिल सके। <verse eid="GEN 27:28" /><verse number="29" style="v" sid="GEN 27:29" />राज-राज के मनसेन तोर वस हे होय, अउ देस-देस के मनसेन तोर आगू झुकै, “तै अपन भाई के मालिक बनिहे, तोर दाय के टोरवा तोर आगू झुकै, अउ तोर आदेस मनहिन जउन कउ तोके सराप दइ, ऊ खुदय सरापित हुइ जइ, अउ जउन कउन तोके आसीस दइ, ऊ आसीस पइ।<note caller="+" style="x"><char style="xo" closed="false">27:29 </char><char style="xt" closed="false"><ref loc="GEN 12:3">उत्पति 12:3</ref></char></note>”<verse eid="GEN 27:29" /></para>
  <para style="s">एसाव अपन बाफ लग आसीस मांगथै</para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 27:30" />इसहाक याकूब के आसीस दइ चुकथै, तब याकूब अपन बाफ इसहाक के लिघ्घो लग बाहिर निकडिस कि ओखर भाई एसाव सिकार लग लउटिस। <verse eid="GEN 27:30" /><verse number="31" style="v" sid="GEN 27:31" />एसाव अपन बाफ के पसंद के खाना बनाइस, ऊ अपन बाफ के लिघ्घो खाना लइके गइस, ऊ अपन बाफ लग कथै, “बाफ, उठ अउ खाना के खा जउन तोर टोरवा तोर निता मारे हबै, तब तै मोके आसीस दइ सकथस।” <verse eid="GEN 27:31" /><verse number="32" style="v" sid="GEN 27:32" />पय इसहाक ओखर लग कथै, “तै कोन हबस?” ऊ जबाब देथै, “मै तोर पहिले बाले टोरवा एसाव यहों।” <verse eid="GEN 27:32" /><verse number="33" style="v" sid="GEN 27:33" />तब इसहाक थरथरात कांपै लग जथै, इसहाक ओखर लग पूंछथै, तब ऊ कोन रथै जउन मोर लिघ्घो सिकार लाय रथै? मै तोर आय लग पहिले ओखर पोरस हर खाना खायों, अउ उके आसीस दयों, अब उहै आसीस ओखर उप्पर बने रही। <verse eid="GEN 27:33" /><verse number="34" style="v" sid="GEN 27:34" />जब एसाव अपन बाफ के हइ बात के सुनिस, तब ओखर मन बोहत गुस्सा लग भर जथै, अउ ऊ बोहत जोर लग चिल्लाथै, “ऊ अपन बाफ लग कथै, तब महुं के आसीस दे।” <verse eid="GEN 27:34" /><verse number="35" style="v" sid="GEN 27:35" />इसहाक ओखर लग कथै, “तोर भाई मोके नरे हबै, ऊ आइस अउ तोर आसीस लइके कढ गइस।” <verse eid="GEN 27:35" /><verse number="36" style="v" sid="GEN 27:36" />एसाव कथै, “ओखर नाम याकूब (याकूब का मतलब चालबाज) सही धरे हबा, ऊ मोके दुइ बेर नरे हबै, पहिले मोर बडा होय का हक लइ लय हबै, अउ अब मोर आसीसो लइ लय हबै, एसाव पूंछथै, का तै मोर निता कउनो आसीस बचाय के नेहको धरे हबस?” <verse eid="GEN 27:36" /><verse number="37" style="v" sid="GEN 27:37" />इसहाक एसाव के जबाब देथै, “नेहको, अब बहोत देरी हुइ गय हबै, मै याकूब के तोर उप्पर मालिक बनाय हव, मै इहो कहि दय हव कि सगलू भाई ओखर हरवाह हुइहिन, मै दाना अउ अंगूर के फसल के आसीस दय हव, टोरवा तोके दे के निता कुछु नेहको बचे हबै।” <verse eid="GEN 27:37" /><verse number="38" style="v" sid="GEN 27:38" />एसाव अपन बाफ लग कथै, “का तोर लिघ्घो एक्कोठे आसीस नेहको हबै? बाफ मोके आसीस दे, एसाव सिसक-सिसक के रोमै लगिस।<note caller="+" style="x"><char style="xo" closed="false">27:38 </char><char style="xt" closed="false"><ref loc="HEB 12:17">इब्रानिन 12:17</ref></char></note>” <verse eid="GEN 27:38" /><verse number="39" style="v" sid="GEN 27:39" />तब इसहाक ओखर लग कथै, तै निक्खा जमीन हे नेहको रइहे, तोर लिघ्घो बोहत दाना नेहको होही।<note caller="+" style="x"><char style="xo" closed="false">27:39 </char><char style="xt" closed="false"><ref loc="HEB 11:20">इब्रानिन 11:20</ref></char></note> <verse eid="GEN 27:39" /><verse number="40" style="v" sid="GEN 27:40" />तोके जीये के निता बोहत मेहनत करै का होही, अउ तै अपन भाई के अधीन रइहे, पय तै मुकति पामै के निता लडिहे, अउ ओखर कब्जा लग मुकति पाय जइहे।<note caller="+" style="x"><char style="xo" closed="false">27:40 </char><char style="xt" closed="false"><ref loc="HEB 11:20">इब्रानिन 11:20</ref></char></note> <verse eid="GEN 27:40" /><verse number="41" style="v" sid="GEN 27:41" />एखर बाद हइ आसीस के कारन एसाव याकूब लग चिडे लागथै, ऊ मन हे सोच लेथै, “मोर बाफ हरबी मरै बाले हबै, अउ मै ओखर दसगातर मनाहूं, पय ओखर बाद मै, याकूब के मार डलिहो।” <verse eid="GEN 27:41" /><verse number="42" style="v" sid="GEN 27:42" />रिबका एसाव के बात सुनथै, कि याकूब के मारै चाहथै, ऊ याकूब के बुलाइस अउ ओखर लग कथै, “सुन, तोर भाई एसाव तोके मारै के जुगाड बनाय हबै। <verse eid="GEN 27:42" /><verse number="43" style="v" sid="GEN 27:43" />इहैनिता मोर टोरवा जउन मै कथो ऊ बात के सुन, तै अपन मामा लाबान के घर हारान सहर छो कढ जा। <verse eid="GEN 27:43" /><verse number="44" style="v" sid="GEN 27:44" />ओखर लिघ्घो कुछ रोज रइहे, जब तक एसाव के गुस्सा सान्त ना हुइ जाय, उहै छो रइहे। <verse eid="GEN 27:44" /><verse number="45" style="v" sid="GEN 27:45" />जब तोर भाई के गुस्सा ठंडा हुइ जइ, अउ जउन तै ओखर संग करे हबस, उके ऊ भूल जही तब मै हरवाह के बुलाय लेहूं, मै एक्कै रोज दोनो टोरवा के खोमै नेहको चाहथो।” <verse eid="GEN 27:45" /><verse number="46" style="v" sid="GEN 27:46" />तब रिबका इसहाक लग कथै, “तोर टोरवा एसाव हित्ती जात टोरिया लग काज कर लय हबै, मै हइ टोरियन लग परेसान हव काखे हइ हमर मनसे समे नेहको हबै, अगर याकूब इनै टोरियन मसे काज करथै, ता मै मर जइहों।”<verse eid="GEN 27:46" /></para>
  <chapter eid="GEN 27" />
  <chapter number="28" style="c" sid="GEN 28" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 28:1" />इसहाक याकूब के बुलाइस, इसहाक उके आसीस दइके कथै, तै कनान देस के टोरियन मसे कउनो के संग काज झइ करबे। <verse eid="GEN 28:1" /><verse number="2" style="v" sid="GEN 28:2" />इहैनिता हइ जिघा के छांड अउ पद्दनराम हे अपन नाना बतूएल के इलाका छो जा, उछो तोर मामा लाबान रथै, ओखर कउनो अक्ठी टोरिया लग काज कर। <verse eid="GEN 28:2" /><verse number="3" style="v" sid="GEN 28:3" />मै सक्तिमान भगवान लग बिनती करथो कि ऊ तोके आसीस दे, अउ तोर बोहत टोरवा पइदा होय, मै बिनती करथो कि तै बोहत जात के बाफ बन। <verse eid="GEN 28:3" /><verse number="4" style="v" sid="GEN 28:4" />मै बिनती करथो कि जउन मेर लग भगवान अब्राहम के आसीस दय रहै, उहै मेर तहुं के आसीस दे, मै बिनती करथो कि भगवान तोके अब्राहम के आसीस दे, जेखर लग तै जिहां रथस ऊ देस हे तोर अधिकार होय, जेही भगवान अब्राहम के दय रथै।<note caller="+" style="x"><char style="xo" closed="false">28:4 </char><char style="xt" closed="false"><ref loc="GEN 17:4-8">उत्पति 17:4-8</ref></char></note> <verse eid="GEN 28:4" /><verse number="5" style="v" sid="GEN 28:5" />हइ मेर लग इसहाक याकूब के पठोय देथै, ऊ पद्दनराम इलाका हे मामा लाबान के लिघ्घो कढ गइस, अरामी बतूएल लाबान अउ रिबका के बाफ रथै, अउ रिबका याकूब अउ एसाव के दाय रथै।<verse eid="GEN 28:5" /></para>
  <para style="s">एसाव कर अक्ठी अउ काज</para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 28:6" />एसाव के पता चलथै कि इसहाक याकूब के आसीस दइके पद्दनराम इलाका छो पठोय हबै कि ऊ उंहा के टोरिया लग काज करै, इसहाक उके आसीस देत इहो आदेस दय हबै, “कि तै कनान देस के टोरियन लग कउनो के संग काज झइ करबे।” <verse eid="GEN 28:6" /><verse number="7" style="v" sid="GEN 28:7" />एसाव समझिस कि याकूब अपन बाफ-दाय के बात सुनके पद्दनराम इलाका छो कढ गय हबै। <verse eid="GEN 28:7" /><verse number="8" style="v" sid="GEN 28:8" />एसाव इहो समझिस कि ओखर बाफ इसहाक नेहको चाहथै कि ओखर टोरवा कनानी टोरिया लग काज करै। <verse eid="GEN 28:8" /><verse number="9" style="v" sid="GEN 28:9" />एसाव के दुइठे डउकी पहिलेन लग रथै, पय ऊ इस्माइल के टोरिया महलत लग काज करिस, इस्माइल अब्राहम के टोरवा रथै, महलत नबायोत के बेहन रथै।<verse eid="GEN 28:9" /></para>
  <para style="s">बेतेल हे याकूब के सपना</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 28:10" />याकूब बेरसेबा के छांड के अउ ऊ हारान सहर छो कढ गइस। <verse eid="GEN 28:10" /><verse number="11" style="v" sid="GEN 28:11" />याकूब के यातरा करत टेम बेरा बुढ जथै, इहैनिता ऊ रात बितामै के निता अक जिघा ठहरै गइस, याकूब ऊ जिघा अक्ठी पथरा देखिस अउ सोमै के निता ओखर उप्पर अपन मूंड रखके सोइस। <verse eid="GEN 28:11" /><verse number="12" style="v" sid="GEN 28:12" />याकूब स्वरगदूत के ऊ सीढी हे चढत-उतरत देखिस अउ भगवान के ऊ सीढी के लिघ्घो ठाढ देखथै, <verse eid="GEN 28:12" /><verse number="13" style="v" sid="GEN 28:13" />भगवान ओखर लिघ्घो ठाढ हुइके कथै, मै तोर बाबा अब्राहम के भगवान यहों, अउ तोर बाफ इसहाक के भगवान यहों, जउन भुंइ हे तै सोय हबस, उके मै तोके अउ तोर लरकन के दइहों। <verse eid="GEN 28:13" /><verse number="14" style="v" sid="GEN 28:14" />तोर लरका ओतका हुइहिन जेकता भुंइ के माटी के नान-नान पथरा हबै, उन पूरब, पच्छिम, उत्तर दख्छिन हे फइल जइहिन, भुंइ के सगलू परवार तोर लरका के कारन मोर लग आसीस पइहिन। <verse eid="GEN 28:14" /><verse number="15" style="v" sid="GEN 28:15" />मै तोर संग हव, जिहां कहि तै जइहे, मै तोके बचाइहों, मै तोके हइ देस हे वापिस लइहों, जउन बात मै तोर लग कहे हव, जब तक उके पूर न कर लो तब तक तोके कबहुन नेहको छांडिहो। <verse eid="GEN 28:15" /><verse number="16" style="v" sid="GEN 28:16" />तब याकूब नींद लग जगिस, ता ऊ कथै, जरूर हइ जिघा भगवान आथै, मै हइ नेहको जानथो। <verse eid="GEN 28:16" /><verse number="17" style="v" sid="GEN 28:17" />याकूब डर गइस, ऊ कथै, “हइ बोहत बडा जिघा हबै, हइ तो भगवान के घर आय, हइ तो स्वरग कर दूरा हबै।” <verse eid="GEN 28:17" /><verse number="18" style="v" sid="GEN 28:18" />याकूब दूसर रोज सुबेन्ने उठिस, ऊ पथरा के उठाइस अउ ओही बगल हे ठाढ कर दइस, तब ऊ ओखर उप्पर तेल चढाइस, हइ मेर लग ऊ भगवान के सुरता के निता खम्भा बनाइस। <verse eid="GEN 28:18" /><verse number="19" style="v" sid="GEN 28:19" />ऊ सहर कर नाम लूज रथै, पय याकूब उके बेतेल<note caller="+" style="f"><char style="fr" closed="false">28:19 </char><char style="ft" closed="false">भगवान कर घर</char></note> धरिस। <verse eid="GEN 28:19" /><verse number="20" style="v" sid="GEN 28:20" />याकूब अक्ठी बचन दइस, ऊ कथै, “अगर भगवान मोर संग रही अउ भगवान जिहां कहि मै जइहों, ऊ मोके बचइ, अगर भगवान मोके खाय के निता अउ पहिनै के निता कपडा देही, <verse eid="GEN 28:20" /><verse number="21" style="v" sid="GEN 28:21" />अगर मै अपन बाफ के लिघ्घो सान्ति लग लउटो, अगर भगवान हइ सगलू चीज करही, ता भगवान मोर भगवान होही। <verse eid="GEN 28:21" /><verse number="22" style="v" sid="GEN 28:22" />हइ जिघा हे मै हइ पथरा के ठाढ करे हव, भगवान के पवितर जिघा होही अउ भगवान जउन कुछु तै मोके देही ओखर दसमांस मै तोके दइहों।”<verse eid="GEN 28:22" /></para>
  <chapter eid="GEN 28" />
  <chapter number="29" style="c" sid="GEN 29" />
  <para style="s">याकूब के लाबान लग मुलाखात</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 29:1" />तब याकूब आगू बढिस ऊ पूरब के परदेस छो गइस। <verse eid="GEN 29:1" /><verse number="2" style="v" sid="GEN 29:2" />याकूब देखथै, कि मइदान हे अक्ठी कुंवा दिखथै, उहै कुंवा के लिघ्घो गेडरा के तीनठे झुंड बइठे देखथै, ऊ उहै कुंवा रथै, जिहां गेडरा पानी पीय करथै, कुंवा के मुंह हे अक्ठी बडा पथरा रथै। <verse eid="GEN 29:2" /><verse number="3" style="v" sid="GEN 29:3" />जब सगलू गेडरा इकठ्ठा हुइ जाय करथै, तब बरेदी कुंवा के पथरा के हटाय के उनही पानी पियाय करथै, पियाय के बाद ऊ पथरा के उहै जिघा हे मढाय देथै। <verse eid="GEN 29:3" /><verse number="4" style="v" sid="GEN 29:4" />याकूब बरेदिन लग पूंछथै, भाई, तुम कछो लग आय हबा? उन जबाब देथै, हम हारान सहर लग आय हवन। <verse eid="GEN 29:4" /><verse number="5" style="v" sid="GEN 29:5" />तब याकूब कथै, का तुम नाहोर के टोरवा लाबान के जानथा? उन कथै, हां हम जानथन। <verse eid="GEN 29:5" /><verse number="6" style="v" sid="GEN 29:6" />तब याकूब पूंछथै, “का उन सब ठीक हबै? उन कथै, हां, उन सब ठीक हबै, देख ओखर टोरिया राहेल अपन गेडरा के संग आउत हबै।” <verse eid="GEN 29:6" /><verse number="7" style="v" sid="GEN 29:7" />याकूब कथै, “देख, अबहुन दिन हबै अउ बेरा के बूढै हे बोहत देरी हबै, रात के निता पसु अउ गेडरा के इकठ्ठा करै का अबे टेम नेहको होय हबै, इहैनिता उनके पानी देया उनके मइदान हे फेरै लइ जा।” <verse eid="GEN 29:7" /><verse number="8" style="v" sid="GEN 29:8" />पय उन कथै, अबे हम असना नेहको कर सकथन, जब सगलू झुंड इकठ्ठा हुइ जइहिन अउ कुंवा के पथरा के हटाय जही, तब हम गेडरा के पानी पियाब। <verse eid="GEN 29:8" /><verse number="9" style="v" sid="GEN 29:9" />याकूब जब तक बरेदिन लग बात करत रहै तब राहेल अपन बाफ के गेडरा के संग आइस, ओखर काम गेडरा के चरामै का रथै। <verse eid="GEN 29:9" /><verse number="10" style="v" sid="GEN 29:10" />याकूब अपन मामा लाबान के टोरिया राहेल अउ ओखर गेडरा के देखके कुंवा के लिघ्घो गइस, ऊ कुंवा के पथरा के हटाइस, अउ अपन मामा के गेडरा के पानी पिलाइस। <verse eid="GEN 29:10" /><verse number="11" style="v" sid="GEN 29:11" />तब याकूब राहेल के चूमिस अउ खुसी लग बोहत रोमै लगिस। <verse eid="GEN 29:11" /><verse number="12" style="v" sid="GEN 29:12" />याकूब गुठेथै कि मै तोर बाफ के बिरादरी लग हव, ऊ राहेल के गुठेथै कि मै रिबका के टोरवा यहों, इहैनिता राहेल घर छो दउडत गइस अउ अपन बाफ लग हइ बात बताइस। <verse eid="GEN 29:12" /><verse number="13" style="v" sid="GEN 29:13" />जब लाबान अपन बेहन के टोरवा याकूब के बारे हे सुनिस तब ऊ ओखर लग मिलै के निता दउडत आथै, ऊ याकूब के गले लगाइस अउ ओही चुमिस, ऊ याकूब के अपन घर लइ गइस, याकूब जउन कुछु होय रथै, अपन मामा लाबान के सगलू बात गुठेइस। <verse eid="GEN 29:13" /><verse number="14" style="v" sid="GEN 29:14" />तब लाबान ओखर लग कथै, तै हमर हाडा अउ मास के हबस, अउ याकूब मामा लाबान के संग अक महिना तक रहिस।<verse eid="GEN 29:14" /></para>
  <para style="s">लाबान के सेबा</para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 29:15" />अक रोज लाबान याकूब लग कथै, “का तै मोर बिरादरी होमै के कारन बिना मजदूरी लय मोर सेबा करत रइहे? मोके बता कि तोर मजदूरी काहिन हबै?” <verse eid="GEN 29:15" /><verse number="16" style="v" sid="GEN 29:16" />लाबान के दुइठे टोरिया रथै, बडी के नाम लिया अउ नान टोरिया के नाम राहेल रथै। <verse eid="GEN 29:16" /><verse number="17" style="v" sid="GEN 29:17" />राहेल दिखै हे बोहत सुन्दर रथै, अउ लिया के आंखी लग धुंधला रथै। <verse eid="GEN 29:17" /><verse number="18" style="v" sid="GEN 29:18" />याकूब राहेल लग माया करथै, ऊ लाबान लग कथै, “अगर तै मोके अपन टोरिया राहेल लग काज करन दइहे ता मै तोर इहां सात साल तक काम कर सकथो।” <verse eid="GEN 29:18" /><verse number="19" style="v" sid="GEN 29:19" />लाबान कथै, मै राहेल के पराय डउका के दो, पय एखर लग निक्खा हबै कि मै उके तोहिन के सउप दो, तै मोर संग रइहे। <verse eid="GEN 29:19" /><verse number="20" style="v" sid="GEN 29:20" />हइ मेर लग याकूब राहेल के निता सात साल तक काम करथै, पय हइ टेम याकूब के बोहत कम लगथै, काखे ऊ राहेल लग बोहत माया करथै। <verse eid="GEN 29:20" /><verse number="21" style="v" sid="GEN 29:21" />याकूब अपन मामा लाबान लग कथै, “मोके राहेल के देया जेखर लग मै ओखर संग काज कर सको, काखे तुम्हर इहां मोर काम करै के टेम पूर हुइ चुके हबै।” <verse eid="GEN 29:21" /><verse number="22" style="v" sid="GEN 29:22" />लाबान ऊ जिघा हे मनसेन के बुलाय के इकठ्ठा करथै, अउ अक्ठी भोजन तइयार करवाथै। <verse eid="GEN 29:22" /><verse number="23" style="v" sid="GEN 29:23" />पय संझा के टेम ऊ अपन बडा टोरिया लिया के लइके याकूब के लिघ्घो गइस, याकूब ओखर संग रात बिताइस। <verse eid="GEN 29:23" /><verse number="24" style="v" sid="GEN 29:24" />(लाबान अपन टोरिया लिया के सेबिका के रूप हे हरवाहिन होमै के कारन जिल्पा के दइस) <verse eid="GEN 29:24" /><verse number="25" style="v" sid="GEN 29:25" />याकूब सुबेन्ने उठथै ता पता चलथै कि मै लिया के संग सोय रहों, याकूब लाबान लग कथै, “तै मोके नरे हबस, मै तोर निता बोहत मेहनत इहैनिता करो कि मै राहेल लग काज कर सको, तै मोके काखे नरे हबस?” <verse eid="GEN 29:25" /><verse number="26" style="v" sid="GEN 29:26" />लाबान कथै, “हमर देस हे नान टोरिया के काज बडा टोरिया लग पहिले नेहको होथै। <verse eid="GEN 29:26" /><verse number="27" style="v" sid="GEN 29:27" />हइ हफ्ता तो पूर कर, ओखर बाद हम दूसर टोरिया राहेल के तोर संग काज कर देब, पय तोके अउ सात साल तक सेबा करै के होही।” <verse eid="GEN 29:27" /><verse number="28" style="v" sid="GEN 29:28" />याकूब असनै करिस, अउ लिया के हफ्ता के पूर करिस, तब लाबान उके अपन टोरिया राहेलो दइ दइस कि ऊ ओखर डउकी बनै। <verse eid="GEN 29:28" /><verse number="29" style="v" sid="GEN 29:29" />लाबान अपन टोरिया राहेल के अपन हरवाहिन बिल्हा के दान के रूप हे दइ दइस ताकि ऊ राहेल के सेबा करै। <verse eid="GEN 29:29" /><verse number="30" style="v" sid="GEN 29:30" />याकूब राहेल के लिघ्घो गइस, पय ऊ लिया लग कम राहेल लग जादा माया करथै, ऊ सात साल तक लाबान के सेबा करिस।<verse eid="GEN 29:30" /></para>
  <para style="s">याकूब के लरका</para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 29:31" />भगवान देखिस कि याकूब लिया लग कम राहेल लग बोहत माया करथै, इहैनिता भगवान लिया के हइ काबिल बनाइस कि ऊ लरका के पइदा कर सके, पय राहेल के कउनो लरका नेहको हुइस। <verse eid="GEN 29:31" /><verse number="32" style="v" sid="GEN 29:32" />लिया अक्ठी टोरवा के पइदा करिस, ऊ ओखर नाम रूबेन धरिस, लिया ओखर हइ नाम इहैनिता धरिस काखे ऊ कथै, “भगवान मोर परेसानी के देखे हबै, मोर डउका मोर लग माया नेहको करथै, इहैनिता हुइ सकथै कि मोर डउका अब मोर लग माया करै।” <verse eid="GEN 29:32" /><verse number="33" style="v" sid="GEN 29:33" />लिया फेरै लादा हे हुइस, अउ ऊ दूसर टोरवा के पइदा करिस, ऊ हइ टोरवा के नाम सिमोन धरिस, लिया कथै, “भगवान मोर बात के सुने हबै कि मोके माया नेहको मिलथै, इहैनिता ऊ मोके हइ टोरवा दय हबै।<note caller="+" style="x"><char style="xo" closed="false">29:33 </char><char style="xt" closed="false"><ref loc="MAT 1:2">मत्ती 1:2</ref></char></note>” <verse eid="GEN 29:33" /><verse number="34" style="v" sid="GEN 29:34" />लिया फेरै लादा हे हुइस, अउ ऊ अक्ठी टोरवा के पइदा करिस, ऊ टोरवा के नाम लेवी धरिस, लिया कथै, “अब जरूर मोर डउका मोर लग माया करही, मै उके तीनठे टोरवा दय हव।” <verse eid="GEN 29:34" /><verse number="35" style="v" sid="GEN 29:35" />ऊ फेरै लादा हे हुइस, ऊ अक्ठी टोरवा के पइदा करिस, ऊ ओखर नाम यहूदा धरिस, लिया उके नाम इहैनिता दइस कि ऊ कहे रथै, “अब मै भगवान के धन्यवाद करिहों,” तब लिया के लरका होय के बन्द हुइ जथै।<verse eid="GEN 29:35" /></para>
  <chapter eid="GEN 29" />
  <chapter number="30" style="c" sid="GEN 30" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 30:1" />राहेल देखथै कि ऊ याकूब के निता कउनो लरका पइदा नेहको कर सकथै, राहेल अपन बेहन लिया लग इसाय लग जथै, इहैनिता राहेल याकूब लग कथै, “मोके लरका दे, नही ता मै मर जइहों।” <verse eid="GEN 30:1" /><verse number="2" style="v" sid="GEN 30:2" />याकूब राहेल के उप्पर गुस्सा होथै, अउ कथै, “मै भगवान नेहको यहों, ऊ भगवान हबै जउन तोके लरका के पइदा करे लग रोके हबै।” <verse eid="GEN 30:2" /><verse number="3" style="v" sid="GEN 30:3" />तब राहेल कथै, “तै मोर हरवाहिन बिल्हा के लइ सकथस, ओखर संग सो अउ ऊ मोर निता लरका के पइदा करी, तब मै ओखर दवारा दाय बनिहों।” <verse eid="GEN 30:3" /><verse number="4" style="v" sid="GEN 30:4" />हइ मेर लग अपन डउका याकूब के निता बिल्हा के दइस, याकूब बिल्हा के संग सोइस। <verse eid="GEN 30:4" /><verse number="5" style="v" sid="GEN 30:5" />बिल्हा लादा हे हुइस अउ याकूब के निता अक्ठी टोरवा के पइदा करिस। <verse eid="GEN 30:5" /><verse number="6" style="v" sid="GEN 30:6" />राहेल कथै, “भगवान मोर बिनती के सुन लय हबै, ऊ मोके अक्ठी टोरवा के रूप हे दय हबै,” इहैनिता राहेल ओखर नाम दान धरिस। <verse eid="GEN 30:6" /><verse number="7" style="v" sid="GEN 30:7" />राहेल कर हरवाहिन बिल्हा दूसर बेर लादा हे हुइस अउ याकूब के निता दूसर टोरवा के पइदा करिस। <verse eid="GEN 30:7" /><verse number="8" style="v" sid="GEN 30:8" />राहेल कथै, “अपन बेहन लग लडै हव मै बोहत झगडा करे हव तब जाके मोके जीत मिले हबै,” इहैनिता ऊ हइ टोरवा कर नाम नप्ताली धरिस। <verse eid="GEN 30:8" /><verse number="9" style="v" sid="GEN 30:9" />लिया सोचिस कि ऊ अउ बोहत लरका के पइदा नेहको कर सकथै, इहैनिता ऊ अपन हरवाहिन जिल्पा के याकूब के निता दइस। <verse eid="GEN 30:9" /><verse number="10" style="v" sid="GEN 30:10" />अउ लिया के हरवाहिन जिल्पा के याकूब लग अक्ठी टोरवा के पइदा करिस। <verse eid="GEN 30:10" /><verse number="11" style="v" sid="GEN 30:11" />लिया कथै, “मै भाग्यवती हव,” अब डउकी मोके भाग्यवती कइहिन, इहैनिता ऊ टोरवा कर नाम गाद धरिस। <verse eid="GEN 30:11" /><verse number="12" style="v" sid="GEN 30:12" />लिया के हरवाहिन जिल्पा के याकूब लग दूसर टोरवा के पइदा करिस। <verse eid="GEN 30:12" /><verse number="13" style="v" sid="GEN 30:13" />लिया कथै, “मै बोहत खुस हव, इहैनिता ऊ टोरवा कर नाम आसेर धरिस।”<verse eid="GEN 30:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 30:14" />गोंहू कटाई के रोज हे रूबेन बाहिर गइस, उके मइदान हे कुछ खास दूदा<note caller="+" style="f"><char style="fr" closed="false">30:14 </char><char style="ft" closed="false">प्रेम कर फल</char></note> फडुहा मिलिस, रूबेन दूदा फडुहा के अपन दाय के लिघ्घो आनिस, राहेल लिया लग कथै, किरपा करके तोर टोरवा के लिघ्घो जउन फूल हबै ओही चुटु हस महुं के दइ दे। <verse eid="GEN 30:14" /><verse number="15" style="v" sid="GEN 30:15" />लिया कथै, “तै तो मोर डउका के पहिलेन लग लइ लय हबस, अब तै मोर टोरवा के फूलो के लय चाहथस,” पय राहेल जबाब देथै, “अगर तै अपन टोरवा के फूल के दइहे ता आज तै याकूब के संग सोय सकथस।” <verse eid="GEN 30:15" /><verse number="16" style="v" sid="GEN 30:16" />ऊ रात याकूब खेत हे सोय रथै, लिया ओही देखिस अउ ओखर लग मिलै कढ गइस, ऊ कथै, आज रात भर मोर संग सुइहे, मै अपन टोरवा के फूल के तोर कीमत के रूप हे दय हव, इहैनिता याकूब उस रात लिया के संग सोय रथै। <verse eid="GEN 30:16" /><verse number="17" style="v" sid="GEN 30:17" />तब भगवान लिया के बिनती के सुनिस, ऊ लादा हे हुइस अउ ऊ याकूब लग पचमा लरका के पइदा करिस। <verse eid="GEN 30:17" /><verse number="18" style="v" sid="GEN 30:18" />लिया कथै, भगवान मोके मोर मेहनत के फडुहा दय हबै, काखे मै अपन हरवाहिन के अपन डउका के दय रथो, इहैनिता ऊ ओखर नाम इस्साकार धरिस। <verse eid="GEN 30:18" /><verse number="19" style="v" sid="GEN 30:19" />लिया फेरै लादा हे हुइस अउ याकूब लग ओखर छटमा लरका के पइदा करिस। <verse eid="GEN 30:19" /><verse number="20" style="v" sid="GEN 30:20" />लिया कथै, भगवान मोके अक्ठी सुन्दर भेंट दय हबै, अब जरूर याकूब मोके अपनाही, काखे मै उके छयठे लरका दय हव, इहैनिता लिया टोरवा कर नाम जबूलून धरिस। <verse eid="GEN 30:20" /><verse number="21" style="v" sid="GEN 30:21" />एखर बाद लिया अक्ठी टोरिया के पइदा करिस, ऊ टोरिया के नाम दीना धरिस। <verse eid="GEN 30:21" /><verse number="22" style="v" sid="GEN 30:22" />तब भगवान राहेल के बिनती सुनिस, अउ भगवान राहेल के कोंख खोलिस। <verse eid="GEN 30:22" /><verse number="23" style="v" sid="GEN 30:23" />ऊ लादा हे हुइस अउ ऊ अक्ठी टोरवा के पइदा करिस, ऊ कथै, भगवान मोर नाम धराई के दूर कर दय हबै। <verse eid="GEN 30:23" /><verse number="24" style="v" sid="GEN 30:24" />इहैनिता ऊ हइ कहिके ओखर नाम यूसुफ धरिस, “भगवान मोके अक्ठी टोरवा अउ देही।”<verse eid="GEN 30:24" /></para>
  <para style="s">याकूब लाबान के संग समझउता</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 30:25" />यूसुफ के राहेल जब पइदा करिस तब याकूब लाबान लग कथै, “मोके अब अपन घर जाय देया। <verse eid="GEN 30:25" /><verse number="26" style="v" sid="GEN 30:26" />मोके मोर डउकी, मोर लरका देया, जेखर निता मै तोर सेबा करे हव, मोके जाय देया, काखे जउन सेबा मै तोर करे हव, उके तै खुदय जानथस। <verse eid="GEN 30:26" /><verse number="27" style="v" sid="GEN 30:27" />लाबान ओखर लग कथै, मोके कुछ कहे दे, काखे मै जान लग हव, कि भगवान तोर बजह लग मोके आसीस दय हबै। <verse eid="GEN 30:27" /><verse number="28" style="v" sid="GEN 30:28" />तै बता कि तोके मै का दो, जउन कइहे उहै तोके मै देहुं।” <verse eid="GEN 30:28" /><verse number="29" style="v" sid="GEN 30:29" />याकूब जबाब देथै, “तै जानथस कि मै तोर निता बोहत मेहनत करे हव, तोर पसु बोहत हबै, अउ जब तक मै उनखर देखभाल करे हव, ठीकै हबै। <verse eid="GEN 30:29" /><verse number="30" style="v" sid="GEN 30:30" />जब मै आय रहों, ता तोर लिघ्घो चुटु हस रहै, अब तोर लिघ्घो बोहत हबै, भगवान तोके बोहत आसीस दय हबै, अब मोर निता टेम आ गय हबै, कि मै अपन काम करो, हइ मोर निता अपन घर बनामै का टेम हबै।” <verse eid="GEN 30:30" /><verse number="31" style="v" sid="GEN 30:31" />लाबान कथै, “मै तोके काहिन दो?” याकूब जबाब देथै, “तै मोके कुछ झइ दे, अगर तै मोर अक्ठी काम कर, ता मै तोर गेडरा छेडी के चराइहों, अउ ओखर देखभाल करिहों। <verse eid="GEN 30:31" /><verse number="32" style="v" sid="GEN 30:32" />मोके आज अपन सगलू गेडरा छेडी के बीच हे जाय देया, मै हर चित्ती अउ चितकबरी गेडरा के मोके ले देया, अउ करिया छेडी के चित्ती अउ चितकबरी के ले देया, इहै मोर मजदूरी होही। <verse eid="GEN 30:32" /><verse number="33" style="v" sid="GEN 30:33" />भभिस्य हे तै सरलता लग देख लइहे कि मै इमानदार हव, ता तै मोर गेडरा अउ छेडी के देखै आ सकथस, अगर कउनो छेडी करिया नेहको होही या गेडरा चितकबरी नेहको होही ता तै जान जाबे कि उके चुराय हव।” <verse eid="GEN 30:33" /><verse number="34" style="v" sid="GEN 30:34" />लाबान जबाब देथै, “मै तोर बात मानथो, तै जउन कुछु मंगहे हम दइबे।” <verse eid="GEN 30:34" /><verse number="35" style="v" sid="GEN 30:35" />पय ऊ रोज लाबान दाग बाले छेडी के लुकाय देथै, अउ लाबान सगलू दाग बाले या चितकबरी छेडिन के लुकाय देथै, अउ ऊ सगलू करिया गेडरा के लुकाय देथै, अउ ऊ अपन टोरवा के हइ गेडरा के देखभाल करै का कथै। <verse eid="GEN 30:35" /><verse number="36" style="v" sid="GEN 30:36" />इहैनिता टोरवा सगलू चितकबरी गेडरा अउ छेडी के लइस अउ ऊ दूसर जिघा कढ गइस, उन तीन रोज तक के यातरा करिस, याकूब रुक गइस, अउ लाबान के बचे हर छेडी अउ गेडरा के चरामै लग जथै, पय उन हे कउन छेडी अउ गेडरा चितकबरी या करिया नेहको रथै। <verse eid="GEN 30:36" /><verse number="37" style="v" sid="GEN 30:37" />इहैनिता याकूब चिनार, बादाम अउ अर्मोन के रूख के हरियर डेराइया काटिस, ऊ उनखर छाली हइ मेर उतारिस कि डेराइया चरका दिखै लग जथै। <verse eid="GEN 30:37" /><verse number="38" style="v" sid="GEN 30:38" />ऊ काटे हर डगाइल गेडरा छेडी के लिघ्घो नाला हे, मतलब नदिया हे जिहां उन पानी पिय के निता आथै, ठाढ कर देथै, जब उन पानी के निता आइन, तब उन लादा हे हुइ जथै। <verse eid="GEN 30:38" /><verse number="39" style="v" sid="GEN 30:39" />छेडी गेडरा डेराइया के लिघ्घो लादा हे होय रथै, इहैनिता उन चित्ताबाले, चितकबरी छउना के पइदा करिन। <verse eid="GEN 30:39" /><verse number="40" style="v" sid="GEN 30:40" />तब याकूब गेडरा के लरका के अलगे-अलगे करिस, अउ लाबान के गेडरा छेडी के मुंह के चितकबरी अउ सगलू करिया लरका के पल्ला कर दइस, अउ अपन झुंड के उनखर लग अलग रखिस, अउ लाबान के गेडरा छेडी लग मिलै नेहको देथै। <verse eid="GEN 30:40" /><verse number="41" style="v" sid="GEN 30:41" />जब कबहुन झुंड हे निक्खा छेडी लादा हे होमै के निता मिलथै, तब याकूब उनखर आंखी के सामने डेराइया रख देथै, उन डेरा-इया के करीब हइ छेडी लादा होमै के निता मिलथै। <verse eid="GEN 30:41" /><verse number="42" style="v" sid="GEN 30:42" />पय जब कमजोर पसु छेडी लादा हे होमै के निता मिलथै ता याकूब उहां डगाइल नेहको धरथै, हइ मेर कमजोर पसु लग पइदा लरका लाबान के रथै, बलवान पसु लग पइदा लरका याकूब के रथै। <verse eid="GEN 30:42" /><verse number="43" style="v" sid="GEN 30:43" />हइ मेर लग याकूब धनड्ड हुइ गय, ओखर लिघ्घो बडी झुंड, बोहत लग हरवाह, उंटवा, छेडी, गेडरा अउ गदहा रथै।<verse eid="GEN 30:43" /></para>
  <chapter eid="GEN 30" />
  <chapter number="31" style="c" sid="GEN 31" />
  <para style="s">याकूब लाबान के लिघ्घो लग भाग जथै</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 31:1" />अक रोज याकूब लाबान के टोरवा के बात करत सुनथै उन कथै, याकूब हमर बाफ के सब कुछ के लूट लय हबै, याकूब धनड्ड हुइ गय हबै, अउ हइ सगलू डेरा ऊ हमर बाफ लग लय हबै। <verse eid="GEN 31:1" /><verse number="2" style="v" sid="GEN 31:2" />याकूब लाबान के मुंह के देखके समझ जथै कि ऊ ओखर पल्ला पहिले जसना माया नेहको हबै। <verse eid="GEN 31:2" /><verse number="3" style="v" sid="GEN 31:3" />तब परभु याकूब लग कथै, “अपन सियान के देस छो लउट जा, जिहां तै पइदा होय रहस, मै तोर संग हव।” <verse eid="GEN 31:3" /><verse number="4" style="v" sid="GEN 31:4" />इहैनिता याकूब राहेल अउ लिया के उहां बुलवा लेथै, जिहां ऊ गेडरा छेडी के झुंड रथै। <verse eid="GEN 31:4" /><verse number="5" style="v" sid="GEN 31:5" />याकूब उनखर लग कथै, मै तोर बाफ के मुंह के देखके समझ गय हव, कि ऊ मोर पल्ला पहिले जसना माया नेहको करथै, पय भगवान मोर बाफ के संग हबै। <verse eid="GEN 31:5" /><verse number="6" style="v" sid="GEN 31:6" />दुनो तुम जानथस कि मै अपन पूर मेहनत लग तोर बाफ के सेबा सक्ति करे हव। <verse eid="GEN 31:6" /><verse number="7" style="v" sid="GEN 31:7" />पय तुम्हर बाफ मोके धोखा दय हबै, तोर बाफ मोर मजदूरी के दस बेर बदल लय हबै, पय हइ पूर टेम हे भगवान मोके लाबान के सगलू धोखा लग बचाय हबै। <verse eid="GEN 31:7" /><verse number="8" style="v" sid="GEN 31:8" />जब उन कहे रथै, “चितकबरी बाले लरका तोर मजदूरी होही,” तब सगलू गेडरा छेडी चितकबरी लरका के पइदा करिन, जब उन कथै, “धारीदार लरका तोर मजदूरी होही,” तबो सगलू गेडरा छेडी धारीदार लरका के पइदा करिन। <verse eid="GEN 31:8" /><verse number="9" style="v" sid="GEN 31:9" />हइ मेर भगवान तोर बाफ के पसु लइके मोके दइ दय हबै। <verse eid="GEN 31:9" /><verse number="10" style="v" sid="GEN 31:10" />जउन टेम छेडी बोकडा लादा हे होमै के निता मिलथै, मै अक्ठी सपना देके रहों, मै देखथो कि छेडी के उप्पर बोकडा चढथै, जउन लादा हे करै के निता मिलत रहै धारीदार अउ चितकबरी रथै। <verse eid="GEN 31:10" /><verse number="11" style="v" sid="GEN 31:11" />तब भगवान के स्वरगदूत मोर लग कथै, “याकूब” मै उके जबाब दयों, “काहिन आदेस हबै?” <verse eid="GEN 31:11" /><verse number="12" style="v" sid="GEN 31:12" />ऊ आदेस दइस, “अपन आंखी उठाय के देख कि छेडी हे चढै बाले सगलू बोकडा धारीदार चित्ते अउ चितकबरी हबै, लाबान तोर संग जउन कुछु करथै, ऊके मै देखो हव। <verse eid="GEN 31:12" /><verse number="13" style="v" sid="GEN 31:13" />मै ऊ बेतेल का भगवान यहों, जिहां तै अक्ठी खम्भा हे तेल डाले रहस, अउ तै मोर मन्नत माने रथस, अब उठ हइ देस लग बाहिर निकड अउ अपन पइदाइसी जिघा लउट जा।”<note caller="+" style="x"><char style="xo" closed="false">31:13 </char><char style="xt" closed="false"><ref loc="GEN 28:18">उत्पति 28:18</ref>,<ref loc="GEN 28:22">22</ref></char></note> <verse eid="GEN 31:13" /><verse number="14" style="v" sid="GEN 31:14" />राहेल अउ लिया याकूब के कथै, “का हमर बाफ के लिघ्घो मरै के बाद हमके देय के निता कुछु हबै कि नेहको? <verse eid="GEN 31:14" /><verse number="15" style="v" sid="GEN 31:15" />ऊ हमर संग पराय जसना बेउहार करे हबै, ऊ हमके अउ तुमके बेच दइस अउ हइ मेर हमर सगलू डेरा ऊ खरच कर दइस। <verse eid="GEN 31:15" /><verse number="16" style="v" sid="GEN 31:16" />भगवान हइ सगलू डेरा के हमर बाफ लइ लय हबै अउ अब हइ हमर हबै, इहैनिता तुम उहै करा जउन भगवान करै के निता कहे हबै।” <verse eid="GEN 31:16" /><verse number="17" style="v" sid="GEN 31:17" />याकूब अपन लरका अउ डउकी के उंटवा हे बइठाइस। <verse eid="GEN 31:17" /><verse number="18" style="v" sid="GEN 31:18" />तब ऊ कनान देस छो लउटै लगिस जिहां ओखर बाफ इसहाक रथै, सगलू पसु सगलू झुंड, जउन याकूब के रथै, उनखर आगू चलथै, ऊ सगलू चीज संग लइ जात रथै जउन ऊ पद्दनराम हे रहत मिले रथै। <verse eid="GEN 31:18" /><verse number="19" style="v" sid="GEN 31:19" />हइ टेम लाबान अपन गेडरा के ऊन काटै गय रथै, जब ऊ बाहिर गय तब राहेल ओखर घर हे घुसिस अउ अपन बाफ के देउता के चुराय लइ आनिस। <verse eid="GEN 31:19" /><verse number="20" style="v" sid="GEN 31:20" />याकूब अरामी लाबान के धोखा दइस, ऊ लाबान के नेहको बताइस कि ऊ उहां लग जथै। <verse eid="GEN 31:20" /><verse number="21" style="v" sid="GEN 31:21" />पय ऊ अपन सब कुछ लइके भाग गइस, ऊ फरात नदिया पार करके अउ ऊ गिलाद के पहाडी देस परदेस चल पडथै।<verse eid="GEN 31:21" /></para>
  <para style="s">लाबान दवारा याकूब के पछियाथै</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 31:22" />तीन रोज बाद लाबान के पता चलथै कि याकूब भाग गइस। <verse eid="GEN 31:22" /><verse number="23" style="v" sid="GEN 31:23" />इहैनिता लाबान अपन मनसे के अकजुट करिस अउ याकूब के पीछा करै के सुरु करिस, सात रोज बाद लाबान याकूब के गिलाद डोंगर के लिघ्घो पाइस। <verse eid="GEN 31:23" /><verse number="24" style="v" sid="GEN 31:24" />ऊ रात भगवान अरामी लाबान के लिघ्घो सपना हे परगट हुइस, भगवान कथै, “याकूब लग तै जउन कुछ कह ओखर अक्ठी सब्द के निता साचेत रह।” <verse eid="GEN 31:24" /><verse number="25" style="v" sid="GEN 31:25" />लाबान याकूब के पकर लेथै, ऊ अपन तम्बू डोंगर हे गाडे रथै, ऊ अपन मनसे के संग गिलाद के डोंगर परदेस हे तम्बू डालिस। <verse eid="GEN 31:25" /><verse number="26" style="v" sid="GEN 31:26" />लाबान याकूब लग कथै, “तै मोके धोखा काखे दय? तै मोर टोरिया के असना काखे लइ जात हबस माना उन लडाई हे पकडे गय टोरिया होय? <verse eid="GEN 31:26" /><verse number="27" style="v" sid="GEN 31:27" />मोर लग बेगैर पूंछे काखे भगे अगर तै कहे होतस, ता मै तोके दावत दय होतो? ओहमा बाजा के संग नाचना अउ गाना होथै। <verse eid="GEN 31:27" /><verse number="28" style="v" sid="GEN 31:28" />तै मोके अपन नाती के चुमै नेहको दय अउ न टोरिया के बिदा कहै दय, तै हइ करके बोहत बड मूरख के काम करे हवस। <verse eid="GEN 31:28" /><verse number="29" style="v" sid="GEN 31:29" />तोके सहीमा चोंट पहुंचामै के सक्ति मोर हे हबै, पय पिछली रात तुम्हर बाफ के भगवान मोर सपना हे आइस, ऊ मोके चेतन्त दइस कि याकूब लग न तो भला कइहा अउ न बुरा। <verse eid="GEN 31:29" /><verse number="30" style="v" sid="GEN 31:30" />मै जानथो कि तै अपन घर छो लउटै चाहथस, इहै कारन हबै कि तै उहां लग कढ जा, पय तै मोर घर लग देउता के काखे चोरे हबस?” <verse eid="GEN 31:30" /><verse number="31" style="v" sid="GEN 31:31" />याकूब लाबान के जबाब देथै, “मै डर गय रथो, मै सोचत रहों कि कहुं तै अपन टोरिया के मोर लग छंडाय लइहे। <verse eid="GEN 31:31" /><verse number="32" style="v" sid="GEN 31:32" />पय मै तुम्हर देउता के नेहको चोरे यहों, अगर तै इहां मोर लिघ्घो कउनो मनसे के, जउन तोर देउता के चोराय हबै, पाबा ता उके मार देया, तुम्हर मनसे मोर गवाह हुइहिन, तै अपन कउनो चीज के इहां ढूंढ सकथा, जउन कुछु तुम्हर होय, लइ लेया।” याकूब के हइ नेहको पता रथै, कि राहेल लाबान के देउता चोरे हबै। <verse eid="GEN 31:32" /><verse number="33" style="v" sid="GEN 31:33" />इहैनिता लाबान याकूब के तम्बू हे गइस अउ ओहमा ढूंढै लगिस, ऊ याकूब के तम्बू हे ढूंढिस अउ तब लिया के तम्बू हे ढूंढिस, तब ऊ उस तम्बू हे ढूंढिस जेहमा दोनोझन हरवाहिन रुके रथै, पय ऊ ओखर घर के देउता के नेहको पाइन, तब लाबान राहेल के तम्बू हे गइस। <verse eid="GEN 31:33" /><verse number="34" style="v" sid="GEN 31:34" />राहेल उंटवा के कांधा हे देउता के लुकाय देथै, अउ ऊ ओखरै उप्पर बइठ जथै, तब लाबान पूर तम्बू हे ढूंढिस पय ऊ देउता के नेहको पाइस। <verse eid="GEN 31:34" /><verse number="35" style="v" sid="GEN 31:35" />राहेल अपन बाफ लग कथै, “हे मोर परभु गुस्सा झइ हो, मै तोर आगू ठाढ नेहको हुइ सकथै, काखे मोर मासिक धरम चलत हबै,” हइ मेर लाबान ढूंढिस, पय उके देउता नेहको मिलिस। <verse eid="GEN 31:35" /><verse number="36" style="v" sid="GEN 31:36" />तब याकूब बोहत गुस्सा हुइ के लाबान लग झगडा करै लग जथै, अउ कथै, “मै काहिन पाप करे हव? मै कोन सा नियम टोरे हव? कि मोर पाछू करैका अउ मोके रोकै के तोर हक नेहको हबै? <verse eid="GEN 31:36" /><verse number="37" style="v" sid="GEN 31:37" />मोर जउन कुछु हबै ओहमा तै ढूंढ लय, तै असना कउनो चीज नेहको पाय हबा जउन तुम्हर हबै, अगर तै कउनो चीज पाय हबा ता मोके दिखाबा, उके इहां धर जेहमा हमर संगी देख सकै, हमर संगी के तय करै देया कि हम दोनो हे कोन निक्खा हबै। <verse eid="GEN 31:37" /><verse number="38" style="v" sid="GEN 31:38" />मै तुम्हर निता बीस साल तक काम करे हव, ई पूर टेम हे लरका पइदा करत टेम हे कउनो गेडरा छेडी तुम्हर समूह मसे नेहको खाय हबै। <verse eid="GEN 31:38" /><verse number="39" style="v" sid="GEN 31:39" />जउन पसु के डोंगर के जानवर मार डालत रहै, उके मै तोर लिघ्घो नेहको लाय करथो अउ मै खुद ऊ घाटा के पूरा करत रथो, पसु के चोरी चाहे रात के होय, या दिन के, तै मोर लग लइ ले करत रहस। <verse eid="GEN 31:39" /><verse number="40" style="v" sid="GEN 31:40" />मोर असना हालत खराब रहै, दिन के घाम अउ रात के ठंड लग मै मारे जथो, मोर नींद मोर आंखी लग भाग जाय करथै। <verse eid="GEN 31:40" /><verse number="41" style="v" sid="GEN 31:41" />मै बीस साल तक तोर घर हे रहों, मै तोर दुइठे टोरिया के निता चउदा साल तक, अउ तोर गेडरा छेडी कर निता छय साल तक तोर सेबा करो, तै दस बेर मोर मजदूरी के बदले। <verse eid="GEN 31:41" /><verse number="42" style="v" sid="GEN 31:42" />मोर बाफ के भगवान, अब्राहम के भगवान अउ इसहाक के भय मोर संग रथै, अगर भगवान मोर संग नेहको होथै ता तै मोके खाली हाथ पठोय देथै, पय भगवान मोर समस्या के देखिस, भगवान मोर करे हर काम के देखिस अउ पिछले रात भगवान साबित कर दइस कि मै निक्खा हव।”<verse eid="GEN 31:42" /></para>
  <para style="s">याकूब अउ लाबान के बीच टीमा</para>
  <para style="p">
    <verse number="43" style="v" sid="GEN 31:43" />लाबान याकूब लग कथै, “हइ टोरिया मोर बिटिया हबै, उनखर लरका मोर हबै, हइ गेडरा मोर हबै, जउन कुछु तै इहां देखथा, मोर हबै, पय मै अपन टोरिया अउ उनखर लरका के रखै के निता कुछु नेहको कर सकथो। <verse eid="GEN 31:43" /><verse number="44" style="v" sid="GEN 31:44" />इहैनिता मै तोर लग अक्ठी टीमा करै चाहथो, हमन पथरा के अक्ठी ढेर बनाउबे जउन हइ बताही कि हम टीमा करे चुके हवन।” <verse eid="GEN 31:44" /><verse number="45" style="v" sid="GEN 31:45" />तब याकूब अक्ठी पथरा लइके उके खम्भा के रूप हे डाढ करिस। <verse eid="GEN 31:45" /><verse number="46" style="v" sid="GEN 31:46" />तब याकूब अपन परवार लग कथै, पथरा के टुकडा अकजुट करा। उन पथरा के अकजुट करके अक्ठी ढेर बनाइस, अउ उहां ओखर उप्पर बइठ के भोजन करिस। <verse eid="GEN 31:46" /><verse number="47" style="v" sid="GEN 31:47" />लाबान ऊ जिघा के नाम धरिस यज्रसहादुथा<note caller="+" style="f"><char style="fr" closed="false">31:47 </char><char style="ft" closed="false">गवाह के ढेर</char></note>, पय याकूब ऊ जिघा के नाम गिलियाद धरिस। <verse eid="GEN 31:47" /><verse number="48" style="v" sid="GEN 31:48" />लाबान याकूब लग कथै, “हइ पथरा के ढेर हम दोनोझन के हमर टीमा के सुरता दिलामै हे मदत मिलही।” हइ कारन हबै कि याकूब ऊ जिघा के गिलियाद धरिस। <verse eid="GEN 31:48" /><verse number="49" style="v" sid="GEN 31:49" />तब लाबान कथै, “भगवान, हम के अक दूसर लग अगले होमै के देखभाल करत रहै, इहैनिता ऊ जिघा के नाम मिजपा होही। <verse eid="GEN 31:49" /><verse number="50" style="v" sid="GEN 31:50" />तब लाबान कथै, अगर तै मोर टोरिया के चोंट पहुंचइहे ता सुरता रखबे, भगवान तोके सजा देही, अगर तै दूसर डउकी लग काज करिहे ता सुरता रखबे, भगवान तोके देखथै।” <verse eid="GEN 31:50" /><verse number="51" style="v" sid="GEN 31:51" />फेर लाबान याकूब लग कथै, “इहां हइ पथरा हबै, जउन हमर बीच हे रखे हबै अउ हइ खासकर पथरा हबै जउन बताही कि हम टीमा करे हबै। <verse eid="GEN 31:51" /><verse number="52" style="v" sid="GEN 31:52" />हइ ढेर गवाह हबै, हइ पथरा सबूत हबै कि अपन टीमा के सुरता करामै हे मदत करही, तोर लग लडै के निता हइ पथरा के पार नेहको जहुं, अउ तै मोर लग लडै के निता हइ पथरा लग आगू मोर पल्ला कबहुन नेहको आबे। <verse eid="GEN 31:52" /><verse number="53" style="v" sid="GEN 31:53" />अब्राहम के भगवान, नाहोर के भगवान अउ उनखर बाफ दादान के भगवान हमके न्याय करही।” याकूब के बाफ इसहाक भगवान के “भय” नाम लग पुकारिस, इहैनिता याकूब टीमा के निता ऊ नाम के निस्तार करिस। <verse eid="GEN 31:53" /><verse number="54" style="v" sid="GEN 31:54" />तब याकूब अक्ठी पसु के मारिस अउ डोंगर हे बलि के रूप हे बलि चढाइस अउ अपन मनसे के भोजन हे सामिल होमै के निता बुलाइस, भोजन करै के बाद उन डोंगर हे रात बिताइस। <verse eid="GEN 31:54" /><verse number="55" style="v" sid="GEN 31:55" />दूसर रोज सुबेन्ने लाबान अपन नाती के चुमिस अउ टोरिया के बिदा करिस, ऊ उनके आसिरवाद दइस अउ अपन घर छो लउट गय।<verse eid="GEN 31:55" /></para>
  <chapter eid="GEN 31" />
  <chapter number="32" style="c" sid="GEN 32" />
  <para style="s">याकूब के एसाव लग मिलै के तइयारी</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 32:1" />याकूब ऊ जिघा छांडे रहै, जब ऊ यातरा करत रथै, ऊ भगवान के स्वरगदूत के देखिस। <verse eid="GEN 32:1" /><verse number="2" style="v" sid="GEN 32:2" />जब याकूब उके देखथै तब ऊ बोलथै, हइ तो भगवान कर दल हबै। इहैनिता याकूब ऊ जिघा के नाम महनैम<note caller="+" style="f"><char style="fr" closed="false">32:2 </char><char style="ft" closed="false">दुइठे दल</char></note> धरिस। <verse eid="GEN 32:2" /><verse number="3" style="v" sid="GEN 32:3" />याकूब के भाई सेईर नाम परदेस हे रथै, हइ एदोम के डोंगर परदेस रथै, याकूब एसाव के लिघ्घो दूत पठोइस। <verse eid="GEN 32:3" /><verse number="4" style="v" sid="GEN 32:4" />याकूब स्वरगदूत लग कथै, “मोर मालिक एसाव के हइ संदेस दे, तुम्हर सेबक याकूब कथै, मै ई सगलू साल अबे तक लाबान के इछो परदेसी हुइके रहों। <verse eid="GEN 32:4" /><verse number="5" style="v" sid="GEN 32:5" />मोर लिघ्घो गाय गोरू छेडी, गदहा, गेडरा अउ नोकर नोकरानी हबै, मै अपन मालिक के बतामै के निता हइ संदेस पठोथो, जेहमा मै तोर किरपा नजर मोके मिलै।” <verse eid="GEN 32:5" /><verse number="6" style="v" sid="GEN 32:6" />स्वरगदूत याकूब के लिघ्घो लग लउटिस अउ कथै, “हम तुम्हर भाई एसाव के लिघ्घो गयन, ऊ तोर लग मिलै के निता अउत हबै, ओखर संग चार सव डउका हबै।” <verse eid="GEN 32:6" /><verse number="7" style="v" sid="GEN 32:7" />तब याकूब बोहत डर गइस, अउ परेसानी हे पड गय, अउ हइ सोचके अपन संगी के, अउ छेडी गेडरा, अउ गाय गोरू, उंटवा के अलगे-अलगे दुइ भाग हे कर दइस। <verse eid="GEN 32:7" /><verse number="8" style="v" sid="GEN 32:8" />याकूब सोचिस, अगर एसाव आयके अक्ठी भाग के नास करही, ता दूसर भाग के बच सकथै। <verse eid="GEN 32:8" /><verse number="9" style="v" sid="GEN 32:9" />याकूब कथै, “हे मोर बाफ अब्राहम के भगवान, हे मोर बाफ इसहाक के भगवान, तै मोके अपन देस हे लउटै के अउ अपन परवार हे आमै के निता कहे, तै कहे रथस कि तोर निक्खा करिहों। <verse eid="GEN 32:9" /><verse number="10" style="v" sid="GEN 32:10" />जउन करुना अउ सही तै अपन सेबक हे करे हबस ओखर निता मै हरमेसा अयोग्य हव, जब मै हइ यरदन नदिया पार करे रथो तब डेरा के नाम हे मोर लिघ्घो केबल अक्ठी डंडा रथै, पय अब मै एतका धनी हुइ गय हव कि मै दुइ भाग हे बांट के लउटत हव। <verse eid="GEN 32:10" /><verse number="11" style="v" sid="GEN 32:11" />किरपा करके मोके मोर भाई एसाव के हाथ लग मुकति कर, मै ओखर लग डरथो, असना झइ होय कि ऊ आयके हम सब के, लरका सहित दाय के मार डालै। <verse eid="GEN 32:11" /><verse number="12" style="v" sid="GEN 32:12" />हे भगवान, तै मोर लग कहे हबस, मै तुम्हर निक्खा करिहों, मै तुम्हर परवार के बढाहूं अउ तोर आय बाले लरका के समुन्दर के कुदरा के जसना बढाय देहुं, उन एकता हुइहिन कि गिने नेहको जाय सके।<note caller="+" style="x"><char style="xo" closed="false">32:12 </char><char style="xt" closed="false"><ref loc="GEN 22:17">उत्पति 22:17</ref></char></note>” <verse eid="GEN 32:12" /><verse number="13" style="v" sid="GEN 32:13" />याकूब रात के उहै जिघा रुकिस, याकूब कुछ चीज एसाव के भेंट दे के निता तइयार करिस। <verse eid="GEN 32:13" /><verse number="14" style="v" sid="GEN 32:14" />याकूब दुइ सव छेडी, बीस बोकडा, दुइ सव गेडरा, बीस नर गेडरा लइस। <verse eid="GEN 32:14" /><verse number="15" style="v" sid="GEN 32:15" />याकूब तीस उंटवा अउ उनखर लरका, चालीस गइया अउ दस गोरू, बीस गदही अउ दस गदहा लइस। <verse eid="GEN 32:15" /><verse number="16" style="v" sid="GEN 32:16" />याकूब पसु के हर अक्ठी झुंड नोकर के दइस, तब याकूब नोकर लग कथै, “सब पसु के हर झुंड के अलगे कर लेया, सब पसु के हर झुंड के बीच कुछ दूर रखा।” <verse eid="GEN 32:16" /><verse number="17" style="v" sid="GEN 32:17" />याकूब उनके आदेस दइस, पसु के पहिले झुंड बाले नोकर लग याकूब कथै, “मोर भाई एसाव जब तुम्हर लिघ्घो आही अउ तुम्हर लग पुछै, हइ पसु तोर सेबक याकूब के हबै? तै कछो जथस? तै केखर नोकर हबस? <verse eid="GEN 32:17" /><verse number="18" style="v" sid="GEN 32:18" />तै जबाब देबे, हइ पसु तोर सेबक याकूब के हबै, याकूब इनके अपन मालिक एसाव के भेंट के रूप हे पठोय हबै, अउ याकूब हमर पाछू आउत हबै।” <verse eid="GEN 32:18" /><verse number="19" style="v" sid="GEN 32:19" />याकूब दूसर नोकर, तीसर नोकर, अउ सगलू दूसर नोकरन के जउन झुंड के पाछू रथै, उनही इहै बात करै का आदेस दइस, ऊ कथै, “जब तुम एसाव लग मिलिहा ता इहै बात कइहा। <verse eid="GEN 32:19" /><verse number="20" style="v" sid="GEN 32:20" />तुम कइहा, हइ भेंट तुम्हर हबै, अउ तोर सेबक याकूबो मनसे के पाछू आउत हबै।” याकूब सोचिस, “अगर मै भेंट के संग हइ मनसे के आगू पठोहुं ता हइ हुइ सकथै कि एसाव मोके अपन गुस्सा के सान्त करके माफ कर दे अउ मोके स्बीकार कर ले।” <verse eid="GEN 32:20" /><verse number="21" style="v" sid="GEN 32:21" />इहैनिता याकूब एसाव के भेंट पठोइस, पय याकूब ऊ रात अपन तम्बू हे रुकिस।<verse eid="GEN 32:21" /></para>
  <para style="s">याकूब कर कुस्ती</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 32:22" />याकूब उहै रात उठिस, ऊ अपन दोनो डउकी अउ दोनो नोकर नोकरानी अउ गेराह टोरवा के लइके यब्बोक नदिया के घाट के पार करिस। <verse eid="GEN 32:22" /><verse number="23" style="v" sid="GEN 32:23" />ऊ उनके नदिया के पार छो पठोय देथै, जउन कुछु ओखर लिघ्घो रथै, उके ऊ नदिया के पार छो पठोय देथै। <verse eid="GEN 32:23" /><verse number="24" style="v" sid="GEN 32:24" />याकूब नदिया के पार करै बाले आखरी मनसे रथै, पय पार करै लग पहिले अक्ठी मनसे आइस अउ ओखर लग मल्लयुध्द करै लगिस, ऊ मनसे ओखर लग तब तक लडिस, जब तक बेरा नेहको निकल गय। <verse eid="GEN 32:24" /><verse number="25" style="v" sid="GEN 32:25" />जब ऊ मनसे देखिस कि ऊ याकूब के नेहको हराय सकथै, तब ऊ याकूब के जांघ के नस के छिस, पय ओखर लग लडत-लडत याकूब के जांघ के नस उखड गइस। <verse eid="GEN 32:25" /><verse number="26" style="v" sid="GEN 32:26" />ऊ मनसे कथै, मोके जाय दे, सुबेन्ने होत हबै, याकूब कथै, जब तक तै मोके आसिरवाद नेहको दइहे, मै तोके नेहको जाय दइहों। <verse eid="GEN 32:26" /><verse number="27" style="v" sid="GEN 32:27" />ऊ पूंछिस, “तोर नाम का हबै?” ऊ जबाब देथै, “याकूब।” <verse eid="GEN 32:27" /><verse number="28" style="v" sid="GEN 32:28" />तब ऊ कहिस, अब तोर नाम याकूब नेहको होही, पय “इस्राएल” होही काखे तै भगवान अउ मनसे लग लडके जीत पाय हबस। <verse eid="GEN 32:28" /><verse number="29" style="v" sid="GEN 32:29" />तब याकूब ओखर लग ओखर नाम पूंछिस, पय ऊ मनसे कथै, “तै मोर नाम काखे पूंछथस?” ऊ टेम ऊ मनसे याकूब के आसिरवाद दइस। <verse eid="GEN 32:29" /><verse number="30" style="v" sid="GEN 32:30" />इहैनिता याकूब ऊ जिघा के नाम पनीएल धरिस याकूब कथै, “ई जिघा मै भगवान के पूर रूप लग देखे हव, तउभरमा मोर जीवन बच गय हबै।” <verse eid="GEN 32:30" /><verse number="31" style="v" sid="GEN 32:31" />ओसनेन ऊ पनीएल लग गुजरिस, तब बेरा निकर आइस, याकूब अपन गोड के कारन लंगराय के चलत रहै। <verse eid="GEN 32:31" /><verse number="32" style="v" sid="GEN 32:32" />इस्राएली जउन पसु के जांघ के जोड बाले जांघ नस के आज के दिन तक नेहको खाथै, एखर कारन इहै हबै कि ऊ डउका याकूब के जांघ के जोड हे जांघ के नस के छिय रथै।<verse eid="GEN 32:32" /></para>
  <chapter eid="GEN 32" />
  <chapter number="33" style="c" sid="GEN 33" />
  <para style="s">याकूब अउ एसाव के मिलन होथै</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 33:1" />याकूब अपन आंख उप्पर उठाइस ता देखथै एसाव अउत हबै, अउ ओखर संग चार सव डउका हबै, ऊ लिया, राहेल अउ दोनोझन नोकरानी के उनखर लरका सउप दइस। <verse eid="GEN 33:1" /><verse number="2" style="v" sid="GEN 33:2" />ऊ सब लग आगू दोनो नोकरानी अउ उनखर लरका के, उनखर पाछू लिया के ओखर लरका के संग, अउ सब लग पाछू राहेल अउ यूसुफ के ठाढ करिस। <verse eid="GEN 33:2" /><verse number="3" style="v" sid="GEN 33:3" />याकूब आगू-आगू गइस, जब तक ऊ अपन भाई के लिघ्घो नेहको पहुंच गइस, तब तक ऊ भुंइ हे झुकके सात बेर ओखर सोगत करत रहिस। <verse eid="GEN 33:3" /><verse number="4" style="v" sid="GEN 33:4" />तब एसाव याकूब के देखिस, ऊ ओखर लग मिलै के निता दउर पडिस, एसाव याकूब के अपन बांह हे भर लइस, अउ छाती लग लगाइस, तब एसाव ओही चुमिस अउ दोनोझन खुसी के मारे रोय पडिन। <verse eid="GEN 33:4" /><verse number="5" style="v" sid="GEN 33:5" />जब एसाव देखिस ता डउकी अउ लरकन के, एसाव पूंछथै, “तुम्हर संग हइ कोन मनसे हबै?” याकूब जबाब देथै, “हइ ऊ लरका हबै जउन भगवान मोके दय हबै, भगवान मोर उप्पर दया करे हबै।” <verse eid="GEN 33:5" /><verse number="6" style="v" sid="GEN 33:6" />तब दोनो डउकी अपन लरका के संग एसाव के लिघ्घो गइन, उन ओही झुकके परनाम करिन। <verse eid="GEN 33:6" /><verse number="7" style="v" sid="GEN 33:7" />तब लिया अपन लरका के संग एसाव के आगू गइस अउ ऊ परनाम करिस अउ तब राहेल अउ यूसुफ एसाव के आगू गइन अउ उन परनाम करिन। <verse eid="GEN 33:7" /><verse number="8" style="v" sid="GEN 33:8" />एसाव कथै, “मै जउन सब मनसे के इहां आउत टेम देखे रहों ऊ कोन आय? अउ ऊ सगलू पसु केखर निता आय?” याकूब जबाब देथै, “ऊ तोके देय निता मोर भेंट आय जेखर लग तै मोके स्बीकार कर सकस।” <verse eid="GEN 33:8" /><verse number="9" style="v" sid="GEN 33:9" />पय एसाव कथै, “भाई, मोके कउनो भेंट नेहको चाही, काखे मोर लिघ्घो सब कुछ हबै।” <verse eid="GEN 33:9" /><verse number="10" style="v" sid="GEN 33:10" />याकूब कथै, “नही, मै तोर लग बिनती करथो, अगर तै सहीमा मोके स्बीकार करथस ता किरपा करके जउन भेंट देथो तै स्बीकार कर, मै तोके दुबारा देख के बोहत खुस हव, हइ तो भगवान के देखै जसना हबै, मै हइ देखके बोहत खुस हव कि तै मोके स्बीकार करे हबस।” <verse eid="GEN 33:10" /><verse number="11" style="v" sid="GEN 33:11" />जउन भेंट तुम्हर लिघ्घो लाय गय हबै, उके स्बीकार कर, भगवान मोर उप्पर बोहत अनुगरह करे हबै मोर लिघ्घो बोहत हबै, हइ मेर याकूब ओखर लग बिनती करिस, तब एसाव ओखर भेंट के स्बीकार करिस। <verse eid="GEN 33:11" /><verse number="12" style="v" sid="GEN 33:12" />एसाव कथै, “आबा हम अपन रास्ता हे बढ चली, मै तुम्हर संग चलिहों।” <verse eid="GEN 33:12" /><verse number="13" style="v" sid="GEN 33:13" />पय याकूब ओखर लग कथै, “हे मोर परभु तै हइ जानथस कि मोर लरका कमजोर हबै अउ मोके अपन झुंड अउ लरका के खास करके देख रेख करैका जरूरी हबै, अगर मै उनके बोहत दुरिहां अक रोज हे चलै के कइहों ता सगलू पसु, गेडरा, छेडी मर जइहिन। <verse eid="GEN 33:13" /><verse number="14" style="v" sid="GEN 33:14" />इहैनिता मोर परभु तुम आगू चला अउ मै धीरे-धीरे तुम्हर पाछू आहुं, मै पसु अउ दूसर पसु के रक्छा के निता बोहत धीरे-धीरे बढिहों अउ मै बोहत धीरे-धीरे इहैनिता चलिहों, कि मोर लरका बोहत जादा थक झइ जाय, मै सेईर सहर हे तुम्हर लग मिलहों।” <verse eid="GEN 33:14" /><verse number="15" style="v" sid="GEN 33:15" />इहैनिता एसाव कथै, “तब मै अपन कुछ संगी के तुम्हर मदत के निता छांड देहुं।” पय याकूब कथै, “मोर परभु कर बिसेस दया हबै, पय असना करै के कउनो जरूरत नेहको हबै।” <verse eid="GEN 33:15" /><verse number="16" style="v" sid="GEN 33:16" />इहैनिता ऊ रोज एसाव सेईर सहर छो कढ गइस। <verse eid="GEN 33:16" /><verse number="17" style="v" sid="GEN 33:17" />पय याकूब उहां लग निकडके सुक्कोत इलाका छो गइस, अउ उहां अपन निता अक्ठी घर अउ पसु के निता सार बनाइस, इहै कारन ऊ जिघा के नाम सुक्कोत रखिस। <verse eid="GEN 33:17" /><verse number="18" style="v" sid="GEN 33:18" />बाद हे याकूब जउन पद्दनराम लग आय रथै, उके कनान परदेस लग सकेम सहर छो पठोय दइस, याकूब सहर के लिघ्घो पटाउरा हे अपन डेरा डालिन। <verse eid="GEN 33:18" /><verse number="19" style="v" sid="GEN 33:19" />याकूब ऊ जमीन के सकेम के बाफ हमोर के परवार लग खरीदिस, याकूब चांदी के एक सव सिक्का दइस।<note caller="+" style="x"><char style="xo" closed="false">33:19 </char><char style="xt" closed="false"><ref loc="JHN 4:5">यूहन्ना 4:5</ref></char></note> <verse eid="GEN 33:19" /><verse number="20" style="v" sid="GEN 33:20" />याकूब भगवान के उपास के निता उहां खास करके अक्ठी खम्भा ठाढ करिस अउ ओखर नाम एल-एलोहे<note caller="+" style="f"><char style="fr" closed="false">33:20 </char><char style="ft" closed="false">इस्राएल के भगवान सक्तिसाली हबै</char></note>-इस्राएल रखिस।<verse eid="GEN 33:20" /></para>
  <chapter eid="GEN 33" />
  <chapter number="34" style="c" sid="GEN 34" />
  <para style="s">दीना के भ्रस्ट करे जायका</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 34:1" />अक रोज लिया के टोरिया दीना, जेही ऊ याकूब के दवारा पइदा करे रथै, कनान देस के टोरियन लग मिलै के निता गइस। <verse eid="GEN 34:1" /><verse number="2" style="v" sid="GEN 34:2" />ऊ परदेस के राजा के नाम हमोर रथै, हमोर के टोरवा के नाम सकेम रथै, ऊ हिव्वी जात के रथै, जब सकेम दीना के देखथै तब उके पकड लथै, ऊ ओखर संग सोइस अउ ओखर संग गलट काम करिस। <verse eid="GEN 34:2" /><verse number="3" style="v" sid="GEN 34:3" />तब ओखर मन याकूब कर बिटिया सकेम दीना लग माया करे लगिस अउ ओखर लग काज करै के चाहथै। <verse eid="GEN 34:3" /><verse number="4" style="v" sid="GEN 34:4" />सकेम अपन बाफ हमोर लग कहिस, मोके हइ टोरिया डउकी के रूप हे परदान कर। <verse eid="GEN 34:4" /><verse number="5" style="v" sid="GEN 34:5" />याकूब सुनिस कि सकेम ओखर टोरिया दीना के संग गलत काम करे हबै, ऊ टेम ओखर टोरवा पसु के संग पटाउरा हे गय रथै, इहैनिता उन जब तक नेहको आय, तब तक याकूब कुछु नेहको करिस। <verse eid="GEN 34:5" /><verse number="6" style="v" sid="GEN 34:6" />सकेम के बाफ हमोर याकूब लग बातचीत करै के निता ओखर लिघ्घो आइस। <verse eid="GEN 34:6" /><verse number="7" style="v" sid="GEN 34:7" />जब याकूब कर टोरवा ओखर बारे हे सुनिन तब ऊ बोहत दुख हुइन, ऊ पटाउरा लग आइन, उन बोहत गुस्सा हे रथै, काखे सकेम याकूब के टोरिया के संग गलत काम करके इस्राएली समाज हे मूरख के काम करे रथै, असना काम नेहको करै के चाही। <verse eid="GEN 34:7" /><verse number="8" style="v" sid="GEN 34:8" />पय हमोर भाइन लग बात करिस, ऊ कथै, “मोर टोरवा सकेम दीना लग बोहत माया करथै, किरपा करके उके एखर संग काज करन देया। <verse eid="GEN 34:8" /><verse number="9" style="v" sid="GEN 34:9" />हमर लग काज सम्बन्ध सुरु करा, अपन टोरिया हमके देया, हमर टोरिया तुम लेया। <verse eid="GEN 34:9" /><verse number="10" style="v" sid="GEN 34:10" />तब तुम हइ देस हे रहि सकही, एखर दूरा तुम्हर निता खुल जही, इहां रहा अउ धन्धा करा, धन डेरा कमाबा।” <verse eid="GEN 34:10" /><verse number="11" style="v" sid="GEN 34:11" />सकेम याकूब अउ भाई लग बात करिस, सकेम कथै, “किरपा करके मोके स्बीकार करा, अउ मै जउन करे हव ओखर निता माफ कर देया, मोके जउन कुछ तुम करै के निता कइहा, मै उहै करिहों। <verse eid="GEN 34:11" /><verse number="12" style="v" sid="GEN 34:12" />तुम जेतका भेंट मंगिहा मै देहुं, अगर मोके तुम दीना लग काज करै दइहा।” <verse eid="GEN 34:12" /><verse number="13" style="v" sid="GEN 34:13" />याकूब कर टोरवा सकेम अउ ओखर बाफ हमोर लग झूठ बोलै के ठान लय रहै, काखे सकेम उनखर बेहन दीना के संग गलत काम करे रथै। <verse eid="GEN 34:13" /><verse number="14" style="v" sid="GEN 34:14" />इहैनिता भाई उनखर लग कथै, “हम तोके अपन बेहन के संग काज नेहको करन देब काखे तुम्हर खलरी के खतना<note caller="+" style="f"><char style="fr" closed="false">34:14 </char><char style="ft" closed="false">सरीर के अक्ठी अंग कर सुध्दिकरन हुइ</char></note> नेहको होय हबै, काखे ऊ हमर निता बुराई के बात होही। <verse eid="GEN 34:14" /><verse number="15" style="v" sid="GEN 34:15" />हम केबल ई सर्त हे तुम्हर बात स्बीकार कर सकथन कि तुमो हमर जसना खतना बाले बनिहा, तुम्हर हर मनसे के खतना करे जाय। <verse eid="GEN 34:15" /><verse number="16" style="v" sid="GEN 34:16" />तब हम अपन टोरिया तुमके देब अउ तुम्हर टोरिया हम लेब, हम तुम्हर संग रहिबे अउ हम सब एकै जात बन जइबे। <verse eid="GEN 34:16" /><verse number="17" style="v" sid="GEN 34:17" />पय अगर तुम हमर बात नेहको सुनिहा, अउ खतना नेहको कराइहा ता हम अपन टोरिया के लइके इहां लग कढ जइबे।” <verse eid="GEN 34:17" /><verse number="18" style="v" sid="GEN 34:18" />उनखर बात लग हमोर अउ ओखर टोरवा सकेम खुस हुइ जथै। <verse eid="GEN 34:18" /><verse number="19" style="v" sid="GEN 34:19" />सकेम उनखर मांग के पूर करै हे देरी नेहको करिस, काखे ऊ याकूब के टोरिया के बोहत चाहथै, ऊ अपन बाफ के सगलू परवार हे सब लग जादा ईज्जतदार मनसे रथै। <verse eid="GEN 34:19" /><verse number="20" style="v" sid="GEN 34:20" />हमोर अउ ओखर टोरवा सकेम सहर हे परवेस दूरा हे आइन, उन सहर के निबासी लग कथै, <verse eid="GEN 34:20" /><verse number="21" style="v" sid="GEN 34:21" />“इस्राएल के हइ मनसे संगी बनै चाहथै, हम उनके अपन परदेस हे रहै दे चाहथन अउ अपन संग सान्ति बनाय रखै चाहथन, हमर लिघ्घो हम सब के निता बोहत जमीन हबै, हम इनखर टोरिया के संग काज करै के आजाद हवन अउ हम अपन टोरिया उनखर संग काज के निता दे हे खुस हवन। <verse eid="GEN 34:21" /><verse number="22" style="v" sid="GEN 34:22" />हइ एकै बात हे हमर संग रहै के लिता अकजुट होय हवन, कि हम सगलू डउकन के खतना करे जाय, जसना उनखर करे जथै, कि हम सगलू अकजुट हुइ जइ। <verse eid="GEN 34:22" /><verse number="23" style="v" sid="GEN 34:23" />तब इनखर पसु, इनखर धन अउ इनखर सगलू पसु हमारै हुइ जइहिन, बस हम उनखर इहां अकजुट हुइ जइ, कि ऊ हमर संग निबास करै लगे।” <verse eid="GEN 34:23" /><verse number="24" style="v" sid="GEN 34:24" />सहर के परवेस दूरा हे आय सगलू मनसे हमोर अउ ओखर टोरवा सकेम के बात मान लइन, हर मनसे जउन सहर के दूरा हे आय रथै, अपन खतना करवइहिन। <verse eid="GEN 34:24" /><verse number="25" style="v" sid="GEN 34:25" />तीन रोज बात खतना कर दय गइन अउ मनसे पीरा हे रथै, याकूब के दुइठे टोरवा जउन दीना कर भाइ रथै, सिमोन अउ लेवी जानत रथै कि ई टेम मनसे कमजोर हुइहिन, इहैनिता ऊ सहर छो गइन अउ उन सगलू डउकन के मार डालिन। <verse eid="GEN 34:25" /><verse number="26" style="v" sid="GEN 34:26" />दीना के भाई सिमोन अउ लेवी हमोर अउ ओखर टोरवा के मार डालिन, उन दीना के सकेम के घर लग निकार लइन अउ उन चले आइन। <verse eid="GEN 34:26" /><verse number="27" style="v" sid="GEN 34:27" />याकूब के दूसर टोरवा सहर हे गइन अउ उन उहां जउन कुछु रथै, लूट लइन, सकेम उनखर बेहन के संग गलत काम करे रथै, ओखर लग तब तक गुस्सा रथै। <verse eid="GEN 34:27" /><verse number="28" style="v" sid="GEN 34:28" />इहैनिता भाई उनखर सगलू पसु छेडी लइ लइन, उन उनखर गदहा अउ सहर अउ खेतवा हे जउन कुछु रथै सब कुछ लइ लइन। <verse eid="GEN 34:28" /><verse number="29" style="v" sid="GEN 34:29" />उनखर धन डेरा, उनखर गाय गोरू बाल बच्चा, उनखर डउकी अउ जउन कुछु उनखर घरन हे रथै सगलू के लूटके अपन हक हे कर लइन। <verse eid="GEN 34:29" /><verse number="30" style="v" sid="GEN 34:30" />पय याकूब सिमोन अउ लेवी लग कथै, “तुम मोके बोहत दुख दय हबा, अउ ई परदेस के निबासी के मन हे घ्रना पइदा कराय दय हबा, सगलू कनानी अउ परिज्जी मनसे हमर बिरोध हुइ जइहिन, इहां हम छुटुहस मनसे हवन, अगर ई परदेस के मनसे हमर बिरोध लडै के निता अकजुट हुइहिन, ता मै नास हुइ जइहों अउ हमर संग हमर सगलू मनसे नास हुइ जइहिन।” <verse eid="GEN 34:30" /><verse number="31" style="v" sid="GEN 34:31" />पय भाई जबाब देथै, “का हम उनही अपन बेहन के संग बेस्या जसना बेउहार करन दइ?”<verse eid="GEN 34:31" /></para>
  <chapter eid="GEN 34" />
  <chapter number="35" style="c" sid="GEN 35" />
  <para style="s">बेतेल सहर हे याकूब के आसीस मिलथै</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 35:1" />तब भगवान याकूब लग कथै, “बेतेल सहर छो जा, उहां बस जा अउ उहां उपास के बेदी बना, भगवान के सुरता कर, ऊ जउन तुम्हर आगू परगट होय रथै, जब तै अपन भाई एसाव लग बचाय के भागत रहस, ऊ भगवान के उपास के निता उहां बेदी बना।” <verse eid="GEN 35:1" /><verse number="2" style="v" sid="GEN 35:2" />तब याकूब अपन परवार अउ उन सगलू मनसे लग जउन ओखर संग रथै, “तुम्हर बीच हे दूसर जात के देबी देउता हबै, उनके हटाय देया अउ खुद के सुध्द करा, अपन कपडा के बदल डाला। <verse eid="GEN 35:2" /><verse number="3" style="v" sid="GEN 35:3" />हम ई जिघा के छांडब अउ बेतेल छो जइबे, ऊ जिघा हे अपन भगवान के निता अक्ठी बेदी बनाइबे, हइ इहै भगवान हबै जउन मोर परेसानी के टेम हे मोर मदत करिस अउ जिहां कहुं मै गयों ऊ मोर संग रहिस।” <verse eid="GEN 35:3" /><verse number="4" style="v" sid="GEN 35:4" />इहैनिता मनसे के लिघ्घो जउन ठगरा देउता रथै, उन सगलू के उन याकूब के दइ देथै उन अपन कानन हे पहिने हर सगलू बाली के याकूब के दइ देथै, याकूब सकेम नाम के सहर के लिघ्घो अक्ठी सिन्दूर कर रूख के तरी हइ सगलू चीजन के गाड दइस। <verse eid="GEN 35:4" /><verse number="5" style="v" sid="GEN 35:5" />याकूब अउ ओखर टोरवा ऊ जिघा के छांड दइन, ऊ इलाका सहर कर मनसे उनखर पीछा करै चाहथै, अउ उनके मार डालै चाहथै पय उनखर मन हे भगवान असना डर समुवाय दइस कि उन याकूब के पीछा नेहको करिन। <verse eid="GEN 35:5" /><verse number="6" style="v" sid="GEN 35:6" />इहैनिता याकूब अउ ओखर मनसे लूज सहर छो पहुंचिन, अब लूज सहर के बेतेल सहर कथै, हइ कनान परदेस हे हबै। <verse eid="GEN 35:6" /><verse number="7" style="v" sid="GEN 35:7" />याकूब उहां अक्ठी बेदी बनाइस, याकूब ऊ जिघा के नाम “एलबेतेल” रखिस, याकूब ई नाम के इहैनिता चुनिस कि जब ऊ अपन भाई के इहां लग भागत रहै, तब पहली बेर भगवान इहां परगट होय रथै। <verse eid="GEN 35:7" /><verse number="8" style="v" sid="GEN 35:8" />उहै टेम रिबका के दाय के दबोरा के मिरतू हुइ गइस, उके बेतेल के बाहिर बांझ रूख के तरी गाड दइन, ऊ रूख कर नाम अल्लोनबक्कूत रखे गइस। <verse eid="GEN 35:8" /><verse number="9" style="v" sid="GEN 35:9" />जब याकूब पद्दनराम इलाका लग लउटिस तब भगवान फेरै ओखर आगू परगट हुइस, भगवान याकूब के आसिरवाद दइस। <verse eid="GEN 35:9" /><verse number="10" style="v" sid="GEN 35:10" />भगवान याकूब लग कथै, “तोर नाम याकूब हबै, पय मै ऊ नाम के बदलिहों, अब तै याकूब नेहको कहाबे, तोर नबा नाम इस्राएल होही।” इहैनिता एखर बाद याकूब के नाम इस्राएल हुइस। <verse eid="GEN 35:10" /><verse number="11" style="v" sid="GEN 35:11" />फेर भगवान ओखर लग कथै, “मै सक्तिमान भगवान हव, तै फल फूल अउ बढा, अउ तोर लग मनसेन के अक्ठी मंडली पइदा होही, अउ तोर वंस हे राजा पइदा हुइही। <verse eid="GEN 35:11" /><verse number="12" style="v" sid="GEN 35:12" />मै अब्राहम अउ इसहाक के खास भुंइ दय रथो, अब ऊ भुंइ मै तुमके देथो।” <verse eid="GEN 35:12" /><verse number="13" style="v" sid="GEN 35:13" />तब भगवान ऊ जिघा लग जिहां ऊ याकूब लग बात करे रथै, तब भगवान ऊ जिघा के छांड दइस। <verse eid="GEN 35:13" /><verse number="14" style="v" sid="GEN 35:14" />याकूब ऊ जिघा हे, जिहां भगवान ओखर लग बात करे रथै, पथरा के अक्ठी खम्भा ठाढ करिस, ऊ ओखर उप्पर दाखरस उंडेलिस। <verse eid="GEN 35:14" /><verse number="15" style="v" sid="GEN 35:15" />जिहां भगवान याकूब लग बात करिस, ऊ जिघा के नाम ऊ बेतेल रखिस।<verse eid="GEN 35:15" /></para>
  <para style="s">राहेल कर मिरतू</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 35:16" />एखर बाद याकूब अउ ओखर परवार बेतेल सहर लग गइन, जब ऊ एप्राता सहर लग कुछ दुरिहां रथै तब राहेल के लरका पइदा करै के पीरा उमडै लगिस, उके बोहत पीरा रथै। <verse eid="GEN 35:16" /><verse number="17" style="v" sid="GEN 35:17" />पय राहेल के बोहत जादा कस्ट होमै लगिस, उके बोहत दरद होथै, राहेल के दाय उके देखिस अउ कथै, “राहेल, झइ डेरा, तै अक्ठी टोरवा के पइदा करिहे।” <verse eid="GEN 35:17" /><verse number="18" style="v" sid="GEN 35:18" />ऊ टोरवा के पइदा करत टेम मर गइस, मरै के पहिलेन राहेल लरका के नाम बेनोनी<note caller="+" style="f"><char style="fr" closed="false">35:18 </char><char style="ft" closed="false">मोर दुख के टोरवा</char></note> रखिस, पय याकूब ओखर नाम बिन्यामीन<note caller="+" style="f"><char style="fr" closed="false">35:18 </char><char style="ft" closed="false">दख्खिन इलाका कर टोरवा</char></note> रखिस। <verse eid="GEN 35:18" /><verse number="19" style="v" sid="GEN 35:19" />राहेल के मिरतू हुइ गय, उके एप्राता मतलब बैतलहम के रास्ता हे गाडे गइस। <verse eid="GEN 35:19" /><verse number="20" style="v" sid="GEN 35:20" />याकूब ओखर मरघटी हे अक्ठी खम्भा ठाढ करिस, उके राहेल के मरघटी के खम्भा कथै, ऊ आजो उहां ठाढ हबै। <verse eid="GEN 35:20" /><verse number="21" style="v" sid="GEN 35:21" />तब याकूब<note caller="+" style="f"><char style="fr" closed="false">35:21 </char><char style="ft" closed="false">इस्राएल</char></note> अपन यातरा सुरु करथै, ऊ एदेर खम्भा के ठीक दख्खिन हे डेरा धरिस।<verse eid="GEN 35:21" /></para>
  <para style="s">याकूब कर बाराठे टोरवा</para>
  <para style="r">(<ref loc="1CH 2:1-2">1 इति 2:1-2</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 35:22" />उहां इस्राएल चुटुहस टेम ठहरिस, जब ऊ उहां रथै तब रूबेन इस्राएल के दासी रखेल बिल्हा के संग सोइस, इस्राएल हइ बारे हे सुनिस ता बोहत गुस्साइस, अउ याकूब कर बारहठे टोरवा रथै। <verse eid="GEN 35:22" /><verse number="23" style="v" sid="GEN 35:23" />ओखर डउकी लिया लग मतलब याकूब कर छयठे टोरवा रथै, रूबेन, सिमोन, लेवी, यहूदा, इस्साकार, जबूलून। <verse eid="GEN 35:23" /><verse number="24" style="v" sid="GEN 35:24" />ओखर डउकी राहेल लग ओखर दुइठे टोरवा रथै, यूसुफ, बिन्यामीन। <verse eid="GEN 35:24" /><verse number="25" style="v" sid="GEN 35:25" />राहेल के दासी बिल्हा लग ओखर दुइठे टोरवा रथै, दान, नप्ताली। <verse eid="GEN 35:25" /><verse number="26" style="v" sid="GEN 35:26" />अउ लिया के दासी जिल्पा लग ओखर दुइठे टोरवा रथै, गाद, आसेर, हइ याकूब के टोरवा हबै जउन पद्दनराम इलाका हे पइदा होय रथै।<verse eid="GEN 35:26" /></para>
  <para style="s">इसहाक कर मिरतू</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 35:27" />याकूब अपन बाफ के लिघ्घो मम्रे सहर हे, जउन किर्यतर्बा मतलब कि हेब्रोन सहर हबै, उहां अब्राहम अउ इसहाक परदेसी बनके रहे करथै, अपन बाफ इसहाक के लिघ्घो आइस।<note caller="+" style="x"><char style="xo" closed="false">35:27 </char><char style="xt" closed="false"><ref loc="HEB 11:9">इब्रानिन 11:9</ref>; <ref loc="GEN 13:18">उत्पति 13:18</ref></char></note> <verse eid="GEN 35:27" /><verse number="28" style="v" sid="GEN 35:28" />जब इसहाक के एक सव अस्सी साल के हुइस। <verse eid="GEN 35:28" /><verse number="29" style="v" sid="GEN 35:29" />तब इसहाक बोहत साल तक जिन्दा रहिस, तब ऊ बोहत डोकराय जथै, तब ऊ मर गइस, ओखर टोरवा एसाव अउ याकूब उके गाडिन जिहां ओखर बाफ के गाडे गय रथै।<verse eid="GEN 35:29" /></para>
  <chapter eid="GEN 35" />
  <chapter number="36" style="c" sid="GEN 36" />
  <para style="s">एसाव कर परवार</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 36:1" />एसाव जउन एदोमो कहाथै, ओखर हइ परवार हबै।<note caller="+" style="x"><char style="xo" closed="false">36:1 </char><char style="xt" closed="false"><ref loc="1CH 1:34-37">1 इति 1:34-37</ref></char></note> <verse eid="GEN 36:1" /><verse number="2" style="v" sid="GEN 36:2" />एसाव कनान देस के टोरिया लग काज करे रथै, हइ ओखर डउकी रथै, हित्ती जात के एलोन के टोरिया आदा, ओहोलीबामा हिव्वी सिबोन के नतिनिया अउ अना के टोरिया।<note caller="+" style="x"><char style="xo" closed="false">36:2 </char><char style="xt" closed="false"><ref loc="GEN 26:34">उत्पति 26:34</ref></char></note> <verse eid="GEN 36:2" /><verse number="3" style="v" sid="GEN 36:3" />फेर ऊ इस्माइल के टोरिया बासमत के, जउन नबायोत के बेहन रथै, काज कर लइस।<note caller="+" style="x"><char style="xo" closed="false">36:3 </char><char style="xt" closed="false"><ref loc="GEN 28:9">उत्पति 28:9</ref></char></note> <verse eid="GEN 36:3" /><verse number="4" style="v" sid="GEN 36:4" />आदा एसाव के अक्ठी टोरवा एलीपज के दइस बासमत के रूएल नाम अक्ठी टोरवा के पइदा करिस। <verse eid="GEN 36:4" /><verse number="5" style="v" sid="GEN 36:5" />अउ ओहोलीबामा यूस, अउ यालाम, कोरह के पइदा करिस, इहै एसाव के टोरवा हबै, जउन उके कनान देस हे पइदा होय रथै। <verse eid="GEN 36:5" /><verse number="6" style="v" sid="GEN 36:6" />एसाव अपन डउकी, टोरिया टोरवा, अपन परवार के सगलू मनसे, पाले बाले पसु, गाय, गोरू, गेडरा छेडी, अउ कनान देस हे जउन अकजुट करे रथै अपन सगलू डेरा के लइके अपन भाई याकूब के लिघ्घो दूसर देस छो कढ जथै। <verse eid="GEN 36:6" /><verse number="7" style="v" sid="GEN 36:7" />उन दोनोन के लिघ्घो एतका डेरा हुइ गय रथै, कि उन अक संग नेहको रह सकथै, जउन देस हे परवेस करत रहै, ऊ दोनो के नेहको समाय सकथै, काखे उनखर लिघ्घो बोहत पसु रथै। <verse eid="GEN 36:7" /><verse number="8" style="v" sid="GEN 36:8" />एसाव सेईर परदेस डोंगर हे जाय के बस गय, एसाव के एदोमो कथै। <verse eid="GEN 36:8" /><verse number="9" style="v" sid="GEN 36:9" />एसाव एदोम मनसे के मूल बाफ हबै, सेईर एदोम के डोंगर परदेस हे रहैबाले एसाव के परवार के हइ नाम हबै। <verse eid="GEN 36:9" /><verse number="10" style="v" sid="GEN 36:10" />हइ एसाव के टोरवन के नाम हबै, एसाव के डउकी आदा के टोरवा एलीपज एसाव के दूसर डउकी बासमत के टोरवा रूएल रथै। <verse eid="GEN 36:10" /><verse number="11" style="v" sid="GEN 36:11" />हइ एलीपज के पांच टोरवा हबै, तेमान ओमार, सपो, गाताम अउ कनज। <verse eid="GEN 36:11" /><verse number="12" style="v" sid="GEN 36:12" />एलीपज के अक्ठी तिम्ना नाम के दासी रखेल रथै, ऊ एलीपज लग अमालेक के पइदा करिस, एसाव के डउकी आदा के इहै टोरवा हबै। <verse eid="GEN 36:12" /><verse number="13" style="v" sid="GEN 36:13" />हइ रूएल के टोरवा हबै, नहत, जेरह, सम्मा, अउ मिज्जा, एसाव के डउकी बासमत के इहै टोरवा हबै। <verse eid="GEN 36:13" /><verse number="14" style="v" sid="GEN 36:14" />एसाव के डउकी ओहोलीबामा के जउन सिबोन के नतिनिया अउ अना के टोरिया रथै, हइ टोरवा हबै, ऊ एसाव लग यूस, यालाम अउ कोरह के पइदा करिस। <verse eid="GEN 36:14" /><verse number="15" style="v" sid="GEN 36:15" />एसाव लग चले बाले परवार इहै हबै, एसाव के पहिला टोरवा एलीपज रथै, एलीपज लग आइस, तेमान, ओमार, सपो, कनज, <verse eid="GEN 36:15" /><verse number="16" style="v" sid="GEN 36:16" />कोरह, गाताम, अमालेक, एलीपज, एदोम देस हे हइ सगलू परवार एसाव के डउकी आदा लग आइन। <verse eid="GEN 36:16" /><verse number="17" style="v" sid="GEN 36:17" />एसाव के टोरवा रूएल हइ परवार के मूल बाफ रथै, नहत, जेरह, सम्मा, मिज्जा, एदोम देस मसे हइ सगलू परवार एसाव के डउकी बासमत लग आइन। <verse eid="GEN 36:17" /><verse number="18" style="v" sid="GEN 36:18" />हइ एसाव के डउकी ओहोलीबामा के परवार हबै, जउन मुखिया हुइन, यूस, यालाम अउ कोरह, एसाव के डउकी अउ अना के टोरिया ओहोलीबामा लग इहै परवार हबै। <verse eid="GEN 36:18" /><verse number="19" style="v" sid="GEN 36:19" />इहै एसाव मतलब एदोम के परवार अउ उनखर मुखिया हबै।<verse eid="GEN 36:19" /></para>
  <para style="s">सेईर के परवार</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 36:20" />एसाव के पहिले एदोम देस हे सेईर नाम अक्ठी होरी मनसे रहथै, सेईर कर टोरवा हइ हबै, लोतान, सोबाल, सिबोन, अना, <verse eid="GEN 36:20" /><verse number="21" style="v" sid="GEN 36:21" />दीसोन, एसेर, अउ दीसान, एदोम देस हे सेईर कर हइ होरी टोरवा अपन परवार के मुखिया रथै। <verse eid="GEN 36:21" /><verse number="22" style="v" sid="GEN 36:22" />लोतान, होरी हेमाम के बाफ रथै, तिम्ना लोतान के बेहन रथै। <verse eid="GEN 36:22" /><verse number="23" style="v" sid="GEN 36:23" />हइ सोबाल के हइ टोरवा हुइन, आल्वान, मानहत, एबाल, सपो, अउ ओनाम। <verse eid="GEN 36:23" /><verse number="24" style="v" sid="GEN 36:24" />हइ सिबोन कर टोरवा हबै, अय्या अउ अना, हइ उहै अना हबै, जउन अपन बाफ सिबोन के गदहा के चराउत टेम पतेरा छो तात पानी के झरना पाय रथै। <verse eid="GEN 36:24" /><verse number="25" style="v" sid="GEN 36:25" />हइ अना कर टोरवा हबै, दीसोन टोरवा, ओहोलीबामा टोरिया। <verse eid="GEN 36:25" /><verse number="26" style="v" sid="GEN 36:26" />दीसान कर चारठे टोरवा रथै, हेमदान, एस्बान, सितरान अउ करान। <verse eid="GEN 36:26" /><verse number="27" style="v" sid="GEN 36:27" />हइ एसेर कर टोरवा हबै, बिल्हान, जावान अउ अकान। <verse eid="GEN 36:27" /><verse number="28" style="v" sid="GEN 36:28" />हइ दीसान कर टोरवा हबै, ऊस, अरान। <verse eid="GEN 36:28" /><verse number="29" style="v" sid="GEN 36:29" />हइ होरी जात के मुखिया हुइन, लोतान, सिबोन, सोबाल, अना, <verse eid="GEN 36:29" /><verse number="30" style="v" sid="GEN 36:30" />दीसोन, एसेर, दीसान, हइ मनसे उन परवार के मुखिया रथै जउन सेईर देस हे होरी रथै।<verse eid="GEN 36:30" /></para>
  <para style="s">एदोम कर राजा</para>
  <para style="r">(<ref loc="1CH 1:43-54">1 इति 1:43-54</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 36:31" />ऊ टेम एदोम देस हे कइठे राजा रथै, इस्राएल हे राजा के होमै के बोहत पहिले एदोम देस हे राजा रथै। <verse eid="GEN 36:31" /><verse number="32" style="v" sid="GEN 36:32" />बोर कर टोरवा बेला एदोम देस हे राज करिस, अउ ओखर राजधानी के नाम दिन्हाबा हबै। <verse eid="GEN 36:32" /><verse number="33" style="v" sid="GEN 36:33" />जब बेला मरिस, तब बोस्रा सहर के रहै बाले जेरह कर टोरवा योबाब ओखर जिघा हे राज करिस। <verse eid="GEN 36:33" /><verse number="34" style="v" sid="GEN 36:34" />जब योबाब मरिस तब तेमानी जात के देस के निबासी हूसाम ओखर जिघा हे राज करिस। <verse eid="GEN 36:34" /><verse number="35" style="v" sid="GEN 36:35" />हूसाम मरिस तब बदद कर टोरवा हदद ओखर जिघा हे राज करिस, हइ उहै हबै जउन मिदयानियन के मोवाब के देस हे हराय रथै, अउ ओखर राजधानी के नाम अबीत हबै। <verse eid="GEN 36:35" /><verse number="36" style="v" sid="GEN 36:36" />जब हदद मरिस तब मस्रेकावासी सम्ला ओखर जिघा हे राज करिस। <verse eid="GEN 36:36" /><verse number="37" style="v" sid="GEN 36:37" />जब सम्ला मरिस तब साउल जउन महानद के तटबाले रहोबोत सहर के रथै, ऊ ओखर जिघा हे राज करिस। <verse eid="GEN 36:37" /><verse number="38" style="v" sid="GEN 36:38" />जब साउल मरिस तब अकबोर कर टोरवा बाल्हानान ओखर जिघा हे राज करिस। <verse eid="GEN 36:38" /><verse number="39" style="v" sid="GEN 36:39" />अकबोर कर टोरवा बाल्हानान मरिस तब हदर ओखर जिघा हे राज करिस, ओखर राजधानी के नाम पाऊ हबै, ओखर डउकी के नाम महेतबेल रथै, ऊ मेजाहब के नतिनिया अउ मतेरद के टोरिया रथै। <verse eid="GEN 36:39" /><verse number="40" style="v" sid="GEN 36:40" />एसाव कर परवार के मुखिया के नाम उनखर कुल अउ रहैबाले जिघा के जसना हइ नाम हबै, तिम्ना, अल्बा, यतेत, <verse eid="GEN 36:40" /><verse number="41" style="v" sid="GEN 36:41" />ओहोलीबामा, एला, पीनोन, <verse eid="GEN 36:41" /><verse number="42" style="v" sid="GEN 36:42" />कनज, तेमान, मिबसार, <verse eid="GEN 36:42" /><verse number="43" style="v" sid="GEN 36:43" />मग्दीएल, अउ ईराम, जउन देस एदोम परवार अपन हक हे कर लय रथै, उनखर रहैबाले जिघा के जसना इहै एदोम मतलब कि एसाव, जउन एदोम परवार के मूल बाफ हबै परवार के मुखिया हबै।<verse eid="GEN 36:43" /></para>
  <chapter eid="GEN 36" />
  <chapter number="37" style="c" sid="GEN 37" />
  <para style="s">यूसुफ अउ ओखर भाई</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 37:1" />याकूब रुक गइस अउ कनान देस हे रहै लगिस, हइ उहै देस हबै, जिहां ओखर बाफ आयके बस गय रथै।<note caller="+" style="x"><char style="xo" closed="false">37:1 </char><char style="xt" closed="false"><ref loc="ACT 7:9">प्रेरितो 7:9</ref></char></note> <verse eid="GEN 37:1" /><verse number="2" style="v" sid="GEN 37:2" />याकूब के परवार के इहै किस्सा हबै, यूसुफ सतरह साल के जबान मनसे रथै, ओखर काम छेडी गेडरा के चरामै का रथै, ऊ अपन बाफ के दूसर डउकी, बिल्हा अउ जिल्पा के संग रहै करथै, ऊ अपन उन भाई के बेकार बातन के खबर अपन बाफ के लिघ्घो लाय करथै। <verse eid="GEN 37:2" /><verse number="3" style="v" sid="GEN 37:3" />याकूब अपन सब टोरवन लग यूसुफ लग जादा माया करथै, काखे ऊ ओखर डोकरा के टोरवा रथै, उन ओखर निता बाहों बाले अक्ठी अंगरखा सिलवाय दय रथै। <verse eid="GEN 37:3" /><verse number="4" style="v" sid="GEN 37:4" />यूसुफ के भाई देखथै कि हमर बाफ हमर लग जादा यूसुफ लग माया करथै, उन इहै कारन अपन भाई लग घ्रना करथै, ऊ यूसुफ लग अच्छी बात नेहको करथै। <verse eid="GEN 37:4" /><verse number="5" style="v" sid="GEN 37:5" />एक बेर यूसुफ सपना देखिस, तब ऊ अपन भाई के सपना के बारे हे गुठेइस तब ऊ ओखर लग अउ जादा घ्रना करे लग जथै। <verse eid="GEN 37:5" /><verse number="6" style="v" sid="GEN 37:6" />यूसुफ उनखर लग हइ कथै, “मै जउन सपना देखे हव, उके तुम सुना। <verse eid="GEN 37:6" /><verse number="7" style="v" sid="GEN 37:7" />हम सब खेतवा हे काम करत रहन, ता हम गोंहू के अक संग गठ्ठा बांधत रहन, मोर गठ्ठा ठाढ हुइस, अउ तुम गठ्ठा मोर गठ्ठा के चारो पल्ला घेरा बनाइन, तब तुम्हर सगलू गठ्ठा मोर गठ्ठा के निहुर के परनाम करिन।” <verse eid="GEN 37:7" /><verse number="8" style="v" sid="GEN 37:8" />ओखर भाई कथै, “का, तुम सोचत हबा कि एखर का मतलब हबै, तै राजा बनिहे अउ हमर उप्पर राज करिहे?” ओखर भाई यूसुफ लग अब अउ जादा घ्रना करैका सुरु करिन काखे ऊ उनखर बारे हे सपना देखे रथै। <verse eid="GEN 37:8" /><verse number="9" style="v" sid="GEN 37:9" />यूसुफ अक्ठी अउ सपना देखिस, ऊ अपन भाइयन के गुठेइस, यूसुफ कथै, देख, मै आज अक्ठी अउ सपना देखे हव, बेरा, जोनइहा अउ गेराह तराइया निहुर के मोके परनाम करथै। <verse eid="GEN 37:9" /><verse number="10" style="v" sid="GEN 37:10" />यूसुफ अपन बाफ के हइ सपना के बारे हे गुठेइस, पय ओखर बाफ ओही गधारके कथै, “हइ कउन मेर के सपना हबै? का तोके बिस्वास हबै कि तोर दाय, तोर भाई अउ हम तोके परनाम करहिन?” <verse eid="GEN 37:10" /><verse number="11" style="v" sid="GEN 37:11" />यूसुफ के भाई ओखर लग इसाय करत रहै, पय ओखर बाफ हइ बात के सुरता धरिस।<verse eid="GEN 37:11" /></para>
  <para style="s">यूसुफ के गुलाम बनाय के मिस्र देस हे जायका</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 37:12" />एक टेम यूसुफ के भाई अपन बाफ के गेडरा छेडी चरामै के निता सकेम सहर छो गइन। <verse eid="GEN 37:12" /><verse number="13" style="v" sid="GEN 37:13" />तब इस्राएल यूसुफ लग कथै, “सकेम सहर छो जा, तुम्हर भाई मोर गेडरा के संग उहां हबै।” यूसुफ जबाब देथै, “मै जइहों।” <verse eid="GEN 37:13" /><verse number="14" style="v" sid="GEN 37:14" />यूसुफ के बाफ कथै, “जा अउ देख कि तुम्हर भाई निक्खा हबै कि नेहको, अउ लउटके आ अउ बता कि का मोर गेडरा निक्खा हबै कि नेहको?” हइ मेर यूसुफ के बाफ उके हेब्रोन के घाटी लग सकेम सहर छो पठोइस। <verse eid="GEN 37:14" /><verse number="15" style="v" sid="GEN 37:15" />सकेम सहर हे यूसुफ भुलाय जथै, अक्ठी मनसे उके खेतवा हे भटकत पाइस, ऊ मनसे कथै, “तै काहिन खोजत हबस?” <verse eid="GEN 37:15" /><verse number="16" style="v" sid="GEN 37:16" />यूसुफ जबाब देथै, मै अपन भाई के खोजथो, किरपा करके मोके गुठेबा कि ऊ गेडरा छेडी कछो चराउत हबै? <verse eid="GEN 37:16" /><verse number="17" style="v" sid="GEN 37:17" />मनसे जबाब देथै, “ऊ पहिलेन कढ गय हबै, मै उनके कहत सुने हव कि ऊ दोतान सहर छो जात हबै।” इहैनिता यूसुफ अपन भाई के पाछू गइस अउ ऊ उनके दोतान सहर हे पइस। <verse eid="GEN 37:17" /><verse number="18" style="v" sid="GEN 37:18" />यूसुफ के भाई बोहत दुरिहां लग उके आउत देखथै, उन उके मार डालै का सोच बनाय लइन। <verse eid="GEN 37:18" /><verse number="19" style="v" sid="GEN 37:19" />उन अक दूसर लग कथै, “हइ सपना देखे बाले यूसुफ अउत हबै। <verse eid="GEN 37:19" /><verse number="20" style="v" sid="GEN 37:20" />अब आबा हम उके मारके कउनो गढहा हे फटक दइ, हम घर हे जाय के कहि देब कि डोंगर के जानवर उके खाय लय हबै, तब हम देखब कि ओखर सपना आगू कइसन पूर होथै।” <verse eid="GEN 37:20" /><verse number="21" style="v" sid="GEN 37:21" />पय रूबेन यूसुफ के बचामै चाहथै, रूबेन कथै, “हम उके नेहको मारब। <verse eid="GEN 37:21" /><verse number="22" style="v" sid="GEN 37:22" />हम उके चोंट पहुंचाय बेगैर अक्ठी खोदरा हे डाल सकथन।” रूबेन यूसुफ के बचामैका अउ ओखर बाफ के संग पठोमै का सोच बनाइस। <verse eid="GEN 37:22" /><verse number="23" style="v" sid="GEN 37:23" />यूसुफ अपन भाई के लिघ्घो आइन, उन ओखर उप्पर हमला करिन अउ ओखर लम्बा सुन्दर अंगरखा के चीथ डालथै। <verse eid="GEN 37:23" /><verse number="24" style="v" sid="GEN 37:24" />तब उन उके खाली सुखाय हर खोदरा हे फटक दइन। <verse eid="GEN 37:24" /><verse number="25" style="v" sid="GEN 37:25" />यूसुफ कुंवा हे रथै, ओखर भाई खाना खाय के निता बइठिन, तब उन आंखी उठाइन अउ इस्माएलिन के अक्ठी दल के देखिन जउन गिलाद लग मिस्र देस छो यातरा हे रथै, उनखर उंटवा कइन मेर के बलसान, मोहरस कर रस अउ डेरा लइके जात रहै। <verse eid="GEN 37:25" /><verse number="26" style="v" sid="GEN 37:26" />इहैनिता यहूदा अपन भाई लग कथै, अगर हम अपन भाई के मार देब अउ ओखर मिरतू के लुकाउब ता ओखर लग हमके काहिन फायदा होही?<note caller="+" style="x"><char style="xo" closed="false">37:26 </char><char style="xt" closed="false"><ref loc="GEN 4:10">उत्पति 4:10</ref>; <ref loc="JOB 16:18">अयूब 16:18</ref></char></note> <verse eid="GEN 37:26" /><verse number="27" style="v" sid="GEN 37:27" />हमके जादा फायदा तब होही जब हम उके हइ इस्माएलिन के हाथ हे बेच देब, अउ दूसर भाई मान गइन। <verse eid="GEN 37:27" /><verse number="28" style="v" sid="GEN 37:28" />तब मिद्यानी बनिया लिघ्घो आइन, ओखर भाई यूसुफ के खोदरा लग बाहिर निकारिन, उन बीस चांदी के भाग हे उके इस्माएलिन के बेच दइन, बनिया उके मिस्र देस छो लइ जथै।<note caller="+" style="x"><char style="xo" closed="false">37:28 </char><char style="xt" closed="false"><ref loc="ACT 7:9">प्रेरितो 7:9</ref></char></note> <verse eid="GEN 37:28" /><verse number="29" style="v" sid="GEN 37:29" />जब रूबेन गढहा के पल्ला लउटिस अउ देखिस कि यूसुफ गढहा हे नेहको हबै तब ऊ अपन कपडा फाडिस। <verse eid="GEN 37:29" /><verse number="30" style="v" sid="GEN 37:30" />रूबेन अपन भाई के लिघ्घो लउटिस, ऊ उनखर लग कथै, टोरवा गढहा हे नेहको हबै, अब मै काहिन करो? <verse eid="GEN 37:30" /><verse number="31" style="v" sid="GEN 37:31" />उन अक्ठी बोकडा के मारिन, अउ ओखर खून के यूसुफ के सुन्दर कपडा हे डालिन। <verse eid="GEN 37:31" /><verse number="32" style="v" sid="GEN 37:32" />तब ओखर भाई ऊ कपडा के अपन बाफ के देखाइस अउ उन कथै, “हम हइ कपडा मिले हबै। का हइ यूसुफ के कपडा हबै?” <verse eid="GEN 37:32" /><verse number="33" style="v" sid="GEN 37:33" />बाफ कपडा के चीन लेथै, ऊ कथै, हइ तो मोर टोरवा के कपडा हबै, डोंगर के जानवर उके खाय लय हबै, जरूर यूसुफ के खंडा खन्डा कर दय गइस। <verse eid="GEN 37:33" /><verse number="34" style="v" sid="GEN 37:34" />याकूब अपन कपडा के फाडिस, उन कनिहा हे कस के बांधिस, अउ बोहत दिन तक अपन टोरवा के निता सोक मनाइस। <verse eid="GEN 37:34" /><verse number="35" style="v" sid="GEN 37:35" />याकूब के सगलू टोरवा, टोरिया उके धीर धरै का परयास करिन, पय याकूब कबहुन धीर नेहको धरिस, याकूब कथै, “मै मरै के रोज तक अपन टोरवा यूसुफ के सोक हे बुढे रइहों।” <verse eid="GEN 37:35" /><verse number="36" style="v" sid="GEN 37:36" />उन मिद्यानी जिनही यूसुफ के खरीदे रथै, बाद हे उके मिस्र देस हे बेच दइस, उन पोतीपर फिरोन के सुपाही के परधान के हाथ हे बेच डालिस।<verse eid="GEN 37:36" /></para>
  <chapter eid="GEN 37" />
  <chapter number="38" style="c" sid="GEN 38" />
  <para style="s">यहूदा अउ तामार</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 38:1" />एक टेम असना हुइस कि यहूदा अपन भाई लग अलगे हुइके कढ गइस, ऊ अदुल्लाम सहर के अक्ठी निबासी के लिघ्घो रहै लगिस जेखर नाम हीरा रथै। <verse eid="GEN 38:1" /><verse number="2" style="v" sid="GEN 38:2" />उहां यहूदा सूआ नाम के अक्ठी कनानी डउका के टोरिया के देखिस, अउ ओखर लग काज करके ओखर लिघ्घो गइस। <verse eid="GEN 38:2" /><verse number="3" style="v" sid="GEN 38:3" />ऊ लादा हे हुइके अउ ऊ अक्ठी टोरवा के पइदा करिस, यहूदा ओखर नाम एर रखिस। <verse eid="GEN 38:3" /><verse number="4" style="v" sid="GEN 38:4" />ऊ फेरै लग लादा हे हुइस, ऊ अक्ठी अउ टोरवा के पइदा करिस, दाय ओखर नाम ओनान रखिस। <verse eid="GEN 38:4" /><verse number="5" style="v" sid="GEN 38:5" />ऊ अक्ठी अउ टोरवा के पइदा करिस, दाय ओखर नाम सेला रखिस, जब ऊ उके पइदा करिस तब ऊ कजीब सहर हे रथै। <verse eid="GEN 38:5" /><verse number="6" style="v" sid="GEN 38:6" />यहूदा अपन टोरवा एर के निता डउकी के रूप हे चुनिस, ऊ डउकी कर नाम तामार रथै। <verse eid="GEN 38:6" /><verse number="7" style="v" sid="GEN 38:7" />पय यहूदा कर ऊ जेठ एर बोहत बेकार मनसे रथै, भगवान ओखर लग खुस नेहको रथै, इहैनिता भगवान उके मार डालिस। <verse eid="GEN 38:7" /><verse number="8" style="v" sid="GEN 38:8" />यहूदा ओनान लग कथै, “तै अपन भाई के डउकी के संग सो, अउ तै ओखर डउका के जसना बन, अगर लरका हुइहिन ता ऊ तोर भाई एर के हुइहिन।” <verse eid="GEN 38:8" /><verse number="9" style="v" sid="GEN 38:9" />ओनान जानथै कि हइ जोडा लग लरका पइदा ओखर नेहको होही, ओनान तामार के संग सोइस, पय ऊ उके अपन लादा हे नेहको होमै दइस। <verse eid="GEN 38:9" /><verse number="10" style="v" sid="GEN 38:10" />एखर लग भगवान गुस्सा हुइस, इहैनिता भगवान ओनान के मार डालिस। <verse eid="GEN 38:10" /><verse number="11" style="v" sid="GEN 38:11" />तब यहूदा अपन बहु तामार लग कथै, “अपन बाफ के घर छो लउट जा, उहै छो रइहे अउ तब तक काज झइ करबे, जब तक मोर नानहस टोरवा सेला बडा झइ हुइ जाय।” यहूदा के डर रथै कि सेलो अपन भाइयन के जसना मारे जाय, तामार अपन बाफ के घर छो लउट गय। <verse eid="GEN 38:11" /><verse number="12" style="v" sid="GEN 38:12" />बाद हे सूआ के टोरिया यहूदा के डउकी मर गइस, यहूदा अपन सोक के टेम के बाद अदुल्लाम अपन संगी हीरा के संग गेडरन के चूंदी काटे बालेन के लिघ्घो तिम्नाथ गइस। <verse eid="GEN 38:12" /><verse number="13" style="v" sid="GEN 38:13" />तामार के हइ पता हुइस कि ओखर ससुर यहूदा अपन गेडरा के ऊन काटै के निता तिम्नाथ जथै। <verse eid="GEN 38:13" /><verse number="14" style="v" sid="GEN 38:14" />तामार बिधवा बाले कपडा उतार देथै इहैनिता ऊ दूसर कपडा पहनिस अउ मुंह के ढांक लइस, तब ऊ तिम्नाथ सहर के लिघ्घो एनैम छो जाय बाले रास्ता के बगल हे बइठे रथै, तामार जानथै कि यहूदा के नानहस टोरवा सेला अब बडा हुइ गय हबै, पय यहूदा ओखर लग काज नेहको करिस। <verse eid="GEN 38:14" /><verse number="15" style="v" sid="GEN 38:15" />यहूदा उहै रास्ता लग यातरा करिस, ऊ उके देखिस, पय सोचिस कि ऊ बेस्या हबै, काखे मुंह ढंके हर रथै। <verse eid="GEN 38:15" /><verse number="16" style="v" sid="GEN 38:16" />इहैनिता यहूदा ओखर लिघ्घो गइस अउ बोलिस, “मोके अपन संग सोमै दे।” यहूदा नेहको जानथै कि ऊ ओखर बहु तामार हबै। तामार बोलथै, “तै मोके केतका देबे?” <verse eid="GEN 38:16" /><verse number="17" style="v" sid="GEN 38:17" />यहूदा जबाब देथै, “मै अपन झुंड लग तोके अक्ठी नबा छेडी पठोहुं।” ऊ जबाब देथै, “मै इके स्बीकार करथो, पय पहिले तै मोके कुछ रखै दे।” <verse eid="GEN 38:17" /><verse number="18" style="v" sid="GEN 38:18" />यहूदा पूंछथै, मै छेडी पठोहुं एखर साबूत के निता तै मोर लग काहिन लय चाहत? तामार जबाब देथै, “तोर सील, नटेरी के डोरा अउ तोर हाथ के डंडा,” यहूदा हइ चीज उके दइ दइस अउ ओखर संग सोइस, तामार ओखर लग लादा हे हुइस। <verse eid="GEN 38:18" /><verse number="19" style="v" sid="GEN 38:19" />एखर बाद ऊ उठके कढ गइस, ऊ मुंह हे ढंके बाले कपडा हटाय दइस, अउ बिधवा डउकी के कपडा पहिन लइस। <verse eid="GEN 38:19" /><verse number="20" style="v" sid="GEN 38:20" />यहूदा अपन अदुल्लामवासी संगी हीरा के तामार के घर ओखर टीमा करे हर छेडी दे के निता पठोइस, यहूदा हीरा लग खास करके सील अउ हाथ के डंडा ओखर लग लामै के निता कहिस, पय हीरा ओखर पता नेहको लगाय सकिस। <verse eid="GEN 38:20" /><verse number="21" style="v" sid="GEN 38:21" />हीरा एनैम सहर के कुछ मनसेन लग पूंछथै, “रास्ता के टाठा हे जउन बेस्या रथै ऊ कछो हबै?” मनसे कथै, “इहां कबहुन कउनो बेस्या नेहको रथै।” <verse eid="GEN 38:21" /><verse number="22" style="v" sid="GEN 38:22" />इहैनिता यहूदा के संगी यहूदा के लिघ्घो लउट गइस अउ ओखर लग कथै, “मै ऊ डउकी के पता नेहको लगाय सको, जउन मनसे ऊ जिघा हे रथै, उन गुठेइन कि उहां कबहुन कउनो बेस्या नेहको रथै।” <verse eid="GEN 38:22" /><verse number="23" style="v" sid="GEN 38:23" />इहैनिता यहूदा कथै, “उके ऊ चीज के रखे देया, मै नेहको चाहथो कि मनसे हमर मजाक उडामै, मै उके छेडी दे चाही, पय हम ओखर पता नेहको लगाय सकन हइ बात बोहत हबै।” <verse eid="GEN 38:23" /><verse number="24" style="v" sid="GEN 38:24" />करीबन तीन महिना बाद कउनो यहूदा लग कथै, “तोर पुतउ तामार बेस्या के मेर पाप करे हबै अउ अब ऊ लादा हे हबै।” तब यहूदा कथै, “उके बाहिर निकारा अउ मार डाला, ओखर सरीर के भूंज डारा।” <verse eid="GEN 38:24" /><verse number="25" style="v" sid="GEN 38:25" />जब मनसे उके बाहिर निकारत रहै तब ऊ अपन ससुर के हइ संदेस पठोथै, जउन मनसे के हइ चीज हबै, ओखर उप्पर मोके गरब हबै, किरपा धियान लग देखा कि हइ चीज सील, डोरा अउ डंडा कोनहर मनसे करे हबै? <verse eid="GEN 38:25" /><verse number="26" style="v" sid="GEN 38:26" />यहूदा उन चीजन के चीन लेथै, अउ कथै, “हइ ठीक कथै, मोर गलती हबै, मै अपन टीमा के जसना अपन टोरवा सेला के इके नेहको दयों,” अउ यहूदा ओखर संग फेर नेहको सोइस। <verse eid="GEN 38:26" /><verse number="27" style="v" sid="GEN 38:27" />जब तामार के लरका पइदा करे के टेम आइस अउ उके पता चलथै, कि मोर लादा हे जुडवा लरका हबै। <verse eid="GEN 38:27" /><verse number="28" style="v" sid="GEN 38:28" />जब ऊ लरका के पइदा करत रथै तब अक्ठी टोरवा हाथ बाहिर निकाडिस, दादी ओखर हाथ पकडिस अउ ओखर हाथ हे अक्ठी लाल डोरा बांध के कथै, हइ लादा लग पहिलेन बाहिर निकडे हबै। <verse eid="GEN 38:28" /><verse number="29" style="v" sid="GEN 38:29" />पय ऊ लरका अपन हाथ वापिस भित्तर तीन लइस, तब दूसर लरका पहिले पइदा हुइ गय, तब दादी कथै, तहिन पहिलेन बाहिर निकडै हे आगू आय, इहैनिता उन ओखर नाम पेरेस धरिस। <verse eid="GEN 38:29" /><verse number="30" style="v" sid="GEN 38:30" />ओखर पइदा के बाद ओखर भाई जेखर हाथ हे लाल डोरा बांधे रथै, लादा लग बाहिर निकडिस, ओखर नाम “जेरह” धरे गइस।<verse eid="GEN 38:30" /></para>
  <chapter eid="GEN 38" />
  <chapter number="39" style="c" sid="GEN 39" />
  <para style="s">युसुफ अउ पोतीपर कर डउकी</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 39:1" />जउन बनिया यूसुफ के खरीदे रथै, ऊ उके मिस्र देस हे लइ गइन, तब पोतीपर नाम अक्ठी मिस्री जउन फिरोन के सिपाही रथै, उन इस्माएलिन के हाथ हे उके बेचिस। <verse eid="GEN 39:1" /><verse number="2" style="v" sid="GEN 39:2" />पय परभु यूसुफ के मदत करे करथै, यूसुफ अक्ठी सफल मनसे बन गइस, यूसुफ अपन मिस्री निबासी के घर हे रथै।<note caller="+" style="x"><char style="xo" closed="false">39:2 </char><char style="xt" closed="false"><ref loc="ACT 7:9">प्रेरितो 7:9</ref></char></note> <verse eid="GEN 39:2" /><verse number="3" style="v" sid="GEN 39:3" />यूसुफ के मालिक देखथै, कि परभु ओखर संग हबै, जउन कुछु ऊ करथै, उके ओखर हाथ लग सफल बनथै।<note caller="+" style="x"><char style="xo" closed="false">39:3 </char><char style="xt" closed="false"><ref loc="ACT 7:9">प्रेरितो 7:9</ref></char></note> <verse eid="GEN 39:3" /><verse number="4" style="v" sid="GEN 39:4" />इहैनिता पोतीपर यूसुफ के पाय के बोहत खुस रथै, पोतीपर उके अपन निता काम करैका अउ घर के परबन्ध हे मदत करै हे लगाइस, पोतीपर के हर अक्ठी चीज के यूसुफ साहब रथै। <verse eid="GEN 39:4" /><verse number="5" style="v" sid="GEN 39:5" />जउन टेम लग पोतीपर उके अपन घर के साहब बनाइस, अउ ओखर हाथ हे अपन सब कुछ सउपिस, ऊ टेम लग परभु यूसुफ के कारन ऊ मिस्री निबासी के घर के आसीस दइस, ओखर घर अउ खेतवा के हर चीज हे परभु के आसीस होमै लगिस। <verse eid="GEN 39:5" /><verse number="6" style="v" sid="GEN 39:6" />पोतीपर अपन सगलू कुछु यूसुफ के हाथ हे छांड दइस, ओखर रहत ऊ भोजन करै के अलावा घर के सम्बन्ध हे अउ कुछु नेहको जानथै। यूसुफ सरीर लग खूब सूरत रथै। <verse eid="GEN 39:6" /><verse number="7" style="v" sid="GEN 39:7" />कुछ टेम बाद यूसुफ के मालिक के डउकी यूसुफ लग माया करै लगिस, अक रोज ऊ कथै, “मोर संग सोय ले।” <verse eid="GEN 39:7" /><verse number="8" style="v" sid="GEN 39:8" />पय यूसुफ मना कर देथै, ऊ कथै, “मोर मालिक घर के हर अक्ठी चीज के निता मोर उप्पर बिस्वास करथै, ऊ इहां हर अक्ठी चीज के जिम्मेदारी मोके दय हबै। <verse eid="GEN 39:8" /><verse number="9" style="v" sid="GEN 39:9" />मोर मालिक अपन घर हे मोके करीबन अपन बरोबर मान दय हबै, पय मोके ओखर डउकी के संग नेहको सोमै चाही, हइ गलत हबै, हइ भगवान के बिरोध पाप हबै।” <verse eid="GEN 39:9" /><verse number="10" style="v" sid="GEN 39:10" />ऊ डउकी हर रोज यूसुफ लग बात करथै पय यूसुफ ओखर संग सोमै लग मना कर देथै। <verse eid="GEN 39:10" /><verse number="11" style="v" sid="GEN 39:11" />अक रोज यूसुफ अपन काम करै के निता घर हे गइस, ऊ टेम ऊ घर हे अकेल्ले मनसे रथै। <verse eid="GEN 39:11" /><verse number="12" style="v" sid="GEN 39:12" />पोतीपर के डउकी यूसुफ के कपडा के पकड लेथै अउ ओखर लग कथै, मोर संग सो, पय यूसुफ अपन कपडा ओखर हाथ लग छांडय के भागिस अउ घर लग बाहिर निकर गइस। <verse eid="GEN 39:12" /><verse number="13" style="v" sid="GEN 39:13" />जब पोतीपर के डउकी देखथै कि यूसुफ अपन कपडा ओखर हाथ हे छांडय के घर लग बाहिर निकर गइस, <verse eid="GEN 39:13" /><verse number="14" style="v" sid="GEN 39:14" />तब ऊ अपन घर के मनसे के बुलाइस अउ उनखर लग कथै, इबरानी सेबक के देखा, उके मोर मालिक हमर बेज्जती करै के निता लाय हबै, ऊ इबरानी मोर लग गलत काम करै के निता मोर लिघ्घो आय रथै, पय मै ऊंच आरो हे पुकारे लगो। <verse eid="GEN 39:14" /><verse number="15" style="v" sid="GEN 39:15" />जब ऊ सुनिस कि मै ऊंच आरो लग चिरलाथो, तब ऊ अपन कपडा मोर हाथ लग छांडाय के भागिस अउ घर लग बाहिर निकर गइस। <verse eid="GEN 39:15" /><verse number="16" style="v" sid="GEN 39:16" />जब तक ओखर मालिक अपन घर हे नेहको आइस, ऊ यूसुफ के कपडा अपन लिघ्घो पडे रहै दइस। <verse eid="GEN 39:16" /><verse number="17" style="v" sid="GEN 39:17" />अउ ऊ अपन डउका के उहै किस्सा सुनाइस, ऊ कथै, “जउन इबरानी दास के तै इहां लाय रथस, ऊ मोर इज्जत लूटे के परयास करथै। <verse eid="GEN 39:17" /><verse number="18" style="v" sid="GEN 39:18" />पय ऊ मोर लिघ्घो आइस ता मै चिरलायो, ऊ अपन कपडा छांड गइस भाग गइस।” <verse eid="GEN 39:18" /><verse number="19" style="v" sid="GEN 39:19" />यूसुफ के मालिक जउन ओखर डउकी कहिस, ऊ सुनके बोहत गुस्साथै। <verse eid="GEN 39:19" /><verse number="20" style="v" sid="GEN 39:20" />अउ यूसुफ के मालिक ओही पकडके जेल हे बेडवाय देथै, जिहां राजा के कैदी बन्द रथै, अउ यूसुफ उहां पडे रहिस।<note caller="+" style="x"><char style="xo" closed="false">39:20 </char><char style="xt" closed="false"><ref loc="ACT 7:9">प्रेरितो 7:9</ref></char></note> <verse eid="GEN 39:20" /><verse number="21" style="v" sid="GEN 39:21" />पय परभु यूसुफ के संग रथै, परभु ओखर उप्पर किरपा करे रथै, अउ जेल के साहब यूसुफ के उप्पर धियान रखे करथै। <verse eid="GEN 39:21" /><verse number="22" style="v" sid="GEN 39:22" />पय जेल के खास साहब यूसुफ जेल के सगलू कैदी के यूसुफ के हाथ हे सउप देथै, जउन कुछु जेल हे होथै, ओखर देख-रेख करे बाले यूसुफ रथै। <verse eid="GEN 39:22" /><verse number="23" style="v" sid="GEN 39:23" />जेल के खास साहब यूसुफ के हाथ हे सउपे गय कउनो चीज के नेहको देखथै, काखे परभु यूसुफ के संग रथै, जउन कुछु यूसुफ करथै, परभु उके सफल बनाथै।<verse eid="GEN 39:23" /></para>
  <chapter eid="GEN 39" />
  <chapter number="40" style="c" sid="GEN 40" />
  <para style="s">यूसुफ दवारा सपनन के मतलब गुठेथै</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 40:1" />हइ बातन के बाद असना होथै, कि मिस्र देस के राजा फिरोन के दुइठे हरवाह कुछ अपराध करे रथै, हइ हरवाहन मसे अक्ठी रोटी पकामै बाले अउ दूसर मोहरस के रस्सा दे बाले के उप्पर गुस्साय रथै। <verse eid="GEN 40:1" /><verse number="2" style="v" sid="GEN 40:2" />तब फिरोन राजा अपन उन दुइठे सुपाही, मतलब मोहरस के रस्सा के साहब, अउ रोटी पकामै बाले के साहब के उप्पर गुस्सा हुइस <verse eid="GEN 40:2" /><verse number="3" style="v" sid="GEN 40:3" />इहैनिता फिरोन राजा उन दोनो के जेल हे डलवाय देथै, जिहां यूसुफ जेल हे रथै। <verse eid="GEN 40:3" /><verse number="4" style="v" sid="GEN 40:4" />तब सुपाही दुनो कैदी के यूसुफ के नजर हे रखथै, दोनो कुछ टेम तक जेल हे रहिन। <verse eid="GEN 40:4" /><verse number="5" style="v" sid="GEN 40:5" />अक रोज मिस्र देस के राजा के मोहरस अउ रोटी पकामै बाले मनसे सपना देखथै, हर सपना के अपन अक्ठी खास मतलब रथै। <verse eid="GEN 40:5" /><verse number="6" style="v" sid="GEN 40:6" />जब यूसुफ सुबेन्ने उनखर लिघ्घो आइस अउ ऊ उनके देखथै, तब ऊ उदास रथै। <verse eid="GEN 40:6" /><verse number="7" style="v" sid="GEN 40:7" />ऊ फिरोन के साहब लग जउन ओखर संग ओखर मालिक के घर हे जेल हे रथै, पूंछथै, “आज तोर मुंह काखे उतरे हर हबै?” <verse eid="GEN 40:7" /><verse number="8" style="v" sid="GEN 40:8" />उन यूसुफ लग कथै, हम सपना देखे हवन, पय इहां उनखर मतलब बतामै बाले कउ नेहको हबै। यूसुफ कथै, का हइ सही हबै कि सपना के मतलब बतामै के केबल भगवान के काम है? किरपा करके मोके सुनाबा। <verse eid="GEN 40:8" /><verse number="9" style="v" sid="GEN 40:9" />इहैनिता मोहरस दे बाले हरवाह यूसुफ के अपन सपना गुठेइस, हरवाह कथै, “मै सपना हे अंगूर कर बेल देखेव। <verse eid="GEN 40:9" /><verse number="10" style="v" sid="GEN 40:10" />ऊ अंगूर के बेल के तीनठे डगाइल रथै, मै डगाइल हे फडुहा आउत अउ उनके अंगूर बनत देखेव। <verse eid="GEN 40:10" /><verse number="11" style="v" sid="GEN 40:11" />मै फिरोन के खोरिया मोर हाथ हे रथै, इहैनिता मै अंगूर के लयों अउ खोरिया हे रस निचोडा, तब मै खोरिया के फिरोन के दयों। <verse eid="GEN 40:11" /><verse number="12" style="v" sid="GEN 40:12" />तब यूसुफ कथै, मै तोके सपना के मतलब समझइहों, तीन डगाइल के मतलब तीन रोज हबै। <verse eid="GEN 40:12" /><verse number="13" style="v" sid="GEN 40:13" />तीन रोज बीतै के बाद पहिले फिरोन राजा तोके माफ करही अउ तोके तोर काम हे लउटै देही, तै फिरोन के निता उहै काम करहे जउन पहिले करत रहस। <verse eid="GEN 40:13" /><verse number="14" style="v" sid="GEN 40:14" />पय जब तै छुटहे इहां लग ता मोके सुरता रखबे, मोर मदत करबे, फिरोन लग मोर बारे हे कहबे, जेखर मै हइ जेल लग बाहिर हुइ सको। <verse eid="GEN 40:14" /><verse number="15" style="v" sid="GEN 40:15" />मोके अपन घर लग लाय गय रथो, जउन मोर अपन मनसे इबरानी के देस हबै, मै कउनो गलती नेहको करे यहों, इहैनिता मोके जेल हे नेहको होमै चाही।” <verse eid="GEN 40:15" /><verse number="16" style="v" sid="GEN 40:16" />रोटी बनामै बाले देखिस कि दूसर हरवाह के सपना निक्खा रथै, इहैनिता रोटी बनामै बाले यूसुफ लग कथै, “मै सपना देखो, मै देखो कि मोर मूंड हे तीन चरका रोटिन के टोपरी हबै। <verse eid="GEN 40:16" /><verse number="17" style="v" sid="GEN 40:17" />सब लग उप्पर के टोपरी हे फिरोन कर निता हर मेर के पके हर भोजन रथै, हइ भोजन राजा के निता रथै, पय हइ भोजन के चिरइया खथै।” <verse eid="GEN 40:17" /><verse number="18" style="v" sid="GEN 40:18" />यूसुफ जबाब देथै, “मै तोके गुठेहुं कि सपना कर मतलब काहिन हबै? तीन टोपरी के मतलब तीन रोज हबै। <verse eid="GEN 40:18" /><verse number="19" style="v" sid="GEN 40:19" />तीन रोज बितै के पहिले फिरोन राजा तोके हइ जेल लग बाहिर निकाडही, तब राजा तोर मूंड के काटही, ऊ तोर देह के अक्ठी खंम्भा हे लटकाही अउ चिरइया तोर देह के खाही।” <verse eid="GEN 40:19" /><verse number="20" style="v" sid="GEN 40:20" />तीन रोज के बाद फिरोन कर जनम दिन रथै, फिरोन अपन सगलू हरवाहन के खाय के निता बुलाथै, खाय के टेम हे फिरोन मोहरस दे बाले अउ रोटी बनामै बाले हरवाह के जेल लग बाहिर आमै दइस। <verse eid="GEN 40:20" /><verse number="21" style="v" sid="GEN 40:21" />फिरोन मोहरस दे बाले हरवाह के आजाद कर दइस, फिरोन उके काम हे रख लेथै, अउ मोहरस दे बाले हरवाह फिरोन के हाथ हे अक्ठी मोहरस कर रस खोरिया हे दइस। <verse eid="GEN 40:21" /><verse number="22" style="v" sid="GEN 40:22" />पय फिरोन राजा रोटी बनामै बाले के मार डारिस, सगलू बात जसना यूसुफ गुठेय रहै ओसनेन हुइस। <verse eid="GEN 40:22" /><verse number="23" style="v" sid="GEN 40:23" />पय मोहरस कर रस दे बाले हरवाह यूसुफ के सुरता नेहको करथै, उके बिसर गइस।<verse eid="GEN 40:23" /></para>
  <chapter eid="GEN 40" />
  <chapter number="41" style="c" sid="GEN 41" />
  <para style="s">यूसुफ फिरोन राजा के सपना के मतलब गुठेथै</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 41:1" />दुइ साल बाद फिरोन राजा सपना देखिस, फिरोन सपना हे देखिस कि ऊ नील नदिया के टाठा हे ठाढ हबै। <verse eid="GEN 41:1" /><verse number="2" style="v" sid="GEN 41:2" />तब फिरोन राजा सपना हे नदिया लग सातठे गोरू के बाहिर आउत देखथै, गोरू मोट अउ अच्छी रथै, गोरू उहां ठाढ रथै अउ चारा चरत रथै। <verse eid="GEN 41:2" /><verse number="3" style="v" sid="GEN 41:3" />तब सातठे दूसर गोरू नदिया लग बाहिर आइस, अउ नदिया के टाठा हे मोट गोरू के लिघ्घो ठाढ हुइ गइन, पय हइ गोरू पातर अउ बेकार रथै। <verse eid="GEN 41:3" /><verse number="4" style="v" sid="GEN 41:4" />हइ सातठे पातर गोरू, अच्छी मोट गोरू के खाय गइन, तब फिरोन जग उठिस। <verse eid="GEN 41:4" /><verse number="5" style="v" sid="GEN 41:5" />ऊ फेर सोय गइस, ऊ दूसर बेर सपना देखिस कि दाना सात बाली अक्ठी दाना के पाछू उगे हर देखथै, दाना के बाली मोट अउ अच्छी रथै। <verse eid="GEN 41:5" /><verse number="6" style="v" sid="GEN 41:6" />तब ऊ उहै दाना के पाछू सात दूसर बाली उगे हर देखथै, दाना के हइ बाली पातर अउ ताथ हवा लग मुरझाय गय रथै। <verse eid="GEN 41:6" /><verse number="7" style="v" sid="GEN 41:7" />तब सात पातर बाली सात मोट अउ अच्छी बाली के खाय लेथै, फिरोन फेर जग गइस अउ ऊ समझिस कि हइ केबल सपना हबै। <verse eid="GEN 41:7" /><verse number="8" style="v" sid="GEN 41:8" />सुबेन्ने फिरोन हइ सपनन के बारे हे परेसान रथै, इहैनिता ऊ मिस्र के सगलू टोनहन के अउ सगलू दिमाक बाले के बुलाइस, फिरोन उनके सपना गुठेइस, पय उन मनसे मसे कउ सपना के मतलब के नेहको गुठेय सकिन।<note caller="+" style="x"><char style="xo" closed="false">41:8 </char><char style="xt" closed="false"><ref loc="DAN 2:2">दानि 2:2</ref></char></note> <verse eid="GEN 41:8" /><verse number="9" style="v" sid="GEN 41:9" />तब अंगूर कर रस दे बाले हरवाह फिरोन लग कथै, “जउन मै पाप करे रहों ऊ सुरता मोके आइस। <verse eid="GEN 41:9" /><verse number="10" style="v" sid="GEN 41:10" />फिरोन तै मोर उप्पर अउ अक दूसर हरवाह हे गुस्सा रथस, अउ तै हम दोनो के जेल हे बेडवाय दय रहस। <verse eid="GEN 41:10" /><verse number="11" style="v" sid="GEN 41:11" />जेल हे एक्कै रात हम दोनो सपना देखे रहन, हर सपना के अलगे-अलगे मतलब रथै। <verse eid="GEN 41:11" /><verse number="12" style="v" sid="GEN 41:12" />उहां हमर संग अक्ठी इबरानी डउका रथै, ऊ सेनापति के सुपाही के सेबक रथै, हम उके अपन-अपन सपना सुनायन अउ ऊ हमके उनखर मतलब गुठेइस। <verse eid="GEN 41:12" /><verse number="13" style="v" sid="GEN 41:13" />जसना ऊ हमके मतलब गुठेय रथै, ओसनेन होथै, मोके अपन काम फिरै मिल गइस अउ रोटी बनामै बाले के फांसी लगाय के लटकाय गइस।” <verse eid="GEN 41:13" /><verse number="14" style="v" sid="GEN 41:14" />इहैनिता फिरोन यूसुफ के जेल लग बुलवाइस, सेना हरबी यूसुफ के जेल लग बाहिर लाइन, यूसुफ अपन चूंदी कटवाइस अउ साफ कपडा पहनिस, तब ऊ फिरोन के आगू ठाढ हुइस। <verse eid="GEN 41:14" /><verse number="15" style="v" sid="GEN 41:15" />तब फिरोन यूसुफ लग कथै, “मै अक्ठी सपना देखे हव, पय कउ असना नेहको हबै जउन सपना के बारे हे मोके समझाय सकै, मै सुने हव कि जब कउ सपना के बारे हे तोर लग कथै तब तै सपना के मतलब गुठेथस।” <verse eid="GEN 41:15" /><verse number="16" style="v" sid="GEN 41:16" />यूसुफ फिरोन के जबाब देथै, मै नेहको जानथो, पय भगवान फिरोन के सही जबाब देही। <verse eid="GEN 41:16" /><verse number="17" style="v" sid="GEN 41:17" />फिरोन यूसुफ लग कथै, देख, मै सपना हे नील नदिया के टाठा हे ठाढ रथै। <verse eid="GEN 41:17" /><verse number="18" style="v" sid="GEN 41:18" />मै सातठे गोरू के नदिया लग बाहिर आउत देखो अउ चारा चरत देखेव, हइ गोरू मोट अउ अच्छी रथै। <verse eid="GEN 41:18" /><verse number="19" style="v" sid="GEN 41:19" />तब मै दूसर सातठे गोरू के नदिया लग बाहिर आउत देखथो, ऊ गोरू पातर अउ कमजोर रथै, मै मिस्र देस हे जेतका गोरू देखे हव, उन मसे सब लग जादा कमजोर रथै। <verse eid="GEN 41:19" /><verse number="20" style="v" sid="GEN 41:20" />अउ हइ कमजोर अउ पातर गोरू पहिले अच्छी सातठे मोट गोरू के खाय डारिस। <verse eid="GEN 41:20" /><verse number="21" style="v" sid="GEN 41:21" />पय जब ऊ उनके खाय चुकथै, तब कउनो के असना बिस्वास नेहको होथै कि उन उनके खाय हबै, काखे जसना पहिले रथै, ओसनेन अबे रथै, तब मै जाग गयों। <verse eid="GEN 41:21" /><verse number="22" style="v" sid="GEN 41:22" />तब मै अपन दूसर सपना हे दाना के सातठे बाली एक्कै दाना के पाछू उगत देखो, ऊ दाना के बाली भररेहर अच्छी अउ सुन्दर रथै। <verse eid="GEN 41:22" /><verse number="23" style="v" sid="GEN 41:23" />तब उनखर बाद सातठे दूसर चूंदी उगिन, पय हइ बाल पातर, कमजोर अउ पूरब लग गरम हवा लग मुरझाय जथै। <verse eid="GEN 41:23" /><verse number="24" style="v" sid="GEN 41:24" />तब पातर बाल सातठे अच्छी बालन के खाय डारिन, “मै हइ अपन मनसे के गुठेयों जउन सपना के मतलब गुठेमै बाले ज्योतिसी रथै, पय कउनो सपना के मतलब मोके नेहको समझाइन कि एखर काहिन मतलब हबै?” <verse eid="GEN 41:24" /><verse number="25" style="v" sid="GEN 41:25" />तब यूसुफ फिरोन लग कथै, “हइ दोनो सपना के एक्कै मतलब होथै, भगवान तोके गुठेथै जउन हरबी होही। <verse eid="GEN 41:25" /><verse number="26" style="v" sid="GEN 41:26" />सात अच्छी गोरू अउ सात अच्छी दाना के बाल सात साल हबै, दोनो सपना के एक्कै मतलब हबै। <verse eid="GEN 41:26" /><verse number="27" style="v" sid="GEN 41:27" />सात पातर अउ कमजोर गोरू अउ सात कमजोर दाना के बाल देस हे भुखमरी के सात साल हबै, हइ सात साल, अच्छी सात साल के बाद आही। <verse eid="GEN 41:27" /><verse number="28" style="v" sid="GEN 41:28" />जउन बात मै फिरोन लग कहे हव, ऊ इहै हबै, जउन काम भगवान करै बाले हबै, ओही तोके देखाय हबै। <verse eid="GEN 41:28" /><verse number="29" style="v" sid="GEN 41:29" />सुन, सगलू मिस्र देस हे सात साल हे बोहत दाना पइदा होही। <verse eid="GEN 41:29" /><verse number="30" style="v" sid="GEN 41:30" />पय उनखर बाद अकाल के सात साल आही, अउ सगलू मिस्र देस हे मनसे हइ सगलू दाना पइदा के बिसर जइहिन, अउ अकाल लग देस नास होही। <verse eid="GEN 41:30" /><verse number="31" style="v" sid="GEN 41:31" />अकाल एतका भंयकर होही कि अच्छी दाना अउ पइदा कउनो के सुरता नेहको होही। <verse eid="GEN 41:31" /><verse number="32" style="v" sid="GEN 41:32" />अउ फिरोन एक्कै सपना दुइ बेर इहैनिता देखाय हबै कि भगवान दवारा हइ बात निस्चित करे जाय चुके हबै, अउ ऊ हरबी घटे बाले हबै। <verse eid="GEN 41:32" /><verse number="33" style="v" sid="GEN 41:33" />इहैनिता हे फिरोन तै अक्ठी असना मनसे के चुन जउन बोहत समझदार अउ दिमाकदार होय, तै उके मिस्र देस के राजा बना। <verse eid="GEN 41:33" /><verse number="34" style="v" sid="GEN 41:34" />तब फिरोन दूसर मनसे के दाना अकजुट करै के निता चुने हर मनसे सात निक्खा साल हे जेतका दाना पइदा करै, मिस्र देस उपज ओखर पचमा हिस्सा दे। <verse eid="GEN 41:34" /><verse number="35" style="v" sid="GEN 41:35" />तब निक्खा दाना के सात साल हे सगलू दाना चीज अकजुट करे जाय अउ दाना फिरोन के हक हे भंडार सहरन हे सुरक्छित रखत जाय। <verse eid="GEN 41:35" /><verse number="36" style="v" sid="GEN 41:36" />अउ हइ दाना सात साल के अकाल लग बचै के निता पूरा मिस्र देस के दे के निता अकजुट करे, ताकि मनसे दाना के कमी लग झइ मरै।”<verse eid="GEN 41:36" /></para>
  <para style="s">यूसुफ मिस्र देस के परधानमन्तरी बनिस</para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 41:37" />हइ बात फिरोन अउ ओखर सगलू अधिकारिन के निक्खा लगिस। <verse eid="GEN 41:37" /><verse number="38" style="v" sid="GEN 41:38" />इहैनिता फिरोन अपन अधिकारिन लग कथै, “का हमके असना मनसे, जसना हइ हबै जेहमा भगवान के आतमा रथै, मिल सकथै?” <verse eid="GEN 41:38" /><verse number="39" style="v" sid="GEN 41:39" />फेर फिरोन यूसुफ लग कथै, “भगवान हइ सगलू चीज तोके देखाय हबै, इहैनिता तहिन जादा दिमाक बाले हबस। <verse eid="GEN 41:39" /><verse number="40" style="v" sid="GEN 41:40" />तै मोर देस के राजा हुइहे, मोर मनसे तोर आदेस के मनहिन, केबल मै राजगद्दी हे तोर लग बडा राजा रइहों।” <verse eid="GEN 41:40" /><verse number="41" style="v" sid="GEN 41:41" />फेर फिरोन यूसुफ लग कथै, “सुन, मै तोके मिस्र देस के सगलू देस के उप्पर अधिकारी ठहराय देथो।” <verse eid="GEN 41:41" /><verse number="42" style="v" sid="GEN 41:42" />तब फिरोन अपन हाथ लग मुंदरी उतार के यूसुफ के हाथ हे डाल देथै, अउ ओही निक्खा मलमल के कपडा पहेनवाय दइस, अउ ओखर नटइ हे सोना के चैन पेहना दइस। <verse eid="GEN 41:42" /><verse number="43" style="v" sid="GEN 41:43" />तब फिरोन यूसुफ के अपन दूसर रथ हे चढके इज्जत दइस, रथन के आगू-आगू चलत रहै अधिकारी बोलथै, कि “घुटवा टेका।” हइ मेर फिरोन यूसुफ के सगलू मिस्र के परधानमन्तरी बनाय दइस। <verse eid="GEN 41:43" /><verse number="44" style="v" sid="GEN 41:44" />फिरोन यूसुफ लग इहो कथै, “मै फिरोन यहों, तोर आदेस के बेगैर कउनो मनसे सगलू मिस्र देस हे हाथ नेहको उठाय सके, अउ न गोड।” <verse eid="GEN 41:44" /><verse number="45" style="v" sid="GEN 41:45" />तब फिरोन यूसुफ के नाम सापनत्पानेह<note caller="+" style="f"><char style="fr" closed="false">41:45 </char><char style="ft" closed="false">भगवान बोलथै तुम जिन्दा रहा</char></note> रखिस, अउ ओन सहर के पुजारी पोतीपेरा के टोरिया आसनत लग ओखर काज कर दइस, अउ यूसुफ सगलू मिस्र देस हे यातरा करे लगिस। <verse eid="GEN 41:45" /><verse number="46" style="v" sid="GEN 41:46" />जब यूसुफ मिस्र देस के फिरोन राजा के सेबा हे परवेस करिस तब ऊ तीस साल के रथै, ऊ फिरोन के दरबार लग निकर के सगलू मिस्र देस हे यातरा करिस। <verse eid="GEN 41:46" /><verse number="47" style="v" sid="GEN 41:47" />सात साल हे देस हे बोहत जादा पइदाबार हुइस। <verse eid="GEN 41:47" /><verse number="48" style="v" sid="GEN 41:48" />अउ यूसुफ मिस्र देस हे सात साल खाय के चीज बचाइस, यूसुफ दाना सहरन हे अकजुट करिस, यूसुफ सहर के चारो पल्ला खेत कर पइदाबार दाना के हर सहर हे अकजुट करिस। <verse eid="GEN 41:48" /><verse number="49" style="v" sid="GEN 41:49" />यूसुफ बोहत दाना अकजुट करिस, हइ समुन्दर के कुदरा के जसना रथै, ऊ एतका दाना अकजुट करिस कि ओखर बजन के तउले नेहको सकै। <verse eid="GEN 41:49" /><verse number="50" style="v" sid="GEN 41:50" />यूसुफ के डउकी आसनत ओन के पुजारी पोतीपेरा के टोरिया रथै, अकाल के पहिले साल के आमै लग यूसुफ अउ ओसनत के दुइठे टोरवा हुइन। <verse eid="GEN 41:50" /><verse number="51" style="v" sid="GEN 41:51" />यूसुफ पहिले टोरवा के नाम मनस्से रखिस काखे उन सोचिस, “भगवान सगलू दुख परेसानी अउ मोर बाफ के परवार के भुलवामै हे मोर मदत करे हबै।” <verse eid="GEN 41:51" /><verse number="52" style="v" sid="GEN 41:52" />यूसुफ दूसर टोरवा के नाम एप्रैम रखिस, काखे ओखर कहै के मतलब हइ रथै, कि मोके दुख मिलै के जिघा हे हइ देस हे भगवान मोके आसीस दय हबै। <verse eid="GEN 41:52" /><verse number="53" style="v" sid="GEN 41:53" />जब मिस्र देस हे दाना के ऊ सात साल खतम हुइस, <verse eid="GEN 41:53" /><verse number="54" style="v" sid="GEN 41:54" />तब अकाल के सात साल सुरुवात हुइस, जसना यूसुफ कहे रथै, सगलू देस हे अकाल रथै, पय मिस्र देस हे दाना के कउनो कमी नेहको रथै।<note caller="+" style="x"><char style="xo" closed="false">41:54 </char><char style="xt" closed="false"><ref loc="ACT 7:11">प्रेरितो 7:11</ref></char></note> <verse eid="GEN 41:54" /><verse number="55" style="v" sid="GEN 41:55" />जब मिस्र देस हे दाना के कमी होमै लगिस तब मनसे फिरोन लग दाना मांगै लगिन, फिरोन मिस्र के मनसे लग कथै, तुम “यूसुफ के लिघ्घो जा, ऊ जउन कुछु कहै उहै करिहा।<note caller="+" style="x"><char style="xo" closed="false">41:55 </char><char style="xt" closed="false"><ref loc="JHN 2:5">यूहन्ना 2:5</ref></char></note>” <verse eid="GEN 41:55" /><verse number="56" style="v" sid="GEN 41:56" />जब पूरे देस हे अकाल पडिस, तब यूसुफ अपन गोदाम के खोल के मिस्र देस के निवासी के दाना बेचै का सुरु करिस, काखे अकाल बोहत जादा रथै। <verse eid="GEN 41:56" /><verse number="57" style="v" sid="GEN 41:57" />दूसर-दूसर देस के मनसे मिस्र हे यूसुफ के लिघ्घो दाना खरीदै के निता आमै लगिन, काखे सगलू देस हे अकाल बोहत जादा हुइ चुकथै।<verse eid="GEN 41:57" /></para>
  <chapter eid="GEN 41" />
  <chapter number="42" style="c" sid="GEN 42" />
  <para style="s">यूसुफ के भाई मिस्र देस हे आथै</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 42:1" />जब याकूब सुनिस कि मिस्र देस हे दाना हबै तब अपन टोरवा लग कथै, “तुम अक दूसर के मुंह काखे देखथा?” <verse eid="GEN 42:1" /><verse number="2" style="v" sid="GEN 42:2" />मै सुने हव कि मिस्र देस हे दाना हबै, तुम उहां जा, अउ हमर निता दाना खरीद के लाबा, जेखर लग हम झइ मरी पय जिन्दा रही।<note caller="+" style="x"><char style="xo" closed="false">42:2 </char><char style="xt" closed="false"><ref loc="ACT 7:12">प्रेरितो 7:12</ref></char></note> <verse eid="GEN 42:2" /><verse number="3" style="v" sid="GEN 42:3" />पय यूसुफ के दस भाई दाना खरीदै के निता मिस्र देस हे आइन। <verse eid="GEN 42:3" /><verse number="4" style="v" sid="GEN 42:4" />याकूब यूसुफ के भाई बिन्यामीन के उनखर संग नेहको पठोथै, उके डर रथै कि कहुं बिन्यामीन के उप्पर कउनो परेसानी झइ आ पडै। <verse eid="GEN 42:4" /><verse number="5" style="v" sid="GEN 42:5" />आमै बाले याकूब के टोरवा रथै जउन दाना खरीदय के निता आय रथै, काखे कनान देस हे अकाल रथै।<note caller="+" style="x"><char style="xo" closed="false">42:5 </char><char style="xt" closed="false"><ref loc="ACT 7:11">प्रेरितो 7:11</ref></char></note> <verse eid="GEN 42:5" /><verse number="6" style="v" sid="GEN 42:6" />हइ टेम यूसुफ मिस्र देस के राजा रथै, केबल यूसुफ रथै जउन मिस्र देस हे आमै बाले मनसेन के दाना बेचै का आदेस दय करथै, यूसुफ के भाई ओखर लिघ्घो आइन अउ उन उके निहुर के परनाम करिन। <verse eid="GEN 42:6" /><verse number="7" style="v" sid="GEN 42:7" />यूसुफ अपन भाइयन के देखिस अउ उनके चीन लेथै, पय यूसुफ उनखर लग हइ मेर बात करथै जसना ऊ उनके नेहको चीनथै, ऊ उनखर संग गुस्सा लग बात करथै, “तुम कछो लग आय हबा?” उन कथै, “हम कनान देस लग आय हवन।” <verse eid="GEN 42:7" /><verse number="8" style="v" sid="GEN 42:8" />यूसुफ अपन भाई के जानथै, पय उन उके नेहको चीनथै। <verse eid="GEN 42:8" /><verse number="9" style="v" sid="GEN 42:9" />यूसुफ उन सपना के बारे हे सुरता करथै, जउन अपन भाई के बारे हे देखे रथै, यूसुफ कथै, “तुम दाना खरीदै के निता नेहको आय हबा, तुम हइ पता लगामै के निता आय हबा कि हम कछो लग ढिलवा हवन?<note caller="+" style="x"><char style="xo" closed="false">42:9 </char><char style="xt" closed="false"><ref loc="GEN 37:5">उत्पति 37:5</ref>,<ref loc="GEN 37:9">9</ref></char></note>” <verse eid="GEN 42:9" /><verse number="10" style="v" sid="GEN 42:10" />उन यूसुफ लग कथै, “नेहको मालिक, हम तोर लिघ्घो दाना खरीदै के निता आय हवन। <verse eid="GEN 42:10" /><verse number="11" style="v" sid="GEN 42:11" />हम सब एक्कै डउका के टोरवा हवन, हम सही मनसे हवन, हम इमानदार हवन।” <verse eid="GEN 42:11" /><verse number="12" style="v" sid="GEN 42:12" />तब यूसुफ उनखर लग कथै, “नेहको, तुम हइ पता लगामै के निता आय हबा कि हम कछो लग ढिलवा हवन?” <verse eid="GEN 42:12" /><verse number="13" style="v" sid="GEN 42:13" />उन कथै, “हम सगलू भाई हवन, हमर परवार हे बारह भाई हवन, अउ कनान देस वासी हम सब के एक्कै बाफ हबै, हमर सब लग नान भाई हमर बाफ के लिघ्घो घर हे हबै, अउ दूसर भाई बोहत पहिले मर गय हबै।” <verse eid="GEN 42:13" /><verse number="14" style="v" sid="GEN 42:14" />पय यूसुफ कथै, “जउन बात मै तुम्हर लग कहे हव, ऊ निक्खा हबै, तुम जासूस मनसे हबा। <verse eid="GEN 42:14" /><verse number="15" style="v" sid="GEN 42:15" />तुम्हर छानबीन करे जही, फिरोन के जीवन के किरिया, जब तक तुम्हर नान भाई इहां नेहको आय जाय, तब तक तुम इहां लग नेहको जाय सकिहा। <verse eid="GEN 42:15" /><verse number="16" style="v" sid="GEN 42:16" />इहैनिता तुम मसे अकझन जाय, अउ अपन नान भाई के इहां लइके आबै, तब तक तुम जेल हे रइहा जेखर लग तुम सही बोलथा कि नेहको, अगर सही नेहको ठहरिया तब फिरोन कर जीवन कर कसम तुम जरूर झूठा हुइहा, पय मोके बिस्वास हबै, कि तुम बुराई करे बाले मनसे हबा।” <verse eid="GEN 42:16" /><verse number="17" style="v" sid="GEN 42:17" />यूसुफ उन सब के तीन रोज तक जेल हे बेडवा देथै। <verse eid="GEN 42:17" /><verse number="18" style="v" sid="GEN 42:18" />यूसुफ तीसर रोज के बाद उनखर लग कथै, “हइ काम करा तब जिन्दा रइहा, काखे मै भगवान लग डरथो। <verse eid="GEN 42:18" /><verse number="19" style="v" sid="GEN 42:19" />अगर तुम इमानदार मनसे हबा ता तुम्हर भाई मसे अकझन जेल हे रहै, बाकी भाई अपन भूंखे परवार कर निता दाना लइके जाय, <verse eid="GEN 42:19" /><verse number="20" style="v" sid="GEN 42:20" />तब अपन सब लग नान भाई के लइके इहां मोर लिघ्घो लाबा, तबै मै बिस्वास करिहों, कि तुम सही बोलथा।” <verse eid="GEN 42:20" /><verse number="21" style="v" sid="GEN 42:21" />उन आपन हे सोचिन, “सही हे हम अपन भाई यूसुफ के परति दोसी हवन, हम ओखर आतमा के कस्ट देखे रथन, जब ऊ हमर लग दया के भीख मांगिस तब हम नेहको सुनन, तबै हइ हमर उप्पर कस्ट आय हबै।” <verse eid="GEN 42:21" /><verse number="22" style="v" sid="GEN 42:22" />तब रूबेन उनखर लग कथै, “मै तुम्हर लग कहे रथो कि ऊ टोरवा के कुछु पाप झइ करा, पय तुम मोर बात एक्को नेहको सुना, इहैनिता अब हम ओखर मिरतू के निता सजा भोगत हवन।” <verse eid="GEN 42:22" /><verse number="23" style="v" sid="GEN 42:23" />उन नेहको जानथै कि यूसुफ उनखर बात के समझथै, काखे उनखर बीच हे दुइ मेर के भासा बोले बाले रथै। <verse eid="GEN 42:23" /><verse number="24" style="v" sid="GEN 42:24" />यूसुफ उनखर लिघ्घो लग हटके रोमै लगिस, अउ ऊ फेरै उनखर लिघ्घो लउटिस अउ उनखर लग बात करिस, यूसुफ उन मसे सिमोन के लइके उनखर आंखी के लिघ्घो उके बन्दी बनाय लइस।<verse eid="GEN 42:24" /></para>
  <para style="s">यूसुफ के भाई कनान देस छो वापिस लउटथै</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 42:25" />एखर बाद यूसुफ आदेस देथै कि उनखर बोरा दाना लग भरे जाय, हर मनसे के बोरा हे चांदी कर पइसा रखे जाय, उनखर रास्ता के निता खाना पीना रखे जाय, उनखर निता ओसनेन करे गइस। <verse eid="GEN 42:25" /><verse number="26" style="v" sid="GEN 42:26" />यूसुफ के भाई दाना के अपन गदहा हे लादिन अउ उहां लग कढ गइन। <verse eid="GEN 42:26" /><verse number="27" style="v" sid="GEN 42:27" />जब उन मसे अक्ठी भाई सार हे अपन गदहा के चारा दे के निता अपन बोरा खोलिस, तब ऊ बोरा के मुंह हे अपन चांदी कर पइसा रखे हर देखिस। <verse eid="GEN 42:27" /><verse number="28" style="v" sid="GEN 42:28" />ऊ अपन भाई लग बोलथै, “मोर पइसा लउटाय दय गय हबै, देखा, हइ मोर बोरा हे हबै।” हइ सुनके ऊ जीव हे जान नेहको रथै, उन बोहत डर गय रथै अउ अक दूसर के देखे लग जथै, उन कथै, “भगवान हमर संग हइ काहिन करिस?” <verse eid="GEN 42:28" /><verse number="29" style="v" sid="GEN 42:29" />जब उन कनान देस हे अपन बाफ याकूब के लिघ्घो आइन तब उन अपन संग घटे हर घटना के गुठेइस, उन कथै, <verse eid="GEN 42:29" /><verse number="30" style="v" sid="GEN 42:30" />मिस्र देस के मालिक हमर लग ठोस लग बात करिस, ऊ हमके ऊ देस हे बेकार मनसे समझिस। <verse eid="GEN 42:30" /><verse number="31" style="v" sid="GEN 42:31" />पय हम ओखर लग कहब, “हम सही मनसे हवन, हम बेकार मनसे नेहको हवन। <verse eid="GEN 42:31" /><verse number="32" style="v" sid="GEN 42:32" />हम बारह भाई हवन, हम एक्कै बाफ के टोरवा हवन, अक्ठी भाई अब नेहको हबै, सब लग नान हस भाई ई टेम कनान देस हे हमर बाफ के लिघ्घो हबै।” <verse eid="GEN 42:32" /><verse number="33" style="v" sid="GEN 42:33" />तब देस के राजा हमर लग हइ कहिस, “हइ साबित करै के निता कि तुम सही मनसे हबा हइ रास्ता हबै, अपन भाई मसे अक्ठी के हमर लिघ्घो इहां छांड दे, अपन दाना लइके अपन परवार के लिघ्घो लउट जा। <verse eid="GEN 42:33" /><verse number="34" style="v" sid="GEN 42:34" />अउ अपन सब लग नान भाई के मोर लिघ्घो लाबा, तब मोके बिस्वास होही कि तुम बेकार मनसे नेहको, पय सही मनसे हबा, मै तुम्हर भाई के तोके सउप दइहों, तब तुम हइ देस हे लेन देन कर सकिहा।” <verse eid="GEN 42:34" /><verse number="35" style="v" sid="GEN 42:35" />उन दाना के बोरा खोलिन ता देखिन कि हर मनसे के पइसा के थइली ओखर बोरा हे हबै, जब उन अउ उनखर बाफ पइसा के थइली देखथै तब ऊ डर गइस। <verse eid="GEN 42:35" /><verse number="36" style="v" sid="GEN 42:36" />उनखर बाफ याकूब उनखर लग कथै, तुम मोके बगैर लरका के कर देया, यूसुफ नेहको रहिस, अब सिमोनो नेहको रहिस, अब तुम बिन्यामीन के लइ जइहा, हइ सब परेसानी मोर उप्पर आय पडे हबै। <verse eid="GEN 42:36" /><verse number="37" style="v" sid="GEN 42:37" />तब रूबेन अपन बाफ लग कथै, “अगर मै बिन्यामीन के वापिस लइके नेहको आहुं ता मोर दोनो टोरवा के मार डरिहा, उके मोर हाथ हे देया, मै उके तोर लिघ्घो वापिस लइहों।” <verse eid="GEN 42:37" /><verse number="38" style="v" sid="GEN 42:38" />पय याकूब कथै, “मै बिन्यामीन के तुम्हर संग नेहको पठोहुं, ओखर भाई मर चुके हबै, अउ मोर डउकी राहेल के उहै अकेल्ले टोरवा बचे हबै, मिस्र देस के यातरा हे अगर ओखर संग कुछु हुइ गय ता ऊ घटना मोके मार डालही, तुम मोके डोकरा के टेम हे अधलोक हे दुखी करके पठोइहा।”<verse eid="GEN 42:38" /></para>
  <chapter eid="GEN 42" />
  <chapter number="43" style="c" sid="GEN 43" />
  <para style="s">बिन्यामीन मिस्र देस छो गइस</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 43:1" />कनान देस हे अकाल अउ जादा होउत गय। <verse eid="GEN 43:1" /><verse number="2" style="v" sid="GEN 43:2" />मनसे ऊ सगलू दाना खाय गइन जउन ऊ मिस्र देस लग लाय रथै, जब दाना समापत हुइ गय, तब याकूब अपन टोरवन लग कथै, “फेरै मिस्र देस हे जा, अउ हम सब के निता खाय के कुछ अउ दाना खरीद के लाबा।” <verse eid="GEN 43:2" /><verse number="3" style="v" sid="GEN 43:3" />यहूदा अपन बाफ लग कथै, “मिस्र देस के राजा हमके चेतन्त दय हबै, जब तक तुम्हर संग तुम्हर भाई नेहको होही, तुम मोर लग बात नेहको कर सकथा। <verse eid="GEN 43:3" /><verse number="4" style="v" sid="GEN 43:4" />अगर तै हमर संग हमर भाई बिन्यामीन के पठोइहे तबै हम मिस्र देस जउबे अउ तोर निता दाना खरीद के लउबे। <verse eid="GEN 43:4" /><verse number="5" style="v" sid="GEN 43:5" />पय अगर तै बिन्यामीन के पठोमै लग मना कर देबे ता हम नेहको जउबे, ऊ राजा चेतन्त दय हबै कि हम ओखर बेगैर लउटके नेहको अइ।” <verse eid="GEN 43:5" /><verse number="6" style="v" sid="GEN 43:6" />तब याकूब कथै, “तुम ऊ मनसे लग काखे कहे हबा, कि तुम्हर दूसर भाई हबै, तुम मोर संग असना बेकार बात काखे करा?” <verse eid="GEN 43:6" /><verse number="7" style="v" sid="GEN 43:7" />उन जबाब देथै, “ऊ मनसे हमर लग आराम के संग सबाल पूंछिस, ऊ हमर मनसे अउ परवार के बारे हे जानै के चाहथै ऊ हमर लग पूंछिस, का तुम्हर बाफ अबे जिन्दा हबै? का तुम्हर दूसर भाई घर हे हबै? तब हम ओखर सबाल के जबाब दयन, हम नेहको जानत रहन कि ऊ हमर दूसर भाई के अपन लिघ्घो लामै का कहि।” <verse eid="GEN 43:7" /><verse number="8" style="v" sid="GEN 43:8" />तब यहूदा अपन बाफ इस्राएल लग कथै, “बिन्यामीन के मोर संग पठो, मै ओखर देखभाल करिहों, हम मिस्र देस हे जरूर जउबे अउ दाना लउबे, अगर हम नेहको जउबे ता हमर लरका मर जइहिन। <verse eid="GEN 43:8" /><verse number="9" style="v" sid="GEN 43:9" />मै बिस्वास दिलाथो कि ऊ सुरक्छित रही, मै एखर जिम्मेदारी लेथै, अगर मै उके तोर लिघ्घो वापिस नेहको लइहों ता तै हरमेसा के निता मोके दोसी ठहराय सकथस। <verse eid="GEN 43:9" /><verse number="10" style="v" sid="GEN 43:10" />अगर हम देरी नेहको करथन ता अब तक दुइ बेर आना-जाना कर चुकथन। <verse eid="GEN 43:10" /><verse number="11" style="v" sid="GEN 43:11" />उनखर बाफ याकूब उनखर लग कथै, अगर असना बात हबै ता इहै करा, अपन बोरा हे कनान देस के सब लग निक्खा चीज धरा, मोहरस कर रस, पिस्ते, बादाम, गोंद अउ लोबान इके मिस्र देस के राजा के भेंट दे के निता लइ जा। <verse eid="GEN 43:11" /><verse number="12" style="v" sid="GEN 43:12" />अपन हाथ हे दुगुनी पइसा लइ जा, जउन पइसा तुम्हर बोरा हे लउट आय रथै, उके अपन संग वापिस लइ जा, जरूर राजा लग गलती होय होही। <verse eid="GEN 43:12" /><verse number="13" style="v" sid="GEN 43:13" />अपन भाई बिन्यामीन के अपन संग लइ जा, अउ मिस्र देस के राजा के लिघ्घो फेरै जा। <verse eid="GEN 43:13" /><verse number="14" style="v" sid="GEN 43:14" />मै बिनती करथो कि सक्तिमान भगवान तुम्हर ऊ टेम मदत करही, जब तुम राजा के आगू ठाढ हुइहा, मै बिनती करथो कि ऊ बिन्यामीन अउ सिमोन के सुरक्छित आमै दइ, अगर असना नेहको होही ता मै बिगर टोरवा के हुइ जइहों।” <verse eid="GEN 43:14" /><verse number="15" style="v" sid="GEN 43:15" />इहैनिता भाई राजा के दे के निता भेंट लइन अउ उन जेकता पइसा पहिले लय रथै, ओखर दुइ गुना अपन संग लइन अउ बिन्यामीन भाई के संग मिस्र देस छो गइस, मिस्र हे पहुंच के यूसुफ के आगू खडा हुइन। <verse eid="GEN 43:15" /><verse number="16" style="v" sid="GEN 43:16" />यूसुफ उनखर संग बिन्यामीन के देखिस, ता ऊ अपन घर के अधिकारी लग कथै, उन मनसे के मोर घर हे लाबा, अक्ठी पसु मारके खाना तइयार करा, हइ मनसे दुपहरी हे मोर संग खाना खइहिन। <verse eid="GEN 43:16" /><verse number="17" style="v" sid="GEN 43:17" />अधिकारी के जसना कहे गय रथै, ओसनेन करथै, ऊ उन मनसे के यूसुफ के घर हे लइ गय। <verse eid="GEN 43:17" /><verse number="18" style="v" sid="GEN 43:18" />उन डर गइन, काखे उनके यूसुफ के घर हे लइ गय रथै, उन कथै, “जउन पइसा पहिले बेर हमर बोरा हे धररे रथै, उहै के कारन हमके इंहा लय गय हबै, जेखर लग ऊ हमर उप्पर दोस लागय हमके हरवाह बना सकै अउ हमर गदहन के लइ ले।” <verse eid="GEN 43:18" /><verse number="19" style="v" sid="GEN 43:19" />तब यूसुफ के घर के देख रेख करै बाले अधिकारी के लिघ्घो सगलू भाई गइन। <verse eid="GEN 43:19" /><verse number="20" style="v" sid="GEN 43:20" />उन कथै, हे हमर मालिक, हम पहिले दाना खरीदै के निता आय रथन। <verse eid="GEN 43:20" /><verse number="21" style="v" sid="GEN 43:21" />तब हम लउटके सार हे आयन अउ अपन बोरा के खोलन, तब देखन कि हमर बोरा के मुंह हे टुल्य रथै, इहैनिता हम ऊ पइसा के अपन संग वापिस लइके आय हवन। <verse eid="GEN 43:21" /><verse number="22" style="v" sid="GEN 43:22" />हम दाना खरीदय के निता अपन हाथ हे दूसर पइसा लाय हवन, हम नेहको जानथन कि कउन मनसे हमर बोरा हे पइसा वापिस धरे रथै। <verse eid="GEN 43:22" /><verse number="23" style="v" sid="GEN 43:23" />ऊ कथै, बेफिकर रहा, झइ डेरा, तुम्हर भगवान तुम्हर बाफ के भगवान बोरा हे तुम्हर निता पइसा धरे होही। मोके तुम्हर पइसा मिल गय रथै, एखर बाद ऊ सिमोन के निकार के उनखर लिघ्घो लाइस। <verse eid="GEN 43:23" /><verse number="24" style="v" sid="GEN 43:24" />घर के अधिकारी उनके यूसुफ के घर हे लइ गइन, ऊ उनके पानी दइस, उन अपन गोड धोइन, ऊ उनके गदहन के चारो दइस। <verse eid="GEN 43:24" /><verse number="25" style="v" sid="GEN 43:25" />सुनिन कि ऊ यूसुफ के संग खाना खइहिन, इहैनिता ओखर निता अपन भेंट तइयार करै हे ऊ दुपहरी लगे रहिस। <verse eid="GEN 43:25" /><verse number="26" style="v" sid="GEN 43:26" />यूसुफ घर छो आइस अउ भाई उके भेंट दइन जउन ऊ अपन संग लाय रथै, अउ उन निहुर के परनाम करिन। <verse eid="GEN 43:26" /><verse number="27" style="v" sid="GEN 43:27" />यूसुफ उनखर हालचाल पूंछिस, अउ कथै, “तुम्हर बाफ जेखर बारे हे तुम गुठे हबा, निक्खा तो हबै? का ऊ अब तक जिन्दा हबै?” <verse eid="GEN 43:27" /><verse number="28" style="v" sid="GEN 43:28" />उन जबाब देथै, “मालिक हमर बाफ निक्खा हबै, ऊ अब तक जिन्दा हबै” अउ ऊ फेर उन घुटवा<note caller="+" style="f"><char style="fr" closed="false">43:28 </char><char style="ft" closed="false">घुटना </char></note> टेकके परनाम करिन। <verse eid="GEN 43:28" /><verse number="29" style="v" sid="GEN 43:29" />तब यूसुफ अपन भाई बिन्यामीन के देखिस, यूसुफ कथै, “का हइ तुम्हर सब लग नान भाई हबै जेखर बारे हे तुम गुठे रहा?” तब यूसुफ बिन्यामीन लग कथै, “भगवान तोर उप्पर किरपा करै।” <verse eid="GEN 43:29" /><verse number="30" style="v" sid="GEN 43:30" />तब यूसुफ कोठा लग बाहिर दउर के गइस, यूसुफ बोहत चाहथै कि ऊ अपन भाई के देखाबै कि ऊ उनखर लग केतका माया करथै, ऊ रोमै लग जथै, पय ऊ नेहको चाहथै कि ओखर भाई उके रोउत देखै, इहैनिता ऊ अपन कोठा हे दउरत पहुंचिस अउ उहै रोइस। <verse eid="GEN 43:30" /><verse number="31" style="v" sid="GEN 43:31" />तब यूसुफ अपन मुंह धोइस अउ बाहिर आइस, ऊ खुद के संभारिस अउ कथै, “आबा खाना खाय के टेम हबै।” <verse eid="GEN 43:31" /><verse number="32" style="v" sid="GEN 43:32" />यूसुफ अकेल्ले अक्ठी टेबुल हे खाना खाइस, ओखर भाई दूसर टेबुल हे अक संग खाना खाइन, मिस्र मनसे दूसर टेबुल हे अक संग खाना खाइन, उनखर बिस्वास रथै कि उनखर निता हइ जरूरी हबै कि ऊ इबरानी मनसे के संग खाय। <verse eid="GEN 43:32" /><verse number="33" style="v" sid="GEN 43:33" />यूसुफ के भाई ओखर आगू टेबुल हे बइठे रथै, सगलू बडा भाई लग नान भाई तक लइन बार बइठे रथै, सगलू भाई अक दूसर के जउन होउत रथै, ऊ चकित करत देखत रथै। <verse eid="GEN 43:33" /><verse number="34" style="v" sid="GEN 43:34" />सेबक यूसुफ के टेबुल लग उनके खाना लेत जात देखथै, पय अउरन के बरोबरी हे सेबकन बिन्यामीन के पांच गुना जादा दइस, यूसुफ के संग ऊ सगलू भाई तब तक खाउत अउ मोहरस के रस्सा पीत रहै जब तक ऊ नसा हे चूर नेहको हुइ गइस।<verse eid="GEN 43:34" /></para>
  <chapter eid="GEN 43" />
  <chapter number="44" style="c" sid="GEN 44" />
  <para style="s">चांदी के खोरिया</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 44:1" />तब यूसुफ अपन हरवाह के आदेस देथै, यूसुफ कथै, “उन मनसेन के बोरा हे एतका दाना भरा जेतका इन लइ जा सकै अउ हर अक्ठी पइसा ऊ दाना के बोरा हे रख देया। <verse eid="GEN 44:1" /><verse number="2" style="v" sid="GEN 44:2" />सब लग नान भाई के बोरा हे पइसा रखा, पय ओखर बोरा हे मोर खास चांदी के खोरिया रख देया।” जसना यूसुफ कथै ओसनेन करिन। <verse eid="GEN 44:2" /><verse number="3" style="v" sid="GEN 44:3" />अगले रोज बोहत सुबेन्ने सब भाई अपन गदहन के संग अपन देस छो वापिस कढ गइन। <verse eid="GEN 44:3" /><verse number="4" style="v" sid="GEN 44:4" />ऊ सहर लग जादा दुरिहां नेहको गय रथै, कि यूसुफ अपन घर के साहबन लग कथै, जा उन मनसे के पीछा करा, जब तुम उनखर लिघ्घो पहुंचा, तब उनखर लग कहबे, “काखे तुम भलाई कर बलदा बुराई करा? काखे तुम मोर मालिक के चांदी के खोरिया चुराया? <verse eid="GEN 44:4" /><verse number="5" style="v" sid="GEN 44:5" />हमर मालिक इहै खोरिया लग पीथै, ऊ सपना के बिचार के निता इहै खोरिया के निस्तार करथै, ई खोरिया के चुराय के तुम गलती करे हबा।” <verse eid="GEN 44:5" /><verse number="6" style="v" sid="GEN 44:6" />तब ऊ उनके जाय के पकड लइन अउ असना बात उनखर लग कथै। <verse eid="GEN 44:6" /><verse number="7" style="v" sid="GEN 44:7" />उन उनखर लग कथै, “मालिक असना बात काखे कथै? असना काम करैका तोर हरवाहन लग दुरिहां रहन। <verse eid="GEN 44:7" /><verse number="8" style="v" sid="GEN 44:8" />हम कनान देस लग ऊ पइसा लउटाय दय रथन जउन पहिले हमर बोरा हे मिले रथै, इहैनिता जरूर हम तुम्हर मालिक के घर लग चांदी या सोना नेहको चुराय हवन। <verse eid="GEN 44:8" /><verse number="9" style="v" sid="GEN 44:9" />अगर तुम कउनो बोरा हे चांदी के ऊ खोरिया पाय जाय ता ऊ मनसे के मिरतू सजा दय जाय अउ हमु मालिक के हरवाह बन जउबे।” <verse eid="GEN 44:9" /><verse number="10" style="v" sid="GEN 44:10" />हरवाह कथै, “जसना तुम कथा हम ओसनेन करब, पय ऊ मनसे के नेहको मारब, अगर मोके चांदी के खोरिया मिलही ता ऊ मनसे मोर हरवाह होही अउ दूसर भाई आजाद हुइ जइहिन।” <verse eid="GEN 44:10" /><verse number="11" style="v" sid="GEN 44:11" />तब सगलू भाई अपन बोरिन के हरबी खोल के भुंइ हे रखिन। <verse eid="GEN 44:11" /><verse number="12" style="v" sid="GEN 44:12" />हरवाह बोरिन के हरबी भुंइ हे मढाय के खोलिन, बोरिन के देखिन, ऊ सब लग बडा भाई लग सुरुवात करथै अउ सब लग नान भाई हे समापत करिन, ऊ बिन्यामीन के बोरा हे खोरिया पाय गय। <verse eid="GEN 44:12" /><verse number="13" style="v" sid="GEN 44:13" />भाई बोहत दुख हुइन, उन दुख के कारन अपन कपडा चीर डारिन, उन अपन बोरा गदहा के उप्पर लादिन अउ सहर छो लउट गइन। <verse eid="GEN 44:13" /><verse number="14" style="v" sid="GEN 44:14" />यहूदा अउ ओखर भाई यूसुफ के घर हे आइन। यूसुफ उहै रथै, ऊ ओखर लिघ्घो भुंइ हे निहुर के परनाम करिन। <verse eid="GEN 44:14" /><verse number="15" style="v" sid="GEN 44:15" />यूसुफ उनखर लग कथै, “तुम हइ कसना काम करा? का तुम नेहको जानथा कि मोर जसना जरूर सोच बिचार कर सकथै?” <verse eid="GEN 44:15" /><verse number="16" style="v" sid="GEN 44:16" />यहूदा कथै, “मालिक, हम काहिन कहि सकथन? हम काहिन बोली? हम कसना अपन के निरदोस साबित करी? भगवान तोर हरवाहन के दुस्करम के पता लगा लय हबै, अब हम अउ ऊ जेखर लिघ्घो खोरिया पाय गय हबै, तोर हरवाह हबै।” <verse eid="GEN 44:16" /><verse number="17" style="v" sid="GEN 44:17" />यूसुफ कथै, “असना काम मोर लग दुरिहां रहै, जउन मनसे के लिघ्घो खोरिया पाय गय हबै, उहै मोर हरवाह बनही, तुम आराम के संग अपन बाफ के लिघ्घो कढ जा।”<verse eid="GEN 44:17" /></para>
  <para style="s">बिन्यामीन के निता यहूदा के बिनती</para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 44:18" />तब यहूदा के लिघ्घो आथै, अउ ऊ कथै, “हे मोर मालिक, किरपा करके अपन हरवाह के आदेस दे कि ऊ तोर लग कुछु कहि सकै, तोर हरवाह के उप्पर तोर गुस्सा झइ भडकै, काखे तै खुद फिरोन के जसना हबस।” <verse eid="GEN 44:18" /><verse number="19" style="v" sid="GEN 44:19" />जब हम पहिले इहां आय रथन, मोर परभु अपन सेबक लग पूंछे रहस कि का तोर बाफ या भाई हबै? <verse eid="GEN 44:19" /><verse number="20" style="v" sid="GEN 44:20" />अउ हम अपन परभु लग कहन, हमर बाफ अक्ठी हबै, ऊ डोकरा हबै अउ हमर अक्ठी नान भाई हबै, हमर बाफ ओखर लग बोहत जादा परेम करथै, काखे ओखर पइदा बुढापा हे होय रथै, हइ अकेल्ले टोरवा हबै, हमर बाफ ओखर लग बोहत जादा परेम करथै। <verse eid="GEN 44:20" /><verse number="21" style="v" sid="GEN 44:21" />तब तै हमर लग कहे रथस, ऊ भाई के मोर लिघ्घो लाबा, उके मै देखे चाहथो। <verse eid="GEN 44:21" /><verse number="22" style="v" sid="GEN 44:22" />अउ हम अपन परभु लग कहे रथन, ऊ नान लरका हबै, ऊ अपन बाफ के छांड के नेहको आ सकथै, अगर ऊ अपन बाफ के छांडही ता ओखर बाफ मर जही। <verse eid="GEN 44:22" /><verse number="23" style="v" sid="GEN 44:23" />तब तै हमके अपन हरवाह के चेतन्त दय रथस, “जब तक तुम्हर संग तुम्हर नान भाई नेहको आही, तुम मोर लग बात नेहको कर सकथा।” <verse eid="GEN 44:23" /><verse number="24" style="v" sid="GEN 44:24" />इहैनिता हम अपन बाफ के लिघ्घो लउटके गयन अउ तै जउन कहे रथस, परभु के उन बातन के गुठेयन। <verse eid="GEN 44:24" /><verse number="25" style="v" sid="GEN 44:25" />जब हमर बाफ कहिस, “मिस्र देस फेरै जा अउ हमर निता कुछ भोजन दाना पानी खरीद के लाबा।” <verse eid="GEN 44:25" /><verse number="26" style="v" sid="GEN 44:26" />तब हम कहे रथन, “हम नेहको जाय सकथन, अगर हमर नान भाई हमर संग जही ता हम जइबे, काखे जब तक हमर नान भाई हमर संग नेहको जही, तब तक हम मिस्र देस के राजा लग बात नेहको कर सकथन।” <verse eid="GEN 44:26" /><verse number="27" style="v" sid="GEN 44:27" />तब हमर बाफ हमर लग कहे रथै, तुम जानथा कि मोर डउकी राहेल मोके दुइठे टोरवा दइस। <verse eid="GEN 44:27" /><verse number="28" style="v" sid="GEN 44:28" />मै अक्ठी टोरवा के दूरी जाय दयों अउ ऊ पतेरा के जानवर दवारा मारे गइस अउ तब लग मै उके नेहको देखे हव। <verse eid="GEN 44:28" /><verse number="29" style="v" sid="GEN 44:29" />अगर तुम मोर दूसर टोरवा के मोर लग दुरिहां लइ जइहा ता अगर उके कुछु हुइ गय ता मै मर जइहों। <verse eid="GEN 44:29" /><verse number="30" style="v" sid="GEN 44:30" />इहैनिता अगर अब हमर बाफ हइ देखै का पडही, हइ नान टोरवा हमर बाफ के जीवन हे सब लग जादा खास रखथै। <verse eid="GEN 44:30" /><verse number="31" style="v" sid="GEN 44:31" />जब ऊ देखही कि नान टोरवा हमर संग नेहको हबै ता ऊ मर जही अउ हइ हमर दोस होही, हम अपन बाफ के जादा दुख अउ मिरतू के कारन हुइबे। <verse eid="GEN 44:31" /><verse number="32" style="v" sid="GEN 44:32" />तोर हरवाह, मै अपन बाफ लग टोरवा के सुराक्छा के जिम्मेदारी लय हव, “अगर मै उके तोर लिघ्घो वापिस नेहको लाथो ता मै तोर परति जीवन भर दोसी बने रइहों।” <verse eid="GEN 44:32" /><verse number="33" style="v" sid="GEN 44:33" />इहैनिता अब मै तोर लग मांगथो अउ तोर लग बिनती करथो कि किरपा करके नान टोरवा के अपन भाइन के संग जाय दे, अउ मै इंहा रुकिहों अउ तोर हरवाह रइहों। <verse eid="GEN 44:33" /><verse number="34" style="v" sid="GEN 44:34" />मै अपन बाफ के लिघ्घो नेहको लउट सकथो, अगर हमर संग नान भाई नेहको रही, मै ई बात लग बोहत जादा डरे हव कि मोर बाफ के संग का होही।<verse eid="GEN 44:34" /></para>
  <chapter eid="GEN 44" />
  <chapter number="45" style="c" sid="GEN 45" />
  <para style="s">यूसुफ खुद के अपन भाइन हे परगट करिस</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 45:1" />तब यूसुफ उन सब के आगू जउन ओखर लिघ्घो अगल बगल ठाढ रथै, खुद के अउ नेहको रोक सकिस अउ चिल्लाय के कथै, “मोर अगल बगल लग सब मनसे के बाहिर कर देया।” जब यूसुफ खुद के भाई के आगू परगट करिस तब ओखर संग कउ नेहको रथै।<note caller="+" style="x"><char style="xo" closed="false">45:1 </char><char style="xt" closed="false"><ref loc="ACT 7:13">प्रेरितो 7:13</ref></char></note> <verse eid="GEN 45:1" /><verse number="2" style="v" sid="GEN 45:2" />तब ऊ चिल्ला चिल्लाय के रोमै लग जथै अउ मिस्र देस के मनसे सुनिन अउ फिरोन के घर के मनसे एखर संदेस मिलिस। <verse eid="GEN 45:2" /><verse number="3" style="v" sid="GEN 45:3" />यूसुफ अपन भाई लग कथै, “मै यूसुफ हव, का अब तक मोर बाफ जिन्दा हबै?” ओखर भाई ओही जबाब नेहको दइ सकथै, काखे उन ओखर आगू घबराय गय रथै। <verse eid="GEN 45:3" /><verse number="4" style="v" sid="GEN 45:4" />फेर यूसुफ अपन भाई लग कथै, “मोर लिघ्घो आबा।” हइ सुनके ऊ लिघ्घो गइन, फेर ऊ कथै, “मै तुम्हर भाई यूसुफ हव, जेही तुम मिस्र देस लग आय बाले के हाथ हे बेच दय रथा। <verse eid="GEN 45:4" /><verse number="5" style="v" sid="GEN 45:5" />अब परेसान झइ होबा, तुम अपन करे हर गलती के निता दुख झइ होबा, ऊ मोर निता भगवान के योजना रथै कि मै इहां आव, मै इहां तुम्हर जीवन बचामै के निता आय हव। <verse eid="GEN 45:5" /><verse number="6" style="v" sid="GEN 45:6" />पिछले दुइ साल लग ई देस हे अकाल पडथै, अबे पांच साल अउ बाकी हबै, ऊ टेम हे न नागर चलही अउ न फसल होही। <verse eid="GEN 45:6" /><verse number="7" style="v" sid="GEN 45:7" />इहैनिता भगवान तुम्हर लग मोके पहिले पठोय हबै जेखर लग मै ई देस हे तुमके बचाय सको, अउ तुम्हर लरका बच सकै। <verse eid="GEN 45:7" /><verse number="8" style="v" sid="GEN 45:8" />इहैनिता तुम नेहको, पय भगवान मोके इहां पठोय हबै, उहै मोके फिरोन के बाफ जसना बनाइस, ताकि मै ओखर सगलू परवार अउ सगलू मिस्र देस के परभु रहों।” <verse eid="GEN 45:8" /><verse number="9" style="v" sid="GEN 45:9" />हरबी करा अउ मोर बाफ के लिघ्घो जाय के उनखर लग कहा, तोर टोरवा यूसुफ हइ कथै, भगवान सगलू मिस्र देस के मालिक मोके बनाय हबै, अब झइ रुका पय मोर लिघ्घो लइके आ जा।<note caller="+" style="x"><char style="xo" closed="false">45:9 </char><char style="xt" closed="false"><ref loc="ACT 7:14">प्रेरितो 7:14</ref></char></note> <verse eid="GEN 45:9" /><verse number="10" style="v" sid="GEN 45:10" />तुम गोसेन परदेस हे रइहा, तुम अपन टोरवा, नाती, छेडी गेडरा, गाय गोरू अउ अपन सगलू चीज सहित मोर लिघ्घो रइहा। <verse eid="GEN 45:10" /><verse number="11" style="v" sid="GEN 45:11" />अकाल के पांच साल हे मै तुम्हर देख-रेख करिहों, हइ मेर तोर अउ तोर परवार के जउन चीज हबै, उनखर तोके खोय के नेहको पडही। <verse eid="GEN 45:11" /><verse number="12" style="v" sid="GEN 45:12" />यूसुफ अपन भाई लग बात करत रथै, ऊ कथै, “अब तुम देखत रहा कि हइ सहीमा मै हव, अउ तुम्हर भाई बिन्यामीन जानथै कि हइ मै यहों। मै तुम्हर भाई तुम्हर लग बात करथो। <verse eid="GEN 45:12" /><verse number="13" style="v" sid="GEN 45:13" />इहैनिता मोर बाफ लग मोर मिस्र देस के जादा डेरा के बारे हे कहे, तुम जउन इहां देखे हबा, ऊ हर चीज के बारे हे मोर बाफ के गुठे, अब हरबी करा अउ मोर बाफ के लइके मोर लिघ्घो आबा।” <verse eid="GEN 45:13" /><verse number="14" style="v" sid="GEN 45:14" />तब यूसुफ अपन भाई बिन्यामीन के गले लगाय के रोमै लगिस, उहो ओखर गले लगाय के रोइस। <verse eid="GEN 45:14" /><verse number="15" style="v" sid="GEN 45:15" />ऊ अपन सगलू भाई के चूमिस अउ उनही गले लगाय के रोइस, एखर बाद यूसुफ के भाई ओखर लग बात चीत करिस। <verse eid="GEN 45:15" /><verse number="16" style="v" sid="GEN 45:16" />हइ बात के संदेस यूसुफ के भाई आय हबै, तब फिरोन के भवन तक पहुंच गइस अउ एखर लग फिरोन अउ ओखर हरवाह खुस हुइन। <verse eid="GEN 45:16" /><verse number="17" style="v" sid="GEN 45:17" />इहैनिता फिरोन यूसुफ लग कथै, असना करा कि, “अपन भाई लग कहि दे कि उनके जेतका दाना चाही लइ ले अउ अपन पसु हे लाद के कनान देस छो लउट जाय। <verse eid="GEN 45:17" /><verse number="18" style="v" sid="GEN 45:18" />उहां लग ऊ अपन बाफ अउ अपन सगलू परवार के लइके तुम्हर लिघ्घो आमै, मै उनके मिस्र देस के सब लग निक्खा चीज देहुं, ऊ मिस्र देस के निक्खा चीज खइहिन। <verse eid="GEN 45:18" /><verse number="19" style="v" sid="GEN 45:19" />उनके आदेस देया कि ऊ नान-नान लरका अउ डउकी के निता मिस्र देस लग गाडी लइ जाय अउ अपन बाफ के लइके आमै। <verse eid="GEN 45:19" /><verse number="20" style="v" sid="GEN 45:20" />ऊ अपन सामान के चिन्ता झइ करै, काखे सगलू मिस्र देस के निक्खा चीज उनखरै हबै।” <verse eid="GEN 45:20" /><verse number="21" style="v" sid="GEN 45:21" />याकूब के टोरवा असना करिन, यूसुफ उनके फिरोन के आदेस के जसना गाडी दइस, रास्ता के निता खाना पीना दइस। <verse eid="GEN 45:21" /><verse number="22" style="v" sid="GEN 45:22" />यूसुफ हर भाई के अक-अक्ठी जोडा कपडा दइस, पय बिन्यामीन के पांच जोडा कपडा दइस अउ यूसुफ ओही तीन सव चांदी के खोटन्ना दइस। <verse eid="GEN 45:22" /><verse number="23" style="v" sid="GEN 45:23" />ऊ अपन बाफ के हइ चीज पठोइस, दस गदहा हे लदे मिस्र देस के निक्खा चीज, दस गदही हे लदे दाना अउ रोटी अउ बाफ के यातरा के निता भोजन चीज पठोइस। <verse eid="GEN 45:23" /><verse number="24" style="v" sid="GEN 45:24" />तब यूसुफ अपन भाई के जाय के निता कहिस, जब ऊ जामै का हुइन तब यूसुफ उनखर लग कथै, “सीधा घर छो जा अउ रास्ता हे झइ लडिहा।” <verse eid="GEN 45:24" /><verse number="25" style="v" sid="GEN 45:25" />हइ मेर भाई मिस्र देस के छांडिन अउ कनान देस हे अपन बाफ याकूब के लिघ्घो गइन। <verse eid="GEN 45:25" /><verse number="26" style="v" sid="GEN 45:26" />उन अपन बाफ के गुठेइन, “यूसुफ अबे जिन्दा हबै, ऊ पूरे मिस्र देस के राजा हबै।” उनखर बाफ चकित हुइस, याकूब उनखर बात हे बिस्वास नेहको करिस। <verse eid="GEN 45:26" /><verse number="27" style="v" sid="GEN 45:27" />तब उन अपन बाफ लग यूसुफ के सगलू बात गुठेइस, जउन ऊ उनखर लग कहे रथै, जब याकूब उन गाडी के देखिस, जउन यूसुफ ओही लामै के निता पठोय रथै, तब ऊ बोहत जादा खुस हुइस। <verse eid="GEN 45:27" /><verse number="28" style="v" sid="GEN 45:28" />इस्राएल याकूब कथै, “अब मोके बिस्वास हबै कि मोर टोरवा यूसुफ अबे जिन्दा हबै, मै मरै लग पहिले उके देख सकहूं।”<verse eid="GEN 45:28" /></para>
  <chapter eid="GEN 45" />
  <chapter number="46" style="c" sid="GEN 46" />
  <para style="s">याकूब के सगलू परवार मिस्र देस छो गइन</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 46:1" />इहैनिता याकूब मिस्र देस के अपन यातरा सुरुवात करिस, पहिले बेरसेबा छो गइस, उहां अपन बाफ इसहाक के भगवान के धन्यवाद दइस अउ उके बलि चढाइस। <verse eid="GEN 46:1" /><verse number="2" style="v" sid="GEN 46:2" />तब भगवान रात के सपना हे याकूब लग कथै, “हे याकूब, हे याकूब,” एखर बाद ऊ कथै, “काहिन आदेस हबै?” <verse eid="GEN 46:2" /><verse number="3" style="v" sid="GEN 46:3" />तब ऊ कथै, “मै भगवान यहों, तोर बाफ के भगवान, तै मिस्र देस छो जाय लग झइ डेरा, काखे मै उहां तोर लग अक्ठी बडा देस बनाहुं। <verse eid="GEN 46:3" /><verse number="4" style="v" sid="GEN 46:4" />मै तोर संग मिस्र देस छो जइहों अउ उहां लग तोके फेरै वापिस लइहों, तोर मिरतू हे यूसुफ तोर आंखी के बन्द करही।” <verse eid="GEN 46:4" /><verse number="5" style="v" sid="GEN 46:5" />तब याकूब बेरसेबा लग चल पडिस, जउन गाडी फिरोन याकूब के लामै के निता पठोय रथै, ओहमा याकूब कर टोरवा अपन बाफ, नान-नान टोरवा अउ अपन डउकी के बइठाय के उनके लइ गइन। <verse eid="GEN 46:5" /><verse number="6" style="v" sid="GEN 46:6" />उनखर लिघ्घो पसु अउ कनान देस हे उनखर अपन जउन कुछु रथै, उहो संग रथै, हइ मेर याकूब अपन सगलू लरका अउ परवार के संग मिस्र हे गइस।<note caller="+" style="x"><char style="xo" closed="false">46:6 </char><char style="xt" closed="false"><ref loc="ACT 7:15">प्रेरितो 7:15</ref></char></note> <verse eid="GEN 46:6" /><verse number="7" style="v" sid="GEN 46:7" />ओखर संग ओखर टोरवा अउ टोरिया, नाती, नतिनिया रथै, ओखर सगलू परवार ओखर संग मिस्र देस हे लइ आनिस। <verse eid="GEN 46:7" /><verse number="8" style="v" sid="GEN 46:8" />हइ याकूब के उन टोरवन अउ परवार के नाम हबै जउन ओखर संग मिस्र देस गइन, रूबेन याकूब के पहिला टोरवा रथै। <verse eid="GEN 46:8" /><verse number="9" style="v" sid="GEN 46:9" />रूबेन कर टोरवा, हनोक, पललू, हेस्रोन अउ कर्म्मी रथै। <verse eid="GEN 46:9" /><verse number="10" style="v" sid="GEN 46:10" />सिमोन कर टोरवा, यमूएल, यामीन, ओहद, याकीन, सोहर अउ अक्ठी कनानी डउकी लग पइदा हुइस साउल रथै। <verse eid="GEN 46:10" /><verse number="11" style="v" sid="GEN 46:11" />लेवी कर टोरवा गेर्सोन, कहात अउ मरारी रथै। <verse eid="GEN 46:11" /><verse number="12" style="v" sid="GEN 46:12" />यहूदा कर टोरवा, एर, ओनान, सेला, पेरेस अउ जेरह। एर अउ ओनान के मिरतू कनान देस हे हुइ गय रथै, पेरेस कर टोरवा हेस्रोन अउ हामूल रथै। <verse eid="GEN 46:12" /><verse number="13" style="v" sid="GEN 46:13" />इस्साकार कर टोरवा तोला, पुब्बा योब अउ सिम्रोन रथै। <verse eid="GEN 46:13" /><verse number="14" style="v" sid="GEN 46:14" />जबूलून कर टोरवा सेरेद, एलोन अउ यहलेल रथै। <verse eid="GEN 46:14" /><verse number="15" style="v" sid="GEN 46:15" />हइ लिया कर टोरवा रथै, जेही ऊ याकूब लग पद्दनराम इलाका हे पइदा करे रथै, ओखर टोरिया दीनो रथै, हइ सगलू टोरवा-टोरिया, नाती, नतिनिया सब के मिलायके तैंतीस झन रथै। <verse eid="GEN 46:15" /><verse number="16" style="v" sid="GEN 46:16" />फेर गाद कर टोरवा सिय्योन, हाग्गी, सूनी, एसबोन, एरी, अरोदी अउ अरेली रथै। <verse eid="GEN 46:16" /><verse number="17" style="v" sid="GEN 46:17" />आसेर कर टोरवा इम्ना, इस्वा, इस्वी अउ बरीया रथै, अउ उनखर बेहन सेरह रथै अउ बरीया कर टोरवा हेबेर अउ मल्कीएल रथै। <verse eid="GEN 46:17" /><verse number="18" style="v" sid="GEN 46:18" />हइ जिल्पा जेही लाबान अपन टोरिया लिया के दय रथै, ओखर टोरवा नाती सब इहै रथै, अउ ओखर दवारा याकूब के सोलह मनसे पइदा हुइस। <verse eid="GEN 46:18" /><verse number="19" style="v" sid="GEN 46:19" />याकूब के डउकी राहेल के टोरवा यूसुफ अउ बिन्यामीन रथै। <verse eid="GEN 46:19" /><verse number="20" style="v" sid="GEN 46:20" />यूसुफ मिस्र देस हे ओन के पुजारी पोतीपेरा कर टोरिया लग काज हुइस अउ आसनत लग यूसुफ के दुइठे टोरवा पइदा हुइन, जेखर नाम हबै, मनस्से अउ एप्रैम। <verse eid="GEN 46:20" /><verse number="21" style="v" sid="GEN 46:21" />बिन्यामीन कर टोरवा बेला, बेकेर, अस्बेल, गेरा, नामान, एही, रोस, मुप्पीम, हुप्पीम अउ आर्द रथै। <verse eid="GEN 46:21" /><verse number="22" style="v" sid="GEN 46:22" />ऊ याकूब कर डउकी राहेल लग पइदा हुइन, ओखर टोरवा रथै, ई परवार हे चउदह मनसे रथै। <verse eid="GEN 46:22" /><verse number="23" style="v" sid="GEN 46:23" />दान कर टोरवा हूसीम रथै। <verse eid="GEN 46:23" /><verse number="24" style="v" sid="GEN 46:24" />नप्ताली कर टोरवा यहसेल, गूनी, सेसेर अउ सिल्लेम रथै। <verse eid="GEN 46:24" /><verse number="25" style="v" sid="GEN 46:25" />ऊ याकूब अउ बिल्हा कर टोरवा रथै, बिल्हा जेही लाबान अपन बिटिया राहेल के दय रथै। ई परवार हे सात मनसे रथै। <verse eid="GEN 46:25" /><verse number="26" style="v" sid="GEN 46:26" />हइ मेर याकूब के परवार मिस्र हे पहुंचिन, याकूब के बहुवन के छांड के कुल छियासठ मनसे रथै। <verse eid="GEN 46:26" /><verse number="27" style="v" sid="GEN 46:27" />यूसुफ कर टोरवा, जउन ओही मिस्र देस हे पइदा होय रथै, दुइठे रथै, हइ मेर लग याकूब के परवार के मनसे जउन मिस्र देस लग आय रथै, कुल सत्तर मनसे रथै।<note caller="+" style="x"><char style="xo" closed="false">46:27 </char><char style="xt" closed="false"><ref loc="ACT 7:14">प्रेरितो 7:14</ref></char></note><verse eid="GEN 46:27" /></para>
  <para style="s">याकूब अउ ओखर परवार मिस्र देस हे</para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 46:28" />याकूब पहिले यहूदा के यूसुफ के लिघ्घो पठोथै, यहूदा गोसेन परदेस हे यूसुफ के लिघ्घो गइस, जब याकूब अउ ओखर मनसे ऊ परदेस हे गइन। <verse eid="GEN 46:28" /><verse number="29" style="v" sid="GEN 46:29" />तब यूसुफ के पता चलथै कि ओखर बाफ लिघ्घो आ गय हबै, इहैनिता यूसुफ अपन रथ तइयार करवाथै अउ अपन बाफ इस्राएल लग गोसेन परदेस के मिलै के निता कढ गइस, जब यूसुफ अपन बाफ के देखिस तब ऊ ओखर गले लग गइस अउ बोहत देरी तक रोथै। <verse eid="GEN 46:29" /><verse number="30" style="v" sid="GEN 46:30" />तब याकूब यूसुफ लग कथै, “अब मै मर सकथो, काखे मै तोके देख लय हव, कि तै अब तक जिन्दा हबस।” <verse eid="GEN 46:30" /><verse number="31" style="v" sid="GEN 46:31" />तब यूसुफ अपन भाई अउ बाफ के परवार के मनसे लग कथै, अब मै जाय के फिरोन लग कइहों, “कि मोर भाई अउ मोर बाफ के परवार जउन कनान देस हे रथै, मोर लिघ्घो आय गय हबै।” <verse eid="GEN 46:31" /><verse number="32" style="v" sid="GEN 46:32" />हइ मनसे बरेदी हबै, काखे उन पसुन के पालत आय हबै, ऊ अपन संग गेडरा छेडी गोरू अउ अपन सगलू डेरा के लाय हबै। <verse eid="GEN 46:32" /><verse number="33" style="v" sid="GEN 46:33" />जब फिरोन तुमके बुलाही अउ “तुम्हर लग पूंछही कि तुम काहिन काम करथा?” <verse eid="GEN 46:33" /><verse number="34" style="v" sid="GEN 46:34" />तब तुम कहबे, “तोर सेबक, हम अउ हमर पुरखा बचपन लग अब तक पसु, छेडी, गेडरा पालत आय हवन, जेखर लग तै गोसेन परदेस हे रह सकस, मिस्र देस के रहै बाले मनसे बरेदी लग घिनाथै।”<verse eid="GEN 46:34" /></para>
  <chapter eid="GEN 46" />
  <chapter number="47" style="c" sid="GEN 47" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 47:1" />तब यूसुफ फिरोन के लिघ्घो गइस अउ ऊ कथै, “मोर बाफ, मोर भाई अउ उनखर सगलू परवार इहां आ गय हबै, ऊ अपन सगलू पसु, गेडरा, छेडी अउ कनान देस हे उनखर अपन जउन कुछु रथै, उनखर संग हबै, ई टेम ऊ गोसेन परदेस हे हबै।” <verse eid="GEN 47:1" /><verse number="2" style="v" sid="GEN 47:2" />यूसुफ अपन भाई मसे पांच मनसे चुन के उनके फिरोन के लिघ्घो ठाढ करिस। <verse eid="GEN 47:2" /><verse number="3" style="v" sid="GEN 47:3" />फिरोन यूसुफ के भाई लग पूंछथै, तुम्हर काहिन काम हबै? उन ओही जबाब देथै, हम तोर सेबक, अपन पुरखन के जसना गेडरा, छेडिन के बरेदी हवन। <verse eid="GEN 47:3" /><verse number="4" style="v" sid="GEN 47:4" />उन फिरोन लग इहो कथै, हम मिस्र देस हे रहै के निता आय हवन, कनान देस हे बोहत जादा अकाल पडे हबै, इहैनिता तोर सेबकन के गेडरा छेडी के निता चारा नेहको हबै, अब किरपा करके अपन सेबकन के गोसेन परदेस हे रहै के आदेस दे। <verse eid="GEN 47:4" /><verse number="5" style="v" sid="GEN 47:5" />फिरोन यूसुफ लग कथै, “तुम्हर बाफ अउ भाई तुम्हर लिघ्घो आय हबै। <verse eid="GEN 47:5" /><verse number="6" style="v" sid="GEN 47:6" />तै मिस्र देस हे कउनो जिघा उनखर रहै के निता चुन सकथस, अपन बाफ अउ अपन भाई के सब लग निक्खा जमीन दे, उनके गोसेन परदेस हे रहन दे अउ अगर उन मसे कउनो निक्खा बरेदी हबै, ता ऊ मोर पसु के देख रेख कर सकथै।” <verse eid="GEN 47:6" /><verse number="7" style="v" sid="GEN 47:7" />यूसुफ अपन बाफ के लिघ्घो आइस, ऊ ऊके फिरोन के लिघ्घो ठाढ करिस, याकूब फिरोन के आसिरवाद दइस। <verse eid="GEN 47:7" /><verse number="8" style="v" sid="GEN 47:8" />फिरोन याकूब लग पूंछिस, “तोर केतका उमर हबै?” <verse eid="GEN 47:8" /><verse number="9" style="v" sid="GEN 47:9" />याकूब फिरोन लग कथै, “बोहत जादा कस्ट के संग मोर नान जीवन रहिस, मै केबल एक सव तीस साल जीवन बितायों, मोर बाफ अउ उनखर बाफ मोर लग जादा उमर तक जिन्दा रहिन।” <verse eid="GEN 47:9" /><verse number="10" style="v" sid="GEN 47:10" />याकूब फिरोन के आसिरवाद दइस, तब फिरोन लग बिदा लइके कढ गइस। <verse eid="GEN 47:10" /><verse number="11" style="v" sid="GEN 47:11" />यूसुफ फिरोन के आदेस के मानिस, ऊ अपन बाफ अउ भाई के मिस्र देस हे जमीन दइस, हइ रामसेस सहर के लिघ्घो मिस्र हे सब लग निक्खा जमीन रथै। <verse eid="GEN 47:11" /><verse number="12" style="v" sid="GEN 47:12" />यूसुफ अपन बाफ अउ भाई अउ अपन बाफ के सगलू मनसे के गिनती जसना खाना पीना के इन्तजाम कर दइस।<verse eid="GEN 47:12" /></para>
  <para style="s">अकाल के टेम हे यूसुफ के परबन्ध</para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 47:13" />उस सगलू देस हे अकाल के टेम अउ जादा बुरा हुइ गइस, देस हे कहुं भोजन दाना नेहको रथै, हइ बेकार टेम के कारन मिस्र अउ कनान देस हे बोहत जादा गरीबी हुइ गय। <verse eid="GEN 47:13" /><verse number="14" style="v" sid="GEN 47:14" />जेतका पइसा मिस्र अउ कनान देस हे रथै, मनसे जादा लग जादा दाना खरीदै लगिस, यूसुफ दाना बचाय के अउ उके फिरोन के महल हे जमा करवाय दइस। <verse eid="GEN 47:14" /><verse number="15" style="v" sid="GEN 47:15" />कुछ टेम बाद मिस्र अउ कनान देस के मनसे के लिघ्घो पइसा नेहको रथै, उन अपन सगलू पइसा दाना खरीदै हे खरच कर देथै, इहैनिता मनसे यूसुफ के लिघ्घो गइस अउ बोलथै, “किरपा करके हमके खाना दे, हमर पइसा खतम हुइ गय हबै, अगर हम नेहको खउबे ता तोर देखत-देखत हम मर जउबे।” <verse eid="GEN 47:15" /><verse number="16" style="v" sid="GEN 47:16" />यूसुफ कथै, “अगर पइसा नेहको हबै ता अपन पसु के दइ देया अउ मै उनखर बदला तुमके दाना देहुं।” <verse eid="GEN 47:16" /><verse number="17" style="v" sid="GEN 47:17" />इहैनिता मनसे अपन पसु, छेडी, गदहा, घोडवा अउ दूसर सगलू जानवर के दाना खरीदै के निता निस्तार हे लामै लगिन अउ ऊ साल यूसुफ उनखर पसु के लइस अउ दाना दइस। <verse eid="GEN 47:17" /><verse number="18" style="v" sid="GEN 47:18" />पय दूसर साल मनसे के लिघ्घो पसु नेहको रथै अउ दाना खरीदै के निता कुछु नेहको रथै, इहैनिता मनसे यूसुफ के लिघ्घो गइन अउ कथै, “तै तो जानथस कि हमर लिघ्घो पइसा नेहको बचे हबै अउ हमर सगलू पसु तोर हुइ गय हबै, इहैनिता हमर लिघ्घो कुछु नेहको बचे हबै, जउन कुछु बचे हबै ता केबल, हमर सरीर अउ हमर जमीन। <verse eid="GEN 47:18" /><verse number="19" style="v" sid="GEN 47:19" />हम अउ हमर खेतवा तोर रहत काखे नास होय? तै दाना दइके हमके अउ हमर खेत के खरीद ले, तब हम अउ हमर खेतवा फिरोन के गुलाम हुइ जउबे, हमके अनाज दे, जेखर लग हम झइ मरी पय जिन्दा रही, हमर खेत झइ बरबाद होय।” <verse eid="GEN 47:19" /><verse number="20" style="v" sid="GEN 47:20" />इहैनिता यूसुफ मिस्र देस के सगलू जमीन फिरोन के निता खरीद लइस, मिस्र देस के सगलू मनसे अपन जमीन के यूसुफ के हाथ बेच दइस, उन हइ इहैनिता करिन काखे उन बोहत जादा भूंखे रथै। <verse eid="GEN 47:20" /><verse number="21" style="v" sid="GEN 47:21" />यूसुफ अक छोर लग दूसर छोर तक मिस्र देस हे जउन मनसे रथै, उनके ऊ सहर हे लाय के बसाय दइस। <verse eid="GEN 47:21" /><verse number="22" style="v" sid="GEN 47:22" />अक्ठी केबल जमीन यूसुफ नेहको खरीदिस जउन पुजारिन के हक हे रथै, पुजारी के जमीन बेचै के जरूरत नेहको पडिस, काखे फिरोन उनखर काम के निता उनके बेतन दय करथै, इहैनिता उन ई पइसा के खाय के निता दाना खरीदै हे खरच करिन। <verse eid="GEN 47:22" /><verse number="23" style="v" sid="GEN 47:23" />यूसुफ मनसे लग कथै, देखो, आज मै तुमके अउ तुम्हर खेतवन के फिरोन के निता खरीदै हव, हइ बिजहा तुम्हर निता हबै, तुम इके खेतवन हे बोवा। <verse eid="GEN 47:23" /><verse number="24" style="v" sid="GEN 47:24" />अउ जउन कुछु होही ओखर पचमा हिस्सा फिरोन के दइहा, बाकी चार हिस्सा तुम उके अपन खेतवन हे बोवा अउ अपन-अपन लरका अउ घर के मनसे सहित खइहा पीहा। <verse eid="GEN 47:24" /><verse number="25" style="v" sid="GEN 47:25" />उन बोलथै, “तै हमर जीवन के रक्छा करे हवस, अगर हमर मालिक हमर उप्पर किरपा द्रस्टि बनाय रखै, ता हम फिरोन के गुलाम बने रहब।” <verse eid="GEN 47:25" /><verse number="26" style="v" sid="GEN 47:26" />इहैनिता यूसुफ ऊ टेम मिस्र देस हे अक्ठी नियम बनाइस अउ ऊ नियम अब तक चले आउथे, नियम के जसना जमीन लग हर अक्ठी उपज के पचमा हिस्सा फिरोन के हबै, फिरोन सगलू जमीन के मालिक हबै, केबल उहै जमीन नेहको हबै जउन पुजारिन के हबै।<verse eid="GEN 47:26" /></para>
  <para style="s">याकूब कर आखरी बिनती</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 47:27" />इस्राएली मिस्र देस के गोसेन परदेस हे रहै लगिस, उन ओखर उप्पर हक जमाय लइस, ऊ फलिन-फूलिन अउ भुंइ हे भर गइन। <verse eid="GEN 47:27" /><verse number="28" style="v" sid="GEN 47:28" />मिस्र देस हे याकूब सतरह साल तक रहिस, हइ मेर याकूब के कुल साल एक सव सइतालिस साल के हुइस। <verse eid="GEN 47:28" /><verse number="29" style="v" sid="GEN 47:29" />याकूब के मरै के दिन आइस तब उन अपन टोरवा यूसुफ के बुलाय के ओखर लग कथै “अगर तै मोर इज्जत करथस ता मोर जांघ के तरी हाथ मढाय के किरिया खा कि तै मोर संग किरपा अउ सही बेउहार करबे, मोके मिस्र देस हे झइ गाडबे।<note caller="+" style="x"><char style="xo" closed="false">47:29 </char><char style="xt" closed="false"><ref loc="GEN 50:6">उत्पति 50:6</ref></char></note> <verse eid="GEN 47:29" /><verse number="30" style="v" sid="GEN 47:30" />जब मै अपन पुरखा के संग मर जइहों, तब तै मोके मिस्र देस लग उठाय के उनखरै मरघटी हे रखबे।” तब यूसुफ कथै, “मै तोर टीमा के जसना करिहों।” <verse eid="GEN 47:30" /><verse number="31" style="v" sid="GEN 47:31" />तब याकूब कथै, “मोर लग टीमा कर” अउ यूसुफ ओखर लग टीमा करिस कि ऊ इके पूर करही, तब याकूब अपन मूंड खटिया हे पाछू धरिस।<note caller="+" style="x"><char style="xo" closed="false">47:31 </char><char style="xt" closed="false"><ref loc="HEB 11:21">इब्रानिन 11:21</ref></char></note><verse eid="GEN 47:31" /></para>
  <chapter eid="GEN 47" />
  <chapter number="48" style="c" sid="GEN 48" />
  <para style="s">याकूब मनस्से अउ एप्रैम के आसिरवाद</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 48:1" />हइ बातन के बाद कउनो मनसे यूसुफ लग कथै, तोर बाफ नंगाय हबै। इहैनिता यूसुफ अपन दुनो टोरवा मनस्से अउ एप्रैम के अपन संग लइस अउ अपन बाफ के लिघ्घो कढ गइन। <verse eid="GEN 48:1" /><verse number="2" style="v" sid="GEN 48:2" />जब यूसुफ पहुंचिस ता कउनो याकूब लग कथै, “तोर टोरवा यूसुफ तोके देखै के निता आय हबै।” याकूब बोहत कमजोर रथै, पय ऊ बोहत परयास करिस अउ खटिया हे बइठ गइस।<note caller="+" style="x"><char style="xo" closed="false">48:2 </char><char style="xt" closed="false"><ref loc="GEN 28:13-14">उत्पति 28:13-14</ref>; <ref loc="GEN 48:3-4">48:3-4</ref></char></note> <verse eid="GEN 48:2" /><verse number="3" style="v" sid="GEN 48:3" />याकूब यूसुफ लग कथै, सक्तिमान भगवान मोके कनान देस के लूज सहर के लिघ्घो मोके दरसन दय रथै, अउ ऊ मोके हइ आसीस दय रथै। <verse eid="GEN 48:3" /><verse number="4" style="v" sid="GEN 48:4" />भगवान मोर लग कहे रथै, मै तोर अक्ठी बडा परवार बनाहुं। मै तोके बोहत जादा लरका देहुं अउ तै अक्ठी बडा देस बनही। तुम्हर मनसे के अधिकार ई देस हे हरमेसा बने रही। <verse eid="GEN 48:4" /><verse number="5" style="v" sid="GEN 48:5" />अब तोर दुनो टोरवा, जउन मिस्र देस हे मोर आमै लग पहिले पइदा होय रथै, ऊ मोर हबै। जसना रूबेन अउ सिमोन हबै ओसनेन मनस्से अउ एप्रैम मोर हबै। <verse eid="GEN 48:5" /><verse number="6" style="v" sid="GEN 48:6" />पय अगर तुम्हर दूसर टोरवा हुइहिन, ता ऊ तुम्हर लरका हुइहिन। पय उहो एप्रैम अउ मनस्से के जउन कुछु होही, ओहमा हिस्सेदार हुइहिन। <verse eid="GEN 48:6" /><verse number="7" style="v" sid="GEN 48:7" />जब मै पद्दान लग आथो, तब एप्राता सहर अबे कुछ दुरिहां रथै, तब कनान देस हे मोर लिघ्घो राहेल के रास्ता हे मर गइस। मै उके उहै एप्राता सहर मतलब बैतलहम के रास्ता हे गाड दयों।<note caller="+" style="x"><char style="xo" closed="false">48:7 </char><char style="xt" closed="false"><ref loc="GEN 35:16-19">उत्पति 35:16-19</ref></char></note> <verse eid="GEN 48:7" /><verse number="8" style="v" sid="GEN 48:8" />तब इस्राएल यूसुफ के टोरवा के देखिस, इस्राएल पूंछिस, “हइ टोरवा कोनहर आय?” <verse eid="GEN 48:8" /><verse number="9" style="v" sid="GEN 48:9" />यूसुफ अपन बाफ लग कथै, “हइ मोर टोरवा आय। ई ऊ टोरवा आय जिके भगवान मोके दय हबै।” इस्राएल कथै, “अपन टोरवा के मोर लिघ्घो ला, मै उके आसीस देहुं।” <verse eid="GEN 48:9" /><verse number="10" style="v" sid="GEN 48:10" />इस्राएल डोकरा रथै अउ ओखर आंखी ठीक नेहको रथै, इहैनिता यूसुफ अपन टोरवा के अपन बाफ के लिघ्घो लइ गय। इस्राएल लरकन के चूमिस अउ गले लगाइस। <verse eid="GEN 48:10" /><verse number="11" style="v" sid="GEN 48:11" />तब इस्राएल यूसुफ लग कथै, “मै कबहुन सोचे नेहको रथो कि मै तोर मुंह फेरै देखहुं, पय देख, भगवान तोके अउ तोर लरकन के मोके देखै दइस।” <verse eid="GEN 48:11" /><verse number="12" style="v" sid="GEN 48:12" />तब यूसुफ लरकन के इस्राएल के गोदी लग लइस अउ ऊ ओखर बाफ के आगू परनाम करै के झुकिस। <verse eid="GEN 48:12" /><verse number="13" style="v" sid="GEN 48:13" />यूसुफ एप्रैम के अपन दहिना पार करिस अउ मनस्से के अपन टेटरा पार हइ मेर एप्रैम इस्राएल के टेटरा पार रथै अउ मनस्से इस्राएल के दहिना पार रथै। <verse eid="GEN 48:13" /><verse number="14" style="v" sid="GEN 48:14" />तब इस्राएल अपन दहिना पार हाथ बढाय के उके एप्रैम के मूंड हे रखिस। एप्रैम नान टोरवा रथै। उन अपन टेटरा हाथ आडा करके मनस्से के मूंड हे रखिस। मनस्से बडा टोरवा रथै। <verse eid="GEN 48:14" /><verse number="15" style="v" sid="GEN 48:15" />अउ इस्राएल यूसुफ के आसीस दइस अउ कथै, “मोर पुरखा अब्राहम अउ इसहाक हमर भगवान के जसना चलिन, अउ उहै भगवान मोर पूरा जीवन के रास्ता हे अगुवाइ करे हबै।<note caller="+" style="x"><char style="xo" closed="false">48:15 </char><char style="xt" closed="false"><ref loc="HEB 11:21">इब्रानिन 11:21</ref></char></note> <verse eid="GEN 48:15" /><verse number="16" style="v" sid="GEN 48:16" />उहै दूत रहिस जउन मोके सगलू कस्टन लग बचाइस अउ मोर बिनती हबै कि हइ लरकन के ऊ आसीस दे। अब हइ लरका मोर नाम पइहिन। ऊ हमर पुरवज अब्राहम अउ इसहाक के नाम पइहिन। मै बिनती करथो कि ऊ ई भुंइ हे बडा परवार अउ देस बनहिन।” <verse eid="GEN 48:16" /><verse number="17" style="v" sid="GEN 48:17" />यूसुफ देखिस कि ओखर बाफ एप्रैम के मूंड हे दहिना हाथ धरिस। ऊ यूसुफ के खुस नेहको कर सकिस। यूसुफ अपन बाफ के हाथ के पकडिस। ऊ उके एप्रैम के मूंड लग हटाय के मनस्से के मूंड हे रखै चाहथै। <verse eid="GEN 48:17" /><verse number="18" style="v" sid="GEN 48:18" />यूसुफ अपन बाफ लग कथै, “तै अपन दहिना हाथ गलत टोरवा हे रखे हबस। मनस्से के पइदा पहिले हबै।” <verse eid="GEN 48:18" /><verse number="19" style="v" sid="GEN 48:19" />पय ओखर बाफ सोचिस अउ कथै, “टोरवा, मै जानथो, मनस्से के पइदा पहिले हबै अउ ऊ बडा होही। ऊ बोहत मनसे के बाफ होही, पय नान बडा भाई लग बडा होही अउ नान भाई के परवार ओखर लग बोहत बडा होही।” <verse eid="GEN 48:19" /><verse number="20" style="v" sid="GEN 48:20" />हइ मेर इस्राएल ऊ रोज उनके आसीस दइस, ऊ कथै, “इस्राएल के मनसे तुम्हर नाम के निस्तार आसीस देय के निता करहिन, तुम्हर कारन किरपा मिलही। मनसे बिनती करहिन भगवान तोके एप्रैम अउ मनस्से के जसना बनाय।” हइ मेर इस्राएल एप्रैम के मनस्से लग बडा बनाइस। <verse eid="GEN 48:20" /><verse number="21" style="v" sid="GEN 48:21" />तब इस्राएल यूसुफ लग कथै, “देख मोर मिरतू कर टेम आय गय हबै। पय भगवान तुम्हर संग अबो रही। ऊ तुमके तुम्हर पुरवजन के देस तक लउटाय लय जही। <verse eid="GEN 48:21" /><verse number="22" style="v" sid="GEN 48:22" />मै तोके असना कुछ दय हव जउन तुम्हर भाई के नेहको दय हव, मै तोके ऊ डोंगर देथो जेही मै एमोरी मनसे लग जीते रहों। ऊ डोंगर के निता मै अपन तलबार अउ अपन धनही लग लडै रहों अउ मै मोर जीत हुइस।<note caller="+" style="x"><char style="xo" closed="false">48:22 </char><char style="xt" closed="false"><ref loc="JHN 4:5">यूहन्ना 4:5</ref></char></note>”<verse eid="GEN 48:22" /></para>
  <chapter eid="GEN 48" />
  <chapter number="49" style="c" sid="GEN 49" />
  <para style="s">याकूब कर भभिस्यवानी</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 49:1" />तब याकूब अपन सगलू टोरवा के अपन लिघ्घो बुलाइस, ऊ कथै, “मोर सगलू टोरवा, इहां मोर लिघ्घो आबा। मै तुमके गुठेहुं कि भभिस्य हे काहिन होही।” <verse eid="GEN 49:1" /><verse number="2" style="v" sid="GEN 49:2" />हे याकूब कर टोरवा, अकजुट हुइके मोर बात सुना, अपन बाफ इस्राएल के बातन हे धियान देया। <verse eid="GEN 49:2" /><verse number="3" style="v" sid="GEN 49:3" />हे रूबेन तै मोर पहिला टोरवा हबस, तै मोर पहिले टोरवा अउ मोर सक्ति के पहिला साबूत हबस, तै मोर सगलू टोरवन लग जादा सक्ति अउ बलवान हबस। <verse eid="GEN 49:3" /><verse number="4" style="v" sid="GEN 49:4" />तै जउन पानी के जसना उबलै बाले हबस, इहैनिता दूसर लग बडा नेहको ठहरहे, काखे तै अपन बाफ के खटिया हे चढे, तब तै ओही असुध्द करिस, ऊ मोर जेठना हे चढ गइस। <verse eid="GEN 49:4" /><verse number="5" style="v" sid="GEN 49:5" />सिमोन अउ लेवी भाई हबै, उनके अपन तलबार लग लडै हे पिरिया हबै। <verse eid="GEN 49:5" /><verse number="6" style="v" sid="GEN 49:6" />हे मोर जीव उनखर गुप्त बइठक हे भाग झइ ले, हे मोर आतमा उनखर दरबार लग मदद झइ कर। काखे ऊ अपन गुस्सा हे मनसे के हत्या करथै, ऊ अपन इक्छा के कारन गोरुन के लंगडा बनाथै। <verse eid="GEN 49:6" /><verse number="7" style="v" sid="GEN 49:7" />उनखर गुस्सा के धिक्कार हबै, काखे ऊ परचंड हबै। उनखर रोस के धिक्कार हबै, काखे ऊ निरदय हबै। मै उनके याकूब के देस हे अलगे-अलगे करिहों, उनके इस्राएल हे तितर-बितर करिहों। <verse eid="GEN 49:7" /><verse number="8" style="v" sid="GEN 49:8" />“हे यहूदा, तोर भाई तोर धन्यवाद करहिन, तै अपन बैरी के हराइहे, तोर भाई तोर आगू झुके। <verse eid="GEN 49:8" /><verse number="9" style="v" sid="GEN 49:9" />यहूदा ऊ सेर के जसना हबै जउन कउनो जानवर के मारे होय, हे मोर टोरवा, तै अपन सिकार हे ठाढ बघवा के जसना हो जउन आराम करै के निता लेटथै, अउ कउ एतका बहादुर नेहको कि उके छेड दे।<note caller="+" style="x"><char style="xo" closed="false">49:9 </char><char style="xt" closed="false"><ref loc="NUM 24:9">गिनती 24:9</ref>; <ref loc="REV 5:5">परकासितवाक्य 5:5</ref></char></note> <verse eid="GEN 49:9" /><verse number="10" style="v" sid="GEN 49:10" />जब तक सीलो न आबै तब तक न तो यहूदा के परवार के मनसे राजा हुइहिन। ओखर परवार के राज-चिन्हा ओखर परवार लग सही सासक के आमै लग पहिले खतम नेहको होही। तब कइ मनसे ओखर आदेस के मनहिन अउ सेबा करहिन। <verse eid="GEN 49:10" /><verse number="11" style="v" sid="GEN 49:11" />ऊ अपन गदही के अंगूर के बेल लग बांधथै, ऊ अपन गदही के लरकन के सब लग निक्खा अंगूर के बेलन हे बांधथै। ऊ अपन कपडा के धोमै के निता सब लग निक्खा दाखरस के निस्तार करथै। <verse eid="GEN 49:11" /><verse number="12" style="v" sid="GEN 49:12" />ओखर आंखी दाखरस पीय लग लाल रथै। ओखर दांत दूध पीमै लग उजियार हबै।” <verse eid="GEN 49:12" /><verse number="13" style="v" sid="GEN 49:13" />जबूलून समुन्दर के तट हे निबास करही। ऊ पानी बाले जिहाज के निता बन्दरगाह बनही, ओखर राज के सीमा सीदोन देस तक होही। <verse eid="GEN 49:13" /><verse number="14" style="v" sid="GEN 49:14" />इस्साकार अक्ठी बलवान गदहा हबै, ऊ पसुन के बाडों के बीच हे रथै। <verse eid="GEN 49:14" /><verse number="15" style="v" sid="GEN 49:15" />जब ऊ देखिस कि आराम करै के जिघा निक्खा हबै, कि जमीन निक्खा हबै, तब ऊ अपन कांधा के बोझ उठामै के निता झुकाय दइस अउ ऊ बेगार के हरवाह बन जही। <verse eid="GEN 49:15" /><verse number="16" style="v" sid="GEN 49:16" />दान, इस्राएल के कुलन हे अक्ठी कुल अपन कुल के मनसे के न्याय करही। <verse eid="GEN 49:16" /><verse number="17" style="v" sid="GEN 49:17" />दान रास्ता के बगल के सपुवा के जसना हबै। ऊ रास्ता के लिघ्घो लेटे हर उस भंयकर सपुवा के जसना हबै, अउ सबार घोडवा लग गिर जथै। <verse eid="GEN 49:17" /><verse number="18" style="v" sid="GEN 49:18" />हे परभु, मै तोर मुकति के इंतजार करथो। <verse eid="GEN 49:18" /><verse number="19" style="v" sid="GEN 49:19" />“डाकुन के अक्ठी गिरोह गाद हे लडाई करही, पय गाद उनके मार भगाइस।” <verse eid="GEN 49:19" /><verse number="20" style="v" sid="GEN 49:20" />“आसेर के जमीन बोहत जादा निक्खा उपज देही, उके उहै भोजन मिलही जउन राजन के निता निस्तार होही।” <verse eid="GEN 49:20" /><verse number="21" style="v" sid="GEN 49:21" />“नप्ताली आजाद दउरै बाले छिगरी के जसना हबै अउ ओखर आरो उनखर लरकन के जसना हबै।” <verse eid="GEN 49:21" /><verse number="22" style="v" sid="GEN 49:22" />यूसुफ फलवन्त डगाइल हबै, झरना के बगल हे लगे फलवन्त डगाइल ओखर साखा भीठी हे फइले हबै। <verse eid="GEN 49:22" /><verse number="23" style="v" sid="GEN 49:23" />बोहत लग मनसे ओखर बिरुध्द हुइन अउ ओखर लग तीर लग लडिन। धनुरधारी मनसे उके परसंद नेहको करथै। <verse eid="GEN 49:23" /><verse number="24" style="v" sid="GEN 49:24" />तउभरमा ओखर धनही स्थिर रहिस, ओखर भुजा, ओखर हाथ गतिवान रथै, याकूब के सक्तिमान भगवान के हाथ लग, इस्राएल के पथरा मेसपाल के नाम लग, <verse eid="GEN 49:24" /><verse number="25" style="v" sid="GEN 49:25" />अउ अपन बाफ के भगवान लग सक्ति पाथै, “भगवान तोके आसीस दे, सक्तिमान भगवान तोके आसीस दे, ऊ तोर उप्पर बादर लग आसीस दे अउ तरी गहिरा समुन्दर लग आसीस दे, ऊ तोके स्तन अउ गरभ के आसीस दे।” <verse eid="GEN 49:25" /><verse number="26" style="v" sid="GEN 49:26" />मोर दाय-बाफ के बोहत निक्खा चीज होवत रहै अउ तुम्हर बाफ लग मोके अउ जादा आसीस मिलै, तुम्हर भाई तोके बेचै चाहै, पय अब तोके अक्ठी ऊंच डोंगर के जसना मोर सगलू आसीस तोके मिलै, उन यूसुफ के मूंड हे जउन अपन भाइयन लग अलगे करे गय रथै। <verse eid="GEN 49:26" /><verse number="27" style="v" sid="GEN 49:27" />“बिन्यामीन अक्ठी असना भूंखे बिगवा के जसना हबै, जउन सुबेन्ने मारथै अउ उके खाथै। संझा के हइ बचे कुचे लग काम चलाथै।” <verse eid="GEN 49:27" /><verse number="28" style="v" sid="GEN 49:28" />हइ इस्राएल के बारह परवार हबै अउ उहै चीजन हबै जिनके उनखर बाफ उनखर लग कथै, ऊ हर अक्ठी टोरवा के ऊ आसीस दइस जउन ओखर निता ठीक रथै।<verse eid="GEN 49:28" /></para>
  <para style="s">याकूब के मिरतू अउ गाडिन</para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 49:29" />तब इस्राएल उनके आदेस दइस, ऊ कथै, “जब मै मरो ता मै अपन मनसे के बीच रहै चाहथो, मै अपन पुरवजन के संग हित्ती एप्रोन के खेतन के गुफा हे गाडे जाय चाहथो।<note caller="+" style="x"><char style="xo" closed="false">49:29 </char><char style="xt" closed="false"><ref loc="ACT 7:16">प्रेरितो 7:16</ref></char></note> <verse eid="GEN 49:29" /><verse number="30" style="v" sid="GEN 49:30" />मोके ऊ गुफा हे गाडबे जउन कनान देस हे मम्रे के पूरुब दिसा हे मकपेला के जमीन हे हबै, जिके अब्राहम निजी मरघटी बनामै के निता हित्ती जात एप्रोन लग जमीन सहित खरीदे रथै।<note caller="+" style="x"><char style="xo" closed="false">49:30 </char><char style="xt" closed="false"><ref loc="GEN 23:16">उत्पति 23:16</ref></char></note> <verse eid="GEN 49:30" /><verse number="31" style="v" sid="GEN 49:31" />उहां उन अब्राहम अउ ओखर डउकी सारा के गाडे रथै। उहां उन इसहाक अउ ओखर डउकी रिबका के गाडिस, उहां मै लिया के गाडों। <verse eid="GEN 49:31" /><verse number="32" style="v" sid="GEN 49:32" />ऊ गुफा उस खेतवा हे हबै जिके हित्ती मनसे लग खरीदे गय रथै।” <verse eid="GEN 49:32" /><verse number="33" style="v" sid="GEN 49:33" />अपन टोरवन लग बात समापत करै के बाद याकूब लेट गय, गोडन के अपन बिछोना हे रखिस अउ मर गइस।<note caller="+" style="x"><char style="xo" closed="false">49:33 </char><char style="xt" closed="false"><ref loc="ACT 7:15">प्रेरितो 7:15</ref></char></note><verse eid="GEN 49:33" /></para>
  <chapter eid="GEN 49" />
  <chapter number="50" style="c" sid="GEN 50" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 50:1" />यूसुफ अपन बाफ के मुंह हे गिर के रोमै लगिस, ऊ बाफ के चूमिस। <verse eid="GEN 50:1" /><verse number="2" style="v" sid="GEN 50:2" />यूसुफ अपन दास के आदेस दइस, कि ऊ ओखर बाफ के सरीर के तइयार करै, हइ दास बैध रथै। बैध याकूब के सरीर के गाडै के निता तइयार करिस। उन मिस्री मनसे के बिसेस तरीका लग सरीर के तइयार करिस। <verse eid="GEN 50:2" /><verse number="3" style="v" sid="GEN 50:3" />जब मिस्री मनसे बिसेस मेर लग लहास तइयार करिस, तब ऊ दफनामै के पहिले चालीस दिन तक इंतजार करिस। ओखर बाद मिस्री याकूब के निता दुख के बिसेस टेम रखिस। हइ टेम सत्तर दिन के रथै। <verse eid="GEN 50:3" /><verse number="4" style="v" sid="GEN 50:4" />सत्तर दिन बाद दुख के टेम समापत हुइस, इहैनिता यूसुफ फिरोन के अधिकारी लग बाफ कथै, “किरपा करके फिरोन लग हइ कह, <verse eid="GEN 50:4" /><verse number="5" style="v" sid="GEN 50:5" />मोर बाफ मोके ई सब्दन हे किरिया खबाय रथै, देख मोर मिरतू लिघ्घो हबै, जउन मरघटी मै कनान देस हे अपन निता खोदे हबै, उहै मोके गाडबे। अब किरपा मोके जाय देया कि मै अपन बाफ के लहास के गाड दो, एखर बाद मै लउट आहुं।<note caller="+" style="x"><char style="xo" closed="false">50:5 </char><char style="xt" closed="false"><ref loc="GEN 47:29-31">उत्पति 47:29-31</ref></char></note>” <verse eid="GEN 50:5" /><verse number="6" style="v" sid="GEN 50:6" />फिरोन जबाब देथै, जा, अउ तोर बाफ जसना किरिया तोके खबाय रथै, उहै के जसना अपन बाफ के गाड। <verse eid="GEN 50:6" /><verse number="7" style="v" sid="GEN 50:7" />पय यूसुफ अपन बाफ के गाडै के निता गइस, ओखर संग फिरोन के करमचारी, ओखर राज परवार के मुखिया अउ मिस्र देस के सगलू पुरान मनसे गइन, <verse eid="GEN 50:7" /><verse number="8" style="v" sid="GEN 50:8" />यूसुफ के परवार के मनसे, ओखर भाई अउ ओखर बाफ के परवार के मनसे गइन, पय ऊ अपन लरकन, गेडरा छेडी अउ गाय-गोरू के गोसेन परदेस हे छांड गइन। <verse eid="GEN 50:8" /><verse number="9" style="v" sid="GEN 50:9" />यूसुफ के संग रथ अउ घुडसवार गइन, हइ मेर लहास यातरा हे बडा समूह हुइ गय। <verse eid="GEN 50:9" /><verse number="10" style="v" sid="GEN 50:10" />जब ऊ यरदन नदिया के बगल हे स्थित आताद, के खनिहार नाम जिघा हे पहुंचिस, तब उन बोहत जादा दुख मनाइस, यूसुफ अपन बाफ के निता सात दिन तक दुख मनाइस। <verse eid="GEN 50:10" /><verse number="11" style="v" sid="GEN 50:11" />अब ऊ सहर के रहै बाले कनानी मनसे आताद के खनिहार हे मनसे के दुख मनाउत देखिस तब कथै, “हइ मिस्र के निबासी के बोहत दुख पूर्न सोक हबै,” इहै कारन ऊ जिघा के नाम आबेलमिस्रैम पडिस, हइ यरदन नदिया के ऊ पार हबै। <verse eid="GEN 50:11" /><verse number="12" style="v" sid="GEN 50:12" />जसना याकूब उनके आदेस दय रथै, ओसनेन उनखर टोरवा करिस। <verse eid="GEN 50:12" /><verse number="13" style="v" sid="GEN 50:13" />उनखर टोरवा उनखर लहास के कनान देस हे लइन अउ नके मम्रे के पूरुब दिसा हे मकपेला के जमीन हे स्थित उस गुफा हे गाडा जेही निजी मरघटी बनामै के निता अब्राहम हित्ती जाती एप्रोन लग जमीन सहित खरीदे रथै। <verse eid="GEN 50:13" /><verse number="14" style="v" sid="GEN 50:14" />यूसुफ अपन बाफ के गाडै के बाद अपन भाई अउ उन सब के संग मिस्र देस छो लउट गइस, जउन लहास के गाडै के निता ओखर संग आय रथै।<verse eid="GEN 50:14" /></para>
  <para style="s">यूसुफ अपन भाइयन के आस्वासन देथै</para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 50:15" />जब यूसुफ के भाई देखथै कि हमर बाफ मर गय हबै, तब कहै लागथै, “जरूर यूसुफ अब हमर पाछू पडही अउ जेतका बुराई हम ओखर करे रथन सब के पूरा बदला हमर लग लेही।” <verse eid="GEN 50:15" /><verse number="16" style="v" sid="GEN 50:16" />इहैनिता उन यूसुफ के लिघ्घो अक्ठी मनसे पठोथै, “तोर बाफ मरै लग पहिले हमके हइ आदेस दय रथै, <verse eid="GEN 50:16" /><verse number="17" style="v" sid="GEN 50:17" />तुम यूसुफ लग हइ मेर कहबे, कि हम बिनती करथन कि तै अपन भाई के गलती अउ पाप के माफ कर, हम तोर लग बुराई करे रथन, पय अब अपन बाफ के भगवान के दासन के गलती छमा कर।” उनखर हइ बात सुनके यूसुफ रोय पडिस। <verse eid="GEN 50:17" /><verse number="18" style="v" sid="GEN 50:18" />अउ ओखर भाई आइन, ऊ ओखर लिघ्घो जमीन हे गिर के बोलथै, “हम तोर सेबक हवन।” <verse eid="GEN 50:18" /><verse number="19" style="v" sid="GEN 50:19" />पय यूसुफ कथै, “झइ डर का मै भगवान के जिघा हे हव? <verse eid="GEN 50:19" /><verse number="20" style="v" sid="GEN 50:20" />तुम मोर संग बुराई के योजना बनाया, पय भगवान भलाई के निता ओखर परयोग करिस कि कइ मनसे जिन्दा बचै, जसना ऊ आजो जिन्दा हबै। <verse eid="GEN 50:20" /><verse number="21" style="v" sid="GEN 50:21" />इहैनिता झइ डरा, मै तुम्हर लग अउ तुम्हर लरकन के देखभाल करिहों।” हइ मेर यूसुफ उनके साहस दइस अउ ऊ कोमरता लग बात करिस।<verse eid="GEN 50:21" /></para>
  <para style="s">यूसुफ के मिरतू</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 50:22" />यूसुफ अपन बाफ के परवार के संग मिस्र देस हे रथै, यूसुफ एक सव दस साल हुइके मरिस। <verse eid="GEN 50:22" /><verse number="23" style="v" sid="GEN 50:23" />अउ यूसुफ एप्रैम के नाती तक देखै पाइस, अउ मनस्से के नाती, जउन माकीर के टोरवा रथै, ऊ पइदा हुइस अउ यूसुफ उनके गोद हे लइस। <verse eid="GEN 50:23" /><verse number="24" style="v" sid="GEN 50:24" />यूसुफ अपन भाई लग कहिस, “मोर मिरतू लिघ्घो हबै। पय भगवान तुम्हर सुधि लेही, अउ तुमके ई देस लग निकार के ऊ देस हे लइ जही, जेखर किरिया ऊ अब्राहम, इसहाक अउ याकूब लग खाय रथै।” <verse eid="GEN 50:24" /><verse number="25" style="v" sid="GEN 50:25" />तब यूसुफ इस्राएली अपन मनसे लग अक्ठी टीमा करै के कहिस, यूसुफ कथै, “मोर लग टीमा करा कि मोर हाडन के अपन संग लइ जइहा जब भगवान तुमके नबा देस हे लइ जही<note caller="+" style="x"><char style="xo" closed="false">50:25 </char><char style="xt" closed="false"><ref loc="EXO 13:19">निरगमन 13:19</ref>; <ref loc="HEB 11:22">इब्रानिन 11:22</ref></char></note>।” <verse eid="GEN 50:25" /><verse number="26" style="v" sid="GEN 50:26" />यूसुफ मिस्र देस हे मरिस, जब ऊ एक सव दस साल के रथै, बैध ओखर लहास के गाडै के निता तइयार करिस अउ मिस्र देस हे ओखर लहास के अक्ठी डब्बा हे रखिस।<verse eid="GEN 50:26" /></para>
  <chapter eid="GEN 50" />
</usx>