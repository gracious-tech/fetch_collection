<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1JN" style="id">- Bhumiya Standard Project</book>
  <para style="h">यूहन्ना</para>
  <para style="toc3">1 यूहन्ना</para>
  <para style="toc2">1 यूहन्ना</para>
  <para style="toc1">1 यूहन्ना कर चिट्ठी</para>
  <para style="mt2">1 यूहन्ना की चिट्ठी</para>
  <para style="mt1">1 यूहन्ना कर चिट्ठी</para>
  <para style="imt">परचा</para>
  <para style="ip">1 यूहन्ना के चिट्ठी प्रेरित यूहन्ना दवारा मसीह के पइदा के 50 लग 100 साल के बीच लिखे गय रथै, यूहन्ना खुद के लिखे बाले के रूप हे नेहको चीनथै, पय पहिले अध्याय दिखाथै कि ऊ यीसु के जीवन अउ जी उठै के प्रतक्छ हबै। <char style="xt"><ref loc="1JN 1:1-3">1:1-3</ref></char> 1 यूहन्ना हे लेखक सैली लग बोहत मिलत-जुलत। असना माने जथै कि यूहन्ना इफिसुस हे रथै यूहन्ना अउ तीसर अक्छर 1 यूहन्ना, 2 यूहन्ना अउ 3 यूहन्ना के जसना सुसमाचार लिखे रथै।</para>
  <para style="ip">यूहन्ना हइ चिट्ठी सगलू मसीहन के असना टेम हे लिखे रथै, जब मंडली के आत्म ग्यानी नाम के मनसेन के अक्ठी समूह लग परेसानी होथै। हइ मनसेन के मानना रथै कि यीसु पूरी तरह लग भगवान रथै पय भुंइ हे रहत ऊ सच हे मांस अउ खून के देह बाले मनसे रथै। हइ कारन लग यूहन्ना यीसु के जीवन के प्रतक्छ होय के बारे लिखथै, अउ हइ कि ओखर अपन हाथ यीसु के छुइस <char style="xt"><ref loc="1JN 1:1-3">1:1-3</ref></char> हइ चिट्ठी के लिखे हे यूहन्ना के मतलब ओखर मगन के पूर करै के रथै। <char style="xt"><ref loc="1JN 2:1">1 यूहन्ना 2:1</ref></char> बिस्वासिन के पाप करै लग रुकिन <char style="xt"><ref loc="1JN 2:26">1 यूहन्ना 2:26</ref></char> अउ स्वास्थ करना बिस्वासिन के उन बचाय गय हबै। <char style="xt"><ref loc="1JN 5:13">5:13</ref></char></para>
  <para style="iot">रूप रेखा</para>
  <para style="io1">1. यूहन्ना अपन चिट्ठी के परचा देथै अउ इके लिखे के अक्ठी उदेस्य देथै। <char style="ior"><ref loc="1JN 1:1-4">1:1-4</ref></char></para>
  <para style="io1">2. फेर ऊ कथै कि भगवान कसना परकास हबै अउ हमके यीसु के जसना जीय चाही। <char style="ior"><ref loc="1JN 1:5-3:10">1:5—3:10</ref> </char></para>
  <para style="io1">3. एखर बाद ऊ हमके अक दूसर लग माया करै के आदेस के सुरता दिलाथै। <char style="ior"><ref loc="1JN 3:11-5:12">3:11—5:12</ref> </char></para>
  <para style="io1">4. ऊ अपन चिट्ठी के समापत करथै। <char style="ior"><ref loc="1JN 5:13-21">5:13-21</ref> </char></para>
  <chapter number="1" style="c" sid="1JN 1"/>
  <para style="s">जीवन कर बचन</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 1:1"/>ऊ दुनिया के सुरु लग रथै, हम इके सुने हबन, हम अपन आंखी लग देखे हबन, हम उके धियान लग देखन अउ इके खुदय अपन हाथन लग छुय हबन, हम ऊ बचन के बारे हे गुठेथन जउन जीवन हबै। <verse eid="1JN 1:1"/><verse number="2" style="v" sid="1JN 1:2"/>अउ हइ जीवन परगट करे गइस, हइ उहै जीवन हबै जउन बाफ के इहां रथै अउ हमर हे परगट करे गय रथै, हम इके देखे हबन ओखर बारे हे गवाही देयत अउ तुमही सबरोज के संदेस सुनाथन। <verse eid="1JN 1:2"/><verse number="3" style="v" sid="1JN 1:3"/>हम उके देखे हबन अउ सुने हबन अब तुमो उहै के सिक्छा देथा, ता तुमो हमर संग संगति रखा हमर हइ संगति बाफ अउ ओखर टोरवा यीसु मसीह के संग हबै। <verse eid="1JN 1:3"/><verse number="4" style="v" sid="1JN 1:4"/>अउ हम हइ बातन के तुमही इहैनिता लिखथन कि हमर मगन पूर हुइ जाय।<verse eid="1JN 1:4"/></para>
  <para style="s">भगवान उजियार हबै</para>
  <para style="p">
    <verse number="5" style="v" sid="1JN 1:5"/>अउ जउन संदेस हम ओखर लग सुने हबन अउ अब तुमो के सुनाथन, भगवान उजियार हबै अउ ओहमा कउनो अंधियार नेहको हबै। <verse eid="1JN 1:5"/><verse number="6" style="v" sid="1JN 1:6"/>अगर हम कथन कि ओखर संग संगति रखथन अउ अंधियार हे चलथन ता हम झूठ बोलथन अउ सच्चाई के जीवन नेहको जीथन। <verse eid="1JN 1:6"/><verse number="7" style="v" sid="1JN 1:7"/>अगर हम उजियार हे चलथन जउन मेर ऊ उजियार हे हबै, ता हमर अक दूसर लग संगति हबै अउ ओखर टोरवा यीसु मसीह के खून हमही सगलू पाप लग सुध्द के देथै<note caller="+" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="ISA 2:5">यसा 2:5</ref></char></note>।<verse eid="1JN 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1JN 1:8"/>अगर हम कथन कि हम कुछु पाप नेहको करे हबन, ता हम अपन खुद के धोखा देथन अउ हमर हे सत्य नेहको हबै। <verse eid="1JN 1:8"/><verse number="9" style="v" sid="1JN 1:9"/>अगर हम अपन पाप के मान लेबो, ता ऊ हमर पाप के छमा करी, अउ हमर सगलू अधरम लग सुध्द करी, काखे ऊ बिस्वास के काबिल अउ धरमी मनसे हबै<note caller="+" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="PSA 32:5">भजन 32:5</ref>; <ref loc="PRO 28:13">नीति 28:13</ref></char></note>। <verse eid="1JN 1:9"/><verse number="10" style="v" sid="1JN 1:10"/>अगर हम कथन कि पाप नेहको करे हबन, ता उके ठगरा ठहराउथन अउ ओखर बचन हमर हे नेहको हबै।<verse eid="1JN 1:10"/></para>
  <chapter eid="1JN 1"/>
  <chapter number="2" style="c" sid="1JN 2"/>
  <para style="s">यीसु मसीह हमर सहारा हबै</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 2:1"/>हे मोर लरका हइ बात मै तुमके इहैनिता लिखथो, कि तुम पाप झइ करा, अगर कउ पाप करथै ता बाफ के आगू हमर पाप लग बचाव करै बाले अक्ठी मददगार हबै, अउ ऊ धरमी यीसु मसीह हबै। <verse eid="1JN 2:1"/><verse number="2" style="v" sid="1JN 2:2"/>ऊ अक्ठी बलिदान हबै जउन हमर पाप के निता छमा मांगथै अउ न सिबाय हमर पाप के निता बलुक सगलू दुनिया के पाप के निता।<verse eid="1JN 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1JN 2:3"/>अगर हम भगवान के आदेस के मानबो, ता ओखरै लग हमही पता चलही कि हम उके जान गय हबन। <verse eid="1JN 2:3"/><verse number="4" style="v" sid="1JN 2:4"/>अगर जउन कउ हइ कथै कि मै उके जानथो, अउ ओखर आदेस के नेहको मानथै, ऊ ठगरा हबै, अउ ऊ सत्य नेहको हबै। <verse eid="1JN 2:4"/><verse number="5" style="v" sid="1JN 2:5"/>पय जउन कउ ओखर बचन के मानथै, ता ओहमा सहिमा भगवान के माया सही हबै, इहै लग हम जानथन कि हम भगवान हे हबन, एखर हइ सबूत हबै। <verse eid="1JN 2:5"/><verse number="6" style="v" sid="1JN 2:6"/>अगर हम कहि कि हम भगवान के संग एकता हे बने रहब, ता हमके ओसनेन जीवन जीये के चाही जसना मसीह यीसु करे रथै।<verse eid="1JN 2:6"/></para>
  <para style="s">सब लग माया करा</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 2:7"/>हे मोर पिरिया संगी मै तुमही कउनो नबा आदेस नेहको लिखथो, बलुक हइ अक्ठी पुरान आदेस हबै, जउन तुमही सुरु लग मिले रथै, हइ पुरान आदेस ऊ बचन हबै जेही तुम सुन चुके हबा। <verse eid="1JN 2:7"/><verse number="8" style="v" sid="1JN 2:8"/>फेरै मै तुमही अक्ठी अउ दूसर नबा आदेस लिखथो, ऊ नबा इहैनिता हबै कि ऊ मसीह हे सच्ची ठहरथै, काखे अंधियार मिटत जथै, अउ सही के उजियार चमकै लगिस।<verse eid="1JN 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 2:9"/>जउन कथै कि मै उजियार हव, अउ अपन भाई बेहन लग बैर करथै, ऊ अंधियार हे हबै। <verse eid="1JN 2:9"/><verse number="10" style="v" sid="1JN 2:10"/>जउन अपन भाई बेहन लग माया करथै, उहै उजियार हे रथै, अउ कउनो कारन नेहको कि उके ठोकड लगै। <verse eid="1JN 2:10"/><verse number="11" style="v" sid="1JN 2:11"/>जउन अपन भाई बेहन लग बैर करथै, ऊ अंधियार हे हबै अउ अंधियार हे चलथै, ऊ हइ नेहको जानथै कि ऊ कछो जथै, काखे अंधियार उके अंधरा बनाय दय हबै।<verse eid="1JN 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1JN 2:12"/>हे मोर पिरिय लरका मै तुमही इहैनिता लिखथो काखे यीसु मसीह के नाम लग तुम्हर पाप छमा करे गय हबै<note caller="+" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="PSA 25:11">भजन 25:11</ref></char></note>। <verse eid="1JN 2:12"/><verse number="13" style="v" sid="1JN 2:13"/>हे बाफ, मै तुमही इहैनिता लिखथो, काखे तुम जउन सुरू लग मवजूद हबै उके जानथा, हे जबान मै इहैनिता लिखथो, काखे तुम ऊ भुतवा हे बिजय पाय चुके हबा।<verse eid="1JN 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1JN 2:14"/>हे लरका, मै तुमके इहैनिता लिखथो, काखे तुम बाफ के चीन लय हबा, हे बाफ मै लिखथो, काखे तुम जउन दुनिया के सुरू लग मवजूद हबै उके जान गय हबा, हे जबान मै तुमके लिखथो, काखे तुम सक्ति साली हबा, भगवान के बचन तुम्हर हे बने रथै, अउ तुम भुतवा लग जीत चुके हबा।<verse eid="1JN 2:14"/></para>
  <para style="s">दुनिया लग माया झइ करा</para>
  <para style="p">
    <verse number="15" style="v" sid="1JN 2:15"/>तुम न दुनिया लग माया करा अउ न दुनिया के चीजन लग जउन दुनिया लग माया करथै, ओखर हे बाफ के माया नेहको। <verse eid="1JN 2:15"/><verse number="16" style="v" sid="1JN 2:16"/>दुनिया हे जउन देह के लालच अउ आंखी के लालच अउ धन डेरा के घमंड, ऊ बाफ लग नेहको बलुक दुनिया लग आथै<note caller="+" style="x"><char style="xo" closed="false">2:16 </char><char style="xt" closed="false"><ref loc="ROM 13:14">रोमियो 13:14</ref>; <ref loc="PRO 27:20">नीति 27:20</ref></char></note>। <verse eid="1JN 2:16"/><verse number="17" style="v" sid="1JN 2:17"/>दुनिया अउ ओखर लालच दोनो खतम होथै, पय जउन भगवान के इक्छा पूर करथै ऊ जुग-जुग तक बने रथै।<verse eid="1JN 2:17"/></para>
  <para style="s">मसीह के बैरी</para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 2:18"/>हे पिरिय लरका, हइ आखरी टेम आय गय हबै, तुम सुने हबा मसीह बिरोधी आमै बाले हबै, इहैनिता बोहत लग मसीह बिरोधी परगट होय हबै, एखर लग हम जानथन कि आखरी टेम आय गय हबै। <verse eid="1JN 2:18"/><verse number="19" style="v" sid="1JN 2:19"/>हइ मनसे सही हे हमर संगति के नेहको रथै, अउ इहैनिता हमके छांड दइन, अगर उन हमर संगति के होतिन ता हमर संग रहथै पय उन कड गइन ताकि हइ स्पस्ट हुइ सकै उनखर मसे कउनो सही हे हमर नेहको रथै।<verse eid="1JN 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 2:20"/>तुम्हर तो ऊ पवितर मनसे के पल्ला लग अभिसेक होय हबै, अउ तुम सगलू सत्य के जानथा। <verse eid="1JN 2:20"/><verse number="21" style="v" sid="1JN 2:21"/>मै तुमही इहैनिता नेहको लिखथो, कि तुम सत्य के नेहको जानथा, बलुक इहैनिता कि तुम सत्य के जानथा, अउ इहो जानथा कि जउन कुछ झूठ हबै ऊ सत्य लग नेहको हबै।<verse eid="1JN 2:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1JN 2:22"/>ठगरा मनसे कोहर हबै? उहै जउन यीसु मसीह के नेहको मानथै, उहै मसीह बिरोधी हबै, ऊ बाफ अउ टोरवा, दुनो के गरहन नेहको करथै। <verse eid="1JN 2:22"/><verse number="23" style="v" sid="1JN 2:23"/>जउन टोरवा के नेहको मानथै, ओखर हे बाफ नेहको रथै, जउन टोरवा के मानथै, ओखर लिघ्घो बाफ हबै।<verse eid="1JN 2:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1JN 2:24"/>जउन बचन तुम सुरु लग सुने हबा, ऊ तुम्हर हे हबै, जउन बचन तुम सुरु लग सुने हबा, अगर ऊ तुम्हर हे बने रही, ता तुम टोरवा अउ बाफ हे बने रइहा। <verse eid="1JN 2:24"/><verse number="25" style="v" sid="1JN 2:25"/>मसीह हमर लग जउन टीमा करे हबै। ऊ अनन्त जीवन हबै।<verse eid="1JN 2:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1JN 2:26"/>हइ बात मै तुमही ओखर बारे हे लिखे हव, जउन तुमही भटकामै चाहथै। <verse eid="1JN 2:26"/><verse number="27" style="v" sid="1JN 2:27"/>जउन अभिसेक तुम मनसे मसीह लग पाय हबा, ऊ तुम्हर हे मवजूद रथै, इहैनिता तुमही जरूरत नेहको कि कउनो मनसे सिखामै, मसीह लग मिले हर अभिसेक तुमही सगलू कुछ सिखाथै, ओखर सिक्छा सत्य हबै असत्य नेहको ऊ सिक्छा के जसना तुम मसीह हे बने रहा।<verse eid="1JN 2:27"/></para>
  <para style="s">हम भगवान कर टोरवा हबन</para>
  <para style="p">
    <verse number="28" style="v" sid="1JN 2:28"/>पिरिय लरका तुम उनखर हे बने रहा, जेखर लग जब ऊ परगट होय ता हमके पूर भरोसा होय अउ उनखर आय लग उनखर आगू हमके बेज्जती नेहको होय पडै। <verse eid="1JN 2:28"/><verse number="29" style="v" sid="1JN 2:29"/>अगर तुम जानथा, कि भगवान धरमी हबै, ता हइ जान लेया कि जउन धरमी काम करथै उहै भगवान कर टोरवा हबै।<verse eid="1JN 2:29"/></para>
  <chapter eid="1JN 2"/>
  <chapter number="3" style="c" sid="1JN 3"/>
  <para style="s">भगवान कर लरका</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 3:1"/>देखा बाफ हमर लग केतका माया करथै, कि हम भगवान के लरका कहाथन, अउ हमु सहीमा हे उहै हबै दुनिया हमके नेहको जानथै, काखे ऊ भगवान के नेहको जानथै। <verse eid="1JN 3:1"/><verse number="2" style="v" sid="1JN 3:2"/>पिरिया अब हम भगवान के लरका हवन, अउ अब हइ परगट नेहको हुइस कि हम का बनब हम एतका जानथन कि जब मसीह परगट होही ता हम ओखर जसना बन जाबे, काखे हम उनही ओसनेन देखबो जसना कि ऊ सहीमा हबै। <verse eid="1JN 3:2"/><verse number="3" style="v" sid="1JN 3:3"/>अउ जउन कउ मसीह लग असना आसा करथै, उके ओसनेन पवितर बनै चाही, जसना मसीह पवितर हबै।<verse eid="1JN 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 3:4"/>जउन मनसे पाप करथै, ऊ बेकार काम करथै, काखे पाप के मतलब अधरम के साथ देना। <verse eid="1JN 3:4"/><verse number="5" style="v" sid="1JN 3:5"/>तुम जानथा कि मसीह हमर पाप छमा करै के निता आइस, ओखर हे कउनो पाप नेहको हबै। <verse eid="1JN 3:5"/><verse number="6" style="v" sid="1JN 3:6"/>जउन कउ ओहमा बने रथै, ऊ पाप नेहको करथै, जउन कउ पाप करथै ऊ उनही नेहको देखे हबै, अउ ऊ उनही नेहको जानथै।<verse eid="1JN 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 3:7"/>पिरिय लरका कउनो तुमके झइ भरमाय, जउन धरमी के काम करथै, ऊ मसीह के जसना धरमी हबै। <verse eid="1JN 3:7"/><verse number="8" style="v" sid="1JN 3:8"/>जउन पाप करथै ऊ भुतवा लग हबै, काखे भुतवा सुरु लग पाप करत आय हबै, भगवान कर टोरवा इहैनिता परगट हुइस कि ऊ भुतवा के काम खतम के दे।<verse eid="1JN 3:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 3:9"/>जउन कउ भगवान लग पइदा हुइस, ऊ पाप नेहको करथै, काखे भगवान बीज रूपी बचन ओखर हे बने रथै, ऊ पाप नेहको के सकथै, काखे ऊ भगवान लग पइदा होय हबै। <verse eid="1JN 3:9"/><verse number="10" style="v" sid="1JN 3:10"/>भगवान के लरका कउन हबै? अउ भुतवा के लरका कउन हबै? तुम उनके हइमेर जान सकथै, सगलू मनसे जउन धरमी के काम हे नेहको चलथै अउ अपन भाई के माया नेहको करथै, ऊ भगवान के नेहको हबै।<verse eid="1JN 3:10"/></para>
  <para style="s">अक दूसर लग माया रखा</para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 3:11"/>जउन संदेस तुम सुरु लग सुने हबा, ऊ हइ हबै कि अक दूसर लग माया रखै चाही। <verse eid="1JN 3:11"/><verse number="12" style="v" sid="1JN 3:12"/>हम कैन के जसना झइ बनी, ऊ भुतवा के लरका रथै, अउ ऊ अपन भाई के मारिस अउ ऊ ओखर हत्या काखे करिस? काखे ओखर काम बेकार रथै, अउ ओखर भाई के धरमी काम रथै<note caller="+" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="PSA 38:20">भजन 38:20</ref></char></note><verse eid="1JN 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 3:13"/>भाई अउ बेहन अगर दुनिया तुम्हर लग बैर करथै ता चकित झइ हुइहा। <verse eid="1JN 3:13"/><verse number="14" style="v" sid="1JN 3:14"/>हम जानथन कि मरै लग पार हुइके जीवन हे पहुंचे हबन, काखे हम भाई बेहन लग माया करथन, जउन माया नेहको करथै ऊ मरै के दसा हे रथै। <verse eid="1JN 3:14"/><verse number="15" style="v" sid="1JN 3:15"/>जउन कउनो अपन भाई लग बैर रखही ऊ खूनी हबै, अउ तुम जानथा कि कउनो खूनी हे अनन्त जीवन नेहको होथै। <verse eid="1JN 3:15"/><verse number="16" style="v" sid="1JN 3:16"/>मसीह हमार निता अपन जीवन छांड दय हबै, इहै लग हम जान गय हबन कि माया का हबै? हमु के अपन भाइन के निता अपन परान दइ दे चाही। <verse eid="1JN 3:16"/><verse number="17" style="v" sid="1JN 3:17"/>इहैनिता जेखर लिघ्घो दुनिया के धन डेरा हबै, अउ जउन अपन भाई के परसानी हे देखके ओखर हे दया नेहको करथै, ओखर हे भगवान के माया हबै हइ कसके कहे जाय सकथै<note caller="+" style="x"><char style="xo" closed="false">3:17 </char><char style="xt" closed="false"><ref loc="DEU 15:7-8">बेवस्थाबिबरन 15:7-8</ref></char></note>। <verse eid="1JN 3:17"/><verse number="18" style="v" sid="1JN 3:18"/>हे पिरिय लरका, हमर माया जीभ अउ बातन लग नेहको पय काम अउ सत्य लग माया करै।<verse eid="1JN 3:18"/></para>
  <para style="s">भगवान कर लिघ्घो हिम्मत</para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 3:19"/>इहै लग हम जान जाबे कि हम सत्य के हबन अउ भगवान कर आगू अपन मन के हिम्मत दइ सकथन। <verse eid="1JN 3:19"/><verse number="20" style="v" sid="1JN 3:20"/>काखे भगवान हमर मन लग बड्डे हबै, अउ सगलू कुछ जानथै। <verse eid="1JN 3:20"/><verse number="21" style="v" sid="1JN 3:21"/>हे पिरिया लरका, अगर कउ बेकार काम करत टेम हमर मन हमके दोसी ठहराथै ता भगवान के आगू हमर बिस्वास बने रथै। <verse eid="1JN 3:21"/><verse number="22" style="v" sid="1JN 3:22"/>हम ओखर लग जउन कुछ मांगबो ऊ हमके उहै देही, काखे हम ओखर आदेसन के मानथन अउ उहै करथन जउन उके निक्खा लगथै। <verse eid="1JN 3:22"/><verse number="23" style="v" sid="1JN 3:23"/>अउ ओखर आदेस हइ हबै कि हम ओखर टोरवा यीसु मसीह के नाम हे बिस्वास करी अउ अक दूसर लग माया करी, जसना मसीह हमके आदेस दय हबै। <verse eid="1JN 3:23"/><verse number="24" style="v" sid="1JN 3:24"/>जउन भगवान के आदेसन के मानथै, अउ उहै हे बने रथै, अउ ओखर हे भगवान निबास करथै, इहैमेर ऊ आतमा के दवारा जेही भगवान हमके दय हबै, हम हइ जानथन कि भगवान हमर भित्तर रथै।<verse eid="1JN 3:24"/></para>
  <chapter eid="1JN 3"/>
  <chapter number="4" style="c" sid="1JN 4"/>
  <para style="s">सच्चा अउ ठगरा आतमा</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 4:1"/>हे पिरिया संगी सब आतमा हे बिस्वास झइ करा, बलुक उनही परख के देखा कि उन भगवान के पल्ला लग हबै या नेहको, काखे बोहत लग ठगरा ग्यानी मनसे दुनिया हे आय गय हबै। <verse eid="1JN 4:1"/><verse number="2" style="v" sid="1JN 4:2"/>भगवान कर आतमा के तुम चीन्ह सकथा, सगलू ऊ आतमा जउन हइ मानथै, कि “यीसु मसीह मनसे के देह के सकल हे भुंइ हे आय हबै” ऊ भगवान के पल्ला लग हबै। <verse eid="1JN 4:2"/><verse number="3" style="v" sid="1JN 4:3"/>पय जउन आतमा जउन यीसु मसीह के नेहको मानथै, उन भगवान के पल्ला लग नेहको हबै, असना मनसे मसीह के बैरी हबै, जेखर बारे हे तुम सुने हबा कि ऊ आथै, बलुक ऊ हइ दुनिया हे हबै।<verse eid="1JN 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 4:4"/>हे पिरिय लरका, तुम भगवान के हबा इहैनिता तुम मसीह के बैरी लग जीत गय हबा, काखे ऊ भगवान जउन तुम्हर हे हबै, जउन दुनिया हे रहै बाले भुतवा लग बड्डे हबै। <verse eid="1JN 4:4"/><verse number="5" style="v" sid="1JN 4:5"/>उन दुनिया के ठगरा आगू कर बात गुठेय बाले हबै, इहै कारन उन दुनिया के बात बोलथै अउ दुनिया उनखर सुनथै। <verse eid="1JN 4:5"/><verse number="6" style="v" sid="1JN 4:6"/>पय हम भगवान के हबन इहैनिता जउन भगवान के जानथै, ऊ हमर सुनथै पय जउन भगवान के नेहको जानथै, ऊ हमर नेहको सुनथै, हइ कारन हम सत्य के आतमा अउ भरमाय बाले आतमा के चीन्ह सकथन।<verse eid="1JN 4:6"/></para>
  <para style="s">भगवान माया हबै</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 4:7"/>हे पिरिया संगी, हम अक दूसर लग माया करी, काखे माया भगवान लग मिलथै, अउ जउन माया करथै, ऊ भगवान के लरका बन गय हबै, अउ भगवान के जानथै। <verse eid="1JN 4:7"/><verse number="8" style="v" sid="1JN 4:8"/>जउन कउनो माया नेहको रखथै, ऊ भगवान के नेहको जानथै, काखे भगवान माया हबै। <verse eid="1JN 4:8"/><verse number="9" style="v" sid="1JN 4:9"/>जउन माया भगवान हमर लग रखथै, ऊ एखर लग परगट हुइस कि भगवान अपन अकठेन टोरवा के दुनिया हे पठोय हबै कि हम ओखर दवारा जीवन पइ। <verse eid="1JN 4:9"/><verse number="10" style="v" sid="1JN 4:10"/>माया एखर हे नेहको कि हम भगवान लग माया करेन, बलुक भगवान हमर लग माया करिस अउ हमर पाप छमा के निता अपन टोरवा के पठोइस।<verse eid="1JN 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 4:11"/>हे पिरिया संगी, अगर भगवान हमर लग एतका माया करिस, ता हमु के अक दूसर लग माया करै के चाही। <verse eid="1JN 4:11"/><verse number="12" style="v" sid="1JN 4:12"/>भगवान के कबहुन कोनो नेहको देखे हबै, अगर हम अक दूसर लग माया करथन, ता भगवान हमर हे निबास करथै, अउ हम ओखर हे अउ ओखर माया हमर भित्तर आय जथै।<verse eid="1JN 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 4:13"/>भगवान हमके अपन आतमा दय हबै, इहैनिता हम जान जथन कि हम ओखर हे अउ ऊ हमर हे निबास करथै। <verse eid="1JN 4:13"/><verse number="14" style="v" sid="1JN 4:14"/>बाफ अपन टोरवा के दुनिया के मुकति करै बाले के रूप हे पठोइस हम हइ देखे हबन अउ हम एखर गवाही देथन। <verse eid="1JN 4:14"/><verse number="15" style="v" sid="1JN 4:15"/>अगर कउ मानथै कि, “यीसु मसीह भगवान कर टोरवा हबै” ता भगवान ओखर हे निबास करथै अउ ऊ भगवान हे। <verse eid="1JN 4:15"/><verse number="16" style="v" sid="1JN 4:16"/>इहैमेर हम अपन परति भगवान कर माया जान गयन अउ एखर हे बिस्वास करथन भगवान माया हबै, अउ जउन माया हे बने रथै ऊ भगवान हे बने रथै, अउ भगवान ओखर हे निबास करथै। <verse eid="1JN 4:16"/><verse number="17" style="v" sid="1JN 4:17"/>इहैमेर माया हमर लग अपन भरपूर तक पहुंच जथै, जेखर लग हम नियाव के रोज पूर भरोसा रख सकै, काखे जसना मसीह हबै, ओसनेन हमु हइ दुनिया हे हबन। <verse eid="1JN 4:17"/><verse number="18" style="v" sid="1JN 4:18"/>माया लग डर नेहको होथै पूर माया डेर के दुरिहां कर देथै, काखे डेर के सबंध सजा लग होथै अउ जउन डेराथै ओखर माया पूरी तरह लग नेहको पहुंचथै।<verse eid="1JN 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 4:19"/>इहैनिता हम माया करथन, काखे भगवान आगू हमर लग माया करिस। <verse eid="1JN 4:19"/><verse number="20" style="v" sid="1JN 4:20"/>अगर कउ हइ कथै “मै भगवान लग माया रखथो” अउ अपन भाई लग बैर करथै, ता ऊ ठगरा हबै, काखे अपन भाई लग जेही उके देखय हबै, माया नेहको करथै ता ऊ भगवान लग जेही ऊ नेहको देखै हबै, ता ऊ माया नेहको के सकथै। <verse eid="1JN 4:20"/><verse number="21" style="v" sid="1JN 4:21"/>मसीह लग हमके हइ आदेस मिले हबै ऊ जउन भगवान कर माया करथै, उके अपन भाई लग माया करै चाही।<verse eid="1JN 4:21"/></para>
  <chapter eid="1JN 4"/>
  <chapter number="5" style="c" sid="1JN 5"/>
  <para style="s">बिस्वास दवारा दुनिया हे जीत</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 5:1"/>जउन कउ बिस्वास करथै कि यीसु मसीह हबै, ऊ भगवान के लरका बन जथै अउ जउन कउ भगवान बाफ लग माया करथै ऊ ओखर लरका लग माया करथै। <verse eid="1JN 5:1"/><verse number="2" style="v" sid="1JN 5:2"/>इहैनिता अगर हम भगवान लग माया करथन अउ ओखर आदेस के मानथन ता हम सहिमा भगवान के लरका लग माया करथन। <verse eid="1JN 5:2"/><verse number="3" style="v" sid="1JN 5:3"/>काखे भगवान के माया हइ हबै कि हम ओखर आदेस के मानथन, अउ ओखर आदेस गरू नेहको हबै<note caller="+" style="x"><char style="xo" closed="false">5:3 </char><char style="xt" closed="false"><ref loc="MAT 11:30">मत्ती 11:30</ref></char></note>। <verse eid="1JN 5:3"/><verse number="4" style="v" sid="1JN 5:4"/>काखे जउन भगवान लग पइदा होय हबै, ऊ दुनिया लग जीत पाय गय हबै, ऊ बिजय जउन दुनिया के हराय देथै, हमर बिस्वास हबै। <verse eid="1JN 5:4"/><verse number="5" style="v" sid="1JN 5:5"/>जउन हइ बिस्वास करथै कि यीसु मसीह भगवान कर टोरवा हबै, ऊ दुनिया लग जीते हर कोन हबै?<verse eid="1JN 5:5"/></para>
  <para style="s">यीसु मसीह कर बारे हे गवाह</para>
  <para style="p">
    <verse number="6" style="v" sid="1JN 5:6"/>यीसु मसीह ऊ जउन अपन बतिस्मा के पानी अउ मिरतू के खून के संग आय रथै, ऊ न केबल पानी के संग आइस अउ आतमा खुस गवाही देथै, कि हइ सत्य हबै काखे कि आतमा सत्य हबै। <verse eid="1JN 5:6"/><verse number="7" style="v" sid="1JN 5:7"/>गवाही देय बाले तीनझन हबै। <verse eid="1JN 5:7"/><verse number="8" style="v" sid="1JN 5:8"/>आतमा पानी अउ खून अउ हइ तीनोझन अक्ठिन बात कथै। <verse eid="1JN 5:8"/><verse number="9" style="v" sid="1JN 5:9"/>हम मनसेन के गवाह स्वीकार करथन, पय भगवान के गवाही ओखर लग बढके हबै, ओखर गवाही हइ हबै कि भगवान अपन टोरवा के बारे हे गवाही दय हबै। <verse eid="1JN 5:9"/><verse number="10" style="v" sid="1JN 5:10"/>जउन भगवान कर टोरवा हे बिस्वास करथै, ओखर हिरदय हे भगवान के हइ गवाह बने रथै, जउन भगवान हे बिस्वास नेहको करथै, ऊ उके ठगरा समझथै, काखे ऊ टोरवा के बारे हे भगवान के गवाह के गरहन नेहको करथै।<verse eid="1JN 5:10"/></para>
  <para style="s">सबरोज कर जीवन</para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 5:11"/>अउ ऊ गवाही हइ हबै, भगवान हमके सबरोज के जीवन दय हबै, अउ हइ जीवन ओखर टोरवा हे हबै। <verse eid="1JN 5:11"/><verse number="12" style="v" sid="1JN 5:12"/>जेही टोरवा मिल गय हबै, ओही जीवन मिल गय हबै, अउ जेही भगवान कर टोरवा नेहको मिले हबै, ओखर हे जीवन नेहको हबै। <verse eid="1JN 5:12"/><verse number="13" style="v" sid="1JN 5:13"/>तुम सगला भगवान कर टोरवा के नाम हे बिस्वास करथा, मै तुमके हइ चिट्ठी लिखथो जेखर लग तुम हइ जान लेया कि तुमही अनन्त काल के जीवन मिले हबै।<verse eid="1JN 5:13"/></para>
  <para style="s">परभावित बिनती</para>
  <para style="p">
    <verse number="14" style="v" sid="1JN 5:14"/>अउ हमके ओखर आगू जउन हियाव होथै, ऊ हइ हबै, कि अगर हम ओखर इक्छा के जसना कुछ मगबो ता ऊ हमर सुनथै। <verse eid="1JN 5:14"/><verse number="15" style="v" sid="1JN 5:15"/>अउ हम हइ जानथन कि ऊ हमर सुनथै, चाहे हम कुछु मांगी हम हइ जानथन कि जउन कुछु भगवान लग मांगे हबन ऊ हमके मिल गय हबै।<verse eid="1JN 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 5:16"/>अगर कउ अपन भाई अउ बेहन के असना पाप करत देखथै, जउन मिरतू नेहको हबै ता ऊ ओखर निता बिनती करै अउ भगवान उके जीवन दे मै ओखर निता जीवन के बारे हे बात करथो, जउन असना पाप करै हे लगे हबै जउन उके अनन्त मिरतू लग नेहको पहुंचाहीं, असना पाप होथै जेखर फडुहा मिरतू हबै, मै तुम्हर लग असना पाप के बारे हे बिनती करै के नेहको कथो। <verse eid="1JN 5:16"/><verse number="17" style="v" sid="1JN 5:17"/>सगलू बेकार काम पाप हबै, पय असना पाप होथै जउन मिरतू के पल्ला नेहको लइ जथै।<verse eid="1JN 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 5:18"/>हम जानथन कि जउन भगवान लग पइदा होय हबै, ऊ पाप नेहको करथै, भगवान कर टोरवा ओखर मदद करथै अउ दुस्ट भुतवा उके नेहको छू पाथै।<verse eid="1JN 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 5:19"/>हम जानथन कि हम भगवान के हबन, पय सगलू दुनिया ऊ भुतवा के कबजा हे हबै<note caller="+" style="x"><char style="xo" closed="false">5:19 </char><char style="xt" closed="false"><ref loc="GAL 1:4">गलातियों 1:4</ref>; <ref loc="JHN 8:47">यूहन्ना 8:47</ref></char></note>।<verse eid="1JN 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 5:20"/>हम जानथन कि भगवान कर टोरवा आय गय हबै, अउ ऊ हमही दिमाक दय हबै कि हम ऊ भगवान के जान लइ जउन सत्य हबै, काखे हम ओखर टोरवा यीसु मसीह हे निबास करथन, इहै सच्चे भगवान अउ सबरोज के जीवन इहै हबै।<verse eid="1JN 5:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1JN 5:21"/>हे लरका, अपन खुद के ठगरा मूरतिन लग बचाय रखिहा।<verse eid="1JN 5:21"/></para>
  <chapter eid="1JN 5"/>
</usx>
