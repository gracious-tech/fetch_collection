<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1PE" style="id">- Bhumiya Standard Project</book>
  <para style="h">पतरस</para>
  <para style="toc3">1 पतरस</para>
  <para style="toc2">1 पतरस</para>
  <para style="toc1">1 पतरस कर सुरूवात चिट्ठी</para>
  <para style="mt2">1 पतरस की सुरूआत की चिट्ठी</para>
  <para style="mt1">1 पतरस कर सुरुवात के चिट्ठी</para>
  <para style="imt">परचा</para>
  <para style="ip">1 पतरस के चिट्ठी प्रेरित पतरस दवारा लिखे गय रथै, पतरस अपन चिट्ठी के सुरुवात हे हइ कथै कि ऊ कोन रथै अउ करही लिखथै। ऊ उन सगलू मसीहियन के चिट्ठी संबोधित करिस जउन ऊ “अनचिन्हार” <char style="xt"><ref loc="1PE 1:1">1:1</ref>; <ref loc="1PE 1:17">1:17</ref></char> अउ <char style="xt"><ref loc="1PE 2:11">2:11</ref></char> कथै उन अपन पढै बालेन के हइ मेर कइबेर संकेतिक करिस काखे ऊ अलगे-अलगे देसन हे बगरे हर रथै। काखे हइ चिट्ठी कुछ इफिसियन के लिखे गय रथै। पोलुस के चिट्ठी लग मिलत-जुलत हबै, बोहत मनसे मानथै कि 1 पतरस इफिसियों के बाद मसीह के पइदा के करीबन 65 साल बाद लिखे गय रथै। पतरस हइ चिट्ठी रोम सहर लग लिखे रथै जेही ऊ बाबुल <char style="xt"><ref loc="1PE 5:13">5:13</ref></char> कहे रथै।</para>
  <para style="ip">पतरस कथै कि ऊ हइ चिट्ठी तुमके प्रोत्साहन करै के अउ हइ बात के गवाही देय के निता लिखे हबै कि हइ भगवान के सच्चा किरपा हबै <char style="xt" closed="false"><ref loc="1PE 5:12">5:12</ref>; <ref loc="1PE 2:11-3:7">1 पतरस 2:11—3:7</ref> </char><char style="xt"><ref loc="EPH 5:18-6:9">इफिसियों 5:18—6:9</ref></char> अउ <char style="xt"><ref loc="COL 3:18-4:6">कुलुस्सियो 3:18—4:6</ref></char> के बीच अक जसना हबै। हइ तीनो खंड परवार सबंध अउ आदेस के मानै बाले अधिकारिन के बारे हे उपदेस देथै। ऊ मसीहियन के प्रोत्साहन करथै कि जब दुख हे हबा, ता मजबूत रहा काखे आखरी लिघ्घो हबै। <char style="xt"><ref loc="1PE 4:1">4:1</ref></char></para>
  <para style="iot">रूप रेखा</para>
  <para style="io1">1. पतरस अपन परचा देथै अउ अपन पढै के संबोधित करथै। <char style="ior"><ref loc="1PE 1:1-2">1:1-2</ref> </char></para>
  <para style="io1">2. फेर ऊ उस मुकति के निता भगवान के धन्यबाद करथै जेही ऊ सबझन के साझा करथै अउ जउन उनखर जीवन के निता खास रखथै। <char style="ior"><ref loc="1PE 1:3-2:10">1:3—2:10</ref></char></para>
  <para style="io1">3. एखर बाद ऊ बिस्वासिन के उपदेस देथै कि कइसन दुनिया हे निक्खा मेर लग रहै के हबै अउ डउका अउ डउकी अउ हरवाह अउ मालिक के बीच कइमेर सबंध के संबोधित करथै। <char style="ior"><ref loc="1PE 2:11-4:11">2:11—4:11</ref></char></para>
  <para style="io1">4. एखर बाद पतरस उनके दुख सहै के निता प्रोत्साहन करथै। <char style="ior"><ref loc="1PE 4:12-5:11">4:12—5:11</ref></char></para>
  <para style="io1">5. फेर ऊ अपन चिट्ठी के समापत करथै। <char style="ior"><ref loc="1PE 5:12-14">5:12-14</ref> </char></para>
  <chapter number="1" style="c" sid="1PE 1"/>
  <para style="s">सोगत</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 1:1"/>यीसु मसीह के चेला पतरस के तरफ लग हइ चिट्ठी भगवान के उन बगरे हर सेबक के नाम हबै, जउन पुन्तुस, गलातिया, कप्पदूकिया, आसिया अउ बितूनिया परदेस हे छिदिर बिदिर हुइके रथै, <verse eid="1PE 1:1"/><verse number="2" style="v" sid="1PE 1:2"/>जउन बाफ भगवान पहिलेन के ग्यान के जसना बोलाय गय हबा, अउ आतमा पवितर के दवारा पवितर करे गय हबा, जेखर लग उन यीसु मसीह के आदेस के पालन करै अउ ओखर खून छिडकाव के निता तुमही चुने गय हबा।</para>
  <para style="p" vid="1PE 1:2">तुमही अनुगरह किरपा अउ सान्ति बोहत लग मिलत रहै।<verse eid="1PE 1:2"/></para>
  <para style="s">अक्ठी जिन्दा आसरा</para>
  <para style="p">
    <verse number="3" style="v" sid="1PE 1:3"/>हमर परभु यीसु मसीह के भगवान अउ बाफ के धन्यबाद होय जउन यीसु मसीह के मरे हर मसे जिन्दा होय के दवारा, अपन बडी दया लग हमके जिन्दा आसा के निता नबा जनम दइस, <verse eid="1PE 1:3"/><verse number="4" style="v" sid="1PE 1:4"/>जउन फिरी हे तुम्हर निता स्वरग हे धररे हबै, ऊ हरमेसा के जीवन सुध्द अउ अजर हबै। <verse eid="1PE 1:4"/><verse number="5" style="v" sid="1PE 1:5"/>तुम्हर बिस्वास के दवारा भगवान के सक्ति तुमही ऊ मुकति के निता, जउन अबे परगट हबै, अउ आमै बाले टेम के आखरी हे परगट होमै बाले हबै।<verse eid="1PE 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1PE 1:6"/>हइ तुम्हर निता बडा मगन के बिसय हबै, पय जरूरी हबै कि अभिनैन कुछ रोज के निता सबैमेर के दुख सहै के पडथै। <verse eid="1PE 1:6"/><verse number="7" style="v" sid="1PE 1:7"/>हइ इहैनिता होथै कि तुम्हर परखे हर बिस्वास परिक्छा हे मजबूत निकरै, सोनो तो आगी हे पिघलाय जथै अउ तुम्हर बिस्वास नास होंय बाले सोना लग कहुं बोहत कीमती हबै, हइ मेर तुम्हर बिस्वास यीसु मसीह के परगट होमै तक परसंसा अउ महिमा अउ आदर इज्जत के कारन बना<note caller="+" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="JOB 23:1">अयूब 23:1</ref>; <ref loc="PSA 66:10">भजन 66:10</ref>; <ref loc="ISA 48:10">यसा 48:10</ref>; <ref loc="JAS 1:12">याकूब 1:12</ref></char></note>। <verse eid="1PE 1:7"/><verse number="8" style="v" sid="1PE 1:8"/>तुम यीसु के कबहुन नेहको देखे हबा, तउभरमा ओखर लग माया करथा, अउ तुम उके हइ टेम नेहको देखत हबा, तउभरमा तुम ओखर हे बिस्वास करत हबा अउ असना खुसी अउ मगन लग जउन सोचबिचार लग बाहिर हबै, जउन भगवान के महिमा लग भररे हर हबै। <verse eid="1PE 1:8"/><verse number="9" style="v" sid="1PE 1:9"/>हइ बिस्वास के फडुहा हबै, तुम्हर आतमा के मुकति।<verse eid="1PE 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1PE 1:10"/>इहै मुकति के बारे हे उन ग्यानी मनसे बोहत खोजिन अउ जांच-पडताल करिन, उन दया के बारे हे जउन तुम्हर हे होमै बाले रथै, आगू कर बात गुठेय रहिन। <verse eid="1PE 1:10"/><verse number="11" style="v" sid="1PE 1:11"/>उन हइ बात के खोजिन कि मसीह के आतमा उन ग्यानी मनसेन हे रथै अउ आगुन लग ऊ मसीह के दुख अउ एखर बाद आमै बाले महिमा के गवाह देयत रहिस, ग्यानी मनसे हइ जानै चाहथै कि आतमा केतका टेम अउ कउन समस्या के तरफ इसारा करथै<note caller="+" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="2PE 1:21">2 पतरस 1:21</ref>; <ref loc="ISA 52:13-14">यसा 52:13-14</ref>; <ref loc="LUK 24:25-27">लूका 24:25-27</ref></char></note>। <verse eid="1PE 1:11"/><verse number="12" style="v" sid="1PE 1:12"/>उनखर हे परगट करे गइस कि जब उन संदेस सुनाउत रहिन, तब उन अपन निता नेहको, पय तुम्हर सेबा के निता बात करथै। अब संदेस के परचार स्वरग लग पठोय हर पवितर आतमा के दवारा लग, तुमही उहै संदेस सुनाथै, स्वरगदूतो इन बातन के पूरी जानकारी हासिल करै के निता तइयार हबै।<verse eid="1PE 1:12"/></para>
  <para style="s">पवितर जीवन जिये के बुलउवा</para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 1:13"/>हइ कारन अपन-अपन दिमाक के कमर बांध के अउ सचेत रही के ऊ अनुगरह किरपा के पूर आसा रखा जउन यीसु मसीह के परगट होय के निता टेम तुमके मिलै बाले हबै। <verse eid="1PE 1:13"/><verse number="14" style="v" sid="1PE 1:14"/>तुम आदेस मानै बाले लरका बनके अपन इक्छा के मेर बेउहार झइ करा, जसना कि पहिले करे करत रहिन, जब तुमही ग्यान नेहको मिले रहिस। <verse eid="1PE 1:14"/><verse number="15" style="v" sid="1PE 1:15"/>पय जसना तुम्हर बोलामै बाले पवितर हबै, ओसनेन तुमो अपन सगलू चाल चलन हे पवितर बना। <verse eid="1PE 1:15"/><verse number="16" style="v" sid="1PE 1:16"/>काखे मूसा कर किताब हे लिखवरे हबै, “पवितर बना, काखे मै पवितर हबो<note caller="+" style="x"><char style="xo" closed="false">1:16 </char><char style="xt" closed="false"><ref loc="LEV 11:44">लयबेवस्था 11:44</ref>; <ref loc="LEV 19:2">19:2</ref>; <ref loc="LEV 20:7">20:7</ref></char></note>।”<verse eid="1PE 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1PE 1:17"/>अगर तुम उके “हे बाफ” बिनती करके कथै, जउन दूसर के पक्छ लय बिना सबझन के कामन के जसना नियाव करथै, ता जब तक इछो परदेसी हे रथा, तब तक डर के जीवन जिया<note caller="+" style="x"><char style="xo" closed="false">1:17 </char><char style="xt" closed="false"><ref loc="2CH 19:7">2 इति 19:7</ref>; <ref loc="ISA 59:18">यसा 59:18</ref>; <ref loc="PSA 28:4">भजन 28:4</ref>; <ref loc="JER 17:10">इरमि 17:10</ref></char></note>। <verse eid="1PE 1:17"/><verse number="18" style="v" sid="1PE 1:18"/>तुम जानत हबा कि तुम्हर बेकार चाल चलन पुरखन लग चले आय हबै, ओखर लग तुमही मुकति सोना चांदी नास होमै बाले चीजन लग नेहको होय हबै<note caller="+" style="x"><char style="xo" closed="false">1:18 </char><char style="xt" closed="false"><ref loc="PSA 49:7-8">भजन 49:7-8</ref>; <ref loc="GAL 1:4">गलातियों 1:4</ref>; <ref loc="ISA 52:3">यसा 52:3</ref></char></note>, <verse eid="1PE 1:18"/><verse number="19" style="v" sid="1PE 1:19"/>पय निरदोस अउ बिना पाप के गेडरा, मतलब मसीह के कीमती खून के दवारा हुइस। <verse eid="1PE 1:19"/><verse number="20" style="v" sid="1PE 1:20"/>ऊ दुनिया के सुरुवात के आगुन लग ठहराय गय रथै, पय हइ टेम के आखरी युग हे तुम्हर निता परगट हुइस। <verse eid="1PE 1:20"/><verse number="21" style="v" sid="1PE 1:21"/>उहै के दवारा तुम अबे तक भगवान के परति बिस्वासी हबै, भगवान ओही मरे हर मसे जिन्दा करिस अउ महिमा दइस कि तुम्हर बिस्वास अउ आसा भगवान हे होय।<verse eid="1PE 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1PE 1:22"/>तुम आदेस मान के सत्य के गरहन करे हबा अउ हइ मेर बिना कपट के हरमेसा माया के निता अपन आतमा के पवितर के लय हबै, इहैनिता अब तुमही सुध्द हिरदय अउ तन-मन लगाय के अक दूसर लग माया करै चाही। <verse eid="1PE 1:22"/><verse number="23" style="v" sid="1PE 1:23"/>तुम्हर नबा पइदा नास होमै बाले नेहको पय हरमेसा के जीवन मतलब भगवान के जिन्दा अउ सबदिन ठहरैय बाले बचन के दवारा होय हबै। <verse eid="1PE 1:23"/><verse number="24" style="v" sid="1PE 1:24"/>काखे सगलू देह चारा मेर,</para>
  <para style="q1" vid="1PE 1:24">अउ ओखर सोभा पतेरन के फूल के जसना हबै,</para>
  <para style="q2" vid="1PE 1:24">चारा मुरझाय जथै,</para>
  <para style="q1" vid="1PE 1:24">फूल झड जथै।<verse eid="1PE 1:24"/></para>
  <para style="q2">
    <verse number="25" style="v" sid="1PE 1:25"/>“पय परभु के बचन जुगजुग तक बने रथै, अउ हइ बचन ऊ संदेस हबै, जउन तुमही सुनाय गय हबै<note caller="+" style="x"><char style="xo" closed="false">1:25 </char><char style="xt" closed="false"><ref loc="ISA 40:6-8">यसा 40:6-8</ref></char></note>।”<verse eid="1PE 1:25"/></para>
  <chapter eid="1PE 1"/>
  <chapter number="2" style="c" sid="1PE 2"/>
  <para style="s">जिन्दा पथरा अउ पवितर मनसे</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 2:1"/>तुम सबैमेर के बैर भाव, छल कपट, डाह, अउ निदरा के पूरी तरह लग छांड देया। <verse eid="1PE 2:1"/><verse number="2" style="v" sid="1PE 2:2"/>जबा पइदा होय हर लरका के जसना सुध्द आतमिक दूध के लालसा करा, ताकि ओखर दवारा मुकति पामै के निता बढत जा<note caller="+" style="x"><char style="xo" closed="false">2:2 </char><char style="xt" closed="false"><ref loc="PSA 34:8">भजन 34:8</ref></char></note>, <verse eid="1PE 2:2"/><verse number="3" style="v" sid="1PE 2:3"/>काखे तुम परभु के किरपा के मिठास चीख लग हबै।<verse eid="1PE 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1PE 2:4"/>अब तुम ओखर लिघ्घो आय हबा, जउन जिन्दा पथरा हबै, जेही मनसे बेकार समझ के छांड दय रहिन पय भगवान के दवारा चुने हर अउ ओखर नजर हे कीमती हबै, तुम ओखर लिघ्घो आबा। <verse eid="1PE 2:4"/><verse number="5" style="v" sid="1PE 2:5"/>तुम खुद जिन्दा पथरन के जसना आतमिक घर बनत जा, जेखर लग याजकन के पवितर समाज बनके, असना आतमिक बलि चढावा जउन यीसु मसीह के दवारा भगवान के गरहन होय। <verse eid="1PE 2:5"/><verse number="6" style="v" sid="1PE 2:6"/>इहैनिता पवितर किताब हे लिखवरे हबै,</para>
  <para style="q1" vid="1PE 2:6">“देखा, मै सियोन डोंगर अक्ठी चुने हर कीमती कोन्टा के पथरा धरथो,</para>
  <para style="q2" vid="1PE 2:6">अउ जउन कउ ओखर हे बिस्वास करही,</para>
  <para style="q2" vid="1PE 2:6">उके कउनो मेर के लज्जित नेहको होमैके पडही<note caller="+" style="x"><char style="xo" closed="false">2:6 </char><char style="xt" closed="false"><ref loc="ISA 8:16">यसा 8:16</ref> </char></note>।”<verse eid="1PE 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 2:7"/>तुम्हर निता, जउन बिस्वास करथा, ऊ पथरा कीमती हबै, जउन बिस्वास नेहको करथै, उनखर निता पवितर किताब हइ कथै,</para>
  <para style="q1" vid="1PE 2:7">“राज मिसतिरी जउन पथरा के बेकार समझ के निकाड देथै,</para>
  <para style="q2" vid="1PE 2:7">उहै कोन्टा के नीह बन गइस<note caller="+" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="PSA 118:22">भजन 118:22</ref></char></note>।”<verse eid="1PE 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 2:8"/>अउ इहो लिखवरे हबै,</para>
  <para style="q1" vid="1PE 2:8">“ऊ असना पथरा हबै जेखर लग मनसेन के ठोकड लगथै,</para>
  <para style="q2" vid="1PE 2:8">असना पटपर हबै जेखर लग उन ठोकड खाथै।” उन बचन हे बिस्वास नेहको करैका चाहथै, इहैनिता उन ठोकड खाय के गिर जथै, इहै उनखर नियम हबै<note caller="+" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="DAN 2:34-35">दानि 2:34-35</ref>; <ref loc="1CO 1:23">1 कुरि 1:23</ref>; <ref loc="ISA 8:14-15">यसा 8:14-15</ref></char></note>।<verse eid="1PE 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1PE 2:9"/>पय तुम अक्ठी चुने हर पुरखा अउ राज पदधारी याजकन के समाज अउ पवितर मनसे अउ भगवान के खास मनसे हबा, जेखर लग तुम ओखर महान कामन के घोसना कर सका, जउन तुमही अंधियार मसे निकार के अपन अथाह उजियार हे बोलाय लय हबै<note caller="+" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="EXO 19:5-6">निरगमन 19:5-6</ref>; <ref loc="DEU 7:6">बेवस्थाबिबरन 7:6</ref>; <ref loc="ISA 9:2">यसा 9:2</ref>; <ref loc="ISA 43:20-21">43:20-21</ref></char></note>। <verse eid="1PE 2:9"/><verse number="10" style="v" sid="1PE 2:10"/>पहिले तुम कुछु नेहको रहा, पय अब तो तुम भगवान कर मनसे हबा, पहिले तुम दया लग दुरिहां रहा, अब तुम ओखर दया के ओग हबा<note caller="+" style="x"><char style="xo" closed="false">2:10 </char><char style="xt" closed="false"><ref loc="HOS 1:10">होसे 1:10</ref>; <ref loc="HOS 2:23">2:23</ref></char></note>।<verse eid="1PE 2:10"/></para>
  <para style="s">मसीही कहामै बाले</para>
  <para style="p">
    <verse number="11" style="v" sid="1PE 2:11"/>हे प्रिजन भाइयो, मै तुम्हर लग बिनती करथो कि तुम अपन खुद के परदेसी अउ यातरी जानके उन दुनिया के लोभ लालच लग जउन आतमा के बिरोध लडथै<note caller="+" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="GAL 5:24">गलातियों 5:24</ref>; <ref loc="1PE 4:2">1 पतरस 4:2</ref></char></note>। <verse eid="1PE 2:11"/><verse number="12" style="v" sid="1PE 2:12"/>आने जात हे तुम्हर चाल चलन निक्खा होय, जेखर लग कि जेखर बारे हे उन तुमही अपराधी मेर जानके बदनाम करथै, तुम्हर निक्खा काम के देखके ऊ आगमन के रोज भगवान कर महिमा करही।<verse eid="1PE 2:12"/></para>
  <para style="s">भगवान कर हरवाह</para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 2:13"/>परभु के निता मनसेन के दवारा चुने हर, हर अक्ठी सासक के वस हे रहा, चाहे ऊ राजा होय सबले बडा साहब हबै। <verse eid="1PE 2:13"/><verse number="14" style="v" sid="1PE 2:14"/>चाहे ऊ राजपाल के होय, जउन कुकरमिन के सजा पय सुकरमिन के बडाई करै के निता राजा के दवारा चुने गय हबै। <verse eid="1PE 2:14"/><verse number="15" style="v" sid="1PE 2:15"/>भगवान चाहत हबै कि तुम अपन निक्खा काम करै के दवारा उन मूरखन के मुंह बंद करा, जउन बिनमतलब के बात करत रथै। <verse eid="1PE 2:15"/><verse number="16" style="v" sid="1PE 2:16"/>तुम आजाद मनसेन मेर बेउहार करा, पय आजादी के आड हे बुराई झइ करा, बकि भगवान के सेबकन मेर बेउहार करा। <verse eid="1PE 2:16"/><verse number="17" style="v" sid="1PE 2:17"/>सबझन भगवान लग डरा, भाई बेहन लग माया करा, भगवान हे बिस्वास रखा अउ राजा के इज्जत करा<note caller="+" style="x"><char style="xo" closed="false">2:17 </char><char style="xt" closed="false"><ref loc="PRO 24:21">नीति 24:21</ref>; <ref loc="ROM 12:10">रोमियो 12:10</ref></char></note>।<verse eid="1PE 2:17"/></para>
  <para style="s">मसीह हमर उदाहरन</para>
  <para style="p">
    <verse number="18" style="v" sid="1PE 2:18"/>हे हरवाह, उन पूरे आदर भक्ति हे अपन गुरुवन के वस हे रहा, निक्खा अउ सही हिरदय बाले गुरुवन के नेहको पय बेकार गुरुवन के इज्जत करा। <verse eid="1PE 2:18"/><verse number="19" style="v" sid="1PE 2:19"/>अगर कउ मनसे धीर लग दुख भोगथै अउ अन्याय सहथै, काखे ऊ समझथै कि भगवान इहै चाहथै, ता हइ बडाई के ओग हबै। <verse eid="1PE 2:19"/><verse number="20" style="v" sid="1PE 2:20"/>अगर तुम अपराध करके मार खाते हबा अउ धीर धरिहा, ता एहमा काहिन बडाई के बात हबै? पय अगर निक्खा काम करके दुख सहै के पडथै अउ तुम उके धीर धरथा, ता हइ भगवान के नजर हे निक्खा हबै। <verse eid="1PE 2:20"/><verse number="21" style="v" sid="1PE 2:21"/>इहैनिता तुमही बोलाय गय हबा, काखे मसीह तुम्हर निता दुख भोगिस अउ तुमही उदाहरन दइस, जेखर लग तुम ओखर बताय हर पद चिन्हा हे चला। <verse eid="1PE 2:21"/><verse number="22" style="v" sid="1PE 2:22"/>यीसु कउनो पाप नेहको करिस अउ न ओखर मुंह लग कउनो मेर गलत बात निकडिस<note caller="+" style="x"><char style="xo" closed="false">2:22 </char><char style="xt" closed="false"><ref loc="ISA 53:9">यसा 53:9</ref>; <ref loc="2CO 5:21">2 कुरि 5:21</ref></char></note>। <verse eid="1PE 2:22"/><verse number="23" style="v" sid="1PE 2:23"/>जब यीसु के गारी दइन, ता सुनके गारी नेहको दइस अउ जब ओही सताय गइस, ता ऊ धमकी नेहको दइस, पय खुद के भगवान कर हाथ हे सउपत दइस, जउन नियाइपन लग नियाव करथै<note caller="+" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="ISA 53:7">यसा 53:7</ref>; <ref loc="1PE 4:19">1 पतरस 4:19</ref></char></note>। <verse eid="1PE 2:23"/><verse number="24" style="v" sid="1PE 2:24"/>ऊ अपन देह हे हमर पापन के क्रूस हे लाद लइस, जेखर लग हम पाप के निता मर के नियाइपन के निता जिये लग जइ, तुम ओखरै मार खाय के दवारा तुम नांगा लग निक्खा होय हबा<note caller="+" style="x"><char style="xo" closed="false">2:24 </char><char style="xt" closed="false"><ref loc="ISA 53:4-5">यसा 53:4-5</ref>; <ref loc="GAL 3:13">गलातियों 3:13</ref></char></note>। <verse eid="1PE 2:24"/><verse number="25" style="v" sid="1PE 2:25"/>तुम गेडरन मेर भुलाय गय रहा, पय अब तुम अपन आतमा के मुखिया के लिघ्घो लउट आय हबा<note caller="+" style="x"><char style="xo" closed="false">2:25 </char><char style="xt" closed="false"><ref loc="ISA 53:6">यसा 53:6</ref>; <ref loc="EZK 34:5-6">यहेज 34:5-6</ref></char></note>।<verse eid="1PE 2:25"/></para>
  <chapter eid="1PE 2"/>
  <chapter number="3" style="c" sid="1PE 3"/>
  <para style="s">डउका अउ डउकी</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 3:1"/>हे डउकियो, तुमो अपन डउकन के कबजा हे रहा, अगर उन मसे कउ भगवान के बचन के पालन नेहको करत होंय ता तुम्हर पवितर आदरपून चाल चलन के देखके अपन-अपन डउकिन के बेउहार के दवारा बिस्वास हे सामिल करे जा सकथै, <verse eid="1PE 3:1"/><verse number="2" style="v" sid="1PE 3:2"/>तउभरमा तुम्हर डर सहित पवितर चाल चलन के देखके बेगैर बचन के अपन-अपन डउकी के चाल चलन के दवारा खिचर जाय। <verse eid="1PE 3:2"/><verse number="3" style="v" sid="1PE 3:3"/>तुम्हर ओढना पहिरावा दिखाउटी झइ होय, मतलब चूंदी गुथैका, अउ सोना के गहनगाठी, या सबैमेर के फरिया पहिनै के, <verse eid="1PE 3:3"/><verse number="4" style="v" sid="1PE 3:4"/>पय तुम्हर लुके हर अउ चोरिमा मनसे के बल नरम अउ मन के दीन हरमेसा के जीवन के सजावट लग होसियार रहा, काखे भगवान के नजर हे एखर कीमत बडका हबै। <verse eid="1PE 3:4"/><verse number="5" style="v" sid="1PE 3:5"/>पहिले के जमाना हे भगवान हे पूर आसा रखै बाले, अउ अपन-अपन डउकन के कबजा हे रहै बाले पवितर डउकियो इहैमेर खुद के संवारथै। <verse eid="1PE 3:5"/><verse number="6" style="v" sid="1PE 3:6"/>जसना सारा अब्राहम के आदेस मानत रहिस अउ ओही स्वामी कहिके गोहराउत रहिस। इहैमेर तुमो भलाई करिहा अउ कउनो मेर के सक लग नेहको घबरइहा, ता तुम ओखर टोरिया कहाइहा।<verse eid="1PE 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 3:7"/>तुमो, जउन डउका हबा, इहैमेर अपन-अपन डउकिन के संग इमानदारी लग रहा, काखे ऊ नर हबै कमजोर जानके ओखर इज्जत करा, हइ समझ के हम दउझन जीवन के बरदान के हकदार हबन, जेखर लग तुम्हर बिनती पराथना हे कउनो बाधा झइ पडै।<verse eid="1PE 3:7"/></para>
  <para style="s">भलाई करै के कारन सताव</para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 3:8"/>आखरी हे हइ तुम सब के सब अक्ठी मन अउ किरपालू अउ भाईचारा के मेर रखा, अपन हे माया रखा, करुनामय अउ नरम बना। <verse eid="1PE 3:8"/><verse number="9" style="v" sid="1PE 3:9"/>तुम बुराई के बदला बुराई झइ करा अउ न गारी के बदला गारी देया, पय एखर उलटा आसीस देया, काखे इहै करै के निता तुम बुलाय गय हबा, कि तुमही फिरी हे आसीस पाय सका। <verse eid="1PE 3:9"/><verse number="10" style="v" sid="1PE 3:10"/>काखे जउन जीवन लग माया करैका,</para>
  <para style="q1" vid="1PE 3:10">अउ अच्छी रोज देखै चाहथै,</para>
  <para style="q2" vid="1PE 3:10">“ऊ अपन जीभ के बुराई लग,</para>
  <para style="q2" vid="1PE 3:10">अउ अपन बिबडा के छल कपट,</para>
  <para style="q2" vid="1PE 3:10">के बात लग बचाय रखा।<verse eid="1PE 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="1PE 3:11"/>ऊ बुराई लग दुरिहां रहै अउ भलाई करी,</para>
  <para style="q2" vid="1PE 3:11">ऊ सान्ति के खोजै अउ ओखर निता परयास करा।<verse eid="1PE 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="1PE 3:12"/>काखे परभु के आंखी धरमी मनसे हे बने रथै,</para>
  <para style="q2" vid="1PE 3:12">ओखर कान उनखर पराथना सुनथै,</para>
  <para style="q2" vid="1PE 3:12">पय परभु बुराई करै बालेन लग दुरिहां रथै<note caller="+" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="PSA 34:15-16">भजन 34:15-16</ref>; <ref loc="JHN 9:31">यूहन्ना 9:31</ref>; <ref loc="PRO 15:29">नीति 15:29</ref></char></note>।”<verse eid="1PE 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 3:13"/>अगर तुम निक्खा करै हे लगे रइहा, तुम्हर हे बुराई करै बाले कोन हबै? <verse eid="1PE 3:13"/><verse number="14" style="v" sid="1PE 3:14"/>अगर तुमही नियाइपन के कारन दुख सहै का पडथै, ता तुम धन्य हबा, तुम उन मनसेन के धमकी लग न डेराय अउ न घबडाबा, <verse eid="1PE 3:14"/><verse number="15" style="v" sid="1PE 3:15"/>मसीह के परभु जानके अपन मन हे पवितर समझइहा। जउन कउ तुम्हर आसा के बारे हे कुछु पूछथै, ता उनही नमरता अउ डर के संग जबाब देय के निता हरमेसा तइयार रइहा, <verse eid="1PE 3:15"/><verse number="16" style="v" sid="1PE 3:16"/>अपन मन के सुध्द रखिहा, हइमेर जउन मनसे तुमही बदनाम करथै अउ तुम्हर निक्खा मसीही चाल चलन के बुराई करथै, उनही लज्जित होमैका पडही। <verse eid="1PE 3:16"/><verse number="17" style="v" sid="1PE 3:17"/>अगर भगवान के इहै इक्छा हबै, ता बुराई करै के कारन सजा भोगय लग निक्खा हबै कि भलाई करै के कारन दुख सहै के कहुं अच्छी हबै। <verse eid="1PE 3:17"/><verse number="18" style="v" sid="1PE 3:18"/>मसीहो अक्कै बेर पापिन के छमा के निता दुख भोगिस, धरमी मनसे पापिन के निता मर गइस, जेखर लग तुमही भगवान के लिघ्घो लइ जाय। ऊ देह के नजर लग तो मर गइस, पय आतमा के दवारा जिन्दा करे गय हबै। <verse eid="1PE 3:18"/><verse number="19" style="v" sid="1PE 3:19"/>ऊ आतमन हे जायके कैदिन आतमन के मुकति के परचार करे गइस। <verse eid="1PE 3:19"/><verse number="20" style="v" sid="1PE 3:20"/>उन ऊ जुग के आदेस नेहको मानै बाले आतमा रहिन, जब भगवान नूह के दिन हे जिहाज बनाउत के टेम धीर धरके ताकत रहिस, ऊ जिहाज हे केबल आठ झन पानी लग बचाय गइन। <verse eid="1PE 3:20"/><verse number="21" style="v" sid="1PE 3:21"/>हइ पानी के बतिस्मा के चीन्हा हबै, जउन अब तुम्हर मुकति करथै, बतिस्मा के मतलब देह के मइल धोमै के नेहको, बकि सुध्द हिरदय लग अपन के भगवान के परति सउपना हबै। हइ बतिस्मा यीसु मसीह के जिन्दा हुइ जाय के दवारा हमर मुकति करथै। <verse eid="1PE 3:21"/><verse number="22" style="v" sid="1PE 3:22"/>मसीह यीसु स्वरग हे जायके भगवान के दहिना पल्ला बइठ गइस अउ सगलू स्वरगदूत, साहबन अउ सक्ति के ओखर कबजा हे के दय हबै<note caller="+" style="x"><char style="xo" closed="false">3:22 </char><char style="xt" closed="false"><ref loc="EPH 1:20-21">इफिसियों 1:20-21</ref>; <ref loc="PSA 110:1">भजन 110:1</ref></char></note>।<verse eid="1PE 3:22"/></para>
  <chapter eid="1PE 3"/>
  <chapter number="4" style="c" sid="1PE 4"/>
  <para style="s">बदलाव जीवन</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 4:1"/>मसीह अपन देह हे दुख सहिस, तुमो खुद ओसनेन मन हे बनाय रखा, काखे जउन कउ देह हे दुख सहे हबै, ऊ पाप के छांड दय हबै, <verse eid="1PE 4:1"/><verse number="2" style="v" sid="1PE 4:2"/>इहैनिता अब ले तुम्हर बाकी देह जीवन मन के इक्छा के पूर करै के नेहको, पय भगवान के इक्छा के जसना अपन बाकी जीवन गुजारा। <verse eid="1PE 4:2"/><verse number="3" style="v" sid="1PE 4:3"/>तुम पहिले संसारिक मनसेन के जीवन मेर गलत काम, लफन्गा के बेकार लालच, दरुहाइ, नाटक बाले, अइसो अराम अउ मूरती पूजन हे जउन टेम गवाइन उहै बोहत हुइस। <verse eid="1PE 4:3"/><verse number="4" style="v" sid="1PE 4:4"/>अब जब तुम हइ बेकार कामन हे रहन सहन हे उनखर संग नेहको देथा, ता उन चकित होथै अउ उन तुम्हर बुराई करथै। <verse eid="1PE 4:4"/><verse number="5" style="v" sid="1PE 4:5"/>उनही जिन्दा अउ मरे हरन के नियाव करैबाले भगवान के अपन चाल चलन के लेखाजोखा देयका पडही<note caller="+" style="x"><char style="xo" closed="false">4:5 </char><char style="xt" closed="false"><ref loc="2TI 4:1">2 तीमु 4:1</ref></char></note>। <verse eid="1PE 4:5"/><verse number="6" style="v" sid="1PE 4:6"/>इहैनिता उन बिस्वासिन के जउन मर चुके हबै, संदेस के परचार सुनाय गय हबै कि देह हे मनसेन के मेर सजा होय रथै, तउभरमा आतमा हे उन भगवान के जसना जिन्दा रहै।<verse eid="1PE 4:6"/></para>
  <para style="s">भगवान कर निक्खा बरदान</para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 4:7"/>ऊ टेम निकट हबै जब सब कुछ बढाय जही, इहैनिता समझदार बना अउ धीर धरा, जेखर लग तुम पराथना बिनती के सका<note caller="+" style="x"><char style="xo" closed="false">4:7 </char><char style="xt" closed="false"><ref loc="JAS 5:8">याकूब 5:8</ref>; <ref loc="EPH 6:18">इफिसियों 6:18</ref></char></note>। <verse eid="1PE 4:7"/><verse number="8" style="v" sid="1PE 4:8"/>सबले बड्डे बात हइ हबै कि अक दूसर लग बोहत माया करा, काखे माया सबैमेर के पाप के मूंद देथै<note caller="+" style="x"><char style="xo" closed="false">4:8 </char><char style="xt" closed="false"><ref loc="PRO 10:12">नीति 10:12</ref></char></note>। <verse eid="1PE 4:8"/><verse number="9" style="v" sid="1PE 4:9"/>तुम बिना कुनमुनाय के अक दूसर के पोहनाई करा। <verse eid="1PE 4:9"/><verse number="10" style="v" sid="1PE 4:10"/>जेही जउन बरदान मिले हबै, ऊ भगवान के कइन मेर के अनुगरह किरपा के अच्छी भन्डारी के जसना अक दूसर के सेबा हे लगामै। <verse eid="1PE 4:10"/><verse number="11" style="v" sid="1PE 4:11"/>अगर कउ बचन देथै, उके सुरता रहै कि ऊ भगवान के बचन बोलथै, जउन धरमी सेबा करथै, ऊ जान ले कि भगवान उके बल देथै, हइ मेर सब बातन हे यीसु मसीह के दवारा भगवान के महिमा परगट हुइ जही। महिमा अउ सक्ति जुगजुग भगवान के हबै। ओसनेन होय।<verse eid="1PE 4:11"/></para>
  <para style="s">मसीह के दुख हे सहपारटी होबा</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 4:12"/>हे पिरिया भाई अउ बेहन तुम्हर परिक्छा आगी लग लय जही, तुम चकित झइ हुइ जइहा, जउन तुमही परखे के मकसद लग तुम्हर हे आही, माना कुछु अनोखी घटना घटत होय। <verse eid="1PE 4:12"/><verse number="13" style="v" sid="1PE 4:13"/>अगर तुम्हर हे अतियाचार करे जही, ता मसीह के दुख भोग के सहपारटी बन जाय के निता तुम मगन हुइ जइहा, जउन रोज मसीह के महिमा परगट होही, तुम बोहत मगन हुइ जइहा। <verse eid="1PE 4:13"/><verse number="14" style="v" sid="1PE 4:14"/>अगर मसीह के नाम के कारन तुम्हर बेज्जती करे जही, ता अपन के धन्य समझिहा, काखे हइ एखर परमाड हबै कि भगवान के महिमामय आतमा तुम्हर हे छाय रथै<note caller="+" style="x"><char style="xo" closed="false">4:14 </char><char style="xt" closed="false"><ref loc="MAT 5:11-12">मत्ती 5:11-12</ref></char></note>। <verse eid="1PE 4:14"/><verse number="15" style="v" sid="1PE 4:15"/>सचेत रइहा कि हत्या, चोरी या गलत काम होय या पराय के कामन हे हाथ डारै के कारन तुम मसे कउ मनसे दुख झइ भोगा। <verse eid="1PE 4:15"/><verse number="16" style="v" sid="1PE 4:16"/>अगर कउ मसीह होमै के कारन दुख भोगथै, ऊ उके लाज के बात झइ समझै, पय ई बात हे भगवान के महिमा करै।<verse eid="1PE 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1PE 4:17"/>काखे नियाव के टेम सुरू हुइ गय हबै अउ हइ खुद भगवान के मानै बालेन लग सुरू होही, अउ अगर हइ सबले पहिले हमर लग सुरू होथै, ता उनखर आखरी का होही, जउन भगवान के संदेस हे बिस्वास नेहको करथै<note caller="+" style="x"><char style="xo" closed="false">4:17 </char><char style="xt" closed="false"><ref loc="HEB 12:24-25">इब्रानिन 12:24-25</ref>; <ref loc="JER 25:29">इरमि 25:29</ref>; <ref loc="EZK 9:6">यहेज 9:6</ref></char></note>? <verse eid="1PE 4:17"/><verse number="18" style="v" sid="1PE 4:18"/>अगर धरमी मनसे के दिग्गत लग मुकति मिलथै,</para>
  <para style="q1" vid="1PE 4:18">ता महिमा नेहको करै बाले,</para>
  <para style="q2" vid="1PE 4:18">अउ पापिन के काहिन हाल होही<note caller="+" style="x"><char style="xo" closed="false">4:18 </char><char style="xt" closed="false"><ref loc="PRO 11:31">नीति 11:31</ref></char></note>?<verse eid="1PE 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1PE 4:19"/>इहैनिता जउन भगवान के इक्छा के जसना दुख भोगथै, उन भलाई करत रहै, अउ बिस्वासओग बनामै बाले भगवान के अपन आतमा सउप देया, अउ निक्खा काम करत रहा।<verse eid="1PE 4:19"/></para>
  <chapter eid="1PE 4"/>
  <chapter number="5" style="c" sid="1PE 5"/>
  <para style="s">भगवान कर सेबक</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 5:1"/>तुम हे जउन सियान हबै, उनखर लग मोर अक्ठी बिनती हबै, महुं सियान हबो, मसीह के दुख भोग के गवाह अउ भभिस्य हे परगट होमै बाले महिमा हे सहभागी हबो। <verse eid="1PE 5:1"/><verse number="2" style="v" sid="1PE 5:2"/>तुमही भगवान के जउन झुन्ड सउपे गय हबै, ओखर बरेदी बना, भगवान के इक्छा के जसना उनखर देखरेख करा दबाव हे नेहको, पय अपन इक्छा के जसना, पइसा के लालच के निता नेहको पय सुध्द सेबा भाव लग, <verse eid="1PE 5:2"/><verse number="3" style="v" sid="1PE 5:3"/>अपन सउपे हर मनसेन हे हक झइ जताबा, पय झुन्ड के निता इमानदार बन के सेबा करा। <verse eid="1PE 5:3"/><verse number="4" style="v" sid="1PE 5:4"/>जउन टेम परधान बरेदी परगट होही, ता तुम कबहुं नेहको बुझाय बाले महिमा के मुकुट पइहा।<verse eid="1PE 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1PE 5:5"/>अउ तुम, जबान टोरवा सियानन के कबजा हे रहा, तुम सब नम्र हुइ के अक दूसर के सेबा के निता कनिहा कस के तइयार रइहा, काखे भगवान घमन्डिन के बिरोध करथै, पय ऊ दीनहीन मनसेन हे दया करथै। <verse eid="1PE 5:5"/><verse number="6" style="v" sid="1PE 5:6"/>तुम भगवान के बलवान हाथ के तरी नरम बने रइहा, जेखर लग ऊ तुमही सही टेम हे बढाही। <verse eid="1PE 5:6"/><verse number="7" style="v" sid="1PE 5:7"/>तुम अपन सगलू चिन्ता ओखर उप्पर छांड देया काखे ओही तुम्हर चिन्ता हबै।<verse eid="1PE 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 5:8"/>तुम धीर धरे रइहा, अउ जगत रइहा काखे तुम्हर बिरोधी परेत गरजय बाले बघवा के जसना हबै हइ खोज हे बागत रथै कि करही चीर खाव। <verse eid="1PE 5:8"/><verse number="9" style="v" sid="1PE 5:9"/>तुम बिस्वास हे मजबूत हुइके ओखर सामना करिहा, तुम जानत हबा कि दुनिया भर हे तुम्हर भाई-बेहन हइ मेर के दुख भोगत हबै। <verse eid="1PE 5:9"/><verse number="10" style="v" sid="1PE 5:10"/>भगवान जउन सगलू अनुगरह किरपा के दाता हबै, तुमही यीसु मसीह हे अपन सबरोज के महिमा के निता बोलाय हबै, ऊ तुम्हर चुटु देर तक दुख उठामै के बाद, तुमही फेरै सिध्द करही, बलवान अउ मजबूत बनाही। <verse eid="1PE 5:10"/><verse number="11" style="v" sid="1PE 5:11"/>ओखर सक्ति जुगजुग बने रहे। ओसनेन होय।<verse eid="1PE 5:11"/></para>
  <para style="s">आखरी सोगत</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 5:12"/>मै तुमही हइ चिट्ठी सिलवानुस लग लिखवाय हबो, जेही मै अपन बिस्वासी भाई मानथो मै तुमही समझाथो अउ बिस्वास देवाथो कि एहमा जउन कुछ लिखवरे हबै, ऊ भगवान के निक्खा अनुगरह किरपा हबै, ऊ किरपा हे मजबूत बने रइहा।<verse eid="1PE 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 5:13"/>हइ बेबीलोन सहर के मंडली के सदस्य, जउन तुम्हर मेर भगवान के चुने हर मनसे हबै, अउ मोर टोरवा मरकुस तुमही नमस्ते कथै। <verse eid="1PE 5:13"/><verse number="14" style="v" sid="1PE 5:14"/>माया के चुम्मा लग अक दूसर के नमस्ते करा।</para>
  <para style="p" vid="1PE 5:14">तुम सगलू के, जउन मसीह हे हबै, सान्ति मिलत रहै।<verse eid="1PE 5:14"/></para>
  <chapter eid="1PE 5"/>
</usx>
