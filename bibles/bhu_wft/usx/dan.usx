<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="DAN" style="id">- Bhumiya Test Project</book>
  <para style="h">दानि</para>
  <para style="toc3">दानि</para>
  <para style="toc2">दानि</para>
  <para style="toc1">दानिय्येल</para>
  <para style="mt2">दानिय्येल के व्दारा लिखा गया यीशु का सुसमाचार</para>
  <para style="mt1">दानिय्येल कर दवारा लिखे गइस यीसु कर संदेस</para>
  <para style="imt">परचा</para>
  <para style="ip">दानिय्येल कर किताब बेबीलोन हे इस्राएलियन कर बन्दी कर टेम आगू कर बात गुठेमै बाले, दानिय्येल कर जीवन अउ आगू कर संदेस दरसन लग सबंध हबै। हइ दानिय्येल अउ ओखर दोसन कर इमानदारी कर संग-संग देस अउ दुनिया लग सबंध आगू कर बात कर बारे हे गुठेथै। किताब 605 लग लगभग 535 ईसा पूरब तक कर टेम के सामिल करथै, जछो दानिय्येल बेबीलोन के चारठे अलगे-अलगे राजन कर सासनकाल कर दउरान सेबा करे रथै। रीतिरिबाज नजर हइ हबै कि दानिय्येल खुद हइ टेम कर दउरान बेबीलोन हे किताब लिखे रथै, पय कइनझन आधुनिक ग्यानिन कर दाबा हबै, कि इके बाद हे दूसर सताब्दी ईसा पूरब कर दउरान, इजराइल हे लिखे गय रथै। आने मनसेन कर मानथै कि किताब कर कुछ हिस्सा अलगे-अलगे टेम हे लिखे गय रथै। दानिय्येल कर किताब गुलामी हे रहै बाले इस्राएलियन कर संग-संग कठिन टेम आमै हे आमै बाले पीढिन के आसा देय कर निता लिखे गय रथै।</para>
  <para style="ip">दानिय्येल कर जीवन के घटना अउ आमै बाले टेम लग सबंध आगू कर बात गुठेमै हइ दुनो के माध्यम लग, भगवान राजन अउ देसन हे अपन सक्ति देखाथै। बाइबल कर संदरभ हे, हइ नबा नियम हे भगवान कर राज के समझै हे मदद करथै। <char style="xt"><ref loc="DAN 7:13-14">दानि 7:13-14</ref></char> हे मसीहा कर आगू कर बात करे गय हबै। आखरी टेम कर बारे हे दानिय्येल कर दरसन कर उल्लेख यीसु करे हबै मत्ती 24:15, मरकुस 13:14 अउ हइ यूहन्ना कर लुके हर बात के परकासन लग सबंध हबै। दानिय्येल इरमियाह कर आगू कर बात गुठेमै के बिचार करथै। दानिय्येल 9:1-3।</para>
  <para style="iot">रूपरेखा</para>
  <para style="io1">1. हे नबूकदनेस्सर कर सासनकाल के दउरान बेबीलोन हे दानिय्येल अउ ओखर दोसन के बारे हे गुठे गय हबै। <char style="ior"><ref loc="DAN 1-4">1—4</ref> </char></para>
  <para style="io1">2. हे राजा बेलसस्सर के दरसन कर दानिय्येल के बिस्तार के बारे हे गुठे गय हबै। अध्याय <char style="ior"><ref loc="DAN 5">5</ref> </char></para>
  <para style="io1">3. हे राजा दारा के सासनकाल के दउरान बघवा कर खोदरा हे दानिय्येल कर बारे हे गुठे गय हबै। अध्याय <char style="ior"><ref loc="DAN 6">6</ref> </char></para>
  <para style="io1">4. हे भभिस्य कर घटनन कर बारे हे दानिय्येल कर भगवान कर पल्ला लग लुके हर बात के परकासन सामिल हबै। <char style="ior"><ref loc="DAN 7-12">7—12</ref></char> क. हे दानिय्येल भभिस्य कर बारे हे दुइठे दरसन अउ उनखर बिस्तार गुठेथै। <char style="ior"><ref loc="DAN 7-8">7—8</ref> </char>ख. हे दानिय्येल अपन मनसेन कर निता बिनती करथै, अउ स्वरगदूत जिब्राएल दवारा जबाब दय जथै। अध्याय <char style="ior"><ref loc="DAN 9">9</ref> </char> ग. हे जिब्राएल भभिस्य कर घटनन कर उजागर करथै, जेहमा आखरी टेम सामिल हबै। <char style="ior"><ref loc="DAN 10-12">10—12</ref> </char></para>
  <chapter number="1" style="c" sid="DAN 1" />
  <para style="s">दानिय्येल अउ ओखर संगी कर किस्सा</para>
  <para style="r">(<ref loc="DAN 1:1-6">दानि 1:1-6</ref>; <ref loc="DAN 6:28">6:28</ref>)</para>
  <para style="s">चारठे सग्यान नबूकदनेस्सर राजा कर आगू</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 1:1" />यहूदिया कर राजा यहोयाकीम के सासन के तीसर साल हे, बेबीलोन के राजा नबूकदनेस्सर आयके यरुसलेम के घेर लेथै।<note caller="+" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="2KI 24:10-16">2 राजा 24:10-16</ref>; <ref loc="2CH 36:10">2 इति 36:10</ref></char></note> <verse eid="DAN 1:1" /><verse number="2" style="v" sid="DAN 1:2" />तब भगवान यहूदा के राजा यहोयाकीम के भगवान के भवन कइन भडवन सहित ओखर हाथ हे कर दइस, अउ उके उन भडवन के सिनार देस हे अपन देउता के मंदिर हे लइ जायके, अपन देउता के भंडार हे धर दइस।<verse eid="DAN 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="DAN 1:3" />तब राजा अपन खास अधिकारी असपनज के आदेस देथै, कि इस्राएली राज कुल मसे अउ सम्मानित परवार मसे बन्दी करे गय सग्यान डउकन के चुन के लइ आबा।<note caller="+" style="x"><char style="xo" closed="false">1:3 </char><char style="xt" closed="false"><ref loc="2KI 20:17">2 राजा 20:17</ref></char></note> <verse eid="DAN 1:3" /><verse number="4" style="v" sid="DAN 1:4" />ऊ सुन्दर होय के चाही, दिमाक हे होसियार होय के चाही, निक्खा पढे लिखे होय के चाही, अउ हरबी सीखै बाले होय के चाही, अउ देह लग हट्टा-कट्टा होय के चाही, ताकि ऊ राजा कर दरबार हे सेबा करै के ओग होय, कसदी उनही बेबीलोन कर बोली अउ पवितर किताब कर ग्यान दे। <verse eid="DAN 1:4" /><verse number="5" style="v" sid="DAN 1:5" />राजकीय खाना पीना अंगूर कर रस हर रोज दय जाय, हइ मेर तीन साल तक उनके सिखाउत रथै, तब ओखर बाद उनके राजा कर आगू हाजिर करे जाय। <verse eid="DAN 1:5" /><verse number="6" style="v" sid="DAN 1:6" />जउन चुने गय रथै, उन मसे कुछ यहूदा कर बिरादरी कर रथै, दानिय्येल, हनन्याह, मीसाएल, अउ अजरयाह नाम के रथै। <verse eid="DAN 1:6" /><verse number="7" style="v" sid="DAN 1:7" />खास अधिकारी असपनज उनखर दूसर नाम धरथै, दानिय्येल कर नाम बेलतसस्सर, हनन्याह कर सदरक, मीसाएल कर मेसक अउ अजरयाह कर नाम अबेदनगो रखथै।<verse eid="DAN 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 1:8" />पय दानिय्येल अपन मन हे ठान लइस कि ऊ राजा के खाना खायके अउ ओखर अंगूर कर रस पीय के अपवितर झइ हो, इहैनिता ऊ खास अधिकारी लग बिनती करिस अपवितर झइ होय के पडै। <verse eid="DAN 1:8" /><verse number="9" style="v" sid="DAN 1:9" />भगवान खास अधिकारी कर हिरदय हे दानिय्येल के परति किरपा अउ दया भर दइस।<note caller="+" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="GEN 39:21">उत्पति 39:21</ref></char></note> <verse eid="DAN 1:9" /><verse number="10" style="v" sid="DAN 1:10" />खास अधिकारी दानिय्येल लग कथै, “मै अपन मालिक राजा लग डरथो, काखे तुम्हर खाय-पीय के उहै ठहराय हबै, कहुं असना झइ होय कि ऊ तोर मुंह तोर संग के जबान लग उतरे हुइस अउ निरास देखै अउ तुम मोर मूंड राजा के जसना संकट हे डारै।”<verse eid="DAN 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 1:11" />तब दानिय्येल ऊ चउकीदार लग, जेही खास अधिकारी दानिय्येल, हनन्याह, मीसाएल, अउ अजरयाह कर उप्पर देखरेख करै के निता ठहराय रथै, ओखर लग कथै। <verse eid="DAN 1:11" /><verse number="12" style="v" sid="DAN 1:12" />“मै तोर लग बिनती करथों, कि अपन हरवाहन के दस रोज तक जांच, हमर खाय के निता सब्जी भाजी अउ पीय के निता पानी दय जाय। <verse eid="DAN 1:12" /><verse number="13" style="v" sid="DAN 1:13" />फेर दस रोज कर बाद हमर मुंह के अउ जउन जबान राजा कर खाना खात हबै, उनखर मुंह के देखथै अउ जसना तोके देख पडथै ओखरै मेर अपन हरवाहन लग बेउहार कर।”<verse eid="DAN 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="DAN 1:14" />उनखर हइ बिनती ऊ मान लइस, अउ दस रोज तक उनही जांचत परखत रथै। <verse eid="DAN 1:14" /><verse number="15" style="v" sid="DAN 1:15" />दस रोज के बाद ऊ उन सग्गियान लग जादा निक्खा अउ हट्टा-कट्टा दिखाई दइन, जउन राजकीय खाना खथै। <verse eid="DAN 1:15" /><verse number="16" style="v" sid="DAN 1:16" />तब ऊ मुखिया उनखर भोजन अउ उनखर पीय के निता ठहराय हुइस अंगूर कर रस दुनो छंडाय के, उनखर सब्जी भाजी दय लगिस।<verse eid="DAN 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 1:17" />भगवान उन चारों सग्यान टोरवन के सगलू किताबन अउ सब मेर के ग्यान हे दिमाक हे अउ चतुराई दइस, अउ दानिय्येल सब मेर के दरसन अउ सपना के मतलब के ग्यानी हुइ गइस।<verse eid="DAN 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 1:18" />तब तीन साल के गुजरै के बाद जउन नबूकदनेस्सर राजा सग्यानन लग मिलै के निता आदेस दइ के ठहराय रथै, ओतकै साल गुजरै के बाद खास अधिकारी सग्यानन के राजा कर आगू ठाड करिस। <verse eid="DAN 1:18" /><verse number="19" style="v" sid="DAN 1:19" />राजा कर सेबा कर निता राजदरबार कर निता चुने गइन, दानिय्येल, हनन्याह, मीसाएल, अउ अजरयाह, के बरोबर कउनो नेहको ठहरिन, इहैनिता ऊ राजा के आगू हाजिर रहै लगिन। <verse eid="DAN 1:19" /><verse number="20" style="v" sid="DAN 1:20" />दिमाक अउ समझ के बारे हे राजा उनखर लग जेतका सबाल करिस, ऊ राजा के सगलू राज के सब जोतसी, अउ तांतरिक लग दस गुना निपुन पाय गइन। <verse eid="DAN 1:20" /><verse number="21" style="v" sid="DAN 1:21" />दानिय्येल साही दरबार हे तब तक रहिस, जब तक फारस कर राजा कुस्रू बेबीलोनियन लग जीत हासिल नेहको कर लइस।<verse eid="DAN 1:21" /></para>
  <chapter eid="DAN 1" />
  <chapter number="2" style="c" sid="DAN 2" />
  <para style="s">नबूकदनेस्सर कर सपना</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 2:1" />राजा नबूकदनेस्सर के राज के दूसर साल के बीच अक्ठी सपना देखथै, जेखर लग ओखर मन बैजुंग हुइ गइस, अउ उके नीद नेहको आइस। <verse eid="DAN 2:1" /><verse number="2" style="v" sid="DAN 2:2" />तब राजा आदेस देथै, कि जोतसी, गुनिया, टोनहा, अउ जादू देखामै बालेन के बुलाय जाय, ताकि उन राजा के सपना के मतलब गुठेमै, इहैनिता उन आइन अउ राजा कर आगू ठाढ हुइ गइन। <verse eid="DAN 2:2" /><verse number="3" style="v" sid="DAN 2:3" />तब राजा उन मनसेन लग कथै, “मै अक्ठी सपना देखे हव, जेखर लग मै बैजुंग हव, मै हइ जानै चाहथो कि ऊ सपना कर मतलब काहिन होही?”<verse eid="DAN 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 2:4" />ई बात हे कसदियन राजा के जबाब देत कथै, ऊ अरामी<note caller="+" style="f"><char style="fr" closed="false">2:4 </char><char style="ft" closed="false">इहां लग 7 पाठ के अखरी तक परयोग करे गय भासा इब्रानी न हुइके अरामी भासा हबै। 7 पाठ तक के अरामी भासा हबै।</char></note> भासा हे बोलथै, “हे राजा तै हरमेसा जिन्दा रह। हम तोर हरवाह हवन, तै अपन सपना गुठे, फेर हम तोके ओखर मतलब गुठेब।” <verse eid="DAN 2:4" /><verse number="5" style="v" sid="DAN 2:5" />राजा कसदी पंडित के जबाब देथै, मोर बचन मजबूत हबै, अगर तै मोर सपना अउ ओखर मतलब मोके नेहको गुठेबे, ता तुम सही जाना कि तुम्हर सरीर के कुरी-कुरी कर दय जही, अउ तुम्हर घर गिराय दय जही। <verse eid="DAN 2:5" /><verse number="6" style="v" sid="DAN 2:6" />अगर तुम मतलब सहित मोर सपना के गुठे दइहा, ता मै तुमके इनाम देहुं, अउ तुम्हर बडा इज्जत करिहों, अब मोके मोर सपना अउ ओखर मतलब गुठेवा।<verse eid="DAN 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 2:7" />उन राजा लग दूसर बेर पूछथै, “हे राजा, अपन हरवाहन के अपन सपना के गुठे अउ हम ओखर मतलब समझाय दइबे।”<verse eid="DAN 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 2:8" />राजा जबाब देथै, “मै निस्चय जानथों, तुम अउ जादा टेम ले चाहथा, तुम जानथा कि मै जउन कहे हव, मोर हइ बचन मजबूत हबै। <verse eid="DAN 2:8" /><verse number="9" style="v" sid="DAN 2:9" />तुम हइ जानथा कि अगर मोर सपना के बारे हे नेहको गुठे पइहा ता तुमके सजा दय जही, इहैनिता तुम सब अकमन हुइके मोर लग बात बनाथा, तुम अउ जादा टेम ले चाहथा, तुमके हइ आसा हबै कि मै जउन कुछु करै चाहथो उके तुम्हर बात हे आयके बिसर जांव, अच्छा, अब तुम मोर सपना गुठेवा, अगर तुम मोर सपना बताय पइहा तबय मै हइ जान पइहों कि सहीमा ऊ सपना के मतलब काहिन हबै, हइ तुम मोके गुठे पइहा।”<verse eid="DAN 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="DAN 2:10" />उन राजा के जबाब देथै, हे राजा दुनिया हे असना मनसे नेहको हबै जउन तोर बात के पूरा कर सकै, कउनो बडा अउ सक्तिसाली राजा जोतिस, टोनहा, अउ कसदी पंडित लग कबहुन असना बात नेहको पूछे हबै। <verse eid="DAN 2:10" /><verse number="11" style="v" sid="DAN 2:11" />जउन बात राजा हमर लग पूछथै, ऊ कठिन हबै, अउ केबल देउता राजा के सपना के बारे हे गुठे सकथै, पय देउता तो मनसे के बीच नेहको रथै।<verse eid="DAN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="DAN 2:12" />हइ बात हे राजा गुस्सा हुइ के बेबीलोन के सगलू पंडितन के मरवा डारै के आदेस दइ देथै। <verse eid="DAN 2:12" /><verse number="13" style="v" sid="DAN 2:13" />जब हइ आदेस निकडिस, अउ पंडित मनसे के हतिया होय बाले रथै, अउ मनसे दानिय्येल अउ ओखर साथिन के खोजत रहै कि उनखरो हतिया करे जाय।<verse eid="DAN 2:13" /></para>
  <para style="s">भगवान दवारा दानिय्येल हे सपना कर मतलब परगट करैके</para>
  <para style="p">
    <verse number="14" style="v" sid="DAN 2:14" />तब दानिय्येल राजा के रक्छा करै बाले के सेना नायक अर्योक लग सोंच बिचार करके हुसियारी लग बात करिस, अर्योक बेबीलोन देस के सगलू दरबारी दिमाक बाले के मारै के निता निकडे रथै। <verse eid="DAN 2:14" /><verse number="15" style="v" sid="DAN 2:15" />दानिय्येल सेना नायक अर्योक लग पूछिस, राजा एतका कठोर सजा देय के आदेस काखे दय हबै? एखर बाद अर्योक राजा के सगलू किस्सा गुठेथै, दानिय्येल उके समझ गइस।<verse eid="DAN 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="DAN 2:16" />दानिय्येल जब हइ किस्सा सुन लेथै, ता ऊ राजा नबूकदनेस्सर के लिघ्घो गइस, दानिय्येल राजा लग बिनती करथै, कि उके चुटु टेम अउ दे, ओखर बाद ऊ राजा के सपना के मतलब गुठे देही। <verse eid="DAN 2:16" /><verse number="17" style="v" sid="DAN 2:17" />एखर बाद दानिय्येल अपन घर छो कढ जथै, ऊ अपन साथी हनन्याह, मीसाएल, अउ अजरयाह के ऊ सगलू बात गुठेथै। <verse eid="DAN 2:17" /><verse number="18" style="v" sid="DAN 2:18" />दानिय्येल अपन साथिन लग स्वरग कर भगवान लग बिनती करै के कथै, दानिय्येल साथिन लग कथै, कि ऊ भगवान लग बिनती करा कि ऊ उनखर उप्पर दया करै, अउ सपना के मतलब समझै हे उनखर मदत करै, जेखर लग बेबीलोन के सगलू दिमाक बाले के संग दानिय्येल अउ ओखर साथिन के मउत के घाट झइ उतारै जाय। <verse eid="DAN 2:18" /><verse number="19" style="v" sid="DAN 2:19" />रात के टेम भगवान अक्ठी दरसन हे दानिय्येल के ऊ भेद के समझाय देथै, ई बात हे स्वरग कर भगवान के धन्यबाद दइस।<verse eid="DAN 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="DAN 2:20" />दानिय्येल कथै, “भगवान के नाम के हरमेसा बडाई करा,</para>
  <para style="q2" vid="DAN 2:20">ग्यान अउ बल ओखरै हबै।<verse eid="DAN 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="DAN 2:21" />उहै टेम के बदलथै उहै साल के रितु के बदलथै,</para>
  <para style="q2" vid="DAN 2:21">उहै राजन के बदलथै, उहै राजा के सक्ति देथै अउ उहै छांडय लेथै,</para>
  <para style="q2" vid="DAN 2:21">उहै ग्यान देथै अउ मनसे के ग्यानमान बनाय देथै, उहै मनसेन के ग्यान देथै अउ मनसे ग्यानी बन जथै।<verse eid="DAN 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="DAN 2:22" />भगवान लुके हर भेदन के परगट करथै,</para>
  <para style="q2" vid="DAN 2:22">ऊ अंधियार हे लुके भेद के जानथै,</para>
  <para style="q2" vid="DAN 2:22">ओखर संग उजियार हरमेसा बने रथै।<verse eid="DAN 2:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="DAN 2:23" />हे मोर पुरखन के भगवान मै तोके धन्यबाद देथों,</para>
  <para style="q1" vid="DAN 2:23">अउ तोर बडाई करथों, काखे तै मोके ग्यान अउ सक्ति दय हबस,</para>
  <para style="q2" vid="DAN 2:23">जउन बात हम पूंछे रथन, उनखर बारे हे तै हमके गुठे हबस,</para>
  <para style="q2" vid="DAN 2:23">तै हमके राजा के सपना के बारे हे गुठे हबस।”<verse eid="DAN 2:23" /></para>
  <para style="s">दानिय्येल सपना के मतलब गुठेथै</para>
  <para style="p">
    <verse number="24" style="v" sid="DAN 2:24" />एखर बाद दानिय्येल अर्योक के लिघ्घो गइस, राजा नबूकदनेस्सर अर्योक के बेबीलोन के हुसियार डउकन के मारै के निता चुनथै, दानिय्येल अर्योक लग कथै, बेबीलोन के हुसियार डउकन के झइ मारा, मोके राजा के लिघ्घो लइ चला, मै उके ओखर सपना के मतलब गुठेहुं।<verse eid="DAN 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 2:25" />इहैनिता अर्योक दानिय्येल हरबी राजा के लिघ्घो लइ गइस, अर्योक राजा लग कथै, यहूदा परदेस कर मनसे गुलाम मसे मै अक्ठी असना डउका खोज लय हव, जउन राजा के सपना के मतलब गुठे सकथै।<verse eid="DAN 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="DAN 2:26" />राजा दानिय्येल लग जेखर नाम बेलतसस्सर रथै, ओखर लग कथै, “का तै मोर सपना मतलब के बारे हे गुठे सकथस?”<verse eid="DAN 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="DAN 2:27" />दानिय्येल जबाब देथै, “हे राजा नबूकदनेस्सर, तै जउन लुके हर बात के बारे हे पूंछथस, ऊ बात तोके न कउनो पंडित, न कउनो टोनहा अउ न कउनो कसदी पंडित गुठे सकथै।” <verse eid="DAN 2:27" /><verse number="28" style="v" sid="DAN 2:28" />पय स्वरग हे अक्ठी भगवान असना हबै, जउन भेद भरी बात के भेद गुठेथै, भगवान राजा नबूकदनेस्सर के आगू काहिन होय बाले हबै, हइ दरसन के निता सपना दय हबै, अपन डसना हे सोउत टेम तै सपना हे जउन बात देखे रथस ऊ ई हबै,<verse eid="DAN 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="DAN 2:29" />हे राजा, जब तै सोउत रहस, तब तोर मन हे हइ बिचार आइस, कि भभिस्य हे काहिन होही? तब सगलू भेद लग परदा हटाय बाले भगवान भभिस्य हे घटै बाले बातन के दरसन तोके देखाय हबै। <verse eid="DAN 2:29" /><verse number="30" style="v" sid="DAN 2:30" />भगवान ऊ भेद मोके गुठे दय हबै, असना इहैनिता नेहको हुइस कि मोर लिघ्घो दूसर मनसेन लग बोहत दिमाक हबै, बलुक मोके भगवान हइ भेद के इहैनिता गुठे हबै, कि राजा के ओखर सपना के मतलब पता चल जाय, अउ हइमेर हे राजा तुम्हर मन हे जउन बात आथै, उके तै समझ सकस।<verse eid="DAN 2:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="DAN 2:31" />हे राजा सपना हे तै अपन आगू ठाड अपन बडा मूरती के देखे हबस, ऊ मूरती बोहत बडा हबै, ऊ चमकदार रथै, अउ बोहत परभावसाली रथै, ऊ असना रथै जेही देखके, देखैबाले के आंखी फटे के फटे रही जाय। <verse eid="DAN 2:31" /><verse number="32" style="v" sid="DAN 2:32" />हइ मूरती के मूंड सुध्द सोना के बने रथै, ओखर छाती अउ बांह चांदी के बने रथै, ओखर लादा अउ जांघ पीतर के बने रथै। <verse eid="DAN 2:32" /><verse number="33" style="v" sid="DAN 2:33" />ओखर टेंघडा लोहा के, अउ गोड के कुछ हिस्सा लोहा अउ कुछ माटी कर बने रथै। <verse eid="DAN 2:33" /><verse number="34" style="v" sid="DAN 2:34" />फेर देखत, देखत, तै काहिन देखे कि अक्ठी पथरा बिगर कउनो छिये, अपनै आप उखडके ऊ मूरती के गोड हे लगके जउन लोहा अउ माटी कर रथै, उनके चूर-चूर कर डारिस। <verse eid="DAN 2:34" /><verse number="35" style="v" sid="DAN 2:35" />तब लोहा, माटी, पीतर, चांदी अउ सोना सगलू चूर-चूर खन्डा हुइ गइस अउ धूपकाल हे खनिहाड के भूसा के जसना हुइ गइस, हवा उनके असना उडाय लइ गइस, कि उनखर कउनो नान खन्डा नेहको बचिस, पय जउन पथरा मूरती के ठोकर मारथै, ऊ पथरा अक-अक्ठी करके बोहत बडा डोंगर बन गइस अउ सगलू भुंइ हे बगर गइस। <verse eid="DAN 2:35" /><verse number="36" style="v" sid="DAN 2:36" />राजा कर सपना इहै हबै, अब हम राजा के एखर मतलब गुठेहुं। <verse eid="DAN 2:36" /><verse number="37" style="v" sid="DAN 2:37" />हे राजन कर राजा तोके स्वरग कर भगवान तोके राज, बल, सक्ति, अउ महिमा दय हबै। <verse eid="DAN 2:37" /><verse number="38" style="v" sid="DAN 2:38" />भगवान तोर हाथ हे भुंइ के सगलू मनसे, पतेरा के जीवजन्तु अउ बादर के चिरइया सउपे हबै, राजा भगवान तोके इनखर हे सासन करै के बल दय हबै, तहिन मूरती कर सोना के मूंड हबस। <verse eid="DAN 2:38" /><verse number="39" style="v" sid="DAN 2:39" />तोर बाद अक्ठी राज अउ उदय होही जउन तोर लग नान होही, फेर अक्ठी अउ तीसर पीतर के जसना राज होही जेहमा सगलू दुनिया आमाय जइ। <verse eid="DAN 2:39" /><verse number="40" style="v" sid="DAN 2:40" />एखर बाद फेर अक्ठी चउथा राज आही, ऊ राज लोहा के जसना मजबूत होही, जसना लोहा सगलू चीजन के खन्डा-खन्डा अउ चूर-चूर कर देही। <verse eid="DAN 2:40" /><verse number="41" style="v" sid="DAN 2:41" />राजा जसना कि तै मूरती के गोड अउ अंगठिन के देखे हबस, कि उन कुछ कुम्हरा के माटी के अउ कुछ लोहा के बने हर रथै, उहै मेर हइ चउथा राज अलग-अलग बटरे हर होही, जसना कि तै लोहा के माटी के संग मिलेहर देखे, ओसनेन ओहमा लोहा के जसना मजबूत होही। <verse eid="DAN 2:41" /><verse number="42" style="v" sid="DAN 2:42" />जउन मेर गोड के अंगठी कुछ लोहा के अउ कुछ माटी के रथै, ओसनेन ऊ राज कुछ मजबूत अउ कुछ कमजोर होही। <verse eid="DAN 2:42" /><verse number="43" style="v" sid="DAN 2:43" />जसना कि तै जउन लोहा के कुम्हरा के माटी के संग लोहा मिलेहर देखे, एखर मतलब हइ हबै, कि ऊ राज के मनसे एक दूसर मनसे लग मिल जुलके रइहिन, पय जसना लोहा माटी के संग मेल नेहको खाथै, ओसनेन उनो एक नेहको बने रइहिन। <verse eid="DAN 2:43" /><verse number="44" style="v" sid="DAN 2:44" />उन राजा के दिन हे स्वरग कर भगवान, एक असना राज उदय करी, जउन सबरोज तक नेहको टूटही, अउ न ऊ कउनो दूसर मनसेन के हाथ हे करे जही, पय ऊ उन सगलू राज के चूर-चूर करी, अउ उनखर अन्त कर डारी, अउ ऊ हरमेसा बने रही। <verse eid="DAN 2:44" /><verse number="45" style="v" sid="DAN 2:45" />जसना तै देखे कि अक्ठी पथरा कउनो के हाथ के बिगर खोदे डोंगर मसे उखडिस अउ ऊ लोहा, पीतर, माटी, चांदी अउ सोना के चूर-चूर करिस, इहै मेर बडा भगवान राजा के गुठे हबै कि एखर बाद काहिन-काहिन होय बाले हबै, न सपना हे अउ न ओखर फडुहा हे कुछ संका हबै।<verse eid="DAN 2:45" /></para>
  <para style="s">राजा दवारा दानिय्येल के इज्जत</para>
  <para style="p">
    <verse number="46" style="v" sid="DAN 2:46" />हइ सुनके नबूकदनेस्सर राजा मुंह के बल गिरके दानिय्येल के परति इज्जत परगट करिस, अउ ऊ आदेस देथै, कि दानिय्येल के भेंट चढाबा, अउ ओखर लिघ्घो सुगंधित धूप जलाया जाय। <verse eid="DAN 2:46" /><verse number="47" style="v" sid="DAN 2:47" />राजा दानिय्येल लग कथै, “सच तो हइ हबै कि तुम्हर भगवान सब देउतन कर भगवान अउ राजन के मालिक हबै, उहै सब रहस्य के पोलपट्टी खोलै बाले हबै, इहैनिता तै हइ भेद के मतलब गुठेमै हे काबिल ठहरे।” <verse eid="DAN 2:47" /><verse number="48" style="v" sid="DAN 2:48" />तब राजा दानिय्येल के अक्ठी ऊंच पद देथै, अउ उके अनेक कीमती उपहार देथै, ऊ दानिय्येल के बेबीलोन देस के सगलू इलाका हे सासक नियुक्त कर देथै, अउ उके बेबीलोन के सब हुसियार मनसेन के उप्पर उके खास परधान बनाय दइस। <verse eid="DAN 2:48" /><verse number="49" style="v" sid="DAN 2:49" />तब दानिय्येल के बिनती करै लग राजा सदरक, मेसक, अउ अबेदनगो के बेबीलोन के देस के काम के उप्पर ठहराइस, पय दानिय्येल खुद राजा के दरबार हे रहै करथै।<verse eid="DAN 2:49" /></para>
  <chapter eid="DAN 2" />
  <chapter number="3" style="c" sid="DAN 3" />
  <para style="s">सोना कर मूरती</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 3:1" />राजा नबूकदनेस्सर सोना के अक्ठी मूरती बनवाइस, जेखर ऊंचाई साठ हाथ अउ चउडाई छह हाथ कर रथै। राजा ओही बेबीलोन के देस के दूरा नाम के मइदान हे ठाढ करवाइस। <verse eid="DAN 3:1" /><verse number="2" style="v" sid="DAN 3:2" />तब राजा अपन सगलू साहबन के अकजुट होय के आदेस दइस, राजकुमारन, राजपालन, अयुक्तन, कोसा अध्यक्छन, मजिसटेटन, अउ देसन के दूसर सगलू साहबन के, उनही राजा नबूकदनेस्सर दवारा स्थापित करे गइस मूरती के समरपन हे सामिल होय के रथै। <verse eid="DAN 3:2" /><verse number="3" style="v" sid="DAN 3:3" />तब राजपाल, हाकिम, जज, हइ सब अधिकारी अकजिघा होथै, जेही राजा नबूकदनेस्सर स्थापित करे रथै, अउ उन ऊ मूरती के आगू ठाड हुइन। <verse eid="DAN 3:3" /><verse number="4" style="v" sid="DAN 3:4" />तब घोसना करै बाले ऊंची आरो हे कथै, हे राज-राज अउ सब भासा के मनसे तुमके हइ करै के आदेस दय जथै। <verse eid="DAN 3:4" /><verse number="5" style="v" sid="DAN 3:5" />जउन टेम तुम नरसिंगा, बसुरी, सितार, सारंगी, बीडा, सहनाई, अउ सबमेर के संगीत के आरो सुना, उहै टेम तुम गिरके सोना के ऊ मूरती के आराधना करा, जेही राजा नबूकदनेस्सर ठाड करे हबै। <verse eid="DAN 3:5" /><verse number="6" style="v" sid="DAN 3:6" />जउन मनसे मूरती के आगू गिरके ओखर इज्जत नेहको करी, ऊ उहै टेम बरत हर आगी के भट्ठी हे फटक दय जही।<note caller="+" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="JER 29:22">इरमि 29:22</ref>; <ref loc="REV 13:15">परकासितवाक्य 13:15</ref></char></note><verse eid="DAN 3:6" /></para>
  <para style="s">दानिय्येल कर तीन दोस हे आदेस न मानै बाले गुनाह</para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 3:7" />इहैनिता जब उन मनसे नरसिंगा, बसुरी, सितार, बीडा, सारंगी, सहनाई अउ दूसर मेर के संगीत अउ बाजन के सुनथै, ता तरी झुक जथै, अउ सोना के ऊ मूरती के आराधना करथै, नबूकदनेस्सर राजा दवारा स्थापित ऊ सोना के मूरती के सगलू परजा, सगलू सेबक अउ उहां के सबमेर के भासा बोलै बाले मनसे पूजापाठ करिन। <verse eid="DAN 3:7" /><verse number="8" style="v" sid="DAN 3:8" />उहै टेम कुछ राजा नबूकदनेस्सर के लिघ्घो आथै, अउ उन यहूदिन के बिरोध हे राजा लग बुराई करथै। <verse eid="DAN 3:8" /><verse number="9" style="v" sid="DAN 3:9" />उन नबूकदनेस्सर राजा लग कथै, हे राजा तै लाखो साल जीहे। <verse eid="DAN 3:9" /><verse number="10" style="v" sid="DAN 3:10" />हे राजा तहिन हइ आदेस दय हबस, कि जसनै संगीत चालू होय तब सब झन गिरके परनाम करै, अउ सोना के मूरती के भजन करै। <verse eid="DAN 3:10" /><verse number="11" style="v" sid="DAN 3:11" />अउ जउन मनसे मूरती के आगू गिरके परनाम अउ अराधना नेहको करहीं, ता धंधकत हर आगी हे डाले जाय। <verse eid="DAN 3:11" /><verse number="12" style="v" sid="DAN 3:12" />राजा तै जउन यहूदिन के बेबीलोन देस के काम के उप्पर नियुक्त करे हबस, उन तोर आदेस के नेहको मानथै, उनखर नाम हबै, सदरक मेसक अबेदनगो, उन तोर बिरुध्द करथै, उन न तोर देउता के सेबा भजन करथै, अउ न तोर बनाय हर सोना के मूरती के आगू झुकथै, अउ न पूजा करथै।<verse eid="DAN 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 3:13" />तब नबूकदनेस्सर राजा हइ सुनके गुस्सा लग लाल हुइ गइस, ऊ सदरक, मेसक, अउ अबेदनगो के बुलवाथै, तब उन तीनो मनसे राजा के आगू आथै। <verse eid="DAN 3:13" /><verse number="14" style="v" sid="DAN 3:14" />नबूकदनेस्सर उनखर लग पूंछथै, सदरक, मेसक, अबेदनगो का हइ सही हबै? कि तुम न मोर देउता के भजन करथा, अउ न तो मोर देउता के आराधना करथा, अउ न मोर दवारा बनाय हर सोना के मूरती के पूजा करथा। <verse eid="DAN 3:14" /><verse number="15" style="v" sid="DAN 3:15" />अब अगर तुम नरसिंगा, बसुरी, सितार सारंगी, बीडा, सहनाई अउ सबमेर के संगीत के आरो सुना, अगर तुम गिरके मोर दवारा बनाय गय हर मूरती के आराधना करै के तइयार हबा, ता बढिया बात हबै, पय अगर तुम ओखर आराधना नेहको करथा, ता इहै टेम बरत हर आगी के भट्ठी हे डाल दय जही, असना कउन देउता हबै, जउन तुमके मोर हाथ लग बचाय सकही।<verse eid="DAN 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="DAN 3:16" />सदरक, मेसक, अउ अबेदनगो राजा के जबाब देथै, हे राजा नबूकदनेस्सर हइ बारे हे हमके तोर आगू अपन खुद के बचाव के जरूरत नेहको हबै। <verse eid="DAN 3:16" /><verse number="17" style="v" sid="DAN 3:17" />अगर हमके बरत हर आगी के भट्ठी हे फटक दय जही, ता हमर भगवान जेखर हम सेबा करथन, ऊ हमके एखर लग बचामै हे सक्तिसाली हबै, हे राजा अउ ऊ हमके तोर हाथ लग बचाही।<verse eid="DAN 3:17" /></para>
  <para style="s">दानिय्येल कर तीनो संगिन के मिरतू कर सजा सुनाय गय</para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 3:18" />पय अगर ऊ हमके नेहको बचाही, तउमा हम तोके गुठे दय चाहथन कि राजा तोर देउता के सेबा नेहको करबो, या तोर दवारा बनाय हर मूरती के आराधना नेहको करब।<verse eid="DAN 3:18" /></para>
  <para style="s">दानिय्येल कर तीनो दोसन के मिरतू सजा</para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 3:19" />तब नबूकदनेस्सर राजा सदरक, मेसक, अबेदनगो के उप्पर बोहत गुस्सा होथै, अउ ओखर सकल के रंग बदल गइस, ऊ आदेस दइस कि आगी के भट्ठी के सात गुना अउ तेज कर दय जाय। <verse eid="DAN 3:19" /><verse number="20" style="v" sid="DAN 3:20" />अउ ऊ अपन सिपाहिन मसे सबले बलवान सिपाही के आदेस देथै, कि सदरक, मेसक अउ अबेदनगो के बांधके बरत हर आगी के भट्ठी हे डाल दय जाय। <verse eid="DAN 3:20" /><verse number="21" style="v" sid="DAN 3:21" />तब उन डउका अपन मोंजा, अंगरखों, पगडी अउ दूसर कपडा सहित बांधके, ऊ धंधकत भट्ठी हे डाल दय गइन। <verse eid="DAN 3:21" /><verse number="22" style="v" sid="DAN 3:22" />राजा कर कठोर आदेस रथै, अउ आगी के भट्ठी एतका गरम रथै, कि आगी के ज्वाला लग उन सिपाही मर जथै, जउन सदरक, मेसक अउ अबेदनगो के आगी के भट्ठी तक लइ जथै। <verse eid="DAN 3:22" /><verse number="23" style="v" sid="DAN 3:23" />अउ उन तीनो मनसे सदरक, मेसक अउ अबेदनगो के बांधके बरत आगी के गडहा हे डाल दय गइन।<verse eid="DAN 3:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="DAN 3:24" />तब राजा नबूकदनेस्सर चकराय गइस अउ घबराय के ठाड हुइ गइस अउ अपन सलाहकारन लग पूंछथै, का हम उन तीनो मनसे के आगी के गडहा हे डालवाय रहन? उन राजा के जबाब देथै, हव राजा सच्ची बात हबै।<verse eid="DAN 3:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 3:25" />फेर राजा कथै, देखा मै आगी के बीच चारठे मनसेन के रेंगत देखथों, उन बधररे हर नेहको हबै, अउ उनखर कुछु नुकसान नेहको होय हबै, अउ चउथा मनसे भगवान कर टोरवा के जसना हबै।<verse eid="DAN 3:25" /></para>
  <para style="s">दानिय्येल कर तीनो दोसन के आजाद करैके अउ पद हे बढोतरी</para>
  <para style="p">
    <verse number="26" style="v" sid="DAN 3:26" />तब नबूकदनेस्सर बरत हर आगी के भट्ठी के दूरा के लिघ्घो पहुंचथै, अउ ऊंच आरो हे कथै, सदरक, मेसक अउ अबेदनगो हे परम परधान के सेबको आगी लग बाहिर निकड आबा, हइ सुनके सदरक, मेसक अउ अबेदनगो आगी के भट्ठी लग बाहिर निकड आइन। <verse eid="DAN 3:26" /><verse number="27" style="v" sid="DAN 3:27" />जब अधिपति, हाकिम, राजपाल अउ राजा के सलाहकारन जउन अकजुट होय रथै, उन डउकन के तरफ देखिस, तब उनखर देह हे आग के कुछ परभाव नेहको पाइस अउ उनखर मूंड के अक्को चूंदी नेहको जरिस, अउ न उनखर कपडा जरिस, अउ न उनखर हे जरै के कुछ गन्ध पाइन।<verse eid="DAN 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="DAN 3:28" />तब नबूकदनेस्सर कथै, सदरक, मेसक, अउ अबेदनगो के भगवान कर महिमा होय, जिहां अपन स्वरगदूत के पठोय के अपन सेबकन के बचाइस, उन ओखर यकीन करिन, अउ राजा के आदेस के परवाह नेहको करिन, अपन जीव देय के तइयार रहिन, एखर कारन उन अपन भगवान के छांडके कउनो देउतन के सेबा या आराधना नेहको करिन।<verse eid="DAN 3:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="DAN 3:29" />इहैनिता मै हइ आदेस देथों, कि कउनो राज या देस के मनसे अगर सदरक, मेसक अउ अबेदनगो के भगवान के बिरुध्द कुछ कथै, ता उनही काटके खन्डा-खन्डा कर दय जही, अउ उनखर घरन के कचरा के ढेर कर दय जही, काखे असना कउनो देउता नेहको हबै, जउन हइमेर लग बचाय सकै।<verse eid="DAN 3:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="DAN 3:30" />तब राजा नबूकदनेस्सर बेबीलोन देस हे सदरक, मेसक अबेदनगो के ऊंच पद देथै।<verse eid="DAN 3:30" /></para>
  <chapter eid="DAN 3" />
  <chapter number="4" style="c" sid="DAN 4" />
  <para style="s">नबूकदनेस्सर के अक्ठी रूख कर बारे हे सपना</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 4:1" />राजा नबूकदनेस्सर बोहत लग राज अउ भासा बोलै बाले मनसेन के, जउन सगलू दुनिया हे बसे हर रथै, हइ संदेस पठोइस कि तुम्हर भला होय। <verse eid="DAN 4:1" /><verse number="2" style="v" sid="DAN 4:2" />भगवान मोर संग अदभुत चिन्ह देखाय हबै, उनखर बारे हे जउन तुमके गुठेउत बोहत खुसी होथै।<verse eid="DAN 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="DAN 4:3" />ओखर देखाय हर चिन्हा केतका बडा</para>
  <para style="q1" vid="DAN 4:3">अउ ओखर चमतकार हे का बडा सक्ति परगट होथै, ओखर राज हरमेसा के</para>
  <para style="q1" vid="DAN 4:3">अउ ओखर परभुता जुग-जुग तक बने रथै।<verse eid="DAN 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 4:4" />मै नबूकदनेस्सर अपन महल हे रथों, मै मगन अउ सफल रथों। <verse eid="DAN 4:4" /><verse number="5" style="v" sid="DAN 4:5" />मै अक्ठी सपना देखों, जउन मोके डराय देथै, मै अपन डसना हे सोथों, मै दरसन के देखथों, जउन कुछ मै देखथों, ऊ मोके बोहत डेराय दइस। <verse eid="DAN 4:5" /><verse number="6" style="v" sid="DAN 4:6" />इहैनिता मै हइ आदेस देथों, कि बेबीलोन के सगलू हुसियार मनसे के मोर लिघ्घो लाय जाय, ताकि उन मोके मोर सपना के मतलब गुठेवै। <verse eid="DAN 4:6" /><verse number="7" style="v" sid="DAN 4:7" />जब टोनहा अउ कसदी मनसे मोर लिघ्घो आथै, ता मै उनके अपन सपना के बारे हे गुठेथों, पय उन मनसे मोके मोर सपना के मतलब नेहको गुठे पाइन। <verse eid="DAN 4:7" /><verse number="8" style="v" sid="DAN 4:8" />आखरी हे दानिय्येल मोर लिघ्घो आथै, जेखर नाम मोर देउता के नाम के कारन बेलतसस्सर रखे गय रथै, अउ जेखर हे पवितर भगवान कर आतमा रथै, अउ मै उके अपन सपना हइ कहिके गुठे दयों। <verse eid="DAN 4:8" /><verse number="9" style="v" sid="DAN 4:9" />मै उके कथों, हे बेलतसस्सर तै सगलू जादू करै बालेन लग बडा हबस, मोके मालुम हबै, कि तोर हे पवितर भगवान कर आतमा रथै, मै जानथों, कि कउनो भेद के समझामै के तोर निता कठिन नेहको हबै, मै जउन सपना देखे रथों, ऊ हइ हबै तै मोके एखर मतलब गुठे।<verse eid="DAN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="DAN 4:10" />जब मै अपन जठना हे सोय रथों, ता मै हइ दरसन देखों, ऊ हइ हबै, मै देखों, कि मोर आगू भुंइ के बीच अक्ठी रूख ठाड हबै ऊ रूख बोहत लम्बा रथै। <verse eid="DAN 4:10" /><verse number="11" style="v" sid="DAN 4:11" />रूख बडा हुइके अक्ठी बडा मजबूत रूख बन गइस, रूख के टिल्ली बादर छुयै लगिस, ऊ रूख के भुंइ के छोर लग देखे जाय सकथै। <verse eid="DAN 4:11" /><verse number="12" style="v" sid="DAN 4:12" />रूख कर पत्ता निक्खा रथै, रूख बोहत बढिया रथै, अउ ऊ रूख हे सब के निता खाय के निता फडुहा रथै, अउ रूख के डगाल हे चिरइया सोउत रथै, सगलू पसु चिरइया ऊ रूख लग भोजन पाथै।<verse eid="DAN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 4:13" />अपन डसना हे सोय-सोय दरसन हे मै उन चीजन के देखथों, अउ तब अक्ठी पवितर स्वरगदूत के मै स्वरग लग तरी उतरत देखथों। <verse eid="DAN 4:13" /><verse number="14" style="v" sid="DAN 4:14" />ऊ बडे ऊंच आरो लग गुठेथै, ऊ कथै, रूख के काट के फेंका एखर डगाल के काट डारा, एखर पत्ता के नोंच लेया, एखर फडुहा के चउगिरदा पल्ला बगराय देया, हइ रूख के तरी आसरा पाये हर पसु कहुं दुरिहां भाग जइहीं, एखर डगाल हे बसेरा करे हर चिरइया कहुं उड जइहीं। <verse eid="DAN 4:14" /><verse number="15" style="v" sid="DAN 4:15" />पय रूख के ठूठ अउ ओखर जर के लोहा अउ पीतर लग बंधररे हर भुंइ के चारा कर बीच भुंइ हे रहै देया,</para>
  <para style="p" vid="DAN 4:15">उके बादर के ओस लग फिलै देया, अउ भुंइ के रूख के बीच पसु के संग रहै देया। <verse eid="DAN 4:15" /><verse number="16" style="v" sid="DAN 4:16" />ओखर मन बदल दय जाय अउ मनसे के जसना ओखर मन नेहको रहै, अउ उके सात साल गुजरै तक पसु के मन दय जाय। <verse eid="DAN 4:16" /><verse number="17" style="v" sid="DAN 4:17" />हइ निरनय के संदेस देय बाले के दवारा करे जथै, पवितर दूत हइ निरनय के घोसना करथै, ताकि जिन्दा मनसे हइ बात के जानै कि ऊ जउन बडा हबै ऊहै भुंइ हे राज के उप्पर परम परधान हबै, अउ उन जेही चाहथै, उके उन राज के दइ देथै, अउ नान लग नान मनसे के उनखर उप्पर नियुक्त कर देथै।<verse eid="DAN 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 4:18" />इहै हबै ऊ सपना जेही राजा नबूकदनेस्सर देखथै, अब हे बेलतसस्सर मोके एखर मतलब गुठे कि एखर मतलब काहिन हबै, काखे मोर राज के कउनो हुसियार मनसे मोके एखर मतलब नेहको गुठे सकथै, पय तै गुठे सकथस, काखे तोर हे पवितर भगवान कर आतमा हबै, दानिय्येल सपना के मतलब गुठेथै।<verse eid="DAN 4:18" /></para>
  <para style="s">दानिय्येल दवारा सपना कर मतलब गुठेथै</para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 4:19" />तब दानिय्येल जेखर नाम बेलतसस्सर रथै, चुटु देर के निता घबराय जथै, अउ ओखर बिचार उके डेराय देथै, इहैनिता राजा कथै,</para>
  <para style="p" vid="DAN 4:19">हे बेलतसस्सर मोर सपना या एखर मतलब लग झइ डेरा, बेलतसस्सर जबाब देथै, हे मोर परभु एखर मतलब तोर बैरी हे लागू होथै, <verse eid="DAN 4:19" /><verse number="20" style="v" sid="DAN 4:20" />ऊ रूख जेही तै देखे हबस, जउन बडा हुइके मजबूत हुइ गइस, जेखर फुंलगी बादर के छीथै, अउ जेही सगलू भुंइ लग देखे जाय सकथै। <verse eid="DAN 4:20" /><verse number="21" style="v" sid="DAN 4:21" />जेखर पत्ता बढिया अउ जेहमा बोहत लग फडुहा रथै, जेखर लग सब के भोजन मिलथै, जउन पतेरा के पसु के आसरा देथै, अउ चिरइया ओखर डगाल हे गोंदा बनाथै।<verse eid="DAN 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="DAN 4:22" />हे राजा ऊ रूख तहिन हबस, तोर महानता एतका हुइ गय हबै, कि हइ बादर के छूय लगे हबै, अउ तोर राज भुंइ के चउगिरदा तक फइल गय हबै। <verse eid="DAN 4:22" /><verse number="23" style="v" sid="DAN 4:23" />हे राजा तै अक्ठी नेक मनसे संदेस वाहक के स्वरग लग तरी उतरत हर देखे हस जउन कथै, हइ रूख के खपल डारा अउ इके नस्ट कर देया, पय एखर ठूठ के, लोहा अउ पीतर लग बंधे हर जमीन के चारा हे रहै देया अउ एखर जर के भुंइ हे छांड देया, उके बादर के ओस लग फिलै देया, उके पतेरा के पसु के संग रहै देया जब तक कि ऊ सात साल बीत न जाय, तब तक इहै दसा हे रहै।<verse eid="DAN 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="DAN 4:24" />हे राजा तोर सपना के मतलब इहै हबै, परम परधान भगवान मोर मालिक राजा के परति हइ बातन के घटै के आदेस दय हबै। <verse eid="DAN 4:24" /><verse number="25" style="v" sid="DAN 4:25" />तोके मनसेन के बीच लग भगाय दय जही, अउ तै पतेरा के पसुन के संग रइहे, तै बइला के जसना चारा खइहे अउ बादर के ओस लग फुलहे, सात साल गुजरै तक तै इहै दसा हे रइहे, अउ तब तै हइ मान लइहे, कि भुंइ हे सगलू राज के उप्पर परम परधान भगवान हबै अउ ऊ जेही चाहथै, उके राज दइ देथै। <verse eid="DAN 4:25" /><verse number="26" style="v" sid="DAN 4:26" />रूख के ठूठ के एखर जर समेत छांडै के जउन आदेस दय गय हबै, ओखर मतलब हइ हबै, तोर राज तोके लउटाय दय जही, जब तै हइ बात मान लइहे, कि दुनिया के परभु स्वरग हे रथै।<note caller="+" style="f"><char style="fr" closed="false">4:26 </char><char style="ft" closed="false">स्वरग हे राज करथै।</char></note> <verse eid="DAN 4:26" /><verse number="27" style="v" sid="DAN 4:27" />राजा मै तोर लग बिनती करथों, तै मोर सलाह स्बीकार कर, मै तोके सलाह देथों, कि तै पाप करै के छांड दे, अउ जउन सही हबै, उहै कर अधरम के छांड दे, गरीबन हे दयालु होय, तबै तै सान्ति के संग रहि सकथस।<verse eid="DAN 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="DAN 4:28" />हइ सगलू बात राजा नबूकदनेस्सर के संग घटथै। <verse eid="DAN 4:28" /><verse number="29" style="v" sid="DAN 4:29" />बारा महिना के बाद मै बेबीलोन के राजभवन के छत हे टहलत रहों, तब ऊ कहै लगिस। <verse eid="DAN 4:29" /><verse number="30" style="v" sid="DAN 4:30" />तब मै सोंचो, “का हइ बेबीलोन सहर बडा हबै, मै अपन बडी ताकत लग बनाय हबो, ताकि हइ मोर राजधानी बनै अउ एखर माध्यम लग मोर बैभव के महिमा के निता बनाय हव।”<verse eid="DAN 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="DAN 4:31" />अभी राजा के हइ बचन ओखर मुंह लग निकरे नेहको रथै, कि स्वरग लग अक्ठी आरो आथै, हे राजा नबूकदनेस्सर तुम्हर निता हइ फइसला करे जथै, तोर राज तोर लग झटक लय गइस। <verse eid="DAN 4:31" /><verse number="32" style="v" sid="DAN 4:32" />अउ तै मनसेन के बीच लग निकाडे जइहे अउ मइदान के पसुन के संग रइहे, अउ गोरुन के जसना चारा चरिहे अउ सात साल तक तोर उप्पर बीतही, जब तक कि तै न जान ले कि परम परधान, मनसे के राज हे परभुता करथै अउ जेही चाहै ओही दइ देथै।<verse eid="DAN 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="DAN 4:33" />उहै टेम हइ बचन नबूकदनेस्सर के बारे हे पूरा हुइस, ऊ मनसेन मसे निकारे गइस, अउ गोरुन के जसना चारा चरै लगिस, अउ ओखर देह बादर के ओस हे फिलथै, इहां तक कि ओखर चूंदी बाज चिरइया के गोड लग अउ ओखर नख्खी चिरइया के हथेली के जसना बढ गइस।<verse eid="DAN 4:33" /></para>
  <para style="s">नबूकदनेस्सर दवारा भगवान कर महिमा</para>
  <para style="p">
    <verse number="34" style="v" sid="DAN 4:34" />सात साल गुजरै के बाद मै नबूकदनेस्सर स्वरग कर पल्ला दीनता लग आंखी उठाथै, अउ मोर समझ लउट आइस, मै परम परधान भगवान के धन्यबाद कथों, जउन सब रोज जिन्दा हबै, मै हइ सब्द हे ओखर महिमा अउ स्तुति करेव,</para>
  <para style="q1" vid="DAN 4:34">भगवान के राज सबरोज हबै,</para>
  <para style="q2" vid="DAN 4:34">ओखर राज पीढी लग पीढी बने रथै।<verse eid="DAN 4:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="DAN 4:35" />भुंइ के सगलू रहइया ओखर आगू बेकार गने जथै,</para>
  <para style="q2" vid="DAN 4:35">अउ ऊ स्वरग के सुपाही अउ भुंइ के रहइया कर बीच</para>
  <para style="q2" vid="DAN 4:35">अपन इक्छा कर जसना काम करथै,</para>
  <para style="q1" vid="DAN 4:35">अउ कउनो ओही रोकके ओखर लग नेहको कहि सकथै,</para>
  <para style="q2" vid="DAN 4:35">“तै हइ का करे हबस?”<verse eid="DAN 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="DAN 4:36" />उहै टेम मोर दिमाक लउट आइस, मोर राज के कीरती के निता मोर परताप अउ बैभव मोके फेरै मिल जाय, मोर मंतरी अउ राजकीय मनसे फेर मोर लिघ्घो आथै, मै फेरै लग राजा बन गयों, मै पहिले लग अधिक बडाई होय लगिस।<verse eid="DAN 4:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="DAN 4:37" />अब मै नबूकदनेस्सर स्वरग कर राजा के स्तुति अउ महिमा करथों, अउ आदर देथों, ऊ जउन कुछु करथै, बढिया करथै, ऊ सब नियाव पूरा करथै, जउन मनसे घमंड लग चलथै, उके ऊ नीचा कर सकथै।<verse eid="DAN 4:37" /></para>
  <chapter eid="DAN 4" />
  <chapter number="5" style="c" sid="DAN 5" />
  <para style="s">बेलसस्सर राजा कर भोज</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 5:1" />राजा बेलसस्सर अपन एक हजार धनी मनसे कर निता बडका भन्डारा करथै, राजा उनखर संग अंगूर कर रस पीथै। <verse eid="DAN 5:1" /><verse number="2" style="v" sid="DAN 5:2" />राजा बेलसस्सर दारू पियत हर अपन रखैल डउकिन के सोना चांदी के बरतन लानै के कथै, हइ उन बरतन रथै, जेही ओखर बाफ नबूकदनेस्सर यरुसलेम के भवन लग लाय रथै, राजा बेलसस्सर चाहथै, कि ओखर धनी मनसे ओखर डउकी अउ ओखर हरवाहिन हइ बरतन लग दारू पीये। <verse eid="DAN 5:2" /><verse number="3" style="v" sid="DAN 5:3" />इहैनिता सोना के उन बरतन लाय गय रथै, जेही यरुसलेम हे भगवान के भवन लग उठाय गय रथै, फेर राजा अउ ओखर साहब ओखर रानी अउ ओखर रखैल डउकी उन बरतन हे दारू डारके पीथै। <verse eid="DAN 5:3" /><verse number="4" style="v" sid="DAN 5:4" />उन दारू पीके सोना, चांदी, पीतर, लोह, लकडी अउ पथरा के देउतन के भजन करै लगथै।<verse eid="DAN 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 5:5" />उहै टेम अचनकै मनसे के जसना हाथ अउ अंगठी निकरके डेहरी के लिघ्घो राजभवन के भीठी हे कुछु लिखै लगिस, अउ हाथ के जउन हिस्सा हे लिखथै ऊ राजा के दिखथै। <verse eid="DAN 5:5" /><verse number="6" style="v" sid="DAN 5:6" />उके देखके राजा डेराय गइस, अउ मन हे डेराय गइस, अउ ओखर कनिहा के जोड कमजोर हुइ गइस, अउ थरथरात-थरथरात ओखर घुटवा एक दूसर लग टकरामै लगिन। <verse eid="DAN 5:6" /><verse number="7" style="v" sid="DAN 5:7" />तब राजा बोहत आरो लग कथै, गुनिया अउ कसदी पंडित के अपन लिघ्घो बुलवाथै, जब बेबीलोन कर पंडित लिघ्घो आइन, तब राजा उनखर लग कथै, मोके जउन कउ हइ लिखाबट के पढके बताही, अउ मोके एखर मतलब समझाय देही, ता मै उके इनाम देहुं, ऊ मनसे के मै बैगनी बन्डी भेंट करिहों, मै ओखर नटेरी हे सोना के हार पहिराहुं, अउ मै उके अपन राज के तीसर सबले बडा सासक बनाय देहुं। <verse eid="DAN 5:7" /><verse number="8" style="v" sid="DAN 5:8" />इहैनिता राजा के सगलू हुसियार डउका उहां आय गइन, पय ऊ लिखाबट के नेहको पढ सकिन, उन समझ नेहको सकिन कि ओखर काहिन मतलब हबै। <verse eid="DAN 5:8" /><verse number="9" style="v" sid="DAN 5:9" />राजा बेलसस्सर के हाकिमन के चक्कर हे पडे हर रथै, अउ राजा भयभीत अउ चिंता हे रथै, काहिन करि काहिन न करि।<verse eid="DAN 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="DAN 5:10" />राजा कर दाय परधान के बातन के सुनके भोज के भवन हे आइस, अउ कहै लगिस, हे राजा तै जुग-जुग जिन्दा रह, अपन मन हे झइ घबरा अउ झइ उदास हो। <verse eid="DAN 5:10" /><verse number="11" style="v" sid="DAN 5:11" />तोर राज हे दानिय्येल नाम के अक्ठी डउका हबै जेखर नाम तोर बाफ बेलतसस्सर रखे रथै, ओहमा पवितर भगवान कर आतमा रथै, अउ ऊ राजा के रोज हे ओखर हे उजियार परवीडता अउ भगवान कर जसना दिमाक पाय हबै, हे राजा तोर बाफ जउन नबूकदनेस्सर राजा रथै, ऊ उके सगलू जोतसी गुनिया कसदी अउ दूसर आगू कर बात गुठेमै बालेन के परधान ठहराय रथै। <verse eid="DAN 5:11" /><verse number="12" style="v" sid="DAN 5:12" />काखे ओहमा निक्खा आतमा ग्यान अउ परवीडता अउ सपना के गुठे बाले अउ पहेलिया खोलै बाले अउ संदेह दूर करै के सक्ति पाय गइस, जेखर नाम ओखर बाफ बेलतसस्सर रखे रथै, इहैनिता अब दानिय्येल के बुलाय जाय, अउ ऊ एखर मतलब गुठेही।<verse eid="DAN 5:12" /></para>
  <para style="s">दानिय्येल दवारा लेख कर मतलब गुठेइस</para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 5:13" />इहैनिता दानिय्येल के राजा के लिघ्घो लइ आइन, राजा दानिय्येल लग कथै, का तै उहै दानिय्येल हबस, मोर बाफ नबूकदनेस्सर राजा दवारा निकारे हर यहूदा देस लग लाय हर का गुलामी मसे हबस? <verse eid="DAN 5:13" /><verse number="14" style="v" sid="DAN 5:14" />मै तोर बारे हे सुने हबो, कि भगवान कर आतमा तोर हे रथै, अउ समझबूझ, ग्यान अउ अच्छी दिमाक तोर हे पाय जथै। <verse eid="DAN 5:14" /><verse number="15" style="v" sid="DAN 5:15" />हुसियार अउ टोनहा मनसे हइ लिखाबट के पढै अउ एखर मतलब गुठेमै के निता मोर लिघ्घो लाय गइन, पय उन एखर मतलब नेहको समझा सकिन। <verse eid="DAN 5:15" /><verse number="16" style="v" sid="DAN 5:16" />पय मै तोर बारे हे सुने हव कि दानिय्येल भेद खोल सकथै, अउ संका दुरिहां कर सकथै, इहैनिता अब अगर तै ऊ लिखै हर के पढ सकहे अउ एखर मतलब मोके समझाय सकहे, ता तोके राजकीय कपडा, अउ तोर नटेरी हे सोन के माला पहिराय जही, अउ राज हे तीसर राजा बनिहे।<verse eid="DAN 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 5:17" />दानिय्येल राजा लग कथै, अपन भेंट अपन लिघ्घो धर, अउ जउन उपहार तै देय चाहथस, ऊ दूसर के दे, ऊ लिखे हर बात मै राजा के पढ के सुनइहों, अउ ओखर मतलब तोके समझाहुं।<verse eid="DAN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 5:18" />हे राजा परमपरधान भगवान तोर बाफ नबूकदनेस्सर के राज महिमा बडाई अउ बैभव दय रथै। <verse eid="DAN 5:18" /><verse number="19" style="v" sid="DAN 5:19" />काखे भगवान उके ऊंच पद दय रथै, इहैनिता सगलू राज-राज के मनसे अउ सब भासा बोले बाले मनसे तोर बाफ लग डरथै, अउ उनखर भय मानथै, अउ जेही ऊ चाहथै उके ऊ जिन्दा रखथै, जेही ऊ चाहथै उके ऊ ऊंच पद देथै, अउ जेही ऊ चाहथै उके ऊ तरी गिराय देथै। <verse eid="DAN 5:19" /><verse number="20" style="v" sid="DAN 5:20" />पय जब घमंड लग ओखर मन फूल गइस अउ ऊ कठोर बन गइस, इहैनिता भगवान दवारा ओखर सक्ति के छंडाय लइस अउ ओखर राज गद्दी सिंहासन लग उतार फटकिस अउ ओखर महिमा झटक लइस। <verse eid="DAN 5:20" /><verse number="21" style="v" sid="DAN 5:21" />उके मनसेन के बीच लग भगाय दय गइस, अउ उके पसु के मन दय गइस, ऊ जंगली गदहा के संग रथै, अउ बइला के जसना चारा चरथै, अउ ओखर देह बादर के ओस लग फिलथै, हइ तब तक होथै, जब तक कि ऊ हइ नेहको मान लइस कि भुंइ हे सब राज के उप्पर भगवान परमपरधान हबै, अउ ऊ जेही चाहथै, उके राज हे सासक ठहराथै।<verse eid="DAN 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="DAN 5:22" />तउभरमा हे बेलसस्सर तै जउन ओखर टोरवा हबस, अउ हइ सब कुछ जानथस, तउभरमा तोर मन नम्र नेहको होय। <verse eid="DAN 5:22" /><verse number="23" style="v" sid="DAN 5:23" />पय तै स्वरग कर परभु के बिरुध्द मूंड उठाय के ओखर भवन के बरतन मंगवाय के अपन आगू धरवाय लय, अउ अपन परधान अउ रानी अउ रखैल समेत तै ओहमा दारू पिये, अउ चांदी, सोना, पीतर, लोह, लकडी अउ पथरा के देउता जउन नेहको देखथै, अउ न सुनथै, अउ न कुछ जानथै, उनखर तै भजन करे, पय भगवान जेखर हाथ हे तोर जीव हबै, अउ जेखर वस हे सब तोर रेंगना-बगना हबै, ओखर इज्जत तै नेहको करे। <verse eid="DAN 5:23" /><verse number="24" style="v" sid="DAN 5:24" />इहैनिता भगवान ऊ हाथ के परगट करिस, जउन भीठी हे लिखिस।<verse eid="DAN 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 5:25" />जउन सब्द लिखे गइस ऊ हइ हबै, मने,<note caller="+" style="f"><char style="fr" closed="false">5:25 </char><char style="ft" closed="false">गिना</char></note> मने, तकेल अउ “परेस”। <verse eid="DAN 5:25" /><verse number="26" style="v" sid="DAN 5:26" />हइ लेख के मतलब हइ हबै, मने मतलब भगवान तोर राज के रोज गिनके ओखर अन्त कर दय हबै। <verse eid="DAN 5:26" /><verse number="27" style="v" sid="DAN 5:27" />तकेल के मतलब हबै, तोके तखरी हे तउल लय गय हबै, अउ तै हरु पाय गय हबस। <verse eid="DAN 5:27" /><verse number="28" style="v" sid="DAN 5:28" />परेस के मतलब हबै, तोर लग तोर राज झटक लय गय हबै, अउ ओखर बटवारा होथै, हइ राज मादियन, अउ फरीसिन के दइ दे गइस।<verse eid="DAN 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="DAN 5:29" />तब बेलसस्सर आदेस दइस, अउ दानिय्येल के राजकीय बन्डी अउ नटेरी हे सोना के माला पहिराथै, अउ हइ डिंडोरा पिटवाथै, कि राज हे तीसर सबले बडा सासक दानिय्येल होही।<note caller="+" style="x"><char style="xo" closed="false">5:29 </char><char style="xt" closed="false"><ref loc="GEN 41:42">उत्पति 41:42</ref></char></note> <verse eid="DAN 5:29" /><verse number="30" style="v" sid="DAN 5:30" />उहै रात बेबीलोन के पुरखन के मालिक राजा बेलसस्सर मार डारे गइस। <verse eid="DAN 5:30" /><verse number="31" style="v" sid="DAN 5:31" />अउ मादी के रहै बाले अक्ठी मनसे जेखर नाम दारा रथै, जेखर उमर कउनो बासठ साल के रथै, ऊ राज कर नबा राजा बनिस।<verse eid="DAN 5:31" /></para>
  <chapter eid="DAN 5" />
  <chapter number="6" style="c" sid="DAN 6" />
  <para style="s">बघवा कर खोदरा हे दानिय्येल</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 6:1" />दारा के हइ निक्खा लगिस अपन राज के उप्पर एक सव बीस असना राजपाल ठहराय, जउन पूरा राज हे अधिकार रखे। <verse eid="DAN 6:1" /><verse number="2" style="v" sid="DAN 6:2" />अउ उनखर उप्पर ओसनेन तीन अध्यक्छ, जेखर हे दानिय्येल अक्ठी रथै, इहैनिता ठहराय, उनखर राजपाल लग लेखा जोखा लय करे, अउ हइ रीति राजा के कुछ नुकसान झइ होय पाय। <verse eid="DAN 6:2" /><verse number="3" style="v" sid="DAN 6:3" />जब हइ देखै गइस, कि दानिय्येल हे उत्तम आतमा रथै, तब ओही उन अध्यक्छन अउ राजपालन लग जादा आदर मिलिस, पय राजा इहो सोंचथै, कि ओही सगलू राज के उप्पर सासक ठहराय। <verse eid="DAN 6:3" /><verse number="4" style="v" sid="DAN 6:4" />तब अध्यक्छ अउ राजपाल राज काम के बारे हे दानिय्येल के बिरुध्द दोस खोजै लगथै, पय ऊ बिस्वासयोग रथै, अउ ओखर काम हे कउनो गलती या दोस नेहको निकडथै, अउ उन असना कउनो अपराध या दोस नेहको पाय सकिन। <verse eid="DAN 6:4" /><verse number="5" style="v" sid="DAN 6:5" />तब उन मनसे कहै लगथै, हम ऊ दानिय्येल के भगवान के नियम के छांड अउ कउनो बारे हे ओखर बिरुध्द कउनो दोस नेहको पा सकहिन।<verse eid="DAN 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="DAN 6:6" />तब अध्यक्छ अउ राजपाल राजा के लिघ्घो एक मत हुइके आथै, अउ ओखर लग कथै, हे राजा दारा तै जुग-जुग जिन्दा रइहे। <verse eid="DAN 6:6" /><verse number="7" style="v" sid="DAN 6:7" />राज के सगलू अध्यक्छन अउ हाकिम अधिपति नियाव करै बाले अउ राजपाल अपन हे अक गुट हुइन, कि राजा असना आदेस देय, अउ असना कडी आदेस निकारै कि तीस रोज तक जउन कउ हे राजा तोके छांडके कउनो अउ मनसे या देउतन लग बिनती करै, ऊ बघवा के मांडा हे डाल दय जाय। <verse eid="DAN 6:7" /><verse number="8" style="v" sid="DAN 6:8" />इहैनिता अब हे राजा असना आदेस दे, अउ हइ चिट्ठी हे दसकत कर, जेखर लग हइ बात मादियन, अउ फारसिन के मजबूत नियम के जसना रद्द नेहको करे जा सके। <verse eid="DAN 6:8" /><verse number="9" style="v" sid="DAN 6:9" />तब राजा दारा उस आदेस चिट्ठी हे दसकत कर दइस। <verse eid="DAN 6:9" /><verse number="10" style="v" sid="DAN 6:10" />जब दानिय्येल के पता चलिस कि ऊ चिट्ठी हे दसकत करे गय हबै, तब ऊ अपन घर हे गइस जेखर उप्पर कर कोठरी के खिडकी यरुसलेम के पल्ला उघरे रथै, अउ अपन रीति के जसना कि ऊ दिन हे तीन बेर अपन भगवान के आगु घुटवा टेक के बिनती अउ धन्यबाद करथै, आजो ऊ ओसनेन करिस।<verse eid="DAN 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 6:11" />तब उन डउका एक मन हुइके आथै, उन दानिय्येल के अपन भगवान के आगू बिनती करत अउ गिडगिडात हर पाथै। <verse eid="DAN 6:11" /><verse number="12" style="v" sid="DAN 6:12" />उन सगलू दानिय्येल हे अरोप लगामै कर निता राजा कर लिघ्घो गइन, उन कथै, माहाराज तै अक्ठी आदेस हे दसकत करे हबस, कि अगले तीस रोज तक जउन कउ तोर सिबाय कउनो देउता या मनसेन लग कुछु मंगहिन, ता उके बघवा कर खोदरा हे फटक दय जही,</para>
  <para style="p" vid="DAN 6:12">राजा कथै, “हव हइ सही आदेस हबै, मादियन फारसिन कर नियम हबै, जेही बदले नेहको जाय सकथै।”<verse eid="DAN 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 6:13" />तब उन राजा लग कथै, यहूदी गुलामी मसे जउन दानिय्येल हबै, हे राजा ऊ न तोर तरफ धियान देथै, अउ न तोर दसकत करे हर आदेस चिट्ठी मानथै, ऊ अभिन्नो हर रोज तीन बेर अपन भगवान लग बिनती करथै।<verse eid="DAN 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="DAN 6:14" />हइ बात सुनके राजा दारा के बडा दुख होथै, ऊ दानिय्येल के बचामै के निता जुगाड सोंचै लगथै, ऊ सुबेन्ने लग बेरा कर बुडै तक दानिय्येल के बचामै के निता कोसिस करथै। <verse eid="DAN 6:14" /><verse number="15" style="v" sid="DAN 6:15" />एखर बाद झुन्ड बनाय के राजा के लिघ्घो आथै, अउ उन राजा लग कथै, हे राजा सुरता रख, मादी अउ फारसी के हइ नियम हबै, राजा दवारा नियम बनाय हर कबहुन न बदले जाय सकथै, अउ न रद्द करे जाय सकथै।<verse eid="DAN 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="DAN 6:16" />तब राजा आदेस दइस, अउ उन दानिय्येल के लायके उके बघवा के खोदरा हे डाल दइन, राजा दानिय्येल लग कथै, तोर भगवान जेखर तै महिमा करथस उहै तोर मदत करी। <verse eid="DAN 6:16" /><verse number="17" style="v" sid="DAN 6:17" />तब राजा के नोकर अक्ठी बडा पथरा लाथै, अउ उन ओखर खोदरा के दूरा हे धर देथै, एखर बाद राजा दारा अपन मुंदरी लेथै, अउ ऊ पथरा हे अपन मुहर लगाय दइस, अउ संग हे अपन परभावसाली मनसेन के मुंदरी लग खोदरा के दूरा हे मोहर लगाय देथै, दानिय्येल के दसा के बदले झइ जाय सकै।<verse eid="DAN 6:17" /></para>
  <para style="s">दानिय्येल के बघवा लग बचामै के परयास</para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 6:18" />एखर बाद राजा दारा अपन महल हे चले गइस, ऊ उस रात भोजन नेहको करथै, ऊ नेहको चाहथै कि कउनो ओखर लिघ्घो आमै, अउ ओखर मन बहलामै बाले सगलू के मना कर देथै, ऊ रात राजा नेहको सोय पाथै।<verse eid="DAN 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 6:19" />जब सुबेन्ने राजा उठिस अउ हरबी बघवा के खोदरा छो गइस। <verse eid="DAN 6:19" /><verse number="20" style="v" sid="DAN 6:20" />जब राजा खोदरा के लिघ्घो पहुंचथै, जिहां दानिय्येल बन्द रथै, ऊ दुख भरी आरो हे दानिय्येल के पुकारथै, “हे दानिय्येल जिन्दा भगवान के हरवाह का तोर भगवान जेखर तै लगेतार पराथना करथस, तोके बघवा के मुंह लग बचाय लइस?”<verse eid="DAN 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="DAN 6:21" />दानिय्येल राजा लग कथै, “हे राजा तै जुगजुग जीहे। <verse eid="DAN 6:21" /><verse number="22" style="v" sid="DAN 6:22" />मोर भगवान अपन अक्ठी दूत के पठोय हबै, जउन बघवा के मुंह बन्द कर दइस, काखे मै भगवान के नजर हे निरदोस रहों, इहैनिता बघवा मोके नुकसान नेहको पहुंचाइस, राजा इहै मेर मै तोर आगू निस्पाप हबो, काखे मै कउनो गलती नेहको करे हव।”<verse eid="DAN 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="DAN 6:23" />हइ सुनके राजा दारा बोहत मगन हुइस, ऊ दानिय्येल के खोदरा लग बाहिर निकारै के आदेस दइस, राजा के नोकर उके खोदरा लग बाहिर निकारिन, दानिय्येल के देह हे एक्को खरोच नेहको लगथै, काखे ऊ अपन भगवान हे यकीन करथै। <verse eid="DAN 6:23" /><verse number="24" style="v" sid="DAN 6:24" />उन मनसे जउन दानिय्येल के उप्पर झूठा दोस लगाय रथै, उनही राजा के आदेस लग लाय गइन, अउ उनही उनखर डउकी लरका समेत बघवा के खोदरा हे डाल दय गइस, अउ एखर पहिलेन कि इन खोदरा के तरी पहुंचतै बघवा लपक लेथै, अउ हाडा समेत उनही चबाय डारथै।<verse eid="DAN 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 6:25" />राजा दारा सगलू भुंइ हे रहैबाले राज-राज के सगलू मनसे अउ हर भासा के मनसेन के हइ लिखिस, “तुम सब उन्नति करा।” <verse eid="DAN 6:25" /><verse number="26" style="v" sid="DAN 6:26" />मै हइ आदेस देथों, कि मोर राज हे हर जिघा के मनसे दानिय्येल के भगवान के भय मानै</para>
  <para style="q1" vid="DAN 6:26">“अउ ओखर महिमा करै, काखे उहै जिन्दा भगवान हबै,</para>
  <para style="q2" vid="DAN 6:26">अउ सबरोज तक बने रही, ओखर राज कबहुन नस्ट नेहको होही,</para>
  <para style="q1" vid="DAN 6:26">ओखर सासन के कबहुन</para>
  <para style="q2" vid="DAN 6:26">आखरी नेहको होही।<verse eid="DAN 6:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="DAN 6:27" />ऊ समस्या लग मुक्त करथै, अउ सरीर के रक्छा करथै,</para>
  <para style="q2" vid="DAN 6:27">अउ भुंइ हे चकित कर काम करथै।</para>
  <para style="q1" vid="DAN 6:27">उहै बघवा के मुंह लग</para>
  <para style="q2" vid="DAN 6:27">दानिय्येल के बचाइस।”<verse eid="DAN 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="DAN 6:28" />हइ मेर दानिय्येल, राजा दारा अउ फारसी राजा कुस्रू के राजकाल हे सुख सान्ति लग रथै।<verse eid="DAN 6:28" /></para>
  <chapter eid="DAN 6" />
  <chapter number="7" style="c" sid="DAN 7" />
  <para style="s">दानिय्येल अपन सपना कर बिस्तार करथै</para>
  <para style="r">(<ref loc="DAN 7:1-12">दानि 7:1-12</ref>; <ref loc="DAN 12:13">12:13</ref>)</para>
  <para style="s">दानिय्येल के सपना हे चारठे पसु</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 7:1" />बेबीलोन के राजा बेलसस्सर के सासन के पहिले साल हे, दानिय्येल रात हे सोउत रहिस, ता ऊ अक्ठी सपना अउ दरसन देखथै, ऊ अपन सपना के बिस्तार लग वरनन करिस।<verse eid="DAN 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="DAN 7:2" />दानिय्येल हइ कथै, मै रात के हइ सपना देखों, कि महासागर हे चउगिरदा पल्ला बडेरा चलै लगिस। <verse eid="DAN 7:2" /><verse number="3" style="v" sid="DAN 7:3" />तब समुन्दर मसे चारठे बडा-बडा जानबर जउन अक दूसर लग अलगे रथै, निकर आइन।<note caller="+" style="x"><char style="xo" closed="false">7:3 </char><char style="xt" closed="false"><ref loc="REV 13:1">परकासितवाक्य 13:1</ref>; <ref loc="REV 17:8">17:8</ref></char></note> <verse eid="DAN 7:3" /><verse number="4" style="v" sid="DAN 7:4" />पहिले पसु बघवा के जसना रथै, जेखर गिधवा के जसना डेखना रथै, मोर देखत-देखत ओखर डेखना के नोंच डारे गइस, अउ उके भुंइ लग उठाय के मनसे के जसना दुइठे गोड हे ठाढ करे गइस, अउ उके अक्ठी मनसे के जसना हिरदय दय गइस।<verse eid="DAN 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 7:5" />फेर मै अक अउ पसु देखों जउन भलुवा कर जसना रथै, अउ अक पसली के बल उठे हर रथै, अउ ओखर मुंह हे दांतन कर बीच तीन पसली रथै, अउ मनसे ओखर लग कथै, उठ बोहत गोस खा।<verse eid="DAN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="DAN 7:6" />एखर बाद मै देखों, कि मोर आगू अक्ठी अउ पसु ठाड हबै, हइ पसु चितवा जसना लगथै, अउ ऊ चितवा के पिठार हे चारठे डेखना रथै, डेखना असना लगथै, कि जसना ऊ कउनो चिरइया के डेखना होय, हइ पसु के चारठे मूंड रथै, अउ उके सासन करै के अधिकार दय गय रथै।<note caller="+" style="x"><char style="xo" closed="false">7:6 </char><char style="xt" closed="false"><ref loc="REV 13:2">परकासितवाक्य 13:2</ref></char></note><verse eid="DAN 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 7:7" />एखर बाद रात के मै अपन सपना हे अक्ठी चउथा पसु के देखों, जउन भयानक डेराय अउ बोहत सक्तिसाली रथै, ओखर बडा-बडा लोह के दांत रथै, ऊ अपन सिकार के दबायके खाय जथै, अउ जउन कुछु बच जथै, उके गोड लग कुचर डालथै, ऊ एखर पहिले के सगलू पसुन लग अलगे रथै, अउ ओखर दसठे सींग रथै। <verse eid="DAN 7:7" /><verse number="8" style="v" sid="DAN 7:8" />जब मै सींगन के धियान लग देखों कि उन सींगन के बीच अक्ठी नान सींग अउ उग आइस, जेहमा लग तीनो के जउन पहिलेन रथै उनके उखाड दइस, हइ सींग जउन मनसे कर जसना सींग रथै, अउ बडे बोल बाले मुंह रथै, अउ ऊ खुद के बडाई करत रथै।<verse eid="DAN 7:8" /></para>
  <para style="s">हरमेसा रहै बाले कर दरसन</para>
  <para style="p">
    <verse number="9" style="v" sid="DAN 7:9" />मोर देखतै-देखत उनखर जिघा हे सिंहासन रखे गइस, अउ ऊ बिराजमान हुइस, ओखर बन्डी बरफ के जसना चरका रथै, उनखर मूंड के चूंदी ऊन लग चरका रथै, ओखर सिहांसन आगी के बने रथै, अउ ओखर पहिया बरत हर आगी के जसना दिखाई देथै।<note caller="+" style="x"><char style="xo" closed="false">7:9 </char><char style="xt" closed="false"><ref loc="REV 20:4">परकासितवाक्य 20:4</ref></char></note> <verse eid="DAN 7:9" /><verse number="10" style="v" sid="DAN 7:10" />परचीन राजा के आगू एक आगी के नदिया बहथै, लाखो-लाख मनसे ओखर सेबा हे रथै, ओखर आगू हजारो-हजार हरवाह ठाड रथै, हइ द्रस्य कुछ ओसनेन रथै, फेर नियाव करै बाले बइठ गइन, अउ किताब खोले गइस<note caller="+" style="x"><char style="xo" closed="false">7:10 </char><char style="xt" closed="false"><ref loc="REV 5:11">परकासितवाक्य 5:11</ref>; <ref loc="REV 20:12">20:12</ref></char></note>।<verse eid="DAN 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 7:11" />ऊ टेम सींग के खुद के घमंड हे सुनके मै देखत रहों, अउ देखतै-देखत जसना मै देखत रथों, कि चउथा पसु के घात करे गइस, अउ ओखर देह बरत आगी लग भसम करे गइस। <verse eid="DAN 7:11" /><verse number="12" style="v" sid="DAN 7:12" />अउ बाकी बचे हर पसुन के अधिकार लइ ले गइस, पय उनखर जीव कुछ टेम तक जिन्दा रहै के आदेस दइस।<verse eid="DAN 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 7:13" />मै रात हे सपना देखों, कि मनसे के टोरवा के जसना कउनो आकास के बादर के संग आथै, अउ ऊ सियान के लिघ्घो आय पहुंचिस अउ उके उनखर आगू लाय गइस। <verse eid="DAN 7:13" /><verse number="14" style="v" sid="DAN 7:14" />ऊ जउन मनसे के जसना दिखाई देथै, उके हक महिमा अउ सगलू सासन सत्ता सउप दय गइस, अउ राज-राज के मनसे अउ अलगे-अलगे कुर कर मनसे अउ अलगे-अलगे भासा बोलै बाले सगलू ओखर अधीन होय, ओखर राज सबरोज तक मजबूत अउ ओखर राज कबहुन नस्ट नेहको होही।<verse eid="DAN 7:14" /></para>
  <para style="s">सपना कर मतलब गुठे गइस</para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 7:15" />मै दानिय्येल मन हे बोहत चिंता हे होयों, अउ जउन सपना मै देखों, ओखर कारन मै घबराय गयों। <verse eid="DAN 7:15" /><verse number="16" style="v" sid="DAN 7:16" />तब उहां जउन मनसे ठाडे रथै, उन मसे अक्ठी के लिघ्घो जायके मै उन सगलू बातन के मतलब पूंछो, ऊ हइ कहिके मोके उन बातन के मतलब गुठेइस। <verse eid="DAN 7:16" /><verse number="17" style="v" sid="DAN 7:17" />उन चारठे बडे-बडे जानबर कर मतलब चारठे राजा आय, जउन भुंइ हे उदय होही। <verse eid="DAN 7:17" /><verse number="18" style="v" sid="DAN 7:18" />पय भगवान के पवितर मनसे ऊ राज के पइहीं, अउ जुगजुग ओखर साहब बने रइहीं।<note caller="+" style="x"><char style="xo" closed="false">7:18 </char><char style="xt" closed="false"><ref loc="REV 22:5">परकासितवाक्य 22:5</ref></char></note><verse eid="DAN 7:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 7:19" />तब मोर मन हे इक्छा हुइस, कि ऊ चउथा जानबर के भेद जान लो, जउन दूसर तीनो लग अलगे अउ अति भयानक रथै, अउ जेखर दांत लोह के अउ नख्खी पीतर के रथै, ऊ सब कुछ खाय डालथै, अउ चूर-चूर कर डालथै, अउ बचे हर के गोडन लग कचर डालथै। <verse eid="DAN 7:19" /><verse number="20" style="v" sid="DAN 7:20" />फेर ओखर मूंड हे दसठे सींगन कर भेद अउ जउन नबा सींग निकडै लग तीनठे सींग गिर गइस, जउन सींग कर आंखी अउ मुंह घमंड लग भरी बात करथै, हइ सगलू सींगन लग बोहत भयांकर रथै, ओखर भेद जानै के मोके इक्छा हुइस।<verse eid="DAN 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="DAN 7:21" />फेर मै देखों, कि ऊ सींग पवितर मनसेन के संग झगडा करके उनखर हे ऊ टेम तक परबल हुइ गइस।<note caller="+" style="x"><char style="xo" closed="false">7:21 </char><char style="xt" closed="false"><ref loc="REV 13:7">परकासितवाक्य 13:7</ref></char></note> <verse eid="DAN 7:21" /><verse number="22" style="v" sid="DAN 7:22" />तब हरमेसा लग जिन्दा पुरान सियान आयके अउ परमपरधान भगवान के पवितर मनसेन के पक्छ हे नियाव करिस, ऊ टेम आइस जब भगवान कर मनसे राज हे अधिकार पाइन।<verse eid="DAN 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="DAN 7:23" />ऊ कथै, ऊ चउथा पसु कर मतलब, अक्ठी चउथा सासन जउन भुंइ हे हुइके सगलू राजन लग अगले होही, अउ सगलू भुंइ के नास करी, अउ गोड लग चूर-चूर करी। <verse eid="DAN 7:23" /><verse number="24" style="v" sid="DAN 7:24" />अउ ऊ सींगन कर मतलब हइ हबै, कि ऊ राज मसे दसठे राजा उठहिन, अउ उनखर बाद अक्ठी दूसर राजा परगट होही, हइ बाकिन लग बोहत जादा अलग होही, जउन तीनठे राजन के गिराय देही।<note caller="+" style="x"><char style="xo" closed="false">7:24 </char><char style="xt" closed="false"><ref loc="REV 17:12">परकासितवाक्य 17:12</ref></char></note> <verse eid="DAN 7:24" /><verse number="25" style="v" sid="DAN 7:25" />अउ परमपरधान भगवान कर बिरुध्द बात करहीं, अउ परमपरधान के मनसेन के पीस डारी, अउ ऊ उनखर निरधारित टेम अउ नियम के बदल दइ, अउ भगवान कर मनसे साढे तीन साल तक ओखर बस हे कर दय जइहीं। <verse eid="DAN 7:25" /><verse number="26" style="v" sid="DAN 7:26" />तब परमपरधान भगवान के मनसे नियाव के निता बइठी, अउ ऊ राज अउ अधिकार झटक लय जही, अउ इहां तक कि ओखर अन्त हुइ जही। <verse eid="DAN 7:26" /><verse number="27" style="v" sid="DAN 7:27" />राज अउ सासन सगलू आकास के तरी भुंइ के सगलू राज के महानता, परमपरधान भगवान के हरवाहन के समूह के दय जही, उनखर राज सब रोज मजबूत रही, अउ दूसर राज के मनसे उनखर इज्जत अउ सेबा करहीं।<verse eid="DAN 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="DAN 7:28" />अउ मै दानिय्येल जउन बात देखे अउ सुने रथों, मन हे बडा घबराहट बने रहिस, अउ मै भयभीत हुइ गयों, अउ हइ बात के मै अपन मन हे रखे रहों।<verse eid="DAN 7:28" /></para>
  <chapter eid="DAN 7" />
  <chapter number="8" style="c" sid="DAN 8" />
  <para style="s">दानिय्येल अक गेडरा अउ अक बोकडा कर सपना</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 8:1" />राजा बेलसस्सर के सासन काल के तीसर साल हे, मै दानिय्येल अपन पहिले दरसन के बाद अक्ठी अउ दरसन देखों। <verse eid="DAN 8:1" /><verse number="2" style="v" sid="DAN 8:2" />मै सपना हे हइ देखों, मै एलाम परदेस के सूसन नाम के अक्ठी सहर हे रथों, कि ऊलै नदिया के टाठा हे ठाड हव। <verse eid="DAN 8:2" /><verse number="3" style="v" sid="DAN 8:3" />मै नजर उप्पर करो, ता देखों कि नदिया के टाठा हे अक्ठी गेडरा ठाड हबै, ओखर दुइठे सींग हबै, हइ दुनो सींग बडा-बडा रथै, पय अक्ठी सींग दूसर सींग लग बडा रथै, जउन सींग बडा रथै, ऊ नान सींग के बाद हे निकरथै। <verse eid="DAN 8:3" /><verse number="4" style="v" sid="DAN 8:4" />मै देखथों, कि ऊ मेढा इछो-उछो सींग मारथै फिरथै, मै देखों कि ऊ मेढा कबहुन दिन बुडती के पल्ला दउरथै, ता कबहुन खाले दिसा के पल्ला ता कबहुन दख्खिन के पल्ला ऊ मेढा अक्कोठे कउनो पसु के रोक नेहको पाथै, अउ न कउनो दूसर पसु के बचाय पाथै, ऊ मेढा सब कुछ कर सकथै, जउन कुछ करै चाहथै, हइमेर लग ऊ मेढा बोहत सक्तिसाली हुइ गइस।<verse eid="DAN 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 8:5" />जब मै एखर बारे हे सोंचथों, तब मै देखों कि अचानकै अक्ठी छेडी दिन बुडती लग आथै, जेखर आंखी के बीच अक्ठी खास सींग रथै, अउ ऊ सगलू भुंइ के पार करके भुंइ के बिगर छूय आथै। <verse eid="DAN 8:5" /><verse number="6" style="v" sid="DAN 8:6" />हइ बोकडा ऊ दुइ सींग बाले मेढा के पल्ला आइस, जेही मै नदिया के टाठा हे ठाड देखे रथों, अउ गुस्सा हुइके ऊ मेढा के उप्पर टूट पडिस। <verse eid="DAN 8:6" /><verse number="7" style="v" sid="DAN 8:7" />मै देखों कि हइ बोकडा बोहत गुस्सा हुइके ऊ मेढा कर उप्पर हमला करथै, अउ उके ठोकड मार के ओखर दुनो सींगन के टोर दइस, मेढा हे एतका बल नेहको रथै, कि ऊ बोकरा के सामना कर सकै, बोकरा मेढा के भुंइ हे पटक देथै, अउ उके अपन खुर लग कचर डारिस, बोकरा के हाथ लग ऊ मेढा के बचामै बाले कउनो नेहको रथै।<verse eid="DAN 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 8:8" />जब छेडी घमंड करै लगिस अउ जब ताकत बाले हुइस, तब ओखर बडा सींग टूट गइस, अउ एखर जिघा हे देखै लायक चारठे सींग निकरके चउगिरदा पल्ला बढै लगिस। <verse eid="DAN 8:8" /><verse number="9" style="v" sid="DAN 8:9" />फेर हइ मसे अक नान हस सींग अउ निकडिस जउन दख्खिन, पूरब अउ टीमा करे हर देस कर पल्ला बोहत बढत गइस। <verse eid="DAN 8:9" /><verse number="10" style="v" sid="DAN 8:10" />ऊ ताकत हे एतका बढिस कि ऊ स्वरग कर सेना लग लडिस, अउ तरइयन मसे केतनोन के भुंइ हे गिराय के कचर डारिस<note caller="+" style="x"><char style="xo" closed="false">8:10 </char><char style="xt" closed="false"><ref loc="REV 12:4">परकासितवाक्य 12:4</ref></char></note> <verse eid="DAN 8:10" /><verse number="11" style="v" sid="DAN 8:11" />इहां तक कि ऊ स्वरग कर सेना के परधान तक पहुंच गइस, ऊ भगवान के चढाय जाय बाले सबरोज के बलिदान के झटक लइस, अउ ओखर पवितर जिघा के माटी हे मिलाय दइस। <verse eid="DAN 8:11" /><verse number="12" style="v" sid="DAN 8:12" />गुस्सा के कारन भगवान कर मनसे अउ सबरोज के बलि के ओखर हाथ हे कर दय गइस, अउ ओखर सच्चाई के माटी हे मिलाय दइस।<verse eid="DAN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 8:13" />तब मै अक्ठी स्वरग के बोलत सुनो, फेर अक्ठी दूसर पवितर जन आगू बाले लग कथै, दरसन के पूर होय हे केतका टेम लगी, ऊ दरसन जेहमा सबरोज के बलिदान बिदरोह जउन उजाड के कारन बनथै, पवितर जिघा के समरपन अउ भगवान के मनसे के गोड तरी कचरे जाय के देखाय गइस।<verse eid="DAN 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="DAN 8:14" />ऊ मोर लग कथै, इके पूर होय हे तेइस सव सुबेन्ने अउ सांझ लगी, तब फेर पवितर जिघा के सही बिधि लग चालू करे जही।<verse eid="DAN 8:14" /></para>
  <para style="s">स्वरगदूत जिब्राएल दवारा सपना के मतलब गुठेइस</para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 8:15" />जब मै सपना के देख चुकों, तब मै दानिय्येल एखर मतलब समझै के परयास करो, मै देखों, कि मोर आगू कउनो ठाड हुइस जउन अक्ठी मनसे के जसना दिखथै। <verse eid="DAN 8:15" /><verse number="16" style="v" sid="DAN 8:16" />मै कउनो मनसे के आरो सुनो, ऊ ऊलै नदिया के टाठा के बीच मसे निकरे रथै, ऊ आरो ऊंच आरो हे कथै, “हे जिब्राएल हइ मनसे के एखर सपना के मतलब गुठे दे।”<note caller="+" style="x"><char style="xo" closed="false">8:16 </char><char style="xt" closed="false"><ref loc="LUK 1:19">लूका 1:19</ref>,<ref loc="LUK 1:26">26</ref></char></note> <verse eid="DAN 8:16" /><verse number="17" style="v" sid="DAN 8:17" />जब ऊ जिघा के लिघ्घो आथै, जिहां मै ठाड रथों, ता मै डेराय जथों, अउ मुंह के बल गिरों, तब ऊ मनसे मोर लग कथै,</para>
  <para style="p" vid="DAN 8:17">“हे मनसे के टोरवा हइ बात के समझ लेया, कि हइ दरसन के संबंध आखरी के टेम लग फलही।” <verse eid="DAN 8:17" /><verse number="18" style="v" sid="DAN 8:18" />जब ऊ बात करथै, मै बिहोस हुइके भुंइ हे गिर पडो, पय ऊ मोके पकड लइस, मोके मोर गोड हे ठाढ करिस <verse eid="DAN 8:18" /><verse number="19" style="v" sid="DAN 8:19" />तब ऊ कथै, “गुस्सा भडकै के आखरी रोज हे जउन कुछु होही, ऊ तोके समझाथो, काखे अंतिम हे ठहराय हर टेम हे पूर होही।”<verse eid="DAN 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="DAN 8:20" />जउन दुइठे सींग बाले मेढा तै देखे हबस, ओखर मतलब हबै मादियन अउ फारस राजा के दरसाथै। <verse eid="DAN 8:20" /><verse number="21" style="v" sid="DAN 8:21" />अउ यूनान देस के राज रोमा दार बोकडा हबै, हइ बोकडा के दुनो आंखी के बीच सींग के मतलब हबै, यूनान के पहिले राजा। <verse eid="DAN 8:21" /><verse number="22" style="v" sid="DAN 8:22" />जउन चारठे सींग के टूटै के बाद एखर जिघा हे निकडथै, ओखर मतलब हबै, यूनानी राज मसे चारठे राज के सुरुआत होही, पय ऊ ओखर जसना सक्तिसाली नेहको होही।<verse eid="DAN 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="DAN 8:23" />जब उन राज के आखरी होही, तब उहां अक्ठी बोहत साहसी अउ क्रूर राजा होही हइ राजा बोहत मक्कार होही, असना ऊ टेम होही, जब पापिन के गिनती बढ जही। <verse eid="DAN 8:23" /><verse number="24" style="v" sid="DAN 8:24" />ऊ बोहत सक्तिसाली हुइ जही, पय अपन खुद के सक्ति लग नेहको, ऊ भयंकर बिनास करी, अउ जउन करी ओहमा जीत जही, ऊ उनही नास करी, जउन सक्तिसाली पवितर मनसे हबै। <verse eid="DAN 8:24" /><verse number="25" style="v" sid="DAN 8:25" />ऊ उन्नति करै के निता छल के परयोग करी, अउ ऊ अपन खुद के घमंडी हुइ के बिना चेताय मनसेन के नास करहीं, अउ राजकुमारन के राजकुमार के बिरुध्द ठाड होही, तउमा ऊ नास करे जही, पय कउनो मनसे के दवारा नेहको। <verse eid="DAN 8:25" /><verse number="26" style="v" sid="DAN 8:26" />सांझ अउ सुबेन्ने के बारे हे जउन कुछु तै देखे अउ सुने हबस, ऊ सही हबै, पय जउन कुछु तै सपना हे देखे हबस उके लुकाय के रख, काखे ऊ बोहत दिनन के बाद पूर हुइ जही।<verse eid="DAN 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="DAN 8:27" />तब मै दानिय्येल के बल जात रहै, अउ मै कुछ दिन तक नांगा हे पडे रहों, तब मै उठके राजा के काम-काज फेरै करे लगों, पय जउन कुछु मै देखे रथों, ओखर लग मै चकित रहों, काखे ओखर कउनो समझामैबाले नेहको रथै।<verse eid="DAN 8:27" /></para>
  <chapter eid="DAN 8" />
  <chapter number="9" style="c" sid="DAN 9" />
  <para style="s">दानिय्येल अपन मनसेन कर निता बिनती</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 9:1" />दारा मादी, जउन छयर्स<note caller="+" style="f"><char style="fr" closed="false">9:1 </char><char style="ft" closed="false">आहसवेरोस कर टोरवा</char></note> के टोरवा रथै, बेबीलोन राज हे राज करथै। <verse eid="DAN 9:1" /><verse number="2" style="v" sid="DAN 9:2" />दारा राजा के पहिले साल हे दानिय्येल कुछ किताब पढथै, उन किताब हे मै देखथों, कि भगवान इरमियाह नबी के हइ गुठे हबै, कि यरुसलेम के फेरै निरमाड केतका साल बाद होही, भगवान कहे रथै, एखर पहिले कि यरुसलेम फेरै बसै सत्तर साल गुजर जही।<note caller="+" style="x"><char style="xo" closed="false">9:2 </char><char style="xt" closed="false"><ref loc="JER 25:11">इरमि 25:11</ref>; <ref loc="JER 29:10">29:10</ref> </char></note> <verse eid="DAN 9:2" /><verse number="3" style="v" sid="DAN 9:3" />फेर मै अपन मालिक भगवान के पल्ला मुडो अउ ओखर लग बिनती करके मदत करेव, मै उपास अउ असना बन्डी पहिर लयों जेखर हइ लगै कि मै दुखी हबो, मै अपन मूंड हे राख डार लयों। <verse eid="DAN 9:3" /><verse number="4" style="v" sid="DAN 9:4" />मै अपन भगवान लग हइ बिनती करेव अउ अपन पाप के मानो,</para>
  <para style="p" vid="DAN 9:4">हे परभु तै महान अउ भययोग भगवान हबस, तै उनखर संग माया अउ दयालु के बचन के निभाथस, जउन मनसे तोर आदेस के मानथै, उनखर संग तै अपन बचन निभाथस।<verse eid="DAN 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 9:5" />पय हे भगवान हम पापी हवन, हम बुरा करे हवन, कुकरम करे हवन, बिदरोह करे हवन, तोर निस्पछ नियाव अउ तोर आदेस लग हम दुरिहां भटक गय हवन। <verse eid="DAN 9:5" /><verse number="6" style="v" sid="DAN 9:6" />हम तोर सेबक नबी, के संदेस के नेहको सुनेन, उन हमर राजा सासक अउ हमर सियान के अउ भुंइ के सगलू मनसे के तोर नाम लग संदेस सुनाय रथन। <verse eid="DAN 9:6" /><verse number="7" style="v" sid="DAN 9:7" />हे परभु तै नेक हबस, पय आज हम बोहत लजाय हवन, यहूदिया के मनसे यरुसलेम के रहैबाले अउ सगलू इस्राएलियन जउन लिघ्घो अउ दुरिहां हबै, हमर बिस्वासघात के कारन तै उनही सब देसन हे तितिर-बितिर कर दय हबै। <verse eid="DAN 9:7" /><verse number="8" style="v" sid="DAN 9:8" />हे यहोबा हम सब झन अउ राजा, मुखिया अउ सियानन समेत बिना सरमाय तोर बिरुध्द बेउहार अउ पाप करे हबन। <verse eid="DAN 9:8" /><verse number="9" style="v" sid="DAN 9:9" />हे यहोबा हम तोर परति बिदरोह करे हबन, तउमा सिबाय तहिन दयालु अउ छमा देय बाले हबस। <verse eid="DAN 9:9" /><verse number="10" style="v" sid="DAN 9:10" />हम हमर भगवान के बातन के नेहको माने हवन या उन नियम के पालन नेहको करे हवन, जेही उन अपन हरवाह आगू कर बात गुठे बालेन के दवारा हमके दय रथै। <verse eid="DAN 9:10" /><verse number="11" style="v" sid="DAN 9:11" />सगलू इस्राएली तोर नियम के उलंघन करे हबै, अउ तोर बात के मानै के बदले ओखर लग दुरिहां हट गय हबै, इहैनिता भगवान के हरवाह मूसा के नियम हे लिखे हर सराप ठहराय गइस, सजा हमर उप्पर उडेल दय गय हबै, काखे हम तोर बिरोध पाप करे हवन। <verse eid="DAN 9:11" /><verse number="12" style="v" sid="DAN 9:12" />तै हमर उप्पर बडी समस्या लायके हमर अउ हमर सासक के बिरुध्द गुठे गइस बचन के तै पूर करे हबस, बादर के तरी सगलू भुंइ हे असना समस्या अउ कहुं नेहको पडिस, जसना समस्या यरुसलेम हे पडे हबै। <verse eid="DAN 9:12" /><verse number="13" style="v" sid="DAN 9:13" />जसना कि मूसा के नियम हे लिखे हबै, हइ सगलू समस्या हमर हे आय पडे हबै, फेर हम अभिन्नो भगवान लग मदत नेहको मांगे हवन, हम अबे पाप करै के नेहको छांडे हवन, हे भगवान तोर सत्य हे हम धियान नेहको देथन। <verse eid="DAN 9:13" /><verse number="14" style="v" sid="DAN 9:14" />पय हे परभु तै हमर निता समस्या तइयार रखे हबस, अउ हमर हे डाल दय हबस, काखे तै जउन कुछ करथस ऊ नेक काम करथस, ओखर सगलू काम नियाव पूर होथै, हम ओखर आरो के सुने हवन, इहैनिता हमर हे हइ समस्या आइस।<verse eid="DAN 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 9:15" />हे हमर परभु भगवान आजो तोर सक्ति अबे तक बने हर हबै, अउ हम मिस्र लग बाहिर निकार लाइस, हे भगवान हम पाप करे हवन, हम दुस्टता करे हवन। <verse eid="DAN 9:15" /><verse number="16" style="v" sid="DAN 9:16" />हे परभु तै बीते टेम हे हमर सहायता करे, इहैनिता अब यरुसलेम लग आगू गुस्सा झइ होय, हइ तोर सहर हबै, तोर पवितर मन्दिर हबै, हमर पाप अउ हमर सियानन कर दवारा करे गय बुराई के कारन, परोसी देसन के सगलू मनसे यरुसलेम अउ तोर मनसेन के बेकार समझथै। <verse eid="DAN 9:16" /><verse number="17" style="v" sid="DAN 9:17" />हे हमर भगवान अपन हरवाह कर पराथना अउ गिडगिडाना के सुन, अपन मन्दिर कर जउन नास हुइ गय हबै, फेरै लग तइयार कर, ताकि सगलू मनसे जान सकै कि तहिन भगवान हबस। <verse eid="DAN 9:17" /><verse number="18" style="v" sid="DAN 9:18" />हे हमर भगवान मोर बिनती के तरफ कान लगाय के सुन अउ आंखी उघारके उजडे हर ऊ सहर के देख जउन तोर नाम लग जाने जथै, हम बोहत निक्खा काम करे हबन इहैनिता नेहको, पय तोर बडी दया हबै। <verse eid="DAN 9:18" /><verse number="19" style="v" sid="DAN 9:19" />हे परभु हमर सुन, हे परभु हमके छमा कर, हे परभु हमर हे धियान दे, अउ जउन करै के हबै ऊ कर, देरी झइ कर, ताकि सबझन जान सकै कि तहिन भगवान हबस, हइ सहर अउ हइ मनसे तोरेन हबै।<verse eid="DAN 9:19" /></para>
  <para style="s">जिब्राइल कर आगू कर बात समझै</para>
  <para style="p">
    <verse number="20" style="v" sid="DAN 9:20" />मै अपन पाप अउ अपन इस्राएली मनसेन के पाप के मानथै अउ बिनती करथै, अउ मोर भगवान के आगू ओखर पवितर मन्दिर के निता बिनती करथों। <verse eid="DAN 9:20" /><verse number="21" style="v" sid="DAN 9:21" />जब मै बिनती करत रथों, तब जिब्राएल जेही मै पहिलेन सपना हे देख चुके रथों, सांझ कर बलिदान कर टेम तेज रपतार लग मोर लिघ्घो आथै।<note caller="+" style="x"><char style="xo" closed="false">9:21 </char><char style="xt" closed="false"><ref loc="LUK 1:19">लूका 1:19</ref>; <ref loc="LUK 19:26">19:26</ref></char></note> <verse eid="DAN 9:21" /><verse number="22" style="v" sid="DAN 9:22" />ऊ ओखर लग कथै, हे दानिय्येल मै तोके आगू कर बातन कर समझ अउ दिमाक देय के निता आय हबो। <verse eid="DAN 9:22" /><verse number="23" style="v" sid="DAN 9:23" />जब तै भगवान लग बिनती करै के सुरु करे, तब ऊ जबाब दइस, ऊ तोर लग माया करथै इहैनिता मै हइ जबाब देय आय हबो, अब मै दरसन कर मतलब तोके गुठेथों, ता तै पूर धियान दे।<verse eid="DAN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="DAN 9:24" />भगवान तोर मनसेन अउ तोर पवितर सहर के पाप अउ बुराई लग छंडामै कर निता सात गुना अउ सत्तर साल कर टेम ठहराय हबै, पाप के छमा करे जही अउ हरमेसा कर नियाव ठहराही, ताकि दरसन आगू कर बात सही हुइ जाय अउ पवितर मन्दिर के फेरै उदघाटन करे जही। <verse eid="DAN 9:24" /><verse number="25" style="v" sid="DAN 9:25" />इहैनिता हइ जान अउ समझ लेया, यरुसलेम के फेर लग स्थापित अउ फेरै बनामै के निता चुने हर परधान<note caller="+" style="f"><char style="fr" closed="false">9:25 </char><char style="ft" closed="false">मसीह</char></note> मनसे सासक के आमै तक सात गुना अउ बासठ साल के बीतै लग, चउक अउ खाई सहित ऊ सहर कस्ट के टेम हे फेरै लग बनाय जही। <verse eid="DAN 9:25" /><verse number="26" style="v" sid="DAN 9:26" />सात गुना अउ बासठ साल कर बाद अक्ठी दूसर चुने हर परधान होही, जउन बेकसूर मारे जही अउ ओखर हाथ हे कुछु नेहको रही, ओखर सुपाही सहर अउ पवितर जिघा के खन्डर बनाय दय जही, ओखर आखरी बाढ कर जसना होही अउ आखरी तक युध्द होत रही, बिनास ठहराय जाय चुके हबै। <verse eid="DAN 9:26" /><verse number="27" style="v" sid="DAN 9:27" />ऊ परधान सात सालन कर निता बोहत मजबूत टीमा बांधही, पय आधा टेम के बीतै हे ऊ पसुबलि अउ आगबलि के बंद करहीं, अउ ऊ मन्दिर हे ऊंच जिघा हे उजाडबाले घ्रनित चीज ठहराही, जब तक ऊ रही, तब तक उहां रखै बाले ऊ आखरी के न देख ले, जउन भगवान ओखर निता रखे हबै।<verse eid="DAN 9:27" /></para>
  <chapter eid="DAN 9" />
  <chapter number="10" style="c" sid="DAN 10" />
  <para style="s">नदिया कर टाठा हे दानिय्येल कर दरसन</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 10:1" />कुस्रू फारस के राजा रथै, ओखर सासन काल के तीसर साल दानिय्येल जेखर दूसर नाम बेलतसस्सर रथै, हइ बात सच रथै, पय समझै हे बोहत कठिन हबै, ऊ बात अक्ठी दरसन हे उके समझाय गय रथै।<verse eid="DAN 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="DAN 10:2" />दानिय्येल कथै, ऊ टेम मै तीन हप्ता तक दुखी रहों। <verse eid="DAN 10:2" /><verse number="3" style="v" sid="DAN 10:3" />पूरा तीन हप्ता तक मै निक्खा खाना नेहको खायों, न मै गोस खायों, अउ न मै दारू पियों, मै तीन हप्ता तक देह हे तेल नेहको लगाइस।<verse eid="DAN 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 10:4" />फेर पहिले महिना के चउबीसमा रोज, जब मै महा नदिया, हिद्देकेल<note caller="+" style="f"><char style="fr" closed="false">10:4 </char><char style="ft" closed="false">टिगरिस</char></note> के टाठा हे ठाड रथों। <verse eid="DAN 10:4" /><verse number="5" style="v" sid="DAN 10:5" />तब मै देखों, कि उहां अक्ठी डउका के अपन आगू ठाड पायों, ऊ सन कर बन्डी पहिरे हर रथै, ओखर कनिहा हे ऊफाज देस कर सुध्द सोन कर बने हर कमरबांध रथै। <verse eid="DAN 10:5" /><verse number="6" style="v" sid="DAN 10:6" />ओखर देह चमकत पथरा कर जसना रथै, ओखर आंखी कर चमक बिजली कर जसना रथै, ओखर बाहीं अउ ओखर गोड चकमकात पीतर लग पालिस जसना झिलमिलात रहै, अउ ओखर आरो गरजै बाले बडका भीड कर जसना रथै।<note caller="+" style="x"><char style="xo" closed="false">10:6 </char><char style="xt" closed="false"><ref loc="REV 1:13-15">परकासितवाक्य 1:13-15</ref>; <ref loc="REV 2:18">2:18</ref>; <ref loc="REV 19:12">19:12</ref> </char></note><verse eid="DAN 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 10:7" />मोर संग कुछ मनसे रथै, उनके हइ दरसन दिखाई नेहको दइस, हइ दरसन सिबाय मै दानिय्येल देखों पय उन थरथराय लगिन, अउ लुकै कर निता भग गइन। <verse eid="DAN 10:7" /><verse number="8" style="v" sid="DAN 10:8" />मै अकेल्ले रहि गयों, अउ मै हइ बडा दरसन देखों, पय दरसन देखै के बाद मोर लग सक्ति जात रहिस, मोर सकल असना बदल गइस, कि मोके कउनो नेहको चीन सकिन। भय लग झुराय गइस, अउ मै ढिलवा हुइ गयों। <verse eid="DAN 10:8" /><verse number="9" style="v" sid="DAN 10:9" />फेर मै दरसन के ऊ मनसे के मै बात करत सुनो, मै बिहोस हुइके भुंइ हे गिर पडेव, अउ अउंधे हर मुंह कर बल पडे रहों। <verse eid="DAN 10:9" /><verse number="10" style="v" sid="DAN 10:10" />फेर अक्ठी हाथ मोके छी लइस, असना होय लग मै अपन हाथ अउ अपन घुटवा के बल ठाड हुइ गयों, मै डेर के मारे थरथर कांपत रहों।<verse eid="DAN 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 10:11" />तब ऊ मोर लग कथै, “हे दानिय्येल बोहत पिरिया मनसे हबस, उके समझ ले, अउ सीधा ठाढ हुइ जा, काखे मै अबे तोर लिघ्घो पठोय गय हव।” जब ऊ मोर लग हइ बचन कथै, तब मै ठाढ तो हुइ गयों पय थरथराउत रहों।<verse eid="DAN 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="DAN 10:12" />ऊ मोर लग कथै, दानिय्येल झइ डेरा, काखे तै दरसन के मतलब समझामै के मजबूत निस्चय करिस, अउ उपास के दवारा आत्मसुध्दि करके खुदय के भगवान के आगू बिनम्र बनाय हबस, ऊ रोज तोर बिनती के आरो भगवान सुन लइस, मै तोर बिनती के जबाब लइके इछो आय हबो। <verse eid="DAN 10:12" /><verse number="13" style="v" sid="DAN 10:13" />फारस देस कर दूत मोके इक्कीस रोज तक उलझाय रथै, मै नेहको आ पायों, तब मिकाइल अक्ठी खास स्वरगदूत हबै, जउन मोर मदत करै के निता आय हबै।<note caller="+" style="x"><char style="xo" closed="false">10:13 </char><char style="xt" closed="false"><ref loc="REV 12:7">परकासितवाक्य 12:7</ref></char></note> <verse eid="DAN 10:13" /><verse number="14" style="v" sid="DAN 10:14" />मै भभिस्य हे तोर मनसेन कर संग काहिन होंय बाले हबै, उके समझामै कर निता आय हबो, हइ दरसन भभिस्य कर बारे हे हबै।<verse eid="DAN 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 10:15" />जब ऊ मोर लग हइ बात गुठे चुकिस तब मै भुंइ के पल्ला मूंड झुकाय लयों, अउ चुप हुइ गयों। <verse eid="DAN 10:15" /><verse number="16" style="v" sid="DAN 10:16" />ऊ दरसन कर कारन मै कमजोर हुइ गयों, अउ थरथराय लगों तब अक्ठी मनसे के जसना दिखथै, मोर होंट के छीथै, अउ मै गुठे लगों, मै ओखर लग कथों, जउन मोर आगू ठाड रथै। <verse eid="DAN 10:16" /><verse number="17" style="v" sid="DAN 10:17" />हे मोर परभु के हइ हरवाह अपन परभु लग बात करै के हिम्मत कसके जुटाय सकथै? परभु मोर देह हे बल नेहको हबै, अउ मै बडी परेसानी लग सांस लइ पाथो।<verse eid="DAN 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 10:18" />ऊ जउन मनसे के जसना दिखाई देथै, मोके छी हबै, अउ बल दय हबै। <verse eid="DAN 10:18" /><verse number="19" style="v" sid="DAN 10:19" />ऊ कथै, “हे भगवान कर पिरिया डउका, झइ डेरा तै बोहत पिरिया मनसे हबस, तुमके सान्ति मिलै,”</para>
  <para style="p" vid="DAN 10:19">अब मजबूत रहा, “जब ऊ मोर लग बात करिस, तब मोके सक्ति मिलिस।”<verse eid="DAN 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="DAN 10:20" />दरसन कर बाद मोर थरथराना नेहको रुकिस, फारस राज कर रखबाला दूत एखर बाद जब मै जइहों, ता यूनान कर रखबाला दूत परगट होही। <verse eid="DAN 10:20" /><verse number="21" style="v" sid="DAN 10:21" />फेर जउन बात सत्य के किताब हे लिखे हर हबै, तोर हे परगट करथों, इस्राएल कर रखबाला दूत मिकाइल के छांडके अउ कउनो मोर मदत करैबाले नेहको हबै।<verse eid="DAN 10:21" /></para>
  <chapter eid="DAN 10" />
  <chapter number="11" style="c" sid="DAN 11" />
  <para style="p">
    <verse number="1" style="v" sid="DAN 11:1" />मादी राजा दारा के सासन काल के पहिले साल मीकाएल के फारस के बिरुध्द युध्द हे हिम्मत देय के अउ उके बल देय के निता ठाड हुइ गइस।<verse eid="DAN 11:1" /></para>
  <para style="s">मिस्र अउ सीरिया कर राज</para>
  <para style="p">
    <verse number="2" style="v" sid="DAN 11:2" />अब देख दानिय्येल मै तोके सत्य बात गुठेथों, देख, फारस हे तीन राजा के सासन अउ होही, एखर बाद अक्ठी चउथा राजा आही, हइ चउथा राजा अपन पहिले के फारस के दूसर राजा लग कहुं, अधिक धनड्ड होही, ऊ चउथा राजा सक्ति पामै के निता अपन डेरा के परयोग करी, ऊ हर कउनो के यूनान के बिरुध्द ठाढ हुइहिन।<verse eid="DAN 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="DAN 11:3" />एखर बाद अक्ठी बोहत अधिक सक्तिसाली राजा आही, ऊ बडी सक्ति के संग सासन करी, ऊ जउन चाही उहै करी। <verse eid="DAN 11:3" /><verse number="4" style="v" sid="DAN 11:4" />जब राज बोहत बडा हुइ जही, तब ऊ टूट जही अउ ओखर बटर जइहीं, अउ ओखर पीढी कर मनसे राज नेहको कर पइहिन।<verse eid="DAN 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 11:5" />मिस्र देस कर राजा सक्तिसाली हुइ जही, पय एखर बाद ओखर अक्ठी सेनापति ओखर लग अधिक सक्तिसाली हुइ जही, ऊ सेना नायक बडा राज हे सासन करहीं। <verse eid="DAN 11:5" /><verse number="6" style="v" sid="DAN 11:6" />कुछ सालन कर बाद मिस्र कर राजा सीरिया कर राजा आपस हे मिलहीं, अउ अपन टोरिया काज करै के निता दइ, पय हइ सबंध आपस हे जादा टेम तक नेहको बने रही। अउ टोरिया अउ ओखर डउका ओखर लरका अउ ओखर हरवाह जउन ओखर संग गय रथै, उनखर संग सब के मार दय जइहीं। <verse eid="DAN 11:6" /><verse number="7" style="v" sid="DAN 11:7" />सीरिया कर राजा आही एखर बाद टोरिया कर परवार के अक्ठी मनसे मिस्र देस कर राजा के जिघा के लेय के निता आही, ऊ सीरिया देस कर राजा के सेना हे हमला करी, ऊ राजा के सुद्रड किला हे परवेस करी, ऊ युध्द करी, अउ जीत जही। <verse eid="DAN 11:7" /><verse number="8" style="v" sid="DAN 11:8" />ऊ उनखर देउता के उनखर धातु के मूरती के अउ उनखर चांदी अउ सोना के कीमती बरतन के लइ लेही, अउ अपन संग मिस्र देस लइ जही, कुछ साल तक ऊ देस हे हमला नेहको होही। <verse eid="DAN 11:8" /><verse number="9" style="v" sid="DAN 11:9" />पय सीरिया देस के राजा ओखर हे हमला करी, पय ऊ अपन देस छो लउट जही।<verse eid="DAN 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="DAN 11:10" />सीरिया कर राजा कर टोरवो लडाई कर निता अक्ठी बडी सेना अकजिघा तइयार करहीं, जउन मेर नदिया कर बाढ आगू लइ जथै, ओसनेन बैरी कर किला तक लइ जही। <verse eid="DAN 11:10" /><verse number="11" style="v" sid="DAN 11:11" />तब मिस्र कर राजा गुस्सा हुइके आगू बढी अउ ऊ सीरिया कर राजा अक्ठी बडी सेना अकजिघा करी, पय ओखर सेना के बन्दी बनाय लइहीं। <verse eid="DAN 11:11" /><verse number="12" style="v" sid="DAN 11:12" />जब हइ बडी सेना के लइ ले जही, तब मिस्र कर राजा के हिरदय घमंड लग भर जही, अउ कइठे मनसेन के मरवाय डारी, पय हरमेसा लगातार जीत नेहको होही।<verse eid="DAN 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 11:13" />काखे सीरिया कर राजा अक्ठी दूसर सेना ठाड कर लइ, जउन ओखर पहिले के सेना लग बडी होही, अउ कइ साल के बाद ऊ पूर तइयारी के संग अक्ठी बडी सेना के लइके आगू बढी। <verse eid="DAN 11:13" /><verse number="14" style="v" sid="DAN 11:14" />उन रोज हे बोहत लग मनसे मिस्र कर राजा के बिरुध्द ठाड होही, तुम्हर अपन मनसेन के बीच जउन लडइया मनसे हबै, ऊ हइ दरसन के पूर बिरोध करहीं, पय उन सफल नेहको होही। <verse eid="DAN 11:14" /><verse number="15" style="v" sid="DAN 11:15" />फेर एखर बाद सीरिया कर राजा आही, अउ आयके सिपाही के घेरा डारी अउ अक्ठी किला बाले सहर हे कब्जा कर लइ, मिस्र कर सेना हे बिरोध करै के सक्ति नेहको होही, अउ उनखर सबले निक्खा सेना दल के लिघ्घो सामना के सक्ति नेहको होही। <verse eid="DAN 11:15" /><verse number="16" style="v" sid="DAN 11:16" />हमला करै बाले जसना चाही ओसनेन करी, कउनो ओखर आगू ठहर नेहको सकी, ऊ अपन खुद के ऊ टीमा करे हर सुन्दर देस हे स्थापित करी, अउ ओखर लिघ्घो नास करै के सक्ति होही।<verse eid="DAN 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 11:17" />ऊ अपन सगलू राज के सक्ति के संग आमै के ठान लइ, अउ मिस्र कर राजा के संग अक्ठी युध्द करी, अउ ओखर राज के जीतै के निता ऊ राजा के अपन अक्ठी टोरिया के काज हे देही, पय ओखर योजना सफल नेहको होही, ओखर लग कउनो मदत नेहको मिली। <verse eid="DAN 11:17" /><verse number="18" style="v" sid="DAN 11:18" />तब ऊ अपन धियान समुन्दर के टाठा हे लगाही, अउ उनखर मसे बोहत के अपन हक हे कर लेही, पय अक्ठी सेनापति ओखर घमंड के आखरी कर देही, अउ ओखर घमंड के जसना ओखर लग पलटा लेही। <verse eid="DAN 11:18" /><verse number="19" style="v" sid="DAN 11:19" />एखर बाद ऊ अपन देस के किला के पल्ला लउट जही, पय ऊ रडभडाय के गिरही, पय ओखर कहुं पता नेहको चलही।<verse eid="DAN 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="DAN 11:20" />एखर बाद अक्ठी अउ राजा आही, जउन अपन राज के धन डेरा बढामै कर निता, मनसेन हे ब्याज बसूली लगाय के अतियाचार करै के निता, अक्ठी अधिकारी पठोही, कुछ टेम हे राजा के मार दय जही, पय न भीड हे न लडाई हे।<verse eid="DAN 11:20" /></para>
  <para style="s">सीरिया देस के दुस्ट राजा</para>
  <para style="p">
    <verse number="21" style="v" sid="DAN 11:21" />ऊ जिघा हे अक्ठी बेकार मनसे ठाड होतै राजगद्दी हे बइठी, पय ओखर लायक नेहको रही, तउमा नर के बात गुठे के राज लइ। <verse eid="DAN 11:21" /><verse number="22" style="v" sid="DAN 11:22" />ऊ बडा सक्तिसाली सुपाही के हराय दइ, ऊ इके टीमा के परधान के नस्ट कर दय जही। <verse eid="DAN 11:22" /><verse number="23" style="v" sid="DAN 11:23" />ऊ परधान के संग एक समझउता होय के बाद ऊ नर देही, अउ सिबाय चुटु मनसेन के संग ऊ सक्तिसाली हुइ जही। <verse eid="DAN 11:23" /><verse number="24" style="v" sid="DAN 11:24" />जब ऊ धनी राज सुरक्छित महसूस करी, तबै ऊ उनखर हे हमला करी अउ असना सफल मिली, जसना न तो ओखर बाफ दादा अउ न ओखर सियान पाय रथै, ऊ लुटे अउ छंडाय गय चीजन अउ डेरा के अपन मनसेन के बीच हे बांट देही, ऊ किला के जीतै के निता जुगाड बनाही, पय चुटु टेम के निता।<verse eid="DAN 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 11:25" />ऊ मिस्र कर राजा के उप्पर हमला करै के निता अक हिम्मत कर संग मजबूत लग अक्ठी सेना ठाड करी, जउन अक्ठी बडा अउ सक्तिसाली सेना कर संग लडाई करै के निता तइयारी करहीं, पय मिस्र कर राजा धोखा खाय जही अउ जीत नेहको पाही। <verse eid="DAN 11:25" /><verse number="26" style="v" sid="DAN 11:26" />जउन राजा के दवारा दय गय हर भोजन के खाय करथै, उनै उके नस्ट करै के कोसिस करहीं, ओखर सुपाही के भगाय दय जही, अउ बोहत लग मनसे युध्द हे मारे जइहिन। <verse eid="DAN 11:26" /><verse number="27" style="v" sid="DAN 11:27" />दुनो राजा अपन मन हे बेकार बात रखके अक्ठिन टेबुल हे बइठहीं, अउ अक दूसर लग झूठ बोलही, जेखर लग कउनो फायदा नेहको होही, काखे ठहराय हर टेम हे आखरी आय जही। <verse eid="DAN 11:27" /><verse number="28" style="v" sid="DAN 11:28" />तब सीरिया देस कर राजा बोहत धन डेरा के संग अपन देस हे लउट जही, पय ओखर मन भगवान कर मनसेन के बिरुध्द लगे रही, ऊ अपन इक्छा कर जसना करी फेर ऊ अपन देस लउट जही।<verse eid="DAN 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="DAN 11:29" />निस्चित टेम हे ऊ फेरै लग दख्खिन देस हे हमला करी, पय हइ बेर के स्थिति पहिले के स्थिति लग अलगे होही। <verse eid="DAN 11:29" /><verse number="30" style="v" sid="DAN 11:30" />कित्ति मनसेन कर जिहाज आही अउ सीरिया कर राजा के बिरुध्द युध्द करी, ऊ उन जिहाज के आउत देखके डेराय जही, फेरै वापिस निरास हुइके लउटके पवितर टीमा हे ऊ अपन गुस्सा उतारी, ऊ लउट के जउन मनसे पवितर टीमा हे चलै के छांड दय रथै उनखर मदत करी। <verse eid="DAN 11:30" /><verse number="31" style="v" sid="DAN 11:31" />ओखर सेना दल भवन के किला के अपवितर करै के निता आगू अइहिन, अउ सबरोज चढामै बाले बलि बन्द कर दय जही, तब घिनाय बाले चीज के स्थापना करहीं। <verse eid="DAN 11:31" /><verse number="32" style="v" sid="DAN 11:32" />जउन मनसे नियाव के नेहको मनहिन उके ऊ मीठ-मीठ बातन लग बहकाय देही, पय जउन मनसे भगवान कर आदेस के मनहीं उनखर बिरोध करहीं, ऊ अपन यकीन हे मजबूत रही अउ सही काम करहीं। <verse eid="DAN 11:32" /><verse number="33" style="v" sid="DAN 11:33" />उन मसे कुछ समझदार अगुवा उनही दिमाक कर बात समझइहीं, पय अपन हइ काम के निता उनके सहीद होय के परी, उन तलबार लग मउत के घाट उतारे जही, उन बरत हर आगी हे फटके जइहीं, उन जेल हे डाले जइहीं अउ उनखर डेरा लूट लय जही, हइ कस्ट सिबाय चुटु रोज के निता होही। <verse eid="DAN 11:33" /><verse number="34" style="v" sid="DAN 11:34" />जब उन दुख हे पडहीं, सताव हे मारे जइहीं, तब उनखर मसे कुछ मनसे मदत मिलै लग बच जइहीं, पय उनखर चिकनी-चुपडी बातन कर बहकाव हे अइहीं अउ आय के उनखर हे मिल जइहीं। <verse eid="DAN 11:34" /><verse number="35" style="v" sid="DAN 11:35" />समझदार मसे कुछ अगुवा मार दय जइहीं, हइ इहैनिता होही कि कुछ ताडे जाय अउ सुध्द हुइ जाय, काखे आखरी ठहराय हर टेम हे होही।<verse eid="DAN 11:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="DAN 11:36" />सीरिया कर राजा जसना उके निक्खा लगही ओसनेन करी, ऊ अपन खुद के देउतन लग ऊंच अउ बडा करी, अउ देउतन के भगवान के बिरुध्द अनसुनी बात करी, ऊ तब तक सफल होत रही, जब तक कि गुस्सा कर टेम पूर नेहको हुइ जही, काखे जउन ठहराय गय हबै, ऊ जरूर पूर होही। <verse eid="DAN 11:36" /><verse number="37" style="v" sid="DAN 11:37" />अउ डउकिन के देउतन के नेहको मानी, इहां तक कि सगलू देउतन के नजर अन्दाज करहीं, काखे ऊ सोंचिस कि ऊ सबले बडा हव। <verse eid="DAN 11:37" /><verse number="38" style="v" sid="DAN 11:38" />उनखर बदला ऊ किला के अक्ठी देउता के इज्जत करी अक्ठी असना देउता जेखर लग ओखर पुरखन अनजान रथै, ऊ उस देउता के इज्जत करी अउ सोना, चांदी, कीमती रत्न उपहार चढाय के ओखर महिमा करी। <verse eid="DAN 11:38" /><verse number="39" style="v" sid="DAN 11:39" />ऊ अक्ठी बिदेसी देउता के मदत लग सबले सक्तिसाली किला हे हमला करी, अउ ऊ उनके बोहत इज्जत करी, जउन उके राजा स्वरूप स्बीकार करहीं, ऊ उनके बोहत लग मनसेन के उप्पर सासक नियुक्त करी, अउ उनही इनाम कर रूप हे जमीन के बांट देही।<verse eid="DAN 11:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="DAN 11:40" />आखरी टेम हे दख्खिन के राजा उके युध्द हे लगाय रखी, अउ उत्तर के राजा रथ घोडा अउ अक्ठी बडा पानी जिहाज के बेंडन के संग उनखर हे हमला करी अउ बाढ के पानी के जसना उनखर मसे होउत निकर जही। <verse eid="DAN 11:40" /><verse number="41" style="v" sid="DAN 11:41" />ऊ टीमा कर देस हे आही अउ हमला करी, बोहत लग देसन के अन्त हुइ जही, पय एदोम, मोआब अउ अम्मोनी के हरवाहन के ओखर हाथ लग बचाय जही। <verse eid="DAN 11:41" /><verse number="42" style="v" sid="DAN 11:42" />ऊ कइठे देसन हे दबोचै के निता अपन हिम्मत के बोहत सारे देसन तक फइलाही, अउ मिस्र देस ओखर हाथ लग नेहको बची। <verse eid="DAN 11:42" /><verse number="43" style="v" sid="DAN 11:43" />ऊ मिस्र देस के सोना-चांदी अउ दूसर कीमती चीजन के मालिक बन जही, लीबिया अउ कूसी<note caller="+" style="f"><char style="fr" closed="false">11:43 </char><char style="ft" closed="false">नील नदिया के इलाका उप्पर हिस्सा कर मनसे </char></note> देस के निबासी ओखर बस हे हुइ जइहीं। <verse eid="DAN 11:43" /><verse number="44" style="v" sid="DAN 11:44" />पय दिन उगती अउ उत्तर दिसा लग आमैबाले समाचार के सुनके ऊ बेचैन हुइ जही, अउ बोहत गुस्सा हुइके ऊ बोहत जन के नास करै अउ उनखर अस्तित्व मिटामै के निकर परी। <verse eid="DAN 11:44" /><verse number="45" style="v" sid="DAN 11:45" />ऊ अपन राजकीय तम्बू समुन्दर अउ टीमा के देस के डोंगर के बीच ठाड करी, फेर ऊ मर जही, अउ कउनो ओखर मदत करै नेहको आही।<verse eid="DAN 11:45" /></para>
  <chapter eid="DAN 11" />
  <chapter number="12" style="c" sid="DAN 12" />
  <para style="s">अन्त के टेम</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 12:1" />ऊ टेम मिकाइल नाम के अक्ठी खास परधान दूत आही, जउन तुम्हर मनसेन के मदत करी, तब असना समस्या के टेम आही, जसना गैर यहूदी के पइदा होय लग लइके अबे तक कबहुन नेहको होय होही, पय ऊ टेम तुम्हर मनसेन मसे हर मनसे बचाय जही, जेखर नाम भगवान कर किताब हे लिखे हर पाय जही।<note caller="+" style="x"><char style="xo" closed="false">12:1 </char><char style="xt" closed="false"><ref loc="MAT 24:21">मत्ती 24:21</ref>; <ref loc="MRK 13:19">मरकुस 13:19</ref>; <ref loc="REV 7:14">परकासितवाक्य 7:14</ref>; <ref loc="REV 12:7">12:7</ref> </char></note> <verse eid="DAN 12:1" /><verse number="2" style="v" sid="DAN 12:2" />मरे हर मनसेन के समूह जउन भुंइ हे गाडे गय हबै, उन जिन्दा हुइ जइहीं, बोहत मनसे सबरोज के जीवन कर निता अउ दूसर लज्जा अउ आखरी बेज्जति कर निता।<note caller="+" style="x"><char style="xo" closed="false">12:2 </char><char style="xt" closed="false"><ref loc="ISA 26:19">यसा 26:19</ref>; <ref loc="MAT 25:46">मत्ती 25:46</ref>; <ref loc="JHN 5:29">यूहन्ना 5:29</ref> </char></note> <verse eid="DAN 12:2" /><verse number="3" style="v" sid="DAN 12:3" />जउन हुसियार अगुवा हबै ऊ बादर के जसना उजियार के जसना चमकहीं, अउ जउन बोहत के नेकपन के पल्ला लइ जथै, उन तरइयां के जसना सबरोज चमकत रइहीं।<verse eid="DAN 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 12:4" />पय हे दानिय्येल, तै हइ किताब कर बचन हे मोहर लगाय के आखरी टेम तक लुकोय के रखे, बोहत मनसे पुंछही-तछहीं अउ खोजहिन एखर लग उनखर ग्यान बढ जइहिन।<note caller="+" style="x"><char style="xo" closed="false">12:4 </char><char style="xt" closed="false"><ref loc="REV 22:10">परकासितवाक्य 22:10</ref> </char></note><verse eid="DAN 12:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 12:5" />तब दानिय्येल देखथै, कि उहां दुइठे अउ मनसे ठाड रथै, अक्ठी नदिया के हइ ठाटा हे हबै, अक्ठी ऊ ठाटा हे। <verse eid="DAN 12:5" /><verse number="6" style="v" sid="DAN 12:6" />उनखर मसे अक्ठी मलमल कर बन्डी पहिरे हर ऊ मनसे लग कथै, जउन नदिया के पानी हे दूत ठाड रथै, ओखर लग पूंछथै, हइ चकित कर काम कब तक पूर होही, अउ केतका टेम लगही?<verse eid="DAN 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 12:7" />ऊ मनसे जउन मलमल कर बन्डी पहिरे रथै, ऊ अपन दहिना अउ टेटरा हाथ बादर के पल्ला उठाथै, अउ मै सुनो कि ऊ सबरोज जिन्दा रहै बाले के किरिया खायके हइ कथै, साढे तीन साल रही, जब भगवान कर मनसेन कर सताव खतम हुइ जही, तब हइ बात पूर होही। <note caller="+" style="x"><char style="xo" closed="false">12:7 </char><char style="xt" closed="false"><ref loc="REV 10:5">परकासितवाक्य 10:5</ref>; <ref loc="REV 12:14">12:14</ref> </char></note><verse eid="DAN 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 12:8" />मै हइ बात सुनथों पय नेहको समझो, इहैनिता मै पूंछो “हे मोर परभु हइ सब बातन के आखरी काहिन होही?”<verse eid="DAN 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="DAN 12:9" />ऊ जबाब देथै, हे दानिय्येल तै जा, काखे आखरी टेम आमै तक के निता हइ बातन हे मुहर लगाय के उनके बन्द कर दय गय हबै। <verse eid="DAN 12:9" /><verse number="10" style="v" sid="DAN 12:10" />बोहत लग मनसे सुध्द करे जइहीं, पय उन जउन दुस्ट हबै, उन बेकार करत रइहीं, दुस्ट इन बातन के नेहको समझ पइहीं, पय जउन हुसियार हबै उन समझहीं।<note caller="+" style="x"><char style="xo" closed="false">12:10 </char><char style="xt" closed="false"><ref loc="REV 22:11">परकासितवाक्य 22:11</ref> </char></note><verse eid="DAN 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 12:11" />जब ले सबरोज के बलि बन्द कर दय गइस, तब लग उजाडै बाले घिनाय चीज स्थापित कर दय गइस, तब लग बारा सव नब्बे दिनन के टेम होही।<note caller="+" style="x"><char style="xo" closed="false">12:11 </char><char style="xt" closed="false"><ref loc="DAN 9:27">दानि 9:27</ref>; <ref loc="DAN 11:31">11:31</ref>; <ref loc="MAT 24:15">मत्ती 24:15</ref>; <ref loc="MRK 13:14">मरकुस 13:14</ref> </char></note> <verse eid="DAN 12:11" /><verse number="12" style="v" sid="DAN 12:12" />धन्य हबै ऊ मनसे जउन धीर के संग अक हजार तीन सव पैंतिस रोज पूर करी।<verse eid="DAN 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 12:13" />हे दानिय्येल अब तै जा, अपन जीवन के आखरी टेम तक अपन गली हे चलत रह, अउ आखरी टेम हे तै मर जइहे, अउ आखरी कर दिनन हे तै अपन उपहार कर निता ठाड हुइहे।<verse eid="DAN 12:13" /></para>
  <chapter eid="DAN 12" />
</usx>