<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2CO" style="id">- Bhumiya Stantard Project</book>
  <para style="h">कुरि</para>
  <para style="toc3">2 कुरि</para>
  <para style="toc2">2 कुरि</para>
  <para style="toc1">2 कुरिन्थियन के निता पोलुस कर चिट्ठी</para>
  <para style="mt2">2 कुरिन्थियों के लिए पौलुस की चिट्ठी</para>
  <para style="mt1">2 कुरिन्थियन के निता पोलुस कर चिट्ठी</para>
  <para style="imt">परचा</para>
  <para style="ip">2 कुरिन्थियन के चेला पोलुस करीबन 55-56 अगल बगल मसीह के जनम <char style="xt"><ref loc="2CO 1:1">1:1</ref> </char>के बाद लिखे गय रथै। हइ हमर लिघ्घो दुइठे चिट्ठी मसे दूसर हबै जेही पोलुस कुरिन्थी के मंडली के लिखथै, दिमाक बालेन के माने के हबै कि पोलुस पहिले कुरिन्थियन के अक्ठी खास चिट्ठी लिखे रथै, हमर लिघ्घो हइ चिट्ठी के कउनो परति नेहको हबै, जेखर ऊ <char style="xt"><ref loc="2CO 2:3-4">2:3-4</ref></char> हे लिखवरे हबै। 2 कुरिन्थियन के लिखे जाय के सब लग जादा संभावना तबै रथै जब पोलुस मकिदुनिया हे रथै। <char style="xt"><ref loc="2CO 2:13">2:13</ref> </char></para>
  <para style="ip">2 कुरिन्थियन एखर मतलब अनोखा हबै कि हइ अक्ठी बोहत बेक्तिगत अउ भवनातमक चिट्ठी हबै। पोलुस कुरिन्थी मंडली के बारे हे तीतुस लग मिले निक्खा बात के बारे अपन खुसी बाटथै। हइ चिट्ठी हम नबा नियम के द्रस्टी कोन लग देय के बारे निक्खा सिक्छा पाथै, ऊ खंड हे जिहां पोलुस यरुसलेम के बिस्वासिन के मदद करै के निता पइसा अकजुट करै के निता सिक्छा देथै। <char style="xt"><ref loc="2CO 8-9">8—9</ref></char> असना लगथै कि मंडली के बाहिर लग कुछ ठगरा चेला मंडली हे कुछ मनसेन के बैरी के निस्तार पोलुस के खिलाप खुद के बढावा देय के निता करत रथै, ऊ पोलुस के हक हे संका करत रहै, जउन 2 कुरिन्थियों के आखरी हे यीसु मसीह के अक्ठी चेला के रूप हे अपन हक के मजबूत लग साबित करै के निता उके प्रेरित करथै।</para>
  <para style="iot">रूप रेखा</para>
  <para style="io1">1. पोलुस अपन चिट्ठी के सुरुवात मंडली के नमस्ते लग करिस। <char style="ior"><ref loc="2CO 1:1-7">1:1-7</ref></char></para>
  <para style="io1">2. दूसर पोलुस के यातरा योजनन हे अपन बदलाव अउ उनखर बारे हे मिले बात अउ अपन पिछले चट्ठी के परति उनखर सोच बिचार के बारे हे बात करथै। <char style="ior"><ref loc="2CO 1:8-7:16">1:8—7:16</ref> </char></para>
  <para style="io1">3. ओखर बाद पोलुस यरुसलेम हे बिस्वासिन के निता पइसा अकजुट करै के सबंध हे सिक्छा देथै। <char style="ior"><ref loc="2CO 8:1-9:15">8:1—9:15</ref></char></para>
  <para style="io1">4. आखरी हे पोलुस अपन प्रेरिताई के निता अक्ठी बचाव देथै अउ अपन अगले मुलाखात के बारे हे सचेत करथै। <char style="ior"><ref loc="2CO 10:1-13:10">10:1—13:10</ref></char></para>
  <chapter number="1" style="c" sid="2CO 1" />
  <para style="s">सोगत</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 1:1" />भगवान के इक्छा के दवारा यीसु मसीह के पोलुस चेला हबै, अउ भाई तीमुथियुस के पल्ला लग, जउन कुरिन्थुस सहर हे भगवान के मंडली अउ सगलू अखाया परदेस के सब पवितर मनसेन के नाम।<verse eid="2CO 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 1:2" />हमर बाफ भगवान अउ परभु यीसु मसीह के पल्ला लग तुमके दया अउ सान्ति मिलत रहै।<verse eid="2CO 1:2" /></para>
  <para style="s">पोलुस भगवान कर धन्यबाद करथै</para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 1:3" />हमर परभु यीसु मसीह के बाफ भगवान धन्य हबै, ऊ दया के मालिक हबै अउ मगन के सोरोत हबै। <verse eid="2CO 1:3" /><verse number="4" style="v" sid="2CO 1:4" />हमर हर परेसानी हे ऊ हमके सान्ति देथै, ताकि हमु हरमेर के परेसानी हे पडे मनसेन के ओसनेन सान्ति दइ सकि, जसना भगवान हमके सान्ति दय हबै। <verse eid="2CO 1:4" /><verse number="5" style="v" sid="2CO 1:5" />काखे जसना मसीह के दुखन हे सामिल हवन ओसनेन मसीह के दवारा हमर खुसी तुम्हर निता उमडथै। <verse eid="2CO 1:5" /><verse number="6" style="v" sid="2CO 1:6" />अगर हम दुख सहथन ता हइ तुम्हर सान्ति अउ मुकति के निता हबै, अगर हमके धीर मिले हबै ता हइ तुम्हर सान्ति के निता हबै, कि तुमो उन दुख के धीर के संग सहि सका, जउन हम सहथन। <verse eid="2CO 1:6" /><verse number="7" style="v" sid="2CO 1:7" />तुम्हर बारे हे हमही पूर आसा हबै, काखे हम जानथन कि जसना हमर कस्ट के तुम बांटथा ओसनेन हमर खुसी हे सहभागी हबन।<verse eid="2CO 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 1:8" />हे भाइयो हम तुम्हर लग हइ नेहको लुकामै चाहथन कि आसिया परदेस हे जउन कस्ट हमके सहै के पडे रहै ऊ हमर सहन सक्ति लग कही जादा रथै, इहां तक कि हम जीवन जिये के आसा छांड चुके रहन। <verse eid="2CO 1:8" /><verse number="9" style="v" sid="2CO 1:9" />हमके असना लगथै कि हमर उप्पर मिरतू के आदेस हुइ चुके हबै, ताकि हम अपन उप्पर भरोसा न रखी पय भगवान के उप्पर रखी, जउन मरे हर के फेरै जिन्दा कर देथै। <verse eid="2CO 1:9" /><verse number="10" style="v" sid="2CO 1:10" />भगवानो हमके मउत के बडा मुसीबत लग बचाइस, अउ ऊ असना ही करत रही, ओखरै उप्पर हमर हइ आसा हबै कि ऊ आय बाले टेम हे बचाही। <verse eid="2CO 1:10" /><verse number="11" style="v" sid="2CO 1:11" />काखे तुम अपन पराथना के दवारा हमर मदत करथा, कि हमर पल्ला लग कइनमेर के ऊ बरदान के निता धन्यबाद परगट करे जाय सकै, जउन कइनमेर के बिनतिन के दवारा हमके मिले हबै।<verse eid="2CO 1:11" /></para>
  <para style="s">पोलुस कर यातरा हे बदलाव होथै</para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 1:12" />हमके एखर गर्व हबै कि हम अपन मन के हइ गवाह हे घमंड करथन कि हम हइ दुनिया के संग अउ खास करके तुम्हर संग भगवान के अनुगरह किरपा के जसना बेउहार करे हबै, हम ऊ सरलता लग अउ सही के संग बेउहार करे हबै, जउन भगवान लग मिले हबै न कि दुनिया के दिमाक लग। <verse eid="2CO 1:12" /><verse number="13" style="v" sid="2CO 1:13" />हमर चिट्ठी हे असना कुछु नेहको होथै, जउन तुम पढ न सका अउ न समझ सका अउ मोर आसा हइ हबै कि तुम आखरी हे सगलू कुछु समझ लइहा। <verse eid="2CO 1:13" /><verse number="14" style="v" sid="2CO 1:14" />ठीक जउन मेर तुम हमके चुटु हस समझ पाय हबा कि तुम हमर गर्व के बिसय हबा, परभु यीसु के दिन हे तुमो हमर उप्पर गर्व करिहा।<verse eid="2CO 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2CO 1:15" />मोके एखर पूर बिस्वास हबै, इहैनिता मै तुम के दुइ बेर आत्मिक फायदा मिल सकै, इहैनिता तुम्हर लिघ्घो आमैका ठान लय रहों। <verse eid="2CO 1:15" /><verse number="16" style="v" sid="2CO 1:16" />मै सोचथो कि मकिदुनिया जात-जात तुम्हर लग मिलो अउ जब मकिदुनिया लग लउटो ता फेरै तुम्हर लिघ्घो जांव, अउ फेर तुम्हर दवारा यहूदिया के निता बिदा करे जांव। <verse eid="2CO 1:16" /><verse number="17" style="v" sid="2CO 1:17" />मै जब हइ योजना बनाय रथो, ता मोके कउनो संका नेहको रथै, या मै जउन योजना बनाथो ता का उके देह के तरीका लग बनाथो कि अक्ठी टेम हे “हां-हां” कहत रहों अउ “ना-ना” करत रहों? <verse eid="2CO 1:17" /><verse number="18" style="v" sid="2CO 1:18" />भगवान बिस्वास के काबिल हबै, अउ ऊ एखर गवाही देही, कि तुम्हर पल्ला हमर जउन बचन हबै अक संग “हां” अउ “ना” नेहको कथै। <verse eid="2CO 1:18" /><verse number="19" style="v" sid="2CO 1:19" />काखे तुम्हर बीच जउन भगवान कर टोरवा यीसु मसीह के हम यानी सिलवानुस, तीमुथियुस अउ मै परचार करे हव, ऊ “हां” अउ न दोनो अकै संग नेहको हबै, बलुक भगवान हे हरमेसा “हां” के बात करे गय हबै। <verse eid="2CO 1:19" /><verse number="20" style="v" sid="2CO 1:20" />भगवान के सगलू टीमा ओहमा “हां” हबै, इहैनिता हम भगवान कर महिमा के निता यीसु मसीह के दवारा “ओसनेन” कथन। <verse eid="2CO 1:20" /><verse number="21" style="v" sid="2CO 1:21" />भगवान, तुम्हर संग-संग, हमके मसीह हे मजबूत बनाय रखथै, अउ उहै अभिसेक मसीह हे हमर अभिसेक करथै। <verse eid="2CO 1:21" /><verse number="22" style="v" sid="2CO 1:22" />जउन हमर उप्पर अपन मालिक के छाप लगाइस अउ हमर भित्तर गवाही के रूप हे ऊ पवितर आतमा हमर मन हे दइस जउन हइ बात के साबूत हबै, कि जउन दे का बचन ऊ हमके दय हबै, उके ऊ हमके देही।<verse eid="2CO 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2CO 1:23" />मै भगवान के गवाह करके अपन जीवन के किरिया खायके कथो मै इहैनिता कुरिन्थुस सहर हे नेहको आय रथो कि मै तुमके कस्ट देयका नेहको चाहथो। <verse eid="2CO 1:23" /><verse number="24" style="v" sid="2CO 1:24" />एखर मतलब हइ नेहको कि हम तुम्हर बिस्वास हे अपन हक जमई, काखे तुम अपन बिस्वास हे अडे हबा, हम तुम्हर खुसी के निता तुम्हर संग-संग चले हम।<verse eid="2CO 1:24" /></para>
  <chapter eid="2CO 1" />
  <chapter number="2" style="c" sid="2CO 2" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 2:1" />इहैनिता मै ठान लयो कि तुमके फेरै दुख देय के निता तुम्हर लिघ्घो नेहको आहुं। <verse eid="2CO 2:1" /><verse number="2" style="v" sid="2CO 2:2" />काखे उहां आयके अगर मै तुमके दुख दो ता मोके उहां खुसी केखर लग मिलही, सिबाय उनखर लग जिनके मोर दवारा दुख पहुंचे हबै? <verse eid="2CO 2:2" /><verse number="3" style="v" sid="2CO 2:3" />इहै बात मै तुमके लिखे हव कि जब मै तुम्हर लिघ्घो आंव ता जिनखर लग मोके खुसी मिलै चाही, उनखर दवारा मोके दुख झइ पहुंचाय जाय, काखे तुम सबके उप्पर मोर बिस्वास रहे हबै, कि मोर खुसी हे तुम सबके खुसी होही। <verse eid="2CO 2:3" /><verse number="4" style="v" sid="2CO 2:4" />मै बडा दुख हे मन के गहरी दुख सहत अउ आंसू बोहाय-बोहाय के ऊ चिट्ठी लिखे रथो मै तुमके दुख देय के निता नेहको लिखे रथो, बलुक इहैनिता कि हइ जान जा कि मै तुम्हर लग केतका माया करथो।<verse eid="2CO 2:4" /></para>
  <para style="s">अपराधी के छमा</para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 2:5" />पय अगर कउ मोके दुख पहुंचाय हबै ता ऊ मोके नेहको बलुक कउनो न कउनो लग तुम सब के दुख पहुंचाय हबै। <verse eid="2CO 2:5" /><verse number="6" style="v" sid="2CO 2:6" />असना मनसे के तुम्हर समाज हे जउन सजा दय हबै ऊ बोहत हबै <verse eid="2CO 2:6" /><verse number="7" style="v" sid="2CO 2:7" />अब तुमके उके छमा अउ सान्ति देय चाही, कहुं असना झइ हो कि ऊ बोहत जादा दुख हे बुड जाय। <verse eid="2CO 2:7" /><verse number="8" style="v" sid="2CO 2:8" />इहैनिता तुम्हर लग मोर बिनती हबै कि तुम दुबारा ओखर परति अपन माया बढावा। <verse eid="2CO 2:8" /><verse number="9" style="v" sid="2CO 2:9" />हइ मै तुमके देखै के निता लिखो कि तुम परिक्छा हे पूर उतरथा, कि नेहको अउ सब बातन के मानथा कि नेहको। <verse eid="2CO 2:9" /><verse number="10" style="v" sid="2CO 2:10" />जेही तुम कउनो बारे हे छमा करथा उके महुं छमा करथो, जउन बारे हे मै छमा करे हव, अगर ऊ सही हे छमा के काबिल रथै ता उके मै मसीह के उपस्थिति समझ के तुम्हर निता छमा करे हव। <verse eid="2CO 2:10" /><verse number="11" style="v" sid="2CO 2:11" />ताकि हम भुतवा के ओखर फन्दा हे झइ फसी काखे ओखर चाल हम अच्छी तरह लग जानथन।<verse eid="2CO 2:11" /></para>
  <para style="s">तरोआस सहर हे पोलुस के असान्ति</para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 2:12" />जब मसीह के संदेस के परचार करै के निता मै तरोआस सहर छो आयों ता उहां मोर निता परभु के दूरा खुले हर रथै। <verse eid="2CO 2:12" /><verse number="13" style="v" sid="2CO 2:13" />उहां अपन भाई तीतुस के न पाय के मोर मन बोहत असान्ति हुइ गय, इहैनिता उनखर लग बिदा लइके मै मकिदुनिया परदेस छो कढ गयों। <verse eid="2CO 2:13" /><verse number="14" style="v" sid="2CO 2:14" />भगवान के धन्यबाद होय जउन हमके लगेतार मसीह के जीत यातरा हे लइ चलथै, अउ हमर दवारा अपन नाम के ग्यान सुगन्ध हर जिघा फइलाउत जथन। <verse eid="2CO 2:14" /><verse number="15" style="v" sid="2CO 2:15" />काखे मनसे चाहे मुकति पाथै या नास होथै, हम उनखर बीच भगवान के निता मसीह के मधुर सुगन्ध हबन। <verse eid="2CO 2:15" /><verse number="16" style="v" sid="2CO 2:16" />पय उनखर निता जउन बिनास के रास्ता हे हबै हइ मिरतू असना दुरगन्ध हबै, जउन मिरतू कि पल्ला लइ जथै, पय उनखर निता जउन मुकति के रास्ता हे चलथै, हइ जीवन के असना सुगन्ध हबै, जउन जीवन के पल्ला खींचथै, पय हइ काम के निता काबिल कोन हबै? <verse eid="2CO 2:16" /><verse number="17" style="v" sid="2CO 2:17" />भगवान के बचन के अपन फायदा के निता ओहमा मिलाबट करके बेचै बाले बोहत दूसर मनसे जसना हम नेहको हबन, हम तो भगवान के आगू भगवान के पल्ला लग पठोय हर मनसे के जसना मसीह हे मजबूत हुइके सच्चाई के संग बोलथन।<verse eid="2CO 2:17" /></para>
  <chapter eid="2CO 2" />
  <chapter number="3" style="c" sid="2CO 3" />
  <para style="s">नबा टीमा के हरवाह</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 3:1" />का हम फेर अपन बडाई करै लागथै? या हमके आने मनसेन के जसना हइ हमर निता जरूरी हबै कि हम तुमके सिफारिस के चिट्ठी देखइ अउ तोर लग मांगी? <verse eid="2CO 3:1" /><verse number="2" style="v" sid="2CO 3:2" />हमर चिट्ठी तुम खुदय हबा, हमर हिरदय हे लिखररे हर जउन सबके दवारा चीन्हे अउ पढे जाय सकथै। <verse eid="2CO 3:2" /><verse number="3" style="v" sid="2CO 3:3" />अउ तुमो असना दिखाथा जसना तुम मसीह के चिट्ठी हबा, जउन हमर सेबा दवारा लिखवाय हबै, जेही सियाही लग नेहको बलुक जिन्दा भगवान के आतमा लग लिखे गय हबै, जेही पथरा के पटिया हे नेहको, बलुक मनसे के हिरदय के पटिया हे लिखररे हबै।<verse eid="2CO 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2CO 3:4" />हम मसीह के कारन भगवान के आगू असना दाबा करैका भरोसा हबै। <verse eid="2CO 3:4" /><verse number="5" style="v" sid="2CO 3:5" />असना नेहको हबै कि हम खुद हे एतका सक्ति हबै, जउन सोचै लगे हबै, कि हम खुद लग कुछ के सकथन बलुक हमके सक्ति भगवान लग मिले हबै। <verse eid="2CO 3:5" /><verse number="6" style="v" sid="2CO 3:6" />उहै हमके नबा टीमा के काम करै के काबिल बनाइस, हइ सब्द के सेबक नेहको, पय आतमा के हबै, लिखररे हर नियम मिरतू के जनम देथै, पय आतमा जीवन देथै।<verse eid="2CO 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 3:7" />सेबा के काम अगर पथरा के पटिया हे खोदे गय अक्छर हे लिखररे हर मिरतू के टीमा एतका उजियार रथै, कि इस्राएल के मनसे मूसा कर नजर लग अकजाइ नेहको देख सकिन, अउ हइ उजियार धीरे-धीरे कम होउत जात रथै। <verse eid="2CO 3:7" /><verse number="8" style="v" sid="2CO 3:8" />फेर आतमा लग टीमा सेबा अउ बोहत उजियार काखे नेहको होही। <verse eid="2CO 3:8" /><verse number="9" style="v" sid="2CO 3:9" />अउ फेर जब दोसी ठहराय बाले सेबा हे एतका उजियार हबै, ता ऊ सेबा हे केतका उजियार होही, जउन धरमी ठहराय बाले सेबा हबै। <verse eid="2CO 3:9" /><verse number="10" style="v" sid="2CO 3:10" />काखे जउन पहिले उजियार लग भरपूर रथै, ऊ अब ऊ उजियार के आगू जउन ओखर लग कहुं जादा उजियार हबै, ऊ उजियार रहित हुइ गय हबै। <verse eid="2CO 3:10" /><verse number="11" style="v" sid="2CO 3:11" />अगर ओखर उजियार असना रथै, जउन लगेतार कम होउत रथै, ता ओखर उजियार, जउन हरमेसा स्थिर हबै, अउ केतका जादा उजियार होही।<verse eid="2CO 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 3:12" />इहै आसा के कारन हमर बात बगैर डर के हबै। <verse eid="2CO 3:12" /><verse number="13" style="v" sid="2CO 3:13" />हम मूसा कर जसना नेहको हवन, जउन अपन मुंह हे परदा डाले रथै कि इस्राएल के मनसे ऊ धीरे-धीरे कम होउत उजियार के झइ देख पामै। <verse eid="2CO 3:13" /><verse number="14" style="v" sid="2CO 3:14" />सही हे इस्राएल के मनसे के दिमाक बंद हुइ गय रथै, काखे आज तक पुरान नियम देय के मउका हे उहै परदा पडे रथै, काखे हइ परदा सिबाय मसीह के दवारा हटाय जथै। <verse eid="2CO 3:14" /><verse number="15" style="v" sid="2CO 3:15" />आज तक जब-जब मूसा कर किताब पढे जथै ता पढै बालेन के मन हे परदा पडे रथै। <verse eid="2CO 3:15" /><verse number="16" style="v" sid="2CO 3:16" />पय जब कउनो के हिरदय परभु के पल्ला मुडथै ता ऊ परदा हटाय दय जथै। <verse eid="2CO 3:16" /><verse number="17" style="v" sid="2CO 3:17" />हइ परभु ऊ आतमा हबै अउ जिहां कहुं परभु के आतमा मउजूद हबै उहां छुटकारा हबै। <verse eid="2CO 3:17" /><verse number="18" style="v" sid="2CO 3:18" />अउ जिहां तक हम सबके सबाल हबै, हमर छाप हे परदा नेहको हबै अउ हम सब अइना के मेर परभु के उजियार के धियान करथन हइ मेर हम धीरे-धीरे परभु के उजियार हे बढथन हइ उजियार परभु लग मिलथै, मतलब आतमा लग।<verse eid="2CO 3:18" /></para>
  <chapter eid="2CO 3" />
  <chapter number="4" style="c" sid="2CO 4" />
  <para style="s">माटी के बरतन हे डेरा</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 4:1" />इहैनिता कि हइ सेबा काम हमके भगवान के दया लग मिले हबै, इहैनिता हम कबहुन हार नेहको मानथन। <verse eid="2CO 4:1" /><verse number="2" style="v" sid="2CO 4:2" />हम लजाय बाले काम के छांड दय हबन, अउ न हम ईस करथन अउ न ही भगवान के बचन के मिलावट करथन बलुक सही के सरल रूप हे परगट करके भगवान के आगू खुद के हर अक्ठी कर मन के निता परगट करथन। <verse eid="2CO 4:2" /><verse number="3" style="v" sid="2CO 4:3" />जउन संदेस के हम परचार करथन ओखर उप्पर अगर कउनो परदा पडे हबै, ता हइ केबल उनखर निता पडे हबै, जउन बिनास रास्ता हे चलथै। <verse eid="2CO 4:3" /><verse number="4" style="v" sid="2CO 4:4" />हइ दुनिया के भगवान उन अबिस्वासिन के दिमाक के अंधियार हे डाल दय हबै, कि ऊ भगवान के परति छाप हे मसीह के महिमा के संदेस लग अलगे रहै उजियार के झइ देख पामै। <verse eid="2CO 4:4" /><verse number="5" style="v" sid="2CO 4:5" />हम खुदय अपन परचार नेहको करथन बलुक परभु के रूप हे यीसु मसीह के सिक्छा देथन, अउ अपन बारे हे हइ कथन कि हम यीसु के नाते हम तुम्हर हरवाह हबन। <verse eid="2CO 4:5" /><verse number="6" style="v" sid="2CO 4:6" />भगवान आदेस दय रथै कि “अंधियार हे उजियार हुइ जाय।” उजियार चमकै उहै भगवान हबै जिनही हमर हिरदय चमकाय दइस कि हम यीसु मसीह के उजियार हे चमकत हर भगवान के महिमा के ग्यान परदान करी।<verse eid="2CO 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 4:7" />पय हम जसना माटी के भडवा हे हइ डेरा इहैनिता रखे गय हबै कि हइ साफ हुइ कि हइ आसीम सक्ति हमर नेहको पय भगवान के हबै। <verse eid="2CO 4:7" /><verse number="8" style="v" sid="2CO 4:8" />हम हर टेम हर कउनो मेर लग कठिन दबाव हे जीथन पय हम कुचरे नेहको गय हबन, पय हम घबराय हवन अउ निरास नेहको हबन। <verse eid="2CO 4:8" /><verse number="9" style="v" sid="2CO 4:9" />हमार उप्पर अन्याय करे जथै, पय हम छांडे नेहको गय हवन हम झुकाय दय गय हवन पय नास नेहको होय हवन। <verse eid="2CO 4:9" /><verse number="10" style="v" sid="2CO 4:10" />हम हर टेम यीसु मसीह के मिरतू के अपन देह हे लय फिरथन कि मसीह यीसु के जीवन हमर देह हे परगट हुइ जाय। <verse eid="2CO 4:10" /><verse number="11" style="v" sid="2CO 4:11" />हम जिन्दा रहत भरमा यीसु के कारन लगेतार मिरतू के सामना करै का पडथै, जेखर लग यीसु के जीवन हमर नास होय बाले देह हे सही रूप लग परगट हुइ जाय। <verse eid="2CO 4:11" /><verse number="12" style="v" sid="2CO 4:12" />हइ मेर मिरतू ता हमर उप्पर परभाव डालथै अउ जीवन तुम्हर हे।<verse eid="2CO 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 4:13" />किताब हे लिखररे हर हबै, “मै बिस्वास करे रथो इहैनिता बोलथो।” हमारो भित्तर बिस्वास के उहै आतमा हबै, अउ हमु बिस्वास करथन इहैनिता हमु बोलथन। <verse eid="2CO 4:13" /><verse number="14" style="v" sid="2CO 4:14" />हम जानथन कि जउन परभु यीसु के फेरै लग जिन्दा करिस, उहै यीसु के संग हमु के फेरै जिन्दा करही, अउ तुम्हर संग हमु के अपन लिघ्घो रख लेही। <verse eid="2CO 4:14" /><verse number="15" style="v" sid="2CO 4:15" />हइ सगलू बात तुम्हर निता करे जथै, ताकि जादा लग जादा मनसेन हे फइलत भगवान के अनुगरह भगवान के महिमा धन्यबाद के बिनती करै बाले के संख्या बढत जाय।<verse eid="2CO 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 4:16" />इहै कारन हबै कि हम हिम्मत नेहको हारथन हमर देह के सक्ति भले ही कमजोर होउत जाय, पय हमर आतमा लगेतार दिन रात नबा होत जथै। <verse eid="2CO 4:16" /><verse number="17" style="v" sid="2CO 4:17" />हमर हइ नान हस दुख हमर निता असना सबरोज अउ जादा लग जादा महिमा के पइदा करथै, जेखर हम बरोबरी नेहको के सकथन। <verse eid="2CO 4:17" /><verse number="18" style="v" sid="2CO 4:18" />काखे हम अपन धियान ओखर उप्पर नेहको करी, जउन दिखथै पय ओखर उप्पर जउन नेहको दिखथै, जउन कुछ दिखथै ऊ चुटु हस टेम के निता हबै पय जउन नेहको दिखथै ऊ सबरोज के निता हबै।<verse eid="2CO 4:18" /></para>
  <chapter eid="2CO 4" />
  <chapter number="5" style="c" sid="2CO 5" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 5:1" />हमके हइ पता हबै कि जब हमार घर हमार सारीरिक जीव के गिराय दय जही ता हमर निता भगवान के पल्ला लग अक्ठी असना घर जुगाड करे गय हबै, जउन मनसे के हाथ लग बनाय हर नेहको पय स्वरग अउ हरमेसा के निता हबै। <verse eid="2CO 5:1" /><verse number="2" style="v" sid="2CO 5:2" />इहैनिता हम जब तक हइ घर हे हबन, हम रोउत रथन अउ इहै चाहत रथन कि अपन स्वरग घर हे जाय सकि। <verse eid="2CO 5:2" /><verse number="3" style="v" sid="2CO 5:3" />काखे ओही पहिरै के बाद हम बिना कपडा के नेहको रह जउबे। <verse eid="2CO 5:3" /><verse number="4" style="v" sid="2CO 5:4" />सही हइ हबै कि ई घर हे रहत भरमा हम भार हे दबे हर दुख हे रथन, काखे हम चाहथन कि हम बिना कपडा के नेहको रही, पय कपडा पहिरी कि जउन कुछ सारीरिक हबै ऊ जीवन के निरवाह बन जाय। <verse eid="2CO 5:4" /><verse number="5" style="v" sid="2CO 5:5" />जउन हमके हइ उदेस्य के निता तइयार करे हबै ऊ भगवान हबै, जिनही अपन आतमा हमके गवाही के रूप हे दइ दय हबै।<verse eid="2CO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 5:6" />इहैनिता हम हरमेसा भगवान के उप्पर भरोसा रखथन, हम हइ जानथन कि हम जब तक हइ देह हे हबै, तब तक हम परभु लग दुरिहां परदेस हे निबास करथन। <verse eid="2CO 5:6" /><verse number="7" style="v" sid="2CO 5:7" />काखे हम सकल के देखके नेहको पय बिस्वास लग चलथन। <verse eid="2CO 5:7" /><verse number="8" style="v" sid="2CO 5:8" />हमके भगवान के उप्पर पूर बिस्वास हबै, हम देह के घर छांडके परभु के इहां जाय का जादा पसंद करथन। <verse eid="2CO 5:8" /><verse number="9" style="v" sid="2CO 5:9" />इहैनिता हम चाहे घर हे रही, चाहे परदेस हे, हमर अकठिन इक्छा हबै, कि हम परभु के निक्खा लगी। <verse eid="2CO 5:9" /><verse number="10" style="v" sid="2CO 5:10" />काखे हइ जरूरी हबै कि हम सब मसीह के राजगद्दी न्याय के आगू ठाढ होय के पडही, कि हर अक्ठी के सरीर देह हे करे गय बेकार, निक्खा, के जसना फडुहा मिलही।<verse eid="2CO 5:10" /></para>
  <para style="s">भगवान लग मेल-जोल के सेबकाई</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 5:11" />इहैनिता परभु लग डरत हम सही के स्वीकार करै के निता मनसेन के समझाथन, हमर अउ भगवान के बीच कउनो परदा नेहको हबै, अउ मोके आसा हबै, कि तुमो हमके पूरी तरह लग जानथा। <verse eid="2CO 5:11" /><verse number="12" style="v" sid="2CO 5:12" />हइ तुम्हर आगू अपन बडाई नेहको पय हइ तुम्हर निता अक्ठी असना मउका हबै कि तुम हमर उप्पर गर्व करा कि तुम उनके एखर जबाब दइ सका, जउन अपन मन के बजाय बाहिर रूप लग घमंड करथन। <verse eid="2CO 5:12" /><verse number="13" style="v" sid="2CO 5:13" />काखे अगर हम दीबाना हबन ता भगवान के निता हबै अउ अगर कोमर हबन ता ऊ तुम्हर निता हबै। <verse eid="2CO 5:13" /><verse number="14" style="v" sid="2CO 5:14" />काखे मसीह के माया हमके सिखाथै, हम तो हइ समझ गय हबन कि जब अक्ठी सब झन कर निता मर गइस, तब सगलू मर गय हबै। <verse eid="2CO 5:14" /><verse number="15" style="v" sid="2CO 5:15" />अउ ऊ सब मनसे के निता मरिस काखे जउन मनसे जिन्दा हबै, ऊ अब आगू बस अपन निता जियत रहै, बलुक ओखर निता जिया जउन मरे के बाद फेरै जिन्दा के दय गय हबै।<verse eid="2CO 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 5:16" />इहैनिता हम सब लग कउनो के देह के नजर लग नेहको देखथै, हम मसीह के पहिले देह के नजर लग देखन, पय अब हम असना नेहको करथन। <verse eid="2CO 5:16" /><verse number="17" style="v" sid="2CO 5:17" />एखर मतलब हइ हबै कि अगर कउ मसीह के संग अक हुइ गय हबै, ता ऊ नबा दुनिया बन गइस, पुरान बात समापत हुइ गय हबै, अउ अब नबा बात आय गय हबै। <verse eid="2CO 5:17" /><verse number="18" style="v" sid="2CO 5:18" />हइ सब भगवान के पल्ला लग हबै, जिनही मसीह के दवारा खुद लग हमर मेल जोल करिस अउ हम मेल जोल के सेबा सउपे हबै। <verse eid="2CO 5:18" /><verse number="19" style="v" sid="2CO 5:19" />हमर संदेस हबै कि भगवान मनसे के पाप के अनदेखा करत मसीह के दवारा उनके अपन हे दुनिया के मेल करा लय हबै अउ उहै मनसेन के भगवान लग मिलामै के संदेस हमके सउपे हबै।<verse eid="2CO 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2CO 5:20" />इहैनिता हम मसीह के राजदूत हबन, भगवान हमर दवारा तुम्हर लग बिनती करथन, मसीह के पल्ला लग तुम्हर लग हमर बिनती हबै, भगवान लग मेल जोल के लेया। <verse eid="2CO 5:20" /><verse number="21" style="v" sid="2CO 5:21" />ऊ जउन पाप नेहको करे रथै, उके भगवान हमर निता पाप बनाय दइस कि हम उन हे भगवान के निता धरमी मनसे बन जइ।<verse eid="2CO 5:21" /></para>
  <chapter eid="2CO 5" />
  <chapter number="6" style="c" sid="2CO 6" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 6:1" />भगवान के काम हे संग-संग काम करै निता हम तुम्हर लग बिनती करथन कि भगवान के जउन अनुगरह किरपा तुमके मिले हबै, उके बेकार झइ जाय देया। <verse eid="2CO 6:1" /><verse number="2" style="v" sid="2CO 6:2" />काखे ऊ कथै,</para>
  <para style="q1" vid="2CO 6:2">“मै सही टेम हे तोर बिनती सुन लयो,</para>
  <para style="q2" vid="2CO 6:2">अउ मै मुकति के रोज तोके सहारा दे आयों।”</para>
  <para style="q1" vid="2CO 6:2">देख, सही टेम इहै हबै,</para>
  <para style="q2" vid="2CO 6:2">देख मुकति के दिन इहै हबै।<verse eid="2CO 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 6:3" />हम कउनो बात हे चोट खाय का कउनो मउका नेहको देथन ताकि हमर सेबा हे कउनो दोस झइ आय। <verse eid="2CO 6:3" /><verse number="4" style="v" sid="2CO 6:4" />पय हर बात लग भगवान के सेबक के जसना अपन निक्खा बेउहार के परगट करथन, अउ बडा धीर लग, दुख लग, घिनहन लग, पीरा लग सहथन। <verse eid="2CO 6:4" /><verse number="5" style="v" sid="2CO 6:5" />हम कोडा लग मार खायन, जेल हे डाले गयन, हमर उप्पर भीड उत्पात करिन, हम बोहत जादा मेहनत करन, हम दिन-रात जगन अउ उपास रहन। <verse eid="2CO 6:5" /><verse number="6" style="v" sid="2CO 6:6" />पवितर लग, ग्यान लग, धीर लग, किरपा लग, पवितर आतमा के काम निस्कपट माया, <verse eid="2CO 6:6" /><verse number="7" style="v" sid="2CO 6:7" />अपन सही संदेस अउ भगवान के सक्ति लग धरमी के अपन दहिना-टेटरा हाथ हे ढाल के रूप हे लइके, <verse eid="2CO 6:7" /><verse number="8" style="v" sid="2CO 6:8" />इज्जत अउ निरादर, महिमा अउ बुराई हइ सब हमके मिले हबै, हम ढोंगी समझे गयन, पय हम सही बोलथन। <verse eid="2CO 6:8" /><verse number="9" style="v" sid="2CO 6:9" />हम बेकार समझे जथन फिर भी परसिध्द हबन, हम मरे हर समझे जथन, पय देखा हम जिन्दा हबन, हमके सजा दय जथै, पय हमर जान नेहको लय जा सकही। <verse eid="2CO 6:9" /><verse number="10" style="v" sid="2CO 6:10" />हम दुखी हबन, फिर भी हम हर टेम खुसी हबन, हम गरीब हबन, पय हम बोहत मनसे के धन्नड बनाथन, हमर लिघ्घो कुछु नेहको हबै, फिर भी सब कुछ हमर हबै।<verse eid="2CO 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 6:11" />हे कुरिन्थियन के मनसे, हम खुलके तुम्हर लग बात करे हबन, हमार हिरदय तुम्हर निता खोल के रख दय हबन। <verse eid="2CO 6:11" /><verse number="12" style="v" sid="2CO 6:12" />हम तुम्हर उप्पर कउनो रोक टोक नेहको लगायन, रोक टोक तुमै खुद अपन मन हे लगाय हबा। <verse eid="2CO 6:12" /><verse number="13" style="v" sid="2CO 6:13" />तुमके अपन लरका समझ के मै कथो, कि बदला हे अपन मन तुमके हमर निता पूरी तरह खुले रखै चाही।<verse eid="2CO 6:13" /></para>
  <para style="s">जिन्दा भगवान के मंडली</para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 6:14" />अबिस्वासी के संग संगति झइ करा, काखे नियाइपन धरमी अउ अधरम के भला कइसन मेल जोल हबै? या उजियार अउ अंधियार हे भला संगी कइसन हुइ सकथै? <verse eid="2CO 6:14" /><verse number="15" style="v" sid="2CO 6:15" />ओसनेन मसीह भुतवा लग कइसन मेल जोल? अउ अबिस्वासी के संग बिस्वासी के कइसन मेल जोल? <verse eid="2CO 6:15" /><verse number="16" style="v" sid="2CO 6:16" />भगवान के मन्दिर का मूरती लग का रिस्ता? काखे हम खुद ऊ जिन्दा भगवान के मन्दिर हबन,</para>
  <para style="q1" vid="2CO 6:16">जसना कि भगवान कथै, “मै उनखर भित्तर निबास करिहों,</para>
  <para style="q2" vid="2CO 6:16">चलिहों फिरिहों,</para>
  <para style="q1" vid="2CO 6:16">मै उनखर भगवान हुइहों,</para>
  <para style="q2" vid="2CO 6:16">अउ ऊ मोर मनसे बनहिन।”<verse eid="2CO 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2CO 6:17" />इहैनिता परभु कथै,</para>
  <para style="q1" vid="2CO 6:17">“तुम उनखर बीच लग बाहिर निकडा,</para>
  <para style="q2" vid="2CO 6:17">उनखर खुद के अलगे के लेया,</para>
  <para style="q1" vid="2CO 6:17">अब तुम कबहुन कुछु चीज के झइ छुइहा,</para>
  <para style="q2" vid="2CO 6:17">जउन असुध्द हबै, तब मै तुमके अपनइहों।”<verse eid="2CO 6:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="2CO 6:18" />“अउ मै तुम्हर बाफ बनिहों,</para>
  <para style="q2" vid="2CO 6:18">तुम मोर टोरवा अउ टोरिया हुइहा,</para>
  <para style="q2" vid="2CO 6:18">सर्वसक्तिमान परभु इहै कथै।”<verse eid="2CO 6:18" /></para>
  <chapter eid="2CO 6" />
  <chapter number="7" style="c" sid="2CO 7" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 7:1" />इहैनिता हे पिरिया भाई अउ बेहन, जब हमर लग हइ टीमा करे गय हबै ता हम भगवान के परति डर के कारन, खुद के देह अउ आतमा के हर अक्ठी पवितर के सुध्द करके अपन बाहरी अउ भीतरी सगलू गुनाह के धोय डारे हबै।<verse eid="2CO 7:1" /></para>
  <para style="s">मंडली के छमा हे पोलुस के मगन</para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 7:2" />हमके अपन हिरदय हे जिघा देया, हम कउनो के कुछ बिगाडे नेहको हबन, अउ न कउनो के दुख पहुंचाय हबन, हम कउनो के संग छल नेहको करे हबन। <verse eid="2CO 7:2" /><verse number="3" style="v" sid="2CO 7:3" />हइ कहै के दवारा हम तुम्हर उप्पर दोस नेहको लगाउत हबन, मै पहिले कह चुके हबन कि तुम हमर हिरदय हे बसे हबा अउ हमर तुम्हर जीवन मरन के संग हबै। <verse eid="2CO 7:3" /><verse number="4" style="v" sid="2CO 7:4" />मोके तुम्हर उप्पर पूर बिस्वास हबै, मोके तुम्हर उप्पर गर्व हबै, मै बोहत खुस हव, सगलू दुखो हे आनन्द लग भरपूर रथो।<verse eid="2CO 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 7:5" />जब हम मकिदुनिया आयन तब भरमा हमर देह के आराम नेहको मिलस, बलुक हमके हर मेर के दुख उठामै का पडे रथै, बाहिर झगडा लग अउ मन के भित्तर डर लग। <verse eid="2CO 7:5" /><verse number="6" style="v" sid="2CO 7:6" />पय दीन-दुखी मनसे के सुखी करै बाले भगवान तीतुस के इहां पहुंचाय के हमके सान्ति दय हबै। <verse eid="2CO 7:6" /><verse number="7" style="v" sid="2CO 7:7" />अउ ऊ केबल ओखर इहां पहुंचै लग नेहको बलुक एखर लग हमके अउ सान्ति मिलिस कि तुम उके केतका सुख दय रथा, ऊ हमके बताइस कि हमर लग मिलै के केतका ब्याकुल हबा, तुमके हमर केतका चिन्ता हबै, एखर लग हम अउ खुस हबन।<verse eid="2CO 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 7:8" />काखे मै तुम्हर लग ऊ चिट्ठी दवारा दुख दयों, फिर भी मोके ओखर उप्पर दुख नेहको होय रथै, मोके हइ देखके दुख होय रथै, कि ऊ चिट्ठी तुमके चुटु टेम के निता दुखी बनाय दय रथै। <verse eid="2CO 7:8" /><verse number="9" style="v" sid="2CO 7:9" />अब मै खुस हव, इहैनिता नेहको कि तुम दुखी होया पय इहैनिता कि तुम्हर मन बदलिस, तुम ऊ दुख के भगवान के इक्छा के जसना स्वीकार करा, अउ हइ मेर तुमके मोर पल्ला लग कउनो नुसकान नेहको हुइस। <verse eid="2CO 7:9" /><verse number="10" style="v" sid="2CO 7:10" />काखे ऊ दुख जेही भगवान देथै अक्ठी असना मन बदलाव के पइदा करथै, जेखर निता पछतामै के नेहको पडथै अउ जउन मुकति दिलाथै, पय ऊ दुख जउन दुनिया लग होथै, ऊ मिरतू के पइदा करथै। <verse eid="2CO 7:10" /><verse number="11" style="v" sid="2CO 7:11" />धियान देया कि भगवान के पल्ला लग आय हर दुख तुमके का-का परिवरतन करे हबै, असना खुसी भरे हबै कि अपन पक्छ सही करै के निता असना बडा इक्छा अन्याय के परति गुस्सा परेसानी के परति असना सचेत, मोर लग मिलै के निता असना तेज लालसा, सेबा के परति असना खुसी अउ दुराचारी के सजा देय के निता असना तेज के दवारा तुम हइ साबित के दय कि सब कुछ निक्खा-निक्खा करै हे तुम कउनो कमी नेहको छांडे हबा।<verse eid="2CO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 7:12" />सही हे मै ऊ चिट्ठी इहैनिता नेहको लिखे रथो कि मोके अन्याय करै बाले अउ अन्याय सहै बाले मनसे के बोहत चिन्ता रथै, बलुक इहैनिता कि तुम मनसे भगवान के आगू हइ अच्छी मेर समझ लेया कि हमर परति तुम्हर केतका सच्चे हबा। <verse eid="2CO 7:12" /><verse number="13" style="v" sid="2CO 7:13" />इहैनिता हमके सान्ति मिलिस, हमर हइ सान्ति के संग तीतुस के मगन के कारन अउ जादा मगन हुइस काखे ओखर जीव तुम सबके कारन खुसी हुइ गय हबै। <verse eid="2CO 7:13" /><verse number="14" style="v" sid="2CO 7:14" />अगर तीतुस के आगू मै तुम्हर उप्पर गर्व परगट करे हबै ता मोके ओखर निता लजाय का नेहको होमै का पडिस, जउन मेर जउन कुछ मै तुम्हर लग कहों ऊ सही रथै, उहै मेर तीतुस के आगू मोर गर्व परगट करै का सही साबित हुइस। <verse eid="2CO 7:14" /><verse number="15" style="v" sid="2CO 7:15" />जब उनके सुरता आथै कि तुम सब कउन मेर लग ओखर आदेस के माने हबा अउ डरत कांपत उनखर सोगत करा, ता तुम्हर परति उनखर माया अउ बढ जथै। <verse eid="2CO 7:15" /><verse number="16" style="v" sid="2CO 7:16" />मै पूरी तरह लग खुस हव, काखे मोके हर बात हे तुम्हर उप्पर पूर भरोसा हबै।<verse eid="2CO 7:16" /></para>
  <chapter eid="2CO 7" />
  <chapter number="8" style="c" sid="2CO 8" />
  <para style="s">बिना झिझकके दान दइहा</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 8:1" />हे भाई अउ बेहन मै तुम्हर लग ऊ अनुगरह के बारे हे गुठेमै चाहथो, जेही भगवान मकिदुनिया के मंडली के परदान करे हबै। <verse eid="2CO 8:1" /><verse number="2" style="v" sid="2CO 8:2" />मोर कहै का मतलब हइ हबै कि अगर उनखर कठिन परिक्छा लय गइस ता ऊ खुस रहिन अउ अपन बोहत गरीब हे हुइके उनखर पूरी तरह लग उदारता के रूप हे छलक पडिस। <verse eid="2CO 8:2" /><verse number="3" style="v" sid="2CO 8:3" />उनखर बारे हे मोर गवाही हबै कि उन अपन सक्ति के जसना नेहको, बलुक ओखर लग जादा उन अपन इक्छा लग दय हबै। <verse eid="2CO 8:3" /><verse number="4" style="v" sid="2CO 8:4" />अउ उन हमर लग बिनती के उप्पर बिनती करत अनुमति चाही कि उन पवितर मनसे के सेबा के धन्यबाद हे सामिल होमै का मउका परदान करे जाय। <verse eid="2CO 8:4" /><verse number="5" style="v" sid="2CO 8:5" />ऊ अपन इक्छा हे हमर आसा लग बोहत जादा आगू बढ गइन, उन पहिले भगवान के परति अउ बाद परभु के फेर भगवान के इक्छा के जसना हमर परति खुद के सउपे हबै। <verse eid="2CO 8:5" /><verse number="6" style="v" sid="2CO 8:6" />इहैनिता हम तीतुस के समझायन कि जसना ऊ आगू सुरु करथै, ओसनेन तुम्हर बीच हे हइ दान के काम के पूर कर लेया। <verse eid="2CO 8:6" /><verse number="7" style="v" sid="2CO 8:7" />इहैनिता हम तीतुस लग बिनती करन कि जसना ऊ अपन काम सुरु के चुके हबै, ओसनेन हइ अनुगरह, बिस्वास, ग्यान के काम के ऊ तुम्हर निता करै, अउ ऊ माया हे जउन हमर लग रखत हबा, बढत जा।<verse eid="2CO 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 8:8" />मै तोके कउनो आदेस नेहको देथो, मै केबल बाकी के खुसी लग तुम्हर माया के बरोबरी करके एखर सच्चाई के परखथो। <verse eid="2CO 8:8" /><verse number="9" style="v" sid="2CO 8:9" />तुम हमर परभु यीसु मसीह के अनुगरह के जानथा कि ऊ धन्नड हुइके तुम्हर निता गरीब बन गइस, ताकि ओखर गरीब हुइ जाय लग तुम धन्नड हुइ जा।<verse eid="2CO 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CO 8:10" />मै हइ बात हे इहै सलाह हबै, हइ तुम्हर निता निक्खा हबै, तुम पिछले साल न केबल दान देय के इक्छा हे सब लग आगू रथा बलुक दान देय हे सब लग आगू रहा। <verse eid="2CO 8:10" /><verse number="11" style="v" sid="2CO 8:11" />इहैनिता अब हइ काम पूर करा कि जसना काम करै के इक्छा हे तुम तइयार रथा, ओसनेन अपन सक्ति के जसना पूर करा। <verse eid="2CO 8:11" /><verse number="12" style="v" sid="2CO 8:12" />अगर कउनो हे दान देय के इक्छा हबै ता जउन कुछु ओखर लिघ्घो हबै, ओखरै आधार हे ओखर दान लय जही, ओखर आधार हे नेहको, जउन ओखर लिघ्घो नेहको हबै।<verse eid="2CO 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 8:13" />हमर मतलब हइ नेहको हबै कि दूसर के भलाई करै के कारन खुद तुम दुख सहा, हमर उदेस्य केबल नियाव करै के हबै। <verse eid="2CO 8:13" /><verse number="14" style="v" sid="2CO 8:14" />हइ टेम तुम्हर कमाई उनखर जरूरत पूर करै के निता बोहत हबै, कबहुन इहो लिखडी हबै कि तुम खुद के जरूरत हे पाबा अउ ऊ अपन कमाई मसे तुम्हर मदद करै तब दोनो पल्ला बाले अक जसना हुइ जइहिन। <verse eid="2CO 8:14" /><verse number="15" style="v" sid="2CO 8:15" />जसना किताब हे लिखै हबै, “जउन बोहत बटोर लय रथै, ओखर लिघ्घो जादा नेहको निकरिस अउ जउन चुटुहस बटोर लय रथै, ऊ कउनो कमी के अहसास नेहको करिस।”<verse eid="2CO 8:15" /></para>
  <para style="s">तीतुस अउ ओखर संगीमन</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 8:16" />भगवान के धन्यबाद होय, जउन तीतुस के मन हे तुम्हर मदत के निता ओसनेन तेज इक्छा लग भर दय हबै, जसना हमर मन हे हबै। <verse eid="2CO 8:16" /><verse number="17" style="v" sid="2CO 8:17" />उन मोर बिनती स्वीकार करिस अउ अब ऊ अपन इक्छा लग बडा खुसी लग तुम्हर लिघ्घो आउत हबै। <verse eid="2CO 8:17" /><verse number="18" style="v" sid="2CO 8:18" />हम ओखर संग अक असना भाई के पठोथै, जउन सगलू मंडली हे भगवान के संदेस के परचार के निता परसंसा के हकदार हबै। <verse eid="2CO 8:18" /><verse number="19" style="v" sid="2CO 8:19" />एखर अलाबा खुद परभु के सेबा अउ मनसे हे हइ मदद के निता हमर तत्परता परगट करै के उदेस्य लग मंडली हइ मनसे के हमर संग यातरा करै के निता चुने हबै।<verse eid="2CO 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2CO 8:20" />हम हइ बात हे चेतन्त रथन कि हइ उदारता के काम के बारे हे जेखर सेबा करथन, कउ हमर हे दोस झइ लगा पामै। <verse eid="2CO 8:20" /><verse number="21" style="v" sid="2CO 8:21" />काखे न केबल परभु के नजर हे, बलुक मनसे के नजर हे हम निक्खा आदत करै का धियान रखथन।<verse eid="2CO 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2CO 8:22" />इनखर संग हम अक्ठी अउ भाई के पठोथन जेही कइनमेर मउका हे हम उके परखे हबन अउ उके सही पाय हबन, अब तुम्हर निता ओखर भरोसा ओहमा अउ जादा खुसी अउ मदद के निता बोहत लग संचार करे हबै। <verse eid="2CO 8:22" /><verse number="23" style="v" sid="2CO 8:23" />तीतुस तुम्हर बीच मोर सहभागी अउ संग-संग चलै बाले हबै, ओखर संगी भाई यातरा मंडली के पठोय हर अउ मसीह के महिमा हबै। <verse eid="2CO 8:23" /><verse number="24" style="v" sid="2CO 8:24" />इहैनिता तुम उनके अपन माया के साबूत दे अउ तुम्हर निता हम एतका गर्व काखे रखथा, इके सिध्द करबे ताकि सगलू मंडली उके देख सकै।<verse eid="2CO 8:24" /></para>
  <chapter eid="2CO 8" />
  <chapter number="9" style="c" sid="2CO 9" />
  <para style="s">सेबा करै बाले के निता दान</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 9:1" />सेबकन के मदद के निता ऊ सेबा काम के बारे हे मोके तुम्हर निता लिखै के कउनो जरूरत नेहको हबै। <verse eid="2CO 9:1" /><verse number="2" style="v" sid="2CO 9:2" />काखे मदद के निता तुम्हर तइयारी लग अच्छी तरह लग जानथो, मकिदुनिया हे रहैबाले के आगू घमंड दिखाथो कि अखाया परदेस के मंडली पिछले अक साल लग एखर निता तइयार हबै अउ तुम्हर खुसी लग बोहतझन के सीख मिले हबै। <verse eid="2CO 9:2" /><verse number="3" style="v" sid="2CO 9:3" />मै हइ भाई के इहैनिता पठोथो कि हम हइ बारे हे तुम्हर उप्पर गर्व परगट करे हवन, ऊ बेकार झइ निकरै, मै चाहथो कि तुम तइयार हबा, जसना कि मै कथो। <verse eid="2CO 9:3" /><verse number="4" style="v" sid="2CO 9:4" />असना झइ होय कि जब कउ मकिदुनिया हे रहैबाले मोर संग आमै अउ तुमके दान देय के निता तइयार नेहको पामै ता मोके अउ तुमके सरमिन्दा होमै का पडै, जब कि हम ई बारे हे तुम्हर उप्पर एतका बिस्वास करे हबन। <verse eid="2CO 9:4" /><verse number="5" style="v" sid="2CO 9:5" />इहैनिता मै भाई लग हइ बिनती करै का जरूरी समझथो कि ऊ पहिले इहां आमै अउ असना परबन्ध करै कि तुम जउन दान के टीमा करे हबा, ऊ मोर पहुंचै लग पहिले तइयार होय अउ ऊ दान तुम्हर कंजूसी लग नेहको, बलुक खुसी लग होय चाही।<verse eid="2CO 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 9:6" />पय बात हइ हबै जउन चुटु बोथै, ऊ चुटु काटथै अउ जउन बोहत बोथै ऊ बोहत काटथै। <verse eid="2CO 9:6" /><verse number="7" style="v" sid="2CO 9:7" />इहैनिता जउन अपन मन हे जेतका देय का ठाने हबै, ऊ ओतकै दे, बिना इक्छा के या जबरजस्ती लग नेहको काखे भगवान के पिरिया ऊ हबै, जउन खुसी लग देथै। <verse eid="2CO 9:7" /><verse number="8" style="v" sid="2CO 9:8" />भगवान सक्तिमान हबै कि ऊ तुमके बोहत जादा अनुगरह दे, कि तुमके सब कुछ मिलत रहै अउ हर निक्खा काम हे तुम्हर लिघ्घो बोहत जादा होय। <verse eid="2CO 9:8" /><verse number="9" style="v" sid="2CO 9:9" />जसना लिखवरे हबै, जउन कुछु दइस,</para>
  <para style="q1" vid="2CO 9:9">“ऊ भिखारिन के दान दइस,</para>
  <para style="q2" vid="2CO 9:9">उनखर नियाइपन किरपा सबैरोज बने रही।”<verse eid="2CO 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CO 9:10" />जउन बोमै बाले के बिजहा अउ खाय बालेन के खाना देथै, ऊ तोके बोमै के निता बिजहा देही, उके बढाही अउ तोके नियाइपन के निक्खा उपज हे बढाही। <verse eid="2CO 9:10" /><verse number="11" style="v" sid="2CO 9:11" />हइ मेर तुम हर मेर के धन लग धनड्ड करे जइहा, हमर दवारा लग तुम्हर हइ उदारता भगवान के परति धन्यबाद के बारे हे होही। <verse eid="2CO 9:11" /><verse number="12" style="v" sid="2CO 9:12" />काखे हइ सेबा के पूर करै लग न सिबाय पवितर मनसेन के जरूरत पूर होथै, पय मनसेन के पल्ला<note caller="+" style="f"><char style="fr" closed="false">9:12 </char><char style="ft" closed="false">ओर</char></note> लग भगवान के बोहत धन्यबाद होथै। <verse eid="2CO 9:12" /><verse number="13" style="v" sid="2CO 9:13" />तुम्हर हइ सेबा के साबूत मानत ऊ भगवान के महिमा करही काखे तुम मसीह के भगवान कर संदेस के आदेस मानत स्वीकार करे हबा, अउ तुम सगलू के परति उदार मन के हबा। <verse eid="2CO 9:13" /><verse number="14" style="v" sid="2CO 9:14" />ऊ तुम्हर निता भगवान लग पराथना करही, ऊ तुम्हर लग माया करथै, काखे ऊ जानथै कि भगवान तुम्हर उप्पर केतका अनुगरह करे हबै। <verse eid="2CO 9:14" /><verse number="15" style="v" sid="2CO 9:15" />भगवान का, उनखर ऊ दान के निता जउन बयान नेहको करे जा सकथै, भगवान के धन्यबाद होय।<verse eid="2CO 9:15" /></para>
  <chapter eid="2CO 9" />
  <chapter number="10" style="c" sid="2CO 10" />
  <para style="s">पोलुस के दवारा ओखर सेबकाई के बचाव</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 10:1" />मै पोलुस मसीह के नम्र अउ दया के नाम हे तुम्हर लग हइ बिनती करथो, कुछ मनसे कथै कि मै तुम्हर आगू कोमर हव, पय दुरिहां रहत भरमा निरभय हव। <verse eid="2CO 10:1" /><verse number="2" style="v" sid="2CO 10:2" />मोर बिनती हइ हबै, जब मै उहां आंव ता मोके उनखर परति, जउन हइ सोचथै कि हम देह के जसना चलै बाले समझथै, ऊ ठोस दिखामै का झइ पडै जेखर मोर लग आसरा करे जथै। <verse eid="2CO 10:2" /><verse number="3" style="v" sid="2CO 10:3" />हम देह हे चलथन फिरथन, पय हम दुनिया के मनसे के जसना नेहको लडथन। <verse eid="2CO 10:3" /><verse number="4" style="v" sid="2CO 10:4" />काखे जउन किताब लग लडाई करथन, ऊ संसारिक नेहको हबै, बलुक ओहमा भगवान के सक्ति हबै, जेही ऊ हर मेर के गढन के नास के देथै। <verse eid="2CO 10:4" /><verse number="5" style="v" sid="2CO 10:5" />अउ उहै किताब लग हम मनसेन के तरकन के अउ ऊ हर बाधा के, जउन भगवान के ग्यान के बिरोध ठाढ हबै, उके टोरथन, अउ हर अक्ठी भावना के कबजा करके मसीह के आदेस मानै बाले बना देथै। <verse eid="2CO 10:5" /><verse number="6" style="v" sid="2CO 10:6" />जब तुम मसे सब कउ आदेस के मानथा, ता हम हर मेर के आदेस के न मानै बाले के सजा दे के निता तइयार हवन।<verse eid="2CO 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 10:7" />तुम केबल जउन आगू हबै, ओखर बाहरी रूप के देखथा, अगर कउनो के अपन बारे हे हइ जरूरी हबै कि ऊ मसीह के हबै ता ऊ हइ बात हे दुबारा बिचारै कि जसना ऊ मसीह के हबै ओसनेन हमु मसीह के हबन। <verse eid="2CO 10:7" /><verse number="8" style="v" sid="2CO 10:8" />अगर मै ओखर उप्पर कुछ जादा गर्व करथो, जउन परभु मोके तुमही बनामै के निता सउपे हबै, न कि तुमही नास के निता, ता ओहमा मोके कउनो लाज नेहको। <verse eid="2CO 10:8" /><verse number="9" style="v" sid="2CO 10:9" />मै नेहको चाहथो कि तुमके हइ अहसास होय कि मै तुमके डरामै के उदेस्य लग हइ चिट्ठी लिखथो। <verse eid="2CO 10:9" /><verse number="10" style="v" sid="2CO 10:10" />कुछ मनसे के कहना हबै, कि ओखर चिट्ठी ठोस अउ परभावसाली हबै, पय जब ऊ खुद आथै, ता ओखर देह ढिलवा लगथै अउ ओखर बोलै के सक्ति न के बरोबर हबै। <verse eid="2CO 10:10" /><verse number="11" style="v" sid="2CO 10:11" />पय असना कहै बाले मनसेन के समझ ले चाही कि तुम्हर बीच न रहत भरमा जब हम अपन चिट्ठी हे कुछ लिखथन ता ऊ ओहमा अउ तुम्हर बीच रहत हम जउन काम करथन ओहमा कउनो अन्तर नेहको हबै।<verse eid="2CO 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 10:12" />हम उनखर संग अपन गिनती या बरोबरी करै का नेहको सोचथन, जउन खुद अपन बडाई करथै ऊ अपन के अक दूसर लग नापथै, अउ अपन बरोबरी खुद करथै, पय उन नेहको जानथै कि केतका मूरख हबै। <verse eid="2CO 10:12" /><verse number="13" style="v" sid="2CO 10:13" />हम अपन मरयादा के बाहिर घमंड नेहको करब, हम भगवान दवारा निरधारित मरयादा हे रहब, तुमो इहै मरयादा हे सीमित हबा। <verse eid="2CO 10:13" /><verse number="14" style="v" sid="2CO 10:14" />हम मरयादा पार नेहको करथन माना हम उहां तक पहुंचे नेहको हबन, जिहां हइ टेम तुम हबा काखे हम सब लग पहिले तुम्हर बीच मसीह के सुभ संदेस के परचार करे रथन। <verse eid="2CO 10:14" /><verse number="15" style="v" sid="2CO 10:15" />अपन जरूरी मरयादा लग बाहिर जायके कउनो दूसर मनसे के काम हे हम गर्व नेहको करथन पय हमके आसा हबै कि तुम्हर बिस्वास जसना-जसना बढही ता ओसनेन हमर काम इलाका के संग तुम्हर बीच हमु सही रूप लग फइलब। <verse eid="2CO 10:15" /><verse number="16" style="v" sid="2CO 10:16" />एखर लग तुम्हर इलाका लग आगू हम संदेस के परचार के पउब, कउनो दूसर के जउन काम सउपे गय रथै, ऊ इलाका हे अब तक जउन काम हुइ चुके हबै, हमके ओखर उप्पर गर्व करै का कउनो जरूरत नेहको हबै।<verse eid="2CO 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2CO 10:17" />जसना किताब हे लिखवरे हबै, जेही गर्व करै का हबै, ऊ परभु के उप्पर करै। <verse eid="2CO 10:17" /><verse number="18" style="v" sid="2CO 10:18" />काखे निक्खा उहै माने जथै जेही परभु निक्खा स्वीकारथै, न कि ऊ जउन खुद के निक्खा समझथै।<verse eid="2CO 10:18" /></para>
  <chapter eid="2CO 10" />
  <chapter number="11" style="c" sid="2CO 11" />
  <para style="s">पोलुस अउ नरै बाले चेला</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 11:1" />मै चाहथो कि तुम मोर चुटु हस मूरखता के सह लेया जसना सहीमा तुम ई टेम सहथा। <verse eid="2CO 11:1" /><verse number="2" style="v" sid="2CO 11:2" />तुम्हर निता मोर माया के धुन ठीक असना हबै जसना भगवान के, तुम ऊ पवितर कुमारी जसना हबा, जेखर मंगनी मै केबल दुलहा मसीह यीसु के सउपे के उदेस्य लग करे हव। <verse eid="2CO 11:2" /><verse number="3" style="v" sid="2CO 11:3" />मोके हरमेसा हइ डर लगे रथै कि कहुं भुतवा तुम्हर मन के मसीह के परति तुम्हर निस्कपट, पवितर लग दुरिहां झइ के दे, जसना सपुवा हब्बा के अपन चलाकी लग धोखा दय रथै। <verse eid="2CO 11:3" /><verse number="4" style="v" sid="2CO 11:4" />काखे जब कउ तुम्हर लिघ्घो आयके जउन यीसु के परचार करे हबै, ओही छांडके कउनो दूसर यीसु के परचार करथै अउ जउन आतमा तुम स्वीकारे हबा, ओखर लग अलगे कउनो अउ आतमा के तुम स्वीकारथा, अउ छुटकारा के जउन संदेस के तुम स्वीकारे हबा, ओखर लग अलगे कउनो दूसर संदेस के स्वीकारथा।<verse eid="2CO 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 11:5" />मै तो समझथो कि मै कउनो बात हे बड्डे लग बड्डे चेला लग कम नेहको हबो। <verse eid="2CO 11:5" /><verse number="6" style="v" sid="2CO 11:6" />मै निक्खा बक्ता नेहको हव, पय मोर भित्तर ग्यान के कमी नेहको हबै, एखर साबूत हम सब मेर लग अउ हर मेर के बात हे तुमके दइ चुके हव।<verse eid="2CO 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 11:7" />इहैनिता कि मै तुम्हर निता भगवान के सुभ संदेस के परचार मुफ्त हे करव, का तुमके ऊंच करै के उदेस्य लग मोर खुद के दीन बनाय ले का पाप रथै? <verse eid="2CO 11:7" /><verse number="8" style="v" sid="2CO 11:8" />तुम्हर बीच सेबा करै के निता मै दूसर मंडली लग अपन जीवन के निता दान लइके माना मै उनके लूटे हव। <verse eid="2CO 11:8" /><verse number="9" style="v" sid="2CO 11:9" />तुम्हर संग रहत भरमा पइसा के जरूरत हे मै तुम्हर लग कउनो के उप्पर बोझ नेहको बनो, मकिदुनिया परदेस लग आय संगी भाई बिस्वासी मोर सगलू जरूरत के पूर करिन, अउ हर इलाका हे मोर इहै परयास रहे हबै कि मै तुम्हर उप्पर बोझ झइ बनो, भभिस्य हे मोर परयास इहै रही। <verse eid="2CO 11:9" /><verse number="10" style="v" sid="2CO 11:10" />मोर भित्तर मसीह के सच्चाई मउजूद हबै, इहैनिता पूरे अखाया परदेस के इलाका के मनसे मोके बढ चढके बोलै लग कउ नेहको रोक सकथै। <verse eid="2CO 11:10" /><verse number="11" style="v" sid="2CO 11:11" />काखे? का इहैनिता कि मै तुम्हर लग माया नेहको रखथो? भगवान हइ जानथै कि मै तुम्हर लग केतका माया रखथो।<verse eid="2CO 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 11:12" />मै जउन करत आउथो अउ उहै करत जइहों, जेखर लग चेलन के हइ बात हे गर्व करै के मउका झइ मिलै कि ऊ परचार काम हे मोर बरोबर हबै। <verse eid="2CO 11:12" /><verse number="13" style="v" sid="2CO 11:13" />असना मनसे ठगरा चेला अउ उन नरथै, ऊ मसीह के चेला होमै के ढोंग करथै। <verse eid="2CO 11:13" /><verse number="14" style="v" sid="2CO 11:14" />हइ कउनो चकित के बारे हे नेहको हबै कि भुतवा भगवान के स्वरगदूत के रूप धारन के लेथै। <verse eid="2CO 11:14" /><verse number="15" style="v" sid="2CO 11:15" />इहैनिता अगर ओखर सेबक नियाइपन धरमी सेबक के रूप धारन के लेथै ता एहमा कोन सी बडी बात हबै? पय आखरी हे उनके अपन करम के जसना फडुहा मिलबै करही।<verse eid="2CO 11:15" /></para>
  <para style="s">चेलन के सकल हे पोलुस के दुख</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 11:16" />मै फेर दुबारा सुरता देबाथो, कउ मोके मूरख झइ समझै पय अगर तुम मोके असना मान लय हबा ता मोके मूरख के रूप हे स्वीकार के लेया, एखर लग मोके गर्व करै का मउका मिल जही। <verse eid="2CO 11:16" /><verse number="17" style="v" sid="2CO 11:17" />अब हइ जउन मै कथो, ऊ परभु के जसना नेहको कथो, बलुक अक्ठी मूरख के रूप हे गर्वपूर्न बिस्वास के संग कथो। <verse eid="2CO 11:17" /><verse number="18" style="v" sid="2CO 11:18" />काखे बोहत मनसे अपन देह के उप्पर गर्व करथै। <verse eid="2CO 11:18" /><verse number="19" style="v" sid="2CO 11:19" />तुम तो समझदार होमै के नाते तुम मूरख मनसे के बेउहार खुसी लग सहथा। <verse eid="2CO 11:19" /><verse number="20" style="v" sid="2CO 11:20" />काखे अगर कउ तुमके गुलाम बनाबै, या तोर उप्पर नियाव करै, तोके कउनो फान्दा हे फसामै, खुद के तोर लग बडा समझै अउ तुम्हर मुंह हे झापड मारै ता तुम उके सह लेथा। <verse eid="2CO 11:20" /><verse number="21" style="v" sid="2CO 11:21" />मै लाज के संग कथो, कि तुम मनसे हइ मेर के बेउहार करै का मोके हिम्मत नेहको हुइस, तुम इके मोर नदानी समझा,</para>
  <para style="p" vid="2CO 11:21">पय जउन बातन के बारे हे ऊ मनसे बडा बात करै का हिम्मत करथै, महुं उन बातन के बारे हे उहै कर सकथों। <verse eid="2CO 11:21" /><verse number="22" style="v" sid="2CO 11:22" />उन इब्रानी हबै? महुं यहों, उन इस्राएली हबै? महुं यहों, उन अब्राहम के टोरवा हबै? महुं यहों। <verse eid="2CO 11:22" /><verse number="23" style="v" sid="2CO 11:23" />का उनो मसीह के सेबक हबै? मै पगलन के जसना कथो, मै उनखर लग बढके हबो मै उनखर लग बोहत मेहनत करे हव, उनखर लग मै कहुं जादा जेल हे धंधररे रहों, अनगिनत बेर मारे गय हव, घरी-घरी मोर जीव परेसानी हे पडे हबै। <verse eid="2CO 11:23" /><verse number="24" style="v" sid="2CO 11:24" />पांच बेर मै यहूदी के हाथ लग उन्तालीस कोडा खाय हव। <verse eid="2CO 11:24" /><verse number="25" style="v" sid="2CO 11:25" />मै तीन-तीन बेर डंडा लग मारे गयों, अक बेर मोर उप्पर पथरा लग मरे गयों, तीन बेर मोर जिहाज बुडिस, अक रोज अउ अक रात मै समुन्दर के गहिरा पानी हे बितायों <verse eid="2CO 11:25" /><verse number="26" style="v" sid="2CO 11:26" />मै बेर-बेर यातरा करत रहों, मोके नदियन के खतरा, यहूदिन के खतरा, गैर यहूदिन के खतरा, सरहन के खतरा, पतेरा जिघा के खतरा, समुन्दर के खतरा अउ ठगरा भाई के खतरा के सामना करै का पडिस। <verse eid="2CO 11:26" /><verse number="27" style="v" sid="2CO 11:27" />मै बोहत मेहनत करव अउ बोहत रात जागत बितायों, मोके हरमेसा खाना नेहको मिलिस, उपास ठंड अउ कपडन के कमी के कारन हइ सब मै सहत रहों। <verse eid="2CO 11:27" /><verse number="28" style="v" sid="2CO 11:28" />हइ सगलू बाहरी परेसानी के अलाबा रोज दिन मोर उप्पर सगलू मंडली के भलाई चिन्ता के भार बने रथै। <verse eid="2CO 11:28" /><verse number="29" style="v" sid="2CO 11:29" />कोन ढिलवा हबै, जेखर ढिलवा के अहसास मोके नेहको होथै? केखर पाप हे पडै लग मै चिन्ता नेहको होतो? <verse eid="2CO 11:29" /><verse number="30" style="v" sid="2CO 11:30" />अगर कउनो बात हे गर्व करै का हबै, ता मै अपन ढिलवन के उप्पर गर्व करिहों। <verse eid="2CO 11:30" /><verse number="31" style="v" sid="2CO 11:31" />परभु यीसु मसीह के बाफ अउ भगवान जुगजुग धन्य हबै, ऊ जानथै कि मै झूठ नेहको बोलथो। <verse eid="2CO 11:31" /><verse number="32" style="v" sid="2CO 11:32" />जब मै दमिस्क सहर हे रथो, ता राजा अरेतास के सिपाही मोके पकडै के निता सहर हे पेहरा बइठाय दइस। <verse eid="2CO 11:32" /><verse number="33" style="v" sid="2CO 11:33" />अउ मै टोपरी हे झरोकिया लग हुइके ऊंच पगरा<note caller="+" style="f"><char style="fr" closed="false">11:33 </char><char style="ft" closed="false">सहरपनाह</char></note> लग उतारे गइस अउ ओखर हाथ लग बच गयों।<figure style="fig" alt="Entrance to the city gate and wall" file="hk00238c.tif" size="col" copy="Horace Knowles ©" ref="11:32">सहर के दूरा अउ भीठी हे परवेस</figure><verse eid="2CO 11:33" /></para>
  <chapter eid="2CO 11" />
  <chapter number="12" style="c" sid="2CO 12" />
  <para style="s">पोलुस के उप्पर परभु के खास अनुगरह</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 12:1" />अपन बडाई करै का मोर निता जरूरी हुइ गय हबै, इहैनिता एहमा मोके कउनो फायदा नेहको हबै, इहैनिता मै परभु के दवारा दय गय दरसन अउ सुभ संदेस के बात हरमेसा करत रइहों। <verse eid="2CO 12:1" /><verse number="2" style="v" sid="2CO 12:2" />मै अक्ठी असना मनसे के, जउन मसीह के बिस्वासी हबै, जानथो, चउदा साल पहिले हइ मनसे तीसर बेर स्वरग तक उठाय लय गइस, देह के संग या बेगैर देह के, मोके पता नेहको हबै, पय भगवान जानथै। <verse eid="2CO 12:2" /><verse number="3" style="v" sid="2CO 12:3" />मै जानथो कइसन इहै मनसे देह के संग या बेगैर देह के, मोके पता नेहको हबै, हइ भगवान जानथै। <verse eid="2CO 12:3" /><verse number="4" style="v" sid="2CO 12:4" />स्वरग लोक हे उठाय लय गय हबै अउ ऊ मनसे असना बात के चरचा सुनिस, जउन वरनन लग बाहिर हबै, अउ जिके परगट करै का कउनो मनसे के इजाजत नेहको हबै। <verse eid="2CO 12:4" /><verse number="5" style="v" sid="2CO 12:5" />इहै मनसे के पल्ला लग मै गर्व करिहों, जउन खुद अपन बारे हे नेहको, केबल अपन कमजोरन के बारे हे बात करथै। <verse eid="2CO 12:5" /><verse number="6" style="v" sid="2CO 12:6" />ओसनेन अगर मै अपन बडाई करै लगो, ता इके मोर मूरखता नेहको माने जा सकही काखे ऊ सही वरनन होही, पय मै इहो नेहको करिहों, कि कउनो मोर आदत, मोर वरनन लग परभावित होय मोके मोर बात अउ करै लग जादा भलाई दय लगिस।<verse eid="2CO 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 12:7" />मोर उप्पर भगवान के संदेस परगट करे गय हबै, मै इनखर उप्पर घमंड न करव, इहैनिता मोर देह हे अक्ठी कांटा चुभाय दय गय हबै, मोके भुतवा के दूत मिले हबै, ताकि ऊ मोके मुटका मारत रहै अउ मै घमंड न करव। <verse eid="2CO 12:7" /><verse number="8" style="v" sid="2CO 12:8" />मै कांटा के ई परेसानी के बारे हे मै परभु लग तीन बेर बिनती करे रहों, कि हइ कांटा के मोर लग दुरिहां के दे। <verse eid="2CO 12:8" /><verse number="9" style="v" sid="2CO 12:9" />पय ऊ मोर लग कथै, “मोर अनुगरह किरपा तोर निता बोहत हबै, काखे मोर सक्ति ढिलवन हे सिध्द होथै।” इहैनिता मै बडे मगन लग अपन ढिलवनो हे घमंड करिहों कि मसीह के सक्ति मोर हे छाउत रहै। <verse eid="2CO 12:9" /><verse number="10" style="v" sid="2CO 12:10" />मै मसीह के कारन अपन ढिलवन हे, बुराई हे, दुख हे, अतियाचार अउ परेसानी हे पूर मेर लग गर्व करथो, काखे मै जब ढिलवा होतो तबय फेरै लग बलवान हुइ जथो।<verse eid="2CO 12:10" /></para>
  <para style="s">कुरिन्थियन के मंडली हे पोलुस के चिन्ता</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 12:11" />हइ करत मै खुद के मूरख बनाय लय हव, तुमै मोके एखर निता मजबूर करे हबै, होमै तो हइ रथै कि तुम मोर बडाई करा, पय मै बेकार हव, फेर मै ऊ बडा-बडा चेला के बरोबरी हे कम नेहको यहों। <verse eid="2CO 12:11" /><verse number="12" style="v" sid="2CO 12:12" />तुम्हर इहां रहत टेम मै चेला के सही आदत परगट करव, मतलब धीर, चकित चिन्हा, अउ सक्ति के काम। <verse eid="2CO 12:12" /><verse number="13" style="v" sid="2CO 12:13" />दूसर मंडली के बरोबरी हे तुम मनसे हे कउन बात के कमी रह गय हबै? हां मै तुम्हर निता बोझ नेहको बनो, तुम मोके हइ अन्याय के निता छमा कर देया।<verse eid="2CO 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 12:14" />अब मै तीसर बेर तुम्हर इहां आमै का तइयारी करत हव, अउ तुम्हर निता बोझ नेहको बनहुं, काखे मै तुमके चाहथो, तुम्हर डेरा के नेहको, लरकन के अपन दाय-बाफ के निता डेरा अकजुट करैका नेहको चाही, बलुक दाय-बाफ के अपन लरकन के निता कमाथै। <verse eid="2CO 12:14" /><verse number="15" style="v" sid="2CO 12:15" />जिहां तक मोर बात हबै, मोर लिघ्घो जउन कुछु हबै, तुम्हर खुसी के निता खरच करिहों, इहां तक कि खुद के तुम्हर निता खरच के डरिहों, अगर मै तुम्हर लग जादा माया करथो, ता भला तुम मोके कम माया कइसन करिहा।<verse eid="2CO 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 12:16" />कुछु होय मै तुम्हर उप्पर भार नेहको बनो, तउभरमा कउनो न कउनो मोर उप्पर हइ दोस जरूर लगाय सकथै, बडा चतुर हबै ऊ जउन नरके फसाय लय हबै। <verse eid="2CO 12:16" /><verse number="17" style="v" sid="2CO 12:17" />जउन मनसे के मै तुम्हर लिघ्घो पठोय रथो, का मै उनखर लग कउनो के दवारा तुम्हर फायदा उठाइस? <verse eid="2CO 12:17" /><verse number="18" style="v" sid="2CO 12:18" />मै तीतुस लग तुम्हर इहां जाय लग बिनती करव, अउ ओखर संग अक्ठी भाई के पठोयों, का तीतुस तुम्हर गलत फायदा उठाइस? का हम दोनो झन अक्ठी आतमा लग हुइके अक्ठी रास्ता हे नेहको चलन? <verse eid="2CO 12:18" /><verse number="19" style="v" sid="2CO 12:19" />तुम हइ समझत हुइहा कि अब तक हम तुम्हर आगू अपन सफाई देत हबन, बात असना नेहको हबै, हम हइ सब मसीह हे, भगवान के आगू मसीह यीसु हे पिरिया भाई अउ बेहन तुमके उन्नत करै के उदेस्य लग कहत हबन। <verse eid="2CO 12:19" /><verse number="20" style="v" sid="2CO 12:20" />मोके हइ डर हबै कि मोर उहां आमै हे मै तुमके अपन आसा के जसना न पाव अउ तुमो मोके अपन आसा के जसना न पाबा, मोके डर हबै, कि उहां झगडा, जलन, गुस्सा अउ बेवस्था ठीक न हो। <verse eid="2CO 12:20" /><verse number="21" style="v" sid="2CO 12:21" />मोके डर हबै कि जब मै फेरै तुम्हर लग मिलै आंव ता तुम्हर आगू मोर भगवान कहुं मोके लज्जित झइ करै, अउ मोके उन मनसे के निता आसूं बहामै का पडै, जिनही पहिले पाप करे हबै, अउ असुध्द, गलत काम, अउ सरीरिक सबंध हे बुढे रहै के निता छमा नेहको मांगे हबै।<verse eid="2CO 12:21" /></para>
  <chapter eid="2CO 12" />
  <chapter number="13" style="c" sid="2CO 13" />
  <para style="s">आखरी चेतन्त अउ सुभकामनाय</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 13:1" />अब मै तीसर बेर तुम्हर लिघ्घो आय बाले हव, किताब हे कहे गय हबै, दुइ या तीन गवाहन के गवाही दवारा सगलू बात परमानित करे जही। <verse eid="2CO 13:1" /><verse number="2" style="v" sid="2CO 13:2" />जब मै दूसर बेर तुम्हर इहां आय रथो, ता उन मनसे लग जिनही पहिले पाप करे रथै, अउ दूसर सगलू मनसे लग, मै जउन बात कहे रथो, उहै पहुंचै लग पहिले दोहराथो कि मै लउटै लग कउनो के उप्पर दया नेहको करिहों। <verse eid="2CO 13:2" /><verse number="3" style="v" sid="2CO 13:3" />काखे तुम हइ साबूत चाहथा कि जउन मोर दवारा बात करथै, ऊ मसीह हबै, अउ ऊ तुम्हर परति ढिलवा नेहको पय तुम्हर दवारा सक्ति बाले हबै। <verse eid="2CO 13:3" /><verse number="4" style="v" sid="2CO 13:4" />हइ सच हबै कि ऊ ढिलवा रहत क्रूस हे चढाय गइस, पय ऊ भगवान के सक्ति दवारा जिन्दा हबै, हम ओखर मेर ढिलवा हबन, पय तुम अहसास करिहों कि हम भगवान के सक्ति दवारा मसीह के संग जिन्दा हबन।<verse eid="2CO 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 13:5" />अउ खुद के परखा कि तुम बिस्वास हे हबा कि नेहको, खुद के जांचा, का तुमके पता नेहको हबै, कि यीसु मसीह तुम्हर भित्तर रथै, अगर नेहको ता तुम जांच हे ढिलवा निकरे हबा। <verse eid="2CO 13:5" /><verse number="6" style="v" sid="2CO 13:6" />मोके आसा हबै कि तुम हइ जान जइहा कि हम ढिलवा नेहको हबन। <verse eid="2CO 13:6" /><verse number="7" style="v" sid="2CO 13:7" />हम भगवान लग पराथना करथन कि तुम कउनो बुराई झइ करा, इहैनिता भलाई करा जउन जरूरी हबै, फेर हम भले ही ढिलवा दिखाई दइ। <verse eid="2CO 13:7" /><verse number="8" style="v" sid="2CO 13:8" />सही हे हम सही के बिरोध कुछु नेहको के सकथन। हम तो जउन करथन, सही के निता करथन। <verse eid="2CO 13:8" /><verse number="9" style="v" sid="2CO 13:9" />जब हम ढिलवा हबन अउ तुम ताकतबर हबा, ता हम खुस होथन, अउ हइ पराथना करथन कि तुम मनसे के सुधार होय। <verse eid="2CO 13:9" /><verse number="10" style="v" sid="2CO 13:10" />हइ कारन दुरिहां होउत भरमा मै तुमके हइ सब लिखथो कि उहां मउजूद होमै हे मोके परभु दवारा दय गय हक का परयोग ठोस भाव हे झइ करै के पडै, हइ हक के उदेस्य हबै उन्नत करै के न कि नास करै के।<verse eid="2CO 13:10" /></para>
  <para style="s">सोगत</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 13:11" />अब हे भाई अउ बेहन, मै तुम्हर लग बिदा लेथो, अपन आदत निक्खा करा, ओसनेन करत जा जसना मै कहे हव, अक जसना सोचा, सान्ति लग रहा, जेखर लग माया अउ सान्ति के भगवान तुम्हर संग रही।<verse eid="2CO 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 13:12" />पवितर चुम्बन दवारा अक दूसर के सोगत करा, सगलू चेला के तुमके नमस्ते, <verse eid="2CO 13:12" /><verse number="13" style="v" sid="2CO 13:13" />परभु यीसु मसीह के किरपा, भगवान के माया अउ सब पवितर के सहभागी तुम दब के संग होय। <verse eid="2CO 13:13" /><verse number="14" style="v" sid="2CO 13:14" />परभु यीसु मसीह के अनुगरह अउ भगवान के माया अउ पवितर आतमा के संग तुम सबके संग होवत रहै।<verse eid="2CO 13:14" /></para>
  <chapter eid="2CO 13" />
</usx>