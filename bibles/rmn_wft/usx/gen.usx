<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="GEN" style="id">- Romani Arli Bible (RAB)</book>
  <para style="h">1. Lil e Mojsijasoro</para>
  <para style="toc1">Postanak (O prvo ili e Mojsijasoro)</para>
  <para style="toc2">1. Mojsije</para>
  <para style="toc3">1. Mojs</para>
  <para style="mt1">O prvo lil e Mojsijasoro</para>
  <para style="mt2">Savo vičini pe hem Postanak</para>
  <chapter number="1" style="c" sid="GEN 1" />
  <para style="s">Sar o Devel stvorinđa o sveto</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 1:1" />Ano početak o Devel stvorinđa o nebo hem i phuv. <verse eid="GEN 1:1" /><verse number="2" style="v" sid="GEN 1:2" />I phuv inele bizo oblik hem čuči, hem i tomina učhari ine o hor pani, a o Duho e Devlesoro lebdini ine upro pani.<verse eid="GEN 1:2" /></para>
  <para style="s1">O prvo dive – o svetlost</para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 1:3" />Tegani o Devel phenđa: “Nek ovel o svetlost!”</para>
  <para style="p" vid="GEN 1:3">Hem ulo o svetlost. <verse eid="GEN 1:3" /><verse number="4" style="v" sid="GEN 1:4" />O Devel dikhlja dai o svetlost šukar hem razdvojinđa o svetlost oti tomina. <verse eid="GEN 1:4" /><verse number="5" style="v" sid="GEN 1:5" />O Devel vičinđa o svetlost “dive”, a i tomina “rat”.</para>
  <para style="p" vid="GEN 1:5">I inele rat, hem inele sabale – adava inele o prvo dive.<verse eid="GEN 1:5" /></para>
  <para style="s1">O dujto dive – o nebo</para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 1:6" />Tegani o Devel phenđa: “Nek ovel svod maškaro panja, te razdvojini o panja savei upre oto panja savei tele!”<verse eid="GEN 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 1:7" />I o Devel ćerđa o svod hem razdvojinđa o panja talo svod oto panja upro o svod. I ađahar ulo. <verse eid="GEN 1:7" /><verse number="8" style="v" sid="GEN 1:8" />O Devel vičinđa o svod “nebo”.</para>
  <para style="p" vid="GEN 1:8">I inele rat, hem inele sabale – adava inele o dujto dive.<verse eid="GEN 1:8" /></para>
  <para style="s1">O trito dive – o kopno hem o biljke</para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 1:9" />Tegani o Devel phenđa: “Nek o panja savei talo nebo čeden pe ko jekh than hem nek mothoj pe o kopno!”</para>
  <para style="p" vid="GEN 1:9">I ađahar ulo. <verse eid="GEN 1:9" /><verse number="10" style="v" sid="GEN 1:10" />O Devel vičinđa o kopno “phuv”, a o čedime panja “more”. I o Devel dikhlja dai adava šukar.<verse eid="GEN 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 1:11" />Tegani o Devel phenđa: “Nek i phuv bijani biljke: biljke save dena seme hem kašta save bijanena plod ano savo isi seme palo pumare vrste ki phuv!”</para>
  <para style="p" vid="GEN 1:11">I ađahar ulo. <verse eid="GEN 1:11" /><verse number="12" style="v" sid="GEN 1:12" />I tari phuv iklile biljke save dena seme, svako pali pli vrsta, hem kašta save bijanena plod ano savo isi seme, svako pali pli vrsta. I o Devel dikhlja dai adava šukar.<verse eid="GEN 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 1:13" />I inele rat, hem inele sabale – adava inele o trito dive.<verse eid="GEN 1:13" /></para>
  <para style="s1">O štarto dive – o kham, o masek hem o čerenja</para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 1:14" />Tegani o Devel phenđa: “Nek oven svetlija ko nebesko svod te razdvojinen o dive oti rat hem te označinen o odredime vremenja, o dive hem o berša! <verse eid="GEN 1:14" /><verse number="15" style="v" sid="GEN 1:15" />Hem nek o svetlija ko nebesko svod osvetlinen i phuv!”</para>
  <para style="p" vid="GEN 1:15">I ađahar ulo. <verse eid="GEN 1:15" /><verse number="16" style="v" sid="GEN 1:16" />O Devel stvorinđa duj bare svetlija: o po baro svetlo te upravini e diveja hem o po tikoro svetlo te upravini e raćaja. Stvorinđa hem o čerenja. <verse eid="GEN 1:16" /><verse number="17" style="v" sid="GEN 1:17" />O Devel čhivđa sa adala svetlija ko nebesko svod te osvetlinen i phuv, <verse eid="GEN 1:17" /><verse number="18" style="v" sid="GEN 1:18" />te upravinen e diveja hem e raćaja hem te razdvojinen o svetlost oti tomina. I o Devel dikhlja dai adava šukar.<verse eid="GEN 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 1:19" />I inele rat, hem inele sabale – adava inele o štarto dive.<verse eid="GEN 1:19" /></para>
  <para style="s1">O pandžto dive – o maćhe hem o čiriklja</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 1:20" />Tegani o Devel phenđa: “Nek o panja oven pherde e dživde bićencar hem nek o čiriklja letinen ko nebo, upreder i phuv!”<verse eid="GEN 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 1:21" />I o Devel stvorinđa e moresere bare stvorenja hem sa e dživde bićen save plivinena ano pani. Stvorinđa len palo lengere vrste, te pheren o panja. Stvorinđa hem sa e čirikljen palo lengere vrste. I o Devel dikhlja dai adava šukar.<verse eid="GEN 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 1:22" />O Devel blagoslovinđa len hem phenđa: “Oven plodna hem množinen tumen hem pheren o panja e moresere! Hem nek o čiriklja množinen pe ki phuv!”<verse eid="GEN 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 1:23" />I inele rat, hem inele sabale – adava inele o pandžto dive.<verse eid="GEN 1:23" /></para>
  <para style="s1">O šofto dive – o kopnena životinje hem o manuš</para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 1:24" />Tegani o Devel phenđa: “Nek oti phuv ikljoven dživde bićija, svako pali pli vrsta: i stoka, okola so lazinena phuvjaja hem o divlja životinje oti svako vrsta!”</para>
  <para style="p" vid="GEN 1:24">I ađahar ulo. <verse eid="GEN 1:24" /><verse number="25" style="v" sid="GEN 1:25" />O Devel stvorinđa divlja životinje pali olengiri vrsta, e stoka pali olengiri vrsta hem okolen so lazinena phuvjaja pali olengiri vrsta. I o Devel dikhlja dai adava šukar.<verse eid="GEN 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 1:26" />Tegani o Devel phenđa: “Ana te ćera manuše pali amari slika, te ličini upra amende. Nek ovel le vlast upro maćhe savei ano more, upro čiriklja savei ko nebo, upri stoka, upri sa i phuv hem upro sa o stvorenja so lazinena phuvjaja.”<verse eid="GEN 1:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="GEN 1:27" />I o Devel stvorinđa e manuše</para>
  <para style="q2" vid="GEN 1:27">pali pli slika.</para>
  <para style="q1" vid="GEN 1:27">Pali slika e Devlesiri</para>
  <para style="q2" vid="GEN 1:27">stvorinđa le.</para>
  <para style="q1" vid="GEN 1:27">Stvorinđa len</para>
  <para style="q2" vid="GEN 1:27">murše hem đuvlja.<verse eid="GEN 1:27" /></para>
  <para style="b" />
  <para style="p">
    <verse number="28" style="v" sid="GEN 1:28" />O Devel blagoslovinđa len hem phenđa lenđe: “Oven plodna hem množinen tumen, pheren i phuv hem čhiven la tali tumari vlast! Vladinen upro maćhe savei ano more hem upro čiriklja savei ko nebo hem upro sa o dživde stvorenja save kretinena ki phuv!”<verse eid="GEN 1:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 1:29" />Tegani o Devel phenđa: “Ače, dava tumen ki sa i phuv svako biljka savi dela seme hem svako kaš savo bijani plod ano savo isi seme – nek oven tumenđe zako hajba. <verse eid="GEN 1:29" /><verse number="30" style="v" sid="GEN 1:30" />A zako sa o divlja životinje, zako sa o čiriklja ko nebo hem zako sa o stvorenja so lazinena phuvjaja – zako sa so ana peste isi le o dah e dživdipnasoro – dava sa o zelena biljke zako hajba.”</para>
  <para style="p" vid="GEN 1:30">I ađahar ulo.<verse eid="GEN 1:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 1:31" />Tegani o Devel dikhlja sa so stvorinđa hem sa adava inele but šukar.</para>
  <para style="p" vid="GEN 1:31">I inele rat, hem inele sabale – adava inele o šofto dive.<verse eid="GEN 1:31" /></para>
  <chapter eid="GEN 1" />
  <chapter number="2" style="c" sid="GEN 2" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 2:1" />Ađahar inele završime o nebo hem i phuv hem sa soi ano lende.<verse eid="GEN 2:1" /></para>
  <para style="s1">O eftato dive – o dive zako odmor</para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 2:2" />Đi o eftato dive o Devel završinđa sa ple delja, a ko eftato dive o Devel odmorinđa pe oto sa ple delja. <verse eid="GEN 2:2" /><verse number="3" style="v" sid="GEN 2:3" />Tegani o Devel blagoslovinđa o eftato dive hem posvetinđa le, adalese so ko adava dive odmorinđa pe oto sa ple delja save stvorinđa.<verse eid="GEN 2:3" /></para>
  <para style="s">O Edensko vrt</para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 2:4" />Adavai o izveštaj e nebostar hem e phuvjatar kad inele stvorime.</para>
  <para style="p" vid="GEN 2:4">Kad o GOSPOD o Devel stvorinđa i phuv hem o nebo,<verse eid="GEN 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 2:5" />pana na iklile ni divlja, a ni poljska biljke ki phuv, adalese so o GOSPOD o Devel pana na muklja bršim upri phuv hem na inele manuš te ćerel buti upro late, <verse eid="GEN 2:5" /><verse number="6" style="v" sid="GEN 2:6" />nego andral oti phuv o pani uštela ine hem natopini i površina e phuvjakiri.<verse eid="GEN 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 2:7" />O GOSPOD o Devel oblikujinđa e manuše oto prah e phuvjakoro, hem ano nak phudinđa lese o dah e dživdipnasoro, hem o manuš ulo dživdo biće. <verse eid="GEN 2:7" /><verse number="8" style="v" sid="GEN 2:8" />Tegani o GOSPOD o Devel zasadinđa o vrt ano Eden, ko istok, hem ano leste čhivđa e manuše kole oblikujinđa. <verse eid="GEN 2:8" /><verse number="9" style="v" sid="GEN 2:9" />O GOSPOD o Devel ćerđa oti phuv te barjon svako vrsta oto kašta savei šukar zako dikhiba hem šukar zako hajba, a ano maškar e vrtesoro inele o kaš e dživdipnasoro hem o kaš e pendžaripnasoro, savo dela te džanel pe soi šukar, a soi bišukar.<verse eid="GEN 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 2:10" />Taro Eden ikljola ine i len savi natopini ine o vrt, a adathar razdvojini pe ine ko štar avera glavna lenja. <verse eid="GEN 2:10" /><verse number="11" style="v" sid="GEN 2:11" />I prvo vičini pe Pišon hem thavdela maškari sa i phuv Havila, ani savi isi zlato. <verse eid="GEN 2:11" /><verse number="12" style="v" sid="GEN 2:12" />O zlato adala phuvjakoroi but šukar, a ano late isi hem mirisna smole hem draga bara oniks. <verse eid="GEN 2:12" /><verse number="13" style="v" sid="GEN 2:13" />I dujto len vičini pe Gihon hem thavdela maškari sa i phuv Kuš. <verse eid="GEN 2:13" /><verse number="14" style="v" sid="GEN 2:14" />I trito len vičini pe Tigar hem thavdela istočno oti Asirija. I štartoi len Eufrat.<verse eid="GEN 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 2:15" />O GOSPOD o Devel lelja e manuše hem čhivđa le ano edensko vrt, te ćerel buti ano leste hem te brinini olestar.<verse eid="GEN 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 2:16" />O GOSPOD o Devel naredinđa e manušese: “Oto svako kaš ano vrt šaj slobodno te ha, <verse eid="GEN 2:16" /><verse number="17" style="v" sid="GEN 2:17" />ali oto kaš e pendžaripnasoro, savo dela te džanel pe soi šukar, a soi bišukar ma te ha! Adalese so, ko adava dive kad olestar ka ha, sigurno ka mere.”<verse eid="GEN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 2:18" />Tegani o GOSPOD o Devel phenđa: “Nane šukar zako manuš te ovel korkoro. Ka ćerav lese pomoćnica koja ka priličini lese.”<verse eid="GEN 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 2:19" />O GOSPOD o Devel oti phuv oblikujinđa sa e životinjen hem sa e čirikljen, pa anđa len anglo manuš, te dikhel save anava o manuš ka del len. Hem sar god o manuš vičinđa nesave dživde biće – ađahar ulo lesoro anav. <verse eid="GEN 2:19" /><verse number="20" style="v" sid="GEN 2:20" />Ađahar o manuš dinđa anava sa e stokenđe, e čirikljenđe hem sa e divljone životinjenđe.</para>
  <para style="p" vid="GEN 2:20">Ali zako Adam na arakhlja pe pomoćnica koja priličini lese. <verse eid="GEN 2:20" /><verse number="21" style="v" sid="GEN 2:21" />Adalese o GOSPOD o Devel muklja zoralo sojba upro manuš. Kad o manuš zasuća, o Devel ikalđa lestar jekh rebro hem adava than pherđa maseja. <verse eid="GEN 2:21" /><verse number="22" style="v" sid="GEN 2:22" />Oto rebro savo ikalđa e manušestar, o GOSPOD o Devel ćerđa e đuvlja hem anđa la anglo manuš.<verse eid="GEN 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 2:23" />A o manuš phenđa:</para>
  <para style="b" vid="GEN 2:23" />
  <para style="q1" vid="GEN 2:23">“Ače, napokon kokalo mle kokalendar</para>
  <para style="q2" vid="GEN 2:23">hem telo mle telostar!</para>
  <para style="q1" vid="GEN 2:23">Nek vičini pe ‘đuvli’,</para>
  <para style="q2" vid="GEN 2:23">adalese so lelja pe e manušestar.”<verse eid="GEN 2:23" /></para>
  <para style="b" />
  <para style="p">
    <verse number="24" style="v" sid="GEN 2:24" />Adalese o manuš ka ačhaj pe dade hem pe daja hem ka ovel jekh pe romnjaja, hem on duj ka oven jekh telo.<verse eid="GEN 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 2:25" />A soduj inele nange, hem o manuš hem lesiri romni, ali na lađandile.<verse eid="GEN 2:25" /></para>
  <chapter eid="GEN 2" />
  <chapter number="3" style="c" sid="GEN 3" />
  <para style="s">O prvo greh</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 3:1" />A o sap inele po lukavo oto sa divlja životinje saven o GOSPOD o Devel ćerđa.</para>
  <para style="p" vid="GEN 3:1">Ov pučlja e đuvlja: “Čače li o Devel phenđa tumenđe: ‘Na troman te han oto nijekh kaš ano vrt?’ ”<verse eid="GEN 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 3:2" />I đuvli phenđa e sapese: “O plodija oto kašta ano vrt amen tromaja te ha, <verse eid="GEN 3:2" /><verse number="3" style="v" sid="GEN 3:3" />sem o plod oto kaš savoi ano maškar e vrtesoro, zako savo o Devel phenđa: ‘Ma te han olestar ni ma te pipinen le, te na meren!’ ”<verse eid="GEN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 3:4" />Tegani o sap phenđa e đuvljaće: “Na, sigurno naka meren. <verse eid="GEN 3:4" /><verse number="5" style="v" sid="GEN 3:5" />Nego, džanel o Devel: kad ka han olestar, ka phravđon tumare jaćha hem ka oven sar o Devel – ka džanen soi šukar, a soi bišukar.”<verse eid="GEN 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 3:6" />I đuvli dikhlja dai o plod oto kaš šukar hajbnase, dai šukar zako dikhiba hem dai poželjno zbog i mudrost savi šaj te del. Pa lelja o plod oto kaš hem halja le. A dinđa le hem ple romese, kova inele olaja, pa hem ov halja. <verse eid="GEN 3:6" /><verse number="7" style="v" sid="GEN 3:7" />Tegani sodujengere jaćha phravdile hem halile dai nange. Adalese pletinde o listija e smokvakere hem ćerdefse nešto soja te učharen pe.<verse eid="GEN 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 3:8" />Tegani šunde o phiriba e GOSPODESORO e Devlesoro kova phirela ine ano vrt kad lelja te raćol, pa garavde pe olestar maškaro kašta ano vrt.<verse eid="GEN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 3:9" />O GOSPOD o Devel vičinđa e manuše hem pučlja le: “Kaj injan?”<verse eid="GEN 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 3:10" />A o manuš phenđa: “Šunđum to phiriba ano vrt hem darandiljum, adalese so injum nango, i garavđum man.”<verse eid="GEN 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 3:11" />A o Devel pučlja le: “Ko phenđa će da injan nango? Na li haljan oto kaš savestar naredinđum će te na ha?”<verse eid="GEN 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 3:12" />A o manuš phenđa: “I đuvli kola tu čhivđan te ovel mancar, oj dinđa man o plod oto kaš, pa me haljum.”<verse eid="GEN 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 3:13" />Tegani o GOSPOD o Devel pučlja e đuvlja: “So ćerđan adava?”</para>
  <para style="p" vid="GEN 3:13">A i đuvli phenđa: “O sap prevarinđa man, pa haljum.”<verse eid="GEN 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 3:14" />Tegani o GOSPOD o Devel phenđa e sapese:</para>
  <para style="b" vid="GEN 3:14" />
  <para style="q1" vid="GEN 3:14">“Adalese so ćerđan adava,</para>
  <para style="q2" vid="GEN 3:14">prokleto te ove maškari sa i stoka</para>
  <para style="q2" vid="GEN 3:14">hem maškaro sa o divlja životinje!</para>
  <para style="q1" vid="GEN 3:14">Ko vođi ka vucine tut</para>
  <para style="q2" vid="GEN 3:14">hem prašina ka ha</para>
  <para style="q2" vid="GEN 3:14">sa o dive te dživdipnasere.<verse eid="GEN 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="GEN 3:15" />A me ka čhivav neprijateljstvo</para>
  <para style="q2" vid="GEN 3:15">maškara tute hem i đuvli,</para>
  <para style="q1" vid="GEN 3:15">hem maškaro klo potomstvo</para>
  <para style="q2" vid="GEN 3:15">hem olakoro potomstvo.</para>
  <para style="q1" vid="GEN 3:15">Ov ka zdrobini to šero,</para>
  <para style="q2" vid="GEN 3:15">a tu ka ha le ki patum.”<verse eid="GEN 3:15" /></para>
  <para style="b" />
  <para style="p">
    <verse number="16" style="v" sid="GEN 3:16" />A e đuvljaće phenđa:</para>
  <para style="b" vid="GEN 3:16" />
  <para style="q1" vid="GEN 3:16">“Ka barjarav te muke e bijandipnasere;</para>
  <para style="q2" vid="GEN 3:16">ano muke ka bijane čhaven.</para>
  <para style="q1" vid="GEN 3:16">Ka ovel tut želja te romese,</para>
  <para style="q2" vid="GEN 3:16">a ov ka vladini upra tute.”<verse eid="GEN 3:16" /></para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" sid="GEN 3:17" />A e Adamese phenđa:</para>
  <para style="b" vid="GEN 3:17" />
  <para style="q1" vid="GEN 3:17">“Adalese so šunđan te romnja</para>
  <para style="q2" vid="GEN 3:17">hem haljan oto kaš zako savo naredinđum će: ‘Ma te ha olestar!’, ače:</para>
  <para style="q2" vid="GEN 3:17">I phuv nek ovel prokleto zbog tute.</para>
  <para style="q1" vid="GEN 3:17">Mukaja ka ha olatar</para>
  <para style="q2" vid="GEN 3:17">sa o dive te dživdipnasere.<verse eid="GEN 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="GEN 3:18" />Oj ka bijani će kare hem korov,</para>
  <para style="q2" vid="GEN 3:18">a tu ka ha o biljke oto polje.<verse eid="GEN 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="GEN 3:19" />Ano znoj te mujesoro maro ka ha,</para>
  <para style="q2" vid="GEN 3:19">sa đikote na irineja tut ani phuv,</para>
  <para style="q1" vid="GEN 3:19">adalese so oti phuv injan ćerdo</para>
  <para style="q2" vid="GEN 3:19">– prah injan hem ano prah ka irine tut. ”<verse eid="GEN 3:19" /></para>
  <para style="b" />
  <para style="p">
    <verse number="20" style="v" sid="GEN 3:20" />O manuš dinđa pla romnjaće anav Eva,<note caller="+" style="f"><char style="fr" closed="false">3,20 </char><char style="fq" closed="false">Eva </char><char style="ft" closed="false">značini “dživdi” ili “okoja koja dela dživdipe”.</char></note> adalese soi oj daj sa e dživdenđe.<verse eid="GEN 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 3:21" />O GOSPOD o Devel ćerđa e Adamese hem lese romnjaće šeja oti koža hem urjavđa len.<verse eid="GEN 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 3:22" />Tegani o GOSPOD o Devel phenđa: “Ače, o manuš akana ulo sar jekh amendar, adalese so džanel soi šukar, a soi bišukar. Adalese na tromal te mukel pe lese te pružini plo vas hem te lel o plod oto kaš e dživdipnasoro, pa te hal le hem te živini večno.”<verse eid="GEN 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 3:23" />Adalese o GOSPOD o Devel ispudinđa le taro edensko vrt, te ćerel buti upri phuv oti savi hem inele ćerdo. <verse eid="GEN 3:23" /><verse number="24" style="v" sid="GEN 3:24" />Kad ispudinđa e manuše, istočno oto edensko vrt čhivđa heruvimija hem jagalo mači, savo kretini pe ine ko sa o strane, te pazinen o drom savo legari nakoro kaš e dživdipnasoro.<verse eid="GEN 3:24" /></para>
  <chapter eid="GEN 3" />
  <chapter number="4" style="c" sid="GEN 4" />
  <para style="s">O Kain hem o Avelj</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 4:1" />O Adam suća pla romnjaja e Evaja, hem oj ačhili khamni hem bijanđa e Kaine.</para>
  <para style="p" vid="GEN 4:1">Tegani oj phenđa: “O GOSPOD pomožinđa man te dobinav murše čhave!”<verse eid="GEN 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 4:2" />Palo adava oj bijanđa hem e Kainesere phrale e Avelje. O Avelj inele pastiri, a o Kain zemljoradniko.<verse eid="GEN 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 4:3" />Palo nesavo vreme, o Kain prinosinđa e GOSPODESE žrtva oto plodija e phuvjakere, <verse eid="GEN 4:3" /><verse number="4" style="v" sid="GEN 4:4" />a o Avelj prinosinđa o najšukar kotora oto mas oti prvina ple stadosiri. O GOSPOD prihvatinđa e Aveljesiri žrtva, <verse eid="GEN 4:4" /><verse number="5" style="v" sid="GEN 4:5" />ali e Kaine hem lesiri žrtva na prihvatinđa. Adalese o Kain but holjanđa hem muklja po muj.<verse eid="GEN 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 4:6" />O GOSPOD pučlja e Kaine: “Sose injan holjame hem sose mukljan to muj? <verse eid="GEN 4:6" /><verse number="7" style="v" sid="GEN 4:7" />Te ćereja okova soi šukar, ka ove prihvatime. A te na ćereja okova soi šukar, o grehi anglo to udar. Ov mangela te prelel tut, ali tu mora te nadvladine le.”<verse eid="GEN 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 4:8" />O Kain phenđa ple phralese e Aveljese: “Hajde ano polje.”</para>
  <para style="p" vid="GEN 4:8">A kad inele ano polje, o Kain uštino upro Avelj hem mudarđa le.<verse eid="GEN 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 4:9" />O GOSPOD pučlja e Kaine: “Kaj to phral o Avelj?”</para>
  <para style="p" vid="GEN 4:9">O Kain phenđa: “Na džanav. Me li injum čuvari mle phralesoro?”<verse eid="GEN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 4:10" />Tegani o GOSPOD phenđa: “So ćerđan adava? Eče o rat te phralesoro vičini tari phuv nakora mande. <verse eid="GEN 4:10" /><verse number="11" style="v" sid="GEN 4:11" />Adalese ov prokleto hem ispudime e phuvjatar savi phravđa plo muj te primini o rat te phralesoro savo čhorđan te vasteja. <verse eid="GEN 4:11" /><verse number="12" style="v" sid="GEN 4:12" />Kad ka ćere buti upri phuv, oj naka del tut više plo bijandipe. Ka ove lutalica hem begunco ki phuv.”<verse eid="GEN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 4:13" />O Kain phenđa e GOSPODESE: “Mli kaznai po bari nego so šaj te akharav la. <verse eid="GEN 4:13" /><verse number="14" style="v" sid="GEN 4:14" />Ače, avdive ispudineja man akala phuvjatar. Ka garavav man te mujestar, hem ka ovav lutalica hem begunco ki phuv, hem ko god ka arakhi man, ka mudari man.”<verse eid="GEN 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 4:15" />O GOSPOD phenđa lese: “Na! Te neko mudari e Kaine, ka resel le efta puti po bari osveta.”</para>
  <para style="p" vid="GEN 4:15">Tegani o GOSPOD čhivđa znako upro Kain, te na mudari le neko kad ka resel le.<verse eid="GEN 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 4:16" />Tegani o Kain cidinđa pe oto muj e GOSPODESORO hem lelja te živini ani phuv Nod, istočno oto Eden.<verse eid="GEN 4:16" /></para>
  <para style="s">E Kainesere potomci</para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 4:17" />O Kain suća pla romnjaja, hem oj ačhili khamni hem bijanđa e Enohe. O Kain izgradinđa diz hem dinđa la anav palo plo čhavo – Enoh. <verse eid="GEN 4:17" /><verse number="18" style="v" sid="GEN 4:18" />E Enohese bijandilo o Irad, e Iradese bijandilo o Mehujael. E Mehujaelese bijandilo o Metušael, a e Metušaelese bijandilo o Lameh.<verse eid="GEN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 4:19" />E Lamehe ine duj romnja: jekhakoro anav inele Ada, a e dujtonakoro Cila. <verse eid="GEN 4:19" /><verse number="20" style="v" sid="GEN 4:20" />I Ada bijanđa e Javale kovai pradad okolengoro kola živinena talo šatorija hem kola arakhena stoka. <verse eid="GEN 4:20" /><verse number="21" style="v" sid="GEN 4:21" />Lesere phralesoro anav inele Juval. Ovi pradad okolengoro kola bašalena harfa hem flauta. <verse eid="GEN 4:21" /><verse number="22" style="v" sid="GEN 4:22" />I Cila bijanđa e Tuval Kaine, kova inele kovači oti svako vrsta alatija oti bronza hem oto sastren. Lesere phenjakoro anav inele Naama.<verse eid="GEN 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 4:23" />O Lameh phenđa ple romnjenđe:</para>
  <para style="b" vid="GEN 4:23" />
  <para style="q1" vid="GEN 4:23">“Ado hem Cilo, šunen man,</para>
  <para style="q2" vid="GEN 4:23">e Lamehesere romnjalen, phraven tumare kana mle lafonenđe.</para>
  <para style="q1" vid="GEN 4:23">Mudarđum e manuše adalese so raninđa man,</para>
  <para style="q2" vid="GEN 4:23">e terne murše adalese so khuvđa man.<verse eid="GEN 4:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="GEN 4:24" />Te o Kain ka ovel efta puti osvetime,</para>
  <para style="q2" vid="GEN 4:24">o Lameh ka ovel eftavardešu efta.”<verse eid="GEN 4:24" /></para>
  <para style="s">O Sit hem o Enos</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 4:25" />O Adam palem suća pla romnjaja, hem oj bijanđa čhave hem dinđa le anav Sit,<note caller="+" style="f"><char style="fr" closed="false">4,25 </char><char style="fq" closed="false">Sit </char><char style="ft" closed="false">značini “dindo” ili “poklonime”.</char></note> vaćerindoj: “O Devel dinđa man dujtone čhave umesto o Avelj, kole o Kain mudarđa.”<verse eid="GEN 4:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 4:26" />E Sitese bijandilo čhavo hem ov dinđa le anav Enos.</para>
  <para style="p" vid="GEN 4:26">Ano adava vreme o manuša lelje te slavinen e GOSPODE<note caller="+" style="f"><char style="fr" closed="false">4,26 </char><char style="fq" closed="false">te slavinen e GOSPODE </char><char style="ft" closed="false">doslovno: te vičinen e Jahvesoro (e GOSPODESORO) anav.</char></note>.<verse eid="GEN 4:26" /></para>
  <chapter eid="GEN 4" />
  <chapter number="5" style="c" sid="GEN 5" />
  <para style="s">E Adamesere potomci</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 5:1" />Akavai o zapis e Adamesere potomkonendar:</para>
  <para style="p" vid="GEN 5:1">Kad o Devel stvorinđa e manuše, ćerđa le te ovel pali olesiri slika. <verse eid="GEN 5:1" /><verse number="2" style="v" sid="GEN 5:2" />Stvorinđa murše hem đuvlja hem blagoslovinđa len, a kad stvorinđa len, dinđa len anav “manuša”.<verse eid="GEN 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 5:3" />Kad e Adame ine šelu trijanda berš, bijandilo lese čhavo slično olese, ki lesiri slika hem ov dinđa le anav Sit. <verse eid="GEN 5:3" /><verse number="4" style="v" sid="GEN 5:4" />Palo adava so bijandilo o Sit, o Adam živinđa pana oftošel berš hem bijandile lese pana čhave hem čhaja. <verse eid="GEN 5:4" /><verse number="5" style="v" sid="GEN 5:5" />O Adam ukupno živinđa enjašelu trijanda berš hem mulo.<verse eid="GEN 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 5:6" />Kad e Site ine šelu pandž berš, bijandilo lese o Enos. <verse eid="GEN 5:6" /><verse number="7" style="v" sid="GEN 5:7" />Palo adava so bijandilo o Enos, o Sit živinđa pana oftošelu efta berš hem bijandile lese pana čhave hem čhaja. <verse eid="GEN 5:7" /><verse number="8" style="v" sid="GEN 5:8" />O Sit ukupno živinđa enjašelu dešu duj berš hem mulo.<verse eid="GEN 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 5:9" />Kad e Enose ine enjavardeš berš, bijandilo lese o Kainam. <verse eid="GEN 5:9" /><verse number="10" style="v" sid="GEN 5:10" />Palo adava so bijandilo o Kainam, o Enos živinđa pana oftošelu dešu pandž berš hem bijandile lese pana čhave hem čhaja. <verse eid="GEN 5:10" /><verse number="11" style="v" sid="GEN 5:11" />O Enos ukupno živinđa enjašelu pandž berš hem mulo.<verse eid="GEN 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 5:12" />Kad e Kainame ine eftavardeš berš, bijandilo lese o Malaleil. <verse eid="GEN 5:12" /><verse number="13" style="v" sid="GEN 5:13" />Palo adava so bijandilo o Malaleil, o Kainam živinđa pana oftošelu saranda berš hem bijandile lese pana čhave hem čhaja. <verse eid="GEN 5:13" /><verse number="14" style="v" sid="GEN 5:14" />O Kainam ukupno živinđa enjašelu deš berš hem mulo.<verse eid="GEN 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 5:15" />Kad e Malaleile ine šovardešu pandž berš, bijandilo lese o Jaret. <verse eid="GEN 5:15" /><verse number="16" style="v" sid="GEN 5:16" />Palo adava so bijandilo o Jaret, o Malaleil živinđa pana oftošelu trijanda berš hem bijandile lese pana čhave hem čhaja. <verse eid="GEN 5:16" /><verse number="17" style="v" sid="GEN 5:17" />O Malaleil ukupno živinđa oftošelu enjavardešu pandž berš hem mulo.<verse eid="GEN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 5:18" />Kad e Jarete ine šelu šovardešu duj berš, bijandilo lese o Enoh. <verse eid="GEN 5:18" /><verse number="19" style="v" sid="GEN 5:19" />Palo adava so bijandilo o Enoh, o Jaret živinđa pana oftošel berš hem bijandile lese pana čhave hem čhaja. <verse eid="GEN 5:19" /><verse number="20" style="v" sid="GEN 5:20" />O Jaret ukupno živinđa enjašelu šovardešu duj berš hem mulo.<verse eid="GEN 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 5:21" />Kad e Enohe ine šovardešu pandž berš, bijandilo lese o Matusala. <verse eid="GEN 5:21" /><verse number="22" style="v" sid="GEN 5:22" />Palo adava so bijandilo o Matusala, o Enoh živinđa trišel berš ćerindoj okova soi pali e Devlesiri<note caller="+" style="f"><char style="fr" closed="false">5,22 </char><char style="fq" closed="false">živinđa trišel berš ćerindoj okova soi pali e Devlesiri </char><char style="ft" closed="false">Doslovno: phirđa e Devleja; isto hem ano bišu štarto stih.</char></note> volja hem bijandile lese pana čhave hem čhaja. <verse eid="GEN 5:22" /><verse number="23" style="v" sid="GEN 5:23" />O Enoh ukupno živinđa trišelu šovardešu pandž berš. <verse eid="GEN 5:23" /><verse number="24" style="v" sid="GEN 5:24" />O Enoh živinđa ćerindoj okova soi pali e Devlesiri volja, a onda nestaninđa, adalese so o Devel lelja le.<verse eid="GEN 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 5:25" />Kad e Matusale ine šelu oftovardešu efta berš, bijandilo lese o Lameh. <verse eid="GEN 5:25" /><verse number="26" style="v" sid="GEN 5:26" />Palo adava so bijandilo o Lameh, o Matusala živinđa pana eftašelu oftovardešu duj berš hem bijandile lese pana čhave hem čhaja. <verse eid="GEN 5:26" /><verse number="27" style="v" sid="GEN 5:27" />O Matusala ukupno živinđa enjašelu šovardešu enja berš hem mulo.<verse eid="GEN 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 5:28" />Kad e Lamehe ine šelu oftovardešu duj berš, bijandilo lese čhavo. <verse eid="GEN 5:28" /><verse number="29" style="v" sid="GEN 5:29" />Ov dinđa le anav Noje,<note caller="+" style="f"><char style="fr" closed="false">5,29 </char><char style="fq" closed="false">Noje </char><char style="ft" closed="false">zvučini sar o lafi: “te utešini”.</char></note> vaćerindoj: “Ov ka utešini amen ani amari phari buti savi mora te ćera ki phuv savi o GOSPOD prokletinđa.” <verse eid="GEN 5:29" /><verse number="30" style="v" sid="GEN 5:30" />Palo adava so bijandilo o Noje, o Lameh živinđa pana panšelu enjavardešu pandž berš hem bijandile lese pana čhave hem čhaja. <verse eid="GEN 5:30" /><verse number="31" style="v" sid="GEN 5:31" />O Lameh ukupno živinđa eftašelu eftavardešu efta berš hem mulo.<verse eid="GEN 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 5:32" />Kad e Noje ine panšel berš, bijandile lese o Sim, o Ham hem o Jafet.<verse eid="GEN 5:32" /></para>
  <chapter eid="GEN 5" />
  <chapter number="6" style="c" sid="GEN 6" />
  <para style="s">O manuša ule bišukar</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 6:1" />Sar o manuša lelje te množinen pe hem te širinen pe ki phuv, bijandile lenđe čhaja. <verse eid="GEN 6:1" /><verse number="2" style="v" sid="GEN 6:2" />O čhave e Devlesere dikhle dai o čhaja e manušengere šuže, pa lelje len romnjenđe, kas god mangle.<verse eid="GEN 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 6:3" />Tegani o GOSPOD phenđa: “Mlo duho, kova dela dživdipe, naka ačhol zauvek ano manuš, adalese soi o manuš telesno. Adalese, o manuš naka živini više oto šelu biš berš.”<verse eid="GEN 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 6:4" />Ano adava vreme, a hem kasnije, ki phuv živinde o Nefilimija,<note caller="+" style="f"><char style="fr" closed="false">6,4 </char><char style="fq" closed="false">Nefilimija </char><char style="ft" closed="false">Akava lafi zvučini sar o jevrejsko vaćeriba zako: “okola kola pele”.</char></note> adalese so o čhave e Devlesere suće e manušengere čhajencar hem on bijande lenđe čhaven. On inele ratnici, prešunde manuša pana taro purano vreme.<verse eid="GEN 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 6:5" />O GOSPOD dikhlja kobori baro e manušesoro bišukaripe ki phuv hem dai o mislija lesere vilesere stalno irime samo nakoro bišukaripe. <verse eid="GEN 6:5" /><verse number="6" style="v" sid="GEN 6:6" />O GOSPOD pokajinđa pe so stvorinđa e manušen ki phuv hem ano lesoro vilo inele bari dukh.<verse eid="GEN 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 6:7" />Adalese o GOSPOD phenđa: “Ka uništinav ki phuv e manušen kolen stvorinđum, zajedno e životinjencar hem okolencar so lazinena phuvjaja hem e čirikljencar savei ko nebo, adalese so pokajinđum man so stvorinđum len.”<verse eid="GEN 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 6:8" />Ali o Noje arakhlja milost anglo GOSPOD.<verse eid="GEN 6:8" /></para>
  <para style="s">O Noje hem i priprema zako potop</para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 6:9" />Akavai o zapis oto Noje:</para>
  <para style="p" vid="GEN 6:9">O Noje inele pravedno manuš, bizi mana maškaro manuša kola živinde lese ano vreme, hem ćerđa okova soi pali e Devlesiri volja. <verse eid="GEN 6:9" /><verse number="10" style="v" sid="GEN 6:10" />Ole ine trin čhave: o Sim, o Ham hem o Jafet.<verse eid="GEN 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 6:11" />A i phuv anglo Devel inele rumime hem inele pherdi nasilje.<verse eid="GEN 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 6:12" />O Devel dikhlja da i phuv inele rumime, adalese so sa o manuša ki phuv ruminde pe, <verse eid="GEN 6:12" /><verse number="13" style="v" sid="GEN 6:13" />pa phenđa e Nojese: “Odlučinđum te uništinav sa e manušen, adalese so i phuv pherdili nasilje zbog olende. Ače, ka uništinav len zajedno e phuvjaja. <verse eid="GEN 6:13" /><verse number="14" style="v" sid="GEN 6:14" />Adalese ćer tuće barka oto kaš čempres. Ano late ćer pregrade, a avrijal hem andral makh la smolaja. <verse eid="GEN 6:14" /><verse number="15" style="v" sid="GEN 6:15" />Ađahar ćer la: nek ovel šelu trijandu pandž metarija glego, bišu duj metarija buli hem dešu trin metarija uči. <verse eid="GEN 6:15" /><verse number="16" style="v" sid="GEN 6:16" />Ćer o krov ki barka ađahar da oto vrh na tele te ovel phravdo ekvaš metari zako svetlost. O udar čhiv ki jekh strana oti barka hem ćer te ovel la teluno, srednjo hem upruno sprati.<verse eid="GEN 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 6:17" />Ače, ka mukav o baro pani ki phuv te uništini svako stvorenje talo nebo savo ana peste isi le o dah e dživdipnasoro. Sa soi ki phuv, ka merel. <verse eid="GEN 6:17" /><verse number="18" style="v" sid="GEN 6:18" />Ali tuja ka phandav savez. Ka đerdine ani barka, tu, ti romni, te čhave hem lengere romnja. <verse eid="GEN 6:18" /><verse number="19" style="v" sid="GEN 6:19" />A oto svako dživdo biće čhiv tuja ani barka po dujen, murše hem đuvlja, te preživinen tuja. <verse eid="GEN 6:19" /><verse number="20" style="v" sid="GEN 6:20" />Oti svako vrsta e čirikljendar, oti svako vrsta e životinjendar hem oti svako vrsta e stvorenjendar so lazinena phuvjaja po duj nek đerdinen kora tute, te preživinen. <verse eid="GEN 6:20" /><verse number="21" style="v" sid="GEN 6:21" />Le tuja sa o vrste oto hajba hem arakh ani barka, te ovel hem tuće hem olenđe zako hajba.”<verse eid="GEN 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 6:22" />I o Noje ćerđa sa ađahar sar so naredinđa lese o Devel.<verse eid="GEN 6:22" /></para>
  <chapter eid="GEN 6" />
  <chapter number="7" style="c" sid="GEN 7" />
  <para style="s">O potop</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 7:1" />O GOSPOD phenđa e Nojese: “Đerdin ani barka, tu hem sa ti porodica, adalese so dikhljum da jedino tu angla mande injan pravedno maškaro manuša kola živinena ano akava vreme. <verse eid="GEN 7:1" /><verse number="2" style="v" sid="GEN 7:2" />Oto sa o čista životinje le tuja po efta parovija: murše hem đuvlja, a oto nečista životinje le po jekh paro: murše hem đuvlja. <verse eid="GEN 7:2" /><verse number="3" style="v" sid="GEN 7:3" />Isto ađahar oto sa o čiriklja savei ko nebo le po efta parovija: murše hem đuvlja, te ovel arakhlo lengoro potomstvo ki sa i phuv. <verse eid="GEN 7:3" /><verse number="4" style="v" sid="GEN 7:4" />Adalese so, zako efta dive ka mukav bršim upri phuv te perel saranda dive hem saranda raća hem ka uništinav ki phuv svako dživdo biće savo ćerđum.”<verse eid="GEN 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 7:5" />I o Noje ćerđa sa so o GOSPOD naredinđa lese.<verse eid="GEN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 7:6" />E Noje ine šovšel berš kad o baro pani alo ki phuv. <verse eid="GEN 7:6" /><verse number="7" style="v" sid="GEN 7:7" />I o Noje đerdinđa ani barka pla romnjaja, ple čhavencar hem lengere romnjencar, te spasini pe oto potop. <verse eid="GEN 7:7" /><verse number="8" style="v" sid="GEN 7:8" />Oto čista hem nečista životinje, oto čiriklja hem oto sa o stvorenja so lazinena phuvjaja, <verse eid="GEN 7:8" /><verse number="9" style="v" sid="GEN 7:9" />đerdinde koro Noje ani barka duj po duj, murš hem đuvli, sar so o Devel naredinđa e Nojese. <verse eid="GEN 7:9" /><verse number="10" style="v" sid="GEN 7:10" />Efta dive palo adava, o baro pani alo upri phuv.<verse eid="GEN 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 7:11" />Kad e Noje ine šovšel berš, ko dešu eftato dive oto dujto masek – ko adava dive sa o izvorija tali phuv lelje zorale te ikljon naupre hem o brane e nebosere phravdile. <verse eid="GEN 7:11" /><verse number="12" style="v" sid="GEN 7:12" />O bršim pelo ki phuv saranda dive hem saranda raća.<verse eid="GEN 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 7:13" />Ko adava isto dive o Noje, lesiri romni, lesere čhave o Sim, o Ham hem o Jafet, hem lengere romnja đerdinde ani barka. <verse eid="GEN 7:13" /><verse number="14" style="v" sid="GEN 7:14" />Olencar đerdinde sa o životinje palo pumare vrste: i stoka, okola so lazinena phuvjaja hem sa o čiriklja. <verse eid="GEN 7:14" /><verse number="15" style="v" sid="GEN 7:15" />Duj po duj oto sa o bićija saven ana peste isi o dah e dživdipnasoro đerdinde koro Noje ani barka. <verse eid="GEN 7:15" /><verse number="16" style="v" sid="GEN 7:16" />Đerdinde murš hem đuvli oto sa o dživde bićija, sar so o Devel naredinđa e Nojese.</para>
  <para style="p" vid="GEN 7:16">Tegani o GOSPOD phandlja o udar palo leste.<verse eid="GEN 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 7:17" />O potop avela ine upri phuv saranda dive. Sar o pani barjola ine, ađahar legari ine i barka hem vazdinđa la oti phuv. <verse eid="GEN 7:17" /><verse number="18" style="v" sid="GEN 7:18" />O pani barilo hem vazdinđa pe uče oti phuv, a i barka plovini ine upro pani. <verse eid="GEN 7:18" /><verse number="19" style="v" sid="GEN 7:19" />Edobor zorale o pani uštino upri phuv da učharđa sa o naj uče planine talo nebo. <verse eid="GEN 7:19" /><verse number="20" style="v" sid="GEN 7:20" />O pani uštino đi sar efta metarija upreder o potopime planine. <verse eid="GEN 7:20" /><verse number="21" style="v" sid="GEN 7:21" />Mule sa o dživde bićija save kretinena ki phuv: o čiriklja, i stoka, o divlja životinje, okola so lazinena phuvjaja hem sa o manuša. <verse eid="GEN 7:21" /><verse number="22" style="v" sid="GEN 7:22" />Ko kopno mudardilo sa so ana peste inole o dah e dživdipnasoro. <verse eid="GEN 7:22" /><verse number="23" style="v" sid="GEN 7:23" />Ađahar o Devel uništinđa svako dživdo biće ki phuv: e manušen, e životinjen, okolen so lazinena phuvjaja hem e čirikljen. Ačhile samo o Noje hem okola kola inele oleja ani barka.<verse eid="GEN 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 7:24" />A o pani učharđa i phuv šelu pinda dive.<verse eid="GEN 7:24" /></para>
  <chapter eid="GEN 7" />
  <chapter number="8" style="c" sid="GEN 8" />
  <para style="s">O Devel zaustavini o potop</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 8:1" />O Devel na bisterđa upro Noje hem upro sa o divlja životinje hem i stoka save inele oleja ani barka, pa ćerđa i barval te phudel upri phuv, hem o pani lelja te cidel pe. <verse eid="GEN 8:1" /><verse number="2" style="v" sid="GEN 8:2" />Phandlile o izvorija tali phuv hem o brane e nebosere, i o bršim ačhilo te perel taro nebo. <verse eid="GEN 8:2" /><verse number="3" style="v" sid="GEN 8:3" />O pani hari po hari cidela pe ine tari phuv, a palo šelu pinda dive edobor pelo tele <verse eid="GEN 8:3" /><verse number="4" style="v" sid="GEN 8:4" />da ko dešu eftato dive oto eftato masek i barka ačhili ki planina Ararat. <verse eid="GEN 8:4" /><verse number="5" style="v" sid="GEN 8:5" />O pani stalno cidela pe ine natele đi ko dešto masek, a ko prvo dive oto dešto masek lelje te dičhon o naj uče thana e planinengere.<verse eid="GEN 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 8:6" />Palo saranda dive, o Noje phravđa o prozori savo ćerđa ki barka <verse eid="GEN 8:6" /><verse number="7" style="v" sid="GEN 8:7" />hem muklja avri e gavrane. O gavran odletini ine hem irini pe sa đikote sa o pani na cidinđa pe tari phuv. <verse eid="GEN 8:7" /><verse number="8" style="v" sid="GEN 8:8" />Tegani o Noje muklja hem e golubica, te dikhel da li o pani cidinđa pe tari površina e phuvjakiri. <verse eid="GEN 8:8" /><verse number="9" style="v" sid="GEN 8:9" />Ali i golubica na arakhlja than ko savo te mukel pe, adalese so o pani pana učharđa sa i površina e phuvjakiri, pa irinđa pe koro Noje ani barka. Ov pružinđa plo vas, dolinđa e golubica hem anđa la ani barka. <verse eid="GEN 8:9" /><verse number="10" style="v" sid="GEN 8:10" />O Noje adžićerđa pana efta dive, i palem muklja e golubica tari barka. <verse eid="GEN 8:10" /><verse number="11" style="v" sid="GEN 8:11" />I golubica irinđa pe angli rat, i dikh, ano muj ine laće tek čhindo listo oti maslina. Palo adava o Noje džanđa da o pani cidinđa pe tari phuv. <verse eid="GEN 8:11" /><verse number="12" style="v" sid="GEN 8:12" />Tegani ov adžićerđa pana efta dive, i palem muklja e golubica, ali oj više na irinđa pe koro leste.<verse eid="GEN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 8:13" />Kad e Noje ine šovšelu jekh berš, ko prvo dive oto prvo masek, o pani cidinđa pe tari phuv. O Noje phravđa jekh deo e krovesoro oti barka, dikhlja okolo, i eče, i površina e phuvjakiri šuki. <verse eid="GEN 8:13" /><verse number="14" style="v" sid="GEN 8:14" />Đi ko bišu eftato dive oto dujto masek i phuv inele skroz šuki.<verse eid="GEN 8:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 8:15" />Tegani o Devel phenđa e Nojese: <verse eid="GEN 8:15" /><verse number="16" style="v" sid="GEN 8:16" />“Ikljov tari barka, tu, ti romni, te čhave hem lengere romnja. <verse eid="GEN 8:16" /><verse number="17" style="v" sid="GEN 8:17" />Tuja ikal hem sa e dživde bićen savei tuja: e čirikljen, e životinjen hem sa okolen so lazinena phuvjaja. Nek i phuv pherđol olencar, nek oven plodna hem nek množinen pe ki phuv.”<verse eid="GEN 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 8:18" />I o Noje iklilo zajedno pla romnjaja, ple čhavencar hem lengere romnjencar. <verse eid="GEN 8:18" /><verse number="19" style="v" sid="GEN 8:19" />Sa o životinje, sa okola so lazinena phuvjaja hem sa o čiriklja – sa so džala phuvjaja – iklile tari barka, vrsta pali vrsta.<verse eid="GEN 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 8:20" />Tegani o Noje vazdinđa žrtveniko e GOSPODESE, i lelja oto sa o čista životinje hem oto sa o čista čiriklja hem adathe žrtvujinđa len sar žrtve paljenice.<verse eid="GEN 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 8:21" />O GOSPOD mirišinđa adava prijatno miris, i phenđa ana peste: “Nikad više naka prokletinav i phuv zbog o manuš, iakoi lesere mislija pana taro tikoripe bišukar, hem nikad više naka uništinav sa e dživde bićen sar so ćerđum.<verse eid="GEN 8:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="GEN 8:22" />Sa đikote ka ovel i phuv, ka ovel</para>
  <para style="q2" vid="GEN 8:22">sejiba hem čediba,</para>
  <para style="q1" vid="GEN 8:22">šil hem tatipe, linaj hem jevend,</para>
  <para style="q2" vid="GEN 8:22">dive hem rat.”<verse eid="GEN 8:22" /></para>
  <chapter eid="GEN 8" />
  <chapter number="9" style="c" sid="GEN 9" />
  <para style="s">E Devlesoro savez e Nojeja</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 9:1" />Tegani o Devel blagoslovinđa e Noje hem lesere čhaven, vaćerindoj: “Oven plodna hem množinen tumen hem pheren i phuv. <verse eid="GEN 9:1" /><verse number="2" style="v" sid="GEN 9:2" />Nek daran tumendar sa o životinje ki phuv hem sa o čiriklja ko nebo, sa o stvorenja so lazinena phuvjaja hem sa o maćhe ano more; oni dinde ano tumare vasta. <verse eid="GEN 9:2" /><verse number="3" style="v" sid="GEN 9:3" />Sa so kretini pe hem soi dživdo, nek ovel tumenđe zako hajba. Sar so dinđum tumen o zelena biljke, ađahar akana dava tumen sa.<verse eid="GEN 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 9:4" />Ali ma han o mas ano savoi pana o rat, adalese so adava značini dai o dživdipe ano leste. <verse eid="GEN 9:4" /><verse number="5" style="v" sid="GEN 9:5" />Zako tumaro rat ano savoi tumaro dživdipe, ka rodav te del pe računi. Ka rodav adava oti svako životinja savi mudari manuše hem oto svako manuš kova mudari avere manuše. Okova kova lela averesoro dživdipe, me ka rodav olesoro dživdipe.<verse eid="GEN 9:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="GEN 9:6" />Ko čhorela o rat e manušesoro,</para>
  <para style="q2" vid="GEN 9:6">aver manuš ka čhorel olesoro rat,</para>
  <para style="q1" vid="GEN 9:6">adalese so pali e Devlesiri slika,</para>
  <para style="q2" vid="GEN 9:6">o Devel ćerđa e manuše.<verse eid="GEN 9:6" /></para>
  <para style="b" />
  <para style="m">
    <verse number="7" style="v" sid="GEN 9:7" />A tumen, oven plodna hem množinen tumen. Širinen tumen ki phuv hem množinen tumen upro late.”<verse eid="GEN 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 9:8" />Tegani o Devel phenđa e Nojese hem lesere čhavenđe: <verse eid="GEN 9:8" /><verse number="9" style="v" sid="GEN 9:9" />“Ače, phandava savez tumencar hem tumare potomstvoja pala tumende, <verse eid="GEN 9:9" /><verse number="10" style="v" sid="GEN 9:10" />hem svakone dživde bićeja savoi tumencar – e čirikljencar, e stokaja hem sa e divljone životinjencar, sa okoleja so iklilo tumencar tari barka – svakone dživde stvorenjeja ki phuv. <verse eid="GEN 9:10" /><verse number="11" style="v" sid="GEN 9:11" />Phandava savez tumencar: Nikad više sa o dživde bićija naka oven mudarde e potopesere panjeja. Nikad više o potop naka uništini i phuv.”<verse eid="GEN 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 9:12" />O Devel phenđa: “Akavai o znako oto savez savo phandava tumencar hem svakone dživde bićeja savoi tumencar, zako sa generacije save ka aven: <verse eid="GEN 9:12" /><verse number="13" style="v" sid="GEN 9:13" />Čhivđum mli duga ano oblaci te ovel znako oto savez maškara mande hem i phuv. <verse eid="GEN 9:13" /><verse number="14" style="v" sid="GEN 9:14" />Kad god ka bičhalav oblaci upri phuv hem upro lende ka dičhol i duga, <verse eid="GEN 9:14" /><verse number="15" style="v" sid="GEN 9:15" />ka setinav man oto mlo savez tumencar hem svakone dživde bićeja. Hem nikad više naka ovel potop savo bi uništini sa e dživde bićen. <verse eid="GEN 9:15" /><verse number="16" style="v" sid="GEN 9:16" />Kad god ano oblako ka mothoj pe i duga, ka dikhav la hem ka setinav man oto večno savez maškaro Devel hem maškaro svako dživdo biće ki phuv.”<verse eid="GEN 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 9:17" />Hem o Devel phenđa e Nojese: “Akavai o znako oto savez savo phandljum maškara mande hem maškaro sa dživde bićija ki phuv.”<verse eid="GEN 9:17" /></para>
  <para style="s">E Nojesere čhave</para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 9:18" />A e Nojesere čhave, kola iklile oti barka, inele: o Sim, o Ham hem o Jafet. (O Ham inele dad e Hanaanesoro.) <verse eid="GEN 9:18" /><verse number="19" style="v" sid="GEN 9:19" />Adala trin inele e Nojesere čhave hem olengere potomci širinde pe ki sa i phuv.<verse eid="GEN 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 9:20" />A o Noje inele zemljoradniko hem prvo manuš kova sadinđa vinograd. <verse eid="GEN 9:20" /><verse number="21" style="v" sid="GEN 9:21" />Jekh dive pilja mol hem matilo, pa nango pašlilo pese ano šatori. <verse eid="GEN 9:21" /><verse number="22" style="v" sid="GEN 9:22" />O Ham, o dad e Hanaanesoro, dikhlja pe dade nange i adava phenđa ple duje phraljenđe kola inele avrijal. <verse eid="GEN 9:22" /><verse number="23" style="v" sid="GEN 9:23" />Tegani o Sim hem o Jafet lelje o ogrtači, čhivde le pese ko piče, hem phirindoj napalal učharde ple nange dade. Mujeja inele irime ki aver strana, ađahar da na dikhle pumare dade nange.<verse eid="GEN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 9:24" />Kad o Noje otrezninđa pe oti mol, dodžanđa so ćerđa lese olesoro najtikneder čhavo. <verse eid="GEN 9:24" /><verse number="25" style="v" sid="GEN 9:25" />Tegani o Noje phenđa:</para>
  <para style="b" vid="GEN 9:25" />
  <para style="q1" vid="GEN 9:25">“Prokleto te ovel o Hanaan,</para>
  <para style="q2" vid="GEN 9:25">te ovel naj teluno robo ple phraljenđe!”<verse eid="GEN 9:25" /></para>
  <para style="b" />
  <para style="p">
    <verse number="26" style="v" sid="GEN 9:26" />Hem phenđa:</para>
  <para style="b" vid="GEN 9:26" />
  <para style="q1" vid="GEN 9:26">“Blagoslovime te ovel o GOSPOD, o Devel e Simesoro,</para>
  <para style="q2" vid="GEN 9:26">o Hanaan te ovel lesoro robo!<verse eid="GEN 9:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="GEN 9:27" />O Devel te umnožini o potomstvo e Jafetesoro,<note caller="+" style="f"><char style="fr" closed="false">9,27 </char><char style="fq" closed="false">Jafetesoro </char><char style="ft" closed="false">zvučini sar lafi: “te raširini”.</char></note></para>
  <para style="q2" vid="GEN 9:27">te živini ano šatorja e Simesere,</para>
  <para style="q2" vid="GEN 9:27">a o Hanaan te ovel lesoro robo!”<verse eid="GEN 9:27" /></para>
  <para style="b" />
  <para style="p">
    <verse number="28" style="v" sid="GEN 9:28" />Palo potop o Noje živinđa pana trišelu pinda berš. <verse eid="GEN 9:28" /><verse number="29" style="v" sid="GEN 9:29" />O Noje ukupno živinđa enjašelu pinda berš hem mulo.<verse eid="GEN 9:29" /></para>
  <chapter eid="GEN 9" />
  <chapter number="10" style="c" sid="GEN 10" />
  <para style="s">E Nojesere čhavengere potomci</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 10:1" />Akavai o zapis e Nojesere čhavendar: e Simestar, e Hamestar, hem e Jafetestar, kolenđe palo potop bijandile čhave.<verse eid="GEN 10:1" /></para>
  <para style="s2">E Jafetesere potomci</para>
  <para style="li">
    <verse number="2" style="v" sid="GEN 10:2" />E Jafetesere čhavei: o Gomer, o Magog, o Madaj, o Javan, o Tuval, o Mešeh hem o Tiras.<verse eid="GEN 10:2" /></para>
  <para style="li">
    <verse number="3" style="v" sid="GEN 10:3" />E Gomeresere čhavei: o Aškenaz, o Rifat hem o Togarma.<verse eid="GEN 10:3" /></para>
  <para style="li">
    <verse number="4" style="v" sid="GEN 10:4" />E Javanestar iklile: o Eliša, o Taršiš, o Kitijci hem o Rodanci. <verse eid="GEN 10:4" /><verse number="5" style="v" sid="GEN 10:5" />Olendar pumenđe ko phuvja razdelinde pe o primorska narodija, premalo pumare plemija ano pumare nacije, svako premali pli čhib.<verse eid="GEN 10:5" /></para>
  <para style="s2">E Hamesere potomci</para>
  <para style="li">
    <verse number="6" style="v" sid="GEN 10:6" />E Hamesere čhavei: o Kuš, o Micrajim, o Put hem o Hanaan.<verse eid="GEN 10:6" /></para>
  <para style="li">
    <verse number="7" style="v" sid="GEN 10:7" />E Kušesere čhavei: o Seva, o Havila, o Savta, o Raama hem o Savteha.</para>
  <para style="li" vid="GEN 10:7">E Raamesere čhavei: o Ševa hem o Dedan.<verse eid="GEN 10:7" /></para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" sid="GEN 10:8" />E Kušese bijandilo o Nimrod, kova inele prvo baro ratniko ki phuv. <verse eid="GEN 10:8" /><verse number="9" style="v" sid="GEN 10:9" />Ov inele zoralo lovco anglo GOSPOD. Adalese phenela pe: “Zoralo lovco anglo GOSPOD sar o Nimrod.” <verse eid="GEN 10:9" /><verse number="10" style="v" sid="GEN 10:10" />Lesoro carstvo ano početak ćerena ine: o Vavilon, o Ereh, o Akad hem o Kalne ani phuv Šinar. <verse eid="GEN 10:10" /><verse number="11" style="v" sid="GEN 10:11" />Tari adaja phuv dželo ani Asirija, kaj izgradinđa i Niniva, o Rehovot Ir, o Kalah <verse eid="GEN 10:11" /><verse number="12" style="v" sid="GEN 10:12" />hem o Resen i bari diz savi terđola maškari Niniva hem o Kalah.<verse eid="GEN 10:12" /></para>
  <para style="b" />
  <para style="li">
    <verse number="13" style="v" sid="GEN 10:13" />E Micrajimestar iklile o Ludijci, o Anamci, o Lehavci, o Naftuhejci, <verse eid="GEN 10:13" /><verse number="14" style="v" sid="GEN 10:14" />o Patrusci, o Kasluhejci, kolendar iklile o Filistejci, hem o Kaftorci.<verse eid="GEN 10:14" /></para>
  <para style="li">
    <verse number="15" style="v" sid="GEN 10:15" />E Hanaanese bijandilo o Sidon, lesoro prvo bijando čhavo, hem o Het. <verse eid="GEN 10:15" /><verse number="16" style="v" sid="GEN 10:16" />E Hanaanestar iklile hem o Jevusejci, o Amorejci, o Girgašanja, <verse eid="GEN 10:16" /><verse number="17" style="v" sid="GEN 10:17" />o Hivijci, o Arkijci, o Sinijci, <verse eid="GEN 10:17" /><verse number="18" style="v" sid="GEN 10:18" />o Arvađanja, o Cemarci hem o Hamaćanja.</para>
  <para style="b" vid="GEN 10:18" />
  <para style="p" vid="GEN 10:18">Palo adava o plemija e Hanaanesere rasejinde pe. <verse eid="GEN 10:18" /><verse number="19" style="v" sid="GEN 10:19" />I hanaansko phuv inele oto Sidon nakori Gerara, sa đi ki Gaza, pa nakori Sodoma, Gomora, Adma hem Cevoim, sa đi ki Laša.<verse eid="GEN 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 10:20" />Adalai e Hamesere potomci, palo pumare plemija hem čhibja, palo pumare phuvja hem narodija.<verse eid="GEN 10:20" /></para>
  <para style="s2">E Simesere potomci</para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 10:21" />A bijandile čhave hem e Simese, e Jafetesere phuredere phralese, kovai pradad zako sa e Everosere potomci.<note caller="+" style="f"><char style="fr" closed="false">10,21 </char><char style="fq" closed="false">Everosere potomci </char><char style="ft" closed="false">Ili: Jevreja.</char></note><verse eid="GEN 10:21" /></para>
  <para style="li">
    <verse number="22" style="v" sid="GEN 10:22" />E Simesere čhavei: o Elam, o Ašur, o Arfaksad, o Lud hem o Aram.<verse eid="GEN 10:22" /></para>
  <para style="li">
    <verse number="23" style="v" sid="GEN 10:23" />A e Aramesere čhavei: o Uc, o Hul, o Geter hem o Maš.<verse eid="GEN 10:23" /></para>
  <para style="li">
    <verse number="24" style="v" sid="GEN 10:24" />E Arfaksadese bijandilo o Sala, a e Salase bijandilo o Ever. <verse eid="GEN 10:24" /><verse number="25" style="v" sid="GEN 10:25" />E Everese bijandile duj čhave. Jekh vičinđa pe Falek,<note caller="+" style="f"><char style="fr" closed="false">10,25 </char><char style="fq" closed="false">Falek </char><char style="ft" closed="false">so značini: “podela”.</char></note> adalese so ano lesoro vreme i phuv podelinđa pe, a olesoro phral vičinđa pe Joktan.<verse eid="GEN 10:25" /></para>
  <para style="li">
    <verse number="26" style="v" sid="GEN 10:26" />E Joktanese bijandile o Almodad, o Šelef, o Hacarmavet, o Jerah, <verse eid="GEN 10:26" /><verse number="27" style="v" sid="GEN 10:27" />o Hadoram, o Uzal, o Dikla, <verse eid="GEN 10:27" /><verse number="28" style="v" sid="GEN 10:28" />o Oval, o Avimael, o Ševa, <verse eid="GEN 10:28" /><verse number="29" style="v" sid="GEN 10:29" />o Ofir, o Havila hem o Jovav. Sa akala inele e Joktanesere čhave. <verse eid="GEN 10:29" /><verse number="30" style="v" sid="GEN 10:30" />Lengere thana, kaj bešena inele oti Meša nakori Sefara, i bregali phuv ko istok.<verse eid="GEN 10:30" /></para>
  <para style="b" />
  <para style="p">
    <verse number="31" style="v" sid="GEN 10:31" />Adalai e Simesere čhave, palo pumare plemija hem čhibja, palo pumare phuvja hem narodija.<verse eid="GEN 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 10:32" />Adalai o plemija e Nojesere čhavengere palo lengere familije ano lengere narodija. Palo potop, olendar ki phuv širinde pe o narodija.<verse eid="GEN 10:32" /></para>
  <chapter eid="GEN 10" />
  <chapter number="11" style="c" sid="GEN 11" />
  <para style="s">I Vavilonsko kula</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 11:1" />A ano adava vreme ki sa i phuv vaćerđa pe samo jekh čhib hem koristinde pe ista lafija. <verse eid="GEN 11:1" /><verse number="2" style="v" sid="GEN 11:2" />Sar o manuša džana ine ko istok, arakhle jekh dolina ani phuv Šinar hem adari lelje te živinen.<verse eid="GEN 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 11:3" />Tegani phende jekh averese: “Hajde te ćera cigle hem te peka len šukar te zoraljon.”</para>
  <para style="p" vid="GEN 11:3">Ađahar koristinde cigla umesto bar, a i smola služinđa lenđe umesto malteri.<verse eid="GEN 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 11:4" />Onda phende: “Hajde te gradina amenđe diz hem kula savakoro vrh ka ovel đi ko nebo. Adaleja ka ćera amenđe baro anav hem te na rasejina amen ki sa i phuv.”<verse eid="GEN 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 11:5" />A o GOSPOD huljilo te dikhel i diz hem i kula so gradinde o manuša.<verse eid="GEN 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 11:6" />O GOSPOD phenđa: “Adalese soi on jekh narodo hem sarijen isi jekh čhib, ondai akava samo početak oto lengere delja. Akana naka ovel lenđe nemoguće te ćeren sa okova so zamislinena. <verse eid="GEN 11:6" /><verse number="7" style="v" sid="GEN 11:7" />Hajde te hulja hem te pomešina lengiri čhib, te na haljoven jekh avere.”<verse eid="GEN 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 11:8" />Ađahar o GOSPOD adathar rasejinđa len ki sa i phuv, pa on ačhavde te gradinen i diz. <verse eid="GEN 11:8" /><verse number="9" style="v" sid="GEN 11:9" />Adalese i diz vičini pe Vavilon,<note caller="+" style="f"><char style="fr" closed="false">11,9 </char><char style="fq" closed="false">Vavilon </char><char style="ft" closed="false">zvučini sar lafi: “te pomešini pe”.</char></note> adalese so adari o GOSPOD pomešinđa i čhib sa e manušengiri, hem adathar rasejinđa len ki sa i phuv.<verse eid="GEN 11:9" /></para>
  <para style="s">E Simesere potomci</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 11:10" />Akavai e Simesere potomci:</para>
  <para style="p" vid="GEN 11:10">Duj berš palo potop, kad e Sime ine šel berš, bijandilo lese o Arfaksad. <verse eid="GEN 11:10" /><verse number="11" style="v" sid="GEN 11:11" />Palo adava so bijandilo o Arfaksad, o Sim živinđa pana panšel berš, hem bijandile lese pana čhave hem čhaja.<verse eid="GEN 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 11:12" />Kad e Arfaksade ine trijandu pandž berš, bijandilo lese o Sala. <verse eid="GEN 11:12" /><verse number="13" style="v" sid="GEN 11:13" />Palo adava so bijandilo o Sala, o Arfaksad živinđa pana štaršelu trin berš, hem bijandile lese pana čhave hem čhaja.<verse eid="GEN 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 11:14" />Kad e Sala ine trijanda berš, bijandilo lese o Ever. <verse eid="GEN 11:14" /><verse number="15" style="v" sid="GEN 11:15" />Palo adava so bijandilo o Ever, o Sala živinđa pana štaršelu trin berš, hem bijandile lese pana čhave hem čhaja.<verse eid="GEN 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 11:16" />Kad e Evere ine trijandu štar berš, bijandilo lese o Falek. <verse eid="GEN 11:16" /><verse number="17" style="v" sid="GEN 11:17" />Palo adava so bijandilo o Falek, o Ever živinđa pana štaršelu trijanda berš, hem bijandile lese pana čhave hem čhaja.<verse eid="GEN 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 11:18" />Kad e Faleke ine trijanda berš, bijandilo lese o Ragav. <verse eid="GEN 11:18" /><verse number="19" style="v" sid="GEN 11:19" />Palo adava so bijandilo o Ragav, o Falek živinđa pana dušelu enja berš, hem bijandile lese pana čhave hem čhaja.<verse eid="GEN 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 11:20" />Kad e Ragave ine trijandu duj berš, bijandilo lese o Seruh. <verse eid="GEN 11:20" /><verse number="21" style="v" sid="GEN 11:21" />Palo adava so bijandilo o Seruh, o Ragav živinđa pana dušelu efta berš, hem bijandile lese pana čhave hem čhaja.<verse eid="GEN 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 11:22" />Kad e Seruhe ine trijanda berš, bijandilo lese o Nahor. <verse eid="GEN 11:22" /><verse number="23" style="v" sid="GEN 11:23" />Palo adava so bijandilo o Nahor, o Seruh živinđa pana dušel berš, hem bijandile lese pana čhave hem čhaja.<verse eid="GEN 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 11:24" />Kad e Nahore ine bišu enja berš, bijandilo lese o Tara. <verse eid="GEN 11:24" /><verse number="25" style="v" sid="GEN 11:25" />Palo adava so bijandilo o Tara, o Nahor živinđa pana šelu dešu enja berš, hem bijandile lese pana čhave hem čhaja.<verse eid="GEN 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 11:26" />Kad e Tara ine eftavardeš berš, bijandile lese o Avram, o Nahor hem o Haran.<verse eid="GEN 11:26" /></para>
  <para style="s">E Avramesiri familija</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 11:27" />Akavai e Tarasere potomci:</para>
  <para style="p" vid="GEN 11:27">E Tarase bijandile o Avram, o Nahor hem o Haran.</para>
  <para style="p" vid="GEN 11:27">E Haranese bijandilo o Lot. <verse eid="GEN 11:27" /><verse number="28" style="v" sid="GEN 11:28" />O Haran mulo angleder ple dadestar e Tarastar, ano Ur Haldejsko, ani phuv kaj bijandilo.<verse eid="GEN 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 11:29" />O Avram hem o Nahor leljefse romnjen. E Avramesiri romni vičinđa pe Saraja, a e Nahoresiri romni vičinđa pe Milka, koja inele čhaj e Haranesiri. O Haran inele e Milkakoro hem e Jiskakoro dad. <verse eid="GEN 11:29" /><verse number="30" style="v" sid="GEN 11:30" />A e Saraja na ine čhave, adalese so inele nerotkinja.<verse eid="GEN 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 11:31" />O Tara lelja ple čhave e Avrame, ple unuko e Lote, kova inele e Haranesoro čhavo, hem pla borja e Saraja, savi inele romni lesere čhavesiri e Avramesiri, hem olencar taro Ur Haldejsko dželo ki phuv Hanaan. Ali kad resle đi ko Haran, lelje te živinen adathe.<verse eid="GEN 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 11:32" />O Tara živinđa dušelu pandž berš hem mulo ano Haran.<verse eid="GEN 11:32" /></para>
  <chapter eid="GEN 11" />
  <chapter number="12" style="c" sid="GEN 12" />
  <para style="s">O Devel vičini e Avrame</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 12:1" />O GOSPOD phenđa e Avramese: “Ačhav ti phuv, te familija hem o čher te dadesoro hem dža ki phuv savi me ka mothovav će.<verse eid="GEN 12:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="GEN 12:2" />Ka ćerav tutar bare narodo</para>
  <para style="q2" vid="GEN 12:2">hem ka blagoslovinav tut.</para>
  <para style="q1" vid="GEN 12:2">To anav ka ćerav te ovel baro,</para>
  <para style="q2" vid="GEN 12:2">a hem korkoro tu ka ove blagoslov.<verse eid="GEN 12:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="GEN 12:3" />Ka blagoslovinav okolen kola tut blagoslovinena,</para>
  <para style="q2" vid="GEN 12:3">a ka prokletinav okolen kola tut prokletinena.</para>
  <para style="q1" vid="GEN 12:3">Prekala tute ka oven blagoslovime</para>
  <para style="q2" vid="GEN 12:3">sa o plemija ki phuv.”<verse eid="GEN 12:3" /></para>
  <para style="b" />
  <para style="p">
    <verse number="4" style="v" sid="GEN 12:4" />I o Avram dželo adathar, sar so phenđa lese o GOSPOD, a oleja dželo hem o Lot. E Avrame ine eftavardešu pandž berš kad dželo taro Haran. <verse eid="GEN 12:4" /><verse number="5" style="v" sid="GEN 12:5" />Peja lelja pe romnja e Saraja, pe phralese čhave e Lote, sa o barvalipe so stekninđa hem sa e robonen so ine len ano Haran, i lelje te džan ki phuv Hanaan. Kad resle adari, <verse eid="GEN 12:5" /><verse number="6" style="v" sid="GEN 12:6" />o Avram nakhlo maškari phuv sa đi ko than Sihem, đi ko baro kaš Morea. Ano adava vreme o Hanaanci živinde ani adaja phuv.<verse eid="GEN 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 12:7" />O GOSPOD mothovđa pe e Avramese hem phenđa lese: “Akaja phuv ka dav te potomstvose.”</para>
  <para style="p" vid="GEN 12:7">Ko adava than o Avram ćerđa žrtveniko e GOSPODESE, kova mothovđa pe lese. <verse eid="GEN 12:7" /><verse number="8" style="v" sid="GEN 12:8" />Adathar dželo ano gore istočno oto Betel, kaj vazdinđa plo šatori. O Betel ine lese ko zapad, a o Aj ko istok. Adari o Avram ćerđa žrtveniko e GOSPODESE hem pokloninđa pe e GOSPODESE. <verse eid="GEN 12:8" /><verse number="9" style="v" sid="GEN 12:9" />A palo adava lelja te putujini oto than ko than premalo Negev.<verse eid="GEN 12:9" /></para>
  <para style="s">O Avram ano Egipat</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 12:10" />A kad ani phuv lelja te ovel bokhalipe, o Avram huljilo ano Egipat te živini adari nesavo vreme, adalese so ani phuv inele but baro bokhalipe.<verse eid="GEN 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 12:11" />Angleder so te đerdini ano Egipat, ov phenđa pe romnjaće e Sarajaće: “Šun, džanav da injan but šuži đuvli. <verse eid="GEN 12:11" /><verse number="12" style="v" sid="GEN 12:12" />Kad ka dikhen tut o Egipćanja, ka phenen: ‘Akavai lesiri romni’, pa man ka mudaren, a tut ka muken te živine. <verse eid="GEN 12:12" /><verse number="13" style="v" sid="GEN 12:13" />Adalese, molinava tut, vaćer da injan mli phen, sar te šaj zbog tute on te oven šukar mancar hem te muken man te živinav.”<verse eid="GEN 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 12:14" />Kad o Avram reslja ano Egipat, o Egipćanja dikhle dai i Saraja but šuži đuvli. <verse eid="GEN 12:14" /><verse number="15" style="v" sid="GEN 12:15" />A dikhle la hem e faraonesere službenici, pa pohvalinde la anglo faraon. Ađahar e Saraja ande ani palata e faraonesiri. <verse eid="GEN 12:15" /><verse number="16" style="v" sid="GEN 12:16" />Zbog olate o faraon inele šukar premalo Avram, pa o Avram stekninđa bakren hem guruven, hernen, slugen hem sluškinjen, hernjen hem kamilen.<verse eid="GEN 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 12:17" />Ali o GOSPOD bičhalđa bare nambormipa upro faraon hem upro olesere čherutne zbog e Avramesiri romni i Saraja.<verse eid="GEN 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 12:18" />Adalese o faraon vičinđa e Avrame hem pučlja le: “So ćerđan maje adava? Sose na phenđan maje dai oj ti romni? <verse eid="GEN 12:18" /><verse number="19" style="v" sid="GEN 12:19" />Sose phenđan: ‘Oj mli phen’, pa me leljum la romnjaće? Ače akana ti romni – le la hem dža!”<verse eid="GEN 12:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 12:20" />Tegani o faraon naredinđa ple manušenđe, hem on ispratinde e Avrame lesere romnjaja hem sa okoleja so inole.<verse eid="GEN 12:20" /></para>
  <chapter eid="GEN 12" />
  <chapter number="13" style="c" sid="GEN 13" />
  <para style="s">O Avram hem o Lot odvojinena pe</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 13:1" />I ađahar o Avram, pe romnjaja hem sa okoleja so inole, dželo taro Egipat upre ano Negev. Oleja inele hem o Lot. <verse eid="GEN 13:1" /><verse number="2" style="v" sid="GEN 13:2" />E Avrame ine baro barvalipe ani stoka, srebro hem zlato. <verse eid="GEN 13:2" /><verse number="3" style="v" sid="GEN 13:3" />Taro Negev oto than ko than putujinđa sa đi ko Betel, đi ko okova than maškaro Betel hem o Aj kaj angleder ine lesoro šatori <verse eid="GEN 13:3" /><verse number="4" style="v" sid="GEN 13:4" />hem kaj ćerđa ine o žrtveniko. Adari o Avram pokloninđa pe e GOSPODESE.<verse eid="GEN 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 13:5" />A hem o Lot, kova putujinđa e Avrameja, inole sitno hem krupno stoka hem šatorja. <verse eid="GEN 13:5" /><verse number="6" style="v" sid="GEN 13:6" />Adaja phuv našti ine te izdržini sodujen dok inele zajedno, adalese so lengoro barvalipe inele baro, ađahar da našti ine te živinen zajedno. <verse eid="GEN 13:6" /><verse number="7" style="v" sid="GEN 13:7" />Ovena ine bare kavge maškaro e Avramesere hem e Lotesere pastirija. Ano adava vreme ani adaja phuv živinde o Hanaanci hem o Perižanja.<verse eid="GEN 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 13:8" />Adalese o Avram phenđa e Lotese: “Familija injam. Nane šukar te ovel kavga maškara mande hem tute, maškaro mle hem kle pastirija. <verse eid="GEN 13:8" /><verse number="9" style="v" sid="GEN 13:9" />Sai će i phuv ko raspolaganje. Odvojin tut mandar. Te tu dželjan levo, me ka džav desno. Te tu dželjan desno, me ka džav levo.”<verse eid="GEN 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 13:10" />O Lot vazdinđa plo šero hem dikhlja dai sa i dolina oti len Jordan premalo Coar šukar natopime panjeja, sar o vrt e GOSPODESORO ili sar o Egipat. Akava inele angleder nego so o GOSPOD uništinđa i Sodoma hem i Gomora. <verse eid="GEN 13:10" /><verse number="11" style="v" sid="GEN 13:11" />I o Lot izabirinđa pese sa i dolina oti len Jordan, pa lelja te džal premalo istok. Ađahar odvojinde pe jekh averestar: <verse eid="GEN 13:11" /><verse number="12" style="v" sid="GEN 13:12" />O Avram živinđa ano Hanaan, dok o Lot živinđa maškaro dizja ani dolina hem vazdinđa pe šatorja sa đi ki Sodoma. <verse eid="GEN 13:12" /><verse number="13" style="v" sid="GEN 13:13" />A o manuša ani Sodoma inele bišukar hem inele bare grešnici anglo GOSPOD.<verse eid="GEN 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 13:14" />Palo adava so o Lot odvojinđa pe, o GOSPOD phenđa e Avramese: “Dikh taro akava than ko sever hem jug, ko istok hem zapad. <verse eid="GEN 13:14" /><verse number="15" style="v" sid="GEN 13:15" />Sa i phuv savi dikheja ka dav tuće hem te potomstvose zauvek. <verse eid="GEN 13:15" /><verse number="16" style="v" sid="GEN 13:16" />Ka ćerav to potomstvo te ovel baro sar o prah e phuvjakoro, pa sar so našti te dženel pe o prah e phuvjakoro, naka šaj te dženel pe ni to potomstvo. <verse eid="GEN 13:16" /><verse number="17" style="v" sid="GEN 13:17" />Dža hem nakh e phuvjaja uzduž hem popreko, adalese so tuće ka dav la.”<verse eid="GEN 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 13:18" />Tegani o Avram čedinđa ple šatorja hem dželo te živini uzalo e Mamresere bare kašta ano Hevron hem adari ćerđa žrtveniko e GOSPODESE.<verse eid="GEN 13:18" /></para>
  <chapter eid="GEN 13" />
  <chapter number="14" style="c" sid="GEN 14" />
  <para style="s">O Avram izbavini e Lote</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 14:1" />Ano adava vreme o Amrafel o caro oto Šinar, o Arioh o caro oto Elasar, o Kedarlaomer o caro oto Elam hem o Tidal o caro oto Gojim <verse eid="GEN 14:1" /><verse number="2" style="v" sid="GEN 14:2" />džele ano mariba protiv pandž avera carija: o Bera o caro oti Sodoma, o Birša o caro oti Gomora, o Šinav o caro oti Adma, o Šemever o caro oti Cevoim hem o caro oti Bela, adavai i Coar. <verse eid="GEN 14:2" /><verse number="3" style="v" sid="GEN 14:3" />Akala pandž carija pumare vojskencar udružinde pe zajedno ani dolina Sidim, adavai o Mrtvo more. <verse eid="GEN 14:3" /><verse number="4" style="v" sid="GEN 14:4" />Angleder, dešu duj berš služinde e Kedarlaomerese, ali ko dešu trito berš pobuninde pe protiv oleste.<verse eid="GEN 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 14:5" />Ko dešu štarto berš, o Kedarlaomer hem o carija kola inele oleja marde pe hem pobedinde e Refajconen ano Aštarot Karnajim, e Zuzejconen ano Ham, e Emijconen ano Šave Kirjatajim, <verse eid="GEN 14:5" /><verse number="6" style="v" sid="GEN 14:6" />hem e Horijconen ki lengiri planina Seir sa đi ko El Paran paše uzali pustinja. <verse eid="GEN 14:6" /><verse number="7" style="v" sid="GEN 14:7" />Tegani irinde pe hem džele ano En Mišpat, adavai o Kadeš, pa osvojinde sa i regija kote živinde o Amalečanja hem e Amorejconen, kola živinde ano Hacecon Tamaru.<verse eid="GEN 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 14:8" />Tegani o caro oti Sodoma, o caro oti Gomora, o caro oti Adma, o caro oti Cevoim hem o caro oti Bela, adavai i Coar, iklile ani dolina Sidim <verse eid="GEN 14:8" /><verse number="9" style="v" sid="GEN 14:9" />protiv o Kedarlaomer o caro oto Elam, o Tidal o caro oto Gojim, o Amrafel o caro oto Šinar hem o Arioh o caro oto Elasar – štar carija protiv pandž. <verse eid="GEN 14:9" /><verse number="10" style="v" sid="GEN 14:10" />A ani dolina Sidim inele pherdo rupe smolaja, pa kad o carija oti Sodoma hem Gomora pumare vojskencar lelje te našen, nesave pele ko rupe, a avera našle ano gore. <verse eid="GEN 14:10" /><verse number="11" style="v" sid="GEN 14:11" />O štar carija lelje sa o barvalipe oti Sodoma hem Gomora hem sa lengoro hajba, pa džele. <verse eid="GEN 14:11" /><verse number="12" style="v" sid="GEN 14:12" />On legarde hem e Lote, e Avramesere phralesere čhave, kova živinđa ani Sodoma, hem sa lesoro barvalipe.<verse eid="GEN 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 14:13" />A jekh manuš kova naštino e neprijateljendar alo hem javinđa e Avramese e Jevrejcose, kova živinđa uzalo bare kašta e Mamresere. O Mamre inele Amorejco, e Eškolosoro hem e Aneresoro phral. On trin inele ano savez e Avrameja. <verse eid="GEN 14:13" /><verse number="14" style="v" sid="GEN 14:14" />Kad o Avram šunđa dai lesere phralesoro čhavo zarobime, čedinđa trišelu dešu ofto trenirime manušen, robonen kolai bijande olese ano čher, hem lelja te džal ano mariba palo carija sa đi ki diz Dan. <verse eid="GEN 14:14" /><verse number="15" style="v" sid="GEN 14:15" />O Avram podelinđa ple manušen ko grupe, pa prekali rat napadinđa e neprijateljen hem pobedinđa len. Jurinđa len sa đi ki diz Hova, severno oti diz Damask. <verse eid="GEN 14:15" /><verse number="16" style="v" sid="GEN 14:16" />Ađahar irinđa palal sa o barvalipe, a irinđa hem pe phralesere čhave e Lote hem sa lesoro barvalipe, zajedno e đuvljencar hem avere manušencar.<verse eid="GEN 14:16" /></para>
  <para style="s">O Melhisedek blagoslovini e Avrame</para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 14:17" />Kad o Avram irinđa pe oto mariba sar pobedniko upro Kedarlaomer hem avera carija kola inele ano savez oleja, o caro oti Sodoma iklilo anglo leste ani dolina Šave, adavai e Carosiri dolina. <verse eid="GEN 14:17" /><verse number="18" style="v" sid="GEN 14:18" />O Melhisedek, o caro oto Salim, anđa o maro hem i mol. Ov inele svešteniko e Najbare Devlesoro <verse eid="GEN 14:18" /><verse number="19" style="v" sid="GEN 14:19" />hem ov blagoslovinđa e Avrame, vaćerindoj:</para>
  <para style="b" vid="GEN 14:19" />
  <para style="q1" vid="GEN 14:19">“Nek e Avrame blagoslovini o Najbaro Devel,</para>
  <para style="q2" vid="GEN 14:19">o Stvoritelji<note caller="+" style="f"><char style="fr" closed="false">14,19 </char><char style="fq" closed="false">Stvoritelji </char><char style="ft" closed="false">Akava lafi ko jevrejski šaj te značini hem “vlasniko” isto hem ano bišu dujto stih.</char></note> e nebosoro hem e phuvjakoro.<verse eid="GEN 14:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="GEN 14:20" />Nek ovel blagoslovime o Najbaro Devel</para>
  <para style="q2" vid="GEN 14:20">kova dinđa tut i pobeda upro neprijatelja.”</para>
  <para style="b" vid="GEN 14:20" />
  <para style="m" vid="GEN 14:20">Tegani o Avram dinđa e Melhisedekese desetak oto sa.<verse eid="GEN 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 14:21" />O caro oti Sodoma phenđa e Avramese: “De man mle manušen, a o barvalipe so osvojinđan nek ačhol tuće.”<verse eid="GEN 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 14:22" />A o Avram phenđa lese: “Haljum sovli e GOSPODESE, e Najbare Devlese, e nebosere hem e phuvjakere Stvoriteljese, <verse eid="GEN 14:22" /><verse number="23" style="v" sid="GEN 14:23" />da naka lav ni o thav, ni o dorikha oti obuća, niti bilo so adalestar soi klo, sar te na phene: ‘Me ćerđum e Avrame te ovel barvalo.’ <verse eid="GEN 14:23" /><verse number="24" style="v" sid="GEN 14:24" />Me maje naka lav ništa sem okolestar so hale mle manuša hem o deo so pripadini okolenđe kola džele mancar – e Anerese, e Eškolese hem e Mamrese; on nek len plo deo.”<verse eid="GEN 14:24" /></para>
  <chapter eid="GEN 14" />
  <chapter number="15" style="c" sid="GEN 15" />
  <para style="s">E Devlesoro savez e Avrameja</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 15:1" />A palo sa adava, o lafi e GOSPODESORO alo e Avramese ani vizija:</para>
  <para style="b" vid="GEN 15:1" />
  <para style="q1" vid="GEN 15:1">“Ma dara, Avrame,</para>
  <para style="q2" vid="GEN 15:1">me injum to štit.</para>
  <para style="q2" vid="GEN 15:1">Ti nagrada ka ovel but bari.”<verse eid="GEN 15:1" /></para>
  <para style="b" />
  <para style="p">
    <verse number="2" style="v" sid="GEN 15:2" />A o Avram phenđa: “GOSPODE, Devla, so ka de man? Nane man čhave, a sa akava so isi man ka ačhol mle slugase e Eliezerese oti Damask.”<verse eid="GEN 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 15:3" />Hem pana phenđa: “Ače, na dinđan man potomstvo, pa mlo nasledniko ka ovel o robo kova bijando maje ano čher.”<verse eid="GEN 15:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 15:4" />Tegani o GOSPOD phenđa: “Naka ovel ov to nasledniko, nego to čhavo, kova ka ikljol tutar, ov ka ovel to nasledniko.”<verse eid="GEN 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 15:5" />Tegani ikalđa e Avrame avri hem phenđa lese: “Dikh upre ko nebo hem džen o čerenja, ako šaj te džene len. Edobor ka ovel to potomstvo.”<verse eid="GEN 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 15:6" />O Avram poverujinđa e GOSPODESE, hem o GOSPOD uračuninđa lese adava ani pravednost.<verse eid="GEN 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 15:7" />O GOSPOD phenđa lese: “Me injum o GOSPOD, kova ikalđa tut taro Ur Haldejsko te dav tuće akaja phuv ano nasledstvo.”<verse eid="GEN 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 15:8" />A o Avram phenđa: “GOSPODE, Devla, sar me ka džanav da ka nasledinav akaja phuv?”<verse eid="GEN 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 15:9" />O GOSPOD phenđa lese: “Ana maje guruvnja oto trin berš, buznja oto trin berš, ovno oto trin berš, jekha grlica hem jekhe terne golube.”<verse eid="GEN 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 15:10" />O Avram anđa lese sa adava hem čhinđa len ko ekvaš, pa čhivđa len jekh premalo avereste. Samo e čirikljen na čhinđa. <verse eid="GEN 15:10" /><verse number="11" style="v" sid="GEN 15:11" />Tegani o čiriklja save hana e mudarde životinjen lelje te napadinen o mas, a o Avram jurinđa len.<verse eid="GEN 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 15:12" />Kad lelja te raćol, e Avrame prelelja o zoralo sojba hem i bari strašno tomina ali upro leste.<verse eid="GEN 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 15:13" />Tegani o GOSPOD phenđa lese: “Šukar te džane da te potomci ka oven abanđije ki tuđo phuv. Ka oven robija hem zlostavime štaršel berš. <verse eid="GEN 15:13" /><verse number="14" style="v" sid="GEN 15:14" />Ali me ka sudinav e narodose kase on ka robujinen, hem on palo adava adathar ka ikljoven bare barvalipnaja. <verse eid="GEN 15:14" /><verse number="15" style="v" sid="GEN 15:15" />Tu ka živine but berša, ka pridružine tut te pradadenđe ano mir hem ka ove parume. <verse eid="GEN 15:15" /><verse number="16" style="v" sid="GEN 15:16" />Tek palo štar generacije te potomci ka irinen pe akate, adalese so o greh e Amorejconengoro kola živinena ko akava than pana na pherđa pli mera sar te šaj kazninav len.”<verse eid="GEN 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 15:17" />Kad lelja te raćol hem kad inele tomina, otojekhvar pojavinđa pe čaro e žaroja savo ćurini ine hem jagali baklja save nakhine maškaro čhinde kotora e životinjengere.<verse eid="GEN 15:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 15:18" />Adava dive o GOSPOD phandlja savez e Avrameja hem phenđa lese: “Te potomkonenđe dava akaja phuv, oti Egipatsko len sa đi ki bari len Eufrat – <verse eid="GEN 15:18" /><verse number="19" style="v" sid="GEN 15:19" />i phuv e Kenejconengiri, e Kenižanengiri, e Kadmonconengiri, <verse eid="GEN 15:19" /><verse number="20" style="v" sid="GEN 15:20" />e Hetitengiri, e Perižanengiri, e Refajconengiri, <verse eid="GEN 15:20" /><verse number="21" style="v" sid="GEN 15:21" />e Amorejconengiri, e Hanaanconengiri, e Girgašanengiri hem e Jevusejconengiri.”<verse eid="GEN 15:21" /></para>
  <chapter eid="GEN 15" />
  <chapter number="16" style="c" sid="GEN 16" />
  <para style="s">I Agara hem o Ismailo</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 16:1" />E Avramesiri romni i Saraja našti ine te bijani lese čhaven. A inola jekh ropkinja Egipćanka koja vičinđa pe Agara, <verse eid="GEN 16:1" /><verse number="2" style="v" sid="GEN 16:2" />pa i Saraja phenđa e Avramese: “Eče, o GOSPOD na dinđa man te oven man čhave. Dža hem sov mla ropkinjaja, šaj prekalo late ka oven man čhave.”</para>
  <para style="p" vid="GEN 16:2">I o Avram šunđa e Saraja. <verse eid="GEN 16:2" /><verse number="3" style="v" sid="GEN 16:3" />Nakhlo deš berš sar o Avram živini ine ano Hanaan, kad lesiri romni i Saraja dinđa pla ropkinja, e Agara e Egipćanka, ple romese e Avramese te ovel lesiri romni. <verse eid="GEN 16:3" /><verse number="4" style="v" sid="GEN 16:4" />Ov suća e Agaraja hem oj ačhili khamni. Kad i Agara dikhlja dai khamni, lelja te dikhel po tele pe gospodarica.<verse eid="GEN 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 16:5" />Tegani i Saraja phenđa e Avramese: “Tu injan krivo zaki akaja nepravda savi arakhlja man. Me anđum mla ropkinja tuće ki angali, a oj, kad dikhlja dai khamni, lelja te dikhel man po tele. Nek o GOSPOD presudini koi amendar dujendar u pravu.”<verse eid="GEN 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 16:6" />Tegani o Avram phenđa e Sarajaće: “Ti ropkinjai tuće ano vasta. Ćer olaja sar so mangeja.”</para>
  <para style="p" vid="GEN 16:6">Tegani i Saraja lelja te zlostavini e Agara, pa oj našli olatar.<verse eid="GEN 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 16:7" />O anđeo e GOSPODESORO arakhlja e Agara koro izvor ki pustinja – o izvor kova inele nakoro drom zako Šur – <verse eid="GEN 16:7" /><verse number="8" style="v" sid="GEN 16:8" />pa pučlja la: “Agaro, ropkinjo e Sarajakiri, kotar aljan hem kaj džaja?”</para>
  <para style="p" vid="GEN 16:8">A oj phenđa: “Našava oti mli gospodarica i Saraja.”<verse eid="GEN 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 16:9" />A o anđeo e GOSPODESORO phenđa laće: “Irin tut te gospodaricate hem pokorin tut laće.” <verse eid="GEN 16:9" /><verse number="10" style="v" sid="GEN 16:10" />Hem phenđa laće: “Ka umnožinav te potomkonen edobor but da naka šaj te dženen pe.” <verse eid="GEN 16:10" /><verse number="11" style="v" sid="GEN 16:11" />O anđeo e GOSPODESORO phenđa laće hem akava:</para>
  <para style="b" vid="GEN 16:11" />
  <para style="q1" vid="GEN 16:11">“Ače, khamni injan hem ka bijane čhave.</para>
  <para style="q2" vid="GEN 16:11">Ka de le anav Ismailo,<note caller="+" style="f"><char style="fr" closed="false">16,11 </char><char style="fq" closed="false">Ismailo </char><char style="ft" closed="false">so značini: “O Devel šunđa”.</char></note></para>
  <para style="q2" vid="GEN 16:11">adalese so o GOSPOD šunđa zaki ti nevolja.<verse eid="GEN 16:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="GEN 16:12" />Ov ka ovel sar divljo her.</para>
  <para style="q1" vid="GEN 16:12">Upro svakoneste ka vazdel plo vas</para>
  <para style="q2" vid="GEN 16:12">hem svako ka vazdel plo vas upro leste.</para>
  <para style="q1" vid="GEN 16:12">Ka živini ano neprijateljstvo</para>
  <para style="q2" vid="GEN 16:12">sa ple phraljencar.”<verse eid="GEN 16:12" /></para>
  <para style="b" />
  <para style="p">
    <verse number="13" style="v" sid="GEN 16:13" />Tegani oj e GOSPODE, kova vaćerđa olaja, vičinđa El Roi, adalese so phenđa: “Akate dikhljum e Devle kova dikhela man.” <verse eid="GEN 16:13" /><verse number="14" style="v" sid="GEN 16:14" />Adalese adava bunari vičini pe Beer Lahaj Roi,<note caller="+" style="f"><char style="fr" closed="false">16,14 </char><char style="fq" closed="false">Beer Lahaj Roi </char><char style="ft" closed="false">so značini: Bunari e dživde Devlesoro kova dikhela man.</char></note> a nalazini pe maškaro Kadeš hem Bered.<verse eid="GEN 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 16:15" />I Agara bijanđa e Avramese čhave, a o Avram dinđa le anav Ismailo. <verse eid="GEN 16:15" /><verse number="16" style="v" sid="GEN 16:16" />E Avrame ine oftovardešu šov berš kad i Agara bijanđa lese e Ismailo.<verse eid="GEN 16:16" /></para>
  <chapter eid="GEN 16" />
  <chapter number="17" style="c" sid="GEN 17" />
  <para style="s">Obreziba – znako oto Savez</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 17:1" />Kad e Avrame ine enjavardešu enja berš, o GOSPOD mothovđa pe lese hem phenđa: “Me injum o Devel, kova sa šaj. Ćer okova soi pali mli volja hem ov bizi mana. <verse eid="GEN 17:1" /><verse number="2" style="v" sid="GEN 17:2" />Tegani ka phandav tuja savez hem ka dav tut bute potomkonen.”<verse eid="GEN 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 17:3" />O Avram pokloninđa pe ađahar so pelo mujeja đi phuv, a o Devel phenđa lese: <verse eid="GEN 17:3" /><verse number="4" style="v" sid="GEN 17:4" />“Akavai mlo savez tuja: Ka ove dad bute narodenđe. <verse eid="GEN 17:4" /><verse number="5" style="v" sid="GEN 17:5" />Naka vičine tut više Avram, nego to anav ka ovel Avraam, adalese so ćerđum tut te ove dad bute narodenđe. <verse eid="GEN 17:5" /><verse number="6" style="v" sid="GEN 17:6" />Ka dav tut bute potomkonen, pa tutar ka ikljon narodija hem carija. <verse eid="GEN 17:6" /><verse number="7" style="v" sid="GEN 17:7" />Ka potvrdinav mlo savez tuja hem te potomkonencar tari generacija ani generacija – o večno savez – hem ka ovav Devel klo hem kle potomkonengoro. <verse eid="GEN 17:7" /><verse number="8" style="v" sid="GEN 17:8" />Tuće hem te potomkonenđe ka dav ano večno nasledstvo sa i phuv Hanaan, ani savi akana živineja sar abanđija, hem ka ovav lengoro Devel.”<verse eid="GEN 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 17:9" />O Devel phenđa e Avraamese: “Ićer tut ko mlo savez, hem tu hem te potomci tari generacija ani generacija. <verse eid="GEN 17:9" /><verse number="10" style="v" sid="GEN 17:10" />Akavai mlo savez tuja hem sa te potomkonencar ko savo mora te ićeren tumen: nek obrezini pe svako murš maškaro tumende. <verse eid="GEN 17:10" /><verse number="11" style="v" sid="GEN 17:11" />Obrezinen tumen, hem adava ka ovel znako oto savez maškara mande hem tumende. <verse eid="GEN 17:11" /><verse number="12" style="v" sid="GEN 17:12" />Tari generacija ani generacija, svako murš maškaro tumende kad bijanđola, palo oftoto dive, nek obrezini pe, ađahar hem svako robo kovai bijando ano tumaro čher ili parencar čindo oto abanđije, kova nane to potomko. <verse eid="GEN 17:12" /><verse number="13" style="v" sid="GEN 17:13" />Bilo dai bijando tuće ano čher ili čindo parencar, mora te obrezini pe. Ađahar tumenđe upro telo ka ovel znako dai mlo savez večno savez. <verse eid="GEN 17:13" /><verse number="14" style="v" sid="GEN 17:14" />Svako murš kova nane obrezime, svako kova na obrezini pe, nek ovel cidime taro plo narodo, adalese so phaglja mlo savez.”<verse eid="GEN 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 17:15" />O Devel phenđa e Avraamese hem akava: “Te romnja naka vičine više Saraja – olakoro anav ka ovel Sara. <verse eid="GEN 17:15" /><verse number="16" style="v" sid="GEN 17:16" />Ka blagoslovinav la hem olatar ka dav tut čhave. Ka blagoslovinav la, hem oj ka ovel daj e narodenđe hem olatar ka ikljon carija e narodengere.”<verse eid="GEN 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 17:17" />Ko adava o Avraam pelo mujeja đi phuv, pa asandilo hem phenđa ana peste: “Zar e manušese ano šel berš ka bijanđol čhavo? Zar i Sara ano enjavardeš berš ka bijani?”<verse eid="GEN 17:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 17:18" />Tegani o Avraam phenđa e Devlese: “Kad bi barem o Ismailo živini talo to blagoslov.”<verse eid="GEN 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 17:19" />A o Devel phenđa lese: “Na! Ti romni i Sara ka bijani će čhave, a tu ka de le anav Isaak. Ka potvrdinav o večno savez oleja hem olesere potomkonencar. <verse eid="GEN 17:19" /><verse number="20" style="v" sid="GEN 17:20" />Šunđum so rodinđan zako Ismailo. Ače, ka blagoslovinav le, ka ćerav te ovel plodno hem ka dav le bute potomkonen. Ov ka ovel dad e dešu duje vladarengoro hem olestar ka ćerav te ovel baro narodo. <verse eid="GEN 17:20" /><verse number="21" style="v" sid="GEN 17:21" />Ali, mlo savez ka potvrdinav e Isaakeja, kole ka bijani će i Sara đi berše ano akava vreme.”<verse eid="GEN 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 17:22" />Kad o Devel završinđa o vaćeriba e Avraameja, dželo olestar.<verse eid="GEN 17:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 17:23" />Ko adava dive o Avraam lelja pe čhave e Ismailo hem sa e robonen kolai bijande lese ano čher hem okolen kolai parencar činde – svakone murše oto plo čher – pa obrezinđa len sar so o Devel phenđa lese. <verse eid="GEN 17:23" /><verse number="24" style="v" sid="GEN 17:24" />E Avraame ine enjavardešu enja berš kad obrezinđa pe, <verse eid="GEN 17:24" /><verse number="25" style="v" sid="GEN 17:25" />a lesere čhave e Ismailo ine dešu trin. <verse eid="GEN 17:25" /><verse number="26" style="v" sid="GEN 17:26" />Ađahar o Avraam hem lesoro čhavo o Ismailo inele obrezime ko isto dive, <verse eid="GEN 17:26" /><verse number="27" style="v" sid="GEN 17:27" />a olencar hem sa o murša ano e Avraamesoro čher – o robija bijande olese ano čher hem okola kolai parencar činde oto abanđije.<verse eid="GEN 17:27" /></para>
  <chapter eid="GEN 17" />
  <chapter number="18" style="c" sid="GEN 18" />
  <para style="s">O trin posetioci</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 18:1" />O GOSPOD palem mothovđa pe e Avraamese uzalo e Mamresere bare kašta sar o Avraam bešela ine ko ulaz pese oto šatori ko naj baro tatipe e divesoro.<verse eid="GEN 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 18:2" />O Avraam vazdinđa plo šero, i eče – dikhlja angla peste trine manušen sar terđona!</para>
  <para style="p" vid="GEN 18:2">Kad dikhlja len, taro ulaz e šatoresoro prastandilo nakoro lende, pa pokloninđa pe mujeja đi phuv anglo lende. <verse eid="GEN 18:2" /><verse number="3" style="v" sid="GEN 18:3" />I phenđa: “Gospodarona, te arakhljum milost angla tute, ma te nakhe akatar, a te na ave kora mande, koro to sluga. <verse eid="GEN 18:3" /><verse number="4" style="v" sid="GEN 18:4" />Te anel pe hari pani, te thoven tumare pre, hem te odmorinen tumen talo akava kaš. <verse eid="GEN 18:4" /><verse number="5" style="v" sid="GEN 18:5" />Ka anav tumenđe hem nešto hajbnase, te osvežinen tumen, a onda te džan tumare dromeja. Adalese so irinđen koro tumaro sluga.”</para>
  <para style="p" vid="GEN 18:5">A on phende lese: “ Šukari, ćer sar so phenđan.”<verse eid="GEN 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 18:6" />O Avraam ki sig dželo kori Sara ano šatori hem phenđa laće: “Siđar! Le i bari vreća oto najšukar varo, pa mesin hem pekh maro!”<verse eid="GEN 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 18:7" />Tegani prastandilo kaj ine o guruva, lelja terne thule telco hem dinđa le jekhe slugaste, kova siđarđa te spremini le zako hajba. <verse eid="GEN 18:7" /><verse number="8" style="v" sid="GEN 18:8" />Onda o Avraam lelja i urda hem o thud hem e telco save spreminđa zako hajba hem ikalđa sa adava anglo lende. Hem sar on hana ine, ov terdino uzalo lende talo kaš.<verse eid="GEN 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 18:9" />Tegani pučle le: “Kaj ti romni i Sara?”</para>
  <para style="p" vid="GEN 18:9">A ov phenđa lenđe: “Eče adari ano šatori.”<verse eid="GEN 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 18:10" />Tegani jekh olendar phenđa: “Đi berše ano akava vreme ka irinav man tute, hem te romnja e Sara ka ovel čhavo.”</para>
  <para style="p" vid="GEN 18:10">A i Sara šunela ine sa adava ko ulaz oto šatori savo inele palo leste. <verse eid="GEN 18:10" /><verse number="11" style="v" sid="GEN 18:11" />Hem o Avraam hem i Sara već inele but purane, hem nakhino e Sarakoro vreme te oven la čhave.<verse eid="GEN 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 18:12" />Adalese i Sara asandili ana peste hem phenđa: “Zar akana, kad injum purani, te doživinav adava zadovoljstvo? A hem mloi rom purano.”<verse eid="GEN 18:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 18:13" />Tegani o GOSPOD pučlja e Avraame: “Sose ti romni i Sara asandili hem phenđa: ‘Zar akana ka bijanav čhave kad injum purani?’ <verse eid="GEN 18:13" /><verse number="14" style="v" sid="GEN 18:14" />Zar e GOSPODESE nešto pharo? Ka irinav man tute đi berše ano akava vreme, hem e Sara ka ovel čhavo.”<verse eid="GEN 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 18:15" />I Sara oti dar hovavđa vaćerindoj: “Na, na asandiljum.”</para>
  <para style="p" vid="GEN 18:15">A o GOSPOD phenđa: “Oja, asandiljan.”<verse eid="GEN 18:15" /></para>
  <para style="s">O Avraam posredujini zaki Sodoma</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 18:16" />Tegani o manuša uštine adathar hem dikhle premali Sodoma, o Avraam lelja te džal olencar te ispratini len.<verse eid="GEN 18:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 18:17" />Tegani o GOSPOD ana peste phenđa: “Zar te garavav oto Avraam so ka ćerav? <verse eid="GEN 18:17" /><verse number="18" style="v" sid="GEN 18:18" />Olestar čače ka ovel baro hem zoralo narodo hem prekalo leste ka oven blagoslovime sa o narodija ki phuv. <verse eid="GEN 18:18" /><verse number="19" style="v" sid="GEN 18:19" />Adalese so, me birinđum le te sikaj ple čhaven hem ple potomkonen te ićeren pe ko drom e GOSPODESORO ćerindoj okova soi ispravno hem pravedno. Ađahar me o GOSPOD ka ćerav okova so obećinđum e Avraamese.”<verse eid="GEN 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 18:20" />O GOSPOD phenđa: “Buti bare o optužbe protiv i Sodoma hem i Gomora hem buti pharo lengoro greh. <verse eid="GEN 18:20" /><verse number="21" style="v" sid="GEN 18:21" />Adalese ka huljav adari hem ka dikhav da li čače ćerde sa okova so šunđum olendar. Te nane ađahar, ka džanav.”<verse eid="GEN 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 18:22" />Okola duj manuša lelje te džan nakori Sodoma, a o Avraam ačhilo te terđol anglo GOSPOD.<verse eid="GEN 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 18:23" />Tegani o Avraam alo paše uzalo GOSPOD hem pučlja: “Zar čače ka uništine hem okolen soi pravedna zajedno e grešnikonencar? <verse eid="GEN 18:23" /><verse number="24" style="v" sid="GEN 18:24" />A so te ani diz isi pinda manuša pravedna? Zar čače ka uništine adaja diz? Zar naka poštedine la zbog o pinda pravedna manuša kolai ano late? <verse eid="GEN 18:24" /><verse number="25" style="v" sid="GEN 18:25" />Dur adalestar da ka ćere nešto ađahar – te mudare e pravednikonen zajedno e grešnikonencar, te postupine isto e pravednikonencar sar so e grešnikonencar. Dur adalestar! Zar o sudija celone svetosoro te na postupini pravedno?”<verse eid="GEN 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 18:26" />A o GOSPOD phenđa: “Te arakhljum ani diz Sodoma pinda manušen kolai pravedna, zbog olende ka poštedinav celo than.”<verse eid="GEN 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 18:27" />A o Avraam phenđa: “Ače, džanav da injum samo prah hem pepeo, hem da nane man pravo te vaćerav ađahar e Gospodeja, <verse eid="GEN 18:27" /><verse number="28" style="v" sid="GEN 18:28" />ali so te ani diz falinena pandž oto pinda pravedna manuša? Zar ka uništine celo diz zbog adala pandž manuša?”</para>
  <para style="p" vid="GEN 18:28">O GOSPOD phenđa: “Te arakhljum da ani diz isi sarandu pandž pravedna manuša, naka uništinav la.”<verse eid="GEN 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 18:29" />O Avraam palem phenđa: “A so te arakhlja pe adari samo saranda pravednici?”</para>
  <para style="p" vid="GEN 18:29">A o GOSPOD phenđa: “Naka uništinav i diz te isi saranda pravedna manuša.”<verse eid="GEN 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 18:30" />O Avraam palem phenđa: “Ma te holjani o Gospod so palem vaćerava. A so te arakhlja pe adari samo trijanda pravednici?”</para>
  <para style="p" vid="GEN 18:30">A o GOSPOD phenđa lese: “Naka uništinav i diz te isi trijanda pravedna manuša.”<verse eid="GEN 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 18:31" />Tegani o Avraam phenđa: “Nane man pravo ađahar te vaćerav e Gospodeja. A so te arakhlja pe adari samo biš pravednici?”</para>
  <para style="p" vid="GEN 18:31">A o GOSPOD phenđa lese: “Naka uništinav i diz te isi biš pravedna manuša.”<verse eid="GEN 18:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 18:32" />O Avraam palem phenđa: “Ma te holjani o GOSPOD so me pana jekhvar ka vaćerav. A so te arakhlja pe adari samo deš pravednici?”</para>
  <para style="p" vid="GEN 18:32">A o GOSPOD phenđa lese: “Naka uništinav i diz te isi deš pravedna manuša.”<verse eid="GEN 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 18:33" />Kad završinđa o vaćeriba e Avraameja, o GOSPOD dželo, a o Avraam irinđa pe čhere.<verse eid="GEN 18:33" /></para>
  <chapter eid="GEN 18" />
  <chapter number="19" style="c" sid="GEN 19" />
  <para style="s">O duj posetioci avena koro Lot</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 19:1" />Okola duj anđelja resle raćate đi i Sodoma. A o Lot bešela ine uzali kapija e dizjakiri, pa kad dikhlja len, uštino, lelja te džal nakoro lende hem pokloninđa pe lenđe mujeja đi phuv.<verse eid="GEN 19:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 19:2" />Hem phenđa lenđe: “Molinava tumen gospodaronalen, irinen ko čher tumare slugasoro te thoven tumare pre hem te nakhaven i rat, a tejsa rano sabale džan tumare dromeja.”</para>
  <para style="p" vid="GEN 19:2">On phende lese: “Na, ka nakhava i rat akate ko trg.”<verse eid="GEN 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 19:3" />Ali o Lot edobor uporno inele, pa on irinde koro leste. Đerdinde lese ano čher, a ov spreminđa lenđe gozba hem peklja maro bizo kvasco, pa hale.<verse eid="GEN 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 19:4" />Angleder so te džan ko sojba, sa o murša oti Sodoma, hem o terne hem o purane, svako olendar, opkolinde o čher.<verse eid="GEN 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 19:5" />Vičinde e Lote hem pučle le: “Kaj okola manuša so ale erat kora tute? Ikal len amenđe avri te sova olencar!”<verse eid="GEN 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 19:6" />Tegani o Lot iklilo avri anglo lende hem phandlja o udar pala peste, <verse eid="GEN 19:6" /><verse number="7" style="v" sid="GEN 19:7" />pa phenđa lenđe: “Molinava tumen, phraljalen, ma ćeren akava bišukaripe. <verse eid="GEN 19:7" /><verse number="8" style="v" sid="GEN 19:8" />Ače, isi man duj čhaja kola pana na inele nijekhe muršeja. Ka ikalav tumenđe olen, pa ćeren olencar so mangena. Ali akale manušenđe ma te ćeren nisavo bišukaripe, adalese so on ale maje ko čher hem oni tali mli zaštita.”<verse eid="GEN 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 19:9" />A on phende lese: “Cide tut adathar! Aljan akate sar abanđija, a već mangeja te ove sudija. Akana tuja ka ćera po bišukar nego olencar.”</para>
  <para style="p" vid="GEN 19:9">I zorale gurinde e Lote, pa lelje te phagen o udar. <verse eid="GEN 19:9" /><verse number="10" style="v" sid="GEN 19:10" />Ali okola duj džene pružinde pumare vasta avri, pa vucinde e Lote andre ano čher nakora pumende hem phandle o udar. <verse eid="GEN 19:10" /><verse number="11" style="v" sid="GEN 19:11" />Tegani on e manušen kola inele anglo udar, hem e ternen hem e puranen, otojekhvar korjarde da našti ine te arakhen o udar.<verse eid="GEN 19:11" /></para>
  <para style="s">O Lot ikljola tari diz Sodoma</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 19:12" />Okola duj džene pučle e Lote: “Kas isi tut pana akate? E đamutren, e čhaven hem e čhajen hem sa kas isi tut ani akaja diz, ikal len avri akatar, <verse eid="GEN 19:12" /><verse number="13" style="v" sid="GEN 19:13" />adalese so ka uniština akava than. O optužbe protiv akala manuša ule but bare anglo GOSPOD hem ov bičhalđa amen te uniština i diz.”<verse eid="GEN 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 19:14" />O Lot dželo te phenel zako ple buduća đamutre:</para>
  <para style="p" vid="GEN 19:14">“Siđaren! Ikljoven taro akava than, adalese so GOSPOD ka uništini le!”</para>
  <para style="p" vid="GEN 19:14">Ali lesere đamutre mislinde da šalini pe olencar.<verse eid="GEN 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 19:15" />Kad dislilo, o anđelja lelje te siđaren e Lote, vaćerindoj: “Siđar! Ikal te romnja hem te duje čhajen kolai akate, te na oven hem tumen uništime kad ka kaznina i diz.”<verse eid="GEN 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 19:16" />A o Lot lelja te mislini pe. Adalese okola duj džene lelje oto vas ole, lesere romnja hem lesere duje čhajen hem ikalde len avri oti diz, adalese so o GOSPOD ine lenđe milosrdno.<verse eid="GEN 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 19:17" />Kad ikalde len, jekh olendar phenđa: “Našen sar džanen hem spasinen tumen! Ma dikhen pala tumende hem ma te ačhoven negde ani dolina! Našen ano planine, sar te na oven uništime!”<verse eid="GEN 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 19:18" />Tegani o Lot phenđa: “Ma, molinava tut gospodarona! <verse eid="GEN 19:18" /><verse number="19" style="v" sid="GEN 19:19" />Me, to sluga, arakhljum milost angla tute hem tu mothovđan to baro mangipe premala mande kad spasinđan mlo dživdipe. Ali, naka resav te našav ano planine, adalese so ka resel man o uništenje hem ka merav. <verse eid="GEN 19:19" /><verse number="20" style="v" sid="GEN 19:20" />Nego, eče adari isi tikori diz savi po paše te našav ano late. Muk man te našav adari, ani adaja tikori diz, sar te spasinav mlo dživdipe.”<verse eid="GEN 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 19:21" />A ov phenđa lese: “Šukari, ka uslišinav ti molba hem naka uništinav i diz savatar tu vaćereja. <verse eid="GEN 19:21" /><verse number="22" style="v" sid="GEN 19:22" />Samo siđar naš adari, adalese so ništa našti te ćerav ništa đikote na reseja adari.” Adaja diz dobinđa anav Coar adalese so o Lot dinđa la anav tikori.<verse eid="GEN 19:22" /></para>
  <para style="s">O Devel uništini i Sodoma hem i Gomora</para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 19:23" />O kham već iklilo kad o Lot đerdinđa ano Coar. <verse eid="GEN 19:23" /><verse number="24" style="v" sid="GEN 19:24" />Tegani o GOSPOD oto nebo muklja jag hem sumpor, save perena ine sar bršim upri Sodoma hem upri Gomora, <verse eid="GEN 19:24" /><verse number="25" style="v" sid="GEN 19:25" />pa uništinđa adala dizja hem sa i dolina, sa e manušen oto dizja hem sa o biljke save ine barjona ki phuv.<verse eid="GEN 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 19:26" />Ali e Lotesiri romni dikhlja napalal nakori Sodoma, hem pretvorinđa pe ano stubo oto lon.<verse eid="GEN 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 19:27" />O Avraam uštino rano sabale hem dželo ko than kaj terđola ine anglo GOSPOD. <verse eid="GEN 19:27" /><verse number="28" style="v" sid="GEN 19:28" />Dikhlja nakori Sodoma hem i Gomora hem nakori sa i dolina, hem dikhlja sar o čuro uštela tari phuv sar o čuro tari peć.<verse eid="GEN 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 19:29" />Ađahar o Devel uništinđa o dizja ani dolina kote o Lot živinđa, ali na bisterđa o obećanje savo dinđa e Avraamese adalese so ikalđa e Lote angleder o uništenje.<verse eid="GEN 19:29" /></para>
  <para style="s">O poreklo oto Moavci hem Amonci</para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 19:30" />O Lot hem lesere duj čhaja džele oto Coar hem lelje te živinen ano planine adalese so darandilo te ačhol ano Coar. Ov hem lesere duj čhaja živinde ani pećina.<verse eid="GEN 19:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 19:31" />I phureder čhaj phenđa e tiknederaće: “Amaroi dad purano, a nane nijekh murš ki akaja phuv kova ka sovel amencar te oven amen čhave, sar soi o adeti ko celo sveto. <verse eid="GEN 19:31" /><verse number="32" style="v" sid="GEN 19:32" />Ana te maćara amare dade moljaja hem te sova oleja, te šaj nastavini pe amare dadesoro potomstvo.”<verse eid="GEN 19:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 19:33" />Ađahar adaja rat maćarde pumare dade moljaja, pa i phureder čhaj dželi andre hem suća oleja. A ov na džanđa ni kad pašlili ni kad uštini.<verse eid="GEN 19:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 19:34" />Tejsa dive i phureder phenđa e tiknederaće: “Erati me sućum me dadeja. Ana erat palem te maćara le moljaja, pa tu dža hem sov oleja, te šaj nastavini pe amare dadesoro potomstvo.”<verse eid="GEN 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 19:35" />Ađahar hem adaja rat maćarde pumare dade moljaja, pa i tikneder čhaj dželi hem suća oleja. A ov na džanđa ni kad pašlili ni kad uštini.<verse eid="GEN 19:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 19:36" />Ađahar soduj čhaja ačhile khamnja pumare dadestar. <verse eid="GEN 19:36" /><verse number="37" style="v" sid="GEN 19:37" />I phureder čhaj bijanđa čhave hem dinđa le anav Moav.<note caller="+" style="f"><char style="fr" closed="false">19,37 </char><char style="fq" closed="false">Moav </char><char style="ft" closed="false">so značini: “mle dadestar”.</char></note> Ovi o pradad oto avdisutne Moavci. <verse eid="GEN 19:37" /><verse number="38" style="v" sid="GEN 19:38" />I tikneder čhaj bijanđa čhave hem dinđa le anav Ben Ami.<note caller="+" style="f"><char style="fr" closed="false">19,38 </char><char style="fq" closed="false">Ben Ami </char><char style="ft" closed="false">so značini: “čhavo mle narodosoro”.</char></note> Ovi o pradad oto avdisutne Amonci.<verse eid="GEN 19:38" /></para>
  <chapter eid="GEN 19" />
  <chapter number="20" style="c" sid="GEN 20" />
  <para style="s">O Avram hem o Avimeleh</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 20:1" />O Avraam taro Hevron lelja te džal nakori phuv Negev hem adari lelja te živini maškaro Kadeš hem Šur. Dok živinđa ano Gerar sar abanđija, <verse eid="GEN 20:1" /><verse number="2" style="v" sid="GEN 20:2" />o Avraam zaki pli romni i Sara phenđa dai lesiri phen. Adalese o Avimeleh, o caro oto Gerar, bičhalđa ple slugen pali Sara hem lelja la kora peste.<verse eid="GEN 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 20:3" />Ali o Devel prekali rat alo ano suno e Avimelehese hem phenđa lese: “Ka mere zbog akaja romni kola leljan, adalese soi oj dindi đuvli.”<verse eid="GEN 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 20:4" />A o Avimeleh pana na suća e Saraja, pa phenđa: “Gospode, zar ka mudare e narodo kova nane krivo? <verse eid="GEN 20:4" /><verse number="5" style="v" sid="GEN 20:5" />Zar na phenđa maje korkoro o Avraam: ‘Oj mli phen’? Hem na li korkori oj phenđa: ‘Ovi mlo phral’? Me adava ćerđum ani čisto savest hem na meljarđum mle vasta.”<verse eid="GEN 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 20:6" />A o Devel phenđa lese ano suno: “Oja, džanav da adava ćerđan ani čisto savest. Adalese zadržinđum tut te na grešine protiv mande – adalese na dinđum tut te pipine la. <verse eid="GEN 20:6" /><verse number="7" style="v" sid="GEN 20:7" />A akana irin adale manušese lesere romnja. Ovi proroko hem ka molini pe tuće, pa ka ačhove dživdo. Ali, te na irinđan la te džane da sigurno ka mere tu hem sare kolai kle.”<verse eid="GEN 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 20:8" />O Avimeleh uštino rano sabale, pa vičinđa sa ple službenikonen. Kad vaćerđa lenđe plo suno, on but darandile.<verse eid="GEN 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 20:9" />Tegani o Avimeleh vičinđa e Avraame, pa pučlja le: “So ćerđan amenđe adava? So ćerđum će bišukar pa te čhive esavko baro greh upra mande hem upro mlo carstvo? Ćerđan maje okova so niko nikase ne bi ćerela.”<verse eid="GEN 20:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 20:10" />Hem o Avimeleh pučlja e Avraame: “Savoi o razlog so ćerđan adava?”<verse eid="GEN 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 20:11" />A o Avraam phenđa: “Mislinđum: ‘Sigurno ko akava than na darana e Devlestar, pa ka mudaren man zbog mli romni.’ <verse eid="GEN 20:11" /><verse number="12" style="v" sid="GEN 20:12" />A sem adalestar, oj čače mli phen, čhaj mle dadesiri, ali na hem mla dajakiri, pa leljum la romnjaće. <verse eid="GEN 20:12" /><verse number="13" style="v" sid="GEN 20:13" />A kad o Devel ćerđa te ikljovav taro čher mle dadesoro, me phenđum laće: ‘Ađahar ka mothove maje to mangipe: kaj god te dža, ka phene da injum to phral.’ ”<verse eid="GEN 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 20:14" />Tegani o Avimeleh lelja bakren, guruven, robonen hem ropkinjen hem dinđa len e Avraamese. Irinđa lese hem lesere romnja e Sara.<verse eid="GEN 20:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 20:15" />O Avimeleh phenđa: “Ače, mli phuv će ko raspolaganje. Le živin kaj god tu mangeja.”<verse eid="GEN 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 20:16" />A e Saraće phenđa: “Ače, dinđum te phralese hiljada srebrnjaci sar dokaz da injan nevino anglo sarijende kolai tuja. Ađahar ka ove potpuno opravdime.”<verse eid="GEN 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 20:17" />Tegani o Avraam molinđa pe e Devlese, hem o Devel sasljarđa e Avimelehe, lesere romnja hem lesere ropkinjen, pa palem šaj ine te bijanen čhaven. <verse eid="GEN 20:17" /><verse number="18" style="v" sid="GEN 20:18" />Adalese so, o GOSPOD ano čher e Avimelehesoro ćerđa svakona đuvlja te ovel nerotkinja zbog e Avraamesiri romni i Sara.<verse eid="GEN 20:18" /></para>
  <chapter eid="GEN 20" />
  <chapter number="21" style="c" sid="GEN 21" />
  <para style="s">Sar bijandilo o Isak</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 21:1" />A o GOSPOD blagoslovinđa e Sara, sar so phenđa, hem ćerđa laće okova so obećinđa: <verse eid="GEN 21:1" /><verse number="2" style="v" sid="GEN 21:2" />I Sara ačhili khamni hem bijanđa e Avraamese čhave ano lesoro phuripe, baš ano adava vreme savestar o Devel vaćerđa. <verse eid="GEN 21:2" /><verse number="3" style="v" sid="GEN 21:3" />Ple čhavese kole bijanđa lese i Sara, o Avraam dinđa anav Isaak.<verse eid="GEN 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 21:4" />O Avraam obrezinđa ple čhave e Isaake kad inole ofto dive, sar so naredinđa lese o Devel. <verse eid="GEN 21:4" /><verse number="5" style="v" sid="GEN 21:5" />E Avraame ine šel berš kad bijandilo lese lesoro čhavo o Isaak.<verse eid="GEN 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 21:6" />I Sara phenđa: “O Devel ćerđa man te asav, hem sare kola ka šunen zako akava, ka asan zajedno mancar.”<verse eid="GEN 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 21:7" />Hem pana phenđa: “Ko šaj ine te phenel e Avraamese da i Sara ka del čuči e čhavoren? A palem, bijanđum lese čhave ano lesoro phuripe.”<verse eid="GEN 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 21:8" />O čhavoro barilo hem ačhavđa te pijel čuči. A adava dive kad o Isaak ačhavđa te pijel čuči, o Avraam ćerđa bari gozba.<verse eid="GEN 21:8" /></para>
  <para style="s">I Agara hem o Ismailo ispudime</para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 21:9" />Ali i Sara dikhlja sar o čhavo kole i Agara i Egipćanka bijanđa e Avraamese marela muj e Isaakeja, <verse eid="GEN 21:9" /><verse number="10" style="v" sid="GEN 21:10" />pa phenđa e Avraamese: “Ispudin akala ropkinja hem lakere čhave, adalese so o čhavo akala ropkinjakoro naka ovel nasledniko mle čhaveja e Isaakeja.”<verse eid="GEN 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 21:11" />E Avraamese adava inele but pharo, adalese so o Ismailo inele lesoro čhavo.<verse eid="GEN 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 21:12" />Ali o Devel phenđa e Avraamese: “Ma te ovel će pharo zbog o čhavoro hem zbog ti ropkinja. Šun sa so i Sara phenela će, adalese so to potomstvo ka računini pe prekalo Isaak. <verse eid="GEN 21:12" /><verse number="13" style="v" sid="GEN 21:13" />A hem taro čhavo e ropkinjakoro ka ćerav narodo, adalese soi hem ov to potomko.”<verse eid="GEN 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 21:14" />O Avraam uštino rano sabale, lelja maro hem morćhi panjeja hem dinđa len e Agaraće. Adava čhivđa laće ko dumo, pa ola zajedno e čhavoreja ispratinđa zako drom. Oj dželi hem lutinđa ki pustinja Beer Ševa. <verse eid="GEN 21:14" /><verse number="15" style="v" sid="GEN 21:15" />Kad na ačhilo više pani ani morćhi, oj čhivđa e čhavore talo jekh grmo, <verse eid="GEN 21:15" /><verse number="16" style="v" sid="GEN 21:16" />pa dželi hem beštini hari po dur, đi sar šel metarija, adalese so mislinđa: “Našti te dikhav sar o čhavoro merela.”</para>
  <para style="p" vid="GEN 21:16">I sar bešela ine ađahar, lelja te rovel glasoja.<verse eid="GEN 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 21:17" />Ali o Devel šunđa e čhavoresoro rojba, pa e Devlesoro anđeo vičinđa e Agara taro nebo, vaćerindoj: “So mučini tut, Agaro? Ma dara. O Devel šunđa sar o čhavoro rovela adari kaj pašljola. <verse eid="GEN 21:17" /><verse number="18" style="v" sid="GEN 21:18" />Ušti, vazde e čhavore hem utešin le, adalese so olestar ka ćerav bare narodo.”<verse eid="GEN 21:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 21:19" />Tegani o Devel phravđa lakere jaćha, hem oj dikhlja bunari e panjeja, pa dželi hem pherđa i morćhi panjeja hem dinđa e čhavorese te pijel.<verse eid="GEN 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 21:20" />O Devel inele e čhavoreja dok barjola ine. O čhavoro živinđa ani pustinja hem ulo strelco. <verse eid="GEN 21:20" /><verse number="21" style="v" sid="GEN 21:21" />Dok živinđa ani pustinja Paran, lesiri daj anđa lese romnja taro Egipat.<verse eid="GEN 21:21" /></para>
  <para style="s">O Avraam phandela savez e Avimeleheja</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 21:22" />Ano adava vreme o Avimeleh hem o Pihol, o naredniko lesere vojskakoro, phende e Avraamese: “O Develi tuja ano sa so ćereja. <verse eid="GEN 21:22" /><verse number="23" style="v" sid="GEN 21:23" />Adalese ha sovli akate anglo Devel da naka prevarine ni man, ni mle čhaven, ni mle potomkonen, nego da ka ove šukar premala mande hem premali akaja phuv ani savi živineja sar abanđija sar so hem me injumle šukar premala tute.”<verse eid="GEN 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 21:24" />A o Avraam phenđa: “Hava sovli da ka ćerav ađahar!”<verse eid="GEN 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 21:25" />Tegani o Avraam žalinđa pe e Avimelehese zbog o bunari e panjeja savo e Avimelehesere sluge ki sila lelje lestar.<verse eid="GEN 21:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 21:26" />A o Avimeleh phenđa: “Na džanav ko adava ćerđa. Tu adalestar ništa na phenđan maje. Me zako adava tek avdive šunava.”<verse eid="GEN 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 21:27" />O Avraam lelja nešto oti sitno hem oti krupno stoka hem dinđa e Avimelehese, pa on duj phandle savez.<verse eid="GEN 21:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 21:28" />Onda o Avraam odvojinđa eftane bakrorjen oto stado, <verse eid="GEN 21:28" /><verse number="29" style="v" sid="GEN 21:29" />a o Avimeleh pučlja le: “So značinena akala efta bakrorja saven cidinđan ki strana?”<verse eid="GEN 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 21:30" />O Avraam phenđa: “Primin mandar akale eftane bakrorjen sar svedočanstvo da me handljum akava bunari.”<verse eid="GEN 21:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 21:31" />Ađahar adava than dobinđa anav Beer Ševa,<note caller="+" style="f"><char style="fr" closed="false">21,31 </char><char style="ft" closed="false">Beer Ševa značini “bunari oti sovli”. Isto ađahar o jevrejsko lafi zaki sovli zvučini sar o broj efta savo angleder spomini pe. </char></note> adalese so on jekh averese hale sovli adari. <verse eid="GEN 21:31" /><verse number="32" style="v" sid="GEN 21:32" />Kad o Avimeleh hem o Avraam phandle o savez ki Beer Ševa, o Avimeleh hem o Pihol, o naredniko lesere vojskakoro, irinde pe ani phuv e Filistejconengiri. <verse eid="GEN 21:32" /><verse number="33" style="v" sid="GEN 21:33" />O Avraam sadinđa kaš tamarisk ki Beer Ševa hem adari pokloninđa pe e GOSPODESE, e Večnone Devlese.<verse eid="GEN 21:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 21:34" />O Avraam but berša živinđa sar abanđija ani phuv e Filistejconengiri.<verse eid="GEN 21:34" /></para>
  <chapter eid="GEN 21" />
  <chapter number="22" style="c" sid="GEN 22" />
  <para style="s">O Devel testirini e Avraame</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 22:1" />Palo nesavo vreme o Devel testirinđa e Avraame.</para>
  <para style="p" vid="GEN 22:1">Vičinđa le: “Avraame!”</para>
  <para style="p" vid="GEN 22:1">A o Avraam phenđa: “Akate injum.”<verse eid="GEN 22:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 22:2" />O Devel phenđa: “Le te čhave e Isaake, te mangle čhave kole volineja, hem dža ki phuv Morija. Adari prinosin le sar žrtva paljenica ki jekh oti planina zaki savi me ka mothovav će.”<verse eid="GEN 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 22:3" />O Avraam uštino rano sabale, čhivđa o sedlo upro her hem lelja peja duje slugen hem ple čhave e Isaake. Kad čhinđa kašta zaki žrtva paljenica, lelja te džal nakoro than savestar o Devel vaćerđa lese.<verse eid="GEN 22:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 22:4" />A ko trito dive o Avraam vazdinđa plo šero hem dikhlja adava than odural, <verse eid="GEN 22:4" /><verse number="5" style="v" sid="GEN 22:5" />pa phenđa ple slugenđe: “Ačhoven akate uzalo her, a me hem o čhavoro ka dža adari te poklonina amen e Devlese, pa ka irina amen kora tumende.”<verse eid="GEN 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 22:6" />O Avraam lelja o kašta zaki žrtva paljenica hem čhivđa len upro dumo e Isaakesoro, a ov lelja peja žaro zaki jag hem i čhurik, pa on duj lelje te džan zajedno.<verse eid="GEN 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 22:7" />O Isaak phenđa ple dadese e Avraamese: “Dade!”</para>
  <para style="p" vid="GEN 22:7">A o Avraam phenđa: “Vaćer, mlo čhavo?”</para>
  <para style="p" vid="GEN 22:7">O Isaak phenđa: “Ače, o žaro hem o kaštai akate, ali kaj o bakroro zaki žrtva paljenica?”<verse eid="GEN 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 22:8" />O Avraam phenđa: “O Devel korkoro ka pobrinini pe zako bakroro zaki žrtva paljenica, mlo čhavo.”</para>
  <para style="p" vid="GEN 22:8">Ađahar on duj nastavinde o drom.<verse eid="GEN 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 22:9" />Kad resle đi ko than savestar o Devel vaćerđa lese, o Avraam ćerđa žrtveniko hem upro leste složinđa o kašta. Onda phandlja ple čhave e Isaake hem čhivđa le ko žrtveniko upro kašta, <verse eid="GEN 22:9" /><verse number="10" style="v" sid="GEN 22:10" />pa pružinđa plo vas hem lelja i čhurik te mudari ple čhave.<verse eid="GEN 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 22:11" />Ali o anđeo e GOSPODESORO vičinđa le taro nebo: “Avraame! Avraame!”</para>
  <para style="p" vid="GEN 22:11">A o Avraam phenđa: “Akate injum.”<verse eid="GEN 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 22:12" />O anđeo phenđa: “Ma vazde to vas upro čhavoro. Ništa ma te ćere lese! Akana džanav da daraja e Devlestar, adalese so na uskratinđan maje te čhave, te mangle čhave.”<verse eid="GEN 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 22:13" />Tegani o Avraam vazdinđa plo šero, i eče, palo leste o ovno ple šingencar zaglavime ano grmo! Ov dželo, dolinđa le hem prinosinđa le sar žrtva paljenica umesto ple čhave. <verse eid="GEN 22:13" /><verse number="14" style="v" sid="GEN 22:14" />O Avraam vičinđa adava than “O GOSPOD ka pobrinini pe.” Adalese hem đi avdive phenela pe: “Ki planina kaj o GOSPOD ka pobrinini pe.”<verse eid="GEN 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 22:15" />O anđeo e GOSPODESORO palo dujto puti vičinđa e Avraame taro nebo, <verse eid="GEN 22:15" /><verse number="16" style="v" sid="GEN 22:16" />pa phenđa lese: “Hava sovli korkoro mancar – vaćeri o GOSPOD – adalese so ćerđan adava hem so na uskratinđan maje te čhave, te mangle čhave, <verse eid="GEN 22:16" /><verse number="17" style="v" sid="GEN 22:17" />izobilno ka blagoslovinav tut hem ka umnožinav to potomstvo, pa ka ovel edobor but sar o čerenja ko nebo hem sar i pošik ki obala e moresiri. To potomstvo ka osvojini o dizja ple neprijateljengere <verse eid="GEN 22:17" /><verse number="18" style="v" sid="GEN 22:18" />hem prekalo to potomstvo ka oven blagoslovime sa o narodija ki phuv adalese so injanle maje poslušno.”<verse eid="GEN 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 22:19" />Tegani o Avraam ple čhaveja irinđa pe koro ple sluge, pa sare zajedno lelje te džan nakori Beer Ševa. I o Avraam ačhilo te živini ani Beer Ševa.<verse eid="GEN 22:19" /></para>
  <para style="s">E Nahoresere potomci</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 22:20" />Palo nesavo vreme, e Avraamese phende da i Milka bijanđa čhaven lesere phralese e Nahorese: <verse eid="GEN 22:20" /><verse number="21" style="v" sid="GEN 22:21" />o najphureder inele o Uc, lesere phralja o Buz, o Kemuel, o dad e Aramesoro, <verse eid="GEN 22:21" /><verse number="22" style="v" sid="GEN 22:22" />o Kesed, o Haz, o Pildaš, o Jidlaf hem o Betuel. <verse eid="GEN 22:22" /><verse number="23" style="v" sid="GEN 22:23" />O Betuel inele e Revekakoro dad. Akale oftone čhaven i Milka bijanđa e Avraamesere phralese e Nahorese. <verse eid="GEN 22:23" /><verse number="24" style="v" sid="GEN 22:24" />A e Nahoresiri romni ropkinja, koja vičinđa pe Reuma, bijanđa lese čhaven: e Tevahe, e Gahame, e Tahaše hem e Maahe.<verse eid="GEN 22:24" /></para>
  <chapter eid="GEN 22" />
  <chapter number="23" style="c" sid="GEN 23" />
  <para style="s">E Sarakoro meriba</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 23:1" />I Sara živinđa šelu bišu efta berš. <verse eid="GEN 23:1" /><verse number="2" style="v" sid="GEN 23:2" />Muli ano Kirjat Arbi (adavai ano Hevron) ani phuv Hanaan, a o Avraam đerdinđa koro late te žalini la hem te rovel la.<verse eid="GEN 23:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 23:3" />Kad uštino taro than kaj inele pašljardi lesiri pokojno romni, dželo koro Hetitija hem phenđa: <verse eid="GEN 23:3" /><verse number="4" style="v" sid="GEN 23:4" />“Me injum abanđija kole nane phuv hem kova živini maškara tumende. Biknen maje than akate zako paruniba, te šaj parunav mla pokojnona romnja.”<verse eid="GEN 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 23:5" />O Hetitija phende lese: <verse eid="GEN 23:5" /><verse number="6" style="v" sid="GEN 23:6" />“Šun amen, gospodarona. Tu injan moćno princo maškar amende. Parun te pokojnona romnja ano amaro najšukar grobo. Niko amendar naka branini će plo grobo te parune te romnja ano leste.”<verse eid="GEN 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 23:7" />Ko adava o Avraam uštino hem pokloninđa pe e narodose adala phuvjakere, e Hetitenđe, <verse eid="GEN 23:7" /><verse number="8" style="v" sid="GEN 23:8" />pa phenđa lenđe: “Te mangena akate te muken maje te parunav mla romnja, onda šunen man hem zamolinen e Efrone, e Coharesere čhave, <verse eid="GEN 23:8" /><verse number="9" style="v" sid="GEN 23:9" />te biknel maje i pećina Mahpela, savi pripadini olese, savi nalazini pe ko kraj oto lesoro polje. Nek biknel la maje pali pherdi cena, te ovel maje than zako paruniba maškara tumende.”<verse eid="GEN 23:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 23:10" />A o Efron bešela ine adari maškaro Hetitija. Tegani o Efron, o Hetiti, phenđa e Avraamese anglo sa o Hetitija kola ale angli kapija lesere dizjakiri: <verse eid="GEN 23:10" /><verse number="11" style="v" sid="GEN 23:11" />“Na, gospodarona. Šun man: Dava tut o polje hem dava tut i pećina savi ano leste – dava tut adava anglo mlo narodo. Parun te pokojnona romnja.”<verse eid="GEN 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 23:12" />O Avraam palem pokloninđa pe e narodose adala phuvjakere, <verse eid="GEN 23:12" /><verse number="13" style="v" sid="GEN 23:13" />pa phenđa e Efronese anglo adava narodo: “Molinava tut te šune man. Ka platinav će kobor o polje vredini. Prihvatin okova so dava tut, te šaj adari te parunav mla romnja.”<verse eid="GEN 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 23:14" />A o Efron phenđa e Avraamese: <verse eid="GEN 23:14" /><verse number="15" style="v" sid="GEN 23:15" />“Šun man gospodarona. Adaja phuv vredini štar kilja srebro, a adava nane but ni tuće ni maje. Parun te romnja.”<verse eid="GEN 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 23:16" />O Avraam složinđa pe e Efroneja hem merinđa lese o srebro kobor akava phenđa anglo avera Hetitija: štar kilja srebro ađahar sar so računinena len o trgovci.<verse eid="GEN 23:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 23:17" />Ađahar e Efronesoro polje ani Mahpela paše uzalo Mamre – hem o polje hem i pećina ano leste hem sa o kašta so ine ano polje <verse eid="GEN 23:17" /><verse number="18" style="v" sid="GEN 23:18" />ulo e Avraamesoro anglo sa o Hetitija kola ale angli kapija e dizjakiri. <verse eid="GEN 23:18" /><verse number="19" style="v" sid="GEN 23:19" />Palo adava o Avraam parunđa pla romnja e Sara ani pećina ko polje Mahpela paše uzalo Mamre, (adavai ano Hevron), ani phuv Hanaan.<verse eid="GEN 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 23:20" />Ađahar adava polje hem i pećina oto Hetitija ule e Avraamesere sar than zako paruniba.<verse eid="GEN 23:20" /></para>
  <chapter eid="GEN 23" />
  <chapter number="24" style="c" sid="GEN 24" />
  <para style="s">O Isaak hem i Reveka</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 24:1" />O Avraam inele već but purano, hem o GOSPOD ano sa blagoslovinđa le.<verse eid="GEN 24:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 24:2" />Ov phenđa ple naj phuredere slugase ano čher, okolese kova upravinđa sa lesere barvalipnaja: “Čhiv to vas maškaro mle ćanga, <verse eid="GEN 24:2" /><verse number="3" style="v" sid="GEN 24:3" />hem ha maje sovli e GOSPODEJA, kovai Devel oto nebo hem oti phuv, da mle čhavese naka ane nesava romnja oto čhaja e Hanaanconengere, maškaro kolende živinava. <verse eid="GEN 24:3" /><verse number="4" style="v" sid="GEN 24:4" />Ha maje sovli da ka dža ki mli phuv, ki mli familija, hem adari ka arakhe romnja mle čhavese e Isaakese.”<verse eid="GEN 24:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 24:5" />O sluga pučlja e Avraame: “A so te na manglja adaja đuvli te avel mancar ani akaja phuv? Valjani li onda te legarav hem te čhave ani phuv kotar tu aljan?”<verse eid="GEN 24:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 24:6" />A o Avraam phenđa lese: “Na! Nisar ma te legare mle čhave adari. <verse eid="GEN 24:6" /><verse number="7" style="v" sid="GEN 24:7" />O GOSPOD, o Devel oto nebo, kova ikalđa man oto čher mle dadesoro hem oti phuv ani savi injum bijando, vaćerđa mancar hem halja pe maje sovli: ‘Te potomstvose ka dav akaja phuv.’ Ov ka bičhali angla tute ple anđeo sar te šaj tu adathar te ane romnja mle čhavese. <verse eid="GEN 24:7" /><verse number="8" style="v" sid="GEN 24:8" />A te na manglja adaja đuvli te avel tuja akari, tu ka ove oslobodime oti akaja sovli savi haljan maje. Ali, mle čhave nisar ma legar adari!”<verse eid="GEN 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 24:9" />Tegani o sluga čhivđa plo vas maškaro ćanga ple gospodaresere e Avraamesere hem halja pe lese sovli.<verse eid="GEN 24:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 24:10" />Palo adava lelja deše kamilen taro krdo ple gospodaresoro pa dželo, legarindoj peja sa o skupa darija oto plo gospodari. Tegani alo ano Aram Naharajim, ani diz e Nahoresiri. <verse eid="GEN 24:10" /><verse number="11" style="v" sid="GEN 24:11" />Kad reslo angli diz, terinđa e kamilen te pašljon anglo jekh bunari. Adava inele angli rat, zako vreme kad o đuvlja ikljona ine te dolen pani.<verse eid="GEN 24:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 24:12" />Ov phenđa: “GOSPODE, tu kova injan Devel mle gospodaresoro e Avraamesoro, pomožin maje avdive hem mothov to mangipe mle gospodarese e Avraamese. <verse eid="GEN 24:12" /><verse number="13" style="v" sid="GEN 24:13" />Ače, terđovava anglo akava izvor, a o čhaja e dizutnengere ikljovena te dolen pani. <verse eid="GEN 24:13" /><verse number="14" style="v" sid="GEN 24:14" />Kola čhajaće ka phenav: ‘Molinava tut, de man te pijav pani taro to khoro’, a oj te phenel: ‘Ale pi, a ka dav hem te kamilenđe te pijen’ – nek oj ovel adaja kola tu odredinđan zako to sluga o Isaak. Palo adava ka džanav da mothovđan to mangipe mle gospodarese.”<verse eid="GEN 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 24:15" />I angleder nego so završinđa i molitva, i Reveka iklili ple khoreja ko piko. Oj inele čhaj e Betuelesiri, kova inele čhavo e Milkakoro hem e Avraamesere phralesoro e Nahoresoro. <verse eid="GEN 24:15" /><verse number="16" style="v" sid="GEN 24:16" />I đuvli inele but šuži hem inele čhaj – adalese so pana na inele nijekhe muršeja. Oj huljili đi ko izvor, pherđa o khoro hem uklinđa upre.<verse eid="GEN 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 24:17" />O sluga prastandilo đi late, pa phenđa laće: “Molinava tut de man te pijav hari pani taro to khoro.”<verse eid="GEN 24:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 24:18" />Oj phenđa lese: “Pi, gospodarona!” Pa ki sig muklja o khoro ko vas hem dinđa le te pijel.<verse eid="GEN 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 24:19" />Palo adava so dinđa le te pijel, oj phenđa lese: “Hem te kamilenđe ka dolav pani te pijen đikote na čaljona.”<verse eid="GEN 24:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 24:20" />Hem oj ki sig čhorđa o khoro ani kopana, pa prastandili palal đi ko bunari te dolel pana pani. I ađahar anđa pani zako sa lesere kamile. <verse eid="GEN 24:20" /><verse number="21" style="v" sid="GEN 24:21" />O sluga traindoj dikhela la ine šukar, te dikhel da li o GOSPOD ćerđa lesoro drom te ovel uspešno.<verse eid="GEN 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 24:22" />Kad čalile o kamile, o manuš dinđa la skupoceno zlatno angrustik zako nakh hem duj po bare zlatna narukvice. <verse eid="GEN 24:22" /><verse number="23" style="v" sid="GEN 24:23" />Tegani pučlja la: “Molinav tut, phen maje kasiri čhaj injan? Isi li than te dadese ano čher te primini amen te nakhava i rat adari?”<verse eid="GEN 24:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 24:24" />A oj phenđa lese: “Me injum e Betuelesiri čhaj, kovai e Milkakoro hem e Nahoresoro čhavo.” <verse eid="GEN 24:24" /><verse number="25" style="v" sid="GEN 24:25" />I phenđa lese: “Kora amende isi pherdo pus hem hajba zako kamile, a hem isi than tumenđe te nakhaven i rat adari.”<verse eid="GEN 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 24:26" />O sluga tegani pelo mujeja đi phuv hem pokloninđa pe e GOSPODESE, <verse eid="GEN 24:26" /><verse number="27" style="v" sid="GEN 24:27" />vaćerindoj: “Blagoslovime te ovel o GOSPOD, o Devel mle gospodaresoro e Avraamesoro, so na čhinavđa mle gospodare oto plo mangipe hem oti pli vernost. O GOSPOD legarđa man dromeja đi ko čher oti familija mle gospodaresiri.”<verse eid="GEN 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 24:28" />Tegani i čhaj prastandili hem sa akava vaćerđa pla dajakere čherutnenđe. <verse eid="GEN 24:28" /><verse number="29" style="v" sid="GEN 24:29" />A e Reveka ine phral kova vičinđa pe Lavan. Ov prastandilo avri đi e Avraamesoro sluga ko izvor, <verse eid="GEN 24:29" /><verse number="30" style="v" sid="GEN 24:30" />adalese so dikhlja i zlatno angrustik pe phenjaće e Revekaće ko nakh hem o narukvice ko vasta hem šunđa olatar sa so phenđa laće okova manuš. Kad alo đi o sluga e Avraamesoro, arakhlja le sar terđola uzalo kamile ko izvor, <verse eid="GEN 24:30" /><verse number="31" style="v" sid="GEN 24:31" />pa phenđa lese: “Ava, tu kole o GOSPOD blagoslovinđa. Sose terđoveja avri? Spreminđum će soba hem than e kamilenđe.”<verse eid="GEN 24:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 24:32" />E Avraamesoro sluga đerdinđa ano čher. E Lavanesere sluge huljavde oto kamile o pharipe hem ande lenđe zako hajba hem pus, a e Avraamesere slugase hem lesere manušenđe ande pani te thoven pumare pre.<verse eid="GEN 24:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 24:33" />Tegani ikalde anglo leste te hal, a ov phenđa lenđe: “Me naka hav maro dok na phenava sose aljum.”</para>
  <para style="p" vid="GEN 24:33">A o Lavan phenđa lese: “Vaćer.”<verse eid="GEN 24:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 24:34" />Ov phenđa: “Me injum o sluga e Avraamesoro. <verse eid="GEN 24:34" /><verse number="35" style="v" sid="GEN 24:35" />O GOSPOD izobilno blagoslovinđa mle gospodare, hem ov barvalilo. Dinđa le sitno hem krupno stoka, srebro hem zlato, robonen hem ropkinjen, kamilen hem hernen. <verse eid="GEN 24:35" /><verse number="36" style="v" sid="GEN 24:36" />A i Sara, i romni mle gospodaresiri, bijanđa lese čhave ko purane berša, pa sa so isi le dinđa olese. <verse eid="GEN 24:36" /><verse number="37" style="v" sid="GEN 24:37" />Mlo gospodari rodinđa te hav lese sovli hem phenđa maje: ‘Ma te ane mle čhavese romnja oto čhaja e Hanaanconengere, maškaro kolende živinava. <verse eid="GEN 24:37" /><verse number="38" style="v" sid="GEN 24:38" />Nego, dža ano čher mle dadesoro hem kori mli familija hem adari arakh romnja mle čhavese.’ <verse eid="GEN 24:38" /><verse number="39" style="v" sid="GEN 24:39" />Tegani me pučljum mle gospodare: ‘A so te na manglja adaja đuvli te avel mancar?’ <verse eid="GEN 24:39" /><verse number="40" style="v" sid="GEN 24:40" />A ov phenđa maje: ‘O GOSPOD, angla kaste živinava ćerindoj olesiri volja, ka bičhali tuja ple anđeo hem ka ćerel to drom te ovel uspešno, pa tu ka arakhe mle čhavese romnja oti mli familija hem oto čher mle dadesoro. <verse eid="GEN 24:40" /><verse number="41" style="v" sid="GEN 24:41" />Tegani, kad ka ave kori mli familija, ka ove slobodno oti mli sovli. Čak hem te on na dinde tut e čhaja, tu ka ove slobodno oti mli sovli.’<verse eid="GEN 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="GEN 24:42" />Kad resljum avdive anglo izvor, phenđum: ‘GOSPODE, tu kova injan Devel mle gospodaresoro e Avraamesoro, te mangeja, molinava tut, pomožin maje te ovel uspešno o drom ko savo leljum te džav. <verse eid="GEN 24:42" /><verse number="43" style="v" sid="GEN 24:43" />Ače, terđovava anglo akava izvor. Te nesavi čhaj avela te dolel pani hem me te phenđum laće: Molinava tut, de man te pijav hari pani taro to khoro, <verse eid="GEN 24:43" /><verse number="44" style="v" sid="GEN 24:44" />a oj te phenel maje: Ale pi, a ka dav hem te kamilenđe te pijen – nek oj ovel adaja kola o GOSPOD odredinđa mle gospodaresere čhavese.’ <verse eid="GEN 24:44" /><verse number="45" style="v" sid="GEN 24:45" />I angleder so te završinav i molitva ana mande, i Reveka iklili e khoreja pese ko piko. Huljili đi ko izvor te dolel pani, a me phenđum laće: ‘Molinav tut de man te pijav pani.’ <verse eid="GEN 24:45" /><verse number="46" style="v" sid="GEN 24:46" />Oj ki sig muklja o khoro oto piko hem phenđa: ‘Ale pi, a ka dolav pani hem te kamilenđe te pijen’. I ađahar piljum, a oj dinđa e kamilenđe te pijen. <verse eid="GEN 24:46" /><verse number="47" style="v" sid="GEN 24:47" />Tegani pučljum la: ‘Kasiri čhaj tu injan?’ A oj phenđa maje: ‘Me injum e Betuelesiri čhaj, kovai e Milkakoro hem e Nahoresoro čhavo.’ Tegani čhivđum laće i angrustik ko nakh hem o narukvice ko vasta, <verse eid="GEN 24:47" /><verse number="48" style="v" sid="GEN 24:48" />pa peljum mujeja đi phuv hem pokloninđum man e GOSPODESE. Blagoslovinđum e GOSPODE, kovai Devel mle gospodaresoro e Avraamesoro, kova legarđa man pravone dromeja, te arakhav mle gospodaresere phralesere unuka lese čhavese. <verse eid="GEN 24:48" /><verse number="49" style="v" sid="GEN 24:49" />A akana, te mangena te mothoven mangipe hem vernost mle gospodarese, phenen maje. A hem te na mangena, phenen maje, te džanav ko soste injum.”<verse eid="GEN 24:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="GEN 24:50" />O Lavan hem o Betuel phende: “Oto GOSPOD akava alo; amen našti te phena ni šaj, a ni našti. <verse eid="GEN 24:50" /><verse number="51" style="v" sid="GEN 24:51" />Ače i Reveka angla tute – le la hem dža. Nek ovel romni te gospodaresere čhavese, sar so o GOSPOD odredinđa.”<verse eid="GEN 24:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="GEN 24:52" />Kad šunđa so phende lese, e Avraamesoro sluga pelo mujeja đi phuv hem pokloninđa pe e GOSPODESE. <verse eid="GEN 24:52" /><verse number="53" style="v" sid="GEN 24:53" />Tegani ikalđa o nakit oto srebro hem oto zlato hem šeja hem dinđa len e Revekaće, a hem lakere phralese hem lakere dajaće dinđa skupa darija. <verse eid="GEN 24:53" /><verse number="54" style="v" sid="GEN 24:54" />Tegani ov hem o manuša kola inele oleja lelje te han hem te pijen hem adari suće.</para>
  <para style="p" vid="GEN 24:54">Sabale kad uštine, o sluga phenđa: “Muken man te irinav man mle gospodareste.”<verse eid="GEN 24:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="GEN 24:55" />A e Revekakoro phral hem i daj phende: “Nek ačhol i čhaj amencar pana jekh deš dive, a onda nek džal.”<verse eid="GEN 24:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="GEN 24:56" />Ali o sluga phenđa lenđe: “Ma zadržinen man akana kad o GOSPOD ćerđa mlo drom te ovel uspešno. Muken man te irinav man mle gospodareste.”<verse eid="GEN 24:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="GEN 24:57" />A on phende lese: “Ka vičina e čhaja hem ka puča la so oj mislini.”<verse eid="GEN 24:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="GEN 24:58" />Tegani vičinde e Reveka hem pučle la: “Mangeja li akana te dža akale manušeja?”</para>
  <para style="p" vid="GEN 24:58">A oj phenđa lenđe: “Mangava.”<verse eid="GEN 24:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="GEN 24:59" />Tegani on ispratinde pumara phenja e Reveka hem e sluškinja koja barjarđa la hem e Avraamesere sluga hem lesere manušen.<verse eid="GEN 24:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="GEN 24:60" />I blagoslovinde e Reveka vaćerindoj:</para>
  <para style="b" vid="GEN 24:60" />
  <para style="q1" vid="GEN 24:60">“Phene amarije,</para>
  <para style="q2" vid="GEN 24:60">tutar te ikljon hiljade hem hiljade čhave,</para>
  <para style="q1" vid="GEN 24:60">hem te potomci nek prelen</para>
  <para style="q2" vid="GEN 24:60">o dizja okolengere kola mrzinena len.”<verse eid="GEN 24:60" /></para>
  <para style="b" />
  <para style="p">
    <verse number="61" style="v" sid="GEN 24:61" />Onda i Reveka hem lakere sluškinje spreminde pe, bešle upro kamile hem lelje te džan e Avraamesere slugaja. Ađahar o sluga lelja e Reveka peja.<verse eid="GEN 24:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="GEN 24:62" />A tegani o Isaak samo so alo oti Beer Lahaj Roija, adalese so živinđa ano Negev. <verse eid="GEN 24:62" /><verse number="63" style="v" sid="GEN 24:63" />Jekh rat kad iklilo ano polje te phirel, vazdinđa plo šero hem dikhlja sar o kamile avena po paše.<verse eid="GEN 24:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="GEN 24:64" />A i Reveka vazdinđa plo šero hem dikhlja e Isaake, pa huljili oti pli kamila <verse eid="GEN 24:64" /><verse number="65" style="v" sid="GEN 24:65" />hem pučlja e Avraamesere sluga: “Kovai okova manuš ano polje so avela premala amende?”</para>
  <para style="p" vid="GEN 24:65">O sluga phenđa laće: “Adavai mlo gospodari.”</para>
  <para style="p" vid="GEN 24:65">I oj lelja plo veo hem učharđa pe.<verse eid="GEN 24:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="GEN 24:66" />Tegani o sluga vaćerđa e Isaakese sa so ćerđa. <verse eid="GEN 24:66" /><verse number="67" style="v" sid="GEN 24:67" />O Isaak anđa e Reveka ano šatori pla dajakoro e Sarakoro, hem oj uli lesiri romni. O Isaak, palo adava so muli lesiri daj, arakhlja uteha ano mangipe premali Reveka.<verse eid="GEN 24:67" /></para>
  <chapter eid="GEN 24" />
  <chapter number="25" style="c" sid="GEN 25" />
  <para style="s">Avera potomci e Avraamesere</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 25:1" />O Avraam leljafse avera romnja, koja vičinđa pe Ketura.<verse eid="GEN 25:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 25:2" />Oj bijanđa lese e Zimrane, e Jokšane, e Medane, e Midijane, e Jišbake hem e Šuahe.<verse eid="GEN 25:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 25:3" />E Jokšanese bijandile o Ševa hem o Dedan.</para>
  <para style="p" vid="GEN 25:3">E Dedaneserei potomci: o Ašurci, o Letušci hem o Leumci.<verse eid="GEN 25:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 25:4" />E Midijanesere čhavei: o Efa, o Efer, o Enoh, o Avida hem o Eldaa.</para>
  <para style="p" vid="GEN 25:4">Sarei on e Keturakere potomci.<verse eid="GEN 25:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 25:5" />Sa so inole, o Avraam ačhavđa e Isaakese, <verse eid="GEN 25:5" /><verse number="6" style="v" sid="GEN 25:6" />a e čhavenđe kola inole pe romnjaja e ropkinjaja pana dok inele dživdo podelinđa darija hem bičhalđa len ko phuvja ano istok – dur oto Isaak.<verse eid="GEN 25:6" /></para>
  <para style="s">E Avraamesoro meriba</para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 25:7" />O Avraam živinđa šelu eftavardešu pandž berš. <verse eid="GEN 25:7" /><verse number="8" style="v" sid="GEN 25:8" />Mulo ano plo baro hem šukar phuripe, palo but berša, hem pridružinđa pe ple pradadenđe. <verse eid="GEN 25:8" /><verse number="9" style="v" sid="GEN 25:9" />Lesere čhave o Isaak hem o Ismailo parunde le ani pećina Mahpela paše uzalo Mamre, ko polje e Efronesoro, kova inele čhavo e Coharesoro e Hetitesoro, <verse eid="GEN 25:9" /><verse number="10" style="v" sid="GEN 25:10" />ko polje savo o Avraam činđa oto Hetitija. Adari o Avraam parume uzali pli romni i Sara.<verse eid="GEN 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 25:11" />Palo e Avraamesoro meriba, o Devel blagoslovinđa lesere čhave e Isaake, kova tegani živinđa ano Beer Lahaj Roi.<verse eid="GEN 25:11" /></para>
  <para style="s">E Ismailosere potomci</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 25:12" />Akavai o zapis e Avraamesere čhavestar e Ismailostar, kole bijanđa i Egipćanka i Agara, e Sarakiri ropkinja.<verse eid="GEN 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 25:13" />Akavai o anava e Ismailosere čhavengoro palo redo sar bijandile:</para>
  <para style="p" vid="GEN 25:13">e Ismailosoro prvobijando čhavoi o Nevajot, pa o Kedar, o Adbeel, o Mivsam,<verse eid="GEN 25:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 25:14" />o Mišma, o Duma, o Masa,<verse eid="GEN 25:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 25:15" />o Hadad, o Tema, o Jetur, o Nafiš hem o Kedma.<verse eid="GEN 25:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 25:16" />Adavai e Ismailosere čhave, dešu duj vladarija upro dešu duj plemija, palo kolendei vičime lengere thana kaj živinena hem lengere taborija. <verse eid="GEN 25:16" /><verse number="17" style="v" sid="GEN 25:17" />O Ismailo živinđa šelu trijandu efta berš, mulo hem pridružinđa pe ple pradadenđe. <verse eid="GEN 25:17" /><verse number="18" style="v" sid="GEN 25:18" />Lesere potomci lelje te živinen ko than maškari Havila hem Šur, savei taro Egipat premali Asirija, a živinde ano neprijateljstvo pumare phraljencar.<verse eid="GEN 25:18" /></para>
  <para style="s">Sar bijandile o Isav hem o Jakov</para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 25:19" />Akavai o zapis e Isaakestar, e Avraamesere čhavestar.</para>
  <para style="p" vid="GEN 25:19">E Avraamese bijandilo o Isaak. <verse eid="GEN 25:19" /><verse number="20" style="v" sid="GEN 25:20" />E Isaake ine saranda berš kad ženinđa pe e Revekaja. I Reveka inele čhaj e Aramejcosiri e Beteulesiri kovai taro Padan Aram, a phen e Aramejcosiri e Lavanesiri.<verse eid="GEN 25:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 25:21" />O Isaak molinđa pe e GOSPODESE zaki pli romni, adalese so inele nerotkinja. O GOSPOD uslišinđa lesiri molitva hem lesiri romni i Reveka ačhili khamni.<verse eid="GEN 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 25:22" />Ali o čhave ano lakoro vođi edobor gurinde pe da oj phenđa: “So desini pe akava mancar?”</para>
  <para style="p" vid="GEN 25:22">Adalese dželi te pučel e GOSPODE.<verse eid="GEN 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 25:23" />O GOSPOD phenđa laće:</para>
  <para style="b" vid="GEN 25:23" />
  <para style="q1" vid="GEN 25:23">“Duj narodijai ano to vođi,</para>
  <para style="q2" vid="GEN 25:23">duj narodija ka podelinen pe taro to vođi.</para>
  <para style="q1" vid="GEN 25:23">Jekh ka ovel po zoralo e dujtonestar</para>
  <para style="q2" vid="GEN 25:23">hem o phureder ka služini e tiknederese.”<verse eid="GEN 25:23" /></para>
  <para style="b" />
  <para style="p">
    <verse number="24" style="v" sid="GEN 25:24" />Kad alo o vreme te bijani, eče, ano lakoro vođi inele blizanci. <verse eid="GEN 25:24" /><verse number="25" style="v" sid="GEN 25:25" />O prvo kova iklilo inele lolo hem balalo sar ogrtači. Adalese dinde le anav Isav.<note caller="+" style="f"><char style="fr" closed="false">25,25 </char><char style="ft" closed="false">Isav ko jevrejski zvučini “balalo”.</char></note> <verse eid="GEN 25:25" /><verse number="26" style="v" sid="GEN 25:26" />Palo adava iklilo lesoro phral, ićerindoj vasteja i patum e Isavesiri. Adalese dinde le anav Jakov.<note caller="+" style="f"><char style="fr" closed="false">25,26 </char><char style="ft" closed="false">Jakov ko jevrejski značini: “okova kova ićeri pe ki patum” ili “prevaranti”. </char></note> E Isaake ine šovardeš berš kad i Reveka bijanđa.<verse eid="GEN 25:26" /></para>
  <para style="s">O Isav biknela plo prvorodstvo</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 25:27" />Kad o čhavore barile, o Isav ulo šukar lovco hem volinđa te ovel avri ko phravdo than, a o Jakov inele povucime manuš hem volinđa te ovel čhere, ano šatori. <verse eid="GEN 25:27" /><verse number="28" style="v" sid="GEN 25:28" />O Isaak volinđa više e Isave, adalese so volinđa te hal o mas oto divlja životinje saven o Isav mudarđa. A i Reveka više volinđa e Jakove.<verse eid="GEN 25:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 25:29" />Jekhvar sar o Jakov spremini ine čorba, o Isav alo taro polje but bokhalo, <verse eid="GEN 25:29" /><verse number="30" style="v" sid="GEN 25:30" />pa phenđa e Jakovese: “De man hari adaja loli čorba! Merava bokhatar!” (Adalese vičinde le Edom.<note caller="+" style="f"><char style="fr" closed="false">25,30 </char><char style="ft" closed="false">Edom ko jevrejski zvučini “lolo”.</char></note>)<verse eid="GEN 25:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 25:31" />O Jakov phenđa: “Prvo biknin maje to pravo ko prvorodstvo.”<verse eid="GEN 25:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 25:32" />O Isav phenđa: “Dikh, samo so na merava bokhatar. So vredini maje o pravo ko prvorodstvo?”<verse eid="GEN 25:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 25:33" />A o Jakov phenđa: “Prvo ha tut maje sovli.”</para>
  <para style="p" vid="GEN 25:33">I o Isav halja pe lese sovli hem ađahar e Jakovese bikninđa plo pravo ko prvorodstvo.<verse eid="GEN 25:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 25:34" />Tegani o Jakov dinđa e Isavese maro hem čorba oto leće, hem o Isav halja hem pilja, pa uštino hem dželo.</para>
  <para style="p" vid="GEN 25:34">Ađahar o Isav na marinđa zako plo pravo ko prvorodstvo.<verse eid="GEN 25:34" /></para>
  <chapter eid="GEN 25" />
  <chapter number="26" style="c" sid="GEN 26" />
  <para style="s">O Isaak ano Gerar</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 26:1" />A ani phuv inele bokhalipe sar ano okova vreme e Avraamesoro, pa o Isaak dželo ano Gerar koro Avimeleh, o caro e Filistejconengoro.<verse eid="GEN 26:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 26:2" />O GOSPOD mothovđa pe e Isaakese hem phenđa: “Ma dža tele ano Egipat, nego le živin ani phuv ani savi me ka phenav će. <verse eid="GEN 26:2" /><verse number="3" style="v" sid="GEN 26:3" />Ov nesavo vreme ani akaja phuv, a me ka ovav tuja hem ka blagoslovinav tut. Adalese so, tuće hem te potomkonenđe ka dav sa akala phuvja hem ka potvrdinav o obećanje savo dinđum te dadese e Avraamese. <verse eid="GEN 26:3" /><verse number="4" style="v" sid="GEN 26:4" />Ka umnožinav to potomstvo sar o čerenja ko nebo hem ka dav len sa akala phuvja. Sa o narodija ki phuv ka oven blagoslovime prekalo to potomstvo <verse eid="GEN 26:4" /><verse number="5" style="v" sid="GEN 26:5" />adalese so o Avraam ine maje poslušno hem ićerđa pe ko sa so phenđum lese, ko mle naredbe, odredbe hem zakonja.”<verse eid="GEN 26:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 26:6" />Ađahar o Isaak ačhilo ano Gerar.<verse eid="GEN 26:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 26:7" />Kad o manuša kola živinde adari pučle le zaki lesiri romni, ov phenđa lenđe: “Oj mli phen”, adalese so darandilo te phenel: “Oj mli romni.” Mislinđa: “Akava narodo šaj te mudari man zbog i Reveka, adalese soi šuži.”<verse eid="GEN 26:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 26:8" />Kad o Isaak već but vreme inele ano Gerar, o Avimeleh, o caro e Filistejconengoro, dikhlja taro prozori, a kad adari – o Isaak milujini pla romnja e Reveka!<verse eid="GEN 26:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 26:9" />O Avimeleh vičinđa e Isaake hem phenđa: “Znači, oj ti romni! Sose phenđan: ‘Oj mli phen?’ ”</para>
  <para style="p" vid="GEN 26:9">O Isaak phenđa: “Adalese so mislinđum da zbog olate šaj te ovav mudardo.”<verse eid="GEN 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 26:10" />Ko adava o Avimeleh phenđa: “So ćerđan amenđe adava? Neko oto manuša šaj ine te sovel te romnjaja, pa ađahar ka čhive ine krivica upro amende!”<verse eid="GEN 26:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 26:11" />Onda o Avimeleh naredinđa sa e narodose: “Ko ka ćerel nešto bišukar akale manušese ili lesere romnjaće, ka ovel mudardo.”<verse eid="GEN 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 26:12" />O Isaak sejinđa ko njive ani adaja phuv, hem ano isto berš čedinđa o bijandipe šel puti više, adalese so o GOSPOD blagoslovinđa le. <verse eid="GEN 26:12" /><verse number="13" style="v" sid="GEN 26:13" />Ađahar ov barvalilo hem lesoro barvalipe sa po više barilo, sa đikote na ulo but barvalo. <verse eid="GEN 26:13" /><verse number="14" style="v" sid="GEN 26:14" />Inole edobor sitno hem krupno stoka hem edobor sluge da sa o Filistejci inele ljubomorna. <verse eid="GEN 26:14" /><verse number="15" style="v" sid="GEN 26:15" />Adalese o Filistejci phuvjaja pherde sa o bunarija save handle o sluge lesere dadesere e Avraamesere.<verse eid="GEN 26:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 26:16" />Tegani o Avimeleh phenđa e Isaakese: “Dža amendar, adalese so uljan po zoralo amendar.”<verse eid="GEN 26:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 26:17" />I o Isaak dželo adathar hem vazdinđa po šatori ani dolina e Geraresiri, pa adari živinđa. <verse eid="GEN 26:17" /><verse number="18" style="v" sid="GEN 26:18" />Ov palem handlja o bunarija save inele handle ano vreme lesere dadesoro e Avraamesoro, a saven o Filistejci palo e Avraamesoro meriba phuvjaja pherde, hem dinđa len ista anava sar so dinđa len hem lesoro dad.<verse eid="GEN 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 26:19" />Kad e Isaakesere sluge handle ani dolina, arakhle bunari e dživde panjeja, <verse eid="GEN 26:19" /><verse number="20" style="v" sid="GEN 26:20" />o gerarska pastirija dolinde pe ki kavga e Isaakesere pastirencar, vaćerindoj: “Adavai amaro pani!”</para>
  <para style="p" vid="GEN 26:20">Adalese o Isaak adava bunari vičinđa Esek,<note caller="+" style="f"><char style="fr" closed="false">26,20 </char><char style="ft" closed="false">Esek značini: “kavga”.</char></note> adalese so zbog adava bunari ćerde kavga oleja. <verse eid="GEN 26:20" /><verse number="21" style="v" sid="GEN 26:21" />Tegani handle aver bunari, ali hem zako olese inele kavga. Adalese o Isaak vičinđa le Sitnah.<note caller="+" style="f"><char style="fr" closed="false">26,21 </char><char style="ft" closed="false">Sitnah značini: “neprijateljstvo”.</char></note> <verse eid="GEN 26:21" /><verse number="22" style="v" sid="GEN 26:22" />O Isaak dželo adathar, pa handlja pana jekh bunari, i niko na ćerđa kavga zako olese. O Isaak vičinđa le Rehovot,<note caller="+" style="f"><char style="fr" closed="false">26,22 </char><char style="ft" closed="false">Rehovot značini “baro than”.</char></note> vaćerindoj: “O GOSPOD dinđa amen akana baro than te množina amen ki phuv.”<verse eid="GEN 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 26:23" />Adathar o Isaak dželo ani Beer Ševa.<verse eid="GEN 26:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 26:24" />Adaja rat o GOSPOD mothovđa pe lese hem phenđa: “Me injum o Devel te dadesoro e Avraamesoro. Ma dara, adalese so me injum tuja. Ka blagoslovinav tut hem ka umnožinav te potomkonen zbog mlo sluga o Avraam.”<verse eid="GEN 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 26:25" />O Isaak adari ćerđa žrtveniko hem pokloninđa pe e GOSPODESE. Adari vazdinđa po šatori, a lesere sluge lelje te hanen bunari.<verse eid="GEN 26:25" /></para>
  <para style="s">O Isaak phandela savez e Avimeleheja</para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 26:26" />Taro Gerar o Avimeleh ple savetnikoja e Ahuzateja hem e Piholeja, e zapovednikoja lesere vojskakere, alo koro Isaak.<verse eid="GEN 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 26:27" />O Isaak pučlja le: “Sose aljen kora mande kad mrzinena man hem kad phenđen maje te džav tumendar?”<verse eid="GEN 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 26:28" />On phende lese: “Dikhljam dai o GOSPOD čače tuja, pa mislinđam da amen maškar amende valjani te ha sovli. Ana te phanda savez tuja <verse eid="GEN 26:28" /><verse number="29" style="v" sid="GEN 26:29" />da naka ćere amenđe bišukaripe, sar so hem ni amen tuće na ćerđam bišukaripe, nego tuja uvek injamle šukar hem mukljam tut te dža ano mir. A akana o GOSPOD blagoslovinđa tut.”<verse eid="GEN 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 26:30" />Tegani o Isaak pripreminđa lenđe gozba, pa hale hem pile. <verse eid="GEN 26:30" /><verse number="31" style="v" sid="GEN 26:31" />Sabale uštine rano hem jekh averese hale sovli. O Isaak onda ispratinđa len, hem on džele olestar ano mir.<verse eid="GEN 26:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 26:32" />Adava dive e Isaakesere sluge ale hem javinde lese oto bunari savo handle. Phende lese: “Arakhljam pani!” <verse eid="GEN 26:32" /><verse number="33" style="v" sid="GEN 26:33" />Adava bunari vičinđa Šiva. Adalese hem avdive adaja diz vičini pe Beer Ševa.<verse eid="GEN 26:33" /></para>
  <para style="s">E Isavesere romnja</para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 26:34" />Kad e Isave ine saranda berš, ženinđa pe e Juditaja koja inele čhaj e Beerijasiri e Hetitesiri hem e Bosmataja koja inele čhaj e Elonesiri e Hetitesiri. <verse eid="GEN 26:34" /><verse number="35" style="v" sid="GEN 26:35" />On duj džene ćerde bare muke e Isaakese hem e Revekaće.<verse eid="GEN 26:35" /></para>
  <chapter eid="GEN 26" />
  <chapter number="27" style="c" sid="GEN 27" />
  <para style="s">O Jakov ki prevara dobini e dadesoro blagoslov</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 27:1" />Kad o Isaak purandilo hem lesere jaćha ule bizorale da našti ine više te dikhel, vičinđa ple phuredere čhave e Isave hem phenđa: “Mlo čhavo!”</para>
  <para style="p" vid="GEN 27:1">A o Isav phenđa: “Akate injum dade!”<verse eid="GEN 27:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 27:2" />O Isaak phenđa: “Ače, purandiljum hem na džanav o dive kad ka merav. <verse eid="GEN 27:2" /><verse number="3" style="v" sid="GEN 27:3" />Adalese le to oružje – ti džidajka hem te strele – pa dža ano polje hem dole maje nesava divljona životinja. <verse eid="GEN 27:3" /><verse number="4" style="v" sid="GEN 27:4" />Onda ćer maje šužo habe, ađahar sar so me volinava, pa ana maje te hav, te blagoslovinav tut angleder so te merav.”<verse eid="GEN 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 27:5" />A i Reveka šunđa sar o Isaak vaćeri pe čhaveja e Isaveja, pa kad o Isav dželo ano polje te dolel divljona životinja hem te anel la ple dadese, <verse eid="GEN 27:5" /><verse number="6" style="v" sid="GEN 27:6" />i Reveka phenđa pe čhavese e Jakovese: “Ače, samo so šunđum te dade sar vaćeri te phralese e Isavese: <verse eid="GEN 27:6" /><verse number="7" style="v" sid="GEN 27:7" />‘Ana maje nesava divljona životinja hem ćer maje šužo habe te hav, pa te blagoslovinav tut anglo GOSPOD angleder so te merav.’ <verse eid="GEN 27:7" /><verse number="8" style="v" sid="GEN 27:8" />Adalese šun man akana, mlo čhavo, hem ćer sar so ka phenav će. <verse eid="GEN 27:8" /><verse number="9" style="v" sid="GEN 27:9" />Dža đi ko stado hem ana maje duje šuže jarconen, te ćerav olendar šukar habe te dadese, ađahar sar so ov volini. <verse eid="GEN 27:9" /><verse number="10" style="v" sid="GEN 27:10" />Tegani tu ka legare le te dadese te hal, te šaj te blagoslovini tut angleder so te merel.”<verse eid="GEN 27:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 27:11" />Ko adava o Jakov phenđa pla dajaće e Revekaće: “Ali mloi phral o Isav balalo manuš, a me na injum. <verse eid="GEN 27:11" /><verse number="12" style="v" sid="GEN 27:12" />A so te mlo dad pipinđa man? Ka isperav hovavno anglo leste, pa upra mande ka čhivav prokletstvo, a na blagoslov.”<verse eid="GEN 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 27:13" />A lesiri daj phenđa lese: “Mlo čhavo, nek to prokletstvo perel upra mande. Samo šun tu man: dža hem ana maje e jarconen.”<verse eid="GEN 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 27:14" />Hem ov dželo, dolinđa e jarconen hem anđa len pla dajaće, a oj ćerđa šužo habe, ađahar sar so volini lesoro dad. <verse eid="GEN 27:14" /><verse number="15" style="v" sid="GEN 27:15" />Tegani i Reveka lelja o najšuže šeja ple phuredere čhavesere e Isavesere save inola ano čher, pa urjavđa ple tiknedere čhave e Jakove, <verse eid="GEN 27:15" /><verse number="16" style="v" sid="GEN 27:16" />a ko vasta hem ki men čhivđa lese i koža e jarcosiri. <verse eid="GEN 27:16" /><verse number="17" style="v" sid="GEN 27:17" />Onda pe čhavese e Jakovese dinđa okova šužo habe hem o maro savo ćerđa.<verse eid="GEN 27:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 27:18" />O Jakov dželo koro plo dad hem phenđa: “Dade!”</para>
  <para style="p" vid="GEN 27:18">A o Isaak phenđa: “Kova injan tu mlo čhavo?”<verse eid="GEN 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 27:19" />A o Jakov ple dadese phenđa: “Me injum o Isav, to prvobijando čhavo. Ćerđum sar so phenđan maje. Akana, molinava tut, ušti te ha hari akava so dolinđum, te šaj te blagoslovine man.”<verse eid="GEN 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 27:20" />Ali o Isaak pučlja ple čhave: “Sar adava da ađahar sigate sa ćerđan, mlo čhavo?” A o Jakov phenđa: “O GOSPOD, to Devel, pomožinđa maje ko adava.”<verse eid="GEN 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 27:21" />Tegani o Isaak phenđa e Jakovese: “Ava po paše, mlo čhavo, te pipinav tut te džanav čače li tu injan mlo čhavo o Isav ili na.”<verse eid="GEN 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 27:22" />O Jakov alo po paše uzalo plo dad o Isaak, hem ov pipinđa le, pa phenđa: “O glasoi e Jakovesoro, ali o vastai e Isavesere.”<verse eid="GEN 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 27:23" />Na pendžarđa le, adalese so lesere vasta inele balale sar lesere phralesere e Isavesere. Kad manglja te blagoslovini le, <verse eid="GEN 27:23" /><verse number="24" style="v" sid="GEN 27:24" />pučlja le pana jekhvar: “Čače li tu injan mlo čhavo o Isav?”</para>
  <para style="p" vid="GEN 27:24">A o Jakov phenđa: “Oja, me injum.”<verse eid="GEN 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 27:25" />Tegani o Isaak phenđa: “Mlo čhavo, ana maje te hav hari adava so dolinđan, te šaj te blagoslovinav tut.”</para>
  <para style="p" vid="GEN 27:25">I o Jakov anđa lese, pa o Isaak halja; hem anđa lese mol, pa o Isaak pilja.<verse eid="GEN 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 27:26" />Tegani lesoro dad o Isaak phenđa: “Akana ava po paše hem čumudin man, mlo čhavo.”<verse eid="GEN 27:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 27:27" />I o Jakov alo po paše hem čumudinđa le, a o Isaak osetinđa o miris oto lesere šeja, pa blagoslovinđa le, vaćerindoj:</para>
  <para style="b" vid="GEN 27:27" />
  <para style="q1" vid="GEN 27:27">“O miris mle čhavesoroi sar o miris oto polje</para>
  <para style="q2" vid="GEN 27:27">savo o GOSPOD blagoslovinđa.<verse eid="GEN 27:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="GEN 27:28" />Nek o Devel del tut rosa taro nebo hem plodno phuv</para>
  <para style="q2" vid="GEN 27:28">– but điv hem mol.<verse eid="GEN 27:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="GEN 27:29" />Nek služinen će o narodija</para>
  <para style="q2" vid="GEN 27:29">hem nek pokloninen pe će o plemija.</para>
  <para style="q1" vid="GEN 27:29">Vladin upro te phralja</para>
  <para style="q2" vid="GEN 27:29">hem nek pokloninen pe će o potomci te dajakere.</para>
  <para style="q1" vid="GEN 27:29">Prokleto nek ovel ko ka prokletini tut</para>
  <para style="q2" vid="GEN 27:29">hem blagoslovime nek ovel ko ka blagoslovini tut!”<verse eid="GEN 27:29" /></para>
  <para style="b" />
  <para style="p">
    <verse number="30" style="v" sid="GEN 27:30" />Samo so dželo o Jakov ple dadestar e Isaakestar palo adava so blagoslovinđa le, lesoro phral o Isav alo taro lov. <verse eid="GEN 27:30" /><verse number="31" style="v" sid="GEN 27:31" />Hem ov ćerđa šužo habe, anđa le ple dadese, pa phenđa lese: “Dade, ušti hem ha hari akala divljona životinja so dolinđum, te šaj te blagoslovine man.”<verse eid="GEN 27:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 27:32" />A lesoro dad o Isaak pučlja le: “Ko injan tu?”</para>
  <para style="p" vid="GEN 27:32">O Isav phenđa: “Me injum o Isav, to prvobijando čhavo.”<verse eid="GEN 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 27:33" />Ko adava o Isaak but darandilo hem phenđa: “Pa ko onda inele okova so dolinđa divljona životinja hem anđa la maje? Haljum adava angleder nego so tu aljan hem blagoslovinđum le, hem adalese adava blagoslov ka ačhol upro leste.”<verse eid="GEN 27:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 27:34" />Kad o Isav šunđa so phenđa lesoro dad, zorale hem ogorčime vičinđa, pa phenđa ple dadese: “Blagoslovin hem man, dade!”<verse eid="GEN 27:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 27:35" />A o Isaak phenđa: “To phral alo hem ki prevara lelja to blagoslov.”<verse eid="GEN 27:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 27:36" />Tegani o Isav phenđa: “Nane ni čudno soi lesoro anav Jakov. Već dujto puti prevarinđa man – lelja mandar o pravo ko prvorodstvo, a akana, ače, lelja mandar hem o blagoslov.”</para>
  <para style="p" vid="GEN 27:36">Onda pučlja: “Zar maje na ačhavđan nijekh blagoslov?”<verse eid="GEN 27:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 27:37" />O Isaak phenđa: “Ole čhivđum te ovel to gospodari hem dinđum sa lesere phraljen te oven lesere sluge. Dinđum le điv hem mol. Nane man ništa so šaj te ćerav tuće, mlo čhavo!”<verse eid="GEN 27:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 27:38" />Ko adava o Isav phenđa ple dadese: “Zar samo jekh blagoslov isi tut, dade? Blagoslovin hem man, dade mleja!”</para>
  <para style="p" vid="GEN 27:38">Pa zorale runđa.<verse eid="GEN 27:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="GEN 27:39" />Lesoro dad o Isaak phenđa lese:</para>
  <para style="b" vid="GEN 27:39" />
  <para style="q1" vid="GEN 27:39">“Dur oti plodno phuv ka ovel to čher,</para>
  <para style="q2" vid="GEN 27:39">dur oti rosa taro nebo.<verse eid="GEN 27:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="GEN 27:40" />Ka živine taro to mači</para>
  <para style="q2" vid="GEN 27:40">hem ka služine te phralese.</para>
  <para style="q1" vid="GEN 27:40">Ali, kad ka pobunine tut,</para>
  <para style="q2" vid="GEN 27:40">lesoro jaram ka frde te menjatar.”<verse eid="GEN 27:40" /></para>
  <para style="b" />
  <para style="p">
    <verse number="41" style="v" sid="GEN 27:41" />O Isav zamrzinđa e Jakove zbog o blagoslov saveja blagoslovinđa le lesoro dad, pa ana peste mislinđa: “Mlo dad pana hari ka merel. Tegani ka mudarav mle phrale.”<verse eid="GEN 27:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="GEN 27:42" />Kad phende e Revekaće so lakoro phureder čhavo o Isav mangela te ćerel, oj bičhalđa te vičinen lakere tiknedere čhave e Jakove hem phenđa lese: “To phral o Isav mangela te osvetini pe hem te mudari tut! <verse eid="GEN 27:42" /><verse number="43" style="v" sid="GEN 27:43" />Adalese šun man akana, mlo čhavo: naš ki sig koro mlo phral o Lavan ano Haran. <verse eid="GEN 27:43" /><verse number="44" style="v" sid="GEN 27:44" />Ačhov koro leste nekobor dive, đikote te phralestar na nakhela i holi. <verse eid="GEN 27:44" /><verse number="45" style="v" sid="GEN 27:45" />Kad ka nakhel lestar i holi hem kad ka bistrel so ćerđan lese, me ka javinav će te irine tut. Sose sodujen tumen te našalav ano jekh dive?”<verse eid="GEN 27:45" /></para>
  <para style="s">O Isaak bičhali e Jakove koro Lavan</para>
  <para style="p">
    <verse number="46" style="v" sid="GEN 27:46" />I Reveka phenđa e Isaakese: “Kalilo maje više akava dživdipe zbog e Isavesere romnja o Hetitkinje. Te hem o Jakov ka lel romnjaće nesava tari akaja phuv, Hetitkinja, so valjani maje onda esavko dživdipe!”<verse eid="GEN 27:46" /></para>
  <chapter eid="GEN 27" />
  <chapter number="28" style="c" sid="GEN 28" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 28:1" />Tegani o Isaak vičinđa e Jakove hem blagoslovinđa le, pa naredinđa lese: “Ma te le romnjaće Hanaanka! <verse eid="GEN 28:1" /><verse number="2" style="v" sid="GEN 28:2" />Sig dža ano Padan Aram, ano čher e Beteulesoro, te papusoro, hem adari arakh će romnja, jekha taro te ujkosere e Lavanesere čhaja. <verse eid="GEN 28:2" /><verse number="3" style="v" sid="GEN 28:3" />Nek o Devel, kova sa šaj, blagoslovini tut te ove plodno hem nek umnožini tut, tutar te ikljon but narodija. <verse eid="GEN 28:3" /><verse number="4" style="v" sid="GEN 28:4" />Nek tuće hem te potomkonenđe del e Avraamesoro blagoslov, te le ano nasledstvo i phuv ani savi akana živineja, i phuv savi o Devel dinđa e Avraamese.”<verse eid="GEN 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 28:5" />Tegani o Isaak bičhalđa e Jakove, hem ov dželo ano Padan Aram, koro Lavan, kovai čhavo e Beteulesoro e Aramejcosoro, a phral e Revekakoro kojai daj e Jakovese hem e Isavese.<verse eid="GEN 28:5" /></para>
  <para style="s">O Isav palem ženini pe</para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 28:6" />O Isav dodžanđa so o Isaak blagoslovinđa e Jakove hem so bičhalđa le ano Padan Aram te arakhi pese adari romnja hem so, blagoslovindoj, naredinđa lese: “Ma te le romnjaće Hanaanka!”, <verse eid="GEN 28:6" /><verse number="7" style="v" sid="GEN 28:7" />hem dodžanđa so o Jakov šunđa ple dade hem pla daja hem so dželo ano Padan Aram. <verse eid="GEN 28:7" /><verse number="8" style="v" sid="GEN 28:8" />Ađahar o Isav halilo da o Hanaanke nane pali volja lesere dadesiri e Isaakesiri, <verse eid="GEN 28:8" /><verse number="9" style="v" sid="GEN 28:9" />pa dželo koro Ismailo hem uzalo aver romnja save već inole, leljafse romnjaće e Mahalata. Oj inele čhaj e Avraamesere čhavesiri e Ismailosiri, a phen e Nevajotovesiri.<verse eid="GEN 28:9" /></para>
  <para style="s">E Jakovesoro suno ano Betel</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 28:10" />Kad o Jakov iklilo tari Beer Ševa, lelja te džal nakoro Haran <verse eid="GEN 28:10" /><verse number="11" style="v" sid="GEN 28:11" />hem alo nesar ko jekh than, ačhilo adari te nakhaj i rat, adalese so već ratilo. Lelja jekh bar oto adava than, čhivđa le uzalo plo šero pa pašlilo te sovel. <verse eid="GEN 28:11" /><verse number="12" style="v" sid="GEN 28:12" />Ano suno dikhlja sluba savi terđola ki phuv, a lakoro vrh inele đi ko nebo. I otojekhvar e Devlesere anđelja ukljena ine hem huljena upro late, <verse eid="GEN 28:12" /><verse number="13" style="v" sid="GEN 28:13" />a upro late, upre, terđola ine o GOSPOD. Ov phenđa: “Me injum o GOSPOD, o Devel te pradadesoro e Avraamesoro hem o Devel e Isaakesoro. Tuće hem te potomstvose ka dav akaja phuv ki savi pašljoveja. <verse eid="GEN 28:13" /><verse number="14" style="v" sid="GEN 28:14" />To potomstvo ka ovel baro sar o prah e phuvjakoro hem ka raširinen pe ko zapad hem ko istok, ko sever hem ko jug. Prekala tute hem prekalo to potomstvo ka oven blagoslovime sa o narodija ki phuv. <verse eid="GEN 28:14" /><verse number="15" style="v" sid="GEN 28:15" />Me injum tuja – ka pazinav tut kaj god te dža hem ka irinav tut ki akaja phuv. Naka ačhavav tut đikote na ispuninava adava so obećinđum će.”<verse eid="GEN 28:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 28:16" />Kad o Jakov uštino taro suno, phenđa: “Čačei o GOSPOD ko akava than, a me adava na džanđum!”<verse eid="GEN 28:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 28:17" />Darandilo hem phenđa: “Kobori strašno akava than! Akava nane ništa aver nego čher e Devlesoro! Akavai i kapija e nebosiri!”<verse eid="GEN 28:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 28:18" />O Jakov uštino sabale rano, lelja o bar savo inele uzalo lesoro šero, ispravinđa le sar stubo hem čhorđa ulje upro leste. <verse eid="GEN 28:18" /><verse number="19" style="v" sid="GEN 28:19" />Adava than vičinđa Betel.<note caller="+" style="f"><char style="fr" closed="false">28,19 </char><char style="fq" closed="false">Betel </char><char style="ft" closed="false">so značini: “čher e Devlesoro”.</char></note> Adaja diz angleder vičinđa pe Luz.<verse eid="GEN 28:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 28:20" />Tegani o Jakov halja pe sovli, vaćerindoj: “Te o Devel ka ovel mancar hem te arakhlja man ko akava mlo drom ko savo leljum te džav, te dinđa man maro te hav hem šeja te urjav, <verse eid="GEN 28:20" /><verse number="21" style="v" sid="GEN 28:21" />pa dživdo hem sasto te irinav man ko čher mle dadesoro, onda o GOSPOD ka ovel mlo Devel, <verse eid="GEN 28:21" /><verse number="22" style="v" sid="GEN 28:22" />a akava bar savo ispravinđum ka ovel sar znako zako e Devlesoro čher. A oto sa so ka de man, Devla, me tuće ka dav desetak.”<verse eid="GEN 28:22" /></para>
  <chapter eid="GEN 28" />
  <chapter number="29" style="c" sid="GEN 29" />
  <para style="s">O Jakov resela ano Haran</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 29:1" />Palo adava o Jakov radujindoj nastavinđa plo drom hem reslja ani phuv kaj živinena o istočna narodija. <verse eid="GEN 29:1" /><verse number="2" style="v" sid="GEN 29:2" />Otojekhvar ano polje dikhlja bunari uzalo saveste pašljona trin stadija bakre. Taro adava bunari o bakre pijena ine pani, a ko otvor e bunaresoro inele navalime baro bar. <verse eid="GEN 29:2" /><verse number="3" style="v" sid="GEN 29:3" />Kad bi čedela pe ine sa o stado, o pastirija bi cidena o bar oto otvor e bunaresoro hem bi dena pani e bakrenđe. Palo adava bi irinena o bar ko lesoro than, ko otvor e bunaresoro.<verse eid="GEN 29:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 29:4" />O Jakov pučlja len: “Kotar injen, phraljalen?”</para>
  <para style="p" vid="GEN 29:4">A on phende lese: “Oto Haran.”<verse eid="GEN 29:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 29:5" />O Jakov palem pučlja len: “Pendžarena li e Lavane, e Nahoresere unuko?”</para>
  <para style="p" vid="GEN 29:5">A on phende lese: “Oja, pendžaraja le.”<verse eid="GEN 29:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 29:6" />Tegani o Jakov palem pučlja len: “Sari ov?”</para>
  <para style="p" vid="GEN 29:6">A on phende lese: “Šukari. Ače lesiri čhaj i Rahilja avela ple stadoja.”<verse eid="GEN 29:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 29:7" />O Jakov phenđa: “Ače, panai dive. Nane o vreme i stoka te čedel pe zako odmor. Den pani e bakrenđe, pa irinen len te han čar.”<verse eid="GEN 29:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 29:8" />On phende lese: “Našti te ćera adava sa đikote sa o stado na čedela pe akate hem đikote na cidela pe o bar oto otvor e bunaresoro. Tek palo adava šaj te da pani e bakrenđe.”<verse eid="GEN 29:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 29:9" />Sar ov pana vaćeri ine olencar, i Rahilja ali ple dadesere bakrencar, adalese so oj arakhi ine e bakren. <verse eid="GEN 29:9" /><verse number="10" style="v" sid="GEN 29:10" />Kad o Jakov dikhlja e Rahilja, ple ujkosere e Lavanesere čhaja, hem e Lavanesere bakren, alo đi o bunari hem cidinđa o bar oto lesoro otvor, pa dinđa ple ujkosere bakren te pijen pani. <verse eid="GEN 29:10" /><verse number="11" style="v" sid="GEN 29:11" />Tegani o Jakov čumudinđa e Rahilja, pa glasoja runđa. <verse eid="GEN 29:11" /><verse number="12" style="v" sid="GEN 29:12" />Kad phenđa laće dai ov čhavo lakere dadesere phenjakoro e Revekakoro, i Rahilja prastandili te vaćeri adava ple dadese.<verse eid="GEN 29:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 29:13" />Kad o Lavan šunđa ple phenjakere čhavestar e Jakovestar, prastandilo nakoro leste, pa zagrlinđa le hem čumudinđa le, pa legarđa le pese ko čher.</para>
  <para style="p" vid="GEN 29:13">Kad o Jakov phenđa lese sa so ulo, <verse eid="GEN 29:13" /><verse number="14" style="v" sid="GEN 29:14" />o Lavan phenđa: “Tu čače injan mlo rat.”</para>
  <para style="s" vid="GEN 29:14">O Jakov ženini pe e Lijaja hem e Rahiljaja</para>
  <para style="p" vid="GEN 29:14">Palo adava so o Jakov ačhilo masek dive koro Lavan, <verse eid="GEN 29:14" /><verse number="15" style="v" sid="GEN 29:15" />o Lavan phenđa lese: “Zar ka ćere maje buti za džabe adalese so injan me phenjakoro čhavo? Vaćer maje kobor te platinav tut?”<verse eid="GEN 29:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 29:16" />A e Lavane ine duj čhaja. E phurederakoro anav inele Lija, a e tiknederakoro Rahilja. <verse eid="GEN 29:16" /><verse number="17" style="v" sid="GEN 29:17" />E Lija ine šuže jaćha, a e Rahilja ine šužo muj hem telo.<verse eid="GEN 29:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 29:18" />O Jakov zavolinđa e Rahilja, pa phenđa: “Ka ćerav buti tuće efta berš zaki ti tikneder čhaj i Rahilja.”<verse eid="GEN 29:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 29:19" />O Lavan phenđa: “Po šukari te dav la tuće nego averese. Ačhov kora mande.”<verse eid="GEN 29:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 29:20" />Ađahar o Jakov ćerđa buti zaki Rahilja efta berš, a sa adala berša olese ine sar nekobor dive, adalese so but volinđa la.<verse eid="GEN 29:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 29:21" />Tegani o Jakov phenđa e Lavanese: “De man mla romnja, te sovav olaja. Adalese so nakhino o vreme oti mli buti.”<verse eid="GEN 29:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 29:22" />O Lavan čedinđa sa e manušen oto adava than ko hajba hem ko piba. <verse eid="GEN 29:22" /><verse number="23" style="v" sid="GEN 29:23" />Ali, kad peli i rat, ov lelja pla čhaja e Lija hem legarđa la koro Jakov, pa o Jakov suća olaja. <verse eid="GEN 29:23" /><verse number="24" style="v" sid="GEN 29:24" />O Lavan pla ropkinja e Zilpa dinđa pla čhajaće e Lijaće te ovel lakiri sluškinja. <verse eid="GEN 29:24" /><verse number="25" style="v" sid="GEN 29:25" />Sabale kad dislilo, o Jakov dikhlja dai adava i Lija!</para>
  <para style="p" vid="GEN 29:25">O Jakov phenđa e Lavanese: “So ćerđan maje akava? Zar na ćerđum će buti zaki Rahilja? Sose prevarinđan man?”<verse eid="GEN 29:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 29:26" />O Lavan phenđa lese: “Akate amende nane o adeti i tikneder čhaj te del pe angleder i phureder. <verse eid="GEN 29:26" /><verse number="27" style="v" sid="GEN 29:27" />Završin akava kurko o bijav e Lijaja, pa ka da tut hem e Rahilja, a tu te ćere buti zako olaće pana efta berš.”<verse eid="GEN 29:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 29:28" />I o Jakov ćerđa ađahar. Kad adava kurko završinđa o bijav e Lijaja, o Lavan dinđa le pla čhaja e Rahilja romnjaće, <verse eid="GEN 29:28" /><verse number="29" style="v" sid="GEN 29:29" />a pla ropkinja e Bilha dinđa e Rahiljaće te ovel lakiri sluškinja. <verse eid="GEN 29:29" /><verse number="30" style="v" sid="GEN 29:30" />Ađahar o Jakov suće hem e Rahiljaja. Ola volinđa više nego e Lija, pa ćerđa buti koro Lavan pana efta berš.<verse eid="GEN 29:30" /></para>
  <para style="s">E Jakovesere čhave</para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 29:31" />O GOSPOD dikhlja da i Lija nane volime, pa dinđa la te bijani čhaven, dok i Rahilja inele nerotkinja.<verse eid="GEN 29:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 29:32" />I Lija ačhili khamni hem bijanđa čhave hem dinđa le anav Ruvim,<note caller="+" style="f"><char style="fr" closed="false">29,32 </char><char style="fq" closed="false">Ruvim </char><char style="ft" closed="false">so značini: “Dikh – čhavoi!” A zvučini hem sar “Dikhlja mle nevolje.”</char></note> adalese so phenđa: “O GOSPOD dikhlja mli nevolja hem akana mlo rom ka volini man.”<verse eid="GEN 29:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 29:33" />I Lija palem ačhili khamni hem bijanđa čhave, pa phenđa: “Adalese so o GOSPOD šunđa da na injum volime, dinđa man hem akale čhave.” Adalese dinđa le anav Simeon.<note caller="+" style="f"><char style="fr" closed="false">29,33 </char><char style="fq" closed="false">Simeon </char><char style="ft" closed="false">so zvučini sar: “Okova kova šunela.” </char></note><verse eid="GEN 29:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 29:34" />Tegani palem ačhili khamni hem bijanđa čhave, pa phenđa: “Akana mlo rom ka povezini pe mancar, adalese so bijanđum lese trine muršen.” Adalese dinđa le anav Levije.<note caller="+" style="f"><char style="fr" closed="false">29,34 </char><char style="fq" closed="false">Levije </char><char style="ft" closed="false">so zvučini sar: “povezime.” </char></note><verse eid="GEN 29:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 29:35" />Oj pana jekhvar ačhili khamni hem bijanđa čhave, pa phenđa: “Akava puti ka zahvalinav e GOSPODESE.” Adalese dinđa le anav Juda.<note caller="+" style="f"><char style="fr" closed="false">29,35 </char><char style="fq" closed="false">Juda </char><char style="ft" closed="false">so zvučini sar: “zahvaliba.” </char></note></para>
  <para style="p" vid="GEN 29:35">Palo adava, nesavo vreme na bijanđa.<verse eid="GEN 29:35" /></para>
  <chapter eid="GEN 29" />
  <chapter number="30" style="c" sid="GEN 30" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 30:1" />Kad i Rahilja dikhlja so našti te bijani čhaven e Jakovese, uli ljubomorno upri pli phen, pa phenđa e Jakovese: “De man čhaven, ili ka merav!”<verse eid="GEN 30:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 30:2" />A o Jakov holjanđa upri Rahilja hem phenđa: “Pa me li injum o Devel. Ovi adava kova na dinđa tut te bijane čhaven.”<verse eid="GEN 30:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 30:3" />Tegani oj phenđa: “Ače mli sluškinja i Bilha – sov olaja, te šaj oj te bijani maje hem prekalo late te dobinav čhaven.”<verse eid="GEN 30:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 30:4" />Ađahar i Rahilja dinđa pla sluškinja e Bilha e Jakovese te ovel lesiri romni. Ov suća e Bilhaja, <verse eid="GEN 30:4" /><verse number="5" style="v" sid="GEN 30:5" />pa i Bilha ačhili khamni hem bijanđa lese čhave.<verse eid="GEN 30:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 30:6" />Tegani i Rahilja phenđa: “O Devel presudinđa ani mli korist. Šunđa mli molitva hem dinđa man čhave.” Adalese dinđa le anav Dan.<note caller="+" style="f"><char style="fr" closed="false">30,6 </char><char style="fq" closed="false">Dan </char><char style="ft" closed="false">zvučini sar: “te presudini pe ani nekasiri korist.” </char></note><verse eid="GEN 30:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 30:7" />E Rahiljakiri sluškinja i Bilha palem ačhili khamni hem bijanđa e Jakovese dujtone čhave.<verse eid="GEN 30:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 30:8" />Tegani i Rahilja phenđa: “Bari inele mli borba mla phenjaja, ali pobedinđum.” Adalese dinđa le anav Neftalim.<note caller="+" style="f"><char style="fr" closed="false">30,8 </char><char style="fq" closed="false">Neftalim </char><char style="ft" closed="false">zvučini sar: “mli borba.” </char></note><verse eid="GEN 30:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 30:9" />Kad i Lija dikhlja so našti više te bijani, lelja pla sluškinja e Zilpa hem dinđa la e Jakovese te ovel lesiri romni. <verse eid="GEN 30:9" /><verse number="10" style="v" sid="GEN 30:10" />E Lijakiri sluškinja i Zilpa bijanđa e Jakovese čhave.<verse eid="GEN 30:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 30:11" />Tegani i Lija phenđa: “But bahtali injum!” Adalese dinđa le anav Gad.<note caller="+" style="f"><char style="fr" closed="false">30,11 </char><char style="fq" closed="false">Gad </char><char style="ft" closed="false">značini “bahtalipe.” </char></note><verse eid="GEN 30:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 30:12" />E Lijakiri sluškinja i Zilpa bijanđa e Jakovese hem dujtone čhave.<verse eid="GEN 30:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 30:13" />Tegani i Lija phenđa: “Čače injum bahtali! O đuvlja ka vičinen man bahtali.” Adalese dinđa le anav Asir.<note caller="+" style="f"><char style="fr" closed="false">30,13 </char><char style="fq" closed="false">Asir </char><char style="ft" closed="false">značini: “bahtalo.” </char></note><verse eid="GEN 30:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 30:14" />Jekhvar, ano vreme kad čedela pe o điv, o Ruvim dželo ano polje hem arakhlja mandragore<note caller="+" style="f"><char style="fr" closed="false">30,14 </char><char style="fq" closed="false">mandragore </char><char style="ft" closed="false">Ano adava vreme o manuša smatrinde da akaja biljka pomožinđa e đuvljenđe te oven plodna. </char></note>, pa anđa len pe dajaće e Lijaće.</para>
  <para style="p" vid="GEN 30:14">I Rahilja phenđa e Lijaće: “Molinava tut de man hari te čhavesere mandragore.”<verse eid="GEN 30:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 30:15" />A i Lija phenđa laće: “Hari li će so leljan mle rome, nego mangeja te le hem mle čhavesere mandragore?”</para>
  <para style="p" vid="GEN 30:15">I Rahilja phenđa: “Šukari. Nek sovel erat o Jakov tuja ani zamena zako te čhavesere mandragore.”<verse eid="GEN 30:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 30:16" />Kad o Jakov irinđa pe raćate taro polje, i Lija iklili anglo leste hem phenđa: “Ka sove mancar akaja rat, adalese so dobinđum tut ani zamena zako mandragore mle čhavesere.” Hem ađahar o Jakov adaja rat suća olaja.<verse eid="GEN 30:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 30:17" />O Devel uslišinđa e Lijakiri molitva, pa oj ačhili khamni hem bijanđa e Jakovese hem pandžtone čhave.<verse eid="GEN 30:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 30:18" />Tegani oj phenđa: “O Devel nagradinđa man so dinđum mla sluškinja mle romese.” Adalese dinđa le anav Isahar.<note caller="+" style="f"><char style="fr" closed="false">30,18 </char><char style="fq" closed="false">Isahar </char><char style="ft" closed="false">zvučini sar: “unajmime murš” hem “isi nagrada.” </char></note><verse eid="GEN 30:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 30:19" />I Lija palem ačhili khamni hem bijanđa e Jakovese šoftone čhave, <verse eid="GEN 30:19" /><verse number="20" style="v" sid="GEN 30:20" />pa phenđa: “O Devel dinđa man but šužo daro. Akana mlo rom ka poštujini man, adalese so bijanđum lese šoftone čhave.” Adalese dinđa le anav Zavulon.<note caller="+" style="f"><char style="fr" closed="false">30,20 </char><char style="fq" closed="false">Zavulon</char><char style="ft" closed="false">zvučini sar: “te poštujini pe” hem “daro.”</char></note><verse eid="GEN 30:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 30:21" />Palo adava i Lija bijanđa hem čhaja hem dinđa la anav Dina.<verse eid="GEN 30:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 30:22" />Tegani o Devel setinđa pe oti Rahilja, uslišinđa lakiri molitva hem ćerđa la te ovel plodno. <verse eid="GEN 30:22" /><verse number="23" style="v" sid="GEN 30:23" />Oj ačhili khamni hem bijanđa čhave, pa phenđa: “O Devel cidinđa mli lađ.” <verse eid="GEN 30:23" /><verse number="24" style="v" sid="GEN 30:24" />Dinđa le anav Josif, <note caller="+" style="f"><char style="fr" closed="false">30,24 </char><char style="fq" closed="false">Josif </char><char style="ft" closed="false">zvučini sar: “te dodel pe pana” hem “cidinđa.” </char></note> vaćerindoj: “Nek del man o GOSPOD pana jekhe čhave.”<verse eid="GEN 30:24" /></para>
  <para style="s">Sar o Jakov barvalilo</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 30:25" />Kad i Rahilja bijanđa e Josife, o Jakov phenđa e Lavanese: “Muk man te irinav man adari kaj bijandiljum. <verse eid="GEN 30:25" /><verse number="26" style="v" sid="GEN 30:26" />De man mle romnjen hem mle čhaven, kolenđe služinđum će, pa te džav. Adalese so, tu korkoro džane kobor ćerđum buti tuće.”<verse eid="GEN 30:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 30:27" />Ko adava o Lavan phenđa: “Te arakhljum milost angla tute, molinava tut ma dža! Prekalo dikhljariba dodžanđum da o GOSPOD zbog tute blagoslovinđa man.” <verse eid="GEN 30:27" /><verse number="28" style="v" sid="GEN 30:28" />Hem pana phenđa: “Odredin i plata savi rodeja mandar, pa me ka dav tut.”<verse eid="GEN 30:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 30:29" />O Jakov phenđa: “Džane sar služinđum će hem kobor ti stoka barili adalese so me brininđum olatar. <verse eid="GEN 30:29" /><verse number="30" style="v" sid="GEN 30:30" />Okova hari so ine tut angleder me so aljum akana but barilo hem o GOSPOD blagoslovinđa tut prekalo sa so ćerđum. Zar nane o vreme te ćerav buti hem zako mlo čher?”<verse eid="GEN 30:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 30:31" />O Lavan pučlja: “So te dav tut?”</para>
  <para style="p" vid="GEN 30:31">O Jakov phenđa: “Ma de man ništa. Samo ćer maje akava, pa ka ačhovav te dav te stokaće čar te hal hem ka arakhav len: <verse eid="GEN 30:31" /><verse number="32" style="v" sid="GEN 30:32" />Muk man avdive te nakhav maškaro sa to stado hem te izdvojinav svakona pegavona hem šarima bakrija hem svakone kale bakrore, hem svakona šarima hem pegavona buznja. Adava ka ovel mli plata. <verse eid="GEN 30:32" /><verse number="33" style="v" sid="GEN 30:33" />Od akana mlo poštenje ka svedočini zako maje kad god ka proverine mli plata: te ano mlo stado aračhola nesavi buzni savi nane šarime ili pegavo, ili bakroro savo nane kalo, nek smatrini pe dai čorde.”<verse eid="GEN 30:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 30:34" />O Lavan phenđa: “Šukari. Nek ovel sar so pheneja.” <verse eid="GEN 30:34" /><verse number="35" style="v" sid="GEN 30:35" />Ko adava isto dive o Lavan izdvojinđa sa e jarconen saven ine pruge ili šare hem svakona pegavona hem šarima buznja – sa adalen saven ine hari parno upra peste – hem svakone kale bakrore, pa dinđa len ple čhavenđe. <verse eid="GEN 30:35" /><verse number="36" style="v" sid="GEN 30:36" />Tegani e stadoja phirindoj dželo trin dive dur oto Jakov. A o Jakov ačhilo te arakhi o ostatak oto stado e Lavanesoro.<verse eid="GEN 30:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 30:37" />O Jakov lelja sveža granke taro kašta topola, badem hem platan, pa ano lende urezinđa parne pruge ađahar so randlja i kora sar te dičhol o parno kaš oti granka. <verse eid="GEN 30:37" /><verse number="38" style="v" sid="GEN 30:38" />O randle granke čhivđa ano kopane, te oven anglo stado kad ka avel te pijel. O stado avela ine te pijel hem adathe parini pe ine. <verse eid="GEN 30:38" /><verse number="39" style="v" sid="GEN 30:39" />A adalese so o stado parini pe ine anglo granke, bijandile prugasta, pegava ili šarime terne životinje.<verse eid="GEN 30:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="GEN 30:40" />O Jakov e terne životinjen odvojinđa, a averen irinđa ađahar te dikhen ano prugasta hem ano kale životinje save inele e Lavanesere. Ađahar o Jakov pese dobinđa odvojime stado hem na mešinđa le e Lavanesere stadoja. <verse eid="GEN 30:40" /><verse number="41" style="v" sid="GEN 30:41" />Kad bi o po zorale životinje oto stado parinena pe, o Jakov čhivela ine o granke ano kopane anglo životinje, sar te šaj o životinje te parinen pe anglo granke. <verse eid="GEN 30:41" /><verse number="42" style="v" sid="GEN 30:42" />A anglo bizorale životinje o Jakov na čhivela ine o granke. Ađahar o bizorale životinje pripadinde e Lavanese, a o zorale e Jakovese. <verse eid="GEN 30:42" /><verse number="43" style="v" sid="GEN 30:43" />Ađahar o Jakov zorale barvalilo, stekninđa bute sitnona stoka, sluškinjen hem slugen, kamilen hem heren.<verse eid="GEN 30:43" /></para>
  <chapter eid="GEN 30" />
  <chapter number="31" style="c" sid="GEN 31" />
  <para style="s">O Jakov našela taro Lavan</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 31:1" />O Jakov šunđa sar e Lavanesere čhave phenena: “O Jakov lelja sa o barvalipe so inele amare dade hem sa akava barvalipe stekninđa ko računi adalestar so pripadinđa amare dadese.”<verse eid="GEN 31:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 31:2" />A hem o Jakov dikhlja da o Lavan nane više oleja sar so inele angleder.<verse eid="GEN 31:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 31:3" />Tegani o GOSPOD phenđa e Jakovese: “Irin tut ani phuv te pradadengiri, kori ti familija. Me ka ovav tuja.”<verse eid="GEN 31:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 31:4" />O Jakov vičinđa e Rahilja hem i Lija te aven ano polje kaj inele lesoro stado, <verse eid="GEN 31:4" /><verse number="5" style="v" sid="GEN 31:5" />pa phenđa: “Dikhava da tumaro dad nane više premala mande sar so inele angleder. Ali o Devel mle dadesoro inele mancar. <verse eid="GEN 31:5" /><verse number="6" style="v" sid="GEN 31:6" />Tumen džanen da me tumare dadese ćerđum buti sa mle zoralipnaja, <verse eid="GEN 31:6" /><verse number="7" style="v" sid="GEN 31:7" />a ov ipak prevarinđa man – deš puti menjinđa mli plata. Ali o Devel na muklja lese te ćerel maje šteta. <verse eid="GEN 31:7" /><verse number="8" style="v" sid="GEN 31:8" />Kad god o Lavan phenđa: ‘O pegava ka oven ti plata’, ano sa o stado bijandile pegava terne životinje. A kad god phenđa: ‘O prugasta ka oven ti plata’, ano sa o stado bijandile prugasta terne životinje. <verse eid="GEN 31:8" /><verse number="9" style="v" sid="GEN 31:9" />Ađahar o Devel lelja e stoka tumare dadestar hem dinđa la maje.<verse eid="GEN 31:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 31:10" />Jekhvar, kad parinđa pe o stado, ano suno dikhljum sar o jarci save parinde pe e buznjencar inele prugasta, pegava hem šarime. <verse eid="GEN 31:10" /><verse number="11" style="v" sid="GEN 31:11" />O anđeo e Devlesoro ano suno phenđa maje: ‘Jakove.’ A me phenđum: ‘Akate injum.’ <verse eid="GEN 31:11" /><verse number="12" style="v" sid="GEN 31:12" />O anđeo phenđa: ‘Vazde to šero hem dikh so sa o jarci save parinena pe e buznjencar prugasta, pegava hem šarime. Adalese so, dikhljum so o Lavan ćerela će. <verse eid="GEN 31:12" /><verse number="13" style="v" sid="GEN 31:13" />Me injum o Devel kova mothovđa pe će ano Betel, kote uljeja pomazinđan o stubo oto bar hem kote haljan tut maje sovli. A akana spremin tut, pa dža tari akaja phuv hem irin tut ki ti familija.’ ”<verse eid="GEN 31:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 31:14" />I Rahilja hem i Lija phende lese: “Zar amen isi pana nesavo deo oto nasledstvo ano čher amare dadesoro? <verse eid="GEN 31:14" /><verse number="15" style="v" sid="GEN 31:15" />Zar ov na dikhela amen sar abanđijen? Na samo so bikninđa amen, nego sa o pare save lelja zako amenđe trošinđa. <verse eid="GEN 31:15" /><verse number="16" style="v" sid="GEN 31:16" />Sa o barvalipe savo o Devel lelja amare dadestar pripadini amenđe hem amare čhavenđe. Adalese ćer sa sar so phenđa će o Devel.”<verse eid="GEN 31:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 31:17" />Tegani o Jakov čhivđa ple čhaven hem ple romnjen upro kamile, <verse eid="GEN 31:17" /><verse number="18" style="v" sid="GEN 31:18" />hem lelja peja sa pla stoka hem sa o barvalipe so stekninđa ano Padan Aram, pa lelja te džal ano Hanaan koro plo dad o Isaak.<verse eid="GEN 31:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 31:19" />Kad o Lavan dželo te muraj e bakren, i Rahilja čorđa e idolen taro lesoro čher. <verse eid="GEN 31:19" /><verse number="20" style="v" sid="GEN 31:20" />A o Jakov prevarinđa e Lavane e Aramejco, ađahar so na phenđa lese da ka džal olestar. <verse eid="GEN 31:20" /><verse number="21" style="v" sid="GEN 31:21" />Ađahar naštino sa okoleja so inole. Kad nakhino prekali len Eufrat, lelja te džal nakoro bregalo krajo Gilad.<verse eid="GEN 31:21" /></para>
  <para style="s">O Lavan jurini e Jakove</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 31:22" />O trito dive e Lavanese javinde da o Jakov naštino. <verse eid="GEN 31:22" /><verse number="23" style="v" sid="GEN 31:23" />O Lavan legarđa peja muršen oti pli familija, pa efta dive jurinđa e Jakove angleder nego so te resel le ko bregalo krajo Gilad.<verse eid="GEN 31:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 31:24" />Tegani o Devel alo e Lavanese e Aramejcose raćate ano suno, pa phenđa lese: “Pazin kad ka rese e Jakove te na phene lese ništa, ni šukar ni bišukar!”<verse eid="GEN 31:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 31:25" />Kad o Lavan reslja le, o Jakov već vazdinđa plo šatori ano bregalo krajo Gilad, pa o Lavan hem o murša oti lesiri familija vazdinde pumaro šatori adari.<verse eid="GEN 31:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 31:26" />O Lavan phenđa e Jakovese: “So ćerđan adava? Prevarinđan man hem legarđan mle čhajen sar te phene dai zarobljenice ano mariba. <verse eid="GEN 31:26" /><verse number="27" style="v" sid="GEN 31:27" />Sose našljan garandoj hem prevarinđan man? Sose na phenđan maje da mangeja te dža pa me ka ispratinav tut ine ano veselje hem điljencar, e dairencar hem e harfencar. <verse eid="GEN 31:27" /><verse number="28" style="v" sid="GEN 31:28" />Na dinđan man te čumudinav mle unukonen hem mle čhajen. Nane šukar ađahar so ćerđan. <verse eid="GEN 31:28" /><verse number="29" style="v" sid="GEN 31:29" />Šaj ine te ćerav tumenđe bišukaripe, ali o Devel tumare dadesoro prekali rat phenđa maje: ‘Pazin kad ka rese e Jakove te na phene lese ništa, ni šukar ni bišukar.’ <verse eid="GEN 31:29" /><verse number="30" style="v" sid="GEN 31:30" />Džanav da dželjan adalese so but mangeja te irine tu koro to dad. Ali sose čorđan mle devlen?”<verse eid="GEN 31:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 31:31" />O Jakov phenđa e Lavanese: “Darandiljum da ki sila ka le mandar te čhajen. <verse eid="GEN 31:31" /><verse number="32" style="v" sid="GEN 31:32" />Kora kaste ka arakhe te devlen, adava manuš naka ovel dživdo. Korkoro akate dikh angli amari familija da li isi nešto klo soi kora mande, a te isi, onda le.”</para>
  <para style="p" vid="GEN 31:32">A o Jakov na džanđa da i Rahilja čorđa len.<verse eid="GEN 31:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 31:33" />O Lavan đerdinđa e Jakovese ano šatori, e Lijaće ano šatori hem ano šatori e duje sluškinjengoro, ali na arakhlja e idolen. Kad iklilo taro e Lijakoro šatori, đerdinđa ano šatori e Rahiljakoro. <verse eid="GEN 31:33" /><verse number="34" style="v" sid="GEN 31:34" />A kad i Rahilja čorđa e idolen, čhivđa len ano sedlo e kamilakoro pa bešlja upro lende. O Lavan rodinđa ano celo šatori, ali ništa na arakhlja.<verse eid="GEN 31:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 31:35" />I Rahilja phenđa ple dadese: “Ma holjan upra mande, gospodarona, so našti te uštav angla tute, adalese so alo upro mande.”</para>
  <para style="p" vid="GEN 31:35">Ađahar o Lavan rodinđa, ali našti ine te arakhi ple idolen.<verse eid="GEN 31:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 31:36" />Tegani o Jakov holjanđa hem lelja te ukorini e Lavane:</para>
  <para style="p" vid="GEN 31:36">“Savo adava zločin me ćerđum? Savo adava greh me ćerđum pa tu man ađahar progonineja? <verse eid="GEN 31:36" /><verse number="37" style="v" sid="GEN 31:37" />Ače, akana kad preirinđan sa mle stvarija, so arakhljan so pripadini te čherese? Čhiv adava angli kli hem mli familija, pe on nek presudinen maškaro amende dujende.<verse eid="GEN 31:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 31:38" />Za akala biš berš kobor injumle kora tute, na aračhili nijekh oto kle bakrija hem oto kle buznja koja na bijanđa, niti haljum bakren taro to stado. <verse eid="GEN 31:38" /><verse number="39" style="v" sid="GEN 31:39" />Na anđum će životinja savi inele hali oto divlja zverija, nego me korkoro sa nadoknadinđum o našaldo. Tu mandar rodinđan te platinav će zako sa so inele čordo bilo diveste ili raćate. <verse eid="GEN 31:39" /><verse number="40" style="v" sid="GEN 31:40" />Ače sar inele maje: diveja mudari man o tatipe, a raćate o šil, pa o sojba našti ine te prelel man. <verse eid="GEN 31:40" /><verse number="41" style="v" sid="GEN 31:41" />I ađahar sa akala biš berš inele maje kora tute. Dešu štar berš ćerđum buti zako te duj čhaja hem šov berš zako stado, a mli plata menjinđan deš puti. <verse eid="GEN 31:41" /><verse number="42" style="v" sid="GEN 31:42" />Te na ovel ine mancar o Devel mle dadesoro, o Devel e Avraamesoro hem o Devel angla kaste o Isaak darala ine, tu sigurno ka muke man ine čuče vastencar. Ali o Devel dikhlja mli muka hem mlo trud savo dinđum, hem prekali rat presudinđa će ani mli korist.”<verse eid="GEN 31:42" /></para>
  <para style="s">O Jakov hem o Lavan phandena savez</para>
  <para style="p">
    <verse number="43" style="v" sid="GEN 31:43" />O Lavan phenđa e Jakovese: “Akalai đuvlja mle čhaja, akalai čhavore mle čhavore hem akavai stado mlo stado. Sa so dikheja, sai mlo. A palem, so bi me avdive šaj te ćerav mle čhajenđe ili e čhavorenđe kolen on bijande? <verse eid="GEN 31:43" /><verse number="44" style="v" sid="GEN 31:44" />Adalese, ana akana te phanda savez, tu hem me, pa adava te ovel sar svedoko maškara mande hem tute.”<verse eid="GEN 31:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="GEN 31:45" />Tegani o Jakov lelja jekh bar hem ispravinđa le sar stubo, <verse eid="GEN 31:45" /><verse number="46" style="v" sid="GEN 31:46" />pa phenđa pla familijaće: “Čeden bara.”</para>
  <para style="p" vid="GEN 31:46">Hem on lelje te čeden bara ki kupa, pa uzali adaja kupa hale. <verse eid="GEN 31:46" /><verse number="47" style="v" sid="GEN 31:47" />O Lavan adaja kupa vičinđa Jegar Sahaduta,<note caller="+" style="f"><char style="fr" closed="false">31,47 </char><char style="fq" closed="false">Jegar Sahaduta </char><char style="ft" closed="false">so ko aramejski značini: “svedoko – bara ki kupa”.</char></note> a o Jakov vičinđa la Galed.<note caller="+" style="f"><char style="fr" closed="false">31,47 </char><char style="fq" closed="false">Galed </char><char style="ft" closed="false">so ko jevrejski značini: “svedoko – bara ki kupa”.</char></note><verse eid="GEN 31:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="GEN 31:48" />O Lavan phenđa: “Akajai kupa oto bara avdive sar svedoko maškara tute hem mande.”</para>
  <para style="p" vid="GEN 31:48">Adalesei vičime Galed.<verse eid="GEN 31:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="GEN 31:49" />A istoi vičime hem Micpa,<note caller="+" style="f"><char style="fr" closed="false">31,49 </char><char style="fq" closed="false">Micpa </char><char style="ft" closed="false">so značini: “kula e stražarengiri.” </char></note> adalese so o Lavan phenđa: “Nek o GOSPOD stražarini upra mande hem upra tute kad ka ova dur jekh averestar. <verse eid="GEN 31:49" /><verse number="50" style="v" sid="GEN 31:50" />Te injanle bišukar premalo mle čhaja, ili te uzalo lende leljan će avere romnjen, čak hem me te na džanav adalese, nek ovel tut ki godi dai o Devel svedoko maškara tute hem mande.”<verse eid="GEN 31:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="GEN 31:51" />O Lavan pana phenđa e Jakovese: “Ače akaja kupa hem ače akava stubo oto bar savo čhivđum maškar amende. <verse eid="GEN 31:51" /><verse number="52" style="v" sid="GEN 31:52" />Akajai kupa svedoko hem akavai stubo svedoko da me naka nakhav prekali akaja kupa ki ti strana te ćerav će bišukaripe, hem da tu naka nakhe prekali akaja kupa hem prekalo akava stubo ki mli strana te ćere maje bišukaripe. <verse eid="GEN 31:52" /><verse number="53" style="v" sid="GEN 31:53" />Nek o Devel e Avraamesoro hem o develja e Nahoresere, o develja lengere dadesoro, presudinena maškar amende.”</para>
  <para style="p" vid="GEN 31:53">O Jakov halja pe sovli e Devleja angla kaste lesoro dad o Isaak darala ine, <verse eid="GEN 31:53" /><verse number="54" style="v" sid="GEN 31:54" />pa adari, ano bregalo krajo, prinosinde žrtva hem vičinđa sa ple familija te han. Kad hale, adari nakhavde hem i rat.<verse eid="GEN 31:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="GEN 31:55" />Rano sabale o Lavan uštino, čumudinđa ple unukonen hem ple čhajen hem blagoslovinđa len, pa irinđa pe čhere.<verse eid="GEN 31:55" /></para>
  <chapter eid="GEN 31" />
  <chapter number="32" style="c" sid="GEN 32" />
  <para style="s">O Jakov avela koro Isav</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 32:1" />O Jakov lelja te džal ple dromeja, a odrumal resle le o anđelja e Devlesere.<verse eid="GEN 32:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 32:2" />Kad dikhlja len, phenđa: “Akavai e Devlesoro tabor.” Adalese adava than vičinđa Mahanajim.<note caller="+" style="f"><char style="fr" closed="false">32,2 </char><char style="fq" closed="false">Mahanajim </char><char style="ft" closed="false">so značini: “duj taborija.”</char></note><verse eid="GEN 32:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 32:3" />O Jakov angla peste bičhalđa glasnikonen ple phralese e Isavese ani regija Seir, ani phuv Edom, <verse eid="GEN 32:3" /><verse number="4" style="v" sid="GEN 32:4" />hem naredinđa lenđe: “Ađahar vaćeren mle gospodarese e Isavese: ‘To sluga o Jakov phenela: Sa akava vreme injum le koro Lavan hem zadržinđum man adari. <verse eid="GEN 32:4" /><verse number="5" style="v" sid="GEN 32:5" />Stekninđum guruven hem heren, sitnona stoka, slugen hem sluškinjen. Bičhalava će e glasnikonen te javinen će, gospodarona, ani nada da ka arakhav milost angla tute.’ ”<verse eid="GEN 32:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 32:6" />Kad o glasnici irinde pe koro Jakov, phende lese: “Injamle koro to phral o Isav, hem ov akana avela nakora tute, a oleja avena štaršel manuša.”<verse eid="GEN 32:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 32:7" />O Jakov mulo oti dar, pa e manušen kola inele oleja, e sitnona stoka, e guruven hem e kamilen podelinđa ko duj taborija. <verse eid="GEN 32:7" /><verse number="8" style="v" sid="GEN 32:8" />Mislinđa: “Te o Isav avela đi ko jekh tabor hem napadini le, o dujto tabor ka šaj te našel.”<verse eid="GEN 32:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 32:9" />Tegani o Jakov molinđa pe: “Devla, tu kova injan Devel mle pradadesoro e Avraamesoro, tu kova injan Devel mle dadesoro e Isaakesoro, GOSPODE, tu kova phenđan maje: ‘Irin tut ani ti phuv hem kori ti familija, a me ka ćerav te ovel će šukar,’ <verse eid="GEN 32:9" /><verse number="10" style="v" sid="GEN 32:10" />na injum dostojno zako sa o mangipe hem zaki sa i vernost savo mothovđan premala mande, premalo to sluga. Samo štapi ine man kad nakhljum prekali len Jordan, a akana mandar ule duj taborija. <verse eid="GEN 32:10" /><verse number="11" style="v" sid="GEN 32:11" />Molinava tut, izbavin man taro vasta mle phralesere e Isavesere, adalese so darava da ka avel hem ka mudari sarijen amen, čak hem e dajen hem e čhaven. <verse eid="GEN 32:11" /><verse number="12" style="v" sid="GEN 32:12" />A tu phenđan: ‘Čače ka ćerav te ovel će šukar hem te oven tut potomci kobor i pošik e moresiri, savi našti dženel pe.’ ”<verse eid="GEN 32:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 32:13" />O Jakov adari nakhavđa i rat, pa okova ki sig so dolinđa ple vastencar spreminđa sar daro ple phralese e Isavese: <verse eid="GEN 32:13" /><verse number="14" style="v" sid="GEN 32:14" />dušel buznjen, biš jarconen, dušel bakren hem biš ovnonen, <verse eid="GEN 32:14" /><verse number="15" style="v" sid="GEN 32:15" />trijanda đuvljane kamilen hem lengere ternen, saranda guruvnjen hem deš guruven, biš hernjen hem deš heren.<verse eid="GEN 32:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 32:16" />Tegani dinđa len ple slugenđe, svako stado posebno, pa phenđa lenđe: “Tumen džan angla mande, ali muken than maškaro svako stado.”<verse eid="GEN 32:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 32:17" />A ple slugase kova inele prvo naredinđa: “Kad ka resel tut mlo phral o Isav hem kad ka pučel tut: ‘Kasoro tu injan hem kaj džaja? Kaserei akala životinje angla tute?’, <verse eid="GEN 32:17" /><verse number="18" style="v" sid="GEN 32:18" />tu phen lese: ‘Akalai životinje te slugasere e Jakovesere. Akavai o daro savo bičhali mle gospodarese e Isavese. A ov, ače, avela pala amende.’ ”<verse eid="GEN 32:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 32:19" />Tegani naredinđa e dujtonese hem e tritonese hem sa averenđe kola inele zadužime zako stado: “Hem tumen isto adava vaćeren e Isavese kad ka resen le. <verse eid="GEN 32:19" /><verse number="20" style="v" sid="GEN 32:20" />Vaćeren lese hem akava: ‘Ače, to sluga o Jakov avela pala amende.’ ”</para>
  <para style="p" vid="GEN 32:20">Adalese so, o Jakov mislinđa: “Ka smirinav le akale daroja savo bičhalava angla mande, pa posle kad ka resa amen, šaj ka primini man šukar.”<verse eid="GEN 32:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 32:21" />Ađahar e Jakovesoro daro dželo anglo leste, a ov adaja rat ačhilo ano tabor.<verse eid="GEN 32:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 32:22" />Adaja isto rat o Jakov uštino, lelja ple soduje romnjen, ple soduje sluškinjen hem sa ple dešujekhe čhaven hem phirindoj nakhino prekalo potok Jabok. <verse eid="GEN 32:22" /><verse number="23" style="v" sid="GEN 32:23" />A kad bičhalđa len prekalo potok, bičhalđa prekal hem sa plo barvalipe.<verse eid="GEN 32:23" /></para>
  <para style="s">O Jakov borini pe e Devleja</para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 32:24" />Ađahar o Jakov ačhilo korkoro, i tegani nesavo manuš borinđa pe oleja sa dok na dislilo. <verse eid="GEN 32:24" /><verse number="25" style="v" sid="GEN 32:25" />Kad okova manuš dikhlja da našti te pobedini le, khuvđa e Jakove ko kuko, pa e Jakovesoro kuko iščašinđa pe dok borinđa pe oleja.<verse eid="GEN 32:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 32:26" />Tegani okova manuš phenđa lese: “Muk man, adalese so već disljola.”</para>
  <para style="p" vid="GEN 32:26">Ali o Jakov phenđa lese: “Naka mukav tut đikote na blagoslovineja man.”<verse eid="GEN 32:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 32:27" />Okova manuš pučlja le: “Sari to anav?”</para>
  <para style="p" vid="GEN 32:27">A ov phenđa lese: “Jakov.”<verse eid="GEN 32:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 32:28" />Okova manuš phenđa lese: “Naka ovel to anav više Jakov, nego Izrael,<note caller="+" style="f"><char style="fr" closed="false">32,28 </char><char style="fq" closed="false">Izrael </char><char style="ft" closed="false">so značini: “ov borini pe e Devleja” ili “o Devel borini pe.”</char></note> adalese so borinđan tut e Devleja hem e manušencar, hem pobedinđan.”<verse eid="GEN 32:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 32:29" />Tegani o Jakov phenđa: “Molinava tut, vaćer maje to anav.”</para>
  <para style="p" vid="GEN 32:29">A okova manuš phenđa lese: “Sose pučeja zako mlo anav?”</para>
  <para style="p" vid="GEN 32:29">Tegani blagoslovinđa e Jakove adari.<verse eid="GEN 32:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 32:30" />O Jakov adava than vičinđa Peniel,<note caller="+" style="f"><char style="fr" closed="false">32,30 </char><char style="fq" closed="false">Peniel </char><char style="ft" closed="false">so značini: “o muj e Devlesoro.”</char></note> vaćerindoj: “Adalese so dikhljum e Devle muj mujeja, a ačhiljum dživdo.” <verse eid="GEN 32:30" /><verse number="31" style="v" sid="GEN 32:31" />Sar nakhela ine maškaro Peniel, o kham iklilo upreder oleste. A zbog plo kuko phirđa bange. <verse eid="GEN 32:31" /><verse number="32" style="v" sid="GEN 32:32" />Adalese o Izraelci đi o avdisutno dive na hana o mas oto mišići savo povezini o zglob oto kuko, adalese so o Jakov inele khuvdo ko adava than.<verse eid="GEN 32:32" /></para>
  <chapter eid="GEN 32" />
  <chapter number="33" style="c" sid="GEN 33" />
  <para style="s">O Jakov resela pe e Isaveja</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 33:1" />O Jakov vazdinđa plo šero hem dikhlja e Isave sar avela štar šele manušencar, pa podelinđa e čhavoren maškari Lija, i Rahilja hem o duj sluškinje. <verse eid="GEN 33:1" /><verse number="2" style="v" sid="GEN 33:2" />Anglal čhivđa e sluškinjen hem lengere čhaven, palo lende e Lija hem lakere čhaven, a e Rahilja hem e Josife palal. <verse eid="GEN 33:2" /><verse number="3" style="v" sid="GEN 33:3" />Ov korkoro dželo anglo lende hem efta puti pokloninđa pe mujeja đi phuv sar avela ine paše nakoro plo phral.<verse eid="GEN 33:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 33:4" />O Isav prastandilo nakoro leste hem zagrlinđa le, čhivđa ple vasta upro leste hem čumudinđa le, pa soduj džene runde.<verse eid="GEN 33:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 33:5" />Tegani o Isav vazdinđa plo šero hem dikhlja e romnjen hem e čhaven, pa pučlja: “Kolai akala tuja?”</para>
  <para style="p" vid="GEN 33:5">O Jakov phenđa: “O čhave kolen o Devel milosrdno dinđa maje, te slugase.”<verse eid="GEN 33:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 33:6" />Tegani o sluškinje hem lengere čhave ale po paše hem pokloninde pe. <verse eid="GEN 33:6" /><verse number="7" style="v" sid="GEN 33:7" />Palo lende ale paše hem i Lija hem lakere čhave hem pokloninde pe, a ko kraj ale paše hem i Rahilja hem o Josif, pa hem on pokloninde pe.<verse eid="GEN 33:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 33:8" />O Isav pučlja: “A savoi razlog so bičhalđan kora mande okova stado?”</para>
  <para style="p" vid="GEN 33:8">O Jakov phenđa: “Te arakhav milost angla tute, gospodarona.”<verse eid="GEN 33:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 33:9" />Ali o Isav phenđa: “Man već isi but, phrala. Ačhav tuće adava soi klo.”<verse eid="GEN 33:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 33:10" />O Jakov phenđa: “Na, molinava tut. Te arakhljum milost angla tute, primin adava daro mandar. Adalese so, kad dikhljum to muj ka phene da dikhljum o muj e Devlesoro, akana kad milosrdno priminđan man. <verse eid="GEN 33:10" /><verse number="11" style="v" sid="GEN 33:11" />Prihvatin o blagoslov savo anđum će, adalese soi o Devel milosrdno premala mande, pa isi man hem buderi.”</para>
  <para style="p" vid="GEN 33:11">I adalese so o Jakov edobor nagovorinđa le, o Isav prihvatinđa o daro.<verse eid="GEN 33:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 33:12" />Tegani o Isav phenđa: “Hajde amen akana te dža ko drom zajedno.”<verse eid="GEN 33:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 33:13" />Ali o Jakov phenđa lese: “Tu gospodarona, džane dai o čhavore bizorale, a valjani te pazinav upro bakre hem o guruvnja save dena thud ple tikoren. Te terinđum len te džan po sig samo jekh dive, sa ka meren. <verse eid="GEN 33:13" /><verse number="14" style="v" sid="GEN 33:14" />Adalese tu, gospodarona, dža angla mande, anglo to sluga, a me ka avav pohari, korako palo korako e stokaja hem e čhavorencar, đikote na resava kora tute, gospodarona, ano Seir.”<verse eid="GEN 33:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 33:15" />O Isav phenđa: “Ana barem te ačhavav tuja nekobor mle manušen.”</para>
  <para style="p" vid="GEN 33:15">O Jakov phenđa: “Šukari adava tutar, gospodarona, ali na valjani.”<verse eid="GEN 33:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 33:16" />Ađahar o Isav ko adava isto dive irinđa pe palal nakoro Seir. <verse eid="GEN 33:16" /><verse number="17" style="v" sid="GEN 33:17" />Ali o Jakov dželo ano Sukot hem adari pese vazdinđa čher, a zaki stoka štale. Adalese hem adava than vičini pe Sukot.<note caller="+" style="f"><char style="fr" closed="false">33,17 </char><char style="fq" closed="false">Sukot </char><char style="ft" closed="false">so značini: “štale.”</char></note><verse eid="GEN 33:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 33:18" />Putujindoj taro Padan Aram, o Jakov šukar alo đi i diz Sihem ano Hanaan hem lelja te živini angli diz. <verse eid="GEN 33:18" /><verse number="19" style="v" sid="GEN 33:19" />I phuv upri savi vazdinđa plo šatori činđa taro čhave e Hamoresere zako šel srebrnjaci. (O Hamor inele dad e Sihemesoro.) <verse eid="GEN 33:19" /><verse number="20" style="v" sid="GEN 33:20" />Adari o Jakov vazdinđa žrtveniko hem vičinđa le El Elohe Izrael.<note caller="+" style="f"><char style="fr" closed="false">33,20 </char><char style="fq" closed="false">El Elohe Izrael </char><char style="ft" closed="false">so značini: “o Eli o Devel e Izraelesoro” ili “zoraloi o Devel e Izraelesoro.”</char></note><verse eid="GEN 33:20" /></para>
  <chapter eid="GEN 33" />
  <chapter number="34" style="c" sid="GEN 34" />
  <para style="s">I Dina silujime</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 34:1" />Jekh dive, i Dina, i čhaj kola i Lija bijanđa e Jakovese, iklili te dikhel e đuvljen taro adava krajo. <verse eid="GEN 34:1" /><verse number="2" style="v" sid="GEN 34:2" />Kad dikhlja la o Sihem, dolinđa la hem silujinđa la. Lesoro dad o Hamor o Hivijco inele vladari adala phuvjakoro. <verse eid="GEN 34:2" /><verse number="3" style="v" sid="GEN 34:3" />Ali o Sihem but zavolinđa e Dina, e Jakovesere čhaja, hem zaljubinđa pe ano late. Adalese trudinđa pe te zadobini lakoro vilo.<verse eid="GEN 34:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 34:4" />O Sihem phenđa ple dadese e Hamorese: “Le maje akala čhaja romnjaće.”<verse eid="GEN 34:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 34:5" />Kad o Jakov šunđa soi lesiri čhaj i Dina lađardi, lesere čhave inele ano polje e stokaja, pa o Jakov na manglja ništa te ćerel sa đikote on na irinena pe.<verse eid="GEN 34:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 34:6" />Tegani e Sihemesoro dad o Hamor alo te vaćeri e Jakoveja. <verse eid="GEN 34:6" /><verse number="7" style="v" sid="GEN 34:7" />Kad šunde so ulo, e Jakovesere čhave irinde pe taro polje but ožalostime hem holjame, adalese so o Sihem, kad suća e Jakovesere čhajaja, ćerđa okova soi ano Izrael lađavo hem so na tromal te ćerel pe.<verse eid="GEN 34:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 34:8" />O Hamor phenđa lenđe: “Mlo čhavo o Sihem but zaljubinđa pe ani tumari čhaj. Molinava tumen den le ola romnjaće. <verse eid="GEN 34:8" /><verse number="9" style="v" sid="GEN 34:9" />Ana te phanda brakovija maškar amende – den amen tumare čhajen romnjenđe, a tumen len amaren. <verse eid="GEN 34:9" /><verse number="10" style="v" sid="GEN 34:10" />Živinen maškar amende – i phuv tumenđe ko raspolaganje: živinen, biknen hem stekninen tumenđe phuv ano late.”<verse eid="GEN 34:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 34:11" />A o Sihem phenđa e Dinakere dadese hem lakere phraljenđe: “Te arakhav milost angla tumende, pa ka dav tumen so god mangena. <verse eid="GEN 34:11" /><verse number="12" style="v" sid="GEN 34:12" />Odredinen kobor god mangena i cena zaki bori hem daro savo god mangena, pa me ka dav tumen kobor god ka roden – samo den ma e čhaja romnjaće.”<verse eid="GEN 34:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 34:13" />Adalese so lengiri phen i Dina inele lađardi, e Jakovesere čhave ki prevara odgovorinde e Sihemese hem lesere dadese, e Hamorese: <verse eid="GEN 34:13" /><verse number="14" style="v" sid="GEN 34:14" />Phende lenđe: “Našti adava te ćera – te da amara phenja biobrezime manušese – adava bi amenđe ovela lađ. <verse eid="GEN 34:14" /><verse number="15" style="v" sid="GEN 34:15" />Ka prihvatina adava so mangena samo te uljen sar amen ađahar so ka obrezinen svakone tumare murše. <verse eid="GEN 34:15" /><verse number="16" style="v" sid="GEN 34:16" />Tegani ka da tumen amare čhajen hem ka la tumare čhajen amenđe, ka živina maškara tumende hem tumencar ka ova jekh narodo. <verse eid="GEN 34:16" /><verse number="17" style="v" sid="GEN 34:17" />Ali, te na šunđen amen hem na obrezinđen tumen, onda amen ka la amara phenja hem ka dža.”<verse eid="GEN 34:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 34:18" />Lengoro predlog sviđinđa pe e Hamorese hem lesere čhavese e Sihemese. <verse eid="GEN 34:18" /><verse number="19" style="v" sid="GEN 34:19" />O Sihem, kova inele najugledno sarijendar ano čher ple dadesoro, na razmislinđa pe ni hari te ćerel okova so rodinde, adalese so edobor manglja e Jakovesere čhaja. <verse eid="GEN 34:19" /><verse number="20" style="v" sid="GEN 34:20" />Adalese o Hamor hem lesoro čhavo o Sihem džele angli kapija pumare dizjakiri te vaćeren pumare dizutnencar, vaćerindoj:<verse eid="GEN 34:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 34:21" />“Adalai manuša šukar premala amende. Ana te muka len te živinen ani amari phuv hem te biknen ano late – isi olenđe dovoljno than ani akaja phuv. Amen šaj te la lengere čhajen romnjenđe, a on šaj te len amare čhajen romnjenđe. <verse eid="GEN 34:21" /><verse number="22" style="v" sid="GEN 34:22" />Ali akala manuša ka pristaninen te živinen amencar sar jekh narodo samo te svako murš maškar amende obrezini pe sar so on obrezinena pe. <verse eid="GEN 34:22" /><verse number="23" style="v" sid="GEN 34:23" />Zar olengiri stoka, lengoro barvalipe hem sa avera životinje ađahar naka oven amare? Adalese ana te pristanina, hem on ka živinen maškar amende.”<verse eid="GEN 34:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 34:24" />I sa olengere dizutne složinde pe e Hamoreja hem lesere čhaveja e Sihemeja, pa svako murš ani diz obrezinđa pe.<verse eid="GEN 34:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 34:25" />Ali ko trito dive, sar pana sarijen olen ine dukha, duj čhave e Jakovesere, o Simeon hem o Levije, e Dinakere phralja, lelje pumare mačija, pa đerdinde iznenada ani diz hem mudarde svakone murše. <verse eid="GEN 34:25" /><verse number="26" style="v" sid="GEN 34:26" />Mačeja mudarde e Hamore hem lesere čhave e Siheme, lelje e Dina taro čher e Sihemesoro pa džele. <verse eid="GEN 34:26" /><verse number="27" style="v" sid="GEN 34:27" />Avera čhave e Jakovesere ale ko adava than kaj inele o mudariba pa čorde i diz adalese so lengiri phen inele lađardi. <verse eid="GEN 34:27" /><verse number="28" style="v" sid="GEN 34:28" />Lelje lengiri sitno hem krupno stoka, e hernen hem sa olengoro so inele ani diz hem ano polje. <verse eid="GEN 34:28" /><verse number="29" style="v" sid="GEN 34:29" />Legarde sa olengoro barvalipe, legarde sa lengere romnjen hem e čhavoren hem čorde sa so inele ano čhera.<verse eid="GEN 34:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 34:30" />Tegani o Jakov phenđa e Simeonese hem e Levijese: “Ćerđen maje nevolja akaleja, adalese so o manuša akala phuvjakere, o Hanaanci hem o Perižanja, zamrzinde man. Amen injam hari, pa te on udružinde pe protiv mande te napadinen man, ka ova uništime hem me hem mle čherutne.”<verse eid="GEN 34:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 34:31" />Ali on phende lese: “Našti ov te postupini amara phenjaja sar bludnicaja.”<verse eid="GEN 34:31" /></para>
  <chapter eid="GEN 34" />
  <chapter number="35" style="c" sid="GEN 35" />
  <para style="s">O Jakov palem ano Betel</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 35:1" />O Devel phenđa e Jakovese: “Spremin tut, pa dža ano Betel hem adari živin. Adari vazde žrtveniko e Devlese kova mothovđa pe će kad našljan te phralestar e Isavestar.”<verse eid="GEN 35:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 35:2" />O Jakov phenđa ple čherutnenđe hem sarijenđe kola inele oleja: “Odbacinen e abanđijengere devlen saven isi tumen tumencar, očistinen tumen hem urjaven aver šeja, <verse eid="GEN 35:2" /><verse number="3" style="v" sid="GEN 35:3" />a onda hajde ano Betel. Adari ka vazdav žrtveniko e Devlese kova uslišinđa man kad injumle ani nevolja hem kova inele mancar ko drom saveja dželjum.”<verse eid="GEN 35:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 35:4" />Ađahar on predinde e Jakovese sa e abanđijengere devlen save inolen hem o čenja save akharde ko kana, a o Jakov adava parunđa talo hrast uzalo Sihem. <verse eid="GEN 35:4" /><verse number="5" style="v" sid="GEN 35:5" />Tegani lelje te džan, a o Devel ćerđa te dolel i dar sa e dizutnen taro avera dizja okolo lende, pa niko na progoninđa e Jakovesere čhaven.<verse eid="GEN 35:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 35:6" />O Jakov hem sa o narodo kova inele oleja resle ani Luz, adavai o Betel, ano Hanaan, <verse eid="GEN 35:6" /><verse number="7" style="v" sid="GEN 35:7" />kaj ov vazdinđa žrtveniko. Ov adava than vičinđa El Betel,<note caller="+" style="f"><char style="fr" closed="false">35,7 </char><char style="fq" closed="false">El Betel </char><char style="ft" closed="false">so značini: “O Devel e Betelesoro.”</char></note> adalese so adari o Devel mothovđa pe lese kad našlo taro plo phral.<verse eid="GEN 35:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 35:8" />Tegani muli i Debora, e Revekakiri sluškinja koja barjarđa la, pa parunde la po tele taro Betel, talo hrast savo vičinde Alon Bahut.<note caller="+" style="f"><char style="fr" closed="false">35,8 </char><char style="fq" closed="false">Alon Bahut </char><char style="ft" closed="false">so značini: “O hrast, uzalo savo rovela pe.”</char></note><verse eid="GEN 35:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 35:9" />Palo adava so o Jakov irinđa pe taro Padan Aram, o Devel palem mothovđa pe lese hem blagoslovinđa le.<verse eid="GEN 35:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 35:10" />O Devel phenđa lese: “Vičineja tut Jakov, ali naka vičine tut više ađahar, nego to anav ka ovel Izrael.”</para>
  <para style="p" vid="GEN 35:10">Ađahar o Devel dinđa le anav Izrael.<verse eid="GEN 35:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 35:11" />O Devel pana phenđa lese: “Me injum o Devel, kova sa šaj. Ov plodno hem množin tut. Tutar ka ikljol narodo hem but narodija, hem ka oven carija maškaro te potomci. <verse eid="GEN 35:11" /><verse number="12" style="v" sid="GEN 35:12" />I phuv savi dinđum e Avraamese hem e Isaakese, dava la hem tuće, a ka dav la hem te potomstvose.”<verse eid="GEN 35:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 35:13" />Tegani o Devel dželo olestar taro adava than ko savo vaćerđa oleja.<verse eid="GEN 35:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 35:14" />O Jakov ispravinđa jekh bar sar stubo ko than ko savo o Devel vaćerđa oleja, pa upro leste čhorđa mol hem ulje sar žrtva e Devlese. <verse eid="GEN 35:14" /><verse number="15" style="v" sid="GEN 35:15" />O than ko savo o Devel vaćerđa oleja, o Jakov vičinđa Betel.<verse eid="GEN 35:15" /></para>
  <para style="s">E Rahiljakoro meriba</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 35:16" />Tegani o Jakov hem lesere manuša džele taro Betel. Kad inele pana hari paše đi i Efrata, i Rahilja lelja te bijani, a inola but dukha.<verse eid="GEN 35:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 35:17" />Dok inola dukha, i babica phenđa laće: “Ma dara, adalese so hem akava ka ovel čhavo.”<verse eid="GEN 35:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 35:18" />A sar cidela ine duša te merel, dinđa ple čhavese anav Ven Oni,<note caller="+" style="f"><char style="fr" closed="false">35,18 </char><char style="fq" closed="false">Ven Oni </char><char style="ft" closed="false">so značini: “O čhavo mle tugakoro.”</char></note> ali lesoro dad dinđa le anav Venijamin.<note caller="+" style="f"><char style="fr" closed="false">35,18 </char><char style="fq" closed="false">Venijamin </char><char style="ft" closed="false">so značini: “O čhavo mle desnone vastesoro” ili “O čhavo mle bahtalipnasoro.”</char></note><verse eid="GEN 35:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 35:19" />Ađahar i Rahilja muli, pa parunde la ko drom nakori Efrata, adavai ano Vitlejem. <verse eid="GEN 35:19" /><verse number="20" style="v" sid="GEN 35:20" />O Jakov čhivđa stubo oto bar upro lakoro grobo hem adava stubo đi avdisutno dive označini e Rahiljakoro grobo. <verse eid="GEN 35:20" /><verse number="21" style="v" sid="GEN 35:21" />Tegani o Izrael dželo ple dromeja hem vazdinđa plo šatori oti aver strana oti kula Eder.<verse eid="GEN 35:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 35:22" />Dok o Izrael živinđa ano adava krajo, o Ruvim dželo hem suća e Bilhaja, ple dadesere romnjaja koja inele ropkinja, a o Izrael dodžanđa zako adava.</para>
  <para style="s" vid="GEN 35:22">E Jakovesere čhave</para>
  <para style="p" vid="GEN 35:22">E Jakove ine dešu duj čhave.<verse eid="GEN 35:22" /></para>
  <para style="b" />
  <para style="li">
    <verse number="23" style="v" sid="GEN 35:23" />E Lijakere čhave inele: o Ruvim, e Jakovesoro prvobijando čhavo, o Simeon, o Levije, o Juda, o Isahar hem o Zavulon.<verse eid="GEN 35:23" /></para>
  <para style="li">
    <verse number="24" style="v" sid="GEN 35:24" />E Rahiljakere čhave inele: o Josif hem o Venijamin.<verse eid="GEN 35:24" /></para>
  <para style="li">
    <verse number="25" style="v" sid="GEN 35:25" />O čhave e Rahiljakere sluškinjakere e Bilhakere inele: o Dan hem o Neftalim.<verse eid="GEN 35:25" /></para>
  <para style="li">
    <verse number="26" style="v" sid="GEN 35:26" />O čhave e Lijakere sluškinjakere e Zilpakere inele: o Gad hem o Asir.</para>
  <para style="b" vid="GEN 35:26" />
  <para style="m" vid="GEN 35:26">Adavai e Jakovesere čhave kola bijandile lese ano Padan Aram.<verse eid="GEN 35:26" /></para>
  <para style="s">E Isaakesoro meriba</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 35:27" />O Jakov irinđa pe koro plo dad o Isaak ano Mamre, ano Kirjat Arba, adavai o Hevron, kaj živinde hem o Avraam hem o Isaak. <verse eid="GEN 35:27" /><verse number="28" style="v" sid="GEN 35:28" />O Isaak živinđa šelu oftovardeš berš. <verse eid="GEN 35:28" /><verse number="29" style="v" sid="GEN 35:29" />Živinđa but berša hem mulo ano plo baro hem bahtalo phuripe, pridružinđa pe ple pradadenđe, pa lesere čhave o Isav hem o Jakov parunde le.<verse eid="GEN 35:29" /></para>
  <chapter eid="GEN 35" />
  <chapter number="36" style="c" sid="GEN 36" />
  <para style="s">E Isavesere potomci</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 36:1" />Akavai o zapis e Isavestar, kole inele hem aver anav – Edom:<verse eid="GEN 36:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 36:2" />O Isav leljafse romnjen Hanaanken: e Ada e Elonesere e Hetitesere čhaja, e Oholivama e Anakere čhaja, koja inele unuka e Civonesiri e Hivijcosiri, <verse eid="GEN 36:2" /><verse number="3" style="v" sid="GEN 36:3" />e Bosmata e Ismailosere čhaja, koja inele e Nevajotesiri phen.<verse eid="GEN 36:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 36:4" />I Ada e Isavese bijanđa e Elifaze, a i Bosmata bijanđa e Reuele, <verse eid="GEN 36:4" /><verse number="5" style="v" sid="GEN 36:5" />a i Oholivama bijanđa e Jeuše, e Jaalame hem e Koreje.</para>
  <para style="p" vid="GEN 36:5">Adalai e Isavesere čhave kola bijandile lese ano Hanaan.<verse eid="GEN 36:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 36:6" />O Isav lelja ple romnjen, e čhaven, e čhajen hem sa ple čherutnen, ple stoka hem avere životinjen hem sa o barvalipe savo stekninđa ano Hanaan, pa dželo ani jekh phuv dur ple phralestar e Jakovestar. <verse eid="GEN 36:6" /><verse number="7" style="v" sid="GEN 36:7" />Adalese so, lengoro barvalipe edobor inele baro da našti ine te živinen zajedno – i phuv ani savi inele našti ine te izdržini sodujen zbog olengiri stoka. <verse eid="GEN 36:7" /><verse number="8" style="v" sid="GEN 36:8" />Ađahar o Isav – o Edom, lelja te živini ano bregalo krajo Seir.<verse eid="GEN 36:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 36:9" />Akalai o potomci e Isavesere, o pradad e Edomconengoro, ano bregalo krajo Seir.<verse eid="GEN 36:9" /></para>
  <para style="li">
    <verse number="10" style="v" sid="GEN 36:10" />Akalai o anava e Isavesere čhavengoro: Elifaz, o čhavo e Isavesere romnjakoro e Adakoro, hem Reuel, o čhavo e Isavesere romnjakoro e Bosmatakoro.<verse eid="GEN 36:10" /></para>
  <para style="li">
    <verse number="11" style="v" sid="GEN 36:11" />E Elifazesere čhavei: o Teman, o Omar, o Cefo, o Gaatam hem o Kenaz.<verse eid="GEN 36:11" /></para>
  <para style="li">
    <verse number="12" style="v" sid="GEN 36:12" />I Timna, koja inele romni ropkinja e Elifazesiri, e Isavesere čhavesiri, e Elifazese bijanđa e Amaleke. Adalai o potomci e Isavesere romnjakere e Adakere.<verse eid="GEN 36:12" /></para>
  <para style="li">
    <verse number="13" style="v" sid="GEN 36:13" />E Reuelesere čhavei: o Nahat, o Zara, o Šama hem o Miza.</para>
  <para style="li" vid="GEN 36:13">Adalai o potomci e Isavesere romnjakere e Bosmatakere.<verse eid="GEN 36:13" /></para>
  <para style="li">
    <verse number="14" style="v" sid="GEN 36:14" />I Oholivama, e Anakiri čhaj hem e Civonesiri unuka, e Isavese bijanđa akale čhaven: e Jeuše, e Jaalame hem e Koreje.<verse eid="GEN 36:14" /></para>
  <para style="b" />
  <para style="m">
    <verse number="15" style="v" sid="GEN 36:15" />Akalai o vođe oto plemija kola iklile e Isavestar:</para>
  <para style="li" vid="GEN 36:15">o čhave e Elifazesere, e Isavesere prvonebijande čhavesere: o Teman, o Omar, o Cefo hem o Kenaz, <verse eid="GEN 36:15" /><verse number="16" style="v" sid="GEN 36:16" />o Korej, o Gaatam hem o Amalek. Adalai o vođe oto plemija kola iklile e Elifazestar ano Edom.</para>
  <para style="li" vid="GEN 36:16">Adalai e Adakere potomci.<verse eid="GEN 36:16" /></para>
  <para style="li">
    <verse number="17" style="v" sid="GEN 36:17" />O čhave e Reuelesere, e Isavesere čhavesere: o Nahat, o Zara, o Šama hem o Miza. Adalai o vođe oto plemija kola iklile e Reuelestar ano Edom.</para>
  <para style="li" vid="GEN 36:17">Adalai o potomci e Isavesere romnjakere e Bosmatakere.<verse eid="GEN 36:17" /></para>
  <para style="li">
    <verse number="18" style="v" sid="GEN 36:18" />O čhave e Isavesere romnjakere e Oholivamakere: o Jeuš, o Jaalam hem o Korej. Adalai o vođe oto plemija kola iklile e Isavesere romnjatar e Oholivamatar, e Anakere čhajatar.<verse eid="GEN 36:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="GEN 36:19" />Adalai e Isavesere – e Edomesere – čhave hem adalai lengere plemija.<verse eid="GEN 36:19" /></para>
  <para style="s">E Seiresere potomci</para>
  <para style="m">
    <verse number="20" style="v" sid="GEN 36:20" />Akalai o čhave e Seiresere e Horijcesere, kola živinde ano Edom: o Lotan, o Šoval, o Civon, o Ana, <verse eid="GEN 36:20" /><verse number="21" style="v" sid="GEN 36:21" />o Dišon, o Ecer hem o Dišan. Adalai o vođe oto plemija e Horijcengere, kolai potomci e Seiresere ano Edom.<verse eid="GEN 36:21" /></para>
  <para style="li">
    <verse number="22" style="v" sid="GEN 36:22" />Akalai o čhave e Lotanesere: o Hori hem o Heman. I Timna inele e Lotanesiri phen.<verse eid="GEN 36:22" /></para>
  <para style="li">
    <verse number="23" style="v" sid="GEN 36:23" />Akalai e Šovalesere čhave: o Alvan, o Manahat, o Eval, o Šefo hem o Onam.<verse eid="GEN 36:23" /></para>
  <para style="li">
    <verse number="24" style="v" sid="GEN 36:24" />Akalai e Civonesere čhave: o Aja hem o Ana. O Anai adava kova ani pustinja arakhlja tate izvorija sar arakhela ine ple dadesere e Civonesere hernen.<verse eid="GEN 36:24" /></para>
  <para style="li">
    <verse number="25" style="v" sid="GEN 36:25" />Akalai e Anasere čhave: o čhavo Dišon hem i čhaj Oholivama.<verse eid="GEN 36:25" /></para>
  <para style="li">
    <verse number="26" style="v" sid="GEN 36:26" />Akalai e Dišonesere čhave: o Hemdan, o Ešban, o Jitran hem o Keran.<verse eid="GEN 36:26" /></para>
  <para style="li">
    <verse number="27" style="v" sid="GEN 36:27" />Akalai e Eceresere čhave: o Bilhan, o Zaavan hem o Akan.<verse eid="GEN 36:27" /></para>
  <para style="li">
    <verse number="28" style="v" sid="GEN 36:28" />Akalai e Dišanesere čhave: o Uc hem o Aran.<verse eid="GEN 36:28" /></para>
  <para style="li">
    <verse number="29-30" style="v" sid="GEN 36:29-30" />Akalai o vođe e Horijcengere palo lengere plemija ani phuv Seir: o Lotan, o Šoval, o Civon, o Ana, o Dišon, o Ecer hem o Dišan.<verse eid="GEN 36:29-30" /></para>
  <para style="s">O carija e Edomesere</para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 36:31" />Akalai o carija kola vladinde ano Edom angleder nego so vladinđa o caro e Izraelconengoro:<verse eid="GEN 36:31" /></para>
  <para style="b" />
  <para style="li">
    <verse number="32" style="v" sid="GEN 36:32" />o Bela o čhavo e Beoresoro ulo caro ano Edom. Lesiri diz vičinđa pe Dinhava.<verse eid="GEN 36:32" /></para>
  <para style="li">
    <verse number="33" style="v" sid="GEN 36:33" />Kad mulo o Bela, olese ko than sar caro alo o Jovav o čhavo e Zaresoro tari Bocra.<verse eid="GEN 36:33" /></para>
  <para style="li">
    <verse number="34" style="v" sid="GEN 36:34" />Kad mulo o Jovav, olese ko than sar caro alo o Hušam tari phuv e Temancengiri.<verse eid="GEN 36:34" /></para>
  <para style="li">
    <verse number="35" style="v" sid="GEN 36:35" />Kad mulo o Hušam, olese ko than sar caro alo o Hadad o čhavo e Bedadesoro, kova pobedinđa e Midijanconen ani phuv e Moavconengiri. Lesiri diz vičinđa pe Avit.<verse eid="GEN 36:35" /></para>
  <para style="li">
    <verse number="36" style="v" sid="GEN 36:36" />Kad mulo o Hadad, olese ko than sar caro alo o Samla tari Masreka.<verse eid="GEN 36:36" /></para>
  <para style="li">
    <verse number="37" style="v" sid="GEN 36:37" />Kad mulo o Samla, olese ko than sar caro alo o Saul tari Rehovot uzali len.<verse eid="GEN 36:37" /></para>
  <para style="li">
    <verse number="38" style="v" sid="GEN 36:38" />Kad mulo o Saul, olese ko than sar caro alo o Vaal Hanan o čhavo e Ahboresoro.<verse eid="GEN 36:38" /></para>
  <para style="li">
    <verse number="39" style="v" sid="GEN 36:39" />Kad mulo o Vaal Hanan o čhavo e Ahboresoro, olese ko than sar caro alo o Hadad. Lesiri diz vičinđa pe Pau. Lesiri romni vičinđa pe Mehetavel i čhaj e Matredesiri hem unuka e Me Zahavesiri.<verse eid="GEN 36:39" /></para>
  <para style="b" />
  <para style="m">
    <verse number="40" style="v" sid="GEN 36:40" />Akalai o anava e vođengoro kola iklile e Isavestar, palo lengere plemija hem o thana:</para>
  <para style="li" vid="GEN 36:40">o Timna, o Alva, o Jetet, <verse eid="GEN 36:40" /><verse number="41" style="v" sid="GEN 36:41" />o Oholivama, o Ela, o Pinon, <verse eid="GEN 36:41" /><verse number="42" style="v" sid="GEN 36:42" />o Kenaz, o Teman, o Mivcar, <verse eid="GEN 36:42" /><verse number="43" style="v" sid="GEN 36:43" />o Magdiel hem o Iram. Adalai o plemija e Edomesere – Isavesere – kovai pradad e Edomconengoro, palo lengere thana ani phuv savi osvojinde.<verse eid="GEN 36:43" /></para>
  <chapter eid="GEN 36" />
  <chapter number="37" style="c" sid="GEN 37" />
  <para style="s">O Josif hem lesere phralja</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 37:1" />O Jakov živinđa ani phuv ki savi živinđa lesoro dad sar abanđija, ano Hanaan.<verse eid="GEN 37:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 37:2" />Akavai o izveštaj e Jakovestar:</para>
  <para style="p" vid="GEN 37:2">Kad o Josif inele terno čhavo oto dešu efta berš, arakhi ine o stado ple dadesoro ple phraljencar, e Bilhakere hem e Zilpakere čhavencar, kola inele lesere dadesere romnja. Ov ple dadese anđa bišukar glaso olendar.<verse eid="GEN 37:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 37:3" />A o Izrael oto sa ple čhave najviše volinđa e Josife, adalese so bijandilo lese ano phuripe, pa ov ćerđa lese but šužo ogrtači. <verse eid="GEN 37:3" /><verse number="4" style="v" sid="GEN 37:4" />Kad e Josifesere phralja dikhle so lengoro dad e Josife volini više oto sa čhave, zamrzinde le edobor da našti ine nijekh ljubazno lafi te phenen lese.<verse eid="GEN 37:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 37:5" />Jekhvar o Josif dikhlja suno hem vaćerđa le ple phraljenđe, pa on pana više zamrzinde le.<verse eid="GEN 37:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 37:6" />O Josif phenđa lenđe: “Šunen savo suno dikhljum: <verse eid="GEN 37:6" /><verse number="7" style="v" sid="GEN 37:7" />Sar phandaja ine e đivesere snopija ano polje, pa mlo snop otojekhvar uštino hem ispravinđa pe, a tumare snopija čedinde pe uzalo leste hem pokloninde pe lese.”<verse eid="GEN 37:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 37:8" />O phralja ko adava phende lese: “Zar tu adava mangeja te vladine upro amende? Zar mangeja te ove amaro gospodari?”</para>
  <para style="p" vid="GEN 37:8">Hem pana po više lelje te mrzinen le zbog lesoro suno hem zbog sa so phenđa olendar.<verse eid="GEN 37:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 37:9" />A o Josif dikhlja hem aver suno hem phenđa le ple phraljenđe vaćerindoj: “Šunen, palem dikhljum suno: pokloninde pe maje o kham, o masek hem o dešu jekh čerenja.”<verse eid="GEN 37:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 37:10" />Kad vaćerđa adava ple dadese hem ple phraljenđe, lesoro dad ukorinđa le hem phenđa: “Savoi adava suno so dikhljan! Zar me, ti daj hem te phralja ka ava hem ka poklonina amen mujeja đi phuv angla tute?”<verse eid="GEN 37:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 37:11" />I dok lesere phralja inele ljubomorna upro leste, lesoro dad razmislinđa oto sa adava.<verse eid="GEN 37:11" /></para>
  <para style="s">O Josif biknime ano Egipat</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 37:12" />Jekhvar, e Josifesere phralja legarde ple dadesere stado te hal čar paše uzalo Sihem, <verse eid="GEN 37:12" /><verse number="13" style="v" sid="GEN 37:13" />o Izrael phenđa e Josifese: “Džane da te phralja legarde e stado te hal čar paše uzalo Sihem. Hajde, ka bičhalav tut koro lende.”</para>
  <para style="p" vid="GEN 37:13">O Josif phenđa: “Šukari, ka džav.”<verse eid="GEN 37:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 37:14" />O Izrael phenđa lese: “Dža hem dikh da li sa šukar te phraljencar hem e stadoja, pa irin tut te javine maje.”</para>
  <para style="p" vid="GEN 37:14">Ađahar bičhalđa le tari Hevronsko dolina.</para>
  <para style="p" vid="GEN 37:14">Kad o Josif reslo ano Sihem, <verse eid="GEN 37:14" /><verse number="15" style="v" sid="GEN 37:15" />jekh manuš dikhlja le sar lutini maškaro polja, pa pučlja le: “So rodeja?”<verse eid="GEN 37:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 37:16" />O Josif phenđa: “Rodava mle phraljen. Phen maje, na li džane kaj legarde e stado te hal čar?”<verse eid="GEN 37:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 37:17" />O manuš phenđa lese: “Džele akatar. Šunđum len sar vaćerena: ‘Hajde ano Dotan.’”</para>
  <para style="p" vid="GEN 37:17">O Josif dželo palo ple phralja hem arakhlja len paše uzalo Dotan. <verse eid="GEN 37:17" /><verse number="18" style="v" sid="GEN 37:18" />A on odural već dikhle le, pa lelje te dogovorinen pe te mudaren le.<verse eid="GEN 37:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 37:19" />Jekh averese phende: “Ače, avela okova so dikhela sune. <verse eid="GEN 37:19" /><verse number="20" style="v" sid="GEN 37:20" />Hajde akana te mudara le hem te frda le ani nesavi jama! Ka phena da halja le nesavi divljo zver. Te dikha onda so ka ovel oto lesere sune!”<verse eid="GEN 37:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 37:21" />Kad šunđa adava o Ruvim, dikhlja te spasini le lengere vastendar, vaćerindoj:</para>
  <para style="p" vid="GEN 37:21">“Ma te mudara le! <verse eid="GEN 37:21" /><verse number="22" style="v" sid="GEN 37:22" />Ma te čhora lesoro rat! Frden le ani akaja jama akate ani pustinja, ali ma vazden tumaro vas upro leste!”</para>
  <para style="p" vid="GEN 37:22">O Ruvim phenđa adava sar te spasini e Josife taro lengere vasta hem te irini le lesere dadese.<verse eid="GEN 37:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 37:23" />Kad o Josif reslja koro ple phralja, on huljavde lestar ki sila okova šužo ogrtači, <verse eid="GEN 37:23" /><verse number="24" style="v" sid="GEN 37:24" />pa dolinde le hem frdinde le ani jama. A ani jama na inele pani.<verse eid="GEN 37:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 37:25" />Kad bešle te han, vazdinde plo šero hem dikhle bute trgovconen kola inele Ismailovci sar avena taro Gilad. Lengere kamile inele natovarime mirisencar, balsameja hem smirnaja saven legarena ine ano Egipat.<verse eid="GEN 37:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 37:26" />O Juda phenđa ple phraljenđe: “So isi amen adalestar te mudara amare phrale hem te garava lesoro meriba? <verse eid="GEN 37:26" /><verse number="27" style="v" sid="GEN 37:27" />Hajde te bikna le akale Ismailconenđe. Ma te vazda amaro vas upro leste, amaroi phral, amaro rat.”</para>
  <para style="p" vid="GEN 37:27">I lesere phralja šunde le.<verse eid="GEN 37:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 37:28" />Kad nakhle maškar olende okola Ismailovci kola inele midijanska trgovci, o phralja ikalde e Josife oti jama hem zako biš srebrnjaci bikninde le olenđe, pa on e Josife legarde ano Egipat.<verse eid="GEN 37:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 37:29" />Kad o Ruvim irinđa pe hem kad dikhlja da o Josif nane ani jama, pharavđa ple šeja upra peste, <verse eid="GEN 37:29" /><verse number="30" style="v" sid="GEN 37:30" />pa irinđa pe koro ple phralja hem phenđa: “O čhavoro nane adari! So ka ćerav akana?”<verse eid="GEN 37:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 37:31" />Tegani o phralja lelje e Josifesoro ogrtači, čhinde jekhe jarco hem o ogrtači makhle e jarcosere rateja, <verse eid="GEN 37:31" /><verse number="32" style="v" sid="GEN 37:32" />pa o ogrtači bičhalde koro plo dad vaćerindoj: “Arakhljam akava. Dikh na li akava te čhavesoro ogrtači.”<verse eid="GEN 37:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 37:33" />O Jakov pendžarđa le hem phenđa: “Oja, adavai o ogrtači mle čhavesoro! Nesavi divljo zver sa halje le! O Josif čhinđerdoi ko kotora!”<verse eid="GEN 37:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 37:34" />Tegani o Jakov pharavđa ple šeja upra peste hem ko maškar urđa pe ano kostret, pa but dive runđa ple čhave. <verse eid="GEN 37:34" /><verse number="35" style="v" sid="GEN 37:35" />Sa lesere čhave hem čhaja ale te tešinen le, ali ov na manglja te utešini pe.</para>
  <para style="p" vid="GEN 37:35">Phenđa: “Na, ka rovav mle čhave sa đikote hem me na džava ano Šeol.”</para>
  <para style="p" vid="GEN 37:35">Ađahar lesoro dad runđa palo leste.<verse eid="GEN 37:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 37:36" />A okola Midijanci bikninde e Josife ano Egipat e Potifarese. Ov inele jekh oto e faraonesere bare službenici, naredniko e palatakere stražakoro.<verse eid="GEN 37:36" /></para>
  <chapter eid="GEN 37" />
  <chapter number="38" style="c" sid="GEN 38" />
  <para style="s">O Juda hem i Tamara</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 38:1" />Ano adava vreme o Juda dželo oto ple phralja hem lelja te živini koro jekh manuš kova vičinđa pe Hira, tari diz Adulam. <verse eid="GEN 38:1" /><verse number="2" style="v" sid="GEN 38:2" />Adari o Juda dikhlja e čhaja nesave Hanaancosere kova vičinđa pe Šua, lelja la romnjaće hem suća olaja. <verse eid="GEN 38:2" /><verse number="3" style="v" sid="GEN 38:3" />Oj ačhili khamni hem bijanđa čhave, kase o Juda dinđa anav Er. <verse eid="GEN 38:3" /><verse number="4" style="v" sid="GEN 38:4" />Oj palem ačhili khamni hem bijanđa čhave, kase dinđa anav Onan. <verse eid="GEN 38:4" /><verse number="5" style="v" sid="GEN 38:5" />Palo adava oj bijanđa pana jekhe čhave hem dinđa le anav Sala. Ano adava vreme kad o čhavoro bijandilo, on živinde ani diz Keziv.<verse eid="GEN 38:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 38:6" />O Juda ple najphuredere čhavese arakhlja romnja. Olakoro anav inele Tamara. <verse eid="GEN 38:6" /><verse number="7" style="v" sid="GEN 38:7" />Ali e Judasoro prvobijando čhavo o Er inele bišukar anglo GOSPOD, pa o GOSPOD mudarđa le.<verse eid="GEN 38:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 38:8" />Tegani o Juda phenđa e Onanese: “Sov te phralesere romnjaja i ćer ti dužnost premalo late sar soi amaro adeti, te šaj te phrale ovel potomstvo.”<verse eid="GEN 38:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 38:9" />Ali adalese so o Onan džanđa da o potomstvo naka ovel olesoro, kad god bi sovela ple phralesere romnjaja, na ćerela ine te ačhol khamni, sar te na del potomstvo ple phralese. <verse eid="GEN 38:9" /><verse number="10" style="v" sid="GEN 38:10" />Adava so ćerđa inele bišukaripe anglo GOSPOD, pa o GOSPOD mudarđa hem ole.<verse eid="GEN 38:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 38:11" />Tegani o Juda phenđa pla borjaće e Tamaraće: “Dža hem živin sar udovica te dadese ano čher, đikote mlo čhavo o Sala na barjola.”</para>
  <para style="p" vid="GEN 38:11">Adalese so, o Juda mislinđa: “Te na mudarđol hem ov sar lesere phralja.”</para>
  <para style="p" vid="GEN 38:11">Ađahar i Tamara dželi te živini ple dadese ano čher.<verse eid="GEN 38:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 38:12" />Palo but vreme e Judasiri romni, e Šuinasiri čhaj, muli. Kad nakhino o vreme e tugujibnasoro, o Juda dželo ple amaleja e Hireja e Adulamcoja ani Timna koro manuša kola muravena ine lesere bakren.<verse eid="GEN 38:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 38:13" />Kad phende e Tamaraće: “Eče, to sastro džala ani Timna te muraj e bakren,” <verse eid="GEN 38:13" /><verse number="14" style="v" sid="GEN 38:14" />tegani oj huljavđa pestar o udovička šeja, phandlja pe o veo, hem učharđa plo šero, pa beštini ko ulaz ano Enajim, kovai nakoro drom premali Timna. Adalese so, dikhlja da o Sala barilo, a na dinde la olese romnjaće.<verse eid="GEN 38:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 38:15" />Kad dikhlja la o Juda, mislinđa dai bludnica, adalese so lakoro muj ine učhardo.<verse eid="GEN 38:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 38:16" />O Juda oto drom dželo uzalo late hem phenđa: “Hajde, ana te sovav tuja.” Ov na džanđa dai oj lesiri bori.</para>
  <para style="p" vid="GEN 38:16">A oj pučlja le: “So ka de man te sućum tuja?”<verse eid="GEN 38:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 38:17" />O Juda phenđa: “Ka bičhalav će jarco taro stado.”</para>
  <para style="p" vid="GEN 38:17">A oj phenđa: “So ka de man sar garancija dok na bičhaleja le?”<verse eid="GEN 38:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 38:18" />O Juda pučlja la: “So te dav tut sar garancija?”</para>
  <para style="p" vid="GEN 38:18">Oj phenđa: “Ti angrustik e pečateja savi phandli e dorikhaja, hem o štapi savoi će ano vas.”</para>
  <para style="p" vid="GEN 38:18">I ov dinđa la adava, pa suća olaja, hem oj ačhili khamni lestar. <verse eid="GEN 38:18" /><verse number="19" style="v" sid="GEN 38:19" />Tegani i Tamara dželi čhere, huljavđa o veo hem palem urđa pe ple udovička šeja.<verse eid="GEN 38:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 38:20" />O Juda bičhalđa ple amale e Adulamco e jarcoja, te činel okola đuvljatar adava soi laće dindo sar garancija, ali ov na arakhlja la.<verse eid="GEN 38:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 38:21" />Ov pučlja e dizutnen: “Kaj i hramsko bludnica koja inele uzalo drom zako Enajim?”</para>
  <para style="p" vid="GEN 38:21">A on phende lese: “Akate na inele nisavi hramsko bludnica.”<verse eid="GEN 38:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 38:22" />Ov irinđa pe koro Juda hem phenđa: “Na arakhljum la. Hem sem adava, o dizutne phende maje: ‘Akate na inele nisavi hramsko bludnica.’ ”<verse eid="GEN 38:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 38:23" />Tegani o Juda phenđa: “Nek ačhol adava koro late, ma o manuša te maren amenđe muj. Eče, me bičhalđum laće jarco, ali tu na arakhljan la.”<verse eid="GEN 38:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 38:24" />Kad nakhine trin masek, e Judase phende: “Ti bori i Tamara muklja pe ano blud, pa čak hem ačhili khamni.”</para>
  <para style="p" vid="GEN 38:24">O Juda phenđa: “Ikalen la hem tharen la.”<verse eid="GEN 38:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 38:25" />Ali, sar ikalena la ine, oj ple sastrese phenđa: “Ačhiljum khamni e manušeja kasoroi akava. Dikh, molinava tut, pendžareja li kasiri akaja angrustik e pečateja savi phandli e dorikhaja hem o štapi?”<verse eid="GEN 38:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 38:26" />O Juda pendžarđa len, pa phenđa: “Oj po pravedno mandar, adalese so me na dinđum la mle čhavese e Salase.”</para>
  <para style="p" vid="GEN 38:26">Hem o Juda više na suća olaja.<verse eid="GEN 38:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 38:27" />Kad alo o vreme i Tamara te bijani, dičhilo dai laće ano vođi blizanci.<verse eid="GEN 38:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 38:28" />Sar bijani ine, jekh olendar pružinđa plo vas avrijal, a i babica phandlja lolo thav ko lesoro vas, vaćerindoj: “Akava iklilo prvo.”<verse eid="GEN 38:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 38:29" />Ali baš kad cidinđa plo vas, lesoro phral iklilo, a i babica phenđa: “Sar li tu probinđan tut te ikljove prvo?” Adalese dinde le anav Fares.<note caller="+" style="f"><char style="fr" closed="false">38,29 </char><char style="fq" closed="false">Fares </char><char style="ft" closed="false">so značini: “proboj.”</char></note><verse eid="GEN 38:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 38:30" />Palo adava iklilo lesoro phral, kole ine o lolo thav ko vas, pa olese dinde anav Zara.<note caller="+" style="f"><char style="fr" closed="false">38,30 </char><char style="fq" closed="false">Zara </char><char style="ft" closed="false">zvučini sar: “o rumenilo e zorakoro.”</char></note><verse eid="GEN 38:30" /></para>
  <chapter eid="GEN 38" />
  <chapter number="39" style="c" sid="GEN 39" />
  <para style="s">O Josif hem e Potifaresiri romni</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 39:1" />Kad o Josif inele legardo ano Egipat, o Egipćanco o Potifar, jekh oto e faraonesere bare službenici, naredniko e palatakere stražakoro, činđa le oto Ismailovci kola legarde le adari.<verse eid="GEN 39:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 39:2" />O GOSPOD inele e Josifeja, pa ov inele uspešno. Živinđa ano čher ple gospodaresoro e Egipćancosoro. <verse eid="GEN 39:2" /><verse number="3" style="v" sid="GEN 39:3" />Kad lesoro gospodari dikhlja dai o GOSPOD e Josifeja hem da dela le te ovel uspešno ano sa so ćerela, <verse eid="GEN 39:3" /><verse number="4" style="v" sid="GEN 39:4" />o Josif arakhlja milost anglo plo gospodari hem ulo lesoro lično sluga. O Potifar čhivđa le te ovel upravniko lesere čherestar hem te brinini pe oto sa lesoro barvalipe. <verse eid="GEN 39:4" /><verse number="5" style="v" sid="GEN 39:5" />Otkad o Potifar čhivđa e Josife te upravini lesere čhereja hem sa lesere barvalipnaja, o GOSPOD, zbog o Josif, blagoslovinđa e Egipćancosoro čher. E GOSPODESORO blagoslov inele upro sa so ine e Potifare ano čher hem ano polje. <verse eid="GEN 39:5" /><verse number="6" style="v" sid="GEN 39:6" />O Potifar muklja e Josifese ko vasta sa so inole hem zako ništa više na brininđa, samo zako hajba savo halja.</para>
  <para style="p" vid="GEN 39:6">A o Josif inele šužo murš hem inole šukar telo. <verse eid="GEN 39:6" /><verse number="7" style="v" sid="GEN 39:7" />Palo nesavo vreme, lesere gospodaresiri romni čhivđa jakh upro leste hem phenđa lese: “Sov mancar.”<verse eid="GEN 39:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 39:8" />O Josif odbinđa la hem phenđa ple gospodaresere romnjaće: “Ače, otkad me injum akate, mlo gospodari na brinini pe zako ništa ano čher, nego sa so isi le muklja maje ko vasta. <verse eid="GEN 39:8" /><verse number="9" style="v" sid="GEN 39:9" />Ano akava čher nane niko upreder mande. Mlo gospodari na uskratinđa maje ništa sem tut, adalese so tu injan lesiri romni. Sar onda šaj te ćerav esavko bišukaripe hem te grešinav protiv o Devel?”<verse eid="GEN 39:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 39:10" />Ađahar dive palo dive oj nagovorini ine e Josife te sovel olaja, a ov odbini ine te sovel olaja hem te ovel paše uzalo late.<verse eid="GEN 39:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 39:11" />Jekh dive o Josif đerdinđa ano čher te ćerel pli buti, a andre niko na inele oto sluge. <verse eid="GEN 39:11" /><verse number="12" style="v" sid="GEN 39:12" />Oj dolinđa le oto ogrtači hem phenđa: “Sov mancar!”</para>
  <para style="p" vid="GEN 39:12">Ali ov ačhavđa plo ogrtači olaće ano vas hem ki sig naštino avri.<verse eid="GEN 39:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 39:13" />Kad oj dikhlja da ov ačhavđa plo ogrtači olaće ano vas hem da naštino avri, <verse eid="GEN 39:13" /><verse number="14" style="v" sid="GEN 39:14" />oj vičinđa ple slugen hem phenđa lenđe: “Dikhen! Anđa amenđe akale Jevrejco te lađari amen! Manglja te sovel mancar, ali me leljum te vičinav. <verse eid="GEN 39:14" /><verse number="15" style="v" sid="GEN 39:15" />Kad šunđa so leljum te vičinav, ačhavđa plo ogrtači kora mande hem naštino avri.”<verse eid="GEN 39:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 39:16" />Ićerđa e Josifesoro ogrtači uzala peste sa đikote lesoro gospodari na alo čhere, <verse eid="GEN 39:16" /><verse number="17" style="v" sid="GEN 39:17" />tegani hem olese vaćerđa isto priča: “Okova sluga o Jevrejco kole anđan amenđe, alo kora mande te lađari man. <verse eid="GEN 39:17" /><verse number="18" style="v" sid="GEN 39:18" />Ali, kad leljum te vičinav, ačhavđa plo ogrtači kora mande hem naštino avri.”<verse eid="GEN 39:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 39:19" />Kad lesoro gospodari šunđa i priča pla romnjakiri, koja phenđa lese: “Ađahar to sluga ćerđa mancar”, inele but holjame, <verse eid="GEN 39:19" /><verse number="20" style="v" sid="GEN 39:20" />pa lelja e Josife hem frdinđa le ano phandlipe, adari kaj inele phandle e carosere zatvorenici.</para>
  <para style="p" vid="GEN 39:20">Dok o Josif inele ano phandlipe, <verse eid="GEN 39:20" /><verse number="21" style="v" sid="GEN 39:21" />o GOSPOD inele oleja. Mothovđa lese plo mangipe hem dinđa le te arakhi milost anglo upravniko oto phandlipe, <verse eid="GEN 39:21" /><verse number="22" style="v" sid="GEN 39:22" />kova sa e zatvorenikonen ano phandlipe muklja e Josifese ko vasta, pa o Josif inele odgovorno zako sa so ćerđa pe adari. <verse eid="GEN 39:22" /><verse number="23" style="v" sid="GEN 39:23" />O upravniko oto phandlipe na brininđa zako ništa so inele e Josifese poverime, adalese so o GOSPOD inele e Josifeja hem dinđa le te ovel uspešno ano sa so ćerela.<verse eid="GEN 39:23" /></para>
  <chapter eid="GEN 39" />
  <chapter number="40" style="c" sid="GEN 40" />
  <para style="s">O Josif tumačini o sune</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 40:1" />Palo nesavo vreme, o peharniko hem o pekari e faraonesoro grešinde protiv o faraon, kovai lengoro gospodari – o caro e Egipatesoro. <verse eid="GEN 40:1" /><verse number="2" style="v" sid="GEN 40:2" />O Faraon holjanđa upro ple duj službenici, upro glavno peharniko hem upro glavno pekari, <verse eid="GEN 40:2" /><verse number="3" style="v" sid="GEN 40:3" />hem phandlja len ano čher e stražakere narednikosoro, ano isto phandlipe kaj o Josif inele phandlo. <verse eid="GEN 40:3" /><verse number="4" style="v" sid="GEN 40:4" />O naredniko e stražakoro odredinđa e Josife te brinini pe olendar.</para>
  <para style="p" vid="GEN 40:4">Hem on inele phandle ko nesavo vreme. <verse eid="GEN 40:4" /><verse number="5" style="v" sid="GEN 40:5" />Jekh rat on soduj – o peharniko hem o pekari e faraonesoro, kola inele ano phandlipe – dikhle suno. Svako olendar dikhlja plo suno hem svako suno inole plo značenje.<verse eid="GEN 40:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 40:6" />Kad o Josif alo sabale koro lende, dikhlja len dai zabrinime, <verse eid="GEN 40:6" /><verse number="7" style="v" sid="GEN 40:7" />pa pučlja len: “Sose avdive injen ađahar zabrinime?”<verse eid="GEN 40:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 40:8" />A on phende lese: “Dikhljam sune, ali nane niko te tumačini len.”</para>
  <para style="p" vid="GEN 40:8">Tegani o Josif phenđa lenđe: “Nane li o Devel adava kova dela o tumačenje zako sune? Hajde, mothoven maje tumare sune.”<verse eid="GEN 40:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 40:9" />O glavno peharniko phenđa plo suno e Josifese vaćerindoj:</para>
  <para style="p" vid="GEN 40:9">“Otojekhvar ano mlo suno dikhljum čokot angla mande, <verse eid="GEN 40:9" /><verse number="10" style="v" sid="GEN 40:10" />hem upro leste inele trin loze. Hem samo so iklile o listija, procvetinđa, hem zrelonde o drakha upro leste. <verse eid="GEN 40:10" /><verse number="11" style="v" sid="GEN 40:11" />Ano vas ićerđum e faraonesiri bari čaša. Tegani leljum o drakha, iscedinđum len ani e faraonesiri bari čaša, hem čhivđum la e faraonese ano vas.”<verse eid="GEN 40:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 40:12" />O Josif phenđa lese: “Ače so značini adava: o trin loze adavai trin dive. <verse eid="GEN 40:12" /><verse number="13" style="v" sid="GEN 40:13" />Zako trin dive o faraon ka smilujini pe će hem ka irini tut ani ti služba, pa i bari čaša ka čhive e faraonese ano vas sar hem angleder kad injanle lesoro peharniko. <verse eid="GEN 40:13" /><verse number="14" style="v" sid="GEN 40:14" />Ali kad ka džal će šukar, molinava tut, setin tut mandar hem mothov mangipe premalo mande ađahar so ka vaćere mandar anglo faraon hem so ka ikale man taro akava phandlipe. <verse eid="GEN 40:14" /><verse number="15" style="v" sid="GEN 40:15" />Adalese so, me injum ki sila legardo tari phuv e Jevrejengiri, a ni akate na ćerđum ništa zako so bi čhivena man ano phandlipe.”<verse eid="GEN 40:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 40:16" />Kad o glavno pekari dikhlja so o Josif šukar protumačinđa o suno, phenđa lese: “Hem me dikhljum suno: upro šero akharđum trin korpe pecivo. <verse eid="GEN 40:16" /><verse number="17" style="v" sid="GEN 40:17" />Ani upruni korpa inele razna vrste oto pecivo e faraonese, ali o čiriklja hale len tari korpa maje upro šero.”<verse eid="GEN 40:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 40:18" />O Josif phenđa lese: “Ače so značini adava: o trin korpei trin dive. <verse eid="GEN 40:18" /><verse number="19" style="v" sid="GEN 40:19" />Zako trin dive o faraon ka čhinel to šero hem ka ove obesime ko kaš, pa o čiriklja ka han to mas.”<verse eid="GEN 40:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 40:20" />Palo trin dive inele e faraonesoro bijando dive hem o faraon ćerđa gozba zako sa ple službenici, pa anglo lende ikalđa e glavnone peharniko hem e glavnone pekare. <verse eid="GEN 40:20" /><verse number="21" style="v" sid="GEN 40:21" />E glavnone peharniko irinđa le ani lesiri služba, pa ov palem i bari čaša čhivđa e faraonese ano vas, <verse eid="GEN 40:21" /><verse number="22" style="v" sid="GEN 40:22" />a e glavnone pekare obesinđa, baš sar so o Josif phenđa lenđe ano plo tumačenje.<verse eid="GEN 40:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 40:23" />Ali o glavno peharniko na setinđa pe e Josifestar. Bisterđa le.<verse eid="GEN 40:23" /></para>
  <chapter eid="GEN 40" />
  <chapter number="41" style="c" sid="GEN 41" />
  <para style="s">O Josif tumačini e faraonesere sune</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 41:1" />Palo duj pherde berša, o faraon dikhlja suno sar terđola ine uzali len Nil. <verse eid="GEN 41:1" /><verse number="2" style="v" sid="GEN 41:2" />I otojekhvar taro Nil iklile efta guruvnja, šuže hem thule, hem lelje te han i trska ki obala. <verse eid="GEN 41:2" /><verse number="3" style="v" sid="GEN 41:3" />Palo lende taro Nil iklile avera efta guruvnja, gruba hem šuke, pa terdine uzalo okola guruvnja ki obala. <verse eid="GEN 41:3" /><verse number="4" style="v" sid="GEN 41:4" />Tegani okola gruba hem šuke sa hale okolen eftane šuže hem thule guruvnjen. Tegani o faraon uštino oto sojba.<verse eid="GEN 41:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 41:5" />Kad palem zasuća, dikhlja dujto suno: Efta klasija e đivesere, pherde hem šuže, barjona ine ki jekh stabiljka. <verse eid="GEN 41:5" /><verse number="6" style="v" sid="GEN 41:6" />Palo lende barile avera efta klasija, šuke hem tharde oti istočno barval. <verse eid="GEN 41:6" /><verse number="7" style="v" sid="GEN 41:7" />Tegani okola šuke sa hale okolen eftane pherden hem šužen. Tegani o faraon uštino oto sojba hem halilo da adava inele suno.<verse eid="GEN 41:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 41:8" />Sabale o faraon inele zabrinime, pa bičhalđa palo sa e egipatesere manušen so dikhljarena hem palo mudraci. Vaćerđa lenđe ple sune, ali nijekh olendar na džanđa te vaćeren lese olengoro značenje.<verse eid="GEN 41:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 41:9" />Tegani o glavno peharniko e faraonese phenđa: “Akana setinđum man nesostar so pogrešinđum. <verse eid="GEN 41:9" /><verse number="10" style="v" sid="GEN 41:10" />Jekhvar kad o faraon holjanđa upro ple sluge, man hem e glavnone pekare phandlja ano čher e stražakere narednikosoro. <verse eid="GEN 41:10" /><verse number="11" style="v" sid="GEN 41:11" />So duj džene ani isto rat dikhljam suno, hem svako suno inole plo značenje. <verse eid="GEN 41:11" /><verse number="12" style="v" sid="GEN 41:12" />Adari inele amencar jekh terno čhavo, Jevrejco, sluga e stražakere narednikosoro. Vaćerđam lese amare sune, hem ov vaćerđa amenđe so značinena – svakonese amendar vaćerđa so značini olesoro suno. <verse eid="GEN 41:12" /><verse number="13" style="v" sid="GEN 41:13" />Hem sa ulo baš ađahar sar so protumačinđa amenđe: me injum irime ani mli služba, a okova dujtoi obesime.”<verse eid="GEN 41:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 41:14" />Tegani o faraon bičhalđa palo Josif hem ki sig ande le taro phandlipe. Kad muravđa pe hem kad urjavđa pe, o Josif iklilo anglo faraon.<verse eid="GEN 41:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 41:15" />O faraon phenđa e Josifese: “Dikhljum jekh suno, a niko na džanel te vaćeri maje lesoro značenje. Ali šunđum tuće hem phenena da džane te protumačine o suno kad šuneja le.”<verse eid="GEN 41:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 41:16" />O Josif phenđa: “Nane đi mande, nego o Devel ka del odgovor savo ka smirini e faraone.”<verse eid="GEN 41:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 41:17" />Tegani o faraon phenđa e Josifese: “Ano suno terđovava ine ki obala oti len Nil, <verse eid="GEN 41:17" /><verse number="18" style="v" sid="GEN 41:18" />i otojekhvar taro Nil iklile efta guruvnja, thule hem šuže, hem lelje te han i trska ki obala. <verse eid="GEN 41:18" /><verse number="19" style="v" sid="GEN 41:19" />Palo lende iklile avera efta guruvnja, jadna, but gruba hem šuke. Nikad ano celo Egipat na dikhljum ađahar grubone guruvnjen. <verse eid="GEN 41:19" /><verse number="20" style="v" sid="GEN 41:20" />Tegani o šuke hem o gruba guruvnja sa hale okolen eftane thule guruvnjen, save prva iklile. <verse eid="GEN 41:20" /><verse number="21" style="v" sid="GEN 41:21" />Ali, kad hale len, na pendžardilo lenđe da hale len – hem pana ačhile isto esavke gruba sar angleder. Tegani uštinjum oto sojba.<verse eid="GEN 41:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 41:22" />A dikhljum ano suno hem efta klasija e đivesere, pherde hem šuže, sar barjona ine ki jekh stabiljka. <verse eid="GEN 41:22" /><verse number="23" style="v" sid="GEN 41:23" />Palo lende barile avera efta klasija sane, šuke hem tharde oti istočno barval. <verse eid="GEN 41:23" /><verse number="24" style="v" sid="GEN 41:24" />Tegani okola šuke sa hale okolen eftane šužen. Vaćerđum akava hem okolenđe so dikhljarena, ali nijekh olendar na džanđa adava te objasnini maje.”<verse eid="GEN 41:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 41:25" />Tegani o Josif phenđa e faraonese: “O sune e faraoneserei jekh isto suno. O Devel mothovđa e faraonese so ka ćerel. <verse eid="GEN 41:25" /><verse number="26" style="v" sid="GEN 41:26" />O efta šuže guruvnjai efta berša, hem o efta šuže klasijai efta berša – adavai jekh isto suno. <verse eid="GEN 41:26" /><verse number="27" style="v" sid="GEN 41:27" />O efta šuke hem o gruba guruvnja save iklile palo lende, sar hem o efta bišukar klasija tharde oti istočno barval, oni isto efta berša. Adavai efta berša oto bokhalipe.<verse eid="GEN 41:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 41:28" />Baš sar so phenđum e faraonese: O Devel mothovđa e faraonese so ka ćerel. <verse eid="GEN 41:28" /><verse number="29" style="v" sid="GEN 41:29" />Ače, efta izobilna berša avena ano celo Egipat, <verse eid="GEN 41:29" /><verse number="30" style="v" sid="GEN 41:30" />ali palo olende avena efta berša oto bokhalipe. Tegani sa o izobilje ano Egipat ka ovel bisterdo, adalese so o bokhalipe ka opustošini i phuv. <verse eid="GEN 41:30" /><verse number="31" style="v" sid="GEN 41:31" />Niko naka setini pe e vremestar oto izobilje, adalese so o bokhalipe savo ka avel ka ovel baro. <verse eid="GEN 41:31" /><verse number="32" style="v" sid="GEN 41:32" />A adava so e faraonesoro suno ponovinđa pe, značini da o Devel zorale odlučinđa adava hem da sigate adava ka ćerel. <verse eid="GEN 41:32" /><verse number="33" style="v" sid="GEN 41:33" />Adalese nek o faraon rodel sposobnone hem mudrone manuše hem nek čhivel le te ovel upravniko upreder o Egipat. <verse eid="GEN 41:33" /><verse number="34" style="v" sid="GEN 41:34" />Nek o faraon čhivel nadglednikonen upreder i phuv te čeden o pandžto deo oti žetva ano Egipat dok ovena adala efta izobilna berša. <verse eid="GEN 41:34" /><verse number="35" style="v" sid="GEN 41:35" />Nek sa o hajba čeden ano plodna berša save avena hem nek palo e faraonesoro ovlašćenje čhiven o điv ano dizja hem nek garaven len hajbnase. <verse eid="GEN 41:35" /><verse number="36" style="v" sid="GEN 41:36" />Nek adava hajba ovel rezerva zaki phuv za okola efta bokhale berša save ka oven ano Egipat, te na upropastini o bokhalipe i phuv.”<verse eid="GEN 41:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 41:37" />E Josifesoro predlog sviđinđa pe e faraonese hem sa lesere službenikonenđe.<verse eid="GEN 41:37" /></para>
  <para style="s">O Josif ovela upravitelji upreder o Egipat</para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 41:38" />O faraon pučlja ple službenikonen: “Šaj li te arakha manuše sar soi akava, ana kastei e Devlesoro Duho?”<verse eid="GEN 41:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="GEN 41:39" />Tegani o faraon phenđa e Josifese: “Adalese so o Devel sa akava baš tuće mothovđa, nane niko ađahar sposobno hem mudro sar so injan tu. <verse eid="GEN 41:39" /><verse number="40" style="v" sid="GEN 41:40" />Ka ove upravitelji oti mli palata hem sa mlo narodo ka pokorini pe te naredbenđe. Jedino me, adalese so injum ko prestolje, ka ovav upreder tute.”<verse eid="GEN 41:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="GEN 41:41" />O faraon pana phenđa e Josifese: “Ače, čhivava tut zako upravitelji upreder celo Egipat.”<verse eid="GEN 41:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="GEN 41:42" />Tegani huljavđa i angrustik e pečateja pese oto vas hem čhivđa la e Josifese ko vas. Urjavđa le šeja oto šužo lan, a ki men čhivđa lese zlatno lanco. <verse eid="GEN 41:42" /><verse number="43" style="v" sid="GEN 41:43" />Dinđa le te vozini pe ano kočije odmah palo olesere, hem anglo leste vičinde: “Peren ko kočija!” Ađahar čhivđa le te ovel upravitelji upreder celo Egipat.<verse eid="GEN 41:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="GEN 41:44" />O faraon phenđa e Josifese: “Me injum faraon, ali niko ani celo phuv Egipat nak ćerel ništa bizo to odobrenje.”<verse eid="GEN 41:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="GEN 41:45" />O faraon e Josifese dinđa anav Cofnat Paaneah,<note caller="+" style="f"><char style="fr" closed="false">41,45 </char><char style="fq" closed="false">Cofnat Paaneah</char><char style="ft" closed="false">akavai egipatsko anav savo ko jevrejski zvučini: “Okova kova tumačini o tajne.”</char></note> a dinđa le romnjaće e Osnata, e Potiferesere čhaja, kova inele svešteniko ano Onu. I o Josif prelelja i vlast upreder celo Egipat.<verse eid="GEN 41:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="GEN 41:46" />E Josife inele trijanda berš kad đerdinđa ani služba koro faraon, o caro e Egipatesoro. Ov dželo oto faraon hem lelja te putujini ko celo Egipat. <verse eid="GEN 41:46" /><verse number="47" style="v" sid="GEN 41:47" />A zako efta berša oto izobilje, i phuv bijanđa but. <verse eid="GEN 41:47" /><verse number="48" style="v" sid="GEN 41:48" />Ano adala efta berša oto izobilje save ule ano Egipat, o Josif čedinđa hajbnase hem čhivđa adava ano dizja. Ani svako diz čhivđa o hajba oto polja save inele ani okolina. <verse eid="GEN 41:48" /><verse number="49" style="v" sid="GEN 41:49" />Ađahar o Josif čedinđa edobor điv sar i pošik e moresiri, pa prestaninđa hem te merini le više, adalese so inele edobor but da našti ine te merini pe.<verse eid="GEN 41:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="GEN 41:50" />Angleder so te aven o bokhale berša, i Osnata, i čhaj e Potifereseri kova inele svešteniko ano Onu, bijanđa e Josifese duje čhaven.<verse eid="GEN 41:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="GEN 41:51" />Ple prvone bijande čhavese o Josif dinđa anav Manasija,<note caller="+" style="f"><char style="fr" closed="false">41,51 </char><char style="fq" closed="false">Manasija </char><char style="ft" closed="false">zvučini sar: “te bistrel pe.”</char></note> adalese so phenđa: “O Devel ćerđa te bistrav sa mli muka hem sa mle dadesere čherutnen.”<verse eid="GEN 41:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="GEN 41:52" />Ple dujtone čhavese dinđa anav Efrem,<note caller="+" style="f"><char style="fr" closed="false">41,52 </char><char style="fq" closed="false">Efrem </char><char style="ft" closed="false">zvučini sar: “dvostruko plodno.” </char></note> vaćerindoj: “O Devel ćerđa man te ovav plodno ani phuv oti mli patnja.”<verse eid="GEN 41:52" /></para>
  <para style="s">O bokhalipe</para>
  <para style="p">
    <verse number="53" style="v" sid="GEN 41:53" />Kad završinde pe okola efta berša oto izobilje save inele ano Egipat, <verse eid="GEN 41:53" /><verse number="54" style="v" sid="GEN 41:54" />lelje te aven o efta berša oto bokhalipe, baš sar so o Josif hem phenđa. Ano sa o phuvja inele bokhalipe, ali ano celo Egipat inele hajbnase. <verse eid="GEN 41:54" /><verse number="55" style="v" sid="GEN 41:55" />A kad alo o bokhalipe hem ano Egipat, o narodo lelja te rodel e faraonestar hajbnase.</para>
  <para style="p" vid="GEN 41:55">Tegani o faraon phenđa e Egipćanconenđe: “Džan koro Josif hem ćeren ađahar sar so ka phenel tumenđe.”<verse eid="GEN 41:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="GEN 41:56" />Kad o bokhalipe širinđa pe ki celo phuv, o Josif phravđa o thana kaj čhivđa ine o điv hem lelja te biknel o điv e Egipćanconenđe, adalese so ano Egipat inele baro bokhalipe. <verse eid="GEN 41:56" /><verse number="57" style="v" sid="GEN 41:57" />A taro celo sveto avena ine ano Egipat te činen điv e Josifestar, adalese so ano celo sveto inele baro bokhalipe.<verse eid="GEN 41:57" /></para>
  <chapter eid="GEN 41" />
  <chapter number="42" style="c" sid="GEN 42" />
  <para style="s">E Josifesere phralja avena ano Egipat</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 42:1" />Kad o Jakov dodžanđa da ano Egipat isi điv, phenđa ple čhavenđe: “Sose samo bešena hem dikhena jekh ano avereste?”<verse eid="GEN 42:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 42:2" />Onda phenđa: “Šunđum da ano Egipat isi điv. Džan adari hem činen le amenđe, te šaj preživina, a na te mera oto bokhalipe.”<verse eid="GEN 42:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 42:3" />Tegani e Josifesere deš phralja džele ano Egipat te činen điv. <verse eid="GEN 42:3" /><verse number="4" style="v" sid="GEN 42:4" />Ali e Venijamine, e Josifesere phrale, o Jakov na bičhalđa olesere phraljencar adalese so darandilo te na arakhi le nesavo bišukaripe. <verse eid="GEN 42:4" /><verse number="5" style="v" sid="GEN 42:5" />Ađahar e Izraelesere čhave arakhle pe maškaro okolende kola džele te činen điv, adalese so hem ano Hanaan inele bokhalipe.<verse eid="GEN 42:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 42:6" />O Josif, kova inele upravitelji ano Egipat, biknela ine o điv sa e narodose ani phuv.</para>
  <para style="p" vid="GEN 42:6">Lesere phralja ale anglo leste hem pokloninde pe lese mujeja đi phuv. <verse eid="GEN 42:6" /><verse number="7" style="v" sid="GEN 42:7" />Kad o Josif dikhlja ple phraljen, pendžarđa len, ali premalo lende inele sar abanđija hem vaćerđa olencar oštro.</para>
  <para style="p" vid="GEN 42:7">I pučlja len: “Kotar injen?”</para>
  <para style="p" vid="GEN 42:7">A on phende lese: “Amen injam oto Hanaan. Aljam te čina hajbnase.”<verse eid="GEN 42:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 42:8" />Iako o Josif pendžarđa ple phraljen, on ole na pendžarde. <verse eid="GEN 42:8" /><verse number="9" style="v" sid="GEN 42:9" />Tegani o Josif setinđa pe ple sunendar save dikhlja olendar,</para>
  <para style="p" vid="GEN 42:9">pa phenđa lenđe: “Tumen injen špijunja! Aljen te dikhen kaj o bizorale thana akala phuvjakere!”<verse eid="GEN 42:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 42:10" />A on phende: “Na, gospodarona! Amen, te sluge, aljam te čina hajbnase. <verse eid="GEN 42:10" /><verse number="11" style="v" sid="GEN 42:11" />Sare amen injam čhave jekhe manušesere. Amen, te sluge, injam poštena manuša, a na špijunja.”<verse eid="GEN 42:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 42:12" />A ov phenđa lenđe: “Na! Tumen aljen te dikhen kaj o bizorale thana akala phuvjakere!”<verse eid="GEN 42:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 42:13" />A on phende: “Amen, te sluge, injamle dešu duj phralja, čhave jekhe manušesere taro Hanaan. O najtikneder ačhilo amare dadeja, a jekh phral amendar mulo.”<verse eid="GEN 42:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 42:14" />O Josif phenđa: “Ađahari sar so phenđum tumenđe: tumen injen špijunja! <verse eid="GEN 42:14" /><verse number="15" style="v" sid="GEN 42:15" />Ađahar ka proverinav tumen: Hava sovli e faraonesere dživdipnaja, naka džan akatar ako tumaro najtikneder phral na avela akari. <verse eid="GEN 42:15" /><verse number="16" style="v" sid="GEN 42:16" />Bičhalen jekhe tumendar te anel tumare phrale. A tumen avera ka ačhon ano phandlipe hem ka oven pučle te proverini pe da li vaćerena čačipe ili na. Te na vaćerena o čačipe, hava sovli e faraonesere dživdipnaja, tumen injen špijunja!”<verse eid="GEN 42:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 42:17" />I čhivđa sarijen olen ko phandlipe ko trin dive.<verse eid="GEN 42:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 42:18" />O trito dive o Josif phenđa lenđe: “Me injum manuš kova darala oto Devel. Adalese ćeren akava so phenava hem ka ačhoven dživde. <verse eid="GEN 42:18" /><verse number="19" style="v" sid="GEN 42:19" />Te injen poštena manuša, nek ačhol jekh tumendar ano phandlipe, a avera nek legaren o điv tumare čherutnenđe kolai ano bokhalipe. <verse eid="GEN 42:19" /><verse number="20" style="v" sid="GEN 42:20" />Tegani anen maje tumare najtiknedere phrale, hem ađahar te potvrdini pe o čačikanipe oto tumare lafija hem te na meren.”</para>
  <para style="p" vid="GEN 42:20">Hem on složinde pe adaleja.<verse eid="GEN 42:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 42:21" />Tegani on phende jekh averese: “Čače injam kriva zbog amaro phral. Dikhljam lesiri patnja dok molinđa amen zaki milost, ali amen na šunđam le. Adalese hem arakhlja amen akaja nevolja.”<verse eid="GEN 42:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 42:22" />A o Ruvim phenđa: “Zar na phenđum tumenđe te na grešinen protiv o čhavoro. Ali tumen na mangljen te šunen man. Ače, akana rodela pe te položina računi zako lesoro rat.”<verse eid="GEN 42:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 42:23" />Na džande da o Josif razumini len, adalese so oleja vaćerde prekalo tumači. <verse eid="GEN 42:23" /><verse number="24" style="v" sid="GEN 42:24" />Tegani o Josif cidinđa pe olendar hem runđa. Kad irinđa pe, palem vaćerđa olencar. Tegani izdvojinđa e Simeone hem naredinđa te phanden le anglo lende.<verse eid="GEN 42:24" /></para>
  <para style="s">E Josifesere phralja irinena pe ano Hanaan</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 42:25" />Tegani o Josif naredinđa te pheren lengere džaci điveja, svakonese ano džako te čhiven lesere pare hem te den len sa so valjani lenđe zako drom. Ađahar hem inele ćerdo. <verse eid="GEN 42:25" /><verse number="26" style="v" sid="GEN 42:26" />On čhivde o điv upro pumare hera hem džele.<verse eid="GEN 42:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 42:27" />Kad ačhile ko than kaj valjande te nakhaven i rat, jekh oto phralja phravđa plo džako te del ple herese te hal hem otojekhvar dikhlja ple pare ano džako.<verse eid="GEN 42:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 42:28" />Tegani ov phenđa ple phraljenđe: “Mle parei irime! Ače, akatei ano mlo ano džako!”</para>
  <para style="p" vid="GEN 42:28">A oti dar lengoro vilo ačhilo. Pa tresindoj, phende jekh averese: “So ćerđa amenđe akava o Devel?”<verse eid="GEN 42:28" /></para>
  <para style="s">O phralja anena izveštaj e Jakovese</para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 42:29" />Kad resle koro plo dad o Jakov ano Hanaan, vaćerde lese sa so inele.<verse eid="GEN 42:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 42:30" />Phende: “O manuš kovai gospodari oti okoja phuv amencar oštro vaćerđa hem optužinđa amen da injam špijunja. <verse eid="GEN 42:30" /><verse number="31" style="v" sid="GEN 42:31" />Ali amen phenđam lese: ‘Amen injam poštena manuša, na injam špijunja. <verse eid="GEN 42:31" /><verse number="32" style="v" sid="GEN 42:32" />Amen injamle dešu duj phralja, čhave oto jekh dad. Jekh phral amendar mulo, a o najtiknederi akana amare dadeja ano Hanaan.’ <verse eid="GEN 42:32" /><verse number="33" style="v" sid="GEN 42:33" />Tegani o gospodari e phuvjakoro phenđa: ‘Ađahar ka džanav da injen poštena manuša: Nek ačhol jekh tumendar ano phandlipe, a avera nek legaren o điv tumare čherutnenđe kolai ano bokhalipe, pa džan. <verse eid="GEN 42:33" /><verse number="34" style="v" sid="GEN 42:34" />Onda anen maje tumare najtiknedere phrale, hem ka džanav da na injen špijunja, nego poštena manuša. Tegani ka irinav tumenđe tumare phrale hem ka šaj slobodno te kretinen tumen ani phuv.’”<verse eid="GEN 42:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 42:35" />Sar čučarena ine pumare džaci, svako arakhlja pli kesa e parencar. Kad dikhle on hem lengoro dad o kese e parencar, darandile.<verse eid="GEN 42:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 42:36" />Lengoro dad o Jakov phenđa lenđe: “Zbog tumende ka ačhovav bizo čhave. Nane više o Josif, nane ni o Simeon, a akana mangena te legaren hem e Venijamine. Sa irinđa pe protiv mande!”<verse eid="GEN 42:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 42:37" />Tegani o Ruvim phenđa ple dadese: “Mudar mle duje čhaven te na irinđum le tuće palal. Muk le maje ko vasta, hem me ka anav le tuće palal.”<verse eid="GEN 42:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 42:38" />A o Jakov phenđa: “Mlo čhavo naka džal tumencar, adalese soi lesoro phral mulo hem samo pana ov ačhilo. Ako desini pe lese nesavo bišukaripe ko drom kaj džana, ka ćeren man ko purane berša rovavne ano Šeol te džav.”<verse eid="GEN 42:38" /></para>
  <chapter eid="GEN 42" />
  <chapter number="43" style="c" sid="GEN 43" />
  <para style="s">E Josifesere phralja irinena pe ano Egipat</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 43:1" />A o bokhalipe ani phuv Hanaan inele sa po baro.<verse eid="GEN 43:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 43:2" />Kad hale o điv savo ande taro Egipat, lengoro dad phenđa lenđe: “Irinen tumen palal ano Egipat hem činen amenđe pana hari hajbnase.”<verse eid="GEN 43:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 43:3" />Ali o Juda phenđa lese: “Okova manuš ozbiljno upozorinđa amen: ‘Ma te ikljoven maje anglo jaćha ako tumaro phral nane tumencar.’ <verse eid="GEN 43:3" /><verse number="4" style="v" sid="GEN 43:4" />Te mukljan te džal amaro phral amencar, amen ka dža hem ka čina će hajbnase. <verse eid="GEN 43:4" /><verse number="5" style="v" sid="GEN 43:5" />Ali te na bičhalđan le amencar, amen naka dža, adalese so okova manuš amenđe phenđa: ‘Ma te ikljoven maje anglo jaćha ako tumaro phral nane tumencar.’ ”<verse eid="GEN 43:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 43:6" />Tegani o Izrael phenđa: “Sose čhivđen man ki akaja nevolja vaćerindoj adale manušese da isi tumen pana jekh phral?”<verse eid="GEN 43:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 43:7" />Lesere čhave phende lese: “O manuš sa detaljno ispitujinđa amen amendar hem amara porodicatar. ‘Dživdo li pana tumaro dad?’, ‘Isi li tumen pana nesavo phral?’ A amen samo odgovorinđam lese ko okova so pučlja. Kotar amen šaj ine te džana da ov ka phenel amenđe: ‘Anen tumare phrale?’ ”<verse eid="GEN 43:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 43:8" />Tegani o Juda phenđa ple dadese e Izraelese: “Bičhal e čhavore mancar, i odmah ka la te dža, te šaj preživina hem amen, hem tu, hem amare čhavore, a na te mera oto bokhalipe. <verse eid="GEN 43:8" /><verse number="9" style="v" sid="GEN 43:9" />Me garantujinava će olese, man dikh sar odgovornone olese. Te na irinava le tuće palal, celo mlo dživdipe ka ovav krivo angla tute. <verse eid="GEN 43:9" /><verse number="10" style="v" sid="GEN 43:10" />Te na odugovlačina ine, đi akana duj puti ka irina amen ine.”<verse eid="GEN 43:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 43:11" />Tegani lengoro dad o Izrael phenđa: “Ako mora ađahar te ovel, onda ćeren akava: Čhiven ano torbe o najšukar plodija oti akaja phuv hem legaren len adale manušese sar daro: hari balsam, hari avđin, mirisija hem smirna, pistaćija hem bademija. <verse eid="GEN 43:11" /><verse number="12" style="v" sid="GEN 43:12" />Hem legaren tumencar duplo više pare, adalese so mora te irinen o pare save inele čhivde tumenđe ano džaci. Šaj adava inele nesavi greška. <verse eid="GEN 43:12" /><verse number="13" style="v" sid="GEN 43:13" />Legaren hem tumare phrale tumencar hem odmah irinen tumen koro adava manuš. <verse eid="GEN 43:13" /><verse number="14" style="v" sid="GEN 43:14" />O Devel, kova sa šaj, nek ćerel adava manuš te smilujini pe tumenđe, pa te mukel hem tumare dujtone phrale hem e Venijamine tumencar te irinen pe. A me, ako valjani te ačhovav bizo čhave, nek ačhovav.”<verse eid="GEN 43:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 43:15" />Ađahar o phralja lelje pumencar o darija hem duplo više pare, legarde e Venijamine, pa odmah džele ano Egipat hem terdine anglo Josif.<verse eid="GEN 43:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 43:16" />Kad o Josif dikhlja e Venijamine olencar, phenđa ple čheresere upravnikose: “Legar akale manušen ano mlo čher, čhin jekha životinja hem spremin la, adalese so ko podne ka han ručko mancar.” <verse eid="GEN 43:16" /><verse number="17" style="v" sid="GEN 43:17" />I ov ćerđa ađahar sar so phenđa lese o Josif hem legarđa len e Josifese ano čher. <verse eid="GEN 43:17" /><verse number="18" style="v" sid="GEN 43:18" />On darandile kad legarde len e Josifese ano čher.</para>
  <para style="p" vid="GEN 43:18">Mislinde: “Ande amen akate zbog o pare save čhivde amenđe ine ano džaci o prvo puti. Ka napadinen amen, ka prelen amen hem ka ćeren amendar robonen, pa ka len amare heren.”<verse eid="GEN 43:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 43:19" />On ale koro upravniko e Josifesere čheresoro hem lelje te vaćeren oleja anglo ulaz e čheresoro,<verse eid="GEN 43:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 43:20" />hem phende lese: “O, gospodarona! Amen već aljam jekhvar te čina hajbnase. <verse eid="GEN 43:20" /><verse number="21" style="v" sid="GEN 43:21" />Ali kad aljam ko than kaj valjanđam te nakhava i rat, otojekhvar, svako amendar arakhlja ple pare pese ano džako, edobor kobor inele o iznos. Akana adala pare anđam amencar. <verse eid="GEN 43:21" /><verse number="22" style="v" sid="GEN 43:22" />A anđam hem pana pare amencar te čina palem hajbnase. Na džana ko čhivđa amenđe amare pare ano džaci.”<verse eid="GEN 43:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 43:23" />O sluga phenđa lenđe: “Ma oven uznemirime. Ma daran. Tumaro Devel, o Devel tumare dadesoro, čhivđa o blago ano tumare džaci. Tumare pare resle đi mande.”</para>
  <para style="p" vid="GEN 43:23">Tegani ikalđa lenđe e Simeone.<verse eid="GEN 43:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 43:24" />Palo adava o upravniko e čheresoro legarđa len ano e Josifesoro čher, dinđa len pani te thoven pumare pre, a lengere herenđe dinđa te han. <verse eid="GEN 43:24" /><verse number="25" style="v" sid="GEN 43:25" />On pripreminde o darija e Josifese kad ka avel ano podne, adalese so šunde da adathe ka han maro. <verse eid="GEN 43:25" /><verse number="26" style="v" sid="GEN 43:26" />Kad o Josif alo čhere, on dinde le o darija save ande ano čher hem pokloninde pe lese mujeja đi phuv.<verse eid="GEN 43:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 43:27" />Ov pučlja len sari on, pa phenđa: “Sari tumaro purano dad, kolestar vaćerđen maje? Pana li dživdo?”<verse eid="GEN 43:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 43:28" />On phende lese: “To sluga, amaro dad, panai dživdo hem sasto.” Pa pokloninde pe lese mujeja đi phuv.<verse eid="GEN 43:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 43:29" />O Josif šukar dikhlja len hem maškaro lende dikhlja e Venijamine, pla dajakere čhave, pa pučlja: “Akava li tumaro najtikneder phral, okova kolestar vaćerđen maje?”</para>
  <para style="p" vid="GEN 43:29">Tegani phenđa: “Nek o Devel ovel milostivno premalo tute, mlo čhavo.”<verse eid="GEN 43:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 43:30" />Tegani o Josif oto jekhvar iklilo avri rodindoj kaj te rovel, adalese so lesoro vilo inele pherdo kad dikhlja ple phrale. Đerdinđa ani jekh soba hem adari runđa.<verse eid="GEN 43:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 43:31" />Kad thovđa plo muj, iklilo, smirinđa pe hem phenđa: “Čhiven te hal pe.”<verse eid="GEN 43:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 43:32" />Ole poslužinde posebno, lesere phraljen posebno, hem o Egipćanja kola oleja hale posebno. O Egipćanja našti ine te han e Jevrejencar, adalese so bi adava ovela lenđe odvratno. <verse eid="GEN 43:32" /><verse number="33" style="v" sid="GEN 43:33" />O phralja inele čhivde te bešen anglo leste palo pumare berša, oto najphureder đi o najtikneder. I zbog adava dikhle jekh ano avereste začudime. <verse eid="GEN 43:33" /><verse number="34" style="v" sid="GEN 43:34" />Kad ande lenđe o hajba oto e Josifesoro astali, o hajba e Venijaminesoro inele pandž puti po baro taro sa averengoro. Ađahar e Josifeja hale hem edobor pile da matile.<verse eid="GEN 43:34" /></para>
  <chapter eid="GEN 43" />
  <chapter number="44" style="c" sid="GEN 44" />
  <para style="s">E Josifesiri srebrno čaša</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 44:1" />O Josif naredinđa ple čheresere upravnikose: “Pher akale manušengere džaci hajbnaja, kobor god šaj te legaren pumencar, hem svakonese upral ano džako čhiv lesere pare. <verse eid="GEN 44:1" /><verse number="2" style="v" sid="GEN 44:2" />A mli bari čaša, okoja i srebrno, čhiv upral ano džako e najtiknederesoro, zajedno e parencar savencar platinđa o điv.”</para>
  <para style="p" vid="GEN 44:2">I okova manuš ćerđa ađahar sar so o Josif phenđa lese.<verse eid="GEN 44:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 44:3" />Kad dislilo, spreminde e phraljen hem lengere heren zako drom.<verse eid="GEN 44:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 44:4" />Sar pana na džele dur oti diz, o Josif phenđa ple čheresere upravnikose: “Odmah te dža palo okola manuša, pa kad ka rese len, phen lenđe: ‘Sose irinena bišukaripe zako šukaripe? Sose čorđen i srebrno bari čaša mle gospodaresiri? <verse eid="GEN 44:4" /><verse number="5" style="v" sid="GEN 44:5" />Adajai čaša savatar pijela mlo gospodari hem savi služini lese te dikhljari? Ćerđen bišukaripe!’ ”<verse eid="GEN 44:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 44:6" />Kad reslja len o upravniko, ov phenđa lenđe sa akala lafija, <verse eid="GEN 44:6" /><verse number="7" style="v" sid="GEN 44:7" />a on ko adava phende lese: “Sose ađahar vaćereja amencar, gospodarona? Dur adalestar da amen, te sluge, ka ćera ađahar nešto! <verse eid="GEN 44:7" /><verse number="8" style="v" sid="GEN 44:8" />Čak taro Hanaan irinđam će hem o pare save arakhljam upral ano amare džaci. Sose bi čoraja onda o srebro ili o zlato taro čher te gospodaresoro? <verse eid="GEN 44:8" /><verse number="9" style="v" sid="GEN 44:9" />Te nekaste amendar arakhlja pe adava, koro te sluge, adale mudaren, a amen avera ka ova te robija, gospodarona.”<verse eid="GEN 44:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 44:10" />O manuš phenđa lenđe: “Šukar vaćerena. Ali nek ovel ađahar: Kora kaste ka arakhi pe adaja čaša, ov ka ovel mlo robo, a avera ka oven slobodna.”<verse eid="GEN 44:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 44:11" />Tegani svako olendar ki sig muklja plo džako ki phuv hem phravđa le. <verse eid="GEN 44:11" /><verse number="12" style="v" sid="GEN 44:12" />O manuš lelja te rodel ano džaci počindoj oto najphureder phral, a završindoj koro najtikneder. I čaša arakhlja pe ano džako e Venijaminesoro. <verse eid="GEN 44:12" /><verse number="13" style="v" sid="GEN 44:13" />Ko adava on pharavde ple šeja, pa sare natovarinde pumare heren hem irinde pe ani diz.<verse eid="GEN 44:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 44:14" />Kad o Juda hem lesere phralja đerdinde ano čher e Josifesoro, ov pana inele adari.</para>
  <para style="p" vid="GEN 44:14">On pele mujeja đi phuv anglo leste, <verse eid="GEN 44:14" /><verse number="15" style="v" sid="GEN 44:15" />a ov phenđa lenđe: “So ćerđen adava? Zar na džanen da manuš sar mande, šaj sa te dodžanel ađahar so ka dikhljari?”<verse eid="GEN 44:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 44:16" />O Juda phenđa: “So te phena će, gospodarona? So te phena? Sar te opravdina amen? O Devel otkrijinđa i krivica amari, te slugengiri. Amen akana injam te robija, gospodarona – amen hem okova kora kaste arakhlja pe ti čaša.”<verse eid="GEN 44:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 44:17" />Ali o Josif phenđa: “Dur adalestar da me nešto ađahar ka ćerav! Samo o manuš kora kaste arakhlja pe mli čaša ka ovel robo, a tumen avera šaj ano mir te irinen tumen koro tumaro dad.”<verse eid="GEN 44:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 44:18" />Tegani o Juda alo paše uzalo leste hem phenđa: “Molinava tut! O gospodarona, muk maje, te slugase, te phenav će nešto hem ma holjan upra mande, upro to sluga, adalese so tu injan sar o faraon. <verse eid="GEN 44:18" /><verse number="19" style="v" sid="GEN 44:19" />Tu, gospodarona, pučljan amen, te slugen: ‘Isi tumen li dad ili aver nesavo phral?’ <verse eid="GEN 44:19" /><verse number="20" style="v" sid="GEN 44:20" />A amen phenđam tuće, gospodarona: ‘Isi amen purano dad, a ole isi pana jekh čhavo, ovi najtikneder kova bijandilo lese ano phuripe. Lesoro phral mulo hem samo ov ačhilo oto čhave ple dajakere. O dad but volini le.’ <verse eid="GEN 44:20" /><verse number="21" style="v" sid="GEN 44:21" />Tu onda phenđan amenđe, te slugenđe: ‘Anen maje ole, te dikhav le mle jaćhencar.’ <verse eid="GEN 44:21" /><verse number="22" style="v" sid="GEN 44:22" />A amen gospodarona, tuće phenđam: ‘O čhavoro našti te ačhaj ple dade, adalese so te ačhavđa le, o dad ka merel.’ <verse eid="GEN 44:22" /><verse number="23" style="v" sid="GEN 44:23" />Ali tu phenđan amenđe, te slugenđe: ‘Te tumaro najtikneder phral na avela tumencar, ma ikljoven maje anglo jaćha!’ <verse eid="GEN 44:23" /><verse number="24" style="v" sid="GEN 44:24" />Kad irinđam amen te slugase, mle dadese, phenđam lese so tu, gospodarona, phenđan. <verse eid="GEN 44:24" /><verse number="25" style="v" sid="GEN 44:25" />Palo nesavo vreme amaro dad phenđa amenđe: ‘Irinen tumen hem činen amenđe pana hari hajbnase’, <verse eid="GEN 44:25" /><verse number="26" style="v" sid="GEN 44:26" />a amen phenđam: ‘Našti te irina amen adari. Šaj te dža samo ako amaro najtikneder phral džala amencar, adalese so našti okole manušese te ikljova anglo jaćha bizo amaro najtikneder phral.’ <verse eid="GEN 44:26" /><verse number="27" style="v" sid="GEN 44:27" />To sluga, mlo dad, phenđa amenđe: ‘Džanen da mli romni bijanđa duje čhaven. <verse eid="GEN 44:27" /><verse number="28" style="v" sid="GEN 44:28" />Jekh dželo mandar, pa me phenđum: “Sigurnoi čhinđerdo ko kotora”, i nikad više na dikhljum le. <verse eid="GEN 44:28" /><verse number="29" style="v" sid="GEN 44:29" />A te legarđen hem akale, pa arakhi le nesavo bišukaripe, ka ćeren man ko purane berša rovavne ano Šeol te džav.’<verse eid="GEN 44:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 44:30" />Te akana me irinđum koro to sluga, koro mlo dad, pa ov, kovai but povezime akale čhavoreja, <verse eid="GEN 44:30" /><verse number="31" style="v" sid="GEN 44:31" />dikhela da o čhavoro nane amencar, ka merel. Ađahar amen, te sluge, ka ćera amare dade ko purane berša rovavne ano Šeol te džal. <verse eid="GEN 44:31" /><verse number="32" style="v" sid="GEN 44:32" />Me, to sluga, dinđum garancija mle dadese zako akava čhavoro, vaćerindoj: ‘Te me na anđum le tuće palal celo dživdipe ka ovav krivo angla tute!’ <verse eid="GEN 44:32" /><verse number="33" style="v" sid="GEN 44:33" />Adalese, gospodarona, muk me, to sluga, te ačhovav akate umesto o čhavoro sar to robo, a tu muk e čhavore te irini pe ple phraljencar. <verse eid="GEN 44:33" /><verse number="34" style="v" sid="GEN 44:34" />Adalese so, sar te irinav man koro mlo dad ako o čhavoro nane mancar? Naka šaj te dikhav o pharipe savo bi arakhi mle dade.”<verse eid="GEN 44:34" /></para>
  <chapter eid="GEN 44" />
  <chapter number="45" style="c" sid="GEN 45" />
  <para style="s">O Josif mothoj pe ple phraljenđe</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 45:1" />O Josif našti ine više te uzdržini pe anglo ple sluge, pa vičinđa: “Nek ikljon sare avri!” Ađahar niko na inele e Josifeja kad mothovđa ple phraljenđe koi ov. <verse eid="GEN 45:1" /><verse number="2" style="v" sid="GEN 45:2" />Ali edobor glasno runđa da šunde le hem o Egipćanja, pa zako adava dodžanđa celo palata e faraonesiri.<verse eid="GEN 45:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 45:3" />O Josif phenđa ple phraljenđe: “Me injum o Josif! Pana li dživdo mlo dad?”</para>
  <para style="p" vid="GEN 45:3">Ali lesere phralja edobor darandile da našti ine te odgovorinen lese.<verse eid="GEN 45:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 45:4" />Tegani o Josif phenđa: “Aven po paše.”</para>
  <para style="p" vid="GEN 45:4">Kad ale po paše, phenđa: “Me injum tumaro phral o Josif, okova kole tumen bikninđen ano Egipat. <verse eid="GEN 45:4" /><verse number="5" style="v" sid="GEN 45:5" />Ali ma oven uznemirime hem ma krivinen tumen so bikninđen man akate, adalese so o Devel bičhalđa man angla tumende te sačuvinen pe o dživdipa e manušengere. <verse eid="GEN 45:5" /><verse number="6" style="v" sid="GEN 45:6" />Već duj berš o bokhalipe vladini ani phuv, a pana pandž berš naka ovel ni haniba ni žetva. <verse eid="GEN 45:6" /><verse number="7" style="v" sid="GEN 45:7" />O Devel bičhalđa man angla tumende, te šaj prekalo baro izbavljenje te spasinav tumare dživdipa hem te ovel tumen potomstvo ki phuv. <verse eid="GEN 45:7" /><verse number="8" style="v" sid="GEN 45:8" />Adalese, na bičhalđen man tumen akate, nego o Devel. Ov čhivđa man te ovav e faraonesoro najbaro službeniko, te ovav gospodari upro celo čher e faraonesoro hem vladari upro celo Egipat.<verse eid="GEN 45:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 45:9" />A akana siđaren palal koro mlo dad hem phenen lese: ‘To čhavo o Josif phenela ađahar: O Devel čhivđa man te ovav gospodari upro celo Egipat. Ava kora mande bizo te misline tut.<verse eid="GEN 45:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 45:10" />Šaj te živine ano gošensko krajo hem ka ove maje paše – tu, te čhave hem te unuci, ti sitno hem ti krupno stoka hem sa so isi tut. <verse eid="GEN 45:10" /><verse number="11" style="v" sid="GEN 45:11" />Me adari ka brininav man tutar, adalese so avena pana pandž berša oto bokhalipe. Ađahar naka ačhove čororo ni tu, ni te čherutne, niti sa soi klo.’<verse eid="GEN 45:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 45:12" />Ače, dikhen tumare jaćhencar, sar so dikhela hem mlo phral o Venijamin, da me čače injum o Josif. <verse eid="GEN 45:12" /><verse number="13" style="v" sid="GEN 45:13" />Vaćeren mle dadese oti čast savi maje mothovdi ano Egipat hem oto sa so dikhljen. Hem sig anen mle dade akari!”<verse eid="GEN 45:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 45:14" />Tegani zagrlinđa ple phrale e Venijamine hem runđa, hem o Venijamin runđa ani lesiri angali. <verse eid="GEN 45:14" /><verse number="15" style="v" sid="GEN 45:15" />Tegani rundoj zagrlinđa hem čumudinđa sa ple phraljen. Palo adava lesere phralja vaćerde oleja.<verse eid="GEN 45:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 45:16" />Kad dodžanđa pe ani palata e faraonesiri da ale e Josifesere phralja, o faraon hem lesere službenici inele radosna.<verse eid="GEN 45:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 45:17" />O faraon phenđa e Josifese: “Phen te phraljenđe: ‘Ćeren ađahar: Natovarinen tumare životinjen e hajbnaja, pa ki sig džan ano Hanaan. <verse eid="GEN 45:17" /><verse number="18" style="v" sid="GEN 45:18" />Tegani anen tumare dade hem tumara porodica mande, a me ka dav tumen najšukar phuv ano Egipat, pa ka uživinen ano obilje akala phuvjakoro.’<verse eid="GEN 45:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 45:19" />A naredini pe će hem akava te phene lenđe: ‘Ćeren ađahar: Len tumenđe nekobor kočije taro Egipat tumare čhavorenđe hem romnjenđe, pa len tumare dade hem aven akate. <verse eid="GEN 45:19" /><verse number="20" style="v" sid="GEN 45:20" />Ma te žalinen zako tumare stvarija so ka ačhaven, adalese so okova soi najšukar ano celo Egipat ka ovel tumaro.’ ”<verse eid="GEN 45:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 45:21" />I o čhave e Izraelesere ćerde ađahar. O Josif dinđa len kočije, sar so o faraon naredinđa, hem hajba zako drom. <verse eid="GEN 45:21" /><verse number="22" style="v" sid="GEN 45:22" />Svakonese olendar dinđa neve šeja, a e Venijaminese dinđa trišel srebrnjaci hem pandž neve šeja. <verse eid="GEN 45:22" /><verse number="23" style="v" sid="GEN 45:23" />A akava bičhalđa ple dadese: deš hera natovarime okova najšukar so isi ano Egipat hem deš hernja natovarime điveja, marencar hem namirnicencar zako lesoro drom.<verse eid="GEN 45:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 45:24" />Ađahar bičhalđa ple phraljen hem ko pođiba phenđa lenđe: “Ma te svađinen tumen odrumal!”<verse eid="GEN 45:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 45:25" />Ađahar on pođinde taro Egipat hem resle koro plo dad o Jakov ano Hanaan.<verse eid="GEN 45:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 45:26" />Tegani phende lese: “O Josif dživdo! Hem vladini upro celo Egipat!” O Jakov šokirinđa pe kad šunđa hem na verujinđa lenđe. <verse eid="GEN 45:26" /><verse number="27" style="v" sid="GEN 45:27" />Ali, kad vaćerde lese sa so o Josif phenđa lenđe hem kad dikhlja o kočije save o Josif bičhalđa te legaren le, lengoro dad o Jakov dživdilo.<verse eid="GEN 45:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 45:28" />Tegani o Izrael phenđa: “Dovoljno maje samo adava soi mlo čhavo o Josif dživdo! Ka džav te dikhav le angleder nego so te merav.”<verse eid="GEN 45:28" /></para>
  <chapter eid="GEN 45" />
  <chapter number="46" style="c" sid="GEN 46" />
  <para style="s">O Jakov džala ano Egipat</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 46:1" />Ađahar o Izrael lelja te džal ko drom sa okoleja so inole. Kad reslo đi i Beer Ševa, prinosinđa žrtva ple dadesere, e Isaakesere Devlese.<verse eid="GEN 46:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 46:2" />O Devel prekali rat alo ani vizija e Izraelese hem vičinđa le: “Jakove! Jakove!”</para>
  <para style="p" vid="GEN 46:2">A ov phenđa lese: “Akate injum!”<verse eid="GEN 46:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 46:3" />O Devel phenđa lese: “Me injum o Devel, o Devel te dadesoro. Ma dara te dža ano Egipat, adalese so adari tutar ka ćerav bare narodo. <verse eid="GEN 46:3" /><verse number="4" style="v" sid="GEN 46:4" />Ka džav tuja ano Egipat hem me ka irinav tut palem akari palal. A tu kad ka mere, o Josif ple vasteja ka phandel te jaćha.”<verse eid="GEN 46:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 46:5" />Palo adava o Jakov dželo tari Beer Ševa. Lesere čhave ole, zajedno pumare romnjencar hem e čhavorencar, vozinde ano kočije save o faraon bičhalđa lenđe palo lende. <verse eid="GEN 46:5" /><verse number="6" style="v" sid="GEN 46:6" />Pumencar legarde sa pumara stoka hem legarde pumencar sa o barvalipe so stekninde ano Hanaan, pa o Jakov hem sa lesoro potomstvo džele ano Egipat. <verse eid="GEN 46:6" /><verse number="7" style="v" sid="GEN 46:7" />Ov ano Egipat legarđa ple čhaven hem ple unukonen, ple čhajen hem ple unuken – celo plo potomstvo.<verse eid="GEN 46:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 46:8" />Akavai o anava e Izraelconengoro – e Jakovesoro hem lesere potomkonengoro – kola džele ano Egipat:</para>
  <para style="b" vid="GEN 46:8" />
  <para style="li" vid="GEN 46:8">O Ruvim, e Jakovesoro prvobijando čhavo. <verse eid="GEN 46:8" /><verse number="9" style="v" sid="GEN 46:9" />E Ruvimesere čhavei:</para>
  <para style="li" vid="GEN 46:9">o Hanoh, o Palu, o Esrom hem o Karmi.<verse eid="GEN 46:9" /></para>
  <para style="li">
    <verse number="10" style="v" sid="GEN 46:10" />E Simeonesere čhavei:</para>
  <para style="li" vid="GEN 46:10">o Jemuel, o Jamin, o Ohad, o Jahin, o Cohar hem o Saul o čhavo jekha Hanaankakoro.<verse eid="GEN 46:10" /></para>
  <para style="li">
    <verse number="11" style="v" sid="GEN 46:11" />E Levijesere čhavei:</para>
  <para style="li" vid="GEN 46:11">o Geršon, o Kehat hem o Merari.<verse eid="GEN 46:11" /></para>
  <para style="li">
    <verse number="12" style="v" sid="GEN 46:12" />E Judasere čhavei:</para>
  <para style="li" vid="GEN 46:12">o Er, o Onan, o Sala, o Fares hem o Zara. O Er hem o Onan mule ano Hanaan.</para>
  <para style="li" vid="GEN 46:12">E Faresesere čhavei: o Esrom hem o Hamul.<verse eid="GEN 46:12" /></para>
  <para style="li">
    <verse number="13" style="v" sid="GEN 46:13" />E Isaharesere čhavei:</para>
  <para style="li" vid="GEN 46:13">o Tola, o Pua, o Jašuv hem o Šimron.<verse eid="GEN 46:13" /></para>
  <para style="li">
    <verse number="14" style="v" sid="GEN 46:14" />E Zavulonesere čhavei:</para>
  <para style="li" vid="GEN 46:14">o Sered, o Elon hem o Jahleel.<verse eid="GEN 46:14" /></para>
  <para style="b" />
  <para style="m">
    <verse number="15" style="v" sid="GEN 46:15" />Adalai o čhave kolen i Lija bijanđa e Jakovese ano Padan Aram. Oj bijanđa lese hem čhaja e Dina. Ukupno oto lesere potomci inele trijandu trin džene.<verse eid="GEN 46:15" /></para>
  <para style="b" />
  <para style="li">
    <verse number="16" style="v" sid="GEN 46:16" />E Gadesere čhavei:</para>
  <para style="li" vid="GEN 46:16">o Cifjon, o Hagi, o Šuni, o Ecbon, o Eri, o Arodi hem o Areli.<verse eid="GEN 46:16" /></para>
  <para style="li">
    <verse number="17" style="v" sid="GEN 46:17" />E Asiresere čhavei:</para>
  <para style="li" vid="GEN 46:17">o Jimna, o Jišva, o Jišvi hem o Berija. Lengiri phen inele i Serah.</para>
  <para style="p" vid="GEN 46:17">E Berijasere čhavei: O Hever hem o Malkijel.<verse eid="GEN 46:17" /></para>
  <para style="b" />
  <para style="m">
    <verse number="18" style="v" sid="GEN 46:18" />Adalai o čhave kolen i Zilpa bijanđa e Jakovese, i sluškinja kola o Lavan dinđa pla čhajaće e Lijaće. Oj bijanđa e Jakovese dešu šove čhaven.<verse eid="GEN 46:18" /></para>
  <para style="b" />
  <para style="li">
    <verse number="19" style="v" sid="GEN 46:19" />Akalai o čhave e Jakovesere romnjakere e Rahiljakere:</para>
  <para style="li" vid="GEN 46:19">O Josif hem o Venijamin.<verse eid="GEN 46:19" /></para>
  <para style="li">
    <verse number="20" style="v" sid="GEN 46:20" />E Josifese ano Egipat i Osnata, i čhaj e Potiferesiri, e sveštenikosiri ano Onu, bijanđa e Manasija hem e Efreme.<verse eid="GEN 46:20" /></para>
  <para style="lh">
    <verse number="21" style="v" sid="GEN 46:21" />E Venijaminesere čhavei:</para>
  <para style="li" vid="GEN 46:21">o Bela, o Beher, o Ašbel, o Gera, o Neman, o Ehi, o Roš, o Mupim, o Hupim hem o Ard.<verse eid="GEN 46:21" /></para>
  <para style="b" />
  <para style="m">
    <verse number="22" style="v" sid="GEN 46:22" />Adalai e Rahiljakere čhave kola bijandile e Jakovese – ukupno dešu štar.<verse eid="GEN 46:22" /></para>
  <para style="b" />
  <para style="li">
    <verse number="23" style="v" sid="GEN 46:23" />E Danesoro čhavo:</para>
  <para style="li" vid="GEN 46:23">o Hušim.<verse eid="GEN 46:23" /></para>
  <para style="li">
    <verse number="24" style="v" sid="GEN 46:24" />E Neftalimesere čhavei:</para>
  <para style="li" vid="GEN 46:24">o Jahceel, o Guni, o Jecer hem o Šilem.<verse eid="GEN 46:24" /></para>
  <para style="b" />
  <para style="m">
    <verse number="25" style="v" sid="GEN 46:25" />Adalai o čhave kolen i Bilha bijanđa e Jakovese, i sluškinja kola o Lavan dinđa pla čhajaće e Rahiljaće. Oj bijanđa e Jakovese efta čhaven.<verse eid="GEN 46:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 46:26" />Sare okola kola džele e Jakoveja ano Egipat – lesere bijande potomci, bizo te računini pe lesere borja – ukupno inele šovardešu šov džene. <verse eid="GEN 46:26" /><verse number="27" style="v" sid="GEN 46:27" />Zajedno e Josifesere duje čhavencar kola bijandile ano Egipat, ukupno inele eftavardeš džene e Jakovese ani porodica kola džele ano Egipat.<verse eid="GEN 46:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 46:28" />A o Jakov bičhalđa e Juda angleder koro Josif te mothoj lese o drom đi o Gošen. Kad resle ano gošensko krajo, <verse eid="GEN 46:28" /><verse number="29" style="v" sid="GEN 46:29" />O Josif naredinđa te pripreminen lese o kočije, pa dželo ano Gošen te resel pe ple dadeja e Izraeleja. Kad terdino anglo plo dad, zorale zagrlinđa le hem rundoj ačhilo lese ani angali.<verse eid="GEN 46:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 46:30" />O Izrael phenđa e Josifese: “Akana šaj te merav, adalese so dikhljum to muj, hem džanav da injan pana dživdo.”<verse eid="GEN 46:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 46:31" />Tegani o Josif phenđa ple phraljenđe hem ple dadesere čherutnenđe: “Džava te vaćerav e faraoneja. Ka phenav lese: ‘Ale maje me phralja hem o čherutne mle dadesere, kola živinde ano Hanaan. <verse eid="GEN 46:31" /><verse number="32" style="v" sid="GEN 46:32" />Adalai manuša pastirija. On arakhena stoka hem pumencar ande pumari sitno hem i krupno stoka hem sa so isi len.’ <verse eid="GEN 46:32" /><verse number="33" style="v" sid="GEN 46:33" />Kad ka vičini tumen o faraon hem kad ka pučel: ‘Savi buti ćerena?’ <verse eid="GEN 46:33" /><verse number="34" style="v" sid="GEN 46:34" />tumen phenen: ‘Amen, te sluge, arakhaja stoka pana taro amaro ternipe, sar so adava ćerde hem amare pradada.’ Ađahar ka šaj te živinen ano gošensko krajo, adalese soi zako Egipćanja sa o pastirija odvratna.”<verse eid="GEN 46:34" /></para>
  <chapter eid="GEN 46" />
  <chapter number="47" style="c" sid="GEN 47" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 47:1" />O Josif dželo hem phenđa e faraonese: “Mlo dad hem mle phralja, pumara sitnona hem krupnona stokaja hem sa okoleja so isi len, resle taro Hanaan hem ače oni akana ano gošensko krajo.”<verse eid="GEN 47:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 47:2" />Tegani izabirinđa pandžen ple phraljendar hem legarđa len anglo faraon.<verse eid="GEN 47:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 47:3" />O faraon pučlja lesere phraljen: “Savi buti ćerena?”</para>
  <para style="p" vid="GEN 47:3">A on phende lese: “Amen, te sluge, injam pastirija, sar so inele hem amare pradada.”<verse eid="GEN 47:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 47:4" />A phende lese hem akava: “Aljam ko nesavo vreme te živina akate sar abanđije adalese soi baro bokhalipe ano Hanaan hem nane so te hal o stado te slugengoro. Adalese, molinaja tut, muk amenđe te slugenđe te živina ano gošensko krajo.”<verse eid="GEN 47:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 47:5" />O faraon phenđa e Josifese: “Ale kora tute to dad hem te phralja. <verse eid="GEN 47:5" /><verse number="6" style="v" sid="GEN 47:6" />O Egipat će ko raspolaganje: Čhiv te dade hem te phraljen ano najšukar deo oti phuv. Nek živinen ano gošensko krajo. A te džaneja da maškaro lende isi neko sposobno, čhiv len te oven nadglednici oti mli stoka.”<verse eid="GEN 47:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 47:7" />Tegani o Josif anđa ple dade e Jakove hem mothovđa le e faraonese.</para>
  <para style="p" vid="GEN 47:7">O Jakov blagoslovinđa e faraone. <verse eid="GEN 47:7" /><verse number="8" style="v" sid="GEN 47:8" />A o faraon pučlja le: “Kobor berš isi tut?”<verse eid="GEN 47:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 47:9" />O Jakov phenđa lese: “Šelu trijanda berš sar lutinava akala phuvajaja. Mle beršai hari hem inele but phare. Pana na živinđum edobor kobor živinde mle pradada.”<verse eid="GEN 47:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 47:10" />Tegani o Jakov blagoslovinđa e faraone hem dželo.<verse eid="GEN 47:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 47:11" />Tegani o Josif čhivđa ple dade hem ple phraljen te živinen ano Egipat hem dinđa len phuvja ano najšukar deo oti phuv, ano e Ramzesoro krajo, sar so o faraon naredinđa. <verse eid="GEN 47:11" /><verse number="12" style="v" sid="GEN 47:12" />O Josif pobrininđa pe zako hajba ple dadese hem ple phraljenđe hem zako sa ple dadesere čherutnenđe premalo broj lengere čhavorengoro.<verse eid="GEN 47:12" /></para>
  <para style="s">O posledice oto bokhalipe</para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 47:13" />Ani celo phuv na inele hajbnase, adalese so inele baro bokhalipe. Hem o Egipat hem o Hanaan inele iscrpime oti bokh. <verse eid="GEN 47:13" /><verse number="14" style="v" sid="GEN 47:14" />O Josif čedinđa sa o pare savencar o narodo oto Egipat hem oto Hanaan činde o điv hem anđa len ani palata e faraonesiri.<verse eid="GEN 47:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 47:15" />Kad na ačhilo više pare ano Egipat hem ano Hanaan, sa o Egipćanja ale koro Josif hem phende: “De amen hajbnase. Sose te mera anglo te jaćha? Nane amen više pare.”<verse eid="GEN 47:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 47:16" />O Josif phenđa lenđe: “Adalese so nane tumen više pare, anen maje tumara stoka hem me ka dav tumen hajbnase ani zamena zaki tumari stoka.”<verse eid="GEN 47:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 47:17" />Hem on ande e Josifese pumara stoka, a ov dinđa len hajbnase ani zamena zako lengere grasta, zako stado oti sitno stoka, zako stado oto guruva hem oto hera. Adava berš dinđa len hajbnase saveja zameninđa zaki sa olengiri stoka.<verse eid="GEN 47:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 47:18" />Kad adava berš nakhino, ale koro leste aver berš hem phende: “Našti te garava tutar, gospodarona, da nane amen više pare hem, adalese so tuće pripadini amari stoka, na ačhilo amen više ništa so te da tut, gospodarona, sem korkore amen hem amare njive. <verse eid="GEN 47:18" /><verse number="19" style="v" sid="GEN 47:19" />Sose anglo te jaćha te propadina hem amen hem amare njive? Čin amen hem amare njive ani zamena zako hajba, pa zajedno amare njivencar ka ova e faraonesere robija. De amen seme, te preživina, hem te na mera hem te na ačhon amare njive pusta.”<verse eid="GEN 47:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 47:20" />Ađahar o Josif činđa sa o njive ano Egipat e faraonese. Sa o Egipćanja bikninde pumare njive, adalese so inele baro bokhalipe maškaro lende. Ađahar sa i phuv uli e faraonesiri. <verse eid="GEN 47:20" /><verse number="21" style="v" sid="GEN 47:21" />A o narodo, oto jekh krajo e Egipatesoro đi aver ule lesere robija. <verse eid="GEN 47:21" /><verse number="22" style="v" sid="GEN 47:22" />Samo o njive e sveštenikonengere na činđa, adalese so on priminena ine redovno hajbnase oto faraon hem adalestar živinena ine, pa adalese na bikninde pumare njive.<verse eid="GEN 47:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 47:23" />O Josif phenđa e narodose: “Adalese so avdive činđum zako faraon tumen hem tumare njive, ače tumenđe seme, pa sejinen i phuv. <verse eid="GEN 47:23" /><verse number="24" style="v" sid="GEN 47:24" />Ali kad ka čeden pe o žetve, jekh petina den e faraonese, a o štar petine nek ačhon tumenđe sar seme zaki njiva hem zako hajba tumenđe, tumare čherutnenđe hem tumare čhavorenđe.”<verse eid="GEN 47:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 47:25" />A on phende: “Spasinđan amaro dživdipe. Adalese so smilujinđan tut amenđe, gospodarona, amen ka ova e faraonesere robija.”<verse eid="GEN 47:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 47:26" />Ađahar o Josif anđa zakoni palo savo jekh petina oti žetva pripadini e faraonese. Adava zakoni oti phuv ano Egipat važini sa đi o avdisutno dive. Samo o njive e sveštenikonengere na pripadinena e faraonese.<verse eid="GEN 47:26" /></para>
  <para style="s">E Jakovesiri poslednjo želja</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 47:27" />O Izraelci živinde ano Egipat, ano gošensko krajo, hem adari stekninde pese phuv. Inele plodna hem zorale umnožinde pe.<verse eid="GEN 47:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 47:28" />O Jakov živinđa ano Egipat dešu efta berš, pa ađahar ukupno živinđa šelu sarandu efta berš.<verse eid="GEN 47:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 47:29" />Kad alo o vreme o Izrael te merel, ov vičinđa ple čhave e Josife hem phenđa lese: “Molinava tut, te arakhljum milost angla tute, čhiv to vas maškaro mle ćanga hem de lafi da ka mothove maje mangipe hem vernost. Ma te parune man ano Egipat. <verse eid="GEN 47:29" /><verse number="30" style="v" sid="GEN 47:30" />Kad ka merav, ka pridružinav man mle dadenđe, a tu ikal man taro Egipat hem parun man adari kaj parume hem mle dada.”</para>
  <para style="p" vid="GEN 47:30">O Josif phenđa: “Ka ćerav ađahar sar so pheneja.”<verse eid="GEN 47:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 47:31" />O Jakov phenđa e Josifese: “Ha maje sovli.” I o Josif halja lese sovli.</para>
  <para style="p" vid="GEN 47:31">Tegani o Izrael, oslonime upro plo štapi, pokloninđa pe e Devlese.<verse eid="GEN 47:31" /></para>
  <chapter eid="GEN 47" />
  <chapter number="48" style="c" sid="GEN 48" />
  <para style="s">O Jakov blagoslovini e Efreme hem e Manasija</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 48:1" />Palo nesavo vreme e Josifese phende: “To dadi namborme”, pa ov lelja peja ple duje čhaven, e Manasija hem e Efreme, pa dželo koro leste.<verse eid="GEN 48:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 48:2" />Kad phende e Jakovese: “Ače, to čhavo o Josif alo kora tute”, o Izrael čedinđa zoralipe hem bešlo ki postelja.<verse eid="GEN 48:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 48:3" />O Jakov phenđa e Josifese: “O Devel, kova sa šaj, mothovđa pe maje ano Luz ano Hanaan hem adari blagoslovinđa man <verse eid="GEN 48:3" /><verse number="4" style="v" sid="GEN 48:4" />hem phenđa maje: ‘Ka ćerav tut te ove plodno hem ka umnožinav tut. Tutar ka ćerav but narodija hem akaja phuv ka dav ano večno nasledstvo te potomkonenđe.’ <verse eid="GEN 48:4" /><verse number="5" style="v" sid="GEN 48:5" />Nek akana te duj čhave, kola bijandile će ano Egipat angleder so aljum akari, oven mle. Nek o Efrem hem o Manasija oven mle, baš sar soi o Ruvim hem o Simeon mle. <verse eid="GEN 48:5" /><verse number="6" style="v" sid="GEN 48:6" />A o čhave kola ka bijanđon će posle palo lende, nek oven kle. Nek lengoro nasledstvo ovel talo anava lengere phraljengere e Efremesoro hem e Manasijasoro.<verse eid="GEN 48:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 48:7" />Sar irinđum man taro Padan, ki mli žalost, i Rahilja muli ano Hanaan sar pana ine putujinaja, paše uzali Efrata, pa parunđum la uzalo drom nakori Efrata” – o avdisutno Vitlejem.<verse eid="GEN 48:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 48:8" />Kad o Izrael dikhlja e Josifesere čhaven pučlja: “Kolai akala?”<verse eid="GEN 48:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 48:9" />A o Josif phenđa ple dadese: “Adalai mle čhave kolen o Devel dinđa man akate.”</para>
  <para style="p" vid="GEN 48:9">Tegani o Izrael phenđa: “Ana len kora mande, te blagoslovinav len.”<verse eid="GEN 48:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 48:10" />A e Izraelesere jaćha ine bizorale zbog o phuripe, pa jedva dikhlja len. O Josif anđa ple čhaven paše uzalo leste, a lesoro dad čumudinđa len hem zagrlinđa len.<verse eid="GEN 48:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 48:11" />O Izrael phenđa e Josifese: “Mislinđum da nikad više naka dikhav to muj, a ače, o Devel dinđa man te dikhav hem to potomstvo.”<verse eid="GEN 48:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 48:12" />Tegani o Josif cidinđa e čhaven tari ple dadesiri angali hem pelo mujeja đi phuv te poklonini pe. <verse eid="GEN 48:12" /><verse number="13" style="v" sid="GEN 48:13" />Onda lelja sodujen hem čhivđa len paše uzalo Izrael, e Efreme nakoro levo vas e Izraelesoro, a e Manasija nakoro desno. <verse eid="GEN 48:13" /><verse number="14" style="v" sid="GEN 48:14" />Ali o Izrael pružinđa plo desno vas hem čhivđa le upro e Efremesoro šero, iako o Efrem inele tikneder. Tegani ukrstindoj ple vasta, čhivđa plo levo vas e Manasijase ko šero, iako o Manasija inele o prvobijando.<verse eid="GEN 48:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 48:15" />Palo adava o Izrael blagoslovinđa e Josife hem phenđa:</para>
  <para style="b" vid="GEN 48:15" />
  <para style="q1" vid="GEN 48:15">“O Devel, anglo koleste mle dada o Avraam hem o Isaak</para>
  <para style="q2" vid="GEN 48:15">živinde ćerindoj lesiri volja,</para>
  <para style="q1" vid="GEN 48:15">o Devel kovai mlo pastiri</para>
  <para style="q2" vid="GEN 48:15">celo mlo dživdipe sa đi o avdisutno dive,<verse eid="GEN 48:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="GEN 48:16" />o Anđeo kova ikalđa man taro svako bišukaripe,</para>
  <para style="q2" vid="GEN 48:16">nek blagoslovini akale terne čhaven,</para>
  <para style="q2" vid="GEN 48:16">mlo anav te spomini pe prekalo lende</para>
  <para style="q1" vid="GEN 48:16">hem o anava mle dadengere e Avraamesoro hem e Isaakesoro</para>
  <para style="q2" vid="GEN 48:16">hem zorale te umnožinen pe ki phuv.”<verse eid="GEN 48:16" /></para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" sid="GEN 48:17" />Kad o Josif dikhlja da lesoro dad čhivđa plo desno vas upro e Efremesoro šero, na ine lese sa jekh, pa lelja ple dadesoro vas hem premestinđa le taro e Efremesoro šero ko šero e Manasijasoro.<verse eid="GEN 48:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 48:18" />Hem phenđa ple dadese: “Na, dade. Akavai o prvobijando – upro lesoro šero čhiv to desno vas.”<verse eid="GEN 48:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 48:19" />Ali lesoro dad odbinđa vaćerindoj: “Džanav, mlo čhavo, džanav. Hem olestar ka ikljol narodo, hem ov ka ovel baro, ali lesoro tikneder phral ka ovel po baro olestar hem olesere potomstvostar ka ikljon but narodija.”<verse eid="GEN 48:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 48:20" />Ađahar ov adava dive blagoslovinđa len hem phenđa:</para>
  <para style="b" vid="GEN 48:20" />
  <para style="q1" vid="GEN 48:20">“Ano tumaro anav o Izrael ka blagoslovini averen vaćerindoj:</para>
  <para style="q1" vid="GEN 48:20">‘Nek o Devel ćerel će sar so ćerđa e Efremese hem e Manasijase.’ ”</para>
  <para style="b" vid="GEN 48:20" />
  <para style="p" vid="GEN 48:20">Ađahar e Efreme čhivđa anglo Manasija.<verse eid="GEN 48:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 48:21" />Tegani o Izrael phenđa e Josifese: “Ače pana hari ka merav, ali o Devel ka ovel tumencar hem ka irini tumen ani phuv tumare pradadengiri. <verse eid="GEN 48:21" /><verse number="22" style="v" sid="GEN 48:22" />A tuće dava nešto po više nego te phraljenđe: o planinsko krajo Sihem savo preleljum mle mačeja hem mla džidajkaja taro Amorejci.”<verse eid="GEN 48:22" /></para>
  <chapter eid="GEN 48" />
  <chapter number="49" style="c" sid="GEN 49" />
  <para style="s">O Jakovese poslednja lafija</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 49:1" />O Jakov tegani vičinđa ple čhaven hem phenđa lenđe: “Čeden tumen uzala mande te phenav tumenđe so ka ovel posle tumencar.<verse eid="GEN 49:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="GEN 49:2" />Čeden tumen hem šunen, čhavalen e Jakovesere,</para>
  <para style="q2" vid="GEN 49:2">šunen tumare dade e Izraele.”<verse eid="GEN 49:2" /></para>
  <para style="s2">O Ruvim</para>
  <para style="q1">
    <verse number="3" style="v" sid="GEN 49:3" />“Ruvime, tu injan mlo prvo čhavo.</para>
  <para style="q1" vid="GEN 49:3">Tu injan mlo zoralipe,</para>
  <para style="q2" vid="GEN 49:3">o prvo plod oto mlo muršikanipe.</para>
  <para style="q2" vid="GEN 49:3">Najčasno hem najzoralo maškaro mle čhave.<verse eid="GEN 49:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="GEN 49:4" />Ali injan sar i poplava savi uništini,</para>
  <para style="q2" vid="GEN 49:4">naka ove više prvo,</para>
  <para style="q1" vid="GEN 49:4">adalese so sućan te dadesere romnjaja,</para>
  <para style="q2" vid="GEN 49:4">hem ađahar kaljarđan mli postelja.”<verse eid="GEN 49:4" /></para>
  <para style="s2">O Simeon hem o Levije</para>
  <para style="q1">
    <verse number="5" style="v" sid="GEN 49:5" />“O Simeon hem o Levijei čače phralja;</para>
  <para style="q2" vid="GEN 49:5">lengerei mačija oružje zako nasilje.<verse eid="GEN 49:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="GEN 49:6" />Ko lengere sastanci naka đerdinav,</para>
  <para style="q2" vid="GEN 49:6">ko lengere čediba naka ovav,</para>
  <para style="q1" vid="GEN 49:6">adalese so ani holi mudarde e manušen</para>
  <para style="q2" vid="GEN 49:6">hem ani pumari oholost sakatinde e guruven.<verse eid="GEN 49:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="GEN 49:7" />Prokleto te ovel lengoro gnev, adalese soi but baro</para>
  <para style="q2" vid="GEN 49:7">hem lengiri holi, adalese soi but okrutno.</para>
  <para style="q1" vid="GEN 49:7">Adalese ka razdelinav len ki phuv e Jakovesiri,</para>
  <para style="q2" vid="GEN 49:7">ka rasejinav len ano Izrael.”<verse eid="GEN 49:7" /></para>
  <para style="s2">O Juda</para>
  <para style="q1">
    <verse number="8" style="v" sid="GEN 49:8" />“Judo, tut ka hvalinen te phralja.</para>
  <para style="q2" vid="GEN 49:8">Te vasteja ka ićere e neprijatelje oti guša.</para>
  <para style="q2" vid="GEN 49:8">O čhave te dadesere ka pokloninen pe tuće.<verse eid="GEN 49:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="GEN 49:9" />Judo, mlo čhavo, tu injan terno lav</para>
  <para style="q2" vid="GEN 49:9">savo terđola upro plo plen.</para>
  <para style="q1" vid="GEN 49:9">Sar lav pašljola ko vođi,</para>
  <para style="q2" vid="GEN 49:9">sar terno lav – ko tromal te dirini le?<verse eid="GEN 49:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="GEN 49:10" />Taro Juda naka cidel pe o žezlo</para>
  <para style="q2" vid="GEN 49:10">hem lesere potomci zauvek ka vladinen,</para>
  <para style="q1" vid="GEN 49:10">sa đikote na avela okova kase pripadini,</para>
  <para style="q2" vid="GEN 49:10">kase ka pokorinen pe o narodija.<verse eid="GEN 49:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="GEN 49:11" />Ov phandela e here ko čokot,</para>
  <para style="q2" vid="GEN 49:11">e terne here ki najšukar loza.</para>
  <para style="q1" vid="GEN 49:11">Ple šeja thovela ani mol,</para>
  <para style="q2" vid="GEN 49:11">ple haljine ano rat e drakhengoro.<verse eid="GEN 49:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="GEN 49:12" />O jaćha leserei po kale oti mol,</para>
  <para style="q2" vid="GEN 49:12">a o danda po parne oto thud.”<verse eid="GEN 49:12" /></para>
  <para style="s2">O Zavulon</para>
  <para style="q1">
    <verse number="13" style="v" sid="GEN 49:13" />“O Zavulon ka živini ki obala e moresiri,</para>
  <para style="q2" vid="GEN 49:13">ka ovel utočište zako brodija;</para>
  <para style="q2" vid="GEN 49:13">lesiri granica ka ovel sa đi ko Sidon.”<verse eid="GEN 49:13" /></para>
  <para style="s2">O Isahar</para>
  <para style="q1">
    <verse number="14" style="v" sid="GEN 49:14" />“O Isahar, ovi zoralo her</para>
  <para style="q2" vid="GEN 49:14">savo pašljola maškaro plo teret.<verse eid="GEN 49:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="GEN 49:15" />Kad dikhela dai o than zako odmor šukar,</para>
  <para style="q2" vid="GEN 49:15">a i phuv šuži,</para>
  <para style="q1" vid="GEN 49:15">plo dumo ka čhivel talo teret</para>
  <para style="q2" vid="GEN 49:15">hem ka ovel prisilime te ćerel buti sar robo.”<verse eid="GEN 49:15" /></para>
  <para style="s2">O Dan</para>
  <para style="q1">
    <verse number="16" style="v" sid="GEN 49:16" />“O Dan ka sudini ple narodose,</para>
  <para style="q2" vid="GEN 49:16">sar svako aver pleme ano Izrael.<verse eid="GEN 49:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="GEN 49:17" />O Dan ka ovel sar sap uzalo drom,</para>
  <para style="q2" vid="GEN 49:17">sar o poskok uzalo drom kad e graste hala ki peta,</para>
  <para style="q2" vid="GEN 49:17">hem e manuše kovai upro gras frdela ki phuv.”<verse eid="GEN 49:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="GEN 49:18" />“GOSPODE, to spasenje adžićerava.”<verse eid="GEN 49:18" /></para>
  <para style="s2">O Gad</para>
  <para style="q1">
    <verse number="19" style="v" sid="GEN 49:19" />“E Gade ka napadinen o razbojnici,</para>
  <para style="q2" vid="GEN 49:19">a ov ka jurini len hem ka napadini len od palal.”<verse eid="GEN 49:19" /></para>
  <para style="s2">O Asir</para>
  <para style="q1">
    <verse number="20" style="v" sid="GEN 49:20" />“E Asiresiri phuv ka ovel barvali hajbnaja,</para>
  <para style="q2" vid="GEN 49:20">hem oj ka del but šukar hajba zako carija.”<verse eid="GEN 49:20" /></para>
  <para style="s2">O Neftalim</para>
  <para style="q1">
    <verse number="21" style="v" sid="GEN 49:21" />“O Neftalim, ovi sar i košuta savi mukli ki sloboda,</para>
  <para style="q2" vid="GEN 49:21">savi bijani šuže ternen.”<verse eid="GEN 49:21" /></para>
  <para style="s2">O Josif</para>
  <para style="q1">
    <verse number="22" style="v" sid="GEN 49:22" />O Josif, ovi plodno čokot,</para>
  <para style="q2" vid="GEN 49:22">plodno čokot uzalo izvor,</para>
  <para style="q2" vid="GEN 49:22">kasere granke uklinde prekalo duvari.<verse eid="GEN 49:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="GEN 49:23" />Ogorčime napadinde le o strelci,</para>
  <para style="q2" vid="GEN 49:23">gađinde le neprijateljski,<verse eid="GEN 49:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="GEN 49:24" />ali lesiri džidajka na slabonđa,</para>
  <para style="q2" vid="GEN 49:24">lesere vasta zoralile,</para>
  <para style="q1" vid="GEN 49:24">zbog e Jakovesoro Zoralo Devel,</para>
  <para style="q2" vid="GEN 49:24">zbog o Pastiri, i Stena e Izraelesiri,<verse eid="GEN 49:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="GEN 49:25" />zbog o Devel te dadesoro, kova pomožini će,</para>
  <para style="q2" vid="GEN 49:25">zbog o Devel, kova sa šaj, kova blagoslovini tut</para>
  <para style="q1" vid="GEN 49:25">bršimeja upral taro nebo,</para>
  <para style="q2" vid="GEN 49:25">hem panjeja telal oti hor phuv,</para>
  <para style="q2" vid="GEN 49:25">bute stokaja hem čhavencar.<verse eid="GEN 49:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="GEN 49:26" />O blagoslovija te dadesere po barei</para>
  <para style="q2" vid="GEN 49:26">oto blagoslovija e purane planinengere,</para>
  <para style="q2" vid="GEN 49:26">oto barvalipe e večnone gorengoro.</para>
  <para style="q1" vid="GEN 49:26">Nek adala blagoslovija huljen upro šero e Josifesoro,</para>
  <para style="q2" vid="GEN 49:26">upro čekat okolesoro kovai posebno maškaro ple phralja.<verse eid="GEN 49:26" /></para>
  <para style="s2">O Venijamin</para>
  <para style="q1">
    <verse number="27" style="v" sid="GEN 49:27" />O Venijamin, ovi sar o grabežljivo ruv;</para>
  <para style="q2" vid="GEN 49:27">sabaleja hala okova so dolinđa,</para>
  <para style="q2" vid="GEN 49:27">a raćate delini o plen.<verse eid="GEN 49:27" /></para>
  <para style="b" />
  <para style="p">
    <verse number="28" style="v" sid="GEN 49:28" />Akalai sa o dešu duj plemija e Izraelesere, a akava phenđa lenđe lengoro dad kad blagoslovinđa len. Svakone olendar blagoslovinđa posebnone blagosloveja.<verse eid="GEN 49:28" /></para>
  <para style="s">E Jakovesoro meriba hem paruniba</para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 49:29" />Tegani o Jakov ađahar naredinđa lenđe: “Sigate ka merav hem ka pridružinav man mle dadenđe. Parunen man mle dadencar ani pećina savi nalazini pe ano polje e Efronesoro e Hetitesoro, <verse eid="GEN 49:29" /><verse number="30" style="v" sid="GEN 49:30" />ani pećina ko polje Mahpela paše uzalo Mamre, ani phuv Hanaan, ano polje savo o Avraam činđa oto Efron o Hetiti te ovel lese than zako paruniba. <verse eid="GEN 49:30" /><verse number="31" style="v" sid="GEN 49:31" />Adari parume o Avraam hem lesiri romni i Sara, adari parume o Isaak hem lesiri romni i Reveka, a adari hem me parunđum e Lija. <verse eid="GEN 49:31" /><verse number="32" style="v" sid="GEN 49:32" />O polje hem i pećina savi ano leste čindei oto Hetitija.”<verse eid="GEN 49:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 49:33" />Kad o Jakov naredinđa ađahar ple čhavenđe, pašlilo, muklja pli duša hem mulo, i pridružinđa pe ple narodose.<verse eid="GEN 49:33" /></para>
  <chapter eid="GEN 49" />
  <chapter number="50" style="c" sid="GEN 50" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 50:1" />O Josif zagrlinđa ple dade, runđa upro leste hem čumudinđa le. <verse eid="GEN 50:1" /><verse number="2" style="v" sid="GEN 50:2" />Tegani naredinđa e doktorenđe kola inele ani lesiri služba te balsamirinen<note caller="+" style="f"><char style="fr" closed="false">50,2 </char><char style="fq" closed="false">balsamirinen </char><char style="ft" closed="false">Adavai egipatsko adeti saveja ikalena pe o organja andral hem makhela pe balsam hem posebna začinja o telo e mulesoro sar te na raspadini pe.</char></note> lesere dade e Izraele, hem o doktorija ćerde adava. <verse eid="GEN 50:2" /><verse number="3" style="v" sid="GEN 50:3" />Zako sa adava valjanđa lenđe saranda dive, adalese so edobor vreme valjanđa lenđe zako balsamiranje e telosoro. A o Egipćanja runde le eftavardeš dive.<verse eid="GEN 50:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 50:4" />Kad nakhine o dive zako tugujiba, o Josif phenđa e faraonesere manušenđe kola živinde ani palata: “Te arakhljum milost angla tumende, vaćeren e faraonese akava umesto mande: <verse eid="GEN 50:4" /><verse number="5" style="v" sid="GEN 50:5" />Mlo dad rodinđa mandar te hav lese sovli hem phenđa: ‘Pana hari ka merav. Parun man ano grobo savo korkoro maje pripreminđum ano Hanaan.’ Muk man te džav te parunav mle dade, a onda ka irinav man. ”<verse eid="GEN 50:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 50:6" />O faraon phenđa: “Dža hem parun te dade sar so haljan lese sovli.”<verse eid="GEN 50:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 50:7" />Ađahar o Josif dželo te paruni ple dade. Oleja džele hem sa e faraonesere službenici – sa o poštujime manuša oti lesiri palata hem sa o poštujime manuša oto Egipat. <verse eid="GEN 50:7" /><verse number="8" style="v" sid="GEN 50:8" />Oleja džele hem sa lesere čherutne, lesere phralja hem sa lesere dadesere čherutne. Ano Gošen ačhile samo o čhavore hem i sitno hem i krupno stoka. <verse eid="GEN 50:8" /><verse number="9" style="v" sid="GEN 50:9" />Oleja lelje te džan hem o kočije hem o manuša upro grasta. Adava inele but bari povorka.<verse eid="GEN 50:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 50:10" />Kad resle đi o gumno e Atadesoro, istočno oti len Jordan, lelje zorale hem bare glasoja te roven. Adari o Josif efta dive inele ani žalost palo po dad.<verse eid="GEN 50:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 50:11" />Dikhindoj i žalost koro gumno e Atadesoro, o Hanaanci kola živinde adari phende: “Sar o Egipćanja žalosno rovena!” Adalese adava than istočno oti len Jordan vičinde Avel Micrajim.<note caller="+" style="f"><char style="fr" closed="false">50,11 </char><char style="fq" closed="false">Avel Micrajim </char><char style="ft" closed="false">so značini: “o egipatsko rojba”.</char></note><verse eid="GEN 50:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 50:12" />E Jakovesere čhave ćerde ađahar sar so naredinđa lenđe lengoro dad: <verse eid="GEN 50:12" /><verse number="13" style="v" sid="GEN 50:13" />Legarde le ano Hanaan hem parunde le ani pećina ano polje Mahpela, uzalo Mamre, o polje savo o Avraam činđa e Efronestar e Hetitestar te ovel lese than zako paruniba. <verse eid="GEN 50:13" /><verse number="14" style="v" sid="GEN 50:14" />Kad parunđa ple dade, o Josif irinđa pe ano Egipat, zajedno ple phraljencar hem sarijencar kola džele oleja te parunen le.<verse eid="GEN 50:14" /></para>
  <para style="s">O phralja utešinena e Josife</para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 50:15" />Dikhindoj so lengoro dad mulo, e Josifesere phralja phende: “So ako o Josif pana holjame upra amende, pa irini amenđe zako sa o bišukaripe so ćerđam lese?”<verse eid="GEN 50:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 50:16" />Adalese bičhalde akala lafija e Josifese: “To dad ađahar naredinđa angleder so te merel: <verse eid="GEN 50:16" /><verse number="17" style="v" sid="GEN 50:17" />‘Ađahar vaćeren e Josifese: Molinava tut, oprostin te phraljenđe o prestup hem o greh savo ćerde kad inele bišukar premala tute.’ Adalese, molinaja tut, oprostin amenđe amaro prestup. Hem amen injam sluge te dadesere Devlesere.” </para>
  <para style="p" vid="GEN 50:17">Kad o Josif šunđa lengere lafija, ov runđa.<verse eid="GEN 50:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 50:18" />Tegani lesere phralja ale, pele mujeja đi phuv anglo leste hem phende: “Amen injam te robija.”<verse eid="GEN 50:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 50:19" />Ali o Josif phenđa lenđe: “Ma daran. Zar me injum e Devlese ko than? <verse eid="GEN 50:19" /><verse number="20" style="v" sid="GEN 50:20" />Tumen mislinđen te ćeren maje bišukaripe, ali o Devel adava mislinđa zako šukar. Adava ćerđa sar te ačhaj ano dživdipe bute naroden, baš sar so hem dičhola avdive. <verse eid="GEN 50:20" /><verse number="21" style="v" sid="GEN 50:21" />Adalese ma daran! Me ka brininav man tumendar hem tumare čhavorendar.”</para>
  <para style="p" vid="GEN 50:21">Ađahar o Josif smirinđa len adale šukare lafonencar.<verse eid="GEN 50:21" /></para>
  <para style="s">E Josifesoro meriba</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 50:22" />O Josif ačhilo te živini ano Egipat zajedno ple dadesere čherutnencar. Živinđa šelu deš berš, <verse eid="GEN 50:22" /><verse number="23" style="v" sid="GEN 50:23" />hem doživinđa te dikhel e Efremesere čhaven đi i trito generacija. A doživinđa te dikhel hem e čhaven oto e Manasijasoro čhavo o Mahir, kolen o Josif prihvatinđa sar ple čhaven.<verse eid="GEN 50:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 50:24" />O Josif phenđa ple phraljenđe: “Me pana hari ka merav, ali o Devel sigurno ka ikljol tumenđe ano pomoć. Ka ikali tumen tari akaja phuv hem ka legari tumen ani phuv zaki savi halja pe sovli e Avraamese, e Isaakese hem e Jakovese.”<verse eid="GEN 50:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 50:25" />Tegani o Josif halja sovli e Izraelconen: “Kad ka ikljol tumenđe o Devel ano pomoć, legaren tumencar mle kokala akatar.”<verse eid="GEN 50:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 50:26" />O Josif mulo kad inole šelu deš berš. Kad balsamirinde lesoro telo, čhivde le ano sanduko ano Egipat.<verse eid="GEN 50:26" /></para>
  <chapter eid="GEN 50" />
</usx>