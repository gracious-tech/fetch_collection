<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JHN" style="id">- Romani Arli Bible (RAB)</book>
  <para style="h">Jovan</para>
  <para style="toc1">O evanđelje e Jovanesoro</para>
  <para style="toc2">Jovan</para>
  <para style="toc3">Jn</para>
  <para style="mt">O evanđelje e Jovanesoro</para>
  <chapter number="1" style="c" sid="JHN 1" />
  <para style="s">O Lafi e Devlesoroi o Isus Hrist</para>
  <para style="q1">
    <verse number="1" style="v" sid="JHN 1:1" />Ko anglunipe inele o Lafi,</para>
  <para style="q2" vid="JHN 1:1">hem o Lafi inele e Devleja,</para>
  <para style="q2" vid="JHN 1:1">hem o Lafi inele o Devel.<verse eid="JHN 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JHN 1:2" />Ov ko anglunipe inele e Devleja.<verse eid="JHN 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JHN 1:3" />Prekalo lestei ćerdo sa so postojini,</para>
  <para style="q2" vid="JHN 1:3">hem bizo lesoro ništa nane ćerdo.<verse eid="JHN 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JHN 1:4" />Ano leste inele o dživdipe</para>
  <para style="q2" vid="JHN 1:4">hem adava dživdipe inele svetlost e manušenđe.<verse eid="JHN 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JHN 1:5" />Adava svetlost svetlini ani tomina</para>
  <para style="q2" vid="JHN 1:5">hem i tomina na prelelja le.<verse eid="JHN 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 1:6" />Inele jekh manuš vičime Jovan Krstitelji, kole o Devel bičhalđa <verse eid="JHN 1:6" /><verse number="7" style="v" sid="JHN 1:7" />te svedočini e svetlostar, te šaj prekalo leste sare te poverujinen. <verse eid="JHN 1:7" /><verse number="8" style="v" sid="JHN 1:8" />Korkoro o Jovan na inele svetlost, nego inele svedoko kova vaćerđa e svetlostar.<verse eid="JHN 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 1:9" />A okova kovai e čačipnasoro svetlost, so osvetlini svakone manuše, alo ko sveto.<verse eid="JHN 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JHN 1:10" />Ov inele ko sveto</para>
  <para style="q2" vid="JHN 1:10">hem o sveto prekalo leste inele ćerdo,</para>
  <para style="q2" vid="JHN 1:10">ali o sveto na pendžarđa le.<verse eid="JHN 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JHN 1:11" />Alo ani pli phuv,</para>
  <para style="q2" vid="JHN 1:11">ali olesere manuša na priminde le.<verse eid="JHN 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JHN 1:12" />A sarijenđe kola priminde le,</para>
  <para style="q2" vid="JHN 1:12">kola verujinena ano lesoro anav,</para>
  <para style="q2" vid="JHN 1:12">dinđa pravo te oven e Devlesere čhave.<verse eid="JHN 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JHN 1:13" />On nane bijande ni prirodno,</para>
  <para style="q2" vid="JHN 1:13">ni oti volja e telosiri,</para>
  <para style="q2" vid="JHN 1:13">ni oti volja e muršesiri, nego oto Devel.<verse eid="JHN 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JHN 1:14" />I o Lafi ulo manuš hem alo te živini maškar amende.</para>
  <para style="q2" vid="JHN 1:14">Amen dikhljam lesiri slava,</para>
  <para style="q1" vid="JHN 1:14">i slava e jekhore Čhavesiri kova alo e Dadestar.</para>
  <para style="q2" vid="JHN 1:14">Ov inele pherdo milost hem čačipe.<verse eid="JHN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 1:15" />(O Jovan svedočinđa olestar vičindoj: “Akavai adava kolestar vaćerđum: Pala mande avela neko kovai po baro mandar, adalese so postojinđa angleder mandar.”)<verse eid="JHN 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 1:16" />Taro pherdipe oti olesiri milost sare priminđam milost pali milost. <verse eid="JHN 1:16" /><verse number="17" style="v" sid="JHN 1:17" />Adalese soi o Zakoni dindo prekalo Mojsije, a i milost hem o čačipe ale prekalo Isus Hrist. <verse eid="JHN 1:17" /><verse number="18" style="v" sid="JHN 1:18" />E Devle niko nikad na dikhlja, ali o jekhoro Čhavo, kovai hem korkoro Devel hem kovai e Dadese najpaše, ov mothovđa le.<verse eid="JHN 1:18" /></para>
  <para style="s">O Jovan o Krstitelj pripremini e manušen e Hristese</para>
  <para style="r">(<ref loc="MAT 3:1-12">Mt 3,1–12</ref>; <ref loc="MRK 1:2-8">Mk 1,2–8</ref>; <ref loc="LUK 3:15-17">Lk 3,15–17</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 1:19" />Akava inele e Jovanesoro svedočanstvo kad o šerutne Jevreja taro Jerusalim bičhalde nesave sveštenikonen hem e Leviten te pučen e Jovane: “Ko injan tu?”<verse eid="JHN 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 1:20" />O Jovan phravdeste phenđa lenđe: “Me na injum o Hrist.”<verse eid="JHN 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 1:21" />I on pučle le: “A kova injan onda? Na li injan o proroko o Ilija?”</para>
  <para style="p" vid="JHN 1:21">Ov phenđa: “Na injum.”</para>
  <para style="p" vid="JHN 1:21">Tegani pučle le: “Na li injan o Proroko kole adžićeraja?”</para>
  <para style="p" vid="JHN 1:21">Ov phenđa: “Na.”<verse eid="JHN 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 1:22" />Tegani phende lese: “Phen amenđe onda kova tu injan, te šaj vaćera okolenđe kola bičhalde amen. So ka phene tutar?”<verse eid="JHN 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 1:23" />A o Jovan phenđa lenđe palo lafija e prorokosere e Isaijasere:</para>
  <para style="q1" vid="JHN 1:23">“Me injum ‘o glaso so vičini ani pustinja:</para>
  <para style="q1" vid="JHN 1:23">Ravnonen o drom e Gospodese!’”<verse eid="JHN 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 1:24" />A nesave oto bičhalde inele fariseja. <verse eid="JHN 1:24" /><verse number="25" style="v" sid="JHN 1:25" />On pučle le: “Sose onda krstineja te na injan o Hrist, ni o Ilija, ni o Proroko?”<verse eid="JHN 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 1:26" />O Jovan phenđa lenđe: “Me krstinava panjeja, ali akate maškara tumende terđola neko kas tumen na pendžarena. <verse eid="JHN 1:26" /><verse number="27" style="v" sid="JHN 1:27" />Pala mande avela ov, kase na injum dostojno ni o dorikha oti obuća te phravav.”<verse eid="JHN 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 1:28" />Adava ulo ani Vitanija, tari istočno strana oti len Jordan, kote o Jovan krstini ine.<verse eid="JHN 1:28" /></para>
  <para style="s">O Jovan svedočini dai o Isus o Hrist</para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 1:29" />Tejsa dive o Jovan dikhlja e Isuse sar avela nakoro leste, i phenđa: “Ače o Bakroro e Devlesoro kova cidela o grehija e svetosere! <verse eid="JHN 1:29" /><verse number="30" style="v" sid="JHN 1:30" />Akavai adava kastar me vaćerđum: ‘Pala mande avela manuš kovai po baro mandar, adalese so postojinđa angleder mandar.’ <verse eid="JHN 1:30" /><verse number="31" style="v" sid="JHN 1:31" />Me na džanđum dai ov adava, ali aljum te krstinav panjeja te šaj ov te ovel mothovdo e izraelesere manušenđe.”<verse eid="JHN 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 1:32" />I o Jovan ađahar svedočinđa: “Dikhljum e Svetone Duho sar huljela taro nebo sar golubi hem ačhola upro leste. <verse eid="JHN 1:32" /><verse number="33" style="v" sid="JHN 1:33" />Me na džanđum dai ov adava, ali kad o Devel bičhalđa man te krstinav panjeja, phenđa maje: ‘Kad ka dikhe e manuše upra kaste huljela o Sveto Duho hem ačhola upro leste, ka džane dai ov adava kova krstini Svetone Duhoja.’ <verse eid="JHN 1:33" /><verse number="34" style="v" sid="JHN 1:34" />I me dikhljum adava hem adalese svedočinava dai ov o Čhavo e Devlesoro.”<verse eid="JHN 1:34" /></para>
  <para style="s">E Isusesere prva učenici</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 1:35" />Tejsa dive o Jovan palem inele adari ple duje učenikonencar.<verse eid="JHN 1:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 1:36" />Dikhindoj e Isuse sar nakhela, phenđa: “Ače o Bakroro e Devlesoro!”<verse eid="JHN 1:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 1:37" />Kad o duj učenici šunde adava, lelje te džan palo Isus.<verse eid="JHN 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 1:38" />O Isus irinđa pe hem dikhlja len sar džana palo leste, i pučlja len: “So mangena?”</para>
  <para style="p" vid="JHN 1:38">On phende lese: “Rabi” (so značini: Učitelju), “kaj bešeja?”<verse eid="JHN 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 1:39" />Ov phenđa lenđe: “Aven hem ka dikhen.”</para>
  <para style="p" vid="JHN 1:39">Hem ađahar džele oleja đi o than kaj bešela ine hem adava dive ačhile koro leste. A tegani inele đi ko štar o sati prekalo dive.<verse eid="JHN 1:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 1:40" />Jekh e duje učenikonendar kola šunde so o Jovan phenđa hem džele palo Isus inele o Andreja, o phral e Simonesoro e Petresoro. <verse eid="JHN 1:40" /><verse number="41" style="v" sid="JHN 1:41" />I najangle arakhlja ple phrale e Simone hem phenđa lese: “Arakhljam e Mesija” (so značini: e Hriste). <verse eid="JHN 1:41" /><verse number="42" style="v" sid="JHN 1:42" />I anđa le koro Isus.</para>
  <para style="p" vid="JHN 1:42">O Isus dikhlja le hem phenđa lese: “Tu injan o Simon, e Jovanesoro čhavo. Ka vičine tut Kifa” (so značini: Petar –“stena”).<verse eid="JHN 1:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 1:43" />Tejsa dive o Isus odlučinđa te džal ki regija Galileja, i arakhlja e Filipe hem phenđa lese: “Phir pala mande!”<verse eid="JHN 1:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 1:44" />O Filip inele tari Vitsaida, tari e Andrejasiri hem e Petresiri diz.<verse eid="JHN 1:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 1:45" />O Filip arakhlja e Natanailo, hem phenđa lese: “Arakhljam e Mesija, okole kastar pisinde o Mojsije ano Zakoni hem o Proroci. Adavai o Isus tari diz Nazaret, e Josifesoro čhavo.”<verse eid="JHN 1:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 1:46" />O Natanail pučlja le: “Šaj li taro Nazaret te avel nešto šukar?”</para>
  <para style="p" vid="JHN 1:46">A o Filip phenđa lese: “Ava hem dikh.”<verse eid="JHN 1:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 1:47" />O Isus dikhlja e Natanailo sar avela nakoro leste, i phenđa averenđe olestar: “Ače čačikano Izraelco, kora kaste nane hovajba.”<verse eid="JHN 1:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 1:48" />A o Natanail pučlja le: “Kotar džane man?”</para>
  <para style="p" vid="JHN 1:48">O Isus phenđa lese: “Dikhljum tut pana kad injanle talo kaš e smokvakoro, angleder so o Filip vičinđa tut.”<verse eid="JHN 1:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 1:49" />Tegani o Natanail phenđa lese: “Rabi, tu injan o Čhavo e Devlesoro! Tu injan o Caro e Izraelesoro!”<verse eid="JHN 1:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 1:50" />O Isus pučlja le: “Tu li verujineja samo adalese so phenđum će so dikhljum tut talo kaš e smokvakoro? Ka dikhe hem po bare stvarija akalendar.”<verse eid="JHN 1:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="JHN 1:51" />Tegani phenđa: “Čače, čače vaćerava tumenđe: ka dikhen o nebo phravdo hem sar o anđelja e Devlesere ukljena hem huljena upro Čhavo e manušesoro.”<verse eid="JHN 1:51" /></para>
  <chapter eid="JHN 1" />
  <chapter number="2" style="c" sid="JHN 2" />
  <para style="s">O Isus ćerela o pani ani mol</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 2:1" />Ko trito dive inele bijav ano gav Kana ani regija Galileja. Adari inele e Isusesiri daj, <verse eid="JHN 2:1" /><verse number="2" style="v" sid="JHN 2:2" />a ko bijav inele vičime hem o Isus hem lesere učenici.<verse eid="JHN 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 2:3" />Kad na ačhili više mol ko bijav, e Isusese phenđa lesiri daj: “Nane len više mol.”<verse eid="JHN 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 2:4" />O Isus phenđa laće: “So isi man adaleja, đuvlije? Mlo vreme pana na alo.”<verse eid="JHN 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 2:5" />Lesiri daj phenđa e slugenđe: “Ćeren sa so vaćeri tumenđe!”<verse eid="JHN 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 2:6" />Adari inele šov bare bokalija oto bar, a ko svako bokali resela ine taro oftovardeš đi ko šelu biš litarja. O Jevreja koristinena len ine zako pumaro adeti e thojbnasoro.<verse eid="JHN 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 2:7" />O Isus phenđa e slugenđe: “Pheren panjeja o bokalija”, hem on pherde len đi o muj.<verse eid="JHN 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 2:8" />Kad ćerde adava, phenđa lenđe: “Akana dolen hari hem legaren e manušese kovai odgovorno zaki gozba.” I on ćerde ađahar.<verse eid="JHN 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 2:9" />Adava manuš probinđa o pani savo ulo mol, i adalese so na džanđa kotari adaja mol – iako džande o sluge kola dolinde pani – vičinđa e mladoženja <verse eid="JHN 2:9" /><verse number="10" style="v" sid="JHN 2:10" />hem phenđa lese: “Svako manuš prvo ikali i šuži mol, a kad o gostija mačona, ikali i mol savi nane edobor šuži. A tu garavđan i najšuži mol sa đi akana.”<verse eid="JHN 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 2:11" />Ađahar o Isus plo prvo čudesno znako ćerđa ani Kana e Galilejakiri, hem mothovđa pli slava, i lesere učenici verujinde ano leste.<verse eid="JHN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 2:12" />Palo bijav o Isus, pe dajaja, ple phraljencar hem ple učenikonencar, huljilo ani diz Kafarnaum. Adari ačhile nekobor dive.<verse eid="JHN 2:12" /></para>
  <para style="s">O Isus na mukela te biknel pe ano Hram</para>
  <para style="r">(<ref loc="MAT 21:12-13">Mt 21,12–13</ref>; <ref loc="MRK 11:15-17">Mk 11,15–17</ref>; <ref loc="LUK 19:45-46">Lk 19,45–46</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 2:13" />Avela ine paše e jevrejengoro prazniko Pasha, i o Isus dželo ko Jerusalim. <verse eid="JHN 2:13" /><verse number="14" style="v" sid="JHN 2:14" />Ano boro e Hramesoro o Isus arakhlja manušen sar biknena guruven, bakren hem goluben. Arakhlja hem okolen so menjinena o pare sar bešena adari. <verse eid="JHN 2:14" /><verse number="15" style="v" sid="JHN 2:15" />I ćerđa bič oto dorikha hem sarijen kola biknena, sa e bakrencar hem e guruvencar, ikalđa taro Hram. Rasfrdinđa o pare okolengere so menjinena len ine, hem preirinđa lengere astalja. <verse eid="JHN 2:15" /><verse number="16" style="v" sid="JHN 2:16" />Okolenđe kola biknena goluben phenđa: “Legaren adava akatar! Ma ćeren pijaca mle Dadesere čherestar!”<verse eid="JHN 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 2:17" />Lesere učenici setinde pe soi pisime ano Sveto lil:</para>
  <para style="q1" vid="JHN 2:17">“O mangipe zako to čher ka thabljol ana mande sar jag.”<verse eid="JHN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 2:18" />Tegani e jevrejengere vođe pučle e Isuse: “Save čudesnone znakoja ka dokažine amenđe da isi tut pravo te ćere sa akava?”<verse eid="JHN 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 2:19" />O Isus phenđa lenđe: “Peraven akava Hram hem me palem ka vazdav le zako trin dive.”<verse eid="JHN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 2:20" />A on phende: “Sarandu šov berš valjanđa te ćerel pe akava Hram, a tu ka vazde le zako trin dive?”<verse eid="JHN 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 2:21" />Ali o Hram savestar o Isus vaćerđa inele lesoro telo. <verse eid="JHN 2:21" /><verse number="22" style="v" sid="JHN 2:22" />Kad uštino taro mule, lesere učenici setinde pe so phenđa adava, i poverujinde ano Sveta lila hem ano lafija save o Isus vaćerđa.<verse eid="JHN 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 2:23" />A sa đikote inele ano Jerusalim zako prazniko Pasha, but džene dikhle o čudesna znakija save ćerela ine hem poverujinde ano leste. <verse eid="JHN 2:23" /><verse number="24" style="v" sid="JHN 2:24" />Ali korkoro o Isus na verujinđa lenđe, adalese so džanđa sarijen. <verse eid="JHN 2:24" /><verse number="25" style="v" sid="JHN 2:25" />Niko na valjanđa te vaćeri lese savoi o manuš, adalese so ov korkoro džanđa soi ano manuš.<verse eid="JHN 2:25" /></para>
  <chapter eid="JHN 2" />
  <chapter number="3" style="c" sid="JHN 3" />
  <para style="s">O Isus hem o Nikodim</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 3:1" />A maškaro fariseja inele jekh manuš palo anav Nikodim, kova inele jekh oto vođe e jevrejengere.<verse eid="JHN 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 3:2" />Jekh rat dželo koro Isus hem phenđa lese: “Rabi, džanaja da e Devlestar injan bičhaldo sar učitelj, adalese so nijekh našti te ćerel esavke čudesna znakija save tu ćereja te o Devel nane oleja.”<verse eid="JHN 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 3:3" />O Isus phenđa lese: “Čače, čače vaćerava će, te o manuš palem na bijanđola, naka šaj te dikhel o carstvo e Devlesoro.”<verse eid="JHN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 3:4" />O Nikodim pučlja le: “Sar šaj o manuš palem te bijanđol kadi purano? Našti, valjda, dujto puti te đerdini ple dajaće ano vođi hem palem te bijanđol!”<verse eid="JHN 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 3:5" />O Isus phenđa lese: “Čače, čače vaćerava će, te o manuš na bijanđola oto pani hem oto Duho, naka šaj te đerdini ko carstvo e Devlesoro. <verse eid="JHN 3:5" /><verse number="6" style="v" sid="JHN 3:6" />Okova soi bijando oto telo, teloi, a soi bijando oto Duho, duhoi. <verse eid="JHN 3:6" /><verse number="7" style="v" sid="JHN 3:7" />Ma čudin tut so phenđum će so valjani palem te bijanđoven. <verse eid="JHN 3:7" /><verse number="8" style="v" sid="JHN 3:8" />I barval phudela kaj mangela; šuneja la, ali na džane kotar avela ni kaj džala. Ađahari svakoneja kovai bijando oto Duho.”<verse eid="JHN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 3:9" />A o Nikodim pučlja le: “Sar šaj adava te ovel?”<verse eid="JHN 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 3:10" />A o Isus phenđa lese: “Tu injan cenime učitelj ano Izrael, a adava na džane! <verse eid="JHN 3:10" /><verse number="11" style="v" sid="JHN 3:11" />Čače, čače vaćerava će: vaćeraja okova so džanaja hem svedočinaja zako okova so dikhljam, ali tumen na prihvatinena amaro svedočanstvo. <verse eid="JHN 3:11" /><verse number="12" style="v" sid="JHN 3:12" />Vaćerđum tumenđe oto stvarija save ovena ki phuv, i tumen na verujinena. Sar ka verujinen te vaćerđum tumenđe oto stvarija save ovena ko nebo? <verse eid="JHN 3:12" /><verse number="13" style="v" sid="JHN 3:13" />Niko na uštino ko nebo sem o Čhavo e manušesoro kova taro nebo huljilo. <verse eid="JHN 3:13" /><verse number="14" style="v" sid="JHN 3:14" />Hem sar so o Mojsije ani pustinja vazdinđa ko štapi e sape oti bronza, ađahar valjani te ovel vazdime hem o Čhavo e manušesoro, <verse eid="JHN 3:14" /><verse number="15" style="v" sid="JHN 3:15" />te šaj svako kova verujini ano leste te ovel le večno dživdipe.”<verse eid="JHN 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 3:16" />Adalese so, o Devel edobor volinđa e manušen taro sveto da dinđa ple jekhore Čhave, da svako kova verujini ano leste te na merel, nego te ovel le večno dživdipe. <verse eid="JHN 3:16" /><verse number="17" style="v" sid="JHN 3:17" />O Devel na bičhalđa ple Čhave ko sveto te osudini e manušen, nego o manuša te oven spasime prekalo leste.<verse eid="JHN 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 3:18" />Ko verujini ano leste, nane osudime, a ko na verujini, ovi već osudime, adalese so na poverujinđa ano anav e Devlesere jekhore Čhavesoro. <verse eid="JHN 3:18" /><verse number="19" style="v" sid="JHN 3:19" />A akavai i osuda: o svetlost alo ko sveto, ali o manuša volinde i tomina umesto o svetlost, adalese so lengere delja inele bišukar. <verse eid="JHN 3:19" /><verse number="20" style="v" sid="JHN 3:20" />Ko god ćerela bišukaripe, mrzini o svetlost hem na ikljola ko svetlost, te na dičhon lesere delja. <verse eid="JHN 3:20" /><verse number="21" style="v" sid="JHN 3:21" />A okova kova živini palo čačipe, ikljola ko svetlost, te dičhol soi lesere delja ćerde ano zoralipe e Devlesoro.<verse eid="JHN 3:21" /></para>
  <para style="s">O Jovan palem vaćeri dai o Isus o Hrist</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 3:22" />Palo adava o Isus dželo ple učenikonencar ko gavutno deo e Judejakoro. Adari inele olencar nesavo vreme hem krstini ine. <verse eid="JHN 3:22" /><verse number="23" style="v" sid="JHN 3:23" />A hem o Jovan krstini ine ano than Enon, paše uzalo gav Salim, adalese so adari inele but pani, a o manuša avena ine koro leste te krstini len. <verse eid="JHN 3:23" /><verse number="24" style="v" sid="JHN 3:24" />Adava inele angleder so e Jovane frdinde ano phandlipe.<verse eid="JHN 3:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 3:25" />A maškaro e Jovanesere učenici hem nesavo aver Jevrejco uli rasprava zako adeti e thojbnasoro.<verse eid="JHN 3:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 3:26" />I adala učenici ale koro Jovan hem phende lese: “Rabi, okova so inele tuja tari aver strana oti len Jordan, okova kastar tu svedočinđan, eče krstini hem sa edobor manuša džana koro leste.”<verse eid="JHN 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 3:27" />A o Jovan phenđa: “O manuš šaj te primini samo okova soi lese dindo e Devlestar kovai ano nebo. <verse eid="JHN 3:27" /><verse number="28" style="v" sid="JHN 3:28" />Korkore injen maje svedoci so phenđum da me na injum o Hrist, nego da injum bičhaldo anglo leste. <verse eid="JHN 3:28" /><verse number="29" style="v" sid="JHN 3:29" />O mladoženjai okova kasiri i nevesta. A o najšukar amal e mladoženjasoro, kova adžićeri te šunel da o mladoženja avela, radosnoi but kad šunela e mladoženjasoro glaso. I adajai radost mli, hem akana uli pherdi. <verse eid="JHN 3:29" /><verse number="30" style="v" sid="JHN 3:30" />Ov valjani te ovel sa po baro, a me sa po tikoro.”<verse eid="JHN 3:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 3:31" />Okova kova avela odupral, ovi upreder sarijende, a okova kovai tari phuv, ovi e phuvjakoro hem vaćeri taro stvarija e phuvjakere. Okova kova avela taro nebo, ovi upreder sarijende. <verse eid="JHN 3:31" /><verse number="32" style="v" sid="JHN 3:32" />Ov svedočini zako okova so dikhlja hem šunđa, ali niko na prihvatini lesoro svedočanstvo. <verse eid="JHN 3:32" /><verse number="33" style="v" sid="JHN 3:33" />A ko prihvatini lesoro svedočanstvo, potvrdini dai o Devel čačikano. <verse eid="JHN 3:33" /><verse number="34" style="v" sid="JHN 3:34" />Okova kas o Devel bičhalđa, vaćeri e Devlesere lafija, adalese so o Devel dinđa le pherdeste e Duho. <verse eid="JHN 3:34" /><verse number="35" style="v" sid="JHN 3:35" />O Dad volini e Čhave hem sa muklja lese ano vasta. <verse eid="JHN 3:35" /><verse number="36" style="v" sid="JHN 3:36" />Svako kova verujini ano Čhavo, isi le večno dživdipe, a kova nane poslušno e Čhavese, naka ovel le večno dživdipe, nego upro leste ačhola e Devlesiri holi.<verse eid="JHN 3:36" /></para>
  <chapter eid="JHN 3" />
  <chapter number="4" style="c" sid="JHN 4" />
  <para style="s">O Isus hem i Samarijanka</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 4:1" />Kad o Isus dodžanđa so o fariseja šunde so ov ćerela hem krstini više učenikonen nego o Jovan, <verse eid="JHN 4:1" /><verse number="2" style="v" sid="JHN 4:2" />– iako korkoro o Isus na krstinđa, nego lesere učenici – <verse eid="JHN 4:2" /><verse number="3" style="v" sid="JHN 4:3" />dželo tari regija Judeja hem irinđa pe ani regija Galileja.<verse eid="JHN 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 4:4" />Morandilo te nakhel maškari regija Samarija. <verse eid="JHN 4:4" /><verse number="5" style="v" sid="JHN 4:5" />Alo đi e samarijakoro gav savo vičini pe Sihar, paše uzalo imanje savo o Jakov dinđa ple čhavese e Josifese. <verse eid="JHN 4:5" /><verse number="6" style="v" sid="JHN 4:6" />Adari inele e Jakovesoro bunari, i o Isus, umorno oto but phiriba, beštino uzalo leste. Inele paše đi ko dešu duj o sati diveste.<verse eid="JHN 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 4:7" />I kad jekh Samarijanka ali te dolel pani, o Isus phenđa laće: “De man te pijav.” <verse eid="JHN 4:7" /><verse number="8" style="v" sid="JHN 4:8" />(Tegani o Isus inele korkoro, adalese so lesere učenici džele ko gav te činen hajbnase.)<verse eid="JHN 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 4:9" />A i Samarijanka phenđa lese: “Sar adava tu kova injan Jevrejco rodeja mandar e Samarijankatar te dav tut pani?” (Adalese so o Jevreja na mešinde pe e Samarijanconencar).<verse eid="JHN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 4:10" />O Isus phenđa laće: “Te džane ine savo daro e Devle isi tuće hem kova injum me so rodava tutar te de man te pijav, ka rode mandar ine hem me ka dav tut o dživdo pani.”<verse eid="JHN 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 4:11" />I đuvli phenđa lese: “Gospodarona, nane tut ni soja te dole pani, a o bunari but hor. Kotar će onda adava dživdo pani? <verse eid="JHN 4:11" /><verse number="12" style="v" sid="JHN 4:12" />Tu li mislineja da injan po baro amare pradadestar e Jakovestar, kova dinđa amen akava bunari hem savestar pilja ov hem lesere čhave hem lesiri stoka?”<verse eid="JHN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 4:13" />O Isus phenđa laće: “Svako kova pijela akava pani, palem ka ovel žedno, <verse eid="JHN 4:13" /><verse number="14" style="v" sid="JHN 4:14" />a kova pijela o pani savo me ka dav le, nikad više naka ovel žedno. O pani savo ka dav le ka ovel ano leste izvor e panjesoro savo dela večno dživdipe.”<verse eid="JHN 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 4:15" />Tegani i đuvli phenđa lese: “Gospodarona, molinava tut, de man adava pani te na ovav više žedno hem te na avav više akate te dolav pani!”<verse eid="JHN 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 4:16" />O Isus phenđa laće: “Dža vičin te rome hem ava palem akari.”<verse eid="JHN 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 4:17" />I đuvli phenđa lese: “Nane man rom.”</para>
  <para style="p" vid="JHN 4:17">Tegani o Isus phenđa laće: “Šukar phenđan so nane tut rom, <verse eid="JHN 4:17" /><verse number="18" style="v" sid="JHN 4:18" />adalese so ine tut pandž roma, a akava kasar akana injan nane to rom. Čače šukar phenđan.”<verse eid="JHN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 4:19" />A i đuvli phenđa lese: “Gospodarona, dikhava da injan proroko. <verse eid="JHN 4:19" /><verse number="20" style="v" sid="JHN 4:20" />Amare pradada slavinde e Devle ki akaja gora, a tumen o Jevreja phenena da e Devle valjani te slavini pe ano Jerusalim.”<verse eid="JHN 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 4:21" />A o Isus phenđa laće: “Đuvlije, verujin maje, avela o vreme kad naka slavinen e Dade samo akate ili ano Jerusalim. <verse eid="JHN 4:21" /><verse number="22" style="v" sid="JHN 4:22" />Tumen o Samarijanci na džanen kas slavinena, a amen o Jevreja džanaja kas slavinaja, adalese so o spasenje avela prekalo Jevreja. <verse eid="JHN 4:22" /><verse number="23" style="v" sid="JHN 4:23" />Ali avela o vreme – hem već alo – kad o čačikane slavljenici ka slavinen e Dade ano duho hem ano čačipe. Esavke slavljenikonen o Dad rodela. <verse eid="JHN 4:23" /><verse number="24" style="v" sid="JHN 4:24" />O Develi duho, hem okola kola slavinena le, valjani te slavinen le ano duho hem ano čačipe.”<verse eid="JHN 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 4:25" />A i đuvli phenđa lese: “Džanav da o Mesija (vičime Hrist) ka avel. Kad ka avel ov, sa ka objasnini amenđe.”<verse eid="JHN 4:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 4:26" />Tegani o Isus phenđa laće: “Me injum adava, kova vaćerava tuja.”<verse eid="JHN 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 4:27" />I ko adava momenti ale lesere učenici hem inele začudime so o Isus vaćeri e đuvljaja. Ali nijekh na pučlja le: “So mangeja olatar?” ili: “Sose vaćereja olaja?”<verse eid="JHN 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 4:28" />Tegani i đuvli ačhavđa plo bokali uzalo bunari, i dželi ko gav hem phenđa e manušenđe: <verse eid="JHN 4:28" /><verse number="29" style="v" sid="JHN 4:29" />“Aven te dikhen e manuše kova phenđa maje sa so ćerđum. Te nane ov o Hrist?”<verse eid="JHN 4:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 4:30" />I o manuša iklile taro gav hem lelje te džan nakoro Isus.<verse eid="JHN 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 4:31" />Sar ovela ine adava, o učenici molinena ine e Isuse vaćerindoj: “Rabi, ha maro!”<verse eid="JHN 4:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 4:32" />A ov phenđa lenđe: “Man isi te hav hajba zako savo tumen na džanen.”<verse eid="JHN 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 4:33" />Tegani o učenici phende jekh averese: “Te na anđa lese neko nešto te hal?”<verse eid="JHN 4:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 4:34" />O Isus phenđa lenđe: “O hajbai mlo te ćerav i volja Okolesiri kova bičhalđa man hem te ćerav đi o kraj i buti savi dinđa man. <verse eid="JHN 4:34" /><verse number="35" style="v" sid="JHN 4:35" />Na li tumen phenena: ‘Pana štar masek đi o čediba i žetva?’ Ače, vaćerava tumenđe: phraven tumare jaćha hem dikhen o njive – spremnai zako čediba. <verse eid="JHN 4:35" /><verse number="36" style="v" sid="JHN 4:36" />Okova kova čedela već primini i plata hem čedela o bijandipe zako večno dživdipe, te šaj hem o sejači te radujini pe zajedno okoleja kova čedela. <verse eid="JHN 4:36" /><verse number="37" style="v" sid="JHN 4:37" />Ađahar pherđola okova vaćeriba: ‘Jekh sejini, a o dujto čedela.’ <verse eid="JHN 4:37" /><verse number="38" style="v" sid="JHN 4:38" />Me bičhalđum tumen te čeden adari kaj na ćerđen buti. Avera ćerde phari buti, a tumen čedinđen o plodija save iklile oti lengiri buti.”<verse eid="JHN 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 4:39" />But Samarijanci taro adava gav poverujinde ano Isus zbog o lafija e đuvljakere koja svedočinđa: “Ov phenđa maje sa so ćerđum!”<verse eid="JHN 4:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 4:40" />A kad o Samarijanci ale koro Isus, zamolinde le te ačhol koro lende, hem ov ačhilo adari duj dive. <verse eid="JHN 4:40" /><verse number="41" style="v" sid="JHN 4:41" />Hem pana but manuša poverujinde ano leste zbog lesere lafija.<verse eid="JHN 4:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 4:42" />Tegani o manuša taro gav phende e đuvljaće: “Akana više na verujinaja zbog adava so tu vaćerđan, nego so korkore šunđam, hem džanaja soi ov čače o Spasitelji e svetosoro.”<verse eid="JHN 4:42" /></para>
  <para style="s">O Isus sasljari e službenikosere čhave</para>
  <para style="r">(<ref loc="MAT 8:5-13">Mt 8,5–13</ref>; <ref loc="LUK 7:1-10">Lk 7,1–10</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 4:43" />Palo adala duj dive, o Isus dželo adathar ki Galileja. <verse eid="JHN 4:43" /><verse number="44" style="v" sid="JHN 4:44" />(Korkoro o Isus tvrdinđa da o proroko nane cenime ano plo than kaj barilo.) <verse eid="JHN 4:44" /><verse number="45" style="v" sid="JHN 4:45" />Kad reslo ki Galileja, o Galilejci priminde le šukar, samo adalese so dikhle o čudesija save ćerđa ano Jerusalim zako prazniko Pasha, adalese so hem on inele adari.<verse eid="JHN 4:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 4:46" />I ađahar o Isus palem alo ani Kana e Galilejakiri, kaj ćerđa ine o pani ani mol. A inele jekh službeniko e carosoro kasoro čhavo pašljola ine namborme ani diz Kafarnaum. <verse eid="JHN 4:46" /><verse number="47" style="v" sid="JHN 4:47" />Kad šunđa so o Isus alo tari Judeja ki Galileja, alo koro leste hem zamolinđa le te avel ano Kafarnaum hem te sasljari lesere čhave kovai anglo meriba.<verse eid="JHN 4:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 4:48" />Tegani o Isus phenđa lese: “Tumen đikote na dikhena znakija hem čudesija, na verujinena.”<verse eid="JHN 4:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 4:49" />O službeniko phenđa lese: “Gospodarona, molinava tut, ava sar pana na mulo mlo čhavo!”<verse eid="JHN 4:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 4:50" />O Isus phenđa lese: “Dža, to čhavo ka živini.”</para>
  <para style="p" vid="JHN 4:50">O manuš poverujinđa ano adava so o Isus phenđa lese hem dželo.<verse eid="JHN 4:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="JHN 4:51" />A odrumal resle le lesere sluge hem phende lese dai lesoro čhavo dživdo. <verse eid="JHN 4:51" /><verse number="52" style="v" sid="JHN 4:52" />Ov pučlja len kad lesere čhavese lelja te ovel po šukar, a on phende lese: “I jag muklja le erati ko jekh o sati diveste.”<verse eid="JHN 4:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 4:53" />Tegani e čhavesoro dad setinđa pe so baš ko adava sati o Isus phenđa lese: “To čhavo ka živini.”</para>
  <para style="p" vid="JHN 4:53">I ov hem sa lesere čherutne poverujinde ano Isus.<verse eid="JHN 4:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 4:54" />Adava inele dujto čudesno znako savo o Isus ćerđa ani Galileja. Ćerđa le kad alo tari Judeja.<verse eid="JHN 4:54" /></para>
  <chapter eid="JHN 4" />
  <chapter number="5" style="c" sid="JHN 5" />
  <para style="s">O Isus ko savato sasljari e manuše kova našti te phirel</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 5:1" />Palo adava o Isus dželo ko Jerusalim zako e jevrejengoro prazniko. <verse eid="JHN 5:1" /><verse number="2" style="v" sid="JHN 5:2" />A ano Jerusalim, uzali e Bakrengiri kapija, inele bazeni savo ko jevrejski vičini pe Vitezda. Adari inele pandž phravde terase učharde krovonencar. <verse eid="JHN 5:2" /><verse number="3" style="v" sid="JHN 5:3" />Adari pašljona ine but namborme manuša: korore, bange hem paralizujime. [On adžićerena ine te ćeren pe talasija ano pani, <verse eid="JHN 5:3" /><verse number="4" style="v" sid="JHN 5:4" />adalese so ponekad avela ine o anđeo e Gospodesoro ko bazeni te ćerel talasija. I kova manuš prvo đerdini ano bazeni kad ovena o talasija, sasljola ine taro bilo savo nambormipe savo inole.]<note caller="+" style="f"><char style="fr" closed="false">5,4 </char><char style="ft" closed="false">O po purane rukopisija nane len o zadnjo deo oto trito stih hem celo štarto stih.</char></note><verse eid="JHN 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 5:5" />A adari inele hem jekh manuš kova trijandu ofto berš inele namborme.<verse eid="JHN 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 5:6" />Kad o Isus dikhlja le sar pašljola hem adalese so džanđa kobori berš namborme, pučlja le: “Mangeja li te ove sasljardo?”<verse eid="JHN 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 5:7" />Tegani o namborme manuš phenđa e Isusese: “Gospodarona, nane man niko te pomožini maje te đerdinav ano bazeni kad ovena o talasija. A dok me resava, nekoi već adari angleder mande.”<verse eid="JHN 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 5:8" />O Isus phenđa lese: “Ušti, le ti nosiljka hem phir!”<verse eid="JHN 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 5:9" />I otojekhvar o manuš saslilo, vazdinđa pli nosiljka hem lelja te phirel.</para>
  <para style="p" vid="JHN 5:9">A adava dive inele savato, <verse eid="JHN 5:9" /><verse number="10" style="v" sid="JHN 5:10" />i adalese e jevrejengere vođe phende e sasljarde manušese: “Avdivei savato! Na tromaš te akhare ti nosiljka!”<verse eid="JHN 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 5:11" />A ov phenđa lenđe: “Okova kova sasljarđa man phenđa maje: ‘Le ti nosiljka hem phir!’”<verse eid="JHN 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 5:12" />On pučle le: “Kovai adava manuš so phenđa će: ‘Le ti nosiljka hem phir!’?”<verse eid="JHN 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 5:13" />Ali o sasljardo manuš na džanđa kova inele adava, adalese so o Isus cidinđa pe maškaro but manuša kola inele adari.<verse eid="JHN 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 5:14" />Palo adava o Isus arakhlja le ko boro e Hramesoro, i phenđa lese: “Eče, sasto injan. Ma grešin više, te na arakhi tut nešto po bišukar.”<verse eid="JHN 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 5:15" />Tegani o sasljardo manuš dželo hem phenđa e jevrejengere vođenđe dai o Isus adava kova sasljarđa le.<verse eid="JHN 5:15" /></para>
  <para style="s">O Isus phenela dai ov e Devlesoro Čhavo</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 5:16" />Adalese so o Isus sasljarđa e manuše ko savato, e jevrejengere vođe lelje te progoninen le.<verse eid="JHN 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 5:17" />A o Isus phenđa lenđe: “Mlo Dad stalno ćerela buti, a ađahar hem me.”<verse eid="JHN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 5:18" />Adalese so phenđa adava, e jevrejengere vođe po više mangle te mudaren le, adalese so na samo so phaglja o zakoni zako savato nego hem so phenđa dai o Devel lesoro Dad – adaleja phenđa dai ov hem o Devel jednaka.<verse eid="JHN 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 5:19" />A o Isus phenđa lenđe: “Čače, čače vaćerava tumenđe: O Čhavo korkoro pestar našti ništa te ćerel. Ćerela samo okova so dikhela so o Dad ćerela. Sa so ćerela o Dad, isto adava ćerela hem o Čhavo. <verse eid="JHN 5:19" /><verse number="20" style="v" sid="JHN 5:20" />Adalese so, o Dad volini e Čhave hem mothoj lese sa so ćerela. A ka mothoj lese hem po bare buća nego soi o sasljariba akale manušesoro, i tumen ka čudinen tumen. <verse eid="JHN 5:20" /><verse number="21" style="v" sid="JHN 5:21" />Adalese so, sar so o Dad vazdela e mulen hem dela len dživdipe, ađahar hem o Čhavo dela dživdipe kase ov mangela. <verse eid="JHN 5:21" /><verse number="22" style="v" sid="JHN 5:22" />Adalese so, o Dad na sudini nikase, nego dinđa vlast e Čhavese te sudini sarijenđe, <verse eid="JHN 5:22" /><verse number="23" style="v" sid="JHN 5:23" />te šaj sare poštujinen e Čhave sar so poštujinena e Dade. Ko na poštujini e Čhave, na poštujini ni e Dade, kova bičhalđa le.<verse eid="JHN 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 5:24" />Čače, čače vaćerava tumenđe: Svako kova šunela mle lafija hem verujini Okolese kova bičhalđa man, isi le večno dživdipe hem naka ovel osudime, nego nakhino taro meriba ko dživdipe. <verse eid="JHN 5:24" /><verse number="25" style="v" sid="JHN 5:25" />Čače, čače vaćerava tumenđe: Avela o vreme, hem već alo, kad o mule ka šunen o glaso e Devlesere Čhavesoro hem, kola ka šunen le, ka oven palem dživde. <verse eid="JHN 5:25" /><verse number="26" style="v" sid="JHN 5:26" />Sar so e Dade isi dživdipe ana peste, ađahar hem ple Čhavese dinđa te ovel le dživdipe ana peste, <verse eid="JHN 5:26" /><verse number="27" style="v" sid="JHN 5:27" />hem dinđa le vlast te sudini, adalese soi ov o Čhavo e manušesoro.<verse eid="JHN 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 5:28" />Ma čudinen tumen adalese. Adalese so avela o vreme kad sare kolai ano grobija ka šunen lesoro glaso <verse eid="JHN 5:28" /><verse number="29" style="v" sid="JHN 5:29" />hem ka ikljon, okola kola ćerde šukaripe, ka ušten te živinen večno, a okola kola ćerde bišukaripe, ka ušten te oven osudime. <verse eid="JHN 5:29" /><verse number="30" style="v" sid="JHN 5:30" />Me korkoro mandar našti ništa te ćerav, nego sudinava ađahar sar so šunava e Dadestar. A mloi sudo pravedno, adalese so na rodava te ovel mli volja, nego i volja Okolesiri kova bičhalđa man.”<verse eid="JHN 5:30" /></para>
  <para style="s">Svedočanstvija e Isusestar</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 5:31" />“Te me korkoro mandar svedočinava, mlo svedočiba nane dovoljno. <verse eid="JHN 5:31" /><verse number="32" style="v" sid="JHN 5:32" />Ali aver neko svedočini mandar, hem džanav dai dovoljno o svedočiba savo dinđa mandar. <verse eid="JHN 5:32" /><verse number="33" style="v" sid="JHN 5:33" />Tumen bičhalđen tumare manušen koro Jovan o Krstitelj, a lesoroi svedočiba mandar čačikano. <verse eid="JHN 5:33" /><verse number="34" style="v" sid="JHN 5:34" />Nane da maje valjani manušikano svedočiba, nego akava phenđum tumenđe e Jovanestar sar te šaj oven spasime. <verse eid="JHN 5:34" /><verse number="35" style="v" sid="JHN 5:35" />O Jovan inele svetiljka savi thabljola hem svetlini, a tumen mangljen samo nesavo vreme te uživinen ano lesoro svetlost.<verse eid="JHN 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 5:36" />A isi man svedočanstvo po baro taro e Jovanesoro – o buća save ćerava. O Dad dinđa man te ćerav len hem on svedočinena adalestar da o Dad bičhalđa man. <verse eid="JHN 5:36" /><verse number="37" style="v" sid="JHN 5:37" />A hem korkoro o Dad, kova bičhalđa man, svedočinđa mandar. Tumen nikad na šunđen lesoro glaso ni na dikhljen lesoro muj, <verse eid="JHN 5:37" /><verse number="38" style="v" sid="JHN 5:38" />a ni lesoro Lafi na živini ana tumende, adalese so na verujinena maje, okolese kole ov bičhalđa. <verse eid="JHN 5:38" /><verse number="39" style="v" sid="JHN 5:39" />Pažljivo sikljovena o Sveta lila, adalese so mislinena da ano lende isi tumen večno dživdipe, a on svedočinena mandar. <verse eid="JHN 5:39" /><verse number="40" style="v" sid="JHN 5:40" />A tumen palem na mangena te aven kora mande te ovel tumen večno dživdipe.<verse eid="JHN 5:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 5:41" />Na prihvatinava pohvala e manušendar. <verse eid="JHN 5:41" /><verse number="42" style="v" sid="JHN 5:42" />Ali me pendžarava tumen hem džanav da ana tumende nane mangipe premalo Devel. <verse eid="JHN 5:42" /><verse number="43" style="v" sid="JHN 5:43" />Me aljum ano anav mle Dadesoro, a tumen na prihvatinena man. Ali, te alo neko aver ano plo anav, ole ka prihvatinen! <verse eid="JHN 5:43" /><verse number="44" style="v" sid="JHN 5:44" />A sar hem ka verujinen maje kad prihvatinena pohvala jekh averestar, a na rodena pohvala e jekhe Devlestar?<verse eid="JHN 5:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 5:45" />Ma mislinen da me ka tužinav tumen anglo Dad. Tumen ka tužini o Mojsije, upra kaste nadinena tumen. <verse eid="JHN 5:45" /><verse number="46" style="v" sid="JHN 5:46" />Adalese so, te verujinen ine e Mojsijase, ka verujinen ine hem maje, adalese so ov mandar pisinđa. <verse eid="JHN 5:46" /><verse number="47" style="v" sid="JHN 5:47" />A kad na verujinena ano adava so ov pisinđa, sar ka verujinen mle lafenđe?”<verse eid="JHN 5:47" /></para>
  <chapter eid="JHN 5" />
  <chapter number="6" style="c" sid="JHN 6" />
  <para style="s">O Isus parvari više oto pandž hiljade manušen</para>
  <para style="r">(<ref loc="MAT 14:13-21">Mt 14,13–21</ref>; <ref loc="MRK 6:30-44">Mk 6,30–44</ref>; <ref loc="LUK 9:10-17">Lk 9,10–17</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 6:1" />Palo adava o Isus irinđa pe ki Galileja hem dželo ki istočno strana oto e Galilejakoro jezero (vičime hem: e Tiberijakoro jezero), <verse eid="JHN 6:1" /><verse number="2" style="v" sid="JHN 6:2" />a palo leste džele but manuša, adalese so dikhle o čudesna znakija save ćerđa sasljarindoj e nambormen. <verse eid="JHN 6:2" /><verse number="3" style="v" sid="JHN 6:3" />O Isus uklinđa ki gora hem bešlo ple učenikonencar. <verse eid="JHN 6:3" /><verse number="4" style="v" sid="JHN 6:4" />(A avela ine paše i Pasha, e jevrejengoro prazniko.)<verse eid="JHN 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 6:5" />I kad o Isus vazdinđa plo šero te dikhel, dikhlja but narodo sar avela nakoro leste, i pučlja e Filipe: “Kaj šaj te čina maro sa akale manušenđe te han?”<verse eid="JHN 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 6:6" />Adava o Isus pučlja e Filipe sar te čhivel le ko test, adalese so već džanđa so ka ćerel.<verse eid="JHN 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 6:7" />A o Filip phenđa lese: “Ni dušel srebrna kovanice naka ovel ine dovoljno te čina sarijenđe te han barem hari.”<verse eid="JHN 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 6:8" />A aver oto lesere učenici – o Andreja, o phral e Simonesoro e Petresoro – phenđa e Isusese: <verse eid="JHN 6:8" /><verse number="9" style="v" sid="JHN 6:9" />“Akatei jekh čhavoro kas isi pandž mare oto ječam hem duj tikore maćhe. Ali adava nane ništa zako sa edobor manuša.”<verse eid="JHN 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 6:10" />O Isus phenđa: “Čhiven e manušen te bešen.”</para>
  <para style="p" vid="JHN 6:10">A ko adava than inele but čar, hem tegani đi ko pandž hiljade murša bešle.<verse eid="JHN 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 6:11" />Tegani o Isus lelja okola mare, zahvalinđa e Devlese, i dinđa len e manušenđe kola bešle, a ađahar ćerđa hem e maćhencar. I sare hale edobor kobor mangle.<verse eid="JHN 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 6:12" />Kad sare čalile, o Isus phenđa ple učenikonenđe: “Čeden sa okolestar so ačhilo oto hajba, te na frdel pe ništa.”<verse eid="JHN 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 6:13" />I on čedinde sa adava so ačhilo oto pandž mare oto ječam save o manuša hale, hem adaleja pherde dešu duj korpe.<verse eid="JHN 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 6:14" />Kad o manuša dikhle o čudesno znako savo o Isus ćerđa, phende: “Akavai čače o Proroko savo valjani te avel ko sveto!”<verse eid="JHN 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 6:15" />A o Isus džanđa so on inele spremna ki zor te čhiven le te ovel lengoro caro, i palem cidinđa pe ki gora, korkoro.<verse eid="JHN 6:15" /></para>
  <para style="s">O Isus phirela upro pani</para>
  <para style="r">(<ref loc="MAT 14:22-27">Mt 14,22–27</ref>; <ref loc="MRK 6:45-52">Mk 6,45–52</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 6:16" />Kad lelja te raćol, lesere učenici huljile đi ko jezero, <verse eid="JHN 6:16" /><verse number="17" style="v" sid="JHN 6:17" />đerdinde ko čamco hem lelje te džan prekalo jezero, nakori diz Kafarnaum. Već peli i rat, a o Isus pana na alo ine koro lende. <verse eid="JHN 6:17" /><verse number="18" style="v" sid="JHN 6:18" />I lelja te phudel jekh zorali barval hem upro jezero vazdinde pe o talasija. <verse eid="JHN 6:18" /><verse number="19" style="v" sid="JHN 6:19" />Kad veslinde sar pandž đi ko šov kilometarija, dikhle e Isuse sar phirela upro pani hem avela nakoro čamco, hem darandile.<verse eid="JHN 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 6:20" />A o Isus phenđa lenđe: “Me injum. Ma daran!”<verse eid="JHN 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 6:21" />Tegani on lelje le peja ano čamco, i o čamco otojekhvar inele ki phuv nakori savi plovinde.<verse eid="JHN 6:21" /></para>
  <para style="s">O Isusi sar o maro savo dela dživdipe</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 6:22" />Tejsato dive o manuša kola ačhile ki aver strana oto jezero setinde pe so adari inele samo jekh čamco hem da o Isus na đerdinđa ano čamco ple učenikonencar, nego da on džele korkore. <verse eid="JHN 6:22" /><verse number="23" style="v" sid="JHN 6:23" />A nesave čamcija tari diz Tiberijada resle paše uzalo than kaj o Gospod zahvalinđa e Devlese zako maro hem dinđa len te han. <verse eid="JHN 6:23" /><verse number="24" style="v" sid="JHN 6:24" />Kad o manuša dikhle da adari nane ni o Isus ni lesere učenici, čhivde pe ano čamcija hem džele ko Kafarnaum te roden le.<verse eid="JHN 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 6:25" />A kad arakhle le ki aver strana oto jezero, pučle le: “Učitelju, kad aljan akari?”<verse eid="JHN 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 6:26" />O Isus phenđa lenđe: “Čače, čače vaćerava tumenđe, tumen na rodena man adalese so haliljen o čudesna znakija, nego adalese so haljen o maro hem čaliljen. <verse eid="JHN 6:26" /><verse number="27" style="v" sid="JHN 6:27" />Ćeren buti, ali na zako hajba savo nakhela, nego zako hajba savo trajini zako večno dživdipe, a adava ka dav tumen me, o Čhavo e manušesoro, adalese so o Devel o Dad dinđa man vlast zako adava.”<verse eid="JHN 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 6:28" />Tegani pučle le: “So valjani te ćera sar te šaj ćera o buća save o Devel rodela amendar?”<verse eid="JHN 6:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 6:29" />A o Isus phenđa lenđe: “Akavai i buti savi o Devel rodela tumendar te ćeren: te verujinen ano okoleste kole ov bičhalđa.”<verse eid="JHN 6:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 6:30" />Tegani pučle le: “Savo, onda, čudesno znako tu ka mothove amenđe, te šaj dikha hem te verujina će? So ka ćere? <verse eid="JHN 6:30" /><verse number="31" style="v" sid="JHN 6:31" />Amare pradada ani pustinja hale o maro vičime mana, sar soi pisime ano Sveta lila: ‘Dinđa len maro taro nebo te han.’”<verse eid="JHN 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 6:32" />O Isus phenđa lenđe: “Čače, čače vaćerava tumenđe, na dinđa tumen o Mojsije maro taro nebo, nego mlo Dad. Hem akana dela tumen e čačipnasoro maro taro nebo. <verse eid="JHN 6:32" /><verse number="33" style="v" sid="JHN 6:33" />Adalese so, e Devlesoroi maro okova kova huljela taro nebo hem dela dživdipe e svetose.”<verse eid="JHN 6:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 6:34" />Tegani phende lese: “Gospode, de amen uvek adava maro.”<verse eid="JHN 6:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 6:35" />A o Isus phenđa lenđe: “Me injum o maro savo dela dživdipe. Ko avela kora mande, naka ovel bokhalo, hem ko verujini ana mande, nikad naka ovel žedno. <verse eid="JHN 6:35" /><verse number="36" style="v" sid="JHN 6:36" />Ali, sar so phenđum tumenđe, dikhljen man, a palem na verujinena. <verse eid="JHN 6:36" /><verse number="37" style="v" sid="JHN 6:37" />Sarijen kolen mlo Dad dela man, ka aven kora mande hem esavken nikad naka ispudinav. <verse eid="JHN 6:37" /><verse number="38" style="v" sid="JHN 6:38" />Adalese so me na huljiljum taro nebo te ćerav mli volja, nego i volja Okolesiri kova bičhalđa man. <verse eid="JHN 6:38" /><verse number="39" style="v" sid="JHN 6:39" />A akajai i volja Okolesiri kova bičhalđa man: te na našalav nijekhe okolendar kolen dinđa man, nego te vazdav len taro mule ko Poslednjo dive. <verse eid="JHN 6:39" /><verse number="40" style="v" sid="JHN 6:40" />Adalese soi akaja i volja mle Dadesiri: svako kova dikhela e Čhave hem verujini ano leste, te ovel le večno dživdipe hem me te vazdav le taro mule ko Poslednjo dive.”<verse eid="JHN 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 6:41" />Tegani o Jevreja lelje te gunđinen protiv o Isus adalese so phenđa: “Me injum o maro savo huljilo taro nebo.”<verse eid="JHN 6:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 6:42" />Hem vaćerena ine: “Nane li akava o Isus, e Josifesoro čhavo? Amen džanaja lesere dade hem e daja. A sar akana vaćeri: ‘Huljiljum taro nebo’?”<verse eid="JHN 6:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 6:43" />A o Isus phenđa lenđe: “Ma gunđinen maškara tumende! <verse eid="JHN 6:43" /><verse number="44" style="v" sid="JHN 6:44" />Nijekh našti te avel kora mande te o Dad kova bičhalđa man na privucini le, a me ole ka vazdav taro mule ko Poslednjo dive. <verse eid="JHN 6:44" /><verse number="45" style="v" sid="JHN 6:45" />Sar so pisinde o Proroci: ‘Sare ka oven sikavde e Devlestar.’ Svako kova šunđa e Dade hem siklilo olestar, avela kora mande. <verse eid="JHN 6:45" /><verse number="46" style="v" sid="JHN 6:46" />Niko na dikhlja e Dade sem okoleste kova alo olestar – ov dikhlja e Dade. <verse eid="JHN 6:46" /><verse number="47" style="v" sid="JHN 6:47" />Čače, čače vaćerava tumenđe: Svako kova verujini ana mande, isi le večno dživdipe. <verse eid="JHN 6:47" /><verse number="48" style="v" sid="JHN 6:48" />Me injum o maro savo dela dživdipe. <verse eid="JHN 6:48" /><verse number="49" style="v" sid="JHN 6:49" />Tumare pradada hale mana ki pustinja, ali sare mule. <verse eid="JHN 6:49" /><verse number="50" style="v" sid="JHN 6:50" />Ali akava maro savo huljela taro nebo esavkoi da ko hala lestar na merela. <verse eid="JHN 6:50" /><verse number="51" style="v" sid="JHN 6:51" />Me injum o dživdo maro savo huljilo taro nebo. Ko ka hal akava maro, večno ka živini. Akavai maro mlo telo, savo ka dav te šaj o manuša taro sveto živinen.”<verse eid="JHN 6:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 6:52" />Tegani o Jevreja lelje zorale te raspravinen pe maškara pumende, pučindoj: “Sar akava manuš šaj te del amen plo telo te ha?”<verse eid="JHN 6:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 6:53" />A o Isus phenđa lenđe: “Čače, čače vaćerava tumenđe: Te na hana o telo e Manušesere Čhavesoro hem te na pijena lesoro rat, nane tumen dživdipe ana tumende. <verse eid="JHN 6:53" /><verse number="54" style="v" sid="JHN 6:54" />Ko hala mlo telo hem pijela mlo rat, isi le večno dživdipe hem me ka vazdav le taro mule ko Poslednjo dive. <verse eid="JHN 6:54" /><verse number="55" style="v" sid="JHN 6:55" />Adalese soi mlo telo čačikano hajba hem mlo rat čačikano piba. <verse eid="JHN 6:55" /><verse number="56" style="v" sid="JHN 6:56" />Okova kova hala mlo telo hem pijela mlo rat, ačhola ana mande hem me ano leste. <verse eid="JHN 6:56" /><verse number="57" style="v" sid="JHN 6:57" />Sar so man bičhalđa o dživdo Dad, hem me živinava zbog o Dad, ađahar hem okova kova hala man ka živini zbog mande. <verse eid="JHN 6:57" /><verse number="58" style="v" sid="JHN 6:58" />Me injum adava maro savo huljilo taro nebo, a na sar okova savo hale tumare pradada ani pustinja hem mule. Ko hala akava maro, večno ka živini.”<verse eid="JHN 6:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 6:59" />O Isus sa akava vaćerđa sikavindoj e manušen ani sinagoga ano Kafarnaum.<verse eid="JHN 6:59" /></para>
  <para style="s">Zbog e Isusesoro sikaviba, but učenici cidena pe olestar</para>
  <para style="p">
    <verse number="60" style="v" sid="JHN 6:60" />But lesere učenici, kad šunde adava, phende: “Adalai but phare lafija. Ko šaj te prihvatini len?”<verse eid="JHN 6:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="JHN 6:61" />A o Isus korkoro pestar džanđa da lesere učenici gunđinena zbog olesere lafija, i phenđa lenđe: “Akava li sikaviba ćerela tumen te odustajinen? <verse eid="JHN 6:61" /><verse number="62" style="v" sid="JHN 6:62" />A so onda ka phenen te dikhljen man, e Čhave e manušesere, sar džava upre ko nebo, adari kaj injumle angleder? <verse eid="JHN 6:62" /><verse number="63" style="v" sid="JHN 6:63" />O Duho dela dživdipe, a o telo ništa na dela. O lafija save me phenđum tumenđe, oni duho hem dživdipe. <verse eid="JHN 6:63" /><verse number="64" style="v" sid="JHN 6:64" />A palem isi nesave maškara tumende kola na verujinena.” O Isus phenđa adava adalese so pana oto početak džanđa kolai adala so naka verujinen ano leste hem kovai adava so ka izdajini le.<verse eid="JHN 6:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="JHN 6:65" />Hem phenđa: “Adalese phenđum tumenđe da nijekh našti te avel kora mande te nane lese dindo e Dadestar.”<verse eid="JHN 6:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="JHN 6:66" />Tegani but lesere učenici cidinde pe olestar hem na džele više palo leste.<verse eid="JHN 6:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="JHN 6:67" />I o Isus pučlja e dešu duje učenikonen: “Na li hem tumen mangena te džan mandar?”<verse eid="JHN 6:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="JHN 6:68" />A o Simon o Petar phenđa lese: “Gospode, kaste te dža? Te lafija dena večno dživdipe, <verse eid="JHN 6:68" /><verse number="69" style="v" sid="JHN 6:69" />hem amen poverujinđam hem džanaja da tu injan o Sveco e Devlesoro.”<verse eid="JHN 6:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="JHN 6:70" />A o Isus phenđa lenđe: “Na li me birinđum tumen e dešu dujen? A palem, jekhi tumendar beng!”<verse eid="JHN 6:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="JHN 6:71" />Adava vaćerđa e Judastar, e Simonesere e Iskariotesere čhavestar, jekhestar e dešu duje učenikonendar, kova ka izdajini le.<verse eid="JHN 6:71" /></para>
  <chapter eid="JHN 6" />
  <chapter number="7" style="c" sid="JHN 7" />
  <para style="s">E Isusese na verujinena ni lesere phralja</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 7:1" />Palo adava o Isus džala ine maškari regija Galileja. Na manglja te džal ki regija Judeja, adalese so e jevrejengere vođe adari mangle te mudaren le.<verse eid="JHN 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 7:2" />A avela ine paše e jevrejengoro Prazniko Senica, <verse eid="JHN 7:2" /><verse number="3" style="v" sid="JHN 7:3" />i e Isusesere phralja phende lese: “Ikljov akatar hem dža ki Judeja, te šaj dikhen te učenici o čudesija save ćereja. <verse eid="JHN 7:3" /><verse number="4" style="v" sid="JHN 7:4" />Adalese so, nijekh kova mangela te ovel pendžarutno, na garaj pe. Kad već ćereja esavke čudesija, mothov tut e svetose.”<verse eid="JHN 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 7:5" />Adalese so čak ni lesere phralja na verujinde ano leste.<verse eid="JHN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 7:6" />A o Isus phenđa lenđe: “Mlo vreme pana na alo, a tumen šaj te džan kad god mangena. <verse eid="JHN 7:6" /><verse number="7" style="v" sid="JHN 7:7" />O sveto našti te mrzini tumen, ali man mrzini, adalese so svedočinava protiv oleste, dai lesere delja bišukar. <verse eid="JHN 7:7" /><verse number="8" style="v" sid="JHN 7:8" />Džan tumen zako prazniko, a me pana na džava adari, adalese so mlo vreme pana na alo.”<verse eid="JHN 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 7:9" />Adava phenđa lenđe hem ačhilo ani Galileja.<verse eid="JHN 7:9" /></para>
  <para style="s">O Isus sikaj ano Hram</para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 7:10" />A kad lesere phralja džele te slavinen o prazniko, dželo hem ov, ali na javno, nego garandoj.<verse eid="JHN 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 7:11" />A e jevrejengere vođe zako prazniko rodinde le hem pučle: “Kaj okova?”<verse eid="JHN 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 7:12" />Maškaro narodo but vaćerđa pe olestar. Nesave vaćerena ine: “Ovi šukar manuš”, dok avera nesave vaćerena: “Nane, prevarini e narodo.” <verse eid="JHN 7:12" /><verse number="13" style="v" sid="JHN 7:13" />Ali nijekh na vaćerđa olestar javno, adalese so darandile e jevrejengere vođendar.<verse eid="JHN 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 7:14" />A ko ekvaš o prazniko, o Isus dželo ko Hram hem lelja te sikaj e narodo.<verse eid="JHN 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 7:15" />Kad šunde le, e jevrejengere vođe začudinde pe, i pučle pe: “Sar akava edobor šukar džanel o Sveta lila, a nikad na inele sikavdo?”<verse eid="JHN 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 7:16" />A o Isus phenđa lenđe: “Mlo sikaviba na avela mandar, nego Okolestar kova bičhalđa man. <verse eid="JHN 7:16" /><verse number="17" style="v" sid="JHN 7:17" />Ko mangela te ćerel e Devlesiri volja, ka džanel avela li akava sikaviba Olestar ili me vaćerava korkoro mandar. <verse eid="JHN 7:17" /><verse number="18" style="v" sid="JHN 7:18" />Ko vaćeri korkoro pestar, pese rodela slava. A ko rodela slava okolese kova bičhalđa le, vaćeri o čačipe hem koro leste nane hovajba. <verse eid="JHN 7:18" /><verse number="19" style="v" sid="JHN 7:19" />Na li o Mojsije dinđa tumen o Zakoni? A palem nijekh tumendar na ćerela palo Zakoni! Sose mangena te mudaren man?”<verse eid="JHN 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 7:20" />O manuša phende: “Ana tute isi demoni! Ko mangela te mudari tut?”<verse eid="JHN 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 7:21" />A o Isus phenđa lenđe: “Ćerđum jekh čudo hem sare divinena tumen. <verse eid="JHN 7:21" /><verse number="22" style="v" sid="JHN 7:22" />O Mojsije dinđa tumen o obreziba hem adalese tumen e čhavore obrezinena čak hem ko savato. Iako adava na avela e Mojsijastar, nego pana e pradadendar. <verse eid="JHN 7:22" /><verse number="23" style="v" sid="JHN 7:23" />I, te o manuš šaj te ovel obrezime ko savato, sar te na ovel phago e Mojsijasoro zakoni, sose edobor holjanena upra mande so ko savato sasljarđum sa o telo e manušesoro? <verse eid="JHN 7:23" /><verse number="24" style="v" sid="JHN 7:24" />Ma sudinen palo spoljašnjost, nego sudinen pravedno.”<verse eid="JHN 7:24" /></para>
  <para style="s">Ano Jerusalim na verujinena dai o Isus o Hrist</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 7:25" />Tegani nesave manuša taro Jerusalim vaćerde: “Nane li akava okova kole dikhena te mudaren? <verse eid="JHN 7:25" /><verse number="26" style="v" sid="JHN 7:26" />A ače, ov javno vaćeri hem niko lafi na phenela lese. Te na halile amare šerutne dai ov čače o Hrist? <verse eid="JHN 7:26" /><verse number="27" style="v" sid="JHN 7:27" />Ali amen džanaja kotari ov, a kad o Hrist ka avel, niko naka džanel kotari.”<verse eid="JHN 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 7:28" />I sar o Isus sikaj ine ano Hram, vičinđa: “Oja, pendžarena man! Hem džanen kotar injum! Na aljum korkoro mandar. Ali, čačikanoi Okova kova bičhalđa man, kole tumen na pendžarena. <verse eid="JHN 7:28" /><verse number="29" style="v" sid="JHN 7:29" />A me pendžarava le, adalese so me injum olestar hem Ov bičhalđa man.”<verse eid="JHN 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 7:30" />Tegani on mangle te dolen le, ali niko na čhivđa plo vas upro leste, adalese so lesoro vreme pana na alo.<verse eid="JHN 7:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 7:31" />A but džene taro narodo poverujinde ano leste, i phende: “O Hrist li, kad ka avel, ka ćerel više čudesna znakija nego so ćerđa len akava?”<verse eid="JHN 7:31" /></para>
  <para style="s">O Isus vaćeri so ka irini pe ko Devel</para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 7:32" />O fariseja šunde so o manuša adava garandoj vaćerena e Isusestar, i on hem o šerutne sveštenici bičhalde nesave stražaren te dolen le.<verse eid="JHN 7:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 7:33" />Tegani o Isus phenđa: “Pana hari ka ovav tumencar, a onda ka irinav man Okoleste kova bičhalđa man. <verse eid="JHN 7:33" /><verse number="34" style="v" sid="JHN 7:34" />Ka roden man, ali naka arakhen man, hem tumen našti te aven adari kaj me ka ovav.”<verse eid="JHN 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 7:35" />Tegani e jevrejengere vođe vaćerde maškara pumende: “Kaj adava ov mislini te džal, a te našti amen te arakha le? Na li mislini te džal koro Jevreja kolai rasejime maškaro Grci hem te sikaj e Grkonen? <verse eid="JHN 7:35" /><verse number="36" style="v" sid="JHN 7:36" />So manglja te vaćeri adaleja kad phenđa: ‘Ka roden man, ali naka arakhen man’, hem: ‘Tumen našti te aven adari kaj me ka ovav’?”<verse eid="JHN 7:36" /></para>
  <para style="s">O Devel ka del e Svetone Duho okolenđe kola verujinena ano Isus</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 7:37" />Kad inele o zadnjo hem o najbitno dive e praznikosoro, o Isus uštino ko pre hem vičindoj phenđa: “Tei neko žedno, nek avel mande hem nek pijel! <verse eid="JHN 7:37" /><verse number="38" style="v" sid="JHN 7:38" />Ko verujini ana mande, sar so vaćeri o Sveto lil, olestar ka thavden o lenja e dživde panjesoro.”<verse eid="JHN 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 7:39" />A o Isus adava vaćerđa e Svetone Duhostar, kole valjande te priminen okola kola verujinena ano leste. Adalese so, tegani o Sveto Duho pana na inele dindo, adalese so o Isus pana na irinđa pe pese ani slava.<verse eid="JHN 7:39" /></para>
  <para style="s">Nesave verujinena dai o Isus o Hrist, a nesave na</para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 7:40" />Kad šunde akala lafija, but džene taro narodo phende: “Akavai čače o Proroko kole adžićeraja.”<verse eid="JHN 7:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 7:41" />A avera phende: “Akavai o Hrist.”</para>
  <para style="p" vid="JHN 7:41">A, palem, nesave avera phende: “Nane. O Hrist li ka avel tari Galileja? <verse eid="JHN 7:41" /><verse number="42" style="v" sid="JHN 7:42" />Na pisini li ano Sveto lil da o Hrist ka avel taro e Davidesoro potomstvo hem taro Vitlejem, taro gav kotari o David?”<verse eid="JHN 7:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 7:43" />I ađahar zbog o Isus uli podela ano narodo. <verse eid="JHN 7:43" /><verse number="44" style="v" sid="JHN 7:44" />A nesave čak mangle te dolen le, ali niko na čhivđa plo vas upro leste.<verse eid="JHN 7:44" /></para>
  <para style="s">E jevrejengere vođe na verujinena dai o Isus proroko</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 7:45" />I o stražarija irinde pe koro šerutne sveštenici hem koro fariseja, a on pučle len: “Sose na anđen e Isuse?”<verse eid="JHN 7:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 7:46" />A o stražarija phende: “Niko nikad ađahar na vaćerđa sar adava manuš.”<verse eid="JHN 7:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 7:47" />A o fariseja phende lenđe: “Hem tumen li prevarinđa? <verse eid="JHN 7:47" /><verse number="48" style="v" sid="JHN 7:48" />Na li neko e šerutnendar ili e farisejendar poverujinđa ano leste? Na. <verse eid="JHN 7:48" /><verse number="49" style="v" sid="JHN 7:49" />Nego, akavai narodo prokleto, adalese so na pendžari o Zakoni!”<verse eid="JHN 7:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 7:50" />Tegani o Nikodim, okova kova angleder inele koro Isus, kovai jekh olendar, pučlja len: <verse eid="JHN 7:50" /><verse number="51" style="v" sid="JHN 7:51" />“Amaro li Zakoni mukela amenđe te osudina e manuše angleder nego so šunaja le hem dikhaja so ćerđa?”<verse eid="JHN 7:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 7:52" />A on phende lese: “Te na injan hem tu tari Galileja? Rode ano Sveto lil hem ka dikhe da nijekh proroko na avela tari Galileja!”<verse eid="JHN 7:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 7:53" />[I tegani sare dželefse čhere.<verse eid="JHN 7:53" /></para>
  <chapter eid="JHN 7" />
  <chapter number="8" style="c" sid="JHN 8" />
  <para style="s">I đuvli dolime ani preljuba</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 8:1" />A o Isus dželo ki e Maslinakiri gora, <verse eid="JHN 8:1" /><verse number="2" style="v" sid="JHN 8:2" />i rano sabale palem alo ano Hram. I sare čedinde pe uzalo leste, a ov beštino hem lelja te sikaj len.<verse eid="JHN 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 8:3" />A o učitelja e Zakonestar hem o fariseja ande koro Isus jekha đuvlja koja inele dolime ani preljuba. Čhivde la ko maškar, <verse eid="JHN 8:3" /><verse number="4" style="v" sid="JHN 8:4" />hem phende lese: “Učitelju, akajai đuvli dolimi kad ćerđa preljuba. <verse eid="JHN 8:4" /><verse number="5" style="v" sid="JHN 8:5" />Ano e Mojsijasoro zakoni terđola da esavka valjani te mudara ađahar so ka frda bara upro late. A so tu pheneja ko adava?”<verse eid="JHN 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 8:6" />On adava pučle le te iskušinen le, sar te ovel len zako sose te optužinen le.</para>
  <para style="p" vid="JHN 8:6">A o Isus telilo hem lelja te pisini najeja ki phuv.<verse eid="JHN 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 8:7" />Ali, adalese so na ačhavde te pučen le adava, ov ispravinđa pe, i phenđa lenđe: “Kovai tumendar bizo greh, prvo nek frdel bar upro late.”<verse eid="JHN 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 8:8" />Hem palem telilo hem pisinđa ki phuv.<verse eid="JHN 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 8:9" />Kad on šunde adava, jekh po jekh lelje te ciden pe adathar, počindoj e najphurederendar. I ađahar ačhile samo o Isus hem i đuvli koja terdini ko maškar.<verse eid="JHN 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 8:10" />Tegani o Isus ispravinđa pe hem pučlja la: “Đuvlije, kaj akala? Nijekh li olendar na osudinđa tut?”<verse eid="JHN 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 8:11" />A oj phenđa lese: “Nijekh, gospodarona.”</para>
  <para style="p" vid="JHN 8:11">Tegani o Isus phenđa laće: “Ni me na osudinava tut. Dža, hem od akana ma grešin više!”]<note caller="+" style="f"><char style="fr" closed="false">8,11 </char><char style="ft" closed="false">Ano najpurane rukopisija na terđona o stihija 7,53-8,11. </char></note><verse eid="JHN 8:11" /></para>
  <para style="s">O Isusi o svetlost savo legari ko dživdipe</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 8:12" />Tegani o Isus palem phenđa e manušenđe: “Me injum o svetlost e svetose. Ko džala pala mande, nikad naka phirel ani tomina, nego ka ovel le svetlost e dživdipnasoro.”<verse eid="JHN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 8:13" />Tegani o fariseja phende lese: “Tu korkoro tutar svedočineja. To svedočiba nane dovoljno.”<verse eid="JHN 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 8:14" />O Isus phenđa lenđe: “Čak hem te svedočinava korkoro mandar, mloi vaćeriba dovoljno, adalese so džanav kotar aljum hem kaj džava. A tumen na džanen ni kotar aljum ni kaj džava. <verse eid="JHN 8:14" /><verse number="15" style="v" sid="JHN 8:15" />Tumen sudinena telesno, a me na sudinava nikas. <verse eid="JHN 8:15" /><verse number="16" style="v" sid="JHN 8:16" />A hem te sudinđum, mloi sudo čačikano, adalese so na injum korkoro, negoi mancar o Dad kova bičhalđa man. <verse eid="JHN 8:16" /><verse number="17" style="v" sid="JHN 8:17" />Čak hem ano tumaro Zakoni pisini dai o svedočiba dovoljno te duj svedoci vaćerena isto. <verse eid="JHN 8:17" /><verse number="18" style="v" sid="JHN 8:18" />Me svedočinava korkoro mandar, a mandar svedočini hem o Dad, kova bičhalđa man.”<verse eid="JHN 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 8:19" />A o fariseja pučle le: “Kaj to dad?”</para>
  <para style="p" vid="JHN 8:19">O Isus phenđa lenđe: “Tumen na džanen ni man ni mle Dade. Te džanen ine ko injum me, ka džanen ine hem mle Dade.”<verse eid="JHN 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 8:20" />Sa adava o Isus vaćerđa uzalo kutije zako čediba o pare sar sikaj ine e manušen ano Hram, hem niko na dolinđa le, adalese so lesoro vreme pana na alo.<verse eid="JHN 8:20" /></para>
  <para style="s">O Jevreja pučena e Isuse koi ov</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 8:21" />O Isus palem phenđa lenđe: “Me džava, a tumen ka roden man, hem ka meren ano tumaro greh. Kaj me džava, tumen našti te aven.”<verse eid="JHN 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 8:22" />Tegani e jevrejengere vođe phende: “Na li akava mangela te mudari pe kad phenela: ‘Kaj me džava, tumen našti te aven’?”<verse eid="JHN 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 8:23" />A o Isus phenđa lenđe: “Tumen injen telal, a me injum upral. Tumen injen taro akava sveto, a me na injum taro akava sveto. <verse eid="JHN 8:23" /><verse number="24" style="v" sid="JHN 8:24" />Adalese phenđum tumenđe da ka meren ano tumare grehija. Te na verujinđen da Me Injum, ka meren ano tumare grehija.”<verse eid="JHN 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 8:25" />On pučle le: “Ko injan tu?”</para>
  <para style="p" vid="JHN 8:25">A o Isus phenđa lenđe: “Me injum okova so pana taro anglunipe vaćerava tumenđe da injum. <verse eid="JHN 8:25" /><verse number="26" style="v" sid="JHN 8:26" />Isi man but so te vaćerav tumendar ki tumari osuda. Okova kova bičhalđa man čačikanoi hem me e svetose vaćerava samo okova so olestar šunđum.”<verse eid="JHN 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 8:27" />On na halile da vaćeri lenđe e Dadestar.<verse eid="JHN 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 8:28" />Adalese o Isus phenđa lenđe: “Kad ka vazden e Čhave e manušesere, tegani ka džanen da Me Injum hem da ništa na ćerava korkoro mandar, nego da vaćerava okova so sikavđa man o Dad. <verse eid="JHN 8:28" /><verse number="29" style="v" sid="JHN 8:29" />A okova kova bičhalđa man, ovi mancar. Na ačhavđa man korkore, adalese so uvek ćerava okova soi lese šukar.”<verse eid="JHN 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 8:30" />I sar vaćeri ine adava, but džene poverujinde ano leste.<verse eid="JHN 8:30" /></para>
  <para style="s">E Isusesoro sikaviba anela oslobođenje</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 8:31" />Tegani o Isus phenđa e Jevrejenđe kola poverujinde ano leste: “Te ićerena tumen ko mlo sikaviba, čače injen mle učenici. <verse eid="JHN 8:31" /><verse number="32" style="v" sid="JHN 8:32" />Ka pendžaren o čačipe, hem o čačipe ka oslobodini tumen.”<verse eid="JHN 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 8:33" />A on phende lese: “Amen injam e Avraamesere potomci, hem nikad na injamle nikasere robija. Sar šaj te phene: ‘Ka oven slobodna’?”<verse eid="JHN 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 8:34" />O Isus phenđa lenđe: “Čače, čače phenava tumenđe, svako kova ćerela greh, ovi robo e grehese. <verse eid="JHN 8:34" /><verse number="35" style="v" sid="JHN 8:35" />E robo nane than ani familija zauvek, a e čhave isi zauvek. <verse eid="JHN 8:35" /><verse number="36" style="v" sid="JHN 8:36" />Adalese, te o Čhavo oslobodini tumen, čače ka oven slobodna. <verse eid="JHN 8:36" /><verse number="37" style="v" sid="JHN 8:37" />Džanav da injen e Avraamesere potomci, a palem, tumen mangena te mudaren man, adalese so ana tumende nane than mle lafese. <verse eid="JHN 8:37" /><verse number="38" style="v" sid="JHN 8:38" />Me vaćerava tumenđe okova so dikhljum koro mlo Dad, ali tumen ćerena okova so šunđen tumare dadestar.”<verse eid="JHN 8:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 8:39" />On phende lese: “Amaroi dad o Avraam.”</para>
  <para style="p" vid="JHN 8:39">A o Isus phenđa lenđe: “Te oven ine e Avraamesere čhave, ka ćeren ine okova so ov ćerđa. <verse eid="JHN 8:39" /><verse number="40" style="v" sid="JHN 8:40" />Ali tumen akana mangena te mudaren man, e manuše kova vaćerđa tumenđe o čačipe savo šunđa e Devlestar. O Avraam na ćerđa ađahar. <verse eid="JHN 8:40" /><verse number="41" style="v" sid="JHN 8:41" />Tumen ćerena okova so ćerela hem tumaro dad.”</para>
  <para style="p" vid="JHN 8:41">A on phende lese: “Amen na injam bijande tari preljuba. Jekh dad isi amen, adavai o Devel!”<verse eid="JHN 8:41" /></para>
  <para style="s">E bengesere čhavei okola kola na lena e Isusesoro sikaviba</para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 8:42" />A o Isus phenđa lenđe: “Te ovel ine o Devel tumaro dad, ka volinen man ine, adalese so me aljum taro Devel hem akana injum akate. Na aljum korkoro mandar, nego ov bičhalđa man. <verse eid="JHN 8:42" /><verse number="43" style="v" sid="JHN 8:43" />Sose na haljovena okova so vaćerava tumenđe? Adalese so našti te prihvatinen mlo lafi. <verse eid="JHN 8:43" /><verse number="44" style="v" sid="JHN 8:44" />Tumaroi dad o beng hem mangena te ćeren palo tumare dadesere želje. Ovi taro anglunipe ubica hem na ićerđa pe ko čačipe, adalese so ano leste nane čačipe. Kad hovaj, ov mothoj plo pravo muj, adalese soi hovavno hem dad e hovajbnasoro. <verse eid="JHN 8:44" /><verse number="45" style="v" sid="JHN 8:45" />A adalese so vaćerava tumenđe o čačipe, tumen na verujinena maje. <verse eid="JHN 8:45" /><verse number="46" style="v" sid="JHN 8:46" />Kova tumendar šaj te dokažini mlo greh? Te vaćerava tumenđe o čačipe, sose na verujinena maje? <verse eid="JHN 8:46" /><verse number="47" style="v" sid="JHN 8:47" />Kovai e Devlestar, šunela e Devlesere lafija. Tumen na šunena len adalese so na injen e Devlestar.”<verse eid="JHN 8:47" /></para>
  <para style="s">O Isus postojinđa angleder nego so o Avraam bijandilo</para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 8:48" />O Jevreja phende lese: “Na li amen šukar phenđam da tu injan Samarijanco hem da injan opsednutime demoneja?”<verse eid="JHN 8:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 8:49" />O Isus phenđa lenđe: “Na injum me opsednutime demoneja, nego me poštujinava mle Dade, a tumen man na poštujinena. <verse eid="JHN 8:49" /><verse number="50" style="v" sid="JHN 8:50" />Me na rodava slava maje – isi neko ko rodela la maje hem ko sudini. <verse eid="JHN 8:50" /><verse number="51" style="v" sid="JHN 8:51" />Čače, čače vaćerava tumenđe: ko ićeri pe ko mle lafija, nikad naka dikhel o meriba.”<verse eid="JHN 8:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 8:52" />A o Jevreja phende lese: “Akana džanaja da injan opsednutime demoneja. O Avraam mulo, a ađahar hem o proroci, a tu vaćereja: ‘Ko ićeri pe ko mle lafija, nikad naka dikhel o meriba.’ <verse eid="JHN 8:52" /><verse number="53" style="v" sid="JHN 8:53" />Na injan valjda po baro amare dadestar e Avraamestar, kova mulo. A hem o proroci da mule. Ko mislineja da tu injan?”<verse eid="JHN 8:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 8:54" />O Isus phenđa lenđe: “Te me korkore man proslavinava, mli slava nane ništa. Man proslavini mlo Dad, kolese tumen vaćerena dai tumaro Devel. <verse eid="JHN 8:54" /><verse number="55" style="v" sid="JHN 8:55" />Tumen na džanen le, ali me džanav le. Te phenav da na džanav le, ka ovav ine hovavno sar tumen. Ali me džanav le hem ićerava man ko lesoro lafi. <verse eid="JHN 8:55" /><verse number="56" style="v" sid="JHN 8:56" />Tumaro dad o Avraam but radujinđa pe so ka dikhel o dive oto mlo aviba. Dikhlja le hem but radujinđa pe.”<verse eid="JHN 8:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="JHN 8:57" />Tegani o Jevreja phende lese: “Nane tut ni pinda berš, a pheneja da dikhljan e Avraame!”<verse eid="JHN 8:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="JHN 8:58" />O Isus phenđa lenđe: “Čače, čače vaćerava tumenđe: angleder nego so o Avraam bijandilo, Me Injum!”<verse eid="JHN 8:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 8:59" />Tegani on lelje bara te frden upro leste, ali o Isus garavđa pe olendar hem iklilo taro Hram.<verse eid="JHN 8:59" /></para>
  <chapter eid="JHN 8" />
  <chapter number="9" style="c" sid="JHN 9" />
  <para style="s">O Isus sasljari e manuše kova bijandilo kororo</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 9:1" />Sar nakhela ine adathar, o Isus dikhlja e manuše kova inele kororo taro bijandipe.<verse eid="JHN 9:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 9:2" />A lesere učenici pučle le: “Učitelju, sose akava manuš bijandilo kororo? Adalese so ov ćerđa greh ili lesoro dad hem i daj?”<verse eid="JHN 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 9:3" />A o Isus phenđa: “Nane kororo adalese so grešinđa ov ili lesoro dad ili i daj. Ov bijando kororo te šaj upro leste mothoj pe o delja e Devlesere zoralipnastar. <verse eid="JHN 9:3" /><verse number="4" style="v" sid="JHN 9:4" />Sari dive, valjani te ćera o delja Okolesere kova bičhalđa man. Avela i rat, kad niko našti te ćerel buti. <verse eid="JHN 9:4" /><verse number="5" style="v" sid="JHN 9:5" />Sar injum ko sveto, me injum svetlost e svetose.”<verse eid="JHN 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 9:6" />Kad adava phenđa, čhungarđa ki phuv hem oto čhungar ćerđa čik, i adala čikaja makhlja e kororesere jaćha.<verse eid="JHN 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 9:7" />Tegani o Isus phenđa lese: “Dža thov to muj ko bazeni Siloam.” (Siloam značini “Bičhaldo”.)</para>
  <para style="p" vid="JHN 9:7">I o manuš dželo, thovđa plo muj hem irinđa pe čhere dikhindoj.<verse eid="JHN 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 9:8" />A lesere komšije hem okola kola angleder džande le sar prosjako, pučle pe: “Nane li akava okova kova bešela ine hem prosini?”<verse eid="JHN 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 9:9" />Nesave phende: “Ovi adava”, a avera phende: “Nane, nego samo ličini upro leste.”</para>
  <para style="p" vid="JHN 9:9">A ov phenđa: “Me injum.”<verse eid="JHN 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 9:10" />Tegani on pučle le: “Sar phravdile te jaćha?”<verse eid="JHN 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 9:11" />A ov phenđa: “O manuš kova vičini pe Isus, ćerđa čik hem olaja makhlja mle jaćha, hem phenđa maje: ‘Dža ko Siloam hem thov to muj.’ I me dželjum, thovđum mlo muj hem leljum te dikhav.”<verse eid="JHN 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 9:12" />On pučle le: “Kaj akana adava manuš?”</para>
  <para style="p" vid="JHN 9:12">A ov phenđa lenđe: “Na džanav.”<verse eid="JHN 9:12" /></para>
  <para style="s">O fariseja ispitujinena e sasljarde</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 9:13" />Tegani e manuše kova angleder inele kororo ande koro fariseja. <verse eid="JHN 9:13" /><verse number="14" style="v" sid="JHN 9:14" />A adava dive kad o Isus ćerđa i čik hem phravđa e kororesere jaćha inele savato. <verse eid="JHN 9:14" /><verse number="15" style="v" sid="JHN 9:15" />Adalese hem o fariseja pučle le sar phravdile lesere jaćha.</para>
  <para style="p" vid="JHN 9:15">A ov phenđa lenđe: “Makhlja mle jaćha e čikaja, me thovđum mlo muj hem akana dikhava.”<verse eid="JHN 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 9:16" />Tegani nesave fariseja phende: “Adava manuš nane e Devlestar, adalese so ćerela buti ko savato.”</para>
  <para style="p" vid="JHN 9:16">A avera phende: “Sar šaj o grešniko te ćerel esavke čudesna znakija?”</para>
  <para style="p" vid="JHN 9:16">Hem ađahar maškaro fariseja uli podela.<verse eid="JHN 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 9:17" />I palem phende e kororese: “Adava manuš phravđa te jaćha. So tu mislineja olestar?”</para>
  <para style="p" vid="JHN 9:17">A ov phenđa: “Ovi proroko.”<verse eid="JHN 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 9:18" />Ali e jevrejengere vođe na verujinde da o manuš inele kororo hem da phravdile lesere jaćha sa đikote na vičinde lesere dade hem e daja.<verse eid="JHN 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 9:19" />I pučle len: “Akava li tumaro čhavo kolese phenena da bijandilo kororo? Sar onda akana dikhela?”<verse eid="JHN 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 9:20" />A lesoro dad hem i daj phende: “Džanaja dai akava amaro čhavo hem da bijandilo kororo. <verse eid="JHN 9:20" /><verse number="21" style="v" sid="JHN 9:21" />Ali, sar onda akana dikhela hem ko phravđa lesere jaćha, na džanaja. Ole pučen. Ovi beršalo hem šaj te vaćeri korkoro pese.”<verse eid="JHN 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 9:22" />Lesoro dad hem i daj phende adava, adalese so darandile e jevrejengere vođendar, adalese so e jevrejengere vođe već odlučinde ine tari sinagoga te ikalen đijekhe kova priznajini e Isuse sar Hriste. <verse eid="JHN 9:22" /><verse number="23" style="v" sid="JHN 9:23" />Adalese lesoro dad hem i daj phende: “Ovi beršalo. Ole pučen!”<verse eid="JHN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 9:24" />Tegani pana jekhvar vičinde e manuše kova inele kororo, i phende lese: “Obećin anglo Devel da ka vaćere o čačipe! Amen džanaja dai adava manuš grešniko.”<verse eid="JHN 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 9:25" />A ov phenđa lenđe: “Me na džanav da li ov grešniko. Džanav samo da injumle kororo, a akana dikhava.”<verse eid="JHN 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 9:26" />A on palem pučle le: “So ćerđa će? Sar phravđa te jaćha?”<verse eid="JHN 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 9:27" />A ov phenđa lenđe: “Adava već phenđum tumenđe, ali na šunđen man. Sose palem mangena adava te šunen? Na li hem tumen mangena te oven lesere učenici?”<verse eid="JHN 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 9:28" />Tegani on lelje te vređinen le hem phende lese: “Tu injan lesoro učeniko, a amen injam e Mojsijasere učenici. <verse eid="JHN 9:28" /><verse number="29" style="v" sid="JHN 9:29" />Amen džanaja da o Devel vaćerđa e Mojsijase, a akalese na džanaja ni kotari.”<verse eid="JHN 9:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 9:30" />A o sasljardo manuš phenđa lenđe: “Čačei čudno akava! Tumen na džanen kotari, a ov phravđa mle jaćha. <verse eid="JHN 9:30" /><verse number="31" style="v" sid="JHN 9:31" />Džanaja da o Devel na šunela e grešnonen, ali šunela okolen kolai pobožna hem kola ćerena lesiri volja. <verse eid="JHN 9:31" /><verse number="32" style="v" sid="JHN 9:32" />Niko nikad na šunđa da neko phravđa o jaćha e manušesere kova bijandilo kororo. <verse eid="JHN 9:32" /><verse number="33" style="v" sid="JHN 9:33" />Te na ovel ine e Devlestar, naka šaj ine ništa te ćerel.”<verse eid="JHN 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 9:34" />A on phende lese: “Tu kova bijandiljan sa ano grehija arakhljan amen te sikave!” Hem frdinde le tari sinagoga.<verse eid="JHN 9:34" /></para>
  <para style="s">O duhovno kororipe</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 9:35" />O Isus šunđa so e sasljarde manuše frdinde tari sinagoga, i arakhlja le hem pučlja le: “Verujineja li ano Čhavo e manušesoro?”<verse eid="JHN 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 9:36" />A ov phenđa lese: “Phen maje koi ov, Gospode, te šaj verujinav ano leste.”<verse eid="JHN 9:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 9:37" />O Isus phenđa lese: “Već dikhljan le. Adavai okova kova vaćeri tuja.”<verse eid="JHN 9:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 9:38" />Tegani ov phenđa: “Verujinava, Gospode.” I pelo ko kočija anglo Isus.<verse eid="JHN 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 9:39" />O Isus phenđa lese: “Me aljum ko akava sveto te šaj e svetose ovel sudime, te šaj dikhen okola kola na dikhena hem te ačhoven korore okola kola mislinena da dikhena.”<verse eid="JHN 9:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 9:40" />Nesave fariseja kola inele oleja šunde adava, i pučle le: “Te na injam hem amen korore?”<verse eid="JHN 9:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 9:41" />A o Isus phenđa lenđe: “Te priznajinen ine da injen korore, naka oven ine kriva zako greh. Ali, adalese so phenena da dikhena, tumari krivica ačhola upra tumende.”<verse eid="JHN 9:41" /></para>
  <chapter eid="JHN 9" />
  <chapter number="10" style="c" sid="JHN 10" />
  <para style="s">O Isusi o šukar pastiri</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 10:1" />“Čače, čače vaćerava tumenđe, ko na đerdini ko udar kotei ogradime e bakrenđe, nego preskočindoj đerdini, ovi čor hem razbojniko. <verse eid="JHN 10:1" /><verse number="2" style="v" sid="JHN 10:2" />A ko đerdini ko udar, ovi e bakrengoro pastiri. <verse eid="JHN 10:2" /><verse number="3" style="v" sid="JHN 10:3" />Olese o stražari phravela o udar, a o bakre šunena lesoro glaso. Ov ple bakren vičini palo anav hem ikali len avri. <verse eid="JHN 10:3" /><verse number="4" style="v" sid="JHN 10:4" />Kad ikali sa ple bakren, džala anglo lende, a o bakre džana palo leste, adalese so pendžarena lesoro glaso. <verse eid="JHN 10:4" /><verse number="5" style="v" sid="JHN 10:5" />Naka džan palo abanđija, nego ka našen olestar, adalese so na pendžarena o glaso e abanđijasoro.”<verse eid="JHN 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 10:6" />O Isus vaćerđa lenđe adaja priča, ali on na halile so manglja te phenel lenđe adaleja.<verse eid="JHN 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 10:7" />Adalese o Isus palem vaćerđa lenđe: “Čače, čače, vaćerava tumenđe, me injum o udar e bakrenđe. <verse eid="JHN 10:7" /><verse number="8" style="v" sid="JHN 10:8" />Sare kola ale angleder mande, oni čora hem razbojnici, ali o bakre na šunde len. <verse eid="JHN 10:8" /><verse number="9" style="v" sid="JHN 10:9" />Me injum o udar. Ko đerdini prekala mande, ka ovel spasime. Ka đerdini hem ka ikljol hem ka arakhi hajbnase. <verse eid="JHN 10:9" /><verse number="10" style="v" sid="JHN 10:10" />O čor avela samo te čorel, te mudari hem te uništini. Me aljum e manušen te ovel dživdipe, hem adava dživdipe ano izobilje.<verse eid="JHN 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 10:11" />Me injum o šukar pastiri. O šukar pastiri dela plo dživdipe zako bakre. <verse eid="JHN 10:11" /><verse number="12" style="v" sid="JHN 10:12" />A o manuš kovai platime te pazini e bakren – adalese so nane pastiri hem o bakre nane olesere – kad dikhela e ruve sar avela, ačhaj e bakren hem našela. A o ruv napadini e bakren hem ćerela len te našen ko sa o strane. <verse eid="JHN 10:12" /><verse number="13" style="v" sid="JHN 10:13" />Adalese soi samo platime manuš, olese na ačhilo đi o bakre.<verse eid="JHN 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 10:14" />Me injum o šukar pastiri. Me pendžarava mle bakren hem mle bakre pendžarena man, <verse eid="JHN 10:14" /><verse number="15" style="v" sid="JHN 10:15" />ađahar sar so o Dad pendžari man hem sar so me pendžarava e Dade. Me dava mlo dživdipe zako bakre. <verse eid="JHN 10:15" /><verse number="16" style="v" sid="JHN 10:16" />Isi man hem avera bakre, kola nane taro akava stado; hem olen valjani te anav. Hem on ka šunen mlo glaso, i ka ovel jekh stado jekhe pastireja. <verse eid="JHN 10:16" /><verse number="17" style="v" sid="JHN 10:17" />Adalese mlo Dad volini man, so dava mlo dživdipe – te šaj palem te lav le. <verse eid="JHN 10:17" /><verse number="18" style="v" sid="JHN 10:18" />Niko na lela le mandar, nego me korkoro mandar dava le. Isi man vlast te dav le hem isi man vlast palem te lav le. Adaja naredba priminđum mle Dadestar.”<verse eid="JHN 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 10:19" />Zbog akala lafija maškaro Jevreja palem uli podela. <verse eid="JHN 10:19" /><verse number="20" style="v" sid="JHN 10:20" />But Jevreja phende: “Ovi opsednutime demoneja hem dilindilo. Sose šunena le?”<verse eid="JHN 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 10:21" />A avera phende: “Adava nane o lafija e manušesere kovai opsednutime demoneja. Šaj li o demoni te phravel e kororengere jaćha?”<verse eid="JHN 10:21" /></para>
  <para style="s">O Isus vaćeri dai ov e Devlesoro Čhavo</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 10:22" />Tegani ano Jerusalim slavinđa pe o prazniko Hanuka, o posvećenje e Hramesoro. Inele jevend.<verse eid="JHN 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 10:23" />O Isus nakhela ine maškari phravdi terasa e Solomonesiri ano Hram. <verse eid="JHN 10:23" /><verse number="24" style="v" sid="JHN 10:24" />A e jevrejengere vođe okružinde le hem phende lese: “Đikote ka garave amendar ko tu injan? Te injan o Hrist, phen amenđe phravdeste!”<verse eid="JHN 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 10:25" />A o Isus phenđa lenđe: “Već phenđum tumenđe angleder, ali tumen na verujinena. O delja save ćerava ano anav mle Dadesoro – on svedočinena mandar. <verse eid="JHN 10:25" /><verse number="26" style="v" sid="JHN 10:26" />Ali tumen na verujinena, adalese so na injen mle bakre. <verse eid="JHN 10:26" /><verse number="27" style="v" sid="JHN 10:27" />Mle bakre šunena mlo glaso hem me pendžarava len, hem on džana pala mande. <verse eid="JHN 10:27" /><verse number="28" style="v" sid="JHN 10:28" />Me dava len večno dživdipe hem on nikad naka meren. Niko naka čorel len mle vastendar. <verse eid="JHN 10:28" /><verse number="29" style="v" sid="JHN 10:29" />Mlo Dad, kova dinđa man len, po baroi sarijendar, hem niko našti te čorel len mle Dadesere vastendar. <verse eid="JHN 10:29" /><verse number="30" style="v" sid="JHN 10:30" />Me hem o Dad jekh injam.”<verse eid="JHN 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 10:31" />Tegani e jevrejengere vođe palem mangle te mudaren le hem lelje bara sar te frden upro leste, <verse eid="JHN 10:31" /><verse number="32" style="v" sid="JHN 10:32" />a o Isus phenđa lenđe: “Mothovđum tumenđe but šukar delja e Dadestar. Zako save olendar mangena te mudaren man barencar?”<verse eid="JHN 10:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 10:33" />A o Jevreja phende lese: “Na mangaja te mudara tut barencar zako šukar delja, nego so hulineja upro Devel. Tu injan samo manuš, a pheneja da injan Devel!”<verse eid="JHN 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 10:34" />O Isus phenđa lenđe: “Nane li pisime tumenđe ano zakoni: ‘Me phenđum: tumen injen develja’? <verse eid="JHN 10:34" /><verse number="35" style="v" sid="JHN 10:35" />Te o Devel e manušen kolenđe alo o lafi e Devlesoro vičinđa develja – a o Sveto lil našti te promenini pe – <verse eid="JHN 10:35" /><verse number="36" style="v" sid="JHN 10:36" />sar onda šaj okolese kole o Dad posvetinđa hem bičhalđa ko sveto te phenen: ‘Hulineja’, adalese so phenđum da injum o Čhavo e Devlesoro? <verse eid="JHN 10:36" /><verse number="37" style="v" sid="JHN 10:37" />Te na ćerava o delja mle Dadesere, ma verujinen maje. <verse eid="JHN 10:37" /><verse number="38" style="v" sid="JHN 10:38" />Ali te ćerava len, sa hem te na verujinen maje, verujinen olenđe, te džanen dai o Dad ana mande hem me ano Dad.”<verse eid="JHN 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 10:39" />Tegani on palem mangle te dolen le, ali ov našlo lenđe taro vasta.<verse eid="JHN 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 10:40" />O Isus palem nakhlo ki aver strana oti len Jordan, ko than kaj o Jovan angleder krstini ine, hem ačhilo adari.<verse eid="JHN 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 10:41" />A but manuša ale koro leste hem vaćerena ine: “O Jovan na ćerđa nijekh čudesno znako, ali čače inele sa so phenđa akale manušestar.”<verse eid="JHN 10:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 10:42" />Hem but džene adari poverujinde ano Isus.<verse eid="JHN 10:42" /></para>
  <chapter eid="JHN 10" />
  <chapter number="11" style="c" sid="JHN 11" />
  <para style="s">E Lazaresoro meriba</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 11:1" />Nesavo manuš palo anav Lazar inele namborme. Ov inele tari Vitanija, taro gav kaj živinde i Marija hem lakiri phen i Marta. <verse eid="JHN 11:1" /><verse number="2" style="v" sid="JHN 11:2" />I Marija inele okoja đuvli koja čhorđa o miris upro e Gospodesere pre hem koslja len ple balencar. O Lazar, kova inele namborme, inele lakoro phral.<verse eid="JHN 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 11:3" />Adalese o phenja bičhalde lafi e Isusese: “Gospode, ače, nambormei to volime amal.”<verse eid="JHN 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 11:4" />Kad o Isus šunđa adava, phenđa: “Akava nambormipe naka završini pe meribnaja, nego ka ovel e Devlese ki slava, te šaj prekalo adava proslavini pe o Čhavo e Devlesoro.”<verse eid="JHN 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 11:5" />A o Isus volinđa e Marta, lakere phenja hem e Lazare. <verse eid="JHN 11:5" /><verse number="6" style="v" sid="JHN 11:6" />I kad šunđa dai o Lazar namborme, ačhilo pana duj dive adari kaj inele, <verse eid="JHN 11:6" /><verse number="7" style="v" sid="JHN 11:7" />i tegani phenđa ple učenikonenđe: “Hajde palem ki Judeja.”<verse eid="JHN 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 11:8" />A o učenici phende lese: “Učitelju, na li e jevrejengere vođe angleder nekobor dive mangle te mudaren tut barencar, a tu palem mangeja te dža adari?”<verse eid="JHN 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 11:9" />O Isus phenđa lenđe: “Nane li e dive dešu duj saća? Ko phirela diveja, na perela, adalese so dikhela o svetlost akale svetosoro. <verse eid="JHN 11:9" /><verse number="10" style="v" sid="JHN 11:10" />Ali, ko phirela raćaja, ka perel, adalese so nane svetlost ano leste.”<verse eid="JHN 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 11:11" />Palo adala lafija, phenđa hem akava: “Amaro amal o Lazar zasuća, ali me džava te vazdav le.”<verse eid="JHN 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 11:12" />A o učenici phende lese: “Gospode, te zasuća, ka sasljol.”<verse eid="JHN 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 11:13" />Ali o Isus vaćerđa lenđe e Lazaresere meribnastar, a on mislinde da vaćeri da o Lazar sovela.<verse eid="JHN 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 11:14" />Tegani o Isus phravdeste phenđa lenđe: “O Lazar mulo. <verse eid="JHN 11:14" /><verse number="15" style="v" sid="JHN 11:15" />Zbog tumende radujinav man so na injumle adari, te šaj verujinen. Ali, hajde akana koro leste.”<verse eid="JHN 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 11:16" />Tegani o Toma vičime Blizanco phenđa avere učenikonenđe: “Hajde hem amen te mera e Isuseja.”<verse eid="JHN 11:16" /></para>
  <para style="s">O Isusi o uštiba taro mule hem o dživdipe</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 11:17" />Kad o Isus reslja adari, dodžanđa dai o Lazar štar dive već ano grobo. <verse eid="JHN 11:17" /><verse number="18" style="v" sid="JHN 11:18" />A i Vitanijai taro Jerusalim dur đi sar trin kilometarija, <verse eid="JHN 11:18" /><verse number="19" style="v" sid="JHN 11:19" />i but Jevreja adathar ale ki Marta hem ki Marija te tešinen len zbog lengoro phral. <verse eid="JHN 11:19" /><verse number="20" style="v" sid="JHN 11:20" />Kad i Marta šunđa da o Isus avela, lelja te džal nakoro leste, a i Marija ačhili čhere.<verse eid="JHN 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 11:21" />Tegani i Marta phenđa e Isusese: “Gospode, te ove ine akate, mlo phral naka merel ine. <verse eid="JHN 11:21" /><verse number="22" style="v" sid="JHN 11:22" />Ali me hem akana džanav da o Devel ka del tut sa so rodeja lestar.”<verse eid="JHN 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 11:23" />O Isus phenđa laće: “To phral ka uštel taro mule!”<verse eid="JHN 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 11:24" />A i Marta phenđa lese: “Džanav da ka uštel taro mule tegani kad sare ka ušten taro mule ko Poslednjo dive.”<verse eid="JHN 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 11:25" />O Isus phenđa laće: “Me injum o uštiba taro mule hem o dživdipe. Ko verujini ana mande, čak hem te merel, ka živini. <verse eid="JHN 11:25" /><verse number="26" style="v" sid="JHN 11:26" />Hem svako kova živini hem verujini ana mande, nikad naka merel. Verujineja li ano adava?”<verse eid="JHN 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 11:27" />A oj phenđa lese: “Oja, Gospode! Verujinava da tu injan o Hrist, o Čhavo e Devlesoro, kova valjanđa te avel ko sveto.”<verse eid="JHN 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 11:28" />Kad phenđa adava, dželi hem vičinđa pla phenja e Marija hem pohari phenđa laće: “Akatei o učitelj hem rodela tut.”<verse eid="JHN 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 11:29" />Kad i Marija šunđa adava, sig uštini hem dželi nakoro leste. <verse eid="JHN 11:29" /><verse number="30" style="v" sid="JHN 11:30" />A o Isus pana na đerdinđa ano gav, nego pana inele adari kaj i Marta reslja le. <verse eid="JHN 11:30" /><verse number="31" style="v" sid="JHN 11:31" />A kad o Jevreja kola inele e Marijaja ano čher hem tešinde la, dikhle da ki sig uštini hem iklili, lelje te džan palo late, mislindoj da džala ko grobo te rovel adari.<verse eid="JHN 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 11:32" />Kad i Marija resli adari kaj inele o Isus hem kad dikhlja le, peli anglo lesere pre hem phenđa lese: “Gospode, te ove ine akate, mlo phral naka merel ine.”<verse eid="JHN 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 11:33" />Kad o Isus dikhlja ola hem e Jevrejen kola ale olaja sar rovena, pelo lese žal hem ine lese but pharo, <verse eid="JHN 11:33" /><verse number="34" style="v" sid="JHN 11:34" />i pučlja len: “Kaj čhivđen le?” On phende lese: “Gospode, ava hem dikh.”<verse eid="JHN 11:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 11:35" />A o Isus lelja te rovel.<verse eid="JHN 11:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 11:36" />Tegani o Jevreja phende: “Dikh kobor volinđa le!”<verse eid="JHN 11:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 11:37" />Ali nesave olendar phende: “Našti ine li ov, kova e kororesere jaćha phravđa, te ćerel akava manuš te na merel?”<verse eid="JHN 11:37" /></para>
  <para style="s">O Isus vazdela taro mule e Lazare</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 11:38" />I e Isusese palem ine but pharo, i dželo ko grobo. Adava inele i pećina ko savakoro udar inele pašljardo o bar.<verse eid="JHN 11:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 11:39" />O Isus phenđa: “Ciden o bar.”</para>
  <para style="p" vid="JHN 11:39">A i Marta, i phen e mulesiri, phenđa lese: “Gospode, već khandela, adalese soi štarto dive sari ano grobo.”<verse eid="JHN 11:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 11:40" />O Isus pučlja la: “Na li phenđum će da ka dikhe e Devlesiri slava te verujinđan?”<verse eid="JHN 11:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 11:41" />Tegani cidinde o bar, a o Isus dikhlja nakoro nebo hem phenđa: “Dade, hvala će so šunđan man.<verse eid="JHN 11:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 11:42" />Džanav da tu uvek šuneja man, ali akava vaćerđum zbog o manuša kola akate terđovena, te poverujinen da tu bičhalđan man.”<verse eid="JHN 11:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 11:43" />Kad phenđa adava, vičinđa oto sa o glaso: “Lazare, ikljov!”<verse eid="JHN 11:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 11:44" />I o mulo iklilo. Lesere vasta hem o pre inele paćarde zavojencar, a lesoro muj inele paćardo maramicaja.</para>
  <para style="p" vid="JHN 11:44">A o Isus phenđa lenđe: “Huljaven lestar adava hem muken le te džal!”<verse eid="JHN 11:44" /></para>
  <para style="s">O šerutne sveštenici hem o fariseja mangena te dolen e Isuse</para>
  <para style="r">(<ref loc="MAT 26:1-5">Mt 26,1–5</ref>; <ref loc="MRK 14:1-2">Mk 14,1–2</ref>; <ref loc="LUK 22:1-2">Lk 22,1–2</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 11:45" />Tegani but Jevreja, kola ale kori Marija hem dikhle so o Isus ćerđa, poverujinde ano leste. <verse eid="JHN 11:45" /><verse number="46" style="v" sid="JHN 11:46" />Ali nesave olendar džele koro fariseja hem vaćerde lenđe okova so o Isus ćerđa.<verse eid="JHN 11:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 11:47" />Tegani o šerutne sveštenici hem o fariseja čedinde pe ko sabor, i phende: “So te ćera? Adava manuš ćerela but čudesna znakija. <verse eid="JHN 11:47" /><verse number="48" style="v" sid="JHN 11:48" />Te mukljam lese te ćerel ađahar sa o manuša ka poverujinen ano leste. Tegani ka aven o Rimljanja hem ka uništinen amaro Hram hem amare narodo.”<verse eid="JHN 11:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 11:49" />A jekh olendar, o Kajafa, kova adava berš inele prvosvešteniko, phenđa lenđe: “Tumen ništa na džanen! <verse eid="JHN 11:49" /><verse number="50" style="v" sid="JHN 11:50" />Na haljovena dai tumenđe po šukar jekh manuš te merel zako narodo, nego sa o narodo te properel.”<verse eid="JHN 11:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="JHN 11:51" />O Kajafa na phenđa adava korkoro pestar, nego, adalese so adava berš inele prvosvešteniko, prorokujinđa da o Isus ka merel zako sa o narodo e Jevrejengoro. <verse eid="JHN 11:51" /><verse number="52" style="v" sid="JHN 11:52" />Hem na samo zako adava narodo, nego hem te bi čedela sa e Devlesere rasejime čhaven.<verse eid="JHN 11:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 11:53" />Ađahar adava dive e jevrejengere vođe dogovorinde pe te mudaren e Isuse.<verse eid="JHN 11:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 11:54" />Adalese o Isus na tromandilo te phirel javno maškaro e jevrejengere vođe, nego adathar dželo paše uzali pustinja, ano gav Efrem, hem adari inele ple učenikonencar.<verse eid="JHN 11:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="JHN 11:55" />A inele paše e jevrejengoro prazniko Pasha hem but Jevreja taro avera dizja hem gava ale ko Jerusalim te očistinen pe angleder i Pasha. <verse eid="JHN 11:55" /><verse number="56" style="v" sid="JHN 11:56" />Rodinde e Isuse hem, terdindoj ano Hram pučle jekh avere: “So mislinena, ka avel li ki Pasha?”<verse eid="JHN 11:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="JHN 11:57" />A o šerutne sveštenici hem o fariseja već dinde naredba, ko ka dodžanel kaj o Isus te vaćeren lenđe, te šaj dolen le.<verse eid="JHN 11:57" /></para>
  <chapter eid="JHN 11" />
  <chapter number="12" style="c" sid="JHN 12" />
  <para style="s">O Isus pomazime ani Vitanija</para>
  <para style="r">(<ref loc="MAT 26:6-13">Mt 26,6–13</ref>; <ref loc="MRK 14:3-9">Mk 14,3–9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 12:1" />Šov dive angleder o prazniko Pasha, o Isus dželo ki Vitanija, kaj inele o Lazar, kole vazdinđa taro mule. <verse eid="JHN 12:1" /><verse number="2" style="v" sid="JHN 12:2" />Adari spreminde lese večera. I Marta poslužini ine, a o Lazar inele maškaro okolende kola e Isuseja inele uzalo astali. <verse eid="JHN 12:2" /><verse number="3" style="v" sid="JHN 12:3" />Tegani i Marija lelja ekvaš litar oto but skupo mirisno ulje savoi ćerdo oto čisto nard, makhlja e Isusesere pre hem koslja len ple balencar. Hem sa o čher mirišinđa ano ulje.<verse eid="JHN 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 12:4" />A jekh oto e Isusesere učenici, o Juda Iskariot, kova posle ka izdajini e Isuse, phenđa: <verse eid="JHN 12:4" /><verse number="5" style="v" sid="JHN 12:5" />“Sose akava mirisno ulje na bikninđa pe zako trišel srebrna kovanice, a o pare te den pe e čororenđe?”<verse eid="JHN 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 12:6" />Ov na phenđa adava adalese so ačhilo lese zako čorore, nego adalese so inele čor: oleste inele o zajednička pare, hem adathar čorela ine pese.<verse eid="JHN 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 12:7" />Tegani o Isus phenđa: “Muk la! Adava ćerđa te pripremini man zako paruniba. <verse eid="JHN 12:7" /><verse number="8" style="v" sid="JHN 12:8" />Maškara tumende uvek ka oven čorore manuša, ali me naka ovav uvek tumencar.”<verse eid="JHN 12:8" /></para>
  <para style="s">O šerutne sveštenici mangena te mudaren e Lazare</para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 12:9" />But Jevreja dodžande dai o Isus ki Vitanija hem džele adari, ali na džele samo zbog o Isus, nego hem zbog o Lazar, kole o Isus vazdinđa taro mule. <verse eid="JHN 12:9" /><verse number="10" style="v" sid="JHN 12:10" />A o šerutne sveštenici odlučinde te mudaren hem e Lazare, <verse eid="JHN 12:10" /><verse number="11" style="v" sid="JHN 12:11" />adalese so zbog oleste but Jevreja džana ine palo Isus hem verujinena ano leste.<verse eid="JHN 12:11" /></para>
  <para style="s">O Isus đerdini ko Jerusalim sar caro</para>
  <para style="r">(<ref loc="MAT 21:1-11">Mt 21,1–11</ref>; <ref loc="MRK 11:1-11">Mk 11,1–11</ref>; <ref loc="LUK 19:28-40">Lk 19,28–40</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 12:12" />Tejsato dive but manuša ale ko prazniko, i kad šunde da o Isus avela ko Jerusalim, <verse eid="JHN 12:12" /><verse number="13" style="v" sid="JHN 12:13" />lelje granke oti palma hem iklile anglo leste, vičindoj:</para>
  <para style="q1" vid="JHN 12:13">“Hosana!</para>
  <para style="q2" vid="JHN 12:13">Blagoslovimei okova kova avela ano anav e Gospodesoro!</para>
  <para style="q1" vid="JHN 12:13">Blagoslovimei o Caro e Izraelesoro!”<verse eid="JHN 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 12:14" />A o Isus arakhlja jekhe terne here hem beštino upro leste, sar soi pisime ano Sveto lil:<verse eid="JHN 12:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JHN 12:15" />“Ma dara, Jerusalime!</para>
  <para style="q2" vid="JHN 12:15">Ače, to Caro avela bešindoj upro terno her.”<verse eid="JHN 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 12:16" />Lesere učenici tegani na halile akava, ali kad o Isus legardilo ani slava, setinde pe so adava inele pisime olestar hem da baš ađahar ćerde lese.<verse eid="JHN 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 12:17" />A o manuša kola inele e Isuseja kad vičinđa e Lazare taro grobo hem vazdinđa le taro mule, svedočinde adalestar averenđe. <verse eid="JHN 12:17" /><verse number="18" style="v" sid="JHN 12:18" />Adalese sa edobor manuša iklile anglo leste, so šunde dai ov adava kova ćerđa adava čudesno znako.<verse eid="JHN 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 12:19" />Tegani o fariseja phende jekh averese: “Dikhena da našti ništa te ćera! Sa o sveto dželo palo leste!”<verse eid="JHN 12:19" /></para>
  <para style="s">O Isus vaćeri ple meribnastar</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 12:20" />A maškaro manuša kola ale ko prazniko te slavinen e Devle inele hem Grci. <verse eid="JHN 12:20" /><verse number="21" style="v" sid="JHN 12:21" />On ale koro Filip, kova inele tari Vitsaida ani Galileja, hem zamolinde le, vaćerindoj: “Gospodarona, amen mangaja te dikha e Isuse.”<verse eid="JHN 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 12:22" />O Filip dželo hem phenđa adava e Andrejase, i on duj džele hem phende adava e Isusese.<verse eid="JHN 12:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 12:23" />A o Isus phenđa lenđe: “Alo o vreme te proslavini pe o Čhavo e manušesoro. <verse eid="JHN 12:23" /><verse number="24" style="v" sid="JHN 12:24" />Čače, čače vaćerava tumenđe: te e đivesoro zrno na perela ki phuv hem na merela, ačhola korkoro. A te merela, anela but bijandipe. <verse eid="JHN 12:24" /><verse number="25" style="v" sid="JHN 12:25" />Ko volini plo dživdipe, ka našali le, a ko mrzini plo dživdipe ko akava sveto, ka arakhi le zako večno dživdipe. <verse eid="JHN 12:25" /><verse number="26" style="v" sid="JHN 12:26" />Ko služini maje, mora te phirel pala mande. Kaj injum me, adari ka ovel hem mlo sluga. Mlo Dad ka mothoj čast okolese kova služini maje.<verse eid="JHN 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 12:27" />Mli dušai akana uznemirime. So te phenav? ‘Dade, spasin man adalestar so adžićeri man’? Na, adalese so me hem aljum zako adava. <verse eid="JHN 12:27" /><verse number="28" style="v" sid="JHN 12:28" />Dade, proslavin to anav!”</para>
  <para style="p" vid="JHN 12:28">Tegani taro nebo šundilo glaso: “Proslavinđum hem palem ka proslavinav!”<verse eid="JHN 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 12:29" />Kad o narodo kova adari terdino šunđa adava, phenđa da grminđa. A avera phende da o anđeo vaćerđa lese adava.<verse eid="JHN 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 12:30" />O Isus phenđa lenđe: “Akava glaso na šundilo zbog mande, nego zbog tumende. <verse eid="JHN 12:30" /><verse number="31" style="v" sid="JHN 12:31" />Akanai o vreme te sudini pe akale svetose. Akana o vladari akale svetosoro ka ovel frdime avri. <verse eid="JHN 12:31" /><verse number="32" style="v" sid="JHN 12:32" />A me, kad ka ovav vazdime tari phuv, sa e manušen ka cidav nakora mande.”<verse eid="JHN 12:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 12:33" />Adava phenđa sar te mothoj savo meriba adžićeri le.<verse eid="JHN 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 12:34" />Tegani o narodo phenđa lese: “Šunđam taro Zakoni da o Hrist ka živini zauvek. Sar onda vaćereja da o Čhavo e manušesoro valjani te merel? Kovai adava ‘Čhavo e manušesoro’?”<verse eid="JHN 12:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 12:35" />A o Isus phenđa lenđe: “O svetlost samo pana hari ka ovel maškar tumende. Phiren sar isi tumen svetlost, te na prelel tumen i tomina. Adalese so, ko phirela ki tomina, na džanel kaj džala. <verse eid="JHN 12:35" /><verse number="36" style="v" sid="JHN 12:36" />Sar isi tumen svetlost, verujinen ano svetlost, te oven čhave e svetlosere.”</para>
  <para style="p" vid="JHN 12:36">Kad phenđa adava, dželo hem garavđa pe olendar.<verse eid="JHN 12:36" /></para>
  <para style="s">O Jevreja na verujinena ano Isus</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 12:37" />Iako o Isus edobor čudesna znakija ćerđa anglo lende, on palem na verujinde lese. <verse eid="JHN 12:37" /><verse number="38" style="v" sid="JHN 12:38" />A sa adava inele sar te pherđol okova so vaćerđa o proroko Isaija:</para>
  <para style="q1" vid="JHN 12:38">“Gospode, ko poverujinđa amare lafenđe</para>
  <para style="q2" vid="JHN 12:38">hem kase mothovđa pe o zoralo vas e Gospodesoro?”<verse eid="JHN 12:38" /></para>
  <para style="m">
    <verse number="39" style="v" sid="JHN 12:39" />Adalese našti ine te poverujinen, adalese so o Isaija phenđa hem akava:<verse eid="JHN 12:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="JHN 12:40" />“O Devel korjarđa lengere jaćha,</para>
  <para style="q2" vid="JHN 12:40">hem steđinđa lengere vile,</para>
  <para style="q1" vid="JHN 12:40">jaćhencar te na dikhen</para>
  <para style="q2" vid="JHN 12:40">hem vileja te na haljoven,</para>
  <para style="q1" vid="JHN 12:40">hem te na irinen pe,</para>
  <para style="q2" vid="JHN 12:40">te sasljarav len.”<verse eid="JHN 12:40" /></para>
  <para style="m">
    <verse number="41" style="v" sid="JHN 12:41" />O Isaija adava phenđa, adalese so dikhlja e Isusesiri slava hem vaćerđa olestar.<verse eid="JHN 12:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 12:42" />A čak hem but vođe e jevrejengere verujinde ano leste, ali na mangle te priznajinen zbog o fariseja, sar te na oven ikalde oti sinagoga. <verse eid="JHN 12:42" /><verse number="43" style="v" sid="JHN 12:43" />Adalese so, više volinde o manuša te hvalinen len nego o Devel.<verse eid="JHN 12:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 12:44" />A o Isus vičinđa oto sa o glaso: “Ko verujini ana mande, na verujini samo ana mande, nego hem ano Okoleste kova bičhalđa man. <verse eid="JHN 12:44" /><verse number="45" style="v" sid="JHN 12:45" />Hem ko dikhela man, dikhela hem Okole kova bičhalđa man. <verse eid="JHN 12:45" /><verse number="46" style="v" sid="JHN 12:46" />Me injum o Svetlost savo alo ko sveto, da svako kova verujini ana mande te na ačhol ani tomina. <verse eid="JHN 12:46" /><verse number="47" style="v" sid="JHN 12:47" />Ko šunela mle lafija, a na ćerela len, me na sudinava lese. Adalese so, me na aljum te sudinav e svetose, nego te spasinav o sveto. <verse eid="JHN 12:47" /><verse number="48" style="v" sid="JHN 12:48" />Ko odbacini man hem na prihvatini mle lafija, isi le lesoro sudija: o Lafi savo vaćerđum ka sudini lese ko Poslednjo dive. <verse eid="JHN 12:48" /><verse number="49" style="v" sid="JHN 12:49" />Adalese so, me na vaćerđum korkoro mandar, nego korkoro mlo Dad, kova bičhalđa man, naredinđa maje so te phenav hem so te vaćerav. <verse eid="JHN 12:49" /><verse number="50" style="v" sid="JHN 12:50" />A me džanav da olesere naredbe dena večno dživdipe. Me vaćerava samo okova so mlo Dad phenđa maje te vaćerav.”<verse eid="JHN 12:50" /></para>
  <chapter eid="JHN 12" />
  <chapter number="13" style="c" sid="JHN 13" />
  <para style="s">O Isus thovela e učenikonengere pre</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 13:1" />Angleder o prazniko Pasha, o Isus džanđa so alo lesoro vreme te džal taro akava sveto koro Dad. Tegani o Isus đi o kraj mothovđa kobor volini okolen kola inele olesere ko akava sveto.<verse eid="JHN 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 13:2" />O Isus hem lesere učenici hana ine zajedno i večera. O beng e Judase e Iskariotese, e Simonesere čhavese, već čhivđa ano vilo te izdajini e Isuse. <verse eid="JHN 13:2" /><verse number="3" style="v" sid="JHN 13:3" />A o Isus džanđa so o Dad dinđa lese sa i vlast; džanđa da e Devlestar alo hem da ko Devel ka džal. <verse eid="JHN 13:3" /><verse number="4" style="v" sid="JHN 13:4" />Uštino oti večera hem huljavđa plo ogrtači, i lelja o peškiri hem phandlja le pese ko maškar. <verse eid="JHN 13:4" /><verse number="5" style="v" sid="JHN 13:5" />Tegani čhorđa pani ano lavori hem lelja te thovel e učenikonengere pre hem te kosel len peškireja saveja phandlja po maškar.<verse eid="JHN 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 13:6" />Kad alo đi o Simon Petar, ov phenđa lese: “Gospode, tu li ka thove mle pre?”<verse eid="JHN 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 13:7" />O Isus phenđa lese: “Tu akana na haljoveja so me ćerava, ali jekh dive ka haljove.”<verse eid="JHN 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 13:8" />A o Petar phenđa lese: “Tu nikad naka thove mle pre!”</para>
  <para style="p" vid="JHN 13:8">A o Isus phenđa lese: “Te na thovđum te pre, našti te ove jekh mle učenikonendar.”<verse eid="JHN 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 13:9" />Tegani o Simon Petar phenđa lese: “Gospode, ma onda thov samo mle pre, nego hem mle vasta hem mlo šero!”<verse eid="JHN 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 13:10" />A o Isus phenđa lese: “Okolese kovai nanđardo valjani te thoven pe samo o pre, adalese soi već čisto. Hem tumen injen čista, ali na sare.”<verse eid="JHN 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 13:11" />Džanđa ko ka izdajini le, i adalese phenđa: “Na injen sare čista.”<verse eid="JHN 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 13:12" />Kad thovđa lengere pre, lelja plo ogrtači hem palem čhivđa pe uzalo astali, hem pučlja len: “Haljovena li so ćerđum tumenđe? <verse eid="JHN 13:12" /><verse number="13" style="v" sid="JHN 13:13" />Tumen man vičinena Učitelju hem Gospode, hem šukar phenena, adalese so me adava injum. <verse eid="JHN 13:13" /><verse number="14" style="v" sid="JHN 13:14" />I te me, o Gospod hem o Učitelj, thovđum tumare pre, onda valjani hem tumen te thoven o pre jekh averese. <verse eid="JHN 13:14" /><verse number="15" style="v" sid="JHN 13:15" />Dinđum tumen primer, hem tumen te ćeren ađahar sar so me ćerđum tumenđe. <verse eid="JHN 13:15" /><verse number="16" style="v" sid="JHN 13:16" />Čače, čače vaćerava tumenđe: o sluga nane po baro ple gospodarestar, ni o bičhaldo okolestar kova bičhalđa le. <verse eid="JHN 13:16" /><verse number="17" style="v" sid="JHN 13:17" />Adalese so džanen akava, blago tumenđe te ađahar ćerđen.”<verse eid="JHN 13:17" /></para>
  <para style="s">O Isus vaćeri ple učenikonenđe da jekh olendar ka izdajini le</para>
  <para style="r">(<ref loc="MAT 26:20-25">Mt 26,20–25</ref>; <ref loc="MRK 14:17-21">Mk 14,17–21</ref>; <ref loc="LUK 22:21-23">Lk 22,21–23</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 13:18" />“Na vaćerava sarijendar tumendar. Me džanav okolen kas birinđum. Ali mora te pherđol okova soi pisime ano Sveto lil: ‘Okova kova mancar hala maro, irinđa pe protiv mande.’ <verse eid="JHN 13:18" /><verse number="19" style="v" sid="JHN 13:19" />Vaćerava tumenđe akana, angleder nego so te ovel, da kad ka ovel, te poverujinen da Me injum. <verse eid="JHN 13:19" /><verse number="20" style="v" sid="JHN 13:20" />Čače, čače vaćerava tumenđe: ko primini okole kole me bičhalava, man primini, a ko primini man, primini Okole kova bičhalđa man.”<verse eid="JHN 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 13:21" />Kad phenđa adava, lesoro duho inele but uznemirime, i tegani phravdeste phenđa lenđe: “Čače, čače vaćerava tumenđe: jekh tumendar ka izdajini man.”<verse eid="JHN 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 13:22" />Tegani o učenici dikhle jekh avere, adalese so na džande kastar o Isus vaćeri. <verse eid="JHN 13:22" /><verse number="23" style="v" sid="JHN 13:23" />Jekh e učenikonendar – okova kas o Isus but volinđa – inele odmah uzalo Isus, <verse eid="JHN 13:23" /><verse number="24" style="v" sid="JHN 13:24" />i o Simon Petar dinđa le znako te pučel e Isuse kastar vaćeri.<verse eid="JHN 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 13:25" />Ađahar adava učeniko pašljarđa pe nakoro Isus hem pučlja le: “Kovai adava, Gospode?”<verse eid="JHN 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 13:26" />A o Isus phenđa lese: “Okova kase ka dav o maro savo ka macinav ano čaro.”</para>
  <para style="p" vid="JHN 13:26">Tegani lelja o kotor maro, macinđa le hem dinđa le e Judase, e Simonesere Iskariotesere čhavese. <verse eid="JHN 13:26" /><verse number="27" style="v" sid="JHN 13:27" />I samo so o Juda halja o maro, đerdinđa ano leste o Sotoni.</para>
  <para style="p" vid="JHN 13:27">Tegani o Isus phenđa lese: “Adava so mangeja te ćere, ćer po sig.”<verse eid="JHN 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 13:28" />Ali niko e učenikonendar kola inele uzalo astali na halilo sose phenđa lese adava. <verse eid="JHN 13:28" /><verse number="29" style="v" sid="JHN 13:29" />Adalese so ko Juda inele o zajednička pare, nesave mislinde da o Isus phenđa lese te džal hem te činel nešto hajbnase zako prazniko ili te del nešto e čororenđe. <verse eid="JHN 13:29" /><verse number="30" style="v" sid="JHN 13:30" />Palo adava so o Juda halja o maro, odmah iklilo avri. A inele rat.<verse eid="JHN 13:30" /></para>
  <para style="s">O Isus dela ple učenikonenđe nevi naredba</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 13:31" />Kad o Juda iklilo, o Isus phenđa: “Akanai proslavime o Čhavo e manušesoro hem o Devel proslavinđa pe ano leste. <verse eid="JHN 13:31" /><verse number="32" style="v" sid="JHN 13:32" />Te o Devel proslavinđa pe ano leste, hem o Devel ole ka proslavini ana peste, hem ka proslavini le odmah. <verse eid="JHN 13:32" /><verse number="33" style="v" sid="JHN 13:33" />Mle čhavoralen, pana hari injum tumencar. Ka roden man, ali, sar so phenđum e jevrejengere vođenđe: ‘Kaj me džava, tumen našti te aven’, ađahar adava hem tumenđe phenava. <verse eid="JHN 13:33" /><verse number="34" style="v" sid="JHN 13:34" />Nevi naredba dava tumen – te volinen jekh avere. Sar so me volinđum tumen, ađahar hem tumen volinen jekh avere. <verse eid="JHN 13:34" /><verse number="35" style="v" sid="JHN 13:35" />Palo akava sare ka džanen da injen mle učenici: te ine tumen mangipe jekh averese.”<verse eid="JHN 13:35" /></para>
  <para style="s">O Isus vaćeri so o Petar ka odreknini pe olestar</para>
  <para style="r">(<ref loc="MAT 26:31-35">Mt 26,31–35</ref>; <ref loc="MRK 14:27-31">Mk 14,27–31</ref>; <ref loc="LUK 22:31-34">Lk 22,31–34</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 13:36" />O Simon Petar pučlja le: “Gospode kaj džaja?”</para>
  <para style="p" vid="JHN 13:36">A o Isus phenđa lese: “Kaj me džava, tu akana našti te ave pala mande. Ali ka ave posle.”<verse eid="JHN 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 13:37" />O Petar pučlja le: “Gospode, sose našti te džav tuja akana? Spremno injum mlo dživdipe te dav tuće!”<verse eid="JHN 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 13:38" />A o Isus pučlja le: “To dživdipe te de maje? Čače, čače vaćerava će, angleder so o bašno ka đilabi, trin puti ka hovave da na pendžareja man.”<verse eid="JHN 13:38" /></para>
  <chapter eid="JHN 13" />
  <chapter number="14" style="c" sid="JHN 14" />
  <para style="s">O Isusi o drom đi ko Dad</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 14:1" />I o Isus phenđa: “Ma te uznemirinen pe tumare vile. Verujinen ano Devel hem verujinen ana mande. <verse eid="JHN 14:1" /><verse number="2" style="v" sid="JHN 14:2" />Ano čher mle Dadesoro isi but thana bešibnase. Te na ovel ine ađahar, naka phenav tumenđe ine: ‘Džava te pripreminav tumenđe than.’ <verse eid="JHN 14:2" /><verse number="3" style="v" sid="JHN 14:3" />A kad ka džav hem kad ka pripreminav tumenđe than, ka avav palem hem ka lav tumen mancar, te oven hem tumen adari kaj me injum. <verse eid="JHN 14:3" /><verse number="4" style="v" sid="JHN 14:4" />A tumen džanena o drom kaj me džava.”<verse eid="JHN 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 14:5" />O Toma phenđa lese: “Gospode, na džanaja kaj džaja. Sar onda šaj te džana o drom?”<verse eid="JHN 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 14:6" />A o Isus phenđa lese: “Me injum o Drom, o Čačipe hem o Dživdipe. Nijekh na avela koro Dad, sem prekala mande. <verse eid="JHN 14:6" /><verse number="7" style="v" sid="JHN 14:7" />Te pendžarđen man, ka pendžaren hem mle Dade. Od akana pendžarena le, hem dikhljen le.”<verse eid="JHN 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 14:8" />O Filip phenđa lese: “Gospode, mothov amenđe e Dade, hem adava ka ovel amenđe dovoljno.”<verse eid="JHN 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 14:9" />O Isus phenđa lese: “Edobor vreme injum tumencar, a tu man, Filipe, pana na pendžareja! Ko dikhlja man, dikhlja hem e Dade. Sar šaj te phene: ‘Mothov amenđe e Dade’? <verse eid="JHN 14:9" /><verse number="10" style="v" sid="JHN 14:10" />Tu li na verujineja da me injum ano Dad hem dai o Dad ana mande? O lafija save vaćerava tumenđe na vaćerava korkoro mandar, nego o Dad, kova živini ana mande, ćerela ple delja prekala mande. <verse eid="JHN 14:10" /><verse number="11" style="v" sid="JHN 14:11" />Verujinen maje da injum ano Dad hem dai o Dad ana mande. A te na verujinena maje, verujinen zbog o delja save ćerava. <verse eid="JHN 14:11" /><verse number="12" style="v" sid="JHN 14:12" />Čače, čače vaćerava tumenđe: ko verujini ana mande, ka ćerel o delja save me ćerava. Ka ćerel hem po bare, adalese so me džava koro Dad. <verse eid="JHN 14:12" /><verse number="13" style="v" sid="JHN 14:13" />Hem sa so ka roden ano mlo anav, me ka ćerav adava, te šaj o Dad proslavini pe ano Čhavo. <verse eid="JHN 14:13" /><verse number="14" style="v" sid="JHN 14:14" />Sa so ka roden ano mlo anav, me ka ćerav.”<verse eid="JHN 14:14" /></para>
  <para style="s">O Isus vaćeri da ka bičhali e Svetone Duho</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 14:15" />“Te volinena man, ka ićeren mle naredbe. <verse eid="JHN 14:15" /><verse number="16" style="v" sid="JHN 14:16" />A me ka molinav e Dade hem ov ka del tumen avere Zastupniko, te ovel tumencar zauvek: <verse eid="JHN 14:16" /><verse number="17" style="v" sid="JHN 14:17" />e Duho e čačipnasere, kole o sveto našti primini, adalese so na dikhela le hem na pendžarela le. Tumen pendžarena le, adalese soi tumencar hem ka ovel ana tumende. <verse eid="JHN 14:17" /><verse number="18" style="v" sid="JHN 14:18" />Naka ačhavav tumen sar čhavoren bizo dad hem bizi daj. Palem ka avav kora tumende. <verse eid="JHN 14:18" /><verse number="19" style="v" sid="JHN 14:19" />Pana hari, hem o sveto više naka dikhel man, ali tumen ka dikhen man. Adalese so me živinava, hem tumen ka živinen. <verse eid="JHN 14:19" /><verse number="20" style="v" sid="JHN 14:20" />Adava dive ka haljoven da me injum ano mlo Dad hem da tumen injen ana mande, a me ana tumende. <verse eid="JHN 14:20" /><verse number="21" style="v" sid="JHN 14:21" />Ko prihvatini mle naredbe hem ićeri len, ov volini man, a ko volini man, ole ka volini hem mlo Dad. A hem me ka volinav le hem ka mothovav man lese.”<verse eid="JHN 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 14:22" />O Juda (na o Iskariot) pučlja le: “Gospode, sar adava da ka mothove tut amenđe, a na e svetose?”<verse eid="JHN 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 14:23" />O Isus phenđa lese: “Te neko volini man, ka ićeri mlo Lafi, hem mlo Dad ka volini le. Mlo Dad hem me ka ava koro leste hem ka ačhova koro leste. <verse eid="JHN 14:23" /><verse number="24" style="v" sid="JHN 14:24" />Ko na volini man, na ićeri mlo Lafi. A o Lafi savo šunena nane mlo, nego avela e Dadestar, kova bičhalđa man.<verse eid="JHN 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 14:25" />Adava phenđum tumenđe akana, sar pana injum tumencar. <verse eid="JHN 14:25" /><verse number="26" style="v" sid="JHN 14:26" />A o Zastupniko, o Sveto Duho, kole o Dad ka bičhali te zastupini man, ka sikaj tumen sa hem ka podsetini tumen ko sa so phenđum tumenđe.<verse eid="JHN 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 14:27" />Ačhavava tumenđe mir, mlo mir dava tumen. Ali, na dava tumen ole ađahar sar o sveto so dela. Ma te uznemirinen pe tumare vile hem ma te daran. <verse eid="JHN 14:27" /><verse number="28" style="v" sid="JHN 14:28" />Šunđen man so phenđum: ‘Džava hem ka irinav man kora tumende.’ Te volinena man, ka radujinen tumen ine so džava koro Dad, adalese soi o Dad po baro mandar.<verse eid="JHN 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 14:29" />Adava phenđum tumenđe akana, angleder nego so ka ovel, te verujinen kad ka ovel adava. <verse eid="JHN 14:29" /><verse number="30" style="v" sid="JHN 14:30" />Naka vaćerav pana but tumencar, adalese so avela o vladari akale svetosoro. Ole nane vlast upra mande, <verse eid="JHN 14:30" /><verse number="31" style="v" sid="JHN 14:31" />ali sar te šaj o sveto dodžanel da me volinava e Dade, ćerava ađahar sar so o Dad naredinđa maje.</para>
  <para style="p" vid="JHN 14:31">Ušten, hajde akatar!”<verse eid="JHN 14:31" /></para>
  <chapter eid="JHN 14" />
  <chapter number="15" style="c" sid="JHN 15" />
  <para style="s">O Isus – o čačikano čokot</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 15:1" />“Me injum o čačikano čokot, a mloi Dad o vinogradari. <verse eid="JHN 15:1" /><verse number="2" style="v" sid="JHN 15:2" />Ov čhinela đijekh loza upra mande savi na anela bijandipe, a čistini đijekha savi anela bijandipe, sar te del više bijandipe. <verse eid="JHN 15:2" /><verse number="3" style="v" sid="JHN 15:3" />A tumen injen već čista zbog o lafi savo vaćerđum tumenđe. <verse eid="JHN 15:3" /><verse number="4" style="v" sid="JHN 15:4" />Ačhoven ana mande hem me ka ačhovav ana tumende. Sar so i loza našti te anel bijandipe korkori pestar te na ačhili upro čokot, ađahar ni tumen našti te anen bijandipe te na ačhiljen ana mande. <verse eid="JHN 15:4" /><verse number="5" style="v" sid="JHN 15:5" />Me injum o čokot, a tumen o loze. Ko ačhola ana mande hem me ano leste, ov anela but bijandipe, adalese so bizo mande našti ništa te ćeren. <verse eid="JHN 15:5" /><verse number="6" style="v" sid="JHN 15:6" />Te neko na ačhola ana mande, frdela pe avri sar i čhindi loza hem šućola, a esavken čedena hem frdena len ani jag, i tharena len. <verse eid="JHN 15:6" /><verse number="7" style="v" sid="JHN 15:7" />Te ačhona ana mande hem te mle lafija ačhona ana tumende, roden okova so mangena hem ka dobinen. <verse eid="JHN 15:7" /><verse number="8" style="v" sid="JHN 15:8" />Akavai ki slava mle Dadesiri: te anen but bijandipe hem te oven mle učenici.<verse eid="JHN 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 15:9" />Sar so o Dad volinđa man, ađahar hem me tumen volinđum. Ačhoven ano mlo mangipe. <verse eid="JHN 15:9" /><verse number="10" style="v" sid="JHN 15:10" />Te ićerđen tumen ko mle naredbe, ka ačhoven ano mlo mangipe, sar so hem me ićerđum man ko naredbe mle Dadesere, i ačhovava ano lesoro mangipe.<verse eid="JHN 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 15:11" />Akava phenđum tumenđe te šaj mli radost ovel ana tumende hem te šaj tumari radost ovel pherdi. <verse eid="JHN 15:11" /><verse number="12" style="v" sid="JHN 15:12" />Akavai mli naredba: volinen jekh avere sar so me volinđum tumen. <verse eid="JHN 15:12" /><verse number="13" style="v" sid="JHN 15:13" />Nane po baro mangipe adalestar nego kad neko dela plo dživdipe ple amalenđe. <verse eid="JHN 15:13" /><verse number="14" style="v" sid="JHN 15:14" />A tumen injen mle amala te ćerđen okova so naredinava tumenđe. <verse eid="JHN 15:14" /><verse number="15" style="v" sid="JHN 15:15" />Na vičinava tumen više sluge, adalese so o sluga na džanel so ćerela lesoro gospodari. Akana vičinava tumen amala, adalese so mothovđum tumenđe sa so phenđa maje mlo Dad. <verse eid="JHN 15:15" /><verse number="16" style="v" sid="JHN 15:16" />Na birinđen tumen man, nego me tumen birinđum hem čhivđum tumen te džan hem te anen bijandipe, hem tumaro bijandipe te ačhol, hem te šaj o Dad te del tumen sa so ka roden ano mlo anav. <verse eid="JHN 15:16" /><verse number="17" style="v" sid="JHN 15:17" />Akava naredinava tumenđe: Volinen jekh avere!”<verse eid="JHN 15:17" /></para>
  <para style="s">O sveto mrzini e Isusesere učenikonen</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 15:18" />“Te o sveto mrzini tumen, džanen da man mrzinđa angleder tumendar. <verse eid="JHN 15:18" /><verse number="19" style="v" sid="JHN 15:19" />Te oven ine akale svetostar, o sveto ka volini tumen ine. Ali, adalese so na injen akale svetostar, nego me izabirinđum tumen olestar, zbog adalese o sveto mrzini tumen. <verse eid="JHN 15:19" /><verse number="20" style="v" sid="JHN 15:20" />Setinen tumen mle lafendar so phenđum tumenđe: ‘O sluga nane po baro ple gospodarestar.’ Te man progoninde, ka progoninen hem tumen. Te ićerde pe ko mlo Lafi, ka ićeren pe hem ko tumaro. <verse eid="JHN 15:20" /><verse number="21" style="v" sid="JHN 15:21" />A sa adava ka ćeren protiv tumende zbog mlo anav, adalese so na džanen Okole kova man bičhalđa. <verse eid="JHN 15:21" /><verse number="22" style="v" sid="JHN 15:22" />Te na avav hem te na vaćerav lenđe ine, naka oven ine kriva zako greh. Ali akana nane len izgovor zako pumaro greh. <verse eid="JHN 15:22" /><verse number="23" style="v" sid="JHN 15:23" />Ko mrzini man, mrzini hem mle Dade. <verse eid="JHN 15:23" /><verse number="24" style="v" sid="JHN 15:24" />Te na ćerav ine delja maškar olende save niko aver na ćerđa, naka oven ine kriva zako greh. A on dikhle o delja save ćerđum, a palem zamrzinde hem man hem mle Dade. <verse eid="JHN 15:24" /><verse number="25" style="v" sid="JHN 15:25" />Ali, valjani te pherđol okova soi pisime ano lengoro Zakoni: ‘Mrzinde man bizo razlog.’<verse eid="JHN 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 15:26" />A kad ka avel o Zastupniko, kole ka bičhalav tumenđe e Dadestar – o Duho e čačipnasoro kova avela e Dadestar – ov ka svedočini mandar. <verse eid="JHN 15:26" /><verse number="27" style="v" sid="JHN 15:27" />A hem tumen ka svedočinen, adalese so taro početak injen mancar.”<verse eid="JHN 15:27" /></para>
  <chapter eid="JHN 15" />
  <chapter number="16" style="c" sid="JHN 16" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 16:1" />I o Isus phenđa: “Adava phenđum tumenđe te na otperen oti vera. <verse eid="JHN 16:1" /><verse number="2" style="v" sid="JHN 16:2" />Ka ikalen tumen oti sinagoga, a ka avel o vreme kad, svako kova ka mudari tumen, ka mislini da adaleja služini e Devlese. <verse eid="JHN 16:2" /><verse number="3" style="v" sid="JHN 16:3" />A adava ka ćeren adalese so na pendžarena ni mle Dade ni man. <verse eid="JHN 16:3" /><verse number="4" style="v" sid="JHN 16:4" />Adava vaćerđum tumenđe, kad ka avel adava vreme, te setinen tumen mle lafendar. Na vaćerđum tumenđe akava ko početak, adalese so injumle tumencar.”<verse eid="JHN 16:4" /></para>
  <para style="s">O Isus vaćeri e Svetone Duhostar</para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 16:5" />“Ali akana džava Okoleste kova bičhalđa man, a nijekh tumendar na pučela man: ‘Kaj džaja?’ <verse eid="JHN 16:5" /><verse number="6" style="v" sid="JHN 16:6" />Nego, adalese so adava phenđum tumenđe, i žal pherđa tumare vile. <verse eid="JHN 16:6" /><verse number="7" style="v" sid="JHN 16:7" />Ali vaćerava tumenđe o čačipe: po šukari tumenđe me te džav. Adalese so, te na dželjum, naka avel tumenđe o Zastupniko. Ali te dželjum, ka bičhalav le tumende. <verse eid="JHN 16:7" /><verse number="8" style="v" sid="JHN 16:8" />A kad ov ka avel, ka mothoj e manušenđe soi čače o greh, i pravednost hem o sudo. <verse eid="JHN 16:8" /><verse number="9" style="v" sid="JHN 16:9" />So tičini pe oto greh, adalese so na verujinena ana mande. <verse eid="JHN 16:9" /><verse number="10" style="v" sid="JHN 16:10" />So tičini pe oti pravednost, adalese so džava koro Dad hem naka dikhen man više. <verse eid="JHN 16:10" /><verse number="11" style="v" sid="JHN 16:11" />So tičini pe oto sudo, adalese soi o vladari akale svetosoro već osudime.<verse eid="JHN 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 16:12" />Pana but so isi man te phenav tumenđe, ali adava naka šaj ine akana te akharen. <verse eid="JHN 16:12" /><verse number="13" style="v" sid="JHN 16:13" />Ali, kad ka avel ov, o Duho e čačipnasoro, ka legari tumen ano sa o čačipe. Ov naka vaćeri korkoro pestar, nego ka vaćeri samo okova so šunela, hem ka vaćeri tumenđe okova so ka ovel. <verse eid="JHN 16:13" /><verse number="14" style="v" sid="JHN 16:14" />Ov ka proslavini man, adalese so mandar ka primini hem tumenđe ka vaćeri. <verse eid="JHN 16:14" /><verse number="15" style="v" sid="JHN 16:15" />Sa so isi mle Dade, mloi. Adalese phenđum tumenđe da mandar ka primini hem tumenđe ka vaćeri.<verse eid="JHN 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 16:16" />Pana hari, hem naka dikhen man više, a onda pana hari, i ka dikhen man.”<verse eid="JHN 16:16" /></para>
  <para style="s">I žalost ka irini pe ani radost</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 16:17" />Tegani nesave lesere učenikonendar pučle jekh avere: “Soi adava so phenela amenđe: ‘Pana hari, hem naka dikhen man, a onda pana hari, i ka dikhen man’, hem: ‘Adalese so džava koro Dad’?”<verse eid="JHN 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 16:18" />I phende: “So mislini adaleja kad phenela: ‘Pana hari’? Na džanaja sostar vaćeri.”<verse eid="JHN 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 16:19" />A o Isus džanđa so mangle te pučen le, hem phenđa lenđe: “Pučena tumen maškara tumende so značini adava so phenđum: ‘Pana hari, hem naka dikhen man, a onda pana hari, i ka dikhen man’? <verse eid="JHN 16:19" /><verse number="20" style="v" sid="JHN 16:20" />Čače, čače vaćerava tumenđe: Ka roven hem ka tugujinen, a o sveto ka radujini pe. Ka oven žalosna, ali tumari žalost ka irini pe ani radost. <verse eid="JHN 16:20" /><verse number="21" style="v" sid="JHN 16:21" />Ano dukhai i đuvli kad bijani, adalese so alo lakoro vreme, ali kad bijanđola o čhavoro, radosnoi adalese so anđa e čhavore ko sveto, i bistrela upro pharipa save nakhavđa. <verse eid="JHN 16:21" /><verse number="22" style="v" sid="JHN 16:22" />Ađahar hem tumen akana injen žalosna, ali me palem ka dikhav tumen hem tumare vile ka radujinen pe, hem niko naka šaj te lel tumendar adaja radost. <verse eid="JHN 16:22" /><verse number="23" style="v" sid="JHN 16:23" />Hem adava dive ništa više naka pučen man. Čače, čače vaćerava tumenđe: sa so ka roden mle Dadestar ano mlo anav, ka del tumen. <verse eid="JHN 16:23" /><verse number="24" style="v" sid="JHN 16:24" />Đi akana ništa na rodinđen ano mlo anav. Roden hem ka dobinen – te šaj tumari radost ovel pherdi.”<verse eid="JHN 16:24" /></para>
  <para style="s">O Isus pobedinđa e sveto</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 16:25" />“Akava vaćerđum tumenđe ano priče. Avela o vreme kad više naka vaćerav tumenđe ano priče, nego phravdeste ka vaćerav tumenđe e Dadestar. <verse eid="JHN 16:25" /><verse number="26" style="v" sid="JHN 16:26" />Adava dive ka roden e Dadestar maje ano anav. Na phenava tumenđe da me ka molinav mle Dade tumenđe, <verse eid="JHN 16:26" /><verse number="27" style="v" sid="JHN 16:27" />adalese so hem korkoro o Dad volini tumen adalese so tumen volinđen man hem poverujinđen da aljum e Devlestar. <verse eid="JHN 16:27" /><verse number="28" style="v" sid="JHN 16:28" />E Dadestar ikliljum hem aljum ko sveto. Akana ačhavava o sveto hem džava mle Dadeste.”<verse eid="JHN 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 16:29" />Tegani lesere učenici phende: “Ače, akana vaćereja amenđe phravdeste, bizo te vaćere ano priče. <verse eid="JHN 16:29" /><verse number="30" style="v" sid="JHN 16:30" />Akana džanaja da sa džane hem na valjani neko te pučel tut nešto, adalese so sa angleder džane. Adalese verujinaja da aljan e Devlestar.”<verse eid="JHN 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 16:31" />A o Isus phenđa lenđe: “Akana li verujinena? <verse eid="JHN 16:31" /><verse number="32" style="v" sid="JHN 16:32" />Ače, avela o vreme – hem već alo – kad sare ka našen svako pese ki strana, a man ka ačhaven korkore. Ali me na injum korkoro, adalese soi o Dad mancar. <verse eid="JHN 16:32" /><verse number="33" style="v" sid="JHN 16:33" />Akava phenđum tumenđe te šaj ovel tumen mir ana mande. Ano sveto ka ovel tumen nevolja, ali tumen oven zorale – me pobedinđum e sveto.”<verse eid="JHN 16:33" /></para>
  <chapter eid="JHN 16" />
  <chapter number="17" style="c" sid="JHN 17" />
  <para style="s">O Isus molini pese</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 17:1" />Kad sa adava o Isus vaćerđa, vazdinđa plo šero nakoro nebo, hem phenđa: “Dade, alo o vreme. Proslavin te Čhave, sar te šaj o Čhavo proslavini tut. <verse eid="JHN 17:1" /><verse number="2" style="v" sid="JHN 17:2" />Adalese so, tu dinđan le vlast upreder svako manuš te del večno dživdipe sarijenđe kolen tu dinđan le. <verse eid="JHN 17:2" /><verse number="3" style="v" sid="JHN 17:3" />A akavai o večno dživdipe: te pendžaren tut, e jekhe čačikane Devle, hem e Isuse Hriste, kole tu bičhalđan. <verse eid="JHN 17:3" /><verse number="4" style="v" sid="JHN 17:4" />Me tut proslavinđum ki phuv ađahar so završinđum i buti savi dinđan man te ćerav. <verse eid="JHN 17:4" /><verse number="5" style="v" sid="JHN 17:5" />A akana tu proslavin man kora tute, Dade, esavka slavaja savi ine man kora tute angleder nego so o sveto inele ćerdo.”<verse eid="JHN 17:5" /></para>
  <para style="s">O Isus molini e učenikonenđe</para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 17:6" />“Mothovđum to anav e manušenđe kolen dinđan man taro akava sveto. On inele kle hem tu dinđan len maje hem on ićerde pe ko to Lafi. <verse eid="JHN 17:6" /><verse number="7" style="v" sid="JHN 17:7" />Akana džanen da sa so dinđan man avela tutar. <verse eid="JHN 17:7" /><verse number="8" style="v" sid="JHN 17:8" />Adalese so, dinđum len o lafija save tu dinđan maje hem on prihvatinde len hem čače halile da me aljum tutar, hem poverujinde da tu bičhalđan man. <verse eid="JHN 17:8" /><verse number="9" style="v" sid="JHN 17:9" />Olenđe molinava. Na molinava zako sveto, nego zako okola kolen dinđan man, adalese soi on kle. <verse eid="JHN 17:9" /><verse number="10" style="v" sid="JHN 17:10" />Sa soi mlo, kloi, hem sa soi klo, mloi, a me injum proslavime prekalo lende. <verse eid="JHN 17:10" /><verse number="11" style="v" sid="JHN 17:11" />Me na injum više ano sveto, ali oni ano sveto, a me avava kora tute. Svetona Dade, arakh len te anaveja, save dinđan maje, te oven jekh sar so amen injam jekh. <verse eid="JHN 17:11" /><verse number="12" style="v" sid="JHN 17:12" />Đikote injumle olencar, arakhljum len e anaveja save dinđan man. Arakhljum len hem nijekh olendar na propelo, sem okolestar kovai osudime ki propast, sar te pherđol o Sveto lil.<verse eid="JHN 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 17:13" />A akana avava kora tute, ali akava vaćerava sar pana injum ko sveto, sar te šaj te ovel len ana pumende o pherdipe oti mli radost. <verse eid="JHN 17:13" /><verse number="14" style="v" sid="JHN 17:14" />Dinđum len to Lafi, a o sveto zamrzinđa len, adalese so on nane oto sveto, sar so hem me na injum oto sveto. <verse eid="JHN 17:14" /><verse number="15" style="v" sid="JHN 17:15" />Na molinava te le len taro sveto, nego te arakhe len e Bišukarestar. <verse eid="JHN 17:15" /><verse number="16" style="v" sid="JHN 17:16" />On nane oto sveto, sar so hem me na injum oto sveto. <verse eid="JHN 17:16" /><verse number="17" style="v" sid="JHN 17:17" />Posvetin len te čačipnaja; o čačipei to Lafi. <verse eid="JHN 17:17" /><verse number="18" style="v" sid="JHN 17:18" />Sar so tu man bičhalđan ano sveto, ađahar hem me len bičhalđum ano sveto <verse eid="JHN 17:18" /><verse number="19" style="v" sid="JHN 17:19" />hem korkore man posvetinava zako olenđe, hem on te oven posvetime čačipnaja.”<verse eid="JHN 17:19" /></para>
  <para style="s">O Isus molini pe sarijenđe kola verujinena</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 17:20" />“Ali, na molinava samo lenđe, nego hem okolenđe kola prekalo olengoro lafi ka poverujinen ana mande, <verse eid="JHN 17:20" /><verse number="21" style="v" sid="JHN 17:21" />te šaj sare oven jekh. Sar so injan tu, Dade, ana mande hem me ana tute, ađahar hem on nek oven jekh ana amende, te šaj o sveto te poverujini da tu bičhalđan man. <verse eid="JHN 17:21" /><verse number="22" style="v" sid="JHN 17:22" />Me dinđum len i slava savi tu man dinđan, te oven jekh sar so amen injam jekh <verse eid="JHN 17:22" /><verse number="23" style="v" sid="JHN 17:23" />– me ano lende, a tu ana mande – te oven savršena ano jedinstvo, te šaj o sveto džanel da tu bičhalđan man hem da len volinđan sar so volinđan man.<verse eid="JHN 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 17:24" />Dade, mangava okola kolen dinđan man te oven mancar adari kaj me injum hem te dikhen mli slava, savi dinđan man adalese so volinđan man angleder nego so o sveto inele ćerdo. <verse eid="JHN 17:24" /><verse number="25" style="v" sid="JHN 17:25" />Pravednona Dade, iako o sveto na pendžari tut, me pendžarava tut, hem akala džanen da tu bičhalđan man. <verse eid="JHN 17:25" /><verse number="26" style="v" sid="JHN 17:26" />Mothovđum lenđe to anav hem pana ka mothovav le, te šaj o mangipe saveja tu volinđan man ovel ano lende, hem me ano lende.”<verse eid="JHN 17:26" /></para>
  <chapter eid="JHN 17" />
  <chapter number="18" style="c" sid="JHN 18" />
  <para style="s">O Isus ovela izdajime hem dolime</para>
  <para style="r">(<ref loc="MAT 26:47-56">Mt 26,47–56</ref>; <ref loc="MRK 14:43-50">Mk 14,43–50</ref>; <ref loc="LUK 22:47-53">Lk 22,47–53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 18:1" />Kad završinđa i molitva, o Isus dželo ple učenikonencar ki aver strana oto potok Kedron. Adari inele jekh vrt ko savo ov hem lesere učenici đerdinde. <verse eid="JHN 18:1" /><verse number="2" style="v" sid="JHN 18:2" />A o izdajniko o Juda džanđa zako adava than adalese so o Isus but puti arakhi pe ine adari ple učenikonencar. <verse eid="JHN 18:2" /><verse number="3" style="v" sid="JHN 18:3" />I o Juda alo adari hem anđa peja četa e rimesere vojnikonendar hem e hramesere stražaren, kolen bičhalde o šerutne sveštenici hem o fariseja. Pumencar legarde baklje, svetiljke hem oružje.<verse eid="JHN 18:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 18:4" />A o Isus, adalese so džanđa sa so ka ovel oleja, iklilo hem pučlja len: “Kas rodena?”<verse eid="JHN 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 18:5" />On phende lese: “E Isuse taro Nazaret!”</para>
  <para style="p" vid="JHN 18:5">A ov phenđa lenđe: “Me injum.”</para>
  <para style="p" vid="JHN 18:5">Olencar terdino hem o Juda, lesoro izdajniko. <verse eid="JHN 18:5" /><verse number="6" style="v" sid="JHN 18:6" />A kad phenđa lenđe: “Me injum”, cidinde pe napalal hem pele ki phuv.<verse eid="JHN 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 18:7" />Tegani o Isus palem pučlja len: “Kas rodena?”</para>
  <para style="p" vid="JHN 18:7">A on phende lese: “E Isuse taro Nazaret.”<verse eid="JHN 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 18:8" />O Isus phenđa lenđe: “Phenđum tumenđe: Me injum. I, adalese so man rodena, muken akalen te džan.” <verse eid="JHN 18:8" /><verse number="9" style="v" sid="JHN 18:9" />Adava phenđa sar te pherđol okova so angleder phenđa: “Na našalđum nijekhe okolendar kolen dinđan man.”<verse eid="JHN 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 18:10" />A e Simone Petre inele mači, i ikalđa le, khuvđa e prvosveštenikosere sluga hem čhinđa lesoro desno kan. E slugasoro anav inele Malho.<verse eid="JHN 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 18:11" />O Isus phenđa e Petrese: “Irin o mači ano korice! Sar te na pijav oti čaša e patnjaja savi dinđa man mlo Dad?”<verse eid="JHN 18:11" /></para>
  <para style="s">E Isuse anena anglo prvosvešteniko</para>
  <para style="r">(<ref loc="MAT 26:57-58">Mt 26,57–58</ref>; <ref loc="MRK 14:53-54">Mk 14,53–54</ref>; <ref loc="LUK 22:54">Lk 22,54</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 18:12" />Tegani i četa, olakoro naredniko hem e hramesere stražarija dolinde e Isuse hem phandle le. <verse eid="JHN 18:12" /><verse number="13" style="v" sid="JHN 18:13" />Najangle legarde le koro Ana e Kajafasoro sastro. O Kajafa inele prvosvešteniko adava berš. <verse eid="JHN 18:13" /><verse number="14" style="v" sid="JHN 18:14" />A o Kajafa inele adava kova savetujinđa e jevrejengere vođen dai po šukar jekh manuš te merel zako sa o narodo.<verse eid="JHN 18:14" /></para>
  <para style="s">O Petar prvo puti odreknini pe e Isusestar</para>
  <para style="r">(<ref loc="MAT 26:69-70">Mt 26,69–70</ref>; <ref loc="MRK 14:66-68">Mk 14,66–68</ref>; <ref loc="LUK 22:55-57">Lk 22,55–57</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 18:15" />Palo Isus pođinde o Simon Petar hem pana jekh učeniko. Adale učeniko o prvosvešteniko džanđa, i ov e Isuseja đerdinđa ko boro e prvosveštenikosoro, <verse eid="JHN 18:15" /><verse number="16" style="v" sid="JHN 18:16" />a o Petar ačhilo avri angli kapija. Tegani iklilo okova dujto učeniko, kole o prvosvešteniko džanđa, vaćerđa e sluškinjaja koja pazini ine anglo udar, i anđa e Petre andre.<verse eid="JHN 18:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 18:17" />Tegani adaja sluškinja pučlja e Petre: “Na li hem tu injan jekh akale manušesere učenikonendar?”</para>
  <para style="p" vid="JHN 18:17">O Petar phenđa: “Na injum.”<verse eid="JHN 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 18:18" />A o sluge hem o stražarija tharde jag hem terdine adari te tačon, adalese so inele šil, i ađahar hem o Petar terdino olencar hem tačola ine.<verse eid="JHN 18:18" /></para>
  <para style="s">O prvosvešteniko o Ana ispitujini e Isuse</para>
  <para style="r">(<ref loc="MAT 26:59-66">Mt 26,59–66</ref>; <ref loc="MRK 14:55-64">Mk 14,55–64</ref>; <ref loc="LUK 22:66-71">Lk 22,66–71</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 18:19" />A zako adava vreme o prvosvešteniko ispitujini ine e Isuse lesere učenikonendar hem lesere sikavibnastar.<verse eid="JHN 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 18:20" />O Isus phenđa lese: “Me javno vaćerđum e manušenđe. Uvek sikavđum ani sinagoga hem ano Hram, kaj sa o Jevreja čedena pe, hem ništa na vaćerđum garandoj. <verse eid="JHN 18:20" /><verse number="21" style="v" sid="JHN 18:21" />Sose man pučeja? Puč okolen kola šunde so vaćerđum lenđe. On džanen so vaćerđum.”<verse eid="JHN 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 18:22" />Kad phenđa adava, khuvđa le šamarka jekh sluga kova adari terdino hem phenđa: “Ađahar li vaćeri pe e prvosveštenikoja?”<verse eid="JHN 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 18:23" />O Isus phenđa lese: “Te phenđum nešto pogrešno, dokažin dai adava pogrešno. Ali te phenđum nešto šukar, sose khuveja man?”<verse eid="JHN 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 18:24" />Tegani o Ana, phandle, bičhalđa le koro prvosvešteniko Kajafa.<verse eid="JHN 18:24" /></para>
  <para style="s">O Petar dujto hem trito puti odreknini pe e Isusestar</para>
  <para style="r">(<ref loc="MAT 26:71-75">Mt 26,71–75</ref>; <ref loc="MRK 14:69-72">Mk 14,69–72</ref>; <ref loc="LUK 22:58-62">Lk 22,58–62</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 18:25" />Sar o Simon Petar terđola hem tačola ine, pučle le: “Te na injan hem tu jekh olesere učenikonendar?”</para>
  <para style="p" vid="JHN 18:25">A ov hovavđa: “Na injum.”<verse eid="JHN 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 18:26" />Jekh sluga e prvosveštenikosoro – o rođako okolesoro kasoro kan o Petar čhinđa – phenđa: “Na li dikhljum tut oleja ano vrt?”<verse eid="JHN 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 18:27" />A o Petar palem hovavđa hem odmah o bašno đilabđa.<verse eid="JHN 18:27" /></para>
  <para style="s">O Isus anglo e rimesoro upravniko o Pilat</para>
  <para style="r">(<ref loc="MAT 27:1-2">Mt 27,1–2</ref>, <ref loc="MAT 27:11-31">11–31</ref>; <ref loc="MRK 15:1-20">Mk 15,1–20</ref>; <ref loc="LUK 23:1-25">Lk 23,1–25</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 18:28" />Rano sabale e Isuse legarde taro e Kajafasoro čher ki palata e Pilatesiri. E jevrejengere vođe na đerdinde ki palata, sar te na oven nečista palo pumaro adeti, adalese so mangle te han i pashalno večera.<verse eid="JHN 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 18:29" />Adalese o Pilat iklilo anglo lende hem pučlja len: “Zako so optužinena akale manuše?”<verse eid="JHN 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 18:30" />A on phende lese: “Te na ovel ine krivo akava manuš, amen naka preda le ine tute.”<verse eid="JHN 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 18:31" />Tegani o Pilat phenđa lenđe: “Len le tumen, i sudinen lese palo tumaro zakoni.”</para>
  <para style="p" vid="JHN 18:31">A o Jevreja phende lese: “Amen na tromaja nikas te mudara.” <verse eid="JHN 18:31" /><verse number="32" style="v" sid="JHN 18:32" />Akava ulo sar te pherđol okova so o Isus phenđa e meribnastar saveja valjanđa te merel.<verse eid="JHN 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 18:33" />O Pilat tegani palem đerdinđa ki palata, vičinđa e Isuse, hem pučlja le: “Tu li injan o caro e Jevrejengoro?”<verse eid="JHN 18:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 18:34" />A o Isus phenđa: “Vaćereja li adava korkoro tutar, ili avera vaćerde će mandar?”<verse eid="JHN 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 18:35" />O Pilat phenđa: “Me li injum Jevrejco? To narodo hem o šerutne sveštenici predinde tut mande. So ćerđan?”<verse eid="JHN 18:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 18:36" />O Isus phenđa lese: “Mlo carstvo nane akale svetostar. Te ovel ine mlo carstvo akale svetostar, mle sluge ka maren pe ine te na ovav predime e jevrejengere vođenđe. Ali mlo carstvo nane akatar.”<verse eid="JHN 18:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 18:37" />Tegani o Pilat phenđa: “Znači, tu injan caro!”</para>
  <para style="p" vid="JHN 18:37">A o Isus phenđa: “Ađahari sar so pheneja: Injum caro. Me akalese bijandiljum hem akalese aljum ko sveto: te svedočinav zako čačipe. Svako kovai oto čačipe, šunela mlo glaso.”<verse eid="JHN 18:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 18:38" />A o Pilat pučlja le: “Soi o čačipe?”</para>
  <para style="p" vid="JHN 18:38">Kad adava phenđa, o Pilat palem iklilo anglo e jevrejengere vođe, i phenđa lenđe: “Na arakhava nisavi krivica upro leste.<verse eid="JHN 18:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 18:39" />Ali tumen isi jekh adeti zaki Pasha te mukav tumenđe jekhe phandle. Mangena li te mukav tumenđe e jevrejengere caro?”<verse eid="JHN 18:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 18:40" />A on vičinde: “Na ole, nego e Varava!”</para>
  <para style="p" vid="JHN 18:40">A o Varava inele razbojniko.<verse eid="JHN 18:40" /></para>
  <chapter eid="JHN 18" />
  <chapter number="19" style="c" sid="JHN 19" />
  <para style="s">O Isus osudime ko meriba</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 19:1" />Tegani o Pilat naredinđa te šibinen e Isuse. <verse eid="JHN 19:1" /><verse number="2" style="v" sid="JHN 19:2" />O vojnici ćerde lese kruna oto kare hem čhivde la lese ko šero, hem urjavde le lolo ogrtači. <verse eid="JHN 19:2" /><verse number="3" style="v" sid="JHN 19:3" />Tegani lelje te aven nakoro leste hem te phenen lese: “Te ove sasto, e jevrejengere carona!” Hem khuvena le ine šamarke.<verse eid="JHN 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 19:4" />O Pilat palem iklilo avri, hem phenđa e narodose: “Ače, ikalava le avri angla tumende, ali te džanen da na arakhljum nisavi krivica upro leste.”<verse eid="JHN 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 19:5" />Tegani o Isus iklilo avri, e krunaja oto kare ko šero hem ano lolo ogrtači, a o Pilat phenđa: “Dikhen e manuše!”<verse eid="JHN 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 19:6" />Kad o šerutne sveštenici hem o stražarija dikhle le, vičinde: “Čhiv le ko krsto! Čhiv le ko krsto!” A o Pilat phenđa lenđe: “Len le tumen, i čhiven le ko krsto, adalese so me na arakhljum nisavi krivica upro leste.”<verse eid="JHN 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 19:7" />A e jevrejengere vođe phende lese: “Amen isi Zakoni, hem palo adava Zakoni ov mora te merel, adalese so tvrdinđa dai e Devlesoro Čhavo!”<verse eid="JHN 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 19:8" />Kad o Pilat adava šunđa, po više darandilo, <verse eid="JHN 19:8" /><verse number="9" style="v" sid="JHN 19:9" />i palem đerdinđa ki palata hem pučlja e Isuse: “Kotar injan?”</para>
  <para style="p" vid="JHN 19:9">Ali o Isus ništa na phenđa.<verse eid="JHN 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 19:10" />Tegani o Pilat phenđa lese: “Maje li na mangeja te phene? Na džaneja li da isi man vlast te mukav tut hem vlast te čhivav tut ko krsto?”<verse eid="JHN 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 19:11" />O Isus phenđa lese: “Naka ovel tut ine nisavi vlast upra mande, te na ovel će ine dindi e Devlestar. Adalesei po baro greh okolesoro kova predinđa man tute.”<verse eid="JHN 19:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 19:12" />Otegani o Pilat po više dikhlja te mukel le.</para>
  <para style="p" vid="JHN 19:12">Ali e jevrejengere vođe vičinde: “Te mukljan akale, na injan e rimesere carosoro amal! Ko pese phenela dai caro, protivini pe e carose!”<verse eid="JHN 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 19:13" />Kad šunđa adava, o Pilat ikalđa e Isuse avri hem beštino ki stolica e sudosiri, ko than savo vičini pe Ploča oto bar – jevrejski: Gavata. <verse eid="JHN 19:13" /><verse number="14" style="v" sid="JHN 19:14" />A adava inele Dive oti priprema zaki Pasha, paše uzalo dešu duj o sati diveste.</para>
  <para style="p" vid="JHN 19:14">O Pilat phenđa e Jevrejenđe: “Ače tumaro caro!”<verse eid="JHN 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 19:15" />A o Jevreja vičinde: “Mudar le! Mudar le! Čhiv le ko krsto!”</para>
  <para style="p" vid="JHN 19:15">A o Pilat pučlja len: “Tumare li caro te čhivav ko krsto?”</para>
  <para style="p" vid="JHN 19:15">A o šerutne sveštenici phende lese: “Amen nane aver caro sem e rimesoro caro!”<verse eid="JHN 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 19:16" />Tegani o Pilat predinđa e Isuse ko vojnici te čhiven le ko krsto, i on lelje le hem legarde le.<verse eid="JHN 19:16" /></para>
  <para style="s">E Isuse čhivena ko krsto</para>
  <para style="r">(<ref loc="MAT 27:32-44">Mt 27,32–44</ref>; <ref loc="MRK 15:21-32">Mk 15,21–32</ref>; <ref loc="LUK 23:26-43">Lk 23,26–43</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 19:17" />Akharindoj plo krsto, o Isus alo ko than vičime Kokalo e šeresoro – savo ko jevrejski vičini pe: “Golgota” – <verse eid="JHN 19:17" /><verse number="18" style="v" sid="JHN 19:18" />kaj čhivde le ko krsto. A oleja čhivde ko krsto pana dujen – jekhe oti jekh strana, avere oti dujto, a o Isus ko maškar.<verse eid="JHN 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 19:19" />O Pilat dinđa te čhivel pe ko krsto jekh natpis ko savo pisinđa akava: <char style="sc">O Isus o Nazarećanin, o caro e jevrejengoro. </char> <verse eid="JHN 19:19" /><verse number="20" style="v" sid="JHN 19:20" />But Jevreja čitinde adava natpis, adalese so o than kaj o Isus inele čhivdo ko krsto inele paše uzali diz. A inele pisime ki jevrejsko, latinsko hem grčko čhib.<verse eid="JHN 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 19:21" />O šerutne sveštenici e jevrejengere phende e Pilatese: “Ma pisin: ‘caro e jevrejengoro’, nego da ov phenđa dai caro e jevrejengoro.”<verse eid="JHN 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 19:22" />A o Pilat phenđa lenđe: “So pisinđum – pisinđum.”<verse eid="JHN 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 19:23" />Kad čhivde e Isuse ko krsto, o vojnici lelje lesere šeja hem podelinde len ko štar kotora – svakone vojnikose po jekh kotor. Lelje hem lesoro gad, savo na inele sivdo, adalese so odupral đi tele inele pletime sar jekh kotor.<verse eid="JHN 19:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 19:24" />Tegani o vojnici phende jekh averese: “Hajde te na pharava o gad, nego te frda o barbuti olese, te dikha kasoro ka ovel.” Adava ulo sar te pherđol okova soi pisime ano Sveto lil:</para>
  <para style="q1" vid="JHN 19:24">“Mle šeja delinde maškara pumende</para>
  <para style="q2" vid="JHN 19:24">hem frdinde o barbuti mle gadese.”</para>
  <para style="m" vid="JHN 19:24">I o vojnici ađahar hem ćerde.<verse eid="JHN 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 19:25" />A uzalo e Isusesoro krsto terđovena ine e Isusesiri daj, lakiri phen, i Marija e Klopesiri romni hem i Marija Magdalena.<verse eid="JHN 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 19:26" />Kad o Isus dikhlja pla daja hem uzalo late e učeniko kole but volinđa, phenđa laće: “Đuvlije, ače tuće čhavo.”<verse eid="JHN 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 19:27" />A e učenikose phenđa: “Ače tuće daj.”</para>
  <para style="p" vid="JHN 19:27">Hem otegani o učeniko lelja la peste.<verse eid="JHN 19:27" /></para>
  <para style="s">E Isusesoro meriba</para>
  <para style="r">(<ref loc="MAT 27:45-56">Mt 27,45–56</ref>; <ref loc="MRK 15:33-41">Mk 15,33–41</ref>; <ref loc="LUK 23:44-49">Lk 23,44–49</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 19:28" />Palo adava, o Isus džanđa da pherdilo sa so valjanđa te ovel. A sar te pherđol o Sveto lil, phenđa hem akava: “Žedno injum.”<verse eid="JHN 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 19:29" />A adari inele jekh čaro pherdo ušlja moljaja, i čhivde o sunđeri ani ušli mol, čhivde le upri e isopesiri trska hem vazdinde le nakoro e Isusesoro muj.<verse eid="JHN 19:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 19:30" />Kad o Isus čhivđa ano muj i mol, phenđa: “Završimei!” Tegani peravđa plo šero hem muklja pli duša.<verse eid="JHN 19:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 19:31" />Adalese so inele Dive zako pripremiba zako savato, e jevrejengere vođe zamolinde e Pilate te phagen pe o pre e manušengere kolai ko krsto, sar po sig te meren, i te na ačhoven lengere telija ko krsto prekalo savato. Adalese so ko adava savato inele baro prazniko. <verse eid="JHN 19:31" /><verse number="32" style="v" sid="JHN 19:32" />I o vojnici ale hem phagle o pre e duje manušengere kola ine čhivde ko krsto e Isuseja, prvo jekhesere, onda e dujtonesere. <verse eid="JHN 19:32" /><verse number="33" style="v" sid="JHN 19:33" />A kad ale đi o Isus, dikhle dai već mulo, i na phagle lesere pre, <verse eid="JHN 19:33" /><verse number="34" style="v" sid="JHN 19:34" />nego jekh vojniko kopljeja posavđa le ko rebrija. Hem odmah adathar thavdinđa rat hem pani.<verse eid="JHN 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 19:35" />Zako akava svedočini okova kova adava dikhlja hem lesoroi svedočanstvo čačikano, hem ov džanela da vaćeri o čačipe, i svedočini te šaj hem tumen poverujinen. <verse eid="JHN 19:35" /><verse number="36" style="v" sid="JHN 19:36" />Akava ulo sar te pherđol okova soi pisime ano Sveto lil: “Nijekh kokalo naka ovel lese phago.”<verse eid="JHN 19:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 19:37" />A ko aver than ano Sveto lil pisini: “Ka dikhen okole kole posavde.”<verse eid="JHN 19:37" /></para>
  <para style="s">E Isusesoro paruniba</para>
  <para style="r">(<ref loc="MAT 27:57-61">Mt 27,57–61</ref>; <ref loc="MRK 15:42-47">Mk 15,42–47</ref>; <ref loc="LUK 23:50-56">Lk 23,50–56</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 19:38" />Palo adava o Josif tari Arimateja zamolinđa e Pilate te mukel lese te lel e Isusesoro telo. O Josif inele e Isusesoro učeniko, ali na javno, adalese so darandilo e jevrejengere vođendar. O Pilat muklja lese adava, i ov alo hem legarđa o telo. <verse eid="JHN 19:38" /><verse number="39" style="v" sid="JHN 19:39" />A alo hem o Nikodim – okova kova angleder alo ine koro Isus prekali rat. Ov anđa peja đi sar trijanda kilja mirisija, mešavina oti smirna hem aloja. <verse eid="JHN 19:39" /><verse number="40" style="v" sid="JHN 19:40" />Tegani lelje e Isusesoro telo hem paćarde le čaršaveja ko savo inele o mirisija, palo adeti e jevrejengoro zako paruniba. <verse eid="JHN 19:40" /><verse number="41" style="v" sid="JHN 19:41" />A uzalo than kaj o Isus inele čhivdo ko krsto, inele jekh vrt. Ano adava vrt inele jekh nevo grobo ano savo pana niko na inele parume. <verse eid="JHN 19:41" /><verse number="42" style="v" sid="JHN 19:42" />Adalese so inele e jevrejengoro Dive zako pripremiba zako savato, hem adalese so o grobo inele paše, čhivde e Isusesoro telo ano leste.<verse eid="JHN 19:42" /></para>
  <chapter eid="JHN 19" />
  <chapter number="20" style="c" sid="JHN 20" />
  <para style="s">E Isusesoro uštiba taro mule</para>
  <para style="r">(<ref loc="MAT 28:1-10">Mt 28,1–10</ref>; <ref loc="MRK 16:1-8">Mk 16,1–8</ref>; <ref loc="LUK 24:1-12">Lk 24,1–12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 20:1" />Rano sabale ko prvo dive oto kurko, sar pana inele tomina i Marija Magdalena ali ko grobo hem dikhlja dai o bar cidime taro ulaz e grobosoro, <verse eid="JHN 20:1" /><verse number="2" style="v" sid="JHN 20:2" />i prastandoj dželi koro Simon Petar hem koro aver učeniko, kole o Isus but volinđa, hem phenđa lenđe: “Legarde e Gospode taro grobo hem na džanaja kaj čhivde le!”<verse eid="JHN 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 20:3" />Tegani o Petar hem okova aver učeniko iklile hem lelje te džan nakoro grobo. <verse eid="JHN 20:3" /><verse number="4" style="v" sid="JHN 20:4" />Soduj džene prastandile zajedno, ali okova dujto učeniko inele po brzo taro Petar hem prvo reslo ko grobo. <verse eid="JHN 20:4" /><verse number="5" style="v" sid="JHN 20:5" />Telilo hem dikhlja o čaršavija save adari inele pašljarde, ali na đerdinđa. <verse eid="JHN 20:5" /><verse number="6" style="v" sid="JHN 20:6" />Tegani palo leste reslja o Simon Petar, i đerdinđa ko grobo hem dikhlja o čaršavija save adari inele pašljarde. <verse eid="JHN 20:6" /><verse number="7" style="v" sid="JHN 20:7" />A i maramica savi inele e Isusese ko šero na inele zajedno e čaršavencar, nego inele ki aver strana paćardi ko jekh than. <verse eid="JHN 20:7" /><verse number="8" style="v" sid="JHN 20:8" />Tegani đerdinđa hem okova aver učeniko, okova kova prvo reslo đi o grobo, dikhlja hem poverujinđa. <verse eid="JHN 20:8" /><verse number="9" style="v" sid="JHN 20:9" />Adalese so, on pana na halile soi pisime ano Sveto lil – da o Isus valjani te uštel taro mule. <verse eid="JHN 20:9" /><verse number="10" style="v" sid="JHN 20:10" />Palo adava o učenici irinde pe pumarende.<verse eid="JHN 20:10" /></para>
  <para style="s">O Isus mothoj pe e Marijaće e Magdalenaće</para>
  <para style="r">(<ref loc="MRK 16:9-11">Mk 16,9–11</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 20:11" />A i Marija terđola ine avri ko grobo hem rovela. Hem sar rovela ine, telili <verse eid="JHN 20:11" /><verse number="12" style="v" sid="JHN 20:12" />hem dikhlja duje anđelen ko parno sar bešena adari kaj inele e Isusesoro telo – jekh ko than kaj inele lesoro šero, a o dujto ko than kaj inele lesere pre.<verse eid="JHN 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 20:13" />A o anđelja pučle la: “Đuvlije, sose roveja?”</para>
  <para style="p" vid="JHN 20:13">A oj phenđa lenđe: “Legarde mle Gospode, hem na džanav kaj čhivde le.”<verse eid="JHN 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 20:14" />Kad adava phenđa, irinđa pe hem dikhlja e Isuse sar terđola, ali na džanđa dai ov adava.<verse eid="JHN 20:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 20:15" />A o Isus pučlja la: “Đuvlije, sose roveja? Kas rodeja?”</para>
  <para style="p" vid="JHN 20:15">A oj, mislindoj dai adava o manuš kova ćerela buti ano vrt, phenđa lese: “Gospodarona, ako tu legarđan le, phen maje kaj čhivđan le, hem me ka lav le.”<verse eid="JHN 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 20:16" />Tegani o Isus phenđa laće: “Marije!”</para>
  <para style="p" vid="JHN 20:16">Oj irinđa pe nakoro leste, hem ko jevrejski phenđa lese: “Rabuni!”– so značini “Učitelju.”<verse eid="JHN 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 20:17" />A o Isus phenđa laće: “Ma zadržin man, adalese so pana na dželjum upre, koro Dad. Nego, dža koro mle phralja, hem phen lenđe: ‘Džava upre, koro mlo Dad hem tumaro Dad, koro mlo Devel hem tumaro Devel.’”<verse eid="JHN 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 20:18" />Hem i Marija Magdalena dželi hem phenđa e učenikonenđe: “Dikhljum e Gospode!”</para>
  <para style="p" vid="JHN 20:18">Hem vaćerđa lenđe okova so o Isus phenđa laće.<verse eid="JHN 20:18" /></para>
  <para style="s">O Isus mothoj pe e učenikonenđe</para>
  <para style="r">(<ref loc="MAT 28:16-20">Mt 28,16–20</ref>; <ref loc="MRK 16:14-18">Mk 16,14–18</ref>; <ref loc="LUK 24:36-49">Lk 24,36–49</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 20:19" />Ki adaja rat ko prvo dive oto kurko, kad o učenici inele zajedno, a o udara phandle adalese so darandile taro e jevrejengere šerutne, o Isus alo hem terdino maškaro lende, i phenđa lenđe: “Mir tumencar.”<verse eid="JHN 20:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 20:20" />Kad adava phenđa, mothovđa lenđe o ožiljci ko ple vasta hem ple rebrija, a o učenici inele radosna so dikhle e Gospode.<verse eid="JHN 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 20:21" />Tegani o Isus palem phenđa lenđe: “Mir tumencar. Sar so mlo Dad bičhalđa man, ađahar hem me bičhalava tumen.”<verse eid="JHN 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 20:22" />Vaćerindoj adava, phudinđa ano lende hem phenđa lenđe: “Priminen e Svetone Duho. <verse eid="JHN 20:22" /><verse number="23" style="v" sid="JHN 20:23" />Kase oprostinena o grehija, oprostimei lenđe, a kase na oprostinena, nane lenđe oprostime.”<verse eid="JHN 20:23" /></para>
  <para style="s">O Isus mothoj pe anglo Toma</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 20:24" />A o Toma vičime Blizanco, jekh e dešu duje učenikonendar, na inele olencar kad o Isus alo.<verse eid="JHN 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 20:25" />Avera učenici phende lese: “Dikhljam e Gospode!”</para>
  <para style="p" vid="JHN 20:25">A ov phenđa lenđe: “Đikote na dikhava o ožiljci e ekserendar olese ko vasta hem na čhivava mlo naj ko than kaj inele o ekserija hem na čhivava mlo vas lese ko rebrija, na verujinava.”<verse eid="JHN 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 20:26" />Palo ofto dive, o učenici palem čedinde pe zajedno andre ano čher, a olencar inele hem o Toma.</para>
  <para style="p" vid="JHN 20:26">Iako o udara inele phandle, o Isus đerdinđa, hem terdino maškaro lende, i phenđa: “Mir tumencar.”<verse eid="JHN 20:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 20:27" />Tegani phenđa e Tomase: “Čhiv to naj akate hem dikh mle vasta. Pružin to vas, i čhiv maje ko rebrija. Hem ma više sumnjin, nego verujin.”<verse eid="JHN 20:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 20:28" />A o Toma tegani phenđa lese: “Mlo Gospod hem mlo Devel!”<verse eid="JHN 20:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 20:29" />A o Isus phenđa lese: “Adalese so dikhljan man, poverujinđan. Blago okolenđe kola na dikhle, a poverujinde.”<verse eid="JHN 20:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 20:30" />O Isus anglo ple učenici ćerđa pana but avera čudesna znakija save nane pisime ani akaja knjiga. <verse eid="JHN 20:30" /><verse number="31" style="v" sid="JHN 20:31" />Ali akavai pisime te verujinen dai o Isus o Hrist, o Čhavo e Devlesoro, hem te šaj, verujindoj, ovel tumen dživdipe ano lesoro anav.<verse eid="JHN 20:31" /></para>
  <chapter eid="JHN 20" />
  <chapter number="21" style="c" sid="JHN 21" />
  <para style="s">O Isus mothoj pe e eftane učenikonenđe</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 21:1" />Palo adava o Isus palem mothovđa pe ple učenikonenđe ko e Tiberijakoro jezero. A mothovđa pe ađahar: <verse eid="JHN 21:1" /><verse number="2" style="v" sid="JHN 21:2" />O Simon Petar, o Toma vičime Blizanco, o Natanailo tari Kana e Galilejakiri, e Zevedejesere čhave hem duj avera učenici inele zajedno.<verse eid="JHN 21:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 21:3" />O Simon Petar phenđa lenđe: “Džava te dolav maćhen.”</para>
  <para style="p" vid="JHN 21:3">A on phende lese: “Hem amen ka dža tuja.”</para>
  <para style="p" vid="JHN 21:3">I džele hem đerdinde ano čamco, ali adaja rat na dolinde ništa.<verse eid="JHN 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 21:4" />A rano sabale, o Isus terdino ki obala, ali o učenici na džande dai ov adava.<verse eid="JHN 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 21:5" />O Isus pučlja len: “Amalalen, dolinđen li nešto?”</para>
  <para style="p" vid="JHN 21:5">A on phende lese: “Na.”<verse eid="JHN 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 21:6" />A o Isus phenđa lenđe: “Frden i mreža ki desno strana oto čamco, hem ka dolen e maćhen.” I on frdinde i mreža hem edobor dolinde maćhen da našti ine te ikalen i mreža taro pani.<verse eid="JHN 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 21:7" />Tegani okova učeniko kole o Isus but volinđa, phenđa e Petrese: “Adavai o Gospod!”</para>
  <para style="p" vid="JHN 21:7">Kad šunđa dai adava o Gospod, o Simon Petar phandlja pe o ogrtači ko maškar, adalese so inele nango, hem ripinđa ano jezero. <verse eid="JHN 21:7" /><verse number="8" style="v" sid="JHN 21:8" />A avera učenici čamcoja ale đi i obala, vucindoj i mreža e maćhencar, adalese so na inele dur oti obala – đi sar šel metarija. <verse eid="JHN 21:8" /><verse number="9" style="v" sid="JHN 21:9" />Kad iklile ki obala, dikhle i jag savi inele već thardi hem upro late maćhe hem maro.<verse eid="JHN 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 21:10" />O Isus phenđa lenđe: “Anen nekobore maćhen adalendar save dolinđen.”<verse eid="JHN 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 21:11" />Tegani o Simon Petar uklilo ko čamco hem ki obala ikalđa i mreža, pherdi bare maćhencar – šelu pindu trin maćhe. Ali, iako inele edobor but, i mreža na pharavdili.<verse eid="JHN 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 21:12" />A o Isus phenđa lenđe: “Aven hem han doručko.”</para>
  <para style="p" vid="JHN 21:12">Hem nijekh e učenikonendar na tromandilo te pučel le: “Ko injan tu?,” adalese so džande dai adava o Gospod.<verse eid="JHN 21:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 21:13" />Tegani o Isus lelja o maro hem dinđa len, a isto ađahar hem e maćhen. <verse eid="JHN 21:13" /><verse number="14" style="v" sid="JHN 21:14" />Adava inele trito puti da o Isus mothovđa pe ple učenikonenđe sar uštino taro mule.<verse eid="JHN 21:14" /></para>
  <para style="s">O Isus hem o Petar</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 21:15" />Kad hale maro, o Isus pučlja e Simone Petre: “Simone, čhaveja e Jovanesereja, volineja man li više nego akala?”</para>
  <para style="p" vid="JHN 21:15">O Petar phenđa lese: “Oja, Gospode, tu džane da volinava tut.”</para>
  <para style="p" vid="JHN 21:15">A o Isus phenđa lese: “Parvar mle bakroren.”<verse eid="JHN 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 21:16" />Tegani o Isus dujto puti pučlja le: “Simone, čhaveja e Jovanesereja, volineja man li?”</para>
  <para style="p" vid="JHN 21:16">A o Petar palem phenđa lese: “Oja, Gospode, tu džane da volinava tut.”</para>
  <para style="p" vid="JHN 21:16">A o Isus phenđa lese: “Arakh mle bakren.”<verse eid="JHN 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 21:17" />Tegani o Isus trito puti pučlja le: “Simone, čhaveja e Jovanesereja, volineja man li?”</para>
  <para style="p" vid="JHN 21:17">A o Petar rastužinđa pe so o Isus trito puti pučlja le: “Volineja man li?” I phenđa lese: “Gospode, tu džane sa, hem džane da volinava tut.”</para>
  <para style="p" vid="JHN 21:17">A o Isus phenđa lese: “Parvar mle bakren. <verse eid="JHN 21:17" /><verse number="18" style="v" sid="JHN 21:18" />Čače, čače vaćerava će: kad injanle terno, korkoro phandeja tut ine to pojas hem džaja kaj mangeja. Ali kad ka puranđove, ka širine te vasta, i avera ka phanden tut hem ka legaren tut kaj na mangeja.”<verse eid="JHN 21:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 21:19" />O Isus adava phenđa sar te mothoj save meribnaja o Petar ka proslavini e Devle. Tegani phenđa lese: “Phir pala mande.”<verse eid="JHN 21:19" /></para>
  <para style="s">O učeniko kole o Isus volinđa</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 21:20" />O Petar irinđa pe hem dikhlja okole učeniko kole o Isus but volinđa sar phirela palo lende, okova kova zaki večera pašljarđa pe nakoro Isus hem pučlja le: “Gospode, ko ka izdajini tut?”<verse eid="JHN 21:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 21:21" />Kad o Petar dikhlja le, pučlja e Isuse: “Gospode, a so ka ovel akaleja?”<verse eid="JHN 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 21:22" />A o Isus phenđa lese: “Te me mangava ov te ačhol dživdo đikote na irinav man, so isi tut adaleja? Tu phir pala mande.”<verse eid="JHN 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 21:23" />Ađahar maškaro phralja šundilo da adava učeniko naka merel. Ali o Isus na phenđa da ov naka merel, nego: “Te me mangava te ačhol dživdo đikote na irinav man, so isi tut adaleja?”<verse eid="JHN 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 21:24" />Adava učeniko svedočini zako sa akava hem ov sa akava pisinđa, hem amen džanaja dai lesoro svedočanstvo čačikano. <verse eid="JHN 21:24" /><verse number="25" style="v" sid="JHN 21:25" />Ali, isi pana but so o Isus ćerđa hem te ovel ine sa palo redo pisime, mislinava da sa adala knjige naka resen ine ni ko sa o sveto!<verse eid="JHN 21:25" /></para>
  <chapter eid="JHN 21" />
</usx>