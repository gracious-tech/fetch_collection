<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JAS" style="id">- Melo New Testament Latin</book>
  <para style="h">Yayqqooba</para>
  <para style="toc1">Yayqooba Xaafeez Kiitaa</para>
  <para style="toc2">Yayqqooba</para>
  <para style="toc3">Yay.</para>
  <para style="mt1">Yayqqooba Xaafeez Kiita</para>
  <para style="imt">Gelo</para>
  <para style="ip">Yhay Yayqqooba kiitay, ammaniza asii gallas gallas fa yezod yessa tamarisiza qofita aykkeeza. Yha kiitay xaafintteezay, biitta ubbayil laalintteez taphpho nam7i Ayihude kochchitayis. Yha maxaafe xaafeezay, eccetith nuunii oosol peeshshiz hiilla, ammaniza asa moko baggannee lo77o amalebagga oge maaqiz bazita misili odar geeshshii beeziza.</para>
  <para style="ip">Yayqqooba kiitay, Manqqotith bagga, duretith bagga, paace bagga, lo77o amale bagga, qinaatebagga, ammano bagga, lo77o ooso bagga, iranthi moodo bagga, eccetith bagga, pettay pettayir kachch bagga, utira bagga, haayotith bagga, hara asal afa pirdda bagga, ceeqintto bagga, garzho bagga, woosa baggannee ammaniza asay oothodayis beeziza baz ubba paaddii xaafeeza.</para>
  <para style="ip">Yayqqooba kiitay, kiristanetith yessay ammano oosor benttiz maaqqeezana qonccisii beeziza.</para>
  <para style="iot">Yayqqooba kiitay aykkeez qofita</para>
  <para style="io1">Sarotho <char style="ior"><ref loc="JAS 1:1">1:1</ref> </char></para>
  <para style="io1">Ammanonnee eccetith <char style="ior"><ref loc="JAS 1:2-8">1:2-8</ref> </char></para>
  <para style="io1">Manqqotithinnee duretith <char style="ior"><ref loc="JAS 1:9-11">1:9-11</ref> </char></para>
  <para style="io1">Paace <char style="ior"><ref loc="JAS 1:12-18">1:12-18</ref> </char></para>
  <para style="io1">Xoossa qaala sissinnee oosol peesho <char style="ior"><ref loc="JAS 1:19-27">1:19-27</ref> </char></para>
  <para style="io1">Ase asapp paro koshshoowaza <char style="ior"><ref loc="JAS 2:1-13">2:1-13</ref> </char></para>
  <para style="io1">Ammanonnee ooso <char style="ior"><ref loc="JAS 2:14-26">2:14-26</ref> </char></para>
  <para style="io1">Iranth moodo bagga <char style="ior"><ref loc="JAS 3:1-18">3:1-18</ref> </char></para>
  <para style="io1">Ammaniza asinnee yha alama <char style="ior"><ref loc="JAS 4:1-5:6">4:1—5:6</ref> </char></para>
  <para style="io1">Duma duma bazitayis inggintteez zorita <char style="ior"><ref loc="JAS 5:7-20">5:7-20</ref> </char></para>
  <para style="ie"/>
  <chapter number="1" style="c" sid="JAS 1"/>
  <para style="p">
    <verse number="1" style="v" sid="JAS 1:1"/>Xoossa Goda Yesuus Kiristtoosa ayllay, Yayqqooba, alame ubbayil laalintteez taphpho nam77ii sheeshitayis kiitteez kiita.<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="MAT 13:55">Mat. 13:55</ref>; <ref loc="MRK 6:3">Mar. 6:3</ref>; <ref loc="ACT 15:13">Haw. O. 15:13</ref>; <ref loc="GAL 1:19">Gal. 1:19</ref></char></note></para>
  <para style="p" vid="JAS 1:1">Saro, yinttis maaqqo.<verse eid="JAS 1:1"/></para>
  <para style="s1">Ammanonnee ecettith</para>
  <para style="p">
    <verse number="2" style="v" sid="JAS 1:2"/>Ta ishuntho, yinttan duma duma paace helliza wode yi lo77o baz denggeezay garkk udii kunth ufayssar ekkoytta. <verse eid="JAS 1:2"/><verse number="3" style="v" sid="JAS 1:3"/>Yi ammanay paacinttay yinttis garzho inggizana yi eriza. <verse eid="JAS 1:3"/><verse number="4" style="v" sid="JAS 1:4"/>Yi wurssith hellodayis yibatar danda7iko abikka paccekka yinttan polonnee kunth maho. <verse eid="JAS 1:4"/><verse number="5" style="v" sid="JAS 1:5"/>Yinttapp ooskka eccettithii dhabiko Xooss woosso. E yinttis inggoda. Xoossay oonakka borekazar ubbayis keehatithar inggiza Xooss. <verse eid="JAS 1:5"/><verse number="6" style="v" sid="JAS 1:6"/>Zin woossittar ammanor se7ekkazar Xoossa woosso. Se77iza oonkka carkko eni7isin eni7iza abba zulo garkke. <verse eid="JAS 1:6"/><verse number="7-8" style="v" sid="JAS 1:7-8"/>Nam77ii qofa yezaynne fa ogayil eqqooya oonkka Godaypp abkka demmada aazippe.<verse eid="JAS 1:7-8"/></para>
  <para style="s1">Manqqotithinnee duretis</para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 1:9"/>Ammaniza manqqo asay, Xoossay unttan dhoqqi udod gisho ufaytto. <verse eid="JAS 1:9"/><verse number="10" style="v" sid="JAS 1:10"/>As duretithii fudhe garkk dhabiza gishos ammaniza dure asay Xoossay unttan ziqqi udikokka ufaytto.<note caller="-" style="x"><char style="xo" closed="false">1:10-11 </char><char style="xt" closed="false"><ref loc="ISA 40:6-7">Isa. 40:6-7</ref></char></note> <verse eid="JAS 1:10"/><verse number="11" style="v" sid="JAS 1:11"/>Away fa mishar kezii maata melisiza, fudha gufisiza; e lo77otithaykka dhabiza. Yey garkkekka, dure asay fa oosor daaburittar dhaboda.<verse eid="JAS 1:11"/></para>
  <para style="s1">Ase helliza paace</para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 1:12"/>Meto gamii aadheezaypp guye, Xoossay fana qaadhizitayis immad gi qaala caaqo geleez de7o zawude ekkod gishos metor garzhiza as anjjintteezaya. <verse eid="JAS 1:12"/><verse number="13" style="v" sid="JAS 1:13"/>Oonkka paacinttiza wode «Tana Xoossay paacceeza» giippe. Xoossay iitar paacinttooya; ma E oonakka paaccooya. <verse eid="JAS 1:13"/><verse number="14" style="v" sid="JAS 1:14"/>Zin pettii pettii as fa iita amotithar gooshinttittaranne dooshinttittar paacinttiza. <verse eid="JAS 1:14"/><verse number="15" style="v" sid="JAS 1:15"/>Yeyppe guye, amotith wodexxii nagara yeliza; ma nagara diccii yhayiqo yeliza.<verse eid="JAS 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JAS 1:16"/>Ta siiqo ishuntho, doshinttippate. <verse eid="JAS 1:16"/><verse number="17" style="v" sid="JAS 1:17"/>Lo77o imonnee kunthi anjjo ubbitay saloppennee salopp yi7iza. Yeykka kuya garkk ubba wode wutoowa woy laaminttoowa poo7itay aday Xoossaypp yi7iza. <verse eid="JAS 1:17"/><verse number="18" style="v" sid="JAS 1:18"/>Nuunii, e medhetithis bayira maaqqad garkk nuna tuma qaalar fa shener yeleeza.<verse eid="JAS 1:18"/></para>
  <para style="s1">Si7eezanna oosol afa peesho</para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 1:19"/>Ta siiqo ishuntho, yhaya dogippate. As ubbay si7odayis elliso, zin odinttodayisnee kaccinttodayis ellisippe. <verse eid="JAS 1:19"/><verse number="20" style="v" sid="JAS 1:20"/>As kachchii Xoossay xillotitha ko7ooya. <verse eid="JAS 1:20"/><verse number="21" style="v" sid="JAS 1:21"/>Yey gishos, tuna hanonnee iitatith ubba dhabisii, Xoossay yi wozina gancce tukkeez yi shemppo ashshodayis danda7iza qaala haayotithar ekkoytta.<verse eid="JAS 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JAS 1:22"/>Zin Xooss qaala oosol peeshshoyttapp attin si7ith aaddar yinttan dooshippatte. <verse eid="JAS 1:22"/><verse number="23" style="v" sid="JAS 1:23"/>Qaala si7ii oothowa asii, E fana masttooter bi7iz asgarkke. <verse eid="JAS 1:23"/><verse number="24" style="v" sid="JAS 1:24"/>E fana bi7ii maaqqii qitiza, zin e ab aazizako ellis dogiza. <verse eid="JAS 1:24"/><verse number="25" style="v" sid="JAS 1:25"/>Zin oonkka wallo kessiza folo higge akaakar bi7ii, kaallii naagizay, si7eezana dogekka oosol peeshshiza athay, fa ooso ubbayir anjjinttoda.<verse eid="JAS 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 1:26"/>Fa irantha naagekkazar goynniza giz athay fana dooshiza; e goynnay cere. <verse eid="JAS 1:26"/><verse number="27" style="v" sid="JAS 1:27"/>Xooss Aday tiina boro baa geesh goynnay yhaya: zhi7o na7itannee am7ita u metayid maadennee alame tunapp fana naago.<verse eid="JAS 1:27"/></para>
  <chapter eid="JAS 1"/>
  <chapter number="2" style="c" sid="JAS 2"/>
  <para style="s1">Ase qurppe</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 2:1"/>Ta ishuntho, yi nu bonchcho Goda Yesuus Kiristtoosa ammaniza maaqqiko, as aafe bi7ii as bonchchippatte. <verse eid="JAS 2:1"/><verse number="2" style="v" sid="JAS 2:2"/>Aazisos, worqqe miggiddo aathii, lo77o afila ma7eez dure as yi shiiqayid ye7eeza. Ma curqqa afila ma7eez manqqo asikka ye7eeza. <verse eid="JAS 2:2"/><verse number="3" style="v" sid="JAS 2:3"/>Lo77o afila ma7eez atha yi aathii bonchchii, «Ne yhannee lo77iza oyidatil bettoba» gi, ma manqqo atha, «Ne ezayid eqqoba woy yhannee ta toke lanqqatte sa7a bettoba» yi yeegiza. <verse eid="JAS 2:3"/><verse number="4" style="v" sid="JAS 2:4"/>Yeezin, yinttii, yi gancce shaako medhdheezittannee iita qofar yez daynnitay garkk baasanee?<verse eid="JAS 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 2:5"/>Ta siiqo ishuntho, si7oytta. Ammanor dure maaqqad garkk fana qadhdhizitayis immad geez salo kaatetithii laattodgarkk yha sa7all yeezii manqqita Xoossay doorekasanee? <verse eid="JAS 2:5"/><verse number="6" style="v" sid="JAS 2:6"/>Zin yi manqqita toochchiza. Yinttan ciiphichizitayinnee pirdde keeth goochizitay durita baasanee? Yinttan daynna tiina goochchizitay unttan baasanee? <verse eid="JAS 2:6"/><verse number="7" style="v" sid="JAS 2:7"/>Yi xeegintteez bonchcho suntha cazhizitay unttan baasanee?<verse eid="JAS 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JAS 2:8"/>Zin Geeshsha Maxaafayid, «As ubba nena ne qadhdhizay garkk qadhdhoba» ginttinttii xaafintteez Xooss kaatetith higga yi poliko lo77o baz oothiza.<note caller="-" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="LEV 19:18">Lewii. 19:18</ref></char></note> <verse eid="JAS 2:8"/><verse number="9" style="v" sid="JAS 2:9"/>Zin yi as aafe bi7ii bonchchiko, nagara oothiza, ma higgay yinttan higge mentheez as garkk pirddoda. <verse eid="JAS 2:9"/><verse number="10" style="v" sid="JAS 2:10"/>Oonkka Xooss higge ubbapp petta ashshii, atteezita ubba naagiko ubbana mentheezay garkk taybinttiza. <verse eid="JAS 2:10"/><verse number="11" style="v" sid="JAS 2:11"/>«Laammippe» geez Goday, ma «Wodhippe» geeza. Zin neenii laamekka attii wodhdheez maaqqiko, higge mentheeza.<note caller="-" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="EXO 20:13-14">Kes. 20:13-14</ref>; <ref loc="DEU 5:17-18">Nam7i. 5:17-18</ref></char></note> <verse eid="JAS 2:11"/><verse number="12" style="v" sid="JAS 2:12"/>Wallo kessiza higge tiina pirdde ekkodayis yez as garkk odinttoyttanne oothoytta. <verse eid="JAS 2:12"/><verse number="13" style="v" sid="JAS 2:13"/>As maaroowa oonakka Xoossii pirddoda maarotith bayth pridoda. Maaqqozin maarotithi pirdda gamiza.<verse eid="JAS 2:13"/></para>
  <para style="s1">Ammanonnee ooso</para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 2:14"/>Ta ishuntho, yinttipp pettii asii taasi ammano yeza gi, fa ammano oosor beezekka attiko eza ab maaddodee? E ammanay eza ashshodayis danda7inee? <verse eid="JAS 2:14"/><verse number="15" style="v" sid="JAS 2:15"/>Aazisos pettii ishay woy pettii mishita kallotikonnee unttis miizibaz dhabiko, <verse eid="JAS 2:15"/><verse number="16" style="v" sid="JAS 2:16"/>yinttipp pettii asii unttiko, «Saro yhanigoytta! Yinttan ho77o! Mi mizhoytta!» gi, koshshiza baz unttis inggekka attiko unttan ab maaddee? <verse eid="JAS 2:16"/><verse number="17" style="v" sid="JAS 2:17"/>Yey gishos, ooso baa ammano fa aaddas yhayqqo.<verse eid="JAS 2:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JAS 2:18"/>Zin pettii asii, «Nees ammano yeza; ma taas ooso yeza. Ne ne ammana ne oosaypp shaakkii tana beezoba; taakka ta ammana ta oosor nena beezoda» yeegiza. <verse eid="JAS 2:18"/><verse number="19" style="v" sid="JAS 2:19"/>Neenii, pettii Xoossii yezana ammaniza; yey yesse. Tuna ayyanitaykka ammaniza; yashshar kukkuriza. <verse eid="JAS 2:19"/><verse number="20" style="v" sid="JAS 2:20"/>Neno boozayo! Ammano oosopp shaakinttii yhayqqo maaqqeezana erodayis koyinnee? <verse eid="JAS 2:20"/><verse number="21" style="v" sid="JAS 2:21"/>Nu aday Afraame, fa na7a Isaaqa yarshsho aqol afa gaddeez wode xilleezay fa oosor baasa?<note caller="-" style="x"><char style="xo" closed="false">2:21 </char><char style="xt" closed="false"><ref loc="GEN 22:1-14">Medhe. 22:1-14</ref></char></note> <verse eid="JAS 2:21"/><verse number="22" style="v" sid="JAS 2:22"/>E ammanannee e oosay wolla ootheezannee e ammanay oosor polintteezana bo7oosaa? <verse eid="JAS 2:22"/><verse number="23" style="v" sid="JAS 2:23"/>Geeshsha Maxaafay, «Afraame Xooss ammaneeza. Xoossay yeya ezis xillotithi udii taybeeza» geezay polintteeza. Ma E Xooss dabbo ginttinttii xeegintteeza.<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="GEN 15:6">Medhe. 15:6</ref>; <ref loc="2CH 20:7">2 Zeena. 20:7</ref>; <ref loc="ISA 41:8">Isa. 41:8</ref></char></note> <verse eid="JAS 2:23"/><verse number="24" style="v" sid="JAS 2:24"/>Asii ammano aaddar baazin oosor xillizana ne bi7inee.<verse eid="JAS 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JAS 2:25"/>Yey garkke, wushumizana Ra7aaba Isra7eelepp kiitintteezita mokkii hara oger unttan moyzeez wode fa oosor xillekkasa?<note caller="-" style="x"><char style="xo" closed="false">2:25 </char><char style="xt" closed="false"><ref loc="JOS 2:1-21">Iyya. 2:1-21</ref></char></note><verse eid="JAS 2:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 2:26"/>Shemppopp shaakintteez ashay yhayqqo maaqqeezay garkk, oosopp shaakintteez ammanaykka yhayqqeezbazii.<verse eid="JAS 2:26"/></para>
  <chapter eid="JAS 2"/>
  <chapter number="3" style="c" sid="JAS 3"/>
  <para style="s1">Iranth naago</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 3:1"/>Ta ishuntho, yinttapp gaamitay asitamaare maaqqippe. Nu, asitamaaritay yhankkitaypp aadhiz pirdda ekkodana yi eriza. <verse eid="JAS 3:1"/><verse number="2" style="v" sid="JAS 3:2"/>Nu ubbitay gaamebazar balinttiza. Fa odayir balinttowa oonkka fanatitha naagodayis danda7iza folo as. <verse eid="JAS 3:2"/><verse number="3" style="v" sid="JAS 3:3"/>Paritay nuus kiitinttod garkk bixaala barssii nu koyiz aqo ubba kanggiza. <verse eid="JAS 3:3"/><verse number="4" style="v" sid="JAS 3:4"/>Markkabe ab garkk gita maaqqikokka wolqqama carkkor uriqinttikokka, laaggizay fa koyiz aqol mahii laaggiza xiqqa mithar laaginttii yhanigiza. <verse eid="JAS 3:4"/><verse number="5" style="v" sid="JAS 3:5"/>Yey garkk iranthi asetith kippilepp xiqqat maaqqikokka gaame dammabazal ceeqinttiza.</para>
  <para style="p" vid="JAS 3:5">Xiqqa tama damma wora xuuggiza. <verse eid="JAS 3:5"/><verse number="6" style="v" sid="JAS 3:6"/>Iranthi tama garkke. Iranthi nu asetith gancce yez iita alame; asetith ubba tunisiza. Gaannamepp keziz tama garkk nu de7o laaso ubba xuuggiza. Fa ommaskka xuuginttoda <verse eid="JAS 3:6"/><verse number="7" style="v" sid="JAS 3:7"/>Biitta do7itannee kafita, ulor gooshinttizitannee abba yez medhetithitakka ubba asii moodiza; unttikka moodintteeza. <verse eid="JAS 3:7"/><verse number="8" style="v" sid="JAS 3:8"/>Zin oonkka iranthi moododayis danda7ekkaya. Iranthii wodhiza marze kumeez moodinttoowa iita medhetithii. <verse eid="JAS 3:8"/><verse number="9" style="v" sid="JAS 3:9"/>Nu iranthar nu Godanne nu ada Xoossa galatiza. Ma ezar Xooss aazii Medhintteez as baadiza. <verse eid="JAS 3:9"/><verse number="10" style="v" sid="JAS 3:10"/>Pettii doonappe galatannee baadithii keziza. Ta ishuntho, yhay garkk hanodayis beezooya.<note caller="-" style="x"><char style="xo" closed="false">3:9-10 </char><char style="xt" closed="false"><ref loc="GEN 1:26">Medhe. 1:26</ref></char></note> <verse eid="JAS 3:10"/><verse number="11" style="v" sid="JAS 3:11"/>Pettii ollapp mali7iza haathinnee caanggiza haathii pulttodayis danda7inee? <verse eid="JAS 3:11"/><verse number="12" style="v" sid="JAS 3:12"/>Ta ishuntho, balase mithii woyira aafodayis danda7inee? Woy woyne mithii balase mith aafe aafodayis danda7inee? Camo haathapp mal7iza haathii benttodayis danda7inee.<verse eid="JAS 3:12"/></para>
  <para style="s1">Salo ecetithinnee sa7a ecetith</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 3:13"/>Yi gancce ecannee akaakizay oonoo? Fa lo77o yessar, haayotithar ecetithar fa ootheez oosa beezo. <verse eid="JAS 3:13"/><verse number="14" style="v" sid="JAS 3:14"/>Zin yi wozinayid caanggiza qinaatennee fana qadhdhiz ecetithii yeziko gayirinttipatte; tumal afa worddotippatte. <verse eid="JAS 3:14"/><verse number="15" style="v" sid="JAS 3:15"/>Yey garkk ecetithay salopp ye7eez baz baazin yey ashoppe, alameppenee, xalaheppe. <verse eid="JAS 3:15"/><verse number="16" style="v" sid="JAS 3:16"/>Qinaatennee fana doso yez aqo kachchinnee iita ooso ubbitay yeza. <verse eid="JAS 3:16"/><verse number="17" style="v" sid="JAS 3:17"/>Yeya maaqqozin afapp yi7iz ecetithay ubbaypp tiina geeshshii. Ma yeyppe sarotith, lo77otith, si7ii ekkiza, qadhinttiza, lo77o aafe kumeezannee, as shagoozitannee cubbotethi baazaya. <verse eid="JAS 3:17"/><verse number="18" style="v" sid="JAS 3:18"/>Sarotithi dosizitay sarotith zerii xillotith maxxiza.<verse eid="JAS 3:18"/></para>
  <chapter eid="JAS 3"/>
  <chapter number="4" style="c" sid="JAS 4"/>
  <para style="s1">Alamel yez ittatitha ixo</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 4:1"/>Kachchinnee ola yi gancce anapp ye7eenee? Yeyititayi yi asetithitay gancce olinttiza yi asho inapp baasannee? <verse eid="JAS 4:1"/><verse number="2" style="v" sid="JAS 4:2"/>Yinttii amottiza, zin denggaamii; yey gishos wodhiza. Miinthii koyiza, zin denggodayis danda7ooya; yey gishos kacinttizannee olinttiza. Yi Xoossa woossoowa gishos koyiz baz denggaam. <verse eid="JAS 4:2"/><verse number="3" style="v" sid="JAS 4:3"/>Yi woossiza, Zin denggaamii. Yi asho amo polodayis zhuca oger woosiza gishos denggaamii. <verse eid="JAS 4:3"/><verse number="4" style="v" sid="JAS 4:4"/>Yinttanno, kaddizitayo! Yha alame dosizay Xoossar morkke maaqqizana yi eroosa? Yha alamayir dabbotodayis koyiz oonkka Xoossar morkke. <verse eid="JAS 4:4"/><verse number="5" style="v" sid="JAS 4:5"/>Geeshsha Maxaafay, «Xoossay nuur yezod garkk ootheez Ayyanay, nuunii ezis buzo maaqqad garkk lo7ithii amottiza» geezay cere odizibaz aazinee? <verse eid="JAS 4:5"/><verse number="6" style="v" sid="JAS 4:6"/>Zin Geeshsha Maxaafay, «Xoossay utirttiza asita ixxiza, zin fana haayitayis aadho keehetith inggiza» yeegiz gishos Xoossay aadho keehetithi gaanithii inggiza.<note caller="-" style="x"><char style="xo" closed="false">4:6 </char><char style="xt" closed="false"><ref loc="PRO 3:34">Aazi. 3:34</ref></char></note><verse eid="JAS 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 4:7"/>Yey gishos, Xoossis moodinttoytta; Daabuloosar eqinttoytta; E yinttapp haakkoda. <verse eid="JAS 4:7"/><verse number="8" style="v" sid="JAS 4:8"/>Xoossiko shiiqoytta; E yinttiko shiiqoda. Yinttanno, nagaranchchittayyo, yi kusha meecoytta; nam77ii qofar yezitayyo, yi wozina geeshshoytta. <verse eid="JAS 4:8"/><verse number="9" style="v" sid="JAS 4:9"/>Kayattoytta, yeekkoyttannee afuxoytta. Yi miichchay yeefor, yi ufayssay azanor laamintto. <verse eid="JAS 4:9"/><verse number="10" style="v" sid="JAS 4:10"/>Goday tiina yi ubba ziqqa udoytta; E yinttan dhoqqi dhoqqi udoda.<verse eid="JAS 4:10"/></para>
  <para style="s1">Asal afa pirddippate</para>
  <para style="p">
    <verse number="11" style="v" sid="JAS 4:11"/>Ta ishuntho, pettay petta zigirppate. Fa isha zigirizaynnee ezal afa pirddizay higge zigirizannee higgel afa pirddiza. Neenii higgel afa pirddiko higgel afa pirddiza maaqqizapp attin higge poliza as ne maaqqooya. <verse eid="JAS 4:11"/><verse number="12" style="v" sid="JAS 4:12"/>Higge inggizaynnee pirddizay Xooss aadda. Ashshodayisinnee dhabisodayis danda7izay eza. Yeezin, asal afa pirddizay ne oonoo?<verse eid="JAS 4:12"/></para>
  <para style="s1">Ceeqinttippatte</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 4:13"/>Yi, «Nuunii yhayino woy wontta ye katama woy yha katama yhammada; ezayid laythi bettoda; zal7ii wodhisoda» yeegizitayyo, si7oytta.<note caller="-" style="x"><char style="xo" closed="false">4:13-14 </char><char style="xt" closed="false"><ref loc="PRO 27:1">Aazi. 27:1</ref></char></note> <verse eid="JAS 4:13"/><verse number="14" style="v" sid="JAS 4:14"/>Wontta abii hanodazako yi erooya. Yi yessay wayadazako erizay oonoo? Yinttii xiqqa wode benttii dhabiza shaara garkke. <verse eid="JAS 4:14"/><verse number="15" style="v" sid="JAS 4:15"/>Yeya ashshii, «Goday giiko nuunii yezoda; yhaya woy yeya oothoda» yeegodayis beeziza. <verse eid="JAS 4:15"/><verse number="16" style="v" sid="JAS 4:16"/>Zin yi yhatte utirttizannee ceeqinttiza. Yey garkk ceeqintta ubbay iita.<verse eid="JAS 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JAS 4:17"/>Yey gishos, lo77o baz oothodayis erttar oothowa athayis yey nagara.<verse eid="JAS 4:17"/></para>
  <chapter eid="JAS 4"/>
  <chapter number="5" style="c" sid="JAS 5"/>
  <para style="s1">Duritayis inggintteez naagiso</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 5:1"/>Yhattekka yinttanno, durtayyo, yinttal afa iita metay yi7iza gishos woo woo gi yeekkoytta. <verse eid="JAS 5:1"/><verse number="2" style="v" sid="JAS 5:2"/>Yi shalay buuqqeeza; yi afilaykka bilar miinttintteeza.<note caller="-" style="x"><char style="xo" closed="false">5:2-3 </char><char style="xt" closed="false"><ref loc="MAT 6:19">Mat. 6:19</ref></char></note> <verse eid="JAS 5:2"/><verse number="3" style="v" sid="JAS 5:3"/>Yi worqqaynnee yi biray baltteeza. Ye balitithay yinttis markka maaqqada. Yeykka yi asha tama garkk maada. Yi yha wureez qammitayid yinttis shalo gaantheeza. <verse eid="JAS 5:3"/><verse number="4" style="v" sid="JAS 5:4"/>Yinttii gade oothii peezheez asay kera miishe yi ciggibe7ekkaya. Yey yinttal afa uukkiza. Ye asay uufay wolqqama Goday haye sintteeza.<note caller="-" style="x"><char style="xo" closed="false">5:4 </char><char style="xt" closed="false"><ref loc="DEU 24:14-15">Nam7i. 24:14-15</ref></char></note> <verse eid="JAS 5:4"/><verse number="5" style="v" sid="JAS 5:5"/>Yha sa7all yinttis giigin ufayisar yessadayis qoppii, Shukos giigintteez mehe garkk yinttan dhiikkii ordiseeza. <verse eid="JAS 5:5"/><verse number="6" style="v" sid="JAS 5:6"/>Yinttar eqinttowazin xillaya yi pirddeeza; eza wodheeza.<verse eid="JAS 5:6"/></para>
  <para style="s1">Garzhonnee woosa</para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 5:7"/>Ta ishuntho, Goday ye7itha garzhii naagoytta. Wootar aqiz athay torchchel tiina irannee guye ira ye7od gatho garzhii al7o katha biittapp wayizii naagii helthii ekkizako qoppoytta. <verse eid="JAS 5:7"/><verse number="8" style="v" sid="JAS 5:8"/>Yinttikka garzhoytta. Goda yi7ithay ukkeez gishos ufayssar naagoytta.<verse eid="JAS 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 5:9"/>Ta ishuntho, Xoossay yinttal afa pirddaam garkk pettay pettayil afa zigirppate. Pirddizay pengel eqqeeza. <verse eid="JAS 5:9"/><verse number="10" style="v" sid="JAS 5:10"/>Ta ishuntho, waayer garzheez, Goday sunthar odeez nabita aaziso uddii ekkoytta. <verse eid="JAS 5:10"/><verse number="11" style="v" sid="JAS 5:11"/>Danda7ar garzheezita nuunii anjjintteezita giza. Iyyooba wayizii garzheezako yi si7eeza. Goday wurssithal eza wayizii maaddeezako yi be77eeza. E maarotithinnee qadhe kumeez Goda maaqqeez gishos yeya ootheeza.<note caller="-" style="x"><char style="xo" closed="false">5:11 </char><char style="xt" closed="false"><ref loc="JOB 1:21-22">Iyo. 1:21-22</ref>; <ref loc="JOB 2:10">2:10</ref>; <ref loc="PSA 103:8">Maz. 103:8</ref></char></note><verse eid="JAS 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 5:12"/>Zin ubbapp tiina, ta ishuntho, salor maaqqin woy sa7ar maaqqin woy hara abarakka caaqqippate. Xooss pirdda yi gelaamgarkke yi oday ee maaqqiko, «Ee» goyitta; wa77a maaqqiko, «Wa77a» goytta.<note caller="-" style="x"><char style="xo" closed="false">5:12 </char><char style="xt" closed="false"><ref loc="MAT 5:34-37">Mat. 5:34-37</ref></char></note><verse eid="JAS 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 5:13"/>Yi gancce meto ekkiza oonkka yeziko Xoossa woosso. Ufayttiza oonkka yeziko galatar yexxo. <verse eid="JAS 5:13"/><verse number="14" style="v" sid="JAS 5:14"/>Yinttipp harggintteez oonkka yeziko woosa keethi cimita xeego. U Goday sunthar woyira zayite tizhii ezis Xoossa woosso.<note caller="-" style="x"><char style="xo" closed="false">5:14 </char><char style="xt" closed="false"><ref loc="MAT 5:34-37">Mat. 5:34-37</ref></char></note> <verse eid="JAS 5:14"/><verse number="15" style="v" sid="JAS 5:15"/>Ammanor woosseez woosay hargger yezana pathiza. Goday eza, harggepp denthiza; E nagara ootheez baz maaqqikokka Goday eza maariza. <verse eid="JAS 5:15"/><verse number="16" style="v" sid="JAS 5:16"/>Yey gishos, yi paxod garkk yi nagara pettay pettayis paaxoyttannee pettay pettayis woossoytta. Xillo as woosay wolqqama ooso oothiza. <verse eid="JAS 5:16"/><verse number="17" style="v" sid="JAS 5:17"/>Eelassa nu garkk ase zin Ira sa7all bukkaamay garkk miinthii Xooss woossin hayidzii laythinnee usuppun agina sa7all ira bukkekaya.<note caller="-" style="x"><char style="xo" closed="false">5:17 </char><char style="xt" closed="false"><ref loc="1KI 17:1">1 Kaat. 17:1</ref>; <ref loc="1KI 18:1">18:1</ref></char></note> <verse eid="JAS 5:17"/><verse number="18" style="v" sid="JAS 5:18"/>Maaqqii e Xoossa woossin salopp ira bukkeeza; sa7aykka katha dolseeza.<note caller="-" style="x"><char style="xo" closed="false">5:18 </char><char style="xt" closed="false"><ref loc="1KI 18:42-45">1 Kaat. 18:42-45</ref></char></note><verse eid="JAS 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 5:19"/>Ta ishuntho, yinttapp oonkka tuma ogeppe buutiko, haray eza tumako mahiko, <verse eid="JAS 5:19"/><verse number="20" style="v" sid="JAS 5:20"/>nagara oothizana ye buuta ogeppe mahiz oonkka, e shemppo yhayiqopp ashshizannee e gaame nagarayis maarotith ingizana ero.<note caller="-" style="x"><char style="xo" closed="false">5:20 </char><char style="xt" closed="false"><ref loc="PRO 10:12">Aazi. 10:12</ref>; <ref loc="1PE 4:8">1 Phix. 4:8</ref></char></note><verse eid="JAS 5:20"/></para>
  <chapter eid="JAS 5"/>
</usx>
