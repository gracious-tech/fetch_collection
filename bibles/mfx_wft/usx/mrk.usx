<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="MRK" style="id">- Melo New Testament Latin</book>
  <para style="h">Marqqoosa</para>
  <para style="toc1">Marqqoosa Xaafeez Yesuus Kiristtoosa Wonggile</para>
  <para style="toc2">Marqqoosa</para>
  <para style="toc3">Mar.</para>
  <para style="mt1">Marqqoosa Xaafeez Yesuus Kiristtoosa Wonggile</para>
  <para style="imt">Gelo</para>
  <para style="ip">Marqqoosa Wonggilay, «Yhay Xooss na7a Yesuus Kiristtoosa Wonggile ayth» giittar dendiza. Yha Wonggilayid Yesuusa ooso asinnee mawuter yez as maaqqii Shiiqeeza. E mawutay E timirttayir, iita ayyanal afa yez wolqqayirannee asii ootheez nagara maaror bentteeza. Yesuusa, «Taanii, asii ootheez nagara aylletithapp wallo kessodayisnnee ta shemppo aathii immadayis ye7eez As Na7a» yeegii fa doonar odeeza.</para>
  <para style="ip">Marqqoosa Yesuusa taarika luulo ogerannee wolqqa kumeez oger odeeza. Marqqoosa odizay Yesuusa qaalannee timirtte aadda baazin ootheez malabazita bayrathii odiza. Marqqoosa xammaqiza Waannisa taarika, Yesuusa xinqqatannee e paacintta haatar odii maaqqii, Yesuusa timirttannee e pathizana paaddiza. Aqi aqi yhammadar Yesuusa tamaaritay Yesuusana usa erttar yhanigeezayigarkk Yesuusa ixxizitaykka usa ixxittar yhanigeeza. Wurssith shemppitay Yesuusa path yezin wurssith saamintta polintteez oositay baz odiza. Yeyititaykka e soxinttannee e dendo bagga odiza.</para>
  <para style="iot">Marqqoosa wonggilay Aykkeez qofita</para>
  <para style="io1">Yha Wonggilay ayth <char style="ior"><ref loc="MRK 1:1-13">1:1-13</ref> </char></para>
  <para style="io1">Yesuusa Galila biitta fa oosa aykkeeza <char style="ior"><ref loc="MRK 1:14-9:50">1:14—9:50</ref> </char></para>
  <para style="io1">Yesuusa Yerusalaame biitta ootheez ooso <char style="ior"><ref loc="MRK 10:1-52">10:1-52</ref> </char></para>
  <para style="io1">Wurssith saamintta Yerusalaame heera <char style="ior"><ref loc="MRK 11:1-15:47">11:1—15:47</ref> </char></para>
  <para style="io1">Yesuusa yhayiqopp dendo <char style="ior"><ref loc="MRK 16:1-8">16:1-8</ref> </char></para>
  <para style="io1">Yhayiqopp dendeez Goday benttithinnee dendii salo qito <char style="ior"><ref loc="MRK 16:9-20">16:9-20</ref> </char></para>
  <para style="ie"/>
  <chapter number="1" style="c" sid="MRK 1"/>
  <para style="s1">Xammaqiza Waannisa Sabbako</para>
  <para style="r">(<ref loc="MAT 3:1-12">Mat. 3:1-12</ref>; <ref loc="LUK 3:1-18">Luq. 3:1-18</ref>; <ref loc="JHN 1:19-28">Wan. 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1"/>Yhay Xooss Na7a Yesuus Kiristtoosa Wongile aythi <verse eid="MRK 1:1"/><verse number="2" style="v" sid="MRK 1:2"/>Nabe Isayaasa xaafeez maxaafay gancce Xoossay,</para>
  <para style="q1" vid="MRK 1:2">«Yeezako, taanii ta kiita na7a</para>
  <para style="q2" vid="MRK 1:2">neep tiina dakkoda.</para>
  <para style="q1" vid="MRK 1:2">E ne oga pixxoda.<note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="MAL 3:1">Mil. 3:1</ref></char></note><verse eid="MRK 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MRK 1:3"/>Pettay liizho gadhar uukkii odittar,</para>
  <para style="q2" vid="MRK 1:3">‹Godayis oge pixxoytta;</para>
  <para style="q1" vid="MRK 1:3">E yedhdhodayis goosse</para>
  <para style="q2" vid="MRK 1:3">ezis luulisoytta geeza»</para>
  <para style="m" vid="MRK 1:3">giinttii xaafintteeza.<note caller="-" style="x"><char style="xo" closed="false">1:3 </char><char style="xt" closed="false"><ref loc="ISA 40:3">Isa. 40:3</ref></char></note><verse eid="MRK 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 1:4"/>Xammaqiza Waannisa asa xammaqqittar, «Yi nagaraypp maaqqii xammaqinttoytta; Xoossay yi nagara yinttis atto goda» yeegii qaala odittar liizho gadhapp ye7eeza. <verse eid="MRK 1:4"/><verse number="5" style="v" sid="MRK 1:5"/>Yihuda biitta yez as ubbitayinnee Yerusalaame katama as ubbitay Waannisako yi7iza. Fa nagara buuxin, Waannisa unttan Yorddanoose borkka xammaqiza.<verse eid="MRK 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 1:6"/>Waannisa gimaale ikisepp dadintteez afila ma77iza. Fa xeessayid dafe dancciza; ma boolerannee degera eessara miiza.<note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="2KI 1:8">2 Kaat. 1:8</ref></char></note> <verse eid="MRK 1:6"/><verse number="7" style="v" sid="MRK 1:7"/>Waannisa qaala odittar, «Taapp guyer loythii miinggizay yi7iza. Hara attozin, ta E caamma wodora zuggii billodayis beezooya. <verse eid="MRK 1:7"/><verse number="8" style="v" sid="MRK 1:8"/>Ta yinttan haathar xammaqiza, zin E yinttan geeshsha Ayyanar xammaqoda» yeegeeza.<verse eid="MRK 1:8"/></para>
  <para style="s1">Yesuusa xammaqinttonnee paacintto</para>
  <para style="r">(<ref loc="MAT 3:13-17">Mat. 3:13-17</ref>; <ref loc="MAT 4:1-11">4:1-11</ref>; <ref loc="LUK 3:21-22">Luq. 3:21-22</ref>; <ref loc="LUK 4:1-13">4:1-13</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9"/>Yesuusa ye wode Galila biitta yez Naazirete katamapp yi7in, Waannisa Yorddanoose borkka eza xammaqeeza. <verse eid="MRK 1:9"/><verse number="10" style="v" sid="MRK 1:10"/>Yesuusa haathapp kezeezan garkk salo dooyinttin, geeshsha Ayyanay ezal afa holle garkk wodhdhodar be7eeza. <verse eid="MRK 1:10"/><verse number="11" style="v" sid="MRK 1:11"/>Maakka, «Ta qadhdhiza ta na7ay nena; ta neell ufayttiza» yeegiz girithii salopp ye7eeza.<note caller="-" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="GEN 22:2">Medhe. 22:2</ref>; <ref loc="PSA 2:7">Maz. 2:7</ref>; <ref loc="ISA 42:1">Isa. 42:1</ref>; <ref loc="MAT 3:17">Mat. 3:17</ref>; <ref loc="MAT 12:18">12:18</ref>; <ref loc="MRK 9:7">Mar. 9:7</ref>; <ref loc="LUK 3:22">Luq. 3:22</ref></char></note><verse eid="MRK 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12"/>Izir geeshsha Ayyanay Yesuusa liizho gadha kanggeeza. <verse eid="MRK 1:12"/><verse number="13" style="v" sid="MRK 1:13"/>Yesuusa liizho gadha xalaher paacinttittar oyttam gallas gam7eeza. Do7itayir yezeeza, zin kiitanchchitay yi7ii eza maaddeeza.<verse eid="MRK 1:13"/></para>
  <para style="s1">Yesuusa molo aykkiz oyddii asitana xeegeeza</para>
  <para style="r">(<ref loc="MAT 4:12-22">Mat. 4:12-22</ref>; <ref loc="LUK 4:14-15">Luq. 4:14-15</ref>; <ref loc="LUK 5:1-11">5:1-11</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14"/>Waannisa acintteezaypp guye Yesuusa Xooss kaatetith Wonggile odittar Galila biitta yhanigeeza. <verse eid="MRK 1:14"/><verse number="15" style="v" sid="MRK 1:15"/>«Layithay helleeza; Xooss kaatetithay ukkeeza. Yi nagaraypp maaqqii, Wongila ammanoytta» yeegeeza.<note caller="-" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="MAT 3:2">Mat. 3:2</ref></char></note><verse eid="MRK 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16"/>Yesuusa Galila Abba lanqqer aadhittar, molo aykkiz, Simoonarannee E isha Indiraasera, fa gite abbal afa olizita be7eeza. <verse eid="MRK 1:16"/><verse number="17" style="v" sid="MRK 1:17"/>Unttiko, «Tana kaalloytta; ta yinttan ase aykkith tamarssoda» yeegeeza. <verse eid="MRK 1:17"/><verse number="18" style="v" sid="MRK 1:18"/>Unttikka izir fa gitita olii ashshii Yesuusana kaalo aykkeeza.<verse eid="MRK 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 1:19"/>Izipp xiqqal tiin yhanigii, nam77ii ishita Zabdoosa na7ita, Yayqqoobarannee Waannisara wogolo gancce fa gite lo7ithizita be7eeza. <verse eid="MRK 1:19"/><verse number="20" style="v" sid="MRK 1:20"/>Yesuusa ellisii unttan xeegeeza. Unttikka fa ada Zabdoosa, e ooso asitayir wogolo gancce olii ashshii eza kaallii yhanigeeza.<verse eid="MRK 1:20"/></para>
  <para style="s1">Tuna ayyana aykkeez athay paxeeza</para>
  <para style="r">(<ref loc="LUK 4:31-37">Luq. 4:31-37</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21"/>Unttii qifirnahoome katama geleeza. Maala gallas helleezan garkk Yesuusa ellisii Ayihude Woosa keethi gelii taamarsso aykkeeza. <verse eid="MRK 1:21"/><verse number="22" style="v" sid="MRK 1:22"/>Mawuter yez as garkk tamarssizap attin higge asitamaaritay garkk tamarssoowa gishos asay E timirtta yhay malabaz geeza.<note caller="-" style="x"><char style="xo" closed="false">1:22 </char><char style="xt" closed="false"><ref loc="MAT 7:28">Mat. 7:28</ref></char></note><verse eid="MRK 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 1:23"/>Ye wode tuna ayyana aykkeez pettii athay Ayihuditay Woosa keeth gelii uukkii, <verse eid="MRK 1:23"/><verse number="24" style="v" sid="MRK 1:24"/>«Naazirete Yesuusa, neerannee nuur aba allalle yenee? Nuna dhabisodayis ye7eenee? Ne oonozako ta eriza; ne Xoossa Geeshsh» yeegeeza.<verse eid="MRK 1:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 1:25"/>Yesuusa ya tuna ayyana, «Hayizoba, yha athaypp kezoba» yeegii azazeeza.<verse eid="MRK 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 1:26"/>Tuna ayyanay atha zardizard udii, xilasii uukkii ezapp kezeeza. <verse eid="MRK 1:26"/><verse number="27" style="v" sid="MRK 1:27"/>Asay ubbay malabaz gi, «Yhay abba? yha athay fa mawuter hara attozin tuna ayyanitakka azaziza. Unttikka ees azazinttiza; yhay aba oroth timirtte?» yeegii, fa ganccer pettay pettay woli oychch aykkeeza.<verse eid="MRK 1:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 1:28"/>Yesuusa Waaray ellisii Galila awurajja yez heera ubba kezeeza.<verse eid="MRK 1:28"/></para>
  <para style="s1">Yesuusa gaame harganchchita patheeza</para>
  <para style="r">(<ref loc="MAT 8:14-17">Mat. 8:14-17</ref>; <ref loc="LUK 4:38-41">Luq. 4:38-41</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29"/>Yesuusa ye wode Ayihuditay Woosa keethapp kezii, Yayqqoobara Waannisara Simoona karannee Indiraase kara geleeza. <verse eid="MRK 1:29"/><verse number="30" style="v" sid="MRK 1:30"/>Simoona machchatii indat oxe misha harger woy7ii yezin Yesuusa ize hellin ezisi odeeza. <verse eid="MRK 1:30"/><verse number="31" style="v" sid="MRK 1:31"/>E izko shiiqii, I kusha aykkii, izo denthii esseeza. Oxe misha hargay ellisii izo dakkin iza unttan mokkeeza.<verse eid="MRK 1:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32"/>Hargintteez asa ubbitannee tuna ayyanitay aykkeez asa ubba omathi awa gelii lemi7ilem7odar eziko ke7eeza. <verse eid="MRK 1:32"/><verse number="33" style="v" sid="MRK 1:33"/>Katama yez as ubbay yi7ii keethayis bale shiiqeeza. <verse eid="MRK 1:33"/><verse number="34" style="v" sid="MRK 1:34"/>Yesuusa duma duma harger aykintteez gaame asita pathii, gaame tuna ayyanita kesseeza. E oonozako tuna ayyanitay ereeza. Zin Yesuusa unttan nashshoda kayeeza.<verse eid="MRK 1:34"/></para>
  <para style="s1">Yesuusa Galila biitta taamarsseeza</para>
  <para style="r">(<ref loc="LUK 4:42-44">Luq. 4:42-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35"/>Yesuusa Zhabaro dendii, asii baa aqo woossodayis yhanigeeza. <verse eid="MRK 1:35"/><verse number="36" style="v" sid="MRK 1:36"/>Simoonarannee ezar yezitay eza koyttar yhanigeeza. <verse eid="MRK 1:36"/><verse number="37" style="v" sid="MRK 1:37"/>Unttii eza denggii, «Asay ubbitay nena koyiza» yeegeeza.<verse eid="MRK 1:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38"/>Yesuusa ma unttan, «Hara aqo ukke heerita yedhdhoytta. Ta ye7eezay Wonggile ododayis maaqqeez gishos ezayddakka qaala ododayis beeziza» yeegeeza. <verse eid="MRK 1:38"/><verse number="39" style="v" sid="MRK 1:39"/>Ayihuditay Woosa keethitayid qaala odittar, tuna ayyanita kessittar, Galila biitta ubba wuteeza.<note caller="-" style="x"><char style="xo" closed="false">1:39 </char><char style="xt" closed="false"><ref loc="MAT 4:23">Mat. 4:23</ref>; <ref loc="MAT 9:35">9:35</ref></char></note><verse eid="MRK 1:39"/></para>
  <para style="s1">Yesuusa borqqontto harger yez atha patheeza</para>
  <para style="r">(<ref loc="MAT 8:1-4">Mat. 8:1-4</ref>; <ref loc="LUK 5:12-17">Luq. 5:12-17</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40"/>Borqqontto harge aykkeez pettii athay Yesuusako yi7ii, E tiinayid xuggunii, «Ne qadhdhiko tana geeshshodayis danda7iza» yeegii woosseeza.<verse eid="MRK 1:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41"/>Yesuusa ezis qadhinttii, fa kusha dakkii eza bochchii, «Ta koyiza, geezhoba» yeegeeza. <verse eid="MRK 1:41"/><verse number="42" style="v" sid="MRK 1:42"/>Izir borqqonttay atha dakkin athay ellisii geezheeza. <verse eid="MRK 1:42"/><verse number="43" style="v" sid="MRK 1:43"/>Yesuusa athayiko miinthii naaginttoba gi moyzeeza. <verse eid="MRK 1:43"/><verse number="44" style="v" sid="MRK 1:44"/>Yesuusa eza, «Nena eroba, yhanno ooskka odippe. Zin yhanigii ne galla qeese beezoba. Ne yhatti geeshsh maaqqeezana asa ersodayis, Muse kiitteez yarshsho yarshshoba» yeegii azazeeza.<note caller="-" style="x"><char style="xo" closed="false">1:44 </char><char style="xt" closed="false"><ref loc="LEV 14:1">Lewii. 14:1</ref></char></note><verse eid="MRK 1:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 1:45"/>Zin athay yhanigii, heera ubbayid asis odeeza. Yey gishos, Yesuusa qonccer, katama gelodayis danda7ekkaya. Zin asii baa aqo gaxa yezeeza; ma asii ubba aqopp eziko yi7iza.<verse eid="MRK 1:45"/></para>
  <chapter eid="MRK 1"/>
  <chapter number="2" style="c" sid="MRK 2"/>
  <para style="s1">Yesuusa sila atha patheeza</para>
  <para style="r">(<ref loc="MAT 9:1-8">Mat. 9:1-8</ref>; <ref loc="LUK 5:17-26">Luq. 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1"/>Xiqqa gallasapp guye Yesuusa qifirnahoome maaqqii, kara yeza giz wore sintteeza. <verse eid="MRK 2:1"/><verse number="2" style="v" sid="MRK 2:2"/>Shiiqeez asa keethay ekkaam ixxin hara attozin balaykka un77od gatho gaame as shiiqin, Yesuusa qaala taamarsseeza. <verse eid="MRK 2:2"/><verse number="3" style="v" sid="MRK 2:3"/>Oyddii asitay pettii sila atha tookkii eziko ke7eeza. <verse eid="MRK 2:3"/><verse number="4" style="v" sid="MRK 2:4"/>Asay gaanggeez gishos atha Yesuusako shiishodayis unttis danda7inttaam ixxin, Yesuusa yeza baggayir keetha qaarii, siitingga qawuxii atha e woyi7eez arssatira sulle dakkii Yesuusa tiinayid wotheeza. <verse eid="MRK 2:4"/><verse number="5" style="v" sid="MRK 2:5"/>Yesuusa u ammana bi7ii, ya sila atha, «Ta na7ayyo, ne nagaray atto gintteeza» yeegeeza.<verse eid="MRK 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 2:6"/>Higge asitamaaritaypp ye aqayid bentteez pettii pettii asitay fa wozinayir, <verse eid="MRK 2:6"/><verse number="7" style="v" sid="MRK 2:7"/>«Yha athay yhay garkk iita baz Xoossal afa abis odinttee? Xooss aaddapp attin hara o nagara atto godayis danda7ee?» yeegii qoppeeza.<verse eid="MRK 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8"/>U fa wozinayid yey garkk qoppeezana Yesuusa ellisii fa ayyanar erii, unttiko, «Yinttii yi wozinayir abis yhay garkk qoppee? <verse eid="MRK 2:8"/><verse number="9" style="v" sid="MRK 2:9"/>Sila atha, ‹Ne nagaray atto gintteeza› gizay shawukkinenee? Woy, ‹Dendii eqqii ne arssa tookkii qitoba› gizayi shawukke? <verse eid="MRK 2:9"/><verse number="10" style="v" sid="MRK 2:10"/>Zin taas, As Na7ayis, sa7all afa yessay nagara atto godayis wolqqa yezana yi erod garkk» yeegii ye sila athayiko, <verse eid="MRK 2:10"/><verse number="11" style="v" sid="MRK 2:11"/>«Ta neeko yhatt odiza, dendii ne arssa tookkii ne kara qitoba» yeegeeza.<verse eid="MRK 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 2:12"/>Athay ellithii dendii, fa arssa tookkii as ubbay tiina kezeeza. Asay ubbay malabaz gi, «Nuunii yhay garkk baz yesha bi7ii erooya» yeegii Xoossa galateeza.<verse eid="MRK 2:12"/></para>
  <para style="s1">Yesuusa Lewana xeegeeza</para>
  <para style="r">(<ref loc="MAT 9:9-13">Mat. 9:9-13</ref>; <ref loc="LUK 5:27-32">Luq. 5:27-32</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13"/>Yesuusa maakka Galila Abba lanqqe yhanigii, eziko ye7eez as ubbita taamarsseeza. <verse eid="MRK 2:13"/><verse number="14" style="v" sid="MRK 2:14"/>Ezayir aadhodar, Ilfoosa na7a Lewe ginttinttizay qaraxe gachisiza aqo betteezin bi7ii, «Tana kaalloba» yeegeeza. Leway dendii eza kaalleeza.<verse eid="MRK 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15"/>Yesuusa katha maadayis Leway kara betteeza. Eza kaalliza asay gaame maaqqeez gishos qaraxe gachisiza gaame asaynnee nagara oothiza asay ezarannee E tamaaritayir wolla betteeza. <verse eid="MRK 2:15"/><verse number="16" style="v" sid="MRK 2:16"/>Higge asitamaare maaqqeez pettii pettii Farasaawe asay Yesuusa nagara oothiz asayrannee qaraxe gachisizitayir katha maadar bi7ii, «E abis nagara oothiz asayirannee qaraxe gachisizitayir katha mee?» yeegii, E tamaaritayir woli oyceeza.<verse eid="MRK 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 2:17"/>Yesuusa u gizana si7ii, «Akime harginttiztayisapp attin pathi asis koshshooya. Taanii nagara oothizita xeegodayis ye7eezapp attin xillita xeegodayis ye7ekkaya» yeegii unttisi maheeza.<verse eid="MRK 2:17"/></para>
  <para style="s1">Xooma bagga erodayis shiiqeez oychch</para>
  <para style="r">(<ref loc="MAT 9:14-17">Mat. 9:14-17</ref>; <ref loc="LUK 5:33-39">Luq. 5:33-39</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18"/>Xammaqiza Waannisa tamaaritaynnee Farasaawitay xoomizazin, Pettii pettii asay Yesuusako yi7ii, «Waannisa tamaaritaynnee Farasaawitay tamaaritay xoomiza, Zin ne tamaaritay abis xoomoosa?» yeegeeza.<verse eid="MRK 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19"/>Yesuusa unttiko, «Machcho ekkizay unttar yezin Laazanthitay, xoomodayis danda7inee? Machcho ekkiz athay unttar yezin, xoomodayis danda7ooya. <verse eid="MRK 2:19"/><verse number="20" style="v" sid="MRK 2:20"/>Zin machcho ekkiza athay u kalepp ekinttiza qamma ye7oda, u ya gallas xoomoda.<verse eid="MRK 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21"/>«Cima afilall afa oroth iraafe gaddii sikkiza asii baaya. Gaddii sikkiko, orothay cima afilana per7iza; per7ithaykka tiinaasaypp daligiza. <verse eid="MRK 2:21"/><verse number="22" style="v" sid="MRK 2:22"/>Ma mal7antto woyine cima ogoro gancce buulliz asii baaya. Buulliz maaqqiko, ye woyinay ogorana dhuusiza, fa ubbaskka laalinttiza, ogoraykka iitiza. Zin mal7antto woyine oroth ogoro gancce buulinttiza» yeegeeza.<verse eid="MRK 2:22"/></para>
  <para style="s1">Maala erodayis shiiqeez oychch</para>
  <para style="r">(<ref loc="MAT 12:1-8">Mat. 12:1-8</ref>; <ref loc="LUK 6:1-5">Luq. 6:1-5</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23"/>Yesuusa pettii maala gallas bangga gade ganccer aadhodar, E tamaaritay ezar wolla yhanigttar bangga tizha mirkkii muus aykkeeza. <verse eid="MRK 2:23"/><verse number="24" style="v" sid="MRK 2:24"/>Farasaawe asay Yesuusako, «Yeezin, ne tamaaritay maala gallas woga baabaz abis oothee?» yeegeeza.<verse eid="MRK 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 2:25"/>Yesuusa unttiko, «Dawute nayinttii, miiz baz kozheez wode paar yezitayir ootheezana yi nabbabekkasa?<note caller="-" style="x"><char style="xo" closed="false">2:25-26 </char><char style="xt" closed="false"><ref loc="1SA 21:1-6">1 Sam. 21:1-6</ref></char></note> <verse eid="MRK 2:25"/><verse number="26" style="v" sid="MRK 2:26"/>Abiyatara qeese halaqa maaqqii yeza wode Dawute Xoossa keeth gelii, qeeshitay aadda maadaypp attin oonkka maadayis woga baabaz Goday tiina gaddeez yarshsho soollo meeza, paar yezitayiskka inggeeza» yeegeeza.<note caller="-" style="x"><char style="xo" closed="false">2:26 </char><char style="xt" closed="false"><ref loc="LEV 24:9">Lewii. 24:9</ref></char></note><verse eid="MRK 2:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 2:27"/>Maakka Yesuusa unttiko, «Maalay asis medhintteezapp attin asii maalas medhinttekkaya. <verse eid="MRK 2:27"/><verse number="28" style="v" sid="MRK 2:28"/>Yey gishos, As Na7ay, hara attozin Maalaskka Goda» yeegeeza.<verse eid="MRK 2:28"/></para>
  <chapter eid="MRK 2"/>
  <chapter number="3" style="c" sid="MRK 3"/>
  <para style="s1">Yesuusa kushe sila atha patheeza</para>
  <para style="r">(<ref loc="MAT 12:9-14">Mat. 12:9-14</ref>; <ref loc="LUK 6:6-11">Luq. 6:6-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1"/>Yesuusa Ayihuditay Woosa keethi maaqqii geleeza. Ezayida kushe sileez pettii athay yeza. <verse eid="MRK 3:1"/><verse number="2" style="v" sid="MRK 3:2"/>Pettii pettii asay Yesuusa mootodayis koyii, kushe sileez atha maala gallas E pathodazakonnee ashshodazako be7adayis koyii miinggii naagiza. <verse eid="MRK 3:2"/><verse number="3" style="v" sid="MRK 3:3"/>Yesuusa kushe sileez atha, «Dendii yhana yi7ii nu gancce eqqoba» yeegeeza. <verse eid="MRK 3:3"/><verse number="4" style="v" sid="MRK 3:4"/>Yeypp guye, asitayiko, «Maala gallas lo77o baz oothizay woganee iita baz oothizay woga? As shemppo ashonnee wodho?» yeegii oyceeza.</para>
  <para style="p" vid="MRK 3:4">Zin asay si77e geeza. <verse eid="MRK 3:4"/><verse number="5" style="v" sid="MRK 3:5"/>Yesuusa shenitii unttan fa kalayir yezita dakkii bi7ii, u wozina docceezita maaqqeez gishos unttan kacceeza. Ya athayiko, «Ne kusha piddi udoba» yeegeeza. Athay piddi udin e kushitay paxeeza. <verse eid="MRK 3:5"/><verse number="6" style="v" sid="MRK 3:6"/>Ellisii Farasaaway Ayihuditay Woosa keethapp bale kezii, Yesuusana wayizii wodhodazako tobbodayis Herodoosa baggitayir pettii kara shiiqeeza.<verse eid="MRK 3:6"/></para>
  <para style="s1">Asay Yesuusako shiiqeeza</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7"/>Yesuusa fa tamaaritayir Galila Abba lanqqe yhanigeeza. Galilapera Yihudap ye7eez gaame asay eza kaalleeza. <verse eid="MRK 3:7"/><verse number="8" style="v" sid="MRK 3:8"/>Maakka Yerusalaamepp, Edomaasapp, Yorddanoose haath pinthappe, Xiroosa katamapper Sidoona giz katamapp Yesuusa ootheez bazita si7ii, gaame asay eziko ye7eeza. <verse eid="MRK 3:8"/><verse number="9" style="v" sid="MRK 3:9"/>Shiiqeez asay gaametithaypp dendeezayid eza waayithaam garkk E tamaaritay wogolo ezis lo7itoday garkk azazeeza.<note caller="-" style="x"><char style="xo" closed="false">3:9-10 </char><char style="xt" closed="false"><ref loc="MRK 4:1">Mar. 4:1</ref>; <ref loc="LUK 5:1-3">Luq. 5:1-3</ref></char></note> <verse eid="MRK 3:9"/><verse number="10" style="v" sid="MRK 3:10"/>Gaame asita E patheez gishos harginttiza asay ubbitay eza bochchodayis urqqinttiza. <verse eid="MRK 3:10"/><verse number="11" style="v" sid="MRK 3:11"/>Tuna ayyana aykkeez asitay eza be7eezan garkk e tiina xuggunii, fa qaala dhoqqi udii, «Ne Xooss Na7aya baasa?» yeegeeza.<verse eid="MRK 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 3:12"/>Yesuusa unttan fa suntha ooskka odaamay garkk miinthii azazeeza.<verse eid="MRK 3:12"/></para>
  <para style="s1">Yesuusa taphpho nam7i hawaarita dooreeza</para>
  <para style="r">(<ref loc="MAT 10:1-4">Mat. 10:1-4</ref>; <ref loc="LUK 6:12-16">Luq. 6:12-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13"/>Yesuusa derell afa kezii, fa kozheez asita faako xeegeeza; unttikka eziko yhanigeeza. <verse eid="MRK 3:13"/><verse number="14" style="v" sid="MRK 3:14"/>Unttikka paar yezoday garkkennee qaala tamaarssoday garkk taphpho nam7ita doorii, unttan, «Hawaarita»<note caller="+" style="f"><char style="fr" closed="false">3:14 </char><char style="fqa" closed="false">Hawaare: </char><char style="ft" closed="false">Hawaare guussay kiitintteez asi guussii.</char></note> gi xeegeeza. <verse eid="MRK 3:14"/><verse number="15" style="v" sid="MRK 3:15"/>Tuna ayyaanttakka kessod garkk unttisi mawute inggeeza.<verse eid="MRK 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 3:16"/>E dooreez taphpho nam7itay yhayitita: Phixiroosa yeeginttii xeeginttiz Simoona, <verse eid="MRK 3:16"/><verse number="17" style="v" sid="MRK 3:17"/>Bo7anerggese (Dada na7ita) yeegii sunth gaddeezita, Zabdoosa na7ita Yayqqoobarannee Yayqqooba isha Waannisa, <verse eid="MRK 3:17"/><verse number="18" style="v" sid="MRK 3:18"/>Indiraase, Filphoosa, Barttolomoosa, Maattoosa, Toomaasa, Ilfoosa na7a Yayqqooba, Taadoosa, Kananepp maaqqeez Simoonarannee, <verse eid="MRK 3:18"/><verse number="19" style="v" sid="MRK 3:19"/>Yesuusa aathii inggeez Asiqoroto Yihuda.<verse eid="MRK 3:19"/></para>
  <para style="s1">Yesuusarannee Bi7elzebular</para>
  <para style="r">(<ref loc="MAT 12:22-32">Mat. 12:22-32</ref>; <ref loc="LUK 11:14-23">Luq. 11:14-23</ref>; <ref loc="LUK 12:10">12:10</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20"/>Yeypp guye, Yesuusa kara geleeza. Ma gaame asay shiiqin, ezara e tamaaritay hara attozin katha maadayiskka danda7ekkaya. <verse eid="MRK 3:20"/><verse number="21" style="v" sid="MRK 3:21"/>Asay eza, «Eeyiza» giz gishos E dabbitay yeya si7ii eza aykkodayis yhanigeeza.<verse eid="MRK 3:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22"/>Higge asitamaaritaypp pettay pettay Yerusalaamepp yi7ii, «Ezal afa Bi7elzebula yeza», E, «Xalahe wolqqar xalahe ayyanita kessiza» yeegii wolla odintteeza.<note caller="-" style="x"><char style="xo" closed="false">3:22 </char><char style="xt" closed="false"><ref loc="MAT 9:34">Mat. 9:34</ref>; <ref loc="MAT 10:25">10:25</ref></char></note><verse eid="MRK 3:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23"/>Yesuusa asita faako xeegii aaziso odeeza. «Xalahe Xalahe wayizii kessodayis danda7ee? <verse eid="MRK 3:23"/><verse number="24" style="v" sid="MRK 3:24"/>Pettii kaatetithay fa gancce shaako kessiko ya kaatetithay eqqodayis danda7ooya. <verse eid="MRK 3:24"/><verse number="25" style="v" sid="MRK 3:25"/>Yey garkk, pettii kara asaykka woli gancce shaako medhdhiko dhabodaypp attin yezodayis danda7ooya. <verse eid="MRK 3:25"/><verse number="26" style="v" sid="MRK 3:26"/>Yikkee, Xalahe wolir morkkinttii duuxiko dhabodaypp attin yezodayis danda7ooya.<verse eid="MRK 3:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 3:27"/>«Zin tiinattii wolqqama atha accekkazar e kara gelii, e shala bonqqodayis danda7iza asii baaya. Accii maaqqeezaypp e kara bonqqodayis danda7iza.<verse eid="MRK 3:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 3:28"/>«Ta yinttis turo odiza; Xoossii as na7itayis nagara ubbannee u cazheez cashsh ubba atto goda. <verse eid="MRK 3:28"/><verse number="29" style="v" sid="MRK 3:29"/>Zin geeshsha Ayyanal afa iita baz odinttiza ooskka medhinas nagara maaqqodaypp attin Xoossii ubbarakka eza maaraamii» yeegeeza.<note caller="-" style="x"><char style="xo" closed="false">3:29 </char><char style="xt" closed="false"><ref loc="LUK 12:10">Luq. 12:10</ref></char></note> <verse eid="MRK 3:29"/><verse number="30" style="v" sid="MRK 3:30"/>Yesuusa yeya geezay, asay, «Ezal afa tuna ayyana yeza» yeegeez gishosii.<verse eid="MRK 3:30"/></para>
  <para style="s1">Yesuusa indatirannee e ishita</para>
  <para style="r">(<ref loc="MAT 12:46-50">Mat. 12:46-50</ref>; <ref loc="LUK 8:19-21">Luq. 8:19-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31"/>E indatinnee E ishitay yi7ii bale eqqii, eza xeegiseeza. <verse eid="MRK 3:31"/><verse number="32" style="v" sid="MRK 3:32"/>E lanqqe betteez gaame asitay, «Ne indatirannee ne ishitayir bale eqqii nena koyiza» yeegeeza.<verse eid="MRK 3:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 3:33"/>Yesuusa mahii, «Ta indat oonoo? Ma ta ishitay aayita?» yeegeeza. <verse eid="MRK 3:33"/><verse number="34" style="v" sid="MRK 3:34"/>Fa kale betteez asa yuuyii bi7ii, «Ta indatinnee ta ishitay yhayttita. <verse eid="MRK 3:34"/><verse number="35" style="v" sid="MRK 3:35"/>Xooss azazo oothiz ubbitay ta ishe, ta misho ta aayo» yeegeeza.<verse eid="MRK 3:35"/></para>
  <chapter eid="MRK 3"/>
  <chapter number="4" style="c" sid="MRK 4"/>
  <para style="s1">Zerth zeriz athay aaziso</para>
  <para style="r">(<ref loc="MAT 13:1-9">Mat. 13:1-9</ref>; <ref loc="LUK 8:4-8">Luq. 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1"/>Yesuusa maakka Galila Abba kale taamarsso aykkeeza. Aqopp aadheez gaame asitay E lanqqayir shiiqin, abbayil yez wogolay gancce gelii betteeza, asay ubbitay Abba lanqqe yeza.<note caller="-" style="x"><char style="xo" closed="false">4:1 </char><char style="xt" closed="false"><ref loc="LUK 5:1">Luq. 5:1</ref></char></note> <verse eid="MRK 4:1"/><verse number="2" style="v" sid="MRK 4:2"/>E unttan gaame baz aazisor taamarsseeza. Tamaarssittar yhay garkk yeegeeza:<verse eid="MRK 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 4:3"/>«Si7oytta! Pettii athay zerth zerodayis kezeeza. <verse eid="MRK 4:3"/><verse number="4" style="v" sid="MRK 4:4"/>E zerodar, pettii pettii zerthay oge achcha wodhdheeza; kafitay yi7ii meeza. <verse eid="MRK 4:4"/><verse number="5" style="v" sid="MRK 4:5"/>Pettii pettii zerthay sisinqqo aadda yez biittal afa wodhdheeza. Afar biitta baazay gishos ye zerithay ellisii doleeza. <verse eid="MRK 4:5"/><verse number="6" style="v" sid="MRK 4:6"/>Zin awa kezeez wode shulleeza. Lo7ithii xapho dakkekka gishos ellisii meleeza. <verse eid="MRK 4:6"/><verse number="7" style="v" sid="MRK 4:7"/>Pettii pettii zerithitay angguth gancce wodhdheeza. Doleezanno angguthii diccii cuulleez gishos aafe aafaam ixxeeza. <verse eid="MRK 4:7"/><verse number="8" style="v" sid="MRK 4:8"/>Pettii pettii zerithitay aradda biittal wodhdhii doleeza. Diccii pettay hasttam, pettay usuppuntam pettay xeet aafeeza» yeegeeza. <verse eid="MRK 4:8"/><verse number="9" style="v" sid="MRK 4:9"/>«Si7iz hayer yez oonkka si7oo» yeegeeza.<verse eid="MRK 4:9"/></para>
  <para style="s1">Yesuusa aazisor odeezay</para>
  <para style="r">(<ref loc="MAT 13:10-17">Mat. 13:10-17</ref>; <ref loc="LUK 8:9-10">Luq. 8:9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10"/>Yesuusa kaler yez asitaynnee taphpho nam77ii tamaaritay Yesuusa fa aadda yezin, eziko shiiqii ya aazisayis bili7itha oyceeza. <verse eid="MRK 4:10"/><verse number="11" style="v" sid="MRK 4:11"/>Yesuusa unttiko yhay garkk yeegeeza: «Yinttis Xooss kaatetithii xuura erettithii ingintteeza. Zin yhankkitayis kaatetithapp bale yezitayis ubba baz aazisor odinttiza. <verse eid="MRK 4:11"/><verse number="12" style="v" sid="MRK 4:12"/>Yeykka,</para>
  <para style="q1" vid="MRK 4:12">« ‹U bbi7iza, zin denggooya.</para>
  <para style="q1" vid="MRK 4:12">Si7iza, zin akaakooya.</para>
  <para style="q1" vid="MRK 4:12">U denggizakonnee akaakizako,</para>
  <para style="q2" vid="MRK 4:12">Xoossiko maaqqoda</para>
  <para style="q2" vid="MRK 4:12">ezkka unttan maarodazinii› »</para>
  <para style="m" vid="MRK 4:12">yeegeeza.<note caller="-" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="ISA 6:9">Isa. 6:9</ref></char></note><verse eid="MRK 4:12"/></para>
  <para style="s1">Zerth aazisayis bili7ith</para>
  <para style="r">(<ref loc="MAT 13:18-23">Mat. 13:18-23</ref>; <ref loc="LUK 8:11-15">Luq. 8:11-15</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13"/>Yesuusa unttiko, «Yha aazisay yinttiskka geloosa? Yeezin, yhankko aazisita ubba yi wayizii akaakodee? <verse eid="MRK 4:13"/><verse number="14" style="v" sid="MRK 4:14"/>Zerizay Xooss qaala zeriza. <verse eid="MRK 4:14"/><verse number="15" style="v" sid="MRK 4:15"/>Qaalay zerinttodar oge kantta wodhdheezitay qaala si7eezita. Zin Xalahe izir yi7ii, u wozinayid zerintteez qaala maxii ekkeeza. <verse eid="MRK 4:15"/><verse number="16" style="v" sid="MRK 4:16"/>Yey garkk, sisinqqo yez biittayil zerintteezay qaala si7ii, ellisii ufayttii ekkizita. <verse eid="MRK 4:16"/><verse number="17" style="v" sid="MRK 4:17"/>Zin unttisi xapho baazay gishos cere yhattesapp attin gam7ooya. Xiqqa wodepp guye qaala gisho meto woy bayi7ithii helliko ellisii dhubinttiza. <verse eid="MRK 4:17"/><verse number="18" style="v" sid="MRK 4:18"/>Angguth gancce zerintteezay qaala si7izita. <verse eid="MRK 4:18"/><verse number="19" style="v" sid="MRK 4:19"/>Zin yha sa7a yessis hirga, duretith qadhennee hara baz amotithii e wozinayid gelii qaala cuulliza gishos aafe aafekkazar attiza. <verse eid="MRK 4:19"/><verse number="20" style="v" sid="MRK 4:20"/>Zin aradda biittal zerintteezitay qaala si7ii ekkizita. Unttikka pettay hasttam, pettay usuppuntam pettay xeet aafiza» yeegeeza.<verse eid="MRK 4:20"/></para>
  <para style="s1">Geema yez xomppe</para>
  <para style="r">(<ref loc="LUK 8:16-18">Luq. 8:16-18</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21"/>Yesuusa gujjii, «Xomppe ayithii, ota gancce woy arssa oommo gaddiz asii yenee? Dhoqqa aqo gaddoosanee?<note caller="-" style="x"><char style="xo" closed="false">4:21 </char><char style="xt" closed="false"><ref loc="MAT 5:15">Mat. 5:15</ref>; <ref loc="LUK 11:33">Luq. 11:33</ref></char></note> <verse eid="MRK 4:21"/><verse number="22" style="v" sid="MRK 4:22"/>Yikkee, qosintteez baz ubbitay kezekkazar; zurintteez baz ubbay pidhdhe benttekkazar attaamii.<note caller="-" style="x"><char style="xo" closed="false">4:22 </char><char style="xt" closed="false"><ref loc="MAT 10:26">Mat. 10:26</ref>; <ref loc="LUK 12:2">Luq. 12:2</ref></char></note> <verse eid="MRK 4:22"/><verse number="23" style="v" sid="MRK 4:23"/>Si7iz haye yez oonkka si7o» yeegeeza.<verse eid="MRK 4:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24"/>Ma unttiko, «yinttii si7iz baz akaakii si7oytta! Xooss qaala yi si7izanigarkk e yinttis akaaka ingoda. Yi makkiz bazar yinttis makkoda. Ezayppekka yinttis gaanthii ingoda. <verse eid="MRK 4:24"/><verse number="25" style="v" sid="MRK 4:25"/>Pettii baz yeza athayis gujjinttii inginttoda, baazaypp hara attozin, yezan izakka eepp ekkinttoda» yeegeeza.<note caller="-" style="x"><char style="xo" closed="false">4:25 </char><char style="xt" closed="false"><ref loc="MAT 13:12">Mat. 13:12</ref>; <ref loc="MAT 25:29">25:29</ref>; <ref loc="LUK 19:26">Luq. 19:26</ref></char></note><verse eid="MRK 4:25"/></para>
  <para style="s1">Zerth dicco aaziso</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26"/>Yesuusa mahii, «Xoossa kaatetithay fa gade zerith zeriz as garkke. <verse eid="MRK 4:26"/><verse number="27" style="v" sid="MRK 4:27"/>Ye athay qamma genttiza; guura gooddii dendiza. E wayizako erekkazin ya zerithay dolii dicciza. <verse eid="MRK 4:27"/><verse number="28" style="v" sid="MRK 4:28"/>Biittata fa aaddas katha ingiza. Tiina caare, yeypp aafodayis gambbuxiza, wurssithala kunth aafe aafiza. <verse eid="MRK 4:28"/><verse number="29" style="v" sid="MRK 4:29"/>Zin kathay maxos helliko athay ellisii maxo aykkiza» yeegeeza.<note caller="-" style="x"><char style="xo" closed="false">4:29 </char><char style="xt" closed="false"><ref loc="JOL 3:13">Iyu. 3:13</ref></char></note><verse eid="MRK 4:29"/></para>
  <para style="s1">Sannaficce zerith aaziso</para>
  <para style="r">(<ref loc="MAT 13:31-34">Mat. 13:31-34</ref>; <ref loc="LUK 13:18-19">Luq. 13:18-19</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30"/>Yesuusa, «Nuunii Xooss kaatetithii ab aaziza gode? Woy abar aazisode? <verse eid="MRK 4:30"/><verse number="31" style="v" sid="MRK 4:31"/>Xooss kaatetithay sannaficce aafe aaziza. Ye mithatii aafa zerodar sa7a yez mithii aafe ubbaypp xiqqizara <verse eid="MRK 4:31"/><verse number="32" style="v" sid="MRK 4:32"/>Zeriko dolii diccii mith ubbaypp aadhiz; gita shaqo kessiza. Salo kafitay i shaqayil afa keexxii bettod gatho daazhiza» yeegeeza.<verse eid="MRK 4:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33"/>Yesuusa yhay garkk unddenna aaziso asitay akaakodayis danda7izay garkk qaala odeeza. <verse eid="MRK 4:33"/><verse number="34" style="v" sid="MRK 4:34"/>Asayis aaziso baazin odooya. Zin Yesuusa fa tamaaritayir aadda yeza wode unttisi bili7ii odeeza.<verse eid="MRK 4:34"/></para>
  <para style="s1">Yesuusa abba zula si77i udeeza</para>
  <para style="r">(<ref loc="MAT 8:23-27">Mat. 8:23-27</ref>; <ref loc="LUK 8:22-25">Luq. 8:22-25</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35"/>Ye gallasi sa7ay omathin, Yesuusa fa tamaaritayiko, «Abbapp seko pino wolla piinggoda» yeegeeza. <verse eid="MRK 4:35"/><verse number="36" style="v" sid="MRK 4:36"/>E tamaaritay woyita olii ashshii, Yesuusa tiina gelii betteez wogolitte gelii Yesuusana paar kanggeeza. Hara wogolitay ezayid yeza. <verse eid="MRK 4:36"/><verse number="37" style="v" sid="MRK 4:37"/>Wolqqama gotekka dendii, wogolay gancce haathii kumod gatho zulay shoceeza. <verse eid="MRK 4:37"/><verse number="38" style="v" sid="MRK 4:38"/>Ye wode Yesuusa wogolayis guye baggar borkothii gentteeza. E tamaaritay eza denthii, «Asitamaarayyo, nuunii dhabodar ne si77e gi bi7inee?» yeegeeza.<verse eid="MRK 4:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 4:39"/>E barkkii gotana, «Si77e goba» yeegii, abbanakka, «Hayizoba» geeza. Gotaykka si77e gin ubba baz cicirkk geeza. <verse eid="MRK 4:39"/><verse number="40" style="v" sid="MRK 4:40"/>Yesuusa fa tamaaritayiko, «Yhay garkk yinttan yashshoday abba? Yinttis ammano abis dhabeenee?» yeegeeza.<verse eid="MRK 4:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 4:41"/>Unttii iita yashsha yashittii woli gancce, «Yhay hara attozin, gotenne abba azazinttizay oonoo?» yeegeeza.<verse eid="MRK 4:41"/></para>
  <chapter eid="MRK 4"/>
  <chapter number="5" style="c" sid="MRK 5"/>
  <para style="s1">Tuna ayyana aykkeez athay paxeeza</para>
  <para style="r">(<ref loc="MAT 8:28-34">Mat. 8:28-34</ref>; <ref loc="LUK 8:26-39">Luq. 8:26-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1"/>Yesuusarannee E tamaaritay abba piinggii, Gerggesonoona giz gade heleeza. <verse eid="MRK 5:1"/><verse number="2" style="v" sid="MRK 5:2"/>Yesuusa wogolaypp wodhdheezan garkk tuna ayyana aykkeez pettii athay duufopp kezii eza heleeza. <verse eid="MRK 5:2"/><verse number="3" style="v" sid="MRK 5:3"/>Ye athay duufo gancce aqittar peezhittar yeza. Eza oonkka santhalaater accodayis danda7ooya. <verse eid="MRK 5:3"/><verse number="4" style="v" sid="MRK 5:4"/>E gaame wode dukkulinttii santhalaater accinttii yeza. Zin santhalata duusirithiza, duththakka menthirithiza. Eza kayodayis danda7iza oonkka baaya. <verse eid="MRK 5:4"/><verse number="5" style="v" sid="MRK 5:5"/>E qammannee gallas ya duufayddannee derell afa uukkiza, fa gallakka shuchchar kariza.<verse eid="MRK 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6"/>Yesuusana haakor bi7ii woxxii yhanigii E tiinayid xuggunii goynneeza. <verse eid="MRK 5:6"/><verse number="7" style="v" sid="MRK 5:7"/>Ye athay fa qaala dhoqqi udii, «Ubbaypp aadho Xoossa Na7a Yesuusa, nenannee tana abba helithizay? Tana dhabisamaygarkk ta nena Xoossa sunthar woossiza» yeegeeza. <verse eid="MRK 5:7"/><verse number="8" style="v" sid="MRK 5:8"/>E yeya geezay Yesuusa eza, «Naat yha tuna ayyanayyo, yha athaypp kezoba» yeegii azazeez gishosii.<verse eid="MRK 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9"/>Yesuusa eziko, «Ne sunthay oonoo?» yeegii oyceeza.</para>
  <para style="p" vid="MRK 5:9">E, «Nuunii gaame maaqqeez gishos ta sunthay Leegona» yeegeeza. <verse eid="MRK 5:9"/><verse number="10" style="v" sid="MRK 5:10"/>Tuna ayyanitay fana ya gadaypp kessii dakkaamaygarkk Yesuusana miinthii woosseeza.<verse eid="MRK 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11"/>Ye derayil afa gaame gudaylle wude heengginttiza. <verse eid="MRK 5:11"/><verse number="12" style="v" sid="MRK 5:12"/>Tuna ayyanitay Yesuusako, «Nuna seko gudaylle wudayiko dakkooye, u gancce yhanigii nu geloda» yeegii woosseeza. <verse eid="MRK 5:12"/><verse number="13" style="v" sid="MRK 5:13"/>Yesuusa unttiko, «qitoytta» yeegeeza. Yeegin tuna ayyanitay athaypp kezii gudayllitayll geleeza. Nam7i mukule maaqqod gudaylle wuday gaga doonar dirggii yhanigii abba gancce gelii mitintteeza.<verse eid="MRK 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14"/>Gudaylle wude heenggizitay yashittii yhanigii haneezibazana katamasinnee gaxares odeeza. Yeyppe asay haneezibazana be7adayis kezeeza. <verse eid="MRK 5:14"/><verse number="15" style="v" sid="MRK 5:15"/>Asay Yesuusako yi7ittar tuna ayyanay eepp kezeez atha be7eeza. E wozinay maaqqini, afila ma77ii, ezayid betteezana bi7ii ubbitay yashitteeza. <verse eid="MRK 5:15"/><verse number="16" style="v" sid="MRK 5:16"/>Yeya be7eez asitay tuna ayyanitay aykkeeza athayil afannee gudayllitayll afa haneezibazana ubba asis odeeza. <verse eid="MRK 5:16"/><verse number="17" style="v" sid="MRK 5:17"/>Yey gishos, asay fa biittaypp Yesuusa kezii qitodaygarkk woosseeza.<verse eid="MRK 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18"/>Yesuusa wogolayil afa kezodar tiin tuna ayyana aykkii dakeez athay, Yesuusar yhammadayis eza woosseeza. <verse eid="MRK 5:18"/><verse number="19" style="v" sid="MRK 5:19"/>Zin Yesuusa ixxii eziko, «Ne kara maaqqii, Goday neesi ab garkk maarotith ootheezakko neesi waafa keheezako ne kara asayis odoba» yeegeeza. <verse eid="MRK 5:19"/><verse number="20" style="v" sid="MRK 5:20"/>Athay yhanigii Taphphii Katama ginttiz aqo yuuyii, Yesuusa ezis ab garkk maarotith ootheezako odeeza. E odeezana si7eez as ubbitay malabaz geeza.<verse eid="MRK 5:20"/></para>
  <para style="s1">Yhayqqeez na7atonnee Yesuusa afila bochcheez asito</para>
  <para style="r">(<ref loc="MAT 9:18-26">Mat. 9:18-26</ref>; <ref loc="LUK 8:40-56">Luq. 8:40-56</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21"/>Yesuusa maaqqii, wogolo gancce gelii, abba piinggeezaypp guye gaame asay abba gaxa E kale shiiqeeza. <verse eid="MRK 5:21"/><verse number="22" style="v" sid="MRK 5:22"/>Iyaroosa giz Ayihuditay Woosa Keethi halaqitaypp pettay, Yesuusana be7eez wode eziko yi7ii e tokayil afa wodhdhii, <verse eid="MRK 5:22"/><verse number="23" style="v" sid="MRK 5:23"/>«Ta na7ata harginttii yhayqqod haniza. Iza paxodgarkk yi7ii ne kusha Izil afa gaddooye» yeegii Yesuusana miinthii woosseeza.<verse eid="MRK 5:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 5:24"/>Yesuusa Iyaroosar yhanigeeza. E yhammadar gaame as eza kaallittar urqqitheeza.<verse eid="MRK 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 5:25"/>Taphpho nam77ii laythi Izilapp suuthii goggeez pettii astta yeza. <verse eid="MRK 5:25"/><verse number="26" style="v" sid="MRK 5:26"/>Gaame akimitay izo akimeezin, iza pathi eqa kaa7inttiza. Iza fa miisha ubba wurssinkka iis yhana iiteezaypp attin abikka izo maaddekkaya. <verse eid="MRK 5:26"/><verse number="27" style="v" sid="MRK 5:27"/>Ye astta Yesuusa waara si7eez, gishos asaypp aadhii Yesuusas guyiguthar yi7ii e afila bochcheeza. <verse eid="MRK 5:27"/><verse number="28" style="v" sid="MRK 5:28"/>Iza, «Ta hara attozin E afila manchchato bochcheezako paxoda» gi qoppeeza.<verse eid="MRK 5:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 5:29"/>Izipp goggiz suuthay izir eqqii atteeza. Iza fa waayaypp paxeezana fa galayill ereeza. <verse eid="MRK 5:29"/><verse number="30" style="v" sid="MRK 5:30"/>Yesuusa ellisii paapp wolqqa kezeezana fa ubbas erii, gaame asay gancce guye maaqqii, «Ta afila bochcheezay oonoo?» yeegeeza.<verse eid="MRK 5:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31"/>E tamaaritay, «Asay nena urqqiza bi7ittar, ‹Oonoo tana bochcheezay yeegii wayizii oyce?› » yeegeeza.<verse eid="MRK 5:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 5:32"/>Yesuusa yeya o ootheezako erodayis yuuyii be7eeza. <verse eid="MRK 5:32"/><verse number="33" style="v" sid="MRK 5:33"/>Zin asita paas haneezibazana erii, yashshar kukkurttar yi7ii Yesuusa tiinayid guphinggii; fa xillat ubba eesi odeeza. <verse eid="MRK 5:33"/><verse number="34" style="v" sid="MRK 5:34"/>Yeeyin, Yesuusa iziko, «Tana7ate, nena ne ammanay patheeza, saro yhanigoba, ne waayayppekka paxoba» yeegeeza.<verse eid="MRK 5:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35"/>Yesuusa haga yhaya ododar, Ayihude Woosa Keethi halaqay karapp kiitintteez asitay yi7ii, «Ne na7ata yhayqqeeza, yhatt asitamaara abis daabursse?» yeegeeza.<verse eid="MRK 5:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 5:36"/>Zin Yesuusa u gizana si7ii, Ayihuditay Woosa Keethi halaqayiko, «Ammano aadda ammanobapp attin yashittippe» yeegeeza. <verse eid="MRK 5:36"/><verse number="37" style="v" sid="MRK 5:37"/>Yesuusa Phixiroosapp, Yayqqobappennee Yayqqooba isha Waannisapp hara oonkka fana kalaamay garkk kayeeza. <verse eid="MRK 5:37"/><verse number="38" style="v" sid="MRK 5:38"/>Unttii Ayihude Woosa Keethi halaqay kara hellodar Yesuusa asay yeekkodar, zelalodarannee uukkodar be7eeza. <verse eid="MRK 5:38"/><verse number="39" style="v" sid="MRK 5:39"/>Gelii asitayiko, «Yha ubba yeefaynnee uufay abiso? Na7ata gentteezapp attin yhayqqekkaya» yeegeeza.<verse eid="MRK 5:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 5:40"/>Asay eza leqqii miicceeza. Zin as ubbita bale kessii, na7atii ada, indatonnee hayidzii taamarita paar ekkii na7ata yezabessa geleeza. <verse eid="MRK 5:40"/><verse number="41" style="v" sid="MRK 5:41"/>Yesuusa na7atii kusha aykkii, «Xaalita, kumii» geeza. Bilthaykka (Xiqqa na7ate, nena giza dendoba) guussii.<verse eid="MRK 5:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 5:42"/>Iza taphpho nam77ii laythi na7azar izir dendii eqqii yedhdhith aykkeeza. Yeykka haneeza bi7ii asay malabaz geeza. <verse eid="MRK 5:42"/><verse number="43" style="v" sid="MRK 5:43"/>Yesuusa yeya u ooskka odaamay garkk unttan miinthii azazii. Na7atis miiz baz immad garkk odeeza.<verse eid="MRK 5:43"/></para>
  <chapter eid="MRK 5"/>
  <chapter number="6" style="c" sid="MRK 6"/>
  <para style="s1">Yesuusa Naazirete ixintteeza</para>
  <para style="r">(<ref loc="MAT 13:53-58">Mat. 13:53-58</ref>; <ref loc="LUK 4:16-30">Luq. 4:16-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1"/>Yesuusa yeypp kezii, fa taamarita kaalithii, fa katama Naazirete qiteeza. <verse eid="MRK 6:1"/><verse number="2" style="v" sid="MRK 6:2"/>Maala gallas Ayihude Woosa Keetha taamarsso aykkeeza. E taamarssizana si7eez gaame asay yhay malabaz gi, «Yhay yha ubba anapp denggeennee? Yhay ees ingintteez ecetithay waafa? Yha malatita oothiza mawutay ees wayizii ingintteene? <figure style="fig" alt="Man reading inside synagogue" file="LB00244B.tif" size="span" ref="6:2">Pettii as Ayihude woosa keeth nabbabodar</figure> <verse eid="MRK 6:2"/><verse number="3" style="v" sid="MRK 6:3"/>Yhay anaaxa baasa? Mayiramii na7a, Yayqqooba, Yoosa, Yihudarannee Simoona isha baasa? E mishunthikka nuur yhannee yezunthun baasanee?» yeegii, E odizana ekkaam ixxeeza.<verse eid="MRK 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 6:4"/>Yesuusa ye asitayiko, «Nabe fa gadella, fa dabbitayddannee fa kara as gancce bonchchnttooyapp attin yhankkitay kale bonchchinttiza» yeegeeza.<note caller="-" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="JHN 4:43">Wan. 4:43</ref></char></note> <verse eid="MRK 6:4"/><verse number="5" style="v" sid="MRK 6:5"/>E ye aqayid fa kusha harginttiza xiqqa asitayil afa gaddii patheezaypp attin hara malata baz oothodayis danda7ekkaya. <verse eid="MRK 6:5"/><verse number="6" style="v" sid="MRK 6:6"/>Asay ammanaam ixxeez gishos pala baz geeza. Yeypp guye, Yesuusa ye heerapp hara heera taamarseeza.<verse eid="MRK 6:6"/></para>
  <para style="s1">Yesuusa taphpho nam7i hawaarita azazeeza</para>
  <para style="r">(<ref loc="MAT 10:5-15">Mat. 10:5-15</ref>; <ref loc="LUK 9:1-6">Luq. 9:1-6</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 6:7"/>Yesuusa taphpho nam77ii taamarita faako xeegii, nam77e nam77e woli helthii azazeeza. Unttis tuna ayyanitayil afa mawute inggeeza. <verse eid="MRK 6:7"/><verse number="8" style="v" sid="MRK 6:8"/>Unttan, «Oges gufe aaddapp attin katha, qurbo, yi kiise miishe ababazkka aykkippattee.<note caller="-" style="x"><char style="xo" closed="false">6:8-11 </char><char style="xt" closed="false"><ref loc="LUK 10:4-11">Luq. 10:4-11</ref></char></note> <verse eid="MRK 6:8"/><verse number="9" style="v" sid="MRK 6:9"/>Yi toke caamma aathoytta, zin laame afilakka aykkippate» yeegeeza. <verse eid="MRK 6:9"/><verse number="10" style="v" sid="MRK 6:10"/>Maakka, «Yinttan asii mokkeez kara abakka maaqqin ye aqato ashshii qitod gatho ye karttee gam7oytta. <verse eid="MRK 6:10"/><verse number="11" style="v" sid="MRK 6:11"/>Yinttan asii mokkowa kara woy yi odiza baz si7oowa kara abakka maaqqiko, ye biittate yez asayis yey markka maaqqod garkk ye aqaypp kezittar, yi tokaypp buli7a tiqisoytta» yeegeeza.<note caller="-" style="x"><char style="xo" closed="false">6:11 </char><char style="xt" closed="false"><ref loc="ACT 13:51">Haw. O. 13:51</ref></char></note><verse eid="MRK 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12"/>Taphpho nam77ii tamaaritay yhanigii, asay fa nagaraypp maaqqod garkk qaala odeeza. <verse eid="MRK 6:12"/><verse number="13" style="v" sid="MRK 6:13"/>Unttii asaypp gaame tuna Ayyanita kesseeza. Gaame hargintteezita zayite tizhii patheeza.<note caller="-" style="x"><char style="xo" closed="false">6:13 </char><char style="xt" closed="false"><ref loc="JAS 5:14">Yay. 5:14</ref></char></note><verse eid="MRK 6:13"/></para>
  <para style="s1">Xammaqiza waannisa Yhayiqo</para>
  <para style="r">(<ref loc="MAT 14:1-12">Mat. 14:1-12</ref>; <ref loc="LUK 9:7-9">Luq. 9:7-9</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14"/>Yesuusa sunthay ubba aqo kezeezay gishos Kaatay Herodoosa e bagga si7eeza. Pettii pettii asay, «Xammaqiza Waannisa yhayiqopp dendeeza, yey baggar yha malatita oothizay eza» yeegeeza.<verse eid="MRK 6:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 6:15"/>Baggitay, «Yhay Eelaasa» yeegeeza.</para>
  <para style="p" vid="MRK 6:15">Yhankkitay ma, «Yhay binii wode nabitaypp pettay garkk maaqqith attaamii» yeegeeza.<note caller="-" style="x"><char style="xo" closed="false">6:14-15 </char><char style="xt" closed="false"><ref loc="MAT 16:14">Mat. 16:14</ref>; <ref loc="MRK 8:28">Mar. 8:28</ref>; <ref loc="LUK 9:19">Luq. 9:19</ref></char></note><verse eid="MRK 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 6:16"/>Zin Herodoosa yeya si7ii «Yhay ta qoodhe gachiseez xammaqiza Waannisa e yhayiqopp dendeeza» yeegeeza.<verse eid="MRK 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 6:17"/>Herodoosa fa ishay Filphoosa machchato Heroodada ekkeez gishos Waannisa ayithii acciseeza. <verse eid="MRK 6:17"/><verse number="18" style="v" sid="MRK 6:18"/>Waannisa Herodoosa, «Ne ne ishay machchato ekkodayis beezooya» yeegeeza.<note caller="-" style="x"><char style="xo" closed="false">6:17-18 </char><char style="xt" closed="false"><ref loc="LUK 3:19-20">Luq. 3:19-20</ref></char></note><verse eid="MRK 6:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 6:19"/>Heroodada Waannisa fa ulor morkkii eza wodhisodayis koyeeza, zin danda7ekkaya. <verse eid="MRK 6:19"/><verse number="20" style="v" sid="MRK 6:20"/>Waannisa xillonnee geesh as maaqqeezana Herodoosa ereez baggar ezis yashittii miinthii naageeza. Herodoosa Waannisa nashsha si7ii ufayttizarakka mor7iza.<verse eid="MRK 6:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21"/>Herodoosa fa yelintteez gallasa bonchchodayis gade aqisizitayis, shaalaqitayisnnee Galila yez damma asayis imato giigiseeza. Yeyi Heroodadas lo77o gallas maaqqeeza. <verse eid="MRK 6:21"/><verse number="22" style="v" sid="MRK 6:22"/>Heroodada na7ata imathi mokinttiza aqayid gelii doonggii, Herodoosannee e imathita ufaysseeza. Kaatay na7atis, «Ne koyiz baz ab maaqqikokka tana oycoba, ta neesi immada» yeegeeza. <verse eid="MRK 6:22"/><verse number="23" style="v" sid="MRK 6:23"/>Ma izis caaqqii, «Ne oyciz baz ab maaqqikokka, ta neesi immada. Hara attozin, ta kaatetithay bagga maaqqikokka ta neesi immada» yeegeeza.<verse eid="MRK 6:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 6:24"/>Na7ata bale kezii fa indatiko, «Ab ingoba gi oyco?» gi oyceeza.</para>
  <para style="p" vid="MRK 6:24">I indat, «xammaqiza Waannisa omma ingo goba» yeegeeza.<verse eid="MRK 6:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 6:25"/>Na7ata ellisii kaatayiko yhanigii, «xammaqiza Waannisa qoodhatip gachchii pili7o gancce gaddii yhatti taas immaday garkk ta koyiza» yeegeeza.<verse eid="MRK 6:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 6:26"/>Yeegin Kaatay unddenna qiiradhdheeza zin fa immathitay gisho izis caaqqeez fa caaqa menthodayis koyekkaya. <verse eid="MRK 6:26"/><verse number="27" style="v" sid="MRK 6:27"/>Yeyi gishos, ellisii naagiza atha Waannisa omma ko7oday garkk azazeeza. Naagiza athay achch keethi yhanigii Waannisa qoodha gachcheeza. <verse eid="MRK 6:27"/><verse number="28" style="v" sid="MRK 6:28"/>Ye gachchintteez omma pili7o gancce gaddii ki7ii na7atis inggeeza. Na7atakka ma fa indatis inggeeza. <verse eid="MRK 6:28"/><verse number="29" style="v" sid="MRK 6:29"/>Waannisa tamaaritay yeya si7eez wode yhanigii e aha ekkii kanggii moogeeza.<verse eid="MRK 6:29"/></para>
  <para style="s1">Yesuusa ichchin mukule asa muzeeza</para>
  <para style="r">(<ref loc="MAT 14:13-21">Mat. 14:13-21</ref>; <ref loc="LUK 9:10-17">Luq. 9:10-17</ref>; <ref loc="JHN 6:1-14">Wan. 6:1-14</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30"/>Hawaaritay maaqqii yi7ii Yesuusako shiiqii u ootheezbazinnee taamarsseeza baz ubba Yesuusas odeeza. <verse eid="MRK 6:30"/><verse number="31" style="v" sid="MRK 6:31"/>Unttiko yi7iza asaynnee qitiza asay gaanggeez gishos Yesuusarannee e tamaaritayi, hara attozin katha maadayiskka unttis wode dhabeeza. Yeeyin, Yesuusa unttiko, «Nuusikka xiqqal shempp ekkodayis asii baa aqo yedhdhoytta» yeegeeza. <verse eid="MRK 6:31"/><verse number="32" style="v" sid="MRK 6:32"/>Yey gishos, unttii fa aaddas wogolo gancce gelii asii baa aqo yhanigeeza.<verse eid="MRK 6:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 6:33"/>U yhammadar gaame asitay unttan bi7ii ereeza. Yeezin, katama ubbapp asii toker woxxii yhanigii u yhanigiza aqayid unttapp tiinattii helleeza. <verse eid="MRK 6:33"/><verse number="34" style="v" sid="MRK 6:34"/>Yesuusa wogolopp wodhdhii gaame woya be7eeza. Asay heenggiz asii baa dur garkk maaqqeezana bi7ii unttis qadhinttii unttan gaame baz taamarisseeza.<note caller="-" style="x"><char style="xo" closed="false">6:34 </char><char style="xt" closed="false"><ref loc="NUM 27:17">Tay. 27:17</ref>; <ref loc="1KI 22:17">1 Kaat. 22:17</ref>; <ref loc="EZK 34:5">Iziqe. 34:5</ref>; <ref loc="MAT 9:36">Mat. 9:36</ref></char></note><verse eid="MRK 6:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 6:35"/>Sa7ay awa aadhodar Yesuusa tamaaritay eziko yi7ii, «Yha aqay liizho; yhatt sa7ay omatheeza. <verse eid="MRK 6:35"/><verse number="36" style="v" sid="MRK 6:36"/>Asay herarannee katamar yhanigii paas miiz baz woonggod garkk asa dakkoba» yeegeeza.<verse eid="MRK 6:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 6:37"/>Zin Yesuusa mahii unttiko, «Asayis miiz baz yi ingoytta» yeegeeza.</para>
  <para style="p" vid="MRK 6:37">U, yeezin «Nuunii yhanigii nam77ii xeet diinnaarer soollo wonggii immadenee?» yeegii oyceeza.<verse eid="MRK 6:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 6:38"/>Yesuusa unttiko, «Yinttis aappun soollo yenee? An yhanigii bo7oytta» yeegeeza.</para>
  <para style="p" vid="MRK 6:38">U bi7ii, «Ichchin soollorannee nam77ii molor yeza» yeegeeza.<verse eid="MRK 6:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 6:39"/>Yesuusa fa taamarita asa ubba cugar cugar shaakkii maatal bettiththoday garkk azazeeza. <verse eid="MRK 6:39"/><verse number="40" style="v" sid="MRK 6:40"/>Asay baggay xeet, baggitay ishatam maaqqii cugar cugar shaakinttii betteeza. <verse eid="MRK 6:40"/><verse number="41" style="v" sid="MRK 6:41"/>Yesuusa ichchin soollorannee nam77ii molita ekkii, salo bi7ii Xoossa galateeza. Soolla duuthii asayis gishoday garkk fa tamaaritayis inggeeza. Ma nam77ii molita u ubbitayis shaakkeeza. <verse eid="MRK 6:41"/><verse number="42" style="v" sid="MRK 6:42"/>As ubbitay mi mizheeza. <verse eid="MRK 6:42"/><verse number="43" style="v" sid="MRK 6:43"/>Atteez soollo gufannee molo gufa, e tamaaritay taphpho nam77ii leemate kunth dentheeza. <verse eid="MRK 6:43"/><verse number="44" style="v" sid="MRK 6:44"/>Soollo meez dhiirath asitay aadda ichchin mukule maaqqada.<verse eid="MRK 6:44"/></para>
  <para style="s1">Yesuusa abbal afa yedhdheeza</para>
  <para style="r">(<ref loc="MAT 14:22-33">Mat. 14:22-33</ref>; <ref loc="JHN 6:15-21">Wan. 6:15-21</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45"/>Ellisii Yesuusa fa tamaaritay wogolo gancce gelii, Abbapp sekofino yez Biitta Beetesayida yhanigodaypp tiinatii qitoday garkk kiiteeza. <verse eid="MRK 6:45"/><verse number="46" style="v" sid="MRK 6:46"/>Asa moyzeezaypp guye Xooss woossodayis derell afa kezeeza.<verse eid="MRK 6:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="MRK 6:47"/>Sa7a qammodar wogolay abba gancce yezin, Yesuusa abba gaxa fa aadda yeza. <verse eid="MRK 6:47"/><verse number="48" style="v" sid="MRK 6:48"/>Carkko e tamaaritayiko carkkiz gishos abba pidhithay waayithizana Yesuusa be7eeza. Wonttimaathe shugula uukkodar e abbal afar yedhdhittar unttiko yi7ii, unttan olii aadhodayis koyeeza. <verse eid="MRK 6:48"/><verse number="49" style="v" sid="MRK 6:49"/>Zin e abbal afa yedhdhodar, u bi7ii, unttisi meeshe aazin uukkeeza. <verse eid="MRK 6:49"/><verse number="50" style="v" sid="MRK 6:50"/>U ubbitay eza bi7ii, yashittii dagameeza.</para>
  <para style="p" vid="MRK 6:50">Zin Yesuusa ellisii unttiko, «Tana, akko baaya; yashittippatte» yeegeeza. <verse eid="MRK 6:50"/><verse number="51" style="v" sid="MRK 6:51"/>Yesuusa wogolayid gelii unttar wolla bettin carkkay si77i atteeza. Unttii gita mala bazi geeza. <verse eid="MRK 6:51"/><verse number="52" style="v" sid="MRK 6:52"/>U wozinay docceez gishos soollayil ootheez malata unttii akaakekkayapp attin yhay unttis malabaz baabonazin.<verse eid="MRK 6:52"/></para>
  <para style="s1">Yesuusa Gensareexee hargintteezita patheeza</para>
  <para style="r">(<ref loc="MAT 14:34-36">Mat. 14:34-36</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53"/>Unttii abba piinggii, Gensareexee biitta hellii, wogola gaxal shiishii acceeza. <verse eid="MRK 6:53"/><verse number="54" style="v" sid="MRK 6:54"/>U wogolaypp wodhodar asay ellisii Yesuusana ereeza. <verse eid="MRK 6:54"/><verse number="55" style="v" sid="MRK 6:55"/>U heera yez biitta ubba woxitii hargintteez asita halar tookkii, «Yesuusa yeza» yeza geez aqayid ki7ith aykkeeza. <verse eid="MRK 6:55"/><verse number="56" style="v" sid="MRK 6:56"/>Asay e yhanigeez kara ubba, gaxare maaqqin, katama, yez hargintteez asita bucal kanggiza. Hargintteez asitay e afila manchcha maaqqikokka bochchod garkk asay eza woosseeza. Bochcheez ubbitay paxeeza.<verse eid="MRK 6:56"/></para>
  <chapter eid="MRK 6"/>
  <chapter number="7" style="c" sid="MRK 7"/>
  <para style="s1">Binii aditay woga</para>
  <para style="r">(<ref loc="MAT 15:1-9">Mat. 15:1-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1"/>Yerusalaamepp ye7eez farasaawitayira pettii pettii higge asitamaaritay Yesuusa kale shiiqeeza. <verse eid="MRK 7:1"/><verse number="2" style="v" sid="MRK 7:2"/>Yesuusa tamaaritaypp pettay pettay geezhekka kusher, yeykka kushe meecinttekkazar katha miizita be7eeza.<verse eid="MRK 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 7:3"/>Farasaawitaynnee Ayihuditay asii ubbay fa aditay wogay garkk fa kushe lo7ithii meecinttekkazar mooya. <verse eid="MRK 7:3"/><verse number="4" style="v" sid="MRK 7:4"/>Yey garkk, unttii gabepp maaqqii meeccekkazar mooya. Ma unttii fa aditaypp ekkeez hara gaame woga yeza: yeykka wancca, ota, biraata miishera arssa meecciz woga naagiza.<verse eid="MRK 7:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5"/>Farasaawitayirannee higge asitamaaritay Yesuusa, «Ne tamaaritay abiso aditay woga menthii fa kushe meecinttekkazar katha miizay?» yeegii oyceeza.<verse eid="MRK 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6"/>Yesuusa unttiko, «Nabe Isayaasa yinttis cubbitayis,</para>
  <para style="q1" vid="MRK 7:6">« ‹Yha asay tana fa iranthi aaddari bonchchiza,</para>
  <para style="q2" vid="MRK 7:6">zin u wozinay taapp haakko yeza.<note caller="-" style="x"><char style="xo" closed="false">7:6-7 </char><char style="xt" closed="false"><ref loc="ISA 29:13">Isa. 29:13</ref></char></note><verse eid="MRK 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MRK 7:7"/>Asii kochcheez woga Xooss higge aazisii taamarssiza gisho</para>
  <para style="q2" vid="MRK 7:7">u tana cer goynniza› »</para>
  <para style="m" vid="MRK 7:7">yeegii xaafeezay turo.<verse eid="MRK 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 7:8"/>«Yinttii Xooss kiita ashshii as woga naagiza» yeegeeza.<verse eid="MRK 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9"/>Maakka Yesuusa, «Yinttii yi woga naagodayis gi Xooss kiita olii ashsheeza <verse eid="MRK 7:9"/><verse number="10" style="v" sid="MRK 7:10"/>Muse, ‹Ne adenne ne indo bonchchoba›, ma ‹Fa adannee woy fa indo cazhizay yhayqqodayis beeziza› yeegeeza.<note caller="-" style="x"><char style="xo" closed="false">7:10 </char><char style="xt" closed="false"><ref loc="EXO 20:12">Kes. 20:12</ref>; <ref loc="NUM 5:16">Tay. 5:16</ref>; <ref loc="EXO 21:17">Kes. 21:17</ref>; <ref loc="LEV 20:9">Lewii. 20:9</ref></char></note> <verse eid="MRK 7:10"/><verse number="11" style="v" sid="MRK 7:11"/>Zin yi yeegiza pettii athay fa ada woy fa indato maaddoda ashshii, ‹Yhay Xoossa yarshsho› giiko, <verse eid="MRK 7:11"/><verse number="12" style="v" sid="MRK 7:12"/>E fa ada woy fa indato maaddaam garkk yi udiza. <verse eid="MRK 7:12"/><verse number="13" style="v" sid="MRK 7:13"/>Yey garkk, yi yhankkita taamarisseez yi wogayid Xoossa qaala leqqeeza. Yey garkk hara gaame baz oothiza» yeegeeza.<verse eid="MRK 7:13"/></para>
  <para style="s1">As tunisiza baz</para>
  <para style="r">(<ref loc="MAT 15:10-20">Mat. 15:10-20</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14"/>Yesuusa gaame asa maakka faako xeegii, «Ubbay ta odiza si7oyttannee akaakoytta. <verse eid="MRK 7:14"/><verse number="15" style="v" sid="MRK 7:15"/>As wozinapp keziz baz as tunisizapp attin balepp as ulo gelii as tunisiza baz abkka baaya. <verse eid="MRK 7:15"/><verse number="16" style="v" sid="MRK 7:16"/>Si7iz hayer yez oonkka si7o» yeegeeza.<verse eid="MRK 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17"/>Yesuusa gaame asa olii ashshii keetha gelin e tamaaritay ye aazisay bagga eza oyceeza. <verse eid="MRK 7:17"/><verse number="18" style="v" sid="MRK 7:18"/>E unttiko, «Yinttiskka ma gelekkasa? Balepp as gancce geliza baz abkka as tunisodayis danda7oozana akaakoosanee? <verse eid="MRK 7:18"/><verse number="19" style="v" sid="MRK 7:19"/>Abis giiko, katha as doonar ulo gancce gelii ezayir bale kezizaypp attin as wozina gancce gelooya» yeegeeza. Ezayid Yesuusa katha ubbay geeshshii maaqqeezana eriseeza.<verse eid="MRK 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20"/>Gujjikka, Yesuusa, «as tunisiza baz as wozina ganccepp keziz bazii. <verse eid="MRK 7:20"/><verse number="21" style="v" sid="MRK 7:21"/>As wozina ganccepp keziz baz wobbo qofa, lagita, kastto, as wodho, <verse eid="MRK 7:21"/><verse number="22" style="v" sid="MRK 7:22"/>laame, iita amotithii, iitatithii, gene, qayxe, doosha, qinaate, cashshe, utirannee boozatithii. <verse eid="MRK 7:22"/><verse number="23" style="v" sid="MRK 7:23"/>Yha iita baz ubbaykka as wozina ganccepp kezii as tunisiza» yeegeeza.<verse eid="MRK 7:23"/></para>
  <para style="s1">Pettii asttii ammano</para>
  <para style="r">(<ref loc="MAT 15:21-28">Mat. 15:21-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24"/>Yesuusa yeypp kezii, Xiroosa katama kale yez gade yhanigeeza. E pettii kara gelii ezayid yezana oonkka erod garkk koyekkaya. Zin qosinttii gam7odayis danda7ekkaya. <verse eid="MRK 7:24"/><verse number="25" style="v" sid="MRK 7:25"/>Zin i xiqqa na7ato tuna ayyana aykkeez pettii astta Yesuusa oosa si7ii ellisii eziko yi7ii e tokayil afa wodhdheeza. <verse eid="MRK 7:25"/><verse number="26" style="v" sid="MRK 7:26"/>Iza Girike asii; yelintteezay Siroofinqqe giz biitta. Iza, fa na7atipp tuna ayyana kessod garkk Yesuusa woosseeza.<verse eid="MRK 7:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 7:27"/>Zin Yesuusa mahii, «Na7itay tiinatii katha mizho; na7itay katha ekkii kanitayis olo koshshooya» yeegeeza.<verse eid="MRK 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 7:28"/>Asita maaqqii, «Ta Godayyo yeyi tuma, zin leemate kale yez kanitay na7itaypp wodhdhiz gufa miinebay» yeegii maheeza.<verse eid="MRK 7:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 7:29"/>Yesuusa ma iziko, «Yha ne qaalay gishos ne kara qitoba; tuna ayyana ne na7atipp kezeeza» yeegeeza.<verse eid="MRK 7:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 7:30"/>Izakka fa kara yhanigodar tuna ayyana i na7atipp kezin arssal woyi7eezanno denggeeza.<verse eid="MRK 7:30"/></para>
  <para style="s1">Yesuusa tullennee muume atha patheeza</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31"/>Yesuusa ma Xiroosa katamapp kezii, Sidoonaranne Taphphii Katamita giz biittar aadhii Galila Abbako yhanigeeza. <verse eid="MRK 7:31"/><verse number="32" style="v" sid="MRK 7:32"/>Asay tullennee deddatiza as Yesuusako ki7ii, fa kushe ezal afa gaddod garkk eza woosseeza. <verse eid="MRK 7:32"/><verse number="33" style="v" sid="MRK 7:33"/>Yesuusa aadda ye atha gaame asaypp gaxa kessii, fa biradhdhe e hayayid dakkeeza. Ma yeypp cuchchii cuttii e irantha bochcheeza. <verse eid="MRK 7:33"/><verse number="34" style="v" sid="MRK 7:34"/>Salo fude dhoqqi gi bi7ii, woossii, «Eftah» geeza. Bili7ithaykka «Dooyinttoba» guusii. <verse eid="MRK 7:34"/><verse number="35" style="v" sid="MRK 7:35"/>Athay hayay ellisii dooyintteeza, accintteez iranthaykka bili7intteeza, athay bili7inttii odintteeza.<verse eid="MRK 7:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 7:36"/>Yesuusa asayiko, «Yhaya ooskka odippate» yeegeeza. Zin E lo7ithii miinthii odippate gin, asay oda gede dalgiseeza. <verse eid="MRK 7:36"/><verse number="37" style="v" sid="MRK 7:37"/>Yeya si7eez as ubbay lo7ithii malabaz gi, «Ubba baz e lo7ithii oothiza. Hara attozin, tulle sissiza, muume odisiza» yeegeeza.<verse eid="MRK 7:37"/></para>
  <chapter eid="MRK 7"/>
  <chapter number="8" style="c" sid="MRK 8"/>
  <para style="s1">Yesuusa oyddii mukule asii muzeeza</para>
  <para style="r">(<ref loc="MAT 15:32-39">Mat. 15:32-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1"/>Xiqqa wodepp guye, gaame asay Yesuusako shiiqeeza. Asayis miizibaz dhabin Yesuusa fa taamarita faako xeegii, <verse eid="MRK 8:1"/><verse number="2" style="v" sid="MRK 8:2"/>«Yha asay taar hayidzii gallas hellodayis gam7ii, abkka miiz baz denggekkazay gishos tana asay qadhithiiza. <verse eid="MRK 8:2"/><verse number="3" style="v" sid="MRK 8:3"/>Ta asa nayer kara dakkaamii, asay yhanigttar ogella daaburii pokkoda, bagga asay haakopp ye7eeza» yeegeeza.<verse eid="MRK 8:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4"/>Yesuusa tamaaritay mahii, «Yha liizhayid yha asa ubba muzodayis gidiza katha denggodays danda7izay oonoo?» yeegeeza.<verse eid="MRK 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 8:5"/>Yesuusa unttiko, «Yinttar aappun soollo yenee?» yeegii oyceeza.</para>
  <para style="p" vid="MRK 8:5">U mahii, «Laappun soollo yeza» yeegeeza.<verse eid="MRK 8:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 8:6"/>Yesuusa asay sa7a bettoday garkk kiiteeza. Yeezeezaypp, laappun soollo ekkii Xooss galatii maaqqii ye soolla duuthirthii, asayis gishod garkk fa tamaaritayis inggeeza. E tamaaritay asayis gisheeza. <verse eid="MRK 8:6"/><verse number="7" style="v" sid="MRK 8:7"/>Unttisi ma xiqqa yishshe molitay yeza. Yesuusa ye molitay gishos Xooss galatii, asayis gishod garkk fa taamarita azazeeza. <verse eid="MRK 8:7"/><verse number="8" style="v" sid="MRK 8:8"/>Asay ubbitay mi mizheeza. E tamaaritay atteez gufa laappun leemate kunth dentheeza. <verse eid="MRK 8:8"/><verse number="9" style="v" sid="MRK 8:9"/>Katha meez asay tayibay oyddii mukule maaqqoda. Yeypp guye, Yesuusa asa dakkeeza. <verse eid="MRK 8:9"/><verse number="10" style="v" sid="MRK 8:10"/>E ma fa tamaaritayir ellithii wogolo gancce gelii Dalmmanuuta ginttiz biitta qiteeza.<verse eid="MRK 8:10"/></para>
  <para style="s1">Malla oothinttodaygarkk oyceeza</para>
  <para style="r">(<ref loc="MAT 16:1-4">Mat. 16:1-4</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11"/>Farasaawe asitay yi7ii Yesuusa paaccodayis koyii, salopp u fana mala beezodaygarkk Yesuusar palama aykkeeza.<note caller="-" style="x"><char style="xo" closed="false">8:11 </char><char style="xt" closed="false"><ref loc="MAT 12:38">Mat. 12:38</ref>; <ref loc="LUK 11:16">Luq. 11:16</ref></char></note><verse eid="MRK 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 8:12"/>Yesuusa sheemitii, «Yha wode asay abis malla koyee? Ta yinttis tuma odiza; yha wode asis aba mallakka ingintteena» yeegeeza.<note caller="-" style="x"><char style="xo" closed="false">8:12 </char><char style="xt" closed="false"><ref loc="MAT 12:39">Mat. 12:39</ref>; <ref loc="LUK 11:29">Luq. 11:29</ref></char></note> <verse eid="MRK 8:12"/><verse number="13" style="v" sid="MRK 8:13"/>E unttan ize olii ashshii maaqqii wogolo gancce gelii abbaypp seko pino piinggeeza.<verse eid="MRK 8:13"/></para>
  <para style="s1">Farasaawitannee Herodoosa irshsho</para>
  <para style="r">(<ref loc="MAT 16:5-12">Mat. 16:5-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14"/>E tamaaritay katha ekkii yhamo dogeeza; unttisi wogolay gancce pettii soollopp hara katha baaya. <verse eid="MRK 8:14"/><verse number="15" style="v" sid="MRK 8:15"/>Yesuusa unttiko, «Yinttan eroytta. Farasaawitay irshshoppennee Herodoosa irshshopp naaginttoytta» yeegii azazeeza.<note caller="-" style="x"><char style="xo" closed="false">8:15 </char><char style="xt" closed="false"><ref loc="LUK 12:1">Luq. 12:1</ref></char></note><verse eid="MRK 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16"/>Unttii woli gancce, «E yhaya gizay nuus soollo baazay gishos» yeegeeza.<verse eid="MRK 8:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 8:17"/>Yesuusa u gizana erii unttiko, «Yinttis soollo baazay gishos abis odinttee? Yhattekka yi eroosa? Woy yi akaakoosa? Yi wozinay docceennee? <verse eid="MRK 8:17"/><verse number="18" style="v" sid="MRK 8:18"/>Yinttis aafe yezin bo7oosa? Haye yezin si7oosa? Yinttis wayizii akaakinttoosa?<note caller="-" style="x"><char style="xo" closed="false">8:18 </char><char style="xt" closed="false"><ref loc="JER 5:21">Erim. 5:21</ref>; <ref loc="EZK 12:2">Iziqe. 12:2</ref>; <ref loc="MRK 4:12">Mar. 4:12</ref></char></note> <verse eid="MRK 8:18"/><verse number="19" style="v" sid="MRK 8:19"/>Ta ichchin soollo ichchin mukule asis peedheez wode aappun leemate kunth gufa dentheennee?» yeegeeza.</para>
  <para style="p" vid="MRK 8:19">Unttikka, «Taphpho nam7i leemate kunth» yeegeeza.<verse eid="MRK 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20"/>«Yey garkk, ta laappun soollo oyddii mukule asis peedhin aappun leemate kunith gufa dentheennee?» yeegeeza.</para>
  <para style="p" vid="MRK 8:20">Unttii, «Laappun leemate kunth dentheeza» yeegeeza.<verse eid="MRK 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 8:21"/>Yeezin, «Yhattekka yinttis qofinttoosa?» yeegeeza.<verse eid="MRK 8:21"/></para>
  <para style="s1">Yesuusa Beetesayda pettii aafe to7a patheeza</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22"/>Unttii Beetesayda katama yhanigeeza. Xiqqa asitay to7a atha Yesuusako ki7ii ye atha bochchod garkk eza woosseeza. <verse eid="MRK 8:22"/><verse number="23" style="v" sid="MRK 8:23"/>Yesuusa to7a athay kushayid aykkii katamapp gaxa keseeza. E aafate cuttii fa kushayid ezal afa gaddii, «Nees akko benttinnee?» yeegii oyceeza.<verse eid="MRK 8:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 8:24"/>Athay dhoqqi gi bi7ii, «Taas asay benttiza, zin asay yedhdhittar mithii aaziza» yeegeeza.<verse eid="MRK 8:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 8:25"/>Yeypp guye, Yesuusa mahii, athay aafayil fa kushe gaddeeza. Athay lo7ithii be7eeza, e aafay paxeeza, ubba baz milxxi udii be7eeza. <verse eid="MRK 8:25"/><verse number="26" style="v" sid="MRK 8:26"/>Yesuusa athayiko, «Ne kara qitoba, katama yhanigippe» yeegii azazeeza.<verse eid="MRK 8:26"/></para>
  <para style="s1">Phixiroosa ammanonnee markkatithii</para>
  <para style="r">(<ref loc="MAT 16:13-20">Mat. 16:13-20</ref>; <ref loc="LUK 9:18-21">Luq. 9:18-21</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27"/>Yesuusa fa tamaaritayir Qisaare Filphoosa kale yez heera yhanigeeza. U yhammadar Ogel afa Yesuusa, «Tana asay oona gineshsha?» yeegii fa taamarita oyceeza.<verse eid="MRK 8:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28"/>E tamaaritay, «Pettii pettii asay nena, ‹Xammaqiza Waannisa› giza; yhankkitay, ‹Eelaasa giza› ma yhankkitay, ‹Nabitaypp petta› giza» yeegeeza.<note caller="-" style="x"><char style="xo" closed="false">8:28 </char><char style="xt" closed="false"><ref loc="MRK 6:14">Mar. 6:14</ref></char></note><verse eid="MRK 8:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 8:29"/>Yesuusa unttiko, «Yeezin yi tana oona gee?» yeegii oyceeza.</para>
  <para style="p" vid="MRK 8:29">Phixiroosa, «Ne Kiristtoosa» yeegii maheeza.<verse eid="MRK 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 8:30"/>Yesuusa, «Tabaz ooskka odaamay garkk naaginttoytta» yeegii unttan azazeeza.<verse eid="MRK 8:30"/></para>
  <para style="s1">Yesuusa fana hellod metonnee waaya odeeza</para>
  <para style="r">(<ref loc="MAT 16:21-28">Mat. 16:21-28</ref>; <ref loc="LUK 9:22-27">Luq. 9:22-27</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31"/>Yesuusa fa tamaaritayiko, «As Na7ay, gaame meto ekkodayis beeziza; cimitay, qeese halaqitaynnee higge asitamaaritay eza ixxodayis beeziza. Unttii eza wodhodayisinnee hayidzii gallasapp guye, e yhayiqopp dendodayis beeziza» yeegii unttan taamarsseeza. <verse eid="MRK 8:31"/><verse number="32" style="v" sid="MRK 8:32"/>E yeya unttis geeshshii odeeza. Phixiroosa aadda pettii bagga aathii kacceeza.<verse eid="MRK 8:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 8:33"/>Zin Yesuusa guye maaqqii, fa taamarita bi7ii, Phixiroosar kacinttii, «Yha Xalahayyo, taapp haakkoba. Ne asii dosizibaz qoppizapp attin Xooss dosizibaz qoppooya» yeegeeza.<verse eid="MRK 8:33"/></para>
  <para style="s1">Yesuusa kaallodayis fana kado koshshiza</para>
  <para style="r">(<ref loc="MAT 10:38-39">Mat. 10:38-39</ref>; <ref loc="MAT 16:24-28">16:24-28</ref>; <ref loc="LUK 9:23-27">Luq. 9:23-27</ref>; <ref loc="LUK 14:26-27">14:26-27</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34"/>Maakka Yesuusa gaame asitayira fa taamarita faako xeegii, «Tana kaallodayis koyiz oonkka fana kado; fa mazqalana tookkii tana kaallo.<note caller="-" style="x"><char style="xo" closed="false">8:34 </char><char style="xt" closed="false"><ref loc="MAT 10:38">Mat. 10:38</ref>; <ref loc="LUK 14:27">Luq. 14:27</ref></char></note> <verse eid="MRK 8:34"/><verse number="35" style="v" sid="MRK 8:35"/>Fa shemppo ashshodayis koyiz athay dhabisiza. Zin ta gishonnee Wonggile gishos fa shemppo dhabisiza athay ashshiza.<note caller="-" style="x"><char style="xo" closed="false">8:35 </char><char style="xt" closed="false"><ref loc="MAT 10:39">Mat. 10:39</ref>; <ref loc="LUK 17:33">Luq. 17:33</ref>; <ref loc="JHN 12:25">Wan. 12:25</ref></char></note> <verse eid="MRK 8:35"/><verse number="36" style="v" sid="MRK 8:36"/>Asii sa7all yez shalo ubba denggii fa shemppo dhabisiko eza ab adode? <verse eid="MRK 8:36"/><verse number="37" style="v" sid="MRK 8:37"/>Asii fa shemppo wozodayis ab ingodayis danda7ee? <verse eid="MRK 8:37"/><verse number="38" style="v" sid="MRK 8:38"/>Xooss ammanoowa yha iita yeletithayid, asii taallannee ta qaalayid yeellatiko, As Na7ay, fa Adayi bonchchayir geesh kiitanchchitayir yi7itar e baggar yeellattoda» yeegeeza.<verse eid="MRK 8:38"/></para>
  <chapter eid="MRK 8"/>
  <chapter number="9" style="c" sid="MRK 9"/>
  <para style="s1">Yesuusa ciray laamintteeza</para>
  <para style="r">(<ref loc="MAT 17:1-13">Mat. 17:1-13</ref>; <ref loc="LUK 9:28-36">Luq. 9:28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1"/>Yesuusa unttiko, «Ta yinttis turo odiza; Xooss kaatetithay wolqqar yi7izana be7ekkazar yhayqqaam pettii pettii asay yhaydda yeza» yeegeeza.<verse eid="MRK 9:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2"/>Yesuusa usuppun gallasapp guye, paar Phixiroosara, Yayqqoobara Waannisara aadda ekkii damma ambal afa kessii u tiinayid laamintteeza.<note caller="-" style="x"><char style="xo" closed="false">9:2-7 </char><char style="xt" closed="false"><ref loc="2PE 1:17-18">2 Phix. 1:17-18</ref></char></note> <verse eid="MRK 9:2"/><verse number="3" style="v" sid="MRK 9:3"/>E afilaykka fociza; sa7a afila meecciza oonkka geeshshodayis danda7oozay garkk mulxxi gi booxeeza. <verse eid="MRK 9:3"/><verse number="4" style="v" sid="MRK 9:4"/>Ye wode Eelaasara Musera Yesuusar wolla nashshodar be7eeza.<verse eid="MRK 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 9:5"/>Phixiroosa Yesuusako, «Asitamaarayyo, nuunii yhaydda yezeezako nuus lo77o; nu hayidzii shaqara petta neesi, petta Muses, ma petta Eelaasas accoda» yeegeeza. <verse eid="MRK 9:5"/><verse number="6" style="v" sid="MRK 9:6"/>Yhankkitay iita yashitteez gisho Phixiroosa ab gizakokka erekkaya.<verse eid="MRK 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7"/>Yeypp guye, shaara yi7ii unttan goollin shaaray ganccepp, «Yhay ta qadhdhiza, ta Na7aya, e giz baz si7oytta» giz qaala ye7eeza. <verse eid="MRK 9:7"/><verse number="8" style="v" sid="MRK 9:8"/>Ellisii u yuuyii be7adar Yesuusapp attin hara oonakka fa kale u be7ekkaya.<note caller="-" style="x"><char style="xo" closed="false">9:8 </char><char style="xt" closed="false"><ref loc="MAT 3:17">Mat. 3:17</ref>; <ref loc="MRK 1:11">Mar. 1:11</ref>; <ref loc="LUK 3:22">Luq. 3:22</ref></char></note><verse eid="MRK 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9"/>Unttii ambalapp wodhdhodar, Yesuusa unttiko, «As Na7ay, yhayiqopp dendod gatho, yi be7eez baz ooskka odippate» yeegii azazeeza.<verse eid="MRK 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 9:10"/>E azazeezana u, «Ero» yeegii, «Yha yhayiqopp dendo guussay abi guuso» yeegii, fa ganccer wolla odintteeza.<verse eid="MRK 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 9:11"/>U maaqqii, «Higge asitamaaritay, ‹Eelaasa tiinatii ye7odayis beeziza› abis gee?» yeegii oyceeza.<note caller="-" style="x"><char style="xo" closed="false">9:11 </char><char style="xt" closed="false"><ref loc="MAL 4:5">Mil. 4:5</ref>; <ref loc="MAT 11:14">Mat. 11:14</ref></char></note><verse eid="MRK 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12"/>Yesuusa mahii «Eelaasa tiinatii yi7ii, ubba baz lo7ithiza; yeezin, abis geeshsha Maxaafay, ‹As Na7ay deexo meto ekkodanee leqinttoda› yeegii xaafeezay waafa? <verse eid="MRK 9:12"/><verse number="13" style="v" sid="MRK 9:13"/>Zin ta yinttis odiza; Eelaasa kase ye7eeza; ma e baz geeshsha Maxaafayid xaafintteezay garkk, asay ezal afa fa koyeezi baz ubba ootheeza» yeegeeza.<verse eid="MRK 9:13"/></para>
  <para style="s1">Yesuusa tuna ayyana aykkeez na7a patheeza</para>
  <para style="r">(<ref loc="MAT 17:14-21">Mat. 17:14-21</ref>; <ref loc="LUK 9:37-43">Luq. 9:37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14"/>Yesuusarannee hayidzii e tamaaritay atteezitayko maaqqii ye7odar gaame as u lanqqayid betteezitannee higge asitamaaritay unttar palamizana be7eeza. <verse eid="MRK 9:14"/><verse number="15" style="v" sid="MRK 9:15"/>Ye gaame asay Yesuusa be7eez wode dagamar malabaz gi, ellisii eziko laasii yi7ii, eza sarotheeza. <verse eid="MRK 9:15"/><verse number="16" style="v" sid="MRK 9:16"/>Yesuusa higge asitamaaritayiko, «unttar palamizay abiso?» yeegii oyceeza.<verse eid="MRK 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 9:17"/>Ye woyitay ganccepp pettii athay maaqqii, «Asitamaarayyo, ta na7ayil afa pogoda kayiz tuna ayyana yeza gishos eza ta neeko ke7eeza. <verse eid="MRK 9:17"/><verse number="18" style="v" sid="MRK 9:18"/>Ya ayyanay dendeez wode, eza shocii olii; doonayir gappuntto ki7ii; achch coonchii; galla zabisii gamin Kessodaygarkk ne tamaaritayis odin, u kessodayis danda7ekkaya» yeegeeza.<verse eid="MRK 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19"/>Yesuusa mahii unttiko, «Ammanoowa yha layitha asito! Taanii yinttar ayide hellodayis yezodee? Ma yinttan ayide hellodayis danda7odee? Na7a taako yhana ekkii ye7oytta» yeegeeza. <verse eid="MRK 9:19"/><verse number="20" style="v" sid="MRK 9:20"/>Unttii na7a eziko ke7eeza; ye tuna ayyanay Yesuusa be7eezangarkk na7a kukkurssii; pokisii, doonar gappuntto ki7ith aykkeeza. <verse eid="MRK 9:20"/><verse number="21" style="v" sid="MRK 9:21"/>Yesuusa ye na7ay adayiko, «Yha ne na7a aykkeezaypp aapun layth maaqqode?» yeegii oyceeza.</para>
  <para style="p" vid="MRK 9:21">Na7ay aday, «E duudezin aykkeeza. <verse eid="MRK 9:21"/><verse number="22" style="v" sid="MRK 9:22"/>Eza wodhodayis gaame wode tama ganccennee haathii gancce oliza, zin ne danda7iko, nuus qadhdhooye, nuna maaddooye» yeegeeza.<verse eid="MRK 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23"/>Yesuusa, « ‹Ne danda7iko ginee?› Ammaniza ooskka ubba baz danda7inttiza» yeegeeza.<verse eid="MRK 9:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 9:24"/>Ellisii na7ay aday fa qaala dhoqqi udii, «Ta ammaniza, zin gujjii ammanodaygarkk tana maaddooye» yeegeeza.<verse eid="MRK 9:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25"/>Yesuusa asay gaanggii gaanggii yhanigizana bi7ii, tuna ayyana, «yha tullennee muume ayyanayyo, yha na7aypp kezoba nena ta azaziza; ma nam7intho maaqqii ezal gelppe» yeegeeza.<verse eid="MRK 9:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 9:26"/>Ye tuna ayyanay uukkii, na7a iita kukkurssii, ezapp kezeeza. Na7ay yhayqqeeza aazin, gaame asay, «Na7ay yhayqqeeza» yeegeeza. <verse eid="MRK 9:26"/><verse number="27" style="v" sid="MRK 9:27"/>Zin Yesuusa na7ay kushayid aykkii denthin, na7ay dendii eqqeeza.<verse eid="MRK 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28"/>Yesuusa kara geleezaypp guye e tamaaritay, «Nuunii ye tuna ayyana kessodayis abis danda7ekkasa?» yeegii Yesuusa aadda oyceeza.<verse eid="MRK 9:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 9:29"/>Yesuusa mahii, «Yey garkkezay woosarannee [xoomarapp] attin harabazar kezodayis danda7ooya» yeegeeza.<verse eid="MRK 9:29"/></para>
  <para style="s1">Yesuusa fa yhayiqannee denda mahii odeeza</para>
  <para style="r">(<ref loc="MAT 17:22-23">Mat. 17:22-23</ref>; <ref loc="LUK 9:43-45">Luq. 9:43-45</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30"/>Unttii ye bessaypp dendii, Galilar aadhii yhanigeeza; Yesuusa fa yezabessa oonkka erod garkk koyekkaya. <verse eid="MRK 9:30"/><verse number="31" style="v" sid="MRK 9:31"/>E fa tamaaritayiko, «As Na7a, asii asitay kushe aathii immadannee wodhoda; E hayidzii gallasapp guye, yhayiqopp dendoda» yeegii taamarisseeza.<verse eid="MRK 9:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 9:32"/>Zin unttisi e geezay gelekkaya; ma eza oycodayiskka yashitteeza.<verse eid="MRK 9:32"/></para>
  <para style="s1">Ubbapp aadhizay oonoo?</para>
  <para style="r">(<ref loc="MAT 18:1-5">Mat. 18:1-5</ref>; <ref loc="LUK 9:46-48">Luq. 9:46-48</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33"/>Unttii qifirnahoome katama yhanigii kara geleezaypp guye Yesuusa unttiko, «Ogel yi abis palaminttee?» yeegii oyceeza. <verse eid="MRK 9:33"/><verse number="34" style="v" sid="MRK 9:34"/>Zin u, «Nu gancce ubbapp aadhoday oonoo?» yeegii palameez gishos si77e geeza.<note caller="-" style="x"><char style="xo" closed="false">9:34 </char><char style="xt" closed="false"><ref loc="LUK 22:24">Luq. 22:24</ref></char></note> <verse eid="MRK 9:34"/><verse number="35" style="v" sid="MRK 9:35"/>Yesuusa bettii, taphpho nam77ii taamarita xeegii, «Oonkka tiina aadhodayis koyko, ubbapp guye aadhii, ubbayis aylle maaqqodayis beeziza» yeegeeza.<note caller="-" style="x"><char style="xo" closed="false">9:35 </char><char style="xt" closed="false"><ref loc="MAT 20:26">Mat. 20:26</ref></char></note><verse eid="MRK 9:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 9:36"/>Pettii xiqqa na7a ekkii, u gancce esseeza; ye xiqqa na7a idinggii unttiko, <verse eid="MRK 9:36"/><verse number="37" style="v" sid="MRK 9:37"/>«Yhay garkk xiqqa na7itaypp petta ta sunthayir mokkiza oonkka tana mokkiza; ma tana mokkiza oonkka tana azazeezanakka mokkizapp attin ta aadda mokkooya» yeegeeza.<note caller="-" style="x"><char style="xo" closed="false">9:37 </char><char style="xt" closed="false"><ref loc="MAT 10:40">Mat. 10:40</ref>; <ref loc="LUK 10:16">Luq. 10:16</ref>; <ref loc="JHN 13:20">Wan. 13:20</ref></char></note><verse eid="MRK 9:37"/></para>
  <para style="s1">Nuna ixxowa ubbay nu bagga</para>
  <para style="r">(<ref loc="LUK 9:49-50">Luq. 9:49-50</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38"/>Waannisa, «Asitamaarayyo, pettii asii ne sunthar tuna Ayyanita kessodar nu bi7ii, nu bagga maaqqekka gishos eza kayeeza» yeegeeza.<verse eid="MRK 9:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 9:39"/>Zin Yesuusa, «Oonkka ta sunthar Xoossii oothiz malata baz oothii, ellisii taal afa iita baz odinttodayis danda7izay baa gishos kayppate. <verse eid="MRK 9:39"/><verse number="40" style="v" sid="MRK 9:40"/>Nubaz ixxowa ubbitay nu bagga.<note caller="-" style="x"><char style="xo" closed="false">9:40 </char><char style="xt" closed="false"><ref loc="MAT 12:30">Mat. 12:30</ref>; <ref loc="LUK 11:23">Luq. 11:23</ref></char></note> <verse eid="MRK 9:40"/><verse number="41" style="v" sid="MRK 9:41"/>Ta yinttis turo odiza; yi taasita maaqqeez gishos oonkka yinttis ta sunthar hale haathii uzhodayis ingikokka, fa gate dhabaamii.<note caller="-" style="x"><char style="xo" closed="false">9:41 </char><char style="xt" closed="false"><ref loc="MAT 10:42">Mat. 10:42</ref></char></note><verse eid="MRK 9:41"/></para>
  <para style="s1">Haras dhube maaqqithapp naagintto</para>
  <para style="r">(<ref loc="MAT 18:6-9">Mat. 18:6-9</ref>; <ref loc="LUK 17:1-2">Luq. 17:1-2</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42"/>«Tana ammaniza yha xiqqitaypp petta balithodaypp oonkka, damma woxa fa qoodheeli accii, abba gancce wodhdhizako eesi lo77oda. <verse eid="MRK 9:42"/><verse number="43" style="v" sid="MRK 9:43"/>Ne kushay nena balithiko, gachchii oloba. Neenii nam77ii kusher to7oowa gaanname tama gancce wodhdhizaypp, duuxa kusher medhina de7o gelo neesi lo77oda. <verse eid="MRK 9:43"/><verse number="44" style="v" sid="MRK 9:44"/>Gaanname guxinekka yhayqqoowa, tamaykka to7oowa aqo.<note caller="-" style="x"><char style="xo" closed="false">9:43-44 </char><char style="xt" closed="false"><ref loc="MAT 5:30">Mat. 5:30</ref></char></note> <verse eid="MRK 9:44"/><verse number="45" style="v" sid="MRK 9:45"/>Ne tokay nena balithiko, gachchii oloba. Ne nam77ii toker gaanname tama gancce wodhdhizaypp, wobbo maaqqii de7o gelizako neesi lo77o. <verse eid="MRK 9:45"/><verse number="46" style="v" sid="MRK 9:46"/>Gaanname guxine yhayqqoowa, tamaykka to7oowa aqo. <verse eid="MRK 9:46"/><verse number="47" style="v" sid="MRK 9:47"/>Ne aafay nena balithiko, woocii kessii oloba. Ne nam77ii aafer gaanname tama gancce wodhdhizaypp, pettii aafer Xooss kaatetithii gelizako neesi lo77o.<note caller="-" style="x"><char style="xo" closed="false">9:47 </char><char style="xt" closed="false"><ref loc="MAT 5:29">Mat. 5:29</ref></char></note> <verse eid="MRK 9:47"/><verse number="48" style="v" sid="MRK 9:48"/>Gaanname guxinay yhayqqoowa, tamaykka to7oowa aqo.<note caller="-" style="x"><char style="xo" closed="false">9:48 </char><char style="xt" closed="false"><ref loc="ISA 66:24">Isa. 66:24</ref></char></note><verse eid="MRK 9:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 9:49"/>«Yarshsho maxiner oothinttizay garkk asii ubbay tamar harqinttoda. <verse eid="MRK 9:49"/><verse number="50" style="v" sid="MRK 9:50"/>Maxine lo77o, zin mal7aam ixxiko, maaqqii wayizii mal7ithode? Yinttar maxine yezo. Yeezii pettay pettayir saro yezoytta» yeegeeza.<note caller="-" style="x"><char style="xo" closed="false">9:50 </char><char style="xt" closed="false"><ref loc="MAT 5:13">Mat. 5:13</ref>; <ref loc="LUK 14:34">Luq. 14:34</ref></char></note><verse eid="MRK 9:50"/></para>
  <chapter eid="MRK 9"/>
  <chapter number="10" style="c" sid="MRK 10"/>
  <para style="s1">Machcho anjjodayis beezooya</para>
  <para style="r">(<ref loc="MAT 19:1-2">Mat. 19:1-2</ref>; <ref loc="LUK 16:18">Luq. 16:18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1"/>Yesuusa yeypp dendii, Yihuda biitta yhanigii Yorddanoose borkka piinggeeza. Gaame asay maaqqii eziko shiiqin, kaseesay garkk ya asa taamarsseeza.<verse eid="MRK 10:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 10:2"/>Farasaawe asapp faaccodayis koyii Yesuusa, «Pettii as fa machchato anjjodgarkk Muse higgay kiitinee?» yeegii eza oyceeza.<verse eid="MRK 10:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3"/>E mahii, «Muse yinttan kase waagii kiitteenee?» yeegeeza.<verse eid="MRK 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4"/>Unttii, «Muse, ‹Pettii asii fa machchatis anjjo warqqate ingii dakko› geeza» yeegeeza.<note caller="-" style="x"><char style="xo" closed="false">10:4 </char><char style="xt" closed="false"><ref loc="NUM 24:1">Tay. 24:1</ref></char></note><verse eid="MRK 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5"/>Yesuusa mahii, unttan «Yi wozinay miinthii maaqqeez gishos Muse yha azaza yinttis xaafeeza. <verse eid="MRK 10:5"/><verse number="6" style="v" sid="MRK 10:6"/>Zin Xoossay tiina medhdhitar dhiirathara maachchar udii, medhdheeza.<note caller="-" style="x"><char style="xo" closed="false">10:6 </char><char style="xt" closed="false"><ref loc="GEN 1:27">Medhe. 1:27</ref>; <ref loc="GEN 5:1">5:1</ref></char></note> <verse eid="MRK 10:6"/><verse number="7" style="v" sid="MRK 10:7"/>Yey gishos, pettii asii fa adennee fa indo ashshii, fa machchatir wolla maadinttiza.<note caller="-" style="x"><char style="xo" closed="false">10:7-8 </char><char style="xt" closed="false"><ref loc="GEN 2:24">Medhe. 2:24</ref></char></note> <verse eid="MRK 10:7"/><verse number="8" style="v" sid="MRK 10:8"/>U nam7itay pettii asho maaqqiza; yhaypp, u pettii asho maaqqodaypp attin nam7e maaqqooya. <verse eid="MRK 10:8"/><verse number="9" style="v" sid="MRK 10:9"/>Yeyi gishos, Xoossay wolalli waaxeezana asii shaakkippe» yeegeeza.<verse eid="MRK 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10"/>U kara maaqqeez wode e tamaaritay yha oday bagga Yesuusa nam7intho oyceeza. <verse eid="MRK 10:10"/><verse number="11" style="v" sid="MRK 10:11"/>Yesuusa unttiko, «Fa machchato anjii hara ekkiz oonkka laammiza.<note caller="-" style="x"><char style="xo" closed="false">10:11-12 </char><char style="xt" closed="false"><ref loc="MAT 5:32">Mat. 5:32</ref>; <ref loc="1CO 7:10-11">1 Qor. 7:10-11</ref></char></note> <verse eid="MRK 10:11"/><verse number="12" style="v" sid="MRK 10:12"/>Ma machchatakka fa azinaypp kezii hara azin geliko laammiza» yeegeeza.<verse eid="MRK 10:12"/></para>
  <para style="s1">Yesuusa duude na7ita anjeeza</para>
  <para style="r">(<ref loc="MAT 19:13-15">Mat. 19:13-15</ref>; <ref loc="LUK 18:15-17">Luq. 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13"/>Yesuusa duude na7ita bochchod garkk, pettii pettii asay na7ita eziko ki7iza, zin e tamaaritay ye asita kacceeza. <verse eid="MRK 10:13"/><verse number="14" style="v" sid="MRK 10:14"/>Yesuusa yeya bi7ii, fa taamarita gayileeza; unttiko, «Duude na7itay taako yi7izana kayppate; Xooss kaatetithay yhaytitay garkkezitayisii. <verse eid="MRK 10:14"/><verse number="15" style="v" sid="MRK 10:15"/>Ta yinttis turo odiza; Xooss kaatetitha duude na7a garkk ekkowa as oonkka ye kaatetitha ubbarakka gelaamii» yeegeeza.<note caller="-" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="MAT 18:3">Mat. 18:3</ref></char></note> <verse eid="MRK 10:15"/><verse number="16" style="v" sid="MRK 10:16"/>Yeypp guye duude na7ita idinggii, fa kushe unttal afa gaddii anjeeza.<verse eid="MRK 10:16"/></para>
  <para style="s1">Duretithinnee Xooss kaatetith</para>
  <para style="r">(<ref loc="MAT 19:16-30">Mat. 19:16-30</ref>; <ref loc="LUK 18:18-30">Luq. 18:18-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17"/>Yesuusa yhanigodayis kezodara pettii athay laasii yi7ii, e tiinayid bunqqitidinne, «keeha Asitamaarayyo, medhinas de7o laattodayis ta ab ootho?» yeegii oyceeza.<verse eid="MRK 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 10:18"/>Yesuusa, «Abis tana keehayyo gi xeegee? Xooss aaddapp attin hara keeha oonkka baaya. <verse eid="MRK 10:18"/><verse number="19" style="v" sid="MRK 10:19"/>Xoossa kiitay, wodhippe; laammippe; kasttippe; worddo markattippe; dooshippe; ne adenne ne indo bonchchoba yeegizana ne eriza» yeegeeza.<note caller="-" style="x"><char style="xo" closed="false">10:19 </char><char style="xt" closed="false"><ref loc="EXO 20:12-16">Kes. 20:12-16</ref>; <ref loc="NUM 5:16-20">Tay. 5:16-20</ref></char></note><verse eid="MRK 10:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20"/>Athay, «Asitamaarayyo, ta yhayitita ubba na7atithapp aykkii yhanno hellodayis naagiza» yeegeeza.<verse eid="MRK 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21"/>Yesuusa atha dakkii bi7ii qadhdheeza; «Nees pettibazii pacciza; yhanigii neesi yeza baz ubba bayizii, ye miisha manqqitayis ingoba; ne salo duritoda. Yeezii maaqqii tana kaalloba» yeegeeza. <verse eid="MRK 10:21"/><verse number="22" style="v" sid="MRK 10:22"/>Zin athay yeya si7ii, e tuqqeez dure maaqqeez gishos fa sina tukkeeza, ufayttekkazar ashshii qiteeza.<verse eid="MRK 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23"/>Yesuusa fa taamarita yuuyii bi7ii, «Dure as Xoossa kaatetithii gelodayi wayizii metodeshsha!» yeegeeza.<verse eid="MRK 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 10:24"/>E tamaaritay e timirtta si7ii malabaz geeza. Zin Yesuusa maakka unttiko, «Na7ito, Xoossa kaatetithii gelodayi wayizii metodeshsha! <verse eid="MRK 10:24"/><verse number="25" style="v" sid="MRK 10:25"/>Dure as Xooss kaatetithii gelodaypp, gimaale narppe lukor aadhoday shawukkiza» yeegeeza.<verse eid="MRK 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26"/>E tamaaritay yhay malabaz gi, «Yeezin, oonii attodee?» yeegii, pettay petta oyceeza.<verse eid="MRK 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27"/>Yesuusa unttan dakkii bi7ii, «Yhay Xoossis danda7inttizapp attin asis danda7inttooya; Xoossis ubba baz danda7inttiza» yeegeeza.<verse eid="MRK 10:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28"/>Phixiroosa Yesuusako, «Yeezako; nuunii nubaz ubba ashshii, nena kaalleeza» yeegeeza.<verse eid="MRK 10:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 10:29"/>Yesuusa «Ta yinttis turo odiza; ta gishonnee Wonggile gishos fa kara woy ishita woy mishita woy ade woy indo woy machcho woy na7ita woy gade ashsheezay oonkka, <verse eid="MRK 10:29"/><verse number="30" style="v" sid="MRK 10:30"/>Yhatti yha wodayid bayi7ithar fa kara, ishita, mishita, indita, na7ita, gade, xeet kushe ekkoda. Tiinas ye7od alame medhina de7o ekkoda. <verse eid="MRK 10:30"/><verse number="31" style="v" sid="MRK 10:31"/>Zin gaamitay tiinatteezitay guyitoda, maakka gaamitay guyiteezitay tiinatoda» yeegeeza.<note caller="-" style="x"><char style="xo" closed="false">10:31 </char><char style="xt" closed="false"><ref loc="MAT 20:16">Mat. 20:16</ref>; <ref loc="LUK 13:30">Luq. 13:30</ref></char></note><verse eid="MRK 10:31"/></para>
  <para style="s1">Yesuusa fa yhayiqannee fa denday bagga hayidzantho odeeza</para>
  <para style="r">(<ref loc="MAT 20:17-19">Mat. 20:17-19</ref>; <ref loc="LUK 18:31-34">Luq. 18:31-34</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32"/>Yesuusarannee e tamaaritayir Yerusalaame yhammadar, Yesuusa fa tamaaritaypp tiin tiin yedhdhiza. U yeya malabaz geeza. Eza kaallizitaykka yashitteeza. Nam7intho, taphpho nam77ii taamarita gaxa kessii, fana hellod baza duma unttisi yhay garkk yeegii odeeza. <verse eid="MRK 10:32"/><verse number="33" style="v" sid="MRK 10:33"/>«Yeezako, nuunii Yerusalaame yhatti wolla kessal yeza. Yeydda as Na7a, qeese halaqitayisnnee higge asitamaaritayis aathii inginttoda. U ezal afa yhayiqo pirdda pirddoda; ma Ayihude baa woyas eza aathii immada. <verse eid="MRK 10:33"/><verse number="34" style="v" sid="MRK 10:34"/>Ye Ayihude baa woyay eza toochchoda, ezal afa cuttoda, lissor garafodannee wodhoda. E hayidzii gallasapp guye, yhayiqopp dendoda» yeegeeza.<verse eid="MRK 10:34"/></para>
  <para style="s1">Yayqqoobarannee Waannisa woosa</para>
  <para style="r">(<ref loc="MAT 20:20-28">Mat. 20:20-28</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35"/>Zabdoosa na7itay Yayqqoobarannee Waannisar Yesuusako yi7ii, «Asitamaarayyo, nuunii nena woossiza ubba baz nuus oothoday garkk koyiza» yeegeeza.<verse eid="MRK 10:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 10:36"/>E unttiko, «Taanii yinttis ab ootho?» yeegeeza.<verse eid="MRK 10:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 10:37"/>Unttii, «Neenii ne bonchcho kaatetitha bettiza gallas nuupp petta ushachch baggar ma petta haddirss baggar bettithooye» yeegeeza.<verse eid="MRK 10:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38"/>Zin Yesuusa unttiko, «Yi ab woossizako erooya, ta uzhodayis yez xuu7a uzhodayis danda7inee? Ma ta xammaqqinttodayis yez xinqqata xammaqinttodayis danda7inee?» yeegeeza.<note caller="-" style="x"><char style="xo" closed="false">10:38 </char><char style="xt" closed="false"><ref loc="LUK 12:50">Luq. 12:50</ref></char></note><verse eid="MRK 10:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 10:39"/>U mahii, «E nu danda7iza» yeegeeza.</para>
  <para style="p" vid="MRK 10:39">Yesuusa maakka, «Tuma ta uzhodayis yez xuu7a yi uzhoda, ta xammaqinttodayis yez xinqqata yi xammaqinttoda. <verse eid="MRK 10:39"/><verse number="40" style="v" sid="MRK 10:40"/>Zin taapp ushachch baggarannee haddirss baggar bettodita dooro ta wolqqa baaya, zin ye aqay Xoossay immadayis giigisii gaddeezitayisii» yeegeeza.<verse eid="MRK 10:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41"/>Yhankko taphphii tamaaritay yeya si7ii Yayqqoballannee Waannisall gayilntteeza. <verse eid="MRK 10:41"/><verse number="42" style="v" sid="MRK 10:42"/>Yesuusa unttan ubba faako xeegii, «Ayihude baa asitayis halaqitay gade aqisizita ginttinttii xeeginttizitay moodizitayis fa asitayil afa mawute yezana yi eriza.<note caller="-" style="x"><char style="xo" closed="false">10:42-44 </char><char style="xt" closed="false"><ref loc="LUK 22:25-26">Luq. 22:25-26</ref>; <ref loc="MAT 23:11">Mat. 23:11</ref>; <ref loc="MRK 9:35">Mar. 9:35</ref>; <ref loc="LUK 22:26">Luq. 22:26</ref></char></note> <verse eid="MRK 10:42"/><verse number="43" style="v" sid="MRK 10:43"/>Zin yi gancce yey garkk baaya; yinttii yi gancce bayiradhodayis koyiz oonkka yinttis aylle maaqqodayis beeziza. <verse eid="MRK 10:43"/><verse number="44" style="v" sid="MRK 10:44"/>Ma yi gancce ubbapp dhoqqa maaqqodayis koyiz oonkka yi ubbayis aylle maaqqodayis beeziza. <verse eid="MRK 10:44"/><verse number="45" style="v" sid="MRK 10:45"/>Hara attozin, As Na7aykka, asis oothodayisinnee gaamita wozodayis fa shemppo aathii immadayis ye7eezapp attin asii ezisi oothod garkk ye7ekkaya» yeegeeza.<verse eid="MRK 10:45"/></para>
  <para style="s1">Yesuusa to7a Barximoosa aafa patheeza</para>
  <para style="r">(<ref loc="MAT 20:29-34">Mat. 20:29-34</ref>; <ref loc="LUK 18:35-43">Luq. 18:35-43</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46"/>Unttii Iyarkko katama yhanigeeza. Yesuusa fa tamaaritayirannee gaame asitayir Iyarkkopp kezodar, Ximoosa na7ay, to7ay, Barximoosa ginttinttizay, oge gaxa bettii woossiza. <verse eid="MRK 10:46"/><verse number="47" style="v" sid="MRK 10:47"/>Barximoosa, e ye ogayr aadhizay Naazirete Yesuusa maaqqeezana si7ii fa qaala dhoqqi udii, «Dawute na7a Yesuusa, tana maarooye!» yeegttar uufo aykkeeza.<verse eid="MRK 10:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 10:48"/>Gaame asay eza, «Hayizoba!» yeegii qoddeeza.</para>
  <para style="p" vid="MRK 10:48">Zin, e fa qaala tiinaasaypp aathii, «Dawute na7ayyo, tana hayyana maarooye!» yeegeeza.<verse eid="MRK 10:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 10:49"/>Yesuusa eqqii, «Eza yhana xeegoytta» yeegeeza.</para>
  <para style="p" vid="MRK 10:49">Unttii to7ayiko, «Akko baaya, dendii eqqoba, nena xeegiza» yeegeeza. <verse eid="MRK 10:49"/><verse number="50" style="v" sid="MRK 10:50"/>To7ay fa afila dhogii olii, guppii dendii eqqii, Yesuusako yhanigeeza.<verse eid="MRK 10:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 10:51"/>Yesuusakka, «Ta neesi ab udod garkk ne koyee?» yeegeeza.</para>
  <para style="p" vid="MRK 10:51">To7ay, «Asitamaarayyo, ta be7adayis koyiza» yeegeeza.<verse eid="MRK 10:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52"/>Yesuusa eza, «Qitoba, ne ammanay nena patheeza» yeegeeza. Izir e aafay bi7in, oger Yesuusa lassa kaalleeza.<verse eid="MRK 10:52"/></para>
  <chapter eid="MRK 10"/>
  <chapter number="11" style="c" sid="MRK 11"/>
  <para style="s1">Yesuusa gaame bonchchor Yerusalaame geleeza</para>
  <para style="r">(<ref loc="MAT 21:1-11">Mat. 21:1-11</ref>; <ref loc="LUK 19:28-40">Luq. 19:28-40</ref>; <ref loc="JHN 12:12-19">Wan. 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1"/>U Yerusalaame ukkittar, Debre Zayite Dere lanqqe yez Beetefaagennee Bitaana katama helleeza. Yesuusa fa tamaaritaypp nam7ita tiina kiittii, <verse eid="MRK 11:1"/><verse number="2" style="v" sid="MRK 11:2"/>«Yinttapp tiina yez heera yhanigoytta; ize heleezan garkk oonkka toggii be7ekka achcha yez hare na7a yi demmada, eza billii, yhana ekkii ye7oytta. <verse eid="MRK 11:2"/><verse number="3" style="v" sid="MRK 11:3"/>Oonkka yinttan, ‹Yhaya abiso wayize?› yeegii oyciko, ‹Goday eza koyiza, yeegoytta e ellisii yhana dakkoda› yeegoytta» yeegeeza.<verse eid="MRK 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4"/>U yhanigii, hare na7aykka bale oge kale acinttii yezana denggii billeeza. <verse eid="MRK 11:4"/><verse number="5" style="v" sid="MRK 11:5"/>Ye aqayid eqqeez pettii pettii asay unttiko, «Hare na7a wayssadayis billee?» yeegeeza. <verse eid="MRK 11:5"/><verse number="6" style="v" sid="MRK 11:6"/>E tamaaritay e unttan azazeezana odin, asay dakkii ashsheeza. <verse eid="MRK 11:6"/><verse number="7" style="v" sid="MRK 11:7"/>U hare na7a Yesuusako ki7ii, fa afilita e zokkayil hiixxin Yesuusa ya hare na7a toggeeza. <verse eid="MRK 11:7"/><verse number="8" style="v" sid="MRK 11:8"/>Gaame asay fa afila ogel hiixeeza; ma atteez asay mith haye shaqqii, ogel afa hiixxeeza. <verse eid="MRK 11:8"/><verse number="9" style="v" sid="MRK 11:9"/>Yesuusapp tiinar yezitannee eza guyer kaalliz asitay fa qaala dhoqqi udii,</para>
  <para style="q1" vid="MRK 11:9">«Hosaana!</para>
  <para style="q2" vid="MRK 11:9">Goday sunthar yi7izay anjintteezaya.<note caller="-" style="x"><char style="xo" closed="false">11:9 </char><char style="xt" closed="false"><ref loc="PSA 118:25">Maz. 118:25</ref></char></note><verse eid="MRK 11:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MRK 11:10"/>Yi7izana, nu ada</para>
  <para style="q2" vid="MRK 11:10">Dawute kaatetithat iza anjintteezanno. Hosaana! Ubbapp aadho Salo»</para>
  <para style="m" vid="MRK 11:10">yeegttar uukkeeza.<verse eid="MRK 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11"/>Yesuusa Yerusalaame yhanigii, Xoossa Keetha geleeza. Ma ubba baz yuuyii be7eezaypp guye, sa7ay qammeezayis taphpho nam77ii tamaaritayir Bitaana katama yhanigeeza.<verse eid="MRK 11:11"/></para>
  <para style="s1">Yesuusa baaddeez balase mithato</para>
  <para style="r">(<ref loc="MAT 21:18-19">Mat. 21:18-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12"/>Wonttitha gallas unttii Bitaanapp kezii yhammadar, Yesuusa nayintteeza. <verse eid="MRK 11:12"/><verse number="13" style="v" sid="MRK 11:13"/>Haakor pettii balase mithato haye tookkii yezanno bi7ii, Izil afa aafe benttodeshsha gi, be7adayis iziko yhanigeeza, zin iziko e yhanigodar haye aaddapp attin pettii aafekka denggekkaya; abis giiko, balase ka77iz wode hellekkaya. <verse eid="MRK 11:13"/><verse number="14" style="v" sid="MRK 11:14"/>Yesuusa ye balasato, «Yikkee, neepp medhinas asii aafe miippe» yeegeeza. E tamaaritay e giza si7eeza.<verse eid="MRK 11:14"/></para>
  <para style="s1">Yesuusa Xoossa keetha zal7izita kesseeza</para>
  <para style="r">(<ref loc="MAT 21:12-17">Mat. 21:12-17</ref>; <ref loc="LUK 19:45-48">Luq. 19:45-48</ref>; <ref loc="JHN 2:13-22">Wan. 2:13-22</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15"/>U Yerusalaame yhanigeeza; Yesuusa Xoossa Keethi gelii, ezayid bayizizitannee wonggizita bale bayi7ithii aykkeeza; ma miishe laammizitay xarpheezanannee holle bayizizitay oyda shirii oleeza, <verse eid="MRK 11:15"/><verse number="16" style="v" sid="MRK 11:16"/>Asii ababazkka tookkii, Xoossa Keethi ganccer aadhaamay garkk kayeeza. <verse eid="MRK 11:16"/><verse number="17" style="v" sid="MRK 11:17"/>Yesuusa asita yhay garkk yeegii taamarsseeza: «Geeshsha Maxaafayid, ‹Ta karay as ubbay Xoossa woossiza kara maaqqada› yeeginttii xaafinttekkasa? Zin yi eza paannitay qosinttiza komi7o maheeza» yeegeeza.<note caller="-" style="x"><char style="xo" closed="false">11:17 </char><char style="xt" closed="false"><ref loc="ISA 56:7">Isa. 56:7</ref>; <ref loc="JER 7:11">Erim. 7:11</ref></char></note><verse eid="MRK 11:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18"/>Qeese halaqitaynnee higge asitamaaritay yeya si7ii, eza wodhodayis oge koshshi aykkeeza. Zin woya ubbay E timirtta malabaz gizi gishos ezisi yashitteeza.<verse eid="MRK 11:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 11:19"/>Sa7a lem7ilem7odar Yesuusarannee e tamaaritay katamapp gaxa kezeeza.<verse eid="MRK 11:19"/></para>
  <para style="s1">Balase mithat meleeza</para>
  <para style="r">(<ref loc="MAT 21:20-22">Mat. 21:20-22</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20"/>Unttii wonttitha gallas ye ogayir aadhttar, ye balasata xaphor meleezano be7eeza. <verse eid="MRK 11:20"/><verse number="21" style="v" sid="MRK 11:21"/>Phixiroosas elqqi gin, «Asitamaarayyo, yinashe, ne baaddeez balasat meleeza» yeegeeza.<verse eid="MRK 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22"/>Yesuusa mahii, «Xoossa ammanoytta. <verse eid="MRK 11:22"/><verse number="23" style="v" sid="MRK 11:23"/>Ta yinttis turo odiza; oonkka fa wozinayid sidhdhekkazar geezbazii hanodana fa wozinar ammanii, yha amiba, ‹shodinttii abba gancce wodhoba› yeegiko ezisi hanoda.<note caller="-" style="x"><char style="xo" closed="false">11:23 </char><char style="xt" closed="false"><ref loc="MAT 17:20">Mat. 17:20</ref>; <ref loc="1CO 13:2">1 Qor. 13:2</ref></char></note> <verse eid="MRK 11:23"/><verse number="24" style="v" sid="MRK 11:24"/>Yey gishos, ta yinttis odiza; Xoossa yi woossizabazinnee oyciz baz ab maaqqiko ekkeezay garkk ammanoytta, yi ekkoda. <verse eid="MRK 11:24"/><verse number="25" style="v" sid="MRK 11:25"/>Xooss woossodayis yi eqqodar salo yez yi Aday yi nagara atto goday garkk, oonkka yinttan naaqqeez baz pettakka yeziko, ezisi atto goytta. [ <verse eid="MRK 11:25"/><verse number="26" style="v" sid="MRK 11:26"/>Zin as nagara yi atto gaam ixxiko, salo yez yi Adaykka yi nagara yinttis atto gamii» yeegeeza.]<verse eid="MRK 11:26"/></para>
  <para style="s1">Yesuusa aba mawuter oothizako oycintteeza</para>
  <para style="r">(<ref loc="MAT 21:23-27">Mat. 21:23-27</ref>; <ref loc="LUK 20:1-8">Luq. 20:1-8</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27"/>U maaqqikka Yerusalaame qiteeza. Yesuusa Xoossa Keetha yedhdhodar, qeese halaqitay, higge asitamaaritaynnee cimitay eziko yi7ii, <verse eid="MRK 11:27"/><verse number="28" style="v" sid="MRK 11:28"/>«Ne yhayttita oothodayis neesi aba mawute yenee? woy neesi yha mawuta inggeezay oonoo?» yeegeeza.<verse eid="MRK 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 11:29"/>Yesuusakka mahii unttiko, «Ta yinttan pettibaz oycoda, taas odoytta. Ta ma yhaya aba mawuter oothizako, yinttis ododa. <verse eid="MRK 11:29"/><verse number="30" style="v" sid="MRK 11:30"/>Waannisa xinqqatay Xoossappennee asappee? Taas odoytta» yeegeeza.<verse eid="MRK 11:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31"/>U woli gancce palama aykkii, «Nu, ‹Xoossapp› giiko, E nuuko, ‹Yeezin, Waannisa odeezana abis ammanekkasa?› yeegoda. <verse eid="MRK 11:31"/><verse number="32" style="v" sid="MRK 11:32"/>‹Asappee giiko› ubba as Waannisa nabe maaqqeeza eriza.» Yey gishos woyayis yashitteeza. <verse eid="MRK 11:32"/><verse number="33" style="v" sid="MRK 11:33"/>Yey gishos, u Yesuusako, «Nu erooya» yeegii maheeza;</para>
  <para style="p" vid="MRK 11:33">Yesuusakka, «Taankka yhaya aba mawuter oothizako, yinttis odaammii» yeegeeza.<verse eid="MRK 11:33"/></para>
  <chapter eid="MRK 11"/>
  <chapter number="12" style="c" sid="MRK 12"/>
  <para style="s1">Woyine tukkiz biitta oothii aqizitay aaziso</para>
  <para style="r">(<ref loc="MAT 21:33-46">Mat. 21:33-46</ref>; <ref loc="LUK 20:9-19">Luq. 20:9-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1"/>Yesuusa unttis aazisor yeegii oda aykkeeza; «pettii athay woyine mithii tukkii, yuushsha gaseeza. Ma woyine buulliz ollakka bookkeeza. Naagodayis aduss shaakko shakkiseeza. Yeypp guye, mattaye yhanttiz asayis ingii, hara biitta qiteeza.<note caller="-" style="x"><char style="xo" closed="false">12:1 </char><char style="xt" closed="false"><ref loc="ISA 5:1">Isa. 5:1</ref></char></note> <verse eid="MRK 12:1"/><verse number="2" style="v" sid="MRK 12:2"/>Woyine aafe maxiza wode hellin, fana hellizana ekkii ye7odgarkk, pettii fa aylla mattaye ekkeezitayiko azazeeza. <verse eid="MRK 12:2"/><verse number="3" style="v" sid="MRK 12:3"/>Mattaye ekkeezitay e aylla aykkii yhadhdhii, kallo kushe dakkeeza. <verse eid="MRK 12:3"/><verse number="4" style="v" sid="MRK 12:4"/>Nam7antho hara aylle unttiko kiittin, unttii ye aylla shuchchar qawuxii yeellathii dakkeeza. <verse eid="MRK 12:4"/><verse number="5" style="v" sid="MRK 12:5"/>Woyine atakiltte goday maakka hara aylle azazeeza. Ya aylla wodheeza, ma hara gaamita dakkin yey garkk, petta petta yhadhdhii, baggita wodheeza.<verse eid="MRK 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 12:6"/>«Woyine atakiltte godayis kiittodayis ubbapp wurssithal e lo7ithii qadhdhiza na7ay aadda atteeza. E, ‹U ta na7a bonchchekka ashshaamii› yeegii, fa na7a unttiko azazeeza.<verse eid="MRK 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 12:7"/>«Zin mattaye ekkeezitay fa ganccer, ‹Laattoday yhaya; yedhdhoytta eza wolla wodhoda; e gaday nuus maaqqoda!› yeegeeza. <verse eid="MRK 12:7"/><verse number="8" style="v" sid="MRK 12:8"/>Na7a aykkii wodhii, e aha woyine atakiltte ganccepp gaxa kessii oleeza.<verse eid="MRK 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9"/>«Yikkee, woyine atakiltte goday wayssadee? Yi7ii ye mattaye ekkeezita wodhii, woyina oothiza hara asayis immada.<verse eid="MRK 12:9"/></para>
  <para style="q1">
    <verse number="10-11" style="v" sid="MRK 12:10-11"/>« ‹Gimbbizitay borii ixxeez shuchchay</para>
  <para style="q2" vid="MRK 12:10-11">keeth muumer tookkiza kirkiro garkk;</para>
  <para style="q2" vid="MRK 12:10-11">ubbapp aadhiz shuchch maaqqeeza.</para>
  <para style="q1" vid="MRK 12:10-11">Yhay Goday ootheez bazi;</para>
  <para style="q2" vid="MRK 12:10-11">ma nu aafayiskka mala bazi›</para>
  <para style="q2" vid="MRK 12:10-11">Yeegizana geeshsha Maxaafepp nabbabekasa?»</para>
  <para style="m" vid="MRK 12:10-11">yeegeeza.<note caller="-" style="x"><char style="xo" closed="false">12:10-11 </char><char style="xt" closed="false"><ref loc="PSA 118:22-23">Maz. 118:22-23</ref></char></note><verse eid="MRK 12:10-11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12"/>Qeese halaqitay, higge asitamaaritaynnee cimitay Yesuusa ye aazisa u faal afa aaziseezana ereez gishos eza aykkodayis koyeeza, zin asayis yashittii, ashshii qiteeza.<verse eid="MRK 12:12"/></para>
  <para style="s1">Giira baggar shiiqeez oychch</para>
  <para style="r">(<ref loc="MAT 22:15-22">Mat. 22:15-22</ref>; <ref loc="LUK 20:20-26">Luq. 20:20-26</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13"/>Farasaawitayppennee Herodoosa baggitaypp xiqqa asitay e odaypp buuta denggii, eza aykkodayis koyii, eziko azazeeza. <verse eid="MRK 12:13"/><verse number="14" style="v" sid="MRK 12:14"/>U eziko yi7ii, «Asitamaarayyo, ne turo odinttizannee asapp ase shagoozana nu eriza. Ne ase shagooya; ma Xooss oge tumar taamarssiza. Nu Oroome biitta Kaat Qeesaares giira gachchizay woganee woga baasa? Giira gachchonnee ashsho?» yeegeeza.<verse eid="MRK 12:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 12:15"/>Zin u cubbotitha Yesuusa erii, «Tana abis faaccodayis koyee? An pettii santte yhana ki7ii tana beezoytta» yeegeeza. <verse eid="MRK 12:15"/><verse number="16" style="v" sid="MRK 12:16"/>Unttii ezisi ke7eeza, «Yha mallaynnee sunthay ooso?» yeegii unttan oyceeza.</para>
  <para style="p" vid="MRK 12:16">Unttii, «Qeesaares» yeegeeza.<verse eid="MRK 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 12:17"/>Yesuusa mahii, «Yeezako, Qeesaareesana Qeesaares, Xoossiisa Xoossis inggoytta» yeegin u e oda yhay mala bazi geeza.<verse eid="MRK 12:17"/></para>
  <para style="s1">Yhayiqopp dendo bagga</para>
  <para style="r">(<ref loc="MAT 22:23-33">Mat. 22:23-33</ref>; <ref loc="LUK 20:27-40">Luq. 20:27-40</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18"/>Yhayqqeez asii dendooya giz Saduqaawitaypp pettii pettii asay Yesuusako yi7ii, yhay garkk yeegii, eza oyceeza.<note caller="-" style="x"><char style="xo" closed="false">12:18 </char><char style="xt" closed="false"><ref loc="ACT 23:8">Haw. O. 23:8</ref></char></note> <verse eid="MRK 12:18"/><verse number="19" style="v" sid="MRK 12:19"/>«Asitamaarayyo, Muse nuus higge xaafittar, ‹Machcho ekkeez athay na7a yelekka yhayqqiko, ye yhayqqeezayis ishay e machchato ekkii, fa ishayis na7a yelodayis beeziza› yeegizana xaafeeza.<note caller="-" style="x"><char style="xo" closed="false">12:19 </char><char style="xt" closed="false"><ref loc="NUM 25:5">Tay. 25:5</ref></char></note> <verse eid="MRK 12:19"/><verse number="20" style="v" sid="MRK 12:20"/>Binii wode laappun ishitay yezitaypp bayray machcho ekkii, na7a yelekkazar yhayqqeeza. <verse eid="MRK 12:20"/><verse number="21" style="v" sid="MRK 12:21"/>Nam7inthay izo ekkeeza, ezkka na7a yelekkazar yhayqqeeza. Hayidzinthaykka yey garkk haneeza. <verse eid="MRK 12:21"/><verse number="22" style="v" sid="MRK 12:22"/>Laappunitaykka yeyigarkk izo ekkii, na7a yelekkazar yhayqqeeza. Ubbapp guye, ma ye asitakka yhayqqeeza. <verse eid="MRK 12:22"/><verse number="23" style="v" sid="MRK 12:23"/>Yeezin, laappunitay izo ekkeez gishos yhayqqeez asay yhayiqopp dendiza gallas, iza unttapp aayayis machcho maaqqode?» yeegeeza.<verse eid="MRK 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24"/>Yesuusa mahii, «Yi balinttizay, geeshsha Maxaafita woy Xooss wolqqa erekka gishos baasa? <verse eid="MRK 12:24"/><verse number="25" style="v" sid="MRK 12:25"/>Yhayqqeez asay yhayiqopp dendiza gallas, salo yez kiitanchchitay garkk maaqqodaypp attin dhiirathi asay ekkooya; maachii asitay gelooya. <verse eid="MRK 12:25"/><verse number="26" style="v" sid="MRK 12:26"/>Zin yhayqqeezitay dendo bagga maaqqiko, Xoossii Museko tusha gancce eexiz tamapp waageezako Muse maxaafaypp nabbabekkasa? Yeykka ‹Taanii, Afraame Xoossii, Isaaqa Xoossii, Yayqqooba Xoossii› yeegeezaya<note caller="-" style="x"><char style="xo" closed="false">12:26 </char><char style="xt" closed="false"><ref loc="EXO 3:6">Kes. 3:6</ref></char></note> <verse eid="MRK 12:26"/><verse number="27" style="v" sid="MRK 12:27"/>Yey gishos, e, path yezitay Xoossapp attin yhayqqeezitay Xooss baaya. Yi aqopp aadhii balinttiza» yeegeeza.<verse eid="MRK 12:27"/></para>
  <para style="s1">Ubbapp aadhiz kiita</para>
  <para style="r">(<ref loc="MAT 22:34-40">Mat. 22:34-40</ref>; <ref loc="LUK 10:25-28">Luq. 10:25-28</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28"/>Higge asitamaaritaypp pettay u palamizana shiiqii si7eeza. Ma Yesuusa unttis lo7ithii maheezana si7ii, «Kiita ubbapp aadhiz kiitay aaya?» yeegii Yesuusana oyceeza.<note caller="-" style="x"><char style="xo" closed="false">12:28-34 </char><char style="xt" closed="false"><ref loc="LUK 10:25-28">Luq. 10:25-28</ref></char></note><verse eid="MRK 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29"/>Yesuusa mahii, eziko yhay garkk yeegeeza: «Kiita ubbapp aadhiz kiita si7oytta; ‹Isreele asayis, Goday nu Xoossay pettii Goda.<note caller="-" style="x"><char style="xo" closed="false">12:29-30 </char><char style="xt" closed="false"><ref loc="NUM 6:4-5">Tay. 6:4-5</ref></char></note> <verse eid="MRK 12:29"/><verse number="30" style="v" sid="MRK 12:30"/>Ne Goda ne Xoossa ne kunth wozinapp, ne kunth shemppopp, ne kunth qofapp, ne kunth wolqqapp qadhdhoba› yeegeeza. <verse eid="MRK 12:30"/><verse number="31" style="v" sid="MRK 12:31"/>Ma kiita ubbapp aadhiz nam7intho kiitay yhaya; ‹Ne lagga ne ubbay garkk qadhdhoba› yeegiza; yhayttitaypp aadhiz hara kiita baaya» yeegeeza.<note caller="-" style="x"><char style="xo" closed="false">12:31 </char><char style="xt" closed="false"><ref loc="LEV 19:18">Lewii. 19:18</ref></char></note><verse eid="MRK 12:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32"/>Higge asitamaaray Yesuusako, «Asitamaarayyo; ‹Xoossay petto. Ezapp attin hara baaya› ne geezay turo.<note caller="-" style="x"><char style="xo" closed="false">12:32 </char><char style="xt" closed="false"><ref loc="NUM 4:35">Tay. 4:35</ref></char></note> <verse eid="MRK 12:32"/><verse number="33" style="v" sid="MRK 12:33"/>Xoossa kunth wozinapp, kunth qofappennee kunth wolqqapp qadhdhizaynnee ma as ubba fa ubbay garkk qadhdhizay xuuggiz yarshshoppennee hara yarshsho ubbaypp aadhiza» yeegeeza.<note caller="-" style="x"><char style="xo" closed="false">12:33 </char><char style="xt" closed="false"><ref loc="HOS 6:6">Hosa. 6:6</ref></char></note><verse eid="MRK 12:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 12:34"/>Yesuusa higge asitamaaray mahithay aadho era as malisse maaqqeezana bi7ii, «Ne Xooss kaatetithapp haakkekkaya» yeegeeza; yeypp guye, Yesuusana hara baz oycodayis oonkka minggekkaya.<note caller="-" style="x"><char style="xo" closed="false">12:28-34 </char><char style="xt" closed="false"><ref loc="LUK 10:25-28">Luq. 10:25-28</ref></char></note><verse eid="MRK 12:34"/></para>
  <para style="s1">Kiristtoosa o na7a</para>
  <para style="r">(<ref loc="MAT 22:41-46">Mat. 22:41-46</ref>; <ref loc="LUK 20:41-46">Luq. 20:41-46</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35"/>Yesuusa Xooss Keetha tamaarssittar, yhay garkk yeegeeza: «Higge asitamaaritay Kiristtoosa waagii fana Dawute na7a gee? <verse eid="MRK 12:35"/><verse number="36" style="v" sid="MRK 12:36"/>Dawute geesha Ayyana denthithin,</para>
  <para style="q1" vid="MRK 12:36">« ‹Goday, ta Godayiko, «Taanii ne morkkita</para>
  <para style="q2" vid="MRK 12:36">ne toke yedhdhiz aqo udod gatho,</para>
  <para style="q2" vid="MRK 12:36">yhaydda ta ushachcha bettoba» geeza</para>
  <para style="m" vid="MRK 12:36">yeegeeza.<note caller="-" style="x"><char style="xo" closed="false">12:36 </char><char style="xt" closed="false"><ref loc="PSA 110:1">Maz. 110:1</ref></char></note> <verse eid="MRK 12:36"/><verse number="37" style="v" sid="MRK 12:37"/>Dawute fa ubbas Kiristtoosana, «Goda gi xeegiko, yeezin, Kiristtoosa wayizii, Dawute na7a maaqqee» yeegeeza.</para>
  <para style="p" vid="MRK 12:37">Woyay Yesuusa gizana ufayttii si7eeza.<verse eid="MRK 12:37"/></para>
  <para style="s1">Yesuusa higge asitamaarita boreeza</para>
  <para style="r">(<ref loc="MAT 23:1-36">Mat. 23:1-36</ref>; <ref loc="LUK 20:45-47">Luq. 20:45-47</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 12:38"/>Yesuusa tamaarssittar, yhay garkk yeegeeza: «Higge asitamaaritaypp naaginttoytta; u aduss afila ma77ii yuuyizitannee gabellakka asay unttan bonchchii sarothizana dosiza. <verse eid="MRK 12:38"/><verse number="39" style="v" sid="MRK 12:39"/>Unttii Ayihuditay Woosa keetha gaame lo77o oyde dosiza; maakka asii fana mokkiza aqokka bonchcho aqo dosiza. <verse eid="MRK 12:39"/><verse number="40" style="v" sid="MRK 12:40"/>U asii be7o gi woosa adussisttar, am7itay keetha bonqqiza; u ubbapp aadhiz pirdda ekkoda» yeegeeza.<verse eid="MRK 12:40"/></para>
  <para style="s1">Am7ati muxaata</para>
  <para style="r">(<ref loc="LUK 21:1-4">Luq. 21:1-4</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41"/>Yesuusa Xooss Keeth gancce muxaata oliza saaxine kale bettii, asay fa miisha ye saaxinayid olizana be7eeza; gaame dure asay gaame miishe ye saaxinate oliza. <verse eid="MRK 12:41"/><verse number="42" style="v" sid="MRK 12:42"/>Pettii manqqo am7at yi7ii, nam77ii sikkinna ye saaxintte oleeza. <verse eid="MRK 12:42"/><verse number="43" style="v" sid="MRK 12:43"/>Yesuusa fa taamarita xeegii, «Ta yinttis turo odiza; muxaata saaxine gancce oleez as ubbapp yha manqqo am7at aathii oleeza. <verse eid="MRK 12:43"/><verse number="44" style="v" sid="MRK 12:44"/>Abis giiko, yhankkitay ubbitay paas puceez miishaypp oleeza. Zin iza fa pacatipp, paas yezanno ubbar oleeza» yeegeeza.<verse eid="MRK 12:44"/></para>
  <chapter eid="MRK 12"/>
  <chapter number="13" style="c" sid="MRK 13"/>
  <para style="s1">Yesuusa Xooss keethay laalinttodana tiinatii odeeza</para>
  <para style="r">(<ref loc="MAT 24:1-2">Mat. 24:1-2</ref>; <ref loc="LUK 21:5-6">Luq. 21:5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1"/>Yesuusa Xooss keethapp kezodar, e tamaaritaypp pettay, «Asitamaarayyo, yhay waafa lo77o shuchchinnee waafa lo77o shuchch keethizako ne bo7oba!» yeegeeza.<verse eid="MRK 13:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 13:2"/>Yesuusa mahii, «Yha damma shuchch keetha ne bi7inee? Yha keethay shuchchii shuchchal afa gimbbintteezay garkk laalinttekkazar attaamii; pettii shuchchikka attekkazar ubbitay laalinttoda» yeegeeza.<verse eid="MRK 13:2"/></para>
  <para style="s1">Wurssith layithis yez mala</para>
  <para style="r">(<ref loc="MAT 24:3-14">Mat. 24:3-14</ref>; <ref loc="LUK 21:7-19">Luq. 21:7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3"/>Yesuusa Xooss keethapp tiina baggar Debre Zayite ambal afa betteezin, Phixiroosa, Yayqqooba, Waannisannee Indiraasera wolla eziko yi7ii, <verse eid="MRK 13:3"/><verse number="4" style="v" sid="MRK 13:4"/>«Yhay ayide hanodazako, nuus odoba; yha ubbitay polinttod woda erisiza mallay abba?» yeegii oyceeza.<verse eid="MRK 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5"/>Yesuusa maakka unttis yhay garkk yeegii odeeza: «Yinttan oonkka balithaamay garkk naaginitoytta. <verse eid="MRK 13:5"/><verse number="6" style="v" sid="MRK 13:6"/>Gaame asay ta sunthar, ‹Taanii Kiristtoosa› yeegttar yi7ii, gaame asita balithoda. <verse eid="MRK 13:6"/><verse number="7" style="v" sid="MRK 13:7"/>Olannee ola wore yi si7eez gallas dagamippatte. Yey garkk baz hanoday attaamii, zin wurssithay haga. <verse eid="MRK 13:7"/><verse number="8" style="v" sid="MRK 13:8"/>Pettii woya hara woyar olinttoda; ma pettii kaatetithay hara kaatetithar olinttoda; biitta eni7o ubba aqo hanoda; naye denidoda, zin yey ubbay yelosi maachchii iqinttiz zookegarkke.<verse eid="MRK 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9"/>«Zin yi, yi ubbas naaginttoytta. Abis giiko, asii yinttan aykkii, pirdde keethis aathii immada; ma Ayihuditay Woosa Keethitayidakka yinttan alanggar alanggoda; gade aqisizitay tiinannee kaatitay tiina ta gishos yi markkattodayis eqqoda.<note caller="-" style="x"><char style="xo" closed="false">13:9-11 </char><char style="xt" closed="false"><ref loc="MAT 10:17-20">Mat. 10:17-20</ref>; <ref loc="LUK 12:11-12">Luq. 12:11-12</ref></char></note> <verse eid="MRK 13:9"/><verse number="10" style="v" sid="MRK 13:10"/>Wurssithii hellodaypp tiina Wonggile as ubbayis odinttodayis beeziza. <verse eid="MRK 13:10"/><verse number="11" style="v" sid="MRK 13:11"/>U yinttan pirdde keeth ki7iza wodennee aathii inggiza wode waagii odode yeegii hirigipatte; ye saatate Xoossay yinttis inggiza baz odoytta. Geeshsha Ayyanay odinttizapp attin yinttan baaya.<verse eid="MRK 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 13:12"/>«Ishay fa isha, adayi fa na7a aathii immada. Na7itay fana yeleezitayil afa dendii, unttan wodhoda. <verse eid="MRK 13:12"/><verse number="13" style="v" sid="MRK 13:13"/>Asii ubbay yinttan ta sunthay gishos ixxoda, zin wurssithii hellodayis garzheezay attoda.<note caller="-" style="x"><char style="xo" closed="false">13:13 </char><char style="xt" closed="false"><ref loc="MAT 10:22">Mat. 10:22</ref></char></note><verse eid="MRK 13:13"/></para>
  <para style="s1">Yerusalaamel hellod iita meto</para>
  <para style="r">(<ref loc="MAT 24:15-28">Mat. 24:15-28</ref>; <ref loc="LUK 21:20-24">Luq. 21:20-24</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14"/>«Zin dhabisiza tuna ooso eqqodayis beezoowa aqo eqqeezin yi be7ada.» Yey waaguusizako nabbabizay akaako! «Yihuda biitta yezitay ye wode amiba guye qosintto.<note caller="-" style="x"><char style="xo" closed="false">13:14 </char><char style="xt" closed="false"><ref loc="DAN 9:27">Daan. 9:27</ref>; <ref loc="DAN 11:31">11:31</ref>; <ref loc="DAN 12:11">12:11</ref></char></note> <verse eid="MRK 13:14"/><verse number="15" style="v" sid="MRK 13:15"/>Keethal yez athaykka pettibaz ekkodayis, fa kara gelppe.<note caller="-" style="x"><char style="xo" closed="false">13:15-16 </char><char style="xt" closed="false"><ref loc="LUK 17:31">Luq. 17:31</ref></char></note> <verse eid="MRK 13:15"/><verse number="16" style="v" sid="MRK 13:16"/>Gade oothol yezay fa afila ekkodayis guye maaqqippe. <verse eid="MRK 13:16"/><verse number="17" style="v" sid="MRK 13:17"/>Ye wode wodeth maachitayisinnee dhanthiza maachita unttan ayye. <verse eid="MRK 13:17"/><verse number="18" style="v" sid="MRK 13:18"/>Zin yhay ubbitay hanodar woday barigo maaqqaamay garkk, Xooss woossoytta. <verse eid="MRK 13:18"/><verse number="19" style="v" sid="MRK 13:19"/>Abis giiko, Xoossii alame medhdheez wodepp aykkii, yhanno hellodayis hanibe7ekka meto tiinappekka hanaam meto asal afa ye wode hanoda.<note caller="-" style="x"><char style="xo" closed="false">13:19 </char><char style="xt" closed="false"><ref loc="DAN 12:1">Daan. 12:1</ref>; <ref loc="REV 7:14">Wan. Qon. 7:14</ref></char></note> <verse eid="MRK 13:19"/><verse number="20" style="v" sid="MRK 13:20"/>Goday ye gallasitay tayiba haatithoozako, as giz oonkka attaamii. Zin e fa dooreez asay gishos ye gallasitay tayiba qanthiseeza.<verse eid="MRK 13:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 13:21"/>«Ye wode oonkka yinttan, ‹Yhaya bo7oytta, Kiristtoosa yhaydda yeza woy Kiristtoosa sendayida yeza› yeegiko, yeya ammanippatte. <verse eid="MRK 13:21"/><verse number="22" style="v" sid="MRK 13:22"/>Worddo Kiristtoositayrannee worddo nabitay dendii unttis danda7inttiko, hara attozin Xoossay maraxeezitakka balithodayis mallannee malabaz beezoda. <verse eid="MRK 13:22"/><verse number="23" style="v" sid="MRK 13:23"/>Zin yi naaginttoytta; ta yinttis ubba baz tiinatii odeeza.<verse eid="MRK 13:23"/></para>
  <para style="s1">Kiristtoosa nam7intho yi7ithi</para>
  <para style="r">(<ref loc="MAT 24:29-31">Mat. 24:29-31</ref>; <ref loc="LUK 21:25-28">Luq. 21:25-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24"/>«Zin ye wode ye waayaypp guye,</para>
  <para style="q1" vid="MRK 13:24">« ‹Awa dhumoda;</para>
  <para style="q2" vid="MRK 13:24">agina fa foo7a kayoda;<note caller="-" style="x"><char style="xo" closed="false">13:24 </char><char style="xt" closed="false"><ref loc="ISA 13:10">Isa. 13:10</ref>; <ref loc="JER 2:10">Erim. 2:10</ref></char></note><verse eid="MRK 13:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="MRK 13:25"/>Xoolinttitay salopp gufoda;</para>
  <para style="q2" vid="MRK 13:25">ma salo yez wolqqitaykka eni7oda.›<note caller="-" style="x"><char style="xo" closed="false">13:25 </char><char style="xt" closed="false"><ref loc="ISA 34:4">Isa. 34:4</ref>; <ref loc="JOL 2:10">Iyu. 2:10</ref>; <ref loc="REV 6:13">Wan. Qon. 6:13</ref></char></note><verse eid="MRK 13:25"/></para>
  <para style="m">
    <verse number="26" style="v" sid="MRK 13:26"/>Ye wode as Na7ay, aadho wolqqarannee bonchchora shaara ganccer ye7odar ubbay be7ada.<note caller="-" style="x"><char style="xo" closed="false">13:26 </char><char style="xt" closed="false"><ref loc="DAN 7:13">Daan. 7:13</ref>; <ref loc="REV 1:7">Wan. Qon. 1:7</ref></char></note> <verse eid="MRK 13:26"/><verse number="27" style="v" sid="MRK 13:27"/>Ye wode Ee kiitanchchita kiittoda; unttikka oyddii gontte yhanigii sa7a gaxapp salo gaxa hellodayis, Xoossii dooreez asita shiishoda.<verse eid="MRK 13:27"/></para>
  <para style="s1">Layithay helleezana erisiza balase mithato</para>
  <para style="r">(<ref loc="MAT 24:32-35">Mat. 24:32-35</ref>; <ref loc="LUK 21:29-33">Luq. 21:29-33</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28"/>«Aaziso balase mithapp akaakoytta; balasata furccodarannee I hayay bili7ith aykkiko bone ukkeezana yi eriza. <verse eid="MRK 13:28"/><verse number="29" style="v" sid="MRK 13:29"/>Yey garkkekka, yi ye ubba baz hanizana bi7iko woday ukkii penge helleezana eroytta. <verse eid="MRK 13:29"/><verse number="30" style="v" sid="MRK 13:30"/>Ta yinttis turo odiza; yha ubbabazay hanod gatho yha yeletith ubbitay aadhaamii. <verse eid="MRK 13:30"/><verse number="31" style="v" sid="MRK 13:31"/>Salonnee sa7a aadhoda, zin ta qaalay ubbarakka aadhaamii.<verse eid="MRK 13:31"/></para>
  <para style="s1">Goday ye7od gallasannee saate oonkka erooya</para>
  <para style="r">(<ref loc="MAT 24:36-44">Mat. 24:36-44</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32"/>«Zin ye gallasannee ye saata Aday aaddapp attin hara attozin salo yez kiitanchchita maaqqin woy Na7a maaqqin oonkka erizay baaya.<note caller="-" style="x"><char style="xo" closed="false">13:32 </char><char style="xt" closed="false"><ref loc="MAT 24:36">Mat. 24:36</ref></char></note> <verse eid="MRK 13:32"/><verse number="33" style="v" sid="MRK 13:33"/>Ye gallasay ayide maaqqodazako yi eroowa gishos naaginttoytta, minggoyttannee woossoytta. <verse eid="MRK 13:33"/><verse number="34" style="v" sid="MRK 13:34"/>Ta yi7ithay fa kara ashshii, oge yhanigiza athay garkke. Athay fa ayllita ommar ommar ootho ayithii unttis fa oosayis mawute inggeeza; ma naagizanakka miinthii naagod garkk azazeeza.<note caller="-" style="x"><char style="xo" closed="false">13:34 </char><char style="xt" closed="false"><ref loc="LUK 12:36">Luq. 12:36</ref></char></note><verse eid="MRK 13:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 13:35"/>«Yey gishos, miinggoytta. Abis giiko, kara aday omathi maaqqo woy giddii bilahe maaqqo woy shugula uufo maaqqo woy wonttimaathe maaqqo ayide ye7odazako, yi erooya. <verse eid="MRK 13:35"/><verse number="36" style="v" sid="MRK 13:36"/>Yi akaakekkazin e yi7ii yinttan yi genttii yezin dengaamay garkk miinggoytta. <verse eid="MRK 13:36"/><verse number="37" style="v" sid="MRK 13:37"/>Ta yinttis odizan garkk as ubbas; miinggoytta» yeegeeza.<verse eid="MRK 13:37"/></para>
  <chapter eid="MRK 13"/>
  <chapter number="14" style="c" sid="MRK 14"/>
  <para style="s1">Kiristtoosal afa tobeeza</para>
  <para style="r">(<ref loc="MAT 26:1-5">Mat. 26:1-5</ref>; <ref loc="LUK 22:1-2">Luq. 22:1-2</ref>; <ref loc="JHN 11:45-53">Wan. 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1"/>Paaziqa Baale bonchchiza gallasnnee boora Baale bonchchiza gallas hellodayis nam77ii gallasii atteeza. Qeese halaqitaynnee higge asitamaaritay cubbotithar Yesuusana aykkii wodhiza oge koyiza.<note caller="-" style="x"><char style="xo" closed="false">14:1 </char><char style="xt" closed="false"><ref loc="EXO 12:1">Kes. 12:1</ref></char></note> <verse eid="MRK 14:1"/><verse number="2" style="v" sid="MRK 14:2"/>«Asay kachchi kesamay garkk Paaziqa bonchchiz gallas oothaamii» yeegeeza.<verse eid="MRK 14:2"/></para>
  <para style="s1">Yesuusana shitto tizheez astto</para>
  <para style="r">(<ref loc="MAT 26:6-13">Mat. 26:6-13</ref>; <ref loc="JHN 12:1-8">Wan. 12:1-8</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3"/>Yesuusa Bitaana katama borqqontto harger yez Simoona kara sibirel afa betteezin, pettii asita albasxirosa ginttiz bilgaaxe kunth narddoose ginttiz gaame al7o shitto ekkii ye7eeza. Ye bilgaaxato menthii shitta Yesuusa ommayil hul7eeza.<note caller="+" style="f"><char style="fr" closed="false">14:3 </char><char style="ft" closed="false">Albesxirose al7o shuchch koch</char></note><note caller="-" style="x"><char style="xo" closed="false">14:3 </char><char style="xt" closed="false"><ref loc="LUK 7:37">Luq. 7:37</ref></char></note><figure style="fig" alt="Alabaster jars" file="HK00142B.tif" size="span" ref="14:3">Albasxirose Bilgaaxe</figure> <verse eid="MRK 14:3"/><verse number="4" style="v" sid="MRK 14:4"/>Ye aqayid yez asaypp pettay pettay kacinttii, «Yha shittay cer iitizay abiso? <verse eid="MRK 14:4"/><verse number="5" style="v" sid="MRK 14:5"/>Yha shittana hayidzii xeet dinnare gate kessodaya<note caller="+" style="f"><char style="fr" closed="false">14:5 </char><char style="fqa" closed="false">Hayidzii xeet dinnare: </char><char style="ft" closed="false">Pettii asis laythar ciginttiza lo77o daamoozepp aadho maaqqiz miishe.</char></note> bayizii, miisha manqqitayis immadayis danda7inttizazin» yeegii fa ganccer wolla odintteeza. Yeezii, ye astto boreeza.<verse eid="MRK 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 14:6"/>Zin Yesuusa «Yha astto ashshoytta; izo abis waaythe? Iza taas lo77o baz ootheeza. <verse eid="MRK 14:6"/><verse number="7" style="v" sid="MRK 14:7"/>Manqqitay ubba wode yinttar yeza. Yi kozheez gallas ayidekka unttan maaddodayis danda7iza, zin ta ubba wode yinttar yezaamii.<note caller="-" style="x"><char style="xo" closed="false">14:7 </char><char style="xt" closed="false"><ref loc="NUM 15:11">Tay. 15:11</ref></char></note> <verse eid="MRK 14:7"/><verse number="8" style="v" sid="MRK 14:8"/>Iza paas danda7intteeay garkk ootheeza; ma tana moogos giigisodayis tiinatii shitto tizheeza. <verse eid="MRK 14:8"/><verse number="9" style="v" sid="MRK 14:9"/>Ta yinttis turo odiza; sa7a ubbayil Wonggile odinttiza abamaaqqikokka, asay izo hasayoday garkk yha iza ootheezay odinttoda» yeegeeza.<verse eid="MRK 14:9"/></para>
  <para style="s1">Yihuda Yesuusana aathii immadayis tobbeeza</para>
  <para style="r">(<ref loc="MAT 26:14-16">Mat. 26:14-16</ref>; <ref loc="LUK 22:3-6">Luq. 22:3-6</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10"/>Taphpho nam77ii tamaaritaypp pettay Asiqoroto Yihuda ginttinttizay Yesuusana qeese halaqitayis aathii immadayis unttiko yhanigeeza. <verse eid="MRK 14:10"/><verse number="11" style="v" sid="MRK 14:11"/>U yeya si7ii ufayttii, «Nu neesi miishe immada» yeegeez gishos; Yihuda Yesuusana aathii ingodayis giiga gallas koyeeza.<verse eid="MRK 14:11"/></para>
  <para style="s1">Yesuusa fa tamaaritayira Paaziqa meeza</para>
  <para style="r">(<ref loc="MAT 26:17-25">Mat. 26:17-25</ref>; <ref loc="LUK 22:7-14">Luq. 22:7-14</ref>, <ref loc="LUK 22:21-23">21-23</ref>; <ref loc="JHN 13:21-30">Wan. 13:21-30</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12"/>Boora Baale bonchchinttizaypp tiina gallas, Paaziqa katha maadayis dur shukkiza gallas Yesuusa tamaaritay eziko, «Paaziqa bonchchiza gallas ne maad katha nu aayid yhanigii makko?» gi oyceeza.<verse eid="MRK 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 14:13"/>Yesuusa fa tamaaritaypp nam7ita yhay garkk yeegii kiiteeza: «Katama yhanigoytta; yi yhammadar, otar haath tookkeez pettii athay yinttan helloda; eza kaalloytta. <verse eid="MRK 14:13"/><verse number="14" style="v" sid="MRK 14:14"/>E yhanigii geliza keethattii godayiko, ‹Asitamaaray neeko, Taanii ta tamaaritayir Paaziqa maadayis imathi keethii aba yenee? yeegeeza› yeegoytta. <verse eid="MRK 14:14"/><verse number="15" style="v" sid="MRK 14:15"/>Kara goday yinttan pooqeel afa hiixinttii giigii yez dalge kifile beezoda; ye aqayid makkoytta» yeegeeza. <figure style="fig" alt="Two-story house with steps to roof" file="LB00235B.tif" size="span" ref="14:15">Ayihude Keeth kara</figure><verse eid="MRK 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 14:16"/>Ye tamaaritay kezii, katama yhanigeeza; Yesuusa unttis odeezay garkk denggii, Paaziqa katha makkeeza.<verse eid="MRK 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17"/>Sa7a omathodar Yesuusa taphpho nam77ii tamaaritayir ye aqa yhanigeeza. <verse eid="MRK 14:17"/><verse number="18" style="v" sid="MRK 14:18"/>U bettii katha maadar, Yesuusa unttiko, «Ta yinttis turo odiza; yinttapp pettay taar miizay, tana aathii immada» yeegeeza.<note caller="-" style="x"><char style="xo" closed="false">14:18 </char><char style="xt" closed="false"><ref loc="PSA 41:9">Maz. 41:9</ref></char></note><verse eid="MRK 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19"/>E tamaaritay dagamii, fa ommas ommas, «Tuma tanashsha?» yeegii eza oyceeza.<verse eid="MRK 14:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 14:20"/>Yesuusa mahii, «Ye athay yi taphpho nam7itaypp petta; E taar wolla fil7o gancce kushe dakkizaya. <verse eid="MRK 14:20"/><verse number="21" style="v" sid="MRK 14:21"/>As Na7ay, geeshsha Maxaafayid yhayqqoda geezay garkk yhayqqoda, zin As Na7a, aathii ingiza atha eza ayye. Ye athay yelinttekka atteezako eesi lo77ozin» yeegeeza.<verse eid="MRK 14:21"/></para>
  <para style="s1">Goday kaho</para>
  <para style="r">(<ref loc="MAT 26:26-30">Mat. 26:26-30</ref>; <ref loc="LUK 22:14-20">Luq. 22:14-20</ref>; <ref loc="1CO 11:23-25">1 Qor. 11:23-25</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22"/>U maadar, Yesuusa boora ekkii, Xooss galateeza; ye boora baxxii, fa tamaaritayis ingittar, «Yashitte, yhay ta asho» yeegeeza.<verse eid="MRK 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 14:23"/>Xuu7a denthii, Xooss galatii, unttis ingin ubbitaykka ye xuu7aypp uzheeza. <verse eid="MRK 14:23"/><verse number="24" style="v" sid="MRK 14:24"/>Yesuusa, «Yhay gaame asayis goggiz oroth caaqo ta suuthii. <verse eid="MRK 14:24"/><verse number="25" style="v" sid="MRK 14:25"/>Ta yinttis turo odiza; taanii Xooss kaatetititha oroth woyine uzhod gallasay hellodi gatho maaqqii yha woyinaypp uzhaamii» yeegeeza.<verse eid="MRK 14:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26"/>Mazmuure yexxeezaypp guye Debre Zayite ambal afa kezeeza.<verse eid="MRK 14:26"/></para>
  <para style="s1">Phixiroosa kaddodana Yesuusa tiinatii odeeza</para>
  <para style="r">(<ref loc="MAT 26:31-35">Mat. 26:31-35</ref>; <ref loc="LUK 22:31-34">Luq. 22:31-34</ref>; <ref loc="JHN 13:36-38">Wan. 13:36-38</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27"/>Yesuusa unttiko, «Yi ubbitay tana olii ashshii laasii dhaboda;</para>
  <para style="q1" vid="MRK 14:27">« ‹Xoossii heenggizana shocoda,</para>
  <para style="q2" vid="MRK 14:27">duritay ubbay laalinttoda› yeeginttii xaafintteezay garkke.</para>
  <para style="m" vid="MRK 14:27">Yeegeeza.<note caller="-" style="x"><char style="xo" closed="false">14:27 </char><char style="xt" closed="false"><ref loc="NUM 13:7">Tay. 13:7</ref></char></note> <verse eid="MRK 14:27"/><verse number="28" style="v" sid="MRK 14:28"/>Zin ta yhayiqopp dendeezaypp guye yinttapp tiinatii Galila aadhoda» yeegeeza.<note caller="-" style="x"><char style="xo" closed="false">14:28 </char><char style="xt" closed="false"><ref loc="MAT 28:16">Mat. 28:16</ref></char></note><verse eid="MRK 14:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 14:29"/>Phixiroosa mahii, «U ubbitay nena olii ashshikokka, ta nena ashshaamii» yeegeeza.<verse eid="MRK 14:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 14:30"/>Yesuusa Phixiroosako, «Ta neesi turo odiza; yhayino qamma shugula nam7i tok uukkodaypp tiina ne tana hayidzii toke kaddoda» yeegeeza.<verse eid="MRK 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 14:31"/>Zin Phixiroosa tiinaasaypp miinthii, «Ta hara attozin, neer wolla yhayqqizakokka, nena kaddamii» yeegeeza. Yhankkitay ubbitaykka yey garkk geeza.<verse eid="MRK 14:31"/></para>
  <para style="s1">Yesuusa Geetesemaane kezii woosseeza</para>
  <para style="r">(<ref loc="MAT 26:36-46">Mat. 26:36-46</ref>; <ref loc="LUK 22:39-46">Luq. 22:39-46</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32"/>Yesuusa fa tamaaritayir Geetesemaane ginttiz aqo yhanigii; fa tamaaritayiko, «Ta Xoossa woossii maaqqod gatho yi yhaydda bettoytta» yeegeeza.<verse eid="MRK 14:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 14:33"/>Yesuusa Phixiroosa, Yayqqoobarannee Waannisa paar ekkii qiteeza; waayintteezannee un77intteeza. <verse eid="MRK 14:33"/><verse number="34" style="v" sid="MRK 14:34"/>Ma unttiko, «Ta shemppata yhayqqod gatho azaneeza, yhaydda gam7oyttannee; miinggoytta» yeegeeza.<verse eid="MRK 14:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 14:35"/>Xiqqa tiina shiiqii, sa7a xuggunii, danda7inttiza baz maaqqiko, ye waaya saatay paapp aadhoday garkk, Xooss woosseeza. <verse eid="MRK 14:35"/><verse number="36" style="v" sid="MRK 14:36"/>Ma, «Aabbo,<note caller="+" style="f"><char style="fr" closed="false">14:36 </char><char style="ft" closed="false">Abba: guussay armayike doonar ta adayyo guussii</char></note> abbabbo, ubba baz neesi danda7inttiza, yha waaye xuu7a taapp haasoba. Zin ne shene hanopp attin ta shene hanippee» yeegeeza.<verse eid="MRK 14:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37"/>Yesuusa maaqqii yi7ii, u gentteezin denggii, Phixiroosako, «Simoona, gentteenee? Hara atto ne pettii saatekka barkkii naagodayis danda7ekkasa? <verse eid="MRK 14:37"/><verse number="38" style="v" sid="MRK 14:38"/>Paace gancce yi gelaamay garkk barkkii naagoyttannee Xoossa miinggii woossoytta. Ayyanay, giigintteezin ashay daabura» yeegeeza.<verse eid="MRK 14:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39"/>Maakka yhanigii tiinaasay garkk Xoossa woosseeza. <verse eid="MRK 14:39"/><verse number="40" style="v" sid="MRK 14:40"/>Yhattekka e guye maaqqii unttiko ye7odar gentteezin denggeeza. U aafa gentta goozii gaddeez gishos eziko ab mahodazakokka erekkaya.<verse eid="MRK 14:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 14:41"/>Hayidzintho unttiko yi7ii, «Yhanno hellodayiskka genttallannee shemppol yenee? Yikkee, gidoda; saatat helleeza; bo7oytta! As Na7ay, nagaranchcho asayis aadhii inginttod woday helleeza. <verse eid="MRK 14:41"/><verse number="42" style="v" sid="MRK 14:42"/>Yikkee dendoytta yedhdhoytta; bo7oytta, tana aathii ingiza athay helleeza» yeegeeza.<verse eid="MRK 14:42"/></para>
  <para style="s1">Yesuusa fa morkkitay kushe aathii ingintteeza</para>
  <para style="r">(<ref loc="MAT 26:47-56">Mat. 26:47-56</ref>; <ref loc="LUK 22:47-53">Luq. 22:47-53</ref>; <ref loc="JHN 18:3-12">Wan. 18:3-12</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43"/>Yesuusa yeya haga ododar, e taphpho nam7i tamaaritaypp pettay, Yihuda, ellisii helleeza. Ma qeese halaqitay, higge asitamaaritaynnee cimitay kiittin, mashshannee gufe aykkeez gaame asay ezar wolla ye7eeza. <verse eid="MRK 14:43"/><verse number="44" style="v" sid="MRK 14:44"/>Yesuusana aathii ingoday ye gaame asayis, «Ta yeerizay eza; eza aykkii, lo7ithii naagii, ekkii kanggoytta» yeegii mala odii gaddeeza.<verse eid="MRK 14:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 14:45"/>Yihuda helleezan garkk Yesuusako shiiqii, «Asitamaarayyo» yeegii Yesuusa yeereeza. <verse eid="MRK 14:45"/><verse number="46" style="v" sid="MRK 14:46"/>Ye gaame asay Yesuusana aykkeeza. <verse eid="MRK 14:46"/><verse number="47" style="v" sid="MRK 14:47"/>E tamaaritaypp pettay fa mashsha shoddii qeese halaqay aylla shocii, e haytto qadhdhii oleeza.<verse eid="MRK 14:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 14:48"/>Yesuusa mahii, asayiko, «Yi Tana paanno aykkizay garkk aykkodayis mashshannee gufe aykkii ye7eenee? <verse eid="MRK 14:48"/><verse number="49" style="v" sid="MRK 14:49"/>Ta Xooss Kara gancce taamaristtar, gallas gallas yinttar yezin tana aykkekkazar, geeshsha Maxaafay geezay polinttodayis beeziza» yeegeeza.<note caller="-" style="x"><char style="xo" closed="false">14:49 </char><char style="xt" closed="false"><ref loc="LUK 19:47">Luq. 19:47</ref>; <ref loc="LUK 21:37">21:37</ref></char></note><verse eid="MRK 14:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 14:50"/>E tamaaritay ubbitay eza olii ashshii laasii dhabeeza.<verse eid="MRK 14:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51"/>Laxana aadda ma77eez pettii yelaga athay Yesuusa kaalo aykkeeza. <verse eid="MRK 14:51"/><verse number="52" style="v" sid="MRK 14:52"/>Zin ye athay laxana olii ashshii, xiira kallo laasii dhabeeza.<verse eid="MRK 14:52"/></para>
  <para style="s1">Yesuusana pirdde Shanggo tiina kanggeeza</para>
  <para style="r">(<ref loc="MAT 26:57-68">Mat. 26:57-68</ref>; <ref loc="LUK 22:54-55">Luq. 22:54-55</ref>, <ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:13-14">Wan. 18:13-14</ref>, <ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53"/>Asay Yesuusa qeese halaqay kara kanggeeza. Ezayid qeese halaqitay, cimitaynnee higge asitamaaritay shiiqii yeza. <verse eid="MRK 14:53"/><verse number="54" style="v" sid="MRK 14:54"/>Phixiroosa qeese halaqay zabba hellodayis haakor eza kaallii yhanigii ezayid naagizitayir bettii tama kazhiza.<verse eid="MRK 14:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="MRK 14:55"/>Qeese halaqitaynnee pirdde shanggitay ubbitay Yesuusa wodhodayis ezal afa markka koyeeza, zin abkka denggekkaya. <verse eid="MRK 14:55"/><verse number="56" style="v" sid="MRK 14:56"/>Gaame asay ezal afa worddo markkatteeza, zin u markkitethay pettii qaala baaya.<verse eid="MRK 14:56"/></para>
  <para style="p">
    <verse number="57-58" style="v" sid="MRK 14:57-58"/>Pettii pettii asitay dendii eqqii Yesuusal afa, «E, ‹Taanii asii keexxeez yha Xoossa Keeth laalii, asii kushe keexxinttekka hara Xooss Keethi hayidzii gallasa gancce keexxod› godar nu si7eeza» yeegii worddo markkatteeza.<note caller="-" style="x"><char style="xo" closed="false">14:58 </char><char style="xt" closed="false"><ref loc="JHN 2:19">Wan. 2:19</ref></char></note> <verse eid="MRK 14:57-58"/><verse number="59" style="v" sid="MRK 14:59"/>Maaqqozin, u markketithay petto baaya.<verse eid="MRK 14:59"/></para>
  <para style="p">
    <verse number="60" style="v" sid="MRK 14:60"/>Qeese halaqay as ubbitay tiinayid dendii eqqii, «Yhayttay nena mootiza mootayis ne mahizbaz baasa?» yeegii Yesuusana oyceeza. <verse eid="MRK 14:60"/><verse number="61" style="v" sid="MRK 14:61"/>Zin Yesuusa si77e geeza; abkka mahekkaya. Qeese halaqay, «Anjintteez Xooss Na7ay, Kiristtoosa nenannee?» yeegii mahii oyceeza.<verse eid="MRK 14:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="MRK 14:62"/>Yesuusa mahii, «E tana, yi As Na7ay, woliqqama Xoossapp ushachch baggar betteezininnee salo shaarar ye7odar be7ada» yeegeeza.<note caller="-" style="x"><char style="xo" closed="false">14:62 </char><char style="xt" closed="false"><ref loc="DAN 7:13">Daan. 7:13</ref></char></note><verse eid="MRK 14:62"/></para>
  <para style="p">
    <verse number="63" style="v" sid="MRK 14:63"/>Qeese halaqay shener fa afila peedhii, «Nuna hara ab markka koshshee? <verse eid="MRK 14:63"/><verse number="64" style="v" sid="MRK 14:64"/>Yi e cashsha si7eeza; yinttis ab aazee?» yeegeeza. Unttii ubbitay, «E yhayqqodayis beeziza» yeegii ezal afa pirddeeza.<note caller="-" style="x"><char style="xo" closed="false">14:64 </char><char style="xt" closed="false"><ref loc="LEV 24:15">Lewii. 24:15</ref></char></note><verse eid="MRK 14:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="MRK 14:65"/>Unttapp pettay pettay ezal afa cutii e aafa goolii zhultittar, «Nena yhadhdheezay oonoo? An nuus odoba!» yeegeeza. Naagizitay eza garafittar ekkii yhanigeeza.<verse eid="MRK 14:65"/></para>
  <para style="s1">Phixiroosa Yesuusana kaddeez</para>
  <para style="r">(<ref loc="MAT 26:69-75">Mat. 26:69-75</ref>; <ref loc="LUK 22:56-62">Luq. 22:56-62</ref>; <ref loc="JHN 18:15-18">Wan. 18:15-18</ref>, <ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66"/>Phixiroosa qeese halaqay zabbayid yeekk baggar yezin, qeese halaqay gadhindditaypp pettat ize ye7eeza. <verse eid="MRK 14:66"/><verse number="67" style="v" sid="MRK 14:67"/>Phixiroosa tama kazhodar iza dakkii bi7ii, «Neekka Naazirete Yesuusar yeza bay» yeegeeza.<verse eid="MRK 14:67"/></para>
  <para style="p">
    <verse number="68" style="v" sid="MRK 14:68"/>Zin Phixiroosa, «Ne gizay abizako ta erooya, taas akaakinttooya» yeegii kaadeeza. Yeegii maaqqii e bale kezeezan garkk shugula uukkeeza<note caller="+" style="f"><char style="fr" closed="false">14:68 </char><char style="ft" closed="false">Pettii pettii maxaafe shugula uukkeeza gizay baaya</char></note>.<verse eid="MRK 14:68"/></para>
  <para style="p">
    <verse number="69" style="v" sid="MRK 14:69"/>Ye gadhinddata Phixiroosa bi7ii, i lanqqe eqqeez asitayiko, «Yha aththaykka unttar yeza» gi mahii odeeza. <verse eid="MRK 14:69"/><verse number="70" style="v" sid="MRK 14:70"/>Zin Phixiroosa maakka kaadeeza.</para>
  <para style="p" vid="MRK 14:70">Xiqqa gam7odar, lanqqe eqqeez asitay maakka Phixiroosako, «Ne Galila biitta as maaqqeez gishos tuma unttar yeza» yeegeeza.<verse eid="MRK 14:70"/></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71"/>Zin Phixiroosa, «Ta yi giz atha erooya!» yeegii fana baaddithnnee caaqo aykkeeza.<verse eid="MRK 14:71"/></para>
  <para style="p">
    <verse number="72" style="v" sid="MRK 14:72"/>Izir shugula nam7intho uukkeeza. Phixiroosa Yesuusa eziko, «Ne shugula nam77ii tok uukkodaypp tiina hayidzii tok tana kaddoda» eziko geezay elqqi gin yeekkeeza.<verse eid="MRK 14:72"/></para>
  <chapter eid="MRK 14"/>
  <chapter number="15" style="c" sid="MRK 15"/>
  <para style="s1">Yesuusana Philaaxoosako kanggeeza</para>
  <para style="r">(<ref loc="MAT 27:1-2">Mat. 27:1-2</ref>, <ref loc="MAT 27:11-14">11-14</ref>; <ref loc="LUK 23:1-5">Luq. 23:1-5</ref>; <ref loc="JHN 18:28-38">Wan. 18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1"/>Wontt guur ellisii qeese halaqitay, cimitay, higge asitamaaritaynnee Pirdde shanggo ubbitay shiiqii tobbeeza. U Yesuusana accii kanggii Philaaxoosas aathii inggeeza.<verse eid="MRK 15:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 15:2"/>Philaaxoosa eziko, «Ne Ayihuditayis kaato?» yeegii oyceeza.</para>
  <para style="p" vid="MRK 15:2">Yesuusa mahii, «Ne geeza» yeegeeza.<verse eid="MRK 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3"/>Qeese halaqitay Yesuusana gaame baza mooteeza. <verse eid="MRK 15:3"/><verse number="4" style="v" sid="MRK 15:4"/>Zin Philaaxoosa mahii Yesuusako, «Nees mahizbaz baasa? U neell afa ab garkk mooto ki7izako be7aamo?» yeegeeza.<verse eid="MRK 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 15:5"/>Zin Yesuusa hara baz mahaam ixxin, Philaaxoosa malabaz geeza.<verse eid="MRK 15:5"/></para>
  <para style="s1">Yesuusana yhayqqo gi pirddeeza</para>
  <para style="r">(<ref loc="MAT 27:15-26">Mat. 27:15-26</ref>; <ref loc="LUK 23:13-25">Luq. 23:13-25</ref>; <ref loc="JHN 18:39-40">Wan. 18:39-40</ref>; <ref loc="JHN 19:1-16">19:1-16</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6"/>Philaaxoosas Paaziqa Baale bonchchiza gallas asitay koyiz pettii atha achchapp bili7iz woga yeza. <verse eid="MRK 15:6"/><verse number="7" style="v" sid="MRK 15:7"/>Ye wode pettii Bairbaana giz athay daafa kessii shemppo wodhdheez asitayir wolla achch kara yeza. <verse eid="MRK 15:7"/><verse number="8" style="v" sid="MRK 15:8"/>Gaame asitay Philaaxoosak yi7ii kaseesay garkk oothod garkk eza oyceeza. <verse eid="MRK 15:8"/><verse number="9" style="v" sid="MRK 15:9"/>Philaaxoosa asana mahii, «Ta yinttis Ayihuditay kaata bili7odana koynee?» yeegii oyceeza. <verse eid="MRK 15:9"/><verse number="10" style="v" sid="MRK 15:10"/>Yha e geezay, qeese halaqitay Yesuusa qinaate aathii inggeezana eriz gishosii.<verse eid="MRK 15:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 15:11"/>Zin qeese halaqitay Bairbaana billoday garkk, ye shiiqeez asitay Philaaxoosa woossoday garkk asita denthitheeza. <verse eid="MRK 15:11"/><verse number="12" style="v" sid="MRK 15:12"/>Philaaxoosa mahii, «Yeezin, yi Ayihude kaate gizana wayisaday garkk koyee?» yeegeeza.<verse eid="MRK 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 15:13"/>Asitay Philaaxoosal afa uukkii, «Mazqalel afa eza sottoba» yeegeeza.<verse eid="MRK 15:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 15:14"/>Philaaxoosa asayiko, «Abiso? e ab iita baz ootheenee?» yeegeeza.</para>
  <para style="p" vid="MRK 15:14">Zin asay tiinaasaypp gujjii uukkii, «Mazqalel afa eza sottoba» yeegeeza.<verse eid="MRK 15:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 15:15"/>Philaaxoosa asa ufayssodayis koyii, Bairbaana asayis bili7eeza; yeypp Yesuusana alanggii, mazqalel afa sottoday garkk aathii inggeeza.<verse eid="MRK 15:15"/></para>
  <para style="s1">Wottaaddaritay Yesuusana toochcheeza</para>
  <para style="r">(<ref loc="MAT 27:27-31">Mat. 27:27-31</ref>; <ref loc="JHN 19:2-3">Wan. 19:2-3</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16"/>Yeypp guye, wottaaddaritay Yesuusa Praytoora ginttiz wottaddartay zabba ekkii kanggii, hara wottaaddarita ubba xeegiseeza. <verse eid="MRK 15:16"/><verse number="17" style="v" sid="MRK 15:17"/>Ma zoqo afila eza ma7iseeza; angguthi zawude kochchii, e ommayid gaddeeza. <verse eid="MRK 15:17"/><verse number="18" style="v" sid="MRK 15:18"/>Yeypp guye, eziko, «Ayihuditay kaatayyo saro» yeegii, ees kushe dentheeza. <verse eid="MRK 15:18"/><verse number="19" style="v" sid="MRK 15:19"/>E ommayid gufer shoceeza; ma ezal afa cutteeza; xuggunii eesi goynneeza. <verse eid="MRK 15:19"/><verse number="20" style="v" sid="MRK 15:20"/>Eza leqqeezaypp guye zoqo afila eepp qaarii ekkii, e afila eza ma7isi mazqalel afa eza sottodayis ekkii kanggeeza.<verse eid="MRK 15:20"/></para>
  <para style="s1">Yesuusana sotteeza</para>
  <para style="r">(<ref loc="MAT 27:32-44">Mat. 27:32-44</ref>; <ref loc="LUK 23:26-43">Luq. 23:26-43</ref>; <ref loc="JHN 19:17-27">Wan. 19:17-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21"/>U yhanigttar, Iskkinddirerannee Rufoosa ada, Simoona giz Qerena gade as, gaxarepp katama yi7izana hellii, Yesuusa mazqalana wolqqanthii toosseeza.<note caller="-" style="x"><char style="xo" closed="false">15:21 </char><char style="xt" closed="false"><ref loc="ROM 16:13">Oro. 16:13</ref></char></note> <verse eid="MRK 15:21"/><verse number="22" style="v" sid="MRK 15:22"/>Yeezii Golggotta giz aqo Yesuusa kanggeeza. «Golggotta» guussay «Omma ota» guussii. <verse eid="MRK 15:22"/><verse number="23" style="v" sid="MRK 15:23"/>Karbe giz dhaler walakintteez woyine uzho gi ees inggeeza. Zin e uzhaam ixxeeza. <verse eid="MRK 15:23"/><verse number="24" style="v" sid="MRK 15:24"/>U mazqalel afa eza sotteezaypp guye oona abii hellodazako gi e afilayil wolla ixa olii shaginttii ekkeeza.<verse eid="MRK 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 15:25"/>U mazqalel afa eza sottodar wonttapp hayidzii saate. <verse eid="MRK 15:25"/><verse number="26" style="v" sid="MRK 15:26"/>Unttii, «Ayihuditay kaata» yeegii eza mootiza xuufe xaafii gaddeeza. <verse eid="MRK 15:26"/><verse number="27" style="v" sid="MRK 15:27"/>Yesuusar nam77ii paannita petta ezpp ushachch baggar yhankka ezpp haddirss baggar mazqalel afa sotteeza. <verse eid="MRK 15:27"/><verse number="28" style="v" sid="MRK 15:28"/>Geeshsha Maxaafe, «Iita baz ootheez asitayir e tayibintteeza» yeegintteezay polintteeza.<note caller="+" style="f"><char style="fr" closed="false">15:27-28 </char><char style="ft" closed="false">Isa. 53:12 Binii kusher xaafintteez maxaafitayid yha quxuray baaya</char></note><verse eid="MRK 15:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 15:29"/>Oger aadhiz asay Yesuusa toochchii, fa omma eni7isii cazheeza; «Yeezin! Xooss kara laalii hayidzii gallasa gancce keexxizayyo,<note caller="-" style="x"><char style="xo" closed="false">15:29 </char><char style="xt" closed="false"><ref loc="PSA 22:7">Maz. 22:7</ref>; <ref loc="PSA 109:25">109:25</ref>; <ref loc="MRK 14:58">Mar. 14:58</ref>; <ref loc="JHN 2:19">Wan. 2:19</ref></char></note> <verse eid="MRK 15:29"/><verse number="30" style="v" sid="MRK 15:30"/>an mazqalaypp sulle wodhdhii nena ashshoba» yeegeeza.<verse eid="MRK 15:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 15:31"/>Yey garkkekka, qeese halaqitay higge tamaarssizitayir wolla Yesuusa toochchii «Yhankkita ashsheeza, zin fana ashshodayis danda7ooya; <verse eid="MRK 15:31"/><verse number="32" style="v" sid="MRK 15:32"/>nu bi7ii ammanod garkk Kiristtoosa, e Isreele Kaatizako, an mazqalaypp yhatti wodhdho» yeegeeza. Ma hara attozin, ezar mazqalel afa sotintteezitaykka eza toochcheeza.<verse eid="MRK 15:32"/></para>
  <para style="s1">Yesuusa yhayiqo</para>
  <para style="r">(<ref loc="MAT 27:45-56">Mat. 27:45-56</ref>; <ref loc="LUK 23:44-49">Luq. 23:44-49</ref>; <ref loc="JHN 19:28-30">Wan. 19:28-30</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33"/>Usuppun saatepp aykkii, uddufun saate hellodayis biitta ubbay dhumeeza. <verse eid="MRK 15:33"/><verse number="34" style="v" sid="MRK 15:34"/>Uddufun saatel Yesuusa fa qaala dhoqqi udii, «Elohee, Elohee, laama sabaqitanii?» yeegii uukkeeza. Yeya guussay, «Ta Xoossayyo, ta Xoossayyo, tana abis ashsheene?» guussii.<note caller="-" style="x"><char style="xo" closed="false">15:34 </char><char style="xt" closed="false"><ref loc="PSA 22:1">Maz. 22:1</ref></char></note><verse eid="MRK 15:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35"/>Ya aqayid eqqeez asaypp pettay pettay yeya si7ii, «Yeezako, Eelaasa xeegiza» yeegeeza. <verse eid="MRK 15:35"/><verse number="36" style="v" sid="MRK 15:36"/>Ye asaypp pettay laasii, zanizar caala woyine kunth; gufe xeeral gaddii, «Naagoytta; Eelaasa mazqalaypp eza wothodayis ye7odazako an wolla be7ada» yeegii Yesuusa doonayiko ushshodayis shiisheeza.<note caller="-" style="x"><char style="xo" closed="false">15:36 </char><char style="xt" closed="false"><ref loc="PSA 69:21">Maz. 69:21</ref></char></note><verse eid="MRK 15:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 15:37"/>Yesuusa fa qaala dhoqqi udii uukkii, yhayqqeeza.<verse eid="MRK 15:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 15:38"/>Xooss kara sotintteez magarazhay afapp sa7a hellodayis, nam7i kezii per7inttii wodhdheeza.<note caller="-" style="x"><char style="xo" closed="false">15:38 </char><char style="xt" closed="false"><ref loc="EXO 26:31">Kes. 26:31</ref></char></note> <verse eid="MRK 15:38"/><verse number="39" style="v" sid="MRK 15:39"/>Mazqalaypp tiina baggar ezayid eqqeez pettii mato halaqay, Yesuusa wayizii yhayqqeezako bi7ii «yha athay tuma Xooss Na7a» yeegeeza.<verse eid="MRK 15:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40"/>Ya haakor eqqii bi7iza maachchitay yeza. U gancce Magdeela Mayirama, geedo na7a Yayqqoobasinnee Yoosa indat Mayramirannee Saloomira yeza. <verse eid="MRK 15:40"/><verse number="41" style="v" sid="MRK 15:41"/>Ye maachch asitay Yesuusa Galila biitta yez wode eza kaallezitannee eza mokkeezita. Ma Yesuusar wolla Yerusalaame yhanigeez hara gaame maachchi asitay ezayid yeza.<note caller="-" style="x"><char style="xo" closed="false">15:40-41 </char><char style="xt" closed="false"><ref loc="LUK 8:2-3">Luq. 8:2-3</ref></char></note><verse eid="MRK 15:41"/></para>
  <para style="s1">Yesuusa moogintteeza</para>
  <para style="r">(<ref loc="MAT 27:57-61">Mat. 27:57-61</ref>; <ref loc="LUK 23:50-56">Luq. 23:50-56</ref>; <ref loc="JHN 19:38-42">Wan. 19:38-42</ref>)</para>
  <para style="p">
    <verse number="42-43" style="v" sid="MRK 15:42-43"/>Sa7ay omarsseez gishos shiiqeez asay gancce bonchchintteez Ayihude shanggitaypp pettay, Yooseefa giz athay, Xooss kaatetithay ye7oda giittar yezay, Armmatasa katama asay ye7eeza. Wonttitha mala wonttiza gallas maaqqeez gisho Yooseefa miinggii Philaaxoosak yhanigii, Yesuusa aha ekkodayis woosseeza. <verse eid="MRK 15:42-43"/><verse number="44" style="v" sid="MRK 15:44"/>Philaaxoosakka Yesuusa yhayiqa si7ii malabaz geeza; mato halaqa xeegii, «E yhayqqii gam7eenenee?» yeegii oyceeza. <verse eid="MRK 15:44"/><verse number="45" style="v" sid="MRK 15:45"/>Philaaxoosa Yesuusa yhayiqa mato halaqaypp si7ii e aha Yooseefas inggeeza. <verse eid="MRK 15:45"/><verse number="46" style="v" sid="MRK 15:46"/>Yooseefa moogo afila wonggii; Yesuusa aha mazqalaypp wothii, afilar xaaxii, zaallapp woocintteez duufo gancce moogeeza. Ma ye duufay doonayid damma shuchch goli7isii gaddeeza. <verse eid="MRK 15:46"/><verse number="47" style="v" sid="MRK 15:47"/>Magdeela Mayiramira Yoosa indat Mayiramira Yesuusa aha unttii aba gaddizako bi7iza.<verse eid="MRK 15:47"/></para>
  <chapter eid="MRK 15"/>
  <chapter number="16" style="c" sid="MRK 16"/>
  <para style="s1">Yesuusa yhayiqopp dendeeza</para>
  <para style="r">(<ref loc="MAT 28:1-8">Mat. 28:1-8</ref>; <ref loc="LUK 24:1-12">Luq. 24:1-12</ref>; <ref loc="JHN 20:1-10">Wan. 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1"/>Maala gallasay aadheezaypp guye Magdeelawe Mayramo, Yayqqooba indat Mayramannee Saloome yhanigii, Yesuusa aha tizhodayis shitto wonggeeza. <verse eid="MRK 16:1"/><verse number="2" style="v" sid="MRK 16:2"/>Wogga gallas guura zherkkizherkko xalqqe kezodar, duufo yhanigeeza. <verse eid="MRK 16:2"/><verse number="3" style="v" sid="MRK 16:3"/>U fa gancce pettatii pettatira, «Duufay doonapp nuus shuchch oonoo gol7isii haasoday?» yeegii wolla odintteeza.<verse eid="MRK 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 16:4"/>U be7adar ye damm atteez shuchchay goli7alii hali7eezana be7eeza. <verse eid="MRK 16:4"/><verse number="5" style="v" sid="MRK 16:5"/>Yesuusa moogintteez duufay gancce gelodar pettii yelaga athay booth afila ma77ii, ushachch baggar betteezana bi7ii dagammeeza.<verse eid="MRK 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 16:6"/>Zin E unttiko, «Dagammippate; mazqalel afa sotintteez, Naazirete Yesuusa yi koyizana ta eriza. E yhaydd baaya, yhayqqopp dendeeza. U eza moogeez aqa yhaya bo7oytta. <verse eid="MRK 16:6"/><verse number="7" style="v" sid="MRK 16:7"/>Yhatti yhanigii Yesuusa tamaaritayisnnee Phixiroosas, ‹Yesuusa yinttapp tiinatii Galila aadhiza. E yinttis odeezay garkk yi eza ezayid be7ada› yeegii odoytta» yeegeeza.<note caller="-" style="x"><char style="xo" closed="false">16:7 </char><char style="xt" closed="false"><ref loc="MAT 26:32">Mat. 26:32</ref>; <ref loc="MRK 14:28">Mar. 14:28</ref></char></note><verse eid="MRK 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8"/>Maachchitay yashshar kukkurttar duufaypp kezii laasii qiteeza. Ma u yashitteez gishos yeya ooskka abikka odekkaya.<note caller="+" style="f"><char style="fr" closed="false">16:8 </char><char style="ft" closed="false">Pettii pettii binii maxaafitay Marqqoosa Wongile tayibo 8nal afa essiza. Ma pettii pettii maxaafitay tayibo 9-20 hellodayis yez qofana gujjooya. Maaqqozin, tayibo 8 kaali yezana gujjiza. Yeykka [Maachchitay yhanigii, kiitanchchay odeez baz ubba Phixiroosasinnee ezar yezitayis qaanthar odeeza. Yeypp guye, Yesuusa fa taamarita geeshshinnee medhinas ashshiza Wonggile kiita awa kessapp awa gelo hellodayis azazeeza]</char></note><verse eid="MRK 16:8"/></para>
  <para style="s1">Yesuusa Magdeela Mayramis bentteeza</para>
  <para style="r">(<ref loc="MAT 28:9-10">Mat. 28:9-10</ref>; <ref loc="JHN 20:11-18">Wan. 20:11-18</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9"/>Yesuusa yhayqqopp dendeezaypp guye wogga gallas guura, laappun tuna ayyanita izpp e kesseez Magdeela Mayramis tiinatii bentteeza. <verse eid="MRK 16:9"/><verse number="10" style="v" sid="MRK 16:10"/>Iza yhanigii tiina ezar yezitayis, u azanttarannee yeekkittar yezin odeeza. <verse eid="MRK 16:10"/><verse number="11" style="v" sid="MRK 16:11"/>Zin Yesuusa pathi yezanannee izis bentteezana u si7eez wode iza giza ammanekkaya.<verse eid="MRK 16:11"/></para>
  <para style="s1">Yesuusa fa nam7i tamaaritayis bentteeza</para>
  <para style="r">(<ref loc="LUK 24:13-35">Luq. 24:13-35</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12"/>Yeypp guye, unttapp nam7itay katamapp kezii yhammadar, ogella Yesuusa tiinaasaypp dummatii unttis bentteeza. <verse eid="MRK 16:12"/><verse number="13" style="v" sid="MRK 16:13"/>U guye maaqqii, hara asayis odeeza, Zin hara asaykka u oda tuma geekkaya.<verse eid="MRK 16:13"/></para>
  <para style="s1">Yesuusa fa taphpho pettii tamaaritayis bentteeza</para>
  <para style="r">(<ref loc="MAT 28:16-20">Mat. 28:16-20</ref>; <ref loc="LUK 24:36-49">Luq. 24:36-49</ref>; <ref loc="JHN 20:19-23">Wan. 20:19-23</ref>; <ref loc="ACT 1:6-8">Haw. O. 1:6-8</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14"/>Guyepp taphpho pettii e tamaaritay katha maadar, Yesuusa unttis bentteeza. Unttis ammano baazay gishonnee yhayiqopp e dendeezana be7eez asay odin u ammanaam ixxeezayis e unttan boreeza.<verse eid="MRK 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 16:15"/>E unttiko, «Biitta ubbayil yhanigii as ubbayis Wongile odoytta.<note caller="-" style="x"><char style="xo" closed="false">16:15 </char><char style="xt" closed="false"><ref loc="ACT 1:8">Haw. O. 1:8</ref></char></note> <verse eid="MRK 16:15"/><verse number="16" style="v" sid="MRK 16:16"/>Ammaneezaynnee xammaqintteezay attoda, zin ammanekkazay pirddinttoda. <verse eid="MRK 16:16"/><verse number="17" style="v" sid="MRK 16:17"/>Ammanizitayis yha malatitay inginttoda. U ta sunthayir tuna ayyanita kessoda, oroth doona nashshoda. <verse eid="MRK 16:17"/><verse number="18" style="v" sid="MRK 16:18"/>U shoosh aykkiko woy wodhiza baz uzhikokka unttan qohaamii. Ma u fa kushe hargintteezitayil afa gaddii unttan pathoda» yeegeeza.<verse eid="MRK 16:18"/></para>
  <para style="s1">Yesuusa pude dendii salo kezeeza</para>
  <para style="r">(<ref loc="LUK 24:50-53">Luq. 24:50-53</ref>; <ref loc="ACT 1:9-11">Haw. O. 1:9-11</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19"/>Goda Yesuusa tamaaritayira nashsheezaypp guye pude dendii salo kezeeza; Xoossapp ushachch baggar betteeza.<note caller="-" style="x"><char style="xo" closed="false">16:19 </char><char style="xt" closed="false"><ref loc="ACT 1:9">Haw. O. 1:9</ref></char></note> <verse eid="MRK 16:19"/><verse number="20" style="v" sid="MRK 16:20"/>E tamaaritay yhanigeez aqo ubbayid qaala odeeza. Godaykka unttar wolla oothiza. U odiza qaalay tuma maaqqeeza Xoossay unttisi ingiza mallayir fa qaala miintheeza.<verse eid="MRK 16:20"/></para>
  <chapter eid="MRK 16"/>
</usx>
