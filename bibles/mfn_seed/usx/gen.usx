<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="GEN" style="id">- Mbembe Osopong [MFNOs]</book>
  <para style="h">Ichedendik</para>
  <para style="toc1">Nnwẹr s'Ichedendik</para>
  <para style="toc2">Ichedendik</para>
  <para style="mt1">Nnwẹr s'Ichedendik</para>
  <chapter number="1" style="c" sid="GEN 1" />
  <para style="s1">Ẹtạma ch'ọyagbin</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 1:1" />K'ẹtạma, Ubinọkpaabyi usi ẹrạng ọttạra isek. <verse eid="GEN 1:1" /><verse number="2" style="v" sid="GEN 1:2" />Ma okpe ngwọ, ọttọhk vạnọ-vạnọ kòde, ọyagbin uning idwukhu, ibyi sidede ipyi irungu <char style="it">bẹ́ kkạng</char>, ibạra ide asi-asi. Iguguma s'Ubinọkpaabyi wa n'isenga ibaabha ma k'asi mbọ.<verse eid="GEN 1:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="GEN 1:3" />Ma wọ Ubinọkpaabyi obeni bẹ́, “Tte ọyaanttaana uninga.” Ọyaanttaana uninga. <verse eid="GEN 1:3" /><verse number="4" style="v" sid="GEN 1:4" />Ubinọkpaabyi ukwu ose bẹ́, ọyaanttaana kk'ujibha, Ubinọkpaabyi ọbhaangẹ ọyaanttaana k'urungubạnga. <verse eid="GEN 1:4" /><verse number="5" style="v" sid="GEN 1:5" />Ma wọ Ubinọkpaabyi oyeri ọyaanttaana nwọ, ẹya, ọbạra oyeri urungubạnga, irungu. Wa ekpebha ọttạra ẹchọhkha bọ asi echedenwu.<verse eid="GEN 1:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="GEN 1:6" />Ubinọkpaabyi oben bẹ́, “Tte ẹkpẹkpa iyin k'ottemkwẹ kw'asi. Tte ẹbhaangẹ asi p'ẹrạng ọttạra asi p'isekh-isek.” <verse eid="GEN 1:6" /><verse number="7" style="v" sid="GEN 1:7" />Ma wọ Ubinọkpaabyi usi ẹkpẹkpa ẹbhaangẹ asi. Asi bạnọ aning k'akpaang k'ẹrạng, mbọkha aninga k'isekh-isek. Akwẹ ode oche ngwọ. <verse eid="GEN 1:7" /><verse number="8" style="v" sid="GEN 1:8" />Ubinọkpaabyi oyeri ẹrạng, akpaang. Wa ekpebha ọttạra ẹchọhkha bọ asi ottonga iwu ifa.<verse eid="GEN 1:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="GEN 1:9" />Ubinọkpaabyi ọbạra oben bẹ́, “Tte asi p'aning k'akpaang isekhisek atobha ibyi rạnẹ, ọfha igbin iyin.” Akwẹ ode oche ngwọ. <verse eid="GEN 1:9" /><verse number="10" style="v" sid="GEN 1:10" />Ubinọkpaabyi oyeri isek, igbin, ọbạra oyeri asi p'atobh ibyi rạnẹ, araanga-diden. Ubinọkpaabyi ose bẹ́, kk'ujibha.<verse eid="GEN 1:10" /></para>
  <para style="pi">
    <verse number="11" style="v" sid="GEN 1:11" />Ubinọkpaabyi oben bẹ́, “Tte isek imen ekpo k'akhira k'akhira: asạsaarẹ p'n'ayạm amạma p'm'amen k'ukhira kwabẹ, ọttạra nchi s'n'iyạm adwuk p'akhaam amạma pabẹ, k'oche kw'ukhira kwabẹ ode.” Akwẹ ode oche ngwọ. <verse eid="GEN 1:11" /><verse number="12" style="v" sid="GEN 1:12" />Isisek imen asạsaarẹ k'akhira-k'akhira: asạsaarẹ p'n'ayạm amạma p'abin k'amạma pabẹ oyeni, ọttạra nchi s'n'iyạm adwuk p'abin k'amạma p'achidwuk pabẹ oyeni. Ubinọkpaabyi ose bẹ́, kk'ujibha. <verse eid="GEN 1:12" /><verse number="13" style="v" sid="GEN 1:13" />Wa ekpebha ọttạra ẹchọhkha bọ asi ittonga iwu ittaan.<verse eid="GEN 1:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="GEN 1:14" />Ubinọkpaabyi oben bẹ́, “Tte mkpon ininga k'akpaang s'm'ibhaangẹ ẹya ọttạra irungu, tte asẹ ide ẹkhọhkha ch'okpe kw'erobha, ọttạra iwu, ọttạra icho. <verse eid="GEN 1:14" /><verse number="15" style="v" sid="GEN 1:15" />Tte mkpon nnọ imaanẹ k'akpaang, ọfha asẹ inạng ọyaanttaana k'ọyagbin.” Akwẹ ode oche ngwọ. <verse eid="GEN 1:15" /><verse number="16" style="v" sid="GEN 1:16" />Ubinọkpaabyi usi mkpon mfa sididen. Wa usi ch'ẹbạr-ọbạr bẹ́, ekkeri ẹya, ọttạra ch'ẹsạkh-ọsạkha bẹ́, ekkeri irungu. Wa ọbạra usi ndudoru. <verse eid="GEN 1:16" /><verse number="17" style="v" sid="GEN 1:17" />Ubinọkpaabyi ochokhu sẹ bẹ́, asẹ ininga k'ọrạngkpaang n'inạng ọyaanttaana k'ọyagbin, <verse eid="GEN 1:17" /><verse number="18" style="v" sid="GEN 1:18" />ọttạra bẹ́, asẹ n'ikkeri ẹya ọttạra urungubạnga, ọttạra bẹ́, asẹ n'ibhaangẹ ọyantaana k'urungubạnga. Ubinọkpaabyi ose bẹ́, kk'ujibha. <verse eid="GEN 1:18" /><verse number="19" style="v" sid="GEN 1:19" />Ẹchọhkha ọttạra ekpebha bọ asi ottonga iwu innebung.<verse eid="GEN 1:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="GEN 1:20" />Ubinọkpaabyi ọbạra oben bẹ́, “Tte asi afu ọttạra nten k'akhira-k'akhira s'ikhaangkẹ isaabh-ọsaabh, s'ining akpen, tte ọnọhn f'ẹrạng ukwur k'iyokhu s'akpaang.” <verse eid="GEN 1:20" /><verse number="21" style="v" sid="GEN 1:21" />Mạnna wọ Ubinọkpaabyi oyokhu nten sididen s'asi, ọttạra ọttọhk fidede f'urukhu akpen, f'n'ọbạra osenga k'asi, ọttạra ọnọhn k'ukhira-k'ukhira. Ubinọkpaabyi ose bẹ́, kk'ujibha. <verse eid="GEN 1:21" /><verse number="22" style="v" sid="GEN 1:22" />Ubinọkpaabyi odo nten nnọ s'kk'usia <char style="it">bẹ́ phyibh</char>, oben bẹ́, “Amaan ayok k'ọsaabh, abạra afu abaabha asi p'araanga-diden. Tte ọnọhn ọsaabh k'ọyagbin.” <verse eid="GEN 1:22" /><verse number="23" style="v" sid="GEN 1:23" />Ẹkpebha ọttạra ẹchọhkha bọ asi ottonga iwu isen.<verse eid="GEN 1:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="GEN 1:24" />Ubinọkpaabyi ọbạra oben bẹ́, “Tte isisek itima nten k'abẹ k'ukhira iyin: nten s'oter, ọttạra nten s'n'isenga k'isisek, ọttạra mkpaten, k'ukhira kwabẹ.” Akwẹ ode oche ngwọ. <verse eid="GEN 1:24" /><verse number="25" style="v" sid="GEN 1:25" />Mạnna wọ Ubinọkpaabyi usi mkpaten, ọttạra nten s'oter otor k'ukhira kwabẹ, ọttạra nten s'n'isenga k'isisek phyi-phyibh k'ukhira kwabẹ. Ubinọkpaabyi ose bẹ́, kk'ujibha.<verse eid="GEN 1:25" /></para>
  <para style="pi">
    <verse number="26" style="v" sid="GEN 1:26" />Ma o, Ubinọkpaabyi oben bẹ́, “Tte amạna ansi ayokhanạng p'm'ade masẹ amạna mba, p'akheri amạna mba oyeni. Tte abẹ akhaama ẹfa ch'm'akkeri nten s'asi, ọttạra ọnọhn f'ẹrạng, ọttạra nten s'oter, ọttạra mkpaten, ọttạra ekpo phyi-phyibh py'n'esenga k'isisek.”<verse eid="GEN 1:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="GEN 1:27" />Mạnna wọ wa Ubinọkpaabyi oyokhu ayokhanạng akhera ẹma oyeni,</para>
  <para style="q2" vid="GEN 1:27">oyokhu bẹ akhera Ubinọkpaabyi.</para>
  <para style="q2" vid="GEN 1:27">Wa oyokhu bẹ ujunung ọttạra ikwanạng.<verse eid="GEN 1:27" /></para>
  <para style="pi">
    <verse number="28" style="v" sid="GEN 1:28" />Ubinọkpaabyi odo bẹ, oben bẹ bẹ́, “Abạnga amaan ayok k'ọsaabh, tte iva pabạnga afu abaabha ọyagbin ọttạra nten s'asi, ọttạra ọnọhn f'ẹrạng, ọttạra ọttọhk fidede f'urukhu akpen, f'n'ọbạra osenga k'isisek.”<verse eid="GEN 1:28" /></para>
  <para style="pi">
    <verse number="29" style="v" sid="GEN 1:29" />Ma wọ Ubinọkpaabyi obeni bẹ bẹ́, “Akkeri, kk'bạnga achidwuk ọttạra achimạma py'idede p'aning k'isisek nnạnga, ọttạra nchi phyi-phyibh s'n'iyạm adwuk p'amạma aning k'ẹtaanga bẹ́, asẹ ide uchiattọhk fabạnga. <verse eid="GEN 1:29" /><verse number="30" style="v" sid="GEN 1:30" />Oseng nten phyibh s'irukhu akpen k'isek, ọttạra ọnọhn phyibh, ọttạra ọttọhk fidede f'n'osenga k'isisek, f'ọbạra urukhu akpen, kk'bẹ akwongutọhng p'ẹkpa nnạnga bẹ́, abẹ achi masẹ uchiattọhk fabẹ.” Akwẹ ode oche ngwọ.<verse eid="GEN 1:30" /></para>
  <para style="pi">
    <verse number="31" style="v" sid="GEN 1:31" />Wa Ubinọkpaabyi ose bẹ́, ọttọhk fidede f'kk'usia ujibhi oseng eden. Wa ekpebha ọttạra ẹchọhkha bọ asi ottonga iwu isajạnẹ.<verse eid="GEN 1:31" /></para>
  <chapter eid="GEN 1" />
  <chapter number="2" style="c" sid="GEN 2" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 2:1" />Wa Ubinọkpaabyi okker ọtọhm f'ẹrạng ọttạra f'isek sisi, ọttạra ọttọhk fidede f'uning k'ẹtaanga kwabẹ.<verse eid="GEN 2:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="GEN 2:2" />Ottong iwu isenọfa, Ubinọkpaabyi okwok ọyọhng k'ọtọhm f'kk'usia. <verse eid="GEN 2:2" /><verse number="3" style="v" sid="GEN 2:3" />Ubinọkpaabyi odo iwu ch'ettong isenọfa, ochok chẹ masẹ iwu ch'awurada, ukwuru bẹ́, ma iwu njọ jọ ch'okwok ọyọhng k'ọtọhm f'ọyagbin sisi.<verse eid="GEN 2:3" /></para>
  <para style="s">Oche kw'uwa Ubinọkpaabyi usi achedennạng</para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 2:4" />Maa wọ ode oche kw'uwa Ọvaar Ubinọkpaabyi usi ẹrạng ọttạra isek.</para>
  <para style="b" vid="GEN 2:4" />
  <para style="p" vid="GEN 2:4">K'okpe kw'Ọvaar Ubinọkpaabyi usi ẹrạng ọttạra isek, <verse eid="GEN 2:4" /><verse number="5" style="v" sid="GEN 2:5" />wa ichi jạnẹ-jạnẹ, tạrr oseng k'isạsaarẹ némena, ukwuru s'Ọvaar Ubinọkpaabyi nạn ọrạngkpang tạm núsia bẹ́, otebh k'isisek, ọttạra bẹ́, wa ọnạng kw'm'utubh isisek kòde. <verse eid="GEN 2:5" /><verse number="6" style="v" sid="GEN 2:6" />Okhenka, asi n'ayin k'isisek, p'asi isisek phyi-phyibh idiri.<verse eid="GEN 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 2:7" />Ma wọ Ọvaar Ubinọkpaabyi utim idọhngọ ọbạnga ujunung, uguma ọyọhng kw'akpen ugiẹ-ẹ k'asungmaang, ujunung nwọ uruk akpen.<verse eid="GEN 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 2:8" />Ọvaar Ubinọkpaabyi ukwu usi owonu k'ukhubha kw'okpebhadudon n'uyin k'Iden. Ọtạkha ujunung nwọ kw'kk'usia, oge ma. <verse eid="GEN 2:8" /><verse number="9" style="v" sid="GEN 2:9" />Ọvaar Ubinọkpaabyi usi isisek imen nchi k'akhira-k'akhira, s'ijibhi k'ichen, ibạra ijibh k'uchiattọhk. Nchi mfa ibe k'ewonuttem, jạnẹ ede ch'akpen, njọkha ede ch'idik-songa ch'ijibha ọttạra ipyibha.<verse eid="GEN 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 2:10" />Ma wọ ọraanga kw'ubin k'Iden ofobhu oseng, ọbạra oge asi ma ewonuttem, ọbạra ọbhaangẹ k'araanga annebung. <verse eid="GEN 2:10" /><verse number="11" style="v" sid="GEN 2:11" />Ọraanga kw'uchi eden okpen Pishọn, kw'ofobhu otena k'isek s'Havila k'ubungu, k'ibyi s'gol uning. <verse eid="GEN 2:11" /><verse number="12" style="v" sid="GEN 2:12" />Gol kw'isek nnọ ode ọkkakwẹ. Wa ibyi nnọ ibạra ikhaama ana p'arebhi iruk, ọttạra ata p'ọniks. <verse eid="GEN 2:12" /><verse number="13" style="v" sid="GEN 2:13" />Ọraanga kw'ottong afa okpen Gihọn kw'uwa ofobhu ọfhạrọ isek s'Kush phyi-phyibh. <verse eid="GEN 2:13" /><verse number="14" style="v" sid="GEN 2:14" />Ọraanga kw'ottong attaan okpen Tigiris kw'uwa ofobhu k'ukhubha kw'okpebhadudon n'uyin k'Asiriya. Ọraanga kw'ottong annebung okpena Yupharetes.<verse eid="GEN 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 2:15" />Ọvaar Ubinọkpaabyi ọtạk ujunung nwọ ochok k'owonu kw'Iden, ọfha odo owonu ngwọ, ọbạra okkeri kwẹ. <verse eid="GEN 2:15" /><verse number="16" style="v" sid="GEN 2:16" />Ọvaar Ubinọkpaabyi ukwu ọnạng ujunung nwọ nkhạkhạma bẹ́, “Kk'ọ ọbọhk nttia bẹ́, achi achidwuk pyidede py'nchi s'ibe ma owonu ngwa. <verse eid="GEN 2:16" /><verse number="17" style="v" sid="GEN 2:17" />De n'ode achidwuk py'ichi ch'idiksonga ch'ijibha ọttạra ipyibha, kàchi o. Iwu ch'achi chẹ, kk'apua e.”<verse eid="GEN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 2:18" />Ma wọ Ọvaar Ubinọkpaabyi n'obeni bẹ́, “Nújibha bẹ́ ujunung nwọ uninga mạnkkeni, amma m'nsi oyok-ikhaana kw'ọbaan-ẹ, nnạng-ẹ.”<verse eid="GEN 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 2:19" />Node s'Ọvaar Ubinọkpaabyi kk'idọhngọ utima ọbạnga mkpaten phyi-phyibh, ọttạra ọnọhn f'ẹrạng phyi-phyibh. Ọtạkha pyẹ phyibh okkena ujunung nwọ, ọfha ose ache-khira p'm'okpe pyẹ. Eche chidede ch'okpe pyẹ, mạnna wọ apyẹ ekpen. <verse eid="GEN 2:19" /><verse number="20" style="v" sid="GEN 2:20" />Ma wọ ujunung nwọ okpe itirakpo phyibh ache pabẹ, ọttạra mkpaten, ọttạra ọnọhn f'ẹrạng.</para>
  <para style="p" vid="GEN 2:20">Okhenka, node ujunung nwọ, oyok-ikhaana kw'ọbaan-ẹ kòde. <verse eid="GEN 2:20" /><verse number="21" style="v" sid="GEN 2:21" />Ma wọ Ọvaar Ubinọkpaabyi usi ujunung nwọ ọttaabha iwora. Masẹ n'ọttaabha ma o, ọrạbh-ẹ ọtạtaang-kạbhọ wạnọ, ọbạra ọtạkha atennạng p'ujunung nwọ ububha ibyi nnọ s'ọrạbh ọtạtaang-kạbhọ nwọ. <verse eid="GEN 2:21" /><verse number="22" style="v" sid="GEN 2:22" />Ma wọ Ọvaar Ubinọkpaabyi ọtạk ọtạtaang-kạbhọ kw'kk'ọrạbha k'ujunung, usi ikwanạng, ọtạkh-ẹ okkena ujunung.<verse eid="GEN 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 2:23" />Ujunung nwọ ọbẹ́,</para>
  <para style="q1" vid="GEN 2:23">“Iyaa! Maa wọ ode ọkhạbhọ kw'akhạbhọ paam,</para>
  <para style="q2" vid="GEN 2:23">ọttạra etennạng ch'atennạng paam.</para>
  <para style="q1" vid="GEN 2:23">Ẹma, abẹ m'ayer-ẹ, ikwanạng,</para>
  <para style="q2" vid="GEN 2:23">ukwuru sabẹ arạbh-ẹ k'ujunung k'ifor.”<verse eid="GEN 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 2:24" />Ẹgwọ usi ujunung m'ubina urik otte ọttạra ọkka, ọgbạkha ifor sẹ ọttạra ikwanạng kwẹ, ọfha abẹma anạng afa ade wạnọ.<verse eid="GEN 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 2:25" />Wa ujunung nwọ ọttạra ikwanạng kwẹ aning irinikhum, mkpạr bẹ nísia.<verse eid="GEN 2:25" /></para>
  <chapter eid="GEN 2" />
  <chapter number="3" style="c" sid="GEN 3" />
  <para style="s1">Ocheden-junung ọttạra ikwanạng kwẹ atto inyina</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 3:1" />Wa ijọhk idongu iyọhnga mkpaten phyibh s'Ọvaar Ubinọkpaabyi kk'usia. Wa asẹ ita ibạbh ikwanạng bẹ́, “Kọngkẹ Ubinọkpaabyi kk'bạnga obena bẹ́, abạnga nạngẹ ichidwuk chidede ma owonu ngwa achi?”<verse eid="GEN 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 3:2" />Ikwanạng nwọ ubhina ijọhk bẹ́, “Ẹngẹ! Oche ngwọ núdia! Ubinọkpaabyi obeni mạna bẹ́, m'ankke-okke anchi ichidwuk chidede ma owonu, <verse eid="GEN 3:2" /><verse number="3" style="v" sid="GEN 3:3" />okhenka, Ubinọkpaabyi obeni mạna bẹ́ amạna nạngẹ achidwuk p'ichi ch'ebe k'ewonuttem ọbọhk antwu, deja, m'ampe-ope.”<verse eid="GEN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 3:4" />Ijọhk nnọ ibạra iben ikwanạng nwọ bẹ́, “Abạnga mape e, <verse eid="GEN 3:4" /><verse number="5" style="v" sid="GEN 3:5" />okhenka ode bẹ́, Ubinọkpaabyi osong ma bẹ́ de abạnga achi achidwuk mbọ, idik m'itto bạnga iyaan <char style="it">bẹ ttaaan</char>, abạnga n'abạra ade masẹ Ubinọkpaabyi kw'osong ijibha ọttạra ipyibha.”<verse eid="GEN 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 3:6" />Okpe kw'ikwanạng nwọ ose bẹ́, achidwuk mbọ ajibhi ichia, abẹ abạra anyạnẹ k'ichen, ọttạra bẹ́, m'ẹgba ẹnạng ọnạng esonga, ọtạkha achidwuk bạnọ uchi, ọbạra ọtạkha bạnọ ọnạng udim kwẹ, kw'uning ma, udim ọbạra uchi. <verse eid="GEN 3:6" /><verse number="7" style="v" sid="GEN 3:7" />Ma wọ achen attaanẹ bẹ ma ibua-ibua, abẹ atin bẹ́, abẹ n'aning irinikhum. Abẹ n'atạk akwongutọhng p'ichi ch'fig, abọhra abubha irinikhum chabẹ.<verse eid="GEN 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 3:8" />Masẹ n'ukpir k'ẹchọhkha, ujunung nwọ ọttạra ikwanạng kwẹ n'abhaang s'Ọvaar Ubinọkpaabyi n'osenga ma owonu ngwọ, abẹ arạbh ata attubha k'ottemkwẹ kw'nchi s'owonu. <verse eid="GEN 3:8" /><verse number="9" style="v" sid="GEN 3:9" />Ma wọ Ọvaar Ubinọkpaabyi oyeri ujunung nwọ, ọbạbh-ẹ bẹ́, “Ọma khẹ nnwạn o?”<verse eid="GEN 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 3:10" />Ujunung nwọ, ọpọhn-ẹ bẹ́, “Mmaang ntwạkhọ sọ s'n'asenga k'owonu, ojor-m, ukwuru bẹ́, nning irinikhum, ẹgwọ nnạbhọ nttubha e.”<verse eid="GEN 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 3:11" />Ọvaar Ubinọkpaabyi n'ọbạbh-ẹ bẹ́, “Anẹ wọ otekh-ọ bẹ aning irinikhum? Kk'achidwuk p'ichi njọ nnạngẹ bạnga nkhạkhạma bẹ́, abạnga nạngẹ achi, achia o?”<verse eid="GEN 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 3:12" />Ujunung nwọ ọpọhn-ẹ bẹ́, “Ikwanạng nwọ kw'anạng-m, ẹwọ ọnạng-m achidwuk p'abin ma ichi njọ bạra nchi e.”<verse eid="GEN 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 3:13" />Ma wọ Ọvaar Ubinọkpaabyi n'ọbạbhọ ikwanạng nwọ bẹ́, “Bạng udik gwọ asi ma?”</para>
  <para style="p" vid="GEN 3:13">Ikwanạng nwọ ọpọhn-ẹ bẹ́, “Ijọhk rọ ibọhr-m bạra nchi achidwuk mbọ.”<verse eid="GEN 3:13" /></para>
  <para style="s">Ubinọkpaabyi ọkpaar iponga sabẹ</para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 3:14" />Ma wọ Ọvaar Ubinọkpaabyi obeni ijọhk bẹ́,</para>
  <para style="q1" vid="GEN 3:14">“Ukwuru udik ngwa kw'asi maa,</para>
  <para style="q2" vid="GEN 3:14">m'upyibh ọnạng-ọ, ọyọhnga nten s'oter phyibh ọttạra mkpaten phyibh,</para>
  <para style="q1" vid="GEN 3:14">ọma m'n'atima ẹfhạr atwạr k'isisek,</para>
  <para style="q2" vid="GEN 3:14">abạra achi idọhngọ,</para>
  <para style="q2" vid="GEN 3:14">k'akpen pọ phyibh.<verse eid="GEN 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="GEN 3:15" />M'nge iwawuna k'ngekha s'ọma ọttạra ikwanạng nwọ.</para>
  <para style="q2" vid="GEN 3:15">Iva pọ ọttạra pẹ m'aninga</para>
  <para style="q2" vid="GEN 3:15">k'iwawuna ayok abẹ.</para>
  <para style="q1" vid="GEN 3:15">Nnwa kwẹ m'utwukhu echo chọ,</para>
  <para style="q2" vid="GEN 3:15">ọma m'agakhẹ afhokkukkọrọ pẹ.”<verse eid="GEN 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 3:16" />Ubinọkpaabyi n'obeni ikwanạng nwọ bẹ́,</para>
  <para style="q1" vid="GEN 3:16">“Amma m'nttạr-ọ irem sididen</para>
  <para style="q2" vid="GEN 3:16">k'okpe kwidede kw'm'amaan nnwa.</para>
  <para style="q1" vid="GEN 3:16">Tạrr oseng mạma, mạna aror bẹ́, agbạkha ifor udim kwọ abẹ,</para>
  <para style="q2" vid="GEN 3:16">ẹma m'oyongu ma ode ochonạng kwọ.”<verse eid="GEN 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 3:17" />Ubinọkpaabyi oben Adam bẹ́,</para>
  <para style="q1" vid="GEN 3:17">“Ọma akhọhmọ ikwanạng kwọ itọhng,</para>
  <para style="q2" vid="GEN 3:17">achi ichidwuk ch'nkhạmọ-ọ bẹ́ nạngẹ achi,</para>
  <para style="q1" vid="GEN 3:17">ma wọ, kk'isisek ẹmma-nnaakha ukwuru ọma.</para>
  <para style="q2" vid="GEN 3:17">Ọma m'ase irem s'ọtọhm brasẹ ase uchiattọhk f'm'achi k'akpen pọ phyibh.<verse eid="GEN 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="GEN 3:18" />Nsidima ọttạra akkaangẹ m'amen ma isisek.</para>
  <para style="q2" vid="GEN 3:18">Uchiattọhk pfọ m'ode asạsaarẹ p'owonu.<verse eid="GEN 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="GEN 3:19" />Ọma mạna asi ọtọhm tạạr asạnẹ iruk,</para>
  <para style="q2" vid="GEN 3:19">brasẹ ase f'machi,</para>
  <para style="q1" vid="GEN 3:19">tạma mantọhmma kpira k'okpe kw'm'akpa nnạm k'isisek,</para>
  <para style="q2" vid="GEN 3:19">ukwuru bẹ́, abẹ atim idọhngọ asi-ọ,</para>
  <para style="q1" vid="GEN 3:19">ọma ade idọhngọ,</para>
  <para style="q2" vid="GEN 3:19">m'abạra akpa nnạm ma idọhngọ nnọ.”<verse eid="GEN 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 3:20" />Wa Adam<note caller="+" style="f"><char style="fr" closed="false">3.20 </char><char style="ft" closed="false">K'eHiburu, </char><char style="bd">Adam</char> ode oche kw'abẹ ayeri bẹ́, ujunung.</note> okpe ikwanạng kwẹ Iv<note caller="+" style="f"><char style="fr" closed="false">3.20 </char><char style="ft" closed="false">K'eHiburu, </char><char style="bd">Iv</char> uyini, akpen.</note>, ukwuru bẹ́, ẹma wọ m'ode ọkka kw'anạng phyibh p'arukhu akpen.<verse eid="GEN 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 3:21" />Wa Ọvaar Ubinọkpaabyi ọtạk atenkpa, utima usi ekpo igiapẹ, ọnạng Adam ọttạra ikwanạng kwẹ, ọfha abẹ abubha nninikhum sabẹ.<verse eid="GEN 3:21" /></para>
  <para style="s">Ubinọkpaabyi ukhubhu Adam ọttạra Iv k'owonu kw'Iden</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 3:22" />Ma wọ Ọvaar Ubinọkpaabyi obeni bẹ́, “Ujunung nwa n'ode masẹ amạna mba oyeni, kk'ijibha ọttạra ipyibha osonga. Khẹ ọbọhk mạ́ntte onemi ọbọhk ọphya achidwuk ma ichi ch'akpen uchi, deja, m'uruk akpen ipimmanitor.”<verse eid="GEN 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 3:23" />Ma wọ Ọvaar Ubinọkpaabyi ukhubhu Adam k'owonu kw'Iden, ọfha ọta utubh isisek s'utim usi-ẹ. <verse eid="GEN 3:23" /><verse number="24" style="v" sid="GEN 3:24" />Masẹ Ubinọkpaabyi ukhubhu Adam o, ochok chẹrubim k'ukhubha kw'okpebhadudon n'uyin, ọttạra ọkkangkkang-kkro kw'ode masẹ okpondaak kw'n'ọyạma <char style="it">bẹ nuuurrrr</char> ọbhạkhẹ iriringi okkeri k'ukhubha kwidede, ọfha ọkpa eden ch'eten k'ibyi s'ichi ch'akpen aning.<verse eid="GEN 3:24" /></para>
  <chapter eid="GEN 3" />
  <chapter number="4" style="c" sid="GEN 4" />
  <para style="s1">Ken ọttạra Ebẹl</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 4:1" />Wa Adam uyim ikwanạng kwẹ, kw'ode Iv abẹ, Iv utima ifhạr, ọmaan Ken. Iv oben bẹ́, “Ọvaar Ubinọkpaabyi kk'aam ọkkaana mmaan ujunungnwa.” <verse eid="GEN 4:1" /><verse number="2" style="v" sid="GEN 4:2" />Wa Iv ọbạra utima ifhạr ọmaan Ebẹl kw'otoru Ken nnạm.</para>
  <para style="p" vid="GEN 4:2">Wa Ebẹl n'utir arạkhạmaan, Ken usi owonu-tọhm.<verse eid="GEN 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 4:3" />Ukwu ọkhaama okpe kw'Ken utim achidwuk p'owonu kwẹ ọta ọnạng Ọvaar Ubinọkpaabyi ẹnạnga. <verse eid="GEN 4:3" /><verse number="4" style="v" sid="GEN 4:4" />Ebẹl ọtạkha achedenva p'arạkhạmaan pẹ p'ajibhi ifor usi ẹnạnga. Ọvaar Ubinọkpaabyi orebhi ettem otena Ebẹl ọttạra ẹnạnga chẹ. <verse eid="GEN 4:4" /><verse number="5" style="v" sid="GEN 4:5" />N'ode Ken ọttạra ẹnạnga chẹ, Ọvaar Ubinọkpaabyi ettem k'ẹ nérebha. Osenga ma, Ken ọdwạkh-ẹ tạrr ọkpạnẹ ititikha.<verse eid="GEN 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 4:6" />Ọvaar Ubinọkpaabyi n'ọbạbhọ Ken bẹ́, “Mbạng vọ ọdwạkh-ọ? Ode yạn kw'n'akpạnẹ ititikha o? <verse eid="GEN 4:6" /><verse number="7" style="v" sid="GEN 4:7" />De wạra asi ọkkakwẹ, wạra ettem kaam mérebh abọ? Okhenka, s'nạn ọkkakwẹ násia, ipyibha nạngkha ẹbaan-ọ bẹ́, ẹvạkh-ọ. Ọbaan bẹ́ akhema chẹ.”<verse eid="GEN 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 4:8" />Wa Ken ukwu ọkhaama nttọhna nnwọkka Ebẹl abẹ, oben-ẹ bẹ́, “Kwu amạna anyin k'ẹkpa.” Masẹ abẹ aning ma k'ẹkpa o, Ken uvun nnwọkka Ebẹl ọfhọ.<verse eid="GEN 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 4:9" />Ọvaar Ubinọkpaabyi ọbạbhọ Ken bẹ́, “Nnwakka Ebẹl mo o?”</para>
  <para style="p" vid="GEN 4:9">Ken ọpọhna bẹ́, “Amma kạ́nsong, amma wọ nde okkeri-nnwọkka kwaam sa?”<verse eid="GEN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 4:10" />Ọvaar Ubinọkpaabyi oben bẹ́, “Bạng udik gwọ asi maa? Khọhmọ oche kw'isẹ s'nnwakka n'igạma k'isisek iyer-m. <verse eid="GEN 4:10" /><verse number="11" style="v" sid="GEN 4:11" />Osenga ma, kk'ọ ẹmma-nnaakha, mbạra nkubh-ọ k'isisek s'iwong ẹmma igwo isẹ s'nnwakka kw'afhọ. <verse eid="GEN 4:11" /><verse number="12" style="v" sid="GEN 4:12" />Okpe kw'atubhu ekpo, apyẹ dạk míjibh ẹnạng-ọ. Ọma ẹyạr ibyi rạnẹ mávạkha, m'ade oseng-nden-nden ma ọyagbin.”<verse eid="GEN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 4:13" />Ken oben Ọvaar Ubinọkpaabyi bẹ́, “Irem saam ibạrẹ o, iyọhnga oche kw'm'nkke ntọhkha. <verse eid="GEN 4:13" /><verse number="14" style="v" sid="GEN 4:14" />Chemma kk'aam akhubha ma isisek nna, ọttạra k'ititikha sọ; bạra nde oseng-nden-nden maa ọyagbin, ọnạng kwidede kw'ose-m, m'ọfhọ-m ọfhọ.”<verse eid="GEN 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 4:15" />Okhenka, Ọvaar Ubinọkpaabyi n'obeni Ken bẹ́, “Oche ngwọ sạng! Ọnạng kwidede kw'ọfhọ-ọ, m'ọtạkha irem s'iyọhng sọ nden nsenọfa.” Ma wọ Ọvaar Ubinọkpaabyi ofhoru Ken, ọfha ọnạng kwidede kw'ose-ẹ nạng-ẹ ọfhọ. <verse eid="GEN 4:15" /><verse number="16" style="v" sid="GEN 4:16" />Ma o, Ken ubina k'ititikha s'Ọvaar Ubinọkpaabyi, ottena, ọta uruk k'isek s'Nọd, k'ukhubha kw'okpebhadudon n'uyin k'Iden.<verse eid="GEN 4:16" /></para>
  <para style="s">Efonamma ch'Ken</para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 4:17" />Wa Ken uyim ikwanạng kwẹ abẹ, ikwanạng nwọ utima ifhạr ọmaan Ẹnọk. Ma okpe ngwọ, Ken n'usi ofhon. Ukwu okpe ofhon ngwọ eche nnwa kwẹ, Ẹnọk.<verse eid="GEN 4:17" /></para>
  <para style="q2">
    <verse number="18" style="v" sid="GEN 4:18" />Wa Ẹnọk ofhonu Irad.</para>
  <para style="q2" vid="GEN 4:18">Irad ofhon Mehujayẹl,</para>
  <para style="q2" vid="GEN 4:18">Mehujayẹl ofhon Metusayẹl,</para>
  <para style="q2" vid="GEN 4:18">Metusayẹl ọbạra ofhon Lamẹk.<verse eid="GEN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 4:19" />Wa Lamẹk ọtạk ipanạng afa, oyok wạnọ okpen Ada, nwọkha okpena Zila. <verse eid="GEN 4:19" /><verse number="20" style="v" sid="GEN 4:20" />Wa Ada ọmaanẹ Jabal, ẹma wọ wa ode otte kw'anạng p'n'aruk k'akkira, abạra atir nten. <verse eid="GEN 4:20" /><verse number="21" style="v" sid="GEN 4:21" />Nnwọkka kwẹ okpen Jubal, kw'ode otte kw'anạng p'abha ugimangim khikhir, ọttạra ugigeri gạge. <verse eid="GEN 4:21" /><verse number="22" style="v" sid="GEN 4:22" />Zila ọbạra ọmaan Tubal-Ken, kw'ode otte kw'atepa p'brons ọttạra mbaanga k'akhira-k'akhira. Nnwọkka kw'Tubal-Ken kw'ikwanạng okpen Naama.<verse eid="GEN 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 4:23" />Wa Lamẹk obeni ipanạng pẹ bẹ́,</para>
  <para style="q1" vid="GEN 4:23">“Ada ọttạra Zila,</para>
  <para style="q2" vid="GEN 4:23">Abạngama ipanạng paam, akhọhm-m itọhng;</para>
  <para style="q2" vid="GEN 4:23">abạngama ipanạng p'Lamẹk, abhaanga ọtọhnga kwaam.</para>
  <para style="q1" vid="GEN 4:23">Amma kk'ujunung wạnọ mfha kw'umum-m ọttọhk,</para>
  <para style="q2" vid="GEN 4:23">udikkobh kw'usi-m ebhenna, ẹwọ kw'mfhọ.<verse eid="GEN 4:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="GEN 4:24" />De ọnạng kwidede ọfhọ Ken,</para>
  <para style="q2" vid="GEN 4:24">ẹma m'ose irem s'iyọhng s'Ken nden nsenọfa,</para>
  <para style="q1" vid="GEN 4:24">okhenka, de ọnạng ọfhọ amma Lamẹk ukwuru udikkobh kw'mfhọ,</para>
  <para style="q2" vid="GEN 4:24">ọnạng nwọ m'ose irem s'iyọhng s'ọnạng kw'ọfhọ Ken nden arạbh attaan ukuma chikhamfa.”<verse eid="GEN 4:24" /></para>
  <para style="s">Ẹmmaana ch'Sẹt ọttạra Ẹnọs</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 4:25" />Wa Adam ọbạra uyima ikwanạng kwẹ abẹ, ikwanạng kwẹ utima ifhạr ọmaan ujunungnwa, ukpuẹ-ẹ Sẹt, ọbẹ́, “Ubinọkpaabyi kk'aam nnwa ọdwạkh-ọdwạk ọnạnga kw'oter echo ch'Ebẹl, kw'Ken ọfhọ.”<verse eid="GEN 4:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 4:26" />Sẹt ọbạra ofhon ujunungnwa, ukpuẹ-ẹ Ẹnọs.</para>
  <para style="p" vid="GEN 4:26">Ma k'okpe ngwọ gwọ kw'anạng atạm eche ch'Ọvaar Ubinọkpaabyi kpukpobha.<verse eid="GEN 4:26" /></para>
  <chapter eid="GEN 4" />
  <chapter number="5" style="c" sid="GEN 5" />
  <para style="s1">Efonamma ch'Adam</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 5:1" />Maa wọ ode nnwẹr s'ache p'efonamma ch'Adam.</para>
  <para style="p" vid="GEN 5:1">Masẹ wa Ubinọkpaabyi usi ayokhanạng, usi bẹ akhera ẹma oyeni. <verse eid="GEN 5:1" /><verse number="2" style="v" sid="GEN 5:2" />Wa usi bẹ ujunung ọttạra ikwanạng, odo bẹ, oyeri bẹ bẹ́, Ayokhanạng.<verse eid="GEN 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 5:3" />Wa Adam kk'icho arạbh asajạnẹ ukuma jobh urukha, bạrasẹ n'ofhonu ujunungnwa kw'okher ẹma oyeni, ukpuẹ-ẹ Sẹt. <verse eid="GEN 5:3" /><verse number="4" style="v" sid="GEN 5:4" />Masẹ Adam kk'Sẹt ofhona, wa ọbạra uruk icho nnọhna mfa, ọbạra ofhon ajunung ọttạra ipanạng adwạkh-ọdwạk. <verse eid="GEN 5:4" /><verse number="5" style="v" sid="GEN 5:5" />Phyi-phyibh, wa Adam urukhu icho nnọhna mfa ukuma arạbh asajạnẹ ukuma jobh, bạrasẹ n'ope.<verse eid="GEN 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 5:6" />Masẹ Sẹt kk'icho arạbh asen ukuma asen urukha, ofhonu Ẹnọs. <verse eid="GEN 5:6" /><verse number="7" style="v" sid="GEN 5:7" />Masẹ Sẹt kk'Ẹnọs ofhona, wa ọbạra uruk icho nnọhna mfa ukuma asenọfa, ọbạra ofhon ajunung ọttạra ipanạng adwạkh-ọdwạk. <verse eid="GEN 5:7" /><verse number="8" style="v" sid="GEN 5:8" />Phyi-phyibh wa Sẹt urukhu icho nnọhna mfa ukuma arạbh asen ukuma jobh-kamfa, bạrasẹ n'ope.<verse eid="GEN 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 5:9" />Masẹ Ẹnọs kk'icho arạbh annebung ukuma jobh urukha, ofhonu Kenan. <verse eid="GEN 5:9" /><verse number="10" style="v" sid="GEN 5:10" />Masẹ kk'Kenan ofhona, wa ọbạra uruk icho nnọhna mfa ukuma chi, ọbạra ofhon ajunung ọttạra ipanạng adwạkh-ọdwạk. <verse eid="GEN 5:10" /><verse number="11" style="v" sid="GEN 5:11" />Phyi-phyibh wa Ẹnọs urukhu icho nnọhna mfa ukuma arạbh asen ukuma asen, bạrasẹ n'ope.<verse eid="GEN 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 5:12" />Masẹ Kenan okke icho arạbh attaan ukuma jobh, ofhonu Mahalalẹl. <verse eid="GEN 5:12" /><verse number="13" style="v" sid="GEN 5:13" />Masẹ kk'Mahalalẹl ofhona, wa ọbạra uruk icho nnọhna mfa ukuma arạbh afa, ọbạra ofhon ajunung ọttạra ipanạng adwạkh-ọdwạk. <verse eid="GEN 5:13" /><verse number="14" style="v" sid="GEN 5:14" />Phyi-phyibh wa Kenan urukhu icho nnọhna mfa ukuma arạbh asen ukuma jobh, bạrasẹ n'ope.<verse eid="GEN 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 5:15" />Masẹ Mahalalẹl okke acho arạbh attaan ukuma asen, ofhonu Jarẹd. <verse eid="GEN 5:15" /><verse number="16" style="v" sid="GEN 5:16" />Masẹ Mahalalẹl kk'Jarẹd ofhona, wa ọbạra uruk icho nnọhna mfa ukuma ẹrạbh ukuma jobh, ọbạra ofhon ajunung ọttạra ipanạng adwạkh-ọdwạk. <verse eid="GEN 5:16" /><verse number="17" style="v" sid="GEN 5:17" />Phyi-phyibh wa Mahalalẹl urukhu icho nnọhna mfa ukuma arạbh annebung ukuma chi, bạrasẹ n'ope.<verse eid="GEN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 5:18" />Masẹ Jarẹd kk'icho arạbh asenọttaan ukuma ifa ukkia, ofhonu Ẹnọk. <verse eid="GEN 5:18" /><verse number="19" style="v" sid="GEN 5:19" />Masẹ Jarẹd kk'Ẹnọk ofhona, ọbạra uruk icho nnọhna mfa, ọbạra ofhon ajunung ọttạra ipanạng adwạkh-ọdwạk. <verse eid="GEN 5:19" /><verse number="20" style="v" sid="GEN 5:20" />Phyi-phyibh wa Jarẹd urukhu icho nnọhna mfa ukuma arạbh asenọttaan ukuma ifa, bạrasẹ n'ope.<verse eid="GEN 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 5:21" />Masẹ Ẹnọk kk'icho arạbh attaan ukuma asen ukkia, ofhonu Mẹtusẹla. <verse eid="GEN 5:21" /><verse number="22" style="v" sid="GEN 5:22" />Masẹ kk'Mẹtusẹla ofhona, Ẹnọk ofon ororo ọtwạn Ubinọkpaabyi abẹ k'icho arạbh chi adwạkh-ọdwạk, ọbạra ofhon ajunung ọttạra ipanạng adwạkh-ọdwạk. <verse eid="GEN 5:22" /><verse number="23" style="v" sid="GEN 5:23" />Phyi-phyibh wa Ẹnọk urukhu icho arạbh chikhanttaan ukuma asen. <verse eid="GEN 5:23" /><verse number="24" style="v" sid="GEN 5:24" />Wa Ẹnọk ofon ororo ọtwạn Ubinọkpaabyi abẹ, osenga ma, Ubinọkpaabyi ọtạkh-ẹ utima ofona.<verse eid="GEN 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 5:25" />Masẹ Mẹtusẹla kk'icho arạbh sọwạnọ ukuma asenọfa urukha, ofhonu Lamẹk. <verse eid="GEN 5:25" /><verse number="26" style="v" sid="GEN 5:26" />Masẹ kk'Lamẹk ofhona, wa Mẹtusẹla ọbạra uruk icho ẹnọhna ukuma arạbh chi ukuma arạbh annebung ukuma ifa, ọbạra ofhon ajunung ọttạra ipanạng adwạkh-ọdwạk. <verse eid="GEN 5:26" /><verse number="27" style="v" sid="GEN 5:27" />Phyi-phyibh wa Mẹtusẹla urukhu icho nnọhna mfa ukuma arạbh asenọttaan ukuma sọwạnọ, bạrasẹ n'ope.<verse eid="GEN 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 5:28" />Masẹ Lamẹk okke icho arạbh sọwạnọ ukuma ifa, ofhonu ujunungnwa, <verse eid="GEN 5:28" /><verse number="29" style="v" sid="GEN 5:29" />ukpuẹ-ẹ Noa. Lamẹk ukwu oben bẹ́, “Nnwa nwa m'ofokhu mạna nttem k'ọtọhm famạna, ọttạra k'irem samạna s'ibin k'isisek s'Ọvaar Ubinọkpaabyi kk'ẹmma-ọraakha.” <verse eid="GEN 5:29" /><verse number="30" style="v" sid="GEN 5:30" />Masẹ Lamẹk kk'Noa ofhona, wa ọbạra uruk icho ẹnọhna ukuma arạbh sọwạnọ ukuma chi, ọbạra ofhon ajunung ọttạra ipanạng adwạkh-ọdwạk. <verse eid="GEN 5:30" /><verse number="31" style="v" sid="GEN 5:31" />Phyi-phyibh wa Lamẹk urukhu icho ẹnọhna ukuma arạbh chikhanttaan ukuma chikhamfa, bạrasẹ n'ope.<verse eid="GEN 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 5:32" />Masẹ Noa kk'icho ẹnọhna ukuma arạbh asen ukkia, ofhonu ajunungva attaan p'ade: Shẹm, ọttạra Ham, ọttạra Japhẹt.<verse eid="GEN 5:32" /></para>
  <chapter eid="GEN 5" />
  <chapter number="6" style="c" sid="GEN 6" />
  <para style="s1">Ipyibha ch'ayokhanạng ma ọyagbin</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 6:1" />K'okpe kw'uwa ayokhanạng atạm sạsaabh ma ọyagbin, abẹ amaan apanạngva anạng bẹ, <verse eid="GEN 6:1" /><verse number="2" style="v" sid="GEN 6:2" />iva p'Ubinọkpaabyi ase bẹ́, apanạngva mbọ p'ayokhanạng ajibhi iminava. Ma wọ abẹ n'atek ayok bạnọ, atạkha bẹ masẹ ipanạng pabẹ. <verse eid="GEN 6:2" /><verse number="3" style="v" sid="GEN 6:3" />Ma wọ Ọvaar Ubinọkpaabyi obeni bẹ́, “Iguguma saam dạkhẹ oyokhanạng abẹ míninga tạrr ipimmanitor, ukwuru bẹ́, oyokhanạng ode akpakpa. Tạma mantọmma, ayokhanạng akpen dạk máruk ayongu icho arạbh asajạnẹ.”<verse eid="GEN 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 6:4" />Ma okpe ngwọ, ọttạra kw'oyongu ma, wa aNephilim aning ma ọyagbin. Masẹ iva p'Ubinọkpaabyi ayim aminava p'ayokhanạng abẹ, aminava mbọ atim ọfhạr amaan bẹ iva. Iva mbọ wa ade afa-nạng, abẹ abạra ade ajunung p'ayini eche.<verse eid="GEN 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 6:5" />Ọvaar Ubinọkpaabyi ose bẹ́, ipyibha ch'ayokhanạng kk'ẹbạra eseng eden ma ọyagbin, ọttạra bẹ́, ẹkka ch'ayokhanạng phyi-phyibh ipyibh-upyibh k'okpe kwidede. <verse eid="GEN 6:5" /><verse number="6" style="v" sid="GEN 6:6" />Akwẹ ọmma Ubinọkpaabyi k'ettem k'usisi kw'ayokhanạng p'kk'usia ma ọyagbin. <verse eid="GEN 6:6" /><verse number="7" style="v" sid="GEN 6:7" />Ma wọ Ọvaar Ubinọkpaabyi n'obeni ẹma oyeni bẹ́, “Amma m'ndimi ayokhanạng phyi-phyibh p'kk'nyokha, ọnạng wạnọ wạnọ ma ọyagbin múrik. Amma m'mbạra ndimi nten phyibh, ọttạra ọnọhn, ọttạra ekpo phyibh py'n'ẹsenga k'isisek. Akwẹ ọmmaam k'ettem bẹ́, amma kk'bẹ nsia.” <verse eid="GEN 6:7" /><verse number="8" style="v" sid="GEN 6:8" />Okhenka, Noa ode ọnạng kw'usi ẹmmaana ch'erebhi Ọvaar Ubinọkpaabyi ettem.<verse eid="GEN 6:8" /></para>
  <para style="s">Udik otena Noa</para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 6:9" />Maa wọ ode udik otena Noa.</para>
  <para style="p" vid="GEN 6:9">Wa Noa ode ọnạng kw'otor-otor, iponga-pyibha nọ́bạra ọkhaama masẹ anạng pakhẹ k'okpe. Wa Noa ọtwạnọ Ubinọkpaabyi abẹ. <verse eid="GEN 6:9" /><verse number="10" style="v" sid="GEN 6:10" />Wa Noa ofhonu ajunungva attaan p'ade: Shẹm, ọttạra Ham, ọttạra Japhẹt.<verse eid="GEN 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 6:11" />Wa Ubinọkpaabyi ose bẹ́, ọyagbin kk'ukhibha, ọbạra ọbạr igbaan. <verse eid="GEN 6:11" /><verse number="12" style="v" sid="GEN 6:12" />Ubinọkpaabyi ukwu ose oche kw'ọyagbin kk'ufhura ukpira, s'ayokhanạng phyibh k'ọyagbin kk'akpen pabẹ akhibha. <verse eid="GEN 6:12" /><verse number="13" style="v" sid="GEN 6:13" />Ma wọ Ubinọkpaabyi obeni Noa bẹ́, “Amma kk'ẹkka nkhaama bẹ́ ndimi ayokhanạng phyibh, s'ọyagbin n'ọbạrẹ igbaan ukwuru ayokhanạng. Kker e, amma m'ndimi ayokhanạng ọttạra ọyagbin nwa <char style="it">bẹ́ phyibh.</char> <verse eid="GEN 6:13" /><verse number="14" style="v" sid="GEN 6:14" />Ọma Noa, tima mkpaakha s'ichi ch'ẹkpọhkhọ-ọkpọhkhọ mun ọkpaar kwididen nạng ọma oyeni. Si mmangọ k'ọkpaar gwọ ẹtaanga, tima ẹbanttum kpa abhaang pẹ k'ẹtaanga ọttạra k'iyaan, ọfha asi nạngẹ k'ẹtaanga anwa. <verse eid="GEN 6:14" /><verse number="15" style="v" sid="GEN 6:15" />Maa wọ ode oche kw'm'ammun ọkpaar ngwọ: Adum pẹ m'ade ntwạkhọ enọhna ukuma arạbh afa ukuma jobh, ẹkpa chẹ m'ede ntwạkhọ arạbh attaan ukuma chi, ebe chẹ m'ede ntwạkhọ arạbh afa ukuma asen. <verse eid="GEN 6:15" /><verse number="16" style="v" sid="GEN 6:16" />M'asi ipakhọhnga abubha kwẹ, tạma k'abem kpira k'ipakhọhnga, chok ẹbhaang ch'ede ẹtwạkhọ k'ubungu ọttạra ibhaakha. Si ọmmakhubh k'ukhubha gwạnọ k'ọkpaar ngwọ, asi nnạna nttaan, jạnẹ k'isekhisek, jạnẹ k'ottemkwẹ, njọkhạ k'ẹrạng.<verse eid="GEN 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 6:17" />“Kkeri, amma m'ntima asi nchi ọyagbin phyibh. Asi mbọ m'anwa akhibhi ọttọhk fidede f'urukhu akpen ma ọyagbin. Fidede f'n'ọgwạkhọ ọyọhng m'opope. <verse eid="GEN 6:17" /><verse number="18" style="v" sid="GEN 6:18" />De n'ode ọma, amma m'nsi echekha chaam nnạng ọma ọttạra iva pọ, ọttạra ikwanạng kwọ, ọttạra ipanạng p'iva pọ; abạngama phyibh m'anwa ma ọkpaar ngwọ ẹtaanga. <verse eid="GEN 6:18" /><verse number="19" style="v" sid="GEN 6:19" />Ọma m'atạkha akhira k'afa-k'afa p'ọttọhk fidede f'urukhu akpen, udim ọttạra ikwa, anwa k'ọkpaar ngwọ ẹtaanga, ọfha apyẹ iruk akpen ọma abẹ ma ọkpaar. <verse eid="GEN 6:19" /><verse number="20" style="v" sid="GEN 6:20" />Akhira k'afa-k'afa p'ọnọhn fidede, ọttạra p'nten sidede, ọttạra p'ọttọhk fidede f'n'osenga k'isisek, m'ikwu etor-ọ, ọfha ininga akpen. <verse eid="GEN 6:20" /><verse number="21" style="v" sid="GEN 6:21" />M'atobha ọttọhk fidede f'ode uchiattọhk ọnạng bạnga, f'ọbạra ode uchiattọhk ọnạng nten nnọkha phyi-phyibh, ayikha ma ọkpaar ngwọ.”<verse eid="GEN 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 6:22" />Noa usi udik kwidede otor k'oche kw'Ubinọkpaabyi ọtọhn-ẹ.<verse eid="GEN 6:22" /></para>
  <chapter eid="GEN 6" />
  <chapter number="7" style="c" sid="GEN 7" />
  <para style="s">Oche kw'uwa asi achi ọyagbin</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 7:1" />Ma wọ Ọvaar Ubinọkpaabyi obeni Noa bẹ́, “Tima ẹchọhmfhạr chọ nwa k'ọkpaar, ukwuru bẹ́, amma kk'nsia bẹ́, ọma wọ ade ọnạng kw'otor-otor ma igbọ nna. <verse eid="GEN 7:1" /><verse number="2" style="v" sid="GEN 7:2" />K'nten s'ibaan k'ẹja fạfọhnọ, tạkha k'mfa-k'mfa k'ukhira kwabẹ k'ibyi isenọfa, udim ọttạra ikwa, atima anwa ma ọkpaar ngwọ. N'ode nten s'nạn k'ẹjafọhna níbaana, tạkha udim ọttạra ikwa k'ukhira kwabẹ, <verse eid="GEN 7:2" /><verse number="3" style="v" sid="GEN 7:3" />abạra atạkha ọnọhn osenọfa-osenọfa k'ukhira kwidede kwabẹ, udim ọttạra ikwa, ọfha ọnọhn-khira fidede uruk akpen ma ọyagbin. <verse eid="GEN 7:3" /><verse number="4" style="v" sid="GEN 7:4" />K'iwu isenọfa k'ititikha, amma m'ntebh ọrạngkpaang k'iwu arạbh afa ọttạra nnunguwu arạbh afa ma ọyagbin, mbạra ndimi ọttọhk fidede f'uning akpen f'kk'nsia ma ọyagbin.”<verse eid="GEN 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 7:5" />Wa Noa usi udik kwidede kw'Ọvaar Ubinọkpaabyi ọtọhn-ẹ.<verse eid="GEN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 7:6" />Wa Noa ode icho ẹnọhna ukuma arạbh jobh k'okpe kw'asi achi ọyagbin.<verse eid="GEN 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 7:7" />Noa utim iva pẹ, ọttạra ikwanạng kwẹ, ọttạra ipanạng p'iva pẹ, ọnwa k'ọkpaar ngwọ, ọfha abẹ annaanga ẹnwanwa njọ. <verse eid="GEN 7:7" /><verse number="8" style="v" sid="GEN 7:8" />Nten k'mfa-k'mfa s'ibaan k'ẹjafọhna, ọttạra k'mfa-k'mfa s'nạn k'ẹjafọhna níbaana, oseng k'ọnọhn ọttạra ekpo py'n'ẹsenga k'isisek, <verse eid="GEN 7:8" /><verse number="9" style="v" sid="GEN 7:9" />udim ọttạra ikwa, n'asenga akhebha Noa, ẹbạra ẹnwa k'ọkpaar ngwọ, k'oche kw'Ubinọkpaabyi kk'Noa ọtọhna. <verse eid="GEN 7:9" /><verse number="10" style="v" sid="GEN 7:10" />Masẹ iwu nnọ isenọfa kk'isenga, asi anwa achi ọyagbin.<verse eid="GEN 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 7:11" />K'okpe kw'Noa n'ode icho ẹnọhna ukuma arạbh jobh, k'iwu chikhamfa k'ophye kw'ottong afa, ẹjọ ch'asi adwu k'isisek <char style="it">bẹ brubrubru</char>, ẹrạng ẹbạra ewonga, asi atebh <char style="it">bẹ wọọọọọọọ</char>. <verse eid="GEN 7:11" /><verse number="12" style="v" sid="GEN 7:12" />Wa ọrạngkpaang otebhi ma ọyagbin k'iwu arạbh afa, ọttạra nnunguwu arạbh afa.<verse eid="GEN 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 7:13" />Ma iwu njọ jạnẹ, Noa ọttạra iva pẹ p'ade Shẹm, ọttạra Ham, ọttạra Japhẹt, ọttạra ikwanạng kw'Noa, ọttạra ipanạng p'iva pẹ, anwa k'ọkpaar ngwọ. <verse eid="GEN 7:13" /><verse number="14" style="v" sid="GEN 7:14" />Wa abẹ anwa k'ọkpaar ngwọ ọttạra mkpaten phyi-phyibh, ator k'akhira pabẹ, ọttạra itirakpo phyi-phyibh, ator k'akhira pabẹ, ọttạra ọttọhk fidede f'n'osenga k'isisek, ator k'akhira pabẹ, ọttạra ọnọhn phyi-phyibh, ator k'akhira pabẹ, ọttạra ọttọhk fidede f'omeni abạbaang. <verse eid="GEN 7:14" /><verse number="15" style="v" sid="GEN 7:15" />Ekpo phyibh py'irukhu akpen esengi k'ẹfa-k'ẹfa etor Noa ẹnwa k'ọkpaar ngwọ. <verse eid="GEN 7:15" /><verse number="16" style="v" sid="GEN 7:16" />Wa nten s'inwa ma ọkpaar ngwọ ide udim ọttạra ikwa f'ọttọhk fidede f'urukhu akpen, otor k'oche kw'Ubinọkpaabyi kk'Noa ọtọhna. Ma wọ Ọvaar Ubinọkpaabyi obheni ukhubh okpora Noa kha ẹtaanga.<verse eid="GEN 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 7:17" />Asi afona ororo achi ọyagbin k'iwu arạbh afa, apyẹ ẹnwa tạrr eyebh ọkpaar ngwọ anạna k'asi k'ẹrạng. <verse eid="GEN 7:17" /><verse number="18" style="v" sid="GEN 7:18" />Asi akwu afu ma ọyagbin <char style="it">bẹ byẹrr,</char> ọkpaar n'ofobh k'asi k'ẹrạng. <verse eid="GEN 7:18" /><verse number="19" style="v" sid="GEN 7:19" />Asi anwa tạrr ẹfhạrọ akpecho p'agor-ogoru phyibh ma ọyagbin. <verse eid="GEN 7:19" /><verse number="20" style="v" sid="GEN 7:20" />Asi anwa afhạrọ akpecho tạrr apyẹ edong ẹyọhnga ntwạkhọ ẹrạbh. <verse eid="GEN 7:20" /><verse number="21" style="v" sid="GEN 7:21" />Ekpo phyi-phyibh py'n'esenga k'isisek epe, tạma k'ọnọhn, ọttạra nten s'asi, kpira k'itirakpo, tạrr oseng k'mkpaten, ọttạra ekpo phyibh py'ifu ma ọyagbin, ọttạra ayokhanạng phyi-phyibh. <verse eid="GEN 7:21" /><verse number="22" style="v" sid="GEN 7:22" />Fidede f'uning k'igbin, f'n'ọgwạkhọ ọyọhng, ope. <verse eid="GEN 7:22" /><verse number="23" style="v" sid="GEN 7:23" />Oche ngwọ gwọ kw'Ubinọkpaabyi udimi ọttọhk fidede f'urukhu akpen k'ọyagbin, tạma k'ayokhanạng kpira k'nten, tạrr oseng k'ekpo py'n'esenga k'isisek, ọttạra ọnọhn f'ẹrạng. Wa n'urikhi Noa ọttạra ayok mbọkha p'aning abẹ k'ọkpaar ẹtaanga.<verse eid="GEN 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 7:24" />Wa asi mbọ achi ọyagbin k'iwu arạbh asenọfa ukuma jobh.<verse eid="GEN 7:24" /></para>
  <chapter eid="GEN 7" />
  <chapter number="8" style="c" sid="GEN 8" />
  <para style="s">Asi p'achi ọyagbin atạm wạwọhrọ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 8:1" />Ma okpe kw'uwa asi kk'ọyagbin achia, wa Ubinọkpaabyi Noa nóbona. Wa itirakpo phyibh ọttạra mkpaten s'ining Noa abẹ k'ọkpaar ẹtaanga nọ́bạra obona. N'ọtọhmọ ibum iguma k'ọyagbin, kw'usi asi awọhrọ. <verse eid="GEN 8:1" /><verse number="2" style="v" sid="GEN 8:2" />Mfhobh-cho s'isisek ikka, amma p'ọrạngkpaang akpa, asi dạk nátebha. <verse eid="GEN 8:2" /><verse number="3" style="v" sid="GEN 8:3" />Asi atạma wạwọhrọ k'ọyagbin. Masẹ n'ottong iwu arạbh asenọfa ukuma jobh o, asi kk'awọhra. <verse eid="GEN 8:3" /><verse number="4" style="v" sid="GEN 8:4" />Ukwu ottonga iwu chikhamfa s'aphye asenọfa, ọkpaar ọta uphyikha k'akpecho p'Ararat. <verse eid="GEN 8:4" /><verse number="5" style="v" sid="GEN 8:5" />Asi awọhrọ oche ngwọ-ngwọ tạrr ukpira k'echedenwu ch'aphye jobh, akpecho ayin.<verse eid="GEN 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 8:6" />Masẹ iwu arạbh afa kk'isenga, Noa ugwunga ufhuma kw'ọkpaar kw'kk'usia. <verse eid="GEN 8:6" /><verse number="7" style="v" sid="GEN 8:7" />Ọtọhm ikpembukha s'n'ikwur, ikpa nnạm, ikwur, ikpa nnạm, tạrr ukpira k'okpe kw'asi kk'akka k'isisek. <verse eid="GEN 8:7" /><verse number="8" style="v" sid="GEN 8:8" />Noa ọbạra ọtọhm ikpua, ọfha osonga de asi kk'akka k'isisek. <verse eid="GEN 8:8" /><verse number="9" style="v" sid="GEN 8:9" />Okhenka, wa ikpua ibyi s'm'ibyạre mfhok nísia, ukwuru s'asi atim aning k'isisek. Asẹ ikwuna itor Noa k'ọkpaar. Noa onemi ọbọhk ọvạkha sẹ oge k'ọkpaar.<verse eid="GEN 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 8:10" />Noa uninga adạkhẹ iwu isenọfa, ọbạra ọtọhm ikpua nnọ iyin k'ọkpaar. <verse eid="GEN 8:10" /><verse number="11" style="v" sid="GEN 8:11" />Masẹ ikpua ikwun itor-ẹ k'echọhkha, itim ikwongutọhng s'oliv s'isen-oseni. Ma wọ Noa osong bẹ́ asi kk'awọhra k'ọyagbin. <verse eid="GEN 8:11" /><verse number="12" style="v" sid="GEN 8:12" />Ukwu uninga adạkhẹ iwu isenọfa, ọbạra ọtọhm sẹ. Okhenka, ikpua nnọ dạk níkwuna.<figure style="fig" alt="Dove flying" file="hk00064c.jpg" size="col" loc="8.5" copy="Illustrations by Horace Knowles, © The British &amp; Foreign Bible Society, 1954, 1967, 1972, 1995" ref="8.5" /><verse eid="GEN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 8:13" />K'echedenwu ch'ocheden-phye kw'usi Noa icho enọhna ukuma arạbh jobh ukuma gwạnọ, asi kk'akka k'isisek. Noa ogbe ẹkpacho ch'ọkpaar, okkeri, ose bẹ́ isisek kk'itạma gwugwu. <verse eid="GEN 8:13" /><verse number="14" style="v" sid="GEN 8:14" />K'iwu ẹrạbh ukuma isenọfa s'ophye kw'ottong afa, isisek kk'ikkera igwu.<verse eid="GEN 8:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 8:15" />Ma wọ Ubinọkpaabyi n'obeni Noa bẹ́, <verse eid="GEN 8:15" /><verse number="16" style="v" sid="GEN 8:16" />“Tima ikwanạng kwọ, ọttạra iva pọ, ọttạra ipanạng p'iva pọ, abạnga ayin k'iyaan. <verse eid="GEN 8:16" /><verse number="17" style="v" sid="GEN 8:17" />Gba tima ọttọhk fidede f'urukhu akpen k'ukhira-k'ukhira, f'uning abọ, ekpo masẹ ọnọhn, ọttạra nten, ọttạra ekpo py'n'esenga k'isisek, ọfha apyẹ ẹmaan ayok ẹnyaamẹ k'ọyagbin, ẹbạra ẹsaabh k'ubhik.”<verse eid="GEN 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 8:18" />Ma wọ Noa uyini k'iyaan ọttạra ajunungva pẹ, ọttạra ikwanạng kwẹ, ọttạra ipanạng p'iva pẹ. <verse eid="GEN 8:18" /><verse number="19" style="v" sid="GEN 8:19" />Nten phyibh s'n'isenga k'isisek, ọttạra ọnọhn phyibh, ọttạra ọttọhk fidede f'n'osenga k'isisek ẹbạra iyin k'ọkpaar ngwọ, fidede k'ukhira kwẹ.<verse eid="GEN 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 8:20" />Ma o, Noa usi ijabyi ọnạng Ọvaar Ubinọkpaabyi, ọtạkha eten k'ajạnẹ-k'ajạnẹ k'nten s'ibaan k'ẹja f'ạfọhnọ, ọttạra ọnọhn f'ọbaan k'ẹja fạfọhnọ, utima usi ẹjafọhna ch'ẹnạnga ẹkkạmachẹ ma ijabyi nnọ. <verse eid="GEN 8:20" /><verse number="21" style="v" sid="GEN 8:21" />Masẹ Ọvaar Ubinọkpaabyi ọbhaang iruk rebhada ch'ẹja njọ, oben kha ettem bẹ́, “Amma kwạna dạkhẹ ọyagbin ẹmma mạ́nnaakhẹ ukwuru usisi kw'oyokhanạng, s'ọbạra ode bẹ́ ettem ch'oyokhanạng ifu ọttạra mpyibha ttotto s'otto. Amma dạkhẹ ekpo py'irukhu akpen mạ́ndimi oche kw'ndimi ma okpe ngwa.<verse eid="GEN 8:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="GEN 8:22" />Tạma mantọmma tạrr ukpira k'ekpongannạmwu ch'ọyagbin,</para>
  <para style="q1" vid="GEN 8:22">okpe kw'ekpo tutubh ọttạra okpe kw'iphya,</para>
  <para style="q1" vid="GEN 8:22">okpe kw'etebhichẹ ọttạra eyonchẹ,</para>
  <para style="q1" vid="GEN 8:22">okpe kw'ẹya ọttạra irungu,</para>
  <para style="q1" vid="GEN 8:22">idik nna phyibh ekponga míkhaama, m'ifona ororo ininga tạrr ipimmanitor.”<verse eid="GEN 8:22" /></para>
  <chapter eid="GEN 8" />
  <chapter number="9" style="c" sid="GEN 9" />
  <para style="s">Echekha ch'Ubinọkpaabyi ọtạk ọnạng Noa</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 9:1" />Ma wọ Ubinọkpaabyi odo Noa ọttạra iva pẹ, oben bẹ bẹ́, “Abạnga afhon iva, tte iva pabạnga asaabh-ọsaabh, abạra anyaamẹ aruk k'ibyi sidede ma ọyagbin. <verse eid="GEN 9:1" /><verse number="2" style="v" sid="GEN 9:2" />Mkpaten s'ọyagbin phyibh, ọttạra ọnọhn f'ẹrạng, ọttạra ekpo phyibh py'n'esenga k'isisek, ọttạra nten s'asi phyibh, m'ẹkhaama ojora fabạnga. Amma nchokhu pyẹ phyibh k'isekhisek kwabạnga. <verse eid="GEN 9:2" /><verse number="3" style="v" sid="GEN 9:3" />Masẹ kk'bạnga asạsaarẹ ncheden nnạnga, mgba nnạng bạnga ọttọhk fidede f'urukhu akpen f'n'osenga k'isisek, ode masẹ uchiattọhk ọnạng bạnga.<verse eid="GEN 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 9:4" />“Okhenka, ọkhaam ọtọhk vạnọ f'abạnga nạmáchi, f'ode eten ch'itim ẹkhaam isẹ káchi, ukwuru bẹ́ isẹ rọ ide akpen. <verse eid="GEN 9:4" /><verse number="5" style="v" sid="GEN 9:5" />De ọnạng ọfhọ oyok, amma m'nnor akpen p'oyok mbạbh-ẹ. Ode eten ẹfhọ oyokhanạng, m'anạng chẹ irem. Ode ọnạng ọfhọ oyok, m'nnạng-ẹ irem s'ibaan-ẹ.<verse eid="GEN 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="GEN 9:6" />Ọnạng kwidede kw'ọfhọ oyokhanạng,</para>
  <para style="q2" vid="GEN 9:6">mạnna wọ oyokhanạng m'ọbạra ọfhọ ẹma,</para>
  <para style="q2" vid="GEN 9:6">ukwuru bẹ́, ẹma Ubinọkpaabyi usi oyokhanạng okhera ẹma oyeni.<verse eid="GEN 9:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="GEN 9:7" />Abạnga afhon iva, tte iva p'abạnga asaabh, anyaamẹ aruk k'ibyi sidede ma ọyagbin.”<verse eid="GEN 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 9:8" />Ma wọ, Ubinọkpaabyi obeni Noa ọttạra iva pẹ bẹ́, <verse eid="GEN 9:8" /><verse number="9" style="v" sid="GEN 9:9" />“Kker e, n'ntạkha echekha nnạng bạnga ọttạra iva p'iva pabạnga. <verse eid="GEN 9:9" /><verse number="10" style="v" sid="GEN 9:10" />Echekha nja m'ininga ẹnạng ọttọhk fidede f'urukhu akpen, f'ode ọnọhn, ọttạra ekpo itirape, ọttạra mkpaten, phyi-phyibh f'ọtwạnọ bạnga abẹ uyin ma ọkpaar, f'urukhu akpen ma ọyagbin. <verse eid="GEN 9:10" /><verse number="11" style="v" sid="GEN 9:11" />Amma n'chekhi nnạng bạnga bẹ́, okpe dạk kóde kw'asi m'abạra achi ekpo py'irukhu akpen phyibh, okpe dạk kóde kw'asi m'abạra anwa akhibhi ọyagbin.”<verse eid="GEN 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 9:12" />Ubinọkpaabyi ọbạra oben bẹ́, “Maa wọ ode ẹkhọhkha ch'Echekha chaam ch'nkhaama bạnga abẹ, ọttạra ekpo phyi-phyibh py'n'ẹgwạkhọ ọyọhng, echekha nja m'ininga ẹnạng igbọ s'm'ikwu k'iwu oro. <verse eid="GEN 9:12" /><verse number="13" style="v" sid="GEN 9:13" />Amma kk'isidikhi chaam nchokha k'ebona, ch'ede ẹkhọhkha ch'Echekha ch'nkhaam bạnga abẹ, ọttạra ọyagbin kubungu. <verse eid="GEN 9:13" /><verse number="14" style="v" sid="GEN 9:14" />Okpe kw'ntọhmọ ebona k'ọyagbin, isidikhi iyin, <verse eid="GEN 9:14" /><verse number="15" style="v" sid="GEN 9:15" />amma m'njima echekha ch'nkhaam bạnga abẹ, ọttạra ekpo phyibh py'irukhu akpen. Okpe dạk kòde kw'asi m'anwa adimi ekpo phyibh py'irukhu akpen. <verse eid="GEN 9:15" /><verse number="16" style="v" sid="GEN 9:16" />Ma wọ, okpe kwidede kw'isidikhi iyini k'ebona, m'nse chẹ njima echekha ch'ipimmanitor ch'Ubinọkpaabyi ọkhaam ọttạra ekpo k'akhira-k'akhira phyi-phyibh py'irukhu akpen.”<verse eid="GEN 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 9:17" />Ma wọ Ubinọkpaabyi obeni Noa bẹ́, “Isidikhi nja jọ ede ẹkhọhkha ch'Echekha ch'nkhaam ọttạra ekpo py'idede py'irukhu akpen ma ọyagbin.”<verse eid="GEN 9:17" /></para>
  <para style="s1">Udik kw'oten k'iva p'Noa</para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 9:18" />Wa ajunungva p'Noa p'ayini ma ọkpaar ngwọ ade Shẹm, ọttạra Ham, ọttạra Japhẹt. Ham wọ wa ode otte kw'Kenaan. <verse eid="GEN 9:18" /><verse number="19" style="v" sid="GEN 9:19" />Wa osengi ma iva mbọ attaan p'Noa ọttạra iva pabẹ, ayokhanạng anyaamẹ afu ọyagbin <char style="it">bẹ́ ttạbh.</char> <figure style="fig" alt="picture of a grape vine" file="hk00110c.tif" size="col" loc="9:20" ref="9.20">Adwuk p'agrep</figure><verse eid="GEN 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 9:20" />Wa Noa ode owonutọhm-nạng. Ẹma wọ wa ode ocheden-nạng kw'okponu nchi s'n'iyạm agrep.<note caller="+" style="f"><char style="fr" closed="false">9.20 </char><char style="ft" closed="false">Nchi nnọ s'agrep n'iyạm adwuk p'abẹ n'atima asi atwuk.</char></note> <verse eid="GEN 9:20" /><verse number="21" style="v" sid="GEN 9:21" />K'okpe mạnna gwạnọ, wa Noa ogwo atwuk p'achidwuk mbọ tạrr ubuma, ọta uyima irinikhum k'ukkira kwẹ. <verse eid="GEN 9:21" /><verse number="22" style="v" sid="GEN 9:22" />Ma wọ Ham kw'ode otte kw'Kenaan ose irinikhum ch'otte, ọta ọkpaak ivọkka k'iyaan. <verse eid="GEN 9:22" /><verse number="23" style="v" sid="GEN 9:23" />Ma wọ Shẹm, ọttạra Japhẹt atạk ivạra sididen anạna k'nkkang sabẹ, abẹ asenga nnạm-nnạm, akpa nnạm avạra otte, abubh-ẹ irinikhum ọfha abẹ nạngẹ irinikhum chẹ ase.<verse eid="GEN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 9:24" />Masẹ Noa n'ọphyạbh s'atwuk kk'ẹ attaana, osonga udik kw'Ham, kw'ode okpongannạm nwa kwẹ kw'ujunung kk'usia, Noa ọrakh-ẹ ẹmma, oben bẹ́,<verse eid="GEN 9:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="GEN 9:25" />“M'upyibh ọnạng Kenaan,</para>
  <para style="q1" vid="GEN 9:25">ẹma m'ode ubira kw'abira p'ivọkka pẹ phyibh.”<verse eid="GEN 9:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="GEN 9:26" />Ọbạra oben bẹ́,</para>
  <para style="q1" vid="GEN 9:26">“Tte ẹtọhnga ede ch'Ọvaar Ubinọkpaabyi kw'Shẹm okpobh,</para>
  <para style="q1" vid="GEN 9:26">tte Kenaan ọbạra ode ubira kw'Shẹm.<verse eid="GEN 9:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="GEN 9:27" />Tte Ubinọkpaabyi onemi nnem s'Japhẹt,</para>
  <para style="q1" vid="GEN 9:27">tte Japhẹt uruk k'akkira p'Shẹm,</para>
  <para style="q1" vid="GEN 9:27">tte Kenaan ode ubira kw'Japhẹt.”<verse eid="GEN 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 9:28" />Masẹ asi p'achi ọyagbin kk'akka phyibh, Noa ọbạra uruk icho arạbh chikhamfa ukuma jobh. <verse eid="GEN 9:28" /><verse number="29" style="v" sid="GEN 9:29" />Ma wọ uyini bẹ́, phyi-phyibh, wa Noa urukhu icho nnọhna mfa ukuma arạbh asenọfa ukuma jobh.<verse eid="GEN 9:29" /></para>
  <chapter eid="GEN 9" />
  <chapter number="10" style="c" sid="GEN 10" />
  <para style="s1">Efonamma ch'Noa</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 10:1" />Maa wọ ode udik kw'oten k'efonamma ch'Noa, ch'ede Shẹm, ọttạra Ham, ọttạra Japhẹt. Wa iva mbọ kk'abhạkha afhon ayok k'okpe kw'uwa asi p'achi ọyagbin kk'akka.<verse eid="GEN 10:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="GEN 10:2" />Ajunungva p'Japhẹt ofhonu wa abẹ ade: Goma, ọttạra Magọg, ọttạra Madai, ọttạra Javan, ọttạra Tubal, ọttạra Mẹshẹk, ọttạra Tiras.<verse eid="GEN 10:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="GEN 10:3" />Wa ajunungva p'Goma ade:</para>
  <para style="li2" vid="GEN 10:3">Askenaz, ọttạra Riphat, ọttạra Togama.<verse eid="GEN 10:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="GEN 10:4" />Ajunungva p'Javan ade:</para>
  <para style="li2" vid="GEN 10:4">Elisha, ọttạra Tarshish, ọttạra Kitim, ọttạra Dodanim. <verse eid="GEN 10:4" /><verse number="5" style="v" sid="GEN 10:5" />Wa iva p'iva p'anạng mba, bọ wa arukhu k'araangakhonga, n'abhaangẹ aruk k'asisek pabẹ, k'mfonamma sabẹ, ọttạra k'ifhon k'ifhon, ọnạng-ọnạng ọkpaak efhon chẹ. Ma wọ ode ẹnạmma ch'Japhẹt.<verse eid="GEN 10:5" /></para>
  <para style="s">Ẹnạmma ch'Ham</para>
  <para style="li1">
    <verse number="6" style="v" sid="GEN 10:6" />Ajunungva p'Ham ade:</para>
  <para style="li2" vid="GEN 10:6">Kush, ọttạra Ijip, ọttạra Put, ọttạra Kenaan.<verse eid="GEN 10:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="GEN 10:7" />Kush n'ọbhạkhẹ ofhon</para>
  <para style="li2" vid="GEN 10:7">Seba, ọttạra Havila, ọttạra Sabata, ọttạra Rama, ọttạra Sabạteka.</para>
  <para style="li1" vid="GEN 10:7">Wa Rama ọbhạkhẹ ofon</para>
  <para style="li2" vid="GEN 10:7">Sheba, ọttạra Dedan.<verse eid="GEN 10:7" /></para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" sid="GEN 10:8" />Kush wọ wa ọbạra ode otte kw'Nimrọd, kw'uwa ode okkemkpa kwididen k'ọyagbin. <verse eid="GEN 10:8" /><verse number="9" style="v" sid="GEN 10:9" />Nimrọd wa ode ọgbajinạng kwididen k'ititikha s'Ọvaar Ubinọkpaabyi. Akwẹma gwọ usi abẹ n'aben bẹ́, “Nimrọd, kw'ode ọgbajinạng kwididen kw'Ubinọkpaabyi kk'ọyọhbh ọnạnga.” <verse eid="GEN 10:9" /><verse number="10" style="v" sid="GEN 10:10" />Icheden-fhon s'uwa ọdạbhẹ ẹvaar ide ifhon s'Babẹl, ọttạra Ẹrẹk, ọttạra Akad, ọttạra Kalnẹ. Ifhon nnọ phyibh wa asẹ ining k'ukhubha kw'Shina. <verse eid="GEN 10:10" /><verse number="11" style="v" sid="GEN 10:11" />Ma wọ wa n'ubin ofona k'ukhubha kw'Asiriya, ọta usi ifhon s'Nineva, ọttạra Rehobot-Ir, ọttạra Kala, <verse eid="GEN 10:11" /><verse number="12" style="v" sid="GEN 10:12" />ọttạra Resen, kw'uning k'ngekha s'Nineva, ọttạra efhon-diden kw'Kala.<verse eid="GEN 10:12" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="13" style="v" sid="GEN 10:13" />Wa Ijip ọbhạkhẹ ofhon abạLud, ọttạra abAnam, ọttạra abạLehab, ọttạra abạNaphatu, <verse eid="GEN 10:13" /><verse number="14" style="v" sid="GEN 10:14" />ọttạra abạPatarus, ọttạra abạKasạlu, ọttạra abạKaphatọr. AbạKasạlu bọ wa abạra abhạkhe afhon ẹkhạma ch'aPhilistiya.<verse eid="GEN 10:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="GEN 10:15" />Kenaan, ẹma wa uchi eden ofhon Sidon, ọbạra ofhon aHet. <verse eid="GEN 10:15" /><verse number="16" style="v" sid="GEN 10:16" />Wa nkhạma s'ibin k'Kenaan ide: aJẹbus, ọttạra abAmọr, ọttạra aGirgash, <verse eid="GEN 10:16" /><verse number="17" style="v" sid="GEN 10:17" />ọttạra aHiv, ọttạra abạAk, ọttạra aSin, <verse eid="GEN 10:17" /><verse number="18" style="v" sid="GEN 10:18" />ọttạra abạAvad, ọttạra aZẹma, ọttạra aHamat.</para>
  <para style="p" vid="GEN 10:18">Wa nnạmma nnọ phyibh s'ibin k'Kenaan inyaamẹ, <verse eid="GEN 10:18" /><verse number="19" style="v" sid="GEN 10:19" />tạma k'Sidon kpira k'Gẹra tạrr atuma k'Gaza. Abẹ abạra aruk afona k'ẹkhạma ch'Sodom, ọttạra Gọmọra, ọttạra Adama, ọttạra Zeboyim, tạrr ukpira k'Lasha.<verse eid="GEN 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 10:20" />Ma wọ ode ẹnạmma ch'Ham k'mfonamma sabẹ, ọttạra k'mfhon sabẹ, ọttạra k'asisek pabẹ, ọttạra k'ifhon sabẹ.<verse eid="GEN 10:20" /></para>
  <para style="s">Ẹnạmma ch'Shẹm</para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 10:21" />Shẹm, kw'uwa Japhẹt otoru nnạm, ofhonu Ẹbẹr, ọttạra iva p'Ẹbẹr ofonu phyibh.<verse eid="GEN 10:21" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="22" style="v" sid="GEN 10:22" />Wa Shẹm ọbạra ofhon iva adwạkh-ọdwạk p'ade:</para>
  <para style="li2" vid="GEN 10:22">Ẹlam, ọttạra Ashur, ọttạra Arphaksad, ọttạra Lud, ọttạra Aram.<verse eid="GEN 10:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="GEN 10:23" />Aram ọbhạkhe ofhon</para>
  <para style="li2" vid="GEN 10:23">Uz, ọttạra Hul, ọttạra Gẹta, ọttạra Mash.<verse eid="GEN 10:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="GEN 10:24" />Arphaksad ofhonu Shẹla, kw'ọbạra ọbhạkhẹ ofhon Ẹbẹr.<verse eid="GEN 10:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="GEN 10:25" />Ẹbẹr wa ofhonu ajunungva afa: ocheden okpen</para>
  <para style="li2" vid="GEN 10:25">Pẹlẹg, kwuyini, ẹbhaangẹ, ukwuru bẹ́, kakhẹ okpe wọ wa anạng abhaangẹ k'ọyagbin, abẹ anyaamẹ aruk k'ibyi k'ibyi. Nwọkka kw'Pẹlẹg okpena Jọktan.<verse eid="GEN 10:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="GEN 10:26" />Jọktan wa ofhonu</para>
  <para style="li2" vid="GEN 10:26">Almodad, ọttạra Shẹlẹph, ọttạra Hazamavẹt, ọttạra Jẹra, <verse eid="GEN 10:26" /><verse number="27" style="v" sid="GEN 10:27" />ọttạra Hadoram, ọttạra Uzal, ọttạra Dikala, <verse eid="GEN 10:27" /><verse number="28" style="v" sid="GEN 10:28" />ọttạra Ọbal, ọttạra Abimayẹl, ọttạra Sheba, <verse eid="GEN 10:28" /><verse number="29" style="v" sid="GEN 10:29" />ọttạra Ophir, ọttạra Havila, ọttạra Jobab. Anạng mba phyibh wa abẹ ade iva p'Jọktan. <verse eid="GEN 10:29" /><verse number="30" style="v" sid="GEN 10:30" />Wa ẹkhạma ch'anạng mbọ arukhu ẹtạm k'Mẹsha tạrr ukpira k'Sẹphar, k'akpecho p'aning k'ukhubha kw'okpebhadudon n'uyin.<verse eid="GEN 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 10:31" />Maa wọ ode ẹnạmma ch'Shẹm k'mfonamma sabẹ, ọttạra k'mfhon sabẹ, ọttạra k'usisek fabẹ, ọttạra k'ifhon sabẹ.<verse eid="GEN 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 10:32" />Maa wọ wa ode mfonamma s'iva p'Noa, ator k'iva p'iva k'idifhon sabẹ. Wa ubin k'anạng mba, idifhon s'ọyagbin phyibh inyaamẹ, k'okpe kw'asi p'uwa achi ọyagbin kk'akka.<verse eid="GEN 10:32" /></para>
  <chapter eid="GEN 10" />
  <chapter number="11" style="c" sid="GEN 11" />
  <para style="s1">Ẹnyạng ch'egor-ogoru k'Babẹl</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 11:1" />Wa anạng ma ọyagbin phyibh akhaam efon jạnẹ, abẹ abạra akpaak udik gwạnọ. <verse eid="GEN 11:1" /><verse number="2" style="v" sid="GEN 11:2" />Masẹ anạng n'asenga afona k'ukhubha kw'okpebhadudon n'uyin, abẹ akwu ase ibyi s'isi ẹkpẹmẹ k'ukhubha kw'Shina, abẹ atima sẹ asi uruk kwabẹ.<verse eid="GEN 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 11:3" />Ma wọ abẹ n'abeni ayok bẹ́, “Tte ambạnga idọhngọ k'apyi k'apyi, anyaan sẹ tạrr asẹ igwu, ikpọhkhọ <char style="it">bẹ́ geng</char>.” Ma wọ abẹ abạng adọhngọ-pyi p'abẹ atim atera ata p'ọchọhm, ọttạra k'ana p'abạng-ọbạnga, p'apyi <char style="it">bẹ́ kkạạng</char>, atima atera idọhngọ idwukhasẹ. <verse eid="GEN 11:3" /><verse number="4" style="v" sid="GEN 11:4" />Ma wọ abẹ abeni bẹ́, “Akwu ansi efhon-diden, ambạra ansi ẹnyạng ch'egoru <char style="it">bẹ́ kotooong</char>, tạrr ikpira k'ọrạngkpaang, annạng amạna mba oyeni, deja, m'anwena-owena ma ọyagbin e.”<verse eid="GEN 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 11:5" />Ma wọ Ọvaar Ubinọkpaabyi ọsạk ukwu ose ofhon ngwọ, ọttạra ẹnyạng-gorada ch'ayokhanạng n'asi. <verse eid="GEN 11:5" /><verse number="6" style="v" sid="GEN 11:6" />Ọvaar Ubinọkpaabyi oben bẹ́, “Mạma ttạng, yeyema sabẹ atim ade ẹkhạma jạnẹ, p'n'akpaak efhon jạnẹ, abẹ asi ọttọhk demapfẹ mva, kw'uyini bẹ́, ọttọhk f'abẹ akhạmọ bẹ́, abẹ asi, f'abẹ n'mákke asi kòde. <verse eid="GEN 11:6" /><verse number="7" style="v" sid="GEN 11:7" />Akwu ansạkha anta ampfura efhon chabẹ, ọfha abẹ nạngẹ adạkhẹ ayok abhaang.”<verse eid="GEN 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 11:8" />Ma wọ Ọvaar Ubinọkpaabyi usi anạng mbọ awena k'ibyi sidede ma ọyagbin, ọbạra ukuma bẹ efhon-diden njọ sisi. <verse eid="GEN 11:8" /><verse number="9" style="v" sid="GEN 11:9" />Ẹgwọ usi abẹ ayeri ibyi nnọ Babẹl<note caller="+" style="f"><char style="fr" closed="false">11.9 </char><char style="fq" closed="false">Babẹl </char><char style="ft" closed="false">ọbạra okpena Babilọn, okhenka, k'eHiburu, </char><char style="fq" closed="false">Babẹl </char><char style="ft" closed="false">iyini ọttọhk masẹ, dạdạma.</char></note>, ukwuru bẹ́, ma ibyi nnọ rọ s'uwa Ọvaar Ubinọkpaabyi ufhuru mfhon s'ọyagbin phyibh. Tạma mạma wọ kw'Ọvaar Ubinọkpaabyi upfhuru bẹ, abẹ atạma wạwena abaabha ọyagbin.<verse eid="GEN 11:9" /></para>
  <para style="s1">Ẹnạmma ch'Shẹm</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 11:10" />Maa wọ ode ẹnạmma ch'Shẹm.</para>
  <para style="p" vid="GEN 11:10">K'icho ifa s'kk'isenga s'asi achi ọyagbin, k'okpe kw'Shẹm n'ode icho arạbh asen, ma wọ ofhonu Arphaksad. <verse eid="GEN 11:10" /><verse number="11" style="v" sid="GEN 11:11" />Masẹ kk'Arphaksad ofhona, wa Shẹm ọbạra uruk icho ẹnọhna ukuma arạbh asen, ọbạra ofhon ajunungva ọttạra apanạngva adwạkh-ọdwạk.<verse eid="GEN 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 11:12" />Masẹ Arphaksad ode icho ẹrạbh ukuma chi, ofhonu Shẹla. <verse eid="GEN 11:12" /><verse number="13" style="v" sid="GEN 11:13" />Masẹ kk'Shẹla ofhona, wa Arphaksad ọbạra uruk icho ẹnọhna ukuma ittaan, ọbạra ofhon ajunungva ọttạra apanạngva adwạkh-ọdwạk.<verse eid="GEN 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 11:14" />Masẹ Shẹla ode icho ẹrạbh ukuma jobh, wa ofhonu Ẹbẹr. <verse eid="GEN 11:14" /><verse number="15" style="v" sid="GEN 11:15" />Masẹ kk'Ẹbẹr ofhona, wa Shẹla ọbạra uruk icho ẹnọhna ukuma ittaan, ọbạra ofhon ajunungva ọttạra apanạngva adwạkh-ọdwạk.<verse eid="GEN 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 11:16" />Masẹ Ẹbẹr ode icho ẹrạbh ukuma sọnaachi, ofhonu Pẹlẹg. <verse eid="GEN 11:16" /><verse number="17" style="v" sid="GEN 11:17" />Masẹ kk'Pẹlẹg ofhona, wa Ẹbẹr ọbạra uruk icho ẹnọhna ukuma arạbh jobh, ọbạra ofhon ajunungva ọttạra apanạngva adwạkh-ọdwạk.<verse eid="GEN 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 11:18" />Masẹ Pẹlẹg ode icho ẹrạbh ukuma jobh, ofhonu Rewu. <verse eid="GEN 11:18" /><verse number="19" style="v" sid="GEN 11:19" />Masẹ kk'Rewu ofhona, wa Pẹlẹg ọbạra uruk icho arạbh jobh ukuma sọwạnọ, ọbạra ofhon ajunungva ọttạra apanạngva adwạkh-ọdwạk.<verse eid="GEN 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 11:20" />Masẹ Rewu ode icho ẹrạbh ukuma jobh-kamfa, ofhonu Serug. <verse eid="GEN 11:20" /><verse number="21" style="v" sid="GEN 11:21" />Masẹ kk'Serug ofhona, wa Rewu ọbạra uruk icho arạbh jobh ukuma isenọfa, ọbạra ofhon ajunungva ọttạra apanạngva adwạkh-ọdwạk.<verse eid="GEN 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 11:22" />Masẹ Serug ode icho ẹrạbh ukuma jobh, ofhonu Nahọr. <verse eid="GEN 11:22" /><verse number="23" style="v" sid="GEN 11:23" />Masẹ kk'Nahọr ofhona, wa Serug ọbạra uruk icho arạbh jobh, ọbạra ofhon ajunungva ọttạra apanạngva adwạkh-ọdwạk.<verse eid="GEN 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 11:24" />Masẹ Nahọr ode icho ẹrạbh ukuma sọwạnọ, ofhonu Tẹra. <verse eid="GEN 11:24" /><verse number="25" style="v" sid="GEN 11:25" />Masẹ kk'Tẹra ofhona, wa Nahọr ọbạra uruk icho arạbh asen ukuma sọnẹrạbh, ọbạra ofhon ajunungva ọttạra apanạngva adwạkh-ọdwạk.<verse eid="GEN 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 11:26" />Masẹ Tẹra ode icho arạbh attaan ukuma jobh, ofhonu Abram, ọttạra Nahọr, ọttạra Haran.<verse eid="GEN 11:26" /></para>
  <para style="s">Ẹnạmma ch'Tẹra</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 11:27" />Maa wọ ode ẹnạmma ch'Tẹra. Tẹra ofhonu Abram, ọttạra Nahọr, ọttạra Haran. Haran ọbạra ofhon Lọt. <verse eid="GEN 11:27" /><verse number="28" style="v" sid="GEN 11:28" />Wa Haran ope, urik otte. Ma okpe ngwọ, wa abẹ aning k'Ur, k'ukhubha kw'abạKaldi, kw'ode ofhon kw'uwa Haran ọmmaan.<verse eid="GEN 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 11:29" />Wa Abram ọttạra Nahọr atạk ipanạng. Ikwanạng kw'Abram okpen Sarai, kw'Nahọr okpena Milka. Milka ọkhaam nnwọkka kw'okpen Iska, Haran wọ wa ofhonu bẹ anạng afa. <verse eid="GEN 11:29" /><verse number="30" style="v" sid="GEN 11:30" />Okhenka, Sarai wa ode ujidim, nnwa nọ́maana.<verse eid="GEN 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 11:31" />Wa Tẹra ọtạk Abram kw'ode nnwa kwẹ, ọttạra Lọt, kw'ode nnwa kw'Haran, ọttạra Sarai, kw'ode ikwanạng kw'nnwa kwẹ, Abram, abẹ abina osenga afona k'ukhubha kw'Ur kw'aKaldi, ọfha abẹ afona k'ukhubha kw'Kenaan. Okhenka, masẹ abẹ aseng akpira k'Haran, abẹ n'akpong ma aruk ma.<verse eid="GEN 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 11:32" />Wa Tẹra ope ma Haran s'ode icho arạbh jobh ukuma asen.<verse eid="GEN 11:32" /></para>
  <chapter eid="GEN 11" />
  <chapter number="12" style="c" sid="GEN 12" />
  <para style="s1">Ubinọkpaabyi oyeri Abram</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 12:1" />K'okpe mạnna gwạnọ, Ọvaar Ubinọkpaabyi obeni Abram bẹ́, “Bina rik ẹkhạma chọ, ọttạra anạng pọ, ọttạra ẹchọhmfhạr ch'atte, afona k'ẹkhạma ch'm'ntibh-ọ.<verse eid="GEN 12:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="GEN 12:2" />“M'nsi-ọ ade otte kw'ẹkhạma chididen.</para>
  <para style="q2" vid="GEN 12:2">M'ndi-ọ, mbạra nsi-ọ ayin eche.</para>
  <para style="q1" vid="GEN 12:2">M'ade idia ánạng anạng saabhada.<verse eid="GEN 12:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="GEN 12:3" />M'nsi ọphyaam nnạng ọnạng kw'usi-ọ ọphyaam.</para>
  <para style="q1" vid="GEN 12:3">Ọnạng kw'ọsaakh-ọ, wọ m'nsaakhẹ.</para>
  <para style="q2" vid="GEN 12:3">Iyagbin <char style="it">bẹ́ wạmm</char> m'isenga k'akhọ-ọ itạkha idia.”<verse eid="GEN 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 12:4" />Osenga ma, Abram ubina osenga oche kw'Ọvaar Ubinọkpaabyi kk'ẹ obena, Lọt ọbạra ọtwạn abẹ. Wa Abram ode icho arạbh attaan ukuma chi, k'okpe kw'ubin k'Haran. <verse eid="GEN 12:4" /><verse number="5" style="v" sid="GEN 12:5" />Abram utim ikwanạng kwẹ, Sarai, ọttạra Lọt kw'ode nnwa kw'nnwọkka, ọbạra utima ẹkhaama chabẹ phyibh k'Haran ọttạra k'abira pabẹ phyibh, abina osenga afona k'ẹkhạma ch'Kenaan.<verse eid="GEN 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 12:6" />Wa abAbram aseng akpira k'Kenaan, abẹ abina afona k'Shẹkẹm, k'ibyi s'ichi chididen ebe, k'ibyi sabẹ ayeri Mọrẹ. Ma okpe ngwọ, wa anạng p'Kenaan atim arukhu ma ẹkhạma njọ. <verse eid="GEN 12:6" /><verse number="7" style="v" sid="GEN 12:7" />Ọvaar Ubinọkpaabyi uyin oben Abram bẹ́, “M'ntte ẹkhạma nja ọbọhk nnạng efonamma chọ.”</para>
  <para style="p" vid="GEN 12:7">Osenga ma, Abram usi ijabyi ma s'm'uninga okpobha Ọvaar Ubinọkpaabyi. Ma ibyi nnọ rọ s'uwa Ọvaar Ubinọkpaabyi uyini okhebh-ẹ.<verse eid="GEN 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 12:8" />Masẹ Abram ubin k'Shẹkẹm ọtwạkhọ ororo, tạrr ukpira k'akpecho p'Bẹtẹl, usi ukkira ma k'ngekha kw'Ayi, k'okpebhadudon, ọttạra k'Bẹtẹl, k'ọchọhkhadudon. Ma wọ Abram usi ijabyi sabẹ n'aninga afọhnọ ẹja anạng Ọvaar Ubinọkpaabyi, ọttạra sa m'ọgba uninga ose njọhm ọnạng Ọvaar Ubinọkpaabyi. <verse eid="GEN 12:8" /><verse number="9" style="v" sid="GEN 12:9" />Mạnna wọ Abram ubin osenga, ofona ororo okkeri ititikha k'ukhubha kw'Nẹgẹv kw'ofor k'Ijip.<verse eid="GEN 12:9" /></para>
  <para style="s1">Abram ọttạra Sarai anwa k'Ijip</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 12:10" />Ma okpe ngwọ, wa okwo f'ididen uning ma ukhubha ngwọ. Osenga ma, Abram ubina, ofona k'Ijip ọta uninga ma k'okpe nwa sạsạkhẹ. <verse eid="GEN 12:10" /><verse number="11" style="v" sid="GEN 12:11" />Masẹ abẹ n'aben bẹ akpira k'Ijip, Abram oben ikwanạng kwẹ bẹ́, “Sarai, amma nsong ma oche kw'ajibhi ikwanạng akpira. <verse eid="GEN 12:11" /><verse number="12" style="v" sid="GEN 12:12" />Ode anạng p'Ijip asong bẹ́, ọma ade ikwanạng kwaam, masẹ abẹ ase ajibhada pọ, abẹ m'aror bẹ́, abẹ afhọ-m, ọfha abẹ atạkh-ọ k'ọbada. <verse eid="GEN 12:12" /><verse number="13" style="v" sid="GEN 12:13" />Totokhạn, de amạna amkpir ma, de abẹ abạbh-ọ bẹ́, ade ikwanạng kwaam, kpaak bẹ bẹ́, amma ọttạra ọma ande ivọkka, ọfha nsenga ọma abẹ nninga akpen.”<verse eid="GEN 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 12:14" />Masẹ Abram ukpir k'Ijip, anạng p'Ijip ase bẹ́, k'udik ọkka, Sarai ọkhankẹ ujibh iminava. <verse eid="GEN 12:14" /><verse number="15" style="v" sid="GEN 12:15" />Masẹ anạng p'ọvaarchọhm kw'Phero kw'ode ọvaarnạng kw'Ijip, abạra ase ikwanạng nwọ ma, abẹ ata atọhnga ajibhada pẹ anạng ọvaarnạng. Abẹ atim-ẹ afona k'ọvaarchọhm. <verse eid="GEN 12:15" /><verse number="16" style="v" sid="GEN 12:16" />Wa Phero oseng Sarai abẹ, ujibh idik Abram abẹ. Osenga ma, ọnạng Abram nnạnga s'isaabh-ọsaabh masẹ arạkhạmaan, ọttạra mmaam, ọttạra nnyạnyaang-kwa, ọttạra abira p'ajunung, ọttạra p'ipanạng, ọttạra nten s'n'itọhkha ekpo, sabẹ ayeri kamẹl.<verse eid="GEN 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 12:17" />Ma wọ, Ọvaar Ubinọkpaabyi usi ikhạmana-pyibha inwa k'ẹchọhmfạr ch'Phero, ivạkha ẹma, ọttạra anạng p'ẹchọhmfạr chẹ phyibh, ukwuru ikwanạng kw'Abram Sarai. <verse eid="GEN 12:17" /><verse number="18" style="v" sid="GEN 12:18" />Ma wọ Phero ọbạbhọ Abram bẹ́, “Bạng udik gwọ asi maa? Asi yạn asi-m igbaan? Oseng yạn nạn khaam nákpaakha bẹ́, Sarai ode ikwanạng kwọ? <verse eid="GEN 12:18" /><verse number="19" style="v" sid="GEN 12:19" />Aseng mbạng apfẹ akpaakh-m bẹ́, ọma ọttạra ẹma abạnga ade ivọkka, abạra achera bẹ́, ntạkh-ẹ k'ọbada? Kkeri ikwanạng kwọ ma. Tạkh-ẹ, asọhng abẹ!”<verse eid="GEN 12:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 12:20" />Phero ọtwạr anạng pẹ itọhng bẹ́, abẹ atạkha Abram ata arik k'nnem s'isisek s'Ijip. Osenga ma, Abram ubina urik Ijip, utima ikwanạng kwẹ ọttạra ekpo pyẹ phyibh ofona.<verse eid="GEN 12:20" /></para>
  <chapter eid="GEN 12" />
  <chapter number="13" style="c" sid="GEN 13" />
  <para style="s1">Ẹbhaangẹ ch'Abram ọttạra Lọt</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 13:1" />Masẹ Abram otte Ijip ọbọhk, utim ikwanạng kwẹ ọttạra ẹkhaama chẹ phyibh, ọkpa nnạm ofona k'ẹkhạma ch'Nẹgẹv, k'ibyi s'uwa abẹ acheden abhing, wa Lọt ọtwạnọ abẹ.<verse eid="GEN 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 13:2" />Abram wa kk'ẹ ujibha m'ororo, ọkhaama itirakpo, ọttạra silva ọttạra gol k'ọsaabh.<verse eid="GEN 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 13:3" />Tạma ma Nẹgẹv, Abram ofon ororo k'osenga kwẹ, n'ubhing k'ibyi-k'ibyi tạrr ukwu ukpira k'Bẹtẹl, k'ibyi s'uwa ocheden ubhing, ọbạra uninga ma ibyi nnọ s'ining k'ngekha s'Bẹtẹl ọttạra Ayi. <verse eid="GEN 13:3" /><verse number="4" style="v" sid="GEN 13:4" />Ma wọ kw'uwa Abram kk'eden uchia usi ijabyi. Ma ibyi nnọ rọ s'ose njọhm ọnạng Ọvaar Ubinọkpaabyi.<verse eid="GEN 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 13:5" />Wa Lọt kw'n'ọtwạn Abram abẹ, ọgba ọkhaama arạkhạmaan ọttạra mmaam, ọttạra akkira p'atọhmnạng arukhu. <verse eid="GEN 13:5" /><verse number="6" style="v" sid="GEN 13:6" />Okhenka, wa asạsaarẹ p'abạra abenga itirakpo py'abẹ ma ibyi nnọ dạk kàde, ukwuru s'uwa ẹkhaama chabẹ n'ẹsaabhẹ ẹyọhnga isisek s'abẹ arukhu tạrr, abẹ dạkhẹ ibyi rạnẹ nákkia aruk. <verse eid="GEN 13:6" /><verse number="7" style="v" sid="GEN 13:7" />Wa anạng p'n'akkeri itirakpo p'Abram asi ẹkhọr ọttạra p'n'akkeri itirakpo p'Lọt. Ma okpe ngwọ, efona ch'Kenaan ọttạra efona ch'Pẹriz, abẹ atwạn aruk ma ẹkhạma njọ jạnẹ.<verse eid="GEN 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 13:8" />Osenga ma, iwu jạnẹ, Abram n'obeni Lọt bẹ́, “Ọma ọttạra amma ande ivotte. Nújibha bẹ́, anạng pọ ọttạra paam asi ẹkhọhr mesese. <verse eid="GEN 13:8" /><verse number="9" style="v" sid="GEN 13:9" />Isisek nna phyibh s'ining ma, ining k'amạna k'mbọhk. Tte amạna ammaangẹ ayok. Ọma tekha ukhubha kw'ọdaakh-ọ, ọfha aruk. Ode atek ukhubha kw'udimbọhk, amma m'ntạkha ukhubha kw'ọkwabọhk. Ode atek ọkwabọhk, amma m'ntạkha udimbọhk.”<verse eid="GEN 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 13:10" />Osenga ma, Lọt udira ichen okkeri isek s'ẹkpẹmẹ s'Jọrdan, ose bẹ́, asẹ ijibh-ujibh, ukwuru s'ikhaam asi masẹ owonu kw'Ọvaar Ubinọkpaabyi, ibạra ijibh masẹ isek s'Ijip k'ukhubha kw'Zoar. (Ma okpe ngwọ, wa Ubinọkpaabyi ifhon s'Sodom ọttạra Gọmọra tạm núdima). <verse eid="GEN 13:10" /><verse number="11" style="v" sid="GEN 13:11" />Ma wọ Lọt okkem ẹkpẹmẹ ch'Jọrdan k'ubungu, k'ukhubha kw'okpebhadudon. Mạnna wọ Lọt ọttạra Abram aseng abhaanga ayok.<verse eid="GEN 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 13:12" />Wa Abram urukhu, ẹma wa uning k'ẹkhạma ch'Kenaan, k'okpe kw'Lọt n'urukhu k'ifhon s'ibaang ọraanga, ọta usi ofon kwẹ ọbaanga ofon kw'Sodom. <verse eid="GEN 13:12" /><verse number="13" style="v" sid="GEN 13:13" />Anạng mbọ p'Sodom wa abẹ ade anạng p'akhaam ọmmaanapyibh kidam-kidaam, abẹ Ubinọkpaabyi k'nakpobha.<verse eid="GEN 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 13:14" />Masẹ Abram ọttạra Lọt k'ayok abhaanga, Ọvaar Ubinọkpaabyi ukwu oben Abram bẹ́, “Dira achen kkeri k'ibir-ibira, ọttạra k'ẹrạkh-ẹrạkha, abạra akkeri k'ukhubha kw'okpebhadudon, ọttạra k'ukhubha kw'ọchọhkha-dudon. <verse eid="GEN 13:14" /><verse number="15" style="v" sid="GEN 13:15" />Ẹkhạma njama ch'ase ma bẹ́ phyibh, m'ntạkha chẹ nnạng ọma, ọttạra iva pọ, ọttạra iva p'iva pọ, tạrr ipimmanitor. <verse eid="GEN 13:15" /><verse number="16" style="v" sid="GEN 13:16" />Amma m'nsi iva p'iva pọ asaabh mororo, masẹ uyiyeng kw'ọnạng nạmókke ubhik. <verse eid="GEN 13:16" /><verse number="17" style="v" sid="GEN 13:17" />Bina, senga baabha ẹkhạma nja k'adum, ọttạra ẹkpa chẹ phyibh, ukwuru bẹ́, achẹma jọ m'nnạng-ọ.”<verse eid="GEN 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 13:18" />Ma o, Abram osenga ọbaabha ẹkhạma njọ tạrr ukpira k'Hẹbrọn. Ukwu usi ukkira kwẹ ọbaanga nchi chididen s'Mamrẹ. Ma ibyi nnọ rọ s'uwa ọbạra usi ijabyi ọnạng Ọvaar Ubinọkpaabyi.<verse eid="GEN 13:18" /></para>
  <chapter eid="GEN 13" />
  <chapter number="14" style="c" sid="GEN 14" />
  <para style="s1">Abram ọkkaan Lọt</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 14:1" />Ma okpe ngwọ, wa Amaraphẹl wọ ode ọvaarnạng kw'Shina, Ariyok ode ọvaarnạng kw'Ẹlasa, Kedor-laomer ode ọvaarnạng kw'Ẹlam, Tidal ọbạra ode ọvaarnạng kw'Goyim.<verse eid="GEN 14:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 14:2" />Wa avaarnạng mbọ phyibh n'akwu afhunu ẹfa, ata arima ekpong ọttạra avaarnạng asen adwạkh-ọdwạk. Avaarnạng mbọ asen p'uwa ayok ata arima bẹ abẹ, akpen,</para>
  <para style="li1" vid="GEN 14:2">Bera, ọvaarnạng kw'Sodom,</para>
  <para style="li1" vid="GEN 14:2">Birasha, ọvaarnạng kw'Gọmọra,</para>
  <para style="li1" vid="GEN 14:2">Shinab, ọvaarnạng kw'Adama,</para>
  <para style="li1" vid="GEN 14:2">Shẹmebẹr, ọvaarnạng kw'Zeboyim,</para>
  <para style="li1" vid="GEN 14:2">ọttạra ọvaarnạng kw'Bẹla, kw'ọbạra okpen Zoar.<verse eid="GEN 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 14:3" />Wa avaarnạng mbọ asen akwu afhunu ẹfa, abẹ ata arima ekpong k'ipekhuma s'Sidim, kw'ode Ọraanga kw'Unung. <verse eid="GEN 14:3" /><verse number="4" style="v" sid="GEN 14:4" />Wa avaarnạng mbọ aning isekh-isek kw'Kedor-laomer k'icho jobh-kamfa, okhenka, abẹ n'afhumu ẹvaar chẹ k'icho kw'ottong jobh-kanttaan.<verse eid="GEN 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 14:5" />Ukwu ukpira icho sọnachi, Kedor-laomer ọttạra avaar mbọkha p'akhaam abẹ ẹgbạkha, abẹ akwu arima ekpong ọttạra avaarnạng mbọkha p'nạn adạkhẹ náchera bẹ́, aninga isekh-isek kwẹ. Abẹ akhema ẹkhạma ch'Rephayim, ch'ining k'ukhubha kw'Ashtẹrọt-Karnayim, abẹ abạra akhema ẹkhạma ch'Zuz ch'ining k'Ham, ọttạra ẹkhạma ch'Ẹm, k'ukhubha kw'Shavẹ-Kiriyatayim. <verse eid="GEN 14:5" /><verse number="6" style="v" sid="GEN 14:6" />Abẹ abạra ata akhema anạng p'ẹkhạma ch'Họr, p'arukhu k'akpecho p'Seir, abẹ akhubhu bẹ tạrr akpira Ẹl-Paran, kw'ọbaang k'ibyi s'anạng nạn nárukha. <verse eid="GEN 14:6" /><verse number="7" style="v" sid="GEN 14:7" />Masẹ abẹ akpir ma, abẹ akpa nnạm k'Ẹn-Mishpat, kw'ọbạra ode Kadẹsh, abẹ abạra ata akhema anạng p'ẹkhạma ch'Amalẹk, ọttạra ẹkhạma ch'Amọr ch'irukhu k'ukhubha kw'Hazazọn-Tamar.<verse eid="GEN 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 14:8" />Ma wọ, ọvaarnạng mbọ asen p'adạbhẹ Sodom, ọttạra Gọmọra, ọttạra Adama, ọttạra Zeboyim, ọttạra Bẹla (kw'ode Zoar), abin ata abe ekpong k'ipekhuma s'Sidim, <verse eid="GEN 14:8" /><verse number="9" style="v" sid="GEN 14:9" />arima avaarnạng mbọkha annebung abẹ, p'ade ọvaar Kedor-laomer kw'ọdạbhẹ Ẹlam, ọttạra Tidal kw'ọdạbhẹ Goyim, ọttạra Amaraphẹl kw'ọdạbhẹ Shina, ọttạra Ariyok, kw'ọdạbhẹ Ẹlasa, kw'uyini bẹ, avaarnạng annebung abe k'ukhubha gwạnọ, mbọkha asen abe k'ukhubha ngwọkha, bẹ abẹ arima ayok abẹ.<verse eid="GEN 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 14:10" />Wa ipekhuma nnọ s'Sidim ikhaam ape p'afhu ọttạra ana p'abạng-ọbạnga abạra apyi <char style="it">bẹ kkạng</char>. K'okpe kw'avaar p'Sodom ọttạra Gọmọra arạbhọ, ayok bạnọ atto ma ape mbọ, mbọkha arạbh atena k'akpecho. <verse eid="GEN 14:10" /><verse number="11" style="v" sid="GEN 14:11" />Wa avaarnạng mbọ annebung avạk aSodom ọttạra aGọmọra ẹkhaama chabẹ phyi-phyibh, ọttạra ichiakpo pyabẹ phyibh ana, abẹ atima afona. <verse eid="GEN 14:11" /><verse number="12" style="v" sid="GEN 14:12" />Wa abẹ agba avạkha Lọt kw'ode nnwa kw'nnwọkka kw'Abram, kw'uwa urukhu k'Sodom k'okpe kw'ekpong njọ etto, ọttạra ẹkhaama chẹ atima afona.<verse eid="GEN 14:12" /></para>
  <para style="s">Abram ọta ọkkaan Lọt sabẹ avạkh-ẹ</para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 14:13" />Ma okpe ngwọ, ọnạng wạnọ kw'uwa ọrạbhọ ekpong ọnnaanga, ukwu ọkpaak Abram kw'ode oHiburu-nạng bẹ́, abẹ kk'Lọt avạkha k'ẹmmạri. Ma okpe ngwọ, Abram wa urukhu ọbaanga nchi s'Mamrẹ kw'ubin Amọr, ọttạra ivọkka pẹ anạng afa p'akpen Ẹshkọl ọttạra Anẹr, p'uwa ade ayok-ikhaana pẹ. <verse eid="GEN 14:13" /><verse number="14" style="v" sid="GEN 14:14" />Masẹ Abram ọbhaang bẹ, abẹ kk'Lọt kw'ode nnwa kw'nnwọkka avạkha k'ibira atima afona, oyeri akpongnạng pẹ p'akke irima. Akpongnạng mbọ ade anạng p'ammaan ma ọchọhm kwẹ, abạra aruk abẹ. Akpongnạng mbọ wa ade anạng nnạbh chi ukuma chikhantaan. Wa Abram utim akpongnạng mbọ pẹ ukhubh anạng p'avạk Lọt tạrr abẹ akpira Dan. <verse eid="GEN 14:14" /><verse number="15" style="v" sid="GEN 14:15" />Ukwu ukpira k'irungu, Abram ọbhaangẹ akpongnạng pẹ k'ikhaana k'ikhaana, abẹ abaabha awawunanạng p'abẹ age ngekha. Abẹ arima bẹ abẹ, abẹ akhubhu bẹ tạrr akpira k'ẹkhạma ch'Hoba, k'ukhubha kw'Damaskọs. <verse eid="GEN 14:15" /><verse number="16" style="v" sid="GEN 14:16" />Osenga ma, Abram ọvạkha anạng mbọma ekpo ọna py'abẹ atạk kk'Sodom ọttạra Gọmọra, ọbạra utima Lọt, ọttạra ekpo pyẹ phyibh, ọttạra ipanạng p'abẹ avạk k'ibira, ọttạra anạng adwạkh-ọdwạk p'abẹ abạra avạkha k'ibira, ukwuna.<verse eid="GEN 14:16" /></para>
  <para style="s">Mẹlkizẹdẹk odo Abram</para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 14:17" />Masẹ Abram n'ukwun-ukwuna s'kk'ọvaar Kedor-laomer ọttạra avaarnạng mbọkha p'aning abẹ okhema k'ekpong, ọvaarnạng kw'Sodom uyin k'iyaan ọta okhebh-ẹ k'ipekhuma s'Shavẹ, ch'ede “Ipekhuma s'Ọvaarnạng.”<verse eid="GEN 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 14:18" />Ma wọ, Mẹlkizẹdẹk, kw'ode ọvaarnạng kw'Salẹm, ọbạra ode ọfọhnẹja kw'Ubinọkpaabyi kw'Ọyọhng, wa utim brẹd ọttạra atwuk okkena Abram. <verse eid="GEN 14:18" /><verse number="19" style="v" sid="GEN 14:19" />Ẹma Mẹlkizẹdẹk, odo Abram, oben bẹ́,</para>
  <para style="q1" vid="GEN 14:19">“Tte Ubinọkpaabyi kw'Ọyọhng,</para>
  <para style="q2" vid="GEN 14:19">kw'ọdạbhẹ idik phyibh,</para>
  <para style="q1" vid="GEN 14:19">kw'ọbạra oyok ẹrạng ọttạra isek,</para>
  <para style="q2" vid="GEN 14:19">odo ọma, Abram.<verse eid="GEN 14:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="GEN 14:20" />Tte ẹtọhnga iyima ẹnạng</para>
  <para style="q2" vid="GEN 14:20">Ubinọkpaabyi kw'Ọyọhng, kw'ọdạbhẹ idik phyibh,</para>
  <para style="q1" vid="GEN 14:20">kw'kk'ọ ẹfa ọnạnga</para>
  <para style="q2" vid="GEN 14:20">ch'atim akhema awawuna-nạng pọ.”</para>
  <para style="p" vid="GEN 14:20">Ma o, Abram ọtạkha ekpo pidede p'utim k'ekpong ukwuna, otobha k'ibyi jobh. Ọtạkha ukwung gwạnọ ma, ọnạng Mẹlkizẹdẹk.<verse eid="GEN 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 14:21" />Ma wo, ọvaarnạng kw'Sodom n'obeni Abram bẹ́, “Ọma tạkha ekpo pidede p'atim k'ekpong akwuna, tte ayokhanạng phyibh p'atim k'ekpong akwuna obọhk nạng-m.”<verse eid="GEN 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 14:22" />Abram ubhin ọvaarnạng kw'Sodom bẹ́, “Amma kk'nchekha k'ititikha s'Ọvaar Ubinọkpaabyi kw'Ọyọhng, kw'ọbạra oyok ẹrạng ọttạra isek bẹ́, <verse eid="GEN 14:22" /><verse number="23" style="v" sid="GEN 14:23" />ọttọhk vạnọ vạnọ f'ode pfọ, f'm'ntạkha ọtạkha kòde, tạma k'ẹnaanga-dikhi tạrr ukpira k'ndikhi s'ekpo py'mfhok pọ, ọfha kwạna nạng akwu aben bẹ́, ujibhada Abram ubin k'mbọhk sọ. <verse eid="GEN 14:23" /><verse number="24" style="v" sid="GEN 14:24" />Amma ọttọhk fidede pfọ, f'amma m'ntạkh-ọtạkha kòde, oyongha uchiattọhk f'anạng paam kk'achia, ọttạra okhebh f'anạng p'ator-m ekpong. Tte Anẹr, ọttạra Ẹshkọl, ọttạra Mamrẹ, atạkha okhebh fabẹ.”<verse eid="GEN 14:24" /></para>
  <chapter eid="GEN 14" />
  <chapter number="15" style="c" sid="GEN 15" />
  <para style="s1">Ọvaar Ubinọkpaabyi ọtạk echekha ọnạng Abram</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 15:1" />Ngwọ o oseng, Ọvaar Ubinọkpaabyi uyin okhebha Abram ọkpaakh-ẹ udik, oben-ẹ bẹ́,</para>
  <para style="q1" vid="GEN 15:1">“Abram, nạng-ọ ojor,</para>
  <para style="q2" vid="GEN 15:1">amma wọ nde ọkhọhnkpa kwọ,</para>
  <para style="q1" vid="GEN 15:1">m'mbạra nsi-ọ ẹtaam chididen.”<verse eid="GEN 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 15:2" />Masẹ Abram ọbhaang idik nnọ, ubhina bẹ́, “O Ọvaar Ubinọkpaabyi kw'Ẹfa phyibh, mbạng vọ m'anạng-m s'nạn nnwa nkhaam? Eliyeza kw'ubin Damaskọs sạng kw'm'uchi-m obo? <verse eid="GEN 15:2" /><verse number="3" style="v" sid="GEN 15:3" />Abram okhenka ode ubira kwaam, amma sạng mfhon-ẹ. Ọma nnwa khaam tạm nánạnga. Ubira nwa wọ m'uchi-m obo.”<verse eid="GEN 15:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 15:4" />Ma wọ, Ọvaar Ubinọkpaabyi ọkpaakhẹ Abram udik, oben-ẹ bẹ́, “Mma e, oche ngwọ sạng. Ubira nwa sạng kw'm'uchi-ọ obo, nnwa kw'ubin k'adima pọ wọ m'uchi-ọ obo e.”<verse eid="GEN 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 15:5" />Ma wọ, Ubinọkpaabyi utim Abram uyin k'iyaan, ọkhọhkh-ẹ ndudoru s'ining k'akpaang, oben-ẹ bẹ́, “Kk'asia oche kw'ndudoru isaabhẹ, ọnạng kòde kw'm'okke sẹ ubhik. Oche ngwọ gwọ kw'iva p'iva pọ kwạna m'asaabh.”<verse eid="GEN 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 15:6" />Abram ocher idik nnọ s'Ọvaar Ubinọkpaabyi ọkpaakh-ẹ k'udik ọkka. Osenga ma, Ọvaar ọtạkh-ẹ masẹ ọnạng kw'otor-otor k'akhẹ k'ititikha.<verse eid="GEN 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 15:7" />Ọvaar Ubinọkpaabyi ọbạra oben Abram bẹ, “Amma nde Ọvaarnạng kwọ, amma wọ wa ntạkh-ọ k'Ur, k'ẹkhạma ch'anạng p'Kaldi, nkwu nnạng ibyi nna, ọfha atạkha sẹ akhaama.”<verse eid="GEN 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 15:8" />Abram ubhin-ẹ bẹ́, “O Ọvaar Ubinọkpaabyi kw'Ẹfa phyibh, m'nsi yạn nsonga bẹ, isisek nna ide saam k'udik ọkka o?”<verse eid="GEN 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 15:9" />Ọvaar Ubinọkpaabyi ubhin-ẹ bẹ́, “Sọhng ata aror ọbhaamkwa, ọttạra uvukpokha, ọttạra uvudim p'ade icho k'ittaan-k'ittaan, ọttạra ikpua, ọttạra ikpembukha,<note caller="+" style="f"><char style="fr" closed="false">15.9 </char><char style="fq" closed="false">Ikpembukha </char><char style="ft" closed="false">means pigeon.</char></note> tima kwu.”<verse eid="GEN 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 15:10" />Abram ọtạk nten nnọ phyibh utima ukwu, ọbhaakha chidede k'ibyi ifa, ochok ikpokha sidede ikkeri oyok. Ọnọhn mạnkkeni vọ f'nạn akpokha afa nọ́bhaakha. <verse eid="GEN 15:10" /><verse number="11" style="v" sid="GEN 15:11" />Masẹ adẹdẹ asạk bẹ́, akwu achi abukhu p'ekpo mbyọ o, Abram ukhubh bẹ.<verse eid="GEN 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 15:12" />Okpe kw'iwu kk'ẹsạkha ma ẹchọhkha, Abram ọtaabh ọda <char style="it">bẹ gbroooong</char> urungubạnga kw'upyi <char style="it">bẹ kkạng</char>, ọbạra ojor-ojora, ububh-ẹ. <verse eid="GEN 15:12" /><verse number="13" style="v" sid="GEN 15:13" />Ma wọ, Ọvaar Ubinọkpaabyi Abram bẹ́, “Songa k'udik ọkka bẹ, iva p'iva pọ m'ade akhikhennạng k'ofhon kw'nạn kwabẹ núdia. Anạng m'age bẹ k'ibira, abạra anạng bẹ irem k'ọttọhk masẹ icho ẹnọhna. <verse eid="GEN 15:13" /><verse number="14" style="v" sid="GEN 15:14" />Okhenka, amma m'nnạng ẹkhạma ch'ege bẹ k'ibira irem. K'ekpongannạm-kpe, abẹ m'atima ẹkhaama chididen annaanga ibira ch'ofhon ngwọ. <verse eid="GEN 15:14" /><verse number="15" style="v" sid="GEN 15:15" />Ọma oyeni kakhọ k'ifor, m'aruk akpen tạrr atạm, brasẹ n'ape ator ab'atte k'idira. <verse eid="GEN 15:15" /><verse number="16" style="v" sid="GEN 15:16" />Ottong igbọ innebung s'iva p'iva pọ, abẹ m'akwuna ma isisek nna, ukwuru bẹ́, okpe tạm nóbenga kw'm'nkubh anọng p'Amọr ma ibyi nna, ukwuru mpyibha sabẹ.”<verse eid="GEN 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 15:17" />Okpe kw'ududon kk'udima, irungu ipyi <char style="it">bẹ kkạng</char>. Abram ose isọhkha s'ekpon ining k'ẹtaanga, ọttạra ikke s'n'iyạma ekpon, ch'eseng k'ngekha s'nten nnọ sabẹ abhaak akpokha afa, eseng efona. <verse eid="GEN 15:17" /><verse number="18" style="v" sid="GEN 15:18" />Ma iwu njọ, Ọvaar Ubinọkpaabyi ọtạk echekha oben Abram bẹ́, “Iva p'iva pọ bọ m'ntạkha isisek nna, tạma k'ọraanga kw'Ijip, tạrr ukpira k'ọraanga kw'Yupharetes bẹ́, abẹ akhaama. <verse eid="GEN 15:18" /><verse number="19" style="v" sid="GEN 15:19" />Ifhon s'irukhu ma isek nnọ ide: Ken, ọttạra Keniz, ọttạra Kadạmọn, <verse eid="GEN 15:19" /><verse number="20" style="v" sid="GEN 15:20" />ọttạra Het, ọttạra Pẹriz, ọttạra Rephayim, <verse eid="GEN 15:20" /><verse number="21" style="v" sid="GEN 15:21" />ọttạra Amọr, ọttạra Kenaan, ọttạra Girgash, ọttạra aJẹbus.”<verse eid="GEN 15:21" /></para>
  <chapter eid="GEN 15" />
  <chapter number="16" style="c" sid="GEN 16" />
  <para style="s1">Hagar ọttạra nnwa kwẹ Ishimayẹl</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 16:1" />Wa Sarai kw'ọba Abram, nnwa nọ́maana. Okhenka, ọkhaam ubira kw'ikwanạng kw'ubin Ijip kw'okpen Hagar. <verse eid="GEN 16:1" /><verse number="2" style="v" sid="GEN 16:2" />Ma wọ, n'obeni Abram bẹ́, “Masẹ Ọvaar Ubinọkpaabyi nạn khaam ọmaan nọ́nạnga, n'mben bẹ́ mphyem-ọ bẹ́, atạkha ubira nwa kwaam ayima abẹ, de m'nsenga ma akhẹ nkhaama nnwa o.” Abram ochera udik ngwọ kw'Sarai ọkpaakhẹ. <verse eid="GEN 16:2" /><verse number="3" style="v" sid="GEN 16:3" />Masẹ Abram kk'icho jobh urukha k'Kenaan, ma wọ Sarai n'ọtạk Hagar kw'ode ubira kwẹ kw'ubin Ijip, ọnạng Abram bẹ́, uyima abẹ. <verse eid="GEN 16:3" /><verse number="4" style="v" sid="GEN 16:4" />Abram uyima Hagar abẹ, ukwu utima ifhạr.</para>
  <para style="p" vid="GEN 16:4">Masẹ Hagar n'osong bẹ́, kk'ifhạr utima, ọtạma ọkka kwẹ kw'ọchọhm myạmyạna <verse eid="GEN 16:4" /><verse number="5" style="v" sid="GEN 16:5" />Osenga ma, Sarai ọdwạkh-ẹ, n'obeni Abram bẹ́, “Ọma wọ awọhkhọ irem nna s'n'ndọhbh ma e. Amma wọ ntạk ubira kwaam nnạng-ọ bẹ́, ayima abẹ, mantọhmma, masẹ n'osong bẹ́, kk'ifhạr utima, n'ose-m ẹsẹkha. Ọvaar Ubinọkpaabyi mạnkkeni wọ m'usi iponga saam ọma abẹ.”<verse eid="GEN 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 16:6" />Abram oben Sarai bẹ́, “Diri ettem, uminanwa nwọ ode ubira kwọ, si-ẹ oche kw'ọdaakh-ọ.” Tạma mạma o, Sarai ọtạma Hagar gbạgbạbhọ. Hagar osenga ma, ọrạbh.<verse eid="GEN 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 16:7" />Masẹ Hagar kk'ọrạbha, oseng-eden kw'Ọvaar Ubinọkpaabyi iyin abẹ k'isipe ch'ining k'ibyi s'owór, isipe ch'ining k'ọkkaden kw'oten k'Shur. <verse eid="GEN 16:7" /><verse number="8" style="v" sid="GEN 16:8" />Ma wọ, itọhmọ nwọ oben Hagar bẹ́, “Ọma Hagar, kw'ade ubira kw'Sarai, abin mạn o? N'ata mạn?” Hagar ubhin-ẹ bẹ́, “Amma n'nnạbh k'nna kwaam k'mbọhk ma e.”<verse eid="GEN 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 16:9" />Oseng-eden kw'Ọvaar Ubinọkpaabyi oben-ẹ bẹ́, “Kpa nnạm tor akka, abạra asạkha echo anạng-ẹ.” <verse eid="GEN 16:9" /><verse number="10" style="v" sid="GEN 16:10" />Oseng-eden nwọ kw'Ọvaar Ubinọkpaabyi ọbạra oben-ẹ bẹ́, “Amma m'nsi iva p'iva pọ asaabh-ọsaabh. Abẹ m'asaabh k'oche kw'ọnạng nạn bẹ mókke ubhik.”<verse eid="GEN 16:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 16:11" />Itọhmọ nnọ s'Ọvaar Ubinọkpaabyi ibạra ittạra-ẹ bẹ́,</para>
  <para style="q1" vid="GEN 16:11">“Ifhạr nnọ s'atim ma,</para>
  <para style="q2" vid="GEN 16:11">m'amaan ujunung,</para>
  <para style="q1" vid="GEN 16:11">m'akpẹ-ẹ Ishimayẹl,</para>
  <para style="q2" vid="GEN 16:11">ukwuru bẹ́, Ọvaar Ubinọkpaabyi kk'ẹmạng chọ ch'irem ọbhaanga.<verse eid="GEN 16:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="GEN 16:12" />Ishmayẹl nwọ m'usi idik-abhaang masẹ ẹnyạnyaang ch'abẹ nạn titira nátira,</para>
  <para style="q1" vid="GEN 16:12">m'ọkhaama iwawuna ọnạng kwidede abẹ,</para>
  <para style="q2" vid="GEN 16:12">ọnạng kwidede m'ọbạra uwun-ẹ,</para>
  <para style="q1" vid="GEN 16:12">anạng pẹ abẹ múruk.”<verse eid="GEN 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 16:13" />Ma wọ, Hagar n'obeni ifor sẹ bẹ́, “N'ode bẹ́, Ọvaar Ubinọkpaabyi wọ kw'nse maa, bạra ntim nnukhu akpen maa o?” Osenga ma, oyer-ẹ eche ch'ikpukpobha bẹ́, Ẹl-roi<note caller="+" style="f"><char style="fr" closed="false">16.13 </char><char style="ft" closed="false">K'eHiburu, Ẹl-Roi uyini, Ọma ade Ubinọkpaabyi kw'okker-m.</char></note>, ọbẹ́, “Amma kk'Ubinọkpaabyi kw'okker-m nsia.”<verse eid="GEN 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 16:14" />Osenga ma, anạng n'ayeri isipe njọ, Beer-Lahai-Roi<note caller="+" style="f"><char style="fr" closed="false">16.14 </char><char style="ft" closed="false">K'eHiburu, Beer-Lahai-Roi uyini, Isipe ch'ẹma kw'urukhu akpen kw'ose-m.</char></note>, kw'uyini, “Isipe ch'ẹma kw'urukhu akpen, kw'ose-m.” Isipe njọ ining k'ngekha s'Kadẹsh ọttạra Bẹrẹd.<verse eid="GEN 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 16:15" />Ma wọ, Hagar ọmaanẹ ujunungnwa ọnạng Abram. Abram ukpuẹ-ẹ Ishimayẹl. <verse eid="GEN 16:15" /><verse number="16" style="v" sid="GEN 16:16" />Wa, Abram ode icho arạbh annebung ukuma isajạnẹ, k'okpe kw'Hagar ọmmaanẹ Ishimayẹl.<verse eid="GEN 16:16" /></para>
  <chapter eid="GEN 16" />
  <chapter number="17" style="c" sid="GEN 17" />
  <para style="s1">Echekha ch'ọkpọkkrọkkọ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 17:1" />K'okpe kw'uwa Abram ode icho arạbh annebung ukuma sọhnẹrạbh, Ọvaar Ubinọkpaabyi uyin Abram abẹ, oben-ẹ bẹ́, “Amma wọ nde Ubinọkpaabyi kw'Ẹfa phyibh, senga k'eden chaam, abạra asi ẹmmaana ch'etor-otor. <verse eid="GEN 17:1" /><verse number="2" style="v" sid="GEN 17:2" />Amma m'nsi oche kw'uwa kk'nchekha nnạng-ọ bẹ́, iva p'iva pọ kwạna m'akhaankẹ asaabh-ọsaabh.”<verse eid="GEN 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 17:3" />Masẹ Abram ọbhaang idik nnọ, ọrạkha uttima ititikha k'isek. Ma wọ, Ọvaar Ubinọkpaabyi oben-ẹ bẹ́, <verse eid="GEN 17:3" /><verse number="4" style="v" sid="GEN 17:4" />“Maa wọ ode udik kw'nchekhi nnạng-ọ, bẹ́, m'ade otte kw'nkhạma saabhada. <verse eid="GEN 17:4" /><verse number="5" style="v" sid="GEN 17:5" />M'mbạra nnạng-ọ eche ẹbhachẹ, dạkhẹ Abram mákpena, m'akpena Abraham, eche ch'iyini, otte kw'nkhạma saabhada. <verse eid="GEN 17:5" /><verse number="6" style="v" sid="GEN 17:6" />M'nsi-ọ afhon iva k'ọsaabh, nkhạma s'isaabh-ọsaabh m'ibina ma akhọ, ọttạra avaar pididen. <verse eid="GEN 17:6" /><verse number="7" style="v" sid="GEN 17:7" />Amma m'nsi echekha chaam ọma abẹ ẹbạra ede echekha ch'iva p'iva pọ, bẹ́ amma m'nde Ubinọkpaabyi kwọ, ọttạra Ubinọkpaabyi kw'iva p'iva pọ tạrr ipimmanitor. <verse eid="GEN 17:7" /><verse number="8" style="v" sid="GEN 17:8" />Amma m'ntạkha isek nna s'Kenaan s'mantọmma arukhu masẹ ukhikhennạng nnạng ọma, ọttạra efona chọ, abạnga akhaama sẹ tạrr ipimmanitor. Amma m'nde Ubinọkpaabyi kwabẹ.”<verse eid="GEN 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 17:9" />Ma wọ, Ubinọkpaabyi obeni Abraham bẹ́, “Node ọma ọttạra iva p'iva pọ, oyonga abạnga m'achok echekha nja chaam tạrr ipimmanitor. <verse eid="GEN 17:9" /><verse number="10" style="v" sid="GEN 17:10" />Maa wọ ode echekha ch'amma ọma abẹ, ọttạra iva p'iva pọ. Echekha ch'abạnga m'achok ede bẹ́, ujunung kwidede kw'uning bạnga abẹ m'usi ọkpọkkrọkkọ. <verse eid="GEN 17:10" /><verse number="11" style="v" sid="GEN 17:11" />Ẹnạm-kpara njọ m'ede ẹkhọhkha ch'echekha ch'amma ọttạra abạngama abẹ. <verse eid="GEN 17:11" /><verse number="12" style="v" sid="GEN 17:12" />K'igbọ s'm'ikwu k'ororo, ujunungnwa kwidede kw'okke iwu isenọttaan, oyonga abẹ m'asi-ẹ ọkpọkkrọkkọ. Ajunung phyibh p'ammaan kabạnga k'ichọhm, ọttạra ayok p'abạnga adebhi k'akpokha p'nạn iva pabạnga ade, oyonga abẹ m'asi bẹ ọkpọkkrọkkọ. <verse eid="GEN 17:12" /><verse number="13" style="v" sid="GEN 17:13" />Ọbạra p'ammaan k'abạnga k'ichọhm bọ, ọbạra ode p'abạnga adebhi k'abạnga k'akpokha o, oyonga abạnga m'asi bẹ ọkpọkkrọkkọ. Echekha chaam ch'ede efhora ch'abạnga k'ifor m'ede echekha ch'ipimmanitor. <verse eid="GEN 17:13" /><verse number="14" style="v" sid="GEN 17:14" />Ujunung kwidede kw'nạn ọkpọkkrọkkọ núsia, tte anạng pẹ akhạm-ẹ ikhaana, ukwuru bẹ́, kk'echekha chaam ufhuma chuchok.”<verse eid="GEN 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 17:15" />Ubinọkpaabyi ọbạra oben Abraham bẹ́, “Node ikwanạng kwọ, Sarai, ẹma dạkhẹ Sarai mókpena, bạra okpena Sara. <verse eid="GEN 17:15" /><verse number="16" style="v" sid="GEN 17:16" />Amma m'ndiẹ-ẹ, mbạra nsi-ẹ ọmaan ujunungnwa ọnạng-ọ. Amma m'ndo Sara bẹ́, ode ọkka kw'nkhạma s'isaabh-ọsaabh. Avaar pididen m'abina ma akhẹ k'ntaak.”<verse eid="GEN 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 17:17" />Osenga ma, Abraham ọrạkha ukhubha ititikha k'isisek, ọnạng Ubinọkpaabyi ikpukpobha, ọmma asa k'ettem oben bẹ́, “Ma, ọnạng masẹ akhaam kw'kk'icho arạbh asen ukkia, s'm'ọbạra ofhon nnwa-o? Ma, Sara kw'ọbạra ode icho arạbh annebung ukuma jobh, s'm'ọmaan adạkhẹ nnwa?”<verse eid="GEN 17:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 17:18" />Ma wọ, Abraham ophyemi Ubinọkpaabyi bẹ́, “Tte Ishimayẹl ọtạkha idia chọ khadẹ o!”<verse eid="GEN 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 17:19" />Ma o, Ubinọkpaabyi ọbẹ́, “Uwe e, okhenka, ikwanạng kwọ Sara, m'ọmaan-ọ ujunungnwa kw'm'akpe-ẹ Isaak. M'nchok echekha ch'ẹma amma abẹ, ede echekha ch'ipimmanitor, ch'm'ẹbạra ininga ẹnạng iva p'iva pẹ tạrr ipimmanitor. <verse eid="GEN 17:19" /><verse number="20" style="v" sid="GEN 17:20" />Node udik kw'oten k'Ishimayẹl, kk'ọ mmanga e. K'udik ọkka, amma m'ndiẹ-ẹ odo e. M'nsi-ẹ ofhon iva, mbạra nttạr-ẹ ọsaabh. Ẹma m'ofhon avaar-va jobh-kamfa, mbạra nsi-ẹ ode ẹkhạma chididen. <verse eid="GEN 17:20" /><verse number="21" style="v" sid="GEN 17:21" />Okhenka, amma m'nchok echekha chaam ọttạra Isaak kw'Sara m'ọmaan ọnạng-ọ ode cho k'okpe demakwẹ ngwa.”<verse eid="GEN 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 17:22" />Masẹ Ubinọkpaabyi kk'udik ngwọ ọkpaakha phyibh, ubina urik Abraham ma.<verse eid="GEN 17:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 17:23" />Ma iwu njọ jạnẹ, Abraham ọtạk Ishimayẹl kw'ode ujunungnwa kwẹ, ọttạra ajunung phyibh p'ammaan k'ẹchọhmfạr chẹ, ọttạra ayok p'odebhi k'akpokha, usi bẹ ọkpọkkrọkkọ oche kw'Ubinọkpaabyi oben-ẹ bẹ́, usi. <verse eid="GEN 17:23" /><verse number="24" style="v" sid="GEN 17:24" />Wa Abraham ode icho arạbh annebung ukuma sọnẹrạbh okpe kw'abẹ asi-ẹ ọkpọkkrọkkọ. <verse eid="GEN 17:24" /><verse number="25" style="v" sid="GEN 17:25" />Nnwa kwẹ, Ishimayẹl, ode icho jobh-kantaan okpe kw'usi ọkpọkkrọkkọ. <verse eid="GEN 17:25" /><verse number="26" style="v" sid="GEN 17:26" />Wa abẹ asi Abraham ọttạra nnwa kwẹ Ishimayẹl ọkpọkkrọkkọ ma iwu njọ jạnẹ. <verse eid="GEN 17:26" /><verse number="27" style="v" sid="GEN 17:27" />Wa Abraham ọttạra ujunung kwidede kw'uning k'akhẹ k'ọchọhm, tạrr oseng k'ayok p'odebhi k'akpokha k'mbọhk s'ukhikhennạng, abạra asi ọkpọkkrọkkọ.<verse eid="GEN 17:27" /></para>
  <chapter eid="GEN 17" />
  <chapter number="18" style="c" sid="GEN 18" />
  <para style="s1">Ubinọkpaabyi ochekhi bẹ, Sara m'ọmaan ujunungnwa</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 18:1" />Wa Ọvaar Ubinọkpaabyi uyini Abraham abẹ k'okpe kw'uning ẹyạr k'ẹchọhmma ch'ukkira kwẹ, ọbaanga nchi s'ididen s'Mamrẹ, k'ọyakpattem kw'iwu ẹkhạmọ <char style="it">bẹ gbạạng</char>. <verse eid="GEN 18:1" /><verse number="2" style="v" sid="GEN 18:2" />Masẹ Abraham udir ichen ose s'ajunung attaan abe abaang-ẹ, ubina k'ibyi s'uning, osenga k'ẹbhạr-k'ẹbhạr okhebha bẹ k'ibyi sabẹ abe, ọrạkha usim bẹ k'ikpukpobha. <verse eid="GEN 18:2" /><verse number="3" style="v" sid="GEN 18:3" />Oben bẹ́, “Aro kwaam, ode kk'ọphyaam nkhaama kakhọ k'ititikha, amma ọtọhmnạng kwọ káseng arik. <verse eid="GEN 18:3" /><verse number="4" style="v" sid="GEN 18:4" />Tte abẹ atima asi akwu abạnga akpobhu mfhok, ọfha abạnga abạra akwokha ọyọhng ma uchikpok ngwa. <verse eid="GEN 18:4" /><verse number="5" style="v" sid="GEN 18:5" />Tte ntima uchiattọhk nkwu abạnga achi, ọfha abạnga akhaama ẹfa ch'abạnga m'afona ororo k'osenga kw'abạnga, s'abạnga kk'akpira k'ibyi s'ọtọhmnạng kwabạnga.”</para>
  <para style="p" vid="GEN 18:5">Abẹ abhin-ẹ bẹ́, “Ọbaan ma, si oche kw'ettem chọ ẹtọhmọ.”<verse eid="GEN 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 18:6" />Ma wọ, Abraham ubin ẹbhạr-ẹbhạr ọta okhebha Sara k'ukkira ẹtaanga, oben-ẹ bẹ́, “Yoma akpobhu-mbọhk attaan p'abubuma tima si brẹd ẹbhạr-ẹbhạrẹ.”<verse eid="GEN 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 18:7" />Ma wọ, Abraham ọrạbhọ ofona k'uvupa, ọta otekha ọbhaam-nwa ọkkakwẹ, ọnạng ọtọhmnạng kwẹ wạnọ, kw'udwuk-udwukha ọfhọ chẹ, utima usi uchiattọhk. <verse eid="GEN 18:7" /><verse number="8" style="v" sid="GEN 18:8" />Ukwu ọtạkha abasi ọttạra ọbhaam-nwa nwọ kw'abẹ kk'abhabha, obera bẹ. Masẹ abẹ n'achi uchiattọhk mvọ, ẹma Abraham obe ọbaanga bẹ ma uchikpok kw'abẹ aning n'achi ọttọhk.<verse eid="GEN 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 18:9" />Anạng mbọ n'abạbhọ Abraham bẹ́, “Ikwanạng kwọ, Sara khẹnwạn?” Ubhin bẹ bẹ́, “Uning ka ukkira ẹtaanga.”<verse eid="GEN 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 18:10" />Ma wọ, ọnạng wạnọ k'ngegha s'anạng mbọ attaan, kw'ode Ubinọkpaabyi, obeni bẹ́, “K'udik ọkka, k'okpe demakwẹ ngwa ode cho, m'mbạra mkpa nnạm nkwu ndibh bạnga ma ibyi nna. Sara kw'ode ikwanạng kwọ, m'ọmaan ujunung-nwa.”</para>
  <para style="p" vid="GEN 18:10">Masẹ ọnạng nwọ n'ọkpaak idik nnọ ọnạng Abraham, wa Sara uning k'ẹtaanga, sabẹ akpa nnạm avạra ayok, n'ọkhọhmọ bẹ itọhng. <verse eid="GEN 18:10" /><verse number="11" style="v" sid="GEN 18:11" />Ma okpe ngwọ, Abraham ọttạra Sara kk'atạma k'idaam k'idaam, Sara dạkhẹ ifor kạnótto. <verse eid="GEN 18:11" /><verse number="12" style="v" sid="GEN 18:12" />Ma wọ, Sara ọmma asa, oben k'ettem bẹ́, “Masẹ kk'ntạma, aro kwaam ọtạm, s'm'nkhaama idạdaakha s'ujunung m'antwạn anyima-o?”<verse eid="GEN 18:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 18:13" />Ma wọ Ọvaar Ubinọkpaabyi ọbạbhọ Abraham bẹ́, “Sara oseng mbạng apfẹ ọmma asa oben k'ettem bẹ́, ‘Amma s'm'mbạra mmaan nnwa ma k'atạm mba dạkhẹ-o?’ <verse eid="GEN 18:13" /><verse number="14" style="v" sid="GEN 18:14" />Udik uning ka, kw'Ọvaar Ubinọkpaabyi nạn mókke usi? K'okpe demakwẹ ngwa ode cho, amma m'mbạra mkpa nnạm nkwu ndibh bạnga, Sara m'ọmaan ujunung-nwa.”<verse eid="GEN 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 18:15" />Masẹ Sara ọbhaang udik ngwọ, ojor-ẹ. Osenga ma, okhona, oben bẹ́, “Amma asa nạ́mma ro.”</para>
  <para style="p" vid="GEN 18:15">Ma wọ, Ọvaar Ubinọkpaabyi oben-ẹ bẹ́, “K'udik ọkka, ọma kk'asa amma.”<verse eid="GEN 18:15" /></para>
  <para style="s1">Abraham uchini Ubinọkpaabyi k'ncho s'aSodom</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 18:16" />Masẹ anạng mbọ attaan abin bẹ́, abẹ afona, abẹ abina achen akkeri k'ofhon kw'Sodom. Wa Abraham ọtwạn bẹ abẹ, ọta urik bẹ k'eden. <verse eid="GEN 18:16" /><verse number="17" style="v" sid="GEN 18:17" />Ma wọ, Ọvaar Ubinọkpaabyi obeni ifor sẹ bẹ́, “Udik ngwa kw'n'mben bẹ́, nsi ma, nọ́baana bẹ, ndubh Abraham. <verse eid="GEN 18:17" /><verse number="18" style="v" sid="GEN 18:18" />K'udik ọkka, iva p'iva p'Abraham m'akwu ade afanạng, ọttạra ẹkhạma chididen, m'osenga ma, idifhon s'iyagbin phyibh ikhaama idia. <verse eid="GEN 18:18" /><verse number="19" style="v" sid="GEN 18:19" />Amma kk'ẹ ntekha bẹ́, utima iva pẹ, ọttạra ẹchọhmfhạr chẹ phyibh, osenga k'eden ch'Ọvaar Ubinọkpaabyi, ọbạra uruk akpen p'ator-otor, ọfha Ọvaar Ubinọkpaabyi ọnạng ẹyaakha k'echekha ch'kk'usia ọnạng Abraham.”<verse eid="GEN 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 18:20" />Ma wọ, Ọvaar Ubinọkpaabyi obeni bẹ́, “Ẹgạma ch'eten k'idik-tạma s'Sodom ọttạra s'Gọmọra ẹbạr-ọbạr, mpyibha sabẹ kk'ibạra iyong-oyongu. <verse eid="GEN 18:20" /><verse number="21" style="v" sid="GEN 18:21" />M'nsạkha, ọfha nta nse de mpyibha sabẹ kk'asia ipyibhi ikpira ẹgạma ch'kk'mmaanga. Ode akwẹ nạn oche ngwọ núdia, amma m'nsong-osonga.”<verse eid="GEN 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 18:22" />Ma wọ, ajunung mbọ abhạkhẹ nnạm akkeri ititikha k'ukhubha kw'Sodom. Okhenka, Abraham ofon ororo obe Ọvaar Ubinọkpaabyi k'ititikha. <verse eid="GEN 18:22" /><verse number="23" style="v" sid="GEN 18:23" />Abraham osenga ofora Ọvaar Ubinọkpaabyi k'ifor, ọbạbh-ẹ bẹ́, “Ma, m'agbama anạng p'ẹmaana ọkkachẹ, attra k'anạng p'ọmmaana-pyibh afhọ o? <verse eid="GEN 18:23" /><verse number="24" style="v" sid="GEN 18:24" />Ode ase anạng nạbh afa ukuma jobh p'asi ẹmmaana ọkkachẹ ma ofhon ngwọ, sạm'ase anạng mbọ ikwosi, atte ofhon ngwọ ọbọhk? <verse eid="GEN 18:24" /><verse number="25" style="v" sid="GEN 18:25" />Mạnna móde ro, bẹ́, ọma m'atạkha anạng p'asi ẹmaana ọkkachẹ attra k'ayok p'asi mpyibha, afhọ. Oche ngwọ móde ro! Ka yạn wọ kw'ọkpaar-aponga kw'ọyagbin nạn udik ọkka músi?”<verse eid="GEN 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 18:26" />Ma wọ, Ọvaar Ubinọkpaabyi ubhin-ẹ bẹ́, “De amma nse anạng nạbh afa ukuma jobh p'asi ẹmaana ọkkachẹ ma ofhon ngwọ, m'nsenga anạng mbọ abẹ, ntte ofhon ngwọ ọbọhk.”<verse eid="GEN 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 18:27" />Ma wọ, Abraham ọbạbhọ dạkhẹ bẹ́, “Totokhạn, Ọvaar Ubinọkpaabyi kwaam, s'ọbạra ọkwọn ode bẹ, k'ọttọhk nạ́mfua, amma m'mbạr ettem mkpaak udik nnạng-ọ, <verse eid="GEN 18:27" /><verse number="28" style="v" sid="GEN 18:28" />de ase anạng nạbh afa ukuma asen ma ofhon ngwọ, p'asi ẹmmaana ọkkachẹ, m'asenga anạng abẹ akhibhi ofhon ngwọ o?”</para>
  <para style="p" vid="GEN 18:28">Ọvaar Ubinọkpaabyi ubhin-ẹ bẹ́, “Mma e, de nse anạng nạbh afa ukuma asen p'ator-otor, amma m'nse bẹ ikwosi, ntte ofhon ngwọ ọbọhk.”<verse eid="GEN 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 18:29" />Abraham ofona ororo ọbạbh-ẹ bẹ́, “De abạra ase anạng nạbh afa p'asi ẹmmaana ọkkachẹ, sạm akhibhi ofhon ngwọ?” Ọvaar Ubinọkpaabyi ubhin-ẹ bẹ́, “Mma e, de nse anạng nạbh afa, amma m'nse bẹ ikwosi, ntte ofhon ngwọ ọbọhk.”<verse eid="GEN 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 18:30" />Ma wọ, Abraham ubhin-ẹ bẹ́, “Totokhạn aro, nạng-ọ ọdwạkhọ, tte mphyem-ọ dạkhẹ, de wạra ase anạng ẹrạbh ukuma jobh ma ofhon ngwọ mo o?”</para>
  <para style="p" vid="GEN 18:30">Ọvaar Ubinọkpaabyi ubhin-ẹ bẹ́, “Mma e, de nse anạng ẹrạbh ukuma jobh, amma wạra mạnte ofon ngwọ ọbọhk otte.”<verse eid="GEN 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 18:31" />Ma wọ, Abraham obeni bẹ́, “Masẹ amma kk'ettem mbạra bẹ́, mphyem-ọ, tte mbạra mbạbh-ọ, wạra de bẹ́, anạng ẹrạbh mạnkkeni bọ ase ma mo o?”</para>
  <para style="p" vid="GEN 18:31">Ọvaar Ubinọkpaabyi ubhin-ẹ bẹ, “K'udik ọkka, wạra nse ubhik-khira ngwọ, wạra m'nsenga k'ncho s'anạng mbọ ẹrạbh, ntte ofhon ngwọ ọbọhk.”<verse eid="GEN 18:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 18:32" />Ma wọ, Abraham ọbạra oben bẹ́, “Totokhạn aro, tte nạng-ọ ọdwạkhọ, tte mphyem adạkhẹ eden nja-nja bẹ́, de wạra abẹ ade anạng jobh mạnkkeni mo o?”</para>
  <para style="p" vid="GEN 18:32">Ọbạra ubhin-ẹ bẹ́, “K'udik ọkka, de wạra nse ubhik-khira ngwọ, wạra m'nsenga k'ncho s'anạng mbọ jobh, ntte ofhon ngwọ ọbọhk.”<verse eid="GEN 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 18:33" />Masẹ Ọvaar Ubinọkpaabyi kk'idik ọkpaakha phyibh Abraham abẹ, oseng ofona, Abraham ọbạra ọkpa nnạm k'ukkira kwẹ.<verse eid="GEN 18:33" /></para>
  <chapter eid="GEN 18" />
  <chapter number="19" style="c" sid="GEN 19" />
  <para style="s">Mpyibha s'anạng p'Sodom</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 19:1" />Ukwu ukpira k'ẹchọhkha, atọhmọ mbọma afa p'Ubinọkpaabyi p'asạk Abraham, akpira k'Sodom. Ma okpe ngwọ, Lọt uning ẹyạr ma ẹbaakhamma ch'Sodom, masẹ ose bẹ, ubina okhebha bẹ, ọrạkha uttima ititikha k'isek usima bẹ. <verse eid="GEN 19:1" /><verse number="2" style="v" sid="GEN 19:2" />Oben bẹ bẹ́, “Abaro paam, totokhạn, abạnga akwu asạkha k'ọchọhm kw'amma ọtọhmnạng kwabạnga, ọfha nnạng bạnga asi p'abạnga m'akpobhu mfhok sabạnga, abạnga abhing maa, de iwu kk'echobha, abạnga apạm-ọpạm abina osenga kwabạnga.”</para>
  <para style="p" vid="GEN 19:2">Abẹ abhin-ẹ bẹ́, “Mesese, m'amming k'ẹbhaama e.”<verse eid="GEN 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 19:3" />Okhenka, Lọt ofon ororo ọkpạna bẹ matạrr, brasẹ abẹ n'acher atwạn abẹ anwa k'akhẹ k'ọchọhm. Lọt ukwu usi brẹd kw'nạn yist ọ̀khaam, ọnạng bẹ, abẹ achi. <verse eid="GEN 19:3" /><verse number="4" style="v" sid="GEN 19:4" />Brasẹ Lọt ọttạra akhikhennạng pẹ n'ayim o, ajunung phyibh, adikkobh, ọttạra adennạng p'ofhon kw'Sodom kk'ọchọhm ngwọ abaabha age ngekha.<verse eid="GEN 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 19:5" />Mạnna wọ abẹ akwọhrọ Lọt ẹmạng abạbh-ẹ bẹ́, “Akhikhennạng mbọ p'asạkh-ọ ma irungu khẹ mbạn? Tạkha bẹ nạng mạna anyima bẹ abẹ.”<verse eid="GEN 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 19:6" />Lọt uyin k'iyaan ọta okhebha bẹ, obhen ukhubh okpora akhikhennạng pẹ kha ẹtaanga, <verse eid="GEN 19:6" /><verse number="7" style="v" sid="GEN 19:7" />oben bẹ bẹ́, “Mma e, abayi, totokhạn abạnga igbaan demasẹ nna kkási. <verse eid="GEN 19:7" /><verse number="8" style="v" sid="GEN 19:8" />Akker e, amma nkhaam aminava afa p'nạn ajunung tạm násonga. Amma m'ntte bẹ ọbọhk nnạng bạnga, ọfha abạnga atima bẹ asi oche kw'ọdaakhẹ bạnga. Node ajunung mbama, abạnga bẹ igbaan demasẹ nna kási, khiri abẹ asạk amma.”<verse eid="GEN 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 19:9" />Abẹ apọhna bẹ́, “Rik mạna ẹbhaang anseng. Ttọttọ, ọma ukhikhenạng wọ m'akwu atek mạna udik kw'm'ansi? De nạn mạna ẹbhaang nárikha, f'm'ansi-ọ m'upyibh ọyọhnga f'wạra m'ansi abẹma.” Anạng mbọ afona ororo age Lọt ẹwạna tạrr abẹ n'abạra avọhkhọ ọmmakhubh. <verse eid="GEN 19:9" /><verse number="10" style="v" sid="GEN 19:10" />Okhenka, ajunung mbọ p'aning k'ọchọhm ẹtaanga n'annemi mbọhk atwạr Lọt anwa k'ọchọhm ẹtaanga, abẹ abhen ukhubh. <verse eid="GEN 19:10" /><verse number="11" style="v" sid="GEN 19:11" />Ma o, abẹ asi ajunung mbọ phyibh p'abe k'iyaan, adikkobh ọttạra adennạng akpa achen, abẹ dạkhẹ ẹchọhmma násia.<verse eid="GEN 19:11" /></para>
  <para style="s">Oche kw'Lọt ubin k'Sodom</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 19:12" />Ma wọ, akhikhennạng mbọ abạbh Lọt bẹ́, “Akhaam anạng adwạkh-ọdwạk ma efhonfhạr yeri? Sọhng ta atạkha adim p'iva pọ, ọttạra ajunungva pọ, ọttạra apanạngva pọ, ọttạra ọnạng kwidede kw'ode kwọ, atima bẹ phyibh abina ma ofhon ngwa, <verse eid="GEN 19:12" /><verse number="13" style="v" sid="GEN 19:13" />ukwuru bẹ, bạra andimi ofhon ngwama e. Mpyibha s'anạng p'ofhon ngwa kk'asia kk'isaabha iseng eden k'ititikha s'Ọvaar Ubinọkpaabyi, ẹgwọ usi, ọtọhmọ mạna bẹ, ankwu andimi ofhon ngwama e.”<verse eid="GEN 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 19:14" />Ma o, Lọt uyin k'iyaan ọta ọkpaak ajunung p'arạk aminava pẹ umina, oben bẹ bẹ́, “Asi ẹbhạr-ẹbhạr abina arik ofhon ngwa, khiri Ọvaar Ubinọkpaabyi bạra udimi kwẹ.”</para>
  <para style="p" vid="GEN 19:14">Ajunung mbọ p'arạk aminava pẹ umina atạk bẹ, Lọt n'usi orokhu.<verse eid="GEN 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 19:15" />Masẹ iwu n'echobh, atọhmọ mbọ ayạk Lọt bẹ́, “Tima ikwanạng kwọ, ọttạra apanạngva pọ afa p'aning ma, bina ma ofhon ngwa ẹbhạr-ẹbhạre, deja, m'agba ape ọttạra ẹchọhmfhạr chọ k'ipyibha ch'ofhon ngwa kk'usia.”<verse eid="GEN 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 19:16" />Masẹ Lọt ukhibhi okpe o, atọhmọ mbọ n'avạk ẹma ọttạra ikwanạng kwẹ, ọttạra apanạngva pẹ afa k'mbọhk, atima bẹ <char style="it">bẹ bẹẹẹm,</char> abina ma ofhon ngwọ, s'Ọvaar Ubinọkpaabyi ose bẹ ikwosi. <verse eid="GEN 19:16" /><verse number="17" style="v" sid="GEN 19:17" />Masẹ abẹ kk'bẹ atima ayin ma ofhon ngwọ, ọnạng wạnọ ma ikhaana s'atọhmọ mbọ oben bẹ́, “Abạnga arạbh akkaana akpen pabạnga o! Abạnga k'nnạm káphyebha o, abạnga k'ẹkpẹme chidede kábạra abe o! Arạbh afona k'akpecho, deja, abạnga m'apope!”<verse eid="GEN 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 19:18" />Ma wọ, Lọt obeni bẹ́, “Mma e, abaro paam, ase-m ikwosi. <verse eid="GEN 19:18" /><verse number="19" style="v" sid="GEN 19:19" />Abạnga kk'aam ọphyaam asia, abạnga kk'ijibha chididen abạra asia anạng-m s'abạnga akkaan akpen paam. Okhenka, amma mạ́nkke nnạbh mkpira k'akpecho, de njaar, ipyibha nja m'ẹvạkh-m k'eden, m'mbạra mpe nttra ma. <verse eid="GEN 19:19" /><verse number="20" style="v" sid="GEN 19:20" />Abạnga akkeri ofhon nwa nwọ kw'uning ọbaanga ma, bina ma kpira kha k'idaam núbhira, tte annạbh amfona kha ọfha ankhaama annaanga.”<verse eid="GEN 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 19:21" />Osenga ma, itọhmọ nnọ ipọhn-ẹ bẹ́, “Amma m'nsi oche kw'aphyem-m. M'ntte ofhon ngwọ ọbọhk otte, kwẹ mạ́ndimi. <verse eid="GEN 19:21" /><verse number="22" style="v" sid="GEN 19:22" />Ẹbhạr-ẹbhạr, abạnga arạbh afona kha, ukwuru bẹ́, amma udik gwạnọ-gwạnọ mạ́nkpongma nsi tạrr abạnga akpira ma.” Ẹgwọ usi abẹ ayeri ofhon ngwọ Zoar, kw'uyini ofhon kw'isisạkhẹ.<verse eid="GEN 19:22" /></para>
  <para style="s">Idima ch'Sodom ọttạra Gọmọra</para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 19:23" />Lọt ọttạra anạng pẹ akpir Zoar k'okpe kw'iwu kk'ẹttaana. <verse eid="GEN 19:23" /><verse number="24" style="v" sid="GEN 19:24" />Ma wọ, Ọvaar Ubinọkpaabyi ọtọhmọ akpon-ta p'abin k'erạng atebh k'Sodom ọttạra Gọmọra. <verse eid="GEN 19:24" /><verse number="25" style="v" sid="GEN 19:25" />Mạnna wọ wa Ubinọkpaabyi oseng udimi ifhon nnọ, ọttạra ifhon phyibh s'ining k'akpecho, ọttạra anạng phyibh p'arukhu ma ifhon nnọ, ọttạra ekpo py'emeni ma isisek nnọ.<verse eid="GEN 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 19:26" />Okhenka, ikwanạng kw'Lọt ophyebh k'nnạm, ukwu ọbhạkhẹ ẹtakpa ch'unung ch'ebe <char style="it">bẹ gbẹẹng</char>.<verse eid="GEN 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 19:27" />Masẹ iwu n'echobh, ma ekpekpebha, Abraham ubina ofona k'ibyi s'uwa obe Ọvaar Ubinọkpaabyi k'ititikha. <verse eid="GEN 19:27" /><verse number="28" style="v" sid="GEN 19:28" />Masẹ okkeri Sodom ọttạra Gọmọra, ọttạra k'isekhisek kw'akpecho phyibh, ose isusong-bina s'niyin ma ukhubha ngwọ, s'ibạra ipyi <char style="it">bẹ kkạạng. </char><verse eid="GEN 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 19:29" />Masẹ Ọvaar Ubinọkpaabyi udimi ifhon nnọ s'ining k'isekhisek kw'akpecho phyibh, ujima Abraham, osenga ma, ọrạbha Lọt k'ipyibha ch'etto ekhebha ifhon nnọ s'uwa Lọt kk'urukha.<verse eid="GEN 19:29" /></para>
  <para style="s">Etạma ch'Moab ọttạra Ammọn</para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 19:30" />Wa Lọt ojor-ẹ oche kw'm'uruk k'Zoar, n'ubin ọttạra apanạngva pẹ afa ọta uruk k'ukhubha kw'akpecho, k'ọmma gwạnọ kw'ẹtakpa.<verse eid="GEN 19:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 19:31" />Iwu jạnẹ, ocheden-nwa kw'Lọt, obeni oyok kw'isạsạkhẹ bẹ́, “Otte kwamạna kk'ọtạma, de akker-okkeri, ujunung ma ibyi nna kóde kw'm'uyima mạna abẹ k'oche kw'ẹmmaana ch'iyagbin phyibh ede. <verse eid="GEN 19:31" /><verse number="32" style="v" sid="GEN 19:32" />Tte annạng otte kwamạna atwuk ogwo ubuma, ọfha anyima abẹ, ọfha ansenga k'otte kwamạna ansi ichimma chamạna nạngẹ idimi.”<verse eid="GEN 19:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 19:33" />Ukwu ukpira k'irungu, abẹ anạng otte atwuk ogwo ubuma, ocheden-nwa ọta uyima otte abẹ. Otte okpe kw'nnwa ukwu uyima ma ọttạra okpe kw'ọbạra ubina kósong.<verse eid="GEN 19:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 19:34" />Masẹ iwu echobh, ocheden-nwa oben oyok kwisạsạkhẹ bẹ́, “K'irungu ch'chạnachẹ, amma k'otte kwamạna abẹ nyima e. M'annạng-ẹ dạkhẹ atwuk ogwo ma irungu, oche kw'ansi chạnachẹ, ọma bạra ata ayima abẹ, ọfha ansenga k'otte kwamạna ansi ichimma chamạna nạngẹ idimi.” <verse eid="GEN 19:34" /><verse number="35" style="v" sid="GEN 19:35" />Ma irungu njọ, abẹ anạng otte atwuk, ogwo ubuma. Oyok kw'isạsạkhẹ ọbạra ọta uyima otte abẹ. Otte okpe kw'nnwa ukwu uyima ma, ọttạra okpe kw'ọbạra ubina kósong.<verse eid="GEN 19:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 19:36" />Ma wọ, apanạngva p'Lọt atim ọfhạr anạng otte kwabẹ. <verse eid="GEN 19:36" /><verse number="37" style="v" sid="GEN 19:37" />Ochedennwa ọmaan ujunung, ukpuẹ-ẹ Moab, ẹma wọ ode otte kw'ẹkhạma ch'Moab tạrr ukpira chemma. <verse eid="GEN 19:37" /><verse number="38" style="v" sid="GEN 19:38" />Oyok kw'isạsạkhẹ ọbạra ọmaan ujunung, ukpuẹ-ẹ Bẹn-Ammi, ẹma wọ ode otte kw'ẹkhạma ch'Ammọn tạrr ukpira chemma.<verse eid="GEN 19:38" /></para>
  <chapter eid="GEN 19" />
  <chapter number="20" style="c" sid="GEN 20" />
  <para style="s">Abraham ọttạra Abimẹlẹk</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 20:1" />Abraham ubin ofona k'ẹkhạma ch'Nẹgẹv, ọta uruk k'ottemkwẹ kw'ifhon s'Kadẹsh ọttạra Shur. Wa uning k'Gẹra k'okpenwa sạsạkhẹ. <verse eid="GEN 20:1" /><verse number="2" style="v" sid="GEN 20:2" />Ma ibyi nnọ rọ wa Abraham ọkpaakhẹ anạng bẹ́, ikwanạng kwẹ, Sara, ode nnwotte kwẹ. Ma wọ Abimẹlẹk kw'ode ọvaarnạng kw'Gẹra ọtọhmọ abẹ ayeri Sara anạng-ẹ, ọtạkh-ẹ.<verse eid="GEN 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 20:3" />Okhenka, Ubinọkpaabyi uyini Abimẹlẹk abẹ k'idachen, usi ẹyaakha ọnạng-ẹ bẹ́, “Ọma kk'pạpe apua e, ukwuru bẹ́, ikwanạng nwọ kw'atạk achok ma ọchọhm kwọ, kk'udim ọba e.”<verse eid="GEN 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 20:4" />Okhenka, wa Abimẹlẹk ọttạra Sara abẹ ayok abẹ tạm náyima, ma wọ, Abimẹlẹk ọbạbhọ Ọvaar Ubinọkpaabyi bẹ́, “Attitte, ma n'abạra atạkha anạng p'nạn ipyibha tạm n'asia afhọ-o? <verse eid="GEN 20:4" /><verse number="5" style="v" sid="GEN 20:5" />Abraham oyeni wọ ọkpaakh-m bẹ́, Sara ode nnwotte kwẹ. Sara oyeni ma akhẹ k'ifor ọbạra ọkpaakh-m bẹ́, Abraham ọttạra ẹma abẹ ade ivotte. Amma udik ngwa k'ẹyaakha nạ́nsia o.”<verse eid="GEN 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 20:6" />Ma o, Ọvaar Ubinọkpaabyi oben Abimẹlẹk k'idachen bẹ́, “Uwe-e, amma oyeni nsonga ma bẹ́, udik ngwa k'ẹyaakha násia, ẹgwọ usi bạra mkpọ-ọ eden ọfha nạngẹ ipyibha k'ititikha saam asi, mbạra mkpọ-ọ eden ọfha abạnga nạngẹ ayok abẹ ayim. <verse eid="GEN 20:6" /><verse number="7" style="v" sid="GEN 20:7" />Nemi eden tte ikwanạng nwọ ọbọhk nạng udim kwẹ, khiri udim ode ọnạng kw'nusi ẹyaakha. M'ọjọhm atim ọnạng-ọ aruk akpen. Okhenka, de nạn khẹ ọbọhk náttia, songa k'udik ọkka bẹ́, ọma ọttạra ẹchọhmfhạr chọ phyibh m'apope.”<verse eid="GEN 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 20:8" />Ma wọ, s'iwu echobh <char style="it">bẹ hii,</char> Abimẹlẹk oyeri adennạng pẹ phyibh akwu, ọtạkha idik nnọ phyibh otek bẹ. Ojora fididen ọvạkha bẹ. <verse eid="GEN 20:8" /><verse number="9" style="v" sid="GEN 20:9" />Ma wọ Abimẹlẹk oyeri Abraham, ọbạbh-ẹ bẹ́, “Bạng udik-khira gwọ kw'asi mạna ma? Ntto yạn k'akhọ k'ititikha, kw'aseng akwẹ anạng amma ọttạra anạng paam ipyima demachẹ nja? Udik kw'ayom maa nọ́baana a.” <verse eid="GEN 20:9" /><verse number="10" style="v" sid="GEN 20:10" />Abimẹlẹk ofon ororo ọbạbh Abraham bẹ́, “Bạng ọtọhk vọ aseng apfẹ asi-m udik demakwẹ ngwa?”<verse eid="GEN 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 20:11" />Abraham ọpọhn-ẹ bẹ́, “Amma nkkẹ bẹ́, anạng p'ofhon ngwa Ubinọkpaabyi kạnárạbh, mbẹ abẹ akke ma afhọ-m ukwuru ikwanạng kwaam. <verse eid="GEN 20:11" /><verse number="12" style="v" sid="GEN 20:12" />Ayongu ma, ikwanạng nwa ode nnwotte kwaam, kw'otte wạnọ ofhonu mạna, ankhenka ankhạmọ ab'ọkka. Amma ntạkh-ẹ masẹ ikwanạng kwaam. <verse eid="GEN 20:12" /><verse number="13" style="v" sid="GEN 20:13" />Okpe kw'uwa Ubinọkpaabyi usi-m mbina nnik ẹchọhmfhạr ch'otte kwaam, nsenga mfona k'ibyi k'ibyi, amma mbeni Sara bẹ́, ibyi sidede s'm'anta, n'atek anạng bẹ́, amma nde nnwotte kwọ, ọfha atima ma akhọhkh-m idạdaakha.”<verse eid="GEN 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 20:14" />Ma wọ Abimẹlẹk ọtạk arạkhạmaan ọttạra mmaam, ọttạra abira p'ajunung ọttạra p'ipanạng, ọnạng Abraham, ọbạra ọtạkha Sara ọkpa nnạm ọnạng-ẹ. <verse eid="GEN 20:14" /><verse number="15" style="v" sid="GEN 20:15" />Ma wọ Abimẹlẹk n'obeni bẹ́, “Kkeri, isisek saam rọ ining-ọ ma ititikha, ruk k'ibyi sidede s'idaakh-ọ.”<verse eid="GEN 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 20:16" />Abimẹlẹk ọbạra oben Sara bẹ́, “Kkeri, amma m'nnạng nnwotte kwọ ashẹkẹl p'silva nnọhna mfa ukuma arạbh jobh. Ma wọ m'ode ẹkhọhkha bẹ́, udik ngwọ kk'ọsa, ọttạra bẹ́, ipina jạnẹ jạnẹ kàkhaam ma udik ngwọ.”<verse eid="GEN 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 20:17" />Ma o, Abraham ose njọhm ọnạng Ubinọkpaabyi. Ubinọkpaabyi ukwu ubina ọnạng Abimẹlẹk, ọttạra ikwanạng kwẹ, ọttạra abira pẹ p'ipanạng, ọfha abẹ amaan adạkhẹ iva, <verse eid="GEN 20:17" /><verse number="18" style="v" sid="GEN 20:18" />ukwuru bẹ́, wa Ọvaar Ubinọkpaabyi kk'Sara, kw'ode ikwanạng kw'Abraham abẹ osenga usi ipanạng p'ẹchọhmfhạr ch'Abimẹlẹk phyibh ajidim.<verse eid="GEN 20:18" /></para>
  <chapter eid="GEN 20" />
  <chapter number="21" style="c" sid="GEN 21" />
  <para style="s1">Ẹmmaana ch'Isaak</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 21:1" />Wa Ọvaar Ubinọkpaabyi odo Sara oche kw'uwa kk'ochekha. <verse eid="GEN 21:1" /><verse number="2" style="v" sid="GEN 21:2" />Sara ukwu utima ifhạr, ọmaan Abraham ujunung-nwa k'atạm. Nnwa nwọ wa ọmmaan otor k'okpe kw'uwa Ubinọkpaabyi kk'ochekha bẹ́, m'ọmmaana. <verse eid="GEN 21:2" /><verse number="3" style="v" sid="GEN 21:3" />Abraham okpe nnwa nwọ Isaak, kw'Sara ọmaanẹ. <verse eid="GEN 21:3" /><verse number="4" style="v" sid="GEN 21:4" />Masẹ Isaak okke iwu isenọttaan, Abraham ọkpaar-ẹ ọnạm otor k'oche kw'Ubinọkpaabyi kk'ẹ ọtọhna. <verse eid="GEN 21:4" /><verse number="5" style="v" sid="GEN 21:5" />Wa Abraham ode icho arạbh asen k'okpe kw'nnwa kwẹ Isaak, ọmmaan.<verse eid="GEN 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 21:6" />Ma wọ Sara obeni bẹ́, “Ubinọkpaabyi kk'aam usia bẹ́, mma asa. Ọnạng kwidede kw'ọbhaang udik ngwa kw'Ubinọkpaabyi usi ọnạng-m, m'otor-m ẹsamma.” <verse eid="GEN 21:6" /><verse number="7" style="v" sid="GEN 21:7" />Ofona ororo oben bẹ́, “Anẹwọ wạra ọkpaakhẹ Abraham bẹ́, amma Sara m'mbạra nnạk nnwa? Okhenka, amma kk'ujunungnwa mmaana nnạng Abraham k'atạm.”<verse eid="GEN 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 21:8" />Nnwa nwọ o ukwu ọbạr, ọkka ukum-ẹ ẹba. Ma iwu njọ ch'ọkka ukum Isaak ẹba, Abraham usi erobha chididen.<verse eid="GEN 21:8" /></para>
  <para style="s">Abraham ukhubhu Hagar ọttạra Ishimayẹl</para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 21:9" />Iwu jạnẹ, Sara ose s'nnwa kw'Hagar kw'uIjip-kwanạng ọmaanẹ ọnạng Abraham, n'usi edera-pyibha ọttạra Isaak. <verse eid="GEN 21:9" /><verse number="10" style="v" sid="GEN 21:10" />Ma wọ, Sara obeni Abraham bẹ́, “Khubh ubira-kwanạng nwa ọttạra nnwa kwẹ, abẹ asọhng afona. Nnwa kw'ubira-kwanạng nọ́baana bẹ́ ọkhaama okhebh k'ẹkhaama chọ ch'nnwa kwaam Isaak m'uchi obo.” <verse eid="GEN 21:10" /><verse number="11" style="v" sid="GEN 21:11" />Udik ngwọ ọphyaangẹ Abraham ẹmma mororo, ukwuru bẹ́, Ishimayẹl ọgba ode nnwa kwẹ. <verse eid="GEN 21:11" /><verse number="12" style="v" sid="GEN 21:12" />Okhenka, Ubinọkpaabyi obeni Abraham bẹ́, “Ettem nạng-ọ ẹmma ẹphyaangẹ ukwuru nnwa nwọ ọttạra ubira-kwanạng nwọ. Si oche kwidede kw'Sara oben-ọ bẹ́, asi, ukwuru bẹ́, m'osenga ma Isaak iva p'iva pọ asaabh ator k'echekha ch'uwa kk'ntạkha. <verse eid="GEN 21:12" /><verse number="13" style="v" sid="GEN 21:13" />Amma m'nsi nnwa kw'ubira-kwanạng nwọ ọbạra ọkhaama ẹkhạma chẹ, ukwuru bẹ́, ẹma ọgba ode nnwa kwọ.”<verse eid="GEN 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 21:14" />Ma o, Abraham ubina k'ekpekpebha, ọtạkha uchiattọhk, ọttạra asi, oge k'ẹkpa ch'ede etenkpa-etenkpa, ọnạng Hagar. Abraham ọtạkha pyẹ ọnạn-ẹ k'nkkaang, ukhubh-ẹ ọttạra nnwa. Ma wọ, Hagar ubin ofona k'ibyi s'anạng nạnárukha, k'ukhubha kw'Beershẹba.<verse eid="GEN 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 21:15" />K'okpe kw'asi mbọ n'asa o, Hagar ọtạkha nnwa ururu k'uchikpok gwạnọ. <verse eid="GEN 21:15" /><verse number="16" style="v" sid="GEN 21:16" />Ọtwạkhọ sạsạkhẹ ọta uninga ẹyạr, oben k'ettem bẹ́, “Amma ettem mạ́nkhaama nninga maa nse oche nnwa kwaam m'ope.” Masẹ utim uning ẹyạr ọbaanga ma, ọtạma asen fạfhobh.<verse eid="GEN 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 21:17" />Wa Ubinọkpaabyi ọbhaang ẹmạng ch'nnwa nwọ n'ọgạma. Itọhmọ s'Ubinọkpaabyi ininga kha ẹrạng iyeri Hagar oben-ẹ bẹ́, “Hagar, ode yạn? Nạng-ọ ojor s'nnwa kwọ uyim mạma, khiri Ubinọkpaabyi kk'ẹmạng chẹ ch'ọgạm, ọbhaanga. <verse eid="GEN 21:17" /><verse number="18" style="v" sid="GEN 21:18" />Bina ata adira nnwa kwọ, khiri m'nsi-ẹ ode otte kw'ẹkhạma chididen.”<verse eid="GEN 21:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 21:19" />Ma wọ, Ubinọkpaabyi usi Hagar ose isipe. Ọtạkha ẹkpa njọ ch'otenkpa ọta ọkhaabha asi tạrr achẹ ifu, ọnạng nnwa ogwo.<verse eid="GEN 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 21:20" />Wa Ubinọkpaabyi uning nnwa nwọ abẹ s'n'ọbạr ukwu. Wa nnwa nwọ urukhu k'ibyi s'anạng nạnárukha, ukwu ode ọgbajinạng. <verse eid="GEN 21:20" /><verse number="21" style="v" sid="GEN 21:21" />Masẹ s'uwa urukhu k'ibyi s'owór k'Paran, ọkka ọta ọtạkha ikwanạng k'Ijip, ọnạng-ẹ k'ọbada.<verse eid="GEN 21:21" /></para>
  <para style="s1">Abraham ọttạra Abimẹlẹk asi ẹgbạkha</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 21:22" />K'okpe ngwọ, Abimẹlẹk utim Phikol, kw'ode ocho kw'akpongnạng pẹ, ọta oben Abraham bẹ́, “Ubinọkpaabyi uning abọ k'ọttọhk fidede f'n'asi. <verse eid="GEN 21:22" /><verse number="23" style="v" sid="GEN 21:23" />Chekhi nạng-m ma ititikha s'Ubinọkpaabyi bẹ́, amma ọttạra iva paam, ọttạra iva p'iva paam mábọhra. M'asi ẹmmaana ọkkachẹ atima ator-m, ọttạra ẹkhạma nja ch'arukhu masẹ ukhikhennạng, ator k'oche kw'kk'nsia nnạng-ọ.”<verse eid="GEN 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 21:24" />Abraham oben bẹ́, “Amma kk'nchekha.”<verse eid="GEN 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 21:25" />Ma wọ, Abraham ọkpaakhẹ Abimẹlẹk udik otena isipe chẹ ch'atọhmnạng p'ẹma Abimẹlẹk kk'ẹ avạkha ana. <verse eid="GEN 21:25" /><verse number="26" style="v" sid="GEN 21:26" />Okhenka, Abimẹlẹk ubhin-ẹ bẹ́, “Amma ọnạng kw'usi udik ngwa kạ́nsong, ọma khaam udik demakwẹ ngwa tạm nákpaakha, chemma wọ n'mmaang kwẹ.”<verse eid="GEN 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 21:27" />Ma wọ, Abraham ọtạk arạkhạmaan ọttạra mmaam ọnạng Abimẹlẹk, abẹma anạng afa atạkha echekha anạng ayok. <verse eid="GEN 21:27" /><verse number="28" style="v" sid="GEN 21:28" />Abraham otekha arạkhạmaan-pa asenọfa k'itirakpo pẹ, ọkhạmọ ochok. <verse eid="GEN 21:28" /><verse number="29" style="v" sid="GEN 21:29" />Abimẹlẹk n'ọbạbhọ Abraham bẹ́, “Arạkhạmaan-pa mbọ asenọfa p'akhạmọ achok kha, iyini yạn?” <verse eid="GEN 21:29" /><verse number="30" style="v" sid="GEN 21:30" />Abraham ubhin-ẹ bẹ́, “Ọma chera bẹ́, atạkha arạkhạmaan-pa mba asenọfa p'amma nnạng-ọ, ma wọ m'ọkhọhkha bẹ, ọma kk'achera bẹ́, amma wọ ntumu isipe nja.” <verse eid="GEN 21:30" /><verse number="31" style="v" sid="GEN 21:31" />Ma wọ, anạng ayeri ibyi nnọ Beershẹba, ukwuru bẹ, ma wọ kw'anạng mbọ afa aning atạkha echekha anạng ayok. <verse eid="GEN 21:31" /><verse number="32" style="v" sid="GEN 21:32" />Masẹ abẹ kk'echekha njọ asia k'Beershẹba, Abimẹlẹk utima Phikol nwọ kw'ode ochonạng kw'akpongnạng pẹ, ọkpa nnạm ọbhạna k'Philistiya. <verse eid="GEN 21:32" /><verse number="33" style="v" sid="GEN 21:33" />Wa, Abraham okponu ichi ch'tamarisk k'Beershẹba. Ma ibyi nnọ rọ s'ẹma Abraham n'uninga okpobha Ọvaar Ubinọkpaabyi kw'ipimmanitor. <verse eid="GEN 21:33" /><verse number="34" style="v" sid="GEN 21:34" />Wa Abraham urukhu ma ẹkhạma njọ ch'Philistiya eden ibhir.<verse eid="GEN 21:34" /></para>
  <chapter eid="GEN 21" />
  <chapter number="22" style="c" sid="GEN 22" />
  <para style="s1">Eyoma ch'ochenchokha kw'Abraham</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 22:1" />K'okpe mạnna gwạnọ, Ọvaar Ubinọkpaabyi oyom nnạm-phyạphye s'Abraham. Oyer-ẹ bẹ́, “Abraham!”</para>
  <para style="p" vid="GEN 22:1">Abraham ọbẹ́, “Kkeri amma maa.”<verse eid="GEN 22:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 22:2" />Ma wọ, Ọvaar Ubinọkpaabyi obeni Abraham bẹ́, “Tạkha nnwa kwọ Isaak, nwọ mạnkkeni kw'achokhu ettem, fona k'ẹkhạma ch'Moriya. Tim-ẹ fọhnọ ẹja-ẹkkạmachẹ k'okpecho kw'm'ntibh-ọ.”<verse eid="GEN 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 22:3" />Masẹ iwu echobh ma k'ekpekpebha, Abraham ubin ọttạra ẹnyạnyaang chẹ, ọttạra atọhmnạng pẹ afa, ọttạra nnwa kwẹ Isaak. Masẹ kk'ommeni ọkkọbha f'm'obenga k'ẹja-ẹkkạmachẹ njọ, ubina osenga ofona k'ibyi s'Ubinọkpaabyi kk'ẹ utibha. <verse eid="GEN 22:3" /><verse number="4" style="v" sid="GEN 22:4" />Ottong iwu ittaan s'osenga ngwọ, Abraham ubina achen, ose ibyi nnọ k'ororo. <verse eid="GEN 22:4" /><verse number="5" style="v" sid="GEN 22:5" />Osenga ma, Abraham oben atọhmnạng pẹ bẹ́, “Aninga ma ọttạra ẹnyạnyaang nja achẹ, s'amma ọttạra Isaak, m'amfona k'ororo, anta amkpobha Ubinọkpaabyi. Ode kk'ansa, m'amkpa nnạm ankhebha bạnga ma ibyi nna.”<verse eid="GEN 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 22:6" />Abraham ọtạkha ommeni f'abẹ m'atima amuma ekpon ch'ẹja ẹkkạmachẹ, oye nnwa kwẹ Isaak. Ẹma Abraham utima ekpon, ọttạra imaana. Masẹ abẹma anạng afa n'asenga k'eden, <verse eid="GEN 22:6" /><verse number="7" style="v" sid="GEN 22:7" />Isaak oben otte bẹ́, “Attitte o.”</para>
  <para style="p" vid="GEN 22:7">Abraham ochera bẹ́, “Nnwa kwaam.”</para>
  <para style="p" vid="GEN 22:7">Isaak ọbẹ́, “Amma n'mben bẹ mbạbh bẹ́, masẹ ommeni uning ma, ekpon ininga, ma, ọrạkhạmaan kw'm'antima anfọhnọ ẹja-ẹkkạmachẹ mo o?”<verse eid="GEN 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 22:8" />Ma wọ, Abraham ubhin-ẹ bẹ́, “Nnwa kwaam, Ubinọkpaabyi oyeni wọ m'ọnạng mạna ọrạkhạmaan kw'm'antima anfọhnọ ẹja-ẹkkạmachẹ e.”<verse eid="GEN 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 22:9" />Masẹ abẹ akpir k'ibyi s'Ubinọkpaabyi kk'ẹ otekha, Abraham usi ijabyi ma, ọtạkha ommeni otobha k'ukwung. Ukwu ọtạkha nnwa kwẹ Isaak, ọdạbh ndikhi, ọtạkh-ẹ ọnạna k'ommeni mvọ k'ẹrạng. <verse eid="GEN 22:9" /><verse number="10" style="v" sid="GEN 22:10" />Ma wọ, Abraham onemi ọbọhk ọtạkha imaana bẹ, ọfhọ nnwa kwẹ. <verse eid="GEN 22:10" /><verse number="11" style="v" sid="GEN 22:11" />Okhenka, itọhmọ s'Ọvaar Ubinọkpaabyi ininga ka ẹrạng iyer-ẹ bẹ́, “Abraham! Abraham o!”</para>
  <para style="q1" vid="GEN 22:11">Abraham ọpọhna bẹ́, “Kkeri amma ma e.”<verse eid="GEN 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 22:12" />Itọhmọ nnọ ikwu iben bẹ́, “Nnwa nwọ ọbọhk kátwu, khẹ ọttọhk kási o! Napra wọ kk'nsonga bẹ, akhaam ojora f'Ubinọkpaabyi, ukwuru s'acher bẹ, atima nnwa nwọ kwọ mạnkkeni, afọhnọ ẹja anạng-m.”<verse eid="GEN 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 22:13" />Ma wọ, Abraham udir ichen ose uvudim ch'abhik itim ẹdạma k'ọkpasạn, ofona ọta ọtạkha chẹ utima ọfọhnọ ẹja-ẹkkạmachẹ k'echo ch'nnwa kwẹ. <verse eid="GEN 22:13" /><verse number="14" style="v" sid="GEN 22:14" />Osenga ma, Abraham oyeri ibyi nnọ bẹ́, “Ọvaar Ubinọkpaabyi m'ọnạng-ọnạng.” Tạma ma kpira chemma, anạng n'ayeri ibyi nnọ, “K'okpecho kw'Ọvaar Ubinọkpaabyi wọ m'ọnạng-ọnạng.”<verse eid="GEN 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 22:15" />Itọhmọ s'Ọvaar Ubinọkpaabyi ining ka ẹrạng iyeri Abraham ottong nden mfa, <verse eid="GEN 22:15" /><verse number="16" style="v" sid="GEN 22:16" />Ọben bẹ́, “Nchekhi k'eche ch'amma Ọvaar Ubinọkpaabyi bẹ́, ukwuru s'acher bẹ́, atima nnwa nwọ kwọ wạnọ mạnkkeni afọhnọ ẹja anạng-m, <verse eid="GEN 22:16" /><verse number="17" style="v" sid="GEN 22:17" />k'udik ọkka, m'ndi-ọ, mbạra nsi iva p'iva pọ asaabh masẹ ndudoru s'ining k'ọrạngkpakpa, ọttạra masẹ opong kw'uning k'ẹraangapa. Iva p'iva pọ m'abạra atạkha ifhon s'awawunanạng pabẹ, <verse eid="GEN 22:17" /><verse number="18" style="v" sid="GEN 22:18" />m'ọbạra osenga k'echo ch'iva p'iva pọ, nkhạma s'iyagbin phyibh itạkha idia, ukwuru s'asạk echo anạng ntọhna saam.”<verse eid="GEN 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 22:19" />Ma wọ, Abraham ọkpa nnạm ọta okhebha atọhmnạng pẹ k'ibyi sabẹ aning atikh-ẹ, abẹ abina abhạna k'Beershẹba. Ma wọ Abraham usi uruk kwẹ.<verse eid="GEN 22:19" /></para>
  <para style="s1">Ẹnạmma ch'Nahọr</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 22:20" />K'okpe mạnna gwạnọ, abẹ akpaakhẹ Abraham bẹ́, Milka, kw'ode ikwanạng kw'nnwakka, kw'ode Nahọr, kk'ajunungva ọbạra ọmaana ọnạng-ẹ. Wa iva p'Milka ọmaanẹ ọnạng Nahọr ade:<verse eid="GEN 22:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="GEN 22:21" />Uz, kw'ode ocheden-nwa,</para>
  <para style="li1" vid="GEN 22:21">Wa Uz ọkhaam ivọhkka p'akpen Buz, ọttạra Kẹmuẹl.</para>
  <para style="li1" vid="GEN 22:21">Kẹmuẹl ẹma wa ode otte kw'Aram,<verse eid="GEN 22:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="GEN 22:22" />ọbạra ode otte kw'Kẹsẹd,</para>
  <para style="li1" vid="GEN 22:22">ọttạra Hazo,</para>
  <para style="li1" vid="GEN 22:22">ọttạra Pildash,</para>
  <para style="li1" vid="GEN 22:22">ọttạra Jidlaph</para>
  <para style="li1" vid="GEN 22:22">ọttạra Bẹtuẹl. <verse eid="GEN 22:22" /><verse number="23" style="v" sid="GEN 22:23" />Bẹtuẹl ode otte kw'Rẹbẹka. Milka wa ọmaanẹ ajunungva asenọttaan ọnạng Nahọr kw'ode nnwọkka kw'Abraham.<verse eid="GEN 22:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 22:24" />Wa oyok kw'Nahọr kw'okpen Reuma ọbạra ọmaan-ẹ ajunungva p'ade: Tẹba, ọttạra Gaham, ọttạra Tahash, ọttạra Maaka.<verse eid="GEN 22:24" /></para>
  <chapter eid="GEN 22" />
  <chapter number="23" style="c" sid="GEN 23" />
  <para style="s1">Obo ọttạra ẹnnọhnga ch'Sara</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 23:1" />Wa Sara urukhu icho arạbh asajạnẹ ukuma isenọfa. <verse eid="GEN 23:1" /><verse number="2" style="v" sid="GEN 23:2" />Ope k'Kiriyat-Arba, kw'abẹ abạra ayeri Hẹbrọn, k'ẹkhạma ch'Kenaan. Wa Abraham ọtạk okpe, utima nkwuna s'ikwanạng kwẹ Sara.<verse eid="GEN 23:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 23:3" />Ma wọ Abraham ubin urik apfhura p'ikwanạng kwẹ, ọta okhebha aHet, oben bẹ bẹ́, <verse eid="GEN 23:3" /><verse number="4" style="v" sid="GEN 23:4" />“Amma nde ukhikhennạng ma kabạnga k'ofhon. Akpe-m isisek s'm'ntima nsi innọhng-apfhura, ọfha osenga ma, nnọhnga upfhura kwaam.”<verse eid="GEN 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 23:5" />Ma wọ, aHet apọhn Abraham bẹ́, <verse eid="GEN 23:5" /><verse number="6" style="v" sid="GEN 23:6" />“Attitte, khọhmọ mạna itọhng. Ọma ade ọvaar-nwa kwididen ma kamạna k'ofhon. Tekha epekwur chidede ch'ẹdaakh-ọ ma k'apekwur pamạna nọhnga ikwanạng kwọ. Ọnạng wạnọ-wạnọ ma kòde kw'mọrạm-ọ ibyi s'm'annọhnga ikwanạng kwọ.”<verse eid="GEN 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 23:7" />Ma wọ, Abraham ubin, utwunga echo k'ikpukpobha, usima anạng p'Het. <verse eid="GEN 23:7" /><verse number="8" style="v" sid="GEN 23:8" />Oben bẹ bẹ́, “De kk'bạnga ọdaakha bẹ, nnọhnga ikwanạng kwaam ma kabạnga k'isisek, tte mphyem bạnga udik gwạnọ. Atotokhạn, aphyem Ẹphrọn, kw'ode nnwa kw'Zoha k'akhaam k'echo, <verse eid="GEN 23:8" /><verse number="9" style="v" sid="GEN 23:9" />bẹ, okpe-m ẹtakpa-pe ch'ining k'Makpẹla, k'ọkpicho kw'owonu kwẹ. Aben-ẹ bẹ, okpe-m k'akpokha p'ẹbaan, ọfha ntima chẹ nsi innọhng-apfhura ma kabạnga k'ofhon.”<verse eid="GEN 23:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 23:10" />Masẹ Abraham n'ọkpaak udik ngwọ, ẹma Ẹphrọn kw'ubin Het uning ẹyạr ma anạng pẹ abẹ. Ọnạngẹ Abraham ẹpọhna k'oche kw'anạng p'Het phyibh p'akwu ma ẹbaakhamma ch'ofhon, abhaang. <verse eid="GEN 23:10" /><verse number="11" style="v" sid="GEN 23:11" />Ẹphrọn wa ọpọhn-ẹ bẹ́, “Mma e, aro kwaam, khọhm-m itọhng; tạkha isisek nnọ, ọttạra ọtakpamma kw'ọttạr ma. Ntte ọbọhk nnạng-ọ ma ititikha s'anạng paam. Nọhnga upfhura kwọ mạma.”<verse eid="GEN 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 23:12" />Ma wọ, Abraham ọbạra utwunga echo k'ikpukpobha k'ititikha s'anạng p'ofhon ngwọ. <verse eid="GEN 23:12" /><verse number="13" style="v" sid="GEN 23:13" />N'obeni Ẹphrọn k'ititikha s'anạng mbọ bẹ́, “Totokhạn, khọhm-m itọhng. Amma m'ndebh isisek nnọ odebh e. Tạkha akpokha p'nnạng-ọ ma isek nna, ọfha nnọhnga upfhura kwaam mạma.”<verse eid="GEN 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 23:14" />Ma wọ Ẹphrọn n'ubhin Abraham bẹ́, <verse eid="GEN 23:14" /><verse number="15" style="v" sid="GEN 23:15" />“Aro kwaam, khọhm-m itọhng. Isisek nna ipe ashẹkẹl ẹnọhna p'silva, okhenka, apyẹ ẹgba mbạng k'ẹgbạkha ch'amma ọma abẹ o? Nọhnga upfhura kwọ ọ.”<verse eid="GEN 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 23:16" />Wa Abraham ocher oche kw'Ẹphrọn obeni, ọnạng Ẹphrọn okpokhabhik ma ititikha s'anạng p'Het otor k'ẹphya ch'ọkpaakhẹ. Wa ọnạng-ẹ ashẹkẹl ẹnọhna p'silva otor k'okpokhabhik kw'okpe ngwọ.<verse eid="GEN 23:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 23:17" />Ma wọ, Ẹphrọn ọtạk isisek nnọ s'ining k'Makpẹla ọbaanga Mamrẹ, ọttạra ẹtakpa-pe ch'ẹttạr mạma, ọttạra k'nchi phyi-phyibh s'ibe ma ibyi nnọ okpe, <verse eid="GEN 23:17" /><verse number="18" style="v" sid="GEN 23:18" />ọnạng Abraham masẹ isisek sẹ, k'ititikha s'anạng p'Het phyibh p'aning k'ẹbaakhamma ch'ofhon ngwọ. <verse eid="GEN 23:18" /><verse number="19" style="v" sid="GEN 23:19" />Masẹ nttọhna s'isisek nnọ kk'isa o, Abraham ọta ọnnọhnga ikwanạng kwẹ, Sara, k'ẹtakpa-pe ch'ining k'Makpẹla, ọbaanga Mamrẹ kw'ode Hẹbrọn, k'ẹkhạma ch'Kenaan. <verse eid="GEN 23:19" /><verse number="20" style="v" sid="GEN 23:20" />Ma wọ, anạng p'Het atạk isisek nnọ, ọttạra ẹtakpa-pe njọ akpe anạng Abraham, utima usi innọhng-apfhura sẹ.<verse eid="GEN 23:20" /></para>
  <chapter eid="GEN 23" />
  <chapter number="24" style="c" sid="GEN 24" />
  <para style="s1">Isaak ọttạra Rẹbẹka</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 24:1" />K'okpe kw'uwa Abraham kk'ọtạma mororo, icho sẹ ibạra isaabh, wa Ọvaar Ubinọkpaabyi kk-ẹ udia k'ukhira kwidede. <verse eid="GEN 24:1" /><verse number="2" style="v" sid="GEN 24:2" />Wa Abraham obeni ocho kw'atọhmnạng p'ẹchọhmfhạr ọttạra udik kwidede kw'ode kwẹ bẹ́, “Ge ọbọhk kwọ k'ntaak saam isekhisek. <verse eid="GEN 24:2" /><verse number="3" style="v" sid="GEN 24:3" />Amma nnoru bẹ́, achekhi k'eche ch'Ọvaar Ubinọkpaabyi, kw'ode Ubinọkpaabyi kw'ẹrạng ọttạra isek bẹ́, ọma ikwanạng k'aminava p'Kenaan, p'nnukhu bẹ abẹ maa, mátạkha anạng nnwa kwaam. <verse eid="GEN 24:3" /><verse number="4" style="v" sid="GEN 24:4" />Okhenka, sọhng k'ẹkhạma chaam, k'anạng paam oyeni, ata atạkha ikwanạng anạng nnwa kwaam, Isaak.”<verse eid="GEN 24:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 24:5" />Ọtọhmnạng nwọ ọbạbh-ẹ bẹ́, “Ode ikwanạng nwọ nạnóchera bẹ́, ọtwạn abamẹ ukwuna ma isek nna mo? N'ode bẹ́, n'abạra ntima nnwa kwọ mkpa nnạm k'ofhon kw'ammaan o?”<verse eid="GEN 24:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 24:6" />Abraham oben-ẹ bẹ́, “Mma o. Nạngẹ yạyom ayom bẹ́, atim nnwa kwaam akpa nnạm mạma o. <verse eid="GEN 24:6" /><verse number="7" style="v" sid="GEN 24:7" />Ọvaar Ubinọkpaabyi, kw'ode Ubinọkpaabyi kw'ẹrạng, kw'utim-m ubina k'ẹchọhmfhạr ch'otte kwaam, ọttạra k'ọmmaana-fhon kwaam. Ọkpaakh-m udik, ọbạra ochekhi ọnạng-m oben bẹ́, Amma m'nnạng iva p'iva pọ isisek nna. Ema m'ọtọhm itọhmọ sẹ, s'm'itibh-ọ eden ch'm'asenga, ọfha atạkha ikwanạng mạma anạng nnwa kwaam. <verse eid="GEN 24:7" /><verse number="8" style="v" sid="GEN 24:8" />De ikwanạng nwọ nạnóchera bẹ́, ọtwạn abọ ukwuna, songa bẹ́, kk'annaanga k'echekha nja chaam. Okhenka, nnwa kwaam kátima akpa nnạm kạkha o.” <verse eid="GEN 24:8" /><verse number="9" style="v" sid="GEN 24:9" />Mạnna wọ, ọtọhmnạng nwọ oge ọbọhk kwẹ k'ntaak s'aro kwẹ, Abraham, ochekhi bẹ́, ẹma m'usi oche kw'aro kwẹ obeni.<verse eid="GEN 24:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 24:10" />Ma wọ ọtọhmnạng nwọ ọtạk akamẹl jobh p'aro kwẹ, ọbạra ọtạkha ekpo-jibha k'ukhira k'ukhira k'aro kwẹ, ọnạna akamẹl mbọ. Ubina osenga ofona k'Aram-Naharayim, osenga ukpira k'ofhon kw'uwa Nahọr urukhu. <verse eid="GEN 24:10" /><verse number="11" style="v" sid="GEN 24:11" />Ukwu ukpira ma ẹchọhkha, k'okpe kw'ipanạng n'ata akhaabha asi, ma wọ utim akamẹl mbọ okwokha ọyọhng ma isipe ch'ining k'ofhon ọkhaan-ọkhaan.<verse eid="GEN 24:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 24:12" />Ma wọ, n'ose njọhm oben bẹ́, “O Ọvaar Ubinọkpaabyi, Ubinọkpaabyi kw'aro kwaam, Abraham, si-m nkhaama ọyọbh ma iwu ch'chemma, abạra asi ọphyaam anạng aro kwaam, Abraham. <verse eid="GEN 24:12" /><verse number="13" style="v" sid="GEN 24:13" />Kker e, amma mbe ma isipe nja ọkhaan-ọkhaan ch'aminava p'ofhon ngwa n'akwu akhaabha asi. <verse eid="GEN 24:13" /><verse number="14" style="v" sid="GEN 24:14" />Tte akwẹ ode bẹ́, de mbeni uminanwa wạnọ bẹ́, ‘Totokhạn, mekh-m asi k'isijọ chọ ngwo,’ oben-m bẹ́, ‘Gwo, ọfha mbạra nnạng akamẹl pọ,’ tte ode bẹ́, ẹma wọ kw'kk'atekha anạng ọtọhmnạng kwọ Isaak. Ma wọ, m'nsonga bẹ́, kk'ọphyaam asia anạng aro kwaam.”<verse eid="GEN 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 24:15" />Bạrasẹ n'okker njọhm sạse, Rẹbẹka uyin kạkha, isijọ achẹ kha nkkaang. Ẹma wa ode uminanwa kw'Bẹtuẹl kw'ode ujunungnwa kw'Milka ọmaanẹ ọnạng Nahọr, kw'ode nnwọkka kw'Abraham. <verse eid="GEN 24:15" /><verse number="16" style="v" sid="GEN 24:16" />Uminanwa nwọ ọkhankẹ ujibh iminava. Ibyi s'ujunung tạm nósonga. Mạnna wọ wa ọsạk k'isipe, utima isijọ ọkhaabha asi tạrr achẹ ifu, utima uvura.<verse eid="GEN 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 24:17" />Ma wọ, ọtọhmnạng kw'Abraham udwuk ọta okhebha Rẹbẹka oben-ẹ bẹ́, “Totokhạn, mekh-m asiva k'isijọ chọ, ngwo.”<verse eid="GEN 24:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 24:18" />Rẹbẹka oben-ẹ bẹ́, “Aro kwaam, tạkha asi gwo.” Ọsạkha isijọ k'ẹbhạr-k'ẹbhạr utima k'mbọhk, ọnạng-ẹ asi ogwo.<verse eid="GEN 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 24:19" />Masẹ kk'ẹ asi ọnạnga ogwo o, n'oben-ẹ bẹ́, “Amma m'mgba nkhaabha nnạng akamẹl pọ, agwo tạrr ebenga bẹ.” <verse eid="GEN 24:19" /><verse number="20" style="v" sid="GEN 24:20" />Ma wọ, udwuk ọta owona asi k'ọttọhk f'nten n'igwo asi, ọkpa nnạm k'isipe ọta ọkhaabha ọnạng akamẹl pẹ, apyẹ egwo tạrr ebenga bẹ. <verse eid="GEN 24:20" /><verse number="21" style="v" sid="GEN 24:21" />Ma wọ, ọtọhmnạng umyi <char style="it">bẹ tọọhng</char>, n'oge-ẹ utum mororo, ọfha ose de ode bẹ, Ọvaar Ubinọkpaabyi kk'ẹ uwujibh ọnạnga k'osenga kw'ọta.<verse eid="GEN 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 24:22" />Masẹ akamẹl kk'asi agwua phyibh, ọtọhmnạng nwọ ọtạkha ẹbaanga ch'gol ch'isung, ch'adọhbh pẹ akpir adọhbh p'beka wạnọ, ọbạra ọtạkha ọmaan ọfa p'gol p'mbọhk, p'adọhbh pẹ akpir adọhbh p'ashẹkẹl jobh. <verse eid="GEN 24:22" /><verse number="23" style="v" sid="GEN 24:23" />Ọbạbh-ẹ bẹ́, “Anẹ wọ ofhon-ọ? Totokhạn kpaakh-m, ibyiyimasẹ ining kha ọchọhm kw'atte, s'amma ọttạra anạng paam m'anyima ma irungu yeri?”<verse eid="GEN 24:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 24:24" />Rẹbẹka ubhin-ẹ bẹ́, “Amma nde nnwa kw'Bẹtuẹl, kw'Milka ọmaanẹ ọnạng Nahọr.” <verse eid="GEN 24:24" /><verse number="25" style="v" sid="GEN 24:25" />Ọbạra oben bẹ́, “Amạna ankhaam uchiattọhk k'ọsaabh, fa nten sọ m'ichi, ọttạra ibyiyimasẹ s'abạnga m'ayima ma irungu.”<verse eid="GEN 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 24:26" />Ma wọ ọtọhmnạng nwọ utwung echo, ọnạng Ọvaar Ubinọkpaabyi ikpukpobha, <verse eid="GEN 24:26" /><verse number="27" style="v" sid="GEN 24:27" />oben bẹ́, “Ẹtọhnga ede ch'Ọvaar Ubinọkpaabyi, kw'ode Ubinọkpaabyi kw'aro kwaam, Abraham. Ẹma kk'aro kwaam ọphyaam pfẹ f'udik ọkka ọnạnga. Node amma, Ọvaar Ubinọkpaabyi kk'aam ma osenga ngwa <char style="it">bẹ bẹẹm</char>, ọnwa k'ọchọhm kw'anạng p'aro kwaam.”<verse eid="GEN 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 24:28" />Wa uminanwa nwọ ọrạbhọ ọta ọkpaak ẹchọhmfhạr ch'ọkka idik nnọ. <verse eid="GEN 24:28" /><verse number="29" style="v" sid="GEN 24:29" />Wa Rẹbẹka ọkhaam nnwọkka kw'ujunung kw'okpen Laban, kw'udwuk ọta okhebha ọtọhmnạng nwọ k'isipe. <verse eid="GEN 24:29" /><verse number="30" style="v" sid="GEN 24:30" />Oche ngwọ kw'ose ẹbaanga ch'isung, ọttạra ọmaan f'nnwọkka oge k'mbọhk, ukwu ọttạra k'idik s'ọbhaang s'Rẹbẹka ọkpaakhẹ otena k'ujunung nwọ, n'ubin ọta okhebha ọtọhmnạng nwọ s'obe ọttạra akamẹl ọbaanga isipe. <verse eid="GEN 24:30" /><verse number="31" style="v" sid="GEN 24:31" />Oben bẹ́, “Kwu e, ọma kw'Ọvaar Ubinọkpaabyi kk'udia, ode yạn kw'atim abe ma o? Kwu amfona, khiri k'ibyi ndia nchokh-ọ, ọttạra ibyi s'akamẹl pọ m'ayima.”<verse eid="GEN 24:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 24:32" />Ma wọ, ọtọhmnạng nwọ ọtwạnọ abẹ ofona k'ọchọhm, abẹ achaarẹ akamẹl ntọhkha, abạra anạng bẹ uchiattọhk, abẹ anạng ọtọhmnạng nwọ ọttạra anạng p'atwạnọ abẹ asi, p'abẹ m'atima akpobhu mfhok sabẹ. <verse eid="GEN 24:32" /><verse number="33" style="v" sid="GEN 24:33" />Ma o, abẹ aber bẹ uchiattọhk, okhenka, ọtọhmnạng nwọ ọbẹ́, “Amma ọttọhk mạ́nchi tạrr mkpaak bạnga udik kw'nseng akwẹ nkwu.” Laban oben-ẹ bẹ́, “ọma Kpaak mạna.”<verse eid="GEN 24:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 24:34" />Ma wọ, obeni bẹ́, Amma nde ọtọhmnạng kw'Abraham. <verse eid="GEN 24:34" /><verse number="35" style="v" sid="GEN 24:35" />Ọvaar Ubinọkpaabyi kk'aro kwaam udia mororo, kk'ujibhada-nạng udia. Kk'ẹ arạkhạmaan, ọttạra mmaam, ọttạra asilva, ọttạra agol, ọttạra atọhmnạng p'ajunung ọttạra p'ipanạng, ọttạra akamẹl, ọttạra nyạnyaang ọnạnga. <verse eid="GEN 24:35" /><verse number="36" style="v" sid="GEN 24:36" />Sara kw'ode ikwanạng kw'aro kwaam, kk'ẹ ujunungnwa ọmaana k'atạm. Aro kwaam k'ẹkhaama chẹ phyibh ọbọhk utia ọnạng nnwa nwọ. <verse eid="GEN 24:36" /><verse number="37" style="v" sid="GEN 24:37" />Aro kwaam usim ntạkha echekha, oben-m bẹ́, ‘Nạngẹ ikwanạng k'aminava p'anạng p'Kenaan p'nnukhu bẹ abẹ maa, atạk anạng nnwa kwaam. <verse eid="GEN 24:37" /><verse number="38" style="v" sid="GEN 24:38" />Okhenka, sọhng k'efona ch'otte kwaam, k'anạng paam, ata atạkha ikwanạng anạng nnwa kwaam.’<verse eid="GEN 24:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="GEN 24:39" />“Ma wọ, mbạbhọ aro kwaam bẹ́, ‘Ode ikwanạng nwọ nạn ochera bẹ, ọtwạn abamẹ ukwuna mo?’<verse eid="GEN 24:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="GEN 24:40" />“Aro kwaam ubhin-m bẹ́, ‘Ọvaar Ubinọkpaabyi kw'amma n'mkpobha k'eden ọkkachẹ, m'ọtọhm itọhmọ sẹ, itim-ọ eden, ibạra inạng-ọ uwujibh k'osenga kwọ, ọfha asenga ma atạkha ikwanạng k'efona ch'otte kwaam, k'anạng paam, anạng nnwa kwaam. <verse eid="GEN 24:40" /><verse number="41" style="v" sid="GEN 24:41" />Ode afon k'ẹnạmma chaam, echekha kọ mẹ́vạkha, s'ọbạra ode bẹ, abẹ náchera anạng-ọ uminanwa nwọ, echekha njọ kọ mẹ́vạkha e.’<verse eid="GEN 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="GEN 24:42" />“Masẹ mkpir ma k'isipe nja chemma, mbeni bẹ́, O Ọvaar Ubinọkpaabyi, kw'ode Ubinọkpaabyi kw'aro kwaam Abraham, de ode ẹkka chọ, totokhạn, nạng-m uwujibh ma osenga ngwa kw'kk'nkwua ma o. <verse eid="GEN 24:42" /><verse number="43" style="v" sid="GEN 24:43" />Kkeri oche kw'mbe ma isipe ọkhaan-ọkhaan, de uminanwa ukwu bẹ, ukwu ọkhaabha asi, nkwu mben-ẹ bẹ́, “otokhạn, mekh-m asi k'isijọ chọ ngwo,” <verse eid="GEN 24:43" /><verse number="44" style="v" sid="GEN 24:44" />de oben-m bẹ́, “Gwo, mbạra nkhaabha nnạng akamẹl,” tte ẹma ode uminanwa nwọma kw'Ọvaar Ubinọkpaabyi kk'otekha ọnạng nnwa kw'aro kwaam. <verse eid="GEN 24:44" /><verse number="45" style="v" sid="GEN 24:45" />Brasẹ nkera njọhm sạse k'ettem chaam, Rẹbẹka uyin kha, isijọ ạchẹ kha nkkaang, ọsạkha k'isipe ọta ọkhaabha asi. Ma wọ, mben-ẹ bẹ́, Totokhạn, mekh-m asi ngwo.<verse eid="GEN 24:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="GEN 24:46" />“Onemi eden ọsạkha isijọ ch'ọnạn k'ẹkaang, oben-m bẹ́, ‘Gwo, mbạra nkhaabha nnạng akamẹl pọ.’ Ma wọ, amma ngwo asi, ọbạra ọkhaabha ọnạng akamẹl.<verse eid="GEN 24:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="GEN 24:47" />“Nkwu mbạbh-ẹ bẹ́, Anẹ wọ ofhon-ọ?</para>
  <para style="p" vid="GEN 24:47">“Ubhina bẹ́, Amma nde nnwa kw'Bẹtuẹl, kw'Nahọr ofonu k'ntaak s'Milka.</para>
  <para style="p" vid="GEN 24:47">“Ma wọ, nge-ẹ ẹbaanga k'isung, mbạra nge-ẹ imaan k'ọbọhk. <verse eid="GEN 24:47" /><verse number="48" style="v" sid="GEN 24:48" />Amma o, ntwunga echo mkpobha Ọvaar Ubinọkpaabyi, kw'ode Ubinọkpaabyi kw'aro kwaam, Abraham, kw'kk'aam eden utima k'eden ọkkachẹ tạrr nkwu ntạkha nnwa mfhona kw'nnwọkka kw'aro kwaam, nnạng nnwa kwẹ k'ọbada. <verse eid="GEN 24:48" /><verse number="49" style="v" sid="GEN 24:49" />Ma o, de asi ọphyaam f'udik ọkka anạng aro kwaam, kpaakh-m; de nạnásia, kpaak-m, ọfha nsonga oche kw'm'nsi.”<verse eid="GEN 24:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="GEN 24:50" />Laban ọttạra Bẹtuẹl abhina bẹ́, “Masẹ idik nna phyibh ibin k'Ọvaar Ubinọkpaabyi, amạna mba udik gwạnọ-gwạnọ kánkhaam kw'm'amkpaak k'eden chidede. <verse eid="GEN 24:50" /><verse number="51" style="v" sid="GEN 24:51" />Kkeri Rẹbẹka ma, tima abẹ sọhng, tte ode ikwanạng kw'nnwa kw'aro kwọ, oche kw'Ọvaar Ubinọkpaabyi kk'obena.”<verse eid="GEN 24:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="GEN 24:52" />Masẹ ọtọhmnạng kw'Abraham ọbhaang udik kw'abẹ akpaakhẹ, utwunga echo k'isisek, ọnạng Ọvaar Ubinọkpaabyi ikpukpobha. <verse eid="GEN 24:52" /><verse number="53" style="v" sid="GEN 24:53" />Ma wọ, ọtọhmnạng nwọ orengi ẹnya-kpo p'gol ọttạra p'silva, ukwu ọttạra k'ọvạra k'ukhira-k'ukhira, ọnạng Rẹbẹka. Ọbạra ọtạkha ekpo py'epe akpokha ọnạng nnwọkka kw'ujunung, ọttạra ọkka kw'Rẹbẹka. <verse eid="GEN 24:53" /><verse number="54" style="v" sid="GEN 24:54" />Ma wọ, ẹma ọttạra anạng p'atwạnọ abẹ achi ọttọhk, agwo atwuk, abẹ abạra ayima ma.</para>
  <para style="p" vid="GEN 24:54">Masẹ abẹ aphyạbh k'ekpebha, n'obeni bẹ́, “Atọhm-m mmạna ntor aro kwaam.”<verse eid="GEN 24:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="GEN 24:55" />Okhenka, nnwọkka kw'Rẹbẹka ọttạra ọkka n'abhin bẹ́, “Tte Rẹbẹka uninga mạna abẹ masẹ ọttọhk f'iwu jobh, brasẹ abạnga atwạn afona.”<verse eid="GEN 24:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="GEN 24:56" />Okhenka, ọtọhmnạng nwọ ubhina bẹ bẹ́, “Totokhạn, tte ntor aro kwaam. Abạnga kaam kávạkha achok, s'Ọvaar Ubinọkpaabyi kk'aam uwujibh ọnạnga. Atọhm-m mmạna ntor aro kwaam.”<verse eid="GEN 24:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="GEN 24:57" />Ma wọ, abẹ abhin-ẹ bẹ́, “Tte anyeri Rẹbẹka oyeni ambạbh-ẹ k'anse.” <verse eid="GEN 24:57" /><verse number="58" style="v" sid="GEN 24:58" />Ma wọ, abẹ ayeri Rẹbẹka abạbh-ẹ bẹ́, “Ọma sạm ọdaakh-ọ bẹ, atwạn ujunung nwa abẹ afona o?”</para>
  <para style="p" vid="GEN 24:58">Ubhina bẹ́, “Uwe e, amma ọdạkh-m mạma e.”<verse eid="GEN 24:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="GEN 24:59" />Ma wọ, abẹ ata arik nnwọkka Rẹbẹka k'eden, ọttạra ọrạrạkha kwẹ, ọttạra ọtọhmnạng kw'Abraham, ọttạra anạng p'atwạnọ abẹ. <verse eid="GEN 24:59" /><verse number="60" style="v" sid="GEN 24:60" />Abẹ abạra ayọbh Rẹbẹka itta, aben-ẹ bẹ́,</para>
  <para style="q1" vid="GEN 24:60">“Nwọkka kwamạna o, tte ọmaan ujibh-ọ, amaan k'ọsaabh</para>
  <para style="q2" vid="GEN 24:60">k'nnọhna k'nnọhna ibhik-asong;</para>
  <para style="q1" vid="GEN 24:60">Tte iva p'iva pọ akwu atạkha</para>
  <para style="q2" vid="GEN 24:60">ifhon s'awawunanạng pabẹ.”<verse eid="GEN 24:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="GEN 24:61" />Ma wọ, Rẹbẹka ọttạra aminava p'arukhu abẹ, ado ifor avura akamẹl pabẹ, atwạn ọtọhmnạng kw'Abraham abẹ afona. Ma wọ, ọtọhmnạng nwọ ọtạk Rẹbẹka utima ofona.<verse eid="GEN 24:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="GEN 24:62" />Wa Isaak kw'urukhu k'Nẹgẹv kk'ubina k'Beer-Lahai-Roi ukwuna. <verse eid="GEN 24:62" /><verse number="63" style="v" sid="GEN 24:63" />Wa k'ẹchọhkhawu jạnẹ, Isaak osengi ofona k'owonu bẹ, ọta ọtạkha ufhum. Masẹ udir ichen okkeri k'ororo, ose s'akamẹl n'akwu. <verse eid="GEN 24:63" /><verse number="64" style="v" sid="GEN 24:64" />Rẹbẹka ọbạra ubina ichen okkeri k'ororo ose Isaak, ma wọ ọsạk k'kamẹl kwẹ, <verse eid="GEN 24:64" /><verse number="65" style="v" sid="GEN 24:65" />ọbạbh ọtọhmnạng bẹ́, “Bạng ujunung wọ ma kw'n'ukwu otor mạna kạkha?”</para>
  <para style="p" vid="GEN 24:65">Ọtọhmnạng nwọ ubhina bẹ́, “Aro kwaam wọ e.” Ma o, Rẹbẹka ọtạkha ọphyọhng kwẹ ububha k'ititikha sẹ.<verse eid="GEN 24:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="GEN 24:66" />Ma wọ, ọtọhmnạng nwọ ọkpaakhẹ Isaak idik s'kkusia bẹ, phyibh. <verse eid="GEN 24:66" /><verse number="67" style="v" sid="GEN 24:67" />Ma wọ, Isaak utim-ẹ ọnwạ k'ikkira s'ọkka kwẹ, Sara. Rẹbẹka n'ode ikwanạng kw'Isaak, Isaak ọkhọhkha Rẹbẹka idạdaakha, utima ma ofokhu ẹmoyeni nttem k'obo kw'ọkka kwẹ.<verse eid="GEN 24:67" /></para>
  <chapter eid="GEN 24" />
  <chapter number="25" style="c" sid="GEN 25" />
  <para style="s1">Obo kw'Abraham</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 25:1" />Wa Abraham ọkhaam oyok kw'okpen Kẹtura.<verse eid="GEN 25:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="GEN 25:2" />Ẹma wọ ọmaan-ẹ Zimran, ọttạra Jọkshan, ọttạra Medan, ọttạra Midiyan, ọttạra Ishbak, ọttạra Shua.<verse eid="GEN 25:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="GEN 25:3" />Jọkshan wa ode otte kw'Sheba ọttạra Dedan; iva p'iva p'Dedan ade abAshur, ọttạra abạLẹtush, ọttạra abạLeum.<verse eid="GEN 25:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="GEN 25:4" />Ajunungva p'Midiyan ade Ẹpha, ọttạra Ẹphẹr, ọttạra Hanọk, ọttạra Abida, ọttạra Ẹlda. Iva mbọ phyibh wa abẹ ade iva p'iva p'Kẹtura.<verse eid="GEN 25:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 25:5" />Wa Isaak okkem ẹkhaama phyibh ch'Abraham ope urik. <verse eid="GEN 25:5" /><verse number="6" style="v" sid="GEN 25:6" />Okhenka, Abraham wa utim ẹkhaama chẹ ẹdwạkh-ọdwạk ọbhaangẹ iva mbọkha phyibh, p'ayok pẹ, oben abẹ akhạm aruk atena k'ukhubha kw'okpebha-dudon n'uyin, ọfha abẹ arik Isaak ẹbhaang.<verse eid="GEN 25:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 25:7" />Phyi-phyibh wa Abraham urukhu icho arạbh asenọttaan ukuma chi. <verse eid="GEN 25:7" /><verse number="8" style="v" sid="GEN 25:8" />Ma wọ, Abraham ọjẹ ikpongannạm-yọhng sẹ, ukwu ope k'atạm otor anạng pẹ p'kk'apua. <verse eid="GEN 25:8" /><verse number="9" style="v" sid="GEN 25:9" />Wa Isaak ọttạra Ishimayẹl annọhng otte kwabẹ, Abraham, k'ẹtakpa-pe ch'ining k'Makpẹla, ọbaanga Mamrẹ, k'isisek s'Ẹphrọn, kw'ode nnwa kw'Zoha kw'ubin Het. <verse eid="GEN 25:9" /><verse number="10" style="v" sid="GEN 25:10" />Wa Abraham odebhi isisek nnọ k'mbọhk s'anạng p'Het. Wa abẹ annọhng Abraham ma ibyi nnọ rạnẹ s'uwa abẹ annọhng ikwanạng kwẹ Sara.<verse eid="GEN 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 25:11" />Masẹ Abraham kk'upua, Ubinọkpaabyi odo nnwa kwẹ Isaak, kw'uwa n'urukhu ọbaanga Beer-Lahai-Roi.<verse eid="GEN 25:11" /></para>
  <para style="s1">Efona ch'Ishimayẹl</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 25:12" />Maa wọ ode efonamma ch'Ishimayẹl, kw'Abraham ofhonu k'ntaak s'Hagar kw'ubin Ijip, kw'uwa ode ubira kw'Sara.<verse eid="GEN 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 25:13" />Maa wọ ode ache p'iva p'Ishimayẹl k'oche kw'ofhonu bẹ:</para>
  <para style="li1" vid="GEN 25:13">Nẹbayọt, ọttạra Kẹda, ọttạra Adbẹl, ọttạra Mibsam,<verse eid="GEN 25:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="GEN 25:14" />ọttạra Mishma, ọttạra Duma, ọttạra Masa,<verse eid="GEN 25:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="GEN 25:15" />ọttạra Hadad, ọmaana Tẹma, ọttạra Jetur, ọttạra Naphish, ọttạra Kẹdẹma.<verse eid="GEN 25:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="GEN 25:16" />Maa wọ ode ajunungva p'Ishimayẹl, p'adạbhẹ nkhạma jobh-kamfa, s'ikpen ache ibhina k'avaar-va pabẹ, ator k'ukhira kw'abẹ arukhu k'ibyibhingasẹ sabẹ. <verse eid="GEN 25:16" /><verse number="17" style="v" sid="GEN 25:17" />Phyi-phyibh wa Ishimayẹl urukhu icho arạbh asajạnẹ ukuma chikhamfa, brasẹ n'ope otor anạng pẹ p'kk'apua. <verse eid="GEN 25:17" /><verse number="18" style="v" sid="GEN 25:18" />Wa iva p'iva pẹ arukhu tạma k'ukhubha kw'Havila tạrr akpira k'ukhubha kw'Shur, ọbaanga erem ch'Ijip, s'n'aben bẹ, afona k'ukhubha kw'Ashur. Wa abẹ arukhu k'iwawuna attra ivotte pabẹ phyibh.<verse eid="GEN 25:18" /></para>
  <para style="s1">Ẹmmaana ch'Ẹsau ọttạra Jekọb</para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 25:19" />Maa wọ ode efonamma ch'Isaak, kw'ode nnwa kw'Abraham.</para>
  <para style="p" vid="GEN 25:19">Wa Abraham ofhonu Isaak. <verse eid="GEN 25:19" /><verse number="20" style="v" sid="GEN 25:20" />K'okpe kw'uwa Isaak ode icho arạbh afa, ọtạk Rẹbẹka k'ọbada. Rẹbẹka ode nnwa kw'Bẹtuẹl kw'ubin Aram kw'Padan-Aram, ọbạra ode nnwọkka kw'Laban.<verse eid="GEN 25:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 25:21" />Wa Rẹbẹka nnwa nọ́maana, ma wọ, Isaak ose njọhm ọnạng Ọvaar Ubinọkpaabyi k'echo ch'Rẹbẹka. Ọvaar Ubinọkpaabyi ọbhaanga njọhm sẹ, usi Rẹbẹka utima ifhạr. <verse eid="GEN 25:21" /><verse number="22" style="v" sid="GEN 25:22" />Wa iva afa p'aning-ẹ k'ẹfhạr n'arima ayok abẹ. Ma wọ, Rẹbẹka ọbạbhọ bẹ́, “Bạng udik gwọ okhebh mama o?” Ma wọ, ororu udik ngwọ ọbạbh Ọvaar Ubinọkpaabyi.<verse eid="GEN 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 25:23" />Ọvaar Ubinọkpaabyi ubhin-ẹ bẹ́,</para>
  <para style="q1" vid="GEN 25:23">“Nkhạma mfa rọ ining-ọ ma ẹfhạr,</para>
  <para style="q2" vid="GEN 25:23">nkhạma nnọ mfa s'ining-ọ ma ẹfhạr, kwạna m'ibhaangẹ ayok,</para>
  <para style="q1" vid="GEN 25:23">ẹkhạma jạnẹ m'ẹkhaama ẹfa ẹyọhnga oyok,</para>
  <para style="q2" vid="GEN 25:23">ẹkhạma ch'ichi eden ẹmmaana m'iruk k'isekhisek kw'ẹkhạma ch'isạsạkhẹ.”<verse eid="GEN 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 25:24" />Masẹ okpe ukpir kw'm'ọmaan, ajunungva agbagba afa bọ aning-ẹ k'ẹfhạr. <verse eid="GEN 25:24" /><verse number="25" style="v" sid="GEN 25:25" />Ocheden-nwa kw'uyini okhor-okhor, ọbạra ọkhaama iphyạbha k'ifor masẹ ẹnọhmakpa ch'ede iphyạbha-iphyạbha. Ma wọ, abẹ akpẹ-ẹ Ẹsau. <verse eid="GEN 25:25" /><verse number="26" style="v" sid="GEN 25:26" />Masẹ ocheden kk'uyina, nnwọkka ọbạra uyin, ọkpạna Ẹsau k'ifokkukkọhrọ. Ma wọ, abẹ akpẹ-ẹ Jekọb. Wa Isaak n'ode icho arạbh attan, k'okpe kw'uwa Rẹbẹka ọmaanẹ agbagba mbọ.<verse eid="GEN 25:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 25:27" />Masẹ iva mbọ kk'abạra, Ẹsau ode ọnạng kw'okke ẹgbaji, ọbạra ode ọnạng kw'n'ọnwa ẹkpa. Okhenka, Jekọb ẹma ode ọnạng kw'udiri akpen, kw'n'ọkhọhng eter-kwora. <verse eid="GEN 25:27" /><verse number="28" style="v" sid="GEN 25:28" />Ẹma Isaak wa ọdaakhẹ ẹkpaten chichi, osenga ma, Ẹsau kw'ode ọgbajinạng ukwu ọdaakh-ẹ idik, okhenka, Jekọb wa ọdaakhẹ Rẹbẹka.<verse eid="GEN 25:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 25:29" />Iwu jạnẹ s'uwa Jekọb n'ọwọhn uchiattọhk, Ẹsau ukwun ẹgbaji okwo apfẹ, s'apfẹ kk'ẹ ọkhaama tạrr ifor imạm-ẹ. <verse eid="GEN 25:29" /><verse number="30" style="v" sid="GEN 25:30" />Ma wọ, obeni Jekọb bẹ́, “Kperi idibhi-khorada njọ náng-m ẹbhạr-ẹbhạrẹ, khiri okwo kkhaam ọfha!” Abẹ asenga ma, ayeri Ẹsau bẹ́, Edom, (kw'uyini ekhora).<verse eid="GEN 25:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 25:31" />Jekọb ubhin-ẹ bẹ́, “Ọma chi eden nạng-m edennạng chọ ch'ocheden-nwa.”<verse eid="GEN 25:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 25:32" />Ẹsau n'ubhin-ẹ bẹ́, “Bạng ọttọhk vọ okpen echeden s'okwo n'oben bẹ, ọdwạng-m achen ma o?”<verse eid="GEN 25:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 25:33" />Okhenka, Jekọb oben-ẹ bẹ́, “Ọma chi eden chekhi bẹ, m'anạng-m edennạng chọ bạra.” Ma wọ, Ẹsau ochekhi, ọtạkha edennạng chẹ ọnạng Jekọb.<verse eid="GEN 25:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 25:34" />Ma wọ, Jekọb ọtạk brẹd, ọttạra k'ẹbọhnga-dibhi ọnạng Ẹsau uchi, ọbạra ogwo asi, brasẹ n'ubin ofona. Mạnna wọ kw'uwa Ẹsau oseng unnukhu edennạng chẹ ch'ocheden-nwa.<verse eid="GEN 25:34" /></para>
  <chapter eid="GEN 25" />
  <chapter number="26" style="c" sid="GEN 26" />
  <para style="s1">Isaak ọttạra Abimẹlẹk</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 26:1" />Ma okpe ngwọ, wa okwo fididen uning k'ofhon, de akperi mvọ f'uwa otto k'okpe kw'Abraham abhạrẹ. Wa Isaak ubin ofona k'Gẹra, ọta okhebha Abimẹlẹk kw'ode ọvaarnạng kw'aPhilistiya. <verse eid="GEN 26:1" /><verse number="2" style="v" sid="GEN 26:2" />Ma wọ, Ọvaar Ubinọkpaabyi uyini Isaak abẹ, oben-ẹ bẹ́, “K'Ijip káta o. Ruk ma isek nna s'mben-ọ bẹ, aruk. <verse eid="GEN 26:2" /><verse number="3" style="v" sid="GEN 26:3" />Ninga ma isek nna k'okpe nwa sạsạkhẹ, amma m'nninga abọ, mbạra ndi-ọ. Amma m'ntạkha isisek nna phyi-phyibh nnạng ọma ọttạra iva p'iva pọ, mbạra nsi idik s'uwa nchekhi nnạng atte kwọ, Abraham. <verse eid="GEN 26:3" /><verse number="4" style="v" sid="GEN 26:4" />Amma m'nsi iva p'iva pọ asaabh masẹ ndudoru s'ọrạngkpakpa, mbạra nnạng bẹ isisek nna <char style="it">bẹ phyibh</char>. Idifhon phyibh m'isenga k'iva p'iva pọ ikhaama idia, <verse eid="GEN 26:4" /><verse number="5" style="v" sid="GEN 26:5" />ukwuru bẹ, Abraham ọsạk echo ọnạng-m, usi idik otor k'oche kw'ntọhn-ẹ, ọbạra ochok nnyina saam, ọttạra ekpebha chaam, ọttạra ntọhna saam.” <verse eid="GEN 26:5" /><verse number="6" style="v" sid="GEN 26:6" />Ma wọ, Isaak n'urukhu k'Gẹra.<verse eid="GEN 26:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 26:7" />Masẹ ajunung p'ofhon ngwọ n'abạbh-ẹ udik atena k'ikwanạng kwẹ o, n'utim ojora, ubhin bẹ bẹ́, “Mma e, ẹma ode nnwọkka kwaam-e.” Wa ojor-ẹ ojora bẹ, oben bẹ, ikwanạng kwẹ wọ. Okkẹ k'ettem bẹ́, “Ajunung p'ofhon ngwa akk-okke afhọ-m, ukwuru ajibhada p'Rẹbẹka.”<verse eid="GEN 26:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 26:8" />Masẹ Isaak kk'urukha ma k'okpe kw'kk'ubhira, Abimẹlẹk kw'ode ọvaarnạng kw'aPhilistiya obe k'ọmmakhubh, ose s'Isaak n'usi idạdaakha ọttạra ikwanạng kwẹ, Rẹbẹka. <verse eid="GEN 26:8" /><verse number="9" style="v" sid="GEN 26:9" />Ma wọ, Abimẹlẹk oyeri Isaak oben-ẹ bẹ́, “K'udik ọkka, ikwanạng kwọ wọ ma! Asi yạn aben bẹ, nnwọkka kwọ wọ?”</para>
  <para style="p" vid="GEN 26:9">Isaak ubhin-ẹ bẹ́, “Amma nkkẹ bẹ, abẹ m'asenga kakhẹ echo, afhọ-m e.”<verse eid="GEN 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 26:10" />Ma wọ, Abimẹlẹk ọbạbh-ẹ bẹ́, “Ukwuru yạn kw'asi udik demakwẹ ngwa? Wạra ode bẹ, ujunung wạnọ k'ikhaana s'ajunung p'ofhon ngwa kk'ikwanạng kwọ abẹ uyima, bẹ njanna wạra kk'mạna iponga-pyibha anạna k'echo.”<verse eid="GEN 26:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 26:11" />Ma wọ, Abimẹlẹk ọnạngẹ inyina ọbaabha ofhon bẹ́, “Ọnạng kwidede kw'ọsẹkhẹ ujunung nwa, ọbạra ode ikwanạng kwẹ ma ofhon ngwa, oyonga m'ope.”<verse eid="GEN 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 26:12" />Ma cho ngwọ gwạnọ, Isaak utubhu owonu ma isisek nnọ, ọphya ekpo py'utubhu k'ọsaabh, ukwuru s'Ọvaar Ubinọkpaabyi udi-ẹ. <verse eid="GEN 26:12" /><verse number="13" style="v" sid="GEN 26:13" />Wa ukwu ọkhaama ẹkhaama, mạnna wọ ẹkhaama njọ ẹbạrẹ tạrr n'ujibh-ẹ oyong-oyongu. <verse eid="GEN 26:13" /><verse number="14" style="v" sid="GEN 26:14" />Wa ọkhaam itirakpo ọttạra atọhmnạng k'ọsaabh, tạrr aPhilistiya n'akhaam abẹ ottemma. <verse eid="GEN 26:14" /><verse number="15" style="v" sid="GEN 26:15" />Ma wọ, asipe p'uwa atọhmnạng p'otte kwẹ, Abraham kk'atuma ma okpe ngwọ, aPhilistiya atim adọhngọ akpa sẹ <char style="it">bẹ phyibh</char>.<verse eid="GEN 26:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 26:16" />Ma wọ, Abimẹlẹk obeni Isaak bẹ́, “Bina rik ofhon kwamạna, khiri n'akhaam ẹfa ayọhnga mạna kidaam-kidaam.”<verse eid="GEN 26:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 26:17" />Ma wọ, Isaak ubin ma ọta uruk k'ẹrạkh-ẹrạkha k'Gẹra. <verse eid="GEN 26:17" /><verse number="18" style="v" sid="GEN 26:18" />Ọbạra utum asipe mbọ p'aPhilistiya kk'akpa, p'uwa otte Abraham kk'utuma, ọbạra ọnạng pẹ ache mbọ bạnọ p'uwa otte kk'pẹ ọnạnga.<verse eid="GEN 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 26:19" />Okhenka, masẹ atọhmnạng p'Isaak abạra atum isipe ẹdwạkh-ọdwạk tạrr achẹ iyin asi akkapẹ, <verse eid="GEN 26:19" /><verse number="20" style="v" sid="GEN 26:20" />akkeri-nten p'ofhon kw'Gẹra, atạma ẹkhọhr sisi ọttạra akkeri-nten p'Isaak, abẹ aben bẹ́, “Asi mbọ ade pamạna e!” Osenga ma, okpe isipe njọ Ẹsẹk, kw'uyini ẹkhọhr, ukwuru sabẹ akkaan isipe njọ ẹma abẹ. <verse eid="GEN 26:20" /><verse number="21" style="v" sid="GEN 26:21" />Masẹ abẹ atumu adạkhẹ isipe ẹdwạkh-ọdwạk, anạng mbọ ajẹ adạkhẹ ẹkhọhr ma isipe njọ, ma wọ, Isaak okpe chẹ Sitna, kw'uyini ẹkhọhr. <verse eid="GEN 26:21" /><verse number="22" style="v" sid="GEN 26:22" />Ubina ma, ọta utum isipe ẹdwạkh-ọdwạk, ọnạng dạkhẹ abẹ ẹkhọhr núsia. Ukwu okpe chẹ Rehobot, ọbẹ́, “Ọvaar Ubinọkpaabyi kk'mạna ẹbhaang ọnạnga, ma isisek nna rọ m'anninga ankhaama ujibhada.”<verse eid="GEN 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 26:23" />Isaak n'ubin ma ofona k'ofhon kw'Beershẹba. <verse eid="GEN 26:23" /><verse number="24" style="v" sid="GEN 26:24" />Ma irungu njọ, Ọvaar Ubinọkpaabyi uyin abẹ, oben-ẹ bẹ́, “Amma wọ nde Ubinọkpaabyi kw'atte kwọ, Abraham. Nạng-ọ ojor khiri m'nning abọ maa, m'ndi-ọ, mbạra nsi iva p'iva pọ asaabh, ukwuru echekha ch'nkhaam ọttạra atte, Abraham, kw'uwa ode ọtọhmnạng kwaam.”<verse eid="GEN 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 26:25" />Ma wọ, Isaak usi ijabyi ma, uninga ma okpobha Ọvaar Ubinọkpaabyi, ọbạra uttima ikkira sẹ ma, atọhmnạng pẹ abạra atum isipe ma.<verse eid="GEN 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 26:26" />Ma okpe ngwọ, Abimẹlẹk kk'Ahuzat kw'n'ọtọhn-ẹ idik, ọttạra Phikol kw'ode odecho kw'akpongnạng pẹ utima ubina k'Gẹra ukwu. <verse eid="GEN 26:26" /><verse number="27" style="v" sid="GEN 26:27" />Isaak ọbạbhọ bẹ bẹ́, “Ode yạn kw'abạnga n'aror-m, s'uwa abạnga awun-m tạrr abạnga akhubh-m kabạnga k'ofhon?”<verse eid="GEN 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 26:28" />Abẹ abhina bẹ́, “Amạna kk'ansia k'udik ọkka bẹ, Ọvaar Ubinọkpaabyi uning abọ. Osenga ma, amben bẹ, ọbaan-ọbaana bẹ, echekha ininga k'ngekha s'ọma ọttạra amạna mba. Tte ankhaama ẹgbạkha ọma abẹ <verse eid="GEN 26:28" /><verse number="29" style="v" sid="GEN 26:29" />bẹ, ọma mạna ipyibha mási, ator k'oche kw'uwa nạn kọ ipyibha nánsia, ankhenka anjibh abọ idik tạrr antte-ọ ọbọhk abina k'idira. Mantọmma, Ọvaar Ubinọkpaabyi kk'ọ udia.”<verse eid="GEN 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 26:30" />Ma wọ, Isaak usi erobha ọnạng bẹ, abẹ achi, abạra agwo. <verse eid="GEN 26:30" /><verse number="31" style="v" sid="GEN 26:31" />K'ekpekpebha s'iwu echobh ma, abẹ atạkha echekha ayok abẹ. Ma wọ, Isaak ọta urik bẹ k'eden, abẹ aseng abhạna k'idira.<verse eid="GEN 26:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 26:32" />Ma iwu njọ, atọhmnạng p'Isaak akwuna akwu akpaakh-ẹ udik atena k'isipe ch'abẹ kk'atuma. Abẹ akpaakh-ẹ bẹ́, “Kk'asi ansia-e.” <verse eid="GEN 26:32" /><verse number="33" style="v" sid="GEN 26:33" />Ma wọ, Isaak oyeri isipe njọ Shiba, kw'uyini echekha. Tạma ma iwu njọ, ofhon ngwọ n'okpen Beershẹba, kw'uyini isipe ch'echekha, oyongu ma, isipe ch'asenọfa.<verse eid="GEN 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 26:34" />Masẹ Ẹsau n'ode icho arạbh afa, ọtạk ikwanạng kw'okpen Judit kw'ode uminanwa kw'Beeri kw'ubin Het, ọttạra Basẹmat kw'ode uminanwa kw'Ẹlọn kw'ubin adạkhẹ Het. <verse eid="GEN 26:34" /><verse number="35" style="v" sid="GEN 26:35" />Ipanạng mbọ afa asi Isaak ọttạra Rẹbẹka aruk k'imạmạna.<verse eid="GEN 26:35" /></para>
  <chapter eid="GEN 26" />
  <chapter number="27" style="c" sid="GEN 27" />
  <para style="s1">Isaak ọyọhbh Jekọb itta</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 27:1" />K'okpe kw'uwa Isaak kk'ọtạma, dạkhẹ iyaan mororo k'nóse, wa oyeri ocheden-nwa kwẹ, Ẹsau, oben-ẹ bẹ́, “Nnwa kwaam.”</para>
  <para style="p" vid="GEN 27:1">Ẹsau ubhin-ẹ bẹ́, “Aro kwaam, kkeri amma ma e.”<verse eid="GEN 27:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 27:2" />Isaak oben bẹ́, “Amma n'nde ọtạmanạng, ebowu chaam kạ́mbra nsonga. <verse eid="GEN 27:2" /><verse number="3" style="v" sid="GEN 27:3" />Ma wọ, tạkha ẹgbaji-kpo pyọ, py'ede ọkhọhn-pa, ọttạra uyuk kwọ, atima ayin ẹgbaji, ata afhọ nten akken-m. <verse eid="GEN 27:3" /><verse number="4" style="v" sid="GEN 27:4" />Si uchiattọhk f'orebh-orebh f'n'ọdaakh-m, kken-m nchi, ọfha nyọhbh-ọ itta brasẹ mpe.”<verse eid="GEN 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 27:5" />Wa Rẹbẹka n'ọkhọhmọ itọhng ọbhaanga idik s'Isaak n'ọkpaak nnwa kwẹ, Ẹsau. Masẹ Ẹsau kk'ẹgbaji uyina bẹ, ọta ọfhọ nten utima ukwuna o, <verse eid="GEN 27:5" /><verse number="6" style="v" sid="GEN 27:6" />Rẹbẹka n'obeni nnwa kwẹ Jekọb bẹ́, Kker e, mfhu mmaanga s'atte n'oben nnwakka Ẹsau bẹ́, <verse eid="GEN 27:6" /><verse number="7" style="v" sid="GEN 27:7" />Sọhng ata afhọ nten, atima asi uchiattọhk f'orebh-orebh anạng-m nchi, ọfha nyọhbh-ọ itta k'ititikha s'Ubinọkpaabyi, brasẹ mpe.<verse eid="GEN 27:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 27:8" />Rẹbẹka n'obeni Jekọb bẹ́, “Nnwa kwaam, tạkha okpe khọhm-m itọhng, asi oche kw'm'mkpaakh-ọ <verse eid="GEN 27:8" /><verse number="9" style="v" sid="GEN 27:9" />Sọhng ka ibyi s'mvu ining, atekha avu-va akkapẹ mạnna afa s'ijibhi ifor, akken-m, ọfha ntima nsi uchiattọhk f'orebh-orebh, nnạng atte oche kw'n'ọdaakh-ẹ. <verse eid="GEN 27:9" /><verse number="10" style="v" sid="GEN 27:10" />Ọma m'atạkha pfẹ akkena atte uchi, ọfha ọyọbh-ọ itta brasẹ ope.”<verse eid="GEN 27:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 27:11" />Jekọb n'obeni ọkka bẹ́, “Jima bẹ, nnwọkka kwaam, Ẹsau omeni iphyạbha s'isaabh-ọsaabh k'ifor, abhaang, amma ifor saam ikwọhng-ọkwọhnga. <verse eid="GEN 27:11" /><verse number="12" style="v" sid="GEN 27:12" />De otte kwaam utwu-m mo o? Okher ma, n'mbọhr-ẹ ọbọhra, bạra osenga ma, ọrakh-m ẹmma, uttu kw'm'ọyọhbh-m itta.”<verse eid="GEN 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 27:13" />Ọkka ọpọhn-ẹ bẹ́, “Tte ẹmma ch'atte m'ọraakh-ọ ẹvạkha amma oyeni. Si oche kw'mben-ọ bẹ, asi; sọhng ata atạkha mvu s'ntọhm-ọ, kken-m.”<verse eid="GEN 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 27:14" />Ma wọ, ofon ọta ọtạkha mvu okkena ọkka. Ọkka utima sẹ usi uchiattọhk f'orebh-orebh oche kw'n'ọdaak otte. <verse eid="GEN 27:14" /><verse number="15" style="v" sid="GEN 27:15" />Rẹbẹka ọtạk ẹnya ch'ijibhi ọtạm ch'ocheden-nwa kwẹ, kw'ode Ẹsau, oge Jekọb kw'ode okponga-nnạm-nwa kwẹ. <verse eid="GEN 27:15" /><verse number="16" style="v" sid="GEN 27:16" />Ọbạra ọtạkha ẹtwạnọ ch'ivu ububh-ẹ k'mbọhk, ọttạra k'ukhubha gwạnọ k'ẹdwạngọ chẹ, kw'nạn iphyạbha ọkhaam <verse eid="GEN 27:16" /><verse number="17" style="v" sid="GEN 27:17" />Ma wọ, n'ọtạk uchiattọhk rebhada mvọ ọttạra k'brẹd kw'kk'usia, ọnạng nnwa kwẹ Jekọb.<verse eid="GEN 27:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 27:18" />Ma wọ, Jekọb ọtạk okkena otte, oben bẹ́, “Attitte kwaam.”</para>
  <para style="p" vid="GEN 27:18">Otte ubhina bẹ́, “Oo! Nnwa kwaam, ọma anẹ wọ?”<verse eid="GEN 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 27:19" />Jekọb ọpọhn-ẹ bẹ́, “Amma ocheden-nwa kwọ, Ẹsau wọ e, kk'nsia oche kw'aben-m bẹ, nsi e. Totokhạn, bina ninga ẹyạr achi ọttọhk, ọfha ayọhbh-m itta sọ ttạng e.”<verse eid="GEN 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 27:20" />Isaak ọbạbh nnwa kwẹ bẹ́, “Nnwa kwaam, asong bẹ, kk'eten ẹbhạr-ẹbhạrẹ asia o?”</para>
  <para style="p" vid="GEN 27:20">Jekọb ọpọhn-ẹ bẹ́, “Ọvaar Ubinọkpaabyi, kw'ode Ubinọkpaabyi kwọ wọ ọnạng-m uwujibh e.”<verse eid="GEN 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 27:21" />Ma wọ, Isaak obeni Jekọb bẹ́, “Twạkhọ gbaar-m ntwu-ọ ọbọhk, ọfha nsonga k'udik ọkka de ode ọma nnwa kwaam, Ẹsau wọ.”<verse eid="GEN 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 27:22" />Ma wọ, Jekọb ọtwạkhọ ọgbaara otte Isaak, utwu-ẹ, oben bẹ́, “Ọkpaakhadik okher kw'Jekọb, mbọhk ikhenka ikhera s'Ẹsau.” <verse eid="GEN 27:22" /><verse number="23" style="v" sid="GEN 27:23" />Wa Isaak, Jekọb nútina, ukwuru bẹ, wa mbọhk sẹ ide iphyạbha-iphyạbha masẹ nnwọkka, Ẹsau. Osenga ma, Isaak ọyọhbh-ẹ itta. <verse eid="GEN 27:23" /><verse number="24" style="v" sid="GEN 27:24" />N'ọbạra ọbạbh-ẹ bẹ́, “Ọma nnwa kwaam Ẹsau wọ k'udik ọkka o?”</para>
  <para style="p" vid="GEN 27:24">Jekọb ubhin-ẹ bẹ́, “Uwee, attitte, amma wọ e.”<verse eid="GEN 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 27:25" />Ma wọ, n'obeni bẹ́, “Nnwa kwaam, kken-m uchiattọhk pfọ nchi, ọfha nyọhbh-ọ itta.”</para>
  <para style="p" vid="GEN 27:25">Jekọb okken-ẹ uchiattọhk uchi, ọbạra ọnạng-ẹ atwuk, ogwo.<verse eid="GEN 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 27:26" />Ma wọ, Isaak oben-ẹ bẹ́, “Nnwa kwaam, kwu baakh-m.”<verse eid="GEN 27:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 27:27" />Ma wọ, Jekọb ọtwạkhọ ọgbaara otte, ọbaakh-ẹ. Masẹ Isaak ọbhaang iruk ch'ekpo py'oge k'ifor o, ma wọ, n'ocher bẹ, Ẹsau wọ, osenga ma, ọyọhbh-ẹ itta, oben bẹ́,</para>
  <para style="q1" vid="GEN 27:27">“K'udik ọkka, iruk ch'nnwa kwaam</para>
  <para style="q2" vid="GEN 27:27">ede masẹ iruk ch'owonu,</para>
  <para style="q2" vid="GEN 27:27">kw'Ọvaar Ubinọkpaabyi kk'udia.<verse eid="GEN 27:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="GEN 27:28" />Tte Ubinọkpaabyi usi ọrạngkpang otebh</para>
  <para style="q2" vid="GEN 27:28">k'agwu p'antubhu,</para>
  <para style="q2" vid="GEN 27:28">tte ọnạng-ọ uchiattọhk ọttạra atwuk abhapẹ k'ọsaabh.<verse eid="GEN 27:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="GEN 27:29" />Tte idifhon phyibh ikpobh-ọ,</para>
  <para style="q2" vid="GEN 27:29">tte anạng phyibh asạkha echo anạng-ọ.</para>
  <para style="q1" vid="GEN 27:29">Ọma m'ade ọvaarnạng kw'ivakka pọ,</para>
  <para style="q2" vid="GEN 27:29">tte ichimma chọ ẹsạkha echo ẹnạng-ọ.</para>
  <para style="q1" vid="GEN 27:29">Tte ẹmma ẹbhạkhẹ ẹvạkha anạng p'm'araakh-ọ ẹmma,</para>
  <para style="q2" vid="GEN 27:29">tte idia ẹbạra iyima ẹnạng anạng p'm'adi-ọ.”<verse eid="GEN 27:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 27:30" />Masẹ Isaak kk'Jekọb ita ọyọbha phyibh o, Jekọb ubina ofona. Ubin k'otte k'ititikha <char style="it">bẹẹ</char>, nnwọkka Ẹsau ukwuna ẹgbaji. <verse eid="GEN 27:30" /><verse number="31" style="v" sid="GEN 27:31" />Wa, Ẹsauọbạra usi uchiattọhk f'orebh-orebh, ọtạkha okkena otte, oben-ẹ bẹ́, “Attitte, totokhạn, bina chi ọttọhk, ọfha ayọhbh-m itta ttạng.”<verse eid="GEN 27:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 27:32" />Otte Isaak n'ọbạbh-ẹ bẹ́, “Ọma anẹ wọ o?”</para>
  <para style="p" vid="GEN 27:32">Ẹsau ubhin-ẹ bẹ́, “Amma ocheden-nwa kwọ, Ẹsau ttạng asạng.”<verse eid="GEN 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 27:33" />Isaak ọfhạnọ <char style="it">bẹ tikhitikhitikhi</char>, oben bẹ́, “Anẹ wọ wạra n'uyini ẹgbaji ọwọhn uchiattọhk okken-m o? Napra nchi pfẹ ma, mbạra nyọhbh-ẹ ikpongannạm-ta, brasẹ n'akwu ma. Afhạra khọ mạ́nsi, m'ọkhankẹ ujibh-ẹ-ujibh!”<verse eid="GEN 27:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 27:34" />Masẹ Ẹsau ọbhaang idik s'otte ọkpaakhẹ, orengi ijunung-mạng ọgạma k'ẹrạng-k'ẹrạng, idwạdwạkhọ asẹ kha ettem, oben otte kwẹ bẹ́, “Attitte kwaam, yọhbh-m itta, totokhạn, gba yọhbh amma itta!”<verse eid="GEN 27:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 27:35" />Okhenka, otte ọpọhn-ẹ bẹ́, “Nnwakka kk'ukwua, ukwu ọbọhr-m, ọtạkha itta sọ.”<verse eid="GEN 27:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 27:36" />Ẹsau n'oben-ẹ bẹ́, “Ọbaan-ọbaana s'akpẹ-ẹ Jekọb. N'ode ikpe mạnna ifa s'kk'aam ọbọhra. K'ochedenkpe, ọtạk edennạng chaam ch'ocheden-nwa, mantọmma, kk'adạkhẹ itta saam ọbạra ọtạkha!” Ma wọ, Ẹsau n'ọbạbhọ otte bẹ́, “N'ode bẹ, khaam itta rạnẹ-rạnẹ nárikha o?”<verse eid="GEN 27:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 27:37" />Isaak ubhin Ẹsau bẹ́, “Amma kk'ẹ ita nyọhbha bẹ, idifhon phyibh ọttạra anạng pẹ phyibh, m'aninga isekhisek kwẹ, mbạra ndi-ẹ oseng k'uchiattọhk ọttạra atwuk k'ọsaabh. Nnwa kwaam, bạng udik ọdwạkh-ọdwạk gwọ akkẹ bẹ, m'nsi nnạng-ọ?”<verse eid="GEN 27:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 27:38" />Ẹsau ọbạbh otte bẹ́, “Attitte kwaam, n'ode bẹ, itta rạnẹ mạnkkeni rọ s'akhaam o? Attitte kwaam, gba yọhbh-m itta khadẹ o!” Ẹsau orengi ijunungmạng ọgạma k'ẹrạng-k'ẹrạng.<verse eid="GEN 27:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="GEN 27:39" />Isaak o, n'ubhin-ẹ bẹ́,</para>
  <para style="q1" vid="GEN 27:39">“Kker e, ibyirukhasẹ sọ, k'isisek</para>
  <para style="q2" vid="GEN 27:39">s'n'ijibh ekpo mífora,</para>
  <para style="q2" vid="GEN 27:39">k'ibyi s'ọrạngkpaang n'otebh mífora.<verse eid="GEN 27:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="GEN 27:40" />Ọma m'aruk k'ekpong k'ekpong,</para>
  <para style="q2" vid="GEN 27:40">m'abạra aninga k'isekhisek kw'nnwakka.</para>
  <para style="q1" vid="GEN 27:40">Okhenka, m'atima ọmmakkarẹ aruk akpen,</para>
  <para style="q2" vid="GEN 27:40">ẹmma nja kọ mẹ́vạkha,</para>
  <para style="q2" vid="GEN 27:40">k'isekhisek kw'nwakka máruk.”<verse eid="GEN 27:40" /></para>
  <para style="s1">Jekọb ọrạbhọ otor Laban</para>
  <para style="p">
    <verse number="41" style="v" sid="GEN 27:41" />Ẹsau ọkhaam iwawuna k'ettem, ukwuru itta s'otte kk'Jekọb ọyọhbha. N'obeni ẹma oyeni bẹ́, “Ebowu ch'otte kwaam nạnka efora, de kk'upua, ansi-ẹ obo, amma m'nfhọ nnwọkka kwaam, Jekọb.”<verse eid="GEN 27:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="GEN 27:42" />Masẹ Rẹbẹka ọbhaang udik kw'Ẹsau n'ọkhạmọ otena Jekọb, oyeri Jekọb ọkpaakh-ẹ bẹ́, “Kker e, nnwakka Ẹsau ọkhaam ẹkka-pyibha otena abọ, abẹ, m'ọfhọ-ọ. <verse eid="GEN 27:42" /><verse number="43" style="v" sid="GEN 27:43" />Nnwa kwaam, khọhm-m itọhng, okpe kákhibhi, si oche kw'mkpaakh-ọ, m'ado ifor ẹbhạr-ẹbhạrẹ arạbh afona k'nnwọkka kwaam, Laban, kw'urukhu k'Haran. <verse eid="GEN 27:43" /><verse number="44" style="v" sid="GEN 27:44" />Ninga abẹ ma tạrr ettem idiri nnwakka. <verse eid="GEN 27:44" /><verse number="45" style="v" sid="GEN 27:45" />Okpe kw'kwạna nnwakka kk'udik kw'asi-ẹ obona, idwạdwạkhọ ibạra isẹ-ẹ k'ettem, ma wọ, m'ntọhm ẹkkaabha nnạng-ọ akwuna. Ukwuru yạn kw'abạngama anạng afa m'adim-m k'iwu jạnẹ ọ?”<verse eid="GEN 27:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="GEN 27:46" />Ma wọ, Rẹbẹka ọkpaak Isaak bẹ́, “Amma akpen kk'aam ebenga, ukwuru ipanạng mba p'abin Het. De Jekọb ọbạra ọtạkha ikwanạng k'anạng p'Het, amma kk'mpua e.”<verse eid="GEN 27:46" /></para>
  <chapter eid="GEN 27" />
  <chapter number="28" style="c" sid="GEN 28" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 28:1" />Ma wọ, Isaak oyeri Jekọb ọyọbh-ẹ itta, ọbạra ọtwạr-ẹ itọhng, oben-ẹ bẹ́, “Ikwanạng wạnọ-wạnọ kw'ubin k'ẹkhạma ch'Kenaan kátạkha o. <verse eid="GEN 28:1" /><verse number="2" style="v" sid="GEN 28:2" />Sọhng k'Padan-Aram ata atạkha ikwanạng k'ichimma ch'Bẹtuẹl, kw'ode otte kw'akka, k'ikhaana s'aminava p'nnwọkka kw'akka, kw'ode Laban. <verse eid="GEN 28:2" /><verse number="3" style="v" sid="GEN 28:3" />Tte Ubinọkpaabyi kw'Ẹfa phyibh udi-ọ, ọbạra ọttr-ọ iva k'ọsaabh, ọbạra usi iva p'iva pọ asaabh tạrr abẹ asi nkhạma s'isaabh-ọsaabh. <verse eid="GEN 28:3" /><verse number="4" style="v" sid="GEN 28:4" />Tte ọnạng ọma ọttạra iva pọ idia ch'uwa ọnạngẹ Abraham, ọfha asenga ma atạkha okhebh ma isisek nna s'arukhu ma masẹ ukhikhennạng, isisek s'Ubinọkpaabyi ọnạngẹ Abraham.” <verse eid="GEN 28:4" /><verse number="5" style="v" sid="GEN 28:5" />Ma wọ, Isaak ọtọhmọ Jekọb, ofona k'Padan-Aram, ọta okhebha Laban kw'ode nnwa kw'Bẹtuẹl, kw'ubin Aram, kw'ọbạra ode nnwọkka kw'Rẹbẹka, kw'ode ọkka kw'Jekọb ọttạra Ẹsau.<verse eid="GEN 28:5" /></para>
  <para style="s">Ẹsau ọtạk ikwanạng ọdwạkh-ọdwạk</para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 28:6" />Masẹ Ẹsau osong bẹ, otte kwabẹ, Isaak, kk'Jekọb itta ọyọhbha, ọbạra ọtọhm-ẹ bẹ, ọsọhng k'Padan-Aram ọta ọtạkha ikwanạng kạkha, ọbạra ọtwạr-ẹ itọhng bẹ́, “Ikwanạng kw'ubin Kenaan kátạkha o,” <verse eid="GEN 28:6" /><verse number="7" style="v" sid="GEN 28:7" />ọbạra osonga bẹ́, Jekọb kk'idik s'otte ọttạra s'ọkka ọbhaanga, ofona k'Padan-Aram. <verse eid="GEN 28:7" /><verse number="8" style="v" sid="GEN 28:8" />Wa Ẹsau n'utini bẹ, ipanạng p'Kenaan abẹ otte Isaak idik kádakhẹ; <verse eid="GEN 28:8" /><verse number="9" style="v" sid="GEN 28:9" />ma wọ, Ẹsau n'ubin ofona k'Ishimayẹl, ọta ọtạkha ikwanạng ọdwạkh-ọdwạk kw'okpen Mahalat, kw'ode nnwọkka kw'ikwanạng kw'Nẹbayọt, kw'ọbạra ode nnwa kw'Ishimayẹl, kw'ode nnwa kw'Abraham.<verse eid="GEN 28:9" /></para>
  <para style="s1">Jekọb ọttaar idachen k'Bẹtẹl</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 28:10" />Jekọb ubin k'Beershẹba ofona k'Haran. <verse eid="GEN 28:10" /><verse number="11" style="v" sid="GEN 28:11" />Ukwu ukpira k'ibyi rạnẹ, ọtạkha ẹta mạma, ochok, uyima ọnạna echo, ọttaabha, s'iwu kk'ipyia. <verse eid="GEN 28:11" /><verse number="12" style="v" sid="GEN 28:12" />Ukwu ọttaara idachen s'ose s'ọkpantạma ọtạm k'isisek udum tạrr ukpira k'ọrạngkpakpa, ọbạra ose s'atọhmọ p'Ubinọkpaabyi n'asenga ma ọkpantạma nwọ avura, abạra asenga ma asạkha. <verse eid="GEN 28:12" /><verse number="13" style="v" sid="GEN 28:13" />Ọbạra ose s'Ọvaar Ubinọkpaabyi obe k'ẹrạng-ẹrạng kw'ọkpantạma nwọ oben bẹ́, “Amma wọ nde Ubinọkpaabyi kw'ab'atte, Abraham ọttạra Isaak akpobh. Amma m'nnạng ọma ọttạra iva p'iva pọ isisek nna s'ayim ma. <verse eid="GEN 28:13" /><verse number="14" style="v" sid="GEN 28:14" />Iva p'iva pọ m'asaabh masẹ uyiyeng, abẹ abạra anyaamẹ k'ibyi sidede, k'ibyi s'ophye n'uyin, ọttạra k'ibyi s'ophye n'udimi, ọttạra ọttạra ibir-ibira, ọttạra k'ẹrạkh-ẹrạkha. Iyagbin phyibh m'isenga ma akhọ, ọttạra iva p'iva pọ itạkha idia. <verse eid="GEN 28:14" /><verse number="15" style="v" sid="GEN 28:15" />Amma m'nninga abọ, mbạra nkker-ọ k'ibyi sidede s'm'afona, mbạra ntima abọ mkpa nnạm ma isek nna. Amma kọ ọbọhk mạ́ntte tạrr nnạng ẹyaakha ma udik ngwa kw'kk'nchekha nnạng-ọ.”<verse eid="GEN 28:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 28:16" />Masẹ Jekọb ọphyạb ọda, oben bẹ́, “K'udik ọkka, Ọvaar Ubinọkpaabyi uning ma ibyi nna, amma wạra kạ́nsong.” <verse eid="GEN 28:16" /><verse number="17" style="v" sid="GEN 28:17" />Wa ojor-ẹ, ukwu oben bẹ́, “Asong bẹ, ibyi nna kk'ijora o! Ibyi nna ibyi idwạkh-ọdwạk míde, iyongu ọchọhm kw'Ubinọkpaabyi; maa wọ ode ẹbaakhamma ch'Ọvaarfhon kw'Ubinọkpaabyi.”<verse eid="GEN 28:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 28:18" />K'ekpekpebha, Jekọb udira ẹta njọ ch'wạra uyim ọnạna echo, offo chẹ obe masẹ ntumu, ọtạkha ana obyenga chẹ k'erạng. <verse eid="GEN 28:18" /><verse number="19" style="v" sid="GEN 28:19" />Ibyi nnọ wa icheden ikpena Luz, bạra Jekọb n'oyeri efhon-diden njọ Bẹtẹl.<verse eid="GEN 28:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 28:20" />Ma wọ, Jekọb ọtạk echekha k'ititikha s'Ubinọkpaabyi, ọbẹ́, “Ma osenga ngwa kw'm'nta ma, de Ubinọkpaabyi uning abamẹ, okker-m, ọnạng-m uchiattọhk f'm'nchi, ọttạra ekpo igiapẹ, <verse eid="GEN 28:20" /><verse number="21" style="v" sid="GEN 28:21" />tạrr kwạna nsenga nkwuna k'otte kwaam k'ọchọhm k'idira, Ọvaar Ubinọkpaabyi wọ m'ode Ubinọkpaabyi kw'm'mkpobha. <verse eid="GEN 28:21" /><verse number="22" style="v" sid="GEN 28:22" />Ma wọ, ẹta nja ch'kk'mffua masẹ ntumu, m'ede ọchọhm kw'Ubinọkpaabyi. Fidede f'anạng-m, m'nnạng-ọ ọttọhk vạnọ k'ekpo jobh.”<verse eid="GEN 28:22" /></para>
  <chapter eid="GEN 28" />
  <chapter number="29" style="c" sid="GEN 29" />
  <para style="s1">Jekọb ukpir k'Padan Aram</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 29:1" />Wa Jekọb ofon ororo k'osenga kwẹ, tạrr ukpira k'anạng p'arukhu k'ukhubha kw'ududon n'uyin. <verse eid="GEN 29:1" /><verse number="2" style="v" sid="GEN 29:2" />Ma wọ ose isipe ch'abẹ atim ẹtakpa ch'ẹbạrẹ ẹkpa abubha, ọbạra ose ikhaana ittaan s'arạkhạmaan, p'ayim ma isipe njọ ọkhaan-ọkhaan, ch'abẹ akhaabh asi anạng bẹ.<verse eid="GEN 29:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 29:3" />K'okpe kwidede kw'akkeri-arạkhạmaan m'anạng arạkhạmaan pabẹ asi, abẹ m'abingi ẹtakpa njọ ch'ibubh ma ammakpa p'isipe achok ọkhaan-ọkhaan, akhaabha asi anạng arạkhạmaan, brasẹ abẹ n'abingi adạkhẹ chẹ abubha.<verse eid="GEN 29:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 29:4" />Jekọb ọbạbh akkeri-arạkhạmaan mbọ bẹ́, “Aye, abạnga abin mạn?”</para>
  <para style="p" vid="GEN 29:4">Abẹ abhina bẹ́, “Amạna ambin Haran.”<verse eid="GEN 29:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 29:5" />Ọbạra ọbạbh bẹ bẹ́, “Abạnga asong ujunung kw'abẹ ayeri Laban ma, kw'Nahọr ofhonu?”</para>
  <para style="p" vid="GEN 29:5">Abẹ abhina bẹ́, “Uwee, ansong-ẹ mạma.”<verse eid="GEN 29:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 29:6" />Ma wọ, Jekọb n'ọbạbhọ bẹ bẹ́, “Ma, usi-ẹ yạn yeri?”</para>
  <para style="p" vid="GEN 29:6">Abẹ abhin-ẹ bẹ, “K'udik ọkka, ifor ikpọhkh-ẹ kạkha e. Kkeri uminanwa kwẹ kw'okpen Rachẹl, oche n'ukwu kha arạkhạmaan apyẹ.”<verse eid="GEN 29:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 29:7" />Ma wọ, Jekọb n'obeni akkeri-arạkhạmaan mbọ bẹ́, “Amma nkkẹ bẹ, s'utim ode ọyakpattem, okpe sạng ma kw'wạra abạnga m'atima arạkhạmaan mbọ akwu akwokha ọyọhng ma ibyi nna. Atera anạng bẹ asi, ọfha abạnga atima pyẹ akpa nnạm, ata anạng uchiattọhk.”<verse eid="GEN 29:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 29:8" />Ma wọ, akkeri-arạkhạmaan mbọ, abhin Jekọb bẹ́, “Mesese o, amạnamba oche ngwọ kạnánsi, m'antik akkeri-arạkhạmaan adwạkh-ọdwạk, brasẹ n'ambingi ẹtakpa ch'ibubh isipe, ma wọ, n'abạra annạng arạkhạmaan pamạna asi okpe gwạnọ.”<verse eid="GEN 29:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 29:9" />Masẹ Jekọb utim ọkpaakhẹ udik ọttạra akkeri-arạkhạmaan mbọ, Rachẹl utima arạkhạmaan p'otte ukpira ma isipe njọ. Ẹma Rachẹl wa ode okkeri-arạkhạmaan k'ẹpanạng. <verse eid="GEN 29:9" /><verse number="10" style="v" sid="GEN 29:10" />Rachẹl wa ọbạra ode ocheden-nwa kw'Laban. Laban nwọ, waọbạra ode nnwọkka kw'ọkka kw'Jekọb. Ma wọ, masẹ Jekọb ose Rachẹl, ọttạra arạkhạmaan p'otte p'utim bẹ, ukwu ọnạng asi, ọta ubingi ẹtakpa ch'ibubh k'isipe, ọkhaabha asi ọnạng arạkhạmaan p'nnwọkka kw'ọkka. <verse eid="GEN 29:10" /><verse number="11" style="v" sid="GEN 29:11" />Ma o, Jekọb ọta ọbaakha Rachẹl, ọbạra ọgạma k'ẹrạng-k'ẹrạng. <verse eid="GEN 29:11" /><verse number="12" style="v" sid="GEN 29:12" />N'ode s'uwa Jekọb kk'Rachẹl ọkpaakha bẹ, ẹma ode uchimmanạng kw'otte Laban, ọbạra ode ujunungnwa kw'Rẹbẹka. Ma wọ, Rachẹl ọrạbhọ ọta ọkpaak otte.<verse eid="GEN 29:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 29:13" />Masẹ Laban ọbhaang idik nnọ s'iten k'Jekọb, kw'ode nnwa kw'nnwọkka kwẹ, ubina ẹbhạr-ẹbhạr ọta okhebh-ẹ kha eden. Masẹ abẹ ase ayok o, Laban ọbaakh-ẹ, ọbạra utim-ẹ ofona kakhẹ ọchọhm. K'ọchọhm wọ wa Jekọb n'ọkpaakhẹ Laban idik phyi-phyibh s'kk'ittia. <verse eid="GEN 29:13" /><verse number="14" style="v" sid="GEN 29:14" />Ma wọ, Laban ọpọhn-ẹ bẹ́, “K'udik ọkka, ọma ade uchimmanạng kwaam, ande anạng bạnọ e.”</para>
  <para style="s1" vid="GEN 29:14">Jekọb ọtạk Lea ọttạra Rachẹl k'ọbada</para>
  <para style="p" vid="GEN 29:14">Ma o, masẹ Jekọb kk'ophye wạnọ ukkia k'ọchọhm kw'Laban, <verse eid="GEN 29:14" /><verse number="15" style="v" sid="GEN 29:15" />Laban n'oben-ẹ bẹ́, “Ọbạra ọkwọn ode bẹ́, amma ọttạra ọma ande anạng bạnọ, akwẹma sạng m'usi ọma n'asi ọtọhm anạng-m k'ajakha. Kpaakh-m ọtọhk f'm'n'atạkha k'ọtọhm pfọ.”<verse eid="GEN 29:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 29:16" />Wa Laban ọkhaam apanạngva afa, ocheden okpen Lea, ottong afa, okpena Rachẹl. <verse eid="GEN 29:16" /><verse number="17" style="v" sid="GEN 29:17" />Lea, ẹma wa ọkhaam adạdaakha-chen, p'apọhkh-ọpọhkha, okhenka, Rachẹl ẹma ode ifor bẹ, bhạkhẹ-bhạkhẹ, iminava achẹ. <verse eid="GEN 29:17" /><verse number="18" style="v" sid="GEN 29:18" />Wa Jekọb ọkhaam idạdaakha Rachẹl abẹ, oben bẹ́, “Amma m'nsi ọtọhm nnạng-ọ k'icho isenọfa k'echo ch'Rachẹl, kw'ode uminanwa kwọ kwisạsạkhẹ.”<verse eid="GEN 29:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 29:19" />Ma wọ, Laban obeni bẹ́, “Ode udik kw'ujibh-ujibh bẹ, ntạkh-ẹ nnạng ọma, ọyọhnga bẹ, ntạkh-ẹ nnạng ọnạng ọdwạkh-ọdwạk. Ninga abam maa.” <verse eid="GEN 29:19" /><verse number="20" style="v" sid="GEN 29:20" />Ma wọ, wa Jekọb usi ọtọhm k'icho isenọfa k'echo ch'Rachẹl, okhenka, ukwuru idạdaakha s'Jekọb ọkhaam Rachẹl abẹ, wa icho nnọ isenọfa ikher-ẹ iwu iphyang-iphyang.<verse eid="GEN 29:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 29:21" />Wa Jekọb ukwu oben Laban bẹ́, “Icho s'ọtọhm saam kk'igba, nạng-m ikwanạng kwaam ọfha nyima abẹ.”<verse eid="GEN 29:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 29:22" />Ma o, Laban obher anạng p'ibyi nnọ phyibh, abẹ atobha, abẹ asi erobha ch'ọbada. <verse eid="GEN 29:22" /><verse number="23" style="v" sid="GEN 29:23" />Okhenka, masẹ n'ukpir k'irungu, Laban ọtạkha nnwa kwẹ, Lea, ọnạng Jekọb. Jekọb uyima abẹ. <verse eid="GEN 29:23" /><verse number="24" style="v" sid="GEN 29:24" />Wa Laban ọtạk ọtọhmnạng kwẹ, Zilpa, ọnạng nnwa kwẹ Lea, bẹ uruk abẹ.<verse eid="GEN 29:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 29:25" />Masẹ iwu n'echobh o, Jekọb n'ose bẹ, otera uyima Lea abẹ. Ma wọ, obeni Laban bẹ́, “Bạng udik khira gwọ asi-m ma? Rachẹl sạng kw'nseng abẹ nsi ọtọhm nnạng-ọ? Ọma n'asi yạn abọhr-m?”<verse eid="GEN 29:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 29:26" />Ma wọ, Laban ubhi bẹ́, “K'ẹmmaana chamạna, nọ́baana bẹ, ọnạng ọtạkha ọkwanạng-nwa kwẹ kw'isạsạkhẹ ọnạng k'ọbada, s'oyok kwididen nạn udim tạm nọ́ba. <verse eid="GEN 29:26" /><verse number="27" style="v" sid="GEN 29:27" />Kera ẹphyawu ch'erobha ch'ọbada ngwa, de kk'akkera, m'annạng-ọ dạkhẹ oyok kw'isạsạkhẹ. Okhemma, bạra asi-m adạkhẹ ọtọhm k'icho isenọfa idwạkh-ọdwạk.”<verse eid="GEN 29:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 29:28" />Wa Jekọb ocher ọnạng-ẹ. Masẹ kk'ẹphyawu ch'erobha okkera ọttạra Lea, Labanọbạra ọtạkha nnwa kwẹ Rachẹl, ọnạng-ẹ k'ọbada. <verse eid="GEN 29:28" /><verse number="29" style="v" sid="GEN 29:29" />Wa Laban ọtạk ọtọhmnạng kwẹ kw'ikwanạng, kw'okpen Bilha, ọnạng Rachẹl bẹ, uruk abẹ. <verse eid="GEN 29:29" /><verse number="30" style="v" sid="GEN 29:30" />Jekọb ọbạra uyima Rachẹl abẹ. Wa Rachẹl n'ọdaakh-ẹ ọtạm ọyọnga Lea. Ma wọ, usi ọtọhm k'icho isenọfa idwạkh-ọdwạk ọnạng Laban.<verse eid="GEN 29:30" /></para>
  <para style="s1">Oche kw'iva p'Jekọb</para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 29:31" />Masẹ wa Ọvaar Ubinọkpaabyi ose bẹ, Rachẹl ọdaakhẹ Jekọb ọtạm ọyọhnga Lea, ọnạng Lea ọmaan, okhenka, Rachẹl ode ujidim. <verse eid="GEN 29:31" /><verse number="32" style="v" sid="GEN 29:32" />Wa Lea ukwu utima ifhạr, ọmaan ujunungnwa, ukpuẹ-ẹ Reubẹn, oben bẹ́, “Ọvaar Ubinọkpaabyi kk'ikwosi saam usia. K'udik ọkka, napra wọ m'ndaakhẹ udim kwaam e.”<verse eid="GEN 29:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 29:33" />Lea ọbạra utima ifhạr ọmaan ujunungnwa, ukwu oben bẹ́ “Ukwuru s'Ọvaar Ubinọkpaabyi ọbhaang bẹ, amma udim kwaam nạ́ndaakha, khaam adạkhẹ nnwa ọnạnga.” Ma wọ, ukpuẹ-ẹ Simeọn.<verse eid="GEN 29:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 29:34" />Leaọbạra utima ifhạr ọmaan ujunungnwa, ọbẹ́, “Iyaa, ẹkpanja udik kwaam bạra n'ọmyẹ-m k'ifor, s'kkẹ ajunungva attaan mmaana.” Ma wọ, ukpuẹ-ẹ Lẹvi.<verse eid="GEN 29:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 29:35" />Lea utima adạkhẹ ifhạr ọmaan ujunungnwa, ukwu oben bẹ́, “Ẹkpanja, m'ntọhnga Ọvaar Ubinọkpaabyi.” Ma wọ, ukpuẹ-ẹ Juda. Ukwu ukuma ọmaan.<verse eid="GEN 29:35" /></para>
  <chapter eid="GEN 29" />
  <chapter number="30" style="c" sid="GEN 30" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 30:1" />Masẹ Rachẹl n'ose bẹ, ifhạr ikhaar-ẹ-ọkhaarẹ, n'utim otor nnwọkka Lea. Ma wọ n'obeni Jekọb bẹ́, “Nạng-m iva o, deja, m'mpope e!”<verse eid="GEN 30:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 30:2" />Ma wọ, Jekọb ọdwạkhẹ Rachẹl abẹ, ọbạbh-ẹ bẹ́, “Amma wọ nde Ubinọkpaabyi kw'usi-ọ bẹ́, nạngẹ iva amaanẹ o?”<verse eid="GEN 30:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 30:3" />Rachẹl ọbẹ́, “N'ode mạnna, Kkeri Bilha, kw'ode ọtọhmnạng kwaam maa. Yima abẹ, ọfha ọmaan-m iva, ọfha nsenga ma akhẹ ntạma ichimma chaam.”<verse eid="GEN 30:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 30:4" />Ma wọ, ọtạk ọtọhmnạng kwẹ Bilha, ọnạng Jekọb masẹ ukwanạng kwẹ. Jekọb uyima abẹ, <verse eid="GEN 30:4" /><verse number="5" style="v" sid="GEN 30:5" />Bilha ukwu utima ifhạr ọmaan ujunungnwa ọnạng Jekọb. <verse eid="GEN 30:5" /><verse number="6" style="v" sid="GEN 30:6" />Ma wọ Rachẹl okpe nnwa nwọ Dan, ọbẹ́, “Ubinọkpaabyi kk'iponga saam ubua, ọbạra ọbhaanga njọhm saam, ọnạng-m ujunungnwa.”<verse eid="GEN 30:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 30:7" />Ma wọ Bilha kw'ode ọtọhmnạng kw'Rachẹl ọbạra utima ifhạr ọmaan Jekọb ujunungnwa kw'ottong afa. <verse eid="GEN 30:7" /><verse number="8" style="v" sid="GEN 30:8" />Rachẹl oben bẹ́, “Amma kk'irima ch'ẹfa nsia ọttạra nnwọkka kwaam Lea, mbạra nkhem-ẹ.” Osenga ma, ukpuẹ-ẹ Naphtali.<verse eid="GEN 30:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 30:9" />Masẹ Lea ose bẹ́, kk'ọmaan ukuma, n'ọtạk ọtọhmnạng kwẹ, Zilpa ọnạng Jekọb masẹ ikwanạng kwẹ. <verse eid="GEN 30:9" /><verse number="10" style="v" sid="GEN 30:10" />Zilpa ọmaan Jekọb ujunungnwa. <verse eid="GEN 30:10" /><verse number="11" style="v" sid="GEN 30:11" />Ma wọ Lea obeni bẹ́, “Maa wọ ọkhaankẹ ode ujibhaada e!” Okpe nnwa nwọ Gad.<verse eid="GEN 30:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 30:12" />Wa Zilpa kw'ode ọtọhmnạng kw'Lea, ọmaan Jekọb ujunungnwa kw'ottong afa. <verse eid="GEN 30:12" /><verse number="13" style="v" sid="GEN 30:13" />Ma wọ, Lea okpe nnwa nwọ Asha, oben bẹ́, “Ettem erebhạm o, s'ayok ipanạng n'abạra n'ayer-m ottennebh.”<verse eid="GEN 30:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 30:14" />K'okpe kw'iphya s'wit, Reubẹn uyini kha owonu, ọta ose asiseni-kwongu p'abẹ ayeri mandrek<note caller="+" style="f"><char style="fr" closed="false">30.14 </char><char style="ft" closed="false">Mandrek ode ikwongu-tọhng s'ikwanạng kw'ode ujidim m'uchi utima ifhạr.</char></note>, utima okkena ọkka kwẹ, Lea. Ma wọ, Rachẹl obeni Lea bẹ́, “Totokhạn, mekh-m asiseni-kwongu bạnọ p'nnwa kwọ utim ukwuna.”<verse eid="GEN 30:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 30:15" />Okhenka, Lea obeni Rachẹl bẹ́, “Udim kwaam kw'kk'aam avạkha ana, khọ nóbenga a? N'abạra atạkha asiseni-kwongu p'nnwa kwaam attạra o?”</para>
  <para style="p" vid="GEN 30:15">Rachẹl oben bẹ́, “Ọbaan ma, de ammekh-m asiseni-kwongu p'nnwa kwọ, ma wọ m'nchera atạkha iyimawu ch'chemma.”<verse eid="GEN 30:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 30:16" />Osenga ma, masẹ Jekọb ukwun iyina k'ẹchọhkha, Lea ọta okhebh-ẹ, ọkpaakh-ẹ bẹ́, “Chemma n'ode iyimawu chaam e, ukwuru bẹ́, kk'asiseni-kwongu p'nnwa kwaam ntima ndebh chẹ.” Ma wọ Jekọb uyim Lea abẹ ma irungu njọ.<verse eid="GEN 30:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 30:17" />Ubinọkpaabyi ọbhaanga njọhm s'Lea, ukwu utima ifhạr, ọmaan Jekọb ujunungnwa kw'ottong asen. <verse eid="GEN 30:17" /><verse number="18" style="v" sid="GEN 30:18" />Lea oben bẹ́, “Ubinọkpaabyi kk'aam ọtaama, ukwuru s'nnạngẹ udim kwaam ọtọhmnạng kwaam, uyima abẹ.” Ma wọ, okpe nnwa nwọ Isaka.<verse eid="GEN 30:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 30:19" />Lea ọbạra utima ifhạr ọmaan Jekọb ujunungnwa kw'ottong asajạnẹ. <verse eid="GEN 30:19" /><verse number="20" style="v" sid="GEN 30:20" />Ma wọ Lea obeni bẹ́, “Ubinọkpaabyi kk'aam ẹnạnga chididen ọnạnga. Ẹkpa nja m'mbạr udim kwaam udik, ukwuru bẹ́, kk'ẹ ajunungva asajạnẹ mmaana.” Osenga-ma ukpuẹ-ẹ Zẹbulun.<verse eid="GEN 30:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 30:21" />Ayongu ma, Lea ọbạra ọmaan ikwanạng, ukpẹ-ẹ Daina.<verse eid="GEN 30:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 30:22" />Ma o, Ubinọkpaabyi ukwu ujima Rachẹl, ọbhaanga njọhm sẹ, ọnạng-ẹ ọmaan. <verse eid="GEN 30:22" /><verse number="23" style="v" sid="GEN 30:23" />Rachẹl utima ifhạr ọmaan ujunung, oben bẹ́, “Ubinọkpaabyi kk'aam ọrạbha k'mkpạr.” <verse eid="GEN 30:23" /><verse number="24" style="v" sid="GEN 30:24" />Ukpẹ-ẹ Josẹph, oben bẹ́, “Tte Ọvaar Ubinọkpaabyi ọttạra-m adạkhẹ ujunungnwa.”<verse eid="GEN 30:24" /></para>
  <para style="s1">Ọsaabh f'itirakpo py'Jekọb</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 30:25" />Masẹ Rachẹl kk'Josẹph ọmaana, Jekọb oben Laban bẹ́, “Tte-m ọbọhk mkpa nnạm k'ọmmaana-fhon kwaam. <verse eid="GEN 30:25" /><verse number="26" style="v" sid="GEN 30:26" />Nạng-m ipanạng paam ọttạra iva paam p'kk'bẹ abẹ nsenga nsi ọtọhm nnạng-ọ, ntima mfona. Ọma oyeni asong ọtọhm demapfẹ ma f'kk'nsia nnạng-ọ.”<verse eid="GEN 30:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 30:27" />Okhenka, Laban oben-ẹ bẹ́, “De kk'ọphyaam nkhaama k'akhọ k'ititikha, totokhạn kákpomma afona, khiri kk'ọsẹ mmạra, nsonga bẹ́, Ọvaar Ubinọkpaabyi kk'aam udia ukwuru ọma.” <verse eid="GEN 30:27" /><verse number="28" style="v" sid="GEN 30:28" />Ọbạra oben bẹ́, “Tekh-m ẹphya ch'ọtọhm pfọ ope, khiri m'nnạng-ọ-ọnạng.”<verse eid="GEN 30:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 30:29" />Jekọb ubhin-ẹ bẹ́, “Ọma asong ọtọhm che ma f'kk'nsia nnạng-ọ, abạra ase ukhira kw'ngwạkhọ itirakpo pyọ, ijibh ẹnạng-ọ. <verse eid="GEN 30:29" /><verse number="30" style="v" sid="GEN 30:30" />Brasẹ n'nkwu, itirakpo pyọ nẹ́saabha oche kw'apyẹ n'ẹsaabhẹ mantọmma. Ọvaar Ubinọkpaabyi kk-ọ udia k'ọtọhm fidede f'kk'nsia nnạng-ọ. Okhenka, nọ́baana bẹ́, abạra atte-m ọbọhk nta nnor f'ẹchọhmfhạr chaam m'ẹbạra itima iruk akpen o?”<verse eid="GEN 30:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 30:31" />Laban ọbạbh-ẹ bẹ́, “M'nnạng-ọ mbạng?”</para>
  <para style="p" vid="GEN 30:31">Jekọb ọpọhn-ẹ bẹ́, “Amma pẹnẹ wạnọ wạnọ k'akhọ ọbọhk nạ́nnora, udik ubungukwẹ kw'nnoru ode bẹ́, m'atte itirakpo pyọ ọbọhk anạng-m nkkeri. <verse eid="GEN 30:31" /><verse number="32" style="v" sid="GEN 30:32" />Tte mbaana mvu sọ s'n'nkkeri, ntekha ọrạkhạmaan-nwa p'akkẹrẹ-ọkkẹr, ọttạra avukpokha py'ape abhaangẹ, ede ẹtaam chaam.<verse eid="GEN 30:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 30:33" />“De ukpir k'okpe kw'm'akwu akkeri itirakpo pyọ, tte udik ọkka kwaam ọkhaama ẹyaakha bẹ́, de ase ọrạkhạmaan-nwa kwidede kw'nạn ifor nọ́kkẹra, ọttạra ivu chidede ch'nạn ẹbhaange nípua k'ikhaana s'nten saam, tạkha bẹ́, mfhu-ufhu.”<verse eid="GEN 30:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 30:34" />Laban oben bẹ́, “Amma kk'nchera k'udik ọkka bẹ, akwẹ ode oche kw'abeni.”<verse eid="GEN 30:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 30:35" />Ma iwu njọ jạnẹ, Laban oseng otekha avudim py'akkẹr-ọkkẹr, ọttạra py'epe abhaangẹ, ọttạra avukpokha phyi-phyibh p'akkẹr-ọkkẹr, ọttạra py'epe abhaangẹ, ọttạra ọrạkhạmaan-nwa bina phyi-phyibh, ọtạkha ọnạng iva pẹ bẹ́, abẹ akkeri. <verse eid="GEN 30:35" /><verse number="36" style="v" sid="GEN 30:36" />Ma wọ ubin osenga kw'iwu ittaan ọttạra iva pẹ, arik Jekọb s'n'okkeri mvu nnọkha s'Laban. <verse eid="GEN 30:36" /><verse number="37" style="v" sid="GEN 30:37" />Ma wọ Jekọb ọtạk abọhkha akhikhebhi, p'ichi ch'pọpula, ọttạra abọhkha p'ichi ch'almọn, ọttạra p'ichi ch'ede <char style="it">bẹ kwaarr</char>, oboru akpakpa, usi asẹ iwur <char style="it">bẹ gwaang</char>. <verse eid="GEN 30:37" /><verse number="38" style="v" sid="GEN 30:38" />Ma wọ Jekọb ọtạk abọhkha p'nchi nnọ s'kk'akpakpa obora, uttima ma ibyi s'mvu n'ita igwo asi, ọfha ode bẹ́, k'okpe kw'm'ivura ayok ma ibyi nnọ s'asẹ n'igwo asi, <verse eid="GEN 30:38" /><verse number="39" style="v" sid="GEN 30:39" />Mvu-nọ asẹ ikkeri achibọhkha mbọ ititikha, asẹ imaan ayok p'akkẹr-ọkkẹr. <verse eid="GEN 30:39" /><verse number="40" style="v" sid="GEN 30:40" />Ma wọ Jekọb ọbhaangẹ arạkhạmaan-va k'nvu ọkhạm ochok, okhenka, n'usi mbọkha p'arikhi bẹ́, apyẹ ekkeri p'akkẹr-ọkkẹr py'ade p'Laban ititikha. Osenga ma, ẹma n'ọkhaam nten sẹ oyeni, s'nạn adạkhẹ kha nnọ s'Laban níttạra. <verse eid="GEN 30:40" /><verse number="41" style="v" sid="GEN 30:41" />K'okpe kw'ifor ibin aten-pa p'agwengi ifor ọtạm, Jekọb m'ọtạkha achibọhkha mbọ uyikha k'ọsọhkha, ọfha asẹ ikkeri ma achibọhkha mbọ k'okpe kw'm'ivura ayok. <verse eid="GEN 30:41" /><verse number="42" style="v" sid="GEN 30:42" />Okhenka, nten s'imạm ifor, sẹ achibọhkha mbọ mọ́khọhkha. Ma wọ, nnọ s'igweng ifor n'ide s'ẹma Jekọb, s'imạm ifor ide s'Laban. <verse eid="GEN 30:42" /><verse number="43" style="v" sid="GEN 30:43" />Mạnna wọ kw'uwa Jekọb oseng ujibh-ẹ mororo, n'ọkhaam itirakpo k'ọsaabh, ọttạra atọhmnạng p'ipanạng ọttạra p'ajunung, ọttạra akamẹl ọttạra nnyạnyaang.<verse eid="GEN 30:43" /></para>
  <chapter eid="GEN 30" />
  <chapter number="31" style="c" sid="GEN 31" />
  <para style="s1">Jekọb ọrạbhọ k'Laban k'mbọhk</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 31:1" />Wa Jekọb ọbhaang bẹ́, ajunungva p'Laban n'akpaak bẹ́, “Jekọb, kk'arạkhạmaan ọttạra mvu s'otte kwamạna ọtạkha pyibh ọkhaama. Ẹkhaama chẹ phyi-phyibh ibin k'otte kwamạna.” <verse eid="GEN 31:1" /><verse number="2" style="v" sid="GEN 31:2" />Jekọb ọbạra ose bẹ́, Laban dạk kẹ ititikha ikkasẹ k'nọ́nạng.<verse eid="GEN 31:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 31:3" />Ma wọ Ọvaar Ubinọkpaabyi obeni Jekọb bẹ́, “Sọhng abhạna ator anạng pọ, ọttạra ẹchọhmfhạr ch'atte. Amma m'nninga abọ, mbạra nkkaan-ọ.”<verse eid="GEN 31:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 31:4" />Osenga ma, Jekọb ọtọhm ẹkkaabha bẹ́, Rachẹl ọttạra Lea akhebh-ẹ kha ibyi s'n'okkeri nten sẹ. <verse eid="GEN 31:4" /><verse number="5" style="v" sid="GEN 31:5" />Oben bẹ bẹ́, Amma kk'nsia bẹ́, ititikha s'atte kwabạnga n'okker-m ibikhi nna, ikkasẹ sạng, okhenka, amma nsong ma bẹ́, Ubinọkpaabyi kw'otte kwaam okpobh, uning abamẹ. <verse eid="GEN 31:5" /><verse number="6" style="v" sid="GEN 31:6" />Abạnga asong ma bẹ́, amma kk'ọtọhm nsia ọttạra ẹfa chaam phyibh nnạng atte kwabạnga, <verse eid="GEN 31:6" /><verse number="7" style="v" sid="GEN 31:7" />oseng ma, kk'aam ọbọra k'ikpe saabhada. Okhenka, Ubinọkpaabyi abẹ nóchera bẹ́, usi-m ọttọhk. <verse eid="GEN 31:7" /><verse number="8" style="v" sid="GEN 31:8" />Okpe kw'obeni bẹ́, Nten nnọ s'ikker-ọkker ẹrọ ide ẹtaam chọ, nten phyibh bạra imaan ayok p'akkẹr-ọkkẹr. <verse eid="GEN 31:8" /><verse number="9" style="v" sid="GEN 31:9" />Ma ukhira ngwọ gwọ, Ubinọkpaabyi ọtạk nten k'atte kwabạnga k'mbọhk, ọtạkha ọnạng-m.<verse eid="GEN 31:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 31:10" />“K'iwu mạnna jạnẹ, k'okpe kw'nten n'ivura ayok, nttaar idachen s'nse bẹ́, avudim p'n'avura avukpokha, ede py'ẹkkẹr-ọkkẹr, ọttạra py'epe abhaangẹ. <verse eid="GEN 31:10" /><verse number="11" style="v" sid="GEN 31:11" />K'idachen, itọhmọ s'Ubinọkpaabyi iyer-m bẹ́, ‘Jekọb.’ Amma nchera bẹ́, ‘O o, kkeri amma maa e.’ <verse eid="GEN 31:11" /><verse number="12" style="v" sid="GEN 31:12" />Ẹma n'oben-m bẹ́, ‘Yangẹ kha ẹrạng, m'ase bẹ́, avudim p'n'avura avukpokha phyibh akkẹr-ọkker, ọttạra py'epe abhaangẹ. Nsi akwẹ ode oche ngwọ ukwuru bẹ́, kk'udik kwidede kw'Laban n'usi-ọ nsia. <verse eid="GEN 31:12" /><verse number="13" style="v" sid="GEN 31:13" />Amma wọ nde Ubinọkpaabyi kw'Bẹtẹl, ma ibyi s'abyeng ẹta ana k'echo, abạra atạkha echekha ma anạng-m. Nemeden bina rik ofhon ngwa, abhạna k'ọmmaana-fhon kwọ.’ ”<verse eid="GEN 31:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 31:14" />Ma wọ, Rachẹl ọttạra Lea n'apọhn udim kwabẹ, Jekọb bẹ́, “Ọttọhk f'm'ambạra anchi otte kwamạna obo k'ẹkhaama chẹ phyibh, dạk kóde. <verse eid="GEN 31:14" /><verse number="15" style="v" sid="GEN 31:15" />Otte kwamạna n'ọtak mạna masẹ akhikhennạng, k'ọbada mạnkeni sạng kw'ọnạng mạna, kk'amina-kpokha pamạna uchia <char style="it">bẹ phyibh</char>. <verse eid="GEN 31:15" /><verse number="16" style="v" sid="GEN 31:16" />K'udik ọkka, si oche kwidede kw'Ubinọkpaabyi kk'ọ obena bẹ́, asi, ukwuru bẹ́, Ubinọkpaabyi kk'ẹkhaama ch'otte kwamạna ọtạkha phyibh, n'ọtạk ọnạng amạnamba, ọttạra iva pamạna.”<verse eid="GEN 31:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 31:17" />Ma wọ, Jekọb ubin, ọtạkha iva pẹ, ọttạra ipanạng pẹ afa, ọnạna k'akamẹl, <verse eid="GEN 31:17" /><verse number="18" style="v" sid="GEN 31:18" />n'utim itirakpo pyẹ phyibh py'kk'ọkhaama k'Padan-Aram ubina osenga bẹ́, ukwuna otor otte kwẹ, Isaak k'Kenaan.<verse eid="GEN 31:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 31:19" />Masẹ Laban kk'ofona bẹ́, ọta uphyiri arạkhạmaan pẹ aphyạbha, ikwanạng kwẹ, Rachẹl, oseng ọta ufu akpatava p'otte. <verse eid="GEN 31:19" /><verse number="20" style="v" sid="GEN 31:20" />Ayongu ma, wa Jekọb ọbọhr Laban kw'ubin Aram ọbọhra, khẹ nótekha bẹ́, nabạra ọrạbh ofona. <verse eid="GEN 31:20" /><verse number="21" style="v" sid="GEN 31:21" />Ma wọ, Jekọb ọtạk ẹkhaama chẹ phy-phyibh, ojekha ọraanga kw'Yupharetes, okkeri ititikha k'ukhubha kw'okpecho kw'Gilead, ọrạbh ofona.<verse eid="GEN 31:21" /></para>
  <para style="s">Laban ukhubhu Jekọb</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 31:22" />Masẹ ottong iwu ittaan, ma wọ abẹ n'atekhi Laban bẹ́, Jekọb kk'ọrạbha. <verse eid="GEN 31:22" /><verse number="23" style="v" sid="GEN 31:23" />Laban ọtạkha ivọkka pẹ p'atwạnọ abẹ, abẹ akhubh Jekọb iwu isenọfa, tạrr abẹ n'avạkh-ẹ kha akpecho p'Gilead. <verse eid="GEN 31:23" /><verse number="24" style="v" sid="GEN 31:24" />Ma wọ, Ubinọkpaabyi uyini Laban kw'ubin Aram abẹ k'idachen ma irungu njọ, ọtwạr-ẹ itọhng, bẹ́, “Tik ifor sọ, nạngẹ ọtọhnga gwạnọ-gwạnọ akpaakhẹ anạng Jekọb, upyibh-upyibh, ujibh-ujibh.”<verse eid="GEN 31:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 31:25" />Masẹ Laban okhebh Jekọb, Jekọb kk'ukkira kwẹ usia k'akpecho p'Gilead. Wa Laban ọttạra ivọkka pẹ akwu asi ibyibhingasẹ sabẹ abaanga ma dạkhẹ. <verse eid="GEN 31:25" /><verse number="26" style="v" sid="GEN 31:26" />Masẹ abẹ akhebh ayok, Laban ọbạbh Jekọb bẹ́, “Asi yạn abọhr-m, atima apanạngva paam arạbh afona masẹ anạng p'abẹ achi k'ekpong? <verse eid="GEN 31:26" /><verse number="27" style="v" sid="GEN 31:27" />Oseng yạn kw'n'afu-ufu arạbh, abạra abọhr-m o? Usi yạn nạn khaam nátekha bẹ́, n'abạra afona, ọfha ntima ọkkọhna ọttạra ukhira, nnik bạnga k'eden o? <verse eid="GEN 31:27" /><verse number="28" style="v" sid="GEN 31:28" />Khaam ọbọhk mesese náttia bẹ́, mbaakha iva paam ọttạra iva p'abẹ ettem, bạrasẹ abẹ n'afon. Efon ch'asi ma nérebha a. <verse eid="GEN 31:28" /><verse number="29" style="v" sid="GEN 31:29" />Amma nkhaam ẹfa ma wạra m'nsi-ọ ọttọhk, okhenka, chạnachẹ k'irungu, Ubinọkpaabyi uyin-m abẹ k'idachen ọtwạr-m itọhng bẹ́, ‘Tik ifor sọ, nạngẹ ọtọhnga gwạnọ-gwạnọ akpaakhẹ anạng Jekọb, upyibh-upyibh, ujibh-ujibh.’ <verse eid="GEN 31:29" /><verse number="30" style="v" sid="GEN 31:30" />Masẹ uttum-ọ bẹ́, abhạna k'atte k'ofhon, asi yạn afu akpatava paam o?”<verse eid="GEN 31:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 31:31" />Jekọb ọpọhna Laban bẹ́, “Amma mfon oche ngwọ ukwuru s'ojor-m bẹ́, m'avạkh-m apanạngva pọ ana k'ẹfa. <verse eid="GEN 31:31" /><verse number="32" style="v" sid="GEN 31:32" />Okhenka, de ase ọnạng mạnna wạnọ kamạna k'ikhaana kw'utim akpatava pọ, tte ọnang nwọ nạngẹ akpen urukhu. Maa ititikha s'anạng pamạna, ọma oyeni kkeri, de amma ntim ọttọhk fidede f'ode pfọ, tạkha” Wa Jekọb kósong bẹ́, Rachẹl kk'akpatava p'ote ufua.<verse eid="GEN 31:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 31:33" />Mạ wọ, Laban ọnwa k'ukkira kw'Jekọb, ọttạra kw'Lea, ọttạra kw'atọhmnạng p'ipanạng afa oror akpatava pẹ, okhenka, ọtọhk vạnọ-vạnọ núsia. Masẹ uyini k'ukkira kw'Lea, ọnwa k'ukkira kw'Rachẹl. <verse eid="GEN 31:33" /><verse number="34" style="v" sid="GEN 31:34" />Wa Rachẹl kk'akpatava p'otte ọtạkha oge k'ẹkpa ch'ibubh ẹyạr-ninga ch'kamẹl kwẹ, uninga ẹyạr onyema pyẹ. Laban ọfạngọ ibyi sidede, akpatava pẹ núsia.<verse eid="GEN 31:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 31:35" />Ma wọ, Rachẹl obeni otte bẹ́, “Aro kwaam, totokhạn nạng-ọ ọdwạkhọ s'nạn nkke mbina mbobe kakhọ k'ititikha, ukwuru bẹ́, ntto ifor.” Ma o, Laban ofona ororo ọfạngọ k'ibyi sidede, akpatava pẹ núsia. <verse eid="GEN 31:35" /><verse number="36" style="v" sid="GEN 31:36" />Jekọb ukwu ọdwạkh-ẹ Laban abẹ, n'obeni Laban bẹ́, “Amma oyeni, njẹ-ọ bạng udik o? Bạng ipyibha khira jọ kk'nsia o, ch'aseng achẹ akhubh-m ẹkhạm-ẹkhạma oche ngwama o? <verse eid="GEN 31:36" /><verse number="37" style="v" sid="GEN 31:37" />Kk'ọttọhk fidede f'ode pfaam afạnga, bạng ọttọhk vọ ase f'ode pfọ? Jẹ pfẹ ma ititikha s'anạng pamạna, tte abẹ akpaara iponga s'amạna mba anạng afa.<verse eid="GEN 31:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 31:38" />“Kk'abọ nninga k'icho mạnna ẹrạbh. Ma icho nnọ phyibh, arạkhạmaan ọttạra, mvu sọ s'ifhạr iyini kíde. Ẹrạkhạmaan-dim chọ nạ́nchia. <verse eid="GEN 31:38" /><verse number="39" style="v" sid="GEN 31:39" />Eten chọ ch'mkpaten ifhọ ch'ntim nkken-ọ kéde. Ọttọhk pfọ f'udimi k'akhaam k'mbọhk, f'nạ́n ntwukha kóde. <verse eid="GEN 31:39" /><verse number="40" style="v" sid="GEN 31:40" />Wa akpen paam ade p'ekkekhạra ẹmaanẹ k'ẹya, ekhokh isi-m k'irungu, mbạra ntim ọda. <verse eid="GEN 31:40" /><verse number="41" style="v" sid="GEN 31:41" />Wa akwẹ ode oche ngwọ k'icho ẹrạbh s'nning abọ. Nsi ọtọhm nnạng-ọ k'icho sọnachi, ọfha ntạkha aminava pọ afa k'ọbada, ọttạra icho isajạnẹ s'nkkeri nten sọ, ayongu ma, ayekhi f'ọbaan bẹ́, anạng-m. <verse eid="GEN 31:41" /><verse number="42" style="v" sid="GEN 31:42" />De wạra nạn Ubinọkpaabyi kw'otte kwaam, kw'ode Ubinọkpaabyi kw'Abraham ọttạra Isaak akpobh, núdia kw'uning abamẹ, njanna wạra kk'aam mbọhk-mbọhk akhubha. Okhenka, Ubinọkpaabyi kk'irem saam usia, ọbạra ose ọtọhm f'kk'nsia, ẹgwọ usi, ọkpọ-ọ eden chạnachẹ k'irungu bẹ́, nạng-m ipyibha asi.”<verse eid="GEN 31:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="GEN 31:43" />Ma wọ, Laban n'ubhin Jekọb bẹ́, “Ipanạng mba ade iva paam, iva mba phyibh ade iva p'iva paam, nten nna ibạra ide saam. Ọttọhk fidede f'akhaam maa, ode pfaam. De akker-okkeri, napra wọ m'mbạra ntạkha iva paam, ọttạra iva p'iva paam amaanẹ k'mbọhk sọ dạkhẹ? <verse eid="GEN 31:43" /><verse number="44" style="v" sid="GEN 31:44" />Kwu antạkha echekha annạng ayok, ch'mede masẹ nttẹnsẹ kw'amma ọma abẹ.”<verse eid="GEN 31:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="GEN 31:45" />Ma o, Jekọb ọtạkha ẹta, ofho, achẹ ebe masẹ ntumu. <verse eid="GEN 31:45" /><verse number="46" style="v" sid="GEN 31:46" />Ma wọ, Jekọb n'obeni anạng pẹ bẹ́, “Abạnga atobha ata.” Abe atạkha ata atobha k'ukwung, abẹ abạra aninga abaanga ọtakwung ngwọ achi uchiattọhk. <verse eid="GEN 31:46" /><verse number="47" style="v" sid="GEN 31:47" />Wa Laban oyeri ọtakwung ngwọ Jega-Sahaduta, Jekọb oyeri kwẹ Galeed<note caller="+" style="f"><char style="fr" closed="false">31.47 </char><char style="ft" closed="false">Galeed k'eHiburu uyini ọta-kwung kw'nttẹnsẹ.</char></note>.<verse eid="GEN 31:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="GEN 31:48" />Laban n'obeni bẹ́, “Chemma, ọtakwung ngwa ode nttẹnsẹ kw'amma ọttạra ọma.” Ẹgwọ usi, abẹ ayeri ibyi nnọ Galeed. <verse eid="GEN 31:48" /><verse number="49" style="v" sid="GEN 31:49" />Wa Laban ọbạra oyeri ibyi nnọ Mizpa, oben bẹ́, “Tte Ọvaar Ubinọkpaabyi okkeri mạna masẹ m'antte ayok ọbọhk, ọnạng-ọnạng ofona kwẹ. <verse eid="GEN 31:49" /><verse number="50" style="v" sid="GEN 31:50" />De atim iva paam k'irem, ọbạra ode bẹ́, m'ata atạkha ipanạng adwạkh-ọdwạk kw'oyongu iva paam, ọbạra ode bẹ́ ọnạng mạna núsia, jima bẹ́ Ubinọkpaabyi wọ ode nttẹnsẹ kw'amma ọma abẹ.” <verse eid="GEN 31:50" /><verse number="51" style="v" sid="GEN 31:51" />Laban ọbạra oben Jekọb bẹ́, “Kkeri ọtakwung maa, kkeri ntumu s'kk'nttima k'ottemkwẹ kw'amma ọttạra ọma abẹ. <verse eid="GEN 31:51" /><verse number="52" style="v" sid="GEN 31:52" />Ọtakwung ngwa, ọttạra ntumu nna, abe masẹ nttẹnsẹ bẹ, okpe dạk kòde kw'amma m'mbạra njekha ibyi nna nkwu nsi ọma ipyibha, ọttạra bẹ́, okpe dạk kòde kw'ọma m'abạra ajekha ibyi nna akwu asim amma ipyibha. <verse eid="GEN 31:52" /><verse number="53" style="v" sid="GEN 31:53" />Tte Ubinọkpaabyi kw'Abraham, ọttạra Nahọr, Ubinọkpaabyi kw'otte kwabẹ okpobh, ọkpaara iponga k'echekha nja, ch'amma ọttạra ọma abẹ.”</para>
  <para style="p" vid="GEN 31:53">Ma wọ Jekọb n'ọtạk echekha k'eche ch'ojora f'otte kwẹ Isaak. <verse eid="GEN 31:53" /><verse number="54" style="v" sid="GEN 31:54" />Jekọb n'ọtạk ọrạkhạmaan ọfhọ, utima ọfọhnọ ẹja ọnạng Ubinọkpaabyi k'ukhubha kw'akpecho, ọbạra oyeri anạng pẹ abẹ akwu achi uchiattọhk ma. Masẹ abẹ kk'uchiattọhk achia phyibh, abẹ n'ayim ma tạrr iwu echobha.<verse eid="GEN 31:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="GEN 31:55" />Masẹ iwu kk'echobha, Laban ubina odo ifor s'm'ofona, ọbaakha iva pẹ afa, ọttạra iva p'iva pẹ, ọbạra ọyọbh bẹ itta, brasẹ n'ubin ọbhạna k'akhẹ k'ofhon.<verse eid="GEN 31:55" /></para>
  <chapter eid="GEN 31" />
  <chapter number="32" style="c" sid="GEN 32" />
  <para style="s">Jekọb odo ifor bẹ, ọta okhebha Ẹsau</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 32:1" />Ma wọ, Jekọb ubin osenga, atọhmọ p'Ubinọkpaabyi ayin abẹ. <verse eid="GEN 32:1" /><verse number="2" style="v" sid="GEN 32:2" />Masẹ Jekọb ose atọhmọ mbọ p'Ubinọkpaabyi, oben bẹ́, “Ibyi nna ide ibyibhingasẹ s'Ubinọkpaabyi.” Osenga ma, oyeri sẹ Mahanayim<note caller="+" style="f"><char style="fr" closed="false">32.2 </char><char style="ft" closed="false">K'eHiburu, Mahanayim uyini ibyibhingasẹ ifa.</char></note>.<verse eid="GEN 32:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 32:3" />Wa Jekọb ọtọhmọ atọhmnạng pẹ bạnọ bẹ́, abẹ acheden ata ase nnwọkka Ẹsau k'ẹkhạma ch'Seir, k'ukhubha kw'Edom, <verse eid="GEN 32:3" /><verse number="4" style="v" sid="GEN 32:4" />ọnạngẹ bẹ ẹkkaabha bẹ́, “Abạnga akpaak aro kwaam, Ẹsau bẹ́, ‘Amma ọtọhmnạng kwọ, Jekọb, mbeni bẹ́, ntạm kẹnạma nninga Laban abẹ tạrr ukpira mantọmma. <verse eid="GEN 32:4" /><verse number="5" style="v" sid="GEN 32:5" />Amma kk'mmaam, ọttạra arạkhạmaan, ọttạra mvu, ọttạra abira p'ajunung, ọttạra p'ipanang nkhaama. Amma ntọhmọ ẹkkaabha nja nkkena aro kwaam, ọfha ntạkha ọphyaam k'akhọ-ọ k'ititikha.’ ”<verse eid="GEN 32:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 32:6" />Masẹ atọhmnạng p'Jekọb akwun ator-ẹ, abẹ akpaakh-ẹ bẹ́, “Kk'nnwakka Ẹsau anta ansia, ẹma oyeni ukwuma kha eden bẹ́ ukwu usi-ọ. Ẹma ọkhaam anạng enọhna p'atwạnọ abẹ.”<verse eid="GEN 32:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 32:7" />Wa Jekọb ojor-ẹ, ettem ẹphyaangẹ-ẹ ẹmma. Osenga ma, ọbhaangẹ anạng p'utim k'ikhaana ifa, ọbạra ọbhaangẹ arạkhạmaan, ọttạra mmaam, ọttạra akamẹl. <verse eid="GEN 32:7" /><verse number="8" style="v" sid="GEN 32:8" />Jekọb nobeni ẹma oyeni bẹ́, “Ode Ẹsau urim ikhaana rạne abẹ, nnọkha s'irikhi m'irạbh innaanga.”<verse eid="GEN 32:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 32:9" />Wa Jekọb ose njọhm, oben bẹ́, “Ubinokpaabyi kw'otte kwaam Abraham, ọttạra kw'otte kwaam Isaak, Ọvaar Ubinọkpaabyi kw'oben-m bẹ́, ‘Sọhng abhạna k'ẹkhạma chọ, ator anạng pọ, amma m'nsi idik ijibh inạng-ọ.’ <verse eid="GEN 32:9" /><verse number="10" style="v" sid="GEN 32:10" />Amma ọtọhmnạng kwọ kk'ọphyaam pfọ, ọttạra idạdaakha sọ nạ́mbaana. Wa ntim uchikwura kwaam mạnkkeni njekha ọraanga kw'Jọrdan, mantọmma, kk'ẹkhaama nsia tạrr n'mmaangẹ chẹ k'ibyi ifa. <verse eid="GEN 32:10" /><verse number="11" style="v" sid="GEN 32:11" />Totokhạn, kkaan-m, arạbh-m k'mbọhk s'nnwọkka kwaam Ẹsau, ukwuru bẹ́, ojora kwaam ode bẹ́, m'ukwu ọfhọ mạna phyibh, oseng k'iva, ọttạra ab'ọkka phyibh. <verse eid="GEN 32:11" /><verse number="12" style="v" sid="GEN 32:12" />Okhenka, wa kk'echekha atạkha anạng-m bẹ́ m'asi-m nkhaama ẹkhaama, abạra asi iva p'iva paam asaabh masẹ uyiyeng kw'iraanga-khonga, kw'ọnạng nạmókke ubhik.”<verse eid="GEN 32:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 32:13" />Wa Jekọb ubhingi ma ibyi nnọ ma irungu njọ. Otekha ekpo byạnọ k'ekpo py'ọkhaam, py'm'ọnạng nnwọkka Ẹsau, masẹ ẹtaam. <verse eid="GEN 32:13" /><verse number="14" style="v" sid="GEN 32:14" />Ubhik kw'ekpo mbyọ ode: avukpokha arạbh jobh, ọttạra afhạmkpẹ ẹrạbh, ọttạra arạkhạmaan-pa arạbh jobh, ọttạra avudim ẹrạbh, <verse eid="GEN 32:14" /><verse number="15" style="v" sid="GEN 32:15" />ọttạra akamẹl-pa ẹrạbh ukuma jobh, ọttạra iva pabẹ, ọttạra mmaam-papẹ arạbh afa, ọttạra mmaam-dim jobh, ọttạra nnyạnyaang-kwa ẹrạbh, ọttạra nnyạnyaang-dim jobh. <verse eid="GEN 32:15" /><verse number="16" style="v" sid="GEN 32:16" />Jekọb ọtạkha arạkhạmaan mbọ ochok k'ikhaana, k'ikhaana. Ikhaana sidede ikhaam ọtọhmnạng wạnọ kw'n'okkeri, oben bẹ bẹ́, “Abạnga achi-m eden asọhng, abạnga abạra arik ayok ẹbhaang k'osenga ngwọ.”<verse eid="GEN 32:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 32:17" />Ukwu ọtwạr ọtọhmnạng kw'uchi eden itọhng bẹ́, “De nnwọkka kwaam, Ẹsau, ọbạbh-ọ bẹ́, ‘Ọma ade kw'anẹ? N'ata mạn maa? Nten s'anẹ rọ n'akkeri?’ <verse eid="GEN 32:17" /><verse number="18" style="v" sid="GEN 32:18" />M'apọhn-ẹ bẹ, ‘Aro kwaam, ekpo mbya phyibh ede py'ọtọhmnạng kwọ, Jekọb. Apyẹ ede ẹnạnga ch'ọtọhmọ okkena aro kwaam Ẹsau. Ẹma oyeni ukwuma kha eden.’ ”<verse eid="GEN 32:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 32:19" />Wa Jekọb ọbạra oben ikhaana s'ittong ifa, ọttạra s'ittong itaan, ọttạra ayok mbọkha phyibh p'm'ator itirakpo nnạm bẹ́, “Masẹ abạnga m'akhebha Ẹsau, abạnga akpaakh-ẹ udik ngwọ gwạnọ kw'mkpaakhẹ ochedennạng. <verse eid="GEN 32:19" /><verse number="20" style="v" sid="GEN 32:20" />Abạnga ajima akpaakh-ẹ bẹ́, ‘Ọtọhmnạng kwọ, Jekọb, n'otor mạna nnạm, ukwuma kha eden e.’ ” Ẹma Jekọb kk'ọkka bẹ́, “Amma m'nchi eden ntọhm ẹnạnga nja, ntima ndir-ẹ ettem, nudusi de ose-m, okko-okke ochera bẹ́, ọtakh-m.” <verse eid="GEN 32:20" /><verse number="21" style="v" sid="GEN 32:21" />Ma wọ, atọhmnạng p'Jekọb achi eden atima nnạnga aseng, okhenka, ẹma oyeni n'uyim ma ibyibhingasẹ sẹ ma irungu njọ.<verse eid="GEN 32:21" /></para>
  <para style="s">Jekọb urim Ubinọkpaabyi abẹ</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 32:22" />Ma irungu njọ, Jekọb ubina, ọtạkha ipanạng pẹ afa, ọttạra atọhmnạng pẹ p'ipanạng afa, ọttạra iva pabẹ p'ajunung, ncho jobhkawạnọ, ọtọhm bẹ akwu igbin-igbin ajekha ọraanga kw'Jabọk. <verse eid="GEN 32:22" /><verse number="23" style="v" sid="GEN 32:23" />Masẹ kk'anạng mbọ phyibh ọtọhma ajekha ọraanga, ọtọhm adạkhẹ anạng ọttạra ẹkhaama chẹ phyibh. <verse eid="GEN 32:23" /><verse number="24" style="v" sid="GEN 32:24" />Osenga ma, Jekọb n'uning mạnkkeni. Ujunung wạnọ uyin abẹ, abẹ arima tạrr iwu echobha. <verse eid="GEN 32:24" /><verse number="25" style="v" sid="GEN 32:25" />Masẹ ujunung nwọ ose bẹ́, Jekọb mókke okhema, n'ọmaam-ẹ ọttọhk k'okpok, usi ọkhạbhọ kw'okpok upyira echo, sabẹ atim arim-urima. <verse eid="GEN 32:25" /><verse number="26" style="v" sid="GEN 32:26" />Ma wọ, ọnạng nwọ obeni Jekọb bẹ, “Ttem ọbọhk mfona, khiri iwu nạngkha echobha.” Jekọb ọpọhn-ẹ bẹ́, “Kọ ọbọhk mạ́ntte, oyonga m'ado-m.”<verse eid="GEN 32:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 32:27" />Ma wọ, ọnạng nwọ nọbạbh-ẹ bẹ́, “Ọma akpen yạn?” Ọpọhn-ẹ bẹ́, “Mkpen Jekọb.”<verse eid="GEN 32:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 32:28" />Ujunung nwọ n'oben-ẹ bẹ́, “Tạma chemma, ọma Jekọb dạk mákpena, n'akpen Israẹl, ukwuru bẹ́, kk'irima asia Ubinọkpaabyi abẹ, ọttạra ayokhanạng, abạra akhema.”<verse eid="GEN 32:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 32:29" />Ma wọ, Jekọb n'obeni ọnạng nwọ bẹ́, “Totokhạn, tekh-m eche chọ.” Ọnạng nwọ ọbạbh-ẹ bẹ́, “Asi yạn abạbh-m eche?” Ma wọ ọnạng nwọ odo Jekọb ma ibyi nnọ.<verse eid="GEN 32:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 32:30" />Wa Jekọb n'oyeri ibyi nnọ Pẹniẹl<note caller="+" style="f"><char style="fr" closed="false">32.30 </char><char style="ft" closed="false">K'eHiburu, Pẹniẹl uyini ititikha s'Ubinọkpaabyi.</char></note>, ọbẹ́, “Amma kk'Ubinọkpaabyi nsia, ititikha ọttạra ititikha, okhenka, nạ́mpua, ntim nnukhu akpen.”<verse eid="GEN 32:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 32:31" />Masẹ iwu n'ebe k'echo, Jekọb n'okpekhi oseng Pẹniẹl, ukwuru ọkhạbhọ kwẹ kw'okpok kw'upyir echo. <verse eid="GEN 32:31" /><verse number="32" style="v" sid="GEN 32:32" />Egwọ usi, tạrr ukpira chemma, anạng p'Israẹl ẹnạng ch'ẹvạk k'ọkhạbhọ kw'okpok kạnáchi, ukwuru ọkhạbhọ kw'okpok kw'Jekọb kw'uwa ọnạng uvunu ọttọhk.<verse eid="GEN 32:32" /></para>
  <chapter eid="GEN 32" />
  <chapter number="33" style="c" sid="GEN 33" />
  <para style="s1">Ẹmẹm ch'Jekọb ọttạra Ẹsau</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 33:1" />Masẹ Jekọb udir ichen, ose nnwọkka Ẹsau s'n'ukwu ọttạra anạng pẹ ẹnọhna. Ma wọ n'ọtạk iva pẹ okhebh ọnạng ab'ọkka. Ọnạng Lea, ọttạra Rachẹl, ọttạra atọhmnạng p'ipanạng pẹ afa. <verse eid="GEN 33:1" /><verse number="2" style="v" sid="GEN 33:2" />Wa ọtạk atọhmnạng p'ipanạng pẹ, ọttạra iva pabẹ utima uchi eden, Lea ọttạra iva pẹ ator bẹ nnạm, bạra Rachẹl ọttạra nnwa kwẹ Josẹph n'akpong nnạm. <verse eid="GEN 33:2" /><verse number="3" style="v" sid="GEN 33:3" />Wa Jekọb ofon ororo otor nnwọkka. Masẹ oseng ofor-ẹ k'ifor, ọrạkha uttima ititikha k'isisek nden nsenọfa, ọnạng Ẹsau ikpukpobha.<verse eid="GEN 33:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 33:4" />Okhenka, Ẹsau ọrabhọ ọta orena Jekọb, ọgaar-ẹ mbọhk k'ikhukhora, ọbạra ọbaakh-ẹ ettem. Abẹma anạng afa agạma. <verse eid="GEN 33:4" /><verse number="5" style="v" sid="GEN 33:5" />Masẹ Ẹsau udir ichen ose ipanạng ọttạra iva, n'ọbạbhọ bẹ́, “Bạng anạng bọ p'abạnga atwạnọ kạkha o?”</para>
  <para style="p" vid="GEN 33:5">Jekọb ọpọhn-ẹ bẹ, “Iva p'Ubinọkpaabyi kk'amma ọtọhmnạng kwọ ọnạnga k'ọphyaam ẹbọ mạma e.”<verse eid="GEN 33:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 33:6" />Ma wọ atọhmnạng pẹ p'ipanạng, ọttạra iva pabẹ aseng agbaara Ẹsau, abẹ arạkha attima ititikha k'isisek anạng-ẹ ikpukpobha. <verse eid="GEN 33:6" /><verse number="7" style="v" sid="GEN 33:7" />Ọpọhn kha, Lea ọttạra iva pẹ abạra attima ititikha k'isisek, bạra Rachẹl ọttạra Josẹph n'akpong nnạm akwu attima ititikha k'isisek anạng-ẹ ikpukpobha.<verse eid="GEN 33:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 33:8" />Ẹsau n'ọbạbhọ bẹ́, “Anạng mbọ p'wạra nkhebh, ọttạra itirakpo py'abẹ atim akwu, atọhmọ bẹ bẹ́, abẹ akwu asi yạn-o?”</para>
  <para style="p" vid="GEN 33:8">Jekọb ọpọhn-ẹ bẹ́, “Attitte, ntim pyẹ nkwu bẹ́, nkwu ntạkha ọphyaam k'ititikha sọ e.”<verse eid="GEN 33:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 33:9" />Ẹsau oben bẹ́, “Mma e, nnwọkka kwaam, ọma khaama ekpo pyọ, amma kk'ekpo nkhaama k'ọsaabh apyẹ ebeng-m.”<verse eid="GEN 33:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 33:10" />Jekọb ọbẹ́, “Mma o, nchin-ọ-uchini. De ọphyaam f'asi anạng-m ubin-ọ k'ettem, tạkha ẹnạnga nja k'akhaam k'ọbọhk. Isia ch'nsi-ọ maa ode masẹ nse ititikha s'Ubinọkpaabyi, s'ammaam mbọhk atạkh-m. <verse eid="GEN 33:10" /><verse number="11" style="v" sid="GEN 33:11" />Totokhạn, chera bẹ́, atạkha ẹnạnga ch'nnạng-ọ, s'Ubinọkpaabyi kk'aam udia, ọnạng-m fidede f'nnoru.” Masẹ Jekọb ofon ororo ọkpạna bẹ́, oyonga nnwọkka m'ọtạkha ẹnạnga ch'ọnạng-ẹ, Ẹsau ukwu ochera, ọtakha.<verse eid="GEN 33:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 33:12" />Ma wọ Ẹsau n'obeni bẹ́, “Seng amfona, amma m'nchi-ọ eden.”<verse eid="GEN 33:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 33:13" />Okhenka, Jekọb oben-ẹ bẹ́, “Attitte, ọma asong ma bẹ́, iva paam atim asạkh-ọsạkha, abẹ ẹfa kákhaam, ọttạra bẹ́, itirakpo pyaam itim irạk ayok. Ode antim bẹ ansenga k'ẹbhạr k'ẹbhạr k'iwu jạnẹ k'ubungu, nten nnọ phyibh m'ipope. <verse eid="GEN 33:13" /><verse number="14" style="v" sid="GEN 33:14" />Tte aro kwaam uchi amma ọtọhmnạng kwẹ eden, ọfha ntima itirakpo mbya ọttạra iva mba, ngima nsenga, tạrr ankhebha ayok kha Seir.”<verse eid="GEN 33:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 33:15" />Ma wọ, Ẹsau n'oben-ẹ bẹ́, “Tte ntte anạng paam bạnọ ọbọhk, abẹ atwạn abọ.”</para>
  <para style="p" vid="GEN 33:15">Jekọb ọpọhn-ẹ bẹ́, “Sam e, attitte. Ukwuru yạn kw'm'abạra aphyaangẹ ifor sọ ẹmma o? Amma nnoru ọphyaam pfọ mạnkkeni.”<verse eid="GEN 33:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 33:16" />Ma iwu njọ jạnẹ, Ẹsau ubin osenga ọkpa nnạm k'Seir. <verse eid="GEN 33:16" /><verse number="17" style="v" sid="GEN 33:17" />Okhenka, Jekọb oten k'Sukọt. Ma wọ kw'uwa usi ọchọhm kw'urukhu, ọbạra usi akkira p'itirakpo pyẹ. Ẹgwọ usi abẹ ayeri ibyi nnọ Sukọt.<note caller="+" style="f"><char style="fr" closed="false">33.17 </char><char style="ft" closed="false">K'eHiburu, Sukọt uyini ukkira.</char></note><verse eid="GEN 33:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 33:18" />Wa k'ekpongannạm-kpe, Jekọb ubin k'Padan-Aram tạrr ukwu ukpira k'efhon-diden ch'Shẹkẹm, k'ẹkhạma ch'Kenaan, usi ibyibhingasẹ ma ọbạanga efhondiden njọ. <verse eid="GEN 33:18" /><verse number="19" style="v" sid="GEN 33:19" />Wa Jekọb odebhi isisek nnọ s'uttim akkira k'mbọhk s'iva p'Hamọr, kw'ode otte kw'Shẹkẹm, k'asilva arạbh asen. <verse eid="GEN 33:19" /><verse number="20" style="v" sid="GEN 33:20" />Ma ibyi nnọ rọ s'Jekọb usi ijabyi, ọbạra oyeri ibyi nnọ bẹ́, Ubinọkpaabyi ode Ubinọkpaabyi kw'Israẹl.<verse eid="GEN 33:20" /></para>
  <chapter eid="GEN 33" />
  <chapter number="34" style="c" sid="GEN 34" />
  <para style="s1">Daina ọttạra anạng p'Shẹkẹm</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 34:1" />Wa k'okpe gwạnọ, Daina kw'ode ọkwanạng-nwa kw'Lea ọmaanẹ ọnạng Jekọb, uyini k'iyaan ọta udibh ipanạng bạnọ p'ofhon ngwọ. <verse eid="GEN 34:1" /><verse number="2" style="v" sid="GEN 34:2" />Masẹ Shẹkẹm kw'ode nnwa kw'Hamọr, kw'ode ọvaarnạng kw'anạng p'Hiv ose Daina, ọvạkh-ẹ k'ẹfa uyima abẹ. <verse eid="GEN 34:2" /><verse number="3" style="v" sid="GEN 34:3" />Wa Shẹkẹm ọtak ettem chẹ phyibh ọkpạna k'Daina kw'ode uminanwa kw'Jekọb. Wa Daina ọdaakh-ẹ oseng eden, n'okhonga bẹ́, usi-ẹ ocher-ẹ eyok. <verse eid="GEN 34:3" /><verse number="4" style="v" sid="GEN 34:4" />Ma wọ, Shẹkẹm obeni otte kwẹ Hamọr bẹ́, “Aro, ọma tạkha uminanwa nwọ nạng-m amba ayok kadẹ o.”<verse eid="GEN 34:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 34:5" />Wa ajunungva p'Jekọb atim aning k'owonu, sabẹ ata anạng itirakpo pyẹ uchiattọhk k'okpe kw'Jekọb ọbhaang bẹ́, abẹ kk'nnwa kwẹ Daina ọkpạrsiadik asia. Umyi udik ngwọ tạrr iva mbọ akwuna.<verse eid="GEN 34:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 34:6" />Wa Hamọr kw'ode otte kw'Shẹkẹm, ubin ofona bẹ́ ẹma ọttạra Jekọb attọhnọ udik ngwọ. <verse eid="GEN 34:6" /><verse number="7" style="v" sid="GEN 34:7" />Masẹ iva p'Jekọb abin kha sabẹ n'akkeri itirakpo akwuna, abẹ abhaanga udik kw'otto sabẹ nạnáde, ifor ipe bẹ, nttem ibạra ipyibh bẹ ukwuru ọkpạrsiadik kw'Shẹkẹm kk'usia k'Israẹl bẹ́, ọvạk uminanwa kw'Jekọb uyima abẹ k'ẹfa, kw'nạnọ́baana mesese.<verse eid="GEN 34:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 34:8" />Okhenka, Hamọr oben bẹ bẹ́, “Totokhạn, abạnga atte nnwa kwaam Shẹkẹm ọbọhk ọtạkha uminanwa kwabạnga, khiri ettem chẹ phyibh n'ẹkpạn k'akhẹ e. <verse eid="GEN 34:8" /><verse number="9" style="v" sid="GEN 34:9" />Tte amạna ammạkhẹ antạkha ayok k'ọbada, tte ajunung p'amạna atạkha aminava p'abạnga, ọfha abạngama abạra atạkha aminava pamạna. <verse eid="GEN 34:9" /><verse number="10" style="v" sid="GEN 34:10" />Abạnga akkokke aruk mạna abẹ, isisek iyim kha <char style="it">bẹ́ tẹẹrr</char>, ifona, abạnga aruk, abạra asenga mphya s'idaakhẹ bạnga, ọttạra bẹ́, abạnga agba akhaama asisek pabạnga oyeni.”<verse eid="GEN 34:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 34:11" />Ma wọ, Shẹkẹm obeni otte ọttạra ivotte p'Daina bẹ́, “Atotokhạn e, tte ntạkha ọphyaam k'abạnga k'ititikha, amma kk'ifor ndia bẹ́, nnạng bạnga ọttọhk fidede f'abạnga abeni bẹ́, nnạng k'echo ch'uminanwa kwabạnga. <verse eid="GEN 34:11" /><verse number="12" style="v" sid="GEN 34:12" />Abạnga atekh-m acho-kpokha ọttạra ekpo pyidede py'ẹbaan bẹ́ ntima nkwu, k'oche kw'ọdaakhẹ bạnga. Amma m'nnạng bạnga ọnạng. Abạnga akhenka anạng-m uminanwa nwọ ntạkh-ẹ k'ọbada.”<verse eid="GEN 34:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 34:13" />Wa iva p'Jekọb aseng ọkpạrsiadik kw'kk'uttia okhebha nnwotte kwabẹ Daina, abọhra Shẹkẹm ọttạra otte kwẹ Hamọr. <verse eid="GEN 34:13" /><verse number="14" style="v" sid="GEN 34:14" />Abẹ aben bẹ́, “Udik demakwẹ ngwọ mánsi. Ode ọkpạrsiadik ọnạng mạna bẹ́, antạkha nwotte kwamạna annạng ọkpatwạr-nạng bẹ́, ọtakh-ẹ k'ọbada. <verse eid="GEN 34:14" /><verse number="15" style="v" sid="GEN 34:15" />Bạrasẹ anchera udik kw'abạnga aphyemi mạna maa, ode bẹ́, abạnga m'achera bẹ́, abạnga ade masẹ amạna. Oyonga ujunung kwidede k'ikhaana sabạnga m'usi ọkpọkkrọkkọ. <verse eid="GEN 34:15" /><verse number="16" style="v" sid="GEN 34:16" />Ma wọ m'antima anchera bẹ́ ajunung pabạnga atạkha ipanạng pamạna, amạna ambạra antạkha ipanạng pabạnga. Ma wọ m'anchera annuk bạnga abẹ, phyi-phyibh bạra ande wạnọ, k'oche kw'abạnga aphyemi. <verse eid="GEN 34:16" /><verse number="17" style="v" sid="GEN 34:17" />Okhenka, de abạnga nạ́náchera bẹ́ abạnga asi ọkpọkkrọkkọ, amạna mánchera bẹ́ abạnga atạkha uminanwa kwamạna k'ọbada, m'antima abẹ utima amfona e.”<verse eid="GEN 34:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 34:18" />Wa Hamọr, ọttạra nnwa kwẹ Shẹkẹm ase bẹ́ ẹkka ch'iva p'Jekọb ijibh-ujibh. <verse eid="GEN 34:18" /><verse number="19" style="v" sid="GEN 34:19" />Wa Shẹkẹm ode ọnạng kw'efona chẹ phyibh n'ẹnạng ikpukpobha. Ukwuru s'uminanwa kw'Jekọb kk'ẹ ọdaakha kidaam-kidaam, okpe dạk núkhibha, ochera bẹ́ abẹ abẹ asi bẹ ọkpọkkrọkkọ, k'oche kw'iva p'Jekọb abeni. <verse eid="GEN 34:19" /><verse number="20" style="v" sid="GEN 34:20" />Ma wọ Hamọr ọttạra nnwa kwẹ Shẹkẹm abin afona k'ẹbhama ch'ofhon bẹ́ abẹ ata akpaak anạng pabẹ udik ngwọ. <verse eid="GEN 34:20" /><verse number="21" style="v" sid="GEN 34:21" />Abẹ akpaak ajunung p'ofhon ngwọ bẹ́, “Ajunung mbọ bạra ajibh akpen! Tte abẹ aruk maa isisek samạna, abẹ asenga mphya, ọgba isisek ibạrẹ kha ifona s'm'ibenga bẹ. M'ankk-okke antạkha aminava pabẹ, abẹ atạkha pamạna. <verse eid="GEN 34:21" /><verse number="22" style="v" sid="GEN 34:22" />Eden oyeni ch'udik ngwa m'osenga ọvạkha, ọfha abẹ achera anạng mạna ode bẹ́, ajunung pamạna phyibh m'achera bẹ́, abẹ asi ọkpọkkrọkkọ, oche kw'abẹma asi. <verse eid="GEN 34:22" /><verse number="23" style="v" sid="GEN 34:23" />De akker-okkeri, ẹkhaama chabẹ phyibh, ọttạra itirakpo pyabẹ phyibh ede pyamạna. Tte anchera annạng bẹ́, ansi oche ngwọ, ọfha abẹ aruk mạna abẹ.”<verse eid="GEN 34:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 34:24" />Wa anạng mbọ phyibh p'aning ma ẹbhama acher anạng Hamọr ọttạra nnwa kwẹ Shẹkẹm. Osenga ma, ujunung kwidede kw'ofhon ngwọ oseng ofona k'ẹbhama ch'ofhon bẹ́ abẹ asi-ẹ ọkpọkkrọkkọ.<verse eid="GEN 34:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 34:25" />Masẹ iwu ittaan kk'isenga sabẹ asi bẹ ọkkpọkkrọkọ s'utim ọkhọhn bẹ ọkhọhn, iva p'Jekọb afa p'ade Simeọn ọttạra Lẹvi, p'ade ivọkka p'Daina, adir akkangkkang-kkro pabẹ k'okpe kw'anạng nạn ichen náchokha, ata afhọ ajunung p'ofhon ngwọ phyibh. <verse eid="GEN 34:25" /><verse number="26" style="v" sid="GEN 34:26" />Abẹ atim akkangkkang-kkro pabẹ afhọ Hamọr ọttạra nnwa kwẹ Shẹkẹm, abẹ abạra anwa k'ọchọhm kw'Shẹkẹm, atạkha Daina atima afona. <verse eid="GEN 34:26" /><verse number="27" style="v" sid="GEN 34:27" />Masẹ iva mbọkha p'Jekọb ase bẹ́ ajunung p'ofhon phyibh n'ayim abubukhu, abẹ anwa k'ofhon ngwọ kw'abẹ ayim nnwotte kwabẹ abẹ k'ẹfa, acha ekpo pyabẹ. <verse eid="GEN 34:27" /><verse number="28" style="v" sid="GEN 34:28" />Abẹ atạkha itirakpo ọttạra mmaam, nnyạnyaang, ọttạra ekpo pyidede ma ofhon ngwọ, atima afona. <verse eid="GEN 34:28" /><verse number="29" style="v" sid="GEN 34:29" />Abẹ atạkha ọttọhk fidede f'abẹ ase ma ofhon ngwọ, tạma k'ẹkhaama chidede, ọttạra ipanạng phyibh, ọttạra iva pabẹ, atima afona.<verse eid="GEN 34:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 34:30" />Ma o, masẹ Jekọb ukwu osonga udik ngwọ, n'obeni Simeọn ọttạra Lẹvi bẹ́, “Abạnga kk'aam agia k'ọmmaphyaangẹ, abạnga asi-m mbạkhọ aKenaan ọttạra aPẹriz p'arukhu maa isisek nna, idik. Abạnga kk'asia bẹ́, ubhik kwamạna nọ́saabha, ode anạng mba akpạr mbọhk bẹ́, arima abamẹ, abẹ m'adim-m ọttạra ẹchọhmfhạr chaam phyibh.”<verse eid="GEN 34:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 34:31" />Okhenka, abẹ apọhn-ẹ bẹ́, “Shẹkẹm wọ wạra ọbaan bẹ́, ọtạkha nwotte kwamạna masẹ ọsasa-kwanạng o?”<verse eid="GEN 34:31" /></para>
  <chapter eid="GEN 34" />
  <chapter number="35" style="c" sid="GEN 35" />
  <para style="s1">Jekọb ọkpa nnạm k'Bẹtẹl</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 35:1" />Wa Ubinọkpaabyi obeni Jekọb bẹ́, “Vura tena kha Bẹtẹl, asi ibyirukhasẹ sọ ma, abạra asi ijabyi ma anạng Ubinọkpaabyi kw'uyini abọ k'okpe kw'uwa arạbhọ k'mbọhk s'nnwạkka, Ẹsau.”<verse eid="GEN 35:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 35:2" />Ma wọ Jekọb obeni ẹchọhmfhạr chẹ, ọttạra anạng phyi-phyibh p'aning abẹ bẹ́, “Abạnga arengi akpatava pidede p'aning bạnga abẹ abhạrẹ, achok ifor sabạnga iwur-uwur, asi ẹmmaana ọkkachẹ. <verse eid="GEN 35:2" /><verse number="3" style="v" sid="GEN 35:3" />Ma wọ abạnga m'akwu amvura amfona k'Bẹtẹl, mạma wọ m'nsi ijabyi nnạng Ubinọkpaabyi kw'ọkkaan-m k'okpe kw'nning k'ọmmaphyaangẹ, kw'ọbạra uninga abamẹ k'ibyi sidede s'kk'nta.” <verse eid="GEN 35:3" /><verse number="4" style="v" sid="GEN 35:4" />Ma wọ abẹ atạk akpatava pidede py'abẹ akhaam, ọttạra akkra py'itọhng py'abẹ age, anạng Jekọb. Jekọb ọtạkha pyẹ ọnnọhnga k'ichirin ch'oak k'Shẹkẹm. <verse eid="GEN 35:4" /><verse number="5" style="v" sid="GEN 35:5" />Ma wọ abẹ abin osenga, ojora f'ididen f'Ubinọkpaabyi ọvạkha ifhon phyibh s'ibaanga bẹ tạrr ọnạng kw'ukhubhu iva Jekọb kòde.<verse eid="GEN 35:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 35:6" />Jekọb ọttạra anạng pẹ phyibh akpir k'Luz, kw'ọbạra okpena Bẹtẹl, k'ẹkhạma ch'Kenaan. <verse eid="GEN 35:6" /><verse number="7" style="v" sid="GEN 35:7" />Ma wọ kw'Jekọb usi ijabyi, okpe sẹ Ẹl-Bẹtẹl, ukwuru bẹ́, ma wọ kw'uwa Ubinọkpaabyi usi ẹyaakha ch'ifor sẹ ọnạng-ẹ k'okpe kw'uwa ọrạbhọ k'nnwọkka Ẹsau.<verse eid="GEN 35:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 35:8" />Wa Dẹbọra kw'ode ọrạrạkha kw'Rẹbẹka ope, abẹ annọhng-ẹ k'ichirin ch'oak ch'ining k'efhoncho ch'Bẹtẹl. Ma wọ abẹ ayeri ibyi nnọ Allọn-Bakut.<verse eid="GEN 35:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 35:9" />Masẹ Jekọb ubin k'Padan-Aram ukwuna, Ubinọkpaabyi ọbạra uyin abẹ, udi-ẹ. <verse eid="GEN 35:9" /><verse number="10" style="v" sid="GEN 35:10" />Oben-ẹ bẹ́, “Ọma akpen Jekọb, okhenka, dạkhẹ Jekọb mákpena, n'akpena Israẹl.” Ma wọ Ubinọkpaabyi ukpuẹ-ẹ Israẹl.<verse eid="GEN 35:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 35:11" />Ọvaar Ubinọkpaabyi ọbạra oben-ẹ bẹ́, “Amma wọ nde Ubinọkpaabyi kw'Ẹfa phyibh; fhon iva k'ọsaabh. Ẹkhạma, ọttạra ẹkhạma ch'nkhạma m'ibina ma ntaak sọ, avaar m'abạra abina k'iva piva pọ. <verse eid="GEN 35:11" /><verse number="12" style="v" sid="GEN 35:12" />Isisek nnọ s'uwa nnạngẹ Abraham ọttạra Isaak, ẹrọ m'nnạng-ọ, asẹma rọ M'mbạra ntte sẹ ọbọhk nnạng ofhon pfọ.” <verse eid="GEN 35:12" /><verse number="13" style="v" sid="GEN 35:13" />Masẹ Ubinọkpaabyi kk'idik nnọ ọkpaakha phyibh, ubina urik Jekọb ma, ofona.<verse eid="GEN 35:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 35:14" />Ma wọ Jekọb ọtạk ẹta ofho ma ibyi nnọ s'Ubinọkpaabyi kk'idik ọkpaakha ọnạng-ẹ, usi ẹnạnga ebyengachẹ mạma, ọbạra ọtạkha ana obyenga ma ẹta njọ. <verse eid="GEN 35:14" /><verse number="15" style="v" sid="GEN 35:15" />Wa Jekọb oyeri ibyi nnọ s'Ubinọkpaabyi ọkpaakhẹ abẹ idik, Bẹtẹl.<verse eid="GEN 35:15" /></para>
  <para style="s1">Obo kw'Rachẹl ọttạra Isaak</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 35:16" />Wa abẹ abin osenga k'Bẹtẹl n'afona k'ẹkhạma Ẹphrat. Masẹ abẹ akpir k'ibyi rạne ma, ọmaan ọtạma Rachẹl k'ẹfa-k'ẹfa sisi. <verse eid="GEN 35:16" /><verse number="17" style="v" sid="GEN 35:17" />Masẹ kk'iyạkhọ ọtạkha kidaam-kidaam, ikwanạng kw'n'utikh-ẹ ọmaan oben-ẹ bẹ́, “Chok ettem tọhng khiri kk'ujunung amaana adạkhẹ.” <verse eid="GEN 35:17" /><verse number="18" style="v" sid="GEN 35:18" />Masẹ ọjẹ ikpongannạm-yọhng s'n'abạra ope, okpe nnwa kwẹ, Bẹn-Oni. Okhenka, otte Jekọb ukpuẹ-ẹ Bẹnjamin.<verse eid="GEN 35:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 35:19" />Ma wọ Rachẹl ope, abẹ annọng-ẹ k'eden ch'eten k'Ẹphrat, kw'ode Bẹtẹlẹhẹm. <verse eid="GEN 35:19" /><verse number="20" style="v" sid="GEN 35:20" />Jekọb ọtạkha ẹta ofho k'epekwur ch'Rachẹl. Tạrr ukpira maa, ẹta njọ ede ẹkhọhkha ch'epekwur ch'Rachẹl.<verse eid="GEN 35:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 35:21" />Jekọb, kw'n'okpen Israẹl ofon ororo k'osenga kwẹ, ọbạra usi ibyirukhasẹ sẹ k'ukhubha kw'Migdal-Eder. <verse eid="GEN 35:21" /><verse number="22" style="v" sid="GEN 35:22" />Masẹ Israẹl urukhu ma ẹkhạma njọ, wa Reubẹn ọnwa kha ọta uyima Bilha, kw'ode oyok kw'otte abẹ. Wa Israẹl ọbhaang udik ngwọ.</para>
  <para style="b" vid="GEN 35:22" />
  <para style="m" vid="GEN 35:22">Wa Jekọb ofhonu ajunungva jobh-kamfa.<verse eid="GEN 35:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="GEN 35:23" />Ajunungva p'Lea ade:</para>
  <para style="li2" vid="GEN 35:23">Reubẹn kw'ode ocheden-nwa kw'Jekọb,</para>
  <para style="li2" vid="GEN 35:23">ọttạra Simeọn, ọttạra Lẹvi, ọttạra Juda, ọttạra Isaka, ọttạra Zẹbulun.<verse eid="GEN 35:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="GEN 35:24" />Iva p'Rachẹl ade:</para>
  <para style="li2" vid="GEN 35:24">Josẹph, ọttạra Bẹnjamin.<verse eid="GEN 35:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="GEN 35:25" />Iva p'Bilha kw'ode ọtọhmnạng kw'Rachẹl, ade:</para>
  <para style="li2" vid="GEN 35:25">Dan ọttạra Naphtali.<verse eid="GEN 35:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="GEN 35:26" />Iva p'Zilpa, kw'ode ọtọhmnạng kw'Lea ade:</para>
  <para style="li2" vid="GEN 35:26">Gad ọttạra Asha.</para>
  <para style="p" vid="GEN 35:26">Ma wọ ode ajunungva p'uwa Jekọb ofhonu k'Padan-Aram.<verse eid="GEN 35:26" /></para>
  <para style="b" />
  <para style="p">
    <verse number="27" style="v" sid="GEN 35:27" />Wa Jekọb ọkpa nnạm otor otte Isaak kha Mamrẹ, kw'ọbaang Kiriyat-Arba (kw'abẹ abạra ayeri Hẹbrọn), k'ibyi s'uwa Abraham ọttạra Isaak kk'arukha bạra. <verse eid="GEN 35:27" /><verse number="28" style="v" sid="GEN 35:28" />Phyi-phyibh wa Isaak urukhu icho arạbh sọwạnọ. <verse eid="GEN 35:28" /><verse number="29" style="v" sid="GEN 35:29" />Ma wọ wa Isaak ope k'atạm otor anạng pẹ p'kk'apua. Ẹsau ọttạra Jekọb p'ade iva pẹ annọhng-ẹ.<verse eid="GEN 35:29" /></para>
  <chapter eid="GEN 35" />
  <chapter number="36" style="c" sid="GEN 36" />
  <para style="s">Efonamma ch'Ẹsau</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 36:1" />Maa wọ ode efonamma ch'Ẹsau, kw'ọbạra okpena Edom.<verse eid="GEN 36:1" /></para>
  <para style="pi">
    <verse number="2" style="v" sid="GEN 36:2" />Wa Ẹsau ọtạk ipanạng p'abin Kenaan. Oyok wạnọ okpen Ada, kw'Ẹlọn kw'ubin Het ofhonu. Ottong ipanạng afa, okpen Oholibama, kw'Ana ofhonu. Ana wa ode nnwa kw'Zibeọn kw'ubin Hiv. <verse eid="GEN 36:2" /><verse number="3" style="v" sid="GEN 36:3" />Ottong ipanạng attaan okpen Basẹmat, kw'Ishimayẹl kw'ọbạra ode nnwọkka kw'Nẹbayọt ofhonu.<verse eid="GEN 36:3" /></para>
  <para style="pi">
    <verse number="4" style="v" sid="GEN 36:4" />Ada wa ọmaanẹ Ẹliphaz ọnạng Ẹsau, Basẹmat ọmaan Reuẹl. <verse eid="GEN 36:4" /><verse number="5" style="v" sid="GEN 36:5" />Oholibama ọmaan Jeush ọttạra Jalam, ọttạra Kora. Ma wọ ode iva p'uwa abẹ amaanẹ anạng Ẹsau k'ẹkhạma ch'Kenaan.<verse eid="GEN 36:5" /></para>
  <para style="pi">
    <verse number="6" style="v" sid="GEN 36:6" />Ẹsau ọtạk ipanạng pẹ, ọttạra iva pẹ, ọttạra anạng p'ọchọhm kwẹ phyibh, ọttạra itirakpo pyẹ, ọttạra nten sẹ, ọttạra ẹkhạma phyi-phyibh ch'kk'usia k'Kenaan, ubina urik nnwọkka Jekọb, ọtta uruk k'ibyi s'ibhir-ubhir. <verse eid="GEN 36:6" /><verse number="7" style="v" sid="GEN 36:7" />Wa isisek s'abẹma anạng afa arukhu dạkhẹ bẹ níbenga, ukwuru itirakpo py'abẹ, ọttạra s'ẹkhaama chabẹ n'ẹsaabhẹ eyongu oche kw'abẹma anạng afa nạn adạkhẹ ibyi rạnẹ mákke aruk. <verse eid="GEN 36:7" /><verse number="8" style="v" sid="GEN 36:8" />Ma wọ Ẹsau kw'ọbạra okpena Edom ọta usi uruk kwẹ k'ukhubha kw'akpecho p'Seir.<verse eid="GEN 36:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 36:9" />Maa wọ ode efonamma ch'Ẹsau, kw'ode otte kwididen kw'anạng p'Edom, k'ukhubha kw'akpecho p'Seir.<verse eid="GEN 36:9" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="10" style="v" sid="GEN 36:10" />Ma wọ ode ache p'ajunungva p'Ẹsau:</para>
  <para style="li2" vid="GEN 36:10">Ẹliphaz, kw'Ada ọmaanẹ,</para>
  <para style="li2" vid="GEN 36:10">ọttạra Reuẹl, kw'Basẹmat ọmaanẹ.<verse eid="GEN 36:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="GEN 36:11" />Iva p'Ẹliphaz ofhonu ade: Teman, ọttạra Ọma, ọttạra Zepho, ọttạra Gatam, ọttạra Kenaz. <verse eid="GEN 36:11" /><verse number="12" style="v" sid="GEN 36:12" />Ẹliphaz kw'Ẹsau ofhonu wa ọbạra ọkhaama oyok kw'okpen Timna, kw'ọmaan-ẹ nnwa kw'okpen Amalẹk. Ada kw'uwa ode ikwanạng kw'Ẹsau wọ wa ode ọkka kwididen kw'iva mbọ phyibh.<verse eid="GEN 36:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="GEN 36:13" />Iva p'Reuẹl ade: Nahat, ọttạra Zẹra, ọttạra Shama, ọttạra Miza. Basẹmat kw'ode ikwanạng kw'Ẹsau wọ wa ode ọkka kwididen kw'iva mbọ phyibh.<verse eid="GEN 36:13" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="14" style="v" sid="GEN 36:14" />Iva p'Oholibama kw'ode nnwa kw'Ana, kw'Zibeọn ofhonu, p'uwa ọmaanẹ ọnạng Ẹsau ade: Jeush, ọttạra Jalam, ọttạra Kọra.<verse eid="GEN 36:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 36:15" />Maa wọ ode avaar p'efonamma ch'Ẹsau, p'abin k'ẹnạmma ch'Ẹliphaz, kw'ode ocheden-nwa kw'Ẹsau ofhonu. Iva mbọ wa ade: Teman, ọttạra Ọma, ọttạra Zepho, ọttạra Kenaz,<verse eid="GEN 36:15" /></para>
  <para style="li2">
    <verse number="16" style="v" sid="GEN 36:16" />ọttạra Kora, ọttạra Gatam, ọttạra Amalẹk. Anạng mba bọ p'uwa atim mvaar k'ẹnạmma ch'Ẹliphaz k'Edom. Ada wọ wa ode ọkka kwididen kw'abẹ phyibh.<verse eid="GEN 36:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="GEN 36:17" />Avaar p'abin k'enạmma ch'Reuẹl kw'ode nnwa kw'Ẹsau ofhonu k'ẹkhạma ch'Edom ade: Nahat, ọttạra Zẹra, ọttạra Shama, ọttạra Miza. Basẹmat wọ wa ode ọkka kwideden kw'avaar mbọ phyibh.<verse eid="GEN 36:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="GEN 36:18" />Avaar p'abin k'ntaak s'Oholibama, kw'ode nnwa ikwanạng kw'Ẹsau, ọbạra ode nnwa kw'Ana, ade: Jeush, ọttạra Jalam, ọttạra Kọra.<verse eid="GEN 36:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 36:19" />Ma wọ ode iva p'Ẹsau, kw'ọbạra okpena Edom, ọttạra avaar p'nnạmma sabẹ phyibh.<verse eid="GEN 36:19" /></para>
  <para style="b" />
  <para style="s">Enạmma ch'Seir.</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 36:20" />Achedennạng p'arukhu k'ukhubha ngwọ, ade iva p'Seir kw'ubin k'ẹnạmma ch'Họr. Abẹ ade:</para>
  <para style="li1" vid="GEN 36:20">Lotan, ọttạra Shobal, ọttạra Zibeọn, ọttạra Ana,<verse eid="GEN 36:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="GEN 36:21" />ọttạra Dishọn, ọttạra Ẹzẹr, ọttạra Dishan. Ma wọ ode avaar p'abaHọr, p'abin k'ẹnạmma ch'Seir k'Edom.<verse eid="GEN 36:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="GEN 36:22" />Wa iva p'Lotan ade: Họri, ọttạra Homam. Timna ẹma wa ode nnwọkka kw'ikwanạng kw'Lotan.<verse eid="GEN 36:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="GEN 36:23" />Wa iva p'Shobal ade: Alvan, ọttạra Manahat, ọttạra Ebal, ọttạra Shepho, ọttạra Ọnam.<verse eid="GEN 36:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="GEN 36:24" />Zibeọn ẹma wa ọkhaam iva afa, p'ade: Aiya, ọttạra Ana. Ana nwọ wọ wa, uchi eden ọta ose asi k'ibyi s'owor, masẹ n'okkeri mmaam s'otte kwẹ, Zibeọn.<verse eid="GEN 36:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="GEN 36:25" />Wa, Ana ọkhaam iva afa p'ade: Dishọn, kw'ode ujunung, ọttạra Oholibama kw'ode ikwanạng.<verse eid="GEN 36:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="GEN 36:26" />Iva p'Dishọn wa abẹ ade: Hẹmdan, ọttạra Ẹshban, ọttạra Itiran, ọttạra Keran.<verse eid="GEN 36:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="GEN 36:27" />Iva p'Ẹzẹr ade: Bilhan, ọttạra Zaavan, ọttạra Akan.<verse eid="GEN 36:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="GEN 36:28" />Iva p'Dishan ade: Uz, ọttara Aran.<verse eid="GEN 36:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="GEN 36:29" />Ma wọ ode avaar p'Họr: Lotan, ọttạra Shobal, ọttạra Zibeọn, ọttạra Ana, <verse eid="GEN 36:29" /><verse number="30" style="v" sid="GEN 36:30" />ọttạra Dishọn, ọttạra Ẹzẹr, ọttạra Dishan, k'nnạmma k'nnạmma k'Seir.<verse eid="GEN 36:30" /></para>
  <para style="s">Avaarnạng p'Edom.</para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 36:31" />Okpe kw'uwa anạng p'Israẹl nạn avaar tạm nakhaama, avaar p'uwa adạbhẹ Edom, ade:<verse eid="GEN 36:31" /></para>
  <para style="li1">
    <verse number="32" style="v" sid="GEN 36:32" />Bẹla kw'ode nnwa kw'Beor wa ọdạbhẹ Edom. Wa, ọvaarfhon kwẹ okpen Dinhaba.<verse eid="GEN 36:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="GEN 36:33" />Masẹ Bẹla ope, Jobab kw'ode nnwa kw'Zẹra kw'ubin Bozra, n'ukwu ọdạbh ẹvaar.<verse eid="GEN 36:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="GEN 36:34" />Masẹ Jobab ope, Husham kw'ubin k'ukhubha kw'Teman, n'ukwu ọdạbh ẹvaar.<verse eid="GEN 36:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="GEN 36:35" />Masẹ Husham ope, Hadad kw'ode nnwa kw'Bẹdad, ukwu ọdabh ẹvaar. Hadad nwọ wọ wa ofon k'Moab ọta urima anạng p'Midiyan abẹ. Ẹma wa, ọvaarfhon kwẹ okpen Avit.<verse eid="GEN 36:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="GEN 36:36" />Masẹ Hadad ope, Samla kw'ubin Masareka, ukwu ọdabh ẹvaar.<verse eid="GEN 36:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="GEN 36:37" />Masẹ Samla ope, Shaul kw'ubin Rehobot, kw'uning ọbaanga ọraanga, n'ukwu ọdạbh ẹvaar.<verse eid="GEN 36:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="GEN 36:38" />Masẹ Shaul ope, Baal-Hanan, kw'ode nnwa kw'Akabọ, ukwu ọdạbh ẹvạar.<verse eid="GEN 36:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="GEN 36:39" />Masẹ Baal-Hanan nnwa kw'Akabọ ope, Hadad ukwu ọdạbh ẹvaar. Ẹma wa, ọvaarfhon kwẹ okpen Pau. Ikwanạng kwẹ kw'ode nnwa kw'Matạrẹd, okpen Mehetabẹl. Matạrẹd wa ode nnwa kw'Me-Zahab.<verse eid="GEN 36:39" /></para>
  <para style="b" />
  <para style="p">
    <verse number="40" style="v" sid="GEN 36:40" />Ma wọ ode avaarnạng p'efonamma ch'Ẹsau, ọttạra ache pabẹ, k'nnạmma sabẹ, ator k'oche kw'abẹ arukhu. Abẹ ade:</para>
  <para style="li1" vid="GEN 36:40">Timna, ọttạra Alva, ọttạra Jetẹt,<verse eid="GEN 36:40" /></para>
  <para style="li1">
    <verse number="41" style="v" sid="GEN 36:41" />ọttạra Oholibama, ọttạra Ẹla, ọttạra Pinọn, <verse eid="GEN 36:41" /><verse number="42" style="v" sid="GEN 36:42" />ọttạra Kenaz, ọttạra Teman, ọttạra Mibzar, <verse eid="GEN 36:42" /><verse number="43" style="v" sid="GEN 36:43" />ọttạra Magdiẹl, ọttạra Iram. Avaar mbọ bọ wa adạbhẹ anạng p'Edom, ator k'oche kw'uwa abẹ arukhu ma isisek nnọ.</para>
  <para style="p" vid="GEN 36:43">Wa Ẹsau wọ ode otte kwididen kw'anạng p'Edom.<verse eid="GEN 36:43" /></para>
  <chapter eid="GEN 36" />
  <chapter number="37" style="c" sid="GEN 37" />
  <para style="s1">Adachen p'Josẹph ọttaar</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 37:1" />Wa Jekọb urukhu k'ofon kw'otte kwẹ kk'urukha, kw'ode ofhon kw'Kenaan.<verse eid="GEN 37:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 37:2" />Ma wọ ode efonamma ch'Jekọb. K'okpe kw'uwa Josẹph ode icho chikhamfa, wa n'ọtwạn ivotte pẹ abẹ, p'ade iva p'Bilha, ọttạra p'Zilpa abẹ akkeri nten s'otte. Wa, Josẹph n'ukwu oponga ivotte ọnạng otte, ukwuru idik-pyibha sabẹ n'asi.<verse eid="GEN 37:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 37:3" />K'ikhana s'iva p'Israẹl ofhonu, Josẹph wọ ọdaakhẹ otte ọtạm ọyọhnga iva mbọkha, ukwuru s'uwa ofhon-ẹ k'atạm. Osenga ma, n'ọbọhra ọnọhma wuraam kw'ope akpokha, ọnạng-ẹ. <verse eid="GEN 37:3" /><verse number="4" style="v" sid="GEN 37:4" />Masẹ ivotte ase bẹ́, Josẹph ọdaakhẹ otte idik ọyọhnga abẹma, abẹ awunẹ tạrr abẹ dạk khẹ ititikha ikkasẹ k'nanạng.<verse eid="GEN 37:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 37:5" />Wa Josẹph ọttaar idachen, masẹ ọkpaakhẹ ivotte idachen nnọ, abẹ adẹ-ẹ awun-uwuna. <verse eid="GEN 37:5" /><verse number="6" style="v" sid="GEN 37:6" />Ukwu oben bẹ bẹ́, “Totokhạn, akhọhmọ itọhng, abhaanga idachen s'nttaar. <verse eid="GEN 37:6" /><verse number="7" style="v" sid="GEN 37:7" />Nttaar s'anning k'owonu n'andạbh arasẹ-khe, n'ns-ose nse s'ekhe chaam n'ebe idumsẹ, n'egoru ẹyọhnga akhẹ pabạnga. Akhẹ pabạnga n'abaabhẹ chaam age ngekha, apyẹ itwunga ncho inạng ekhe chaam ikpukpobha.”<verse eid="GEN 37:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 37:8" />Ivotte pẹ abhin-ẹ bẹ́, “Okhemma, k'akhọ kh'ẹkka, n'ode bẹ́, amạna mba bạra anninga isekh-isek kwọ sa? Ọma n'akkẹ k'udik ọkka bẹ́, ọma wọ n'abạra adạbh mạna yeri?” Ma wọ, abẹ adiẹ-ẹ awun-uwuna, ukwuru idachen sẹ, ọttạra idik s'kk'bẹ ọkpaakha.<verse eid="GEN 37:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 37:9" />Wa Josẹph ọbạra ọttaara idachen idwạkh-ọdwạk, ọtạkha sẹ ọkpaak ivotte pẹ, ọbẹ. “Abạnga akhọm-m ithọng, khiri kk'idachen idwạkh-ọdwạk nttaara e. Ẹkpa nja, n'nse s'ududon, ọttạra ophye, ọttạra ndudoru jobhkawạnọ n'itwunga ncho inạng-m ikpukpobha.”<verse eid="GEN 37:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 37:10" />Masẹ Josẹph ọbạra ọkpaak otte idachen s'ọttaar o, otte ọtạbh-ẹ, ọbạra ọbạbh-ẹ bẹ́, “Bạng idachen khira rọ s'attaar ma? N'ode bẹ́, amma, ọttạra akka, ọttạra ivotte pọ m'antwunga ncho samạna, anạng ọma ikpukpobha o?” <verse eid="GEN 37:10" /><verse number="11" style="v" sid="GEN 37:11" />Ma wọ, ivotte p'Josẹph n'akhaam ottemma Josẹph abẹ, okhenka, Jekọb, kw'ode otte kwabẹ, otạk idik nnọ oge k'ettem.<verse eid="GEN 37:11" /></para>
  <para style="s">Ivotte p'Josẹph akpẹ-ẹ anạng anạng p'Ijip</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 37:12" />K'iwu mạnna jạnẹ, ivotte p'Josẹph atim nten s'otte kwabẹ afona bẹ́, ita ichi ekpo kha ọbaanga ofhon kw'Shẹkẹm. <verse eid="GEN 37:12" /><verse number="13" style="v" sid="GEN 37:13" />Ma wọ, Israẹl obeni Josẹph bẹ́, “Ọma asong ma bẹ́, ivatte kk'nten atima afona, ita ichi ekpo ọbaanga Shẹkẹm. Kwu, ntọhmọ ata akkeri bẹ.” Josẹph ubhina bẹ́, “Iya, aro, tọhm-m khadẹ o.”<verse eid="GEN 37:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 37:14" />Ma wọ, otte ọtọhm-ẹ k'ibyi s'ivotte aning, kha ipekhuma s'Hẹbrọn, oben-ẹ bẹ́, “Sọhng ta akkeri de ivatte ọttạra nten aning kha mororo, ọfha akwu atekh-m.” Masẹ Josẹph ukpir ka Shẹkẹm, <verse eid="GEN 37:14" /><verse number="15" style="v" sid="GEN 37:15" />ujunung wạnọ usi-ẹ oche kw'n'ottena kha ibyi s'nten n'ichi asạsaarẹ, ọbạbh-ẹ bẹ́, “N'aror mbạng?”<verse eid="GEN 37:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 37:16" />Josẹph ọpọhnẹ bẹ́, “N'nnor ivotte paam e, ma, s'm'na atibh-m ibyi sabẹ na anạng nten uchiattọhk?”<verse eid="GEN 37:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 37:17" />Ujunung nwọ ọpọhnẹ bẹ́, “Abẹ kk'abina mama-e, Wạra mmang sabẹ abeni ayok bẹ́, ‘Tte amfona kha Dọtan.’ ”</para>
  <para style="p" vid="GEN 37:17">Ma wọ, Josẹph ofon okhebha ivotte k'ibyi s'ifor kha Dọtan.<verse eid="GEN 37:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 37:18" />Masẹ abẹ ase-ẹ eden-ibhir, brasẹ n'ukpir k'ibyi sabẹ aning, abẹ kk'attọhna phyibh k'oche kw'abẹ ma afhẹ-ẹ.<verse eid="GEN 37:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 37:19" />Abẹ abhạkhẹ aben ayok bẹ, “Akker e, ọttaar adachen nwọ ukwuma e! <verse eid="GEN 37:19" /><verse number="20" style="v" sid="GEN 37:20" />Akwu, amfhẹ-ẹ, ammạrẹ k'ipekhuma rạnẹ ma, ọfha de ammạn, anta amkpaak otte kwamạna bẹ́, ẹkpaten jạnẹ khẹ ichia, ọfha anninga ma anse oche kwa adachen mbọ pẹ m'iyin k'eden.”<verse eid="GEN 37:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 37:21" />Okhenka, okpe kw'nwotte kwabẹ kwididen, kw'okpen Reubẹn ọbhaang udik ngwọ, oror eden k'oche kw'm'ọkkaanẹ Josẹph k'abẹ k'mbọhk, ukwu oben bẹ́, “Mma e, tte nạng-ẹ fhu-fhọ amfhọ. <verse eid="GEN 37:21" /><verse number="22" style="v" sid="GEN 37:22" />Tte anạngẹ isẹ rạnẹ-rạnẹ ambyeng. Tte ankhenka ammạr-ẹ ma ipekhuma nna s'ibyi s'owor, okhenka, abạnga ọnạng k'afhọ o.” Reubẹn ọkpaakhẹ ọfha osenga ma, ọkkaana akpen p'Josẹph, ọfha ọbạra utim-ẹ okkena otte kwabẹ.<verse eid="GEN 37:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 37:23" />Ma Josẹph ukpir k'ibyi s'ivotte aning, abẹ avạkh-ẹ awạra ọnọhma jibhada nwọ kw'ope akpokha kw'oge. <verse eid="GEN 37:23" /><verse number="24" style="v" sid="GEN 37:24" />Abẹ atạkh-ẹ abhạrẹ k'ipekhuma s'asi nạn ade.<verse eid="GEN 37:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 37:25" />Masẹ abẹ aning ẹyạr bẹẹ́, abẹ achi ọttọhk, abẹ n'adir achen akkeri kha oro, abẹ ase ikhaana s'anạng p'Ishimayẹl p'abin ka ofhon kw'Gilead akwu. Akamẹl pabẹ itọhk ekpo py'erebhi iruk k'ukhira-k'ukhira, py'abẹ atim n'afona k'ofhon kw'Ijip.<verse eid="GEN 37:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 37:26" />Ma wọ, Juda n'ọbạbhọ ivotte pẹ bẹ́, “Ma, bạng ọttọhk vọ ode iru samạna de amfhọ nwotte kwamạna antạkha obo kwẹ andubh-o? <verse eid="GEN 37:26" /><verse number="27" style="v" sid="GEN 37:27" />Akwu amkpẹ-ẹ annạng anạng mba p'Ishimayẹl, tte nạng-ẹ amfhọ, kidam-kidaam, ẹma ode nwotte kwạmạna, kw'isẹ rạnẹ isi mạna.” Ma wọ, ivọtte phyibh acher udik kw'Reubẹn ọkpaakhẹ.<verse eid="GEN 37:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 37:28" />Masẹ aseng-mphya mbọ p'Ishimayẹl, p'abạra ade anạng p'Midiyan n'aben bẹ aseng o, ivotte p'Josẹph atta areng-ẹ k'ipekhuma sabẹ kk'ẹ abhạra, akpẹ-ẹ anạng aseng-mphya mbọ k'ashẹkẹl ẹrạbh p'silva, abẹ atim'abẹ afọna k'Ijip.<verse eid="GEN 37:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 37:29" />Masẹ Reubẹn ọkpa nnạm k'ipekhuma nnọ s'wạra abẹ abhạrẹ Josẹph, dạk khẹ núsia, ọyaakhẹ ọvạra f'oge k'for. <verse eid="GEN 37:29" /><verse number="30" style="v" sid="GEN 37:30" />30 Ofona ọtta okhebha ivotte kk'ibyi sabẹ́ aning, ọkpaak bẹ bẹ́, “Nnwa nwọ dạk kha kọde, ma m'nsi yạn o?”<verse eid="GEN 37:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 37:31" />Ma wọ, abẹ n'atạk ivu jạnẹ afhọ, abẹ atạkha ọnọhma kw'Josẹph arạna ma isẹ nnọ s'ivu. <verse eid="GEN 37:31" /><verse number="32" style="v" sid="GEN 37:32" />Abẹ atima ọnọhma nwọ abhạna ata akhọkha otte kwabẹ, abẹ akpaakh-ẹ bẹ́, “Attitte, kkeri ọnọhma kw'anse. Kkeri de ode kw'nnwa kwọ wọ o.”<verse eid="GEN 37:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 37:33" />Otte utin ọnọhma nwọ, oben bẹ́, “Ọnọhma kw'nnwa kwaam wọ e! Ẹkpaten jạnẹ kk'Josẹph ichia ẹyaakh-ọyaakhẹ e.”<verse eid="GEN 37:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 37:34" />Ma wọ, Jekọb, ọyaakhẹ ọvạra f'oge k'ífor, ọtạkha ọvạra-bina oge, utima nkwuna s'nnwa kwẹ k'iwu sabhaada. <verse eid="GEN 37:34" /><verse number="35" style="v" sid="GEN 37:35" />Iva pẹ p'ajunung, ọttạra p'ipanạng phyi-phyibh akwu afokh-ẹ nttem, okhenka, Jekọb ufhum-ufhum, ọbẹ, “Mma e, atte-m ọbọhk mpe, abẹ annọhng-m ọttạra nkwuna s'nnwa kwaam e.” Ma o, otte ọgạma ẹmạng ch'nnwa.<verse eid="GEN 37:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 37:36" />Masẹ idik nnọ n'itto ma, aseng-mphya mbọ p'Ishimayẹl, p'abạra ade anạng p'Midiyan, kk'Josẹph akpua kha Ijip anạng ujunung wạnọ kw'okpen Pọtipha, kw'ode ocho kw'ajukwa p'ọvaar Phero.<verse eid="GEN 37:36" /></para>
  <chapter eid="GEN 37" />
  <chapter number="38" style="c" sid="GEN 38" />
  <para style="s">Juda ọttạra Tama</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 38:1" />K'okpe ngwọma, Juda ubina urik ivotte pẹ, ọta uruk ọttra ujunung wạnọ kw'okpen Hira, kw'ubin Adulam. <verse eid="GEN 38:1" /><verse number="2" style="v" sid="GEN 38:2" />Ma Adulam, wọ kw'uwa Juda okhebh uminanwa wạnọ kw'ọkpen Shua kw'otte ubin Kenaan, ọtạkh-ẹ k'ọbada, ọbạra uyima abẹ. <verse eid="GEN 38:2" /><verse number="3" style="v" sid="GEN 38:3" />Uminanwa nwọ ukwu utima ifhạr ọmaan ujunung nnwa, otte ukpuẹ-ẹ Ẹr.<verse eid="GEN 38:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 38:4" />Uminanwa nwọ ọbạra utima ifhạr, ọmaan ujunung ukpuẹ-ẹ Ọnan. <verse eid="GEN 38:4" /><verse number="5" style="v" sid="GEN 38:5" />Okpe kw'uwa Juda uning kha Kezib, wa uminanwa nwọ ọbạra utima ifhạr, ọmaan ujunung ọdwạkh-ọdwạk, ukpiẹ-ẹ Shẹla.<verse eid="GEN 38:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 38:6" />Masẹ iva mbọ abạrẹ, otte kwabẹ, kw'ode Juda, ọtạk ikwanạng kw'okpen Tamar, ọnạng ochedennwa kwẹ, kw'ode Ẹr, k'obada.<verse eid="GEN 38:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 38:7" />Okhenka, ẹma Ẹr, kw'ode ochedennwa kw'Juda, ode ọgbannạng k'ititikha s'Ọvaar Ubinọkpaabyi, osengama, Ọvaar Ubinọkpaabyi ọtạkha akpen pẹ.<verse eid="GEN 38:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 38:8" />Masẹ Ẹr kk'upua, Juda ukwu oben Ọnan, kw'ode nnwa kwẹ, bẹ́, “Ọbaan bẹ́, asi oche kw'ẹmmaana chamạna ede, sọhng ata ayima ikwanạng kw'nnwakka abẹ, ọfha ọmaan iva ọnạng nnwakka.” <verse eid="GEN 38:8" /><verse number="9" style="v" sid="GEN 38:9" />Okhenka, masẹ Ọnan osong bẹ́, nnwa kwidede kw'm'ubina ma ntaak s'ikwanạng kw'nwọkka, kwẹ kode. Okpe kwidede kw'uyim ikwanạng kw'nwọkka abẹ, ọja adima ọbhạrẹ k'isisek, ọfha ikwanạng nwọ nạngẹ ifhạr utim ọmaan iva ọnạng nwọkka kw'kk'upua. <verse eid="GEN 38:9" /><verse number="10" style="v" sid="GEN 38:10" />Wa udik ngwa kw'usi ma, akwẹ upyibhi k'ititikha s'Ọvaar Ubinọkpaabhyi. Osenga ma, Ọvaar Ubinọkpaabyi ọbạra ọtạkha akpen p'Ọnan.<verse eid="GEN 38:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 38:11" />Ma wọ, Juda obeni ọnyẹ kwẹ, kw'ode Tamar bẹ́, “Sọhng ata aruk k'atte k'ọchọhm masẹ opokwa, tạrr ukpira k'okpe kw'nnwa kwaam kw'ode Shẹla m'ọbạr ukpira k'oche kw'm'ọtạkha ikwanạng.” Wa obeni oche ngwọ ukwuru s'ọkkẹ bẹ́, Shẹla m'ọbạra ope oche kw'ivọkka ape. Ma wọ, Tamar ọkpa nnạm k'otte k'ochọhm.<verse eid="GEN 38:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 38:12" />Ukwu ukpira k'icho ma, ikwanạng kw'Juda, kw'ode nnwa kw'Shua ukwu ope. Wa Juda utim nkwuna s'ikwanạng nwọ kwẹ tạrr asẹ isa. Ma wọ, ẹma ọttạra oyodikkobh kwẹ, Hira, kw'ubin Adulam, abin afona kha Timna, k'ibyi sabẹ n'agwu arạkhạmaan pẹ aphyạbha.<verse eid="GEN 38:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 38:13" />Masẹ abẹ akpaak-ẹ Tamar bẹ́, “Otte-ofhon-udim n'osengkha k'eden n'ukwu k'Timna bẹ́, ukwu ọgwa arạkhạmaan pẹ aphyạbha,” <verse eid="GEN 38:13" /><verse number="14" style="v" sid="GEN 38:14" />ọwạra epokwa kpo pẹ, ọtạkha ivạra s'ide ọphyọhng-ọphyọhng ububha ititikha sẹ, ọta uninga ẹyạr k'ọkkaden kw'oten k'ofhon kw'Enaim, kw'm'asenga afona k'Timna. Wa, Tama kk'osonga bẹ, chibhi s'Shẹla kk'ọbạra k'oche kw'wạra m'ọtạkhẹ k'ọbada, wa mạnna nusia.<verse eid="GEN 38:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 38:15" />Masẹ Juda ose Tamar, ọkkẹ bẹ ọsasa wọ, ukwuru s'utim ọphyọhng ububha ititikha sẹ.<verse eid="GEN 38:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 38:16" />Wa, Juda kosóng bẹ, ikwanạng kw'nnwa kwẹ wọ, n'ojek okhebh-ẹ kha eden ukhubha, oben-ẹ bẹ, “Kwu, nnyim'abọ.” Ikwanạng kw'nnwa ọbạbh-ẹ bẹ́, “Manạng-m bạng de nyim-o abẹ o?”<verse eid="GEN 38:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 38:17" />Judah ubhin-ẹ bẹ́, “M'nnẹngi uvunwa k'mvu saam ntọhm nkken-ọ.” Ma wọ, ikwanạng kw'nnwa n'ọbạbh-ẹ bẹ, “De n'ode oche ngwọ, m'abhikh-m ọttọhk fọ, ọfha ntima tạrr ukpira k'okpe kwa m'atọhm uvunwa nwọ akken-m.”<verse eid="GEN 38:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 38:18" />Judah ọbạbh-ẹ bẹ́, “Bạng ọttọhk vọ m'mmikh-ọ ma o?” Ikwanạng kw'nnwa ubhin-ẹ bẹ́, “Ọyagba kw'age k'ẹdwạngọ kw'ọkhaam efhora chọ, ọttạra uchikwura kw'atim k'ọbọhk.” Ma wọ, Juda ọwạr ọyagba kw'oge k'ẹdwạngọ, ọttạra uchikwura kw'utim k'ọbọhk ọnạng ikwanạng kw'nnwa kwẹ brasẹ n'ocher uyim'abẹ, okponga ma, utima ifhạr.<verse eid="GEN 38:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 38:19" />Masẹ Tama ubin ma, ofona ọta ofhona ekpo py'wạra oge, ọtạkha adạkhẹ epokwa-vạra pfẹ oge.<verse eid="GEN 38:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 38:20" />Masẹ Juda n'ọtọhmọ oyodikkobh, Hira, kw'ubin Adulam, bẹ́, okkena ikwanạng nwọ uvunwa kw'm'utima obhek ekpo pyẹ k'ikwanạng nwọ k'mbọhk, wa Hira ọta ukpira ma ibyi nnọ, dạkhẹ ikwanạng nwọ nusia. <verse eid="GEN 38:20" /><verse number="21" style="v" sid="GEN 38:21" />Ma wọ, Hira n'ọbạbhọ ajunung bạnọ p'ofhon ngwọ bẹ́, “Ọsasa-kwanạng nwọ kw'wạra uning ma ọkkaden kw'Enayim ọkhaan-ọkhaan kẹnwạn?”</para>
  <para style="p" vid="GEN 38:21">Abẹ abhin-ẹ bẹ́, “Ọsasa-kwanạng wạnọ-wạnọ ma tạma nuninga.”<verse eid="GEN 38:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 38:22" />Ma wọ, Hira ọkpa nnạm okhebha Juda, ọkpaakh-ẹ bẹ́, “Amma khẹ nạnsia e. Ottong idik ifa, ajunung p'arukhu abaanga ma akpaakh-m bẹ́, ọsasa-kwanạng wạnọ-wạnọ maa ibyi nnọ tạma núninga.”<verse eid="GEN 38:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 38:23" />Osenga ma, Juda ubhina bẹ́, “Tte-ẹ ọbọhk kạkha, tte ofona ekpo mbyọ apyẹ, nạn oche ngwọ núdia, anạng m'ase mạna ẹsẹkha e. Ọma oyeni kk'asia bẹ́, kk'ọ uvunwa nnạnga bẹ́, akken-ẹ, khẹ násia.”<verse eid="GEN 38:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 38:24" />Ukwu ukpira ọttọhk masẹ aphye attaan, Juda n'ọbhaang ọbhaanga, n'ọbhaang bẹ́, Tamar kw'ode ikwanạng kw'nnwa kwẹ n'osenga ẹsasa, osenga ma, kk'ifhạr utima. Ma wọ, Juda n'ọnạngẹ ẹfa bẹ́, abẹ atwạr-ẹ ayin k'iyaan, ọfha abẹ annemi eden akkạm-ẹ ikhikhebhi.<verse eid="GEN 38:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 38:25" />Masẹ abẹ atwạr-ẹ ayin k'iyaan bẹ́, abẹ akkạm-ẹ, Tamar ọtọhm ẹkkaabha ọnạng otte-ofhon-udim, ọben bẹ́, “Ujunung kw'ọkhaam ekpo py'ntim ma, wọ oge-m ifhạr nna ma e.” Ọbạra ọttạra bẹ, “Kwu ikkeri, de m'akke atin ọnạng kw'ọkhaam ọyagba, ọttạra efhora, ọttạra uchikwura kw'ntim ma khanse.”<verse eid="GEN 38:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 38:26" />Masẹ Juda ose ekpo mbyọ ma, utin pyẹ, ukwu oben bẹ́, “Ẹma otor-otor ọyọhnga amma e, ukwuru bẹ́, wạra ọbaan bẹ́, ntạkh-ẹ nnạng nnwa kwaam kw'ode Shẹla.” Wa, Juda dạkhẹ Tamar abẹ núyima. <verse eid="GEN 38:26" /><verse number="27" style="v" sid="GEN 38:27" />Masẹ okpe ukpir kw'm'ọmaan, ukwu ode bẹ́, ajunungva afa bọ p'aning-ẹ k'ẹfhạr.<verse eid="GEN 38:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 38:28" />Masẹ n'okhonga bẹ́, ọmaan, nnwa wạnọ utima ọbọhk uchi eden, ikwanạng kw'n'utik anạng ọmaan ọtạkha ẹvạra-dikhi ekhora, ọkpẹ-ẹ k'ọbọhk, oben bẹ́, “Oyok nwa wọ uchi eden uyin.” <verse eid="GEN 38:28" /><verse number="29" style="v" sid="GEN 38:29" />Masẹ nnwa nwọ n'ọbạra ọkpa nnạm k'obọhk oge k'ẹtaanga, nwọkka uyin, ikwanạng kw'n'utik anạng ọmaan n'obeni bẹ́, “Kw'uyini bẹ, n'aseng oche ngwama, ayin!” Abẹ asenga ma akpẹ-ẹ Pẹrẹz.<verse eid="GEN 38:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 38:30" />Okpe núbhira, nwọkka nwọkha kw'abẹ akpa ẹvạrakpa khora uyin, abẹ akpẹ-ẹ Zẹra.<verse eid="GEN 38:30" /></para>
  <chapter eid="GEN 38" />
  <chapter number="39" style="c" sid="GEN 39" />
  <para style="s1">Josẹph ọttạra ikwanạng kw'Pọtipha</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 39:1" />Ma o, masẹ anạng p'Ishimayẹl kk'Josẹph atima akpira k'Ijip, abẹ akpe-ẹ anạng Pọtipha, kw'ode ocho kw'anạng p'n'akkeri udimpa kw'ọvaar Phero.<verse eid="GEN 39:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 39:2" />Masẹ Josẹph urukhu ọttạra aro kwẹ k'Ijip, wa Ọvaar Ubinọkpaabyi uning abẹ, ọbạra udi-ẹ k'idik phyibh. <verse eid="GEN 39:2" /><verse number="3" style="v" sid="GEN 39:3" />Masẹ aro kwẹ, Pọtipha n'ose bẹ́, Ọvaar Ubinọkpaabyi uning Josẹph abẹ, ọbạra ọse bẹ́, ubinọkpaabyi ọnang-ẹ uwujibh, udi-ẹ k'idik phyibh, <verse eid="GEN 39:3" /><verse number="4" style="v" sid="GEN 39:4" />Josẹph n'ọdaakh-ẹ idik tạrr n'ọtạkh-ẹ ochok masẹ ọtọhmnạng kwẹ oyeni. Ọtạkha ẹchọhmfhạr chẹ, ọttạra ọttọhk fidede pf'ọkhaam ọnạng-ẹ bẹ, okkeri. <verse eid="GEN 39:4" /><verse number="5" style="v" sid="GEN 39:5" />Tạma k'okpe kw'Pọtipha otte ẹchọhmfhạr chẹ, ọttạra ekpo pẹ phyibh ọbọhk ọnạng Josẹph bẹ́, okkeri, wa Ubinọkpaabyi oseng Josẹph abẹ odo ẹchọhmfhạr ch'Pọtifa k'idik phyibh. <verse eid="GEN 39:5" /><verse number="6" style="v" sid="GEN 39:6" />Ma wọ, udik kw'uwa ọbạra ọyọhnọ Pọtipha ettem kode, oyonga uchiattọhk pfẹ m'uchi, s'kk'idik sidede ọbọhk uttia ọnạng Josẹph.</para>
  <para style="p" vid="GEN 39:6">Josẹph wa ujibhi idikkobh, ọbạra ufu k'ifor <char style="it">bẹ, gbạng.</char> <verse eid="GEN 39:6" /><verse number="7" style="v" sid="GEN 39:7" />K'okpe ma, ikwanạng kw'aro kwẹ ọtạm Josẹph adạdaakha-chen kạkkeri, ukwu oben-ẹ bẹ́, “Kw'ayim-m abẹ kadẹ o!”<verse eid="GEN 39:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 39:8" />Josẹph ufhum, oben ikwanạng kw'aro kwẹ bẹ, “Mma e, aro kwaam kk'ẹchọhmfhạr chẹ phyibh ọbọhk uttia ọnạng-m bẹ́, nkkeri. Udik gwạnọ-gwạnọ kw'ọbạra ọkpaakh-m dạk kóde. <verse eid="GEN 39:8" /><verse number="9" style="v" sid="GEN 39:9" />Ọnạng ọdwạkh-ọdwạk kw'ọkhaam ẹfa ọyọhnga amma ma ọchọhm ngwa kóde. Aro kwaam khaam ọttọhk vunọ-vunọ nọrạma, oyonga ọma, ukwuru bẹ, ade ikwanạng kwẹ. Amma m'nsi yạn nsi igbaan demasẹ nna, mpyibh k'ititikha s'Ubinọkpaabyi o?” <verse eid="GEN 39:9" /><verse number="10" style="v" sid="GEN 39:10" />Chibhi s'ikwanạng nwa ọphyaangẹ Josẹph ẹmma k'iwu chidede bẹ́, uyim-ẹ abẹ, Josẹph nochera, nọbạra ochera bẹ́, ọgbaara ikwanạng nwọ k'ifor.<verse eid="GEN 39:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 39:11" />K'iwu mạnna jạnẹ, Josẹph ofon bẹ́, ọta usi ọtọhm pfẹ k'ọchọhm kw'aro kwẹ. Ma iwu njọ, wa ọtohmnạng ọdwạkh-ọdwạk k'ọchọhm ẹtaanga kode. <verse eid="GEN 39:11" /><verse number="12" style="v" sid="GEN 39:12" />Ikwanạng kw'Pọtifa ọvạkha Josẹph k'ẹvạrakpa ch'ọpabh, ọbẹ, “Kwu ayima abamẹ!” Okhenka, Josẹph otte ọnọhma kwẹ ọbọhk ọnạng-ẹ, ọrạbh uyin k'iyaan.<verse eid="GEN 39:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 39:13" />Masẹ ikwanạng kw'Pọtifa ose bẹ́, Josẹph kk'ọrạbha uyin k'iyaan, urik ọnọhma kwẹ k'akhẹ k'ọbọhk, <verse eid="GEN 39:13" /><verse number="14" style="v" sid="GEN 39:14" />n'oyeri atọhmnạng pẹ, oben bẹ bẹ́, “Abạnga kk'asia, udim kwaam utim oHiburu-nạng nwa ukwu ma bẹ́, ukwu ọnạng mạna ọkpạrsia-dik. Ọnwa okhebh-m kha ẹmangọ ẹtaanga bẹ́, uyima abamẹ k'ẹfa, nkhenka njẹ egạma. <verse eid="GEN 39:14" /><verse number="15" style="v" sid="GEN 39:15" />Masẹ njẹ ẹgạma njọ k'ẹrạng-k'ẹrạng o, ma wọ n'ọrạbhọ uyin k'iyaan urik ọnọhma kwẹ ma.”<verse eid="GEN 39:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 39:16" />Ikwanạng nwọ ọtạkha ọnọhma nwọ ochok, tạrr udim kwẹ ukwuna kw'ọbạra ode aro kw'Josẹph. <verse eid="GEN 39:16" /><verse number="17" style="v" sid="GEN 39:17" />Ọtạkha udik ngwọ ọkpaakh-ẹ, ọbẹ, “OHiburu-nạng nwọ kw'atim akkena mạna ma, wạra ọnwa okhebh-m kha ẹmangọ ẹtaanga bẹ́, uyima abamẹ k'ẹfa. <verse eid="GEN 39:17" /><verse number="18" style="v" sid="GEN 39:18" />Masẹ ọbhaang sa n'n'njẹ ẹgạma nnor ẹkkaana, ma wọ ọrạbhọ urik ọnọhma kwẹ kha akhaam k'mbọhk.”<verse eid="GEN 39:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 39:19" />Masẹ Pọtipha ọbhaang udik ngwọ kw'ikwanạng kwẹ ọkpaakh-ẹ otena k'oche kw'Josẹph usi-ẹ, ettem ipyibh-ẹ. <verse eid="GEN 39:19" /><verse number="20" style="v" sid="GEN 39:20" />Ma wọ, ọnạngẹ ẹfa bẹ, abẹ age Josẹph mgbakkọhbhọ k'ọgbakkọhbhọ-ter kw'abẹ akpạk agbakkọhbhọ p'ọvaar Phero.</para>
  <para style="p" vid="GEN 39:20">Okhenka, masẹ Josẹph uning ma ọgbakkọhbhọ-ter, <verse eid="GEN 39:20" /><verse number="21" style="v" sid="GEN 39:21" />wa Ọvaar Ubinọkpaabyi uning Josẹph abẹ, ọkkaan-ẹ, ọnạng-ẹ ọphyaam k'ititikha s'ocho kw'anạng p'n'akkeri agbakkọhbhọ. <verse eid="GEN 39:21" /><verse number="22" style="v" sid="GEN 39:22" />Osenga ma, usi Josẹph odecho kw'agbakkọhbhọ phyibh, ọbạra ọnạng-ẹ ẹfa otena k'udik kwidede kw'abẹ m'asi ma ọgbakkọhbhọ-ter. <verse eid="GEN 39:22" /><verse number="23" style="v" sid="GEN 39:23" />Ocho kw'anạng p'n'akkeri agbakkọhbhọ mbọ osenga ma, ọrạbha ichen k'idik s'oge Josẹph k'mbọhk, ukwuru s'Ovaar Ubinọkpaabyi uning Josẹph abẹ, ọbạra usi udik kwidede ọmạm ọnạng-ẹ.<verse eid="GEN 39:23" /></para>
  <chapter eid="GEN 39" />
  <chapter number="40" style="c" sid="GEN 40" />
  <para style="s1">Josẹph usi ẹyaakha ch'adachen p'agbakkọhbhọ attaar</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 40:1" />K'okpe mạnna gwạnọ, wa ọnạng kw'n'ọnạng ọvaarnạng kw'Ijip atwuk, ọttạra ọnạng kw'n'usi uchiattọhk pfẹ, apini aro kwabẹ, kw'ode Phero, kw'ode ọvaarnạng kw'Ijip. <verse eid="GEN 40:1" /><verse number="2" style="v" sid="GEN 40:2" />Wa Phero ọdwạkh-ẹ otena atọhmnạng mbọ pẹ afa, p'ade ocho kw'anạng p'n'anạng ọvaarnạng atwuk, ọttạra ocho kw'anạng p'n'asi uchiattọhk anạng ọvaarnạng. <verse eid="GEN 40:2" /><verse number="3" style="v" sid="GEN 40:3" />Wa ọtạk bẹ ọta ọkpạkha k'ọchọhm kw'ochonạng kw'akker-agbakkọhbhọ, k'ọgbakkọhbhọ-ter ngwọ gwạnọ kw'abẹ akpạkhẹ Josẹph. <verse eid="GEN 40:3" /><verse number="4" style="v" sid="GEN 40:4" />Odennạng kw'ọgbakkọhbhọ-ter ngwọ otte bẹ ọbọhk ọnạng Josẹph, Josẹph okkeri bẹ.</para>
  <para style="p" vid="GEN 40:4">Masẹ anạng mbọ afa k'mgbakkọhbhọ ayima k'okpe ma, <verse eid="GEN 40:4" /><verse number="5" style="v" sid="GEN 40:5" />k'irunguwu jạnẹ, ajunung mba afa, oyok kw'n'ọnạng ọvaarnạng kw'Ijip atwuk, ọttạra oyok kw'n'usi uchiattọhk, p'abẹ akpạk k'ọgbakkọhbhọ-ter, ọnạng-ọnạng ọttaar idachen s'ikhaam ẹyaakha ch'ede nkhạmọ kha nnọ s'oyok ọttaar.<verse eid="GEN 40:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 40:6" />Masẹ Josẹph ukwu k'ekpebha, n'ose bẹ́, abẹ aning ikwosi-ikwosi. <verse eid="GEN 40:6" /><verse number="7" style="v" sid="GEN 40:7" />Ma wọ n'ọbạbhọ atọhmnạng p'Phero p'abẹ atwạnọ ayima mgbakkọhbhọ, k'ọchọhm kw'otte kwẹ bẹ́, “Ode yạn kw'chemma nttem iphyaangẹ bạnga ẹmma oche ngwa o?”<verse eid="GEN 40:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 40:8" />Abẹ apọhn-ẹ bẹ́, “Amạna mba anạng afa anttaar adachen. Okhenka, ọnạng kw'm'usi ẹyaakha ch'adachen mbọ ọnạng mạna kòde.”</para>
  <para style="p" vid="GEN 40:8">Josẹph n'oben-ẹ bẹ́, “Atotokhạn, akpaakh-m adachen pabạnga, Ubinọkpaabyi wọ n'ọnạng ẹyaakha ch'adachen phyibh e.”<verse eid="GEN 40:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 40:9" />Ma wọ ocho kw'anạng p'n'anạng ọvaarnạng atwuk, ọkpaakhẹ Josẹph idachen sẹ, ọbẹ́, “Amma nttaar s'ichi ch'grep ebe-m k'ititikha. <verse eid="GEN 40:9" /><verse number="10" style="v" sid="GEN 40:10" />Ichi njọ ch'grep ẹkhaam abọhkha ataan. Masẹ abọhkha mbọ ayini agbo <char style="it">bẹ ẹ</char>, ẹtạma ayoyo sisi, ẹyạm adwuk p'agrep, apyẹ ẹbhạkhẹ ekhor. <verse eid="GEN 40:10" /><verse number="11" style="v" sid="GEN 40:11" />K'ọbọhk kwaam, ntim nkkọbh kw'ọvaar Phero, kw'mmyạn adwuk mbọ p'grep nge, ntạkha nnạng Phero.”<verse eid="GEN 40:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 40:12" />Ma wọ, Josẹph ọnang-ẹ ẹyaakha bẹ́, “Achibọhkha mbọ attaan ayini iwu ittaan. <verse eid="GEN 40:12" /><verse number="13" style="v" sid="GEN 40:13" />K'iwu ittaan k'oro, Phero m'oreng-ọ k'mgbakkọhbhọ, ọbạra ọnạng-ọ ininga chọ, bạra n'anạng-ẹ atwuk k'oche kw'uwa n'acheden asi. <verse eid="GEN 40:13" /><verse number="14" style="v" sid="GEN 40:14" />Okhenka, okpe kw'idik m'ijibh inạng-ọ, totokhạn khaam kha bonu, kpaak Phero bẹ́, amma nning kha, ọfha ọrạbh-m k'mgbakkọhbhọ nna. <verse eid="GEN 40:14" /><verse number="15" style="v" sid="GEN 40:15" />Amma wa, abẹ avạkh-m k'ẹfa k'isek s'aHiburu atima akwu maa ofhon ngwa. Masẹ mbạra nninga maa ofhon ngwa, amma udik gwạnọ-gwạnọ nạnja, kw'wạra m'nsenga akwẹ nnyima mgbakkọhbhọ nna s'nnyim ma.”<verse eid="GEN 40:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 40:16" />Ma o, masẹ ocho kw'anạng p'n'asi uchiattọhk f'ọvaarnạng, osẹ bẹ́, ẹyaakha s'idachen s'oyok ide ikkasẹ inạng-ẹ, oben Josẹph bẹ́, “Amma mgba nttaara idachen e. Ma idachen nnọ, ntọhk ọkhạrạbaang ọttaan p'abrẹd k'echo. <verse eid="GEN 40:16" /><verse number="17" style="v" sid="GEN 40:17" />Ichiakpo k'akhira-k'akhira py'Phero m'uchi, ining k'ikhạrạbaang s'ẹrạng-ẹrạng k'ẹtaanga, okhenka, ọnọhn f'iyokhu n'ukwu ochoru ichiakpo mbyọ ma akhaam k'echo, itima efona.”<verse eid="GEN 40:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 40:18" />Ma wọ, Josẹph ọnạng-ẹ ẹyaakha bẹ́, “Idachen nnọ iyini bẹ, ọkhạrạbaang mvọ ọttaan, uyini iwu ittaan. <verse eid="GEN 40:18" /><verse number="19" style="v" sid="GEN 40:19" />K'iwu ittaan s'ororo, Phero m'upu-ọ echo, ọbạra ọtạkha ibukhu sọ orena k'ichi, ọnọhn vọ m'uchi atenạng pọ phyibh.”<verse eid="GEN 40:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 40:20" />Ma iwu njọ ch'ettọng ittaan, Phero usi erobha ch'utim ujima iwu ch'ọmmaan, obher atọhmnạng pẹ phyibh. Ukwu ọnạng ẹfa bẹ́, abẹ ata arengi ocho kw'anạng p'n'anạng ọvaarnạng atwuk, ọttạra ocho kw'anạng p'n'asi uchiattọhk anạng ọvaarnạng, obe bẹ k'ititikha s'ayok. <verse eid="GEN 40:20" /><verse number="21" style="v" sid="GEN 40:21" />Ọbara ọkpa nnạm ọnạng ocho kw'anạng p'n'anạng-ẹ atwuk, ininga chẹ, obạra onạng Phero atwuk k'oche kw'uwa n'ọnạng-ẹ. <verse eid="GEN 40:21" /><verse number="22" style="v" sid="GEN 40:22" />Okhenka, n'ọnạngẹ ẹfa bẹ́, abẹ ape echo ch'ocho-nạng kw'n'usi uchiattọhk f'ọvaarnạng, abẹ abạra atạkha ubukhu kwẹ arena k'ichi, k'oche kw'uwa Josẹph kk'ẹyaakha ocheden usia ọnạng bẹ.<verse eid="GEN 40:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 40:23" />Okhenka, ocho kw'anạng p'n'anạng ọvaarnạng atwuk, n'obonu bẹ́, ọkpaak ovaarnạng udik kwidede otena k'Josẹph kw'utim uning k'mgbakkọhbhọ.<verse eid="GEN 40:23" /></para>
  <chapter eid="GEN 40" />
  <chapter number="41" style="c" sid="GEN 41" />
  <para style="s1">Josẹph ọnang ẹyaakha kh'adachen p'Phero</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 41:1" />Masẹ icho ifa kk'isenga, Phero ọttaar idachen s'obe k'iraanga-khonga, k'ọraanga kw'okpen Nile, <verse eid="GEN 41:1" /><verse number="2" style="v" sid="GEN 41:2" />ose s'mmaam nsenọfa s'ijibh ifor, ibạra ide <char style="it">bẹ bạmabạmabạma</char> ayini k'ọraanga kw'Nile ikwu ichi asạsaarẹ p'ameni ma iraanga-khonga. <verse eid="GEN 41:2" /><verse number="3" style="v" sid="GEN 41:3" />Ma ngwọ osengi, mmaam nsenọfa idwạkh-ọdwạk s'ikkokh-okkokhu ibạra ipyibh k'ifor iyin k'ọraanga itta ibe ibaanga nnọkha s'ijibhi ifor s'n'ichi asạsaarẹ ma iraanga-khonga. <verse eid="GEN 41:3" /><verse number="4" style="v" sid="GEN 41:4" />Masẹ mmaam nnọ s'ikkokhu-okkokhu, ibạra ipyibh k'ifor itạma s'ijibh ifor chi-chi, ọvaar Phero ukwu ọphyạbha k'ọda.<verse eid="GEN 41:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 41:5" />Wa Phero ọbạra ọtta uyima, ẹkpa nja, n'ọttaar idachen idwạkh-ọdwạk, ose igwu-rin jạnẹ ch'itim agwudwuk asenọfa p'ijibh-ujibh. <verse eid="GEN 41:5" /><verse number="6" style="v" sid="GEN 41:6" />Ma ngwọ osengi, agwudwuk asenọfa ẹdwạkh-ọdwạk p'nạn nijibha ẹbạra iyin k'igwurin jạnẹ, ufhum kw'ọkpọkh-ọkpọkhọ k'ukhubha kw'okpebha-dudon nuyin uguma pyẹ, apyẹ igwu phyibh. <verse eid="GEN 41:6" /><verse number="7" style="v" sid="GEN 41:7" />Ma wọ, agwudwuk mbọ asenọfa p'nạn k'ifor nijibha etera imyi mbọkha asenọfa p'ijibhi ifor phyibh. Masẹ Phero ọphyạb ọda, ma wọ n'osong bẹ, idachen rọ s'ọttaar.<verse eid="GEN 41:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 41:8" />Masẹ iwu n'echobh, ettem ẹphyaangẹ Phero ẹmma, osenga ma, ọtọhm anạng bẹ́, abẹ ayeri abọhnganạng phyibh, ọttạra anạng p'akhaam esonga k'Ijip phyibh. Masẹ abẹ akwu akpira, otekhi bẹ adachen p'ọttaar. Bạrama, ọnạng mạnna wạnọ kw'okke ẹyaakha nạng-nạng kh'adachen p'Phero ọttaar kode.<verse eid="GEN 41:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 41:9" />Osenga ma, ochonạng kw'atọhmnạng p'n'anạng Phero atwuk, oben bẹ́, “Chemma, amma kk'ipina chaam njima-e. <verse eid="GEN 41:9" /><verse number="10" style="v" sid="GEN 41:10" />Wa ọkhaam okpe kw'Phero ọdwạkhẹ ọttạra atọhmnạng pẹ abẹ, kw'ode amma, ọttạra ochonạng kw'atọhmnạng p'nanạng-ẹ uchiattọhk, p'uwa ọtọhmọ mgbakkọhbhọ, k'ọchọhm kw'odennạng kw'akker-agbakkọhbhọ. <verse eid="GEN 41:10" /><verse number="11" style="v" sid="GEN 41:11" />Wa k'irunguwu jạnẹ, amạna mba anạng afa p'ọvaar Phero ọtọhmọ mgbakọbhọ, khọnạng-khọnạng, anttaar idachen, idachen s'idede ikhaam ẹyaakha chẹ. <verse eid="GEN 41:11" /><verse number="12" style="v" sid="GEN 41:12" />Ma wọ, antạk adachen mbọ amkpaakh oHiburu-dikobh wạnọ kw'ode itọhmọ s'odennạng kw'n'okkeri agbakkọhbhọ. Udikobh nwọ wọ wa ọnạngẹ eyaakha ch'adachen mbọ. <verse eid="GEN 41:12" /><verse number="13" style="v" sid="GEN 41:13" />K'udik ọkka, wa akwẹ ode oche kwa oHibru-dikobh nwọ ọkpaakhẹ. Wa Phero ọkpa nnạm ọnạng-m ininga ch'iwa ochokhạm. Oyok nwọkha abẹ arennẹ idikhi.”<verse eid="GEN 41:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 41:14" />Ma wọ, Phero ọtọhmọ anạng bẹ, abẹ atima Josẹph k'ọgbakkọhbhọ-ter akwu. Ma ibua-ibua, abẹ ata areng-ẹ. Masẹ Josẹph k'agbaphyạbha pẹ ọwạra, ọbạra ofhona ẹnya ch'oge, ọta ose Phero.<verse eid="GEN 41:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 41:15" />Masẹ abẹ akpir, Phero otek Josẹph bẹ́, “Amma nttaar idachen s'ọnạng wạnọ-wạnọ nạn ẹyaakhạ okke ọnạng. Kakha, amma kk'mmaanga bẹ́, ọma nanạng anạng ẹyaakha ch'adachen.”<verse eid="GEN 41:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 41:16" />Josẹph ọpọhna Phero bẹ́, “Amma ẹfa k'nkhaam ch'mạnạng ọ ẹyaakha ch'adachen e, okhenka ode bẹ́, Ubinọkpaabyi wọ m'ọnạng ẹpọhna ch'm'ẹdaakh-ọ e.”<verse eid="GEN 41:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 41:17" />Ma o, Phero otekhi Josẹph bẹ́, “Nttaar s'mbe k'iraanga-khonga s'ọraanga kw'abẹ ayeri Nile. <verse eid="GEN 41:17" /><verse number="18" style="v" sid="GEN 41:18" />Nse mmaam nsenọfa s'ijibhi ifor, ibạra ide <char style="it">bẹ bạmabạmabạma,</char> iyini k'ọraanga ikwu ichi asạsaarẹ ma iraanga-khonga. <verse eid="GEN 41:18" /><verse number="19" style="v" sid="GEN 41:19" />Ma ngwọ osengi, mmaam nsenọfa idwạkh-ọdwạk s'ikokh-okokhu ibạra ipyibh k'ifor, iyin ma ọraanga dạkhẹ. Amma s'mbebẹ nninga, mmaam s'ikkokhu k'ifor ochengwọ tạma nạnsia ma isisek s'Ijip, <verse eid="GEN 41:19" /><verse number="20" style="v" sid="GEN 41:20" />Mmaam nnọ s'ikkokh-okkokhu ichi nnọ s'ijibhi ifor. <verse eid="GEN 41:20" /><verse number="21" style="v" sid="GEN 41:21" />Chibhi sabẹ k'ayok achia phyibh, abẹ k'ifor na jibha, itim ikkokhu ma. Mgbe nphyạbha k'oda.<verse eid="GEN 41:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 41:22" />“Mbạra nyima dạkhẹ, nse s'agwudwuk asenọfa p'ijibhi ifor iyini k'irin jạnẹ. <verse eid="GEN 41:22" /><verse number="23" style="v" sid="GEN 41:23" />Ma ngwọ osengi, agwudwuk asenọfa adwạkh-ọdwạk p'nạn ijibhi abạra ayin k'igwurin jạnẹ, ufhum kw'iyoma kw'ọkpọkh-ọkpọkhọ uguma pyẹ, apyẹ igwu phyibh. <verse eid="GEN 41:23" /><verse number="24" style="v" sid="GEN 41:24" />Ma wọ, agwudwuk mbọ asenọfa p'nạn k'ifor ijibhi amyi asenọfa p'ajibhi ifor bẹ́ pyibh. Ntạk idik nna pyibh mkpaakh abọhnganạng p'Ijip pyibh, bạrama, ọnạng kw'okke ẹyaakha sisi ọnạng-m kode.”<verse eid="GEN 41:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 41:25" />Osenga ma, Josẹph ọkpaak Phero bẹ́, “Adachen mbọ afa ade ukhira ngwọ gwạnọ. Ubinọkpaabyi khọ ẹyaakha ọnạnga k'udik kw'n'oben bẹ usi. <verse eid="GEN 41:25" /><verse number="26" style="v" sid="GEN 41:26" />Adachen mbọ phyibh ẹkhaam ẹyaakha jạnẹ, ẹyaakha njọ ede bẹ: Mmaam nnọ nsenọfa s'ijibhi ifor, iyini icho isenọfa. Agwudwuk mbọ asenọfa p'ijibhi ifor, ibạra iyin icho isenọfa. <verse eid="GEN 41:26" /><verse number="27" style="v" sid="GEN 41:27" />Mmaam nnọ nsenọfa s'ikokh-okokhu s'ikpong nnạm iyin k'ọraanga, ọttạra agwudwuk mbọ asenọfa pyẹ nạn k'ifor ijibhi, kw'ufum k'ukhubha kw'okpebhadudon k'usia apyẹ igwu<char style="it">bẹ khạkhaara,</char> iyini icho isenọfa s'okwo f'ididen.”<verse eid="GEN 41:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 41:28" />“Attitte, ode mas'mkpaakhẹ nnạng Phero bẹ́, Ubinọkpaabyi kk'ẹyaakha usia ọnạng-ọ k'udik kw'n'oben bẹ, usi. <verse eid="GEN 41:28" /><verse number="29" style="v" sid="GEN 41:29" />K'icho isenọfa, ofon kw'Ijip m'ọkhaama uchiattọhk k'ọsaabh. <verse eid="GEN 41:29" /><verse number="30" style="v" sid="GEN 41:30" />Ode okpe ngwọ osengi mạmma, okwo f'ididen m'uninga icho isenọfa, ọbạra ọnyaamẹ k'ofon kw'Ijip phyibh, m'osenga ma okwo mvọ f'ididen, uchiattọhk k'ofon kw'Ijip dạk muninga. <verse eid="GEN 41:30" /><verse number="31" style="v" sid="GEN 41:31" />Okwo mvọ m'ọkpọkhọ tạrr, abẹ m'abonu okpe kw'uwa idik ijibhi inạng bẹ. <verse eid="GEN 41:31" /><verse number="32" style="v" sid="GEN 41:32" />Ọttọhk f'usi bạra Phero ọttaar idachen nnọ rạnẹ nden nfa, ode bẹ́, Ubinọkpaabyi kk'kwẹ ọttọhna ochok bẹ́, akwẹ m'ode oche kw'ọkpaakhẹ, eden mibhir.<verse eid="GEN 41:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 41:33" />“Mantọhmma, tte Phero oror ujunạng kw'ọkhaam esonga, ọttạra ekkoji, ọfha ọnạng ujunạng nwọ ẹfa ch'm'utima ọdạbh ẹkhạma ch'Ijip. <verse eid="GEN 41:33" /><verse number="34" style="v" sid="GEN 41:34" />Tte Phero ọbạra otekha atọhmnạng p'm'aninga k'isekhisek kwẹ, p'm'ator-ẹ n'atobha ichiakpo k'icho nnọma isenọfa s'uchiattọhk m'ọsaabh-ọsaabh k'Ijip. Anạng mbọ m'atobha ichiakpo mbọ k'akwung asen, brasẹ abẹ n'atạk ukwung gwạnọ achok. <verse eid="GEN 41:34" /><verse number="35" style="v" sid="GEN 41:35" />Tte ubina k'ẹfa ch'Phero bẹ́, k'icho isenọfa s'm'ikwu, anạng mbọ atạkha ichiakpo mbọ achok k'ọkhaanga-chọhm ch'efhon-diden njọ, abạra akkeri pẹ. <verse eid="GEN 41:35" /><verse number="36" style="v" sid="GEN 41:36" />Abạnga aye ichiakpo mbọ, m'ininga ma, ofha abẹ atima k'icho nnọ isenọfa s'okwo f'ididen m'uninga k'ẹkhạma ch'Ijip, ọfha anạng nạng ape k'okwo.”<verse eid="GEN 41:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 41:37" />Osenga ma, Phero ọttạra atọhmnạng pẹ phyibh achera anạng ntọhna s'Josẹph ọnạng bẹ. <verse eid="GEN 41:37" /><verse number="38" style="v" sid="GEN 41:38" />Ma wọ, Phero ọbạbh atọhmnạng pẹ bẹ́, “Ma, sạmạna anse ọnạng kw'ode masẹ ujunung nwa, kw'ọkhaam esonga ch'ibin k'Ubinọkpaabyi o?”<verse eid="GEN 41:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="GEN 41:39" />Osenga ma, Phero oben Josẹph bẹ́, “Masẹ Ubinọkpaabyi khọ ẹyaakha ch'idik nna phyibh ọnạnga, ọnạng ọdwạkh-ọdwạk kw'ọkhaam esonga ọttạra ekkoji ch'ọma akhaam kóde. <verse eid="GEN 41:39" /><verse number="40" style="v" sid="GEN 41:40" />Ọma wọ m'ade echo k'ọvaarchọhm kwaam, anạng paam phyibh m'aninga isekhisek kwọ. Ikpukpobha s'ẹvaar mạnkeni rọ s'amma m'ntima mbạr nyọng-ọ.”<verse eid="GEN 41:40" /></para>
  <para style="s">Abẹ anạng Josẹph edennạng k'Ijip</para>
  <para style="p">
    <verse number="41" style="v" sid="GEN 41:41" />Phero ofona ororo oben Josẹph bẹ́, “Amma khọ ọbọhk nnạna k'echo, nnạng-ọ edennạng ch'ẹbaabhẹ Ijip.” <verse eid="GEN 41:41" /><verse number="42" style="v" sid="GEN 41:42" />Osenga ma, Phero ọwạra ẹbaanga ch'oge k'ẹnọhna, oge Josẹph. Ọtạkha imaan s'gol uge-ẹ k'ẹdwạngọ, ọbạra ọtạkha ọvạra ọkkọkka uge-ẹ. <verse eid="GEN 41:42" /><verse number="43" style="v" sid="GEN 41:43" />Wa Phero khẹ ẹfa ọnạnga bẹ́, abẹ ayaar Josẹph k'ọkpaar kw'ẹnyạnyaang n'ẹtwạr mas'ọvaar kw'onyem-ẹ k'nnạm, bạra anạng p'achiẹ-ẹ eden n'awur ẹmạng bẹ, “Abạnga akhọmọ itọhng e, odennạng ukwuma e, abạnga arikh-ẹ eden oseng o.” Mạnna wọ, ọvaar Phero ọnạng Josẹph ẹvaar ch'ofon kw'Ijip phyibh, ọdạbh.<verse eid="GEN 41:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="GEN 41:44" />Phero ọbạra oben Josẹph bẹ́, “Ọbạra ode bẹ́, Amma wọ nde ọvaarnạng kw'Ijip, k'ẹfa ch'kk'ọnnạnga, udik kwidede kw'ọnạng wạnọ-wạnọ obeni bẹ usi, oche kw'abeni, mạnna wọ akwẹ m'ode.” <verse eid="GEN 41:44" /><verse number="45" style="v" sid="GEN 41:45" />Wa ọvaar Phero ukp-ẹ Zaphenat-Panea, ọbạra ọnạng-ẹ uminanwa kw'okpen Asenat, kw'ode nnwa kw'Potiphera nwọ kw'ode ọfọhnẹja kwa On, k'ọbada. Ma wọ, ẹfa ch'Josẹph ẹnyaamẹ ẹbaabha Ijip.<verse eid="GEN 41:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="GEN 41:46" />Wa Josẹph ode icho ẹrạbh ukuma jobh k'okpe kw'ọtạm Phero abẹ ọtọhm sisi. Wa ubin urik ọvaar Phero, osenga ose ofon kw'Ijip phyibh. <verse eid="GEN 41:46" /><verse number="47" style="v" sid="GEN 41:47" />Ma icho nnọ isenọfa s'uchiatọhk ọsaabh-ọsaabh, <verse eid="GEN 41:47" /><verse number="48" style="v" sid="GEN 41:48" />Josẹph ọttạra atọhmnạng p'aning k'isek-isek kwẹ, atạk ichiakpo k'ọsaabh achok k'ifhon-diden s'Ijip. Ichiakpo p'abẹ achokhu k'efhon-diden kwidede, ede ichiakpo p'abẹ aphya ma ofon ngwọ. <verse eid="GEN 41:48" /><verse number="49" style="v" sid="GEN 41:49" />Ma wọ, Josẹph ochokhu ichiakpo mbọ k'ọsaabh masẹ opong kw'ọraanga. Ichiakpo mbyọ n'ẹsaabhẹ tạrr abẹ ubhik dạk kasóng.<verse eid="GEN 41:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="GEN 41:50" />Brasẹ icho s'okwo f'ididen n'ukpir, Josẹph kk'ajunungva afa ofhona k'ikwanạng kwẹ, Asenat, kw'ode nnwa kw'Potiphera, kw'ode ọfọhnẹja kwa On. <verse eid="GEN 41:50" /><verse number="51" style="v" sid="GEN 41:51" />Wa Josẹph okpe ocheden-nwa kwẹ, Manasẹ, oben bẹ, “Ubinọkpaabyi khaam usia mbonu irem saam phyibh, ọttạra efonamma ch'otte kwaam phyibh.” <verse eid="GEN 41:51" /><verse number="52" style="v" sid="GEN 41:52" />Ọbạra okpe nnwa kw'ottong ẹfa Ephraim, oben bẹ́, “Ubinọkpaabyi khaam usia bẹ́, nde otte kw'iva ma isek na k'irem saam.” <verse eid="GEN 41:52" /><verse number="53" style="v" sid="GEN 41:53" />Ma icho isenọfa nnọ s'ichiakpo ining k'ọsaabh k'Ijip, kk'isenga, <verse eid="GEN 41:53" /><verse number="54" style="v" sid="GEN 41:54" />icho nnọkha isenọfa s'okwo fididen k'ikwikpira, k'oche kw'uwa Josẹph kk'ẹyaakha ọnạnga. Wa okwo fididen uning ma idifhon nnọ phyibh, bạra, ichiakpo p'ẹsaabh-ọsaabh ininga ma Ijip. <verse eid="GEN 41:54" /><verse number="55" style="v" sid="GEN 41:55" />Masẹ uchiattọhk ọtạm wu-wor k'efhonfhạr ch'Ijip, anạng n'ata agạma okwo anạng ọvaar Phero, ọfha ọnạng bẹ uchiattọhk. Osenga ma, Phero oben anạng pẹ bẹ, “Abạnga asọhng k'Josẹph, asi udik kwidede kw'obeni bẹ, abạnga asi.”<verse eid="GEN 41:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="GEN 41:56" />Masẹ okwo fididen mvọ k'ọnyaama ọbaabha Ijip, Josẹph obeni atọhmnạng pẹ bẹ, abẹ agwunga ọkhaangachọhm, ọfha abẹ akpe ichiakpo anạng anạ́ng p'Ijip. <verse eid="GEN 41:56" /><verse number="57" style="v" sid="GEN 41:57" />Ma wọ, wa anạng n'abina k'ibyi-k'ibyi, akwu adebh uchiattọhk k'Ijip k'mbọhk s'Josẹph, ukwuru okwo fididen f'uning ọbaabha ọyagbin.<verse eid="GEN 41:57" /></para>
  <chapter eid="GEN 41" />
  <chapter number="42" style="c" sid="GEN 42" />
  <para style="s1">Ivotte p'Josẹph ata k'Ijip</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 42:1" />Masẹ Jekọb ọbhaang bẹ́, uchiattọhk uning kha Ijip, ọbạbh ajunungva pẹ bẹ́, “Ode yạn kw'abạnga atim aning n'akkeri ayok mạnna o? <verse eid="GEN 42:1" /><verse number="2" style="v" sid="GEN 42:2" />Amma kk'mmaanga bẹ́, uchiattọhk uning kha ẹkhạma ch'Ijip. Abạnga asọhng ata adebh atima akwu amạna anchi, ọfha nạng ampe k'okwo.”<verse eid="GEN 42:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 42:3" />Ma wọ ivotte p'Josẹph ncho jobh abin afona k'Ijip bẹ́, abẹ ata adebh uchiattọhk. <verse eid="GEN 42:3" /><verse number="4" style="v" sid="GEN 42:4" />Okhenka, Jekọb wa Bẹnjamin kw'ode nnwọkka kw'Josẹph ọbọhk núttia bẹ́, ọtwạn ivotte abẹ ata adebh uchiattọhk k'Ijip. Wa Jekọb ojor-ẹ bẹ́, ipyibha m'ẹbạra etto ekhebha Bẹnjamin. <verse eid="GEN 42:4" /><verse number="5" style="v" sid="GEN 42:5" />Ma wọ, wa iva p'Jekọb attạr ma ikhaana s'anạng p'afon k'Ijip bẹ́, ata adebh uchiattọhk, ukwuru s'uwa okwo fididen ọbạra uninga k'ẹkhạma ch'Kenaan.<verse eid="GEN 42:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 42:6" />Ma okpe ngwọ, Josẹph n'utim edennạng k'Ijip, ọbạra ode ọnạng kw'n'okpe uchiattọhk ọnạng anạng phyibh. Ma wọ, masẹ ivotte p'Josẹph akpir k'Ijip, abẹ arạkha attima ititikha sabẹ k'isisek k'ikpukpobha. <verse eid="GEN 42:6" /><verse number="7" style="v" sid="GEN 42:7" />Masẹ Josẹph ose ivotte pẹ <char style="it">bẹ jọọr</char>, utin bẹ. Okhenka, wa usi nkkari bẹ́, bẹ nútina, n'ọbạbhọ bẹ ẹkkaam-ẹkkaam bẹ́, “Abạnga abin mạn akwu maa?”</para>
  <para style="p" vid="GEN 42:7">Abẹ apọhn-ẹ bẹ́, “Amạna ambin k'ẹkhạma ch'Kenaan ankwu bẹ́, ankwu andebh uchiattọhk e.”<verse eid="GEN 42:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 42:8" />Oseng s'uwa Josẹph kk'ivotte pẹ utina, wa abẹ khẹ nátina. <verse eid="GEN 42:8" /><verse number="9" style="v" sid="GEN 42:9" />Ma wọ Josẹph ujim adachen p'uwa kk'ọttara otena bẹ, n'obeni bẹ bẹ́, “Abạnga ade abaan-ibyi, abạnga kk'akwua bẹ́, akwu abaana ofhon kwamạna, ọfha abạnga asonga urima-bọhk kwamạna.”<verse eid="GEN 42:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 42:10" />Abẹ apọhna bẹ́, “Mma e, aro kwamạna, akwẹ oche ngwo núdia e. Atọhmnạng pọ akwu bẹ́, akwu adebh uchiattọhk. <verse eid="GEN 42:10" /><verse number="11" style="v" sid="GEN 42:11" />Amạna mba phyibh ande ajunung p'otte wạnọ ofhonu e. Atọhmnạng pọ akpaakhẹ udik ọkka e, amạna abaan-ibyi nándia a.”<verse eid="GEN 42:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 42:12" />Josẹph oben bẹ bẹ́, “Afhạra! Abạnga akwu bẹ, akwu asonga urima-bọhk kwamạna.”<verse eid="GEN 42:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 42:13" />Abẹ n'abhin bẹ́, “Aro, wa amạna mba atọhmnạng pọ ande anạng jobh-kamfa p'otte wạnọ kw'urukhu kha Kenaan ofhonu. Okpongannạm kwamạna uning kha otte kwamạna abẹ, okhenka, oyok wạnọ k'ikhaana s'amạna mba anạng jobh-kamfa k'akpen dạk kòde.”<verse eid="GEN 42:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 42:14" />Josẹph ofona ororo oben bẹ́, “Udik ngwa utim ode k'oche ntekhi bạnga bẹ́, abạnga ade abaan-ibyi e! <verse eid="GEN 42:14" /><verse number="15" style="v" sid="GEN 42:15" />Bạrasẹ ansonga udik ọkka, eyoma chabạnga ede bẹ́, abạnga m'ata atima okpongannạm kwabạnga atima akwu. Amma ntim akpen p'Phero nchekhi bẹ́, de abạnga nạn oche ngwọ násia, abạnga mábhạna e. <verse eid="GEN 42:15" /><verse number="16" style="v" sid="GEN 42:16" />Abạnga atọhm ọnạng wạnọ k'abạnga k'ngekha ọkpa nnạm, ọta utima okpongannạm nwọ kwabạnga ukwu, ayok mbakha m'aninga k'mgbakkọhbhọ tạrr abẹ akwuna akhebha bạnga maa, ọfha anyoma bạnga anse de abạnga n'akpaak udik ọkka o. De nạn oche ngwọ núdia, ntim akpen p'Phero nchekhi bẹ́, abạnga ade abaan-ibyi!” <verse eid="GEN 42:16" /><verse number="17" style="v" sid="GEN 42:17" />Ma wọ ọtạk bẹ ọkpạkha k'iwu ittaan.<verse eid="GEN 42:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 42:18" />Ottong iwu nnọ ittaan, Josẹph oben bẹ bẹ́, “Amma nkhaam ojora f'Ubinọkpaabyi e. Abạnga asi oche kw'mbeni, ọfha abạnga aruk akpen. <verse eid="GEN 42:18" /><verse number="19" style="v" sid="GEN 42:19" />De abạnga ade anạng p'n'akpaak udik ọkka, tte ọnạng wạnọ k'abạnga ngekha uninga k'mgbakkọhbhọ maa, ọfha ayok atạkha uchiattọhk f'abạnga kk'adebha akkena anạng pabạnga ichọhmfhạr, p'n'ayima okwo kha. <verse eid="GEN 42:19" /><verse number="20" style="v" sid="GEN 42:20" />Brasẹ nchera bẹ́, abạnga afhạra násia, ọfha abạnga nạ́ngẹ abạra ape, oyonga abạnga m'atima okpongannạm kwabạnga akken-m.” Wa abẹ acher asi oche kw'otekhi bẹ.<verse eid="GEN 42:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 42:21" />Abẹ n'abhạkhẹ aben ayok bẹ́, “K'udik ọkka, iponga-pyibha nna s'amạna antạk maa, ibin k'igbaan s'uwa ansi nnwotte kwamạna e. Tte anjima oche kw'uwa udik ngwọ ọmmẹ-ẹ, ọttạra oche kw'uwa n'uchini mạna bẹ́, ankkaan-ẹ. Okhenka, wa ọnạng kw'ọkhọhm-ẹ itọhng kòde, ẹgwọ usi udik okhebha mạna maa e.”<verse eid="GEN 42:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 42:22" />Reubẹn ubhina bẹ bẹ́, “Wa bạnga itọhng nạ́ntwạra bẹ́, abạnga nạngẹ nnwa nwọ ipyibha asi? Okhenka, ọnạng kw'uwa ọkhọhm-m itọhng kòde. Akkeri ẹngwọ mạma, ọbaan bẹ́ anse irem k'echo ch'nnwa nwọ.” <verse eid="GEN 42:22" /><verse number="23" style="v" sid="GEN 42:23" />Masẹ abẹ n'akpaak idik nnọ phyibh, abẹ kásong bẹ́, Josẹph nạngka ọbhaanga, ukwuru s'uwa n'utima ọnạng usi akkabharikkọ ọnạng bẹ.<verse eid="GEN 42:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 42:24" />Wa Josẹph n'ubin urik bẹ ma k'ibyi sabẹ aning, ọta ọgạma ẹmạng, bạra n'ọkpa nnạm okhebha bẹ, ọbạra ọkpaak ọtọhnga ọnạng bẹ. Ọvạkha Simeọn ma ngekha s'ayok, ọdạbh ndikhi ma ititikha sabẹ.<verse eid="GEN 42:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 42:25" />Ma wọ, Josẹph ọnạngẹ anạng pẹ ẹfa bẹ́, abẹ ata age anạng mbọ agwu k'mkpa sabẹ atim akwu, abẹ abạra arik akpokha p'ọnạng-ọnạng utim odebh agwu k'akhẹ k'ẹkpa, abẹ abạra attạra uchiattọhk f'anạng mbọ m'achi k'eden. Masẹ abẹ kk'oche ngwọ asia, <verse eid="GEN 42:25" /><verse number="26" style="v" sid="GEN 42:26" />anạng mbọ atạkha uchiattọhk f'abẹ kk'bẹ anạnga adạbh k'nnyạnyaang sabẹ, abhạna.<verse eid="GEN 42:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 42:27" />Masẹ abẹ akpir k'ibyi sabẹ abhingi s'iwu kk'ipyia, oyok wạnọ ọchaarẹ ẹkpa chẹ ọfha ọnạng ẹnyạnyaang chẹ uchiattọhk, n'ose asilva pẹ k'ẹkpa chẹ ẹtaanga. <verse eid="GEN 42:27" /><verse number="28" style="v" sid="GEN 42:28" />Ọkpaak ayok bẹ́, “Abẹ kk'asilva paam arikha e, khiri ẹmba k'akhaam k'ẹkpa e.” Masẹ abẹ abhaang udik kw'oyok ọkpaakhẹ bẹ, nttem iyọhn bẹ, ojora ọvạkha bẹ, abẹ afhạnọ abạbh ayok bẹ, “Ma, bạng udik gwọ kw'Ubinọkpaabyi n'usi mạna ma o?”<verse eid="GEN 42:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 42:29" />Masẹ abẹ akwu akpira k'ẹkhạma ch'Kenaan, abẹ akpaak otte kwabẹ Jekọb udik kwidede kw'kk'uttia okhebha bẹ k'osenga kw'abẹ ata, aben bẹ́, <verse eid="GEN 42:29" /><verse number="30" style="v" sid="GEN 42:30" />“Ujunung kw'ọdạbhẹ ofhon ngwọ otera ọkkaamẹ mạna abẹ ọkkaam, ọbạra ọtạkha mạna masẹ abaan-ibyi, p'akwu ofhon-bạbaana. <verse eid="GEN 42:30" /><verse number="31" style="v" sid="GEN 42:31" />Okhenka, amkpaakh-ẹ bẹ́, ‘Amạna ande anạng ọkka e, abaan-ibyi nándia. <verse eid="GEN 42:31" /><verse number="32" style="v" sid="GEN 42:32" />Wa ande ivotte jobh-kamfa p'otte wạnọ ofhonu. Okhenka, oyok wạnọ k'ngekha samạna ncho jobh-kamfa k'akpen dạk kòde. Okpongannạm kwamạna wọ n'uning otte kwamạna abẹ kha Kenaan.’<verse eid="GEN 42:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 42:33" />“Ma wọ, ujunung nwọ kw'utim edennạng ch'ofhon ngwọ obeni mạna bẹ́, oche kw'ẹma m'utima osonga bẹ́ ande anạng ọkka ode bẹ́, m'antte ọnạng wạnọ k'ikhaana s'amạna uninga abẹ, ọfha ayok mbọkha atạkha uchiattọhk akkena ichọhmfhạr sabẹ, s'ining k'okwo fididen. <verse eid="GEN 42:33" /><verse number="34" style="v" sid="GEN 42:34" />Abẹ de oyongu bẹ́ m'antima okpongannạm kwamạna ankken-ẹ, ẹma móchera bẹ́ amạna abaabh-ibyi nándia, mọ́bạra ochera bẹ́ ande anạng ọkka. Abẹ de kk'ansia oche ngwọ, ẹma m'otte nwotte kwamạna ọbọhk otte ọnạng mạna, ọfha ambạra ankke ẹphya ansenga ma ofhon ngwọ.”<verse eid="GEN 42:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 42:35" />Masẹ abẹ n'awon ekpo py'ining k'mkpa sabẹ atim akwuna, ọnạng-ọnạng n'ose ikwa sẹ s'silva s'wạra utim odebh agwu k'ẹkpa chẹ ẹtaanga. Masẹ abẹma phyibh ọttạra otte kwabẹ n'abạra ase akwa p'silva p'abẹ arengi k'mkpa sabẹ, ojora ọvạkha bẹ phyibh. <verse eid="GEN 42:35" /><verse number="36" style="v" sid="GEN 42:36" />Ma wọ otte kwabẹ Jekọb obeni bẹ bẹ́, “Abạnga kk'aam iva paam arạma. Josẹph ọttạra Simeọn k'akpen dạk kàde, mantọmma, abạnga kk'adạkhẹ akwua bẹ́ akwu atạkha Bẹnjamin atima afona. Idik nna phyibh itim itto ikhebha amma nwa mạnkkeni!”<verse eid="GEN 42:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 42:37" />Ma wọ Reubẹn obeni otte bẹ́, “Tte Bẹnjamin ọbọhk anạng-m, amma m'ntima iva paam ncho mfa ntera echo chẹ, de nạn abẹ nạ́ntima nkwuna nkken-ọ. Ọttọk f'idede f'ọdaakh-ọ bẹ́ asi iva paam, si bẹ.”<verse eid="GEN 42:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 42:38" />Okhenka, Jekọb ubhin bẹ́, “Kwaam asạng! Nnwa kwaam ọbọhk mạ́ntte nnạng bạnga, ukwuru bẹ́ nnwọkka kwẹ kk'upua, n'urikhi ẹma-ẹma. De ipyibha chidede etto ekhebh-ẹ k'osenga kw'abạnga m'ata, ma wọ ode bẹ́ abạnga m'annọhng-m ma k'atạm mba ọttạra k'ikwosi.”<verse eid="GEN 42:38" /></para>
  <chapter eid="GEN 42" />
  <chapter number="43" style="c" sid="GEN 43" />
  <para style="s1">Ivotte p'Josẹph atim Bẹnjamin akpa nnạm k'Ijip</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 43:1" />Wa okwo fididen utim uning k'ẹkhạma ch'Kenaan. <verse eid="GEN 43:1" /><verse number="2" style="v" sid="GEN 43:2" />Masẹ Jekọb ọttạra ẹchọhmfhạr chẹ kk'agwu p'uwa abẹ adebhi k'Ijip akkera achi, otte n'obeni bẹ bẹ́, “Abạnga akpa nnạm k'Ijip ata adebh uchiattọhk-nwa atima akwu.”<verse eid="GEN 43:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 43:3" />Okhenka, wa Juda obeni otte bẹ́, “Ujunung nwọ kw'ọdạbhẹ Ijip, ọtwạrọ mạna itọhng mororo bẹ́, ‘Abạnga khaam k'ititikha kábe, oyonga abạnga m'atima nwotte nwọkha kwabạnga akwu.’ <verse eid="GEN 43:3" /><verse number="4" style="v" sid="GEN 43:4" />De acher bẹ́ nnwotte kwamạna ọtwạn mạna abẹ, m'anta-ọta anta andebh uchiattọhk ankken-ọ. <verse eid="GEN 43:4" /><verse number="5" style="v" sid="GEN 43:5" />Okhenka, de nạn khẹ ọbọhk náttia ọtwạn mạna abẹ, amạna mántta, ukwuru bẹ́ ujunung nwọ obeni mạna bẹ́, ‘Abạnga khaam k'ititikha kábe, kw'oyongu bẹ́ abạnga atima nnwotte nwọkha kwabạnga akwu.’ ”<verse eid="GEN 43:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 43:6" />Wa Jekọb kw'ọbạra okpena Israẹl, ọbạbhọ bẹ́, “Abạnga asi yạn age-m k'ọmmaphyaangẹ demakwẹ nwa, kw'abạnga akpaakhẹ ujunung nwọ bẹ́ abạnga akhaam nnwotte ọdwạkh-ọdwạk kạkha o?”<verse eid="GEN 43:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 43:7" />Abẹ abhina bẹ́, “Ujunung nwọ ọbạbhọ mạna idik-saabhada s'iten k'ifor s'amạna, ọttạra ẹchọhmfhạr chamạna bẹ́, ‘Atte kwabạnga utim urukhu akpen kạkha? Abạnga akhaam nnwotte ọdwạkh-ọdwạk kạkha?’ Udik ubungukwẹ kw'amạna ansi ode bẹ́, ampọhn-ẹ idik s'ọbạbhọ mạna phyibh. Wạra m'ansenga yạn ansonga bẹ́ m'oben mạna antima nnwotte kwamạna ankwu o?”<verse eid="GEN 43:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 43:8" />Ma wọ Juda n'obeni Israẹl bẹ́, “Tte nnwa nwọ ọbọhk anạng-m, ọfha amfona echomajạnẹ anta andebh uchiattọhk antima ankwu, deja, ọma ọttạra amạna mba, ọttạra iva pamạna kk'ampua k'okwo e. <verse eid="GEN 43:8" /><verse number="9" style="v" sid="GEN 43:9" />Amma oyeni wọ m'nkker-ẹ, de aror-ẹ, bạbh-m. Amma m'ntima akpen paam phyibh ntera echo chẹ de nạn khẹ nạ́ntima nkwuna nkken-ọ. <verse eid="GEN 43:9" /><verse number="10" style="v" sid="GEN 43:10" />Wạra nạn ekpekhibha nja núdia, njanna wạra k'ikpe ifa anta ankwuna.”<verse eid="GEN 43:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 43:11" />Ma wọ otte Jekọb n'obeni bẹ bẹ́, “<char style="it">A o</char>, ma n'ode mạnna, abạnga atekha ẹnạnga k'ekpo ẹkka-pẹ mbyọ py'ankhaam ma isek nna, masẹ ana p'arebhi iruk, ọttạra ọkhọhn, ọttạra amạma p'kashu, ọttạra amạma p'almọn, akkena ujunung nwọ. <verse eid="GEN 43:11" /><verse number="12" style="v" sid="GEN 43:12" />Abạnga abạra atạkha asilva p'ade ikpe ifa k'mbọma p'iwu njọ oge k'mkpa sabạnga. De abạnga akpir kha, arik asilva mbọ p'abạnga ase k'mma s'mkpa sabạnga, khiri okke-okke ode bẹ́ abẹ asi ipina age pyẹ ma. <verse eid="GEN 43:12" /><verse number="13" style="v" sid="GEN 43:13" />Abạnga abạra atima nwotte kwabạnga annemi eden asọhng k'ujunung nwọ. <verse eid="GEN 43:13" /><verse number="14" style="v" sid="GEN 43:14" />Tte njọhm samạna ide bẹ́, Ọvaar Ubinọkpaabyi kw'Ẹfa phyibh, usi ujunung nwọ ose bạnga ikwosi, otte nnwatte nwọkha kwabạnga ọbọhk, ọttạra Bẹnjamin, abẹ atwạn bạnga abẹ akwuna. N'ode amma, de iva paam m'adim-m udimi o, tte abẹ adim-m kadẹ o.”<verse eid="GEN 43:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 43:15" />Ma wọ ajunung mbọ atạk nnạnga nnọ, ọttạra asilva p'ade ikpe ifa kha mbọ p'uwa abẹ atim, akwu attạra k'Bẹnjamin atima afona. Abẹ asenga k'ẹbhạr-k'ẹbhạr akpira k'Ijip, annemi eden k'Josẹph. <verse eid="GEN 43:15" /><verse number="16" style="v" sid="GEN 43:16" />Masẹ Josẹph ose bẹ Bẹnjamin abẹ, oben ọtọhmnạng kwẹ kw'ọchọhm bẹ́, “Tima anạng mbọ sọhng k'akhaam k'ọchọhm, abạnga afhọ eten atima asi uchiattọhk, khiri abẹ m'achi ọttọhk abaamẹ k'ẹyachẹ.”<verse eid="GEN 43:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 43:17" />Wa ọtọhmnạng usi oche kw'Josẹph obeni, utima ivotte p'Josẹph ofona k'ọchọhm kw'Josẹph. <verse eid="GEN 43:17" /><verse number="18" style="v" sid="GEN 43:18" />Masẹ abẹ akpir k'ọchọhm kw'Josẹph, ajunung mbọ ojora bẹ, sabẹ akkẹ bẹ́, “Okke-okke ode bẹ́, asilva mbọ p'iwu njọ abẹ akpa nnạm age k'mkpa samạna ẹbọ abẹ aseng akwẹ atima mạna akwu ma ibyi nna e. N'oben bẹ urima mạna abẹ, ọbạra ọna mạna ẹfa, ọbạra ọvạkha mạna nnyạnyaang samạna ọna, ọbạra utima mạna usi abira pẹ.”<verse eid="GEN 43:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 43:19" />Ma wọ abẹ afon ata akhebha ọtọhmnạng kw'Josẹph k'ẹbaakhamma ch'ọchọhm ngwọ, akpaak abẹ. <verse eid="GEN 43:19" /><verse number="20" style="v" sid="GEN 43:20" />Abẹ aben bẹ́, “Totokhạn aro kwạmạna, wa ankwu andebh uchiattọhk maa k'ochedenkpe. <verse eid="GEN 43:20" /><verse number="21" style="v" sid="GEN 43:21" />Masẹ amkpir k'ibyi s'ammingi, ọnạng-ọnạng n'ose ubhik ngwọ kw'asilva p'utim odebh uchiattọhk k'ẹmma ch'ẹkpa chẹ ẹtaanga. Ma wọ antim pẹ maa bẹ́ ankwu annikh e. <verse eid="GEN 43:21" /><verse number="22" style="v" sid="GEN 43:22" />Masẹ nạn ọnạng ansong kw'uwa oge asilva mbọ k'mkpa samạna, antim asilva adwạkh-ọdwạk ankwu, p'm'antima andebh uchiattọhk ma e.”<verse eid="GEN 43:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 43:23" />Ọtọhmnạng nwọ oben bẹ́, “Tte nạngẹ bạnga ojor, udik ma ẹtaanga kòde. Ubinọkpaabyi kwabạnga, kw'ode Ubinọkpaabyi kw'atte kwabạnga, kk'bạnga akpokha ọnạnga k'mkpa sabạnga. Amma wa k'asilva p'abạnga atim adebh uchiattọhk ntạkha.” Ma wọ utim nnwotte kwabẹ Simeọn, utima uyin k'iyaan, okkena bẹ.<verse eid="GEN 43:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 43:24" />Ọtọhmnạng nwọ utima ajunung mbọ ọnwa k'ọchọhm kw'Josẹph, ọnạng bẹ asi p'abẹ atim akpobhu mfhok oche kw'ẹmmaana chabẹ ede, ọbạra ọnạng mmaam sabẹ uchiattọhk. <verse eid="GEN 43:24" /><verse number="25" style="v" sid="GEN 43:25" />Abẹ akwu ado ifor ọttạra nnạnga sabẹ atim, atik okpe kw'Josẹph m'ukpira, sabẹ kk'abhaanga bẹ́, abẹ m'aninga ma achi ọttọhk.<verse eid="GEN 43:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 43:26" />Masẹ Josẹph ukpir k'ọchọhm, abẹ atạkha nnạnga nnọ sabẹ kk'atima akwu ma ọchọhm, anạng-ẹ. Abẹ abạra arạkha attima ititikha sabẹ k'isek, anạng Josẹph ikpukpobha. <verse eid="GEN 43:26" /><verse number="27" style="v" sid="GEN 43:27" />Ọbạbh bẹ bẹ́, “Usi bạnga yạn o? Atte kw'iwu njọkha abạnga akpaakh-m udik akwuru, utim urukhu akpen kạkha o? Usi-ẹ yạn?”<verse eid="GEN 43:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 43:28" />Abẹ apọhna bẹ́, “Ọtọhmnạng kwọ kw'ode otte kwamạna utim uning akpen kạkha e, ifor ikpọkh-ẹ mạma.” Ma wọ abẹ atwung ncho, abạra aruru ifor sabẹ k'isek, anạng Josẹph ikpukpobha.<verse eid="GEN 43:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 43:29" />Masẹ Josẹph udir achen ose nnwọkka Bẹnjamin kw'ọkka wạnọ ọmaanẹ bẹ, n'ọbạbhọ bẹ́, “Nwotte nwọ kwabạnga kw'isạsạkhẹ kw'singwọ abạnga akpaakh-m udik atena wọ maa?” N'obeni bẹ, “Nnwa kwaam, tte Ubinọkpaabyi usi-ọ ọphyaam.” <verse eid="GEN 43:29" /><verse number="30" style="v" sid="GEN 43:30" />Masẹ Josẹph ose nnwọkka kwẹ <char style="it">bẹ jọọr, </char> ẹmạng ibir-ẹ, ọttạra k'ikwosi s'ifu-ẹ kha ettem. Ubina k'ẹbhạr-k'ẹbhạr urik bẹ ma, uyin k'iyaan oror ibyi s'm'uninga ọgạma. N'ofon kha ẹmaanggọ chẹ ẹtaanga ọta ọgạma ẹmạng.<verse eid="GEN 43:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 43:31" />Masẹ kk'ititikha okpobha, ubina kha ẹmangọ uyin k'iyaan, ọvạkha ifor sẹ, ukwu oben bẹ́, “Abera bẹ uchiattọhk.”<verse eid="GEN 43:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 43:32" />Wa abẹ aber Josẹph uchiattọhk pfẹ ọkhạmọ, abẹ abạra abera f'ivotte pẹ akhạmọ, abạra abera anạng p'Ijip p'aning ọttạra Josẹph uchiattọhk fabẹ akhạmọ. Wa akwẹ ode oche ngwọ ukwuru s'anạng p'Ijip atạk bẹ́, ode unyina-dik bẹ́, abẹ achi uchiattọhk ibyi rạnẹ ọttạra anạng p'Hiburu. <verse eid="GEN 43:32" /><verse number="33" style="v" sid="GEN 43:33" />Wa abẹ achokhu ivotte ẹyạr ator k'ọgbo f'abẹ ade, tạma k'ocheden tạrr ukpira k'okpongannạm kwabẹ. Wa abẹ n'abhạkhẹ akkeri ayok, s'udik okkonu bẹ k'oche kw'abẹ aseng achok bẹ ininga ator k'ọgbọ. <verse eid="GEN 43:33" /><verse number="34" style="v" sid="GEN 43:34" />K'okpe kw'abẹ akhebhi uchiattọhk f'ubin k'okpokkro kw'Josẹph, okhebh f'Bẹnjamin ọbạrẹ nden nsen ọyọhnga f'ayok phyibh. Wa abẹma phyibh achi uchiattọhk, abạra agwo atwuk Josẹph abẹ, tạrr ettem erebh ọnạng kwidede.<verse eid="GEN 43:34" /></para>
  <chapter eid="GEN 43" />
  <chapter number="44" style="c" sid="GEN 44" />
  <para style="s1">Josẹph ọnạngẹ ivotte pẹ eyoma</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 44:1" />Wa Josẹph ọtọhnọ ọtọhmnạng kw'ọchọhm kwẹ bẹ́, “Yikha uchiattọhk k'ajunung mbọ k'mkpa k'oche kw'abe m'akke atọhkha, bạra ge asilva p'ọnạng-ọnạng kk'ọnạnga k'ẹmma ch'ẹkpa chẹ. <verse eid="GEN 44:1" /><verse number="2" style="v" sid="GEN 44:2" />Atạkha nkkọbh kwaam kw'silva age k'ẹmma ch'ẹkpa ch'oyok kw'isạsạkhẹ, abạra atạkha asilva p'utim odebh uchiattọhk agẹ-ẹ ma ẹkpa.” Wa ọtọhmnạng nwọ usi oche kw'Josẹph ọtọhn-ẹ.<verse eid="GEN 44:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 44:3" />Ukwu ukpira s'iwu echobh, abẹ atọhm ajunung mbọ abhạna attạra nnyạnyaang sabẹ. <verse eid="GEN 44:3" /><verse number="4" style="v" sid="GEN 44:4" />Masẹ abẹ nạn eden-ibhir tạm náfona arik ofhon, Josẹph oben ọtọhmnạng kwẹ bẹ́, “Khubh ajunung mbọ k'eden. De akhebh bẹ, bạbh bẹ bẹ́, ‘Ode yạn kw'abạnga n'atim ipyibha atera ijibha ch'abẹ asi anạng bạnga o? <verse eid="GEN 44:4" /><verse number="5" style="v" sid="GEN 44:5" />Ode yạn kw'abạnga afu nkkọbh kw'aro kwaam n'utima ogwo asi, kw'n'ọbạra utima ọbhạrẹ ọsẹ o? Udik kw'abạnga ayom maa bạra upyibh.’ ”<verse eid="GEN 44:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 44:6" />Mase okhebh be k'eden, ọmmạnga itọhnga nnọ ọkpaak bẹ. <verse eid="GEN 44:6" /><verse number="7" style="v" sid="GEN 44:7" />Okhenka, abẹ aben-ẹ bẹ́, “Taa, Ubinọkpaabyi káchera! Ode yạn kw'aro kwamạna ọkkẹ bẹ́ amạna mba atọhmnạng pẹ m'ankke-okke ansi udik-demakwẹ ngwọ o? <verse eid="GEN 44:7" /><verse number="8" style="v" sid="GEN 44:8" />Anter antima asilva p'iwu nja anse k'mma s'mkpa samạna ẹtaanga, tạma k'isek s'Kenaan ankwu annik maa. Mbạng vọ n'abạra utima mạna amfu silva ọbạra ode gol k'ọchọhm kw'aro kwabạnga o? <verse eid="GEN 44:8" /><verse number="9" style="v" sid="GEN 44:9" />De ase ọnạng k'ikhaana s'atọhmnạng pọ kw'utim nkkọbh nwọ, tte ọnạng-khira nwọ ope echomajạne, amạna mba phyibh m'ambạra ande abira p'aro kwọ.”<verse eid="GEN 44:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 44:10" />Ọtọhmnạng nwọ n'obeni bẹ́, “Ọbaan ma. Tte ode oche kw'abạnga abeni. Ọnạng kwidede kw'amạna anse nkkọbh nwọ k'ẹkpa chẹ, ẹma nwọ bạra ode ubira kwaam, ma wọ m'antte ayok ọbọhk abẹ abhạna.”<verse eid="GEN 44:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 44:11" />Mạnna wọ ọnạng-ọnạng ọsạk ẹkpa chẹ k'isek k'ẹbhạr-k'ẹbhạr, ọbạra ọchaarẹ ẹkpa mma chẹ. <verse eid="GEN 44:11" /><verse number="12" style="v" sid="GEN 44:12" />Mạnna wọ ọtọhmnạng nwọ ọtạm k'mkpa s'adennạng ọfạngọ tạrr ukwu ukpira ch'oyok kw'isạsạkhẹ. N'ukwu ose nkkọbh nwọ k'ẹkpa ch'Bẹnjamin. <verse eid="GEN 44:12" /><verse number="13" style="v" sid="GEN 44:13" />Osenga ma, ivotte n'avạk ọvạra fabẹ k'ifor ayaakhẹ, abẹ adira ntọhkha sabẹ anạna k'nnyạnyaang, abhạkhẹ echo akpa nnạm k'ofhon kw'wạra abẹ abin.<verse eid="GEN 44:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 44:14" />Wa Josẹph utim uning kha ọchọhm okpe kw'Juda ọttạra ivotte pẹ akpir. Abẹ atto afhur-ufhur ma isisek, n'agạma ma akhẹ ititikha.<verse eid="GEN 44:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 44:15" />Ma wọ Josẹph obeni bẹ bẹ́, “Bạng udik-dema gwọ kw'abạnga ayom maa? Abạnga kásong bẹ́ ọnạng masẹ akhaam n'utima ọsẹ osonga idik s'm'iyin kha iwu oro o?”<verse eid="GEN 44:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 44:16" />Juda ubhina bẹ́, “Bạng udik gwọ kw'm'ambạra amkpaak aro kwamạna o? Bạng udik gwọ kw'm'antekh-ọ o? M'amkpaakh-ẹ yạn o? M'ansenga yạn ankọhkha bẹ́, mbọhk samạna iwur-uwur ma udik ngwa o? Ubinọkpaabyi kk'mpyibha samạna ọtạkha ọjẹ k'ọyaankpa, ẹma nwọ kw'nkọbh nwọ uning k'ẹkpa chẹ, ọttạra amạna mba phyibh n'ande abira p'aro kwamạna e.”<verse eid="GEN 44:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 44:17" />Okhenka, Josẹph obeni bẹ́, “Ubinọkpaabyi káchera! Bẹ́ amma nsi udik-khira ngwọ. Ọnạng nwọ kw'abẹ ase nkkọbh k'ẹkpa chẹ, ẹwọ m'ode ubira kwaam. Abạnga kha phyibh, asọhng abhạna akhebha atte kwabạnga k'idira.”<verse eid="GEN 44:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 44:18" />Ma wọ Juda ofon okhebha Josẹph, oben-ẹ bẹ́, “Aro kwaam, amma nkhaam udik kw'n'mben bẹ́ mkpaak ngiọ-ọ k'itọhng. Totokhạn, nạng-ọ ọdwạkhọ otena amma ọtọhmnạng kwọ. Amma nsong kha bẹ́ ẹfa chọ ede obengana ọttạra ch'Phero oyeni ma ifor sẹ.<verse eid="GEN 44:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 44:19" />“Wa ọma aro kwaam abạbhọ amạna mba atọhmnạng pọ bẹ́, ‘Abạnga akhaam atte ọttạra nnwọkka ọdwạkh-ọdwạk kạkha?’ <verse eid="GEN 44:19" /><verse number="20" style="v" sid="GEN 44:20" />Wa ammin-ọ bẹ́, ‘Ankhaam otte kha kw'kk'ọtạma, ambạra ankhaama nnwotte kw'otte kwamạna ofhonu k'atạm. Nnwọkka kw'abẹ ade ọkka wạnọ, kk'upua ẹma-ẹma wọ n'urikhi k'ọkka kwabẹ, ẹma ọdaakhẹ otte idik mororo.’<verse eid="GEN 44:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 44:21" />“Osenga ma, wa abeni amạna mba atọhmnạng pọ bẹ́, ‘Abạnga asọhng ata atim-ẹ akwu, ọfha ntima achen paam afa nsiẹ-ẹ.’ <verse eid="GEN 44:21" /><verse number="22" style="v" sid="GEN 44:22" />Wa amkpaakh-ọ bẹ́, ‘Otte kwamạna móchera bẹ́ otte nnwa nwọ ọbọhk ubina urikh-ẹ e, ukwuru bẹ́ de ubin urikh-ẹ, otte m'opope e.’ <verse eid="GEN 44:22" /><verse number="23" style="v" sid="GEN 44:23" />Okhenka, wa abeni amạna mba atọhmnạng pọ bẹ́, ‘Amma dạkhẹ bạnga ititikha saam mạ́nnạng, de abạnga nạn nnwatte kw'ode bạnga okpongannạm nátima akwu, nsẹ-ẹ.’ <verse eid="GEN 44:23" /><verse number="24" style="v" sid="GEN 44:24" />Masẹ amkpa nnạm anta ankhebha ọtọhmnạng kwọ, kw'ode otte kwamạna, amkpaakh-ẹ oche kw'ọma aro kwaam kk'mạna akpaakha.<verse eid="GEN 44:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 44:25" />“Ma ọ, masẹ otte kwamạna obeni bẹ́, ‘Abạnga abạra asọhng ata adebh uchiattọhk-nwa.’ <verse eid="GEN 44:25" /><verse number="26" style="v" sid="GEN 44:26" />Okhenka, wa ambeni bẹ́, ‘Amạna mánkke anta de nạnáchera bẹ́, antima nnwotte kwamạna anta. Ujunung nwọ kw'n'okpe uchiattọhk mạna ititikha mọ́nạng de nnwotte kwamạna kw'isạsạkhẹ nạn mạna abẹ nọ́twạna anta andebh uchiattọhk e.’<verse eid="GEN 44:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 44:27" />“Otte kwamạna kw'ode ọtọhmnạng kwọ obeni mạna bẹ́, ‘Abạnga asong ma bẹ́, wa ikwanạng kwaam ọmaan-m ajunungva afa. <verse eid="GEN 44:27" /><verse number="28" style="v" sid="GEN 44:28" />Oyok wạnọ k'akpen dạk kòde. K'udik ọkka, nten kk'ẹ ichia iyaakhẹ k'akpa-k'akpa. Tạma ma kpira maa, khẹ k'ichen kạ́nse. <verse eid="GEN 44:28" /><verse number="29" style="v" sid="GEN 44:29" />De abạnga abạra atima oyok nwa afona, ipyibha chidede ekhebh-ẹ k'eden, nnạm nọ́kpa, kw'uyini bẹ́, abạnga m'annọhng-m k'atạm ọttạra ikwosi.’<verse eid="GEN 44:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 44:30" />“Ma wọ ode bẹ́, de nnwa nwa nạn mạna abẹ nọ́twạna s'm'amkpa nnạm k'otte kwaam, kw'ode ọtọhmnạng kwọ, s'ettem che phyibh ẹkpạn ma nnwa nwọ, <verse eid="GEN 44:30" /><verse number="31" style="v" sid="GEN 44:31" />ukwu ose bẹ́ nnwa nwọ mạna abẹ nọ́twạna, m'opope e. <verse eid="GEN 44:31" /><verse number="32" style="v" sid="GEN 44:32" />Amma ọtọhmnạng kwọ ntạk mkparẹka k'ititikha s'otte kwaam, mben bẹ́, ‘Tte amma ntima akpen paam ntera echo chẹ, de nạn khẹ nạ́ntima nkwuna nkken-ọ!’<verse eid="GEN 44:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 44:33" />“Ma n'ode mạnna, aro kwaam, amma nchinọ-uchini, tima amma ọtọhmnạng kwọ masẹ ubira atera echo ch'nnwa nwa, ọfha atte ẹma ọbọhk ọtwạn ivotte pẹ abẹ ọbhạna. <verse eid="GEN 44:33" /><verse number="34" style="v" sid="GEN 44:34" />Amma eden kạ́nsong ch'm'nsenga mmạna ntor otte kwamạna, de nnwa nwọ nạn abaamẹ nọ́twạna ọbhạna. Mma o! Khaam ọbọhk kátte bẹ́ nta nse ọkhạnkhạmọ kw'udik ngwa m'ọnạng otte kwaam e.”<verse eid="GEN 44:34" /></para>
  <chapter eid="GEN 44" />
  <chapter number="45" style="c" sid="GEN 45" />
  <para style="s1">Josẹph ọyaakhẹ ifor sẹ ọnạng ivotte</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 45:1" />Masẹ Josẹph nạn adạkhẹ ifor sẹ nókke ọvạkha k'ititikha s'atọhmnạng pẹ, orengi ẹmạng ọgạma, ọbẹ́, “Tte ọnạng kwidede ubin-m k'ititikha!” Ma wọ, wa ukhikhennạng ọdwạkh-ọdwạk kw'uning ma okpe kw'Josẹph ọyaakhẹ ifor sẹ ọnạng ivotte pẹ, kòde. <verse eid="GEN 45:1" /><verse number="2" style="v" sid="GEN 45:2" />Wa Josẹph ọgạm ẹmạng k'ẹrạng tạrr anạng p'Ijip abhaanga, tạrr ẹchọhmfhạr ch'Phero ẹbạra ẹbhaanga ẹmạng ch'ọgạm.<verse eid="GEN 45:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 45:3" />Josẹph oben ivotte pẹ bẹ́, “Amma Josẹph wọ ma e! Otte kwaam utim urukhu akpen kạkha o?” Okhenka, wa ivotte pẹ khẹ kákke apọhna ukwuru ojora-khira f'ọvạk bẹ k'ititikha sẹ.<verse eid="GEN 45:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 45:4" />Josẹph oben ivotte bẹ́, “Abạnga atwạkhọ agbaar-m k'ifor.” Masẹ abẹ atwạkhọ agbaar-ẹ, oben bẹ bẹ́, “Amma wọ nde Josẹph, nnwotte kwabạnga, kw'uwa abạnga akpe anạng aseng-mphya p'Ijip. <verse eid="GEN 45:4" /><verse number="5" style="v" sid="GEN 45:5" />Tte nttem nạngẹ bạnga ẹmma iphyaangẹ. Abạnga ayok kábạra apyima s'abạnga akpe-m anạng maa, ukwuru bẹ́ Ubinọkpaabyi oben bẹ́ ugim-ugim ọtọhm-m ma, ọfha osenga amma abẹ ọkkaana akpen p'ayokhanạng. <verse eid="GEN 45:5" /><verse number="6" style="v" sid="GEN 45:6" />N'ode icho ifa maa s'okwo f'ididen uning ma ẹkhạma nja, k'icho isen kha oro, anạng ekpo mátubh, abẹ mábạra aphya. <verse eid="GEN 45:6" /><verse number="7" style="v" sid="GEN 45:7" />Okhenka, wa Ubinọkpaabyi ugim-ugim ọtọhm-m maa bé, nkkaana nchok abạnga ma mba bạnọ akpen maa ọyagbin, ọfha mbạra nnạng bạnga ẹnnaanga chididen.<verse eid="GEN 45:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 45:8" />“Ma o, abạnga ma asạng asi, Ubinọkpaabyi wọ wa ọtọhm-m ma. Usi-m bẹ́ nde ọvaar kw'ajukwa p'Phero phyibh, ọttạra aro kw'ọchọhm kwẹ, ọttạra ọdạbhẹ kw'anạng p'Ijip phy-phyibh. <verse eid="GEN 45:8" /><verse number="9" style="v" sid="GEN 45:9" />Abạnga akpa nnạm ẹbhạr-ẹbhạrẹ, ata akpaak otte kwaam bẹ́, Nnwa kwọ Josẹph ọtọhmọ ẹkkaabha okken-ọ bẹ́, ‘Ubinọkpaabyi kk'aam ẹvaar ch'Ijip phyi-phyibh ọnạnga. Okpe kákhibhi, jekha akwu akhebh-m kha ibyi s'nning. <verse eid="GEN 45:9" /><verse number="10" style="v" sid="GEN 45:10" />Ọma otte kwaam, ọttạra iva pọ, ọttạra iva p'iva pọ, ọttạra itirakpo pyọ, ọttạra ẹkhaama chọ phyibh, m'aruk k'ukhubha kw'Goshẹn, ọfha annuk ambaanga ayok. <verse eid="GEN 45:10" /><verse number="11" style="v" sid="GEN 45:11" />Ma Goshẹn wọ mạnkker-ọ, ukwuru bẹ́ okwo f'ididen utim uning kha oro. Nạn mạnna núdia, ọma ọttạra ẹchọhmfhạr chọ, ọttạra itirakpo pyọ phyibh m'atto okpor.’<verse eid="GEN 45:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 45:12" />“Abạnga ma phyibh ọttạra nnwọkka kwaam Bẹnjamin kk'asia bẹ́ k'udik ọkka, amma Josẹph wọ n'mkpaak bạnga abẹ maa. <verse eid="GEN 45:12" /><verse number="13" style="v" sid="GEN 45:13" />Abạnga akpaak otte kwaam abạrada-hira p'nkhaam k'Ijip, abạra akpaakh-ẹ udik kwidede kw'abạnga kk'asia. Abạnga asọhng ẹbhạr-ẹbhạrẹ, ata atạkha otte kwaam akwu.”<verse eid="GEN 45:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 45:14" />Ma wọ, Josẹph ọgaar nnwọkka Bẹnjamin, abẹ abaakha ayok nttem, agạma. <verse eid="GEN 45:14" /><verse number="15" style="v" sid="GEN 45:15" />Wa Josẹph ọgạm ẹmạng utima ọbaakha ivotte pẹ phyibh. Masẹ kk'usia mạnna, ma wọ ivotte pẹ n'akhaam ottembạr akpaak abẹ idik.<verse eid="GEN 45:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 45:16" />Masẹ ẹgạma njọ ikpir k'ọvaarter kw'Phero bẹ́ ivotte pa Josẹph kk'akwua k'Ijip, wa akwẹ orebhi Phero ọttạra anạng pẹ phyibh ettem. <verse eid="GEN 45:16" /><verse number="17" style="v" sid="GEN 45:17" />Phero oben Josẹph bẹ́, Kpaak ivatte pọ bẹ́, Udik kw'abạnga m'asi ode bẹ́, abạnga m'atạkha ekpo pyabạnga anạna itirakpo pyabạnga, ọfha abạnga abhạna k'ẹkhạma ch'Kenaan, <verse eid="GEN 45:17" /><verse number="18" style="v" sid="GEN 45:18" />abạnga abạra atima atte kwabạnga, ọttạra ichọhmfhạr sabạnga akwu k'Ijip. Amma m'nnạng bạnga ukhubha kw'isisek ijibhi ọtạm, ọfha abạnga akhaama ekpo k'ọsaabh ma.<verse eid="GEN 45:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 45:19" />Bạra kpaak bẹbẹ́, “Udik kw'abạnga m'asi ode bẹ́, ‘Abạnga atạkha ijaar sididen s'nnyạnyaang n'itwạr ma k'Ijip, atima ata atạkha iva pabạnga, ọttạra ipanạng pabạnga, ọttạra atte kwabạnga, atima akwu. <verse eid="GEN 45:19" /><verse number="20" style="v" sid="GEN 45:20" />Tte udik kw'oten k'ẹkhaama chabạnga nạngẹ bạnga ẹmma ọphyaangẹ, ukwuru bẹ́, ukhubha kw'isisek ijibhi ọtạm k'Ijip, ọkhaam abạnga ma.’ ”<verse eid="GEN 45:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 45:21" />Mạnna wọ wa iva p'Jekọb asi udik kwidede kw'abẹ atọhnọ bẹ. Josẹph ọnạngẹ ivotte pẹ akpaar p'ẹbhạr pididen, otor k'ẹfa ch'ọvaar Phero kk'ọnạnga, ọbạra ọnạng bẹ uchiattọhk f'abẹ m'achi k'eden. <verse eid="GEN 45:21" /><verse number="22" style="v" sid="GEN 45:22" />Ọnạngẹ ọnạng-ọnạng ọvạra ọbhapfhẹ, oyongu Bẹnjamin kw'ọnạng-ẹ ashẹkẹl arạbh chi p'silva, ọttạra ọvạra ọdwạkh-ọdwạk akhira asen. <verse eid="GEN 45:22" /><verse number="23" style="v" sid="GEN 45:23" />Wa Josẹph ọtạk nnyạnyaang-dim jobh s'itọhk ẹkka-kpo p'Ijip, ọttạra nnyạnyang-pa jobh s'itọhk agwu ọttạra brẹd, ọttạra uchiattọhk ọdwạkh-ọdwạk f'otte m'uchi k'eden. <verse eid="GEN 45:23" /><verse number="24" style="v" sid="GEN 45:24" />Ma wọ, masẹ kk'bẹ ekpo mbyọ okhebha phyibh, oben abẹ asọhng. Masẹ abẹ abin osenga, oben bẹ bẹ́, “Abạnga ẹkhọr k'eden kasi o!”<verse eid="GEN 45:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 45:25" />Ma o, abẹ abina k'Ijip akwu akhebha otte kwabẹ Jekọb k'ẹkhạma ch'Kenaan. <verse eid="GEN 45:25" /><verse number="26" style="v" sid="GEN 45:26" />Masẹ abẹ akwu akpira, abẹ akpaak otte, bẹ́, “Attitte o, Josẹph utim urukhu akpen kạkha e! Ẹma wọ n'ọdabhẹ Ijip phyibh e!” Jekọb okkon-ẹ, udik ngwọ nọ́tạkha masẹ udik ọkka. <verse eid="GEN 45:26" /><verse number="27" style="v" sid="GEN 45:27" />Okhenka, masẹ abẹ n'akpaakhẹ udik kwidede kw'Josẹph kk'bẹ ọkpaakha, ọbạra ose ijaar sididen s'nnyạnyaang n'itwạr s'Josẹph kk'ọtọhmọ bẹ́, akwu atạkhẹ atima afona k'Ijip, ifor ikpọkhọ Jekọb <verse eid="GEN 45:27" /><verse number="28" style="v" sid="GEN 45:28" />Ma wọ Jekọb obeni bẹ́, “Akwẹ ode udik ọkka e, nnwa kwaam Josẹph utim urukhu akpen kạkha e. Oyonga m'nta k'Ijip nta nsiẹ-ẹ bạrasẹ mpe.”<verse eid="GEN 45:28" /></para>
  <chapter eid="GEN 45" />
  <chapter number="46" style="c" sid="GEN 46" />
  <para style="s1">Jekọb ọttạra ẹchọhmfhạr chẹ afon k'Ijip</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 46:1" />Ma wọ Jekọb ubin osenga ọttạra ọttọhk fidede f'ode pfẹ. Masẹ ukwu ukpira k'Beershẹba, ọfọhnọ ẹja ma ọnạng Ubinọkpaabyi kw'otte kwẹ Isaak okpobh.<verse eid="GEN 46:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 46:2" />Ukwu ukpira k'irungu, Ubinọkpaabyi uyin Jekọb abẹ k'idachen, oyer-ẹ bẹ́, “Jekọb! Jekọbh o!”</para>
  <para style="p" vid="GEN 46:2">Jekọb ochera bẹ́, “Kkeri amma ma e.”<verse eid="GEN 46:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 46:3" />Ma wọ obeni bẹ́, “Amma wọ nde Ubinọkpaabyi kw'atte kwọ okpobh. Tte nạng-ọ ojor s'm'afona k'Ijip, ukwuru bẹ́, mạma wọ m'nsi-ọ ade ẹkhạma chididen. <verse eid="GEN 46:3" /><verse number="4" style="v" sid="GEN 46:4" />Amma m'ntwạn abọ mfona k'Ijip, mbạra ntim-ọ mkpa nnạm. Josẹph wọ ode ọnạng kw'm'ububh-ọ achen k'obo.”<verse eid="GEN 46:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 46:5" />Wa Jekọb ubin k'Beershẹba, iva pẹ atim ẹma otte kwabẹ, ọttạra iva pabẹ, ọttạra ipanạng pabẹ, ayikha k'ijaar sididen s'nnyạnyaang n'itwạr, s'Phero kk'ọtọhma bẹ́, abẹ atima atọhkha otte. <verse eid="GEN 46:5" /><verse number="6" style="v" sid="GEN 46:6" />Wa Jekọb ọttạra iva pẹ, ọttạra iva p'iva phyibh atim itirakpo pyabẹ, ọttạra ẹkhaama ch'abẹ kk'asia k'Kenaan, afona k'Ijip. <verse eid="GEN 46:6" /><verse number="7" style="v" sid="GEN 46:7" />Jekọb utim ajunungva ọttạra iva pabẹ, ọttạra apanạngva pẹ, ọttạra iva pabẹ, ọttạra ẹchọhmfhạr chẹ kubungu, ofona Ijip.<verse eid="GEN 46:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 46:8" />Maa wọ ode ache p'ajunungva p'Jekọb, p'afon k'Ijip:</para>
  <para style="q1" vid="GEN 46:8">Reubẹn kw'ode ochedennwa kw'Jekọb.<verse eid="GEN 46:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 46:9" />Ajunungva p'Reubẹn ade:</para>
  <para style="q2" vid="GEN 46:9">Hanọk, ọttạra Palu,</para>
  <para style="q3" vid="GEN 46:9">Hẹzrọn, ọttạra Karmi.<verse eid="GEN 46:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="GEN 46:10" />Ajunungva p'Simeọn ade:</para>
  <para style="q2" vid="GEN 46:10">Jemuyẹl, ọttạra Jamin,</para>
  <para style="q3" vid="GEN 46:10">ọttạra Ọhad, ọttạra Jakin,</para>
  <para style="q3" vid="GEN 46:10">ọttạra Zoha,</para>
  <para style="q3" vid="GEN 46:10">ọttạra Shaul kw'ode ujunungnwa kw'ikwanạng kwẹ kw'ubin Kenaan ọmaanẹ.<verse eid="GEN 46:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 46:11" />Ajunungva p'Lẹvi ade:</para>
  <para style="q2" vid="GEN 46:11">Gershọn, ọttạra Kohat</para>
  <para style="q3" vid="GEN 46:11">ọttạra Mẹrari.<verse eid="GEN 46:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 46:12" />Ajunungva p'Juda ade:</para>
  <para style="q2" vid="GEN 46:12">Ẹr, ọttạra Ọnan, ọttạra Shẹla,</para>
  <para style="q3" vid="GEN 46:12">ọttạra Pẹrẹz, ọttara Zẹra (okhenka, wa Ẹr ọttạra Ọnan kk'apua kha Kenaan).</para>
  <para style="q1" vid="GEN 46:12">Ajunungva p'Pẹrẹz ade:</para>
  <para style="q2" vid="GEN 46:12">Hẹzrọn ọttạra Hamul.<verse eid="GEN 46:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 46:13" />Ajunungva p'Isaka ade:</para>
  <para style="q2" vid="GEN 46:13">Tola, ọttạra Pua, ọttạra Jashub,</para>
  <para style="q3" vid="GEN 46:13">ọttạra Shimrọn.<verse eid="GEN 46:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 46:14" />Ajunungva p'Zẹbulun ade:</para>
  <para style="q2" vid="GEN 46:14">Sẹrẹd, ọttạra Ẹlọn, ọttạra Jalẹl.<verse eid="GEN 46:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 46:15" />Maa wọ ode ajunungva p'uwa Lea ọmaanẹ ọnạng Jekọb k'Padan-Aram, de akpẹrẹ Daina kw'ode ọkwanạng-nwa kwẹ achok ọkhaan-ọkhaan. Wa iva mbọ pẹ phyi-phyibh, adikkobh ọttạra aminava, ade ẹrạbh ukuma jobh-kantaan.<verse eid="GEN 46:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 46:16" />Ajunungva pa Gad ade:</para>
  <para style="q2" vid="GEN 46:16">Ziphon, ọttạra Hagi,</para>
  <para style="q3" vid="GEN 46:16">ọttạra Shuni, ọttạra Ẹzbọn,</para>
  <para style="q3" vid="GEN 46:16">ọttạra Eri, ọttạra Arodi, ọttạra</para>
  <para style="q3" vid="GEN 46:16">Areli.<verse eid="GEN 46:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 46:17" />Ajunungva p'Asha ade:</para>
  <para style="q2" vid="GEN 46:17">Imna,</para>
  <para style="q3" vid="GEN 46:17">ọttạra Ishva, ọttạra Ishvi,</para>
  <para style="q3" vid="GEN 46:17">ọttạra Beriya.</para>
  <para style="q2" vid="GEN 46:17">Nnwọkka kwabẹ kw'ikwanạng wa ode Sera.</para>
  <para style="q2" vid="GEN 46:17">Ajunungva p'Beriya ade:</para>
  <para style="q2" vid="GEN 46:17">Hebẹr, ọttạra Malkiyẹl.<verse eid="GEN 46:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 46:18" />Wa iva chikawạnọ ẹbọ p'Zilpa ọmaanẹ ọnạng Jekọb. Zilpa wa ode ubira kw'Laban kk'ọtạkha ọnạng uminanwa kwẹ Lea bẹ́, uruk Lea abẹ.<verse eid="GEN 46:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 46:19" />Ajunungva p'Jekọb ofonu k'ikwanạng kwẹ Rachẹl ade Josẹph ọttạra Bẹnjamin. <verse eid="GEN 46:19" /><verse number="20" style="v" sid="GEN 46:20" />Asenat kw'ode uminanwa kw'Potiphera, kw'ode ọfọhnẹja k'On, ọmaanẹ Manasẹ ọttạra Ephraim ọnạng Josẹph k'Ijip.<verse eid="GEN 46:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 46:21" />Ajunungva p'Bẹnjamin ade: Bẹla, ọttạra Bẹkẹr, ọttạra Ashbẹl, ọttạra Gẹra, ọttạra Naaman, ọttạra Ehi, ọttạra Rosh, ọttạra Mupim, ọttạra Hupim, ọttạra Ard.<verse eid="GEN 46:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 46:22" />Ajunungva phyi-phyibh p'Rachẹl ọmaanẹ ọnạng Jekọb ade sọnaachi.<verse eid="GEN 46:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 46:23" />Dan ofonu ujunung kw'okpen Hushim.<verse eid="GEN 46:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 46:24" />Ajunungva p'Naphtali ade: Jazẹl, ọttạra Guni, ọttạra Jẹzẹr, ọttạra Shilẹm.<verse eid="GEN 46:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 46:25" />Phyi-phyibh, iva p'Bilha kw'ode ubira kw'uwa Laban ọnạng uminanwa kwẹ Rachẹl ọmaanẹ ọnạng Jekọb, ade ncho nsenọfa.<verse eid="GEN 46:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 46:26" />Wa ọnạng-mik kw'ọtwạnọ Jekọb abẹ ofona k'Ijip, ode arạbh attaan ukuma asajạnẹ, de akpẹrẹ ipanạng p'iva pẹ ajẹ, anạng mbọ phyibh wa abẹ abin k'ẹnạmma ch'Jekọb. <verse eid="GEN 46:26" /><verse number="27" style="v" sid="GEN 46:27" />De n'atạk ajunungva afa p'Josẹph ofonu k'Ijip attạra, ọnạngmik phyi-phyibh kw'ẹchọhmfhạr ch'Jekọb kw'ofon k'Ijip ode arạbh attaan ukuma jobh.<verse eid="GEN 46:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 46:28" />Ma wọ Jekọb ọtọhmọ Juda bẹ́ uchi eden oseng ọta okhebha Josẹph, ọbạbh ibyi s'Goshen uning. Masẹ abẹ akpir k'ukhubha kw'Goshen, <verse eid="GEN 46:28" /><verse number="29" style="v" sid="GEN 46:29" />Josẹph ọnạng ẹfa bẹ́ abẹ atạkha ijaar sididen s'nnyạnyaang n'itwạr atima akwu, ọfha ọta ose otte kwẹ Israẹl s'kk'ukpira kha Goshẹn. Masẹ Josẹph ose otte <char style="it">bẹ jọọr</char>, ọgaara otte mbọhk k'ikhạkhora, ọbạra ọgạma ẹmạng eden ibhir.<verse eid="GEN 46:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 46:30" />Jekọb oben Josẹph bẹ́, “Masẹ amma kk'nsia k'udik ọkka bẹ́ ọma atim arukhu akpen kha, k'ifor s'obo ndia e.”<verse eid="GEN 46:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 46:31" />Ma wọ Josẹph obeni ivotte pẹ ọttạra ẹchọhmfhạr ch'otte kwẹ bẹ́, “Amma bạra mfona k'Phero nta mkpaakh-ẹ bẹ́, ‘Ivotte paam, ọttạra ẹchọhmfhạr ch'otte kwaam, p'uwa arukhu k'ẹkhạma ch'Kenaan, kk'akwuna ator-m kha e. <verse eid="GEN 46:31" /><verse number="32" style="v" sid="GEN 46:32" />Ajunung mbọ ade akkeri-arakhạmaan, abẹ kk'akwua ọttạra nten sabẹ, ọttạra ọttọhk f'idede f'ode fabẹ.’ ” <verse eid="GEN 46:32" /><verse number="33" style="v" sid="GEN 46:33" />N'ọbhạkhẹ oben ivotte pẹ bẹ́, “De Phero oyeri bạnga, ọbạbh bạnga bẹ́, ‘Mbạng vọ ode ọbọhktọhm fabạnga?’ <verse eid="GEN 46:33" /><verse number="34" style="v" sid="GEN 46:34" />Abhina bẹ́, ‘Aro, amạna mba atọhmnạng pọ antạm k'ẹvava n'antir nten masẹ ab'otte pamạna e.’ M'osenga ma otte bạnga ọbọhk, abạnga aruk k'Goshẹn, ukwuru bẹ́, anạng pa n'akkeri arạkhạmaan abạkhọ anạng p'Ijip idik k'eden-tạma.”<verse eid="GEN 46:34" /></para>
  <chapter eid="GEN 46" />
  <chapter number="47" style="c" sid="GEN 47" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 47:1" />Wa Josẹph ubin ọta ọkpaak Phero bẹ́, “Otte kwaam ọttạra ivotte paam kk'abina k'Kenaan akpira ma Goshẹn ọttạra itirakpo pabẹ oseng k'ẹkhaama chabẹ phyibh.” <verse eid="GEN 47:1" /><verse number="2" style="v" sid="GEN 47:2" />Ma wọ, Josẹph orengi ivotte pẹ anạng asen, utima ọta ọkhọkha Phero.<verse eid="GEN 47:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 47:3" />Phero ọbạbh ivotte mbọ pẹ bẹ́, “Mbạng vọ ode ọbọhktọhm fabạnga?” Abẹ abhin-ẹ bẹ́, Aro, iva pọ ade akkeri-nten, masẹ ab'otte pamạna e. <verse eid="GEN 47:3" /><verse number="4" style="v" sid="GEN 47:4" />Wa abẹ abạra aben Phero bẹ́, “Amạna kk'ankwua bẹ́, ankwu annuk ma Goshẹn k'okpe nwa sạsạkhẹ, ukwuru okwo f'ididen f'uning kha Kenaan, ọbạrẹ osengeden, asạsaarẹ kha dạk kade p'nten m'ichi. Ẹgwọ usi, aro, n'anchin-ọ bẹ́, atte mạna ọbọhk annuk ma Goshẹn.”<verse eid="GEN 47:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 47:5" />Osenga ma, Phero oben Josẹph bẹ́, “Masẹ atte ọttạra ivotte pọ kk'akwua akhebh-ọ kha, <verse eid="GEN 47:5" /><verse number="6" style="v" sid="GEN 47:6" />isisek s'Ijip phyibh ining k'akhọ k'mbọhk, tekha ibyi s'asong bẹ́, ijibh-ujibh nạng bẹ, abẹ aninga. Tte abẹ aruk k'ukhubha kw'Goshẹn. Ode asong anạng kabẹ k'ngekha p'akke emenka ch'ọtọhm, tạkha nten saam nạng bẹ, abẹ agba akkeri.”<verse eid="GEN 47:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 47:7" />Ma wọ, Josẹph utim otte ọta ọkhọkha Phero. Jekọb usima Phero, ọyọbh-ẹ itta. <verse eid="GEN 47:7" /><verse number="8" style="v" sid="GEN 47:8" />Masẹ Phero ose bẹ́, Jekọb k'ọtạma, n'ọbạbh-ẹ bẹ́, “Ọmoyeni ade icho iphyaang?”<verse eid="GEN 47:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 47:9" />Jekọb ubhini Phero bẹ́, “Amma k'icho arạbh asajạnẹ ukuma jobh nnukha, nsanga ọyagbin. Icho s'amma kk'nnukha nisaabha, okhenka ode bẹ́, isaabhẹ ọkhạnkumọ, asẹ icho s'uwa ab'otte paam arukhu nikpira.” <verse eid="GEN 47:9" /><verse number="10" style="v" sid="GEN 47:10" />Jekọb ọbạra ọyọbh Phero itta ottong nden nfa, bạrasẹ n'ofon.<verse eid="GEN 47:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 47:11" />Mạnna wọ, Josẹph ọtạk ibyi ikkasẹ nnọ s'kk'otekha k'Ijip, k'ẹkhạma ch'Rameses, ọnạng otte ọttạra ivotte pẹ bẹ́, abẹ aruk, k'oche kw'Phero khẹ ẹfa ọnạnga bẹ́, usi. <verse eid="GEN 47:11" /><verse number="12" style="v" sid="GEN 47:12" />Josẹph ọbạra ọtạkha uchiattọhk f'm'obenga otte ọttạra ivotte pẹ, ọttạra ẹchọhmfhạr ch'otte phyibh, ọnạng bẹ otor k'oche kw'ubhik kw'iva pabẹ ade.<verse eid="GEN 47:12" /></para>
  <para style="s">Okwo f'ididen uning k'Ijip</para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 47:13" />Uchiattọhk mvọ f'uwa nạn ode ma ẹkhạma njọ phyibh, wa usi anạng p'Ijip ọttạra p'Kenaan ase irem sididen. <verse eid="GEN 47:13" /><verse number="14" style="v" sid="GEN 47:14" />Wa Josẹph otobha akpokha phyibh pabẹ akpe, anạng p'Ijip ọttạra p'Kenaan uchiattọhk, utima ofona k'ọvaarchọhm kw'Phero. <verse eid="GEN 47:14" /><verse number="15" style="v" sid="GEN 47:15" />Masẹ akpokha kk'anạng p'Ijip ọttạra p'Kenaan ẹsa k'mbọhk, anạng p'Ijip phyibh abin ata akhebha Josẹph aben-ẹ bẹ́, “Akpokha k'mạna ẹsa k'mbọhk e, ukwuru yạn kw'm'akkeri mạna ampe k'okwo o? Nạng mạna uchiattọhk.”<verse eid="GEN 47:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 47:16" />Ma wọ, Josẹph ubhin bẹ bẹ́, “Ode akpokha k'bạnga ẹsa k'mbọhk, abạnga atima itirakpo p'abạnga akwu, ọfha anchi nfhona ọttạra uchiattọhk.” <verse eid="GEN 47:16" /><verse number="17" style="v" sid="GEN 47:17" />Mạnna wọ abẹ afon ata atạkha itirakpo p'ạbẹ, nnyạnyaang, ọttạra arạkhạmaan, mvu, ọttạra mmaam, atima akkena Josẹph, ọfha ọnạng bẹ uchiattọhk. Cho ngwọ anạng mbọ atim itirakpo pabẹ achi nfona ọttạra uchiattọhk f'Josẹph n'ọnạng bẹ.<verse eid="GEN 47:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 47:18" />Masẹ cho ngwọ k'osenga, anạng p'Ijip ata aben Josẹph bẹ́, “Aro kwamạna, udik udubhakwẹ sạng mama-e, udik ubungukwẹ ode bẹ́, masẹ k'akpokha k'mạna ẹsa, itirakpo p'amạna n'ede pọ, oyonga ifor samạna, ọttạra asisek p'amạna mạnkkeni, ọttọhk f'm'ambạra annạng-ọ dạk kode e. <verse eid="GEN 47:18" /><verse number="19" style="v" sid="GEN 47:19" />Totokhạn aro, mạna ọbọhk kátte ampe k'okwo, annik asisek p'amạna. Debh mạna ọttạra asisek p'amạna, ọfha ankhaama uchiattọhk f'm'anchi. K'ifor andia bẹ́, ọvaar Phero ọtạkha mạna masẹ abira pẹ, ọbạra ọtạkha asisek p'amạna ọkhaama. Khenka nạng mạna uchiattọhk f'm'anchi ọttạra ekpo itubhapẹ, ọfha antima annuk akpen, ọfha isisek s'amạna nạngẹ idwukhu ining.”<verse eid="GEN 47:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 47:20" />Ma wọ, wa okwo f'ididen mvọ ọkpọhkhọ k'Ijip tạrr anạng p'Ijip atạkha asisek pfabẹ phyibh akpe anạng Josẹph, kw'odebhi fhẹ ọnạng ọvaar Phero, <verse eid="GEN 47:20" /><verse number="21" style="v" sid="GEN 47:21" />Wa Josẹph utim anạng mbọma mase abira, nasi ọtọhm k'ẹkhạma ch'Ijip phyibh, anạng Phero. <verse eid="GEN 47:21" /><verse number="22" style="v" sid="GEN 47:22" />Okhẹnka ode bẹ́, asisek p'afọhnẹja mạnkkeni bọ p'uwa nạn odebha, ukwuru bẹ́, wa phero n'ọnạng bẹ okhebh pf'akpokha k'ọtọhm pf'abẹ n'asi, abẹ abạra akhaama uchiattọhk f'obengi bẹ, ọbạra obek. Ẹgwọ usi wa abẹ asisek p'abẹ nákpua.<verse eid="GEN 47:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 47:23" />Ma wọ, Josẹph n'oben anạng p'Ijip bẹ́, “Chemma, amma k'bạnga ndebha ọttạra asisek p'abạnga phyibh nnạng ọvaar Phero, abạnga atạk eborakpo mba ata atạma tutubh. <verse eid="GEN 47:23" /><verse number="24" style="v" sid="GEN 47:24" />Okpe kw'abạnga asi iphya, akhebh ichiakpo mbọ k'akwung asen, atạkha ukwung gwạnọ achok ọvaar Phero, akwung mbọkha annebung, abạnga achok itubhapẹ, ọttạra ichia-pẹ pabạnga ọttạra iva.”<verse eid="GEN 47:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 47:25" />Ma wọ, abẹ abhin-ẹ bẹ́, “Iyaa, amạna k'anchera, ọma k'akpen pamạna akkaana e. Tte antạkha ọphyaam k'ititikha s'aro kwamạna, k'anchera bẹ́, m'ande abira p'Phero e.”<verse eid="GEN 47:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 47:26" />Osenga ma, Josẹph n'ochokhu kwe mase inyina k'isek s'Ijip, tạma ma iwu njọ tạrr kpira chemma, abẹ n'akhebh iphya kpo p'abẹ k'akwung asen, atạkha ukwung gwạnọ achok ọvaar Phero. Asisek p'afọhnẹja mạnkkeni bọ p'uwa nạn p'Phero nadia.<verse eid="GEN 47:26" /></para>
  <para style="s">Udik kwa Jekọb ophyemi</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 47:27" />Wa anạng p'Israẹl arukhu k'Goshẹn ma k'Ijip, ma wọ abẹ akhaama ẹkhaama k'ọsaabh, abạra amaan iva k'osaabh.<verse eid="GEN 47:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 47:28" />Wa Jekọb urukhu k'Ijip icho chikhamfa, phyi-phyibh, wa Jekọb urukhu acho arạbh asenọfa ukuma isenọfa. <verse eid="GEN 47:28" /><verse number="29" style="v" sid="GEN 47:29" />Masẹ Israẹl ọkẹ bẹ obo kwẹ k'ofora, oyeri nnwa kwẹ Josẹph, oben-ẹ bẹ́, “Ode k'ọphyaam nkhaama k'akhọ k'ititikha, ge ọbọhk kwọ k'ntaak saam atạkha echekha bẹ́, ode mpe, khaam ma Ijip mannọhnga, <verse eid="GEN 47:29" /><verse number="30" style="v" sid="GEN 47:30" />tạkha apfura paam bina k'Ijip, ntor ab'otte paam, ata annọhng-m k'ibyi sabẹ annọhng.”</para>
  <para style="p" vid="GEN 47:30">Ma wọ, Josẹph ubhin bẹ, “Attitte kwaam, m'nsi oche kw'abeni.”<verse eid="GEN 47:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 47:31" />Jekọb n'oben-ẹ bẹ, “Chekhi k'akhaam k'ititikha.” Osenga ma, Josẹph ọtạkha echekha k'otte k'ititikha, Israẹl ọrạkha echo ọnạna k'uchikwura kwẹ, ọnạng Ubinọkpaabyi isima.<verse eid="GEN 47:31" /></para>
  <chapter eid="GEN 47" />
  <chapter number="48" style="c" sid="GEN 48" />
  <para style="s1">Jekọb ọyọbh iva p'Josẹph itta</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 48:1" />Wa abẹ atekhi Josẹph bẹ́, “Atte ọmmẹ-ẹmma e.” Josẹph ubina ọttạra ajunungva pẹ afa, Manasẹ ọttạra Ephraim, ọta ose otte Jekọb kha Goshẹn. <verse eid="GEN 48:1" /><verse number="2" style="v" sid="GEN 48:2" />Masẹ abẹ atekhi Jekọb bẹ, “Nnwa kwọ Josẹph k'ukwua bẹ ukwu usi-ọ,” mạnna wọ kw'Israẹl okhong ubina k'ibhikha ch'uyim, uninga ẹyạr.<verse eid="GEN 48:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 48:3" />Ma wọ, Jekọb n'obeni Josẹph bẹ́, “Ubinọkpaabyi kw'ẹfa phyibh uyini-okhebh-m k'Luz, kha Kenaan, odo-m <verse eid="GEN 48:3" /><verse number="4" style="v" sid="GEN 48:4" />ọbạra oben-m bẹ́, ‘Amma m'nạng-ọ iva k'ọsaabh, m'nsi-ọ ade ofhon ubungukwẹ, mbạra nạng-ọ isisek nna, ide sọ, ọttạra s'iva pọ tạrr ipimmanitor.’<verse eid="GEN 48:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 48:5" />“Mantọhmma, iva mba afa p'afhonu k'Ijip brasẹ amma n'nkwu, Ephraim ọttạra Manasẹ, m'abạra ade paam, oche kw'Reubẹn, ọttạra Simeọn ade. <verse eid="GEN 48:5" /><verse number="6" style="v" sid="GEN 48:6" />Iva adwạkh-ọdwạk p'm'afhon bọ m'ade pọ. Iva mbọ p'ade pọ m'atạkha okhebh pf'ebochia chabẹ k'Efrem, ọttạra Manasẹ. <verse eid="GEN 48:6" /><verse number="7" style="v" sid="GEN 48:7" />Ikwosi saam ikhenka ide bẹ, s'mbin k'Padan-Aram nkwuna, wa Rachẹl ope k'eden s'antim aning k'osenga k'Kenaan, kw'ọbaang Ẹphrat. Ma wọ, wa nnọng-ẹ k'eden ọkhaan-ọkhaan ch'Ẹphrat (kw'ode Bẹtẹlẹhẹm).”<verse eid="GEN 48:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 48:8" />Ma wọ, masẹ Israẹl ose iva p'Josẹph, ọbạbh bẹ, “Bạng anạng bọ khạkha o?”<verse eid="GEN 48:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 48:9" />Josẹph ubhina otte bẹ́, “Attitte, iva p'Ubinọkpaabyi ọnạng-m bọ ma e.”</para>
  <para style="p" vid="GEN 48:9">Ma wọ, Jekọb n'obeni bẹ́, “Tima bẹ kwu, ọfha nyọbh bẹ itta.”<verse eid="GEN 48:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 48:10" />Ma okpe ngwọ, Jekọb k'ọtạma, dạkhẹ iyaan k'nóse. Ma wọ, Josẹph utim iva mbọ afa ọtwukhọ ọgbaara otte k'ifor, otte ọbaakh bẹ ettem, usima be.<verse eid="GEN 48:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 48:11" />Masẹ kk'Israẹl ọbaakha, n'ọbhạkhẹ oben Josẹph bẹ, “Amma ichen nạnchokha bẹ́, mạmbạra nse ititikha sọ, mạntọhmma, ititikha sọ mạnkkeni sạng s'nse, Ubinọkpaabyi kk'usia bẹ, tte mbạra nse iva pọ.”<verse eid="GEN 48:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 48:12" />Osenga ma, Josẹph n'ọrạbh iva mbọ k'ntaak s'otte, utima bẹ uttima ititikha k'isek ma ititikha s'Jekọb. <verse eid="GEN 48:12" /><verse number="13" style="v" sid="GEN 48:13" />Ma wọ, Josẹph ọvạk Ephraim k'udimbọhk kwẹ, kw'ode ọkwabọhk kw'Jekọb, ọbạra ọvạkha Manasẹ k'ọkwabọhk kwẹ, kw'ode udimbọhk kw'Jekọb, ọtwukhọ bẹ ọbaanga otte k'ifor. <verse eid="GEN 48:13" /><verse number="14" style="v" sid="GEN 48:14" />Okhenka, wa Jekọb udir mbọhk sẹ ọnạna iva mbọ k'ncho. Ọnạn Ephraim kw'ode nnwannwa, udimbọhk, ọnạn Manasẹ kw'ode odennạng ọkwabọhk.<verse eid="GEN 48:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 48:15" />Osenga ma, ọyọhbh Josẹph itta, ọbẹ,</para>
  <para style="q1" vid="GEN 48:15">“Tte Ọvaar Ubinọkpaabyi kw'ab'otte paam</para>
  <para style="q2" vid="GEN 48:15">Abraham, ọttạra Isaak akpobh,</para>
  <para style="q1" vid="GEN 48:15">Ubinọkpaabyi kw'khaam okkera</para>
  <para style="q2" vid="GEN 48:15">k'akpen paam phyibh tạrr ukpira ma,<verse eid="GEN 48:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="GEN 48:16" />tte itọhmọ,</para>
  <para style="q2" vid="GEN 48:16">s'khaam ikkaana,</para>
  <para style="q1" vid="GEN 48:16">k'ipyibha ch'idede,</para>
  <para style="q2" vid="GEN 48:16">ido iva mba.</para>
  <para style="q1" vid="GEN 48:16">Tte iva mba akpena ache pabẹ abhina kakhaam,</para>
  <para style="q2" vid="GEN 48:16">tte abẹ abạra akpena ache pabẹ abhina,</para>
  <para style="q1" vid="GEN 48:16">k'ab'otte paam, Abraham, ọttạra Isaak,</para>
  <para style="q2" vid="GEN 48:16">tte abẹ asaabh ayọng-ọyọnga ma ọyagbin.”<verse eid="GEN 48:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 48:17" />Masẹ wa Jekọb n'ọyọhbh iva mbọ itta, Josẹph ose bẹ, udimbọhk kw'otte ọnạn Ephraim k'echo, ettem khẹ nerebha. Ma wọ n'ubin bẹ, ọta udira ọbọhk kw'otte ọnạn Ephraim k'echo bẹ, ọnạna Manasẹ. <verse eid="GEN 48:17" /><verse number="18" style="v" sid="GEN 48:18" />Ma wọ, Josẹph oben otte bẹ, “Mma e, aro kwaam, oyok nwa wọ ode ocheden, nạna udimbọhk kwọ kakhẹ k'echo.”<verse eid="GEN 48:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 48:19" />Otte ufhum, oben bẹ́, “Nnwa kwaam, ọttan-m mạma e, nsong ma bẹ́, iva p'iva p'Manasẹ m'ade ẹkhạma ch'ididen ch'm'iyin eche. Ayongu ma, Efrem m'ọkhaama ẹfa ọyọhnga Manasẹ, iva p'iva pẹ m'ade idifhon s'isaabh-ọsaabh.”<verse eid="GEN 48:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 48:20" />Ma wọ, Jekọb ọyọhbhọ iva mbọ itta ma iwu njọma, oben bẹ e</para>
  <para style="q1" vid="GEN 48:20">“Anạng p'Israẹl m'atima eche chọ n'anạngẹ anạng idia.</para>
  <para style="q2" vid="GEN 48:20">Tte Ubinọkpaabyi ọnạng-ọ uwujibh ọttạra ottennebh k'oche kw'ọnạngẹ Ephraim ọttạra Manasẹ.”</para>
  <para style="p" vid="GEN 48:20">Ma wọ, usi Efrem ode odennạng ọnạng Manasẹ.<verse eid="GEN 48:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 48:21" />Ma wọ, Jekọb n'obeni Josẹph bẹ́, “Ebowu chaam nạnk'efora, okhenka, tte Ọvaar Ubinọkpaabyi uninga bạnga abẹ, ọbạra utima bạnga ọkpa nnạm k'isek s'ab'atte. <verse eid="GEN 48:21" /><verse number="22" style="v" sid="GEN 48:22" />Ọma wọ n'ade ocho, kw'ayok, mạnnạng-ọ isisek nnọ s'ikpechowọna s'nvạk anạng p'Amọr nna, s'nnim bẹ abẹ ọttạra ọkkangkkang-kkro kwaam ọttạra uyuk kwaam.”<verse eid="GEN 48:22" /></para>
  <chapter eid="GEN 48" />
  <chapter number="49" style="c" sid="GEN 49" />
  <para style="s1">Jekọb ọyọhbhọ iva pẹ itta</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 49:1" />Wa Jekọb oyeri iva pẹ, oben bẹ́, Akwu attonga maa, ọfha ntek bạnga ukhira kw'akpen pabạnga m'ade k'iwu oro.<verse eid="GEN 49:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="GEN 49:2" />Iva p'Jekọb o, abạnga attonga maa akhọhmọ itọhng,</para>
  <para style="q2" vid="GEN 49:2">abạnga akhọhmọ atte kw'abạnga Jekọb itọhng.<verse eid="GEN 49:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="GEN 49:3" />Reubẹn, ọma wọ ade ochedennwa kwaam,</para>
  <para style="q2" vid="GEN 49:3">abạra ade ẹfa chaam,</para>
  <para style="q2" vid="GEN 49:3">ọma wọ ade ẹkhọhkha ch'ijunung chaam,</para>
  <para style="q2" vid="GEN 49:3">abạra ade ọnạng kw'n'ntima nkkarẹ ẹmma.<verse eid="GEN 49:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="GEN 49:4" />Ọma m'ade masẹ abokhada p'asi,</para>
  <para style="q2" vid="GEN 49:4">ọma ujibhada máse,</para>
  <para style="q1" vid="GEN 49:4">ukwuru bẹ́, annukhu ibhikha ch'atte,</para>
  <para style="q2" vid="GEN 49:4">ayima ikwanạng kwẹ abẹ.<verse eid="GEN 49:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="GEN 49:5" />Simeọn ọttạra Lẹvi akwu ẹmmaana jạnẹ,</para>
  <para style="q2" vid="GEN 49:5">abẹ akwu akpen p'idik khikhibhi.<verse eid="GEN 49:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="GEN 49:6" />Tte amma nạngẹ k'ikhaana sabẹ nttạr,</para>
  <para style="q2" vid="GEN 49:6">tte nạngẹ wạnọ k'ininga chabẹ nde,</para>
  <para style="q1" vid="GEN 49:6">ukwuru bẹ́, abẹ kk'ottempyibh kwabẹ atima afhọ anạng saabhada,</para>
  <para style="q2" vid="GEN 49:6">abẹ abạra asi itirakpo ọgbaan, avạkha pyẹ aphyạkhẹ mfhok oche kw'ọdaakhẹ bẹ.<verse eid="GEN 49:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="GEN 49:7" />M'upyibh ọnạng ottempyibh kwabẹ,</para>
  <para style="q1" vid="GEN 49:7">ottempyibh kw'n'utima bẹ ọfhọ anạng k'ẹfa-k'ẹfa.</para>
  <para style="q2" vid="GEN 49:7">M'upyibh ọnạng akkaam pabẹ,</para>
  <para style="q2" vid="GEN 49:7">akkaam p'n'atima bẹ asi ọgbaan.</para>
  <para style="q1" vid="GEN 49:7">Amma m'nsi iva p'iva nạngẹ ibyi rạnẹ arukhu k'ẹkhạma ch'Jekọb.</para>
  <para style="q2" vid="GEN 49:7">Mbạra nsi bẹ akhạmọ aruk k'ẹkhạma ch'Israẹl.<verse eid="GEN 49:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="GEN 49:8" />N'ode ọma Juda,</para>
  <para style="q1" vid="GEN 49:8">ivatte m'atọhng-ọ.</para>
  <para style="q2" vid="GEN 49:8">Ọwawunanạng kwọ kw'm'ọbạra obe abọ kòde,</para>
  <para style="q2" vid="GEN 49:8">ivatte pọ phyibh m'asạkha echo anạng-ọ.<verse eid="GEN 49:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="GEN 49:9" />Ọma Juda m'akhaama ẹfa masẹ okke-nwa,</para>
  <para style="q2" vid="GEN 49:9">kw'ọfhọ eten uchi, ọbhạkhẹ ọkpa nnạm k'ibyi s'otto ukwu,</para>
  <para style="q1" vid="GEN 49:9">masẹ okke-dim, ọkpẹ abạra akhubha k'isisek</para>
  <para style="q2" vid="GEN 49:9">masẹ okke-kwa, ọnạng kw'm'okke ọmmyạn-ọ kòde.<verse eid="GEN 49:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="GEN 49:10" />Ẹvaar k'Juda míbina e,</para>
  <para style="q2" vid="GEN 49:10">ẹvaarchi k'ntaak sẹ mẹ́bạra ibina,</para>
  <para style="q1" vid="GEN 49:10">tạrr etto k'ọnạng kw'achẹ ẹbaan,</para>
  <para style="q2" vid="GEN 49:10">idifhon phyibh ibạra isạkha echo inạng-ẹ.<verse eid="GEN 49:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="GEN 49:11" />Ẹma m'ọkpạna ẹnyạnyaang chẹ k'ichi ch'grep,</para>
  <para style="q2" vid="GEN 49:11">M'ọkpạna ọnyạnyaang-nwa-kwakwẹ k'ichibọhkha ch'ẹdaakh-ẹ.</para>
  <para style="q1" vid="GEN 49:11">Ẹma m'n'utima atwuk okpobhu ọvạra pfẹ,</para>
  <para style="q2" vid="GEN 49:11">ọbạra utima agrep-si okpobhu anọhma-baba pẹ.<verse eid="GEN 49:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="GEN 49:12" />Ẹma m'okhor ichen ukwuru atwuk saabhada p'm'ogwo,</para>
  <para style="q2" vid="GEN 49:12">asa pẹ m'awur ayong-oyongu ukwuru abasi saabhada p'm'ogwo.<verse eid="GEN 49:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="GEN 49:13" />Zẹbulun m'usi ofhon kwẹ k'ẹraangakha, ch'akkaara-kpaar m'n'attima n'akwokha ọyọhng;</para>
  <para style="q2" vid="GEN 49:13">Erem chẹ m'ennemi tạrr ikpira k'ukhubha kw'Sidon.<verse eid="GEN 49:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="GEN 49:14" />“Isaka ode masẹ ẹnyạnyaang ch'ẹkhaam ẹfa,</para>
  <para style="q2" vid="GEN 49:14">ch'n'idira mkpa sididen s'ifhu ọttạra ẹtọhkha.”<verse eid="GEN 49:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="GEN 49:15" />Okpe kw'ose oche kw'iyọhngkwokha-byi sẹ ijibhi ikpira,</para>
  <para style="q2" vid="GEN 49:15">ọttạra oche kw'isisek sẹ ibạra ijibh ininga,</para>
  <para style="q1" vid="GEN 49:15">m'ọsạkha ẹkkaang chẹ ọtọhkha ẹtọhkha,</para>
  <para style="q2" vid="GEN 49:15">ọbạra ochera bẹ́, m'usi ọfa-tọhm masẹ ubira.<verse eid="GEN 49:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="GEN 49:16" />Dan m'ode ọkpaar-aponga kw'm'ọdạbh anạng pẹ k'eden ọkkachẹ,</para>
  <para style="q2" vid="GEN 49:16">masẹ efonamma jạnẹ ch'Israẹl.<verse eid="GEN 49:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="GEN 49:17" />Dan m'ojora masẹ ijọhk s'ining k'eden ọkhaan-ọkhaan,</para>
  <para style="q2" vid="GEN 49:17">masẹ ọpfạpfạbhọ kw'uyim k'eden,</para>
  <para style="q1" vid="GEN 49:17">masẹ ọpfạpfạbhọ kw'n'ọgaakhẹ ẹnyạnyaang k'afhokkukkọrọ,</para>
  <para style="q2" vid="GEN 49:17">kw'usi ọyaar-ẹnyạnyaang ugina otto nnạm-nnạm.<verse eid="GEN 49:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="GEN 49:18" />“O Ọvaar Ubinọkpaabyi, amma nning ntik ẹnnaanga chọ.”<verse eid="GEN 49:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="GEN 49:19" />Ikhaana s'ariribha m'irima Gad abẹ,</para>
  <para style="q2" vid="GEN 49:19">okhenka, m'umum bẹ ekpo k'afhokkukkọhrọ sabẹ n'arạbh.<verse eid="GEN 49:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="GEN 49:20" />“Asha m'ọkhaama uchiattọhk ọkkapfẹ f'orebh-orebh,”</para>
  <para style="q2" vid="GEN 49:20">ẹma m'usi uchiattọhk ọkkapfẹ f'ọbaan bẹ́, abẹ anạng ọvaarnạng uchi.<verse eid="GEN 49:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="GEN 49:21" />“Naphtali ode masẹ uyibh-kwa, kw'n'osenga kakhẹ k'ifor,</para>
  <para style="q2" vid="GEN 49:21">uyibh-kwa kw'n'ọmaan iva p'ajibh-ujibh.”<verse eid="GEN 49:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="GEN 49:22" />“Josẹph ode masẹ ichi ch'n'ẹyạm agrep,</para>
  <para style="q2" vid="GEN 49:22">ch'ebe k'efhobh ọkhaan-ọkhaan,</para>
  <para style="q2" vid="GEN 49:22">ch'ẹsaabhẹ abọhkha mororo.<verse eid="GEN 49:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="GEN 49:23" />Akke-kkaamankkaam m'atima ottempyibh arima abẹ,</para>
  <para style="q2" vid="GEN 49:23">abẹ m'atima iwawuna sididen attẹ-ẹ ayuk.”<verse eid="GEN 49:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="GEN 49:24" />Okhenka, m'akhema bẹ,</para>
  <para style="q1" vid="GEN 49:24">s'avạk uyuk kwọ ijunung-ijunung,</para>
  <para style="q2" vid="GEN 49:24">ukwuru k'efa ch'Ubinọkpaabyi kw'Ẹfa phyibh, kw'Jekọb okpobh,</para>
  <para style="q2" vid="GEN 49:24">usi mbọhk sọ ikpọhkh-ọkpọhkhọ,</para>
  <para style="q1" vid="GEN 49:24">ukwuru Okkeri-arạkhạmaan</para>
  <para style="q2" vid="GEN 49:24">kw'ode Ẹtakpa ch'Israẹl,<verse eid="GEN 49:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="GEN 49:25" />ukwuru Ubinọkpaabyi kw'atte okpobh, kw'n'ọkkaan-ọ,</para>
  <para style="q2" vid="GEN 49:25">ukwuru Ubinọkpaabyi kw'Ẹfa phyibh, kw'udiọ-ọ</para>
  <para style="q2" vid="GEN 49:25">ọttạra idia ch'ẹrạng n'ẹnạng,</para>
  <para style="q1" vid="GEN 49:25">ọttạra idia ch'asi p'isisek ẹtaanga,</para>
  <para style="q2" vid="GEN 49:25">ọttạra idia ch'ọmaan, ọttạra ch'abasi k'ọsaabh.<verse eid="GEN 49:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="GEN 49:26" />Ujibhada kw'atạk k'atte kwọ,</para>
  <para style="q1" vid="GEN 49:26">ọbạrẹ ọtạm ọyọhnga ujibhada kw'ubin k'akpecho p'abạrẹ ayọhnga akpecho,</para>
  <para style="q2" vid="GEN 49:26">ọyọhnga idik ikkasẹ s'ibin k'akpecho p'uwa.</para>
  <para style="q1" vid="GEN 49:26">Tte Josẹph ọtạkha ujibhada nwa phyibh ọkhaama,</para>
  <para style="q2" vid="GEN 49:26">tte ẹma ode ocho kw'ivotte pẹ phyibh.<verse eid="GEN 49:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="GEN 49:27" />“Bẹnjamin ode eten ch'ẹkkaam-ọkkaam,</para>
  <para style="q2" vid="GEN 49:27">ch'n'ichi ayok nten k'ekpebha,</para>
  <para style="q2" vid="GEN 49:27">ẹbạra ekkema okhebh f'm'uchi k'ẹchọhkha.”<verse eid="GEN 49:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 49:28" />Anạng mbọ phyibh bọ wa asi mfonamma jobh-kamfa s'Israẹl. Maa wọ ode idik s'uwa otte ọkpaakhẹ s'ọyọhbhọ bẹ itta. Wa ọyọhbhọ ọnạng-ọnạng itta s'baan-ẹ.<verse eid="GEN 49:28" /></para>
  <para style="s1">Obo kw'Jekọb</para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 49:29" />Ma wọ, Jekọb ọnạngẹ bẹ ntọhna bẹ́, “Ebowu chaam nạnka efora, ch'mpe ntor abaro paam. Abạnga m'annọhng-m k'ibyi s'uwa abaro paam annọhng, k'ọmma kw'ẹtakpa ch'ining k'owonu kw'Ẹphrọn kw'ubin Het, <verse eid="GEN 49:29" /><verse number="30" style="v" sid="GEN 49:30" />ọmma kw'ẹtakpa ch'ining k'Makpẹla, ọbaanga Mamrẹ k'Kenaan, kw'uwa Abraham odebhi ọttạra owonu k'mbọhk s'Ẹphrọn kw'ubin Het, utima usi innọhng-apfura. <verse eid="GEN 49:30" /><verse number="31" style="v" sid="GEN 49:31" />Ma wọ wa abẹ annọhng Abraham, ọttạra ikwanạng kwẹ, Sara. Ma ibyi nnọ rạnẹ rọ s'uwa abẹ annọhng Isaak, ọttạra ikwanạng kwẹ, Rẹbẹka. Ma wọ kw'uwa mbạra nnọhnga Lea. <verse eid="GEN 49:31" /><verse number="32" style="v" sid="GEN 49:32" />Wa Abraham odebhi owonu ngwọ, ọttạra ọmma kw'ẹtakpa kw'uning ma k'mbọhk s'anạng p'Het.”<verse eid="GEN 49:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 49:33" />Masẹ Jekọb kk'iva pẹ ntọhna ọnạnga phyibh, oyebh mfhok sẹ ọnạna k'ibhikha, ope otor anạng pẹ.<verse eid="GEN 49:33" /></para>
  <chapter eid="GEN 49" />
  <chapter number="50" style="c" sid="GEN 50" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 50:1" />Josẹph otto ọkpẹkhẹ apfura p'otte, ọgạma, ọbạra ọbaakh-ẹ. <verse eid="GEN 50:1" /><verse number="2" style="v" sid="GEN 50:2" />Ma wọ Josẹph ọtọhnọ akkeri-akhạmakhạma p'atọhmnạng pẹ bẹ́, abẹ adira apfura p'otte kwẹ Jekọb ata aye, abẹ abạra akkeri wẹ, ọfha awẹ nạngẹ ọdọhkhọ. <verse eid="GEN 50:2" /><verse number="3" style="v" sid="GEN 50:3" />Wa abẹ aye wẹ k'iwu arạbh afa ator k'oche kw'ẹmmaana ch'apfura-yiye ede k'Ijip. Wa anạng p'Ijip atim nkwuna k'iwu arạbh attaan ukuma jobh.<verse eid="GEN 50:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 50:4" />Masẹ iwu nnọ s'nkwuna kk'ittonga, Josẹph oben ajukwa p'Phero bẹ́, “De kk'ọphyaam nkhaama k'abạnga k'ititikha, akkaan-m akpaak Phero bẹ́, <verse eid="GEN 50:4" /><verse number="5" style="v" sid="GEN 50:5" />Wa otte kwaam usi-m ntạkha echekha s'oben-m bẹ́, ‘Ebowu chaam nạngka efora, de mbe maa mpe, sọhng ata annọhng-m k'epekwur ch'ntumu k'Kenaan nchok amma oyeni.’ Ma wọ, tte nta nnọhnga otte kwaam, de kk'ẹ nnọhnga, m'nkwun-ukwuna e.”<verse eid="GEN 50:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 50:6" />Ma wọ Phero oben-ẹ bẹ́, “Ọma sọhng ata annọhnga atte, ator k'echekha ch'uwa kk'ọ usia atạkha.”<verse eid="GEN 50:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 50:7" />Mạnna wọ Josẹph ubin osenga ọta otte nạnnọhnga. Wa atọhmnạng p'Phero phyi-phyibh, ọttạra adennạng p'ọvaardimpa kw'Phero, ọttạra adennạng p'Ijip <char style="it">bẹ wạạm</char>, <verse eid="GEN 50:7" /><verse number="8" style="v" sid="GEN 50:8" />akwu attạra k'ẹchọhmfhạr ch'Josẹph phyibh, ọttạra ivotte pẹ, ọttạra anạng p'ẹchọhmfhạr ch'otte Jekọb, atwạnọ Josẹph abẹ. Wa iva mạnkkeni ọttạra itirakpo bọ n'arikhi kha Goshẹn. <verse eid="GEN 50:8" /><verse number="9" style="v" sid="GEN 50:9" />Wa ijaar sididen s'nnyạnyaang n'itwạr, ọttạra ayaar-nnyạnyaang, abạra atwạn abẹ. Wa ikhana nnọ ikhangkẹ isaabh-ọsaabh.<verse eid="GEN 50:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 50:10" />Masẹ abẹ akpir k'ibyi sabẹ n'aninga akhaan abarli-mạma k'Atad, k'Jọrdan ukhubha, abẹ agạma abomạng k'erạng-k'ẹrạng ọttạra ottempyibh. Ma ibyi nnọ rạnẹ ẹrọ s'uwa Josẹph utim nkwuna s'obo kw'otte k'iwu isenọfa. <verse eid="GEN 50:10" /><verse number="11" style="v" sid="GEN 50:11" />Wa anạng p'Kenaan p'arukhu ma ibyi nnọ sabẹ n'akhaan abarli-mạma k'Atad, p'ase oche kw'Josẹph usi obo kw'otte, ayeri ibyi nnọ s'ibaang Jọrdan bẹ́, Abẹl-Mizrayim, aben bẹ́, “Anạng p'Ijip aning k'nkwuna k'obo!”<verse eid="GEN 50:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 50:12" />Ma wọ wa iva p'Jekọb asi oche kw'otte kk'bẹ ọtọhna. <verse eid="GEN 50:12" /><verse number="13" style="v" sid="GEN 50:13" />Wa abẹ adir apfura p'otte afona k'isek s'Kenaan, ata annọhnga k'ọmma kw'ẹtakpa kw'uning k'Makpẹla, ọbaanga Mamrẹ. Wa Abraham kk'ọmma ngwọ kw'ẹtakpa odebha ọttạra owonu kw'uning ma, k'mbọhk s'Ẹphrọn kw'ubin Het, utima usi innọhng-apfura. <verse eid="GEN 50:13" /><verse number="14" style="v" sid="GEN 50:14" />Masẹ Josẹph kk'otte ọnnọhnga, ẹma ọttạra ivotte pẹ, ọttạra anạng p'akhubhu bẹ obo phyibh, akpa nnạm abhạna k'Ijip.<verse eid="GEN 50:14" /></para>
  <para style="s1">Josẹph oge ivotte pẹ nttem</para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 50:15" />Masẹ abẹ kk'obo akwuna, ivotte p'Josẹph atin bẹ́ otte kwabẹ dạkhẹ k'akpen kóde, abẹ n'abạbhọ abẹma oyeni bẹ́, “De Josẹph n'obe maa chemma oben bẹ́ utwukha ipyibha chidede ch'kk'ẹ ansia mo?” <verse eid="GEN 50:15" /><verse number="16" style="v" sid="GEN 50:16" />Ma wọ abẹ atọhmọ ẹkkaabha anạng Josẹph bẹ́, “Wa atte ọnạngẹ mạna ntọhna bạrasẹ n'ope e: <verse eid="GEN 50:16" /><verse number="17" style="v" sid="GEN 50:17" />Wa obeni bẹ́, ‘Abạnga akpaak Josẹph bẹ́ amma mbeni bẹ́ ubina ọnạng mpyibha sidede s'abạnga kk'ẹ asi e.’ Ma o, anchin-ọ-uchini, bẹ́ abina ma anạng mpyibha s'atọhmnạng p'Ubinọkpaabyi kw'uwa atte kwọ okpobh.” Masẹ ẹkkaabha njọ etto Josẹph k'itọhng o, Josẹph ọgạma.<verse eid="GEN 50:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 50:18" />Ma wọ ivotte afon ata akhebh-ẹ, atto abạmọ ma isisek, agạma mmạng ma akhẹ ititikha, aben bẹ́, “Amạna mba ande abira pọ e.”<verse eid="GEN 50:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 50:19" />Okhenka, Josẹph oben bẹ bẹ́, “Tte nạngẹ bạnga ojor. Amma wọ nde Ubinọkpaabyi o? <verse eid="GEN 50:19" /><verse number="20" style="v" sid="GEN 50:20" />Wa abạnga akkẹ bẹ́ abạnga asi-m igbaan, okhenka, wa Ubinọkpaabyi utim ẹkka ọkkachẹ otte udik ngwọ ọbọhk bẹ́ akwẹ ode, ọfha ọkkaana akpen p'anạng-saabhada, oche kw'akwẹ ode maa. <verse eid="GEN 50:20" /><verse number="21" style="v" sid="GEN 50:21" />Ma o, tte nạng bạnga ojor. Amma m'nkkeri bạnga okkeri, oseng k'iva pabạnga.” Josẹph ofon ororo ọnạng ivotte pẹ ottembạr, ọbạra ọkpaak bẹ idik s'ottem-fokhu.<verse eid="GEN 50:21" /></para>
  <para style="s1">Obo kw'Josẹph</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 50:22" />Wa Josẹph ọttạra ẹchọhmfhạr ch'otte k'ubungu afon ororo aruk k'Ijip. Wa Josẹph urukhu icho arạbh asen ukuma jobh, <verse eid="GEN 50:22" /><verse number="23" style="v" sid="GEN 50:23" />tạrr ose iva p'iva p'Ephraim. Wa Josẹph ọbạra utin bẹ́, iva p'abin k'ntaak s'Makir, kw'ode nnwa kw'Manasẹ, abạra ade iva pẹ.<verse eid="GEN 50:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 50:24" />Wa Josẹph ọkpaakhẹ ivotte pẹ bẹ́, “Ebowu chaam nạngka efora e, okhenka, de mbe maa mpe, Ubinọkpaabyi m'ochok echekha chẹ ochok bẹ́, utima bạnga ubina maa isisek nna, ọta ọnạng bạnga isisek s'uwa ochekhi bẹ́, m'ọnạng Abraham, ọttạra Isaak, ọttạra Jekọb.” <verse eid="GEN 50:24" /><verse number="25" style="v" sid="GEN 50:25" />Ma wọ Josẹph usi ivotte pẹ, p'ade iva p'Israẹl atạkha echekha k'ititikha sẹ, aben bẹ́, “K'udik ọkka, Ubinọkpaabyi m'ọnạng bạnga ẹkkaana ọnạng, oyonga abạnga m'adira akhạbhọ paam maa isek nna atima afona.”<verse eid="GEN 50:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 50:26" />Ma wọ wa Josẹph ope s'ode icho arạbh asen ukuma jobh. Masẹ abẹ kk'apfura pẹ ayia, abẹ adira wẹ age k'Ikwukwur k'Ijip.<verse eid="GEN 50:26" /></para>
  <chapter eid="GEN 50" />
</usx>