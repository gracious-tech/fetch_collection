<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1KI" style="id">- Mbembe Osopong [MFNOs]</book>
  <para style="h">1Avaarnạng</para>
  <para style="toc2">1 Avaarnạng</para>
  <para style="toc1">Icheden-nwẹr s'Avaarnạng</para>
  <para style="mt1">Icheden-nwẹr s'Avaar</para>
  <chapter number="1" style="c" sid="1KI 1" />
  <para style="s1">Atạm p'Devid</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 1:1" />Wa ọvaar Devid kk'ọtạma mororo, chibhi sabẹ abubh-ẹ nnọhmakpa, ekhok kẹ ọbọhk níttia. <verse eid="1KI 1:1" /><verse number="2" style="v" sid="1KI 1:2" />Ma wọ atọhmnạng pẹ aben-ẹ bẹ́, “Tte annor uminanwa wạnọ kw'm'uninga ọvaarnạng abẹ, kw'm'ọbạra okker-ẹ. Uminanwa nwọ m'uyima ọbaang-ẹ, ọfha ekhok ette aro kwamạna ọbọhk.”<verse eid="1KI 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1KI 1:3" />Mạnna wọ kw'abẹ aroru uminanwa kw'ujibhi ọyọhnga ayok k'Israẹl, abẹ ata atạkha Abishag kw'ubin Shunam akkena ọvaarnạng. <verse eid="1KI 1:3" /><verse number="4" style="v" sid="1KI 1:4" />Wa uminanwa nwọ ujibhi iminava mororo. N'okkeri ọvaarnạng, ọbạra uninga abẹ. Okhenka, wa ọvaarnạng abẹ núyima.<verse eid="1KI 1:4" /></para>
  <para style="s">Adonija usi ẹma oyeni ọvaarnạng</para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 1:5" />Wa Adonija kw'ode nnwa kw'Hagit ọttạra Devid, utim ifor sẹ usi ẹmma, oben bẹ́, “Amma wọ n'nde ọvaarnạng e.” Ma wọ ofon ọta ọtạkha ijaar s'nnyạnyaang nitwạr, ọttạra ayaar-nnyạnyaang, ukwu ọttạra k'ajunung arạbh afa ukuma jobh p'n'achi-ẹ eden. <verse eid="1KI 1:5" /><verse number="6" style="v" sid="1KI 1:6" />(Wa okpe kòde kw'otte ọkpẹ-ẹ eden ọbạbh-ẹ bẹ́, “Ọma asi yạn asi oche ngwọ?” Wa ẹma nwọ ujibhi idikkobh mororo, ọbạra otor Absalọm nnạm k'otte.)<verse eid="1KI 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 1:7" />Wa Adonija ukwu ọkhaama nttọhna ọttạra Joab kw'ode nnwa kw'Zeruya, ọttạra Abiyata kw'ode ọfọhnẹja, p'abuẹ-ẹ k'nnạm. <verse eid="1KI 1:7" /><verse number="8" style="v" sid="1KI 1:8" />Okhenka, Zadọk kw'ode ọfọhnẹja, ọttạra Bẹnaya kw'ode nnwa kw'Jẹhoyada, ọttạra Natan kw'ode usi-ẹyaakha, ọttạra Shimeyi, ọttạra Reyi, ọttạra ọbaabhẹ kw'Devid, abẹ Adonija abẹ nátwạna.<verse eid="1KI 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 1:9" />Adonija utim arạkhạmaan, ọttạra mmaam, ọttạra mmaamva adimpẹ p'ajibhi ifor ọfọhnọ nja k'ẹta ch'Zohẹlẹt, ọbaanga Ẹn-Rogẹl. Obher ivotte pẹ phyibh p'ade ajunungva p'ọvaarnạng, ọttạra ikhaana s'ọvaarnạng phyi-phyibh p'abin Juda. <verse eid="1KI 1:9" /><verse number="10" style="v" sid="1KI 1:10" />Okhenka, wa Natan kw'ode usi-ẹyaakha nóbhera. Bẹnaya, ọttạra abaabhẹ akkapẹ, tạrr oseng k'Sọlọmọn kw'ode nwotte, nọ́bạra obhera.<verse eid="1KI 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 1:11" />Ma wọ Natan obeni Batshẹba kw'ode ọkka kw'Sọlọmọn bẹ́, “Ọma tạm nábhaanga bẹ́, Adonija kw'ode nnwa kw'Hagit kk'ọvaarnạng udia o? Okhenka, aro kwamạna kw'ode Devid, udik ngwọ kósong. <verse eid="1KI 1:11" /><verse number="12" style="v" sid="1KI 1:12" />Ma o, tte ntọhn-ọ eden ch'm'asenga akkaana akpen pọ oyeni ọttạra p'nnwa kwọ Sọlọmọn. <verse eid="1KI 1:12" /><verse number="13" style="v" sid="1KI 1:13" />Sọhng mantọmma ata akhebha ọvaar Devid aben-ẹ bẹ́, ‘Aro ọvaar kwaam, ọma sạng achekhi anạng amma ọtọhmnạng kwọ bẹ́: “K'udik ọkka, nnwa kwaam Sọlọmọn wọ m'ọtạkha ẹvaar chaam, ọbạra uninga ẹyạr k'ẹvaarchi chaam?’ Ka yạn wọ kw'Adonija node ọvạarnạng o?’ <verse eid="1KI 1:13" /><verse number="14" style="v" sid="1KI 1:14" />Amma m'nkwu-ukwu masẹ m'akpaak ọvaarnạng udik ngwọ, ọfha nkwu nge ẹmma ma udik kw'n'akpaak.”<verse eid="1KI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 1:15" />Ma wọ Batshẹbha ofon ọta okhebha ọvaar Devid kw'kk'ọtạma kha ẹmaanggọ chẹ ẹtaanga, s'Abishag kw'ubin Shunam n'okker-ẹ. <verse eid="1KI 1:15" /><verse number="16" style="v" sid="1KI 1:16" />Batshẹba ọrạkha, uttima ititikha k'isisek k'ikpukpobha, ọnạng ọvaarnạng.</para>
  <para style="p" vid="1KI 1:16">Ọvaarnạng ọbạbh-ẹ bẹ́, “Mbạng vọ aroru?”<verse eid="1KI 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1KI 1:17" />Ọpọhn-ẹ bẹ́, “Ọma oyeni wọ atim eche ch'Ọvaar Ubinọkpaabyi, kw'ode Ubinọkpaabyi kwọ, achekhi anạng-m bẹ́: ‘K'udik ọkka, nnwa kwaam Sọlọmọn wọ m'ọtạkha ẹvaar chaam, ọbạra uninga ẹyạr k'ẹvaarchi chaam.’ <verse eid="1KI 1:17" /><verse number="18" style="v" sid="1KI 1:18" />Okhenka, ọma aro ọvaar kwaam, kásong bẹ́, Adonija kk'ọvaarnạng udia o? <verse eid="1KI 1:18" /><verse number="19" style="v" sid="1KI 1:19" />Ẹma kk'mmaam, ọttạra mmaamva adimpẹ, ọttạra arạkhạmaan k'ọsaabh ọtạkha, utima ọfọhnọ ẹja. Obheri ajunungva p'ọvaarnạng phyi-phyibh, ọttạra Abiyata kw'ode ọfọhnẹja, ọttạra Joab kw'ode odecho kw'akpong-nạng. Okhenka, Sọlọmọn kw'ode ọtọhmnạng kwọ, nóbhera. <verse eid="1KI 1:19" /><verse number="20" style="v" sid="1KI 1:20" />Aro ọvaar kwaam, achen p'anạng p'Israẹl phyibh n'akkeri ọma bẹ́, akpaak bẹ ọnạng kw'm'otor-ọ nnạm, kw'm'uninga ẹyạr k'ẹvaarchi ch'ọma aro ọvaar kwaam. <verse eid="1KI 1:20" /><verse number="21" style="v" sid="1KI 1:21" />Nạn mạnna núdia, de aro ọvaar kwaam ope ma, abẹ annọhng-ẹ otor ab'otte, abẹ m'atạkha amma ọttạra nnwa kwaam Sọlọmọn, asi ọgbaan aben bẹ́ ande ariribha e.”<verse eid="1KI 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 1:22" />Masẹ utim ọkpaakhẹ ọvaarnạng udik ngwọ, Natan kw'ode usi-ẹyakha ukpira. <verse eid="1KI 1:22" /><verse number="23" style="v" sid="1KI 1:23" />Wa abẹ akpaakhẹ ọvaarnạng bẹ́, “Natan kw'ode usi-ẹyaakha uning mama e.” Ma wọ ofon okhebha ọvaarnạng, ọrạkha uttima ititikha k'isisek k'ikpukpobha.<verse eid="1KI 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1KI 1:24" />Natan ọbẹ́, “Kkọhm khẹ, ọma ọvaar kwaam kk'ẹyaakha asia bẹ́, Adonija wọ m'ọtạkha ẹvaar chọ, ọbạra uninga ẹyạr k'ẹvaarchi chọ? <verse eid="1KI 1:24" /><verse number="25" style="v" sid="1KI 1:25" />Ẹma kk'ofona ọta ọtạkha mmaam saabhada, ọttạra mmaamva adimpẹ, ọttạra arạkhạmaan. Kk'ajunungva p'ọvaarnạng phyi-phyibh obhera, ọbạra obher adecho p'akpong-nạng, ọttạra Abiyata kw'ode ọfọhnẹja. Abẹ aning abẹ kha mantọmma n'achi, abạra agwọ, n'aben bẹ́, ‘Tte ọvaar Adonija uruk akpen p'adum-udum!’ <verse eid="1KI 1:25" /><verse number="26" style="v" sid="1KI 1:26" />Okhenka, amma ọtọhmnạng kwọ, ọttạra Zadọk kw'ode ọfọhnẹja, ọttạra Bẹnaya kw'ode nnwa kw'Jẹhoyada, ọttạra ọtọhmnạng kwọ Sọlọmọn, nóbhera. <verse eid="1KI 1:26" /><verse number="27" style="v" sid="1KI 1:27" />Node bẹ́, udik kw'aro ọvaar kwaam usi gwọ ma, kw'nạn núsia amạna ansonga ọnạng kw'm'ọtạkha ẹvaar chẹ, kw'm'ọbạra uninga ẹyạr k'ẹvaarchi ch'aro ọvaar kwaam o?”<verse eid="1KI 1:27" /></para>
  <para style="s1">Devid usi Sọlọmọn ọvaarnạng</para>
  <para style="p">
    <verse number="28" style="v" sid="1KI 1:28" />Wa ọvaar Devid obeni bẹ́, “Ayeri Batshẹba ọnnwa okhebh-m kha.” Mạnna wọ ọnnwa okhebha ọvaarnạng kha ẹtaanga, ọta ubuẹ-ẹ k'ititikha.<verse eid="1KI 1:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 1:29" />Ma wọ ọvaarnạng n'ọtạk echekha oben bẹ́, “Oche ngwọ kw'Ọvaar Ubinọkpaabyi urukhu akpen, kw'ọkkaan ọrạbh-m k'ọmmaphyaange kwidede, <verse eid="1KI 1:29" /><verse number="30" style="v" sid="1KI 1:30" />chemma, amma m'nsi udik kw'uwa nchekhi k'eche ch'Ọvaar Ubinọkpaabyi, kw'ode Ubinọkpaabyi kw'Israẹl, bẹ́: Nnwa kwaam Sọlọmọn wọ m'ọtạkha ẹvaar chaam, ẹma wọ m'ọbạra uninga k'ẹvaarchi chaam, k'ọvaarter kwaam.”<verse eid="1KI 1:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1KI 1:31" />Ma wọ Batshẹba ọrạk uttima ititikha k'isisek k'ikpukpobha, oben ọvaarnạng bẹ́, “Tte aro ọvaar kwaam, Devid, uruk akpen tạrr ipimanitor.”<verse eid="1KI 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1KI 1:32" />Ọvaar Devid oben bẹ́, “Ayeri Zadọk kw'ode ọfọhnẹja, ọttạra Natan kw'ode nnwa kw'Jẹhoyada, anạng-m.” Masẹ abẹ akwu ayin ọvaarnạng k'ititikha, <verse eid="1KI 1:32" /><verse number="33" style="v" sid="1KI 1:33" />ọvaarnạng oben bẹ bẹ́, “Abạnga atạkha atọhmnạng p'aro kwabạnga abẹ atwạn bạnga abẹ. Aben nnwa kwaam Sọlọmọn ọyaar ẹnyạnyaang chaam, atim-ẹ afona kha Gihọn. <verse eid="1KI 1:33" /><verse number="34" style="v" sid="1KI 1:34" />Ma wọ kw'Zadọk kw'ode ọfọhnẹja, ọttạra Natan kw'ode usi-ẹyaakha m'abyeng-ẹ ana k'echo, asiẹ-ẹ ọvaarnạng kw'Israẹl. Abạnga age ubukpọhng, abạra anạng ẹyaakha bẹ́, ‘Ọvaar Sọlọmọn m'uruk akpen p'adum-udum!’ <verse eid="1KI 1:34" /><verse number="35" style="v" sid="1KI 1:35" />Abạnga atwạn abẹ akpa nnạm, ọfha ukwu uninga ẹyạr k'ẹvaarchi chaam, ọbạra ọdạbh ẹvaar chaam. Amma kk'ẹ ntekha bẹ́, ode ọvaarnạng kw'Israẹl ọttạra kw'Juda.”<verse eid="1KI 1:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1KI 1:36" />Bẹnaya kw'ode nnwa kw'Jẹhoyada ubhin ọvaarnạng bẹ́, “Tte akwẹ ode oche ngwọ! Tte Ọvaar Ubinọkpaabyi, kw'ode Ubinọkpaabyi kw'aro ọvaar kwaam, ọnạng ẹyaakha ch'udik ngwa. <verse eid="1KI 1:36" /><verse number="37" style="v" sid="1KI 1:37" />Oche ngwọ kw'uwa Ọvaar Ubinọkpaabyi uning aro ọvaar kwaam abẹ, tte ọbạra uninga Sọlọmọn abẹ, ọfha usi ẹvaar chẹ ẹbạr ọtạm ẹyọhnga ẹvaar ch'aro ọvaar kwaam, Devid!”<verse eid="1KI 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1KI 1:38" />Mạnna wọ kw'Zadọk kw'ode ọfọhnẹja, ọttạra Natan kw'ode usi-ẹyaakha, ọttạra Bẹnaya kw'ode nnwa kw'Jẹhoyada, ọttạra anạng p'Kẹrẹt, ọttạra p'Kẹlẹt, abin ata akpoma Sọlọmọn kw'ọyaarẹ k'ẹnyạnyaang ch'ọvaar Devid, abẹ afona kha Gihọn. <verse eid="1KI 1:38" /><verse number="39" style="v" sid="1KI 1:39" />Zadọk kw'ode ọfọhnẹja ọtạkha ubhik kw'ana p'abin k'ukkira kw'awurada, obyenga Sọlọmọn ana k'echo. Mạnna wọ kw'abẹ age ubukpọhng, anạng phyibh abạra anạng ẹyaakha k'ẹrạng-k'ẹrạng bẹ́, “Tte ọvaar Sọlọmọn uruk akpen p'adum-udum!” <verse eid="1KI 1:39" /><verse number="40" style="v" sid="1KI 1:40" />Anạng phyibh n'ator-ẹ nnạm, abẹ age ẹsa, abạra atima erobha chididen ch'abẹ asi tạrr, isek inyengi.<verse eid="1KI 1:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="1KI 1:41" />Wa Adonija ọttạra akhikhennạng phyi-phyibh p'aning abẹ, abhaang udik ngwọ k'okpe kw'abẹ n'aben bẹ́ akkera ininga chabẹ. Masẹ Joab ọbhaang ubukpọhng kw'anạng mbọ age, n'ọbạbh-ọ bẹ́, Ẹkhọhr-khira njọ k'efhondiden, iyini yạn o?”<verse eid="1KI 1:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="1KI 1:42" />Masẹ utim ọkpaakhẹ udik ngwọ, Jonatan kw'ode nnwa kw'Abiyata kw'ode ọfọhnẹja ukwu ukpira. Adonija oben bẹ́, “Nwa kha ẹtaanga. Ujunung ọkkọkka masẹ akhọ, m'utima ẹkkaabha ọkkachẹ ukwu.”<verse eid="1KI 1:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="1KI 1:43" />Jonatan ubhina Adonija bẹ́, “Akwẹ oche ngwọ núdia e! Aro ọvaar kwamạna Devid, kk'Sọlọmọn ẹvaar ọdạbha e. <verse eid="1KI 1:43" /><verse number="44" style="v" sid="1KI 1:44" />Ọvaarnạng kk'Zadọk kw'ode ọfọhnẹja, ọttạra Natan kw'ode usi-ẹyaakha, ọttạra Bẹnaya kw'ode nnwa kw'Jẹhoyada, ọttạra anạng p'Kẹrẹt, ọttạra p'Pẹlẹt ọtọhma bẹ́, abẹ atwạn abẹ, ọyaar k'ẹnyạnyaang ch'ọvaarnạng ọkpa nnạm. <verse eid="1KI 1:44" /><verse number="45" style="v" sid="1KI 1:45" />Zadọk kw'ode ọfọhnẹja, ọttạra Natan kw'ode usi-ẹyaakha kk'ẹ ana abyenga k'echo asiẹ-ẹ ọvaarnạng kha Gihọn. Abẹ kk'abina kha, orebhada awẹ, kw'n'utim ẹkhọhr ukwu k'efhondiden. Ẹkhọhr njọ jọ n'abhaanga mạma e. <verse eid="1KI 1:45" /><verse number="46" style="v" sid="1KI 1:46" />Oyongu ma, Sọlọmọn kk'ẹyạr uninga k'ẹvaarchi e. <verse eid="1KI 1:46" /><verse number="47" style="v" sid="1KI 1:47" />Atọhmnạng p'ọvaarnạng kk'abạra akwua bẹ́, akwu asima aro ọvaar kwamạna, Devid, aben bẹ́, ‘Tte Ubinọkpaabyi kwọ usi Sọlọmọn uyin eche ọyọhng-ọ, ọbạra usi ẹvaar chẹ ẹbạr ẹyọhnga chọ!’ Ma wọ ọvaarnạng ọrạk ma ibhikha chẹ k'ikpukpobha, <verse eid="1KI 1:47" /><verse number="48" style="v" sid="1KI 1:48" />oben bẹ́, ‘Tte ẹtọhnga iyima ẹnạng Ọvaar Ubinọkpaabyi kw'ode Ubinọkpaabyi kw'Israẹl, kw'kk'usia bẹ́, ntima achen paam afa nse ọnạng kw'ọtạk ẹvaar chaam chemma.’ ”<verse eid="1KI 1:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="1KI 1:49" />Osenga ma, akhikhennạng p'Adonija abina k'opoma, ininga ipfura. <verse eid="1KI 1:49" /><verse number="50" style="v" sid="1KI 1:50" />Okhenka, Adonija ubina, ukwuru ojora f'Sọlọmọn, ọta ọvạkha k'abhik p'ijabyi. <verse eid="1KI 1:50" /><verse number="51" style="v" sid="1KI 1:51" />Ma wọ abẹ akpaakhẹ Sọlọmọn bẹ́, “Ọvaar Sọlọmọn ojor Adonija ojora, kw'usi ọta ọvạkha k'abhik p'ijabyi. Ukwu oben bẹ́, ‘Tte ọvaar Sọlọmọn ochekhi ọnạng-m chemma bẹ́, ọkkangkkang-kkro mútima ọfhọ amma ọtọhmnạng kwẹ.’ ”<verse eid="1KI 1:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="1KI 1:52" />Sọlọmọn ubhina bẹ́, “De usi ẹmmaana ọkkachẹ, usisira-naanga kwẹ kw'm'otto k'isek kòde. De ọkhạmọ ipyibha, m'opope.” <verse eid="1KI 1:52" /><verse number="53" style="v" sid="1KI 1:53" />Ma wọ ọvaar Sọlọmọn ọtọhmọ anạng abẹ ata achaar-ẹ k'ijabyi atima akwu. Adonija o, ukwu ọrạkha k'ititikha s'ọvaar Sọlọmọn, kw'oben-ẹ bẹ́, “Sọhng abhạna kakh-ọ k'ọchọhm.”<verse eid="1KI 1:53" /></para>
  <chapter eid="1KI 1" />
  <chapter number="2" style="c" sid="1KI 2" />
  <para style="s1">Ikpongannạm-tọhna s'Devid ọnạngẹ Sọlọmọn</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 2:1" />Masẹ obo kw'Devid nạngka ofora, wa onạngẹ nnwa kwẹ Sọlọmọn ntọhna bẹ́:<verse eid="1KI 2:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1KI 2:2" />“Amma nabạra mpe, ọma be <char style="it">bẹ́ gwuk</char>, asi idik masẹ ujunung, <verse eid="1KI 2:2" /><verse number="3" style="v" sid="1KI 2:3" />asi idik nnọma s'Ọvaar Ubinọkpaabyi, kw'ode Ubinọkpaabyi kwọ, ororu: Ọma senga abẹ k'ikpukpobha, achok akpebhi pẹ, ọttạra ntọhna sẹ, ọttạra nnyina sẹ, ọttạra nttọhna sẹ ator k'oche kw'abẹ akkẹrẹ k'Nnyina s'Mosẹs. Si idik nnọ ọfha asenga ma akhaama ẹnnaanga k'ọttọhk fidede f'm'asi, ọttạra k'ibyi sidede s'mata, <verse eid="1KI 2:3" /><verse number="4" style="v" sid="1KI 2:4" />k'oche kw'Ọvaar Ubinọkpaabyi m'okke ochok echekha chẹ ch'ọnạng-m bẹ́: ‘De iva p'iva pọ arukhu akpen k'oche kw'ọbaan bẹ́, abẹ aruk, abẹ abạra atima nttem sabẹ phyibh, ọttạra akpakpa pabẹ phyibh atwạn abaamẹ, itwuna kéde bẹ́, m'akhaama ọnạng ọkhaama kw'm'ọtạkha ẹvaarchi k'Israẹl.’<verse eid="1KI 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 2:5" />“Ọma oyeni asong udik ma kw'Joab kw'ode nnwa kw'Zeruya usi-m, oche kw'ọfhọ adecho afa p'akpongnạng p'Israẹl, p'ade: Abnẹr kw'ode nnwa kw'Nẹr, ọttạra Amasa kw'ode nnwa kw'Jẹtẹr. Ọfhọ bẹ obyenga isẹ sabẹ k'okpe kw'ẹmẹm, aben bẹ́ k'okpong-kpe gwọ, ọtạkha isẹ nnọ ofokha k'udikhikpa kwẹ kw'irin, ọttạra k'akpafhok py'oge. <verse eid="1KI 2:5" /><verse number="6" style="v" sid="1KI 2:6" />Tima ekkoji chọ siẹ-ẹ oche kw'ọdaakh-ọ, tạrr okhebha ma ọnwa k'epekwur, kẹ ọbọhk kátte uruk akpen.<verse eid="1KI 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 2:7" />“Okhenka, si ijibha anạng iva p'Barzilayi kw'ubin Gilead. Tte abẹ attạra k'anạng p'n'achi uchiattọhk k'okpokkro kwọ, khiri wa abẹ abe abaamẹ k'okpe kw'nnạbhọ k'mbọhk s'nnwatte Absalọm.<verse eid="1KI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 2:8" />“Kàbonu bẹ́, Shimeyi kw'ode nnwa kw'Gẹra kw'ubin Bahurim, k'ẹkhạma ch'Bẹnjamin uning abọ ma. Ẹma wọ wa ọsaakh-m ipyibha-ipyibha k'iwu njọ ch'nsengi mfona k'Mahanayim. Masẹ ọsạk okhebh-m k'Jọrdan, nchekhi k'eche ch'Ọvaar Ubinọkpaabyi nnạng-ẹ bẹ́, ‘Amma ọkkangkkang-kkro mạ́ntima mfhọ-ọ.’ <verse eid="1KI 2:8" /><verse number="9" style="v" sid="1KI 2:9" />Okhenka, kẹ kátạkha masẹ ọnạng kw'nạ́n aponga-pyibha ọkhaam. Ọma ade ujunung kw'ekkoji, m'asonga-osonga oche kw'm'asi. Se bẹ́ akhạbhọ bẹ age k'epekwur ẹtaanga.”<verse eid="1KI 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 2:10" />Wa Devid ope otor ab'otte, abẹ annọhng-ẹ k'efhondiden ch'Devid. <verse eid="1KI 2:10" /><verse number="11" style="v" sid="1KI 2:11" />Wa Devid ode ọvaarnạng k'Hẹbrọn k'icho isenọfa, ọbạra ode ọvaarnạng k'Jẹrusalẹm k'icho ẹrạbh ukuma jobh-kanttaan. Phyi-phyibh wa ọdạbhẹ Israẹl k'icho arạbh afa. <verse eid="1KI 2:11" /><verse number="12" style="v" sid="1KI 2:12" />Ma wọ Sọlọmọn uning ẹyạr k'ẹvaarchi ch'otte Devid, wa ẹvaar chẹ ẹbạra ittima arạnga <char style="it">bẹ́ gwuk</char>.<verse eid="1KI 2:12" /></para>
  <para style="s1">Ẹvaar ch'Sọlọmọn ittim arạnga</para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 2:13" />Wa Adonija kw'ode nnwa kw'Hagit ofon ọta okhebha Batshẹba kw'ode ọkka kw'Sọlọmọn. Batshẹba ọbạbh-ẹ bẹ́, “Akwu k'ẹmẹm o?”</para>
  <para style="p" vid="1KI 2:13">Ubhina bẹ́, “Uwe e, nkwu k'ẹmẹm e.” <verse eid="1KI 2:13" /><verse number="14" style="v" sid="1KI 2:14" />Ukwu ọttạra bẹ́, “Amma nkhaam udik kw'n'mben bẹ́, mkpaakh-ọ e.”</para>
  <para style="p" vid="1KI 2:14">Batshẹba ọbẹ́, “Kpaakh-m.”<verse eid="1KI 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 2:15" />Oben bẹ́, “Ọma asong ma bẹ́, ọvaarfhon ngwa ode kwaam. Anạng p'Israẹl phyibh achokhu ichen bẹ́, amma wọ ndạbhẹ bẹ. Okhenka, idik ikwu ibhạkhẹ ininga. Ma, nnwotte kwaam wọ n'ọkhaam ọvaarfhon, ukwuru s'Ọvaar Ubinọkpaabyi otte kwẹ ọbọhk ọnạng-ẹ. <verse eid="1KI 2:15" /><verse number="16" style="v" sid="1KI 2:16" />Amma nkhaam udik gwạnọ kw'n'mben bẹ́, mphyem, khaam kwẹ kárạm o.”</para>
  <para style="p" vid="1KI 2:16">Oben bẹ́, “Kpaakh-m kwẹ.”<verse eid="1KI 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1KI 2:17" />Ma wọ ofon ororo oben bẹ́, “Totokhạn, ben ọvaar Sọlọmọn ọnạng-m Abishag kw'ubin Shunam, ntạkh-ẹ k'ọbada. Amma nsong ma bẹ́, ọma khaam udik ngwa márạm.”<verse eid="1KI 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1KI 2:18" />Batshẹba ubhina bẹ́, “Ọbaan ma, amma m'mkpaak ọvaarnạng udik ngwa ọkpaak k'akhọ k'echo.”<verse eid="1KI 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 2:19" />Masẹ Batshẹba ọta bẹ́, ọta ọkpaak ọvaar Sọlọmọn udik ngwọ k'echo ch'Adonija, ọvaarnạng ubina ọta okhebh-ẹ, utwunga usima ọkka, bạrasẹ n'ọta uninga ẹyạr k'ẹvaarchi chẹ. Mạnna wọ kw'ọkka uning ẹyạr k'udimbọhk kwẹ.<verse eid="1KI 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1KI 2:20" />Ukwu oben bẹ́, “Amma n'mben bẹ́, mphyem-ọ idikva e. Totokhạn, khaam kárạm.”</para>
  <para style="p" vid="1KI 2:20">Ọvaarnạng oben bẹ́, “Nna kwaam, phyem, khiri kọ mạ́nnạm.”<verse eid="1KI 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1KI 2:21" />Ma wọ obeni bẹ́, “Tte Abishag kw'ubin Shunam ọbọhk anạng nnwatte Adonija, ọtạkh-ẹ k'ọbada.”<verse eid="1KI 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 2:22" />Ọvaar Sọlọmọn ubhina ọkka bẹ́, “Asi yạn aphyem-m bẹ́, ntạkha Abishag kw'ubin Shunam nnạng Adonija k'ọbada? Wạra n'aphyemi adạkhẹ bẹ́, ntạkha ọvaarfhon nnạng-ẹ, ọgba ẹma wọ ode odennạng kwaam. Oche ngwọ gwọ wạra m'agba aphyem anạng Abiyata kw'ode ọfọhnẹja, ọttạra Joab kw'ode nnwa kw'Zeruya!”<verse eid="1KI 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 2:23" />Ọvaar Sọlọmọn ochekhi k'eche ch'Ọvaar Ubinọkpaabyi bẹ́, “Tte Ubinọkpaabyi ọnạng-m irem, ọbạra asẹ ibạrẹ yạn, de Adonija nạn akpen pẹ nútima otera echo ch'udik kw'ophyemi maa! <verse eid="1KI 2:23" /><verse number="24" style="v" sid="1KI 2:24" />Oche ngwọ kw'Ọvaar Ubinọkpaabyi urukhu akpen, kw'kk'aam arạnga uttima <char style="it">bẹ́ gwuk</char>, k'ẹvaar ch'otte kwaam Devid, ọbạra usi ẹnạmma chaam ebe oche kw'ochekhi, oyonga Adonija m'ope chemma!” <verse eid="1KI 2:24" /><verse number="25" style="v" sid="1KI 2:25" />Mạnna wọ kw'ọvaar Sọlọmọn ọnạngẹ Bẹnaya kw'ode nnwa kw'Jehoyada ẹfa, ọta uvun Adonija ọfhọ.<verse eid="1KI 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 2:26" />Ọvaarnạng oben Abiyata kw'ode ọfọhnẹja bẹ́, “Kpa nnạm k'iwonu sọ s'ining k'Anatọt. Ọma abaan k'obo. Okhenka, amma khọ mạntọmma mạ́mfhọ, ukwuru bẹ́, ọma wọ atọhk Ikwukwur s'Echekha ch'Ọvaar Ubinọkpaabyi kw'Ọyọhng, k'ititikha s'otte kwaam Devid, abạra atạkha okhebh k'irem s'otte kwaam.” <verse eid="1KI 2:26" /><verse number="27" style="v" sid="1KI 2:27" />Mạnna wọ kw'Sọlọmọn ọrạbh Abiyata k'ọtọhm f'afọhnẹja p'Ọvaar Ubinọkpaabyi, otor k'ọtọhnga kw'Ọvaar Ubinọkpaabyi ọkpaakhẹ k'Shilo otena k'ẹchọhmfhạr ch'Ẹli.<verse eid="1KI 2:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1KI 2:28" />Masẹ ẹkkaabha njọ ikpir Joab kw'kk'nttọhna ọkhaama ọttạra Adonija, ọyaanga Absalọm ọjẹ, ọrạbh otena k'ukkira kw'Ọvaar Ubinọkpaabyi, ọvạkha abhik p'ijabyi. <verse eid="1KI 2:28" /><verse number="29" style="v" sid="1KI 2:29" />Wa abẹ akpaakhẹ ọvaar Sọlọmọn bẹ́, Joab kk'ọrạbha ofona k'ukkira kw'Ọvaar Ubinọkpaabyi, ọta uninga ọbaanga ijabyi. Sọlọmọn ọnạng Bẹnaya kw'ode nnwa kw'Jehoyada ẹfa bẹ́, “Sọhng ata avun-ẹ afhọ!”<verse eid="1KI 2:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="1KI 2:30" />Ma wọ Bẹnaya ofon k'ukkira kw'Ọvaar Ubinọkpaabyi, ọta oben-ẹ bẹ́, “Ọvaarnạng ọbẹ́, ayin k'iyaan e.”</para>
  <para style="p" vid="1KI 2:30">Okhenka, oben bẹ́, “Mma, amma m'mpe maa.”</para>
  <para style="p" vid="1KI 2:30">Bẹnaya ọbạra utima ẹkkaabha okkena ọvaarnạng, oben bẹ́, “Kkeri oche kw'Joab ubhin-m e.”<verse eid="1KI 2:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1KI 2:31" />Ma wọ ọvạarnạng obeni Bẹnaya bẹ́, “Si oche kw'obeni. Vun-ẹ fhọ, annọhng-ẹ, ọfha osenga ma, amma ọttạra ẹchọhmfhạr chaam phyibh annaanga iponga-pyibha s'isẹ s'anạng p'Joab ọfhọ. <verse eid="1KI 2:31" /><verse number="32" style="v" sid="1KI 2:32" />Ọvaar Ubinọkpaabyi wọ m'ọnạng-ẹ irem k'isẹ s'kk'obyenga, ukwuru bẹ́, ẹma utim ọkkangkkang-kkro ọfhọ ajunung afa, k'okpe kw'otte kwaam Devid nạnósong. Anạng mbọ afa ade: Abnẹr kw'ode nnwa kw'Nẹr, ọbạra ode odecho kw'akpongnạng p'Israẹl, ọttạra Amasa kw'ode nnwa kw'Jẹtẹr, kw'ọbạra ode odecho kw'akpongnạng p'Juda, p'ajibhi, abạra ator ọtạm ayọhng-ẹ. <verse eid="1KI 2:32" /><verse number="33" style="v" sid="1KI 2:33" />Tte iponga-pyibha s'isẹ sabẹ inạna Joab ọttạra iva p'iva pẹ k'echo. Okhenka, tte ẹmẹm ch'Ọvaar Ubinọkpaabyi ininga Devid abẹ, ọttạra iva p'iva pẹ, ọttạra ẹchọhmfhạr, ọttạra ẹvaar chẹ tạrr ipimmanitor.”<verse eid="1KI 2:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1KI 2:34" />Ma wọ Bẹnaya kw'ode nnwa kw'Jehoyada ofon ọta uvun Joab ọfhọ, wa abẹ annọhng-ẹ kakhẹ k'ọchọhm, k'ibyi s'anạng nạnárukha. <verse eid="1KI 2:34" /><verse number="35" style="v" sid="1KI 2:35" />Ọvaarnạng n'ọtạk Bẹnaya kw'ode nnwa kw'Jẹhoyada usi odecho kw'akpongnạng, utima otera echo ch'Joab, ọbạra ọtạkha Zadọk kw'ode ọfọhnẹja otera echo ch'Abiyata.<verse eid="1KI 2:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1KI 2:36" />Wa ọvaarnạng ọtọhmọ abẹ ayeri Shimeyi, oben-ẹ bẹ́, “Ibyi idwạkh-ọdwạk káta, si ọchọhm kw'm'aruk anạng ọma oyeni k'Jẹrusalẹm. <verse eid="1KI 2:36" /><verse number="37" style="v" sid="1KI 2:37" />Songa k'udik ọkka bẹ́, iwu ch'ajek Ipekhuma s'Kidrọn, kk'apua e.”<verse eid="1KI 2:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1KI 2:38" />Shimeyi ọpọhna ọvaarnạng bẹ́, “Udik kw'akpaakhẹ ujibhi ma. Amma ọtọhmnạng kwọ m'nsi-usi oche kw'aro ọvaar kwaam ọkpaakhẹ.” Wa Shimeyi uning k'Jẹrusalẹm k'okpe-bhirada.<verse eid="1KI 2:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1KI 2:39" />Ukwu ukpira icho ittaan, atọhmnạng afa p'Shimeyi arạbh ator Akish, kw'ode nnwa kw'Maaka, ọbạra ode ọvaarnạng kw'Gat. Wa abẹ akpaakhẹ Shimeyi bẹ́, “Atọhmnạng pọ aning kha Gat e.” <verse eid="1KI 2:39" /><verse number="40" style="v" sid="1KI 2:40" />Ma wọ Shimeyi uvur ẹnyạnyaang chẹ ọta okhebha Akish kha Gat, oror atọhmnạng pẹ ose ichen. Shimeyi utim atọhmnạng pẹ ubina kha Gat ukwuna.<verse eid="1KI 2:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="1KI 2:41" />Masẹ Sọlọmọn ọbhaang bẹ́, Shimeyi kk'ubina ma Jẹrusalẹm otena k'Gat tạrr ukwuna, <verse eid="1KI 2:41" /><verse number="42" style="v" sid="1KI 2:42" />ọvaarnạng oyeri Shimeyi, oben-ẹ bẹ́, “Ọma sạng kw'uwa ntạk echekha k'eche ch'Ọvaar Ubinọkpaabyi, mbạra ntwạr-ọ itọhng bẹ́, ‘Iwu chidede ch'ata ibyi sidede, kk'apua e?’ Wa aben-m ma iwu njọ bẹ́, ‘Udik kw'akpaakhẹ ujibh-ujibh. Amma m'nsạkha echo ọsạkha.’ <verse eid="1KI 2:42" /><verse number="43" style="v" sid="1KI 2:43" />Oseng yạn bạra nạn echekha ch'atạk k'Ọvaar Ubinọkpaabyi náchokha, echo nábạra asạkha anạng ntọhna saam o?”<verse eid="1KI 2:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="1KI 2:44" />Ọvaarnạng ọbạra oben Shimeyi bẹ́, “Ọma asong ipyibha chidede s'uwa asi otte kwaam Devid kha ettem chọ. <verse eid="1KI 2:44" /><verse number="45" style="v" sid="1KI 2:45" />Okhenka, ọvaar Sọlọmọn m'ọtạkha idia, ẹvaar ch'Devid m'ebe <char style="it">bẹ́ gwuk</char> k'ititikha s'Ọvaar Ubinọkpaabyi tạrr ipimmanitor.”<verse eid="1KI 2:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="1KI 2:46" />Mạnna wọ kw'ọvaarnạng ọnạngẹ Bẹnaya kw'ode nnwa kw'Jehoyada ẹfa. Uyin k'iyaan ọta uvun Shimeyi ọfhọ.</para>
  <para style="p" vid="1KI 2:46">Ma wọ kw'ẹvaar ittim arạnga k'mbọhk s'Sọlọmọn.<verse eid="1KI 2:46" /></para>
  <chapter eid="1KI 2" />
  <chapter number="3" style="c" sid="1KI 3" />
  <para style="s1">Sọlọmọn ophyemi ekkoji</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 3:1" />Wa Sọlọmọn oseng iyok ọttạra ọvaar Phero kw'Ijip, osenga ma ọtạkha nnwa kw'Phero k'ọbada. Utim-ẹ ukwuna k'Efhondiden ch'Devid tạrr, okkera ọtọhm f'ọvaarchọhm, ọttạra Ọchọhm kw'Ọvaar Ubinọkpaabyi, ọttạra ọbaakha kw'ọbaabh Jẹrusalẹm sisi. <verse eid="1KI 3:1" /><verse number="2" style="v" sid="1KI 3:2" />Wa anạng mbọ n'afọhnọ nja k'ijabyi s'ikpukpobha k'ọyaankpa, ukwuru s'uwa abẹ nạn Ọchọhm kw'eche ch'Ọvaar Ubinọkpaabyi tạm násia. <verse eid="1KI 3:2" /><verse number="3" style="v" sid="1KI 3:3" />Sọlọmọn ọkhọhk idạdaakha sẹ s'Ọvaar Ubinọkpaabyi, uruk akpen otor k'ntọhna s'otte Devid ọnạng-ẹ, kw'oyongu bẹ́, wa ẹma ọfọhnọ nja, ọbạra ọkkạmọ insẹns k'ọyaankpa k'ijabyi s'ikpukpobha.<verse eid="1KI 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1KI 3:4" />Wa ọvaarnạng n'ọta ọfọhnọ nja k'Gibeọn, ukwuru bẹ́, ma wọ wa ode ijabyi s'ikpukpobha s'ibạrẹ udik ọtạm. Wa Sọlọmọn ọnạngẹ nnạnga ikkạmasẹ nnọhna mfa ukuma arạbh jobh, ma ijabyi nnọ s'ikpukpobha. <verse eid="1KI 3:4" /><verse number="5" style="v" sid="1KI 3:5" />Ọvaar Ubinọkpaabyi uyin Sọlọmọn abẹ k'irungu k'idachen k'Gibeọn. Ubinọkpaabyi oben bẹ́, “Phyem ọttọhk fidede f'aroru bẹ́, nnạng-ọ.”<verse eid="1KI 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 3:6" />Sọlọmọn ubhina bẹ́, “Ọma kk'ijibha-bạrada asia anạng otte kwaam Devid, kw'ode ọtọhmnạng kwọ, ukwuru s'uwa ẹma ophye nnạm ka akhọ, ọbạra otor-otor, ọkhaama ettem ọkkachẹ. Ọma afon ororo asi ijibha-bạrada nja anạng-ẹ, anạng-ẹ ujunungnwa bẹ́, ọtạkha ẹvaar chẹ tạrr ukpira maa.<verse eid="1KI 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 3:7" />“Chemma, o Ọvạar Ubinọkpaabyi, kw'ode Ubinọkpaabyi kwaam, ọma kk'amma ọtọhmnạng kwọ, ọvaarnạng asia bẹ́, ntera echo ch'otte kwaam Devid. Okhenka, amma ntim nde nnwannwa, amma oche kw'm'nsi itọhmbọhk saam kạ́nsong. <verse eid="1KI 3:7" /><verse number="8" style="v" sid="1KI 3:8" />Amma ọtọhmnạng kwọ nning k'ngekha s'anạng p'kk'atekha, anạng-bạrada p'asaabhẹ ayọhnga oche kw'ọnạng nạmókke ubhik. <verse eid="1KI 3:8" /><verse number="9" style="v" sid="1KI 3:9" />Ma o, nạng amma ọtọhmnạng kwọ ekkoji k'ettem ch'm'ntima ndạbh anạng pọ. Mbạra ntima chẹ nkhọhkha odenkhạmọ k'udik kw'otor-otor, ọttạra ipina. Ọnạng kw'm'okke anạng-bạrada mba pọ ọdạbh kòde e.”<verse eid="1KI 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 3:10" />Wa Ọvaar Ubinọkpaabyi orebhi ettem Sọlọmọn abẹ k'udik kw'kk'ophyema. <verse eid="1KI 3:10" /><verse number="11" style="v" sid="1KI 3:11" />Mạnna wọ kw'Ọvaar Ubinọkpaabyi oben-ẹ bẹ́, “Mase ọma ayaang akpen p'adum-udum, ọttạra ẹkhaama, ọttạra obo kw'awawuna-nạng pọ ajẹ, akwu aphyem ekkoji ch'm'atima asi iponga ikkasẹ, <verse eid="1KI 3:11" /><verse number="12" style="v" sid="1KI 3:12" />amma m'nnạng-ọ f'aphyemi ọnạng. M'nnạng-ọ ettem ch'ekkoji, ọttạra esonga, tạrr ukpira k'oche kw'ode bẹ́, ọnạng kòde kw'uwa kk'udia masẹ akhọ, ọnạng mọ́bạra uninga kw'm'ode masẹ akhọ. <verse eid="1KI 3:12" /><verse number="13" style="v" sid="1KI 3:13" />Oyongu ma, amma m'nnạng-ọ f'aphyemi, ọttạra ẹkhaama, ọttạra abạrada, ọfha ode bẹ́, k'akpen pọ phyibh, ọvaarnạng kw'm'obenga abọ kòde. <verse eid="1KI 3:13" /><verse number="14" style="v" sid="1KI 3:14" />De asạk echo anạng-m, abạra achok akpebhi ọttạra nnyina saam oche kw'uwa atte Devid ochokhu, amma m'nnạng-ọ akpen p'adum-udum.” <verse eid="1KI 3:14" /><verse number="15" style="v" sid="1KI 3:15" />Sọlọmọn ogbe ọphyạbha, ukwu osonga bẹ́, idachen rọ.</para>
  <para style="p" vid="1KI 3:15">Ọkpa nnạm k'Jẹrusalẹm, ọta obe k'ititikha s'Ikwukwur s'Echekha ch'Ọvaar Ubinọkpaabyi, ọfọhnọ nja s'nnạnga ikkạmasẹ, ọttạra s'nnạnga s'ẹmẹm. Ukwu usi adạkhẹ erobha ọnạng atọhmnạng pẹ phyibh.<verse eid="1KI 3:15" /></para>
  <para style="s1">Sọlọmọn ọkhọhk ekkoji chẹ</para>
  <para style="p">
    <verse number="16" style="v" sid="1KI 3:16" />Wa asaasa afa ayini akwu abe ọvaarnạng k'ititikha. <verse eid="1KI 3:16" /><verse number="17" style="v" sid="1KI 3:17" />Oyok wạnọ oben bẹ́, “Attitte kwaam, totokhạn, ikwanạng nnwa ọttạra amma annukhu ọchọhm gwạnọ. Amma mmaanẹ nnwa k'okpe kw'uning abaamẹ ma ọchọhm. <verse eid="1KI 3:17" /><verse number="18" style="v" sid="1KI 3:18" />Ukwu ukpira iwu ittaan s'mmaanẹ nnwa kwaam, ikwanạng nnwa ọbạra ọmaan nnwa. Amạna mba anạng afa mạnkkeni bọ anning k'ọchọhm, ọnạng ọdwạkh-ọdwạk kw'uning ma ọttạra mạna kòde.<verse eid="1KI 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 3:19" />“Ikwanạng nnwa uyim ọkpẹkhẹ nnwa kwẹ k'irungu, nnwa kwẹ ope. <verse eid="1KI 3:19" /><verse number="20" style="v" sid="1KI 3:20" />Ma wọ ọphyạbh ma irungu, udira nnwa kwaam kw'uyim ọbaakh-m s'n'nttaabha ọda. Ọtạkha nnwa kwaam ururu k'ẹba, ọtạkha upfura-nwa kwẹ ururu-m k'ẹba. <verse eid="1KI 3:20" /><verse number="21" style="v" sid="1KI 3:21" />Masẹ iwu echobh, mbina bẹ́, nnạk nnwa kwaam, n'nse bẹ́, kk'upua. Masẹ ndi-ẹ utum nge k'ekpebha, nkwu nse bẹ́ nnwa kw'mmaanẹ sạ́ng ma.”<verse eid="1KI 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 3:22" />Ikwanạng nwọkha oben bẹ́, “Mma aro! Nwọ kw'urukhu akpen wọ ode kwaam, ubukhu ode kwọ.”</para>
  <para style="p" vid="1KI 3:22">Okhenka, ocheden-kwanạng ofona ororo oben bẹ́, “Mma! Ubukhu ode kwọ, kw'urukhu akpen ode kwaam ro.” Ma wọ abẹ asi ẹkhaanga ma ititikha s'ọvaarnạng.<verse eid="1KI 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 3:23" />Ọvaarnạng oben bẹ́, “Oyok nnwa ọbẹ, ‘Kw'urukhu akpen ode kwaam, ubukhu ode kwọ.’ Oyok nwọkha ọbẹ́, ‘Mma aro! Ubukhu ode kwọ, kw'urukhu akpen ode kwaam.’ ”<verse eid="1KI 3:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1KI 3:24" />Ma wọ ọvaarnạng obeni bẹ́, “Abạnga anạng-m ọkkangkkang-kkro.” <verse eid="1KI 3:24" /><verse number="25" style="v" sid="1KI 3:25" />Ọvaarnạng ọnạng ẹfa bẹ́, “Akhebh nnwa kw'urukhu akpen akpokha afa, atạkha ikpokha anạng oyok wạnọ, abạra atạkha ikpokha anạng oyok nwọkha.”<verse eid="1KI 3:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 3:26" />Ikwanạng kw'ọkhaam nnwa kw'urukhu akpen osenga k'idạdaakha s'ọkhaam nnwa kwẹ abẹ, uchini ọvaarnạng oben bẹ́, “Attitte kwaam, totokhạn, nạng-ẹ nnwa kw'urukhu akpen! Kẹ káfhọ!”</para>
  <para style="p" vid="1KI 3:26">Okhenka, ikwanạng nwọkha oben bẹ́, “Ọnạng kw'm'ọkhaam-ẹ k'ikhaana samạna mba anạng afa kòde. Khebh-ẹ ibyi ifa!”<verse eid="1KI 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1KI 3:27" />Ma wọ ọvaarnạng ọkpaar iponga oben bẹ́, “Anạng ocheden-kwanạng nnwa kw'urukhu akpen. Abạnga kẹ káfhọ, khiri ẹma wọ ode ọkka.”<verse eid="1KI 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1KI 3:28" />Okpe kw'anạng p'Israẹl phyibh n'abhaang iponga nnọ s'ọvaarnạng ọkpaar, ọvaarnạng n'ojor bẹ ojora, ukwuru sabẹ ase bẹ́, utim ekkoji ch'Ubinọkpaabyi usi iponga s'itor-otor.<verse eid="1KI 3:28" /></para>
  <chapter eid="1KI 3" />
  <chapter number="4" style="c" sid="1KI 4" />
  <para style="s1">Ikhaana s'Sọlọmọn ọttạra atọhmnạng pẹ</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 4:1" />Wa ọvaar Sọlọmọn ọdạbhẹ Israẹl phyi-phyibh. <verse eid="1KI 4:1" /><verse number="2" style="v" sid="1KI 4:2" />Maa wọ wa ode adecho p'ikhaana sẹ:</para>
  <para style="b" vid="1KI 4:2" />
  <para style="li1" vid="1KI 4:2">Azariya kw'ode nnwa kw'Zadọk kw'ode ọfọhnẹja;<verse eid="1KI 4:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1KI 4:3" />Ẹlihorẹph ọttạra Ahija p'ade ajunungva p'Shisha, ade akkẹrẹ;</para>
  <para style="li1" vid="1KI 4:3">Jehoshaphat kw'ode nnwa kw'Ahilud, ode oye-idik;<verse eid="1KI 4:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="1KI 4:4" />Bẹnaya kw'ode nnwa kw'Jẹhoyada, ode odecho kw'akpongnạng;</para>
  <para style="li1" vid="1KI 4:4">Zadọk ọttạra Abiyata, ade afọhnẹja;<verse eid="1KI 4:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="1KI 4:5" />Azariya kw'ode nnwa kw'Natan, ode ọfọhnẹja, ọttạra ọnạng kw'n'ọtọhn ọvaarnạng idik;<verse eid="1KI 4:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1KI 4:6" />Ahishar ode otobh-idik s'ọvaarchọhm;</para>
  <para style="li1" vid="1KI 4:6">Adoniram kw'ode nnwa kw'Abda, ode okker-itọhm s'nạn akpokha nípua.<verse eid="1KI 4:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="1KI 4:7" />Wa Sọlọmọn ọkhaam adạbhẹ-nkhạma jobh-kamfa k'Israẹl phyibh, p'n'anạng ọvaarnạng ọttạra anạng p'aning k'ọvaarchọhm uchiattọhk. Ọnạng kwidede ọkhaam ophye wạnọ k'cho kw'm'usi nttọhna s'uchiattọhk mvọ nạnạng. <verse eid="1KI 4:7" /><verse number="8" style="v" sid="1KI 4:8" />Maa wọ ode ache pabẹ:</para>
  <para style="b" vid="1KI 4:8" />
  <para style="li1" vid="1KI 4:8">Bẹn-Hur ọdạbhẹ akpecho p'Ephraim;<verse eid="1KI 4:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1KI 4:9" />Bẹn-Dẹkẹr ọdạbh Makaz, ọttạra Shalbim, ọttạra Bẹt-Shẹmẹsh, ọttạra Ẹlọn-Bẹtanan;<verse eid="1KI 4:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1KI 4:10" />Bẹn-Hẹsẹd ọdạbh Arubot (Soko ọttạra isek s'Hẹphẹr ide sẹ);<verse eid="1KI 4:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1KI 4:11" />Bẹn-Abinadab ọdạbh Naphot-Dor (wa ẹma ọtạk Taphat kw'ode uminanwa kw'Sọlọmọn k'ọbada);<verse eid="1KI 4:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1KI 4:12" />Baana kw'ode nnwa kw'Ahilud, ọdạbhẹ Taanak ọttạra Mẹgido, ọttạra Bẹt-Shan phyi-phyibh kw'ọbaang Zarẹtan, k'isekhisek kw'Jẹzrẹl, tạma k'Bẹt-Shan tạrr ukpira Abẹl-Mẹhola, ajekha afona kha Jọkmeam;<verse eid="1KI 4:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1KI 4:13" />Bẹn-Gẹbẹr ọdạbh Ramọt-Gilead (ibyirukhasẹ s'Jair kw'ode Manasẹ k'Gilead ide sẹ, ọttạra nkhạma s'Argọb k'Bashan, ọttạra ifhondiden sẹ s'ikhaam abaakha arạbh attaan p'akhaam mbaakha-mma s'brons);<verse eid="1KI 4:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1KI 4:14" />Ahinadab kw'ode nnwa kw'Ido, ọdabh Mahanayim;<verse eid="1KI 4:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1KI 4:15" />Ahimaz ọdạbh Naphtali (ẹma kk'Basemat kw'ode uminanwa kw'Sọlọmọn ọtạkha k'ọbada);<verse eid="1KI 4:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1KI 4:16" />Baana kw'ode nnwa kw'Hushayi, ọdạbh Ashẹr ọttạra Alọt;<verse eid="1KI 4:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1KI 4:17" />Jehoshaphat kw'ode nnwa kw'Parua ọdạbh Isaka;<verse eid="1KI 4:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1KI 4:18" />Shimeyi kw'ode nnwa kw'Ẹla, ọdạbh Bẹnjamin;<verse eid="1KI 4:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1KI 4:19" />Gẹbẹr kw'ode nnwa kw'Uri ọdạbh Gilead (k'ofhon kw'Sihọn kw'ode ọvaarnạng kw'Amọr, ọttạra k'ofhon kw'Ọg, kw'ode ọvaarnạng kw'Bashan). Ẹma-ẹma wọ wa ọdạbhẹ ẹkhạma njọ.<verse eid="1KI 4:19" /></para>
  <para style="s1">Ẹkhaama ọttạra ekkoji ch'Sọlọmọn</para>
  <para style="p">
    <verse number="20" style="v" sid="1KI 4:20" />Wa anạng p'Juda ọttạra p'Israẹl asaabhẹ masẹ uyiyeng kw'ẹraanga-kha. Wa anạng mbọ achi, agwo, ettem ẹbạra erebh bẹ. <verse eid="1KI 4:20" /><verse number="21" style="v" sid="1KI 4:21" />Mạnna wọ Sọlọmọn ọdạbhẹ ivaarfhon nnọ phyibh, tạma k'ọraanga kw'Euphrates, akwu akpira k'isek s'aPhilistiya tạrr akpira k'erem ch'Ijip. Wa nkhạma nnọ n'ikkena Sọlọmọn ntuma, asẹ ibạra ininga k'isekhisek kwẹ k'akpen pẹ phyibh.<verse eid="1KI 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 4:22" />Wa uchiattọhk f'Sọlọmọn ororu k'iwu ode akpobhu-mbọhk ẹrạbh ukuma jobh p'abubuma akkapyẹ, ọttạra akpobhu-mbọhk arạbh attaan p'uchiattọhk, <verse eid="1KI 4:22" /><verse number="23" style="v" sid="1KI 4:23" />mmaam jobh sabẹ n'anạng uchiattọhk k'ọpa, mmaam ẹrạbh sabẹ n'anạng asạsaarẹ, ọttạra arạkhạmaan arạbh asen ọttạra mvu, akwu attạra k'achimi, ọttạra ayip, ọttạra uchimi-khora, ọttạra inọhn s'ijibhi ifor. <verse eid="1KI 4:23" /><verse number="24" style="v" sid="1KI 4:24" />Ẹma wa ọdạbhẹ avaar p'ifhondiden phy-phyibh, k'ukhubha kw'ududon n'udimi, k'Ọraanga kw'Euphrates, tạma k'Tiphsa tạrr akpira Gaza, ọbạra uruk k'idira k'ukhubha kwidede. <verse eid="1KI 4:24" /><verse number="25" style="v" sid="1KI 4:25" />Israẹl ọttạra aJuda, tạma k'Dan tạrr akpira Beershẹba, arukhu k'idira k'okpe kw'Sọlọmọn. Ọnạng kwidede n'uchi agrep ọttạra afig pyẹ oyeni.<verse eid="1KI 4:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 4:26" />Wa Sọlọmọn ọkhaam ibyi sabẹ n'achok ijaar nnọhna jobh s'nnyạnyaang nitwạr, ọbạra ọkhaama anyạnyaang-pa nnọhna ẹrạbh ukuma jobh.<verse eid="1KI 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1KI 4:27" />Adạbhẹ p'nkhạma atạk ọnạng-ọnạng k'ophye kwẹ, n'akkena ọvạrr Sọlọmọn uchiattọhk, ọttạra anạng phyibh p'n'achi ọttọhk k'okpokkro kw'ọvaarnạng. Abẹ akwu ase bẹ́, ọttọhk vạnọ-vạnọ f'oworu bẹ kòde. <verse eid="1KI 4:27" /><verse number="28" style="v" sid="1KI 4:28" />Abẹ abạra atima nnạnga sabẹ s'abarli ọttạra asạsaarẹ-bukhu p'abẹ n'anạng nnyạnyaang s'nitwạr ijaar, ọttạra nnyạnyaang idwạkh-ọdwạk, akwu achok ator k'ibyi sabẹ.<verse eid="1KI 4:28" /></para>
  <para style="s1">Ekkoji ch'Sọlọmọn</para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 4:29" />Wa Ubinọkpaabyi ọnạngẹ Sọlọmọn ekkoji ọttạra esonga chideden, ọttạra itina ch'esaabhẹ masẹ uyiyeng kw'ẹraanga-kha. <verse eid="1KI 4:29" /><verse number="30" style="v" sid="1KI 4:30" />Ekkoji ch'Sọlọmọn ẹbạrẹ ẹyọhnga ekkoji ch'anạng phyibh p'aning k'ukhubha kw'ududon n'uyin, ẹbạra ẹbạr ọtạm ẹyọhnga ekkoji ch'Ijip phyibh. <verse eid="1KI 4:30" /><verse number="31" style="v" sid="1KI 4:31" />Ẹma wa ọkhaam ekkoji ọyọhnga ọnạng kwidede, de attạr Ẹtan kw'ubin Ẹzra. Ọkhaam ekkoji ọyọhnga Heman, ọttạra Kalkol, ọttạra Darda p'ade ajunungva p'Mahol. Uyini eche k'idifhon idwạkh-ọdwạk phyi-phyibh. <verse eid="1KI 4:31" /><verse number="32" style="v" sid="1KI 4:32" />Ọkpaakhẹ itọhnga s'ẹtạma nnọhna arạbh asenọfa ukuma arạbh jobh, ọbạra ọkkọhn mmạng nnọhna mfa ukuma arạbh jobh ukuma asen. <verse eid="1KI 4:32" /><verse number="33" style="v" sid="1KI 4:33" />Ọkpaakhẹ idik otena akpen p'asạsaarẹ, tạma k'achigbagba p'Lebanọn tạrr ukpira k'ahisọp p'ameni k'udimokpon. Ọbạra ọkpaak idik otena k'nten, ọttạra k'ọnọhn, ọttạra ọjọhk, ọttạra atum, ọttạra nsiten. <verse eid="1KI 4:33" /><verse number="34" style="v" sid="1KI 4:34" />Avaarnạng p'ọyagbin p'kk'udik kw'ekkoji ch'Sọlọmọn abhaanga n'atọhm anạng p'abin k'nkhạma idwạkh-ọdwạk bẹ́, phyi-phyibh abẹ akwu akhọhmọ itọhng anạng ekkoji ch'Sọlọmọn.<verse eid="1KI 4:34" /></para>
  <chapter eid="1KI 4" />
  <chapter number="5" style="c" sid="1KI 5" />
  <para style="s1">Efordia s'Ọchọhm kw'Ubinọkpaabyi sisi</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 5:1" />Wa ọvaar Hiram kw'Taya n'ọsạkha echo ọnạng oyokh-udikkobh kwẹ Devid k'okpe kwidede. Masẹ n'ọbhaang bẹ́, abẹ kk'Sọlọmọn kw'ode nnwa kw'Devid ana abyenga k'echo bẹ́, ode ọvaarnạng ọbhakwẹ kw'Israẹl, Hiram ọtọhm ikhaana sẹ bẹ́, abẹ ata asim-ẹ. <verse eid="1KI 5:1" /><verse number="2" style="v" sid="1KI 5:2" />Ma wọ Sọlọmọn ọtọhmọ ẹkkaabha okkena Hiram oben bẹ́,<verse eid="1KI 5:2" /></para>
  <para style="pm">
    <verse number="3" style="v" sid="1KI 5:3" />“Ọma asong ka bẹ́, wa Devid kw'ode otte kwaam Ọchọhm kw'Ubinọkpaabyi nókke usi ọnạng eche ch'Ọvaar Ubinọkpaabyi, kw'ode Ubinọkpaabyi kwẹ kw'ikpukpobha, ukwuru mkpong-saabhada s'urim ọttạra nkhạma s'ibaabhẹ. Wa ọchọhm ngwọ nókke usi tạrr Ọvaar Ubinọkpaabyi usi-ẹ okhema awawunanạng pẹ. <verse eid="1KI 5:3" /><verse number="4" style="v" sid="1KI 5:4" />Okhenka, Ọvaar Ubinọkpaabyi, kw'ode Ubinọkpaabyi kwaam kk'aam ẹmẹm ọnạnga k'eden chidede. Amma awawunanạng kạ́nkhaam, udik kwidede n'ujibh-ujibh ọnạng-m. <verse eid="1KI 5:4" /><verse number="5" style="v" sid="1KI 5:5" />Ẹgwọ usi n'ndo ifor s'm'nsi Ọchọhm kw'Ubinọkpaabyi kw'm'ntima nnạng eche ch'Ọvaar Ubinọkpaabyi kw'ode Ubinọkpaabyi kwaam, oche kw'uwa Ọvaar Ubinọkpaabyi obeni otte kwaam, Devid, k'okpe kw'oben-ẹ bẹ́, ‘Nnwa kwọ kw'm'ntima ntera echo ch'ẹvaar chọ, wọ m'usi Ọchọhm kw'amma Ubinọkpaabyi, utima ọnạng eche chaam ikpukpobha.’<verse eid="1KI 5:5" /></para>
  <para style="pm">
    <verse number="6" style="v" sid="1KI 5:6" />Totokhạn, nạng ẹfa bẹ́, abẹ akpaara nchi s'Lebanọn anạng-m. Tte ajunung paam ọbọhk abẹ asi ọtọhm ajunung pọ abẹ. Amma m'nnạng ajunung pọ okpokha-bhik kwidede kw'ọtọhm fabẹ ope.<verse eid="1KI 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 5:7" />Masẹ Hiram ọbhaang ẹkkaabha ch'Sọlọmọn, ettem erebh-ẹ tạrr, oben bẹ́, “Ẹtọhnga iyim ẹnạng Ọvaar Ubinọkpaabyi kw'ọnạngẹ Devid okkoji-nnwa bẹ́, ode ọvaarnạng kw'ẹkhạma-bạrạda ch'Israẹl.”<verse eid="1KI 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 5:8" />Ma wọ, Hiram ubhin sọlọmọn bé:</para>
  <para style="pm" vid="1KI 5:8">“Amma kk'ẹkkaabha chọ mmaanga e, mnạng-ọ nchi ọnạng oche kw'aroru. Amma m'nnạng-ọ nchi ọttạra nchi s'siprẹs ọnạng. <verse eid="1KI 5:8" /><verse number="9" style="v" sid="1KI 5:9" />Atọhmnạng paam m'atima nchi utima sabẹ adạbhe k'akhe, k'akpecho p'Lẹbanọn, afona k'Ọraanga kwididen. M'annyaar sẹ ma ọraanga ọkhaan-ọkhaan antima amfona k'ibyi sidede s'm'atekha. Ma wọ m'anchaarẹ akhẹ mbọ annạng-ọ nchi. Ọma m'anạng-m uchiattọhk f'ẹchọhmfhạr chaam m'ichi.”<verse eid="1KI 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 5:10" />Mạnna wọ kw'Hiram ọnạngẹ Sọlọmọn nchi s'sida ọttạra s'siprẹs oche kw'ororu. <verse eid="1KI 5:10" /><verse number="11" style="v" sid="1KI 5:11" />Sọlọmọn n'ọnạng Hiram akpobhu-mbọhk nnọhna arạbh jobh-kamfa ukuma jobh p'wit, masẹ uchiattọhk f'ẹchọhmfhạr chẹ. Nọnạng-ẹ adạkhẹ ogbạre nnọhna arạbh jobh-kanttaan ukuma chi f'ana p'oliv p'abẹ amyạn-ọmyạna. <verse eid="1KI 5:11" /><verse number="12" style="v" sid="1KI 5:12" />Wa Ọvaar Ubinọkpaabyi ọnạngẹ Sọlọmọn ekkoji oche kw'ochekhi. Mạnna wọ kw'uwa Hiram ọttạra Sọlọmọn atạk echekha ch'ẹmẹm anạng ayok.<verse eid="1KI 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 5:13" />Wa ọvaar sọlọmọn otek atọhmnạng nnọhna arạbh attaan ukuma chi k'Israẹl. <verse eid="1KI 5:13" /><verse number="14" style="v" sid="1KI 5:14" />K'ophye kwidede, n'ọtọhm anạng k'ẹkhaan-k'ẹkhaan, anạng nnọhna ẹrạbh ukuma nsen, k'oche kw'ujunung kwidede m'uninga ophye wạnọ k'Lẹbanọn, aphye afa k'ọchọhm. Adoniram wọ wa ode ocho kw'atọhmnạng mbọ. <verse eid="1KI 5:14" /><verse number="15" style="v" sid="1KI 5:15" />Sọlọmọn ọbạra otekha atọhmnạng p'n'atọhkha ekpo, anạng nnọhna arạbh asenọttaan ukuma chi, ọttạra anạng nnọhna arạbh jobh p'n'akpaara nta k'ẹkhạma ch'akpecho, <verse eid="1KI 5:15" /><verse number="16" style="v" sid="1KI 5:16" />ọttạra adecho p'ọtọhm p'Sọlọmọn, anạng nnọhna sọwạnọ p'n'akkeri ọtọhm. <verse eid="1KI 5:16" /><verse number="17" style="v" sid="1KI 5:17" />K'ẹfa ch'ọvaarnạng, akpaar-nta atumu nta, abạra akpaara pyẹ ọkkakwẹ atima attima ọgbaarẹ kw'Ọchọhm kw'Ubinọkpaabyi. <verse eid="1KI 5:17" /><verse number="18" style="v" sid="1KI 5:18" />Atọhmnạng p'abin k'efhondiden ch'Gẹbal, akkaan amengkka p'Sọlọmọn ọttạra p'Hiram, abẹ adokha nchi ọttạra nta s'Ọchọhm kw'Ubinọkpaabyi.<verse eid="1KI 5:18" /></para>
  <chapter eid="1KI 5" />
  <chapter number="6" style="c" sid="1KI 6" />
  <para style="s1">Sọlọmọn usi Ọchọhm kw'Ubinọkpaabyi</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 6:1" />K'cho kw'ottong innebung, k'ophye kw'Ziv kw'ode ophye kw'ottong afa kw'Sọlọmọn kk'Israẹl ọdạbha, ma wọ kw'uwa ọtạm Ọchọhm kw'Ọvaar Ubinọkpaabyi. Wa node icho ẹnọhna ukuma arạbh annebung s'anạng p'Israẹl kk'abina k'Ijip.<verse eid="1KI 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1KI 6:2" />Ọchọhm kw'uwa ọvaar Sọlọmọn usi ọnạng Ọvaar Ubinọkpaabyi ode ntwạkhọ arạbh annebung ukuma jobh k'adum, ẹkpa chẹ ede ntwạkhọ ẹrạbh ukuma jobh, ebe chẹ ede ntwạkhọ arạbh afa ukuma nsen. <verse eid="1KI 6:2" /><verse number="3" style="v" sid="1KI 6:3" />Ẹchọhmma ch'iyaan-iyaan ch'udimpa kw'Ọchọhm kw'Ubinọkpaabyi ede ntwạkhọ ẹrạbh ukuma jobh k'adum, ede obengana ọttạra ẹkpa ch'ọchọhm ngwọ. Ẹkpa ede ntwạkhọ chi, ch'ẹttwạkhọ k'ititikha s'ọchọhm ngwọ. <verse eid="1KI 6:3" /><verse number="4" style="v" sid="1KI 6:4" />Usi ufhum-ma p'akkobh-okkobha k'ẹrạng-ẹrạng kw'adimokpon p'ọchọhm ngwọ. <verse eid="1KI 6:4" /><verse number="5" style="v" sid="1KI 6:5" />Usi mmangọ k'iyaan-iyaan kw'udimokpon kw'udimpa ọttạra kw'ibyi s'awurada, utima ọfhạrọ ọchọhm ngwọ. <verse eid="1KI 6:5" /><verse number="6" style="v" sid="1KI 6:6" />Ọgbaarẹ kw'isekhisek kw'ọchọhm ngwọ ode ntwạkhọ nsenọfa ọmaana ikpokha, ọgbaarẹ kw'ottemkwẹ ode ntwạkhọ sọwạnọ, ọgbaarẹ kw'ibir-ibir ode ntwạkhọ jobh ọmaana ikpokha. Ukwu usi ategba utima ọvạkha mkpạkha s'adimokpon, ọfha anạng nạngẹ ọttọhk k'adimokpon p'ọchọhm ngwọ ammunu.<verse eid="1KI 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 6:7" />Masẹ abẹ n'asi Ọchọhm ngwọ kw'Ubinọkpaabyi, wa abẹ atim ata p'abẹ aphyaakhẹ k'itabyi mạnkkeni asi kwẹ. Ẹkhọhr ch'ọttọhk udwukhafẹ fidede, ọttạra ẹbạr, tạrr oseng k'ọtọhm-ttọhk f'ẹbaanga f'ọnạng ọbhaang k'ibyi sabẹ n'asi ọchọhm ngwọ, kòde.<verse eid="1KI 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 6:8" />Wa ọmmakhubh kw'ọgbaarẹ kw'isekhisek uning k'ẹrạkh-ẹrạkha kw'ọchọhm ngwọ; ibyạrẹ-mfhok ininga itena k'ọgbaarẹ kw'ottemkwẹ ọttạra kw'ibir-ibira. <verse eid="1KI 6:8" /><verse number="9" style="v" sid="1KI 6:9" />Wa usi ọchọhm ngwọ akwẹ ọsa, utima agbangbang ububha kwẹ ọttạra mkpaakha s'ichi ch'sida. <verse eid="1KI 6:9" /><verse number="10" style="v" sid="1KI 6:10" />Ọbạra usi mmaangọ ọbaabha ọchọhm ngwọ phyibh. Ebe ch'ẹmaanggọ chidede ede ntwạkhọ nsenọfa ọmaana ibhaakha, abẹ asi sẹ akpạna k'agbangbang p'ichi ch'sida.<verse eid="1KI 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 6:11" />Ma wọ Ọvaar Ubinọkpaabyi obeni Sọlọmọn bẹ́, <verse eid="1KI 6:11" /><verse number="12" style="v" sid="1KI 6:12" />“Node ọchọhm ngwa kw'n'asi maa, de achokhu nnyina saam, abạra atạkha ntọhna saam, achok nttọhna saam phyibh, asạkha echo anạng-m, amma m'nsenga ọma abẹ nnạng ẹyaakha ch'echekha ch'nkhaam atte Devid abẹ. <verse eid="1KI 6:12" /><verse number="13" style="v" sid="1KI 6:13" />Amma m'nnuk k'ikhaana s'anạng p'Israẹl, anạng paam Israẹl ọbọhk mạ́mbạra ntte.”<verse eid="1KI 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1KI 6:14" />Wa Sọlọmọn usi ọchọhm ngwọ akwẹ ọsa. <verse eid="1KI 6:14" /><verse number="15" style="v" sid="1KI 6:15" />Ummun mkpaakhakpa s'ichi ch'sida utima ububha adimokpon k'ẹtaanga, ummun sẹ tạma k'ọgbaarẹ kw'ọchọhm ngwọ tạrr akpira k'ibyi s'ikpa ipakhọhnga, ọtạkha mkpaakhakpa s'siprẹs ububha ọgbaarẹ kw'ọchọhm ngwọ. <verse eid="1KI 6:15" /><verse number="16" style="v" sid="1KI 6:16" />Utima mkpaakhakpa s'ichi ch'sida okhebh tạma k'ọgbaarẹ tạrr akpira k'ibyi s'ikpa ipakhọhnga, utima usi ẹmaanggọ ch'ibyi s'Awurada p'ayọhng Awurada ch'ede ntwạkhọ ẹrạbh ukuma jobh, k'ẹtaanga kw'ọchọhm ngwọ. <verse eid="1KI 6:16" /><verse number="17" style="v" sid="1KI 6:17" />Ọgbaarẹ kw'uning k'ititikha s'ẹmaanggọ njọ, ode ntwạkhọ arạbh attaan k'adum. <verse eid="1KI 6:17" /><verse number="18" style="v" sid="1KI 6:18" />Wa abẹ atim ichi ch'sida asi ọchọhm ngwọ k'ẹtaanga. Abẹ abạra agwa adwuk p'isigwua, ọttạra ayoyo p'ammaam-ọmmaama, atima adokha kwẹ. Abẹ atima ichi ch'sida asi ọttọhk fidede f'ọchọhm ngwọ, ẹta jạnẹ-jạnẹ ch'ọnạng ose k'ichen kède.<verse eid="1KI 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 6:19" />Usi ibyi s'awurada k'ẹtaanga kw'ọchọhm ngwọ k'oche kw'abẹ m'anạna Ikwukwur s'Echekha ch'Ọvaar Ubinọkpaabyi. <verse eid="1KI 6:19" /><verse number="20" style="v" sid="1KI 6:20" />Wa ibyi nnọ s'awurada ide ntwạkhọ ẹrạbh ukuma jobh k'adum, ide ntwạkhọ ẹrạbh ukuma jobh k'ẹkpa, ibạra ide ntwạkhọ ẹrạbh ukuma jobh k'ebe. Utima gol ọfhạrọ sẹ kha ẹtaanga, ọbạra utima gol ọfhạrọ ijabyi s'sida. <verse eid="1KI 6:20" /><verse number="21" style="v" sid="1KI 6:21" />Sọlọmọn utim gol ọkkakwẹ ọfhạrọ ọchọhm ngwọ kha ẹtaanga, ọbạra utima mgbakkọhbhọ s'gol ọkpa k'ititikha s'ibyi s'awurada sabẹ atim gol afhạrọ. <verse eid="1KI 6:21" /><verse number="22" style="v" sid="1KI 6:22" />Mạnna wọ utim gol ọfhạrọ ẹtaanga kw'ibyi nnọ phyibh, ọbạra utima gol ọfhạrọ ijabyi s'ining k'ẹtaanga kw'ibyi s'awurada.<verse eid="1KI 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 6:23" />Utima ichi ch'oliv usi chẹrubim afa k'ẹtaanga kw'ibyi s'awurada. Ebe ch'chẹrub kwidede ede ntwạkhọ chi. <verse eid="1KI 6:23" /><verse number="24" style="v" sid="1KI 6:24" />Ẹbạbaang jạnẹ ch'chẹrub kw'uchi eden ede ntwạkhọ nsenọfa k'adum, ẹbạbaang njọkha ẹbạra ede ntwạkhọ nsenọfa. Wa abạbaang mbọ ade ntwạkhọ chi, s'ayom k'ẹbạbaang-cho jạnẹ tạrr akpira k'njọkha. <verse eid="1KI 6:24" /><verse number="25" style="v" sid="1KI 6:25" />Abạbaang p'chẹrub nwọkha abạra ade ntwạkhọ jobh. Wa chẹrubim mbọ afa ade obengana k'ẹfa ọttạra k'ukhira. <verse eid="1KI 6:25" /><verse number="26" style="v" sid="1KI 6:26" />Ebe ch'chẹrub kwidede ede ntwạkhọ chi. <verse eid="1KI 6:26" /><verse number="27" style="v" sid="1KI 6:27" />Ọtạkha cherubim mbọ ochok kha ẹtaanga kw'ibyi s'Awurada p'ayọhng Awurada ma ọchọhm ngwọ. Abạbaang p'chẹrubim mbọ ẹmmaam-ọmmaama, ọbạbaang kw'oyok wạnọ utwu udimokpon wạnọ, ọbạbaang kw'chẹrub nwọkha utwu udimokpon nwọkha. Abạbaang mbọ pabẹ atwu ayok ma ottemkwẹ kw'ẹmaanggọ. <verse eid="1KI 6:27" /><verse number="28" style="v" sid="1KI 6:28" />Utima gol ọfhạrọ chẹrubim mbọ.<verse eid="1KI 6:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 6:29" />Usi chẹrubim ọttạra aji, ọttạra ayoyo p'ammaam-ọmmaama, ọfhạrọ adimokpon p'ọchọhm ngwọ phyibh k'mmaangọ ẹtaanga ọttạra k'iyaan. <verse eid="1KI 6:29" /><verse number="30" style="v" sid="1KI 6:30" />Ọbạra utima gol ububha ọgbaarẹ kw'ọchọhm ngwọ k'iyaan ọttạra k'ẹtaanga.<verse eid="1KI 6:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1KI 6:31" />Utim ichi ch'oliv usi ammakhubh k'ẹtaanga kw'ibyi s'awurada. Wa mkpaakha nnọ ide ibyi rạnẹ k'ibyi isen, de akhebhi ẹkpa ch'ibyi s'awurada k'ibyi isen. <verse eid="1KI 6:31" /><verse number="32" style="v" sid="1KI 6:32" />Usi chẹrubim ọttạra aji, ọttạra ayoyo p'ammaam-ọmmaama ma ammakhubh mbọ afa p'abẹ atim ichi ch'oliv asi, ọbạra utima gol udwukhakwẹ ọfhạrọ chẹrubim mbọ ọttạra aji. <verse eid="1KI 6:32" /><verse number="33" style="v" sid="1KI 6:33" />Ma ukhira ngwọ gwạnọ, utim ichi ch'oliv usi mkpọmmachi s'udimpa s'ide ibyi rạnẹ k'ibyi innebung, de akhebhi ẹkpa ch'ibyi s'awurada. <verse eid="1KI 6:33" /><verse number="34" style="v" sid="1KI 6:34" />Utim siprẹs usi ammakhubh afa. Ọmmakhubh kwidede ọkhaam mkpa mfa s'n'igwunga ibaakha k'ayok. <verse eid="1KI 6:34" /><verse number="35" style="v" sid="1KI 6:35" />Usi chẹrubim ọttạra aji ọttạra ayoyo p'ammaam-ọmmaama, utima gol udwukhakwẹ ọfhạrọ pyẹ ọbaabh-ọbaabha.<verse eid="1KI 6:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1KI 6:36" />Utim ata p'abẹ ado-odo, ọttạra agbangbang p'ichi ch'sida p'ẹkwọhng-ọkwọhnga, usi adimpa attaan.<verse eid="1KI 6:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="1KI 6:37" />Wa ọphyaakhẹ ọgbạarẹ kw'ọchọhm kw'Ọvaar Ubinọkpaabyi k'icho kw'ottong innebung, k'ophye kw'Ziv, kw'Sọlọmọn kk'Israẹl ọdạbha. <verse eid="1KI 6:37" /><verse number="38" style="v" sid="1KI 6:38" />Wa okker ọchọhm kw'Ubinọkpaabyi phyi-phyibh otor k'ntora s'ọchọhm, k'icho kw'ottong jobh-kawạnọ, k'ophye kw'Bul kw'ode aphye asenọttaan. Wa utim icho isenọfa usi ọchọhm ngwọ.<verse eid="1KI 6:38" /></para>
  <chapter eid="1KI 6" />
  <chapter number="7" style="c" sid="1KI 7" />
  <para style="s1">Sọlọmọn usi ọvaarchọhm kwẹ</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 7:1" />Wa Sọlọmọn utim icho jobh-kantaan okkera ọvaarchọhm kwẹ sisi. <verse eid="1KI 7:1" /><verse number="2" style="v" sid="1KI 7:2" />Wa usi ọvaarter kw'oyeri Ọchọhm kw'Ẹkpa ch'Lẹbanọn, kw'ode ntwạkhọ arạbh asenọfa ukuma jobh k'adum, ntwạkhọ arạbh attaan ukuma chi k'ẹkpa, ọbạra ode ntwạkhọ arạbh afa ukuma nsen k'ebe. Ẹchọhmma njọ ẹbạra ẹkhaama akpakhaana annebung p'mkpọmmachi s'ichi ch'sida, p'agbangẹrẹ p'ichi ch'sida akpạn, atima atuma pyẹ. <verse eid="1KI 7:2" /><verse number="3" style="v" sid="1KI 7:3" />Utim ichi ch'sida ububha ipakhọhnga s'inạn k'agbangẹrẹ, p'anạn k'akpakhaana mbọ p'mkpọmmachi. Wa abẹ ade agbangẹrẹ arạbh afa ukuma asen p'anạn k'mkpọmmachi chi. <verse eid="1KI 7:3" /><verse number="4" style="v" sid="1KI 7:4" />Wa oge afhum-ma attaan-k'attaan k'ẹrạng-ẹrạng, p'akkeri ayok ititikha. <verse eid="1KI 7:4" /><verse number="5" style="v" sid="1KI 7:5" />Nchọhmma phyi-phyibh ikhaam mkpọmmachi ukhira gwạnọ s'ining k'nttaan-k'nttaan ikkeri ayok ititikha.<verse eid="1KI 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 7:6" />Wa usi adimokpon p'adum pẹ ade ntwạkhọ arạbh attaan ukuma chi, ẹkpa chẹ ede ntwạkhọ arạbh afa ukuma asen, ububha pyẹ. Wa ọkhaam udimokpon kw'uning k'ititikha s'mkpọmmachi nnebung, ọttạra ukkira-kpa kw'uning bẹ k'ititikha.<verse eid="1KI 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 7:7" />Ọbạra usi udimokpon kw'm'uninga usi aponga, ọttạra udimokpon kw'eponga-kpaara. Wa usi wẹ tạma k'udimokpon tạrr ukpira k'nchi s'ọraarẹ k'ẹrạng, ọttạra ichi s'sida. <verse eid="1KI 7:7" /><verse number="8" style="v" sid="1KI 7:8" />Ọttạra bẹ́, ọvaarchọhm kw'n'oben bẹ́ uruk, kw'uning k'ẹpannạm, ode ukhira ngwọ gwạnọ. Wa Sọlọmọn usi ọchọhm kw'ode masẹ ọvaarchọhm ngwọ ọnạng nnwa kw'Phero kw'ikwanạng, kw'kk'ọtạkha k'ọbada.<verse eid="1KI 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 7:9" />Idik nnọ phyibh, tạma k'iyaan kpira k'adimokpon pididen, atạm k'agbaarẹ p'ọchọhm ngwọ tạrr akpira k'ammakpabem p'ọchọhm, wa usi ọttạra ata p'abin k'ata akkapẹ p'abẹ asi, atima ayọmkpọ akpaara ator k'ukhira kw'abẹ ayom pyẹ, tạma k'ẹtaanga kpira k'iyaan. <verse eid="1KI 7:9" /><verse number="10" style="v" sid="1KI 7:10" />Abẹ atim ata p'akwọhng ọkwọhnga k'ọsaabh asi agbaarẹ p'ọchọhm ngwọ, bạnọ ade ntwạkhọ chi, bạnọ ade ntwạkhọ jobh-kamfa. <verse eid="1KI 7:10" /><verse number="11" style="v" sid="1KI 7:11" />K'ẹrạng, ọbạra ọkhaama ata akkapẹ p'abẹ akpaar ator k'ukhira kw'abẹ aroru, ọttạra agbangẹrẹ p'ichi ch'sida. <verse eid="1KI 7:11" /><verse number="12" style="v" sid="1KI 7:12" />Akhaan-ọkhaan p'adimokpon p'ọchọhm ngwọ ẹtaanga, akhaam ntumu s'ata attaan p'akhaam agbangẹrẹ p'ichi ch'sida k'ẹrạng, masẹ ẹtaanga kw'udimokpon kw'ọchọhm kw'Ọvaar Ubinọkpaabyi, ọttạra iyaan-iyaan kw'ọvarrchọhm.<verse eid="1KI 7:12" /></para>
  <para style="s1">Sọlọmọn obeni Hiram bẹ́ usi ọchọhm</para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 7:13" />Ọvaar Sọlọmọn ọtọhmọ abẹ ayeri Hiram kw'ubin Taya. <verse eid="1KI 7:13" /><verse number="14" style="v" sid="1KI 7:14" />Ẹma nwọ wa ode ujunungnwa kw'opokwa kw'ubin k'ẹkhạma ch'Naphtali, otte ode otepa kw'brons, ubin Taya. Wa ọkhaam emmengkka ọttạra ekkoji ch'ọtọhm fidede f'oten k'brons. Wa ocher eyera ch'ọvaar Sọlọmọn oyer-ẹ bẹ́, usi itọhm sidede s'brons sabẹ anạng-ẹ.<verse eid="1KI 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 7:15" />Udwukhu brons utima usi mkpọmmachi mfa; ẹkpọmmachi chidede ede ntwạkhọ ẹrạbh ukuma nsenọfa k'adum, ọttạra ntwạkhọ chi-kanttaan k'iriringi. <verse eid="1KI 7:15" /><verse number="16" style="v" sid="1KI 7:16" />Ọbạra udwuk brons afa pididen ọnạna k'ẹrạng kw'mkpọmmachi nnọ. Adum p'wạnọ ade ntwạkhọ nsen, adum p'nwọkha ade ntwạkhọ nsen. <verse eid="1KI 7:16" /><verse number="17" style="v" sid="1KI 7:17" />Ọbạra usi ọttọhk f'ode masẹ ibunu f'utim mgbakkọhbhọ oyok ọnạna k'ẹrạng kw'mkpọmmachi nnọ, ọnạna esenọfa k'ẹkpọmmachi chidede. <verse eid="1KI 7:17" /><verse number="18" style="v" sid="1KI 7:18" />Usi akhaana afa p'apomegranet ọfhạrọ ibunu nnọ, utima odokha ẹrạng-ẹrạng kw'mkpọmmachi nnọ. <verse eid="1KI 7:18" /><verse number="19" style="v" sid="1KI 7:19" />K'ẹrạng-ẹrạng kw'mkpọmmachi nnọ mfa s'ining ma ibyi nnọ, ọkhaam ivạra s'ide ntwạkhọ nsajạnẹ k'adum. <verse eid="1KI 7:19" /><verse number="20" style="v" sid="1KI 7:20" />K'ẹrạng-ẹrạng kw'ẹkpọmmachi chidede, ọkhaam ọgbanggbang kw'uning ọbaanga ibunu nnọ s'apomegranet arạbh jobh p'aning k'ọkpakhaana. <verse eid="1KI 7:20" /><verse number="21" style="v" sid="1KI 7:21" />Hiram ochokhu mkpọmmachi nnọ k'ẹtaanga kw'ọchọhm ngwọ. Okpe ẹkpọmmachi ch'ining k'ukhubha kw'ẹrạkh-ẹrạkha Jakin, okpe njọkha ch'ining k'ibir-ibira Boaz. <verse eid="1KI 7:21" /><verse number="22" style="v" sid="1KI 7:22" />K'ẹrạng-ẹrạng kw'mkpọmmachi nnọ, utim brons usi ayoyo. Ma wọ ọtọhm f'mkpọmmachi sisi ọsa.<verse eid="1KI 7:22" /></para>
  <para style="s">Ẹgbanggbang-dim ch'brons</para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 7:23" />Hiram utim brons usi ẹgbanggbang-dim ch'asi ch'ede iriringi, ch'ikpir ntwạkhọ jobh. Tạma k'ẹgbanggbang-yạr tạrr ukpira k'ẹmma ede ntwạkhọ nsen k'adum. Ọtạkha idikhi ch'ikpir ntwạkhọ ẹrạbh ukuma jobh, bẹ́ abẹ ayoma ẹmma chẹ. <verse eid="1KI 7:23" /><verse number="24" style="v" sid="1KI 7:24" />K'ẹyạr ch'ọgbanggbang nwọ, ọkhaam akhaana afa p'asigwua p'brons, p'atobh abaabh-ọbaabha, p'akpir ntwạkhọ chi k'adum. Asigwua mbọ aning k'akpakhaana afa k'ibyi rạnẹ ọttạra ọgbanggbang nwọ.<verse eid="1KI 7:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 7:25" />Ọgbanggbang nwọ ọnạn k'mmaam jobh-kamfa p'brons. Attaan akkeri ibir-ibira, attaan akkeri k'ukhubha kw'ududon n'uyin; attaan akkeri k'ukhubha kw'ẹrạkh-ẹrạkha, attaan akkeri k'ukhubha kw'ududon n'udimi. <verse eid="1KI 7:25" /><verse number="26" style="v" sid="1KI 7:26" />Adinada p'ọgbanggbang nwọ ade ẹbọhkpattem, ẹmma chẹ ede masẹ ẹmma ch'nkkọhbh, masẹ ogbo kw'oyoyo. Ọgbanggbang nwọ ọnwa agbạre nnọhna ẹrạbh ukuma asen.<verse eid="1KI 7:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1KI 7:27" />Wa Hiram ọbạra utima brons usi ekpo jobh py'ekher ijaar, wa kwidede ukpir ntwạkhọ nsajạnẹ k'adum, ọttạra ntwạkhọ nsajạnẹ k'ẹkpa, ọttạra ntwạkhọ nnebung k'ebe. <verse eid="1KI 7:27" /><verse number="28" style="v" sid="1KI 7:28" />Maa wọ ode oche kw'uwa abẹ asi pyẹ: wa apyẹ ẹkhaam mkpa s'ining k'akhaan-ọkhaan. <verse eid="1KI 7:28" /><verse number="29" style="v" sid="1KI 7:29" />Ma mkpa nnọ s'ining k'akhaan-ọkhaan, abẹ anạn nkke, ọttạra mmaam, ọttạra chẹrubim. K'mkpọmmachi ẹrạng-ẹrạng ọttạra k'isekhisek ode nkke, ọttạra ẹbhaam, wa ode ọbọhktọhm f'otepa. <verse eid="1KI 7:29" /><verse number="30" style="v" sid="1KI 7:30" />Oyongu ma, fidede ọkhaam mfhok nnebung s'brons s'n'ibhạkhẹ-ọbhạkhẹ, ọttạra mkpạkha s'brons, fidede ọbạra ọkhaama ọgbanggbang kw'ọnạn k'mfhok nnebung. <verse eid="1KI 7:30" /><verse number="31" style="v" sid="1KI 7:31" />K'ẹtaanga kwẹ, ọkhaam ibyi s'itto eje s'ide iriringi, ibạra ide ntwạkhọ jobh-kawạnọ k'adong. Ibyi nnọ s'itto eje ide iriringi ọttạra udimokpon kwẹ kw'ode ntwạkhọ ẹrạbh ukuma wạnọ. Abẹ abạra afhạrọ akhaan-ọkhaan p'ọmmakhubh. Akhaan-ọkhaan p'ikpaang nnọ ade nkhạbha nnebung, apyẹ iriringi nídia. <verse eid="1KI 7:31" /><verse number="32" style="v" sid="1KI 7:32" />Mfhok sẹ nnebung ining k'isekhisek kw'ikpaang, abẹ adạbhẹ mkpạkha s'ivạk mfhok amaana ma. Ariringi p'mfhok ade ntwạkhọ arạbh attaan ukuma asenọttaan k'ebe, <verse eid="1KI 7:32" /><verse number="33" style="v" sid="1KI 7:33" />wa mfhok nnọ ide masẹ mfhok s'ọkpaar kw'ẹnyạnyaang n'ẹtwạr; mkpạkha sabẹ ọttạra ariringi p'mfhok, ọttạra mbaanga s'ivạk ottemkwẹ kw'ariringi p'mfhok, phyi-phyibh ade brons.<verse eid="1KI 7:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1KI 7:34" />Ọkpaar kwidede ọkhaam avạkh-ọbọhk annebung, ẹkhạbha chidede ikhaam ivạkh-ọbọhk rạnẹ, s'itọhnọ kisekhisek kw'ikpaang iyin k'iyaan. <verse eid="1KI 7:34" /><verse number="35" style="v" sid="1KI 7:35" />K'ẹrạng-ẹrạng kwẹ, ọkhaam udikhikpa kw'ode ntwạkhọ ẹrạbh ukuma mfa, ọbạra ọkhaama avạkh-ọbọhk annebung p'akpạn k'ẹnwyạnga chidede. <verse eid="1KI 7:35" /><verse number="36" style="v" sid="1KI 7:36" />Ọkkẹrẹ chẹrubim ọttạra nkke, ọttạra aji k'ibyi sabẹ n'avạkha mbọhk, ọttạra k'aphyaangẹ pabẹ. <verse eid="1KI 7:36" /><verse number="37" style="v" sid="1KI 7:37" />Mạnna wọ kw'uwa usi ekpo mbyọ jobh. Wa abẹ adwukhu pyẹ phyibh k'ibyi rạnẹ, apyẹ ẹbạra ekhera ayok.<verse eid="1KI 7:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1KI 7:38" />Hiram ọbạra usi agbanggbang-dim jobh p'brons, ẹgbanggbang-dim chidede ikpir ntwạkhọ nsajạnẹ, ch'ẹnwa agbạre arạbh jobh. <verse eid="1KI 7:38" /><verse number="39" style="v" sid="1KI 7:39" />Ọtạkha nnạna nsen ochok k'ukhubha kw'ẹrạkha-ẹrạkha kw'ọchọhm, ọbạra ọtạkha nsen ochok k'ibir-ibira. Ọtạkha ẹgbanggbang-dim ch'asi ochok k'ẹnwyạnga k'ẹrạkh-ẹrạkha kw'ọchọhm kw'okkeri k'ukhubha kw'ududon n'uyin. <verse eid="1KI 7:39" /><verse number="40" style="v" sid="1KI 7:40" />Wa ọbạra usi ọsọhkha ọttạra ashọvẹl ọttạra akpobhu-mbọhk p'efokhu.</para>
  <para style="p" vid="1KI 7:40">Ma wọ Hiram okker ọtọhm fidede f'kk'usia ọnạng Sọlọmọn k'ọchọhm kw'Ọvaar Ubinọkpaabyi:<verse eid="1KI 7:40" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="41" style="v" sid="1KI 7:41" />mkpọmmachi mfa;</para>
  <para style="li1" vid="1KI 7:41">ọttạra agbanggbang-dim afa p'anạn k'mkpọmmachi nnọ k'ẹrạng-ẹrạng;</para>
  <para style="li1" vid="1KI 7:41">ọttạra ategba afa p'abẹ atim adokha agbanggbang-dim mbọ afa k'ẹrạng-ẹrạng kw'mkpọmmachi nnọ;<verse eid="1KI 7:41" /></para>
  <para style="li1">
    <verse number="42" style="v" sid="1KI 7:42" />ọttạra apomegranet ẹnọhna p'ategba mbọ afa (otegba gwạnọ ọkhaam apomegranet akhaana afa p'abẹ atim adokha agbanggbang-dim p'anạn k'ẹrạng-ẹrạng kw'mkpọmmachi nnọ mfa);<verse eid="1KI 7:42" /></para>
  <para style="li1">
    <verse number="43" style="v" sid="1KI 7:43" />ọttạra nnạna jobh, ọttạra agbanggbang-dim pyabẹ;<verse eid="1KI 7:43" /></para>
  <para style="li1">
    <verse number="44" style="v" sid="1KI 7:44" />ọttạra agbanggbang-dim p'asi, ọttạra mmaam jobhkamfa k'isekhisek kwabẹ;<verse eid="1KI 7:44" /></para>
  <para style="li1">
    <verse number="45" style="v" sid="1KI 7:45" />ọttạra ọsọhkha, ọttạra ashọvẹl, ọttạra akpobhu-mbọhk p'efokhu.</para>
  <para style="b" vid="1KI 7:45" />
  <para style="p" vid="1KI 7:45">Wa Hiram utim brons kw'ọbhaabhẹ k'ekpon usi ekpo mbyọ phyibh ọnạng ọvaar Sọlọmọn k'Ọchọhm kw'Ọvaar Ubinọkpaabyi. <verse eid="1KI 7:45" /><verse number="46" style="v" sid="1KI 7:46" />Wa ọvaarnạng obeni abẹ atima idọhngọ abạnga pyẹ k'ẹkpẹmẹ ch'Jọrdan kw'uning k'ottemkwẹ kw'Sukot, ọttạra Zarẹtan. <verse eid="1KI 7:46" /><verse number="47" style="v" sid="1KI 7:47" />Wa Sọlọmọn adọhbh py'ekpo mbyọ phyibh nóyoma, ukwuru s'apyẹ ẹsaabhẹ eseng eden; wa abẹ adọhbh py'brons nábạra ayoma.<verse eid="1KI 7:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="1KI 7:48" />Wa Sọlọmọn ọbạra usi ekpo phyibh py'abẹ atim adokha Ọchọhm kw'Ọvaar Ubinọkpaabyi, py'ade:</para>
  <para style="b" vid="1KI 7:48" />
  <para style="li1" vid="1KI 7:48">ijabyi s'gol;</para>
  <para style="li1" vid="1KI 7:48">ọttạra okpokkro kw'gol kw'abẹ n'anạna brẹd kw'awurada;<verse eid="1KI 7:48" /></para>
  <para style="li1">
    <verse number="49" style="v" sid="1KI 7:49" />ọttạra itukkạng-chi ch'gol (asen k'udimbọhk, asen k'ọkwabọhk, k'ititikha s'ibyi s'awurada);</para>
  <para style="li1" vid="1KI 7:49">ọttạra ayoyo p'gol, ọttạra attukkạng, ọttạra afamgba pabẹ;<verse eid="1KI 7:49" /></para>
  <para style="li1">
    <verse number="50" style="v" sid="1KI 7:50" />ọttạra agbanggbang-dim p'gol, ọttạra atukkạng-nạm, ọttạra akpobhu-mbọhk p'efokhu, ọttạra nsengakpa, ọttạra insẹns;</para>
  <para style="li1" vid="1KI 7:50">ọttạra mkpạkha s'gol s'ammakhubh p'ẹmaanggọ ch'ẹtaanga ch'ede ibyi s'Awurada p'ayọhng Awurada, ọtạra k'ammakhubh p'udimpa kw'ọchọhm kw'Ubinọkpaabyi.<verse eid="1KI 7:50" /></para>
  <para style="b" />
  <para style="p">
    <verse number="51" style="v" sid="1KI 7:51" />Masẹ ọtọhm phyibh f'ọvaar Sọlọmọn usi k'Ọchọhm kw'Ọvaar Ubinọkpaabyi kk'ọsa, ofona ọta ọtạkha ekpo py'otte Devid py'ede: silva, ọttạra gol, ọttạra ekpo py'ọchọhm-dudokha, ọtạkha pyẹ ochok k'ibhikha ch'Ọchọhm kw'Ọvaar Ubinọkpaabyi, utima pyẹ ukwu otte ọbọhk ọnạng Ọvaar Ubinọkpaabyi.<verse eid="1KI 7:51" /></para>
  <chapter eid="1KI 7" />
  <chapter number="8" style="c" sid="1KI 8" />
  <para style="s1">Abẹ atim ikwukwur s'Echekha akwu k'Ọchọhm kw'Ubinọkpaabyi</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 8:1" />Wa ọvaar Sọlọmọn oyeri adennạng p'Israẹl ọttạra adabhẹ-nkhạma, ọttạra avaar-mfona s'inạmma s'Israẹl otobha bẹ́, abẹ atima Ikwukwur s'Ẹchekha ch'Ọvaar Ubinọkpaabyi kha Ziyọn, kw'ode efhondiden ch'Devid, akwuna k'Jẹrusalẹm. <verse eid="1KI 8:1" /><verse number="2" style="v" sid="1KI 8:2" />Wa anạng p'Israẹl phyibh akwu atobha k'ọvaar Sọlọmọn, k'okpe kw'erobha k'ophye kw'Ẹtanim, kw'ode aphye asenọfa.<verse eid="1KI 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1KI 8:3" />Masẹ adennạng p'Israẹl phyibh kk'akpira, afọhnẹja adira Ikwukwur s'Ẹchekha. <verse eid="1KI 8:3" /><verse number="4" style="v" sid="1KI 8:4" />Abẹ atim Ikwukwur s'Ẹchekha ch'Ọvaar Ubinọkpaabyi, ọttạra ibyirukhasẹ s'Ọvaar Ubinọkpaabyi, ọttạra ekpo edokhapyẹ py'ining k'ẹtaanga. Afọhnẹja ọttạra aLẹvi atọhkha pyẹ. <verse eid="1KI 8:4" /><verse number="5" style="v" sid="1KI 8:5" />Ọvaar Sọlọmọn ọttạra anạng p'Israẹl phyi-phyibh p'kk'atobha abaabh-ẹ, aninga k'ititikha s'Ikwukwur s'Echekha njọ, n'atima arạkhạmaan k'ọsaabh ọttạra mmaam s'ibhikh-asong, afọhnọ ẹja.<verse eid="1KI 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 8:6" />Afọhnẹja mbọ atim Ikwukwur s'Echekha ch'Ọvaar Ubinọkpaabyi akwu achok k'ibyi sẹ, k'ẹtaanga kw'ibyi s'Awurada p'ayọhng Awurada, k'ọchọm kw'Ubinọkpaabyi. Wa abẹ achokhu sẹ k'isekhisek kw'abạbaang p'chẹrubim. <verse eid="1KI 8:6" /><verse number="7" style="v" sid="1KI 8:7" />Chẹrubim mbọ ammaam abạbaang pabẹ abubha ibyi s'Ikwukwur s'Echekha ining. Wa chẹrubim mbọ abubh Ikwukwur s'Ẹchekha ọttạra nsemachi sabẹ n'atima adira sẹ. <verse eid="1KI 8:7" /><verse number="8" style="v" sid="1KI 8:8" />Nsemachi nnọ idumu tạrr ikpira k'ochẹ kw'm'akke-okke abe k'iyaan-iyaan kw'ibyi s'awurada, s'ide ibyi s'Awurada p'ayọng Awurada, ase ibyi s'asẹ ikpong. Asẹ itim ining kha tạrr ukpira chemma. <verse eid="1KI 8:8" /><verse number="9" style="v" sid="1KI 8:9" />Wa ọttọhk f'uning k'Ikwukwur nnọ ẹtaanga kòde, oyong ata-gbẹrẹ afa p'Mosẹs kk'ugia k'ẹtaanga k'Họrẹb. Ma wọ wa Ọvaar Ubinọkpaabyi ochekhi ọnạng anạng p'Israẹl, sabẹ abin k'Ijip.<verse eid="1KI 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 8:10" />Masẹ afọhnẹja abin k'Ibyi s'Awurada, ebona ẹsạkha ibubha Ọchọhm kw'Ọvaar Ubinọkpaabyi. <verse eid="1KI 8:10" /><verse number="11" style="v" sid="1KI 8:11" />Afọhnẹja ọtọhm fabẹ kákke asi ukwuru ebona, s'abạrada p'Ọvaar Ubinọkpaabyi kk'ọchọhm kwẹ afhạra.<verse eid="1KI 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1KI 8:12" />Ma o, Sọlọmọn oben bẹ́, “Ọvaar Ubinọkpaabyi kk'obena bẹ́, ẹma m'uninga k'ebona ch'ipyi irungu <char style="it">bẹ kkạng</char> ; <verse eid="1KI 8:12" /><verse number="13" style="v" sid="1KI 8:13" />k'udik ọkka, amma kk'ọchọhm kw'abạrada nsia nnạng-ọ, kw'ode ibyi s'm'aruk tạrr ipimmanitor.”<verse eid="1KI 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1KI 8:14" />Masẹ anạng p'Israẹl phyibh atim abe ma, ọvaarnạng ọbhạkhẹ nnạm odo bẹ. <verse eid="1KI 8:14" /><verse number="15" style="v" sid="1KI 8:15" />Ma wọ obeni bẹ́,</para>
  <para style="pm" vid="1KI 8:15">“Ẹtọhnga iyim ẹnạng Ọvaar Ubinọkpaabyi, kw'ode Ubinọkpaabyi kw'Israẹl, kw'kk'ọbọhk kwẹ utima usi udik kw'utim ẹmma chẹ ochekhi ọnạng otte kwaam Devid. Obeni bẹ́, <verse eid="1KI 8:15" /><verse number="16" style="v" sid="1KI 8:16" />‘Tạma k'iwu ch'ntim anạng paam Israẹl mbina k'Ijip, amma efhondiden k'ẹkhạma jạnẹ-jạnẹ ch'Israẹl tạm nạ́ntekha ch'm'isi ọchọhm, ọfha anạng akpobha eche chaam mạma. Okhenka, amma kk'Devid ntekha bẹ́, ọdạbh anạng paam Israẹl.’<verse eid="1KI 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1KI 8:17" />“Otte kwaam Devid kk'ọkhạma kha ettem bẹ́, m'usi ọchọhm kw'anạng m'akpobha eche ch'Ọvaar Ubinọkpaabyi, kw'ode Ubinọkpaabyi kw'Israẹl. <verse eid="1KI 8:17" /><verse number="18" style="v" sid="1KI 8:18" />Okhenka, Ọvaar Ubinọkpaabyi obeni otte kwaam bẹ́, ‘Ode udik kw'ujibh-ujibh bẹ́, akhaama ẹkka ch'ẹkpọhkhọ-ọkpọhkhọ bẹ́, asi ọchọhm kw'anạng m'akpobha Eche chaam. <verse eid="1KI 8:18" /><verse number="19" style="v" sid="1KI 8:19" />Okhenka, ọma sạng m'asi ọchọhm ngwọ e, nnwa kwọ kw'ubin k'adima pọ, ọbạra ode isẹ sọ, wọ ode ọnạng kw'm'usi ọchọhm kw'anạng m'akpobha eche chaam.’<verse eid="1KI 8:19" /></para>
  <para style="pm">
    <verse number="20" style="v" sid="1KI 8:20" />“Ọvaar Ubinọkpaabyi kk'echekha ch'ọtạk ochokha: amma kk'echo ch'otte kwaam Devid ntera. Ma o, amma n'nning ẹyạr k'ẹvaarchi ch'Israẹl, ntor k'echekha ch'Ọvaar Ubinọkpaabyi ọtạk. Amma kk'ọchọhm nsia kw'anạng m'akpobha eche ch'Ọvaar Ubinọkpaabyi, kw'ode Ubinọkpaabyi kw'Israẹl. <verse eid="1KI 8:20" /><verse number="21" style="v" sid="1KI 8:21" />Amma kk'ibyi nsia s'Ikwukwur s'Echekha m'ininga, s'ide echekha ch'Ọvaar Ubinọkpaabyi ọttạra abaro pamạna, k'okpe kw'utim bẹ ubina k'Ijip.”<verse eid="1KI 8:21" /></para>
  <para style="s1">Njọhm s'Sọlọmọn ose, s'otte ọchọhm ọbọhk ọnạng Ubinọkpaabyi</para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 8:22" />Wa Sọlọmọn obe k'ititikha s'ijabyi s'Ọvaar Ubinọkpaabyi, k'ititikha s'anạng p'Israẹl phyibh, ọmmaama mbọhk sẹ otena k'ẹrạng <verse eid="1KI 8:22" /><verse number="23" style="v" sid="1KI 8:23" />oben bẹ́:</para>
  <para style="pm" vid="1KI 8:23">“O Ọvaar Ubinọkpaabyi kw'ode Ubinọkpaabyi kw'Israẹl, ọttọhk k'ẹrạng ọttạra ma isek f'obeng ọma Ubinọkpaabyi abẹ kòde. Ọma wọ n'achok echekha chọ ch'idạdaakha s'akhaam anạng pọ abẹ, p'afon ororo atima ettem-ibunguchẹ asenga abọ. <verse eid="1KI 8:23" /><verse number="24" style="v" sid="1KI 8:24" />Ọma kk'echekha chọ ch'akhaam ọttạra ọtọhmnạng kwọ Devid, kw'otte kwaam, achokha. Ọma atim ẹmma chọ atạkha echekha njọ, oche kw'akwẹ ode chemma bẹ́, ọma kk'ẹyaakha ch'udik ngwa anạnga.<verse eid="1KI 8:24" /></para>
  <para style="pm">
    <verse number="25" style="v" sid="1KI 8:25" />“Ma o, Ọvaar Ubinọkpaabyi, kw'ode Ubinọkpaabyi kw'Israẹl, chok ọtọhmnạng kwọ Devid kw'ode otte kwaam, nchekha nnọ s'atạk anạng-ẹ k'okpe kw'uwa abeni bẹ́, ‘Ọma kátwuna bẹ́, anạng-m ọnạng kw'm'otera echo chaam masẹ ọvaarnạng kw'Israẹl, de iva p'iva pọ atạk okpe k'udik kwidede, asenga k'nnạm-phyạphye k'ititikha saam, oche kw'ọma kk'asia.’ <verse eid="1KI 8:25" /><verse number="26" style="v" sid="1KI 8:26" />Ma wọ, o Ubinọkpaabyi kw'Israẹl, tte idik sọ s'achekhi anạng ọtọhmnạng kwọ Devid kw'ode otte kwaam, ide udik ọkka.<verse eid="1KI 8:26" /></para>
  <para style="pm">
    <verse number="27" style="v" sid="1KI 8:27" />Ma, Ubinọkpaabyi s'm'uruk ma ọyagbin k'udik ọkka o? Ọrạngkpaang, ọbạra kw'ogoru ọtạm wọ, khọ mókke obenga; bạra wạra ọchọhm ngwa kw'kk'nsia o! <verse eid="1KI 8:27" /><verse number="28" style="v" sid="1KI 8:28" />Okhenka, o Ọvaar Ubinọkpaabyi kw'ode Ubinọkpaabyi kwaam, bhaanga njọhm s'amma ọtọhmnạng kwọ, ọttạra ephyema chaam ch'ikwosi. Bhaanga ẹmạng ọttạra njọhm s'amma ọtọhmnạng kwọ n'nse k'ititikha sọ chemma. <verse eid="1KI 8:28" /><verse number="29" style="v" sid="1KI 8:29" />Tte achen pọ awonga akkeri ọchọhm ngwa k'irungu ọttạra k'ẹya. Ibyi nna s'abeni bẹ́, ‘Eche chaam m'ininga ma,’ ọfha abhaanga njọhm s'amma ọtọhmnạng kwọ nkkeri ma ibyi nna nse. <verse eid="1KI 8:29" /><verse number="30" style="v" sid="1KI 8:30" />Bhaanga ephyema ch'ọtọhmnạng kwọ, ọttạra ch'anạng pọ Israẹl k'okpe kw'abẹ m'ase njọhm akkeri ma ibyi nnọ. Bhaanga sẹ kha ẹrạng kw'ode ibyirukhasẹ sọ. Okpe kw'abhaang sẹ, bina ma nạng bẹ.<verse eid="1KI 8:30" /></para>
  <para style="pm">
    <verse number="31" style="v" sid="1KI 8:31" />“De ọnạng upini oyokh-ọbaanga kwẹ, de ode udik kw'ọbaan k'mkpon-chichi, bạra abẹ akwu bẹ́, akwu achi mkpon k'ititikha s'ijabyi sọ ma ọchọhm ngwa, <verse eid="1KI 8:31" /><verse number="32" style="v" sid="1KI 8:32" />ninga kha ẹrạng bhaanga bẹ, abạra asi oche kw'ọbaan bẹ́, asi. Si aponga p'atọhmnạng pọ; anạng oyok kw'iponga ipyibhi ipyima kk'udik kw'kk'usia. Atte oyok kw'iponga nạnípyibha ọbọhk, ator k'etora chẹ.<verse eid="1KI 8:32" /></para>
  <para style="pm">
    <verse number="33" style="v" sid="1KI 8:33" />De ọwawunanạng okhem anạng pọ Israẹl, ukwuru ipyibha ch'abẹ kk'asia k'ititikha sọ, abẹ abạra akpa nnạm ator-ọ, akwu atọhnga eche chọ, abẹ ase njọhm achin-ọ ma ọchọhm ngwa, <verse eid="1KI 8:33" /><verse number="34" style="v" sid="1KI 8:34" />ninga kha ẹrạng bhaanga, abạra abina anạng ipyibha ch'anạng pọ Israẹl, abạra atima bẹ akpa nnạm k'isek s'uwa anạngẹ ab'otte pabẹ.<verse eid="1KI 8:34" /></para>
  <para style="pm">
    <verse number="35" style="v" sid="1KI 8:35" />“De ọrạngkpaang nạnótebha ukwuru s'amma p'ọrạngkpaang akpa, s'ubin k'ipyibha ch'anạng pọ kk'ọ asia, abẹ ase njọhm ma ibyi nna, abẹ abạra anạng ẹyaakha ch'eche chọ, akpa nnạm avạra ipyibha chabẹ, ukwuru ipyima ch'kk'bẹ anạnga, <verse eid="1KI 8:35" /><verse number="36" style="v" sid="1KI 8:36" />ninga kha ẹrạng bhaanga, abạra abina anạng ipyibha ch'atọhmnạng pọ Israẹl. Kpebhi bẹ bẹ́, abẹ aruk k'eden ch'etor-otor, abạra atebh asi k'isek s'achekhi anạng anạng pọ, masẹ okhebh fabẹ.<verse eid="1KI 8:36" /></para>
  <para style="pm">
    <verse number="37" style="v" sid="1KI 8:37" />De okwo fididen, ọbạra ode ọkhạmana, otto ma isek nna, ode ọkhạmana f'akwongutọhng o, ọbạra ode agwuruwewe o, ode mpfapfa o, ọbạra ode okpe kw'awawunanạng abaabhẹ bẹ k'efhondiden chabẹ o, ode ipyibha-khira chidede, ode bẹ́ ọkhạmaana vọ ukwu, <verse eid="1KI 8:37" /><verse number="38" style="v" sid="1KI 8:38" />de ọnạng kwidede k'ikhaana s'anạng p'Israẹl ose njọhm, ode bẹ́, ophyemi ọttọhk fidede o, de utim ọkhạnkhạmọ kw'ettem chẹ ọmmaama mbọhk sẹ otena ma k'ọchọhm ngwa, <verse eid="1KI 8:38" /><verse number="39" style="v" sid="1KI 8:39" />ninga kha ẹrạng ch'ede ibyirukhasẹ sọ bina anạng bẹ. Si nạng ọnạng kwidede ator k'usisi kwabẹ, s'ọma asong nttem sabẹ (khiri ọma mạnkkeni wọ asong nttem s'ayokhanạng phyibh), <verse eid="1KI 8:39" /><verse number="40" style="v" sid="1KI 8:40" />ọfha abẹ aruk k'ojora pfọ, k'okpe kwidede kw'abẹ m'aruk k'isek s'uwa anạngẹ ab'otte pamạna.<verse eid="1KI 8:40" /></para>
  <para style="pm">
    <verse number="41" style="v" sid="1KI 8:41" />“De ukhikhennạng kw'nạn ọmmaana kw'anạng pọ Israẹl núdia, ubin kha edenibhir ukwu k'eche chọ, <verse eid="1KI 8:41" /><verse number="42" style="v" sid="1KI 8:42" />sabẹ m'abhaanga eche-bạrada chọ ọttạra ibọhktọhm-bạrada sọ, ọttạra ẹfa chọ, abẹ akwu ase njọhm akkeri k'ọchọhm ngwa, <verse eid="1KI 8:42" /><verse number="43" style="v" sid="1KI 8:43" />ninga kha ẹrạng kw'ode ibyirukhasẹ sọ bhaanga. Asi udik kwidede kw'ukhikhennạng nwọ ophyem-ọ, ọfha idifhon s'ọyagbin phyibh isonga eche chọ, ibạra ikhaama ojora pfọ oche kw'anạng pọ Israẹl akhaam. Abẹ atima ma asonga bẹ́, amma kk'ọchọhm nsia kw'abẹ m'akpobha eche chọ.<verse eid="1KI 8:43" /></para>
  <para style="pm">
    <verse number="44" style="v" sid="1KI 8:44" />“De anạng pọ ata bẹ́, abẹ ata arima awawunanạng pabẹ abẹ k'ibyi sidede s'm'atọhm bẹ, de abẹ ase njọhm anạng ọma Ọvaar Ubinọkpaabyi, akkeri k'efhondiden ch'kk'atekha, ọttạra k'ọchọhm kw'kk'nsia bẹ́, abẹ akpobha eche chọ, <verse eid="1KI 8:44" /><verse number="45" style="v" sid="1KI 8:45" />ninga kha ẹrạng bhaanga njọhm sabẹ, ọttạra ephyema chabẹ, akkaana bẹ.<verse eid="1KI 8:45" /></para>
  <para style="pm">
    <verse number="46" style="v" sid="1KI 8:46" />“De abẹ asi iphyibha k'akhọ k'ititikha, s'ọnạng nạ́n ode kw'nạ́n ipyibha kạnúsi, ettem ipyibh-ọ etena bẹ abẹ, akwu atte bẹ ọbọhk anạng awawunanạng pabẹ, abẹ avạkha bẹ k'ẹmmạri atima afona kabẹ k'nkhạma s'ibhiri eden, ọbạra ode s'ifor-ofora; <verse eid="1KI 8:46" /><verse number="47" style="v" sid="1KI 8:47" />de abẹ n'abạra afhona nttem k'isek sabẹ avạk bẹ k'ẹmmạri aben bẹ́, ‘Amạna mba kk'ipyibha ansia, amạna kk'anttia, ambạra ansi ọgban’; <verse eid="1KI 8:47" /><verse number="48" style="v" sid="1KI 8:48" />de abẹ atim nttem sabẹ, ọttạra akpakpa pabẹ phyibh akpa nnạm ator-ọ ma isek s'awawunanạng pabẹ, p'avạk bẹ k'ẹmmạri, abẹ akkeri k'isek s'uwa anạngẹ ab'otte pabẹ, ase njọhm akkeri efhondiden ch'kk'atekha, ọttạra k'ọchọhm kw'kk'nsia bẹ́, abẹ akpobha eche chọ; <verse eid="1KI 8:48" /><verse number="49" style="v" sid="1KI 8:49" />ninga kha ẹrạng, kw'ode ibyirukhasẹ sọ, bhaanga njọhm ọttạra ephyema chabẹ, akkaana bẹ. <verse eid="1KI 8:49" /><verse number="50" style="v" sid="1KI 8:50" />Abina anạng anạng pọ p'kk'ipyibha asia k'akhọ k'ititikha, abạra asi bẹ́, anạng p'avạk bẹ k'ẹmmạri ase bẹ ikwosi; <verse eid="1KI 8:50" /><verse number="51" style="v" sid="1KI 8:51" />ukwuru sabẹ ade anạng pọ, abẹ abạra ade okhebh pfọ f'atim abina k'Ijip, p'arengi k'irem s'ikhạmọ masẹ ekpon ch'eson mbaanga.<verse eid="1KI 8:51" /></para>
  <para style="pm">
    <verse number="52" style="v" sid="1KI 8:52" />Tte achen pọ awonga akkeri ephyema ch'amma ọtọhmnạng kwọ, ọttạra ephyema ch'anạng pọ Israẹl, abạra akhọhmọ itọhng anạng bẹ k'okpe kwidede kw'abẹ ase njọhm agạma ayer-ọ. <verse eid="1KI 8:52" /><verse number="53" style="v" sid="1KI 8:53" />S'ode bẹ́, ọma oyeni wọ atek bẹ k'ikhaana s'idifhon phyibh bẹ́, abẹ ade okhebh pfọ, masẹ aseng k'ọtọhmnạng kwọ Mosẹs asi ẹyaakha k'okpe kw'ọma Ọvaar Ubinọkpaabyi kw'Ọyọhng, atim ab'otte pamạna abina k'Ijip.”<verse eid="1KI 8:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="1KI 8:54" />Masẹ Sọlọmọn kk'njọhm nnọ usia <char style="it">bẹ́ phyiibh</char>, ọttạra k'idik phyibh s'ophyemi Ọvaar Ubinọkpaabyi, ubin k'ititikha s'ijabyi s'Ọvaar Ubinọkpaabyi k'ibyi s'wạra kk'ndwudwungu ukpikha, ọmmaama mbọhk otena k'ẹrạng. <verse eid="1KI 8:54" /><verse number="55" style="v" sid="1KI 8:55" />Obe mạma ọyọhbh efhonfhạr ch'Israẹl phyibh itta, oben k'ẹrạng-k'ẹrạng bẹ́:<verse eid="1KI 8:55" /></para>
  <para style="pm">
    <verse number="56" style="v" sid="1KI 8:56" />“Ẹtọhnga iyim ẹnạng Ọvaar Ubinọkpaabyi, kw'kk'anạng pẹ Israẹl ẹyọhng-kwokha ọnạnga oche kw'ochekhi. Ọtọhnga kwẹ gwạnọ-gwạnọ kw'oseng k'ọtọhmnạng kwẹ Mosẹs ọtạkha echekha ọkkachẹ, p'ọkhaam itwuna, kòde. <verse eid="1KI 8:56" /><verse number="57" style="v" sid="1KI 8:57" />Tte Ọvaar Ubinọkpaabyi kw'ode Ubinọkpaabyi kwamạna, uninga mạna abẹ, oche kw'uwa uning ab'otte pamạna abẹ; tte nạngẹ mạna ọbọhk otte, nạngẹ mạna ọbạra obonu. <verse eid="1KI 8:57" /><verse number="58" style="v" sid="1KI 8:58" />Tte ọbhạkhẹ nttem samạna antor-ẹ, ambạra ansạkha echo annạng-ẹ, ambạra anchok nnyina, ọttạra ekpebha, ọttạra ntọhna s'uwa ọnạngẹ ab'otte pamạna. <verse eid="1KI 8:58" /><verse number="59" style="v" sid="1KI 8:59" />Tte itọhnga nna saam s'mkpaakhẹ k'Ọvaar Ubinọkpaabyi k'ititikha, isenga ifora Ọvaar Ubinọkpaabyi, kw'ode Ubinọkpaabyi kwamạna k'irungu ọttạra k'ẹya. Tte ẹma ọkkaana ọtọhmnạng kwẹ, ọttạra anạng pẹ Israẹl, otor k'idik sabẹ aroru k'iwu chidede, <verse eid="1KI 8:59" /><verse number="60" style="v" sid="1KI 8:60" />ọfha idifhon s'iyagbin phyibh isonga bẹ́, Ọvaar Ubinọkpaabyi wọ ode Ubinọkpaabyi, ọdwạkh-ọdwạk kha kòde. <verse eid="1KI 8:60" /><verse number="61" style="v" sid="1KI 8:61" />Tte nttem sabạnga phyibh ininga k'Ọvaar Ubinọkpaabyi, kw'ode Ubinọkpaabyi kwamạna, ọfha annuk antor k'ekpebha chẹ, ambạra nsạkha echo annạng k'nnyina s'okpe ngwa.”<verse eid="1KI 8:61" /></para>
  <para style="s1">Ẹbọhkttia ch'ọchọhm anạng Ubinọkpaabyi</para>
  <para style="p">
    <verse number="62" style="v" sid="1KI 8:62" />Wa ọvaar Sọlọmọn ọttạra anạng p'Israẹl phyibh afọhnọ nja k'ititikha s'Ọvaar Ubinọkpaabyi. <verse eid="1KI 8:62" /><verse number="63" style="v" sid="1KI 8:63" />Wa Sọlọmọn utim mmaam nnọhna arạbh afa ukuma chi, ọttạra arạkhạmaan, ọttạra mvu nnọhna arạbh chi, ọfọhnọ ẹja ch'ẹmẹm ọnạng Ọvaar Ubinọkpaabyi. Ma wọ ọvaarnạng ọttạra anạng p'Israẹl phyibh atte ọchọhm ngwọ ọbọhk anạng Ọvaar Ubinọkpaabyi.<verse eid="1KI 8:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="1KI 8:64" />Ma iwu njọ jạnẹ, ọvaarnạng otek ibyi rạnẹ ma ottemkwẹ kw'ẹttọhmma-ttem k'ititikha s'ọchọhm kw'Ọvaar Ubinọkpaabyi, uninga ma usi nnạnga ikkạmasẹ, ọttạra nnạnga s'agwu, ọttạra iyaak s'nnạnga s'ẹmẹm. Wa usi oche ngwọ ukwuru bẹ́, wa ijabyi s'brons s'ining k'ititikha s'Ọvaar Ubinọkpaabyi isạk iyọhnga bẹ́, ivạkha nnạnga ikkạmasẹ, ọttạra nnạnga s'agwu, ọttạra iyaak s'nnạnga s'ẹmẹm.<verse eid="1KI 8:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="1KI 8:65" />Wa Sọlọmọn usi erobha ma okpe ngwọ, ọttạra efhonfhạr ch'Israẹl phyibh, tạma k'anạng p'Lebo-Hamat, tạrr ukpira k'ẹkpẹme ch'Ijip. Wa abẹ atim iwu isenọfa asi erobha njọ k'ititikha s'Ọvaar Ubinọkpaabyi, abẹ attạra adạkhẹ iwu isenọfa idwạkh-ọdwạk. Phyi-phyibh wa abẹ asi erobha njọ iwu sọnachi. <verse eid="1KI 8:65" /><verse number="66" style="v" sid="1KI 8:66" />Iwu ikwu echobha, ọtọhm anạng mbọ abẹ abhạna. Abẹ ado ọvaarnạng, akpa nnạm abhạna k'ichọhm sabẹ, k'orebhada, ọttạra ottennebh awẹ, ukwuru idik-jibhada phyi-pyibh s'Ọvaar Ubinọkpaabyi kk'usia ọnạng ọtọhmnạng kwẹ Devid, ọttạra anạng pẹ Israẹl.<verse eid="1KI 8:66" /></para>
  <chapter eid="1KI 8" />
  <chapter number="9" style="c" sid="1KI 9" />
  <para style="s1">Ọvaar Ubinọkpaabyi uyini Sọlọmọn abẹ</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 9:1" />Masẹ Sọlọmọn kk'Ọchọhm kw'Ọvaar Ubinọkpaabyi, ọttạra ọvaarter okkera, ọbạra okkera udik kwidede kw'ọkkẹ bẹ́, usi, <verse eid="1KI 9:1" /><verse number="2" style="v" sid="1KI 9:2" />Ọvaar Ubinọkpaabyi uyin Sọlọmọn abẹ ottong ikpe ifa, k'oche kw'uwa uyini abẹ kha Gibeọn. <verse eid="1KI 9:2" /><verse number="3" style="v" sid="1KI 9:3" />Ọvaar Ubinọkpaabyi oben-ẹ bẹ́:</para>
  <para style="pm" vid="1KI 9:3">“Amma kk'njọhm sọ, ọttạra ephyema ch'kk'asia k'ititikha saam mmaanga; amma kk'ọchọhm kw'kk'asia ntekha nchok bẹ́, ma wọ kw'anạng m'n'akpobha eche chaam tạrr ipimmanitor. Achen paam m'akkeri ma, ettem chaam m'ẹbạra efona ororo ininga ma.<verse eid="1KI 9:3" /></para>
  <para style="pm">
    <verse number="4" style="v" sid="1KI 9:4" />“Node ọma, de atwạn-m abẹ k'nnạm-phyạphye ọttạra ettem jạnẹ ọttạra etora, k'oche kw'uwa atte Devid usi, asi idik phyibh ator k'oche kw'mben-ọ bẹ́ asi, abạra achok akpebhi ọttạra nnyina saam, <verse eid="1KI 9:4" /><verse number="5" style="v" sid="1KI 9:5" />amma m'nttima ẹvaarchi ch'ẹvaar chọ arạnga k'Israẹl tạrr ipimmanitor, oche kw'uwa nchekhi nnạng atte Devid, k'okpe kw'mbeni bẹ́, ‘Ọma itwuna kède bẹ́, m'akhaama ọnạng ọkhaama kw'm'otera echo chọ masẹ ọvaarnạng kw'Israẹl.’<verse eid="1KI 9:5" /></para>
  <para style="pm">
    <verse number="6" style="v" sid="1KI 9:6" />“Okhenka, de abạnga ma, ọbạra ode iva p'iva pabạnga bọ akpa nnạm avạr-m, abạnga akuma nnyina saam, ọttạra akpebhi paam p'kk'bạnga nnạnga chu-chok, abạnga atera ata asạkha ncho, abạra asi idik idwạkh-ọdwạk, <verse eid="1KI 9:6" /><verse number="7" style="v" sid="1KI 9:7" />amma m'ndimi anạng p'Israẹl k'isek s'amma kk'bẹ nnạnga, mbạra mfhum ọchọhm ngwa kw'kk'ntekha nchok bẹ́, anạng akpobha eche chaam. Anạng p'Israẹl bạra ade ọsammadik ọttạra innukhudik k'ikhaana s'idifhon phyibh. <verse eid="1KI 9:7" /><verse number="8" style="v" sid="1KI 9:8" />Ọchọhm ngwa bạra ode ọtakwung. M'okkona anạng phyibh p'm'aseng ma, abẹ m'akpaak innukhu aben bẹ́, ‘Ukwuru yạn kw'Ọvaar Ubinọkpaabyi usi udik-demakwẹ ngwa ma isek nna, ọttạra ma ọchọhm ngwa o?’ <verse eid="1KI 9:8" /><verse number="9" style="v" sid="1KI 9:9" />Anạng bạra abhina bẹ́, ‘Ukwuru sabẹ kk'nnạm akpa avạra Ọvaar Ubinọkpaabyi, kw'ode Ubinọkpaabyi kwabẹ, kw'uwa utim ab'otte pabẹ ubina k'Ijip e. Idik idwạkh-ọdwạk n'ichi bẹ ẹja, abẹ asạkha ncho anạng sẹ, abạra akpobha sẹ. Ẹgwọ usi Ọvaar Ubinọkpaabyi ọnạngẹ bẹ ọkhạmkạmọ nwa phyibh e.’ ”<verse eid="1KI 9:9" /></para>
  <para style="s1">Ibọhktọhm idwạkh-ọdwạk s'Sọlọmọn</para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 9:10" />Wa k'cho kw'ottong icho ẹrạbh wọ kw'Sọlọmọn usi ibyi nna ifa s'ide: Ọchọhm kw'Ọvaar Ubinọkpaabyi, ọttạra ọvaarter. <verse eid="1KI 9:10" /><verse number="11" style="v" sid="1KI 9:11" />Wa ọvaar Sọlọmọn ọnạngẹ ọvaar Hiram kw'Taya ifhon ẹrạbh s'Galilee, ukwuru nchi s'sida, ọttạra nchi s'siprẹs, ọttara gol kw'uwa Hiram kk'Sọlọmọn ọnạnga oche kw'ororu. <verse eid="1KI 9:11" /><verse number="12" style="v" sid="1KI 9:12" />Okhenka, masẹ Hiram ubin kha Taya bẹ́, ọta ose ifhon s'Sọlọmọn kk'ẹ ọnạnga, wa ifhon nnọ khẹ ettem nírebha. <verse eid="1KI 9:12" /><verse number="13" style="v" sid="1KI 9:13" />Nọbạbh-ọ bẹ́, “Ayi kwaam, bạng ifhon-demasẹ rọ s'anạng-m ma?” Wa oyeri ifhon nnọ Ẹkhạma ch'Kabul<note caller="+" style="f"><char style="fr" closed="false">9.13 </char><char style="ft" closed="false">Kabul k'eHiburu uyini ibyi s'nạ́n ọttọhk ipe.</char></note>. Mạnna wọ kw'ibyi nnọ ikpen tạrr ukpira chemma. <verse eid="1KI 9:13" /><verse number="14" style="v" sid="1KI 9:14" />Node s'uwa Hiram kk'atalẹn arạbh asajạnẹ p'gol ọtọhma okkena ọvaar Sọlọmọn.<verse eid="1KI 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 9:15" />Maa wọ ode itoru s'ọtọhm f'Ọchọhm kw'Ọvaar Ubinọkpaabyi f'uwa Sọlọmọn utim anạng usi, ọttạra ọvaarter kwẹ, ọttạra egbo, ọttạra udimokpon kw'Jẹrusalẹm, ọttạra Hazọr, ọttạra Mẹgido, ọttạra Gẹzẹr. <verse eid="1KI 9:15" /><verse number="16" style="v" sid="1KI 9:16" />(Node s'uwa Phero, kw'ode ọvaarnạng kw'Ijip kk'ofhon kw'Gẹzẹr akwẹ urima, okhema kwẹ, oge kwẹ ekpon ọkkạmọ. Ọfhọ aKenaan p'arukhu ma, bạrasẹ n'ọtạk ofhon ngwọ masẹ ẹnạnga ch'ọbada, ọnạng uminanwa kwẹ kw'ọba Sọlọmọn. <verse eid="1KI 9:16" /><verse number="17" style="v" sid="1KI 9:17" />Sọlọmọn ọbạra ọkpa nnạm usi ofhon kw'Gẹzẹr.) Usi ofhon-ẹrạkha kw'Bẹt-Họrọn, <verse eid="1KI 9:17" /><verse number="18" style="v" sid="1KI 9:18" />ọttạra Baalat, ọttạra Tamar, k'ibyi s'anạng nạnárukha, ma isisek sẹ, <verse eid="1KI 9:18" /><verse number="19" style="v" sid="1KI 9:19" />ọttạra efhondiden s'ọkhaanga-chọhm, ọttạra ifhon s'akpaar pẹ p'nnyạnyaang n'itwạr, ọttạra ifhon s'nnyạnyaang s'Sọlọmọn. Wa usi udik kwidede kw'ọdaakhẹ bẹ́, usi k'Jẹrusalẹm, ọttạra k'Lebanọn, ọbaabha nkhạma sidede s'uwa ọdạbhẹ.<verse eid="1KI 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1KI 9:20" />Wa anạng p'Amọr ọttạra p'Het, ọttạra p'Pẹriz, ọttạra p'Hiv, ọttạra p'Jẹbus (p'uwa nạn Israẹl nábina), atim arikhi ma ibyi nnọ. <verse eid="1KI 9:20" /><verse number="21" style="v" sid="1KI 9:21" />Wa iva p'iva p'anạng mbọ p'uwa arikhi ma isek nnọ, p'anạng p'Israẹl nạnákke akhubh bọ p'uwa Sọlọmọn n'utima usi ibira-tọhm sẹ, oche kw'ode tạrr ukpira chemma. <verse eid="1KI 9:21" /><verse number="22" style="v" sid="1KI 9:22" />Okhenka, wa ọnạng wạnọ-wạnọ kw'ubin Israẹl kw'Sọlọmọn oge k'ibira kòde; wa utim bẹ usi arim-ekpong pẹ, ọttạra ikhaana s'ẹfa chẹ, ọttạra atim-eden p'ekpong, ọttạra atọhmnạng pẹ, ọttạra ayaar-nnyạnyaang, ọttạra adecho p'ijaar s'nnyạnyaang n'itwạr, ọttạra p'ayaar-nnyạnyaang. <verse eid="1KI 9:22" /><verse number="23" style="v" sid="1KI 9:23" />Wa Sọlọmọn ọbạra ọkhaama anạng ẹnọhna ukuma arạbh asenọfa ukuma jobh, p'usi adecho p'itọhm p'n'akkeri atọhmnạng.<verse eid="1KI 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1KI 9:24" />K'okpe kw'uwa uminanwa kw'Phero kk'ubina kha efhondiden ch'Devid ukwu k'ọvaarchọhm kw'Sọlọmọn kk'usia ọnạng-ẹ, Sọlọmọn ukwu usi egbo ọttạra ma.<verse eid="1KI 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 9:25" />Wa Sọlọmọn n'ọfọhnọ ẹja ch'nnạnga ikkạmasẹ, ọttạra ch'nnạnga s'ẹmẹm ikpe ittaan k'cho, k'ijabyi s'kk'usia, ọnạng Ọvaar Ubinọkpaabyi. Wa n'ọbạra ọkkạmọ insẹns ma ititikha s'Ọvaar Ubinọkpaabyi ma okpe ngwọ gwạnọ ọttạra ẹjafọhna. Ma wọ okker ọchọhm ngwọ usi.<verse eid="1KI 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 9:26" />Wa ọvaar Sọlọmọn ọbạra usi ijaar sididen s'asi kha Ẹziyọn-Gẹbẹr, kw'ọbaang Ẹlat, k'ẹkhạma ch'Edom, k'ẹraangakha ch'Ẹraanga-khora. <verse eid="1KI 9:26" /><verse number="27" style="v" sid="1KI 9:27" />Ma wọ Hiram ọtọhmọ ajunung pẹ p'akke ijaar sididen s'asi yạyaar, abẹ ata ator ajunung p'Sọlọmọn p'n'ayaar ijaar sẹ sididen s'asi. <verse eid="1KI 9:27" /><verse number="28" style="v" sid="1KI 9:28" />Abẹ ayaarẹ afona k'Ophir, ata atima atalẹn p'gol ẹnọhna ukuma ẹrạbh, p'abẹ atim akkena ọvaar Sọlọmọn.<verse eid="1KI 9:28" /></para>
  <chapter eid="1KI 9" />
  <chapter number="10" style="c" sid="1KI 10" />
  <para style="s1">Ọvaarnạng kw'ikwanạng kw'ubin Shẹba udibh Sọlọmọn</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 10:1" />Masẹ ọvaarnạng kw'ikwanạng kw'ubin Shẹba ọbhaang oche kw'Sọlọmọn uyini eche, ọttạra ikhaana s'ẹma ọttạra Ọvaar Ubinọkpaabyi, ukwu ndwạna s'ikpọhkhọ-ọkpọhkhọ asẹ bẹ́, ukwu oyoma Sọlọmọn. <verse eid="1KI 10:1" /><verse number="2" style="v" sid="1KI 10:2" />Wa ukpir k'Jẹrusalẹm ọttạra ẹkhaan ch'afanạng, ọttạra akamẹl p'atọhk ekpo py'erebhi iruk, ọttạra gol k'ọsaabh, ọttạra ata akkapyẹ k'ukhira-k'ukhira. Masẹ okhebh Sọlọmọn, ọkpaakh-ẹ udik kwidede kw'uning-ẹ k'ettem. <verse eid="1KI 10:2" /><verse number="3" style="v" sid="1KI 10:3" />Sọlọmọn ubhin-ẹ ndwạna phyibh s'ọbạbh-ẹ; wa udik gwạnọ-gwạnọ kw'ọkhaarẹ ọvaarnạng ọkhaarẹ bẹ́, ubhin-ẹ kòde. <verse eid="1KI 10:3" /><verse number="4" style="v" sid="1KI 10:4" />Masẹ ọvaarnạng nwọ kw'ikwanạng kw'ubin Shẹba ose ekkoji-dema ch'Sọlọmọn ọkhaam, ọttạra ọvaarter kw'kk'usia, <verse eid="1KI 10:4" /><verse number="5" style="v" sid="1KI 10:5" />ọttạra uchiattọhk f'ọnạn k'okpokkro kwẹ, ọttạra oche kw'anạng p'ikhaana sẹ aning ẹyạr, ọttạra atọhmnạng pẹ ọttạra nnya sabẹ age, ọttạra anạng p'n'anạng-ẹ atwuk, ọttạra nnạnga ikkạmasẹ s'usi k'ọchọhm kw'Ọvaar Ubinọkpaabyi, ifor ipẹ-ẹ.<verse eid="1KI 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 10:6" />Oben ọvaarnạng bẹ́, “Ẹkkaabha ch'amma mmaang k'ẹkhạma chaam otena idik s'asi, ọttạra ekkoji chọ, ede udik ọkka. <verse eid="1KI 10:6" /><verse number="7" style="v" sid="1KI 10:7" />Okhenka, wa amma nkhaang idik nnọ tạrr, n'nkwu ntima achen paam nse sẹ. K'udik ọkka, abẹ khaam ibhaakha s'idik nna nákpaakha; ekkoji chọ ọttạra ẹkhaama chọ ẹbạrẹ ẹyọhnga ẹkkaabha ch'amma mmaang. <verse eid="1KI 10:7" /><verse number="8" style="v" sid="1KI 10:8" />Anạng pọ n'akhaama ottennebh! Ottennebh ọbạra uyima ọnạng anạng pọ, p'n'aninga k'ititikha sọ k'okpe kwidede abhaanga ekkoji chọ! <verse eid="1KI 10:8" /><verse number="9" style="v" sid="1KI 10:9" />Ẹtọhnga iyim ẹnạng Ọvaar Ubinọkpaabyi, kw'ode Ubinọkpaabyi kwọ, kw'kk'ottennebh ọtạkha kakhọ, ọbạra ọtạkh-ọ ochok ẹyạr k'ẹvaarchi ch'Israẹl. Ubin k'idạdaakha s'Ọvaar Ubinọkpaabyi s'nạn ekponga ikhaam, s'ọkhaam ọttạra anạng p'Israẹl, usi-ọ ọvaarnạng bẹ́, ọma m'n'akpaara aponga k'eden ọkkachẹ, ch'ẹbạra etor-otor.”<verse eid="1KI 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 10:10" />Wa ọnạngẹ ọvaarnạng atalẹn arạbh asajạnẹ p'gol, ọttạra ekpo py'erebhi iruk k'ọsaabh, ọttạra ata akkapẹ k'ukhira-k'ukhira. Wa ekpo py'erebhi iruk, py'ẹsaabhẹ eyongu py'ọvaarnạng nwọ kw'ikwanạng kw'ubin Shẹba utim okkena ọvaar Sọlọmọn kède.<verse eid="1KI 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 10:11" />(Wa ijaar s'Hiram s'asi ibin kha Ophir ikwu ittạra gol; abẹ abạra atọhkha ekpo k'ọsaabh py'ichi ch'almug, ọttạra ata akkapẹ k'ukhira-k'ukhira abina kha akwu. <verse eid="1KI 10:11" /><verse number="12" style="v" sid="1KI 10:12" />Wa ọvaarnạng utim ichi njọ ch'almug usi achidaak p'Ọchọhm kw'Ọvaar Ubinọkpaabyi, ọttạra k'ọvaarter, ọbạra utima usi abukpọhng, ọttạra agimangim ọnạng akkọhn-mmạng. Tạma ma iwu njọ, abẹ ichi ch'almug k'ọsaabh oche ngwọ tạm násia, bạra node bẹ́, abẹ m'adebh atima akwu.)<verse eid="1KI 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 10:13" />Wa ọvaar Sọlọmọn ọnạngẹ ọvaarnạng nwọ kw'ikwanạng kw'ubin Shẹba ọttọhk fidede f'ororu, ọttạra f'ọbạbh-ẹ, oyongu ekpo py'kk'ẹ ọnạnga bạra k'ọvaarchọhm kwẹ. Ma wọ utim anạng pẹ k'ẹkhaan ọkpa nnạm ọbhạna k'ẹkhạma chẹ.<verse eid="1KI 10:13" /></para>
  <para style="s1">Ẹkhaama ch'Sọlọmọn</para>
  <para style="p">
    <verse number="14" style="v" sid="1KI 10:14" />Wa adọhbh p'gol kw'Sọlọmọn n'ọtạkha k'cho ade adọhbh p'atalẹn ẹnọhna ukuma arạbh jobh-kanttaan ukuma asajạnẹ, <verse eid="1KI 10:14" /><verse number="15" style="v" sid="1KI 10:15" />de arạbh p'ọtạk k'mbọhk s'anạng p'n'asenga mphya, ọttạra ntuma s'avạar p'Arabiya, ọttạra s'adạbhẹ-nkhạma n'anạng-ẹ.<verse eid="1KI 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1KI 10:16" />Wa ọvaar Sọlọmọn utim gol udwuk akhọhnkpa p'abạrẹ ẹkpa; utima ashẹkẹl p'gol ẹnọhna ukuma arạbh jobh usi ọkhọhnkpa wạnọ. <verse eid="1KI 10:16" /><verse number="17" style="v" sid="1KI 10:17" />Wa ọbạra utima gol udwuk akhọhnkpa arạbh chi p'asạk ẹkpa, utima amina attaan p'gol usi ọkhọhnkpa wạnọ. Ọvaarnạng ọtạkha pyẹ ochok k'Ọchọhm kw'Ẹkpa ch'Lebanọn.<verse eid="1KI 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1KI 10:18" />Ọvaarnạng usi ẹvaarchi chididen ch'utim ekpo masẹ nnyi-sa odokha, ọbạra utima gol ọkkakwẹ ọfhạrọ wẹ. <verse eid="1KI 10:18" /><verse number="19" style="v" sid="1KI 10:19" />Wa ẹvaarchi njọ ẹkhaam ibyạrẹ-mfhok nsajạnẹ sabẹ n'asenga avura k'nnạm s'ẹvaarchi njọ, abẹ asi ibyi s'ide iriringi s'm'ọnạna echo. Wa ẹvaarchi njọ ẹkhaam mbọhk-nạna mfa, abẹ agwa nkke s'ibe ibaanga k'udimbọhk ọttạra k'ọkwabọhk. <verse eid="1KI 10:19" /><verse number="20" style="v" sid="1KI 10:20" />Nkke jobh-kamfa sabẹ agwa ibe ma k'ibyạrẹ-mfhok nnọ nsajạnẹ, ikkeri ayok ititikha. Ẹkhạma jạnẹ-jạnẹ ch'kk'oche ngwọ isia kède. <verse eid="1KI 10:20" /><verse number="21" style="v" sid="1KI 10:21" />Wa atwuk-gbạre p'ọvaar Sọlọmọn phyibh ade gol, ekpo-bhaakha phyi-phyibh py'ọchọhm kw'Ẹkpa ch'Lebanọn ẹbạra ede gol akkapẹ. Ọttọhk vạnọ-vạnọ f'abẹ atim silva asi kòde, ukwuru s'uwa silva nạn ọttọhk núpua k'okpe kw'Sọlọmọn. <verse eid="1KI 10:21" /><verse number="22" style="v" sid="1KI 10:22" />Wa ọvaar Sọlọmọn ọkhaam ijaar sididen s'asi k'ọsaabh k'ọraanga kwididen, ọttạra k'ijaar s'Hiram. Wa ijaar nnọ s'Tarshish n'ita osenga ikwuna, okpe gwạnọ k'icho ittaan. Asẹ n'itọhkha gol, ọttạra asilva, ọttạra ekpo masẹ nnyi-sa, ọttạra ajijankkọhm, ọttạra nnyobha.<verse eid="1KI 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 10:23" />Wa ọvaar Sọlọmọn ọkhaam ẹkhaama chididen ọttạra ekkoji ọyọhnga avaar mbọkha p'iyagbin phyibh. <verse eid="1KI 10:23" /><verse number="24" style="v" sid="1KI 10:24" />Iyagbin <char style="it">bẹ́ wạạm</char> n'ikwu ikhebha Sọlọmọn, ọfha abẹ abhaanga ekkoji ch'Ubinọkpaabyi kk'ẹ ọnạnga. <verse eid="1KI 10:24" /><verse number="25" style="v" sid="1KI 10:25" />Cho kwidede, ukhikhennạng kwidede kw'ukwu n'utima ẹnạnga ch'silva, ọttạra gol, ọttạra ọvạra, ọttạra ekpongkpo, ọttạra ekpo py'erebhi iruk, ọttạra nnyạnyaang, ọttạra nnyạnyaang s'akhira adwạkh-ọdwạk.<verse eid="1KI 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 10:26" />Wa Sọlọmọn ọkhaam ijaar s'nnyạnyaang n'itwạr, ọttạra nnyạnyaang k'ọsaabh. Wa ọkhaam ijaar s'nnyạnyaang n'itwạr nnọhna nttaan ukuma arạbh jobh, ọttạra nnyạnyaang nnọhna arạbh afa ukuma jobh s'ochokhu k'ifhondiden s'ijaar s'nnyạnyaang n'itwạr, ọttạra kha Jẹrusalẹm kw'ọvaarnạng urukhu. <verse eid="1KI 10:26" /><verse number="27" style="v" sid="1KI 10:27" />Ọvaar Sọlọmọn usi asilva asaabh k'Jẹrusalẹm masẹ ata, ọbạra usi nchi s'sida isaabh masẹ nchi s'sikamọr p'akpechorin. <verse eid="1KI 10:27" /><verse number="28" style="v" sid="1KI 10:28" />Wa Sọlọmọn odebhi nnyạnyaang sẹ k'Ijip, ọttạra k'Kuwe, wa asenga-mphya p'ọvaarnạng adebhi sẹ kha Kuwe ator k'oche kw'ẹphya ede ma okpe ngwọ. <verse eid="1KI 10:28" /><verse number="29" style="v" sid="1KI 10:29" />Wa abẹ adebhi ọkpaar kw'nnyạnyaang n'itwạr k'ashẹkẹl p'asilva, ẹnọhna ukuma arạbh jobh k'Ijip, ọttạra ẹnyạnyaang k'ashẹkẹl arạbh asenọfa ukuma jobh. Abẹ abạra atọhm pyẹ akkena avaar p'Het, ọttạra p'Aram.<verse eid="1KI 10:29" /></para>
  <chapter eid="1KI 10" />
  <chapter number="11" style="c" sid="1KI 11" />
  <para style="s1">Ipanạng p'Sọlọmọn</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 11:1" />Ayongu ọkwanạngnwa kw'Phero, wa ọvaar Sọlọmọn ode ọnạng kw'ipanạng p'abin ifhon idwạkh-ọdwạk adaakhẹ. Wa ọtạk ipanạng p'Moab, ọttạra p'Ammọn, ọttạra p'Edom, ọttạra p'Sidọn, ọttạra p'Het k'ọbada. <verse eid="1KI 11:1" /><verse number="2" style="v" sid="1KI 11:2" />Wa ipanạng mbọ abin k'idifhon nnọ s'uwa Ọvaar Ubinọkpaabyi kk'anạng p'Israẹl obena bẹ́, “Abạnga ipanạng k'ifhon nna k'ọbada kátạkha o, ukwuru bẹ́, abẹ m'abhạkhẹ nttem sabạnga ọbhạkhẹ, abạnga akpobha akha pabẹ.” Tạrr oseng ma, Sọlọmọn osengi idạdaakha asẹ ọvạkha bẹ ochok. <verse eid="1KI 11:2" /><verse number="3" style="v" sid="1KI 11:3" />Wa ọkhaam ipanạng ẹnọhna ukuma arạbh chi p'ade iva p'avaarnnạng, ọbạra ọkhaama amina-panạng arạbh chi. Ipanạng mbọ wa atim-ẹ attena apa. <verse eid="1KI 11:3" /><verse number="4" style="v" sid="1KI 11:4" />K'okpe kw'Sọlọmọn kk'ọtạma, ipanạng pẹ atim-ẹ okpobha akha, asi ettem chẹ phyibh k'Ọvaar Ubinọkpaabyi, kw'ode Ubinọkpaabyi kwẹ dạk núgia, k'oche kw'uwa ettem ch'otte Devid kk'idia. <verse eid="1KI 11:4" /><verse number="5" style="v" sid="1KI 11:5" />Sọlọmọn okpobh Ashtọrẹt kw'ode ọkha f'ikwanạng f'anạng p'Sidọn, ọttạra Molẹk, f'ode ọkha f'anạng p'Ammọn, f'ukpukhu anạng ukpukhu. <verse eid="1KI 11:5" /><verse number="6" style="v" sid="1KI 11:6" />Mạnna wọ Sọlọmọn usi ibyibyia-dik k'ititikha s'Ọvaar Ubinọkpaabyi; ettem phyibh nútima ọtwạn Ọvaar Ubinọkpaabyi abẹ, oche kw'uwa otte kwẹ Devid kk'Ubinọkpaabyi abẹ ọtwạna.<verse eid="1KI 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 11:7" />Wa Sọlọmọn usi ikpukpobha-byi s'ọyaankpa, k'okpecho kw'uning k'ukhubha kw'ududon n'uyin kha Jẹrusalẹm, ọnạng Kẹmọsh kw'ode ọkha f'anạng p'Moab f'ukpukhu anạng ukpukhu, ọbạra usi ọnạng anạng p'Molẹk kw'ode ọkha f'anạng p'Ammọn, f'ukpukhu anạng ukpukhu. <verse eid="1KI 11:7" /><verse number="8" style="v" sid="1KI 11:8" />Wa usi oche ngwọ ọnạng ipanạng pẹ phyibh p'abin idifhon idwạkh-ọdwạk, p'n'akkạmọ insẹns, abạra afọhnọ nja anạng ikha sabẹ.<verse eid="1KI 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 11:9" />Wa ettem ipyibhi Ọvaar Ubinọkpaabyi otena Sọlọmọn, ukwuru s'kk'nnạm ọkpa ọvạra Ọvaar Ubinọkpaabyi, kw'ode Ubịnọkpaabyi kw'Israẹl, kw'kk'abẹ uyina nden mfa. <verse eid="1KI 11:9" /><verse number="10" style="v" sid="1KI 11:10" />Tạrr oseng s'uwa kk'Sọlọmọn eden ọkpa bẹ́ nạngẹ akha okpobh, Sọlọmọn ntọhna s'Ọvaar Ubinọkpaabyi nọ́tạkha. <verse eid="1KI 11:10" /><verse number="11" style="v" sid="1KI 11:11" />Ma wọ Ọvaar Ubinọkpaabyi obeni Sọlọmọn bẹ́, “Masẹ ode bẹ́ ọmmaana-che kwọ ẹgwọ ma, ọma echekha chaam ọttạra akpebhi paam p'nnạng-ọ náchokha, itwuna kède bẹ́ m'mmaangẹ ẹkhạma nja kakhọ k'mbọhk, nnạng ọnạng wạnọ k'atọhmnạng pọ. <verse eid="1KI 11:11" /><verse number="12" style="v" sid="1KI 11:12" />Okhenka, amma udik ngwa ma okpe kwọ mạ́nsi, ukwuru atte Devid, m'nsi ẹbhaangẹ k'okpe kw'nnwa kwọ. <verse eid="1KI 11:12" /><verse number="13" style="v" sid="1KI 11:13" />Tạrr oseng ma, ofhon ngwa phyibh mạ́mmaangẹ. Okhenka, m'nnạng-ẹ ẹkhạma jạnẹ, ukwuru ọtọhmnạng kwaam Devid, ọttạra Jẹrusalẹm kw'kk'ntekha.<verse eid="1KI 11:13" /></para>
  <para style="s1">Awawunanạng p'Sọlọmọn</para>
  <para style="p">
    <verse number="14" style="v" sid="1KI 11:14" />Wa Ọvaar Ubinọkpaabyi otte Sọlọmọn ọbọhk ọkhaama ọwawunanạng kw'ode Hadad kw'ubin Edom, k'efonamma ch'ọvaarnạng kw'Edom. <verse eid="1KI 11:14" /><verse number="15" style="v" sid="1KI 11:15" />K'ocheden-kpe, masẹ Devid n'urima anạng p'Edom abẹ, Joab kw'ode ochonạng kw'akpongnạng, kw'kk'ofona bẹ́, ọta ọnnọhnga anạng p'kk'akpua, okpong kha ọfhọ anạng p'Edom phyibh. <verse eid="1KI 11:15" /><verse number="16" style="v" sid="1KI 11:16" />Wa Joab ọttạra anạng p'Israẹl phyibh abhingi ma k'aphye asajạnẹ, tạrr abẹ afhọ ajunung p'Edom phyibh. <verse eid="1KI 11:16" /><verse number="17" style="v" sid="1KI 11:17" />Okhenka, Hadad kw'uwa utim ode udikkobh, ọtwạnọ ikhaana rạnẹ s'ibin Edom abẹ, p'uwa ade atọhmnạng p'otte, abẹ arạbh afona Ijip. <verse eid="1KI 11:17" /><verse number="18" style="v" sid="1KI 11:18" />Abẹ abin k'Midiyan afona kha Paran. Abẹ atạkha ajunung bạnọ ma Paran afona k'Ijip, ata akhebha Phero kw'ode ọvaarnạng kw'Ijip, kw'ọtạk ọchọhm ọttạra isisek ukwu ọttạra k'uchiattọhk ọnạng Hadad.<verse eid="1KI 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 11:19" />Wa Phero orebhi ettem Hadad abẹ tạrr ọtạkha nnwọkka kw'ọvaarnạng kw'ikwanạng Tahpenes kw'ode ikwanạng kwẹ, ọnạng Hadad k'ọbada. <verse eid="1KI 11:19" /><verse number="20" style="v" sid="1KI 11:20" />Nnwọkka nwọ kw'Tahpenes, kw'ikwanạng ọmaan-ẹ ujunungnwa kw'okpen Gẹnubat, kw'uwa Tahpenes ọrạkhẹ k'ọvaarter. Ma wọ Gẹnubat urukhu ọttạra iva p'Phero oyeni.<verse eid="1KI 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1KI 11:21" />Okpe kw'uwa Hadad utim uning k'Ijip, ọbhaang bẹ́ Devid kk'upua otor ab'otte, ọbạra ọbhaanga bẹ́, Joab kw'ode odecho kw'akpongnạng kk'upua ọttạra. Ma wọ Hadad obeni Phero bẹ́, “Tte-m ọbọhk mfona, ọfha mkpa nnạm k'ẹkhạma chaam.”<verse eid="1KI 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 11:22" />Phero n'ọbạbh-ẹ bẹ́, “Mbạng vọ owor-ọ ma ofhon ngwa kw'n'abạra akpa nnạm k'ẹkhạma chọ o?”</para>
  <para style="p" vid="1KI 11:22">Hadad ọpọhna bẹ́, “Ọttọhk sạng, khenka tte-m ọbọhk mfona!”<verse eid="1KI 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 11:23" />Ubinọkpaabyi ọbạra otte Sọlọmọn ọbọhk ọkhaama ọwawunanạng ọdwạkh-ọdwạk kw'okpen Rẹzọn, kw'ode nnwa kw'Eliyada, kw'uwa ọrạbhọ k'mbọhk s'aro kwẹ Hadadẹzẹr, kw'ode ọvaarnạng kw'Zoba. <verse eid="1KI 11:23" /><verse number="24" style="v" sid="1KI 11:24" />K'okpe Devid udimi akpongnạng p'Zoba, wa Rẹzọn otobh ikhaana s'ajunung p'acher k'akhẹ, ukwu ode bẹ utim-eden, abẹ akwu aseng afona kha Damaskọs ata uruk, abạra akhaama ẹfa. <verse eid="1KI 11:24" /><verse number="25" style="v" sid="1KI 11:25" />Wa Rẹzọn ode ọwawunanạng kw'Israẹl k'akpen p'Sọlọmọn phyibh, akwu attạra k'ẹkhọhr ch'uwa Hadad n'ọnạng-ẹ. Wa Rẹzọn ọdạbhẹ Aram, okhenka uwuna Israẹl.<verse eid="1KI 11:25" /></para>
  <para style="s1">Jẹroboam utim ẹkhọhr otor Sọlọmọn</para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 11:26" />Wa Jẹroboam kw'ode ujunungnwa kw'Nẹbat ọbạra utima ẹkhọr otor ọvaarnạng. Ẹma wa ode ọnạng wạnọ k'ikhaana s'atọhmnạng p'Sọlọmọn, kw'ubin Zẹrẹda, k'ẹkhạma ch'Ephraim, ọkka kwẹ ode opokwa kw'okpen Zeruya.<verse eid="1KI 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1KI 11:27" />Maa wọ ode oche kw'oten k'ẹkhọhr ch'Jẹroboam utim otor ọvaar Sọlọmọn. Wa Sọlọmọn kk'egbo utubha ọkpa abhaang py'aphyaakhẹ k'udimokpon kw'efhondiden ch'Devid. <verse eid="1KI 11:27" /><verse number="28" style="v" sid="1KI 11:28" />Wa Jẹroboam ode ujunung kw'ọkhaam emengkka. Masẹ Sọlọmọn ose ọtọhm-jibhada f'udikkobh nwọ usi, ọtạkh-ẹ usi ochonạng kw'atọhmnạng phyibh p'nkhạma s'Josẹph.<verse eid="1KI 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 11:29" />Ma okpe ngwọ, wa Jẹroboam ubin k'Jẹrusalẹm bẹ́ uyin k'iyaan, Ahija kw'ode usi-ẹyaakha kw'ubin Shilo, kw'oge ọnọhma-wuraam ọbhakwẹ, okhebh-e k'eden. Abẹma anạng afa mạnkkeni atwạnọ ikhaana abina arik ofhon. <verse eid="1KI 11:29" /><verse number="30" style="v" sid="1KI 11:30" />Ahija ọvạkha ọnọhma-wuraam ọbhakwẹ kw'oge ọyaakhẹ k'akpa-k'akpa k'ibyi jobh-kamfa. <verse eid="1KI 11:30" /><verse number="31" style="v" sid="1KI 11:31" />Nobeni Jẹroboam bẹ́, “Rengi akpa jobh anạng ọma oyeni, khiri Ọvaar Ubinọkpaabyi, kw'ode Ubinọkpaabyi kw'Israẹl obeni bẹ́, ‘Kker e, amma m'mmaangẹ ofhon ngwa k'mbọhk s'Sọlọmọn, ntạkha nkhạma jobh nnạng-ọ. <verse eid="1KI 11:31" /><verse number="32" style="v" sid="1KI 11:32" />Okhenka, ukwuru ọtọhmnạng kwaam Devid, ọttạra efhondiden ch'Jẹrusalẹm, ch'kk'ntekha k'ikhaana s'nkhạma s'Israẹl phyibh, ẹma Sọlọmọn m'ọkhaama ẹkhạma jạnẹ. <verse eid="1KI 11:32" /><verse number="33" style="v" sid="1KI 11:33" />Amma m'nsi oche ngwọ, ukwuru sabẹ kk'nnạm akpa avạr-m, abẹ n'akpobha Ashtọrẹt, kw'ode ọkha f'anạng p'Sidọn ọttạra Kẹmọsh, kw'ode ọkha f'anạng p'Moab, ọttạra Molẹk, kw'ode ọkha f'anạng p'Ammọn, abẹ echo násạkha asenga k'ikpukpobha abamẹ. Abẹ idik s'itor-otor nábạra asia k'ititikha saam. Abẹ akpebhi paam ọttạra nnyina saam nábạra achokha, oche kw'uwa Devid kw'ode otte kw'Sọlọmọn ochokhu.<verse eid="1KI 11:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1KI 11:34" />“ ‘Okhenka, amma ofhon ngwọ phyibh k'mbọhk s'Sọlọmọn mạ́ntạkha; amma kk'ẹ ẹvaar ndạbha k'akpen pẹ phyibh, ukwuru ọtọhmnạng kwaam Devid, kw'ntek, kw'ochokhu nnyina saam, ọttạra akpebhi paam. <verse eid="1KI 11:34" /><verse number="35" style="v" sid="1KI 11:35" />Amma m'ntạkhha ofhon ngwọ k'mbọhk s'nnwa kwẹ, nnạng-ọ nkhạma jobh. <verse eid="1KI 11:35" /><verse number="36" style="v" sid="1KI 11:36" />Amma m'ntạkha ẹkhạma jạnẹ nnạng nnwa kwẹ, ọfha ọyaanttaana kw'ọtọhmnạng kwaam Devid uninga ofona ororo k'ititikha saam k'Jẹrusalẹm, kw'ode efhondiden ch'ntek bẹ́ anạng aninga akpobha eche chaam. <verse eid="1KI 11:36" /><verse number="37" style="v" sid="1KI 11:37" />Okhenka, node ọma, amma m'ntạkh-ọ, bẹ́ adạbh ibyi abaabh-ọbaabha k'oche kw'ọdaakhọ. Ọma wọ m'ade ọvaarnạng kw'Israẹl. <verse eid="1KI 11:37" /><verse number="38" style="v" sid="1KI 11:38" />De asi udik kwidede kw'ntọhn-ọ, abạra asạkha echo k'osenga kwọ amma abẹ, abạra asi idik s'itor-otor k'ititikha saam bẹ́, achok akpebhi paam, ọttạra nnyina saam k'oche kw'ọtọhmnạng kwaam Devid usi, amma m'nninga abọ. M'nnạng-ọ ẹkhạma ch'ẹvaar ch'm'ittima arạnga masẹ njọ ch'uwa Devid ọdạbhẹ, m'mbạra ntạkha Israẹl nạng-ọ. <verse eid="1KI 11:38" /><verse number="39" style="v" sid="1KI 11:39" />Amma m'nạng iva p'iva p'Devid irem ukwuru udik ngwọ, okhenka, asẹ ipimmanitor míninga.’ ”<verse eid="1KI 11:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="1KI 11:40" />Sọlọmọn okhong bẹ́ ọfhọ Jẹroboam, okhenka, Jẹroboam ọrạbhọ ofona k'Ijip, k'ọvaarnạng kw'okpen Shishak, uninga ma tạrr Sọlọmọn ope.<verse eid="1KI 11:40" /></para>
  <para style="s1">Obo kw'Sọlọmọn</para>
  <para style="p">
    <verse number="41" style="v" sid="1KI 11:41" />Idik idwạkh-ọdwạk s'Sọlọmọn usi phyi-phyibh, ọttạra ekkoji ch'uwa ọkhọhk, abẹ akkẹrẹ sẹ k'nnwẹr s'idik s'ẹtạma s'Sọlọmọn. <verse eid="1KI 11:41" /><verse number="42" style="v" sid="1KI 11:42" />Wa Sọlọmọn ode ọvaarnạng k'Jẹrusalẹm, ọdạbhẹ Israẹl <char style="it">bẹ́ wạmm</char> k'icho arạbh afa. <verse eid="1KI 11:42" /><verse number="43" style="v" sid="1KI 11:43" />Wa Sọlọmọn ope otor ab'otte, abẹ annọhng-ẹ k'ẹfhondiden ch'Devid kw'ode otte kwẹ. Rẹhoboam kw'ode nnwa kwẹ, ọtạk ẹvaar ch'otte ọdạbh.<verse eid="1KI 11:43" /></para>
  <chapter eid="1KI 11" />
  <chapter number="12" style="c" sid="1KI 12" />
  <para style="s1">Anạng p'Israẹl akhaam Rẹhoboam abẹ idwạdwạkhọ</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 12:1" />Wa Rẹhoboạm ofon k'Shẹkẹm, s'anạng p'Israẹl phyibh kk'afona kha bẹ́, abẹ ata anạng-ẹ ẹvaar. <verse eid="1KI 12:1" /><verse number="2" style="v" sid="1KI 12:2" />Masẹ Jẹroboam kw'ode nnwa kw'Nẹbat ọbhaang udik ngwọ (k'okpe kw'utim uning k'Ijip, s'uwa ọrạbhọ ọvaar Sọlọmọn ọta uninga), ubina kha Ijip ukwuna. <verse eid="1KI 12:2" /><verse number="3" style="v" sid="1KI 12:3" />Wa abẹ atọhmọ bẹ́ Jẹroboam ukwuna. Ẹma ọttạra ẹkhaan ch'anạng p'Israẹl phyibh afona ata akhebha Rẹhoboam, aben-ẹ bẹ́: <verse eid="1KI 12:3" /><verse number="4" style="v" sid="1KI 12:4" />“Wa atte oge mạna ọyaak kw'ọdọhbh-ọdọhbh. Ọma m'ayekhi mạna ẹtọhm-kpọhkha nja, ọttạra ọyaak kw'oge mạna, khiri amạna m'ansi ọtọhm usi annạng-ọ.”<verse eid="1KI 12:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 12:5" />Rẹhoboam ọpọhna bẹ́, “Abạnga asọhng afona, akpa nnạm k'iwu ittaan.” Mạnna wọ kw'anạng mbọ afon.<verse eid="1KI 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 12:6" />Ma wọ ọvaar Rẹhoboam ọta okhebha adennạng p'uwa kk'ọtọhm asia anạng otte Sọlọmọn, k'okpe kw'uwa urukhu akpen. Ọbạbh bẹ bẹ́, “Yạn wọ kw'abạnga akkẹ bẹ́, wạra m'mmina anạng mbọ idik nnọ?”<verse eid="1KI 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 12:7" />Abẹ abhina bẹ́, “De chemma s'm'akke ade ọtọhmnạng anạng anạng mba, asi ọtọhm anạngẹ bẹ, abạra anạngẹ bẹ ibhina ọkkachẹ, abẹ m'acher-ochera ade atọhmnạng pọ k'okpe kwidede ẹ.”<verse eid="1KI 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 12:8" />Okhenka, Rẹhoboam ufhumu ntọhna s'adennạng mbọ anạng-ẹ, otera ọta ọbạbh ibhagbọ sabẹ atwạnọ abạr, p'n'abạra asi abẹ ọtọhm. <verse eid="1KI 12:8" /><verse number="9" style="v" sid="1KI 12:9" />Ọbạbh bẹ bẹ́, “Ntọhna sabạnga ide yạn? Yạn wọ m'mmina anạng mba p'akwu aben-m bẹ́, ‘Yekhi mạna ọyaak kw'uwa atte oge mạna’?”<verse eid="1KI 12:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 12:10" />Ibhagbọ nnọ sabẹ kk'atwạna abạr, abhin-ẹ bẹ́, “Anạng mba khọ abena bẹ́, ‘Yekhi mạna ọyak kw'uwa atte oge mạna, age mạna kwọ kw'obhekh-obhekhi.’ M'atek bẹ bẹ́, ‘Amma ẹnọhna-kpikperi chaam idini ẹyọhnga irin ch'otte kwaam e. <verse eid="1KI 12:10" /><verse number="11" style="v" sid="1KI 12:11" />Otte kwaam wa oge bạnga ọyaak kw'ọdọhbhọ-ọdọhbh, amma m'ntera nsi awẹ odo ọdọhbh-ọdọhbh.Wa otte kwaam utim achiva uvun bạnga, amma m'abạra ntima afonukpan mvun bạnga e.’ ”<verse eid="1KI 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1KI 12:12" />Iwu nnọ ittaan ikwu iseng, Jẹroboam ọttạra anạng mbọ phyibh akpa nnạm k'Rẹhoboam, k'oche kw'ọvaarnạng kk'obena bẹ́, “Abạnga akpa nnam k'iwu ittaan.” <verse eid="1KI 12:12" /><verse number="13" style="v" sid="1KI 12:13" />Ọvaarnạng ubhin anạng mbọ udik ngwọ ẹkkam-ẹkkam. Ufhum ntọhna s'adennạng anạng-ẹ, <verse eid="1KI 12:13" /><verse number="14" style="v" sid="1KI 12:14" />ọtạkha ntọhna s'ibhagbọ, oben bẹ́, “Wa otte kwaam oge bạnga ọyaak kw'ọdọhbhọ-ọdọhbh, amma m'ntera nsi awẹ odo ọdọhbh-ọdọhbh. Wa otte kwaam utim achiva uvun bạnga, amma m'ntima afhonukpan mvun bạnga.” <verse eid="1KI 12:14" /><verse number="15" style="v" sid="1KI 12:15" />Ma o, ọvaarnạng anạng mbọ itọhng nọ́khọhma, ukwuru s'uwa idik nnọ ibin k'Ọvaar Ubinọkpaabyi, ọfha ọtọhnga kw'Ọvaar Ubinọkpaabyi ọkhaama ẹyaakha, kw'kk'Ahija kw'ubin Shilo, utima ọkpaak, ọnạng Jẹroboam kw'ode nnwa kw'Nẹbat.<verse eid="1KI 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1KI 12:16" />Masẹ anạng p'Israẹl phyibh ase bẹ́, ọvaarnạng ufhum-ufhum bẹ́ ọkhọmọ bẹ itọhng, abẹ n'abhin ọvaarnạng bẹ́:</para>
  <para style="q1" vid="1KI 12:16">“Bạng okhebh vọ f'amạna ankhaam k'Devid o,</para>
  <para style="q2" vid="1KI 12:16">mbạng vọ ọkpạkhẹ mạna k'nnwa kw'Jẹsẹ?</para>
  <para style="q1" vid="1KI 12:16">Anạng p'Israẹl o, akpa nnam kabạnga k'ichọhm!</para>
  <para style="q2" vid="1KI 12:16">Devid o, ọma oyeni kkeri ẹchọhmfhạr chọ e!”</para>
  <para style="m" vid="1KI 12:16">Mạnna wọ anạng p'Israẹl asengi abhạna k'abẹ k'ichọhm. <verse eid="1KI 12:16" /><verse number="17" style="v" sid="1KI 12:17" />Okhenka, Rẹhoboam ofon ororo ọdạbh anạng p'Israẹl p'uwa arukhu k'ifhon s'Juda.<verse eid="1KI 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1KI 12:18" />Wa ọvaar Rẹhoboam ọtọhmọ Adoniram, kw'ode okkeri-itọhm s'nạ́n akpokha ipe, okhenka, anạng p'Israẹl phyibh atọhbh-ẹ ata, ope. Ma wọ ọvaar Rẹhoboam ọrạbhọ ọta uvura k'ọkpaar kwẹ kw'nnyạnyaang n'itwạr ofona k'Jẹrusalẹm. <verse eid="1KI 12:18" /><verse number="19" style="v" sid="1KI 12:19" />Tạma ma, anạng p'Israẹl n'awun ẹvaar ch'Devid tạrr ukpira maa.<verse eid="1KI 12:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1KI 12:20" />K'okpe kw'anạng p'Israẹl phyibh abhaang bẹ́, Jẹroboam kk'ukwuna, abẹ atọhm anạng ayer-ẹ k'ininga, anạngẹ ẹvaar ch'ọdạbhẹ Israẹl <char style="it">bẹ́ wạmm</char>. Ẹkhạma ch'Juda mạnkkeni jọ wa itwung ẹcho ẹnạng ẹvaar ch'Devid.<verse eid="1KI 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1KI 12:21" />Masẹ Rẹhoboam ukpir k'Jẹrusalẹm, otobha adikkobh p'akpọhkhọ irima k'Juda ọttạra k'Bẹnjamin, anạng nnọhna ẹnọhna ukuma arạbh afa ukuma jobh, ọfha abẹ ata arima Israẹl abẹ, ọfha abẹ abạra akpa nnạm atạkha efhondiden anạng Rẹhoboam, kw'ode nnwa kw'Sọlọmọn.<verse eid="1KI 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 12:22" />Okhenka, Shẹmaya kw'ode usi-ẹyaakha kw'Ubinọkpaabyi, ọbhaang ọtọhnga kw'Ubinọkpaabyi bẹ́: <verse eid="1KI 12:22" /><verse number="23" style="v" sid="1KI 12:23" />“Kpaak Rẹhoboam kw'ode nnwa kw'Sọlọmọn, kw'ọbạra ode ọvaarnạng kw'Juda, ọttạra anạng p'Juda, ọttạra anạng p'Bẹnjamin phyi-phyibh bẹ́: <verse eid="1KI 12:23" /><verse number="24" style="v" sid="1KI 12:24" />‘Maa wọ ode udik kw'Ọvaar Ubinọkpaabyi ọkpaakhẹ bẹ: abạnga nạ́ngẹ avur ata arima anạng p'Israẹl p'ade ivotte pabạnga abẹ. Ọnạng-ọnạng osong ọbhạna, khiri udik ngwa ubin k'akhaam.’ ” Mạnna wọ abẹ abhaang ọtọhnga kw'Ọvaar Ubinọkpaabyi, akpa nnạm abhạna k'oche kw'Ọvaar Ubinọkpaabyi kk'bẹ ọtọhna.<verse eid="1KI 12:24" /></para>
  <para style="s1">Akpatava p'mmaam p'gol p'aning k'Bẹtẹl ọttạra k'Dan</para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 12:25" />Wa Jẹroboam usi Shẹkẹm k'okpecho kw'Ephraim, uruk ma. Ubina ma ọta usi Pẹniyẹl.<verse eid="1KI 12:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 12:26" />Jẹroboam ọkkẹ kha ettem chẹ bẹ́, “Efhondiden bạra ẹbhạkhẹ ẹkpa nnạm k'ẹchọhmfhạr ch'Devid ttạng e. <verse eid="1KI 12:26" /><verse number="27" style="v" sid="1KI 12:27" />De anạng mba afon k'Jẹrusalẹm bẹ, abẹ ata afọhnọ nja k'ọchọhm kw'Ọvaar Ubinọkpaabyi, abẹ m'abạra asạkha echo anạng aro kwabẹ, Rẹhoboam, kw'ode ọvaarnạng kw'Juda, Abẹ m'afhọ-m, abhạkhẹ akpa nnạm k'ọvaar Rẹhoboam.”<verse eid="1KI 12:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1KI 12:28" />Masẹ kk'ọbạbha, ọvaarnạng utima gol usi akpatava afa p'ẹbhaam. Oben anạng mbọ bẹ́, “Akwẹ ọmma-ọmma ọnạngẹ bạnga bẹ́, abạnga n'abina afona k'Jẹrusalẹm. Anạng p'Israẹl o, akkeri akha pabạnga mạma, p'atim bạnga abina k'Ijip e.” <verse eid="1KI 12:28" /><verse number="29" style="v" sid="1KI 12:29" />Ọtạkha ọkha vạnọ uttima k'Bẹtẹl, ọtạkha mvọkha uttima k'Dan. <verse eid="1KI 12:29" /><verse number="30" style="v" sid="1KI 12:30" />Udik ngwọ n'ukwu ode ipyibha; anạng n'akwu akpobha ọkha vạnọ k'Bẹtẹl, abạra akpa nnạm afona k'Dan ata akpobha ọkha mvọkha.<verse eid="1KI 12:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1KI 12:31" />Jẹroboam ummunu akhapa k'ikpukpobha-byi k'ọyaankpa, otekha anạng k'ibyi-k'ibyi usi bẹ afọhnẹja, ọbạra abẹ k'ẹnạmma ch'Lẹvi nábina. <verse eid="1KI 12:31" /><verse number="32" style="v" sid="1KI 12:32" />Jẹroboam orengi ophye kw'ọttong esenọttaan, ochok masẹ erobhawu, masẹ erobha-khira njọ ch'abẹ n'asi k'Juda, n'ọfọhnọ nja k'ijabyi. Wa n'ọfọhnọ nja nnọ ọnạng akpatava p'kk'usia k'Bẹtẹl, ọbạra ochok afọhnẹja k'ikpukpobha-byi s'ọyaankpa s'kk'usia k'Bẹtẹl. <verse eid="1KI 12:32" /><verse number="33" style="v" sid="1KI 12:33" />K'iwu chi, k'ophye kw'ottong esenọttaan, kw'ode ophye kw'ẹma oyeni otek, ọfọhnọ nja k'ijabyi s'kk'usia k'Bẹtẹl. Ma wọ ochokhu erobhawu ọnạng anạng p'Israẹl, ọbạra uvura ofona k'ijabyi ọta ọnạng nnạnga.<verse eid="1KI 12:33" /></para>
  <chapter eid="1KI 12" />
  <chapter number="13" style="c" sid="1KI 13" />
  <para style="s1">Usi-ẹyaakha kw'Ubinọkpaabyi kw'ubin Juda</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 13:1" />Wa osengi k'ọtọhnga kw'Ọvaar Ubinọkpaabyi, usi-ẹyaakha wạnọ kw'Ubinọkpaabyi ubina kha Juda ofona k'Bẹtẹl, k'okpe kw'Jẹroboam n'obe k'ijabyi bẹ́, ọnạng ẹnạnga. <verse eid="1KI 13:1" /><verse number="2" style="v" sid="1KI 13:2" />Osengi k'ọtọhnga kw'Ọvaar Ubinọkpaabyi ọkpaak, ọttạbhẹ ijabyi nnọ oben bẹ́: “Ijabyi, ijabyi o! Ọvaar Ubinọkpaabyi obeni bẹ́: ‘Abẹ m'amaan ujunungnwa kw'm'okpena Josiya k'ẹchọhmfhạr ch'Devid. Ẹma m'utima afọhnẹja p'ikpukpobha-byi s'ọyaankpa, p'n'afọhnọ nja mạma, ọfọhnọ nja. Ẹma m'ọbạra ọnnọhnga akhạbhọ p'ayokhanạng ma.’ ” <verse eid="1KI 13:2" /><verse number="3" style="v" sid="1KI 13:3" />Ma iwu njọ-njọ, usi-ẹyaakha kw'Ubinọkpaabyi ọnạngẹ ẹkhọhkha oben bẹ́: ‘Maa wọ ode ẹkhọhkha ch'Ọvaar Ubinọkpaabyi kk'ẹyaakha ọnạnga oben bẹ́: Ijabyi nna m'ibhaangẹ ibyi ifa, itạtọhng sẹ m'inyaanẹ k'isisek.”<verse eid="1KI 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1KI 13:4" />Masẹ ọvaar Jẹroboam ọbhaang itọhnga s'usi-ẹyaakha kw'Ubinọkpaabyi ọkpaakhẹ ọttạbhẹ ijabyi s'Bẹtẹl, uninga k'ijabyi, onemi ọbọhk kwẹ oben bẹ́, “Avạkh-ẹ!” Okhenka, ọbọkh kw'onemi otena usi-ẹyaakha upu-ẹ tạrr akwẹ dạk nókke ọsạkha. <verse eid="1KI 13:4" /><verse number="5" style="v" sid="1KI 13:5" />Ijabyi nnọ o, n'ibạra ikhebh ibyi ifa tạrr itạtọhng sẹ inyaanẹ k'isisek, otor kẹkhọhkha ch'usi-ẹyaakha kw'Ubinọkpaabyi osengi k'ọtọhnga kw'Ọvaar Ubinọkpaabyi, m'ọnạng.<verse eid="1KI 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 13:6" />Ma wọ ọvaarnạng obeni usi-ẹyaakha kw'Ubinọkpaabyi bẹ́, “Se njọhm k'akhaam k'echo nạng Ọvaar Ubinọkpaabyi, kw'ode Ubinọkpaabyi kwọ, ọfha ọbọhk kwaam ọkpa nnạm ode oche kw'wạra akwẹ ode.” Wa usi-ẹyaakha kw'Ubinọkpaabyi ose njọhm ọnạng Ọvaar Ubinọkpaabyi k'akhẹ k'echo. Ma wọ ọbọhk kw'ọvaarnạng ọkpa nnạm ode oche kw'wạra akwẹ ode.<verse eid="1KI 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 13:7" />Ọvaarnạng n'obeni usi-ẹyaakha kw'Ubinọkpaabyi bẹ́, “Kwu antwạn amfona kha ọchọhm anta anchi ọttọhk, ọfha mbạra nsi-ọ ẹtaam.”<verse eid="1KI 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 13:8" />Okhenka, usi-ẹyaakha kw'Ubinọkpaabyi ubhina ọvaarnạng bẹ́, “Amma abọ mạ́ntwạn, brẹd ma mạ́nchi, asi ma mạ́mbạra ngwo, ọbạra ode bẹ́, m'anạng-m ibhaakha s'ẹkhaama chọ. <verse eid="1KI 13:8" /><verse number="9" style="v" sid="1KI 13:9" />S'Ọvaar Ubinọkpaabyi osengi k'ọtọhnga kwẹ ọnạng-m inyina bẹ́, ‘Ọma nọ́baana bẹ́ achi brẹd, nọ́baana bẹ́ agwo asi ma, k'eden ch'asenga afona, kábạra asenga akwuna.’ ” <verse eid="1KI 13:9" /><verse number="10" style="v" sid="1KI 13:10" />Ma wọ n'osengi k'eden ẹdwạkh-ọdwạk ukwuna, ọyaanga njọ ch'wạra osengi ofona k'Bẹtẹl ọjẹ.<verse eid="1KI 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 13:11" />Wa ọkhaam usi-ẹyaakha wạnọ kw'kk'ọtạma kw'urukhu k'Bẹtẹl, kw'iva pẹ ata akpaak udik kwidede kw'usi-ẹyaakha kw'Ubinọkpaabyi kk'usia ma iwu njọ. Abẹ abạra akpaak otte idik s'usi-ẹyaakha kw'Ubinọkpaabyi kk'ọvaarnạng ọbạra ọkpaakha. <verse eid="1KI 13:11" /><verse number="12" style="v" sid="1KI 13:12" />Otte n'ọbạbhọ bẹ bẹ́, “Ẹma ukwu njạn?” Iva atibh-ẹ eden ch'usi-ẹyaakha kw'Ubinọkpaabyi, kw'ubin Juda, kk'osenga ofona. <verse eid="1KI 13:12" /><verse number="13" style="v" sid="1KI 13:13" />Nobeni iva bẹ́, “Abạnga ado ẹnyạnyaang ininga anạng-m.” Masẹ abẹ kk'ẹnyạnyaang ininga adia anạng-ẹ, uvura chẹ, <verse eid="1KI 13:13" /><verse number="14" style="v" sid="1KI 13:14" />ọyaar ukhubh usi-ẹyaakha kw'Ubinọkpaayi k'nnạm. Ọta okhebh-ẹ s'uning ẹyạr k'ichi-rin ch'oak, ọbạbh bẹ́, “Ọma wọ ade usi-ẹyaakha nwọma kw'ubin Juda o?”</para>
  <para style="p" vid="1KI 13:14">Ubhina bẹ́, “Uwe e, amma wọ e.”<verse eid="1KI 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 13:15" />Ma wọ usi-ẹyaakha nwọ oben-ẹ bẹ́, “Kwu antwạn amfona kha ọchọhm anta anchi ọttọhk.”<verse eid="1KI 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1KI 13:16" />Usi-ẹyaakha kw'Ubinọkpaabyi oben bẹ́, “Amma abọ mạ́ntwạn mkpa nnạm, brẹd ọma abẹ mạ́nchi, asi abọ mạ́mbạra ngwo maa ibyi nna. <verse eid="1KI 13:16" /><verse number="17" style="v" sid="1KI 13:17" />Ọvaar Ubinọkpaabyi kk'osenga k'ọtọhnga kwẹ ọkpaakh-m bẹ́, ‘Ọma nọ́baana bẹ́ achi brẹd, nọ́baana bẹ́ agwo asi ma, k'eden ch'wạra asengi afona, kábạra aseng akwuna.’ ”<verse eid="1KI 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1KI 13:18" />Usi-ẹyaakha kw'kk'ọtạma ubhina bẹ́, “Amma mgba nde usi-ẹyaakha masẹ akhọ. Oseng-eden kw'Ubinọkpaabyi osengi k'ọtọhnga kw'Ọvaar Ubinọkpaabyi oben-m bẹ́: ‘Sọhng ata atim-ẹ akpa nnạm k'akhọ k'ọchọhm, ọfha ukwu uchi brẹd, ọbạra ogwo asi.’ ” (Okhenka, wa n'usi afhạra). <verse eid="1KI 13:18" /><verse number="19" style="v" sid="1KI 13:19" />Mạnna wọ kw'usi-ẹyaakha kw'Ubinọkpaabyi ọtwạnọ abẹ ọkpa nnạm, ọta uchi brẹd ọbạra ogwo asi k'akhẹ k'ọchọhm.<verse eid="1KI 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1KI 13:20" />Masẹ abẹ atim aning ma okpokkro, Ọvaar Ubinọkpaabyi ọkpaak udik ọnạng usi-ẹyaakha kw'kk'ọtạma, kw'utim-ẹ ọkpa nnạm. <verse eid="1KI 13:20" /><verse number="21" style="v" sid="1KI 13:21" />Ọkpaakhẹ ọttạbhẹ usi-ẹyaakha kw'Ubinọkpaabyi, kw'kk'ubina kha Juda ukwu, oben bẹ́, “Ọvaar Ubinọkpaabyi obeni bẹ́, ‘Ọma asẹkhẹ ọtọhnga kw'Ọvaar Ubinọkpaabyi, inyina ch'Ọvaar Ubinọkpaabyi, kw'ode Ubinọkpaabyi kwọ ọnạng-ọ, náchokha. <verse eid="1KI 13:21" /><verse number="22" style="v" sid="1KI 13:22" />Ọma akpa nnạm akwu achi brẹd, abạra agwo asi k'ibyi s'mben-ọ bẹ́, nạngẹ ọttọhk achi, nạngẹ asi agwo. Ma o, apfura pọ k'epekwur ch'ab'atte mánnọhnga.’ ”<verse eid="1KI 13:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 13:23" />K'ókpe kw'usi-ẹyaakha kw'Ubinọkpaabyi kk'ọttọhk okkera uchi, ọbạra okkera asi ogwo, usi-ẹyaakha nwọ kw'utim-ẹ ọkpa nnạm ukwu odo ẹnyạnyaang chẹ ininga, ọnạng-ẹ. <verse eid="1KI 13:23" /><verse number="24" style="v" sid="1KI 13:24" />Masẹ n'osenga k'eden, ekke ẹkhebh-ẹ k'eden ẹfhọ. Apfura pẹ ayima ma k'eden ọttạra ẹnyạnyaang, ọttạra ekke p'abe abaanga abe ma. <verse eid="1KI 13:24" /><verse number="25" style="v" sid="1KI 13:25" />Anạng bạnọ p'asengi ase upfura kw'uyim ma, ọttạra ekke ch'ebe ẹbaanga abẹ, afona ata akpaak anạng kha ẹfhondiden ch'usi-ẹyaakha kw'kk'ọtạma urukhu.<verse eid="1KI 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 13:26" />Okpe kw'usi-ẹyaakha nwọ kw'wạra utim-ẹ k'eden ọkpa nnạm ọbhaang kwẹ, oben bẹ́, “Usi-ẹyaakha kw'Ubinọkpaabyi, kw'ọsẹkhẹ ọtọhnga kw'Ọvaar Ubinọkpaabyi wọ. Ọvaar Ubinọkpaabyi kk'ẹ ọbọhk uttia ọnạng ekke, ch'kk'ẹ ivuna ẹfhọ, k'oche kw'ọtọhnga kw'Ọvaar Ubinọkpaabyi kk'ẹ ọkpaakha.<verse eid="1KI 13:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1KI 13:27" />Usi-ẹyaakha kw'kk'ọtạma oben iva pẹ bẹ́, “Ado ẹnyạnyaang ininga anạng-m,” Abẹ asi oche ngwọ. <verse eid="1KI 13:27" /><verse number="28" style="v" sid="1KI 13:28" />Ma wọ kw'uyini k'iyaan, ọta osẹ upfura kw'uyim kha eden, ọttạra ẹnyạnyaang, ọttạra ekke p'abe abaanga abẹ. Ekke upfura níchia, ẹnyạnyaang nẹ́bạra ivuna. <verse eid="1KI 13:28" /><verse number="29" style="v" sid="1KI 13:29" />Ma o, usi-ẹyaakha kw'kk'ọtạma udira apfura p'usi-ẹyaakha kw'Ubinọkpaabyi, ọnạna k'ẹnyạnyaang, utima wẹ ukwuna k'ẹfhondiden chẹ, ọfha ọgạm-ẹ, ọbạra ọnnọhng-ẹ. <verse eid="1KI 13:29" /><verse number="30" style="v" sid="1KI 13:30" />Ọnnọhng upfura nwọ k'epekwur chẹ, abẹ agạm-ẹ aben bẹ́, “Nnwọkka kwaam e!”<verse eid="1KI 13:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1KI 13:31" />Masẹ kk'apfura mbọ ọnnọhnga, nobeni iva pẹ bẹ́, “De kwạna mpe, abạnga annọhng-m k'epekwur ch'nnọhng usi-ẹyaakha kw'Ubinọkpaabyi  o, abạnga aruru akhạbhọ paam abaanga akhạbhọ pẹ, <verse eid="1KI 13:31" /><verse number="32" style="v" sid="1KI 13:32" />khiri ẹkkaabha ch'oseng k'ọtọhnga kw'Ọvaar Ubinọkpaabyi ọkpaak, ọttạbhẹ ijabyi s'Bẹtẹl, ọttạra akhapa pidede p'ikpukpobha-byi s'ọyaankpa phyi-phyibh k'ifhon s'Samariya, kwạna m'iyin-uyin e.<verse eid="1KI 13:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1KI 13:33" />Tạrr oseng ma, Jẹroboam efhona nọ́khaama k'ibyibyiadik sẹ. Okhenka, ọbạra ọtekha adạkhẹ afọhn-nja p'ikpukpobha-byi s'ọyaankpa k'anạng-khira pidede. Ọnạng kwidede kw'ọdaakhẹ bẹ́ ode ọfọhnẹja, ọtekh-ẹ ochok k'ikpukpobha-byi s'ọyaankpa. <verse eid="1KI 13:33" /><verse number="34" style="v" sid="1KI 13:34" />Maa wọ ode ipyibha ch'ẹchọhmfhạr ch'Jẹroboam, ch'itim ttạtto kwẹ, ọttạra idima chẹ ikwu ma ọyagbin.<verse eid="1KI 13:34" /></para>
  <chapter eid="1KI 13" />
  <chapter number="14" style="c" sid="1KI 14" />
  <para style="s1">Ẹyaakha ch'Ahija usi otena Jẹroboam</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 14:1" />Ma okpe ngwọ, Ahija kw'ode ujunungnwa kw'Jẹroboam otto ọkhạmana. <verse eid="1KI 14:1" /><verse number="2" style="v" sid="1KI 14:2" />Jẹroboam ukwu oben ikwanạng kwẹ bẹ́, “Sọhng ata afhona ifor sọ , ọfha anạng nạng-ọ atini masẹ ikwanạng kw'amma Jẹroboam. De kk'asia oche ngwọ, asọhng afona kha Shilo, k'ibyi s'Ahija kw'ode usi-ẹyaakha uning, kw'uwa ọkpaakh-m bẹ́, amma m'ndạbh anạng mba. <verse eid="1KI 14:2" /><verse number="3" style="v" sid="1KI 14:3" />Tạkha abrẹd-dwuk jobh, ọttạra igbugbo, ọttạra k'igbạre s'ọkhọhn, atima ata asẹ-ẹ. Ẹma m'ọkpaakh-ọ udik ọkpaak kw'm'uyin udikkobh-nwa nwọ.” <verse eid="1KI 14:3" /><verse number="4" style="v" sid="1KI 14:4" />Wa ikwanạng kw'Jẹroboam usi oche kw'udim oben-ẹ, ukwu ofona k'ọchọhm kw'Ahija kha Shilo. Wa ma okpe ngwọ, Ahija dạkhẹ iyaan kidaam kạnóse, ukwuru s'kk'ọtạma. <verse eid="1KI 14:4" /><verse number="5" style="v" sid="1KI 14:5" />Okhenka, Ọvaar Ubinọkpaabyi kk'Ahija ọkpaakha bẹ́, “Ikwanạng kw'Jẹroboam ukwuma ukwu ọbạbh-ọ udik otena k'ọkhạmana f'nnwa kwẹ. Ọma kpaakh-ẹ udik kw'mkpaakh-ọ. De ukpir maa, m'usi nkkari bẹ́, ode ọnạng ọdwạkh-ọdwạk.”<verse eid="1KI 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 14:6" />Masẹ Ahija ọbhaang ntwạkhọ sẹ k'ọmmakhubh, oben bẹ́, “Ikwanạng kw'Jẹroboam kwu kha ẹtaanga, nkkari nnọ, sa mbạng nọ o? Abẹ anạng-m ẹkkaabha-tạma bẹ́ mkpaakh-ọ. <verse eid="1KI 14:6" /><verse number="7" style="v" sid="1KI 14:7" />Sọhng ata akpaak Jẹroboam bẹ́ maa wọ ode udik kw'Ọvaar Ubinọkpaabyi, kw'ode Ubinọkpaabyi kw'Israẹl ọkpaakhẹ: ‘Wa amma ntekh-ọ k'ikhaana s'anạng mbọ, nsi-ọ ọdạbhẹ kw'anạng paam Israẹl. <verse eid="1KI 14:7" /><verse number="8" style="v" sid="1KI 14:8" />Ntạk ofhon ngwọ k'ẹchọhmfhạr ch'Devid nnạng-ọ. Okhenka, ọma nádia masẹ ọtọhmnạng kwaam Devid, kw'ochokhu nnyina saam, ọbạra utima ettem phyibh ọtwạn abamẹ, usi idik s'itor-otor mạnkkeni k'ititikha saam. <verse eid="1KI 14:8" /><verse number="9" style="v" sid="1KI 14:9" />Ọma kk'ipyibha asia ch'ẹyọhng ch'anạng phyibh p'kk'ọ eden achia aruk. Ọma kk'akha asia anạng ọma oyeni; atima agbikhi idwạdwạkhọ saam, abạra akpa nnạm avạr-m.<verse eid="1KI 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 14:10" />“ ‘Ukwuru udik ngwa, amma m'ntte ipyibha ọbọhk ikhebha ẹchọhmfhạr ch'ọma Jẹroboam. Amma m'ndimi akpen p'akponga-nnạm-va p'ujunung kwidede kw'Jẹroboam k'Israẹl, ode ubira, ubira núdia. Amma m'nkkạmọ ẹchọhmfhạr ch'Jẹroboam phyibh masẹ ọnạng ọkkạmọ abhera, tạrr apyẹ ẹsa phyibh. <verse eid="1KI 14:10" /><verse number="11" style="v" sid="1KI 14:11" />Mpfa rọ m'ichi apfura p'anạng p'Jẹroboam, p'm'ape k'efhondiden, ọnọhn f'ẹrạng m'uchi apfura p'ayok p'm'ape ma ẹkhạma njọ. Ọvaar Ubinọkpaabyi kk'ọkpaakha!’<verse eid="1KI 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1KI 14:12" />“Ọma sọhng abhạna. De akpir k'ẹfhondiden <char style="it">bẹ́ gwọọ</char>, udikkobh-nwa nwọ m'opope. <verse eid="1KI 14:12" /><verse number="13" style="v" sid="1KI 14:13" />Anạng p'Israẹl phyibh m'agạm-ẹ, abạra annọhng-ẹ. Ẹma mạnkkeni wọ ode nnwa kw'Jẹroboam kw'm'ọkhaama epekwur, ukwuru bẹ́, ẹma mạnkkeni wọ ubin k'ẹchọhmfhạr ch'Jẹroboam kw'Ọvaar Ubinọkpaabyi, kw'ode Ubinọkpaabyi kw'Israẹl kk'udik kw'ujibh-ujibh usia.<verse eid="1KI 14:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1KI 14:14" />“Ọvaar Ubinọkpaabyi m'otekha ọnạng otekha ọnạng ẹma oyeni kw'm'ode ọvaarnạng kw'anạng p'Israẹl, kw'm'udimi ẹnạmma ch'Jẹroboam. Udik ngwa m'otto chemma, ọbạra mantọmma wọ. <verse eid="1KI 14:14" /><verse number="15" style="v" sid="1KI 14:15" />Ọvaar Ubinọkpaabyi m'ọnạng Israẹl irem, tạrr abẹ bạra akhera asạsaarẹ p'afhobhu k'asi ibir-ibir. Ẹma m'ukhubh Israẹl k'isek nnọ ikkasẹ s'uwa ọnạngẹ ab'otte pabẹ, m'ọbạra usi abẹ araama tạrr abẹ ayongu Ọraanga kw'Euphrates, ukwuru sabẹ agbikhi idwạdwạkhọ s'Ọvaar Ubinọkpaabyi, k'akpatava p'Ashẹra p'abẹ asi. <verse eid="1KI 14:15" /><verse number="16" style="v" sid="1KI 14:16" />Ẹma m'ọkpa nnạm ọvạra Israẹl ukwuru ipyibha ch'Jẹroboam kk'usia, s'utima anạng p'Israẹl asi ipyibha.”<verse eid="1KI 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1KI 14:17" />Wa ikwanạng kw'Jẹroboam ubin ofona, otena k'Tirza. Masẹ ọbyạrẹ ma ẹkpọmmachi ch'ọchọhm <char style="it">bẹ́ ẹ</char> , udikkobh-nwa nwọ ope. <verse eid="1KI 14:17" /><verse number="18" style="v" sid="1KI 14:18" />Abẹ annọhng-ẹ, anạng p'Israẹl phyibh agạm-ẹ, k'oche kw'Ọvaar Ubinọkpaabyi utim Ahija kw'ode usi-ẹyaakha kwẹ, ọkpaak.<verse eid="1KI 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 14:19" />Idik idwạkh-ọdwạk s'iten k'ẹvaar ch'Jẹroboam, ọttạra mkpong s'urim, ọttạra ukhira kw'ọdạbhẹ ẹvaar, abẹ akkerẹ sẹ k'nnwẹr s'idik s'ẹtạma s'avaar p'Israẹl. <verse eid="1KI 14:19" /><verse number="20" style="v" sid="1KI 14:20" />Wa Jẹroboam ọdạbhẹ ẹvaar k'icho ẹrạbh ukuma ifa, ope otor ab'otte. Nadab kw'ode nnwa kwẹ, n'ukwu ode ọvaarnạng.<verse eid="1KI 14:20" /></para>
  <para style="s1">Rẹhoboam kw'ode ọvaarnạng kw'Juda</para>
  <para style="p">
    <verse number="21" style="v" sid="1KI 14:21" />Wa Rẹhoboam kw'ode nnwa kw'Sọlọmọn ode ọvaarnạng k'Juda. Wa ode icho arạbh afa ukuma wạnọ k'okpe kw'ọdạbhẹ ẹvaar, ọdạbhẹ ẹvaar k'icho chi-khamfa k'Jẹrusalẹm, kw'ode ẹfhondiden ch'Ọvaar Ubinọkpaabyi kk'otekha, k'nkhạma s'Israẹl bẹ́, abẹ akpobha eche chẹ. Wa ọkka kwẹ okpen Naama, ubin Ammọn.<verse eid="1KI 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 14:22" />Wa anạng p'Juda asi ibyibyiadik k'ititikha s'Ọvaar Ubinọkpaabyi. Mpyibha sabẹ asi, igbikhi ottemma kw'Ubinọkpaabyi k'idwạdwạkhọ, iyọhnga s'uwa ab'otte kk'asia. <verse eid="1KI 14:22" /><verse number="23" style="v" sid="1KI 14:23" />Wa abẹ abạra asi akhapa k'ikpukpobha-byi k'ọyaankpa anạng abẹma oyeni, abẹ abạra asi mkpọmmachi s'awurada, ọttạra akpatava p'Ashẹra k'okpecho kwidede kw'ogor-ogoru, ọttạra k'ichirin chidede ch'irin-urina. <verse eid="1KI 14:23" /><verse number="24" style="v" sid="1KI 14:24" />Wa abẹ akhaam akhapa p'asasa p'ajunung ma isek nnọ; wa idik s'anạng mbọ n'asi ide idik s'ikpukhu anạng ukpukhu, s'idifhon s'uwa Ọvaar Ubinọkpaabyi kk'ukhubha k'ititikha s'anạng p'Israẹl, ọbhạrẹ.<verse eid="1KI 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 14:25" />K'cho kw'ottong isen kw'Rẹhoboam kk'ẹvaar ọdạbha, ẹwọ kw'Shishak kw'ode ọvaarnạng kw'Ijip urim Jẹrusalẹm abẹ. <verse eid="1KI 14:25" /><verse number="26" style="v" sid="1KI 14:26" />Utim ẹkkakpo py'ọchọhm kw'Ọvaar Ubinọkpaabyi, ọttạra ẹkkakpo py'ọvaarter ofona. Ọtạk ọttọhk f'idede tạrr ukpira k'akhọhnkpa p'gol phyi-phyibh p'uwa Sọlọmọn kk'usia. <verse eid="1KI 14:26" /><verse number="27" style="v" sid="1KI 14:27" />Ma wọ Ọvaar Rẹhoboam utim brons usi akhọhnkpa utima otera mbọkha. Ọtạkha pyẹ ọnạng adecho p'n'atik ibyi, p'aning k'ọtọhm k'ẹbaakhamma ch'ọvaarter. <verse eid="1KI 14:27" /><verse number="28" style="v" sid="1KI 14:28" />Okpe kwidede kw'ọvaarnạng ọta k'ọchọhm kw'Ọvaar Ubinọkpaabyi, atik-ibyi mbọ n'ata adira akhọhnkpa mbọ, de abẹ kk'asia, abẹ akpa nnạm ata achok kha ẹmaanggọ ch'ekpong-kpo.<verse eid="1KI 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 14:29" />Idik idwạkh-ọdwạk s'iten k'ẹvaar ch'Rẹhoboam, ọttạra idik sidede s'usi, abẹ akkerẹ sẹ k'nnwẹr s'idik s'ẹtama s'avaar p'Juda. <verse eid="1KI 14:29" /><verse number="30" style="v" sid="1KI 14:30" />Wa Rẹhoboam ọttạra Jẹroboam n'afona ororo arima ayok abẹ. <verse eid="1KI 14:30" /><verse number="31" style="v" sid="1KI 14:31" />Rẹhoboam o, ope otor ab'otte, abẹ annọhng-ẹ k'ẹfhondiden ch'Devid. Wa ọkka kwẹ okpen Naama, kw'ubin Ammọn. Abija kw'ode nnwa kwẹ n'ukwu ode ọvaarnạng.<verse eid="1KI 14:31" /></para>
  <chapter eid="1KI 14" />
  <chapter number="15" style="c" sid="1KI 15" />
  <para style="s1">Abija ode ọvaarnạng kw'Juda</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 15:1" />Wa Abija ọtạm ẹvaar dạdạbh k'Juda, k'cho kw'ottong chi-khanttaan kw'u Jẹroboam kw'ode nnwa kw'Nẹbat kk'ẹvaar ọdạbha k'Israẹl. <verse eid="1KI 15:1" /><verse number="2" style="v" sid="1KI 15:2" />Wa Abija ọdạbhẹ ẹvaar k'Jẹrusalẹm k'ícho ittaan. Ọkka kwẹ okpen Maaka, kw'ode ọkwanạng-nwa kw'Abishalọm.<verse eid="1KI 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1KI 15:3" />Ẹma wa usi mpyibha sidede s'ab'otte kk'asia. Wa ettem phyibh nútima ọtwạn Ọvaar Ubinọkpaabyi, kw'ode Ubinọkpaabyi kwẹ abẹ, oche kw'uwa Devid kw'ode otte kwideden kk'usia. <verse eid="1KI 15:3" /><verse number="4" style="v" sid="1KI 15:4" />Okhenka, ukwuru Devid, Ọvaar Ubinọkpaabyi kw'ode Ubinọkpaabyi, ọnạng-ẹ ọyaanttaana k'Jẹrusalẹm, s'oseng k'nnwa kwẹ otera echo chẹ, ọbạra usi Jẹrusalẹm ọkpọhkhọ. <verse eid="1KI 15:4" /><verse number="5" style="v" sid="1KI 15:5" />Wa Devid kk'idik s'itor-otor usia k'ititikha s'Ọvaar Ubinọkpaabyi ọttạra bẹ́, ipina kọ́khaam k'nnyina s'Ọvaar Ubinọkpaabyi k'akpen pẹ phyibh, oyonga udik kw'Uriya kw'ubin Het.<verse eid="1KI 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 15:6" />Wa k'akpen p'Abija phyi-phyibh, Abija ọttạra Rẹhoboam n'arima mkpong ayok abẹ. <verse eid="1KI 15:6" /><verse number="7" style="v" sid="1KI 15:7" />Idik idwạkh-ọdwạk s'iten k'ẹvaar ch'Abija, ọttạra idik phyibh s'usi, abẹ akkerẹ sẹ k'nnwẹr s'idik s'ẹtạma s'avaar p'Juda. Wa Abija ọttạra Jẹroboam n'arima mkpong. <verse eid="1KI 15:7" /><verse number="8" style="v" sid="1KI 15:8" />Abija ope otor ab'otte, abẹ annọhng-ẹ k'ẹfhondiden ch'Devid. Asa kw'ode nnwa kwẹ, n'ukwu ode ọvaarnạng.<verse eid="1KI 15:8" /></para>
  <para style="s1">Asa ode ọvaarnạng kw'Juda</para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 15:9" />Wa Asa ọtạm ẹvaar dạdạbh k'Juda k'cho kw'ottong ẹrạbh kw'Jẹroboam kk'ẹvaar ọdabha k'Israẹl. <verse eid="1KI 15:9" /><verse number="10" style="v" sid="1KI 15:10" />Wa Asa ọdạbhẹ ẹvaar k'Jẹrusalẹm k'icho arạbh afa ukuma wạnọ. Wa ọkka kwideden okpen Maaka, kw'ode nnwa kw'Abishalọm.<verse eid="1KI 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 15:11" />Wa Asa usi idik s'itor-otor k'ititikha s'Ọvaar Ubinọkpaabyi, oche kw'uwa otte Devid kk'usia. <verse eid="1KI 15:11" /><verse number="12" style="v" sid="1KI 15:12" />Wa ukhubhu asasa-junung k'akhapa p'isek nnọ, ọbạra ukhibhi akpatava p'uwa ab'otte kk'asia. <verse eid="1KI 15:12" /><verse number="13" style="v" sid="1KI 15:13" />Wa ọgba ọsạkha Maaka kw'ode ọkka kwideden ininga, masẹ ọkka kw'ọvaarnạng, ukwuru akpatava p'Ashẹra p'usi, p'ikpukhu anạng bẹ́ abẹ akpobha. Wa Asa ọkkọhbhọ Ashẹra nwọ ọjẹ, ukwu ọkkạmọ wẹ k'ipekhuma s'kidron. <verse eid="1KI 15:13" /><verse number="14" style="v" sid="1KI 15:14" />Okhenka, wa Asa ikpukpobha-byi s'ọyaankpa núkhibha, utim ettem k'ubungu ọtwạn Ọvaar Ubinọkpaabyi abẹ, k'akpen pẹ phyibh. <verse eid="1KI 15:14" /><verse number="15" style="v" sid="1KI 15:15" />Ọtọhk asilva ọttạra gol ukwu ọttạra k'nnạnga idwạkh-ọdwạk s'ẹma ọttạra otte kk'ọbọhhk attia anạng Ubinọkpaabyi, ochok k'ọchọhm kw'Ọvar Ubinọkpaabyi.<verse eid="1KI 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1KI 15:16" />Wa Asa ọttạra Baasha kw'ode ọvaarnạng k'Israẹl, arim ekpong k'okpe phyi-phyibh kw'abẹ adạbhẹ ẹvaar. <verse eid="1KI 15:16" /><verse number="17" style="v" sid="1KI 15:17" />Baasha kw'ode ọvaarnạng kw'Israẹl ofon ọta urima Juda abẹ, ọbạra ọkpa k'Rama, ọfha anạng nạngẹ k'iyaan ayini, abẹ nạngẹ k'ẹtaanga abạra anwa, k'ẹkhạma ch'Juda kw'Asa ode ọvaarnạng.<verse eid="1KI 15:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1KI 15:18" />Ma o Asa n'ọtạk silva ọttạra gol p'arikhi k'ikwurukpa ch'ọchọhm kw'Ọvaar Ubinọkpaabyi, ọttạra k'ikwurukpa ch'ọvaarchọhm kwẹ, ọnạng atọhmnạng pẹ bẹ́, abẹ akkena Bẹn-Hadad kw'ode nnwa kw'Tabrimọn. Wa Tabrimọn ode nnwa kw'Hẹziyọn, kw'ode ọvaarnạng kw'Aram, kw'uwa ọdạbhẹ Damaskọs. <verse eid="1KI 15:18" /><verse number="19" style="v" sid="1KI 15:19" />Oben bẹ́, “Tte antạkha echekha annạng ayok oche kw'uwa ab'otte pamạna atạk. Kkeri, amma n'ntọhm ẹnạnga ch'silva ọttạra gol nken-ọ e. M'avọhkhọ echekha ch'atạk ọttạra Baasha kw'ode ọvaarnạng kw'Israẹl, ọfha otte ẹkhạma chaam ọbọhk.”<verse eid="1KI 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1KI 15:20" />Bẹn-Hadad ochera ọnạng ọvaar Asa, ukwu ọtọhm atimeden p'akpongnạng pẹ, abẹ ata arima ifhon s'Israẹl abẹ. Ma wọ okhem ifhon s'Ijọn ọttạra s'Dan ọttạra s'Abẹl-Bẹt-Maaka, ọttạra s'Kinẹrẹt phyi-phyibh, ọttạra ẹkhạma ch'Naphtali kubungu. <verse eid="1KI 15:20" /><verse number="21" style="v" sid="1KI 15:21" />Masẹ Baasha ọbhaang udik ngwọ, ukuma ọtọhm f'ofhon kw'Rama sisi, ọtwạr ọkpa nnạm k'Tirza. <verse eid="1KI 15:21" /><verse number="22" style="v" sid="1KI 15:22" />Ma wọ ọvaar Asa ọnạngẹ anạng p'Juda phyi-hyibh ẹfa, ọnạng núrikha, bẹ́ abẹ ata adira ata ọttạra mkpaakha s'iwa Baasha utim usi ọtọhm k'Rama. Ọvaar Asa utima pyẹ usi Gẹba k'Bẹnjamin, ọbạra utima usi Mizpa.<verse eid="1KI 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 15:23" />Idik idwạkh-ọdwạk s'iten k'ẹvaar ch'Asa, ọttạra idik phyi-phyibh s'ọkhaam, ọttạra idik phyi-phyibh s'usi, akwu attạra k'ifhondiden s'usi, abẹ akkerẹ sẹ k'nnwẹr s'idik s'ẹtạma s'avaar p'Juda. Ayongu ma, wa n'ọkhaam ọkhạmana k'mfhok-kpatwạkhọ sẹ. <verse eid="1KI 15:23" /><verse number="24" style="v" sid="1KI 15:24" />Wa Asa ope otor ab'otte, abẹ annọhng-ẹ k'efhondiden ch'otte Devid, k'ibyi sabẹ annọhng ab'otte. Wa Jẹhoshaphat kw'ode nnwa kwẹ n'ukwu ode ọvaarnạng.<verse eid="1KI 15:24" /></para>
  <para style="s1">Nadab ode ọvaarnạng kw'Israẹl</para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 15:25" />Wa Nadab kw'ode nnwa kw'Jẹroboam, ukwu ode ọvaarnạng kw'Israẹl, k'cho kw'ottong afa kw'Asa kk'Juda ọdạbha. Ọdạbhẹ Israẹl k'icho ifa. <verse eid="1KI 15:25" /><verse number="26" style="v" sid="1KI 15:26" />Otoru ntwạkhọ s'otte, usi ipyibha k'ititikha s'Ọvaar Ubinọkpaabyi. Usi ipyibha-khira njọ ch'otte utim anạng p'Israẹl eden, abẹ asi.<verse eid="1KI 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1KI 15:27" />Wa Baasha kw'ode nnwa kw'Ahija kw'ubin k'ẹkhạma ch'Isaka, ọkhaam nttọhna-pyibha otena abẹ. Mạnna wọ ọfhẹ-ẹ kha Gibeton, kw'ode ofhon gwạnọ k'ẹkhạma ch'aPhilistiya, kˈokpe kw'Nadab ọttạra anạng p'Israẹl phyibh abaabhẹ Gibeton age ngekha. <verse eid="1KI 15:27" /><verse number="28" style="v" sid="1KI 15:28" />Wa Baasha ọfhọ Nadab, k'icho kw'ottong ittaan kw'ọvaar Asa kk'Juda ọdạbha. Mạnna wọ Baasha oter echo ch'Nadab masẹ ọvaarnạng k'Israẹl.<verse eid="1KI 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 15:29" />Oche ngwọ kw'ọtạm ẹvaar dạdạbh <char style="it">bẹ́ ẹ</char>, ọfhọ ẹnạmma ch'Jẹroboam phyi-phyibh. Ọnạng wạnọ-wạnọ k'ẹnạmma ch'Jẹroboam ọbọhk núttia uruk akpen, ọfhọ bẹ phyibh, otor k'ọtọhnga kw'uwa kw'Ọvaar Ubinọkpaabyi kk'osenga k'ọtọhmnạng kwẹ Ahija kw'ubin Shilo, ọnạng ẹyaakha. <verse eid="1KI 15:29" /><verse number="30" style="v" sid="1KI 15:30" />Wa akwẹ ode oche ngwọ ukwuru mpyibha s'Jẹroboam kk'usia, ọttạra s'utim anạng p'Israẹl eden abẹ asi, akwu attạra k'oche kw'ugbikhi idwạdwạkhọ s'Ọvaar Ubinọkpaabyi, kw'ode Ubinọkpaabyi kw'Israẹl.<verse eid="1KI 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1KI 15:31" />Idik idwạkh-ọdwạk s'iten k'ẹvaar ch'Nadab, ọttạra idik phyibh s'usi, abẹ akkẹrẹ sẹ k'nnwẹr s'idik s'ẹtạma s'avaar p'Israẹl. <verse eid="1KI 15:31" /><verse number="32" style="v" sid="1KI 15:32" />Wa Asa ọttạra Baasha kw'ode ọvaarnạng kw'Israẹl, n'arima ekpong k'okpe phyibh kw'abẹ adạbhẹ ẹvaar.<verse eid="1KI 15:32" /></para>
  <para style="s1">Baasha ode ọvaarnạng kw'Israẹl</para>
  <para style="p">
    <verse number="33" style="v" sid="1KI 15:33" />Wa Baasha kw'ode nnwa kw'Ahija, ọtạm ẹvaar k'Israẹl phyibh dạdạbh k'cho kw'ottong ittaan kw'Asa kk'ẹvaar ọdạbha k'Juda.Wa Baasha ọdạbhẹ ẹvaar k'Tirza icho ẹrạbh ukuma innebung. <verse eid="1KI 15:33" /><verse number="34" style="v" sid="1KI 15:34" />Otoru ntwạkhọ s'otte, usi ibyibyia-dik k'ititikha s'Ọvaar Ubinọkpaabyi. Usi ipyibha-khira njọ ch'Jẹroboam utim anạng p'Israẹl eden abẹ asi.<verse eid="1KI 15:34" /></para>
  <chapter eid="1KI 15" />
  <chapter number="16" style="c" sid="1KI 16" />
  <para style="p">
    <verse number="1" style="v" sid="1KI 16:1" />Wa Ọvaar Ubinọkpaabyi ọkpaakhẹ Jẹhu kw'ode nnwa kw'Hanani udik otena Baasha, oben bẹ́: <verse eid="1KI 16:1" /><verse number="2" style="v" sid="1KI 16:2" />“Amma ndir-ọ k'idọhngọ, mbạra ntekh-ọ masẹ ọdạbhẹ kw'anạng paam Israẹl. Okhenka, ọma atoru ntwạkhọ s'Jẹroboam, asi anạng p'Israẹl asi ipyibha, abẹ abạra atima mpyibha sabẹ agbikhi idwạdwạkhọ saam. <verse eid="1KI 16:2" /><verse number="3" style="v" sid="1KI 16:3" />Ma o, amma nabạra ndimi Baasha ọttạra ẹchọhmfhạr chẹ, amma m'nsi ẹchọhmfhạr chọ ede masẹ njọ ch'Jẹroboam, kw'ode nnwa kw'Nẹbat. <verse eid="1KI 16:3" /><verse number="4" style="v" sid="1KI 16:4" />Mpfa rọ m'ichi apfura p'anạng p'Baasha, p'ape k'efhondiden. Ọnọhn f'ẹrạng m'uchi apfura p'ayọk p'ape k'ẹkhạma njọ.”<verse eid="1KI 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 16:5" />Idik idwạkh-ọdwạk s'iten k'ẹvaar ch'Baasha, ọttạra idik s'usi, akwu attạra k'idik s'ọkhaam, abẹ akkẹrẹ sẹ k'nnwẹr s'idik s'ẹtạma s'avaar p'Isaẹl. <verse eid="1KI 16:5" /><verse number="6" style="v" sid="1KI 16:6" />Wa Baasha ope otor ab'otte. Abẹ annọhng-ẹ kha Tirza. Ẹla kw'ode nnwa kwẹ n'ukwu ode ọvaarnạng.<verse eid="1KI 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 16:7" />Ayongu ma, Ọvaar Ubinọkpaabyi ọkpaakhẹ Jẹhu kw'ode usi-ẹyaakha, kw'ọbạra ode nnwa kw'Hanani udik otena Baasha ọttạra ẹchọhmfhạr chẹ, ukwuru ibyibyia-dik phyi-phyibh s'kk'usia k'ititikha s'Ọvaar Ubinọkpaabyi. Osengi ma idik nnọ s'usi, ugbikhi idwạdwạkhọ s'Ọvaar Ubinọkpaabyi, n'okher ẹchọhmfhạr ch'Jẹroboam ch'udimi phyibh.<verse eid="1KI 16:7" /></para>
  <para style="s1">Ẹla kw'ode ọvaarnạng kw'Israẹl</para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 16:8" />Wa Ẹla kw'ode nnwa kw'Baasha ọtạm ẹvaar dạdạbh k'Israẹl k'chọ kw'ottong ẹrạbh ukuma icho isajạnẹ kw'Asa kk'Juda ọdạbha. Wa Ẹla ọdạbhẹ Tirza icho ifa.<verse eid="1KI 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 16:9" />Wa Zimri kw'ode ọtọhmnạng wạnọ kwẹ, ọbạra ode odecho kw'ibhaakha rạnẹ k'ijaar sẹ s'nnyạnyaang nitwạr, ọkhạmọ ipyibha otena abẹ. Ma okpe ngwọ, wa Ẹla uning kha Tirza s'kk'ugwua ubuma k'ọchọhm kw'Arza, kw'ode okker-ọtọhm kw'ọvaarter kha Tirza. <verse eid="1KI 16:9" /><verse number="10" style="v" sid="1KI 16:10" />Ma wọ Zimri ọnnwa ma, ọta uvun-ẹ ọfhọ, k'cho kw'ottong icho ẹrạbh ukuma esenọfa kw'Asa kk'Juda ọdạbha. Wa Zimri ọtạk ẹvaar ch'Ẹla.<verse eid="1KI 16:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 16:11" />Zimri ọdạbhẹ ẹvaar, ma ọta uninga ẹyạr k'ẹvaarchi <char style="it">bẹ ẹ</char>, onemi eden ọfhọ ẹnạmma ch'Baasha <char style="it">bẹ́ phyibh</char>. Ujunung wạnọ-wạnọ ọbọhk núttia, ode ọnạng kw'Baasha o, ọbạra ode oyokh-udikkobh kwẹ o, ọfhọ-ọfhọ ubina. <verse eid="1KI 16:11" /><verse number="12" style="v" sid="1KI 16:12" />Mạnna wọ kw'Zimri oseng udimi ẹnạmma ch'Baasha phyi-phyibh, otor k'udik kw'Ọvaar Ubinọkpaabyi oseng k'Jẹhu, kw'ode usi-ẹyaakha ọkpaakhẹ ọnạng Baasha. <verse eid="1KI 16:12" /><verse number="13" style="v" sid="1KI 16:13" />Wa akwẹ ode oche ngwọ ukwuru mpyibha s'Baasha ọttạra nnwa kwẹ Ẹla kk'asia, ọttạra mpyibha sabẹ atim anạng p'Israẹl eden abẹ asi, k'kpatava p'abẹ agwa, atima agbikhi idwạkdwạkhọ s'Ọvaar Ubinọkpaabyi, kw'ode Ubinọkpaabyi kw'Israẹl.<verse eid="1KI 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1KI 16:14" />Idik idwạkh-ọdwạk s'ẹvaar ch'Ẹla, ọttạra usisi kwẹ phyibh, abẹ akkẹrẹ sẹ k'nnwẹr s'idik s'ẹtạma s'avaar p'Israẹl.<verse eid="1KI 16:14" /></para>
  <para style="s1">Zimri kw'ode ọvaarnạng kw'Israẹl</para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 16:15" />Wa Zimri ọtạm Israẹl dạdạbh k'cho kw'ottong ẹrạbh ukuma isenọfa p'Asa kk'ọvaarnạng udia k'Juda. Okhenka, wa Zimri ọdạbhẹ Tirza iwu isenọfa mạnkkeni. Wa akpongnạng abhingi abaanga Gibeton, kw'ode ofhon gwạnọ k'ẹkhạma ch'aPhilistiya. <verse eid="1KI 16:15" /><verse number="16" style="v" sid="1KI 16:16" />Masẹ anạng p'Israẹl aning kha ibyibhingasẹ abhaanga bẹ́, Zimri kk'nttọhna usia ọfhọ ọvaarnạng, abẹ n'anạngẹ ẹyaakha k'ibyibhingasẹ bẹ́, Ọmri kw'ode odecho kw'akpongnạng wọ node ọvaarnạng kw'Israẹl k'iwu ch'chemma. <verse eid="1KI 16:16" /><verse number="17" style="v" sid="1KI 16:17" />Ma wọ Omri ọtwạrọ anạng p'Israẹl phyibh ọkpa nnạm k'Gibeton, ọta ọbaabha Tirza kw'ode efhondiden ch'Israẹl oge ngekha. <verse eid="1KI 16:17" /><verse number="18" style="v" sid="1KI 16:18" />Masẹ Zimri ose bẹ́ abẹ kk'ẹfhondiden achia, ubina ọta ọnwa k'ibyittubhasẹ s'ọvaarchọhm, oge ekpon ọbaabha ọvaarchọhm okpora ẹma oyeni kha ẹtaanga. Okhebha ma ope, <verse eid="1KI 16:18" /><verse number="19" style="v" sid="1KI 16:19" />ukwuru s'kk'ibyibyia-dik ọbạra usia k'ititikha s'Ọvaar Ubinọkpaabyi, otor ntwạkhọ s'Jẹroboam, usi mpyibha-khira nnọ s'Jẹroboam utim anạng p'Israẹl eden abẹ asi.<verse eid="1KI 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1KI 16:20" />Idik idwạkh-ọdwạk s'ẹvaar ch'Zimri, ọttạra ọgbaan f'uwa usi, abẹ akkẹrẹ sẹ k'nnwẹr s'idik s'ẹtạma s'avaar p'Israẹl.<verse eid="1KI 16:20" /></para>
  <para style="s1">Omri kw'ode ọvaarnạng kw'Israẹl</para>
  <para style="p">
    <verse number="21" style="v" sid="1KI 16:21" />Wa anạng p'Israẹl abhaangẹ k'ikhaana ifa. Ikhaana rạnẹ ibe ituma Tibni kw'ode nnwa kw'Ginat bẹ́, ode bẹ ọvaarnạng. Ikhaana nnọkha ibe ituma Omri. <verse eid="1KI 16:21" /><verse number="22" style="v" sid="1KI 16:22" />Okhenka, wa ikhaana s'Omri ikhaam ẹfa iyọhnga s'Tibni kw'ode nnwa kw'Ginat. Wa abẹ afhọ Tibni, Omri n'ukwu ode ọvaarnạng.<verse eid="1KI 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 16:23" />Wa Omri ode ọvaarnạng kw'Israẹl k'icho kw'ottong ẹrạbh ukuma jobh-kawạnọ, kw'Asa kk'Juda ọdạbha. Wa Omri ọdạbhẹ ẹvaar k'icho jobh-kamfa, attạra k'icho isajạnẹ s'ọdạbhẹ Tirza. <verse eid="1KI 16:23" /><verse number="24" style="v" sid="1KI 16:24" />Wa utim atalẹn afa p'silva odebh okpecho kw'Samariya k'mbọhk s'Shemer. Usi efhondiden ma okpecho nwọ, oyeri kwẹ Samariya, kw'ode eche ch'Shemer, kw'uwa ọkhaam okpecho nwọ.<verse eid="1KI 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 16:25" />Okhenka, wa Omri usi ipyibha k'ititikha s'Ọvaar Ubinọkpaabyi, ch'ẹyọhng ipyibha ch'anạng phyibh p'achiẹ-ẹ eden adạbh. <verse eid="1KI 16:25" /><verse number="26" style="v" sid="1KI 16:26" />Otoru nden phyibh s'Jẹroboam kw'ode nnwa kw'Nẹbat, usi ipyibha-khira njọ ch'Jẹroboam utim anạng p'Israẹl eden abẹ asi. Anạng mbọ aseng akpatava p'nạn k'eden náyina agbikhi idwạdwạkhọ s'Ọvaar Ubinọkpaabyi, kw'ode Ubinọkpaabyi kw'Israẹl.<verse eid="1KI 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1KI 16:27" />Idik idwạkh-ọdwạk s'ẹvaar ch'Omri, ọttạra idik s'usi, ọttạra idik s'ọkhaam, abẹ akkẹrẹ sẹ k'nnwẹr s'idik s'ẹtạma s'avaar p'Israẹl. <verse eid="1KI 16:27" /><verse number="28" style="v" sid="1KI 16:28" />Wa Omri ope otor ab'otte, abẹ annọhng-ẹ k'Samariya. Ahab kw'ode nnwa kwẹ wọ n'ukwu ode ọvaarnạng.<verse eid="1KI 16:28" /></para>
  <para style="s">Ahab kw'ode ọvaarnạng kw'Israẹl</para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 16:29" />Wa Ahab kw'ode nnwa kw'Omri, ọtạm ẹvaar ch'Israẹl dạdạbh k'cho kw'ọttong ẹrạbh ukuma chi-kanttaan, kw'Asa kk'Juda ọdạbha. Wa Ahab ọdạbhẹ ẹvaar k'Samariya k'Israẹl icho ẹrạbh ukuma ifa. <verse eid="1KI 16:29" /><verse number="30" style="v" sid="1KI 16:30" />Wa Ahab kw'ode nnwa kw'Omri usi ibyibyia chididen k'ititikha s'Ọvaar Ubinọkpaabyi ch'ẹyọhng ch'anạng p'achiẹ-ẹ eden adạbh. <verse eid="1KI 16:30" /><verse number="31" style="v" sid="1KI 16:31" />Wa akwẹ khẹ nóbenga bẹ́ usi mpyibha s'uwa Jẹroboam kw'ode nnwa kw'Nẹbat usi. Wa ọbạra ọta ọtạkha Jẹzẹbẹl kw'ode uminanwa kw'Ẹtbaal, kw'ode ọvaarnạng kw'Sidọn. Osenga ma ọtạma Baal kpukpobha. <verse eid="1KI 16:31" /><verse number="32" style="v" sid="1KI 16:32" />Usi ijabyi s'Baal k'ọchọhm kw'Baal, kw'uwa usi k'Samariya. <verse eid="1KI 16:32" /><verse number="33" style="v" sid="1KI 16:33" />Wa Ahab ọbạra usi akpatava p'Ashẹra, utima ugbikhi idwạdwạkhọ s'Ọvaar Ubinọkpaabyi, kw'ode Ubinọkpaabyi kw'Israẹl, ọyọhnga udik kw'avaar p'achiẹ-ẹ eden adạbh Israẹl asi.<verse eid="1KI 16:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1KI 16:34" />K'okpe kw'Ahab ọdạbhẹ ẹvaar ẹwọ kw'uwa Hiyẹl kw'ubin Bẹtẹl, ọbạra ọkpa nnạm ọta usi ofhon kw'Jẹriko. Wa Abiram kw'ode ocheden-nwa kwẹ ope, k'okpe kw'n'ọphyaakhẹ agbaarẹ p'ofhon ngwọ. Sẹgub kw'ode okponga-nnạm kwẹ ọbạra ope k'okpe kw'n'usi abaakhamma, otor k'idik s'uwa Ọvaar Ubinọkpaabyi oseng k'Joshua, kw'ode nnwa kwˈNun ọkpaakhẹ.<verse eid="1KI 16:34" /></para>
  <chapter eid="1KI 16" />
  <chapter number="17" style="c" sid="1KI 17" />
  <para style="s1">Elija ọnạngẹ ẹyaakha ch'iyoma sididen</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 17:1" />Ma wọ Elija kw'ubin Tishbe, k'ẹkhạma ch'Gilead obeni Ahab bẹ́, “Oche ngwọ kw'Ọvaar Ubinọkpaabyi, kw'ode Ubinọkpaabyi kw'Israẹl kw'amma mkpobh urukhu akpen, ipọhrọ, ọbạra ode ọrạngkpaang, k'icho s'm'ikwu k'iwu oro, mátebh, oyonga bẹ́ kk'ẹmma mmạnga.”<verse eid="1KI 17:1" /></para>
  <para style="s1">Ikpembukha ọnạngẹ Elija uchiattọhk</para>
  <para style="p">
    <verse number="2" style="v" sid="1KI 17:2" />Ma o, Ọvaar Ubinọkpaabyi oben Elija bẹ́, <verse eid="1KI 17:2" /><verse number="3" style="v" sid="1KI 17:3" />“Bina maa, sọhng k'ukhubha kw'okpebhadudon n'uyin ata attubha k'usí kw'Kẹrit, k'ukhubha kw'okpebhadudon n'uyin k'Jọrdan. <verse eid="1KI 17:3" /><verse number="4" style="v" sid="1KI 17:4" />Ọma m'agwo asi ma efhobh njọ, kk'Ikpembukha ntọhma bẹ́ ẹnạng-ọ uchiatttọhk ma.”<verse eid="1KI 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 17:5" />Ma wọ usi oche kw'Ọvaar Ubinọkpaabyi ọkpaakh-ẹ. Ukwu ofona k'usi kw'Kẹrit, k'ukubha kw'okpebhadudon n'uyin k'Jọrdan, uninga kha. <verse eid="1KI 17:5" /><verse number="6" style="v" sid="1KI 17:6" />Ikpembukha n'ikken-ẹ brẹd ọttạra eten k'ekpebha ọttạra ẹchọhkhawu chidede, n'ọbạra ogwo asi ma efhobh.<verse eid="1KI 17:6" /></para>
  <para style="s1">Elija ọttạra opokwa kw'Zarẹphat</para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 17:7" />K'okpe ma, efhobh njọ ẹkka, ukwuru s'ọrạngkpaang nạn ma ẹkhạma njọ nótebha. <verse eid="1KI 17:7" /><verse number="8" style="v" sid="1KI 17:8" />Ọvaar Ubinọkpaabyi ọkpaakh-ẹ udik oben bẹ́: <verse eid="1KI 17:8" /><verse number="9" style="v" sid="1KI 17:9" />“Nemi eden sọhng kha Zarẹphat k'ẹkhạma ch'Sidon, ata aninga kha. Amma kk'opokwa wạnọ ntọhna ma bẹ́ ọnạng-ọ uchiattọhk.” <verse eid="1KI 17:9" /><verse number="10" style="v" sid="1KI 17:10" />Mạnna wọ ubin ofona kha Zarẹphat. Masẹ ukpir k'ẹbaakhamma ch'ofhon ngwọ, okhebha opokwa s'n'otobha ommeni. Elija oyeri opokwa nwọ oben-ẹ bẹ́, “Totokhạn, nạng-m asi ngwo.” <verse eid="1KI 17:10" /><verse number="11" style="v" sid="1KI 17:11" />Masẹ ọta bẹ́, ọta ọkhaabha asi, oben-ẹ bẹ́, “Gba ttạra brẹd ọnnwakwẹ ma, nchi.”<verse eid="1KI 17:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1KI 17:12" />Opokwa nwọ ubhina bẹ́, “K'oche kw'Ọvaar Ubinọkpaabyi, kw'ode Ubinọkpaabyi kwọ urukhu akpen, brẹd wạnọ-wạnọ kạ́nkhaam, oyonga ẹbọhkka ch'abubuma, ọttạra ana p'oliv k'ekpomma. Ẹgwọ n'ntobha ommeni f'm'ntima mmạna nta nwọhn uchiattọhk f'amma ọttạra nnwa kwaam, ọfha amạna anchi ampe.”<verse eid="1KI 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 17:13" />Elija oben-ẹ bẹ́, “Tte nạng-ọ ojor. Sọhng abhạna ata asi oche kw'abeni. Okhenka, tima mvọ f'akhaam asi brẹd ọnwakwẹ kwaam akken-m, bạrasẹ n'ata asi uchiattọhk f'ọma ọttạra nnwa kwọ m'achi. <verse eid="1KI 17:13" /><verse number="14" style="v" sid="1KI 17:14" />S'Ọvaar Ubinọkpaabyi kw'ode Ubinọkpaabyi kw'Israẹl obeni bẹ́, ‘Igbạre sọ s'abubuma, abubuma míwor, ẹnakpomma chọ ana mása tạrr ukpira k'iwu ch'Ọvaar Ubinọkpaabyi m'otebh asi ma ẹkhạma nja.’ ”<verse eid="1KI 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 17:15" />Ofona ọta usi oche kw'Elija kk'ẹ otekha bẹ́ usi. Mạnna wọ kw'uchiattọhk uning k'iwu chidede ọnạng Elija ọttạra ikwanạng nnwa ọttạra ẹchọhmfhạr chẹ. <verse eid="1KI 17:15" /><verse number="16" style="v" sid="1KI 17:16" />Abubuma nása k'igbạre sabẹ age, ana nábạra asa k'ekpomma, otor k'ọtọhnga kw'Ọvaar Ubinọkpaabyi utim Elija ọkpaak.<verse eid="1KI 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1KI 17:17" />K'okpe ma, nnwa kw'ikwanạng nwọ kw'ọkhaam ọchọhm, ukwu ọmmẹ-ẹ. Ọmmẹ-ẹ tạrr okhema adim, okponga ma, ope. <verse eid="1KI 17:17" /><verse number="18" style="v" sid="1KI 17:18" />Ikwanạng nwọ oben Elija bẹ́, “O usi-ẹyaakha kw'Ubinọkpaabyi, ode yạn kw'awun-m o?” Ttọttọ, akwu bẹ́ akwu ajim-m mpyibh saam, abạra afhọ nnwa kwaam o?”<verse eid="1KI 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 17:19" />Elija ọpọhna bẹ́, “Nạng-m nnwa kwọ.” Ọtạkh-ẹ k'mbọhk s'ọkka, utim-ẹ uvura k'ẹmaanggọ ch'ẹnyạng ch'nuninga, urur-ẹ k'ibhikha chẹ. <verse eid="1KI 17:19" /><verse number="20" style="v" sid="1KI 17:20" />Nose njọhm oyeri Ọvaar Ubinọkpaabyi, oben bẹ́, “O Ọvaar Ubinọkpaabyi kw'ode Ubinọkpaabyi kwaam, node bẹ́ ọma kk'ọkhạnkạmọ ọbọhk attia okhebha opokwa nnwa kw'amma nning abẹ, kw'asi nnwa kwẹ ope o?” <verse eid="1KI 17:20" /><verse number="21" style="v" sid="1KI 17:21" />Uyima ukhubha nnwa nwọ nden nttaan, ose njọhm oyeri Ọvaar Ubinọkpaabyi bẹ́, “O Ọvaar Ubinọkpaabyi kw'ode Ubinọkpaabyi kwaam, tte nnwa nnwa ọbạra uruk akpen!”<verse eid="1KI 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 17:22" />Wa Ọvaar Ubinọkpaabyi ọbhaang njọhm s'Elija, usi nnwa nwọ ọphyạbha, ọbạra uruk akpen. <verse eid="1KI 17:22" /><verse number="23" style="v" sid="1KI 17:23" />Elija o udira nnwa nwọ k'ẹmaanggọ, utim-ẹ ọsạkha ẹnyạng ch'ọchọhm. Ọtạkh-ẹ ọnạng ọkka, oben bẹ́, “Kker ẹ, nnwa kwọ k'akpen ọbạra urukha e!”<verse eid="1KI 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1KI 17:24" />Ma wọ ikwanạng nwọ obeni Elija bẹ́, “Napra wọ n'nsong bẹ́ ọma ade usi-ẹyaakha kw'Ubinọkpaayi, ọttạra bẹ́, ọtọhnga kw'Ọvaar Ubinọkpaabyi kw'uyini k'akhọ k'ẹmma ode udik ọkka.”<verse eid="1KI 17:24" /></para>
  <chapter eid="1KI 17" />
  <chapter number="18" style="c" sid="1KI 18" />
  <para style="s1">Elija ọttạra Obadaya</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 18:1" />K'okpe-bhirada, k'cho kw'ottong attaan, Ọvaar Ubinọkpaabyi ọkpaakhẹ Elija udik, oben bẹ́, “Sọhng ata akhọhkha Ahab ifor sọ, khiri m'ntọhm ọrạngkpaang ọtọhm otebh ma ẹkhạma njọ.” <verse eid="1KI 18:1" /><verse number="2" style="v" sid="1KI 18:2" />Mạnna wọ Elija ofon ọta ọkhọhkha Ahab ifor sẹ.</para>
  <para style="p" vid="1KI 18:2">Ma okpe ngwọ, wa okwo fididen uning k'Samariya, <verse eid="1KI 18:2" /><verse number="3" style="v" sid="1KI 18:3" />kw'usi Ahab oyeri Obadaya, kw'ode okker-ọtọhm kwẹ. (Wa Obadaya ọkhaam ojora fididen kh'Ovaar Ubinọkpaabyi. <verse eid="1KI 18:3" /><verse number="4" style="v" sid="1KI 18:4" />K'okpe kw'uwa Jẹzẹbẹl n'ọfhọ asi-ẹyaakha p'Ọvaar Ubinọkpaabyi, Obadaya kk'asi-ẹyaakha arạbh asen ọtạkha ọta udubh k'atakpa afa. Anạng arạbh afa ukuma jobh k'ẹtakpa chidede, n'ọnạng bẹ uchiattọhk ọttạra asi.) <verse eid="1KI 18:4" /><verse number="5" style="v" sid="1KI 18:5" />Wa Ahab obeni Obadaya bẹ́, “Sọhng ata asenga abaabha ẹkhạma njọ, akpira k'mfhobh-cho ọttạra apekhuma p'idede. Ankke ma anse asạsaarẹ p'm'annạng nnyạnyaang ọttạra mmaam achi aruk akpen, ọfha nạngẹ utirattọhk famạna vạnọ-vạnọ ọbọhk antẹ, ope.” <verse eid="1KI 18:5" /><verse number="6" style="v" sid="1KI 18:6" />Mạnna wọ kw'abẹ abhaangẹ ẹkhạma njọ ch'abẹ akhạmọ bẹ́, abẹ asenga akhạbha. Ahab osenga ofona k'ukhubha gwạnọ, Obadaya ofona ukhubha ngwọkha.<verse eid="1KI 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 18:7" />Masẹ Obadaya n'osenga ọbaabha, Elija ọttạma abẹ. Obadaya utin-ẹ, ọrạkha uttima ititikha k'ikpukpobha usim-ẹ, oben bẹ́, “Aro kwaam Elija, ọma wọ maa k'udik ọkka?”<verse eid="1KI 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 18:8" />Elija ubhina bẹ́, “Uwe e, sọhng ata akpaak aro kwọ bẹ́, Elija uning mama e.”<verse eid="1KI 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 18:9" />Obadaya ọbạbh bẹ́, “Ipina chaam ede yạn o, kw'n'aben bẹ́ atạkha amma ọtọhmnạng kwọ, atte ọbọhk anạng Ahab ọfhọ o? <verse eid="1KI 18:9" /><verse number="10" style="v" sid="1KI 18:10" />K'oche kw'Ọvaar Ubinọkpaabyi, kw'ode Ubinọkpaabyi kwọ urukhu akpen, ẹkhạma kède, ọvaarfhon kọ́bạra ode kw'aro kwaam nạn ọnạng tạm nótọhma bẹ́, abẹ aror-ọ. Okpe kwidede kw'ẹkhạma, ọbạrạ ode ọvaarfhon obeni bẹ́, ma kàde, m'oben abẹ achekhi bẹ́, abẹ kọ ma násia. <verse eid="1KI 18:10" /><verse number="11" style="v" sid="1KI 18:11" />Ma, ọma n'atọhm amma bẹ́ nta mkpaak aro kwaam bẹ́, ‘ Elija uning mama.’ <verse eid="1KI 18:11" /><verse number="12" style="v" sid="1KI 18:12" />Masẹ m'mbina nnikhọ ma, amma ibyi s'iguguma s'Ọvaar Ubinọkpaabyi n'abạra itima abọ ifona kạ́nsong. De n'mfon nta mkpaak Ahab bẹ́ kk'ọ nsia, ukwu ukpira maa khọ núsia, m'ofhọ-m ofhọ. Abhaang, amma ọtọhmnạng kwọ ntạm k'idikkobh chaam mkpobha Ọvaar Ubinọkpaabyi o. <verse eid="1KI 18:12" /><verse number="13" style="v" sid="1KI 18:13" />Aro kwaam, node bẹ́, udik nábhaanga kw'nsi k'okpe kw'Jẹzẹbẹl n'ọfhọ asi-ẹyaakha p'Ọvaar Ubinọkpaabyi? Amma ndubhu asi-ẹyaakha arạbh asen k'atakpa afa, arạbh afa ukuma jobh k'ẹtakpa jạnẹ, arạbh afa ukuma jobh ka njọkha, mbạra nnạng bẹ uchiattọhk ọttạra asi. <verse eid="1KI 18:13" /><verse number="14" style="v" sid="1KI 18:14" />Ma n'atọhm-m bẹ́, nta mkpaak aro kwaam bẹ́, ‘Elija uning maa’, m'ọfhọ-m ọfhọ!”<verse eid="1KI 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 18:15" />Elija oben bẹ́, “K'oche kw'Ọvaar Ubinọkpaabyi kw'Ẹfa phyibh kw'amma mkpobh urukhu akpen, k'udik-ọkka, amma m'nkọhkha Ahab ifor saam ọkhọhkha chemma.”<verse eid="1KI 18:15" /></para>
  <para style="s1">Elija uning k'okpecho kw'Kaamẹl</para>
  <para style="p">
    <verse number="16" style="v" sid="1KI 18:16" />Wa Obadaya ubin ọta okhebha Ahab ọkpaakh-ẹ udik ngwọ. Ahab o n'ofon ọta okhebha Elija. <verse eid="1KI 18:16" /><verse number="17" style="v" sid="1KI 18:17" />Masẹ Ahab ose Elija, ọbạbh-ẹ bẹ́, “Ọma wọ ma, ọma ọkhọhr-nạng kw'Israẹl?”<verse eid="1KI 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1KI 18:18" />Elija ubhina bẹ́, “Amma Israẹl k'ẹkhọhr nạ́ngia, ọma ọttạra ẹchọhmfhạr ch'atte bọ n'atera age Israẹl k'ẹkhọhr e. Abạnga kk'nnyina s'Ovaar Ubinọkpaabyi ayaanga ajẹ, ata akpohba akpatava p'Baal. <verse eid="1KI 18:18" /><verse number="19" style="v" sid="1KI 18:19" />Ma o, yeri anạng p'Israẹl phyi-phyibh, abẹ akhebh-m k'okpecho kw'Kaamẹl. Abạra atima asi-ẹyaakha mbọ p'Baal, ẹnọhna ukuma arạbh afa ukuma jobh, abạra atima asi-ẹyaakha p'Ashẹra ẹnọhna akwu, p'n'achi ọttọhk k'okpokkro kw'Jẹzẹbẹl.”<verse eid="1KI 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1KI 18:20" />Mạnna wọ Ahab ọtọhmọ ẹkkaabha ọbaabha Israẹl, bẹ́ abẹ ayeri asi-ẹyaakha atobha k'okpecho kw'Kaamẹl. <verse eid="1KI 18:20" /><verse number="21" style="v" sid="1KI 18:21" />Elija uyin obe anạng mbọ k'ititikha, oben bẹ́, “M'ubhir ukpira yạn, bạrasẹ abạnga asi ẹkka ch'abạnga k'idik nnama ifa o? De Ọvaar Ubinọkpaabyi wọ abạnga makpobha, akpobh-ẹ. Okhenka, ode Baal wọ abạnga makpobha, akpobh-ẹ.”</para>
  <para style="p" vid="1KI 18:21">Anạng mbọ akhenka amyi <char style="it">bẹ́ tọọhng</char>.<verse eid="1KI 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 18:22" />Ma wọ, Elija obeni bẹ bẹ́, “Amma-amma wọ n'nnikhi k'ikhaana s'asi-ẹyaakha p'Ọvaar Ubinọkpaabyi. Okhenka, asi-ẹyaakha p'Baal ade ẹnọhna ukuma arạbh afa ukuma jobh. <verse eid="1KI 18:22" /><verse number="23" style="v" sid="1KI 18:23" />Anạng mạna mmaam-dim mfa. Tte asi-ẹyaakha p'Baal atekha jạnẹ anạng abẹma oyeni. Tte abẹ achẹk chẹ k'ayaara-k'ayaara anạna k'ommeni, abẹ nạ́ngẹ ekpon age. Amma m'ntạkha ọbhaam-dim nwọkha, ndo wẹ nnạna k'ommeni, ekpon mạ́nge. <verse eid="1KI 18:23" /><verse number="24" style="v" sid="1KI 18:24" />Abạnga m'ayeri eche ch'ọkha f'abạnga, amma m'mbạra nyeri eche ch'Ọvaar Ubinọkpaayi. Ọnạng kw'oseng k'ekpon ubhina, uyini bẹ́, ẹma wọ kw'abạnga m'akpobha.”</para>
  <para style="p" vid="1KI 18:24">Wa anạng mbọ phyibh abeni bẹ́, “Udik kw'akpaakhẹ ma, ujibhi oseng eden.”<verse eid="1KI 18:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 18:25" />Elija oben asi-ẹyaakha mbọ p'Baal bẹ́, “Masẹ abạngama asaabhẹ-ọsaabh, abạnga achi eden atekha ọbhaam-dim wạnọ, ado wẹ. Abạnga ayeri eche ch'ọkha fabạnga, okhenka, abạnga ekpon káge o.” <verse eid="1KI 18:25" /><verse number="26" style="v" sid="1KI 18:26" />Mạnna wọ abẹ atạk ọbhaam-dim kw'abẹ anạngẹ bẹ, ado.</para>
  <para style="p" vid="1KI 18:26">Abẹ ayeri eche ch'ọkha fabẹ, tạma k'ekpebha tạrr, ukpira k'ẹya, abẹ n'awạmọ k'ẹrạng-k'ẹrạng bẹ́, “O Baal, tọbh mạna ẹmma khadẹ!” Okhenka, bẹ ẹmma nọ́tọbha, bẹ nọ́bạra ubhina. Abẹ atubh mbin abaabha ijabyi sabẹ kk'asia.<verse eid="1KI 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1KI 18:27" />Ma ẹyachẹ, Elija ọtạm bẹ yuyukhu, ọben bẹ́, “Abạnga ado ayeri-oyeri, ọgba ẹma wọ abạnga n'akpobha! Njanna n'ọkkẹ udik, ayọngu ma, ọyạyạkhẹ wọ, adaadaak, ọta osenga. Njanna n'ọttaabha ọda, oyonga abạnga m'aphyạbh-ẹ.” <verse eid="1KI 18:27" /><verse number="28" style="v" sid="1KI 18:28" />Osenga ma, abẹ ado awạmọ-ọwạmọ, abẹ atima akkangkkang-kkro ọttạra akhọhn ataarẹ abẹma oyeni k'ifor tạrr isẹ ibyenga, otor k'ọche kw'ẹmmaana chabẹ edẹ. <verse eid="1KI 18:28" /><verse number="29" style="v" sid="1KI 18:29" />Ẹyachẹ njọ eseng, abẹ afona ororo asi ẹyaakha ch'erebhi bẹ tạrr ukpira k'okpe kw'ejafọhna ch'ẹchọhkha. Okhenka, bẹ ẹmma nọ́tọbha, bẹ nọ́bạra ọpọhna, ọnạng kw'ọbạra ọkhọmọ bẹ itọhng kòde.<verse eid="1KI 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="1KI 18:30" />Ma wọ, Elija obeni anạng mbọ phyibh bẹ́, “Abạnga asenga agbaar-m khansẹ.” Anạng mbọ asenga agbaar-ẹ. Odo ijabyi s'Ọvaar Ubinọkpaabyi, sabẹ kk'avọhkha. <verse eid="1KI 18:30" /><verse number="31" style="v" sid="1KI 18:31" />Elija ọtạkha ata jobh-kamfa, ẹta jạnẹ ebe ẹnạng ẹkhạma jạnẹ ch'ẹnạmma ch'Jekọb, kw'Ọvaar Ubinọkpaabyi oseng k'akhẹ oben bẹ́ “Oma m'akpena Israẹl.” <verse eid="1KI 18:31" /><verse number="32" style="v" sid="1KI 18:32" />Utim ata mbọ usi ijabyi k'eche ch'Ọvaar Ubinọkpaabyi, ọbạra ọphyaakhẹ ọgbaarẹ kw'ọmmaam ẹkpa, kw'm'okke ọnwa agbạre p'ididen afa p'achimạma, ọfhạrọ sẹ. <verse eid="1KI 18:32" /><verse number="33" style="v" sid="1KI 18:33" />Otobha ommeni, ọchẹk ọbhaam-dim nwọ, ọtạkha ọnạna k'ọmmeni mvọ. Oben bẹ bẹ́, “Abạnga age asi k'agbạre annebung tạrr apẹ ifu, abạnga abyenga pyẹ ma ẹnạnga njọ ọttạra k'ommeni.”<verse eid="1KI 18:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1KI 18:34" />Ọbạra oben bẹ bẹ́, “Abạnga asi adạkhẹ.” Wa abẹ asi adạkhẹ.</para>
  <para style="p" vid="1KI 18:34">Oben bẹ́, “Abạnga asi ottonga ikpe ittaan .” <verse eid="1KI 18:34" /><verse number="35" style="v" sid="1KI 18:35" />Wa asi mbọ afhobhu afhạrọ ijabyi nnọ, abẹ abạra afu k'ọgbaarẹ <char style="it">bẹ́ ttạbh</char>. <verse eid="1KI 18:35" /><verse number="36" style="v" sid="1KI 18:36" />Masẹ ukpir k'ọkpe kw'ẹjafọhna, Elija kw'ode usi-ẹyaakha osenga obe k'ititikha, ose njọhm oben bẹ́, “O Ọvaar Ubinọkpaabyi, kw'ode Ubinọkpaabyi kw'Abraham, ọttạra Isaak, ọttạra Jekọb akpobh, tte anạng asonga chemma bẹ́, ọma wọ ade Ubinọkpaabyi kw'Israẹl, abẹ abạra asonga bẹ́, amma nde ọtọhmnạng kwọ, kw'n'usi idik phyi-phyibh otor k'nnyina sọ. <verse eid="1KI 18:36" /><verse number="37" style="v" sid="1KI 18:37" />Bhaanga njọhm saam, o Ọvaar Ubinọkpaabyi, bhaanga njọhm saam, ọfha anạng mba asonga bẹ́, ọma Ubinọkpaabyi wọ ade Ubinọkpaabyi, kw'm'abạra abhakhẹ nttem sabẹ itor-ọ.” <verse eid="1KI 18:37" /><verse number="38" style="v" sid="1KI 18:38" />Mạnna wọ ekpon ch'ibin k'Ọvaar Ubinọkpaabyi ẹsạk ẹkkạmọ ẹja, ọttạra ommeni, ọttạra nta, ọttạra isisek, ẹbạra ẹyạma ẹttaakhẹ asi p'aning k'ọgbaarẹ.<verse eid="1KI 18:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1KI 18:39" />Masẹ anạng mbọ phyibh asẹ udik ngwọ, abẹ́ atto ayima ma isisek, agạma aben bẹ́, “Ọvaar Ubinọkpaabyi wọ ode Ubinọkpaabyi kw'ọbaan ikpukpobha! Ọvaar Ubinọkpaabyi wọ ọbaan ikpukpobha!”<verse eid="1KI 18:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="1KI 18:40" />Wa Elija obeni bẹ bẹ́, “ Abạnga avạkha asi-ẹyaakha p'Baal. Abạnga ọnạng wạnọ-wạnọ ọbọhk kátte ọrạbh o!” Mạnna wọ abẹ avạk bẹ́, Elija utima bẹ ọsạkha k'Ipekhuma s'Kishọn, ọfhọ bẹ ma.<verse eid="1KI 18:40" /></para>
  <para style="s">Elija ose njọhm bẹ́ ọrạngkpaang otebh</para>
  <para style="p">
    <verse number="41" style="v" sid="1KI 18:41" />Elija oben Ahab bẹ́, “Sọhng ata achi, abạra agwo, khiri ọrạngkpaang kwididen nạngkhu umun itum.” <verse eid="1KI 18:41" /><verse number="42" style="v" sid="1KI 18:42" />Ahab ofon bẹ́, ota uchi, ọbạra ogwọ, Elija o, uvura k'okpecho k'Kaamẹl ẹrạng-ẹrạng, ọrạkha ma isek, ọtạkha ititikha oge k'ntaak.<verse eid="1KI 18:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="1KI 18:43" />Oben ọtọhmnạng kwẹ bẹ́, “Sọhng ata akkeri k'ukhubha kw'ọraanga kwididen.” Ofona ọta okkeri.</para>
  <para style="p" vid="1KI 18:43">Oben bẹ́, “ Ọttọhk kha kòde e.” Elija oben-ẹ k'ikpe isenọfa bẹ́, “Kpa nnạm ata akkeri.” <verse eid="1KI 18:43" /><verse number="44" style="v" sid="1KI 18:44" />Ottong nden nsenọfa, ọtọhmnạng ukwu ọkpaakh-ẹ bẹ́, “Ebona ch'ẹsạk masẹ ọbọhk nạngkhi iyin k'ukhubha kw'ọraanga kwididen e.”</para>
  <para style="p" vid="1KI 18:44">Ma wọ Elija obeni bẹ́, “Sọhng ata akpaak Ahab bẹ́, ‘Do ọkpaar kwọ kw'nnyạnyaang n'itwạr ininga, arạbh asạkha ọfha ọrạngkpaang nạ́ng-ọ eden ọkpa.’ ” <verse eid="1KI 18:44" /><verse number="45" style="v" sid="1KI 18:45" />Iwa ebona ipyi k'ọrạngkpaang <char style="it">bẹ́ kkạng</char>, ibum iguma, ọrạngkpaang kwididen ọtạma tạtebh. Ahab ọrạbh ofona k'Jẹzrẹl. <verse eid="1KI 18:45" /><verse number="46" style="v" sid="1KI 18:46" />Wa ẹfa ch'Ọvaar Ubinọkpaabyi ẹsạk ẹnwa Elija, ọtạkha udikhikpa kwẹ ọkpa k'ọnọhma-wuram kwẹ, ọrạbh oyongu Ahab tạrr, ukpira kha Jẹzrẹl.<verse eid="1KI 18:46" /></para>
  <chapter eid="1KI 18" />
  <chapter number="19" style="c" sid="1KI 19" />
  <para style="s1">Elija ọrạbhọ ofona kha Horẹb</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 19:1" />Wa Ahab ukwu ọkpaak Jẹzẹbẹl udik kwidede kw'Elija kk'usia, ọttạra oche kw'utim ọkkangkkang-kkro ọfhọ asi-ẹyaakha phyibh. <verse eid="1KI 19:1" /><verse number="2" style="v" sid="1KI 19:2" />Osenga ma, Jẹzẹbẹl ọtọhm ọkpaakhẹ-ẹkkaabha ọta oben Elija bẹ́, “Tte akha asi-m ukhira kwidede kw'ọdaakhẹ bẹ, de uphyini k'okpe-demakwẹ ngwa, nạn akpen pọ nạ́ndima masẹ usi-ẹyaakha wạnọ, k'ikhaana s'asi-ẹyaakha mbọ p'afhọ.”<verse eid="1KI 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1KI 19:3" />Wa ojora ọvạk Elija, ọrạbh ọkkaana akpen pẹ. Masẹ ukpir k'Beershẹba, k'ẹkhạma ch'Juda, ubin urik ọtọhmnạng kwẹ ma. <verse eid="1KI 19:3" /><verse number="4" style="v" sid="1KI 19:4" />Utim iwu jạnẹ usi osenga ukpira k'ibyi s'anạng nạnárukha. Ukwu ukpira k'ofo kw'ichi jạnẹ, uninga ẹyạr ma ose njọhm bẹ́ ope, oben bẹ́, “O Ọvaar Ubinọkpaabyi, amma idik kk'aam igba e, tạkha akpen paam, ọgba amma sạng njibhi nyọhnga abaro paam.” <verse eid="1KI 19:4" /><verse number="5" style="v" sid="1KI 19:5" />Mạnna wọ uyim ma ofo kw'ichi njọ isekhisek, ọttaabha.</para>
  <para style="p" vid="1KI 19:5">Ma ibua-ibua, oseng-eden kw'Ubinọkpaabyi utwu-ẹ, oben bẹ́, “ Bina achi ọttọhk.” <verse eid="1KI 19:5" /><verse number="6" style="v" sid="1KI 19:6" />Udira achen okkeri ọbaabha, ose brẹd kw'abẹ abhaabhẹ k'ekpon, kw'uning ọbaang-ẹ ma echo, ọttạra igbạre s'asi. Uchi, ọbạra ogwo, ọbạra uyima.<verse eid="1KI 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 19:7" />Wa oseng-eden kw'Ubinọkaabyi ọkpa nnạm ottong ifa, ukwu utwu-ẹ, oben bẹ́, “Bina achi ọttọhk khiri osenga kw'm'asi ubhiri oseng eden.” <verse eid="1KI 19:7" /><verse number="8" style="v" sid="1KI 19:8" />Mạnna wọ ubin uchi, ọbạra ogwo. Osenga ma ọkhaama ẹfa ch'utim usi osenga k'iwu arạbh afa, ọttạra nnungu-wu arạbh afa, tạrr ukpira k'Horẹb, kw'ode okpecho kw'Ubinọkpaabyi. <verse eid="1KI 19:8" /><verse number="9" style="v" sid="1KI 19:9" />Uyima k'ọtakpamma ma irungu njọ.</para>
  <para style="s1" vid="1KI 19:9">Ọvaar Ubinọkpaabyi uyini Elija abẹ</para>
  <para style="p" vid="1KI 19:9">Wa Ọvaar Ubinọkpaabyi ọkpaakhẹ Elija abẹ, oben bẹ́, “Elija, n'asi mbạng maa?”<verse eid="1KI 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 19:10" />Elija ubhina bẹ́, “ Amma kk'aam obhema k'idik s'Ọvaar Ubinọkpaabyi kw'Ẹfa phyibh. Anạng p'Israẹl kk'echekha chọ afhuma, abẹ avọhkhọ njabyi sọ, abạra atima ọkkangkkang-kkro afhọ asi-ẹyaakha pọ. Amma mạnkkeni wọ n'nnikhi, mạntọmma, abẹ n'akhonga bẹ́ abẹ agba afhọ-m.”<verse eid="1KI 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 19:11" />Ọvaar Ubinọkpaabyi oben bẹ́, “Yin kha iyaan ata abe k'okpehco k'ititikha s'Ọvaar Ubinọkpaabyi, khiri amma Ọvaar Ubinọkpaabyi n'abạra nseng nnyong-ọ.”</para>
  <para style="p" vid="1KI 19:11">Ma wọ ufum kw'ọkpọhkhọ-ọkpọhkhọ ugum, ọphyaakhẹ akpecho, ọbạra ọphyaakhẹ atakpa k'ititikha s'Ọvaar Ubinọkpaabyi. Okhenka, wa Ọvaar Ubinọkpaabyi ma ufum nwọ kòde. Masẹ ufum nwọ kk'osenga, ibum ch'isisek isi, okhenka, wa Ọvaar Ubinọkpaabyi ma ibum ch'isisek kòde. <verse eid="1KI 19:11" /><verse number="12" style="v" sid="1KI 19:12" />Masẹ ibum njọ ch'isisek ikum, ekpon iyin. Okhenka Ọvaar Ubinọkpaabyi ma ekpon njọ kòde. Ayongu ekpon njọ, n'ode idik-kkaabha. <verse eid="1KI 19:12" /><verse number="13" style="v" sid="1KI 19:13" />Masẹ Elija ọbhaang ẹkkaabha njọ, ọkwạnọ ọnọhma-wuraam kwẹ ububha k'ititikha, uyin k'iyaan ọta obe k'ọtakpamma.</para>
  <para style="p" vid="1KI 19:13">Ma wọ ọtọhnga iyini ọbạbh-ẹ bẹ́, “ Elija n'asi mbạng maa?”<verse eid="1KI 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1KI 19:14" />Ubhina bẹ́, “Amma kk'aam obhema k'idik s'Ọvaar Ubinọkpaabyi kw'Ẹfa phyibh, Anạng p'Israẹl kk'echekha chọ afhuma, abẹ avọhkhọ njabyi sọ, abạra atima ọkkangkkang-kkro afhọ asi-ẹyaakha pọ. Amma mạnkkeni wọ n'nnikhi, kw'abẹ n'akhonga bẹ́, abẹ agba afhọ-m.”<verse eid="1KI 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 19:15" />Ọvaar Ubinọkpaabyi oben-ẹ bẹ́, “Sọhng akpa nnạm, asenga k'eden ch'wạra aseng akwu, afona k'ibyi s'anạng nạnárukha s'Damaskọs. De akpir kha, byenga Hazayẹl ana k'echo, asiẹ-ẹ ọvaarnạng kw'Aram. <verse eid="1KI 19:15" /><verse number="16" style="v" sid="1KI 19:16" />Abạra abyenga Jẹhu, kw'ode nnwa kw'Nimshi ana k'echo, asiẹ-ẹ ọvaarnạng kw'Israẹl. Abyenga Elisha, kw'ode ujunung-nnwa kw'Shaphat kw'ubin Abẹl-Mẹhola ana k'echo, ọfha otera echo chọ masẹ usi-ẹyaakha. <verse eid="1KI 19:16" /><verse number="17" style="v" sid="1KI 19:17" />Jẹhu m'ọfhọ ọnạng kwidede kw'ọnnaang ọkkangkkang-kkro kw'Hazayẹl, Elija m'ọbạra ọfhọ ọnạng kwidede kw'ọnnaang ọkkangkkang-kkro kw'Jehu. <verse eid="1KI 19:17" /><verse number="18" style="v" sid="1KI 19:18" />Okhenka, amma nchokhu anạng nnọhna chikhamfa ukuma arạbh jobh k'Israẹl, p'nạn ndwudwungu tạm nákpikha anạng Baal, abẹ kẹ nábạra abaakha.”<verse eid="1KI 19:18" /></para>
  <para style="s1">Eyera ch'Elisha</para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 19:19" />Wa Elija ubin ma ọta ose Elisha, kw'ode nnwa kw'Shaphat, s'n'utima mmaam ẹrạbh ukuma annebung utubh isisek, ẹma oyeni n'ọyaar mmaam s'ikpong nnạm s'ittong ẹrạbh ukuma annebung. Elija ọta okhebha Elisha, ọwạra ọnọhma-wuram kwẹ, ugiẹ-ẹ. <verse eid="1KI 19:19" /><verse number="20" style="v" sid="1KI 19:20" />Elisha ubina urik mmaam sẹ, ọrạbh otor Elija nnạm, oben bẹ́, “ Tte nta mbaaakha otte kwaam, ọttạra ọkka kwaam, mbạra mben bẹ bẹ́, ‘Abạnga ayima e,’ ọfha nkwu amfona,”</para>
  <para style="p" vid="1KI 19:20">Elija ubhina bẹ́, “Kpa nnạm asọhng, amma kọ eden nạ́mkpa.”<verse eid="1KI 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1KI 19:21" />Mạnna wọ Elisha ubin urikh-ẹ, okpa nnạm. Ọtạkha mmaam sẹ, ọfhọ. Ọtạkha ẹtọhmkpo py'n'utima utubh isisek umuma ekpon ch'utim ọwọhn nten nnọ, bạrasẹ n'ọtạk ọnạng anạng pẹ, abéẹ achi. Mạnna wọ ubin ọtwạn Elija abẹ, ọta ode ọtọhmnạng kwẹ.<verse eid="1KI 19:21" /></para>
  <chapter eid="1KI 19" />
  <chapter number="20" style="c" sid="1KI 20" />
  <para style="s1">Bẹn-Hadad urim Samariya abẹ</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 20:1" />Wa Bẹn-Hadad, kw'ode ọvaarnạng kw'Aram otobh akpongnạng pẹ phyibh. Avaarnạng ẹrạbh ukuma jobh-kamfa, atim nnyạnyaang sabẹ ọttạra ijaar s'nnyạnyaang ata akhạbha Samariya, arima abẹ. <verse eid="1KI 20:1" /><verse number="2" style="v" sid="1KI 20:2" />Ọtọhmọ akpaakh-nkkaabha p'efhondiden bẹ́, abẹ ata akhebha Ahab kw'ode ọvaarnạng kw'Israẹl, <verse eid="1KI 20:2" /><verse number="3" style="v" sid="1KI 20:3" />aben bẹ́, “Maa wọ ode udik kw'Bẹn-Hadad ọkpaakhẹ: ‘Silva ọttạra gol, ọttạra ipanạng pọ p'ajibhi ọtạm akwu attạra k'iva pọ, ade paam.’ ”<verse eid="1KI 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1KI 20:4" />Ọvaarnạng kw'Israẹl ubhina bẹ́, “Tte akwẹ ode oche kw'aro kwaam kw'ode ọvaarnạng, ọkpaakhẹ. Amma ọttạra ọtọhk fidede f'nkhaam ode pfọ.”<verse eid="1KI 20:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 20:5" />Akpaak-nkkaabha abạra akwu aben bẹ́, “Ma wọ ode udik kw'Bẹn-Hadad ọkpaakhẹ bẹ́, ‘Amma ntọhmọ ẹkkaabha bẹ́, anạng-m silva ọttạra gol ọttạra ipanạng pọ ọttạra iva. <verse eid="1KI 20:5" /><verse number="6" style="v" sid="1KI 20:6" />Okhenka, uphyini k'okpe demakwẹ ngwa, amma m'ntọhm atọhmnạng paam akwu anwa k'ọvaarter kwọ, ọtạra k'ichọhm s'atọhmnạng pọ. Abẹ m'avạkh-ọ ekpo py'ẹbạr-ọ udik phyibh ana, atima afona.’ ”<verse eid="1KI 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 20:7" />Ọvaarnạng kw'Israẹl oyeri adennạng p'ẹkhạma njọ phyibh, oben bẹ bẹ́, “Abạnga akkeri oche kw'ujunung nwa n'oror ẹkhọr o! Masẹ ọtọhmọ bẹ́, nnạng-ẹ ipanạng paam, ọttạra iva paam, ọttạra silva, ọttạra gol paam, amma khẹ pyẹ nạ́nnạma.”<verse eid="1KI 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 20:8" />Adennạng ọttạra anạng phyibh abhina bẹ́, “Khẹ itọhng kákhọhmọ, bạra tạm nukpir kw'm'asi oche kw'obeni.”<verse eid="1KI 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 20:9" />Osenga ma, ubhina atọhmnạng p'Bẹn-Hadad bẹ́, “Abạnga akpaak aro ọvaar kwaam bẹ́, ‘Ọtọhmnạng kwọ m'usi udik kwidede k'oche kw'wạra achi eden aben bẹ́, usi. De node ngwa, amma kwẹ mạ́nkke nsi e.’ ” Abẹ afona ata akpaak Bẹn-Hadad ibhina njọ.<verse eid="1KI 20:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 20:10" />Bẹn-Hadad ọtọhm ẹkkaabha ẹdwạkh-ọdwạk ọnạng Ahab, oben bẹ́, “De ububuma kw'ufu ẹbọhkpattem urikhi k'Samariya kw'm'obenga ajunung paam makhebh, tte akha mbọ asi-m oche kw'ọdaakhẹ bẹ.”<verse eid="1KI 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 20:11" />Ọvaarnạng kw'Israẹl ubhina bẹ́, “Abạnga akpaakh-ẹ bẹ́, ‘Ọnạng nwọ kw'oge ekpong-kpo oge, nạ́ng ẹmma usi masẹ ọnạng kw'n'ọwạr-ọwạra ẹ.’ ”<verse eid="1KI 20:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1KI 20:12" />Wa Bẹn-Hadad ọbhaang ẹkkaabha njọ k'ọkpe kw'ẹma ọttạra ayohk-avaar n'agwo atwuk k'abẹ k'ichọhm: ọnạng ajunung pẹ ẹfa bẹ́, “Abạnga ado ifọr ata arima bẹ abẹ.” Mạnna wọ abẹ ado ifor ata arima efhondiden abẹ.<verse eid="1KI 20:12" /></para>
  <para style="s1">Ahab okhem Bẹn-Hadad</para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 20:13" />Wa usi-ẹyaakha ukwu okhebha Ahab, kw'ode ọvaarnạng kw'Israẹl, ukwu ọnạng ẹyaakha, oben bẹ́, “Maa wọ ode udik kw'Ọvaar Ubinọkpaabyi ọkpaakhẹ, oben bẹ́, ‘Abạnga kk'asia ochẹ kw'akpongnạng mbọ asaabhẹ? Amma m'ntạkha bẹ nge bạnga k'mbọhk chemma. Ma wọ abạnga m'asonga bẹ́, amma wọ nde Ọvaar Ubinọkpaabyi.’ ”<verse eid="1KI 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1KI 20:14" />Ahab ọbạbh bẹ́, “Anẹ wọ m'usi udik ngwa o?”</para>
  <para style="p" vid="1KI 20:14">Usi-ẹyaakha ubhina bẹ́, “Ọvaar Ubinọkpaabyi obeni bẹ́: ‘Akpongnạng p'ade adikkobh p'aning kisekh-isek kw'adecho p'nkhạma, ẹbọ m'asi udik ngwa.’ ”</para>
  <para style="p" vid="1KI 20:14">Ahab ọbạbh bẹ́, “Anẹ wọ m'ọtạma irima nja? ”</para>
  <para style="p" vid="1KI 20:14">Usi-ẹyaakhẹ ubhina bẹ́, “Ọma wọ m'atạma chẹ.”<verse eid="1KI 20:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 20:15" />Ma wọ, Ahab oyeri akpongnạng arạbh jobh-kawạnọ ukuma jobh-kamfa p'ade adikkobh p'aning k'isekh-isek kw'adecho p'nkhạma. Okhenka, n'oyeri anạng mbọkha p'Israẹl phyi-phyibh otobha. Phyi-phyibh abẹ ade anạng nnọhna chi-khamfa ukuma arạbh jobh. <verse eid="1KI 20:15" /><verse number="16" style="v" sid="1KI 20:16" />Abẹ abina k'ẹya, k'okpe kw'Bẹn-Hadad ọttạra ayokh-avaarnạng ẹrạbh ukuma jobh-kamfa, p'atum-ẹ, n'abuma atwuk k'abẹ k'ichọhm. <verse eid="1KI 20:16" /><verse number="17" style="v" sid="1KI 20:17" />Akpongnạng p'ade adikkobh p'aning k'isekhisek kw'adecho p'nkhạma, bọ achi eden afona.</para>
  <para style="p" vid="1KI 20:17">Wa Bẹn-Hadad kk'abaan-ibyi ọtọhma p'akwu akpaakh-ẹ bẹ́, “Ajunung n'asenga kha Samariya akwuma e.”<verse eid="1KI 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1KI 20:18" />Oben bẹ́, “De abẹ akwu k'ẹmẹm, abạnga avạkha bẹ ikhikhebhi; de abẹ akwu irima, abạnga avạkha bẹ ikhikhebhi.”<verse eid="1KI 20:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 20:19" />Akpongnạng p'ade adikkobh p'aning k'isekhisek kw'adecho p'nkhạma abina k'efhondiden, n'arima ekpong atọr bẹ nnạm. <verse eid="1KI 20:19" /><verse number="20" style="v" sid="1KI 20:20" />Ọnạng-ọnạng ọfhọ ọwawunanạng kwẹ. Ma wọ anạng p'Aram arạbhọ, anạng p'Israẹl akhubhu bẹ. Okhenka, wa Bẹn-Hadad kw'ode ọvaarnạng kw'Aram uvur ẹnyạnyaang, utima ayaar-nnyạnyaang bạnọ pẹ ọrạbh, ọnnaanga. <verse eid="1KI 20:20" /><verse number="21" style="v" sid="1KI 20:21" />Wa ọvaarnạng kw'Israẹl osenga ukwu urima ayaar-nnyạnyaang ọttạra ijaar s'nnyạnyaang n'itwạr tạrr, okhema anạng mbọ p'Aram ipyibha-ipyibha.<verse eid="1KI 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 20:22" />Ayongu ma, usi-ẹyaahka ukwu okhebha ọvaanạng kw'Israẹl, oben bẹ́, “Do ifor sọ atik, khiri k'okpe kw'iyaabha, ọvaarnạng kw'Aram ukwuma ukwu urima abọ dạkhẹ e.”<verse eid="1KI 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 20:23" />Wa atọhmnạng p'ọvaarnạng kw'Aram anạng-ẹ ntọhna abẹn bẹ́, “Akha pabẹ ade akha p'abẹ achokhu kha akpecho. Ẹgwọ usi, abẹ akhaam ẹfa ch'abẹ akhema mạna. Okhenka, de annim bẹ abẹ k'ẹkpẹmẹ, k'udik-ọkka, m'anna bẹ ẹfa ọna e. <verse eid="1KI 20:23" /><verse number="24" style="v" sid="1KI 20:24" />Udik gwạnọ kw'm'asi ode bẹ́, m'arengi avaarnạng phyibh k'nninga sabẹ, atima adecho adwạkh-ọdwạk atera ncho sabẹ. <verse eid="1KI 20:24" /><verse number="25" style="v" sid="1KI 20:25" />Ma abạra atobha arim-ekpong demapẹ mbọ p'kk'adima. Tima nnyạnyaang atera ncho s'nnyạnyaang, atima ijaar s'nnyạnyaang n'itwạr, atera ijaar s'nnyạnyaang n'itwạr, ọfha ankke Israẹl abẹ ririma k'ẹkpẹmẹ. K'udik-ọkka, m'ankpọkh-ọkpọkhọ anyọnga bẹ e.” Wa ochera bẹ abẹ, usi oche kwabe atọhn-ẹ.<verse eid="1KI 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 20:26" />K'ọyaabha-kpe ọdwạkh-ọdwạk, Ben-Hadad otobha anạng p'Aram, abẹ aseng afona k'Aphẹk ata arima anạng p'Israẹl abẹ. <verse eid="1KI 20:26" /><verse number="27" style="v" sid="1KI 20:27" />Abẹ atọbha anạng p'Israẹl abạra ado bẹ ifor. Abẹ asenga ata akhebha bẹ. Wa anạng p'Israẹl p'akheri akhaana sạsạkhẹ afa p'nvu, aninga k'ibyibhikhasẹ akkeri bẹ ititikha, k'okpe kw'anạng p'Aram anyaamẹ afhu ẹkhạma njọ <char style="it">bẹ́, tạp</char>.<verse eid="1KI 20:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1KI 20:28" />Usi-ẹyaakha kw'Ubinọkpaabyi ukwu ọkpaak ọvaarnạng kw'Israẹl bẹ́, “ Ma wọ ode udik kw'Ọvaar Ubinọkpaabyi ọkpaakhẹ: Amma m'ntạkha arim-ekpong saabhada mbọma nge-ọ k'mbọhk, ukwuru sẹ anạng p'Aram akkẹ bẹ́, k'akpecho mạnkkeni bọ Ọvaar Ubinọkpaabyi ọkhaam ẹfa, k'mkpẹmẹ kọ́khaam, osenga ma, asonga bẹ́, amma wọ nde Ọvaar Ubinọkpaabyi.’ ”<verse eid="1KI 20:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 20:29" />Wa abẹ abhingi k'abyi-abhingapẹ akkeri ayok ititikha, k'iwu isenọfa. Ottong iwu isenọfa, ekpong ẹtạma. Anạng p'Israẹl atim iwu jạnẹ afhọ arim-ekpong p'Aram, nnọhna arạbh jobh-kamfa ukuma asen. <verse eid="1KI 20:29" /><verse number="30" style="v" sid="1KI 20:30" />Anạng p'arikh-urik arạbh afona k'ofhon-diden kw'Aphẹk, kw'udumokpon otto ọkpẹkhẹ anạng nnọhna arạbh attaan ukuma asenọfa ukuma arạbh jobh. Bẹn-Hadad ọrạbh ofona k'ofhon-diden ọta utubha k'ẹmaanggọ jạnẹ.<verse eid="1KI 20:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1KI 20:31" />Ajukwa pẹ aben-ẹ bẹ́, “ Kk'ammaanga bẹ́, avaarnạng p'Israẹl akhaam ikwosi. Tte ankpa ọvạra-bina k'nnin, ambạra ankpa ndikhi k'ncho, akkẹ ma, ọvaarnạng kw'Israẹl m'ọttọ-ọ ọbọhk otte, aruk akpen.”<verse eid="1KI 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1KI 20:32" />Wa abẹ akpa ọvạra-bina k'nnin, ọttạra ndikhi k'ncho, aseng afona k'ọvaarnạng kw'Israẹl, oben bẹ́, “Ọtọhmnạng kw'Bẹn-Hadad obeni bẹ́, ‘Totokhạn tte-m ọbọhk nnuk akpen.’ ”</para>
  <para style="p" vid="1KI 20:32">Ọvaarnạng ubhina bẹ́, “Utim uruk akpen kạkha? Ode masẹ nnwọkka kwaam.”<verse eid="1KI 20:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1KI 20:33" />Ajunung mbọ okpe nákhibha, abẹ atạk ọtọhnga ngwọ masẹ ẹkhọhkha ẹkkachẹ. Abẹ atọr m'ọtọhnga ngwọ kwẹ, abẹn bẹ́, ‘Uwe e, Bẹn-Hadad kw'ode masẹ nnwakka e!’</para>
  <para style="p" vid="1KI 20:33">Ọvaarnạng oben bẹ́, “ Abạnga ata atạkhẹ atim akwu.” Masẹ Bẹn-Hadad uyini kha, Ahab oben-ẹ uvura k'ọkpaar kwẹ kw'nnyạnyaang n'itwạr.<verse eid="1KI 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1KI 20:34" />Bẹn-Hadad oben bẹ́, “M'mmạnga nnạm nnạng-ọ ifhon-diden s'iwa otte kwaam avạk atte kwọ ọna. Akkema asi ọphyabyi fọ k'Damaskọs, oche kw'iwa otte kwaam usi, k'Samariya.”</para>
  <para style="p" vid="1KI 20:34">Ahab oben bẹ́, “Bạrasẹ nttọ-ọ ọbọhk abhạna, m'antạkha echekha ayok abẹ.” Wa ọtạk echekha Ahab abẹ, uttiẹ-ẹ ọbọhk ọbhạna.<verse eid="1KI 20:34" /></para>
  <para style="s1">Ọsẹyaakha unukhu Ahab</para>
  <para style="p">
    <verse number="35" style="v" sid="1KI 20:35" />Oseng k'ọkpaakha-dik kw'Ọvaar Ubinọkpaabyi, bạra usi-ẹyaakha wạnọ k'ngekha kw'asi-ẹyaakha, oben oyokh-ikhaana bẹ́, “Tima okpong-ttọhk fọ si-m ebhena.” Okhenka, oyok ufhum. <verse eid="1KI 20:35" /><verse number="36" style="v" sid="1KI 20:36" />Ma wọ, usi-ẹyaakha nwọ obeni bẹ́, “De abin arik-m ma <char style="it">bẹẹ</char> ekye m'ẹfhọ-ọ ọfhọ, ukwuru bẹ́, echo násạkha anạng Ọvaar Ubinọkpaabyi. Mạnna wọ ujunung nwọ ubin ofona, ekye ẹsẹ-ẹ k'eden, ẹvạkh-ẹ ẹfhọ.”<verse eid="1KI 20:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="1KI 20:37" />Usi-ẹyaakha ọbạra ose ujunung ọdwạkh-ọdwạk, oben bẹ́, “Totokhạn si-m ebhena.” Ujunung nnwọ usi-ẹ ebhena. <verse eid="1KI 20:37" /><verse number="38" style="v" sid="1KI 20:38" />Usi-ẹyaakha nwọ ofona ọta obe k'eden utik ọvaarnạng. Oge ẹnya ẹdwạkh-ọdwạk, ọkpa ẹvạrakpa ch'echo, ububha achen. <verse eid="1KI 20:38" /><verse number="39" style="v" sid="1KI 20:39" />Masẹ ọvaanạng m'oseng, usi-ẹyaakha nwa oyer-ẹ oben bẹ́, “Amma ọtọhmnạng kwọ nta k'akpong-chen, ọnạng wạnọ utim ọnạng kw'abẹ avạk k'ekpong ukwu ọben bẹ́, ‘Kkeri ujunung nwa. De udimi, mantima akpen pọ antera pẹ, deja, m'atuk talẹn wạnọ kw'silva.’ <verse eid="1KI 20:39" /><verse number="40" style="v" sid="1KI 20:40" />Sẹ n'ọyạk ọtọhmnạng kwọ, nseng kha nseng kha, ujunung nwọ ọrạbh.”</para>
  <para style="p" vid="1KI 20:40">Ọvaarnạng kw'Israẹl ubhina bẹ́, “Obo kwọ wọ ma, kw'kk'ẹyaakha asia.”<verse eid="1KI 20:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="1KI 20:41" />Mạnna wọ usi-ẹyaakha nwọ n'ọwạr ẹvạrakpa njọ ch'echo k'achen pẹ, ọvaarnạng kw'Israẹl utin-ẹ, masẹ usi-ẹyaakha wạnọ k'ngekha s'asi-ẹyaakha. <verse eid="1KI 20:41" /><verse number="42" style="v" sid="1KI 20:42" />Oben ọvaarnạng bẹ́, “Ma wọ ode udik kw'Ọvaar Ubinọkpaabyi ọkpaakhẹ, oben bẹ́, ‘Kk'ujunung kw'amma mbeni bẹ́, ope, ọbọhk attia uruk akpen. Ma wọ, m'atima akpen pọ atera pẹ, atima arim-ekpong pọ atera pẹ.’ ” <verse eid="1KI 20:42" /><verse number="43" style="v" sid="1KI 20:43" />Wa ọvaarnạng kw'Israẹl utim ofor-dọhbha, k'idwạdwạkhọ ọbhạna k'ọvaarter kwẹ, k'Samariya.<verse eid="1KI 20:43" /></para>
  <chapter eid="1KI 20" />
  <chapter number="21" style="c" sid="1KI 21" />
  <para style="s1">Owonu kw'grep kw'Nabọt</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 21:1" />K'okpe ma, wa ọkhaam udik kw'uyini ottena owonu kw'grep kw'Nabọt kw'ubin Jẹzrẹl. Wa owonu ngwọ uning k'ofhon kw'Jẹzrẹl ọbaanga ọvaarter kw'Ahab, kw'ode ọvaarnạng kw'Samariya. <verse eid="1KI 21:1" /><verse number="2" style="v" sid="1KI 21:2" />Iwu jạnẹ, Ahab obeni Nabọt bẹ́, “Masẹ owonu kwọ kw'grep uning ọbaanga ọvaarter kwaam, tte ntạkha kwẹ ọfha ntima ntubh ekpo ẹdwạkh-ọdwạk. M'nnang-ọ owonu kw'grep kw'ujibh ọtạm, ọbạra ọdaakh-ọ bẹ́, akpe-m kwẹ okpe, m'ndebh kwẹ k'ẹphya chidede ch'ẹbaan.”<verse eid="1KI 21:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1KI 21:3" />Okhenka, wa Nabọt ubhin Ahab bẹ́, “Ọvaar Ubinọkpaabyi m'óchera bẹ́, ntạkha okhebh f'ab'otte paam, nnạng-ọ.”<verse eid="1KI 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1KI 21:4" />Wa Ahab utim ifor-dọhbha, ọttạra idwạdwạkhọ asẹ ọbhạna, ukwuru sẹ Nabọt kw'ubin Jẹzrẹl, kk'obena bẹ́, “Khọ okhebh f'ab'otte paam mạ́nnạng.” Ahab ọta uyima k'ibhikha ọbhạkhẹ okkeri udimokpon ọbạra ufhum uchiattọhk chichi.<verse eid="1KI 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 21:5" />Masẹ Jẹzẹbẹl kw'ode ikwanạng kwẹ ukwu, ọbạbh-ẹ bẹ́, “Bạng udik gwọ ọphyaang-ọ ẹmma, kw'afhumu uchiattọhk o?”<verse eid="1KI 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 21:6" />Ahab ubhin-ẹ bẹ́, “Mbeni Nabọt kw'ubin Jẹzrẹl bẹ́, ‘Kpe-m owonu kwọ kw'grep de kk'ọdaakha, m'nnạng-ọ owonu ọdwạkh-ọdwạk ntima ntero ngwọ.” Okhenka, oben bẹ́, ‘Khọ owonu kwaam kw'grep mạ́nnạng.’ ”<verse eid="1KI 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 21:7" />Jẹzẹbẹl kw'ode ikwanạng kwẹ, oben bẹ́, “Ọma sạng ade ọvaarnạng kw'Israẹl o? Bina k'ibhikha achi uchiattọhk! Rebh ettem. M'ntạkha owonu ngwọ kw'grep kw'Nabọt kw'ubin Jẹzrẹl, nnạng-ọ.”<verse eid="1KI 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 21:8" />Wa ikwanạng nwọ utima eche ch'Ahab ọkkẹr nkkaabha, oyemma ẹnọhna ch'Ahab ma nkkaabha nnọ, ọtọhm okkena adencho ọttạra adennạng p'arukhu k'ofhon-diden wạnọ, Nabọt abẹ. <verse eid="1KI 21:8" /><verse number="9" style="v" sid="1KI 21:9" />Ọkkẹrẹ ma nkkaabha nnọ bẹ́,</para>
  <para style="pm" vid="1KI 21:9">“Abạnga atobha ayok atạkha iwu ch'abạnga m'aninga okwo, abạnga anạng Nabọt ininga ch'ẹbạr-udik k'ngekha kw'anạng. <verse eid="1KI 21:9" /><verse number="10" style="v" sid="1KI 21:10" />Abạnga atạkha anạng-ajaakha afa achok ẹyạr akkeri Nabọt ititikha, tte anạng mbọ afa abaar-ẹ idik aben bẹ́, kk'Ubinọkpaabyi ọttạra avaarnạng ọsaakha, Osenga ma, abạnga atim-ẹ ayin k'iyaan atọbh-ẹ nta afhọ.”<verse eid="1KI 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 21:11" />Wa adencho ọttạra adennạng mbọ p'arukhu k'ofhon-diden gwạnọ Nabọt abẹ, asi ator k'ẹkkaabha ch'Jẹzẹbẹl kk'ọkkẹra ọtọhm bẹ. <verse eid="1KI 21:11" /><verse number="12" style="v" sid="1KI 21:12" />Abẹ atạkha iwu ch'abẹ m'anininga okwo, abẹ atạkha ininga ch'ẹbạr-udik k'ngekha kw'anạng, anạng Nabọt. <verse eid="1KI 21:12" /><verse number="13" style="v" sid="1KI 21:13" />Mạnna kw'anạng ajaakha mbọ afa akwu aninga ẹyạr akkeri Nabọt ititikha. Abẹ abaar-ẹ idik m'ititikha s'anạng bẹ́, Nabọt kk'Ubinọkpaabyi ọttạra avaarnạng ọsaakha ẹ.” Ma wọ abẹ atim-ẹ ayin k'iyaan s'ofhon-diden, abẹ atọbh-ẹ nta afhọ. <verse eid="1KI 21:13" /><verse number="14" style="v" sid="1KI 21:14" />Wa abẹ atọhm ẹkkaabha anạng Jẹzẹbẹl bẹ́, “Abẹ kk'Nabọt nta atọbha, afhọ.”<verse eid="1KI 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 21:15" />Jẹzẹbẹl ọbhaang ẹkkaabha njọ <char style="it">bẹẹẹ</char> abẹ kk'Nabọt nta atọbha afhọ, oben Ahab bẹ́, “Bina ata atạkha owonu kw'grep kw'Nabọt kw'ubin Jẹzrẹl, kw'ufhum-ọ kpekpe, akhaama. K'akpen dạk kóde, kk'upua e.” <verse eid="1KI 21:15" /><verse number="16" style="v" sid="1KI 21:16" />Masẹ Ahab ọbhaang bẹ́, Nabọt kk'upua, ubina ofhona k'owonu kw'grep kw'Nabọt kw'ubin Jẹzrẹl bẹ́, ọta tạkha kwẹ ọkhaama.<verse eid="1KI 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1KI 21:17" />Ma wọ, Ọvaar Ubinọkpaabyi ọkpaak Elija kw'ubin Tishbẹ ọtọnga oben bẹ́: <verse eid="1KI 21:17" /><verse number="18" style="v" sid="1KI 21:18" />“Sọhng ata akhebha Ahab kw'ode ọvaarnạng kw'Israẹl kw'ọdạbhẹ Samariya. Uning k'owonu kw'grep kw'Nabọt, ọta ọtạkha kwẹ ọkhaama. <verse eid="1KI 21:18" /><verse number="19" style="v" sid="1KI 21:19" />Ben-ẹ bẹ́, ‘Ma wọ ode udik kw'Ọvaar Ubbinọkpaabyi ọkpaakhẹ: Kk'ọnạng afha, atạkha ọtọhk fẹ. M'ibyi nnọ s'mpfa nttaakhẹ isẹ s'Nabọt, ma kw'mpfa m'bạra ittaakhẹ isẹ sọ, k'udik-ọkka, isẹ sọ e!’ ”<verse eid="1KI 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1KI 21:20" />Ahab oben Elija bẹ́, “Kw'uyini bẹ́, ọma ọwawuna-nạng kwaam kk'aam arora ase o!”</para>
  <para style="p" vid="1KI 21:20">Elija ubhina bẹ́, “Kk'ọ nsia e, ukwuru s'kk'ifor sọ akpia anạng ibyibya k'ititikha s'Ọvaar Ubinọkpaabyi. <verse eid="1KI 21:20" /><verse number="21" style="v" sid="1KI 21:21" />Ọvaar Ubinọkpaabyi obeni bẹ́, ‘M'nnạng-ọ irem. M'ndima iva p'iva pọ, mbạra ndimi okpong-nnạm-nwa kw'ujunug kwidede k'echọhmfạr ch'Ahab k'Israẹl, ode ubira ọbạra ubira núdia. <verse eid="1KI 21:21" /><verse number="22" style="v" sid="1KI 21:22" />M'nsi ẹchọhmfạr chọ ede masẹ ẹchọhmfạr ch'Jẹroboam, kw'ode nnwa kw'Nẹbat, ọttạra ẹchọhmfạr ch'Baasha, kw'ode nnwa kw'Ahija, ukwuru sẹ kk'idwạdwạkhọ saam agbọkha, abạra atima anạng p'Israẹl eden abẹ asi ẹkhọngkwuru.’<verse eid="1KI 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 21:23" />“Udik kw'oten Jẹzẹbẹl, Ọvaar Ubinọkpaabyi oben bẹ́, ‘Mpfa m'nchi Jẹzẹbẹl ọbaanga odumokpon k'Jẹzrẹl.’<verse eid="1KI 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1KI 21:24" />“Mpfa rọ m'nchi ọnạng kwidede kw'ode kw'Ahab kw'ope k'ofhon-diden, ọnọhn f'ẹrạng m'bạra ichi ọnạng kw'ope m'ẹkhạma njọ.”<verse eid="1KI 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 21:25" />(Wa ọnạng tạma núninga, kw'okpe ifor sẹ ọnạng ibyibya k'ititikha s'Ọvaar Ubinọkpaabyi, masẹ Ahab, kw'Jẹzẹbẹl kw'ode ikwanạng kwẹ n'ọchọma. <verse eid="1KI 21:25" /><verse number="26" style="v" sid="1KI 21:26" />Wa usi idik s'ibạk anạng, n'okpobha akha, masẹ anạng p'Amọr, p'iwa Ubinọkpaabyi ukhubhu k'ititikha s'anạng p'Israẹl.)<verse eid="1KI 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1KI 21:27" />Masẹ Ahab ọbhaang atim mbọ, ọyaakhẹ ọvạra fẹ f'ifor, oge ọvạra-bina ọbạra utim uchiattọhk. Uyima ọvạra-bina apyẹ, ọbạra osenga ikwosi ọbaabha.<verse eid="1KI 21:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1KI 21:28" />Ma wọ, Ọvaar Ubinọkpaabyi okpaakhẹ Elija kw'ubin Tishbẹ bẹ́: <verse eid="1KI 21:28" /><verse number="29" style="v" sid="1KI 21:29" />“Kk'asia oche kw'Ahab k'ifor sẹ okhoma kha khaam k'ititikha o? Masẹ kk'ifor okhoma, ọkhạnkhạmọ dạk mạ́ntọhm k'okpe kwẹ. Okhenka, m'nnạng ẹchọhmfạr chẹ ọkhạnkhạmọ k'okpe kw'nnwa kwẹ ọdạbhẹ.”<verse eid="1KI 21:29" /></para>
  <chapter eid="1KI 21" />
  <chapter number="22" style="c" sid="1KI 22" />
  <para style="s1">Mikaya usi nyaakha otena Ahab</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 22:1" />K'icho ittaan, anạng p'Aram ọttạra anạng p'Israẹl ekpong nárima. <verse eid="1KI 22:1" /><verse number="2" style="v" sid="1KI 22:2" />Okhenka, k'icho kw'ottong icho ittaan, Jẹhoshaphat kw'ode ọvaarnạng kw'Juda ofon ọta ose ọvaarnạng kw'Israẹl. <verse eid="1KI 22:2" /><verse number="3" style="v" sid="1KI 22:3" />Ọvaarnạng kw'Israẹl kk'atọhmnạng pẹ obena bẹ́, “Abạnga kásong bẹ́, amạna mba bọ ankhaam Ramọt-Gilead, okhenka, m'ansenga yạn antạkha kwẹ k'mbọhk s'ọvaarnạng kw'Aram?”<verse eid="1KI 22:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1KI 22:4" />Ma wọ nọbạbhọ Jẹhoshaphat bẹ́, “S'm'atwạn-m abẹ anta annima Ramọt-Gilead abẹ?”</para>
  <para style="p" vid="1KI 22:4">Jẹhoshaphat ubhina ọvaarnạng kw'Israẹl bẹ́, “Amma nde oche kw'ọma ade, arim-mkpong paam ade oche kw'pọ ade, nnyạnyaang saam ide masẹ nnọ sọ.” <verse eid="1KI 22:4" /><verse number="5" style="v" sid="1KI 22:5" />Okhenka, Jẹhoshaphat ọbạra oben ọvaarnạng kw'Israẹl bẹ́, “Ochedendik ode bẹ́, m'aror ntọhna s'Ọvaar Ubinọkpaabyi.”<verse eid="1KI 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 22:6" />Ma wọ ọvaarnạng kw'Israẹl oyeri asi-ẹyaakha p'akpir anạng ẹnọhna, ọbạbh bẹ bẹ́, “Anta annima ekpong ọttạra anạng p'Ramọt-Gilead abẹ sa a?”</para>
  <para style="p" vid="1KI 22:6">Abẹ abhina bẹ́ “Sọhng, khiri Ọvaar Ubinọkpaabyi m'otạkha bẹ otạkha oge ọvaarnọng k'mbọhk.”<verse eid="1KI 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 22:7" />Okhenka, Jẹhoshaphat ọbạbh bẹ́, “Usi-ẹyaakha kw'Ọvaar Ubinọkpaabyi dạk ma kóde kw'm'ankke andwạn o?”<verse eid="1KI 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 22:8" />Ọvaarnạng kw'Israẹl ọpọhna Jẹhoshaphat bẹ́, “Ankhaam usi-ẹyaakha wạnọ kw'okpen Mikaya, kw'ode nnwa kw'Imla, kw'm'ankke-oke ansenga ma akhẹ andwạn Ọvaar Ubinọkpaabyi. Okhenka, khaam idik kọ́daakhẹ, ukwuru bẹ́, ẹyaakha ọkkachẹ otena abaam mókke ọnạng.”</para>
  <para style="p" vid="1KI 22:8">Jẹhoshaphat ubhina bẹ́, “Tte ọvaarnạng nạngẹ udik-demakwẹ ngwọ ọkpaakhẹ.”<verse eid="1KI 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 22:9" />Ma wọ ọvaarnạng kw'Israẹl noyeri ọtọhmnạng kwẹ wạnọ, oben bẹ́, “Tima Mikaya kw'ode nnwa kw'Imla, akwu k'okpe-k'okpe.”<verse eid="1KI 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 22:10" />Wa ọvaarnạng kw'Israẹl, ọttạra Jẹhoshaphat kw'ode ọvaarnạng kw'Juda, asi mvaar-nya sabẹ aninga k'mvaar-chi sabẹ, k'ibyi sa bẹ n'aninga akhaan akwumạma, ọbaanga ẹbaakhamma ch'Samariya. Asi-ẹyaakha phyip n'asi nyaakha ma bẹ k'ititikha. <verse eid="1KI 22:10" /><verse number="11" style="v" sid="1KI 22:11" />Zẹdẹkaya kw'ode nnwa kw'Kenaana utima mbaanga usi abhik, oben bẹ́, “Ma wọ ode udik kw'Ọvaar Ubinọkpaabyi ọkpaakhẹ bẹ́, ‘Abạnga m'atima pẹ arima anọng p'Aram abẹ, tạrr abạnga adimi bẹ phyip.’ ”<verse eid="1KI 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1KI 22:12" />Asi-ẹyaakha mbọkha phyibh n'asi ẹyaakha njọ jạnẹ jạnẹ, abẹ n'abeni bẹ́, “Abạnga arima Ramọt-Gilead abẹ, akhema, kkeri Ọvaar Ubinọkpaabyi m'ọtạkha kwẹ oge ọvaarnọng k'mbọhk.”<verse eid="1KI 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 22:13" />Ọkpaakh-ẹkkaabha kw'kk'ofona bẹ́, ọta oyeri Mikaya, oben-ẹ bẹ́, “Kker e, asi-ẹyaakha mbọkha phyip, n'asi ẹyaakha ch'ekhema anạng ọvaarnạng, ọbaan bẹ́, ọma abạra asi ukhira ngwọ gwạnọ.”<verse eid="1KI 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1KI 22:14" />Okhenka, Mikaya oben bẹ́, “Oche ngwọ kw'Ọvaar Ubinọkpaabyi urukhu akpen, amma m'kpaakh-ẹ udik demakwẹ kw'idede kw'Ọvaar ubinọkpaabyi ọkpaakh-m.”<verse eid="1KI 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 22:15" />Ma ukpir, ọvaarnạng ọbọbh-ẹ bẹ, Mikaya, amạna anta anima Ramọt-Gilead abẹ o?”</para>
  <para style="p" vid="1KI 22:15">Mikaya ubhinẹ bẹ, “Sọhng ata akhem-ẹ, kkeri Ọvaar Ubinọkpaabyi m'ọtạkha kwẹ ugiọ-ọ k'mbọhk.”<verse eid="1KI 22:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1KI 22:16" />Ọvaarnạng oben-ẹ bẹ, “Ikpe iphyaang s'amma mạnsiọ-ọ achekhi ke che ch'Ọvaar Ubinọkpaabyi bẹ́, akpaakh-m udik-ọkka ọ?”<verse eid="1KI 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1KI 22:17" />Mikaya ubhin-ẹ bẹ́, “Amma nse s'anạng p'Israẹl phyibh n'araama k'akpecho masẹ arạkhạmaan p'nạn akkeri-arạkhạmaan akhaam. Ọvaar Ubinọkpaabyi oben bẹ́, ‘Anạng mba atim-eden k'akhaam. Tte ọnạng kwidede ọbhạna k'idira.’ ”<verse eid="1KI 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1KI 22:18" />Ọvaarnạng kw'Israẹl oben Jẹhoshaphat bẹ́, “Wạra khọ nạ́ntekha bẹ́, ẹyaakha ẹkkachẹ ch'm'ijibh-m m'usio o?”<verse eid="1KI 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 22:19" />Mikaya ofona ororo n'ọkpaak bẹ́, bhaanga udik kw'Ọvaar Ubinọkpaabyi: amma nse Ọvaar Ubinọkpaabyi s'uning ẹyạr k'ẹvaar-chi chẹ, ọttạra ọsaabh f'uning k'ẹrọng k'udimbọhk ọttạra k'ọkwabọhk kwẹ. <verse eid="1KI 22:19" /><verse number="20" style="v" sid="1KI 22:20" />Ọvaar Ubinọkpaabyi oben bẹ́, ‘Anẹ wọ m'ọbọhra Ahab ọta urima Ramọt-Gilead abẹ, osengama ope?’ Ibhina ede nkhạmọ-nkhạmọ.<verse eid="1KI 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1KI 22:21" />K'ekponga-nnạm, iguguma ikwu ikwe ebe Ọvaar Ubinọkpaabyi k'ititikha eben bẹ́, ‘Amma m'bọhr-ẹ ọbọhra.’<verse eid="1KI 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 22:22" />Ọvaar Ubinọkpaabyi ọbọbh bẹ́, ‘Masenga yạn?’</para>
  <para style="p" vid="1KI 22:22">“ ‘Amma n'nta nde iguguma ch'afhạra k'ẹmma ch'asi-ẹyaakha pẹ phyip.’</para>
  <para style="p" vid="1KI 22:22">Ọvaar Ubinọkpaabyi oben bẹ́, “ ‘Makke-okke abọhr-ẹ. Sọhng ata asi ochengwọ.’<verse eid="1KI 22:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 22:23" />“Ọvaar Ubinọkpaabyi kk'egwugwuma ch'afhạra ọbọhk utia ẹnwa asi-ẹyaakha pọ phyip. Ọvaar Ubinọkpaabyi kk'ẹyaakha-pyibha ch'm'idim-ọ usia.”<verse eid="1KI 22:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1KI 22:24" />Mạna wọ Zẹdẹkaya kw'ode nnwa kw'Kenaana ubin ọta ububha Mikaya ọbọhk k'ititikha, ọbọbh bẹ́, “Kha yạn wọ kw'iguguma ch'ibin k'Ọvaar Ubinọkpaabyi n'ette amma ọbọhk, ẹta ẹkpaak udik ẹnạng ọma o?”<verse eid="1KI 22:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 22:25" />Mikaya ubhina bẹ́, “Ọma m'asonga-ọsonga ma iwu njọ ch'm'arạbh bẹ́, ata atubha k'ẹmaanggọ ẹtaanga.”<verse eid="1KI 22:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 22:26" />Ọvaarnạng kw'Israẹl ọnạng ẹfa, ọben bẹ́, “Abạnga atọm Mikaya ọkpa nnạm otor Amọn, kw'ode ọdạbhẹ kw'efon-diden, ọttạrạ Joash kw'ode nnwa kw'ọvaarnạng <verse eid="1KI 22:26" /><verse number="27" style="v" sid="1KI 22:27" />aben bẹ́, ‘Ọvaarnạng obeni bẹ́: abạnga age ọnạng nwa k'mgbakkọhbhọ, abạnga uchiattọhk khẹ kánạng oyonga brẹd ọttạrạ asi, uninga tạrr nkwuna k'idira.’ ”<verse eid="1KI 22:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1KI 22:28" />Mikaya oben bẹ́, “Ode ọma akwun k'idira, ma wọ ode bẹ Ọvaar Ubinọkpaabyi kha khaam nósenga ọkpaak kwẹ.” Ọbạra ọttạra bẹ́, abạnga mba phyibh abhaanga ọtọhnga kwaam!”<verse eid="1KI 22:28" /></para>
  <para style="s1">Obo kw'Ahab</para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 22:29" />Ma wọ, ọvaarnạng kw'Israẹl, ọttạra Jẹhoshaphat kw'ode ọvaarnạng kw'Juda, afona ata arima anạng p'Ramọt-Gilead abẹ. <verse eid="1KI 22:29" /><verse number="30" style="v" sid="1KI 22:30" />Ọvaarnạng kw'Israẹl oben Jẹhoshaphat bẹ́, “Amma m'mfhona ẹnya n'tima nta ekpong njọ, okhenka, ọma ge ẹvaar-nya chọ.” Ma wọ kw'ọvaarnạng kw'Israẹl ofhon ẹnya ota ekpong.<verse eid="1KI 22:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1KI 22:31" />Ode s'ọvaarnạng kw'Aram kk'adecho pẹ p'ijaar s'nnyạnyaang n'itwạr, anạng ẹrạbh ukuma jobh-kamfa, ẹfa ọnạnga bẹ́, “Abạnga ọnạng ọdwạkh-ọdwạk, ọsạkh-ọsạkha, ọbạra ọbạr-ọbạr o, abẹ kárima, oyonga ọvaarnạng kw'Israẹl.” <verse eid="1KI 22:31" /><verse number="32" style="v" sid="1KI 22:32" />Okpe kw'adecho p'ijaar s'nnyạnyaang n'itwạr n'ase Jẹhoshaphat, abẹ akkẹ bẹ́, “K'udik-ọkka, ọvaaarnạng kw'Israẹl wọ ma.” Mạnna wọ abẹ abhạkhẹ bẹ́, arima abẹ. Okhenka, Jẹhoshaphat ọwọmọ ẹmạng. <verse eid="1KI 22:32" /><verse number="33" style="v" sid="1KI 22:33" />Masẹ adecho p'ijaar s'nnyạnyaang n'itwạr n'atini bẹ́, ọvaarnạng kw'Israẹl sạng, abẹ akum-ẹ khukhubh.<verse eid="1KI 22:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1KI 22:34" />Masẹ ọtta-uyuk wạnọ n'ọkhạkh-ẹ ọtta uyuk, kw'osengi k'ẹphaangẹ k'ẹbhaang jạnẹ k'ekpongkpo py'ifọr, ukhum ọvaarnạng kw'Israẹl. Osenga-ma ọvaarnạng oben ọyaar-ijaar kwẹ kw'nnyạnyaang bẹ́, “Bhạkhẹ ọkpaar, atim-m abina ma ekpong kpa, kkeri abẹ khaam ọttọhk asia.” <verse eid="1KI 22:34" /><verse number="35" style="v" sid="1KI 22:35" />Wa ekpong jọ irim k'iwu ibunguchẹ. Abẹ atạkha ọvaarnạng abe idumsẹ ma ọkpaar kw'nnyạnyaang ekkeri ititikha k'Aram. Isẹ iyin k'ebhena ch'abẹ asi-ẹ ibyenga k'ọgbarẹ k'ọkpaar kw' nnyạnyaang n'itwạr, masẹ n'ukpir k'ẹchọkha, ope. <verse eid="1KI 22:35" /><verse number="36" style="v" sid="1KI 22:36" />Ukwu ukpira k'ọchọkha-dudon, abẹ awon ẹmạng k'ibyibhigasẹ s'arim-nkpong p'Israẹl aben bẹ́, “ujunung kw'idede ọkpa nnạm ọbhạna k'ofon kwẹ. Ujunung kw'idede ọsọng obhạna k'ẹkhạma chẹ ẹ!”<verse eid="1KI 22:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="1KI 22:37" />Wa ọvaarnạng ope, abẹ atim-ẹ akwuna akwa anọhnga k'Samariya. <verse eid="1KI 22:37" /><verse number="38" style="v" sid="1KI 22:38" />Abẹ ata akpobhu ọkpaar kw'nnyạnyaang, k'isipe jạnẹ ch'Samariya (k'ibyi sẹ asasa n'akpobha asi), mpfa ibạra ittaakhẹ isẹ sẹ, otor kk'ọtọhga kw'Ọvaar Ubinọkpaabyi kk'ẹyaakha usia.<verse eid="1KI 22:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1KI 22:39" />Idik idwạkh-ọdwạk s'ẹvaar ch'Ahab, ọttạrạ idik s'usi bẹ phyip, ọvaarter kw'usi utima ekpo masẹ nnyi-sa odokha, ọtạrạ efhon-diden ch'usi ikpọkhọ, abẹ akkẹrẹ sẹ k'nwẹr s'atạmadik s'itor k'avaarnạng p'Israẹl. <verse eid="1KI 22:39" /><verse number="40" style="v" sid="1KI 22:40" />Wa Ahab ope otor ab'otte. Ahaziya kw'ode nnwa kwẹ wọ-nukwu ọdabh ẹvaar.<verse eid="1KI 22:40" /></para>
  <para style="s1">Jẹhoshaphat kw'ode ọvaarnạng kw'Juda</para>
  <para style="p">
    <verse number="41" style="v" sid="1KI 22:41" />Wa Jẹhoshaphat kw'ode nnwa kw'Asa ukwu ode ọvaarnạng kw'Juda, k'icho kw'ottong inebạng kw'Ahab kk'ọvaarnạng kw'Israẹl udia. <verse eid="1KI 22:41" /><verse number="42" style="v" sid="1KI 22:42" />Wa Jẹhoshaphat ode icho ẹrạbh ukuma chi, k'okpe kw'ode ọvaarnạng, ọdabh Jẹrusalẹm k'icho ẹrạbh ukuma asen.Wa ọkka okpen Azuba, kw'ode nnwa kw'Shilhi. <verse eid="1KI 22:42" /><verse number="43" style="v" sid="1KI 22:43" />Wa usi idik s'itor-otor k'ititikha s'Ọvaar Ubinọkpaabyi, otor ntwạkhọ s'otte Asa, sẹ n'ọpạna. Osenga-ma, wa ikpukpobhabyi s'ọyaankpa abẹ khẹ navạkha-na, anạng mba afon ororo n'asi njafọna, abạra akạmmọ insẹns ma ibyi nnọ <verse eid="1KI 22:43" /><verse number="44" style="v" sid="1KI 22:44" />Wa Jẹhoshaphat, obạra uruk k'ẹmẹm ọttạrạ ọvaarnạng kw'Israẹl.<verse eid="1KI 22:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="1KI 22:45" />Idik idwạkh-ọdwạk k'ẹvaar ch'Jẹhoshaphat, idik s'usi ọttạrạ m'kpong s'urim, abẹ akkẹr-ẹ sẹ k'nnwẹr s'itạm'adik ator k'avaarnạng p'Juda. <verse eid="1KI 22:45" /><verse number="46" style="v" sid="1KI 22:46" />Wa ukhibhi akhapa p'asasa p'ajunung p'wa arikhi ma ẹkhạma njọ phyip, k'ọkpe kw'ọtte Asa utim urukhu akpen. <verse eid="1KI 22:46" /><verse number="47" style="v" sid="1KI 22:47" />Ma ọkpe ngwọma, wa ọvaarnạng k'Edom kode. Ọdạbhẹ-ẹkhạma wọ wa ode ọvaarnạng.<verse eid="1KI 22:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="1KI 22:48" />Wa Jẹhoshaphat usi ijaar s'asi s'Tashish k'ọsaabh, p'n'utima ọta odebh gol k'Phir. Okhenka, wa abẹ ibyi nákke ata, abẹ n'akpong k'Ẹziyọn-Gẹbẹr. <verse eid="1KI 22:48" /><verse number="49" style="v" sid="1KI 22:49" />Ma okpe ngwọ, Ahaziya kw'ode nnwa kw'ahab oben Jẹhoshaphat bẹ́, “Tte ajunung paam ayaar ijaar saam atwạn attạrạ ajunung pọ.” Jẹhoshaphat ufhum.<verse eid="1KI 22:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="1KI 22:50" />Wa Jẹhoshaphat ope ọtor ab'otte, abẹ anọhng-ẹ k'efhon-diden ch'Devid kw'ode otte. Jẹhoram kw'ode nnwa kwẹ wọ n'ọdabhẹ ẹvaar njọ.<verse eid="1KI 22:50" /></para>
  <para style="s1">Ahaziya kw'ode ọvaarnạng kw'Israẹl</para>
  <para style="p">
    <verse number="51" style="v" sid="1KI 22:51" />Wa Ahaziya kw'ode nnwa kw'Ahab ukwu ode ọvaarnạng kw'Israẹl k'Samariya k'icho ifa, k'icho kw'ittong icho chi-khamfa s'Jẹhoshaphat kk'ọvaarnạng udia k'Juda. <verse eid="1KI 22:51" /><verse number="52" style="v" sid="1KI 22:52" />Wa usi ibyibya-dik k'ititikha s'Ọvaar Ubinọkpaabyi, ukwuru bẹ́ otoru ntwạkhọ s'otte ọttạrạ s'okka ọttạrạ ntwạkhọ s'Jẹroboam kw'ode nnwa kw'Nẹbat, kw'usi anạng p'Israẹl asi ipyikha. <verse eid="1KI 22:52" /><verse number="53" style="v" sid="1KI 22:53" />Wa ọsạk echo ọbạra okpobha Baal, k'oche kw'wa otte kk'usia, kw'ugbikhi idwạdwạkhọ s'Ọvaar Ubinọkpaabyi, kw'ode Ubinọkpaabyi kw'Israẹl.<verse eid="1KI 22:53" /></para>
  <chapter eid="1KI 22" />
</usx>