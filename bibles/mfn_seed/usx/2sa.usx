<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2SA" style="id">- Mbembe Osopong [MFNOs]</book>
  <para style="h">2 Samwẹl</para>
  <para style="toc2">2 Samwẹl</para>
  <para style="toc1">Nnwẹr s'ittong ifa s'Samwẹl</para>
  <para style="mt1">Nnwẹr s'ittong ifa s'Samwẹl</para>
  <chapter number="1" style="c" sid="2SA 1" />
  <para style="s1">Devid ọbhaang obo kw'Saul</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 1:1" />K'okpe kw'Saul kk'upua, Devid ubina kha s'kk'anạng p'Amalẹk okhema ukwuna, ukwu uninga iwu ifa k'Ziklag. <verse eid="2SA 1:1" /><verse number="2" style="v" sid="2SA 1:2" />Ottong iwu ittaan, ujunung wạnọ kw'ubin k'ibyibhingasẹ s'Saul ukwu, ọttạra ọvạra f'kk'ọyaakha kk'ifor, ububuma awẹ kha echo. Masẹ ukpir k'ibyi s'Devid uning, otto ukhubha k'isek k'ikpukpobha.<verse eid="2SA 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 1:3" />Devid ọbọbh-ẹ bẹ́, “Ọma abin mạn akwu maa?”</para>
  <para style="p" vid="2SA 1:3">Ujunung nwọ ubhina bẹ́, “Amma nnạbhọ k'ibyibhingasẹ s'akpongnạng p'Israẹl.”<verse eid="2SA 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 1:4" />Devid ọbạbh-ẹ bẹ́, “Bạng udik gwọ otto? Kpaakh-m”</para>
  <para style="p" vid="2SA 1:4">Ujunung nwọ ọpọhn-ẹ bẹ́, “Akpongnạng saabhada p'Israẹl kk'arạbha k'akpong-chen, saabhada kk'abạra apua. Saul ọttạra nnwa kwẹ Jonatan kk'abạra apua.”<verse eid="2SA 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 1:5" />Ma wọ, Devid ọbạbhọ udikkobh nwọ kw'uttim ẹkkaabha njọ ukwu bẹ́, “Ọma aseng yạn asonga bẹ́, Saul ọttạra nnwa kwẹ Jonatan kk'apua?”<verse eid="2SA 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 1:6" />Udikkobh nwọ ọpọhna bẹ́, “Amma nta k'okpecho kw'Gilboa, nta nttạma s'Saul kk'uttia ọkpẹkhẹ ọkhọhn pfẹ, ọttạra oche kw'ijaar s'nnyạnyaang n'itwạr, ọttạra ayaar-nnyạnyaang n'akhubh-ẹ ẹkhạm-ẹkhạma. <verse eid="2SA 1:6" /><verse number="7" style="v" sid="2SA 1:7" />Masẹ ọbhạkhẹ ose-m, oyer-m, nchera mben bẹ́, ‘Kkeri amma maa.’<verse eid="2SA 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 1:8" />“Ọbạbh-m bẹ́, ‘Ọma ade bạng ọnạng?’</para>
  <para style="p" vid="2SA 1:8">“Amma o n'mpọhn-ẹ bẹ́, ‘Amma mbin Amalẹk.’<verse eid="2SA 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 1:9" />“Ma wọ, oben-m bẹ́, ‘Twạkhọ gbaar-m, afhọh-m! Khiri n'nning k'mbọhk s'obo maa, n'nttem njẹ iyọhng maa e.’<verse eid="2SA 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 1:10" />“Amma o, ntwạkhọ mgbaar-ẹ, mfhẹ-ẹ, ukwuru s'nse bẹ́, masẹ k'uttia ma, akpen dạk múruk. Nkwu nwạr-ẹ ivaarkpo s'ukhubh k'echo, ọttạra ọkpọ-ọbọhk kw'oge, ntima nkwu maa bẹ́, nnạng ọma aro kwaam e.”<verse eid="2SA 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 1:11" />Ma wọ Devid ọttạra ajunung pẹ phyibh avạk ọvạra fabẹ k'ifor ayaakhẹ. <verse eid="2SA 1:11" /><verse number="12" style="v" sid="2SA 1:12" />Abẹ aninga ikwosi-ikwosi, abạra agạma mmạng, ayima okwo tạrr ukpira k'ẹchọhkha, ukwuru obo kw'Saul ọttạra nnwa kwẹ Jonatan, ọttạra kw'anạng p'Ọvaar Ubinọkpaabyi, ọttạra anạng p'Israẹl, ukwuru sabẹ atim ọkkangkkang-kkro afhọ bẹ.<verse eid="2SA 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 1:13" />Devid ọbạbh ujunung nwọ, kw'utim ekkaabha njọ ukwu bẹ́, “Ọma abin mạn?”</para>
  <para style="p" vid="2SA 1:13">Ujunung nwọ ọpọhna bẹ́, “Amma nde nnwa kw'ukhikhennạng kw'ubin Amalẹk.”<verse eid="2SA 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 1:14" />Ma wọ Devid ọbạbh-ẹ bẹ́, “Usi yạn kw'nạn khọ nójora bẹ́, ayaan ọbọhk kwọ, afhọ ọnạng kw'Ọvaar Ubinọkpaabyi kk'ana obyenga k'echo?”<verse eid="2SA 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 1:15" />Ma wọ Devid oyeri ujunung kwẹ wạnọ oben bẹ́, “Song ata afhẹ-ẹ!” Osenga ma, uvun-ẹ ọfhọ, ujunung nwọ ope. <verse eid="2SA 1:15" /><verse number="16" style="v" sid="2SA 1:16" />N'ode s'Devid kk'ẹ obena bẹ́, “Isẹ sọ m'ibhạkhẹ ikpẹkhẹ ọma oyeni, s'kk'ẹmma chọ atima ayaakhẹ bẹ́, ọma kk'ọnạng kw'Ọvaar Ubinọkpaabyi obyeng ana k'echo afha.”<verse eid="2SA 1:16" /></para>
  <para style="s1">Ebomạng ch'Devid utim ọgạma Saul ọttạra Jonatan</para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 1:17" />Devid utim ebomạng nja ọgạma Saul ọttạra nnwa kwẹ Jonatan. <verse eid="2SA 1:17" /><verse number="18" style="v" sid="2SA 1:18" />Ọnạng ẹfa bẹ́, abẹ akpebhi ajunung p'Juda ebomạng nja ch'uyuk. (Abẹ akkẹrẹ ẹmạng nja k'nnwẹr s'Jasha).<verse eid="2SA 1:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="2SA 1:19" />“Israẹl o, abạrada pọ kk'apua ayima k'akpecho pọ e!</para>
  <para style="q2" vid="2SA 1:19">Kkeri oche kw'afanạng atto e!<verse eid="2SA 1:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="2SA 1:20" />Abạnga udik ngwa k'Gat kk'akpaak o,</para>
  <para style="q2" vid="2SA 1:20">abạnga kwẹ k'akkaden p'Ashkẹlọn kákpaak,</para>
  <para style="q1" vid="2SA 1:20">deja, aminava p'aPhilistiya m'aninga kk'ottennebh,</para>
  <para style="q2" vid="2SA 1:20">deja, aminava p'akpatwạr-nạng m'asi erobha e.<verse eid="2SA 1:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="2SA 1:21" />“O akpecho p'Gilboa,</para>
  <para style="q2" vid="2SA 1:21">Abạnga abona-si, oseng ọrạngkpaang máse e.</para>
  <para style="q2" vid="2SA 1:21">Tte achimạma p'nnạnga nạngẹ adạkhẹ k'iwonu sabạnga iyạmọ,</para>
  <para style="q1" vid="2SA 1:21">ukwuru bẹ́, ma wọ abẹ annukhu ọkhọhnkpa kw'ọfa-nạng,</para>
  <para style="q2" vid="2SA 1:21">usi ọkhọhnkpa kw'Saul ana p'Ọvaar Ubinọkpaabyi dạk kọ́khaam.<verse eid="2SA 1:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="2SA 1:22" />Ubin k'isẹ s'anạng p'ape,</para>
  <para style="q2" vid="2SA 1:22">ubina k'ẹnạng ch'afa-nạng,</para>
  <para style="q1" vid="2SA 1:22">uyuk kw'Jonatan nnạm nọ́kpa.</para>
  <para style="q2" vid="2SA 1:22">Ọkkangkkang-kkro kw'Saul mbọhk-mbọhk núkwuna.<verse eid="2SA 1:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="2SA 1:23" />Masẹ wa Saul ọttạra Jonatan arukhu akpen,</para>
  <para style="q2" vid="2SA 1:23">abẹ adaakhẹ anạng idik, abạra asi ọphyaam anạng ayok;</para>
  <para style="q2" vid="2SA 1:23">k'obo, abẹ ayok nábạra abhaangẹ.</para>
  <para style="q1" vid="2SA 1:23">Wa abẹ agwengi ayọhnga itingi,</para>
  <para style="q2" vid="2SA 1:23">abẹ akhaama ẹfa ayọhnga nkke.<verse eid="2SA 1:23" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="24" style="v" sid="2SA 1:24" />“Aminava p'Israẹl o,</para>
  <para style="q2" vid="2SA 1:24">abạnga agạma Saul e,</para>
  <para style="q1" vid="2SA 1:24">kw'n'ọnạng bạnga ọvạra f'okhoru ichi-cho,</para>
  <para style="q2" vid="2SA 1:24">kw'utim gol odokhu nnya sabạnga.<verse eid="2SA 1:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="2SA 1:25" />“Chakhokho o! Kkeri oche kw'afanạng ape k'ekpong e!</para>
  <para style="q2" vid="2SA 1:25">Jonatan ope uyima k'akpecho pọ.<verse eid="2SA 1:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="2SA 1:26" />O Jonatan nnwọkka kwaam, ọma wọ amma n'ngạma e,</para>
  <para style="q2" vid="2SA 1:26">ọma wa abạra-m udik aseng eden.</para>
  <para style="q1" vid="2SA 1:26">Idạdaakha s'uwa akhaam abamẹ ibạr-ọbạr,</para>
  <para style="q2" vid="2SA 1:26">ibạrẹ ọtạm iyọhnga idạdaakha s'ikwanạng.<verse eid="2SA 1:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="2SA 1:27" />“Kkeri oche kw'afanạng k'attia!</para>
  <para style="q2" vid="2SA 1:27">“Ekpongkpo kk'ikhibha <char style="it">bẹ́ phyibh!”</char><verse eid="2SA 1:27" /></para>
  <chapter eid="2SA 1" />
  <chapter number="2" style="c" sid="2SA 2" />
  <para style="s1">Abẹ abyengi Devid ana k'echo ọdạbh ẹvaar ch'Juda</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 2:1" />Ukwu ukpira k'okpe ma, Devid ọbạbh Ọvaar Ubinọkpaabyi bẹ́, “Ma, n'mbin mfona k'ofhon gwạnọ k'ẹkhạma ch'Juda o?”</para>
  <para style="p" vid="2SA 2:1">Ọvaar Ubinọkpaabyi ubhin-ẹ bẹ́, “Sọhng.”</para>
  <para style="p" vid="2SA 2:1">Devid ọbạbh bẹ́, “M'ntena mạn?”</para>
  <para style="p" vid="2SA 2:1">Ọvaar Ubinọkpaabyi ubhin-ẹ bẹ́, “Tena k'Hẹbrọn.”<verse eid="2SA 2:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 2:2" />Ma wọ Devid ubin ofona k'Hẹbrọn ọttạra ipanạng pẹ afa p'ade, Ahinoam kw'ubin Jẹzrẹl, ọttạra Abigẹl, kw'ode opokwa kw'Nabal kw'ubin Kaamẹl. <verse eid="2SA 2:2" /><verse number="3" style="v" sid="2SA 2:3" />Wa Devid ọbạra utima ajunung p'aning abẹ, ọnạng-ọnạng ọttạra ẹchọhmfhạr chẹ, abẹ ata aruk k'ifhon s'Hẹbrọn. <verse eid="2SA 2:3" /><verse number="4" style="v" sid="2SA 2:4" />Wa ajunung p'Juda abin akwu k'Hẹbrọn, ma wọ, Devid abẹ abyeng-ẹ ana k'echo asi-ẹ ọvaarnạng kw'Juda.</para>
  <para style="p" vid="2SA 2:4">Masẹ abẹ akpaakhẹ Devid bẹ́ ajunung p'Jabẹsh-Gilead bọ annọhng Saul, <verse eid="2SA 2:4" /><verse number="5" style="v" sid="2SA 2:5" />Devid ukwu ọtọhm akpaakh-nkkaabha ọnạng ajunung p'Jabẹsh-Gilead bẹ́, “Tte Ọvaar Ubinọkpaabyi odo bạnga k'ọphyaam f'abạnga asi anạng aro kwabạnga Saul, s'abạnga annọhng-ẹ. <verse eid="2SA 2:5" /><verse number="6" style="v" sid="2SA 2:6" />Tte Ọvaar Ubinọkpaabyi usi bạnga ọphyaam, ọbạra ọkhọhkha bạnga idạdaakha. Amma m'mbạra nsi ọphyaam nnạng bạnga, ukwuru udik kw'abạnga asi maa. <verse eid="2SA 2:6" /><verse number="7" style="v" sid="2SA 2:7" />Ma o, abạnga akpọhkhọ ifor, abe <char style="it">bẹ́ gwuk</char> masẹ ajunung, s'Saul kw'ode aro kwabạnga kk'upua. Ẹgwọ usi ajunung p'Juda abyeng-m ana k'echo bẹ́, nde ọvaarnạng kwabẹ.”<verse eid="2SA 2:7" /></para>
  <para style="s1">Ekpong ch'anạng p'Devid ọttạra iva p'iva p'Saul</para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 2:8" />Ma okpe ngwọ, wa Abnẹr kw'ode nnwa kw'Nẹr, wọ ode ocho kw'akpongnạng p'Saul. Ẹma wọ ọtạk Ish-Boshẹt kw'ode nnwa kw'Saul, utima ojekha k'Mahanayim. <verse eid="2SA 2:8" /><verse number="9" style="v" sid="2SA 2:9" />Usi ẹ ọvaarnạng kw'Gilead, ọttạra Ashur, ọttạra p'Jẹzrẹl, ọttạra Ephraim, ọttạra Bẹnjamin, ọttạra p'ẹkhạma ch'Israẹl phyi-phyibh.<verse eid="2SA 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 2:10" />Wa Ish-Boshẹt kw'ode nnwa kw'Saul, ode icho arạbh afa s'ọtạm ẹvaar ch'Israẹl dạdạbh. Ukwu ọdạbhẹ bẹ k'icho ifa. Okhenka, wa efona ch'Juda etor ikhaana s'Devid. <verse eid="2SA 2:10" /><verse number="11" style="v" sid="2SA 2:11" />Wa Devid urukhu ma Hẹbrọn, masẹ ọvaarnạng, ọdạbhẹ Juda k'icho isenọfa ukuma aphye asajạnẹ.<verse eid="2SA 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 2:12" />Abnẹr kw'ode nnwa kw'Nẹr, ọttạra ajunung p'Ish-Boshẹt kw'ode nnwa kw'Saul, abin k'Mahanayim afona k'Gibeọn. <verse eid="2SA 2:12" /><verse number="13" style="v" sid="2SA 2:13" />Wa Joab kw'ode nnwa kw'Zẹruya, ọttạra ajunung p'Devid ata attạma ayok abẹ k'isipe ch'Gibeọn. Ikhaana rạnẹ ining ẹyạr k'ukhubha gwạnọ kw'isipe, nnọkha ininga k'ukhubha ngwọkha.<verse eid="2SA 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 2:14" />Ma wọ Abnẹr obeni Joab bẹ́, “Tte adikkobh pamạna bạnọ abina ayoma ayok mbọhk maa amạna k'ititikha.”</para>
  <para style="p" vid="2SA 2:14">Joab ọbẹ́, “Ujibhi ma! Tte abẹ ayoma.”<verse eid="2SA 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 2:15" />Mạnna wọ abẹ abhikhi anạng jobh-kamfa p'Bẹnjamin ọttạra Ish-Boshẹt, kw'ode nnwa kw'Saul. Abẹ abạra abhik anạng jobh-kamfa p'Devid. <verse eid="2SA 2:15" /><verse number="16" style="v" sid="2SA 2:16" />Ma o, ọnạng-ọnạng ubina, ọdạbh urima-nạng kwẹ ma echo, ukhum-ẹ ọkkangkkang-kkro k'atạtaang, abẹ atwạn atto, ape. Osenga ma, abẹ ayeri ibyi nnọ k'Gibeọn, Helkat-Hazurim<note caller="+" style="f"><char style="fr" closed="false">2.16 </char><char style="ft" closed="false">Helkat-Hazurim k'eHiburu, uyini, mkpạr nọ́ttaana. Okhenka, ọnnwẹr vạnọ obeni bẹ́, ọtọhnga ngwọ okke-okke uyin, isisek s'amaana-va, ọbạra uyin, isisek s'ẹkhọhr. </char></note>.<verse eid="2SA 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 2:17" />Wa ekpong ẹkhạmọ ma iwu njọ tạrr anạng p'Devid akhema anạng p'Abnẹr ọttạra anạng p'Israẹl.<verse eid="2SA 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 2:18" />Wa iva attaan p'Zeruya aning ma p'ade Joab, ọtttạra Abishayi, ọttạra Asahẹl. Asahẹl wa ogwengi masẹ otenwuru. <verse eid="2SA 2:18" /><verse number="19" style="v" sid="2SA 2:19" />Asahẹl ukhubhu Abnẹr, nnạm nọ́bhạkha bẹ́ ọkkeri k'udimbọhk, ọbạra ode k'ọkwabọhk. <verse eid="2SA 2:19" /><verse number="20" style="v" sid="2SA 2:20" />Abnẹr ọbhạkẹ nnạm ọbạbh bẹ́, “Asahẹl ọma wọ ma?”</para>
  <para style="p" vid="2SA 2:20">Asahẹl ubhina bẹ́, “Uwe e, amma wọ e.”<verse eid="2SA 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 2:21" />Abnẹr oben-ẹ bẹ́, “Kkeri k'udimbọhk kwọ, abạra akkeri k'ọkwabọhk, vạkha udikkobh wạnọ ekpong-kpo pyẹ ana.” Asahẹl ofona ororo ukhubh-ẹ masẹ ukhubh-ẹ ma.<verse eid="2SA 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 2:22" />Abnẹr ọbạra oben Asahẹl bẹ́, “Dạk kaam kkákhubh! Amma nạ́nnora bẹ́, mfhọ-ọ. De mfhọ-ọ m'nsenga yạn nkkeri nnwatte Joab k'ititikha o?”<verse eid="2SA 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 2:23" />Okhenka, Asahẹl nóchera bẹ́, ukuma Abnẹr khukhubh. Osenga ma, Abnẹr utima ẹkhọhn-ma chẹ ukhum Asahẹl k'ẹfhạr tạrr ọkhọhn uyin k'nnạm. Asahẹl otto, ope ma ibua-ibua. Ọnạng kwidede kw'ukpir ma s'Asahẹl uyim ope, m'obe ma k'ikpukpobha.<verse eid="2SA 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 2:24" />Okhenka, Joab ọttạra Abishayi akhubhu Abnẹr. Masẹ ududon n'ọsạk o, abẹ akwu akpira k'okpecho kw'Amma, kw'ọbaang Giya, k'ọkkaden kw'ọten k'ukhubha kw'anạng nạnárukha k'Gibeọn. <verse eid="2SA 2:24" /><verse number="25" style="v" sid="2SA 2:25" />Ma wọ ajunung p'Bẹnjamin abe atuma Abnẹr. Abẹ atobha k'ikhaana rạnẹ, ata abe k'okpecho k'erạng ado ifor sabẹ.<verse eid="2SA 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 2:26" />Abnẹr ukwu oyeri Joab oben-ẹ bẹ́, “Ma n'ode bẹ́, ekpong nja m'efona ororo n'irima tạrr ipimmanitor o? Ọma nákka bẹ́, ọkpicho kw'ekpong nja m'upyibh oseng eden o? M'ubhir ukpira yạn bạrasẹ aben anạng pọ akuma ivọkka pabẹ khukhubh o?”<verse eid="2SA 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2SA 2:27" />Joab ubhina bẹ́, “K'oche kw'Ubinọkpaabyi urukhu akpen, de wạra nạn ẹmạng násia, njanna wạra ajunung mbọ m'afona ororo akhubh ivọkka pabẹ tạrr iwu echobha.”<verse eid="2SA 2:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2SA 2:28" />Osenga ma, Joab oge ẹsa, utima oyeri ajunung pẹ phyibh bẹ́, abẹ akuma anạng p'Israẹl khukhubh, abẹ abạra akuma irima.<verse eid="2SA 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2SA 2:29" />Ma irungu njọ phyibh, Abnẹr ọttạra anạng pẹ aseng abaabha Araba, abẹ ajekha ọraanga kw'Jọrdan, asenga afona ororo ma ekpebha tạrr, akpira Mahanayim.<verse eid="2SA 2:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 2:30" />Ma wọ Joab n'ukum Abnẹr khukhubh, ukwu otobha akpongnạng pẹ phyibh. De akpẹrẹ Asahẹl ajẹ, akpongnạng sọnẹrạbh p'Devid bọ adimi-udimi. <verse eid="2SA 2:30" /><verse number="31" style="v" sid="2SA 2:31" />Okhenka, wa akpongnạng p'Devid kk'akpongnạng p'Bẹnjamin, anạng nạbh chi ukuma arạbh attaan p'atwạnọ Abnẹr abẹ, afha. <verse eid="2SA 2:31" /><verse number="32" style="v" sid="2SA 2:32" />Wa abẹ atạk Asahẹl annọhnga k'epekwur ch'otte kwẹ, k'Bẹtẹlẹhẹm. Ma wọ Joab ọttạra akpongnạng pẹ atim irungu njọ phyibh asi osenga tạrr, akpira k'Hẹbrọn s'iwu echobh.<verse eid="2SA 2:32" /></para>
  <chapter eid="2SA 2" />
  <chapter number="3" style="c" sid="2SA 3" />
  <para style="p">
    <verse number="1" style="v" sid="2SA 3:1" />Wa ekpong ch'iva p'iva p'Saul ọttạra anạng p'Devid, ining tạrr eden ibhir. Wa anạng p'Devid ado ẹfa akhaama-ọkhaama, okhenka, ẹfa efon ororo ẹsa iva p'iva p'Saul.<verse eid="2SA 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 3:2" />Wa abẹ amaanẹ ajunungva anạng Devid s'urukhu k'Hẹbrọn.</para>
  <para style="li1" vid="2SA 3:2">Ochedenwa okpen Amnọn kw'Ahinoam kw'ubin Jẹzrẹl ọmaanẹ;<verse eid="2SA 3:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="2SA 3:3" />ottong anạng afa okpen Kilẹab, kw'Abigẹl kw'ode opokwa kw'Nabal kw'ubin Kaamẹl ọmaanẹ.</para>
  <para style="li1" vid="2SA 3:3">Ottong attaan okpen Absalọm kw'ode nnwa kw'Maaka ọmaanẹ. Maaka wa ode nnwa kw'Talmayi, kw'ode ọvaarnạng kw'Gẹshur.<verse eid="2SA 3:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="2SA 3:4" />Ottong annebung okpen Adonija kw'ode nnwa kw'Hagit;</para>
  <para style="li1" vid="2SA 3:4">ottong asen okpen Shẹphatiya kw'ode nnwa kw'Abital.<verse eid="2SA 3:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="2SA 3:5" />Ottong asajạnẹ okpen Itreyam kw'ode nnwa kw'Ẹgla ọmaanẹ ọnạng Devid.</para>
  <para style="li1" vid="2SA 3:5">Iva mbọ bọ p'uwa abẹ amaanẹ anạng Devid k'Hẹbrọn.<verse eid="2SA 3:5" /></para>
  <para style="s1">Abnẹr ojek ottor Devid</para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 3:6" />K'okpe kw'iva p'iva p'Saul ọttạra anạng p'Devid atim arim-urima, Abnẹr n'utima okpe ngwọma odo ifor sẹ ẹfa gạge k'ikhaana s'iva p'iva p'Saul. <verse eid="2SA 3:6" /><verse number="7" style="v" sid="2SA 3:7" />Ma okpe ngwọ, Saul kk'oyok ọkhaama kw'okpen Rizpa, kw'ode ọkwanạngnwa kw'Aiya. Wa Ish-Boshẹt obeni Abnẹr bẹ́, “Asi yạn usi bạra ayima oyok kw'otte kwaam abẹ?”<verse eid="2SA 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 3:8" />Wa ettem ipyibhi Abnẹr, ukwuru udik kw'Ish-Boshẹt ọkpaakhẹ. Ma wọ ubhin bẹ́, “Amma nde ocho kw'ẹpfa ch'n'isi ọtọhm ẹnạng anạng p'Juda sa a? Chemma, amma m'nsạkha echo nnạng atte Saul, ọttạra efona chẹ, ọttạra ayok-ikhaana pẹ. Amma khọ ọbọhk tạm nạ́nttia nnạng Devid. Okhenka, ọma abạrẹ ettem abaar-m udik chemma ukwuru ikwanạng nwa. <verse eid="2SA 3:8" /><verse number="9" style="v" sid="2SA 3:9" />Tte Ọvaar Ubinọkpaabyi usi amma, Abnẹr oche kw'ọdaakh-ẹ, tte ọbạra usi-m ọttạra-ọttạra, de amma nạn ọttọhk f'Ubinọkpaabyi ochekhi ọnạng Devid nạ́nsia, <verse eid="2SA 3:9" /><verse number="10" style="v" sid="2SA 3:10" />s'Ubinọkpaabyi obeni bẹ́, m'ọtạkha ẹvaar ch'ọchọhm kw'Saul ọnạng Devid, s'm'utima ẹvaarchi ch'Devid arạnga k'Israẹl ọttạra Juda, tạma k'Dan tạrr ukpira k'Beershẹba.” <verse eid="2SA 3:10" /><verse number="11" style="v" sid="2SA 3:11" />Wa Ish-Boshẹt dạkhẹ Abnẹr udik gwạnọ-gwạnọ nókke ọpọhna, ukwuru s'ọrạbhọ Abnẹr.<verse eid="2SA 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 3:12" />Ma wọ, wa Abnẹr ọtọhmọ akpaakh-nkkaabha abẹ ata abạbh Devid bẹ́, “Isisek s'anẹ rọ maa? Ọma tạkha echekha amma abẹ, ọfha ntima efhonfhạr ch'Israẹl phyi-phyibh njekha ntor-ọ.”<verse eid="2SA 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 3:13" />Devid ọpọhna bẹ́, “Ujibhi ma, amma kk'echekha ntạkha ọma abẹ. Okhenka, tte mphyem-ọ udik gwạnọ, ọma khaam k'ititikha kábe, kw'oyongu bẹ́, m'atima Mikal, kw'ode ọkwanạngnwa kw'Saul atima akwu ase-m.” <verse eid="2SA 3:13" /><verse number="14" style="v" sid="2SA 3:14" />Ma wọ Devid ọtọhmọ akpaakh-nkkaabha k'Ish-Boshẹt kw'ode nnwa kw'Saul, oben bẹ́, “Abạnga anạng-m ikwanạng kwaam Mikal, kw'ntim mkpatwạr arạbh asen s'aPhilistiya ntạkha.”<verse eid="2SA 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 3:15" />Mạnna wọ Ish-Boshẹt ọnạngẹ ẹfa, abẹ arạbha Mikal k'ọbada kw'Paltiyẹl kw'ode nnwa kw'Laish, atima afona. <verse eid="2SA 3:15" /><verse number="16" style="v" sid="2SA 3:16" />Okhenka, udim ọtwạnọ abẹ n'ogạma ottor-ẹ nnạm tạrr abẹ akpira Bahurim. Ma wọ Abnẹr oben-ẹ bẹ́, “Ọma kpa nnạm abhạna!” Mạnna wọ ọkpa nnạm ọbhạna.<verse eid="2SA 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 3:17" />Wa Abnẹr oyeri adecho p'Israẹl oben bẹ́, “Okpe kk'ubhira kw'abạnga n'akhonga bẹ́, adạbh Devid ẹvaar. <verse eid="2SA 3:17" /><verse number="18" style="v" sid="2SA 3:18" />Okpe kk'obenga ttạng e! Abạnga m'asi oche ngwọ, khiri wa Ọvaar Ubinọkpaabyi ochekhi ọnạng Devid bẹ́, ‘Amma m'nsenga k'ọttọhmnạng kwaam Devid nkkaana anạng paam p'ade Israẹl k'mbọhk s'aPhilistiya, ọttạra k'mbọhk s'awawuna-nạng pabẹ phyibh.’ ”<verse eid="2SA 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 3:19" />Abnẹr ọbạra ọkpaak idik ọnạng anạng p'Bẹnjamin. Ma wọ ubin ofona k'Hẹbrọn bẹ́, ọta ọkpaak Devid udik kwidede kw'anạng p'Israẹl, ọttạra ẹchọhmfhạr ch'Bẹnjamin n'aben bẹ́, asi. <verse eid="2SA 3:19" /><verse number="20" style="v" sid="2SA 3:20" />K'okpe kw'Abnẹr utim ajunung pẹ otta okhebha Devid k'Hẹbrọn, Devid usi erobha ọnạng Abnẹr ọttạra ajunung pẹ. <verse eid="2SA 3:20" /><verse number="21" style="v" sid="2SA 3:21" />Ma wọ Abnẹr obeni Devid bẹ́, “Tte mfona mantọmma ọfha nta nttobha anạng p'Israẹl phyibh nchok aro kwaam kw'ode ọvaarnạng, ọfha abẹ atạkha echekha ọma abẹ, ọfha abạra ade ọvaarnạng kw'm'ọdạbh fidede ator k'oche kw'ẹkka chọ ede.” Ma wọ, Devid obeni Abnẹr ọbhạna k'idira.<verse eid="2SA 3:21" /></para>
  <para style="s1">Joab ọfhọ Abnẹr</para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 3:22" />Ma okpe nwa ma, anạng p'Devid ọttạra Joab akwuna ekpong, ọttạra ekpo-sabhaada py'abẹ achi. Okhenka, wa Abnẹr dạkhẹ Devid abẹ k'Hẹbrọn núninga, s'uwa Devid kk'e ọtọhma ọbhạna k'idira. <verse eid="2SA 3:22" /><verse number="23" style="v" sid="2SA 3:23" />Masẹ Joab ọttạra akpongnạng pẹ phyibh akpir, abẹ akpaakh-ẹ bẹ́, Abnẹr kw'ode ujunungnwa kw'Nẹr kk'ukwua k'ọvaarnạng, ọttạra bẹ́, ọvaarnạng kk'ẹ ọtọhma ọbhạna k'idira.<verse eid="2SA 3:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 3:24" />Ma wọ Joab ofon okhebha ọvaarnạng ọbạbh-ẹ bẹ́, “Bạng udik gwọ asi maa? Mmaang bẹ́, wạra Abnẹr ukwu maa, ukwuru yạn kw'attiẹ-ẹ ọbọhk ofona? Mantọmma, kk'ofona! <verse eid="2SA 3:24" /><verse number="25" style="v" sid="2SA 3:25" />Ọma asong ọnạng-khira kw'Abnẹr kw'ode nnwa kw'Nẹr ode ma? Ukwu bẹ́, ukwu ọbọhr-ọ, ọfha osonga osenga kwọ, ọbạra osonga udik kwidede kw'm'asi.”<verse eid="2SA 3:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 3:26" />Joab ubina urik Devid, ọttọhm akpaakh-nkkaabha abẹ akhubh Abnẹr ọkpa-nnạm. Abẹ avạkh-ẹ k'isipe ch'Sira atim-ẹ akpa nnạm. Okhenka, wa Devid udik ngwọ kósong. <verse eid="2SA 3:26" /><verse number="27" style="v" sid="2SA 3:27" />Ma o, masẹ Abnẹr ọkpa nnạm k'Hẹbrọn, Joab utim-ẹ ọnwa k'ẹmaanggọ, usi aben bẹ́, n'oben bẹ́ ọkkaabh-ẹ udik. Joab ukhum-ẹ imaana k'ẹfhạr, ope, utima otera obo kw'nnwọkka kwẹ, Asahẹl.<verse eid="2SA 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2SA 3:28" />Masẹ Devid ọbhaang udik ngwa, oben bẹ́, “K'ititikha s'Ọvaar Ubinọkpaabyi, mbọhk saam ọttạra s'anạng p'amma ndạbhẹ kíde k'obo kw'Abnẹr kw'ode nnwa kw'Nẹr. <verse eid="2SA 3:28" /><verse number="29" style="v" sid="2SA 3:29" />Tte isẹ s'Abnẹr itwạn Joab abẹ, ọttạra ẹchọhmfhạr chẹ phyibh! Tte ẹchọhmfhạr ch'Joab nạngẹ ọnạng eworu kw'ọkhaam ọyaakha-fhok, ọttạra okpokhora, ọttạra ọnạng kw'n'utima ichi osenga, ọttạra kw'm'ope k'ọkkangkkang-kkro, ọttạra kw'oworu uchiattọhk.”<verse eid="2SA 3:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 3:30" />(Wa Joab ọttạra nnwọkka Abishayi afhọ Abnẹr, ukwuru s'kk'nnwotte kwabẹ Asahẹl ọfha k'ekpong ch'abẹ arim k'Gibeọn.)<verse eid="2SA 3:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="2SA 3:31" />Ma wọ Devid obeni Joab ọttạra anạng phyibh p'atwạnọ abẹ bẹ́, “Abạnga ayaakhẹ ọvạra f'abạnga age k'ifor, age ọvạra bina, abạnga atima nkwuna s'Abnẹr.” Ọvaar Devid ẹma oseng otor ikwukwur s'itọhk apfura nnạm. <verse eid="2SA 3:31" /><verse number="32" style="v" sid="2SA 3:32" />Wa abẹ annọhng Abnẹr ma Hẹbrọn. Ọvaar Devid ọgạm ẹmạng k'ẹrạng-k'ẹrạng k'epekwur ch'Abnẹr. Mạnna wọ anạng phyibh agạm.<verse eid="2SA 3:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="2SA 3:33" />Ọvaar Devid ọkkọhnọ ebomạng ọnạng Abnẹr bẹ́,</para>
  <para style="q1" vid="2SA 3:33">“Ma ọbaan kha bẹ́, Abnẹr ope masẹ udindingi-nạng?<verse eid="2SA 3:33" /></para>
  <para style="q2">
    <verse number="34" style="v" sid="2SA 3:34" />Abẹ mbọhk sọ nádạbha,</para>
  <para style="q2" vid="2SA 3:34">Abẹ khọ mgbakkọhbhọ k'mfhok nákpa,</para>
  <para style="q1" vid="2SA 3:34">akwu ape masẹ ọnạng kw'ope k'mbọhk s'abyibyanạng.”</para>
  <para style="p" vid="2SA 3:34">Anạng agạma adạkhẹ k'ẹrạng-k'ẹrạng.<verse eid="2SA 3:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="2SA 3:35" />Ma wọ abẹma phyibh akwu achini Devid bẹ uchi ọttọhk s'iwu itim ining, okhenka, wa Devid ochekhi oben bẹ́, “Tte Ubinọkpaabyi ọfhọ-m, de amma ndạnẹ ọttọhk fidede maa akhaam k'ẹmma bạrasẹ iwu n'ẹsa!”<verse eid="2SA 3:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="2SA 3:36" />Wa anạng mbọ phyibh p'aning ma age udik ngwọ utum, akwẹ ọbạra orebh bẹ ettem. K'udik ọkka, udik kwidede kw'ọvaarnạng usi, orebhi bẹ ettem. <verse eid="2SA 3:36" /><verse number="37" style="v" sid="2SA 3:37" />Osenga ma, ma iwu njọ jọ ch'anạng p'Juda phyi-phyibh, ọttạra anạng p'Israẹl phyibh asong bẹ́, ọbọhk kw'ọvaar Devid k'obo kw'Abnẹr kw'ode nnwa kw'Nẹr kòde.<verse eid="2SA 3:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="2SA 3:38" />Ma wọ ọvaarnạng obeni anạng pẹ bẹ́, “Node bẹ́, abạnga kásong bẹ́, nnwa kw'ọvaarnạng ọttạra ọfanạng kwididen wọ ope chemma k'Israẹl o? <verse eid="2SA 3:38" /><verse number="39" style="v" sid="2SA 3:39" />Chemma nwa, chibhi s'ode bẹ́, amma wọ nde ọvaarnạng kw'abẹ abyeng ana k'echo, ifor imạm-m o. Ajunung mba p'ade iva p'Zeruya akhaam ẹfa ayọhng-m. Tte Ọvaar Ubinọkpaabyi utwuk ipyibha ch'upyibhanạng otor k'usisi kwẹ!”<verse eid="2SA 3:39" /></para>
  <chapter eid="2SA 3" />
  <chapter number="4" style="c" sid="2SA 4" />
  <para style="s1">Obo kw'Ish-Boshẹt</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 4:1" />Masẹ Ish-Boshẹt kw'ode nnwa kw'Saul ọbhaang bẹ́, Abnẹr kk'upua k'Hẹbrọn, ẹfa ẹsẹ-ẹ. Efhonfhạr ch'Israẹl phyibh ininga k'ojora. <verse eid="2SA 4:1" /><verse number="2" style="v" sid="2SA 4:2" />Wa nnwa kw'Saul ọkhaam ajunungva afa p'uwa ade adecho p'arim-ekpong. Wa oyok wạnọ okpen Baana, nwọkha okpena Rekab. Wa abẹ ade iva p'Rimọn kw'ubin Berot, k'ẹkhạma ch'Bẹnjamin. Wa abẹ n'atạkha Berot attạra k'ifhon s'isi ẹkhạma ch'Bẹnjamin, <verse eid="2SA 4:2" /><verse number="3" style="v" sid="2SA 4:3" />ukwuru s'uwa anạng p'Berot arạbhọ afona k'Gittayim, ata aruk mạma masẹ akhikhennạng tạrr ukpira k'iwu ch'chemma.<verse eid="2SA 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 4:4" />(Wa Jonatan kw'ode nnwa kw'Saul ọkhaam ujunungnwa kw'ọphyạkhẹ mkpẹtẹ. Nnwa nwọ wa ode icho isen k'okpe kw'abẹ atim ẹkkaabha ch'obo kw'Saul ọttạra Jonatan k'Jẹzrẹl akwu. Wa ọrạrạkha kwẹ udir-ẹ bẹ́, utima abẹ ọrạbh. Okhenka, masẹ n'udwukha bẹ́ utim-ẹ ofona o, nnwa nwọ ọnnaang-ẹ otto, ọphyạkhẹ mfhok. Wa okpen Mẹphiboshẹt.)<verse eid="2SA 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 4:5" />Ma wọ Rekab ọttạra Baana p'ade iva p'Rimọn p'abin Berot, abin afona k'ọchọhm kw'Ish-Boshẹt. Wa abẹ akpir kha k'ọyakpattem k'okpe kw'Ish-Boshẹt n'okwokha ọyọhng. <verse eid="2SA 4:5" /><verse number="6" style="v" sid="2SA 4:6" />Abẹ anwa k'ọchọhm etaanga aben bẹ́ abẹ ata awit tạtạkha, abẹ akhum-ẹ imaana k'ẹfhạr, afhẹ-ẹ. Rekab ọttạra nnwọkka Baana arạbh afona.<verse eid="2SA 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 4:7" />Masẹ abẹ kk'anwa k'ọchọhm, abẹ afona k'ẹmaanggọ ch'Ish-Boshẹt akhebh-ẹ s'utim uyim k'ibhikha, akhum-ẹ afhọ. Abẹ akpaar-ẹ echo atima chẹ asenga k'ukhubha kw'Araba ma irungu njọ afona. <verse eid="2SA 4:7" /><verse number="8" style="v" sid="2SA 4:8" />Abẹ atạk echo ch'Ish-Boshẹt akkena Devid k'Hẹbrọn, aben ẹma ọvaarnạng bẹ́, “Kkeri echo ch'Ish-Boshẹt maa kw'ode nnwa kw'ọwawuna-nạng kwọ kw'ode Saul, kw'ọkhạmọ bẹ́, ọfhọ-ọ. Chemma, Ọvaar Ubinọkpaabyi kk'udik ngwa utwukha k'Saul ọttạra iva p'iva pẹ k'echo ch'aro kwaam, kw'ode ọvaarnạng.”<verse eid="2SA 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 4:9" />Okhenka, Devid ọpọhn Rekab ọttạra nnwọkka Baana p'ade iva p'Rimọn, kw'ubin Berot bẹ́, “K'oche Ọvaar Ubinọkpaabyi kw'ọrạbh-m k'dạma-dạma kwidede urukhu akpen, <verse eid="2SA 4:9" /><verse number="10" style="v" sid="2SA 4:10" />okpe kw'ọnạng ukwu otekh-m bẹ́, Saul kk'upua, s'ọkkẹ bẹ́, ọnạng-m ẹkkaabha ọkkachẹ, wa mvạkh-ẹ mfhọ k'ofhon kw'Ziklag. Ẹtaam ch'uwa nsi-ẹ k'ẹkkaabha chẹ jọ ma! <verse eid="2SA 4:10" /><verse number="11" style="v" sid="2SA 4:11" />M'ntera nsi nyọhng-ọyọhnga, k'okpe kw'abyibyanạng akhebh ọnạng kw'otor-otor k'ibhikha, k'akhẹ k'ọchọhm, afhọ. Ọbaan bẹ́, nnor isẹ s'ọnạng nwọ mbạbh bạnga, mbạra ndimi bạnga ma ọyagbin nwa!”<verse eid="2SA 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 4:12" />Ma wọ Devid ọnạngẹ anạng pẹ ẹfa bẹ́, abẹ afhọ bẹ. Wa abẹ akpaar mbọhk ọttạra mfhok sabẹ, atạkha sẹ akpạna abaanga isipe ch'Hẹbrọn. Okhenka, wa abẹ atạk echo ch'Ish-Boshẹt atta annọhnga k'epekwur ch'Abnẹr kha Hẹbrọn.<verse eid="2SA 4:12" /></para>
  <chapter eid="2SA 4" />
  <chapter number="5" style="c" sid="2SA 5" />
  <para style="s1">Devid ọdạbhẹ ẹvaar ch'Israẹl</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 5:1" />Wa nkhạma s'Israẹl phyi-phyibh ikwu ikhebha Devid k'Hẹbrọn iben bẹ́, “Amạna mba ande anạng pọ oyeni e. <verse eid="2SA 5:1" /><verse number="2" style="v" sid="2SA 5:2" />K'okpe kw'kk'osenga, kw'uwa Saul ọdạbhẹ mạna, ọma wọ wa n'achi eden k'anạng p'Israẹl k'mkpong. Wa Ọvaar Ubinọkpaabyi oben-ọ bẹ́, ‘Ọma wọ ade ọnạng kw'm'okkeri anạng paam Israẹl, abạra ade ọvaarnạng kwabẹ.’ ”<verse eid="2SA 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 5:3" />Masẹ adennạng p'Israẹl phyibh kk'ọvaar Devid akhebha k'Hẹbrọn, ọvaar Devid usi echekha ọttạra bẹ k'Hẹbrọn ma ititikha s'Ọvaar Ubinọkpaabyi. Wa abẹ abyeng Devid ana k'echo asi-ẹ ọvaarnạng kw'Israẹl.<verse eid="2SA 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 5:4" />Wa Devid ode icho ẹrạbh ukuma jobh k'okpe kw'ọdạbhẹ ẹvaar. Wa ọdạbhẹ ẹvaar k'icho arạbh afa. <verse eid="2SA 5:4" /><verse number="5" style="v" sid="2SA 5:5" />K'Hẹbrọn, Devid ọdạbhẹ Juda k'icho isenọfa ọmaana aphye asaajạnẹ, ọbạra ọdạbh Israẹl ọttạra Juda k'Jẹrusalẹm phyi-pyibh k'icho ẹrạbh ukuma jobh-kanttaan.<verse eid="2SA 5:5" /></para>
  <para style="s1">Devid okhem anạng p'Jẹrusalẹm</para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 5:6" />Ọvaarnạng ọttạra anạng pẹ aseng afona k'Jẹrusalẹm bẹ́, abẹ ata arima aJẹbus p'uwa arukhu ma, abẹ. AJẹbus aben Devid bẹ́, “Maa mánwa. Akpachen ọttạra aphyạk-mkpẹtẹ bọ m'atera akhubh-ọ.” Wa abẹ akkẹ bẹ́, abẹ m'akke-okke akpa Devid eden. <verse eid="2SA 5:6" /><verse number="7" style="v" sid="2SA 5:7" />Oseng ma, Devid ọvạk ibyittubhasẹ sabẹ s'Ziyọn, kw'ode efhon-diden kw'Devid.<verse eid="2SA 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 5:8" />Ma iwu njọ, Devid kk'obena bẹ́, “Ọnạng kwidede kw'm'okhema aJẹbus, ọbaan bẹ́ osenga k'efhobh ọkhaan-ọkhaan, okhebha ‘aphyạk-mkpẹtẹ ọttạra akpachen’ p'ade awawuna-nạng p'Devid.” Akwẹma gwọ usi abẹ n'aben bẹ́, “Akpachen ọttạra aphyạk-mkpẹtẹ k'ọvaarchọhm mánwa.”<verse eid="2SA 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 5:9" />Ma wọ Devid n'urukhu k'ibyittubhasẹ k'Ziyọn, oyeri ibyi nnọ efhon-diden ch'Devid. Wa usi efhon-diden njọ ọkhạbh-ọkhạbha, tạma k'egbo tạrr ukpira k'ẹtaanga. <verse eid="2SA 5:9" /><verse number="10" style="v" sid="2SA 5:10" />Devid n'odo ẹfa ọkhaama-ọkhaama, ukwuru s'Ọvaar Ubinọkpaabyi, kw'ode Ubinọkpaabyi kw'Ẹfa phyibh uning abẹ.<verse eid="2SA 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 5:11" />Ma wọ Hiram kw'ode ọvaarnạng kw'Tyrẹ ọtọhmọ akpaakh-ẹkkaabha pẹ k'Devid, p'ọnạngẹ mkpaakha s'sida, ọttạra agwọhr-mkpaakha, ọttạra ammun-ichọhm bẹ́, abẹ ata ammun udimpa anạng Devid. <verse eid="2SA 5:11" /><verse number="12" style="v" sid="2SA 5:12" />Osenga ma, Devid utin bẹ́, Ọvaar Ubinọkpaabyi kk'ẹ ẹrạnga uttima masẹ ọvaarnạng kw'Israẹl, ọttạra bẹ́, kk'ọvaarfhon kwẹ abạrada ọnạnga ukwuru anạng pẹ Israẹl.<verse eid="2SA 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 5:13" />Masẹ Devid ubin k'Hẹbrọn, ọkhaam ayok k'ọsaabh, ọttạra ipanạng p'ọtạk-ọtạkha k'Jẹrusalẹm. Wa abẹ amaan-ẹ ajunungva ọttạra apanạngva k'ọsaabh. <verse eid="2SA 5:13" /><verse number="14" style="v" sid="2SA 5:14" />Maa wọ ode ache p'iva p'uwa ofhonu k'Jẹrusalẹm: Shammua, ọttạra Shobab, ọttạra Natan, ọttạra Sọlọmọn, <verse eid="2SA 5:14" /><verse number="15" style="v" sid="2SA 5:15" />ọttạra Ibha, ọttạra Ẹlishua, ọttạra Nẹphẹg, ọttạra Japhiya, <verse eid="2SA 5:15" /><verse number="16" style="v" sid="2SA 5:16" />ọttạra Elishama, ọttạra Ẹliyada, ọttạra Ẹliphẹlẹt.<verse eid="2SA 5:16" /></para>
  <para style="s1">Devid okhem aPhilistiya</para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 5:17" />Masẹ aPhilistiya abhaang bẹ́, abẹ kk'Devid ana abyenga k'echo asi-ẹ ọvaarnạng kw'Israẹl, abẹ abina k'ẹfa ata aror Devid bẹ́, abẹ avạkha. Wa Devid ọbhaang kwẹ, ubina ọsạkha k'ibyittubhasẹ. <verse eid="2SA 5:17" /><verse number="18" style="v" sid="2SA 5:18" />Oche ngwọ gwọ kw'aPhilistiya anwa, anyaamẹ k'ipekhuma s'Rephayim. <verse eid="2SA 5:18" /><verse number="19" style="v" sid="2SA 5:19" />Ma wọ wa Devid ọta ọdwạn Ọvaar Ubinọkpaabyi ọbạbh-ẹ bẹ́, “Ma n'nta nnima aPhilistiya abẹ o? S'm'atte bẹ ọbọhk anạng-m?”</para>
  <para style="p" vid="2SA 5:19">Ọvaar Ubinọkpaabyi ọpọhn-ẹ bẹ́, “Sọhng, khiri k'udik ọkka, m'ntte aPhilistiya ọbọhk otte nnạng-ọ.”<verse eid="2SA 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 5:20" />Ma wọ Devid ubin ofona k'Baal-Pẹrazim, ọta okhema bẹ ma. Oben bẹ́, “Oche ngwọ kw'asi n'amaam, mạnna wọ kw'Ọvaar Ubinọkpaabyi ọmaamẹ k'ibyi s'awawuna-nạng paam k'akhaam k'ititikha.” Osenga ma, oyeri ibyi nnọ Baal-Pẹrazim. <verse eid="2SA 5:20" /><verse number="21" style="v" sid="2SA 5:21" />Wa aPhilistiya arạbhọ arik ikha sabẹ ma, Devid ọttạra anạng pẹ atima sẹ afona.<verse eid="2SA 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 5:22" />APhilistiya abạra ayin adạkhẹ, anyaamẹ k'Ipekhuma s'Rephayim. <verse eid="2SA 5:22" /><verse number="23" style="v" sid="2SA 5:23" />Ma wọ, Devid ọbạra ọdwạn Ọvaar Ubinọkpaabyi, Ọvaar Ubinọkpaabyi ọpọhn-ẹ bẹ́, “Abạnga <char style="it">bẹ́ gbẹng</char> kásenga avura, okhenka, asenga nnạm-nnạm abaabha bẹ age k'ngekha. Arima bẹ abẹ ma ititikha s'nchi s'balsam. <verse eid="2SA 5:23" /><verse number="24" style="v" sid="2SA 5:24" />De abạnga abhaang ntwạkhọ s'n'isenga k'ẹrạng-ẹrạng kw'nchi s'balsam <char style="it">bẹ́ ẹ,</char> asenga ẹbhạr-ẹbhạrẹ khiri ma wọ uyini bẹ́, Ọvaar Ubinọkpaabyi k'bạnga eden uchia bẹ́, ọta ọfhọ akpongnạng p'aPhilistiya.” <verse eid="2SA 5:24" /><verse number="25" style="v" sid="2SA 5:25" />Ma wọ Devid usi oche kw'Ọvaar Ubinọkpaabyi kk'ẹ ọtọhna. Ọfhọ aPhilistiya tạma k'Gibeọn tạrr ukpira k'Gẹzẹr.<verse eid="2SA 5:25" /></para>
  <chapter eid="2SA 5" />
  <chapter number="6" style="c" sid="2SA 6" />
  <para style="s1">Abẹ atim Ikwukwur s'Echekha ch'Ubinọkpaabyi afona k'Jẹrusalẹm</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 6:1" />Wa Devid ọbạra ọtọhbha adikkobh p'Israẹl p'akpọhkhọ ifor, anạng nnọhna arạbh attaan ukuma chi. <verse eid="2SA 6:1" /><verse number="2" style="v" sid="2SA 6:2" />Ẹma Devid ọttạra ajunung pẹ phyibh asengi afona k'Baala, k'ẹkhạma ch'Juda bẹ́, abẹ ata atạkha Ikwukwur s'Echekha ch'Ubinọkpaabyi atima akwu. Abẹ n'ayeri ikwukwur nnọ k'eche ch'Ọvaar Ubinọkpaabyi kw'Ẹfa phyibh, kw'ọnạn ẹvaar-ẹvaar k'ottemkwẹ kw'chẹrubim k'Ikwukur nnọ s'Echekha. <verse eid="2SA 6:2" /><verse number="3" style="v" sid="2SA 6:3" />Abẹ atạk Ikwukwur s'Echekha ch'Ubinọkpaabyi anạna k'ọkpaar kw'nnyạnyaang n'itwạr, kw'utim ode ọbhakwẹ, atima sẹ abina k'ọchọhm kw'Abinadab, kw'uning k'okpecho. Uza ọttạra Ahiyo p'ade iva p'Abinadab bọ wa n'akkeri ọkpaar ngwọ ọbhakwẹ, <verse eid="2SA 6:3" /><verse number="4" style="v" sid="2SA 6:4" />ọttạra Ikwukwur s'Echekha ch'Ubinọkpaabyi sabẹ anạn ma, wa Ahiyo n'osenga k'ititikha s'ọkpaar ngwọ. <verse eid="2SA 6:4" /><verse number="5" style="v" sid="2SA 6:5" />Wa Devid ọttạra anạng p'Israẹl phyi-phyibh atim ọkkọhna, ọttạra abukpọhng, ọttạra agimangim, ọttạra agaang-gang, ọttạra ekpo ikhirapẹ p'ichi ẹkkachẹ, ọttạra achang-kpakpa, atima ẹfa chabẹ phyibh n'asi erobha k'ititikha s'Ọvaar Ubinọkpaabyi.<verse eid="2SA 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 6:6" />K'okpe kw'abẹ akpir k'ibyi sabẹ n'aninga ayuk abarli-mạma k'Nakọn, Uza onemi ọbọhk ọvạkha Ikwukwur s'Echekha ch'Ubinọkpaabyi, s'mmaam n'iben bẹ́ ikpena itto. <verse eid="2SA 6:6" /><verse number="7" style="v" sid="2SA 6:7" />Ettem ipyibhi Ọvaar Ubinọkpaabyi otenạ Uza ukwuru s'ose Ubinọkpaabyi ẹsẹkha. Ma wọ Ubinọkpaabyi uvun-ẹ ọfhọ, otto k'ọkhaan-ọkhaan kw'Ikwukwur s'Echekha ch'Ubinọkpaabyi, ope.<verse eid="2SA 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 6:8" />Ma wọ Devid ọdwạkhẹ ukwuru idwạdwạkhọ s'Ọvaar Ubinọkpaabyi utim ọtor Uza. Tạma ma iwu njọ kpira chemma, abẹ n'ayeri ibyi nnọ Pẹrẹz-Uza.<note caller="+" style="f"><char style="fr" closed="false">6.8 </char><char style="ft" closed="false">Pẹrẹz-Uza, k'eHiburu uyini irem s'Uza.</char></note><verse eid="2SA 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 6:9" />Ma iwu njọ, Devid ọkhaama ojora f'Ọvaar Ubinọkpaabyi, oben bẹ́, “Ikwukwur s'Echekha ch'Ọvaar Ubinọkpaabyi bạra isenga yạn itor-m o?” <verse eid="2SA 6:9" /><verse number="10" style="v" sid="2SA 6:10" />Wa Devid dạkhẹ ifor núdia, bẹ́, ọtạkha Ikwukwur s'Echekha ch'Ọvaar Ubinọkpaabyi ukwuna k'efhon-diden kw'Devid. Otera utima sẹ ofona k'ọchọhm kw'Ọbẹd-Edom kw'ubin Git. <verse eid="2SA 6:10" /><verse number="11" style="v" sid="2SA 6:11" />Wa Ikwukwur s'Echekha ch'Ọvaar Ubinọkpaabyi ining k'ọchọhm kw'Ọbẹd-Edom kw'ubin Git k'aphye attaan. Ma wọ Ọvaar Ubinọkpaabyi odo Ọbẹd-Edom ọttạra ẹchọhmfhạr chẹ phyibh.<verse eid="2SA 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 6:12" />Ma wọ abẹ akpaakhẹ ọvaar Devid bẹ́, “Ọvaar Ubinọkpaabyi kk'ẹchọhmfhạr ch'Ọbẹd-Edom udia, ọttạra ọttọhk fidede f'ode pfẹ, ukwuru Ikwukwur s'Echekha ch'Ọvaar Ubinọkpaabyi e.” Wa Devid utim erobha ofona ọta ọtạkha Ikwukwur s'Echekha ch'Ọvaar Ubinọkpaabyi k'ọchọhm kw'Ọbẹd-Edom, utima ukwu k'ofhon-diden kw'Devid. <verse eid="2SA 6:12" /><verse number="13" style="v" sid="2SA 6:13" />K'okpe kw'anạng p'attọhk Ikwukwur s'Echekha ch'Ọvaar Ubinọkpaabyi kk'ntwạkhọ nsajạnẹ asenga, Devid ọtạkha ẹbhaamdim ọttạra ọbhaamnwa, utima ọfọhnọ ẹja. <verse eid="2SA 6:13" /><verse number="14" style="v" sid="2SA 6:14" />Wa Devid oge ẹphọd oyokhakwẹ, utima ẹfa chẹ phyibh utubh ibin k'ititikha s'Ọvaar Ubinọkpaabyi. <verse eid="2SA 6:14" /><verse number="15" style="v" sid="2SA 6:15" />Ẹma Devid, ọttạra anạng p'Israẹl phyi-phyibh atim ọkkọhna ọttạra abukpọhng, atima Ikwukwur s'Echekha ch'Ọvaar Ubinọkpaabyi awuna.<verse eid="2SA 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 6:16" />Oche ngwọ kw'abẹ n'atima Ikwukwur s'Echekha ch'Ọvaar Ubinọkpaabyi anwa k'ofhon-diden kw'Devid o, Mikal kw'ode uminanwa kw'Saul obe kha ọmma kw'ufhum n'ose. Masẹ ose s'Devid n'ogbe akwura, ọbạra utubh ibin k'ititikha s'Ọvaar Ubinọkpaabyi, Devid obe ma, ọbạkh-ẹ idik.<verse eid="2SA 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 6:17" />Abẹ atima Ikwukwur s'Echekha ch'Ọvaar Ubinọkpaabyi akwu attima k'ibyi s'asẹ ibaan bẹ́ ininga, s'ide ukkira kw'Devid kk'usia ochok sẹ. Wa Devid ọfọhnọ nja ikkạmasẹ, ọttạra nnạnga s'ẹmẹm ọnạng Ọvaar Ubinọkpaabyi. <verse eid="2SA 6:17" /><verse number="18" style="v" sid="2SA 6:18" />Masẹ Devid kk'nja ikkạmasẹ ọtttạra s'ẹmẹm ọfọhna phyibh, odo anạng mbọ k'eche ch'Ọvaar Ubinọkpaabyi kw'Ẹfa phyibh. <verse eid="2SA 6:18" /><verse number="19" style="v" sid="2SA 6:19" />Ma wọ ọtạk brẹd, ọttạra nten ichẹkhasẹ, ọttạra k'atwuk p'agrep p'agwu-ugwu, ọnạng ọnạng-ọnạng, ajunung ọttạra ipanạng ma ikhaana s'anạng p'Israẹl phyi-phyibh. Mạnna wọ ọnạng-ọnạng ubin ọbhạna k'akhẹ k'ọchọhm.<verse eid="2SA 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 6:20" />K'okpe kw'Devid n'ukwun bẹ́, ukwu odo ẹchọhmfhạr chẹ, Mikal kw'ode uminanwa kw'Saul uyini okhebh-ẹ k'iyaan, oben bẹ́, “Chemma oyeni, ọvaarnạng kw'Israẹl kk'ifor sẹ okpobha. N'oseng irinikhum k'ititikha s'aminava p'atọhmnạng p'ikhaana sẹ, masẹ udindingi-nạng!”<verse eid="2SA 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 6:21" />Devid oben Mikal bẹ́, “Amma n'nsi erobha k'ititikha s'Ọvaar Ubinọkpaabyi kw'ọkpẹrẹ atte ọttạra ẹchọhmfhạr chẹ ọjẹ, k'okpe kw'oreng-m bẹ́, ndạbh anạng p'Israẹl, p'ade anạng p'Ọvaar Ubinọkpaabyi. <verse eid="2SA 6:21" /><verse number="22" style="v" sid="2SA 6:22" />Amma kk'ifor ndia bẹ́ ntubh idindingi ch'ẹyọhng nja, mbạra nsạkha ifor saam ininga. Okhenka, k'ititikha s'aminava mbọ p'ade attọhmnạng p'akpaakhẹ udik akwuru, abẹ m'anạng-m ikpukpobha ọnạng e.”<verse eid="2SA 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 6:23" />Wa Mikal, kw'ode uminanwa kw'Saul, nnwa nọ́maana tạrr okhebha ma, ope.<verse eid="2SA 6:23" /></para>
  <chapter eid="2SA 6" />
  <chapter number="7" style="c" sid="2SA 7" />
  <para style="s1">Echekha ch'Ubinọkpaabyi ọtạk ọnạng Devid</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 7:1" />K'okpe kw'uwa ọvaar Devid kk'ẹyạr ọvạkha k'akhẹ k'ọvaarter, Ọvaar Ubinọkpaabyi ọbạra usi ẹ uruk k'ẹmẹm ọttạra awawunanạng pẹ phyibh p'abaabh-ẹ ọbaabha. <verse eid="2SA 7:1" /><verse number="2" style="v" sid="2SA 7:2" />Wa ọvaarnạng obeni Natan kw'ode usi-ẹyaakha kw'Ubinọkpaabyi bẹ́, “Kker e, amma nnukhu k'ọvaarchọhm kw'abẹ atim mkpaakha s'sida asi k'okpe kw'Ikwukwur s'Echekha ch'Ubinọkpaabyi itim ining k'ukkira.”<verse eid="2SA 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 7:3" />Natan ubhina ọvaarnạng bẹ́, “Fona ororo si udik kwidede kw'ubin-ọ k'ettem, khiri Ọvaar Ubinọkpaabyi uning abọ ma.”<verse eid="2SA 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 7:4" />Ma irunguchẹ njọ, ọkpaakha-dik kw'Ọvaar Ubinọkpaabyi ukpir Natan, oben bẹ́,<verse eid="2SA 7:4" /></para>
  <para style="pm">
    <verse number="5" style="v" sid="2SA 7:5" />“Sọhng ata akpaak ọtọhmnạng kwaam Devid bẹ́, ‘Amma Ọvaar Ubinọkpaabyi mbeni bẹ́ ọma sạng kw'm'asi ọchọhm kw'amma m'nnuk e. <verse eid="2SA 7:5" /><verse number="6" style="v" sid="2SA 7:6" />Amma k'ọchọhm tạm nạ́nnukha tạma k'iwu ch'ntim anạng p'Israẹl mbina k'Ijip, tạrr ukpira maa iwu ch'chemma. Amma n'nnuk k'ibyi-k'ibyi k'ukkira m'asẹ ọchọhm kwaam. <verse eid="2SA 7:6" /><verse number="7" style="v" sid="2SA 7:7" />Wa nnạngẹ adạbhẹ p'nkhạma s'Israẹl ẹfa bẹ́, abẹ atima anạng pabẹ eden masẹ akkeri-arạkhạmaan atim arạkhạmaan pabẹ eden. Amma kk'bẹ abẹ nsenga k'ibyi-k'ibyi, mbạra mming bẹ abẹ k'akkira. Bạng okpe gwọ kw'uwa amma kk'adạbhẹ mbọ mbena bẹ́ udik kw'abẹ nạn ọchọhm kw'mkpaakha s'sida násia anạng-m?’ ”<verse eid="2SA 7:7" /></para>
  <para style="pm">
    <verse number="8" style="v" sid="2SA 7:8" />“Ma wọ m'akpaak ọtọhmnạng kwaam Devid bẹ́, ‘Ọvaar Ubinọkpaabyi kw'Ẹfa phyibh obeni bẹ́, amma ntạkhọ k'ekpa s'n'akkeri itirakpo, nkwu nsi-ọ ọdạbhẹ kw'anạng paam, Israẹl. <verse eid="2SA 7:8" /><verse number="9" style="v" sid="2SA 7:9" />Amma kk'abọ nninga k'ibyi sidede s'kk'ata, mbạra nnạbh-ọ k'mbọhk s'awawunanạng pọ phyibh p'n'arima abọ. Ma wọ nkwu nsi-ọ ayin eche masẹ eche ch'anạng p'ayini eche ọtạm maa k'ọyagbin. <verse eid="2SA 7:9" /><verse number="10" style="v" sid="2SA 7:10" />Amma nnạngẹ anạng paam Israẹl ibyi, mbạra nttima bẹ arạnga, ọfha abẹ asenga ma akhaama ibyirukhasẹ sabẹ, ọfha ọnạng nạngẹ adạkhẹ bẹ ẹmma ọphyaangẹ. Abyibyanạng dạkhẹ bẹ irem mánạng k'oche kw'uwa abẹ n'asi bẹ kanạma, <verse eid="2SA 7:10" /><verse number="11" style="v" sid="2SA 7:11" />ọttạra k'okpe kw'ntek asi-aponga p'anạng paam, Israẹl. Amma m'mbạra nsi-ọ aninga k'ẹmẹm ọttạra awawunanạng pọ phyibh.</para>
  <para style="pm" vid="2SA 7:11">“ ‘Ọvaar Ubinọkpaabyi ọyaakhẹ bẹ́ ẹma Ọvaar Ubinọkpaabyi oyeni wọ m'uttima ẹchọhmfhạr chọ arạnga ọnạng ọ. <verse eid="2SA 7:11" /><verse number="12" style="v" sid="2SA 7:12" />K'okpe kw'iwu sọ kk'ittonga maa ọyagbin, ata akwokha ọyọhng ọttạra ab'otte pọ, m'nnengi nnwa wạnọ k'ikhaana s'iva pọ, kw'ode isẹ sọ oyeni, mbạra nttima ọvaarfhon kwẹ arạnga. <verse eid="2SA 7:12" /><verse number="13" style="v" sid="2SA 7:13" />Ẹma wọ m'usi ọchọhm ọnạng-m. Amma m'mbạra nttima ẹvaar ch'ọvaarfhon kwẹ arạnga tạrr ipimmanitor. <verse eid="2SA 7:13" /><verse number="14" style="v" sid="2SA 7:14" />Amma wọ m'nde otte kwẹ, ẹma m'ọbạra ode nnwa kwaam. K'okpe kw'usi ipina, m'mvun-ẹ uchi-nwa, mbạra ntima ayokhanạng nnạng-ẹ irem. <verse eid="2SA 7:14" /><verse number="15" style="v" sid="2SA 7:15" />Okhenka, ọnạng kòde kw'm'ọtạkha idạdaakha s'nkhaam abẹ, oche kw'uwa ntạk sẹ k'Saul, kw'uwa mvạkh-ẹ ẹvaar nna kabạnga k'ititikha. <verse eid="2SA 7:15" /><verse number="16" style="v" sid="2SA 7:16" />Ọchọhm kwọ ọttạra ọvaarfhon kwọ m'uttima arạnga tạrr ipimmanitor.’ ”<verse eid="2SA 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 7:17" />Ma wọ wa Natan ọkpaakhẹ Devid idik s'eyaakha njọ phyibh.<verse eid="2SA 7:17" /></para>
  <para style="s1">Njọhm s'Devid</para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 7:18" />Wa ọvaar Devid ọnwa k'ukkira ọta uninga ẹyạr k'ititikha s'Ọvaar Ubinọkpaabyi, oben bẹ́,</para>
  <para style="pm" vid="2SA 7:18">“O Ọvaar Ubinọkpaabyi kw'Ọyọhng, amma nde anẹ, ẹchọhmfhạr chaam ẹgba kha mbạng, kw'adir-m anạna k'ibyi-demasẹ nna o? <verse eid="2SA 7:18" /><verse number="19" style="v" sid="2SA 7:19" />O Ọvaar Ubinọkpaabyi kw'Ọyọhng, akwẹ ma nókponga. Ọma kk'ẹyaakha asia ch'eten k'ẹvaar ch'ọttọhmnạng kwọ k'okpe kw'oro. O Ọvaar Ubinọkpaabyi kw'Ọyọhng, nttọhna nna ide s'ayokhanạng o?<verse eid="2SA 7:19" /></para>
  <para style="pm">
    <verse number="20" style="v" sid="2SA 7:20" />“O Ọvaar Ubinọkpaabyi kw'Ọyọhng, bạng udik gwọ kw'amma Devid m'mbạra mkpaakh-ọ, s'atạm k'etạma asonga ọtọhmnạng kwọ o? <verse eid="2SA 7:20" /><verse number="21" style="v" sid="2SA 7:21" />Asengi echekha chọ ọttạra ẹkka ọkkachẹ chọ achẹ, asi ẹyaakha anạng amma ọtọhmnạng kwọ.<verse eid="2SA 7:21" /></para>
  <para style="pm">
    <verse number="22" style="v" sid="2SA 7:22" />O Ọvaar Ubinọkpaabyi kw'Ọyọhng, kk'abạra e! Onạng kòde kw'ode masẹ akhọ. Ubinọkpaabyi ọdwạkh-ọdwạk kòde kw'obeng abọ, otor k'oche kw'kk'atọhng pamạna antima ammaanga. <verse eid="2SA 7:22" /><verse number="23" style="v" sid="2SA 7:23" />Bạng anạng bọ ade masẹ anạng pọ Israẹl? Ofhon gwạnọ-gwạnọ maa ọyagbin kòde kw'ode masẹ ofhon kw'Israẹl, kw'Ubinọkpaabyi ọta obhek ọnạng ẹma oyeni, osenga ma ọkhaama eche, ọbạra usi ikkukkona-dik, ọttạra idik s'ipe anạng ifor k'okpe kw'ukhubhu idifhon nnọkha, ọttạra ikha sabẹ ma ititikha s'anạng pọ, p'abhekhi k'Ijip. <verse eid="2SA 7:23" /><verse number="24" style="v" sid="2SA 7:24" />Ọma kk'anạng p'Israẹl arạnga attima, masẹ anạng pọ oyeni. Ọma Ọvaar Ubinọkpaabyi kk'Ubinọkpaabyi kwabẹ akwu adia tạrr ipimmanitor.<verse eid="2SA 7:24" /></para>
  <para style="pm">
    <verse number="25" style="v" sid="2SA 7:25" />“Ma wọ, O Ọvaar Ubinọkpaabyi, chok echekha ch'kk'asia ukwuru amma ọtọhmnạng kwọ, ọttạra ẹchọhmfhạr chẹ tạrr ipimmanitor. Si oche kw'kk'achekha, <verse eid="2SA 7:25" /><verse number="26" style="v" sid="2SA 7:26" />ọfha eche chọ ẹbạr ipimmanitor. Ma wọ anạng n'abạra aben bẹ́, ‘Ọvaar Ubinọkpaabyi kw'Ẹfa phyibh wọ ode Ubinọkpaabyi kw'Israẹl e!’ Ẹchọhmfhạr ch'amma ọtọhmnạng kwọ Devid m'ittima arạnga k'ititikha sọ.<verse eid="2SA 7:26" /></para>
  <para style="pm">
    <verse number="27" style="v" sid="2SA 7:27" />“O Ọvaar Ubinọkpaabyi kw'Ẹfa phyibh, kw'ode Ubinọkpaabyi kw'Israẹl, ọma kk'eyaakha nja asia anạng amma ọtọhmnạng kwọ, aben bẹ́, ‘Amma Ọvaar Ubinọkpaabyi m'nsi ọchọhm nnạng-ọ.’ Ma wọ amma ọtọhmnạng kwọ kk'ottembạr nkhaama bẹ́, nse njọhm nna ọnạng-ọ. <verse eid="2SA 7:27" /><verse number="28" style="v" sid="2SA 7:28" />O Ọvaar Ubinọkpaabyi kw'Ọyọhng, ọma wọ ade Ubinọkpaabyi! Echekha chọ ede udik ọkka. Ọma kk'idik nna abạra achekha anạng amma ọtọhmnạng kwọ. <verse eid="2SA 7:28" /><verse number="29" style="v" sid="2SA 7:29" />Tte ettem erebh-ọ bẹ́, idia ch'ado iva p'iva paam, ininga efona ororo k'ititikha sọ tạrr ipimmanitor; otor k'oche kw'ọma Ọvaar Ubinọkpaabyi kw'Ọyọhng kk'akpaakha. M'osenga k'idia chọ, iva p'iva p'amma ọtọhmnạng kwọ akhaama idia tạrr ipimmanitor.”<verse eid="2SA 7:29" /></para>
  <chapter eid="2SA 7" />
  <chapter number="8" style="c" sid="2SA 8" />
  <para style="s1">Nkhema s'Devid</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 8:1" />Ukwu ukpira k'okpe ma, Devid okhema aPhilistiya, ọbạra ochok bẹ k'isekhisek kwẹ. Orengi ofhon kw'Mẹtẹg-Amma k'mbọhk s'aPhilistiya.<verse eid="2SA 8:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 8:2" />Wa Devid ọbạra okhema anạng p'Moab. Usi abẹ ayima k'isisek k'akpakhaana attaan, ọfhọ akpakhaana afa, otte rạnẹ ọbọhk iruk akpen. Wa anạng p'Moab p'arikhi-urik n'aning k'isekhisek kw'Devid, abẹ n'anạng-ẹ ntum.<verse eid="2SA 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 8:3" />Ayongu ma, wa Devid ọbạra okhema Hadadẹzẹr, kw'ode ọvaarnạng kw'Zoba, kw'ọbạra ode nnwa kw'Rehob. Wa okhem-ẹ k'okpe kw'ọta bẹ́, ọbạra ọta uttima ẹvaar chẹ arạnga k'ukhubha kw'Ọraanga kw'Yupharetes. <verse eid="2SA 8:3" /><verse number="4" style="v" sid="2SA 8:4" />Wa Devid ọvạk ijaar s'nnyạnyaang n'itwạr nnọhna mfa ukuma arạbh jobh, ọttạra ayaar-nnyạnyaang nnọhna chi ukuma mfa ukuma arạbh jobh, ọttạra akpongnạng p'aseng k'mfhok nnọhna arạbh afa ukuma jobh. Wa Devid ọphyạkhẹ nnyạnyaang s'n'itwạr ijaar nnọma mfhok, urik nnyạnyaang s'ijaar arạbh asen.<verse eid="2SA 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 8:5" />Masẹ anạng p'Aram p'abin Damaskọs akwu bẹ́, akwu akkaana Hadadẹzẹr kw'ode ọvaarnạng kw'Zoba, Devid o ukwu ọfhọ bẹ anạng nnọnhna arạbh afa ukuma chi. <verse eid="2SA 8:5" /><verse number="6" style="v" sid="2SA 8:6" />Wa Devid ọbạra ochok akpongnạng pẹ abaabha ẹbaakhamma ch'ẹkhạma ch'anạng p'Aram p'abin Damaskọs. Anạng p'Aram n'aning k'isekhisek kwẹ, abẹ abạra akken-ẹ ntum. Wa Ọvaar Ubinọkpaabyi ọnạngẹ Devid ekhema k'ibyi sidede s'ọta.<verse eid="2SA 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 8:7" />Wa Devid ọtạk akhọhnkpa p'gol, p'atọhmnạng p'Hadadẹzẹr utima ukwuna k'Jẹrusalẹm. <verse eid="2SA 8:7" /><verse number="8" style="v" sid="2SA 8:8" />Ọvaar Devid ọbạra ọtạkha abrons k'ọsaabh k'Teba ọttạra Bẹrotayi s'ide ifhon s'Hadadẹzẹr ọdạbhẹ.<verse eid="2SA 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 8:9" />Masẹ Toi kw'ode ọvaarnạng kw'Hamat ọbhaang bẹ́, Devid kk'akpongnạng p'Hadadẹzẹr okhema phyibh-phyibh, <verse eid="2SA 8:9" /><verse number="10" style="v" sid="2SA 8:10" />ọtọhm nnwa kwẹ Joram bẹ́, ọta usima Ọvaar Devid, ọbạra ọtọhng-ẹ s'okhem Hadadẹzẹr k'ekpong. Wa Hadadẹzẹr kk'ekpong ọbạra urima Toi abẹ. Wa Joram utim nnạnga s'silva ọttạra s'gol ọttạra s'brons utima ofona.<verse eid="2SA 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 8:11" />Wa ọvaar Devid otte ọbọhk k'nnạnga nnọ ọnạng Ọvaar Ubinọkpaabyi, k'oche kw'kk'usia ọttạra silva ọttạra gol p'uwa ọtạk k'idifhon phyi-phyibh s'kk'okhema, <verse eid="2SA 8:11" /><verse number="12" style="v" sid="2SA 8:12" />s'ide Edom, ọttạra Moab, ọttạra Ammọn, ọttạra Philistiya, ọttạra Amalẹk. Wa ọbạra otte ọbọhk k'ekpo py'uchi k'ekpong k'mbọhk s'Hadadẹzẹr, kw'ode ọvaarnạng kw'Zoba, kw'ọbạra ode nnwa kw'Rehob, ọnạng Ubinọkpaabyi.<verse eid="2SA 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 8:13" />Wa Devid ọbạra uyin eche s'ukwun ekpong ch'ọfhọ anạng p'Edom nnọhna arạbh afa ukuma asen k'Ipekhuma s'Unung.<verse eid="2SA 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 8:14" />Wa ochokhu akpongnạng pẹ abaabha Edom, anạng p'Edom phyibh n'aning k'isekhisek kw'Devid. Wa Ọvaar Ubinọkpaabyi ọnạngẹ Devid ekhema k'ibyi sidede s'ọta.<verse eid="2SA 8:14" /></para>
  <para style="s1">Atọhmnạng p'Devid</para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 8:15" />Wa Devid ọdạbhẹ Israẹl ọbaabh-ọbaabha, ọbạra usi aponga p'ator-otor, abạra ajibh anạng anạng pẹ phyibh. <verse eid="2SA 8:15" /><verse number="16" style="v" sid="2SA 8:16" />Wa Joab kw'ode nnwa kw'Zẹruya wọ ode odecho kw'akpongnạng; Jẹhosaphat kw'ode nnwa kw'Ahilud, ode ọkkẹrẹ kw'idik s'kk'iyina. <verse eid="2SA 8:16" /><verse number="17" style="v" sid="2SA 8:17" />Zadọk kw'ode nnwa kw'Ahitub ọttạra Ahimẹlẹk kw'ode nnwa kw'Abiyata, bọ wa ade afọhnẹja; Sẹraya ode ọkkẹrẹ. <verse eid="2SA 8:17" /><verse number="18" style="v" sid="2SA 8:18" />Bẹnaya kw'ode nnwa kw'Jẹhoyada wọ ode odecho kw'anạng p'Kẹrẹt, ọttạra anạng p'Pẹlẹt. Ajunungva p'Devid ade afọhnẹja.<verse eid="2SA 8:18" /></para>
  <chapter eid="2SA 8" />
  <chapter number="9" style="c" sid="2SA 9" />
  <para style="s1">Devid ọttạra Mẹphiboshẹt</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 9:1" />Wa Devid ọbạbhọ bẹ́ “Ọnạng utim urikhi kha ẹchọhmfhạr ch'Saul kw'm'nsi ọphyaam nnạng k'ẹcho ch'Jonatan yeri?” <verse eid="2SA 9:1" /><verse number="2" style="v" sid="2SA 9:2" />Wa ọkhaam ọtọhmnạng kw'n'okkeri ẹchọhmfhạr ch'Saul kw'okpen Ziba, kw'abẹ ayeri anạng Devid. Ọvaar Devid ọbạbh-ẹ bẹ́, “Ọma wọ akpen Ziba?”</para>
  <para style="p" vid="2SA 9:2">Ubhina bẹ́, “Uwe e, amma ọtọhmnạng kwọ wọ e.”<verse eid="2SA 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 9:3" />Ọvaarnạng ukwu ọbạbh bẹ́, “Ọnạng wạnọ-wạnọ utim urikhi kha ẹchọhmfhạr ch'Saul, kw'amma m'nsi ọphyaam f'Ubinọkpaabyi nnạng o?”</para>
  <para style="p" vid="2SA 9:3">Ziba ubhina ọvaarnạng bẹ́, “Ujunungnwa wạnọ kw'Jonatan utim urikhi kha, okhenka ọphyạkhẹ mkpẹtẹ.”<verse eid="2SA 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 9:4" />Ọvaarnạng ọbạbh bẹ́, “Ẹma oyeni uning mạn?”</para>
  <para style="p" vid="2SA 9:4">Ziba ubhina bẹ́, “Uning k'Lo-Dẹba, k'ọchọhm kw'Makir, kw'Amiyẹl ofhonu.”<verse eid="2SA 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 9:5" />Ma o, ọvaar Devid ọtọhm anạng k'Lo-Dẹba, k'ọchọhm kw'Makir, kw'Amiyẹl ofhonu bẹ́, abẹ ata atim-ẹ akwu.<verse eid="2SA 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 9:6" />Masẹ Mẹphiboshẹt, kw'ode nnwa kw'Jonatan, kw'Saul ofhonu ukpir, ọrạkha ọnạng Devid ikpukpobha.</para>
  <para style="p" vid="2SA 9:6">Devid oyer-ẹ bẹ́, “Mẹphiboshẹt!”</para>
  <para style="p" vid="2SA 9:6">Ochera bẹ́, “Aro kwaam, amma ọtọhmnạng kwọ wọ ẹ.”<verse eid="2SA 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 9:7" />Devid oben-ẹ bẹ́, “Nạng-ọ ojor, amma m'nsi ọphyaam nnạng-ọ k'echo ch'atte Jonatan. M'mbạra mkpa nnạm ntạkha abibini p'atte kw'ididen Saul phyi-phyibh nnạng-ọ. Ọma bạra n'achi uchiattọhk amma abẹ k'okpe kw'idede.”<verse eid="2SA 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 9:8" />Mẹphiboshẹt ọrạkha k'ikpukpobha oben bẹ́, “Amma ọtọhmnạng kwọ mgba kha mbạng o, kw'asi ọphyaam-dema mva anạng ẹpfa-bukhu masẹ akhaam?”<verse eid="2SA 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 9:9" />Ma wọ ọvaarnạng oyeri Ziba kw'ode ọtọhmnạng kw'Saul, ọkpaakh-ẹ bẹ́, “Amma kk'ọttọk fidede f'Saul, kw'ode aro kwọ, ọttạra ẹchọhmfhạr chẹ phyibh ọbọhk nttia nnạng nnwa-mfhona kw'aro kwọ. <verse eid="2SA 9:9" /><verse number="10" style="v" sid="2SA 9:10" />Ọma ọttạra ajunungva pọ, ọttạra atọhhmnạng pọ mạna atubh owonu anạng-ẹ, ọfha uchiattọhk uninga f'nnwa-mfona kw'aro kwọ m'n'uchi. Mẹphiboshẹt kw'ode nnwa-mfona kw'aro kwọ m'n'uchi uchiattọhk amma abẹ.” (Wa Ziba ofhonu ajunungva chi, ọbạra ọkhaama atọhmnạng ẹrạbh.)<verse eid="2SA 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 9:11" />Wa Ziba obeni ọvaarnạng bẹ́, “Amma ọtọhmnạng kwọ m'nsi fidede f'aro kwaam kw'ode ọvaarnạng obeni.” Mạnna wọ Mẹphiboshẹt uchi ọttọhk ọttạra Devid masẹ nnwa wạnọ kw'ọvaarnạng.<verse eid="2SA 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 9:12" />Wa Mẹphiboshẹt ọkhaam udikkobh-nwa wạnọ kw'okpen Mika. Anạng p'ẹchọhmfhạr ch'Ziba phyibh abạra ade atọhmnạng p'Mẹphiboshẹt. <verse eid="2SA 9:12" /><verse number="13" style="v" sid="2SA 9:13" />Ma wọ Mẹphiboshẹt urukhu k'Jẹrusalẹm ukwuru s'uwa n'uchi ọttọhk ọvaarnạng abẹ k'okpe kwidede. Ẹma wa ọphyạkhẹ mkpẹtẹ.<verse eid="2SA 9:13" /></para>
  <chapter eid="2SA 9" />
  <chapter number="10" style="c" sid="2SA 10" />
  <para style="s1">Devid okhem anạng p'Ammọn</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 10:1" />Ukwu ukpira k'okpe ma, ọvaarnạng kw'anạng p'Ammọn ukwu ope. Ujunungnwa kwẹ kw'okpen Hanun ukwu ọdạbh ẹvaar chẹ. <verse eid="2SA 10:1" /><verse number="2" style="v" sid="2SA 10:2" />Devid oben bẹ́, “Amma m'nsi ọphyaam nnạng Hanun, kw'ode nnwa kw'Nahas, k'oche kw'uwa otte kwẹ usi ọphyaam ọnạng-m.” Ma wọ Devid ọtọhmọ anạng bẹ́, abẹ ata adema Hanun abẹ k'obo kw'otte. Masẹ atọhmnạng p'Devid akpir k'ofhon kw'Ammọn, <verse eid="2SA 10:2" /><verse number="3" style="v" sid="2SA 10:3" />adecho p'Ammọn aben Hanun kw'ode aro kwabẹ bẹ́, “Ọma akkẹ bẹ́ ikpukpobha rọ s'Devid ọkhọhk k'obo kw'atte s'ọtọhmọ ajunung mbọ bẹ́, abẹ akwu adema abọ? Nákka bẹ́, ọtọhmọ bẹ bẹ́, abẹ akwu abaana ofhon ngwa, ọfha osonga nden s'm'utima urima akwẹ okhema o?” <verse eid="2SA 10:3" /><verse number="4" style="v" sid="2SA 10:4" />Ma wọ Hanun ọvạk anạng mbọ p'Devid ọtọhmọ, ugwu agba-phyạbha ukhubha gwạnọ, ọbạra ọvạkha anọhma-baba pabẹ ọyaakhẹ k'ayạrạba, ukhubh bẹ abhạna.<verse eid="2SA 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 10:5" />Masẹ Devid obhaang udik ngwọ, ọtọhm atọhmọ pẹ bẹ abẹ ata akhebha anạng mbọ, sabẹ kk'bẹ ẹsẹkha-bạrada njọ anạnga. Ọvaarnạng n'obeni bẹ́, “Abạnga aninga k'Jẹriko tạrr agba-phyạbha pabạnga amen, bạrasẹ abạnga n'akwun.”<verse eid="2SA 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 10:6" />Masẹ anạng p'Ammọn n'atini bẹ́, abẹ kk'asia ettem ipyibh Devid otena bẹ abẹ, abẹ abher akpongnạng p'Aram p'aseng k'mfhok, nnọhna arạbh afa ukuma jobh, p'abin k'ẹkhạma ch'Bẹt-Rehob ọttạra Zoba. Wa ajunung nnọhna mfa ukuma arạbh jobh abạra afona k'ọvaarnạng kw'Maaka. Nnọhna ẹrạbh ukuma jobh afona k'ẹkhạma ch'Tob.<verse eid="2SA 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 10:7" />Masẹ Devid ọbhaang udik ngwa, ọtọhm Joab utima akpongnạng pẹ phyibh p'akke irima ofona. <verse eid="2SA 10:7" /><verse number="8" style="v" sid="2SA 10:8" />Wa akpongnạng p'Ammọn ado ifor ayin k'iyaan ata abe k'ẹbaakhamma ch'efhon-diden, abẹ age okpong-baakha. Akpongnạng p'Aram, p'nkhạma s'Zoba, ọttạra s'Rehob, ọttạra s'Tob, ọttạra s'Maaka, anyaangẹ atobha k'ọyaankpa kw'ọbaang ma.<verse eid="2SA 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 10:9" />Masẹ Joab osẹ bẹ́, abẹ kk'ẹ okpong-baakha agia abaabh-ẹ, ma wọ n'otek akkedim bạnọ p'ekpong k'Israẹl bẹ́, abẹ ata arima akpongnạng p'Aram abẹ. <verse eid="2SA 10:9" /><verse number="10" style="v" sid="2SA 10:10" />Wa ọtạk akpongnạng mbọkha p'arikhi otte ọbọhk ọnạng nnwọkka Abishayi, utima bẹ ọta urima akpongnạng p'Ammọn abẹ. <verse eid="2SA 10:10" /><verse number="11" style="v" sid="2SA 10:11" />Joab oben bẹ́, “De anạng p'Aram akpọhkhọ ayọhng-m, ọma kwu ikkaan-m o. Okhenka, de anạng p'Ammọn akpọhkhọ ayọhnga ọma, amma m'nkwu-ukwu, nkwu nkkaan-ọ. <verse eid="2SA 10:11" /><verse number="12" style="v" sid="2SA 10:12" />Ọma kpọhkhọ ifor annima irima nja ẹkkam-ẹkkam k'ncho s'anạng pamạna, ọttạra s'ifhon-diden s'Ubinọkpaabyi kwamạna. Ọvaar Ubinọkpaabyi m'usi oche kw'ọdaakh-ẹ.”<verse eid="2SA 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 10:13" />Ma wọ Joab ọttạra akpongnạng pẹ afon ata arima anạng p'Aram abẹ, anạng p'Aram arạbh ma k'abẹ k'ititikha. <verse eid="2SA 10:13" /><verse number="14" style="v" sid="2SA 10:14" />Masẹ anạng p'Ammọn ase bẹ́, anạng p'Aram nạnka arạbh, abẹ arạbh arik Abishayi annwa k'efhon-diden. Ma wọ Joab ukum anạng p'Ammọn abẹ ririma, ọkpa nnạm ọbhạna k'Jẹrusalẹm.<verse eid="2SA 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 10:15" />Masẹ akpongnạng p'Aram n'ase bẹ́, akpongnạng p'Israẹl kk'bẹ akhema, abẹ afona adạkhẹ ata ado ayok atobha. <verse eid="2SA 10:15" /><verse number="16" style="v" sid="2SA 10:16" />Wa Hadadẹzẹr ofon ọta ọtạkha akpongnạng p'Aram tạma k'Ọraanga ukhubha kw'Yupharetes tạrr ukpira k'Hẹlam. Shobak kw'ode odecho kw'akpongnạng p'Hadadẹzẹr, utima bẹ eden.<verse eid="2SA 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 10:17" />Masẹ Devid ọbhaang udik ngwa, otobha anạng p'Israẹl phyibh, utima bẹ ojekha Jọrdan afona k'Hẹlam. Wa anạng p'Aram age okpong-baakha atik Devid k'oche kw'abẹ m'arima abẹ. <verse eid="2SA 10:17" /><verse number="18" style="v" sid="2SA 10:18" />Okhenka, aSiriya arạbhọ ma ititikha s'anạng p'Israẹl. Wa Devid ọfhọ ayaar-akpaar p'nnyạnyaang n'itwạr enọhna ukuma arạbh chi, ọttạra akpongnạng p'aseng k'mfhok nnọhna arạbh asen. Wa ọbạra uvun Shobak kw'ode odecho kw'akpongnạng pabẹ, ọfhọ. <verse eid="2SA 10:18" /><verse number="19" style="v" sid="2SA 10:19" />Masẹ avaar phyibh p'aning k'isekhisek kw'Hadadẹzẹr ase bẹ́, anạng p'Israẹl kk'bẹ akhema, abẹ afona ata asi ẹmẹm ọttạra anạng p'Israẹl, abẹ abạra aninga k'isekhisek kwabẹ.</para>
  <para style="p" vid="2SA 10:19">Wa ojora ọvạk anạng p'Aram bẹ́, abẹ abạra ata akkaana anạng p'Ammọn.<verse eid="2SA 10:19" /></para>
  <chapter eid="2SA 10" />
  <chapter number="11" style="c" sid="2SA 11" />
  <para style="s1">Devid ọttạra Batshẹba</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 11:1" />Ma ọyaabhakpe kw'avaar n'afona ekpong, Devid ọtọhmọ Joab ọttạra atọhmnạng p'ọvaarnạng ọttạra akpongnạng p'Israẹl phyi-phyibh ekpong. Abẹ ata afhọ anạng p'Ammọn, abạra abaabha ofhon kw'Raba age ngekha; Devid oyeni uninga k'Jẹrusalẹm.<verse eid="2SA 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 11:2" />K'ẹchọhkhawu mạnna jạnẹ, ovaar Devid ubin k'ibhikha ọta osenga k'ọvaarchọhm ẹrạng-ẹrạng. Uninga kha ose ikwanạng wạnọ kw'n'okpobha asi. Ikwanạng nwọ wa ọkhaankẹ ujibh iminava. <verse eid="2SA 11:2" /><verse number="3" style="v" sid="2SA 11:3" />Devid ọtọhm ọnạng bẹ́, ọta oror osonga ọnạng kw'ikwanạng nwọ ode. Ọnạng nwọ ọkpaakh-ẹ bẹ́, “Batshẹba kw'Eliyam ofhonu, ọbạra ode ikwanạng kw'Uriya kw'ubin Het, ẹwọ ma e.” <verse eid="2SA 11:3" /><verse number="4" style="v" sid="2SA 11:4" />Devid o, ukwu ọtọhm akpaakh-nkkaabha bẹ́, abẹ ata atạkh-ẹ akken-ẹ. Ukwu ukpira, uyima abẹ, bạrasẹ ikwanạng nwọ n'ọkpa nnạm ọbhana k'akhẹ k'ọchọhm. (Okpe tạm núbhira kw'ikwanạng nwọ okker immaana-dik s'ifor ttutto usi.) <verse eid="2SA 11:4" /><verse number="5" style="v" sid="2SA 11:5" />Ikwanạng nwọ o ophye okpong-ẹ, ọtọhm ẹkkaabha ọnạngẹ Devid bẹ́, “Amma ophye kk'aam okponga e.”<verse eid="2SA 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 11:6" />Ma wọ Devid ọtọhmọ ẹkkaabha ọnạng Joab bẹ́, “Tọhm Uriya kw'ubin Het nạng-m.” Mạnna wọ Joab ọtọhm-ẹ ọnạng Devid. <verse eid="2SA 11:6" /><verse number="7" style="v" sid="2SA 11:7" />Masẹ Uriya n'okhebh-ẹ, Devid ọbạbh-ẹ oche kw'Joab uning kha, ọttạra oche kw'akpongnạng ode bẹ, ọttạra oche kw'ekpong ede. <verse eid="2SA 11:7" /><verse number="8" style="v" sid="2SA 11:8" />Ma wọ Devid obeni Uriya bẹ́, “Sọhng ata akpobhu mfhok k'akhọ k'ọchọhm.” Uriya ubina ma k'ọvaarchọhm ofona, abẹ atima ẹtaam ch'ọvaarnạng ọnạng-ẹ ator-ẹ nnạm. <verse eid="2SA 11:8" /><verse number="9" style="v" sid="2SA 11:9" />Okhenka, wa Uriya okpong ma uyima k'ẹbaakhamma ch'ọvaarter ọttạra akpongnạng p'aro kwẹ, k'ochọhm kwẹ nọ́ta.<verse eid="2SA 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 11:10" />Masẹ abẹ akpaakhẹ Devid bẹ́, “Uriya k'ọchọhm kwẹ nọ́bhạna ẹ.” Ma wọ Devid ọbạbhọ Uriya bẹ́, “Bẹ napra abina eden-ibhir akwu maa? Ode yạn kw'nạn k'akhọ ọchọhm nábhạna o?”<verse eid="2SA 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 11:11" />Uriya oben Devid bẹ́, “Ikwukwur s'Echekha, ọttạra anạng p'Israẹl, ọttạra p'Juda ayim k'ukkira, Joab kw'ode aro kwaam, ocho kwaam ọttạra atọhmnạng, ọttạra akpongnạng p'ọma ọvaarnạng kwaam abhingi kha ọyaankpa. Ukwuru yạn kw'amma n'abạra mmạna k'akhaam k'ọchọhm bẹ́, nta nchi, mbạra ngwo, mbạra nyima ikwanạng kwaam abẹ o? Oche ngwa kw'ọma arukhu akpen, amma udik demakwẹ gwọ mạ́nsi!”<verse eid="2SA 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 11:12" />Ma wọ Devid n'oben-ẹ bẹ́, “Khenka ninga maa chemma, uphyini amma m'ntọhm-ọ akpa nnạm.” Wa Uriya ubhingi ma Jẹrusalẹm ma iwu njọ, ọttạra iwu ch'echobh ma. <verse eid="2SA 11:12" /><verse number="13" style="v" sid="2SA 11:13" />Devid oyer-ẹ, ukwu uchi ọttọhk, ọbạra ogwo atwuk abẹ. Wa Devid ọnạng-ẹ atwuk tạrr ubuma. Okhenka, ma ẹchọhkha, Uriya utim uwurukpa kwẹ ọta otor atọhmnạng p'aro kwẹ abẹ ayima. K'ọchọhm kwẹ nọ́bhạna.<verse eid="2SA 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 11:14" />K'ekpebha Devid ọkkẹr ẹkkaabha k'ọnnwẹrkpa ọnạng Uriya bẹ́, okkena Joab. <verse eid="2SA 11:14" /><verse number="15" style="v" sid="2SA 11:15" />Ma ọnnwẹrkpa nwọ, ọkkẹrẹ bẹ́, “Chok Uriya k'akpong-chen, k'ibyi s'irima ẹkhạm-ọkhạm mororo, anyaangẹ arikh-ẹ, ọfha abẹ attẹ-ẹ, afhọ.”<verse eid="2SA 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 11:16" />Ma o, masẹ Joab kk'efhon-diden ọbaabha oge ngekha, ọtạkha Uriya ochok k'ukhubha kw'osong bẹ́, akkemkpa p'awawuna-nạng pabẹ aning. <verse eid="2SA 11:16" /><verse number="17" style="v" sid="2SA 11:17" />Masẹ ajunung p'efhon-diden ngwọ ayini k'iyaan bẹ́, abẹ akwu arima Joab abẹ, ma wọ abẹ afhọ Uriya kw'ubin Het, ọttạra akpongnạng bạnọ p'Devid. <verse eid="2SA 11:17" /><verse number="18" style="v" sid="2SA 11:18" />Wa Joab otọhmọ ẹkkaabha otek Devid udik kwidede kw'uyini k'ekpong njọ. <verse eid="2SA 11:18" /><verse number="19" style="v" sid="2SA 11:19" />Ọtọhnọ ọkpaakh-ẹkkaabha nwọ bẹ́, “De kk'ọvaarnạng atekha oche kw'ekpong ede, <verse eid="2SA 11:19" /><verse number="20" style="v" sid="2SA 11:20" />de ọvaarnạng ọdwạkh-ẹ, ọbạbh-ọ bẹ́, ‘Abạnga asi yạn ata arima ekpong abaanga k'efhon-diden oyeni? Wạra abạnga kásong bẹ́, abẹ akkokke aninga k'ọbaakha n'atta ayuk? <verse eid="2SA 11:20" /><verse number="21" style="v" sid="2SA 11:21" />Anẹ wọ wa ọfhọ Abimẹlẹk kw'Jerub-Bẹshẹt ofhonu? Ikwanạng sạng uning k'ọbaakha ubingi ẹtakpa ch'ẹfhẹ-ẹ k'Tẹbẹz? Abạnga asi yạn ata arima afora k'ọbaakha?’ Kpaakh-ẹ bẹ́, ‘Ayongu ma, Uriya kw'ubin Het, kw'ode ọtọhmnạng kwọ ọgba ope ẹ.’ ”<verse eid="2SA 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 11:22" />Ma wọ ọkpaakh-ẹkkaabha ubin ofona. Masẹ ukpir, ọkpaakh-ẹ idik phyibh s'Joab kk'ẹ ọtọhma bẹ́ ọkpaak Devid. <verse eid="2SA 11:22" /><verse number="23" style="v" sid="2SA 11:23" />Ọkpaakh-ẹkkaabha nwọ oben Devid bẹ́, “Akpongnạng mbọ ayọhng mạna mkpaam e. Abẹ ayini k'iyaan akwu arima mạna abẹ k'ọyaankpa, okhenka, ankhubhu bẹ tạrr abẹ akpa nnạm k'ẹbaakhamma ch'efhon-diden kwabẹ. <verse eid="2SA 11:23" /><verse number="24" style="v" sid="2SA 11:24" />Ma wọ akkedim p'ayuk-ttạtta aning k'ọbaakha n'atta akpongnạng pọ ayuk, osenga ma, anạng bạnọ p'ọvaarnạng ape. Ayongu ma, Uriya kw'ode okpongnạng kwọ kw'ubin Het kk'upua.”<verse eid="2SA 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2SA 11:25" />Devid oben ọkpaakh-ẹkkaabha nwọ bẹ́, “Ben Joab bẹ́, tte udik ngwọ nạng-ẹ ẹmma ọphyaangẹ, khiri ẹkpong ch'ẹfhọ ọnạng, m'ẹbạra ẹfhọ ọnạng ọdwạkh-ọdwạk. Tte ọkpọhkhọ ifor ofona ororo urima efhon-diden nwọ abẹ, udimi wẹ. Tima idik nna ge Joab nttem.”<verse eid="2SA 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 11:26" />Masẹ ikwanạng kw'Uriya ọbhaang bẹ́ udim kwẹ kk'upua, ọgạma, ọbạra utima nkwuna sẹ. <verse eid="2SA 11:26" /><verse number="27" style="v" sid="2SA 11:27" />Masẹ okpe kw'utim nkwuna kk'ottonga, Devid ọta ọtạkh-ẹ ukwuna k'akhẹ k'ọchọhm, ukwu ode ikwanạng kwẹ, ọmaan-ẹ ujunungnwa. Okhenka, usisi nwọ kw'Devid Ọvaar Ubinọkpaabyi ettem nórebha.<verse eid="2SA 11:27" /></para>
  <chapter eid="2SA 11" />
  <chapter number="12" style="c" sid="2SA 12" />
  <para style="s1">Natan upyimi Devid k'usisi kwẹ</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 12:1" />Ọvaar Ubinọkpaabyi ọtọhmọ Natan ọta okhebha Devid. Masẹ okhebh-ẹ, oben bẹ́, “Wa ọkhaam ajunung mạnna afa p'abin ofhon gwạnọ. Oyok wạnọ ujibh-ẹ ujibh, nwọkha otto okpor. <verse eid="2SA 12:1" /><verse number="2" style="v" sid="2SA 12:2" />Oyok kw'ujibh-ẹ ujibh ọkhaam arạkhạmaan ọttạra mmaam k'ọsaabh. <verse eid="2SA 12:2" /><verse number="3" style="v" sid="2SA 12:3" />Okhenka, ukpukpora nwọ ọttọhk kọ́khaam, oyonga ọrạkhạmaan-kwa kw'isạsạkhẹ, awẹma-awẹma kw'kk'odebha. Ọgwạkhọ wẹ tạrr awẹ ọbạr, ọttạra iva p'ujunung nwọ. Ọrạkhạmaan nwọ n'uchi ọttọhk ujunung nwọ abẹ, ọbạra ogwo asi k'nkkọbh kw'ujunung nwọ, ọbạra ọttaabha ugi-ẹ ma k'mbọhk. Wa ọrạkhạmaam-nwa nwọ n'ode masẹ ọkwanạngnwa ọnạng-ẹ.<verse eid="2SA 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 12:4" />“Wa ukhikhen-nạng mạnna wạnọ ukwu ọsạkha oyok nwọ kw'ujibh-ẹ ujibh, nwọ kw'ujibh-ẹ ujibh ufhum bẹ́, ọtạkha arạkhạmaan pẹ, ọbạra ode mmaam sẹ bẹ́, utima usi uchiattọhk ọnạng ukhikhen-nạng kw'kk'ẹ ọsạkha. Uttu kw'm'usi oche ngwọ, otera ọta ọtạkha ọrạkhạmaan-kwa nwọ wạnọ kw'ukpukpora, utima usi uchiattọhk ọnạng ukhikhen-nạng kw'kk'ẹ ọsạkha.”<verse eid="2SA 12:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 12:5" />Udik ngwọ ọdwạkhọ Devid tạrr oben Natan bẹ́, “Oche ngwọ kw'Ọvaar Ubinọkpaabyi urukhu akpen, ọnạng nwọ kw'usi udik demakwẹ ngwọ ọbaan bẹ́, ope echomajạnẹ! <verse eid="2SA 12:5" /><verse number="6" style="v" sid="2SA 12:6" />Ẹma nwọ ọbaan bẹ́ utwuk ọrạkhạmaan-kwa nwọ k'ikpe innebung, ukwuru bẹ́, ikwosi kọ́khaam k'udik kw'usi ma.”<verse eid="2SA 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 12:7" />Ma wọ Natan obeni Devid bẹ́, “Ọma wọ ade ujunung nwọ e! Maa wọ ode udik kw'Ọvaar Ubinọkpaabyi, kw'ode Ubinọkpaabyi kw'Israẹl, ọkpaakhẹ: ‘Amma mbyeng-ọ ana k'echo, nsi-ọ ọvaarnạng kw'Israẹl, mbạra nkkaan-ọ, nneng-ọ k'mbọhk s'Saul. <verse eid="2SA 12:7" /><verse number="8" style="v" sid="2SA 12:8" />Amma ntte ẹchọhmfhạr ch'aro kwọ ọbọhk nnạng-ọ, mbạra ntạkha ipanạng pẹ nnạng-ọ. Nnạng-ọ ẹvaar ch'Israẹl ọttạra ch'Juda. Wạra ode bẹ́, idik nna khọ níbenga, wạra m'nnạng-ọ nyọhnga ma. <verse eid="2SA 12:8" /><verse number="9" style="v" sid="2SA 12:9" />Ode yạn kw'afhumu ọkpaakha-dik kw'Ọvaar Ubinọkpaabyi, ata asi ubyibya-dik demakwẹ ngwa, k'ititikha sẹ o? Ọma atim ọkkangkkang-kkro afhọ Uriya kw'ubin Het, abạra atạkha ikwanạng kwẹ aba. Ọma atim ọkkangkkang-kkro kw'anạng p'Ammọn afhẹ-ẹ. <verse eid="2SA 12:9" /><verse number="10" style="v" sid="2SA 12:10" />M'osenga ma, ọkkangkkang-kkro ẹchọhmfhạr chọ ọbọhk mótte, ukwuru s'afhumu ọkpaakha-dik kwaam, afona ata atạkha ikwanạng kw'Uriya kw'ubin Het aba.’<verse eid="2SA 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 12:11" />“Maa wọ ode udik kw'Ọvaar Ubinọkpaabyi obeni: ‘Amma m'ntọhm ẹkhọngkwuru k'ẹchọhmfhạr chọ. M'ntạkha ipanạng pọ nnạng oyok-ọbaanga kwọ. Ẹma nwọ m'uyima ipanạng pọ abẹ k'ọyaankpa. <verse eid="2SA 12:11" /><verse number="12" style="v" sid="2SA 12:12" />Ọma asi udik ngwa idubh-idubha, okhenka amma m'nsi kwẹ k'ọyaankpa k'ititikha s'anạng p'Israẹl phyibh.’ ”<verse eid="2SA 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 12:13" />Ma wọ Devid obeni Natan bẹ́, “Amma kk'ipyibha nsia k'ititikha s'Ọvaar Ubinọkpaabyi.”</para>
  <para style="p" vid="2SA 12:13">Natan ọpọhna bẹ́, “Ọvaar Ubinọkpaabyi kk'ubina ọnạng-ọ k'ipyibha chọ. Ọma dạk mápe. <verse eid="2SA 12:13" /><verse number="14" style="v" sid="2SA 12:14" />Okhenka, ukwuru s'kk'awọhkha bẹ́, awawuna-nạng p'Ọvaar Ubinọkpaabyi annukh-ẹ, nnwa nwọ kw'abẹ amaanẹ anạng-ọ akpen múruk.”<verse eid="2SA 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 12:15" />Masẹ Natan kk'ọbhạna k'akhẹ k'ọchọhm, Ọvaar Ubinọkpaabyi usi nwa nwọ kw'ikwanạng kw'Uriya ọmaanẹ ọnạng Devid otto ọkhạmana. <verse eid="2SA 12:15" /><verse number="16" style="v" sid="2SA 12:16" />Wa Devid uchini Ubinọkpaabyi k'echo ch'nnwa nwọ. Uyim okwo, ọbạra oge ọvạra-bina uyima k'isisek k'nnuguwu s'isaabh-ọsaabh. <verse eid="2SA 12:16" /><verse number="17" style="v" sid="2SA 12:17" />Adennạng p'ẹchọhmfhạr chẹ akhonga k'oche kw'abẹ m'avạkh-ẹ ubina k'isisek, nóchera, ọbạra ufhum uchiatọhk chichi bẹ abẹ.<verse eid="2SA 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 12:18" />Ottong iwu isenọfa, nnwa nwọ ope. Atọhmnạng p'Devid ojoru bẹ k'oche kw'abẹ m'akpaakh-ẹ bẹ́, nnwa nwọ kk'upua, sabẹ akkẹ bẹ́, “Yeyema s'nnwa nwọ utim urukhu akpen, de amkpaakhẹ Devid udik, mạna itọhng mọ́khọhmọ. Masẹ nnwa nwa n'ope maa, m'ansenga yạn amkpaakh-ẹ o? Okke-okke usi f'nạn ichen nánchokha e.”<verse eid="2SA 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 12:19" />Masẹ Devid ose bẹ́, atọhmnạng pẹ n'akkaabha ayok idik, ukwu utin bẹ́ nnwa nwọ kk'upua. Ma wọ ọbạbhọ bẹ́, “Nnwa nwọ kk'upua o?”</para>
  <para style="p" vid="2SA 12:19">Abẹ abhin-ẹ bẹ́, “Uwe-e, kk'upua e.”<verse eid="2SA 12:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 12:20" />Ma wọ Devid ubin k'isek ọta okpobha asi, ọfọhnọ ana, ọbạra ofhona ẹnya. Ukwu ofona k'ọchọhm kw'Ọvaar Ubinọkpaabyi, ọta okpobh-ẹ. Ubina ma, ofona k'akhẹ k'ọchọhm, oben abẹ anạng-ẹ uchiattọhk, uchi.<verse eid="2SA 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 12:21" />Atọhmnạng pẹ abạbh-ẹ bẹ́, “Ọma n'asi yạn maa o? K'okpẹ kw'nnwa nwọ utim uning akpen, ayima okwo, abạra afhobh asẹn. Masẹ nnwa n'ope, ma wọ n'atera abina achi ọttọhk!”<verse eid="2SA 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 12:22" />Ubhina bẹ́, “K'okpe kw'nnwa nwọ utim urukhu akpen, nnyim okwo, mbạra mfhobh asẹn ukwuru s'nkkẹ bẹ́, “Ọvaar Ubinọkpaabyi m'ọkhaama abamẹ ikwosi, otte nnwa nwọ ọbọhk uruk akpen. <verse eid="2SA 12:22" /><verse number="23" style="v" sid="2SA 12:23" />Okhenka, masẹ kk'upua, bạra mfona ororo nninga okwo fa mbạng o? Amma s'm'nkke ntima abẹ mkpa nnạm k'akpen? Amma wọ m'ntera nkhebh-ẹ kha, ẹma sạng m'ọbạra ọkpa nnạm okebha amma kha.”<verse eid="2SA 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 12:24" />Ma wọ Devid ofokhu ikwanạng kwẹ Batshẹba nttem, ọta uyima abẹ, ọmaan-ẹ ujunungnwa, abẹ akpẹ-ẹ Sọlọmọn. Nnwa nwọ ọdaakhẹ Ọvaar Ubinọkpaabyi; <verse eid="2SA 12:24" /><verse number="25" style="v" sid="2SA 12:25" />ukwuru idạdaakha nnọ, Ọvaar Ubinọkpaabyi ọtọhmọ Natan kw'ode usi-ẹyaakha bẹ́, ọta ukpẹ-ẹ bẹ́, Jedidiya<note caller="+" style="f"><char style="fr" closed="false">12.25 </char><char style="ft" closed="false">K'eHiburu, eche nja Jedidiya iyini bẹ́, Ọdaakh-m kw'Ọvaar Ubinọkpaabyi. </char></note>.<verse eid="2SA 12:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 12:26" />Ma okpe ngwọ, wa Joab urim ekpong ọttạra ofhon kw'Raba, kw'ẹkhạma ch'Ammọn abẹ, ọvạk bẹ ọvaar-fhon kwabẹ ọna. <verse eid="2SA 12:26" /><verse number="27" style="v" sid="2SA 12:27" />Joab ọtọhmọ akpaakh-nkkaabha ata akhebha Devid akpaakh-ẹ bẹ́, “Amma Joab kk'Raba abẹ nnima, mbạra ntạkha asipe pẹ. <verse eid="2SA 12:27" /><verse number="28" style="v" sid="2SA 12:28" />Atobha akpongnạng p'arikhi ẹbhạr-ẹbhạrẹ, abẹ ata abaabha efhon-diden ngwọ age ngekha, atạkha kwẹ k'ẹfa, deja, amma m'nvạkha bẹ efhon-diden ngwọ nna, mkpe kwẹ mmina k'akhaam.”<verse eid="2SA 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2SA 12:29" />Mạnna wọ Devid otobh akpongnạng phyibh utima ofona k'Raba, urima bẹ abẹ tạrr okhema bẹ. <verse eid="2SA 12:29" /><verse number="30" style="v" sid="2SA 12:30" />Wa Devid ọwạr ọvaarnạng kw'abẹ ikpo, abẹ atạkha akhubha ẹma Devid. Adọhbh p'ikpo nnọ ikpir talẹn wạnọ kw'gol, abẹ abạra akpạna sẹ ata-jibha. Wa Devid ọkhaankẹ uchi bẹ ekpo k'ọsaabh ma ekpong njọ ch'efhon-diden. <verse eid="2SA 12:30" /><verse number="31" style="v" sid="2SA 12:31" />Ọtạkha anạng p'ofhon ngwọ, ọnạng itọhm sabẹ m'atima uyọhngkpọ ọttạra mgbikhiri asi, ọttạra s'mbạr, ọttạra s'ọtọhkhọ f'mbaanga, ọttạra s'mbạr, ọbạra utima bẹ usi itọhm s'ata p'adọhngọ rạrạbha. Wa Devid usi udik ngwọ ọbaabha ifhon s'Ammọn phyi-phyibh. Ma wọ Devid ọttạra akpongnạng pẹ phyibh akpa nnạm abhạna k'Jẹrusalẹm.<verse eid="2SA 12:31" /></para>
  <chapter eid="2SA 12" />
  <chapter number="13" style="c" sid="2SA 13" />
  <para style="s1">Amnọn ọttạra Tamar</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 13:1" />Wa Absalọm kw'ode ujunungnwa kw'Devid, ọkhaam nnwọkka kw'ikwanạng kw'ujibhi iminava kw'okpen Tamar. K'okpe mạnna gwạnọ, Amnọn kw'ode ujunung nnwa kw'Devid ọkhaam idạdaakha Tamar abẹ.<verse eid="2SA 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 13:2" />Wa Amnọn ọtạk ettem oge k'Tamar tạrr okhebha ma otto ọkhạmana, ukwuru bẹ́, wa Tamar ujunung tạm nósonga, ukwu ọkhaarẹ-ọkhaarẹ bẹ́, uyima abẹ.<verse eid="2SA 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 13:3" />Okhenka, wa Amnọn ọkhaam oyok-udikkobh kw'okpen Jonadab, kw'ode nnwa kw'Shimeyi, kw'ode nnwotte kw'Devid. Jonadab ẹma ode ọnạng kw'odongu-odongu k'idaam oyeni. <verse eid="2SA 13:3" /><verse number="4" style="v" sid="2SA 13:4" />Ọbạbh Amnọn bẹ́, “Ode yạn kw'ọma nnwa kw'ọvaarnọng n'aninga ikwosi-ikwosi k'ekpebha-wu chidede? Tekh-m kadẹ.”</para>
  <para style="p" vid="2SA 13:4">Amnọn ọpọhn-ẹ bẹ́, “Tamar kw'ode nnwọkka kw'Absalọm, kw'ande ivotte, ẹwọ n'ọdaakh-m e.”<verse eid="2SA 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 13:5" />Jonadab oben-ẹ bẹ́, “Sọhng ata ayima k'ibhikha, asi nkkari bẹ́, ọmmọ-ọ ọmma. Masẹ atte m'ukwu usi-ọ, ben-ẹ bẹ́, ‘Amma wạra ọdaakh-m bẹ́, nnwotte kwaam Tamar ukwu usi uchiattọhk ọnạng-m e. Tte uninga ma ititikha saam usi pfẹ ọfha n'nse-ẹ, ọbạra ọyạkh-m pfẹ ọyạkha.’ ”<verse eid="2SA 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 13:6" />Ma wọ Amnọn usi nkkari ọta uyima masẹ ọnạng kw'ẹkhạmaana-dim ẹmmẹ-ẹ. Masẹ otte, ọvaar Devid ukwu bẹ́, usi-ẹ, Amnọn oben-ẹ bẹ́, “Amma wạra ọdaakh-m bẹ́, nnwotte kwaam Tamar ukwu usi uchiattọhk f'm'ọdaakh-m ọnạng-m, ọbạra ọyạkh-m pfẹ ọyạkha.<verse eid="2SA 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 13:7" />Devid o, n'ọtọhmọ abẹ ayeri Tamar k'ọvaarter, oben bẹ́, “Sọhng k'ọchọhm kw'nnwatte Amnọn, ata asi uchiattọhk anạng-ẹ.” <verse eid="2SA 13:7" /><verse number="8" style="v" sid="2SA 13:8" />Mạnna wọ kw'Tamar ofon k'ọchọhm kw'nnwotte Amnọn, kw'okhebh-ẹ s'uyim kha ibhikha. Tamar ọtạkha agwu-buma ọlọhkhọ utima usi brẹd ma akhẹ k'ititikha. <verse eid="2SA 13:8" /><verse number="9" style="v" sid="2SA 13:9" />Ọtạkha brẹd nwọ oge k'kkoriya ọta ober-ẹ, okhenka, Amnọn nóchera uchi.</para>
  <para style="p" vid="2SA 13:9">Amnọn n'obeni bẹ́, “Aben ọnạng kwidede uyin k'iyaan.” Mạnna wọ ọnạng kwidede ubin uyin k'iyaan. <verse eid="2SA 13:9" /><verse number="10" style="v" sid="2SA 13:10" />Amnọn o, oben Tamar bẹ́, “Dira uchiattọhk mvọ kken-m kha ẹmaanggọ chaam, ọfha atima ọbọhk kwọ oyeni ayạkh-m pfẹ.” Tamar udir brẹd nwọ kw'kk'usia, ọnwa k'ẹmaanggọ ch'nnwotte kwẹ Amnọn. <verse eid="2SA 13:10" /><verse number="11" style="v" sid="2SA 13:11" />Okhenka, masẹ utim uchiattọhk mvọ okken-ẹ bẹ́ uchi o, ọdạbh-ẹ, oben bẹ́, “Nnwotte kwaam, vura kwu antwạn anyima kha ibhikha.”<verse eid="2SA 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 13:12" />Tamar oben-ẹ bẹ́, “Mma o, ọma ade nnwotte kwaam! Khaam k'ẹfa kávạkha! Udik demakwẹ ngwa k'Israẹl tạm núyina o! Ubyibyadik ngwa kási. <verse eid="2SA 13:12" /><verse number="13" style="v" sid="2SA 13:13" />Amma ọttạra ọma m'annuk yạn ọttạra ọkpạrsia-dik ngwa o? Ọma m'ade masẹ udindingi-nạng wạnọ ma k'Israẹl. Ttọttọkhạn, kpaak ọvaarnạng abẹ, khaam eden mọ́kpa bẹ́, mbọ-ọ.” <verse eid="2SA 13:13" /><verse number="14" style="v" sid="2SA 13:14" />Amnọn khẹ itọhng nọ́khọma, ọvạkh-ẹ uyima abẹ k'ẹfa, ukwuru s'ọkhaam ẹfa ọyọhng-ẹ.<verse eid="2SA 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 13:15" />Ma wọ Amnọn ọtạm ma uwuna Tamar k'idaam oyeni. K'udik ọkka, wa uwun-ẹ ọyọhnga oche kw'uwa uchi eden ọdaakh-ẹ. Amnọn oben-ẹ bẹ́, “Bina yin k'iyaan afona!”<verse eid="2SA 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 13:16" />Tamar oben-ẹ bẹ́, “Mma o! De akhubh-m abhạrẹ k'iyaan wọ oter upyibhi ọtạm ọyọhnga udik kw'kk'aam asia maa e.”</para>
  <para style="p" vid="2SA 13:16">Okhenka, khẹ itọhng nọ́khọma. <verse eid="2SA 13:16" /><verse number="17" style="v" sid="2SA 13:17" />Oter oyeri ọtọhmnạng kwẹ, oben bẹ́, “Khubh ikwanạng nwa ma ubin-m k'ititikha, akpạkh-ẹ ukhubh!” <verse eid="2SA 13:17" /><verse number="18" style="v" sid="2SA 13:18" />Mạnna wọ ọtọhmnạng kwẹ utum-ẹ ọbhạrẹ k'iyaan, ọkpạkh-ẹ ukhubh. Wa Tamar oge iwuru ch'epe akpokha, ch'ede iwuru-khira ch'uwa aminava p'ọvaarnạng p'nạn ajunung tạma násonga n'age. <verse eid="2SA 13:18" /><verse number="19" style="v" sid="2SA 13:19" />Tamar ọta okpokhu itạtọhng ububha k'echo, ọvạkha iwuru ch'oge ọyaakhẹ. Ọtạkha mbọhk ọtọhkha k'echọ, ọgạma k'ẹrạng-k'ẹrạng ofona.<verse eid="2SA 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 13:20" />Nnwọkka Absalọm ọbạbh-ẹ bẹ́, “Nnwatte Amnọn, kk'abọ uyima sa? Nnwọkka kwaam kkuma ẹmạng; nnwatte kwọ wọ mạma e. Udik ngwa k'ettem káge.” Tamar n'urukhu ikwosi-ikwosi k'ọchọhm kw'nnwọkka Absalọm.<verse eid="2SA 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 13:21" />Masẹ ọvaar Devid ọbhaang udik ngwọ, ettem ipyibh-ẹ. <verse eid="2SA 13:21" /><verse number="22" style="v" sid="2SA 13:22" />Absalọm udik gwạnọ-gwạnọ kw'ujibh-ujibh ọbạra ode kw'upyibh-upyibh nọ́kpaakha ọnạng Amnọn ma udik ngwọ. Okhenka, uwun Amnọn k'ọkpạrsia-dik kw'kk'usia ọnạng Tamar, kw'ode nnwọkka kwẹ.<verse eid="2SA 13:22" /></para>
  <para style="s1">Absalọm ọfhọ Amnọn</para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 13:23" />Masẹ icho ifa kk'isenga, k'okpe kw'atọhmnạng p'Absalọm, p'n'aphyiri arạkhạmaan aphyạbha aning k'Baal-Hazọr, kw'ọbaanga Ephraim, wa Absalọm obher ajunungva p'ọvaarnạng phyibh bẹ́, abẹ akwu akhebh-ẹ kha. <verse eid="2SA 13:23" /><verse number="24" style="v" sid="2SA 13:24" />Ma wọ Absalọm ofon ọta okhebha ọvaarnạng oben bẹ́, “Atọhmnạng paam n'aphyiri arạkhạmaam aphyạbha. Totokhạn, tte ọvaarnạng ọttạra atọhmnạng pẹ akwu aninga abamẹ.”<verse eid="2SA 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2SA 13:25" />Ọvaarnạng oben bẹ́, “Mma e, nnwa kwaam, tte amạna phyibh nạngẹ anta khiri akwẹ m'ọdọhbh-ọ kidaam-kidaam.” Chibhi s'Absalọm ọkwẹ-ẹ, nóchera bẹ́ ọta, okhenka ọyọhbh-ẹ itta.<verse eid="2SA 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 13:26" />Ma wọ Absalọm obeni bẹ́, “Ọbạra mákke akwu, totokhạn tte nnwotte kwaam Amnọn ọbọhk ọtwạn mạna abẹ.”</para>
  <para style="p" vid="2SA 13:26">Ọvaarnạng ọbạbh-ẹ bẹ́, “K'ayạn kw'ẹma m'ọtwạn abọ o?” <verse eid="2SA 13:26" /><verse number="27" style="v" sid="2SA 13:27" />Okhenka, Absalọm ofon ororo ọkwẹ-ẹ tạrr ọvaarnạng osenga ma, otte Amnọn ọttạra ajunungva mbọkha pẹ ọbọhk, abẹ atwạn abẹ afona.<verse eid="2SA 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2SA 13:28" />Masẹ bẹ akpir kha, Absalọm oben atọhmnạng pẹ bẹ́, “Akhọhmọ itọhng! K'okpe kw'Amnọn kk'atwuk ubuma, mben bạnga bẹ́, ‘Abạnga avun Amnọn afhọ,’ afhẹ-ẹ, nạngẹ bạnga ojor khiri amma wọ nnạngẹ bạnga ẹfa. Abạnga akpọhkhọ ifor akhọhkha ijunung. <verse eid="2SA 13:28" /><verse number="29" style="v" sid="2SA 13:29" />Wa atọhmnạng p'Absalọm asi Amnọn oche kw'Absalọm kk'bẹ ẹfa ọnạnga. Ma wọ ajunungva p'ọvaarnạng abin ata avura k'nnyạnyaang sabẹ arạbh afona.<verse eid="2SA 13:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 13:30" />Masẹ abẹ atim aseng k'eden, ẹkkaabha ekhebha Devid bẹ́, “Absalọm kk'ajunungva p'ọvaarnạng ọfha phyibh e, ọnạng wạnọ-wạnọ núrikha.” <verse eid="2SA 13:30" /><verse number="31" style="v" sid="2SA 13:31" />Ọvaarnạng ubina, ọyaakhẹ ẹnya ch'oge k'ifor, uyima k'isisek; atọhmnạng pẹ phyibh ayaakhẹ sabẹ age k'ifor, abạra aninga abẹ ma.<verse eid="2SA 13:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2SA 13:32" />Okhenka, Jonadab kw'ode ujunung-nwa kw'Shimeyi, kw'ode nnwotte kw'Devid, oben bẹ́, “Tte aro kwaam nạngẹ ọtạk bẹ́, abẹ afhọ avaar-va phyibh; Amnọn mạnkeni wọ ope e. Ode nttọhna s'Absalọm kk'ọkhạma ochok, tạma k'iwu ch'Amnọn uyim nnwọkka Tamar abẹ k'ẹfa. <verse eid="2SA 13:32" /><verse number="33" style="v" sid="2SA 13:33" />Aro ọvaar kwaam, ettem nạng-ọ ẹmma ẹphyaangẹ k'ẹkkaabha ch'ikpir-ọ bẹ́, avaar-va phyibh kk'apua. Amnọn mạnkkeni wọ ope.”<verse eid="2SA 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="2SA 13:34" />Ayongu ma, Absalọm kk'ọrạbha.</para>
  <para style="p" vid="2SA 13:34">Masẹ utik-ibyi udir achen okkeri k'ororo osẹ anạng k'ọsaabh k'eden, k'ukhubha kw'ọchọhkha-dudon n'udimi, n'asạkha k'okpecho ọkhaan-ọkhaan n'akwu. Utik-ibyi nwọ ofona ọta ọkpaak ọvaarnạng bẹ́, “Attitte, nse ajunung k'ọsaabh p'abin k'ukhubha kw'Horonayim k'okpecho ọkhaan-ọkhaan n'asenga akwu e.”<verse eid="2SA 13:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="2SA 13:35" />Jonadab oben ọvaarnạng bẹ́, “Kker e, ajunungva p'ọvaarnạng kk'akpira ttạng e; akwẹ kk'udia k'oche kw'amma otọhmnạng kwọ mbeni e.”<verse eid="2SA 13:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="2SA 13:36" />Masẹ ọkpaakhẹ udik ngwọ ọsa, ajunungva p'ọvaarnạng akpira, ẹmạng achẹ ka ẹrạng-k'ẹrạng. Wa Ọvaarnạng ọttạra ikhaana sẹ phyibh agba agạma ẹmạng njọ ipyibh-ipyibha.<verse eid="2SA 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="2SA 13:37" />Wa Absalọm ọrạbhọ ọta okhebha Talmayi, ujunungnwa kw'Amihud, kw'ode ọvaarnạng kw'Gẹshur. Okhenka, wa ọvaar Devid utim nkwuna s'nnwa kwẹ Amnọn, k'iwu s'isaabh-ọsaabh.<verse eid="2SA 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="2SA 13:38" />Masẹ Absalọm ọrạbhọ ofona k'Gẹshur, wa uning ma k'icho ittaan. <verse eid="2SA 13:38" /><verse number="39" style="v" sid="2SA 13:39" />Wa ọvaar Devid utwu-ẹ k'ettem bẹ́, wạra ose Absalọm, ukwuru s'kk'ottem-fokhu ọkhaama k'obo kw'Amnọn.<verse eid="2SA 13:39" /></para>
  <chapter eid="2SA 13" />
  <chapter number="14" style="c" sid="2SA 14" />
  <para style="s1">Absalọm ọkpa nnạm k'Jẹrusalẹm</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 14:1" />Wa Joab kw'ode nnwa kw'Zẹruya osong bẹ́, ettem ch'ọvaarnạng ining k'Absalọm. <verse eid="2SA 14:1" /><verse number="2" style="v" sid="2SA 14:2" />Ma wọ Joab ọtọhmọ ọnạng k'Tẹkoa bẹ́, ọta ọtạkha ikwanạng wạnọ kw'odongu-odongu utima ukwu. Joab wa obeni ikwanạng nwọ bẹ́, “Ọma si nkkari bẹ́, aning epokwa. Age ọvạra-bina. Ana bạnọ-bạnọ káfọhnọ. Si masẹ ọnạng kw'kk'epokwa uninga k'iwu-saabhada. <verse eid="2SA 14:2" /><verse number="3" style="v" sid="2SA 14:3" />Sọhng k'ọvaarnạng ata akpaakh-ẹ idik nna s'mkpaakh-ọ maa.” Joab ukwu ọtọhn-ẹ oche kw'm'okpaak.<verse eid="2SA 14:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 14:4" />Okpe kw'ikwanạng nwọ kw'ubin Tẹkoa ukpir k'ọvaarnạng, ọrạkha uttima ititikha k'isisek k'ikpukpobha oben bẹ́, “O ọvaarnạng, kkaan-m e!”<verse eid="2SA 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 14:5" />Ọvaarnạng ọbạbh-ẹ bẹ́, “Mbạng vọ ọphyaang-ọ ẹmma?”</para>
  <para style="p" vid="2SA 14:5">Ikwanạng nwọ ọpọhn-ẹ bẹ́, “Amma nde opokwa; udim kwaam kk'upua. <verse eid="2SA 14:5" /><verse number="6" style="v" sid="2SA 14:6" />Amma ọtọhmnạng kwọ nkhaam ajunungva afa. Wa abẹ arim ayok abẹ k'owonu k'okpe kw'ọnạng nạnóde kw'ọkkaan bẹ irima. Oyok wạnọ uvun oyok ọfhọ. <verse eid="2SA 14:6" /><verse number="7" style="v" sid="2SA 14:7" />Mantọmma, efona chaam phyibh n'iwun-m uwuna, n'eben-m bẹ́, ‘Nạng mạna oyok nwọ kw'ọfhọ nnwọkka, ọfha amạna amgba amfhẹ-ẹ, antera echo ch'nnwọkka kw'ọfhọ; ọbạra m'andim-ẹ ẹbochia.’ Maa, sabẹ n'adimi akpen p'nnwa nwọ wạnọ kw'urikh-m o? Sabẹ n'adimi eche ch'udim kwaam ọttạra ẹchọhmfhạr chẹ ma ọyagbin o?”<verse eid="2SA 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 14:8" />Wa ọvaarnạng obeni ikwanạng nwọ bẹ́, “Sọhng mạna, amma m'nttọhnọ udik ngwọ nnạng-ọ.”<verse eid="2SA 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 14:9" />Tạrr oseng mạma, ikwanạng nwọ kw'ubin Tẹkoa oben-ẹ bẹ́, “Tte aro ọvaar kwaam ubina ọnạng amma ọttạra ẹchọhmfhạr ch'otte kwaam. Tte ọvaarnạng ọttạra ẹvaarchi chẹ nạngẹ ipina ẹkhaam.”<verse eid="2SA 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 14:10" />Ọvaarnạng ọpọhna bẹ́, “De ọnạng kwidede ọphyaang-ọ ẹmma, tim-ẹ kwu. Kwạna abẹ dạk kọ ẹmma máphyaangẹ.”<verse eid="2SA 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 14:11" />Ikwanạng nwọ ọbẹ́, “Tte ọvaarnạng ochekhi k'eche ch'Ọvaar Ubinọkpaabyi, kw'ode Ubinọkpaabyi kwẹ, bẹ́, ẹma ọnạng wạnọ-wạnọ ọbọhk mótte utwukha ẹnạng-fha njọ, ọfha abẹ nạngẹ nnwa kwaam afhọ.”</para>
  <para style="p" vid="2SA 14:11">Ọvaarnạng ọpọhna bẹ́, “S'Ọvaar Ubinọkpaabyi urukhu akpen, isisira-naanga s'nnwa kwọ k'isek mítto.”<verse eid="2SA 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 14:12" />Ma o, ikwanạng nwọ oben bẹ́, “Attitte, tte amma ọtọhmnạng kwọ mkpaak ọvaarnạng kwaam udik e.”</para>
  <para style="p" vid="2SA 14:12">Ọvaarnạng ubhin-ẹ bẹ́, “Kpaak udik!”<verse eid="2SA 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 14:13" />Ikwanạng nwọ n'obeni bẹ́, “Asi yạn attọhnọ ipyibha-khira nja atena anạng p'Ubinọkpaabyi? De ọvaarnạng ọkpaakhẹ udik demakwẹ ngwa, ẹma oyeni sạng kw'ọbhạkhẹ upyima ma, s'ọvaarnạng nạn nnwa kwẹ kw'ukhubhu tạm nútima ọkpa nnạm o? <verse eid="2SA 14:13" /><verse number="14" style="v" sid="2SA 14:14" />Masẹ asi p'abyeng k'isisek p'ọnạng nạn adạkhẹ mókke utima ọkpa nnạm, mạnna wọ m'ampe. Nttọhna s'Ubinọkpaabyi oche ngwọ nídia. Okhenka, ẹma oter oror bẹ́ ọnạng kw'abẹ akhubh-ukhubh ọkpa nnạm otor-ẹ.<verse eid="2SA 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 14:15" />“Amma kk'nkwua bẹ́, nkwu mkpaak aro kw'ode ọvaarnạng kwaam udik ngwa, ukwuru bẹ́, anạng mbọ kk'asia ojor-m. Amma ọtọhmnạng kwọ kk'nkka bẹ́, ‘De mkpaakhẹ ọvaarnạng udik ngwa, nudusi, m'usi ọttọhk f'mphyem-ẹ ọnạng-m. <verse eid="2SA 14:15" /><verse number="16" style="v" sid="2SA 14:16" />Nudusi, ọvaarnạng m'ocher-ochera bẹ́, ọkkaana orengi amma ọtọhmnạng kwẹ k'mbọhk s'ujunung kw'n'okhonga bẹ́, ọrạm amma ọttạra nnwa kwaam k'okhebh f'Ubinọkpaabyi ochokhu mạna.’<verse eid="2SA 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 14:17" />“Ẹgwọ usi amma ọtọhmnạng kwọ nkkẹ bẹ́, ‘Tte ọtọhnga kw'aro ọvaar kwaam okkeri okhebh pfaam, ukwuru bẹ́, aro ọvaar kwaam ode masẹ oseng-eden kw'Ubinọkpaabyi, kw'osong ijibha ọttạra ipyibha. Tte Ọvaar Ubinọkpaabyi, kw'ode Ubinọkpaabyi kwọ uninga abọ.’ ”<verse eid="2SA 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 14:18" />Ma o, ọvaarnạng oben ikwanạng nwọ bẹ́, “Khaam ibhina ch'udik kw'm'mbạbh-ọ maa, kádubh o.”</para>
  <para style="p" vid="2SA 14:18">Ikwanạng nwọ ọbẹ́, “Tte aro ọvaar kwaam ọbạbh kadẹ o.”<verse eid="2SA 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 14:19" />Ọvaarnạng ọbạbh bẹ́, “Ọma nákka bẹ́, ọbọhk kw'Joab uning ma udik ngwa?”</para>
  <para style="p" vid="2SA 14:19">Ikwanạng nwọ ubhina bẹ́, “S'ọma aro ọvaar kwaam arukhu akpen, ọnạng wạnọ-wạnọ kw'm'ọkhạmọ udik usi, oyonga kw'aro ọvaar kwaam ọkpaakhẹ, kóde. Akwẹ ode udik ọkka bẹ́, ọtọhmnạng kwọ, Joab, wọ ọtọhn-m bẹ́, nsi udik ngwa. Ẹma wọ ọbạra ọtọhn amma ọtọhmnạng kwọ idik s'mkpaakhẹ maa phyibh. <verse eid="2SA 14:19" /><verse number="20" style="v" sid="2SA 14:20" />Wa Joab kw'ode ọtọhmnạng kwọ usi oche ngwọ ọfha utima ma ọbhạkhẹ idik ininga. Aro kwaam ọkhaam ekkoji masẹ oseng-eden kw'Ubinọkpaabyi, ẹma osong udik kwidede ma kw'n'otto maa isek nna.”<verse eid="2SA 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 14:21" />Ma wọ ọvaarnạng obeni Joab bẹ́, “Ọbaan ma, m'nsi-usi oche ngwọ. Ọma sọhng ata atima udikkobh nwọ kw'ode Absalọm tima kpa nnạm.”<verse eid="2SA 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 14:22" />Joab otto ukhubha ititikha k'isisek k'ikpukpobha, ọbạra odo ọvaarnạng. Oben bẹ́, “Amma ọtọhmnạng kwọ kk'nsonga bẹ́, kk'ọphyaam nkhaama k'ititikha s'aro ọvaar kwaam chemma, ukwuru s'ọvaarnạng kk'amma ọtọhmnạng kwẹ ephyema chẹ ọnạnga.”<verse eid="2SA 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 14:23" />Ma wọ Joab ubin ofona k'Gẹshur ọta ọtạkha Absalọm utima ọkpa nnạm k'Jẹrusalẹm. <verse eid="2SA 14:23" /><verse number="24" style="v" sid="2SA 14:24" />Okhenka, ọvaarnạng oben bẹ́, “Absalọm m'ofona k'akhẹ k'ọchọhm, nạn-nóra bẹ, ose ititikha saam.” Mạnna wọ kw'Absalọm osengi ofona k'akhẹ k'ọchọhm, ititikha s'Ọvaarnạng núsia.<verse eid="2SA 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2SA 14:25" />Wa k'Israẹl phyibh, ọnạng kóde kw'abẹ atọhng ajibhada pẹ, masẹ mbọ p'Absalọm. Tạma k'echo tạrr ukpira k'mfhokpatwạkhọ, ọraak kọ́khaam. <verse eid="2SA 14:25" /><verse number="26" style="v" sid="2SA 14:26" />Wa n'uphyiri isisira sẹ okpe gwạnọ k'cho, ukwuru s'asẹ n'idọhbh-ẹ ọdọhbh. Okpe kwidede kw'uphyiri isisira sẹ, adọhbh p'isisira sẹ n'ikpira ashẹkẹl arạbh jobh, itor k'oche kw'abẹ n'ayoma adọhbh py'ekpo k'ọvaarchọhm.<verse eid="2SA 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2SA 14:27" />Wa Absalọm ọkhaam ajunungva attaan ọttạra ọkwanạngnwa. Wa ọkwanạngnwa nwọ okpen Tamar, ọbạra ujibh ikwanạng.<verse eid="2SA 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2SA 14:28" />Wa Absalọm urukhu k'Jẹrusalẹm icho ifa, okhenka, ititikha s'ọvaarnạng nókke ose. <verse eid="2SA 14:28" /><verse number="29" style="v" sid="2SA 14:29" />Absalọm ọtọhm bẹ́, abe ayeri Joab anạng-ẹ, ọfha ọtọhm-ẹ k'ọvaarnạng. Okhenka, Joab ufhumu eyera njọ. <verse eid="2SA 14:29" /><verse number="30" style="v" sid="2SA 14:30" />Ma wọ obeni atọhmnạng pẹ bẹ́, “Akkeri, owonu ngwọ kw'Joab kw'uning ọbaanga kwaam, ọkhaam abarli. Asọhng ata akkạmọ kwẹ.” Mạnna wọ kw'atọhmnạng p'Absalọm akkạmọ owonu kw'Joab.<verse eid="2SA 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="2SA 14:31" />Joab ofona ọta okhebha Absalọm oben-ẹ bẹ́, “Ukwuru yạn kw'atọhmnạng pọ ata akkạmọ owonu kwaam o?”<verse eid="2SA 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2SA 14:32" />Absalọm oben Joab bẹ́, “Kker e, amma ntọhmọ ẹkkaabha bẹ́ akwu, ọfha ntọhm-ọ ata abạbh ọvaarnạng bẹ́, ‘Mbạng vọ f'nseng apfẹ mbina k'Gẹshur nkwuna ma o? De wạra nning kha wọ m'ujibh-m ọtạm!’ Masẹ n'nning maa, nnoru bẹ́ nse ititikha s'ọvaarnạng e. Ode kk'mpina k'eden chidede, tte ọfhọ-m.”<verse eid="2SA 14:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="2SA 14:33" />Ma wọ Joab ubin ofona k'ọvaarnạng ọta ọkpaakh-ẹ udik ngwọ. Wa ọvaarnạng oyeri Absalọm kw'ukwu ọrạkha uttima ititikha k'isisek, k'ikpukpobha. Ọvaarnạng ọbaakh-ẹ.<verse eid="2SA 14:33" /></para>
  <chapter eid="2SA 14" />
  <chapter number="15" style="c" sid="2SA 15" />
  <para style="s1">Ẹgbaan-maana ch'Absalọm usi</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 15:1" />Ukwu ukpira k'okpe ma, Absalọm ọtạkha ọkpaar kw'nnyạnyaang n'itwạr, ọttạra nnyạnyaang, ukwu ọttạra k'ajunung arạbh afa ukuma jobh bẹ́, abẹ achiẹ-ẹ eden. <verse eid="2SA 15:1" /><verse number="2" style="v" sid="2SA 15:2" />Wa n'ọpạm-ọpạm ọta obe k'eden ọkhaan-ọkhaan ch'eten k'ẹbaakhamma ch'efhon-diden. Okpe kwidede kw'ọnạng utim iponga bẹ́, ọta okhebha ọvaarnạng ọfha ọttọhnọ, Absalọm m'oyeri ọnạng nwọ ọbạbh-ẹ bẹ́, “Ọma abin bạng ofhon?” Ọnạng nwọ m'ubhina bẹ́, “Amma ọtọhmnạng kwọ mbin k'ẹkhạma jạnẹ ch'Israẹl.” <verse eid="2SA 15:2" /><verse number="3" style="v" sid="2SA 15:3" />Ma wọ, Absalọm m'oben-ẹ bẹ́, “Kker e, iponga nna ijibhi ọma, ibạra itor-otor, okhenka ode bẹ́, ọnạng kw'm'ọkhọhm-ọ itọhng k'echo ch'ọvaarnạng kòde e.” <verse eid="2SA 15:3" /><verse number="4" style="v" sid="2SA 15:4" />Absalọm m'ọttạra bẹ́, “Wạra abẹ n'asi-m ọkpaar-aponga ma isek nna o! Ọnạng kwidede kw'ọkhaam udik kw'ọphyaangẹ-ẹ ẹmma, ọbạra ode iponga, m'ukwu okhebh-m, wạra m'n'mkpaara iponga s'm'irebh ọnạng kwidede ettem.”<verse eid="2SA 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 15:5" />Okpe kwidede kw'ọnạng oseng ofora Absalọm k'ifor bẹ́, ọrạkha uttima ititikha k'isisek usim-ẹ, Absalọm m'onemi ọbọhk ọvạkh-ẹ ubina, ọbaakh-ẹ. <verse eid="2SA 15:5" /><verse number="6" style="v" sid="2SA 15:6" />Wa Absalọm n'usi oche ngwọ ọnạng anạng p'Israẹl phyi-phyibh p'atim iponga akwu bẹ́, ọvaarnạng oponga ọnạng bẹ. Osenga ma, odebh nttem s'anạng p'Israẹl.<verse eid="2SA 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 15:7" />Masẹ icho innebung kk'isenga, Absalọm oben ọvaarnạng bẹ́, “Tte nta k'Hẹbrọn, ọfha nta nnạng ẹyaakha ch'echekha ch'uwa ntạk nnạng Ọvaar Ubinọkpaabyi. <verse eid="2SA 15:7" /><verse number="8" style="v" sid="2SA 15:8" />Masẹ wa ọtọhmnạng kwọ urukhu k'Gẹshur k'ẹkhạma ch'Aram, wa ntạk echekha bẹ́, ‘De Ọvaar Ubinọkpaabyi utim-m ọkpa nnạm k'Jẹrusalẹm, amma m'mkpobha Ọvaar Ubinọkpaabyi k'Hẹbrọn.’ ”<verse eid="2SA 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 15:9" />Ọvaarnạng oben-ẹ bẹ́, “Sọhng k'idira.” Mạnna wọ kw'Absalọm osengi ofona k'Hẹbrọn.<verse eid="2SA 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 15:10" />Wa Absalọm ọtọhmọ abaan-ibyi k'nkhạma s'Israẹl phyi-phyibh bẹ́, abẹ ata aben bẹ́, “De abạnga abhaang sabẹ age ẹsa <char style="it">bẹ́ ẹ</char>, annemi eden awạmọ k'ẹrạng-k'ẹrạng bẹ́, Absalọm kk'ọvaarnạng udia k'Hẹbrọn e!” <verse eid="2SA 15:10" /><verse number="11" style="v" sid="2SA 15:11" />Wa ajunung arạbh jobh p'abin k'Jẹrusalẹm bọ atwạnọ Absalọm abẹ. Obheri bẹ masẹ anạng p'akwu udik kw'abẹ nạnásong. <verse eid="2SA 15:11" /><verse number="12" style="v" sid="2SA 15:12" />Masẹ Absalọm n'ọfọhnọ nja, wa ọbạra ọtọhm abẹ ayeri Ahitophẹl kw'ubin Gilo, kw'n'ọnạng Devid ntọhna, ubina k'Gilo kw'ode ofhon kwẹ ukwu. Ma wọ nttọhna-pyibha s'Absalọm ido ikpọhkhọ-ọkpọhkhọ, ikhaana sẹ ido isaabh-ọsaabh.<verse eid="2SA 15:12" /></para>
  <para style="s1">Devid ọrạbhọ urik Jẹrusalẹm</para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 15:13" />Wa itọhmọ rạnẹ ikwu ikpaak Devid bẹ́, “Nttem s'anạng p'Israẹl ining k'Absalọm e.”<verse eid="2SA 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 15:14" />Ma wọ Devid obeni atọhmnạng pẹ p'aning abẹ k'Jẹrusalẹm bẹ́, “Akwu annạbh o, deja, ọnạng wạnọ-wạnọ kw'm'ọnnaanga k'mbọhk s'Absalọm kòde e. Ọbaan bẹ́, ambina amfona ẹbhạr-ẹbhạr, deja, m'ọta ọkhạbhọ mạna oro udimi mạna, ọbạra utima ọkkangkkang-kkro ọfhọ anạng p'efhon-diden.”<verse eid="2SA 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 15:15" />Ikhaana s'ọvaarnạng ibhin-ẹ bẹ́, “Atọhmnạng pọ kk'ifor adia atik bẹ́, asi fidede f'aro ọvaar kwamạna obeni.”<verse eid="2SA 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 15:16" />Mạnna wọ ọvaarnạng ubin osenga, anạng p'ẹchọhmfhạr chẹ phyibh abẹ. Okhenka, wa ubin urik ayok pẹ ncho jobh bẹ́, abẹ aninga akkeri ọvaarter. <verse eid="2SA 15:16" /><verse number="17" style="v" sid="2SA 15:17" />Wa ọvaarnạng utim anạng phyibh p'atwạnọ abẹ, abẹ asenga tạrr abẹ ata abe k'efhon-diden ọkhaan-ọkhaan. <verse eid="2SA 15:17" /><verse number="18" style="v" sid="2SA 15:18" />Wa atọhmnạng pẹ phyibh achiẹ-ẹ eden aseng. Ajunung p'Kẹrẹt ọttạra p'Pẹlẹt, ọttạra ajunung p'Git p'akpir ẹnọhna ukuma arạbh jobh p'atwạnọ ọvaarnạng abẹ abina k'Gat abạra achiẹ-ẹ eden.<verse eid="2SA 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 15:19" />Ọvaarnạng n'obeni Ittayi kw'ubin Git bẹ́, “Ode yạn kw'atwạnọ mạna abẹ? Ọma ade ukhikhennạng kw'ọrạbhọ ibira k'ofhon kwọ. Kpa nnạm ata aninga ọvaar Absalọm abẹ. <verse eid="2SA 15:19" /><verse number="20" style="v" sid="2SA 15:20" />Chạnachẹ-chạnachẹ wọ kw'akwu. M'nsi yạn ntte-ọ ọbọhk awena mạna abẹ, s'amma oyeni nạn ibyi nsong s'n'anten-otena? Tima anạng pọ phyibh kpa nnạm. Tte Ọvaar Ubinọkpaabyi usi bạnga ọphyaam, ọbạra ọkhọhkha bạnga idạdaakha.”<verse eid="2SA 15:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 15:21" />Okhenka, Ittayi n'ubhin ọvaarnạng bẹ́, “K'oche kw'Ọvaar Ubinọkpaabyi urukhu akpen, ọttạra k'oche kw'aro ọvaar kwaam ọbạra uruk akpen, ibyi sidede s'aro ọvaar kwaam uning, ode obo, ode akpen, amma ọtọhmnạng kwọ m'mbe abọ ma.”<verse eid="2SA 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 15:22" />Devid oben Ittayi bẹ́, “Fona ororo k'osenga kwọ.” Mạnna wọ kw'Ittayi kw'ubin Git ubin osenga ọttạra ajunung pẹ, ọttạra ichọhmfhạr s'ining abẹ.<verse eid="2SA 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 15:23" />Wa anạng phyibh p'ẹkhạma njọ agạm mmạng k'ẹrạng k'okpe kw'anạng mbọ n'asenga ayongu bẹ. K'okpe kw'ọvaarnạng n'ojekha Ipekhuma s'Kidrọn, ikhaana sẹ phyibh itwạnọ abẹ, abẹ asenga atena k'ukhubha kw'anạng nạnárukha.<verse eid="2SA 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 15:24" />Wa Zadọk ọgba uninga ma, ọttạra aLẹvi phyi-phyibh p'n'adira Ikwukwur s'Echekha ch'Ubinọkpaabyi. Wa abẹ aber Ikwukwur nnọ s'Echekha ch'Ubinọkpaabyi k'isisek. Abiyata ọfọhnọ nja tạrr anạng mbọ atte efhon-diden njọ ọbọhk phyibh.<verse eid="2SA 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2SA 15:25" />Ma o, ọvaarnạng oben Zadọk bẹ́, “Tima Ikwukwur s'Echekha ch'Ubinọkpaabyi akpa nnạm k'efhon-diden. De amma nkhaam ọphyaam k'ititikha s'Ọvaar Ubinọkpaabyi, m'utim-m utima ọkpa nnạm maa. M'ọbạra usi-m nse Ikwukwur nna, ọttạra ibyirukhasẹ sẹ. <verse eid="2SA 15:25" /><verse number="26" style="v" sid="2SA 15:26" />Okhenka, de obeni bẹ́, ‘Ettem khaam nérebha ọttạra abọ,’ amma kk'ifor ndia; tte usi-m oche kw'ọdaakh-ẹ.”<verse eid="2SA 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2SA 15:27" />Wa ọvaarnạng ọbạra oben Zadọk kw'ode ọfọhnẹja bẹ́, “Akwẹ khọ nọ́ttaana o? Tạkha idia chaam kpa nnạm k'efhon-diden. Tima Ahimaz kw'ode nnwa kwọ, ọttạra Jonatan kw'ode nnwa kw'Abiyata kpa nnạm. Ọma ọttạra Abiyata, abạnga atima iva mbọ afa pabạnga akpa nnạm. <verse eid="2SA 15:27" /><verse number="28" style="v" sid="2SA 15:28" />Amma m'nninga k'ibyi s'anạng n'asenga ajekha afona k'ibyi s'anạng nạnárukha, tạrr ẹkkaabha chọ ikpir-m.” <verse eid="2SA 15:28" /><verse number="29" style="v" sid="2SA 15:29" />Mạnna wọ wa Zadọk ọttạra Abiyata atim Ikwukwur s'Echekha ch'Ubinọkpaabyi akpa nnạm, ata aninga k'Jẹrusalẹm.<verse eid="2SA 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 15:30" />Okhenka, wa Devid ofon ororo uvura Okpecho kw'Oliv. Wa ububh ọttọhk k'echo, utima mfhok eje n'ọgạma ẹmạng utima osenga. Anạng p'ator-ẹ, abạra abubha ekpo k'echo n'agạma avura okpecho ator-ẹ nnạm. <verse eid="2SA 15:30" /><verse number="31" style="v" sid="2SA 15:31" />Masẹ abẹ kk'Devid akpaakha bẹ́, “Ahitophẹl ọgba ọttạra k'ikhaana s'anạng p'Absalọm n'utima okkobha ikwung e,” ma wọ Devid ose njọhm oben bẹ́, “O Ọvaar Ubinọkpaabyi, si ntọhna s'Ahitophẹl ibhạkhẹ idindingi.”<verse eid="2SA 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2SA 15:32" />Masẹ Devid ukpir k'okpecho k'ẹrạng, k'ibyi s'anạng n'aninga akpobha Ubinọkpaabyi, Hushayi kw'ubin Ark utim ọnọhma kw'kk'ọyaakha k'ifor, abubuma abẹ kha echo. <verse eid="2SA 15:32" /><verse number="33" style="v" sid="2SA 15:33" />Devid oben-ẹ bẹ́, “De m'atwạn-m abẹ, m'ade ẹtọhkha anạng-m e.” <verse eid="2SA 15:33" /><verse number="34" style="v" sid="2SA 15:34" />Okhenka, de akpa nnạm k'efhon-diden ata aben Absalọm bẹ́, ‘Aro ọvaar, amma nde ọtọhmnạng kwọ. Wa nde ọtọhmnạng kw'atte, mantọmma, n'nde ọtọhmnạng kwọ.’ Ma wọ m'akkaan-m, akhibhi ntọhna s'Ahitophẹl. <verse eid="2SA 15:34" /><verse number="35" style="v" sid="2SA 15:35" />Zadọk ọttạra Abiyata p'ade afọhnẹja m'aninga abọ ma. Kpaak bẹ udik kwidede kw'abhaang k'ọvaarter. <verse eid="2SA 15:35" /><verse number="36" style="v" sid="2SA 15:36" />Ajunungva afa pabẹ p'ade: Ahimaz kw'Zadọk ofhonu, ọttạra Jonatan kw'Abiyata ofhonu, aning abẹ ma. De abhaang udik kwidede, tọhm bẹ abẹ akwu atekh-m.<verse eid="2SA 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="2SA 15:37" />Ma o, Hushayi kw'ode oyok-udikkobh kw'Devid ukpir k'Jẹrusalẹm k'okpe kw'Absalọm n'ọnwa k'efhon-diden.<verse eid="2SA 15:37" /></para>
  <chapter eid="2SA 15" />
  <chapter number="16" style="c" sid="2SA 16" />
  <para style="s1">Devid ọttạra Ziba</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 16:1" />Masẹ Devid kk'osenga oyongu okpecho nwọ, n'ose Ziba kw'ode ọtọhmnạng kw'Mẹphiboshẹt s'obe ma n'utikh-ẹ. Wa ọdạbhẹ achikkọhbhọ k'nnyạnyaang, ọbạra ọtạkha abrẹd-dwuk arạbh jobh, ọttạra igbugbo s'agrep p'agwu-ugwu akwua arạbh asen, ọttạra igbugbo s'fig akwua arạbh asen, ukwu ọttạra k'atwuk p'abẹ age k'ẹkpa ch'abẹ atim otenkpa asi, utima utik Devid.<verse eid="2SA 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 16:2" />Wa ọvaarnạng ọbạbhọ Ziba bẹ́, “Atim ekpo mbyama akwu kha mbạng o?”</para>
  <para style="p" vid="2SA 16:2">Ziba ubhina bẹ́, “Nnyạnyaang nna ide s'ẹchọhmfhạr ch'ọvaarnạng m'n'ẹyaar. Brẹd ọttạra achidwuk mbọ ade p'adikkobh m'achi. Atwuk mbọ m'abạra n'asi ifor ikpọhkhọ ayok p'ẹfa kk'bẹ ẹsa, k'ibyi s'anạng nạn nárukha.”<verse eid="2SA 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 16:3" />Ọvaarnạng n'ọbạbhọ bẹ́, “Nnwa-mfhona kw'aro kwọ mo o?”</para>
  <para style="p" vid="2SA 16:3">Ziba oben bẹ́, “Ẹma uning kha Jẹrusalẹm, ukwuru s'ọkkẹ bẹ́ ‘chemma anạng p'Israẹl m'atte ẹvaar ch'otte kwẹ kwididen ọbọhk, anạng-ẹ.’ ”<verse eid="2SA 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 16:4" />Ọvaarnạng oben Ziba bẹ́, “Ọttọhk fidede f'Mẹphiboshẹt ọkhaam node pfọ.”</para>
  <para style="p" vid="2SA 16:4">Ziba ọbẹ́, “Aro ọvaar kwaam, ntwung echo k'ikpukpobha nnạng-ọ, tte nkhaama ọphyaam k'akhọ k'ititikha.”<verse eid="2SA 16:4" /></para>
  <para style="s1">Shimeyi unnukhu Devid</para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 16:5" />Masẹ ọvaar Devid ukpir k'ofhon kw'Bahurim, ujunung wạnọ kw'ubin k'ẹnạmma jạnẹ ọttạra ẹchọhmfhạr ch'Saul uyin kha, ọtạma innukhu kpạkpaak. Ujunung nwọ okpen Shimeyi, kw'ode nnwa kw'Gera. <verse eid="2SA 16:5" /><verse number="6" style="v" sid="2SA 16:6" />Wa n'ọbhạrẹ Ọvaar Devid ọttạra ikhaana sẹ ata. Node s'akpongnạng ọttạra anạng p'n'atik Devid aning-ẹ k'udimbọhk ọttạra k'ọkwabọhk. <verse eid="2SA 16:6" /><verse number="7" style="v" sid="2SA 16:7" />Wa Shimeyi n'unnukhu Devid oben bẹ́, “Bina maa ibyi nna, sọhng afona! Ọfhọ-anạng masẹ akhọ! Ubyibyanạng! <verse eid="2SA 16:7" /><verse number="8" style="v" sid="2SA 16:8" />Ọvaar Ubinọkpaabyi kk'ọ irem ọnạnga kk'anạng p'afhọ k'ẹchọhmfhạr ch'Saul, kw'atạk ẹvaar k'akhẹ k'mbọhk adạbh. Ọvaar Ubinọkpaabyi kk'ẹvaar njọ ọtạkha k'akhọ k'mbọhk, ọnạng nnwa kwọ Absalọm. N'aning k'irem, ukwuru anạng mbọ p'afhọ!”<verse eid="2SA 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 16:9" />Ma wọ Abishayi kw'ode nnwa kw'Zẹruya obeni ọvaarnạng bẹ́, “Ukwuru yạn kw'ọpfa-bukhu nwa n'unnukhu aro ọvaar kwaam oche ngwa? Tte-m ọbọhk nta mpe-ẹ echo!”<verse eid="2SA 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 16:10" />Okhenka, ọvaarnạng oben bẹ́, “Udik ngwa osengi bạnga yạn o, abạngama iva p'Zeruya? De ode bẹ́ Ọvaar Ubinọkpaabyi wọ oben-ẹ bẹ́ unnukhu amma Devid, anẹ m'ọkhaama ẹfa ọbạbh bẹ́, ‘Ukwuru yạn kw'n'asi udik demakwẹ ngwa?’ ”<verse eid="2SA 16:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 16:11" />Mạnna wọ Devid obeni Abishayi ọttạra atọhmnạng pẹ phyibh bẹ́, “Yeyema kwaam oyeni kw'mfhonu-ofhon, n'oror nden s'm'ọfhọ-m, bạra wạra oBẹnjamin-nạng nwa o! Attẹ-ẹ ọbọhk unnukh-m, khiri Ọvaar Ubinọkpaabyi wọ oben-ẹ bẹ́ usi oche ngwọ. <verse eid="2SA 16:11" /><verse number="12" style="v" sid="2SA 16:12" />Nudusi, Ọvaar Ubinọkpaabyi okke-okke ose irem saam, utima idia ch'echekha chẹ, otera innukhu nja ch'Shimeyi unnukh-m chemma.”<verse eid="2SA 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 16:13" />Wa Devid ọttạra atọhmnạng pẹ afon ororo k'osenga kwabẹ k'okpe kw'Shimeyi n'ọbạra osenga k'ukhubha kw'okpecho kw'okker-ẹ ititikha, n'unnukhu Devid, ọbhạr-ẹ ata, ofhon-ẹ abubuma. <verse eid="2SA 16:13" /><verse number="14" style="v" sid="2SA 16:14" />Wa ọvaarnạng ọttạra anạng phyibh p'atwạnọ abẹ, akwu akpira k'ibyi sabẹ n'afona s'kk'bẹ obhema. Ma wọ wa Devid okwok ọyọhng.<verse eid="2SA 16:14" /></para>
  <para style="s1">Ntọhna s'Hushayi ọttạra Ahitophẹl</para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 16:15" />Wa Absalọm ọttạra ajunung p'Israẹl phyibh kk'akpira k'Jẹrusalẹm. Wa Ahitophẹl ọgba ọtwạn abẹ. <verse eid="2SA 16:15" /><verse number="16" style="v" sid="2SA 16:16" />Oyok-udikkobh kw'Devid kw'okpen Hushayi, kw'ubin Ark ọta okhebha Absalọm oben-ẹ bẹ́, “Tte ọvaarnạng uruk akpen p'adum-udum!”<verse eid="2SA 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 16:17" />Absalọm ọbạbhọ Hushayi bẹ́, “Idạdaakha s'akhọhk oyokh-udikkobh, asẹma rọ maa? Abạnga aseng iyok, ode yạn kw'nạ́n abẹ nátwạna afona?”<verse eid="2SA 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 16:18" />Hushayi oben Absalọm bẹ́, “Mma e, amma m'nninga nttạra ọnạng nwọ kw'Ọvaar Ubinọkpaabyi kk'otekha, kw'ode nwọ kw'anạng mba, ọttạra anạng p'Israẹl phyibh atek. <verse eid="2SA 16:18" /><verse number="19" style="v" sid="2SA 16:19" />Ọttạra bẹ́, anẹ wọ kw'amma m'nsi ọtọhm nnạng o? Ma nọ́baana bẹ́, nsi ọtọhm nnạng nnwa, k'oche kw'uwa nsi nnạng otte? Amma m'nsi ọtọhm nnạng ọma e.”<verse eid="2SA 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 16:20" />Absalọm oben Ahitophẹl bẹ́, “Nạng mạna ntọhna sọ khẹ. M'ansi yạn?”<verse eid="2SA 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 16:21" />Ahitophẹl ubhina Absalọm bẹ́, “Yima ayok p'atte abẹ, p'ochokhu bẹ́, abẹ akkeri ọvaarter. Ẹgwọ m'usi anạng p'Israẹl phyibh abhaanga bẹ́, kk'atte idik abạkha. Anạng p'abe atumọ n'abạra ado ẹfa akhaama-ọkhaama.” <verse eid="2SA 16:21" /><verse number="22" style="v" sid="2SA 16:22" />Mạnna wọ abẹ asi ukkira k'ọchọhm ẹrạng-ẹrạng anạng Absalọm. Uninga ma uyima ayok p'otte abẹ ma ititikha s'anạng p'Israẹl phyibh.<verse eid="2SA 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 16:23" />Ma okpe ngwọ, ntọhna s'Ahitophẹl ide masẹ ntọhna s'ọnạng ọdwạnọ Ubinọkpaabyi. Mạnna wọ kw'uwa Devid ọttạra Absalọm n'atạkha ntọhna sidede s'Ahitophẹl ọnạngẹ.<verse eid="2SA 16:23" /></para>
  <chapter eid="2SA 16" />
  <chapter number="17" style="c" sid="2SA 17" />
  <para style="p">
    <verse number="1" style="v" sid="2SA 17:1" />Ahitophẹl oben Absalọm bẹ́, “Tte ntekha ajunung nnọhna ẹrạbh ukuma jobh, ntima bẹ nkhubh Devid k'irunguwu nja chemma. <verse eid="2SA 17:1" /><verse number="2" style="v" sid="2SA 17:2" />Amma m'nnima abẹ k'okpe kw'kk'ẹ ọkhọhna, ẹfa ẹbạra ẹsẹ-ẹ. M'ngiẹ-ẹ ojora fididen k'ifor, ọfha anạng p'aning abẹ arạbh. M'mfhọ ọvaarnạng mạnkkeni, <verse eid="2SA 17:2" /><verse number="3" style="v" sid="2SA 17:3" />mbạra ntima anạng mbọ phyibh mkpa nnạm nkken-ọ. De ọnạng nwọ kw'aroru ope, anạng mbọkha phyibh, ọttọhk f'm'usi bẹ kòde.” <verse eid="2SA 17:3" /><verse number="4" style="v" sid="2SA 17:4" />Absalọm ọttạra adennạng p'Israẹl phyibh atạk ntọhna-khira nnọ masẹ udik ọkka.<verse eid="2SA 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 17:5" />Ma wọ Absalọm n'obeni bẹ́, “Ayeri Hushayi kw'ubin Ark ukwu, ọfha amgba ammaanga ẹkka chẹ.” <verse eid="2SA 17:5" /><verse number="6" style="v" sid="2SA 17:6" />Masẹ Hushayi ukpir, Absalọm oben-ẹ bẹ́, “Kkeri ntọhna s'Ahitophẹl kk'mạna ọnạnga e. Amạna ansi oche kw'ọkpaakhẹ o? Nạn oche ngwọ núdia, kpaak mạna ẹkka chọ.”<verse eid="2SA 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 17:7" />Hushayi n'ubhin Absalọm bẹ́, “Ntọhna s'Ahitophẹl ọnạngẹ ẹkpa nja kíjibhi. <verse eid="2SA 17:7" /><verse number="8" style="v" sid="2SA 17:8" />Hushayi ọbẹ́, “Ọma asong ma bẹ́, atte ọttạra anạng pẹ ade akpongnạng, p'abạra akkaam masẹ ekke ch'abẹ avạk iva ana. Ayongu ma, atte ode okpongnạng kw'ekkoji; maa múyima ọttạra akpongnạng pẹ ma irungu nja ma e. <verse eid="2SA 17:8" /><verse number="9" style="v" sid="2SA 17:9" />S'n'amkpaak maa, de nạn ma ọtakpamma gwạnọ núttubha, nudusi, uttubh kha ibyi idwạkh-ọdwạk. De uchi eden urima akpongnạng pọ abẹ, ọnạng kwidede kw'ọbhaang kwẹ m'oben bẹ́, ‘Abẹ nạngkha apekhi akpongnạng p'atoru Absalọm e.’ <verse eid="2SA 17:9" /><verse number="10" style="v" sid="2SA 17:10" />Ma wọ, ọbạra okpongnạng kw'ọbạrẹ ettem masẹ ekke wọ, ojora m'ọnẹ-ẹ ẹfa, ukwuru bẹ́, anạng p'Israẹl phyibh asong ma bẹ́ atte ode okpongnạng. Anạng p'aning abẹ abạra ade akkemkpa.<verse eid="2SA 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 17:11" />Ẹgwọ usi, ntọhna saam ide bẹ́, kkeri anạng p'Israẹl phyi-phyibh, tạma k'ẹkhạma ch'Dan tạrr akpira k'ẹkhạma ch'Beershẹba, kkeri oche kw'abẹ asaabhẹ masẹ uyiyeng kw'ẹraanga-kha, tte abẹma phyibh akwu attạr-ọ. Ọma oyeni m'atima bẹ eden ata ekpong. <verse eid="2SA 17:11" /><verse number="12" style="v" sid="2SA 17:12" />Ibyi sidede s'ankhebh atte, m'ambubh-ẹ ma ifor masẹ ebona ibubh isisek annima abẹ. Ẹma oyeni akpen múruk, ujunung wạnọ-wạnọ kwẹ kw'm'uruk akpen kòde. <verse eid="2SA 17:12" /><verse number="13" style="v" sid="2SA 17:13" />De ọrạbhọ ọnwa k'efhon-diden, anạng p'Israẹl m'atima ndikhi anwa ma ofhon ngwọ atwạr adimokpon p'ọbaakha kw'ofhon ngwọ ajẹ k'ipekhuma, ẹtakpong jạnẹ-jạnẹ mírik.”<verse eid="2SA 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 17:14" />Ma wọ Absalọm ọttạra ajunung p'Israẹl phyibh abeni bẹ́, “Ntọhna s'Hushayi kw'ubin Ark ijibhi ọtạm iyọhnga s'Ahitophẹl.” Wa Ọvaar Ubinọkpaabyi usi bẹ́ ntọhna ikkasẹ s'Ahitophẹl onạngẹ nạngẹ k'eden iyini, ọfha osenga ma otte ipyibha ọbọhk ikhebha Absalọm.<verse eid="2SA 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 17:15" />Wa Hushayi obeni Zadọk ọttạra Abiyata p'ade afọhnẹja bẹ́, “Ahitophẹl kk'Absalọm ọttạra adennạng p'Israẹl ọtọhna oche kw'abẹ m'asi. Okhenka, amma kk'bẹ ukhira ọdwạkh-ọdwạk ntekha kw'abẹ m'asi. <verse eid="2SA 17:15" /><verse number="16" style="v" sid="2SA 17:16" />Nemi eden tọhm ẹkkaabha nạng Devid bẹ́, ‘Nạngẹ k'ibyi s'anạng n'asenga ajekha k'ibyi s'anạng nạnárukha attaabh o. Nemi eden jekha k'ukhubha, deja, abẹ m'avạkha ọvaarnạng ọttạra anạng p'aning abẹ phyibh afhọ e.’ ”<verse eid="2SA 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 17:17" />Wa Jonatan ọttạra Ahimaz aning k'Ẹn-Rogẹl, sabẹ nạn nárora bẹ́ anạng ase bẹ sabẹ m'anwa k'efhon-diden. Wa uminanwa wạnọ wọ n'ọta otek bẹ idik, bạrasẹ abẹma n'ata akpaak ọvaar Devid. <verse eid="2SA 17:17" /><verse number="18" style="v" sid="2SA 17:18" />Okhenka, wa udikkobh wạnọ ose bẹ, ọta ọkpaak Absalọm. Ma wọ Jonatan ọttạra Ahimaz atim ẹbhạr-ẹbhạr afona k'ọchọhm kw'ujunung wạnọ k'Bahurim, ata attubha ma k'isipe chẹ ẹtaanga. <verse eid="2SA 17:18" /><verse number="19" style="v" sid="2SA 17:19" />Ma wọ ikwanạng kw'atte nwọ ọtạk ọttọhk ububha isipe njọ, ọtạkha agwu ọyaan ma. Ọnạng kw'osong bẹ́ ajunung mbọ attubh ma kòde.<verse eid="2SA 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 17:20" />Masẹ ajunung p'Absalọm akwu akhebha ikwanạng nwọ ma ọchọhm, abẹ abạbh-ẹ bẹ́, “Ahimaz ọttạra Jonatan aning mạn?”</para>
  <para style="p" vid="2SA 17:20">Ikwanạng nwọ ubhina bẹ́, “Abẹ ajek k'efhobh ukhubha e.” Wa ajunung mbọ aroru bẹ tạrr abẹ ọnạng násia. Ma wọ abẹ akwu akpa nnạm k'Jẹrusalẹm.<verse eid="2SA 17:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 17:21" />Masẹ ajunung mbọ kk'afona, Ahimaz ọttạra Jonatan ayin k'isipe, ata akpaak ọvaar Devid udik ngwọ. Abẹ aben-ẹ bẹ́, “Do ifor ẹbhạr-ẹbhạr ajekha k'ọraanga-ukhubha, khiri Ahitophẹl kk'bẹ ọtọhna oche kw'abẹ m'asi.” <verse eid="2SA 17:21" /><verse number="22" style="v" sid="2SA 17:22" />Ma wọ Devid ọttạra anạng p'aning abẹ phyibh abin ajekha k'ukhubha kw'Jọrdan. Bạrasẹ iwu echobha, anạng kk'Jọrdan ajekha phyibh.<verse eid="2SA 17:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 17:23" />Masẹ Ahitophẹl ose bẹ́ abẹ ntọhna s'ọnạngẹ bẹ nátạkha, ọyaar ẹnyạnyaang chẹ ọbhạna k'akhẹ k'ofhon. Ukwu odo ẹchọhmfhạr <char style="it">bẹ́ phyibh,</char> ubina ọtạ orena idikhi. Osenga ma, ope, abẹ annọhng-ẹ k'ibyi sabẹ annọhng otte.<verse eid="2SA 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 17:24" />Ma wọ Devid ubin ofona k'Mahanayim. Wa Absalọm ọbạra utima ajunung p'Israẹl phyibh ojekha k'ukhubha kw'Jọrdan. <verse eid="2SA 17:24" /><verse number="25" style="v" sid="2SA 17:25" />Wa Absalọm kk'ininga ch'Joab kw'ode ocho kw'akpongnạng ọtạkha ọnạng Amasa. Amasa wa ode nnwa kw'Jẹtẹr kw'ubin Ishmayẹl, kw'ọtạk Abigẹl kw'ode ọkwanạngnwa kw'Nahash, ọbạra ode nnwotte kw'Zẹruya kw'ode ọkka kw'Joab. <verse eid="2SA 17:25" /><verse number="26" style="v" sid="2SA 17:26" />Anạng p'Israẹl ọttạra Absalọm abhingi k'ẹkhạma ch'anạng p'Gilead.<verse eid="2SA 17:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2SA 17:27" />Masẹ Devid ukpir k'ofhon kw'Mahanayim, Shobi kw'ode ujunungnwa kw'Nahash, kw'ubin Raba, k'ẹkhạma ch'Ammọn, ọttạra Makir kw'ode ujunungnwa kw'Amiyẹl kw'ubin k'Lo-Dẹba, ọttạra Bazilayi kw'ubin Rogẹlim k'ẹkhạma ch'Gilead <verse eid="2SA 17:27" /><verse number="28" style="v" sid="2SA 17:28" />atim iyimakpo, ọttạra agbangbaang, ọttạra ọbaanga-sọhkha. Abẹ abạra atima wit ọttạra abarli, ọttạra agwu-buma, ọttạra agwu-abhaabhapẹ, ọttạra nsiseni, ọttạra achen-meni, <verse eid="2SA 17:28" /><verse number="29" style="v" sid="2SA 17:29" />ọttạra ọkhọhn, ọttạra abasi, ọttạra arạkhạmaan, ọttạra abukpa p'abin k'abasi p'adamagbudu akkena Devid ọttạra anạng pẹ bẹ́, abẹ achi. Abẹ aben bẹ́, “Anạng mba kk'bẹ ọkhọhna, okwo ọkhaama bẹ, asi abạra adaak bẹ k'ibyi s'anạng nạn nárukha.”<verse eid="2SA 17:29" /></para>
  <chapter eid="2SA 17" />
  <chapter number="18" style="c" sid="2SA 18" />
  <para style="s1">Obo kw'Absalọm</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 18:1" />Wa Devid otobh akpongnạng p'aning abẹ, usi ayok bạnọ adecho p'akpongnạng nnọhna-nnọhna, bạnọ ade adecho p'akpongnạng arạbh asen-asen. <verse eid="2SA 18:1" /><verse number="2" style="v" sid="2SA 18:2" />Devid ọbhaangẹ akpongnạng mbọ k'ikhaana ittaan, usi Joab odecho kw'ikhaana rạnẹ. Usi Abishayi kw'ode nnwa kw'Zẹruya, kw'ọbạra ode nnwotte kw'Joab odecho kw'ikhaana rạnẹ. Usi Ittayi kw'ubin Git odecho kw'ikhaana rạnẹ. Wa ọvaarnạng obeni ajunung mbọ bẹ́, “Amma oyeni m'mbạra ntwạn bạnga abẹ.”<verse eid="2SA 18:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 18:3" />Okhenka, ajunung mbọ abeni bẹ́, “Aro o, nọ́baana bẹ́ ọma atwạn mạna abẹ e. De awawunanạng akhubh mạna amạna annạbh, bẹ udik mókhera. Ọbạra ampe amkpira anạng ibhaakha, bẹ udik-udik mókhera. Okhenka, ọma abạrẹ udik ayọhnga amạna mba anạng nnọhna ẹrạbh ukuma asen. Ẹgwọ usi ọbaan-ọbaana bẹ́ aninga ma efhon-diden n'age mạna ẹfa.”<verse eid="2SA 18:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 18:4" />Wa ọvaarnạng n'ọpọhn bẹ́, “Amma m'nsi fidede f'ujibhi bạnga e.”</para>
  <para style="p" vid="2SA 18:4">Ma wọ wa ọvaarnạng obe k'ọbaakha ọkhaan-ọkhaan, s'akpongnạng mbọ abin, tạma k'ikhaana s'arạbh asen-asen, ọttạra ikhaana nnọhna-nnọhna, afona. <verse eid="2SA 18:4" /><verse number="5" style="v" sid="2SA 18:5" />Wa ọvaarnạng ọtwạrọ Joab ọttạra Abishayi ọttạra Ittayi itọhng bẹ́, “Abạnga asenga amma abẹ akkobha udikkobh nwọ Absalọm okkobh o.” Wa akpongnạng phyi-phyibh abhaang s'ọvaarnạng n'ọtwạr adecho itọhng ukwuru Absalọm.<verse eid="2SA 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 18:6" />Wa akpongnạng mbọ ayini k'efhon-diden k'ọsaabh ata arima anạng p'Israẹl abẹ. Wa ekpong njọ irim k'ẹkpa ch'Ephraim. <verse eid="2SA 18:6" /><verse number="7" style="v" sid="2SA 18:7" />Ma wọ wa ajunung p'Devid akhem akpongnạng p'Israẹl. Anạng p'ape ma iwu njọ asaabhẹ akpira nnọhna arạbh afa ukuma jobh. <verse eid="2SA 18:7" /><verse number="8" style="v" sid="2SA 18:8" />Wa irima njọ ẹnyaamẹ ẹbaabha ẹkhạma njọ phyibh. Ọnạng-mik kw'uwa ope k'ẹkpa, ọyọhng kw'ope k'ọkkangkkang-kkro.<verse eid="2SA 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 18:9" />Wa Absalọm ọttạm akpongnạng p'Devid abẹ. Wa n'ọyaar ẹnyạnyaang chẹ. Masẹ ẹnyạnyaang n'esenga bẹ́, eyongu k'isekhisek kw'ichi jạnẹ chididen ch'oak, ch'abọhkha pẹ akpa-ọkpa, isisira s'Absalọm ikwu igbaama k'ichi njọ. Ma wọ n'ọwọhn k'iyokhu, ẹnyạnyaang chẹ ẹrạbh efona.<verse eid="2SA 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 18:10" />Ma wọ ujunung wạnọ kw'ose udik kw'kk'uttia, ofon ọta ọkpaak Joab bẹ́, “Nse s'Absalọm ọwọhn k'ichi ch'oak e!”<verse eid="2SA 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 18:11" />Joab oben ujunung kw'ọkpaakh-ẹ udik ngwọ bẹ́, “Abẹ́? Ase-ẹ k'udik-ọkka? Ka yạn kw'nạn khẹ náfha abhạrẹ ma isek echomajạnẹ? Njanna wạra kk'ọ ashẹkẹl jobh p'asilva ọttạra udikhikpa kw'okkemkpa nnạnga.”<verse eid="2SA 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 18:12" />Okhenka, ujunung nwọ ubhin Joab bẹ́, “Ọbạra age-m ashẹkẹl nnọhna mfa ukuma arạbh jobh ma mbọhk, amma nnwa kw'ọvaarnạng ọbọhk mạ́ntwu e. Anning ma ammaanga s'ọvaarnạng ọtwạrọ ọma ọttạra Abishayi ọttạra Ittayi itọhng bẹ́, ‘Abạnga asenga amma abẹ akkobha udikkobh nwọ Absalọm okkobh o.’ <verse eid="2SA 18:12" /><verse number="13" style="v" sid="2SA 18:13" />De wạra kk'Absalọm mfha, nge akpen paam k'ọmmaphyaangẹ s'udik nạn nóde kw'ọvaarnạng nạn kạnósonga, bẹ́ njanna wạra kk'arạbha arikh-m.”<verse eid="2SA 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 18:14" />Joab oben bẹ́, “Amma dạkhẹ abọ okpe mạ́nkhibhi.” Onemi eden ọtạkha akhọhn attaan ọta ukhum Absalọm k'ittemmạma s'utim ọgwạkhọ ọyọhng ma ichi ch'oak. <verse eid="2SA 18:14" /><verse number="15" style="v" sid="2SA 18:15" />Atim-ekpong-kpo p'Joab, anạng jobh abaabh Absalọm age ngekha, akker-ẹ avun afhọ.<verse eid="2SA 18:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 18:16" />Ma o, Joab ukwu oge ẹsa, utima oben akpongnạng p'Devid bẹ́ abẹ akuma akpongnạng p'Israẹl khukhubh. <verse eid="2SA 18:16" /><verse number="17" style="v" sid="2SA 18:17" />Abẹ adira apfura p'Absalọm ata abhạrẹ k'ipekhuma s'idong-odong kha ẹkpa, atạkha ọtakpa-kwung abubh-ẹ. Ma okpe ngwọma, anạng p'Israẹl phyibh arạbhọ afona k'ichọhm sabẹ.<verse eid="2SA 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 18:18" />K'okpe kw'Absalọm utim urukhu akpen, wa ọtạk ẹta uttima ebebe k'Ipekhuma s'Ọvaarnạng masẹ ijima ọnạng ifor sẹ, s'uwa ọkkẹ bẹ́, “Amma ujunungnwa kạ́nkhaam kw'm'usi eche chaam ininga efona ororo.” Wa oyeri ẹta njọ ubhina k'eche chẹ. Ẹta njọ ekpen Ijima ch'Absalọm, tạrr ukpira k'iwu ch'chemma.<verse eid="2SA 18:18" /></para>
  <para style="s1">Devid utim nkwuna s'Absalọm</para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 18:19" />Wa Ahimaz kw'ode nnwa kw'Zadọk obeni bẹ́, “Tte nnạbh nta mkpaak ọvaarnạng ẹkkaabha nja bẹ́, Ọvaar Ubinọkpaabyi kk'ẹ ọrạbha k'mbọhk s'awawunanạng pẹ.”<verse eid="2SA 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 18:20" />Joab oben-ẹ bẹ́, “Chemma sạng kw'm'ata akpaak ẹkkaabha njọ. M'ata iwu ẹdwạkh-ọdwạk, chemma káta, ukwuru bẹ́, nnwa kw'ọvaarnạng kk'upua.”<verse eid="2SA 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 18:21" />Ma wọ Joab oben ọnạng wạnọ kw'ubin Kush bẹ́, “Sọhng ata akpaak ọvaarnạng udik kw'kk'asia.” Ọnạng nwọ ọrạkha ọnạng Joab ikpukpobha, ukwu ọrạbh ofona.<verse eid="2SA 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 18:22" />Ahimaz kw'ode nnwa kw'Zadọk ọbạra oben bẹ́, “Ọkwọhn ode, totokhạn, tte nnạbh ntor ayi nwọ kw'ubin Kush nnạm.”</para>
  <para style="p" vid="2SA 18:22">Oseng ma, Joab ubhin bẹ́, “Nnwa kwaam, ode yạn kw'n'aben bẹ́ m'agba afona, s'nạn ẹkkaabha jạnẹ-jạnẹ akhaam ch'm'ẹnạng-ọ ẹtaam?”<verse eid="2SA 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 18:23" />Ahimaz ọbẹ́, “Ọkwọhn ode, amma m'nttima ẹbhạr mfona.”</para>
  <para style="p" vid="2SA 18:23">Ma o, Joab oben bẹ́, “Rạbh afona khẹ!” Mạnna wọ Ahimaz ọrạbhọ oseng k'ukhubha kw'ukhubha kw'usi ẹkpẹmẹ, n'uchi ọnạng kw'ubin Kush eden.<verse eid="2SA 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 18:24" />Masẹ Devid uning ẹyạr k'ottemkwẹ kw'ẹbaakhamma ch'iyaan ọttạra ch'ẹtaanga, utik-ibyi uvur k'ipakhọhnga s'udimokpon kw'ẹbaakhamma. Masẹ okkeri k'iyaan, n'ose ujunung kw'n'uttima ẹbhạr mạnkkeni. <verse eid="2SA 18:24" /><verse number="25" style="v" sid="2SA 18:25" />Utik-ibyi oyeri ọvaarnạng otek!</para>
  <para style="p" vid="2SA 18:25">Ọvaarnạng oben bẹ́, “De oseng mạnkkeni, songa bẹ́ utim ẹkkaabha ọkkachẹ.” Ujunung nwọ ttạng utim ẹbhạr kha ukwu, n'ofor-ofora.<verse eid="2SA 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 18:26" />Utik-ibyi nwọ ọbạra ose s'ọnạng ọdwạkh-ọdwạk n'ọrạbh ukwu. Oyeri utik-ẹbhaakhamma oben bẹ́, “Kkeri oche kw'ujunung ọdwạkh-ọdwạk n'ọrạbh ukwu kha mạnkkeni!”</para>
  <para style="p" vid="2SA 18:26">Ọvaarnạng oben bẹ́, “Nudusi, ẹma ọbạra utima ẹkkaabha ọkkachẹ.”<verse eid="2SA 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2SA 18:27" />Utik-ibyi oben bẹ́, “Okher-m bẹ́ ocheden nwọ n'ọrạbh masẹ Ahimaz kw'Zadọk ofhonu.”</para>
  <para style="p" vid="2SA 18:27">Ọvaarnạng oben bẹ́, “Ẹma ode ọnạng ọkka. Utim ẹkkaabha ọkkachẹ.”<verse eid="2SA 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2SA 18:28" />Ma wọ Ahimaz oyeri ọvaarnạng oben bẹ́, “Attitte, kk'ujibha ọnạng mạna e!” Ọrạkha uttima ititikha k'isisek ọnạng ọvaarnạng ikpukpobha oben bẹ́, “Ẹtọhnga iyim ẹnạng Ọvaar Ubinọkpaabyi, kw'ode Ubinọkpaabyi kwọ! Ẹma kk'anạng p'arim aro ọvaar kwaam abẹ okhema.”<verse eid="2SA 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2SA 18:29" />Ọvaarnạng ọbạbh bẹ́, “Udikkobh-nwa nwọ, Absalọm, uning ọkkakwẹ kạkha o?”</para>
  <para style="p" vid="2SA 18:29">Ahimaz ubhina bẹ́ “Nse dạma-dạma kwididen s'Joab n'oben bẹ́ ọtọhm amma ọtọhmnạng kwọ, ọttạra ọtọhmnạng kw'ọvaarnạng ẹkkaabha. Okhenka, dạma-dạma nwọ khaam nọ́ttaana.”<verse eid="2SA 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 18:30" />Ọvaarnạng oben bẹ́, “Be maa ọkhaan-ọkhaan kanse.” Mạnna wọ ọtwạkhọ obe.<verse eid="2SA 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="2SA 18:31" />Ma okpe ngwọ, ọnạng nwọ kw'ubin Kush ukwu ukpira, oben bẹ́. “Aro ọvaar kwaam, bhaanga ẹkkaabha ọkkachẹ! Ọvaar Ubinọkpaabyi kk'ọ orạbha k'mbọhk s'awawuna-nạng pọ phyibh e.”<verse eid="2SA 18:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2SA 18:32" />Ọvaarnạng ọbạbh oKush-nạng nwọ bẹ́, “Udikkobh-nwa nwọ Absalọm uning ọkkakwẹ kạkha o?”</para>
  <para style="p" vid="2SA 18:32">OKush-nạng nwọ ubhina bẹ́, “Tte awawuna-nạng p'aro ọvaar kwaam, ọttạra anạng phyibh p'akhạmọ bẹ́, asi-ẹ ipyibha, ade masẹ udikkobh-nwa nwọ.”<verse eid="2SA 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="2SA 18:33" />Ma wọ ifor ikwu ibhạkhẹ ọvaarnạng. Ubina uvura k'ẹmaanggọ ẹrạng-ẹrạng, ch'ining k'ẹbaakhamma, ofona ọta ọgạma. Masẹ n'ofona, n'oben bẹ́, “O nnwa kwaam Absalọm! Absalọm kwaam e! Uttu wạra ọma m'ape, amma wọ wạra m'ntera mpe e! O nnwa kwaam Absalọm! Nnwa kwaam e! Nnwa kwaam!”<verse eid="2SA 18:33" /></para>
  <chapter eid="2SA 18" />
  <chapter number="19" style="c" sid="2SA 19" />
  <para style="p">
    <verse number="1" style="v" sid="2SA 19:1" />Wa abẹ akpaakhẹ Joab bẹ́, “Ọvaarnạng ọgạm ẹmạng kạkha e, ọbạra utima nkwuna s'obo kw'Absalọm.” <verse eid="2SA 19:1" /><verse number="2" style="v" sid="2SA 19:2" />Ma iwu njọ, akpongnạng n'ayaang erobha ch'ekhema chabẹ ajẹ, abẹ n'abhạkhẹ atima nkwuna sabẹ abhaang bẹ́ ọvaarnạng utim nkwuna s'nnwa kwẹ kw'ope. <verse eid="2SA 19:2" /><verse number="3" style="v" sid="2SA 19:3" />Ma iwu njọ, ajunung mbọ abẹkh-ọbẹk ata anwa k'efhon-diden masẹ anạng p'ekpong ipyibh iwu bạra abẹ arạbh mkpạr asẹ akwuna. <verse eid="2SA 19:3" /><verse number="4" style="v" sid="2SA 19:4" />Ọvaarnạng ububha mbọhk k'ititikha n'ọgạma k'ẹrạng-k'ẹrạng bẹ́, “O nnwa kwaam Absalọm! Absalọm e! Nnwa kwaam e! O nnwa kwaam!”<verse eid="2SA 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 19:5" />Ma o, Joab ọta ọnwa k'ọchọhm kw'ọvaarnạng oben-ẹ bẹ́, “Chemma kk'akpongnạng pọ phyibh mkpạr arenga, p'ade anạng p'akkaan akpen pọ, ọttạra akpen p'ajunungva ọttạra p'apanạngva pọ, ọttạra p'ipanạng pọ, ọttạra p'ayok pọ. <verse eid="2SA 19:5" /><verse number="6" style="v" sid="2SA 19:6" />Atera akhọhkha awawunanạng pọ idạdaakha, awun anạng p'akhọhkh-ọ idạdaakha. Chemma, kk'akhọhkha bẹ́, adecho p'akpongnạng, ọttạra akpongnạng pabẹ, ọttọk nápua kakhọ k'ititikha. Amma oyeni kk'nsia k'iwu ch'chemma bẹ́, wạra m'orebh-ọ de wạra amạna mba phyibh ampe, Absalọm uruk akpen. <verse eid="2SA 19:6" /><verse number="7" style="v" sid="2SA 19:7" />Nemi eden bina ata age anạng pọ nttem. Amma nchekhi k'eche ch'Ọvaar Ubinọkpaabyi bẹ́, ode nạn k'iyaan náchera ayin, bạrasẹ iwu echobha, ujunung wạnọ-wạnọ máse kw'm'ọbạra uninga abọ. Udik ngwọ m'upyibh ọyọhnga ipyibha chidede ch'kk'ittia ekhebh-ọ k'akpen, tạma k'idikkobh chọ kpira mantọmma.”<verse eid="2SA 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 19:8" />Ma wọ ọvaarnạng ubin ọta uninga ẹyạr k'ẹbaakhamma. Masẹ abẹ n'akpaakhẹ anạng mbọ bẹ, ọvaarnạng uning kha ẹbhaakhamma, abẹma phyibh abina ata akhebh-ẹ kha.</para>
  <para style="s1" vid="2SA 19:8">Devid ọkpa nnạm k'Jẹrusalẹm</para>
  <para style="p" vid="2SA 19:8">Ma okpe ngwọ, anạng p'Israẹl kk'arạbha afona k'abẹ k'ichọhm. <verse eid="2SA 19:8" /><verse number="9" style="v" sid="2SA 19:9" />K'nkhạma s'Israẹl phyi-phyibh abaabha ọbaabha, anạng n'akhaanga ayok idik aben bẹ́, “Ọvaarnạng wọ wa ọkkaan mạna k'mbọhk s'awawuna-nạng pamạna. Ẹma wọ wa ọbạra ọrạbha mạna k'mbọhk s'aPhilistiya. Okhenka, kk'ọrạbha urik ofhon ukwuru Absalọm. <verse eid="2SA 19:9" /><verse number="10" style="v" sid="2SA 19:10" />Absalọm oyeni kw'uwa ambyeng ana k'echo bẹ́, ọdạbh mạna, kk'upua. Usi yạn bạra nạn udik tạm námkpaakha k'oche wạra ọvaar Devid m'ọkpa nnạm o?”<verse eid="2SA 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 19:11" />Ọvaar Devid ukwu ọtọhm ẹkkaabha ọnạng Zadọk ọttạra Abiyata p'ade afọhnẹja bẹ́, “Abạnga abạbh adennạng p'Juda bẹ́, Abạnga n'akhibhi okpe asi mbạng, kw'abạnga nạn kạnákwu akwu atạkha ọvaarnạng ọkpa nnạm k'akhẹ k'ọvaarter o, ‘Abhaang idik sabẹ n'akpaak abaabha Israẹl kk'ọvaarnạng oyeni ittia k'itọhng. <verse eid="2SA 19:11" /><verse number="12" style="v" sid="2SA 19:12" />Abạnga ade afona-nạng paam, p'isẹ rạnẹ isi. Ukwuru yạn kw'abạnga m'ade akponga-nnạm p'm'akwu bẹ́, akwu atima ọvaarnạng abhạna o?’ <verse eid="2SA 19:12" /><verse number="13" style="v" sid="2SA 19:13" />Abạnga aben Amasa bẹ́, ‘Ọma ande isẹ rạnẹ. Tte Ubinọkpaabyi usi-m oche kwidede kw'ọdaakhẹ, ode nạn khọ odecho kw'akpongnạng paam nạ́nsia k'akpen pọ phyibh, ntima ntera echo ch'Joab.’ ”<verse eid="2SA 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 19:14" />Ma wọ Devid odebhi nttem s'aJuda, usi abẹ akhaama ẹkka jạnẹ. Abẹ atọhm ẹkkaabha anạng ọvaarnạng aben bẹ́, “Ọma ọttạra atọhmnạng pọ phyibh, akpa nnạm.” <verse eid="2SA 19:14" /><verse number="15" style="v" sid="2SA 19:15" />Mạnna wọ ọvaarnạng ọkpa nnạm, ukwu ukpira k'Ọraanga kw'Jọrdan.</para>
  <para style="p" vid="2SA 19:15">Ma okpe ngwọ, akpongnạng p'Juda kk'kpikpira akpira k'Gilgal bẹ́, akwu akhebha ọvaarnạng ma, ọfha abẹ atima abẹ ajekha Jọrdan. <verse eid="2SA 19:15" /><verse number="16" style="v" sid="2SA 19:16" />Shimeyi kw'ode nnwa kw'Gera, kw'ubin Bahurim, k'ẹkhạma ch'Bẹnjamin, utim akpongnạng p'Juda ubina ẹbhạr-ẹbhạr ọta okhebha ọvaar Devid. <verse eid="2SA 19:16" /><verse number="17" style="v" sid="2SA 19:17" />Anạng p'uwa atwạnọ ọvaar Devid abẹ, p'abin Bẹnjamin ade anạng nnọhna mfa ukuma arạbh jobh, ọttạra Ziba kw'uwa ode ọtọhmnạng kw'ẹchọhmfhạr ch'Saul, ọttạra ajunungva pẹ chi, ọttạra atọhmnạng pẹ ẹrạbh. Wa abẹ adwuk-udwukha asạkha k'Jọrdan akhebha ọvaarnạng kha. <verse eid="2SA 19:17" /><verse number="18" style="v" sid="2SA 19:18" />Abẹ atim ẹchọhmfhạr ch'ọvaarnạng asenga k'ibyi s'anạng n'akwu ajekha, ajekha k'ukhubha. Abẹ abạra asi udik kwidede kw'ọvaarnạng ororu.</para>
  <para style="p" vid="2SA 19:18">Masẹ ọvaarnạng n'odo ifor bẹ́ ojekha Jọrdan, Shimeyi kw'Gera ofhonu, n'otto ukhubha k'ikpukpobha ma ititikha s'ọvaarnạng, <verse eid="2SA 19:18" /><verse number="19" style="v" sid="2SA 19:19" />oben-ẹ bẹ́, “Aro kwaam o, totokhạn, mpina saam kásaana o. Nchin-ọ uchini, mpina s'amma ọtọhmnạng kwọ nsi k'okpe kw'uwa abin k'Jẹrusalẹm kájima. Tte udik ngwọ ọsa ọvaarnạng k'ettem, <verse eid="2SA 19:19" /><verse number="20" style="v" sid="2SA 19:20" />khiri amma ọtọhmnạng kwọ nsong kha bẹ́ kk'ipyibha nsia. Okhenka, amma kk'nkwua chemma masẹ ocheden-nạng kw'ubin k'nkhạma s'Josẹph bẹ́, nkwu nkhebha aro ọvaar kwaam.”<verse eid="2SA 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 19:21" />Ma wọ Abishayi kw'Zẹruya ofhonu obeni bẹ́, “Shimeyi ọbaan k'obo ma udik ngwa ma e. Ẹma ọta unnukhu ọnạng kw'ọvaar Ubinọkpaabyi kk'ana obyenga k'echo.”<verse eid="2SA 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 19:22" />Devid ubhina bẹ́, “Abạnga ma iva p'Zeruya, osengi bạnga yạn maa udik ngwa? Abạnga ẹfa jạnẹ-jạnẹ kákham bẹ́, abạnga age ẹmma ma udik ngwa. Ọbaan ma bẹ́, abạnga afhọ ọnạng ma Israẹl chemma o? Amma oyeni nsong kha bẹ́, amma wọ nde ọvaarnạng kw'Israẹl chemma nwa.” <verse eid="2SA 19:22" /><verse number="23" style="v" sid="2SA 19:23" />Ma wọ ọvaarnạng ochekhi ọnạng Shimeyi bẹ́, “Ọma mápe e.”<verse eid="2SA 19:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 19:24" />Wa Mẹphiboshẹt kw'ode nnwa-mfhona kw'Saul, ọbạra ọta okhebha ọvaarnạng. Mfhok sẹ nókpobha, agba-phyạbha nọ́bra uphyira, ọvạra f'ifor nókpobha, tạma k'iwu ch'ọvaarnạng ofon k'Jẹrusalẹm, tạrr ukpira k'iwu ch'ọkpa nnạm k'idira. <verse eid="2SA 19:24" /><verse number="25" style="v" sid="2SA 19:25" />Masẹ ubin k'Jẹrusalẹm ukwu okhebha ọvaarnạng, ọvaarnạng ọbạbh-ẹ bẹ́, “Mẹphiboshẹt, ukwuru yạn kw'uwa nạn abamẹ nátwạna afona?”<verse eid="2SA 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 19:26" />Ọpọhn-ẹ bẹ́, “Aro ọvaar kwaam, masẹ amma ọtọhmnạng kwọ nphyạkhẹ mkpẹtẹ, mbeni ọtọhmnạng kwaam bẹ́ okken-m ẹnyạnyaang chaam, mvura nnyạar, ọfha ntwạn ọvaarnạng abẹ. Wa Ziba kw'ode ọtọhmnạng kwaam wọ ọbọhr-m, khaam nókkena. <verse eid="2SA 19:26" /><verse number="27" style="v" sid="2SA 19:27" />Kk'amma ọtọhm-nạng kwọ idik ọbọhma ọnạng ọma aro kwaam. Ọma aro ọvaar kwaam ade masẹ oseng-eden kw'Ubinọkpaabyi. Si oche kw'ọbaan bẹ́, asi. <verse eid="2SA 19:27" /><verse number="28" style="v" sid="2SA 19:28" />Wa ọnạng kòde kw'ubin k'ẹnạmma ch'otte kwaam kwididen, kw'nạn k'obo nọ́baana k'mbọhk s'ọvaarnạng kwaam. Okhenka, ater anạng amma ọtọhmnạng kwọ ininga k'ikhaana s'anạng p'n'achi ọttọhk k'okpokkro kwọ. Amma nkhaam bạng ẹfa ch'm'mfona ororo mbạbh adạkhẹ ọvaarnạng ọttọhk?”<verse eid="2SA 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2SA 19:29" />Ọvaarnạng oben-ẹ bẹ́, “Tte mạnna ma udik ngwọ. Amma kk'ọma ọttạra Ziba ẹfa nnạnga bẹ́, abạnga ata akhebh ekpo py'Saul anạng abạngama oyeni.”<verse eid="2SA 19:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 19:30" />Mẹphiboshẹt oben ọvaarnạng bẹ́, “Masẹ aro kwaam kk'ukwuna k'idira, tte ẹma Ziba ọtạkha ekpo phyibh.”<verse eid="2SA 19:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="2SA 19:31" />Wa Bazilayi kw'ubin k'ẹkhạma ch'Gilead ọbạra ubina k'ofhon kw'Rogẹlim ukwu, ọfha ọtwạn ọvaarnạng abẹ ojekha Jọrdan, ọfha ọbạra urikh-ẹ k'eden. <verse eid="2SA 19:31" /><verse number="32" style="v" sid="2SA 19:32" />Wa Bazilayi kk'ọtạma mororo, s'uwa n'ode icho arạbh annebung. Wa ọbạra ode ọnạng ọkka kw'uwa n'okkeri ọvaarnạng k'okpe kw'uning k'Mahanayim. <verse eid="2SA 19:32" /><verse number="33" style="v" sid="2SA 19:33" />Ọvaarnạng oben Bazilayi bẹ́, “Twạn-m abẹ anjekha k'Jẹrusalẹm. Amma m'nkker-ọ okkeri.”<verse eid="2SA 19:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="2SA 19:34" />Okhenka, Bazilayi ubhin ọvaarnạng bẹ́, “Amma m'nnuk adạkhẹ mkpira yạn, kw'm'ntwạn ọvaarnạng abẹ mfona k'Jẹrusalẹm? <verse eid="2SA 19:34" /><verse number="35" style="v" sid="2SA 19:35" />Amma n'nde icho arạbh annebung. Maa, s'm'nsonga adạkhẹ udik kw'ujibhi ujibh ọttạra kw'nạnújibh o? Amma erobha ọttạra ọkhạmana dạk kạ́nsong. Amma ọtọhmnạng kwọ orebh f'ichiakpo ọttạra f'atwuk dạk kạ́mmaang. Mmạng s'akkọhn-mmạng s'ajunung ọttạra s'ipanạng dạk kạ́mmaang. Ka yạn kw'amma ọtọhmnạng kwọ n'abạra nkwu nttạra ọma aro ọvaar kwaam ẹtọhkha o? <verse eid="2SA 19:35" /><verse number="36" style="v" sid="2SA 19:36" />Amma kk'ẹtaam nja ch'ọvaarnạng nạ́mbaana. Amma ọtọhmnạng kwọ m'nkhenka ntwạn ọmma ọvaarnạng abẹ njekha k'Jọrdan, nnikh-ọ k'oden-khuma. <verse eid="2SA 19:36" /><verse number="37" style="v" sid="2SA 19:37" />Tte amma ọtọhmnạng kwọ mkpa nnạm, ọfha mpe k'akhaam k'ofhon mbaanga apekwur p'otte, ọttạra ọkka kwaam. Okhenka, kkeri ọtọhmnạng kwọ Kimham maa. Tte ẹma nwọ ọtwạn aro ọvaar kwaam abẹ ojekha k'ukhubha. Si fidede f'akkẹ bẹ́ m'asi anạng-ẹ.”<verse eid="2SA 19:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="2SA 19:38" />Ọvaarnạng oben bẹ́, “Kimham m'ojekha abamẹ ojekha. Amma m'nsi fidede f'nkkẹ, nnạng-ẹ. Fidede f'ọma abạra aror, m'nsi-usi nnạng-ọ.”<verse eid="2SA 19:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="2SA 19:39" />Ma wọ anạng phyibh attạr ọvaarnạng ajekha k'Jọrdan. Ọvaarnạng o, ukwu ọbaakha Bazilayi, ọbạra ọyọhbh-ẹ itta. Bazilayi ọkpa nnạm ọbhạna k'akhẹ k'ofhon.<verse eid="2SA 19:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="2SA 19:40" />Masẹ ọvaarnạng ojek k'ukhubha kw'Gilgal, Kimham ọtwạnọ abẹ ojekha. Akpongnạng phyibh p'Juda, ọttạra ibhaakha s'akpongnạng p'Israẹl kk'ọvaarnạng atima ajekha k'ukhubha.<verse eid="2SA 19:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="2SA 19:41" />Okpe núbhira, ajunung phyibh p'Israẹl akwu k'ọvaar Devid akwu aben-ẹ bẹ́, “Ode yạn kw'ivotte pamạna p'Juda afu ọvaarnạng atim-ẹ ọttạra ẹchọhmfhạr chẹ, ọttạra akpongnạng pẹ phyibh ajekha Jọrdan afona o?”<verse eid="2SA 19:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="2SA 19:42" />Wa ajunung p'Juda phyibh abhin ajunung p'Israẹl bẹ́, “Wa ansi oche ngwọ ukwuru bẹ́, ọvaarnạng ọttạra amạna mba ande anạng bạnọ. Mbạng vọ ode ottempyibh kw'abạnga? Amạna kk'ọttọhk vạnọ-vạnọ f'ọvaarnạng antạkha anchi? Amạna kk'ọttọhk vạnọ-vạnọ antạkha annạng amạna mba oyeni?”<verse eid="2SA 19:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="2SA 19:43" />Ma wọ ajunung p'Israẹl n'abhin ajunung p'Juda bẹ́, “Amạna-mba ankhaam nkhạma jobh ma ẹvaar nja, ẹgwọ usi ankhaam Devid ọtạm anyọhnga bạnga. Abạnga asi yạn asẹkhẹ mạna oche ngwa ma o? Amạna-mba sạng p'uwa anchi eden amben bẹ́, oyonga ọvaarnạng kwamạna m'ọkpa nnạm?”</para>
  <para style="p" vid="2SA 19:43">Mạnna wọ kw'ajunung p'Juda afon ororo ajẹ ẹkhọhr ma udik ngwọ.<verse eid="2SA 19:43" /></para>
  <chapter eid="2SA 19" />
  <chapter number="20" style="c" sid="2SA 20" />
  <para style="s1">Shẹba ọnạngẹ Devid ẹkhọhr</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 20:1" />Wa ọkhọhr-nạng mạnna wạnọ uning ma kw'okpen Shẹba, kw'ode ujunungnwa kw'Bikiri, kw'ubin k'ẹkhạma ch'Bẹnjamin. Wa oge ẹsa, owon bẹ́,</para>
  <para style="q1" vid="2SA 20:1">“Amạna mba okhebh k'Devid kánkhaam,</para>
  <para style="q2" vid="2SA 20:1">amạna okhebh k'nnwa kw'Jẹsẹ kánkhaam!</para>
  <para style="q1" vid="2SA 20:1">Anạng p'Israẹl o, ọnạng-ọnạng ofona k'akhẹ k'ọchọhm e!”<verse eid="2SA 20:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 20:2" />Mạnna wọ kw'anạng p'Israẹl phyibh afhumu Devid, ator Shẹba kw'Bikiri ofhonu. Okhenka, anạng p'Juda atoru ọvaarnạng kwabẹ, tạma k'ọraanga kw'Jọrdan tạrr ukpira k'Jẹrusalẹm.<verse eid="2SA 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 20:3" />Masẹ Devid ukwun k'ọvaarter kwẹ k'Jẹrusalẹm, ọtạk ayok pẹ ncho jobh p'kk'ofona urik bẹ́ abẹ akkeri ọvaarter, ochok k'ọchọhm gwạnọ, ọtạkha anạng ochok bẹ́ abẹ akkeri bẹ. Wa n'ọnạng bẹ fidede f'abẹ aroru, okhenka, bẹ abẹ núyima. Wa ipanạng mbọ aning ma ibyi nnọ rạnẹ masẹ apokwa tạrr abẹ akhebha ma, ape.<verse eid="2SA 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 20:4" />Wa ọvaarnạng obeni Amasa bẹ́, “Tima iwu ittaan yeri aJuda ọttạra ọma oyeni, abạnga akwu.” <verse eid="2SA 20:4" /><verse number="5" style="v" sid="2SA 20:5" />Okhenka, masẹ Amasa ofon bẹ́, ọta oyeri aJuda o, okponga ma tạrr okpe kw'ọvaarnạng ugi-ẹ oseng.<verse eid="2SA 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 20:6" />Ma wọ Devid obeni Abishayi bẹ́, “Kker e, igbaan s'uwa Shẹba kw'ode nnwa kw'Bikiri usi mạna, m'iyọhnga s'uwa Absalọm usi e. Tima ajunung p'aro kwọ khubh-ẹ, deja, m'oror ifhon-diden s'ikhaam ẹfa ọta uttubha, ọnnaanga mạna.” <verse eid="2SA 20:6" /><verse number="7" style="v" sid="2SA 20:7" />Mạnna wọ kw'ajunung p'Joab ọttạra anạng p'Kẹrẹt ọttạra anạng p'Pẹlẹt, ọttạra akkemkpa phyibh, atoru k'ntọhna s'Abishayi kw'ode odecho, afona. Wa abẹ abin k'Jẹrusalẹm akhubh Shẹba, kw'ode nnwa kw'Bikiri.<verse eid="2SA 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 20:8" />Masẹ abẹ aning k'ẹtakpa chididen k'Gibeọn, Amasa ukwu okhebha bẹ ma. Wa Joab oge ekpong-nya, ọtạkha ọmaananwa kw'ọjaabhẹ nnạm mfa kw'oge k'ọpa, ọdạbh k'udikpa kw'ọkpa k'irin.<verse eid="2SA 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 20:9" />Joab oben Amasa bẹ́, “Nnwotte kwaam, usi-ọ yạn?” Joab utima udimbọhk kwẹ ọvạkha Amasa k'agba-phyạbha s'n'oben bẹ́ ọbaakh-ẹ ọbaakha. <verse eid="2SA 20:9" /><verse number="10" style="v" sid="2SA 20:10" />Amasa utum k'imaana s'Joab utim k'ọbọhk núgia. Joab orengi imaana nnọ ukhum-ẹ okpe ngwọ gwạnọ ma ẹfhạr <char style="it">bẹ́ dwạrr,</char> tạrr afhạrọ ayin atto k'isisek. Amasa ope. Ma wọ Joab ọttạra nnwotte Abishayi akhubhu Shẹba kw'ode nnwa kw'Bikiri.<verse eid="2SA 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 20:11" />Wa ọnạng wạnọ k'ikhaana s'anạng p'Joab obe utuma apfura p'Amasa oben bẹ́, “Ọnạng kwidede kw'obe Joab ọttạra Devid abẹ, tte otor Joab!” <verse eid="2SA 20:11" /><verse number="12" style="v" sid="2SA 20:12" />Amasa ọrạn k'isẹ sẹ ma eden-ttem. Ujunung nwọ n'ose bẹ́, akpongnạng phyibh n'ata abe ma, akker-ẹ. Masẹ ode bẹ́ ọnạng kwidede kw'ukpir ma ibyi s'Amasa uning n'obe ma, ukwu ọtwạr-ẹ ubina k'eden, urur-ẹ k'owonu gwạnọ, ọtạkha ivạra ububh-ẹ. <verse eid="2SA 20:12" /><verse number="13" style="v" sid="2SA 20:13" />Masẹ abẹ kk'Amasa adira abina k'eden o, okpongnạng kwidede otor Joab abẹ akhubh Shẹba kw'ode nnwa kw'Bikiri.<verse eid="2SA 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 20:14" />Shẹba ọkpaang nkhạma s'Israẹl phyi-phyibh tạrr ukpira k'Abẹl Bẹt-Maka, ọbạra ọkpaanga ẹkhạma ch'anạng p'Bikiri p'uwa atobh ifor sabẹ atwạn Shẹba abẹ. <verse eid="2SA 20:14" /><verse number="15" style="v" sid="2SA 20:15" />Akpongnạng phyibh p'atwạnọ Joab abẹ, akwu abaabha Shẹba age ngekha k'Abẹl Bẹt-Maka. Abẹ atubh okhomakpa atima avạkha iyaan-iyaan kw'udimokpon kw'efhon-diden. Abẹ n'akhonga bẹ́, avọhkhọ udimokpon nwọ. <verse eid="2SA 20:15" /><verse number="16" style="v" sid="2SA 20:16" />Okhenka, ikwanạng wạnọ kw'odongu-odongu uyin ma efhon-diden n'ọwạmọ bẹ́, “Akhọhmọ itọhng e! Abạnga akhọhmọ itọhng! Ayeri Joab akken-m mkpaakh-ẹ udik.” <verse eid="2SA 20:16" /><verse number="17" style="v" sid="2SA 20:17" />Joab osenga okhebh-ẹ, ikwanạng nwọ ọbạbh-ẹ bẹ́, “Ọma wọ akpen Joab?”</para>
  <para style="p" vid="2SA 20:17">Ubhina bẹ́, “Uwe e, amma wọ.”</para>
  <para style="p" vid="2SA 20:17">Ikwanạng nwọ oben-ẹ bẹ́, “Khọhmọ itọhng abhaanga udik kw'amma ọtọhmnạng kwọ n'mben bẹ́, mkpaak.”</para>
  <para style="p" vid="2SA 20:17">Oben-ẹ bẹ́, “N'nka nkhọhmọ itọhng.”<verse eid="2SA 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 20:18" />Ikwanạng nwọ oben-ẹ bẹ́, “Wa abẹ n'akpaak ẹtạma bẹ́, ‘Sọhng ata atạkha ntọhna k'Abẹl,’ brasẹ udik ngwọ n'ọkhaam echo. <verse eid="2SA 20:18" /><verse number="19" style="v" sid="2SA 20:19" />Amạna mba ande anạng p'ẹmẹm, ambạra ande anạng p'akhaam nnạm-phyiphye k'Israẹl. Ọma n'akhonga bẹ́, adimi efhon-diden ch'ede ẹrạnga ch'Israẹl. Usi yạn kw'n'aben bẹ́, adimi ofhon kw'Ọvaar Ubinọkpaabyi o?”<verse eid="2SA 20:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 20:20" />Joab ubhina bẹ́, “Ubinọkpaabyi káchera! Ubinọkpaabyi káchera, bẹ́ amma m'nkhibhi, ọbạra ode bẹ́ m'ndimi ofhon ro! <verse eid="2SA 20:20" /><verse number="21" style="v" sid="2SA 20:21" />Mesese, akwẹ oche ngwọ mòde. Ode bẹ́ ẹ, ujunung wạnọ kw'okpen Shẹba, kw'Bikiri kw'ubin k'akpecho p'Ephraim ofhonu, ẹma wọ ọyaanẹ ọbọhk kwẹ bẹ́, uvun ọvaar Devid. Anạng-m ujunungnwa wạnọ, amma m'ntte efhon-diden njama ọbọhk otte.”</para>
  <para style="p" vid="2SA 20:21">Ikwanạng nwọ n'obeni Joab bẹ́, “M'ammạrẹ echo chẹ k'ọbaakha ukhubha annạng-ọ.”<verse eid="2SA 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 20:22" />Ikwanạng nwọ o, n'utim adongada mbọ pẹ ọta okhebha anạng phyibh, abẹ akpaara Shẹba kw'Bikiri ofhonu echo, abhạrẹ Joab k'ọbaakha ukhubha. Ma wọ Joab oge ẹsa utima oben anạng pẹ phyibh atte efhon-diden njọ ọbọhk, ọnạng-ọnạng ọkpa nnạm k'akhẹ k'ọchọhm. Wa Joab ọgba ọkpa nnạm okhebha ọvaarnạng kha Jẹrusalẹm.<verse eid="2SA 20:22" /></para>
  <para style="s">Ikhaana s'Devid</para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 20:23" />Wa Joab wọ ode odecho kw'akpongnạng p'Israẹl <char style="it">bẹ́ wạạmm</char>; Bẹnaya kw'Jehoyada ofhonu, wọ ode odecho kw'akpongnạng p'Kẹrẹt, ọttạra akpongnạng p'Pẹlẹt. <verse eid="2SA 20:23" /><verse number="24" style="v" sid="2SA 20:24" />Adoniram ode ocho kw'atọhmnạng. Jẹhosaphat kw'Ahilud ofhonu ode ọkkẹrẹ kw'idik s'kk'ittia. <verse eid="2SA 20:24" /><verse number="25" style="v" sid="2SA 20:25" />Sheva ode ọkkẹrẹ; Zadọk ọttạra Abiyata ade afọhnẹja. <verse eid="2SA 20:25" /><verse number="26" style="v" sid="2SA 20:26" />Wa Ira, kw'ubin Jair ode ọfọhnẹja kw'Devid.<verse eid="2SA 20:26" /></para>
  <chapter eid="2SA 20" />
  <chapter number="21" style="c" sid="2SA 21" />
  <para style="s1">Devid oter udik kw'Saul usi anạng p'Gibeọn</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 21:1" />K'okpe kw'uwa Devid ọdạbhẹ ẹvaar, wa okwo f'ididen uning k'Israẹl k'icho mạnna ittaan. Wa Devid ọta ọdwạn Ọvaar Ubinọkpaabyi otena ma udik ngwọ. Ọvaar Ubinọkpaabyi oben bẹ́, “Okwo mvama ubin k'usisi kw'Saul ọttạra ẹnạmma chẹ, sabẹ afhọ anạng p'Gibeọn”.<verse eid="2SA 21:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 21:2" />Ọvaar Devid oyeri anạng p'Gibeọn, ọkpaak bẹ abẹ. (Wa anạng p'Gibeọn Israẹl nábina, abẹ ade anạng p'Amọr p'arikhi-urik. Wa anạng p'Israẹl kk'achekha bẹ́, abẹ m'atte bẹ ọbọhk abẹ aruk. Okhenka, Saul ọkhạmọ bẹ́ m'ọfhọ bẹ, ukwuru s'uttum-ẹ kha ettem bẹ́, ọkkaana anạng p'Israẹl, ọttạra p'Juda.) <verse eid="2SA 21:2" /><verse number="3" style="v" sid="2SA 21:3" />Devid ọbạbh anạng p'Gibeọn bẹ́, “M'nsi mbạng nnạng bạnga? M'nsenga yạn nsi efokhu, ọfha abạnga ado okhebh f'Ọvaar Ubinọkpaabyi?”<verse eid="2SA 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 21:4" />Anạng p'Gibeọn abhin-ẹ bẹ́, “Amạnamba ẹfa kánkhaam bẹ́, annor gol ọttạra silva k'mbọhk s'Saul, oseng k'ẹchọhmfhạr chẹ. Amạnamba ẹfa mámbạra ankhaama bẹ́, amfhọ ọnạng wạnọ-wạnọ k'Israẹl.”</para>
  <para style="p" vid="2SA 21:4">Devid n'ọbạra ọbạbh bẹ́, “Mbạng vọ f'abạnga aroru bẹ́ nsi nnạng bạnga?”<verse eid="2SA 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 21:5" />Abẹ abhina ọvaarnạng bẹ́, “Ọnạng nwọ kw'udimi mạna, ọttọhnọ bẹ́ udimi mạna woowong, amạna ibyi rạnẹ-rạnẹ k'Israẹl kánkhaam. <verse eid="2SA 21:5" /><verse number="6" style="v" sid="2SA 21:6" />Tte abẹ anạng mạna iva p'iva pabẹ p'ade ajunung, ncho nsenọfa, amfhọ, anjạn apfura pabẹ ma ititikha s'Ọvaar Ubinọkpaabyi, k'Gibea kw'ode ọfhon kw'Saul, ẹma nwọ kw'Ọvaar Ubinọkpaabyi kk'otekha.”</para>
  <para style="p" vid="2SA 21:6">Ma wọ ọvaarnạng obeni bẹ́, “Amma m'ntte bẹ ọbọhk otte nnạng bạnga.”<verse eid="2SA 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 21:7" />Wa ọvaarnạng otte Mẹphiboshẹt kw'ọde nnwa kw'Saul ọbọhk uruk akpen, ukwuru echekha ch'Devid ọttạra Jonatan kw'ode nnwa kw'Saul kk'atạkha k'ititikha s'Ọvaar Ubinọkpaabyi. <verse eid="2SA 21:7" /><verse number="8" style="v" sid="2SA 21:8" />Okhenka, ọvaarnạng ọtạk Armoni, ọttạra Mẹphiboshẹt, p'ade iva afa p'Aiya kw'ode nnwa kw'Rizpa ọmaanẹ ọnạng Saul, ọttạra ajunungva asen p'Mẹrab kw'ode uminanwa kw'Saul ọmaanẹ ọnạng Adriyẹl kw'Barzilayi kw'ubin Mẹholat ofhonu. <verse eid="2SA 21:8" /><verse number="9" style="v" sid="2SA 21:9" />Ọtạkha bẹ ọnạng anạng p'Gibeọn, abẹ afhọ bẹ, atạkha apfura pabẹ ajạn k'okpecho, k'ititikha s'Ọvaar Ubinọkpaabyi. Wa abẹma anạng asenọfa phyibh ape okpe gwạnọ. Wa abẹ afhọ bẹ k'echedenwu ch'iphya, s'iphya s'abarli itạm.<verse eid="2SA 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 21:10" />Rizpa kw'ode ọkwanạng-nwa kw'Aiya ọtạk ọvạra-bina ọjẹ k'ẹtakpa ọnạng ẹma oyeni. Tạma ma ọphyakpe tạrr ukpira k'okpe kw'ọrạngkpaang ọtạm apfura mbọ tạtebh, n'ukhubh ọnọhn k'ẹya, ukhubh mkpaten k'irungu, ọfha apyẹ nạngẹ apfura mbọ achi. <verse eid="2SA 21:10" /><verse number="11" style="v" sid="2SA 21:11" />Okpe kw'Devid ọbhaang udik kw'Rizpa kw'ode ọkwanạng-nwa kw'Aiya, kw'ode oyok kw'Saul kk'usia, <verse eid="2SA 21:11" /><verse number="12" style="v" sid="2SA 21:12" />Devid ọta ọtạkha akhạbhọ p'Saul ọttạra nnwa kwẹ Jonatan k'anạng p'Jabẹsh-Gilead. (Wa anạng bọ afu apfura pabẹ k'okpe kw'iphya s'Bẹt-Shan, kha ibyi s'uwa aPhilistiya kk'bẹ arena, k'okpe kw'abẹ kk'Saul afha k'Gilboa). <verse eid="2SA 21:12" /><verse number="13" style="v" sid="2SA 21:13" />Mạnna wọ Devid ọta ọtạkha akhạbhọ p'Saul ọttạra p'nnwa kwẹ Jonatan kạkha. Ọbạra ọtakha akhạbhọ p'anạng p'abẹ kk'afha ajạn apfura pabe.<verse eid="2SA 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 21:14" />Abẹ annọhng akhạbhọ p'Saul ọttạra p'nnwa kwẹ Jonatan k'epekwur ch'Kish, kw'ode otte kw'Saul, kha Zẹla, k'ẹkhạma ch'Bẹnjamin. Abẹ abạra asi udik kwidede kw'ọvaarnạng ororu. Masẹ abẹ kk'idik nnọ asia, Ubinọkpaabyi ọbhaanga njọhm sabẹ s'isek nnọ.<verse eid="2SA 21:14" /></para>
  <para style="s1">Mkpong s'aPhilistiya arim</para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 21:15" />Wa anạng p'Israẹl ọttạra p'Philistiya abạra arima ekpong. Devid utim anạng pẹ urima anạng p'Philistiya abẹ, tạrr ẹfa ẹsẹ-ẹ. <verse eid="2SA 21:15" /><verse number="16" style="v" sid="2SA 21:16" />Ishbi-Bẹnọb, nnwa wạnọ k'ikhaana s'iva p'iva p'Rapha, echo ch'ọkhọhn pfẹ ẹdọhbhọ ikpira adọhbh p'ashẹkẹl arạbh chi, ọbạra utima ọkkangkkang-kkro ọbhakwẹ, oben bẹ́, ẹma m'ọfhọ Devid, <verse eid="2SA 21:16" /><verse number="17" style="v" sid="2SA 21:17" />Okhenka, Abishayi kw'Zẹruya ofhonu, ọkkaan Devid. Uvun oPhilistiya-nạng nwọ ọfhọ. Ma wọ ajunung p'Devid achekhi bẹ́, “Ọma dạkhẹ mạna abẹ mátwạn ata ekpong, ọfha ọyaantana kw'Israẹl nạng udimi.”<verse eid="2SA 21:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 21:18" />Ukwu ukpira k'okpe ma, ekpong ẹbạra ẹtto ọttạra anạng p'Philistiya k'Gọb. Ma okpe ngwọ, Sibẹkayi kw'ubin Hushat ọfhọ Saph, kw'ode nnwa wạnọ k'ikhaana s'iva p'iva p'Rapha.<verse eid="2SA 21:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 21:19" />K'ekpong edwạkh-ọdwạk ọttạra anạng p'Philistiya k'Gọb, Ẹlhanan kw'Jair kw'ubin Bẹtẹlẹhẹm, ofhonu, ọfhọ Golayat kw'ubin Git, kw'ọkhaam ọkhọhn f'udini masẹ ẹbaanga ch'abẹ n'atima ayok ekpo.<verse eid="2SA 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 21:20" />K'ekpong ẹdwạkh-ọdwạk ch'etto k'Gat, wa ọkhaam ujunung wạnọ kw'ufu <char style="it">bẹ́ gbuk</char>, kw'ọkhaam nnọhna nsajạnẹ k'ọbọhk kwidede, ọttạra nnọhna nsajạnẹ k'ofhok kwidede. Phyi-phyibh wa ọkhaam nnọhna ẹrạbh ukuma nnebung. Wa ọbạra ode nnwa-mfona kw'Rapha. <verse eid="2SA 21:20" /><verse number="21" style="v" sid="2SA 21:21" />Masẹ wa unnukhu Israẹl, Jonatan kw'ode nnwa kw'Shimeyi, kw'ode nnwotte kw'Devid, ọfhẹ-ẹ.<verse eid="2SA 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 21:22" />Wa anạng mbọ annebung ade iva p'iva p'Rapha kw'ubin Gat. Wa Devid ọttạra ajunung pẹ bọ afhọ bẹ.<verse eid="2SA 21:22" /></para>
  <chapter eid="2SA 21" />
  <chapter number="22" style="c" sid="2SA 22" />
  <para style="s1">Ẹmạng ch'Devid ch'ẹtọhnga</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 22:1" />Masẹ Ọvaar Ubinọkpaabyi ọkkaan, ọrạbha Devid k'mbọhk s'awawunanạng pẹ phyibh, ọttạra k'mbọhk s'Saul, ma wọ ọkkọhnọ ẹmạng ọnạng Ọvaar Ubinọkpaabyi. <verse eid="2SA 22:1" /><verse number="2" style="v" sid="2SA 22:2" />Oben bẹ́:</para>
  <para style="q1" vid="2SA 22:2">“Ọvaar Ubinọkpaabyi wọ ode ẹtakpa chaam,</para>
  <para style="q2" vid="2SA 22:2">ọbạra ode ibyittubhasẹ saam,</para>
  <para style="q2" vid="2SA 22:2">ọttạra ọkkaana kwaam;<verse eid="2SA 22:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="2SA 22:3" />Ubinọkpaabyi kwaam wọ ode ẹtakpa chaam, ch'amma nttubh,</para>
  <para style="q2" vid="2SA 22:3">ode ọkhọhnkpa ọttạra ẹfa ch'ẹnnaanga chaam.</para>
  <para style="q1" vid="2SA 22:3">Ẹma wọ ode ntumu-k'nnạm kwaam, ọttạra ibyittubhasẹ saam, ọttạra ọkkaana,</para>
  <para style="q2" vid="2SA 22:3">ẹma wọ ọkkaan-m k'mbọhk s'agbaannạng.<verse eid="2SA 22:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="2SA 22:4" />Amma nyeri Ọvaar Ubinọkpaabyi, kw'ọbaan ẹtọhnga,</para>
  <para style="q2" vid="2SA 22:4">kw'khaam ọkkaana, nnaanga k'mbọhk s'awawunanạng paam.<verse eid="2SA 22:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="2SA 22:5" />“Abokhada p'obo kk'aam afhạra,</para>
  <para style="q2" vid="2SA 22:5">efhobh ch'ikhibha kk'aam ẹfa ẹna.<verse eid="2SA 22:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="2SA 22:6" />Ndikhi s'epekwur kk'iyokha ibaabh-m,</para>
  <para style="q2" vid="2SA 22:6">abẹ aro ọmma kw'obo achokh-m.<verse eid="2SA 22:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="2SA 22:7" />“Amma nnyeri Ubinọkpaabyi k'ọyạyạkhẹ kwaam,</para>
  <para style="q2" vid="2SA 22:7">Amma nnyeri Ubinọkpaabyi kwaam bẹ ọkkaan-m.</para>
  <para style="q1" vid="2SA 22:7">Ọvaar Ubinọkpaabyi ọbhaang ẹmạng chaam k'ọchọhm kwẹ;</para>
  <para style="q2" vid="2SA 22:7">ẹmạng chaam kk'Ọvaar Ubinọkpaabyi ikpira k'itọhng.<verse eid="2SA 22:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="2SA 22:8" />Iyagbin ifhạnọ, ibạra ipoma,</para>
  <para style="q2" vid="2SA 22:8">agbaarẹ p'ọrạngkpakpa anyengi,</para>
  <para style="q2" vid="2SA 22:8">abẹ afhạnọ ukwuru idwạdwạkhọ sẹ.<verse eid="2SA 22:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="2SA 22:9" />Isusong iyin-ẹ k'asung-maang,</para>
  <para style="q2" vid="2SA 22:9">akpon-daak py'akhạm-ọkhạm ayin-ẹ k'ẹmma,</para>
  <para style="q2" vid="2SA 22:9">akponkạnga abạra ayạma ekpon ma.<verse eid="2SA 22:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="2SA 22:10" />Udwu akpaang osenga ma ọsạkha,</para>
  <para style="q2" vid="2SA 22:10">ebona ch'ipyi <char style="it">bẹ́ kkạạng,</char> ining k'mfhokpatwạkhọ sẹ.<verse eid="2SA 22:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="2SA 22:11" />Uvur k'chẹrubim ukwur;</para>
  <para style="q2" vid="2SA 22:11">Osenga k'abạbaang p'ufum ukwur.<verse eid="2SA 22:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="2SA 22:12" />Utim ituntumu usi ukkira ububha ẹma oyeni,</para>
  <para style="q2" vid="2SA 22:12">usi ebọna ch'ẹrạng achẹ ipyi irungu <char style="it">bẹ́ kkạạng</char> k'ọrạngkpang.<verse eid="2SA 22:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="2SA 22:13" />K'ottemkwẹ kw'ọyaanttaana, k'ititikha sẹ,</para>
  <para style="q2" vid="2SA 22:13">akponkạnga ayạm ekpon.<verse eid="2SA 22:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="2SA 22:14" />Ọvaar Ubinọkpaabyi uning kha ọvaar-fhon kwẹ ọtta itum masẹ ẹbhaamkpon.</para>
  <para style="q2" vid="2SA 22:14">Ọvaar Ubinọkpaabyi kw'Ọyọhng ọbạra ọttạbhẹ ẹmạng k'ẹrạng.<verse eid="2SA 22:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="2SA 22:15" />Ọtta ayuk, ukwuru awawuna-nạng,</para>
  <para style="q2" vid="2SA 22:15">utima akponkạnga p'ayạm ekpon chididen ukhubh bẹ.<verse eid="2SA 22:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="2SA 22:16" />Ẹmạng ch'Ọvaar Ubinọkpaabyi ọttạbhẹ,</para>
  <para style="q2" vid="2SA 22:16">ọttạra iyọhng s'ọjẹ k'asung-maang pẹ,</para>
  <para style="q1" vid="2SA 22:16">asi adong p'ẹraanga-diden ajạn k'ọyaankpa,</para>
  <para style="q2" vid="2SA 22:16">ibạra isi agbaarẹ p'ọyagbin atto eje.<verse eid="2SA 22:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="2SA 22:17" />Uning k'ẹrạng, onemi ọbọhk ọvạkh-m,</para>
  <para style="q2" vid="2SA 22:17">owong-m k'asi p'adong-odong utim-m uyin kha.<verse eid="2SA 22:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="2SA 22:18" />Ọrạbh-m k'mbọhk s'awawuna-nạng paam p'akhaam ẹfa,</para>
  <para style="q2" vid="2SA 22:18">ọrạbh-m k'mbọhk s'awawuna-nạng paam p'akpọhkhọ ayọhng-m.<verse eid="2SA 22:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="2SA 22:19" />Abẹ arim abamẹ k'iwu ch'idik ikhebh-m,</para>
  <para style="q2" vid="2SA 22:19">okhenka, Ọvaar Ubinọkpaabyi wọ wa ode itumạm saam.<verse eid="2SA 22:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="2SA 22:20" />Ọchọkh-m k'ibyi s'immaam ẹkpa,</para>
  <para style="q2" vid="2SA 22:20">ọkkaan-m, ukwuru s'ọkhaam ọttennebh abamẹ.<verse eid="2SA 22:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="2SA 22:21" />“Ọvaar Ubinọkpaabyi usi-m ẹtaam otor k'atorada paam,</para>
  <para style="q2" vid="2SA 22:21">kk'aam ọtaama otor k'awurada p'mbọhk saam.<verse eid="2SA 22:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="2SA 22:22" />Amma kk'nden s'Ọvaar Ubinọkpaabyi ntora,</para>
  <para style="q2" vid="2SA 22:22">iponga khaam nípyibha, s'nạn nnạm nạ́mkpa mvạra Ubinọkpaabyi kwaam.<verse eid="2SA 22:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="2SA 22:23" />Amma kk'nnyina sẹ phyibh nchokha,</para>
  <para style="q2" vid="2SA 22:23">nnạm nạ́mbạra mkpa mvạra ntọhna sẹ.<verse eid="2SA 22:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="2SA 22:24" />Iponga-pyibha k'akhẹ k'ititikha kạ́nkhaam,</para>
  <para style="q2" vid="2SA 22:24">kk'ifhor saam nnenga k'ipyibha.<verse eid="2SA 22:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="2SA 22:25" />Ọvaar Ubinọkpaabyi kk'aam ọtaama otor k'atorada paam,</para>
  <para style="q2" vid="2SA 22:25">kk'aam ọtaama otor k'awurada p'mbọhk saam.<verse eid="2SA 22:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="2SA 22:26" />“Ẹma nwọ kw'ọsạk echo ọnạng-ọ,</para>
  <para style="q2" vid="2SA 22:26">ẹwọ m'akhọhkha idạdaakha sọ.</para>
  <para style="q2" vid="2SA 22:26">M'asi ijibha anạng ọnạng kw'nạn ipina ọkhaam.<verse eid="2SA 22:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="2SA 22:27" />Ọnạng nwọ kw'uwur-uwur, ẹwọ kw'm'akhọhkha awurada pọ,</para>
  <para style="q2" vid="2SA 22:27">okhenka, ọnạng kw'usi ibyibya-dik, ẹwọ m'asi-ẹ igbaan.<verse eid="2SA 22:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="2SA 22:28" />M'akkaana ọnạng kw'ọsạk ifhor sẹ,</para>
  <para style="q2" vid="2SA 22:28">okhenka, m'asạkha ọnạng kw'ose ifhor sẹ ininga.<verse eid="2SA 22:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="2SA 22:29" />Ọvaar Ubinọkpaabyi, ọma wọ ade ọyaanttaana kwaam,</para>
  <para style="q2" vid="2SA 22:29">Ọvaar Ubinọkpaabyi usi uwutuma kwaam otto iyaan.<verse eid="2SA 22:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="2SA 22:30" />Ẹkkaana chọ ẹjọ m'ntima nnima akpongnạng abẹ;</para>
  <para style="q2" vid="2SA 22:30">k'ẹfa ch'Ubinọkpaabyi kwaam, nkke-okẹ mgbe abaakha pabẹ njekha.<verse eid="2SA 22:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="2SA 22:31" />“Eden ch'Ubinọkpaabyi etor-otor:</para>
  <para style="q2" vid="2SA 22:31">Ọkpaakhadik kw'Ubinọkpaabyi ipina kkọ́khaam.</para>
  <para style="q2" vid="2SA 22:31">Ẹma ode ọkhọhnkpa kw'ububh anạng p'attubh k'akhẹ.<verse eid="2SA 22:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="2SA 22:32" />Anẹ wọ m'akpobha kw'ọyọhng Ọvaar Ubinọkpaabyi?</para>
  <para style="q2" vid="2SA 22:32">Anẹ wọ ode Ẹtakpa chamạna ch'ẹyọhng Ubinọkpaabyi?<verse eid="2SA 22:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="2SA 22:33" />Ẹma Ubinọkpaabyi wọ utim ẹfa chẹ ọbaabh-m,</para>
  <para style="q2" vid="2SA 22:33">ọbaabha eden chaam.<verse eid="2SA 22:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="2SA 22:34" />M'usi mfhok saam ikhaama ẹfa masẹ nnọ s'uchimi,</para>
  <para style="q2" vid="2SA 22:34">usi-m mbe k'ibyi s'igor-ogoru.<verse eid="2SA 22:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="2SA 22:35" />M'okpebhi mbọhk saam irima,</para>
  <para style="q2" vid="2SA 22:35">mbọhk saam ikke-okke immena uyuk kw'brọns.<verse eid="2SA 22:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="2SA 22:36" />Ẹkkaana chọ ch'anạng-m ede ọkhọhnkpa kwaam,</para>
  <para style="q2" vid="2SA 22:36">ẹkkaana chọ kk'aam abạrada ẹnạnga.<verse eid="2SA 22:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="2SA 22:37" />Asi-m nsenga k'ọkkaden kw'ọmmaam-ẹkpa,</para>
  <para style="q2" vid="2SA 22:37">mfhok saam mípyara.<verse eid="2SA 22:37" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="38" style="v" sid="2SA 22:38" />Nkubhu awawuna-nạng paam, mbạra ndimi bẹ,</para>
  <para style="q2" vid="2SA 22:38">nnạm nạ́mkpa tạrr ndimi bẹ.<verse eid="2SA 22:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="2SA 22:39" />Ndimi bẹ phyi-phyibh, abẹ dạk kákke abina,</para>
  <para style="q2" vid="2SA 22:39">abẹ atto ayim-m k'mfhokpatwạkhọ.<verse eid="2SA 22:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="2SA 22:40" />Anạng-m ẹfa ch'ekpong ririma,</para>
  <para style="q2" vid="2SA 22:40">asi awawuna-nạng paam asạkha ncho anạng-m.<verse eid="2SA 22:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="2SA 22:41" />Asi awawuna-nạng paam arạbh-m,</para>
  <para style="q2" vid="2SA 22:41">mbạra ndimi anạng p'awun-m.<verse eid="2SA 22:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="2SA 22:42" />Abẹ agạm aror ẹkkaana, okhenka, ọnạng kw'ọkkaan bẹ kòde.</para>
  <para style="q2" vid="2SA 22:42">Abẹ agạm ayeri Ọvaar Ubinọkpaabyi, bẹ ẹpọhna nọ́bạra ọnạnga.<verse eid="2SA 22:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="2SA 22:43" />Nkokhu bẹ tạrr abẹ ape masẹ ububuma kw'isisek,</para>
  <para style="q2" vid="2SA 22:43">ndwukhu bẹ, mbạra mbyạrẹ bẹ mfhok masẹ idọhngọ s'inyọhng-ọnyọhngọ k'aden-gbaarẹ.<verse eid="2SA 22:43" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="44" style="v" sid="2SA 22:44" />“Ọma kk'aam akkaana k'mbọhk s'idifhon s'irim abamẹ,</para>
  <para style="q2" vid="2SA 22:44">achokh-m masẹ ocho kw'idifhon.</para>
  <para style="q1" vid="2SA 22:44">Anạng p'uwa nạnsóng n'aning k'isekhisek kwaam.<verse eid="2SA 22:44" /></para>
  <para style="q2">
    <verse number="45" style="v" sid="2SA 22:45" />Akhikhennạng n'aning k'ojora k'akhaam k'ititikha;</para>
  <para style="q2" vid="2SA 22:45">okpe kw'abẹ abhaang ọtọnga kwaam <char style="it">bẹ́ ẹ</char>, abẹ anạng-m ikpukpobha.<verse eid="2SA 22:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="2SA 22:46" />Ẹfa ẹsa bẹ <char style="it">bẹ́ phyibh</char>,</para>
  <para style="q2" vid="2SA 22:46">abẹ abina k'ibyitubhasẹ sabẹ, akwu k'opoma.<verse eid="2SA 22:46" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="47" style="v" sid="2SA 22:47" />“Ọvaar Ubinọkpaabyi urukhu akpen! Ẹtọhnga iyim ẹnạng Ẹtakpa chaam!</para>
  <para style="q2" vid="2SA 22:47">Tte abạrada ayima anạng Ubinọkpaabyi, kw'ode Ẹtakpa chaam, kw'ọbạra ode Ọkkaana kwaam!<verse eid="2SA 22:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="2SA 22:48" />Ẹma wọ ode Ubinọkpaabyi kw'n'utwukha idik k'echo chaam,</para>
  <para style="q2" vid="2SA 22:48">ẹma wọ ọtạk idifhon ochok k'isekh-isek kwaam,<verse eid="2SA 22:48" /></para>
  <para style="q2">
    <verse number="49" style="v" sid="2SA 22:49" />ẹma wọ ọkkaan-m k'mbọhk s'awawuna-nạng paam.</para>
  <para style="q1" vid="2SA 22:49">Ọma adir-m k'ebe ch'ẹyọhng ch'awawuna-nạng paam,</para>
  <para style="q2" vid="2SA 22:49">akkaan-m k'mbọhk s'agbạgbaana.<verse eid="2SA 22:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="2SA 22:50" />Ẹgwọ usi amma m'ntọhnga ọma Ọvaar Ubinọkpaabyi, k'ngekha s'idifhon;</para>
  <para style="q2" vid="2SA 22:50">amma m'nkkọhn mmạng ntima ntọhnga eche chọ.<verse eid="2SA 22:50" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="51" style="v" sid="2SA 22:51" />Ẹma m'ọnạng ọvaarnạng kwẹ nkhema sididen,</para>
  <para style="q2" vid="2SA 22:51">usi ijibha ọnạng nwọma kw'obyeng ana k'echo,</para>
  <para style="q2" vid="2SA 22:51">kw'ode Devid ọttạra iva p'iva pẹ, tạrr ipimmanitor.”<verse eid="2SA 22:51" /></para>
  <chapter eid="2SA 22" />
  <chapter number="23" style="c" sid="2SA 23" />
  <para style="s1">Ikpongannạm-dik s'Devid</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 23:1" />Maa wọ ode ikpongannạm-dik s'Devid:</para>
  <para style="q1" vid="2SA 23:1">“Idik s'Devid kw'ode nnwa kw'Jẹsẹ ọkpaakhẹ,</para>
  <para style="q2" vid="2SA 23:1">idik s'ujunung kw'Ọvaar Ubinọkpaabyi kw'Ọyọhng kk'udira k'erạng,</para>
  <para style="q1" vid="2SA 23:1">ujunung kw'Ubinọkpaabyi kw'Jekọb kk'ana obyenga k'echo,</para>
  <para style="q2" vid="2SA 23:1">kw'ode okkemkpa kw'abẹ akkọhnọ k'mmạng s'Israẹl:<verse eid="2SA 23:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="2SA 23:2" />“Iguguma s'Ọvaar Ubinọkpaabyi itim-m ikpaak ọtọhnga,</para>
  <para style="q2" vid="2SA 23:2">ọtọhnga kwẹ uning-m maa k'ẹdaak.<verse eid="2SA 23:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="2SA 23:3" />Ubinọkpaabyi kw'Israẹl ọkpaakhẹ ọtọhnga,</para>
  <para style="q2" vid="2SA 23:3">Ẹtakpa ch'anạng p'Israẹl eben-m bẹ́,</para>
  <para style="q1" vid="2SA 23:3">‘Ọnạng kw'ọdạbhẹ anạng k'eden ch'ẹtor-otor,</para>
  <para style="q2" vid="2SA 23:3">utima ojora f'Ubinọkpaabyi odạbhẹ bẹ;<verse eid="2SA 23:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="2SA 23:4" />ẹma m'ode masẹ ọyaanttaana kw'ekkekhạra ch'okpebha-dudon,</para>
  <para style="q2" vid="2SA 23:4">masẹ ekpebha ch'ebona nạn néde,</para>
  <para style="q1" vid="2SA 23:4">masẹ ọyaanttaana kw'ọmaanẹ k'okpe kw'orạngkpaang kk'ukuma tạtebh,</para>
  <para style="q2" vid="2SA 23:4">kw'usi asạsaarẹ amen k'isisek.’<verse eid="2SA 23:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="2SA 23:5" />“De wạra ẹchọhmfhạr chaam nạn nétora k'ititikha s'Ubinọkpaabyi,</para>
  <para style="q2" vid="2SA 23:5">k'udik ọkka, wạra echekha ch'ipimmanitor mọ́tạkha ọnạng-m,</para>
  <para style="q2" vid="2SA 23:5">wạra m'otobha chẹ ochok k'ukhubha kwidede,</para>
  <para style="q1" vid="2SA 23:5">k'udik ọkka kk'ẹnnaanga chaam usia iyin k'eden,</para>
  <para style="q2" vid="2SA 23:5">ọbạra ọnang-m fidede f'nnoru.<verse eid="2SA 23:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="2SA 23:6" />Okhenka, abyibyanạng ade masẹ akkaangẹ, py'abẹ abhạrẹ ukhubha gwạnọ,</para>
  <para style="q2" vid="2SA 23:6">py'ọnạng nạ́n k'mbọhk mòkke ọyọhkha.<verse eid="2SA 23:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="2SA 23:7" />Ọnạng kwidede kw'm'utwu akkaang-ẹ,</para>
  <para style="q2" vid="2SA 23:7">m'utima ọttọhk masẹ ẹbaanga, ọbạra ode ẹmma ch'ọkhọhn;</para>
  <para style="q2" vid="2SA 23:7">abẹ n'akkạmọ akkaangẹ k'ibyi s'apyẹ ining.<verse eid="2SA 23:7" /></para>
  <para style="s1">Akkemkpa p'Devid</para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 23:8" />Maa wọ ode ache p'akkemkpa p'Devid:</para>
  <para style="p" vid="2SA 23:8">Joshẹb-Bashẹbẹt kw'ubin Takemọn, wọ wa ode ochonạng k'ikhaana s'anạng attaan. Ẹma wọ wa utim ọkhọhn pfẹ urima ajunung nnọhhna mfa abẹ, p'ọfhọ k'okpe gwạnọ.<verse eid="2SA 23:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 23:9" />Ottong anạng afa ode Ẹleaza kw'ode nnwa kw'Dodo kw'ubin Aho. Masẹ ode ọnạng wạnọ kw'ọttạr k'ikhaana s'akkemkpa mbọ attaan, wa uning Devid abẹ k'okpe kw'abẹ asẹkhẹ aPhilistiya p'uwa atobh k'Pas-Damin bẹ́, arima ekpong. Ma wọ akpongnạng p'Israẹl atwạr ifor. <verse eid="2SA 23:9" /><verse number="10" style="v" sid="2SA 23:10" />Okhenka, Eleaza ocher obo ọfhọ aPhilistiya tạrr, ọbọhk okwokh-ẹ, ọbạra ọraakhẹ k'ọkkangkkang-kkro. Wa Ọvaar Ubinọkpaabyi ọnạngẹ bẹ ekhema chididen ma iwu njọ. Ma wọ akpongnạng akpa nnạm k'Ẹleaza. Okhenka, wa n'urikhi bẹ́, abẹ achi anạng mbọ p'kk'apua, ekpo.<verse eid="2SA 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 23:11" />Ottong anạng attaan ode Shama kw'ode nnwa kw'Agi kw'ubin Harar. K'okpe kw'aPhilistiya atobh k'ibyi mạnna rạnẹ s'achen-meni asaabh-ọsaabh, akpongnạng p'Israẹl arạbh arik bẹ. <verse eid="2SA 23:11" /><verse number="12" style="v" sid="2SA 23:12" />Okhenka, Shama odo obe k'ottemkwẹ kw'owonu ngwọ, ọkpa aPhilistiya eden, ọfhọ bẹ. Wa Ọvaar Ubinọkpaabyi ọnạngẹ bẹ ekhema chididen.<verse eid="2SA 23:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 23:13" />K'ọphyakpe, ajunung attaan k'ikhaana s'akkemkpa ẹrạbh ukuma jobh, ata akhebha Devid k'ọmma kw'ẹtakpa kw'Adulam, k'okpe kw'ikhaana s'aPhilistiya ibhingi k'Ẹkpẹmẹ ch'Rephayim. <verse eid="2SA 23:13" /><verse number="14" style="v" sid="2SA 23:14" />K'okpe ngwọ kw'Devid uning k'ibyittubhasẹ, atik-ẹbaakhamma ch'Philistiya aning k'Bẹtẹlẹhẹm. <verse eid="2SA 23:14" /><verse number="15" style="v" sid="2SA 23:15" />Asi akwu adaak Devid, oben bẹ́, “Uwo o, wạra ọnạng n'ọkhaabh asi k'isipe ch'ẹbaang ẹbaakhama ch'Bẹtẹlẹhẹm ọnạng-m ngwo!” <verse eid="2SA 23:15" /><verse number="16" style="v" sid="2SA 23:16" />Ma wọ kw'akkemkpa mbọ attaan adwu ma ibyibhingasẹ s'aPhilistiya, ata akhaabha asi k'isipe ch'ẹbaang ẹbaakhamma ch'Bẹtẹlẹhẹm, atima akkena Devid bẹ́ ogwo. Okhenka, Devid ufhumu asi mbọ gwu-gwo, oter obyenga pyẹ ma ititikha s'Ọvaar Ubinọkpaabyi masẹ ẹnạnga. <verse eid="2SA 23:16" /><verse number="17" style="v" sid="2SA 23:17" />Oben bẹ́, “O Ovaar Ubinọkpaabyi, kàchera bẹ́ amma nsi udik demakwẹ ngwa! Asi mba abạrẹ udik masẹ isẹ s'ajunung mbọ p'atạk akpen pabẹ age k'obo.” Devid ufhum asi mbọ gwu-gwo.</para>
  <para style="p" vid="2SA 23:17">Mạnna wọ wa akkemkpa mbọ attaan asi icherobo-dik nnọ.<verse eid="2SA 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 23:18" />Abishayi kw'ode nnwotte kw'Joab, kw'ọbạra ode nnwa kw'Zẹruya, wọ wa ode ocho kw'abẹma mbọ anạng attaan. Wa utim ọkhọhn pfẹ urima ajunung arạbh chi abẹ, ọfhọ bẹ. Osenga ma, uyin eche masẹ ayok mbọkha ncho nttaan. <verse eid="2SA 23:18" /><verse number="19" style="v" sid="2SA 23:19" />Wa abẹ anạng Abishayi edennạng ch'ẹbạrẹ ọtạm ẹyọhnga ch'ayok mbọkha ncho nttaan. Ẹma wọ node odecho kwabẹ, oseng s'ode bẹ́ wa k'ikhaana sabẹ nọ́ttạra.<verse eid="2SA 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 23:20" />Bẹnaya kw'ode nnwa kw'Jẹhoyada, kw'ọbạra ode okkemkpa kw'ubin Kabzil, wa ocher obo usi idik ma. Ọfhọ akkemkpa pididen afa p'Moab. Ọbạra osạkha k'ipekhuma ọta ọfhọ ekke k'iwu ch'ebona etebhi. <verse eid="2SA 23:20" /><verse number="21" style="v" sid="2SA 23:21" />Ẹma wa ọbạra ọfhọ uJip-nạng kw'ọbạrẹ ẹfa. Chibhi s'uwa uJip-nạng nwọ utim ọkhọhn k'ọbọhk, Bẹnaya utim uchikwura urima abẹ. Ọvạkha uJip-nạng nwọ ọkhọhn pfẹ ọna, utima ọfhẹ-ẹ. <verse eid="2SA 23:21" /><verse number="22" style="v" sid="2SA 23:22" />Obo kw'uwa Bẹnaya, kw'ode nnwa kw'Jẹhoyada, ocher, ẹgwọ ma. Wa ọbạra uyin eche mase akkemkpa mbọkha ncho nttaan. <verse eid="2SA 23:22" /><verse number="23" style="v" sid="2SA 23:23" />Wa abẹ akpobh-ẹ ayọhnga ajunung mbọkha ẹrạbh ukuma jobh. Okhenka, ẹma wa k'ikhaana s'akkemkpa mbọkha attaan n'ọ́ttạra. Ma wọ Devid usi-ẹ odecho kw'anạng p'n'atikh-ẹ.<verse eid="2SA 23:23" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="24" style="v" sid="2SA 23:24" />K'ikhaana s'anạng mbọ ẹrạbh ukuma jobh ode:</para>
  <para style="li2" vid="2SA 23:24">Asahẹl kw'ode nnwotte kw'Joab,</para>
  <para style="li2" vid="2SA 23:24">ọttạra Ẹlhanan kw'ode nnwa kw'Dodo kw'ubin Bẹtẹlẹhẹm,<verse eid="2SA 23:24" /></para>
  <para style="li2">
    <verse number="25" style="v" sid="2SA 23:25" />ọttạra Shama kw'ubin Harod,</para>
  <para style="li2" vid="2SA 23:25">ọttạra Ẹlika kw'ọbạra ubina Harod,<verse eid="2SA 23:25" /></para>
  <para style="li3">
    <verse number="26" style="v" sid="2SA 23:26" />ọttạra Hẹlẹz kw'ubin Palti,</para>
  <para style="li3" vid="2SA 23:26">ọttạra Ira kw'ode nnwa kw'Ikẹsh kw'ubin Tẹkoa,<verse eid="2SA 23:26" /></para>
  <para style="li3">
    <verse number="27" style="v" sid="2SA 23:27" />ọttạra Abiyẹza kw'ubin Anatọt,</para>
  <para style="li3" vid="2SA 23:27">ọttạra Sibẹkayi kw'ubin Hushat,<verse eid="2SA 23:27" /></para>
  <para style="li3">
    <verse number="28" style="v" sid="2SA 23:28" />ọttạra Zalmọn kw'ubin Aho,</para>
  <para style="li3" vid="2SA 23:28">ọttạra Maharayi kw'ubin Nẹtophat,<verse eid="2SA 23:28" /></para>
  <para style="li3">
    <verse number="29" style="v" sid="2SA 23:29" />ọttạra Hẹlẹb kw'ode nnwa kw'Baana kw'ọbạra ubina Nẹtophat,</para>
  <para style="li3" vid="2SA 23:29">ọttạra Ittayi kw'ode nnwa kw'Ribayi kw'ubin Gibea, k'ekhạma ch'Bẹnjamin,<verse eid="2SA 23:29" /></para>
  <para style="li3">
    <verse number="30" style="v" sid="2SA 23:30" />ọttạra Bẹnaya kw'ubin Piraton,</para>
  <para style="li3" vid="2SA 23:30">ọttạra Hidayi kw'ubin k'ukhubha kw'Gaash,<verse eid="2SA 23:30" /></para>
  <para style="li3">
    <verse number="31" style="v" sid="2SA 23:31" />ọttạra Abi-Albọn kw'ubin Arbat,</para>
  <para style="li3" vid="2SA 23:31">ọttạra Azmavẹt kw'ubin Barhum,<verse eid="2SA 23:31" /></para>
  <para style="li3">
    <verse number="32" style="v" sid="2SA 23:32" />ọttạra Eliyaba kw'ubin Shaalbọn, kw'Jashẹn ofhonu,</para>
  <para style="li3" vid="2SA 23:32">ọttạra ajunungva p'Jashẹn, Jonatan<verse eid="2SA 23:32" /></para>
  <para style="li3">
    <verse number="33" style="v" sid="2SA 23:33" />ọttạra Jonatan kw'ode nnwa kw'Shama kw'ubin Hara,</para>
  <para style="li3" vid="2SA 23:33">ọttạra Ahiyam kw'ode nnwa kw'Shara, kw'ọbạra ubina Harar,<verse eid="2SA 23:33" /></para>
  <para style="li3">
    <verse number="34" style="v" sid="2SA 23:34" />ọttạra Ẹliphẹlẹt kw'Ahasbayi kw'ubin Maakat ofhonu,</para>
  <para style="li3" vid="2SA 23:34">ọttạra Ẹliyam kw'Ahitophẹl kw'ubin Gilọn ofhonu,<verse eid="2SA 23:34" /></para>
  <para style="li3">
    <verse number="35" style="v" sid="2SA 23:35" />ọttạra Hẹzro kw'ubin Kaamẹl,</para>
  <para style="li3" vid="2SA 23:35">ọttạra Paarayi kw'ubin Arbit,<verse eid="2SA 23:35" /></para>
  <para style="li3">
    <verse number="36" style="v" sid="2SA 23:36" />ọttạra Igal kw'ode nnwa kw'Natan kw'ubin Zoba, kw'ọbạra ode nnwa kw'Hagri,<verse eid="2SA 23:36" /></para>
  <para style="li3">
    <verse number="37" style="v" sid="2SA 23:37" />ọttạra Zẹlẹk kw'ubin Ammọn,</para>
  <para style="li3" vid="2SA 23:37">ọttạra Naharayi kw'ubin Berot, kw'ode utim-ekpongkpo kw'Joab, kw'Zẹruya ofhonu,<verse eid="2SA 23:37" /></para>
  <para style="li3">
    <verse number="38" style="v" sid="2SA 23:38" />ọttạra Ira kw'ubin Itri,</para>
  <para style="li3" vid="2SA 23:38">ọttạra Garẹb kw'ọbạra ubina Itri,<verse eid="2SA 23:38" /></para>
  <para style="li3">
    <verse number="39" style="v" sid="2SA 23:39" />ọttạra Uriya kw'ubin Het.</para>
  <para style="li2" vid="2SA 23:39">Phyi-phyibh, wa abẹ ade anạng ẹrạbh ukuma chikhamfa.<verse eid="2SA 23:39" /></para>
  <chapter eid="2SA 23" />
  <chapter number="24" style="c" sid="2SA 24" />
  <para style="s1">Devid ubhikhi akpongnạng</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 24:1" />Wa ettem ẹbạra ipyibh Ọvaar Ubinọkpaabyi etena anạng p'Israẹl ọttạra p'Juda. Osenga akwẹma akwẹ ọchọhma Devid ọta usi bẹ abẹ ẹkhọhr, oben bẹ bẹ́, “Asọhng ata atạkha ọnạng-mik kw'Israẹl ọttạra kw'Juda.”<verse eid="2SA 24:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 24:2" />Ma wọ ọvaarnạng obeni Joab ọttạra adecho p'akpongnạng p'aning abẹ bẹ́, “Asenga abaabha nnạmma s'Israẹl, atạma k'Dan tạrr akpira k'Beershẹba, abhik akpongnạng, ọfha nsonga ubhik kw'abẹ ade.”<verse eid="2SA 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 24:3" />Joab ubhina ọvaarnạng bẹ́, “Tte Ọvaar Ubinọkpaabyi, kw'ode Ubinọkpaabyi kwọ, ọttạra ọnạng-mik kw'akpongnạng ikpe arạbh asen oyong-oyongu. Tte aro ọvaar kwaam utima achen pẹ afa ose. Bạng ọttọhk vọ usi aro ọvaar kwaam n'oben bẹ́ usi udik demakwẹ ngwọ o?”<verse eid="2SA 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 24:4" />Wa ọkpaakhadik kw'ọvaarnạng ọkpọhkhọ ọyọhnga kw'Joab ọttạra kw'adecho p'akpongnạng. Ma wọ abẹ abin arik ọvaarnạng, ata abhik akpongnạng p'Israẹl.<verse eid="2SA 24:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 24:5" />Masẹ abẹ kk'Jọrdan ajekha, abẹ abhingi abaanga Aroẹ, k'ẹrạkh-ẹrạkha kw'ofhon kw'usi ẹkpẹmẹ. Abẹ asenga k'Gad afona k'Jaza. <verse eid="2SA 24:5" /><verse number="6" style="v" sid="2SA 24:6" />Abẹ aseng afona k'Gilead, ọttạra k'ẹkhạma ch'Tatim Hodshi, afona k'Dan Jaan, atena k'Sidon. <verse eid="2SA 24:6" /><verse number="7" style="v" sid="2SA 24:7" />Abẹ n'asengi atena k'ibyittubhasẹ s'Tyrẹ, ọttạra k'ifhon s'aHiv, ọttạra s'aKenaan phyi-phyibh. Abẹ n'akpong nnạm afona k'Beershẹba kw'uning k'Nẹgẹv, k'ẹkhạma ch'Juda.<verse eid="2SA 24:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 24:8" />Masẹ abẹ kk'asenga abaabha isisek nnọ phyibh k'aphye sọnẹrạbh, abẹ akpa nnạm k'Jẹrusalẹm.<verse eid="2SA 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 24:9" />Joab ọkpaakhẹ ọvaarnạng ọnạng-mik kw'akpongnạng. Ọnạng-mik kw'afanạng p'Israẹl ode nnọhna arạbh asen p'akke ọkkangkkang-kkro vạvạkha. Ọnạng-mik kw'Juda ode nnọhna arạbh attaan ukuma arạbh afa ukuma jobh.<verse eid="2SA 24:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 24:10" />Masẹ Devid kk'akpongnạng ubhikha phyibh, ẹttem ẹphyaang-ẹ ẹmma tạrr n'obeni Ọvaar Ubinọkpaabyi bẹ́, “Amma kk'ipyibha chididen nsia maa udik ngwa. Tọtọkhạn o, Ọvaar Ubinọkpaabyi, bina ma nạng ipina ch'amma ọtọhmnạng kwọ. Amma kk'idindingi-dik nsia e.”<verse eid="2SA 24:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 24:11" />Brasẹ Devid n'ọphyạbh k'ekpebha, ọkpaakha-dik kw'Ọvaar Ubinọkpaabyi kk'Gad kw'ode usi-ẹyaakha, kw'ọbạra ode ichen s'Devid ukpira bẹ́: <verse eid="2SA 24:11" /><verse number="12" style="v" sid="2SA 24:12" />“Sọhng ata akpaak Devid bẹ́, ‘Maa wọ ode udik kw'Ọvaar Ubinọkpaabyi ọkpaakhẹ: Amma njọ-ọ idik ittaan k'ititikha bẹ́, atekha gwạnọ kw'm'ntima mkpaara iponga sọ.’ ”<verse eid="2SA 24:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 24:13" />Mạnna wọ Gad ọta okhebha Devid, oben-ẹ bẹ́, “Maa s'm'ọdaakh-ọ bẹ́, okwo fididen uninga k'isisek sọ k'icho ittaan o? S'm'ọbạra ọdaakh-ọ bẹ́, arạbh abhạrkpa p'awawuna-nạng pọ m'akhubh bạnga k'aphye attaan? M'ọdaakh-ọ bẹ́, ọkhạnkhạmọ kwididen otto maa k'isisek nna k'iwu ittaan yeri? Bạbh ettem chọ tena ma idik nnọ mantọmma, atekh-m oche kw'akkẹ, ọfha nta mkpaak ọnạng kw'ọtọhm-m.”<verse eid="2SA 24:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 24:14" />Wa Devid obeni Gad bẹ́, “Ettem ẹphyaang-m ẹmma o. Uttu kw'm'antto k'mbọhk s'ayokhanạng, tte antera antto k'mbọhk s'Ọvaar Ubinọkpaabyi kw'ikwosi sẹ ibạrẹ-ọbạr.”<verse eid="2SA 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 24:15" />Mạnna wọ kw'Ọvaar Ubinọkpaabyi ọtọhmọ ọkhạnkhạmọ kwididen k'Israẹl, kw'ọtạm k'ekpebha tạrr ukpira k'iwu ch'abẹ age. Wa anạng nnọhna arạbh asenọttaan ukuma chi ape, tạma k'Dan tạrr ukpira Beershẹba. <verse eid="2SA 24:15" /><verse number="16" style="v" sid="2SA 24:16" />Masẹ oseng-eden kw'Ubinọkpaabyi onemi ọbọhk bẹ́ udimi Jẹrusalẹm echomajạnẹ, Ọvaar Ubinọkpaabyi ofhona ettem otena k'ọkhạnkạmọ nwọ. N'obeni oseng-eden kwẹ bẹ́, “Tte mạnna! Twạr ọbọhk kwọ.” Wa oseng-eden nwọ kw'Ọvaar Ubinọkpaabyi n'ọta uninga k'ibyi sabẹ n'aninga ayuk agwu-mạma, s'Arawuna kw'ubin Jẹbus ọkhaam.<verse eid="2SA 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 24:17" />Masẹ Devid ose oseng-eden nwọ kw'n'ọfhọ anạng, oben Ọvaar Ubinọkpaabyi bẹ́, “Amma kk'ipyibha nsia e; amma okkeri-arạkhạmaan, kk'ipina nsia e. Abẹma mbọ akhenka ade masẹ arạkhạmaan. Abẹ ajẹ bạng udik? Tte ọkhạnkhạmọ ọkpẹkhẹ amma ọttạra ẹchọhmfhạr chaam kadẹ.”<verse eid="2SA 24:17" /></para>
  <para style="s1">Devid usi ijabyi</para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 24:18" />Ma iwu njọ, Gad ọta okhebha Devid oben-ẹ bẹ́, “Vura, asọhng ata asi ijabyi anạng Ọvaar Ubinọkpaabyi k'ibyi sabẹ n'aninga ayuk agwu-mạma, k'ochọhm kw'Arawuna kw'ubin Jẹbus.” <verse eid="2SA 24:18" /><verse number="19" style="v" sid="2SA 24:19" />Mạnna wọ kw'Devid uvur, otor k'oche kw'Ọvaar Ubinọkpaabyi kk'Gad utima oben-ẹ bẹ́, usi. <verse eid="2SA 24:19" /><verse number="20" style="v" sid="2SA 24:20" />K'okpe kw'Arawuna n'ose s'ọvaarnạng ọttạra ayok-ikhaana pẹ n'asenga ator-ẹ, uyin k'iyaan ọta ọrạkha uttima ititikha k'isek ma ititikha s'ọvaarnạng.<verse eid="2SA 24:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 24:21" />Arawuna ọbạbh bẹ́, “Ode yạn kw'aro ọvaar kwaam n'oror amma ọtọhmnạng kwẹ o?”</para>
  <para style="p" vid="2SA 24:21">Devid ubhina bẹ́, “Nkwu bẹ́, nkwu ndebh ibyi sọ sabẹ n'aninga ayuk agwu-mạma, ọfha nsi ijabyi maa nnạng Ọvaar Ubinọkpaabyi, ọfha ọkhạnkhạmọ kw'otto okhebha anạng mbama ukuma.”<verse eid="2SA 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 24:22" />Arawuna oben Devid bẹ́, “Tte aro ọvaar kwaam ọtạkha ọttọhk fidede f'ọdaakh-ẹ, utima usi ẹnạnga. Kkeri mmaam s'ẹnạnga ẹkkạmachẹ maa, ọttạra otegba f'abẹ n'atima ayuk agwu-mạma, ọttạra ayagba p'mmaam p'm'atima masẹ ommeni. <verse eid="2SA 24:22" /><verse number="23" style="v" sid="2SA 24:23" />K'ẹvaar chọ, amma Arawuna kk'ekpo mbya phyibh ntạkha nnạng ọma ọvaarnạng. Tte Ọvaar Ubinọkpaabyi, kw'ode Ubinọkpaabyi kwọ, ọtạkha ẹja chọ.”<verse eid="2SA 24:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 24:24" />Okhenka, ọvaarnạng ubhin Arawuna bẹ́, “Mma e, amma ọdaakh-m bẹ́, nnạng akpokha ma ekpo mbya e. Amma ẹja ẹkkạmachẹ ch'nạn khaam ọttọhk nípua, mạ́mfọhnọ nnạng Ọvaar Ubinọkpaabyi, kw'ode Ubinọkpaabyi kwaam.”</para>
  <para style="p" vid="2SA 24:24">Ma wọ Devid odebhi ibyi nnọ sabẹ n'aninga ayuk agwu-mạma, ọttạra mmaam, k'ashẹkẹl p'silva arạbh afa ukuma jobh.<verse eid="2SA 24:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2SA 24:25" />Wa Devid usi ijabyi mạma ọnạng Ọvaar Ubinọkpaabyi. Ọfọhnọ ẹja ẹkkạmachẹ ọttạra ẹnạnga ch'idira ma. Ma wọ, Ọvaar Ubinọkpaabyi ọbhaang njọhm sẹ otena k'isisek nnọ. Ọkhạnkhạmọ kw'otto Israẹl ukuma.<verse eid="2SA 24:25" /></para>
  <chapter eid="2SA 24" />
</usx>