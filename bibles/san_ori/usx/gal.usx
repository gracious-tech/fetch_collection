<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="GAL" style="id">Sanskrit Bible (NT) in Oriya Script (ସତ୍ୟୱେଦଃ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">Galatians</para>
  <para style="toc1">ଗାଲାତିନଃ ପତ୍ରଂ</para>
  <para style="toc2">ଗାଲାତିନଃ</para>
  <para style="toc3">ଗାଲାତିନଃ</para>
  <para style="mt1">ଗାଲାତିନଃ ପତ୍ରଂ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ମନୁଷ୍ୟେଭ୍ୟୋ ନହି ମନୁଷ୍ୟୈରପି ନହି କିନ୍ତୁ ଯୀଶୁଖ୍ରୀଷ୍ଟେନ ମୃତଗଣମଧ୍ୟାତ୍ ତସ୍ୟୋତ୍ଥାପଯିତ୍ରା ପିତ୍ରେଶ୍ୱରେଣ ଚ ପ୍ରେରିତୋ ଯୋଽହଂ ପୌଲଃ ସୋଽହଂ</para>
  <para style="p">
    <verse number="2" style="v"/>ମତ୍ସହୱର୍ତ୍ତିନୋ ଭ୍ରାତରଶ୍ଚ ୱଯଂ ଗାଲାତୀଯଦେଶସ୍ଥାଃ ସମିତୀଃ ପ୍ରତି ପତ୍ରଂ ଲିଖାମଃ|</para>
  <para style="p">
    <verse number="3" style="v"/>ପିତ୍ରେଶ୍ୱରେଣାସ୍ମାଂକ ପ୍ରଭୁନା ଯୀଶୁନା ଖ୍ରୀଷ୍ଟେନ ଚ ଯୁଷ୍ମଭ୍ୟମ୍ ଅନୁଗ୍ରହଃ ଶାନ୍ତିଶ୍ଚ ଦୀଯତାଂ|</para>
  <para style="p">
    <verse number="4" style="v"/>ଅସ୍ମାକଂ ତାତେଶ୍ୱରେସ୍ୟେଚ୍ଛାନୁସାରେଣ ୱର୍ତ୍ତମାନାତ୍ କୁତ୍ସିତସଂସାରାଦ୍ ଅସ୍ମାନ୍ ନିସ୍ତାରଯିତୁଂ ଯୋ</para>
  <para style="p">
    <verse number="5" style="v"/>ଯୀଶୁରସ୍ମାକଂ ପାପହେତୋରାତ୍ମୋତ୍ସର୍ଗଂ କୃତୱାନ୍ ସ ସର୍ୱ୍ୱଦା ଧନ୍ୟୋ ଭୂଯାତ୍| ତଥାସ୍ତୁ|</para>
  <para style="p">
    <verse number="6" style="v"/>ଖ୍ରୀଷ୍ଟସ୍ୟାନୁଗ୍ରହେଣ ଯୋ ଯୁଷ୍ମାନ୍ ଆହୂତୱାନ୍ ତସ୍ମାନ୍ନିୱୃତ୍ୟ ଯୂଯମ୍ ଅତିତୂର୍ଣମ୍ ଅନ୍ୟଂ ସୁସଂୱାଦମ୍ ଅନ୍ୱୱର୍ତ୍ତତ ତତ୍ରାହଂ ୱିସ୍ମଯଂ ମନ୍ୟେ|</para>
  <para style="p">
    <verse number="7" style="v"/>ସୋଽନ୍ୟସୁସଂୱାଦଃ ସୁସଂୱାଦୋ ନହି କିନ୍ତୁ କେଚିତ୍ ମାନୱା ଯୁଷ୍ମାନ୍ ଚଞ୍ଚଲୀକୁର୍ୱ୍ୱନ୍ତି ଖ୍ରୀଷ୍ଟୀଯସୁସଂୱାଦସ୍ୟ ୱିପର୍ୟ୍ୟଯଂ କର୍ତ୍ତୁଂ ଚେଷ୍ଟନ୍ତେ ଚ|</para>
  <para style="p">
    <verse number="8" style="v"/>ଯୁଷ୍ମାକଂ ସନ୍ନିଧୌ ଯଃ ସୁସଂୱାଦୋଽସ୍ମାଭି ର୍ଘୋଷିତସ୍ତସ୍ମାଦ୍ ଅନ୍ୟଃ ସୁସଂୱାଦୋଽସ୍ମାକଂ ସ୍ୱର୍ଗୀଯଦୂତାନାଂ ୱା ମଧ୍ୟେ କେନଚିଦ୍ ଯଦି ଘୋଷ୍ୟତେ ତର୍ହି ସ ଶପ୍ତୋ ଭୱତୁ|</para>
  <para style="p">
    <verse number="9" style="v"/>ପୂର୍ୱ୍ୱଂ ଯଦ୍ୱଦ୍ ଅକଥଯାମ, ଇଦାନୀମହଂ ପୁନସ୍ତଦ୍ୱତ୍ କଥଯାମି ଯୂଯଂ ଯଂ ସୁସଂୱାଦଂ ଗୃହୀତୱନ୍ତସ୍ତସ୍ମାଦ୍ ଅନ୍ୟୋ ଯେନ କେନଚିଦ୍ ଯୁଷ୍ମତ୍ସନ୍ନିଧୌ ଘୋଷ୍ୟତେ ସ ଶପ୍ତୋ ଭୱତୁ|</para>
  <para style="p">
    <verse number="10" style="v"/>ସାମ୍ପ୍ରତଂ କମହମ୍ ଅନୁନଯାମି? ଈଶ୍ୱରଂ କିଂୱା ମାନୱାନ୍? ଅହଂ କିଂ ମାନୁଷେଭ୍ୟୋ ରୋଚିତୁଂ ଯତେ? ଯଦ୍ୟହମ୍ ଇଦାନୀମପି ମାନୁଷେଭ୍ୟୋ ରୁରୁଚିଷେଯ ତର୍ହି ଖ୍ରୀଷ୍ଟସ୍ୟ ପରିଚାରକୋ ନ ଭୱାମି|</para>
  <para style="p">
    <verse number="11" style="v"/>ହେ ଭ୍ରାତରଃ, ମଯା ଯଃ ସୁସଂୱାଦୋ ଘୋଷିତଃ ସ ମାନୁଷାନ୍ନ ଲବ୍ଧସ୍ତଦହଂ ଯୁଷ୍ମାନ୍ ଜ୍ଞାପଯାମି|</para>
  <para style="p">
    <verse number="12" style="v"/>ଅହଂ କସ୍ମାଚ୍ଚିତ୍ ମନୁଷ୍ୟାତ୍ ତଂ ନ ଗୃହୀତୱାନ୍ ନ ୱା ଶିକ୍ଷିତୱାନ୍ କେୱଲଂ ଯୀଶୋଃ ଖ୍ରୀଷ୍ଟସ୍ୟ ପ୍ରକାଶନାଦେୱ|</para>
  <para style="p">
    <verse number="13" style="v"/>ପୁରା ଯିହୂଦିମତାଚାରୀ ଯଦାହମ୍ ଆସଂ ତଦା ଯାଦୃଶମ୍ ଆଚରଣମ୍ ଅକରୱମ୍ ଈଶ୍ୱରସ୍ୟ ସମିତିଂ ପ୍ରତ୍ୟତୀୱୋପଦ୍ରୱଂ କୁର୍ୱ୍ୱନ୍ ଯାଦୃକ୍ ତାଂ ୱ୍ୟନାଶଯଂ ତଦୱଶ୍ୟଂ ଶ୍ରୁତଂ ଯୁଷ୍ମାଭିଃ|</para>
  <para style="p">
    <verse number="14" style="v"/>ଅପରଞ୍ଚ ପୂର୍ୱ୍ୱପୁରୁଷପରମ୍ପରାଗତେଷୁ ୱାକ୍ୟେଷ୍ୱନ୍ୟାପେକ୍ଷାତୀୱାସକ୍ତଃ ସନ୍ ଅହଂ ଯିହୂଦିଧର୍ମ୍ମତେ ମମ ସମୱଯସ୍କାନ୍ ବହୂନ୍ ସ୍ୱଜାତୀଯାନ୍ ଅତ୍ୟଶଯି|</para>
  <para style="p">
    <verse number="15" style="v"/>କିଞ୍ଚ ଯ ଈଶ୍ୱରୋ ମାତୃଗର୍ଭସ୍ଥଂ ମାଂ ପୃଥକ୍ କୃତ୍ୱା ସ୍ୱୀଯାନୁଗ୍ରହେଣାହୂତୱାନ୍</para>
  <para style="p">
    <verse number="16" style="v"/>ସ ଯଦା ମଯି ସ୍ୱପୁତ୍ରଂ ପ୍ରକାଶିତୁଂ ଭିନ୍ନଦେଶୀଯାନାଂ ସମୀପେ ଭଯା ତଂ ଘୋଷଯିତୁଞ୍ଚାଭ୍ୟଲଷତ୍ ତଦାହଂ କ୍ରୱ୍ୟଶୋଣିତାଭ୍ୟାଂ ସହ ନ ମନ୍ତ୍ରଯିତ୍ୱା</para>
  <para style="p">
    <verse number="17" style="v"/>ପୂର୍ୱ୍ୱନିଯୁକ୍ତାନାଂ ପ୍ରେରିତାନାଂ ସମୀପଂ ଯିରୂଶାଲମଂ ନ ଗତ୍ୱାରୱଦେଶଂ ଗତୱାନ୍ ପଶ୍ଚାତ୍ ତତ୍ସ୍ଥାନାଦ୍ ଦମ୍ମେଷକନଗରଂ ପରାୱୃତ୍ୟାଗତୱାନ୍|</para>
  <para style="p">
    <verse number="18" style="v"/>ତତଃ ପରଂ ୱର୍ଷତ୍ରଯେ ୱ୍ୟତୀତେଽହଂ ପିତରଂ ସମ୍ଭାଷିତୁଂ ଯିରୂଶାଲମଂ ଗତ୍ୱା ପଞ୍ଚଦଶଦିନାନି ତେନ ସାର୍ଦ୍ଧମ୍ ଅତିଷ୍ଠଂ|</para>
  <para style="p">
    <verse number="19" style="v"/>କିନ୍ତୁ ତଂ ପ୍ରଭୋ ର୍ଭ୍ରାତରଂ ଯାକୂବଞ୍ଚ ୱିନା ପ୍ରେରିତାନାଂ ନାନ୍ୟଂ କମପ୍ୟପଶ୍ୟଂ|</para>
  <para style="p">
    <verse number="20" style="v"/>ଯାନ୍ୟେତାନି ୱାକ୍ୟାନି ମଯା ଲିଖ୍ୟନ୍ତେ ତାନ୍ୟନୃତାନି ନ ସନ୍ତି ତଦ୍ ଈଶ୍ୱରୋ ଜାନାତି|</para>
  <para style="p">
    <verse number="21" style="v"/>ତତଃ ପରମ୍ ଅହଂ ସୁରିଯାଂ କିଲିକିଯାଞ୍ଚ ଦେଶୌ ଗତୱାନ୍|</para>
  <para style="p">
    <verse number="22" style="v"/>ତଦାନୀଂ ଯିହୂଦାଦେଶସ୍ଥାନାଂ ଖ୍ରୀଷ୍ଟସ୍ୟ ସମିତୀନାଂ ଲୋକାଃ ସାକ୍ଷାତ୍ ମମ ପରିଚଯମପ୍ରାପ୍ୟ କେୱଲଂ ଜନଶ୍ରୁତିମିମାଂ ଲବ୍ଧୱନ୍ତଃ,</para>
  <para style="p">
    <verse number="23" style="v"/>ଯୋ ଜନଃ ପୂର୍ୱ୍ୱମ୍ ଅସ୍ମାନ୍ ପ୍ରତ୍ୟୁପଦ୍ରୱମକରୋତ୍ ସ ତଦା ଯଂ ଧର୍ମ୍ମମନାଶଯତ୍ ତମେୱେଦାନୀଂ ପ୍ରଚାରଯତୀତି|</para>
  <para style="p">
    <verse number="24" style="v"/>ତସ୍ମାତ୍ ତେ ମାମଧୀଶ୍ୱରଂ ଧନ୍ୟମୱଦନ୍|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ଅନନ୍ତରଂ ଚତୁର୍ଦଶସୁ ୱତ୍ସରେଷୁ ଗତେଷ୍ୱହଂ ବର୍ଣବ୍ବା ସହ ଯିରୂଶାଲମନଗରଂ ପୁନରଗଚ୍ଛଂ, ତଦାନୋଂ ତୀତମପି ସ୍ୱସଙ୍ଗିନମ୍ ଅକରୱଂ|</para>
  <para style="p">
    <verse number="2" style="v"/>ତତ୍କାଲେଽହମ୍ ଈଶ୍ୱରଦର୍ଶନାଦ୍ ଯାତ୍ରାମ୍ ଅକରୱଂ ମଯା ଯଃ ପରିଶ୍ରମୋଽକାରି କାରିଷ୍ୟତେ ୱା ସ ଯନ୍ନିଷ୍ଫଲୋ ନ ଭୱେତ୍ ତଦର୍ଥଂ ଭିନ୍ନଜାତୀଯାନାଂ ମଧ୍ୟେ ମଯା ଘୋଷ୍ୟମାଣଃ ସୁସଂୱାଦସ୍ତତ୍ରତ୍ୟେଭ୍ୟୋ ଲୋକେଭ୍ୟୋ ୱିଶେଷତୋ ମାନ୍ୟେଭ୍ୟୋ ନରେଭ୍ୟୋ ମଯା ନ୍ୟୱେଦ୍ୟତ|</para>
  <para style="p">
    <verse number="3" style="v"/>ତତୋ ମମ ସହଚରସ୍ତୀତୋ ଯଦ୍ୟପି ଯୂନାନୀଯ ଆସୀତ୍ ତଥାପି ତସ୍ୟ ତ୍ୱକ୍ଛେଦୋଽପ୍ୟାୱଶ୍ୟକୋ ନ ବଭୂୱ|</para>
  <para style="p">
    <verse number="4" style="v"/>ଯତଶ୍ଛଲେନାଗତା ଅସ୍ମାନ୍ ଦାସାନ୍ କର୍ତ୍ତୁମ୍ ଇଚ୍ଛୱଃ କତିପଯା ଭାକ୍ତଭ୍ରାତରଃ ଖ୍ରୀଷ୍ଟେନ ଯୀଶୁନାସ୍ମଭ୍ୟଂ ଦତ୍ତଂ ସ୍ୱାତନ୍ତ୍ର୍ୟମ୍ ଅନୁସନ୍ଧାତୁଂ ଚାରା ଇୱ ସମାଜଂ ପ୍ରାୱିଶନ୍|</para>
  <para style="p">
    <verse number="5" style="v"/>ଅତଃ ପ୍ରକୃତେ ସୁସଂୱାଦେ ଯୁଷ୍ମାକମ୍ ଅଧିକାରୋ ଯତ୍ ତିଷ୍ଠେତ୍ ତଦର୍ଥଂ ୱଯଂ ଦଣ୍ଡୈକମପି ଯାୱଦ୍ ଆଜ୍ଞାଗ୍ରହଣେନ ତେଷାଂ ୱଶ୍ୟା ନାଭୱାମ|</para>
  <para style="p">
    <verse number="6" style="v"/>ପରନ୍ତୁ ଯେ ଲୋକା ମାନ୍ୟାସ୍ତେ ଯେ କେଚିଦ୍ ଭୱେଯୁସ୍ତାନହଂ ନ ଗଣଯାମି ଯତ ଈଶ୍ୱରଃ କସ୍ୟାପି ମାନୱସ୍ୟ ପକ୍ଷପାତଂ ନ କରୋତି, ଯେ ଚ ମାନ୍ୟାସ୍ତେ ମାଂ କିମପି ନୱୀନଂ ନାଜ୍ଞାପଯନ୍|</para>
  <para style="p">
    <verse number="7" style="v"/>କିନ୍ତୁ ଛିନ୍ନତ୍ୱଚାଂ ମଧ୍ୟେ ସୁସଂୱାଦପ୍ରଚାରଣସ୍ୟ ଭାରଃ ପିତରି ଯଥା ସମର୍ପିତସ୍ତଥୈୱାଚ୍ଛିନ୍ନତ୍ୱଚାଂ ମଧ୍ୟେ ସୁସଂୱାଦପ୍ରଚାରଣସ୍ୟ ଭାରୋ ମଯି ସମର୍ପିତ ଇତି ତୈ ର୍ବୁବୁଧେ|</para>
  <para style="p">
    <verse number="8" style="v"/>ଯତଶ୍ଛିନ୍ନତ୍ୱଚାଂ ମଧ୍ୟେ ପ୍ରେରିତତ୍ୱକର୍ମ୍ମଣେ ଯସ୍ୟ ଯା ଶକ୍ତିଃ ପିତରମାଶ୍ରିତୱତୀ ତସ୍ୟୈୱ ସା ଶକ୍ତି ର୍ଭିନ୍ନଜାତୀଯାନାଂ ମଧ୍ୟେ ତସ୍ମୈ କର୍ମ୍ମଣେ ମାମପ୍ୟାଶ୍ରିତୱତୀ|</para>
  <para style="p">
    <verse number="9" style="v"/>ଅତୋ ମହ୍ୟଂ ଦତ୍ତମ୍ ଅନୁଗ୍ରହଂ ପ୍ରତିଜ୍ଞାଯ ସ୍ତମ୍ଭା ଇୱ ଗଣିତା ଯେ ଯାକୂବ୍ କୈଫା ଯୋହନ୍ ଚୈତେ ସହାଯତାସୂଚକଂ ଦକ୍ଷିଣହସ୍ତଗ୍ରହଂଣ ୱିଧାଯ ମାଂ ବର୍ଣବ୍ବାଞ୍ଚ ଜଗଦୁଃ, ଯୁୱାଂ ଭିନ୍ନଜାତୀଯାନାଂ ସନ୍ନିଧିଂ ଗଚ୍ଛତଂ ୱଯଂ ଛିନ୍ନତ୍ୱଚା ସନ୍ନିଧିଂ ଗଚ୍ଛାମଃ,</para>
  <para style="p">
    <verse number="10" style="v"/>କେୱଲଂ ଦରିଦ୍ରା ଯୁୱାଭ୍ୟାଂ ସ୍ମରଣୀଯା ଇତି| ଅତସ୍ତଦେୱ କର୍ତ୍ତୁମ୍ ଅହଂ ଯତେ ସ୍ମ|</para>
  <para style="p">
    <verse number="11" style="v"/>ଅପରମ୍ ଆନ୍ତିଯଖିଯାନଗରଂ ପିତର ଆଗତେଽହଂ ତସ୍ୟ ଦୋଷିତ୍ୱାତ୍ ସମକ୍ଷଂ ତମ୍ ଅଭର୍ତ୍ସଯଂ|</para>
  <para style="p">
    <verse number="12" style="v"/>ଯତଃ ସ ପୂର୍ୱ୍ୱମ୍ ଅନ୍ୟଜାତୀଯୈଃ ସାର୍ଦ୍ଧମ୍ ଆହାରମକରୋତ୍ ତତଃ ପରଂ ଯାକୂବଃ ସମୀପାତ୍ କତିପଯଜନେଷ୍ୱାଗତେଷୁ ସ ଛିନ୍ନତ୍ୱଙ୍ମନୁଷ୍ୟେଭ୍ୟୋ ଭଯେନ ନିୱୃତ୍ୟ ପୃଥଗ୍ ଅଭୱତ୍|</para>
  <para style="p">
    <verse number="13" style="v"/>ତତୋଽପରେ ସର୍ୱ୍ୱେ ଯିହୂଦିନୋଽପି ତେନ ସାର୍ଦ୍ଧଂ କପଟାଚାରମ୍ ଅକୁର୍ୱ୍ୱନ୍ ବର୍ଣବ୍ବା ଅପି ତେଷାଂ କାପଟ୍ୟେନ ୱିପଥଗାମ୍ୟଭୱତ୍|</para>
  <para style="p">
    <verse number="14" style="v"/>ତତସ୍ତେ ପ୍ରକୃତସୁସଂୱାଦରୂପେ ସରଲପଥେ ନ ଚରନ୍ତୀତି ଦୃଷ୍ଟ୍ୱାହଂ ସର୍ୱ୍ୱେଷାଂ ସାକ୍ଷାତ୍ ପିତରମ୍ ଉକ୍ତୱାନ୍ ତ୍ୱଂ ଯିହୂଦୀ ସନ୍ ଯଦି ଯିହୂଦିମତଂ ୱିହାଯ ଭିନ୍ନଜାତୀଯ ଇୱାଚରସି ତର୍ହି ଯିହୂଦିମତାଚରଣାଯ ଭିନ୍ନଜାତୀଯାନ୍ କୁତଃ ପ୍ରୱର୍ତ୍ତଯସି?</para>
  <para style="p">
    <verse number="15" style="v"/>ଆୱାଂ ଜନ୍ମନା ଯିହୂଦିନୌ ଭୱାୱୋ ଭିନ୍ନଜାତୀଯୌ ପାପିନୌ ନ ଭୱାୱଃ</para>
  <para style="p">
    <verse number="16" style="v"/>କିନ୍ତୁ ୱ୍ୟୱସ୍ଥାପାଲନେନ ମନୁଷ୍ୟଃ ସପୁଣ୍ୟୋ ନ ଭୱତି କେୱଲଂ ଯୀଶୌ ଖ୍ରୀଷ୍ଟେ ଯୋ ୱିଶ୍ୱାସସ୍ତେନୈୱ ସପୁଣ୍ୟୋ ଭୱତୀତି ବୁଦ୍ଧ୍ୱାୱାମପି ୱ୍ୟୱସ୍ଥାପାଲନଂ ୱିନା କେୱଲଂ ଖ୍ରୀଷ୍ଟେ ୱିଶ୍ୱାସେନ ପୁଣ୍ୟପ୍ରାପ୍ତଯେ ଖ୍ରୀଷ୍ଟେ ଯୀଶୌ ୱ୍ୟଶ୍ୱସିୱ ଯତୋ ୱ୍ୟୱସ୍ଥାପାଲନେନ କୋଽପି ମାନୱଃ ପୁଣ୍ୟଂ ପ୍ରାପ୍ତୁଂ ନ ଶକ୍ନୋତି|</para>
  <para style="p">
    <verse number="17" style="v"/>ପରନ୍ତୁ ଯୀଶୁନା ପୁଣ୍ୟପ୍ରାପ୍ତଯେ ଯତମାନାୱପ୍ୟାୱାଂ ଯଦି ପାପିନୌ ଭୱାୱସ୍ତର୍ହି କିଂ ୱକ୍ତୱ୍ୟଂ? ଖ୍ରୀଷ୍ଟଃ ପାପସ୍ୟ ପରିଚାରକ ଇତି? ତନ୍ନ ଭୱତୁ|</para>
  <para style="p">
    <verse number="18" style="v"/>ମଯା ଯଦ୍ ଭଗ୍ନଂ ତଦ୍ ଯଦି ମଯା ପୁନର୍ନିର୍ମ୍ମୀଯତେ ତର୍ହି ମଯୈୱାତ୍ମଦୋଷଃ ପ୍ରକାଶ୍ୟତେ|</para>
  <para style="p">
    <verse number="19" style="v"/>ଅହଂ ଯଦ୍ ଈଶ୍ୱରାଯ ଜୀୱାମି ତଦର୍ଥଂ ୱ୍ୟୱସ୍ଥଯା ୱ୍ୟୱସ୍ଥାଯୈ ଅମ୍ରିଯେ|</para>
  <para style="p">
    <verse number="20" style="v"/>ଖ୍ରୀଷ୍ଟେନ ସାର୍ଦ୍ଧଂ କ୍ରୁଶେ ହତୋଽସ୍ମି ତଥାପି ଜୀୱାମି କିନ୍ତ୍ୱହଂ ଜୀୱାମୀତି ନହି ଖ୍ରୀଷ୍ଟ ଏୱ ମଦନ୍ତ ର୍ଜୀୱତି| ସାମ୍ପ୍ରତଂ ସଶରୀରେଣ ମଯା ଯଜ୍ଜୀୱିତଂ ଧାର୍ୟ୍ୟତେ ତତ୍ ମମ ଦଯାକାରିଣି ମଦର୍ଥଂ ସ୍ୱୀଯପ୍ରାଣତ୍ୟାଗିନି ଚେଶ୍ୱରପୁତ୍ରେ ୱିଶ୍ୱସତା ମଯା ଧାର୍ୟ୍ୟତେ|</para>
  <para style="p">
    <verse number="21" style="v"/>ଅହମୀଶ୍ୱରସ୍ୟାନୁଗ୍ରହଂ ନାୱଜାନାମି ଯସ୍ମାଦ୍ ୱ୍ୟୱସ୍ଥଯା ଯଦି ପୁଣ୍ୟଂ ଭୱତି ତର୍ହି ଖ୍ରୀଷ୍ଟୋ ନିରର୍ଥକମମ୍ରିଯତ|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ହେ ନିର୍ବ୍ବୋଧା ଗାଲାତିଲୋକାଃ, ଯୁଷ୍ମାକଂ ମଧ୍ୟେ କ୍ରୁଶେ ହତ ଇୱ ଯୀଶୁଃ ଖ୍ରୀଷ୍ଟୋ ଯୁଷ୍ମାକଂ ସମକ୍ଷଂ ପ୍ରକାଶିତ ଆସୀତ୍ ଅତୋ ଯୂଯଂ ଯଥା ସତ୍ୟଂ ୱାକ୍ୟଂ ନ ଗୃହ୍ଲୀଥ ତଥା କେନାମୁହ୍ୟତ?</para>
  <para style="p">
    <verse number="2" style="v"/>ଅହଂ ଯୁଷ୍ମତ୍ତଃ କଥାମେକାଂ ଜିଜ୍ଞାସେ ଯୂଯମ୍ ଆତ୍ମାନଂ କେନାଲଭଧ୍ୱଂ? ୱ୍ୟୱସ୍ଥାପାଲନେନ କିଂ ୱା ୱିଶ୍ୱାସୱାକ୍ୟସ୍ୟ ଶ୍ରୱଣେନ?</para>
  <para style="p">
    <verse number="3" style="v"/>ଯୂଯଂ କିମ୍ ଈଦୃଗ୍ ଅବୋଧା ଯଦ୍ ଆତ୍ମନା କର୍ମ୍ମାରଭ୍ୟ ଶରୀରେଣ ତତ୍ ସାଧଯିତୁଂ ଯତଧ୍ୱେ?</para>
  <para style="p">
    <verse number="4" style="v"/>ତର୍ହି ଯୁଷ୍ମାକଂ ଗୁରୁତରୋ ଦୁଃଖଭୋଗଃ କିଂ ନିଷ୍ଫଲୋ ଭୱିଷ୍ୟତି? କୁଫଲଯୁକ୍ତୋ ୱା କିଂ ଭୱିଷ୍ୟତି?</para>
  <para style="p">
    <verse number="5" style="v"/>ଯୋ ଯୁଷ୍ମଭ୍ୟମ୍ ଆତ୍ମାନଂ ଦତ୍ତୱାନ୍ ଯୁଷ୍ମନ୍ମଧ୍ୟ ଆଶ୍ଚର୍ୟ୍ୟାଣି କର୍ମ୍ମାଣି ଚ ସାଧିତୱାନ୍ ସ କିଂ ୱ୍ୟୱସ୍ଥାପାଲନେନ ୱିଶ୍ୱାସୱାକ୍ୟସ୍ୟ ଶ୍ରୱଣେନ ୱା ତତ୍ କୃତୱାନ୍?</para>
  <para style="p">
    <verse number="6" style="v"/>ଲିଖିତମାସ୍ତେ, ଇବ୍ରାହୀମ ଈଶ୍ୱରେ ୱ୍ୟଶ୍ୱସୀତ୍ ସ ଚ ୱିଶ୍ୱାସସ୍ତସ୍ମୈ ପୁଣ୍ୟାର୍ଥଂ ଗଣିତୋ ବଭୂୱ,</para>
  <para style="p">
    <verse number="7" style="v"/>ଅତୋ ଯେ ୱିଶ୍ୱାସାଶ୍ରିତାସ୍ତ ଏୱେବ୍ରାହୀମଃ ସନ୍ତାନା ଇତି ଯୁଷ୍ମାଭି ର୍ଜ୍ଞାଯତାଂ|</para>
  <para style="p">
    <verse number="8" style="v"/>ଈଶ୍ୱରୋ ଭିନ୍ନଜାତୀଯାନ୍ ୱିଶ୍ୱାସେନ ସପୁଣ୍ୟୀକରିଷ୍ୟତୀତି ପୂର୍ୱ୍ୱଂ ଜ୍ଞାତ୍ୱା ଶାସ୍ତ୍ରଦାତା ପୂର୍ୱ୍ୱମ୍ ଇବ୍ରାହୀମଂ ସୁସଂୱାଦଂ ଶ୍ରାୱଯନ ଜଗାଦ, ତ୍ୱତ୍ତୋ ଭିନ୍ନଜାତୀଯାଃ ସର୍ୱ୍ୱ ଆଶିଷଂ ପ୍ରାପ୍ସ୍ୟନ୍ତୀତି|</para>
  <para style="p">
    <verse number="9" style="v"/>ଅତୋ ଯେ ୱିଶ୍ୱାସାଶ୍ରିତାସ୍ତେ ୱିଶ୍ୱାସିନେବ୍ରାହୀମା ସାର୍ଦ୍ଧମ୍ ଆଶିଷଂ ଲଭନ୍ତେ|</para>
  <para style="p">
    <verse number="10" style="v"/>ଯାୱନ୍ତୋ ଲୋକା ୱ୍ୟୱସ୍ଥାଯାଃ କର୍ମ୍ମଣ୍ୟାଶ୍ରଯନ୍ତି ତେ ସର୍ୱ୍ୱେ ଶାପାଧୀନା ଭୱନ୍ତି ଯତୋ ଲିଖିତମାସ୍ତେ, ଯଥା, "ଯଃ କଶ୍ଚିଦ୍ ଏତସ୍ୟ ୱ୍ୟୱସ୍ଥାଗ୍ରନ୍ଥସ୍ୟ ସର୍ୱ୍ୱୱାକ୍ୟାନି ନିଶ୍ଚିଦ୍ରଂ ନ ପାଲଯତି ସ ଶପ୍ତ ଇତି| "</para>
  <para style="p">
    <verse number="11" style="v"/>ଈଶ୍ୱରସ୍ୟ ସାକ୍ଷାତ୍ କୋଽପି ୱ୍ୟୱସ୍ଥଯା ସପୁଣ୍ୟୋ ନ ଭୱତି ତଦ ୱ୍ୟକ୍ତଂ ଯତଃ "ପୁଣ୍ୟୱାନ୍ ମାନୱୋ ୱିଶ୍ୱାସେନ ଜୀୱିଷ୍ୟତୀତି" ଶାସ୍ତ୍ରୀଯଂ ୱଚଃ|</para>
  <para style="p">
    <verse number="12" style="v"/>ୱ୍ୟୱସ୍ଥା ତୁ ୱିଶ୍ୱାସସମ୍ବନ୍ଧିନୀ ନ ଭୱତି କିନ୍ତ୍ୱେତାନି ଯଃ ପାଲଯିଷ୍ୟତି ସ ଏୱ ତୈ ର୍ଜୀୱିଷ୍ୟତୀତିନିଯମସମ୍ବନ୍ଧିନୀ|</para>
  <para style="p">
    <verse number="13" style="v"/>ଖ୍ରୀଷ୍ଟୋଽସ୍ମାନ୍ ପରିକ୍ରୀଯ ୱ୍ୟୱସ୍ଥାଯାଃ ଶାପାତ୍ ମୋଚିତୱାନ୍ ଯତୋଽସ୍ମାକଂ ୱିନିମଯେନ ସ ସ୍ୱଯଂ ଶାପାସ୍ପଦମଭୱତ୍ ତଦଧି ଲିଖିତମାସ୍ତେ, ଯଥା, "ଯଃ କଶ୍ଚିତ୍ ତରାୱୁଲ୍ଲମ୍ବ୍ୟତେ ସୋଽଭିଶପ୍ତ ଇତି| "</para>
  <para style="p">
    <verse number="14" style="v"/>ତସ୍ମାଦ୍ ଖ୍ରୀଷ୍ଟେନ ଯୀଶୁନେୱ୍ରାହୀମ ଆଶୀ ର୍ଭିନ୍ନଜାତୀଯଲୋକେଷୁ ୱର୍ତ୍ତତେ ତେନ ୱଯଂ ପ୍ରତିଜ୍ଞାତମ୍ ଆତ୍ମାନଂ ୱିଶ୍ୱାସେନ ଲବ୍ଧୁଂ ଶକ୍ନୁମଃ|</para>
  <para style="p">
    <verse number="15" style="v"/>ହେ ଭ୍ରାତୃଗଣ ମାନୁଷାଣାଂ ରୀତ୍ୟନୁସାରେଣାହଂ କଥଯାମି କେନଚିତ୍ ମାନୱେନ ଯୋ ନିଯମୋ ନିରଚାଯି ତସ୍ୟ ୱିକୃତି ର୍ୱୃଦ୍ଧି ର୍ୱା କେନାପି ନ କ୍ରିଯତେ|</para>
  <para style="p">
    <verse number="16" style="v"/>ପରନ୍ତ୍ୱିବ୍ରାହୀମେ ତସ୍ୟ ସନ୍ତାନାଯ ଚ ପ୍ରତିଜ୍ଞାଃ ପ୍ରତି ଶୁଶ୍ରୁୱିରେ ତତ୍ର ସନ୍ତାନଶବ୍ଦଂ ବହୁୱଚନାନ୍ତମ୍ ଅଭୂତ୍ୱା ତୱ ସନ୍ତାନାଯେତ୍ୟେକୱଚନାନ୍ତଂ ବଭୂୱ ସ ଚ ସନ୍ତାନଃ ଖ୍ରୀଷ୍ଟ ଏୱ|</para>
  <para style="p">
    <verse number="17" style="v"/>ଅତଏୱାହଂ ୱଦାମି, ଈଶ୍ୱରେଣ ଯୋ ନିଯମଃ ପୁରା ଖ୍ରୀଷ୍ଟମଧି ନିରଚାଯି ତତଃ ପରଂ ତ୍ରିଂଶଦଧିକଚତୁଃଶତୱତ୍ସରେଷୁ ଗତେଷୁ ସ୍ଥାପିତା ୱ୍ୟୱସ୍ଥା ତଂ ନିଯମଂ ନିରର୍ଥକୀକୃତ୍ୟ ତଦୀଯପ୍ରତିଜ୍ଞା ଲୋପ୍ତୁଂ ନ ଶକ୍ନୋତି|</para>
  <para style="p">
    <verse number="18" style="v"/>ଯସ୍ମାତ୍ ସମ୍ପଦଧିକାରୋ ଯଦି ୱ୍ୟୱସ୍ଥଯା ଭୱତି ତର୍ହି ପ୍ରତିଜ୍ଞଯା ନ ଭୱତି କିନ୍ତ୍ୱୀଶ୍ୱରଃ ପ୍ରତିଜ୍ଞଯା ତଦଧିକାରିତ୍ୱମ୍ ଇବ୍ରାହୀମେ ଽଦଦାତ୍|</para>
  <para style="p">
    <verse number="19" style="v"/>ତର୍ହି ୱ୍ୟୱସ୍ଥା କିମ୍ଭୂତା? ପ୍ରତିଜ୍ଞା ଯସ୍ମୈ ପ୍ରତିଶ୍ରୁତା ତସ୍ୟ ସନ୍ତାନସ୍ୟାଗମନଂ ଯାୱଦ୍ ୱ୍ୟଭିଚାରନିୱାରଣାର୍ଥଂ ୱ୍ୟୱସ୍ଥାପି ଦତ୍ତା, ସା ଚ ଦୂତୈରାଜ୍ଞାପିତା ମଧ୍ୟସ୍ଥସ୍ୟ କରେ ସମର୍ପିତା ଚ|</para>
  <para style="p">
    <verse number="20" style="v"/>ନୈକସ୍ୟ ମଧ୍ୟସ୍ଥୋ ୱିଦ୍ୟତେ କିନ୍ତ୍ୱୀଶ୍ୱର ଏକ ଏୱ|</para>
  <para style="p">
    <verse number="21" style="v"/>ତର୍ହି ୱ୍ୟୱସ୍ଥା କିମ୍ ଈଶ୍ୱରସ୍ୟ ପ୍ରତିଜ୍ଞାନାଂ ୱିରୁଦ୍ଧା? ତନ୍ନ ଭୱତୁ| ଯସ୍ମାଦ୍ ଯଦି ସା ୱ୍ୟୱସ୍ଥା ଜୀୱନଦାନେସମର୍ଥାଭୱିଷ୍ୟତ୍ ତର୍ହି ୱ୍ୟୱସ୍ଥଯୈୱ ପୁଣ୍ୟଲାଭୋଽଭୱିଷ୍ୟତ୍|</para>
  <para style="p">
    <verse number="22" style="v"/>କିନ୍ତୁ ଯୀଶୁଖ୍ରୀଷ୍ଟେ ଯୋ ୱିଶ୍ୱାସସ୍ତତ୍ସମ୍ବନ୍ଧିଯାଃ ପ୍ରତିଜ୍ଞାଯାଃ ଫଲଂ ଯଦ୍ ୱିଶ୍ୱାସିଲୋକେଭ୍ୟୋ ଦୀଯତେ ତଦର୍ଥଂ ଶାସ୍ତ୍ରଦାତା ସର୍ୱ୍ୱାନ୍ ପାପାଧୀନାନ୍ ଗଣଯତି|</para>
  <para style="p">
    <verse number="23" style="v"/>ଅତଏୱ ୱିଶ୍ୱାସସ୍ୟାନାଗତସମଯେ ୱଯଂ ୱ୍ୟୱସ୍ଥାଧୀନାଃ ସନ୍ତୋ ୱିଶ୍ୱାସସ୍ୟୋଦଯଂ ଯାୱଦ୍ ରୁଦ୍ଧା ଇୱାରକ୍ଷ୍ୟାମହେ|</para>
  <para style="p">
    <verse number="24" style="v"/>ଇତ୍ଥଂ ୱଯଂ ଯଦ୍ ୱିଶ୍ୱାସେନ ସପୁଣ୍ୟୀଭୱାମସ୍ତଦର୍ଥଂ ଖ୍ରୀଷ୍ଟସ୍ୟ ସମୀପମ୍ ଅସ୍ମାନ୍ ନେତୁଂ ୱ୍ୟୱସ୍ଥାଗ୍ରଥୋଽସ୍ମାକଂ ୱିନେତା ବଭୂୱ|</para>
  <para style="p">
    <verse number="25" style="v"/>କିନ୍ତ୍ୱଧୁନାଗତେ ୱିଶ୍ୱାସେ ୱଯଂ ତସ୍ୟ ୱିନେତୁରନଧୀନା ଅଭୱାମ|</para>
  <para style="p">
    <verse number="26" style="v"/>ଖ୍ରୀଷ୍ଟେ ଯୀଶୌ ୱିଶ୍ୱସନାତ୍ ସର୍ୱ୍ୱେ ଯୂଯମ୍ ଈଶ୍ୱରସ୍ୟ ସନ୍ତାନା ଜାତାଃ|</para>
  <para style="p">
    <verse number="27" style="v"/>ଯୂଯଂ ଯାୱନ୍ତୋ ଲୋକାଃ ଖ୍ରୀଷ୍ଟେ ମଜ୍ଜିତା ଅଭୱତ ସର୍ୱ୍ୱେ ଖ୍ରୀଷ୍ଟଂ ପରିହିତୱନ୍ତଃ|</para>
  <para style="p">
    <verse number="28" style="v"/>ଅତୋ ଯୁଷ୍ମନ୍ମଧ୍ୟେ ଯିହୂଦିଯୂନାନିନୋ ର୍ଦାସସ୍ୱତନ୍ତ୍ରଯୋ ର୍ୟୋଷାପୁରୁଷଯୋଶ୍ଚ କୋଽପି ୱିଶେଷୋ ନାସ୍ତି; ସର୍ୱ୍ୱେ ଯୂଯଂ ଖ୍ରୀଷ୍ଟେ ଯୀଶାୱେକ ଏୱ|</para>
  <para style="p">
    <verse number="29" style="v"/>କିଞ୍ଚ ଯୂଯଂ ଯଦି ଖ୍ରୀଷ୍ଟସ୍ୟ ଭୱଥ ତର୍ହି ସୁତରାମ୍ ଇବ୍ରାହୀମଃ ସନ୍ତାନାଃ ପ୍ରତିଜ୍ଞଯା ସମ୍ପଦଧିକାରିଣଶ୍ଚାଧ୍ୱେ|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ଅହଂ ୱଦାମି ସମ୍ପଦଧିକାରୀ ଯାୱଦ୍ ବାଲସ୍ତିଷ୍ଠତି ତାୱତ୍ ସର୍ୱ୍ୱସ୍ୱସ୍ୟାଧିପତିଃ ସନ୍ନପି ସ ଦାସାତ୍ କେନାପି ୱିଷଯେଣ ନ ୱିଶିଷ୍ୟତେ</para>
  <para style="p">
    <verse number="2" style="v"/>କିନ୍ତୁ ପିତ୍ରା ନିରୂପିତଂ ସମଯଂ ଯାୱତ୍ ପାଲକାନାଂ ଧନାଧ୍ୟକ୍ଷାଣାଞ୍ଚ ନିଘ୍ନସ୍ତିଷ୍ଠତି|</para>
  <para style="p">
    <verse number="3" style="v"/>ତଦ୍ୱଦ୍ ୱଯମପି ବାଲ୍ୟକାଲେ ଦାସା ଇୱ ସଂସାରସ୍ୟାକ୍ଷରମାଲାଯା ଅଧୀନା ଆସ୍ମହେ|</para>
  <para style="p">
    <verse number="4" style="v"/>ଅନନ୍ତରଂ ସମଯେ ସମ୍ପୂର୍ଣତାଂ ଗତୱତି ୱ୍ୟୱସ୍ଥାଧୀନାନାଂ ମୋଚନାର୍ଥମ୍</para>
  <para style="p">
    <verse number="5" style="v"/>ଅସ୍ମାକଂ ପୁତ୍ରତ୍ୱପ୍ରାପ୍ତ୍ୟର୍ଥଞ୍ଚେଶ୍ୱରଃ ସ୍ତ୍ରିଯା ଜାତଂ ୱ୍ୟୱସ୍ଥାଯା ଅଧିନୀଭୂତଞ୍ଚ ସ୍ୱପୁତ୍ରଂ ପ୍ରେଷିତୱାନ୍|</para>
  <para style="p">
    <verse number="6" style="v"/>ଯୂଯଂ ସନ୍ତାନା ଅଭୱତ ତତ୍କାରଣାଦ୍ ଈଶ୍ୱରଃ ସ୍ୱପୁତ୍ରସ୍ୟାତ୍ମାନାଂ ଯୁଷ୍ମାକମ୍ ଅନ୍ତଃକରଣାନି ପ୍ରହିତୱାନ୍ ସ ଚାତ୍ମା ପିତଃ ପିତରିତ୍ୟାହ୍ୱାନଂ କାରଯତି|</para>
  <para style="p">
    <verse number="7" style="v"/>ଅତ ଇଦାନୀଂ ଯୂଯଂ ନ ଦାସାଃ କିନ୍ତୁଃ ସନ୍ତାନା ଏୱ ତସ୍ମାତ୍ ସନ୍ତାନତ୍ୱାଚ୍ଚ ଖ୍ରୀଷ୍ଟେନେଶ୍ୱରୀଯସମ୍ପଦଧିକାରିଣୋଽପ୍ୟାଧ୍ୱେ|</para>
  <para style="p">
    <verse number="8" style="v"/>ଅପରଞ୍ଚ ପୂର୍ୱ୍ୱଂ ଯୂଯମ୍ ଈଶ୍ୱରଂ ନ ଜ୍ଞାତ୍ୱା ଯେ ସ୍ୱଭାୱତୋଽନୀଶ୍ୱରାସ୍ତେଷାଂ ଦାସତ୍ୱେଽତିଷ୍ଠତ|</para>
  <para style="p">
    <verse number="9" style="v"/>ଇଦାନୀମ୍ ଈଶ୍ୱରଂ ଜ୍ଞାତ୍ୱା ଯଦି ୱେଶ୍ୱରେଣ ଜ୍ଞାତା ଯୂଯଂ କଥଂ ପୁନସ୍ତାନି ୱିଫଲାନି ତୁଚ୍ଛାନି ଚାକ୍ଷରାଣି ପ୍ରତି ପରାୱର୍ତ୍ତିତୁଂ ଶକ୍ନୁଥ? ଯୂଯଂ କିଂ ପୁନସ୍ତେଷାଂ ଦାସା ଭୱିତୁମିଚ୍ଛଥ?</para>
  <para style="p">
    <verse number="10" style="v"/>ଯୂଯଂ ଦିୱସାନ୍ ମାସାନ୍ ତିଥୀନ୍ ସଂୱତ୍ସରାଂଶ୍ଚ ସମ୍ମନ୍ୟଧ୍ୱେ|</para>
  <para style="p">
    <verse number="11" style="v"/>ଯୁଷ୍ମଦର୍ଥଂ ମଯା ଯଃ ପରିଶ୍ରମୋଽକାରି ସ ୱିଫଲୋ ଜାତ ଇତି ଯୁଷ୍ମାନଧ୍ୟହଂ ବିଭେମି|</para>
  <para style="p">
    <verse number="12" style="v"/>ହେ ଭ୍ରାତରଃ, ଅହଂ ଯାଦୃଶୋଽସ୍ମି ଯୂଯମପି ତାଦୃଶା ଭୱତେତି ପ୍ରାର୍ଥଯେ ଯତୋଽହମପି ଯୁଷ୍ମତ୍ତୁଲ୍ୟୋଽଭୱଂ ଯୁଷ୍ମାଭି ର୍ମମ କିମପି ନାପରାଦ୍ଧଂ|</para>
  <para style="p">
    <verse number="13" style="v"/>ପୂର୍ୱ୍ୱମହଂ କଲେୱରସ୍ୟ ଦୌର୍ବ୍ବଲ୍ୟେନ ଯୁଷ୍ମାନ୍ ସୁସଂୱାଦମ୍ ଅଜ୍ଞାପଯମିତି ଯୂଯଂ ଜାନୀଥ|</para>
  <para style="p">
    <verse number="14" style="v"/>ତଦାନୀଂ ମମ ପରୀକ୍ଷକଂ ଶାରୀରକ୍ଲେଶଂ ଦୃଷ୍ଟ୍ୱା ଯୂଯଂ ମାମ୍ ଅୱଜ୍ଞାଯ ଋତୀଯିତୱନ୍ତସ୍ତନ୍ନହି କିନ୍ତ୍ୱୀଶ୍ୱରସ୍ୟ ଦୂତମିୱ ସାକ୍ଷାତ୍ ଖ୍ରୀଷ୍ଟ ଯୀଶୁମିୱ ୱା ମାଂ ଗୃହୀତୱନ୍ତଃ|</para>
  <para style="p">
    <verse number="15" style="v"/>ଅତସ୍ତଦାନୀଂ ଯୁଷ୍ମାକଂ ଯା ଧନ୍ୟତାଭୱତ୍ ସା କ୍କ ଗତା? ତଦାନୀଂ ଯୂଯଂ ଯଦି ସ୍ୱେଷାଂ ନଯନାନ୍ୟୁତ୍ପାଟ୍ୟ ମହ୍ୟଂ ଦାତୁମ୍ ଅଶକ୍ଷ୍ୟତ ତର୍ହି ତଦପ୍ୟକରିଷ୍ୟତେତି ପ୍ରମାଣମ୍ ଅହଂ ଦଦାମି|</para>
  <para style="p">
    <verse number="16" style="v"/>ସାମ୍ପ୍ରତମହଂ ସତ୍ୟୱାଦିତ୍ୱାତ୍ କିଂ ଯୁଷ୍ମାକଂ ରିପୁ ର୍ଜାତୋଽସ୍ମି?</para>
  <para style="p">
    <verse number="17" style="v"/>ତେ ଯୁଷ୍ମତ୍କୃତେ ସ୍ପର୍ଦ୍ଧନ୍ତେ କିନ୍ତୁ ସା ସ୍ପର୍ଦ୍ଧା କୁତ୍ସିତା ଯତୋ ଯୂଯଂ ତାନଧି ଯତ୍ ସ୍ପର୍ଦ୍ଧଧ୍ୱଂ ତଦର୍ଥଂ ତେ ଯୁଷ୍ମାନ୍ ପୃଥକ୍ କର୍ତ୍ତୁମ୍ ଇଚ୍ଛନ୍ତି|</para>
  <para style="p">
    <verse number="18" style="v"/>କେୱଲଂ ଯୁଷ୍ମତ୍ସମୀପେ ମମୋପସ୍ଥିତିସମଯେ ତନ୍ନହି, କିନ୍ତୁ ସର୍ୱ୍ୱଦୈୱ ଭଦ୍ରମଧି ସ୍ପର୍ଦ୍ଧନଂ ଭଦ୍ରଂ|</para>
  <para style="p">
    <verse number="19" style="v"/>ହେ ମମ ବାଲକାଃ, ଯୁଷ୍ମଦନ୍ତ ର୍ୟାୱତ୍ ଖ୍ରୀଷ୍ଟୋ ମୂର୍ତିମାନ୍ ନ ଭୱତି ତାୱଦ୍ ଯୁଷ୍ମତ୍କାରଣାତ୍ ପୁନଃ ପ୍ରସୱୱେଦନେୱ ମମ ୱେଦନା ଜାଯତେ|</para>
  <para style="p">
    <verse number="20" style="v"/>ଅହମିଦାନୀଂ ଯୁଷ୍ମାକଂ ସନ୍ନିଧିଂ ଗତ୍ୱା ସ୍ୱରାନ୍ତରେଣ ଯୁଷ୍ମାନ୍ ସମ୍ଭାଷିତୁଂ କାମଯେ ଯତୋ ଯୁଷ୍ମାନଧି ୱ୍ୟାକୁଲୋଽସ୍ମି|</para>
  <para style="p">
    <verse number="21" style="v"/>ହେ ୱ୍ୟୱସ୍ଥାଧୀନତାକାଙ୍କ୍ଷିଣଃ ଯୂଯଂ କିଂ ୱ୍ୟୱସ୍ଥାଯା ୱଚନଂ ନ ଗୃହ୍ଲୀଥ?</para>
  <para style="p">
    <verse number="22" style="v"/>ତନ୍ମାଂ ୱଦତ| ଲିଖିତମାସ୍ତେ, ଇବ୍ରାହୀମୋ ଦ୍ୱୌ ପୁତ୍ରାୱାସାତେ ତଯୋରେକୋ ଦାସ୍ୟାଂ ଦ୍ୱିତୀଯଶ୍ଚ ପତ୍ନ୍ୟାଂ ଜାତଃ|</para>
  <para style="p">
    <verse number="23" style="v"/>ତଯୋ ର୍ୟୋ ଦାସ୍ୟାଂ ଜାତଃ ସ ଶାରୀରିକନିଯମେନ ଜଜ୍ଞେ ଯଶ୍ଚ ପତ୍ନ୍ୟାଂ ଜାତଃ ସ ପ୍ରତିଜ୍ଞଯା ଜଜ୍ଞେ|</para>
  <para style="p">
    <verse number="24" style="v"/>ଇଦମାଖ୍ୟାନଂ ଦୃଷ୍ଟନ୍ତସ୍ୱରୂପଂ| ତେ ଦ୍ୱେ ଯୋଷିତାୱୀଶ୍ୱରୀଯସନ୍ଧୀ ତଯୋରେକା ସୀନଯପର୍ୱ୍ୱତାଦ୍ ଉତ୍ପନ୍ନା ଦାସଜନଯିତ୍ରୀ ଚ ସା ତୁ ହାଜିରା|</para>
  <para style="p">
    <verse number="25" style="v"/>ଯସ୍ମାଦ୍ ହାଜିରାଶବ୍ଦେନାରୱଦେଶସ୍ଥସୀନଯପର୍ୱ୍ୱତୋ ବୋଧ୍ୟତେ, ସା ଚ ୱର୍ତ୍ତମାନାଯା ଯିରୂଶାଲମ୍ପୁର୍ୟ୍ୟାଃ ସଦୃଶୀ| ଯତଃ ସ୍ୱବାଲୈଃ ସହିତା ସା ଦାସତ୍ୱ ଆସ୍ତେ|</para>
  <para style="p">
    <verse number="26" style="v"/>କିନ୍ତୁ ସ୍ୱର୍ଗୀଯା ଯିରୂଶାଲମ୍ପୁରୀ ପତ୍ନୀ ସର୍ୱ୍ୱେଷାମ୍ ଅସ୍ମାକଂ ମାତା ଚାସ୍ତେ|</para>
  <para style="p">
    <verse number="27" style="v"/>ଯାଦୃଶଂ ଲିଖିତମ୍ ଆସ୍ତେ, "ୱନ୍ଧ୍ୟେ ସନ୍ତାନହୀନେ ତ୍ୱଂ ସ୍ୱରଂ ଜଯଜଯଂ କୁରୁ| ଅପ୍ରସୂତେ ତ୍ୱଯୋଲ୍ଲାସୋ ଜଯାଶବ୍ଦଶ୍ଚ ଗୀଯତାଂ| ଯତ ଏୱ ସନାଥାଯା ଯୋଷିତଃ ସନ୍ତତେ ର୍ଗଣାତ୍| ଅନାଥା ଯା ଭୱେନ୍ନାରୀ ତଦପତ୍ୟାନି ଭୂରିଶଃ|| "</para>
  <para style="p">
    <verse number="28" style="v"/>ହେ ଭ୍ରାତୃଗଣ, ଇମ୍ହାକ୍ ଇୱ ୱଯଂ ପ୍ରତିଜ୍ଞଯା ଜାତାଃ ସନ୍ତାନାଃ|</para>
  <para style="p">
    <verse number="29" style="v"/>କିନ୍ତୁ ତଦାନୀଂ ଶାରୀରିକନିଯମେନ ଜାତଃ ପୁତ୍ରୋ ଯଦ୍ୱଦ୍ ଆତ୍ମିକନିଯମେନ ଜାତଂ ପୁତ୍ରମ୍ ଉପାଦ୍ରୱତ୍ ତଥାଧୁନାପି|</para>
  <para style="p">
    <verse number="30" style="v"/>କିନ୍ତୁ ଶାସ୍ତ୍ରେ କିଂ ଲିଖିତଂ? "ତ୍ୱମ୍ ଇମାଂ ଦାସୀଂ ତସ୍ୟାଃ ପୁତ୍ରଞ୍ଚାପସାରଯ ଯତ ଏଷ ଦାସୀପୁତ୍ରଃ ପତ୍ନୀପୁତ୍ରେଣ ସମଂ ନୋତ୍ତରାଧିକାରୀ ଭୱିଯ୍ୟତୀତି| "</para>
  <para style="p">
    <verse number="31" style="v"/>ଅତଏୱ ହେ ଭ୍ରାତରଃ, ୱଯଂ ଦାସ୍ୟାଃ ସନ୍ତାନା ନ ଭୂତ୍ୱା ପାତ୍ନ୍ୟାଃ ସନ୍ତାନା ଭୱାମଃ|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ଖ୍ରୀଷ୍ଟୋଽସ୍ମଭ୍ୟଂ ଯତ୍ ସ୍ୱାତନ୍ତ୍ର୍ୟଂ ଦତ୍ତୱାନ୍ ଯୂଯଂ ତତ୍ର ସ୍ଥିରାସ୍ତିଷ୍ଠତ ଦାସତ୍ୱଯୁଗେନ ପୁନ ର୍ନ ନିବଧ୍ୟଧ୍ୱଂ|</para>
  <para style="p">
    <verse number="2" style="v"/>ପଶ୍ୟତାହଂ ପୌଲୋ ଯୁଷ୍ମାନ୍ ୱଦାମି ଯଦି ଛିନ୍ନତ୍ୱଚୋ ଭୱଥ ତର୍ହି ଖ୍ରୀଷ୍ଟେନ କିମପି ନୋପକାରିଷ୍ୟଧ୍ୱେ|</para>
  <para style="p">
    <verse number="3" style="v"/>ଅପରଂ ଯଃ କଶ୍ଚିତ୍ ଛିନ୍ନତ୍ୱଗ୍ ଭୱତି ସ କୃତ୍ସ୍ନୱ୍ୟୱସ୍ଥାଯାଃ ପାଲନମ୍ ଈଶ୍ୱରାଯ ଧାରଯତୀତି ପ୍ରମାଣଂ ଦଦାମି|</para>
  <para style="p">
    <verse number="4" style="v"/>ଯୁଷ୍ମାକଂ ଯାୱନ୍ତୋ ଲୋକା ୱ୍ୟୱସ୍ଥଯା ସପୁଣ୍ୟୀଭୱିତୁଂ ଚେଷ୍ଟନ୍ତେ ତେ ସର୍ୱ୍ୱେ ଖ୍ରୀଷ୍ଟାଦ୍ ଭ୍ରଷ୍ଟା ଅନୁଗ୍ରହାତ୍ ପତିତାଶ୍ଚ|</para>
  <para style="p">
    <verse number="5" style="v"/>ଯତୋ ୱଯମ୍ ଆତ୍ମନା ୱିଶ୍ୱାସାତ୍ ପୁଣ୍ୟଲାଭାଶାସିଦ୍ଧଂ ପ୍ରତୀକ୍ଷାମହେ|</para>
  <para style="p">
    <verse number="6" style="v"/>ଖ୍ରୀଷ୍ଟେ ଯୀଶୌ ତ୍ୱକ୍ଛେଦାତ୍ୱକ୍ଛେଦଯୋଃ କିମପି ଗୁଣଂ ନାସ୍ତି କିନ୍ତୁ ପ୍ରେମ୍ନା ସଫଲୋ ୱିଶ୍ୱାସ ଏୱ ଗୁଣଯୁକ୍ତଃ|</para>
  <para style="p">
    <verse number="7" style="v"/>ପୂର୍ୱ୍ୱଂ ଯୂଯଂ ସୁନ୍ଦରମ୍ ଅଧାୱତ କିନ୍ତ୍ୱିଦାନୀଂ କେନ ବାଧାଂ ପ୍ରାପ୍ୟ ସତ୍ୟତାଂ ନ ଗୃହ୍ଲୀଥ?</para>
  <para style="p">
    <verse number="8" style="v"/>ଯୁଷ୍ମାକଂ ସା ମତି ର୍ୟୁଷ୍ମଦାହ୍ୱାନକାରିଣ ଈଶ୍ୱରାନ୍ନ ଜାତା|</para>
  <para style="p">
    <verse number="9" style="v"/>ୱିକାରଃ କୃତ୍ସ୍ନଶକ୍ତୂନାଂ ସ୍ୱଲ୍ପକିଣ୍ୱେନ ଜସଯତେ|</para>
  <para style="p">
    <verse number="10" style="v"/>ଯୁଷ୍ମାକଂ ମତି ର୍ୱିକାରଂ ନ ଗମିଷ୍ୟତୀତ୍ୟହଂ ଯୁଷ୍ମାନଧି ପ୍ରଭୁନାଶଂସେ; କିନ୍ତୁ ଯୋ ଯୁଷ୍ମାନ୍ ୱିଚାରଲଯତି ସ ଯଃ କଶ୍ଚିଦ୍ ଭୱେତ୍ ସମୁଚିତଂ ଦଣ୍ଡଂ ପ୍ରାପ୍ସ୍ୟତି|</para>
  <para style="p">
    <verse number="11" style="v"/>ପରନ୍ତୁ ହେ ଭ୍ରାତରଃ, ଯଦ୍ୟହମ୍ ଇଦାନୀମ୍ ଅପି ତ୍ୱକ୍ଛେଦଂ ପ୍ରଚାରଯେଯଂ ତର୍ହି କୁତ ଉପଦ୍ରୱଂ ଭୁଞ୍ଜିଯ? ତତ୍କୃତେ କ୍ରୁଶଂ ନିର୍ବ୍ବାଧମ୍ ଅଭୱିଷ୍ୟତ୍|</para>
  <para style="p">
    <verse number="12" style="v"/>ଯେ ଜନା ଯୁଷ୍ମାକଂ ଚାଞ୍ଚଲ୍ୟଂ ଜନଯନ୍ତି ତେଷାଂ ଛେଦନମେୱ ମଯାଭିଲଷ୍ୟତେ|</para>
  <para style="p">
    <verse number="13" style="v"/>ହେ ଭ୍ରାତରଃ, ଯୂଯଂ ସ୍ୱାତନ୍ତ୍ର୍ୟାର୍ଥମ୍ ଆହୂତା ଆଧ୍ୱେ କିନ୍ତୁ ତତ୍ସ୍ୱାତନ୍ତ୍ର୍ୟଦ୍ୱାରେଣ ଶାରୀରିକଭାୱୋ ଯୁଷ୍ମାନ୍ ନ ପ୍ରୱିଶତୁ| ଯୂଯଂ ପ୍ରେମ୍ନା ପରସ୍ପରଂ ପରିଚର୍ୟ୍ୟାଂ କୁରୁଧ୍ୱଂ|</para>
  <para style="p">
    <verse number="14" style="v"/>ଯସ୍ମାତ୍ ତ୍ୱଂ ସମୀପୱାସିନି ସ୍ୱୱତ୍ ପ୍ରେମ କୁର୍ୟ୍ୟା ଇତ୍ୟେକାଜ୍ଞା କୃତ୍ସ୍ନାଯା ୱ୍ୟୱସ୍ଥାଯାଃ ସାରସଂଗ୍ରହଃ|</para>
  <para style="p">
    <verse number="15" style="v"/>କିନ୍ତୁ ଯୂଯଂ ଯଦି ପରସ୍ପରଂ ଦଂଦଶ୍ୟଧ୍ୱେ ଽଶାଶ୍ୟଧ୍ୱେ ଚ ତର୍ହି ଯୁଷ୍ମାକମ୍ ଏକୋଽନ୍ୟେନ ଯନ୍ନ ଗ୍ରସ୍ୟତେ ତତ୍ର ଯୁଷ୍ମାଭିଃ ସାୱଧାନୈ ର୍ଭୱିତୱ୍ୟଂ|</para>
  <para style="p">
    <verse number="16" style="v"/>ଅହଂ ବ୍ରୱୀମି ଯୂଯମ୍ ଆତ୍ମିକାଚାରଂ କୁରୁତ ଶାରୀରିକାଭିଲାଷଂ ମା ପୂରଯତ|</para>
  <para style="p">
    <verse number="17" style="v"/>ଯତଃ ଶାରୀରିକାଭିଲାଷ ଆତ୍ମନୋ ୱିପରୀତଃ, ଆତ୍ମିକାଭିଲାଷଶ୍ଚ ଶରୀରସ୍ୟ ୱିପରୀତଃ, ଅନଯୋରୁଭଯୋଃ ପରସ୍ପରଂ ୱିରୋଧୋ ୱିଦ୍ୟତେ ତେନ ଯୁଷ୍ମାଭି ର୍ୟଦ୍ ଅଭିଲଷ୍ୟତେ ତନ୍ନ କର୍ତ୍ତୱ୍ୟଂ|</para>
  <para style="p">
    <verse number="18" style="v"/>ଯୂଯଂ ଯଦ୍ୟାତ୍ମନା ୱିନୀଯଧ୍ୱେ ତର୍ହି ୱ୍ୟୱସ୍ଥାଯା ଅଧୀନା ନ ଭୱଥ|</para>
  <para style="p">
    <verse number="19" style="v"/>ଅପରଂ ପରଦାରଗମନଂ ୱେଶ୍ୟାଗମନମ୍ ଅଶୁଚିତା କାମୁକତା ପ୍ରତିମାପୂଜନମ୍</para>
  <para style="p">
    <verse number="20" style="v"/>ଇନ୍ଦ୍ରଜାଲଂ ଶତ୍ରୁତ୍ୱଂ ୱିୱାଦୋଽନ୍ତର୍ଜ୍ୱଲନଂ କ୍ରୋଧଃ କଲହୋଽନୈକ୍ୟଂ</para>
  <para style="p">
    <verse number="21" style="v"/>ପାର୍ଥକ୍ୟମ୍ ଈର୍ଷ୍ୟା ୱଧୋ ମତ୍ତତ୍ୱଂ ଲମ୍ପଟତ୍ୱମିତ୍ୟାଦୀନି ସ୍ପଷ୍ଟତ୍ୱେନ ଶାରୀରିକଭାୱସ୍ୟ କର୍ମ୍ମାଣି ସନ୍ତି| ପୂର୍ୱ୍ୱଂ ଯଦ୍ୱତ୍ ମଯା କଥିତଂ ତଦ୍ୱତ୍ ପୁନରପି କଥ୍ୟତେ ଯେ ଜନା ଏତାଦୃଶାନି କର୍ମ୍ମାଣ୍ୟାଚରନ୍ତି ତୈରୀଶ୍ୱରସ୍ୟ ରାଜ୍ୟେଽଧିକାରଃ କଦାଚ ନ ଲପ୍ସ୍ୟତେ|</para>
  <para style="p">
    <verse number="22" style="v"/>କିଞ୍ଚ ପ୍ରେମାନନ୍ଦଃ ଶାନ୍ତିଶ୍ଚିରସହିଷ୍ଣୁତା ହିତୈଷିତା ଭଦ୍ରତ୍ୱଂ ୱିଶ୍ୱାସ୍ୟତା ତିତିକ୍ଷା</para>
  <para style="p">
    <verse number="23" style="v"/>ପରିମିତଭୋଜିତ୍ୱମିତ୍ୟାଦୀନ୍ୟାତ୍ମନଃ ଫଲାନି ସନ୍ତି ତେଷାଂ ୱିରୁଦ୍ଧା କାପି ୱ୍ୟୱସ୍ଥା ନହି|</para>
  <para style="p">
    <verse number="24" style="v"/>ଯେ ତୁ ଖ୍ରୀଷ୍ଟସ୍ୟ ଲୋକାସ୍ତେ ରିପୁଭିରଭିଲାଷୈଶ୍ଚ ସହିତଂ ଶାରୀରିକଭାୱଂ କ୍ରୁଶେ ନିହତୱନ୍ତଃ|</para>
  <para style="p">
    <verse number="25" style="v"/>ଯଦି ୱଯମ୍ ଆତ୍ମନା ଜୀୱାମସ୍ତର୍ହ୍ୟାତ୍ମିକାଚାରୋଽସ୍ମାଭିଃ କର୍ତ୍ତୱ୍ୟଃ,</para>
  <para style="p">
    <verse number="26" style="v"/>ଦର୍ପଃ ପରସ୍ପରଂ ନିର୍ଭର୍ତ୍ସନଂ ଦ୍ୱେଷଶ୍ଚାସ୍ମାଭି ର୍ନ କର୍ତ୍ତୱ୍ୟାନି|</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ହେ ଭ୍ରାତରଃ, ଯୁଷ୍ମାକଂ କଶ୍ଚିଦ୍ ଯଦି କସ୍ମିଂଶ୍ଚିତ୍ ପାପେ ପତତି ତର୍ହ୍ୟାତ୍ମିକଭାୱଯୁକ୍ତୈ ର୍ୟୁଷ୍ମାଭିସ୍ତିତିକ୍ଷାଭାୱଂ ୱିଧାଯ ସ ପୁନରୁତ୍ଥାପ୍ୟତାଂ ଯୂଯମପି ଯଥା ତାଦୃକ୍ପରୀକ୍ଷାଯାଂ ନ ପତଥ ତଥା ସାୱଧାନା ଭୱତ|</para>
  <para style="p">
    <verse number="2" style="v"/>ଯୁଷ୍ମାକମ୍ ଏକୈକୋ ଜନଃ ପରସ୍ୟ ଭାରଂ ୱହତ୍ୱନେନ ପ୍ରକାରେଣ ଖ୍ରୀଷ୍ଟସ୍ୟ ୱିଧିଂ ପାଲଯତ|</para>
  <para style="p">
    <verse number="3" style="v"/>ଯଦି କଶ୍ଚନ କ୍ଷୁଦ୍ରଃ ସନ୍ ସ୍ୱଂ ମହାନ୍ତଂ ମନ୍ୟତେ ତର୍ହି ତସ୍ୟାତ୍ମୱଞ୍ଚନା ଜାଯତେ|</para>
  <para style="p">
    <verse number="4" style="v"/>ଅତ ଏକୈକେନ ଜନେନ ସ୍ୱକୀଯକର୍ମ୍ମଣଃ ପରୀକ୍ଷା କ୍ରିଯତାଂ ତେନ ପରଂ ନାଲୋକ୍ୟ କେୱଲମ୍ ଆତ୍ମାଲୋକନାତ୍ ତସ୍ୟ ଶ୍ଲଘା ସମ୍ଭୱିଷ୍ୟତି|</para>
  <para style="p">
    <verse number="5" style="v"/>ଯତ ଏକୈକୋे ଜନଃ ସ୍ୱକୀଯଂ ଭାରଂ ୱକ୍ଷ୍ୟତି|</para>
  <para style="p">
    <verse number="6" style="v"/>ଯୋ ଜନୋ ଧର୍ମ୍ମୋପଦେଶଂ ଲଭତେ ସ ଉପଦେଷ୍ଟାରଂ ସ୍ୱୀଯସର୍ୱ୍ୱସମ୍ପତ୍ତେ ର୍ଭାଗିନଂ କରୋତୁ|</para>
  <para style="p">
    <verse number="7" style="v"/>ଯୁଷ୍ମାକଂ ଭ୍ରାନ୍ତି ର୍ନ ଭୱତୁ, ଈଶ୍ୱରୋ ନୋପହସିତୱ୍ୟଃ, ଯେନ ଯଦ୍ ବୀଜମ୍ ଉପ୍ୟତେ ତେନ ତଜ୍ଜାତଂ ଶସ୍ୟଂ କର୍ତ୍ତିଷ୍ୟତେ|</para>
  <para style="p">
    <verse number="8" style="v"/>ସ୍ୱଶରୀରାର୍ଥଂ ଯେନ ବୀଜମ୍ ଉପ୍ୟତେ ତେନ ଶରୀରାଦ୍ ୱିନାଶରୂପଂ ଶସ୍ୟଂ ଲପ୍ସ୍ୟତେ କିନ୍ତ୍ୱାତ୍ମନଃ କୃତେ ଯେନ ବୀଜମ୍ ଉପ୍ୟତେ ତେନାତ୍ମତୋଽନନ୍ତଜୀୱିତରୂପଂ ଶସ୍ୟଂ ଲପ୍ସ୍ୟତେ|</para>
  <para style="p">
    <verse number="9" style="v"/>ସତ୍କର୍ମ୍ମକରଣେଽସ୍ମାଭିରଶ୍ରାନ୍ତୈ ର୍ଭୱିତୱ୍ୟଂ ଯତୋଽକ୍ଲାନ୍ତୌସ୍ତିଷ୍ଠଦ୍ଭିରସ୍ମାଭିରୁପଯୁକ୍ତସମଯେ ତତ୍ ଫଲାନି ଲପ୍ସ୍ୟନ୍ତେ|</para>
  <para style="p">
    <verse number="10" style="v"/>ଅତୋ ଯାୱତ୍ ସମଯସ୍ତିଷ୍ଠତି ତାୱତ୍ ସର୍ୱ୍ୱାନ୍ ପ୍ରତି ୱିଶେଷତୋ ୱିଶ୍ୱାସୱେଶ୍ମୱାସିନଃ ପ୍ରତ୍ୟସ୍ମାଭି ର୍ହିତାଚାରଃ କର୍ତ୍ତୱ୍ୟଃ|</para>
  <para style="p">
    <verse number="11" style="v"/>ହେ ଭ୍ରାତରଃ, ଅହଂ ସ୍ୱହସ୍ତେନ ଯୁଷ୍ମାନ୍ ପ୍ରତି କିଯଦ୍ୱୃହତ୍ ପତ୍ରଂ ଲିଖିତୱାନ୍ ତଦ୍ ଯୁଷ୍ମାଭି ର୍ଦୃଶ୍ୟତାଂ|</para>
  <para style="p">
    <verse number="12" style="v"/>ଯେ ଶାରୀରିକୱିଷଯେ ସୁଦୃଶ୍ୟା ଭୱିତୁମିଚ୍ଛନ୍ତି ତେ ଯତ୍ ଖ୍ରୀଷ୍ଟସ୍ୟ କ୍ରୁଶସ୍ୟ କାରଣାଦୁପଦ୍ରୱସ୍ୟ ଭାଗିନୋ ନ ଭୱନ୍ତି କେୱଲଂ ତଦର୍ଥଂ ତ୍ୱକ୍ଛେଦେ ଯୁଷ୍ମାନ୍ ପ୍ରୱର୍ତ୍ତଯନ୍ତି|</para>
  <para style="p">
    <verse number="13" style="v"/>ତେ ତ୍ୱକ୍ଛେଦଗ୍ରାହିଣୋଽପି ୱ୍ୟୱସ୍ଥାଂ ନ ପାଲଯନ୍ତି କିନ୍ତୁ ଯୁଷ୍ମଚ୍ଛରୀରାତ୍ ଶ୍ଲାଘାଲାଭାର୍ଥଂ ଯୁଷ୍ମାକଂ ତ୍ୱକ୍ଛେଦମ୍ ଇଚ୍ଛନ୍ତି|</para>
  <para style="p">
    <verse number="14" style="v"/>କିନ୍ତୁ ଯେନାହଂ ସଂସାରାଯ ହତଃ ସଂସାରୋଽପି ମହ୍ୟଂ ହତସ୍ତଦସ୍ମତ୍ପ୍ରଭୋ ର୍ୟୀଶୁଖ୍ରୀଷ୍ଟସ୍ୟ କ୍ରୁଶଂ ୱିନାନ୍ୟତ୍ର କୁତ୍ରାପି ମମ ଶ୍ଲାଘନଂ କଦାପି ନ ଭୱତୁ|</para>
  <para style="p">
    <verse number="15" style="v"/>ଖ୍ରୀଷ୍ଟେ ଯୀଶୌ ତ୍ୱକ୍ଛେଦାତ୍ୱକ୍ଛେଦଯୋଃ କିମପି ଗୁଣଂ ନାସ୍ତି କିନ୍ତୁ ନୱୀନା ସୃଷ୍ଟିରେୱ ଗୁଣଯୁକ୍ତା|</para>
  <para style="p">
    <verse number="16" style="v"/>ଅପରଂ ଯାୱନ୍ତୋ ଲୋକା ଏତସ୍ମିନ୍ ମାର୍ଗେ ଚରନ୍ତି ତେଷାମ୍ ଈଶ୍ୱରୀଯସ୍ୟ କୃତ୍ସ୍ନସ୍ୟେସ୍ରାଯେଲଶ୍ଚ ଶାନ୍ତି ର୍ଦଯାଲାଭଶ୍ଚ ଭୂଯାତ୍|</para>
  <para style="p">
    <verse number="17" style="v"/>ଇତଃ ପରଂ କୋଽପି ମାଂ ନ କ୍ଲିଶ୍ନାତୁ ଯସ୍ମାଦ୍ ଅହଂ ସ୍ୱଗାତ୍ରେ ପ୍ରଭୋ ର୍ୟୀଶୁଖ୍ରୀଷ୍ଟସ୍ୟ ଚିହ୍ନାନି ଧାରଯେ|</para>
  <para style="p">
    <verse number="18" style="v"/>ହେ ଭ୍ରାତରଃ ଅସ୍ମାକଂ ପ୍ରଭୋ ର୍ୟୀଶୁଖ୍ରୀଷ୍ଟସ୍ୟ ପ୍ରସାଦୋ ଯୁଷ୍ମାକମ୍ ଆତ୍ମନି ସ୍ଥେଯାତ୍| ତଥାସ୍ତୁ|</para>
</usx>
