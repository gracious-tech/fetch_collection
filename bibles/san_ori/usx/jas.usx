<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="JAS" style="id">Sanskrit Bible (NT) in Oriya Script (ସତ୍ୟୱେଦଃ।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">James</para>
  <para style="toc1">ଯାକୂବଃ ପତ୍ରଂ</para>
  <para style="toc2">ଯାକୂବଃ</para>
  <para style="toc3">ଯାକୂବଃ</para>
  <para style="mt1">ଯାକୂବଃ ପତ୍ରଂ</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ଈଶ୍ୱରସ୍ୟ ପ୍ରଭୋ ର୍ୟୀଶୁଖ୍ରୀଷ୍ଟସ୍ୟ ଚ ଦାସୋ ଯାକୂବ୍ ୱିକୀର୍ଣୀଭୂତାନ୍ ଦ୍ୱାଦଶଂ ୱଂଶାନ୍ ପ୍ରତି ନମସ୍କୃତ୍ୟ ପତ୍ରଂ ଲିଖତି|</para>
  <para style="p">
    <verse number="2" style="v"/>ହେ ମମ ଭ୍ରାତରଃ, ଯୂଯଂ ଯଦା ବହୁୱିଧପରୀକ୍ଷାଷୁ ନିପତତ ତଦା ତତ୍ ପୂର୍ଣାନନ୍ଦସ୍ୟ କାରଣଂ ମନ୍ୟଧ୍ୱଂ|</para>
  <para style="p">
    <verse number="3" style="v"/>ଯତୋ ଯୁଷ୍ମାକଂ ୱିଶ୍ୱାସସ୍ୟ ପରୀକ୍ଷିତତ୍ୱେନ ଧୈର୍ୟ୍ୟଂ ସମ୍ପାଦ୍ୟତ ଇତି ଜାନୀଥ|</para>
  <para style="p">
    <verse number="4" style="v"/>ତଚ୍ଚ ଧୈର୍ୟ୍ୟଂ ସିଦ୍ଧଫଲଂ ଭୱତୁ ତେନ ଯୂଯଂ ସିଦ୍ଧାଃ ସମ୍ପୂର୍ଣାଶ୍ଚ ଭୱିଷ୍ୟଥ କସ୍ୟାପି ଗୁଣସ୍ୟାଭାୱଶ୍ଚ ଯୁଷ୍ମାକଂ ନ ଭୱିଷ୍ୟତି|</para>
  <para style="p">
    <verse number="5" style="v"/>ଯୁଷ୍ମାକଂ କସ୍ୟାପି ଜ୍ଞାନାଭାୱୋ ଯଦି ଭୱେତ୍ ତର୍ହି ଯ ଈଶ୍ୱରଃ ସରଲଭାୱେନ ତିରସ୍କାରଞ୍ଚ ୱିନା ସର୍ୱ୍ୱେଭ୍ୟୋ ଦଦାତି ତତଃ ସ ଯାଚତାଂ ତତସ୍ତସ୍ମୈ ଦାଯିଷ୍ୟତେ|</para>
  <para style="p">
    <verse number="6" style="v"/>କିନ୍ତୁ ସ ନିଃସନ୍ଦେହଃ ସନ୍ ୱିଶ୍ୱାସେନ ଯାଚତାଂ ଯତଃ ସନ୍ଦିଗ୍ଧୋ ମାନୱୋ ୱାଯୁନା ଚାଲିତସ୍ୟୋତ୍ପ୍ଲୱମାନସ୍ୟ ଚ ସମୁଦ୍ରତରଙ୍ଗସ୍ୟ ସଦୃଶୋ ଭୱତି|</para>
  <para style="p">
    <verse number="7" style="v"/>ତାଦୃଶୋ ମାନୱଃ ପ୍ରଭୋଃ କିଞ୍ଚିତ୍ ପ୍ରାପ୍ସ୍ୟତୀତି ନ ମନ୍ୟତାଂ|</para>
  <para style="p">
    <verse number="8" style="v"/>ଦ୍ୱିମନା ଲୋକଃ ସର୍ୱ୍ୱଗତିଷୁ ଚଞ୍ଚଲୋ ଭୱତି|</para>
  <para style="p">
    <verse number="9" style="v"/>ଯୋ ଭ୍ରାତା ନମ୍ରଃ ସ ନିଜୋନ୍ନତ୍ୟା ଶ୍ଲାଘତାଂ|</para>
  <para style="p">
    <verse number="10" style="v"/>ଯଶ୍ଚ ଧନୱାନ୍ ସ ନିଜନମ୍ରତଯା ଶ୍ଲାଘତାଂଯତଃ ସ ତୃଣପୁଷ୍ପୱତ୍ କ୍ଷଯଂ ଗମିଷ୍ୟତି|</para>
  <para style="p">
    <verse number="11" style="v"/>ଯତଃ ସତାପେନ ସୂର୍ୟ୍ୟେଣୋଦିତ୍ୟ ତୃଣଂ ଶୋଷ୍ୟତେ ତତ୍ପୁଷ୍ପଞ୍ଚ ଭ୍ରଶ୍ୟତି ତେନ ତସ୍ୟ ରୂପସ୍ୟ ସୌନ୍ଦର୍ୟ୍ୟଂ ନଶ୍ୟତି ତଦ୍ୱଦ୍ ଧନିଲୋକୋଽପି ସ୍ୱୀଯମୂଢତଯା ମ୍ଲାସ୍ୟତି|</para>
  <para style="p">
    <verse number="12" style="v"/>ଯୋ ଜନଃ ପରୀକ୍ଷାଂ ସହତେ ସ ଏୱ ଧନ୍ୟଃ, ଯତଃ ପରୀକ୍ଷିତତ୍ୱଂ ପ୍ରାପ୍ୟ ସ ପ୍ରଭୁନା ସ୍ୱପ୍ରେମକାରିଭ୍ୟଃ ପ୍ରତିଜ୍ଞାତଂ ଜୀୱନମୁକୁଟଂ ଲପ୍ସ୍ୟତେ|</para>
  <para style="p">
    <verse number="13" style="v"/>ଈଶ୍ୱରୋ ମାଂ ପରୀକ୍ଷତ ଇତି ପରୀକ୍ଷାସମଯେ କୋଽପି ନ ୱଦତୁ ଯତଃ ପାପାଯେଶ୍ୱରସ୍ୟ ପରୀକ୍ଷା ନ ଭୱତି ସ ଚ କମପି ନ ପରୀକ୍ଷତେ|</para>
  <para style="p">
    <verse number="14" style="v"/>କିନ୍ତୁ ଯଃ କଶ୍ଚିତ୍ ସ୍ୱୀଯମନୋୱାଞ୍ଛଯାକୃଷ୍ୟତେ ଲୋଭ୍ୟତେ ଚ ତସ୍ୟୈୱ ପରୀକ୍ଷା ଭୱତି|</para>
  <para style="p">
    <verse number="15" style="v"/>ତସ୍ମାତ୍ ସା ମନୋୱାଞ୍ଛା ସଗର୍ଭା ଭୂତ୍ୱା ଦୁଷ୍କୃତିଂ ପ୍ରସୂତେ ଦୁଷ୍କୃତିଶ୍ଚ ପରିଣାମଂ ଗତ୍ୱା ମୃତ୍ୟୁଂ ଜନଯତି|</para>
  <para style="p">
    <verse number="16" style="v"/>ହେ ମମ ପ୍ରିଯଭ୍ରାତରଃ, ଯୂଯଂ ନ ଭ୍ରାମ୍ୟତ|</para>
  <para style="p">
    <verse number="17" style="v"/>ଯତ୍ କିଞ୍ଚିଦ୍ ଉତ୍ତମଂ ଦାନଂ ପୂର୍ଣୋ ୱରଶ୍ଚ ତତ୍ ସର୍ୱ୍ୱମ୍ ଊର୍ଦ୍ଧ୍ୱାଦ୍ ଅର୍ଥତୋ ଯସ୍ମିନ୍ ଦଶାନ୍ତରଂ ପରିୱର୍ତ୍ତନଜାତଚ୍ଛାଯା ୱା ନାସ୍ତି ତସ୍ମାଦ୍ ଦୀପ୍ତ୍ୟାକରାତ୍ ପିତୁରୱରୋହତି|</para>
  <para style="p">
    <verse number="18" style="v"/>ତସ୍ୟ ସୃଷ୍ଟୱସ୍ତୂନାଂ ମଧ୍ୟେ ୱଯଂ ଯତ୍ ପ୍ରଥମଫଲସ୍ୱରୂପା ଭୱାମସ୍ତଦର୍ଥଂ ସ ସ୍ୱେଚ୍ଛାତଃ ସତ୍ୟମତସ୍ୟ ୱାକ୍ୟେନାସ୍ମାନ୍ ଜନଯାମାସ|</para>
  <para style="p">
    <verse number="19" style="v"/>ଅତଏୱ ହେ ମମ ପ୍ରିଯଭ୍ରାତରଃ, ଯୁଷ୍ମାକମ୍ ଏକୈକୋ ଜନଃ ଶ୍ରୱଣେ ତ୍ୱରିତଃ କଥନେ ଧୀରଃ କ୍ରୋଧେଽପି ଧୀରୋ ଭୱତୁ|</para>
  <para style="p">
    <verse number="20" style="v"/>ଯତୋ ମାନୱସ୍ୟ କ୍ରୋଧ ଈଶ୍ୱରୀଯଧର୍ମ୍ମଂ ନ ସାଧଯତି|</para>
  <para style="p">
    <verse number="21" style="v"/>ଅତୋ ହେତୋ ର୍ୟୂଯଂ ସର୍ୱ୍ୱାମ୍ ଅଶୁଚିକ୍ରିଯାଂ ଦୁଷ୍ଟତାବାହୁଲ୍ୟଞ୍ଚ ନିକ୍ଷିପ୍ୟ ଯୁଷ୍ମନ୍ମନସାଂ ପରିତ୍ରାଣେ ସମର୍ଥଂ ରୋପିତଂ ୱାକ୍ୟଂ ନମ୍ରଭାୱେନ ଗୃହ୍ଲୀତ|</para>
  <para style="p">
    <verse number="22" style="v"/>ଅପରଞ୍ଚ ଯୂଯଂ କେୱଲମ୍ ଆତ୍ମୱଞ୍ଚଯିତାରୋ ୱାକ୍ୟସ୍ୟ ଶ୍ରୋତାରୋ ନ ଭୱତ କିନ୍ତୁ ୱାକ୍ୟସ୍ୟ କର୍ମ୍ମକାରିଣୋ ଭୱତ|</para>
  <para style="p">
    <verse number="23" style="v"/>ଯତୋ ଯଃ କଶ୍ଚିଦ୍ ୱାକ୍ୟସ୍ୟ କର୍ମ୍ମକାରୀ ନ ଭୂତ୍ୱା କେୱଲଂ ତସ୍ୟ ଶ୍ରୋତା ଭୱତି ସ ଦର୍ପଣେ ସ୍ୱୀଯଶାରୀରିକୱଦନଂ ନିରୀକ୍ଷମାଣସ୍ୟ ମନୁଜସ୍ୟ ସଦୃଶଃ|</para>
  <para style="p">
    <verse number="24" style="v"/>ଆତ୍ମାକାରେ ଦୃଷ୍ଟେ ସ ପ୍ରସ୍ଥାଯ କୀଦୃଶ ଆସୀତ୍ ତତ୍ ତତ୍କ୍ଷଣାଦ୍ ୱିସ୍ମରତି|</para>
  <para style="p">
    <verse number="25" style="v"/>କିନ୍ତୁ ଯଃ କଶ୍ଚିତ୍ ନତ୍ୱା ମୁକ୍ତେଃ ସିଦ୍ଧାଂ ୱ୍ୟୱସ୍ଥାମ୍ ଆଲୋକ୍ୟ ତିଷ୍ଠତି ସ ୱିସ୍ମୃତିଯୁକ୍ତଃ ଶ୍ରୋତା ନ ଭୂତ୍ୱା କର୍ମ୍ମକର୍ତ୍ତୈୱ ସନ୍ ସ୍ୱକାର୍ୟ୍ୟେ ଧନ୍ୟୋ ଭୱିଷ୍ୟତି|</para>
  <para style="p">
    <verse number="26" style="v"/>ଅନାଯତ୍ତରସନଃ ସନ୍ ଯଃ କଶ୍ଚିତ୍ ସ୍ୱମନୋ ୱଞ୍ଚଯିତ୍ୱା ସ୍ୱଂ ଭକ୍ତଂ ମନ୍ୟତେ ତସ୍ୟ ଭକ୍ତି ର୍ମୁଧା ଭୱତି|</para>
  <para style="p">
    <verse number="27" style="v"/>କ୍ଲେଶକାଲେ ପିତୃହୀନାନାଂ ୱିଧୱାନାଞ୍ଚ ଯଦ୍ ଅୱେକ୍ଷଣଂ ସଂସାରାଚ୍ଚ ନିଷ୍କଲଙ୍କେନ ଯଦ୍ ଆତ୍ମରକ୍ଷଣଂ ତଦେୱ ପିତୁରୀଶ୍ୱରସ୍ୟ ସାକ୍ଷାତ୍ ଶୁଚି ର୍ନିର୍ମ୍ମଲା ଚ ଭକ୍ତିଃ|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ହେ ମମ ଭ୍ରାତରଃ, ଯୂଯମ୍ ଅସ୍ମାକଂ ତେଜସ୍ୱିନଃ ପ୍ରଭୋ ର୍ୟୀଶୁଖ୍ରୀଷ୍ଟସ୍ୟ ଧର୍ମ୍ମଂ ମୁଖାପେକ୍ଷଯା ନ ଧାରଯତ|</para>
  <para style="p">
    <verse number="2" style="v"/>ଯତୋ ଯୁଷ୍ମାକଂ ସଭାଯାଂ ସ୍ୱର୍ଣାଙ୍ଗୁରୀଯକଯୁକ୍ତେ ଭ୍ରାଜିଷ୍ଣୁପରିଚ୍ଛଦେ ପୁରୁଷେ ପ୍ରୱିଷ୍ଟେ ମଲିନୱସ୍ତ୍ରେ କସ୍ମିଂଶ୍ଚିଦ୍ ଦରିଦ୍ରେଽପି ପ୍ରୱିଷ୍ଟେ</para>
  <para style="p">
    <verse number="3" style="v"/>ଯୂଯଂ ଯଦି ତଂ ଭ୍ରାଜିଷ୍ଣୁପରିଚ୍ଛଦୱସାନଂ ଜନଂ ନିରୀକ୍ଷ୍ୟ ୱଦେତ ଭୱାନ୍ ଅତ୍ରୋତ୍ତମସ୍ଥାନ ଉପୱିଶତ୍ୱିତି କିଞ୍ଚ ତଂ ଦରିଦ୍ରଂ ଯଦି ୱଦେତ ତ୍ୱମ୍ ଅମୁସ୍ମିନ୍ ସ୍ଥାନେ ତିଷ୍ଠ ଯଦ୍ୱାତ୍ର ମମ ପାଦପୀଠ ଉପୱିଶେତି,</para>
  <para style="p">
    <verse number="4" style="v"/>ତର୍ହି ମନଃସୁ ୱିଶେଷ୍ୟ ଯୂଯଂ କିଂ କୁତର୍କୈଃ କୁୱିଚାରକା ନ ଭୱଥ?</para>
  <para style="p">
    <verse number="5" style="v"/>ହେ ମମ ପ୍ରିଯଭ୍ରାତରଃ, ଶୃଣୁତ, ସଂସାରେ ଯେ ଦରିଦ୍ରାସ୍ତାନ୍ ଈଶ୍ୱରୋ ୱିଶ୍ୱାସେନ ଧନିନଃ ସ୍ୱପ୍ରେମକାରିଭ୍ୟଶ୍ଚ ପ୍ରତିଶ୍ରୁତସ୍ୟ ରାଜ୍ୟସ୍ୟାଧିକାରିଣଃ କର୍ତ୍ତୁଂ କିଂ ନ ୱରୀତୱାନ୍? କିନ୍ତୁ ଦରିଦ୍ରୋ ଯୁଷ୍ମାଭିରୱଜ୍ଞାଯତେ|</para>
  <para style="p">
    <verse number="6" style="v"/>ଧନୱନ୍ତ ଏୱ କିଂ ଯୁଷ୍ମାନ୍ ନୋପଦ୍ରୱନ୍ତି ବଲାଚ୍ଚ ୱିଚାରାସନାନାଂ ସମୀପଂ ନ ନଯନ୍ତି?</para>
  <para style="p">
    <verse number="7" style="v"/>ଯୁଷ୍ମଦୁପରି ପରିକୀର୍ତ୍ତିତଂ ପରମଂ ନାମ କିଂ ତୈରେୱ ନ ନିନ୍ଦ୍ୟତେ?</para>
  <para style="p">
    <verse number="8" style="v"/>କିଞ୍ଚ ତ୍ୱଂ ସ୍ୱସମୀପୱାସିନି ସ୍ୱାତ୍ମୱତ୍ ପ୍ରୀଯସ୍ୱ, ଏତଚ୍ଛାସ୍ତ୍ରୀଯୱଚନାନୁସାରତୋ ଯଦି ଯୂଯଂ ରାଜକୀଯୱ୍ୟୱସ୍ଥାଂ ପାଲଯଥ ତର୍ହି ଭଦ୍ରଂ କୁରୁଥ|</para>
  <para style="p">
    <verse number="9" style="v"/>ଯଦି ଚ ମୁଖାପେକ୍ଷାଂ କୁରୁଥ ତର୍ହି ପାପମ୍ ଆଚରଥ ୱ୍ୟୱସ୍ଥଯା ଚାଜ୍ଞାଲଙ୍ଘିନ ଇୱ ଦୂଷ୍ୟଧ୍ୱେ|</para>
  <para style="p">
    <verse number="10" style="v"/>ଯତୋ ଯଃ କଶ୍ଚିତ୍ କୃତ୍ସ୍ନାଂ ୱ୍ୟୱସ୍ଥାଂ ପାଲଯତି ସ ଯଦ୍ୟେକସ୍ମିନ୍ ୱିଧୌ ସ୍ଖଲତି ତର୍ହି ସର୍ୱ୍ୱେଷାମ୍ ଅପରାଧୀ ଭୱତି|</para>
  <para style="p">
    <verse number="11" style="v"/>ଯତୋ ହେତୋସ୍ତ୍ୱଂ ପରଦାରାନ୍ ମା ଗଚ୍ଛେତି ଯଃ କଥିତୱାନ୍ ସ ଏୱ ନରହତ୍ୟାଂ ମା କୁର୍ୟ୍ୟା ଇତ୍ୟପି କଥିତୱାନ୍ ତସ୍ମାତ୍ ତ୍ୱଂ ପରଦାରାନ୍ ନ ଗତ୍ୱା ଯଦି ନରହତ୍ୟାଂ କରୋଷି ତର୍ହି ୱ୍ୟୱସ୍ଥାଲଙ୍ଘୀ ଭୱସି|</para>
  <para style="p">
    <verse number="12" style="v"/>ମୁକ୍ତେ ର୍ୱ୍ୟୱସ୍ଥାତୋ ଯେଷାଂ ୱିଚାରେଣ ଭୱିତୱ୍ୟଂ ତାଦୃଶା ଲୋକା ଇୱ ଯୂଯଂ କଥାଂ କଥଯତ କର୍ମ୍ମ କୁରୁତ ଚ|</para>
  <para style="p">
    <verse number="13" style="v"/>ଯୋ ଦଯାଂ ନାଚରତି ତସ୍ୟ ୱିଚାରୋ ନିର୍ଦ୍ଦଯେନ କାରିଷ୍ୟତେ, କିନ୍ତୁ ଦଯା ୱିଚାରମ୍ ଅଭିଭୱିଷ୍ୟତି|</para>
  <para style="p">
    <verse number="14" style="v"/>ହେ ମମ ଭ୍ରାତରଃ, ମମ ପ୍ରତ୍ୟଯୋଽସ୍ତୀତି ଯଃ କଥଯତି ତସ୍ୟ କର୍ମ୍ମାଣି ଯଦି ନ ୱିଦ୍ୟନ୍ତ ତର୍ହି ତେନ କିଂ ଫଲଂ? ତେନ ପ୍ରତ୍ୟଯେନ କିଂ ତସ୍ୟ ପରିତ୍ରାଣଂ ଭୱିତୁଂ ଶକ୍ନୋତି?</para>
  <para style="p">
    <verse number="15" style="v"/>କେଷୁଚିଦ୍ ଭ୍ରାତୃଷୁ ଭଗିନୀଷୁ ୱା ୱସନହୀନେଷୁ ପ୍ରାତ୍ୟହିକାହାରହୀନେଷୁ ଚ ସତ୍ସୁ ଯୁଷ୍ମାକଂ କୋଽପି ତେଭ୍ୟଃ ଶରୀରାର୍ଥଂ ପ୍ରଯୋଜନୀଯାନି ଦ୍ରୱ୍ୟାଣି ନ ଦତ୍ୱା ଯଦି ତାନ୍ ୱଦେତ୍,</para>
  <para style="p">
    <verse number="16" style="v"/>ଯୂଯଂ ସକୁଶଲଂ ଗତ୍ୱୋଷ୍ଣଗାତ୍ରା ଭୱତ ତୃପ୍ୟତ ଚେତି ତର୍ହ୍ୟେତେନ କିଂ ଫଲଂ?</para>
  <para style="p">
    <verse number="17" style="v"/>ତଦ୍ୱତ୍ ପ୍ରତ୍ୟଯୋ ଯଦି କର୍ମ୍ମଭି ର୍ୟୁକ୍ତୋ ନ ଭୱେତ୍ ତର୍ହ୍ୟେକାକିତ୍ୱାତ୍ ମୃତ ଏୱାସ୍ତେ|</para>
  <para style="p">
    <verse number="18" style="v"/>କିଞ୍ଚ କଶ୍ଚିଦ୍ ଇଦଂ ୱଦିଷ୍ୟତି ତୱ ପ୍ରତ୍ୟଯୋ ୱିଦ୍ୟତେ ମମ ଚ କର୍ମ୍ମାଣି ୱିଦ୍ୟନ୍ତେ, ତ୍ୱଂ କର୍ମ୍ମହୀନଂ ସ୍ୱପ୍ରତ୍ୟଯଂ ମାଂ ଦର୍ଶଯ ତର୍ହ୍ୟହମପି ମତ୍କର୍ମ୍ମଭ୍ୟଃ ସ୍ୱପ୍ରତ୍ୟଯଂ ତ୍ୱାଂ ଦର୍ଶଯିଷ୍ୟାମି|</para>
  <para style="p">
    <verse number="19" style="v"/>ଏକ ଈଶ୍ୱରୋ ଽସ୍ତୀତି ତ୍ୱଂ ପ୍ରତ୍ୟେଷି| ଭଦ୍ରଂ କରୋଷି| ଭୂତା ଅପି ତତ୍ ପ୍ରତିଯନ୍ତି କମ୍ପନ୍ତେ ଚ|</para>
  <para style="p">
    <verse number="20" style="v"/>କିନ୍ତୁ ହେ ନିର୍ବ୍ବୋଧମାନୱ, କର୍ମ୍ମହୀନଃ ପ୍ରତ୍ୟଯୋ ମୃତ ଏୱାସ୍ତ୍ୟେତଦ୍ ଅୱଗନ୍ତୁଂ କିମ୍ ଇଚ୍ଛସି?</para>
  <para style="p">
    <verse number="21" style="v"/>ଅସ୍ମାକଂ ପୂର୍ୱ୍ୱପୁରୁଷୋ ଯ ଇବ୍ରାହୀମ୍ ସ୍ୱପୁତ୍ରମ୍ ଇସ୍ହାକଂ ଯଜ୍ଞୱେଦ୍ୟାମ୍ ଉତ୍ସୃଷ୍ଟୱାନ୍ ସ କିଂ କର୍ମ୍ମଭ୍ୟୋ ନ ସପୁଣ୍ୟୀକୃତଃ?</para>
  <para style="p">
    <verse number="22" style="v"/>ପ୍ରତ୍ୟଯେ ତସ୍ୟ କର୍ମ୍ମଣାଂ ସହକାରିଣି ଜାତେ କର୍ମ୍ମଭିଃ ପ୍ରତ୍ୟଯଃ ସିଦ୍ଧୋ ଽଭୱତ୍ ତତ୍ କିଂ ପଶ୍ୟସି?</para>
  <para style="p">
    <verse number="23" style="v"/>ଇତ୍ଥଞ୍ଚେଦଂ ଶାସ୍ତ୍ରୀଯୱଚନଂ ସଫଲମ୍ ଅଭୱତ୍, ଇବ୍ରାହୀମ୍ ପରମେଶ୍ୱରେ ୱିଶ୍ୱସିତୱାନ୍ ତଚ୍ଚ ତସ୍ୟ ପୁଣ୍ୟାଯାଗଣ୍ୟତ ସ ଚେଶ୍ୱରସ୍ୟ ମିତ୍ର ଇତି ନାମ ଲବ୍ଧୱାନ୍|</para>
  <para style="p">
    <verse number="24" style="v"/>ପଶ୍ୟତ ମାନୱଃ କର୍ମ୍ମଭ୍ୟଃ ସପୁଣ୍ୟୀକ୍ରିଯତେ ନ ଚୈକାକିନା ପ୍ରତ୍ୟଯେନ|</para>
  <para style="p">
    <verse number="25" style="v"/>ତଦ୍ୱଦ୍ ଯା ରାହବ୍ନାମିକା ୱାରାଙ୍ଗନା ଚାରାନ୍ ଅନୁଗୃହ୍ୟାପରେଣ ମାର୍ଗେଣ ୱିସସର୍ଜ ସାପି କିଂ କର୍ମ୍ମଭ୍ୟୋ ନ ସପୁଣ୍ୟୀକୃତା?</para>
  <para style="p">
    <verse number="26" style="v"/>ଅତଏୱାତ୍ମହୀନୋ ଦେହୋ ଯଥା ମୃତୋଽସ୍ତି ତଥୈୱ କର୍ମ୍ମହୀନଃ ପ୍ରତ୍ୟଯୋଽପି ମୃତୋଽସ୍ତି|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ହେ ମମ ଭ୍ରାତରଃ, ଶିକ୍ଷକୈରସ୍ମାଭି ର୍ଗୁରୁତରଦଣ୍ଡୋ ଲପ୍ସ୍ୟତ ଇତି ଜ୍ଞାତ୍ୱା ଯୂଯମ୍ ଅନେକେ ଶିକ୍ଷକା ମା ଭୱତ|</para>
  <para style="p">
    <verse number="2" style="v"/>ଯତଃ ସର୍ୱ୍ୱେ ୱଯଂ ବହୁୱିଷଯେଷୁ ସ୍ଖଲାମଃ, ଯଃ କଶ୍ଚିଦ୍ ୱାକ୍ୟେ ନ ସ୍ଖଲତି ସ ସିଦ୍ଧପୁରୁଷଃ କୃତ୍ସ୍ନଂ ୱଶୀକର୍ତ୍ତୁଂ ସମର୍ଥଶ୍ଚାସ୍ତି|</para>
  <para style="p">
    <verse number="3" style="v"/>ପଶ୍ୟତ ୱଯମ୍ ଅଶ୍ୱାନ୍ ୱଶୀକର୍ତ୍ତୁଂ ତେଷାଂ ୱକ୍ତ୍ରେଷୁ ଖଲୀନାନ୍ ନିଧାଯ ତେଷାଂ କୃତ୍ସ୍ନଂ ଶରୀରମ୍ ଅନୁୱର୍ତ୍ତଯାମଃ|</para>
  <para style="p">
    <verse number="4" style="v"/>ପଶ୍ୟତ ଯେ ପୋତା ଅତୀୱ ବୃହଦାକାରାଃ ପ୍ରଚଣ୍ଡୱାତୈଶ୍ଚ ଚାଲିତାସ୍ତେଽପି କର୍ଣଧାରସ୍ୟ ମନୋଽଭିମତାଦ୍ ଅତିକ୍ଷୁଦ୍ରେଣ କର୍ଣେନ ୱାଞ୍ଛିତଂ ସ୍ଥାନଂ ପ୍ରତ୍ୟନୁୱର୍ତ୍ତନ୍ତେ|</para>
  <para style="p">
    <verse number="5" style="v"/>ତଦ୍ୱଦ୍ ରସନାପି କ୍ଷୁଦ୍ରତରାଙ୍ଗଂ ସନ୍ତୀ ଦର୍ପୱାକ୍ୟାନି ଭାଷତେ| ପଶ୍ୟ କୀଦୃଙ୍ମହାରଣ୍ୟଂ ଦହ୍ୟତେ ଽଲ୍ପେନ ୱହ୍ନିନା|</para>
  <para style="p">
    <verse number="6" style="v"/>ରସନାପି ଭୱେଦ୍ ୱହ୍ନିରଧର୍ମ୍ମରୂପପିଷ୍ଟପେ| ଅସ୍ମଦଙ୍ଗେଷୁ ରସନା ତାଦୃଶଂ ସନ୍ତିଷ୍ଠତି ସା କୃତ୍ସ୍ନଂ ଦେହଂ କଲଙ୍କଯତି ସୃଷ୍ଟିରଥସ୍ୟ ଚକ୍ରଂ ପ୍ରଜ୍ୱଲଯତି ନରକାନଲେନ ଜ୍ୱଲତି ଚ|</para>
  <para style="p">
    <verse number="7" style="v"/>ପଶୁପକ୍ଷ୍ୟୁରୋଗଜଲଚରାଣାଂ ସର୍ୱ୍ୱେଷାଂ ସ୍ୱଭାୱୋ ଦମଯିତୁଂ ଶକ୍ୟତେ ମାନୁଷିକସ୍ୱଭାୱେନ ଦମଯାଞ୍ଚକ୍ରେ ଚ|</para>
  <para style="p">
    <verse number="8" style="v"/>କିନ୍ତୁ ମାନୱାନାଂ କେନାପି ଜିହ୍ୱା ଦମଯିତୁଂ ନ ଶକ୍ୟତେ ସା ନ ନିୱାର୍ୟ୍ୟମ୍ ଅନିଷ୍ଟଂ ହଲାହଲୱିଷେଣ ପୂର୍ଣା ଚ|</para>
  <para style="p">
    <verse number="9" style="v"/>ତଯା ୱଯଂ ପିତରମ୍ ଈଶ୍ୱରଂ ଧନ୍ୟଂ ୱଦାମଃ, ତଯା ଚେଶ୍ୱରସ୍ୟ ସାଦୃଶ୍ୟେ ସୃଷ୍ଟାନ୍ ମାନୱାନ୍ ଶପାମଃ|</para>
  <para style="p">
    <verse number="10" style="v"/>ଏକସ୍ମାଦ୍ ୱଦନାଦ୍ ଧନ୍ୟୱାଦଶାପୌ ନିର୍ଗଚ୍ଛତଃ| ହେ ମମ ଭ୍ରାତରଃ, ଏତାଦୃଶଂ ନ କର୍ତ୍ତୱ୍ୟଂ|</para>
  <para style="p">
    <verse number="11" style="v"/>ପ୍ରସ୍ରୱଣଃ କିମ୍ ଏକସ୍ମାତ୍ ଛିଦ୍ରାତ୍ ମିଷ୍ଟଂ ତିକ୍ତଞ୍ଚ ତୋଯଂ ନିର୍ଗମଯତି?</para>
  <para style="p">
    <verse number="12" style="v"/>ହେ ମମ ଭ୍ରାତରଃ, ଉଡୁମ୍ବରତରୁଃ କିଂ ଜିତଫଲାନି ଦ୍ରାକ୍ଷାଲତା ୱା କିମ୍ ଉଡୁମ୍ବରଫଲାନି ଫଲିତୁଂ ଶକ୍ନୋତି? ତଦ୍ୱଦ୍ ଏକଃ ପ୍ରସ୍ରୱଣୋ ଲୱଣମିଷ୍ଟେ ତୋଯେ ନିର୍ଗମଯିତୁଂ ନ ଶକ୍ନୋତି|</para>
  <para style="p">
    <verse number="13" style="v"/>ଯୁଷ୍ମାକଂ ମଧ୍ୟେ ଜ୍ଞାନୀ ସୁବୋଧଶ୍ଚ କ ଆସ୍ତେ? ତସ୍ୟ କର୍ମ୍ମାଣି ଜ୍ଞାନମୂଲକମୃଦୁତାଯୁକ୍ତାନୀତି ସଦାଚାରାତ୍ ସ ପ୍ରମାଣଯତୁ|</para>
  <para style="p">
    <verse number="14" style="v"/>କିନ୍ତୁ ଯୁଷ୍ମଦନ୍ତଃକରଣମଧ୍ୟେ ଯଦି ତିକ୍ତେର୍ଷ୍ୟା ୱିୱାଦେଚ୍ଛା ଚ ୱିଦ୍ୟତେ ତର୍ହି ସତ୍ୟମତସ୍ୟ ୱିରୁଦ୍ଧଂ ନ ଶ୍ଲାଘଧ୍ୱଂ ନଚାନୃତଂ କଥଯତ|</para>
  <para style="p">
    <verse number="15" style="v"/>ତାଦୃଶଂ ଜ୍ଞାନମ୍ ଊର୍ଦ୍ଧ୍ୱାଦ୍ ଆଗତଂ ନହି କିନ୍ତୁ ପାର୍ଥିୱଂ ଶରୀରି ଭୌତିକଞ୍ଚ|</para>
  <para style="p">
    <verse number="16" style="v"/>ଯତୋ ହେତୋରୀର୍ଷ୍ୟା ୱିୱାଦେଚ୍ଛା ଚ ଯତ୍ର ୱେଦ୍ୟେତେ ତତ୍ରୈୱ କଲହଃ ସର୍ୱ୍ୱଂ ଦୁଷ୍କୃତଞ୍ଚ ୱିଦ୍ୟତେ|</para>
  <para style="p">
    <verse number="17" style="v"/>କିନ୍ତୂର୍ଦ୍ଧ୍ୱାଦ୍ ଆଗତଂ ଯତ୍ ଜ୍ଞାନଂ ତତ୍ ପ୍ରଥମଂ ଶୁଚି ତତଃ ପରଂ ଶାନ୍ତଂ କ୍ଷାନ୍ତମ୍ ଆଶୁସନ୍ଧେଯଂ ଦଯାଦିସତ୍ଫଲୈଃ ପରିପୂର୍ଣମ୍ ଅସନ୍ଦିଗ୍ଧଂ ନିଷ୍କପଟଞ୍ଚ ଭୱତି|</para>
  <para style="p">
    <verse number="18" style="v"/>ଶାନ୍ତ୍ୟାଚାରିଭିଃ ଶାନ୍ତ୍ୟା ଧର୍ମ୍ମଫଲଂ ରୋପ୍ୟତେ|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ଯୁଷ୍ମାକଂ ମଧ୍ୟେ ସମରା ରଣଶ୍ଚ କୁତ ଉତ୍ପଦ୍ୟନ୍ତେ? ଯୁଷ୍ମଦଙ୍ଗଶିବିରାଶ୍ରିତାଭ୍ୟଃ ସୁଖେଚ୍ଛାଭ୍ୟଃ କିଂ ନୋତ୍ପଦ୍ୟନ୍ତେे?</para>
  <para style="p">
    <verse number="2" style="v"/>ଯୂଯଂ ୱାଞ୍ଛଥ କିନ୍ତୁ ନାପ୍ନୁଥ, ଯୂଯଂ ନରହତ୍ୟାମ୍ ଈର୍ଷ୍ୟାଞ୍ଚ କୁରୁଥ କିନ୍ତୁ କୃତାର୍ଥା ଭୱିତୁଂ ନ ଶକ୍ନୁଥ, ଯୂଯଂ ଯୁଧ୍ୟଥ ରଣଂ କୁରୁଥ ଚ କିନ୍ତ୍ୱପ୍ରାପ୍ତାସ୍ତିଷ୍ଠଥ, ଯତୋ ହେତୋଃ ପ୍ରାର୍ଥନାଂ ନ କୁରୁଥ|</para>
  <para style="p">
    <verse number="3" style="v"/>ଯୂଯଂ ପ୍ରାର୍ଥଯଧ୍ୱେ କିନ୍ତୁ ନ ଲଭଧ୍ୱେ ଯତୋ ହେତୋଃ ସ୍ୱସୁଖଭୋଗେଷୁ ୱ୍ୟଯାର୍ଥଂ କୁ ପ୍ରାର୍ଥଯଧ୍ୱେ|</para>
  <para style="p">
    <verse number="4" style="v"/>ହେ ୱ୍ୟଭିଚାରିଣୋ ୱ୍ୟଭିଚାରିଣ୍ୟଶ୍ଚ, ସଂସାରସ୍ୟ ଯତ୍ ମୈତ୍ର୍ୟଂ ତଦ୍ ଈଶ୍ୱରସ୍ୟ ଶାତ୍ରୱମିତି ଯୂଯଂ କିଂ ନ ଜାନୀଥ? ଅତ ଏୱ ଯଃ କଶ୍ଚିତ୍ ସଂସାରସ୍ୟ ମିତ୍ରଂ ଭୱିତୁମ୍ ଅଭିଲଷତି ସ ଏୱେଶ୍ୱରସ୍ୟ ଶତ୍ରୁ ର୍ଭୱତି|</para>
  <para style="p">
    <verse number="5" style="v"/>ଯୂଯଂ କିଂ ମନ୍ୟଧ୍ୱେ? ଶାସ୍ତ୍ରସ୍ୟ ୱାକ୍ୟଂ କିଂ ଫଲହୀନଂ ଭୱେତ୍? ଅସ୍ମଦନ୍ତର୍ୱାସୀ ଯ ଆତ୍ମା ସ ୱା କିମ୍ ଈର୍ଷ୍ୟାର୍ଥଂ ପ୍ରେମ କରୋତି?</para>
  <para style="p">
    <verse number="6" style="v"/>ତନ୍ନହି କିନ୍ତୁ ସ ପ୍ରତୁଲଂ ୱରଂ ୱିତରତି ତସ୍ମାଦ୍ ଉକ୍ତମାସ୍ତେ ଯଥା, ଆତ୍ମାଭିମାନଲୋକାନାଂ ୱିପକ୍ଷୋ ଭୱତୀଶ୍ୱରଃ| କିନ୍ତୁ ତେନୈୱ ନମ୍ରେଭ୍ୟଃ ପ୍ରସାଦାଦ୍ ଦୀଯତେ ୱରଃ||</para>
  <para style="p">
    <verse number="7" style="v"/>ଅତଏୱ ଯୂଯମ୍ ଈଶ୍ୱରସ୍ୟ ୱଶ୍ୟା ଭୱତ ଶଯତାନଂ ସଂରୁନ୍ଧ ତେନ ସ ଯୁଷ୍ମତ୍ତଃ ପଲାଯିଷ୍ୟତେ|</para>
  <para style="p">
    <verse number="8" style="v"/>ଈଶ୍ୱରସ୍ୟ ସମୀପୱର୍ତ୍ତିନୋ ଭୱତ ତେନ ସ ଯୁଷ୍ମାକଂ ସମୀପୱର୍ତ୍ତୀ ଭୱିଷ୍ୟତି| ହେ ପାପିନଃ, ଯୂଯଂ ସ୍ୱକରାନ୍ ପରିଷ୍କୁରୁଧ୍ୱଂ| ହେ ଦ୍ୱିମନୋଲୋକାଃ, ଯୂଯଂ ସ୍ୱାନ୍ତଃକରଣାନି ଶୁଚୀନି କୁରୁଧ୍ୱଂ|</para>
  <para style="p">
    <verse number="9" style="v"/>ଯୂଯମ୍ ଉଦ୍ୱିଜଧ୍ୱଂ ଶୋଚତ ୱିଲପତ ଚ, ଯୁଷ୍ମାକଂ ହାସଃ ଶୋକାଯ, ଆନନ୍ଦଶ୍ଚ କାତରତାଯୈ ପରିୱର୍ତ୍ତେତାଂ|</para>
  <para style="p">
    <verse number="10" style="v"/>ପ୍ରଭୋଃ ସମକ୍ଷଂ ନମ୍ରା ଭୱତ ତସ୍ମାତ୍ ସ ଯୁଷ୍ମାନ୍ ଉଚ୍ଚୀକରିଷ୍ୟତି|</para>
  <para style="p">
    <verse number="11" style="v"/>ହେ ଭ୍ରାତରଃ, ଯୂଯଂ ପରସ୍ପରଂ ମା ଦୂଷଯତ| ଯଃ କଶ୍ଚିଦ୍ ଭ୍ରାତରଂ ଦୂଷଯତି ଭ୍ରାତୁ ର୍ୱିଚାରଞ୍ଚ କରୋତି ସ ୱ୍ୟୱସ୍ଥାଂ ଦୂଷଯତି ୱ୍ୟୱସ୍ଥାଯାଶ୍ଚ ୱିଚାରଂ କରୋତି| ତ୍ୱଂ ଯଦି ୱ୍ୟୱସ୍ଥାଯା ୱିଚାରଂ କରୋଷି ତର୍ହି ୱ୍ୟୱସ୍ଥାପାଲଯିତା ନ ଭୱସି କିନ୍ତୁ ୱିଚାରଯିତା ଭୱସି|</para>
  <para style="p">
    <verse number="12" style="v"/>ଅଦ୍ୱିତୀଯୋ ୱ୍ୟୱସ୍ଥାପକୋ ୱିଚାରଯିତା ଚ ସ ଏୱାସ୍ତେ ଯୋ ରକ୍ଷିତୁଂ ନାଶଯିତୁଞ୍ଚ ପାରଯତି| କିନ୍ତୁ କସ୍ତ୍ୱଂ ଯତ୍ ପରସ୍ୟ ୱିଚାରଂ କରୋଷି?</para>
  <para style="p">
    <verse number="13" style="v"/>ଅଦ୍ୟ ଶ୍ୱୋ ୱା ୱଯମ୍ ଅମୁକନଗରଂ ଗତ୍ୱା ତତ୍ର ୱର୍ଷମେକଂ ଯାପଯନ୍ତୋ ୱାଣିଜ୍ୟଂ କରିଷ୍ୟାମଃ ଲାଭଂ ପ୍ରାପ୍ସ୍ୟାମଶ୍ଚେତି କଥାଂ ଭାଷମାଣା ଯୂଯମ୍ ଇଦାନୀଂ ଶୃଣୁତ|</para>
  <para style="p">
    <verse number="14" style="v"/>ଶ୍ୱଃ କିଂ ଘଟିଷ୍ୟତେ ତଦ୍ ଯୂଯଂ ନ ଜାନୀଥ ଯତୋ ଜୀୱନଂ ୱୋ ଭୱେତ୍ କୀଦୃକ୍ ତତ୍ତୁ ବାଷ୍ପସ୍ୱରୂପକଂ, କ୍ଷଣମାତ୍ରଂ ଭୱେଦ୍ ଦୃଶ୍ୟଂ ଲୁପ୍ୟତେ ଚ ତତଃ ପରଂ|</para>
  <para style="p">
    <verse number="15" style="v"/>ତଦନୁକ୍ତ୍ୱା ଯୁଷ୍ମାକମ୍ ଇଦଂ କଥନୀଯଂ ପ୍ରଭୋରିଚ୍ଛାତୋ ୱଯଂ ଯଦି ଜୀୱାମସ୍ତର୍ହ୍ୟେତତ୍ କର୍ମ୍ମ ତତ୍ କର୍ମ୍ମ ୱା କରିଷ୍ୟାମ ଇତି|</para>
  <para style="p">
    <verse number="16" style="v"/>କିନ୍ତ୍ୱିଦାନୀଂ ଯୂଯଂ ଗର୍ୱ୍ୱୱାକ୍ୟୈଃ ଶ୍ଲାଘନଂ କୁରୁଧ୍ୱେ ତାଦୃଶଂ ସର୍ୱ୍ୱଂ ଶ୍ଲାଘନଂ କୁତ୍ସିତମେୱ|</para>
  <para style="p">
    <verse number="17" style="v"/>ଅତୋ ଯଃ କଶ୍ଚିତ୍ ସତ୍କର୍ମ୍ମ କର୍ତ୍ତଂ ୱିଦିତ୍ୱା ତନ୍ନ କରୋତି ତସ୍ୟ ପାପଂ ଜାଯତେ|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ହେ ଧନୱନ୍ତଃ, ଯୂଯମ୍ ଇଦାନୀଂ ଶୃଣୁତ ଯୁଷ୍ମାଭିରାଗମିଷ୍ୟତ୍କ୍ଲେଶହେତୋଃ କ୍ରନ୍ଦ୍ୟତାଂ ୱିଲପ୍ୟତାଞ୍ଚ|</para>
  <para style="p">
    <verse number="2" style="v"/>ଯୁଷ୍ମାକଂ ଦ୍ରୱିଣଂ ଜୀର୍ଣଂ କୀଟଭୁକ୍ତାଃ ସୁଚେଲକାଃ|</para>
  <para style="p">
    <verse number="3" style="v"/>କନକଂ ରଜତଞ୍ଚାପି ୱିକୃତିଂ ପ୍ରଗମିଷ୍ୟତି, ତତ୍କଲଙ୍କଶ୍ଚ ଯୁଷ୍ମାକଂ ପାପଂ ପ୍ରମାଣଯିଷ୍ୟତି, ହୁତାଶୱଚ୍ଚ ଯୁଷ୍ମାକଂ ପିଶିତଂ ଖାଦଯିଷ୍ୟତି| ଇତ୍ଥମ୍ ଅନ୍ତିମଘସ୍ରେଷୁ ଯୁଷ୍ମାଭିଃ ସଞ୍ଚିତଂ ଧନଂ|</para>
  <para style="p">
    <verse number="4" style="v"/>ପଶ୍ୟତ ଯୈଃ କୃଷୀୱଲୈ ର୍ୟୁଷ୍ମାକଂ ଶସ୍ୟାନି ଛିନ୍ନାନି ତେଭ୍ୟୋ ଯୁଷ୍ମାଭି ର୍ୟଦ୍ ୱେତନଂ ଛିନ୍ନଂ ତଦ୍ ଉଚ୍ଚୈ ର୍ଧ୍ୱନିଂ କରୋତି ତେଷାଂ ଶସ୍ୟଚ୍ଛେଦକାନାମ୍ ଆର୍ତ୍ତରାୱଃ ସେନାପତେଃ ପରମେଶ୍ୱରସ୍ୟ କର୍ଣକୁହରଂ ପ୍ରୱିଷ୍ଟଃ|</para>
  <para style="p">
    <verse number="5" style="v"/>ଯୂଯଂ ପୃଥିୱ୍ୟାଂ ସୁଖଭୋଗଂ କାମୁକତାଞ୍ଚାରିତୱନ୍ତଃ, ମହାଭୋଜସ୍ୟ ଦିନ ଇୱ ନିଜାନ୍ତଃକରଣାନି ପରିତର୍ପିତୱନ୍ତଶ୍ଚ|</para>
  <para style="p">
    <verse number="6" style="v"/>ଅପରଞ୍ଚ ଯୁଷ୍ମାଭି ର୍ଧାର୍ମ୍ମିକସ୍ୟ ଦଣ୍ଡାଜ୍ଞା ହତ୍ୟା ଚାକାରି ତଥାପି ସ ଯୁଷ୍ମାନ୍ ନ ପ୍ରତିରୁଦ୍ଧୱାନ୍|</para>
  <para style="p">
    <verse number="7" style="v"/>ହେ ଭ୍ରାତରଃ, ଯୂଯଂ ପ୍ରଭୋରାଗମନଂ ଯାୱଦ୍ ଧୈର୍ୟ୍ୟମାଲମ୍ବଧ୍ୱଂ| ପଶ୍ୟତ କୃଷିୱଲୋ ଭୂମେ ର୍ବହୁମୂଲ୍ୟଂ ଫଲଂ ପ୍ରତୀକ୍ଷମାଣୋ ଯାୱତ୍ ପ୍ରଥମମ୍ ଅନ୍ତିମଞ୍ଚ ୱୃଷ୍ଟିଜଲଂ ନ ପ୍ରାପ୍ନୋତି ତାୱଦ୍ ଧୈର୍ୟ୍ୟମ୍ ଆଲମ୍ବତେ|</para>
  <para style="p">
    <verse number="8" style="v"/>ଯୂଯମପି ଧୈର୍ୟ୍ୟମାଲମ୍ବ୍ୟ ସ୍ୱାନ୍ତଃକରଣାନି ସ୍ଥିରୀକୁରୁତ, ଯତଃ ପ୍ରଭୋରୁପସ୍ଥିତିଃ ସମୀପୱର୍ତ୍ତିନ୍ୟଭୱତ୍|</para>
  <para style="p">
    <verse number="9" style="v"/>ହେ ଭ୍ରାତରଃ, ଯୂଯଂ ଯଦ୍ ଦଣ୍ଡ୍ୟା ନ ଭୱେତ ତଦର୍ଥଂ ପରସ୍ପରଂ ନ ଗ୍ଲାଯତ, ପଶ୍ୟତ ୱିଚାରଯିତା ଦ୍ୱାରସମୀପେ ତିଷ୍ଠତି|</para>
  <para style="p">
    <verse number="10" style="v"/>ହେ ମମ ଭ୍ରାତରଃ, ଯେ ଭୱିଷ୍ୟଦ୍ୱାଦିନଃ ପ୍ରଭୋ ର୍ନାମ୍ନା ଭାଷିତୱନ୍ତସ୍ତାନ୍ ଯୂଯଂ ଦୁଃଖସହନସ୍ୟ ଧୈର୍ୟ୍ୟସ୍ୟ ଚ ଦୃଷ୍ଟାନ୍ତାନ୍ ଜାନୀତ|</para>
  <para style="p">
    <verse number="11" style="v"/>ପଶ୍ୟତ ଧୈର୍ୟ୍ୟଶୀଲା ଅସ୍ମାଭି ର୍ଧନ୍ୟା ଉଚ୍ୟନ୍ତେ| ଆଯୂବୋ ଧୈର୍ୟ୍ୟଂ ଯୁଷ୍ମାଭିରଶ୍ରାୱି ପ୍ରଭୋଃ ପରିଣାମଶ୍ଚାଦର୍ଶି ଯତଃ ପ୍ରଭୁ ର୍ବହୁକୃପଃ ସକରୁଣଶ୍ଚାସ୍ତି|</para>
  <para style="p">
    <verse number="12" style="v"/>ହେ ଭ୍ରାତରଃ ୱିଶେଷତ ଇଦଂ ୱଦାମି ସ୍ୱର୍ଗସ୍ୟ ୱା ପୃଥିୱ୍ୟା ୱାନ୍ୟୱସ୍ତୁନୋ ନାମ ଗୃହୀତ୍ୱା ଯୁଷ୍ମାଭିଃ କୋଽପି ଶପଥୋ ନ କ୍ରିଯତାଂ, କିନ୍ତୁ ଯଥା ଦଣ୍ଡ୍ୟା ନ ଭୱତ ତଦର୍ଥଂ ଯୁଷ୍ମାକଂ ତଥୈୱ ତନ୍ନହି ଚେତିୱାକ୍ୟଂ ଯଥେଷ୍ଟଂ ଭୱତୁ|</para>
  <para style="p">
    <verse number="13" style="v"/>ଯୁଷ୍ମାକଂ କଶ୍ଚିଦ୍ ଦୁଃଖୀ ଭୱତି? ସ ପ୍ରାର୍ଥନାଂ କରୋତୁ| କଶ୍ଚିଦ୍ ୱାନନ୍ଦିତୋ ଭୱତି? ସ ଗୀତଂ ଗାଯତୁ|</para>
  <para style="p">
    <verse number="14" style="v"/>ଯୁଷ୍ମାକଂ କଶ୍ଚିତ୍ ପୀଡିତୋ ଽସ୍ତି? ସ ସମିତେଃ ପ୍ରାଚୀନାନ୍ ଆହ୍ୱାତୁ ତେ ଚ ପଭୋ ର୍ନାମ୍ନା ତଂ ତୈଲେନାଭିଷିଚ୍ୟ ତସ୍ୟ କୃତେ ପ୍ରାର୍ଥନାଂ କୁର୍ୱ୍ୱନ୍ତୁ|</para>
  <para style="p">
    <verse number="15" style="v"/>ତସ୍ମାଦ୍ ୱିଶ୍ୱାସଜାତପ୍ରାର୍ଥନଯା ସ ରୋଗୀ ରକ୍ଷାଂ ଯାସ୍ୟତି ପ୍ରଭୁଶ୍ଚ ତମ୍ ଉତ୍ଥାପଯିଷ୍ୟତି ଯଦି ଚ କୃତପାପୋ ଭୱେତ୍ ତର୍ହି ସ ତଂ କ୍ଷମିଷ୍ୟତେ|</para>
  <para style="p">
    <verse number="16" style="v"/>ଯୂଯଂ ପରସ୍ପରମ୍ ଅପରାଧାନ୍ ଅଙ୍ଗୀକୁରୁଧ୍ୱମ୍ ଆରୋଗ୍ୟପ୍ରାପ୍ତ୍ୟର୍ଥଞ୍ଚୈକଜନୋ ଽନ୍ୟସ୍ୟ କୃତେ ପ୍ରାର୍ଥନାଂ କରୋତୁ ଧାର୍ମ୍ମିକସ୍ୟ ସଯତ୍ନା ପ୍ରାର୍ଥନା ବହୁଶକ୍ତିୱିଶିଷ୍ଟା ଭୱତି|</para>
  <para style="p">
    <verse number="17" style="v"/>ଯ ଏଲିଯୋ ୱଯମିୱ ସୁଖଦୁଃଖଭୋଗୀ ମର୍ତ୍ତ୍ୟ ଆସୀତ୍ ସ ପ୍ରାର୍ଥନଯାନାୱୃଷ୍ଟିଂ ଯାଚିତୱାନ୍ ତେନ ଦେଶେ ସାର୍ଦ୍ଧୱତ୍ସରତ୍ରଯଂ ଯାୱଦ୍ ୱୃଷ୍ଟି ର୍ନ ବଭୂୱ|</para>
  <para style="p">
    <verse number="18" style="v"/>ପଶ୍ଚାତ୍ ତେନ ପୁନଃ ପ୍ରାର୍ଥନାଯାଂ କୃତାଯାମ୍ ଆକାଶସ୍ତୋଯାନ୍ୟୱର୍ଷୀତ୍ ପୃଥିୱୀ ଚ ସ୍ୱଫଲାନି ପ୍ରାରୋହଯତ୍|</para>
  <para style="p">
    <verse number="19" style="v"/>ହେ ଭ୍ରାତରଃ, ଯୁଷ୍ମାକଂ କସ୍ମିଂଶ୍ଚିତ୍ ସତ୍ୟମତାଦ୍ ଭ୍ରଷ୍ଟେ ଯଦି କଶ୍ଚିତ୍ ତଂ ପରାୱର୍ତ୍ତଯତି</para>
  <para style="p">
    <verse number="20" style="v"/>ତର୍ହି ଯୋ ଜନଃ ପାପିନଂ ୱିପଥଭ୍ରମଣାତ୍ ପରାୱର୍ତ୍ତଯତି ସ ତସ୍ୟାତ୍ମାନଂ ମୃତ୍ୟୁତ ଉଦ୍ଧରିଷ୍ୟତି ବହୁପାପାନ୍ୟାୱରିଷ୍ୟତି ଚେତି ଜାନାତୁ|</para>
</usx>
