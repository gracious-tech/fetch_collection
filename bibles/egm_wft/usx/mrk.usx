<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MRK" style="id">- Benamanga Bible Version</book>
  <para style="h">Maliko</para>
  <para style="toc1">Njowo Nofu ngita isimbilwe na Maliko</para>
  <para style="toc2">Maliko</para>
  <para style="toc3">Mlk</para>
  <para style="mt2">NJOWO NOFU NGITA ISIMBILWE NA</para>
  <para style="mt1">MALIKO</para>
  <para style="imt">ULONGOCHO</para>
  <para style="ip">Kiganulo cha Njowo lya Maliko nde kimwi pagati lya figanulo fitai fya lyagano miya fyefilonga maisa ga Yesu Kilisito. Kila kiganulo pa ifyo fitai kikemelwa “Injili” mana lyake “Njowo Nofu.” Figanulo ifi fiyandikwe chipindi Yesu peafuwe, yevasimbilie vakali Matayo na Maliko na Luka pamwinga na Yohani. Njowo Nofu lya Maliko nde fupi kuchumba chonda. Ikwidikilwa kuva Njowo Nofu ivangilwe kusimbwa kabula lya Njowo Nofu chingi pa myaka sitini na chihanu mpaka sabini peababilwe Yesu BK. Vakwimbaji volofu va Bibiliya viidikila kuva Njowo iyi yeisimbilwe ukoya Loma kwa kuva tila numbula vakilisitu ukoya Loma.</para>
  <para style="ip">Maliko achelilwe ngita Yohani Maliko agitile kasi pamwi na vanjagila Paulo na Balinaba ila se vagendeliye kuvecha pamwinga pa umishini Matayo 13.13. Pambele Maliko agendile pamwinga na Balinaba, Matayo 15.37-39. Maliko yeachelanike kuva mganja mkomi va Peteli 1 Peteli 5.13. Kangi Maliko seakali mugati va vevagawene maisa ga Yesu vakwimbaji vikwidikila kuva Maliko agayasimbile njowo kuhumila na gala agagapulike kwa Peteli njowo cha Maliko chilonga pakyanya lya makwimbiso ga Yesu kutigila figono fya mwiso.</para>
  <para style="iot">Gegagehe mukiganulo kya Maliko</para>
  <para style="io">Utambulicho va kiganulo cha Maliko 1.1-13</para>
  <para style="io">Mawulanicho pakyanya ga kumtumikila Yesu peakali Galilaya Maliko 1.14—8.21</para>
  <para style="io">Lugendo lwa Yesu kuhelela ku Yelusalemu Maliko 8.22—10.52.</para>
  <para style="io">Maisa ga Yesu ukoya Yelusalemnu pamwinga na kufuwa kwake na kuchulubuka kwake, Maliko 11.1—16.8.</para>
  <chapter number="1" style="c" sid="MRK 1" />
  <para style="s">Yohani mbatisaji akuvadalikiya vanu</para>
  <para style="r">
    <ref loc="MAT 3:1-12">Matayo 3.1-12</ref>; <ref loc="LUK 3:1-18">Luka 3.1-18</ref>; <ref loc="JHN 1:19-28">Yohani 1.19-28</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1" />Iyi ndi Njowo Nofu lya Yesu Kilisito, Mwana va Nguluvi. <verse eid="MRK 1:1" /><verse number="2" style="v" sid="MRK 1:2" />Ivangile ngita peisimbilwe pa kiganulo cha mvichi va Nguluvi yeikemelwa Isaya,</para>
  <para style="q" vid="MRK 1:2">“Nguluvi alongile ndikumlagicha mnanzi vangu akulongole yumwene,</para>
  <para style="q" vid="MRK 1:2">akugalanichile ng'asi lyako.<verse eid="MRK 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="MRK 1:3" />Lichwi lya munu ikemela kuwelu,</para>
  <para style="q" vid="MRK 1:3">‘Mumgalanichile ng'asi lya Mtwa,</para>
  <para style="q" vid="MRK 1:3">mgolole pono peichumbila!’”<verse eid="MRK 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 1:4" />Yohani mbatisaji ahumile kuwelu, akavadalikila vanu na kuvabatisa akilonga kuva muleke sambi chenu na Nguluvi avahechelele sambi. <verse eid="MRK 1:4" /><verse number="5" style="v" sid="MRK 1:5" />Vanu kuhuma inyi yonda lya Yudea na vanu vonda kuhuma pamwani va Yelusalemu vamweleliye Yohani, vakahongecha sambi chawo na kuvabatisa pa mgoka Yolidani.<verse eid="MRK 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 1:6" />Yohani akali afwalile mwenda weugelanichilwe kwa magala ga mwang'oko yeikemelwa ngamiya na lufunga va ngwembe mu kigudi. Kyakulia kyake kikali midedema na luki. <verse eid="MRK 1:6" /><verse number="7" style="v" sid="MRK 1:7" />Akavadalikiye vanu, “Kuhuma nene ekwacha munu yeali na umwimike mkomi mno. Nene sendidikilwa kugundama na kuwopola ndegei cha mikobasi gyake. <verse eid="MRK 1:7" /><verse number="8" style="v" sid="MRK 1:8" />Nene ndikuvabatisa kwa malenga, ila mwene akuvabatisa kwa Muhe lwa Nguluvi.”<verse eid="MRK 1:8" /></para>
  <para style="s">Kubatiswa na Kugechwa kwa Yesu</para>
  <para style="r">
    <ref loc="MAT 3:13-4:11">Matayo 3.13—4.11</ref>; <ref loc="LUK 3:21-22">Luka 3.21-22</ref>; <ref loc="LUK 4:1-13">4.1-13</ref></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9" />Figono fila, Yesu achile kuhuma Nasaleti, mwani va ku Galilaya, akabatiswa na Yohani mu mgoka Yolidani. <verse eid="MRK 1:9" /><verse number="10" style="v" sid="MRK 1:10" />Yesu peakali ihuma mumalenga, awene luhano idindwike na Muhe lwa Nguluvi ukwika ku kyanya lyake ngita ng'unda. <verse eid="MRK 1:10" /><verse number="11" style="v" sid="MRK 1:11" />Na lichwi yapulise kuhuma kuluhano, “Veve Mwana vangu yendikukelie, ndikeliwe nave.”<verse eid="MRK 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12" />Bahobaho alongwichwe na Muhe lya Nguluvi kuhelela kuwelu, <verse eid="MRK 1:12" /><verse number="13" style="v" sid="MRK 1:13" />akalile ukoya figono Alobaini peigechwa na Setani. Ukoya kukali na vang'oko va kudasi, navo ndumindumi va kuluhano va Nguluvi vakali vakimuhudumila.<verse eid="MRK 1:13" /></para>
  <para style="s">Yesu ekuvakemela valowa vatai</para>
  <para style="r">
    <ref loc="MAT 4:12-22">Matayo 4.12-22</ref>; <ref loc="LUK 4:14-15">Luka 4.14-15</ref>; <ref loc="LUK 5:1-11">5.1-11</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14" />Yohani peabatilwe na kudindilwa mu kiwopo, Yesu akahele inyi lya Galilaya, avangile kudalika Njowo Nofu lya Nguluvi, <verse eid="MRK 1:14" /><verse number="15" style="v" sid="MRK 1:15" />akilonga, “Vakati ufikile, na ung'achale va Nguluvi upepi. Muhongeche na kwidikila Njowo Nofu lya Nguluvi!”<verse eid="MRK 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16" />Yesu peakali ichumba mumbali lya lihiva lya Galilaya, avawene valowa somba vavili Simoni pamwinga na Andelea lukolo vake vilowa somba kwa wafu.<figure style="fig" file="07 Fishing.jpg" size="col" ref="1.16">Munu ilowa somba kwa wafu</figure> <verse eid="MRK 1:16" /><verse number="17" style="v" sid="MRK 1:17" />Yesu akavalongie, “Mwache kwa nene na nene ndikuvagita nyenye kuvaleta vanu kwa nene ngita valowa pevileta somba.” <verse eid="MRK 1:17" /><verse number="18" style="v" sid="MRK 1:18" />Bahobaho vakaleka nyafu chawo, vakamfuatile.<verse eid="MRK 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 1:19" />Peahele pautalo ludodo, akamwene Yakobo na Yohani, vana va Sebedayo. Navo vakali muwato, visambula nyafu chawo. <verse eid="MRK 1:19" /><verse number="20" style="v" sid="MRK 1:20" />Bahobaho, Yesu akavakemelie, navo vakamleka daada vawo Sebedayo mu wato pamwi na vachulila, vakahele kwa Yesu.<verse eid="MRK 1:20" /></para>
  <para style="s">Yesu ekumnanicha munu munya lihoka</para>
  <para style="r">
    <ref loc="LUK 4:31-37">Luka 4.31-37</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21" />Yesu na vachulila vake vakahele mbaka kumwani Kapelinaum. Pekifikile kigono kya kutulula, Yesu ayingie kaye lya kutang'anila Vayawudi, akavanga kudalika. <verse eid="MRK 1:21" /><verse number="22" style="v" sid="MRK 1:22" />Vanu vala vevampulike vakadudwive mno, na madaliko gyake, kwakuva akali akidalika ngita munu mwene umwimike vala se ngita vawulanichi vawo va Malagicho.<verse eid="MRK 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 1:23" />Baho munu munya lihoka akaingile mukaye lya kutang'anila Vayawudi, <verse eid="MRK 1:23" /><verse number="24" style="v" sid="MRK 1:24" />yula lihoka akabwatile, “Wikela kutugitila liki, veve Yesu va Nasaleti? Wuli, vachile kutuhananga? Ndichele veve ani, veve ndi Mng'alili va Nguluvi!”<verse eid="MRK 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 1:25" />Yesu akamkanile yula lihoka, akilonga, “Yigale, muwege uyu munu.”<verse eid="MRK 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 1:26" />Yula lihoka amuhogosile kwa ludali kuno ibwatuka, akamuhega. <verse eid="MRK 1:26" /><verse number="27" style="v" sid="MRK 1:27" />Vanu vonda vadudwive, vekwiwucha, “Ichi njowo liki? Wuli, ndi mawulanichi mamiya? Munu uyu ali na umwimike va kuvaswitilicha mihoka, navo vekumpulika” <verse eid="MRK 1:27" /><verse number="28" style="v" sid="MRK 1:28" />Makani ga Yesu chikapulise kisatu kila pono ponda ku Galilaya.<verse eid="MRK 1:28" /></para>
  <para style="s">Yesu akumnanicha vanu volofu</para>
  <para style="r">
    <ref loc="MAT 8:14-17">Matayo 8.14-17</ref>; <ref loc="LUK 4:38-41">Luka 4.38-41</ref></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29" />Bahobaho pevahumile mu kaye lya kutang'anila Vayawudi, Yesu pamwinga na Yakobo na Yohani vakahele mbaka kaye lya Simoni na Andelea. <verse eid="MRK 1:29" /><verse number="30" style="v" sid="MRK 1:30" />Maye yumwi, mganafu va Simoni, akali pa ulili evawuwa ng'ali, vamlongie njowo cha Yesu. <verse eid="MRK 1:30" /><verse number="31" style="v" sid="MRK 1:31" />Ndena Yesu akahelela kwa yula mtamwa, amkoliye akamwinamula na kumwinamula. Ila kuvauwa kwahumile, akamnachiche naye ivangile kuvatelekela.<verse eid="MRK 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32" />Palumie peifikile na lichuwa pelidibie, vanu vakavasindika vatamwa vonda kwa Yesu na vala yevali na lihoka. <verse eid="MRK 1:32" /><verse number="33" style="v" sid="MRK 1:33" />Vanu vonda va mwani ula vilundise pautalo lya kaye. <verse eid="MRK 1:33" /><verse number="34" style="v" sid="MRK 1:34" />Yesu akavaponya vanu volofu vevali na utamwa gya yaina gyolofu. Akavahecha mihoka gyolofu, ila akavakanile havo mihoka vabihile kulonga kwakuva vamchele mwene ndi ani.<verse eid="MRK 1:34" /></para>
  <para style="s">Yesu idalika inyi lya Galilaya</para>
  <para style="r">
    <ref loc="LUK 4:42-44">Luka 4.42-44</ref></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35" />Nyolasagala, Yesu akalamka, akahele pamfiyo, kumsuka Nguluvi. <verse eid="MRK 1:35" /><verse number="36" style="v" sid="MRK 1:36" />Simoni na vayage vakahele kumsaka. <verse eid="MRK 1:36" /><verse number="37" style="v" sid="MRK 1:37" />Peva vamwene, vakamlongie, “Vanu vonda vekukusaka.”<verse eid="MRK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38" />Yesu akavalongie, “Tubite pa mwani pangi pa pepi neke ndivese kudalika ukoya, kwakuva ndachile kwa hago.”<verse eid="MRK 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 1:39" />Ndena akachungutila inyi lya Galilaya yonda, kuno akidalika pa Kaye lya kutanganila Vayawudi na kuhecha lihoka.<verse eid="MRK 1:39" /></para>
  <para style="s">Yesu akumnanicha munu yeali na ukalavilo</para>
  <para style="r">
    <ref loc="MAT 8:1-4">Matayo 8.1-4</ref>; <ref loc="LUK 5:12-16">Luka 5.12-16</ref></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40" />Munu yumwi akali na ukalavilo akahelela kwa Yesu, akafugamile na kumlongela, “Peukela, wiwesa kuning'alila!”<verse eid="MRK 1:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41" />Yesu akamwonile lusungu, agonjue liwoko lyake, akambyalisa na kumlongela, “Ndikela kung'alila!” <verse eid="MRK 1:41" /><verse number="42" style="v" sid="MRK 1:42" />Bahobaho ukalavilo ukamuhuma munu yula, kang'ala. <verse eid="MRK 1:42" /><verse number="43" style="v" sid="MRK 1:43" />Baho Yesu akamlongie abite kisatu na akamlongie, <verse eid="MRK 1:43" /><verse number="44" style="v" sid="MRK 1:44" />“Lole bihile kumlongela munu yeyonda njowo hulu, ila uhelele kuwoneka kwa mtekechi na ukahumiche usembe kwa Nguluvi ngita pealagiliche Musa, kwa kung'alila kwa veve, iveche uswida kwa vanu vangi.”<verse eid="MRK 1:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 1:45" />Ila yula munu akahelela avangile kulonga njowo chila chonda, mbaka Yesu akalemwile kwingila ku mwani na kuwoneka kwa vanu, akali akukala pono kuhela vanu. Ndena vanu vakali vahelela kuhuma kila pono.<verse eid="MRK 1:45" /></para>
  <chapter eid="MRK 1" />
  <chapter number="2" style="c" sid="MRK 2" />
  <para style="s">Yesu akumnanicha munu munyalugaso</para>
  <para style="r">
    <ref loc="MAT 9:1-8">Matayo 9.1-8</ref>; <ref loc="LUK 5:17-26">Luka 5.17-26</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1" />Pefichumbile figono fidodo, Yesu awuyile Kapelinaumu na vanu vapulike kuva agehe pakaye. <verse eid="MRK 2:1" /><verse number="2" style="v" sid="MRK 2:2" />Vanu volofu vamemile hilo mugati ata fwasi ikali kwihela, mbaka kwivala pamlyangilo. Yesu akali akuvadalikila njowo chinofu cha Nguluvi, <verse eid="MRK 2:2" /><verse number="3" style="v" sid="MRK 2:3" />Baho vafikile vanu vatai, vamnyamue munu munyalugaso vakamsindike kwa Yesu. <verse eid="MRK 2:3" /><verse number="4" style="v" sid="MRK 2:4" />Kwakuva lipinga lya vanu likali likomi vakalemwile kumsindika kwa Yesu, vatobuwe pono pa kitufili yeigehe pakyanya pono peagehe Yesu. Pevapatile pono, vakamkwisa yula munu akiva avasile pa kitefu. <verse eid="MRK 2:4" /><verse number="5" style="v" sid="MRK 2:5" />Yesu pealolile ludikilo lyawo, akamlongie munu yula munyalugaso, “Mwana vangu, ulekilwe sambi sako.” <verse eid="MRK 2:5" /><verse number="6" style="v" sid="MRK 2:6" />Vamonga va vawulanichi va malagicho pevali vikaliye pala vakahocha mnumbula chawo. <verse eid="MRK 2:6" /><verse number="7" style="v" sid="MRK 2:7" />“Wuli munu uyu ilonga ifyo? Ekumliga Nguluvi! Ndi ani yeiwesa kuvalekela sambi, ila Nguluvi yumwene?”<verse eid="MRK 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8" />Baho, baho Yesu akachele mahocho gyawo, akavalongela, “Wuli, muhocha ndeni munumbula chenu? <verse eid="MRK 2:8" /><verse number="9" style="v" sid="MRK 2:9" />Njowo liki lipefu hilo, kumlongela munu uyu munyalugaso, ‘Ulekilwe sambi chako,’ awu kumlongela; ‘Wime tegule litefu lyako ubite?’ <verse eid="MRK 2:9" /><verse number="10" style="v" sid="MRK 2:10" />Nondee ngamchela kuva Mwana va Munu anago umwimike va kuvalekela sambi chawo muinyi. Baho Yesu akamlongiye yula munu munyalugaso.” <verse eid="MRK 2:10" /><verse number="11" style="v" sid="MRK 2:11" />“Ndikulongela wime, tegule kitefu kyako uwelele kukaye lyako!” <verse eid="MRK 2:11" /><verse number="12" style="v" sid="MRK 2:12" />Yula munu munyalugaso akawime, akategula kitefu kyake akagenda pautalo pa vanu vonda pevilola njowo lula lukavaduduvile vanu vonda, vakamnjuma Nguluvi, vakilonga, “Tukali setupatila kowona njowo ngita yili haa!”<verse eid="MRK 2:12" /></para>
  <para style="s">Yesu akumkemela Lawi</para>
  <para style="r">
    <ref loc="MAT 9:9-13">Matayo 9.9-13</ref>; <ref loc="LUK 5:27-32">Luka 5.27-32</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13" />Yesu akahelela kangi mung'umbung'umbu lya lihiva lya Galilaya. Lipinga lya vanu likamfutila, na mwene akavangile kuvafundisa. <verse eid="MRK 2:13" /><verse number="14" style="v" sid="MRK 2:14" />Peachumbile, akamwene Lawi mwana va Alifayo, ekalile pono pa kuhombela kodi. Yesu akamlongie, “Nifuatile!” Lawi akawime, akamfuatile.<verse eid="MRK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15" />Yesu akali akalile pa kaye lya Lawi akiliya kyakula, vahomba kodi volofu na venye sambi vakali vamfuatile Yesu na volofu vawo vakava vakalile panyi pamwinga na vachulila vake. <verse eid="MRK 2:15" /><verse number="16" style="v" sid="MRK 2:16" />Suwe, vawulanichi vangi va malagicho na Vafalisayo pevamuonile Yesu pagehe kulia pamwi na vanu venye sambi na vahomba kodi, vakavaucha vachulila vake, “Wuli aliya pamwinga na vahomba kodi na venye sambi?”<verse eid="MRK 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 2:17" />Yesu peapulike, akavalongie, “Vanu sevitamika vakela hamu mulami, vevikela ndi vala vatamwa. Sendachile kuvakemela vanu vasanji, ila venye sambi.”<verse eid="MRK 2:17" /></para>
  <para style="s">Yesu ihuchwa njowo lya kudinda kuliya</para>
  <para style="r">
    <ref loc="MAT 9:14-17">Matayo 9.14-17</ref>; <ref loc="LUK 5:33-39">Luka 5.33-39</ref></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18" />Suwe vachulila va Yohani na vachulila va Mafalisayo vakali vedinda kulya. Vanu vangi vamwelelie Yesu na kumuhucha, “Wuli vachulila va Yohani na vachulila va Mafalisayo vidinda kulya ila vachulila vako sevidinda kulya?”<verse eid="MRK 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19" />Yesu akavahigile, “Wuli, vevalalikwe kulihungu lya kutola viwesa wuli kudinda kulya chipindi vagehe pamwi na mtwa va lihungu lya kutola? Muda gonda vagehe pamwi na mtwa va lihungu lya kutola seviwesa kudinda kuliya. <verse eid="MRK 2:19" /><verse number="20" style="v" sid="MRK 2:20" />Ila kigono kikwacha mtwa va lihungu lya kutola ehumichwa kwavo, chipindi huwo ndevekudinda kulya.”<verse eid="MRK 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21" />“Pahela munu yeaitegula kipapi kimya na kuvika ku mwenda weusakie. Peugitele ifyo, kila kipapi kimya kidemula wula mwenda weusakie, nalo ikwanangika hilo. <verse eid="MRK 2:21" /><verse number="22" style="v" sid="MRK 2:22" />Vala kuhela munu yeavikile difayi miya mukihako gya gosi kiwofu. Peigita ifyo, yila difayi miya gikubachula ifyo kihako, kwaifyo difayi yisukwika na kihako kya ngwembe likwananga. Difayi miya ivikwa ku kichoba kipya.”<verse eid="MRK 2:22" /></para>
  <para style="s">Yesu iwulanicha kuhusu kigono kya kutulula</para>
  <para style="r">
    <ref loc="MAT 12:1-8">Matayo 12.1-8</ref>; <ref loc="LUK 6:1-5">Luka 6.1-5</ref></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23" />Kigono kimwi kya Kutulula, Yesu pamwinga na vachulila vake vakali vakuchumba ku mikunda gya upemba. Pevali vagenda, vachulila vake vakavangile kudumula mihocho gya upemba. <verse eid="MRK 2:23" /><verse number="24" style="v" sid="MRK 2:24" />Vafalisayo vakamuhucha Yesu, “Wuli mwigita njowo lyelikanwilwe kugita kigono lya kutulula?” <verse eid="MRK 2:24" /><verse number="25" style="v" sid="MRK 2:25" />Yesu akavahigile, “Mwikali mwimbile hamu peagitile Dawudi paminga na vayake chipindi pevakali na njala? <verse eid="MRK 2:25" /><verse number="26" style="v" sid="MRK 2:26" />Dawudi ingile pa kaye lya Nguluvi chipindi Abiasali akiva mtekechi mkomi, akalia gila mibubunda yeivikile pautalo pa Nguluvi, ambayo ikali ibihilwe munu ye yonda kulya ila vale vatekechi ng'ani, Ila Dawudi akaliye akavagavila vayage.” <verse eid="MRK 2:26" /><verse number="27" style="v" sid="MRK 2:27" />Suwe, Yesu akavalongie, “Kigono kya Kutulula kivikilwe kwa ajili lya vanu, ila sevanu kwajili lya kigono kya Kutulula. <verse eid="MRK 2:27" /><verse number="28" style="v" sid="MRK 2:28" />Ndena, Mwana va Munu ndiye munya umwimike pakyanya pa kigono kya kutulula.”<verse eid="MRK 2:28" /></para>
  <chapter eid="MRK 2" />
  <chapter number="3" style="c" sid="MRK 3" />
  <para style="s">Yesu ekumnanicha munu munya liwokolugaso</para>
  <para style="r">
    <ref loc="MAT 12:9-14">Matayo 12.9-14</ref>; <ref loc="LUK 6:6-11">Luka 6.6-11</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1" />Yesu ingile kangi pa kaya lya kutang'anila Vayawudi, na ukoya pakali na munu munya liwokolugaso. <verse eid="MRK 3:1" /><verse number="2" style="v" sid="MRK 3:2" />Vanu vakali vamchindile amponyele munu huyo kigono kya kutulula neke vapatile kumlata. <verse eid="MRK 3:2" /><verse number="3" style="v" sid="MRK 3:3" />Yesu akamlongie yula munu munya liwokolugaso, “Wime pautalo neke kila munu akulole.” <verse eid="MRK 3:3" /><verse number="4" style="v" sid="MRK 3:4" />Suwe, Yesu akavahucha, “Ndeunofu kigono kya kutulula kugita njowo lunofu awu kugita njowo lihofu? Kuwokola maisa awu kudocha?” Ila vawo vakachikile. <verse eid="MRK 3:4" /><verse number="5" style="v" sid="MRK 3:5" />Yesu kavalola vonda kwa kuvipa, akasugwime kwakuva lya usugu vawo. Suwe, akamlongie yula munu, “Gonjolola liwoko lyako!” Nave akagonjolola liwoko lyake, ukava uponile ndakyene. <verse eid="MRK 3:5" /><verse number="6" style="v" sid="MRK 3:6" />Baho Mafalisayo vakahuma kwivala; vakapatine pamwinga na lipinga lya vanu va Helode, vakasakile namuna lya kumdocha Yesu.<verse eid="MRK 3:6" /></para>
  <para style="s">Lipinga lya vanu kung'umbu lya lihiva</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7" />Yesu pamwinga na vachulila vake vakahumile, vakahelela kung'umbu lya lihiva lya Galilaya, na lipinga likomi lya vanu kuhuma inyi lya Galilaya vivila vakamfuatile, <verse eid="MRK 3:7" /><verse number="8" style="v" sid="MRK 3:8" />Idumea, kumwambo lya mgoka Yolidani, Tilo na Sidoni. Vanu havo volofu vakamheleliye Yesu kwakuva vapulikige njowo cholofu cheagitile. <verse eid="MRK 3:8" /><verse number="9" style="v" sid="MRK 3:9" />Yesu akavalongie vachulila vake vavike unofu wato limwi, neke lipinga lya vanu libihile kumfuatila. <verse eid="MRK 3:9" /><verse number="10" style="v" sid="MRK 3:10" />Kwa kuva aponyile vatamwa volofu, na vatamwa vonda vakali vekwisung'a neke vapatile kumkolela. <verse eid="MRK 3:10" /><verse number="11" style="v" sid="MRK 3:11" />Na vanu vevali na mihoka pevamlole Yesu, vakaguwe panyi pautalo lyake na kutova kyowo vakilonga, “Veve ndi Mwana va Nguluvi.” <verse eid="MRK 3:11" /><verse number="12" style="v" sid="MRK 3:12" />Ila Yesu akavakanile mahoka vabihile kuvalongela vanu kuva mwene ni ani.<verse eid="MRK 3:12" /></para>
  <para style="s">Yesu akuvahagula vanjagila kumi na vavili</para>
  <para style="r">
    <ref loc="MAT 10:1-4">Matayo 10.1-4</ref>; <ref loc="LUK 6:12-16">Luka 6.12-16</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13" />Yesu akang'ie kidunda, akavakemela vala yehavakelye. Navo vakahelela, <verse eid="MRK 3:13" /><verse number="14" style="v" sid="MRK 3:14" />nave akavahaguwe vanu kumi na vavili ambawo yehavakemeliee vanjagila, neke vapate kuva pamwinga nave na kuvalagilicha kubita kudalika, <verse eid="MRK 3:14" /><verse number="15" style="v" sid="MRK 3:15" />na vaveche na umwimike va kuvadaga mihoka. <verse eid="MRK 3:15" /><verse number="16" style="v" sid="MRK 3:16" />Hava kumi na vavili yehavahaguwe nde hava: Simoni Yesu amkemelie Peteli, <verse eid="MRK 3:16" /><verse number="17" style="v" sid="MRK 3:17" />Yakobo na Yohani vana va Sebedayo Yesu avakemelie litawa Boanelige, mana lyake “Vana va Mdilimo.” <verse eid="MRK 3:17" /><verse number="18" style="v" sid="MRK 3:18" />Andelea na Filipo na Batolomeo na Matayo na Tomasi na Yakobo mwana va Alifayo na Tadayo na Simoni munu va Kanani na <verse eid="MRK 3:18" /><verse number="19" style="v" sid="MRK 3:19" />Yuda Isikaliyoti, yula yeamkanile Yesu.<verse eid="MRK 3:19" /></para>
  <para style="s">Yesu na Belizebuli</para>
  <para style="r">
    <ref loc="MAT 12:22-32">Matayo 12.22-32</ref>; <ref loc="LUK 11:14-23">Luka 11.14-23</ref>; <ref loc="LUK 12:10">12.10</ref></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20" />Pambele Yesu akawuye kukaye, lipinga lya vanu vilundise kangi, mbaka Yesu na vanjagila vake vakalemwile kuliya kyakula. <verse eid="MRK 3:20" /><verse number="21" style="v" sid="MRK 3:21" />Lukololo vake pevapatile njowo hicho vakehela kumnyamula kwakuva vanu vakali vakilonga, “Ana lukwale” <verse eid="MRK 3:21" /><verse number="22" style="v" sid="MRK 3:22" />Vawulanichi va malagicho vakali vihuma Payelusalemu vakalonga, “Uyu akali Belisebuli mkomi va mihoka! Kangi, akuvadaga lihoka kwa ludali lya mkomi va lihoka.” <verse eid="MRK 3:22" /><verse number="23" style="v" sid="MRK 3:23" />Yesu akavakemela, akavalongie kwa mifanu, “Setani avesa wuli kumdaga Setani” <verse eid="MRK 3:23" /><verse number="24" style="v" sid="MRK 3:24" />Ikiva ung'achale umwinga ugawanyike lipinga lipanga yakwipinga, ung'achale hugo wiguwa. <verse eid="MRK 3:24" /><verse number="25" style="v" sid="MRK 3:25" />Kangi, ikiva vanu va kaye yimwi vakigavanyika mipinga mipinga gehipinganila, kaye iyo ikwanangika. <verse eid="MRK 3:25" /><verse number="26" style="v" sid="MRK 3:26" />Na ngita, utavala va Setani ugavanyike mipinga mipinga seuvesa kwikala hilo ukwanangika. <verse eid="MRK 3:26" /><verse number="27" style="v" sid="MRK 3:27" />Pahela munu ye ivesa kwingila kukaye lya munu yeali na ludali na kumnyaga finu fyake, avange tandi kumuwopa munu huyo munya ludali, ipo ndeivesa kumnyaga finu fyake.<verse eid="MRK 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 3:28" />“Ndikuvalongela ndakyene, vanu vilekelwa sambi chawo chonda na malichwi gyonda gya kumliga Nguluvi. <verse eid="MRK 3:28" /><verse number="29" style="v" sid="MRK 3:29" />Ila yeyonda yeakumliga Muhe lya Nguluvi seilekelwa hamu, yeavecha na nongwa lya sambi lya mbepali.” <verse eid="MRK 3:29" /><verse number="30" style="v" sid="MRK 3:30" />Yesu akalongie ifyo kwa kuva vakali vilonga, “Yesu agehe na lihoka.”<verse eid="MRK 3:30" /></para>
  <para style="s">Maye na vakololo vake Yesu</para>
  <para style="r">
    <ref loc="MAT 12:46-50">Matayo 12.46-50</ref>; <ref loc="LUK 8:21">Luka 8.21</ref></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31" />Pambele vachile maye vake Yesu pamwinga na lukololo vake. Vakiwa vaimile kwivala, vakamlagicha munu amkemele. <verse eid="MRK 3:31" /><verse number="32" style="v" sid="MRK 3:32" />Lipinga likomi lya vanu likali limchungutile, vakamlongie, “Maye vako na vakololo vako vagehe kwivala, vakukemela.” <verse eid="MRK 3:32" /><verse number="33" style="v" sid="MRK 3:33" />Yesu akavauchile, “Maye vangu na vakololo vangu ndi ani?” <verse eid="MRK 3:33" /><verse number="34" style="v" sid="MRK 3:34" />Pambele akavalola vanu yevalimchungutila, akalonga, “Hava nde maye vangu na lukolo vangu. <verse eid="MRK 3:34" /><verse number="35" style="v" sid="MRK 3:35" />Munu yeyonda yeagitile yeakelie Nguluvi, uyu nde lukolo vangu na muhacha vangu na maye vangu.”<verse eid="MRK 3:35" /></para>
  <chapter eid="MRK 3" />
  <chapter number="4" style="c" sid="MRK 4" />
  <para style="s">Mufanu va mvyalaji mbeyu</para>
  <para style="r">
    <ref loc="MAT 13:1-9">Matayo 13.1-9</ref>; <ref loc="LUK 8:4-8">Luka 8.4-8</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1" />Yesu avangile kuwulanicha kangi mung'umbu lya lihiva lya Galilaya. Lipinga likomi lya vanu limchungutile mbaka akalamuwe kwingila mu wato na kukala mula. Vanu vonda vakali vakalile mulung'umbu lya lihiva lya Galilaya. <verse eid="MRK 4:1" /><verse number="2" style="v" sid="MRK 4:2" />Alivafundisa makani golofu kwa mifanu, kwa mawulanichi gyake alivalongela, <verse eid="MRK 4:2" /><verse number="3" style="v" sid="MRK 4:3" />“Mpulikiche! Munu yumwi mvyalaji mbeyu akahele kumicha mbeyu. <verse eid="MRK 4:3" /><verse number="4" style="v" sid="MRK 4:4" />Peagehe imicha mbeyu, chingi chikaguwe mung'asi, fidege fyachile fyaliye. <verse eid="MRK 4:4" /><verse number="5" style="v" sid="MRK 4:5" />Chingi chaguwe pa maganga pahela mganga wolofu, chikamelile kisatu, kwa kuva mganga ukali mdodo. <verse eid="MRK 4:5" /><verse number="6" style="v" sid="MRK 4:6" />Peliumile lichuwa, mimelo gikagama kwa kuva midadikwa gyake gikile hamu panyi. <verse eid="MRK 4:6" /><verse number="7" style="v" sid="MRK 4:7" />Mbeyu chingi chaguwe pa mibiki gya mihomi, mihomi igyo gikakulile na kukekenecha mimelo ifyo seihumiche mabenelo. <verse eid="MRK 4:7" /><verse number="8" style="v" sid="MRK 4:8" />Ila mbeyu chingi chikaguwe mumganga mnofu, chimelile unofu na kukula, chikahumicha mabenelo. Mbeyu yimwi ikahumiche mabenelo selasini na yingi ikahumiche mabenelo sitini na chingi chahumiche mabenelo mia yimwi!” <verse eid="MRK 4:8" /><verse number="9" style="v" sid="MRK 4:9" />Pambele Yesu akalonga, “Munu yeali na misigicha gya kupulikila na apulike!”<verse eid="MRK 4:9" /></para>
  <para style="s">Yesu kuhumulila mana lya mifanu</para>
  <para style="r">
    <ref loc="MAT 13:10-17">Matayo 13.10-17</ref>; <ref loc="LUK 8:9-10">Luka 8.9-10</ref></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10" />Yesu peagehe weka hela, vala vanu vevamchungulite, pamwinga na vachulila vake kumi na vavili, vakahelela kwa Yesu vakamuhucha njowo lwa mifanu gyake. <verse eid="MRK 4:10" /><verse number="11" style="v" sid="MRK 4:11" />Yesu kavalongela, “Nyenye mgavilwe umwimike va kuchela lupwepo lya Ung'achale va Nguluvi, ila vala yevagehe vilongelwa kila kinu kwa mifanu, <verse eid="MRK 4:11" /><verse number="12" style="v" sid="MRK 4:12" />neke, ‘Mbepali valole ndakyene, ila vabihile kulola, mbepali vapulike, ila vabihile kuchela, vakuwesa kumsedukila Nguluvi, na mwene ivesa kuvalekela sambi chawo.’”<verse eid="MRK 4:12" /></para>
  <para style="s">Yesu ahumulila mana lya uwanganicho va mvyalaji mbeyu</para>
  <para style="r">
    <ref loc="MAT 13:18-23">Matayo 13.18-23</ref>; <ref loc="LUK 8:11-15">Luka 8.11-15</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13" />Pambele Yesu akavaucha, “Mchele hamu mana lya uwanganicho ugu? Suwe, wuli damuwesa kuchela mifanu gingi? <verse eid="MRK 4:13" /><verse number="14" style="v" sid="MRK 4:14" />Mbeyu yeivyaliwe na munu yula yeivyala mbeyu ndi lichwi lya Nguluvi. <verse eid="MRK 4:14" /><verse number="15" style="v" sid="MRK 4:15" />Vanu vangi ndi ngita mbeyu yeigwilie mung'asi ambapo lichwi livyalilwe. Ila baho hela pevikulipulika lichwi, Setani ikwacha na kulihecha lichwi hilyo lelivyalilwe munumbula chawo. <verse eid="MRK 4:15" /><verse number="16" style="v" sid="MRK 4:16" />Vanu vangi ngita chila mbeyu chechigwilie pa maganga. Pevakulipulika lichwi, vipokela kwa kukeduka. <verse eid="MRK 4:16" /><verse number="17" style="v" sid="MRK 4:17" />Ila kwa kuva lila lichwi selikwingila na kuvika midadikwa munumbula gyawo, baho vaendelesa kwa muda mdodo. Na chipindi va magudo na chipindi va utumama peihumila kwakuva lya lila lichwi, baho hela vakulileka lichwi. <verse eid="MRK 4:17" /><verse number="18" style="v" sid="MRK 4:18" />Vanu vangi ndi ngita chila mbeyu chechigwilie pa mibiki gya mihomi. Hugo ndi vala vevipulika hilyo lichwi lya Nguluvi, <verse eid="MRK 4:18" /><verse number="19" style="v" sid="MRK 4:19" />Ila wogofi va inyi hugu kukela na kwikedusa yuve magudo ga inyi na kukela mno kuvecha na mali cholofu na kukekeneka hilyo navo sevibaba manunu. <verse eid="MRK 4:19" /><verse number="20" style="v" sid="MRK 4:20" />Ila vangi viwana na yila mbeyu chechivyalilwe pa mganga mnofu. Hava hulipulika lichwi lya Nguluvi, vakalipokela, vakababa manunu: Vangi selasini na vangi sitini na vangi miya.<verse eid="MRK 4:20" /></para>
  <para style="s">Kibatali kyekigubikwe</para>
  <para style="r">
    <ref loc="LUK 8:16-18">Luka 8.16-18</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21" />“Yesu endeliye kuvalongela, wuli kibatali kikwaswa na kugubika panyi lya kiviya awu panyi pa ulili? Be seiwaswa na kuvika pakyanya pa kisusu? <verse eid="MRK 4:21" /><verse number="22" style="v" sid="MRK 4:22" />Na kinu kyokyonda kyekifiilwe kiwoneka, na kinu kyekigubikwe kigubitulwa. <verse eid="MRK 4:22" /><verse number="23" style="v" sid="MRK 4:23" />Munya masigicha gya kupulika na apulike.”<verse eid="MRK 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24" />Yesu akavalongela kangi, “Mpulike unofu gyempulika muhinga gila gwemwitumila kuva vingila vayenu nde hikyo hikyo kyekitumilwa kuvahinga piya kangi mwilutichilwa hilo. <verse eid="MRK 4:24" /><verse number="25" style="v" sid="MRK 4:25" />Kwakuva yeali na kinu iongelechelwa, nave seinakyo kinu, hata kila kidodo kyeinakyo inyagwa.”<verse eid="MRK 4:25" /></para>
  <para style="s1">Mufanu va mbeyu yeimela na kukula</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26" />Yesu endelie kulonga, “Ung'achale va Nguluvi ndi ngita, munu yeivyala mbeyu pa mgunda. <verse eid="MRK 4:26" /><verse number="27" style="v" sid="MRK 4:27" />Peamalile kuvyala, peali avasile au agehe meho, na chipindi hugo mbeyu imela na kukula. Mweni seichela mbeyu peimela na kukula. <verse eid="MRK 4:27" /><verse number="28" style="v" sid="MRK 4:28" />Mganga uwene huugita umele mimelo kukula na kubaba manunu, livanga likwati kumela, kangi lisina, pambele lihocho. <verse eid="MRK 4:28" /><verse number="29" style="v" sid="MRK 4:29" />Mapemba pegakangie, yula munu uvanga kubena kwa kikwakwa kya kubenela mabenelo, kwa kuva chipindi va kubena ufikile.” <figure style="fig" file="12 Sickle.jpg" size="col" ref="4.29">Munu ibena kwa kikwaka</figure><verse eid="MRK 4:29" /></para>
  <para style="s">Mfanu va mbeyu lya libiki lyelikemelwa Haladali</para>
  <para style="r">
    <ref loc="MAT 13:31">Matayo 13.31</ref>,<ref loc="MAT 13:32">32</ref>; <ref loc="LUK 13:18-19">Luka 13.18-19</ref></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30" />Yesu akavalongie kangi, “Ung'achale va Nguluvi uwana na kinu liki? Tuhumulile kwa mufanu liki? <verse eid="MRK 4:30" /><verse number="31" style="v" sid="MRK 4:31" />Iwanine ngita mbeyu lya haladali ambalyo nde ndodondodo kuchumba mbeyu chonda chechivyalwa pa mganga. <verse eid="MRK 4:31" /><verse number="32" style="v" sid="MRK 4:32" />Peisindilwe kuvyalwa, imela na kuva mmelo mkomi kuchumba mimelo gyonda gya pamgunda. Kangi mimagwa gyake mikomi mbaka fidege vichenga fyaso fyawo pa mimagwa gyake.” <verse eid="MRK 4:32" /><verse number="33" style="v" sid="MRK 4:33" />Yesu alivadalikila unanzi vake kwa mifanu gingi gyongofu gya namuna hilyo; Kaywanga navo namuna pevavesile kupulika. <verse eid="MRK 4:33" /><verse number="34" style="v" sid="MRK 4:34" />Sealongile navo lichwi lyolyonda bila kutumila mifanu; ila peagehe weka pamwinga na vachulila vake, alivalongela mana lya kila mifanu.<verse eid="MRK 4:34" /></para>
  <para style="s">Yesu epolecha lidaba</para>
  <para style="r">
    <ref loc="MAT 8:23-27">Matayo 8.23-27</ref>; <ref loc="LUK 8:22-25">Luka 8.22-25</ref></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35" />Kigono kikila palumie, Yesu avalongie vachulila vake, “Tuagame tuhelele kumwambo lya lihiva.” <verse eid="MRK 4:35" /><verse number="36" style="v" sid="MRK 4:36" />Suwe, vakaleka lila lipinga lya vanu, Vachulila vakaingile muwato peagehe Yesu vakahelela pamwinga. Fifila miwato gingi gimfuatile. <verse eid="MRK 4:36" /><verse number="37" style="v" sid="MRK 4:37" />Suwe, likala likomi likavanga kupuga, madaba gakaitove ula wato likavanga kuingicha malenga mugati muwato.<figure style="fig" file="09 Boat in Storm.jpg" size="col" ref="4.37">Madaba gautova wato</figure> <verse eid="MRK 4:37" /><verse number="38" style="v" sid="MRK 4:38" />Yesu akali kumbele muwato, akiva agonile pakyanya lya msegamo. Vachulila vake vakamlamuse na kumlongela, “Muwulanichi, seulola kuva nefwe twisaka kufua?” <verse eid="MRK 4:38" /><verse number="39" style="v" sid="MRK 4:39" />Yesu akalamwike, akalikanie ula likala na kuyalongela madaba, “Chike! Leke” Baho lukala gikachikila na kukasigala jii. <verse eid="MRK 4:39" /><verse number="40" style="v" sid="MRK 4:40" />Pambele Yesu akavalongie vachulila vake, “Wuli mwikogopa? Be, mwave mwihela mbatwa hela?” <verse eid="MRK 4:40" /><verse number="41" style="v" sid="MRK 4:41" />Navo vakakogwipe mno, vakava vekwihucha, “Uyu ani? Hata lukala na madaba gikumpulika!”<verse eid="MRK 4:41" /></para>
  <chapter eid="MRK 4" />
  <chapter number="5" style="c" sid="MRK 5" />
  <para style="s">Yesu akumnanicha munu munya lihoka</para>
  <para style="r">
    <ref loc="MAT 8:28-34">Matayo 8.28-34</ref>; <ref loc="LUK 8:26-36">Luka 8.26-36</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1" />Yesu na vachulila vake vakahagame kumwambo lya lihiva lya Galilaya, pa inyi lya Vagelasi. <verse eid="MRK 5:1" /><verse number="2" style="v" sid="MRK 5:2" />Baho Yesu peikile muliwato, katang'ana na munu yeaumile kumgunda lya Nguluvi. Uyu munu akali na lihoka. <verse eid="MRK 5:2" /><verse number="3" style="v" sid="MRK 5:3" />Munu uyo figono fyonda akali akwikala kumgunda va Nguluvi vala kuhela munu yeivesa kangi kumuhopa ata kwa ndegei cha kyuma. <verse eid="MRK 5:3" /><verse number="4" style="v" sid="MRK 5:4" />Kwa figono fyolofu vakali vakumuhopa pingu mumawoko na magulu kwa ndegei cha kyuma, ila akali akichidumu. Na pakali kwahela munu yeali na ludali lya kumkanila. <verse eid="MRK 5:4" /><verse number="5" style="v" sid="MRK 5:5" />Pamunyi na pamie akali akwikala kumgunda va Nguluvi na pafidunda, na kutova kyowo na akwiketulaketula na miganga. <verse eid="MRK 5:5" /><verse number="6" style="v" sid="MRK 5:6" />Peamuonile Yesu kwa kutali, akamnyilie, na kumfugamila pautalo pake, <verse eid="MRK 5:6" /><verse number="7" style="v" sid="MRK 5:7" />kamkemela kwa lichwi likomi akilonga, “Yesu, Mwana va Nguluvi yeagehe kukyanya mno! Ukela liki kwa nene? Ndikusuka Kwa litawa lya Nguluvi, bihile kuniguda!” <verse eid="MRK 5:7" /><verse number="8" style="v" sid="MRK 5:8" />Kwakuva Yesu akali amlongile, “Veve lihoka, muhege munu uyu!” <verse eid="MRK 5:8" /><verse number="9" style="v" sid="MRK 5:9" />Pambele Yesu akamuhucha, “Litawa lyako ani?” Akamhigile, “Litawa lyangu, ‘Lipinga’ Kwakuva twigehe volofu.” <verse eid="MRK 5:9" /><verse number="10" style="v" sid="MRK 5:10" />Pambele endeliye kumsuka Yesu abihile kuvadaga avo mihoka mu inyi yila. <verse eid="MRK 5:10" /><verse number="11" style="v" sid="MRK 5:11" />Pepi na baho pakali na lipinga likomi lya vangubi vikwamilwa pa ligema lya kidunda vakali vakuli. <verse eid="MRK 5:11" /><verse number="12" style="v" sid="MRK 5:12" />Suwe, havo mihoka vakamsuka Yesu vakilonga, “Utusindike kwa vangubi hava na utuleke tuvaingile.” <verse eid="MRK 5:12" /><verse number="13" style="v" sid="MRK 5:13" />Yesu akavahamulise na mihoka vakamuhumile yula munu na vakavaingie vala vangubi. Lipinga lyonda lya vangubi elufu chivili viikile pa lingema hadi pa lihiva viingie mu malenga na vafuwe. <verse eid="MRK 5:13" /><verse number="14" style="v" sid="MRK 5:14" />Vanu vevali vikwamila vala vagubi vakanyila, na kuvalongela vanu njowo chila, mumwani na kumgunda. Vanu vakahelela kulola gila gyegihumie. <verse eid="MRK 5:14" /><verse number="15" style="v" sid="MRK 5:15" />Vakafikile Yesu, vamuonile munu yula yeakali na fipuga lya mihoka ekalile panyi, afwalile myenda gyake na luhala lyake umuwuyile, vanu vonda vakahogwipe. <verse eid="MRK 5:15" /><verse number="16" style="v" sid="MRK 5:16" />Vanu yevawonile njowo lula, vakavalongie vanu vangi njowo lwelumuhumie munu yula yeakali na mihoka na njowo cha vagubi vala. <verse eid="MRK 5:16" /><verse number="17" style="v" sid="MRK 5:17" />Suwe vanu vakavanga kumsuka Yesu ahege pa inyi lyawo. <verse eid="MRK 5:17" /><verse number="18" style="v" sid="MRK 5:18" />Yesu peakali akang'ala muwato, munu yula yeakali na mihoka kamsuka Yesu ahelele pamwinga nave. <verse eid="MRK 5:18" /><verse number="19" style="v" sid="MRK 5:19" />Ila Yesu kamkanila. Na kumlongela, “Helele kukaye kwa vakolo vako na kuvalongela njowo chonda cheakugitile Mtwa na namuna peakuonile lusungu.” <verse eid="MRK 5:19" /><verse number="20" style="v" sid="MRK 5:20" />Suwe, munu yula akahelele, akavanga kuhumulila njowo chonda cheamgitile Yesu ukoya Dekapoli mana lyake inyi gyenye mwani kumi. Na vanu vonda vakadudwive.<verse eid="MRK 5:20" /></para>
  <para style="s">Yesu akumuponya muhinja va Yailo na mdala yumwi</para>
  <para style="r">
    <ref loc="MAT 9:18-26">Matayo 9.18-26</ref>; <ref loc="LUK 8:40-56">Luka 8.40-56</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21" />Yesu peahagame kangi paubali lwa pili lya lihiva lya Galilaya kwa wato. Lipinga likomi lya vanu palutalo lyake, nave akava ahemile mung'umbu lya lihiva. <verse eid="MRK 5:21" /><verse number="22" style="v" sid="MRK 5:22" />Munu yumwi yekali mkomi va kaye lya kutang'anila Vayawudi, litawa lyake Yailo, akahelela kumlola Yesu, peamuonile Yesu, akafugamile pautalo lyake, <verse eid="MRK 5:22" /><verse number="23" style="v" sid="MRK 5:23" />akamsuka Yesu akilonga, “Muhinja vangu mtamwa epepi kufuwa. Chondi tuhelele, ukamvikile liwoko lyako, neke apatile kuponila na kwikala.” <verse eid="MRK 5:23" /><verse number="24" style="v" sid="MRK 5:24" />Suwe, Yesu akahelela pamwinga na Yailo. Vanu volofu mno ukamfuatila, vakali vakumkekeneka kila lubali. <verse eid="MRK 5:24" /><verse number="25" style="v" sid="MRK 5:25" />Baho pakali na mdala yumwi yeakali na utamwa va luholovela kwa myaka kyumi na givili. <verse eid="MRK 5:25" /><verse number="26" style="v" sid="MRK 5:26" />Mdala uyo akali agudile hilo kuhelela kwa vaganga volofu. Na kusinda mali chake chonda, ila aponile hamu, ila endelie kutamika hilo. <verse eid="MRK 5:26" /><verse number="27" style="v" sid="MRK 5:27" />Akali apulikile njowo lya Yesu, akachumbile lukekeno lya vanu kuhuma ku mbele, na kukolela mwenda gya Yesu, <verse eid="MRK 5:27" /><verse number="28" style="v" sid="MRK 5:28" />kwakuva elongie munumbula lyake yumwene, “Ngita ndivesa kubyalisa mwenda vake, dandinana.” <verse eid="MRK 5:28" /><verse number="29" style="v" sid="MRK 5:29" />Peabyalise mwenda va Yesu, luholovela ikalekile kuhuma na mwene awonile mvili vake uponile. <verse eid="MRK 5:29" /><verse number="30" style="v" sid="MRK 5:30" />Bahobaho Yesu achele kuva ludali chake chimponyile munu. Suwe akausedukila wula lipinga lya vanu, akaucha, “Ndi ani yeabyalise mwenda gyangu?” <verse eid="MRK 5:30" /><verse number="31" style="v" sid="MRK 5:31" />Vachulila vake vakamuhigile, “Wiwona kuva vanu vakwikeng'eneka, wuli wiucha ndi ani yeakubyalise?” <verse eid="MRK 5:31" /><verse number="32" style="v" sid="MRK 5:32" />Ila Yesu endelie kulola neke amlole nde ani yeabyalise. <verse eid="MRK 5:32" /><verse number="33" style="v" sid="MRK 5:33" />Mdala yula achele njowo chechimuhumie, iwonise kuno itetema kwa wogofi, afugamile pautalo pa Yesu na kumlongela undakyene vonda. <verse eid="MRK 5:33" /><verse number="34" style="v" sid="MRK 5:34" />Yesu kamlongela, “Muhinja vangu, mbatwa lyako ikuponyile. Helele kwa utengamaso, na uponile hilo utamwa vako.” <verse eid="MRK 5:34" /><verse number="35" style="v" sid="MRK 5:35" />Yesu pehave eywanga, vachile vanu kuhuma kaya lya Yailo, mkomi va kaye kukutanila Vayawudi. Vakamlongie Yailo, “Muhinja vako afue suwe. Wuli wikwendelela kumusumbula Muwulanichi?”<verse eid="MRK 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 5:36" />Ila Yesu peapulike gevaywangile akabedile, Akamlongiye yula mkomi va kaye lya kutang'ala Vayawudi, “Bihile kwogopa, mbatwa hela.” <verse eid="MRK 5:36" /><verse number="37" style="v" sid="MRK 5:37" />Yesu akavalongela kuhela munu yeyonda kulongocha na mwene, ila Peteli na Yakobo na Yohani na lukolo vake Yakobo. <verse eid="MRK 5:37" /><verse number="38" style="v" sid="MRK 5:38" />Pevafikile kaya kwa Yailo yumwi vakomi va kaye lya kutang'anila Vayawudi, Yesu awene kudadavila akapulike vanu vivemba na kukivilicha. <verse eid="MRK 5:38" /><verse number="39" style="v" sid="MRK 5:39" />Yesu akaingila mugati, akavalongela, “Wuli mwigita madadavila na kuvemba? Mwana seafue ila avasile hela!” <verse eid="MRK 5:39" /><verse number="40" style="v" sid="MRK 5:40" />Ila vene vamuhekile kwakubeda, ila mwene akavahumicha vonda kwivala. Kavanyamula daada na maye va mwana yula, pamwinga na vachulila vake vadatu, vakaingila mugati yeagehe mwana yula. <verse eid="MRK 5:40" /><verse number="41" style="v" sid="MRK 5:41" />Yesu akaukolela liwoko lya mwana yula, akamlongie, “Talitha, komu!” Mana lyake, “Muhinja, ndikulongela, lamwike!” <verse eid="MRK 5:41" /><verse number="42" style="v" sid="MRK 5:42" />Bahala pala muhinja yula akalamwike na kuvanga kugendagenda. Muhinja yula akali na myaka kumi na givili. Vanu pegavawonile hago vadudwive hilo. <verse eid="MRK 5:42" /><verse number="43" style="v" sid="MRK 5:43" />Ila Yesu kavakanila vabihile kumlongela munu yeyonda njowo hichi chechihumile. Pambele kavalongela, “Mgavile muhinja yula kyakula.”<verse eid="MRK 5:43" /></para>
  <chapter eid="MRK 5" />
  <chapter number="6" style="c" sid="MRK 6" />
  <para style="s">Yesu ikanwa ukoya Nasaleti</para>
  <para style="r">
    <ref loc="MAT 13:53-58">Matayo 13.53-58</ref>; <ref loc="LUK 4:16-30">Luka 4.16-30</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1" />Yesu akahegile pala, akahelela pa kijiji kyake, vachulila vake vakamfuatila. <verse eid="MRK 6:1" /><verse number="2" style="v" sid="MRK 6:2" />Peifikile kigono kya kutulula, alivanga kwimbisa pa kaye lya kutang'anila Vayawudi. Vanu yevakali vekumpulika vaduduvalile, vakilonga, “Apatila kwii fyonda ifi? Uginyange liki yeagevilwe? Avesa wuli kugita umunyitu haga? <verse eid="MRK 6:2" /><verse number="3" style="v" sid="MRK 6:3" />Uyu muhongola finu fya mibiki hamu? Mwana va Maliamu, na vakolo vake vakina Yakobo na Yusufu na Yuda na Simoni? Na vahachave vake vakwikala bahala ipa?” Suwe, vakanile kumwidikila. <verse eid="MRK 6:3" /><verse number="4" style="v" sid="MRK 6:4" />Yesu kavalongela, “Mviichi hupulikwa konda seivecha seiginya pa inyi lyake na kwa vakolo vake na kaye lyake.” <verse eid="MRK 6:4" /><verse number="5" style="v" sid="MRK 6:5" />Yesu seavesile kugita umunyitu vovonda ukoya seivecha akavika mawoko gyake vatamwa na kuvaponya vatamwa sevolofu. <verse eid="MRK 6:5" /><verse number="6" style="v" sid="MRK 6:6" />Yesu akadudwive mno kwa kuva vandu seviidikie.</para>
  <para style="s" vid="MRK 6:6">Yesu akuvalagicha vachulila vake kumi na vavili</para>
  <para style="r" vid="MRK 6:6">
    <ref loc="MAT 10:5-15">Matayo 10.5-15</ref>; <ref loc="LUK 9:1-6">Luka 9.1-6</ref></para>
  <para style="p" vid="MRK 6:6">Pambele Yesu akafigendelie fijiji fya pepi, akiva akuvafundisa vanu. <verse eid="MRK 6:6" /><verse number="7" style="v" sid="MRK 6:7" />Kavakemela vala vachulila kumi na vavili, akavanga kuvalagicha vavili va vavili. Akavagavila umwimike va kuvadaga mihoka. <verse eid="MRK 6:7" /><verse number="8" style="v" sid="MRK 6:8" />Akavalagiche akavalongela, “Mbihile kutegula kinu chochonda mung'asi, seiveche lusaga ng'ani. Mbihile kutegula libumunda, vala muhako, vala sendi. <verse eid="MRK 6:8" /><verse number="9" style="v" sid="MRK 6:9" />Mfwale mikobasi ila mbihile kunyamula myenda gingi.” <verse eid="MRK 6:9" /><verse number="10" style="v" sid="MRK 6:10" />Kangi akavalongela, “Pemwingila kaye lyolyonda, mwikale ipo bila kuhegahega mbaka pemwihega pono ipo. <verse eid="MRK 6:10" /><verse number="11" style="v" sid="MRK 6:11" />Na pono poponda vanu pevalema kuvakalibisa awu kuvapulika, muhege na mupumune lifuna mumagulu gyenu, kuva usaidi kwa vene.” <verse eid="MRK 6:11" /><verse number="12" style="v" sid="MRK 6:12" />Suwe, vakahega na kuvadalikia vanu neke vanu vahongeche na kuchileka sambi chawo. <verse eid="MRK 6:12" /><verse number="13" style="v" sid="MRK 6:13" />Vakahumiche mihoka gyolofu na kuvabaka mafuta gya msaituni vatamwa volofu na vakavaponyile.<verse eid="MRK 6:13" /></para>
  <para style="s">Kufua kwa Yohani mbatisaji</para>
  <para style="r">
    <ref loc="MAT 14:1-12">Matayo 14.1-12</ref>; <ref loc="LUK 9:7-9">Luka 9.7-9</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14" />Suwe, ng'achale Helode akapulika njowo hicho chonda, kwakuva njowo cha Yesu chikalutale pono ponda. Vanu vangi vakali valonga, “Yohani mbatisaji achulubuke! Ndi kwa kuva aveche na ludali lya kugita umunyitu ugi.” <verse eid="MRK 6:14" /><verse number="15" style="v" sid="MRK 6:15" />Ila volofu valongile, “Munu uyu nde Elia.” Vangi vilongile, “Uyu nde Mvichi ngita yumwinga vala vavichi va daha.” <verse eid="MRK 6:15" /><verse number="16" style="v" sid="MRK 6:16" />Ila Helode peapulike njowo hicho akalonga, “Uyu nde Yohani mbatisa! Yendimudumule mutuwe, ila achulubuke!” <verse eid="MRK 6:16" /><verse number="17" style="v" sid="MRK 6:17" />Pamwandi ipo Helode mwene akalagicha kuva Yohani mbatisaji abatwe na kudindilwa mukifungo. Agitile ifyo kwakuva amtolile Helodia yeali mdala va Filipo ambaye lukolo va Helode. <verse eid="MRK 6:17" /><verse number="18" style="v" sid="MRK 6:18" />Yohani akali amlongie Helode, “Seunofu kumtola mdala va lukololo vako!” <verse eid="MRK 6:18" /><verse number="19" style="v" sid="MRK 6:19" />Ndeni, Helodia akamvipie mno Yohani, akasakile kumdocha, ila seavesile kumdocha. <verse eid="MRK 6:19" /><verse number="20" style="v" sid="MRK 6:20" />Helode amwogwipe Yohani akichele kuva munu msanji na mng'alili, suwe akali akumdima. Akava ikela kumpulikicha Yohani, ingava amalile kumpulikicha, agudile hilo munumbula lyake. <verse eid="MRK 6:20" /><verse number="21" style="v" sid="MRK 6:21" />Kigono kimwi Helodiya apatile nafwasi pa lihungu lya kuwikwa kubabwa kwa Helode. Kigono hikyo Helode akavagitile lihungu vatavala vake, na vakomi va vapuga vake na filongosi va inyi lya Galilaya. <verse eid="MRK 6:21" /><verse number="22" style="v" sid="MRK 6:22" />Muhinja va Helodia peaingile kukina, akakina unofu mno, Helode na vagenji vake vakakedukile mno. Suwe ng'achale akamlongie yula muhinja, “Suke kinu kyokyonde kyewikela, nene ndikugavila.” <verse eid="MRK 6:22" /><verse number="23" style="v" sid="MRK 6:23" />Kangi akamlapie, “Kyokyonda kyeukunisuka ndikugavila, hata ikiva nusu lya ung'achale vangu!” <verse eid="MRK 6:23" /><verse number="24" style="v" sid="MRK 6:24" />Baho yula muhinja akahuma kwivala akahele kumuwucha maye vake, “Ndisuke liki?” Maye vake akamhigile, “Suke lituwe lya Yohani Mbatisa.” <verse eid="MRK 6:24" /><verse number="25" style="v" sid="MRK 6:25" />Baho yula muhinja akamuwulie ng'achale akamlongie, “Ndikela unigavile salaisi mutuwe lya Yohani Mbatisa paluhelo!” <verse eid="MRK 6:25" /><verse number="26" style="v" sid="MRK 6:26" />Ng'achale akasugime mno, ila kwakuva ilapile pautalo lya vagenji vake, alemwile kumkanila. <verse eid="MRK 6:26" /><verse number="27" style="v" sid="MRK 6:27" />Ng'achale akamlagicha mpuga akanyamule lituwe lya Yohani Mbatisa. Mpuga akahelela kumdumula Yohani Mbatisa lituwe mula mukifungo. <verse eid="MRK 6:27" /><verse number="28" style="v" sid="MRK 6:28" />Mpuga yula akakiletile lituwe lila muluhelo, akamgavila yula muhinja, mwene kamgavila maye vake. <verse eid="MRK 6:28" /><verse number="29" style="v" sid="MRK 6:29" />Vachulila va Yohani Mbatisa pevapulikile lukaini lula, vakahelela kuunyamula mviili vake na kuusila.<verse eid="MRK 6:29" /></para>
  <para style="s">Yesu avalisile kyakula vanu elufu chianu</para>
  <para style="r">
    <ref loc="MAT 14:13-21">Matayo 14.13-21</ref>; <ref loc="LUK 9:10-17">Luka 9.10-17</ref>; <ref loc="JHN 6:1-4">Yohani 6.1-4</ref></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30" />Vala vanjagila vakawuya vatang'ine na Yesu, vakamlongiye fyonda fyevagitile na kuwulanicha. <verse eid="MRK 6:30" /><verse number="31" style="v" sid="MRK 6:31" />Yesu akavalongiye, “Tuhelele weka hela kyamfiyo, mkatulule ludodo.” Alongile ndeni kwakuva kukali na vanu volofu hilo vangi vakwacha bahala pala na kuhega, mbaka Yesu na vachulila vake ata se vapatile nafwasi lya kuliya kyakuliya. <verse eid="MRK 6:31" /><verse number="32" style="v" sid="MRK 6:32" />Suwe, vakahegile vavene kwa wato, vahelela pakifiyo. <verse eid="MRK 6:32" /><verse number="33" style="v" sid="MRK 6:33" />Hata ifyo vanu vakavawene pevahega, vakachela. Suwe, vakahelela kwa magulu kuhuma kila mwani na vakalongue kufika. <verse eid="MRK 6:33" /><verse number="34" style="v" sid="MRK 6:34" />Yesu peikile muwato, akaliwene lipinga likomi lya vanu. Avawonie lusungu kwakuva vakali ngita kondolo vahela mdimaji. Ndena akavanga kuvawulanicha makani gyongofu. <verse eid="MRK 6:34" /><verse number="35" style="v" sid="MRK 6:35" />Palumie peifikile, vachulila va Yesu vakamuhelelie na kumlongela, “Poono ipa pakudasi na nalichuwa lidibala. <verse eid="MRK 6:35" /><verse number="36" style="v" sid="MRK 6:36" />Uvaleke vanu vahelele kumigunda na pafijiji fya pepi vakajigulile kyakula.” <verse eid="MRK 6:36" /><verse number="37" style="v" sid="MRK 6:37" />Ila Yesu avalongie, “Muvagavile nyenye kyakula.” Navo vakamuhuchile, Be! “Seulola kuva twitakilwa kuvecha na sendi cholofu cha kuvagulila vanu ava kyakula?” <verse eid="MRK 6:37" /><verse number="38" style="v" sid="MRK 6:38" />Yesu akavahucha, “Mwinagyo mibumunda milinga? Muhelele tandi mkailole.” Pevalolile, vakamwigile, “Gigehe mibumunda chianu na somba vavili hela.” <verse eid="MRK 6:38" /><verse number="39" style="v" sid="MRK 6:39" />Suwe, Yesu akavalagiche vachulila vake vavalongele vanu vonda vakale mulipinga lipinga, vakale panyi pa misoli. <verse eid="MRK 6:39" /><verse number="40" style="v" sid="MRK 6:40" />Suwe, vanu vakakala mufipinga fipinga gya vanu miya yimwi na gya vanu hamusini. <verse eid="MRK 6:40" /><verse number="41" style="v" sid="MRK 6:41" />Pambele Yesu kainyamula mibumunda gila mihanu na somba vavili. Kalola kuluhano, akahongecha na kugifunya na kuiketula gila mibumunda. Pambele kavagavila vachulila vake neke vavagavile vanu vonda. Na vala somba vavili wavagavile vanu vonda. <verse eid="MRK 6:41" /><verse number="42" style="v" sid="MRK 6:42" />Vanu vonda vakalie na kwiguta. <verse eid="MRK 6:42" /><verse number="43" style="v" sid="MRK 6:43" />Vachulila va Yesu vakaholasa fibumunda na fisomba gyesigile vaka memecha findilo kumi na chivili. <verse eid="MRK 6:43" /><verse number="44" style="v" sid="MRK 6:44" />Vanu vonda vewaliye vagosi vakali elufu chianu, se vavalilwe vadala na vana.<verse eid="MRK 6:44" /></para>
  <para style="s">Yesu igenda pakyanya pa malenga</para>
  <para style="r">
    <ref loc="MAT 14:22-23">Matayo 14.22-23</ref>; <ref loc="JHN 6:15-21">Yohani 6.15-21</ref></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45" />Baho Yesu akavalagicha vachulila vake vaingiye muwato, valongole kuhelela kumwambo lya lihiva Betisaida. Chipindi mwene akulilaga lila lipinga lya vanu. <verse eid="MRK 6:45" /><verse number="46" style="v" sid="MRK 6:46" />Peamalile kuvalaga, akahelela pakidunda kumsuka Nguluvi. <verse eid="MRK 6:46" /><verse number="47" style="v" sid="MRK 6:47" />Palumiye peifikile, wato ugehe pagati lya lihiva, mwene akali weka hela kumwambo lya lihiva. <verse eid="MRK 6:47" /><verse number="48" style="v" sid="MRK 6:48" />Suwe kavawonile vachulila vake vekuang'anika kuguba muwato kwa ludali, kwa kuva lukala ukali ukuvatova. Pepi kukiya, Yesu akavahelelea vachulila vake kuno akigenda pakyanya lya malenga. Akasakile kuvachumba. <verse eid="MRK 6:48" /><verse number="49" style="v" sid="MRK 6:49" />Navo pevamuonile igenda pakyanya lya malenga, vakachelile lingasaga, vakatovile kyowo. <verse eid="MRK 6:49" /><verse number="50" style="v" sid="MRK 6:50" />Kwakuva vonda pevamwonile vakaogwipe mno. Baho Yesu akavalongie, “Muchike, ndi nene, mbihile kwogopa.” <verse eid="MRK 6:50" /><verse number="51" style="v" sid="MRK 6:51" />Baho kaingila muwato pevagehe vachulila vako, na lukala ukachikile, vachulila vake vakekang'ise mno, <verse eid="MRK 6:51" /><verse number="52" style="v" sid="MRK 6:52" />kwakuva vakali sevachele mana lya kuvagavila mibumunda gila valie vanu elufu chihanu, luhala lwao lukali have kukisi.<verse eid="MRK 6:52" /></para>
  <para style="s">Yesu akumnanicha vatamwa kula Genesaleti</para>
  <para style="r">
    <ref loc="MAT 14:34-36">Matayo 14.34-36</ref></para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53" />Vakaagama lihiva, vakafikila pa inyi lya Genesaleti, vakauwopile wato kwa ndegeyi neke libihile kuhelela na malenga. <verse eid="MRK 6:53" /><verse number="54" style="v" sid="MRK 6:54" />Peviikile muwato, baho vanu vakamchele Yesu. <verse eid="MRK 6:54" /><verse number="55" style="v" sid="MRK 6:55" />Suwe, vakachungutile kisatu pa inyi lyonda, na kuvanga kuvanyamula vatamwa vavasile pakitefu gyawo na kuvasindika pono poponda pevapulike kuva Yesu agehe. <verse eid="MRK 6:55" /><verse number="56" style="v" sid="MRK 6:56" />Kila pono Yesu peahele, kufijiji na pamwani awu pamigunda, vanu vakavavikile vatamwa pafivanja. Vakamsuka avaleke vabyalise lukanji lya mwenda gwake. Nawo vevabyalise vakananile.<verse eid="MRK 6:56" /></para>
  <chapter eid="MRK 6" />
  <chapter number="7" style="c" sid="MRK 7" />
  <para style="s">Mafundiso gya vagogolo</para>
  <para style="r">
    <ref loc="MAT 15:19">Matayo 15.19</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1" />Vafalisayo pamwinga na Vawulanichi va malagicho vevahumile pa Yelusalemu vilundisile pautalo pa Yesu. <verse eid="MRK 7:1" /><verse number="2" style="v" sid="MRK 7:2" />Vakavawene vangi va vachulila vake vakulia kyakula kwa mawoko, bila kukalava ngita itakive na malagicho ga Vayawudi.<verse eid="MRK 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 7:3" />Kwakuva Vafalisayo na Vayawudi vonda sevilia kyakula mbaka vakalave mawoko gyawo mbaka pa kisugulumbi, ngita pevagitile vagogolo vawo. <verse eid="MRK 7:3" /><verse number="4" style="v" sid="MRK 7:4" />Kangi pivihuma kusoko sevivesa kulia kinu kyekyonda bila kukalava mawoko gyawo. Kangi kugehe na mila chingi cholofu chevakuchifuata ngita chila cha kuhogoficha fikombe, fiviya na fyombo fya kyuma.<verse eid="MRK 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5" />Suwe, Vafalisayo na vawulanichi va malagicho vakamuhucha Yesu, “Wuli vachulila vako sevafuatila mila cha vagogolo vetu, ila vene vekulia bila kukalava mawoko?”<verse eid="MRK 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6" />Yesu akavahigile, “Mvichi Isaya alongile undakyene pealagule kukyanya yenu nyenye vafyangu, ngita peandikile, Nguluvi ilonga ‘Vanu ava vekuniginya kwa milomo gyawo, ila numbula chawo chigehe kutali na nene. <verse eid="MRK 7:6" /><verse number="7" style="v" sid="MRK 7:7" />Kugundamila kwavo kwahofyo, kwakuva vewulanicha malagilicho gya vanu na kulonga kuva malagilicho gya Nguluvi!’<verse eid="MRK 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 7:8" />“Nyenye muleka Malagilicho gya Nguluvi na mukolela malagilicho gya vanu.”<verse eid="MRK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9" />Yesu akagendelie kulonga, “Nyenye munalyo namuna lya luhala mnofu lya kuleka malagilicho gya Nguluvi, neke mwikolela malagilicho gyenu. <verse eid="MRK 7:9" /><verse number="10" style="v" sid="MRK 7:10" />Kwakuva Musa alongile, ‘Vaginye dadi vako na maye vako na munu yeyonda yeakumliga daada awu maye vake adochwe.’ <verse eid="MRK 7:10" /><verse number="11" style="v" sid="MRK 7:11" />Ila nyenye mwilonga, ngita munu yeali na kinu kya kumtanga daada awu mamiye, ila akilonga kinu hiki, Kolibani mana lyake, kihumichwe kwa Nguluvi, <verse eid="MRK 7:11" /><verse number="12" style="v" sid="MRK 7:12" />suwe mwihocha munu uyo seivesa kumtanga daada awu mamiye. <verse eid="MRK 7:12" /><verse number="13" style="v" sid="MRK 7:13" />Suwe mwibeda lichwi lya Nguluvi kwakuva lya mawulanichi gyenu mwifundisila. Kangi mwigita finu fyolofu gya namuna iyo.”<verse eid="MRK 7:13" /></para>
  <para style="s">Makani gegikumgita munu abihile kwidikilwa kwa Nguluvi</para>
  <para style="r">
    <ref loc="MAT 15:10-20">Matayo 15.10-20</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14" />Yesu kalikemela kangi lipinga lila lya vanu akavalongela, “Munipulike vonda na mchele. <verse eid="MRK 7:14" /><verse number="15" style="v" sid="MRK 7:15" />Kuhela kinu kimwingila munu kivesa kumgita kuva seidikilwa pautalo pa Nguluvi. Ila kinu kyekimuhumila munu nde kikumgita seidikilwe pautalo pa Nguluvi.” <verse eid="MRK 7:15" /><verse number="16" style="v" sid="MRK 7:16" />Munu yeali na misigicha gya kupulikila na apulike! <verse eid="MRK 7:16" /><verse number="17" style="v" sid="MRK 7:17" />Peaulekile lila lipinga lya vanu na kwikingila mugati, vachulila vake vakamuhucha mana lya uwanganicho wula. <verse eid="MRK 7:17" /><verse number="18" style="v" sid="MRK 7:18" />Yesu kavahigile “Hata nyenye semwichela? Semchele kuva kinu kyekikumwingila munu kuhuma kwivala sekikumgita munu seidikilwe pautalo pa Nguluvi? <verse eid="MRK 7:18" /><verse number="19" style="v" sid="MRK 7:19" />Kwakuva sekikumwingila munumbula, ila kikumwingila mulileme, na pambele kukihecha kwivala lya mvili?” Kwa kulonga ndena, Yesu alongile fyakula fyonda finofu kwa kuliya. <verse eid="MRK 7:19" /><verse number="20" style="v" sid="MRK 7:20" />Endelie kulonga, “Kinu kimuhuma munu ndi kikumgita seidikilwe pautalo pa Nguluvi. <verse eid="MRK 7:20" /><verse number="21" style="v" sid="MRK 7:21" />Kwakuva numbula lya munu gihuma mahocho mawofu, uhochi na uwichi na udochaji, <verse eid="MRK 7:21" /><verse number="22" style="v" sid="MRK 7:22" />ugoni na uwimi na uwofu na udesi na ufuma na wifu na maligo na kidada na upufi. <verse eid="MRK 7:22" /><verse number="23" style="v" sid="MRK 7:23" />Finu fyonda ifyo fihuma mugati lya mnumbula lya munu, nagyo gikumgita munu kuva seidikilwe pautalo pa Nguluvi.”<verse eid="MRK 7:23" /></para>
  <para style="s">Mbatwa lya mdala Musilofonike</para>
  <para style="r">
    <ref loc="MAT 15:21-28">Matayo 15.21-28</ref></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24" />Yesu akahega pono pala, akahelela pa inyi yeugehe pepi na mwani va Tilo. Uukoya akaingila pa kaye yimwi na seakelile munu yeyonda achele. Ila seavesile kwifia. <verse eid="MRK 7:24" /><verse number="25" style="v" sid="MRK 7:25" />Baho pakali na mdala yumwi yeakali na muhinja yeakali na lihoka, akapulike njowo lwa Yesu. Suwe, akahelela na akafugamile pautalo pa Yesu. <verse eid="MRK 7:25" /><verse number="26" style="v" sid="MRK 7:26" />Mdala yula seakali Myawudi na yeababilwe Silofoinike lya Siliya. Baho amsukile Yesu amuheche lihoka muhinja vake. <verse eid="MRK 7:26" /><verse number="27" style="v" sid="MRK 7:27" />Ila Yesu akamlongie, “Leke tandi vana vigwite. Kwakuva seunofu kunyamula kyakula kya vana na kuvatagila mibuwa.” <verse eid="MRK 7:27" /><verse number="28" style="v" sid="MRK 7:28" />Mdala yula amuhigile, “Ndakyene Mtwa, ila hata libuwa vevali panyi lya mesa vilila masigalilo gya kyakula gya vana!” <verse eid="MRK 7:28" /><verse number="29" style="v" sid="MRK 7:29" />Yesu amlongie, “Kwakuva kwa lihigilo lyako, helele kukaye yula lihoka kamuhega muhinja vako!” <verse eid="MRK 7:29" /><verse number="30" style="v" sid="MRK 7:30" />Baho mdala yula akahelie kukaye lyake, akamwene mwana vake avasile paulili na lihoka limuhumile.<verse eid="MRK 7:30" /></para>
  <para style="s">Yesu ekumnanicha munu munya kisaya king'ali na mdindamatu</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31" />Baho Yesu akahega kuinyi lya Tilo, akachumbile pagati lya Sidoni, afikile hadi Dekapoli yaani inyi genye myani kumi, akafikile lihiva lya Galilaya. <verse eid="MRK 7:31" /><verse number="32" style="v" sid="MRK 7:32" />Baho vanu vakamsindike munu munya kisaya na mdindamatu. Vakamsukile Yesu amvikile mawoko. <verse eid="MRK 7:32" /><verse number="33" style="v" sid="MRK 7:33" />Yesu akamvikile patali na lipinga lya vanu. Akavika fyala fyake mulisigicha gya munu yula. Pambele akafunya miti mufyala fyake, na kuubyalisa lumili lwa munu yula. <verse eid="MRK 7:33" /><verse number="34" style="v" sid="MRK 7:34" />Pambele Yesu akalolile kukyanya paluhano, akapepile muhe kwaludali na kumlongela munu yula, “Efata” Mana lyake “Dinduka!” <verse eid="MRK 7:34" /><verse number="35" style="v" sid="MRK 7:35" />Bahobaho masigicha gya munu yula gikadinduka na lumili lwake ukali lipefu, akavanga kuywanga unofu. <verse eid="MRK 7:35" /><verse number="36" style="v" sid="MRK 7:36" />Yesu akavakanila vabihile kumlongela munu yeyonda cheagitile. Ila kila peagina kuvakanila, ndifyo vakagina kulanducha njowo hicho. <verse eid="MRK 7:36" /><verse number="37" style="v" sid="MRK 7:37" />Vanu vonda vakadudwive mno, vilonga, “Kagita fyonda finu unofu. Kavaponela vanu vadindamatu vaka pulika na vanu sevavesa kuywanga vakaywanga.”<verse eid="MRK 7:37" /></para>
  <chapter eid="MRK 7" />
  <chapter number="8" style="c" sid="MRK 8" />
  <para style="s">Yesu akuvalisa kyakula vanu elufu chitai</para>
  <para style="r">
    <ref loc="MAT 15:32-39">Matayo 15.32-39</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1" />Vakati hugo, lipinga likomi lya vanu vekekung'ese kangi na vakali vihela kyakuliya. Suwe Yesu akavakemela vachulila vake, akavalongie, <verse eid="MRK 8:1" /><verse number="2" style="v" sid="MRK 8:2" />“Ndikuvawonela lusungu vanu hava kwa kuva twikalile pamwinga na nene kwa figono fidatu na vehela kyakula. <verse eid="MRK 8:2" /><verse number="3" style="v" sid="MRK 8:3" />Pendivaleka vahelele kukaye vakiva na njala vichilika mung'asi, kwakuva vangi vihuma patali.” <verse eid="MRK 8:3" /><verse number="4" style="v" sid="MRK 8:4" />Vachulila vake vakamuhucha, “Baha kudasi twipata kwii mibumunda gya kuvagwitisa vanu vonda hava?” <verse eid="MRK 8:4" /><verse number="5" style="v" sid="MRK 8:5" />Yesu akavahucha, “Mwigehe na mibumunda milinga?” Vakamwigile, “Tunagyo mibumunda saba hela.” <verse eid="MRK 8:5" /><verse number="6" style="v" sid="MRK 8:6" />Suwe, akavalongela vanu vakale panyi, kanyamula gila mibumunda saba, akamhongecha Nguluvi, akaidumula mibumunda, kavagavila vachulila vake, vene vavagavile vanu. <verse eid="MRK 8:6" /><verse number="7" style="v" sid="MRK 8:7" />Vakali kangi na fisomba fidodo. Yesu akavifunyile, akavagavila kangi vachulila vake neke havagavile vanu. <verse eid="MRK 8:7" /><verse number="8" style="v" sid="MRK 8:8" />Vanu vakalie, vakagwite. Vakung'asile masigalio gya kyakula vakamemiche mandilu saba. <verse eid="MRK 8:8" /><verse number="9" style="v" sid="MRK 8:9" />Vanu vevalie vakali elufu chitai. Pambele Yesu akavelagile, <verse eid="MRK 8:9" /><verse number="10" style="v" sid="MRK 8:10" />bahobaho, akaingila muliwato pamwinga na vachulila vake, vakahelela inyi lya Dalimanuta.<verse eid="MRK 8:10" /></para>
  <para style="s">Vafalisayo vikela umanyitu</para>
  <para style="r">
    <ref loc="MAT 16:1-4">Matayo 16.1-4</ref></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11" />Vafalisayo vachile, vakavanga kumuhucha Yesu. Kwa kumgecha, vakakelie agite umanyitu kuvawonesa kuva umwimike vake uhumile kuluhano kwa Nguluvi. <verse eid="MRK 8:11" /><verse number="12" style="v" sid="MRK 8:12" />Yesu akaswigime munumbula, kavalongela, “Wuli kilelo hiki kikela umanyitu? Ndakyene ndikuvalongela, kilelo hiki sekipatila umanyitu vovonda.” <verse eid="MRK 8:12" /><verse number="13" style="v" sid="MRK 8:13" />Suwe, akavalekile, akakang'ala kangi muliwato, akavanga kubita kuhelela kumwambo lya pili lya lihiva.<verse eid="MRK 8:13" /></para>
  <para style="s">Lisimika lya Vafalisayo na lya Helode</para>
  <para style="r">
    <ref loc="MAT 16:5-12">Matayo 16.5-12</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14" />Vachulila va Yesu vasemwile kunyamula mibumunda, ila vakali na limwi hela mula muliwato. <verse eid="MRK 8:14" /><verse number="15" style="v" sid="MRK 8:15" />Yesu akavahonyile, “Mlolile mno! Mwikale kutali na lisimika lya Vafalisayo na lisimika lya Helode.” <verse eid="MRK 8:15" /><verse number="16" style="v" sid="MRK 8:16" />Vachulila vakavanga valonganile vene kwa vene, “Iywanga ndena kwakuva twihela mibumunda.” <verse eid="MRK 8:16" /><verse number="17" style="v" sid="MRK 8:17" />Yesu achelege hago, akavalongie, “Wuli mwilongana kwakuva muhela mibumunda? Mwave semtambula vala kuchela? Wuli numbula chenu mikangafu kuchela? <verse eid="MRK 8:17" /><verse number="18" style="v" sid="MRK 8:18" />Mwigehe na meho ila semlola? Mwigehe na misigicha ila sempulika? Be, semwikwiwuka? <verse eid="MRK 8:18" /><verse number="19" style="v" sid="MRK 8:19" />Chipindi chila pendidumule gila mibumunda mihanu na kuvagavila vanu elefu chihanu? Mwilundisile vindilu vilinga gyegisigile?”</para>
  <para style="p" vid="MRK 8:19">Vakamwigile, “Fikali kumi na fivili.”<verse eid="MRK 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20" />“Pendidumule gila mibumunda saba na kuvagavila vanu elefu chitai, mwikalundise vindilu fya mibumunda vilinga gyegisigile?” Vakamwigila, “Fikali saba.” <verse eid="MRK 8:20" /><verse number="21" style="v" sid="MRK 8:21" />Baho, akavahucha, “Mwave hela kuchela?”<verse eid="MRK 8:21" /></para>
  <para style="s">Yesu ekumnanicha munu yeabofwike meho ukoya Betisaida</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22" />Yesu akafikile Betisaida pamwinga na vachulila vake, ukoya vanu vakamletie munu yeabofwike meho, vakamsuka ambyalise. <verse eid="MRK 8:22" /><verse number="23" style="v" sid="MRK 8:23" />Yesu akamkolela liwoko yula munu yeabofwike meho, akamsindika kwivala lya mwani. Akamfunyila miti mumeho ga yula munu yeabofwike meho na kumvikila mawoko mumeho, Yesu akamuhucha, “Wiwesa kulola kinu kyokyonda?” <verse eid="MRK 8:23" /><verse number="24" style="v" sid="MRK 8:24" />Yula munu yeabofwike meho akalola, akalonga, “Ndilola vanu ila vewoneka ngita mibiki gyegigenda.” <verse eid="MRK 8:24" /><verse number="25" style="v" sid="MRK 8:25" />Yesu akamvikila kangi mawoko mumeho ga yula munu, nave akahulutule meho, umwimike vake va kulola ukamuhuya, akalola kila kinu savasava. <verse eid="MRK 8:25" /><verse number="26" style="v" sid="MRK 8:26" />Yesu kamlongela ahelele kukaye lyake na kumkanila, “Ubihile kuchumbila kukijiji kingi chumbaniche kukaye lyako!”<verse eid="MRK 8:26" /></para>
  <para style="s">Peteli ilandula kuva Yesu ndive Kilisito</para>
  <para style="r">
    <ref loc="MAT 16:13-20">Matayo 16.13-20</ref>; <ref loc="LUK 9:18-21">Luka 9.18-21</ref></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27" />Pambele Yesu na vachulila vake vakahelela ku fijiji fya Kaisalia Filipi. Pevagehe mung'asi, Yesu akavahucha vachulila vake, “Vanu vilonga nene ani?” <verse eid="MRK 8:27" /><verse number="28" style="v" sid="MRK 8:28" />Vakamwigila, “Vanu vangi vilonga veve Yohani mbatisaji, vangi vilonga veve Elia na vangi vilonga veve mwingavao va vavichi va Ngulivi.” <verse eid="MRK 8:28" /><verse number="29" style="v" sid="MRK 8:29" />Pambele Yesu akavahucha, “Na nyenye mwilonga nene ani?” Peteli akamuhigile, “Veve ndive Kilisito yeahanguliwe na Nguluvi.” <verse eid="MRK 8:29" /><verse number="30" style="v" sid="MRK 8:30" />Yesu akavakanila, “Vabihile kumlongela munu yeyonda njowo lwake.”<verse eid="MRK 8:30" /></para>
  <para style="s">Yesu ilagula pakyanya lya maguda na kufua na kuchulubuka kwa mwene</para>
  <para style="r">
    <ref loc="MAT 16:21-28">Matayo 16.21-28</ref>; <ref loc="LUK 9:22-27">Luka 9.22-27</ref></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31" />Baho Yesu akavangile kufafundisa vachulila vake kuva Mwana va Munu ipata maguda gyolofu na kukanwa na vagogolo na filongosi va vatekechi vakomi, na vawulanichi va malagicho na kudochwa, na pefichumbile figono fidatu ichulubuka. <verse eid="MRK 8:31" /><verse number="32" style="v" sid="MRK 8:32" />Yesu akavalongela njowo hilyo vasivasi. Bahobaho Peteli akamnyamula palubali akavanga kumlongalonga. <verse eid="MRK 8:32" /><verse number="33" style="v" sid="MRK 8:33" />Ila Yesu akaseduke na kuvalola vachulila vake, akamlakila Peteli akilonga, “Uhege kumbele lyangu Setani! Veve sewihocha gya Nguluvi bali uhocha gya vanu.” <verse eid="MRK 8:33" /><verse number="34" style="v" sid="MRK 8:34" />Pambele akaukemela lipinga lya vanu pamwinga na vachulila vake, akalonga, “Munu yeyonda ekela kunifuatila nene, ndi lasima ajileme mwene, anyamule kipindilihicho lyake, anifuatile. <verse eid="MRK 8:34" /><verse number="35" style="v" sid="MRK 8:35" />Kwakuva munu yeyonda yeakela kuwokola uwumi gyake yumwene akuyayagicha, ila munu yeakuyayagicha uwumi gyake kwakuva nene na kwakuva lya Njowo Nofu lya Nguluvi, akuyawokola. <verse eid="MRK 8:35" /><verse number="36" style="v" sid="MRK 8:36" />Munu apatila liki ngita akuupatila finu fyonda fya inyi yonda na kuyagicha uwumi gyake? <verse eid="MRK 8:36" /><verse number="37" style="v" sid="MRK 8:37" />Awu munu ahecha kinu liki apatile kangi uwumi gyake. <verse eid="MRK 8:37" /><verse number="38" style="v" sid="MRK 8:38" />Munu yeyonda yeaniwonela nyoni nene na malichwi gyangu pa filelo ifi fya ugoni na fya sambi, Mwana va Munu, akumuwonela nyoni chipindi peikwacha pa ukomi va Dadie vake pamwi na vandumindumi va Nguluvi kuluhano.”<verse eid="MRK 8:38" /></para>
  <chapter eid="MRK 8" />
  <chapter number="9" style="c" sid="MRK 9" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1" />Yesu endelie kuvalongela, “Ndakyene ndikuvalongela, vangi vagehe baha ambavo sevafua mbaka vauwone ung'achale va Nguluvi ukwacha kwa ludali.”<verse eid="MRK 9:1" /></para>
  <para style="s">Yesu iseduka wuso</para>
  <para style="r">
    <ref loc="MAT 17:1-13">Matayo 17.1-13</ref>; <ref loc="LUK 9:28-36">Luka 9.28-36</ref></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2" />Pefichumbile figono sita, Yesu akavanyamula Peteli na Yakobo na Yohani vakahelela pamwinga kukyanya pakidunda kitali viweka hela. Ukoya Yesu akaseduka wuso pautalo gawo, <verse eid="MRK 9:2" /><verse number="3" style="v" sid="MRK 9:3" />myenda gyake gikali mivalafu ging'ala hilo, kuhela munu yeyonda pa inyi yeavesa kukanja ngita fila. <verse eid="MRK 9:3" /><verse number="4" style="v" sid="MRK 9:4" />Baho Elia na Musa vakavahumie, vakava vaywangege na Yesu. <verse eid="MRK 9:4" /><verse number="5" style="v" sid="MRK 9:5" />Peteli akamlongie Yesu, “Muwulanichi, ndi unofu nefwe twikale baha. Suwe, ngiba tuchenge fibudi fidatu, kimwi kya veve na kimwi kya Musa na kimwi kya Elia.” <verse eid="MRK 9:5" /><verse number="6" style="v" sid="MRK 9:6" />Peteli seachele kya kulonga kwakuva mwene na vayage vakali vakaogwipe mno. <verse eid="MRK 9:6" /><verse number="7" style="v" sid="MRK 9:7" />Baho likahumila lifunde likavagubika na sauti ikapulikike pa lila lifunde, “Uyu Mwana Vangu ndimkeliye, mumpulike mwene.” <verse eid="MRK 9:7" /><verse number="8" style="v" sid="MRK 9:8" />Bahobaho vachulila havo vakalola kuno na kuno, sevamuonile kangi munu yungi, ila vamuonile Yesu. <verse eid="MRK 9:8" /><verse number="9" style="v" sid="MRK 9:9" />Pevali vikwika kukidunda, Yesu akavakanila, “Vabihile kumlongela munu yeyonda njowo chevawonile, mbaka Mwana va Munu peichulubuka.” <verse eid="MRK 9:9" /><verse number="10" style="v" sid="MRK 9:10" />Vakalikolela lilagilicho lila, ila vakava vakwiwuchana, “Kuno kuchulubuka mana lyake liki?” <verse eid="MRK 9:10" /><verse number="11" style="v" sid="MRK 9:11" />Vakamuhucha Yesu, “Wuli vawulanichi va malagicho vilonga kuva lasima awuye tandi Elia?” <verse eid="MRK 9:11" /><verse number="12" style="v" sid="MRK 9:12" />Yesu akavahigile, “Ndakyene, Elia hekwacha tandi, neke kuwisa umiya njowo chonda. Ila pamwinga na agyo, iyandikwe kuva Mwana va Munu ni lasima akudwe mno na kubedaliwa? <verse eid="MRK 9:12" /><verse number="13" style="v" sid="MRK 9:13" />Ila ndikuvalongela, Elia achile sue, navo vakamgitila vevakelie, ngita peisimbilwe.”<verse eid="MRK 9:13" /></para>
  <para style="s">Yesu ekumnanicha mwana munya lihoka</para>
  <para style="r">
    <ref loc="MAT 17:14-21">Matayo 17.14-21</ref>; <ref loc="LUK 9:37-43a">Luka 9.37-43a</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14" />Pevavafikie vala vachulila vangi, vawene lipinga likomi lya vanu livachungutile. Vangi vawulanichi va malangicho vakali vekibisana navo. <verse eid="MRK 9:14" /><verse number="15" style="v" sid="MRK 9:15" />Vanu havo vakamuwonile Yesu, vakadudwive mno, vakamnyiliye vamsamuse. <verse eid="MRK 9:15" /><verse number="16" style="v" sid="MRK 9:16" />Yesu akavahucha vachulila vake, “Mwibisana navo kuwusu liki?” <verse eid="MRK 9:16" /><verse number="17" style="v" sid="MRK 9:17" />Bahala pala munu yumwi mulipinga lila lya vanu akahigile, “Muwulanichi, ndimletile mwana vangu kwa veve, munya lihoka yeamgitile seavese kuywanga. <verse eid="MRK 9:17" /><verse number="18" style="v" sid="MRK 9:18" />Kila peakumwingila, akumkwisa panyi na kumgita ahumilwe na mafulofulo mumlomo na kusigina mino na kunyala mvili vake vonda. Vachulila vako ndivalongie vamuheche yula lihoka vakalemwile.” <verse eid="MRK 9:18" /><verse number="19" style="v" sid="MRK 9:19" />Yesu akavalongie, “Nyenye filelo sekihela na mbatwa! Ndivecha pamwinga na nyenye mbaka pandili? Ndikuvafumilila mbaka pandili? Mletile mdimi kwa nene!” <verse eid="MRK 9:19" /><verse number="20" style="v" sid="MRK 9:20" />Vakamsindika kwa Yesu. Yula lihoko pevamuwene Yesu, baho akampeliye kilibisi yula mdimi, akamgwisa panyi, akagalawuka na kuhuma mifulofulo mumlomo. <verse eid="MRK 9:20" /><verse number="21" style="v" sid="MRK 9:21" />Yesu kamuhuchile daada va yula mdimi, “Aga gimpatile kuhuma pandili?”</para>
  <para style="p" vid="MRK 9:21">Akamhigile, “Kuhuma pauvana vake.” <verse eid="MRK 9:21" /><verse number="22" style="v" sid="MRK 9:22" />“Baho kwa baho lihoka akali akwimgwisa palyoto na mumalenga neke kumdochila. Ila ngita wiwesa kugita njowo chochonda, tusuka utuwonele lusungu ututange!”<verse eid="MRK 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23" />Yesu akamlongie, “Ngita wiwesa kwidikila, fyonda fikuwesenika kwa munu yeaidikile.”<verse eid="MRK 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 9:24" />Baho daada va yula mdimi akatova kyowo akilonga, “Ndidikila, ila mbatwa lyangu seitosa, unitange.” <verse eid="MRK 9:24" /><verse number="25" style="v" sid="MRK 9:25" />Yesu peuwonile lipinga lya vanu liginakulutala kisatu pautalo lyake, akamlakila yula lihoka, “Veve lihoka yeukumgita mwana uyu kuva munu seiywanga na mdindamatu, ndikuamulu umuhege mwana uyu vala bihile kumwingila kangi!” <verse eid="MRK 9:25" /><verse number="26" style="v" sid="MRK 9:26" />Baho yula lihoka akatova kyowo, akampelie kilibisi na kumgwisa panyi mwana yula, baho akamuhuma. Mwana awonike ngita munu yeafuwe, ifyo vanu volofu vakalonga, “Afue!” <verse eid="MRK 9:26" /><verse number="27" style="v" sid="MRK 9:27" />Ila Yesu akamkolela liwoko yula mdimi, akamwinula na mwene akaimile.<verse eid="MRK 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28" />Suwe, Yesu peaingile kukaye vachulila vake vakamuhucha pevagehe weka mugati, “Wuli nefwe tulemwile kumuhecha yula lihoka?”<verse eid="MRK 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 9:29" />Yesu akavahigile, “Lihoka ngita hava sevidagwa ndeni bila kumsuka Nguluvi.”<verse eid="MRK 9:29" /></para>
  <para style="s">Yesu elonga kangi kufua kwa mwene</para>
  <para style="r">
    <ref loc="MAT 17:22-23">Matayo 17.22-23</ref>; <ref loc="LUK 9:43b-45">Luka 9.43b-45</ref></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30" />Yesu na vachulila vake vakahega baho, vakachumbile ku Galilaya. Yesu sehakelie munu yeyonda achele pono pevagehe, <verse eid="MRK 9:30" /><verse number="31" style="v" sid="MRK 9:31" />kwakuva akali ekuvafundisa vachulila vake. Akavalongie, “Mwana va Munu ekanwa na kubatwa na vanu navo vekumdocha, ila pefichumba figono fidatu kudochwa kwa mwene echulubuka.”<verse eid="MRK 9:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 9:32" />Ila vachulila vake sevachele kila kyeakali akilonga ila vakaogwipe kumuhucha.<verse eid="MRK 9:32" /></para>
  <para style="s">Nde ani yeagehe mkomi?</para>
  <para style="r">
    <ref loc="MAT 18:1-5">Matayo 18.1-5</ref>; <ref loc="LUK 9:46-48">Luka 9.46-48</ref></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33" />Suwe, vakafikile Kapelinaumu na pevagehe kukaye, Yesu akavahucha vachulila vake, “Mukali mwibisana liki mung'asi?”<verse eid="MRK 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 9:34" />Ila sevavesile kumhiga, kwakuva kung'asi vakali vikwiwucha ndi ani yeagehe mkomi mugati gawo. <verse eid="MRK 9:34" /><verse number="35" style="v" sid="MRK 9:35" />Yesu akalile panyi, akavakemela vachulila vake vonda kumi na vavili, akavalongie, “Ngita munu yeyonda akikela kuva va kwansa lasima aveche va mwiso na muchulila va vonda.” <verse eid="MRK 9:35" /><verse number="36" style="v" sid="MRK 9:36" />Baho akamnyamue mwana mdodo, kamwimiche pagati gyawo, akamkumbatile, akavalongie, <verse eid="MRK 9:36" /><verse number="37" style="v" sid="MRK 9:37" />“Munu yeyonda yeakumwanukila mwana ngita uyu kwa litawa lyangu, ekunjanukila nene. Namunu yeyonda yeakunyanukila nene, seakunjanuka nene hela, ila akumpokela na yula yeanitumile.”<verse eid="MRK 9:37" /></para>
  <para style="s">Yeseakutupinga agehe palubali lyetu</para>
  <para style="r">
    <ref loc="LUK 9:49-50">Luka 9.49-50</ref></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38" />Yohani akamlongie, “Muwulanichi, tumwene munu yumwi akihecha lihoka kwa litawa lyako, nefwe tukamkanila kwakuva mwene semuyetu.”<verse eid="MRK 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 9:39" />Ila Yesu akalonga, “Mbihile kumkanila, kwakuva kwa hela munu yeagitila umunyitu kwa litawa lyangu ambaye pambele udodo ewesa kulonga mahofu pakyanya lyangu. <verse eid="MRK 9:39" /><verse number="40" style="v" sid="MRK 9:40" />Kwakuva yeyonda seipingana nefwe agehe palubali lyetu. <verse eid="MRK 9:40" /><verse number="41" style="v" sid="MRK 9:41" />Munu yeyonda yekuvagavila malenga gya kunyuwa, kwakuva nyenye vanu va Kilisito ndakyene seikosa kupokela sawadi lyake.”<verse eid="MRK 9:41" /></para>
  <para style="s">Magecho ga sambi</para>
  <para style="r">
    <ref loc="MAT 18:6-9">Matayo 18.6-9</ref>; <ref loc="LUK 17:1-2">Luka 17.1-2</ref></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42" />“Munu yeyonda yaakuvagita vana hava vadodo kugita sambi vevakunidikila nene, ngiba awopilwe lwala likomi na kutagwa mulinyanza. <verse eid="MRK 9:42" /><verse number="43" style="v" sid="MRK 9:43" />Liwoko lyako likikusababisila kugita sambi, udumule. Ngiba uwingile paumumi va mbepali na liwoko limwi, kuliko kwingila na mawoko givili. Pelyoto seuchimika mbepali.” <verse eid="MRK 9:43" /><verse number="44" style="v" sid="MRK 9:44" />Ukoya mifilifili sevifua vala lyoto seuchimika mbepali. <verse eid="MRK 9:44" /><verse number="45" style="v" sid="MRK 9:45" />Na ligulu lyako likikusababisila kugita sambi, udumule!, Ngiba uwingile paumumi va mbepali wihela ligulu limwi, kuliko kuva na magulu gyonda givili na kutagwa palyoto lya figono fyonda seuchimika. <verse eid="MRK 9:45" /><verse number="46" style="v" sid="MRK 9:46" />Ukoya mifilifili sevafua vala lyoto seuchimika. <verse eid="MRK 9:46" /><verse number="47" style="v" sid="MRK 9:47" />Na liho lyako likikusababisila kugita sambi, ling'ole! Ngiba uwingile kuung'achale va Nguluvi na liho limwi hela, kuliko kuva na mewo gyonda givili na kutagwa palyoto va figono fyonda weseuchimika. <verse eid="MRK 9:47" /><verse number="48" style="v" sid="MRK 9:48" />Mula mifilifili vake sevafua vala lyoto seuchimika.<verse eid="MRK 9:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 9:49" />“Kila munu ivikwa munyo kwa lyoto.<verse eid="MRK 9:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 9:50" />“Munyo nde nofu, ila ngita iyanangike, iwongelechwa na liki?</para>
  <para style="p" vid="MRK 9:50">“Muveche na munyo mugati yenu, mwikale kwa lutengamaso yumwi na yungi.”<verse eid="MRK 9:50" /></para>
  <chapter eid="MRK 9" />
  <chapter number="10" style="c" sid="MRK 10" />
  <para style="s">Yesu iwulanicha kutolana na kulekana</para>
  <para style="r">
    <ref loc="MAT 19:1-12">Matayo 19.1-12</ref>; <ref loc="LUK 16:18">Luka 16.18</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1" />Yesu akahuma bahala akahelela kumwani lwa Yudeya, mbaka kumwambo lwa mgoka Yolidani. Lipinga lya vanu likamuheleliye kangi, mwene akavawulanicha kangi ngita peachovie.<verse eid="MRK 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 10:2" />Baho vamonga Vafalisayo vakamuheleliya na kumgecha, vakamuhucha, “Wuli ndiunofu mgosi kumleka mdala vake?”<verse eid="MRK 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3" />Yesu akavahigile, “Wuli Musa avagavile malagicho liki?”<verse eid="MRK 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4" />Vene vakamlongie, “Musa atulagiliche mgosi peamleka mdala vake kwa kumgavila talaka.”<verse eid="MRK 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5" />Yesu akavalongie, “Musa avaandikie Malagilicho, kwakuva lwa ukangafu lwa numbula chenu. <verse eid="MRK 10:5" /><verse number="6" style="v" sid="MRK 10:6" />Kuhuma kuwumbwa kwa inyi, ‘Nguluvi awumbile mgosi na mdala.’ Masimbo gilonga, <verse eid="MRK 10:6" /><verse number="7" style="v" sid="MRK 10:7" />‘Mgosi akumleka dadi vake na maye vake na kuvecha pamwinga na mdala vake, <verse eid="MRK 10:7" /><verse number="8" style="v" sid="MRK 10:8" />vavecha mvili wumwi.’ Ino vavecha mvili wumwi, setandi vavili. <verse eid="MRK 10:8" /><verse number="9" style="v" sid="MRK 10:9" />Suwe, cheakiwunganise Nguluvi, munu seiwesa kuvalekanicha.”<verse eid="MRK 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10" />Pevaingile mukaye, vachulila vake vakamuhucha makani gala. <verse eid="MRK 10:10" /><verse number="11" style="v" sid="MRK 10:11" />Mwene akavalongie, “Yeakumleka mdala vake na kumtola yungi, igita ugoni. <verse eid="MRK 10:11" /><verse number="12" style="v" sid="MRK 10:12" />Na mdala yeakumleka mgosi vake na kutauka na yungi igita ugoni.”<verse eid="MRK 10:12" /></para>
  <para style="s">Yesu ekuvafunya vana vadodo</para>
  <para style="r">
    <ref loc="MAT 19:13-15">Matayo 19.13-15</ref>; <ref loc="LUK 18:15-17">Luka 18.15-17</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13" />Vanu vamonga vakamsindikile Yesu vana vadodo avafunye, ila vachulila vake vakavalakilila vanu vala. <verse eid="MRK 10:13" /><verse number="14" style="v" sid="MRK 10:14" />Yesu pevawonile akavipila akavalongie vachulila vake, “Valeke vana havo vache kwa nene, mubihile kuvakana, kwakuva Ung'achale va kuluhano kwa Nguluvi ndi kwa vanu vevagehe ngita vana hava. <verse eid="MRK 10:14" /><verse number="15" style="v" sid="MRK 10:15" />Ndakyene ndikuvalongela, munu yeyonda yesewunuka Ung'achale va kuluhano kwa Nguluvi ngita mwana mdodo, seikwingila haa muung'achale va kuluhano kwa Nguluvi.” <verse eid="MRK 10:15" /><verse number="16" style="v" sid="MRK 10:16" />Baho akavanwike vana vala mumawoko gyake na akavakumbatila na akavafunya.<verse eid="MRK 10:16" /></para>
  <para style="s">Munu yeali mmosi</para>
  <para style="r">
    <ref loc="MAT 19:16-30">Matayo 19.16-30</ref>; <ref loc="LUK 18:18-30">Luka 18.18-30</ref></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17" />Yesu peavangile kangi lugendo lwake, munu yumwi kamnyililia, akafugamile pautalo lyake, akamuhucha “Muwulanichi mnofu, ndigite liki neke niuhale uwumi va mbepali?”<verse eid="MRK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 10:18" />Yesu akamuhigila, “Wuli unikemela mnofu? Kuhela munu yeali msanji ila Nguluvi weka hela. <verse eid="MRK 10:18" /><verse number="19" style="v" sid="MRK 10:19" />Ugachele Malagilicho, ‘Ubihile kugita ugoni, ubihile kudocha, ubihile kuhicha, ubihile kulonga udesi kwa myago na ubihile kulonga ufyangu, vaginye dadi vako na maye vako.’”<verse eid="MRK 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20" />Munu yula akamuhigile, “Muwulanichi, hago gyonda ndigitile paudimi vangu.”<verse eid="MRK 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21" />Yesu akamlolile, akamkela, akamlongie, “Upemswe na kinu kimwi, helele ukaguche kila kinu kyeunakyo, uvagavile vahangala hicho sendi na veve uvecha na umosi wolofu kuluhano, baho vache unifuatile.” <verse eid="MRK 10:21" /><verse number="22" style="v" sid="MRK 10:22" />Yula munu peapulike hago, akasugwime, akahelela kuno ahunime, kwakuva akali na mali chongofu.<verse eid="MRK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23" />Yesu alolile palubali chonda, akavalongie vachulila vake, “Ivecha ikava ukangafu mno kwa vala vamosi kwingila mu Ung'achale va kuluhano kwa Nguluvi!”<verse eid="MRK 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 10:24" />Vachulila vakadudwive malichwi gyake. Ila Yesu akavalongie kangi, “Vana vangu, ndikanga mno kwingila mu Ung'achale va kuluhano kwa Nguluvi! <verse eid="MRK 10:24" /><verse number="25" style="v" sid="MRK 10:25" />Ndi lipefu mno mnyama yeikemelwa ngamila kuchumba mulibwenge lya sasiya, kuliko mmosi kwingila mu Ung'achale va kuluhano kwa Nguluvi.”<figure style="fig" file="14 Camel.jpg" size="col" ref="10.25">Ngamila</figure><verse eid="MRK 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26" />Vachulila vake vakadudwive mno vakwiucha, “Ndi ani yeivesa kulowola?”<verse eid="MRK 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27" />Yesu akavahutulie meho, akavalongie, “Kwa munu yili seliwanikie, ila kwa Nguluvi finu fyonda liwanikie.”<verse eid="MRK 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28" />Peteli akamlongie, “Tufilekile fyonda na kukufuatila veve!”<verse eid="MRK 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 10:29" />Yesu akalonga, “Ndakyene ndikuvalongela, kila munu yealekile kaye na lukololo na muhacha na dadi na maye na vana vake na migunda kwakuva lya nene na kwakuva lya Njowo Nofu, <verse eid="MRK 10:29" /><verse number="30" style="v" sid="MRK 10:30" />ambaye ehombwa mala mia chipindi hugu, kaye na lukololo na muhacha na maye na vana na migunda pamwinga na maguda, figono fikwacha apokela uwumi va mbepali. <verse eid="MRK 10:30" /><verse number="31" style="v" sid="MRK 10:31" />Ila volofu vevagehe va kwansa vavecha va kumwiso, na vevagehe va kumwiso vavecha va kwansa.”<verse eid="MRK 10:31" /></para>
  <para style="s">Yesu ilonga mala lya udatu kufua na kuchulubuka</para>
  <para style="r">
    <ref loc="MAT 20:17-19">Matayo 20.17-19</ref>; <ref loc="LUK 18:31-34">Luka 18.31-34</ref></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32" />Suwe, pevali mung'asi kuhelela pakyanya ku Yelusalemu na Yesu akali alonguwe. Vachulila vake vakaingilwe na uwogofi, navo vanu vevamfuatila vakaingilwa na uwogofi. Yesu kavanyamula kangi vala vachulila vake kumi na vavili, akavanga kuvalongela gyekumwachila. <verse eid="MRK 10:32" /><verse number="33" style="v" sid="MRK 10:33" />Akavalongie, “Mpulike! Twihelela ku Yelusalemu, na koya Mwana va Munu esindikwa kwa vatekechi vakomi na vawulanichi va malagicho, navo vakumuhiga adochilwe, pambele vakumsindika kwa vanu seva Vayawudi. <verse eid="MRK 10:33" /><verse number="34" style="v" sid="MRK 10:34" />Navo vekumkinila na kumfunyila miti, vakumtova na ndomondo na kumdocha. Ila pakigono kya udatu echulubuka.”<verse eid="MRK 10:34" /></para>
  <para style="s">Yakobo na Yohani vakumsuka Yesu</para>
  <para style="r">
    <ref loc="MAT 20:20-28">Matayo 20.20-28</ref></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35" />Ndeni Yakobo na Yohani, vana va Sebedayo, vakamweleliye Yesu vakamlongia, “Muwulanicha, twikela utugitile kinu kyetukusuka.” <verse eid="MRK 10:35" /><verse number="36" style="v" sid="MRK 10:36" />Yesu akavahucha, “Mwikela ndivagitile liki?” <verse eid="MRK 10:36" /><verse number="37" style="v" sid="MRK 10:37" />Vakamuhigile, “Peukalila pakigoda kyako kya ukomi kya Ung'achale, utuleke twikale palubali lwako lwa liwoko lya kulia na yungi akale paubali lya liwoko lya kusoto.” <verse eid="MRK 10:37" /><verse number="38" style="v" sid="MRK 10:38" />Yesu kavalongela, “Semwichela mwisuka liki! Mwivesa kufumilia magudo gyendikugapatila na kufua ngita nene pendifua?” <verse eid="MRK 10:38" /><verse number="39" style="v" sid="MRK 10:39" />Vakamuhigile, “Twivesa.”</para>
  <para style="p" vid="MRK 10:39">Yesu akavalongiye, “Magudo gyendikugapatila nene nyenye mwiwesa kufumilia na kufa ngita nene pendifua. <verse eid="MRK 10:39" /><verse number="40" style="v" sid="MRK 10:40" />Ila ndi ani yekukala palubali lya liwoko lya kulia awu kusoto. Se nene kulamula, ila Nguluvi yeamula ne ani akale kwii na ani akale kwii.”<verse eid="MRK 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41" />Vala vachulila vangi kumi pevapulike hago, vakavanga kuvavipila Yakobo na Yohani. <verse eid="MRK 10:41" /><verse number="42" style="v" sid="MRK 10:42" />Yesu akavakemela vachulila vake vonda na akavalongie, “Mwichele kuva vatavala va inyi kuvatavala vanu vawo kwa ludali, na vakomi havo huvatumikisa vanu vawo. <verse eid="MRK 10:42" /><verse number="43" style="v" sid="MRK 10:43" />Ila kwa nyenye semveche ndeni, ila yeikela kuva mkomi mugati yenu, itakilwa aveche mnyengendwa venu. <verse eid="MRK 10:43" /><verse number="44" style="v" sid="MRK 10:44" />Munu yeasaka kuva mkomi, lasima aveche mndumendume va vonda. <verse eid="MRK 10:44" /><verse number="45" style="v" sid="MRK 10:45" />Kwakuva Mwana va Munu seachile kugitilwa kasi ila achile kugita kasi na kuhuwecha uwumi vake kuva ukombosi kwa vanu vongofu.”<verse eid="MRK 10:45" /></para>
  <para style="s">Yesu akumnanicha Balitimayo munu abofwike meho</para>
  <para style="r">
    <ref loc="MAT 20:29-34">Matayo 20.29-34</ref>; <ref loc="LUK 18:35-43">Luka 18.35-43</ref></para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46" />Suwe vakafikile Yeliko, Yesu peakali ihuma kumwani na vachulila vake pamwinga na lipinga likomi lya vanu, munu yumwi yeabofwike meho, litawa lyake Balitimayo, mwana va Timayo akali akalile mulibali lya ng'asi esuka vamtange.<verse eid="MRK 10:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MRK 10:47" />Peapulike kuva ndi Yesu va Nasaleti akali echumba bahala, akavanga kumkemela kwa lisauti likomi, “Yesu, Mwana va Dawudi! Muwonele lusungu!”<verse eid="MRK 10:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 10:48" />Vanu volofu vakamlakia na kumlongela achike, ila mwene akagina kukemela kwa lisauti likomi, “Mwana va Dawudi, niwonile lusungu!”<verse eid="MRK 10:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 10:49" />Yesu imile na kulonga, “Mumkemele.”</para>
  <para style="p" vid="MRK 10:49">Suwe vakamkemie yula yeabofwike meho, vakamlongie, “Wikangache! Wime akukukemela.”<verse eid="MRK 10:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 10:50" />Mwene akatagile patali mwenda vake, akaimile na amuhelelie Yesu.<verse eid="MRK 10:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 10:51" />Yesu akamuhucha, “Ukela ndikugitie liki?”</para>
  <para style="p" vid="MRK 10:51">Yula munu yeabofwike meho akamuhigile, “Muwalanichi, ndikela kulola.”<verse eid="MRK 10:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52" />Yesu akamlongie, “Bite, mbatwa lyako ikuponyile.”</para>
  <para style="p" vid="MRK 10:52">Bahobaho yula munu yeabofwike meho akavesile kulola, akamfuatile Yesu mumng'asi.<verse eid="MRK 10:52" /></para>
  <chapter eid="MRK 10" />
  <chapter number="11" style="c" sid="MRK 11" />
  <para style="s">Yesu akwingila Pa Yelusalemu kwa lubilikila</para>
  <para style="r">
    <ref loc="MAT 21:1-11">Matayo 21.1-11</ref>; <ref loc="LUK 19:28-40">Luka 19.28-40</ref>; <ref loc="JHN 12:12-19">Yohani 12.12-19</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1" />Pevali pepi na Yelusalemu na mwani Betifage na Betania pawip na kidunda lwa Miseituni. Baho Yesu akavalagilicha vachulila vake vavili, <verse eid="MRK 11:1" /><verse number="2" style="v" sid="MRK 11:2" />avalongie, “Mwelele pakijiji chekigehe palutalo gyenu. Pemwingila mula, mumlola mwanapunda avopilwe, yeave kukang'alwa na munu yeyonda. Mdinduwe mumletile kwa nene. <verse eid="MRK 11:2" /><verse number="3" style="v" sid="MRK 11:3" />Ngita munu akivahucha, wuli mwigita ndeni mumlongele, Mtwa akumkela na akumwisa baha badala lya muda mdodo.”<verse eid="MRK 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4" />Suwe, vakahelela, vakamwene mwanapunda awopwilwe paubali lya ng'asi, pepi na mlangilo lwa kaye, <verse eid="MRK 11:4" /><verse number="5" style="v" sid="MRK 11:5" />pevali vakumuwopola, vanu vevakali vevimile pepi bahala pala vakavahucha, “Wuli mwimwopola mwanapunda?” <verse eid="MRK 11:5" /><verse number="6" style="v" sid="MRK 11:6" />Vachulila vakahigila ngita Yesu yeavalongie, vanu vala vakavaleka vahelele na yula mwanapunda. <verse eid="MRK 11:6" /><verse number="7" style="v" sid="MRK 11:7" />Vakamsindika kwa Yesu yula mwanapunda. Vakatalasa myenda gyawo kukyanya lya yula mwanapunda na Yesu kakang'ala kukyanya lyake. <verse eid="MRK 11:7" /><verse number="8" style="v" sid="MRK 11:8" />Vanu volofu vakatandasile myenda gyawo mung'asi, vangi vakatandasile viputila fya mibiki fidodo fyefidumulwe pamigunda kuonesa kumginya. <verse eid="MRK 11:8" /><verse number="9" style="v" sid="MRK 11:9" />Vanu vonda vevalonguwe na vala vevafuatile, vakalonga kwa lisauti likomi, “Njuma afunyilwe yeachile kwa litawa lya Mtwa! <verse eid="MRK 11:9" /><verse number="10" style="v" sid="MRK 11:10" />Ufunyilwe ung'achale wiukwacha va daada vetu Dawudi njuma kwa Nguluvi yeagehe kukyanya hilo!”<verse eid="MRK 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11" />Yesu ayingile ku Yelusalemu akahelela mbaka Kaye lya Nguluvi, akalolile kila kinu unofu. Ila kwa fila ikali palumie, akahelela Betania pamwinga na vala kumi na vavili.<verse eid="MRK 11:11" /></para>
  <para style="s">Yesu akuukotola libiki lya Mtini</para>
  <para style="r">
    <ref loc="MAT 21:18-19">Matayo 21.18-19</ref></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12" />Kilau lyake, pevagehe vihuya Betania, Yesu ivavwa njala. <verse eid="MRK 11:12" /><verse number="13" style="v" sid="MRK 11:13" />Suwe, kwa utali awonile libiki lya Mtini likali na mikwati gyolofu. Akahelela neke awulole ngita yeugehe na manunu. Peafikile, akauwene huwela linunu lyelonda ila mikwati hela, kwakuva ukali sevakati va kubaba manunu. <verse eid="MRK 11:13" /><verse number="14" style="v" sid="MRK 11:14" />Baho akaulongela libiki lya mtini, “Kuhuma neng'uli mbaka figono fyonda munu yeyonda abihile kulia manunu kuhuma kwa veve.” Vachulila vake vakampulika malichwi hago.<verse eid="MRK 11:14" /></para>
  <para style="s">Yesu ekuling'alila Kaye lya Nguluvi</para>
  <para style="r">
    <ref loc="MAT 21:12-17">Matayo 21.12-17</ref>; <ref loc="LUK 19:45-48">Luka 19.45-48</ref>; <ref loc="JHN 2:13-22">Yohani 2.13-22</ref></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15" />Vafikile ku Yelusalemu. Yesu akaingila pa Kaya lya Nguluvi akavanga kuvadaga kwivala vanu vevakali vagucha na kugula vanyama kwajili lya usembe va kunyanya. Akachigalambula mesa cha vala vevakali vebadilisana sendi, na figoda fya vala vevali vigucha ng'unda. <verse eid="MRK 11:15" /><verse number="16" style="v" sid="MRK 11:16" />Akanile munu yeyonda kunyamula kinu kyokyonda mulikanji lya Kaya lya Nguluvi. <verse eid="MRK 11:16" /><verse number="17" style="v" sid="MRK 11:17" />Baho akavawulanicha, “Isimbilwe mumasimbo ga Nguluvi, ‘Kukaye lyangu ikemelwa kaye lya lwifunyo lwa vanu va inyi chonda.’ Ila nyenye mwigitila kuva manga lya vanyaga!”<verse eid="MRK 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18" />Vatekechi vakomi na vawulanichi va malagilicho pevapulike ago, vakavanga kusaka ng'asi lya kumdocha Yesu. Ila vamuwogwipe ali na lipinga likomi lya vanu vadudwive na mawulanichi gyake.<verse eid="MRK 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 11:19" />Peifikile palumie, Yesu na vachulila vake vakahegile kumwani.<verse eid="MRK 11:19" /></para>
  <para style="s">Mawulanichio kuhuma pa libiki lyelikemelwa mtini lyelinyalile</para>
  <para style="r">
    <ref loc="MAT 21:20-22">Matayo 21.20-22</ref></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20" />Nyolasagala, pevakali vekuchumba, vawene libiki lya mtini lyelinyalile kuvangila kukyanya mbaka panyi. <verse eid="MRK 11:20" /><verse number="21" style="v" sid="MRK 11:21" />Peteli iwike na kumlongela Yesu, “Muwulanichi, lole! Lila libiki lya mtini lyeukotue, ugamile!”<verse eid="MRK 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22" />Yesu akavalongie, “Mwidikile Nguluvi. <verse eid="MRK 11:22" /><verse number="23" style="v" sid="MRK 11:23" />Ndikuvalongela ndakyene, munu yeakulongela kidunda iki, ‘Kuhukula ukatagwe muinyanza,’ Ila adikila kuva njowo chonda yeilonga gigitwa, agitilwa njowo icho. <verse eid="MRK 11:23" /><verse number="24" style="v" sid="MRK 11:24" />Kwa ifyo ndikuvalongela, pemfunya na kusuka kinu, mwidikile kuva mupokela, nakyo kivecha kyenu. <verse eid="MRK 11:24" /><verse number="25" style="v" sid="MRK 11:25" />Pemkwima kufunya, muvapyanile nongwa kila munu yeavavifiche kyokyonda, neke Dadie venu yeagehe kuluhano avalekela nongwa chenu na nyenye nogwa chenu.” <verse eid="MRK 11:25" /><verse number="26" style="v" sid="MRK 11:26" />Ila ngita nyenye semuvalekela nongwa vangi, hata Dadie yenu yeagehe kuluhano seakuvalekela nongwa chenu.<verse eid="MRK 11:26" /></para>
  <para style="s">Yesu ewuchwa umwimike lwake</para>
  <para style="r">
    <ref loc="MAT 21:23-27">Matayo 21.23-27</ref>; <ref loc="LUK 20:1-8">Luka 20.1-8</ref></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27" />Suwe, vakafikila kangi ku Yelusalemu. Yesu peakali egenda mu Kaya lya Nguluvi, vatekechi vakomi na vawulanichi va malagicho na vagogolo vamuheleliye, <verse eid="MRK 11:27" /><verse number="28" style="v" sid="MRK 11:28" />Valamuwucha, “Ugita makani aga kwa umwimika va ani? Ndi ani yeakugavile umwimika lya kugita njowo ichi?”<verse eid="MRK 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 11:29" />Yesu akavahigile, “Ndivahucha luhucho limwi, pemunihigila, na nene pia ndikuvalongela ndigita njowo hichi kwa umwimika va ani. <verse eid="MRK 11:29" /><verse number="30" style="v" sid="MRK 11:30" />Mnilongele, umwimike va ubatiso va Yohani Mbatisa uhumile kwa vanu awu uhumile kuluhano kwa Nguluvi?”<verse eid="MRK 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31" />Vakavangile kwiwucha, ngita ngatulonga, gihuma kuluhano kwa Nguluvi daatuhucha, wuli se mumwidikile Yohani mbatisa? <verse eid="MRK 11:31" /><verse number="32" style="v" sid="MRK 11:32" />Ila tukilonga, gihuma kwa vanu, vakaogwipe vanu kwakuva vanu vonda vidikie kuva Yohani Mbatisa akali mvichi va Nguluvi ndakyene. <verse eid="MRK 11:32" /><verse number="33" style="v" sid="MRK 11:33" />Suwe, vakamuhigila Yesu, nefwe setuchela.</para>
  <para style="p" vid="MRK 11:33">Yesu akavalongela, “Nene sendikuvalongela ndigita umwimike ugu kwa umwimike va ani.”<verse eid="MRK 11:33" /></para>
  <chapter eid="MRK 11" />
  <chapter number="12" style="c" sid="MRK 12" />
  <para style="s">Mfanu va mgunda lya misabibu na valimi</para>
  <para style="r">
    <ref loc="MAT 21:33-46">Matayo 21.33-46</ref>; <ref loc="LUK 20:9-19">Luka 20.9-19</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1" />Yesu akavanga kuywanga navo kwa mifanu, munu yumwi alimile mgunda lya misabibu. Anyengetiche lukanji na pagati lyake akagimile kisimo kya valimi difwai, achengile lilingo. Pambele ahadisile mgunda gula kwa vakulima, mwene akahelela painyi lya kutali.<figure style="fig" file="04 Winepress.jpg" size="col" ref="12.1">Vanu vikama sabibu</figure> <verse eid="MRK 12:1" /><verse number="2" style="v" sid="MRK 12:2" />Vakati va mabenelo, amlagichile mnyigendwa vake kwa vala vakulima, amletie masumulo gya mabenelo gya mgunda gwake. <verse eid="MRK 12:2" /><verse number="3" style="v" sid="MRK 12:3" />Vala vakulima vakamwibatile, vamtovile, vakamwisile ahela kinu. <verse eid="MRK 12:3" /><verse number="4" style="v" sid="MRK 12:4" />Akamlagiliche kangi mnyegendwa yungi na yula yeamlagiche vakamlemiche kituwe na vakamwanagile. <verse eid="MRK 12:4" /><verse number="5" style="v" sid="MRK 12:5" />Yula mwunya mgunda akamlagilicha kangi mnyegendwa yungi, vakulima vala vamuhulege. Munya mgunda akavalagilicha vanyigendwa volofu ila vala vakulima vakavatova na vangi vakavadocha. <verse eid="MRK 12:5" /><verse number="6" style="v" sid="MRK 12:6" />Munya mgunda asigie na munu yumwi va kumlagilicha, yula mwana vake yemkelie. Pambele amlagiliche yula mwana vake kuno elonga, vakumginya mwana vangu. <verse eid="MRK 12:6" /><verse number="7" style="v" sid="MRK 12:7" />Ila vala vakulima valonganile, yula nde muhala, mwache tumdoche, neke uhala vake uvecha vetu. <verse eid="MRK 12:7" /><verse number="8" style="v" sid="MRK 12:8" />Ino nde vambatile, vakamdocha na kumtaga kwivala lya gula mgunda lya misabibu. <verse eid="MRK 12:8" /><verse number="9" style="v" sid="MRK 12:9" />“Yesu akavahuchile, mwihocha yula mwene mgunda agita liki? Ekwacha na kuvadocha vala vakulima na kulikodisa hilyo mgunda lya misabibu kwa vanu vangi. <verse eid="MRK 12:9" /><verse number="10" style="v" sid="MRK 12:10" />Wuli semwikwimbile Masimbo haga? ‘Liganga levalikanile vachengaji ino livechile liganga likomi lya palubali. <verse eid="MRK 12:10" /><verse number="11" style="v" sid="MRK 12:11" />Mtwa agitile njowo hilyi, nalyo ndi lya kududwiva mno kwanefwe.!’” <verse eid="MRK 12:11" /><verse number="12" style="v" sid="MRK 12:12" />Vatekechi vakomi na vawulanichi va malagicho na vagogolo vachele lya kuva uwanganicho wula ukali unavahusu. Baho vakagecha kumbata, ila vakaogwipe lipinga lya vanu, vakamleka vakahelela.<verse eid="MRK 12:12" /></para>
  <para style="s">Kuhomba kodi kwa Ng'achale mkomi va Loma</para>
  <para style="r">
    <ref loc="MAT 22:15-22">Matayo 22.15-22</ref>; <ref loc="LUK 20:20-26">Luka 20.20-26</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13" />Suwe, Vafalisayo na lipinga lya Helode vakalagichwa vamgomiche Yesu kwa kumuhucha mahucho. <verse eid="MRK 12:13" /><verse number="14" style="v" sid="MRK 12:14" />Vanu vala vakamweleliye Yesu, vakamlongie, “Muwulanichi, tuchele kuva veve ndi munu mwidikilwa yeulonga ndakyene. Vala seulava ukomi va munu sekinu kwa veve, ila uvafundisa ng'asi lya undakyene va Nguluvi. Ndehalali kuhomba kodi kwa Ng'achale mkomi va Loma, awu sehalali? Tuhombe awu setuhombe?” <verse eid="MRK 12:14" /><verse number="15" style="v" sid="MRK 12:15" />Ila Yesu achele ufyangu vawo, kavalongela, “Wuli mwigecha kunigomicha? Niwonise hilyo sendi.” <verse eid="MRK 12:15" /><verse number="16" style="v" sid="MRK 12:16" />Vakamgavila yila sendi, mwene akavahucha, “Wuso hugu na litawa hilyi lya ani?” Navo vakamwigila, “Lya Ng'achale mkomi va Loma.” <verse eid="MRK 12:16" /><verse number="17" style="v" sid="MRK 12:17" />Suwe, Yesu akavalongie, “Lya Ng'achale mkomi va Loma mgavile Ng'achale mkomi va Loma, na ga Nguluvi mgavile Nguluvi.” Navo vakadudwile mno.<verse eid="MRK 12:17" /></para>
  <para style="s">Yesu ihuchwa njowo lya uchulubuka</para>
  <para style="r">
    <ref loc="MAT 22:23-33">Matayo 22.23-33</ref>; <ref loc="LUK 20:27-40">Luka 20.27-40</ref></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18" />Baho Masadukayo vevakali vilonga kuva kuhela uchulubuko vakamweleliye Yesu, vakamuhucha, <verse eid="MRK 12:18" /><verse number="19" style="v" sid="MRK 12:19" />“Muwulanichi Musa atulagiliche ndeni, ‘Mgosi akifua na kuleka mdala ihela vana, mkolo vake etakilwa amtole neke ambabie lukololwe vake vana.’ <verse eid="MRK 12:19" /><verse number="20" style="v" sid="MRK 12:20" />Suwe, kukali na vakololo saba. Yealongue akatolile mdala, kafua bila kuleka mwana. <verse eid="MRK 12:20" /><verse number="21" style="v" sid="MRK 12:21" />Lukolo vauvili akamtola yula mdala yefiliwe na mgosi vake na mwene akafua bila kuleka mwana, na lukolo va udatu ikavecha ndeni. <verse eid="MRK 12:21" /><verse number="22" style="v" sid="MRK 12:22" />Vonda saba vafue bila kuleka mwana. Pambele yula maye akafua bila kuleka mwana. <verse eid="MRK 12:22" /><verse number="23" style="v" sid="MRK 12:23" />Suwe, kigono kya vanu kuchulubuka, yula mdala ivecha va ani kwakuva akatawike na vakololo vonda saba?”<verse eid="MRK 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24" />Yesu akavalongie, “Nyenye mkosiye kwakuva se mchele Masimbo ga Nguluvi vala ludali lwa Nguluvi. <verse eid="MRK 12:24" /><verse number="25" style="v" sid="MRK 12:25" />Kwakuva vanu pevachulubuka se vatola awu kutawuka, vavecha ngita vandumindumi va kuluhano kwa Nguluvi. <verse eid="MRK 12:25" /><verse number="26" style="v" sid="MRK 12:26" />Ila kwa njowo cha kuchulubuka kwa vafu, wuli semkwimbile kiganulo kya Musa pono pekiandikwe kila kisako kyekikali kikwaka lyoto? Nguluvi avalongile Musa, ‘Nene ndi Nguluvi va Ibulahimu na Nguluvi va Isaka na Nguluvi va Yakobo.’ <verse eid="MRK 12:26" /><verse number="27" style="v" sid="MRK 12:27" />Suwe, mwene se Nguluvi vavanu vevafue, ila ndi Nguluvi va vevagehe wumi. Nyenye mukosele muno.”<verse eid="MRK 12:27" /></para>
  <para style="s">Amuli ngomi</para>
  <para style="r">
    <ref loc="MAT 22:34-40">Matayo 22.34-40</ref>; <ref loc="LUK 10:25-28">Luka 10.25-28</ref></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28" />Muwulanichi yumwi va malagicho akafikile, kavapulika vilongana. Peamuonili Yesu avahigile unofu Masadukayo, nave akajihumiche, akamuhucha, “Pa malagicho lyonda ndi ikwii yeigehe ngomi kuchumba chonda?” <verse eid="MRK 12:28" /><verse number="29" style="v" sid="MRK 12:29" />Yesu akamhigile, lulagilicho lukomi nde ulu, pulike nyenye vanu va Isilaeli! Mtwa Nguluvi vetu, agehe yumwi weka hela. <verse eid="MRK 12:29" /><verse number="30" style="v" sid="MRK 12:30" />Mkele Mtwa Nguluvi vako kwa numbula lyako lyonda na kwa muhe lyako lyonda na kwa luhala lwako lwonda na ludali chako chonda. <verse eid="MRK 12:30" /><verse number="31" style="v" sid="MRK 12:31" />Na amuli lya uvili ilonga ndeni, “Mkele myago ngita wikwikela yuve. Kwahela amuli yingi ngomi kuchumba iyi.”<verse eid="MRK 12:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32" />Yula muwulanichi va malagicho akamlongie Yesu, “Muwulanichi, uwigile unofu kuva Nguluvi ndi yumwi vala kwahela Nguluvi yungi ila yumwene. <verse eid="MRK 12:32" /><verse number="33" style="v" sid="MRK 12:33" />Kumkela Nguluvi kwa numbula lyonda na kwa luhala londa na kwa ludali chonda na kumkela myego ngita akugikela mwene ndi ngiba hilo kuliko kuhumicha usembe na usembe va kunyanya kwa nguluvi.” <verse eid="MRK 12:33" /><verse number="34" style="v" sid="MRK 12:34" />Yesu pewonile kuva munu yula ahigile unofu, akamlongie, “Veve seugehe patali na Ung'achale va Nguluvi.” Kuhuma kigono ikyo kwihela munu yeyonda yeagechile kumuhucha kinu Yesu.<verse eid="MRK 12:34" /></para>
  <para style="s">Kilisito yeahaguliwe na Nguluvi ndi mwana va ani?</para>
  <para style="r">
    <ref loc="MAT 22:41-46">Matayo 22.41-46</ref>; <ref loc="LUK 20:41-44">Luka 20.41-44</ref></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35" />Yesu peagehe kuvafundisa koya Kaye lya Nguluvi, akahucha, wuli vawulanichi va malagilicho vilonga kuva Kilisito ndi kilelo kya Dawudi? <verse eid="MRK 12:35" /><verse number="36" style="v" sid="MRK 12:36" />Dawudi mwene akilonga kwa kulongochwa na Muhe lya Nguluvi akilonga,</para>
  <para style="q" vid="MRK 12:36">Mtwa akamlongie Mtwa vangu.</para>
  <para style="q" vid="MRK 12:36">Kale palubali vangu va kulia,</para>
  <para style="q" vid="MRK 12:36">mbaka ndivavike vachundama vako panyi gya magulu gyako.<verse eid="MRK 12:36" /></para>
  <para style="m">
    <verse number="37" style="v" sid="MRK 12:37" />“Dawudi mwene amkemela Kilisito Mtwa. Kilisito ivecha wuli kuva mwana va Dawudi?”</para>
  <para style="s" vid="MRK 12:37">Yesu akuvakanila vanu vajilole na vawulanichi va malagicho</para>
  <para style="r" vid="MRK 12:37">
    <ref loc="MAT 23:1-36">Matayo 23.1-36</ref>; <ref loc="LUK 20:45-47">Luka 20.45-47</ref></para>
  <para style="p" vid="MRK 12:37">Lipinga lya vanu ukali ukumpulikila kwa lukeduko. <verse eid="MRK 12:37" /><verse number="38" style="v" sid="MRK 12:38" />Peagehe kuvafundisa, Yesu akalonga, “Mwikale kutali na vawulanichi va malagicho. Vawo ukela kugenda vakiva vafalile lihingila mitali na kuhungilwa na vanu kwa uginya pakivanja, <verse eid="MRK 12:38" /><verse number="39" style="v" sid="MRK 12:39" />na kukala pafigoda fya pautalo pa Kaye lya kutang'anila Vayawudi na kwikala pafigoda fyapalutalo mulihungu. <verse eid="MRK 12:39" /><verse number="40" style="v" sid="MRK 12:40" />Vakuvanyaga finu fyawo vadala yevafulilwe na vagosi na vakijigita vifunya lufunyo lutali! Kigono kya muhinga vapatila lihinga ng'ali.”<verse eid="MRK 12:40" /></para>
  <para style="s">Usembe lwa maye yeafwiliwe na mgosi</para>
  <para style="r">
    <ref loc="LUK 21:1-4">Luka 21.1-4</ref></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41" />Yesu akali ikalile pepi na sandiko lya kuhechela usembe. Akalolela vanu volofu yevagehe kuhecha sendi mulisanduku lya lusanja lya Kaye lya Nguluvi. Vamosi vakahechile sendi chongofu. <verse eid="MRK 12:41" /><verse number="42" style="v" sid="MRK 12:42" />Ila maye yumwinga muhangala yeafwiliwe na mgosi akaachile, akahecha sendi chivili ndodo cha shaba. <verse eid="MRK 12:42" /><verse number="43" style="v" sid="MRK 12:43" />Baho Yesu avakemele vachulila vake, kavalongela, “Ndakyene ndikuvalongela, maye uyu muhangala yeafwiliwe na mgosi kavika sendi chongofu mulisanduku lya lusanja kuchumba vanu vonda. <verse eid="MRK 12:43" /><verse number="44" style="v" sid="MRK 12:44" />Kwakuva vongofu vonda vahumiche kuhumila mali chechilutie, ila maye uyu muhangala, ahumiche kila kinu kyenakyo hata kila kyakumtanga kwa kwikala.”<verse eid="MRK 12:44" /></para>
  <chapter eid="MRK 12" />
  <chapter number="13" style="c" sid="MRK 13" />
  <para style="s">Yesu elonga kuhanangwa kwa Kaye lya Nguluvi</para>
  <para style="r">
    <ref loc="MAT 24:1-2">Matayo 24.1-2</ref>; <ref loc="LUK 21:5-6">Luka 21.5-6</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1" />Yesu peakali ahumila pa Kaye lya Nguluvi yumwi va vachulila vake akamlongie, “Muwulanichi, lole miganga haga na kaye hichi gigehe manofu mno!” <verse eid="MRK 13:1" /><verse number="2" style="v" sid="MRK 13:2" />Yesu akahigile akalonga, “Be, wilola kaya hichi ngomi? Kwahela hata liganga limwi yelisigila pakyanya lya lingi, kila kinu kitunyulwa.”<verse eid="MRK 13:2" /></para>
  <para style="s">Utumama na makuda</para>
  <para style="r">
    <ref loc="MAT 24:3-14">Matayo 24.3-14</ref>; <ref loc="LUK 21:7-19">Luka 21.7-19</ref></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3" />Yesu peakali ekalile pakyanya lya kidunda va Miseituni kuno elolela pa Kaye pa Nguluvi, Peteli na Yakobo na Yohani na Andelea vakamuhucha peagehe weka, <verse eid="MRK 13:3" /><verse number="4" style="v" sid="MRK 13:4" />“Tulongele njowo hichi gihumila panili? Kimanyilo liki kiwonesa kuva njowo hichi chigehe pepi kutimila?”<verse eid="MRK 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5" />Yesu akavalongela, “Mwilolele, mubihile kuchangwa na munu yeyonda. <verse eid="MRK 13:5" /><verse number="6" style="v" sid="MRK 13:6" />Kwakuva volofu vekwacha kwa litawa lyangu, kila yumwi yelonga kuva, ‘Nene nde Kilisito!’ Navo vekuvachanga vanu volofu. <verse eid="MRK 13:6" /><verse number="7" style="v" sid="MRK 13:7" />Pempulike kyowo gya fita pepi na lupwepo lwa fita kwa pautali, mbihile kwogofya, njowo hichi gitakilwa kuhumile, ila mwiso wula wave kufikila. <verse eid="MRK 13:7" /><verse number="8" style="v" sid="MRK 13:8" />Vanu va inyi limwi vakwitova na vanu va inyi lingi, ung'achale wimwi utovana na ung'achale wungi, kila pono kuvecha na chiyigayiga na lumyai. Njowo haga ndi ngita ng'eng'enda lya kubaba mwana.”<verse eid="MRK 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9" />Ila nyenye mwilole. Vanu vikuvasindika pidamo na kuvatovanga pa Kaya lya kutang'anila Vayawudi. Mwisindikwa pautalo lya filongosi na vang'achale kwakuva lya nene, neke mvese kuvalongele Njowo Nofu cha Yesu. <verse eid="MRK 13:9" /><verse number="10" style="v" sid="MRK 13:10" />Ila yitakilwa Njowo Nofu idalikwe tandi kwa vanu va inyi yonda kabula lya kigono kya mwiso kwacha. <verse eid="MRK 13:10" /><verse number="11" style="v" sid="MRK 13:11" />Navo pevabatile na kuvasindika pidamo, mbihile kwogopa mwilonga liki. Saa yila payifikila, mlonge kyokyonda kyemgavilwa kwakuva senyenye yemwiilonga, ila Muhe lya Nguluvi. <verse eid="MRK 13:11" /><verse number="12" style="v" sid="MRK 13:12" />Lukolo akumkanila lukolo vake adochwe, daada akumkanila mwana vake, vana navo vakuvalema vasasi vawo na kuvadocha. <verse eid="MRK 13:12" /><verse number="13" style="v" sid="MRK 13:13" />Vanu vonda vekuvavipila nyenye kwakuva lya nene. Ila yeanifumilila mbaka kumwiso ndiye yeiwokolewa.<verse eid="MRK 13:13" /></para>
  <para style="s">Utatala ukomi</para>
  <para style="r">
    <ref loc="MAT 24:15-28">Matayo 24.15-28</ref>; <ref loc="LUK 21:20-24">Luka 21.20-24</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14" />Pamuwonela kinu kyeakukivipila Nguluvi kiimile sepono lyake, mkwimbaji na achele mana lyake, baho vale vevagehe Yudea vanyilie pafidunda. <verse eid="MRK 13:14" /><verse number="15" style="v" sid="MRK 13:15" />Yeagehe kukyanya lya kituvili lya kaye abihile kwika kwiingila mukaye mwake kunyamula kinu. <verse eid="MRK 13:15" /><verse number="16" style="v" sid="MRK 13:16" />Yeagehe kumgunda abihile kuwuya kukaye kutegula mwenda vake. <verse eid="MRK 13:16" /><verse number="17" style="v" sid="MRK 13:17" />Mwilava nye vadala vevali na lisololo na yevakukong'elecha vana figono ifyo! <verse eid="MRK 13:17" /><verse number="18" style="v" sid="MRK 13:18" />Msuke kwa Nguluvi neke njowo hulu lubihile kuhumila chipindi va ng'ala. <verse eid="MRK 13:18" /><verse number="19" style="v" sid="MRK 13:19" />Kwakuva chipindi hugo kuvecha na utatala ambayo seihumile kuhuma pamwandi Nguluvi pawumbile inyi mbaka neng'uli, vala seihumila kangi.<verse eid="MRK 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 13:20" />Ngita Mtwa ngaabihile kupwamsa figono ifyo kwahela munu ngawokolilwe. Ila kwa vala vanu yeavahaguwe, Mtwa apwamse figono ifyo. <verse eid="MRK 13:20" /><verse number="21" style="v" sid="MRK 13:21" />“Suwe munu akivalongela, ‘Lole, Kilisito yeahaguliwe na Nguluvi agehe baha,’ awu ‘Agehe pala,’ mubihile kudikila. <verse eid="MRK 13:21" /><verse number="22" style="v" sid="MRK 13:22" />Kwakuva vihumila vakina Makilisitu yesevahaguliwe na Nguluvi va na vavichi va udesi, vikugita fimanyilo na umunyitu kwa ajili lya kuvachanga ngita ivesekana hata vala yeavahaguwe Nguluvi. <verse eid="MRK 13:22" /><verse number="23" style="v" sid="MRK 13:23" />Ila nyenye mujilole. Nene ndivalongie makani gyonda kabula segahumie.<verse eid="MRK 13:23" /></para>
  <para style="s">Kwacha kwa Mwana va Munu</para>
  <para style="r">
    <ref loc="MAT 24:29-31">Matayo 24.29-31</ref>; <ref loc="LUK 21:25-28">Luka 21.25-28</ref></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24" />“Suwe, figono ifyo, peuchumbile utatala hilyo, lichuwa livikwa kisi na mwechi seulangacha. <verse eid="MRK 13:24" /><verse number="25" style="v" sid="MRK 13:25" />Nondwa chigua kuhuma kulifunde, na ludali cha kulifunde chihogoseka.” <verse eid="MRK 13:25" /><verse number="26" style="v" sid="MRK 13:26" />Bawo vekumlola Mwana va Munu ikwacha mulifunde kwa ludali chingi na ukomi. <verse eid="MRK 13:26" /><verse number="27" style="v" sid="MRK 13:27" />Naye hekuvalagicha vandumindumi va kuluhano vavalundise vanu vevahaguliwe na Nguluvi kuhuma palubali chonda chitai cha inyi, kuhuma kumwiso va inyi mbaka kumwiso va luhano.<verse eid="MRK 13:27" /></para>
  <para style="s">Mfanu va libiki lya mtini</para>
  <para style="r">
    <ref loc="MAT 24:32-35">Matayo 24.32-35</ref>; <ref loc="LUK 21:29-33">Luka 21.29-33</ref></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28" />“Mulolele libiki lya mtini na mwifundise uwanganicho hugu. Pemuwonile mimagwa lyake gyevanga kuva lideke na kuhomola mikwati, mwichela kuva chipindi va mabenelo upepi. <verse eid="MRK 13:28" /><verse number="29" style="v" sid="MRK 13:29" />Fifyo ifyo na nyenye pemuwonile finu ifyo pefihumila muchele kuva Mwana va Munu agehe pepi mno. <verse eid="MRK 13:29" /><verse number="30" style="v" sid="MRK 13:30" />Ndikuvalongela ndakyene, kilelo hichi sekichumba mbaka finu ifyo fyonda pefihumila. <verse eid="MRK 13:30" /><verse number="31" style="v" sid="MRK 13:31" />Luhano na inyi fichumba, ila malichwi gya nene segachumba ng'odo.<verse eid="MRK 13:31" /></para>
  <para style="s">Kwahela yeachele kigono vala saa</para>
  <para style="r">
    <ref loc="MAT 24:36-44">Matayo 24.36-44</ref></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32" />“Ila kigono na saa kwahela yeyonda yeachele, vala vandumindumi va kuluhano kwa Nguluvi, vala Mwana, ila Dadi weka hela yeachele. <verse eid="MRK 13:32" /><verse number="33" style="v" sid="MRK 13:33" />Mwilole na mwiwope, kwakuva semchele chipindi hugo ufikila pandili. <verse eid="MRK 13:33" /><verse number="34" style="v" sid="MRK 13:34" />Ivecha ngita munu yeahega kukaye kuhelela kumagendo akivalekela vanyegendwa vake kuhilolela kaye, kila yumwi na kasi lyake na akamlongie na mdimaji va mlyangilo ave mewo. <verse eid="MRK 13:34" /><verse number="35" style="v" sid="MRK 13:35" />Mwiwope kwakuva semchela mwene kaye ewuya pandili, kuva palumie awu mwilogati awu mbungamie awu pamilau. <verse eid="MRK 13:35" /><verse number="36" style="v" sid="MRK 13:36" />Mwiwope neke achile gafula abihile kuvalola muvasile. <verse eid="MRK 13:36" /><verse number="37" style="v" sid="MRK 13:37" />Lila lendivalongela nyenye, ndikuvalongela vanu vonda, mwiwope!”<verse eid="MRK 13:37" /></para>
  <chapter eid="MRK 13" />
  <chapter number="14" style="c" sid="MRK 14" />
  <para style="s">Mpango va kumdocha Yesu</para>
  <para style="r">
    <ref loc="MAT 26:1-5">Matayo 26.1-5</ref>; <ref loc="LUK 22:1-2">Luka 22.1-2</ref>; <ref loc="JHN 11:45-53">Yohani 11.45-53</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1" />Ikali isigalie figono fivili hela kufikila lihungu lya Pasaka na lihungu lya mibumunda sevikilwe lisimika. Vatekechi vakomi na vawulanichi va malagicho vakali kusaka ng'asi cha udesi cha kumbata Yesu kwa ila na vamdoche. <verse eid="MRK 14:1" /><verse number="2" style="v" sid="MRK 14:2" />Ila vakalongile, “Tubihile kumbata chipindi va lihungu lya Pasaka vanu viwesa kugita ndewo.”<verse eid="MRK 14:2" /></para>
  <para style="s">Yesu isukuliwa manung'ililo koya Betania</para>
  <para style="r">
    <ref loc="MAT 26:6-13">Matayo 26.6-13</ref>; <ref loc="JHN 12:1-8">Yohani 12.1-8</ref></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3" />Yesu akali Kubetania, kukaye lya Simoni yeali itamika ukalavilo. Peakali kuliya kyakuliya kya palumie, akaachile maye ali na bochobocho lya mafuta gya kunung'ilila unofu gyene samani ngomi. Akalidenyile lila libochobocho, na kumbaka Yesu mafuta palituwe lyake. <verse eid="MRK 14:3" /><verse number="4" style="v" sid="MRK 14:4" />Vanu vevagehe bahala pala vakavipile mno, vakali vihuchana, “Wuli manung'ililo haga ga sendi ngomi giyaga hela? <verse eid="MRK 14:4" /><verse number="5" style="v" sid="MRK 14:5" />Manung'ililo haga gageveswa kuguchwa kwa sendi cholofu mno na sendi hicho vagavilwe vanu vahangala!” Vakamlakie yula maye mno. <verse eid="MRK 14:5" /><verse number="6" style="v" sid="MRK 14:6" />Ila Yesu akavalongile, “Mumleke, wuli mukumsumbula? Anigitile njowo nofu. <verse eid="MRK 14:6" /><verse number="7" style="v" sid="MRK 14:7" />Vahangala mwigehe navo pamwinga figono fyonda, muvesa kuvatanga chipindi vovonda yemwikela. Ila nene sendivecha na nyenye figono fyonda. <verse eid="MRK 14:7" /><verse number="8" style="v" sid="MRK 14:8" />Maye uyu agitile lyavesile. Kalongola kubaka mvili vangu manung'ililo, kuuvika unofu kwa magubukilo. <verse eid="MRK 14:8" /><verse number="9" style="v" sid="MRK 14:9" />Ndikuvalongela ndakyene, peponda pa inyi Njowo Nofu pechidalikwa, gito ili cheagitile itambulwa kwa kumuwuka yumwene.”<verse eid="MRK 14:9" /></para>
  <para style="s">Yuda idikila kumkana Yesu</para>
  <para style="r">
    <ref loc="MAT 26:14-16">Matayo 26.14-16</ref>; <ref loc="LUK 22:3-6">Luka 22.3-6</ref></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10" />Baho Yuda Sikaliyoti, yumwi va vala kumi na vavili, akahele kwa vatekechi vakomi neke kumseduka Yesu. <verse eid="MRK 14:10" /><verse number="11" style="v" sid="MRK 14:11" />Vatekechi vakomi pevapulike njowo hilyo, vakedwike, vakamlongie kumgavila sendi. Suwe, Yuda akavangile kusaka chipindi va kumseduka.<verse eid="MRK 14:11" /></para>
  <para style="s">Yesu ekuliya kyakula kya Pasaka na vachulila vake</para>
  <para style="r">
    <ref loc="MAT 26:17-25">Matayo 26.17-25</ref>; <ref loc="LUK 22:7-14">Luka 22.7-14</ref>,<ref loc="LUK 22:21-23">21-23</ref>; <ref loc="JHN 13:21-30">Yohani 13.21-30</ref></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12" />Kigono kya kwansa lya lihungu lya mibumunda segivikwa lisimika, chipindi vakuhinja mwana kondolo va Pasaka, vachulila vake vakamuhuchile, “Ukela kulia kwii lihungu lya Pasaka?” <verse eid="MRK 14:12" /><verse number="13" style="v" sid="MRK 14:13" />Suwe, Yesu akavalagiliche vachulila vake vavili kavalongile, “Muhelele kumwani na koya mwitang'ana na mgosi yumwi anyamuwe kichoba kya malenga. Mumfuate, <verse eid="MRK 14:13" /><verse number="14" style="v" sid="MRK 14:14" />mbaka kukaye yeikwingila, mkamlongie mwene kaya, ‘Muwulanichi alongile, kigehe kwiya kyumba kyangu kya vagenji kyakulilya lihungu lya Pasaka pamwinga na vachulila vangu?’ <verse eid="MRK 14:14" /><verse number="15" style="v" sid="MRK 14:15" />Nave akuvawonesa kyumba kikomi kudali kitayaliswe sue. Mutwandalisiye mula.” <verse eid="MRK 14:15" /><verse number="16" style="v" sid="MRK 14:16" />Vachulila vakahegile, vakahele kumwani, vakawene kila kinu kigehe unofu ngita Yesu avalongile. Ndena vakaandalisa kyakula kya lihungu lya Pasaka. <verse eid="MRK 14:16" /><verse number="17" style="v" sid="MRK 14:17" />Peifikile palumiye, Yesu afikile pamwinga na vachulila vake kumi na vavili. <verse eid="MRK 14:17" /><verse number="18" style="v" sid="MRK 14:18" />Pevagehe kulia kyakula, Yesu akavalongie, “Ndakyene ndikuvalongela, myenu yumwi yeilya sahani yimwinga na nene, akuniseduka.”<verse eid="MRK 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19" />Bahala vachulila vake vakavanga kuswigima vakamuhucha Yesu, “Nde ani?” <verse eid="MRK 14:19" /><verse number="20" style="v" sid="MRK 14:20" />Yesu akavalongiye, “Yumwi venu nyenye kyumi na vavili, yeichwika libumunda pamwi na nene mukimbundi. <verse eid="MRK 14:20" /><verse number="21" style="v" sid="MRK 14:21" />Ndakyene Mwana va Munu ifua ngita Masimbo Mang'alile gyegilonga. Ila ole vake munu yula yeakumseduka Mwana va Munu! Ngiba munu uyu sehababilwe!”<verse eid="MRK 14:21" /></para>
  <para style="s">Kyakula kya Mtwa</para>
  <para style="r">
    <ref loc="MAT 26:26-30">Matayo 26.26-30</ref>; <ref loc="LUK 22:14-20">Luka 22.14-20</ref>; <ref loc="1CO 11:23-25">Vakolindo 11.23-25</ref></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22" />Pevagehe kulya, Yesu kanyamula libumunda, akamuhongiche Nguluvi kadumula na kuvagavila vachulila vake peilonga, “Mnyamule, ugu ndi mvili vangu.”<verse eid="MRK 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 14:23" />Kangi, akanyamula kikombe kya difai, akamuhongiche Nguluvi, akavagavile vachulila vake, vonda vakanywelie kikombe kila, <verse eid="MRK 14:23" /><verse number="24" style="v" sid="MRK 14:24" />akavalongie, “Iyi ndi danda lyangu yeisibitisa Lyagano lya Nguluvi, danda yeisukwika kwajili lya vanu volofu. <verse eid="MRK 14:24" /><verse number="25" style="v" sid="MRK 14:25" />Ndakyene ndikuvalongela, sendinyuwa kangi difai lya sabibu mbaka kigono kila pendinyuwa umiya pa Ung'achale va Nguluvi.” <verse eid="MRK 14:25" /><verse number="26" style="v" sid="MRK 14:26" />Kangi vakaimbile wimbo, vakahega, vakahelela pa kidunda va Miseituni.<verse eid="MRK 14:26" /></para>
  <para style="s">Yesu ilagula kuva Peteli ekumkana</para>
  <para style="r">
    <ref loc="MAT 26:31-35">Matayo 26.31-35</ref>; <ref loc="LUK 22:31-34">Luka 22.31-34</ref>; <ref loc="JHN 13:36-38">Yohani 13.36-38</ref></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27" />Yesu akavalongie vachulila vake, “Nyenye vonda mwenileka, kwakuva Masimbo Mang'alile gyilonga, ‘Ndikumtova mtekechi, nawo kondolo viyaganika koya na koya.’ <verse eid="MRK 14:27" /><verse number="28" style="v" sid="MRK 14:28" />Ila pendichulubuka, ndikuvalongola kula ku Galilaya.” <verse eid="MRK 14:28" /><verse number="29" style="v" sid="MRK 14:29" />Peteli akamlongie, “Hata ngita vangi vonda vekukuleka, nene sendikuleka ng'odo!” <verse eid="MRK 14:29" /><verse number="30" style="v" sid="MRK 14:30" />Yesu akamlongie Peteli, “Ndakyene ndikukulongela, neng'uni, pamie hugu, kabula livisi seiwika mala chivili, ukunikanila mala chidatu.” <verse eid="MRK 14:30" /><verse number="31" style="v" sid="MRK 14:31" />Ila Peteli kamlongela, “Hata ngita nditakilwa kufua pamwinga nave, sendikuleka ng'odo.” Vachulila vonda vakalongile ndeni.<verse eid="MRK 14:31" /></para>
  <para style="s">Yesu isuka pa mgunda mdodo Getisemane</para>
  <para style="r">
    <ref loc="MAT 26:35-46">Matayo 26.35-46</ref>; <ref loc="LUK 22:39-46">Luka 22.39-46</ref></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32" />Suwe, vakafikile pa mgunda mdodo ukemelwe Gatesemane. Yesu akavalongela vachulila vake, “Mwikale baha chipindi nene ndifunya.” <verse eid="MRK 14:32" /><verse number="33" style="v" sid="MRK 14:33" />Baho akavanyamula peteli na Yakobo na Yohani, akavanga kuswigima na kutumama. <verse eid="MRK 14:33" /><verse number="34" style="v" sid="MRK 14:34" />Akavalongie, “Numbula vangu imemile na lusugimo mkomi hata pepi kufua. Mwikale baha na mbihile kuvasa mkisuka.”<verse eid="MRK 14:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 14:35" />Akahela pautalo padodo, ague panyi lufuma akasuka akilonga, ngita ivechekanika seaichumbile saa hilyo lya magudo. <verse eid="MRK 14:35" /><verse number="36" style="v" sid="MRK 14:36" />Akalonga, “Daada vangu, kwa veve makani gonda givesekanika. Unihechele kikombe hiki, ila seiveche ngita ndikelafyo nene, ila ukelafyo veve.” <verse eid="MRK 14:36" /><verse number="37" style="v" sid="MRK 14:37" />Yesu awuyile kwa vachulila vala vadatu, akavawene vavasile. Suwe, akamuhucha Peteli, “Simoni, uvasile? Be seuvesile kuvecha meho hata lisaa limwi?” <verse eid="MRK 14:37" /><verse number="38" style="v" sid="MRK 14:38" />Avalongie kangi, “Mveche meho na kusuka neke mbihile kwingila mmagecho. Muhe ikela, ila mvili uhela ludali.” <verse eid="MRK 14:38" /><verse number="39" style="v" sid="MRK 14:39" />Akahele kusuka kangi akawuyila malichwi gagala. <verse eid="MRK 14:39" /><verse number="40" style="v" sid="MRK 14:40" />Akawuyile kangi, akavawene vavasile. Kwakuva mewo gyaho gamemile tulo, sevachele lya kumuhiga. <verse eid="MRK 14:40" /><verse number="41" style="v" sid="MRK 14:41" />Peachile mala lya udatu akavalongie, “Mwave mwivasa na kutulula? Ino mlamke! Vakati ufikile! Mwana va Munu vakumtawula kwa vanu vawofu venye sambi. <verse eid="MRK 14:41" /><verse number="42" style="v" sid="MRK 14:42" />Mlamke na tuhelele setu lole yula mkanila vangu ekwacha.”<verse eid="MRK 14:42" /></para>
  <para style="s">Yesu ibatwa</para>
  <para style="r">
    <ref loc="MAT 26:47-56">Matayo 26.47-56</ref>; <ref loc="LUK 22:47-53">Luka 22.47-53</ref>; <ref loc="JHN 18:3-12">Yohani 18.3-12</ref></para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43" />Yesu peali ave kuywanga, Yuda, yumwinga va vala kumi na vavili, akafikile pamwinga na lipinga lya vanu vevali na mipanga na findonga. Vanu havo valagilichwe na vatekechi vakomi, vawulanichi va malagicho na vavaha. <verse eid="MRK 14:43" /><verse number="44" style="v" sid="MRK 14:44" />Yuda Isikalioti akali avagavile kimanyilo, “Yula yendikumnonela ndi mwene, mumbate na kumnyamula.” <verse eid="MRK 14:44" /><verse number="45" style="v" sid="MRK 14:45" />Yuda peafikile hela, kamuheleliya Yesu, kamlongela, “Rabi” mana lyake “Muwulanichi!” Akamkumbatila. <verse eid="MRK 14:45" /><verse number="46" style="v" sid="MRK 14:46" />Baho vala vanu vakambatile Yesu, na kumdima abihile kuhega. <verse eid="MRK 14:46" /><verse number="47" style="v" sid="MRK 14:47" />Yumwi va vala vevakali vihimila bahala pala pamwinga na Yesu, akahomola lipanga lyake, akamtovile mnyengendwa va mtekechi mkomi na kumdumula lisigicha. <verse eid="MRK 14:47" /><verse number="48" style="v" sid="MRK 14:48" />Yesu avalongie, “Wuli mwachile na mipanga na findonga kunibata ngita nene ndinyamula finu fya vanu kwa ludali? <verse eid="MRK 14:48" /><verse number="49" style="v" sid="MRK 14:49" />Figono fyonda ndalipamwinga na nyenye pendiwulanicha pa Kaye lya Nguluvi, vala semwibatile. Ila ino yitakilwa Masimbo Mang'alile gyatimile.” <verse eid="MRK 14:49" /><verse number="50" style="v" sid="MRK 14:50" />Bawo vachulila vonda vakamlekile, vakanyilile. <verse eid="MRK 14:50" /><verse number="51" style="v" sid="MRK 14:51" />Kukali na mdimi yumwi yeakali amfutila Yesu akiva afwulile mgololo mvalafu. Navo vakasakile kumbata. <verse eid="MRK 14:51" /><verse number="52" style="v" sid="MRK 14:52" />Ila mwene akasulubuka, akaulekile wula mgololo mvalafu, akanyilile bila mgololo mvalafu.<verse eid="MRK 14:52" /></para>
  <para style="s">Yesu agehe pautalo palidamo lya vavaha</para>
  <para style="r">
    <ref loc="MAT 26:57-68">Matayo 26.57-68</ref>; <ref loc="LUK 22:54">Luka 22.54</ref>,<ref loc="LUK 22:55">55</ref>,<ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:13">Yohani 18.13</ref>,<ref loc="JHN 18:14">14</ref>,<ref loc="JHN 18:19-24">19-24</ref></para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53" />Suwe, vakamsindika Yesu kwa mtekechi mkomi na vatekechi vakomi vonda, vagogolo na vawulanichi va malagicho koya vilundise. <verse eid="MRK 14:53" /><verse number="54" style="v" sid="MRK 14:54" />Peteli amfuatile Yesu kwa utali, akaingiye mulidamwa lwa mtekechi mkomi, akaliye pamwinga na vadimaji akilota lyoto. <verse eid="MRK 14:54" /><verse number="55" style="v" sid="MRK 14:55" />Vatekechi vakomi na vanu vonda va Lidamo likomi vakasakile malichwi gegakumgita Yesu kudochwa, ila sevaupatile. <verse eid="MRK 14:55" /><verse number="56" style="v" sid="MRK 14:56" />Vanu volofu vakaimile na kulonga udesi neke kumlata Yesu, ila malichwi gyawo segawanine. <verse eid="MRK 14:56" /><verse number="57" style="v" sid="MRK 14:57" />Vangi vahimile na kulonga udesi na kulonga, <verse eid="MRK 14:57" /><verse number="58" style="v" sid="MRK 14:58" />“Tumpulike munu uyu ikilonga, ‘Ndikuiananga Kaya lya Nguluvi hilyi yevachengili kwa mawoko gya vanu na kwa figono fidatu ndichenga yingi yeselichengilwe kwa mawoko gya vanu.’” <verse eid="MRK 14:58" /><verse number="59" style="v" sid="MRK 14:59" />Ila hata ifyo, malichwi gyawo segawanine. <verse eid="MRK 14:59" /><verse number="60" style="v" sid="MRK 14:60" />Suwe, Mtekechi Mkomi imile pautalo lyawo, akamuhuchile Yesu, “Be veve seuvesa kuhiga malata haga ambago vanu hava valetile kukyanya lyako?” <verse eid="MRK 14:60" /><verse number="61" style="v" sid="MRK 14:61" />Ila mwene akachikile, sealongile hata lichwi limwi. Mtekechi Mkomi akamuhucha kangi, “Be veve nde Kilisito yeaguliwe na Nguluvi, Mwana va Nguluvi Mfunyilwa?” <verse eid="MRK 14:61" /><verse number="62" style="v" sid="MRK 14:62" />Yesu akahigile, “Ndakyene nene. Kangi, mukumuwona Mwana va Munu akalile ubali va kulia va Nguluvi munya ludali, ikwacha pa mafunde gya kuluhano.” <verse eid="MRK 14:62" /><verse number="63" style="v" sid="MRK 14:63" />Baho Mtekechi Mkomi akatatula liingila lyake na akalonga, “Twikela malichwi liki kangi gya kumlata? <verse eid="MRK 14:63" /><verse number="64" style="v" sid="MRK 14:64" />Mpulike peakumliga Nguluvi! Nyenye mulola wuli?”</para>
  <para style="p" vid="MRK 14:64">Vonda vakamuhinga kuva akunjumwa kudochwa.<verse eid="MRK 14:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MRK 14:65" />Suwe, vangi vakavanga kumfunyila miti, vakamuhopila mwenda meho, vakamtovile na kumlongela, “Lotele ani akutovile!” Vadima vakamnyamula na kumtova mimbata.<verse eid="MRK 14:65" /></para>
  <para style="s">Peteli akumkana Yesu</para>
  <para style="r">
    <ref loc="MAT 26:69-75">Matayo 26.69-75</ref>; <ref loc="LUK 22:56-62">Luka 22.56-62</ref>; <ref loc="JHN 18:15-18">Yohani 18.15-18</ref>,<ref loc="JHN 18:25-27">25-27</ref></para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66" />Peteli peakali ave panyi kulidamwa, akahachile yumwi va mnyingendwa va mdala va Mtekechi Mkomi, <verse eid="MRK 14:66" /><verse number="67" style="v" sid="MRK 14:67" />peamuwonile Peteli akilota lyoto, akamuhumichie meho! Akamlongiye, “Hata veve ukali pamwinga na Yesu Mnasaleti.” <verse eid="MRK 14:67" /><verse number="68" style="v" sid="MRK 14:68" />Ila Peteli akakanile, “Sendichele, vala sendimanya kyeulonga!” Baho Peteli akahegele, akahelela pono pakwiingilila. Baho livisi akawikile. <verse eid="MRK 14:68" /><verse number="69" style="v" sid="MRK 14:69" />Yula mnyengendwa peamuwonile kangi Peteli, akavanga kangi kuvalongela vanu vevakali vihimile baho, “Munu uyu ndi yumwinga vawo.” <verse eid="MRK 14:69" /><verse number="70" style="v" sid="MRK 14:70" />Peteli akakanila kangi. Pambele ludodo, vanu vevali vihimile baho vakamlongie Peteli, “Ndakyene veve ndi yumwinga vawo, kwakuva veve ndi Mgalilaya.” <verse eid="MRK 14:70" /><verse number="71" style="v" sid="MRK 14:71" />Ila Peteli akavanga kukotola na kwiilapa, akavalongie, “Nene sendimchele munu uyu yemukumlonga njowo lwake.” <verse eid="MRK 14:71" /><verse number="72" style="v" sid="MRK 14:72" />Baho livisi akawikile mala lya uvili. Suwe, Peteli iwikile pealongilwe na Yesu. “Kabula livisi kuwika mala chivili, ukunikanila mala chidatu.” Peteli avembile.<verse eid="MRK 14:72" /></para>
  <chapter eid="MRK 14" />
  <chapter number="15" style="c" sid="MRK 15" />
  <para style="s">Yesu esindikwa kwa Pilato</para>
  <para style="r">
    <ref loc="MAT 27:1-2">Matayo 27.1-2</ref>,<ref loc="MAT 27:11-14">11-14</ref>; <ref loc="LUK 23:1-5">Luka 23.1-5</ref>; <ref loc="JHN 18:28-38">Yohani 18.28-38</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1" />Pembungamiye, vatekechi vakomi vakatanganile pamwinga na vagogolo, vawulanichi va malagicho na ludamo londa lya vayawudi, vakamuwopile Yesu kwa mnyololo, vakamsendika kwa Pilato. <verse eid="MRK 15:1" /><verse number="2" style="v" sid="MRK 15:2" />Pilato akamuhucha Yesu, “Be veve ndi ng'achale va Vayawudi?” Yesu akahigile, “Igehe ngita peilonga veve.” <verse eid="MRK 15:2" /><verse number="3" style="v" sid="MRK 15:3" />Vatekechi vakomi vakamlata Yesu kwa makani gyolofu. <verse eid="MRK 15:3" /><verse number="4" style="v" sid="MRK 15:4" />Pilato akamuhucha kangi Yesu, “Wuli sewihiga kinu? Lole vevihumicha malata gyolofu kukyanya lyako.” <verse eid="MRK 15:4" /><verse number="5" style="v" sid="MRK 15:5" />Ila Yesu seahigile kinu, Pilato akadudwive.<verse eid="MRK 15:5" /></para>
  <para style="s">Yesu akuhingwa kudochwa</para>
  <para style="r">
    <ref loc="MAT 27:15-26">Matayo 27.15-26</ref>; <ref loc="LUK 23:13-25">Luka 23.13-25</ref>; <ref loc="JHN 18:39-19:16">Yohani 18.39—19.16</ref></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6" />Kila chipindi va lihungu lya Pasaka, Pilato akali na achoviye kumdindulia munu yeali mukihopo yeikelwa na vanu. <verse eid="MRK 15:6" /><verse number="7" style="v" sid="MRK 15:7" />Vakati hugo pakali na munu yumwi yeakemelwe Balaba akali adindilwe pamwinga na vanu yevaukanile ulongosi na vakagitile madocho makomi chipindi va ndewo. <verse eid="MRK 15:7" /><verse number="8" style="v" sid="MRK 15:8" />Vanu volofu vamuhelelie Pilato na vamsukile avagitile ngita peachovie. <verse eid="MRK 15:8" /><verse number="9" style="v" sid="MRK 15:9" />Pilato avahuchile, “Wuli mwikela ndivadinduliye Ng'achale va Vayawudi?” <verse eid="MRK 15:9" /><verse number="10" style="v" sid="MRK 15:10" />Pilato alongile ndena kwakuva achele kuva vatekechi vakomi vamsindikile Yesu kwamwene kwakuva lya wifu. <verse eid="MRK 15:10" /><verse number="11" style="v" sid="MRK 15:11" />Ila vatekechi vakomi vakavafung'achile vanu vamsuke Pilato avadindulie Balaba. <verse eid="MRK 15:11" /><verse number="12" style="v" sid="MRK 15:12" />Pilato avahuchile kangi, “Ino mwisaka ndigite wuli na munu uyu yemukumkemela Ng'achale va Vayawudi?” <verse eid="MRK 15:12" /><verse number="13" style="v" sid="MRK 15:13" />Vanu vonda vakalonga kwa lisauti likomi kangi, “Akong'olewe pa kipindilihicho!” <verse eid="MRK 15:13" /><verse number="14" style="v" sid="MRK 15:14" />Pilato akavahucha, “Wuli! Agitile lihofu liki?” Ila vene vahendelile kutova kyowo mno, “Akong'olewe pa kipindilihicho!” <verse eid="MRK 15:14" /><verse number="15" style="v" sid="MRK 15:15" />Pilato asakile kuvakedusa lila lipinga lya vanu, suwe akamuhumiche Balaba kuhuma mukihopo. Akavalongie Yesu atovwe ndomondo, pambele akamuhumiche akong'olwe pa kipindilihicho.<verse eid="MRK 15:15" /></para>
  <para style="s">Vapuga vakumbeda Yesu</para>
  <para style="r">
    <ref loc="MAT 27:27-31">Matayo 27.27-31</ref>; <ref loc="JHN 19:2-3">Yohani 19.2-3</ref></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16" />Baho vipuga vakamsindike Yesu mgati lya lidamwa, ku utengule na vakavakemela vapuga vonda. <verse eid="MRK 15:16" /><verse number="17" style="v" sid="MRK 15:17" />Vakamfwalisile liingila lya langi lya sambalawu, vakabotile ingela lya mihomi, vakamfwalisile palituwe. <verse eid="MRK 15:17" /><verse number="18" style="v" sid="MRK 15:18" />Vakavangila kumuhungila kwa kumbeda, “Aisenga Ng'achale va Vayawudi!” <verse eid="MRK 15:18" /><verse number="19" style="v" sid="MRK 15:19" />Vakamtovile kwa lidenge pamtuwe, vakamfunyila miti, vakamfugamilie pautalo lyake na kumgundamila. <verse eid="MRK 15:19" /><verse number="20" style="v" sid="MRK 15:20" />Pevambedile, vakamfulile lila liingila lya sambalau, vakamfwalila myenda gyake, pambele vakamuhumicha kwivala vakamsindika neke vamkong'olile pa kipindilihicho.<verse eid="MRK 15:20" /></para>
  <para style="s">Yesu ikong'olelwa mupindilihicho</para>
  <para style="r">
    <ref loc="MAT 27:32-44">Matayo 27.32-44</ref>; <ref loc="LUK 23:26-43">Luka 23.26-43</ref>; <ref loc="JHN 19:17-27">Yohani 19.17-27</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21" />Pevakali mung'asi, vatang'anile na munu yumwi akemelwe litawa lyake Simoni, munu va Kileni, dadi vawo Alekisanda na Lufu na chipindi hugo akali ihuma kwivala lya kumwani, vapuga vakasakile yula munu ategule kipindilihicho lya Yesu. <verse eid="MRK 15:21" /><verse number="22" style="v" sid="MRK 15:22" />Baho vakamsindike Yesu hadi pono pakemeliwe Goligota, mana lyake pono pa Lifufu lya Mtuwe. <verse eid="MRK 15:22" /><verse number="23" style="v" sid="MRK 15:23" />Vakamgavile difayi yeihanganiswe na mgoda ukemelwe manemane, ila mwene kalema kunyua. <verse eid="MRK 15:23" /><verse number="24" style="v" sid="MRK 15:24" />Suwe, vakamkong'olela pa kipindilihicho na mwenda gyake vakagawine mugati mwao kwa kuchitovela kula valaamule ani agavilwa liki. <verse eid="MRK 15:24" /><verse number="25" style="v" sid="MRK 15:25" />Yali saa datu pamilau pevamkong'olie pa kipindilihicho <verse eid="MRK 15:25" /><verse number="26" style="v" sid="MRK 15:26" />Liyandikilwe landulo lya nongwa lyake, “Ng'achale va Vayawudi” <verse eid="MRK 15:26" /><verse number="27" style="v" sid="MRK 15:27" />Filefile vakavakong'olela vanyaga vavili pamwinga na Yesu kila mwinga palipindilihicho lyake yungi palubali lya kulia na yungi palubali lwa kusoto. <verse eid="MRK 15:27" /><verse number="28" style="v" sid="MRK 15:28" />Nago mayandiko gatimile, gala ge galongilwe, “Avalililwe pamwinga na vagita sambi” <verse eid="MRK 15:28" /><verse number="29" style="v" sid="MRK 15:29" />Vanu pevali vechumba paoono ipo vamonile, vatikisile mituwe gao na kulonga, “Aha! Veve munya kudenya kaye lya Nguluvi na kulichenga kwaa figono fidatu! <verse eid="MRK 15:29" /><verse number="30" style="v" sid="MRK 15:30" />Ino wike pa kipindulihicho ujiwokole yuve!” <verse eid="MRK 15:30" /><verse number="31" style="v" sid="MRK 15:31" />Na filefile vatekechi vakomi pamwinga na vawulanichi va malagicho vaka mbedile vilonga, “Avaokuwe vanu vangi ila seivesa kwiwokola yumwene! <verse eid="MRK 15:31" /><verse number="32" style="v" sid="MRK 15:32" />Pulike ati mwene nde Kilisito yeahaguliwe na Nguluvi, Ng'achale va Isilaeli! Kwike nondee kuhuma pakipindilihicho neke tulole na kwidikila.” Na ata vanu vala yevakong'oliwe mupindilihicho palubali lyake na vene vakamligile.<verse eid="MRK 15:32" /></para>
  <para style="s">Kufua kwa Yesu</para>
  <para style="r">
    <ref loc="MAT 27:45-56">Matayo 27.45-56</ref>; <ref loc="LUK 23:44-49">Luka 23.44-49</ref>; <ref loc="JHN 19:28-30">Yohani 19.28-30</ref></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33" />Kuhuma saa sita pamunyi, inyi yonda igubukwe na kisi ngomi mbaka saa tisa. <verse eid="MRK 15:33" /><verse number="34" style="v" sid="MRK 15:34" />Peifikile saa tisa palumie, Yesu avembile kwa lisauti likomi, akalongie, “Eloi, Eloi, lama sabakitani?” Mana lyake, “Nguluvi vangu, Nguluvi vangu, wuli unilekile?” <verse eid="MRK 15:34" /><verse number="35" style="v" sid="MRK 15:35" />Vanu vangi vevaemile pala pevapulike ifyo, valongile, “Pulike! Ekumkemela Elia.” <verse eid="MRK 15:35" /><verse number="36" style="v" sid="MRK 15:36" />Munu yumwi akanyile, akaichwika lidodoki pa divai yeihatile, akavikile kukyanya lya lidenge na kumgavila Yesu anyuwe akilonga, “Suwe mumleke tulole ngita Elia ekwacha kumkwisa pakipindilihicho!” <verse eid="MRK 15:36" /><verse number="37" style="v" sid="MRK 15:37" />Yesu akavemba sauti ngomi, akafue. <verse eid="MRK 15:37" /><verse number="38" style="v" sid="MRK 15:38" />Pasia ngomi lya Kaye lya Nguluvi lyademuke fipande fivili kuvangila pakyanya hadi panyi. <verse eid="MRK 15:38" /><verse number="39" style="v" sid="MRK 15:39" />Mkomi va vapuga yumwi yeali emile pautalo lya kipindilihicho lwa Yesu, peawonele namuna peadumula muhe, akalonga, “Ndakyene munu uyu akali Mwana va Nguluvi!” <verse eid="MRK 15:39" /><verse number="40" style="v" sid="MRK 15:40" />Vekali na vadala yevalolile kwa utali, mugativawo akiva Malia munu va Magidalene na Mali maye va Yakobo mdodo na Yusufu na Salome. <verse eid="MRK 15:40" /><verse number="41" style="v" sid="MRK 15:41" />Vadala havo vamfuatiile Yesu peali ku Galilaya na kumtumikila. Kukali na vadala vangi volofu vachile pa Yelusalemu pamwinga nave.<verse eid="MRK 15:41" /></para>
  <para style="s">Yesu ivikwa mukaye mwa Nguluvi</para>
  <para style="r">
    <ref loc="MAT 27:57-61">Matayo 27.57-61</ref>; <ref loc="LUK 23:50-56">Luka 23.50-56</ref>; <ref loc="JHN 19:38-42">Yohani 19.38-42</ref></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42" />Muda va palumie peufikile, kwakuva ikali kigono kya maandaliso, kigono kimwi kabula kigono kya kutulula. <verse eid="MRK 15:42" /><verse number="43" style="v" sid="MRK 15:43" />Akachile Yosefu, munu va Alimataya, mnanzi va Ludamo Likomi lya Vayawudi, yeaginywe mno. Yemwene akali ekuhuchindila kwacha kwa Ung'achale va Nguluvi. Suwe, akamuheleliye Pilato bila wogofi, asukile agavilwe mvili gwa Yesu. <verse eid="MRK 15:43" /><verse number="44" style="v" sid="MRK 15:44" />Pilato akadudwive kupulika kuva Yesu akali afuwe dahaa. Suwe, amkemelie mkomi va vapuga, akamuhuchile kuva Yesu afuwe dahaa. <verse eid="MRK 15:44" /><verse number="45" style="v" sid="MRK 15:45" />Pilato pealongilwe ndeni na yula mkomi va vapuga kuva Yesu afuwe, akamlekile Yosefu kunyamula mvili va Yesu. <verse eid="MRK 15:45" /><verse number="46" style="v" sid="MRK 15:46" />Yosefu akagulile ligubiko, akaukwisa mvili va Yesu kuhuma pakipindulihicho, akaumilimili ligubiko. Akauvikile pa likabuli lyelikali lihogwile kumgamba. Pambele alibilingisa likanga likomi pautalo lya mlyangilo. <verse eid="MRK 15:46" /><verse number="47" style="v" sid="MRK 15:47" />Malia yula va kuhuma Kumagidalena na Malia maye vake Yusufu pevalolile pala peuvikilwe mvili va Yesu.<verse eid="MRK 15:47" /></para>
  <chapter eid="MRK 15" />
  <chapter number="16" style="c" sid="MRK 16" />
  <para style="s">Kuchulubuka kwa Yesu</para>
  <para style="r">
    <ref loc="MAT 28:1-8">Matayo 28.1-8</ref>; <ref loc="LUK 24:1-12">Luka 24.1-12</ref>; <ref loc="JHN 20:1-10">Yohani 20.1-10</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1" />Pekichumbile Kigono kya Kutulula, Malia yula va kuhuma Magidala, Salome na Malia maye vake Yakobo vakagulile manung'ililo neke vakaubake muvili va Yesu. <verse eid="MRK 16:1" /><verse number="2" style="v" sid="MRK 16:2" />Mbungamiye lya kigono kya kwansa lya juma, vakafikile kukabuli lya Yesu, lichuwa pelivangile kuhuma. <verse eid="MRK 16:2" /><verse number="3" style="v" sid="MRK 16:3" />Pevagehe mung'asi vakali vihuchana, “Ani yeakutuhechela lila liganga likomi pamlyangilo mwa likabuli?” <verse eid="MRK 16:3" /><verse number="4" style="v" sid="MRK 16:4" />Ila pevalolile, vawonile liganga likomi lihechilwe. <verse eid="MRK 16:4" /><verse number="5" style="v" sid="MRK 16:5" />Peviingie mulikabuli, vamuwene mdimi yumwi afwalile lihingila livalafu, ekalile lubali lya kuliya navo vakadudwive mno. <verse eid="MRK 16:5" /><verse number="6" style="v" sid="MRK 16:6" />Yula mndumindumi va Nguluvi yeawonikile ngita mdimi akamlongie, “Mbiile kududwivala mkumsaka Yesu Munasaleti yekong'oliwe pakipindilihicho. Achulubwike! Kwihela ipa. Mlole pono peavamvasile. <verse eid="MRK 16:6" /><verse number="7" style="v" sid="MRK 16:7" />Ila muhelele mukavalongile vachulila vake pamwi na Peteli kuva, ‘Yesu akuvalongola kuhelela ku Galilaya, ukoya dakumlola ngita pevalongiye.’” <verse eid="MRK 16:7" /><verse number="8" style="v" sid="MRK 16:8" />Suwe vanyilile kuhuma kumgunda va Nguluvi, kwa kuva vatetime kwa wogofi na kududwiva. Sevakamlongie munu yoyonda kinu, kwa kuva vakaongwipe mno.<verse eid="MRK 16:8" /></para>
  <para style="s">Yesu ekumuhumila Maliya munu va kuhuma Magidala</para>
  <para style="r">
    <ref loc="MAT 28:9-10">Matayo 28.9-10</ref>; <ref loc="LUK 20:11-18">Luka 20.11-18</ref></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9" />Yesu peachulubuke mbungamie kigono kya kwansa kya juma ewonise tandi kwa Maliya munu va kuhuma Magidala ambaye Yesu akali amuhechile mihoka saba. <verse eid="MRK 16:9" /><verse number="10" style="v" sid="MRK 16:10" />Maliya akahelele kuvalongela, vala vevakali vikwilongocha na Yesu, ambavo vakali kukivilicha na kuvemba. <verse eid="MRK 16:10" /><verse number="11" style="v" sid="MRK 16:11" />Ila pevapulike kuva Yesu yu uwumi na Maliya munu va Magidala akali amwene, sevaidikie.<verse eid="MRK 16:11" /></para>
  <para style="s">Yesu akuvahumila vachulila vavili</para>
  <para style="r">
    <ref loc="LUK 24:13-35">Luka 24.13-35</ref></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12" />Pambele Yesu akavahumie vavili pagati lya vachulila vake pevali vehelele kwivala lya kumwani akiva na lisula lingi. <verse eid="MRK 16:12" /><verse number="13" style="v" sid="MRK 16:13" />Navo vakawuyile na kuvalongela vayawo, ila sevaidikie vawo piya.<verse eid="MRK 16:13" /></para>
  <para style="s">Yesu akuvalagilicha vala Vachulila kumi na yumwi</para>
  <para style="r">
    <ref loc="MAT 28:16-20">Matayo 28.16-20</ref>; <ref loc="LUK 24:36-49">Luka 24.36-49</ref>; <ref loc="JHN 20:19-23">Yohani 20.19-23</ref>; <ref loc="ACT 1:6-8">Magito 1.6-8</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14" />Pambele Yesu akavahumie vala vachulila vake kumi na yumwi pevakali vekuliya kyakuliya. Akavalakila kwa kuva sevaidikie na ukangafu va numbula chawo kwa kuwa sevakuvaidikie vala vevamuwene baada lya kuchulubuka. <verse eid="MRK 16:14" /><verse number="15" style="v" sid="MRK 16:15" />Akavalongie, “Muhelele inyi chonda, mkadalike Njowo Nofu kwa vanu vonda. <verse eid="MRK 16:15" /><verse number="16" style="v" sid="MRK 16:16" />Yeyonda yeikwidikila na kubatiswa iwokoka. Ila mwene yeseikwidikie ikuhingwa. <verse eid="MRK 16:16" /><verse number="17" style="v" sid="MRK 16:17" />Na kimanyilo hiki chivesa pamwi na vala yevikwidikila, kwa litawa lyangu vihecha mihoka, na vilonga kwa luga miya. <verse eid="MRK 16:17" /><verse number="18" style="v" sid="MRK 16:18" />Vakikolela lyoka na hata vakinyua kinu kyokyonda kya kuvalemacha, sekikuvalemacha haa, vatavavikila mawoko gyawo pakyanya lya vatamwa navo vepona.”<verse eid="MRK 16:18" /></para>
  <para style="s">Yesu inyamuliwa kuhelela kuluhano kwa Nguluvi</para>
  <para style="r">
    <ref loc="LUK 24:50-53">Luka 24.50-53</ref>; <ref loc="ACT 1:9-11">Magito 1.9-11</ref></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19" />Peamalile Yesu kulonga navo, akanyamuliwa kuluhano kwa Nguluvi na kwikala liwoko lya kulia lya Nguluvi. <verse eid="MRK 16:19" /><verse number="20" style="v" sid="MRK 16:20" />Baho vachulila vake vakahelela kudalika kila pono, Mtwa akagitile kasi pamwinga navo na kwiwonesa kuva lichwi lyake kwa kimanyilo chechilongochwe navo.<verse eid="MRK 16:20" /></para>
  <chapter eid="MRK 16" />
</usx>