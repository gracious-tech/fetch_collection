<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="3JN" style="id">Tagin: Bible Translation 1st Edition</book>
  <para style="ide">Unicode (UTF8)</para>
  <para style="h">3 Jon</para>
  <para style="toc1">JON gv Siti Lvumnvbv jinam</para>
  <para style="toc2">3 Jon</para>
  <para style="toc3">3Jn</para>
  <para style="mt1">JON</para>
  <para style="mt2">gv Siti Lvumnvbv Jinam</para>
  <para style="imt">Mintamchonam</para>
  <para style="ip">
    <char style="bk">Jon gv lvum nvnvbv lvknam siti</char> si Gaius vnam Gvrja rigvnv um “nyigagatv” vdwgv lokv lvkto. Kristan kvvbia ninyigv mvdurridur nam lvgabv lvknv ngv giausnyi hartvto, okv Diotrepes vnam nyi akonyi alv manam lvgabv gamrwto.</para>
  <para style="iot">Arwng lokv darlinnam</para>
  <para style="io1">Mintamchonam <char style="ior">(<ref loc="3JN 1:1-4">1-4</ref>) </char></para>
  <para style="io1">Gauisnyi hartvnam <char style="ior">(<ref loc="3JN 1:5-8">5-8</ref>) </char></para>
  <para style="io1">Diotrepesnyi miyakayanam <char style="ior">(<ref loc="3JN 1:9-10">9-10</ref>) </char></para>
  <para style="io1">Dementriusnyi mvnglwk jinam <char style="ior">(<ref loc="3JN 1:11-12">11-12</ref>) </char></para>
  <para style="io1">Mintarminya <char style="ior">(<ref loc="3JN 1:13-15">13-15</ref>) </char></para>
  <chapter number="1" style="c" sid="3JN 1"/>
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">1:1 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 19:29">Nyim 19:29</ref>; <ref loc="ROM 16:23">Rom 16:23</ref>; <ref loc="1CO 1:14">1Kor 1:14</ref> </char>
    </note> Abwng lokv—</para>
  <para style="p" vid="3JN 1:1">Ngoogv jvjvrungbv paknam, ayanam Gaiusnyi.<verse eid="3JN 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="3JN 1:2"/>Ngoogv ayanam ajin, noogv Dow lo alvdunv vla ngo chinam aingbv—ogumvnwng ngv alvminggv yilakv okv noogv adwnayak vka alv yilakv vla ngo kumdunv. <verse eid="3JN 1:2"/><verse number="3" style="v" sid="3JN 1:3"/>Noogv jvjvlo ribvdoobvnam aingbv—vdwlo kristan meego aadula okv no jvjvlo vdwgo jwkjwkvrwk la ridu vla nga minam am ngo achialvbv mvngputo. <verse eid="3JN 1:3"/><verse number="4" style="v" sid="3JN 1:4"/>Ngoogv umvuu vdwv jvjvlo ridudodu kv vnam am ngo tvvpanam si oguguka mvngpu yanvgo kaaku madu.<verse eid="3JN 1:4"/></para>
  <para style="s">Gaiusnyi hartvnam</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5"/>Ngoogv ayanam ajin, nonuno kvbi kristan ajin vdwgv lvgabv vdwlo bunu nyien bv rijeka kudungkua riji kolo nonu achialvbv jwkjwkvrwk bv ridu. <verse eid="3JN 1:5"/><verse number="6" style="v" sid="3JN 1:6"/>Bunu gvrja lo nonugv paknam lvkwnglo japla ridu. Pwknvyarnvnyi mvnglwk koodubv bunugv mooying vngtung nga vngbv dubv bunua mvdurridur laka. <verse eid="3JN 1:6"/><verse number="7" style="v" sid="3JN 1:7"/>Vkvlvgavbolo mvngjwngmanv vdwgvlo oguka ridurnam kamabv Kristo gv kudungkua lvgabv bunu mooying vnglintoku. <verse eid="3JN 1:7"/><verse number="8" style="v" sid="3JN 1:8"/>Vbvrikunamv, ngonu kristan vdwv, sikvnv nyi vdw sum ridur tvka vbvribolo ngonu bunua jvjv gv lvgabv kudungkua nga ridur minggv lare.<verse eid="3JN 1:8"/></para>
  <para style="s">Diotrepes okv Dementrius</para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9"/>Ngo gvrja lo siti takching achukgo lvkto; vbvritola Diotrepes, oogv rigvdubv mvngnv, vv ngo ogugo mimpvdw um tvvgap jima. <verse eid="3JN 1:9"/><verse number="10" style="v" sid="3JN 1:10"/>Vbvrikunamv, vdwlo ngo aarekudw vkvgv ripvkunam ogumvnwng nga ngo aagv jireku: Busunam gaam si hv vdwgo ngonu lvkwnglo mimbvdw okv hv mvvla minku bvdw! vbvritola ninyi lvgabv vv mvngchik chima; ngonugv kristan ajin vdwv bunu aajvka umka laarwk simare, okv laarwk sinwngnv vdwaka bunua mintur yala ridu okv bunua gvrja lokv charlin yadubv gwngduku!<verse eid="3JN 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11"/>Ngoogv ajin vdw, alvmanv nga kaagv la riyoka, vbvritola alvnvngv ogudw um kaagv la ritoka. Yvvdw alvnvbv ridunv vv Pwknvyarnv gvbv ridunv; Yvvdw alvmanv oguvdw um ridunv vv Pwknvyarnvnyi kaama dunv.<verse eid="3JN 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="3JN 1:12"/>Dementrius gv lvkwnglo nyi mvnwng ngv alvnvbv mindu; jvjvklv ngvka ninyia alvnvbv mindu. Okv ngonuka bvngtam minggv dunv, okv nonu chindu ngonu ogugo mindudw vv jvjvdu.<verse eid="3JN 1:12"/></para>
  <para style="s">Kumnyung bv kumrwksikunam</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13"/>Ngo gvlo nonua achialvgo minsv ngv doodu, vbvrijvka ngo koolum okv sai lokv lvknya jilama. <verse eid="3JN 1:13"/><verse number="14" style="v" sid="3JN 1:14"/>Nonua ngo baapubv kaarwk sinvpv mvngtin sidu, okv vbvrikubolo ngonuv doorwk sitola atuanying ngv japrwk sipa reku.<verse eid="3JN 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="3JN 1:15"/>Sarsopoyo ngv nonu gvlo dooming gvyilaka .</para>
  <para style="p" vid="3JN 1:15">Ngoogv ajin vdwv kumrwksinam am jilwkdu. Nonugv ajin mvnwng ngv kumrwksidu.<verse eid="3JN 1:15"/></para>
  <chapter eid="3JN 1"/>
</usx>
