<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PSA" style="id">- Havai</book>
  <para style="toc1">Ahi Noi Devet</para>
  <para style="toc2">Ahi</para>
  <para style="toc3">AHI</para>
  <para style="mt1">Ahi</para>
  <chapter number="1" style="c" sid="PSA 1"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 1:1"/>Gareana lawe na tangaloi nge hilogo hi</para>
  <para style="q2" vid="PSA 1:1">dige tea lo tovotovo nora tangaloi esi,</para>
  <para style="q2" vid="PSA 1:1">me he labe tea lo nora turegi rau esi,</para>
  <para style="q2" vid="PSA 1:1">siu he toga tea lo herera tangaloi vaivei lolohaga Huqe.<verse eid="PSA 1:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 1:2"/>Nge mo havusie gena leo noi <char style="nd">Huqe</char></para>
  <para style="q2" vid="PSA 1:2">me mo ladolado lolo nona tamwata vataha na rani me lolo bongi.<verse eid="PSA 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 1:3"/>Nge mwere na gai ram rivuana lo mwararai matamata</para>
  <para style="q2" vid="PSA 1:3">nge hilogo lo tarona mo mwasigi a raune rain soi tea,</para>
  <para style="q1" vid="PSA 1:3">me nge mo maraga lo gineu doluegi nge mo vaire.<verse eid="PSA 1:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 1:4"/>Hate mwere na tangaloi esi</para>
  <para style="q2" vid="PSA 1:4">mwere na bembei tovu ngere hilogo a langi mo heregi vohoginire.<verse eid="PSA 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 1:5"/>Siu i Huqe vin veveginire tangaloi esi rain vurogi</para>
  <para style="q2" vid="PSA 1:5">me vin vile wahera tangaloi galegale asi dena bubugiana nora tangaloi vovohoi.<verse eid="PSA 1:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 1:6"/>Huri <char style="nd">Huqe</char> u ilo na turegire tangaloi vovohoi,</para>
  <para style="q2" vid="PSA 1:6">nge a tangaloi esi mo huri na turegi mateana.<verse eid="PSA 1:6"/></para>
  <chapter eid="PSA 1"/>
  <chapter number="2" style="c" sid="PSA 2"/>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 2:1"/>?Huri havagi a vanue dolue ram lalangogi huri vena ra vai gineu esi?</para>
  <para style="q2" vid="PSA 2:1">?Huri havagi tangaloi a nora lalangogi mo toa vurogi?<verse eid="PSA 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 2:2"/>Ratahigi tau lo ure ram labe ram rarai ve ra qalo mei <char style="nd">Huqe</char>.</para>
  <para style="q2" vid="PSA 2:2">Ngere ram vile bubugi ram tovotovo asi vovoi <char style="nd">Huqe</char> mena na nona tangaloi vagatai.<verse eid="PSA 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 2:3"/>Ngere ram veve vena, “Ginde da lai vohogi na garovauveu</para>
  <para style="q2" vid="PSA 2:3">me da tuli vohogi na garo ngere denire.”<verse eid="PSA 2:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 2:4"/>Nge mo toga lolo taetae mo mana,</para>
  <para style="q2" vid="PSA 2:4">me i Huqe mo vaivei lolohaga meire.<verse eid="PSA 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 2:5"/>Siu nge mo veve vohoginire me na nona loloasi,</para>
  <para style="q2" vid="PSA 2:5">mena nona lolobute mo vaire ram matagu.<verse eid="PSA 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 2:6"/>Siu nau teu na Nongu ratahigi me lui Saeon</para>
  <para style="q2" vid="PSA 2:6">a Nongu vusi gogona.<verse eid="PSA 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 2:7"/>Ratahigi move, “Neu nain toregi na leo noi <char style="nd">Huqe.</char></para>
  <para style="q2" vid="PSA 2:7">Nge mo veve laweau move,</para>
  <para style="q1" vid="PSA 2:7">‘Nigo i netungu mwere!</para>
  <para style="q2" vid="PSA 2:7">Bagataha nam voragi tamamu.<verse eid="PSA 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 2:8"/>Tareve goin hui deni eu, me neu nain bete lawego a nomu vanue,</para>
  <para style="q2" vid="PSA 2:8">mena nom sinobu vin dadari lo duvin ureure.<verse eid="PSA 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 2:9"/>Goin vei vurivurire, gena ruqi aean</para>
  <para style="q2" vid="PSA 2:9">me goin momogagi nire mwere na sosovene tano.’”<verse eid="PSA 2:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 2:10"/>Siu i gimiu ratahigi nein iloe.</para>
  <para style="q2" vid="PSA 2:10">Nein leohuri, gimiu tangaloi leogoro talo ure.<verse eid="PSA 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 2:11"/>Go tabana nona <char style="nd">Huqe</char> mena londo mava,</para>
  <para style="q2" vid="PSA 2:11">rongarea mena matagute.<verse eid="PSA 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 2:12"/>Go lai tabe tabegi na maresu mwera vaiteu</para>
  <para style="q2" vid="PSA 2:12">mo mero mo vai asisigi nigo huri mo mero u siseri.</para>
  <para style="q1" vid="PSA 2:12">Gareana lawera hi ramo betubetu lune.<verse eid="PSA 2:12"/></para>
  <chapter eid="PSA 2"/>
  <chapter number="6" style="c" sid="PSA 6"/>
  <para style="d">Tomtomuei Ahi. Mena bue gerigeri mena bue gerigeri garo gai welu. Ahi noi Devet.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 6:1"/>
    <char style="nd">Huqe</char> lolo nomu lolobute go mese veve vohogi eu sige</para>
  <para style="q2" vid="PSA 6:1">lolo nom meroana go mese haharau.<verse eid="PSA 6:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 6:2"/>
    <char style="nd">Huqe</char> go haharagi na gareana lawe au huri neu nam wiriwiri,</para>
  <para style="q2" vid="PSA 6:2">
    <char style="nd">Huqe</char> go vaga vagamwasoi eu huri a hui gu ram rurururu.<verse eid="PSA 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 6:3"/>Me neu gaheau, nam romasi liu.</para>
  <para style="q2" vid="PSA 6:3">?Nge nigo <char style="nd">Huqe</char> goin bului eu tagaha?<verse eid="PSA 6:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 6:4"/>
    <char style="nd">Huqe</char> gon tudori gon bului eu.</para>
  <para style="q2" vid="PSA 6:4">Me lo nom hahagavi vagitue gon vaga vagamwasoi eu.<verse eid="PSA 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 6:5"/>Huri lolo mateana a tangaloi vin lado bibigo tea.</para>
  <para style="q2" vid="PSA 6:5">?Me hine lolo qaru vin ware hagegi nigo?<verse eid="PSA 6:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 6:6"/>Neu nam wiriwiri gena nongu ngarana;</para>
  <para style="q1" vid="PSA 6:6">Mena nongu tinengi nam vaga bibilugi na heregu</para>
  <para style="q2" vid="PSA 6:6">mena qanagu lolo bongi gena nongu tingeni.<verse eid="PSA 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 6:7"/>Mataku mo dodo gena romasi,</para>
  <para style="q2" vid="PSA 6:7">Me a matagu mo asi gena nongu tavului vuro.<verse eid="PSA 6:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 6:8"/>Nen vano den eu gimiu doluegi nem vai gineu rau esi vohogi,</para>
  <para style="q2" vid="PSA 6:8">huri <char style="nd">Huqe</char> mo rongo na nongu ngarana.<verse eid="PSA 6:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 6:9"/>A <char style="nd">Huqe</char> nge u rongo na nongu ngarana huri na hahagavi,</para>
  <para style="q2" vid="PSA 6:9">siu i <char style="nd">Huqe</char> vin duvi na nongu tataro.<verse eid="PSA 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 6:10"/>Nongu tavalui vuro doluegi rain matagu lawuagi,</para>
  <para style="q2" vid="PSA 6:10">me rain maemae rain toa dori siseri deni eu siu rain maemae.<verse eid="PSA 6:10"/></para>
  <chapter eid="PSA 6"/>
  <chapter number="23" style="c" sid="PSA 23"/>
  <para style="d">Ahi noi Devet.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 23:1"/>A <char style="nd">Huqe</char> nge a nongu leo goro garea,</para>
  <para style="q2" vid="PSA 23:1">neu nain he mahogi tea.<verse eid="PSA 23:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 23:2"/>Mo vai eu nam eno lolo ute lombu,</para>
  <para style="q2" vid="PSA 23:2">me mo tomuegi eu lo mwararai wai matamata.<verse eid="PSA 23:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 23:3"/>Mo vurugegi na nongu mwasoana,</para>
  <para style="q2" vid="PSA 23:3">me mo tomuegi eu sulo turegi vovohoiana huri na henana.<verse eid="PSA 23:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 23:4"/>Hate huri nain dige turu na dodo,</para>
  <para style="q2" vid="PSA 23:4">a waluwelui asiana nain matagu tea gena gineu esi,</para>
  <para style="q2" vid="PSA 23:4">huri nigo mei eu;</para>
  <para style="q2" vid="PSA 23:4">a nom ruqi mena gaitigo ngere a gai turegu.<verse eid="PSA 23:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 23:5"/>Gom rarai na hinaga</para>
  <para style="q2" vid="PSA 23:5">lo nagoi nongu tavului vuro,</para>
  <para style="q1" vid="PSA 23:5">gom lai gogogi eu</para>
  <para style="q2" vid="PSA 23:5">me a nongu laha mo horo mwalinglingi.<verse eid="PSA 23:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 23:6"/>A hogo liu, a nom gareana me nom vaigarea vin huri eu vataha</para>
  <para style="q2" vid="PSA 23:6">na rani nongu mwasoana</para>
  <para style="q1" vid="PSA 23:6">me neu nain toga lolo valei <char style="nd">Huqe</char></para>
  <para style="q2" vid="PSA 23:6">vagituei.<verse eid="PSA 23:6"/></para>
  <chapter eid="PSA 23"/>
  <chapter number="30" style="c" sid="PSA 30"/>
  <para style="d">Ahi noi Devet huri na vai gogonagi na Sara Gogona.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 30:1"/>Nain tabe hagegi nigo gena roroa, <char style="nd">Huqe,</char></para>
  <para style="q2" vid="PSA 30:1">huri gu ragasi eu dena walu,</para>
  <para style="q2" vid="PSA 30:1">me gohi mesingegi tea ve nongu tavalui vuro ve rain rongarea gieu.<verse eid="PSA 30:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 30:2"/>Nongu <char style="nd">Huqe</char> Mauri,</para>
  <para style="q2" vid="PSA 30:2">nam warego huri na buluiana,</para>
  <para style="q2" vid="PSA 30:2">siu nigo gu vagamwasoi eu.<verse eid="PSA 30:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 30:3"/>
    <char style="nd">Huqe,</char> gu ragasi eu dena qarui mateana.</para>
  <para style="q2" vid="PSA 30:3">Gu dedegi na nongu mwasoana, hi hivo tea lolo walu.<verse eid="PSA 30:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 30:4"/>Gimiu nona tangaloi gogona nein galohagi na <char style="nd">Huqe,</char></para>
  <para style="q2" vid="PSA 30:4">me nein bete na harigiana lawe na henana u gogona.<verse eid="PSA 30:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 30:5"/>Huri a nona meroana mo eno mahogi biti,</para>
  <para style="q2" vid="PSA 30:5">nge a nona leogareagi nigo mo eno tuqaravu,</para>
  <para style="q1" vid="PSA 30:5">tangiana vin eno lai bongi gategale,</para>
  <para style="q2" vid="PSA 30:5">nge lolo robongi a rongarea.<verse eid="PSA 30:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 30:6"/>Tavohe nongu tutugoro mo eno, nam veve vena,</para>
  <para style="q2" vid="PSA 30:6">“Neu nain he gilu tea.”<verse eid="PSA 30:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 30:7"/>O <char style="nd">Huqe,</char> tavohe gom leogareagi eu</para>
  <para style="q2" vid="PSA 30:7">gom vai na vusigu mo labe siaga;</para>
  <para style="q1" vid="PSA 30:7">nge tavohe gom hiligi na nagomu</para>
  <para style="q2" vid="PSA 30:7">nau ruru gena matagute.<verse eid="PSA 30:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 30:8"/>O <char style="nd">Huqe,</char> neu nau warego;</para>
  <para style="q2" vid="PSA 30:8">Lawego Huqe, neu nau ngara huri na hahagavi.<verse eid="PSA 30:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 30:9"/>?Hava lalaie nge talehe tare vena neu nau mate?</para>
  <para style="q2" vid="PSA 30:9">?Neu nam soi silolo walu siu?</para>
  <para style="q1" vid="PSA 30:9">?A qie vin galohagi nigo?</para>
  <para style="q2" vid="PSA 30:9">?I nge vin toregi na nom garohuri?<verse eid="PSA 30:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 30:10"/>O <char style="nd">Huqe,</char> go rongo au me go hagavi eu,</para>
  <para style="q2" vid="PSA 30:10">me O <char style="nd">Huqe,</char> go vuragi na buluigu.<verse eid="PSA 30:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 30:11"/>Nigo gu dori na nongu tangiana silo hawana.</para>
  <para style="q2" vid="PSA 30:11">Nigo gu lei vohogi na luqegu a luqe asi</para>
  <para style="q2" vid="PSA 30:11">siu gom luqegi eu gena hahavusiana.<verse eid="PSA 30:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 30:12"/>Huri ve a lologu na huri ehi lawego,</para>
  <para style="q2" vid="PSA 30:12">siu neu na mese toga maunegi.</para>
  <para style="q1" vid="PSA 30:12">Nongu <char style="nd">Huqe</char> Mauri,</para>
  <para style="q2" vid="PSA 30:12">neu nain ware hagegi nigo tavagi tuei.<verse eid="PSA 30:12"/></para>
  <chapter eid="PSA 30"/>
  <chapter number="51" style="c" sid="PSA 51"/>
  <para style="d">A ahi noi Devet. A tomtomuei buegerigeri. I tangaloi leo ligoligogi Natan, u vumai lobena, lo tagugi i Devet u vei na doridori esi mei Batsiba.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 51:1"/>Huqe Mauri go hagavi eu na huri na nomu vaigarea lawua</para>
  <para style="q2" vid="PSA 51:1">huri na nongu doridori esi.</para>
  <para style="q1" vid="PSA 51:1">Lo nomu hahagavi gon lai vohogi</para>
  <para style="q2" vid="PSA 51:1">na nongu asiana.<verse eid="PSA 51:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 51:2"/>Gon solo vohogi na nongu asiana doluegi,</para>
  <para style="q2" vid="PSA 51:2">me go vagahagi eu dena na bugungu doluegi.<verse eid="PSA 51:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 51:3"/>Ba huri nau ilo na nongu doridori esi mei eu,</para>
  <para style="q2" vid="PSA 51:3">siu a bugungu mo eno mei eu vataha na tarogi.<verse eid="PSA 51:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 51:4"/>Siu nigo hogosie nau vagasile vovohigo</para>
  <para style="q2" vid="PSA 51:4">me nau vei na gineu esi lolo matamu.</para>
  <para style="q1" vid="PSA 51:4">Tavohe gom lanqa, u vovohoi,</para>
  <para style="q2" vid="PSA 51:4">me tavohe gom vevegi na tangaloi u vovohoi.<verse eid="PSA 51:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 51:5"/>A hogo nau vora lolo asiana siu neu</para>
  <para style="q2" vid="PSA 51:5">a nongu galegale asi lungu tavohe i retahigu mo tinogi eu<verse eid="PSA 51:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 51:6"/>Gu tarave na hogo lolo loloi tangaloi,</para>
  <para style="q2" vid="PSA 51:6">me gu huhui eu gena lolorani lolo buloi dimwangogu.<verse eid="PSA 51:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 51:7"/>Vagahagi eu gena digugu<note caller="+" style="f"><char style="fr" closed="false">51.7 </char><char style="ft" closed="false">Hisob a rivurivu dam vuie lolo dai. Mo tuliana lo gineu sige tangaloi, mo gogonagi nire me mo solo vohogi bugure.</char></note> me neu nain mwasara,</para>
  <para style="q2" vid="PSA 51:7">solo vohogi na nongu asiana me neu nain mevute vin liu na vire hi a wagahiata.<verse eid="PSA 51:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 51:8"/>Vai eu na rongarea me na havuhevu.</para>
  <para style="q2" vid="PSA 51:8">Siregi na hui gu momogagi nire ra havuhevu.<verse eid="PSA 51:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 51:9"/>Vunigi na nagomu dena nongu asiana</para>
  <para style="q2" vid="PSA 51:9">me go hara vohogi na nongu doridori esi doluegi.<verse eid="PSA 51:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 51:10"/>O Huqe Mauri, go vai na lolo lolongu, a dimwango mwasara,</para>
  <para style="q2" vid="PSA 51:10">me go vai na tanumwe garaqa huire lolo lolongu.<verse eid="PSA 51:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 51:11"/>Mese tuli vohogi eu denigo,</para>
  <para style="q2" vid="PSA 51:11">me go mese lai vohogi na nom Tanumwe Gogona deni eu.<verse eid="PSA 51:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 51:12"/>Gon bete muleagi lawe au a hahavusi na nom vaga mwasoana,</para>
  <para style="q2" vid="PSA 51:12">me gon bete na nom tanumwei tabetabe na gaiture au.<verse eid="PSA 51:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 51:13"/>Siu neu nain huhui na tangaloi esi kena nom leo</para>
  <para style="q2" vid="PSA 51:13">me ngere rain tudori su lobemu.<verse eid="PSA 51:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 51:14"/>O Huqe Mauri, Huqe Mauri nigo nongu vagamwasoi,</para>
  <para style="q2" vid="PSA 51:14">go vagamwasoi eu dena dai,</para>
  <para style="q1" vid="PSA 51:14">siu neu nain huri na ahi hahavusiana</para>
  <para style="q2" vid="PSA 51:14">huri na nomu vovohoiana.<verse eid="PSA 51:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 51:15"/>Huqe, go tagahi na singogu</para>
  <para style="q2" vid="PSA 51:15">siu a wawagu vin ware hagegi na henamu.<verse eid="PSA 51:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 51:16"/>Huri nigo gom rahagi na bulengu kankarue nam hogohogo lawego,</para>
  <para style="q2" vid="PSA 51:16">siu nigo goin hevuhevu tea lo nongu hure bonboni.<verse eid="PSA 51:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 51:17"/>A hogohogo, O Huqe Mauri, a tanumwegi u mevurivuri</para>
  <para style="q2" vid="PSA 51:17">me a dimwangona mo hahagavi.</para>
  <para style="q2" vid="PSA 51:17">O Huqe Mauri, go mese tudori denie.<verse eid="PSA 51:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 51:18"/>Go vai na gineu garea lawe na Saeon; mwerehi gom taranie.</para>
  <para style="q2" vid="PSA 51:18">Go hagovi na qetuqetu goro na Jerusalem.<verse eid="PSA 51:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 51:19"/>Siu a hogohogo rau vovohoi,</para>
  <para style="q2" vid="PSA 51:19">a hure bonboni bulugi dodoluegi vin veigo goin hevuhevu,</para>
  <para style="q2" vid="PSA 51:19">me a bulugi boegi doluegi rain hureana lo nom vonda gogona.<verse eid="PSA 51:19"/></para>
  <chapter eid="PSA 51"/>
  <chapter number="100" style="c" sid="PSA 100"/>
  <para style="d">A ahi na veve garea.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 100:1"/>Galohagi na <char style="nd">Huqe,</char> mena hahavusiana,</para>
  <para style="q2" vid="PSA 100:1">dali na ure.<verse eid="PSA 100:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 100:2"/>Galohagi na <char style="nd">Huqe,</char> mena hahavusiana;</para>
  <para style="q2" vid="PSA 100:2">nein vumai lo nagona mena ahi hahavusiana.<verse eid="PSA 100:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 100:3"/>Nei ilo huri ve i <char style="nd">Huqe,</char> nge i Huqe Mauri;</para>
  <para style="q1" vid="PSA 100:3">nge u vei ginde</para>
  <para style="q2" vid="PSA 100:3">me ginde a nona,</para>
  <para style="q1" vid="PSA 100:3">ginde nona tangaloi</para>
  <para style="q2" vid="PSA 100:3">me a nona buri sibsib nge vin leohuri ginde lo tanona.<verse eid="PSA 100:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 100:4"/>Ahu turu na nona matai ara mena veve garea,</para>
  <para style="q2" vid="PSA 100:4">me nen ware roroagi nie lolo sarana.</para>
  <para style="q1" vid="PSA 100:4">Nen garea hurie</para>
  <para style="q2" vid="PSA 100:4">me nen vaga roroagi na henana.<verse eid="PSA 100:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 100:5"/>Huri a <char style="nd">Huqe,</char> nge u garea lawuagi</para>
  <para style="q2" vid="PSA 100:5">me a nona vaigarea vin eno randu,</para>
  <para style="q1" vid="PSA 100:5">a nona garohuri vin eno duruhi</para>
  <para style="q2" vid="PSA 100:5">na babagi doluegi vin tuei.<verse eid="PSA 100:5"/></para>
  <chapter eid="PSA 100"/>
</usx>
