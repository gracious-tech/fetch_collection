<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="EPH" style="id">- RELLI PROJECT</book>
  <para style="h">ఎపెసీ</para>
  <para style="toc3">ఎపెసీ</para>
  <para style="toc2">ఎపెసీ</para>
  <para style="toc1">అపొస్తులుడైలా పౌలు ఎపేసీ రాసిల పత్రిక</para>
  <para style="mt2">పౌలు ఎపెసీయులుకు రాసిన పత్రిక</para>
  <para style="mt1">పౌలు ఎపెసీయులుకు రాసిల పత్రిక</para>
  <para style="imt">అగరొ కొత</para>
  <para style="ip">ఎపెస్సి పత్రిక కొలస్సి పత్రిక పనాక క్రీస్తు జొర్నైలా తరవాత 60 వ బొచ్చుర్రె రాసిసె యే లేక రాసిలింకె<char style="xt"><ref loc="EPH 1:1">1:1</ref></char> వ వచనం ప్రకారము అపొస్తులు యీలా పౌలు పరిచయం కొరిగిసి యే పత్రికరె కొలస్సి పత్రిక పనాక తా సొంతమైల సుబవచనాలు నీనె యడ పౌలు దీకిరి రాసిబొడిసి బులి బడె మంది పండితులు కొయిలీసె యే కారనం వలరె సె చుట్టు పక్కరె రొల్లా ప్రాంతంరె సెట్టె రొల్ల బడె సంగాలుకు పొడిదివురొ యీసి యే లేక పౌలు చెరసాలరె రొల్లాబెల్లె రాసికిరి అచ్చి. <char style="xt"><ref loc="EPH 3:1">3:1</ref></char><char style="xt"><ref loc="EPH 4:1">4:1</ref></char><char style="xt"><ref loc="EPH 6:20">6:20</ref></char> వచనాలు తెలియపరిచిలీసె తుకికు ఎపెసు సంగముకు జెల్లాబెల్లె పౌలు తా ద్వార యే లేక పొడిదీసి <char style="xt"><ref loc="EPH 6:21-22">6:21-22</ref>.</char></para>
  <para style="ip">ఆసియరె రొమీయులు రాజదాని పట్నంరె ఎపెసు గుటె పట్నం ఎ ఎపెస్సు పట్నం గ్రీకులురొ దేవత యీలా అర్తమిదేవి గుడికి కెత్తొ నా గలిగిలాట అపొస్తులు <char style="xt"><ref loc="ACT 19:23-31">అపో 19:23-31</ref></char>ఎ ఎపెసు సంగము అగరె బడె బలంగా రొవురొ యీకిరి అచ్చి ఉంచినె బడె బలహీనత యీజీకిరి అయిసి. ప్రకటన <char style="xt"><ref loc="EPH 2:1-7">2:1-7</ref>.</char></para>
  <para style="ip">యే లేకరె పౌలు యేసు క్రీస్తు దీకిరి తా ప్రజానె పాపోనె క్సమించికిరి రక్సించిగీకిరి క్యాకిరి ఏర్పర్చిగిచ్చో సకం బాగం వివరించికిరి అచ్చి యే లేకరె క్రీస్తు ముండొగా సంగము దే గా ఇంకా గొరొకు ముక్యమైల పొతొరొ పన పోల్చికిరి కొయివురొ ఈసి యే లేక తరవాత బాగంరె క్రైస్తువులు జీవించిల విదానం గురించి సూచనలు దివురొ యీసి.</para>
  <para style="iot">సంగతీనె</para>
  <para style="io1">1. పౌలు ఎపెసు సంగముకు సుబం బులి కొయికిరి పరిచయం కొరిగిసి<char style="ior"><ref loc="EPH 1:1-2">1:1-2</ref> </char></para>
  <para style="io1">2. పౌలు ఆండ్రె సంగము ఇంక క్రీస్తు ఇంక సంగం మొజిరె సంబందం గురించి వివరించివురొ <char style="ior"><ref loc="EPH 1:3-3:21">1:3–3:21</ref> </char></para>
  <para style="io1">3. ఎట్టె పౌలు క్రైస్తువులురొ జీవన విదానం గురించి రాసిసి <char style="ior"><ref loc="EPH 4:1-6:20">4:1–6:20</ref> </char></para>
  <para style="io1">4. ఆకరుగా పౌలు కుండె సూచనలు కొయికుంట ముగించివురొ<char style="ior"><ref loc="EPH 6:21-24">6:21-24</ref></char></para>
  <chapter number="1" style="c" sid="EPH 1"/>
  <para style="p">
    <verse number="1" style="v" sid="EPH 1:1"/>పురువురొ యిస్టముచొప్పురె క్రీస్తుయేసురొ అపోస్తులుడైలా పౌలు ఎపెసురె రొల్లా పురువురొ ప్రజానెకు క్రీస్తుయేసురె విస్వాసం రొల్లాలింకు సుబం కొయికిరి రాసిలాట.<verse eid="EPH 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="EPH 1:2"/>అం బోయీలా పురువుతీకిరి ప్రబువైలా యేసుక్రీస్తు తీకిరి తొముకు క్రుపా, సమాదానము కలిగివాసిబులి.<verse eid="EPH 1:2"/></para>
  <para style="s">క్రీస్తురె ఆత్మీయ ఆసీర్వాదాలు</para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 1:3"/>అం ప్రబువైలా యేసుక్రీస్తురొ బోయీలా పురువు స్తుతింపబొడిమాసి. సెయ్యె క్రీస్తురె పరలోక విసయానెరె ఆత్మసంబందమైలా సొబ్బి ఆసీర్వాదానె అముకు అనుగ్రహించిసి. <verse eid="EPH 1:3"/><verse number="4" style="v" sid="EPH 1:4"/>అమె తా అగరె పవిత్రంగా, దోసం నీకుంటా రొమ్మాసిబులి జగత్తుకు పునాది నాపొగిలా అగుంతాక, సెయ్యె ప్రేమసంగరె క్రీస్తురె అముకు ఏర్పాటు కొరిగిచ్చి. <verse eid="EPH 1:4"/><verse number="5" style="v" sid="EPH 1:5"/>తా యిస్టప్రకారమైలా దయాసంకల్పము చొపురె, యేసుక్రీస్తు ద్వారా తాకు పిల్లానె యీకిరి రొయితందుకాక, అముకు అగుంతాక తా కోసం నిర్నయించిగీకిరి, <verse eid="EPH 1:5"/><verse number="6" style="v" sid="EPH 1:6"/>సడుకాక తా ప్రియమైలా పో ద్వారా సెయ్యె సుచ్చరాక అముకు అనుగ్రహించిలా తా క్రుప మహిమకు కీర్తి చెల్లించిమాసి. <verse eid="EPH 1:6"/><verse number="7" style="v" sid="EPH 1:7"/>పురువురొ మహా క్రుప వల్లరాక, తా ప్రియమైలా పో యేసు రొగొతొ <note caller="+" style="f"><char style="fr" closed="false">1:7 </char><char style="ft" closed="false">రొగొతొ బలి యాగం</char></note>ద్వారా అముకు విడుదల, పాపక్సమాపన కలిగిసి. <verse eid="EPH 1:7"/><verse number="8" style="v" sid="EPH 1:8"/>అముకు సంపూర్నమైలా జ్ఞానవివేకము కలిగితె సేక్రుపకు అమంపరె విస్తరించిసి.<verse eid="EPH 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 1:9"/>కలొ సంపూర్తయిజిల్లాబెల్లె ఈవలిసిలా ఏర్పాటు వల్లరె, పురువు తా దయాసంకల్పము చొపురె తా చిత్తము గురించి నుచ్చిదిల్లా ఉద్దేసము అముకు తెలియపర్చిసి.<verse eid="EPH 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EPH 1:10"/>యే సంకల్పమువల్లరాక పురువు పరలోకంరె తల్లాంచ ఈనన్నా, బూమంపరె తల్లాంచ ఈనన్నా, సొబ్బిటికు క్రీస్తురె సమకూర్చిమాసిబులి సెయ్యె తాబిత్తరె ముండొగా నిర్నయించిగిచ్చి.<verse eid="EPH 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 1:11"/>పురువు తాకు ఇస్టమైలా నిబందంన దీకిరి అముకు బచ్చిగీకిరి, వారసునెగా కొరిసి. సెయ్యె తా ఇస్టం చొప్పురె సొబ్బిపైటీనెకొరిలీసి.<verse eid="EPH 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EPH 1:12"/>ఈనె క్రీస్తుకు అగుంతా నమ్మిలా అం ద్వారా పురువురొ మహిమకు గొప్ప కలిగిమాసి.<verse eid="EPH 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EPH 1:13"/>తొమ్మంకా సత్యవాక్కుకు బుల్నే రక్సన సువార్త సునికిరి, క్రీస్తురె నమ్మకం రొగ్గిచ్చొ. సడుకాక పురువు దిల్లా కొతా వల్లరె పరిసుద్దత్మసంగరె తొమంపరె ముద్రించబొడిసి. <verse eid="EPH 1:13"/><verse number="14" style="v" sid="EPH 1:14"/>పురువురొ మహిమకు కీర్తి కలిగిమాసిబులి సెయ్యె సంపాదించిగిల్లా మనమానుకు విడుదల కలిగిలాదాకా ఆత్మ అం వారసత్వముకు హామీగా అచ్చి.<verse eid="EPH 1:14"/></para>
  <para style="s">పౌలురొ ప్రార్దన</para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 1:15"/>యే కారనం చొపురె ప్రబువైలా యేసురె తొం విస్వాసం గురించి పురువురొ ప్రజానె గురించి తొమె దిగిపించిలా ప్రేమ గురించి మియ్యి సునిలాబెల్లెతీకిరి<verse eid="EPH 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EPH 1:16"/>తొం విసయమురె నామానుకుంటా మో ప్రార్దనల్రె పురువుకు క్రుతజ్ఞత చెల్లించిలించి. <verse eid="EPH 1:16"/><verse number="17" style="v" sid="EPH 1:17"/>ఈనె అం ప్రబువైలా యేసుక్రీస్తు పురువు, మహిమ గల్లా బో, తా జ్ఞాన ప్రత్యక్సతలుగల్లా మనుసుకు ఆత్మ తొముకు దిమ్మాసిబులి ప్రార్దించిలించి. <verse eid="EPH 1:17"/><verse number="18" style="v" sid="EPH 1:18"/>తొం మనోనేత్రాలూనె వెలిక్కిరి, అం డక్క గురించి నిరీక్సన కెటువంటిటవో, తా ప్రజానెరె తా మహిమగల్లా వారసత్వం కెత్తె ఐస్వర్యమో తొమె గ్రహించిమాసిబులి మో ప్రార్దన.<verse eid="EPH 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EPH 1:19"/>ఈనె విస్వసించిల అంబిత్తరె పైటికొరిల గొప్ప సక్తి యెడాక సడ గొప్ప సక్తి అంబిత్తరె పైటికొరిలీసి, <verse eid="EPH 1:19"/><verse number="20" style="v" sid="EPH 1:20"/>సే సక్తి వలరాక క్రీస్తుకు మొర్నొదీకిరి ఉటిదీకిరి ఇంకా పరలోకంరె తా బత్తొకైలాడుకు బొసరదీగిచ్చి. <verse eid="EPH 1:20"/><verse number="21" style="v" sid="EPH 1:21"/>క్రీస్తురొ సొబ్బిఆదిపత్యం, అదికారం, ప్రబావం, ప్రబుత్వంకన్నా యే యుగంరె గానీ, అయితల్లా యుగంరె గానీ నాతల్లా సొబ్బినానెకన్నా బడే గొప్పగా తాకు హెచ్చించిసి. <verse eid="EPH 1:21"/><verse number="22" style="v" sid="EPH 1:22"/>తర్వాతరె పురువు సొబ్బిటుకు క్రీస్తు గొడ్డోనె తొల్లె రొక్కిరి, సంగముబిత్తరె సొబ్బిటంపరె తాకు ముండొగా నియమించిసి. <verse eid="EPH 1:22"/><verse number="23" style="v" sid="EPH 1:23"/>యే సంగం తా దే, సొబ్బిటికు సొబ్బివిదాలుగా పూరదీతల్లా పురువు పరిపూర్నతైకిరచ్చి.<verse eid="EPH 1:23"/></para>
  <chapter eid="EPH 1"/>
  <chapter number="2" style="c" sid="EPH 2"/>
  <para style="s">మొర్నొ తీకిరి జీకకు</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 2:1"/>అగరె తొమె అతిక్రమాల్రె పాపాల్రే ఆత్మీయతరె మొరిజీకిరి తల్లాపని అచ్చొ <verse eid="EPH 2:1"/><verse number="2" style="v" sid="EPH 2:2"/>సెల్లె పూర్వకలొరె తొమె యే లొకొ పద్దతీనుకు వాయుమండలసంబందమైలా అదిపతికి, బుల్నే అవిదేయతరె పైటికొరితల్లా ఆత్మకు అనుసరించికిరి చలిగిచ్చొ. <verse eid="EPH 2:2"/><verse number="3" style="v" sid="EPH 2:3"/>సొత్తాక అగరె అమల్లా యే అవిస్వాసినె సంగరాక అమె దేరో దుస్టస్వబావం అనుసరించికిరి జీంచొ. దేకు మనుసుకు నచ్చిలాపనికిరి కొరుకుంటా, పొదర్లింకెపనికిరి స్వబావసిద్దంగా పురువురొ రగ్గొకు కారకునెగా అచ్చొ.<verse eid="EPH 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 2:4"/>ఈనె పురువురొ మహాకరున ఇంకా గొప్ప ప్రేమ తవ్వురొ వల్లరె, <verse eid="EPH 2:4"/><verse number="5" style="v" sid="EPH 2:5"/>అమె అం అతిక్రమానె సంగరె ఆత్మీయంగా మొరికిరితల్లాబెల్లె, పురువురొ క్రుపసంగరాక తొముకు రక్సన దీకిరి క్రీస్తుద్వారా అముకు జీపించిసి.<verse eid="EPH 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EPH 2:6"/>పురువు క్రీస్తుయేసురె అమె ఏకమైవురొ వల్లరె అముకు తాసంగరంకా ఉటిదీకిరి, పరలోకంరె తాసంగరెపాటు సింహసనం ఉంపరె బొసరదీగిచ్చి.<verse eid="EPH 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 2:7"/>అయితల్లా యుగాల్రె క్రీస్తు యేసురె పురువు కొరిలా ఉపకారం ద్వారా అత్యదికమైలా తా క్రుపాసమ్రుద్ది అముకు దిగదీతే సెయ్యె యాకిరి కొరిసి. <verse eid="EPH 2:7"/><verse number="8" style="v" sid="EPH 2:8"/>తొమె విస్వాసం ద్వారా క్రుపసంగరాక రక్సన పొందిగిచ్చొ. యెడ తొము వల్లరె కలిగిలాటని, పురువాక బహుమానంగా దీసి. <verse eid="EPH 2:8"/><verse number="9" style="v" sid="EPH 2:9"/>సడ అం పైటీనె వల్లరె కలిగిలాటని గనక కేసే గొప్పానె కొయిగిన్నాసి. <verse eid="EPH 2:9"/><verse number="10" style="v" sid="EPH 2:10"/>అముకు పురువురొ స్రుస్టిగా, పురువు అగరాక సిద్దపరిచిలా బొల్టపైటీనె కొరితె కోసమాక అముకు క్రీస్తు యేసురె స్రుస్టించిసి.<verse eid="EPH 2:10"/></para>
  <para style="s">క్రీస్తురె ఏకమైవురొ</para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 2:11"/>ఈనె పూర్వం తొమె దేకుఅనుసరించిలా పొదరెలింకెనె. “దేద్వారా మనమానె అత్తరె సున్నతి పొందిలా యూదునె” తొముకు “సున్నతి నీలాలింకె” బులి డక్కితవ్వె బులి గుర్తించిగీండి. <verse eid="EPH 2:11"/><verse number="12" style="v" sid="EPH 2:12"/>సే కలొరె తొమె క్రీస్తుకు ఏరుగా అచ్చొ. ఇస్రాయేలురె పౌరసత్వం నీలాలింకెపనికిరి వాగ్దాన నిబందనానెకు పొదర్లింకెపనికిరి, నిరీక్సన నీలాలింకెపనికిరి, లొకొరె పురువు నీలాలింకెపనికిరి అచ్చొ. <verse eid="EPH 2:12"/><verse number="13" style="v" sid="EPH 2:13"/>ఈనెను అగరె పురువుకు దూరుగా తల్లా తొమె ఉంచినె క్రీస్తు యేసురె క్రీస్తు రొగుతొ ద్వారా పురువుకు పక్కరైసొ.<verse eid="EPH 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 2:14"/>సెయ్యాక అముకు సాంతి. సెయ్యె యూదునెకు యూదునెనీలాలింకు ఏకం కొరిసి. అం దీలింకు మొజిరె విరోదంబుల్లా అడ్డు గోడకు తా దే ద్వారా కూలమరిసి. <verse eid="EPH 2:14"/><verse number="15" style="v" sid="EPH 2:15"/>యాకిరి సే ఉబయులు తీకిరి గుటె నో ప్రజకు స్రుస్టించితే విదులూనె, ఆజ్ఞానె తల్లా దర్మసాస్త్రముకు రద్దు కొరిసి. <verse eid="EPH 2:15"/><verse number="16" style="v" sid="EPH 2:16"/>తంకెబిత్తరె రొల్లా ద్వేసముకు క్రీస్తుసిలువ మొర్నొ ద్వారా సత్రుత్వముకు కడిపీకిరి, అంకు బయులుకు పురువు సంగరె ఏకం కొరికిరి మిసితె సాంతి కొరిమాసిబులి యాకిరి కొరిసి. <verse eid="EPH 2:16"/><verse number="17" style="v" sid="EPH 2:17"/>సడకాక యేసు అయికిరి పొదరెలింకెగా రొల్లా తొముకు పక్కరెగా రొల్లా తంకు సమాదాన సువార్త ప్రకటించిసి. <verse eid="EPH 2:17"/><verse number="18" style="v" sid="EPH 2:18"/>యేసు ద్వారాక తొమె అమ్మె గుట్టాత్మ ద్వారాక బోపక్కు చేరిగీపారొ. <verse eid="EPH 2:18"/><verse number="19" style="v" sid="EPH 2:19"/>ఈనె పొదర్లింకైలా తొమె ఉంచినె తీకిరి పొదర్లింకె పొదరొదెసొలింకెనింతొ. పురువురొ మనమానె సమానమైలా పౌరులునె, పురువురొ కుటుంబం మనమానె.<verse eid="EPH 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 2:20"/>క్రీస్తు యేసాక ముక్యమైలా మూలపొత్రొగా రొయికిరి అపోస్తులునె ప్రవక్తానె పొగిలా పునాదంపరె బందికరచ్చొ. <verse eid="EPH 2:20"/><verse number="21" style="v" sid="EPH 2:21"/>తా వల్లరాక తా కుటుంబం బుల్లా బంద బొల్లే అమిర్చికిరి, ప్రబువు కోసం పవిత్రమైలా దేవాలయంగా రూపొందుకుంటా అచ్చి. <verse eid="EPH 2:21"/><verse number="22" style="v" sid="EPH 2:22"/>తాబిత్తరె తొమ్మంకా ఆత్మరె పురువుకు నివాసంగా రొయితె ఏకమైలీసొ.<verse eid="EPH 2:22"/></para>
  <chapter eid="EPH 2"/>
  <chapter number="3" style="c" sid="EPH 3"/>
  <para style="s">యూదునె నీలాలింకె కోసమాక పౌలురొ పైటి</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 3:1"/>యే కారనం వల్లారాక యూదునెనీలాలింకె తొముగురించి క్రీస్తు యేసురో కైదీయైలా పౌలు బుల్లా మియ్యి ప్రార్దించిలించి. <verse eid="EPH 3:1"/><verse number="2" style="v" sid="EPH 3:2"/>తొముకోసం మెత్తె అనుగ్రహించిలా పురువురొ క్రుపవిసయమైలా తొం కోసం ప్రత్యేకమైలా బాద్యత దీసిబులి తొమె సునికిరి అచ్చొ.<verse eid="EPH 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 3:3"/>పురువు నుచ్చిదిల్లా తా ప్రనాలిక మెత్తె తెలియపర్చిసి. అడ గురించి తొముకంకా తెలిసిలా సంగతి స్పస్టంగా రాసించి. <verse eid="EPH 3:3"/><verse number="4" style="v" sid="EPH 3:4"/>మీ రాసిలాంచకు తొమె చదివినె క్రీస్తు గురించి నుచ్చిదిల్లా సంగతీనె అర్దం కొరిగిపారొ. <verse eid="EPH 3:4"/><verse number="5" style="v" sid="EPH 3:5"/>యే నుచ్చిదిల్లా ప్రనాలిక ఉంచినె ఆత్మ ద్వారా పురువురొ పవిత్రమైలా అపోస్తులింకు ప్రవక్తానెకు వెల్లడికొరిలాపనికిరి పూర్వదినోనెరొ మనమానుకు బయలుపర్చిలాని. <verse eid="EPH 3:5"/><verse number="6" style="v" sid="EPH 3:6"/>యే నుచ్చిదిల్లా ప్రనాలిక కిడబుల్నే, సువార్త ద్వారా అన్యజనులంకా యూదునె సంగరె క్రీస్తు యేసురె సమానమైలా వారసులూనె, గుట్టె దేబిత్తరొ బాగాలునె, వాగ్దానంరె పాలిబాగస్తునె ఈకిరి అచ్చె బుల్లాటాక.<verse eid="EPH 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 3:7"/>మియ్యి సే సువార్తకు పైటిమనమైంచి. పురువురొ సక్తిసంగరె తా క్రుప వల్లరాక యెడ సాద్యమైసి.<verse eid="EPH 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EPH 3:8"/>పురువురొ మనమానె సొబ్బిలింకెబిత్తరె అత్యల్పుడైలా మెత్తె అమె ఊహించినార్లా క్రీస్తు ఐస్వర్యముకు యూదునెనీలాలింకె సువార్త ప్రకటంచితె అవకాసం దీసి. <verse eid="EPH 3:8"/><verse number="9" style="v" sid="EPH 3:9"/>సొబ్బిటికి స్రుస్టికర్తైలా పురువురె అనాది తీకిరి నుచ్చుకిరి తల్లా సే నుచ్చిదిల్లా ప్రనాలికకు సొబ్బిలింకు వెల్లడి కొరితె పురువు సే క్రుపకు మెత్తె అనుగ్రహించిసి. <verse eid="EPH 3:9"/><verse number="10" style="v" sid="EPH 3:10"/>తా నుచ్చిదిల్లా ప్రనాలికరొ జ్ఞానం సంగము ద్వారా వాయుమండలమురొ ప్రదానులునె అదికారినె తెలిసిగిమ్మాసిబులి పురువురొ ఉద్దేసం. <verse eid="EPH 3:10"/><verse number="11" style="v" sid="EPH 3:11"/>సడ అం ప్రబువైలా క్రీస్తుయేసురె పురువు కొరిలా తా నిత్యమైలా ప్రనాలిక. <verse eid="EPH 3:11"/><verse number="12" style="v" sid="EPH 3:12"/>క్రీస్తంపరె అముకురొల్లా విస్వాసం వల్లరాక తాదీకిరి అముకు దైర్యం, పురువురొ సన్నిదికు ప్రవేసించితె స్వేచ్చ కలిగిసి. <verse eid="EPH 3:12"/><verse number="13" style="v" sid="EPH 3:13"/>సడవల్లరె తొముకోసం మెత్తె కలిగిలా హింసానె దిక్కిరి తొమె అదైర్యపొడితెనాండి. యెడానె తొముకు పైటికైతె కారనాలుగా తాసి.<verse eid="EPH 3:13"/></para>
  <para style="s">క్రీస్తురొ ప్రేమ</para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 3:14"/>యే కారనం వల్లరె బో అగరె మీ మోకాల్లు పొక్కిరి ప్రార్దించిలించి.<verse eid="EPH 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 3:15"/>కైంకిబుల్నే పరలోకంరె, బూమంపరె తల్లా ప్రతీ కుటుంబం తా నారాక అంగీకరించబొడిలీసి. <verse eid="EPH 3:15"/><verse number="16" style="v" sid="EPH 3:16"/>పురువు తా బిత్తరె రొల్లా తా ఆత్మ ద్వారా తా గొప్ప మహిమకు తొముకు దీకిరి సక్తిసంగరె తొముకు బలపర్చుబులి మగిలించి.<verse eid="EPH 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 3:17"/>ఈనె క్రీస్తు తొం హ్రుదయాల్రె విస్వాసం ద్వారా నివసించిమాసి. తొమె తా ప్రేమరె సెరోనె సొచ్చికిరి స్దిరంగా రొమ్మాసి యెడాక మో ప్రార్దన. <verse eid="EPH 3:17"/><verse number="18" style="v" sid="EPH 3:18"/>సడవలరె పురువురొ మనమానె సొబ్బిలింకుసంగరె మిసికిరి క్రీస్తుప్రేమరె వొంచు, వెడల్పు, లోతు, ఎత్తు బడే పూర్తిగా గ్రహించిమాసి బులి, <verse eid="EPH 3:18"/><verse number="19" style="v" sid="EPH 3:19"/>జ్ఞానముకు మించిలా క్రీస్తు ప్రేమకు తెలిసిగిత్తే తగిలా సక్తి పొందివాసిబులి ఇంకా పురువురొ పోలికకు అయిమాసి బులి మో ప్రార్దన. <verse eid="EPH 3:19"/><verse number="20" style="v" sid="EPH 3:20"/>అం బిత్తరె పైటికొరిలా తా సక్తి ప్రకారం అమె మగిలాటకన్నా, ఊహించిలాటకన్నా బడే బూతు కొరిపారిలా సక్తి గలిగిలా,<verse eid="EPH 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 3:21"/>పురువుకు, సంగమురె క్రీస్తు యేసురె తరతరమునెకు నిత్యము మహిమ కలిగిమాసి. ఆమేను.<verse eid="EPH 3:21"/></para>
  <chapter eid="EPH 3"/>
  <chapter number="4" style="c" sid="EPH 4"/>
  <para style="s">సంగమురొ ఐక్యత</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 4:1"/>ఈనె ప్రబువు కోసం కైదీయైలా మియ్యి తొముకు బతిమాలిగిల్లాట కిడబుల్నే పురువు తొమె డక్కిలా డక్కకు తగిలపనికిరి జీవించండి <verse eid="EPH 4:1"/><verse number="2" style="v" sid="EPH 4:2"/>ప్రేమసంగరె జొనుకు జొనె సహించిగీకుంటా సంపూర్న వినయం, సాత్వికం, సమాదానం కలిగికిరి రోండి, <verse eid="EPH 4:2"/><verse number="3" style="v" sid="EPH 4:3"/>సమాదానం బుల్లా బందందీకిరి ఆత్మకలిగించిలా ఐక్యతకు కాపాడిగీకుంటా స్రద్ద కలిగికిరి సలిగిమాసి.<verse eid="EPH 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 4:4"/>దే గుట్టాక, ఆత్మ గుట్టాక సాకిరాక పురువు తొముకు డక్కిలా డక్క గుట్టాక నిరీక్సన గుట్టాక <verse eid="EPH 4:4"/><verse number="5" style="v" sid="EPH 4:5"/>ప్రబువు జొన్నాక, విస్వాసం గుట్టాక. బాప్టీసం గుట్టాక. <verse eid="EPH 4:5"/><verse number="6" style="v" sid="EPH 4:6"/>సొబ్బిలింకు బో ఈలా పురువు జొన్నాక. సెయ్యె సొబ్బిలింకన్నా ఉంపరె తల్లాట, సొబ్బిలింకె బిత్తరె అచ్చి సొబ్బిలింకె ద్వారా పైటి కొరిపించిలీసి.<verse eid="EPH 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 4:7"/>ఈనె క్రీస్తు అనుగ్రహించిలా క్రుప నప్పకు దరికిరి అం బిత్తరె సొబ్బిలింకూ వరం దీసి. <verse eid="EPH 4:7"/><verse number="8" style="v" sid="EPH 4:8"/>యెడ గురించాక</para>
  <para style="q1" vid="EPH 4:8">సెయ్యె ఆరోహనమైలాబెల్లె</para>
  <para style="q2" vid="EPH 4:8">బందీనుకు చెరబిత్తురుకు కొడిబాజేసిబులి</para>
  <para style="q2" vid="EPH 4:8">తా మనమానుకు బహుమానాలు దీసిబులి లేకనంరె కొయికిరి అచ్చి.<verse eid="EPH 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 4:9"/>“ఆరోహనమైజేసి” బుల్లా కొతకు అగరె సెయ్యె బూమి తొల్లుకు వొల్లిసి బులికిరంకా అర్దం దిల్లీసి. <verse eid="EPH 4:9"/><verse number="10" style="v" sid="EPH 4:10"/>సాకిరి వొల్లిలాటాక సెయ్యాక సొబ్బిటుకు వ్యాపించికిరి, మెగోనె మహా మెగొనల్లా దాటికిరి, బడే ఉంపురుకు ఎక్కికిరి అచ్చి.<verse eid="EPH 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 4:11"/>సెయ్యె వరమూనె దీకిరి కుండెలింకు అపోస్తునెగా, కుండెలింకు ప్రవక్తానెగా, కుండెలింకు సువార్తకులుగా, యింకుండెలింకు జొగులోనెగా, బొదకులుగా నియమించిసి.<verse eid="EPH 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EPH 4:12"/>సడద్వారా విస్వాసునెకు సేవా కార్యమునెకు సిద్దం కొరిమాసిబులి క్రీస్తు దేరె క్సేమాబివ్రుద్ది కలిగిమాసిబులి సెయ్యె యాకిరి కొరిసి. <verse eid="EPH 4:12"/><verse number="13" style="v" sid="EPH 4:13"/>ఇంకా అమల్లా విస్వాసంరె, పురువురొ పో గురించైలా జ్ఞానంరె గుట్టాకబావం కలిక్కిరి రొమ్మాసిబులి క్రీస్తు కలిక్కిరి రొల్లా పరిపూర్న పరినతికి సమానమైలా వ్రుద్ది చెందిమాసి. <verse eid="EPH 4:13"/><verse number="14" style="v" sid="EPH 4:14"/>సెత్తెలె అమె పసిపిల్లానె పనికిరి నీకుంటా మనమానె కపటం సంగరె, కుయుక్తి సంగరె తప్పు బట్టొకు జింకిమాసిబులి కల్పించిగిల్లా సొబ్బిరకాల బోదానె బుల్లా కదిలితల్లా అలానె, బా మడ్డోనుకు పిట్టిగీకిరి నాబాజీకుంటా రొమ్మా. <verse eid="EPH 4:14"/><verse number="15" style="v" sid="EPH 4:15"/>సడకు బదులుగా ప్రేమ సంగరె సత్యమాక కొయికుంటా సొబ్బి విసయాల్రె అముకు సిరస్సు యీకిరి తల్లా క్రీస్తు పనికిరి బొడుమా. <verse eid="EPH 4:15"/><verse number="16" style="v" sid="EPH 4:16"/>సెయ్యాక. తా దీకిరి సంగం బుల్లా దే బొల్లే అమిర్చికిరి, తాండ్రెతీకిరి ప్రతీ బాగాలూనె కీల్లు సంగరె మిసికిరి రొయికిరి, సడ తా సక్తికొద్దీ పైటి కొరిలాబెల్లె ప్రేమరె సడకు క్సేమాబివ్రుద్ది కలిగిలాపనికిరి అబివ్రుద్ది చెందుసి.<verse eid="EPH 4:16"/></para>
  <para style="s">క్రీస్తురె నో జీక</para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 4:17"/>ఈనె తొమె ఎట్టెతీకిరి యూదునెనీలాలింకె సలిగిల్లాపనికిరి సలినాసిబులి ప్రబువు నారె తొముకు హెచ్చరించిలించి. <verse eid="EPH 4:17"/><verse number="18" style="v" sid="EPH 4:18"/>కైంకిబుల్నే తంకె మనుసూనె అందకారమైజీకిరి తంకె హ్రుదయం కటినమైజిల్లందరె తంకె అజ్ఞానం వల్లరె సలిగీకిరి పురువురొ జీవంతీకిరి వేరైజీసె. <verse eid="EPH 4:18"/><verse number="19" style="v" sid="EPH 4:19"/>తంకె లజ్జొనీకుంటా అత్యాస సంగరె బడేరకానెగా అపవిత్రమైలా పైటీనె కొరితె కోసం తంకె తంకాక కామవికారాలుకు ఒప్పకొయిగిల్లీసె. <verse eid="EPH 4:19"/><verse number="20" style="v" sid="EPH 4:20"/>ఈనె తొమె క్రీస్తు గురించి సుగ్గిల్లాట యెడనీ. <verse eid="EPH 4:20"/><verse number="21" style="v" sid="EPH 4:21"/>యేసురె సత్యం గురించి తల్లాట తల్లా పనికిరాక తొమె ఉపదేసం పొందిసొ. <verse eid="EPH 4:21"/><verse number="22" style="v" sid="EPH 4:22"/>ఈనె తొమె అగరె జీవితముకు సంబందించిలాట, మోసకరమైలా దురాసవలరె చెడిజేకిరితల్లా తొం పుర్నస్వబావముకు సడదేండి. <verse eid="EPH 4:22"/><verse number="23" style="v" sid="EPH 4:23"/>తొం అంతరంగంరొ మనుసూనె నో ఈకిరి ఈవాసి. <verse eid="EPH 4:23"/><verse number="24" style="v" sid="EPH 4:24"/>నీతిరె యదార్దమైలా పవిత్రత కలిక్కిరి పురువు పొలికగా కొరిలా నో స్వబావంకు పిందిగివాసి. <verse eid="EPH 4:24"/><verse number="25" style="v" sid="EPH 4:25"/>అమె క్రీస్తు దేరె జొనుకు జొనె అవయవానె పనాలింకె. గనక తొమె సొరొకొతానె మానికిరి తొం సంగరొ మనమదీకిరి సత్యమాక కొయిమాసి. <verse eid="EPH 4:25"/><verse number="26" style="v" sid="EPH 4:26"/>రగొ పొడువొచ్చు గని సడ పాపముకు బట్టొకడినాసి. తొం రగొ బెల్లొ గుమ్మిలాదాకా రొన్నాసి.<verse eid="EPH 4:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EPH 4:27"/>అపవాదికు చోటు దీతేనాండి<verse eid="EPH 4:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="EPH 4:28"/>చొరొపైటి కొరితల్లాట సడకు సడదిమ్మాసి. తా అత్తోనె సంగరె కొస్టొపొడికిరి పైటికొరికిరి అవసరం రొల్లాలింకు సాయం కొరిమాసి. <verse eid="EPH 4:28"/><verse number="29" style="v" sid="EPH 4:29"/>తొం తుండొతీకిరి చెడుకొతానె అయినాసి. సునిలాలింకు పైటికైలాపనికిరి తంకు అబివ్రుద్ది కలిగిలా కొతానాక కోండి.<verse eid="EPH 4:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EPH 4:30"/>పురువురొ పవిత్రాత్మకు దుక్కపరిస్తేనా. కైంకిబుల్నే తా నిచ్చయతముద్ర తొం విమోచన దినో దాకా తొమంపరె రోసి. <verse eid="EPH 4:30"/><verse number="31" style="v" sid="EPH 4:31"/>సమస్తమైలా దుస్టత్వం ద్వేసం, రగో, రౌద్రం, అల్లరి, దూసన బుల్లా సడానల్లా సడదేండి.<verse eid="EPH 4:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="EPH 4:32"/>సడకు బదులుగా హ్రుదయంరె కరున కలిక్కిరి జొనంపరె జొనె దయ దిగదేండి. పురువు తొముకు క్యాకిరి క్రీస్తురె క్సమించిసొ సాకిరాక తొమ్మంకా పొదర్లింకు క్సమించిమాసి.<verse eid="EPH 4:32"/></para>
  <chapter eid="EPH 4"/>
  <chapter number="5" style="c" sid="EPH 5"/>
  <para style="s">హల్లొరె జీవురొ</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 5:1"/>ఈనె తొమె పురువురొ ప్రియమైలా పిల్లానెపనికిరి తాకు పోలికిరి సలిగీండి <verse eid="EPH 5:1"/><verse number="2" style="v" sid="EPH 5:2"/>క్రీస్తు అముకు ప్రేమించికిరి అముకోసం పురువుకు ఇస్టమైల పరిమలమైలా అర్పనగా, తాకు సెయ్యాక బలిగా అప్పకొయిగిచ్చి. సడపనా ప్రేమకాక తొమ్మంకా కలిక్కిరి రోండి.<verse eid="EPH 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 5:3"/>తొం బిత్తరె దర్నిపైటి, అపవిత్రత, పిసినారితనం, యెడనల్లా తన్నాసి. కనీసం తొమె సే నానైనన్నా టెక్కినాసి. యెడాక పురువురొ మనమానెకు తగిలా ప్రవర్తన.<verse eid="EPH 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 5:4"/>క్రుతజ్ఞత కొతానాక తొం తుండొ సంగరె అయిమాసి గని, అసబ్యమైలా కొతానె, మూర్కమైలా కొతానె, దీట అర్దాలు అయిలా కొతానె తొమె పలికినాసి. యెడానె తొముకు తగినింతె. <verse eid="EPH 5:4"/><verse number="5" style="v" sid="EPH 5:5"/>తొముకు తెలుసు దర్నిపైటిలింకు అపవిత్రమైలాలింకు, విగ్రహారదికులులింకు, అత్యాస కలిగిలాలింకు క్రీస్తుకు, పురువుకు చెందిలా దెసొకు అర్హత నీ.<verse eid="EPH 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EPH 5:6"/>నాపైటికైలా కొతానె కొయిలాలింకు వల్లరె పాడైజీతేనాండి. సడపనాంచ వల్లరె కొతా నాసున్లాలింకంపరకు పురువురొ ఉగ్రత ఆసి. <verse eid="EPH 5:6"/><verse number="7" style="v" sid="EPH 5:7"/>సడకాక తంకు దూరుగా రోండి.<verse eid="EPH 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EPH 5:8"/>అడకగరె కలొరె తొమె వొందారైకిరి అచ్చొ. ఈనె ఉంచినె ప్రబువురె హల్లొ యికిరచ్చొ. హల్లొకు సంబందించిలాలింకె పనికిరి సలిగీండి.<verse eid="EPH 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 5:9"/>కైంకిబుల్నే హల్లొరొ పలం సొబ్బిరకాలుగా బొల్టతనం, న్యాయం, సత్యం దిగదెల్లీసి. <verse eid="EPH 5:9"/><verse number="10" style="v" sid="EPH 5:10"/>ఈనె ప్రబువుకు కిడ ఇస్టమో సడ ద్వారాగా సలిగీండి.<verse eid="EPH 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 5:11"/>నాపైటికైలా వొందారొ పైటీనెరె నారొయికుంటా సడానుకు బదులుగా హల్లోరె దన్నెయిండి. <verse eid="EPH 5:11"/><verse number="12" style="v" sid="EPH 5:12"/>కైంకిబుల్నే తంకె రహస్యంగా కొరితల్లా పైటీనె గురించి కొతాలగువురొ కూడా బడే అవమానం.<verse eid="EPH 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EPH 5:13"/>ప్రతీ పైటీ హల్లొ సంగరె పొదరకు ఆసి. సాకిరి పొదరెపొడ్లా హల్లొ ప్రతీస్దలంరె సత్యరూపముకు ప్రకాసించుకుంటాక తాసి. <verse eid="EPH 5:13"/><verse number="14" style="v" sid="EPH 5:14"/>సాకిరి పొదరె పొడ్లాట ప్రతీటా హల్లాక. సడకాక,</para>
  <para style="q1" vid="EPH 5:14">గుమ్మితల్లా తూ ఉటూ</para>
  <para style="q2" vid="EPH 5:14">మొరిజెల్లాలింకబిత్తరె తీకిరి ఉటూ</para>
  <para style="q1" vid="EPH 5:14">క్రీస్తు తొ ఉంపరె ప్రకాసించువొ బులి కొయిలీసి.<verse eid="EPH 5:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 5:15"/>తెలివినీలాలింకెపనికిరినీకుంటా తెలివిగా జీతె జాగర్త పొడండి. <verse eid="EPH 5:15"/><verse number="16" style="v" sid="EPH 5:16"/>కలొకు బొల్టపైటీనె కోసం వాడిగీండి. కైంకిబుల్నే దినోనె బొల్టాంచనీ. <verse eid="EPH 5:16"/><verse number="17" style="v" sid="EPH 5:17"/>సడకాక తొమె తెలివినీలాలింకెపనికిరి నా తైకిరి ఈనె ప్రబువు ఇస్టం కిడవో తెలిసిగీండి.<verse eid="EPH 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EPH 5:18"/>మొద్దొ పీకిరి మత్తులైజీతేనాండి. సడ నాసనం కొరుసి. ఈనె సడకు బదులుగా ఆత్మసంగరె పూరికిరి తాండి.<verse eid="EPH 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EPH 5:19"/>గిత్తోనెసంగరె సంగీతం సంగరె ఆత్మ సంబందమైలా గిత్తోనెసంగరె జొనుకు జొనె బలపర్చిగీకుంటా, ప్రబువు గురించి తొమె మనుసూన్రె గైకుంటా కీర్తించొండి. <verse eid="EPH 5:19"/><verse number="20" style="v" sid="EPH 5:20"/>అం ప్రబువైలా యేసుక్రీస్తు నారె సొబ్బిటి గురించి బో ఈలా పురువుకు సొబ్బికల్రే క్రుతజ్ఞతాస్తుతీనె చెల్లించోండి.<verse eid="EPH 5:20"/></para>
  <para style="s">నైపోనె ఇంకా గొయితానె</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 5:21"/>క్రీస్తు ఉంపరె తల్లా బక్తి సంగరె జొనుకు జొనె లోబొడికిరి తాండి.<verse eid="EPH 5:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EPH 5:22"/>తిల్డ్రలింకె ప్రబువుకు లోబొడికిరి తల్లాపనికిరాక తంకు గొయితానుకు లోబొడిమాసి. <verse eid="EPH 5:22"/><verse number="23" style="v" sid="EPH 5:23"/>క్రీస్తు సంగముకు కేవిదంగా ముండొ యీకిరి అచ్చో సాకిరాక గొయిత తా నైపొకు ముండొ యీకిరి అచ్చి. తాకు సెయ్యాక సంగంకు రక్సకుడుగా అచ్చి.<verse eid="EPH 5:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EPH 5:24"/>సంగం క్రీస్తుకు లోబొడిలా పనికిరాక నైపోనె కూడా సొబ్బి విసయాల్రె తంగొయితానుకు లోబొడిమాసి.<verse eid="EPH 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 5:25"/>గొయితానె, తొమ్మంకా సంగముకు క్రీస్తు ప్రేమించికిరి పొర్నొ దిల్లాపనాక తొం నైపోనుకు ప్రేమించిమాసి.<verse eid="EPH 5:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="EPH 5:26"/>యాకిరి కొరికిరి సంగముకు వాక్యంబుల్లా పనిసంగరె దొయికిరి, పవిత్రం కొరిసి, <verse eid="EPH 5:26"/><verse number="27" style="v" sid="EPH 5:27"/>సడకు కలంకమైనా, ముడతలన్నా, సడానె పనాంచ కిచ్చీ నీకుంటా పవిత్రంగా నిర్దోసంగా మహిమైలా పనికిరి తా అగరె తారదీగిచ్చి.<verse eid="EPH 5:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="EPH 5:28"/>సాకిరాక వొండ్రపోనె కూడా తంక సొంత దేనె పనికిరాక తంక నైపోనుకు ప్రేమించివలిసిలా బాద్యత అచ్చి. తా నైపుకు ప్రేమించిలాట తాకు ప్రేమించిగిల్లాపనికిరాక. <verse eid="EPH 5:28"/><verse number="29" style="v" sid="EPH 5:29"/>కేసే తా దేకు ద్వేసించిగిన్నీ, క్రీస్తు సంగముకు పోసించికిరి సంరక్సించిగిల్లా విదంగా తంకె దే కు దిగుసు. <verse eid="EPH 5:29"/><verse number="30" style="v" sid="EPH 5:30"/>సడకాక అం అల్లా క్రీస్తు దేకు బాగాలైకిరి అచ్చొ.<verse eid="EPH 5:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="EPH 5:31"/>“లేకనానెరె కొయిలాపన యెడవల్లరాక వొండ్రపో తా బోకు మాకు సడికిరి తా నైపుకు హత్తుగునుసి, తంకెదీలింకె గుట్టె దే ఊసె.” <verse eid="EPH 5:31"/><verse number="32" style="v" sid="EPH 5:32"/>యే లోతైలా సత్యం అర్దం కొరిగించి. ఈనె మియ్యి క్రీస్తు గురించి సంగం గురించి కొయిలించి. <verse eid="EPH 5:32"/><verse number="33" style="v" sid="EPH 5:33"/>ఈనె తొం బిత్తరె ప్రతీ గొయిత తాకు సెయ్యె కెత్తె ప్రేమించిగిల్లీసో తా నైపొకంకా సాకిరాక ప్రేమించిమాసి. సాకిరాక నైపొ తా గొయితకు గౌరవించిమాసి.<verse eid="EPH 5:33"/></para>
  <chapter eid="EPH 5"/>
  <chapter number="6" style="c" sid="EPH 6"/>
  <para style="s">పిల్లానె ఇంకా మాబోనె</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 6:1"/>పిల్లానె, ప్రబువురె తొం మాబోనుకు లోబొడికిరి రోండి. క్రైస్తవుడుగా యెడ తొం పైటి. <verse eid="EPH 6:1"/><verse number="2" style="v" sid="EPH 6:2"/>“తొత్తె మేలు కలిగిలాపనికిరి తో బోకు మాకు గౌరవించు. యెడ వాగ్దానంరె మిసికిరి రొల్లా అగరొ ఆజ్ఞ పాటించిమాసి.”<verse eid="EPH 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 6:3"/>సడ తొత్తె బూమంపరె దీర్గాయుసుకు దివ్వొ. <verse eid="EPH 6:3"/><verse number="4" style="v" sid="EPH 6:4"/>మాబోనే, తొం పిల్లానుకు రగొ పుట్టించితెనాండి. తంకు క్రీస్తురొ క్రమసిక్సనరె, బోదరె పుసొండి.<verse eid="EPH 6:4"/></para>
  <para style="s">దాసీనె ఇంకా యజమానినె</para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 6:5"/>సేవకులింకే, డొరొసంగరె వనుకు సంగరె, క్రీస్తుకు లోబొడిలాపనికిరి, యే లొకొరె తొం యజమానునెకు హ్రుదయపూర్వకంగా లోబొడికిరి రోండి.<verse eid="EPH 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EPH 6:6"/>మనమానుకు సంతోసం పరిచిలా పనికిరి తంకె పొదర్లింకు దిగిదిల్లపని నీకుంట క్రీస్తు దాసునె బులి తెలిసిగీకిరి పురువుకు కెడ ఇస్టమొ సడ కొరండి,<verse eid="EPH 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 6:7"/>ప్రబువుకు కొరిలాపనికిరాక యిస్టపూర్వకంగా కొరండి.<verse eid="EPH 6:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EPH 6:8"/>దాసుడైనన్నా, స్వతంత్రుడైనన్నా, తొం బిత్తరె ప్రతీ మనమ సెయ్యె కొరిలా బొల్ట పైటికు ప్రబువు వల్లరె ప్రతిపలం పొందిగివొబులి తొముకు తెలుసు.<verse eid="EPH 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 6:9"/>యజమానునే, తొమ్మంకా తొం దాసునె గురించి సాకిరాక ప్రవర్తించొండి. తొముకు తొం దాసూనుకు జొన్నాక యజమాని పరలోకంరె అచ్చిబులి, సెయ్యె పక్సపాతం నీలాటబులి గ్రహించికిరి, తంకు బెదిరించివురొ మానిగీండి.<verse eid="EPH 6:9"/></para>
  <para style="s">పురువు పక్కరె తల్లా సొబ్బి ఆయుదాలు</para>
  <para style="p">
    <verse number="10" style="v" sid="EPH 6:10"/>చివరకు, ప్రబువురొ మహాసక్తి ద్వారా తాబిత్తరె బలవంతులైకిరి రోండి .<figure style="fig" alt="Roman soldier" file="LB00196C.TIF" size="col" copy="Horace Knowles ©" ref="6:10">రోమా సైనికుడు</figure><verse eid="EPH 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 6:11"/>తొమె సాతాను మాయకొతానెకు ఎదిరించితె సక్తి పొందిగిత్తందుకు పురువు దిల్లా సర్వాంగ కవచముకు పిందిగీండి.<verse eid="EPH 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EPH 6:12"/>కైంకిబుల్నే అం పోరాటం మనమానె సంగరె నీ. ఈనె వొందారొ సంబందమైలా లొకొనాదూనె సంగరె, ప్రదానునె సంగరె, అదికారినె సంగరె, మెగోమండలాల్రె బిత్తరె దురాత్మానె సమూహానె సంగరె అమె పోరాడిలించొ.<verse eid="EPH 6:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EPH 6:13"/>సడకాక తొమె యే ఆపదకలొరె తంకు ఎదిరించికిరి సక్తిమంతునెగా తారితె పురువు దీతల్లా సర్వాంగ కవచముకు పిందిగీండి. <verse eid="EPH 6:13"/><verse number="14" style="v" sid="EPH 6:14"/>తొం వొంటకు సత్యం బుల్లా దట్టీ, నీతి బుల్లా కవచం పిందిగీండి,<verse eid="EPH 6:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 6:15"/>పాదమునెకు సాంతి సువార్త కోసం సిద్దమనుసు బుల్లా చెప్పిలీనె పిందిగీండి. <verse eid="EPH 6:15"/><verse number="16" style="v" sid="EPH 6:16"/>సడసంగరె పాటు సత్రువు బిసిరిలా నియ్య బానమునెకు అడ్డిగిత్తందుకు పైటికైలా విస్వాసం బుల్లా డాలు పిందిగీండి. <verse eid="EPH 6:16"/><verse number="17" style="v" sid="EPH 6:17"/>ఈనె రక్సన బుల్లా సిరస్త్రానం, పురువురొ వాక్కు బుల్లా ఆత్మకడ్గం పిందిగీండి. <verse eid="EPH 6:17"/><verse number="18" style="v" sid="EPH 6:18"/>ఆత్మరె సొబ్బి కలోన్రె సొబ్బిరకాల ప్రార్దనానె, విజ్ఞాపనానె కొరుకుంటా రోండి. సడకోసం పూర్తి పట్టుదల సంగరె పురువురొ మనమానె కోసం విజ్ఞాపనలూనె కొరుకుంటా సతనైకిరి రోండి. <verse eid="EPH 6:18"/><verse number="19" style="v" sid="EPH 6:19"/>సువార్త రహాస్యముకు దైర్యంగా కొయితె, మియ్యి కొతాలగితల్లాబెల్లె పురువు తా వాక్కుకు మెత్తె అనుగ్రహించిలా పనికిరి మో కోసమంకా ప్రార్దన కొరండి. <verse eid="EPH 6:19"/><verse number="20" style="v" sid="EPH 6:20"/>సంకెల్లు సంగరె రొల్లా మియ్యి యే సువార్త కోసం రాయబారి. మియ్యి యే సువార్తకు కెటువంటి దైర్యం సంగరె ప్రకటించిమాసో సెత్తాక దైర్యం సంగరె ప్రకటించిలపని మో కోసం ప్రార్దన కొరండి.<verse eid="EPH 6:20"/></para>
  <para style="s">ఆకరు దండము</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 6:21"/>మో ప్రియమైలా బయి తుకికు ప్రబువురె నమ్మకమైలా సేవకుడు. తా ద్వారా మియ్యి క్యాకిరి అచ్చొ, కిడ కొరిలించొ తొముకు తెలుసు.<verse eid="EPH 6:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EPH 6:22"/>అం సంగతీనె తొమె జనితందుకు, తొం మనుసూనెకు ప్రోత్సహించితె తాకు తొం పక్కు పొడదీంచి.<verse eid="EPH 6:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EPH 6:23"/>బో యీల పురువు, ప్రబువైలా యేసు క్రీస్తు సాంతికు విస్వాసం సంగరె దిగిపించిలా ప్రేమకు అన్నబయినె అప్పబొయినినె అనుగ్రహించిమాసి గాక.<verse eid="EPH 6:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EPH 6:24"/>అం ప్రబువైలా యేసు క్రీస్తుకు నిత్యమైలాప్రేమ సంగరె ప్రేమించిలాలింకల్లా పురువు క్రుప కలిగిమాసి గాక.<verse eid="EPH 6:24"/></para>
  <chapter eid="EPH 6"/>
</usx>
