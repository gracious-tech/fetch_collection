<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JER" style="id"/>
  <para style="h">عَننَبِ يٍرٍ مِ</para>
  <para style="toc1">عَلَ شَ مَسٍنيِ عَننَبِ يٍرٍ مِ بّ</para>
  <para style="toc2">عَننَبِ يٍرٍ مِ</para>
  <para style="toc3">يٍر</para>
  <para style="mt">عَلَ شَ مَسٍنيِ عَننَبِ يٍرٍ مِ بّ</para>
  <para style="imt">مَسٍنيِ ندٍ يِ كِتَابُي شَ قٍ رَ</para>
  <para style="ip">عِسِرَيِلَ نُ بَرَ عِتَشُن دْشْ قِرِن. سّيتِ نَشَن نُ نَ كْولَ مَ عَ نُ شِلِ عِسِرَيِلَ، سّيتِ نَشَن نُ نَ لَبٍ رَ عَ نُ شِلِ يُدَيَ. عَلَتَلَ نُ بَرَ عَ نِيَ عِسِرَيِلَ شَ شَنِن كٌنيِيَ كُي عَسِرِيَ بْشِ مَ عَ شَ يُنُبِيٍ شَ قٍ رَ. يُدَيَ نُ بَرَ رَتَنفَ نَ مَ بَرِ مَ مَنفّ ندٍيٍ نُ نَ نَشٍيٍ نُ وَ مَ بِرَقٍ عَلَتَلَ شَ سّرِيّ قْشْ رَ، عٍ مُ كُيٍ بَتُ. كْنْ عَ دْنشْي رَ، يُدَيَ قَن بَرَ سُشُ سٍنتَنّ شَ فَنتَنيِ رَ، عٍ قَ كُيٍ بَتُ قْلْ. عَننَبِ يٍرٍ مِ نُ قِندِشِ عَلَ شَ نَمِحْنمّ نَن نَ نَ تّمُي.</para>
  <para style="ip">عَننَبِ يٍرٍ مِ نَشَ عَلَ شَ سّرِيّ مَسٍن يُدَيَكَيٍ بّ عَ قَنيِ رَ، عَلَكٌ عٍ شَ عَ كٌلٌن عٍ شَ كُيٍ بَتُي قِندِ مَ قٍ حَاشِ نَن نَ عٍ بّ عَلَتَلَ مَبِرِ. عَ نَشَ عٍ كَوَندِ هَن، كْنْ عٍ مُ تِن فبِلٍندٍ عَلَ مَ. نَ كُي عَننَبِ يٍرٍ مِ شَ مَسٍنيِ بَرَ شْرْشْ. عَ نَشَ عَلَ شَ نَتّ تَفِ رَبَ عٍ بّ عَ قَلَقٍ رَ عٍ يَشُييٍ بَبِلْنكَيٍ قَمَ نّ عٍ بْنبْدٍ نَ يُنُبِ شَ قٍ رَ. هَلِ يُدَيَ تٌ قِندِشِ عَلَ شَ حَمَ رَ، عَلَ نُ بَرَ نَتّ تٌنفٌ عٍ شَ حَشَنكَتّ حَاشِ سْتْ بَبِلْنكَيٍ سَابُي رَ. عَننَبِ يٍرٍ مِ تٌ نَ قَلَ يُدَيَ مَنفّ بّ، عَ نَشَ شْنْ عَ مَ، عَ عَ سَ فٍيلِ كُي.</para>
  <para style="ip">يُدَيَكَيٍ مُ لَشِ عَ رَ عَ عٍ قِندِ بَبِلْن شَ كٌنيِيٍ نَن نَ عٍ شَ يُنُبِ شَ قٍ رَ. عٍ نَشَ عَ مَحْشُن عٍ نْمَ عٍ رَتَنفَدٍ نَ حَشَنكَتّ مَ مِسِرَكَيٍ سَابُي رَ. عَننَبِ يٍرٍ مِ نَشَ عَ مَسٍن عٍ شَ مَحْشُنيِ قِندِشِ وُلٍ نَن نَ نَشَن مُ رَقَنشِ عَلَ مَ. عَ نُ لَنمَ عٍ شَ تِن عَلَتَلَ شَ حَشَنكَتّ رَ، عٍ شَ عَ كٌلٌن عٍ نَ سْتْشِ قٍ نَشَن مَ.</para>
  <para style="ip">عَننَبِ يٍرٍ مِ شَ كِتَابُي نَ كَوَندِ نُن نَ تَرُشُي بِرِن مَسٍنمَ وٌن بّ. عَلَتَلَ شَ مَسٍنيِ عَ نَشَن قِشِ عَ شَ نَمِحْنمّ مَ، نَ بِرِن بَرَ كَمَلِ. عَدَ مَدِ بِرِن شَ عَ كٌلٌن يُنُبِ مُ قَن، عَ قِندِشِ حَشَنكَتّ نَن نَ عٍ بّ. نَ نَن عَ رَ، قٌ عٍ شَ فبِلٍن يُنُبِ قْشْ رَ، عٍ شَ بِرَ عَلَتَلَ شُي قْشْ رَ. نَ فبَنسَن نَن نْمَ قِندِدٍ سْونّيَ رَ عَدَ مَ بّ عَ شَ دُنِحّءِفِرِ كُي. عَلَ شَ وٌن مَلِ نَ كِرَ شْن مَ. عَمِنَ.</para>
  <para style="imte">عَلَ شَ مَسٍنيِ عَننَبِ يٍرٍ مِ بّ</para>
  <chapter number="1" style="c" sid="JER 1"/>
  <para style="s">عَننَبِ يٍرٍ مِ شَ وَلِ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 1:1"/>عَننَبِ يٍرٍ مِ شَ مَسٍنيِ نَن يَ. عَ بَبَ شِلِ شِلِكِيَ، سّرّشّدُبّ نَشَن كٍلِ عَنَتْتِ، بُنيَمِن بْشِ مَ. <verse eid="JER 1:1"/><verse number="2" style="v" sid="JER 1:2"/>يُدَيَ مَنفّ يٌسِيَ نَشَن نُ قِندِشِ عَمٌن شَ دِ رَ، عَ شَ مَنفّيَ حّ قُ نُن سَشَن ندٍ، عَلَتَلَ نَشَ وْيّن عَننَبِ يٍرٍ مِ بّ. <verse eid="JER 1:2"/><verse number="3" style="v" sid="JER 1:3"/>عَننَبِ يٍرٍ مِ مَن نُ كَوَندِ تِمَ يُدَيَ مَنفّ يٍهٌيَكِمِ شَ وَشَتِ، هَن يُدَيَ مَنفّ سٍدٍكِيَ شَ مَنفّيَ حّ قُ نُن كٍرٍن ندٍ، كِكٍ سُولِ ندٍ، دَرِ سَلَمُكَيٍ نُ شَنِنمَ كٌنيِيَ كُي تّمُي نَشّ. يٍهٌيَكِمِ نُن سٍدٍكِيَ نَن نُ نَ يٌسِيَ شَ دِيٍ رَ.<verse eid="JER 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 1:4"/>عَلَتَلَ نَشَ يِ مَسٍنيِ تِ ﭑ بّ يِ كِ،<verse eid="JER 1:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JER 1:5"/>«بٍينُ ﭑ شَ عِ نْنْ عِ نفَ تّيفّ،</para>
  <para style="q" vid="JER 1:5">ﭑ تَن نُ عِ كٌلٌن.</para>
  <para style="q" vid="JER 1:5">بٍينُ عِ نفَ شَ عِ سْتْ،</para>
  <para style="q" vid="JER 1:5">ﭑ نُ بَرَ شّيرَيَ رَفِرِ عِ مَ،</para>
  <para style="q" vid="JER 1:5">عِ شَ قِندِ نَمِحْنمّ رَ سِيٍ بِرِن شُن مَ.»<verse eid="JER 1:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="JER 1:6"/>ﭑ نَشَ عَ يَابِ،</para>
  <para style="q" vid="JER 1:6">«ﭑ مَرِفِ عَلَتَلَ، ﭑ مُ قَتَ مَسٍنيِ تِدٍ،</para>
  <para style="q" vid="JER 1:6">بَرِ مَ قٌنِكٍ نَن ﭑ نَ.»<verse eid="JER 1:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="JER 1:7"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ،</para>
  <para style="q" vid="JER 1:7">«عِ نَشَ عَ قَلَ عَ قٌنِكٍ نَن عِ رَ،</para>
  <para style="q" vid="JER 1:7">بَرِ مَ عِ تَن نَن سِفَمَ مِشِيٍ شْن مَ،</para>
  <para style="q" vid="JER 1:7">ﭑ عِ شّيمَ دّننَشّ.</para>
  <para style="q" vid="JER 1:7">عِ شَ ﭑ مَ يَامَرِ بِرِن مَسٍن عٍ بّ.<verse eid="JER 1:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 1:8"/>عِ نَشَ فَاشُ عٍ يَ رَ،</para>
  <para style="q" vid="JER 1:8">بَرِ مَ وٌن بِرِن نَن عَ رَ.</para>
  <para style="q" vid="JER 1:8">ﭑ عِ مَكَنتَمَ نّ.»</para>
  <para style="q" vid="JER 1:8">عَلَتَلَ شَ مَسٍنيِ نَن يَ.<verse eid="JER 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 1:9"/>نَ تّمُي عَلَتَلَ نَشَ عَ شْنيّ عِتَلَ ﭑ دّ مَ، عَ قَ عَ مَسٍن ﭑ بّ، «عِ بَرَ عَ تٌ، ﭑ بَرَ ﭑ مَ مَسٍنيِ سَ عِ شَشِلِ مَ. <verse eid="JER 1:9"/><verse number="10" style="v" sid="JER 1:10"/>تٌ ﭑ بَرَ عِ سُفَندِ عِ شَ قِندِ ﭑ مَ شّيرَ رَ دُنِحَ سِيٍ تَفِ. عِ شُننَكَنّ شَ قٍ قَلَمَ نّ مَنفّيَ ندٍيٍ بّ، عٍ قَ بِرَ، عٍ كَنَ. عِ شُننَكٍلِ شَ قٍ قَلَمَ نّ مَنفّيَ فبّتّيٍ بّ، عٍ قَ عٍ سَنكٍ سْرْن، عٍ سَبَتِ عَ قَنيِ رَ.»<verse eid="JER 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 1:11"/>عَلَتَلَ نَشَ يِ وْيّنيِ مَسٍن ﭑ بّ يِ كِ، «عَننَبِ يٍرٍ مِ، عِ مُنسٍ تٌشِ؟» ﭑ نَشَ عَ يَابِ، «ﭑ وُرِ نَن تٌشِ نَشَن بٌفِمَ سِننَنيِ مَ.» <verse eid="JER 1:11"/><verse number="12" style="v" sid="JER 1:12"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، «عِ بَرَ عَ تٌ عَ قَنيِ رَ، ﭑ مَ مَسٍنيِ رَكَمَلِقٍ مُ كَنَمَ.»<verse eid="JER 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 1:13"/>عَلَتَلَ مَن نَشَ يِ وْيّنيِ مَسٍن ﭑ بّ يِ كِ، «عِ مُنسٍ تٌشِ؟» ﭑ نَشَ عَ يَابِ، «ﭑ تُندٍ سَتُنشِ نَن تٌشِ كْولَ بِرِ.» <verse eid="JER 1:13"/><verse number="14" style="v" sid="JER 1:14"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، «حَشَنكَتّ بِرِن كٍلِمَ كْولَ نَن مَ، عَ قَ بْشِ حَمَ بِرِن هَلَكِ. <verse eid="JER 1:14"/><verse number="15" style="v" sid="JER 1:15"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ. ﭑ قَمَ نّ حَمَ بِرِن شِلِدٍ كٍلِقٍ كْولَ مَ، عٍ شَ عٍ شَ مَنفّ كِبَنيِيٍ دْشْ دَرِ سَلَمُ سٌدٍ دّ رَ، عٍ يِ تّتّ بِرِن نَبِلِن، عٍ يُدَيَ تَايٍ بِرِن سُشُ. <verse eid="JER 1:15"/><verse number="16" style="v" sid="JER 1:16"/>ﭑ عٍ مَكِيتِمَ نّ عٍ شَ قٍ كٌبِ رَبَشِيٍ مَ، بَرِ مَ عٍ بَرَ ﭑ قِنسِرِوَلِ، عٍ سُرَيِ فَن سّرّشّ رَ كُيٍيٍ بّ، عٍ تُوبِ عٍ بّ عٍ نَشٍيٍ يَءِلَنشِ عٍ بّلّشّ رَ. <verse eid="JER 1:16"/><verse number="17" style="v" sid="JER 1:17"/>عِ تَن شَ عِ تَفِ عِشِرِ، عِ شَ كٍلِ، عِ شَ ﭑ مَ مَسٍنيِ بِرِن تَفِ رَبَ عٍ بّ. عِ نَشَ فَاشُ عٍ يَ رَ، شَ نَ مُ عَ رَ ﭑ قٍ ندٍ مَسٍنمَ نّ عِ بّ نَشَن دَنفِ نٍيٍ رَ ثٌن. <verse eid="JER 1:17"/><verse number="18" style="v" sid="JER 1:18"/>تٌ ﭑ بَرَ عِ قِندِ شّيرَ رَ يُدَيَ مَنفّ، كُنتِفِيٍ، سّرّشّدُبّيٍ، نُن حَمَ بِرِن شُن مَ. عِ لُمَ نّ عَلْ تّتّ بٍلٍبٍلٍ وُرٍ دَاشِ، عَلْ يِرٍ مَكَنتَشِ. <verse eid="JER 1:18"/><verse number="19" style="v" sid="JER 1:19"/>عٍ عِ فٍرٍ مَ نّ، كْنْ عٍ مُ شُتُ سْتْمَ عِ مَ، بَرِ مَ ﭑ نَ عِ قْشْ رَ عِ مَكَنتَقٍ نَن نَ.» عَلَتَلَ شَ مَسٍنيِ نَن يَ.<verse eid="JER 1:19"/></para>
  <chapter eid="JER 1"/>
  <chapter number="2" style="c" sid="JER 2"/>
  <para style="s">عِسِرَيِلَكَيٍ شَ يَنقّ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 2:1"/>عَلَتَلَ نَشَ يِ وْيّنيِ مَسٍن ﭑ بّ يِ كِ،<verse eid="JER 2:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JER 2:2"/>«عِ شَ سَ عَ قَلَ دَرِ سَلَمُكَيٍ بّ،</para>
  <para style="q" vid="JER 2:2">عَلَتَلَ بَرَ عَ مَسٍن، ‹ﭑ بَرَ رَتُ وٌ شَ شَنُنتٍيَ مَ،</para>
  <para style="q" vid="JER 2:2">عَ نُ نَ كِ نَشّ سِنفٍ رَ وٌ قٌنِكٍ تّمُي.</para>
  <para style="q" vid="JER 2:2">وٌ نُ بَرَ بِرَ ﭑ قْشْ رَ فبٍنفبٍرٍن يِرٍ،</para>
  <para style="q" vid="JER 2:2">شّي مُ نُ سَشِ دّننَشّ.</para>
  <para style="q" vid="JER 2:2">وٌ نَ رَبَ مَرَقَنيِ نَن كُي.<verse eid="JER 2:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JER 2:3"/>عِسِرَيِلَ نُ قِندِشِ عَلَتَلَ نَن فبٍ رَ،</para>
  <para style="q" vid="JER 2:3">عَلْ سَنسِ بٌفِ سِنفٍ.</para>
  <para style="q" vid="JER 2:3">نَشٍيٍ عٍ تْورْ، نٍيٍ قَن قَمَ نّ تْورْدٍ.›»</para>
  <para style="q" vid="JER 2:3">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="JER 2:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="JER 2:4"/>يَشُبَ بْنسْي، وٌ شَ وٌ تُلِ مَتِ عَلَتَلَ شَ مَسٍنيِ رَ.</para>
  <para style="q" vid="JER 2:4">عِسِرَيِلَ شَبِلّ بِرِن، وٌ شَ وٌ تُلِ مَتِ.<verse eid="JER 2:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JER 2:5"/>عَلَتَلَ بَرَ عَ مَسٍن،</para>
  <para style="q" vid="JER 2:5">«وٌ بَبَيٍ ﭑ مَ قٍ كٌبِ مُندُن تٌشِ</para>
  <para style="q" vid="JER 2:5">نَشَن عَ نِيَشِ عٍ شَ فبِلٍن ﭑ قْشْ رَ؟</para>
  <para style="q" vid="JER 2:5">وٌ بَرَ بِرَ قٍ قُقَقُ قْشْ رَ،</para>
  <para style="q" vid="JER 2:5">عَوَ وٌ تَن قَن قِندِ مَ مِشِ قُقَقُ نَن نَ.<verse eid="JER 2:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JER 2:6"/>عٍ مُ عَ قَلَشِ وٌ بّ،</para>
  <para style="q" vid="JER 2:6">‹عَلَتَلَ نَ مِندٍن،</para>
  <para style="q" vid="JER 2:6">نَشَن وٌن نَمِنِشِ مِسِرَ بْشِ رَ،</para>
  <para style="q" vid="JER 2:6">نَشَن وٌن شَنِن فبٍنفبٍرٍن يِرٍ؟</para>
  <para style="q" vid="JER 2:6">قٌلٍيٍ نُن بْشِ مَشَرٍ فبَنسَن نَن نَ مّننِ.</para>
  <para style="q" vid="JER 2:6">عَدَ مَدِيٍ مُ نْمَ بَلٌدٍ نَ بْشِ مَ.›<verse eid="JER 2:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JER 2:7"/>ﭑ بَرَ وٌ شَنِن بْشِ قَنيِ مَ،</para>
  <para style="q" vid="JER 2:7">عَلَكٌ وٌ شَ بَلٌي قَنيِ سْتْ.</para>
  <para style="q" vid="JER 2:7">كْنْ وٌ تٌ قَ، وٌ بَرَ ﭑ مَ بْشِ قِندِ يِرٍ سّنِيّنتَرٍ رَ،</para>
  <para style="q" vid="JER 2:7">وٌ بَرَ قٍ شْنشِ رَبَ نَا ﭑ دّننَشّ قِشِ وٌ مَ كّ رَ.<verse eid="JER 2:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 2:8"/>سّرّشّدُبّيٍ مُ عَلَتَلَ قٍنشِ.</para>
  <para style="q" vid="JER 2:8">كَرَ مْشْي مُ ﭑ كٌلٌن.</para>
  <para style="q" vid="JER 2:8">يَرٍرَتِيٍ بَرَ ﭑ يَنقَ.</para>
  <para style="q" vid="JER 2:8">نَمِحْنمّيٍ بَرَ بَلَ كُيٍ مَسٍنيِ تِ.</para>
  <para style="q" vid="JER 2:8">عٍ بَرَ بِرَ سٍ قْشْ رَ نَشَن مُ نْمَ عٍ مَلِدٍ.<verse eid="JER 2:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JER 2:9"/>نَ نَن عَ تٌشِ ﭑ وٌ حَشَنكَتَمَ.»</para>
  <para style="q" vid="JER 2:9">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.</para>
  <para style="q" vid="JER 2:9">«ﭑ وٌ شَ مَمَدِيٍ قَن مَكِيتِ.<verse eid="JER 2:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JER 2:10"/>وٌ سَ كِتِمِ سُورِ مَتٌ،</para>
  <para style="q" vid="JER 2:10">وٌ شَ مِشِيٍ شّي كٍدَرِ،</para>
  <para style="q" vid="JER 2:10">وٌ نَ بِرِن مَتٌ عَ قَنيِ رَ.</para>
  <para style="q" vid="JER 2:10">وٌ مُ يِ كُيٍ بَتُقٍ مْولِ تٌمَ نَا.<verse eid="JER 2:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JER 2:11"/>سِ ندٍ نَ نَ نَشَن عَلَ بّحِن،</para>
  <para style="q" vid="JER 2:11">عٍ قَ كُيٍ قِندِ عٍ شَ عَلَ رَ؟</para>
  <para style="q" vid="JER 2:11">ﭑ مَ حَمَ بَرَ عٍ شَ شُننَكٍلِ مَسَرَ،</para>
  <para style="q" vid="JER 2:11">عٍ قَ عٍ شَشِلِ تِ كُيٍ رَ نَشَن مُ نْمَ عٍ مَلِدٍ.<verse eid="JER 2:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JER 2:12"/>كٌورٍ بَرَ قِندِ سٍيدٍ رَ نَ قٍ مَ.</para>
  <para style="q" vid="JER 2:12">نَ بَرَ قِندِ كِنِكِنِ نُن كَابَنَكٌ رَ.</para>
  <para style="q" vid="JER 2:12">عَ لَنمَ نَ شَ وٌ شَشِلِ عِقُ،</para>
  <para style="q" vid="JER 2:12">عَ شَ وٌ دّ عِشَرَ.»</para>
  <para style="q" vid="JER 2:12">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="JER 2:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="JER 2:13"/>«ﭑ مَ حَمَ بَرَ قٍ حَاشِ قِرِن نَبَ؛</para>
  <para style="q" vid="JER 2:13">عٍ بَرَ ﭑ بّحِن،</para>
  <para style="q" vid="JER 2:13">ﭑ تَن نَشَن نُ لُشِ عَلْ يٍ قَنيِ عٍ بّ،</para>
  <para style="q" vid="JER 2:13">يٍ نَشَن مُ حْنمَ.</para>
  <para style="q" vid="JER 2:13">عٍ بَرَ قّحّيٍ يَءِلَن، يٍ رَفَتَمَ دّننَشّ،</para>
  <para style="q" vid="JER 2:13">كْنْ عٍ عِبْوشِ، يٍ بِرِن بَرَ مِنِ عَ رَ.»<verse eid="JER 2:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="JER 2:14"/>«كٌنيِ نَن نَ عِسِرَيِلَ رَ،</para>
  <para style="q" vid="JER 2:14">كَ عَ قِندِشِ دِ لَسِرِ نَن نَ؟</para>
  <para style="q" vid="JER 2:14">مُنقٍ رَ عَ حَشَنكَتَشِ؟<verse eid="JER 2:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 2:15"/>عَ لُشِ نّ عَلْ يّتّ شَاحّ نَن نَ شَاحّقٍ عٍ مَ.</para>
  <para style="q" vid="JER 2:15">عٍ شَ بْشِ بَرَ قِندِ فبَلٌي يِرٍ رَ.</para>
  <para style="q" vid="JER 2:15">مِشِ يٌ مُ نَ سْنْن عٍ شَ تَا فَنشِيٍ كُي.<verse eid="JER 2:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 2:16"/>مِسِرَكَ نَشٍيٍ نَ نٌقِ نُن تَثَنشّسِ،</para>
  <para style="q" vid="JER 2:16">عٍ قَمَ نّ وٌ شُن نَكَنَدٍ.<verse eid="JER 2:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 2:17"/>نَ قَتَنشِ قٍ نَشَن مَ،</para>
  <para style="q" vid="JER 2:17">وٌ فبِلٍنشِ وٌ مَرِفِ عَلَتَلَ شَ كِرَ قَنيِ قْشْ رَ.<verse eid="JER 2:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JER 2:18"/>يَكْسِ مُنقٍ رَ وٌ نَ مِسِرَ كِرَ شْن؟</para>
  <para style="q" vid="JER 2:18">وٌ وَ مَ نِلِ شُرٍ يٍ نَن مِنقٍ؟</para>
  <para style="q" vid="JER 2:18">مُنقٍ رَ وٌ نَ عَسِرِ كِرَ شْن؟</para>
  <para style="q" vid="JER 2:18">وٌ وَ مَ عٍقِرَتِ شُرٍ يٍ نَن مِنقٍ؟<verse eid="JER 2:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JER 2:19"/>عَلَ شَ وٌ شَ كٌبِحَ رَفبِلٍن وٌ مَ.</para>
  <para style="q" vid="JER 2:19">عَلَ شَ وٌ شَ قِنسِرِوَلِيَ سَرٍ قِ وٌ مَ،</para>
  <para style="q" vid="JER 2:19">عَلَكٌ وٌ شَ عَ كٌلٌن فبِلٍنقٍ وٌ مَرِفِ عَلَتَلَ قْشْ رَ،</para>
  <para style="q" vid="JER 2:19">عَ قِندِشِ قٍ حَاشِ نُن قٍ شْنّ نَن نَ.</para>
  <para style="q" vid="JER 2:19">وٌ حَشَنكَتَشِ نّ بَرِ مَ وٌ بَرَ تٌندِ فَاشُدٍ ﭑ يَ رَ.»</para>
  <para style="q" vid="JER 2:19">مَنفّ عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="JER 2:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="JER 2:20"/>«كَبِ تّمُي شْننَكُيٍ ﭑ بَرَ وٌ لُ وٌ يّتّ يِ.</para>
  <para style="q" vid="JER 2:20">وٌ بَرَ عَ قَلَ عَ يَنقَنتٍيَ مُ نَ وٌ بْحّ كُي،</para>
  <para style="q" vid="JER 2:20">كْنْ وٌ بَرَ سِفَ كُيٍ بَتُدٍ فٍيَيٍ قَرِ وُرِ بُن مَ.</para>
  <para style="q" vid="JER 2:20">نَ بَرَ قِندِ لَنفٌيحَ رَ وٌ بّ.<verse eid="JER 2:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JER 2:21"/>وٌ نُ لُشِ نّ عَلْ وّنِ بِلِ قَنيِ ﭑ نَشَن سِشِ.</para>
  <para style="q" vid="JER 2:21">مُنسٍ عَ نِيَشِ وٌ شَ ﭑ نَبٌلٌ؟</para>
  <para style="q" vid="JER 2:21">يَكْسِ وٌ لُشِ نّ عَلْ وّنِ بِلِ حَاشِ</para>
  <para style="q" vid="JER 2:21">نَشَن مُ بٌفِ قَنيِ رَ مِنِمَ.<verse eid="JER 2:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JER 2:22"/>هَلِ وٌ وٌ مَشَ سٌدَ سَاقُنيِ رَ،</para>
  <para style="q" vid="JER 2:22">وٌ شَ يُنُبِ مُ نْمَ بَدٍ.»</para>
  <para style="q" vid="JER 2:22">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="JER 2:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="JER 2:23"/>«وٌ نْمَ عَ قَلَدٍ دِ،</para>
  <para style="q" vid="JER 2:23">‹ﭑ مُ نْشْشِ. ﭑ مُ بِرَشِ بَلِ كُيٍ قْشْ رَ؟›</para>
  <para style="q" vid="JER 2:23">وٌ وٌ قْشِ مَتٌ فُلُنبَ يِرٍ.</para>
  <para style="q" vid="JER 2:23">وٌ شَ وٌ حْشْ تِ وٌ شَ قٍ رَبَشِيٍ رَ.</para>
  <para style="q" vid="JER 2:23">وٌ بَرَ لُ عَلْ حْشْمّ فِنّ رَبّحِنشِ،<verse eid="JER 2:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JER 2:24"/>عَلْ وُلَءِ سٌقَلٍ نَشَن سٌقَلٍ شّمّ قٍنمَ عَ شِرِ مَ فبٍنفبٍرٍن يِرٍ.</para>
  <para style="q" vid="JER 2:24">ندٍ نْمَ عَ بَدٍ نَ مَ؟</para>
  <para style="q" vid="JER 2:24">مِشِ نَشَن كَتَمَ عَ سُشُدٍ، عَ تَفَنمَ نّ.</para>
  <para style="q" vid="JER 2:24">عَ مُ مَسْتْمَ قٌ نَ وَشَتِ دَنفِ.<verse eid="JER 2:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JER 2:25"/>وٌ نَشَ فبَتَ بِرَدٍ كُيٍ قْشْ رَ.</para>
  <para style="q" vid="JER 2:25">وٌ وٌ فِمَ نَا وٌ سَنيِ عِفٍلِ رَ،</para>
  <para style="q" vid="JER 2:25">هَلِ يٍ شْلِ نَ وٌ مَ.</para>
  <para style="q" vid="JER 2:25">كْنْ وٌ بَرَ ﭑ يَابِ،</para>
  <para style="q" vid="JER 2:25">‹عَدٍ، مُشُ مُ نْمَ فبِلٍندٍ كُيٍيٍ قْشْ رَ.</para>
  <para style="q" vid="JER 2:25">عٍ رَقَن مُشُ مَ، مُشُ وَ مَ كَقُقٍ عٍ رَ.›»<verse eid="JER 2:25"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="26" style="v" sid="JER 2:26"/>«عِسِرَيِلَكَيٍ قَمَ نّ لُدٍ يَافِ كُي</para>
  <para style="q" vid="JER 2:26">عَلْ مُحّتِ نَشَن سُشُشِ.</para>
  <para style="q" vid="JER 2:26">مَنفّيٍ، كُنتِفِيٍ، سّرّشّدُبّيٍ، نُن نَمِحْنمّيٍ،</para>
  <para style="q" vid="JER 2:26">عٍ بِرِن لُمَ نّ يَافِ كُي،<verse eid="JER 2:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="JER 2:27"/>نَشٍيٍ عَ قَلَمَ وُرِ مَسٌلِشِ بّ، ‹ﭑ بَبَ،›</para>
  <para style="q" vid="JER 2:27">نَشٍيٍ عَ قَلَمَ فّمّ مَسٌلِشِ بّ، ‹ﭑ دَا مَنفّ.›</para>
  <para style="q" vid="JER 2:27">نَ مِشِ مْولِ بَرَ عٍ كٌبٍ تِ ﭑ نَ،</para>
  <para style="q" vid="JER 2:27">عٍ بَرَ تٌندِ عٍ يَ رَقِندِدٍ ﭑ مَ.</para>
  <para style="q" vid="JER 2:27">كْنْ عٍ شَ تْورّ كُي،</para>
  <para style="q" vid="JER 2:27">عٍ مَن عَ قَلَمَ ﭑ بّ، ‹كٍلِ، عِ شَ مُشُ رَكِسِ.›<verse eid="JER 2:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="JER 2:28"/>وٌ شَ كُيٍيٍ نَ مِندٍن، وٌ نَشٍيٍ يَءِلَنشِ،</para>
  <para style="q" vid="JER 2:28">نَشٍيٍ بَرَ وُيَ يُدَيَ تَايٍ كُي؟</para>
  <para style="q" vid="JER 2:28">عٍ تَن شَ كٍلِ، عٍ شَ وٌ رَتَنفَ وٌ شَ تْورّ مَ،</para>
  <para style="q" vid="JER 2:28">شَ عٍ قَتَ نَ رَبَدٍ.<verse eid="JER 2:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="JER 2:29"/>مُنقٍ رَ وٌ تَن مَتَندِلَيٍ وَ مَ ﭑ مَكِيتِقٍ؟»</para>
  <para style="q" vid="JER 2:29">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="JER 2:29"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="30" style="v" sid="JER 2:30"/>«ﭑ بَرَ وٌ شَ دِيٍ بْنبْ عَلَكٌ عٍ شَ مَتِنشِن،</para>
  <para style="q" vid="JER 2:30">كْنْ عٍ مُ مَتِنشِنشِ.</para>
  <para style="q" vid="JER 2:30">وٌ بَرَ وٌ شَ نَمِحْنمّيٍ قَشَ وٌ شَ سَنتِدّفّمَ رَ،</para>
  <para style="q" vid="JER 2:30">عَلْ يّتّ شَاحّشِ.<verse eid="JER 2:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="JER 2:31"/>تٌ مِشِيٍ، وٌ شَ لَ عَلَ شَ مَسٍنيِ رَ.</para>
  <para style="q" vid="JER 2:31">ﭑ عِسِرَيِلَ لُشِ فبٍنفبٍرٍن يِرٍ نّ، شَ نَ مُ عَ رَ دِ مِ كُي؟</para>
  <para style="q" vid="JER 2:31">مُنقٍ رَ ﭑ مَ حَمَ عَ قَلَمَ،</para>
  <para style="q" vid="JER 2:31">‹مُشُ وَ مَ لُقٍ مُشُ يّتّ رَ،</para>
  <para style="q" vid="JER 2:31">مُشُ مُ بِرَ مَ عِ قْشْ رَ سْنْن؟›<verse eid="JER 2:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="JER 2:32"/>فِنّ دِ مّدِ نْمَ نّيمُدٍ عَ شَ كْنمَفٌرٍ مَ،</para>
  <para style="q" vid="JER 2:32">شَ نَ مُ عَ شَ دٍ مُي؟</para>
  <para style="q" vid="JER 2:32">ﭑ مَ حَمَ بَرَ نّيمُ ﭑ تَن مَ كَبِ تّمُي شْننَكُيٍ.<verse eid="JER 2:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="JER 2:33"/>وٌ بَرَ وٌ مَشِرِ عَلَكٌ وٌ شَ شَنُنتٍنيِ ندٍ قٍن.</para>
  <para style="q" vid="JER 2:33">وٌ بَرَ دَنفِ مِشِ بِرِن نَ نَ وَلِ كٌبِ مْولِ كُي.<verse eid="JER 2:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="JER 2:34"/>وٌ بَرَ سٍتَرٍيٍ قَشَ، نَشٍيٍ مُ قٍ حَاشِ يٌ رَبَشِ.</para>
  <para style="q" vid="JER 2:34">وٌ شَ دُفِيٍ نْشْشِ عٍ وُلِ رَ.<verse eid="JER 2:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="JER 2:35"/>كْنْ وٌ عَ قَلَمَ،</para>
  <para style="q" vid="JER 2:35">‹مُشُ مُ قٍ كٌبِ رَبَشِ.</para>
  <para style="q" vid="JER 2:35">عَلَ شَ شْنّ شَ فبِلٍن مُشُ قْشْ رَ.›</para>
  <para style="q" vid="JER 2:35">ﭑ تَن نَن وٌ مَكِيتِمَ نْندِ رَ،</para>
  <para style="q" vid="JER 2:35">بَرِ مَ وٌ بَرَ عَ قَلَ،</para>
  <para style="q" vid="JER 2:35">‹مُشُ مُ يُنُبِ رَبَشِ.›<verse eid="JER 2:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="JER 2:36"/>وٌ كِرَ مَسَرَشِ مُنقٍ رَ،</para>
  <para style="q" vid="JER 2:36">وٌ قَ وٌ شَشِلِ تِ مِسِرَ رَ؟</para>
  <para style="q" vid="JER 2:36">وٌ قَمَ نّ يَافِدٍ عٍ شْن مَ،</para>
  <para style="q" vid="JER 2:36">عَلْ وٌ يَافِشِ عَسِرِيَ شْن مَ كِ نَشّ.<verse eid="JER 2:36"/></para>
  <para style="q">
    <verse number="37" style="v" sid="JER 2:37"/>وٌ مِنِمَ نّ عٍ شْنيِ وٌ بّلّشّ عِفٍلِ رَ،</para>
  <para style="q" vid="JER 2:37">بَرِ مَ وٌ تَشُشِ نَشٍيٍ رَ، عَلَتَلَ بَرَ نٍيٍ رَبّحِن.</para>
  <para style="q" vid="JER 2:37">وٌ مُ شُننَكٍلِ يٌ سْتْمَ عٍ سَابُي رَ.»<verse eid="JER 2:37"/></para>
  <chapter eid="JER 2"/>
  <chapter number="3" style="c" sid="JER 3"/>
  <para style="s">عِسِرَيِلَ شَ دَنشَنِيَتَرٍحَ</para>
  <para style="q">
    <verse number="1" style="v" sid="JER 3:1"/>«شَ شّمّ مّي عَ شَ فِنّ رَ،</para>
  <para style="q" vid="JER 3:1">نَ فِنّ نَشَ سَ دْشْ شّمّ فبّتّ شْن،</para>
  <para style="q" vid="JER 3:1">عَ شَ شّمّ سِنفٍ مَن نْمَ فبِلٍندٍ عَ مَ سْنْن؟</para>
  <para style="q" vid="JER 3:1">يِ بْشِ بَرَ لُ سّنِيّنتَرٍحَ كُي.</para>
  <para style="q" vid="JER 3:1">وٌ تَن نَشٍيٍ بَرَ لَنفٌيحَ رَبَ وٌ شَنُنتٍنيِ كُيٍيٍ رَ،</para>
  <para style="q" vid="JER 3:1">يَكْسِ وٌ مَن قَ وَ مَ فبِلٍنقٍ ﭑ مَ نّ؟»</para>
  <para style="q" vid="JER 3:1">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="JER 3:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="JER 3:2"/>«وٌ وٌ يَ رَتٍ، وٌ شَ عَ مَتٌ،</para>
  <para style="q" vid="JER 3:2">شَ يِرٍ ندٍ نَ وٌ مُ لَنفٌيحَ رَبَشِ دّننَشّ.</para>
  <para style="q" vid="JER 3:2">وٌ نُ نَ وٌ شَنُنتٍنيِ عَلَيٍ مّمّقٍ كِرَ شْن مَ،</para>
  <para style="q" vid="JER 3:2">عَلْ مُحّتِيٍ نَشٍيٍ عٍ نْشُنمَ كِرَ دّ عٍ شَ دُتُن مِشِيٍ مَ.</para>
  <para style="q" vid="JER 3:2">وٌ بَرَ يِ بْشِ نْشْ وٌ حّرّ كِ سّنِيّنتَرٍ رَ.<verse eid="JER 3:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JER 3:3"/>نَ نَن عَ رَ ﭑ مُ تُنّ رَقَشِ،</para>
  <para style="q" vid="JER 3:3">ﭑ مُ حّمّ تُنّ رَفٌرٌ وٌ بّ.</para>
  <para style="q" vid="JER 3:3">كْنْ وٌ يَ شْرْشْ عَلْ لَنفٌي فِنّ،</para>
  <para style="q" vid="JER 3:3">وٌ مُ يَافِشِ قٍقٍ مَ.<verse eid="JER 3:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JER 3:4"/>هَن يَ وٌ عَ قَلَمَ ﭑ بّ،</para>
  <para style="q" vid="JER 3:4">‹مُشُ بَبَ، نَشَن مّينِشِ مُشُ مَ مُشُ قٌنِكٍ تّمُي،<verse eid="JER 3:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JER 3:5"/>هَن تٌ عِ شْنْشِ مُشُ مَ؟</para>
  <para style="q" vid="JER 3:5">عِ مُ دِحّمَ سْنْن؟›</para>
  <para style="q" vid="JER 3:5">عِيٌ، وٌ نَ نَن قَلَشِ،</para>
  <para style="q" vid="JER 3:5">كْنْ وٌ مُ وٌ بَشِ نَ كِرَ حَاشِ شْن قٍقٍ مَ.»<verse eid="JER 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 3:6"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ مَنفّ يٌسِيَ شَ وَشَتِ، «عِ بَرَ عِسِرَيِلَ شَ يَنقَنتٍيَ تٌ؟ عَ بَرَ يّنّ رَبَ فٍيَ بِرِن قَرِ، عَ نُن وُرِ بِلِ تٌقَنيِ بِرِن بُن مَ. <verse eid="JER 3:6"/><verse number="7" style="v" sid="JER 3:7"/>ﭑ بَرَ عَ مَحْشُن، نَ دَنفِ شَنبِ عَ مَن قَمَ نّ فبِلٍندٍ ﭑ مَ، كْنْ عَ مُ قَ. عَ مَافِنّ تِنشِنتَرٍ يُدَيَ قَن عَ تٌشِ. <verse eid="JER 3:7"/><verse number="8" style="v" sid="JER 3:8"/>ﭑ تٌ مّي عِسِرَيِلَ رَ، ﭑ تٌ قَتَن كّيدِ سٌ عَ يِ رَ عَ شَ يّنّ شَ قٍ رَ، عَ مَافِنّ يُدَيَ تِنشِنتَرٍ مُ فَاشُ ﭑ يَ رَ قٍوٌ. عَ قَن بَرَ سِفَ يّنّ رَبَدٍ. <verse eid="JER 3:8"/><verse number="9" style="v" sid="JER 3:9"/>عِسِرَيِلَ شَ كُيٍ بَتُقٍ، فّمّ نُن وُرِ دَاشِ، نَ بَرَ بْشِ قِندِ يِرٍ سّنِيّنتَرٍ رَ. <verse eid="JER 3:9"/><verse number="10" style="v" sid="JER 3:10"/>نَ بِرِن كُي يُدَيَ تِنشِنتَرٍ، عِسِرَيِلَ مَافِنّ، عَ مُ حَنِفٍ تٌنفٌشِ عَ بْحّ كُي عَ شَ عَ يّتّ رَفبِلٍن ﭑ مَ. عَ نَ قَلَ عَ دّ فبَنسَن نَن نَ.» عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="JER 3:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="JER 3:11"/>نَ تّمُي عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ،</para>
  <para style="q" vid="JER 3:11">«عِسِرَيِلَ تِنشِنتَرٍ قِسَ يُدَيَ سّنِيّنتَرٍ بّ.<verse eid="JER 3:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JER 3:12"/>عِ شَ سَ مَسٍنيِ تِ كْولَ بِرِ رَ،</para>
  <para style="q" vid="JER 3:12">‹عِسِرَيِلَ سّنِيّنتَرٍ، عِ يّتّ رَفبِلٍن ﭑ مَ.</para>
  <para style="q" vid="JER 3:12">ﭑ مُ شْنْشِ وٌ مَ سْنْن.</para>
  <para style="q" vid="JER 3:12">هِننّنتٍ نَن ﭑ نَ،</para>
  <para style="q" vid="JER 3:12">ﭑ بْحّ مُ لُمَ شْنْ رَ تّمُي بِرِن.›»</para>
  <para style="q" vid="JER 3:12">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="JER 3:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="JER 3:13"/>«وٌ شَ وٌ تِ وٌ شَ وَلِ كٌبِ رَ.</para>
  <para style="q" vid="JER 3:13">وٌ بَرَ وٌ مَرِفِ عَلَتَلَ مَتَندِ،</para>
  <para style="q" vid="JER 3:13">وٌ بَرَ بِرَ عَلَ فبّتّيٍ قْشْ رَ وُرِ بِلِيٍ بُن مَ.</para>
  <para style="q" vid="JER 3:13">وٌ مُ تِن وٌ تُلِ مَتِدٍ ﭑ شُي رَ.»</para>
  <para style="q" vid="JER 3:13">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="JER 3:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="JER 3:14"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ،</para>
  <para style="q" vid="JER 3:14">«وٌ تَن كَلَبَنتٍيٍ، وٌ فبِلٍن ﭑ مَ.</para>
  <para style="q" vid="JER 3:14">ﭑ تَن نَن نَ وٌ مَرِفِ رَ.</para>
  <para style="q" vid="JER 3:14">ﭑ قَمَ نّ وٌ مَيٍفٍتِدٍ تَا نُن شَبِلّ كُي،</para>
  <para style="q" vid="JER 3:14">ﭑ قَ وٌ رَفبِلٍن سِيٌن.<verse eid="JER 3:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 3:15"/>ﭑ يَرٍرَتِيٍ تِمَ نّ وٌ بّ، نَشٍيٍ رَقَن ﭑ مَ.</para>
  <para style="q" vid="JER 3:15">عٍ لْننِ نُن شَشِلِ قَنيِ مَسٍنمَ نّ وٌ بّ.»<verse eid="JER 3:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="JER 3:16"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ.</para>
  <para style="q" vid="JER 3:16">«وٌ نَ وُيَ وٌ شَ بْشِ كُي،</para>
  <para style="q" vid="JER 3:16">وٌ قَمَ نّ نّيمُدٍ عَلَتَلَ شَ سَاتّ كَنكِرَ مَ.</para>
  <para style="q" vid="JER 3:16">وٌ مُ عَ شَ قٍ قَلَمَ،</para>
  <para style="q" vid="JER 3:16">وٌ شَ مَحْشُنيِ مُ سِفَمَ عَ مَ.</para>
  <para style="q" vid="JER 3:16">وٌ مُ عَ كٌلٌنمَ عَ بَرَ لْي،</para>
  <para style="q" vid="JER 3:16">وٌ مُ فبّتّ قٍنمَ.<verse eid="JER 3:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 3:17"/>كْنْ نَ تّمُي دَرِ سَلَمُ شِلِ قَمَ نّ قَلَدٍ</para>
  <para style="q" vid="JER 3:17">‹عَلَتَلَ شَ كِبَنيِ.›</para>
  <para style="q" vid="JER 3:17">سِ بِرِن سِفَمَ نَا عَلَتَلَ شِلِ رَ.</para>
  <para style="q" vid="JER 3:17">عٍ فبِلٍنمَ نّ عٍ شَ مَحْشُنيِ حَاشِ قْشْ رَ.<verse eid="JER 3:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JER 3:18"/>نَ وَشَتِ يُدَيَكَيٍ قَمَ نّ كَقُدٍ عِسِرَيِلَكَيٍ مَ.</para>
  <para style="q" vid="JER 3:18">عٍ بِرِن كٍلِمَ بْشِ نَن مَ نَشَن نَ كْولَ مَ،</para>
  <para style="q" vid="JER 3:18">عٍ قَ فبِلٍن بْشِ مَ ﭑ دّننَشّ قِشِ وٌ بَبَيٍ مَ كّ رَ.<verse eid="JER 3:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JER 3:19"/>ﭑ تَن نُ بَرَ عَ قَلَ،</para>
  <para style="q" vid="JER 3:19">‹ﭑ وَ مَ نّ وٌ شَ لُ عَلْ ﭑ مَ دِيٍ،</para>
  <para style="q" vid="JER 3:19">ﭑ شَ بْشِ قِ وٌ مَ كّ رَ،</para>
  <para style="q" vid="JER 3:19">نَشَن تٌقَن بْشِ بِرِن بّ.›</para>
  <para style="q" vid="JER 3:19">ﭑ بَرَ عَ مَحْشُن عَ وٌ ﭑ شِلِ قَلَمَ نّ ‹ﭑ بَبَ.›</para>
  <para style="q" vid="JER 3:19">ﭑ بَرَ عَ مَحْشُن وٌ مُ فبِلٍنمَ ﭑ قْشْ رَ.<verse eid="JER 3:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 3:20"/>كْنْ وٌ تَن عِسِرَيِلَ، وٌ بَرَ ﭑ يَنقَ</para>
  <para style="q" vid="JER 3:20">عَلْ فِنّ نَشَن عَ شَ مْرِ يَنقَ عَ يّنّ رَبَ.»</para>
  <para style="q" vid="JER 3:20">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="JER 3:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="JER 3:21"/>عِسِرَيِلَكَيٍ عٍ شُي عِتٍمَ فٍيَ قَرِ،</para>
  <para style="q" vid="JER 3:21">عٍ وَ مَ، عٍ عَلَ مَشَندِ مَ،</para>
  <para style="q" vid="JER 3:21">بَرِ مَ عٍ بَرَ كِرَ حَاشِ سُشُ،</para>
  <para style="q" vid="JER 3:21">عٍ بَرَ نّيمُ عٍ مَرِفِ عَلَتَلَ مَ.<verse eid="JER 3:21"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="22" style="v" sid="JER 3:22"/>عَلَتَلَ نَشّ، «وٌ تَن مَتَندِلَيٍ، وٌ فبِلٍن،</para>
  <para style="q" vid="JER 3:22">ﭑ نْمَ وٌ رَكِسِدٍ وٌ شَ يَنقَنتٍيَ مَ.»</para>
  <para style="q" vid="JER 3:22">عِسِرَيِلَكَيٍ نَشَ عَ يَابِ،</para>
  <para style="q" vid="JER 3:22">«عَوَ، مُشُ فبِلٍنمَ نّ عِ مَ،</para>
  <para style="q" vid="JER 3:22">بَرِ مَ عِ تَن نَن نَ مُشُ مَرِفِ عَلَتَلَ رَ.<verse eid="JER 3:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JER 3:23"/>عِيٌ، شُي نَشَن كٍلِمَ فٍيَ قَرِ، وُلٍ نَ عَ رَ.</para>
  <para style="q" vid="JER 3:23">عِيٌ، مُشُ مَرِفِ عَلَتَلَ نَن نَ عِسِرَيِلَ رَكِسِمَ رَ.<verse eid="JER 3:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JER 3:24"/>كَبِ مُشُ دِ مّدِ تّمُي،</para>
  <para style="q" vid="JER 3:24">كُيٍ رَتْنشِيٍ بَرَ مُشُ بَبَيٍ شَ هَرِفٍ شُن نَكَنَ،</para>
  <para style="q" vid="JER 3:24">عٍ شَ شُرُ سٍيٍ نُن عٍ شَ دِيٍ.<verse eid="JER 3:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JER 3:25"/>نَ يَافِ بَرَ مُشُ سْتْ،</para>
  <para style="q" vid="JER 3:25">بِنيّ بِرِن بَرَ بَ مُشُ مَ،</para>
  <para style="q" vid="JER 3:25">بَرِ مَ مُشُ بَرَ يُنُبِ رَبَ وٌن مَرِفِ عَلَتَلَ رَ،</para>
  <para style="q" vid="JER 3:25">مُشُ تَن نُن وٌن بَبَيٍ،</para>
  <para style="q" vid="JER 3:25">كَبِ مُشُ دِ مّدِ تّمُي هَن تٌ.</para>
  <para style="q" vid="JER 3:25">مُشُ مُ مُشُ تُلِ مَتِشِ مُشُ مَرِفِ عَلَتَلَ شُي رَ.»<verse eid="JER 3:25"/></para>
  <chapter eid="JER 3"/>
  <chapter number="4" style="c" sid="JER 4"/>
  <para style="s">يُدَيَ شَ فبَلٌي</para>
  <para style="q">
    <verse number="1" style="v" sid="JER 4:1"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ،</para>
  <para style="q" vid="JER 4:1">«عِسِرَيِلَ، شَ وٌ وٌ يّتّ رَفبِلٍن ﭑ مَ،</para>
  <para style="q" vid="JER 4:1">شَ وٌ قٍ رَتْنشِ بَ ﭑ يَ تٌدٍ رَ،</para>
  <para style="q" vid="JER 4:1">شَ وٌ مُ لِنتَن وٌ شَ كّوَلِ رَ،<verse eid="JER 4:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JER 4:2"/>شَ وٌ وٌ كَلِ عَلَتَلَ شِلِ رَ تِنشِنيِ نُن نْندِ رَ،</para>
  <para style="q" vid="JER 4:2">سِيٍ قَمَ نّ بَرَكَ نُن بِنيّ سْتْدٍ عَلَتَلَ سَابُي رَ.»<verse eid="JER 4:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="JER 4:3"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ شّمّيٍ بّ</para>
  <para style="q" vid="JER 4:3">نَشٍيٍ نَ يُدَيَ نُن دَرِ سَلَمُ؛</para>
  <para style="q" vid="JER 4:3">«وٌ شَ شّ نّينّ مَسّفّ،</para>
  <para style="q" vid="JER 4:3">وٌ نَشَ سَنسِ شْرِ سِ كُنسِ تُنبٍ شْورَ.<verse eid="JER 4:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JER 4:4"/>شّمّ نَشٍيٍ نَ يُدَيَ نُن دَرِ سَلَمُ،</para>
  <para style="q" vid="JER 4:4">وٌ شَ وٌ بْحّ سّنِيّن عَلَتَلَ بّ.</para>
  <para style="q" vid="JER 4:4">وٌ شَ قٍ حَاشِ بَ وٌ سٌندٌنيِ كُي،</para>
  <para style="q" vid="JER 4:4">عَلْ قٍ حَاشِ بَمَ وٌ مَ كِ نَشّ وٌ سُننَ تّمُي.</para>
  <para style="q" vid="JER 4:4">وٌ شَ نَ رَبَ عَلَكٌ ﭑ بْحّ نَشَ تٍ وٌ مَ،</para>
  <para style="q" vid="JER 4:4">ﭑ مَ شْنّ قَ وٌ فَن عَلْ تّ</para>
  <para style="q" vid="JER 4:4">نَشَن مُ نْمَ شُبٍندٍ وٌ شَ قٍ كٌبِ رَبَشِيٍ شَ قٍ رَ.<verse eid="JER 4:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JER 4:5"/>وٌ شَ يِ مَسٍنيِ تِ يُدَيَكَيٍ بّ،</para>
  <para style="q" vid="JER 4:5">وٌ مَن شَ عَ قَلَ دَرِ سَلَمُكَيٍ بّ.</para>
  <para style="q" vid="JER 4:5">وٌ شَ قٍرِ قٍ عِسِرَيِلَ يِرٍ بِرِن،</para>
  <para style="q" vid="JER 4:5">وٌ شَ عَ قَلَ وٌ شُي عِتٍشِ رَ،</para>
  <para style="q" vid="JER 4:5">‹وٌ شَ سٌ تَا مَكَنتَشِيٍ كُي.›<verse eid="JER 4:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JER 4:6"/>وٌ شَ عَ مَتْنشُمَ سِيٌنكَيٍ بّ عٍ شَ عٍ فِ،</para>
  <para style="q" vid="JER 4:6">عٍ نَشَ تِ كِرَ شْن مَ،</para>
  <para style="q" vid="JER 4:6">بَرِ مَ ﭑ نَ قَقٍ تْورّ نُن حَشَنكَتّ رَ كٍلِقٍ كْولَ مَ.<verse eid="JER 4:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JER 4:7"/>سِيٍ كَنَمَ بَرَ كِرَ سُشُ،</para>
  <para style="q" vid="JER 4:7">عَلْ يّتّ نَشَن مِنِمَ سُبٍ قٍندٍ.</para>
  <para style="q" vid="JER 4:7">عَ بَرَ كٍلِ عَ شْنيِ عَلَكٌ عَ شَ وٌ شَ بْشِ كَنَ.</para>
  <para style="q" vid="JER 4:7">وٌ شَ تَايٍ بِرِن قَمَ نّ كَنَدٍ،</para>
  <para style="q" vid="JER 4:7">مِشِ يٌ مُ لُمَ نَا.<verse eid="JER 4:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 4:8"/>نَ نَن عَ رَ وٌ لَنمَ وٌ شَ سُننُن دٌنمَ رَفٌرٌ وٌ مَ،</para>
  <para style="q" vid="JER 4:8">وٌ شَ سُننُن، وٌ شَ حْنقٍ رَبَ،</para>
  <para style="q" vid="JER 4:8">بَرِ مَ عَلَتَلَ شَ شْنّ مُ فبِلٍنمَ وٌ قْشْ رَ.»<verse eid="JER 4:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="JER 4:9"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 4:9">«نَ لْشْي لِمَنِيَ بَمَ نّ مَنفّ نُن كُنتِفِيٍ يِ رَ.</para>
  <para style="q" vid="JER 4:9">سّرّشّدُبّيٍ نُن نَمِحْنمّيٍ دّيٍ عِشَرَ مَ نّ.»<verse eid="JER 4:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JER 4:10"/>ﭑ بَرَ عَلَ يَابِ،</para>
  <para style="q" vid="JER 4:10">«ﭑ مَرِفِ عَلَتَلَ،</para>
  <para style="q" vid="JER 4:10">مُنقٍ رَ عِ بَرَ عَ قَلَ عِ شَ حَمَ نُن دَرِ سَلَمُ بّ،</para>
  <para style="q" vid="JER 4:10">‹وٌ قَمَ بْحّسَ سْتْدٍ،›</para>
  <para style="q" vid="JER 4:10">كْنْ سَنتِدّفّمَ بَرَ فّ عٍ قَشَدٍ؟»<verse eid="JER 4:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JER 4:11"/>نَ تّمُي عَ قَمَ نّ عَ قَلَدٍ حَمَ نُن دَرِ سَلَمُ بّ،</para>
  <para style="q" vid="JER 4:11">«قٌيٍ بَرَ كٍلِ فبٍنفبٍرٍن يِرٍ.</para>
  <para style="q" vid="JER 4:11">عَ مُ قَمَ قٍ قَنيِ رَ،</para>
  <para style="q" vid="JER 4:11">عَ قَمَ ﭑ مَ حَمَ نَن تْورْدٍ.<verse eid="JER 4:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JER 4:12"/>عَ قِندِشِ قٌيٍ مَفَاشُشِ نَن نَ،</para>
  <para style="q" vid="JER 4:12">نَشَن كٍلِشِ ﭑ يِرٍ.</para>
  <para style="q" vid="JER 4:12">يَكْسِ ﭑ عٍ حَشَنكَتَمَ نّ.»<verse eid="JER 4:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="JER 4:13"/>يَشُييٍ نَ قَقٍ عَلْ قٌيٍ بٍلٍبٍلٍ نَشَن كٍلِقٍ كٌورٍ مَ.</para>
  <para style="q" vid="JER 4:13">عٍ شَ سْورِ رَفِسٍيٍ لُمَ نّ عَلْ تُرُننَادّ.</para>
  <para style="q" vid="JER 4:13">عٍ شَ سٌي شُلُن عَلْ سّفّيٍ.</para>
  <para style="q" vid="JER 4:13">فبَلٌي بَرَ وٌن لِ، وٌن بَرَ هَلَكِ.<verse eid="JER 4:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JER 4:14"/>دَرِ سَلَمُ، وٌ وٌ بْحّ رَ سّنِيّن، عَلَكٌ وٌ شَ كِسِ.</para>
  <para style="q" vid="JER 4:14">كّوَلِ كٌبِ لُمَ وٌ بْحّ مَ هَن تّمُي مُندُن؟<verse eid="JER 4:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 4:15"/>دَنَكَيٍ بَرَ نَ فبَلٌي مَسٍنيِ تِ،</para>
  <para style="q" vid="JER 4:15">عٍقِرَ مِكَيٍ قَن بَرَ نَ قَلَ.<verse eid="JER 4:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 4:16"/>وٌ شَ سِيٍ رَ سِ، وٌ شَ دَرِ سَلَمُ قَن نَسِ،</para>
  <para style="q" vid="JER 4:16">يَشُييٍ نَ كٍلِقٍ يِرٍ مَكُيٍ نّ، عٍ نَ قَقٍ يُدَيَ تَايٍ كُي.<verse eid="JER 4:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="JER 4:17"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 4:17">«عٍ بَرَ دَرِ سَلَمُ رَبِلِن</para>
  <para style="q" vid="JER 4:17">عَلْ شّ كَنتَمَيٍ شّ رَبِلِنمَ كِ نَشّ.</para>
  <para style="q" vid="JER 4:17">نَ قَمَ نّ دَرِ سَلَمُ لِدٍ بَرِ مَ عٍ بَرَ ﭑ مَتَندِ.<verse eid="JER 4:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JER 4:18"/>نَ قِندِشِ وٌ شَ وَلِ كٌبِ سَرٍ نَن نَ.</para>
  <para style="q" vid="JER 4:18">وٌ نَشَن نَبَشِ، نَ بَرَ فبِلٍن وٌ مَ عَ حَاشِ رَ،</para>
  <para style="q" vid="JER 4:18">هَن عَ وٌ سٌندٌنيِ سْشْ.»<verse eid="JER 4:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="JER 4:19"/>ﭑ بْحّ قَن نَ تْورْقٍ.</para>
  <para style="q" vid="JER 4:19">ﭑ بَرَ سُننُن.</para>
  <para style="q" vid="JER 4:19">ﭑ مُ نْمَ مَدُندُدٍ،</para>
  <para style="q" vid="JER 4:19">بَرِ مَ ﭑ بَرَ سَرَيٍ نُن فٍرٍ شُي مّ قَ رَ.<verse eid="JER 4:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 4:20"/>عٍ عَ قَلَمَ فبَلٌي نَ قَقٍ،</para>
  <para style="q" vid="JER 4:20">بْشِ بِرِن بَرَ كَنَ.</para>
  <para style="q" vid="JER 4:20">ﭑ مَ كِرِ بَنشِيٍ بَرَ بِرَ كٍرٍن نَ،</para>
  <para style="q" vid="JER 4:20">لِنفِرَ يٌ مُ نَ ﭑ يِ رَ.<verse eid="JER 4:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JER 4:21"/>فٍرٍ تْنشُمَ عَ عِتِمَ هَن مُن تّمُي؟</para>
  <para style="q" vid="JER 4:21">فٍرٍ شُي مِنِمَ هَن مُن لْشْي؟<verse eid="JER 4:21"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="22" style="v" sid="JER 4:22"/>عَلَتَلَ نَشّ، «ﭑ مَ حَمَ شَشِلِ مُ نَ،</para>
  <para style="q" vid="JER 4:22">عٍ مُ ﭑ كٌلٌن،</para>
  <para style="q" vid="JER 4:22">عٍ لُشِ نّ عَلْ دِ لْننِتَرٍيٍ.</para>
  <para style="q" vid="JER 4:22">عٍ قٍ حَاشِ نَن فبَنسَن كٌلٌن،</para>
  <para style="q" vid="JER 4:22">كْنْ عٍ مُ قَتَ قٍ قَنيِ رَبَدٍ.»<verse eid="JER 4:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="JER 4:23"/>ﭑ بَرَ لَامَتُنيِ تٌ يِ بْشِ شَ قٍ رَ.</para>
  <para style="q" vid="JER 4:23">سٍسٍ مُ لُمَ يِ بْشِ مَ،</para>
  <para style="q" vid="JER 4:23">هَلِ كٌورٍ مُ يَنبَمَ عَ مَ.<verse eid="JER 4:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JER 4:24"/>ﭑ بَرَ لَامَتُنيِ تٌ فٍيَيٍ شَ قٍ رَ.</para>
  <para style="q" vid="JER 4:24">فٍيَيٍ قَمَ نّ سّرّندٍ، تٍنتٍنيِيٍ رَ مَشَ.<verse eid="JER 4:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JER 4:25"/>ﭑ بَرَ لَامَتُنيِ تٌ نِمَسٍ شَ قٍ رَ.</para>
  <para style="q" vid="JER 4:25">مِشِ مُ لُمَ يِ بْشِ مَ سْنْن،</para>
  <para style="q" vid="JER 4:25">شْنِيٍ قَن بَرَ عٍ فِ.<verse eid="JER 4:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JER 4:26"/>ﭑ بَرَ لَامَتُنيِ تٌ يِ يِرٍ شَ قٍ رَ.</para>
  <para style="q" vid="JER 4:26">كَرٍ مٍلٍ فٍيَ قِندِ مَ نّ فبٍنفبٍرٍنيِ رَ،</para>
  <para style="q" vid="JER 4:26">تَا بِرِن قَمَ فَندٍ عَلَتَلَ نُن عَ شَ شْنّ شَ قٍ نَن نَ.<verse eid="JER 4:26"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="27" style="v" sid="JER 4:27"/>عَلَتَلَ بَرَ عَ مَسٍن،</para>
  <para style="q" vid="JER 4:27">«يِ بْشِ بِرِن حَشَنكَتَمَ نّ،</para>
  <para style="q" vid="JER 4:27">كْنْ ﭑ مُ عَ بِرِن شُن نَكَنَمَ.<verse eid="JER 4:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="JER 4:28"/>نَ نَن عَ رَ يِ بْشِ نَ سُننُنيِ كُي، كٌورٍ بَرَ عِقْورْ.</para>
  <para style="q" vid="JER 4:28">ﭑ تَن نَن عَ رَفِرِشِ،</para>
  <para style="q" vid="JER 4:28">ﭑ مُ فبِلٍنمَ ﭑ مَ نَتّ قْشْ رَ.<verse eid="JER 4:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="JER 4:29"/>فٍرٍ سٌي نَ قَ سٌي قَرِ، مِشِ بِرِن عٍ فِمَ نّ.</para>
  <para style="q" vid="JER 4:29">فٍرٍ سٌي نَ قَ تَنبّيٍ رَ، مِشِ يٌ مُ لُمَ تَا كُي.</para>
  <para style="q" vid="JER 4:29">ندٍيٍ عٍ فِمَ نّ وٌندِ يِرٍ، ندٍيٍ عٍ فِ فٍيَيٍ قَرِ.</para>
  <para style="q" vid="JER 4:29">مِشِ بِرِن كٍلِمَ نّ تَا كُي.<verse eid="JER 4:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="JER 4:30"/>عِ تَن نَشَن شُن نَكَنَشِ، عِ نَ مُنسٍ رَبَقٍ؟</para>
  <para style="q" vid="JER 4:30">عِ وَ مَ عِ مَشِرِقٍ دُفِ قَنيِ رَ،</para>
  <para style="q" vid="JER 4:30">عِ وَ مَ كْنمَفٌرٍ شّيمَ دَاشِ رَفٌرٌقٍ عِ مَ،</para>
  <para style="q" vid="JER 4:30">عِ وَ مَ تٌقَن سٍ سَقٍ عِ يَ كِرِ مَ؟</para>
  <para style="q" vid="JER 4:30">عِ نَ نَ بِرِن نَبَقٍ عِ شَنُنتٍنيِيٍ بّ قُقَقُ،</para>
  <para style="q" vid="JER 4:30">بَرِ مَ عِ مُ رَقَن عٍ مَ سْنْن.</para>
  <para style="q" vid="JER 4:30">عٍ وَ مَ عِ قَشَقٍ تُن.<verse eid="JER 4:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="JER 4:31"/>ﭑ بَرَ وَ شُي ندٍ مّ.</para>
  <para style="q" vid="JER 4:31">نَ وَ شُي لُشِ نّ عَلْ قُرِ فِنّ نَشَن نَ عَ شَ دِ سِنفٍ بَرِقٍ.</para>
  <para style="q" vid="JER 4:31">دَرِ سَلَمُ نَ سَيَ كِرَ شْن مَ، عَ نَ عَ قَلَقٍ،</para>
  <para style="q" vid="JER 4:31">‹عَ فبٍ مُ لُشِ سْنْن، قَشّتِيٍ شَ ﭑ نِي بَ.›»<verse eid="JER 4:31"/></para>
  <chapter eid="JER 4"/>
  <chapter number="5" style="c" sid="JER 5"/>
  <para style="s">عَلَ شَ فبٍحْشْي</para>
  <para style="sp">عَننَبِ يٍرٍ مِ شَ مَسٍنيِ دَرِ سَلَمُكَيٍ بّ</para>
  <para style="q">
    <verse number="1" style="v" sid="JER 5:1"/>«وٌ شَ يِرٍ بِرِن مَتٌ دَرِ سَلَمُ،</para>
  <para style="q" vid="JER 5:1">وٌ شَ مَشْرِنيِ تِ تَا كُي،</para>
  <para style="q" vid="JER 5:1">عَلَكٌ وٌ شَ تِنشِنتْي ندٍ تٌ،</para>
  <para style="q" vid="JER 5:1">نَشَن حّرّ مَ كِرَ قَنيِ شْن مَ،</para>
  <para style="q" vid="JER 5:1">نَشَن بِرَ مَ نْندِ قْشْ رَ.</para>
  <para style="q" vid="JER 5:1">شَ وٌ سَ نَ مِشِ مْولِ تٌ،</para>
  <para style="q" vid="JER 5:1">ﭑ دِحّمَ نّ دَرِ سَلَمُ مَ.<verse eid="JER 5:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JER 5:2"/>عٍ عٍ كَلِمَ نّ عَلَتَلَ شِلِ رَ،</para>
  <para style="q" vid="JER 5:2">كْنْ نَ بِرِن قِندِشِ وُلٍ نَن نَ.<verse eid="JER 5:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JER 5:3"/>عَلَتَلَ، ﭑ عَ كٌلٌن عِ وَ مَ تِنشِنيِ نَن شْن مَ.</para>
  <para style="q" vid="JER 5:3">عِ بَرَ عِسِرَيِلَكَيٍ حَشَنكَتَ،</para>
  <para style="q" vid="JER 5:3">كْنْ عٍ مُ قَهَامُي يٌ سْتْشِ نَ كُي.</para>
  <para style="q" vid="JER 5:3">عِ بَرَ عٍ تْورْ، كْنْ عٍ مُ لْننِ سْتْشِ نَ كُي.</para>
  <para style="q" vid="JER 5:3">عٍ بْحّ بَرَ شْرْشْ عَلْ فّمّ،</para>
  <para style="q" vid="JER 5:3">عٍ تٌندِ دَنشَنِيَدٍ.<verse eid="JER 5:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JER 5:4"/>ﭑ بَرَ عَ قَلَ، سٍتَرٍيٍ فبَنسَن نَن يِ حَمَ رَ.</para>
  <para style="q" vid="JER 5:4">نَ نَن عَ رَ عٍ مُ عَلَتَلَ شَ كِرَ كٌلٌن،</para>
  <para style="q" vid="JER 5:4">عٍ مُ عٍ مَرِفِ عَلَ شَ سّرِيّ قَهَامُمَ.<verse eid="JER 5:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JER 5:5"/>عَ لَنمَ ﭑ شَ يِ مَسٍنيِ تِ كُنتِفِيٍ نَن بّ،</para>
  <para style="q" vid="JER 5:5">بَرِ مَ عٍ تَن عَلَتَلَ شَ كِرَ كٌلٌن،</para>
  <para style="q" vid="JER 5:5">عٍ عٍ مَرِفِ عَلَ شَ سّرِيّ قَهَامُمَ.</para>
  <para style="q" vid="JER 5:5">كْنْ عٍ بِرِن لَن، عٍ سٍسٍ مُ تِن بِرَدٍ عَلَ قْشْ رَ.</para>
  <para style="q" vid="JER 5:5">عٍ بِرِن بَرَ عَ مَتَندِ.<verse eid="JER 5:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JER 5:6"/>نَ نَن عَ رَ بُرُنيِ يّتّ عٍ قَشَمَ،</para>
  <para style="q" vid="JER 5:6">وُلَءِ بَرٍ عٍ عِبْو.</para>
  <para style="q" vid="JER 5:6">بَرَتّ عٍ مّلّنمَ عٍ شَ تَا سٌدٍ دّيٍ رَ، عَ شَ عٍ قَشَ،</para>
  <para style="q" vid="JER 5:6">بَرِ مَ عٍ شَ كّوَلِ كٌبِ بَرَ فبٌ، هَن عَ بَرَ دَنفِ عَ عِ.»<verse eid="JER 5:6"/></para>
  <para style="sp">عَلَتَلَ شَ مَسٍنيِ دَرِ سَلَمُكَيٍ بّ</para>
  <para style="q">
    <verse number="7" style="v" sid="JER 5:7"/>«دَرِ سَلَمُ، عَ لَنمَ ﭑ شَ دِحّ عِ مَ؟</para>
  <para style="q" vid="JER 5:7">عِ شَ دِيٍ بَرَ ﭑ نَبٌلٌ،</para>
  <para style="q" vid="JER 5:7">عٍ عٍ كَلِمَ كُيٍ نَن شِلِ رَ.</para>
  <para style="q" vid="JER 5:7">ﭑ نُ بَرَ عٍ بَلٌ،</para>
  <para style="q" vid="JER 5:7">كْنْ عٍ بَرَ ﭑ يَنقَ، عٍ بِرَ لَنفٌييٍ قْشْ رَ.<verse eid="JER 5:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 5:8"/>عٍ مَنِيَشِ سٌي شّمّمَيٍ نَن نَ،</para>
  <para style="q" vid="JER 5:8">كَنكَن قَ بِرَ عَ دْشْبٌورٍ شَ فِنّ قْشْ رَ.<verse eid="JER 5:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JER 5:9"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 5:9">عَ مُ لَنمَ ﭑ شَ يِ مِشِ مْولِ حَشَنكَتَ؟</para>
  <para style="q" vid="JER 5:9">عَ مُ لَنمَ ﭑ شَ ﭑ فبٍحْشْ يِ سِ مْولِ مَ؟<verse eid="JER 5:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JER 5:10"/>وٌ تٍ عٍ شَ تّتّيٍ قَرِ، وٌ شَ عٍ رَبِرَ،</para>
  <para style="q" vid="JER 5:10">كْنْ وٌ نَشَ حَمَ بِرِن شُن نَكَنَ.</para>
  <para style="q" vid="JER 5:10">وٌ شَ عٍ تْورْ،</para>
  <para style="q" vid="JER 5:10">بَرِ مَ عٍ مُ تِنشِ بِرَدٍ عَلَتَلَ قْشْ رَ.<verse eid="JER 5:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JER 5:11"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 5:11">عِسِرَيِلَ نُن يُدَيَ بِرِن بَرَ ﭑ يَنقَ.<verse eid="JER 5:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JER 5:12"/>عٍ بَرَ عَلَتَلَ رَبٌلٌ،</para>
  <para style="q" vid="JER 5:12">عٍ قَ عَ قَلَ، ‹عَلَ مُ نَ.</para>
  <para style="q" vid="JER 5:12">وٌن مُ قَمَ فبَلٌي سْتْدٍ سَنتِدّفّمَ نُن كَامّ رَ.›<verse eid="JER 5:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JER 5:13"/>عٍ شَ نَمِحْنمّ مُ ﭑ شُي شَ مَسٍنمَ.</para>
  <para style="q" vid="JER 5:13">عٍ قٍ حَاشِ نَشَن مَسٍنمَ،</para>
  <para style="q" vid="JER 5:13">نَ شَ فبِلٍن عٍ مَ.»<verse eid="JER 5:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="JER 5:14"/>نَ نَن عَ رَ مَنفّ عَلَتَلَ بَرَ عَ مَسٍن،</para>
  <para style="q" vid="JER 5:14">«وٌ تٌ نَ مْولِ قَلَ،</para>
  <para style="q" vid="JER 5:14">ﭑ بَرَ ﭑ مَ مَسٍنيِ لُ عِ دّ كُي.</para>
  <para style="q" vid="JER 5:14">ﭑ مَ مَسٍنيِ لُشِ نّ عَلْ تّ</para>
  <para style="q" vid="JER 5:14">نَشَن قَمَ يِ حَمَ فَندٍ عَلْ تّ يٍفٍ فَنمَ كِ نَشّ.»<verse eid="JER 5:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="JER 5:15"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 5:15">«ﭑ شَ عَ قَلَ وٌ بّ عِسِرَيِلَ،</para>
  <para style="q" vid="JER 5:15">ﭑ قَمَ نّ حَمَ ندٍ رَ وٌ شِلِ مَ.</para>
  <para style="q" vid="JER 5:15">حَمَ سّنبّمَ نَن عَ رَ نَشَن كٍلِمَ يِرٍ مَكُيٍ،</para>
  <para style="q" vid="JER 5:15">نَشَن بَرَ بُ دُنِحَ،</para>
  <para style="q" vid="JER 5:15">عِ مُ نَشَن شُي كٌلٌن،</para>
  <para style="q" vid="JER 5:15">عِ مُ نْمَ نَشَن قَهَامُدٍ.<verse eid="JER 5:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 5:16"/>عٍ شَ تَنبّ حَاشُ، عٍ مِشِ قَشَمَ نّ.</para>
  <para style="q" vid="JER 5:16">فٍرٍ سٌي فبَنفبَلَنشِ نَن عٍ رَ.<verse eid="JER 5:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 5:17"/>عٍ وٌ شَ بَلٌي دٌنمَ نّ،</para>
  <para style="q" vid="JER 5:17">عٍ وٌ شَ دِ بِرِن تٌنفٌمَ نّ،</para>
  <para style="q" vid="JER 5:17">عٍ وٌ شَ شُرُ سٍ بِرِن مُحَمَ نّ،</para>
  <para style="q" vid="JER 5:17">عٍ وٌ شَ سَنسِ سِشِ بِرِن كَنَمَ نّ،</para>
  <para style="q" vid="JER 5:17">عٍ وٌ شَ تَا مَكَنتَشِيٍ رَبِرَ مَ نّ عٍ شَ سَنتِدّفّمَ رَ،</para>
  <para style="q" vid="JER 5:17">وٌ نُ لَشِ تَا نَشٍيٍ رَ.»<verse eid="JER 5:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="JER 5:18"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 5:18">«كْنْ ﭑ مُ وٌ بِرِن سْنتْمَ.<verse eid="JER 5:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JER 5:19"/>شَ عَ سَ لِ وٌ عَ قَلَ،</para>
  <para style="q" vid="JER 5:19">‹مُنقٍ رَ مُشُ مَرِفِ عَلَ بَرَ يِ قٍ مْولِ رَبَ مُشُ رَ؟›</para>
  <para style="q" vid="JER 5:19">عَلَ وٌ يَابِمَ نّ،</para>
  <para style="q" vid="JER 5:19">‹وٌ تٌ ﭑ نَبٌلٌ عَلَكٌ وٌ شَ كُيٍيٍ بَتُ وٌ شْنيِ،</para>
  <para style="q" vid="JER 5:19">نَشٍيٍ كٍلِشِ حَمَنّ فبّتّ مَ،</para>
  <para style="q" vid="JER 5:19">وٌ تَن قِندِ مَ نَ حَمَنّ شَ كٌنيِيٍ نَن نَ عٍ تَن شْنيِ.›<verse eid="JER 5:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 5:20"/>وٌ شَ يِ مَسٍن يَشُبَ شَ دِيٍ بّ،</para>
  <para style="q" vid="JER 5:20">وٌ شَ عَ قَلَ يُدَيَكَيٍ بّ،<verse eid="JER 5:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JER 5:21"/>‹وٌ وٌ تُلِ مَتِ،</para>
  <para style="q" vid="JER 5:21">وٌ تَن حَمَ شَشِلِتَرٍ، حَمَ كِنِكِنِتَرٍ،</para>
  <para style="q" vid="JER 5:21">نَشَن يَ مُ سٍ تٌمَ،</para>
  <para style="q" vid="JER 5:21">نَشَن تُلِ مُ قٍ مّمَ.<verse eid="JER 5:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JER 5:22"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 5:22">وٌ مُ فَاشُمَ ﭑ يَ رَ؟</para>
  <para style="q" vid="JER 5:22">وٌ مُ سّرّنمَ ﭑ تٌقٍ رَ،</para>
  <para style="q" vid="JER 5:22">ﭑ تَن نَشَن بَا نَانِنيِ سَشِ مّيّنيِ رَ،</para>
  <para style="q" vid="JER 5:22">عَلَكٌ بَا نَشَ دَنفِ يِرٍ ندٍ؟</para>
  <para style="q" vid="JER 5:22">بَا مْرْنيِ كٍلِمَ نّ،</para>
  <para style="q" vid="JER 5:22">كْنْ عٍ مُ نْمَ دَنفِدٍ نَانِنيِ رَ نَشَن سَشِ.›<verse eid="JER 5:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JER 5:23"/>يِ حَمَ سٌندٌنيِ شْرْشْ.</para>
  <para style="q" vid="JER 5:23">عٍ بَرَ عَلَ مَتَندِ، عٍ بَرَ فبِلٍن عَ قْشْ رَ.<verse eid="JER 5:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JER 5:24"/>عٍ مُ عَ قَلَمَ عٍ بْحّ كُي،</para>
  <para style="q" vid="JER 5:24">‹وٌن شَ فَاشُ وٌن مَرِفِ عَلَتَلَ يَ رَ،</para>
  <para style="q" vid="JER 5:24">نَشَن تُنّ يٍ رَفٌرٌ مَ حّمّ تّمُي،</para>
  <para style="q" vid="JER 5:24">عَ قْلّ نُن عَ رَحْنيِ،</para>
  <para style="q" vid="JER 5:24">عَلَكٌ شّ شَ شَبَ عَ وَشَتِ.›<verse eid="JER 5:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JER 5:25"/>وٌ شَ كّوَلِ كٌبِ بَرَ نَ بِرِن كَنَ،</para>
  <para style="q" vid="JER 5:25">وٌ شَ يُنُبِيٍ بَرَ عَ نِيَ بَلٌي شَ بَ وٌ يِ رَ.<verse eid="JER 5:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JER 5:26"/>مِشِ حَاشِ ندٍيٍ مَسُنبُشِ ﭑ مَ حَمَ رَ،</para>
  <para style="q" vid="JER 5:26">نَشٍيٍ فَنتَنيِ عِتَلَمَ مِشِ بّ عَلْ شْنِ سُشُييٍ.<verse eid="JER 5:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="JER 5:27"/>عٍ عٍ شَ بَنشِ رَقٍمَ سٍ مُحَشِيٍ رَ،</para>
  <para style="q" vid="JER 5:27">عَلْ تْشْي كُلّ نَشَن نَقٍشِ تْشْييٍ رَ.</para>
  <para style="q" vid="JER 5:27">عٍ بَننَشِ نَ نَاقُلِ مْولِ نَن نَ.<verse eid="JER 5:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="JER 5:28"/>قٍ حَاشِيٍ بَرَ عٍ شُنفبٌ هَن عَ بَرَ دَنفِ عَ عِ.</para>
  <para style="q" vid="JER 5:28">عٍ مُ قٍ قَنيِ رَبَمَ كِرِدِيٍ بّ،</para>
  <para style="q" vid="JER 5:28">عٍ مُ تِنشِن سٍتَرٍيٍ مَبِرِ.</para>
  <para style="q" vid="JER 5:28">عٍ نَاقُلِ نَن تُن قٍنمَ.<verse eid="JER 5:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="JER 5:29"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 5:29">عَ مُ لَنمَ ﭑ شَ يِ مِشِ مْولِ حَشَنكَتَ؟</para>
  <para style="q" vid="JER 5:29">عَ مُ لَنمَ ﭑ شَ ﭑ فبٍحْشْ يِ سِ مْولِ مَ؟<verse eid="JER 5:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="JER 5:30"/>قٍ رَتْنشِ نَشٍيٍ مُ دَشَ،</para>
  <para style="q" vid="JER 5:30">نٍيٍ بَرَ سٌ يِ بْشِ كُي.<verse eid="JER 5:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="JER 5:31"/>نَمِحْنمّيٍ نَ وُلٍ قَلَقٍ،</para>
  <para style="q" vid="JER 5:31">سّرّشّدُبّيٍ نَ مُحّ تِقٍ،</para>
  <para style="q" vid="JER 5:31">نَ بِرِن بَرَ رَقَن ﭑ مَ حَمَ مَ.</para>
  <para style="q" vid="JER 5:31">وٌ مُنسٍ رَبَمَ وٌ شَ بْشِ مُنَقَنيِ شَ قٍ رَ؟»<verse eid="JER 5:31"/></para>
  <chapter eid="JER 5"/>
  <chapter number="6" style="c" sid="JER 6"/>
  <para style="s">دَرِ سَلَمُ شَ حَشَنكَتّ</para>
  <para style="q">
    <verse number="1" style="v" sid="JER 6:1"/>«بُنيَمِنكَيٍ، وٌ وٌ فِ، وٌ كٍلِ دَرِ سَلَمُ.</para>
  <para style="q" vid="JER 6:1">سَرَ قٍ تٍكٌوَ، فٍرٍ تْنشُمَ رَتٍ بٍتِ هَكٍرٍ مِ،</para>
  <para style="q" vid="JER 6:1">بَرِ مَ حَشَنكَتّ نَ قَقٍ كٍلِقٍ كْولَ مَ،</para>
  <para style="q" vid="JER 6:1">عَ فبٍ مُ لُشِ فبَلٌي شَ وٌ لِ.<verse eid="JER 6:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JER 6:2"/>سِيٌن، تَا تٌقَنيِ،</para>
  <para style="q" vid="JER 6:2">ﭑ وٌ شُن نَكَنَمَ نّ.<verse eid="JER 6:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JER 6:3"/>شُرُ سٍ دّ مَدٌنيِيٍ قَمَ نّ عٍ شَ كِرِ بَنشِيٍ تِدٍ يِرٍ،</para>
  <para style="q" vid="JER 6:3">وٌ شَ تَا نُ نَ دّننَشّ،</para>
  <para style="q" vid="JER 6:3">عٍ قَ عٍ شَ شُرُ سٍيٍ مَكَنتَ مّننِ.»<verse eid="JER 6:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="JER 6:4"/>«سِيٌن يَشُييٍ، وٌ كٍلِ، وٌ فٍرٍ سٌ نَ تَا شِلِ مَ.</para>
  <para style="q" vid="JER 6:4">وٌ شَ سِفَ يَنيِ رَ.</para>
  <para style="q" vid="JER 6:4">سٌفٍ نَ فٌرٌ، وٌ نَشَ كْنتْقِلِ،<verse eid="JER 6:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JER 6:5"/>وٌ مَن شَ سِفَ كْي رَ،</para>
  <para style="q" vid="JER 6:5">بَنشِ مَكَنتَشِيٍ كَنَدٍ.»<verse eid="JER 6:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="JER 6:6"/>مَنفّ عَلَتَلَ بَرَ عَ مَسٍن سِيٌن يَشُييٍ بّ،</para>
  <para style="q" vid="JER 6:6">«وٌ سَ وُرِ بِلِيٍ شَبَ،</para>
  <para style="q" vid="JER 6:6">وٌ تٍ سٍ يَءِلَن عَلَكٌ وٌ شَ سٌ دَرِ سَلَمُ تّتّ كُي.</para>
  <para style="q" vid="JER 6:6">تَا نَ عَ رَ نَشَن لَنشِ عَ شَ رَتْن،</para>
  <para style="q" vid="JER 6:6">بَرِ مَ عٍ لُمَ عٍ بٌورٍ تْورْ رَ تّمُي بِرِن.<verse eid="JER 6:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JER 6:7"/>قٍ حَاشِ مِنِمَ يِ تَا كُي تّمُي بِرِن،</para>
  <para style="q" vid="JER 6:7">عَلْ يٍ مِنِمَ كْلْنيِ كُي كِ نَشّ.</para>
  <para style="q" vid="JER 6:7">كٌبِحَ نُن قٍ حَاشِ فبَنسَن نَن نَ عٍ تَفِ.</para>
  <para style="q" vid="JER 6:7">نَ بِرِن لُشِ نّ عَلْ قُرٍ ﭑ نَشَن تٌمَ تّمُي بِرِن.»<verse eid="JER 6:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="JER 6:8"/>«دَرِ سَلَمُ، عِ شَ عِ تُلِ مَتِ ﭑ مَ مَرَ سِ رَ،</para>
  <para style="q" vid="JER 6:8">عَلَكٌ ﭑ نَشَ ﭑ مَكُيَ عِ رَ،</para>
  <para style="q" vid="JER 6:8">عِ قَ لُ عَلْ فبٍنفبٍرٍنيِ،</para>
  <para style="q" vid="JER 6:8">مِشِ مُ سَبَتِشِ دّننَشّ.»<verse eid="JER 6:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="JER 6:9"/>مَنفّ عَلَتَلَ بَرَ عَ مَسٍن،</para>
  <para style="q" vid="JER 6:9">«عِسِرَيِلَكَ نَشٍيٍ لُشِ،</para>
  <para style="q" vid="JER 6:9">عٍ بِرِن بَمَ نّ بْشِ مَ،</para>
  <para style="q" vid="JER 6:9">عَلْ سَنسِ بٌفِ فبِلٍنمَ بَ رَ كِ نَشّ.»<verse eid="JER 6:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="JER 6:10"/>«ندٍ ﭑ مَ مَسٍنيِ رَ مّمَ؟</para>
  <para style="q" vid="JER 6:10">ندٍ قِندِ مَ نَ سٍيدٍ رَ؟</para>
  <para style="q" vid="JER 6:10">وٌ تُلِ شْرْشْ، وٌ مُ قٍ مّمَ.</para>
  <para style="q" vid="JER 6:10">وٌ يٌمَ عَلَتَلَ شَ مَسٍنيِ مَ،</para>
  <para style="q" vid="JER 6:10">وٌ مُ وَ مَ عَ شَ مَرَ سِ شْن.<verse eid="JER 6:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JER 6:11"/>عَلَتَلَ شَ شْنّ فبٌ ﭑ بْحّ كُي،</para>
  <para style="q" vid="JER 6:11">ﭑ شَ نَ قَلَ وٌ بّ.»</para>
  <para style="b" vid="JER 6:11"/>
  <para style="q" vid="JER 6:11">«عَلَ شَ شْنّ عِسِرَيِلَكَيٍ بِرِن لِمَ نّ،</para>
  <para style="q" vid="JER 6:11">دِ مّدِ نَشٍيٍ بٍرٍ مَ كِرَ رَ،</para>
  <para style="q" vid="JER 6:11">قٌنِكٍ نَشٍيٍ مَلَنمَ،</para>
  <para style="q" vid="JER 6:11">شّمّ نُن فِنّ نَشٍيٍ مْشِ عَ قَنيِ رَ.<verse eid="JER 6:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JER 6:12"/>ﭑ نَن ﭑ بّلّشّ تِمَ عٍ مَ تّمُي نَشّ،</para>
  <para style="q" vid="JER 6:12">مِشِ فبّتّيٍ قَمَ نّ عٍ شَ بَنشِيٍ تٌنفٌدٍ،</para>
  <para style="q" vid="JER 6:12">عٍ شَ شّيٍ، عَ نُن عٍ شَ فِنّيٍ.»</para>
  <para style="q" vid="JER 6:12">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="JER 6:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="JER 6:13"/>«كٍلِقٍ دِ مّدِ مَ، دْشْقٍ شّمْشِ رَ،</para>
  <para style="q" vid="JER 6:13">عٍ بِرِن نَ عٍ يّتّ شَ فٍينِ نَن قٍنقٍ.</para>
  <para style="q" vid="JER 6:13">نَمِحْنمّ نُن سّرّشّدُبّ قَن نَ مِشِ مَدَشُقٍ.<verse eid="JER 6:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JER 6:14"/>عٍ مُ قٍ فبٍفبٍ رَبَمَ ﭑ مَ حَمَ مَلِقٍ رَ.</para>
  <para style="q" vid="JER 6:14">عٍ عَ قَلَمَ، ‹وٌ نَشَ كْنتْقِلِ، وٌ بْحّ شَ سَ.›</para>
  <para style="q" vid="JER 6:14">كْنْ بْحّسَ يٌ مُ نَ.<verse eid="JER 6:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 6:15"/>عَ لَنمَ عٍ شَ يَافِ عٍ شَ قٍ كٌبِيٍ رَ،</para>
  <para style="q" vid="JER 6:15">كْنْ عٍ مُ يَافِمَ.</para>
  <para style="q" vid="JER 6:15">يَافِتَرٍ نَن لَنشِ عٍ مَ.</para>
  <para style="q" vid="JER 6:15">نَ نَن عَ رَ، ﭑ قَمَ عٍ رَبِرَدٍ كِيتِ وَشَتِ.»</para>
  <para style="q" vid="JER 6:15">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="JER 6:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="JER 6:16"/>عَلَتَلَ بَرَ عَ مَسٍن،</para>
  <para style="q" vid="JER 6:16">«وٌ شَ كِرَ قَنيِ قٍن،</para>
  <para style="q" vid="JER 6:16">وٌ شَ عَ كٌلٌن كِرَ قٌرِيٍ نُ نَ كِ نَشّ.</para>
  <para style="q" vid="JER 6:16">كِرَ تِنشِنشِ نَ مِندٍن؟</para>
  <para style="q" vid="JER 6:16">وٌ شَ لُ نَ كِرَ قَرِ عَلَكٌ وٌ شَ بْحّسَ سْتْ.»</para>
  <para style="b" vid="JER 6:16"/>
  <para style="q" vid="JER 6:16">كْنْ حَمَ بَرَ عَ يَابِ،</para>
  <para style="q" vid="JER 6:16">«مُشُ مُ وَ مَ لُقٍ نَ كِرَ شْن مَ.»<verse eid="JER 6:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="JER 6:17"/>عَلَ بَرَ عَ مَسٍن، «ﭑ بَرَ وٌ شَ سْورِيٍ تِ وٌ شَ تّتّ قَرِ،</para>
  <para style="q" vid="JER 6:17">نَشٍيٍ مّينِمَ وٌ مَ.</para>
  <para style="q" vid="JER 6:17">وٌ شَ عٍ شُي رَ مّ.»</para>
  <para style="b" vid="JER 6:17"/>
  <para style="q" vid="JER 6:17">كْنْ حَمَ بَرَ عَ يَابِ،</para>
  <para style="q" vid="JER 6:17">«مُشُ مُ وَ مَ عٍ شُي رَ مّقٍ.»<verse eid="JER 6:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="JER 6:18"/>عَلَ بَرَ عَ مَسٍن، «حَمَنّ بِرِن، وٌ وٌ تُلِ مَتِ،</para>
  <para style="q" vid="JER 6:18">وٌ شَ عَ مَتٌ نَشَن قَمَ رَبَدٍ بٍ.<verse eid="JER 6:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JER 6:19"/>دُنِحَ بِرِن، وٌ وٌ تُلِ مَتِ.</para>
  <para style="q" vid="JER 6:19">ﭑ تَن نَن قَمَ يِ حَمَ حَشَنكَتَدٍ،</para>
  <para style="q" vid="JER 6:19">ﭑ تَن نَن قَمَ عٍ مَحْشُنيِ سَرٍ رَفبِلٍندٍ عٍ مَ،</para>
  <para style="q" vid="JER 6:19">بَرِ مَ عٍ مُ تِن عٍ تُلِ مَتِدٍ ﭑ مَ مَسٍنيِ رَ،</para>
  <para style="q" vid="JER 6:19">عٍ بَرَ يٌ ﭑ مَ سّرِيّ مَ.<verse eid="JER 6:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 6:20"/>ﭑ هَيِ نَ عٍ شَ سُرَيِ سّرّشّ مَ،</para>
  <para style="q" vid="JER 6:20">نَشَن كٍلِشِ سٍيبَ؟</para>
  <para style="q" vid="JER 6:20">ﭑ هَيِ نَ عٍ شَ لَبُندّ سّرّشّ مَ،</para>
  <para style="q" vid="JER 6:20">نَشَن كٍلِشِ يِرٍ مَكُيٍ؟</para>
  <para style="q" vid="JER 6:20">وٌ شَ سّرّشّ فَن دَاشِيٍ مُ رَقَن ﭑ مَ،</para>
  <para style="q" vid="JER 6:20">ﭑ مُ تِنمَ وٌ شَ سّرّشّ سٍسٍ رَ سُشُدٍ.<verse eid="JER 6:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JER 6:21"/>نَ نَن عَ رَ عَلَتَلَ بَرَ عَ مَسٍن،</para>
  <para style="q" vid="JER 6:21">ﭑ قَمَ نّ فّمّ دْشْدٍ يِ حَمَ يَ رَ،</para>
  <para style="q" vid="JER 6:21">عٍ قَمَ عٍ سَنيِ رَدِندٍ نَشَن نَ.</para>
  <para style="q" vid="JER 6:21">بَبَيٍ نُن عٍ شَ دِيٍ،</para>
  <para style="q" vid="JER 6:21">دْشْبٌورٍيٍ نُن دّقَنبٌورٍيٍ،</para>
  <para style="q" vid="JER 6:21">عٍ بِرِن سْنتْمَ نّ.»<verse eid="JER 6:21"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="22" style="v" sid="JER 6:22"/>عَلَتَلَ بَرَ عَ مَسٍن،</para>
  <para style="q" vid="JER 6:22">«حَمَ ندٍ نَ قَقٍ كٍلِقٍ كْولَ مَ،</para>
  <para style="q" vid="JER 6:22">حَمَ فبٍفبٍ نَشَن نَ دُنِحَ يِرٍ بِرِن.<verse eid="JER 6:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JER 6:23"/>شَلِ نُن تَنبّ نَ عٍ يِ رَ.</para>
  <para style="q" vid="JER 6:23">عٍ حَاشُ، عٍ مُ كِنِكِنِ كٌلٌن.</para>
  <para style="q" vid="JER 6:23">عٍ شُي فبٌ عَلْ مْرْنيِ.</para>
  <para style="q" vid="JER 6:23">سٌي كَنيِيٍ نَن عٍ رَ.</para>
  <para style="q" vid="JER 6:23">عٍ بِرِن مَلَنشِ عَلَكٌ عٍ شَ سِيٌن فٍرٍ.»<verse eid="JER 6:23"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="24" style="v" sid="JER 6:24"/>عِسِرَيِلَ نَ وْيّنقٍ عٍ بٌرٍ تَفِ، «وٌن بَرَ عٍ شِبَارُ مّ،</para>
  <para style="q" vid="JER 6:24">لِمَنِيَ بَرَ بَ وٌن يِ رَ،</para>
  <para style="q" vid="JER 6:24">كْنتْقِلِ بَرَ وٌن سُشُ.</para>
  <para style="q" vid="JER 6:24">وٌن نَ تْورْقٍ عَلْ فِنّ نَشَن نَ دِ بَرِقٍ.<verse eid="JER 6:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JER 6:25"/>وٌ نَشَ مِنِ دَاشَ دٍ،</para>
  <para style="q" vid="JER 6:25">وٌ نَشَ حّرّ كِرَ شْن مَ،</para>
  <para style="q" vid="JER 6:25">بَرِ مَ وٌن يَشُييٍ وٌن نَبِلِنشِ،</para>
  <para style="q" vid="JER 6:25">سَنتِدّفّمَ نَ عٍ يِ رَ.»<verse eid="JER 6:25"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="26" style="v" sid="JER 6:26"/>ﭑ بَرَ عٍ يَابِ، «ﭑ مَ حَمَ، وٌ سُننُن دٌنمَ رَفٌرٌ وٌ مَ،</para>
  <para style="q" vid="JER 6:26">وٌ شَ سُننُن عَلْ مِشِ نَشَن شَ دِ كٍرٍنيِ بَرَ قَشَ.</para>
  <para style="q" vid="JER 6:26">وٌ شَ سُننُنيِ شَ فبٌ،</para>
  <para style="q" vid="JER 6:26">بَرِ مَ وٌن يَشُييٍ نَ قَقٍ كٍرٍن نَ.»<verse eid="JER 6:26"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="27" style="v" sid="JER 6:27"/>عَلَتَلَ بَرَ عَ مَسٍن ﭑ بّ، «ﭑ عِ قِندِشِ مِشِ نَن نَ</para>
  <para style="q" vid="JER 6:27">نَشَن ﭑ مَ حَمَ مَتٌمَ.</para>
  <para style="q" vid="JER 6:27">عِ شَ عٍ مَتٌ عَلَكٌ عِ شَ عَ كٌلٌن شَ عٍ حّرّ كِ قَن.</para>
  <para style="q" vid="JER 6:27">عِ لُشِ نّ عَلْ مِشِ نَشَن وُرٍ نُن فبٍتِ رَشُنُمَ، عَ عٍ فبِ بَ.<verse eid="JER 6:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="JER 6:28"/>عٍ بِرِن قِندِشِ مَتَندِلَيٍ نَن نَ نَشٍيٍ يٌمَ عَلَ مَ.</para>
  <para style="q" vid="JER 6:28">عٍ لُشِ عَلْ وُرٍ نُن يْشُي، نَشَن فبِ مُ بَشِ.</para>
  <para style="q" vid="JER 6:28">عٍ مُ قَن.<verse eid="JER 6:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="JER 6:29"/>شَبُي تّ رَدّشّمَ عَ قَنيِ رَ</para>
  <para style="q" vid="JER 6:29">عَلَكٌ عَ شَ وُرٍ نُن يْشُي رَشُنُ، عٍ فبِ شَ بَ.</para>
  <para style="q" vid="JER 6:29">كْنْ قٍ حَاشِ مُ حْنمَ ﭑ مَ حَمَ تَفِ.</para>
  <para style="q" vid="JER 6:29">عٍ لُشِ نّ عَلْ سُنبُي نَشَن مُ بَمَ وُرٍ كُي.<verse eid="JER 6:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="JER 6:30"/>عٍ شِلِ قَلَمَ ‹فبٍتِ كَنَشِ›،</para>
  <para style="q" vid="JER 6:30">بَرِ مَ عَلَتَلَ بَرَ عٍ رَبّحِن.»<verse eid="JER 6:30"/></para>
  <chapter eid="JER 6"/>
  <chapter number="7" style="c" sid="JER 7"/>
  <para style="s">عِسِرَيِلَ شَ فبَلٌي</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 7:1"/>عَلَتَلَ نَشَ يِ مَسٍنيِ تِ عَننَبِ يٍرٍ مِ بّ،<verse eid="JER 7:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JER 7:2"/>«عِ شَ تِ عَلَتَلَ شَ هْرْ مْبَنشِ نَادّ رَ،</para>
  <para style="q" vid="JER 7:2">عِ قَ يِ وْيّنيِ مَسٍن نَا،</para>
  <para style="q" vid="JER 7:2">‹وٌ وٌ تُلِ مَتِ عَلَتَلَ شَ مَسٍنيِ رَ،</para>
  <para style="q" vid="JER 7:2">وٌ تَن يُدَيَكَ نَشٍيٍ بِرِن سٌمَ يِ نَادّيٍ رَ قَقٍ تُوبِدٍ عَلَتَلَ بّ.<verse eid="JER 7:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JER 7:3"/>عِسِرَيِلَ مَنفّ عَلَتَلَ نَشّ، شَ وٌ كِرَ مَسَرَ،</para>
  <para style="q" vid="JER 7:3">وٌ نَشَ قٍ قَنيِ سُشُ،</para>
  <para style="q" vid="JER 7:3">ﭑ وٌ لُمَ نّ يِ بْشِ مَ.<verse eid="JER 7:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JER 7:4"/>وٌ نَشَ لَ يِ وُلٍ مَسٍنيِ رَ، وٌ نُ قَ عَ قَلَ؛</para>
  <para style="q" vid="JER 7:4">عَلَتَلَ شَ هْرْ مْبَنشِ نَن يِ كِ،</para>
  <para style="q" vid="JER 7:4">عَلَتَلَ شَ هْرْ مْبَنشِ، عَلَتَلَ شَ هْرْ مْبَنشِ.<verse eid="JER 7:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JER 7:5"/>شَ وٌ كِرَ مَسَرَ،</para>
  <para style="q" vid="JER 7:5">شَ وٌ قٍ قَنيِ سُشُ،</para>
  <para style="q" vid="JER 7:5">شَ وٌ تِنشِن وٌ بٌورٍيٍ تَفِ،<verse eid="JER 7:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JER 7:6"/>شَ وٌ مُ شْحّ، كِرِدِ، نُن كَاحّ فِنّ تْورْ،</para>
  <para style="q" vid="JER 7:6">شَ وٌ مُ مِشِ قَشَ تْوحّفّ رَ يِ بْشِ مَ،</para>
  <para style="q" vid="JER 7:6">شَ وٌ مُ بِرَ عَلَ فبّتّيٍ قْشْ رَ،</para>
  <para style="q" vid="JER 7:6">نَشٍيٍ قِندِ مَ تْورّ رَ وٌ بّ،<verse eid="JER 7:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JER 7:7"/>نَ تّمُي ﭑ وٌ لُمَ نّ يِ بْشِ مَ عَبَدَن،</para>
  <para style="q" vid="JER 7:7">ﭑ نَشَن قِشِ وٌ بَبَيٍ مَ.<verse eid="JER 7:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 7:8"/>كْنْ وٌ بَرَ بِرَ وُلٍ قْشْ رَ،</para>
  <para style="q" vid="JER 7:8">نَشَن مُ سٍسٍ قَنمَ وٌ مَ.<verse eid="JER 7:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JER 7:9"/>مُنقٍ رَ وٌ وَ مَ قَشّ نُن يّنّ رَبَقٍ،</para>
  <para style="q" vid="JER 7:9">وٌ وٌ كَلِ وُلٍ رَ،</para>
  <para style="q" vid="JER 7:9">وٌ سُرَيِ فَن سّرّشّ رَ بَلَ كُيٍ بّ،</para>
  <para style="q" vid="JER 7:9">وٌ بِرَ عَلَ فبّتّيٍ قْشْ رَ،</para>
  <para style="q" vid="JER 7:9">وٌ مُ نَشٍيٍ كٌلٌن؟<verse eid="JER 7:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JER 7:10"/>نَ شَنبِ وٌ قَ قَ تِدٍ ﭑ يَ عِ،</para>
  <para style="q" vid="JER 7:10">ﭑ مَ بَنشِ كُي، ﭑ شِلِ مَتْشْمَ دّننَشّ.</para>
  <para style="q" vid="JER 7:10">وٌ نَشّ وٌ بَرَ كِسِ،</para>
  <para style="q" vid="JER 7:10">كْنْ وٌ قٍ شْنشِ رَبَمَ.<verse eid="JER 7:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JER 7:11"/>وٌ يِ بَنشِ قِندِشِ مِشِ حَاشِ بَنشِ نَن نَ،</para>
  <para style="q" vid="JER 7:11">ﭑ شِلِ قَلَمَ دّننَشّ؟</para>
  <para style="q" vid="JER 7:11">ﭑ تَن عَلَتَلَ بَرَ عَ بِرِن تٌ.<verse eid="JER 7:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JER 7:12"/>وٌ شَ رَتُ سِلٌ مَ،</para>
  <para style="q" vid="JER 7:12">ﭑ مَ يِرٍ سّنِيّنشِ سِنفٍ نُ نَ دّننَشّ.</para>
  <para style="q" vid="JER 7:12">ﭑ بَرَ مّننِ قَن حَشَنكَتَ،</para>
  <para style="q" vid="JER 7:12">ﭑ مَ عِسِرَيِلَ حَمَ شَ حَاشُحَ شَ قٍ رَ.›»<verse eid="JER 7:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="JER 7:13"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ.</para>
  <para style="q" vid="JER 7:13">«يَكْسِ، وٌ تٌ بَرَ يِ قٍ بِرِن نَبَ،</para>
  <para style="q" vid="JER 7:13">وٌ تٌ تٌندِ ﭑ مَ مَسٍنيِ سُشُدٍ،</para>
  <para style="q" vid="JER 7:13">ﭑ نَشَن قَلَشِ وٌ بّ تّمُي بِرِن،</para>
  <para style="q" vid="JER 7:13">وٌ تٌ تٌندِ ﭑ مَ شِلِ رَتِندٍ،<verse eid="JER 7:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JER 7:14"/>ﭑ قَمَ نّ قٍ رَبَدٍ يِ هْرْ مْبَنشِ رَ،</para>
  <para style="q" vid="JER 7:14">عَلْ ﭑ نَشَن نَبَشِ سِلٌ رَ.</para>
  <para style="q" vid="JER 7:14">ﭑ نَ مْولِ رَبَمَ نّ يِ بَنشِ رَ،</para>
  <para style="q" vid="JER 7:14">ﭑ نَشَن قِشِ وٌ نُن وٌ بَبَيٍ مَ، وٌ لَشِ نَشَن نَ.<verse eid="JER 7:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 7:15"/>ﭑ وٌ مَكُيَمَ نّ ﭑ يِرٍ رَ،</para>
  <para style="q" vid="JER 7:15">عَلْ ﭑ وٌ نفَشَكٍرٍنيِيٍ عٍقِرَ مِ بْنسْي مَكُيَشِ ﭑ نَ كِ نَشّ.»<verse eid="JER 7:15"/></para>
  <para style="sp">عَلَتَلَ شَ مَسٍنيِ عَننَبِ يٍرٍ مِ بّ</para>
  <para style="q">
    <verse number="16" style="v" sid="JER 7:16"/>«عِ تَن، هَلِ عِ مُ عَلَ مَشَندِ يِ حَمَ بّ،</para>
  <para style="q" vid="JER 7:16">هَلِ عِ مُ عِ شُي عِتٍ سَلِدٍ،</para>
  <para style="q" vid="JER 7:16">هَلِ عِ مُ ﭑ مَكُلَ،</para>
  <para style="q" vid="JER 7:16">بَرِ مَ ﭑ مُ عِ دَنشُنمَ.<verse eid="JER 7:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 7:17"/>عِ مُ عَ تٌشِ قٍ نَشَن نَبَمَ يُدَيَ تَايٍ نُن دَرِ سَلَمُ كُي؟<verse eid="JER 7:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JER 7:18"/>عٍ شَ دِيٍ يٍفٍ مَتٌنفٌمَ،</para>
  <para style="q" vid="JER 7:18">بَبَيٍ تّ رَدّشّمَ،</para>
  <para style="q" vid="JER 7:18">فِنّيٍ قَن تَامِ شِندٍ رَ مُلَنمَ، عٍ عَ رَ مْندْ كُيٍ بّ،</para>
  <para style="q" vid="JER 7:18">وٌ نَشَن شِلِمَ كٌورٍ مَنفّ فِنّ.</para>
  <para style="q" vid="JER 7:18">عٍ مَن مِنسٍ بَمَ سّرّشّ رَ.</para>
  <para style="q" vid="JER 7:18">نَ كُي عٍ بَرَ ﭑ نَشْنْ،<verse eid="JER 7:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JER 7:19"/>ﭑ تَن قَن قَمَ نّ عٍ تْورْدٍ.»</para>
  <para style="b" vid="JER 7:19"/>
  <para style="q" vid="JER 7:19">عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 7:19">«عٍ بَرَ عٍ يّتّ تْورْ،</para>
  <para style="q" vid="JER 7:19">عٍ بَرَ عٍ يّتّ كَن نَيَافِ.<verse eid="JER 7:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 7:20"/>نَ نَن عَ تٌشِ ﭑ تَن مَرِفِ عَلَتَلَ نَشّ،</para>
  <para style="q" vid="JER 7:20">‹ﭑ مَ حَشَنكَتّ نَ يِ بْشِ مَ،</para>
  <para style="q" vid="JER 7:20">مِشِيٍ نُن سُبٍيٍ نُن بٌفِسٍيٍ مَ.</para>
  <para style="q" vid="JER 7:20">عٍ بِرِن قَمَ نّ فَندٍ تّ رَ،</para>
  <para style="q" vid="JER 7:20">نَشَن مُ شُبٍنمَ.›»<verse eid="JER 7:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="JER 7:21"/>عِسِرَيِلَ مَنفّ عَلَتَلَ نَشَ عَ مَسٍن،</para>
  <para style="q" vid="JER 7:21">«وٌ شَ وٌ شَ سّرّشّ فَن دَاشِ قَن دٌن.<verse eid="JER 7:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JER 7:22"/>ﭑ مُ سّرّشّ قٍ فبَنسَن شَ قَلَ وٌ بَبَيٍ بّ،</para>
  <para style="q" vid="JER 7:22">ﭑ تٌ عٍ رَ مِنِ مِسِرَ بْشِ رَ.<verse eid="JER 7:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JER 7:23"/>كْنْ ﭑ عٍ يَامَرِ يِ نَن نَ،</para>
  <para style="q" vid="JER 7:23">‹وٌ بِرَ ﭑ شُي قْشْ رَ،</para>
  <para style="q" vid="JER 7:23">عَلَكٌ ﭑ شَ قِندِ وٌ مَرِفِ عَلَ رَ،</para>
  <para style="q" vid="JER 7:23">وٌ قَن شَ قِندِ ﭑ مَ حَمَ رَ.</para>
  <para style="q" vid="JER 7:23">وٌ شَ حّرّ ﭑ مَ كِرَ شْن مَ،</para>
  <para style="q" vid="JER 7:23">ﭑ نَشَن مَسٍنشِ وٌ بّ،</para>
  <para style="q" vid="JER 7:23">عَلَكٌ وٌ شَ هّيرِ سْتْ.›<verse eid="JER 7:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JER 7:24"/>كْنْ عٍ مُ عٍ تُلِ مَتِ ﭑ نَ،</para>
  <para style="q" vid="JER 7:24">عٍ بَرَ بِرَ عٍ شَ مَحْشُن كٌبِ قْشْ رَ،</para>
  <para style="q" vid="JER 7:24">عٍ بَرَ عٍ كٌبٍ تِ ﭑ نَ،</para>
  <para style="q" vid="JER 7:24">عٍ مُ بِرَشِ ﭑ قْشْ رَ.<verse eid="JER 7:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JER 7:25"/>كَبِ وٌ بَبَيٍ نَشَ مِنِ مِسِرَ بْشِ رَ هَن تٌ،</para>
  <para style="q" vid="JER 7:25">ﭑ نَ ﭑ مَ كٌنيِ نَمِحْنمّيٍ شّيقٍ وٌ مَ.<verse eid="JER 7:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JER 7:26"/>كْنْ وٌ مُ وٌ تُلِ مَتِشِ ﭑ نَ.</para>
  <para style="q" vid="JER 7:26">وٌ شَشِلِ شْرْشْشِ،</para>
  <para style="q" vid="JER 7:26">وٌ بَرَ كٌبِ دَنفِقٍ وٌ بَبَيٍ رَ.»<verse eid="JER 7:26"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="27" style="v" sid="JER 7:27"/>«عِ نَ يِ وْيّنيِ بِرِن قَلَ عٍ بّ،</para>
  <para style="q" vid="JER 7:27">عٍ مُ عِ دَنشُنمَ.</para>
  <para style="q" vid="JER 7:27">عِ نَ عٍ شِلِ، عٍ مُ عَ رَتِنمَ.<verse eid="JER 7:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="JER 7:28"/>نَ تّمُي عِ شَ عَ قَلَ عٍ بّ،</para>
  <para style="q" vid="JER 7:28">‹سِ نَن يَ نَشَن مُ عٍ تُلِ مَتِمَ</para>
  <para style="q" vid="JER 7:28">عٍ مَرِفِ عَلَتَلَ شَ مَسٍنيِ رَ.</para>
  <para style="q" vid="JER 7:28">عٍ مُ مَرَ سِ مّمَ.</para>
  <para style="q" vid="JER 7:28">سّرِيّ يٌ مُ نَ عٍ يِ رَ.›<verse eid="JER 7:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="JER 7:29"/>عِ شُنسّشّ مَشَبَ،</para>
  <para style="q" vid="JER 7:29">عِ نَشَن نَلُشِ عِ شَ كَلِ شَ قٍ رَ.</para>
  <para style="q" vid="JER 7:29">عَلَتَلَ بَرَ شْنْ، عَ بَرَ يِ حَمَ رَبّحِن.<verse eid="JER 7:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="JER 7:30"/>يُدَيَكَيٍ بَرَ قٍ رَبَ ﭑ مُ وَ مَ نَشَن تٌقٍ.</para>
  <para style="q" vid="JER 7:30">عٍ بَرَ قٍ شْنشِ دْشْ ﭑ مَ بَنشِ كُي،</para>
  <para style="q" vid="JER 7:30">ﭑ شِلِ قَلَمَ دّننَشّ.</para>
  <para style="q" vid="JER 7:30">عٍ بَرَ نَ قِندِ يِرٍ سّنِيّنتَرٍ رَ.»</para>
  <para style="q" vid="JER 7:30">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="JER 7:30"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="31" style="v" sid="JER 7:31"/>«عٍ بَرَ كُيٍ بَتُدٍ يَءِلَن فٍيَ قَرِ تٌقٍتِ</para>
  <para style="q" vid="JER 7:31">نُن هِنٌمَ فُلُنبَ كُي،</para>
  <para style="q" vid="JER 7:31">عَلَكٌ عٍ شَ عٍ شَ دِيٍ فَن سّرّشّ رَ.</para>
  <para style="q" vid="JER 7:31">ﭑ تَن مُ عٍ يَمَرِشِ نَ قٍ مْولِ رَ،</para>
  <para style="q" vid="JER 7:31">عَ مَكُيَ ﭑ مَ مَحْشُنيِ رَ ثٌن.»<verse eid="JER 7:31"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="32" style="v" sid="JER 7:32"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ.</para>
  <para style="q" vid="JER 7:32">«لْشْي قَمَ قَدٍ تٌقٍتِ شِلِ مَسَرَ مَ نّ.</para>
  <para style="q" vid="JER 7:32">هِنٌمَ فُلُنبَ قَمَ نّ شِلِدٍ قَشّ تِدٍ.</para>
  <para style="q" vid="JER 7:32">تٌقٍتِ قِندِ مَ نّ فَبُرِ يِرٍ رَ.<verse eid="JER 7:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="JER 7:33"/>شْنِيٍ نُن سُبٍيٍ قَمَ نّ نَ حَمَ بِنبِيٍ دٌندٍ.</para>
  <para style="q" vid="JER 7:33">مِشِ يٌ مُ لُمَ نَا نَشَن عٍ كٍرِ مَ.<verse eid="JER 7:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="JER 7:34"/>شُلُنيِ حْنمَ نّ يُدَيَ نُن دَرِ سَلَمُ بْشِ كُي.</para>
  <para style="q" vid="JER 7:34">سِفِ مُ سَمَ، يٍلِبَ مُ وْيّنمَ.</para>
  <para style="q" vid="JER 7:34">قُوتِ مُ شِرِ مَ نَ فبَلٌي شَ قٍ رَ.»<verse eid="JER 7:34"/></para>
  <chapter eid="JER 7"/>
  <chapter number="8" style="c" sid="JER 8"/>
  <para style="s">عِسِرَيِلَ نُن عَننَبِ يٍرٍ مِ شَ تْورّ</para>
  <para style="sp">عَلَتَلَ شَ مَسٍنيِ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 8:1"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛ «نَ وَشَتِ يُدَيَ مَنفّيٍ، كُنتِفِيٍ، سّرّشّدُبّيٍ، نَمِحْنمّيٍ، نُن دَرِ سَلَمُكَيٍ، عٍ شْرِيٍ رَتٍمَ نّ فَبُرِ كُي، <verse eid="JER 8:1"/><verse number="2" style="v" sid="JER 8:2"/>عٍ سَ رَيٍنسٍن كّنّ مَ سٌفٍ، كِكٍ، نُن تُنبُييٍ بُن مَ، عٍ نَشٍيٍ شَنُ، عٍ نَشٍيٍ بَتُ، عٍ بِرَ نَشٍيٍ قْشْ رَ، عٍ نَشٍيٍ قٍن، عٍ تُوبِ نَشٍيٍ بّ. نَ نَن عَ رَ، عٍ شْرِيٍ مُ سَمَ فَبُرِ كُي، عٍ شَ رَيٍنسٍن بْشِ مَ. <verse eid="JER 8:2"/><verse number="3" style="v" sid="JER 8:3"/>مِشِ نَشٍيٍ مُ قَشَ نَ حَمَ حَاشِ يَ مَ، ﭑ قَمَ نّ عٍ رَيٍنسٍندٍ حَمَنّ مَ، قَشّ شْلِ عٍ سُشُمَ دّننَشّ.» عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="JER 8:3"/></para>
  <para style="sp">عَلَتَلَ شَ مَسٍنيِ عَننَبِ يٍرٍ مِ بّ</para>
  <para style="q">
    <verse number="4" style="v" sid="JER 8:4"/>عِ شَ عَ قَلَ عٍ بّ،</para>
  <para style="q" vid="JER 8:4">«عَلَتَلَ بَرَ عَ مَسٍن،</para>
  <para style="q" vid="JER 8:4">‹مِشِ نْمَ بِرَدٍ، عٍ مُ كٍلِ؟</para>
  <para style="q" vid="JER 8:4">مِشِ نْمَ عٍ مَقِندِدٍ، عٍ مُ فبِلٍن؟›<verse eid="JER 8:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JER 8:5"/>مُنقٍ رَ دَرِ سَلَمُ حَمَ ﭑ مَتَندِ مَ؟</para>
  <para style="q" vid="JER 8:5">مُنقٍ رَ عٍ فبِلٍنشِ كِرَ قَنيِ قْشْ رَ، عٍ بِرَ كِرَ حَاشِ قْشْ رَ؟</para>
  <para style="q" vid="JER 8:5">يِ مِشِيٍ لُمَ نّ عٍ شَ يَنقّ كُي،</para>
  <para style="q" vid="JER 8:5">عٍ تٌندِ فبِلٍندٍ ﭑ مَ.<verse eid="JER 8:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JER 8:6"/>ﭑ نَن ﭑ تُلِ مَتِمَ نّ عٍ شُي رَ،</para>
  <para style="q" vid="JER 8:6">كْنْ عٍ شَ وْيّنيِ مُ لَنمَ.</para>
  <para style="q" vid="JER 8:6">مِشِ يٌ مُ فبِلٍنمَ عَ شَ كٌبِحَ قْشْ رَ.</para>
  <para style="q" vid="JER 8:6">عَ مُ عَ قَلَمَ، ‹ﭑ نَ مُنسٍ رَبَقٍ؟›</para>
  <para style="q" vid="JER 8:6">كَنكَن بِرَ مَ عَ يّتّ وَشْنقٍ نَن قْشْ رَ،</para>
  <para style="q" vid="JER 8:6">عَلْ سٌي نَشَن فبَتَشِ سِفَقٍ فٍرٍ سٌدٍ.<verse eid="JER 8:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JER 8:7"/>هَلِ فبٌنفبٌي نَشَن نَ كٌورٍ مَ،</para>
  <para style="q" vid="JER 8:7">عَ فبِلٍن وَشَتِ كٌلٌن.</para>
  <para style="q" vid="JER 8:7">فَنبّ، تُرُننَ، نُن يٍدْنمّ بِرِن</para>
  <para style="q" vid="JER 8:7">عٍ عٍ فبِلٍن وَشَتِ كٌلٌن.</para>
  <para style="q" vid="JER 8:7">كْنْ ﭑ مَ حَمَ مُ عَلَتَلَ شَ سّرِيّ كٌلٌن.»<verse eid="JER 8:7"/></para>
  <para style="sp">عَلَتَلَ شَ مَسٍنيِ عِسِرَيِلَ بّ</para>
  <para style="q">
    <verse number="8" style="v" sid="JER 8:8"/>«وٌ عَ قَلَمَ، ‹لْننِلَيٍ نَن مُشُ رَ،</para>
  <para style="q" vid="JER 8:8">مُشُ عَلَتَلَ شَ سّرِيّ كٌلٌن.›</para>
  <para style="q" vid="JER 8:8">كْنْ وٌ نَ قَلَمَ دِ؟</para>
  <para style="q" vid="JER 8:8">وٌ شَ دِينّ سّبّلِتِيٍ بَرَ عَلَ شَ سّرِيّ مَسَرَ وُلٍ رَ.<verse eid="JER 8:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JER 8:9"/>وٌ شَ لْننِلَيٍ بَرَ يَافِ، عٍ شَشِلِ بَرَ عِقُ،</para>
  <para style="q" vid="JER 8:9">بَرِ مَ عٍ بَرَ شَنِن كٌنيِيَ كُي.</para>
  <para style="q" vid="JER 8:9">عٍ بَرَ نَ سْتْ بَرِ مَ عٍ يٌشِ عَلَتَلَ شَ مَسٍنيِ مَ.</para>
  <para style="q" vid="JER 8:9">عٍ قِندِشِ لْننِلَ مْولِ مُندُن نَ؟»<verse eid="JER 8:9"/></para>
  <para style="sp">عَلَتَلَ شَ مَسٍنيِ عَننَبِ يٍرٍ مِ بّ</para>
  <para style="q">
    <verse number="10" style="v" sid="JER 8:10"/>«نَ نَن عَ رَ ﭑ قَمَ عٍ شَ فِنّيٍ قِدٍ شّمّ فبّتّيٍ مَ.</para>
  <para style="q" vid="JER 8:10">مِشِ فبّتّيٍ قَمَ عٍ شَ شّيٍ بَدٍ عٍ يِ رَ،</para>
  <para style="q" vid="JER 8:10">بَرِ مَ عٍ بِرِن نَ عٍ يّتّ شَ فٍينِ فبَنسَن نَن قٍنقٍ.</para>
  <para style="q" vid="JER 8:10">عَ قْلْقٍ عٍ شَ نَمِحْنمّيٍ مَ، عَ سَ دْشْ عٍ شَ سّرّشّدُبّيٍ رَ،</para>
  <para style="q" vid="JER 8:10">عٍ بِرِن نَ وُلٍ قَلَقٍ.<verse eid="JER 8:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JER 8:11"/>عٍ مُ قٍ فبٍفبٍ رَبَمَ ﭑ مَ حَمَ مَلِقٍ رَ.</para>
  <para style="q" vid="JER 8:11">عٍ عَ قَلَمَ، ‹وٌ نَشَ كْنتْقِلِ، وٌ بْحّ شَ سَ.›</para>
  <para style="q" vid="JER 8:11">كْنْ بْحّسَ يٌ مُ نَ.<verse eid="JER 8:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JER 8:12"/>عَ لَنمَ عٍ شَ يَافِ عٍ شَ قٍ كٌبِيٍ رَ،</para>
  <para style="q" vid="JER 8:12">كْنْ عٍ مُ يَافِمَ.</para>
  <para style="q" vid="JER 8:12">يَافِتَرٍ نَن لَنشِ عٍ مَ.</para>
  <para style="q" vid="JER 8:12">نَ نَن عَ رَ، ﭑ قَمَ عٍ رَبِرَدٍ كِيتِ وَشَتِ.»</para>
  <para style="q" vid="JER 8:12">عَلَتَلَ شَ وْيّنيِ نَن نَ كِ.<verse eid="JER 8:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="JER 8:13"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 8:13">«ﭑ بَرَ نَتّ تٌنفٌ ﭑ شَ عٍ رَبٌلٌ.</para>
  <para style="q" vid="JER 8:13">ﭑ مُ وّنِ بٌفِ قِمَ عٍ مَ،</para>
  <para style="q" vid="JER 8:13">ﭑ مُ شْرّ بٌفِ رَ مِنِمَ عٍ شَ شْرّ بِلِيٍ كْن نَ.</para>
  <para style="q" vid="JER 8:13">عٍ بُرّشّ لِسِمَ نّ،</para>
  <para style="q" vid="JER 8:13">مِشِ فبّتّيٍ قَ عٍ بٌفِ بَدٍ.»<verse eid="JER 8:13"/></para>
  <para style="sp">عِسِرَيِلَ شَ مَسٍنيِ عٍ بٌورٍ بّ</para>
  <para style="q">
    <verse number="14" style="v" sid="JER 8:14"/>«وٌن نَ مُنسٍ رَبَقٍ بٍ؟</para>
  <para style="q" vid="JER 8:14">وٌن شَ مَلَن، وٌن شَ وٌن فِ تَا مَكَنتَشِيٍ كُي،</para>
  <para style="q" vid="JER 8:14">وٌن شَ قَشَ نَا،</para>
  <para style="q" vid="JER 8:14">بَرِ مَ وٌن مَرِفِ عَلَتَلَ بَرَ نَتّ تٌنفٌ</para>
  <para style="q" vid="JER 8:14">عَ شَ وٌن سْنتْ، عَ شَ شْنّ دْشْ وٌن مَ وٌن مَ يُنُبِيٍ شَ قٍ رَ.<verse eid="JER 8:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 8:15"/>وٌن بَرَ وَ بْحّسَ شْن، كْنْ بْحّسَ يٌ مُ نَ.</para>
  <para style="q" vid="JER 8:15">وٌن بَرَ وَ يَلَنيِ شْن، كْنْ فٍرٍ بَرَ كٍلِ.<verse eid="JER 8:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 8:16"/>وٌن يَشُييٍ شَ سٌي شُي مّمَ دَنَ بْشِ مَبِرِ،</para>
  <para style="q" vid="JER 8:16">بْشِ بِرِن نَ سّرّنقٍ نَ شُي مَ.</para>
  <para style="q" vid="JER 8:16">عٍ قَمَ نّ بْشِ بِرِن شُن نَكَنَدٍ،</para>
  <para style="q" vid="JER 8:16">عٍ قَ مِشِ بِرِن سْنتْدٍ.»<verse eid="JER 8:16"/></para>
  <para style="sp">عَلَتَلَ شَ مَسٍنيِ عِسِرَيِلَ بّ</para>
  <para style="q">
    <verse number="17" style="v" sid="JER 8:17"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 8:17">«ﭑ نَ بٍ. ﭑ بَرَ بْشِمَسٍ حَاشِيٍ رَ سَنبَ وٌ مَ.</para>
  <para style="q" vid="JER 8:17">مِشِ يٌ مُ نْمَ عٍ رَ، عٍ وٌ شِنمَ نّ.»<verse eid="JER 8:17"/></para>
  <para style="sp">عَننَبِ يٍرٍ مِ شَ مَسٍنيِ عَلَتَلَ بّ</para>
  <para style="q">
    <verse number="18" style="v" sid="JER 8:18"/>«قّيرّ يٌ مُ نَ، ﭑ بْحّ بَرَ تْورْ.<verse eid="JER 8:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JER 8:19"/>عِ تُلِ مَتِ ﭑ بْنسْي وَ شُي رَ نَشَن كٍلِقٍ يِرٍ مَكُيٍ.</para>
  <para style="q" vid="JER 8:19">عٍ عَ قَلَمَ، ‹عَلَتَلَ مُ نَ سِيٌن؟</para>
  <para style="q" vid="JER 8:19">سِيٌن مَنفّ مُ نَ سْنْن؟›</para>
  <para style="q" vid="JER 8:19">عَلَ عٍ يَابِمَ نّ،</para>
  <para style="q" vid="JER 8:19">‹مُنقٍ رَ عٍ وَ مَ ﭑ نَشْنْقٍ عٍ شَ كُيٍيٍ رَ</para>
  <para style="q" vid="JER 8:19">نَشٍيٍ تِدٍ يٌ مُ نَ، نَشٍيٍ كٍلِشِ يِرٍ مَكُيٍ؟›<verse eid="JER 8:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 8:20"/>شّ شَبَ تّمُي بَرَ دَنفِ،</para>
  <para style="q" vid="JER 8:20">سٌفٌقُرٍ قَن بَرَ دَنفِ.</para>
  <para style="q" vid="JER 8:20">هَن يَ وٌن مُ كِسِ سْتْ.<verse eid="JER 8:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JER 8:21"/>ﭑ بْنسْي شَ تْورّ بَرَ قِندِ كٌتٍ رَ ﭑ بّ.</para>
  <para style="q" vid="JER 8:21">ﭑ بَرَ كِنِكِنِ، لِمَنِيَ بَرَ بَ ﭑ يِ رَ.<verse eid="JER 8:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JER 8:22"/>سٍرِ يٌ مُ نَ فَلَدِ بْشِ مَ؟</para>
  <para style="q" vid="JER 8:22">سٍرِبَ يٌ مُ نَا؟</para>
  <para style="q" vid="JER 8:22">مُنقٍ رَ ﭑ بْنسْي مُ نْمَ يَلَندٍ؟<verse eid="JER 8:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JER 8:23"/>يٍ يٌ مُ نَ ﭑ قَتٍ كُي سْنْن</para>
  <para style="q" vid="JER 8:23">نَشَن قِندِ مَ يَ يٍ رَ.</para>
  <para style="q" vid="JER 8:23">ﭑ بَرَ وَ كْي نُن يَنيِ رَ ﭑ بْنسْي بّ نَشَن تْورْشِ.»<verse eid="JER 8:23"/></para>
  <chapter eid="JER 8"/>
  <chapter number="9" style="c" sid="JER 9"/>
  <para style="s">وُلٍ قَلَقٍ</para>
  <para style="sp">عَلَتَلَ شَ مَسٍنيِ</para>
  <para style="q">
    <verse number="1" style="v" sid="JER 9:1"/>«شَ عَ سَ لِ ﭑ مِشِ ندٍ سْتْ نَشٍيٍ نَ بِيَاسِ كُي،</para>
  <para style="q" vid="JER 9:1">ﭑ كَقُمَ نٍيٍ نَن مَ، ﭑ نَ ﭑ مَ حَمَ رَبّحِن.</para>
  <para style="q" vid="JER 9:1">ﭑ وَ مَ ﭑ مَكُيَقٍ نّ عٍ رَ،</para>
  <para style="q" vid="JER 9:1">بَرِ مَ يّنّلَيٍ نُن يَنقَنتٍيٍ نَن عٍ رَ.<verse eid="JER 9:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JER 9:2"/>عٍ دّ وُلٍ قَلَمَ عَلْ سْورِ نَشَن تَنبّ وٌلِمَ.</para>
  <para style="q" vid="JER 9:2">وُلٍ سّنبّ فبٌ عٍ يَ مَ، عٍ مُ نْندِ كٌلٌن.</para>
  <para style="q" vid="JER 9:2">عٍ لُمَ يُنُبِ رَبَ رَ، عٍ مُ ﭑ كٌلٌن.»</para>
  <para style="q" vid="JER 9:2">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="JER 9:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="JER 9:3"/>«وٌ نَشَ لَ وٌ بٌورٍ رَ،</para>
  <para style="q" vid="JER 9:3">وٌ نَشَ لَ وٌ نفَشَكٍرٍنيِ رَ،</para>
  <para style="q" vid="JER 9:3">بَرِ مَ بِرِن لُمَ نّ عٍ بٌورٍ مَدَشُ رَ،</para>
  <para style="q" vid="JER 9:3">عٍ بِرِن بِرَ تْوحّفّ قْشْ رَ.<verse eid="JER 9:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JER 9:4"/>كَنكَن وُلٍ قَلَمَ عٍ بٌورٍ بّ،</para>
  <para style="q" vid="JER 9:4">يَنقَنتٍيَ فبٌ عٍ يَ مَ.</para>
  <para style="q" vid="JER 9:4">عٍ دّ بَرَ وُلٍ مَتِنكَن،</para>
  <para style="q" vid="JER 9:4">عٍ لُمَ نَ يُنُبِ كِرَ نَن شْن مَ.<verse eid="JER 9:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JER 9:5"/>يَنقَنتٍيٍ نَن عٍ رَ،</para>
  <para style="q" vid="JER 9:5">عٍ مُ وَ مَ ﭑ تَن كٌلٌنقٍ.»</para>
  <para style="q" vid="JER 9:5">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="JER 9:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="JER 9:6"/>مَنفّ عَلَتَلَ بَرَ عَ مَسٍن،</para>
  <para style="q" vid="JER 9:6">«ﭑ قَمَ نّ عٍ مَتٌدٍ،</para>
  <para style="q" vid="JER 9:6">عَلْ شَبُي نَشَن وُرٍ رَشُنُمَ عَلَكٌ عَ فبِ شَ بَ.</para>
  <para style="q" vid="JER 9:6">ﭑ قَمَ نّ قٍ ندٍ رَبَدٍ عٍ شَ حَاشُحَ شَ قٍ رَ.<verse eid="JER 9:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JER 9:7"/>وُلٍ قَلّ نَن عٍ رَ، يَنقَنتٍيَ رَقَن عٍ مَ.</para>
  <para style="q" vid="JER 9:7">عٍ قٍ قَنيِ قَلَمَ عٍ بٌورٍ بّ عٍ دّ نَن كُي،</para>
  <para style="q" vid="JER 9:7">كْنْ يَنقَنتٍيَ نَ عٍ بْحّ مَ.<verse eid="JER 9:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 9:8"/>عَ مُ لَنمَ ﭑ شَ عٍ حَشَنكَتَ نَ قٍ مَ؟</para>
  <para style="q" vid="JER 9:8">عَ مُ لَنمَ شّ عٍ سَرٍ شَ قِ؟»</para>
  <para style="q" vid="JER 9:8">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="JER 9:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="JER 9:9"/>«ﭑ يَ يٍ رَ مِنِمَ فٍيَيٍ نُن فبٍنفبٍرٍنيِيٍ شَ قٍ رَ.</para>
  <para style="q" vid="JER 9:9">نَ بِرِن فَنشِ، مِشِ مُ نَ، شُرُ سٍ مُ نَ.<verse eid="JER 9:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JER 9:10"/>ﭑ فّمّيٍ مَلَنمَ نّ يِرٍ دَرِ سَلَمُ نُ نَ دّننَشّ،</para>
  <para style="q" vid="JER 9:10">مّننِ شَ قِندِ وُلَءِ بَرٍيٍ شْنيِ رَ.</para>
  <para style="q" vid="JER 9:10">ﭑ يُدَيَ تَايٍ قِندِ مَ نّ فبَلٌي يِرٍ رَ،</para>
  <para style="q" vid="JER 9:10">مِشِ يٌ مُ لُ نَا.»<verse eid="JER 9:10"/></para>
  <para style="sp">عِسِرَيِلَ شَ مَسٍنيِ</para>
  <para style="q">
    <verse number="11" style="v" sid="JER 9:11"/>«عَدَ مَدِ مُندُن نْمَ نَ قٍ قَهَامُدٍ؟</para>
  <para style="q" vid="JER 9:11">شَ عَلَ بَرَ نَ تَفِ رَبَ مِشِ ندٍ بّ،</para>
  <para style="q" vid="JER 9:11">عَ شَ عَ مَسٍن مُشُ بّ.</para>
  <para style="q" vid="JER 9:11">بٍ بْشِ قِندِشِ فبَلٌي بْشِ نَن نَ،</para>
  <para style="q" vid="JER 9:11">عَ بِرِن فَنشِ، مِشِ مُ نَ.»<verse eid="JER 9:11"/></para>
  <para style="sp">عَلَتَلَ شَ مَسٍنيِ</para>
  <para style="p">
    <verse number="12" style="v" sid="JER 9:12"/>عَلَتَلَ بَرَ عَ مَسٍن، «نَ فبَلٌي عٍ لِشِ نّ بَرِ مَ عٍ بَرَ ﭑ مَ سّرِيّ رَبٌلٌ ﭑ نَشَن قِشِ عٍ مَ. عٍ مُ عٍ تُلِ مَتِشِ ﭑ مَ مَسٍنيِ رَ، عٍ مُ ﭑ مَ يَامَرِيٍ رَبَتُشِ. <verse eid="JER 9:12"/><verse number="13" style="v" sid="JER 9:13"/>عٍ بَرَ بِرَ عٍ يّتّ وَشْنقٍ قْشْ رَ، عٍ نُ بَلِ كُيٍيٍ بَتُ عٍ بَبَيٍ نَشٍيٍ مَسٍنشِ عٍ بّ. <verse eid="JER 9:13"/><verse number="14" style="v" sid="JER 9:14"/>نَ نَن عَ رَ ﭑ تَن عِسِرَيِلَ مَرِفِ عَلَتَلَ بَرَ نَتّ تٌنفٌ يِ حَمَ شَ ثْسْنّ فٍرُن. <verse eid="JER 9:14"/><verse number="15" style="v" sid="JER 9:15"/>ﭑ عٍ رَيٍنسٍنمَ نّ حَمَنّ مَ، عٍ تَن نُن عٍ بَبَيٍ مُ دّننَشّ كٌلٌن، ﭑ عٍ سْنتْمَ نّ سَنتِدّفّمَ رَ.»<verse eid="JER 9:15"/></para>
  <para style="sp">عَلَتَلَ شَ مَسٍنيِ</para>
  <para style="q">
    <verse number="16" style="v" sid="JER 9:16"/>مَنفّ عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 9:16">«وٌ وٌ تُلِ مَتِ.</para>
  <para style="q" vid="JER 9:16">وٌ مِشِيٍ شِلِ نَشٍيٍ قَتَ وَدٍ،</para>
  <para style="q" vid="JER 9:16">عٍ شَ عٍ وَ شُي رَ مِنِ.<verse eid="JER 9:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 9:17"/>عٍ شَ عٍ شُلُن عٍ وَ شُي رَ مِنِدٍ.</para>
  <para style="q" vid="JER 9:17">وٌن تَن قَن شَ وَ، يَ يٍ شَ مِنِ.»<verse eid="JER 9:17"/></para>
  <para style="sp">عِسِرَيِلَ شَ مَسٍنيِ</para>
  <para style="q">
    <verse number="18" style="v" sid="JER 9:18"/>وَ شُي مِنِمَ سِيٌن تَا كُي؛</para>
  <para style="q" vid="JER 9:18">«وٌن بَرَ فبَلٌي سْتْ،</para>
  <para style="q" vid="JER 9:18">وٌن بَرَ لُ يَافِ كُي.</para>
  <para style="q" vid="JER 9:18">وٌن بَرَ كٍلِ وٌن مَ بْشِ مَ،</para>
  <para style="q" vid="JER 9:18">وٌن مَ بَنشِيٍ بَرَ كَنَ.»<verse eid="JER 9:18"/></para>
  <para style="sp">عَننَبِ يٍرٍ مِ شَ مَسٍنيِ</para>
  <para style="q">
    <verse number="19" style="v" sid="JER 9:19"/>«وٌ تَن فِنّيٍ، وٌ وٌ تُلِ مَتِ عَلَتَلَ شَ مَسٍنيِ رَ،</para>
  <para style="q" vid="JER 9:19">وٌ وٌ تُلِ مَتِ عَ شَ وْيّنيِ رَ.</para>
  <para style="q" vid="JER 9:19">وٌ وٌ شَ دِيٍ نُن وٌ بٌورٍيٍ مَتِنكَن وَ رَ،<verse eid="JER 9:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 9:20"/>بَرِ مَ قَشّ بَرَ سٌ وٌن شْنيِ.</para>
  <para style="q" vid="JER 9:20">وٌن مَ دِيٍ بَرَ قَشَ كِرَ رَ،</para>
  <para style="q" vid="JER 9:20">وٌن مَ قٌنِكٍيٍ بَرَ قَشَ تَا كُي.»<verse eid="JER 9:20"/></para>
  <para style="sp">عَلَتَلَ شَ مَسٍنيِ</para>
  <para style="q">
    <verse number="21" style="v" sid="JER 9:21"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 9:21">«عَ قَلَ حَمَ بّ مِشِيٍ نَ قَشَقٍ،</para>
  <para style="q" vid="JER 9:21">عٍ لُشِ بْشِ مَ عَلْ مَالٍ شِرِ نَشٍيٍ شَبَشِ،</para>
  <para style="q" vid="JER 9:21">كْنْ مِشِ مُ نَ نَشَن عٍ مَلَنمَ.»<verse eid="JER 9:21"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="22" style="v" sid="JER 9:22"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 9:22">«لْننِلَ نَشَ عَ يّتّ مَتْشْ عَ شَ لْننِ شَ قٍ رَ.</para>
  <para style="q" vid="JER 9:22">سّنبّمَ نَشَ عَ يّتّ مَتْشْ عَ سّنبّ شَ قٍ رَ.</para>
  <para style="q" vid="JER 9:22">بَننَ مِشِ نَشَ عَ يّتّ مَتْشْ عَ شَ بَننَيَ شَ قٍ رَ.<verse eid="JER 9:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JER 9:23"/>شَ مِشِ وَ مَ عَ يّتّ مَتْشْقٍ قٍ ندٍ مَ،</para>
  <para style="q" vid="JER 9:23">عَ شَ عَ يّتّ مَتْشْ عَ شَ دَنشَنِيَ نَن مَ قٍ رَ.</para>
  <para style="q" vid="JER 9:23">عَلَتَلَ نَن ﭑ نَ،</para>
  <para style="q" vid="JER 9:23">هِننّنتٍ نَشَن تِنشِنيِ نُن سّرِيّ رَوَلِمَ دُنِحَ مَ.</para>
  <para style="q" vid="JER 9:23">نَ قٍ مْولِ رَقَن ﭑ مَ.»</para>
  <para style="q" vid="JER 9:23">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="JER 9:23"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="24" style="v" sid="JER 9:24"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 9:24">«لْشْي قَمَ قَدٍ، ﭑ مِشِ هَلَكِمَ نّ،</para>
  <para style="q" vid="JER 9:24">نَشَن سُننَشِ كْنْ عَ بْحّ مُ سّنِيّن،<verse eid="JER 9:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JER 9:25"/>عَلْ مِسِرَكَيٍ، يُدَيَكَيٍ، عٍدٌنكَيٍ،</para>
  <para style="q" vid="JER 9:25">عَمٌنِكَيٍ، مٌوَبَكَيٍ،</para>
  <para style="q" vid="JER 9:25">نَشٍيٍ بِرِن عٍ شُنسّشّ مَشَبَمَ</para>
  <para style="q" vid="JER 9:25">نَشَن نَ عٍ شُنيِ سّيتِيٍ مَ.</para>
  <para style="q" vid="JER 9:25">يِ سِ بِرِن نَشٍيٍ نَ فبٍنفبٍرٍنيِ مَ،</para>
  <para style="q" vid="JER 9:25">عٍ سُننَشِ، كْنْ عٍ مُ سُننَ وَلِ رَبَمَ.</para>
  <para style="q" vid="JER 9:25">هَلِ عِسِرَيِلَكَيٍ مُ سُننَ وَلِ رَبَمَ،</para>
  <para style="q" vid="JER 9:25">عٍ بْحّ مُ سّنِيّن.»<verse eid="JER 9:25"/></para>
  <chapter eid="JER 9"/>
  <chapter number="10" style="c" sid="JER 10"/>
  <para style="s">كُيٍيٍ</para>
  <para style="sp">عَلَتَلَ شَ مَسٍنيِ</para>
  <para style="q">
    <verse number="1" style="v" sid="JER 10:1"/>عِسِرَيِلَ بْنسْي، وٌ وٌ تُلِ مَتِ عَلَتَلَ شَ مَسٍنيِ رَ.<verse eid="JER 10:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JER 10:2"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 10:2">«وٌ نَشَ بِرَ سِ فبّتّيٍ حّرّ كِ قْشْ رَ.</para>
  <para style="q" vid="JER 10:2">وٌ نَشَ فَاشُ تْنشُمَيٍ يَ رَ نَشٍيٍ نَ كٌورٍ مَ.</para>
  <para style="q" vid="JER 10:2">سِ فبّتّيٍ فَاشُمَ نَ قٍ مْولِ نَن يَ رَ.<verse eid="JER 10:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JER 10:3"/>عٍ شَ دِينّ مُ قِندِشِ نْندِ رَ.</para>
  <para style="q" vid="JER 10:3">عٍ وُرِ سّفّمَ وُلَ عِ،</para>
  <para style="q" vid="JER 10:3">مِشِ ندٍ عَ مَسٌلِ بٍيرَ رَ.<verse eid="JER 10:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JER 10:4"/>عٍ عَ رَشُنمَ فبٍتِ نُن شّيمَ رَ،</para>
  <para style="q" vid="JER 10:4">عٍ لَنتُمَ مَبَنبَن دّرّ مَ رَ عَلَكٌ عَ نَشَ بِرَ.<verse eid="JER 10:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JER 10:5"/>نَ كُيٍيٍ مُ نْمَ وْيّندٍ.</para>
  <para style="q" vid="JER 10:5">عَ لُشِ نّ عَلْ وُرِ نَشَن تِشِ لَاكْي يِرٍ شْنِيٍ مَفَاشُ سٍ.</para>
  <para style="q" vid="JER 10:5">عَ مُ نْمَ حّرّدٍ، قٌ مِشِ عَ شَنِن.</para>
  <para style="q" vid="JER 10:5">وٌ نَشَ فَاشُ نَ كُيٍ مْولِ يَ رَ،</para>
  <para style="q" vid="JER 10:5">بَرِ مَ عَ مُ نْمَ قٍ حَاشِ شَ نَ مُ عَ قَنيِ رَبَدٍ.<verse eid="JER 10:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JER 10:6"/>عَلَتَلَ، عِ مَنِيّ مُ نَ.</para>
  <para style="q" vid="JER 10:6">عِ سّنبّ فبٌ، عِ شِلِ مَفَاشُ.<verse eid="JER 10:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JER 10:7"/>دُنِحَ مَنفّ، ندٍ نَ نَشَن مُ فَاشُمَ عِ يَ رَ؟</para>
  <para style="q" vid="JER 10:7">عَ لَنمَ دُنِحَ بِرِن شَ فَاشُ عِ يَ رَ،</para>
  <para style="q" vid="JER 10:7">بَرِ مَ عِ مَنِيّ يٌ مُ نَ دُنِحَ لْننِلَيٍ تَفِ،</para>
  <para style="q" vid="JER 10:7">شَ نَ مُ عَ رَ دُنِحَ مَنفّيٍ يَ مَ.<verse eid="JER 10:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 10:8"/>دُنِحَ مِشِ قِندِشِ لْننِتَرٍ نُن شَشِلِتَرٍ نَن نَ.</para>
  <para style="q" vid="JER 10:8">نَ كٌلٌنمَ عٍ شَ وُرِ بَتُي نَن كُي.<verse eid="JER 10:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JER 10:9"/>كُيٍيٍ قِندِشِ فبٍتِ نَن نَ تَرَ سِسِ دَاشِ،</para>
  <para style="q" vid="JER 10:9">عَ قِندِشِ شّيمَ رَ عُقَسِ دَاشِ.</para>
  <para style="q" vid="JER 10:9">شَبُي نَن عَ يَءِلَنمَ.</para>
  <para style="q" vid="JER 10:9">دُفِ فبٍيلِ رَفٌرٌشِ عَ مَ.</para>
  <para style="q" vid="JER 10:9">وَلِكّيٍ نَن كُيٍ يَءِلَنمَ.<verse eid="JER 10:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JER 10:10"/>كْنْ عَلَتَلَ نَن قِندِشِ عَلَ رَ نْندِ كِ مَ.</para>
  <para style="q" vid="JER 10:10">عَلَ حِحّ نَن مَنفّ رَ عَبَدَن.</para>
  <para style="q" vid="JER 10:10">دُنِحَ سّرّنمَ عَ شَ شْنّ نَن يَ رَ،</para>
  <para style="q" vid="JER 10:10">سِيٍ مُ نْمَ تِدٍ عَ يَ رَ.<verse eid="JER 10:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JER 10:11"/>وٌ شَ عَ مَسٍن عٍ بّ،</para>
  <para style="q" vid="JER 10:11">‹يِ كُيٍيٍ شَ مُ دُنِحَ نُن كٌورٍ دَاشِ،</para>
  <para style="q" vid="JER 10:11">عٍ مُ نْمَ بُدٍ دُنِحَ بّندّ قُحِ قَرِ.›»<verse eid="JER 10:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="JER 10:12"/>عَلَتَلَ نَن بْشِ دَا عَ سّنبّ رَ،</para>
  <para style="q" vid="JER 10:12">عَ دُنِحَ تِ عَ شَ لْننِ رَ،</para>
  <para style="q" vid="JER 10:12">عَ كٌورٍ وَلَشّ عِتَلَ عَ شَشِلِ رَ.<verse eid="JER 10:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JER 10:13"/>عَ نَ يَامَرِ قِ، يٍ شَ مَلَن كٌورٍ مَ، عَ مَلَنمَ نّ،</para>
  <para style="q" vid="JER 10:13">عَ قِندِ نُشُي رَ دُنِحَ شُن مَ،</para>
  <para style="q" vid="JER 10:13">يٍ نُن قٌيٍ نَ مِنِ، فَلَنيِ قَن عَ شُي رَ مِنِ.<verse eid="JER 10:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JER 10:14"/>عَدَ مَدِ شَشِلِ مُ نَ.</para>
  <para style="q" vid="JER 10:14">كُيٍ يَءِلَنمَ قَمَ نّ يَافِدٍ عَ شَ وَلِ شَ قٍ رَ،</para>
  <para style="q" vid="JER 10:14">بَرِ مَ كُيٍيٍ قِندِشِ وُلٍ نَن نَ،</para>
  <para style="q" vid="JER 10:14">عٍ مُ حّنفِمَ قٍقٍ مَ.<verse eid="JER 10:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 10:15"/>سٍ قُقَقُ نَن عٍ رَ،</para>
  <para style="q" vid="JER 10:15">عٍ قِندِشِ مِشِ شَ وَلِ نَن نَ نَشٍيٍ تِدٍ يٌ مُ نَ،</para>
  <para style="q" vid="JER 10:15">نَشٍيٍ دَنفِمَ دُنِحَ حَشَنكَتَمَ لْشْي نَشّ.<verse eid="JER 10:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 10:16"/>يَشُبَ مَرِفِ مُ مَنِيَمَ كُيٍ رَ.</para>
  <para style="q" vid="JER 10:16">يَشُبَ مَرِفِ نَن بِرِن دَاشِ،</para>
  <para style="q" vid="JER 10:16">عَ عِسِرَيِلَ سُفَندِ عَ شَ حَمَ رَ.</para>
  <para style="q" vid="JER 10:16">عَ شِلِ قَلَمَ نّ مَنفّ عَلَتَلَ.<verse eid="JER 10:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 10:17"/>وٌ وٌ هَرِفٍ مَلَن،</para>
  <para style="q" vid="JER 10:17">وٌ تَن نَشٍيٍ نَ تَا سُشُشِ كُي،<verse eid="JER 10:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JER 10:18"/>بَرِ مَ عَلَتَلَ بَرَ عَ مَسٍن،</para>
  <para style="q" vid="JER 10:18">«ﭑ بٍكَيٍ كٍرِ مَ نّ</para>
  <para style="q" vid="JER 10:18">عَلْ مِشِ نَشَن فّمّ وٌلِمَ لَاتِ رَ.</para>
  <para style="q" vid="JER 10:18">ﭑ عٍ هَلَكِمَ نّ، عٍ مُ كِسِمَ.»<verse eid="JER 10:18"/></para>
  <para style="sp">عِسِرَيِلَ شَ مَسٍنيِ</para>
  <para style="q">
    <verse number="19" style="v" sid="JER 10:19"/>«حَشَنكَتّ بِرِن نَ ﭑ بّ، ﭑ مَ تْورّ فبٌ.</para>
  <para style="q" vid="JER 10:19">كْنْ ﭑ عَ قَلَمَ نّ ﭑ يّتّ بّ،</para>
  <para style="q" vid="JER 10:19">تْورّ نَن عَ رَ ﭑ نَشَن سْتْ، ﭑ شَ تِن نَ رَ.<verse eid="JER 10:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 10:20"/>ﭑ مَ كِرِ بَنشِ بَرَ بِرَ،</para>
  <para style="q" vid="JER 10:20">عَ لُوتِيٍ بَرَ بٌلٌن.</para>
  <para style="q" vid="JER 10:20">ﭑ مَ دِيٍ بَرَ كٍلِ ﭑ شُن مَ،</para>
  <para style="q" vid="JER 10:20">مِشِ يٌ مُ نَ نَشَن ﭑ مَلِمَ بَنشِ تِدٍ.<verse eid="JER 10:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JER 10:21"/>عِسِرَيِلَ يَرٍرَتِيٍ شَشِلِ مُ نَ،</para>
  <para style="q" vid="JER 10:21">عٍ مُ عَلَتَلَ قٍنشِ.</para>
  <para style="q" vid="JER 10:21">عٍ شَشِلِتَرٍحَ تٌمَ نَ كُي.</para>
  <para style="q" vid="JER 10:21">عٍ قْشِرَبِرّيٍ يٍنسٍنشِ نَ نَن مَ.<verse eid="JER 10:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JER 10:22"/>وٌن شُي مَفَاشُشِ مّمَ نّ نَشَن كٍلِشِ كْولَ مَ،</para>
  <para style="q" vid="JER 10:22">نَشَن قَمَ يُدَيَ شَ تَايٍ كَنَدٍ،</para>
  <para style="q" vid="JER 10:22">عٍ شَ قِندِ وُلَءِ بَرٍيٍ شْنيِ رَ.<verse eid="JER 10:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JER 10:23"/>عَلَتَلَ، ﭑ عَ كٌلٌن عَدَ مَدِ مُ قٍقٍ رَفِرِ مَ،</para>
  <para style="q" vid="JER 10:23">عَ مُ عَ يّتّ رَحّرّ مَ دُنِحّءِفِرِ كُي.<verse eid="JER 10:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JER 10:24"/>عَلَتَلَ، ﭑ مَتِنشِن عِ شَ سّرِيّ رَ،</para>
  <para style="q" vid="JER 10:24">كْنْ عِ نَشَ شْنْ ﭑ مَ، شَ نَ مُ عَ رَ ﭑ قَشَمَ نّ.<verse eid="JER 10:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JER 10:25"/>عِ شَ شْنْ سِ فبّتّيٍ نَن مَ نَشٍيٍ مُ عِ كٌلٌن،</para>
  <para style="q" vid="JER 10:25">عِ شَ شْنْ حَمَيٍ نَن مَ نَشٍيٍ مُ عِ شِلِ قَلَمَ،</para>
  <para style="q" vid="JER 10:25">بَرِ مَ عٍ وَ مَ يَشُبَ بْنسْي نَن قَشَقٍ،</para>
  <para style="q" vid="JER 10:25">عٍ وَ مَ عٍ شُن نَكَنَقٍ نّ، عٍ شَ عٍ سْنتْ،</para>
  <para style="q" vid="JER 10:25">عٍ وَ عٍ شْنيِ شَ قِندِ فبَلٌي يِرٍ رَ.»<verse eid="JER 10:25"/></para>
  <chapter eid="JER 10"/>
  <chapter number="11" style="c" sid="JER 11"/>
  <para style="s">عَلَتَلَ شَ سَاتّ كَنَقٍ</para>
  <para style="sp">عَلَتَلَ شَ مَسٍنيِ</para>
  <para style="q">
    <verse number="1" style="v" sid="JER 11:1"/>عَلَتَلَ نَشَ يِ مَسٍنيِ تِ عَننَبِ يٍرٍ مِ بّ،<verse eid="JER 11:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JER 11:2"/>«عَ قَلَ يُدَيَكَيٍ نُن دَرِ سَلَمُكَيٍ بّ،</para>
  <para style="q" vid="JER 11:2">‹وٌ وٌ تُلِ مَتِ يِ سَاتّ رَ.<verse eid="JER 11:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JER 11:3"/>عِسِرَيِلَ مَرِفِ عَلَ بَرَ عَ مَسٍن،</para>
  <para style="q" vid="JER 11:3">دَنكّ نَ تُلِ شْرِ بّ نَشَن مُ يِ سَاتّ رَ مّمَ،<verse eid="JER 11:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JER 11:4"/>سَاتّ ﭑ نَشَن مَسٍنشِ وٌ بَبَيٍ بّ</para>
  <para style="q" vid="JER 11:4">عٍ مِنِ لْشْي كٍلِقٍ رَ مِسِرَ بْشِ مَ.</para>
  <para style="q" vid="JER 11:4">عٍ تٌ كٍلِ نَا قٍ شْرْشْي كُي،</para>
  <para style="q" vid="JER 11:4">ﭑ نَشَ عَ قَلَ عٍ بّ،</para>
  <para style="q" vid="JER 11:4">وٌ شَ وٌ تُلِ مَتِ ﭑ نَ،</para>
  <para style="q" vid="JER 11:4">وٌ شَ ﭑ مَ يَامَرِ رَبَتُ.</para>
  <para style="q" vid="JER 11:4">نَ كُي وٌ قِندِ مَ نّ ﭑ مَ حَمَ رَ،</para>
  <para style="q" vid="JER 11:4">ﭑ قَن قِندِ وٌ مَرِفِ عَلَ رَ.<verse eid="JER 11:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JER 11:5"/>ﭑ نَ ﭑ كَلِ وٌ بَبَيٍ بّ نَشَن نَ،</para>
  <para style="q" vid="JER 11:5">بْشِ قَنيِ قِقٍ رَ وٌ مَ شِحّ نُن كُمِ نَ دّننَشّ،</para>
  <para style="q" vid="JER 11:5">ﭑ بَرَ نَ رَكَمَلِ تٌ لْشْي.</para>
  <para style="q" vid="JER 11:5">وٌ نَ نَ بْشِ نَن مَ تٌ.›»</para>
  <para style="sp" vid="JER 11:5">عَننَبِ يٍرٍ مِ شَ مَسٍنيِ</para>
  <para style="q" vid="JER 11:5">ﭑ نَشَ عَ يَابِ، «عَمِنَ مَرِفِ عَلَتَلَ.»<verse eid="JER 11:5"/></para>
  <para style="sp">عَلَتَلَ شَ مَسٍنيِ</para>
  <para style="q">
    <verse number="6" style="v" sid="JER 11:6"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ،</para>
  <para style="q" vid="JER 11:6">«يِ مَسٍنيِ تِ عِ شُي عِتٍشِ رَ يُدَيَ تَايٍ كُي،</para>
  <para style="q" vid="JER 11:6">عَ نُن دَرِ سَلَمُ كِرَيٍ شْن مَ.</para>
  <para style="q" vid="JER 11:6">عَ قَلَ، ‹وٌ وٌ تُلِ مَتِ يِ سَاتّ رَ، وٌ شَ عَ رَبَتُ.<verse eid="JER 11:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JER 11:7"/>كَبِ ﭑ نَشَ وٌ بَبَيٍ رَ مِنِ مِسِرَ بْشِ رَ،</para>
  <para style="q" vid="JER 11:7">ﭑ بَرَ عٍ يَامَرِ، عٍ شَ عٍ تُلِ مَتِ ﭑ نَ.›<verse eid="JER 11:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 11:8"/>كْنْ عٍ مُ تِن ﭑ شُي رَ مّدٍ.</para>
  <para style="q" vid="JER 11:8">كَنكَن بَرَ بِرَ عَ بْحّ حَاشِ قْشْ رَ.</para>
  <para style="q" vid="JER 11:8">نَ نَن عَ رَ ﭑ قَمَ ﭑ مَ سَاتّ رَكَمَلِدٍ،</para>
  <para style="q" vid="JER 11:8">ﭑ عٍ يَمَرِشِ نَشَن نَ، عٍ نَشَن مَتَندِشِ.»<verse eid="JER 11:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="JER 11:9"/>عَلَتَلَ بَرَ عَ مَسٍن ﭑ بّ،</para>
  <para style="q" vid="JER 11:9">«يُدَيَكَيٍ نُن دَرِ سَلَمُكَيٍ وَ مَ ﭑ يَنقَقٍ.<verse eid="JER 11:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JER 11:10"/>عٍ بَرَ عٍ بَبَيٍ شَ حّرّ كِ حَاشُحَ تٌنفٌ،</para>
  <para style="q" vid="JER 11:10">عٍ تٌندِ ﭑ مَ مَسٍنيِ رَ،</para>
  <para style="q" vid="JER 11:10">عٍ قَ بِرَ عَلَ فبّتّيٍ قْشْ رَ، عٍ عٍ بَتُ.</para>
  <para style="q" vid="JER 11:10">عِسِرَيِلَ بْنسْي نُن يُدَ بْنسْي بَرَ ﭑ مَ سَاتّ مَتَندِ،</para>
  <para style="q" vid="JER 11:10">ﭑ نَشَن تٌنفٌ عٍ بَبَيٍ بّ.<verse eid="JER 11:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JER 11:11"/>نَ كُي عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 11:11">‹ﭑ قَمَ نّ عٍ حَشَنكَتَدٍ هَن عٍ مُ نْ مِنِدٍ.</para>
  <para style="q" vid="JER 11:11">عٍ قَمَ نّ عٍ مَوَدٍ ﭑ بّ، كْنْ ﭑ مُ عٍ شُي سُشُمَ.<verse eid="JER 11:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JER 11:12"/>يُدَيَ شَ تَايٍ نُن دَرِ سَلَمُكَيٍ قَمَ نّ عَلَ فبّتّ مَشَندِدٍ،</para>
  <para style="q" vid="JER 11:12">عٍ سُرَيِ بَ سّرّشّ رَ نَشٍيٍ بّ.</para>
  <para style="q" vid="JER 11:12">كْنْ نَ كُيٍيٍ مُ قَمَ عٍ رَكِسِدٍ عٍ شَ تْورّ كُي.<verse eid="JER 11:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JER 11:13"/>يُدَيَكَيٍ، وٌ كُيٍيٍ بَتُمَ وٌ شَ تَايٍ كُي.</para>
  <para style="q" vid="JER 11:13">نَ سّرّشّبَدٍيٍ قِندِشِ يَافِ نَن نَ وٌ بّ.</para>
  <para style="q" vid="JER 11:13">دَرِ سَلَمُكَيٍ، كُيٍ سّرّشّبَدٍ نَ وٌ شَ كِرَ بِرِن شْن مَ،</para>
  <para style="q" vid="JER 11:13">وٌ سُرَيِ بَمَ سّرّشّ رَ بَلِ كُيٍ بّ دّننَشّ.›<verse eid="JER 11:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JER 11:14"/>عِ نَشَ دُبَ يِ حَمَ بّ،</para>
  <para style="q" vid="JER 11:14">عِ نَشَ عِ مَوَ ﭑ تَن عَلَ بّ، عِ نَشَ ﭑ مَشَندِ،</para>
  <para style="q" vid="JER 11:14">بَرِ مَ ﭑ مُ عٍ وَ شُي سُشُمَ.»<verse eid="JER 11:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="JER 11:15"/>«مُنقٍ رَ ﭑ شَنُنتٍنيِ قَمَ ﭑ مَ بَنشِ كُي،</para>
  <para style="q" vid="JER 11:15">عَ لُ قٍ كٌبِ رَبَ رَ تّمُي بِرِن؟</para>
  <para style="q" vid="JER 11:15">وٌ عَ مَحْشُنشِ نّ وٌ شَ سّرّشّيٍ نْمَ وٌ رَكِسِدٍ،</para>
  <para style="q" vid="JER 11:15">هَلِ قٍ حَاشِ تٌ قَ رَقَن وٌ مَ؟<verse eid="JER 11:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 11:16"/>عَلَتَلَ نُ بَرَ وٌ شِلِ</para>
  <para style="q" vid="JER 11:16">‹عٌلِوِ وُرِ شِندٍ، نَشَن بٌفِ تٌقَن.›</para>
  <para style="q" vid="JER 11:16">كْنْ يَكْسِ وٌ قَمَ نّ فبٍلٍفبٍلٍدٍ</para>
  <para style="q" vid="JER 11:16">بَرِ مَ تّ سَمَ نّ وٌ سَلٌنيِيٍ مَ.<verse eid="JER 11:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 11:17"/>مَنفّ عَلَتَلَ نَشَن وٌ تِشِ،</para>
  <para style="q" vid="JER 11:17">عَ بَرَ يَامَرِ قِ وٌ شَ حَشَنكَتَ</para>
  <para style="q" vid="JER 11:17">عِسِرَيِلَ بْنسْي نُن يُدَيَ بْنسْي شَ يُنُبِ شَ قٍ رَ.</para>
  <para style="q" vid="JER 11:17">عٍ بَرَ ﭑ نَشْنْ عٍ شَ سّرّشّيٍ رَ،</para>
  <para style="q" vid="JER 11:17">عٍ نَشٍيٍ بَشِ بَلِ كُيٍ بّ.»<verse eid="JER 11:17"/></para>
  <para style="sp">عَننَبِ يٍرٍ مِ شَ مَسٍنيِ</para>
  <para style="q">
    <verse number="18" style="v" sid="JER 11:18"/>«عَلَتَلَ بَرَ عٍ وَشْنقٍ مَسٍن ﭑ بّ.</para>
  <para style="q" vid="JER 11:18">ﭑ بَرَ عَ كٌلٌن عٍ نُ وَ مَ نَشَن نَبَقٍ ﭑ نَ.<verse eid="JER 11:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JER 11:19"/>ﭑ نُ لُشِ نّ عَلْ يّشّييْرّ عٍ نَشَن شَنِنمَ عَ قَشَدٍ.</para>
  <para style="q" vid="JER 11:19">ﭑ مُ نُ عَ كٌلٌن عٍ نُ وَ مَ نَشَن نَبَقٍ ﭑ نَ.</para>
  <para style="q" vid="JER 11:19">عٍ نُ بَرَ عَ قَلَ ﭑ مَ قٍ رَ،</para>
  <para style="q" vid="JER 11:19">‹وٌن شَ يِ وُرِ بِلِ نُن عَ بٌفِ كَنَ.</para>
  <para style="q" vid="JER 11:19">وٌن شَ عَ نِي بَ دُنِحَ بّندّ قُحِ قَرِ،</para>
  <para style="q" vid="JER 11:19">عَلَكٌ مِشِ يٌ نَشَ رَتُ عَ شِلِ مَ.›<verse eid="JER 11:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 11:20"/>كْنْ مَنفّ عَلَتَلَ قِندِشِ كِيتِسَ تِنشِنشِ نَن نَ،</para>
  <para style="q" vid="JER 11:20">نَشَن مِشِ بْحّ نُن عَ سٌندٌنيِ مَ قٍ كٌلٌن.</para>
  <para style="q" vid="JER 11:20">ﭑ نَ ﭑ فبٍحْشْقٍ لُشِ عِ تَن نَن مَ،</para>
  <para style="q" vid="JER 11:20">بَرِ مَ ﭑ شَشِلِ تِشِ عِ تَن نَن نَ.<verse eid="JER 11:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JER 11:21"/>نَ نَن عَ رَ عَلَتَلَ بَرَ نَتّ تٌنفٌ عَنَتْتِكَيٍ شَ قٍ رَ،</para>
  <para style="q" vid="JER 11:21">نَشٍيٍ وَ مَ ﭑ قَشَقٍ، نَشٍيٍ ﭑ يَمَرِ،</para>
  <para style="q" vid="JER 11:21">‹عِ نَشَ نَمِحْنمّ مَسٍنيِ تِ عَلَتَلَ شِلِ رَ،</para>
  <para style="q" vid="JER 11:21">شَ نَ مُ عَ رَ مُشُ عِ قَشَمَ نّ.›<verse eid="JER 11:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JER 11:22"/>مَنفّ عَلَتَلَ بَرَ عَ مَسٍن،</para>
  <para style="q" vid="JER 11:22">‹ﭑ عٍ حَشَنكَتَمَ نّ.</para>
  <para style="q" vid="JER 11:22">عٍ شَ قٌنِكٍيٍ قَمَ نّ قَشَدٍ سَنتِدّفّمَ رَ،</para>
  <para style="q" vid="JER 11:22">عٍ شَ دِيٍ قَشَ كَامّ رَ.<verse eid="JER 11:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JER 11:23"/>عٍ شَ مِشِ يٌ مُ لُمَ دُنِحَ مَ،</para>
  <para style="q" vid="JER 11:23">بَرِ مَ ﭑ قَ تّمُي ﭑ عَنَتْتِكَيٍ هَلَكِمَ نّ.›»<verse eid="JER 11:23"/></para>
  <chapter eid="JER 11"/>
  <chapter number="12" style="c" sid="JER 12"/>
  <para style="s">عَلَ شَ نَتّيٍ مِشِ حَاشِيٍ شَ قٍ رَ</para>
  <para style="sp">عَننَبِ يٍرٍ مِ شَ مَسٍنيِ عَلَتَلَ بّ</para>
  <para style="q">
    <verse number="1" style="v" sid="JER 12:1"/>«عَلَتَلَ، عِ تِنشِن،</para>
  <para style="q" vid="JER 12:1">كْنْ ﭑ وَ مَ عِ مَشْرِنقٍ عِ شَ نَتّ ندٍ شَ قٍ رَ.</para>
  <para style="q" vid="JER 12:1">مُنقٍ رَ مِشِ حَاشِيٍ شَ قٍ لُمَ سْونّيَ رَ؟</para>
  <para style="q" vid="JER 12:1">مُنقٍ رَ بْحّسَ نَ يَنقَنتٍيٍ بّ؟<verse eid="JER 12:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JER 12:2"/>عِ تَن نَن عٍ دَاشِ، عِ تَن نَن عٍ بَلٌشِ.</para>
  <para style="q" vid="JER 12:2">عٍ سِفَمَ يَرٍ، عٍ قٍ رَبَمَ عٍ شَ دُنِحّءِفِرِ كُي.</para>
  <para style="q" vid="JER 12:2">عٍ عِ شِلِ قَلَمَ عٍ دّ رَ،</para>
  <para style="q" vid="JER 12:2">كْنْ عِ شَ قٍ مُ نَ عٍ بْحّ كُي.<verse eid="JER 12:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JER 12:3"/>عَلَتَلَ، عِ ﭑ سٌندٌنيِ مَ قٍ كٌلٌن.</para>
  <para style="q" vid="JER 12:3">عِ شَ نَتّ تٌنفٌ مِشِ حَاشِيٍ قَشَقٍ رَ،</para>
  <para style="q" vid="JER 12:3">عَلْ يّشّي نَشٍيٍ شَنِنمَ عٍ كْن نَشَبَ يِرٍ.<verse eid="JER 12:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JER 12:4"/>بْشِ لُمَ سُننُنيِ كُي هَن مُن لْشْي؟</para>
  <para style="q" vid="JER 12:4">تُنّ تٌندِ مَ قَدٍ هَن مُن تّمُي؟</para>
  <para style="q" vid="JER 12:4">سُبٍيٍ نُن شْنِيٍ نَ قَشَقٍ مِشِ شَ حَاشُحَ سَابُي رَ،</para>
  <para style="q" vid="JER 12:4">بَرِ مَ عٍ نَشّ، ‹عَلَ مُ مُشُ تٌمَ.›»<verse eid="JER 12:4"/></para>
  <para style="sp">عَلَتَلَ شَ مَسٍنيِ عَننَبِ يٍرٍ مِ بّ</para>
  <para style="q">
    <verse number="5" style="v" sid="JER 12:5"/>«شَ عِ تَفَن عِ فِدٍ عَدَ مَدِيٍ يَ مَ،</para>
  <para style="q" vid="JER 12:5">عِ قَ عِ فِمَ دِ سٌي يَ مَ؟</para>
  <para style="q" vid="JER 12:5">شَ عِ بِرَ تَا كُي، عِ حّرّ مَ يُرُدّن وُلَ كُي دِ؟<verse eid="JER 12:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JER 12:6"/>عِ نفَشَكٍرٍنيِ نَشٍيٍ كٍلِشِ عِ بَبَ شْنيِ،</para>
  <para style="q" vid="JER 12:6">عٍ قَمَ نّ عِ يَنقَدٍ، عٍ سْنشْي رَتٍ عِ مَ.</para>
  <para style="q" vid="JER 12:6">عِ نَشَ لَ عٍ شَ وْيّن حْشُنمّ رَ.<verse eid="JER 12:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JER 12:7"/>ﭑ نَن ﭑ مَ بَنشِ بّحِنمَ نّ،</para>
  <para style="q" vid="JER 12:7">ﭑ نَن ﭑ مَ حَمَ رَبٌلٌمَ نّ،</para>
  <para style="q" vid="JER 12:7">ﭑ شَنُنتٍنيِيٍ قِ عٍ يَشُييٍ مَ.<verse eid="JER 12:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 12:8"/>ﭑ نَ رَبَمَ نّ بَرِ مَ ﭑ مَ حَمَ بَرَ لُ</para>
  <para style="q" vid="JER 12:8">عَلْ يّتّ شَاحّ وُلَءِ.</para>
  <para style="q" vid="JER 12:8">ﭑ بَرَ عٍ شْن.<verse eid="JER 12:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JER 12:9"/>ﭑ مَ حَمَ بَرَ لُ</para>
  <para style="q" vid="JER 12:9">عَلْ شْنِ مَشْنْشِ سّفّيٍ بِرَ مَ نَشَن قْشْ رَ.</para>
  <para style="q" vid="JER 12:9">‹وُلَءِ سُبٍيٍ، وٌ شَ قَ ﭑ مَ حَمَ سْنتْدٍ.›<verse eid="JER 12:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JER 12:10"/>شُرُ سٍ دّ مَدٌنيِيٍ بَرَ ﭑ مَ لَاكْي كَنَ،</para>
  <para style="q" vid="JER 12:10">عٍ ﭑ مَ شّ قَنيِ مَبٌرٌن، عَ قِندِ يِرٍ شَرَشِ رَ.<verse eid="JER 12:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JER 12:11"/>ﭑ مَ بْشِ بَرَ قِندِ فبَلٌي يِرٍ رَ.</para>
  <para style="q" vid="JER 12:11">عَ نَ سُننُنيِ كُي ﭑ يَ شْرِ،</para>
  <para style="q" vid="JER 12:11">سٍسٍ مُ قَنمَ مّننِ، مِشِ يٌ مُ كِنِكِنِمَ عَ مَ.<verse eid="JER 12:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JER 12:12"/>سْورِ حَاشِيٍ نَ قَقٍ كٍلِقٍ فبٍنفبٍرٍن يِرٍ،</para>
  <para style="q" vid="JER 12:12">بَرِ مَ عَلَتَلَ بَرَ عَ رَفِرِ سَنتِدّفّمَ شَ بْشِ بِرِن لِ،</para>
  <para style="q" vid="JER 12:12">مِشِ يٌ نَشَ لُ بْحّسَ كُي.<verse eid="JER 12:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JER 12:13"/>عٍ بَرَ سَنسِ شْرِ سِ،</para>
  <para style="q" vid="JER 12:13">كْنْ عٍ تُنبٍ فبَنسَن نَن سْتْمَ.</para>
  <para style="q" vid="JER 12:13">عٍ عٍ يّتّ رَتَفَنمَ نّ قُقَقُ.</para>
  <para style="q" vid="JER 12:13">عَلَتَلَ بَرَ شْنْ وٌ مَ،</para>
  <para style="q" vid="JER 12:13">نَ بِرِن شَ قِندِ يَافِ رَ وٌ بّ.»<verse eid="JER 12:13"/></para>
  <para style="sp">عَلَتَلَ شَ مَسٍنيِ عِسِرَيِلَ يَشُييٍ بّ</para>
  <para style="q">
    <verse number="14" style="v" sid="JER 12:14"/>عَلَتَلَ بَرَ عَ مَسٍن،</para>
  <para style="q" vid="JER 12:14">«سِ نَشٍيٍ سَبَتِشِ عِسِرَيِلَ رَبِلِنيِ،</para>
  <para style="q" vid="JER 12:14">سِ نَشٍيٍ ﭑ مَ عِسِرَيِلَ حَمَ شَ بْشِ شُن نَكَنَمَ،</para>
  <para style="q" vid="JER 12:14">ﭑ نَشَن قِشِ عٍ مَ،</para>
  <para style="q" vid="JER 12:14">وٌ شَ عَ كٌلٌن ﭑ قَمَ نّ وٌ قَن كٍرِدٍ وٌ شْنيِ،</para>
  <para style="q" vid="JER 12:14">ﭑ قَ ﭑ مَ حَمَ بَ وٌ يِ رَ.<verse eid="JER 12:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 12:15"/>ﭑ نَ فّ عٍ بَدٍ وٌ يِ رَ،</para>
  <para style="q" vid="JER 12:15">ﭑ مَن كِنِكِنِمَ نّ عٍ مَ،</para>
  <para style="q" vid="JER 12:15">ﭑ قَ عٍ رَفبِلٍن عٍ شَ بْشِ مَ نَشَن قِندِشِ عٍ كّ رَ.<verse eid="JER 12:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 12:16"/>شَ نَ سِيٍ ﭑ مَ حَمَ شَ سّرِيّ مَتِنكَن،</para>
  <para style="q" vid="JER 12:16">عٍ قَ عٍ رَكَلِ ﭑ شِلِ رَ، ‹عَلَتَلَ حِحّ،›</para>
  <para style="q" vid="JER 12:16">ﭑ عٍ رَ سٌمَ نّ ﭑ مَ حَمَ يَ مَ.</para>
  <para style="q" vid="JER 12:16">عٍ نُ بَرَ ﭑ مَ حَمَ مَتِنكَن عٍ كَلِدٍ بَلِ شِلِ رَ،</para>
  <para style="q" vid="JER 12:16">ﭑ مَ حَمَ قَن نْمَ نّ عٍ مَتِنكَندٍ كَلِ رَ ﭑ شِلِ رَ.<verse eid="JER 12:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 12:17"/>كْنْ شَ عَ سَ لِ نَ سِيٍ مُ عٍ تُلِ مَتِ ﭑ مَ مَسٍنيِ رَ،</para>
  <para style="q" vid="JER 12:17">ﭑ عٍ شُن نَكَنَمَ نّ، ﭑ قَ عٍ سْنتْ.»</para>
  <para style="q" vid="JER 12:17">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="JER 12:17"/></para>
  <chapter eid="JER 12"/>
  <chapter number="13" style="c" sid="JER 13"/>
  <para style="s">عَننَبِ يٍرٍ مِ شَ بّلّتِ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 13:1"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، «سَ بّلّتِ دُفِ دَاشِ سَرَ، عِ تَفِ شِرِ. عِ نَشَ عَ بُندَ يٍ رَ.» <verse eid="JER 13:1"/><verse number="2" style="v" sid="JER 13:2"/>ﭑ نَشَ سِفَ بّلّتِ سَرَدٍ عَلْ عَلَتَلَ عَ قَلَ ﭑ بّ كِ نَشّ. ﭑ نَشَ ﭑ تَفِ شِرِ.<verse eid="JER 13:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 13:3"/>نَ دَنفِ شَنبِ، عَلَتَلَ مَن نَشَ عَ مَسٍن ﭑ بّ، <verse eid="JER 13:3"/><verse number="4" style="v" sid="JER 13:4"/>«بّلّتِ تٌنفٌ عِ نَشَن سَرَشِ، عِ نَشَن شِرِشِ عِ تَفِ. كٍلِ، عِ سِفَ عٍقِرَتِ شُرٍ مَبِرِ. مّننِ عِ شَ نَ بّلّتِ نْشُن فّمّ لٌنفٌرِ رَ.» <verse eid="JER 13:4"/><verse number="5" style="v" sid="JER 13:5"/>ﭑ نَشَ سِفَ، ﭑ نَشَ بّلّتِ نْشُن عٍقِرَتِ مَبِرِ عَلْ عَلَتَلَ عَ مَسٍنشِ ﭑ بّ كِ نَشّ.<verse eid="JER 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 13:6"/>كِكٍ وُيَشِ دَنفِ شَنبِ، عَلَتَلَ مَن نَشَ عَ مَسٍن ﭑ بّ، «كٍلِ، عِ سِفَ عٍقِرَتِ عِ بّلّتِ تٌنفٌ عِ نَشَن نْشُنشِ.» <verse eid="JER 13:6"/><verse number="7" style="v" sid="JER 13:7"/>ﭑ نَشَ سِفَ عٍقِرَتِ شُرٍ بّلّتِ نْشُنشِ تٌنفٌدٍ. ﭑ نَشَ عَ تٌ عَ بَرَ نُ بْرْ، ﭑ مُ نْمَ عَ رَوَلِدٍ سْنْن.<verse eid="JER 13:7"/></para>
  <para style="sp">عَلَتَلَ شَ مَسٍنيِ</para>
  <para style="q">
    <verse number="8" style="v" sid="JER 13:8"/>عَلَتَلَ نَشَ يِ مَسٍنيِ تِ ﭑ بّ،<verse eid="JER 13:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JER 13:9"/>«عَلَتَلَ بَرَ عَ مَسٍن،</para>
  <para style="q" vid="JER 13:9">عَ نَ نَ كِ نّ يُدَيَ نُن دَرِ سَلَمُ شَ يّتّ عِفبٌحَ شَ قٍ رَ.<verse eid="JER 13:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JER 13:10"/>حَمَ حَاشِ نَن عٍ رَ نَشَن تٌندِ ﭑ مَ مَسٍنيِ سُشُدٍ،</para>
  <para style="q" vid="JER 13:10">نَشَن بْحّ شْرْشْ،</para>
  <para style="q" vid="JER 13:10">عٍ بِرَ مَ عَلَ فبّتّيٍ نَن قْشْ رَ، عٍ تُوبِ عٍ بّ.</para>
  <para style="q" vid="JER 13:10">عٍ قَمَ نّ لُدٍ عَلْ نَ بّلّتِ</para>
  <para style="q" vid="JER 13:10">نَشَن كَنَشِ، نَشَن مُ قَنشِ سْنْن.»<verse eid="JER 13:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="JER 13:11"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 13:11">«ﭑ نُ بَرَ عِسِرَيِلَ نُن يُدَيَ بْنسْي شِرِ ﭑ تَفِ،</para>
  <para style="q" vid="JER 13:11">عَلْ مِشِ بّلّتِ شِرِ مَ عَ تَفِ كِ نَشّ.</para>
  <para style="q" vid="JER 13:11">ﭑ نُ وَ مَ نّ عٍ شَ قِندِ ﭑ مَ حَمَ رَ،</para>
  <para style="q" vid="JER 13:11">عٍ شَ قٍ شَ قِندِ بِنيّ نُن مَتْشْي رَ ﭑ بّ،</para>
  <para style="q" vid="JER 13:11">كْنْ عٍ مُ تِن ﭑ مَ مَسٍنيِ رَ.»<verse eid="JER 13:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="JER 13:12"/>«نَ كُي عِ شَ عَ قَلَ عٍ بّ،</para>
  <para style="q" vid="JER 13:12">عِسِرَيِلَ مَرِفِ عَلَتَلَ بَرَ عَ مَسٍن،</para>
  <para style="q" vid="JER 13:12">‹وّنِ قّحّ بِرِن نَقٍ وّنِ رَ.›</para>
  <para style="q" vid="JER 13:12">عٍ قَمَ نّ عِ يَابِدٍ،</para>
  <para style="q" vid="JER 13:12">‹مُشُ عَ كٌلٌن عَ لَنمَ وّنِ قّحّ شَ رَقٍ وّنِ رَ.›<verse eid="JER 13:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JER 13:13"/>عِ مَن شَ عٍ يَابِ،</para>
  <para style="q" vid="JER 13:13">عَلَتَلَ بَرَ عَ مَسٍن،</para>
  <para style="q" vid="JER 13:13">‹مَنفّ بِرِن نَشٍيٍ نَ دَوُدَ شَ كِبَنيِ كُي،</para>
  <para style="q" vid="JER 13:13">عَ نُن سّرّشّدُبّيٍ، نُن نَمِحْنمّيٍ، نُن دَرِ سَلَمُكَيٍ،</para>
  <para style="q" vid="JER 13:13">ﭑ قَمَ نّ عٍ بِرِن لُدٍ عَلْ سِيسِلَيٍ.›»<verse eid="JER 13:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="JER 13:14"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 13:14">«ﭑ قَمَ نّ فٍرٍ سٌدٍ حَمَ يَ مَ،</para>
  <para style="q" vid="JER 13:14">ﭑ دِيٍ نُن عٍ بَبَيٍ تَفِ عِسٌ.</para>
  <para style="q" vid="JER 13:14">ﭑ مُ كِنِكِنِمَ، ﭑ مُ دِحّمَ.</para>
  <para style="q" vid="JER 13:14">ﭑ قَمَ نّ عٍ بِرِن شُن نَكَنَدٍ.<verse eid="JER 13:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 13:15"/>وٌ شَ وٌ تُلِ مَتِ ﭑ نَ،</para>
  <para style="q" vid="JER 13:15">وٌ نَشَ وٌ يّتّ عِفبٌ،</para>
  <para style="q" vid="JER 13:15">بَرِ مَ عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="JER 13:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 13:16"/>وٌ شَ وٌ مَرِفِ عَلَتَلَ مَتْشْ،</para>
  <para style="q" vid="JER 13:16">بٍينُ عَ شَ دِ مِ رَ سِن بْشِ مَ،</para>
  <para style="q" vid="JER 13:16">بٍينُ وٌ شَ بِرَ فٍيَيٍ قَرِ كْي رَ.</para>
  <para style="q" vid="JER 13:16">وٌ وَ مَ نَءِيَلَنيِ شْن مَ،</para>
  <para style="q" vid="JER 13:16">كْنْ عَلَتَلَ دِ مِ حَاشِ نَن نَفٌرٌ مَ وٌ مَ.</para>
  <para style="q" vid="JER 13:16">عَ لُشِ نّ عَلْ نُشُي نَشَن قْورْشِ</para>
  <para style="q" vid="JER 13:16">عَ قِندِ قَشّ رَ وٌ بّ.<verse eid="JER 13:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 13:17"/>شَ وٌ مُ وٌ تُلِ مَتِمَ يِ مَسٍنيِ رَ،</para>
  <para style="q" vid="JER 13:17">ﭑ قَمَ نّ وَدٍ ﭑ كٍرٍنيِ مَ وٌ شَ يّتّ عِفبٌحَ شَ قٍ رَ.</para>
  <para style="q" vid="JER 13:17">يَ يٍ قَمَ نّ مِنِدٍ ﭑ يَيٍ رَ،</para>
  <para style="q" vid="JER 13:17">بَرِ مَ عَلَتَلَ شَ حَمَ بَرَ شَنِن كٌنيِيَ كُي.»<verse eid="JER 13:17"/></para>
  <para style="sp">عَلَتَلَ شَ مَسٍنيِ عَننَبِ يٍرٍ مِ بّ</para>
  <para style="q">
    <verse number="18" style="v" sid="JER 13:18"/>«عَ قَلَ مَنفّ نُن عَ شَ فِنّ بّ،</para>
  <para style="q" vid="JER 13:18">وٌ فٌرٌ بْشِ مَ،</para>
  <para style="q" vid="JER 13:18">بَرِ مَ مَنفّيَ بَرَ بَ وٌ يِ رَ.</para>
  <para style="q" vid="JER 13:18">مَنفّ تْنشُمَ مُ لُمَ وٌ شُن مَ سْنْن.<verse eid="JER 13:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JER 13:19"/>نٍفٍوِ شَ تَايٍ بَلَنشِ،</para>
  <para style="q" vid="JER 13:19">مِشِ يٌ مُ نْمَ عٍ نَادّيٍ رَبِدٍ.</para>
  <para style="q" vid="JER 13:19">يُدَيَ بْنسْي بِرِن بَرَ شَنِن حَمَنّ مَ.<verse eid="JER 13:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 13:20"/>وٌ عَ مَتٌ، حَمَ ندٍ نَ قَقٍ كٍلِقٍ كْولَ مَ.</para>
  <para style="q" vid="JER 13:20">حَمَ نَ مِندٍن، ﭑ نَشَن تَشُشِ عِ رَ،</para>
  <para style="q" vid="JER 13:20">نَشٍيٍ لُشِ عَلْ عِ شَ شُرُ سٍيٍ فَلِ عِ حّلّشِنشِ نَشٍيٍ رَ؟<verse eid="JER 13:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JER 13:21"/>وٌ مُنسٍ قَلَمَ</para>
  <para style="q" vid="JER 13:21">وٌ دّقَنبٌورٍيٍ تِمَ وٌ شُن مَ تّمُي نَشّ يَنقَنتٍيَ رَ؟</para>
  <para style="q" vid="JER 13:21">نَ تْورّ مُ لُمَ شّ عَلْ دِ بَرِ شَ تْورّ؟<verse eid="JER 13:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JER 13:22"/>شَ وٌ وٌ يّتّ مَشْرِن،</para>
  <para style="q" vid="JER 13:22">مُنقٍ رَ يِ بَرَ مُشُ لِ،</para>
  <para style="q" vid="JER 13:22">وٌ شَ عَ كٌلٌن وٌ يَافِ نُن قٍ حَاشِ سْتْمَ نّ</para>
  <para style="q" vid="JER 13:22">وٌ شَ يُنُبِ وُيَشِ شَ قٍ رَ.<verse eid="JER 13:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JER 13:23"/>مِشِ قْورّ كِرِ نْمَ قِيشّدٍ؟</para>
  <para style="q" vid="JER 13:23">بَرَتّ شَ مَكَتُنيِ نْمَ مَسَرَدٍ؟</para>
  <para style="q" vid="JER 13:23">وٌ تَن فٌ، وٌ تَن نَشٍيٍ دَرِشِ قٍ حَاشِ رَ؟</para>
  <para style="q" vid="JER 13:23">وٌ نْمَ لُدٍ كِرَ قَنيِ شْن مَ؟<verse eid="JER 13:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JER 13:24"/>ﭑ قَمَ نّ وٌ رَيٍنسٍندٍ</para>
  <para style="q" vid="JER 13:24">عَلْ مَالٍ لَفِ نَشَن لْيمَ فبٍنفبٍرٍنيِ قٌيٍ كُي.»<verse eid="JER 13:24"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="25" style="v" sid="JER 13:25"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 13:25">«ﭑ بَرَ نَ حَشَنكَتّ مْولِ نَتّ وٌ بّ،</para>
  <para style="q" vid="JER 13:25">بَرِ مَ وٌ بَرَ نّيمُ ﭑ مَ،</para>
  <para style="q" vid="JER 13:25">وٌ بَرَ لَ وُلٍ رَ.<verse eid="JER 13:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JER 13:26"/>ﭑ قَمَ نّ وٌ رَيَافِدٍ عَ حَاشِ رَ.<verse eid="JER 13:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="JER 13:27"/>ﭑ بَرَ وٌ شَ يّنّ نُن وٌ شَ لَنفٌيحَ تٌ،</para>
  <para style="q" vid="JER 13:27">وٌ بِرَ مَ نَشَن قْشْ رَ فٍيَيٍ قَرِ نُن دَاشَيٍ كُي.</para>
  <para style="q" vid="JER 13:27">ﭑ بَرَ وٌ شَ قٍ حَاشِيٍ تٌ.</para>
  <para style="q" vid="JER 13:27">حَشَنكَتّ نَ وٌ بّ دَرِ سَلَمُكَ سّنِيّنتَرٍيٍ.</para>
  <para style="q" vid="JER 13:27">وٌ لُمَ نَ كِرَ شْن مَ هَن مُن تّمُي؟»<verse eid="JER 13:27"/></para>
  <chapter eid="JER 13"/>
  <chapter number="14" style="c" sid="JER 14"/>
  <para style="s">كَامّ رَفٌرٌقٍ عِسِرَيِلَ بْشِ مَ</para>
  <para style="sp">عَلَتَلَ شَ مَسٍنيِ</para>
  <para style="q">
    <verse number="1" style="v" sid="JER 14:1"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ</para>
  <para style="q" vid="JER 14:1">عَ نَشَن تِشِ عَننَبِ يٍرٍ مِ بّ،</para>
  <para style="q" vid="JER 14:1">كَامّ تٌ سِن عِسِرَيِلَ بْشِ مَ.<verse eid="JER 14:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JER 14:2"/>«يُدَيَ نَ سُننُنيِ كُي،</para>
  <para style="q" vid="JER 14:2">عَ شَ تَا كَنَشِيٍ نَ فبٍلٍفبٍلٍقٍ بْشِ مَ.<verse eid="JER 14:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JER 14:3"/>دٍنبَيَ كَنيِيٍ عٍ شَ وَلِكّيٍ شّيمَ يٍ قٍندٍ،</para>
  <para style="q" vid="JER 14:3">كْنْ يٍ مُ نَ كْلْنيِيٍ كُي،</para>
  <para style="q" vid="JER 14:3">عٍ قَ فبِلٍن قّحّ عِفٍلِشِ رَ.</para>
  <para style="q" vid="JER 14:3">عٍ سُننُن دٌنمَ رَفٌرٌ مَ عٍ مَ يَافِ شَ قٍ رَ.<verse eid="JER 14:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JER 14:4"/>بْشِ بَرَ عِبْو قْلْ،</para>
  <para style="q" vid="JER 14:4">بَرِ مَ تُنّ يٌ مُ قَشِ عَ مَ.</para>
  <para style="q" vid="JER 14:4">وَلِكّيٍ قَن لُشِ نَ يَافِ نَن كُي،</para>
  <para style="q" vid="JER 14:4">عٍ قَ سُننُن دٌنمَ رَفٌرٌ عٍ مَ.<verse eid="JER 14:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JER 14:5"/>تْوكّ عَ شَ دِ رَبٌلٌمَ وُلَ عِ،</para>
  <para style="q" vid="JER 14:5">بَرِ مَ حٌوفٍ مُ نَ عٍ نَشَن دٌنمَ.<verse eid="JER 14:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JER 14:6"/>سٌقَلٍ تِشِ فٍيَيٍ قَرِ،</para>
  <para style="q" vid="JER 14:6">عٍ قٌيٍ مَمّمَ عَلْ وُلَءِ بَرٍيٍ.</para>
  <para style="q" vid="JER 14:6">عٍ حٌوفٍ قٍنمَ</para>
  <para style="q" vid="JER 14:6">كْنْ عٍ مُ سٍسٍ تٌمَ.»<verse eid="JER 14:6"/></para>
  <para style="sp">عِسِرَيِلَ شَ مَسٍنيِ عَلَتَلَ بّ</para>
  <para style="q">
    <verse number="7" style="v" sid="JER 14:7"/>«عَلَتَلَ، هَلِ مُشُ شَ يُنُبِ فبٌ،</para>
  <para style="q" vid="JER 14:7">عِ شَ مُشُ رَكِسِ عِ شِلِ شَ قٍ رَ.</para>
  <para style="q" vid="JER 14:7">مُشُ بَرَ قٍ حَاشِ فبٍفبٍ رَبَ،</para>
  <para style="q" vid="JER 14:7">مُشُ بَرَ يُنُبِ رَبَ عِ رَ.<verse eid="JER 14:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 14:8"/>عِسِرَيِلَ شَشِلِ تِشِ عِ تَن نَن نَ،</para>
  <para style="q" vid="JER 14:8">عِ قِندِشِ مُشُ رَكِسِمَ نَن نَ مُشُ شَ تْورّ كُي.</para>
  <para style="q" vid="JER 14:8">مُنقٍ رَ عِ بَرَ لُ عَلْ شْحّ مُشُ شْنيِ؟</para>
  <para style="q" vid="JER 14:8">مُنقٍ رَ عِ بَرَ لُ عَلْ بِيَاسِلَ نَشَن نَ دَنفِقٍ تُن؟<verse eid="JER 14:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JER 14:9"/>مُنقٍ رَ عِ بَرَ لُ عَلْ سْورِ سّنبّتَرٍ نَشَن مُ نْمَ مُشُ رَكِسِدٍ؟</para>
  <para style="q" vid="JER 14:9">عَلَتَلَ، عِ نَ مُشُ يَ مَ،</para>
  <para style="q" vid="JER 14:9">عِ شِلِ نَ مُشُ شُن مَ.</para>
  <para style="q" vid="JER 14:9">عِ نَشَ مُشُ رَبٌلٌ.»<verse eid="JER 14:9"/></para>
  <para style="sp">عَلَتَلَ شَ مَسٍنيِ عِسِرَيِلَ بّ</para>
  <para style="q">
    <verse number="10" style="v" sid="JER 14:10"/>عَلَتَلَ بَرَ عَ مَسٍن يِ حَمَ بّ،</para>
  <para style="q" vid="JER 14:10">«حّرّتِيٍ نَن لَنشِ وٌ مَ،</para>
  <para style="q" vid="JER 14:10">وٌ مُ نْمَ وٌ يّتّ سُشُدٍ.»</para>
  <para style="sp" vid="JER 14:10">عَننَبِ يٍرٍ مِ شَ مَسٍنيِ</para>
  <para style="q" vid="JER 14:10">«عٍ مُ رَقَن عَلَتَلَ مَ.</para>
  <para style="q" vid="JER 14:10">عَ عٍ شَ يُنُبِيٍ كٌلٌن،</para>
  <para style="q" vid="JER 14:10">عَ قَمَ عٍ حَشَنكَتَدٍ نَ نَن مَ.»<verse eid="JER 14:10"/></para>
  <para style="sp">عَلَتَلَ شَ مَسٍنيِ عَننَبِ يٍرٍ مِ بّ،</para>
  <para style="q">
    <verse number="11" style="v" sid="JER 14:11"/>عَلَتَلَ بَرَ عَ مَسٍن ﭑ بّ،</para>
  <para style="q" vid="JER 14:11">«عِ نَشَ عَلَ مَشَندِ قٍ قَنيِ رَ يِ حَمَ بّ.<verse eid="JER 14:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JER 14:12"/>شَ عٍ سُنيِ سُشُ، ﭑ مَ تٌنفٌمَ.</para>
  <para style="q" vid="JER 14:12">شَ عٍ سّرّشّيٍ بَ، ﭑ مُ عٍ سُشُمَ،</para>
  <para style="q" vid="JER 14:12">بَرِ مَ ﭑ وَ مَ عٍ شُن نَكَنَقٍ نّ</para>
  <para style="q" vid="JER 14:12">سَنتِدّفّمَ، كَامّ، نُن قُرٍ حَاشِ رَ.»<verse eid="JER 14:12"/></para>
  <para style="sp">عَننَبِ يٍرٍ مِ شَ مَسٍنيِ عَلَتَلَ بّ</para>
  <para style="q">
    <verse number="13" style="v" sid="JER 14:13"/>ﭑ بَرَ عَلَ يَابِ،</para>
  <para style="q" vid="JER 14:13">«ﭑ مَرِفِ عَلَتَلَ، نَمِحْنمّيٍ بَرَ عَ قَلَ عٍ بّ،</para>
  <para style="q" vid="JER 14:13">‹وٌ مُ سَنتِدّفّمَ تٌمَ،</para>
  <para style="q" vid="JER 14:13">وٌ مُ كَامّ كٌلٌنمَ.</para>
  <para style="q" vid="JER 14:13">وٌ بْحّسَ نَن تُن سْتْمَ بٍ.›»<verse eid="JER 14:13"/></para>
  <para style="sp">عَلَتَلَ شَ مَسٍنيِ عَننَبِ يٍرٍ مِ بّ</para>
  <para style="q">
    <verse number="14" style="v" sid="JER 14:14"/>عَلَتَلَ بَرَ عَ مَسٍن ﭑ بّ،</para>
  <para style="q" vid="JER 14:14">«نَ نَمِحْنمّيٍ نَ وُلٍ نَن قَلَقٍ ﭑ شِلِ رَ.</para>
  <para style="q" vid="JER 14:14">ﭑ تَن مُ عٍ شّيشِ،</para>
  <para style="q" vid="JER 14:14">ﭑ تَن مُ يَامَرِ قِشِ عٍ مَ،</para>
  <para style="q" vid="JER 14:14">ﭑ تَن مُ وْيّنشِ عٍ بّ.</para>
  <para style="q" vid="JER 14:14">عٍ شَ وُلٍ مَسٍنيِ قَتَنشِ لَامَتُنيِيٍ نَن نَ</para>
  <para style="q" vid="JER 14:14">نَشٍيٍ مُ قِندِشِ نْندِ رَ،</para>
  <para style="q" vid="JER 14:14">عَ قَتَنشِ سٍ مَتٌي نُن كُيٍيٍ شَ وَلِ نَن مَ،</para>
  <para style="q" vid="JER 14:14">عَ قَتَنشِ عٍ يّتّ شَشِلِ مَدَشُشِ نَن نَ.<verse eid="JER 14:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 14:15"/>نَ نَن عَ رَ، عَلَتَلَ بَرَ عَ مَسٍن،</para>
  <para style="q" vid="JER 14:15">‹نَمِحْنمّ نَشَن مَسٍنيِ تِمَ ﭑ شِلِ رَ</para>
  <para style="q" vid="JER 14:15">ﭑ مُ نَشَن قِشِ عَ مَ،</para>
  <para style="q" vid="JER 14:15">عَ قَ عَ قَلَ «سَنتِدّفّمَ نُن كَامّ مُ يِ بْشِ لِمَ،»</para>
  <para style="q" vid="JER 14:15">نَ نَمِحْنمّ مْولِ سْنتْمَ نّ سَنتِدّفّمَ نُن كَامّ رَ.<verse eid="JER 14:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 14:16"/>عَ مَسٍنيِ تِمَ حَمَ نَشَن بّ،</para>
  <para style="q" vid="JER 14:16">عٍ قَمَ نّ قَشَدٍ دَرِ سَلَمُ كِرَيٍ شْن مَ سَنتِدّفّمَ نُن كَامّ رَ.</para>
  <para style="q" vid="JER 14:16">مِشِ يٌ مُ لُمَ نَا نَشٍيٍ عٍ رَفَتَمَ،</para>
  <para style="q" vid="JER 14:16">مِشِ يٌ مُ نَ نَشٍيٍ عٍ شَ فِنّيٍ نُن عٍ شَ دِيٍ رَفَتَمَ.</para>
  <para style="q" vid="JER 14:16">ﭑ قَ عٍ شَ قٍ حَاشِ سَرٍ رَفبِلٍندٍ عٍ مَ.›<verse eid="JER 14:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 14:17"/>عِ شَ عَ قَلَ عٍ بّ،</para>
  <para style="q" vid="JER 14:17">‹يَ يٍ مِنِمَ ﭑ يَ رَ كْي نُن يَنيِ تّمُي بِرِن،</para>
  <para style="q" vid="JER 14:17">بَرِ مَ ﭑ مَ حَمَ سّنِيّنشِ بَرَ تْورّ بٍلٍبٍلٍ سْتْ،</para>
  <para style="q" vid="JER 14:17">فبَلٌي بَرَ عٍ لِ.<verse eid="JER 14:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JER 14:18"/>شّمّ نَ دَاشَ نَشٍيٍ قَشَشِ سَنتِدّفّمَ رَ.</para>
  <para style="q" vid="JER 14:18">قُرٍ مَ كَامّشِيٍ نَ تَا كُي.</para>
  <para style="q" vid="JER 14:18">نَمِحْنمّيٍ نُن سّرّشّدُبّيٍ قَن بْشِ عِحّرّ مَ،</para>
  <para style="q" vid="JER 14:18">كْنْ عٍ شَشِلِ مُ نَ سْنْن.›»<verse eid="JER 14:18"/></para>
  <para style="sp">عِسِرَيِلَ شَ مَسٍنيِ عَلَتَلَ بّ</para>
  <para style="q">
    <verse number="19" style="v" sid="JER 14:19"/>«عَلَتَلَ، عِ بَرَ يُدَيَ رَبٌلٌ كٍرٍنيِ رَ؟</para>
  <para style="q" vid="JER 14:19">سِيٌن مُ رَقَنشِ عِ بْحّ مَ سْنْن؟</para>
  <para style="q" vid="JER 14:19">مُنقٍ رَ عِ مُشُ حَشَنكَتَمَ،</para>
  <para style="q" vid="JER 14:19">عِ تٌندِ مُشُ رَيَلَندٍ؟</para>
  <para style="q" vid="JER 14:19">مُشُ بَرَ وَ بْحّسَ شْن، كْنْ مُشُ مُ عَ سْتْشِ.</para>
  <para style="q" vid="JER 14:19">مُشُ بَرَ وَ يَلَنيِ شْن، كْنْ وَ شُي فبَنسَن نَن مِنِشِ.<verse eid="JER 14:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 14:20"/>عَلَتَلَ، مُشُ بَرَ مُشُ شَ حَاشُحَ كٌلٌن،</para>
  <para style="q" vid="JER 14:20">مُشُ بَرَ مُشُ بَبَيٍ شَ يُنُبِيٍ تٌ.</para>
  <para style="q" vid="JER 14:20">مُشُ بَرَ يُنُبِ رَبَ عِ رَ.<verse eid="JER 14:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JER 14:21"/>كْنْ عِ نَشَ شْنْ عِ شِلِ شَ قٍ رَ.</para>
  <para style="q" vid="JER 14:21">عِ نَشَ عَ لُ ندٍ شَ بَ عِ شَ بِنيّ نُن عِ شَ يَرَفَاشُي رَ.</para>
  <para style="q" vid="JER 14:21">عِ شَ رَتُ سَاتّ مَ نَشَن نَ وٌن تَفِ.<verse eid="JER 14:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JER 14:22"/>وُلٍ كُيٍ ندٍ نَ دُنِحَ نَشَن تُنّ رَفٌرٌ مَ؟ عَدٍ.</para>
  <para style="q" vid="JER 14:22">كٌورٍ نْمَ تُنّ رَقَدٍ؟ عَدٍ.</para>
  <para style="q" vid="JER 14:22">مُشُ شَشِلِ تِشِ عِ تَن نَن نَ،</para>
  <para style="q" vid="JER 14:22">بَرِ مَ عِ تَن نَن فبَنسَن نْمَ نَ قٍ مْولِ رَبَدٍ.»<verse eid="JER 14:22"/></para>
  <chapter eid="JER 14"/>
  <chapter number="15" style="c" sid="JER 15"/>
  <para style="s">عَلَ شَ نَتّ</para>
  <para style="sp">عَلَتَلَ شَ مَسٍنيِ عَننَبِ يٍرٍ مِ بّ</para>
  <para style="q">
    <verse number="1" style="v" sid="JER 15:1"/>عَلَتَلَ بَرَ عَ مَسٍن ﭑ بّ،</para>
  <para style="q" vid="JER 15:1">«هَلِ عَننَبِ مُنسَ نُن عَننَبِ سَمُوٍلِ</para>
  <para style="q" vid="JER 15:1">ﭑ مَشَندِ نّ يِ حَمَ شَ قٍ رَ،</para>
  <para style="q" vid="JER 15:1">ﭑ بْحّ مُ تِن نَ دُبَ سُشُدٍ.</para>
  <para style="q" vid="JER 15:1">عٍ شَ عٍ مَكُيَ ﭑ نَ، عٍ شَ سِفَ.<verse eid="JER 15:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JER 15:2"/>شَ يِ حَمَ عِ مَشْرِن، ‹مُشُ شَ سِفَ مِندٍن›،</para>
  <para style="q" vid="JER 15:2">عِ شَ عٍ يَابِ، ‹عَلَتَلَ نَن عَ مَسٍنشِ،</para>
  <para style="q" vid="JER 15:2">نَشَن لَنمَ عَ شَ قَشَ، نَ كَنيِ شَ قَشَ،</para>
  <para style="q" vid="JER 15:2">نَشَن لَنمَ عَ شَ قَشَ سَنتِدّفّمَ رَ،</para>
  <para style="q" vid="JER 15:2">نَ كَنيِ شَ قَشَ سَنتِدّفّمَ رَ،</para>
  <para style="q" vid="JER 15:2">نَشَن لَنمَ عَ شَ قَشَ كَامّ رَ،</para>
  <para style="q" vid="JER 15:2">نَ كَنيِ شَ قَشَ كَامّ رَ،</para>
  <para style="q" vid="JER 15:2">نَشَن لَنمَ عَ شَ شَنِن كٌنيِيَ كُي،</para>
  <para style="q" vid="JER 15:2">نَ كَنيِ شَ شَنِن كٌنيِيَ كُي.›<verse eid="JER 15:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JER 15:3"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 15:3">‹ﭑ قَمَ نّ عٍ حَشَنكَتَدٍ تْورّ نَانِ رَ.</para>
  <para style="q" vid="JER 15:3">سَنتِدّفّمَيٍ قَمَ نّ ندٍيٍ قَشَدٍ.</para>
  <para style="q" vid="JER 15:3">بَرٍيٍ قَ ندٍيٍ عِبْودٍ.</para>
  <para style="q" vid="JER 15:3">شْنِ نَشٍيٍ نَ كٌورٍ مَ نُن وُلَءِ سُبٍ نَشٍيٍ نَ بْشِ،</para>
  <para style="q" vid="JER 15:3">عٍ قَمَ نّ ندٍيٍ سْنتْدٍ، عٍ عٍ دٌن.<verse eid="JER 15:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JER 15:4"/>دُنِحَ مَنفّيَ بِرِن نَ نَ قٍ تٌ، عٍ لُمَ فَاشُي نَن كُي.</para>
  <para style="q" vid="JER 15:4">عٍ قَمَ نّ عَ كٌلٌندٍ يُدَيَ مَنفّ شٍسٍكِيَ شَ دِ مَنَسِ،</para>
  <para style="q" vid="JER 15:4">عَ قٍ حَاشِ نَشَن نَبَشِ دَرِ سَلَمُ،</para>
  <para style="q" vid="JER 15:4">نَ بَرَ عَ نِيَ عَلَتَلَ شَ عٍ حَشَنكَتَ.<verse eid="JER 15:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JER 15:5"/>دَرِ سَلَمُ، ندٍ كِنِكِنِمَ عِ مَ؟</para>
  <para style="q" vid="JER 15:5">ندٍ نْمَ دِحّدٍ عِ شَ قٍ رَ؟</para>
  <para style="q" vid="JER 15:5">ندٍ عِ شَ قٍ مَشْرِنمَ؟›<verse eid="JER 15:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JER 15:6"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 15:6">‹وٌ بَرَ ﭑ نَبٌلٌ،</para>
  <para style="q" vid="JER 15:6">وٌ بَرَ فبِلٍن ﭑ قْشْ رَ.</para>
  <para style="q" vid="JER 15:6">نَ قٍ نَ عَ رَ ﭑ قَمَ وٌ سُشُدٍ، ﭑ مُ كِنِكِنِ وٌ مَ.<verse eid="JER 15:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JER 15:7"/>ﭑ قَمَ نّ عٍ رَيٍنسٍندٍ عَلْ مَالٍ لَفِ،</para>
  <para style="q" vid="JER 15:7">ﭑ قَ عٍ شَ دِيٍ بَدٍ عٍ يِ رَ،</para>
  <para style="q" vid="JER 15:7">ﭑ قَ ﭑ مَ حَمَ شُن نَكَنَدٍ</para>
  <para style="q" vid="JER 15:7">بَرِ مَ عٍ مُ فبِلٍنشِ عٍ شَ وَلِ كٌبِ قْشْ رَ.<verse eid="JER 15:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 15:8"/>عٍ شَ كَاحّ فِنّيٍ وُيَمَ نّ</para>
  <para style="q" vid="JER 15:8">عَلْ مّيّنيِ نَشَن نَ بَا دّ رَ.</para>
  <para style="q" vid="JER 15:8">كَسَرَ تِ قَمَ نّ دِنفّيٍ مَ يَنيِ رَ،</para>
  <para style="q" vid="JER 15:8">عَ قَ قٍ مَفَاشُشِ رَبَ عٍ رَ.<verse eid="JER 15:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JER 15:9"/>نفَ نَشَن بَرَ دِ سٌلٌقٍرٍ بَرِ،</para>
  <para style="q" vid="JER 15:9">عَ قَمَ نّ تَفَندٍ، عَ قَشَ يَافِ كُي عَ شَ وَشَتِ مُ عَ لِشِ.</para>
  <para style="q" vid="JER 15:9">عِسِرَيِلَ يَشُييٍ قَمَ نّ عٍ سْنتْدٍ سَنتِدّفّمَ رَ.›</para>
  <para style="q" vid="JER 15:9">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.»<verse eid="JER 15:9"/></para>
  <para style="sp">عَننَبِ يٍرٍ مِ شَ مَسٍنيِ</para>
  <para style="q">
    <verse number="10" style="v" sid="JER 15:10"/>«ﭑ نفَ، حَشَنكَتّ نَ ﭑ بّ.</para>
  <para style="q" vid="JER 15:10">عِ بَرَ ﭑ نَسٌ دُنِحَ</para>
  <para style="q" vid="JER 15:10">كْنْ ﭑ مَ قٍ مُ رَقَنشِ بٍكَ يٌ مَ.</para>
  <para style="q" vid="JER 15:10">ﭑ مُ دٌنِ تٌنفٌمَ، ﭑ مُ دٌنِ قِمَ،</para>
  <para style="q" vid="JER 15:10">كْنْ مِشِ بِرِن لُمَ ﭑ دَنكَ رَ.»<verse eid="JER 15:10"/></para>
  <para style="sp">عَلَتَلَ شَ مَسٍنيِ</para>
  <para style="q">
    <verse number="11" style="v" sid="JER 15:11"/>عَلَتَلَ بَرَ عَ مَسٍن،</para>
  <para style="q" vid="JER 15:11">«ﭑ مُ وٌ رَكِسِشِ شّ؟</para>
  <para style="q" vid="JER 15:11">ﭑ مُ يَشُييٍ بْنبْ شّ وٌ شَ قٍ رَ وٌ تْورْ تّمُي؟<verse eid="JER 15:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JER 15:12"/>وُرٍ نُن يْشُي بٌلٌنمَ؟ عَدٍ.</para>
  <para style="q" vid="JER 15:12">مِشِ نَشَن كٍلِمَ كْولَ مَ فٌ؟<verse eid="JER 15:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JER 15:13"/>ﭑ بَرَ وٌ شَ هَرِفٍ نُن وٌ شَ نَاقُلِ بِرِن قِ مِشِ مَ</para>
  <para style="q" vid="JER 15:13">وٌ شَ يُنُبِيٍ شَ قٍ رَ وٌ نَشٍيٍ رَبَشِ يِ بْشِ مَ.<verse eid="JER 15:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JER 15:14"/>ﭑ وٌ سَمَ نّ وٌ يَشُييٍ سَفٌي،</para>
  <para style="q" vid="JER 15:14">عٍ شَ وٌ شَنِن بْشِ مَ وٌ مُ دّننَشّ كٌلٌن،</para>
  <para style="q" vid="JER 15:14">بَرِ مَ ﭑ بَرَ شْنْ وٌ مَ عَ حَاشِ رَ.»<verse eid="JER 15:14"/></para>
  <para style="sp">عَننَبِ يٍرٍ مِ شَ مَسٍنيِ عَلَتَلَ بّ</para>
  <para style="q">
    <verse number="15" style="v" sid="JER 15:15"/>«عَلَتَلَ، عِ بَرَ عَ بِرِن كٌلٌن.</para>
  <para style="q" vid="JER 15:15">عِ شَ رَتُ ﭑ مَ، ﭑ مَلِ، ﭑ فبٍحْشْ ﭑ يَشُييٍ مَ.</para>
  <para style="q" vid="JER 15:15">عِ نَشَ ﭑ قَشَ، عِ تَن كِنِكِنِنتٍ،</para>
  <para style="q" vid="JER 15:15">بَرِ مَ ﭑ نَ تْورْقٍ عِ شِلِ شَ قٍ رَ.<verse eid="JER 15:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 15:16"/>ﭑ تٌ عِ شَ مَسٍنيِ مّ، ﭑ بَرَ عَ سُشُ.</para>
  <para style="q" vid="JER 15:16">عِ شَ سّرِيّ رَقَن ﭑ مَ،</para>
  <para style="q" vid="JER 15:16">بَرِ مَ ﭑ قِندِشِ عِ فبٍ نَن نَ، عِ تَن مَنفّ عَلَتَلَ.<verse eid="JER 15:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 15:17"/>ﭑ مُ لُ مِشِ يَ مَ نَشٍيٍ نُ يٌمَ عِ مَ،</para>
  <para style="q" vid="JER 15:17">بَرِ مَ عِ شَ قٍ نُ نَ ﭑ بْحّ كُي.</para>
  <para style="q" vid="JER 15:17">ﭑ نُ بَرَ لُ ﭑ كٍرٍن،</para>
  <para style="q" vid="JER 15:17">ﭑ نُ شْنْشِ يِ حَمَ مَ عَلْ عِ تَن.<verse eid="JER 15:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JER 15:18"/>مُنقٍ رَ ﭑ لُمَ تْورّ كُي؟</para>
  <para style="q" vid="JER 15:18">مُنقٍ رَ ﭑ مُ يَلَنيِ سْتْمَ؟</para>
  <para style="q" vid="JER 15:18">عِ نَشَ عِ شَ لَايِدِ كَنَ</para>
  <para style="q" vid="JER 15:18">عَلْ كْلْنيِ نَشَن مُ يٍ رَ مِنِمَ سْنْن.»<verse eid="JER 15:18"/></para>
  <para style="sp">عَلَتَلَ شَ مَسٍنيِ عَننَبِ يٍرٍ مِ بّ</para>
  <para style="q">
    <verse number="19" style="v" sid="JER 15:19"/>نَ نَن عَ رَ عَلَتَلَ بَرَ عَ مَسٍن،</para>
  <para style="q" vid="JER 15:19">«شَ عِ فبِلٍن ﭑ مَ،</para>
  <para style="q" vid="JER 15:19">ﭑ عِ رَفبِلٍنمَ نّ عِ وَلِدٍ.</para>
  <para style="q" vid="JER 15:19">شَ عِ بَ وْيّن حَاشِ قَلَقٍ،</para>
  <para style="q" vid="JER 15:19">ﭑ مَن عِ قِندِ مَ نّ ﭑ مَ شّيرَ رَ.</para>
  <para style="q" vid="JER 15:19">حَمَ شَ بِرَ عِ قْشْ رَ،</para>
  <para style="q" vid="JER 15:19">عِ تَن نَشَ بِرَ عٍ قْشْ رَ دٍ.<verse eid="JER 15:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 15:20"/>يِ حَمَ قَمَ نّ عِ فٍرٍدٍ،</para>
  <para style="q" vid="JER 15:20">كْنْ عٍ مُ نْمَ عِ رَ،</para>
  <para style="q" vid="JER 15:20">بَرِ مَ ﭑ عِ لُمَ نّ عَلْ تّتّ شْرْشْي عٍ يَ رَ.</para>
  <para style="q" vid="JER 15:20">ﭑ نَ عِ سّيتِ مَ، عَلَكٌ ﭑ شَ عِ رَكِسِ، ﭑ شَ عِ رَتَنفَ.</para>
  <para style="q" vid="JER 15:20">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="JER 15:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JER 15:21"/>ﭑ عِ بَمَ نّ مِشِ حَاشِ بّلّشّ،</para>
  <para style="q" vid="JER 15:21">ﭑ عِ رَتَنفَ مَنفّ سّنبّمَ مَ.»<verse eid="JER 15:21"/></para>
  <chapter eid="JER 15"/>
  <chapter number="16" style="c" sid="JER 16"/>
  <para style="s">فبَلٌي عِسِرَيِلَ بْشِ مَ</para>
  <para style="sp">عَلَتَلَ شَ مَسٍنيِ عَننَبِ يٍرٍ مِ بّ</para>
  <para style="q">
    <verse number="1" style="v" sid="JER 16:1"/>عَلَتَلَ بَرَ يِ مَسٍنيِ تِ ﭑ بّ،<verse eid="JER 16:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JER 16:2"/>«عِ نَشَ فِنّ دْشْ، عِ نَشَ دِيٍ سْتْ،<verse eid="JER 16:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JER 16:3"/>بَرِ مَ عَلَتَلَ بَرَ عَ مَسٍن دِيٍ شَ قٍ رَ</para>
  <para style="q" vid="JER 16:3">نَشٍيٍ قَمَ بَرِدٍ يِ بْشِ مَ،</para>
  <para style="q" vid="JER 16:3">عَ نُن عٍ نفَ نَشٍيٍ عٍ بَرِشِ،</para>
  <para style="q" vid="JER 16:3">عَ نُن عٍ بَبَ نَشٍيٍ عٍ سْتْشِ،<verse eid="JER 16:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JER 16:4"/>عٍ قَمَ نّ قَشَدٍ قُرٍ مَ،</para>
  <para style="q" vid="JER 16:4">كْنْ حْنقٍ مُ رَبَمَ عٍ بّ، عٍ مُ رَفَتَمَ بْشِ مَ.</para>
  <para style="q" vid="JER 16:4">عٍ قِندِ مَ حَحّ نَن نَ بّندّ قُحِ قَرِ.</para>
  <para style="q" vid="JER 16:4">عٍ نَ قَشَ سَنتِدّفّمَ نُن كَامّ رَ،</para>
  <para style="q" vid="JER 16:4">شْنِيٍ نُن وُلَءِ سُبٍيٍ قَ عٍ بِنبِيٍ دٌندٍ.»<verse eid="JER 16:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="JER 16:5"/>عَلَتَلَ بَرَ عَ مَسٍن ﭑ بّ،</para>
  <para style="q" vid="JER 16:5">«عِ نَشَ سٌ بَنشِ كُي مِشِ نَ سُننُنيِ كُي دّننَشّ،</para>
  <para style="q" vid="JER 16:5">عِ نَشَ سِفَ حْن يِرٍ، عِ نَشَ مِشِ كُنقَ بَ،</para>
  <para style="q" vid="JER 16:5">بَرِ مَ ﭑ بَرَ بْحّسَ بَ ﭑ مَ حَمَ يِ رَ،</para>
  <para style="q" vid="JER 16:5">ﭑ بَرَ تٌندِ هِننّ نُن كِنِكِنِ مَ عٍ بّ.»</para>
  <para style="q" vid="JER 16:5">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="JER 16:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="JER 16:6"/>«مِشِ شُنفبٍيٍ نُن مِشِ لَنمَيٍ قَشَمَ نّ يِ بْشِ مَ.</para>
  <para style="q" vid="JER 16:6">عٍ مُ رَفَتَمَ، عٍ حْنقٍ مُ رَبَمَ.</para>
  <para style="q" vid="JER 16:6">عٍ شَ مِشِيٍ مُ عٍ يّتّ مَشَبَمَ سُننُنيِ كُي،</para>
  <para style="q" vid="JER 16:6">عٍ مُ عٍ شُنيِ بِمَ قَشَ مِشِيٍ بّ.<verse eid="JER 16:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JER 16:7"/>عٍ مُ تَامِ دْشْمَ سُننُن مِشِيٍ بّ عَلَكٌ عٍ شَ مَدُندُ.</para>
  <para style="q" vid="JER 16:7">عٍ مُ مِنسٍ دْشْمَ سُننُن مِشِيٍ بّ،</para>
  <para style="q" vid="JER 16:7">نَشٍيٍ بَبَ شَ نَ مُ عَ رَ عٍ نفَ بَرَ قَشَ.<verse eid="JER 16:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 16:8"/>عِ نَشَ حْن قٍ بَندٍ دٌن،</para>
  <para style="q" vid="JER 16:8">عِ نَشَ لُ سُننُن مِشِيٍ قّ مَ عٍ مَدُندُقٍ رَ،<verse eid="JER 16:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JER 16:9"/>بَرِ مَ عِسِرَيِلَ مَنفّ عَلَتَلَ بَرَ عَ مَسٍن،</para>
  <para style="q" vid="JER 16:9">‹ﭑ بَرَ قَ يِ وَشَتِ وٌ تَفِ</para>
  <para style="q" vid="JER 16:9">عَلَكٌ حّلّشِنيِ سِفِيٍ شَ دَن،</para>
  <para style="q" vid="JER 16:9">شُلُنيِيٍ شَ حْن قُتِ شِرِ مَيٍ تَفِ.›»<verse eid="JER 16:9"/></para>
  <para style="sp">عَننَبِ يٍرٍ مِ شَ مَسٍنيِ عَلَتَلَ بّ</para>
  <para style="q">
    <verse number="10" style="v" sid="JER 16:10"/>«ﭑ نَ فّ يِ مَسٍنيِ تِدٍ حَمَ بّ،</para>
  <para style="q" vid="JER 16:10">عٍ قَمَ نّ ﭑ مَشْرِندٍ،</para>
  <para style="q" vid="JER 16:10">‹مُنقٍ رَ عَلَتَلَ بَرَ عَ مَسٍن عَ شَ مُشُ حَشَنكَتَ؟</para>
  <para style="q" vid="JER 16:10">مُنسٍ قِندِشِ مُشُ شَ يُنُبِ رَ؟</para>
  <para style="q" vid="JER 16:10">مُشُ قٍ حَاشِ مُندُن نَبَشِ مُشُ مَرِفِ عَلَتَلَ رَ؟›»<verse eid="JER 16:10"/></para>
  <para style="sp">عَلَتَلَ شَ مَسٍنيِ عَننَبِ يٍرٍ مِ بّ</para>
  <para style="q">
    <verse number="11" style="v" sid="JER 16:11"/>«عِ شَ عٍ يَابِ،</para>
  <para style="q" vid="JER 16:11">‹عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 16:11">وٌ بَبَيٍ بَرَ ﭑ نَبٌلٌ،</para>
  <para style="q" vid="JER 16:11">عٍ بَرَ بِرَ عَلَ فبّتّيٍ قْشْ رَ،</para>
  <para style="q" vid="JER 16:11">عٍ بَرَ عٍ بَتُ، عٍ بَرَ تُوبِ عٍ بّ.</para>
  <para style="q" vid="JER 16:11">عٍ بَرَ ﭑ تَن نَبّحِن، عٍ مُ ﭑ مَ سّرِيّ سُشُ.<verse eid="JER 16:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JER 16:12"/>وٌ تَن بَرَ قٍ حَاشِ رَبَ دَنفِقٍ وٌ بَبَيٍ رَ.</para>
  <para style="q" vid="JER 16:12">وٌ بَرَ بِرَ وٌ سٌندٌنيِ حَاشِ وَشْنقٍ قْشْ رَ،</para>
  <para style="q" vid="JER 16:12">وٌ مُ وٌ تُلِ مَتِ ﭑ نَ.<verse eid="JER 16:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JER 16:13"/>ﭑ شَ وٌ كٍرِ يِ بْشِ مَ،</para>
  <para style="q" vid="JER 16:13">وٌ شَ سِفَ يِرٍ ندٍ وٌ نُن وٌ بَبَيٍ مُ دّننَشّ كٌلٌن.</para>
  <para style="q" vid="JER 16:13">مّننِ وٌ نْمَ نّ عَلَ فبّتّيٍ بَتُدٍ كْي نُن يَنيِ رَ،</para>
  <para style="q" vid="JER 16:13">بَرِ مَ ﭑ مُ كِنِكِنِمَ وٌ مَ سْنْن.›»<verse eid="JER 16:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="JER 16:14"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 16:14">«لْشْي قَمَ قَدٍ، مِشِ مُ عَ قَلَمَ سْنْن،</para>
  <para style="q" vid="JER 16:14">‹عَلَتَلَ حِحّ بَرَ عِسِرَيِلَكَيٍ رَ مِنِ مِسِرَ بْشِ رَ.›<verse eid="JER 16:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 16:15"/>مِشِيٍ قَمَ نّ عَ قَلَدٍ،</para>
  <para style="q" vid="JER 16:15">‹عَلَتَلَ حِحّ بَرَ عِسِرَيِلَكَيٍ رَ مِنِ كْولَ بْشِ مَ،</para>
  <para style="q" vid="JER 16:15">عَ نُن بْشِ بِرِن مَ عٍ رَيٍنسٍنشِ دّننَشّ.</para>
  <para style="q" vid="JER 16:15">ﭑ قَمَ نّ عٍ رَفبِلٍندٍ عٍ شَ بْشِ مَ،</para>
  <para style="q" vid="JER 16:15">ﭑ نَشَن قِ عٍ بَبَيٍ مَ.›»<verse eid="JER 16:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="JER 16:16"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 16:16">«ﭑ قَمَ نّ مِشِ سُشُييٍ شّيدٍ عٍ يِرٍ، عٍ شَ عٍ سُشُ.</para>
  <para style="q" vid="JER 16:16">ﭑ قَمَ نّ كٌيِنمَيٍ شّيدٍ عٍ يِرٍ، عٍ شَ عٍ قٍن فٍيَيٍ قَرِ فّمّيٍ لٌنفٌرِ رَ،<verse eid="JER 16:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 16:17"/>بَرِ مَ ﭑ بَرَ عٍ حّرّ كِ تٌ.</para>
  <para style="q" vid="JER 16:17">عٍ رَبَقٍ مُ نْشُنشِ ﭑ مَ،</para>
  <para style="q" vid="JER 16:17">ﭑ عٍ شَ يُنُبِيٍ بِرِن تٌمَ.<verse eid="JER 16:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JER 16:18"/>ﭑ قَمَ نّ عٍ شَ يُنُبِ سَرٍ رَفبِلٍندٍ عٍ مَ دْشْ قِرِن،</para>
  <para style="q" vid="JER 16:18">بَرِ مَ عٍ بَرَ ﭑ مَ بْشِ قِندِ بْشِ سّنِيّنتَرٍ رَ،</para>
  <para style="q" vid="JER 16:18">ﭑ نَشَن قِشِ عٍ مَ كّ رَ.</para>
  <para style="q" vid="JER 16:18">عٍ بَرَ نَ بْشِ رَقٍ قٍ حَاشِ نُن قٍ رَتْنشِ رَ.»<verse eid="JER 16:18"/></para>
  <para style="sp">عَننَبِ يٍرٍ مِ شَ مَسٍنيِ</para>
  <para style="q">
    <verse number="19" style="v" sid="JER 16:19"/>«عَلَتَلَ قِندِشِ ﭑ سّنبّ نَن نَ،</para>
  <para style="q" vid="JER 16:19">عَ قِندِشِ ﭑ كَنتَمَ نَن نَ،</para>
  <para style="q" vid="JER 16:19">عَ قِندِشِ ﭑ مَ كَنتَرِ نَن نَ ﭑ مَ تْورّ كُي.</para>
  <para style="q" vid="JER 16:19">سِيٍ قَمَ نّ قَدٍ عِ يِرٍ كٍلِقٍ دُنِحَ تُشُي بِرِن.</para>
  <para style="q" vid="JER 16:19">عٍ قَمَ نّ عَ قَلَدٍ، ‹مُشُ بَبَيٍ بِرَشِ وُلٍ نَن قْشْ رَ،</para>
  <para style="q" vid="JER 16:19">وُلٍ نَشَن مُ قِندِشِ مُنَقَنيِ رَ عٍ بّ.›<verse eid="JER 16:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 16:20"/>عَدَ مَدِ نْمَ عَلَيٍ يَءِلَندٍ؟</para>
  <para style="q" vid="JER 16:20">عٍ نَشَن يَءِلَنمَ، عَلَ مُ عَ رَ.»<verse eid="JER 16:20"/></para>
  <para style="sp">عَلَتَلَ شَ مَسٍنيِ</para>
  <para style="q">
    <verse number="21" style="v" sid="JER 16:21"/>«نَ نَن عَ رَ،</para>
  <para style="q" vid="JER 16:21">يِ بِيَاسِ ﭑ قَمَ نّ ﭑ سّنبّ مَفَاشُشِ مَسٍندٍ عٍ بّ،</para>
  <para style="q" vid="JER 16:21">عَلَكٌ عٍ شَ عَ كٌلٌن عَلَتَلَ نَن ﭑ نَ.»<verse eid="JER 16:21"/></para>
  <chapter eid="JER 16"/>
  <chapter number="17" style="c" sid="JER 17"/>
  <para style="s">سٌندٌنيِ سّنِيّنتَرٍ</para>
  <para style="sp">عَلَتَلَ شَ مَسٍنيِ</para>
  <para style="q">
    <verse number="1" style="v" sid="JER 17:1"/>«يُدَيَ شَ يُنُبِ سّبّشِ وُرٍ سّبّلِ تِ سٍ شْرْشْي نَن نَ.</para>
  <para style="q" vid="JER 17:1">عَ سّبّشِ عٍ سٌندٌنيِ مَ،</para>
  <para style="q" vid="JER 17:1">عَ سّبّشِ عٍ شَ سّرّشّبَدٍ قٍرِيٍ مَ،</para>
  <para style="q" vid="JER 17:1">عَلْ سّبّلِ تِمَ وَلَشّ مَ كِ نَشّ.<verse eid="JER 17:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JER 17:2"/>عٍ شَ دِيٍ قَن نَتُمَ عٍ شَ سّرّشّبَدٍيٍ مَ نَ كِ نّ،</para>
  <para style="q" vid="JER 17:2">عَ نُن عٍ شَ عَسٍرِ وُرِ مَسٌلِشِيٍ مَ</para>
  <para style="q" vid="JER 17:2">نَشٍيٍ لُشِ سَنسِ بُن مَ فٍيَيٍ قَرِ.<verse eid="JER 17:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JER 17:3"/>ﭑ مَ فٍيَ نَشَن نَ وٌ شَ بْشِ مَ،</para>
  <para style="q" vid="JER 17:3">عَ نُن وٌ هَرِفٍ، نُن وٌ شَ نَاقُلِ بِرِن،</para>
  <para style="q" vid="JER 17:3">نُن وٌ شَ كُيٍ بَتُدٍ نَشٍيٍ نَ فٍيَيٍ قَرِ،</para>
  <para style="q" vid="JER 17:3">ﭑ نَ بِرِن سٌمَ نّ وٌ يَشُييٍ يِ رَ وٌ شَ يُنُبِ شَ قٍ رَ،</para>
  <para style="q" vid="JER 17:3">وٌ نَشَن نَبَشِ وٌ شَ بْشِ بِرِن مَ.<verse eid="JER 17:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JER 17:4"/>وٌ يّتّ يَتِ قَمَ نّ وٌ كّ بّحِندٍ، ﭑ نَشَن قِشِ وٌ مَ.</para>
  <para style="q" vid="JER 17:4">ﭑ وٌ قِندِ مَ نّ وٌ يَشُي شَ كٌنيِيٍ رَ بْشِ ندٍ مَ،</para>
  <para style="q" vid="JER 17:4">وٌ مُ نَشَن كٌلٌن،</para>
  <para style="q" vid="JER 17:4">بَرِ مَ وٌ بَرَ ﭑ نَشْنْ عَ حَاشِ رَ،</para>
  <para style="q" vid="JER 17:4">ﭑ مَ شْنّ لُشِ نّ عَلْ تّ شُبٍنتَرٍ.»<verse eid="JER 17:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="JER 17:5"/>عَلَتَلَ بَرَ عَ مَسٍن،</para>
  <para style="q" vid="JER 17:5">«دَنكّ نَ مِشِ بّ نَشَن شَشِلِ تِشِ عَدَ مَدِ رَ،</para>
  <para style="q" vid="JER 17:5">نَشَن عَ يّتّ تَشُمَ مِشِ ندٍ رَ،</para>
  <para style="q" vid="JER 17:5">نَشَن بْحّ بَرَ عَلَتَلَ بّحِن.<verse eid="JER 17:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JER 17:6"/>عَ لُمَ نّ عَلْ كُنسِ نَشَن تِشِ فبٍنفبٍرٍنيِ مَ.</para>
  <para style="q" vid="JER 17:6">عَ شَ قٍ مُ سْونّيَمَ نَ بْشِ شَرٍ مَ،</para>
  <para style="q" vid="JER 17:6">مِشِ مُ سَبَتِشِ دّننَشّ.<verse eid="JER 17:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JER 17:7"/>حّلّشِنيِ نَ مِشِ بّ نَشَن شَشِلِ تِشِ عَلَتَلَ رَ،</para>
  <para style="q" vid="JER 17:7">نَشَن عَ يّتّ تَشُمَ عَلَ رَ.<verse eid="JER 17:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 17:8"/>عَ تَن لُشِ نّ عَلْ سَنسِ نَشَن سِشِ شُرٍ قّ مَ،</para>
  <para style="q" vid="JER 17:8">نَشَن سَنكٍ يٍ سْتْمَ عَ قَنيِ رَ.</para>
  <para style="q" vid="JER 17:8">وُيٍنيِ مُ عَ لِمَ مّننِ، عَ بُرّشّ قَنمَ نّ تُن.</para>
  <para style="q" vid="JER 17:8">هَلِ سٌفٌقُرٍ تّمُي، عَ بُرّشّ مُ لِسِمَ،</para>
  <para style="q" vid="JER 17:8">عَ بٌفِمَ نّ تّمُي بِرِن.»<verse eid="JER 17:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="JER 17:9"/>«عَدَ مَ شَ تِنشِنتَرٍيَ كٌبِ قٍ بِرِن بّ.</para>
  <para style="q" vid="JER 17:9">عَ مُ نْمَ مَتِنشِندٍ.</para>
  <para style="q" vid="JER 17:9">ندٍ نَ قَهَامُمَ؟<verse eid="JER 17:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JER 17:10"/>ﭑ تَن عَلَتَلَ، ﭑ مِشِ بْحّ نَن مَتٌمَ،</para>
  <para style="q" vid="JER 17:10">ﭑ عَدَ مَ سٌندٌنيِ كُي نَن قٍنمَ،</para>
  <para style="q" vid="JER 17:10">عَلَكٌ ﭑ شَ كَنكَن شَ قٍ رَبَشِ سَرٍ رَفبِلٍن عَ مَ.<verse eid="JER 17:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JER 17:11"/>نَاقُلِ تِنشِنتَرٍ كَنيِ لُشِ نّ</para>
  <para style="q" vid="JER 17:11">عَلْ دْنمّ نَشَن شّلّيٍ رَ سّفّمَ عَ فبٍ مُ نَ نَشٍيٍ رَ.</para>
  <para style="q" vid="JER 17:11">عَ شَ نَاقُلِ لْيمَ عَ شَ دُنِحّءِفِرِ نَن كُي،</para>
  <para style="q" vid="JER 17:11">عَ قَشَ تّمُي عَ قَ كٌلٌندٍ عَ لْننِتَرٍ نَن عَ رَ.»<verse eid="JER 17:11"/></para>
  <para style="sp">عَننَبِ يٍرٍ مِ شَ مَسٍنيِ</para>
  <para style="q">
    <verse number="12" style="v" sid="JER 17:12"/>«وٌن مَرِفِ عَلَتَلَ شَ كِبَنيِ نَ نْرّ كُي،</para>
  <para style="q" vid="JER 17:12">عَ شَ هْرْ مْلِنفِرَ عِتٍشِ نَ نَ كَبِ قْلّ.<verse eid="JER 17:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JER 17:13"/>عَلَتَلَ، عِسِرَيِلَ شَشِلِ تِشِ عِ تَن نَن نَ.</para>
  <para style="q" vid="JER 17:13">مِشِ نَشَن عِ بّحِنمَ، عٍ لُمَ يَافِ نَن كُي.»</para>
  <para style="sp" vid="JER 17:13">عَلَتَلَ شَ مَسٍنيِ</para>
  <para style="q" vid="JER 17:13">«مِشِ نَشَن ﭑ بّحِنمَ، عٍ لْيمَ نّ بّندّ قُحِ قَرِ،</para>
  <para style="q" vid="JER 17:13">بَرِ مَ عٍ بَرَ تٌندِ عَلَتَلَ رَ،</para>
  <para style="q" vid="JER 17:13">نَشَن مَنِيَشِ يٍ رَ مِشِ بَلٌمَ نَشَن نَ.»<verse eid="JER 17:13"/></para>
  <para style="sp">عَننَبِ يٍرٍ مِ شَ مَسٍنيِ عَلَتَلَ بّ</para>
  <para style="q">
    <verse number="14" style="v" sid="JER 17:14"/>«عَلَتَلَ، ﭑ نَيَلَن، ﭑ نَكِسِ.</para>
  <para style="q" vid="JER 17:14">ﭑ لَمَ نّ عِ رَ، تَنتُي نَ عِ بّ.<verse eid="JER 17:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 17:15"/>عَلَتَلَ عَ قَلَمَ ﭑ بّ،</para>
  <para style="q" vid="JER 17:15">‹عَلَتَلَ شَ مَسٍنيِ مُ كَمَلِمَ شّ؟</para>
  <para style="q" vid="JER 17:15">عَ شَ كَمَلِ.›<verse eid="JER 17:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 17:16"/>ﭑ مُ تٌندِ مَ قِندِدٍ حَمَ يَرٍرَتِ رَ.</para>
  <para style="q" vid="JER 17:16">عِ عَ كٌلٌن ﭑ مُ وَ مَ فبَلٌي شَ مُشُ لِ.</para>
  <para style="q" vid="JER 17:16">عِ ﭑ مَ مَسٍنيِ بِرِن كٌلٌن.<verse eid="JER 17:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 17:17"/>عِ نَشَ ﭑ مَفَاشُ،</para>
  <para style="q" vid="JER 17:17">بَرِ مَ ﭑ مَ كَنتَرِ نَن عِ رَ فبَلٌي كُي.<verse eid="JER 17:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JER 17:18"/>عِ شَ ﭑ يَشُييٍ رَيَافِ،</para>
  <para style="q" vid="JER 17:18">كْنْ عِ نَشَ ﭑ تَن لُ يَافِ كُي.</para>
  <para style="q" vid="JER 17:18">عِ شَ ﭑ يَشُييٍ رَ سّرّن،</para>
  <para style="q" vid="JER 17:18">كْنْ عِ نَشَ ﭑ لُ فَاشُي كُي.</para>
  <para style="q" vid="JER 17:18">عِ شَ فبَلٌي رَ سَنبَ عٍ مَ،</para>
  <para style="q" vid="JER 17:18">عِ شَ عٍ هَلَكِ عَ حَاشِ رَ.»<verse eid="JER 17:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 17:19"/>عَلَتَلَ بَرَ عَ مَسٍن ﭑ بّ، «سِفَ، عِ سَ تِ نَادّ سّيتِ مَ نَشَن شِلِ قَلَمَ، ‹حَمَ شَ نَادّ،› يُدَيَ مَنفّيٍ سٌمَ دّننَشّ، عٍ مِنِمَ دّننَشّ رَ. عِ مَن شَ سِفَ دَرِ سَلَمُ سٌدٍ دّ بِرِن نَ، <verse eid="JER 17:19"/><verse number="20" style="v" sid="JER 17:20"/>عَ قَلَ حَمَ بّ، ‹يُدَيَ مَنفّ، يُدَيَكَيٍ، نُن دَرِ سَلَمُكَيٍ، وٌ تَن نَشٍيٍ بِرِن سٌمَ يِ نَادّيٍ رَ، وٌ وٌ تُلِ مَتِ عَلَتَلَ شَ مَسٍنيِ رَ.›»<verse eid="JER 17:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JER 17:21"/>عَلَتَلَ بَرَ عَ مَسٍن،</para>
  <para style="q" vid="JER 17:21">«وٌ شَ عَ مَتٌ عَ قَنيِ رَ،</para>
  <para style="q" vid="JER 17:21">وٌ نَشَ كٌتٍ شَنِن مَلَبُي لْشْي،</para>
  <para style="q" vid="JER 17:21">وٌ نَشَ كٌتٍ رَ سٌ دَرِ سَلَمُ تَا كُي.<verse eid="JER 17:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JER 17:22"/>وٌ نَشَ كٌتٍ رَ مِنِ وٌ شَ بَنشِ كُي مَلَبُي لْشْي،</para>
  <para style="q" vid="JER 17:22">وٌ نَشَ وَلِ يٌ رَبَ نَ لْشْي.</para>
  <para style="q" vid="JER 17:22">وٌ شَ مَلَبُي لْشْي بِنيَ</para>
  <para style="q" vid="JER 17:22">عَلْ ﭑ وٌ بَبَيٍ يَمَرِشِ كِ نَشّ.<verse eid="JER 17:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JER 17:23"/>عٍ مُ ﭑ شُي رَ مّشِ، عٍ مُ عٍ تُلِ مَتِشِ ﭑ نَ.</para>
  <para style="q" vid="JER 17:23">عٍ عٍ كٌبٍ رَ سٌشِ ﭑ نَ، عٍ تٌندِ ﭑ مَ سّرِيّ رَ.»<verse eid="JER 17:23"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="24" style="v" sid="JER 17:24"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ،</para>
  <para style="q" vid="JER 17:24">«شَ وٌ وٌ تُلِ مَتِ ﭑ نَ،</para>
  <para style="q" vid="JER 17:24">شَ وٌ مُ كٌتٍ يٌ رَ سٌ تَا كُي مَلَبُي لْشْي،</para>
  <para style="q" vid="JER 17:24">شَ وٌ مَلَبُي لْشْي بِنيَ،</para>
  <para style="q" vid="JER 17:24">شَ وٌ مُ وَلِ يٌ رَبَ نَ لْشْي،<verse eid="JER 17:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JER 17:25"/>مَنفّيٍ نُن مَنفّدِيٍ سٌمَ نّ تَا سٌدٍ دّيٍ كُي سٌي نُن سْورِ رَفِسٍيٍ قَرِ،</para>
  <para style="q" vid="JER 17:25">عٍ قَ دْشْ دَوُدَ شَ كِبَنيِ كُي.</para>
  <para style="q" vid="JER 17:25">يُدَيَكَيٍ نُن دَرِ سَلَمُكَيٍ قَن سٌمَ نّ تَا كُي،</para>
  <para style="q" vid="JER 17:25">دَرِ سَلَمُ قَ سَبَتِ عَبَدَن.<verse eid="JER 17:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JER 17:26"/>مِشِ قَمَ نّ كٍلِقٍ يُدَيَ تَايٍ كُي،</para>
  <para style="q" vid="JER 17:26">كٍلِقٍ دَرِ سَلَمُ رَبِلِنيِ،</para>
  <para style="q" vid="JER 17:26">كٍلِقٍ بُنيَمِن بْشِ مَ،</para>
  <para style="q" vid="JER 17:26">كٍلِقٍ سٍقٍلَ بْشِ مَ،</para>
  <para style="q" vid="JER 17:26">كٍلِقٍ فٍيَيٍ نُن نٍفٍوِ فبٍنفبٍرٍنيِ مَ.</para>
  <para style="q" vid="JER 17:26">عٍ قَمَ نّ عَلَكٌ عٍ شَ سّرّشّ مْولِ بِرِن بَ عَلَتَلَ شَ هْرْ مْبَنشِ كُي،</para>
  <para style="q" vid="JER 17:26">عَلْ سّرّشّ فَن دَاشِ، شَنُنتٍيَ سّرّشّ،</para>
  <para style="q" vid="JER 17:26">سُرَيِ سّرّشّ، نُن تَنتُي سّرّشّ.<verse eid="JER 17:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="JER 17:27"/>كْنْ شَ وٌ مُ وٌ تُلِ مَتِ ﭑ نَ،</para>
  <para style="q" vid="JER 17:27">شَ وٌ تٌندِ مَلَبُي لْشْي بِنيَدٍ،</para>
  <para style="q" vid="JER 17:27">شَ وٌ كٌتٍ شَنِن نَ لْشْي،</para>
  <para style="q" vid="JER 17:27">وٌ عٍ رَ سٌ دَرِ سَلَمُ تَا كُي مَلَبُي لْشْي،</para>
  <para style="q" vid="JER 17:27">ﭑ وٌ شَ تَا سٌدٍ دّيٍ فَنمَ نّ تّ رَ نَشَن مُ شُبٍنمَ،</para>
  <para style="q" vid="JER 17:27">عَ قَ دَرِ سَلَمُ يِرٍ مَكَنتَشِ بِرِن كَنَ.»<verse eid="JER 17:27"/></para>
  <chapter eid="JER 17"/>
  <chapter number="18" style="c" sid="JER 18"/>
  <para style="s">قّحّ يَءِلَنيِ</para>
  <para style="sp">عَلَتَلَ شَ مَسٍنيِ</para>
  <para style="q">
    <verse number="1" style="v" sid="JER 18:1"/>عَلَتَلَ نَشَ يِ مَسٍنيِ تِ عَننَبِ يٍرٍ مِ بّ،<verse eid="JER 18:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JER 18:2"/>«كٍلِ، عِ شَ سِفَ قّحّ يَءِلَنيِ شْنيِ.</para>
  <para style="q" vid="JER 18:2">مّننِ عِ قَمَ نّ ﭑ مَ مَسٍنيِ مّدٍ.»<verse eid="JER 18:2"/></para>
  <para style="sp">عَننَبِ يٍرٍ مِ شَ مَسٍنيِ</para>
  <para style="q">
    <verse number="3" style="v" sid="JER 18:3"/>«عَوَ، ﭑ نَشَ سِفَ قّحّ يَءِلَنيِ شْنيِ.</para>
  <para style="q" vid="JER 18:3">عَ نُ نَ قّحّ يَءِلَنقٍ،<verse eid="JER 18:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JER 18:4"/>كْنْ نَ قّحّ تٌ بْو يِرٍ ندٍ،</para>
  <para style="q" vid="JER 18:4">عَ مَن نَشَ فبِلٍن عَ يَءِلَن نَ،</para>
  <para style="q" vid="JER 18:4">عَلَكٌ عَ شَ لُ عَلْ عَ نُ وَ مَ عَ شْن مَ كِ نَشّ.»<verse eid="JER 18:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="JER 18:5"/>«عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ،<verse eid="JER 18:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JER 18:6"/>‹عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 18:6">عِسِرَيِلَ بْنسْي، ﭑ تَن قَن قٍ رَبَمَ نّ وٌ رَ،</para>
  <para style="q" vid="JER 18:6">نَشَن مَنِيَشِ يِ قّحّ يَءِلَنيِ شَ وَلِ رَ.</para>
  <para style="q" vid="JER 18:6">عِسِرَيِلَ بْنسْي، وٌ نَ ﭑ بّلّشّ كُي</para>
  <para style="q" vid="JER 18:6">عَلْ بٌورَ نَ قّحّ يَءِلَنيِ بّلّشّ كِ نَشّ.<verse eid="JER 18:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JER 18:7"/>شَ ﭑ نَتّ تٌنفٌ سِ، شَ نَ مُ عَ رَ مَنفّيَ، رَبِرَقٍ رَ،</para>
  <para style="q" vid="JER 18:7">ﭑ شَ عٍ هَلَكِ، ﭑ شَ عٍ شُن نَكَنَ،<verse eid="JER 18:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 18:8"/>كْنْ عٍ قَ فبِلٍن عٍ شَ قٍ حَاشِ قْشْ رَ،</para>
  <para style="q" vid="JER 18:8">نَ تّمُي ﭑ قَن فبِلٍنمَ نّ ﭑ مَ نَتّ قْشْ رَ،</para>
  <para style="q" vid="JER 18:8">ﭑ مُ عٍ حَشَنكَتَمَ سْنْن.<verse eid="JER 18:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JER 18:9"/>شَ ﭑ نَتّ تٌنفٌ سِ، شَ نَ مُ عَ رَ مَنفّيَ، تِقٍ رَ،<verse eid="JER 18:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JER 18:10"/>كْنْ عٍ قَ قٍ حَاشِ رَبَ ﭑ نَ،</para>
  <para style="q" vid="JER 18:10">عٍ فبِلٍن ﭑ شُي قْشْ رَ،</para>
  <para style="q" vid="JER 18:10">نَ تّمُي ﭑ قَن فبِلٍنمَ نّ قٍ قَنيِ قْشْ رَ</para>
  <para style="q" vid="JER 18:10">ﭑ نُ وَ مَ نَشَن نَبَقٍ عٍ بّ.›»<verse eid="JER 18:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="JER 18:11"/>«عَ قَلَ يُدَيَكَيٍ نُن دَرِ سَلَمُكَيٍ بّ،</para>
  <para style="q" vid="JER 18:11">عَلَتَلَ بَرَ عَ مَسٍن،</para>
  <para style="q" vid="JER 18:11">‹ﭑ بَرَ نَتّ تٌنفٌ وٌ شِلِ مَ،</para>
  <para style="q" vid="JER 18:11">ﭑ شَ وٌ حَشَنكَتَ.</para>
  <para style="q" vid="JER 18:11">وٌ شَ فبِلٍن وٌ شَ كِرَ حَاشِ قْشْ رَ،</para>
  <para style="q" vid="JER 18:11">وٌ شَ وٌ حّرّ كِ مَسَرَ.›<verse eid="JER 18:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JER 18:12"/>كْنْ عٍ نَشَ عَ يَابِ،</para>
  <para style="q" vid="JER 18:12">‹نَ مُ قَمَ سْونّيَدٍ،</para>
  <para style="q" vid="JER 18:12">بَرِ مَ مُشُ تَن بِرَ مَ مُشُ شَشِلِ نَن قْشْ رَ.</para>
  <para style="q" vid="JER 18:12">مُشُ تَن بِرَ مَ مُشُ وَشْنقٍ نَن قْشْ رَ، هَلِ عَ حَاشُ.›»<verse eid="JER 18:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="JER 18:13"/>«عَلَتَلَ مَن بَرَ عٍ يَابِ،</para>
  <para style="q" vid="JER 18:13">‹وٌ شَ عَ مَتٌ شَ يِ مْولِ نُ بَرَ رَبَ سِيٍ تَفِ.</para>
  <para style="q" vid="JER 18:13">ندٍ بَرَ نَ قٍ مْولِ مّ سِندٍن؟</para>
  <para style="q" vid="JER 18:13">عِسِرَيِلَ سّنِيّنشِ بَرَ قٍ شْنشِ رَبَ.<verse eid="JER 18:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JER 18:14"/>شِنبٍلِ نْمَ كٍلِدٍ لِبَن فٍيَ قَرِ؟</para>
  <para style="q" vid="JER 18:14">شُرٍ شُنشُرِ نَشٍيٍ يٍ فٌرٌ مَ نَا، عٍ نْمَ شْرِدٍ؟›<verse eid="JER 18:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 18:15"/>كْنْ ﭑ مَ حَمَ تَن بَرَ نّيمُ ﭑ مَ قٍ رَ،</para>
  <para style="q" vid="JER 18:15">عٍ سُرَيِ فَن سّرّشّ رَ كُيٍيٍ بّ،</para>
  <para style="q" vid="JER 18:15">عٍ بِرَ كِرَ فبّتّ يَءِلَنتَرٍيٍ قْشْ رَ،</para>
  <para style="q" vid="JER 18:15">عٍ كِرَ قٌرِ لُ نَ.<verse eid="JER 18:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 18:16"/>عٍ بَرَ عَ نِيَ عٍ شَ بْشِ شَ فبَلٌي سْتْ.</para>
  <para style="q" vid="JER 18:16">دَنفِ مِشِيٍ نَ نَ تٌ، عٍ دّ عِشَرَ مَ نّ، عٍ قَ عٍ مَبٍرٍ.<verse eid="JER 18:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 18:17"/>ﭑ قَمَ نّ عٍ رَيٍنسٍندٍ عٍ يَشُييٍ يَ رَ،</para>
  <para style="q" vid="JER 18:17">عَلْ قٌيٍ نَشَن كٍلِمَ سٌفٍتٍدٍ.</para>
  <para style="q" vid="JER 18:17">ﭑ نَن ﭑ كٌبٍ رَ سٌمَ عٍ رَ فبَلٌي لْشْي.»<verse eid="JER 18:17"/></para>
  <para style="sp">عَننَبِ يٍرٍ مِ يَشُييٍ شَ مَسٍنيِ</para>
  <para style="p">
    <verse number="18" style="v" sid="JER 18:18"/>مِشِ ندٍيٍ بَرَ عَ قَلَ،</para>
  <para style="q" vid="JER 18:18">«وٌن شَ عَننَبِ يٍرٍ مِ شَ قٍ مَبٍرٍ بَرِ مَ</para>
  <para style="q" vid="JER 18:18">سّرّشّدُبّيٍ مُ حْنمَ نَشٍيٍ عَلَ شَ سّرِيّ مَسٍنمَ،</para>
  <para style="q" vid="JER 18:18">لْننِلَيٍ مُ حْنمَ نَشٍيٍ مِشِ رَ سِمَ،</para>
  <para style="q" vid="JER 18:18">نَمِحْنمّيٍ مُ حْنمَ نَشٍيٍ مَسٍنيِ تِمَ.</para>
  <para style="q" vid="JER 18:18">وٌن شَ وُلٍ سَ عَ شُن مَ، وٌن تٌندِ عَ شَ مَسٍنيِ رَ.»<verse eid="JER 18:18"/></para>
  <para style="sp">عَننَبِ يٍرٍ مِ شَ مَسٍنيِ عَلَتَلَ بّ</para>
  <para style="q">
    <verse number="19" style="v" sid="JER 18:19"/>«عَلَتَلَ، ﭑ مَلِ، عِ تُلِ مَتِ ﭑ يَشُييٍ وْيّن شُي رَ.<verse eid="JER 18:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 18:20"/>عٍ لَنمَ عٍ شَ قٍ قَنيِ مَسَرَ قٍ حَاشِ رَ؟</para>
  <para style="q" vid="JER 18:20">عٍ وَ مَ ﭑ قَشَقٍ نّ.</para>
  <para style="q" vid="JER 18:20">عِ شَ رَتُ عَ مَ ﭑ قِندِشِ عِ شَ شّيرَ نَن نَ،</para>
  <para style="q" vid="JER 18:20">عَلَكٌ عٍ شَ رَتَنفَ عِ شَ شْنّ مَ.<verse eid="JER 18:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JER 18:21"/>نَ كُي عِ شَ عٍ شَ دِيٍ قَشَ كَامّ رَ،</para>
  <para style="q" vid="JER 18:21">عِ شَ عٍ قَشَ سَنتِدّفّمَ رَ.</para>
  <para style="q" vid="JER 18:21">عٍ شَ فِنّيٍ شَ قِندِ دِبَرِتَرٍيٍ رَ،</para>
  <para style="q" vid="JER 18:21">شَ نَ مُ عَ رَ كَاحّ فِنّيٍ.</para>
  <para style="q" vid="JER 18:21">عِ شَ عَ لُ عٍ شَ مْرِيٍ شَ قَشَ،</para>
  <para style="q" vid="JER 18:21">عٍ شَ قٌنِكٍيٍ شَ بِرَ سَنتِدّفّمَ رَ.<verse eid="JER 18:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JER 18:22"/>عِ نَ عٍ يَشُييٍ شّي عٍ يِرٍ،</para>
  <para style="q" vid="JER 18:22">وَ شُي شَ مِنِ عٍ شَ بَنشِيٍ كُي،</para>
  <para style="q" vid="JER 18:22">بَرِ مَ عٍ بَرَ وَ ﭑ نَبِرَقٍ يِلِ كُي،</para>
  <para style="q" vid="JER 18:22">عٍ بَرَ وَ ﭑ سُشُقٍ فَنتَنيِ رَ.<verse eid="JER 18:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JER 18:23"/>عِ تَن عَلَتَلَ، عِ عٍ شَ مَحْشُنيِ كٌبِ بِرِن كٌلٌن،</para>
  <para style="q" vid="JER 18:23">عٍ وَ مَ نَشَن نَبَقٍ ﭑ نَ.</para>
  <para style="q" vid="JER 18:23">عِ نَشَ عٍ شَ يُنُبِ شَقَرِ.</para>
  <para style="q" vid="JER 18:23">عِ نَشَ دِحّ عٍ شَ يُنُبِ مَ.</para>
  <para style="q" vid="JER 18:23">عِ شَ عٍ رَبِرَ عِ يَ تٌدٍ رَ، عِ شَ شْنْ عٍ مَ عَ حَاشِ رَ.»<verse eid="JER 18:23"/></para>
  <chapter eid="JER 18"/>
  <chapter number="19" style="c" sid="JER 19"/>
  <para style="s">تٌقٍتِ شَ فبَلٌي</para>
  <para style="sp">عَلَتَلَ شَ مَسٍنيِ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 19:1"/>عَلَتَلَ نَشَ عَ مَسٍن، «سِفَ، عِ سَ قّحّ سَرَ قّحّ يَءِلَنيِ شْنيِ. حَمَ قٌرِيٍ نُن سّرّشّدُبّ قٌرِيٍ شَ عِ مَتِ. <verse eid="JER 19:1"/><verse number="2" style="v" sid="JER 19:2"/>عِ نَ فّ نَ سَرَدٍ، وٌ شَ مِنِ بٍتِ هِنٌمَ بِرِ رَ، ‹قّحّ نَادّ› نَ دّننَشّ بِرِ. مّننِ عِ شَ يِ مَسٍنيِ تِ، <verse eid="JER 19:2"/><verse number="3" style="v" sid="JER 19:3"/>‹يُدَيَ مَنفّ نُن دَرِ سَلَمُكَيٍ، وٌ وٌ تُلِ مَتِ عَلَتَلَ شَ مَسٍنيِ رَ.›»</para>
  <para style="q" vid="JER 19:3">«عِسِرَيِلَ مَنفّ عَلَتَلَ بَرَ عَ مَسٍن،</para>
  <para style="q" vid="JER 19:3">‹ﭑ قَمَ نّ بٍكَيٍ حَشَنكَتَدٍ عَ حَاشِ رَ.</para>
  <para style="q" vid="JER 19:3">ﭑ نَشَن نَبَمَ عٍ رَ، مِشِ يٌ مُ نَ قٍ مْولِ مّشِ سِندٍن.<verse eid="JER 19:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JER 19:4"/>ﭑ نَ رَبَمَ نّ بَرِ مَ عٍ بَرَ ﭑ نَبّحِن،</para>
  <para style="q" vid="JER 19:4">عٍ بَرَ يِ بْشِ قِندِ يِرٍ سّنِيّنتَرٍ رَ،</para>
  <para style="q" vid="JER 19:4">سُرَيِ فَنمَ سّرّشّ رَ كُيٍيٍ بّ دّننَشّ.</para>
  <para style="q" vid="JER 19:4">عَ سِنفٍ عٍ مُ نُ دَرِشِ نَ مْولِ رَ.</para>
  <para style="q" vid="JER 19:4">عٍ بَبَيٍ نُن يُدَيَ مَنفّيٍ مُ نُ نَ مْولِ رَبَمَ،</para>
  <para style="q" vid="JER 19:4">كْنْ يَكْسِ عٍ بَرَ مِشِيٍ نِي بَ،</para>
  <para style="q" vid="JER 19:4">نَشٍيٍ مُ قٍ حَاشِ يٌ رَبَشِ.<verse eid="JER 19:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JER 19:5"/>عٍ بَرَ بَتُدٍيٍ تِ بَلِ كُيٍ بّ فٍيَيٍ قَرِ،</para>
  <para style="q" vid="JER 19:5">عٍ عٍ شَ دِيٍ بَمَ سّرّشّ فَن دَاشِ رَ دّننَشّ.</para>
  <para style="q" vid="JER 19:5">ﭑ تَن مُ عٍ يَمَرِشِ نَ مْولِ رَ،</para>
  <para style="q" vid="JER 19:5">ﭑ مُ نَ مْولِ قَلَشِ،</para>
  <para style="q" vid="JER 19:5">نَ مْولِ مُ لُشِ ﭑ مَ مَحْشُنيِ يَ مَ.›»<verse eid="JER 19:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="JER 19:6"/>«عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 19:6">نَ نَن عَ رَ لْشْي قَمَ عَ لِدٍ</para>
  <para style="q" vid="JER 19:6">يِ بْشِ شِلِ مُ قَلَمَ تٌقٍتِ نُن بٍن هِنٌمَ سْنْن،</para>
  <para style="q" vid="JER 19:6">عَ قَمَ قَلَدٍ نّ ‹فبَلٌي فُلُنبَ.›<verse eid="JER 19:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JER 19:7"/>بٍ ﭑ يُدَيَ نُن دَرِ سَلَمُ وَشْنقٍ كَنَمَ نّ،</para>
  <para style="q" vid="JER 19:7">ﭑ عٍ رَبِرَ عٍ يَشُييٍ شَ سَنتِدّفّمَ رَ،</para>
  <para style="q" vid="JER 19:7">نَشٍيٍ وَ مَ عٍ سْنتْقٍ.</para>
  <para style="q" vid="JER 19:7">ﭑ عٍ بِنبِيٍ لُمَ شْنِيٍ نُن وُلَءِ سُبٍيٍ نَن بّ.<verse eid="JER 19:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 19:8"/>ﭑ يِ تَا كَنَمَ نّ،</para>
  <para style="q" vid="JER 19:8">عَ قَ قِندِ يَافِ رَ بٍكَيٍ بّ.</para>
  <para style="q" vid="JER 19:8">دَنفِ مِشِيٍ نَ يِ تَا كَنَشِ تٌ،</para>
  <para style="q" vid="JER 19:8">عٍ دّ عِشَرَ مَ نّ، عٍ قَ يٌ وٌ مَ.<verse eid="JER 19:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JER 19:9"/>عٍ يَشُي نَشٍيٍ وَ مَ عٍ سْنتْقٍ،</para>
  <para style="q" vid="JER 19:9">عٍ قَمَ نّ عٍ تْورْدٍ تَا كُي</para>
  <para style="q" vid="JER 19:9">هَن بٍكَيٍ عٍ يّتّ شَ دِيٍ نُن عٍ دْشْبٌورٍيٍ دٌن.»<verse eid="JER 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 19:10"/>«عِ نَ فّ نَ مَسٍنيِ تِدٍ، عِ شَ قّحّ عِبْو قٌرِيٍ يَ شْرِ نَشٍيٍ عِ مَتِشِ. عِ شَ عَ قَلَ عٍ بّ،<verse eid="JER 19:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JER 19:11"/>‹مَنفّ عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 19:11">ﭑ يِ حَمَ نُن عٍ شَ تَا شُن نَكَنَمَ نَ كِ نّ،</para>
  <para style="q" vid="JER 19:11">عَلْ قّحّ عِبْوشِ كِ نَشّ.</para>
  <para style="q" vid="JER 19:11">نَ قّحّ مُ يَءِلَنمَ سْنْن.</para>
  <para style="q" vid="JER 19:11">تٌقٍتِ قِندِ مَ مِشِ قَشَشِيٍ رَفَتَدٍ نَن نَ.›»<verse eid="JER 19:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="JER 19:12"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 19:12">«ﭑ يِ يِرٍ نُن عَ شَ مِشِيٍ لُمَ نّ عَلْ تٌقٍتِ.<verse eid="JER 19:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JER 19:13"/>دَرِ سَلَمُ بَنشِيٍ نُن يُدَيَ مَنفّ شَ بَنشِيٍ،</para>
  <para style="q" vid="JER 19:13">عٍ بِرِن قِندِ مَ يِرٍ سّنِيّنتَرٍ نَن نَ عَلْ تٌقٍتِ.</para>
  <para style="q" vid="JER 19:13">سِنفٍ رَ، مِشِيٍ بَرَ سُرَيِ فَن سّرّشّ رَ بَنشِيٍ قَرِ،</para>
  <para style="q" vid="JER 19:13">عٍ بَرَ تُنبُييٍ بَتُ،</para>
  <para style="q" vid="JER 19:13">عٍ بَرَ مِنسٍ بَ سّرّشّ رَ عَلَ فبّتّيٍ بّ.»<verse eid="JER 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 19:14"/>عَننَبِ يٍرٍ مِ نَشَ قَ كٍلِقٍ تٌقٍتِ، عَلَتَلَ مَسٍنيِ سٌشِ عَ يِ رَ دّننَشّ. عَ نَشَ تِ عَلَتَلَ شَ بَنشِ نَادّ رَ، عَ عَ قَلَ حَمَ بّ، <verse eid="JER 19:14"/><verse number="15" style="v" sid="JER 19:15"/>«عِسِرَيِلَ مَنفّ عَلَتَلَ بَرَ عَ مَسٍن، ‹ﭑ يِ تَا نُن عَ رَبِلِنيِ حَشَنكَتَمَ نّ. ﭑ قَمَ نّ فبَلٌي رَ عٍ بّ بَرِ مَ عٍ بَرَ عٍ كٌبٍ رَ سٌ ﭑ نَ، عٍ تٌندِ ﭑ مَ سّرِيّ رَ.›»<verse eid="JER 19:15"/></para>
  <chapter eid="JER 19"/>
  <chapter number="20" style="c" sid="JER 20"/>
  <para style="s">عَننَبِ يٍرٍ مِ شَ تْورّ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 20:1"/>سّرّشّدُبّ ثَسُرَ، عِمٍرِ شَ دِ، نَشَن قِندِشِ هْرْ مْبَنشِ يَرٍرَتِ رَ، عَ تٌ عَننَبِ يٍرٍ مِ شَ كَوَندِ مّ، <verse eid="JER 20:1"/><verse number="2" style="v" sid="JER 20:2"/>عَ نَشَ عَ سُشُ، عَ عَ بْنبْ، عَ عَ سَ كُتُنيِ رَ هْرْ مْبَنشِ سّيتِ مَ بُنيَمِن سٌدٍ دّ رَ. <verse eid="JER 20:2"/><verse number="3" style="v" sid="JER 20:3"/>كُيٍ تٌ عِبَ، ثَسُرَ نَشَ عَ رَ مِنِ، كْنْ عَننَبِ يٍرٍ مِ نَشَ عَ يَابِ، «عَلَتَلَ بَرَ عِ شِلِ مَسَرَ. عَ مُ قَلَمَ سْنْن ثَسُرَ، عَ قَلَمَ نّ قَ ‹مَفٌرِ مِسَبِبَ،› ‹حَشَنكَتّ يِرٍ.› <verse eid="JER 20:3"/><verse number="4" style="v" sid="JER 20:4"/>عَلَتَلَ نَشَ عَ مَسٍن، ‹ﭑ فَاشُي لُمَ نّ عِ تَن نُن عِ بٌورٍيٍ بْحّ مَ. عِ يَشُييٍ عِ بٌورٍيٍ قَشَمَ نّ سَنتِدّفّمَ رَ عِ يَ شْرِ. ﭑ يُدَيَ بْشِ قَن سَمَ نّ بَبِلْن مَنفّ بّلّشّ، عَ عٍ بْنبْ سَنتِدّفّمَ رَ، عَ قَ عٍ شَنِن بَبِلْن. <verse eid="JER 20:4"/><verse number="5" style="v" sid="JER 20:5"/>هَرِفٍ نُن نَاقُلِ نَشَن بِرِن نَ يِ تَا كُي، عَ نُن نَشَن نَ يُدَيَ مَنفّيٍ يِ رَ، ﭑ نَ بِرِن سٌمَ نّ وٌ يَشُييٍ يِ رَ يِ فٍرٍ كُي، عٍ شَ عَ شَنِن بَبِلْن. <verse eid="JER 20:5"/><verse number="6" style="v" sid="JER 20:6"/>عِ تَن ثَسُرَ، نُن عِ شَ مِشِيٍ، وٌ قَن سِفَمَ نّ كٌنيِيَ كُي بَبِلْن بْشِ مَ. عِ قَشَمَ مّننِ نّ، عِ رَفَتَ نَا، عِ تَن نُن عِ بٌورٍيٍ عِ نَشٍيٍ كَوَندِشِ وُلٍ رَ.›»<verse eid="JER 20:6"/></para>
  <para style="sp">عَننَبِ يٍرٍ مِ شَ مَسٍنيِ</para>
  <para style="q">
    <verse number="7" style="v" sid="JER 20:7"/>«عَلَتَلَ، عِ بَرَ ﭑ نَتَنتَن،</para>
  <para style="q" vid="JER 20:7">ﭑ قَن بَرَ ﭑ يّتّ لُ نَ تَنتَنيِ كُي.</para>
  <para style="q" vid="JER 20:7">عِ بَرَ ﭑ سُشُ، عِ بَرَ نْ ﭑ نَ.</para>
  <para style="q" vid="JER 20:7">لْشْي يٌ لْشْي عٍ ﭑ مَبٍرٍ مَ، عٍ بِرِن يٌمَ ﭑ مَ.<verse eid="JER 20:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 20:8"/>ﭑ مَ مَسٍنيِ بِرِن قِندِ مَ حَشَنكَتّ نُن فبَلٌي نَن نَ.</para>
  <para style="q" vid="JER 20:8">ﭑ نَ عَلَتَلَ شَ مَسٍنيِ تِ، حَمَ بِرِن يٌ ﭑ مَ.<verse eid="JER 20:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JER 20:9"/>شَ ﭑ نَ عَ قَلَ،</para>
  <para style="q" vid="JER 20:9">‹ﭑ مُ عَ شَ قٍ كَوَندِ مَ سْنْن،</para>
  <para style="q" vid="JER 20:9">ﭑ مُ وْيّنمَ عَ شِلِ رَ سْنْن،›</para>
  <para style="q" vid="JER 20:9">عَلَتَلَ شَ مَسٍنيِ لُمَ نّ عَلْ تّ ﭑ بْحّ كُي.</para>
  <para style="q" vid="JER 20:9">ﭑ مُ نْمَ نَ تّ رَشُبٍندٍ،</para>
  <para style="q" vid="JER 20:9">قٌ ﭑ شَ عَلَتَلَ شَ مَسٍنيِ تِ.<verse eid="JER 20:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JER 20:10"/>ﭑ بَرَ تْوحّفّ فبٍفبٍ مّ.</para>
  <para style="q" vid="JER 20:10">شَ ﭑ عَ قَلَ، ‹فبَلٌي نَ قَقٍ،›</para>
  <para style="q" vid="JER 20:10">مِشِ ندٍيٍ عَ قَلَ، ‹وٌن شَ عَ مَسٍن مَنفَسَنيِ بّ.›</para>
  <para style="q" vid="JER 20:10">ﭑ بٌورٍيٍ بِرِن نَ ﭑ مَتٌقٍ،</para>
  <para style="q" vid="JER 20:10">عَلَكٌ عٍ شَ ﭑ سُشُ تَنتَنيِ كُي.</para>
  <para style="q" vid="JER 20:10">عٍ عَ قَلَمَ، ‹تّمُندٍ وٌن نْمَ نّ عَ سُشُدٍ فَنتَنيِ رَ،</para>
  <para style="q" vid="JER 20:10">وٌن شَ نْ عَ رَ، وٌن شَ وٌن فبٍحْشْ عَ مَ.›<verse eid="JER 20:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JER 20:11"/>كْنْ عَلَتَلَ سّنبّمَ نَ ﭑ سّيتِ مَ.</para>
  <para style="q" vid="JER 20:11">ﭑ يَشُييٍ قَمَ نّ بِرَدٍ، عٍ مُ نْمَ ﭑ نَ.</para>
  <para style="q" vid="JER 20:11">نَ قِندِ مَ نّ يَافِ رَ عٍ بّ، عٍ شَشِلِ عِقُ.<verse eid="JER 20:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JER 20:12"/>مَنفّ عَلَتَلَ تِنشِنتْييٍ كٌلٌن،</para>
  <para style="q" vid="JER 20:12">عَ عٍ بْحّ نُن عٍ سٌندٌنيِ مَتٌمَ.</para>
  <para style="q" vid="JER 20:12">ﭑ عَ كٌلٌن عَلَتَلَ قَمَ نّ ﭑ فبٍحْشْدٍ عٍ مَ،</para>
  <para style="q" vid="JER 20:12">ﭑ شَشِلِ تِشِ عَ تَن نَن نَ.<verse eid="JER 20:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JER 20:13"/>وٌ عَلَتَلَ مَتْشْ، وٌ بّيتِ بَ عَ بّ،</para>
  <para style="q" vid="JER 20:13">بَرِ مَ عَ سٍتَرٍيٍ رَكِسِمَ نّ عٍ يَشُييٍ بّلّشّ.<verse eid="JER 20:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JER 20:14"/>ﭑ بَرِ لْشْي دَنكَشِ.</para>
  <para style="q" vid="JER 20:14">ﭑ نفَ ﭑ بَرِشِ لْشْي نَشّ، لْشْي قَنيِ مُ عَ رَ.<verse eid="JER 20:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 20:15"/>شّيرَ نَشَن ﭑ بَرِ قٍ قَلَ ﭑ بَبَ بّ،</para>
  <para style="q" vid="JER 20:15">مِشِ دَنكَشِ نَن نُ عَ رَ.</para>
  <para style="q" vid="JER 20:15">ﭑ بَبَ نُ بَرَ سّيوَ نَ شِبَارُ رَ،<verse eid="JER 20:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 20:16"/>كْنْ نَ شّيرَ شَ لُ عَلْ يِ تَايٍ،</para>
  <para style="q" vid="JER 20:16">عَلَتَلَ نَشٍيٍ هَلَكِشِ كِنِكِنِتَرٍحَ كُي.</para>
  <para style="q" vid="JER 20:16">عَ شَ عٍ فبٍلٍفبٍلٍ شُي مّ فّيسّفّ نُن يَنيِ رَ.<verse eid="JER 20:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 20:17"/>عَ نُ لَن نّ عَ شَ ﭑ قَشَ ﭑ نفَ تّيفّ،</para>
  <para style="q" vid="JER 20:17">ﭑ شَ رَفَتَ مّننِ عَبَدَن.<verse eid="JER 20:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JER 20:18"/>مُنقٍ رَ ﭑ قَ مِنِشِ دُنِحَ مَ،</para>
  <para style="q" vid="JER 20:18">ﭑ شَ يِ تْورّ نُن يِ قٍ شْنّ سْتْ،</para>
  <para style="q" vid="JER 20:18">ﭑ مَ دُنِحّءِفِرِ شَ قِندِ يَافِ رَ ﭑ بّ؟»<verse eid="JER 20:18"/></para>
  <chapter eid="JER 20"/>
  <chapter number="21" style="c" sid="JER 21"/>
  <para style="s">دَرِ سَلَمُ شَ فبَلٌي مَسٍنيِ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 21:1"/>عَلَتَلَ نَشَ يِ مَسٍنيِ تِ عَننَبِ يٍرٍ مِ بّ، مَنفّ سٍدٍكِيَ تٌ مَلَكِيَ شَ دِ ثَسُرَ نُن مَاسٍيَ شَ دِ سٍقَنِيَ سّرّشّدُبّ شّي عَ يِرٍ. عٍ نَشَ عَ قَلَ عَ بّ، <verse eid="JER 21:1"/><verse number="2" style="v" sid="JER 21:2"/>«عِ شَ عَلَتَلَ مَشَندِ مُشُ بّ بَرِ مَ بَبِلْن مَنفّ نٍبُكَدَنسَرِ نَ وٌن فٍرٍقٍ. تّمُندٍ عَلَتَلَ نْمَ كَابَنَكٌ ندٍ رَبَدٍ وٌن بّ عَلَكٌ نٍبُكَدَنسَرِ شَ مَكُيَ وٌن نَ.»<verse eid="JER 21:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 21:3"/>عَننَبِ يٍرٍ مِ نَشَ عٍ يَابِ، «وٌ شَ عَ قَلَ سٍدٍكِيَ بّ، <verse eid="JER 21:3"/><verse number="4" style="v" sid="JER 21:4"/>عِسِرَيِلَ مَرِفِ عَلَتَلَ بَرَ عَ مَسٍن، ‹وٌ بَبِلْن مَنفّ نُن عَ شَ سْورِيٍ فٍرٍ فٍرٍ سٌسٍ نَشَن نَ، ﭑ عَ نِيَمَ نّ عٍ شَ قِندِ وٌ شُن نَكَنَمَ رَ. نَشٍيٍ نَ وٌ فٍرٍقٍ تَا قَرِ مَ، عٍ قَمَ نّ سٌدٍ تَا كُي. <verse eid="JER 21:4"/><verse number="5" style="v" sid="JER 21:5"/>ﭑ تَن يَتِ فٍرٍ تِمَ نّ وٌ بّ سّنبّ رَ، بَرِ مَ ﭑ شْنْشِ وٌ مَ عَ حَاشِ رَ. ﭑ بْحّ بَرَ تٍ. <verse eid="JER 21:5"/><verse number="6" style="v" sid="JER 21:6"/>ﭑ قَمَ نّ يِ تَاكَيٍ بْنبْدٍ، شّمّيٍ نُن شُرُ سٍيٍ، عَلَكٌ عٍ شَ قَشَ قُرٍ حَاشِ مَ. <verse eid="JER 21:6"/><verse number="7" style="v" sid="JER 21:7"/>نَ دَنفِ شَنبِ، يُدَيَ مَنفّ سٍدٍكِيَ، عَ شَ مِشِيٍ، نُن حَمَ نَشَن مُ قَمَ قَشَدٍ قُرٍ، سَنتِدّفّمَ، نُن كَامّ رَ يِ تَا كُي، ﭑ قَمَ نّ عٍ سٌدٍ عٍ يَشُي بَبِلْن مَنفّ نٍبُكَدَنسَرِ يِ رَ، نَشَن وَ مَ عٍ نِي بَقٍ. عَ قَمَ نّ عٍ بْنبْدٍ سَنتِدّفّمَ رَ، عَ مُ كِنِكِنِمَ عٍ مَ قٍقٍ مَ. عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.›»<verse eid="JER 21:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 21:8"/>«عِ شَ عَ قَلَ حَمَ بّ، عَلَتَلَ بَرَ عَ مَسٍن، ‹ﭑ وٌ تِمَ نّ كِرَ قِرِن شْن مَ. كٍرٍن قِندِ كِسِ كِرَ رَ، بٌورٍ قِندِ قَشّ كِرَ رَ. <verse eid="JER 21:8"/><verse number="9" style="v" sid="JER 21:9"/>نَشَن لُمَ يِ تَا كُي، عَ قَمَ نّ قَشَدٍ سَنتِدّفّمَ، كَامّ، نُن قُرٍ رَ، كْنْ نَشَن عَ يّتّ قِمَ بَبِلْنكَيٍ مَ نَشٍيٍ بَرَ وٌ شَ تَا رَبِلِن، نَ كَنيِ كِسِمَ نّ. <verse eid="JER 21:9"/><verse number="10" style="v" sid="JER 21:10"/>ﭑ بَرَ نَتّ تٌنفٌ ﭑ شَ قٍ حَاشِ رَبَ يِ تَا رَ. ﭑ مُ هِننّمَ عَ رَ. ﭑ عَ سٌمَ نّ بَبِلْن مَنفّ يِ رَ، عَ قَ عَ فَن تّ رَ. عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.›»<verse eid="JER 21:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JER 21:11"/>«عِ شَ عَ قَلَ يُدَيَ مَنفّ بْنسْي بّ،</para>
  <para style="q" vid="JER 21:11">وٌ وٌ تُلِ مَتِ عَلَتَلَ رَ.<verse eid="JER 21:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JER 21:12"/>دَوُدَ بْنسْي، عَلَتَلَ بَرَ عَ مَسٍن،</para>
  <para style="q" vid="JER 21:12">وٌ شَ كِيتِ تِنشِنشِ سَ فّيسّفّ يٌ فّيسّفّ،</para>
  <para style="q" vid="JER 21:12">وٌ شَ تْورْ مِشِ رَتَنفَ مِشِ كٌبِ مَ،</para>
  <para style="q" vid="JER 21:12">عَلَكٌ ﭑ نَشَ شْنْ وٌ مَ،</para>
  <para style="q" vid="JER 21:12">عَ قَ لُ عَلْ تّ نَشَن مُ شُبٍنمَ وٌ شَ كٌبِحَ شَ قٍ رَ.<verse eid="JER 21:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JER 21:13"/>ﭑ بَرَ شْنْ وٌ مَ،</para>
  <para style="q" vid="JER 21:13">وٌ تَن نَشٍيٍ سَبَتِشِ يِ فُلُنبَ يِرٍ،</para>
  <para style="q" vid="JER 21:13">وٌ تَن نَشٍيٍ لُشِ عَلْ فّمّيٍ قِيلِ مَ،</para>
  <para style="q" vid="JER 21:13">وٌ تَن نَشٍيٍ عَ قَلَمَ،</para>
  <para style="q" vid="JER 21:13">‹ندٍ نْمَ وٌن نَ؟ ندٍ نْمَ سٌدٍ وٌن شْنيِ؟›»</para>
  <para style="q" vid="JER 21:13">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="JER 21:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="JER 21:14"/>«ﭑ قَمَ نّ وٌ حَشَنكَتَدٍ وٌ شَ يُنُبِيٍ شَ قٍ رَ،</para>
  <para style="q" vid="JER 21:14">ﭑ تّ سٌ وٌ شْنيِ رَ نَشَن وٌ بِرِن فَنمَ.»</para>
  <para style="q" vid="JER 21:14">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="JER 21:14"/></para>
  <chapter eid="JER 21"/>
  <chapter number="22" style="c" sid="JER 22"/>
  <para style="s">يُدَيَ مَنفّ شَ فبَلٌي</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 22:1"/>عَلَتَلَ بَرَ عَ مَسٍن، «سِفَ يُدَيَ مَنفّ شْنيِ يِ مَسٍنيِ رَ. <verse eid="JER 22:1"/><verse number="2" style="v" sid="JER 22:2"/>عِ شَ عَ قَلَ عَ بّ، ‹يُدَيَ مَنفّ، عِ تَن نَشَن نَ دَوُدَ شَ كِبَنيِ كُي، عِ تَن، عِ شَ مِشِيٍ، نُن عِ شَ حَمَ نَشَن سٌمَ يِ نَادّ رَ، وٌ وٌ تُلِ مَتِ عَلَتَلَ رَ. <verse eid="JER 22:2"/><verse number="3" style="v" sid="JER 22:3"/>عَلَتَلَ بَرَ عَ مَسٍن، وٌ شَ تِنشِن، وٌ شَ سّرِيّ رَبَتُ. وٌ شَ تْورْ مِشِ رَتَنفَ مِشِ كٌبِ مَ. وٌ نَشَ شْحّ، كِرِدِ، نُن كَاحّ فِنّ تْورْ. وٌ نَشَ قٍ حَاشِ رَبَ، وٌ نَشَ كٌبِ، وٌ نَشَ مِشِ نِي بَ يِ بْشِ مَ. <verse eid="JER 22:3"/><verse number="4" style="v" sid="JER 22:4"/>شَ عَ سَ لِ وٌ نَشَ بِرَ يِ سّرِيّ قْشْ رَ، مَنفّ نَشٍيٍ دْشْمَ دَوُدَ شَ كِبَنيِ كُي، عٍ قَمَ نّ سٌدٍ تَا كُي سٌي نُن سْورِ رَفِسٍيٍ قَرِ، عٍ تَن نُن عٍ شَ مِشِيٍ، نُن عٍ شَ حَمَ. <verse eid="JER 22:4"/><verse number="5" style="v" sid="JER 22:5"/>كْنْ شَ وٌ مُ يِ سّرِيّ رَبَتُ، ﭑ بَرَ ﭑ كَلِ ﭑ يّتّ رَ، يِ بْنسْي شُن نَكَنَمَ نّ. عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.›»<verse eid="JER 22:5"/></para>
  <para style="sp">عَلَتَلَ شَ مَسٍنيِ</para>
  <para style="q">
    <verse number="6" style="v" sid="JER 22:6"/>عَلَتَلَ بَرَ عَ مَسٍن يُدَيَ مَنفّ بّ عَ بْنسْي شَ قٍ رَ،</para>
  <para style="q" vid="JER 22:6">«عِ بَرَ لُ عَلْ فَلَدِ ﭑ بّ، عِ بَرَ لُ عَلْ لِبَن فٍيَ،</para>
  <para style="q" vid="JER 22:6">كْنْ ﭑ بٍكَيٍ كٍرِ مَ نّ، ﭑ بٍ قِندِ فبٍنفبٍرٍنيِ رَ.<verse eid="JER 22:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JER 22:7"/>ﭑ سْورِيٍ شّيمَ نّ فٍرٍ سٌسٍيٍ رَ،</para>
  <para style="q" vid="JER 22:7">عٍ شَ سّدِرِ وُرِيٍ شَبَ، عٍ شَ عٍ فَن.<verse eid="JER 22:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 22:8"/>سِ فبٍفبٍ دَنفِمَ نّ نَا، عٍ قَ عَ قَلَ عٍ بٌورٍ بّ،</para>
  <para style="q" vid="JER 22:8">‹مُنقٍ رَ عَلَتَلَ يِ مْولِ رَبَشِ يِ تَا شُنفبٍ رَ؟›<verse eid="JER 22:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JER 22:9"/>ندٍ عٍ يَابِمَ نّ، ‹عٍ مَرِفِ عَلَتَلَ نَ رَبَشِ نّ</para>
  <para style="q" vid="JER 22:9">بَرِ مَ عٍ بَرَ عَ شَ سَاتّ رَبّحِن،</para>
  <para style="q" vid="JER 22:9">عٍ قَ عَلَ فبّتّيٍ بَتُ، عٍ تُوبِ عٍ بّ.›»<verse eid="JER 22:9"/></para>
  <para style="sp">عَننَبِ يٍرٍ مِ شَ مَسٍنيِ</para>
  <para style="q">
    <verse number="10" style="v" sid="JER 22:10"/>«وٌ نَشَ حْنقٍ رَبَ مِشِ قَشَشِيٍ بّ،</para>
  <para style="q" vid="JER 22:10">وٌ نَشَ سُننُن.</para>
  <para style="q" vid="JER 22:10">وٌ شَ وَ مِشِيٍ بّ نَشٍيٍ شَنِنمَ حَمَنّ مَ،</para>
  <para style="q" vid="JER 22:10">بَرِ مَ عٍ مُ فبِلٍنمَ عٍ شْنيِ عَبَدَن.<verse eid="JER 22:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JER 22:11"/>عَلَتَلَ بَرَ عَ مَسٍن يٌسِيَ شَ دِ سَلُمُ شَ قٍ رَ،</para>
  <para style="q" vid="JER 22:11">نَشَن نُ بَرَ تِ مَنفّ رَ عَ بَبَ حْشْي رَ،</para>
  <para style="q" vid="JER 22:11">‹عَ مُ فبِلٍنمَ عَبَدَن.<verse eid="JER 22:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JER 22:12"/>عَ قَشَمَ حَمَنّ نَن مَ عٍ عَ شَنِنمَ دّننَشّ.</para>
  <para style="q" vid="JER 22:12">عَ مُ يِ بْشِ تٌمَ سْنْن.›»<verse eid="JER 22:12"/></para>
  <para style="sp">عَلَتَلَ شَ مَسٍنيِ</para>
  <para style="q">
    <verse number="13" style="v" sid="JER 22:13"/>«حَشَنكَتّ نَ مِشِ بّ</para>
  <para style="q" vid="JER 22:13">نَشَن بَنشِ تِمَ تِنشِنتَرٍيَ كُي،</para>
  <para style="q" vid="JER 22:13">نَشَن عَ قَرِ عِدْشْمَ مُحّ سَابُي رَ،</para>
  <para style="q" vid="JER 22:13">نَشَن مِشِ رَوَلِمَ تْورّ كُي،</para>
  <para style="q" vid="JER 22:13">عَ تٌندِ سَرٍ سٌدٍ عَ شَ وَلِكّ يِ رَ.<verse eid="JER 22:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JER 22:14"/>حَشَنكَتّ نَ مِشِ بّ نَشَن عَ قَلَمَ،</para>
  <para style="q" vid="JER 22:14">‹ﭑ شَ بَنشِ بٍلٍبٍلٍ تِ ﭑ يّتّ بّ،</para>
  <para style="q" vid="JER 22:14">نَشَن كُي فبٌ، وُندّرِ وُيَ نَشَن مَ،</para>
  <para style="q" vid="JER 22:14">نَشَن شُنمَسَشِ سّدِرِ وُرِ رَ،</para>
  <para style="q" vid="JER 22:14">نَشَن مَسٌشِ سٍ فبٍيلِ رَ.›<verse eid="JER 22:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 22:15"/>عِ قِندِشِ مَنفّ رَ سّدِرِ وُرِ نَن مَ قٍ رَ؟</para>
  <para style="q" vid="JER 22:15">عِ بَبَ مُ بَلٌي نُن مِنسٍ سْتْشِ شّ؟</para>
  <para style="q" vid="JER 22:15">كْنْ عَ نَشَ تِنشِنيِ نُن قٍ قَنيِ رَبَ،</para>
  <para style="q" vid="JER 22:15">نَ نَن قِندِشِ سْونّيَ رَ عَ بّ.<verse eid="JER 22:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 22:16"/>عَ نَشَ سٍتَرٍ نُن تْورْ مِشِ رَتَنفَ،</para>
  <para style="q" vid="JER 22:16">نَ نَن قِندِشِ سْونّيَ رَ عَ بّ.</para>
  <para style="q" vid="JER 22:16">نَ بِرِن عَ مَسٍنشِ نّ عَ بَرَ ﭑ كٌلٌن.»</para>
  <para style="q" vid="JER 22:16">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="JER 22:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="JER 22:17"/>«كْنْ عِ تَن بِرَ مَ عِ يّتّ شَ فٍينِ نَن تُن قْشْ رَ،</para>
  <para style="q" vid="JER 22:17">هَلِ نَ قَ قِندِ قَشّ تِقٍ رَ،</para>
  <para style="q" vid="JER 22:17">هَلِ نَ قَ قِندِ مِشِ تْورْقٍ رَ.<verse eid="JER 22:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JER 22:18"/>نَ نَن عَ تٌشِ عَلَتَلَ مَسٍنيِ تِشِ</para>
  <para style="q" vid="JER 22:18">يٌسِيَ شَ دِ يٍهٌيَكِمِ شَ قٍ رَ، يُدَيَ مَنفّ،</para>
  <para style="q" vid="JER 22:18">‹عٍ مُ نْمَ عَ بِنيَدٍ حْنقٍ رَ،</para>
  <para style="q" vid="JER 22:18">عٍ مُ عَ قَلَمَ، ﭑ تَارَ، ﭑ مَرِفِ.›<verse eid="JER 22:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JER 22:19"/>عٍ مُ عَ رَفَتَمَ،</para>
  <para style="q" vid="JER 22:19">عَ لُمَ نّ عَلْ سٌقَلٍ قَشَشِ نَشَن وْلّمَ دَرِ سَلَمُ قَرِ مَ.»<verse eid="JER 22:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="JER 22:20"/>«وٌ شَ تٍ لِبَن،</para>
  <para style="q" vid="JER 22:20">وٌ شَ وٌ شُي عِتٍ بَسَن بْشِ مَ،</para>
  <para style="q" vid="JER 22:20">وٌ شَ فبٍلٍفبٍلٍ عَبَرِ مِ،</para>
  <para style="q" vid="JER 22:20">بَرِ مَ وٌ دّقَنبٌورٍ بِرِن بَرَ بِرَ.<verse eid="JER 22:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JER 22:21"/>بٍينُن تْورّ شَ وٌ سُشُ،</para>
  <para style="q" vid="JER 22:21">ﭑ نُ بَرَ مَسٍنيِ تِ وٌ بّ،</para>
  <para style="q" vid="JER 22:21">كْنْ وٌ مُ تِن نَ رَ مّدٍ.</para>
  <para style="q" vid="JER 22:21">وٌ نَ نَ كِ نّ كَبِ وٌ دِ مّدِ تّمُي،</para>
  <para style="q" vid="JER 22:21">وٌ مُ وَ مَ ﭑ مَ سّرِيّ رَبَتُقٍ.<verse eid="JER 22:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JER 22:22"/>وٌ شَ يَرٍرَتِيٍ بَرَ لْي عَلْ قٌيٍ،</para>
  <para style="q" vid="JER 22:22">وٌ مّينِمَيٍ بَرَ سِفَ كٌنيِيَ كُي.</para>
  <para style="q" vid="JER 22:22">وٌ تَن بَرَ يَافِ، وٌ شَشِلِ بَرَ عِقُ وٌ شَ كٌبِحَ شَ قٍ رَ.<verse eid="JER 22:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JER 22:23"/>وٌ تَن نَشٍيٍ نَ لِبَن،</para>
  <para style="q" vid="JER 22:23">نَشٍيٍ لُشِ عَلْ شْنِيٍ عٍ تّي كُي سّدِرِ وُرِ كْن نَ،</para>
  <para style="q" vid="JER 22:23">وٌ قَمَ نّ تْورْدٍ عَ حَاشِ رَ فبَلٌي شَ قٍ رَ.</para>
  <para style="q" vid="JER 22:23">وٌ قَمَ نّ لُدٍ تْورّ كُي عَلْ فِنّ نَشَن نَ دِ بَرِقٍ.»<verse eid="JER 22:23"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="24" style="v" sid="JER 22:24"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 22:24">«ﭑ بَرَ ﭑ كَلِ،</para>
  <para style="q" vid="JER 22:24">هَلِ يٍهٌيَكِمِ شَ دِ يٍكٌيَكِنِ، يُدَيَ مَنفّ،</para>
  <para style="q" vid="JER 22:24">سَ قَتُ ﭑ مَ عَلْ ﭑ مَ شُرُندّ قَنيِ،</para>
  <para style="q" vid="JER 22:24">ﭑ مُ تٌندِ مَ نَ بَدٍ ﭑ بّلّشّ رَ.<verse eid="JER 22:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JER 22:25"/>ﭑ عِ سٌمَ عِ يَشُييٍ نَن يِ رَ نَشٍيٍ وَ مَ عِ سْنتْقٍ،</para>
  <para style="q" vid="JER 22:25">عِ فَاشُمَ نَشٍيٍ يَ رَ،</para>
  <para style="q" vid="JER 22:25">نٍبُكَدَنسَرِ، بَبِلْن مَنفّ، نُن بَبِلْنكَيٍ.<verse eid="JER 22:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JER 22:26"/>ﭑ وٌ كٍرِ مَ نّ حَمَنّ مَ، عِ تَن نُن عِ نفَ،</para>
  <para style="q" vid="JER 22:26">وٌ مُ بَرِشِ دّننَشّ.</para>
  <para style="q" vid="JER 22:26">وٌ قَشَمَ نَا نّ.<verse eid="JER 22:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="JER 22:27"/>وٌ مُ فبِلٍنمَ وٌ شْنيِ سْنْن، وٌ وَ مَ لُقٍ دّننَشّ.</para>
  <para style="q" vid="JER 22:27">وٌ مُ فبِلٍنمَ نَا عَبَدَن.»<verse eid="JER 22:27"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="28" style="v" sid="JER 22:28"/>«يٍهٌيَكِنِ بَرَ لُ عَلْ قّحّ عِبْوشِ،</para>
  <para style="q" vid="JER 22:28">مِشِ مُ وَ مَ نَشَن شْن؟</para>
  <para style="q" vid="JER 22:28">مُنقٍ رَ عٍ عَ تَن نُن عَ شَ دِيٍ كٍرِ مَ حَمَنّ مَ، عٍ مُ دّننَشّ كٌلٌن؟<verse eid="JER 22:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="JER 22:29"/>ﭑ مَ حَمَ نَشَن سَبَتِشِ ﭑ مَ بْشِ مَ،</para>
  <para style="q" vid="JER 22:29">وٌ شَ وٌ تُلِ مَتِ عَلَتَلَ رَ.<verse eid="JER 22:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="JER 22:30"/>عَلَتَلَ بَرَ عَ مَسٍن،</para>
  <para style="q" vid="JER 22:30">‹وٌ شَ سّبّلِ تِ يِ مِشِ شَ قٍ رَ،</para>
  <para style="q" vid="JER 22:30">عَ مُ دِ سْتْمَ،</para>
  <para style="q" vid="JER 22:30">عَ شَ دُنِحّءِفِرِ مُ سْونّيَمَ،</para>
  <para style="q" vid="JER 22:30">عَ شَ دِ يٌ مُ لُمَ دَوُدَ شَ كِبَنيِ كُي،</para>
  <para style="q" vid="JER 22:30">عَ شَ دِ يٌ مُ يُدَيَ يَمَرِ مَ سْنْن.›»<verse eid="JER 22:30"/></para>
  <chapter eid="JER 22"/>
  <chapter number="23" style="c" sid="JER 23"/>
  <para style="s">عَلَتَلَ شَ شّيرَ تِنشِنشِ</para>
  <para style="sp">عَلَتَلَ شَ مَسٍنيِ</para>
  <para style="q">
    <verse number="1" style="v" sid="JER 23:1"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 23:1">«حَشَنكَتّ نَ ﭑ مَ حَمَ يَرٍرَتِيٍ بّ</para>
  <para style="q" vid="JER 23:1">نَشٍيٍ بَرَ ﭑ مَ حَمَ رَلْي، عٍ بَرَ عٍ رَيٍنسٍن.<verse eid="JER 23:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JER 23:2"/>عِسِرَيِلَ مَرِفِ عَلَتَلَ بَرَ عَ مَسٍن عَ شَ حَمَ يَرٍرَتِيٍ شَ قٍ رَ،</para>
  <para style="q" vid="JER 23:2">وٌ بَرَ ﭑ مَ حَمَ رَيٍنسٍن نّ، وٌ بَرَ عٍ كٍرِ.</para>
  <para style="q" vid="JER 23:2">وٌ مُ مّينِشِ عٍ مَ.</para>
  <para style="q" vid="JER 23:2">ﭑ قَمَ وٌ حَشَنكَتَدٍ وٌ شَ كٌبِحَ نَن مَ.»</para>
  <para style="q" vid="JER 23:2">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="JER 23:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="JER 23:3"/>«ﭑ قَمَ نّ ﭑ مَ حَمَ بِرِن نَ،</para>
  <para style="q" vid="JER 23:3">ﭑ نُ بَرَ نَشَن شَنِن حَمَنّ مَ.</para>
  <para style="q" vid="JER 23:3">ﭑ قَمَ نّ عٍ رَفبِلٍندٍ عٍ شْنيِ</para>
  <para style="q" vid="JER 23:3">عَلَكٌ عٍ مَن شَ وُيَ، عٍ شَ قٍ مَن شَ سْونّيَ.<verse eid="JER 23:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JER 23:4"/>ﭑ يَرٍرَتِيٍ تِمَ نّ عٍ بّ نَشٍيٍ مّينِمَ عٍ مَ.</para>
  <para style="q" vid="JER 23:4">عٍ مُ فَاشُمَ سْنْن، عٍ مُ سّرّنمَ.</para>
  <para style="q" vid="JER 23:4">ﭑ عٍ هَيِ بِرِن قَنمَ نّ عٍ بّ.»</para>
  <para style="q" vid="JER 23:4">عَلَتَلَ بَرَ نَ مَسٍن.<verse eid="JER 23:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="JER 23:5"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 23:5">«لْشْي قَمَ نّ قَدٍ ﭑ دَوُدَ شَ دِ تِنشِنشِ رَكٍلِمَ لْشْي نَشّ.</para>
  <para style="q" vid="JER 23:5">عَ حَمَ يَمَرِ مَ نّ لْننِ، تِنشِنيِ، نُن سّرِيّ رَ بْشِ كُي.<verse eid="JER 23:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JER 23:6"/>نَ وَشَتِ يُدَيَ كِسِمَ نّ،</para>
  <para style="q" vid="JER 23:6">عِسِرَيِلَ بْحّسَ سْتْ،</para>
  <para style="q" vid="JER 23:6">مِشِيٍ عَ قَلَ، ‹عَلَتَلَ قِندِشِ وٌن مَ تِنشِنيِ نَن نَ.›»<verse eid="JER 23:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="JER 23:7"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 23:7">«لْشْي قَمَ قَدٍ مِشِ مُ عَ قَلَمَ،</para>
  <para style="q" vid="JER 23:7">‹عَلَتَلَ حِحّ نَشَن عِسِرَيِلَكَيٍ رَ مِنِشِ مِسِرَ بْشِ رَ.›<verse eid="JER 23:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 23:8"/>عٍ عَ قَلَمَ نّ، ‹وٌن بَرَ وٌن كَلِ عَلَتَلَ شِلِ رَ،</para>
  <para style="q" vid="JER 23:8">نَشَن عِسِرَيِلَ بْنسْي رَكٍلِشِ،</para>
  <para style="q" vid="JER 23:8">عَ عٍ رَ مِنِ حَمَنّ رَ نَشَن نَ كْولَ مَ</para>
  <para style="q" vid="JER 23:8">عَ نُن يِرٍ بِرِن عَ عٍ كٍرِشِ دّننَشّ.</para>
  <para style="q" vid="JER 23:8">عٍ مَن قَمَ نّ عٍ شَ بْشِ رَ سَبَتِدٍ.›»<verse eid="JER 23:8"/></para>
  <para style="sp">عَننَبِ يٍرٍ مِ شَ مَسٍنيِ</para>
  <para style="q">
    <verse number="9" style="v" sid="JER 23:9"/>«مَسٍنيِيٍ نَن يَ نَمِحْنمّيٍ شَ قٍ رَ؛</para>
  <para style="q" vid="JER 23:9">ﭑ بْحّ بَرَ كِنِكِنِ.</para>
  <para style="q" vid="JER 23:9">ﭑ شْرِ بِرِن نَ سّرّنقٍ،</para>
  <para style="q" vid="JER 23:9">ﭑ لُشِ نّ عَلْ سِيسِلَ بَرِ مَ عَلَتَلَ شَ مَسٍنيِ سّنِيّنشِ شْرْشْ.»<verse eid="JER 23:9"/></para>
  <para style="sp">عَلَتَلَ شَ مَسٍنيِ</para>
  <para style="q">
    <verse number="10" style="v" sid="JER 23:10"/>«يِ بْشِ رَقٍشِ يّنّلَيٍ نَن نَ.</para>
  <para style="q" vid="JER 23:10">بْشِ يَتِ يَتِ نَ دَنكّ كُي نَ نَن مَ،</para>
  <para style="q" vid="JER 23:10">قِيلِ بَرَ شَرَ، حٌوفٍ بَرَ حْن.</para>
  <para style="q" vid="JER 23:10">مِشِ مَقُرَ تِنشِنتَرٍيَ رَبَدٍ.</para>
  <para style="q" vid="JER 23:10">عٍ سُو سَمَ نَ رَ عَ قَنيِ رَ.<verse eid="JER 23:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JER 23:11"/>نَمِحْنمّ نُن سّرّشّدُبّ مُ تِنشِن.</para>
  <para style="q" vid="JER 23:11">ﭑ بَرَ كٌبِحَ تٌ ﭑ مَ بَنشِ كُي.»</para>
  <para style="q" vid="JER 23:11">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="JER 23:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="JER 23:12"/>«نَ نَن عَ رَ عٍ شَ كِرَ شْرْشْ.</para>
  <para style="q" vid="JER 23:12">دِ مِ بَرَ سِن عٍ شُن مَ.</para>
  <para style="q" vid="JER 23:12">عٍ لُمَ نّ بِرَ رَ،</para>
  <para style="q" vid="JER 23:12">بَرِ مَ ﭑ بَرَ نَتّ تٌنفٌ ﭑ شَ عٍ حَشَنكَتَ.</para>
  <para style="q" vid="JER 23:12">نَ وَشَتِ نَ قَقٍ.»</para>
  <para style="q" vid="JER 23:12">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="JER 23:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="JER 23:13"/>«ﭑ بَرَ قٍ حَاشِيٍ تٌ نَمِحْنمّ سَمَرِكَيٍ يَ مَ.</para>
  <para style="q" vid="JER 23:13">عٍ نَ مَسٍنيِ تِقٍ بَلِ شِلِ رَ،</para>
  <para style="q" vid="JER 23:13">عٍ بَرَ ﭑ مَ حَمَ عِسِرَيِلَ رَلْي.<verse eid="JER 23:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JER 23:14"/>ﭑ مَن بَرَ قٍ رَتْنشِيٍ تٌ نَمِحْنمّ دَرِ سَلَمُكَيٍ يَ مَ.</para>
  <para style="q" vid="JER 23:14">عٍ قِندِشِ يّنّلَيٍ نَن نَ، عٍ حّرّ مَ وُلٍ رَ،</para>
  <para style="q" vid="JER 23:14">عٍ تِنشِنتَرٍيٍ مَلِمَ عَلَكٌ عٍ نَشَ فبِلٍن عٍ شَ وَلِ كٌبِ قْشْ رَ.</para>
  <para style="q" vid="JER 23:14">عٍ بَرَ لُ ﭑ بّ عَلْ سٌدٌ مَكَيٍ،</para>
  <para style="q" vid="JER 23:14">عٍ شَ مِشِيٍ مَنِيَشِ فٌمٌرَكَيٍ نَن نَ.»<verse eid="JER 23:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="JER 23:15"/>نَ نَن عَ رَ مَنفّ عَلَتَلَ عَ مَسٍنشِ نَمِحْنمّيٍ شَ قٍ رَ،</para>
  <para style="q" vid="JER 23:15">«ﭑ قٍ شْنّ سٌمَ نّ عِ يِ رَ بَلٌي رَ،</para>
  <para style="q" vid="JER 23:15">ﭑ يٍ حَاشِ سٌ عِ يِ رَ مِنسٍ رَ،</para>
  <para style="q" vid="JER 23:15">بَرِ مَ دَرِ سَلَمُ نَمِحْنمّيٍ بَرَ عَ نِيَ</para>
  <para style="q" vid="JER 23:15">ﭑ مَ بْشِ بِرِن شَ قِندِ بْشِ سّنِيّنتَرٍ رَ.»<verse eid="JER 23:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="JER 23:16"/>عَلَتَلَ بَرَ عَ مَسٍن،</para>
  <para style="q" vid="JER 23:16">«وٌ نَشَ وٌ تُلِ مَتِ نَمِحْنمّيٍ شَ مَسٍنيِ رَ.</para>
  <para style="q" vid="JER 23:16">عٍ نَشَن مَسٍنمَ وٌ بّ عَ قِندِشِ وُلٍ نَن نَ.</para>
  <para style="q" vid="JER 23:16">عٍ لَامَتُنيِيٍ شَ قٍ قَلَمَ وٌ بّ</para>
  <para style="q" vid="JER 23:16">نَشٍيٍ قَتَنشِ عٍ يّتّ شَشِلِ مَ.</para>
  <para style="q" vid="JER 23:16">عَلَتَلَ شَ مُ عَ مَسٍنشِ.<verse eid="JER 23:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 23:17"/>عٍ بَرَ سُو سَ عَ قَلَدٍ ﭑ مَتَندِلَيٍ بّ،</para>
  <para style="q" vid="JER 23:17">‹عَلَتَلَ نَشّ وٌ بْحّسَ سْتْمَ نّ.›</para>
  <para style="q" vid="JER 23:17">عٍ مَن نُ عَ قَلَ مِشِيٍ بّ،</para>
  <para style="q" vid="JER 23:17">نَشٍيٍ بِرَ مَ عٍ يّتّ وَشْنقٍ قْشْ رَ،</para>
  <para style="q" vid="JER 23:17">‹قٍ حَاشِ يٌ مُ وٌ سْتْمَ.›<verse eid="JER 23:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JER 23:18"/>ندٍ بَرَ تِ عَلَتَلَ سّيتِ مَ، عَ شَ عَ شَ مَسٍنيِ رَ مّ؟</para>
  <para style="q" vid="JER 23:18">ندٍ بَرَ عَ تُلِ مَتِ عَ شَ مَسٍنيِ رَ؟</para>
  <para style="q" vid="JER 23:18">ندٍ بَرَ نَ مّ؟<verse eid="JER 23:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JER 23:19"/>عَلَتَلَ بَرَ شْنْ مِشِ حَاشِ مَ.</para>
  <para style="q" vid="JER 23:19">نَ لُشِ نّ عَلْ قٌيٍ شُنفبٍ نَشَن دَنفِمَ عٍ شُن مَ.<verse eid="JER 23:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 23:20"/>عَلَتَلَ شَ شْنّ مُ فبِلٍنمَ،</para>
  <para style="q" vid="JER 23:20">قٌ عَ شَ كَمَلِ،</para>
  <para style="q" vid="JER 23:20">قٌ عَ شَ نَتّ بِرِن شَ رَبَ.</para>
  <para style="q" vid="JER 23:20">نَ بِرِن نَ حْن، وٌ شَشِلِ سْتْمَ نّ.<verse eid="JER 23:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JER 23:21"/>ﭑ تَن شَ مُ يِ نَمِحْنمّيٍ شّيشِ، عٍ عٍ يّتّ شَشِلِ نَن نَوَلِقٍ.</para>
  <para style="q" vid="JER 23:21">ﭑ مُ مَسٍنيِ تِشِ عٍ بّ، عٍ مَسٍنيِ تِشِ عٍ يّتّ نَن نَ.<verse eid="JER 23:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JER 23:22"/>شَ عَ سَ عَ لِ عٍ نُ نَ ﭑ تَن نَن سّيتِ مَ،</para>
  <para style="q" vid="JER 23:22">عٍ ﭑ مَ مَسٍنيِ نَن مَسٍنمَ ﭑ مَ حَمَ بّ،</para>
  <para style="q" vid="JER 23:22">عَلَكٌ عٍ شَ فبِلٍن عٍ شَ كِرَ حَاشِ قْشْ رَ،</para>
  <para style="q" vid="JER 23:22">عٍ شَ كٌبِحَ لُ نَ.»<verse eid="JER 23:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="JER 23:23"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 23:23">«عَلَ نَن ﭑ نَ نَشَن مَكْرّ وٌ رَ،</para>
  <para style="q" vid="JER 23:23">ﭑ مُ نَ يِرٍ مَكُيٍ.<verse eid="JER 23:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JER 23:24"/>عَدَ مَدِ نْمَ عَ نْشُندٍ ﭑ مَ؟»</para>
  <para style="q" vid="JER 23:24">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.</para>
  <para style="q" vid="JER 23:24">«ﭑ مُ نَ كٌورٍ نُن بْشِ بِرِن مَ شّ؟»</para>
  <para style="q" vid="JER 23:24">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="JER 23:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JER 23:25"/>«ﭑ بَرَ نَ نَمِحْنمّيٍ شُي مّ.</para>
  <para style="q" vid="JER 23:25">عٍ وُلٍ نَن قَلَمَ،</para>
  <para style="q" vid="JER 23:25">عٍ نَشّ، ‹ﭑ بَرَ لَامَتُنيِ تٌ، ﭑ بَرَ لَامَتُنيِ تٌ.›»<verse eid="JER 23:25"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="26" style="v" sid="JER 23:26"/>«نَمِحْنمّيٍ لُمَ وُلٍ قَلَ رَ هَن مُن تّمُي؟</para>
  <para style="q" vid="JER 23:26">عٍ عٍ يّتّ مَدَشُمَ هَن مُن تّمُي؟<verse eid="JER 23:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="JER 23:27"/>عٍ مَحْشُنشِ نّ عَ حَمَ نْمَ نّيمُدٍ ﭑ شِلِ رَ</para>
  <para style="q" vid="JER 23:27">عٍ شَ لَامَتُنيِيٍ سَابُي رَ، عٍ نَشَن قَلَمَ عٍ بٌورٍ بّ،</para>
  <para style="q" vid="JER 23:27">عَلْ عٍ بَبَيٍ نّيمُشِ ﭑ شِلِ مَ كِ نَشّ عٍ قَ بَلِ بَتُ.<verse eid="JER 23:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="JER 23:28"/>نَشَن بَرَ شِيٍ سَ، عَ شَ نَ نَن قَلَ.</para>
  <para style="q" vid="JER 23:28">نَشَن بَرَ ﭑ مَ مَسٍنيِ سْتْ، عَ شَ نَ قَلَ نْندِ رَ.</para>
  <para style="q" vid="JER 23:28">مُنسٍ نَ مَالٍ شْرِ نُن مَالٍ لَفِ تَفِ؟»</para>
  <para style="q" vid="JER 23:28">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="JER 23:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="JER 23:29"/>«ﭑ مَ مَسٍنيِ مُ لُشِ شّ عَلْ تّ؟»</para>
  <para style="q" vid="JER 23:29">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.</para>
  <para style="q" vid="JER 23:29">«ﭑ مَ مَسٍنيِ مُ لُشِ شّ عَلْ دّرّ مَ نَشَن فّمّ عِبْو مَ؟»<verse eid="JER 23:29"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="30" style="v" sid="JER 23:30"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 23:30">«يِ نَمِحْنمّيٍ مُ رَقَنشِ ﭑ مَ.</para>
  <para style="q" vid="JER 23:30">عٍ مَسٍنيِ مُحَمَ عٍ بٌورٍ مَ،</para>
  <para style="q" vid="JER 23:30">عٍ قَ عَ قَلَ عَلَ شَ مَسٍنيِ نَ عَ رَ.»<verse eid="JER 23:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="JER 23:31"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 23:31">«يِ نَمِحْنمّيٍ مُ رَقَنشِ ﭑ مَ.</para>
  <para style="q" vid="JER 23:31">عٍ عَ قَلَمَ، ‹عَلَ شَ مَسٍنيِ نَن يَ،›</para>
  <para style="q" vid="JER 23:31">كْنْ عٍ دّ نَن تُن وُيَشِ.»<verse eid="JER 23:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="JER 23:32"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 23:32">«يِ نَمِحْنمّيٍ مُ رَقَنشِ ﭑ مَ،</para>
  <para style="q" vid="JER 23:32">نَشٍيٍ لَامَتُنيِ وُلٍ قَلَمَ،</para>
  <para style="q" vid="JER 23:32">نَشٍيٍ ﭑ مَ حَمَ رَلْيمَ عٍ شَ وُلٍ قُقَقُيٍ رَ.</para>
  <para style="q" vid="JER 23:32">ﭑ مُ عٍ شّيشِ، ﭑ مُ يَامَرِ يٌ قِشِ عٍ مَ،</para>
  <para style="q" vid="JER 23:32">حَمَ هَيِ مُ نَ عٍ مَ قٍوٌ.»</para>
  <para style="q" vid="JER 23:32">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="JER 23:32"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="33" style="v" sid="JER 23:33"/>«شَ حَمَ عِ مَشْرِن،</para>
  <para style="q" vid="JER 23:33">شَ نَ مُ عَ رَ نَمِحْنمّ، شَ نَ مُ عَ رَ سّرّشّدُبّ،</para>
  <para style="q" vid="JER 23:33">‹مُنسٍ قِندِشِ عَلَتَلَ شَ نَتّ رَ،›</para>
  <para style="q" vid="JER 23:33">عِ شَ يِ نَتّ قَلَ عٍ بّ،</para>
  <para style="q" vid="JER 23:33">‹عَلَتَلَ بَرَ وٌ رَبّحِن.›<verse eid="JER 23:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="JER 23:34"/>شَ نَمِحْنمّ، شَ نَ مُ عَ رَ سّرّشّدُبّ،</para>
  <para style="q" vid="JER 23:34">شَ نَ مُ عَ رَ مِشِ ندٍ عَ قَلَ حَمَ بّ،</para>
  <para style="q" vid="JER 23:34">‹عَلَتَلَ شَ مَسٍنيِ نَن يَ،›</para>
  <para style="q" vid="JER 23:34">ﭑ قَمَ نّ نَ كَنيِ نُن عَ بْنسْي حَشَنكَتَدٍ.<verse eid="JER 23:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="JER 23:35"/>وٌ وٌ بٌورٍ مَشْرِنمَ،</para>
  <para style="q" vid="JER 23:35">‹عَلَتَلَ مُنسٍ يَابِشِ؟ عَلَتَلَ مُنسٍ مَسٍنشِ؟›<verse eid="JER 23:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="JER 23:36"/>كْنْ عَ مُ لَنمَ وٌ شَ عَ قَلَ،</para>
  <para style="q" vid="JER 23:36">‹عَلَتَلَ شَ مَسٍنيِ نَن يَ،›</para>
  <para style="q" vid="JER 23:36">بَرِ مَ نَ قِندِشِ وٌ يّتّ شَ مَسٍنيِ نَن نَ.</para>
  <para style="q" vid="JER 23:36">وٌ وَ مَ مَنفّ عَلَتَلَ شَ مَسٍنيِ نَن مَسَرَقٍ.<verse eid="JER 23:36"/></para>
  <para style="q">
    <verse number="37" style="v" sid="JER 23:37"/>وٌ نَمِحْنمّ مَشْرِنمَ،</para>
  <para style="q" vid="JER 23:37">‹عَلَتَلَ مُنسٍ يَابِشِ؟ عَلَتَلَ مُنسٍ مَسٍنشِ؟›<verse eid="JER 23:37"/></para>
  <para style="q">
    <verse number="38" style="v" sid="JER 23:38"/>شَ وٌ مَن عَ قَلَمَ،</para>
  <para style="q" vid="JER 23:38">‹عَلَتَلَ شَ مَسٍنيِ نَن يَ،›</para>
  <para style="q" vid="JER 23:38">ﭑ تٌ عَ قَلَ وٌ بّ عَ وٌ نَشَ نَ مْولِ قَلَ،<verse eid="JER 23:38"/></para>
  <para style="q">
    <verse number="39" style="v" sid="JER 23:39"/>ﭑ وٌ رَبّحِنمَ نّ كٍرٍنيِ رَ،</para>
  <para style="q" vid="JER 23:39">ﭑ وٌ مَكُيَ ﭑ نَ،</para>
  <para style="q" vid="JER 23:39">وٌ تَن نُن وٌ شَ تَا ﭑ نَشَن قِشِ وٌ نُن وٌ بَبَيٍ مَ.<verse eid="JER 23:39"/></para>
  <para style="q">
    <verse number="40" style="v" sid="JER 23:40"/>ﭑ وٌ رَيَافِمَ نّ عَبَدَن.</para>
  <para style="q" vid="JER 23:40">نَ يَافِ مُ بَمَ وٌ مَ، مِشِ مُ نّيمُمَ عَ رَ.»<verse eid="JER 23:40"/></para>
  <chapter eid="JER 23"/>
  <chapter number="24" style="c" sid="JER 24"/>
  <para style="s">شْرّ ثَانِ قِرِن</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 24:1"/>بَبِلْن مَنفّ نٍبُكَدَنسَرِ تٌ فّ يُدَيَ مَنفّ يٍهٌيَكِنِ، يٍهٌيَكِمِ شَ دِ، عَ شَ كُنتِفِيٍ، يُدَيَ كَمُدّرِيٍ نُن شَبُييٍ شَنِندٍ كٌنيِيَ كُي بَبِلْن بْشِ مَ، عَلَتَلَ نَشَ لَامَتُنيِ ندٍ مَسٍن ﭑ بّ. ثَانِ قِرِن نُ نَ عَلَتَلَ شَ هْرْ مْبَنشِ يَ رَ. عٍ نُ رَقٍشِ شْرّيٍ رَ. <verse eid="JER 24:1"/><verse number="2" style="v" sid="JER 24:2"/>شْرّ بٌفِ قَنيِيٍ، نَشٍيٍ لُشِ عَلْ شْرّ بٌفِ بَ سِنفٍيٍ، عٍ نُ سَشِ ثَانِ كٍرٍن كُي. شْرّ بٌفِ حَاشِيٍ، نَشٍيٍ كَنَشِ، نٍيٍ قَن نُ سَشِ ثَانِ بٌورٍ كُي. <verse eid="JER 24:2"/><verse number="3" style="v" sid="JER 24:3"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، «عَننَبِ يٍرٍ مِ، عِ مُنسٍ تٌشِ؟» ﭑ نَشَ عَ يَابِ، «ﭑ شْرّيٍ نَن تٌشِ. ندٍيٍ قَن هَن، ندٍيٍ قَن كَنَشِ. شْرّ نَشٍيٍ كَنَشِ، عٍ مُ نْمَ دٌندٍ.»<verse eid="JER 24:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 24:4"/>عَلَتَلَ نَشَ يِ مَسٍنيِ تِ ﭑ بّ، <verse eid="JER 24:4"/><verse number="5" style="v" sid="JER 24:5"/>«عِسِرَيِلَ مَرِفِ عَلَتَلَ شَ مَسٍنيِ نَن يَ؛ عِ شْرّ بٌفِ قَنيِيٍ تٌشِ كِ نَشّ، ﭑ تَن قَن عِسِرَيِلَكَيٍ تٌشِ نَ كِ نّ، نَشٍيٍ شَنِنشِ كٌنيِيَ كُي بَبِلْن بْشِ مَ. <verse eid="JER 24:5"/><verse number="6" style="v" sid="JER 24:6"/>ﭑ نَن ﭑ حّنفِ سَمَ نّ عٍ شْن مَ عَ قَنيِ رَ. ﭑ عٍ رَفبِلٍنمَ نّ يِ بْشِ مَ، ﭑ عٍ شَ قٍ سْونّيَمَ نّ. ﭑ مُ عٍ هَلَكِمَ سْنْن. <verse eid="JER 24:6"/><verse number="7" style="v" sid="JER 24:7"/>ﭑ شَشِلِ قَنيِ قِمَ نّ عٍ مَ عَلَكٌ عٍ شَ عَ كٌلٌن ﭑ تَن نَن نَ عَلَتَلَ رَ. شَ عٍ يّتّ رَفبِلٍن ﭑ مَ عٍ بْحّ بِرِن نَ، عٍ تَن نَن قِندِ مَ ﭑ مَ حَمَ رَ، ﭑ تَن قَن قِندِ عٍ مَرِفِ عَلَ رَ.»<verse eid="JER 24:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 24:8"/>عَلَتَلَ نَشَ عَ مَسٍن، «يِ شْرّ بٌفِ حَاشِ نَشٍيٍ مُ دٌنمَ، عٍ مِسَالِشِ يُدَيَ مَنفّ سٍدٍكِيَ نُن عَ شَ كُنتِفِيٍ نَن نَ، عَ نُن دَرِ سَلَمُكَيٍ نَشٍيٍ بِرِن لُشِ يِ بْشِ مَ، نُن نَشٍيٍ سَبَتِشِ مِسِرَ بْشِ مَ. <verse eid="JER 24:8"/><verse number="9" style="v" sid="JER 24:9"/>ﭑ عٍ قِندِ مَ حَمَ شْنشِ نَن نَ دُنِحَ بِرِن. عٍ لُمَ يَافِ كُي. مِشِ يٌمَ نّ عٍ مَ، عٍ عٍ دَنكَ يِرٍ بِرِن ﭑ عٍ شَنِنمَ دّننَشّ. <verse eid="JER 24:9"/><verse number="10" style="v" sid="JER 24:10"/>ﭑ عٍ رَحْنمَ نّ سَنتِدّفّمَ، كَامّ، نُن قُرٍ حَاشِ رَ. عٍ مُ لُمَ يِ بْشِ مَ، ﭑ دّننَشّ قِشِ عٍ نُن عٍ بَبَيٍ مَ.»<verse eid="JER 24:10"/></para>
  <chapter eid="JER 24"/>
  <chapter number="25" style="c" sid="JER 25"/>
  <para style="s">عِسِرَيِلَ شَ كٌنيِيَ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 25:1"/>عَلَتَلَ نَشَ مَسٍنيِ ندٍ تِ عَننَبِ يٍرٍ مِ بّ، يٌسِيَ شَ دِ يٍهٌيَكِمِ شَ مَنفّيَ حّ نَانِ ندٍ كُي يُدَيَ بْشِ مَ. نَ نُ قِندِشِ نٍبُكَدَنسَرِ شَ مَنفّيَ حّ سِنفٍ نَن نَ بَبِلْن بْشِ مَ. <verse eid="JER 25:1"/><verse number="2" style="v" sid="JER 25:2"/>عَننَبِ يٍرٍ مِ نَشَ يِ مَسٍنيِ تِ يُدَيَكَيٍ نُن دَرِ سَلَمُكَيٍ بّ، <verse eid="JER 25:2"/><verse number="3" style="v" sid="JER 25:3"/>«كَبِ عَمٌن شَ دِ يٌسِيَ شَ مَنفّيَ حّ قُ نُن سَشَن ندٍ يُدَيَ بْشِ مَ، هَن تٌ، نَ حّ مْشْحّن نُن سَشَن نَن يَ. نَ وَشَتِ عَلَتَلَ نُ بَرَ مَسٍنيِ ندٍ تِ ﭑ بّ. ﭑ بَرَ نَ قَلَ وٌ بّ تّمُي بِرِن، كْنْ وٌ مُ تِنشِ وٌ تُلِ مَتِدٍ ﭑ نَ. <verse eid="JER 25:3"/><verse number="4" style="v" sid="JER 25:4"/>عَلَتَلَ بَرَ عَ شَ كٌنيِ نَمِحْنمّيٍ شّي وٌ مَ وَشَتِ بِرِن، كْنْ وٌ مُ عٍ شُي رَ مّشِ، وٌ مُ عٍ شَ مَسٍنيِ سُشُشِ. <verse eid="JER 25:4"/><verse number="5" style="v" sid="JER 25:5"/>عٍ نَشَ عَ مَسٍن وٌ بّ وٌ شَ فبِلٍن وٌ شَ حّرّ كِ حَاشِ قْشْ رَ، عَلَكٌ وٌ شَ بُ يِ بْشِ مَ، عَلَتَلَ نَشَن قِشِ وٌ نُن وٌ بَبَيٍ مَ، عَ شَ قِندِ وٌ فبٍ رَ عَبَدَن.»<verse eid="JER 25:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 25:6"/>«وٌ نَشَ بِرَ عَلَ فبّتّيٍ قْشْ رَ، وٌ نَشَ عٍ بَتُ، وٌ نَشَ تُوبِ عٍ بّ. وٌ نَشَ ﭑ نَشْنْ، عَلَكٌ ﭑ نَشَ وٌ حَشَنكَتَ. <verse eid="JER 25:6"/><verse number="7" style="v" sid="JER 25:7"/>كْنْ وٌ مُ ﭑ شُي سُشُشِ. وٌ حّرّ كِ بَرَ ﭑ نَشْنْ، ﭑ شَ وٌ حَشَنكَتَ. عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.»<verse eid="JER 25:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 25:8"/>نَ نَن عَ رَ مَنفّ عَلَتَلَ نَشَ عَ مَسٍن، «وٌ تٌ تٌندِ ﭑ مَ مَسٍنيِ رَ، <verse eid="JER 25:8"/><verse number="9" style="v" sid="JER 25:9"/>ﭑ فَلِ قٍنمَ نّ كْولَ مَ، نَشَن نَ ﭑ مَ كٌنيِ بَبِلْن مَنفّ نٍبُكَدَنسَرِ شَ يَامَرِ بُن مَ. ﭑ عٍ شّيمَ نّ وٌ نُن وٌ دْشْبٌورٍ سْنتْدٍ. مِشِ دّ عِشَرَ مَ نّ وٌ شَ قٍ رَ، عٍ قَ يٌ وٌ مَ. وٌ لُمَ نَا شُننَكَنّ نَن كُي عَبَدَن. <verse eid="JER 25:9"/><verse number="10" style="v" sid="JER 25:10"/>سِفِ مُ سَمَ وٌ شْنيِ سْنْن، شُلُنيِ مُ رَبَمَ. مِشِ مُ مَالٍ دِن شُي مّمَ، عٍ مُ لَنثُي شَ نَءِيَلَنيِ تٌمَ. <verse eid="JER 25:10"/><verse number="11" style="v" sid="JER 25:11"/>فبَلٌي يِ بْشِ لِمَ نّ، سٍ بِرِن كَنَ. وٌ نُن وٌ دْشْبٌورٍيٍ لُمَ كٌنيِيَ نَن كُي بَبِلْن مَنفّ شَ نْي بُن مَ حّ تٌنفٌ سٌلٌقٍرٍ.»<verse eid="JER 25:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 25:12"/>«عَلَتَلَ شَ مَسٍنيِ نَن يَ؛ كْنْ نَ حّ تٌنفٌ سٌلٌقٍرٍ نَ كَمَلِ، ﭑ بَبِلْن مَنفّ نُن عَ شَ حَمَ حَشَنكَتَمَ نّ عٍ شَ قٍ حَاشِ شَ قٍ رَ. ﭑ عٍ شَ بْشِ شُن نَكَنَمَ نّ عَبَدَن. <verse eid="JER 25:12"/><verse number="13" style="v" sid="JER 25:13"/>ﭑ قٍ نَشَن بِرِن قَلَشِ يِ حَمَيٍ شِلِ مَ يِ كِتَابُي كُي عَننَبِ يٍرٍ مِ سَابُي رَ، ﭑ قَمَ نّ نَ بِرِن نَكَمَلِدٍ. <verse eid="JER 25:13"/><verse number="14" style="v" sid="JER 25:14"/>بَبِلْنكَيٍ قَمَ نّ لُدٍ سِ سّنبّمَ وُيَشِيٍ شَ يَامَرِ بُن مَ. ﭑ عٍ شَ وَلِ سَرٍ رَفبِلٍنمَ نّ عٍ مَ.»<verse eid="JER 25:14"/></para>
  <para style="sp">عَلَتَلَ شَ مَسٍنيِ</para>
  <para style="q">
    <verse number="15" style="v" sid="JER 25:15"/>عِسِرَيِلَ مَرِفِ عَلَ بَرَ عَ مَسٍن ﭑ بّ،</para>
  <para style="q" vid="JER 25:15">«ﭑ مَ شْنّ شَ قٍ قَلَ سِ بِرِن بّ</para>
  <para style="q" vid="JER 25:15">ﭑ عِ شّيمَ دّننَشّ.<verse eid="JER 25:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 25:16"/>عٍ نَ ﭑ مَ شْنّ تٌ،</para>
  <para style="q" vid="JER 25:16">عٍ لُمَ نّ عَلْ سِيسِلَيٍ سَنتِدّفّمَ يَ رَ.»<verse eid="JER 25:16"/></para>
  <para style="sp">عَننَبِ يٍرٍ مِ شَ مَسٍنيِ</para>
  <para style="q">
    <verse number="17" style="v" sid="JER 25:17"/>«ﭑ بَرَ عَلَتَلَ شَ شْنّ مَسٍن سِ بِرِن بّ،</para>
  <para style="q" vid="JER 25:17">عَ ﭑ شّيشِ دّننَشّ.<verse eid="JER 25:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JER 25:18"/>ﭑ بَرَ عَ مَسٍن دَرِ سَلَمُ نُن يُدَيَ تَايٍ كُي،</para>
  <para style="q" vid="JER 25:18">عٍ شَ مَنفّيٍ نُن كُنتِفِيٍ بّ.</para>
  <para style="q" vid="JER 25:18">مِشِيٍ دّ قَمَ نّ عِشَرَدٍ عٍ شَ فبَلٌي سْتْشِيٍ شَ قٍ رَ،</para>
  <para style="q" vid="JER 25:18">عٍ قَ يٌ عٍ مَ، عٍ عٍ دَنكَ عَلْ عَ رَبَقٍ كِ نَشّ تٌ لْشْي.<verse eid="JER 25:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JER 25:19"/>ﭑ بَرَ عَ مَسٍن مِسِرَ مَنفّ قِرَوُنَ بّ،</para>
  <para style="q" vid="JER 25:19">عَ شَ كٌنيِيٍ، عَ شَ كُنتِفِيٍ، نُن عَ شَ حَمَ بِرِن بّ.<verse eid="JER 25:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 25:20"/>ﭑ بَرَ عَ مَسٍن سِيٍ بّ</para>
  <para style="q" vid="JER 25:20">نَشٍيٍ نَ سٌفٍفٌرٌدٍ مَبِرِ.</para>
  <para style="q" vid="JER 25:20">ﭑ بَرَ عَ مَسٍن عُسِ مَنفّيٍ بّ، عَ نُن قِلِسِتَ مَنفّيٍ بّ،</para>
  <para style="q" vid="JER 25:20">نَشٍيٍ نَ عَسِكَلْن، فَسَ، عٍكِرٌن، نُن عَسِدٌدِ.<verse eid="JER 25:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JER 25:21"/>ﭑ بَرَ عَ مَسٍن عٍدٌن، مٌوَبَ، نُن عَمٌنِ مَنفّيٍ بّ.<verse eid="JER 25:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JER 25:22"/>ﭑ بَرَ عَ مَسٍن تِرٍ نُن سِدْن مَنفّيٍ بّ،</para>
  <para style="q" vid="JER 25:22">نَشٍيٍ نَ بَا دّ رَ.<verse eid="JER 25:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JER 25:23"/>ﭑ بَرَ عَ مَسٍن دٍدَن، تٍمَ، نُن بُسِ مَنفّيٍ بّ،</para>
  <para style="q" vid="JER 25:23">نَشٍيٍ نَ يِرٍ مَكُيٍ.<verse eid="JER 25:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JER 25:24"/>ﭑ بَرَ عَ مَسٍن عَرَبُ مَنفّيٍ بّ،</para>
  <para style="q" vid="JER 25:24">نَشٍيٍ نَ فبٍنفبٍرٍن يِرٍ.<verse eid="JER 25:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JER 25:25"/>ﭑ بَرَ عَ مَسٍن سَبِدِ، عٍلَمَ، نُن مٍدِيَ مَنفّيٍ بّ،<verse eid="JER 25:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JER 25:26"/>عَ نُن مَنفّ بِرِن نَشٍيٍ نَ كْولَ مَ،</para>
  <para style="q" vid="JER 25:26">نَشٍيٍ مَكْرّ نُن نَشٍيٍ مَكُيَ دُنِحَ يِرٍ بِرِن.</para>
  <para style="q" vid="JER 25:26">نٍيٍ بِرِن دَنفِ شَنبِ،</para>
  <para style="q" vid="JER 25:26">ﭑ مَن بَرَ عَ مَسٍن سٍيسَكِ مَنفّ بّ.»<verse eid="JER 25:26"/></para>
  <para style="sp">عَلَتَلَ شَ مَسٍنيِ</para>
  <para style="q">
    <verse number="27" style="v" sid="JER 25:27"/>«عِ شَ عَ مَسٍن عٍ بّ،</para>
  <para style="q" vid="JER 25:27">‹عِسِرَيِلَ مَنفّ عَلَتَلَ بَرَ عَ مَسٍن،</para>
  <para style="q" vid="JER 25:27">وٌ شَ عَ شَ شْنّ كٌلٌن،</para>
  <para style="q" vid="JER 25:27">وٌ شَ لُ نَ شْنّ كُي هَن سَنتِدّفّمَ شَ فّ وٌ سْنتْدٍ</para>
  <para style="q" vid="JER 25:27">ﭑ نَشَن شّيمَ وٌ تَفِ.›<verse eid="JER 25:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="JER 25:28"/>شَ عٍ تٌندِ ﭑ مَ شْنّ كٌلٌندٍ، عَ قَلَ عٍ بّ،</para>
  <para style="q" vid="JER 25:28">عَلَتَلَ بَرَ نَتّ شْرْشْي تٌنفٌ،</para>
  <para style="q" vid="JER 25:28">عٍ شَ ﭑ مَ شْنّ كٌلٌن.»<verse eid="JER 25:28"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="29" style="v" sid="JER 25:29"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 25:29">«ﭑ بَرَ نَتّ تٌنفٌ</para>
  <para style="q" vid="JER 25:29">ﭑ شَ ﭑ مَ تَا سُفَندِشِ حَشَنكَتَ،</para>
  <para style="q" vid="JER 25:29">ﭑ شِلِ قَلَمَ نَشَن شُن مَ.</para>
  <para style="q" vid="JER 25:29">وٌ نَشّ عَ وٌ مُ قٍ حَاشِ يٌ رَبَشِ</para>
  <para style="q" vid="JER 25:29">كْنْ وٌ بَرَ قٍ حَاشِ رَبَ.</para>
  <para style="q" vid="JER 25:29">نَ نَن عَ رَ ﭑ بَرَ نَتّ تٌنفٌ،</para>
  <para style="q" vid="JER 25:29">وٌ شَ سْنتْ سَنتِدّفّمَ رَ.»</para>
  <para style="q" vid="JER 25:29">مَنفّ عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="JER 25:29"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="30" style="v" sid="JER 25:30"/>«عِ شَ يِ بِرِن قَلَ عٍ بّ.</para>
  <para style="q" vid="JER 25:30">عِ شَ عَ قَلَ عٍ بّ عَلَتَلَ شُي مَفَاشُشِ بَرَ مِنِ</para>
  <para style="q" vid="JER 25:30">عَ شَ هْرْ مْلِنفِرَ كُي كٌورٍ مَ عَ شَ بْشِ شِلِ مَ.</para>
  <para style="q" vid="JER 25:30">عَ بَرَ عَ شُي رَ مِنِ عَ حَاشِ رَ دُنِحَ شِلِ مَ.<verse eid="JER 25:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="JER 25:31"/>نَ شُي بَرَ دُنِحَ بِرِن لِ.</para>
  <para style="q" vid="JER 25:31">عَلَتَلَ نَ كِيتِ سَقٍ سِ بِرِن مَ نَشٍيٍ نَ دُنِحَ.</para>
  <para style="q" vid="JER 25:31">نَشَن حَاشُ، عَ سْنتْمَ نّ سَنتِدّفّمَ رَ.»</para>
  <para style="q" vid="JER 25:31">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="JER 25:31"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="32" style="v" sid="JER 25:32"/>عَلَتَلَ بَرَ عَ مَسٍن،</para>
  <para style="q" vid="JER 25:32">«عَلَتَلَ شَ شْنّ بَرَ كٍلِ</para>
  <para style="q" vid="JER 25:32">عَلْ قٌيٍ شُنفبٍ نَشَن سِفَمَ سِ بِرِن مَ دُنِحَ بّندّ قُحِ قَرِ.<verse eid="JER 25:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="JER 25:33"/>عَلَتَلَ نَشٍيٍ سْنتْمَ دُنِحَ مَ نَ لْشْي،</para>
  <para style="q" vid="JER 25:33">حْن قٍ مُ رَبَمَ عٍ بّ، عٍ مُ فَبُرِ سْتْمَ،</para>
  <para style="q" vid="JER 25:33">عٍ قِندِ مَ حَحّ نَن نَ بّندّ قُحِ قَرِ.<verse eid="JER 25:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="JER 25:34"/>حَمَ يَرٍرَتِيٍ، وٌ شَ فبٍلٍفبٍلٍ،</para>
  <para style="q" vid="JER 25:34">وٌ شَ وٌ وَ شُي رَ مِنِ،</para>
  <para style="q" vid="JER 25:34">بَرِ مَ فبَلٌي لْشْي بَرَ وٌ لِ.</para>
  <para style="q" vid="JER 25:34">وٌ قَمَ نّ يٍنسٍندٍ، وٌ بِرَ،</para>
  <para style="q" vid="JER 25:34">عَلْ سٍ شُنشُرِ نَشَن تِدٍ مُ نَ.<verse eid="JER 25:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="JER 25:35"/>وٌ شَ يَرٍرَتِيٍ مُ كِسِمَ سْنْن،</para>
  <para style="q" vid="JER 25:35">وٌ مُ يِفِيَ سْتْمَ.<verse eid="JER 25:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="JER 25:36"/>وٌ وٌ شَ يَرٍرَتِيٍ وَ شُي مّمَ نّ،</para>
  <para style="q" vid="JER 25:36">وٌ عٍ فبٍلٍفبٍلٍ شُي مّ،</para>
  <para style="q" vid="JER 25:36">بَرِ مَ عَلَتَلَ نَ عٍ شَ بْشِ كَنَقٍ.<verse eid="JER 25:36"/></para>
  <para style="q">
    <verse number="37" style="v" sid="JER 25:37"/>عَلَتَلَ شَ شْنّ مَفَاشُشِ بَرَ عَ نِيَ</para>
  <para style="q" vid="JER 25:37">شُي يٌ مُ مِنِمَ سْنْن عٍ شَ بْشِ مَ.<verse eid="JER 25:37"/></para>
  <para style="q">
    <verse number="38" style="v" sid="JER 25:38"/>عَلَتَلَ بَرَ لُ عَلْ يّتّ نَشَن بَرَ عَ يِرٍ مَسَرَ.</para>
  <para style="q" vid="JER 25:38">عَ بَرَ بْشِ كَنَ عَ شَ شْنّ شَ قٍ رَ.»<verse eid="JER 25:38"/></para>
  <chapter eid="JER 25"/>
  <chapter number="26" style="c" sid="JER 26"/>
  <para style="s">عَننَبِ يٍرٍ مِ مَكِيتِقٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 26:1"/>يٌسِيَ شَ دِ يٍهٌيَكِمِ شَ مَنفّيَ قْلّ يُدَيَ كُي، عَلَتَلَ نَشَ يِ مَسٍنيِ تِ عَننَبِ يٍرٍ مِ بّ، عَ نَشّ، <verse eid="JER 26:1"/><verse number="2" style="v" sid="JER 26:2"/>«عِ شَ تِ ﭑ مَ هْرْ مْبَنشِ تّتّ كُي، عِ سَ وْيّن حَمَ بّ نَشَن كٍلِشِ يُدَيَ تَايٍ كُي قَقٍ رَ عَلَتَلَ بَتُدٍ عَ شَ هْرْ مْبَنشِ كُي. عِ شَ قٍ بِرِن مَسٍن عٍ بّ ﭑ نَشَن قَلَمَ عِ بّ. عِ نَشَ سٍسٍ لُ. <verse eid="JER 26:2"/><verse number="3" style="v" sid="JER 26:3"/>تّمُندٍ عٍ عٍ تُلِ مَتِمَ نّ نَ رَ، عٍ فبِلٍن عٍ شَ وَلِ كٌبِيٍ قْشْ رَ. نَ تّمُي ﭑ قَن فبِلٍن ﭑ مَ نَتّ قْشْ رَ عٍ شَ قٍ حَاشِ شَ قٍ رَ. <verse eid="JER 26:3"/><verse number="4" style="v" sid="JER 26:4"/>عِ شَ عَ قَلَ عٍ بّ، ‹عَلَتَلَ بَرَ عَ مَسٍن، شَ وٌ مُ وٌ تُلِ مَتِ ﭑ مَ سّرِيّ رَ ﭑ وٌ يَمَرِشِ نَشَن نَ، <verse eid="JER 26:4"/><verse number="5" style="v" sid="JER 26:5"/>شَ وٌ مُ وٌ تُلِ مَتِ ﭑ مَ كٌنيِ نَمِحْنمّيٍ رَ، ﭑ نَشٍيٍ شّيشِ وٌ مَ، وٌ تٌندِشِ نَشٍيٍ شَ مَسٍنيِ رَ، <verse eid="JER 26:5"/><verse number="6" style="v" sid="JER 26:6"/>نَ تّمُي ﭑ قٍ رَبَمَ نّ وٌ رَ عَلْ ﭑ نَشَن نَبَشِ سِلٌ رَ. يِ تَا قِندِ مَ نّ تَا دَنكَشِ رَ دُنِحَ سِ بِرِن تَفِ.›»<verse eid="JER 26:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 26:7"/>سّرّشّدُبّيٍ، نَمِحْنمّيٍ، نُن حَمَ بِرِن نَشَ عَننَبِ يٍرٍ مِ شَ مَسٍنيِ مّ عَلَتَلَ شَ بَنشِ كُي. <verse eid="JER 26:7"/><verse number="8" style="v" sid="JER 26:8"/>عَننَبِ يٍرٍ مِ تٌ فّ عَلَتَلَ شَ مَسٍنيِ تِدٍ حَمَ بّ، سّرّشّدُبّيٍ، نَمِحْنمّيٍ، نُن حَمَ بِرِن نَشَ عَ سُشُ، عٍ قَ عَ قَلَ، «وٌن شَ عَ قَشَ، وٌن شَ عَ قَشَ!» <verse eid="JER 26:8"/><verse number="9" style="v" sid="JER 26:9"/>عٍ نَشَ عَ مَشْرِن، «مُنقٍ رَ عِ عَ مَسٍنشِ عَلَتَلَ شِلِ رَ عَ قَلَقٍ، يِ بَنشِ قَمَ نّ لُدٍ عَلْ بَنشِ نَشَن نَ سِلٌ، يِ تَا قَن قَ كَنَ، مِشِ يٌ مُ لُ عَ كُي؟» فَلِ بِرِن نُ بَرَ عَننَبِ يٍرٍ مِ رَبِلِن عَلَتَلَ شَ بَنشِ كُي.<verse eid="JER 26:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 26:10"/>يُدَيَ كُنتِفِيٍ تٌ نَ قٍ مّ، عٍ نَشَ كٍلِ مَنفّ شْنيِ، عٍ سِفَ عَلَتَلَ شَ بَنشِ، عٍ سَ دْشْ نَادّ نّينّ سّيتِ مَ مَرِفِ شَ بَنشِ سٌدٍ دّ رَ. <verse eid="JER 26:10"/><verse number="11" style="v" sid="JER 26:11"/>سّرّشّدُبّيٍ نُن نَمِحْنمّيٍ نَشَ عَ قَلَ كُنتِفِيٍ نُن حَمَ بّ، «عَ لَنمَ يِ شّمّ شَ قَشَ، بَرِ مَ عَ بَرَ يِ تَا شَ قٍ حَاشِ قَلَ. وٌ بَرَ نَ مّ وٌ يّتّ رَ.»<verse eid="JER 26:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 26:12"/>عَننَبِ يٍرٍ مِ نَشَ عَ قَلَ كُنتِفِيٍ نُن حَمَ بّ، «عَلَتَلَ نَن ﭑ شّيشِ يِ مَسٍنيِ تِدٍ يِ بَنشِ نُن يِ تَا شَ قٍ رَ. <verse eid="JER 26:12"/><verse number="13" style="v" sid="JER 26:13"/>يَكْسِ وٌ تَن شَ وٌ حّرّ كِ مَسَرَ، وٌ شَ وٌ تُلِ مَتِ وٌ مَرِفِ عَلَتَلَ شُي رَ، عَلَكٌ عَ شَ فبِلٍن عَ شَ نَتّ قْشْ رَ وٌ شَ قٍ رَ. <verse eid="JER 26:13"/><verse number="14" style="v" sid="JER 26:14"/>ﭑ نَ وٌ سَفٌي. وٌ شَ وٌ وَشْنقٍ رَبَ ﭑ نَ. <verse eid="JER 26:14"/><verse number="15" style="v" sid="JER 26:15"/>كْنْ وٌ شَ عَ كٌلٌن، شَ وٌ ﭑ قَشَ، وٌ تَن نُن دَرِ سَلَمُكَيٍ بَرَ يُنُبِ سْتْ ﭑ مَ قَشّ شَ قٍ رَ، بَرِ مَ ﭑ تَن مُ قٍ حَاشِ يٌ رَبَشِ. عَلَتَلَ نَن ﭑ شّيشِ يِ مَسٍنيِ قَلَدٍ وٌ بّ.»<verse eid="JER 26:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 26:16"/>كُنتِفِيٍ نُن حَمَ نَشَ عَ قَلَ سّرّشّدُبّيٍ نُن شّيرَيٍ بّ، «وٌ مُ نْمَ يِ شّمّ قَشَدٍ، بَرِ مَ عَ وْيّنشِ وٌن بّ عَلَتَلَ نَن شِلِ رَ.»<verse eid="JER 26:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 26:17"/>قٌرِ ندٍيٍ نَشَ كٍلِ، عٍ قَ عَ قَلَ حَمَ بّ، <verse eid="JER 26:17"/><verse number="18" style="v" sid="JER 26:18"/>«مِكَ مٌرٍ سٍتِكَ قَن نُ نَمِحْنمّ مَسٍنيِ تِمَ نّ يُدَيَ مَنفّ شٍسٍكِيَ شَ وَشَتِ. عَ نُ بَرَ عَ قَلَ،</para>
  <para style="q" vid="JER 26:18">‹مَنفّ عَلَتَلَ بَرَ عَ مَسٍن،</para>
  <para style="q" vid="JER 26:18">سِيٌن قَمَ نّ لُدٍ عَلْ شّ نَشَن بُشَشِ،</para>
  <para style="q" vid="JER 26:18">دَرِ سَلَمُ قِندِ فّمّ مَلَنشِيٍ رَ،</para>
  <para style="q" vid="JER 26:18">عَلَتَلَ شَ هْرْ مْبَنشِ قِندِ قْتْنيِ رَ.›»<verse eid="JER 26:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 26:19"/>«يُدَيَ مَنفّ شٍسٍكِيَ بَرَ قَشَ؟ عَ مُ عَلَتَلَ مَشَندِشِ شّ؟ نَ تّمُي عَلَتَلَ نَشَ فبِلٍن عَ شَ نَتّ قْشْ رَ. يَكْسِ، وٌن نَشَ وٌن يّتّ يٌ تْورْ.»<verse eid="JER 26:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 26:20"/>مِشِ فبّتّ قَن نُ نَ، نَشَن نُ بَرَ يِ مَسٍنيِ مْولِ تِ عَلَتَلَ شِلِ رَ دَرِ سَلَمُ نُن يُدَيَ شِلِ مَ، عَلْ عَننَبِ يٍرٍ مِ عَ رَبَشِ كِ نَشّ. عَ نُ شِلِ عُرِيَ سٍمَيَ شَ دِ كِرِيَتِ يٍيَرِ مِ. <verse eid="JER 26:20"/><verse number="21" style="v" sid="JER 26:21"/>مَنفّ يٍهٌيَكِمِ نُن عَ شَ كُنتِفِيٍ نُن عَ شَ سْورِيٍ تٌ نَ مَسٍنيِ مّ، عٍ نَشَ كَتَ عَ قَشَدٍ، كْنْ عُرِيَ تٌ عَ مّ، عَ نَشَ فَاشُ، عَ فِ سِفَقٍ رَ مِسِرَ بْشِ مَ. <verse eid="JER 26:21"/><verse number="22" style="v" sid="JER 26:22"/>مَنفّ يٍهٌيَكِمِ نَشَ عَكِبٌرِ شَ دِ عٍلِنَتَن نُن مِشِ ندٍيٍ شّي عَ قْشْ رَ مِسِرَ. <verse eid="JER 26:22"/><verse number="23" style="v" sid="JER 26:23"/>عٍ نَشَ قَ عُرِيَ رَ كٍلِقٍ مِسِرَ، عٍ عَ شَنِن مَنفّ يٍهٌيَكِمِ يِرٍ. يٍهٌيَكِمِ نَشَ عَ قَشَ سَنتِدّفّمَ رَ، عَ قَ عَ رَفَتَ سٍتَرٍيٍ شَ فَبُرِ يِرٍ.<verse eid="JER 26:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 26:24"/>نَ كُي سَقَن شَ دِ عَشِكَمَ نَشَ عَننَبِ يٍرٍ مِ مَلِ، عَلَكٌ حَمَ نَشَ عَ قَشَ.<verse eid="JER 26:24"/></para>
  <chapter eid="JER 26"/>
  <chapter number="27" style="c" sid="JER 27"/>
  <para style="s">عَننَبِ يٍرٍ مِ شَ كَرَقٌي</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 27:1"/>يٌسِيَ شَ دِ يٍهٌيَكِمِ شَ مَنفّيَ قْلّ يُدَيَ كُي، عَلَتَلَ نَشَ يِ مَسٍنيِ تِ عَننَبِ يٍرٍ مِ بّ، عَ نَشّ، <verse eid="JER 27:1"/><verse number="2" style="v" sid="JER 27:2"/>«عِ شَ كَرَقٌي رَفٌرٌ عِ كْن مَ. <verse eid="JER 27:2"/><verse number="3" style="v" sid="JER 27:3"/>عِ شَ شّيرَ شّي عٍدٌن، مٌوَبَ، عَمٌن، تِرٍ، نُن سِدْن مَنفّيٍ شْن عٍ شَ مِشِيٍ سَابُي رَ، نَشٍيٍ قَشِ دَرِ سَلَمُ، يُدَيَ مَنفّ سٍدٍكِيَ يِرٍ. <verse eid="JER 27:3"/><verse number="4" style="v" sid="JER 27:4"/>عٍ شَ عَ قَلَ مَنفّيٍ بّ، ‹عِسِرَيِلَ مَنفّ عَلَتَلَ بَرَ يِ مَسٍنيِ تِ مَنفّيٍ بّ، <verse eid="JER 27:4"/><verse number="5" style="v" sid="JER 27:5"/>ﭑ تَن نَن بْشِ، عَدَ مَدِيٍ، نُن دَالِسٍ بِرِن دَاشِ نَشَن نَ دُنِحَ بّندّ قُحِ قَرِ. ﭑ عٍ دَاشِ ﭑ سّنبّ مَفَاشُشِ نَن نَ. ﭑ عَ بِرِن قِمَ مِشِ نَن مَ ﭑ وَ مَ نَشَن شْن.›»<verse eid="JER 27:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 27:6"/>«يَكْسِ ﭑ بَرَ يِ بْشِ بِرِن سٌ بَبِلْن مَنفّ نٍبُكَدَنسَرِ يِ رَ. عَ تَن نَن قِندِشِ ﭑ مَ كٌنيِ رَ. ﭑ بَرَ وُلَءِ سُبٍيٍ قَن لُ عَ سَفٌي. <verse eid="JER 27:6"/><verse number="7" style="v" sid="JER 27:7"/>حَمَنّ بِرِن قَمَ لُدٍ عَ تَن نَن مَ يَامَرِ بُن مَ. عٍ مَن لُمَ نّ عَ شَ دِ نُن عَ شَ مَمَدِ قَن مَ يَامَرِ بُن مَ، بٍينُن عَ شَ وَشَتِ شَ كَمَلِ. نَ تّمُي حَمَنّ سّنبّمَيٍ نُن مَنفّ شُنفبٍيٍ قَمَ نّ دُ سُدٍ عَ شُن نَ.»<verse eid="JER 27:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 27:8"/>«شَ حَمَنّ مَنفّ ندٍ تٌندِ بَبِلْن مَنفّ نٍبُكَدَنسَرِ رَبَتُدٍ، ﭑ تَن نَن قَمَ سَنتِدّفّمَ، كَامّ، نُن قُرٍ حَاشِ رَ نَ كَنيِ مَ، هَن عَ شَ حَمَنّ حْن نٍبُكَدَنسَرِ سَابُي رَ. عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ. <verse eid="JER 27:8"/><verse number="9" style="v" sid="JER 27:9"/>وٌ نَشَ وٌ تُلِ مَتِ وٌ شَ نَمِحْنمّيٍ، وٌ شَ سٍمَتٌي، وٌ شَ دُورٍيٍ، نُن وٌ شَ مَندُرُلَيٍ رَ، نَشٍيٍ عَ قَلَمَ وٌ بّ، ‹وٌ مُ لُمَ بَبِلْن مَنفّ سَفٌي.› <verse eid="JER 27:9"/><verse number="10" style="v" sid="JER 27:10"/>عٍ نَ وُلٍ نَن قَلَقٍ وٌ بّ، عَلَكٌ وٌ شَ مَكُيَ وٌ شَ بْشِ رَ، وٌ شَ لُ كٌنيِيَ كُي، هَن وٌ شَ حْن. <verse eid="JER 27:10"/><verse number="11" style="v" sid="JER 27:11"/>كْنْ حَمَ نَشَن نَ عَ يّتّ مَفٌرٌ بَبِلْن مَنفّ بّ، عَ عَ رَبَتُ، ﭑ نَ حَمَ شُن نَقَنمَ نّ عَ شَ بْشِ مَ، عَ شَ وَلِ مّننِ، عَ سَبَتِ نَا. عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.»<verse eid="JER 27:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 27:12"/>ﭑ نَشَ يِ مَسٍنيِ تِ يُدَيَ مَنفّ سٍدٍكِيَ بّ، «وٌ شَ لُ بَبِلْن مَنفّ شَ يَامَرِ بُن مَ، وٌ شَ وٌ مَفٌرٌ عَ تَن نُن عَ شَ حَمَ بّ عَلَكٌ وٌ شَ كِسِ. <verse eid="JER 27:12"/><verse number="13" style="v" sid="JER 27:13"/>مُنقٍ رَ عِ نُن عِ شَ حَمَ وَ مَ قَشَقٍ سَنتِدّفّمَ، كَامّ، نُن قُرٍ حَاشِ رَ، عَلْ عَلَتَلَ عَ مَسٍنشِ كِ نَشّ حَمَ بِرِن بّ نَشَن مُ تِن عَ مَفٌرٌدٍ بَبِلْن مَنفّ بّ؟ <verse eid="JER 27:13"/><verse number="14" style="v" sid="JER 27:14"/>وٌ نَشَ وٌ تُلِ مَتِ نَمِحْنمّيٍ رَ نَشٍيٍ عَ قَلَمَ، ‹وٌ مُ لُمَ بَبِلْن مَنفّ شَ يَامَرِ بُن مَ.› عٍ وُلٍ نَن تُن قَلَقٍ. <verse eid="JER 27:14"/><verse number="15" style="v" sid="JER 27:15"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛ ‹ﭑ تَن شَ مُ عٍ شّيشِ. عٍ وُلٍ نَن تُن قَلَقٍ وٌ بّ ﭑ شِلِ رَ، عَلَكٌ ﭑ شَ وٌ كٍرِ، ﭑ مَن شَ وٌ شُن نَكَنَ، وٌ تَن نُن نَمِحْنمّ نَشٍيٍ وْيّنقٍ وٌ بّ.›»<verse eid="JER 27:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 27:16"/>ﭑ بَرَ يِ مَسٍنيِ تِ سّرّشّدُبّيٍ نُن حَمَ بّ، «عَلَتَلَ نَشَ عَ مَسٍن، ‹وٌ نَشَ وٌ تُلِ مَتِ وٌ شَ نَمِحْنمّيٍ رَ نَشٍيٍ عَ قَلَمَ وٌ بّ عَ عَلَتَلَ شَ بَنشِ يِرَبَسٍيٍ قَمَ نّ رَفبِلٍندٍ وٌ يِرٍ كٍلِقٍ رَ بَبِلْن بْشِ مَ. عٍ نَ وُلٍ نَن تُن قَلَقٍ. <verse eid="JER 27:16"/><verse number="17" style="v" sid="JER 27:17"/>وٌ نَشَ وٌ تُلِ مَتِ عٍ رَ، وٌ وٌ مَفٌرٌ بَبِلْن مَنفّ بّ، عَلَكٌ وٌ شَ كِسِ. مُنقٍ رَ وٌ وَ مَ يِ تَا شَ كَنَ؟ <verse eid="JER 27:17"/><verse number="18" style="v" sid="JER 27:18"/>شَ نَمِحْنمّيٍ نَن عٍ رَ، شَ عٍ نَ عَلَتَلَ شَ مَسٍنيِ نَن تِقٍ، عٍ شَ مَنفّ عَلَتَلَ مَشَندِ عَلَكٌ يِرَبَسٍ نَشٍيٍ لُشِ عَلَتَلَ شَ بَنشِ كُي، يُدَيَ مَنفّ شَ بَنشِ كُي، نُن دَرِ سَلَمُ كُي، عٍ نَشَ عٍ شَنِن بَبِلْن بْشِ مَ. <verse eid="JER 27:18"/><verse number="19" style="v" sid="JER 27:19"/>مَنفّ عَلَتَلَ بَرَ قٍ ندٍ قَلَ عَ شَ بَنشِ سَنيِيٍ شَ قٍ رَ، نَ يٍ رَفَتَدٍ شُنفبٍ، نُن نَ يٍ رَفَتَدٍ شُنشُرِيٍ، نُن سٍ فبّتّ شَ قٍ رَ نَشٍيٍ نَ تَا كُي، <verse eid="JER 27:19"/><verse number="20" style="v" sid="JER 27:20"/>بَبِلْن مَنفّ نٍبُكَدَنسَرِ مُ نَشٍيٍ شَنِن، عَ تٌ نُ يٍهٌيَكِمِ شَ دِ يُدَيَ مَنفّ يٍهٌيَكِنِ، يُدَيَ كُنتِفِيٍ، نُن دَرِ سَلَمُكَيٍ شَنِنقٍ عَ شْنيِ. <verse eid="JER 27:20"/><verse number="21" style="v" sid="JER 27:21"/>عِسِرَيِلَ مَنفّ عَلَتَلَ نَشَ مَسٍنيِ تِ يِرَبَسٍيٍ شَ قٍ رَ نَشٍيٍ نُ لُشِ عَ شَ بَنشِ كُي، يُدَيَ مَنفّ شَ بَنشِ كُي، نُن دَرِ سَلَمُ كُي، <verse eid="JER 27:21"/><verse number="22" style="v" sid="JER 27:22"/>عٍ بِرِن شَنِنمَ نّ بَبِلْن بْشِ مَ. عٍ لُمَ نّ نَا هَن عَ نَتّ تٌنفٌمَ تّمُي نَشّ، عَ مَن شَ عٍ رَفبِلٍن دَرِ سَلَمُ.›»<verse eid="JER 27:22"/></para>
  <chapter eid="JER 27"/>
  <chapter number="28" style="c" sid="JER 28"/>
  <para style="s">عَننَبِ شَنَنِيَ شَ مَسٍنيِ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 28:1"/>يُدَيَ مَنفّ سٍدٍكِيَ شَ مَنفّيَ حّ نَانِ، كِكٍ سُولِ ندٍ رَ، عَسُرُ شَ دِ عَننَبِ شَنَنِيَ فَبَيٌنكَ نَشَ وْيّن عَلَتَلَ شَ هْرْ مْبَنشِ كُي سّرّشّدُبّيٍ نُن حَمَ يَ شْرِ. <verse eid="JER 28:1"/><verse number="2" style="v" sid="JER 28:2"/>عَ نَشّ، «عِسِرَيِلَ مَرِفِ عَلَتَلَ بَرَ عَ مَسٍن، ‹ﭑ قَمَ نّ بَبِلْن مَنفّ شَ يَامَرِ كَنَدٍ. <verse eid="JER 28:2"/><verse number="3" style="v" sid="JER 28:3"/>بٍينُن حّ قِرِن شَ كَمَلِ، ﭑ مَن قَمَ نّ عَلَتَلَ شَ هْرْ مْلِنفِرَ شُنمَسٍ بِرِن نَفبِلٍندٍ بٍ، بَبِلْن مَنفّ نٍبُكَدَنسَرِ نَشَن تٌنفٌ، عَ عٍ شَنِن بَبِلْن بْشِ مَ. <verse eid="JER 28:3"/><verse number="4" style="v" sid="JER 28:4"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ، ﭑ مَن قَمَ نّ يٍهٌيَكِمِ شَ دِ، يُدَيَ مَنفّ يٍهٌيَكِنِ رَفبِلٍندٍ، عَ نُن مِشِ بِرِن نَشٍيٍ نُ شَنِنشِ بَبِلْن. ﭑ بَبِلْن مَنفّ شَ يَامَرِ كَنَمَ نّ.›»<verse eid="JER 28:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 28:5"/>عَننَبِ يٍرٍ مِ نَشَ عَننَبِ شَنَنِيَ يَابِ سّرّشّدُبّيٍ نُن حَمَ يَ شْرِ عَلَتَلَ شَ هْرْ مْبَنشِ كُي. <verse eid="JER 28:5"/><verse number="6" style="v" sid="JER 28:6"/>عَننَبِ يٍرٍ مِ نَشَ عَ قَلَ، «عَمِنَ، عَلَتَلَ شَ عَ رَبَ نَ كِ. عَلَتَلَ شَ عِ شَ مَسٍنيِ رَكَمَلِ. عَ شَ عَ شَ هْرْ مْبَنشِ شُنمَسٍيٍ رَفبِلٍن بٍ كٍلِقٍ بَبِلْن بْشِ مَ، عَ نُن عِسِرَيِلَ حَمَ نَشٍيٍ نَ كٌنيِيَ كُي مّننِ. <verse eid="JER 28:6"/><verse number="7" style="v" sid="JER 28:7"/>كْنْ ﭑ شَ عَ قَلَ عِ بّ، عَ نُن حَمَ بِرِن بّ، وٌ شَ وٌ تُلِ مَتِ ﭑ نَ. <verse eid="JER 28:7"/><verse number="8" style="v" sid="JER 28:8"/>كَبِ تّمُي شْننَكُيٍ بٍينُن وٌن مَ وَشَتِ، نَمِحْنمّيٍ بَرَ مَسٍنيِ تِ حَمَنّيٍ نُن مَنفّيَيٍ شِلِ مَ، عَ قَلَقٍ رَ عٍ شَ فٍرٍ سْتْ، تْورّ، نُن قُرٍ حَاشِ. <verse eid="JER 28:8"/><verse number="9" style="v" sid="JER 28:9"/>كْنْ شَ عَ سَ لِ نَمِحْنمّ ندٍ مَسٍنيِ تِ بْحّسَ شَ قٍ رَ، قٌ نَ مَسٍنيِ شَ كَمَلِ نّ بٍينُن مِشِيٍ شَ عَ كٌلٌن عَلَتَلَ نَن نَ نَمِحْنمّ شّيشِ.»<verse eid="JER 28:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 28:10"/>عَننَبِ شَنَنِيَ نَشَ كَرَقٌي بَ عَننَبِ يٍرٍ مِ كْن مَ، عَ نَشَ عَ عِفِرَ. <verse eid="JER 28:10"/><verse number="11" style="v" sid="JER 28:11"/>نَ كُي عَ نَشَ عَ قَلَ حَمَ بّ، «عَلَتَلَ شَ مَسٍنيِ نَن يَ. بٍينُن حّ قِرِن، ﭑ قَمَ نّ بَبِلْن مَنفّ نٍبُكَدَنسَرِ شَ يَامَرِ بَدٍ حَمَنّ بِرِن مَ.» عَننَبِ يٍرٍ مِ نَشَ سِفَ.<verse eid="JER 28:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 28:12"/>عَننَبِ شَنَنِيَ تٌ فّ عَننَبِ يٍرٍ مِ شَ كَرَقٌي عِفِرَدٍ، عَلَتَلَ نَشَ يِ مَسٍنيِ تِ عَننَبِ يٍرٍ مِ بّ، <verse eid="JER 28:12"/><verse number="13" style="v" sid="JER 28:13"/>«سِفَ، عِ سَ عَ قَلَ شَنَنِيَ بّ، ‹عَلَتَلَ بَرَ عَ مَسٍن عِ بّ، عِ بَرَ كَرَقٌي وُرِ دَاشِ عِفِرَ، كْنْ ﭑ قَمَ كَرَقٌي وُرٍ دَاشِ نَن نَفٌرٌدٍ عِ كْن مَ.› <verse eid="JER 28:13"/><verse number="14" style="v" sid="JER 28:14"/>عِسِرَيِلَ مَنفّ عَلَتَلَ شَ مَسٍنيِ نَن يَ، ‹ﭑ قَمَ كَرَقٌي وُرٍ دَاشِ نَن سَدٍ حَمَنّ بِرِن كْن مَ، عَلَكٌ عٍ شَ لُ بَبِلْن مَنفّ نٍبُكَدَنسَرِ شَ يَامَرِ بُن مَ. ﭑ مَن بَرَ وُلَءِ سُبٍ بِرِن سَ عَ سَفٌي.›»<verse eid="JER 28:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 28:15"/>عَننَبِ يٍرٍ مِ نَشَ عَ قَلَ شَنَنِيَ بّ، «عِ تُلِ مَتِ شَنَنِيَ. عَلَتَلَ شَ مُ عِ شّيشِ. عِ شَشِلِسَ وْيّنيِ نَشَن قَلَقٍ حَمَ بّ، عَ قِندِشِ وُلٍ نَن نَ. <verse eid="JER 28:15"/><verse number="16" style="v" sid="JER 28:16"/>عَلَتَلَ نَشَ عَ مَسٍن، ‹ﭑ شَ عَ قَلَ عِ بّ، ﭑ عِ كٍرِ مَ نّ يِ بْشِ مَ، عِ قَ قَشَ تٌوقَرٍ، بَرِ مَ عِ بَرَ عَلَتَلَ شَ مَسٍنيِ مَتَندِ.›» <verse eid="JER 28:16"/><verse number="17" style="v" sid="JER 28:17"/>عَننَبِ شَنَنِيَ نَشَ قَشَ نَ حّ كُي، كِكٍ سٌلٌقٍرٍ ندٍ.<verse eid="JER 28:17"/></para>
  <chapter eid="JER 28"/>
  <chapter number="29" style="c" sid="JER 29"/>
  <para style="s">عَننَبِ يٍرٍ مِ شَ بَتَاشّ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 29:1"/>بَتَاشّ نَن يَ، عَننَبِ يٍرٍ مِ نَشَن نَسَنبَ كٍلِقٍ دَرِ سَلَمُ، سِفَقٍ بَبِلْن. عَ عَ سّبّ قٌرِيٍ، سّرّشّدُبّيٍ، نَمِحْنمّيٍ، نُن عِسِرَيِلَ حَمَ بِرِن نَن مَ، نٍبُكَدَنسَرِ نُ بَرَ نَشٍيٍ شَنِن بَبِلْن كٍلِقٍ دَرِ سَلَمُ. <verse eid="JER 29:1"/><verse number="2" style="v" sid="JER 29:2"/>سِنفٍ نُ، مَنفّ يٍهٌيَكِنِ، عَ نفَ، مَنفّ بَتُلَيٍ، يُدَيَ نُن دَرِ سَلَمُ كُنتِفِيٍ، نُن وَلِكّ قَنيِيٍ نُ بَرَ كٍلِ دَرِ سَلَمُ سِفَقٍ رَ بَبِلْن. <verse eid="JER 29:2"/><verse number="3" style="v" sid="JER 29:3"/>عَننَبِ يٍرٍ مِ نَشَ يِ بَتَاشّ تَشُ سَقَن شَ دِ عٍلَاسَ رَ، عَ نُن شِلِكِيَ شَ دِ فّمَرَيَ رَ. يُدَيَ مَنفّ سٍدٍكِيَ نُ بَرَ شِلِكِيَ سِنفٍ شّي مَنفّ نٍبُكَدَنسَرِ شْن بَبِلْن بْشِ مَ.<verse eid="JER 29:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 29:4"/>عِسِرَيِلَ مَرِفِ عَلَتَلَ شَ مَسٍنيِ نَن يَ، كَتَرَبِ مِشِ مَ نَشٍيٍ شَنِنشِ كٌنيِيَ كُي بَبِلْن بْشِ مَ؛ <verse eid="JER 29:4"/><verse number="5" style="v" sid="JER 29:5"/>«وٌ شَ بَنشِيٍ تِ، وٌ شَ سَبَتِ نَا. وٌ شَ لَاكْي سَ، وٌ شَ بَلٌ عَ بٌفِ شُن نَ. <verse eid="JER 29:5"/><verse number="6" style="v" sid="JER 29:6"/>وٌ شَ فِنّيٍ دْشْ، وٌ شَ دِيٍ سْتْ. وٌ شَ فِنّيٍ قٍن وٌ شَ دِيٍ بّ، وٌ شَ وٌ شَ دِ فِنّيٍ قِ شّمّيٍ مَ قُتِ رَ، عَلَكٌ نٍيٍ قَن شَ دِيٍ سْتْ. وٌ شَ وُيَ نَا، وٌ نَشَ شُرُن. <verse eid="JER 29:6"/><verse number="7" style="v" sid="JER 29:7"/>وٌ شَ شُننَقَنيِ قٍن نَ تَا بّ ﭑ وٌ شَنِنشِ دّننَشّ. وٌ مَن شَ عَلَتَلَ مَشَندِ عٍ بّ، بَرِ مَ وٌ شَ هّيرِ قَتَنشِ عٍ شَ هّيرِ نَن نَ.»<verse eid="JER 29:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 29:8"/>عِسِرَيِلَ مَرِفِ عَلَتَلَ نَشَ عَ مَسٍن، «وٌ نَشَ تِن وٌ شَ نَمِحْنمّيٍ شَ وٌ مَدَشُ. وٌ نَشَ وٌ تُلِ مَتِ سٍ مَتٌي رَ، وٌ نَشَ لَ وٌ يّتّ شَ شِيٍ رَ. <verse eid="JER 29:8"/><verse number="9" style="v" sid="JER 29:9"/>وٌ شَ نَمِحْنمّيٍ شَ مَسٍنيِ قِندِشِ وُلٍ نَن نَ. عٍ وْيّنمَ ﭑ شِلِ نَن نَ، كْنْ ﭑ تَن شَ مُ عٍ شّيشِ. عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.»<verse eid="JER 29:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JER 29:10"/>عَلَتَلَ تَن نَشَن مَسٍنشِ نَ نَن يَ، «وٌ نَ فّ حّ تٌنفٌ سٌلٌقٍرٍ رَبَدٍ بَبِلْن، ﭑ نَن ﭑ مَ لَايِدِ رَكَمَلِمَ نّ وٌ رَفبِلٍنقٍ رَ بٍ. <verse eid="JER 29:10"/><verse number="11" style="v" sid="JER 29:11"/>ﭑ عَ كٌلٌن ﭑ قٍ نَشَن حَنِفٍشِ وٌ بّ، قٍ قَنيِ نَ عَ رَ، تْورّ مُ نَ نَشَن كُي. ﭑ عَ رَفِرِ مَ نّ وٌ مَ عَلَكٌ وٌ شَ هّيرِ سْتْ يَرٍ. عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ. <verse eid="JER 29:11"/><verse number="12" style="v" sid="JER 29:12"/>وٌ نَ ﭑ شِلِ، ﭑ قَمَ نّ وٌ رَفبِلٍندٍ. وٌ نَ ﭑ مَشَندِ، ﭑ قَمَ نّ وٌ شَ دُبَ سُشُدٍ. <verse eid="JER 29:12"/><verse number="13" style="v" sid="JER 29:13"/>وٌ نَ ﭑ قٍن، وٌ قَمَ نّ ﭑ تٌدٍ، بَرِ مَ وٌ ﭑ قٍنمَ وٌ بْحّ بِرِن نَن نَ. <verse eid="JER 29:13"/><verse number="14" style="v" sid="JER 29:14"/>ﭑ مُ تِنمَ ﭑ نْشُندٍ وٌ مَ. ﭑ قَمَ نّ وٌ شَ مِشِيٍ رَ مِنِدٍ كٌنيِيَ كُي، ﭑ قَ عٍ رَفبِلٍندٍ بٍ كٍلِقٍ حَمَنّ بِرِن مَ، ﭑ عٍ شَنِن دّننَشّ. عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.»<verse eid="JER 29:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 29:15"/>وٌ عَ قَلَمَ، «عَلَ بَرَ نَمِحْنمّ ندٍيٍ رَ مِنِ وٌن يَ مَ بَبِلْن بْشِ مَ.» <verse eid="JER 29:15"/><verse number="16" style="v" sid="JER 29:16"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ عَ نَشَن مَسٍنشِ مَنفّ بّ نَشَن دْشْشِ دَوُدَ شَ كِبَنيِ كُي، عَ نُن حَمَ نَشَن سَبَتِشِ يِ تَا كُي، وٌ نفَشَكٍرٍنيِ نَشٍيٍ مُ شَنِنشِ كٌنيِيَ كُي. <verse eid="JER 29:16"/><verse number="17" style="v" sid="JER 29:17"/>مَنفّ عَلَتَلَ شَ مَسٍنيِ نَن يَ؛ «ﭑ قَمَ نّ سَنتِدّفّمَ، كَامّ، نُن قُرٍ حَاشِ رَ عٍ شِلِ مَ. ﭑ عٍ لُمَ نّ عَلْ شْرّ كَنَشِ نَشَن مُ نْمَ دٌندٍ. <verse eid="JER 29:17"/><verse number="18" style="v" sid="JER 29:18"/>ﭑ بِرَ مَ نّ عٍ قْشْ رَ سَنتِدّفّمَ، كَامّ، نُن قُرٍ حَاشِ رَ. ﭑ عٍ قِندِ مَ نّ مِشِ دَنكَشِيٍ رَ دُنِحَ بِرِن مَ. مِشِيٍ دّ عِشَرَ مَ نّ عٍ شَ قٍ رَ، عٍ يٌ عٍ مَ. عٍ يَافِمَ نّ سِ بِرِن تَفِ ﭑ نٍيٍ رَيٍنسٍنشِ دّننَشّ. <verse eid="JER 29:18"/><verse number="19" style="v" sid="JER 29:19"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ. ﭑ نَ بِرِن نَبَشِ نّ بَرِ مَ عٍ مُ ﭑ مَ مَسٍنيِ سُشُشِ. ﭑ بَرَ ﭑ مَ كٌنيِ نَمِحْنمّيٍ شّي عٍ يِرٍ كَبِ قْلّ، كْنْ عٍ مُ عٍ تُلِ مَتِشِ عٍ شُي رَ. عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.»<verse eid="JER 29:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 29:20"/>«كْنْ وٌ تَن، ﭑ نَشٍيٍ شّيشِ بَبِلْن، كٍلِقٍ دَرِ سَلَمُ، وٌ شَ وٌ تُلِ مَتِ عَلَتَلَ شَ مَسٍنيِ رَ. <verse eid="JER 29:20"/><verse number="21" style="v" sid="JER 29:21"/>عِسِرَيِلَ مَنفّ عَلَتَلَ شَ مَسٍنيِ نَن يَ كٌلَيَ شَ دِ عَكَبُ، عَ نُن مَاسٍيَ شَ دِ سٍدٍكِيَ شَ قٍ رَ، نَشٍيٍ نَمِحْنمّ مَسٍنيِ وُلٍ دَاشِ قَلَشِ وٌ بّ ﭑ شِلِ رَ. ﭑ عٍ سَمَ نّ بَبِلْن مَنفّ نٍبُكَدَنسَرِ سَفٌي، عَ عٍ قَشَ وٌ يَ شْرِ. <verse eid="JER 29:21"/><verse number="22" style="v" sid="JER 29:22"/>يُدَيَكَيٍ نَشٍيٍ شَنِنشِ كٌنيِيَ كُي بَبِلْن بْشِ مَ، عٍ قَمَ دَنكّ تِدٍ يِ كِ نّ؛ ‹عَلَتَلَ شَ عِ شَ قٍ رَبَ عَلْ عَ سٍدٍكِيَ نُن عَكَبُ شَ قٍ رَبَ كِ نَشّ.› بَبِلْن مَنفّ نَشَ عٍ فَن تّ رَ، <verse eid="JER 29:22"/><verse number="23" style="v" sid="JER 29:23"/>بَرِ مَ عٍ نُ بَرَ قٍ حَاشِ رَبَ عِسِرَيِلَ بْشِ مَ. عٍ نُ يّنّ رَبَ عٍ دْشْبٌورٍيٍ شَ فِنّيٍ رَ، عٍ مَن نُ وُلٍ قَلَ ﭑ شِلِ رَ، هَلِ ﭑ مُ يَامَرِ نَشَن سٌشِ عٍ يِ.» عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="JER 29:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 29:24"/>عِ شَ عَ مَسٍن سٍمَيَ نٍشٍلَمِكَ بّ، <verse eid="JER 29:24"/><verse number="25" style="v" sid="JER 29:25"/>«عِسِرَيِلَ مَرِفِ عَلَتَلَ بَرَ عَ مَسٍن، ‹عِ بَرَ بَتَاشّيٍ رَ سَنبَ عِ شِلِ رَ دَرِ سَلَمُ حَمَ بِرِن مَ، عَ نُن سّرّشّدُبّ مَاسٍيَ شَ دِ سٍقَنِيَ، نُن سّرّشّدُبّ بِرِن مَ. يِ نَن سّبّشِ عٍ كُي؛ <verse eid="JER 29:25"/><verse number="26" style="v" sid="JER 29:26"/>«عَلَتَلَ بَرَ عِ قِندِ سّرّشّدُبّ رَ يٍهٌيَدَ حْشْي رَ، عَلَكٌ عِ شَ مِشِيٍ مَتٌ عَلَتَلَ شَ بَنشِ كُي نَشٍيٍ وَ مَ عٍ يّتّ قِندِقٍ نَمِحْنمّ رَ. عَ لَنمَ نَ كَنيِيٍ شَ شِرِ وُرِ مَ، شَ نَ مُ عَ رَ يْلْنشْنيِ شَ سَ عٍ مَ. <verse eid="JER 29:26"/><verse number="27" style="v" sid="JER 29:27"/>مُنقٍ رَ عِ مُ عَننَبِ يٍرٍ مِ عَنَتْتِكَ تَن سُشُ، نَشَن بَرَ عَ يّتّ قِندِ نَمِحْنمّ رَ وٌ تَفِ، <verse eid="JER 29:27"/><verse number="28" style="v" sid="JER 29:28"/>نَشَن بَرَ بَتَاشّ رَ سَنبَ وٌن مَ بَبِلْن عَ قَلَقٍ رَ وٌن بُمَ نّ، عَ لَنمَ وٌن شَ بَنشِيٍ تِ، وٌن شَ سَبَتِ بٍ، وٌن شَ لَاكْي سَ، وٌن شَ عٍ بٌفِ دٌن.» ›»<verse eid="JER 29:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JER 29:29"/>سّرّشّدُبّ سٍقَنِيَ نَشَ نَ بَتَاشّ شَرَن عَننَبِ يٍرٍ مِ يَ شْرِ. <verse eid="JER 29:29"/><verse number="30" style="v" sid="JER 29:30"/>عَلَتَلَ نَشَ يِ مَسٍنيِ سٌ عَننَبِ يٍرٍ مِ يِ رَ؛ <verse eid="JER 29:30"/><verse number="31" style="v" sid="JER 29:31"/>«عَ مَسٍن عِسِرَيِلَكَيٍ بِرِن بّ نَشٍيٍ نَ كٌنيِيَ كُي بَبِلْن بْشِ مَ، ‹عَلَتَلَ شَ مَسٍنيِ سٍمَيَ نٍشٍلَمِكَ شَ قٍ رَ، نَ نَن يَ؛ سٍمَيَ تٌ بَرَ عَ يّتّ قِندِ نَمِحْنمّ رَ، هَلِ ﭑ تَن شَ مُ عَ شّيشِ، عَ نُ قَ وٌ مَدَشُ وُلٍ رَ، <verse eid="JER 29:31"/><verse number="32" style="v" sid="JER 29:32"/>ﭑ تَن عَلَتَلَ بَرَ نَتّ تٌنفٌ ﭑ شَ سٍمَيَ نٍشٍلَمِكَ نُن عَ بْنسْي حَشَنكَتَ. ﭑ عٍ بِرِن بَمَ نّ يِ حَمَ يَ مَ. عَ مُ قَمَ ﭑ مَ قٍ قَنيِ تٌدٍ ﭑ نَشَن نَبَمَ يِ حَمَ بّ، بَرِ مَ عَ شَ مَسٍنيِ بَرَ عَ نِيَ مِشِيٍ شَ ﭑ مَتَندِ. عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.›»<verse eid="JER 29:32"/></para>
  <chapter eid="JER 29"/>
  <chapter number="30" style="c" sid="JER 30"/>
  <para style="s">عَلَ شَ لَايِدِ عِسِرَيِلَ بّ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 30:1"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ عَ نَشَن مَسٍنشِ عَننَبِ يٍرٍ مِ بّ. <verse eid="JER 30:1"/><verse number="2" style="v" sid="JER 30:2"/>عِسِرَيِلَ مَرِفِ عَلَتَلَ شَ مَسٍنيِ نَن يَ؛ «ﭑ مَ مَسٍنيِ سّبّ كِتَابُي. <verse eid="JER 30:2"/><verse number="3" style="v" sid="JER 30:3"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛ ﭑ شَ عَ قَلَ وٌ بّ، لْشْي قَمَ عَ لِدٍ ﭑ نَن ﭑ مَ حَمَ رَ مِنِمَ كٌنيِيَ كُي تّمُي نَشّ. ﭑ عِسِرَيِلَ نُن يُدَيَ رَفبِلٍنمَ نّ بْشِ مَ ﭑ دّننَشّ قِشِ عٍ بٍنبَيٍ مَ. نَ بْشِ مَن شَ قِندِ عٍ فبٍ رَ.»<verse eid="JER 30:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 30:4"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ عِسِرَيِلَ نُن يُدَيَ شَ قٍ رَ؛<verse eid="JER 30:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JER 30:5"/>عَلَتَلَ بَرَ عَ مَسٍن،</para>
  <para style="q" vid="JER 30:5">«وٌن بَرَ سْنشْي شْرْشْي مّ،</para>
  <para style="q" vid="JER 30:5">عَ مَفَاشُ، بْحّسَ يٌ مُ نَ.<verse eid="JER 30:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JER 30:6"/>وٌ عَ كٌلٌن شّمّ مُ دِ بَرِ مَ،</para>
  <para style="q" vid="JER 30:6">كْنْ يِ وَشَتِ شّمّ عٍ قُرِ سُشُمَ عٍ بّلّشّ رَ</para>
  <para style="q" vid="JER 30:6">عَلْ فِنّ عٍ قُرِ سُشُمَ كِ نَشّ عٍ دِ بَرِ تّمُي.</para>
  <para style="q" vid="JER 30:6">مُنقٍ رَ عٍ يَتَفِ مَسَرَشِ؟<verse eid="JER 30:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JER 30:7"/>فبَلٌي لْشْي نَ عَ رَ نَشَن دَنفِمَ عَ بِرِن نَ.</para>
  <para style="q" vid="JER 30:7">عَ شْرْشْ يَشُبَ بْنسْي بّ، كْنْ عٍ كِسِمَ نّ.»<verse eid="JER 30:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="JER 30:8"/>مَنفّ عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 30:8">«نَ وَشَتِ نَ لِ،</para>
  <para style="q" vid="JER 30:8">ﭑ قَمَ نّ بَبِلْن شَ نْي بَدٍ وٌ قَرِ.</para>
  <para style="q" vid="JER 30:8">ﭑ وٌ شَ يْلْنشْنيِ بٌلٌنمَ نّ،</para>
  <para style="q" vid="JER 30:8">وٌ مُ لُمَ حَمَنّ فبّتّ سَفٌي سْنْن.<verse eid="JER 30:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JER 30:9"/>وٌ قَمَ نّ وٌ مَرِفِ عَلَتَلَ بَتُدٍ،</para>
  <para style="q" vid="JER 30:9">عَ نُن وٌ شَ مَنفّ دَوُدَ ﭑ نَشَن نَكٍلِمَ.»<verse eid="JER 30:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="JER 30:10"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 30:10">«ﭑ مَ كٌنيِ يَشُبَ، وٌ نَشَ فَاشُ.</para>
  <para style="q" vid="JER 30:10">عِسِرَيِلَ، وٌ نَشَ سّرّن.</para>
  <para style="q" vid="JER 30:10">ﭑ قَمَ نّ وٌ شْرّيَدٍ،</para>
  <para style="q" vid="JER 30:10">ﭑ وٌ بْنسْي رَ مِنِ كٌنيِيَ كُي يِرٍ مَكُيٍ،</para>
  <para style="q" vid="JER 30:10">يَشُبَ قَ سَبَتِ بْحّسَ كُي يِ بْشِ مَ.</para>
  <para style="q" vid="JER 30:10">مِشِ يٌ مُ عِ تْورْ مَ سْنْن،<verse eid="JER 30:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JER 30:11"/>بَرِ مَ وٌن بِرِن نَ عَ رَ.</para>
  <para style="q" vid="JER 30:11">ﭑ وٌ تَن نَكِسِمَ نّ،</para>
  <para style="q" vid="JER 30:11">كْنْ ﭑ سِ فبّتّيٍ تَن حَشَنكَتَ،</para>
  <para style="q" vid="JER 30:11">ﭑ وٌ رَيٍنسٍن يّ دّننَشّ.</para>
  <para style="q" vid="JER 30:11">ﭑ وٌ حَشَنكَتَمَ نّ تِنشِنيِ كُي،</para>
  <para style="q" vid="JER 30:11">عَلْ عَ لَن عَ شَ رَبَ كِ نَشّ،</para>
  <para style="q" vid="JER 30:11">كْنْ ﭑ مُ قَمَ وٌ سْنتْدٍ.<verse eid="JER 30:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JER 30:12"/>عَلَتَلَ نَشَ عَ مَسٍن؛</para>
  <para style="q" vid="JER 30:12">وٌ شَ فبَلٌي مُ كَنَمَ، قٌ وٌ شَ تْورْ.<verse eid="JER 30:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JER 30:13"/>مِشِ مُ نَ نَشَن وٌ مَلِمَ،</para>
  <para style="q" vid="JER 30:13">نَشَن وٌ شَ تْورّ دَندَنمَ.</para>
  <para style="q" vid="JER 30:13">سٍرِ مُ نَ وٌ بّ.<verse eid="JER 30:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JER 30:14"/>وٌ شَنُنتٍنيِيٍ بَرَ نّيمُ وٌ مَ،</para>
  <para style="q" vid="JER 30:14">عٍ مُ وٌ قٍنمَ سْنْن،</para>
  <para style="q" vid="JER 30:14">بَرِ مَ ﭑ تَن بَرَ وٌ بْنبْ عَ حَاشِ رَ،</para>
  <para style="q" vid="JER 30:14">ﭑ بَرَ حَشَنكَتّ شْرْشْي دْشْ وٌ مَ،</para>
  <para style="q" vid="JER 30:14">وٌ شَ يُنُبِ وُيَشِيٍ نُن وٌ شَ كٌبِحَ شَ قٍ رَ.<verse eid="JER 30:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 30:15"/>مُنقٍ رَ وٌ نَ وَقٍ نَ فبَلٌي شَ قٍ رَ؟</para>
  <para style="q" vid="JER 30:15">مُنقٍ رَ وٌ مُ تِنمَ نَ حَشَنكَتّ رَ؟</para>
  <para style="q" vid="JER 30:15">ﭑ نَ بِرِن نَبَشِ وٌ شَ كٌبِحَ نُن وٌ شَ يُنُبِ وُيَشِيٍ نَن مَ قٍ رَ.<verse eid="JER 30:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 30:16"/>نَ نَن عَ رَ، مِشِ نَشٍيٍ بَرَ وٌ تْورْ،</para>
  <para style="q" vid="JER 30:16">عٍ قَن تْورّ نَن سْتْمَ.</para>
  <para style="q" vid="JER 30:16">وٌ يَشُي بِرِن سِفَمَ نّ كٌنيِيَ كُي.</para>
  <para style="q" vid="JER 30:16">مِشِ نَشٍيٍ بَرَ وٌ هَرِفٍ بَ وٌ يِ،</para>
  <para style="q" vid="JER 30:16">عٍ قَن هَرِفٍ بَمَ نّ عٍ يِ رَ.</para>
  <para style="q" vid="JER 30:16">مِشِ نَشٍيٍ بَرَ وٌ شَ تَايٍ كَنَ،</para>
  <para style="q" vid="JER 30:16">ﭑ عَ نِيَمَ نّ عٍ تَن قَن شَ تَايٍ شَ كَنَ.»<verse eid="JER 30:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="JER 30:17"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 30:17">«ﭑ قَمَ نّ وٌ رَكٍلِدٍ، ﭑ قَ وٌ رَيَلَندٍ.</para>
  <para style="q" vid="JER 30:17">عٍ بَرَ وٌ شِلِ سِيٌن رَبّحِنشِ،<verse eid="JER 30:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JER 30:18"/>كْنْ عَلَتَلَ بَرَ عَ مَسٍن،</para>
  <para style="q" vid="JER 30:18">ﭑ يَشُبَ هَرِفٍ رَفبِلٍنمَ نّ عَ بْنسْي مَ،</para>
  <para style="q" vid="JER 30:18">ﭑ عٍ شَ لِنفِرَيٍ رَكٍلِمَ نّ،</para>
  <para style="q" vid="JER 30:18">ﭑ عٍ شَ تَايٍ تِمَ نّ تَا قٌرِ كَنَشِ قَرِ،</para>
  <para style="q" vid="JER 30:18">ﭑ عٍ شَ مَنفّ بَنشِ يَءِلَن عَ يِرٍ قٌرِ.<verse eid="JER 30:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JER 30:19"/>عٍ قَمَ نّ ﭑ مَتْشْدٍ عٍ شُي عِتٍشِ سّيوّ كُي.</para>
  <para style="q" vid="JER 30:19">ﭑ عٍ رَوُيَمَ نّ، عٍ مُ شُرُنمَ.</para>
  <para style="q" vid="JER 30:19">ﭑ عٍ بِنيَمَ نّ، عَلَكٌ عٍ نَشَ لُ يَافِ كُي سْنْن.<verse eid="JER 30:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 30:20"/>يَشُبَ شَ دِيٍ مَن لُمَ نّ عَلْ عَ سِنفٍ،</para>
  <para style="q" vid="JER 30:20">عَ بْنسْي سّنبّ سْتْ ﭑ يَ شْرِ.</para>
  <para style="q" vid="JER 30:20">ﭑ عٍ يَشُييٍ فٍرٍ مَ نّ.<verse eid="JER 30:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JER 30:21"/>مَنفّ مِنِمَ نّ يَشُبَ بْنسْي،</para>
  <para style="q" vid="JER 30:21">عٍ شَ مَنفّ قَمَ قِندِدٍ عٍ شَ مِشِ ندٍ نَن نَ.</para>
  <para style="q" vid="JER 30:21">ﭑ تَن نَ عَ رَ مِنِمَ، عَ شَ عَ مَكْرّ ﭑ نَ،</para>
  <para style="q" vid="JER 30:21">شَ نَ مُ عَ رَ مِشِ يٌ مُ نْمَ نَ رَبَدٍ عَ يّتّ رَ.</para>
  <para style="q" vid="JER 30:21">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.»<verse eid="JER 30:21"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="22" style="v" sid="JER 30:22"/>«وٌ قِندِ مَ نّ ﭑ مَ حَمَ رَ،</para>
  <para style="q" vid="JER 30:22">ﭑ قَن قِندِ وٌ مَرِفِ عَلَ رَ.<verse eid="JER 30:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JER 30:23"/>عَلَتَلَ شَ شْنّ نَن يَ،</para>
  <para style="q" vid="JER 30:23">عَ بْحّ تٍمَ نّ عَلْ قٌيٍ بٍلٍبٍلٍ،</para>
  <para style="q" vid="JER 30:23">عَ قَ مِشِ حَاشِ شُن نَكَنَ.<verse eid="JER 30:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JER 30:24"/>عَلَتَلَ شَ شْنّ مُ بَمَ</para>
  <para style="q" vid="JER 30:24">هَن عَ فّ وَلِ بِرِن نَبَدٍ عَ وَ مَ نَشَن شْن.</para>
  <para style="q" vid="JER 30:24">وٌ قَمَ نّ نَ بِرِن قَهَامُدٍ عَ وَشَتِ.»<verse eid="JER 30:24"/></para>
  <chapter eid="JER 30"/>
  <chapter number="31" style="c" sid="JER 31"/>
  <para style="s">عِسِرَيِلَ شَ كِسِ</para>
  <para style="sp">عَلَتَلَ شَ مَسٍنيِ</para>
  <para style="q">
    <verse number="1" style="v" sid="JER 31:1"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ،</para>
  <para style="q" vid="JER 31:1">«وَشَتِ ندٍ قَمَ، ﭑ قِندِ مَ نّ عِسِرَيِلَ بْنسْي بِرِن مَرِفِ عَلَ رَ.</para>
  <para style="q" vid="JER 31:1">عٍ تَن قَن قِندِ مَ نّ ﭑ مَ حَمَ رَ.»<verse eid="JER 31:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="JER 31:2"/>عَلَتَلَ بَرَ عَ مَسٍن،</para>
  <para style="q" vid="JER 31:2">«عَلَتَلَ بَرَ هِننّ عِسِرَيِلَ رَ</para>
  <para style="q" vid="JER 31:2">عَ نَشَن نَتَنفَشِ سَنتِدّفّمَ رَ فبٍنفبٍرٍن يِرٍ.</para>
  <para style="q" vid="JER 31:2">عِسِرَيِلَ قَمَ نّ مَلَبُي سْتْدٍ.»<verse eid="JER 31:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="JER 31:3"/>عَلَتَلَ بَرَ عَ مَسٍن ﭑ بّ كٍلِقٍ يِرٍ مَكُيٍ،</para>
  <para style="q" vid="JER 31:3">«ﭑ عِ شَنُمَ نّ عَبَدَن.</para>
  <para style="q" vid="JER 31:3">ﭑ مَ هِننّ مُ حْنمَ عِ بّ.<verse eid="JER 31:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JER 31:4"/>عِسِرَيِلَ، ﭑ عِ رَكٍلِمَ نّ، ﭑ عِ يَءِلَن.</para>
  <para style="q" vid="JER 31:4">عِ مَن بّيتِ بَمَ نّ سّيوّ كُي مَشَسٍيٍ شُي نُن قَرٍ رَ.<verse eid="JER 31:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JER 31:5"/>عِ مَن سَنسِ سِمَ نّ سَمَرِ فٍيَيٍ قَرِ.</para>
  <para style="q" vid="JER 31:5">بْشِ رَوَلِمَيٍ سَنسِ سِمَ نّ، عٍ مَن عَ بٌفِ بَ.<verse eid="JER 31:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JER 31:6"/>لْشْي قَمَ عَ لِدٍ،</para>
  <para style="q" vid="JER 31:6">كَنتَمَيٍ شِلِ تِمَ نّ عٍقِرَ مِ فٍيَ قَرِ،</para>
  <para style="q" vid="JER 31:6">‹وٌ كٍلِ، وٌن شَ تٍ سِيٌن فٍيَ قَرِ</para>
  <para style="q" vid="JER 31:6">وٌن مَرِفِ عَلَ نَ دّننَشّ.›»<verse eid="JER 31:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="JER 31:7"/>عَلَتَلَ بَرَ عَ مَسٍن،</para>
  <para style="q" vid="JER 31:7">«وٌ شَ سّيوَ يَشُبَ شَ قٍ رَ،</para>
  <para style="q" vid="JER 31:7">وٌ شَ سِ بِرِن شُن تِ عَلَ مَتْشْي رَ.</para>
  <para style="q" vid="JER 31:7">وٌ وٌ شُي رَ مِنِ، وٌ شَ عَلَتَلَ تَنتُ،</para>
  <para style="q" vid="JER 31:7">نَشَن بَرَ عِسِرَيِلَ رَكِسِ، عَ شَ حَمَ نَشَن لُشِ.<verse eid="JER 31:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 31:8"/>ﭑ عٍ رَفبِلٍنمَ نّ كٍلِقٍ كْولَ مَ،</para>
  <para style="q" vid="JER 31:8">كٍلِقٍ دُنِحَ يِرٍ بِرِن.</para>
  <para style="q" vid="JER 31:8">دْنشُييٍ نُن مَبٌلٌنيِيٍ نَ عٍ تَفِ.</para>
  <para style="q" vid="JER 31:8">قُرِ فِنّيٍ نُن فِنّ نَشٍيٍ نَ دِ بَرِقٍ نَ عٍ يَ مَ.</para>
  <para style="q" vid="JER 31:8">حَمَ فبٍفبٍ فبِلٍنمَ نّ بٍ.<verse eid="JER 31:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JER 31:9"/>عٍ قَمَ نّ وَ رَ، عٍ عَلَ مَشَندِ.</para>
  <para style="q" vid="JER 31:9">ﭑ عٍ رَفبِلٍنمَ نّ يٍ يِرٍ كِرَ قَنيِ شْن مَ.</para>
  <para style="q" vid="JER 31:9">عٍ مُ بِرَ مَ بَرِ مَ ﭑ تَن نَن قِندِشِ عِسِرَيِلَ بَبَ رَ،</para>
  <para style="q" vid="JER 31:9">عٍقِرَ مِ بْنسْي ﭑ مَ دِ سِنفٍ نَ عَ رَ.<verse eid="JER 31:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JER 31:10"/>سِ بِرِن، وٌ شَ وٌ تُلِ مَتِ عَلَتَلَ شَ مَسٍنيِ رَ،</para>
  <para style="q" vid="JER 31:10">وٌ سَ عَ مَسٍن دُنِحَ بِرِن بّ.</para>
  <para style="q" vid="JER 31:10">وٌ شَ عَ قَلَ،</para>
  <para style="q" vid="JER 31:10">‹نَشَن عِسِرَيِلَ رَيٍنسٍنشِ،</para>
  <para style="q" vid="JER 31:10">عَ قَمَ نّ عٍ مَلَندٍ، عَ قَ عٍ كَنتَ</para>
  <para style="q" vid="JER 31:10">عَلْ شُرُ سٍ دّ مَدٌنيِ عَ شَ فْورّ مَكَنتَمَ كِ نَشّ.›<verse eid="JER 31:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JER 31:11"/>وٌ شَ نَ قَلَ، بَرِ مَ عَلَتَلَ قَمَ يَشُبَ شْرّيَدٍ،</para>
  <para style="q" vid="JER 31:11">عَ عٍ شُن سَرَ مِشِ مَ نَشَن سّنبّ فبٌ عٍ بّ.<verse eid="JER 31:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JER 31:12"/>عٍ فبِلٍنمَ نّ، عٍ شُننَكٍلِ سْتْ سِيٌن قَرِ.</para>
  <para style="q" vid="JER 31:12">عٍ بَرَكّ سْتْمَ نّ عَلَتَلَ بّلّشّ،</para>
  <para style="q" vid="JER 31:12">عَلْ مّنفِ، وّنِ نّينّ، تُرٍ، يّشّي، نُن نِنفٍيٍ.</para>
  <para style="q" vid="JER 31:12">عٍ لُمَ نّ عَلْ لَاكْي يِرٍ يٍ نَ دّننَشّ،</para>
  <para style="q" vid="JER 31:12">عٍ مُ تْورْ مَ سْنْن.<verse eid="JER 31:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JER 31:13"/>فِنّ دِ مّدِيٍ لُمَ نّ قَرٍ بٌرٌن نَ،</para>
  <para style="q" vid="JER 31:13">سّفّتَلَيٍ نُن شّمْشِيٍ قَن شُلُنيِ رَبَ.</para>
  <para style="q" vid="JER 31:13">عٍ شَ سُننُنيِ قِندِ مَ نّ حّلّشِنيِ رَ.</para>
  <para style="q" vid="JER 31:13">ﭑ عٍ مَدُندُ مَ نّ عٍ شَ تْورّ كُي، عٍ شَ سّيوَ.<verse eid="JER 31:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JER 31:14"/>ﭑ سُبٍ تُرَشِ قِمَ نّ سّرّشّدُبّيٍ مَ،</para>
  <para style="q" vid="JER 31:14">ﭑ مَ حَمَ قَ لُفَ ﭑ هَرِفٍ رَ.»<verse eid="JER 31:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="JER 31:15"/>عَلَتَلَ بَرَ عَ مَسٍن،</para>
  <para style="q" vid="JER 31:15">«وَ شُي مِنِمَ نّ رَ مَ سُننُنيِ نَ دّننَشّ.</para>
  <para style="q" vid="JER 31:15">رَشٍلٍ وَ مَ نّ عَ شَ دِيٍ شَ قٍ رَ،</para>
  <para style="q" vid="JER 31:15">عَ مُ نْمَ دُندُدٍ بَرِ مَ عَ شَ دِيٍ مُ نَ.»<verse eid="JER 31:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 31:16"/>عَلَتَلَ بَرَ عَ مَسٍن،</para>
  <para style="q" vid="JER 31:16">«عِ سَبَرِ، عِ نَشَ وَ سْنْن.</para>
  <para style="q" vid="JER 31:16">ﭑ عِ شَ وَلِ سَرٍ رَفبِلٍنمَ نّ عِ مَ،</para>
  <para style="q" vid="JER 31:16">عِ شَ دِيٍ مَن فبِلٍنمَ نّ كٍلِقٍ عٍ يَشُييٍ يِرٍ.»</para>
  <para style="q" vid="JER 31:16">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="JER 31:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 31:17"/>«يِفِ نَ عِ بّ يَرٍ،</para>
  <para style="q" vid="JER 31:17">عِ شَ دِيٍ فبِلٍنمَ نّ عٍ شْنيِ.»</para>
  <para style="q" vid="JER 31:17">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="JER 31:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JER 31:18"/>«ﭑ بَرَ عٍقِرَ مِ وَ شُي مّ عَ عَ قَلَمَ،</para>
  <para style="q" vid="JER 31:18">‹عِ بَرَ ﭑ حَشَنكَتَ، عِ بَرَ ﭑ تْورْ،</para>
  <para style="q" vid="JER 31:18">عَلْ نِنفٍ نَشَن مُ شُرُشِ.</para>
  <para style="q" vid="JER 31:18">يَكْسِ، ﭑ مَلِ ﭑ شَ فبِلٍن،</para>
  <para style="q" vid="JER 31:18">بَرِ مَ عِ تَن نَن ﭑ مَرِفِ عَلَتَلَ رَ.<verse eid="JER 31:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JER 31:19"/>سِنفٍ ﭑ نُ بَرَ فبِلٍن عِ قْشْ رَ،</para>
  <para style="q" vid="JER 31:19">كْنْ نَ دَنفِ شَنبِ، ﭑ بَرَ تُوبِ.</para>
  <para style="q" vid="JER 31:19">ﭑ تٌ ﭑ حّرّ كِ مَتٌ قَ، ﭑ بَرَ شْنْ ﭑ يّتّ مَ.</para>
  <para style="q" vid="JER 31:19">ﭑ بَرَ يَافِ، ﭑ شَشِلِ بَرَ عِقُ،</para>
  <para style="q" vid="JER 31:19">بَرِ مَ كَبِ ﭑ دِ مّدِ تّمُي ﭑ حّرّ كِ مُ قَن.›<verse eid="JER 31:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 31:20"/>عٍقِرَ مِ ﭑ مَ دِ، قِسَمَنتٍ شَ مُ عَ رَ، ﭑ نَشَن شَنُشِ؟</para>
  <para style="q" vid="JER 31:20">ﭑ مُ نْمَ دُندُدٍ عَ شَ قٍ مَ،</para>
  <para style="q" vid="JER 31:20">عَ شَ قٍ لُمَ نّ ﭑ بْحّ كُي، ﭑ كِنِكِنِمَ نّ عَ مَ.»</para>
  <para style="q" vid="JER 31:20">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="JER 31:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JER 31:21"/>«عِسِرَيِلَ سّنِيّنشِ، عِ شَ تْنشُمَ تِ كِرَ شْن مَ،</para>
  <para style="q" vid="JER 31:21">عِ شَ سّبّلِ تِ كِرَ دّ رَ نَشَن عِ رَفبِلٍنمَ عِ شَ تَايٍ كُي.</para>
  <para style="q" vid="JER 31:21">عِسِرَيِلَ، عِ شَ فبِلٍن عِ شْنيِ.<verse eid="JER 31:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JER 31:22"/>ﭑ مَ دِ شُرُتَرٍ، عِ ﭑ مَتَندِ مَ هَن مُن تّمُي؟</para>
  <para style="q" vid="JER 31:22">عَلَتَلَ وَ مَ قٍ نّينّ رَ مِنِقٍ دُنِحَ مَ،</para>
  <para style="q" vid="JER 31:22">قٍ نّينّ، فِنّ نَن قَ شّمّ تَن قٍنمَ.»<verse eid="JER 31:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="JER 31:23"/>عِسِرَيِلَ مَنفّ عَلَتَلَ بَرَ عَ مَسٍن،</para>
  <para style="q" vid="JER 31:23">«ﭑ نَ يُدَيَكَيٍ رَفبِلٍن عٍ شْنيِ كٍلِقٍ كٌنيِيَ كُي،</para>
  <para style="q" vid="JER 31:23">مِشِ قَمَ نّ عَ قَلَدٍ يُدَيَ شَ قٍ رَ،</para>
  <para style="q" vid="JER 31:23">‹مَرِفِ شَ هِننّ عِ رَ يِرٍ تِنشِنشِ، فٍيَ سّنِيّنشِ قَرِ.›<verse eid="JER 31:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JER 31:24"/>يُدَيَكَيٍ قَمَ نّ سَبَتِدٍ عٍ شَ بْشِ مَ عٍ شَ تَايٍ كُي،</para>
  <para style="q" vid="JER 31:24">عٍ شَ وَلِكّيٍ نُن عٍ شَ شُرُ سٍ مَكَنتَمَيٍ.<verse eid="JER 31:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JER 31:25"/>ﭑ قَمَ نّ مِشِ تَفَنشِيٍ مَلِدٍ،</para>
  <para style="q" vid="JER 31:25">ﭑ تْورّ بَ عٍ مَ.»<verse eid="JER 31:25"/></para>
  <para style="sp">عَننَبِ يٍرٍ مِ شَ مَسٍنيِ</para>
  <para style="q">
    <verse number="26" style="v" sid="JER 31:26"/>نَ تّمُي ﭑ نَشَ شُنُ. ﭑ نُ بَرَ شِ عَ قَنيِ رَ.<verse eid="JER 31:26"/></para>
  <para style="sp">عَلَتَلَ شَ مَسٍنيِ</para>
  <para style="q">
    <verse number="27" style="v" sid="JER 31:27"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 31:27">«لْشْي قَمَ قَدٍ ﭑ عَ نِيَمَ نّ</para>
  <para style="q" vid="JER 31:27">عِسِرَيِلَ نُن يُدَيَ بْنسْي شَ وُيَ،</para>
  <para style="q" vid="JER 31:27">عٍ شَ شُرُ سٍيٍ شَ فبٌ.<verse eid="JER 31:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="JER 31:28"/>تّمُي دَنفِشِ ﭑ بَرَ بِرَ عٍ قْشْ رَ</para>
  <para style="q" vid="JER 31:28">عَلَكٌ ﭑ شَ عٍ رَحْن، ﭑ شَ عٍ تْورْ، ﭑ شَ عٍ شُن نَكَنَ،</para>
  <para style="q" vid="JER 31:28">ﭑ شَ عٍ كٍرِ، ﭑ شَ عٍ حَشَنكَتَ.</para>
  <para style="q" vid="JER 31:28">كْنْ يَكْسِ ﭑ بِرَ مَ نّ عٍ قْشْ رَ</para>
  <para style="q" vid="JER 31:28">عَلَكٌ ﭑ شَ عٍ تِ، ﭑ شَ عٍ شُن نَقَن.»</para>
  <para style="q" vid="JER 31:28">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="JER 31:28"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="29" style="v" sid="JER 31:29"/>«نَ تّمُي يِ تَالِ مُ قَلَمَ سْنْن،</para>
  <para style="q" vid="JER 31:29">‹بَبَيٍ نَ بٌفِ سٍ يْشْي دٌن،</para>
  <para style="q" vid="JER 31:29">عٍ شَ دِيٍ دّ بَرَبَرَ مَ نّ.›<verse eid="JER 31:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="JER 31:30"/>كَنكَن قَشَمَ نّ عَ يّتّ كَن مَ يُنُبِ شَ قٍ رَ.</para>
  <para style="q" vid="JER 31:30">مِشِ يٌ نَشَن نَ بٌفِ سٍ يْشْي دٌن،</para>
  <para style="q" vid="JER 31:30">نَ كَنيِ نَن دّ بَرَبَرَ مَ.»<verse eid="JER 31:30"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="31" style="v" sid="JER 31:31"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 31:31">«وَشَتِ قَمَ عَ لِدٍ، ﭑ سَاتّ نّينّ تٌنفٌمَ نّ عِسِرَيِلَ نُن يُدَيَ بْنسْي بّ.<verse eid="JER 31:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="JER 31:32"/>عَ مُ لُمَ عَلْ سَاتّ نَشَن نُ تٌنفٌشِ عٍ بَبَيٍ بّ،</para>
  <para style="q" vid="JER 31:32">ﭑ تٌ عٍ سُشُ، ﭑ عٍ رَ مِنِ مِسِرَ بْشِ رَ.</para>
  <para style="q" vid="JER 31:32">عٍ نَشَ نَ سَاتّ كَنَ هَلِ ﭑ تٌ قِندِشِ عٍ مَرِفِ رَ.<verse eid="JER 31:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="JER 31:33"/>سَاتّ نَن يَ ﭑ نَشَن تٌنفٌمَ عِسِرَيِلَ بْنسْي بّ؛</para>
  <para style="q" vid="JER 31:33">نَ وَشَتِ نَ دَنفِ،</para>
  <para style="q" vid="JER 31:33">ﭑ نَ ﭑ مَ سّرِيّ لُمَ نّ عٍ بْحّ مَ،</para>
  <para style="q" vid="JER 31:33">ﭑ عَ سّبّ عٍ سٌندٌنيِ مَ.</para>
  <para style="q" vid="JER 31:33">ﭑ قِندِ مَ نّ عٍ مَرِفِ عَلَ رَ،</para>
  <para style="q" vid="JER 31:33">عٍ قَن قِندِ ﭑ فبٍ حَمَ رَ.<verse eid="JER 31:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="JER 31:34"/>نَ وَشَتِ، مِشِ مُ عَ بٌورٍ شَرَنمَ سْنْن،</para>
  <para style="q" vid="JER 31:34">مِشِ مُ عَ قَلَمَ عَ نفَشَكٍرٍنيِيٍ بّ،</para>
  <para style="q" vid="JER 31:34">‹وٌ شَ عَلَتَلَ قٍن،›</para>
  <para style="q" vid="JER 31:34">بَرِ مَ عَ بِرِن ﭑ كٌلٌنمَ نّ،</para>
  <para style="q" vid="JER 31:34">كٍلِقٍ دِ مّدِ مَ عَ سَ دْشْ قٌرِ رَ.</para>
  <para style="q" vid="JER 31:34">ﭑ عٍ شَ يُنُبِيٍ شَقَرِ مَ نّ،</para>
  <para style="q" vid="JER 31:34">ﭑ مُ رَتُمَ عٍ شَ وَلِ كٌبِ مَ سْنْن.»</para>
  <para style="q" vid="JER 31:34">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="JER 31:34"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="35" style="v" sid="JER 31:35"/>عَلَتَلَ بَرَ عَ مَسٍن،</para>
  <para style="q" vid="JER 31:35">«مَنفّ عَلَتَلَ نَن عَ نِيَمَ سٌفٍ شَ يَنبَ يَنيِ رَ،</para>
  <para style="q" vid="JER 31:35">كِكٍ نُن تُنبُييٍ شَ يَنبَ كْي رَ.</para>
  <para style="q" vid="JER 31:35">عَ مْرْنيِ رَكٍلِمَ، عَ مْرْنيِ رَ مَشَمَ.»<verse eid="JER 31:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="JER 31:36"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ،</para>
  <para style="q" vid="JER 31:36">«شَ عَ سَ لِ نَ مْولِ مُ رَبَمَ سْنْن،</para>
  <para style="q" vid="JER 31:36">نَ وَشَتِ، عِسِرَيِلَ بْنسْي قَن مُ قِندِ مَ سِ رَ ﭑ يَ رَ.»<verse eid="JER 31:36"/></para>
  <para style="q">
    <verse number="37" style="v" sid="JER 31:37"/>عَلَتَلَ بَرَ عَ مَسٍن،</para>
  <para style="q" vid="JER 31:37">«شَ عَ سَ لِ كٌورٍ نْمَ مَنِيَدٍ،</para>
  <para style="q" vid="JER 31:37">شَ عَ سَ لِ بْشِ دْشْ كِ نْمَ كٌلٌندٍ،</para>
  <para style="q" vid="JER 31:37">نَ وَشَتِ ﭑ بَرَ مّي عِسِرَيِلَ بْنسْي رَ عٍ شَ وَلِ كٌبِ شَ قٍ رَ.»</para>
  <para style="q" vid="JER 31:37">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="JER 31:37"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="38" style="v" sid="JER 31:38"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 31:38">«وَشَتِ قَمَ قَدٍ يِ تَا مَن تِمَ نّ عَلَتَلَ بّ،</para>
  <para style="q" vid="JER 31:38">كٍلِقٍ شَنَنّلِ شَ يِرٍ عِتٍشِ مَ هَن تَا سٌدٍ دّ تُشُي يِرٍ.<verse eid="JER 31:38"/></para>
  <para style="q">
    <verse number="39" style="v" sid="JER 31:39"/>لُوتِ مَن عِتَلَمَ نّ عَ تِنشِنشِ رَ هَن فَرٍبٍ فٍيَ قَرِ،</para>
  <para style="q" vid="JER 31:39">هَن فٌوَ مَبِرِ رَ.<verse eid="JER 31:39"/></para>
  <para style="q">
    <verse number="40" style="v" sid="JER 31:40"/>فُلُنبَ، بِنبِ نُن تّ شُبٍ وْلّمَ دّننَشّ،</para>
  <para style="q" vid="JER 31:40">عَ نُن شّ نَشٍيٍ بَشِ سٍدِرٌن فُلُنبَ رَ،</para>
  <para style="q" vid="JER 31:40">هَن تَا سٌدٍ دّ نَشَن شِلِ قَلَمَ سٌي نَادّ،</para>
  <para style="q" vid="JER 31:40">نَشَن نَ تّتّ تُشُي قُفٍ رَ،</para>
  <para style="q" vid="JER 31:40">نَ يِرٍ بِرِن قِندِ مَ نّ عَلَتَلَ فبٍ رَ.</para>
  <para style="q" vid="JER 31:40">عَ مُ كَنَمَ سْنْن.»<verse eid="JER 31:40"/></para>
  <chapter eid="JER 31"/>
  <chapter number="32" style="c" sid="JER 32"/>
  <para style="s">عَننَبِ يٍرٍ مِ شّ سَرَقٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 32:1"/>عَلَتَلَ نَشَ مَسٍنيِ تِ عَننَبِ يٍرٍ مِ بّ يُدَيَ مَنفّ سٍدٍكِيَ شَ مَنفّيَ حّ قُ. نٍبُكَدَنسَرِ شَ مَنفّيَ نُ بَرَ حّ قُ نُن سٌلٌمَسَشَن لِ. <verse eid="JER 32:1"/><verse number="2" style="v" sid="JER 32:2"/>بَبِلْن مَنفّ شَ سْورِيٍ نُ بَرَ دَرِ سَلَمُ سُشُ. عَننَبِ يٍرٍ مِ نُ سَشِ فٍيلِ كُي يُدَيَ مَنفّ سٍدٍكِيَ شْنيِ <verse eid="JER 32:2"/><verse number="3" style="v" sid="JER 32:3"/>عَ شَ نَمِحْنمّ مَسٍنيِ شَ قٍ رَ. سٍدٍكِيَ نُ بَرَ عَ مَشْرِن، «مُنقٍ رَ عِ عَ مَسٍنمَ عَ عَلَتَلَ يِ تَا لُمَ نّ بَبِلْن مَنفّ سَفٌ؟ <verse eid="JER 32:3"/><verse number="4" style="v" sid="JER 32:4"/>عِ مَن عَ قَلَ عَ عَلَتَلَ نَشّ، ﭑ تَن يُدَيَ مَنفّ سٍدٍكِيَ مُ قَمَ قٌتِفٌلِدٍ كَلِدِكَيٍ يِ، ﭑ قَمَ لُدٍ بَبِلْن مَنفّ نَن سَفٌي، ﭑ شَ ﭑ دّنتّفّ عَ يَ شْرِ. <verse eid="JER 32:4"/><verse number="5" style="v" sid="JER 32:5"/>مُنقٍ رَ عِ عَ قَلَمَ عَ عَلَتَلَ عَ مَسٍنشِ، ‹بَبِلْن مَنفّ سٍدٍكِيَ شَنِنمَ نّ بَبِلْن بْشِ مَ. عَ لُمَ نّ نَا هَن ﭑ قَ تّمُي. شَ وٌ سٌ كَلِدِكَيٍ فٍرٍقٍ، نَ مُ قِندِ مَ وٌ بّ شُننَكٍلِ رَ.›»<verse eid="JER 32:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 32:6"/>عَننَبِ يٍرٍ مِ نَشَ عَ قَلَ، «عَلَتَلَ شَ مَسٍنيِ نَن يَ؛ <verse eid="JER 32:6"/><verse number="7" style="v" sid="JER 32:7"/>عِ سْشْ سَلُمُ شَ دِ شَنَمٍلِ قَمَ نّ عِ يِرٍ، عَ قَ عَ قَلَ عِ بّ، ‹ﭑ مَ شّ سَرَ نَشَن نَ عَنَتْتِ، بَرِ مَ عِ تَن نَن نْمَ عَ شُن سَرَدٍ كّ سّرِيّ كِ مَ.›»<verse eid="JER 32:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 32:8"/>ﭑ سْشْ شَ دِ شَنَمٍلِ نَشَ قَ ﭑ يِرٍ عَلْ عَلَتَلَ عَ مَسٍنشِ ﭑ بّ كِ نَشّ. عَ نَشَ ﭑ لِ فٍيلِ تّتّ كُي، عَ عَ قَلَ ﭑ بّ، «ﭑ مَ شّ سَرَ نَشَن نَ عَنَتْتِ، بُنيَمِن بْنسْي شَ بْشِ، بَرِ مَ عِ تَن نْمَ عَ شُن سَرَدٍ كّ سّرِيّ كِ مَ. عَ شُن سَرَ.» ﭑ نَشَ عَ كٌلٌن عَلَتَلَ شَ مَسٍنيِ كَمَلِشِ نَن نُ عَ رَ. <verse eid="JER 32:8"/><verse number="9" style="v" sid="JER 32:9"/>ﭑ نَشَ ﭑ سْشْ شَ دِ شَنَمٍلِ شَ شّ سَرَ، نَشَن نُ نَ عَنَتْتِ. ﭑ نَشَ فبٍتِ كِلٌ قِرِن مَنِيَ عَ بّ. <verse eid="JER 32:9"/><verse number="10" style="v" sid="JER 32:10"/>ﭑ نَشَ كّيدِ سّبّ، ﭑ نَن ﭑ مَ تْنشُمَ دْشْ عَ مَ، ﭑ قَ فبٍتِ مَنِيَ سِكٍيلِ رَ سٍيدٍ يَ شْرِ. <verse eid="JER 32:10"/><verse number="11" style="v" sid="JER 32:11"/>ﭑ نَشَ نَ كّيدِ مَتْنشُمَشِ تٌنفٌ، سّرِيّ سّبّشِ نَشَن كُي، عَ نُن كّيدِ فبّتّ نَشَن مَنِيَشِ نَ سِنفٍ رَ. <verse eid="JER 32:11"/><verse number="12" style="v" sid="JER 32:12"/>ﭑ نَشَ نَ كّيدِ سٌ بَرُكِ يِ رَ، نٍرِيَ شَ دِ، مَشَسٍيَ شَ مَمَدِ. ﭑ بَرَ نَ رَبَ ﭑ سْشْ شَ دِ شَنَمٍلِ نُن سٍيدٍ يَ شْرِ، نَشٍيٍ نُ بَرَ عٍ بّلّشّ قْشِ سَ كّيدِ مَ نَشَن شّ سَرَقٍ، نَ شَ قٍ سّبّشِ كّيدِ نَشَن مَ. يُوِقِ نَشٍيٍ نُ نَ فٍيلِ تّتّ كُي، عٍ بِرِن نَ تٌشِ.<verse eid="JER 32:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 32:13"/>ﭑ نَشَ عَ قَلَ بَرُكِ بّ، <verse eid="JER 32:13"/><verse number="14" style="v" sid="JER 32:14"/>«عِسِرَيِلَ مَرِفِ مَنفّ عَلَتَلَ شَ مَسٍنيِ نَن يَ؛ يِ كّيدِ قِرِن تٌنفٌ، شّ سَرَ قٍ سّبّشِ نَشٍيٍ كُي، تْنشُمَ دْشْشِ نَشَن مَ، عَ نُن بٌورٍ تْنشُمَتَرٍ، عِ شَ عٍ سَ قّحّ دِ كُي عَلَكٌ عٍ نَشَ كَنَ، عٍ شَ بُ.» <verse eid="JER 32:14"/><verse number="15" style="v" sid="JER 32:15"/>عِسِرَيِلَ مَرِفِ عَلَتَلَ نَشَ عَ مَسٍن، «وَشَتِ قَمَ قَدٍ، بَنشِيٍ، شّيٍ، نُن وّنِ سَنسِيٍ مَن مَتِمَ نّ يِ بْشِ مَ.»<verse eid="JER 32:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 32:16"/>ﭑ تٌ نَ شّ سَرَ كّيدِ سٌ نٍرِيَ شَ دِ بَرُكِ يِ رَ، ﭑ نَشَ عَلَتَلَ مَشَندِ يِ كِ،<verse eid="JER 32:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 32:17"/>«ﭑ مَرِفِ عَلَتَلَ،</para>
  <para style="q" vid="JER 32:17">نَشَن بَرَ كٌورٍ نُن بْشِ دَا عِ شَ سّنبّ مَفَاشُي رَ،</para>
  <para style="q" vid="JER 32:17">عِ تَن نْمَ قٍ بِرِن نَ.<verse eid="JER 32:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JER 32:18"/>عِ هِننّمَ مِشِيٍ رَ هَن عٍ بْنسْي وُلُ ندٍ،</para>
  <para style="q" vid="JER 32:18">كْنْ عِ مَن نْمَ دِيٍ حَشَنكَتَدٍ عٍ بَبَيٍ شَ يُنُبِيٍ مَ.</para>
  <para style="q" vid="JER 32:18">عِ تَن نَن عَلَ كَلَنكٍ رَ نَشَن سّنبّ فبٌ،</para>
  <para style="q" vid="JER 32:18">نَشَن شِلِ مَنفّ عَلَتَلَ.<verse eid="JER 32:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JER 32:19"/>عِ شَ لْننِ فبٌ، عِ قٍ رَبَمَ سّنبّ رَ.</para>
  <para style="q" vid="JER 32:19">عِ يَيٍ تِشِ عِبُنَدَ مَ دِيٍ رَ كِرَ بِرِن شْن،</para>
  <para style="q" vid="JER 32:19">عَلَكٌ عِ شَ عٍ بِرِن سَرٍ قِ عٍ شَ وَلِ رَ.<verse eid="JER 32:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 32:20"/>عِ بَرَ لَامَتُنيِيٍ رَ مِنِ،</para>
  <para style="q" vid="JER 32:20">عِ بَرَ كَابَنَكٌي رَبَ مِسِرَ بْشِ مَ هَن تٌ.</para>
  <para style="q" vid="JER 32:20">عِ مَن بَرَ نَ رَبَ عِسِرَيِلَ نُن دُنِحَ بِرِن مَ،</para>
  <para style="q" vid="JER 32:20">هَن عِ بَرَ شِلِ شُنفبٍ سْتْ يِ وَشَتِ.<verse eid="JER 32:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JER 32:21"/>عِ بَرَ عِ شَ حَمَ عِسِرَيِلَ رَ مِنِ مِسِرَ لَامَتُنيِيٍ نُن كَابَنَكٌييٍ رَ.</para>
  <para style="q" vid="JER 32:21">عِ سّنبّ مَفَاشُشِ بَرَ عٍ بِرِن نَسّرّن.<verse eid="JER 32:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JER 32:22"/>عِ بَرَ يِ بْشِ قِ عٍ مَ،</para>
  <para style="q" vid="JER 32:22">عِ عِ كَلِشِ نَشَن نَ عٍ بٍنبَيٍ بّ،</para>
  <para style="q" vid="JER 32:22">شِحّ نُن كُمِ فبٌشِ دّننَشّ.<verse eid="JER 32:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JER 32:23"/>عٍ تٌ قَ، عٍ بَرَ بْشِ سْتْ،</para>
  <para style="q" vid="JER 32:23">كْنْ عٍ مُ عِ شُي رَبَتُشِ،</para>
  <para style="q" vid="JER 32:23">عٍ مُ بِرَشِ عِ شَ سّرِيّ قْشْ رَ،</para>
  <para style="q" vid="JER 32:23">عٍ مُ عِ شَ يَامَرِيٍ سُشُشِ.</para>
  <para style="q" vid="JER 32:23">نَ نَن عَ نِيَشِ عِ بَرَ عٍ لُ يِ فبَلٌي كُي.<verse eid="JER 32:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JER 32:24"/>كَلِدِكَيٍ بَرَ بّندّ مَلَن عَلَكٌ عٍ شَ تٍ تّتّ قَرِ.</para>
  <para style="q" vid="JER 32:24">يِ تَا قَمَ نّ لُدٍ عٍ سَفٌي.</para>
  <para style="q" vid="JER 32:24">عَ قَمَ نّ كَنَدٍ سَنتِدّفّمَ، كَامّ، نُن قُرٍ حَاشِ رَ.</para>
  <para style="q" vid="JER 32:24">عِ نَشَن مَسٍنشِ عَ بَرَ كَمَلِ عِ يَ شْرِ.<verse eid="JER 32:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JER 32:25"/>هَلِ نَ بِرِن تٌ رَبَشِ،</para>
  <para style="q" vid="JER 32:25">عِ تَن مَرِفِ عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ،</para>
  <para style="q" vid="JER 32:25">ﭑ شَ شّ سَرَ فبٍتِ رَ سٍيدٍ يَ شْرِ.</para>
  <para style="q" vid="JER 32:25">ﭑ نَ بِرِن نَبَشِ كَلِدِكَيٍ فٍرٍ تّمُي نّ.»<verse eid="JER 32:25"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="26" style="v" sid="JER 32:26"/>عَلَتَلَ مَن نَشَ يِ مَسٍنيِ قِ عَننَبِ يٍرٍ مِ مَ؛<verse eid="JER 32:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="JER 32:27"/>«ﭑ تَن نَن دَالِسٍ بِرِن مَرِفِ عَلَتَلَ رَ.</para>
  <para style="q" vid="JER 32:27">قٍ ندٍ نَ نَ ﭑ مُ نْمَ نَشَن نَ؟<verse eid="JER 32:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="JER 32:28"/>نَ نَن عَ رَ عَلَتَلَ يِ مَسٍنيِ تِمَ؛</para>
  <para style="q" vid="JER 32:28">ﭑ قَمَ نّ يِ تَا سٌدٍ كَلِدِكَيٍ يِ رَ.</para>
  <para style="q" vid="JER 32:28">بَبِلْن مَنفّ نٍبُكَدَنسَرِ قَمَ نّ عَ سُشُدٍ.<verse eid="JER 32:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="JER 32:29"/>كَلِدِكَيٍ نَشٍيٍ سٌمَ يِ تَا كُي،</para>
  <para style="q" vid="JER 32:29">عٍ قَمَ نّ عَ بِرِن فَندٍ تّ رَ.</para>
  <para style="q" vid="JER 32:29">وٌ سُرَيِ فَنشِ سّرّشّ رَ بَلِ كُيٍ بّ دّننَشّ،</para>
  <para style="q" vid="JER 32:29">عٍ نَ كَنَمَ نّ.</para>
  <para style="q" vid="JER 32:29">وٌ مِنسٍ سّرّشّ بَشِ عَلَ فبّتّيٍ بّ دّننَشّ،</para>
  <para style="q" vid="JER 32:29">عٍ نَ قَن كَنَمَ نّ.</para>
  <para style="q" vid="JER 32:29">وٌ شَ كُيٍ بَتُي بَرَ ﭑ نَشْنْ.<verse eid="JER 32:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="JER 32:30"/>كَبِ عِسِرَيِلَكَيٍ نُن يُدَيَكَيٍ دِ مّدِ تّمُي،</para>
  <para style="q" vid="JER 32:30">عٍ بَرَ قٍ رَبَ نَشَن مُ رَقَن ﭑ مَ.</para>
  <para style="q" vid="JER 32:30">عٍ بَرَ ﭑ نَشْنْ عٍ شَ وَلِ كٌبِ رَ.»</para>
  <para style="q" vid="JER 32:30">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="JER 32:30"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="31" style="v" sid="JER 32:31"/>«كَبِ عٍ نَشَ يِ تَا تِ هَن تٌ،</para>
  <para style="q" vid="JER 32:31">عٍ قٍ رَبَمَ نَشَن ﭑ نَشْنْمَ.</para>
  <para style="q" vid="JER 32:31">نَ نَن نَ كِ ﭑ بَرَ ﭑ كٌبٍ رَ سٌ عٍ رَ،<verse eid="JER 32:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="JER 32:32"/>عِسِرَيِلَكَيٍ، يُدَيَكَيٍ، دَرِ سَلَمُكَيٍ،</para>
  <para style="q" vid="JER 32:32">عٍ شَ مَنفّيٍ، عٍ شَ كُنتِفِيٍ،</para>
  <para style="q" vid="JER 32:32">عٍ شَ سّرّشّدُبّيٍ، نُن عٍ شَ نَمِحْنمّيٍ،</para>
  <para style="q" vid="JER 32:32">عٍ بِرِن شَ كّوَلِ كٌبِيٍ شَ قٍ رَ.<verse eid="JER 32:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="JER 32:33"/>عٍ بَرَ عٍ كٌبٍ رَ سٌ ﭑ نَ.</para>
  <para style="q" vid="JER 32:33">ﭑ نُ بَرَ عٍ مَتِنكَن تّمُي بِرِن،</para>
  <para style="q" vid="JER 32:33">كْنْ عٍ مُ ﭑ مَ سّرِيّ سُشُ.<verse eid="JER 32:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="JER 32:34"/>عٍ بَرَ كُيٍيٍ دْشْ ﭑ مَ بَنشِ كُي،</para>
  <para style="q" vid="JER 32:34">ﭑ شِلِ قَلَمَ دّننَشّ.</para>
  <para style="q" vid="JER 32:34">عٍ بَرَ ﭑ مَ بَنشِ مَنْشْ نَ قٍ مْولِ رَ.<verse eid="JER 32:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="JER 32:35"/>عٍ بَرَ سَلِدٍيٍ تِ بَلِ كُيٍيٍ بّ بٍن هِنٌمَ فُلُنبَ كُي.</para>
  <para style="q" vid="JER 32:35">مّننِ عٍ بَرَ عٍ شَ دِيٍ بَ سّرّشّ رَ مْلْكْ بّ.</para>
  <para style="q" vid="JER 32:35">ﭑ مُ نَشَن قَلَ عٍ بّ،</para>
  <para style="q" vid="JER 32:35">نَشَن مُ نْمَ قِندِدٍ ﭑ مَ مَحْشُنيِ رَ،</para>
  <para style="q" vid="JER 32:35">عٍ بَرَ نَ قٍ شْنشِ مْولِ بِرِن نَبَ،</para>
  <para style="q" vid="JER 32:35">عَ قَ قِندِ يُنُبِ رَ يُدَيَ بّ.»<verse eid="JER 32:35"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="36" style="v" sid="JER 32:36"/>«وٌ عَ قَلَمَ عَ يِ تَا قَمَ لُدٍ بَبِلْن مَنفّ نَن سَفٌي،</para>
  <para style="q" vid="JER 32:36">سَنتِدّفّمَ، كَامّ، نُن قُرٍ حَاشِ سَابُي رَ.</para>
  <para style="q" vid="JER 32:36">كْنْ عِسِرَيِلَ مَرِفِ عَلَتَلَ شَ مَسٍنيِ نَن يَ؛<verse eid="JER 32:36"/></para>
  <para style="q">
    <verse number="37" style="v" sid="JER 32:37"/>‹ﭑ قَمَ نّ عِسِرَيِلَكَيٍ رَ مِنِدٍ حَمَنّيٍ مَ،</para>
  <para style="q" vid="JER 32:37">ﭑ عٍ رَيٍنسٍنشِ دّننَشّ ﭑ مَ شْنّ شُنفبٍ كُي.</para>
  <para style="q" vid="JER 32:37">ﭑ بْحّ نُ بَرَ تٍ عٍ مَ،</para>
  <para style="q" vid="JER 32:37">كْنْ ﭑ مَن قَمَ نّ عٍ رَ سٌدٍ يِ تَا كُي بْحّسَ رَ.<verse eid="JER 32:37"/></para>
  <para style="q">
    <verse number="38" style="v" sid="JER 32:38"/>عٍ مَن قِندِ مَ نّ ﭑ مَ حَمَ رَ،</para>
  <para style="q" vid="JER 32:38">ﭑ مَن قِندِ عٍ مَرِفِ عَلَ رَ.<verse eid="JER 32:38"/></para>
  <para style="q">
    <verse number="39" style="v" sid="JER 32:39"/>ﭑ قَمَ نّ عٍ لُدٍ شَشِلِ كٍرٍن نُن كِرَ كٍرٍن شْن،</para>
  <para style="q" vid="JER 32:39">عَلَكٌ عٍ شَ فَاشُ ﭑ يَ رَ،</para>
  <para style="q" vid="JER 32:39">عٍ تَن نُن عٍ بْنسْي شَ لُ هّيرِ كُي عَبَدَن.<verse eid="JER 32:39"/></para>
  <para style="q">
    <verse number="40" style="v" sid="JER 32:40"/>ﭑ قَمَ نّ سَاتّ تٌنفٌدٍ عٍ بّ نَشَن مُ كَنَمَ عَبَدَن.</para>
  <para style="q" vid="JER 32:40">ﭑ مُ فبِلٍنمَ عٍ قْشْ رَ.</para>
  <para style="q" vid="JER 32:40">ﭑ قٍ قَنيِ رَبَمَ نّ عٍ بّ.</para>
  <para style="q" vid="JER 32:40">ﭑ نَن ﭑ مَ يَرَفَاشُي لُمَ نّ عٍ بْحّ مَ،</para>
  <para style="q" vid="JER 32:40">عَلَكٌ عٍ نَشَ عٍ مَكُيَ ﭑ نَ.<verse eid="JER 32:40"/></para>
  <para style="q">
    <verse number="41" style="v" sid="JER 32:41"/>ﭑ سّيوَ مَ نّ قٍ قَنيِ رَبَقٍ رَ عٍ بّ.</para>
  <para style="q" vid="JER 32:41">ﭑ عٍ رَ سَبَتِمَ نّ يِ بْشِ كُي</para>
  <para style="q" vid="JER 32:41">ﭑ بْحّ نُن ﭑ نِي بِرِن نَ.›»<verse eid="JER 32:41"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="42" style="v" sid="JER 32:42"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 32:42">«ﭑ يِ قٍ قَنيِ بِرِن نَبَمَ نّ عٍ بّ،</para>
  <para style="q" vid="JER 32:42">عَلْ ﭑ حَشَنكَتّ رَبَشِ عٍ رَ كِ نَشّ.</para>
  <para style="q" vid="JER 32:42">نَ سٍسٍ مُ كَنَمَ.<verse eid="JER 32:42"/></para>
  <para style="q">
    <verse number="43" style="v" sid="JER 32:43"/>مِشِ مَن قَمَ نّ شّ سَرَدٍ يِ بْشِ مَ،</para>
  <para style="q" vid="JER 32:43">وٌ عَ قَلَمَ نَشَن نَ،</para>
  <para style="q" vid="JER 32:43">بٍ بَرَ قِندِ فبَلٌي يِرٍ رَ عَدَ مَ نُن سُبٍ بّ.</para>
  <para style="q" vid="JER 32:43">بِرِن بَرَ لُ كَلِدِكَيٍ سَفٌ.»<verse eid="JER 32:43"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="44" style="v" sid="JER 32:44"/>كْنْ عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 32:44">«وٌ مَن قَمَ نّ شّيٍ سَرَدٍ فبٍتِ رَ يِ بْشِ مَ.</para>
  <para style="q" vid="JER 32:44">شّ سَرَ كّيدِ مَن يَءِلَنمَ،</para>
  <para style="q" vid="JER 32:44">تْنشُمَ دْشْ عٍ مَ سٍيدٍ يَ شْرِ</para>
  <para style="q" vid="JER 32:44">بُنيَمِن بْنسْي شَ بْشِ مَ،</para>
  <para style="q" vid="JER 32:44">دَرِ سَلَمُ رَبِلِنيِ، يُدَيَ شَ تَايٍ كُي،</para>
  <para style="q" vid="JER 32:44">فٍيَ تَايٍ كُي، سٍقٍلَ بْشِ كُي، نُن نٍفٍوِ فبٍنفبٍرٍن يِرٍ.</para>
  <para style="q" vid="JER 32:44">ﭑ عٍ شَ مِشِ رَفبِلٍنمَ نّ كٍلِقٍ كٌنيِيَ كُي.»<verse eid="JER 32:44"/></para>
  <chapter eid="JER 32"/>
  <chapter number="33" style="c" sid="JER 33"/>
  <para style="s">دَرِ سَلَمُ شَ كِسِ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 33:1"/>عَلَتَلَ مَن نَشَ مَسٍنيِ ندٍ تِ عَننَبِ يٍرٍ مِ بّ فٍيلِ تّتّ كُي؛<verse eid="JER 33:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JER 33:2"/>«عَلَتَلَ شَ مَسٍنيِ نَن يَ،</para>
  <para style="q" vid="JER 33:2">نَشَن قٍ بِرِن نَبَمَ،</para>
  <para style="q" vid="JER 33:2">نَشَن قٍ بِرِن نَفِرِ مَ،</para>
  <para style="q" vid="JER 33:2">نَشَن شِلِ عَلَتَلَ.<verse eid="JER 33:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JER 33:3"/>ﭑ مَشَندِ عَلَكٌ ﭑ شَ عِ يَابِ.</para>
  <para style="q" vid="JER 33:3">ﭑ قٍ شُنفبٍيٍ مَسٍنمَ نّ عِ بّ،</para>
  <para style="q" vid="JER 33:3">قٍ نْشُنشِيٍ عِ مُ نَشٍيٍ كٌلٌن.<verse eid="JER 33:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JER 33:4"/>عِسِرَيِلَ مَرِفِ عَلَتَلَ بَرَ عَ مَسٍن يِ تَا بَنشِيٍ شَ قٍ رَ،</para>
  <para style="q" vid="JER 33:4">عَ نُن يُدَيَ مَنفّ شَ بَنشِيٍ شَ قٍ رَ،</para>
  <para style="q" vid="JER 33:4">عٍ بِرِن قَمَ نّ بِرَدٍ عَلَكٌ مِشِيٍ شَ عٍ يّتّ رَتَنفَ يَشُييٍ مَ،</para>
  <para style="q" vid="JER 33:4">نَشٍيٍ تٍمَ تَا تّتّ قَرِ سَنتِدّفّمَ رَ.<verse eid="JER 33:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JER 33:5"/>فٍرٍ نَ مِنِ كَلِدِكَيٍ شْنيِ،</para>
  <para style="q" vid="JER 33:5">نَ بَنشِيٍ قَمَ نّ رَقٍدٍ بِنبِيٍ رَ،</para>
  <para style="q" vid="JER 33:5">عَلَتَلَ نَشٍيٍ قَشَمَ عَ شَ شْنّ كُي.</para>
  <para style="q" vid="JER 33:5">ﭑ نَ ﭑ يَ نْشُنمَ نّ يِ تَا مَ عٍ شَ وَلِ كٌبِ شَ قٍ رَ.<verse eid="JER 33:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JER 33:6"/>كْنْ ﭑ قَمَ نّ يَلَنيِ قِدٍ عَ مَ،</para>
  <para style="q" vid="JER 33:6">عَلَكٌ عٍ شَ لُ بْحّسَ نُن هّيرِ كُي.<verse eid="JER 33:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JER 33:7"/>ﭑ يُدَيَكَيٍ نُن عِسِرَيِلَكَيٍ رَ مِنِمَ نّ كٌنيِيَ كُي،</para>
  <para style="q" vid="JER 33:7">عٍ مَن شَ سَبَتِ بٍ عَلْ سِنفٍ.<verse eid="JER 33:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 33:8"/>ﭑ عٍ رَ سّنِيّنمَ نّ عٍ شَ كّوَلِ كٌبِ بِرِن مَ،</para>
  <para style="q" vid="JER 33:8">عٍ نَشَن نَبَشِ ﭑ نَ.</para>
  <para style="q" vid="JER 33:8">ﭑ عٍ شَ يُنُبِيٍ شَقَرِ مَ نّ،</para>
  <para style="q" vid="JER 33:8">عٍ نَشَن نَبَشِ ﭑ نَ عٍ شَ مَتَندِ كُي.<verse eid="JER 33:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JER 33:9"/>ﭑ سّيوَ مَ نّ يِ تَا شَ قٍ رَ.</para>
  <para style="q" vid="JER 33:9">سِ بِرِن قَمَ نّ ﭑ مَتْشْدٍ، عٍ ﭑ بِنيَ هّيرِ شَ قٍ رَ،</para>
  <para style="q" vid="JER 33:9">ﭑ قَمَ نَشَن نَبَدٍ عِسِرَيِلَكَيٍ بّ.</para>
  <para style="q" vid="JER 33:9">دُنِحَ نَ عَ تٌ ﭑ نَشَن نَبَمَ بٍكَيٍ بّ،</para>
  <para style="q" vid="JER 33:9">عٍ دّ عِشَرَ مَ نّ، عٍ كَابَ.»<verse eid="JER 33:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="JER 33:10"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 33:10">«وٌ عَ قَلَمَ عَ بٍ بَرَ قِندِ فبَلٌي يِرٍ رَ،</para>
  <para style="q" vid="JER 33:10">عَدَ مَدِ مُ نَ، سُبٍ مُ نَ.</para>
  <para style="q" vid="JER 33:10">كْنْ مِشِ شُي مَن قَمَ نّ رَ مّدٍ يُدَيَ تَايٍ كُي،</para>
  <para style="q" vid="JER 33:10">عَ نُن دَرِ سَلَمُ شَ كِرَيٍ شْن مَ.<verse eid="JER 33:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JER 33:11"/>حّلّشِن سِفِ سَمَ نّ،</para>
  <para style="q" vid="JER 33:11">فِنّ دْشْي شُلُنيِ رَبَ،</para>
  <para style="q" vid="JER 33:11">تَنتُي قَن رَ سِفَ مَنفّ عَلَتَلَ مَ،</para>
  <para style="q" vid="JER 33:11">بَرِ مَ عَلَتَلَ قَن، عَ شَ هِننّ مُ كَنَمَ عَبَدَن.</para>
  <para style="q" vid="JER 33:11">مِشِ بّيتِ بَمَ نّ نَشٍيٍ تَنتُي سّرّشّيٍ شَنِنمَ عَلَتَلَ شَ هْرْ مْبَنشِ كُي.</para>
  <para style="q" vid="JER 33:11">ﭑ عِسِرَيِلَكَيٍ رَ مِنِمَ نّ كٌنيِيَ كُي،</para>
  <para style="q" vid="JER 33:11">عٍ شَ سَبَتِ بٍ عَلْ سِنفٍ.</para>
  <para style="q" vid="JER 33:11">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.»<verse eid="JER 33:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="JER 33:12"/>مَنفّ عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 33:12">«يَكْسِ عَدَ مَدِ نُن سُبٍ يٌ مُ نَ يِ تَا كَنَشِ كُي،</para>
  <para style="q" vid="JER 33:12">كْنْ ﭑ مَن قَمَ نّ عَ نِيَدٍ فْورّ شَ وُيَ بٍ،</para>
  <para style="q" vid="JER 33:12">شُرُ سٍ مَكَنتَمَيٍ شَ لُ عٍ قّ مَ.<verse eid="JER 33:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JER 33:13"/>تَا نَشٍيٍ نَ فٍيَيٍ قَرِ،</para>
  <para style="q" vid="JER 33:13">نَشٍيٍ نَ سٍقٍلَ بْشِ مَ نُن نٍفٍوِ فبٍنفبٍرٍنيِ مَ،</para>
  <para style="q" vid="JER 33:13">نَشٍيٍ نَ بُنيَمِن بْنسْي شَ بْشِ مَ نُن دَرِ سَلَمُ رَبِلِنيِ،</para>
  <para style="q" vid="JER 33:13">نَشٍيٍ نَ يُدَيَ بْشِ مَ،</para>
  <para style="q" vid="JER 33:13">شُرُ سٍيٍ مَن شَ لُ عٍ بِرِن يِ رَ عٍ كَنتَمَيٍ قّ مَ.</para>
  <para style="q" vid="JER 33:13">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.»<verse eid="JER 33:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="JER 33:14"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 33:14">«وَشَتِ قَمَ نّ عَ لِدٍ ﭑ مَ مَسٍنيِ قَنيِ كَمَلِمَ تّمُي نَشّ،</para>
  <para style="q" vid="JER 33:14">ﭑ نَشَن تٌنفٌ عِسِرَيِلَ نُن يُدَيَ بْنسْي بّ.<verse eid="JER 33:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 33:15"/>نَ لْشْي ﭑ دَوُدَ شَ دِ ندٍ رَ مِنِمَ نّ،</para>
  <para style="q" vid="JER 33:15">نَشَن تِنشِنيِ نُن سّرِيّ وَلِ رَبَمَ يِ بْشِ كُي.<verse eid="JER 33:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 33:16"/>نَ لْشْي يُدَيَ كِسِمَ نّ،</para>
  <para style="q" vid="JER 33:16">دَرِ سَلَمُ قَ لُ بْحّسَ كُي.</para>
  <para style="q" vid="JER 33:16">نَ دِ شِلِ قَلَمَ نّ؛ عَلَتَلَ نَن وٌن مَ تِنشِنيِ رَ.»<verse eid="JER 33:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="JER 33:17"/>عَلَتَلَ بَرَ عَ مَسٍن،</para>
  <para style="q" vid="JER 33:17">«دَوُدَ شَ دِ ندٍ لُمَ نّ عِسِرَيِلَ شَ كِبَنيِ كُي تّمُي بِرِن.<verse eid="JER 33:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JER 33:18"/>ﭑ يَ مُ بَمَ لٍوِكَ سّرّشّدُبّيٍ رَ،</para>
  <para style="q" vid="JER 33:18">عَلَكٌ عٍ شَ سّرّشّ فَن دَاشِيٍ بَ،</para>
  <para style="q" vid="JER 33:18">عٍ شَ سُرَيِ فَن سّرّشّ رَ،</para>
  <para style="q" vid="JER 33:18">عٍ شَ سّرّشّ ندٍ قَن بَ لْشْ يٌ لْشْ.»<verse eid="JER 33:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="JER 33:19"/>عَلَتَلَ بَرَ يِ مَسٍنيِ تِ عَننَبِ يٍرٍ مِ بّ؛<verse eid="JER 33:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 33:20"/>«عَلَتَلَ بَرَ عَ مَسٍن،</para>
  <para style="q" vid="JER 33:20">لْشْ يٌ لْشْ ﭑ يَنيِ نُن كْي رَ مِنِمَ.</para>
  <para style="q" vid="JER 33:20">شَ عَ سَ لِ نُ، نَ يَنيِ نُن كْي رَ مِنِقٍ كَنَمَ،<verse eid="JER 33:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JER 33:21"/>نَ تّمُي ﭑ مَ سَاتّ ﭑ نَشَن تٌنفٌ ﭑ مَ كٌنيِ دَوُدَ بّ،</para>
  <para style="q" vid="JER 33:21">نَ قَن كَنَمَ نّ،</para>
  <para style="q" vid="JER 33:21">عَ لِمَ دَوُدَ شَ دِ ندٍ مُ لُمَ عَ شَ كِبَنيِ كُي،</para>
  <para style="q" vid="JER 33:21">لٍوِكَ سّرّشّدُبّيٍ قَن مُ لُمَ ﭑ مَ وَلِ رَبَ رَ.<verse eid="JER 33:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JER 33:22"/>ﭑ عَ رَفِرِ مَ نّ ﭑ مَ كٌنيِ دَوُدَ شَ دِيٍ نُن لٍوِكَ سّرّشّدُبّيٍ مَ،</para>
  <para style="q" vid="JER 33:22">عٍ وُيَ عَلْ تُنبُي نَشٍيٍ نَ كٌورٍ مَ،</para>
  <para style="q" vid="JER 33:22">عَلْ مّيّنيِ نَشَن نَ بَا دّ رَ.»<verse eid="JER 33:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="JER 33:23"/>عَلَتَلَ بَرَ يِ مَسٍنيِ تِ عَننَبِ يٍرٍ مِ بّ؛<verse eid="JER 33:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JER 33:24"/>«عِ مُ عَ مّشِ مِشِيٍ نَشَن قَلَمَ؟</para>
  <para style="q" vid="JER 33:24">عٍ نَشّ عَ عَلَتَلَ بَرَ عَ شَ حَمَ سُفَندِشِ قِرِنيِ رَبّحِن.</para>
  <para style="q" vid="JER 33:24">عٍ بَرَ يٌ ﭑ مَ حَمَ مَ نَ وْيّنيِ رَ،</para>
  <para style="q" vid="JER 33:24">عٍ مَحْشُنشِ نّ عَ ﭑ مَ حَمَ مُ قِندِشِ سِ رَ سْنْن.»<verse eid="JER 33:24"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="25" style="v" sid="JER 33:25"/>عَلَتَلَ بَرَ عَ مَسٍن،</para>
  <para style="q" vid="JER 33:25">«عَلْ ﭑ سَاتّ تٌنفٌشِ يَنيِ نُن كْي رَ مِنِقٍ رَ كِ نَشّ،</para>
  <para style="q" vid="JER 33:25">عَلْ ﭑ سَاتّ تٌنفٌشِ كٌورٍ نُن بْشِ رَحّرّقٍ رَ كِ نَشّ،<verse eid="JER 33:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JER 33:26"/>ﭑ مَن سَاتّ تٌنفٌشِ نَ كِ نّ مّينِقٍ رَ يَشُبَ بْنسْي مَ.</para>
  <para style="q" vid="JER 33:26">نَ مُ كَنَمَ قٍوٌ.</para>
  <para style="q" vid="JER 33:26">ﭑ مَ كٌنيِ دَوُدَ شَ دِ ندٍ لُمَ نّ عِبُرَهِمَ، عِسِيَفَ، نُن يَشُبَ بْنسْي شُن نَ عَبَدَن.</para>
  <para style="q" vid="JER 33:26">ﭑ عٍ رَ مِنِمَ نّ كٌنيِيَ كُي،</para>
  <para style="q" vid="JER 33:26">ﭑ كِنِكِنِمَ نّ عٍ مَ.»<verse eid="JER 33:26"/></para>
  <chapter eid="JER 33"/>
  <chapter number="34" style="c" sid="JER 34"/>
  <para style="s">دَرِ سَلَمُكَيٍ شَ كّوَلِ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 34:1"/>بَبِلْن مَنفّ نٍبُكَدَنسَرِ، عَ شَ سْورِيٍ نُن حَمَنّ بِرِن نَشٍيٍ نُ نَ عَ شَ يَامَرِ بُن مَ، عٍ تٌ فٍرٍ سٌ دَرِ سَلَمُ نُن عَ رَبِلِنيِ، عَلَتَلَ نَشَ يِ مَسٍنيِ تِ عَننَبِ يٍرٍ مِ بّ، <verse eid="JER 34:1"/><verse number="2" style="v" sid="JER 34:2"/>«عِسِرَيِلَ مَرِفِ عَلَتَلَ بَرَ عَ مَسٍن عِ بّ عِ شَ سِفَ سٍدٍكِيَ يِرٍ. عِ شَ عَ قَلَ عَ بّ، ‹يُدَيَ مَنفّ عَلَتَلَ شَ مَسٍنيِ نَن يَ؛ ﭑ يِ تَا سَمَ نّ بَبِلْن مَنفّ سَفٌي، عَ قَ عَ فَن تّ رَ. <verse eid="JER 34:2"/><verse number="3" style="v" sid="JER 34:3"/>عِ تَن مُ عِ بَمَ عَ يِ رَ. مِشِ عِ سُشُمَ نّ عَ حَاشِ رَ، عٍ عِ تِ بَبِلْن مَنفّ يَ عِ، وٌ قَ دّ مَسَرَ. نَ دَنفِ شَنبِ عَ عِ شَنِنمَ نّ بَبِلْن بْشِ مَ. <verse eid="JER 34:3"/><verse number="4" style="v" sid="JER 34:4"/>كْنْ يُدَيَ مَنفّ سٍدٍكِيَ، عِ تُلِ مَتِ عَلَتَلَ شَ مَسٍنيِ رَ. عَلَتَلَ بَرَ عَ مَسٍن عِ مُ قَشَمَ سَنتِدّفّمَ رَ. <verse eid="JER 34:4"/><verse number="5" style="v" sid="JER 34:5"/>عِ قَشَمَ بْحّسَ نَن كُي. عِ رَفَتَمَ نّ عَلْ عِ بٍنبَيٍ مَنفّيٍ نَشٍيٍ سِنفٍ قَشَ. سُرَيِ فَنمَ نّ عِ بّ، عٍ عِ حْنقٍ بِنيَ. ﭑ مَ مَسٍنيِ نَن نَ كِ.›»<verse eid="JER 34:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 34:6"/>عَننَبِ يٍرٍ مِ يِ مَسٍنيِ نَن تِ يُدَيَ مَنفّ سٍدٍكِيَ بّ دَرِ سَلَمُ. <verse eid="JER 34:6"/><verse number="7" style="v" sid="JER 34:7"/>بَبِلْن سْورِ فَلِ نُ نَ دَرِ سَلَمُ فٍرٍقٍ، نُن يُدَيَ تَا فبّتّيٍ، عَلْ لَكِسِ نُن عَسٍكَ نَشٍيٍ نُ قِندِشِ تَا سّنبّمَيٍ رَ يُدَيَ بْشِ مَ.<verse eid="JER 34:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 34:8"/>مَنفّ سٍدٍكِيَ تٌ سَاتّ تٌنفٌ دَرِ سَلَمُكَيٍ بّ عٍ شَ شْرّيَ قِ عٍ شَ كٌنيِيٍ مَ، عَلَتَلَ نَشَ يِ مَسٍنيِ تِ عَننَبِ يٍرٍ مِ بّ. <verse eid="JER 34:8"/><verse number="9" style="v" sid="JER 34:9"/>سٍدٍكِيَ نُ بَرَ عٍ يَمَرِ عٍ شَ عٍ شَ كٌنيِيٍ عٍبُرُ شْرّيَ، عَلَكٌ عٍبُرُ يٌ نَشَ لُ كٌنيِيَ كُي. <verse eid="JER 34:9"/><verse number="10" style="v" sid="JER 34:10"/>كُنتِفِ نُن حَمَ بِرِن نَشٍيٍ نُ بَرَ لَن نَ مَ، عٍ نَشَ يَامَرِ رَبَتُ، عٍ نَشَ عٍ شَ كٌنيِيٍ شْرّيَ. <verse eid="JER 34:10"/><verse number="11" style="v" sid="JER 34:11"/>كْنْ عَ دْنشْي رَ، عٍ نَشَ فبِلٍن نَ نَتّ مَ، عٍ مَن نَشَ عٍ شَ كٌنيِيٍ رَ سُشُ، عٍ نُ بَرَ نَشٍيٍ شْرّيَ.<verse eid="JER 34:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 34:12"/>نَ تّمُي عَلَتَلَ نَشَ يِ مَسٍنيِ تِ عَننَبِ يٍرٍ مِ بّ، <verse eid="JER 34:12"/><verse number="13" style="v" sid="JER 34:13"/>«عِسِرَيِلَ مَرِفِ عَلَتَلَ بَرَ عَ مَسٍن، ‹ﭑ نَشَ سَاتّ تٌنفٌ وٌ بَبَيٍ بّ ﭑ عٍ رَ مِنِ كٌنيِيَ كُي تّمُي نَشّ مِسِرَ بْشِ مَ. ﭑ نُ بَرَ عَ مَسٍن عٍ بّ، <verse eid="JER 34:13"/><verse number="14" style="v" sid="JER 34:14"/>حّ سٌلٌقٍرٍ يٌ حّ سٌلٌقٍرٍ وٌ شَ وٌ نفَشَكٍرٍنيِ عٍبُرُ شْرّيَ نَشَن نُ بَرَ عَ يّتّ قِندِ كٌنيِ رَ وٌ بّ. عَ نْمَ وَلِدٍ عِ بّ حّ سٍننِ بُن مَ، كْنْ عَ سٌلٌقٍرٍ ندٍ وٌ شَ عَ رَفبِلٍن عَ شْنيِ. كْنْ وٌ بَبَيٍ مُ ﭑ شُي سُشُ، عٍ مُ عٍ تُلِ مَتِ ﭑ نَ. <verse eid="JER 34:14"/><verse number="15" style="v" sid="JER 34:15"/>تٌ وٌ تَن بَرَ ﭑ مَ يَامَرِ رَبَتُ عَ سّرِيّ كِ مَ، وٌ بَرَ وٌ شَ كٌنيِيٍ شْرّيَ. نَ كُي وٌ بَرَ سَاتّ تٌنفٌ ﭑ بّ ﭑ مَ بَنشِ كُي ﭑ شِلِ مَتْشْمَ دّننَشّ. <verse eid="JER 34:15"/><verse number="16" style="v" sid="JER 34:16"/>كْنْ وٌ مَن بَرَ فبِلٍن نَ نَتّ قْشْ رَ، وٌ قَ وٌ شَ كٌنيِيٍ مَكَنكَن عَلَكٌ عٍ مَن شَ لُ وٌ شَ يَامَرِ بُن مَ. نَ كُي وٌ بَرَ يٌ ﭑ شِلِ مَ.›»<verse eid="JER 34:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 34:17"/>نَ نَن عَ رَ عَلَتَلَ بَرَ عَ مَسٍن وٌ بّ، «وٌ مُ ﭑ شُي رَبَتُ شْرّيَ قِقٍ رَ وٌ شَ كٌنيِيٍ مَ. عَلَتَلَ شَ مَسٍنيِ نَن يَ؛ ﭑ قَن بَرَ نَتّ تٌنفٌ وٌ شَ لُ سَنتِدّفّمَ، قُرٍ حَاشِ، نُن كَامّ سَفٌي عَلَكٌ سِ بِرِن نَشٍيٍ نَ دُنِحَ شَ وٌ شَ حَشَنكَتّ تٌ. <verse eid="JER 34:17"/><verse number="18" style="v" sid="JER 34:18"/>مِشِ نَشٍيٍ بَرَ ﭑ مَ سَاتّ كَنَ، عٍ مُ عَ رَبَشِ عَ سّرِيّ كِ مَ، ﭑ عٍ لُمَ نّ عَلْ نَ نِنفٍ عٍ نَشَن عِشَبَ عَ تَفِ، عٍ قَ دَنفِ عَ شُنتُنيِ قِرِنيِ تَفِ. <verse eid="JER 34:18"/><verse number="19" style="v" sid="JER 34:19"/>يُدَيَ كُنتِفِيٍ، دَرِ سَلَمُ كُنتِفِيٍ، مَنفّ شَ مِشِيٍ، سّرّشّدُبّيٍ، نُن حَمَ بِرِن نَشٍيٍ بَرَ دَنفِ نِنفٍ شُنتُنيِيٍ تَفِ سَاتّ شِرِقٍ رَ، <verse eid="JER 34:19"/><verse number="20" style="v" sid="JER 34:20"/>ﭑ عٍ سَمَ نّ عٍ يَشُييٍ سَفٌ نَشٍيٍ وَ مَ عٍ قَشَقٍ، عٍ بِنبِيٍ قَ قِندِ شْنِيٍ نُن سُبٍيٍ شَ دٌنسٍ رَ. <verse eid="JER 34:20"/><verse number="21" style="v" sid="JER 34:21"/>ﭑ يُدَيَ مَنفّ سٍدٍكِيَ نُن عَ شَ كُنتِفِيٍ سَمَ نّ عٍ يَشُييٍ سَفٌ، نَشٍيٍ وَ مَ عٍ قَشَقٍ. ﭑ عٍ لُمَ نّ بَبِلْن مَنفّ شَ سْورِيٍ يِ رَ، نَشٍيٍ حَن بَرَ كٍلِ وٌ شُن مَ. <verse eid="JER 34:21"/><verse number="22" style="v" sid="JER 34:22"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛ ﭑ يَامَرِ قِمَ نّ عَلَكٌ عٍ مَن شَ قَ يِ تَا شِلِ مَ، عٍ شَ عَ فٍرٍ، عٍ عَ سُشُ، عٍ عَ فَن تّ رَ. ﭑ يُدَيَ شَ تَايٍ قِندِ مَ نّ فبَلٌي يِرٍ رَ، مِشِ يٌ مُ لُ نَا.»<verse eid="JER 34:22"/></para>
  <chapter eid="JER 34"/>
  <chapter number="35" style="c" sid="JER 35"/>
  <para style="s">رٍكَبُ بْنسْي</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 35:1"/>عَلَتَلَ نَشَ يِ مَسٍنيِ تِ عَننَبِ يٍرٍ مِ بّ يٌسِيَ شَ دِ يٍهٌيَكِمِ، يُدَيَ مَنفّ شَ وَشَتِ. <verse eid="JER 35:1"/><verse number="2" style="v" sid="JER 35:2"/>«عِ شَ سِفَ رٍكَبُ بْنسْي شِلِدٍ، عٍ شَ قَ عَلَتَلَ شَ هْرْ مْبَنشِ. عٍ نَ مّننِ لِ، عِ شَ عٍ رَ سٌ كٌنكٌي ندٍ كُي، عِ شَ وّنِ سٌ عٍ يِ رَ.»<verse eid="JER 35:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 35:3"/>ﭑ نَشَ سِفَ يٍرٍ مِ شَ دِ يَاسَنِيَ تٌنفٌدٍ، شَبَسِنِيَ شَ مَمَدِ، عَ نُن عَ شُنيَ شّمّمَيٍ نُن عَ شَ دِ شّمّمَيٍ. نٍيٍ قِندِشِ رٍكَبُ بْنسْي نَن نَ. <verse eid="JER 35:3"/><verse number="4" style="v" sid="JER 35:4"/>ﭑ نَشَ عٍ شَنِن عَلَتَلَ شَ بَنشِ، يِفِدَلِيَ شَ دِ هَنَن شَ كٌنكٌي كُي. هَنَن قِندِشِ عَلَ شَ كٌنيِ نَن نَ. عَ شَ كٌنكٌي نُ نَ كُنتِفِيٍ شَ كٌنكٌي نَن سّيتِ مَ. نَ كٌنكٌي نُ دْشْشِ سَلَمُ شَ دِ مَاسٍيَ شَ كٌنكٌي نَن قَرِ، نَشَن قِندِشِ نَادّ كَنتَمَ رَ. <verse eid="JER 35:4"/><verse number="5" style="v" sid="JER 35:5"/>ﭑ نَشَ وّنِ سٌ رٍكَبُ بْنسْي شَ مِشِيٍ يِ رَ، ﭑ قَ عَ قَلَ عٍ بّ عٍ شَ عَ مِن.<verse eid="JER 35:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 35:6"/>كْنْ عٍ نَشَ ﭑ يَابِ، «مُشُ تَن مُ وّنِ مِنمَ، بَرِ مَ مُشُ بَبَ يٌنَدَبٌ، مُشُ بٍنبَ رٍكَبُ شَ دِ، عَ بَرَ مُشُ يَمَرِ، ‹وٌ نَشَ وّنِ مِن، وٌ تَن نُن وٌ شَ دِيٍ. <verse eid="JER 35:6"/><verse number="7" style="v" sid="JER 35:7"/>وٌ نَشَ بَنشِ تِ، وٌ نَشَ سَنسِ سِ، وٌ نَشَ وّنِ بِلِ سِ. نَ سٍسٍ نَشَ لُ وٌ يِ رَ. عَ لَنمَ وٌ شَ لُ كِرِ بَنشِيٍ نَن كُي وٌ شَ دُنِحّءِفِرِ بِرِن كُي، عَلَكٌ وٌ شَ بُ يِ بْشِ مَ وٌ قَشِ دّننَشّ.› <verse eid="JER 35:7"/><verse number="8" style="v" sid="JER 35:8"/>مُشُ بَرَ بِرَ رٍكَبُ شَ دِ يٌنَدَبٌ شُي بِرِن قْشْ رَ، نَشَن قِندِشِ مُشُ بَبَ رَ. مُشُ تَن مُ وّنِ مِنمَ مُشُ شَ دُنِحّءِفِرِ كُي، مُشُ نُن مُشُ شَ فِنّيٍ نُن مُشُ شَ دِيٍ. <verse eid="JER 35:8"/><verse number="9" style="v" sid="JER 35:9"/>بَنشِ يٌ، وّنِ بِلِ يٌ، شّ يٌ، دَاشَيٍ يٌ، نَ سٍسٍ مُ نَ مُشُ يِ رَ. <verse eid="JER 35:9"/><verse number="10" style="v" sid="JER 35:10"/>مُشُ تَن لُمَ كِرِ بَنشِيٍ نَن بُن مَ، عَلْ مُشُ بَبَ يٌنَدَبٌ مُشُ يَمَرِشِ كِ نَشّ. <verse eid="JER 35:10"/><verse number="11" style="v" sid="JER 35:11"/>بَبِلْن مَنفّ نٍبُكَدَنسَرِ تٌ فٍرٍ سٌ عِسِرَيِلَ، مُشُ نَشَ عَ قَلَ، ‹وٌن شّي دَرِ سَلَمُ، وٌن شَ وٌن مَكُيَ كَلِدِكَيٍ نُن سِرِيَكَيٍ شَ سْورِيٍ رَ.› نَ نَن عَ رَ مُشُ نَشَ قَ سَبَتِ دَرِ سَلَمُ.»<verse eid="JER 35:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 35:12"/>نَ تّمُي عَلَتَلَ نَشَ يِ مَسٍنيِ تِ عَننَبِ يٍرٍ مِ بّ، <verse eid="JER 35:12"/><verse number="13" style="v" sid="JER 35:13"/>«عِسِرَيِلَ مَرِفِ عَلَتَلَ نَشَ عَ مَسٍن، سِفَ، عَ قَلَ يُدَيَكَيٍ نُن دَرِ سَلَمُكَيٍ بّ، ‹وٌ مُ قَهَامُي سْتْ يِ مَسٍنيِ كُي؟ وٌ مُ ﭑ مَ سّرِيّ رَبَتُمَ؟ عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ. <verse eid="JER 35:13"/><verse number="14" style="v" sid="JER 35:14"/>رٍكَبُ شَ دِ يٌنَدَبٌ تٌ عَ شَ دِيٍ يَمَرِ عٍ نَشَ وّنِ مِن، عٍ مُ عَ مِنشِ هَن تٌ، عٍ بَرَ عٍ بَبَ شَ يَامَرِ رَبَتُ. ﭑ تَن بَرَ وْيّن وٌ بّ سَنيَ وُيَشِ، كْنْ وٌ مُ ﭑ شُي سُشُ. <verse eid="JER 35:14"/><verse number="15" style="v" sid="JER 35:15"/>ﭑ بَرَ ﭑ مَ كٌنيِ نَمِحْنمّيٍ شّي وٌ يِرٍ سَنيَ وُيَشِ عَ قَلَقٍ رَ وٌ بّ، وٌ شَ فبِلٍن وٌ شَ كِرَ حَاشِ قْشْ رَ، وٌ شَ تُوبِ، وٌ نَشَ عَلَ فبّتّيٍ بَتُ، عَلَكٌ وٌ شَ نْ لُدٍ يِ بْشِ كُي ﭑ نَشَن قِشِ وٌ مَ نُن وٌ بَبَيٍ مَ. كْنْ وٌ مُ وٌ تُلِ مَتِشِ ﭑ نَ، وٌ مُ ﭑ شُي رَبَتُشِ. <verse eid="JER 35:15"/><verse number="16" style="v" sid="JER 35:16"/>رٍكَبُ شَ دِ يٌنَدَبٌ شَ دِيٍ بِرَشِ عٍ بَبَ شَ سّرِيّ نَن قْشْ رَ، كْنْ يِ حَمَ بَرَ ﭑ تَن مَتَندِ. <verse eid="JER 35:16"/><verse number="17" style="v" sid="JER 35:17"/>نَ نَن عَ رَ عِسِرَيِلَ مَرِفِ عَلَتَلَ بَرَ عَ مَسٍن، ﭑ قَمَ نّ فبَلٌي رَ يُدَيَ نُن دَرِ سَلَمُكَ بِرِن مَ عَلْ ﭑ عَ مَسٍنشِ كِ نَشّ، بَرِ مَ ﭑ نُ بَرَ وْيّن، كْنْ عٍ مُ ﭑ شُي سُشُ، ﭑ نُ بَرَ عٍ شِلِ، كْنْ عٍ مُ ﭑ مَ شِلِ رَتِن.›»<verse eid="JER 35:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JER 35:18"/>عَننَبِ يٍرٍ مِ نَشَ عَ مَسٍن رٍكَبُ بْنسْي بّ، «عِسِرَيِلَ مَرِفِ عَلَتَلَ شَ مَسٍنيِ نَن يَ؛ وٌ تٌ وٌ بَبَ يٌنَدَبٌ شَ يَامَرِ سُشُ، وٌ تٌ بِرَ عَ شَ سّرِيّ بِرِن قْشْ رَ، <verse eid="JER 35:18"/><verse number="19" style="v" sid="JER 35:19"/>رٍكَبُ شَ دِ يٌنَدَبٌ شَ دِيٍ مُ فَنمَ عَ رَ عَبَدَن. عِسِرَيِلَ مَرِفِ عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.»<verse eid="JER 35:19"/></para>
  <chapter eid="JER 35"/>
  <chapter number="36" style="c" sid="JER 36"/>
  <para style="s">مَنفّ يٍهٌيَكِمِ شَ كِتَابُي فَنيِ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 36:1"/>يٌسِيَ شَ دِ يٍهٌيَكِمِ شَ مَنفّيَ حّ نَانِ ندٍ يُدَيَ بْشِ مَ، عَلَتَلَ نَشَ عَ مَسٍن عَننَبِ يٍرٍ مِ بّ، <verse eid="JER 36:1"/><verse number="2" style="v" sid="JER 36:2"/>«ﭑ نَشَن قَلَ عِسِرَيِلَ نُن يُدَيَ شَ قٍ رَ كَبِ يٌسِيَ شَ وَشَتِ هَن تٌ، عِ شَ نَ بِرِن سّبّ كّيدِ مَكُنتَنشِ كُي. <verse eid="JER 36:2"/><verse number="3" style="v" sid="JER 36:3"/>تّمُندٍ يُدَيَكَيٍ قَمَ نّ فَاشُدٍ ﭑ مَ مَسٍنيِ يَ رَ، عَ نُن ﭑ مَ قٍ حَاشِ ﭑ نَشَن نَبَمَ عٍ رَ، هَن عٍ فبِلٍنمَ عٍ شَ كِرَ كٌبِ قْشْ رَ تّمُي نَشّ. نَ نَن نْمَ عَ نِيَدٍ ﭑ شَ دِحّ عٍ شَ يُنُبِ مَ.»<verse eid="JER 36:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 36:4"/>عَننَبِ يٍرٍ مِ نَشَ نٍرِيَ شَ دِ بَرُكِ شِلِ، عَلَكٌ عَلَتَلَ نَشَن مَسٍن عَننَبِ يٍرٍ مِ بّ، بَرُكِ شَ نَ بِرِن سّبّ كّيدِ مَكُنتَنشِ مَ. <verse eid="JER 36:4"/><verse number="5" style="v" sid="JER 36:5"/>عٍ تٌ فّ نَ وَلِ رَ، عَننَبِ يٍرٍ مِ نَشَ يِ يَامَرِ قِ بَرُكِ مَ، «عٍ بَرَ ﭑ مَكَنكَن بٍ، ﭑ مُ نْمَ سِفَدٍ عَلَتَلَ شَ بَنشِ كُي. <verse eid="JER 36:5"/><verse number="6" style="v" sid="JER 36:6"/>عِ تَن شَ سِفَ عَلَتَلَ شَ بَنشِ كُي سُنيِ لْشْي، عِ شَ يِ سّبّلِ بِرِن شَرَن حَمَ بّ، عَ نُن يُدَيَكَيٍ نَشٍيٍ كٍلِشِ تَا فبّتّيٍ، عَلَكٌ عٍ شَ عَلَتَلَ شَ مَسٍنيِ كٌلٌن، ﭑ نَشَن قَلَ عِ بّ، عِ نَشَن سّبّ كّيدِ مَكُنتَنشِ كُي. <verse eid="JER 36:6"/><verse number="7" style="v" sid="JER 36:7"/>عَلَتَلَ بَرَ شْنْ عٍ مَ عَ حَاشِ رَ، كْنْ تّمُندٍ شَ عٍ فبِلٍن عٍ شَ كِرَ كٌبِ قْشْ رَ، عَلَتَلَ نْمَ نّ عٍ شَ مَشَندِ سُشُدٍ.» <verse eid="JER 36:7"/><verse number="8" style="v" sid="JER 36:8"/>نٍرِيَ شَ دِ بَرُكِ نَشَ عَلَتَلَ شَ مَسٍنيِ شَرَن عَلَتَلَ شَ بَنشِ كُي، عَلْ عَننَبِ يٍرٍ مِ عَ يَمَرِشِ كِ نَشّ.<verse eid="JER 36:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JER 36:9"/>يٌسِيَ شَ دِ يٍهٌيَكِمِ شَ مَنفّيَ حّ سُولِ، كِكٍ سٌلٌمَنَانِ ندٍ يُدَيَ بْشِ مَ، عَ نَشَ دَرِ سَلَمُكَيٍ نُن يُدَيَكَيٍ مَشِلِ عٍ شَ سُنيِ رَبَ عَلَتَلَ بّ دَرِ سَلَمُ. <verse eid="JER 36:9"/><verse number="10" style="v" sid="JER 36:10"/>نَ لْشْي بَرُكِ نَشَ عَننَبِ يٍرٍ مِ شَ وْيّنيِ بِرِن شَرَن عَلَتَلَ شَ بَنشِ كُي حَمَ يَ شْرِ. عَ نُ نَ مَنفّ شَ سّبّلِتِ فّمَرَيَ شَ كٌنكٌي نَن كُي، عَلَتَلَ شَ بَنشِ كٌورٍ رَ، سٌدٍ نّينّ دّ رَ. سَقَن شَ دِ فّمَرَيَ نَن نُ عَ رَ. <verse eid="JER 36:10"/><verse number="11" style="v" sid="JER 36:11"/>فّمَرَيَ شَ دِ مِكٍ تٌ عَلَتَلَ شَ مَسٍنيِ مّ نَشَن سّبّشِ كِتَابُي كُي، <verse eid="JER 36:11"/><verse number="12" style="v" sid="JER 36:12"/>عَ نَشَ فٌرٌ، عَ سِفَ مَنفّ شَ سّبّلِتِ شَ كٌنكٌي مَنفّ شَ بَنشِ كُي، كُنتِفِ بِرِن نُ عٍ مَلَنمَ دّننَشّ. مَنفّ شَ سّبّلِتِ عٍلِسَمَ، سٍمَيَ شَ دِ دّلَيَ، عَكِبٌرِ شَ دِ عٍلِنَتَن، سَقَن شَ دِ فّمَرَيَ، شَنَنِيَ شَ دِ سٍدٍكِيَ، عَ نُن كُنتِفِ فبّتّيٍ نُ نَ نَ. <verse eid="JER 36:12"/><verse number="13" style="v" sid="JER 36:13"/>مِكٍ نَشَ بَرُكِ شَ مَسٍنيِ بِرِن تَفِ رَبَ عٍ بّ، عَ نَشَن شَرَنشِ كِتَابُي كُي حَمَ يَ شْرِ.<verse eid="JER 36:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 36:14"/>نَ تّمُي كُنتِفِيٍ نَشَ نٍتَنِيَ شَ دِ يٍهُدِ شّي، سٍلٍمِيَ شَ مَمَدِ، كُو سِ بْنسْي، عَ شَ سَ عَ قَلَ بَرُكِ بّ، «كِتَابُي تٌنفٌ عِ نَشَن شَرَنشِ حَمَ بِرِن تَفِ، عِ قَ عَ رَ.» نٍرِيَ شَ دِ بَرُكِ نَشَ كِتَابُي تٌنفٌ، عَ نَشَ سِفَ عٍ يِرٍ. <verse eid="JER 36:14"/><verse number="15" style="v" sid="JER 36:15"/>عٍ نَشَ عَ قَلَ عَ بّ، «دْشْ، عِ شَ يِ سّبّلِ شَرَن مُشُ بّ.» بَرُكِ نَشَ عَ شَرَن. <verse eid="JER 36:15"/><verse number="16" style="v" sid="JER 36:16"/>عٍ تٌ فّ نَ مَسٍنيِ رَ مّدٍ، عٍ نَشَ كْنتْقِلِ، عٍ قَ عَ قَلَ بَرُكِ بّ، «مُشُ شَ يِ بِرِن تَفِ رَبَ مَنفّ بّ.» <verse eid="JER 36:16"/><verse number="17" style="v" sid="JER 36:17"/>عٍ نَشَ بَرُكِ مَشْرِن، «عَ تَفِ رَبَ مُشُ بّ عِ يِ سّبّشِ كِ نَشّ؟ يٍرٍ مِ نَن نَ قَلَشِ عِ بّ؟» <verse eid="JER 36:17"/><verse number="18" style="v" sid="JER 36:18"/>بَرُكِ نَشَ عٍ يَابِ، «عَننَبِ يٍرٍ مِ نَن يِ وْيّنيِ بِرِن قَلَ ﭑ بّ عَ شُي عِتٍشِ رَ. ﭑ نَشَ عَ سّبّ كِتَابُي كُي دُبّ رَ.» <verse eid="JER 36:18"/><verse number="19" style="v" sid="JER 36:19"/>كُنتِفِيٍ نَشَ عَ قَلَ بَرُكِ بّ، «وٌ نُن يٍرٍ مِ، وٌ سَ وٌ نْشُن. مِشِ يٌ نَشَ عَ كٌلٌن وٌ نَ دّننَشّ.»<verse eid="JER 36:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 36:20"/>كُنتِفِيٍ نَشَ سِفَ مَنفّ يِرٍ عَ شَ تّتّ كُي، عٍ قَ يٍرٍ مِ شَ مَسٍنيِ بِرِن تَفِ رَبَ عَ بّ. عٍ نُ بَرَ كِتَابُي لُ مَنفّ شَ سّبّلِتِ عٍلِسَمَ شَ كٌنكٌي كُي. <verse eid="JER 36:20"/><verse number="21" style="v" sid="JER 36:21"/>مَنفّ نَشَ يٍهُدِ شّي عَ شَ سَ قَ كِتَابُي رَ. يٍهُدِ نَشَ عَ تٌنفٌ مَنفّ شَ سّبّلِتِ عٍلِسَمَ شَ كٌنكٌي كُي، عَ قَ عَ شَرَن مَنفّ نُن عَ شَ كُنتِفِيٍ بّ. <verse eid="JER 36:21"/><verse number="22" style="v" sid="JER 36:22"/>نَ وَشَتِ مَنفّ نُ نَ عَ شَ حّمّ بَنشِ كُي، عَ مَفٌرٌشِ كٌلٌثْوتِ قّ مَ تّ رَ عَ كُي. نَ تّمُي كِكٍ سٌلٌمَنَانِ ندٍ نَن نُ عَ رَ. <verse eid="JER 36:22"/><verse number="23" style="v" sid="JER 36:23"/>يٍهُدِ تٌ فّ يِرٍ ندٍيٍ شَرَندٍ، مَنفّ نَشَ مّننِ شَبَ عَ شَ سّبّلِتِ شَ قِنّ رَ، عَ عَ وْلّ تّ عِ. عَ لُ نَ نَن نَبَ رَ هَن كِتَابُي بِرِن نَشَ فّ فَندٍ. <verse eid="JER 36:23"/><verse number="24" style="v" sid="JER 36:24"/>نَ كُي مَنفّ نُن عَ شَ مِشِ نَشٍيٍ نَ مَسٍنيِ مّ، عٍ مُ فَاشُ، عٍ مُ عٍ شَ دٌنمَيٍ عِبْو سُننُنيِ كُي. <verse eid="JER 36:24"/><verse number="25" style="v" sid="JER 36:25"/>كْنْ عٍلِنَتَن، دّلَيَ، نُن فّمَرَيَ نُ بَرَ مَنفّ مَيَندِ عَلَكٌ عَ نَشَ نَ كِتَابُي فَن، كْنْ عَ مُ عٍ شُي رَ مّ. <verse eid="JER 36:25"/><verse number="26" style="v" sid="JER 36:26"/>مَنفّ نَشَ عَ قَلَ عَ شَ دِ يٍرَ مٍيلِ بّ، عَ نُن عَسِرِيّلِ شَ دِ سٍرَيَ نُن عَبٍدٍيلِ شَ دِ سٍلٍمِيَ بّ، عٍ شَ سّبّلِتِ بَرُكِ نُن عَننَبِ يٍرٍ مِ سُشُ، كْنْ عَلَتَلَ نُ بَرَ عٍ نْشُن عٍ مَ.<verse eid="JER 36:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JER 36:27"/>مَنفّ تٌ بَرَ فّ كِتَابُي فَندٍ، عَننَبِ يٍرٍ مِ نَشَن سّبّشِ بَرُكِ سَابُي رَ، عَلَتَلَ نَشَ عَ مَسٍن عَننَبِ يٍرٍ مِ بّ، <verse eid="JER 36:27"/><verse number="28" style="v" sid="JER 36:28"/>«عِ مَن شَ كّيدِ مَكُنتَنشِ تٌنفٌ، عِ شَ وْيّنيِ بِرِن سّبّ عَ مَ نَشَن نُ نَ بٌورٍ كِتَابُي كُي، يُدَيَ مَنفّ يٍهٌيَكِمِ نَشَن فَنشِ. <verse eid="JER 36:28"/><verse number="29" style="v" sid="JER 36:29"/>عِ شَ عَ قَلَ يُدَيَ مَنفّ يٍهٌيَكِمِ بّ، ‹عَلَتَلَ شَ مَسٍنيِ نَن يَ؛ عِ تَن نَن كِتَابُي فَنشِ، عِ نُ قَ عَ قَلَ مُنقٍ رَ عَ سّبّشِ بَبِلْن مَنفّ قَمَ نّ يِ بْشِ بِرِن كَنَدٍ، عَدَ مَدِيٍ نُن سُبٍيٍ بِرِن سْنتْ؟›» <verse eid="JER 36:29"/><verse number="30" style="v" sid="JER 36:30"/>نَ نَن عَ تٌشِ، عَلَتَلَ يِ مَسٍنشِ يُدَيَ مَنفّ يٍهٌيَكِمِ شَ قٍ رَ؛ «عَ شَ مِشِ يٌ مُ قَمَ دْشْدٍ دَوُدَ شَ مَنفّ كِبَنيِ كُي. عَ قُرٍ قَمَ رَبّحِندٍ سٌفٍ نَن مَ، عَ قَ لُ شِنبٍلِ كُي كْي رَ. <verse eid="JER 36:30"/><verse number="31" style="v" sid="JER 36:31"/>ﭑ قَمَ نّ عَ حَشَنكَتَدٍ، عٍ نُن عَ بْنسْي نُن عَ شَ وَلِكّيٍ، عٍ شَ وَلِ كٌبِ شَ قٍ رَ. ﭑ مَن قَمَ نّ حَشَنكَتّ دْشْدٍ دَرِ سَلَمُكَيٍ نُن يُدَيَكَيٍ مَ عَلْ ﭑ عَ مَسٍنشِ كِ نَشّ، بَرِ مَ عٍ مُ ﭑ شُي سُشُشِ.»<verse eid="JER 36:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JER 36:32"/>عَننَبِ يٍرٍ مِ نَشَ كّيدِ مَكُنتَنشِ فبّتّ تٌنفٌ، عَ عَ سٌ سّبّلِتِ نٍرِيَ شَ دِ بَرُكِ يِ رَ. عَننَبِ يٍرٍ مِ نَشَ فبِلٍن مَسٍنيِ تِ رَ بَرُكِ بّ، يُدَيَ مَنفّ يٍهٌيَكِمِ نَشَن فَنشِ. عَ مَن نَشَ وْيّن فبّتّ سَ نَ قَرِ.<verse eid="JER 36:32"/></para>
  <chapter eid="JER 36"/>
  <chapter number="37" style="c" sid="JER 37"/>
  <para style="s">سٍدٍكِيَ نُن عَننَبِ يٍرٍ مِ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 37:1"/>بَبِلْن مَنفّ نٍبُكَدَنسَرِ نَشَ يٌسِيَ شَ دِ سٍدٍكِيَ تِ يُدَيَ مَنفّ رَ يٍهٌيَكِمِ شَ دِ يٍهٌيَكِنِ حْشْي رَ. <verse eid="JER 37:1"/><verse number="2" style="v" sid="JER 37:2"/>سٍدٍكِيَ، عَ شَ كُنتِفِيٍ، نُن بْشِ حَمَ مُ عٍ تُلِ مَتِ عَلَتَلَ شَ مَسٍنيِ رَ عَننَبِ يٍرٍ مِ نَشَن مَسٍنشِ.<verse eid="JER 37:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JER 37:3"/>سٍدٍكِيَ نَشَ سٍلٍمِيَ شَ دِ يٍهُكَلَ نُن مَاسٍيَ شَ دِ سٍقَنِيَ شّي عَننَبِ يٍرٍ مِ يِرٍ عَ قَلَقٍ رَ، «مُشُ مَرِفِ عَلَتَلَ مَشَندِ مُشُ بّ.» <verse eid="JER 37:3"/><verse number="4" style="v" sid="JER 37:4"/>عَننَبِ يٍرٍ مِ مُ نُ سَشِ فٍيلِ كُي سِندٍن، عَ نُ نْمَ حّرّدٍ حَمَ يَ مَ عَلْ عَ نُ وَ مَ عَ شْن مَ كِ نَشّ.<verse eid="JER 37:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JER 37:5"/>مِسِرَ مَنفّ شَ سْورِيٍ تٌ مِنِ مِسِرَ بْشِ رَ، كَلِدِكَيٍ نَشَ نَ شِبَارُي مّ، عٍ نَشَ كٍلِ دَرِ سَلَمُ عٍ نُ نَ فٍرٍقٍ دّننَشّ. <verse eid="JER 37:5"/><verse number="6" style="v" sid="JER 37:6"/>نَ وَشَتِ عَلَتَلَ نَشَ يِ مَسٍنيِ تِ عَننَبِ يٍرٍ مِ بّ، <verse eid="JER 37:6"/><verse number="7" style="v" sid="JER 37:7"/>«عِسِرَيِلَ مَرِفِ عَلَتَلَ شَ مَسٍنيِ نَن يَ؛ وٌ عَ مَسٍن يُدَيَ مَنفّ بّ، نَشَن وٌ شّيشِ ﭑ يِرٍ عَلَكٌ ﭑ شَ عَلَتَلَ مَشَندِ وٌ بّ، مِسِرَ مَنفّ شَ سْورِ نَشٍيٍ مِنِشِ وٌ مَلِدٍ، عٍ قَمَ نّ فبِلٍندٍ عٍ شْنيِ مِسِرَ. <verse eid="JER 37:7"/><verse number="8" style="v" sid="JER 37:8"/>نَ تّمُي كَلِدِكَيٍ مَن فبِلٍنمَ نّ بٍ، عٍ قَ يِ تَا سُشُ، عٍ عَ فَن تّ رَ. <verse eid="JER 37:8"/><verse number="9" style="v" sid="JER 37:9"/>عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ. وٌ نَشَ وٌ يّتّ مَدَشُ، وٌ نَشَ عَ مَحْشُن كَلِدِكَيٍ بَرَ مَكُيَ وٌ رَ. عٍ مُ قَمَ وٌ لُدٍ. <verse eid="JER 37:9"/><verse number="10" style="v" sid="JER 37:10"/>هَلِ وٌ كَلِدِكَيٍ شَ سْورِيٍ بْنبْ، نَشٍيٍ نَ وٌ فٍرٍقٍ، عٍ شَ سْورِ مَشْنْشِ ندٍيٍ قَمَ نّ كٍلِدٍ عَلَكٌ عٍ شَ يِ تَا فَن تّ رَ.»<verse eid="JER 37:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 37:11"/>كَلِدِكَيٍ شَ سْورِيٍ تٌ كٍلِ دَرِ سَلَمُ مِسِرَ مَنفّ شَ سْورِيٍ شَ قٍ رَ، <verse eid="JER 37:11"/><verse number="12" style="v" sid="JER 37:12"/>عَننَبِ يٍرٍ مِ نَشَ وَ كٍلِقٍ دَرِ سَلَمُ، عَ شَ سِفَ بُنيَمِن بْنسْي شَ بْشِ مَ عَلَكٌ عَ شَ عَ كّ ندٍ تٌنفٌ نَا. <verse eid="JER 37:12"/><verse number="13" style="v" sid="JER 37:13"/>عَ تٌ بُنيَمِن نَادّ لِ كٍلِقٍ دَرِ سَلَمُ، سٍلٍمِيَ شَ دِ يِرِيَ، شَنَنِيَ شَ مَمَدِ نَشَ عَ سُشُ، عَ عَ قَلَ عَ بّ، «عِ نَ سِفَقٍ كَلِدِكَيٍ نَن يِرٍ.» <verse eid="JER 37:13"/><verse number="14" style="v" sid="JER 37:14"/>عَننَبِ يٍرٍ مِ نَشَ عَ يَابِ، «عِ وُلٍ. ﭑ مُ سِفَقٍ كَلِدِكَيٍ شَ يِرٍ.» كْنْ يِرِيَ مُ لَ عَ رَ، عَ نَشَ عَننَبِ يٍرٍ مِ سُشُ، عَ عَ شَنِن كُنتِفِيٍ شْن مَ. <verse eid="JER 37:14"/><verse number="15" style="v" sid="JER 37:15"/>كُنتِفِيٍ نَشَ شْنْ عَننَبِ يٍرٍ مِ مَ، عٍ عَ بْنبْ، عٍ عَ سَ فٍيلِ كُي، دّننَشّ قِندِشِ يٌنَتَن سّبّلِتِ شَ بَنشِ رَ. <verse eid="JER 37:15"/><verse number="16" style="v" sid="JER 37:16"/>عٍ نَشَ عَننَبِ يٍرٍ مِ رَ سٌ يِرٍ حَاشِ ندٍ كُي مّننِ، عَ لُشِ دّننَشّ تّمُي شْننَكُيٍ.<verse eid="JER 37:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 37:17"/>مَنفّ سٍدٍكِيَ نَشَ عَننَبِ يٍرٍ مِ شِلِ، عَ قَ عَ مَشْرِن فُندٌ رَ، «عَلَتَلَ بَرَ مَسٍنيِ ندٍ قِ عِ مَ؟» عَننَبِ يٍرٍ مِ نَشَ عَ يَابِ، «عِيٌ. بَبِلْن مَنفّ قَمَ نّ عِ سُشُدٍ.» <verse eid="JER 37:17"/><verse number="18" style="v" sid="JER 37:18"/>عَننَبِ يٍرٍ مِ مَن نَشَ عَ قَلَ مَنفّ سٍدٍكِيَ بّ، «ﭑ هَاكّ مُندُن نَبَشِ عِ رَ، شَ نَ مُ عِ شَ كُنتِفِيٍ رَ، شَ نَ مُ حَمَ رَ، وٌ ﭑ سَشِ فٍيلِ كُي نَشَن مَ؟ <verse eid="JER 37:18"/><verse number="19" style="v" sid="JER 37:19"/>وٌ شَ نَمِحْنمّيٍ نَ مِندٍن، نَشٍيٍ عَ قَلَمَ بَبِلْن مَنفّ مُ قَمَ وٌ تَن نُن يِ بْشِ سُشُدٍ؟ <verse eid="JER 37:19"/><verse number="20" style="v" sid="JER 37:20"/>يَكْسِ عِ شَ عِ تُلِ مَتِ ﭑ نَ. مَنفّ، ﭑ بَرَ عِ مَيَندِ، عِ شَ ﭑ مَ وْيّنيِ سُشُ. عِ نَشَ ﭑ نَسٌ يٌنَتَن سّبّلِتِ شْنيِ سْنْن، عَلَكٌ ﭑ نَشَ قَشَ!» <verse eid="JER 37:20"/><verse number="21" style="v" sid="JER 37:21"/>مَنفّ سٍدٍكِيَ نَشَ يَامَرِ قِ عٍ شَ عَننَبِ يٍرٍ مِ لُ فٍيلِ تّتّ كُي، عٍ مَن شَ تَامِ شُنتُنيِ سٌ عَ يِ رَ لْشْ يٌ لْشْ كٍلِقٍ تَامِ فَندٍ. عٍ شَ نَ رَبَ هَن تَامِ حْنمَ تَا كُي تّمُي نَشّ. نَ نَن عَ تٌشِ عَننَبِ يٍرٍ مِ نَشَ لُ فٍيلِ تّتّ كُي.<verse eid="JER 37:21"/></para>
  <chapter eid="JER 37"/>
  <chapter number="38" style="c" sid="JER 38"/>
  <para style="s">عَننَبِ يٍرٍ مِ وٌلِقٍ كْلْنيِ كُي</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 38:1"/>مَتَن شَ دِ سّقَتَيَ، ثَسُرَ شَ دِ فّدَلَيَ، سٍلٍمِيَ شَ دِ يٍهُكَلَ، مَلَكِيَ شَ دِ ثَسُرَ، عٍ نَشَ عَننَبِ يٍرٍ مِ شَ مَسٍنيِ مّ عَ نَشَن مَسٍنشِ حَمَ بّ عَ قَلَقٍ رَ، <verse eid="JER 38:1"/><verse number="2" style="v" sid="JER 38:2"/>«عَلَتَلَ بَرَ عَ مَسٍن، مِشِ يٌ نَشَن لُمَ يِ تَا كُي، نَ كَنيِ قَشَمَ سَنتِدّفّمَ، كَامّ، شَ نَ مُ عَ رَ قُرٍ حَاشِ نَن نَ. كْنْ نَشَن عَ يّتّ دّنتّفّمَ كَلِدِكَيٍ بّ، نَ كَنيِ تَن كِسِمَ نّ. <verse eid="JER 38:2"/><verse number="3" style="v" sid="JER 38:3"/>عَلَتَلَ بَرَ عَ مَسٍن، يِ تَا قَمَ نّ لُدٍ بَبِلْن مَنفّ شَ سْورِيٍ سَفٌي.»<verse eid="JER 38:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 38:4"/>كُنتِفِيٍ نَشَ عَ قَلَ مَنفّ بّ، «عَ لَنمَ يِ مِشِ شَ قَشَ، بَرِ مَ عَ تَا فٍرٍ سٌي سّنبّ نَن بَمَ. عَ شَ مَسٍنيِ نَ لِمَنِيَ بَقٍ حَمَ مَ. عَ مُ وَ مَ تَا شَ شُننَقَنيِ شْن، عَ وَ مَ عَ شَ تْورّ نَن شْن.» <verse eid="JER 38:4"/><verse number="5" style="v" sid="JER 38:5"/>مَنفّ سٍدٍكِيَ نَشَ عٍ يَابِ، «عَوَ يِرٍ، ﭑ بَرَ عَ لُ وٌ يِ رَ.» <verse eid="JER 38:5"/><verse number="6" style="v" sid="JER 38:6"/>نَ كُي عٍ نَشَ عَننَبِ يٍرٍ مِ سُشُ، عٍ عَ رَفٌرٌ لُوتِ رَ مَنفّ شَ دِ مَلَكِيَ شَ كْلْنيِ كُي سْورِيٍ شَ تّتّ تَفِ. يٍ نُ بَرَ حْن نَا، كْنْ عَننَبِ يٍرٍ مِ نَشَ بِرِ بٌورَ كُي.<verse eid="JER 38:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 38:7"/>مَنفّ بَتُلَ عٍبٍدِ مٍلٍكِ عٍتِيٌثِكَ نَشَ عَ مّ عٍ نُ بَرَ عَننَبِ يٍرٍ مِ رَفٌرٌ كْلْنيِ كُي. مَنفّ نُ دْشْشِ بُنيَمِن سٌدٍ دّ رَ. <verse eid="JER 38:7"/><verse number="8" style="v" sid="JER 38:8"/>عٍبٍدِ مٍلٍكِ نَشَ مِنِ مَنفّ شَ بَنشِ، عَ سَ عَ قَلَ مَنفّ بّ، <verse eid="JER 38:8"/><verse number="9" style="v" sid="JER 38:9"/>«ﭑ مَ مَنفّ، يِ مِشِيٍ بَرَ قٍ حَاشِ رَبَ عَننَبِ يٍرٍ مِ رَ، عٍ عَ رَفٌرٌشِ كْلْنيِ نَن كُي. عَ قَشَمَ نّ كَامّ رَ مّننِ، بَرِ مَ تَامِ بَرَ حْن تَا كُي.» <verse eid="JER 38:9"/><verse number="10" style="v" sid="JER 38:10"/>مَنفّ نَشَ عٍبٍدِ مٍلٍكِ عٍتِيٌثِكَ يَمَرِ، «عِ شَ مِشِ تٌنفٌ سَشَن تٌنفٌ، وٌ سَ عَننَبِ يٍرٍ مِ رَتٍ كْلْنيِ كُي بٍينُ عَ شَ قَشَ.» <verse eid="JER 38:10"/><verse number="11" style="v" sid="JER 38:11"/>عٍبٍدِ مٍلٍكِ نَشَ نَ مِشِيٍ تٌنفٌ، عٍ نَشَ سِفَ مَنفّ شَ بَنشِ كُي، نَاقُلِ رَفَتَ يِرٍ بُن مَ. عٍ تٌ دُفِ قٌرِ ندٍيٍ تٌنفٌ، عٍ نَشَ عٍ رَفٌرٌ عَننَبِ يٍرٍ مِ مَ كْلْنيِ كُي لُوتِ رَ. <verse eid="JER 38:11"/><verse number="12" style="v" sid="JER 38:12"/>عٍبٍدِ مٍلٍكِ عٍتِيٌثِكَ نَشَ عَ قَلَ عَننَبِ يٍرٍ مِ بّ، «يِ دُفِ قٌرِ سَ لُوتِ قَرِ عِ بّلّشّيٍ بُن مَ.» عَننَبِ يٍرٍ مِ نَشَ نَ رَبَ. <verse eid="JER 38:12"/><verse number="13" style="v" sid="JER 38:13"/>عٍ نَشَ عَننَبِ يٍرٍ مِ رَتٍ لُوتِ رَ، هَن عَ نَشَ تٍ نَا رَ. نَ تّمُي عَ نَشَ لُ سْورِيٍ شَ تّتّ كُي.<verse eid="JER 38:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JER 38:14"/>مَنفّ سٍدٍكِيَ نَشَ شّيرَ تِ عَننَبِ يٍرٍ مِ مَ، عٍ شَ نَرَلَن عَلَتَلَ شَ هْرْ مْلِنفِرَ نَادّ سَشَن ندٍ. مَنفّ نَشَ عَ قَلَ عَننَبِ يٍرٍ مِ بّ، «ﭑ وَ مَ عِ مَشْرِنقٍ قٍ ندٍ مَ، كْنْ عِ نَشَ سٍسٍ نْشُن ﭑ مَ.» <verse eid="JER 38:14"/><verse number="15" style="v" sid="JER 38:15"/>عَننَبِ يٍرٍ مِ نَشَ سٍدٍكِيَ يَابِ، «شَ ﭑ سَ عِ يَابِ نْندِ رَ، عِ مُ ﭑ قَشَمَ شّ؟ عِ تٌندِ مَ نّ ﭑ مَ مَرَ سِ سُشُدٍ.» <verse eid="JER 38:15"/><verse number="16" style="v" sid="JER 38:16"/>نَ تّمُي سٍدٍكِيَ نَشَ عَ كَلِ فُندٌ رَ عَننَبِ يٍرٍ مِ بّ، «ﭑ بَرَ ﭑ كَلِ عَلَتَلَ حِحّ رَ نَشَن وٌن نَكِسِمَ، ﭑ مُ عِ قَشَمَ، ﭑ مَن مُ عِ سٌمَ مِشِيٍ يِ رَ نَشٍيٍ وَ مَ عِ قَشَقٍ.»<verse eid="JER 38:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 38:17"/>نَ كُي عَننَبِ يٍرٍ مِ نَشَ عَ قَلَ سٍدٍكِيَ بّ، «عِسِرَيِلَ مَرِفِ عَلَتَلَ بَرَ عَ مَسٍن، شَ عِ يّتّ دّنتّفّ بَبِلْن مَنفّ شَ كُنتِفِيٍ بّ، عِ تَن نُن عِ شَ دٍنبَيَ كِسِمَ نّ، يِ تَا قَن مُ فَنمَ تّ رَ سْنْن. <verse eid="JER 38:17"/><verse number="18" style="v" sid="JER 38:18"/>كْنْ شَ عِ تٌندِ عِ يّتّ دّنتّفّدٍ بَبِلْن مَنفّ شَ كُنتِفِيٍ بّ، يِ تَا قَمَ نّ لُدٍ كَلِدِكَيٍ سَفٌي، عٍ قَ عَ فَن تّ رَ، عِ قَن لُ عٍ يِ رَ.»<verse eid="JER 38:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JER 38:19"/>مَنفّ سٍدٍكِيَ نَشَ عَ قَلَ عَننَبِ يٍرٍ مِ بّ، «ﭑ فَاشُشِ يُوِقِيٍ نَن يَ رَ نَشٍيٍ نَ كَلِدِكَيٍ يِ رَ، بَرِ مَ شَ عٍ سَ ﭑ سٌ نٍيٍ يِ رَ، عٍ ﭑ تْورْ مَ نّ عَ حَاشِ رَ.» <verse eid="JER 38:19"/><verse number="20" style="v" sid="JER 38:20"/>عَننَبِ يٍرٍ مِ نَشَ عَ يَابِ، «عٍ مُ نَ رَبَمَ. عَ لَنمَ عِ شَ عَلَتَلَ شَ يَامَرِ سُشُ ﭑ نَشَن قَلَشِ عِ بّ. نَ كُي قٍ بِرِن سْونّيَمَ نّ عِ بّ، عِ كِسِمَ نّ. <verse eid="JER 38:20"/><verse number="21" style="v" sid="JER 38:21"/>كْنْ شَ عِ تٌندِ عِ يّتّ سٌدٍ عٍ يِ رَ، عِ قَمَ نّ يِ حَشَنكَتّ سْتْدٍ عَلَتَلَ نَشَن مَسٍنشِ ﭑ بّ. <verse eid="JER 38:21"/><verse number="22" style="v" sid="JER 38:22"/>فِنّ نَشٍيٍ نَ يُدَيَ مَنفّ شَ بَنشِ كُي، عٍ شَنِنمَ نّ بَبِلْن مَنفّ شَ كُنتِفِيٍ يِرٍ. نَ فِنّيٍ قَمَ نّ عَ قَلَدٍ،</para>
  <para style="q" vid="JER 38:22">‹وٌ شَنُنتٍنيِيٍ بَرَ وٌ مَدَشُ،</para>
  <para style="q" vid="JER 38:22">وٌ بَرَ بِرِ بٌورَ كُي،</para>
  <para style="q" vid="JER 38:22">وٌ دّقَنبٌورٍ بَرَ وٌ يَنقَ.›<verse eid="JER 38:22"/></para>
  <para style="m">
    <verse number="23" style="v" sid="JER 38:23"/>عِ شَ فِنّيٍ نُن عِ شَ دِ بِرِن قَمَ نّ شَنِندٍ كَلِدِكَيٍ شْن مَ. وٌ مُ رَتَنفَمَ عٍ مَ. بَبِلْن مَنفّ قَمَ نّ وٌ سُشُدٍ، عَ يِ تَا فَن تّ رَ.» <verse eid="JER 38:23"/><verse number="24" style="v" sid="JER 38:24"/>سٍدٍكِيَ نَشَ عَ قَلَ عَننَبِ يٍرٍ مِ بّ، «وٌن مَ دّ مَسَرّ شَ قِندِ فُندٌ رَ، عَلَكٌ عِ نَشَ قَشَ. <verse eid="JER 38:24"/><verse number="25" style="v" sid="JER 38:25"/>شَ عَ سَ لِ كُنتِفِيٍ نَشَ عَ كٌلٌن وٌن بَرَ دّ مَسَرَ، عٍ قَ عِ مَشْرِن، ‹وٌ نُن مَنفّ مُنسٍ قَلَشِ وٌ بٌورٍ بّ؟ نَ قٍ بِرِن قَلَ مُشُ بّ عَلَكٌ عِ نَشَ قَشَ،› <verse eid="JER 38:25"/><verse number="26" style="v" sid="JER 38:26"/>عِ شَ عٍ يَابِ، ‹ﭑ نُ بَرَ مَنفّ مَيَندِ عَ شَ ﭑ نَمِنِ يٌنَتَن شَ بَنشِ كُي، عَلَكٌ ﭑ نَشَ قَشَ.›»<verse eid="JER 38:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JER 38:27"/>كُنتِفِيٍ نَشَ قَ عَننَبِ يٍرٍ مِ يِرٍ، عٍ نَشَ مَشْرِنيِ ندٍيٍ تِ عَ مَ. عَننَبِ يٍرٍ مِ نَشَ عٍ يَابِ عَلْ مَنفّ عَ يَمَرِشِ كِ نَشّ. عٍ نَشَ فبِلٍن دُندُي كُي. <verse eid="JER 38:27"/><verse number="28" style="v" sid="JER 38:28"/>عَننَبِ يٍرٍ مِ نَشَ لُ سْورِيٍ شَ تّتّ كُي هَن دَرِ سَلَمُ سُشُ تّمُي نَشّ.<verse eid="JER 38:28"/></para>
  <chapter eid="JER 38"/>
  <chapter number="39" style="c" sid="JER 39"/>
  <para style="s">دَرِ سَلَمُ سُشُقٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 39:1"/>دَرِ سَلَمُ سُشُ يِ كِ نّ؛ سٍدٍكِيَ يُدَيَ مَنفّ شَ مَنفّيَ حّ سٌلٌمَنَانِ ندٍ كِكٍ قُ ندٍ كُي، بَبِلْن مَنفّ نٍبُكَدَنسَرِ نُن عَ شَ سْورِ فَلِ نَشَ دَرِ سَلَمُ رَبِلِن. <verse eid="JER 39:1"/><verse number="2" style="v" sid="JER 39:2"/>سٍدٍكِيَ شَ مَنفّيَ حّ قُ نُن كٍرٍن كِكٍ نَانِ شِ سٌلٌمَنَانِ ندٍ كُي، بَبِلْنكَيٍ نَشَ تَا تّتّ يِرٍ ندٍ كَنَ. <verse eid="JER 39:2"/><verse number="3" style="v" sid="JER 39:3"/>نَ كُي بَبِلْن كُنتِفِيٍ نَشَ سٌ، عٍ دْشْ تَا نَادّ شُنفبٍ رَ، نٍرِفَلِ سَرٍ سٍرِ، سَنفَرِ نٍبٌ، سَرٍ سٍكِمِ سْورِ يَرٍرَتِيٍ شَ مَنفّ، عَ نُن بَبِلْن كُنتِفِ فبّتّيٍ. <verse eid="JER 39:3"/><verse number="4" style="v" sid="JER 39:4"/>يُدَيَ مَنفّ سٍدٍكِيَ نُن عَ شَ سْورِيٍ تٌ عٍ تٌ، عٍ نَشَ عٍ فِ. عٍ نَشَ مِنِ تَا كُي كْي رَ مَنفّ شَ لَاكْي يِرٍ، نَادّ رَ نَشَن نَ تّتّ قِرِن تَفِ، عَرَبَ كِرَ شْن مَ. <verse eid="JER 39:4"/><verse number="5" style="v" sid="JER 39:5"/>كَلِدِ سْورِيٍ نَشَ بِرَ عٍ قْشْ رَ، عٍ نَشَ سٍدٍكِيَ لِ يٍرِكٌ فُلُنبَ يِرٍ. عٍ تٌ عَ سُشُ، عٍ نَشَ عَ شَنِن بَبِلْن مَنفّ نٍبُكَدَنسَرِ شْن مَ رِبِلَ شَمَتَ بْشِ مَ. نٍبُكَدَنسَرِ نَشَ يَامَرِ ندٍ قِ عَ شَ قٍ رَ.<verse eid="JER 39:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 39:6"/>بَبِلْن مَنفّ نَشَ سٍدٍكِيَ شَ دِيٍ نُن يُدَيَ كُنتِفِ بِرِن كْن نَشَبَ رِبِلَ، سٍدٍكِيَ يَ شْرِ. <verse eid="JER 39:6"/><verse number="7" style="v" sid="JER 39:7"/>نَ دَنفِ شَنبِ عَ نَشَ سٍدٍكِيَ تَن يَيٍ سْشْ، عَ قَ يْلْنشْنيِ سَ عَ مَ عَ شَنِنقٍ رَ بَبِلْن. <verse eid="JER 39:7"/><verse number="8" style="v" sid="JER 39:8"/>كَلِدِكَيٍ نَشَ تّ سَ مَنفّ نُن حَمَ شَ بَنشِيٍ مَ، عٍ قَ دَرِ سَلَمُ تّتّ بِرِن نَبِرَ. <verse eid="JER 39:8"/><verse number="9" style="v" sid="JER 39:9"/>سْورِ مَنفّ نٍبُسَرَدَن نَشَ مِشِ دْنشْييٍ شَنِن بَبِلْن، نَشٍيٍ نُ بَرَ عٍ يّتّ رَفبِلٍن عَ مَ عَ نُن نَشٍيٍ نُ بَرَ لُ تَا كُي. <verse eid="JER 39:9"/><verse number="10" style="v" sid="JER 39:10"/>كْنْ عَ نَشَ سٍتَرٍيٍ لُ يُدَيَ بْشِ مَ، عَلَكٌ عٍ شَ مّينِ وّنِ بِلِيٍ نُن دَاشَيٍ مَ.<verse eid="JER 39:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 39:11"/>بَبِلْن مَنفّ نٍبُكَدَنسَرِ نُ بَرَ يَامَرِ قِ سْورِ مَنفّ نٍبُسَرَدَن مَ عَننَبِ يٍرٍ مِ شَ قٍ رَ، <verse eid="JER 39:11"/><verse number="12" style="v" sid="JER 39:12"/>«عِ شَ مّينِ يٍرٍ مِ مَ، عِ نَشَ قٍ حَاشِ يٌ رَبَ عَ رَ. عِ شَ عَ وَشْنقٍ بِرِن نَبَ عَ بّ.» <verse eid="JER 39:12"/><verse number="13" style="v" sid="JER 39:13"/>سْورِ مَنفّ نٍبُسَرَدَن، كُنتِفِ نٍبُسَسِبَن، مَندُرُلَيٍ شَ مَنفّ نٍرِفَلِ سَرٍ سٍرِ، نُن بَبِلْن مَنفّ شَ كُنتِفِيٍ، <verse eid="JER 39:13"/><verse number="14" style="v" sid="JER 39:14"/>عٍ نَشَ يٍرٍ مِ تٌنفٌ فٍيلِ تّتّ كُي، عٍ عَ سٌ عَشِكَمَ شَ دِ فّدَلَيَ يِ رَ، سَقَن شَ مَمَدِ، عَلَكٌ عٍ شَ عَ شَنِن عَ شْنيِ. نَ كِ عَننَبِ يٍرٍ مِ نَشَ لُ عَ شَ مِشِيٍ يَ مَ.<verse eid="JER 39:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 39:15"/>عَننَبِ يٍرٍ مِ نُ نَ فٍيلِ تّتّ كُي تّمُي نَشّ، عَلَتَلَ نَشَ عَ مَسٍن عَ بّ، <verse eid="JER 39:15"/><verse number="16" style="v" sid="JER 39:16"/>«سَ عَ قَلَ عٍبٍدِ مٍلٍكِ عٍتِيٌثِكَ بّ، ‹عِسِرَيِلَ مَرِفِ عَلَتَلَ شَ مَسٍنيِ نَن يَ؛ ﭑ قَمَ نّ فبَلٌي رَ يِ تَا شِلِ مَ عَلْ ﭑ عَ مَسٍنشِ كِ نَشّ. نَ قِندِ مَ قٍ حَاشِ نَن نَ وٌ بّ، قٍ قَنيِ مُ عَ رَ. نَ بِرِن نَبَمَ عِ يَ شْرِ نّ. <verse eid="JER 39:16"/><verse number="17" style="v" sid="JER 39:17"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛ نَ لْشْي ﭑ عِ رَتَنفَمَ نّ عِ يَشُييٍ مَ. <verse eid="JER 39:17"/><verse number="18" style="v" sid="JER 39:18"/>ﭑ عِ رَكِسِمَ نّ، عَلَكٌ عِ نَشَ قَشَ سَنتِدّفّمَ رَ. عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.›»<verse eid="JER 39:18"/></para>
  <chapter eid="JER 39"/>
  <chapter number="40" style="c" sid="JER 40"/>
  <para style="s">عَننَبِ يٍرٍ مِ شْرّيَقٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 40:1"/>سْورِ مَنفّ نٍبُسَرَدَن تٌ عَننَبِ يٍرٍ مِ رَ مِنِ رَ مَ، عَلَتَلَ نَشَ مَسٍنيِ تِ عَ بّ. عَ عَ تٌنفٌ رَ مَ تّمُي نَشّ، يٍرٍ مِ نُ شِرِشِ يْلْنشْنيِ رَ دَرِ سَلَمُكَيٍ نُن يُدَيَكَيٍ تَفِ نَشٍيٍ نُ نَ شَنِنقٍ بَبِلْن بْشِ مَ. <verse eid="JER 40:1"/><verse number="2" style="v" sid="JER 40:2"/>سْورِ شُنيِ نَشَ عَننَبِ يٍرٍ مِ شِلِ، عَ عَ قَلَ عَ بّ، «عِ مَرِفِ عَلَتَلَ نُ بَرَ يِ حَشَنكَتّ شَ قٍ قَلَ يِ تَا شِلِ مَ. <verse eid="JER 40:2"/><verse number="3" style="v" sid="JER 40:3"/>عَلَتَلَ بَرَ عَ شَ مَسٍنيِ رَكَمَلِ بَرِ مَ وٌ بَرَ يُنُبِ رَبَ عَ رَ. وٌ يِ بِرِن سْتْشِ نّ بَرِ مَ وٌ بَرَ تٌندِ عَ شُي سُشُدٍ. <verse eid="JER 40:3"/><verse number="4" style="v" sid="JER 40:4"/>ﭑ بَرَ عِ شْرّيَ يِ يْلْنشْنيِ مَ نَشٍيٍ نَ عِ بّلّشّ مَ. شَ عِ وَ مَ قَقٍ بَبِلْن، ﭑ مّينِمَ عِ مَ. شَ عِ مُ وَ مَ نَ شْن، عِ شَ لُ بٍ، عِ شَ سِفَ عِ وَ مَ دّننَشّ شْن.» <verse eid="JER 40:4"/><verse number="5" style="v" sid="JER 40:5"/>عَ تٌ بُ عَ يَابِدٍ، سْورِ شُنيِ نَشَ عَ قَلَ عَ بّ، «فبِلٍن عَشِكَمَ شَ دِ فّدَلَيَ شْن، سَقَن شَ مَمَدِ، بَبِلْن مَنفّ نَشَن تِشِ مَنفّ رَ يُدَيَ تَايٍ شُن. عِ نْمَ لُدٍ حَمَ يَ مَ، شَ نَ مُ عَ رَ عِ نْمَ سِفَدٍ عِ وَ مَ دّننَشّ شْن.» سْورِ شُنيِ نَشَ بَلٌي نُن بُنسٍ قِ عَ مَ، عَ نَشَ عَ لُ عَ شَ سِفَ. <verse eid="JER 40:5"/><verse number="6" style="v" sid="JER 40:6"/>عَننَبِ يٍرٍ مِ نَشَ سِفَ عَشِكَمَ شَ دِ فّدَلَيَ شْن مِسِثَ، عَ نَشَ لُ حَمَ يَ مَ نَشَن نُ بَرَ لُ بْشِ مَ.<verse eid="JER 40:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 40:7"/>سْورِ مَنفّيٍ نُن سْورِ نَشٍيٍ نُ نَ بْشِ مَ، عٍ نَشَ عَ كٌلٌن بَبِلْن مَنفّ نُ بَرَ عَشِكَمَ شَ دِ فّدَلَيَ تِ مَنفّ رَ بْشِ قَرِ، عَ مَن بَرَ تِن سٍتَرٍ ندٍيٍ، شّمّيٍ، فِنّيٍ، نُن دِيٍ، عٍ شَ لُ بْشِ مَ. <verse eid="JER 40:7"/><verse number="8" style="v" sid="JER 40:8"/>نٍتَنِيَ شَ دِ سُمَيِلَ، كَرٍيَ شَ دِيٍ يٌشَنَن نُن يٌنَتَن، تَنشُمّتِ شَ دِ سٍرَيَ، عٍقَيِ نٍتٌقَكَ، نُن مَكَتِكَ شَ دِ يَاسَنِيَ، عَ نُن عٍ شَ مِشِيٍ، عٍ بِرِن نَشَ سِفَ فّدَلَيَ شْن مِسِثَ. <verse eid="JER 40:8"/><verse number="9" style="v" sid="JER 40:9"/>عَشِكَمَ شَ دِ فّدَلَيَ، سَقَن شَ مَمَدِ، نَشَ عَ كَلِ عٍ تَن نُن عٍ شَ مِشِيٍ بّ، «وٌ نَشَ سِيكّ كَلِدِكَيٍ رَبَتُقٍ رَ. وٌ شَ لُ بٍ، وٌ شَ بَبِلْن مَنفّ رَبَتُ عَلَكٌ قٍ بِرِن شَ سْونّيَ وٌ بّ. <verse eid="JER 40:9"/><verse number="10" style="v" sid="JER 40:10"/>ﭑ تَن شَ لُ بٍ مِسِثَ، ﭑ شَ كَلِدِكَيٍ رَبَتُ نَشٍيٍ ﭑ لِمَ بٍ. وٌ تَن شَ نُ وّنِ بٌفِيٍ بَ، سٌفٌقُرٍ بٌفِ سٍيٍ، نُن تُرٍ. وٌ شَ سَبَتِ وٌ شَ تَايٍ كُي.»<verse eid="JER 40:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 40:11"/>يُوِقِ نَشٍيٍ نُ نَ مٌوَبَ، عَمٌنِ، عٍدٌن، نُن يِرٍ فبّتّ، عٍ نَشَ عَ كٌلٌن عَ بَبِلْن مَنفّ نُ بَرَ حَمَ دْنشْي لُ يُدَيَ عَشِكَمَ شَ دِ فّدَلَيَ، سَقَن شَ مَمَدِ شَ يَامَرِ بُن مَ. <verse eid="JER 40:11"/><verse number="12" style="v" sid="JER 40:12"/>عٍ نَشَ فبِلٍن يُدَيَ فّدَلَيَ شْنيِ مِسِثَ، كٍلِقٍ بْشِيٍ مَ عٍ نُ بَرَ يٍنسٍن يّ دّننَشّ. عٍ نَشَ وّنِ بٌفِ فبٍفبٍ بَ، عَ نُن سٌفٌقُرٍ بٌفِ سٍ وُيَشِيٍ.<verse eid="JER 40:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 40:13"/>كَرٍيَ شَ دِيٍ يٌشَنَن نُن سْورِ يَرٍرَتِيٍ نَشٍيٍ نُ نْشُنشِ وُلَ عِ، عٍ نَشَ سِفَ فّدَلَيَ شْن مِسِثَ، <verse eid="JER 40:13"/><verse number="14" style="v" sid="JER 40:14"/>عٍ قَ عَ قَلَ عَ بّ، «عِ بَرَ عَ كٌلٌن عَ عَمٌنِ مَنفّ بَالِ بَرَ نٍتَنِيَ شَ دِ سُمَيِلَ شّي عِ يِرٍ عَلَكٌ عَ شَ عِ قَشَ؟» عَشِكَمَ شَ دِ فّدَلَيَ مُ لَ عٍ رَ. <verse eid="JER 40:14"/><verse number="15" style="v" sid="JER 40:15"/>كَرٍيَ شَ دِيٍ يٌشَنَن نَشَ عَ قَلَ فّدَلَيَ بّ فُندٌ رَ مِسِثَ، «عِ شَ تِن ﭑ شَ نٍتَنِيَ شَ دِ سُمَيِلَ قَشَ. مِشِ يٌ مُ عَ كٌلٌنمَ. مُنقٍ رَ عِ عَ لُمَ عَ شَ عِ قَشَ؟ مُنقٍ رَ عَ عَ لُشِ يُدَيَكَيٍ نَشٍيٍ نَ عِ سّيتِ مَ عٍ شَ يٍنسٍن يّ؟» <verse eid="JER 40:15"/><verse number="16" style="v" sid="JER 40:16"/>عَشِكَمَ شَ دِ فّدَلَيَ نَشَ كَرٍيَ شَ دِ يٌشَنَن يَابِ، «عِ نَشَ نَ رَبَ. عِ نَشَن قَلَقٍ سُمَيِلَ شُن مَ نَ كِ، وُلٍ نَ عَ رَ.»<verse eid="JER 40:16"/></para>
  <chapter eid="JER 40"/>
  <chapter number="41" style="c" sid="JER 41"/>
  <para style="s">فّدَلَيَ قَشَ كِ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 41:1"/>كِكٍ سٌلٌقٍرٍ ندٍ، نٍتَنِيَ شَ دِ سُمَيِلَ، عٍلِسَمَ شَ مَمَدِ، مَنفّ شَ كُنتِفِ ندٍ نَشَن قَتَنشِ مَنفّ بْنسْي رَ، عَ نَشَ سِفَ عَشِكَمَ شَ دِ فّدَلَيَ يِرٍ مِسِثَ، عَ نُن كُنتِفِ قُ. عٍ تٌ فّ عٍ دّفٍدٍ يِرٍ كٍرٍن، <verse eid="JER 41:1"/><verse number="2" style="v" sid="JER 41:2"/>نٍتَنِيَ شَ دِ سُمَيِلَ نُن عَ شَ مِشِ قُ، عٍ نَشَ عَشِكَمَ شَ دِ فّدَلَيَ قَشَ سَنتِدّفّمَ رَ. سَقَن شَ مَمَدِ فّدَلَيَ، بَبِلْن مَنفّ نُ بَرَ نَشَن دْشْ مَنفّ رَ، عَ قَشَ نَ كِ نّ. <verse eid="JER 41:2"/><verse number="3" style="v" sid="JER 41:3"/>سُمَيِلَ نَشَ يُوِقِيٍ نُن كَلِدِ سْورِيٍ بِرِن قَشَ نَشٍيٍ نُ نَ فّدَلَيَ قّ مَ.<verse eid="JER 41:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 41:4"/>نَ وَشَتِ مِشِ يٌ مُ عَ كٌلٌن فّدَلَيَ نُ بَرَ قَشَ. نَ كُيٍ عِبَ، <verse eid="JER 41:4"/><verse number="5" style="v" sid="JER 41:5"/>مِشِ تٌنفٌ سٌلٌمَسَشَن نَشَ قَ كٍلِقٍ سِكٍمِ، سِلٌ، نُن سَمَرِ. عٍ دّ شَبٍ نُ بِشِ، عٍ شَ دُفِيٍ عِبْوشِ، عٍ قَتٍ نُ مَشَبَشِ. عٍ قَ سّرّشّيٍ نُن سُرَيِ نَن نَ عَلَتَلَ شَ بَنشِ يِرٍ. <verse eid="JER 41:5"/><verse number="6" style="v" sid="JER 41:6"/>نٍتَنِيَ شَ دِ سُمَيِلَ نَشَ مِنِ مِسِثَ عٍ رَلَندٍ. عٍ نُ نَ وَقٍ. عَ نَشَ عَ قَلَ عٍ بّ، «وٌ قَ عَشِكَمَ شَ دِ فّدَلَيَ يِرٍ.» <verse eid="JER 41:6"/><verse number="7" style="v" sid="JER 41:7"/>عٍ تٌ تَا تَفِ لِ، نٍتَنِيَ شَ دِ سُمَيِلَ نُن عَ شَ مِشِيٍ نَشَ عٍ كْن نَشَبَ، عٍ قَ عٍ وٌلِ كْلْنيِ كُي. <verse eid="JER 41:7"/><verse number="8" style="v" sid="JER 41:8"/>كْنْ مِشِ قُ نَشَ سُمَيِلَ مَيَندِ، «عِ نَشَ مُشُ قَشَ، بَرِ مَ دٌنسٍ فبٍفبٍ نَ مُشُ يِ رَ، عَ رَفَتَشِ وُلَ عِ، عَلْ قُندٍنيِ مَنِيّ، تُرٍ، نُن كُمِ.» نَ كُي عَ مُ تِن عٍ نُن عٍ نفَشَكٍرٍنيِيٍ قَشَدٍ. <verse eid="JER 41:8"/><verse number="9" style="v" sid="JER 41:9"/>سُمَيِلَ فّدَلَيَ شَ مِشِيٍ قُرٍيٍ رَفٌرٌ كْلْنيِ نَشَن كُي، مَنفّ عَسَ نُ بَرَ نَ فٍ عِسِرَيِلَ مَنفّ بَاسَ شَ قٍ رَ. <verse eid="JER 41:9"/><verse number="10" style="v" sid="JER 41:10"/>سُمَيِلَ نَشَ حَمَ دْنشْي سُشُ مِسِثَ، مَنفّ شَ دِ فِنّيٍ نُن مِشِ فبّتّيٍ، بَبِلْن سْورِ مَنفّ نٍبُسَرَدَن نُ بَرَ نَشٍيٍ تَشُ عَشِكَمَ شَ دِ فّدَلَيَ رَ. سُمَيِلَ نَشَ عٍ شَنِن عَمٌنِكَيٍ شْن.<verse eid="JER 41:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 41:11"/>كَرٍيَ شَ دِ يٌشَنَن نُن سْورِ يَرٍرَتِيٍ نَشٍيٍ نُ نَ عَ قّ مَ، عٍ نَشَ نٍتَنِيَ شَ دِ سُمَيِلَ شَ كّوَلِ حَاشِ كٌلٌن. <verse eid="JER 41:11"/><verse number="12" style="v" sid="JER 41:12"/>عٍ نَشَ مِشِيٍ مَلَن عَلَكٌ عٍ شَ نٍتَنِيَ شَ دِ سُمَيِلَ فٍرٍ. عٍ نَشَ عَ لِ فَبَيٌن شُرٍ شُنفبٍ يِرٍ. <verse eid="JER 41:12"/><verse number="13" style="v" sid="JER 41:13"/>سُمَيِلَ نُ مِشِ نَشٍيٍ سُشُشِ مِسِثَ، عٍ تٌ كَرٍيَ شَ دِ يٌشَنَن نُن سْورِ يَرٍرَتِيٍ تٌ، عٍ نَشَ سّيوَ، <verse eid="JER 41:13"/><verse number="14" style="v" sid="JER 41:14"/>عٍ نَشَ كٍلِ سُمَيِلَ شُن مَ، عٍ بِرَ كَرٍيَ شَ دِ يٌشَنَن قْشْ رَ. <verse eid="JER 41:14"/><verse number="15" style="v" sid="JER 41:15"/>نٍتَنِيَ شَ دِ سُمَيِلَ نُن عَ شَ مِشِ سٌلٌمَسَشَن نَشَ عٍ فِ يٌشَنَن يَ رَ، عٍ سِفَ عَمٌنِكَيٍ يِرٍ.<verse eid="JER 41:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JER 41:16"/>كَرٍيَ شَ دِ يٌشَنَن نُن سْورِ يَرٍرَتِيٍ نَشَ مِسِثَ حَمَ دْنشْي شَنِن فَبَيٌن، نٍتَنِيَ شَ دِ سُمَيِلَ نُ بَرَ نَشٍيٍ سُشُ. فٍرٍ سٌي، فِنّيٍ، نُن مَنفّ شَ مِشِيٍ نُ نَ عٍ يَ مَ. سُمَيِلَ نُ بَرَ عَشِكَمَ شَ دِ فّدَلَيَ قَشَ. <verse eid="JER 41:16"/><verse number="17" style="v" sid="JER 41:17"/>عٍ نَشَ حّرّ هَن كِمٍهَمِ بّتّلّيمُ سّيتِ مَ. عٍ نُ نَ سِفَقٍ مِسِرَ بْشِ مَ، <verse eid="JER 41:17"/><verse number="18" style="v" sid="JER 41:18"/>عَلَكٌ عٍ شَ عٍ مَكُيَ كَلِدِكَيٍ رَ. عٍ نُ بَرَ فَاشُ عٍ يَ رَ، بَرِ مَ نٍتَنِيَ شَ دِ سُمَيِلَ نُ بَرَ عَشِكَمَ شَ دِ فّدَلَيَ قَشَ، بَبِلْن مَنفّ نُ بَرَ نَشَن تِ مَنفّ رَ.<verse eid="JER 41:18"/></para>
  <chapter eid="JER 41"/>
  <chapter number="42" style="c" sid="JER 42"/>
  <para style="s">عَننَبِ يٍرٍ مِ شَ مَرَ سِ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 42:1"/>سْورِ يَرٍرَتِيٍ، كَرٍيَ شَ دِ يٌشَنَن، هٌسَيَ شَ دِ يٍسَنِيَ، نُن حَمَ بِرِن كٍلِ دِ مّدِيٍ مَ، سَ دْشْ قٌرِيٍ رَ، عٍ نَشَ سِفَ <verse eid="JER 42:1"/><verse number="2" style="v" sid="JER 42:2"/>عَننَبِ يٍرٍ مِ يِرٍ، عٍ عَ قَلَ عَ بّ، «يَندِ، عِ شَ عِ مَرِفِ عَلَتَلَ مَشَندِ مُشُ بّ، يِ حَمَ دْنشْي شَ قٍ رَ نَشَن لُشِ. سِنفٍ مُشُ نُ وُيَ، كْنْ يَكْسِ مُشُ بَرَ شُرُن عَلْ عِ عَ تٌشِ كِ نَشّ. <verse eid="JER 42:2"/><verse number="3" style="v" sid="JER 42:3"/>عِ مَرِفِ عَلَتَلَ، عَ شَ كِرَ مَسٍن مُشُ بّ مُشُ حّرّ مَ نَشَن مَ.»<verse eid="JER 42:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 42:4"/>عَننَبِ يٍرٍ مِ نَشَ عٍ يَابِ، «ﭑ بَرَ عَ مّ. ﭑ وٌ مَرِفِ عَلَتَلَ مَشَندِ مَ وٌ بّ عَلْ وٌ عَ قَلَ كِ نَشّ. ﭑ نْندِ بِرِن مَسٍنمَ نّ وٌ بّ عَلَتَلَ وٌ يَابِمَ نَشَن نَ.» <verse eid="JER 42:4"/><verse number="5" style="v" sid="JER 42:5"/>عٍ نَشَ عَ قَلَ عَ بّ، «عَلَتَلَ بَرَ قِندِ مُشُ شَ سٍيدٍ قَنيِ رَ، نَشَن مُ سّرِيّ كَنَمَ. مُشُ بِرَ مَ عِ مَرِفِ عَلَتَلَ شَ مَسٍنيِ نَن قْشْ رَ عَ نَشَن قَلَمَ مُشُ بّ. <verse eid="JER 42:5"/><verse number="6" style="v" sid="JER 42:6"/>شَ عَ قِندِ قٍ حْشُنشِ رَ، شَ عَ قِندِ قٍ شْرْشْي رَ، مُشُ قَمَ نّ مُشُ مَرِفِ عَلَتَلَ شُي رَبَتُدٍ مُشُ نَشَن قٍنشِ عِ سَابُي رَ. قٍ بِرِن سْونّيَمَ نّ مُشُ بّ شَ مُشُ بِرَ مُشُ مَرِفِ عَلَتَلَ وَشْنقٍ قْشْ رَ.»<verse eid="JER 42:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 42:7"/>شِ قُ تٌ دَنفِ، عَلَتَلَ نَشَ مَسٍنيِ تِ عَننَبِ يٍرٍ مِ بّ. <verse eid="JER 42:7"/><verse number="8" style="v" sid="JER 42:8"/>عَننَبِ يٍرٍ مِ نَشَ كَرٍيَ شَ دِ يٌشَنَن شِلِ، سْورِ يَرٍرَتِيٍ، نُن حَمَ بِرِن كٍلِقٍ دِ مّدِيٍ مَ، سَ دْشْ قٌرِيٍ رَ. <verse eid="JER 42:8"/><verse number="9" style="v" sid="JER 42:9"/>عَ نَشَ عَ قَلَ عٍ بّ، «عِسِرَيِلَ مَرِفِ عَلَتَلَ شَ مَسٍنيِ نَن يَ، وٌ ﭑ شّيشِ نَشَن قْشْ رَ. <verse eid="JER 42:9"/><verse number="10" style="v" sid="JER 42:10"/>شَ وٌ لُ يِ بْشِ مَ، ﭑ وٌ شُن نَكٍلِمَ نّ، ﭑ مُ وٌ شُن نَكَنَمَ. وٌ لُمَ نّ عَلْ سَنسِ ﭑ نَشَن سِشِ، نَشَن مُ تَلَمَ سْنْن، بَرِ مَ ﭑ نَشَن نَبَشِ وٌ رَ، عَ بَرَ قِندِ نِمِسّ رَ ﭑ بّ. <verse eid="JER 42:10"/><verse number="11" style="v" sid="JER 42:11"/>وٌ نَشَ فَاشُ بَبِلْن مَنفّ يَ رَ، نَشَن وٌ رَ سّرّنشِ. وٌ نَشَ فَاشُ عَ يَ رَ، بَرِ مَ وٌن بِرِن نَ عَ رَ، ﭑ مُ وٌ سَمَ عَ سَفٌي. عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ. <verse eid="JER 42:11"/><verse number="12" style="v" sid="JER 42:12"/>ﭑ كِنِكِنِمَ نّ وٌ مَ، عَ قَن قَ كِنِكِنِدٍ وٌ مَ. عَ قَمَ نّ وٌ رَفبِلٍندٍ وٌ شَ بْشِ مَ.»<verse eid="JER 42:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JER 42:13"/>«كْنْ شَ وٌ عَ قَلَ، ‹مُشُ تَن مُ لُمَ بٍ،› شَ وٌ مُ وٌ تُلِ مَتِ وٌ مَرِفِ عَلَتَلَ شُي رَ، <verse eid="JER 42:13"/><verse number="14" style="v" sid="JER 42:14"/>شَ وٌ عَ قَلَ، ‹عَدٍ، مُشُ سِفَمَ نّ مِسِرَ، فٍرٍ مُ نَ دّننَشّ، فٍرٍ قٍرِ قٍ شُي مُ مّمَ دّننَشّ، كَامّ مُ مُشُ سُشُمَ دّننَشّ. مُشُ شَ سَبَتِ مّننِ،› <verse eid="JER 42:14"/><verse number="15" style="v" sid="JER 42:15"/>عَوَ نَ كُي عِسِرَيِلَ مَرِفِ عَلَتَلَ بَرَ عَ مَسٍن يُدَيَ بْنسْي دْنشْي بّ، ‹شَ وٌ نَتّ تٌنفٌ سِفَقٍ رَ مِسِرَ، شَ وٌ سَ سَبَتِ نَ بْشِ مَ، <verse eid="JER 42:15"/><verse number="16" style="v" sid="JER 42:16"/>سَنتِدّفّمَ وٌ لِمَ نّ نَا، وٌ فَاشُمَ نَشَن يَ رَ. كَامّ وٌ سُشُمَ، وٌ كْنتْقِلِشِ نَشَن نَ. وٌ قَشَمَ نّ مِسِرَ بْشِ مَ. <verse eid="JER 42:16"/><verse number="17" style="v" sid="JER 42:17"/>نَشَن بِرِن نَتّ تٌنفٌمَ سَبَتِقٍ رَ مِسِرَ، عٍ بِرِن قَشَمَ نّ سَنتِدّفّمَ، كَامّ، شَ نَ مُ عَ رَ قُرٍ حَاشِ رَ. مِشِ يٌ مُ كِسِمَ، مِشِ يٌ مُ رَتَنفَمَ نَ حَشَنكَتّ مَ ﭑ قَمَ نَشَن دْشْدٍ عٍ مَ. <verse eid="JER 42:17"/><verse number="18" style="v" sid="JER 42:18"/>عِسِرَيِلَ مَرِفِ عَلَتَلَ شَ مَسٍنيِ نَن يَ؛ شَ وٌ سِفَمَ مِسِرَ، ﭑ شْنْمَ نّ وٌ مَ عَلْ ﭑ شْنْشِ دَرِ سَلَمُكَيٍ مَ كِ نَشّ. وٌ فبَلٌي نَن سْتْمَ، وٌ شِلِ قِندِ كٌنبِ وْيّنيِ رَ، وٌ يَافِ، وٌ مُ يِ بْشِ تٌ سْنْن.› <verse eid="JER 42:18"/><verse number="19" style="v" sid="JER 42:19"/>عَلَتَلَ بَرَ عَ مَسٍن وٌ تَن يُدَيَكَ دْنشْييٍ بّ، ‹وٌ نَشَ سِفَ مِسِرَ دٍ! وٌ شَ ﭑ مَ مَسٍنيِ قَهَامُ عَ قَنيِ رَ.›»<verse eid="JER 42:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 42:20"/>«وٌ تٌ ﭑ شّي وٌ مَرِفِ عَلَتَلَ مَشَندِدٍ، وٌ بَرَ تَنتَن. وٌ بَرَ عَ قَلَ ﭑ بّ، ‹مُشُ مَرِفِ عَلَتَلَ مَشَندِ مُشُ بّ. مُشُ مَرِفِ عَلَتَلَ نَشَن مَسٍنمَ مُشُ بّ، عِ شَ نُ نَ قَلَ مُشُ بّ، مُشُ مُ تٌندِ مَ نَ رَبَدٍ.› <verse eid="JER 42:20"/><verse number="21" style="v" sid="JER 42:21"/>تٌ ﭑ بَرَ نَ مَسٍنيِ تِ وٌ بّ، كْنْ وٌ مُ وَ مَ وٌ تُلِ مَتِقٍ عَلَتَلَ شُي رَ. عَ نَشَن مَسٍنشِ ﭑ بّ وٌ شَ قٍ رَ، وٌ مُ وَ مَ نَ رَ مّقٍ. <verse eid="JER 42:21"/><verse number="22" style="v" sid="JER 42:22"/>وٌ شَ عَ كٌلٌن عَ وٌ نَ سَبَتِ مِسِرَ بْشِ مَ، وٌ قَشَمَ نّ سَنتِدّفّمَ، كَامّ، شَ نَ مُ عَ رَ قُرٍ حَاشِ رَ.»<verse eid="JER 42:22"/></para>
  <chapter eid="JER 42"/>
  <chapter number="43" style="c" sid="JER 43"/>
  <para style="s">عَننَبِ يٍرٍ مِ شَنِنقٍ مِسِرَ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 43:1"/>عَننَبِ يٍرٍ مِ تٌ فّ مَرِفِ عَلَتَلَ شَ مَسٍنيِ تِدٍ حَمَ بّ، عَلْ عَلَتَلَ عَ يَمَرِشِ كِ نَشّ، <verse eid="JER 43:1"/><verse number="2" style="v" sid="JER 43:2"/>هٌسَيَ شَ دِ عَسَرَيَ، كَرٍيَ شَ دِ يٌشَنَن، نُن يّتّ عِفبٌي فبّتّيٍ، عٍ نَشَ عَ قَلَ عَننَبِ يٍرٍ مِ بّ، «عِ وُلٍ! مُشُ مَرِفِ عَلَتَلَ مُ عِ شّيشِ عَ قَلَقٍ رَ وٌ نَشَ سَبَتِ مِسِرَ. <verse eid="JER 43:2"/><verse number="3" style="v" sid="JER 43:3"/>نٍرِيَ شَ دِ بَرُكِ تَن نَ عِ تُتُنقٍ عَلَكٌ عِ شَ مُشُ لُ كَلِدِكَيٍ سَفٌي، عٍ شَ مُشُ قَشَ، شَ نَ مُ عَ رَ عٍ شَ مُشُ شَنِن بَبِلْن.»<verse eid="JER 43:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 43:4"/>كَرٍيَ شَ دِ يٌشَنَن، سْورِ يَرٍرَتِيٍ، نُن حَمَ، عٍ نَشَ تٌندِ مَرِفِ شَ يَامَرِ رَ لُقٍ يُدَيَ بْشِ مَ. <verse eid="JER 43:4"/><verse number="5" style="v" sid="JER 43:5"/>كَرٍيَ شَ دِ يٌشَنَن نُن سْورِيٍ يَرٍرَتِيٍ نَشَ يُدَيَ حَمَ دْنشْي شَنِن مِسِرَ، نَشٍيٍ نُ بَرَ فبِلٍن يُدَيَ كٍلِقٍ حَمَنّيٍ مَ عٍ نُ يٍنسٍنشِ دّننَشّ. <verse eid="JER 43:5"/><verse number="6" style="v" sid="JER 43:6"/>عٍ نَشَ شّمّيٍ، فِنّيٍ، دِ مّدِيٍ، مَنفّ شَ دِ فِنّيٍ، نُن مِشِ بِرِن شَنِن، سْورِ مَنفّ نٍبُسَرَدَن نَشٍيٍ تَشُشِ عَشِكَمَ شَ دِ فّدَلَيَ رَ، سَقَن شَ مَمَدِ. عَننَبِ يٍرٍ مِ نُن نٍرِيَ شَ دِ بَرُكِ قَن نُ نَ عٍ يَ مَ. <verse eid="JER 43:6"/><verse number="7" style="v" sid="JER 43:7"/>عٍ تٌ تٌندِ عٍ تُلِ مَتِدٍ عَلَتَلَ رَ، عٍ نَشَ حَمَ بِرِن شَنِن مِسِرَ بْشِ مَ تَثَنشّسِ.<verse eid="JER 43:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 43:8"/>عَلَتَلَ نَشَ عَ مَسٍن عَننَبِ يٍرٍ مِ بّ تَثَنشّسِ، <verse eid="JER 43:8"/><verse number="9" style="v" sid="JER 43:9"/>«فّمّ شُنفبٍ ندٍيٍ سَ مِسِرَ مَنفّ شَ بُنتُنيِ تِمَ دّننَشّ تَثَنشّسِ. عِ شَ نَ رَبَ يُدَيَكَيٍ يَ شْرِ، <verse eid="JER 43:9"/><verse number="10" style="v" sid="JER 43:10"/>عِ قَ يِ مَسٍنيِ تِ عٍ بّ؛ ‹ﭑ تَن عِسِرَيِلَ مَرِفِ عَلَتَلَ عَ نِيَمَ نّ ﭑ مَ كٌنيِ بَبِلْن مَنفّ نٍبُكَدَنسَرِ شَ عَ شَ كِبَنيِ تِ بٍ يِ فّمّ نْشُنشِيٍ قَرِ، <verse eid="JER 43:10"/><verse number="11" style="v" sid="JER 43:11"/>عَ قَمَ مِسِرَ فٍرٍدٍ تّمُي نَشّ. نَ كُي نَشٍيٍ لَن عٍ شَ قَشَ، نٍيٍ قَشَمَ نّ. نَشٍيٍ لَن عٍ شَ سُشُ، نٍيٍ سُشُمَ نّ. نَشٍيٍ لَن عٍ شَ سْشْ سَنتِدّفّمَ رَ، نٍيٍ سْشْمَ نّ. <verse eid="JER 43:11"/><verse number="12" style="v" sid="JER 43:12"/>ﭑ تّ سَمَ نّ مِسِرَ شَ كُيٍيٍ شَ بَنشِيٍ. نٍبُكَدَنسَرِ عٍ فَنمَ نّ، عَ كُيٍيٍ شَنِنمَ نّ. عَ نْ مِسِرَ رَ عَلْ شُرُ سٍ دّ مَدٌنيِ نْمَ عَ شَ دُفِ رَ كِ نَشّ، عَ قَ كٍلِ بْحّسَ كُي. <verse eid="JER 43:12"/><verse number="13" style="v" sid="JER 43:13"/>عَ كُيٍ بَتُدٍيٍ كَنَمَ نّ بٍتِ سٍمٍسِ مِسِرَ بْشِ مَ، عَ مِسِرَ كُيٍيٍ شَ بَنشِيٍ فَنمَ نّ تّ رَ.›»<verse eid="JER 43:13"/></para>
  <chapter eid="JER 43"/>
  <chapter number="44" style="c" sid="JER 44"/>
  <para style="s">مِسِرَ شَ شُننَكَنّ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 44:1"/>مَسٍنيِ نَشَن تِشِ عَننَبِ يٍرٍ مِ بّ يُوِقِيٍ شَ قٍ رَ، نَشٍيٍ بَرَ سَبَتِ مِسِرَ بْشِ مَ، مِفِدٌلِ، تَثَنشّسِ، نٌقِ، نُن ثَتِرٌ سِ تَا كُي؛ <verse eid="JER 44:1"/><verse number="2" style="v" sid="JER 44:2"/>«عِسِرَيِلَ مَرِفِ عَلَتَلَ شَ مَسٍنيِ نَن يَ؛ وٌ بَرَ عَ تٌ ﭑ حَشَنكَتّ نَشَن دْشْ دَرِ سَلَمُ نُن يُدَيَ تَا بِرِن مَ. تٌ مّننِ بِرِن كَنَشِ، مِشِ يٌ مُ نَ. <verse eid="JER 44:2"/><verse number="3" style="v" sid="JER 44:3"/>نَ رَكٍلِشِ عٍ شَ قٍ حَاشِيٍ نَن مَ، عٍ ﭑ نَشْنْ نَشَن نَ، عَلْ سُرَيِ بَقٍ سّرّشّ رَ كُيٍيٍ بّ، عَ نُن كُيٍيٍ بَتُقٍ، وٌ تَن نُن وٌ بَبَيٍ مُ نَشٍيٍ كٌلٌن. <verse eid="JER 44:3"/><verse number="4" style="v" sid="JER 44:4"/>ﭑ بَرَ ﭑ مَ كٌنيِ نَمِحْنمّيٍ شّي وٌ يِرٍ تّمُي بِرِن عَ قَلَقٍ رَ وٌ نَشَ يِ كّوَلِ رَبَ ﭑ نَشَن شْنشِ. <verse eid="JER 44:4"/><verse number="5" style="v" sid="JER 44:5"/>كْنْ عٍ مُ نَ رَ مّشِ، عٍ مُ عٍ تُلِ مَتِشِ نَ مَسٍنيِ رَ. عٍ مُ فبِلٍنشِ عٍ شَ قٍ حَاشِ قْشْ رَ، عٍ مُ بَشِ سُرَيِ فَنقٍ عٍ شَ كُيٍيٍ بّ. <verse eid="JER 44:5"/><verse number="6" style="v" sid="JER 44:6"/>ﭑ مَ شْنّ بَرَ يٍنسٍن يُدَيَ تَايٍ نُن دَرِ سَلَمُ شَ كِرَيٍ مَ، دّننَشّ قِندِشِ فبَلٌي رَ عَلْ وٌ عَ تٌمَ كِ نَشّ تٌ.»<verse eid="JER 44:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JER 44:7"/>«نَ نَن عَ رَ عِسِرَيِلَ مَرِفِ عَلَتَلَ شَ مَسٍنيِ نَن يَ؛ مُنقٍ رَ وٌ نَ يِ قٍ حَاشِ رَبَقٍ وٌ يّتّ رَ؟ وٌ نَ عَ نِيَقٍ شّمّيٍ، فِنّيٍ، دِ مّدِيٍ، نُن دِيْرّ كٍرٍن مُ لُمَ يُدَيَ بْشِ مَ. <verse eid="JER 44:7"/><verse number="8" style="v" sid="JER 44:8"/>وٌ نَ ﭑ نَشْنْقٍ وٌ شَ سُرَيِ سّرّشّ رَ وٌ نَشَن بَمَ كُيٍيٍ بّ مِسِرَ بْشِ مَ، وٌ وٌ فِ دّننَشّ. نَ كُي وٌ قَمَ نّ يَافِ سْتْدٍ سِ بِرِن تَفِ نَشٍيٍ نَ دُنِحَ. <verse eid="JER 44:8"/><verse number="9" style="v" sid="JER 44:9"/>وٌ بَرَ نّيمُ وٌ بَبَيٍ شَ قٍ حَاشِيٍ رَ، يُدَيَ مَنفّيٍ شَ كّوَلِ كٌبِيٍ رَ، عٍ شَ فِنّيٍ شَ قٍ حَاشِيٍ رَ، وٌ شَ قٍ حَاشِيٍ نُن وٌ شَ فِنّيٍ شَ قٍ حَاشِيٍ رَ، عٍ نَشَن نَبَشِ يُدَيَ بْشِ مَ نُن دَرِ سَلَمُ كِرَيٍ شْن؟ <verse eid="JER 44:9"/><verse number="10" style="v" sid="JER 44:10"/>هَن تٌ عٍ مُ عٍ يّتّ رَفبِلٍنشِ ﭑ مَ، عٍ مُ فَاشُشِ ﭑ يَ رَ، عٍ مُ بِرَشِ ﭑ مَ سّرِيّ نُن ﭑ مَ يَامَرِيٍ قْشْ رَ ﭑ نَشَن قِشِ وٌ نُن وٌ بَبَيٍ مَ.»<verse eid="JER 44:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JER 44:11"/>«نَ نَن عَ رَ عِسِرَيِلَ مَرِفِ عَلَتَلَ بَرَ عَ مَسٍن، ﭑ بَرَ نَتّ تٌنفٌ قٍ حَاشِ رَبَقٍ رَ وٌ رَ، ﭑ شَ يُدَيَ بِرِن سْنتْ. <verse eid="JER 44:11"/><verse number="12" style="v" sid="JER 44:12"/>يُدَيَكَ دْنشْي نَشٍيٍ بَرَ نَتّ تٌنفٌ سَبَتِقٍ رَ مِسِرَ بْشِ مَ، عٍ بِرِن قَشَمَ نّ نَا سَنتِدّفّمَ نُن كَامّ رَ، كٍلِقٍ دِ مّدِيٍ مَ، عَ سَ دْشْ قٌرِيٍ رَ. سَنتِدّفّمَ نُن كَامّ عَ نِيَمَ نّ عٍ شِلِ شَ قِندِ كٌنبِ وْيّنيِ رَ، عٍ شَ فبَلٌي نُن يَافِ سْتْ. <verse eid="JER 44:12"/><verse number="13" style="v" sid="JER 44:13"/>ﭑ قٍ رَبَمَ نّ مِشِيٍ رَ نَشٍيٍ سَبَتِشِ مِسِرَ بْشِ مَ، عَلْ ﭑ نَشَن نَبَشِ دَرِ سَلَمُ سَنتِدّفّمَ، كَامّ، نُن قُرٍ حَاشِ رَ. <verse eid="JER 44:13"/><verse number="14" style="v" sid="JER 44:14"/>مِشِ نَشٍيٍ عٍ فِشِ مِسِرَ كٍلِقٍ يُدَيَ، كٍرٍن مُ كِسِمَ. عٍ نُ وَ مَ فبِلٍنقٍ يُدَيَ بْشِ نَن مَ، كْنْ عٍ مُ فبِلٍنمَ سْنْن، قٌ مِشِ كٍرٍن كٍرٍن.»<verse eid="JER 44:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JER 44:15"/>شّمّ بِرِن نَشٍيٍ نُ عَ كٌلٌن عٍ شَ فِنّيٍ نُ سُرَيِ بَمَ سّرّشّ رَ عَلَ فبّتّ بّ، نُن فِنّ نَشٍيٍ نُ نَ نَ مَلَنيِ كُي، نُن حَمَ نَشَن نُ سَبَتِشِ مِسِرَ بْشِ مَ ثَتِرٌ سِ تَا كُي، عٍ نَشَ عَننَبِ يٍرٍ مِ يَابِ، <verse eid="JER 44:15"/><verse number="16" style="v" sid="JER 44:16"/>«مُشُ مُ وَ مَ مُشُ تُلِ مَتِقٍ يِ مَسٍنيِ رَ عِ نَشَن مَسٍنشِ عَلَتَلَ شِلِ رَ. <verse eid="JER 44:16"/><verse number="17" style="v" sid="JER 44:17"/>مُشُ وَ مَ بِرَقٍ مُشُ شَ مَسٍنيِ نَن قْشْ رَ. مُشُ وَ مَ سُرَيِ بَقٍ سّرّشّ رَ كٌورٍ مَنفّ فِنّ نَن بّ، مُشُ وَ مَ مِنسٍ قَن بَقٍ سّرّشّ رَ عَ تَن نَن بّ، عَلْ مُشُ نُن مُشُ بَبَيٍ، عَ نُن مُشُ شَ مَنفّيٍ نُن كُنتِفِيٍ عَ رَبَشِ كِ نَشّ يُدَيَ شَ تَايٍ نُن دَرِ سَلَمُ كُي. نَ وَشَتِ بَلٌي نُ نَ مُشُ يِ رَ عَ قَنيِ رَ، مُشُ نُ سّيوَشِ، تْورّ يٌ مُ نُ نَ. <verse eid="JER 44:17"/><verse number="18" style="v" sid="JER 44:18"/>كْنْ كَبِ مُشُ نَشَ بَ سُرَيِ نُن مِنسٍ بَقٍ سّرّشّ رَ كٌورٍ مَنفّ فِنّ بّ، سٍ بِرِن نَشَ حْن مُشُ يِ رَ بَقٍ فٍرٍ نُن كَامّ رَ.» <verse eid="JER 44:18"/><verse number="19" style="v" sid="JER 44:19"/>فِنّيٍ مَن نَشَ عَ قَلَ، «مُشُ تٌ نُ سُرَيِ نُن مِنسٍ بَمَ سّرّشّ رَ كٌورٍ مَنفّ فِنّ بّ، مُشُ شَ مْرِيٍ نُ تِنمَ مُشُ شَ تَامِ يَءِلَن مَنفّ فِنّ مِسَالِ رَ، مُشُ شَ مِنسٍ بَ سّرّشّ رَ عَ بّ.»<verse eid="JER 44:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JER 44:20"/>عَننَبِ يٍرٍ مِ نَشَ حَمَ بِرِن يَابِ، شّمّيٍ نُن فِنّيٍ، <verse eid="JER 44:20"/><verse number="21" style="v" sid="JER 44:21"/>«وٌ سُرَيِ نَشَن فَنشِ يُدَيَ تَايٍ كُي نُن دَرِ سَلَمُ، وٌ تَن نُن وٌ بَبَيٍ، وٌ شَ مَنفّيٍ نُن وٌ شَ كُنتِفِيٍ، نُن حَمَ بِرِن، عَلَتَلَ مُ كٌلٌن سْتْ شّ نَ مَ؟ نَ قٍ مُ لُشِ شّ عَ بْحّ كُي؟ <verse eid="JER 44:21"/><verse number="22" style="v" sid="JER 44:22"/>عَلَتَلَ مُ نُ نْمَ تِندٍ وٌ شَ قٍ حَاشِيٍ نُن وٌ شَ قٍ شْنشِيٍ رَ وٌ نُ لُمَ نَشَن نَبَ رَ. نَ كُي وٌ شَ بْشِ بَرَ كَنَ، عَ قِندِ فبَلٌي يِرٍ رَ. وٌ بَرَ يَافِ سْتْ، وٌ شَ مِشِيٍ بَرَ قَشَ عَلْ وٌ عَ تٌمَ كِ نَشّ تٌ. <verse eid="JER 44:22"/><verse number="23" style="v" sid="JER 44:23"/>نَ بِرِن نَبَشِ نّ بَرِ مَ وٌ بَرَ سُرَيِ فَن سّرّشّ رَ، نَ قِندِ يُنُبِ رَ عَلَتَلَ مَبِرِ. وٌ مُ تِن عَلَتَلَ شُي سُشُدٍ، وٌ مُ تِن حّرّدٍ عَ شَ سّرِيّ، عَ شَ يَامَرِ، نُن عَ شَ مَرَ سِ قْشْ رَ. تٌ لْشْي وٌ يِ تْورّ سْتْشِ نَ نَن مَ.»<verse eid="JER 44:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 44:24"/>عَننَبِ يٍرٍ مِ مَن نَشَ عَ قَلَ حَمَ نُن فِنّيٍ بّ، «وٌ وٌ تُلِ مَتِ عَلَتَلَ شَ مَسٍنيِ رَ، وٌ تَن يُدَيَكَ نَشٍيٍ قَشِ مِسِرَ بْشِ مَ. <verse eid="JER 44:24"/><verse number="25" style="v" sid="JER 44:25"/>عِسِرَيِلَ مَرِفِ عَلَتَلَ شَ مَسٍنيِ نَن يَ؛ وٌ تَن نُن وٌ شَ فِنّيٍ بَرَ نَتّ تٌنفٌ وٌ شَ وٌ يّتّ وَشْنقٍ رَبَ. وٌ بَرَ عَ قَلَ، ‹مُشُ وَ مَ مُشُ شَ لَايِدِ رَكَمَلِقٍ، مُشُ شَ سُرَيِ نُن مِنسٍ بَ سّرّشّ رَ كٌورٍ مَنفّ فِنّ بّ.› عَوَ، يَكْسِ وٌ قَمَ نَ بِرِن نَبَدٍ عَلْ وٌ عَ قَلَ كِ نَشّ. <verse eid="JER 44:25"/><verse number="26" style="v" sid="JER 44:26"/>نَ كُي، وٌ شَ وٌ تُلِ مَتِ عَلَتَلَ شَ مَسٍنيِ رَ، وٌ تَن يُدَيَكَ نَشٍيٍ سَبَتِشِ مِسِرَ بْشِ مَ. ‹ﭑ بَرَ ﭑ كَلِ ﭑ شِلِ بِنيّ رَ، ﭑ تَن عَلَتَلَ، يُدَيَكَ يٌ نَشَن سَبَتِشِ مِسِرَ، عَ مُ ﭑ شِلِ قَلَمَ سْنْن، عَ مُ عَ قَلَمَ عَلَتَلَ حِحّ. <verse eid="JER 44:26"/><verse number="27" style="v" sid="JER 44:27"/>ﭑ حْشْ سَمَ نّ عٍ شْن مَ عَلَكٌ عٍ شَ حَشَنكَتَ، عٍ نَشَ هّيرِ يٌ سْتْ. شّمّ يُدَيَكَ نَشٍيٍ بِرِن نَ مِسِرَ، عٍ قَمَ نّ قَشَدٍ فٍرٍ نُن كَامّ رَ. <verse eid="JER 44:27"/><verse number="28" style="v" sid="JER 44:28"/>كٍرٍن كٍرٍن نَشٍيٍ مُ قَشَمَ نَا، نٍيٍ كٍلِمَ نّ مِسِرَ فبِلٍنقٍ رَ يُدَيَ. كْنْ نَشٍيٍ بِرِن كٍلِشِ يُدَيَ عَلَكٌ عٍ شَ سَبَتِ مِسِرَ بْشِ مَ، عٍ قَمَ نّ عَ كٌلٌندٍ مَسٍنيِ نَشَن كَمَلِمَ، ﭑ فبٍ، شَ نَ مُ عَ رَ عٍ فبٍ.› <verse eid="JER 44:28"/><verse number="29" style="v" sid="JER 44:29"/>عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ. تْنشُمَ نَن يَ عَلَكٌ وٌ شَ عَ كٌلٌن ﭑ وٌ حَشَنكَتَمَ نّ، ﭑ مَ مَسٍنيِ بِرِن كَمَلِمَ نّ. <verse eid="JER 44:29"/><verse number="30" style="v" sid="JER 44:30"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛ ﭑ مِسِرَ مَنفّ هٌقٌرَ لُمَ نّ عَ يَشُييٍ سَفٌي، نَشٍيٍ وَ مَ عَ قَشَقٍ. ﭑ عَ رَبَمَ نّ عَلْ ﭑ يُدَيَ مَنفّ سٍدٍكِيَ لُشِ بَبِلْن مَنفّ نٍبُكَدَنسَرِ سَفٌ كِ نَشّ، نَشَن بَرَ وَ عَ قَشَقٍ.»<verse eid="JER 44:30"/></para>
  <chapter eid="JER 44"/>
  <chapter number="45" style="c" sid="JER 45"/>
  <para style="s">عَننَبِ يٍرٍ مِ شَ مَسٍنيِ بَرُكِ بّ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 45:1"/>يُدَيَ مَنفّ يٌسِيَ شَ دِ يٍهٌيَكِمِ شَ مَنفّيَ حّ نَانِ ندٍ، نٍرِيَ شَ دِ بَرُكِ تٌ عَننَبِ شَ مَسٍنيِ سّبّ كِتَابُي كُي، عَننَبِ يٍرٍ مِ نَشَ عَ قَلَ بَرُكِ بّ، <verse eid="JER 45:1"/><verse number="2" style="v" sid="JER 45:2"/>«عِسِرَيِلَ مَرِفِ عَلَتَلَ شَ مَسٍنيِ نَن يَ عِ تَن بَرُكِ بّ، <verse eid="JER 45:2"/><verse number="3" style="v" sid="JER 45:3"/>عِ بَرَ عَ قَلَ، ‹تْورّ نَ ﭑ بّ، بَرِ مَ عَلَتَلَ بَرَ قٍ شْرْشْي دْشْ ﭑ شُن مَ. ﭑ بَرَ تَفَن عَ مَيَندِدٍ، مَلَبُي يٌ مُ نَ ﭑ بّ.›»<verse eid="JER 45:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JER 45:4"/>«عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ ﭑ شَ يِ وْيّنيِ قَلَ عِ بّ، ‹عِ بَرَ عَ تٌ، ﭑ نَشَن بِرِن يَءِلَنشِ، ﭑ نَ بِرِن كَنَمَ نّ. ﭑ نَشَن بِرِن سِشِ، ﭑ نَ بِرِن تَلَمَ نّ. ﭑ نَ بِرِن نَبَمَ نّ يِ بْشِ رَ. <verse eid="JER 45:4"/><verse number="5" style="v" sid="JER 45:5"/>عَوَ، عِ تَن عِ وَ مَ مُنسٍ شْن؟ عِ نَشَ قٍ تٌقَنيِ قٍن، بَرِ مَ ﭑ قَمَ نّ دُنِحَ بِرِن حَشَنكَتَدٍ. ﭑ نَشَن نَبَمَ عِ بّ، نَ نَن يَ؛ عِ سِفَمَ دّدّ، ﭑ عِ لُمَ نّ سِمَيَ كُي. عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.›»<verse eid="JER 45:5"/></para>
  <chapter eid="JER 45"/>
  <chapter number="46" style="c" sid="JER 46"/>
  <para style="s">مَسٍنيِ مِسِرَ بّ</para>
  <para style="q">
    <verse number="1" style="v" sid="JER 46:1"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ سِيٍ شَ قٍ رَ؛<verse eid="JER 46:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JER 46:2"/>«مَسٍنيِ نَن يَ مِسِرَ شَ قٍ رَ.</para>
  <para style="q" vid="JER 46:2">مَسٍنيِ نَن يَ مِسِرَ مَنفّ نٍكٌ شَ سْورِيٍ شَ قٍ رَ،</para>
  <para style="q" vid="JER 46:2">نَشٍيٍ نُ نَ عٍقِرَتِ شُرٍ سّيتِ مَ كَرَكٍمِسِ،</para>
  <para style="q" vid="JER 46:2">بَبِلْن مَنفّ نٍبُكَدَنسَرِ عٍ بْنبْ تّمُي نَشّ،</para>
  <para style="q" vid="JER 46:2">يٌسِيَ شَ دِ يٍهٌيَكِمِ، يُدَيَ مَنفّ شَ مَنفّيَ حّ نَانِ ندٍ.»<verse eid="JER 46:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="JER 46:3"/>«وٌ سْورِ مَكَنتَسٍ لَنمَدِيٍ نُن عَ شُنفبٍيٍ تٌنفٌ.</para>
  <para style="q" vid="JER 46:3">وٌ شَ وٌ مَسٌ فٍرٍ شِلِ مَ.<verse eid="JER 46:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JER 46:4"/>وٌ شَ سٌي دْشْ سٍيٍ يَءِلَن.</para>
  <para style="q" vid="JER 46:4">سٌي رَفِمَيٍ، وٌ شَ تٍ سٌي قَرِ.</para>
  <para style="q" vid="JER 46:4">شُنيِ مَكَنتَسٍ شَ لُ وٌ يِ رَ،</para>
  <para style="q" vid="JER 46:4">وٌ شَ تَنبّيٍ سُشُ وٌ يِ رَ،</para>
  <para style="q" vid="JER 46:4">وٌ شَ سَنيِ مَكَنتَسٍ سَ وٌ سَنيِيٍ مَ.»<verse eid="JER 46:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="JER 46:5"/>«مُنسٍ دَنفِقٍ؟</para>
  <para style="q" vid="JER 46:5">عٍ نَ سّرّنقٍ فَاشُي رَ، عٍ نَ فبِلٍنقٍ شَنبِ.</para>
  <para style="q" vid="JER 46:5">عٍ شَ سّنبّمَيٍ بَرَ بِرَ، عٍ نَ فبِلٍنقٍ عٍ فِ رَ فَاشُي كُي.</para>
  <para style="q" vid="JER 46:5">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="JER 46:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JER 46:6"/>سّنبّمَيٍ مُ كِسِمَ، سُو سَ مِشِيٍ مُ عٍ رَتَنفَمَ.</para>
  <para style="q" vid="JER 46:6">عٍ بِرِن بِرَ مَ نّ كْولَ مَ عٍقِرَتِ شُرٍ دّ رَ.»<verse eid="JER 46:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="JER 46:7"/>ندٍ تٍمَ عَلْ نِلِ شُرٍ، نَشَن يٍ بَنبَرَن شّ؟<verse eid="JER 46:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 46:8"/>مِسِرَ نَن تٍقٍ عَلْ نِلِ شُرٍ نَشَن يٍ بَنبَرَن شّ.</para>
  <para style="q" vid="JER 46:8">عَ بَرَ عَ قَلَ، «ﭑ تٍمَ نّ دُنِحَ بِرِن مَ،</para>
  <para style="q" vid="JER 46:8">ﭑ شَ تَا بِرِن كَنَ، ﭑ شَ حَمَيٍ سْنتْ.<verse eid="JER 46:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JER 46:9"/>سٌي رَفِمَيٍ، وٌ تٍ!</para>
  <para style="q" vid="JER 46:9">سْورِ رَفِسٍيٍ، وٌ شَ فٍرٍ تِ سّنبّ رَ!</para>
  <para style="q" vid="JER 46:9">عٍتِيٌثِكَيٍ نُن ثُتِكَيٍ فبَنفبَلَنيِيٍ،</para>
  <para style="q" vid="JER 46:9">وٌ شَ مِنِ وٌ شَ سْورِ مَكَنتَسٍيٍ رَ!</para>
  <para style="q" vid="JER 46:9">لِدِكَيٍ، وٌ شَ مِنِ شَلِيٍ رَ!<verse eid="JER 46:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JER 46:10"/>مَنفّ عَلَتَلَ شَ فبٍحْشْي لْشْي نَن يَ.</para>
  <para style="q" vid="JER 46:10">مَرِفِ عَ فبٍحْشْمَ نّ عَ يَشُييٍ مَ سَنتِدّفّمَ رَ.</para>
  <para style="q" vid="JER 46:10">عٍ وُلِ رَ مِنِمَ نّ،</para>
  <para style="q" vid="JER 46:10">عَ قِندِ سّرّشّ رَ مَنفّ عَلَتَلَ بّ حَمَنّ مَ نَشَن نَ كْولَ مَ عٍقِرَتِ مَبِرِ.<verse eid="JER 46:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JER 46:11"/>مِسِرَكَ دِ مّدِيٍ، وٌ شَ تٍ فَلَدِ مَبِرِ سٍرِ قٍندٍ،</para>
  <para style="q" vid="JER 46:11">كْنْ نَ مُ نْمَ وٌ رَيَلَندٍ.<verse eid="JER 46:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JER 46:12"/>دُنِحَ بِرِن بَرَ وٌ شَ يَافِ تٌ،</para>
  <para style="q" vid="JER 46:12">عٍ بَرَ وٌ شُي مّ،</para>
  <para style="q" vid="JER 46:12">بَرِ مَ وٌ شَ سْورِيٍ نَ عٍ يَ عِسٌقٍ عٍ بٌرٍ رَ،</para>
  <para style="q" vid="JER 46:12">عٍ بِرِن بَرَ بِرَ.<verse eid="JER 46:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JER 46:13"/>عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ</para>
  <para style="q" vid="JER 46:13">بَبِلْن مَنفّ نٍبُكَدَنسَرِ شَ فٍرٍ مِسِرَ شِلِ مَ.»<verse eid="JER 46:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="JER 46:14"/>«وٌ شَ نَ مَسٍنيِ تِ مِسِرَ بْشِ مَ.</para>
  <para style="q" vid="JER 46:14">مِفِدٌلِ شَ نَ مّ، نٌقِ نُن تَثَنشّسِ شَ نَ مّ.</para>
  <para style="q" vid="JER 46:14">وٌ شَ عَ قَلَ، ‹وٌ كٍلِ، وٌ شَ فٍرٍ سٌسٍ رَقَلَ،</para>
  <para style="q" vid="JER 46:14">بَرِ مَ سَنتِدّفّمَ كَنيِيٍ بَرَ وٌ رَبِلِن!›<verse eid="JER 46:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 46:15"/>مُنقٍ رَ وٌ شَ سْورِيٍ مُ نْمَ عٍ يَشُييٍ رَ؟</para>
  <para style="q" vid="JER 46:15">عٍ مُ نْمَ بَرِ مَ عَلَتَلَ نَن عٍ رَبِرَقٍ.<verse eid="JER 46:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 46:16"/>سْورِ وُيَشِيٍ بَرَ بِرَ.</para>
  <para style="q" vid="JER 46:16">عٍ بَرَ فبِلٍن عَ قَلَ رَ،</para>
  <para style="q" vid="JER 46:16">‹وٌن شَ فبِلٍن وٌن شْنيِ،</para>
  <para style="q" vid="JER 46:16">وٌن مَ مِشِيٍ نَ دّننَشّ،</para>
  <para style="q" vid="JER 46:16">عَلَكٌ وٌن شَ وٌن مَكُيَ فٍرٍ حَاشِ رَ.›<verse eid="JER 46:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 46:17"/>مّننِ عٍ قَمَ نّ عَ قَلَدٍ،</para>
  <para style="q" vid="JER 46:17">‹مِسِرَ مَنفّ سّنبّ مُ نَ،</para>
  <para style="q" vid="JER 46:17">عَ وْيّنمَ نّ تُن، كْنْ عَ مُ قَتَ فٍرٍ سٌدٍ.›»<verse eid="JER 46:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="JER 46:18"/>«مَنفّ عَلَتَلَ شَ مَسٍنيِ نَن يَ،</para>
  <para style="q" vid="JER 46:18">ﭑ حِحّ.</para>
  <para style="q" vid="JER 46:18">نَشَن سّنبّ فبٌ عَلْ تَبٌرٌ فٍيَ،</para>
  <para style="q" vid="JER 46:18">نَشَن سّنبّ فبٌ عَلْ كَرٍ مٍلٍ فٍيَ بَا سّيتِ مَ،</para>
  <para style="q" vid="JER 46:18">عَ نَ قَقٍ.<verse eid="JER 46:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JER 46:19"/>مِسِرَكَيٍ، وٌ شَ كٌتٍ يَءِلَن سِفَقٍ رَ كٌنيِيَ كُي.</para>
  <para style="q" vid="JER 46:19">نٌقِ قِندِ مَ نّ فبَلٌي يِرٍ رَ،</para>
  <para style="q" vid="JER 46:19">عَ فَنمَ نّ، عَ شَ مِشِ يٌ مُ كِسِمَ.<verse eid="JER 46:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 46:20"/>مِسِرَ مَنِيَ نِنفٍ تٌقَنيِ رَ،</para>
  <para style="q" vid="JER 46:20">كْنْ تُفِتُفِ حَاشِ نَ قَقٍ كٍلِقٍ كْولَ مَ عَ شِلِ مَ.<verse eid="JER 46:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JER 46:21"/>مِسِرَ شَ سْورِ شْحّيٍ،</para>
  <para style="q" vid="JER 46:21">نَشٍيٍ فٍرٍ سٌمَ كْبِرِ شَ قٍ رَ،</para>
  <para style="q" vid="JER 46:21">عٍ قَن فبِلٍنمَ نّ مِسِرَ قْشْ رَ عٍ سِفَ عٍ فِ رَ.</para>
  <para style="q" vid="JER 46:21">نَ فبَلٌي فبٌ عٍ بّ،</para>
  <para style="q" vid="JER 46:21">عٍ مُ نْمَ نَ حَشَنكَتّ رَ.<verse eid="JER 46:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JER 46:22"/>مِسِرَ عَ فِمَ نّ عَلْ بْشِمَسٍ عَ يَشُييٍ يَ رَ،</para>
  <para style="q" vid="JER 46:22">نَشٍيٍ قَمَ سّنبّ رَ،</para>
  <para style="q" vid="JER 46:22">عَلْ بٍيرَ كَنيِ نَشٍيٍ قَمَ وٌندِ سّفّدٍ.<verse eid="JER 46:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JER 46:23"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 46:23">عٍ قَمَ نّ نَ وٌندِ سّفّدٍ، هَلِ عَ سّنبّ فبٌ.</para>
  <para style="q" vid="JER 46:23">عٍ نْمَ نّ نَ رَ بَرِ مَ عٍ وُيَ عَلْ تُفُمِيٍ.<verse eid="JER 46:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JER 46:24"/>مِسِرَ بَرَ يَافِ،</para>
  <para style="q" vid="JER 46:24">عٍ بَرَ لُ حَمَنّ سَفٌي نَشَن نَ كْولَ مَ.»<verse eid="JER 46:24"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="25" style="v" sid="JER 46:25"/>عِسِرَيِلَ مَنفّ عَلَتَلَ بَرَ عَ مَسٍن،</para>
  <para style="q" vid="JER 46:25">«ﭑ قَمَ نّ عَمٌن تٍبٍسٍكَ حَشَنكَتَدٍ.</para>
  <para style="q" vid="JER 46:25">ﭑ قَمَ نّ مِسِرَ مَنفّ، عَ شَ عَلَيٍ نُن عَ شَ كُنتِفِيٍ هَلَكِدٍ.</para>
  <para style="q" vid="JER 46:25">ﭑ مِشِ بِرِن تْورْ مَ نّ نَشٍيٍ شَشِلِ تِشِ مِسِرَ مَنفّ رَ.<verse eid="JER 46:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JER 46:26"/>ﭑ نٍيٍ لُمَ نّ عٍ يَشُييٍ سَفٌي،</para>
  <para style="q" vid="JER 46:26">نَشٍيٍ وَ مَ عٍ قَشَقٍ،</para>
  <para style="q" vid="JER 46:26">عَلْ بَبِلْن مَنفّ نٍبُكَدَنسَرِ نُن عَ شَ مِشِيٍ.</para>
  <para style="q" vid="JER 46:26">نَ دَنفِ شَنبِ، مِشِ مَن سَبَتِمَ نّ مِسِرَ بْشِ مَ.</para>
  <para style="q" vid="JER 46:26">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.»<verse eid="JER 46:26"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="27" style="v" sid="JER 46:27"/>«عِ تَن، ﭑ مَ كٌنيِ يَشُبَ، عِ نَشَ فَاشُ.</para>
  <para style="q" vid="JER 46:27">عِسِرَيِلَ، عِ نَشَ سّرّن،</para>
  <para style="q" vid="JER 46:27">بَرِ مَ ﭑ عِ رَكِسِمَ نّ حَمَنّ مَكُيٍ مَ.</para>
  <para style="q" vid="JER 46:27">ﭑ عِ بْنسْي رَ مِنِمَ نّ عٍ شَ كٌنيِيَ كُي.</para>
  <para style="q" vid="JER 46:27">يَشُبَ بْنسْي فبِلٍنمَ نّ،</para>
  <para style="q" vid="JER 46:27">عٍ قَ لُ بْحّسَ كُي عٍ يَشُييٍ شَنبِ.<verse eid="JER 46:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="JER 46:28"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 46:28">عِ تَن، ﭑ مَ كٌنيِ يَشُبَ، عِ نَشَ فَاشُ،</para>
  <para style="q" vid="JER 46:28">بَرِ مَ ﭑ سِ بِرِن سْنتْمَ نّ ﭑ وٌ رَيٍنسٍن يّ دّننَشّ.</para>
  <para style="q" vid="JER 46:28">كْنْ ﭑ مُ عِ تَن سْنتْمَ.</para>
  <para style="q" vid="JER 46:28">ﭑ عِ حَشَنكَتَمَ عَ سّرِيّ كِ نَن فبَنسَن مَ،</para>
  <para style="q" vid="JER 46:28">بَرِ مَ ﭑ مُ نْمَ نْندِ كِيتِ لُدٍ نَ.»<verse eid="JER 46:28"/></para>
  <chapter eid="JER 46"/>
  <chapter number="47" style="c" sid="JER 47"/>
  <para style="s">مَسٍنيِ قِلِسِتَكَيٍ بّ</para>
  <para style="q">
    <verse number="1" style="v" sid="JER 47:1"/>عَلَتَلَ بَرَ يِ مَسٍنيِ تِ عَننَبِ يٍرٍ مِ بّ</para>
  <para style="q" vid="JER 47:1">قِلِسِتَكَيٍ شَ قٍ رَ بٍينُ مِسِرَ مَنفّ شَ فَسَ فٍرٍ.<verse eid="JER 47:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JER 47:2"/>«عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 47:2">مِشِ قَمَ نّ كٍلِقٍ كْولَ مَ</para>
  <para style="q" vid="JER 47:2">نَشٍيٍ لُشِ عَلْ يٍ شُنفبٍ شُرٍ كُي،</para>
  <para style="q" vid="JER 47:2">نَشَن بَنبَرَنمَ، عَ قَ تَايٍ كَنَ.</para>
  <para style="q" vid="JER 47:2">تَاكَيٍ بِرِن عٍ وَ شُي رَ مِنِمَ نّ.<verse eid="JER 47:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JER 47:3"/>سٌي نُن سْورِ رَفِسٍيٍ شُي نَ تَا لِ،</para>
  <para style="q" vid="JER 47:3">بَبَيٍ مُ عٍ شَ دِيٍ مَلِمَ،</para>
  <para style="q" vid="JER 47:3">سّنبّمَيٍ مُ سّنبّتَرٍيٍ مَلِمَ.<verse eid="JER 47:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JER 47:4"/>قِلِسِتَكَيٍ فبَلٌي لْشْي بَرَ عَ لِ.</para>
  <para style="q" vid="JER 47:4">تِرٍ نُن سِدْن مُ قِلِسِتَكَيٍ شَ مَلِ سْتْمَ سْنْن،</para>
  <para style="q" vid="JER 47:4">بَرِ مَ عَلَتَلَ بَرَ عٍ سْنتْ عَ نُن كَقَتٌرٌكَيٍ.<verse eid="JER 47:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JER 47:5"/>فَسَ بَرَ كَنَ، عَسِكَلْن بَرَ عَ سَبَرِ.»</para>
  <para style="b" vid="JER 47:5"/>
  <para style="q" vid="JER 47:5">«مِشِ نَشٍيٍ لُشِ قِيلِ مَ،</para>
  <para style="q" vid="JER 47:5">وٌ وٌ يّتّ مَشَبَمَ سُننُنيِ كُي هَن مُن تّمُي؟<verse eid="JER 47:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JER 47:6"/>وٌ عَ قَلَمَ، ‹عَلَتَلَ شَ سَنتِدّفّمَ وَلِمَ هَن مُن تّمُي؟</para>
  <para style="q" vid="JER 47:6">عَ رَ سٌ عَ تّي كُي، عِ بْحّ مَفٌرٌ!›<verse eid="JER 47:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JER 47:7"/>ﭑ شَ عَ قَلَ وٌ بّ، عَ سَنتِدّفّمَ مَلَبُمَ دِ؟</para>
  <para style="q" vid="JER 47:7">عَلَتَلَ نَن عَ يَمَرِشِ،</para>
  <para style="q" vid="JER 47:7">عَ شَ سِفَ هَن عَسِكَلْن بَا دّ رَ.</para>
  <para style="q" vid="JER 47:7">عَ شَ وَلِ نَن نَ كِ.»<verse eid="JER 47:7"/></para>
  <chapter eid="JER 47"/>
  <chapter number="48" style="c" sid="JER 48"/>
  <para style="s">مَسٍنيِ مٌوَبَكَيٍ بّ</para>
  <para style="q">
    <verse number="1" style="v" sid="JER 48:1"/>عِسِرَيِلَ مَنفّ عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 48:1">«حَشَنكَتّ نَ نٍبٌ بّ، نَ تَا بَرَ كَنَ.</para>
  <para style="q" vid="JER 48:1">يَافِ نَ كِرِيَتَيِمِ بّ، نَ تَا بَرَ سُشُ،</para>
  <para style="q" vid="JER 48:1">عَ شَ يِرٍ مَكَنتَشِ بَرَ قِندِ فبَلٌي مَفَاشُشِ رَ.<verse eid="JER 48:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JER 48:2"/>مَتْشْي مُ نَ مٌوَبَ بّ سْنْن.</para>
  <para style="q" vid="JER 48:2">شّسِبْنكَيٍ لُمَ سُننُنيِ نَن كُي.</para>
  <para style="q" vid="JER 48:2">ندٍيٍ نَشّ، ‹وٌن شَ عَ رَحْن دُنِحَ مِشِيٍ تَفِ.›</para>
  <para style="q" vid="JER 48:2">وٌ تَن شَشِلِتَرٍيٍ، وٌ قَن مَ قٍ حْنمَ نّ،</para>
  <para style="q" vid="JER 48:2">سَنتِدّفّمَ نَ وٌ قْشْ رَ.<verse eid="JER 48:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JER 48:3"/>شٌرٌنَيِمِ فبٍلٍفبٍلٍمَ نّ،</para>
  <para style="q" vid="JER 48:3">عَ بِرِن بَرَ بِرَ، عَ بِرِن بَرَ كَنَ.<verse eid="JER 48:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JER 48:4"/>مٌوَبَ بَرَ كَنَ، عَ شَ دِيٍ عٍ وَ شُي رَ مِنِمَ.<verse eid="JER 48:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JER 48:5"/>عٍ تٍمَ نّ لُشِتِ فٍيَ قَرِ وَ رَ.</para>
  <para style="q" vid="JER 48:5">وَ شُي مّمَ نّ شٌرٌنَيِمِ كِرَ شْن فبَلٌي شَ قٍ رَ.<verse eid="JER 48:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JER 48:6"/>وٌ وٌ فِ، وٌ شَ وٌ نِي رَتَنفَ،</para>
  <para style="q" vid="JER 48:6">وٌ شَ وٌ نْشُن وُلَ عِ.<verse eid="JER 48:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JER 48:7"/>وٌ تَن نَشٍيٍ وٌ شَشِلِ تِشِ وٌ شَ نَاقُلِ رَ،</para>
  <para style="q" vid="JER 48:7">وٌ قَن سُشُمَ نّ.</para>
  <para style="q" vid="JER 48:7">كٍمٌسِ سٌمَ نّ كٌنيِيَ كُي،</para>
  <para style="q" vid="JER 48:7">عَ نُن عَ شَ سّرّشّدُبّيٍ نُن عَ شَ كُنتِفِيٍ.<verse eid="JER 48:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 48:8"/>تَا يٌ تَا قَمَ نّ كَنَدٍ، كٍرٍن مُ كِسِمَ.</para>
  <para style="q" vid="JER 48:8">عٍ شَ دَاشَيٍ قَن كَنَمَ نّ عَلَتَلَ شَ يَامَرِ سَابُي رَ.<verse eid="JER 48:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JER 48:9"/>مٌوَبَ شَ عَ فِ عَلْ شْنِ نَشَن حّرّ مَ كٌورٍ مَ.</para>
  <para style="q" vid="JER 48:9">عَ شَ تَايٍ قَمَ نّ كَنَدٍ، مِشِ يٌ مُ لُمَ نَا.<verse eid="JER 48:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JER 48:10"/>دَنكّ نَ مِشِ بّ نَشَن مُ عَلَتَلَ شَ وَلِ رَبَمَ.</para>
  <para style="q" vid="JER 48:10">دَنكّ نَ مِشِ بّ نَشَن مُ عَ شَ سَنتِدّفّمَ رَوَلِمَ.»<verse eid="JER 48:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="JER 48:11"/>«كَبِ عَ دِ مّدِ تّمُي، مٌوَبَ بَرَ لُ بْحّسَ كُي،</para>
  <para style="q" vid="JER 48:11">مِشِ يٌ مُ عَ تْورْ،</para>
  <para style="q" vid="JER 48:11">مِشِ يٌ مُ عَ رَ سٌشِ كٌنيِيَ كُي.</para>
  <para style="q" vid="JER 48:11">كَبِ تّمُي شْننَكُيٍ عَ نَشَ لُ عَ يّتّ رَ.<verse eid="JER 48:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JER 48:12"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 48:12">كْنْ لْشْي نَ قَقٍ، مِشِيٍ عَ تْورْ مَ نّ، عٍ عَ شُن نَكَنَ.<verse eid="JER 48:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JER 48:13"/>مٌوَبَ يَافِمَ نّ كٍمٌسِ شْن مَ،</para>
  <para style="q" vid="JER 48:13">عَلْ عِسِرَيِلَ يَافِشِ بٍتٍلِ شْن مَ كِ نَشّ.</para>
  <para style="q" vid="JER 48:13">سِنفٍ عِسِرَيِلَ شَشِلِ نُ تِشِ بٍتٍلِ رَ.<verse eid="JER 48:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JER 48:14"/>وٌ نْمَ عَ قَلَدٍ دِ،</para>
  <para style="q" vid="JER 48:14">‹فبَنفبَلَنيِ نَن مُشُ رَ،</para>
  <para style="q" vid="JER 48:14">سْورِ فَلِ نَ مُشُ يِ رَ؟›<verse eid="JER 48:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 48:15"/>مٌوَبَ بَرَ كَنَ، عَ شَ تَايٍ نَ فَنقٍ،</para>
  <para style="q" vid="JER 48:15">عَ شَ سّفّتَلَيٍ بَرَ قَشَ.</para>
  <para style="q" vid="JER 48:15">مَنفّ شَ مَسٍنيِ نَن نَ كِ،</para>
  <para style="q" vid="JER 48:15">نَشَن قِندِشِ مَنفّ عَلَتَلَ رَ.»<verse eid="JER 48:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="JER 48:16"/>«مٌوَبَ شَ فبَلٌي نَ قَقٍ،</para>
  <para style="q" vid="JER 48:16">عَ فبٍ مُ لُشِ عَ شَ تْورْ عَ حَاشِ رَ.<verse eid="JER 48:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 48:17"/>مٌوَبَ دْشْبٌورٍيٍ، وٌ يٌ عَ مَ.</para>
  <para style="q" vid="JER 48:17">وٌ تَن نَشٍيٍ عَ كٌلٌن، وٌ شَ مَشْرِنيِ تِ،</para>
  <para style="q" vid="JER 48:17">‹مُنسٍ عَ نِيَشِ مٌوَبَ شَ مَنفّيَ مَفَاشُشِ شَ كَنَ؟›<verse eid="JER 48:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JER 48:18"/>دِبٌن، وٌ وٌ مَفٌرٌ، وٌ شَ لُ بْشِ مَ،</para>
  <para style="q" vid="JER 48:18">بَرِ مَ نَشَن مٌوَبَ كَنَ،</para>
  <para style="q" vid="JER 48:18">عَ قَمَ نّ وٌ شَ يِرٍ مَكَنتَشِيٍ قَن قْشْ رَ.<verse eid="JER 48:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JER 48:19"/>عَرٌوٍرِكَيٍ، وٌ مَمّ تِ كِرَ دّ رَ،</para>
  <para style="q" vid="JER 48:19">وٌ شَ فِ مِشِ مَشْرِن، ‹مُنسٍ نِيَشِ؟›<verse eid="JER 48:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 48:20"/>مٌوَبَ بَرَ يَافِ عَ حَاشِ رَ.</para>
  <para style="q" vid="JER 48:20">وٌ شَ فبٍلٍفبٍلٍ،</para>
  <para style="q" vid="JER 48:20">وٌ شَ عَ قَلَ عَرِنٌن شُرٍ دّ رَ،</para>
  <para style="q" vid="JER 48:20">عَ مٌوَبَ بَرَ كَنَ.»<verse eid="JER 48:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="JER 48:21"/>«كِيتِ بَرَ حَمَنّ لِ نَشَن نَ شٌلٌن، يَسٍرِ، مٍقَاتِ،<verse eid="JER 48:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JER 48:22"/>دِبٌن، نٍبٌ، بٍتِ دِبِلَتَيِمَ،<verse eid="JER 48:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JER 48:23"/>كِرِيَتَيِمِ، بٍتِ فَمُلُ، بٍتِ مٍيٌنِ،<verse eid="JER 48:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JER 48:24"/>كٍرِيٌتِ، بٌسَرَ، نُن مٌوَبَ تَا بِرِن،</para>
  <para style="q" vid="JER 48:24">نَشٍيٍ مَكْرّ، نَشٍيٍ مَكُيَ.<verse eid="JER 48:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JER 48:25"/>مٌوَبَ سّنبّ بَرَ كَنَ، مٌوَبَ بَرَ بِرَ.</para>
  <para style="q" vid="JER 48:25">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.»<verse eid="JER 48:25"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="26" style="v" sid="JER 48:26"/>«مٌوَبَ بَرَ عَ يّتّ عِفبٌ عَلَتَلَ مَ.</para>
  <para style="q" vid="JER 48:26">نَ نَن نَ كِ قٌ عَ شَ بِرَ</para>
  <para style="q" vid="JER 48:26">عَلْ مِشِ سِيسِشِ نَشَن نَ بْشُنقٍ.</para>
  <para style="q" vid="JER 48:26">عَ شَ لُ نَ يَافِ كُي.<verse eid="JER 48:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="JER 48:27"/>وٌ مُ يٌشِ شّ عِسِرَيِلَ مَ؟</para>
  <para style="q" vid="JER 48:27">وٌ بَرَ عَ تٌ مُحّ تِ رَ؟</para>
  <para style="q" vid="JER 48:27">مُنقٍ رَ وٌ يٌمَ عَ مَ؟<verse eid="JER 48:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="JER 48:28"/>مٌوَبَكَيٍ، وٌ شَ وٌ فِ،</para>
  <para style="q" vid="JER 48:28">كٍلِقٍ وٌ شَ تَايٍ كُي سِفَقٍ رَ فٍيَيٍ قَرِ.</para>
  <para style="q" vid="JER 48:28">وٌ شَ لُ عَلْ فَنبّ نَشَن عَ تّي سَمَ فّمّ لٌنفٌرِ رَ.<verse eid="JER 48:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="JER 48:29"/>مُشُ بَرَ مٌوَبَ شَ يّتّ عِفبٌحَ كٌلٌن.</para>
  <para style="q" vid="JER 48:29">عَ بْحّ فبٌ، عَ لَشِ عَ يّتّ رَ،</para>
  <para style="q" vid="JER 48:29">عَ مُ وَ مَ مَرَ سِ شْن، عَ سٌندٌنيِ مُ قَن.<verse eid="JER 48:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="JER 48:30"/>عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.»</para>
  <para style="b" vid="JER 48:30"/>
  <para style="q" vid="JER 48:30">«ﭑ عَ شَ يّتّ عِفبٌحَ كٌلٌن،</para>
  <para style="q" vid="JER 48:30">كْنْ عَ مُ قِندِ مَ عَ رَ.</para>
  <para style="q" vid="JER 48:30">عَ شَ وْيّن شُنفبٍ مُ كَمَلِمَ.<verse eid="JER 48:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="JER 48:31"/>نَ نَن عَ رَ مٌوَبَ مُ رَقَنشِ ﭑ مَ.</para>
  <para style="q" vid="JER 48:31">ﭑ مُ نْمَ وْيّن قَنيِ قَلَدٍ عَ شَ قٍ رَ،</para>
  <para style="q" vid="JER 48:31">ﭑ مَ وْيّنيِ شْرْشْ كِرٍ شَرٍ سٍتِكَيٍ شَ قٍ رَ.<verse eid="JER 48:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="JER 48:32"/>ﭑ بَرَ كِنِكِنِ سَنسِ بِلِيٍ مَ نَشٍيٍ نَ سِبِمَ،</para>
  <para style="q" vid="JER 48:32">سِفَقٍ يَاسّرِ مَ.</para>
  <para style="q" vid="JER 48:32">وٌ شَ سَنسِيٍ بَرَ يَاسّرِ بَا لِ، عٍ بَرَ دَنفِ نَ رَ،</para>
  <para style="q" vid="JER 48:32">كْنْ مِشِ ندٍيٍ بَرَ نَ بِرِن كَنَ.</para>
  <para style="q" vid="JER 48:32">وٌ مُ نَ وّنِ بٌفِ تٌمَ سْنْن.<verse eid="JER 48:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="JER 48:33"/>حّلّشِنيِ نُن سّيوّ مُ لُمَ وٌ شَ دَاشَيٍ سْنْن.</para>
  <para style="q" vid="JER 48:33">سّيوّ بَرَ حْن مٌوَبَ بْشِ مَ.</para>
  <para style="q" vid="JER 48:33">وّنِ مُ يَءِلَنمَ حّلّشِنيِ رَ سْنْن.</para>
  <para style="q" vid="JER 48:33">فٍرٍ سْنشْي فبَنسَن نَن لُمَ نَا.<verse eid="JER 48:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="JER 48:34"/>شّسِبْن شَ سْنشْي عٍلٍيَلٍ لِمَ نّ،</para>
  <para style="q" vid="JER 48:34">يَهَسِكَيٍ نَ مّ.</para>
  <para style="q" vid="JER 48:34">كٍلِقٍ سٌوَرِ مَ، سَ دْشْ شٌرٌنَيِمِ رَ هَن عٍفٍلَتِ سٍلِسِيَ، عٍ بِرِن</para>
  <para style="q" vid="JER 48:34">نَ وَ شُي مّمَ نّ، بَرِ مَ نِمِرِن شَ شُرٍيٍ بَرَ شْرِ.<verse eid="JER 48:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="JER 48:35"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 48:35">ﭑ وَ مَ مٌوَبَ رَحْنقٍ نّ</para>
  <para style="q" vid="JER 48:35">عَ نُن مِشِ نَشَن بِرِن تٍمَ كُيٍيٍ بَتُدٍ يِرٍ عِتٍشِيٍ قَرِ.<verse eid="JER 48:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="JER 48:36"/>ﭑ بْحّ تْورْ مَ نّ مٌوَبَ بّ،</para>
  <para style="q" vid="JER 48:36">ﭑ بْحّ تْورْ كِرِيَ شَرٍ سٍتِكَيٍ بّ،</para>
  <para style="q" vid="JER 48:36">بَرِ مَ عٍ هَرِفٍ بَرَ كَنَ.<verse eid="JER 48:36"/></para>
  <para style="q">
    <verse number="37" style="v" sid="JER 48:37"/>عٍ بَرَ عٍ شُنيِ بِ، عٍ بَرَ عٍ دّ شَبٍ مَشَبَ،</para>
  <para style="q" vid="JER 48:37">عٍ بَرَ عٍ قَتٍ يَتِ مَشَبَ،</para>
  <para style="q" vid="JER 48:37">عٍ بَرَ سُننُن دٌنمَ رَفٌرٌ عٍ مَ سُننُنيِ كُي.<verse eid="JER 48:37"/></para>
  <para style="q">
    <verse number="38" style="v" sid="JER 48:38"/>مٌوَبَ بَنشِ بِرِن بَرَ قِندِ حْن يِرٍ رَ،</para>
  <para style="q" vid="JER 48:38">بَرِ مَ ﭑ بَرَ عٍ كَنَ عَلْ قّحّ قٌرِ.</para>
  <para style="q" vid="JER 48:38">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="JER 48:38"/></para>
  <para style="q">
    <verse number="39" style="v" sid="JER 48:39"/>وٌ شَ وٌ شُي عِتٍ، مٌوَبَ بَرَ فَاشُ،</para>
  <para style="q" vid="JER 48:39">عٍ بَرَ لُ يَافِ كُي، عٍ دْشْبٌورٍ بِرِن بَرَ يٌ عٍ مَ.»<verse eid="JER 48:39"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="40" style="v" sid="JER 48:40"/>عَلَتَلَ بَرَ عَ مَسٍن،</para>
  <para style="q" vid="JER 48:40">«عَ حّرّ مَ نّ كٌورٍ مَ عَلْ سّفّ،</para>
  <para style="q" vid="JER 48:40">عَ قَ فٌرٌ مٌوَبَ شُن مَ.<verse eid="JER 48:40"/></para>
  <para style="q">
    <verse number="41" style="v" sid="JER 48:41"/>كٍرِيٌتِ بَرَ سُشُ،</para>
  <para style="q" vid="JER 48:41">عَ شَ يِرٍ مَكَنتَشِيٍ بَرَ كَنَ.</para>
  <para style="q" vid="JER 48:41">مٌوَبَ سّنبّمَيٍ بْحّيٍ بَرَ لُ</para>
  <para style="q" vid="JER 48:41">عَلْ فِنّ نَشَن نَ دِ بَرِقٍ.<verse eid="JER 48:41"/></para>
  <para style="q">
    <verse number="42" style="v" sid="JER 48:42"/>مٌوَبَ كَنَمَ نّ، عَ مُ قِندِ مَ سِ رَ سْنْن،</para>
  <para style="q" vid="JER 48:42">بَرِ مَ عَ بَرَ عَ يّتّ عِفبٌ عَلَتَلَ مَ.<verse eid="JER 48:42"/></para>
  <para style="q">
    <verse number="43" style="v" sid="JER 48:43"/>فَاشُي لُمَ نّ مٌوَبَ بّ،</para>
  <para style="q" vid="JER 48:43">عَ بِرَ يِلِ كُي، عَ سُشُ فَنتَنيِ رَ.</para>
  <para style="q" vid="JER 48:43">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.»<verse eid="JER 48:43"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="44" style="v" sid="JER 48:44"/>«نَشَن عَ فِمَ فَاشُي رَ، عَ بِرَ مَ نّ يِلِ كُي.</para>
  <para style="q" vid="JER 48:44">نَشَن نَتٍ يِلِ رَ، عَ سُشُمَ نّ فَنتَنيِ رَ،</para>
  <para style="q" vid="JER 48:44">بَرِ مَ مٌوَبَ حَشَنكَتَ وَشَتِ بَرَ عَ لِ.<verse eid="JER 48:44"/></para>
  <para style="q">
    <verse number="45" style="v" sid="JER 48:45"/>فِ مِشِيٍ تِمَ نّ شّسِبْن قَرِ، بَرِ مَ عٍ سّنبّ بَرَ حْن.</para>
  <para style="q" vid="JER 48:45">تّ بَرَ سٌ شّسِبْن، عَ مٌوَبَكَ مِشِ حَاشِيٍ شُن نَكَنَمَ نّ.<verse eid="JER 48:45"/></para>
  <para style="q">
    <verse number="46" style="v" sid="JER 48:46"/>فبَلٌي نَ مٌوَبَ بّ.</para>
  <para style="q" vid="JER 48:46">كٍمٌسِكَيٍ بَرَ لْي،</para>
  <para style="q" vid="JER 48:46">عٍ شَ دِيٍ بَرَ سِفَ كٌنيِيَ كُي.<verse eid="JER 48:46"/></para>
  <para style="q">
    <verse number="47" style="v" sid="JER 48:47"/>كْنْ ﭑ مٌوَبَكَيٍ رَفبِلٍنمَ نّ وَشَتِ رَحْنيِ.</para>
  <para style="q" vid="JER 48:47">ﭑ بَرَ نَ نَتّ تٌنفٌ مٌوَبَ شَ قٍ رَ.</para>
  <para style="q" vid="JER 48:47">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.»<verse eid="JER 48:47"/></para>
  <chapter eid="JER 48"/>
  <chapter number="49" style="c" sid="JER 49"/>
  <para style="s">مَسٍنيِ عَمٌنِكَيٍ، عٍدٌنكَيٍ،</para>
  <para style="s">دَ مَسِكَيٍ، كٍدَرِكَيٍ، نُن عٍلَمَكَيٍ بّ</para>
  <para style="q">
    <verse number="1" style="v" sid="JER 49:1"/>عَلَتَلَ بَرَ عَ مَسٍن عَمٌنِكَيٍ شَ قٍ رَ؛</para>
  <para style="q" vid="JER 49:1">«دِ مُ نَ عِسِرَيِلَكَيٍ بّ؟</para>
  <para style="q" vid="JER 49:1">كّ تٌنفٌمَيٍ مُ نَ عٍ بّ؟</para>
  <para style="q" vid="JER 49:1">مُنقٍ رَ عَمٌنِ مَنفّ فَدِ بْشِ سْتْشِ،</para>
  <para style="q" vid="JER 49:1">عَ شَ مِشِيٍ قَ لُ نَ تَا كُي؟»<verse eid="JER 49:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="JER 49:2"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 49:2">«لْشْي قَمَ عَ لِدٍ،</para>
  <para style="q" vid="JER 49:2">ﭑ قَمَ نّ رَابَ فٍرٍدٍ عَمٌنِ بْشِ مَ.</para>
  <para style="q" vid="JER 49:2">عَ قِندِ مَ فبَلٌي يِرٍ نَن نَ،</para>
  <para style="q" vid="JER 49:2">تَا نَشٍيٍ نَ عَ رَبِلِنيِ عٍ بِرِن فَن.</para>
  <para style="q" vid="JER 49:2">نَ وَشَتِ عِسِرَيِلَ مَن بْشِ مَسْتْمَ نّ</para>
  <para style="q" vid="JER 49:2">نَشَن نُ بَرَ بَ عَ يِ رَ.<verse eid="JER 49:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JER 49:3"/>شّسِبْن، وٌ شَ وَ عَيِ بّ نَشَن بَرَ كَنَ.</para>
  <para style="q" vid="JER 49:3">رَابَكَيٍ، وٌ شَ وَ، وٌ شَ سُننُن دٌنمَ رَفٌرٌ وٌ مَ،</para>
  <para style="q" vid="JER 49:3">حْن قٍ بَرَ عَ لِ.</para>
  <para style="q" vid="JER 49:3">وٌ شَ وٌ فِ تّتّ قَرِ،</para>
  <para style="q" vid="JER 49:3">بَرِ مَ وٌ شَ مَنفّ بَرَ شَنِن كٌنيِيَ كُي، عَ نُن سّرّشّدُبّيٍ نُن كُنتِفِيٍ.<verse eid="JER 49:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JER 49:4"/>مُنقٍ رَ وٌ شَشِلِ تِشِ وٌ شَ لَاكْي وَلِ رَ؟</para>
  <para style="q" vid="JER 49:4">مُنقٍ رَ وٌ لَشِ وٌ يّتّ شَ نَاقُلِ رَ، مَتَندِلَيٍ؟</para>
  <para style="q" vid="JER 49:4">وٌ عَ قَلَمَ، ‹ندٍ نْمَ وٌن نَ؟›</para>
  <para style="q" vid="JER 49:4">كْنْ وٌ سّنبّ قَمَ نّ كَنَدٍ.<verse eid="JER 49:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JER 49:5"/>مَنفّ عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 49:5">ﭑ قَمَ نّ وٌ مَفَاشُدٍ</para>
  <para style="q" vid="JER 49:5">عَ نُن وٌ رَبِلِنيِ.</para>
  <para style="q" vid="JER 49:5">وٌ بِرِن شَنِنمَ نّ، مِشِ كٍرٍن مُ كِسِمَ.<verse eid="JER 49:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JER 49:6"/>نَ دَنفِ شَنبِ، ﭑ مَن عَمٌنِكَيٍ شُن نَكٍلِمَ نّ.</para>
  <para style="q" vid="JER 49:6">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.»<verse eid="JER 49:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="JER 49:7"/>مَسٍنيِ نَن يَ عٍدٌنكَيٍ بّ؛</para>
  <para style="q" vid="JER 49:7">مَنفّ عَلَتَلَ بَرَ عَ مَسٍن،</para>
  <para style="q" vid="JER 49:7">«لْننِ مُ نَ تٍمَن سْنْن؟</para>
  <para style="q" vid="JER 49:7">مَرَ سِ بَرَ حْن عَ شَ دِيٍ يَ مَ؟</para>
  <para style="q" vid="JER 49:7">قَهَامُي بَرَ كَنَ؟<verse eid="JER 49:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 49:8"/>وٌ وٌ فِ، وٌ شَ وٌ كٌبٍ رَ سٌ.</para>
  <para style="q" vid="JER 49:8">دٍدَنكَيٍ، وٌ شَ وٌ نْشُن فٍيَيٍ قَرِ،</para>
  <para style="q" vid="JER 49:8">بَرِ مَ ﭑ قَمَ نّ عٍسَيُ شَ فبَلٌي رَ.</para>
  <para style="q" vid="JER 49:8">عَ حَشَنكَتَ وَشَتِ بَرَ عَ لِ.<verse eid="JER 49:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JER 49:9"/>نَشٍيٍ قَمَ وٌ شَ بٌفِسٍ بَدٍ،</para>
  <para style="q" vid="JER 49:9">عٍ مُ سٍسٍ لُمَ نَا.</para>
  <para style="q" vid="JER 49:9">نَشٍيٍ قَمَ وٌ مُحَدٍ،</para>
  <para style="q" vid="JER 49:9">عٍ سٍ بِرِن كَنَمَ نّ عَلْ عٍ وَ مَ عَ شْن مَ كِ نَشّ.<verse eid="JER 49:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JER 49:10"/>ﭑ قَمَ نّ سٍ بِرِن بَدٍ عٍسَيُ يِ رَ.</para>
  <para style="q" vid="JER 49:10">عَ مُ نْمَ عَ نْشُندٍ، بَرِ مَ ﭑ نَ يِرٍ بِرِن كٌلٌن.</para>
  <para style="q" vid="JER 49:10">عَ بْنسْي، عَ نفَشَكٍرٍنيِيٍ، نُن عَ دْشْبٌورٍيٍ،</para>
  <para style="q" vid="JER 49:10">عٍ بِرِن شُن نَكَنَمَ نّ، عٍ بِرِن لْي.<verse eid="JER 49:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JER 49:11"/>وٌ شَ كِرِدِيٍ لُ نَ، ﭑ تَن نَن قَمَ عٍ بَلٌدٍ.</para>
  <para style="q" vid="JER 49:11">وٌ شَ كَاحّ فِنّيٍ شَ عٍ شَشِلِ تِ ﭑ تَن نَن نَ.<verse eid="JER 49:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JER 49:12"/>عَلَتَلَ بَرَ عَ مَسٍن؛</para>
  <para style="q" vid="JER 49:12">هَلِ نَشَن مُ قٍ حَاشِ رَبَشِ، عَ قَمَ نّ تْورْدٍ.</para>
  <para style="q" vid="JER 49:12">وٌ تَن نَشٍيٍ قٍ حَاشِ رَبَشِ، عَ مُ لَنمَ شّ وٌ قَن شَ تْورْ؟</para>
  <para style="q" vid="JER 49:12">وٌ تْورْ مَ نّ.»<verse eid="JER 49:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="JER 49:13"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 49:13">«ﭑ بَرَ ﭑ كَلِ ﭑ يّتّ رَ،</para>
  <para style="q" vid="JER 49:13">بٌسَرَ كَنَمَ نّ، عَ يَافِ سْتْ.</para>
  <para style="q" vid="JER 49:13">بٌسَرَ نُن عَ رَبِلِنيِ دَنكّ نَن سْتْمَ،</para>
  <para style="q" vid="JER 49:13">نَا قَ قِندِ فبَلٌي يِرٍ رَ.»<verse eid="JER 49:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="JER 49:14"/>عَلَتَلَ بَرَ شِبَارُ قِ ﭑ مَ،</para>
  <para style="q" vid="JER 49:14">عَ بَرَ شّيرَيٍ شّي سِ بِرِن مَ؛</para>
  <para style="q" vid="JER 49:14">«وٌ شَ قَ، وٌ شَ وٌ مَلَن،</para>
  <para style="q" vid="JER 49:14">وٌ شَ فٍرٍ تِ.»<verse eid="JER 49:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 49:15"/>عَ نَشّ عٍدٌنكَيٍ بّ، «ﭑ بَرَ وٌ شُرُن سِيٍ يَ مَ،</para>
  <para style="q" vid="JER 49:15">وٌ بَرَ يَافِ سْتْ عَدَ مَدِيٍ تَفِ.<verse eid="JER 49:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 49:16"/>وٌ شَ يّتّ عِفبٌحَ، وٌ شَ بْحّتٍ بَرَ وٌ يَنقَ.</para>
  <para style="q" vid="JER 49:16">وٌ تَن نَشٍيٍ سَبَتِشِ فٍيَيٍ قَرِ،</para>
  <para style="q" vid="JER 49:16">وٌ تَن نَشٍيٍ شَ بَنشِيٍ نَ يِرٍ عِتٍشِ عَلْ سّفّ تّي،</para>
  <para style="q" vid="JER 49:16">ﭑ وٌ رَبِرَ مَ نّ.</para>
  <para style="q" vid="JER 49:16">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.»<verse eid="JER 49:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="JER 49:17"/>«عٍدٌن قِندِ مَ نّ فبَلٌي يِرٍ رَ.</para>
  <para style="q" vid="JER 49:17">دَنفِ مِشِيٍ دّ عِشَرَ مَ نّ،</para>
  <para style="q" vid="JER 49:17">عٍ كَابَ نَ حَشَنكَتّ تٌقٍ رَ.<verse eid="JER 49:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JER 49:18"/>عَلَتَلَ بَرَ عَ مَسٍن وٌ بّ،</para>
  <para style="q" vid="JER 49:18">وٌ شُن نَكَنَمَ نّ</para>
  <para style="q" vid="JER 49:18">عَلْ سٌدٌ مَ نُن فٌمٌرَ شُن نَكَنَشِ كِ نَشّ.</para>
  <para style="q" vid="JER 49:18">مِشِ يٌ مُ لُمَ نَا سْنْن.<verse eid="JER 49:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JER 49:19"/>ﭑ لُمَ نّ عَلْ يّتّ نَشَن كٍلِمَ يُرُدّن شُرٍ قّ مَ،</para>
  <para style="q" vid="JER 49:19">عَ سِفَ سُبٍ قٍندٍ يِرٍ فبّتّ.</para>
  <para style="q" vid="JER 49:19">ﭑ عٍدٌن كٍرِ مَ نّ عَ شْنيِ، ﭑ قَ مَنفّ سُفَندِشِ تِ نَا.</para>
  <para style="q" vid="JER 49:19">ندٍ مَنِيَ ﭑ نَ؟ ندٍ ﭑ نَسِمَ؟<verse eid="JER 49:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 49:20"/>نَ كُي وٌ شَ عَ رَ مّ</para>
  <para style="q" vid="JER 49:20">عَ عَلَتَلَ نَتّ نَشَن تٌنفٌشِ عٍدٌن نُن تٍمَنكَيٍ شِلِ مَ.</para>
  <para style="q" vid="JER 49:20">عَ عٍ شَنِنمَ نّ عَلْ شُرُ سٍيٍ،</para>
  <para style="q" vid="JER 49:20">عَ قَ عٍ شْنيِ كَنَ.<verse eid="JER 49:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JER 49:21"/>دُنِحَ بِرِن قَمَ نّ عٍ شَ بِرّ كٌلٌندٍ،</para>
  <para style="q" vid="JER 49:21">نَ شِبَارُي رَيٍنسٍن يّ هَن شُلُنيُمِ بَا يِرٍ.<verse eid="JER 49:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JER 49:22"/>نَ لْشْي عٍ يَشُييٍ مَنِيَمَ سّفّ نَن نَ</para>
  <para style="q" vid="JER 49:22">نَشَن حّرّ مَ كٌورٍ مَ عٍ مَتٌقٍ رَ،</para>
  <para style="q" vid="JER 49:22">عٍ قَ دُ سُ بٌسَرَ شُن نَ.</para>
  <para style="q" vid="JER 49:22">نَ لْشْي عٍدٌن سّنبّمَيٍ لُمَ نّ</para>
  <para style="q" vid="JER 49:22">عَلْ فِنّ نَشٍيٍ نَ دِ بَرِقٍ.»<verse eid="JER 49:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="JER 49:23"/>مَسٍنيِ، نَشَن مَسٍنشِ دَ مَسِ بّ، نَ نَن يَ؛</para>
  <para style="q" vid="JER 49:23">«شَمَتَ نُن عَرَثَدِ بَرَ يَافِ،</para>
  <para style="q" vid="JER 49:23">بَرِ مَ عٍ بَرَ شِبَارُ حَاشِ مّ.</para>
  <para style="q" vid="JER 49:23">عٍ بْحّ بَرَ رَ مَشَ عَلْ مْرْنيِ نَشَن نَ بَا مَ،</para>
  <para style="q" vid="JER 49:23">نَشَن مُ نْمَ عَ رَشَرَدٍ.<verse eid="JER 49:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JER 49:24"/>دَ مَسِ سّنبّ بَرَ حْن، عَ وَ مَ عَ فِقٍ فَاشُي كُي.</para>
  <para style="q" vid="JER 49:24">كْنتْقِلِ نُن تْورّ بَرَ عَ سُشُ عَلْ فِنّ نَشَن نَ دِ بَرِقٍ.<verse eid="JER 49:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JER 49:25"/>نَ تَا تٌقَنيِ ﭑ نُ حّلّشِنشِ نَشَن نَ،</para>
  <para style="q" vid="JER 49:25">نَ بَرَ قِندِ تَا رَبّحِنشِ رَ؟<verse eid="JER 49:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JER 49:26"/>نَ لْشْي، نَا قٌنِكٍيٍ بِرَ مَ نّ تَا كُي،</para>
  <para style="q" vid="JER 49:26">نَا سْورِيٍ قَن دُندُ.</para>
  <para style="q" vid="JER 49:26">مَنفّ عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="JER 49:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="JER 49:27"/>ﭑ تّ سَمَ نّ دَ مَسِ تّتّ مَ،</para>
  <para style="q" vid="JER 49:27">بٍن هَدَدَ شَ يِرٍ مَكَنتَشِ فَن.»<verse eid="JER 49:27"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="28" style="v" sid="JER 49:28"/>مَسٍنيِ نَن يَ كٍدَرِ نُن شَسٌرِ شَ مَنفّيَ شَ قٍ رَ،</para>
  <para style="q" vid="JER 49:28">بَبِلْن مَنفّ نٍبُكَدَنسَرِ نَشَن فٍرٍشِ؛</para>
  <para style="q" vid="JER 49:28">عَلَتَلَ بَرَ عَ مَسٍن،</para>
  <para style="q" vid="JER 49:28">«وٌ كٍلِ، وٌ شَ كٍدَرِ فٍرٍ.</para>
  <para style="q" vid="JER 49:28">وٌ شَ حَمَنّ كَنَ نَشَن نَ قُفٍ رَ.<verse eid="JER 49:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="JER 49:29"/>وٌ شَ عٍ شَ كِرِ بَنشِيٍ، عٍ شَ شُرُ سٍيٍ،</para>
  <para style="q" vid="JER 49:29">عٍ شَ كٌتٍ بِرِن، نُن عٍ شَ حْشْمّيٍ سُشُ.</para>
  <para style="q" vid="JER 49:29">وٌ شَ عَ قَلَ عٍ بّ،</para>
  <para style="q" vid="JER 49:29">‹قٍ شْرْشْي نَ وٌ لِقٍ يِرٍ بِرِن.›<verse eid="JER 49:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="JER 49:30"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 49:30">شَسٌرِكَيٍ، وٌ شَ وٌ فِ،</para>
  <para style="q" vid="JER 49:30">وٌ شَ يِلِ فٍ وٌ وٌ نْشُنمَ دّننَشّ،</para>
  <para style="q" vid="JER 49:30">بَرِ مَ بَبِلْن مَنفّ نٍبُكَدَنسَرِ بَرَ نَتّ تٌنفٌ وٌ شَ قٍ رَ،</para>
  <para style="q" vid="JER 49:30">عَ بَرَ عَ حَنِفٍ عَ شَ وٌ فٍرٍ.»<verse eid="JER 49:30"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="31" style="v" sid="JER 49:31"/>عَلَتَلَ بَرَ عَ مَسٍن،</para>
  <para style="q" vid="JER 49:31">«وٌ كٍلِ، وٌ شَ سِ ندٍ فٍرٍ نَشَن بْحّ سَشِ.</para>
  <para style="q" vid="JER 49:31">عَ شَ نَادّيٍ مُ بَلَنشِ، عَ يِرٍيٍ مُ مَكَنتَشِ.</para>
  <para style="q" vid="JER 49:31">عَ نَ عَ كٍرٍنيِ نَن مَ.<verse eid="JER 49:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="JER 49:32"/>وٌ قَمَ نّ عٍ شَ حْشْمّيٍ نُن عٍ شَ شُرُ سٍ وُيَشِيٍ سْتْدٍ.</para>
  <para style="q" vid="JER 49:32">يِ مِشِ نَشٍيٍ عٍ دّ شَبٍ سّيتِ بِمَ،</para>
  <para style="q" vid="JER 49:32">ﭑ عٍ رَلْيمَ نّ قٌيٍ كُي، عٍ شَ تْورْ يِرٍ بِرِن.<verse eid="JER 49:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="JER 49:33"/>شَسٌرِ قِندِ مَ نّ وُلَءِ بَرٍ يِرٍ رَ، فبَلٌي نَ دّننَشّ.</para>
  <para style="q" vid="JER 49:33">مِشِ يٌ مُ سَبَتِمَ مّننِ سْنْن.»<verse eid="JER 49:33"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="34" style="v" sid="JER 49:34"/>عَلَتَلَ نَن يِ مَسٍنيِ تِشِ عَننَبِ يٍرٍ مِ بّ عٍلَمَ شَ قٍ رَ</para>
  <para style="q" vid="JER 49:34">يُدَيَ مَنفّ سٍدٍكِيَ شَ مَنفّيَ قْلّ تّمُي؛<verse eid="JER 49:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="JER 49:35"/>مَنفّ عَلَتَلَ بَرَ عَ مَسٍن،</para>
  <para style="q" vid="JER 49:35">«ﭑ عٍلَمَ شَ شَلِ كَنَمَ نّ، نَشَن قِندِشِ عَ سّنبّ رَ.<verse eid="JER 49:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="JER 49:36"/>ﭑ فٍرٍ تِمَ نّ عَ بّ يِرٍ بِرِن، ﭑ شَ عَ رَلْي قٌيٍ كُي.</para>
  <para style="q" vid="JER 49:36">نَ فٍرٍ دَنفِ شَنبِ، سِ بِرِن قَمَ نّ فِ مِشِ ندٍ سْتْدٍ كٍلِقٍ عٍدٌن.<verse eid="JER 49:36"/></para>
  <para style="q">
    <verse number="37" style="v" sid="JER 49:37"/>ﭑ قَمَ نّ عٍلَمَكَيٍ رَ سّرّندٍ عٍ يَشُييٍ يَ رَ</para>
  <para style="q" vid="JER 49:37">نَشٍيٍ وَ مَ عٍ قَشَقٍ.</para>
  <para style="q" vid="JER 49:37">ﭑ عٍ حَشَنكَتَمَ نّ ﭑ مَ شْنّ كُي،</para>
  <para style="q" vid="JER 49:37">ﭑ مَ سَنتِدّفّمَ قَ عٍ بِرِن سْنتْدٍ.</para>
  <para style="q" vid="JER 49:37">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="JER 49:37"/></para>
  <para style="q">
    <verse number="38" style="v" sid="JER 49:38"/>ﭑ مَ كِبَنيِ لُمَ نّ عٍلَمَ،</para>
  <para style="q" vid="JER 49:38">ﭑ عٍ شَ مَنفّ نُن عٍ شَ كُنتِفِيٍ قَشَ.</para>
  <para style="q" vid="JER 49:38">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="JER 49:38"/></para>
  <para style="q">
    <verse number="39" style="v" sid="JER 49:39"/>كْنْ وَشَتِ دْنشْي رَ،</para>
  <para style="q" vid="JER 49:39">ﭑ مَن عٍدٌنكَيٍ رَفبِلٍنمَ نّ كٍلِقٍ كٌنيِيَ كُي.</para>
  <para style="q" vid="JER 49:39">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.»<verse eid="JER 49:39"/></para>
  <chapter eid="JER 49"/>
  <chapter number="50" style="c" sid="JER 50"/>
  <para style="s">مَسٍنيِ بَبِلْن بّ</para>
  <para style="q">
    <verse number="1" style="v" sid="JER 50:1"/>عَلَتَلَ شَ مَسٍنيِ عَ نَشَن قِشِ عَننَبِ يٍرٍ مِ مَ بَبِلْنكَيٍ شَ قٍ رَ،</para>
  <para style="q" vid="JER 50:1">نَشٍيٍ نَ كَلِدِ بْشِ مَ.<verse eid="JER 50:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JER 50:2"/>«وٌ شَ عَ قَلَ سِ بِرِن بّ، وٌ شَ عٍ رَكٌلٌن عَ رَ،</para>
  <para style="q" vid="JER 50:2">وٌ شَ تْنشُمَ تِ نَ شَ قٍ رَ، وٌ نَشَ عَ نْشُن.</para>
  <para style="q" vid="JER 50:2">وٌ شَ عَ قَلَ، ‹بَبِلْن بَرَ سُشُ،</para>
  <para style="q" vid="JER 50:2">عَ شَ عَلَ كُيٍ بٍلِ نُن مٍرٌدَكِ بَرَ يَافِ، عٍ بَرَ فَاشُ،<verse eid="JER 50:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JER 50:3"/>بَرِ مَ سِ ندٍ كٍلِقٍ كْولَ مَ، نَ تٍقٍ عٍ شِلِ مَ.</para>
  <para style="q" vid="JER 50:3">سِ نَن عَ رَ نَشَن قِندِشِ فبَلٌي رَبَ رَ،</para>
  <para style="q" vid="JER 50:3">مِشِ يٌ، سُبٍ يٌ، سٍسٍ مُ لُشِ سْنْن، عٍ بِرِن بَرَ عٍ فِ.›»<verse eid="JER 50:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="JER 50:4"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 50:4">«نَ وَشَتِ عِسِرَيِلَكَيٍ نُن يُدَيَكَيٍ فبِلٍنمَ نّ.</para>
  <para style="q" vid="JER 50:4">عٍ قَمَ نّ وَ رَ، عٍ عٍ مَرِفِ عَلَتَلَ قٍن.<verse eid="JER 50:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JER 50:5"/>عٍ مَشْرِنيِ تِمَ نّ سِيٌن شَ قٍ رَ،</para>
  <para style="q" vid="JER 50:5">عٍ عٍ شُنتِ نَا رَ.</para>
  <para style="q" vid="JER 50:5">‹وٌن شّي، وٌن شَ سَاتّ شِرِ وٌن نُن عَلَتَلَ تَفِ،</para>
  <para style="q" vid="JER 50:5">سَاتّ نَشَن مُ نّيمُمَ وٌن نَ سْنْن.›<verse eid="JER 50:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JER 50:6"/>ﭑ مَ حَمَ نُ لُشِ نّ عَلْ شُرُ سٍ لْيشِيٍ.</para>
  <para style="q" vid="JER 50:6">عٍ كَنتَمَيٍ بَرَ عٍ رَلْي فٍيَيٍ قَرِ.</para>
  <para style="q" vid="JER 50:6">عٍ نُ تٍ، عٍ نُ فٌرٌ، عٍ مُ عَ كٌلٌن عٍ نَ دّدّ.<verse eid="JER 50:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JER 50:7"/>نَشٍيٍ نَ عٍ تٌ، عٍ عٍ تْورْ.</para>
  <para style="q" vid="JER 50:7">عٍ يَشُييٍ بَرَ عَ قَلَ، ‹مُشُ قْشِ مُ عَ رَ.</para>
  <para style="q" vid="JER 50:7">عٍ يِ سْتْشِ نّ بَرِ مَ عٍ بَرَ يُنُبِ رَبَ عَلَتَلَ رَ،</para>
  <para style="q" vid="JER 50:7">نَشَن نُ بَرَ تِنشِنيِ مَسٍن عٍ بّ،</para>
  <para style="q" vid="JER 50:7">عٍ بَبَيٍ شَشِلِ نُ تِشِ نَشَن نَ.›»<verse eid="JER 50:7"/></para>
  <para style="sp">عَلَتَلَ شَ مَسٍنيِ عِسِرَيِلَكَيٍ بّ</para>
  <para style="q">
    <verse number="8" style="v" sid="JER 50:8"/>«وٌ وٌ فِ، وٌ شَ مِنِ بَبِلْن،</para>
  <para style="q" vid="JER 50:8">وٌ مِنِ كَلِدِ بْشِ رَ.</para>
  <para style="q" vid="JER 50:8">وٌ شَ لُ عَلْ سِكْتّ نَشَن تِشِ شُرُ سٍيٍ يَ رَ.<verse eid="JER 50:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JER 50:9"/>ﭑ تَن يَتِ سِيٍ رَكٍلِمَ نّ بَبِلْن شِلِ مَ، كٍلِقٍ كْولَ مَ.</para>
  <para style="q" vid="JER 50:9">عٍ قَمَ نّ فٍرٍ شْرْشْي تِدٍ عٍ بّ.</para>
  <para style="q" vid="JER 50:9">عٍ شَ تَنبّيٍ سّنبّ فبٌ، عٍ شَ فٍرٍ سْونّيَمَ نّ.<verse eid="JER 50:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JER 50:10"/>كَلِدِ بْشِ قَمَ نّ كَنَدٍ،</para>
  <para style="q" vid="JER 50:10">عٍ يَشُييٍ قَ عٍ وَشْنسٍ تٌنفٌدٍ.</para>
  <para style="q" vid="JER 50:10">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.»<verse eid="JER 50:10"/></para>
  <para style="sp">عَلَتَلَ شَ مَسٍنيِ بَبِلْن بّ</para>
  <para style="q">
    <verse number="11" style="v" sid="JER 50:11"/>«عِيٌ، وٌ شَ سّيوَ، وٌ شَ حّلّشِن،</para>
  <para style="q" vid="JER 50:11">وٌ تَن نَشٍيٍ بَرَ ﭑ كّ شُن نَكَنَ.</para>
  <para style="q" vid="JER 50:11">عِيٌ، وٌ شَ تُفَن عَلْ نِنفٍيٍ،</para>
  <para style="q" vid="JER 50:11">وٌ شَ وٌ شُي رَ مِنِ عَلْ سٌييٍ.<verse eid="JER 50:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JER 50:12"/>وٌ نفَ بَرَ يَافِ،</para>
  <para style="q" vid="JER 50:12">نَشَن وٌ بَرِشِ عَ بَرَ لُ يَافِ كُي.</para>
  <para style="q" vid="JER 50:12">عَ بَرَ قِندِ سِ دْنشْي رَ،</para>
  <para style="q" vid="JER 50:12">عَ شَ بْشِ بَرَ قِندِ فبٍنفبٍرٍنيِ رَ، يِرٍ مَشَرَشِ رَ.<verse eid="JER 50:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JER 50:13"/>عَلَتَلَ بَرَ شْنْ عَ مَ، عَ شَ بْشِ مُ رَ سَبَتِمَ سْنْن.</para>
  <para style="q" vid="JER 50:13">عَ بَرَ قِندِ فبَلٌي يِرٍ رَ.</para>
  <para style="q" vid="JER 50:13">مِشِ نَشَن نّ دَنفِمَ نَا، نَ كَنيِ دّ عِشَرَ مَ نّ،</para>
  <para style="q" vid="JER 50:13">عٍ كَابَ نَ فبَلٌي مَ.»<verse eid="JER 50:13"/></para>
  <para style="sp">عَلَتَلَ شَ مَسٍنيِ بَبِلْن يَشُييٍ بّ</para>
  <para style="q">
    <verse number="14" style="v" sid="JER 50:14"/>«وٌ شَ تِ بَبِلْن يَ رَ فٍرٍ كِ مَ.</para>
  <para style="q" vid="JER 50:14">شَلِ كَنيِيٍ، وٌ شَ تَنبّيٍ وٌلِ عٍ مَ.</para>
  <para style="q" vid="JER 50:14">وٌ شَ فٍرٍ تِ سّنبّ رَ،</para>
  <para style="q" vid="JER 50:14">بَرِ مَ عَ بَرَ يُنُبِ رَبَ عَلَتَلَ رَ.<verse eid="JER 50:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JER 50:15"/>وٌ شَ سْنشْي رَتٍ عَ مَ.</para>
  <para style="q" vid="JER 50:15">عَ وَ مَ عَ يّتّ نَن قِقٍ وٌ مَ، عَ شَ بَنشِيٍ بَرَ كَنَ،</para>
  <para style="q" vid="JER 50:15">عَ شَ تّتّ بَرَ بِرَ عَلَتَلَ فبٍحْشْي سَابُي رَ.</para>
  <para style="q" vid="JER 50:15">وٌ قَن شَ وٌ فبٍحْشْ.</para>
  <para style="q" vid="JER 50:15">وٌ شَ عَ رَبَ عَ رَ عَلْ عَ عَ رَبَشِ وٌ رَ كِ نَشّ.<verse eid="JER 50:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 50:16"/>وٌ شَ شّي سَيٍ نُن شّي شَبَمَيٍ قَشَ بَبِلْن.</para>
  <para style="q" vid="JER 50:16">سَنتِدّفّمَ شَ عَ نِيَ عٍ بِرِن شَ عٍ فِ عٍ شْنيِ مَ.<verse eid="JER 50:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 50:17"/>عِسِرَيِلَ لُشِ نّ عَلْ شُرُ سٍ لْيشِ، يّتّ بَرَ نَشٍيٍ كٍرِ.</para>
  <para style="q" vid="JER 50:17">عَسِرِ مَنفّ نَن سِنفٍ عَ تْورْ،</para>
  <para style="q" vid="JER 50:17">بَبِلْن مَنفّ قَن قَ عَ هَلَكِ عَ دْنشْي رَ.»<verse eid="JER 50:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="JER 50:18"/>نَ نَن عَ رَ عِسِرَيِلَ مَرِفِ عَلَتَلَ عَ مَسٍنشِ،</para>
  <para style="q" vid="JER 50:18">«ﭑ بَبِلْن مَنفّ نُن عَ شَ حَمَ حَشَنكَتَمَ نّ</para>
  <para style="q" vid="JER 50:18">عَلْ ﭑ عَ رَبَشِ عَسِرِيَ مَنفّ رَ كِ نَشّ.<verse eid="JER 50:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JER 50:19"/>ﭑ عِسِرَيِلَ رَفبِلٍنمَ نّ عَ شْنيِ،</para>
  <para style="q" vid="JER 50:19">عَ شَ فْورّ مَن شَ لُ كَرٍ مٍلٍ نُن بَسَن،</para>
  <para style="q" vid="JER 50:19">عَ شَ وَ سَ قٍ قَنيِ رَ عٍقِرَ مِ نُن فَلَدِ فٍيَيٍ قَرِ.<verse eid="JER 50:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JER 50:20"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="JER 50:20">نَ وَشَتِ ﭑ دِحّمَ نّ عِسِرَيِلَ شَ يُنُبِيٍ مَ،</para>
  <para style="q" vid="JER 50:20">ﭑ دِحّ يُدَيَ شَ يُنُبِيٍ قَن مَ،</para>
  <para style="q" vid="JER 50:20">بَرِ مَ ﭑ بَرَ مِشِ دْنشْي شَ يُنُبِيٍ شَقَرِ.»<verse eid="JER 50:20"/></para>
  <para style="sp">عَلَتَلَ شَ مَسٍنيِ بَبِلْن يَشُييٍ بّ</para>
  <para style="q">
    <verse number="21" style="v" sid="JER 50:21"/>«وٌ تٍ مٍرَتَيِمِ بْشِ مَ ثٍكٌدِكَيٍ شِلِ مَ.</para>
  <para style="q" vid="JER 50:21">وٌ شَ عٍ رَتْن، وٌ شَ ﭑ مَ يَامَرِ بِرِن نَكَمَلِ.<verse eid="JER 50:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JER 50:22"/>فٍرٍ سْنشْي نَ عٍ شَ بْشِ مَ، فبَلٌي نَ عَ رَ.<verse eid="JER 50:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JER 50:23"/>بَبِلْن سّنبّمَ بَرَ كَنَ،</para>
  <para style="q" vid="JER 50:23">نَشَن نُ لُشِ عَلْ دّرّ مَ دُنِحَ بِرِن كُي.</para>
  <para style="q" vid="JER 50:23">يَكْسِ عَ بَرَ قِندِ فبَلٌي يِرٍ رَ.<verse eid="JER 50:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JER 50:24"/>ﭑ بَرَ بَبِلْن سُشُ فَنتَنيِ رَ عَ مُ نَشَن تٌشِ.</para>
  <para style="q" vid="JER 50:24">ﭑ بَرَ عِ تٌ، ﭑ بَرَ عِ مَسْتْ بَرِ مَ عَلَ مَتَندِ نَن نُ عِ رَ.<verse eid="JER 50:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JER 50:25"/>عَلَتَلَ نَن فٍرٍ سٌشِ بَبِلْن عَ شَ شْنّ كُي.</para>
  <para style="q" vid="JER 50:25">مَنفّ عَلَتَلَ نَ وَلِقٍ كَلِدِ بْشِ مَ.<verse eid="JER 50:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JER 50:26"/>دُنِحَ بِرِن شَ قَ بَبِلْن،</para>
  <para style="q" vid="JER 50:26">وٌ شَ عٍ شَ بَنشِيٍ رَبِ عٍ سَنسِ بٌفِيٍ رَفَتَمَ دّننَشّ.</para>
  <para style="q" vid="JER 50:26">نَ بِرِن شَ رَتْن، سٍسٍ نَشَ لُ.<verse eid="JER 50:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="JER 50:27"/>وٌ شَ عٍ شَ تُورَيٍ بِرِن كْن نَشَبَ شُرُ سٍ كْن نَشَبَمَ دّننَشّ.</para>
  <para style="q" vid="JER 50:27">حَشَنكَتّ نَ عٍ بّ، عٍ شَ كِيتِ وَشَتِ بَرَ عَ لِ.<verse eid="JER 50:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="JER 50:28"/>مِشِ نَشٍيٍ كٍلِشِ بَبِلْن كٌنيِيَ كُي،</para>
  <para style="q" vid="JER 50:28">عٍ نَ مَسٍنيِ تِقٍ سِيٌن،</para>
  <para style="q" vid="JER 50:28">‹مُشُ مَرِفِ عَلَتَلَ بَرَ عَ فبٍحْشْ،</para>
  <para style="q" vid="JER 50:28">عَ بَرَ عَ شَ هْرْ مْلِنفِرَ فبٍحْشْ.›<verse eid="JER 50:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="JER 50:29"/>شَلِ كَنيِيٍ شَ قَ بَبِلْن شِلِ مَ،</para>
  <para style="q" vid="JER 50:29">نَشٍيٍ قَتَ تَنبّ وٌلِدٍ.</para>
  <para style="q" vid="JER 50:29">وٌ شَ بَبِلْن نَبِلِن، مِشِ يٌ نَشَ مِنِ.</para>
  <para style="q" vid="JER 50:29">وٌ شَ عَ شَ كّوَلِ سَرٍ رَفبِلٍن عَ مَ،</para>
  <para style="q" vid="JER 50:29">وٌ شَ عَ رَبَ عَ رَ عَلْ عَ رَبَشِ مِشِ فبّتّ رَ كِ نَشّ.</para>
  <para style="q" vid="JER 50:29">عَ بَرَ عَ يّتّ عِفبٌ عَلَتَلَ مَ، عِسِرَيِلَ سّنِيّنتْي.<verse eid="JER 50:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="JER 50:30"/>نَ نَن عَ رَ عَ شَ قٌنِكٍيٍ قَمَ بِرَدٍ تَا كُي،</para>
  <para style="q" vid="JER 50:30">عَ شَ سْورِيٍ دُندُ نَ تّمُي.</para>
  <para style="q" vid="JER 50:30">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.»<verse eid="JER 50:30"/></para>
  <para style="sp">عَلَتَلَ شَ مَسٍنيِ بَبِلْن بّ</para>
  <para style="q">
    <verse number="31" style="v" sid="JER 50:31"/>«عِ تَن يّتّ عِفبٌي،</para>
  <para style="q" vid="JER 50:31">ﭑ شَ عِ حَشَنكَتَ.</para>
  <para style="q" vid="JER 50:31">عِ شَ كِيتِ لْشْي بَرَ عَ لِ.</para>
  <para style="q" vid="JER 50:31">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.»<verse eid="JER 50:31"/></para>
  <para style="sp">عَلَتَلَ شَ مَسٍنيِ</para>
  <para style="q">
    <verse number="32" style="v" sid="JER 50:32"/>«نَ يّتّ عِفبٌي بِرَ مَ نّ، مِشِ يٌ مُ عَ رَكٍلِمَ.</para>
  <para style="q" vid="JER 50:32">ﭑ عَ شَ تَايٍ فَنمَ نّ، ﭑ عَ رَبِلِنيِ بِرِن كَنَ.<verse eid="JER 50:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="JER 50:33"/>مَنفّ عَلَتَلَ بَرَ عَ مَسٍن،</para>
  <para style="q" vid="JER 50:33">عِسِرَيِلَكَيٍ نُن يُدَيَكَيٍ نَ حَشَنكَتّ كُي.</para>
  <para style="q" vid="JER 50:33">مِشِ نَشٍيٍ عٍ رَ سٌشِ كٌنيِيَ كُي عٍ تٌندِ مَ نّ عٍ رَبّحِندٍ.<verse eid="JER 50:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="JER 50:34"/>كْنْ عٍ شُنسَرَ مَ سّنبّ فبٌ، عَ شِلِ مَنفّ عَلَتَلَ.</para>
  <para style="q" vid="JER 50:34">عَ عٍ شُن مَقَلَمَ نّ عَلَكٌ عٍ شَ بْحّسَ سْتْ،</para>
  <para style="q" vid="JER 50:34">بَبِلْنكَيٍ شُن شَ رَكَنَ.<verse eid="JER 50:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="JER 50:35"/>سَنتِدّفّمَ شَ كَلِدِكَيٍ قَشَ،</para>
  <para style="q" vid="JER 50:35">عَ شَ بَبِلْنكَيٍ، عٍ شَ كُنتِفِيٍ، نُن عٍ شَ كَرَ مْشْي سْنتْ.<verse eid="JER 50:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="JER 50:36"/>سَنتِدّفّمَ شَ عٍ شَ نَمِحْنمّ وُلٍ قَلّيٍ قَشَ.</para>
  <para style="q" vid="JER 50:36">شَشِلِتَرٍيٍ نَن عٍ رَ.</para>
  <para style="q" vid="JER 50:36">سَنتِدّفّمَ شَ عٍ شَ سْورِيٍ قَشَ.</para>
  <para style="q" vid="JER 50:36">عٍ شَ لُ فَاشُي كُي.<verse eid="JER 50:36"/></para>
  <para style="q">
    <verse number="37" style="v" sid="JER 50:37"/>سَنتِدّفّمَ شَ عٍ شَ سٌييٍ قَشَ،</para>
  <para style="q" vid="JER 50:37">عَ شَ عٍ شَ سْورِ رَفِسٍيٍ كَنَ.</para>
  <para style="q" vid="JER 50:37">سَنتِدّفّمَ شَ عٍ شَ سْورِ سَرَشِيٍ قَشَ.</para>
  <para style="q" vid="JER 50:37">عٍ شَ لُ عَلْ فِنّيٍ.</para>
  <para style="q" vid="JER 50:37">سَنتِدّفّمَ شَ عٍ شَ نَاقُلِ كَنَ، عٍ شَ شَنِن.<verse eid="JER 50:37"/></para>
  <para style="q">
    <verse number="38" style="v" sid="JER 50:38"/>عٍ شَ شُرٍيٍ شَ شْرِ.</para>
  <para style="q" vid="JER 50:38">كُيٍ بْشِ نَ عَ رَ.</para>
  <para style="q" vid="JER 50:38">كُيٍيٍ نَن مِشِ مَدَشُمَ.<verse eid="JER 50:38"/></para>
  <para style="q">
    <verse number="39" style="v" sid="JER 50:39"/>نَ نَن عَ رَ وُلَءِ سُبٍيٍ لُمَ نَا،</para>
  <para style="q" vid="JER 50:39">وُلَءِ بَرٍيٍ، بَرَتّيٍ، نُن شْنِ حَاشِيٍ.</para>
  <para style="q" vid="JER 50:39">مِشِ يٌ مُ سَبَتِمَ نَا سْنْن.<verse eid="JER 50:39"/></para>
  <para style="q">
    <verse number="40" style="v" sid="JER 50:40"/>عَ لُمَ نّ عَلْ سٌدٌ مَ نُن فٌمٌرَ عَلَ نَشَن كَنَ.</para>
  <para style="q" vid="JER 50:40">مِشِ مُ تٌمَ نَا، عَدَ مَدِ يٌ مُ سَبَتِمَ نَا.</para>
  <para style="q" vid="JER 50:40">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.»<verse eid="JER 50:40"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="41" style="v" sid="JER 50:41"/>«حَمَ نَ قَقٍ كٍلِقٍ كْولَ مَ.</para>
  <para style="q" vid="JER 50:41">سِ سّنبّمَ نَ عَ رَ، نَشَن شَ مَنفّيٍ نَ دُنِحَ يِرٍ بِرِن.<verse eid="JER 50:41"/></para>
  <para style="q">
    <verse number="42" style="v" sid="JER 50:42"/>شَلِ نُن تَنبّ نَ عٍ يِ رَ.</para>
  <para style="q" vid="JER 50:42">عٍ حَاشُ، عٍ مُ كِنِكِنِ كٌلٌن.</para>
  <para style="q" vid="JER 50:42">عٍ شُي فبٌ عَلْ مْرْنيِ شُي.</para>
  <para style="q" vid="JER 50:42">عٍ حّرّ مَ سٌي نَن قَرِ، عٍ قَتَ فٍرٍ رَ.</para>
  <para style="q" vid="JER 50:42">عٍ نَ قَقٍ بَبِلْن نَن قْشْ رَ.<verse eid="JER 50:42"/></para>
  <para style="q">
    <verse number="43" style="v" sid="JER 50:43"/>بَبِلْن مَنفّ تٌ نَ مّ،</para>
  <para style="q" vid="JER 50:43">عَ سّنبّ نَشَ كَنَ، عَ بْحّ نَشَ فَاشُ،</para>
  <para style="q" vid="JER 50:43">عَلْ فِنّ نَشَن نَ دِ بَرِقٍ.<verse eid="JER 50:43"/></para>
  <para style="q">
    <verse number="44" style="v" sid="JER 50:44"/>ﭑ لُمَ نّ عَلْ يّتّ نَشَن كٍلِمَ يُرُدّن شُرٍ قّ مَ،</para>
  <para style="q" vid="JER 50:44">عَ سِفَ سُبٍ قٍندٍ يِرٍ فبّتّ.</para>
  <para style="q" vid="JER 50:44">ﭑ بَبِلْن كٍرِ مَ نّ عَ شْنيِ، ﭑ قَ مَنفّ سُفَندِشِ تِ عَ شُن.</para>
  <para style="q" vid="JER 50:44">ندٍ مَنِيَ ﭑ نَ؟ ندٍ ﭑ نَسِمَ؟</para>
  <para style="q" vid="JER 50:44">ندٍ نْمَ ﭑ نَتٌندِدٍ؟<verse eid="JER 50:44"/></para>
  <para style="q">
    <verse number="45" style="v" sid="JER 50:45"/>نَ كُي وٌ شَ وٌ تُلِ مَتِ عَلَتَلَ شَ نَتّ رَ،</para>
  <para style="q" vid="JER 50:45">عَ نَشَن تٌنفٌشِ بَبِلْن شِلِ مَ،</para>
  <para style="q" vid="JER 50:45">عَ نَشَن حَنِفٍشِ كَلِدِ شَ بْشِ شَ قٍ رَ.</para>
  <para style="q" vid="JER 50:45">عَ عٍ شَنِنمَ نّ عَلْ شُرُ سٍيٍ، عَ قَ عٍ شْنيِ كَنَ.<verse eid="JER 50:45"/></para>
  <para style="q">
    <verse number="46" style="v" sid="JER 50:46"/>دُنِحَ نَ عَ كٌلٌن عَ بَبِلْن بَرَ سُشُ،</para>
  <para style="q" vid="JER 50:46">عٍ سّرّنمَ نّ، عٍ قَ لُ فَاشُي كُي.»<verse eid="JER 50:46"/></para>
  <chapter eid="JER 50"/>
  <chapter number="51" style="c" sid="JER 51"/>
  <para style="s">بَبِلْن رَحْنيِ</para>
  <para style="sp">عَلَتَلَ شَ مَسٍنيِ</para>
  <para style="q">
    <verse number="1" style="v" sid="JER 51:1"/>عَلَتَلَ بَرَ عَ مَسٍن،</para>
  <para style="q" vid="JER 51:1">«ﭑ تُرُننَادّ شّيمَ نّ بَبِلْن شِلِ مَ،<verse eid="JER 51:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JER 51:2"/>تُرُننَادّ نَشَن قِندِشِ عَ يَشُييٍ رَ.</para>
  <para style="q" vid="JER 51:2">عٍ قَمَ نّ عَ رَيٍنسٍندٍ قٌيٍ كُي،</para>
  <para style="q" vid="JER 51:2">عٍ عَ هَرِفٍ بِرِن بَ عَ يِ رَ،</para>
  <para style="q" vid="JER 51:2">عٍ تِ عَ كَنكٍ عَ يِرٍ بِرِن.<verse eid="JER 51:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JER 51:3"/>شَلِ وٌلِ شَ عَ كَنكٍ مَكَنتَسٍ تٌنفٌ.</para>
  <para style="q" vid="JER 51:3">عَ نَشَ كِنِكِنِ بَبِلْن سّفّتَلَيٍ مَ، عَ شَ عٍ سْنتْ.<verse eid="JER 51:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JER 51:4"/>كَلِدِكَ قَشَشِيٍ تٌمَ نّ عٍ شَ بْشِ مَ يِرٍ بِرِن،</para>
  <para style="q" vid="JER 51:4">عٍ رَبِرَشِ كِرَيٍ مَ، عٍ سْشْشِ عَ حَاشِ رَ.»<verse eid="JER 51:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="JER 51:5"/>«مَنفّ عَلَتَلَ مُ عِسِرَيِلَ نُن يُدَيَ رَبٌلٌمَ،</para>
  <para style="q" vid="JER 51:5">هَلِ عٍ شَ يُنُبِيٍ تٌ بَرَ فبٌ عٍ مَ عٍ شْنيِ عِسِرَيِلَ سّنِيّنتْي يَ شْرِ.<verse eid="JER 51:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JER 51:6"/>وٌ شَ كٍلِ بَبِلْن بْشِ مَ.</para>
  <para style="q" vid="JER 51:6">كَنكَن شَ عَ يّتّ رَكِسِ،</para>
  <para style="q" vid="JER 51:6">بَرِ مَ عَلَتَلَ قَمَ نّ عَ فبٍ حْشْدٍ،</para>
  <para style="q" vid="JER 51:6">عَ عٍ سَرٍ رَفبِلٍن عٍ مَ.<verse eid="JER 51:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JER 51:7"/>سِنفٍ، عَلَتَلَ نَن نُ قِندِشِ سَابُي رَ بَبِلْن بّ،</para>
  <para style="q" vid="JER 51:7">دُنِحَ بِرِن شَ حَشَنكَتَ، عٍ شَ مَدَشُ عَلْ سِيسِلَيٍ.<verse eid="JER 51:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JER 51:8"/>كْنْ يَكْسِ عَ فبٍ مُ لُشِ عَ شَ بِرَ، عَ شُن شَ رَكَنَ.</para>
  <para style="q" vid="JER 51:8">وٌ شَ عَ كُنقَ بَ،</para>
  <para style="q" vid="JER 51:8">وٌ شَ كَتَ سٍرِ سْتْدٍ عَ بّ عَلَكٌ عَ شَ يَلَن.»<verse eid="JER 51:8"/></para>
  <para style="sp">عِسِرَيِلَكَيٍ شَ مَسٍنيِ</para>
  <para style="q">
    <verse number="9" style="v" sid="JER 51:9"/>«وٌن بَرَ كَتَ بَبِلْن رَيَلَندٍ،</para>
  <para style="q" vid="JER 51:9">كْنْ عَ مُ سْونّيَشِ.</para>
  <para style="q" vid="JER 51:9">وٌن شَ عَ لُ نَا، وٌن شَ سِفَ وٌن شْنيِ،</para>
  <para style="q" vid="JER 51:9">بَرِ مَ عَ شَ يُنُبِيٍ بَرَ فبٌ يّ.<verse eid="JER 51:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JER 51:10"/>عَلَتَلَ بَرَ وٌن نَكِسِ تِنشِنيِ رَ.</para>
  <para style="q" vid="JER 51:10">وٌن شَ وٌن مَرِفِ عَلَتَلَ شَ كَابَنَكٌي دّنتّفّ سِيٌن.<verse eid="JER 51:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JER 51:11"/>تَنبّيٍ يَءِلَن، شَلِ سَسٍ رَقٍ.</para>
  <para style="q" vid="JER 51:11">عَلَتَلَ بَرَ عَ نِيَ مٍدٍ مَنفّ بْحّ شَ تٍ،</para>
  <para style="q" vid="JER 51:11">عَ شَ بَبِلْن حَشَنكَتَ عَ مَرِفِ بّ.</para>
  <para style="q" vid="JER 51:11">عَلَتَلَ فبٍحْشْي نَن نَ كِ عَ شَ هْرْ مْبَنشِ شَ قٍ رَ.<verse eid="JER 51:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JER 51:12"/>وٌ شَ تْنشُمَ رَتٍ بَبِلْن شَ تّتّ شِلِ مَ،</para>
  <para style="q" vid="JER 51:12">وٌ شَ سْورِيٍ شَ وُيَ، عٍ شَ عٍ يّتّ يَءِلَن فٍرٍ شِلِ مَ.</para>
  <para style="q" vid="JER 51:12">عَلَتَلَ قَمَ نّ عَ سَفٌ رَبَدٍ،</para>
  <para style="q" vid="JER 51:12">عَ عَ شَ نَتّ رَكَمَلِ بَبِلْنكَيٍ شِلِ مَ.»<verse eid="JER 51:12"/></para>
  <para style="sp">نَمِحْنمّ شَ مَسٍنيِ</para>
  <para style="q">
    <verse number="13" style="v" sid="JER 51:13"/>وٌ تَن بَبِلْنكَ نَاقُلِ كَنيِ نَشٍيٍ سَبَتِشِ شُرٍ دّ رَ،</para>
  <para style="q" vid="JER 51:13">وٌ حْن وَشَتِ بَرَ عَ لِ.<verse eid="JER 51:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JER 51:14"/>مَنفّ عَلَتَلَ بَرَ عَ كَلِ عَ يّتّ شِلِ رَ،</para>
  <para style="q" vid="JER 51:14">«ﭑ قَمَ نّ سْورِيٍ رَ وٌ شِلِ مَ،</para>
  <para style="q" vid="JER 51:14">عٍ وُيَ عَلْ تُفُمِ فَلِ، عٍ قَ سْنشْي بٍلٍبٍلٍ رَتٍ.»<verse eid="JER 51:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="JER 51:15"/>عَلَتَلَ دُنِحَ دَاشِ عَ سّنبّ نَن نَ،</para>
  <para style="q" vid="JER 51:15">عَ شَرٍ سَ عَ شَ لْننِ رَ،</para>
  <para style="q" vid="JER 51:15">عَ كٌورٍ عِتَلَ عَ شَ قٍ كٌلٌنيِ رَ.<verse eid="JER 51:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JER 51:16"/>عَ نَ فَلَنيِ رَبُلَ، تُنّ يٍ كٍلِمَ نّ كٌورٍ مَ،</para>
  <para style="q" vid="JER 51:16">نُشُي تٍ بْشِ شُن مَ.</para>
  <para style="q" vid="JER 51:16">عَ سٍيَمَكْنيِ رَ مِنِمَ تُنّ،</para>
  <para style="q" vid="JER 51:16">عَ قٌيٍ رَ مِنِ عَ كٍلِدٍ.<verse eid="JER 51:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JER 51:17"/>عَدَ مَدِ قِندِشِ شَشِلِتَرٍ نَن نَ نَشَن مُ قَهَامُي سْتْ،</para>
  <para style="q" vid="JER 51:17">شّيمَ شَبُي يَافِ سْتْمَ نّ عَ شَ كُيٍيٍ سَابُي رَ،</para>
  <para style="q" vid="JER 51:17">نَشٍيٍ قِندِشِ كُيٍ وُلٍ حّنفِتَرٍيٍ رَ.<verse eid="JER 51:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JER 51:18"/>سٍ قُقَقُ نَن نَ عٍ رَ، لْننِلَ يٌمَ نَشَن مَ.</para>
  <para style="q" vid="JER 51:18">عٍ قَمَ نّ حْندٍ عٍ شَ كِيتِ وَشَتِ.<verse eid="JER 51:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JER 51:19"/>عَننَبِ يَشُبَ مَرِفِ تَن مُ نَ كِ شّ،</para>
  <para style="q" vid="JER 51:19">بَرِ مَ دَالِ مَنفّ نَ عَ رَ نَشَن شِلِ عَلَتَلَ سّنبّمَ،</para>
  <para style="q" vid="JER 51:19">نَشَن عَ شَ حَمَ دَا عَ يّتّ بّ.<verse eid="JER 51:19"/></para>
  <para style="sp">عَلَتَلَ شَ مَسٍنيِ عِسِرَيِلَ بّ</para>
  <para style="q">
    <verse number="20" style="v" sid="JER 51:20"/>«عِ تَن قِندِشِ ﭑ مَ فٍرٍ سٌسٍ نَن نَ،</para>
  <para style="q" vid="JER 51:20">ﭑ سِيٍ رَيٍنسٍنمَ نَشَن نَ،</para>
  <para style="q" vid="JER 51:20">ﭑ مَنفّيَ شُن نَكَنَمَ نَشَن سَابُي رَ،<verse eid="JER 51:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JER 51:21"/>ﭑ سٌي نُن عَ رَفِمَ شَ قٍ دَنمَ نَشَن نَ،</para>
  <para style="q" vid="JER 51:21">ﭑ سْورِ رَفِسٍ كَنَمَ نَشَن سَابُي رَ،<verse eid="JER 51:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JER 51:22"/>ﭑ شّمّ نُن فِنّ سْنتْمَ نَشَن نَ،</para>
  <para style="q" vid="JER 51:22">ﭑ سّفّتَلَ نُن فِنّدِ مّدِ قَشَمَ نَشَن سَابُي رَ،<verse eid="JER 51:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JER 51:23"/>ﭑ شُرُ سٍيٍ نُن عَ دّ مَدٌنيِيٍ رَيٍنسٍنمَ نَشَن نَ،</para>
  <para style="q" vid="JER 51:23">ﭑ شّ سَيٍ نُن عٍ شَ نِنفٍ رَيٍنسٍنمَ نَشَن سَابُي رَ،</para>
  <para style="q" vid="JER 51:23">ﭑ مَنفّ نُن كُنتِفِيٍ رَيٍنسٍنمَ نَشَن نَ.<verse eid="JER 51:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JER 51:24"/>ﭑ سَرٍ رَفبِلٍنمَ نّ بَبِلْن بْشِ نُن بَبِلْنكَيٍ مَ،</para>
  <para style="q" vid="JER 51:24">عٍ شَ قٍ حَاشِيٍ شَ قٍ رَ عٍ نَشَن نَبَشِ سِيٌن نَ.</para>
  <para style="q" vid="JER 51:24">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="JER 51:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JER 51:25"/>ﭑ تِشِ عِ كَنكٍ، عِ تَن مَنفّيَ شُنفبٍ نَشَن دُنِحَ شُن نَكَنَ.</para>
  <para style="q" vid="JER 51:25">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.</para>
  <para style="q" vid="JER 51:25">ﭑ نَ ﭑ شْنيّ عِتَلَمَ نّ عِ شِلِ مَ،</para>
  <para style="q" vid="JER 51:25">ﭑ عِ رَدِن تٍنتٍنيِ رَ،</para>
  <para style="q" vid="JER 51:25">ﭑ عِ قِندِ فٍيَ رَ نَشَن كُي عِفٍلِ.<verse eid="JER 51:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JER 51:26"/>تِدٍ يٌ مُ لُمَ عِ مَ سْنْن، سٍسٍ مُ تِمَ عِ شْنيِ.</para>
  <para style="q" vid="JER 51:26">عِ مُ قِندِ مَ عَ رَ عَبَدَن.</para>
  <para style="q" vid="JER 51:26">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.»<verse eid="JER 51:26"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="27" style="v" sid="JER 51:27"/>«وٌ شَ تْنشُمَ رَتٍ دُنِحَ مَ.</para>
  <para style="q" vid="JER 51:27">وٌ شَ فٍرٍ سَرَ شُي رَ مِنِ سِيٍ تَفِ.</para>
  <para style="q" vid="JER 51:27">وٌ شَ كٍلِ، فٍرٍ شَ تِ بَبِلْن شِلِ مَ.</para>
  <para style="q" vid="JER 51:27">مَنفّيَ بِرِن شَ قَ كٍلِقٍ عَرَرَتِ، مِنِ، نُن عَسِكٍنَسِ.</para>
  <para style="q" vid="JER 51:27">سْورِ مَنفّ شَ سُفَندِ وٌ يَ مَ،</para>
  <para style="q" vid="JER 51:27">وٌ شَ سٌي شَ وُيَ عَلْ تُفُمِ فَلِ.<verse eid="JER 51:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="JER 51:28"/>سِيٍ شَ قَ فٍرٍ شِلِ مَ،</para>
  <para style="q" vid="JER 51:28">مٍدٍ شَ مَنفّيٍ نُن عَ شَ كُنتِفِيٍ،</para>
  <para style="q" vid="JER 51:28">عَ نُن عٍ يَمَرِ مَ حَمَنّ نَشٍيٍ مَ.<verse eid="JER 51:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="JER 51:29"/>بَبِلْن بْشِ سّرّنمَ نّ تْورّ كُي،</para>
  <para style="q" vid="JER 51:29">بَرِ مَ عَلَتَلَ شَ نَتّيٍ مُ كَنَمَ.</para>
  <para style="q" vid="JER 51:29">نَ بْشِ قَمَ نّ شُن نَكَنَدٍ،</para>
  <para style="q" vid="JER 51:29">مِشِ يٌ مُ سَبَتِمَ مّننِ سْنْن.<verse eid="JER 51:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="JER 51:30"/>بَبِلْن شَ سْورِيٍ مُ فٍرٍ تِمَ سْنْن،</para>
  <para style="q" vid="JER 51:30">عٍ لُمَ عٍ شَ يِرٍ كَنتَشِيٍ نَن كُي تُن.</para>
  <para style="q" vid="JER 51:30">عٍ سّنبّ بَرَ حْن، عٍ قَ لُشِ نّ عَلْ فِنّيٍ.</para>
  <para style="q" vid="JER 51:30">عٍ شَ بَنشِيٍ بِرِن فَنشِ، عٍ شَ تّتّ نَادّ كَنَشِ.<verse eid="JER 51:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="JER 51:31"/>شّيرَيٍ لُ رَ نّ قَ رَ مَنفّ شْنيِ،</para>
  <para style="q" vid="JER 51:31">عٍ عَ قَلَ عَ بّ عَ يَشُييٍ بَرَ دّننَشّ سُشُ.<verse eid="JER 51:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="JER 51:32"/>عٍ بَرَ شُرٍ عِفِرِدٍيٍ سُشُ،</para>
  <para style="q" vid="JER 51:32">عٍ بَرَ تّ سٌ شّيٍ رَ،</para>
  <para style="q" vid="JER 51:32">بَبِلْن سْورِيٍ بَرَ لُ فَاشُي كُي.<verse eid="JER 51:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="JER 51:33"/>ﭑ تَن عِسِرَيِلَ مَرِفِ عَلَتَلَ شَ مَسٍنيِ نَن يَ،</para>
  <para style="q" vid="JER 51:33">بَبِلْن تَا لُشِ نّ عَلْ لٌنيِ سَنسِ شْرِ بٌرٌنمَ دّننَشّ.</para>
  <para style="q" vid="JER 51:33">عَ شَ شّ شَبَ تّمُي نَ قَقٍ.»<verse eid="JER 51:33"/></para>
  <para style="sp">عِسِرَيِلَكَيٍ شَ مَسٍنيِ</para>
  <para style="q">
    <verse number="34" style="v" sid="JER 51:34"/>«بَبِلْن مَنفّ نٍبُكَدَنسَرِ بَرَ وٌن تْورْ،</para>
  <para style="q" vid="JER 51:34">عَ بَرَ وٌن شَشِلِ عِقُ،</para>
  <para style="q" vid="JER 51:34">عَ بَرَ وٌن لُ عَلْ بّكِ عِفٍلِ.</para>
  <para style="q" vid="JER 51:34">عَ لُشِ نّ عَلْ سُبٍ مَفَاشُشِ نَشَن بَرَ وٌن دٌن،</para>
  <para style="q" vid="JER 51:34">نَشَن لُفَ وٌن نَ، عَ وٌن بْشُن.<verse eid="JER 51:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="JER 51:35"/>عَ قٍ حَاشِ نَشَن نَبَشِ وٌن تَن سِيٌنكَيٍ رَ،</para>
  <para style="q" vid="JER 51:35">نَ شَ فبِلٍن بَبِلْن مَ.</para>
  <para style="q" vid="JER 51:35">عَ نِي نَشٍيٍ بَشِ دَرِ سَلَمُ،</para>
  <para style="q" vid="JER 51:35">نَ سَرٍ شَ فبِلٍن بَبِلْنكَيٍ مَ.»<verse eid="JER 51:35"/></para>
  <para style="sp">عَلَتَلَ شَ مَسٍنيِ</para>
  <para style="q">
    <verse number="36" style="v" sid="JER 51:36"/>نَ كُي عَلَتَلَ نَشّ،</para>
  <para style="q" vid="JER 51:36">«وٌ شَ عَ مَتٌ، ﭑ قَمَ نّ وٌ شُن مَقَلَدٍ،</para>
  <para style="q" vid="JER 51:36">ﭑ قَ وٌ فبٍ حْشْدٍ.</para>
  <para style="q" vid="JER 51:36">ﭑ بَبِلْن بَا شْرِ مَ نّ، ﭑ عَ شَ دُلٌنيِيٍ شَرَ مَ نّ.<verse eid="JER 51:36"/></para>
  <para style="q">
    <verse number="37" style="v" sid="JER 51:37"/>بَبِلْن قِندِ مَ نّ يِرٍ كَنَشِ رَ وُلَءِ بَرٍيٍ لُمَ دّننَشّ.</para>
  <para style="q" vid="JER 51:37">مِشِيٍ مُ تِنمَ لُدٍ نَ يِرٍ مَفَاشُشِ.<verse eid="JER 51:37"/></para>
  <para style="q">
    <verse number="38" style="v" sid="JER 51:38"/>عَ شَ حَمَ شَاحّشِ عَلْ يّتّيٍ،</para>
  <para style="q" vid="JER 51:38">عٍ عٍ شُي رَ مِنِمَ عَلْ يّتّ يْرّ،<verse eid="JER 51:38"/></para>
  <para style="q">
    <verse number="39" style="v" sid="JER 51:39"/>كْنْ عٍ نَ كٍلِ، ﭑ عٍ قِندِ مَ سِيسِلَيٍ نَن نَ،</para>
  <para style="q" vid="JER 51:39">نَشٍيٍ يٍلٍمَ هَن، كْنْ عٍ نَ شِ، عٍ مُ شُنُمَ سْنْن.</para>
  <para style="q" vid="JER 51:39">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.»<verse eid="JER 51:39"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="40" style="v" sid="JER 51:40"/>«ﭑ عٍ رَفٌرٌ مَ نّ عَلْ يّشّي نَشٍيٍ كْن نَشَبَمَ،</para>
  <para style="q" vid="JER 51:40">عَلْ يّشّي نُن سِ كٌنتٌنيِيٍ.<verse eid="JER 51:40"/></para>
  <para style="q">
    <verse number="41" style="v" sid="JER 51:41"/>بَبِلْن شُنفبٍ، دُنِحَ بِرِن نَشَن مَتْشْمَ،</para>
  <para style="q" vid="JER 51:41">نَ بِرَشِ دِ؟</para>
  <para style="q" vid="JER 51:41">مُنسٍ عَ نِيَشِ عَ شَ قِندِ فبَلٌي رَ سِيٍ تَفِ؟<verse eid="JER 51:41"/></para>
  <para style="q">
    <verse number="42" style="v" sid="JER 51:42"/>بَا قَمَ نّ عَ مَكٌتٌدٍ، مْرْنيِيٍ دِن عَ رَ.<verse eid="JER 51:42"/></para>
  <para style="q">
    <verse number="43" style="v" sid="JER 51:43"/>عَ شَ تَايٍ بّحِنمَ نّ، عٍ قِندِ فبٍنفبٍرٍنيِ رَ،</para>
  <para style="q" vid="JER 51:43">مِشِ مُ سَبَتِمَ دّننَشّ.</para>
  <para style="q" vid="JER 51:43">هَلِ بِيَاسِلَيٍ مُ لُمَ نَا.<verse eid="JER 51:43"/></para>
  <para style="q">
    <verse number="44" style="v" sid="JER 51:44"/>ﭑ عٍ شَ كُيٍ بٍلِ حَشَنكَتَمَ نّ،</para>
  <para style="q" vid="JER 51:44">ﭑ قَ عَ نِيَ عَ شَ مِشِيٍ بّحِن عَ نَشٍيٍ سْتْ.</para>
  <para style="q" vid="JER 51:44">مِشِيٍ مُ كٍلِمَ حَمَنّيٍ مَ قَقٍ عَ بَتُدٍ سْنْن.</para>
  <para style="q" vid="JER 51:44">بَبِلْن شَ تّتّ بِرَ مَ نّ كٍرٍنيِ رَ.»<verse eid="JER 51:44"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="45" style="v" sid="JER 51:45"/>«ﭑ مَ حَمَ، وٌ شَ كٍلِ نَا.</para>
  <para style="q" vid="JER 51:45">وٌ شَ وٌ فِ، بَرِ مَ عَلَتَلَ شَ شْنّ بُلَمَ مّننِ نّ.<verse eid="JER 51:45"/></para>
  <para style="q">
    <verse number="46" style="v" sid="JER 51:46"/>لِمَنِيَ نَشَ بَ وٌ يِ رَ،</para>
  <para style="q" vid="JER 51:46">وٌ نَشَ فَاشُ وْيّنيِ رَ نَشٍيٍ قَمَ مّدٍ نَا.</para>
  <para style="q" vid="JER 51:46">وْيّنيِ لُمَ قَلَ رَ نّ سّنبّمَيٍ شَ قٍ رَ نُن فٍرٍ شَ قٍ رَ.<verse eid="JER 51:46"/></para>
  <para style="q">
    <verse number="47" style="v" sid="JER 51:47"/>وَشَتِ قَمَ عَ لِدٍ ﭑ بَبِلْن شَ كُيٍيٍ حَشَنكَتَمَ تّمُي نَشّ.</para>
  <para style="q" vid="JER 51:47">عَ شَ بْشِ بِرِن لُمَ يَافِ كُي نَ تّمُي نّ،</para>
  <para style="q" vid="JER 51:47">عَ شَ مِشِيٍ قَ سْنتْدٍ.<verse eid="JER 51:47"/></para>
  <para style="q">
    <verse number="48" style="v" sid="JER 51:48"/>نَ كُي كٌورٍ نُن بْشِ قَمَ نّ حّلّشِندٍ عَ شَ بِرّ شَ قٍ رَ،</para>
  <para style="q" vid="JER 51:48">عَ يَشُييٍ سَفٌ مَ، يَشُي نَشٍيٍ كٍلِشِ كْولَ مَ.</para>
  <para style="q" vid="JER 51:48">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.»<verse eid="JER 51:48"/></para>
  <para style="sp">نَمِحْنمّ شَ مَسٍنيِ</para>
  <para style="q">
    <verse number="49" style="v" sid="JER 51:49"/>«بَبِلْن شَ بِرَ عِسِرَيِلَكَ مِشِ قَشَشِيٍ شَ قٍ رَ،</para>
  <para style="q" vid="JER 51:49">عَلْ مِشِ فبٍفبٍ قَشَشِ دُنِحَ مَ كِ نَشّ بَبِلْن بّلّشّ قْشِ رَ.<verse eid="JER 51:49"/></para>
  <para style="q">
    <verse number="50" style="v" sid="JER 51:50"/>وٌ تَن نَشٍيٍ بَرَ وٌ يّتّ رَتَنفَ سَنتِدّفّمَ مَ،</para>
  <para style="q" vid="JER 51:50">وٌ نَشَ دُفُندِ، وٌ شَ سِفَ.</para>
  <para style="q" vid="JER 51:50">هَلِ وٌ نَ يِرٍ مَكُيٍ،</para>
  <para style="q" vid="JER 51:50">وٌ شَ رَتُ عَلَتَلَ مَ، وٌ حْشْ شَ سَ دَرِ سَلَمُ شْن.»<verse eid="JER 51:50"/></para>
  <para style="sp">عِسِرَيِلَ شَ مَسٍنيِ</para>
  <para style="q">
    <verse number="51" style="v" sid="JER 51:51"/>«وٌن بَرَ يَافِ سْتْ، وٌن بَرَ كٌنبِ،</para>
  <para style="q" vid="JER 51:51">وٌن مُ نْمَ وٌن شُن نَكٍلِدٍ سْنْن،</para>
  <para style="q" vid="JER 51:51">بَرِ مَ سِ فبّتّيٍ بَرَ سٌ يِرٍ سّنِيّنشِيٍ كُي عَلَتَلَ شَ هْرْ مْبَنشِ يِرٍ.»<verse eid="JER 51:51"/></para>
  <para style="sp">عَلَتَلَ شَ مَسٍنيِ</para>
  <para style="q">
    <verse number="52" style="v" sid="JER 51:52"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ،</para>
  <para style="q" vid="JER 51:52">«ﭑ نَ فّ بَبِلْن شَ كُيٍيٍ حَشَنكَتَدٍ،</para>
  <para style="q" vid="JER 51:52">عَ شَ حَمَ لُمَ وَ رَ نّ بْشِ بِرِن مَ.<verse eid="JER 51:52"/></para>
  <para style="q">
    <verse number="53" style="v" sid="JER 51:53"/>هَلِ بَبِلْن شَ قٍ قَمَ سْونّيَدٍ نُ،</para>
  <para style="q" vid="JER 51:53">عَ شَ شُننَكٍلِ سْتْ،</para>
  <para style="q" vid="JER 51:53">ﭑ قَمَ نّ عَ نِيَدٍ عَ شَ قٍ بِرِن شَ كَنَ.</para>
  <para style="q" vid="JER 51:53">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.»<verse eid="JER 51:53"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="54" style="v" sid="JER 51:54"/>«شُي شْرْشْي مِنِمَ بَبِلْن بْشِ مَ عَ شَ كَنَرِ نَن شَ قٍ رَ.<verse eid="JER 51:54"/></para>
  <para style="q">
    <verse number="55" style="v" sid="JER 51:55"/>عَلَتَلَ قَمَ نّ بَبِلْن شُن نَكَنَدٍ،</para>
  <para style="q" vid="JER 51:55">عَ عٍ شَ سْنشْي دَن.</para>
  <para style="q" vid="JER 51:55">عٍ يَشُييٍ دِنمَ نّ عٍ رَ عَلْ بَا مْرْنيِيٍ،</para>
  <para style="q" vid="JER 51:55">عٍ شُي شَاحّ عَ حَاشِ رَ.<verse eid="JER 51:55"/></para>
  <para style="q">
    <verse number="56" style="v" sid="JER 51:56"/>كَنَرِتِيٍ بِرَ مَ نّ بَبِلْنكَيٍ قْشْ رَ،</para>
  <para style="q" vid="JER 51:56">عٍ عٍ شَ سْورِيٍ سُشُ، عٍ عٍ شَ شَلِيٍ عِفِرَ،</para>
  <para style="q" vid="JER 51:56">بَرِ مَ عَلَتَلَ فبٍحْشْي تِمَ نّ،</para>
  <para style="q" vid="JER 51:56">عَ عٍ سَرٍ بِرِن نَفبِلٍن عٍ مَ.<verse eid="JER 51:56"/></para>
  <para style="q">
    <verse number="57" style="v" sid="JER 51:57"/>ﭑ عٍ شَ مَنفّيٍ، كُنتِفِيٍ، لْننِلَيٍ نُن سْورِيٍ قِندِ مَ سِيسِلَيٍ نَن نَ،</para>
  <para style="q" vid="JER 51:57">نَشٍيٍ لُمَ شِ رَ عَبَدَن، عٍ مُ شُنُمَ قٍقٍ مَ.</para>
  <para style="q" vid="JER 51:57">مَنفّ شَ مَسٍنيِ نَن نَ كِ،</para>
  <para style="q" vid="JER 51:57">نَشَن شِلِ عَلَتَلَ سّنبّمَ.»<verse eid="JER 51:57"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="58" style="v" sid="JER 51:58"/>«عَلَتَلَ شَ مَسٍنيِ نَن يَ،</para>
  <para style="q" vid="JER 51:58">بَبِلْن شَ تّتّ شُنفبٍ بِرَ مَ نّ،</para>
  <para style="q" vid="JER 51:58">عَ شَ نَادّ عِتٍشِيٍ فَن،</para>
  <para style="q" vid="JER 51:58">عَ شَ حَمَ عَ يّتّ رَتَفَن قٍ قُقَقُ مَ،</para>
  <para style="q" vid="JER 51:58">عَ وَلِ نَشَن نَبَشِ، نَ بِرِن فَن تّ رَ.»<verse eid="JER 51:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="JER 51:59"/>عَننَبِ يٍرٍ مِ تٌ يُدَيَ مَنفّ سٍدٍكِيَ مَتِ بَبِلْن عَ شَ مَنفّيَ حّ نَانِ ندٍ رَ، عَ نَشَ يِ مَسٍنيِ سٌ نٍرِيَ شَ دِ سٍرَيَ يِ رَ، نَشَن قِندِشِ مَشَسٍيَ شَ مَمَدِ رَ. <verse eid="JER 51:59"/><verse number="60" style="v" sid="JER 51:60"/>عَ نُ بَرَ بَبِلْن شَ فبَلٌي شَ قٍ بِرِن سّبّ كّيدِ ندٍ مَ، عَ نُ لَنمَ عٍ شَ نَشٍيٍ سْتْ. <verse eid="JER 51:60"/><verse number="61" style="v" sid="JER 51:61"/>عَ نَشَ عَ قَلَ سٍرَيَ بّ، «عِ نَ بَبِلْن بْشِ لِ، عِ شَ يِ مَسٍنيِ بِرِن شَرَن عِ شُي عِتٍشِ رَ. <verse eid="JER 51:61"/><verse number="62" style="v" sid="JER 51:62"/>نَ تّمُي، عِ شَ عَ قَلَ، ‹عَلَتَلَ، عِ بَرَ عَ مَسٍن عَ يِ يِرٍ بِرِن قَمَ نّ كَنَدٍ، مِشِيٍ نُن شُرُ سٍ مُ تٌمَ بٍ سْنْن، يِ بْشِ قَ قِندِ فبٍنفبٍرٍنيِ رَ.› <verse eid="JER 51:62"/><verse number="63" style="v" sid="JER 51:63"/>عِ نَ فّ يِ سّبّلِ شَرَندٍ، عِ شَ عَ شِرِ فّمّ ندٍ رَ، عِ قَ نَ فّمّ وٌلِ عٍقِرَتِ شُرٍ شْورَ. <verse eid="JER 51:63"/><verse number="64" style="v" sid="JER 51:64"/>نَ تّمُي عِ شَ عَ قَلَ، ‹بَبِلْن قَن دُلَمَ نَ كِ نّ، عَ مُ تٍمَ سْنْن فبَلٌي شَ قٍ رَ عَلَتَلَ نَشَن نَفِرِشِ عَ مَ. عَ شَ حَمَ شُن مُ رَكٍلِمَ سْنْن.›»</para>
  <para style="p" vid="JER 51:64">عَننَبِ يٍرٍ مِ شَ مَسٍنيِ دَنشِ بٍ نّ.<verse eid="JER 51:64"/></para>
  <chapter eid="JER 51"/>
  <chapter number="52" style="c" sid="JER 52"/>
  <para style="s">دَرِ سَلَمُ بِرَقٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="JER 52:1"/>سٍدٍكِيَ مَنفّيَ سْتْ عَ حّ مْشْحّن نُن كٍرٍن نَن مَ، عَ قَ حّ قُ نُن كٍرٍن مَنفّيَ رَبَ دَرِ سَلَمُ. عَ نفَ نُ قِندِشِ يٍرٍ مِ شَ دِ شَمُتَلِ نَشَن كٍلِ لِبِنَ مَ. <verse eid="JER 52:1"/><verse number="2" style="v" sid="JER 52:2"/>سٍدٍكِيَ نَشَ قٍ حَاشِ رَبَ عَ مَرِفِ عَلَتَلَ يَ شْرِ عَلْ يٍهٌيَكِمِ نُ بَرَ عَ رَبَ كِ نَشّ. <verse eid="JER 52:2"/><verse number="3" style="v" sid="JER 52:3"/>دَرِ سَلَمُ نُن يُدَيَ نُ بَرَ قٍ شْرْشْي سْتْ عَلَتَلَ شَ شْنّ شَ قٍ رَ. عَ رَحْنيِ عَلَتَلَ نَشَ عَ فبِلٍن عٍ قْشْ رَ.</para>
  <para style="p" vid="JER 52:3">نَ تّمُي سٍدٍكِيَ نَشَ مَنفّ نٍبُكَدَنسَرِ مَتَندِ. <verse eid="JER 52:3"/><verse number="4" style="v" sid="JER 52:4"/>نَ كُي عَ شَ مَنفّيَ حّ سٌلٌمَنَانِ ندٍ، كِكٍ قُ، شِ قُ ندٍ رَ، بَبِلْن مَنفّ نٍبُكَدَنسَرِ نَشَ قَ عَ نُن عَ شَ سْورِ فَلِ رَ دَرِ سَلَمُ فٍرٍ شِلِ مَ. عٍ نَشَ يٌنكِن تَا رَبِلِنيِ رَ، عٍ سٍ ندٍ تِ عَلَكٌ عٍ شَ نْ تٍدٍ تّتّ قَرِ. <verse eid="JER 52:4"/><verse number="5" style="v" sid="JER 52:5"/>تَا نَشَ لُ سُشُي كُي هَن مَنفّ سٍدٍكِيَ شَ مَنفّيَ حّ قُ نُن كٍرٍن ندٍ رَ.<verse eid="JER 52:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JER 52:6"/>كِكٍ نَانِ ندٍ شِ سٌلٌمَنَانِ ندٍ رَ، كَامّ نُ بَرَ سّنبّ سْتْ تَا كُي، دٌنسٍ يٌ مُ نُ نَ حَمَ يِ رَ سْنْن. <verse eid="JER 52:6"/><verse number="7" style="v" sid="JER 52:7"/>تَا تّتّ تٌ كَنَ، سْورِيٍ نَشَ عٍ فِ نَادّ رَ نَشَن نَ تّتّ قِرِنيِيٍ تَفِ، مَنفّ شَ مَلَبُدٍ قّ مَ، عٍ قَ سِفَ عَرَبَ قِيلِ مَ. كَلِدِكَيٍ نُ يٌنكِنشِ تَا رَبِلِنيِ.<verse eid="JER 52:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JER 52:8"/>كَلِدِكَيٍ تٌ تَا سْورِيٍ تٌ عٍ فِ رَ، عٍ نَشَ بِرَ عٍ شَ مَنفّ قْشْ رَ، عٍ قَ عَ سُشُ يٍرِكٌ قِيلِ مَ. مَنفّ شَ سْورِيٍ نَشَ عٍ فِ عَ شُن مَ، عٍ يٍنسٍن يّ. <verse eid="JER 52:8"/><verse number="9" style="v" sid="JER 52:9"/>كَلِدِكَيٍ نَشَ مَنفّ سُشُ، عٍ عَ شَنِن بَبِلْن مَنفّ شْن مَ رِبِلَ عَ مَكِيتِقٍ رَ. <verse eid="JER 52:9"/><verse number="10" style="v" sid="JER 52:10"/>عٍ نَشَ سٍدٍكِيَ شَ دِيٍ كْن نَشَبَ عَ يَ شْرِ، عٍ قَ عَ تَن يَيٍ كَنَ. <verse eid="JER 52:10"/><verse number="11" style="v" sid="JER 52:11"/>نَ دَنفِ شَنبِ، بَبِلْن مَنفّ نَشَ عَ شِرِ وُرٍ فبٍيلِ يْلْنشْنيِ رَ، عَ عَ شَنِن بَبِلْن. مّننِ عَ نَشَ لُ فٍيلِ كُي هَن عَ قَشَ تّمُي نَشّ.<verse eid="JER 52:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JER 52:12"/>كِكٍ سُولِ ندٍ شِ قُ ندٍ رَ، نٍبُكَدَنسَرِ شَ مَنفّيَ حّ قُ نُن سٌلٌمَنَانِ ندٍ بَبِلْن شُن مَ، نٍبُسَرَدَن بَبِلْن مَنفّ شَ سْورِ شُنيِ نَشَ سِفَ دَرِ سَلَمُ. <verse eid="JER 52:12"/><verse number="13" style="v" sid="JER 52:13"/>عَ نَشَ عَلَتَلَ شَ بَنشِ، مَنفّ شَ بَنشِ، نُن دَرِ سَلَمُ بَنشِ شُنفبٍ بِرِن فَن. <verse eid="JER 52:13"/><verse number="14" style="v" sid="JER 52:14"/>كَلِدِكَيٍ شَ سْورِ نَشٍيٍ نُ نَ عَ قْشْ رَ، عٍ نَشَ تّتّ رَبِرَ نَشَن نُ دَرِ سَلَمُ رَبِلِنشِ. <verse eid="JER 52:14"/><verse number="15" style="v" sid="JER 52:15"/>نٍبُسَرَدَن، بَبِلْن سْورِ مَنفّ نَشَ دَرِ سَلَمُ حَمَ دْنشْييٍ شَنِن بَبِلْن، عَلْ سٍتَرٍيٍ، وَلِكّيٍ، نُن مِشِ نَشٍيٍ عٍ يّتّ سٌ بَبِلْن مَنفّ يِ رَ. <verse eid="JER 52:15"/><verse number="16" style="v" sid="JER 52:16"/>كْنْ عَ نَشَ تِن سٍتَرٍ ندٍيٍ تَن شَ لُ نَا، عٍ شَ نُ بْشِ رَوَلِ، عٍ نُ وّنِ بِلِيٍ سِ.<verse eid="JER 52:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JER 52:17"/>كَلِدِكَيٍ نَشَ سٍيٍ تٌنفٌ نَشٍيٍ يَءِلَنشِ وُرٍ فبٍيلِ رَ، عٍ عٍ رَشُنُ عَلَكٌ عٍ شَ نَ وُرٍ فبٍيلِ شَنِن بَبِلْن. نَ كُي، عٍ نَشَ كِنكِ قِرِن، يٍ سَسٍ شُنفبٍ، نُن عَ دْشْدٍيٍ كَنَ. <verse eid="JER 52:17"/><verse number="18" style="v" sid="JER 52:18"/>عٍ نَشَ عَلَتَلَ شَ بَنشِ تُندٍيٍ، ثٍلِيٍ، قِنّيٍ، تْنبِلِيٍ، نُن يِرَبَسٍ بِرِن تٌنفٌ، نَشٍيٍ نُ يَءِلَنشِ وُرٍ فبٍيلِ رَ. <verse eid="JER 52:18"/><verse number="19" style="v" sid="JER 52:19"/>عَ نَشَ يِرَبَسٍيٍ نُن ثْوتِيٍ قَن بِرِن تٌنفٌ نَشٍيٍ نُ يَءِلَنشِ شّيمَ نُن فبٍتِ رَ. <verse eid="JER 52:19"/><verse number="20" style="v" sid="JER 52:20"/>بَنشِ كِنكِ قِرِنيِيٍ، يٍ سَسٍ شُنفبٍ نَشَن شِلِ «بَا،» عَ دْشْدٍ قُ نُن قِرِنيِ نَشٍيٍ نُ نَ عَ بُن مَ، عٍ مَسٌلِشِ تُورَيٍ رَ، سُلٍمَنِ نَشٍيٍ يَءِلَن عَلَتَلَ شَ بَنشِ بّ، نَ بِرِن قِندِشِ وُرٍ فبٍيلِ فبٍفبٍ نَن نَ، نَشَن شَسَبِ مُ نُ نْمَ كٌلٌندٍ. <verse eid="JER 52:20"/><verse number="21" style="v" sid="JER 52:21"/>نَ بَنشِ كِنكِ قِرِنيِيٍ شَ مَءِتٍيَ نُ نْنفْن يَ قُ نُن سٌلٌمَسَشَن لِمَ، عٍ رَبِلِنيِ نُ نْنفْن يَ قُ نُن قِرِن لِمَ. نٍيٍ نُ يَءِلَنشِ وُرٍ فبٍيلِ نَن نَ نَشَن تِلِنيِ سُشُي تَفِ لِمَ، عٍ كُي عِفٍلِشِ. <verse eid="JER 52:21"/><verse number="22" style="v" sid="JER 52:22"/>نَ كِنكِ شُنيِيٍ نُ يَءِلَنشِ وُرٍ فبٍيلِ نَن نَ، عٍ مَسٌلِ كْوبّ بٌفِ مَنِيّيٍ رَ. نٍيٍ شَ مَءِتٍيَ نُ نْنفْن يَ سُولِ لِمَ. <verse eid="JER 52:22"/><verse number="23" style="v" sid="JER 52:23"/>كْوبّ بٌفِ مَنِيّ تٌنفٌ سٌلٌمَنَانِ نُن سٍننِ نُ نَ تَندٍ مَبِرِ، نَانِ نُ نَ بَنشِ كُي مَبِرِ، نَشٍيٍ بِرِن نَلَنشِ لَن كّمّ مَ.<verse eid="JER 52:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JER 52:24"/>بَبِلْن سْورِ مَنفّ نَشَ سّرّشّدُبّ كُنتِفِ سٍرَيَ، سّرّشّدُبّ قِرِن ندٍ سٍقَنِيَ، نُن هْرْ مْبَنشِ نَادّ مَكَنتّ سَشَنيِيٍ شَنِن عَ شُن مَ. <verse eid="JER 52:24"/><verse number="25" style="v" sid="JER 52:25"/>عَ نَشَ يِ مِشِ شُنفبٍيٍ قَن شَنِن؛ سْورِ مَنفّ، مَنفّ رَ سِمَ سٌلٌقٍرٍ نَشٍيٍ تٌشِ تَا كُي، كُنتِفِ ندٍ نَشَن نُ سْورِيٍ سُفَندِ مَ، نُن نَ تَاكَيٍ مِشِ تٌنفٌ سٍننِ. <verse eid="JER 52:25"/><verse number="26" style="v" sid="JER 52:26"/>بَبِلْن سْورِ مَنفّ نٍبُسَرَدَن نَشَ نَ مِشِ بِرِن شَنِن بَبِلْن مَنفّ شْن مَ رِبِلَ. <verse eid="JER 52:26"/><verse number="27" style="v" sid="JER 52:27"/>بَبِلْن مَنفّ نَشَ عٍ قَشَ رِبِلَ، شَمَتَ بْشِ مَ. يُدَيَكَيٍ تٌنفٌشِ عٍ شَ بْشِ مَ نَ كِ نّ.<verse eid="JER 52:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JER 52:28"/>مِشِ شَسَبِ نَن يَ نٍبُكَدَنسَرِ نَشَن شَنِن كٌنيِيَ كُي بَبِلْن بْشِ مَ؛</para>
  <para style="q" vid="JER 52:28">عَ شَ مَنفّيَ حّ سٌلٌقٍرٍ ندٍ، يُدَيَكَ مِشِ وُلُ سَشَن مِشِ مْشْحّن نُن سَشَن.<verse eid="JER 52:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="JER 52:29"/>عَ شَ مَنفّيَ حّ قُ نُن سٌلٌمَسَشَن ندٍ، دَرِ سَلَمُكَ مِشِ كّمّ سٌلٌمَسَشَن، مِشِ تٌنفٌ سَشَن نُن قِرِن.<verse eid="JER 52:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="JER 52:30"/>عَ شَ مَنفّيَ حّ مْشْحّن نُن سَشَن ندٍ، يُدَيَكَ مِشِ كّمّ سٌلٌقٍرٍ، مِشِ تٌنفٌ نَانِ نُن سُولِ.</para>
  <para style="q" vid="JER 52:30">نَ بِرِن لَنشِ مِشِ وُلُ نَانِ، مِشِ كّمّ سٍننِ نَن مَ.<verse eid="JER 52:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JER 52:31"/>يُدَيَ مَنفّ يٍهٌيَكِنِ شَ سِفّ حّ تٌنفٌ سَشَن نُن سٌلٌقٍرٍ ندٍ رَ بَبِلْن بْشِ مَ، عَ كِكٍ قُ نُن قِرِن ندٍ، شِ مْشْحّن نُن سُولِ ندٍ رَ، عٍقِلِ مٍرٌدَكِ نَشَ قِندِ بَبِلْن مَنفّ رَ، عَ قَ يُدَيَ مَنفّ يٍهٌيَكِنِ رَ مِنِ فٍيلِ. <verse eid="JER 52:31"/><verse number="32" style="v" sid="JER 52:32"/>عَ نَشَ هِننّ عَ رَ، عَ عَ شَ كِبَنيِ رَدَنفِ مَنفّ فبّتّيٍ رَ، عَ تَن نُن نَشٍيٍ نُ عَ رَ بَبِلْن بْشِ مَ. <verse eid="JER 52:32"/><verse number="33" style="v" sid="JER 52:33"/>يٍهٌيَكِنِ نَشَ عَ شَ فٍيلِمَنِ سٌسٍيٍ مَسَرَ، عَ نُ قَ عَ دّفٍ مَنفّ شَ تٍيبِلِ رَ تّمُي بِرِن. <verse eid="JER 52:33"/><verse number="34" style="v" sid="JER 52:34"/>بَبِلْن مَنفّ نَشَ عَ حْشْ سَ عَ شَ قٍ شْن مَ عَ قَنيِ رَ، عَ نَشَ عَ كِ عَ شَ سِمَيَ بِرِن كُي.<verse eid="JER 52:34"/></para>
  <chapter eid="JER 52"/>
</usx>
