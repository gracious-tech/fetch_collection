<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ZEC" style="id"/>
  <para style="h">عَننَبِ سَكَرِ</para>
  <para style="toc1">عَلَ شَ مَسٍنيِ عَننَبِ سَكَرِ بّ</para>
  <para style="toc2">عَننَبِ سَكَرِ</para>
  <para style="toc3">سَك</para>
  <para style="mt">عَننَبِ سَكَرِ شَ كِتَابُي</para>
  <para style="imt">مَسٍنيِ ندٍ يِ كِتَابُي شَ قٍ رَ</para>
  <para style="ip">عَلَ نَشَ عَننَبِ سَكَرِ شّي دَرِ سَلَمُ ثٍرِ سٍ مَنفّ دَرِيُسِ شَ وَشَتِ. عِسِرَيِلَكَيٍ نُ بَرَ حّ تٌنفٌ سٌلٌقٍرٍ رَبَ كٌنيِيَ كُي ثٍرِ سٍ بْشِ مَ عٍ شَ كُيٍ بَتُي شَ قٍ رَ، كْنْ عَلَ نَشَ عَ نِيَ دَرِيُسِ شَ عٍ بّحِن فبِلٍنقٍ رَ عِسِرَيِلَ بْشِ مَ. عٍ تٌ مّننِ لِ عٍ شَ تَايٍ نُن عَلَ شَ هْرْ مْلِنفِرَ بَنشِ بِرِن نُ بَرَ كَنَ. عٍ نَشَ وَلِ سُشُ نٍيٍ يَءِلَنقٍ رَ، كْنْ عٍ يَشُييٍ نَشَ عٍ تْورْ. نَ كُي عَلَ نَشَ عَننَبِ سَكَرِ نُن عَننَبِ هَفٍ شّي دَرِ سَلَمُ عَلَكٌ عٍ شَ عِسِرَيِلَكَيٍ رَلِمَنِيَ.</para>
  <para style="ip">عَننَبِ سَكَرِ شَ مَسٍنيِ قْلْمَ لَامَتُنيِ سٌلٌمَسَشَن نَن مَ، نَشٍيٍ عَ مَسٍنمَ عَ عَلَ قَمَ نّ عِسِرَيِلَكَيٍ مَلِدٍ عٍ شَ وَلِ كُي. عَ مَن عَ مَسٍنمَ عَ عَلَ قَمَ نّ سِيٍ حَشَنكَتَدٍ نَشٍيٍ نَ عَ شَ حَمَ تْورْقٍ. عَلَ لِمَنِيَ قِمَ نّ عَ شَ مِشِيٍ مَ عَننَبِ سَكَرِ شَ مَسٍنيِ سَابُي رَ.</para>
  <para style="ip">عِسِرَيِلَ شَ شُننَكٍلِ مُ قِندِ مَ قٍ قَنيِ رَ عٍ تَن فبَنسَن بّ. دُنِحَ نَ عَ تٌ عَلَ مّينِمَ عِسِرَيِلَ مَ كِ نَشّ، عٍ قَن دَنشَنِيَمَ نّ عَلَ مَ، عٍ بِرَ عِسِرَيِلَكَيٍ قْشْ رَ. عَلَ عِسِرَيِلَكَ ندٍ رَكٍلِمَ نَشَن مِسَالِمَ سّرّشّدُبّ كُنتِفِ رَ. نَ شّمّ قِندِ مَ عِسِرَيِلَ مَنفّ شُنفبٍ نَن نَ، عَلَ شَ مِشِ سُفَندِشِ، نَشَن عٍ شُن تِمَ عَلَ شَ كِرَ مَ.</para>
  <para style="ip">يِ سَاتّ عَلَ نَشَن تٌنفٌشِ عِسِرَيِلَ بّ عَ قِندِ مَ نّ لْننِ بٍلٍبٍلٍ رَ تٌ مِشِيٍ بّ. عَلَ وَ مَ نّ دُنِحَ بِرِن شَ بِرَ عَ شَ سّرِيّ قْشْ رَ، عٍ شَ لَ عَلَ شَ شَنُنتٍيَ رَ عَلَكٌ عٍ شَ كِسِ سْتْ. شَ عَ سَ لِ عَدَ مَدِيٍ تٌندِ مَ عَلَ شَ مَلِ رَ، عٍ سَرٍ حَاشِ سْتْمَ نّ عٍ حّرّ كِ شَ قٍ رَ. عَلَ وَ مَ مِشِ رَكِسِقٍ. نَ نَن عَ رَ عَ نَشَ مَرَكِسِمَ شّي وٌن مَ عَلَكٌ لَنيِ شَ لُ عَلَتَلَ نُن عَدَ مَ تَفِ. عَلَ شَ نَ سْونّيَ وٌن بِرِن بّ، وٌن قَن شَ تِن نَ رَ. عَمِنَ.</para>
  <para style="imte">عَننَبِ سَكَرِ شَ كِتَابُي</para>
  <chapter number="1" style="c" sid="ZEC 1"/>
  <para style="s">لَامَتُنيِ سِنفٍ؛ فبِلٍنقٍ عَلَ مَ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 1:1"/>دَرِيُسِ شَ مَنفّيَ حّ قِرِن ندٍ كِكٍ سٌلٌمَسَشَن ندٍ كُي، عَلَتَلَ نَشَ عَ مَسٍن عَننَبِ سَكَرِ بّ، بّرّكَيَ شَ دِ، عِدٌ شَ مَمَدِ قَنيِ، عَ نَشّ، <verse eid="ZEC 1:1"/><verse number="2" style="v" sid="ZEC 1:2"/>«عَلَتَلَ بَرَ شْنْ وٌ بٍنبَيٍ مَ. <verse eid="ZEC 1:2"/><verse number="3" style="v" sid="ZEC 1:3"/>كْنْ، عِ شَ عَ قَلَ، مَنفّ عَلَتَلَ شَ مَسٍنيِ نَن يَ؛ ‹ﭑ تَن مَنفّ عَلَتَلَ بَرَ عَ قَلَ وٌ بّ، وٌ شَ فبِلٍن ﭑ مَ. نَ تّمُي ﭑ قَن فبِلٍنمَ نّ وٌ مَ. <verse eid="ZEC 1:3"/><verse number="4" style="v" sid="ZEC 1:4"/>وٌ نَشَ لُ عَلْ وٌ بٍنبَيٍ. سِنفٍ نَمِحْنمّيٍ نُ بَرَ عَ مَسٍن عٍ بّ، «مَنفّ عَلَتَلَ شَ مَسٍنيِ نَن يَ، وٌ فبِلٍن وٌ شَ قٍ حَاشِيٍ نُن وٌ شَ كّوَلِ حَاشِيٍ قْشْ رَ.» كْنْ عٍ مُ عٍ تُلِ مَتِ ﭑ مَ مَسٍنيِ رَ، عٍ مُ ﭑ شُي سُشُ. ﭑ تَن عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ. <verse eid="ZEC 1:4"/><verse number="5" style="v" sid="ZEC 1:5"/>وٌ بٍنبَيٍ نَ مِندٍن؟ نَمِحْنمّيٍ فٌ؟ عٍ مُ قَشَمَ شّ؟ <verse eid="ZEC 1:5"/><verse number="6" style="v" sid="ZEC 1:6"/>ﭑ مَ مَسٍنيِ نُن ﭑ مَ سّرِيّ، عَ مُ وٌ بٍنبَيٍ لِشِ؟›»</para>
  <para style="p" vid="ZEC 1:6">عَ تٌ فّ نَ مَسٍنيِ رَ، حَمَ نَشَ تُوبِ، عٍ قَ عَ قَلَ عٍ بٌورٍ بّ، «مَنفّ عَلَتَلَ بَرَ وٌن مَ قٍ رَبَشِيٍ سَرٍ رَفبِلٍن وٌن مَ.»<verse eid="ZEC 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ZEC 1:7"/>كِكٍ قُ نُن كٍرٍن ندٍ شِ مْشْحّن نُن نَانِ ندٍ، سٍبَتِ كِكٍ، دَرِيُسِ شَ مَنفّيَ حّ قِرِن ندٍ، عَلَتَلَ نَشَ عَ مَسٍن عَننَبِ سَكَرِ بّ، بّرّكَيَ شَ دِ، عِدٌ شَ مَمَدِ، <verse eid="ZEC 1:7"/><verse number="8" style="v" sid="ZEC 1:8"/>«تٌ كْي رَ ﭑ بَرَ يِ لَامَتُنيِ تٌ. شّمّ ندٍ نُ نَ سٌي فبٍيلِ قَرِ، عَ نُ تِشِ مِرِتِ وُرِيٍ تَفِ قٌلٍ كُي. سٌي فبٍيلِيٍ، سٌي قْورّيٍ، نُن سٌي قِيشّيٍ نُ نَ عَ شَنبِ رَ. <verse eid="ZEC 1:8"/><verse number="9" style="v" sid="ZEC 1:9"/>ﭑ نَشَ عَ مَشْرِن، ‹ﭑ مَرِفِ، مُنسٍ نَ يٍيٍ تَن نَ؟› مَلٍكّ نَشَن نُ وْيّنمَ ﭑ نَ، عَ نَشَ عَ قَلَ، ‹ﭑ عَ مَسٍنمَ نّ عِ بّ.› <verse eid="ZEC 1:9"/><verse number="10" style="v" sid="ZEC 1:10"/>مِشِ نَشَن نُ تِشِ مِرِتِ وُرِيٍ تَفِ، عَ نَشَ عَ قَلَ، ‹عَلَتَلَ شَ شّيرَيٍ نَن عٍ رَ نَشٍيٍ دُنِحَ عِحّرّ مَ.› <verse eid="ZEC 1:10"/><verse number="11" style="v" sid="ZEC 1:11"/>عٍ نَشَ دّنتّفّ سَ عَلَتَلَ شَ مَلٍكّ بّ نَشَن نُ تِشِ مِرِتِ وُرِيٍ تَفِ، ‹مُشُ بَرَ دُنِحَ بِرِن عِحّرّ، دُنِحَ مِشِ بِرِن رَشَرَشِ، عٍ نَ بْحّسَ كُي.› <verse eid="ZEC 1:11"/><verse number="12" style="v" sid="ZEC 1:12"/>عَلَتَلَ شَ مَلٍكّ نَشَ عَ قَلَ، ‹مَنفّ عَلَتَلَ، عِ قَمَ كِنِكِنِدٍ دَرِ سَلَمُ نُن يُدَيَ شَ تَايٍ مَ مُن تّمُي؟ عِ شْنْشِ عٍ مَ كَبِ حّ تٌنفٌ سٌلٌقٍرٍ.› <verse eid="ZEC 1:12"/><verse number="13" style="v" sid="ZEC 1:13"/>عَلَتَلَ نَشَ نَ مَلٍكّ رَلِمَنِيَ، عَ عَ مَدُندُ، مَلٍكّ نَشَن نُ وْيّنمَ ﭑ نَ.»<verse eid="ZEC 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ZEC 1:14"/>«نَ مَلٍكّ نَشَ عَ قَلَ ﭑ بّ، ‹عِ شَ عَ قَلَ، مَنفّ عَلَتَلَ شَ مَسٍنيِ نَن يَ؛ دَرِ سَلَمُ نُن سِيٌن رَقَن ﭑ مَ. ﭑ مُ تِنمَ عٍ شَ بِرَ شَنُنتٍنيِ فبّتّ قْشْ رَ. <verse eid="ZEC 1:14"/><verse number="15" style="v" sid="ZEC 1:15"/>ﭑ بَرَ شْنْ سِ فبّتّيٍ مَ نَشٍيٍ حْشْ عَ مَ تْورّ يٌ مُ نْمَ عٍ لِدٍ. سِنفٍ ﭑ نُ شْنْشِ دٌندٌرٌنتِ ﭑ مَ حَمَ مَ، كْنْ سِيٍ تَن بَرَ ندٍ سَ ﭑ مَ حَمَ شَ تْورّ شُن مَ.›»<verse eid="ZEC 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ZEC 1:16"/>«نَ نَن عَ رَ، عَلَتَلَ نَشَ عَ مَسٍن، ‹ﭑ مَن كِنِكِنِمَ نّ دَرِ سَلَمُ مَ، ﭑ مَن ﭑ مَ بَنشِ تِمَ نّ. لُوتِ عِبّندُنمَ نّ دَرِ سَلَمُ تَا شُن مَ عَلَكٌ نَ شَ مَنِيَ، نَ تَا مَن شَ فبِلٍن تِ رَ.› مَنفّ عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ. <verse eid="ZEC 1:16"/><verse number="17" style="v" sid="ZEC 1:17"/>عِ مَن شَ عَ قَلَ، ‹مَنفّ عَلَتَلَ شَ مَسٍنيِ نَن يَ؛ هَرِفٍ مَن لُمَ ﭑ مَ تَايٍ كُي، ﭑ مَن سِيٌن مَدُندُ مَ نّ، ﭑ مَن دَرِ سَلَمُ سُفَندِ مَ نّ.›»<verse eid="ZEC 1:17"/></para>
  <chapter eid="ZEC 1"/>
  <chapter number="2" style="c" sid="ZEC 2"/>
  <para style="s">لَامَتُنيِ قِرِن ندٍ؛ قٍرِيٍ نُن شَبُييٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 2:1"/>ﭑ نَشَ يِ لَامَتُنيِ تٌ؛ ﭑ بَرَ قٍرِ نَانِ تٌ. <verse eid="ZEC 2:1"/><verse number="2" style="v" sid="ZEC 2:2"/>ﭑ بَرَ مَلٍكّ مَشْرِن، نَشَن نُ وْيّنمَ ﭑ نَ، «مُنسٍ نَ يٍيٍ رَ؟» عَ نَشَ ﭑ يَابِ، «سّنبّمَيٍ نَن يٍيٍ رَ نَشٍيٍ يُدَيَ، عِسِرَيِلَ، نُن دَرِ سَلَمُ رَيٍنسٍنشِ.»<verse eid="ZEC 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ZEC 2:3"/>نَ تّمُي، عَلَتَلَ نَشَ شَبُي نَانِ مَسٍن ﭑ بّ. <verse eid="ZEC 2:3"/><verse number="4" style="v" sid="ZEC 2:4"/>ﭑ نَشَ مَشْرِنيِ تِ، «يٍيٍ قَشِ مُنسٍ رَبَدٍ بٍ؟» عَ نَشَ ﭑ يَابِ، «يِ قٍرِ نَانِ مِسَالِشِ سّنبّمَيٍ نَن نَ نَشٍيٍ يُدَيَ رَيٍنسٍنشِ مِشِ يٌ مُ نْ عَ شُنيِ رَكٍلِدٍ. كْنْ يِ شَبُييٍ قَشِ عٍ مَفَاشُدٍ نّ، عٍ سِ فبّتّ سّنبّمَيٍ رَبِرَ، نَشٍيٍ كٍلِشِ يُدَيَ بْشِ شِلِ مَ عَلَكٌ عٍ شَ يُدَيَكَيٍ رَيٍنسٍن.»<verse eid="ZEC 2:4"/></para>
  <para style="s">لَامَتُنيِ سَشَن ندٍ؛ مَنِيَ لُوتِ</para>
  <para style="p">
    <verse number="5" style="v" sid="ZEC 2:5"/>ﭑ نَشَ يِ لَامَتُنيِ تٌ؛ شّمّ ندٍ نُ نَ، مَنِيَ لُوتِ نُ سُشُشِ عَ يِ رَ. <verse eid="ZEC 2:5"/><verse number="6" style="v" sid="ZEC 2:6"/>ﭑ نَشَ عَ مَشْرِن، «عِ سِفَ مِندٍن؟» عَ نَشَ ﭑ يَابِ، «ﭑ دَرِ سَلَمُ نَن مَنِيَقٍ، عَلَكٌ ﭑ شَ عَ فبٌي نُن عَ كُيّيَ كٌلٌن.»<verse eid="ZEC 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ZEC 2:7"/>مَلٍكّ نَشَن نُ وْيّنمَ ﭑ نَ، عَ نَشَ سِفَ يَرٍ، مَلٍكّ فبّتّ نَشَ قَ عَ رَلَندٍ. <verse eid="ZEC 2:7"/><verse number="8" style="v" sid="ZEC 2:8"/>عَ نَشَ عَ قَلَ عَ بّ، «عِ فِ، سَ عَ قَلَ يِ سّفّتَلَ بّ، عَ دَرِ سَلَمُكَيٍ نُن شُرُ سٍيٍ قَمَ نّ وُيَدٍ هَن تّتّ مُ نْ عٍ رَبِلِندٍ سْنْن.» <verse eid="ZEC 2:8"/><verse number="9" style="v" sid="ZEC 2:9"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛ «ﭑ تَن يَتِ عٍ مَكَنتَمَ نّ. ﭑ لُمَ نّ عٍ بّ عَلْ تّتّ تّ دَاشِ، ﭑ مَ نْرّ قَ لُ عٍ تَفِ.»<verse eid="ZEC 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ZEC 2:10"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="ZEC 2:10">«وٌ وٌ فِ، وٌ وٌ فِ!</para>
  <para style="q" vid="ZEC 2:10">وٌ شَ كٍلِ حَمَنّ مَ نَشَن نَ كْولَ مَ.»</para>
  <para style="q" vid="ZEC 2:10">عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="ZEC 2:10">«سِنفٍ ﭑ نُ بَرَ وٌ رَيٍنسٍن يّ دُنِحَ مَ.<verse eid="ZEC 2:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ZEC 2:11"/>سِيٌن مِشِيٍ، وٌ وٌ فِ.</para>
  <para style="q" vid="ZEC 2:11">وٌ تَن نَشٍيٍ نَ بَبِلْن،</para>
  <para style="q" vid="ZEC 2:11">وٌ شَ كٍلِ نَا.»<verse eid="ZEC 2:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="ZEC 2:12"/>مَنفّ عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ،</para>
  <para style="q" vid="ZEC 2:12">عَ نَشَن شّيشِ بِنيّ كُي،</para>
  <para style="q" vid="ZEC 2:12">قٍ قَلَقٍ يِ سِيٍ شَ قٍ رَ نَشٍيٍ وٌ تْورْشِ؛</para>
  <para style="q" vid="ZEC 2:12">«نَشَن عَ بّلّشّ دِنمَ وٌ رَ،</para>
  <para style="q" vid="ZEC 2:12">عَ لُشِ نّ عَلْ نَ كَنيِ بَرَ عَ بّلّشّ دِن عَلَ رَ.»<verse eid="ZEC 2:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="ZEC 2:13"/>ﭑ نَ كٍلِ عٍ شِلِ مَ،</para>
  <para style="q" vid="ZEC 2:13">عٍ قِندِ عٍ شَ كٌنيِيٍ شَ كٌنيِيٍ رَ.</para>
  <para style="q" vid="ZEC 2:13">نَ كُي وٌ عَ كٌلٌنمَ نّ</para>
  <para style="q" vid="ZEC 2:13">عَ مَنفّ عَلَتَلَ نَن ﭑ شّيشِ.<verse eid="ZEC 2:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="ZEC 2:14"/>«دَرِ سَلَمُكَيٍ، وٌ وٌ شُي عِتٍ سّيوّ كُي،</para>
  <para style="q" vid="ZEC 2:14">بَرِ مَ ﭑ قَمَ نّ لُدٍ وٌ تَفِ.»</para>
  <para style="q" vid="ZEC 2:14">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="ZEC 2:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="ZEC 2:15"/>سِ وُيَشِ قَمَ نّ عَلَتَلَ مَ نَ لْشْي،</para>
  <para style="q" vid="ZEC 2:15">عٍ قَ قِندِ ﭑ مَ حَمَ رَ.</para>
  <para style="q" vid="ZEC 2:15">ﭑ لُمَ نّ وٌ تَفِ،</para>
  <para style="q" vid="ZEC 2:15">وٌ قَ عَ كٌلٌن</para>
  <para style="q" vid="ZEC 2:15">عَ مَنفّ عَلَتَلَ نَن ﭑ شّيشِ وٌ مَ.<verse eid="ZEC 2:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="ZEC 2:16"/>يُدَيَ مَن قِندِ مَ عَلَتَلَ فبٍ نَن نَ</para>
  <para style="q" vid="ZEC 2:16">عَ شَ بْشِ سّنِيّنشِ كُي.</para>
  <para style="q" vid="ZEC 2:16">عَ مَن قَمَ نّ دَرِ سَلَمُ سُفَندِدٍ.<verse eid="ZEC 2:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="ZEC 2:17"/>عَدَ مَدِ بِرِن شَ عَ سَبَرِ عَلَتَلَ بّ،</para>
  <para style="q" vid="ZEC 2:17">عَ نَ كٍلِقٍ عَ شَ يِرٍ سّنِيّنشِ.<verse eid="ZEC 2:17"/></para>
  <chapter eid="ZEC 2"/>
  <chapter number="3" style="c" sid="ZEC 3"/>
  <para style="s">لَامَتُنيِ نَانِ ندٍ؛ سّرّشّدُبّ كُنتِفِ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 3:1"/>عَ نَشَ سّرّشّدُبّ كُنتِفِ يٌسُوٍ مَسٍن ﭑ بّ، عَ نُ تِشِ عَلَتَلَ شَ مَلٍكّ يَ عِ. سٍنتَنّ نُ تِشِ عَ يِرٍقَنيِ مَ عَ شَ عَ تْوحّفّ. <verse eid="ZEC 3:1"/><verse number="2" style="v" sid="ZEC 3:2"/>عَلَتَلَ نَشَ عَ قَلَ سٍنتَنّ بّ، «ﭑ تَن، عَلَتَلَ نَشَن دَرِ سَلَمُ سُفَندِشِ، ﭑ بَرَ عَ قَلَ عِ بّ سٍنتَنّ، عِ سَبَرِ! يٍفٍ شُنتُنيِ شَ مُ نَ يِ شّمّ رَ نَشَن بَشِ تّ دّ عِ؟»<verse eid="ZEC 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ZEC 3:3"/>يٌسُوٍ نُ تِشِ مَلٍكّ يَ عِ، دُفِ نْشْشِ نَن نُ رَفٌرٌشِ عَ مَ. <verse eid="ZEC 3:3"/><verse number="4" style="v" sid="ZEC 3:4"/>مَلٍكّ نَشَ عَ قَلَ عَ بٌورٍيٍ بّ نَشٍيٍ نُ تِشِ يٌسُوٍ سّيتِ مَ، «وٌ دُفِ نْشْشِيٍ بَ عَ مَ.» عَ مَن نَشَ عَ قَلَ يٌسُوٍ بّ، «عَ مَتٌ، ﭑ بَرَ عِ شَ يُنُبِ بَ، ﭑ بَرَ دُفِ تٌقَنيِيٍ رَفٌرٌ عِ مَ.» <verse eid="ZEC 3:4"/><verse number="5" style="v" sid="ZEC 3:5"/>ﭑ نَشَ عَ قَلَ، «وٌ شَ شُنيِ رَتٌقَن سٍ سّنِيّنشِ دْشْ عَ شُنيِ مَ.» عٍ نَشَ شُنيِ رَتٌقَن سٍ سّنِيّنشِ دْشْ عَ شُنيِ مَ، عٍ نَشَ دُفِيٍ رَفٌرٌ عَ مَ. عَلَتَلَ شَ مَلٍكّ نُ تِشِ نَا.<verse eid="ZEC 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ZEC 3:6"/>عَلَتَلَ شَ مَلٍكّ نَشَ يِ مَسٍنيِ تِ يٌسُوٍ بّ، <verse eid="ZEC 3:6"/><verse number="7" style="v" sid="ZEC 3:7"/>«مَنفّ عَلَتَلَ شَ مَسٍنيِ نَن يَ؛ شَ عِ حّرّ ﭑ مَ كِرَيٍ شْن، شَ عِ ﭑ مَ يَامَرِيٍ سُشُ، عِ قَمَ نّ ﭑ مَ بَنشِ رَحّرّدٍ، عِ قَ ﭑ مَ تّتّ مَكَنتَدٍ. نَ تّمُي عِ يِرٍ سْتْمَ نّ بٍ يٍيٍ تَفِ. <verse eid="ZEC 3:7"/><verse number="8" style="v" sid="ZEC 3:8"/>سّرّشّدُبّ كُنتِفِ يٌسُوٍ، عِ تَن نُن نَشٍيٍ دْشْشِ عِ يَ عِ، وٌ وٌ تُلِ مَتِ. وٌ بَرَ قِندِ مِسَالِ رَ. ﭑ قَمَ ﭑ مَ كٌنيِ شّيدٍ، نَشَن شِلِ ‹سَلٌنيِ.› <verse eid="ZEC 3:8"/><verse number="9" style="v" sid="ZEC 3:9"/>وٌ شَ فّمّ مَتٌ ﭑ نَشَن دْشْشِ يٌسُوٍ يَ عِ. يَ سٌلٌقٍرٍ نَ نَ فّمّ كٍرٍنيِ مَ. ﭑ سّبّلِ تِمَ نّ عَ مَ، ﭑ مَن قَ يِ بْشِ شَ يُنُبِ بَ لْشْي كٍرٍن كُي.» مَنفّ عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ. <verse eid="ZEC 3:9"/><verse number="10" style="v" sid="ZEC 3:10"/>«نَ لْشْي، وٌ وٌ بٌورٍ شِلِمَ نّ، وٌ شَ لُ يِرٍ كٍرٍن وٌ شَ وّنِ بِلِ نُن شْرّ بِلِ بُن مَ.» مَنفّ عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="ZEC 3:10"/></para>
  <chapter eid="ZEC 3"/>
  <chapter number="4" style="c" sid="ZEC 4"/>
  <para style="s">لَامَتُنيِ سُولِ ندٍ؛ لَنثُي دْشْ سٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 4:1"/>مَلٍكّ نَشَن نُ وْيّنمَ ﭑ نَ، عَ نَشَ قَ ﭑ نَشُنُدٍ، عَلْ عٍ مِشِ رَشُنُمَ كِ نَشّ شِشْلِ مَ. <verse eid="ZEC 4:1"/><verse number="2" style="v" sid="ZEC 4:2"/>عَ نَشَ ﭑ مَشْرِن، «عِ مُنسٍ تٌشِ؟» ﭑ نَشَ عَ يَابِ، «ﭑ لَنثُي دْشْ سٍ شّيمَ دَاشِ نَن تٌشِ، بِتِرّ نَ عَ شُنتَفِ، تُرٍ رَ عَ كُي. لَنثُي سٌلٌقٍرٍ فبَكُشِ عَ مَ، تُرٍ فٌرٌدٍ سٌلٌقٍرٍ، تُرٍ رَ سٌمَ نَ لَنثُي سٌلٌقٍرٍيٍ كُي. <verse eid="ZEC 4:2"/><verse number="3" style="v" sid="ZEC 4:3"/>عٌلِوِ وُرِ بِلِ قِرِن تِشِ تُرٍ بِتِرّ سّيتِ قِرِنيِيٍ مَ، كٍرٍن عَ يِرٍقَنيِ مَ، كٍرٍن عَ كْولَ مَ.» <verse eid="ZEC 4:3"/><verse number="4" style="v" sid="ZEC 4:4"/>ﭑ نَشَ مَلٍكّ مَشْرِن، نَشَن نُ وْيّنمَ ﭑ نَ، «ﭑ مَرِفِ، مُنسٍ نَ يٍيٍ رَ؟» <verse eid="ZEC 4:4"/><verse number="5" style="v" sid="ZEC 4:5"/>عَ نَشَ عَ قَلَ ﭑ بّ، «عِ مُ عَ كٌلٌن؟» ﭑ نَشَ عَ يَابِ؛ «ﭑ مَرِفِ، ﭑ مُ عَ كٌلٌن.» <verse eid="ZEC 4:5"/><verse number="6" style="v" sid="ZEC 4:6"/>نَ تّمُي عَ نَشَ عَ مَسٍن ﭑ بّ، «عَلَتَلَ شَ مَسٍنيِ نَن يَ، عَ نَشَن تِشِ سٌرٌبَبٍلِ بّ، ‹وٌ سّنبّ مُ نْمَ سٍسٍ رَ. ﭑ تَن نَن شَشِلِ نْمَ عَ رَبَدٍ.› مَنفّ عَلَتَلَ شَ مَسٍنيِ نَن يَ.»<verse eid="ZEC 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ZEC 4:7"/>«فٍيَ شُنفبٍ نَشَن نَ سٌرٌبَبٍلِ يَ رَ، ﭑ نَ قِندِ مَ نّ قِيلِ رَ. عَ قَمَ نّ فّمّ قَنيِ رَ مِنِدٍ بَنشِ تِ سٍ رَ، حَمَ قَ عَ قَلَ عٍ شُي عِتٍشِ رَ، ‹عَلَ شَ هِننّ عَ رَ، عَلَ شَ هِننّ عَ رَ!›»<verse eid="ZEC 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ZEC 4:8"/>عَلَتَلَ نَشَ يِ مَسٍنيِ تِ ﭑ بّ، <verse eid="ZEC 4:8"/><verse number="9" style="v" sid="ZEC 4:9"/>«سٌرٌبَبٍلِ بَرَ يِ بَنشِ تِ قْلْ، عَ مَن عَ رَحْنمَ نّ.» نَ كُي وٌ عَ كٌلٌنمَ نّ عَ مَنفّ عَلَتَلَ نَن ﭑ شّيشِ وٌ يِرٍ. <verse eid="ZEC 4:9"/><verse number="10" style="v" sid="ZEC 4:10"/>ندٍ يٌمَ قٍ قْلّ شُرِ مَ؟ حَمَ نَ وَلِ سٍ تٌ سٌرٌبَبٍلِ بّلّشّ، عٍ حّلّشِنمَ نّ.</para>
  <para style="p" vid="ZEC 4:10">مَلٍكّ نَشَ عَ قَلَ ﭑ بّ، «نَ لَنثُي سٌلٌقٍرٍ قِندِشِ عَلَتَلَ يَيٍ نَن نَ نَشٍيٍ دُنِحَ عِحّرّ مَ.» <verse eid="ZEC 4:10"/><verse number="11" style="v" sid="ZEC 4:11"/>ﭑ نَشَ عَ مَشْرِن عَ مَ، «مُنسٍ نَ نَ عٌلِوِ وُرِ بِلِ قِرِنيِ رَ، نَشٍيٍ نَ لَنثُي دْشْ سٍ يِرٍقَنيِ مَ نُن عَ كْولَ مَ؟» <verse eid="ZEC 4:11"/><verse number="12" style="v" sid="ZEC 4:12"/>ﭑ مَن نَشَ عَ مَشْرِن عَ مَ، «مُنسٍ نَ نَ عٌلِوِ سَلٌنيِ قِرِنيِيٍ رَ، نَشٍيٍ نَ تُرٍ فٌرٌدٍ شّيمَ دَاشِ قِرِنيِيٍ سّيتِ مَ، عٌلِوِ تُرٍ دَنفِمَ نَشٍيٍ كُي؟» <verse eid="ZEC 4:12"/><verse number="13" style="v" sid="ZEC 4:13"/>عَ نَشَ عَ قَلَ ﭑ بّ، «عِ مُ عَ كٌلٌن عٍ نَشٍيٍ مِسَالِشِ؟» ﭑ نَشَ عَ يَابِ، «ﭑ مَرِفِ، ﭑ مُ عَ كٌلٌن.» <verse eid="ZEC 4:13"/><verse number="14" style="v" sid="ZEC 4:14"/>عَ نَشَ عَ قَلَ ﭑ بّ، «مِشِ قِرِن نَن عٍ رَ عَلَ نَشٍيٍ سُفَندِشِ، عَ تُرٍ عِقِلِ عٍ شُنيِيٍ مَ، عٍ شَ وَلِ دُنِحَ بِرِن مَرِفِ بّ.»<verse eid="ZEC 4:14"/></para>
  <chapter eid="ZEC 4"/>
  <chapter number="5" style="c" sid="ZEC 5"/>
  <para style="s">لَامَتُنيِ سٍننِ ندٍ؛ دَنكّ كّيدِ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 5:1"/>ﭑ مَن نَشَ لَامَتُنيِ تٌ نَشَن قِندِشِ كّيدِ مَكُنتَنشِ رَ كٌورٍ مَ. <verse eid="ZEC 5:1"/><verse number="2" style="v" sid="ZEC 5:2"/>مَلٍكّ نَشَ ﭑ مَشْرِن، «عِ مُنسٍ تٌشِ؟» ﭑ نَشَ عَ يَابِ، «ﭑ كّيدِ مَكُنتَنشِ نَن تٌشِ كٌورٍ مَ، عَ كُيَ نْنفْن يَ مْشْحّن، عَ عِفبٌ نْنفْن يَ قُ.» <verse eid="ZEC 5:2"/><verse number="3" style="v" sid="ZEC 5:3"/>عَ نَشَ عَ قَلَ ﭑ بّ، «دَنكّ سّبّشِ نَ كّيدِ مَ نَشَن مَسٍنشِ بْشِ يِرٍ بِرِن. عَ سّبّشِ مُحّتِ نُن مِشِيٍ نَن بّ، نَشٍيٍ عٍ كَلِمَ وُلٍ رَ، عٍ بِرِن قَمَ نّ كٍرِدٍ يِ بْشِ مَ. <verse eid="ZEC 5:3"/><verse number="4" style="v" sid="ZEC 5:4"/>مَنفّ عَلَتَلَ شَ مَسٍنيِ نَن يَ، ‹ﭑ يِ دَنكّ رَ سٌمَ نّ مُحّتِيٍ شَ بَنشِيٍ كُي، عَ نُن مِشِ نَشٍيٍ عٍ كَلِمَ ﭑ شِلِ رَ كْنْ عٍ قَ وُلٍ قَلَ. نَ دَنكّ لُمَ نّ عٍ شَ بَنشِيٍ كُي هَن عَ بِرِن كَنَ.›»<verse eid="ZEC 5:4"/></para>
  <para style="s">لَامَتُنيِ سٌلٌقٍرٍ ندٍ؛ فِنّ نَ بُسَلِ كُي</para>
  <para style="p">
    <verse number="5" style="v" sid="ZEC 5:5"/>مَلٍكّ نَشَن نُ وْيّنمَ ﭑ نَ، عَ نَشَ مَكْرّ ﭑ نَ، عَ قَ عَ قَلَ ﭑ بّ، «عَ مَتٌ نَشَن نَ مِنِقٍ يَكْسِ.» <verse eid="ZEC 5:5"/><verse number="6" style="v" sid="ZEC 5:6"/>ﭑ نَشَ عَ مَشْرِن، «مُنسٍ عَ رَ؟» عَ نَشَ ﭑ يَابِ، «بُسَلِ نَن عَ رَ، حَمَ شَ قٍ حَاشِيٍ نَ نَشَن كُي.» <verse eid="ZEC 5:6"/><verse number="7" style="v" sid="ZEC 5:7"/>دّرَكٌتٍ بِنيٍ تٌ بَ عَ دّ رَ، عَ نَشَ عَ تٌ فِنّ ندٍ دْشْشِ عَ كُي. <verse eid="ZEC 5:7"/><verse number="8" style="v" sid="ZEC 5:8"/>مَلٍكّ نَشَ عَ قَلَ ﭑ بّ، «قٍ حَاشِ مِسَالِ نَن يِ فِنّ رَ.» عَ مَن نَشَ فِنّ رَدِن بُسَلِ كُي، عَ قَ عَ دّ رَكٌتٌ دّرَكٌتٍ بِنيٍ رَ.<verse eid="ZEC 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ZEC 5:9"/>ﭑ تٌ ﭑ يَ رَكٍلِ، ﭑ نَشَ فِنّ قِرِن تٌ. فَبُتٍنيِ فبٌنفبٌي دَاشِيٍ نُ نَ عٍ مَ، عٍ نُ نَ حّرّقٍ كٌورٍ مَ. عٍ نَشَ نَ بُسَلِ تٌنفٌ، عٍ عَ شَنِن كٌورٍ مَ. <verse eid="ZEC 5:9"/><verse number="10" style="v" sid="ZEC 5:10"/>ﭑ نَشَ مَلٍكّ مَشْرِن، نَشَن نُ وْيّنمَ ﭑ نَ، «عٍ نَ بُسَلِ شَنِنقٍ مِندٍن؟» <verse eid="ZEC 5:10"/><verse number="11" style="v" sid="ZEC 5:11"/>عَ نَشَ ﭑ يَابِ، «عٍ نَ عَ شَنِنقٍ بَبِلْن بْشِ نَن مَ، عٍ بَنشِ تِمَ عَ بّ دّننَشّ، عَ شَ لُ نَا.»<verse eid="ZEC 5:11"/></para>
  <chapter eid="ZEC 5"/>
  <chapter number="6" style="c" sid="ZEC 6"/>
  <para style="s">لَامَتُنيِ سٌلٌمَسَشَن ندٍ؛ سْورِ رَفِسٍ نَانِ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 6:1"/>ﭑ مَن نَشَ لَامَتُنيِ تٌ. سْورِ رَفِسٍ نَانِ نُ نَ مِنِقٍ فٍيَ قِرِنيِيٍ لٌنفٌرِ رَ. نَ فٍيَيٍ نُ يَءِلَنشِ يْشُي نَن نَ. <verse eid="ZEC 6:1"/><verse number="2" style="v" sid="ZEC 6:2"/>سٌي فبٍيلِيٍ نَن نُ نَ سْورِ رَفِسٍ سِنفٍ بّندُنقٍ، سٌي قْورّيٍ نَن نُ نَ سْورِ رَفِسٍ قِرِن ندٍ بّندُنقٍ، <verse eid="ZEC 6:2"/><verse number="3" style="v" sid="ZEC 6:3"/>سٌي قِيشّيٍ نَن نُ نَ سْورِ رَفِسٍ سَشَن ندٍ بّندُنقٍ، سٌي مَكَتُنشِيٍ نَن نُ نَ سْورِ رَفِسٍ نَانِ ندٍ بّندُنقٍ. <verse eid="ZEC 6:3"/><verse number="4" style="v" sid="ZEC 6:4"/>ﭑ نَشَ مَلٍكّ مَشْرِن، نَشَن نُ وْيّنمَ ﭑ نَ، «ﭑ مَرِفِ، مُنسٍ يٍيٍ رَ؟»<verse eid="ZEC 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ZEC 6:5"/>مَلٍكّ نَشَ ﭑ يَابِ، «قٌيٍ نَانِ نَن عٍ رَ، دُنِحَ مَرِفِ نَ نَشٍيٍ رَ مِنِقٍ. <verse eid="ZEC 6:5"/><verse number="6" style="v" sid="ZEC 6:6"/>سٌي قْورّيٍ سِفَمَ حَمَنّ كْولَ نَن مَ، سٌي قِيشّيٍ سِفَمَ حَمَنّ سٌفٍفٌرٌدٍ نَن مَ، سٌي مَكَتُنشِيٍ سِفَمَ حَمَنّ يِرٍقَنيِ نَن مَ.» <verse eid="ZEC 6:6"/><verse number="7" style="v" sid="ZEC 6:7"/>يِ سٌي سّنبّمَيٍ تٌ نُ وَ مَ سِفَقٍ دُنِحَ عِحّرّدٍ، مَلٍكّ ندٍ نَشَ عَ قَلَ عٍ بّ، «وٌ سِفَ بْشِ عِحّرّدٍ.» عٍ نَشَ كٍلِ كٍرٍن نَ. <verse eid="ZEC 6:7"/><verse number="8" style="v" sid="ZEC 6:8"/>عَلَ نَشَ عَ قَلَ ﭑ بّ عَ شُي عِتٍشِ رَ، «عِ بَرَ عَ مَتٌ، نَشٍيٍ سِفَشِ حَمَنّ كْولَ مَ، عٍ بَرَ ﭑ وَشْنقٍ رَبَ نَا.»<verse eid="ZEC 6:8"/></para>
  <para style="s">يٌسُوٍ شَ مَنفّيَ</para>
  <para style="p">
    <verse number="9" style="v" sid="ZEC 6:9"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛ <verse eid="ZEC 6:9"/><verse number="10" style="v" sid="ZEC 6:10"/>«شٍلٍدَيِ، تٌبِيَ، نُن يّدَيَ نَ قَ كٍلِقٍ كٌنيِيَ كُي بَبِلْن بْشِ مَ، عِ شَ عٍ شَ قَنفَدَ مَيٍ رَ سُشُ. نَ لْشْي عِ شَ سِفَ سٌقٌنِ شَ دِ يٌسِيَ يِرٍ <verse eid="ZEC 6:10"/><verse number="11" style="v" sid="ZEC 6:11"/>نَ فبٍتِ نُن نَ شّيمَ رَ. عِ شَ مَنفّيَ تْنشُمَ رَقَلَ نَ رَ، عِ قَ عَ دْشْ سّرّشّدُبّ كُنتِفِ يٌسُوٍ شُن مَ، يٍهٌسَدَكِ شَ دِ. <verse eid="ZEC 6:11"/><verse number="12" style="v" sid="ZEC 6:12"/>عِ شَ عَ قَلَ عَ بّ، ‹مَنفّ عَلَتَلَ شَ مَسٍنيِ نَن يَ؛ يِ مِشِ نَشَن شِلِ «سَلٌنيِ.» نَ سَلٌنيِ بُلَمَ نّ، عَ قَ عَلَتَلَ شَ هْرْ مْبَنشِ تِ. <verse eid="ZEC 6:12"/><verse number="13" style="v" sid="ZEC 6:13"/>عَ تَن نَن عَلَتَلَ شَ هْرْ مْبَنشِ تِمَ، مَنفّيَ تْنشُمَ لُمَ نّ عَ يِ، عَ دْشْ عَ شَ كِبَنيِ كُي، عَ حَمَ يَمَرِ. سّرّشّدُبّ ندٍ قَن دْشْمَ نّ عَ شَ كِبَنيِ كُي. بْحّسَ لُ عٍ قِرِنيِ تَفِ.› <verse eid="ZEC 6:13"/><verse number="14" style="v" sid="ZEC 6:14"/>مَنفّيَ تْنشُمَ لُمَ نّ عَلَتَلَ شَ هْرْ مْبَنشِ كُي هٍلٍمِ، تٌبِيَ، يّدَيَ، نُن سٌقٌنِ شَ دِ هٍنِ يِ رَ.»<verse eid="ZEC 6:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ZEC 6:15"/>«مِشِ نَشٍيٍ مَكُيَ، نٍيٍ قَمَ نّ عَلَتَلَ شَ هْرْ مْبَنشِ تِدٍ. نَ كُي وٌ عَ كٌلٌنمَ نّ عَ مَنفّ عَلَتَلَ نَن ﭑ شّيشِ وٌ مَ. نَ بِرِن قَمَ نّ رَبَدٍ شَ وٌ وٌ مَرِفِ عَلَتَلَ شُي سُشُ عَ قَنيِ رَ.»<verse eid="ZEC 6:15"/></para>
  <chapter eid="ZEC 6"/>
  <chapter number="7" style="c" sid="ZEC 7"/>
  <para style="s">سُنيِ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 7:1"/>دَرِيُسِ شَ مَنفّيَ حّ نَانِ ندٍ، كِسِلٍوِ كِكٍ سٌلٌمَنَانِ ندٍ، شِ نَانِ ندٍ لْشْي، عَلَتَلَ نَشَ مَسٍنيِ تِ عَننَبِ سَكَرِ بّ. <verse eid="ZEC 7:1"/><verse number="2" style="v" sid="ZEC 7:2"/>بٍتٍلِكَيٍ نُ بَرَ سَرٍ سٍرِ نُن رٍفٍمِ مٍلٍكِ نُن عٍ شَ مِشِيٍ شّي عَلَتَلَ مَشَندِدٍ. <verse eid="ZEC 7:2"/><verse number="3" style="v" sid="ZEC 7:3"/>عٍ مَن شَ مَنفّ عَلَتَلَ شَ سّرّشّدُبّيٍ، نَشٍيٍ نُ نَ هْرْ مْبَنشِ كُي، عَ نُن نَمِحْنمّيٍ مَشْرِن، «مُشُ لَن مُشُ شَ مُشُ وَ شُي رَ مِنِ كِكٍ سُولِ ندٍ رَ، مُشُ شَ سُنيِ سُشُ عَلْ مُشُ عَ رَبَشِ حّ وُيَشِيٍ رَ كِ نَشّ؟»<verse eid="ZEC 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ZEC 7:4"/>مَنفّ عَلَتَلَ نَشَ مَسٍنيِ تِ ﭑ بّ يِ كِ، <verse eid="ZEC 7:4"/><verse number="5" style="v" sid="ZEC 7:5"/>«حَمَ نُن سّرّشّدُبّيٍ مَشْرِن ﭑ بّ، ‹وٌ تٌ نُ سُنيِ سُشُمَ سُننُنيِ كُي نَ كِكٍ سُولِ ندٍيٍ نُن نَ كِكٍ سٌلٌقٍرٍ ندٍيٍ حّ تٌنفٌ سٌلٌقٍرٍ بُن مَ، وٌ نُ سُنمَ ﭑ تَن نَن بّ؟ <verse eid="ZEC 7:5"/><verse number="6" style="v" sid="ZEC 7:6"/>وٌ تٌ نُ وٌ دّفٍمَ نُن وٌ وٌ مِنمَ، وٌ مُ عَ رَبَشِ وٌ يّتّ شَ بّ؟ <verse eid="ZEC 7:6"/><verse number="7" style="v" sid="ZEC 7:7"/>عَلَتَلَ مُ نَ مَسٍنيِ مْولِ تِ عَ شَ نَمِحْنمّ سِنفٍيٍ سَابُي شَ رَ، دَرِ سَلَمُ نُن عَ رَبِلِنيِ نُ سَبَتِشِ بْحّسَ كُي تّمُي نَشّ؟ نَ تّمُي، مِشِيٍ نُ نَ نٍفٍوِ نُن سٍقٍلَ بْشِ مَ.›»<verse eid="ZEC 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ZEC 7:8"/>عَلَتَلَ نَشَ مَسٍنيِ تِ عَننَبِ سَكَرِ بّ يِ كِ، <verse eid="ZEC 7:8"/><verse number="9" style="v" sid="ZEC 7:9"/>«مَنفّ عَلَتَلَ شَ مَسٍنيِ نَن يَ؛ ‹وٌ شَ كِيتِ سَ تِنشِنيِ كُي. وٌ شَ هِننّ وٌ بٌورٍ رَ كِنِكِنِ كُي. <verse eid="ZEC 7:9"/><verse number="10" style="v" sid="ZEC 7:10"/>وٌ نَشَ كَاحّ فِنّيٍ، كِرِدِيٍ، بْشِ شْحّيٍ، نُن سٍتَرٍيٍ تْورْ. وٌ نَشَ نَتّ حَاشِ تٌنفٌ وٌ بْحّ كُي وٌ بٌورٍيٍ شَ قٍ رَ.› <verse eid="ZEC 7:10"/><verse number="11" style="v" sid="ZEC 7:11"/>كْنْ عٍ مُ تِن نَ مَسٍنيِ رَ، عٍ نَشَ عٍ كٌبٍ سٌ، عٍ مُ عٍ تُلِ مَتِ نَ رَ. <verse eid="ZEC 7:11"/><verse number="12" style="v" sid="ZEC 7:12"/>عٍ بْحّيٍ نَشَ شْرْشْ عَلْ دِيَمَن، عٍ نَشَ تٌندِ مَنفّ عَلَتَلَ شَ سّرِيّ سُشُدٍ، عَ شَشِلِ سّنِيّنشِ نُ بَرَ نَشَن نَسَنبَ نَمِحْنمّ سِنفٍيٍ مَ. نَ نَن عَ رَ مَنفّ عَلَتَلَ نَشَ شْنْ عٍ مَ عَ بٍلٍبٍلٍ رَ. <verse eid="ZEC 7:12"/><verse number="13" style="v" sid="ZEC 7:13"/>عَ تٌ عٍ شِلِ، عٍ نَشَ تٌندِ عَ شُي سُشُدٍ. يَكْسِ، شَ عٍ تَن بَرَ عَ شِلِ، عَ مُ عٍ شَ مَشَندِ سُشُمَ دٍ.» مَنفّ عَلَتَلَ شَ مَسٍنيِ نَن يَ، <verse eid="ZEC 7:13"/><verse number="14" style="v" sid="ZEC 7:14"/>«ﭑ عٍ رَيٍنسٍن نّ سِيٍ بِرِن يَ مَ عٍ مُ نَشٍيٍ كٌلٌن. عٍ تٌ كٍلِ عٍ شَ بْشِ مَ، دّننَشّ نُ بَرَ رَبّحِن، مِشِ يٌ مُ دَنفِمَ دّننَشّ، مِشِ يٌ مُ سِفَمَ دّننَشّ. بْشِ قَنيِ قِندِ فبَلٌي بْشِ رَ عٍ تَن نَن سَابُي رَ.»<verse eid="ZEC 7:14"/></para>
  <chapter eid="ZEC 7"/>
  <chapter number="8" style="c" sid="ZEC 8"/>
  <para style="s">عَلَ شَ لَايِدِ دَرِ سَلَمُ شَ قٍ رَ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 8:1"/>مَنفّ عَلَتَلَ شَ مَسٍنيِ نَن يَ؛ <verse eid="ZEC 8:1"/><verse number="2" style="v" sid="ZEC 8:2"/>مَنفّ عَلَتَلَ نَشَ عَ مَسٍن، «ﭑ مُ وَ مَ ﭑ قِرِن ندٍ شْن سِيٌن. ﭑ مَ حَمَ شَ قٍ شْرْشْ ﭑ مَ كِ قَنيِ.» <verse eid="ZEC 8:2"/><verse number="3" style="v" sid="ZEC 8:3"/>عَلَتَلَ نَشَ عَ مَسٍن، «ﭑ مَن قَمَ نّ سِيٌن، ﭑ شَ لُ وٌ تَفِ دَرِ سَلَمُ. دَرِ سَلَمُ قَمَ نّ شِلِدٍ ‹تَا نْندِلَ.› مَنفّ عَلَتَلَ شَ فٍيَ قَمَ نّ شِلِدٍ ‹فٍيَ سّنِيّنشِ.›»<verse eid="ZEC 8:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ZEC 8:4"/>مَنفّ عَلَتَلَ شَ مَسٍنيِ نَن يَ؛ «شّمْشِيٍ نُن حّلّشّقٌرِيٍ مَن لُمَ نّ دَرِ سَلَمُ مَلَن يِرٍ، يِسُشُوُرِ سُشُ عٍ يِ عٍ شَ سِمَيَ شْننَكُيٍ شَ قٍ رَ. <verse eid="ZEC 8:4"/><verse number="5" style="v" sid="ZEC 8:5"/>دِ مّدِيٍ قَن لُمَ نّ بٍرٍ رَ تَا مَلَندٍيٍ.»<verse eid="ZEC 8:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ZEC 8:6"/>مَنفّ عَلَتَلَ شَ مَسٍنيِ نَن يَ، «هَلِ عَ قَ قِندِ تّرّننَ رَ يِ وَشَتِ حَمَ دْنشْي بّ، مَنفّ عَلَتَلَ مُ نْمَ كَابَدٍ نَ قٍ مَ.»<verse eid="ZEC 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ZEC 8:7"/>مَنفّ عَلَتَلَ شَ مَسٍنيِ نَن يَ، «ﭑ نَن ﭑ مَ حَمَ رَكِسِمَ نّ حَمَنّيٍ مَ نَشٍيٍ كٍلِمَ سٌفٍتٍدٍ نُن سٌفٍفٌرٌدٍ. <verse eid="ZEC 8:7"/><verse number="8" style="v" sid="ZEC 8:8"/>ﭑ عٍ رَفبِلٍنمَ نّ دَرِ سَلَمُ. عٍ قِندِ مَ نّ ﭑ مَ حَمَ رَ، ﭑ قَن قِندِ عٍ مَرِفِ عَلَ رَ نْندِ نُن تِنشِنيِ كُي.»<verse eid="ZEC 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ZEC 8:9"/>مَنفّ عَلَتَلَ شَ مَسٍنيِ نَن يَ، «وٌ وٌ سّنبّ سٌ، وٌ تَن نَشٍيٍ نُ بَرَ يِ مَسٍنيِ مّ نَمِحْنمّيٍ سَابُي رَ مَنفّ عَلَتَلَ شَ بَنشِ كْورِن تّمُي نَشّ. وٌ وٌ سّنبّ سٌ عَلَكٌ يِ بَنشِ شَ حْن. <verse eid="ZEC 8:9"/><verse number="10" style="v" sid="ZEC 8:10"/>بٍينُ نَ وَلِ شَ قْلْ، وَلِ سَرٍ يٌ مُ نُ نَ وَلِكّيٍ بّ. هَلِ نِنفٍيٍ مُ دٌنسٍ سْتْ عٍ شَ وَلِ كُي. وَلِ بِرِن مُ نُ نْمَ سْونّيَدٍ، بَرِ مَ ﭑ نُ بَرَ يَشُيحَ رَ مِنِ مِشِيٍ تَفِ. <verse eid="ZEC 8:10"/><verse number="11" style="v" sid="ZEC 8:11"/>كْنْ يَكْسِ ﭑ مُ يِ حَمَ دْنشْي تْورْ مَ عَلْ سِنفٍ.» مَنفّ عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="ZEC 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ZEC 8:12"/>«بْحّسَ لُمَ نّ بْشِ مَ. وّنِ بِلِيٍ بٌفِمَ نّ، بْشِ دَشَمُي رَ مِنِمَ نّ، تُنّ يٍ قَمَ نّ. ﭑ نَ بِرِن سٌمَ نّ يِ حَمَ دْنشْي يِ رَ عٍ كّ رَ. <verse eid="ZEC 8:12"/><verse number="13" style="v" sid="ZEC 8:13"/>سِنفٍ يُدَيَ بْنسْي نُن عِسِرَيِلَ بْنسْي قِندِ نّ دَنكّ رَ سِيٍ تَفِ، كْنْ يَكْسِ، ﭑ تٌ وٌ رَكِسِ، وٌ قِندِ مَ نّ عٍ بّ سَابُي رَ عٍ بَرَكّ سْتْ. وٌ نَشَ فَاشُ، وٌ وٌ سّنبّ سٌ.»<verse eid="ZEC 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ZEC 8:14"/>مَنفّ عَلَتَلَ شَ مَسٍنيِ نَن يَ، «وٌ بٍنبَيٍ تٌ ﭑ نَشْنْ، ﭑ نَشَ نَتّ تٌنفٌ ﭑ شَ وٌ حَشَنكَتَ. ﭑ مُ تِن فبِلٍندٍ نَ نَتّ قْشْ رَ. <verse eid="ZEC 8:14"/><verse number="15" style="v" sid="ZEC 8:15"/>كْنْ يَكْسِ ﭑ بَرَ نَتّ تٌنفٌ، ﭑ شَ قٍ قَنيِ رَبَ وٌ بّ، دَرِ سَلَمُ نُن يُدَيَ بْنسْي. وٌ نَشَ فَاشُ. <verse eid="ZEC 8:15"/><verse number="16" style="v" sid="ZEC 8:16"/>وٌ شَ يِ مَسٍنيِ رَبَتُ؛ وٌ شَ نْندِ قَلَ وٌ بٌورٍ بّ، وٌ شَ كِيتِ سَ نْندِ نُن تِنشِنيِ كُي. <verse eid="ZEC 8:16"/><verse number="17" style="v" sid="ZEC 8:17"/>حَاشُيحَ نَشَ لُ وٌ بْحّ كُي وٌ بٌورٍيٍ مَبِرِ. وٌ نَشَ وٌ كَلِ وُلٍ كُي، بَرِ مَ نَ قٍ مْولِ مُ رَقَن ﭑ مَ.» مَنفّ عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="ZEC 8:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ZEC 8:18"/>مَنفّ عَلَتَلَ شَ مَسٍنيِ نَن يَ، <verse eid="ZEC 8:18"/><verse number="19" style="v" sid="ZEC 8:19"/>«مَنفّ عَلَتَلَ نَشَ عَ مَسٍن وٌ سُنيِ نَشٍيٍ سُشُمَ كِكٍ نَانِ ندٍ، كِكٍ سُولِ ندٍ، كِكٍ سٌلٌقٍرٍ ندٍ، نُن كِكٍ قُ ندٍ رَ، نٍيٍ شَ قِندِ سَلِ سّيوّ دَاشِيٍ رَ. نْندِ نُن بْحّسَ شَ رَقَن وٌ مَ.»<verse eid="ZEC 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ZEC 8:20"/>مَنفّ عَلَتَلَ شَ مَسٍنيِ نَن يَ، «مِشِ فبٍفبٍ قَمَ نّ قَدٍ كٍلِقٍ حَمَنّ فبّتّيٍ مَ. <verse eid="ZEC 8:20"/><verse number="21" style="v" sid="ZEC 8:21"/>مِشِيٍ لُمَ سِفَ رَ يِرٍ فبّتّ عٍ سَ عَ قَلَ مّننِكَيٍ بّ، ‹وٌن شّي مَنفّ عَلَتَلَ مَشَندِدٍ، وٌن بِرِن نَ عَ رَ.› <verse eid="ZEC 8:21"/><verse number="22" style="v" sid="ZEC 8:22"/>سّنبّمَ وُيَشِيٍ كٍلِقٍ حَمَنّ فبّتّيٍ مَ، عٍ قَمَ نّ مَنفّ عَلَتَلَ قٍندٍ دَرِ سَلَمُ، عٍ عَ مَشَندِ.»<verse eid="ZEC 8:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ZEC 8:23"/>مَنفّ عَلَتَلَ شَ مَسٍنيِ نَن يَ، «نَ لْشْييٍ حَمَنّ فبّتّيٍ مِشِ قُ قَمَ نّ كَنكَندٍ يُوِقِ كٍرٍن مَ، عٍ قَ عَ قَلَ عَ بّ، ‹وٌن بِرِن نَ عَ رَ، بَرِ مَ مُشُ بَرَ عَ كٌلٌن عَلَ نَ وٌ قّ مَ.›»<verse eid="ZEC 8:23"/></para>
  <chapter eid="ZEC 8"/>
  <chapter number="9" style="c" sid="ZEC 9"/>
  <para style="s">سِ فبّتّيٍ شَ كِيتِ</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 9:1"/>عَلَتَلَ بَرَ مَسٍنيِ شْرْشْي تِ</para>
  <para style="q" vid="ZEC 9:1">شَدَرَكِ شَ بْشِ شَ قٍ رَ.</para>
  <para style="q" vid="ZEC 9:1">نَ مَسٍنيِ بَرَ دَ مَسِ تَا قَن لِ.</para>
  <para style="q" vid="ZEC 9:1">عَلَتَلَ فبٍ نَن عَدَ مَدِ بِرِن نَ،</para>
  <para style="q" vid="ZEC 9:1">عِسِرَيِلَ بْنسْييٍ قَن عَ فبٍ.<verse eid="ZEC 9:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ZEC 9:2"/>نَ مَسٍنيِ بَرَ شَمَتَ تَا لِ،</para>
  <para style="q" vid="ZEC 9:2">نَشَن نَ دَ مَسِ نَانِنيِ مَبِرِ.</para>
  <para style="q" vid="ZEC 9:2">عَ بَرَ تِرٍ نُن سِدْن قَن لِ،</para>
  <para style="q" vid="ZEC 9:2">هَلِ لْننِلَيٍ نَن تٌ عٍ رَ.<verse eid="ZEC 9:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ZEC 9:3"/>تِرٍ بَرَ تَا مَكَنتَشِ تِ،</para>
  <para style="q" vid="ZEC 9:3">عَ شَ فبٍتِ بَرَ فبٌ عَلْ مّيّنيِ،</para>
  <para style="q" vid="ZEC 9:3">عَ شَ شّيمَ بَرَ فبٌ عَلْ بٌورَ.<verse eid="ZEC 9:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ZEC 9:4"/>كْنْ مَرِفِ نَ بِرِن بَمَ نّ عَ يِ،</para>
  <para style="q" vid="ZEC 9:4">عَ عَ شَ تّتّ رَدِن بَا مَ، عَ قَ تَا فَن.<verse eid="ZEC 9:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ZEC 9:5"/>عَسِكَلْن نَ نَ تٌ،</para>
  <para style="q" vid="ZEC 9:5">عَ قَن لُمَ نّ فَاشُي كُي.</para>
  <para style="q" vid="ZEC 9:5">فَسَ نُن عٍكِرٌن قَن فَاشُمَ نّ،</para>
  <para style="q" vid="ZEC 9:5">عٍ سّرّنمَ نّ بَرِ مَ عٍ شَ شُننَكٍلِ بَرَ قِندِ يَافِ رَ.</para>
  <para style="q" vid="ZEC 9:5">فَسَ مَنفّ قَشَمَ نّ،</para>
  <para style="q" vid="ZEC 9:5">مِشِ يٌ مُ لُمَ عَسِكَلْن سْنْن.<verse eid="ZEC 9:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ZEC 9:6"/>سِ مَسُنبُشِ قَمَ نّ سَبَتِدٍ عَسِدٌدِ.</para>
  <para style="q" vid="ZEC 9:6">«ﭑ قِلِسِتَكَيٍ شَ يّتّ عِفبٌحَ رَفٌرٌ مَ نّ.<verse eid="ZEC 9:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="ZEC 9:7"/>ﭑ قَشّ تِقٍ حْنمَ نّ مّننِ.»</para>
  <para style="q" vid="ZEC 9:7">حَمَ دْنشْي قَمَ نّ بِرَدٍ مُشُ مَرِفِ عَلَ قْشْ رَ.</para>
  <para style="q" vid="ZEC 9:7">عٍ سَبَتِمَ نّ يُدَيَ شَبِلّيٍ يَ مَ.</para>
  <para style="q" vid="ZEC 9:7">عٍكِرٌن لُمَ نّ عَلْ يٍبُسُ.<verse eid="ZEC 9:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ZEC 9:8"/>«ﭑ نَ ﭑ مَ بَنشِ كَنتَ مَ نّ،</para>
  <para style="q" vid="ZEC 9:8">عَلَكٌ سْورِ فَلِ يٌ نَشَ عَ كَنَ.</para>
  <para style="q" vid="ZEC 9:8">نَشَن قَمَ، نَشَن دَنفِمَ،</para>
  <para style="q" vid="ZEC 9:8">عٍ مُ نْمَ سٍسٍ رَ،</para>
  <para style="q" vid="ZEC 9:8">بَرِ مَ يَكْسِ ﭑ حّنفِ سَشِ عَ شْن مَ.»<verse eid="ZEC 9:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="ZEC 9:9"/>سِيٌنكَيٍ، وٌ شَ حّلّشِن.</para>
  <para style="q" vid="ZEC 9:9">دَرِ سَلَمُكَيٍ، وٌ شَ وٌ شُي عِتٍ سّيوّ كُي.</para>
  <para style="q" vid="ZEC 9:9">وٌ شَ مَنفّ نَ قَقٍ وٌ يِرٍ.</para>
  <para style="q" vid="ZEC 9:9">عَ تِنشِن. عَ كِسِشِ.</para>
  <para style="q" vid="ZEC 9:9">عَ مُ عَ يّتّ عِفبٌمَ،</para>
  <para style="q" vid="ZEC 9:9">عَ سٌمَ تَا كُي سٌقَلٍ نَن قَرِ،</para>
  <para style="q" vid="ZEC 9:9">سٌقَلٍ شّمّمَ، سٌقَلٍ فِنّمَ شَ دِ.<verse eid="ZEC 9:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ZEC 9:10"/>«ﭑ سْورِ رَفِسٍ بَمَ نّ عٍقِرَ مِ بْشِ مَ،</para>
  <para style="q" vid="ZEC 9:10">ﭑ سٌييٍ بَمَ نّ دَرِ سَلَمُ.</para>
  <para style="q" vid="ZEC 9:10">فٍرٍ سٌ شَلِيٍ مُ لُمَ نَا.»</para>
  <para style="q" vid="ZEC 9:10">عَ بْحّسَ نَن مَسٍنمَ سِيٍ بّ.</para>
  <para style="q" vid="ZEC 9:10">عَ شَ مَنفّيَ شُنفبٌمَ نّ يِرٍ بِرِن،</para>
  <para style="q" vid="ZEC 9:10">كٍلِقٍ بَا شُنفبٍ مَ، عَ سَ دْشْ شُرٍ شُنفبٍ رَ.<verse eid="ZEC 9:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ZEC 9:11"/>«ﭑ بَرَ وٌ شَ مِشِ سُشُشِيٍ شُن سَرَ</para>
  <para style="q" vid="ZEC 9:11">وٌن مَ سَاتّ شَ قٍ رَ</para>
  <para style="q" vid="ZEC 9:11">نَشَن شِرِشِ سّرّشّ وُلِ دَاشِ رَ.</para>
  <para style="q" vid="ZEC 9:11">عٍ نُ نَ قٍ شْرْشْي كُي،</para>
  <para style="q" vid="ZEC 9:11">عَلْ مِشِ نَشٍيٍ رَفٌرٌشِ كْلْنيِ ندٍ كُي، يٍ مُ نَ نَشَن كُي.<verse eid="ZEC 9:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="ZEC 9:12"/>وٌ شَ فبِلٍن تَا مَكَنتَشِ كُي،</para>
  <para style="q" vid="ZEC 9:12">وٌ تَن فٍيلِمَنِ نَشٍيٍ شَشِلِ تِشِ ﭑ نَ.</para>
  <para style="q" vid="ZEC 9:12">تٌ ﭑ شَ عَ قَلَ وٌ بّ،</para>
  <para style="q" vid="ZEC 9:12">ﭑ وٌ هَرِفٍ رَفبِلٍنمَ نّ وٌ مَ،</para>
  <para style="q" vid="ZEC 9:12">ﭑ مَن قَ عَ شُنمَسَ.<verse eid="ZEC 9:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="ZEC 9:13"/>يُدَيَ قِندِ مَ نّ ﭑ مَ شَلِ رَ.</para>
  <para style="q" vid="ZEC 9:13">عٍقِرَ مِ لُمَ نّ عَلْ ﭑ مَ تَنبّيٍ.</para>
  <para style="q" vid="ZEC 9:13">سِيٌنِكَيٍ قِندِ مَ نّ ﭑ مَ سْورِيٍ رَ</para>
  <para style="q" vid="ZEC 9:13">فِرّكِكَيٍ شِلِ مَ.</para>
  <para style="q" vid="ZEC 9:13">ﭑ مَ سَنتِدّفّمَ نَن عِ رَ.»<verse eid="ZEC 9:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="ZEC 9:14"/>عَلَتَلَ عَ يّتّ مَكّنّنمَ نّ عٍ بّ،</para>
  <para style="q" vid="ZEC 9:14">عَ شَ تَنبّ لُ عَلْ سٍيَمَكْنيِ.</para>
  <para style="q" vid="ZEC 9:14">مَرِفِ عَلَتَلَ سَرَ قٍمَ نّ،</para>
  <para style="q" vid="ZEC 9:14">عَ لُ عَلْ تُرُننَادّ.<verse eid="ZEC 9:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="ZEC 9:15"/>مَنفّ عَلَتَلَ عٍ مَكَنتَمَ نّ.</para>
  <para style="q" vid="ZEC 9:15">عٍ شَ فٍرٍ سٌسٍيٍ كَنَرِ رَبَمَ نّ،</para>
  <para style="q" vid="ZEC 9:15">عٍ وُلِ عِقِلِ عَلْ سّرّشّدُبّيٍ</para>
  <para style="q" vid="ZEC 9:15">نَشَن شُرُ سٍ كْن نَشَبَمَ،</para>
  <para style="q" vid="ZEC 9:15">عٍ قَ نَ وُلِ كَسَن سّرّشّبَدٍ مَ.<verse eid="ZEC 9:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="ZEC 9:16"/>عٍ مَرِفِ عَلَتَلَ عٍ رَكِسِمَ نّ نَ لْشْي،</para>
  <para style="q" vid="ZEC 9:16">عَلْ شُرُ سٍ دّ مَدٌنيِ عَ شَ شُرُ سٍيٍ كَنتَمَ كِ نَشّ.</para>
  <para style="q" vid="ZEC 9:16">عَلَ شَ حَمَ لُمَ نّ عَلْ دِيَمَن نَشَن يَنبَمَ بْشِ مَ.<verse eid="ZEC 9:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="ZEC 9:17"/>عٍ تٌقَنمَ نّ، عٍ رَيَبُ.</para>
  <para style="q" vid="ZEC 9:17">بَلٌي قَنيِ سّفّتَلَيٍ شُنفبٌمَ نّ،</para>
  <para style="q" vid="ZEC 9:17">مِنسٍ قَنيِيٍ سُنفبُتُنيِيٍ رَيَبُ.<verse eid="ZEC 9:17"/></para>
  <chapter eid="ZEC 9"/>
  <chapter number="10" style="c" sid="ZEC 10"/>
  <para style="s">عَلَ شَ هِننّ</para>
  <para style="q">
    <verse number="1" style="v" sid="ZEC 10:1"/>وٌ شَ عَلَتَلَ مَشَندِ حّمّ تّمُي.</para>
  <para style="q" vid="ZEC 10:1">عَلَتَلَ قَمَ نّ تُنّ بٍلٍبٍلٍ رَ وٌ بّ،</para>
  <para style="q" vid="ZEC 10:1">عَلَكٌ وٌ شَ شّيٍ شَ قَن.<verse eid="ZEC 10:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ZEC 10:2"/>كُيٍيٍ وُلٍ قَلَمَ،</para>
  <para style="q" vid="ZEC 10:2">سٍمَتٌييٍ مُ نْندِ تٌمَ،</para>
  <para style="q" vid="ZEC 10:2">عٍ شِيٍيٍ قَسَرِ مَ وُلٍ رَ،</para>
  <para style="q" vid="ZEC 10:2">عٍ شَ مَدُندُي قُقَقُ نَ عَ رَ.</para>
  <para style="q" vid="ZEC 10:2">نَ بِرِن بَرَ عَ نِيَ حَمَ شَ لْي عَلْ شُرُ سٍيٍ.</para>
  <para style="q" vid="ZEC 10:2">عٍ نَ تْورّ كُي بَرِ مَ شُرُ سٍ دّ مَدٌنيِ مُ نَ عٍ بّ.<verse eid="ZEC 10:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ZEC 10:3"/>ﭑ بَرَ شْنْ نَ شُرُ سٍ دّ مَدٌنيِيٍ مَ.</para>
  <para style="q" vid="ZEC 10:3">ﭑ عٍ شَ يَرٍرَتِيٍ حَشَنكَتَمَ نّ.</para>
  <para style="q" vid="ZEC 10:3">يُدَيَ لُمَ نّ عَلْ مَنفّ عَلَتَلَ شَ شُرُ سٍيٍ،</para>
  <para style="q" vid="ZEC 10:3">عَ مّينِمَ نّ عٍ مَ.</para>
  <para style="q" vid="ZEC 10:3">عٍ قَمَ نّ بِنيّ سْتْدٍ،</para>
  <para style="q" vid="ZEC 10:3">عَلْ سْورِ مَنفّ شَ سٌي.<verse eid="ZEC 10:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ZEC 10:4"/>مِشِ ندٍ كٍلِمَ نّ يُدَيَ</para>
  <para style="q" vid="ZEC 10:4">نَشَن مِسَالِمَ فّمّ رَ بَنشِ تِشِ نَشَن قَرِ،</para>
  <para style="q" vid="ZEC 10:4">نَشَن مِسَالِمَ وُرِ رَ كِرِ بَنشِ شِرِشِ نَشَن نَ،</para>
  <para style="q" vid="ZEC 10:4">نَشَن مِسَالِمَ شَلِ فٍرٍ سٌسٍ رَ.</para>
  <para style="q" vid="ZEC 10:4">مَنفّ بِرِن قَتَنشِ يُدَيَ بْنسْي نَن نَ.<verse eid="ZEC 10:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ZEC 10:5"/>يُدَيَكَيٍ قِندِ مَ نّ سّنبّمَيٍ رَ،</para>
  <para style="q" vid="ZEC 10:5">نَشٍيٍ عٍ يَشُييٍ مَبٌرٌنمَ فٍرٍ كُي،</para>
  <para style="q" vid="ZEC 10:5">بَرِ مَ عَلَتَلَ نَ عٍ قّ مَ.</para>
  <para style="q" vid="ZEC 10:5">عٍ يَشُييٍ شَ سٌي رَفِمَيٍ لُمَ نّ يَافِ كُي.<verse eid="ZEC 10:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="ZEC 10:6"/>«ﭑ يُدَيَ بْنسْي شُن نَكٍلِمَ نّ،</para>
  <para style="q" vid="ZEC 10:6">ﭑ يُسُقُ بْنسْي رَكِسِ،</para>
  <para style="q" vid="ZEC 10:6">ﭑ عٍ شَ تَايٍ يَءِلَن،</para>
  <para style="q" vid="ZEC 10:6">بَرِ مَ ﭑ بَرَ كِنِكِنِ عٍ مَ.</para>
  <para style="q" vid="ZEC 10:6">عٍ قَمَ نّ لُدٍ عَلْ ﭑ مُ عٍ رَبّحِن.</para>
  <para style="q" vid="ZEC 10:6">عٍ مَرِفِ عَلَتَلَ نَن ﭑ نَ،</para>
  <para style="q" vid="ZEC 10:6">ﭑ عٍ شَ دُبَ سُشُمَ نّ.<verse eid="ZEC 10:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="ZEC 10:7"/>عٍقِرَ مِ بْنسْي قَن قِندِ مَ نّ سّنبّمَيٍ رَ.</para>
  <para style="q" vid="ZEC 10:7">عٍ سّيوَ مَ نّ دَنفِقٍ سِيسِلَيٍ رَ.</para>
  <para style="q" vid="ZEC 10:7">عٍ شَ دِيٍ نَ بِرِن تٌمَ نّ، عٍ قَن حّلّشِن.</para>
  <para style="q" vid="ZEC 10:7">عٍ بِرِن بْحّ سّيوَ مَ نّ عَلَتَلَ شَ قٍ رَ.<verse eid="ZEC 10:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ZEC 10:8"/>ﭑ نَن ﭑ مَ حَمَ مَشِلِمَ نّ،</para>
  <para style="q" vid="ZEC 10:8">ﭑ شَ عٍ شُن سَرَ،</para>
  <para style="q" vid="ZEC 10:8">عٍ شَ وُيَ دَنفِقٍ سِنفٍ رَ.<verse eid="ZEC 10:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ZEC 10:9"/>هَلِ ﭑ تٌ عٍ رَيٍنسٍنشِ سِيٍ يَ مَ،</para>
  <para style="q" vid="ZEC 10:9">عٍ عٍ رَتُمَ نّ ﭑ مَ قٍ مَ يِرٍ مَكُيٍ.</para>
  <para style="q" vid="ZEC 10:9">عٍ تَن نُن عٍ شَ دِيٍ كِسِمَ نّ،</para>
  <para style="q" vid="ZEC 10:9">عٍ مَن قَ فبِلٍن عٍ شْنيِ.<verse eid="ZEC 10:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ZEC 10:10"/>ﭑ عٍ رَقَمَ نّ كٍلِقٍ مِسِرَ بْشِ مَ،</para>
  <para style="q" vid="ZEC 10:10">ﭑ عٍ مَلَن كٍلِقٍ عَسِرِيَ بْشِ مَ.</para>
  <para style="q" vid="ZEC 10:10">ﭑ مَن فَلَدِ نُن لِبَن بْشِ قِمَ نّ عٍ مَ،</para>
  <para style="q" vid="ZEC 10:10">كْنْ عٍ كْنتِ دَنفِمَ نّ نَ بِرِن نَ.<verse eid="ZEC 10:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ZEC 10:11"/>عٍ شَ تْورّ بَرَ لُ عَلْ بَا مْرْنيِيٍ،</para>
  <para style="q" vid="ZEC 10:11">كْنْ عَلَ نَ مْرْنيِيٍ رَفٌرٌ مَ نّ.</para>
  <para style="q" vid="ZEC 10:11">نِلِ شُرٍ بَرَ عَ نِيَ عٍ شَ لُ كٌنيِيَ كُي،</para>
  <para style="q" vid="ZEC 10:11">كْنْ نَ شُرٍ بَرَ شْرِ.</para>
  <para style="q" vid="ZEC 10:11">عَسِرِيَ شَ يّتّ عِفبٌحَ فٌرٌ مَ نّ،</para>
  <para style="q" vid="ZEC 10:11">مِسِرَ شَ مَنفّيَ حْن.<verse eid="ZEC 10:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="ZEC 10:12"/>ﭑ تَن نَن عٍ سّنبّ سٌمَ،</para>
  <para style="q" vid="ZEC 10:12">عٍ قَمَ نّ حّرّدٍ ﭑ شِلِ رَ.»</para>
  <para style="q" vid="ZEC 10:12">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="ZEC 10:12"/></para>
  <chapter eid="ZEC 10"/>
  <chapter number="11" style="c" sid="ZEC 11"/>
  <para style="s">شُرُ سٍ دّ مَدٌنيِيٍ</para>
  <para style="q">
    <verse number="1" style="v" sid="ZEC 11:1"/>لِبَن بْشِ، عِ شَ وُرِ بِرِن قَمَ نّ فَندٍ.<verse eid="ZEC 11:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ZEC 11:2"/>وٌ قَمَ نّ وَدٍ وٌ شُي عِتٍشِ رَ،</para>
  <para style="q" vid="ZEC 11:2">بَرِ مَ سِثِرّ، سّدِرِ، نُن كٌندٍ بِلِيٍ قَمَ نّ بِرَدٍ.</para>
  <para style="q" vid="ZEC 11:2">بَسَن وٌندِ بٍلٍبٍلٍ بَرَ كَنَ.<verse eid="ZEC 11:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ZEC 11:3"/>شُرُ سٍ دّ مَدٌنيِيٍ وَ مَ نّ،</para>
  <para style="q" vid="ZEC 11:3">بَرِ مَ قِيلِ بَرَ كَنَ.</para>
  <para style="q" vid="ZEC 11:3">يّتّيٍ شَاحّمَ نّ،</para>
  <para style="q" vid="ZEC 11:3">بَرِ مَ يُرُدّن قْتْنيِ بَرَ كَنَ.<verse eid="ZEC 11:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ZEC 11:4"/>ﭑ مَرِفِ عَلَتَلَ عَ مَسٍن نّ،</para>
  <para style="q" vid="ZEC 11:4">«وٌ شَ شُرُ سٍيٍ دّ مَدٌن،</para>
  <para style="q" vid="ZEC 11:4">نَشٍيٍ قَمَ قَشَدٍ.<verse eid="ZEC 11:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ZEC 11:5"/>مِشِ نَشٍيٍ عٍ سَرَ مَ</para>
  <para style="q" vid="ZEC 11:5">عٍ قَمَ نّ عٍ كْن نَشَبَدٍ كِنِكِنِتَرٍحَ كُي.</para>
  <para style="q" vid="ZEC 11:5">نَشٍيٍ عٍ مَتِمَ عٍ عَ قَلَمَ نّ،</para>
  <para style="q" vid="ZEC 11:5">‹عَلَ تَنتُ. ﭑ بَرَ بَننَ.›</para>
  <para style="q" vid="ZEC 11:5">شُرُ سٍ دّ مَدٌنيِيٍ مُ كِنِكِنِمَ عٍ مَ.»<verse eid="ZEC 11:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ZEC 11:6"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="ZEC 11:6">«ﭑ قَن مُ كِنِكِنِمَ يِ حَمَ مَ.</para>
  <para style="q" vid="ZEC 11:6">ﭑ بَرَ عٍ بِرِن لُ عٍ بٌورٍ يِ رَ،</para>
  <para style="q" vid="ZEC 11:6">عٍ شَ مَنفّ يِ رَ،</para>
  <para style="q" vid="ZEC 11:6">عَلَكٌ حَمَ شَ حَشَنكَتَ.</para>
  <para style="q" vid="ZEC 11:6">ﭑ مُ مِشِ يٌ رَتَنفَمَ نَ مَ.»<verse eid="ZEC 11:6"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="7" style="v" sid="ZEC 11:7"/>نَ كُي ﭑ نَشَ شُرُ سٍيٍ تْورْشِ دّ مَدٌن، نَشٍيٍ نُ لَنشِ عٍ شَ قَشَ. ﭑ نَشَ يِسُشُوُرِ قِرِن تٌنفٌ. ﭑ نَشَ كٍرٍن شِلِ سَ «هِننّ،» بٌورٍ «لَنيِ.» ﭑ نَشَ شُرُ سٍيٍ دّ مَدٌن. <verse eid="ZEC 11:7"/><verse number="8" style="v" sid="ZEC 11:8"/>ﭑ نَشَ شُرُ سٍ دّ مَدٌنيِ سَشَن كٍرِ كِكٍ كٍرٍن بُن، بَرِ مَ عٍ مُ رَقَنشِ ﭑ مَ سْنْن، ﭑ قَن مُ رَقَنشِ عٍ مَ. <verse eid="ZEC 11:8"/><verse number="9" style="v" sid="ZEC 11:9"/>ﭑ نَشَ عَ قَلَ شُرُ سٍيٍ بّ، «ﭑ مُ وٌ دّ مَدٌنمَ سْنْن. نَشَن لَن عَ شَ قَشَ، عَ شَ قَشَ. نَشَن لَن عَ شَ سِفَ، عَ شَ سِفَ. نَشَن لَن عَ شَ لُ بٍ، عَ شَ عَ بٌورٍ قَشَ.» <verse eid="ZEC 11:9"/><verse number="10" style="v" sid="ZEC 11:10"/>ﭑ نَشَ ﭑ مَ يِسُشُوُرِ تٌنفٌ نَشَن شِلِ «هِننّ،» ﭑ نَشَ عَ عِفِرَ. نَ مِسَالِشِ سَاتّ نَن نَ نَشَن شِرِشِ ﭑ تَن نُن سِيٍ بِرِن تَفِ. نَ سَاتّ بَرَ كَنَ. <verse eid="ZEC 11:10"/><verse number="11" style="v" sid="ZEC 11:11"/>ﭑ تٌ نَ كَنَ شُرُ سٍيٍ تْورْشِ يَ شْرِ، عٍ نَشَ عَ كٌلٌن ﭑ نُ بَرَ عَلَتَلَ شَ مَسٍنيِ قَلَ. <verse eid="ZEC 11:11"/><verse number="12" style="v" sid="ZEC 11:12"/>ﭑ نَشَ عَ قَلَ عٍ بّ، «شَ عَ وٌ كّنّن، وٌ ﭑ مَ وَلِ سَرٍ قِ ﭑ مَ، شَ نَ مُ عَ رَ وٌ عَ لُ نَ.» عٍ نَشَ كْبِرِ كٌلٍ تٌنفٌ سَشَن قِ ﭑ مَ وَلِ سَرٍ رَ. <verse eid="ZEC 11:12"/><verse number="13" style="v" sid="ZEC 11:13"/>عَلَتَلَ نَشَ عَ قَلَ ﭑ بّ، «شَ عٍ ﭑ مَ وَلِ تِدٍ تٌمَ نَ كِ نّ، عَ سَرٍ مُ فبٌ، عَ وْلّ. قّحّ يَءِلَنمَ شَ نَ تٌنفٌ.» ﭑ نَشَ نَ كْبِرِ كٌلٍ تٌنفٌ سَشَن تٌنفٌ، ﭑ نَشَ عٍ وْلّ عَلَتَلَ شَ بَنشِ كُي مِشِ ندٍ بّ نَشَن قّحّيٍ يَءِلَنمَ. <verse eid="ZEC 11:13"/><verse number="14" style="v" sid="ZEC 11:14"/>نَ دَنفِ شَنبِ، ﭑ نَشَ ﭑ مَ يِسُشُوُرِ عِفِرَ نَشَن نُ شِلِ «لَنيِ،» بَرِ مَ لَنيِ مُ نَ يُدَيَ نُن عِسِرَيِلَ تَفِ سْنْن.<verse eid="ZEC 11:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ZEC 11:15"/>عَلَتَلَ نَشَ عَ قَلَ ﭑ بّ، «عِ مَن شَ شُرُ سٍ دّ مَدٌنيِ شَشِلِتَرٍ شَ وَلِسٍيٍ تٌنفٌ. <verse eid="ZEC 11:15"/><verse number="16" style="v" sid="ZEC 11:16"/>ﭑ شُرُ سٍ دّ مَدٌنيِ رَكٍلِمَ نّ يِ بْشِ مَ نَشَن مُ عَ حّنفِ سَمَ شُرُ سٍيٍ شْن مَ. شَ شُرُ سٍ كٍرٍن بَرَ لْي، عَ مُ سِفَمَ عَ قٍندٍ. شَ كٍرٍن بَرَ مَشْنْ، عَ مُ عَ دَندَنمَ. شَ كٍرٍن بَرَ شُنفبٌ قْلْ، عَ عَ سُبٍ بِرِن دٌنمَ نّ هَن عَ عَ تٌرٍ لِ.»<verse eid="ZEC 11:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="ZEC 11:17"/>«حَشَنكَتّ نَ شُرُ سٍ دّ مَدٌنيِ حَاشِ بّ،</para>
  <para style="q" vid="ZEC 11:17">نَشَن شُرُ سٍيٍ رَبّحِنمَ.</para>
  <para style="q" vid="ZEC 11:17">سَنتِدّفّمَ شَ عَ بّلّشّ سّفّ،</para>
  <para style="q" vid="ZEC 11:17">عَ شَ عَ يَ سْشْ.</para>
  <para style="q" vid="ZEC 11:17">عَ بّلّشّ نَشَ نْ قٍقٍ رَ،</para>
  <para style="q" vid="ZEC 11:17">عَ يَ نَشَ قٍ يٌ تٌ.»<verse eid="ZEC 11:17"/></para>
  <chapter eid="ZEC 11"/>
  <chapter number="12" style="c" sid="ZEC 12"/>
  <para style="s">يُدَيَ شَ شُننَكٍلِ</para>
  <para style="q">
    <verse number="1" style="v" sid="ZEC 12:1"/>عَلَتَلَ بَرَ مَسٍنيِ شْرْشْي تِ عِسِرَيِلَ شَ قٍ رَ.</para>
  <para style="q" vid="ZEC 12:1">عَلَتَلَ شَ مَسٍنيِ نَن يَ،</para>
  <para style="q" vid="ZEC 12:1">نَشَن كٌورٍ نُن بْشِ دَاشِ،</para>
  <para style="q" vid="ZEC 12:1">نَشَن شَشِلِ سٌ عَدَ مَدِ يِ رَ؛<verse eid="ZEC 12:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ZEC 12:2"/>«ﭑ قٍ شُنفبٍ رَبَمَ نّ دَرِ سَلَمُ بّ،</para>
  <para style="q" vid="ZEC 12:2">دُنِحَ سِيٍ تَفِ.</para>
  <para style="q" vid="ZEC 12:2">مِشِ نَ قَ دَرِ سَلَمُ فٍرٍدٍ،</para>
  <para style="q" vid="ZEC 12:2">ﭑ كَابَنَكٌ رَبَمَ نّ يُدَيَ بّ.<verse eid="ZEC 12:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ZEC 12:3"/>نَ لْشْي، ﭑ دَرِ سَلَمُ قِندِ مَ نّ فّمّ بِنيٍ رَ سِ بِرِن بّ.</para>
  <para style="q" vid="ZEC 12:3">نَشَن كَتَمَ نَ عِتٍقٍ رَ،</para>
  <para style="q" vid="ZEC 12:3">نَ كَنيِ مَشْنْمَ نّ.</para>
  <para style="q" vid="ZEC 12:3">دُنِحَ سِ بِرِن مَلَنمَ نّ عَ شِلِ مَ.»<verse eid="ZEC 12:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ZEC 12:4"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="ZEC 12:4">«نَ لْشْي، ﭑ سْورِ نُن عَ شَ سٌي رَدَشُمَ نّ.</para>
  <para style="q" vid="ZEC 12:4">ﭑ نٍيٍ قِندِ دْنشُي رَ.</para>
  <para style="q" vid="ZEC 12:4">ﭑ يُدَيَ بْنسْي مَتٌمَ نّ،</para>
  <para style="q" vid="ZEC 12:4">ﭑ نَن ﭑ حّنفِ سَ عٍ شْن مَ.<verse eid="ZEC 12:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ZEC 12:5"/>يُدَيَ مَنفّيٍ عَ قَلَمَ نّ عٍ بْحّ كُي،</para>
  <para style="q" vid="ZEC 12:5">‹دَرِ سَلَمُكَيٍ سّنبّ فبٌشِ</para>
  <para style="q" vid="ZEC 12:5">عٍ مَرِفِ عَلَتَلَ نَن سَابُي رَ.›<verse eid="ZEC 12:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ZEC 12:6"/>نَ لْشْي، ﭑ يُدَيَ مَنفّيٍ لُمَ نّ</para>
  <para style="q" vid="ZEC 12:6">عَلْ تّ وٌلٍنشِ يٍفٍ شْورَ،</para>
  <para style="q" vid="ZEC 12:6">شَ نَ مُ عَلْ تّ نَ دِن سّشّ رَ.</para>
  <para style="q" vid="ZEC 12:6">عٍ قَمَ نّ سِ بِرِن هَلَكِدٍ نَشَن نَ عٍ رَبِلِنيِ.</para>
  <para style="q" vid="ZEC 12:6">دَرِ سَلَمُ مُ كَنَمَ.<verse eid="ZEC 12:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="ZEC 12:7"/>عَلَتَلَ يُدَيَ تَايٍ نَن سِنفٍ رَكِسِمَ،</para>
  <para style="q" vid="ZEC 12:7">عَلَكٌ دَوُدَ شَبِلّ نُن دَرِ سَلَمُكَيٍ</para>
  <para style="q" vid="ZEC 12:7">شَ بِنيّ نَشَ دَنفِ يُدَيَ مِشِيٍ رَ.<verse eid="ZEC 12:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ZEC 12:8"/>نَ لْشْي، عَلَتَلَ دَرِ سَلَمُكَيٍ مَكَنتَمَ نّ.</para>
  <para style="q" vid="ZEC 12:8">عَلَ عَ نِيَمَ نّ مِشِ تَفَنشِ شَ دَوُدَ سّنبّ سْتْ.</para>
  <para style="q" vid="ZEC 12:8">دَوُدَ شَبِلّ سّنبّ فبٌمَ نّ عَلَ سَابُي رَ.</para>
  <para style="q" vid="ZEC 12:8">عَلَتَلَ شَ مَلٍكّ عَ حّرّ مَ نّ عٍ يَ رَ.<verse eid="ZEC 12:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ZEC 12:9"/>نَ لْشْي، ﭑ سِ بِرِن هَلَكِمَ نّ</para>
  <para style="q" vid="ZEC 12:9">نَشٍيٍ دَرِ سَلَمُ فٍرٍ مَ.<verse eid="ZEC 12:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="ZEC 12:10"/>ﭑ هِننّ نُن كِنِكِنِ لُمَ نّ</para>
  <para style="q" vid="ZEC 12:10">دَوُدَ شَبِلّ نُن دَرِ سَلَمُكَيٍ شَشِلِ مَ.</para>
  <para style="q" vid="ZEC 12:10">عٍ قَمَ نّ عٍ يَ رَقِندِدٍ ﭑ مَ، عٍ ﭑ تَن نَشَن سْشْشِ.</para>
  <para style="q" vid="ZEC 12:10">عٍ سُننُنمَ نّ ﭑ مَ قٍ رَ،</para>
  <para style="q" vid="ZEC 12:10">عَلْ مِشِ نَشَن شَ دِ سِنفٍ بَرَ قَشَ.</para>
  <para style="q" vid="ZEC 12:10">عٍ عٍ وَ شُي رَ مِنِمَ نَ كِ نّ.<verse eid="ZEC 12:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ZEC 12:11"/>نَ لْشْي، سُننُنيِ فبٌمَ نّ دَرِ سَلَمُ،</para>
  <para style="q" vid="ZEC 12:11">عَلْ هَدَدَ رِ مْن سُننُنشِ مٍفِدٌ فُلُنبَ كُي كِ نَشّ.<verse eid="ZEC 12:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="ZEC 12:12"/>حَمَ بِرِن سُننُنمَ نّ شَبِلّ كِ مَ.</para>
  <para style="q" vid="ZEC 12:12">دَوُدَ شَبِلّ لُمَ نّ عَ شَتِ مَ.</para>
  <para style="q" vid="ZEC 12:12">نَتَن شَبِلّ قَن لُمَ نّ عَ شَتِ مَ.</para>
  <para style="q" vid="ZEC 12:12">شّمّيٍ نُن فِنّيٍ مُ سُننُنمَ يِرٍ كٍرٍن.<verse eid="ZEC 12:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="ZEC 12:13"/>لٍوِ شَبِلّ لُمَ نّ عَ شَتِ مَ.</para>
  <para style="q" vid="ZEC 12:13">سِمٍيِ شَبِلّ لُمَ نّ عَ شَتِ مَ.</para>
  <para style="q" vid="ZEC 12:13">شّمّيٍ نُن فِنّيٍ مُ سُننُنمَ يِرٍ كٍرٍن.<verse eid="ZEC 12:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="ZEC 12:14"/>شَبِلّ بِرِن لُمَ نّ عَ شَتِ مَ.»<verse eid="ZEC 12:14"/></para>
  <chapter eid="ZEC 12"/>
  <chapter number="13" style="c" sid="ZEC 13"/>
  <para style="s">حَمَ سّنِيّنشِ</para>
  <para style="q">
    <verse number="1" style="v" sid="ZEC 13:1"/>نَ لْشْي، دُلٌنيِ مِنِمَ نّ</para>
  <para style="q" vid="ZEC 13:1">نَشَن نْمَ دَوُدَ شَبِلّ نُن دَرِ سَلَمُكَيٍ</para>
  <para style="q" vid="ZEC 13:1">يُنُبِ بَدٍ.<verse eid="ZEC 13:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ZEC 13:2"/>مَنفّ عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="ZEC 13:2">«نَ لْشْي، ﭑ كُيٍيٍ شِلِ بَمَ نّ وٌ دّ كُي،</para>
  <para style="q" vid="ZEC 13:2">وٌ نّيمُ عٍ مَ.</para>
  <para style="q" vid="ZEC 13:2">ﭑ عٍ شَ نَمِحْنمّيٍ نُن عٍ شَ سّنِيّنتَرٍحَ كٍرِ مَ نّ.<verse eid="ZEC 13:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ZEC 13:3"/>شَ مِشِ ندٍ سُو سَمَ نَمِحْنمّ مَسٍنيِ تِدٍ،</para>
  <para style="q" vid="ZEC 13:3">عَ نفَ نُن عَ بَبَ نَشَن عَ بَرِشِ عٍ عَ قَلَمَ عَ بّ،</para>
  <para style="q" vid="ZEC 13:3">‹عِ شَ قَشَ، بَرِ مَ عِ بَرَ وُلٍ قَلَ عَلَتَلَ شِلِ رَ.›</para>
  <para style="q" vid="ZEC 13:3">عَ نفَ نُن عَ بَبَ نَشَن عَ بَرِشِ،</para>
  <para style="q" vid="ZEC 13:3">عٍ عَ سْشْمَ نّ نَ مَسٍنيِ شَ قٍ رَ.<verse eid="ZEC 13:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ZEC 13:4"/>نَ لْشْي، نَمِحْنمّيٍ بِرِن يَافِمَ نّ</para>
  <para style="q" vid="ZEC 13:4">عٍ شَ مَسٍنيِيٍ شَ قٍ رَ.</para>
  <para style="q" vid="ZEC 13:4">عٍ مُ نَمِحْنمّ دُفِ رَفٌرٌ مَ عٍ مَ سْنْن</para>
  <para style="q" vid="ZEC 13:4">عَلَكٌ عٍ شَ مِشِ مَدَشُ.<verse eid="ZEC 13:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ZEC 13:5"/>عٍ بِرِن عَ قَلَمَ نّ،</para>
  <para style="q" vid="ZEC 13:5">‹نَمِحْنمّ مُ ﭑ نَ.</para>
  <para style="q" vid="ZEC 13:5">كَبِ ﭑ دِ مّدِ تّمُي ﭑ شّ نَن تُن سَقٍ.›<verse eid="ZEC 13:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ZEC 13:6"/>كْنْ عٍ عَ مَشْرِنمَ نّ،</para>
  <para style="q" vid="ZEC 13:6">‹مُنسٍ نَ يِ نَرِ رَ عِ بّلّشّيٍ مَ؟›</para>
  <para style="q" vid="ZEC 13:6">عَ عٍ يَابِمَ نّ؛</para>
  <para style="q" vid="ZEC 13:6">‹ﭑ شَنُنتٍنيِ نَن ﭑ مَشْنْشِ.›»<verse eid="ZEC 13:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="ZEC 13:7"/>«سَنتِدّفّمَ، كٍلِ ﭑ مَ شُرُ سٍ دّ مَدٌنيِ شِلِ مَ،</para>
  <para style="q" vid="ZEC 13:7">كٍلِ مِشِ شِلِ مَ نَشَن نَ ﭑ سّيتِ مَ.»</para>
  <para style="q" vid="ZEC 13:7">مَنفّ عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="ZEC 13:7">«سَنتِدّفّمَ، شُرُ سٍ دّ مَدٌنيِ قَشَ،</para>
  <para style="q" vid="ZEC 13:7">يّشّييٍ رَيٍنسٍن يّ.</para>
  <para style="q" vid="ZEC 13:7">ﭑ قَمَ نّ يّشّييْرّيٍ حَشَنكَتَدٍ.»<verse eid="ZEC 13:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ZEC 13:8"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="ZEC 13:8">«حَمَ دْشْ قِرِن قَشَمَ نّ،</para>
  <para style="q" vid="ZEC 13:8">كْنْ عَ دْشْ سَشَن ندٍ بَلٌمَ نّ.<verse eid="ZEC 13:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ZEC 13:9"/>ﭑ نَ دْشْ سَشَن ندٍ سَمَ نّ تّ عِ،</para>
  <para style="q" vid="ZEC 13:9">ﭑ عٍ رَشُنُ عَلْ فبٍتِ.</para>
  <para style="q" vid="ZEC 13:9">ﭑ شَ عٍ مَتٌ عَلْ شّيمَ.</para>
  <para style="q" vid="ZEC 13:9">عَ نَ ﭑ مَشَندِ، ﭑ عَ شَ دُبَ سُشُمَ نّ.</para>
  <para style="q" vid="ZEC 13:9">ﭑ قَمَ نّ عَ مَسٍندٍ، ‹ﭑ مَ حَمَ نَن يَ،›</para>
  <para style="q" vid="ZEC 13:9">عَ قَن عَ مَسٍن، ‹عَلَتَلَ نَن مُشُ مَرِفِ عَلَ رَ.›»<verse eid="ZEC 13:9"/></para>
  <chapter eid="ZEC 13"/>
  <chapter number="14" style="c" sid="ZEC 14"/>
  <para style="s">عَلَتَلَ قَ لْشْي</para>
  <para style="p">
    <verse number="1" style="v" sid="ZEC 14:1"/>عَلَتَلَ شَ لْشْي قَقٍ.</para>
  <para style="q" vid="ZEC 14:1">وٌ يَشُييٍ وٌ هَرِفٍ عِتَشُنمَ نّ عٍ بٌورٍ مَ وٌ يَ شْرِ.<verse eid="ZEC 14:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ZEC 14:2"/>ﭑ سِ بِرِن مَلَنمَ نّ دَرِ سَلَمُ فٍرٍ شِلِ مَ.</para>
  <para style="q" vid="ZEC 14:2">عٍ سٌمَ نّ تَا كُي، عٍ بَنشِ كَنَ، عٍ دُتُن فِنّيٍ مَ.</para>
  <para style="q" vid="ZEC 14:2">عٍ حَمَ سّيتِ شَنِنمَ نّ كٌنيِيَ كُي،</para>
  <para style="q" vid="ZEC 14:2">عٍ بٌورٍ سّيتِ لُ تَا كُي.<verse eid="ZEC 14:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="ZEC 14:3"/>عَلَتَلَ كٍلِمَ نّ عَ سَ نَ سِيٍ فٍرٍ عَ فٍرٍ كِ مَ.<verse eid="ZEC 14:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ZEC 14:4"/>نَ لْشْي عَلَ تِمَ نّ عٌلِوِ فٍيَ قَرِ،</para>
  <para style="q" vid="ZEC 14:4">نَشَن نَ دَرِ سَلَمُ يَ رَ سٌفٍتٍدٍ مَبِرِ.</para>
  <para style="q" vid="ZEC 14:4">عٌلِوِ فٍيَ عِبْو مَ نّ عَ تَفِ،</para>
  <para style="q" vid="ZEC 14:4">كٍلِقٍ سٌفٍتٍدٍ هَن سٌفٍفٌرٌدٍ.</para>
  <para style="q" vid="ZEC 14:4">فُلُنبَ لُمَ نّ فٍيَ قِرِن تَفِ،</para>
  <para style="q" vid="ZEC 14:4">كٍرٍن نَ كْولَ مَ، كٍرٍن نَ يِرٍقَنيِ مَ.<verse eid="ZEC 14:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ZEC 14:5"/>نَ تّمُي وٌ وٌ فِمَ نّ فُلُنبَ كُي</para>
  <para style="q" vid="ZEC 14:5">ﭑ مَ فٍيَيٍ تَفِ هَن عَسٍلِ.</para>
  <para style="q" vid="ZEC 14:5">وٌ وٌ فِمَ نّ عَلْ وٌ وٌ فِشِ بْشِ شَ سّرّنيِ يَ رَ كِ نَشّ،</para>
  <para style="q" vid="ZEC 14:5">يُدَيَ مَنفّ يُسِيَ شَ وَشَتِ.</para>
  <para style="q" vid="ZEC 14:5">نَ تّمُي ﭑ مَرِفِ عَلَتَلَ قَمَ نّ،</para>
  <para style="q" vid="ZEC 14:5">عَ نُن عَ شَ سّنِيّنتْييٍ رَ.<verse eid="ZEC 14:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ZEC 14:6"/>نَ لْشْي، نَءِيَلَنيِ مُ لُمَ دُنِحَ مَ،</para>
  <para style="q" vid="ZEC 14:6">يَنبَسٍيٍ شُنُمَ نّ.<verse eid="ZEC 14:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="ZEC 14:7"/>يَنيِ نُن كْي مُ نَ نَ لْشْي.</para>
  <para style="q" vid="ZEC 14:7">عَلَتَلَ نَن نَ لْشْي مْولِ كٌلٌن.</para>
  <para style="q" vid="ZEC 14:7">كْنْ نُنمَرٍ تّمُي نَءِيَلَنمَ نّ.<verse eid="ZEC 14:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="ZEC 14:8"/>نَ لْشْي، كِسِ يٍ مِنِمَ نّ دَرِ سَلَمُ،</para>
  <para style="q" vid="ZEC 14:8">سّيتِ تٍ سٌفٍتٍدٍ بَا مَبِرِ،</para>
  <para style="q" vid="ZEC 14:8">سّيتِ فٌرٌ سٌفٍفٌرٌدٍ بَا مَبِرِ.</para>
  <para style="q" vid="ZEC 14:8">عَ مِنِمَ نّ سٌفٍ قُرٍ نُن حّمّ تّمُي.<verse eid="ZEC 14:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ZEC 14:9"/>عَلَتَلَ نَن قِندِ مَ دُنِحَ بِرِن مَنفّ رَ.</para>
  <para style="q" vid="ZEC 14:9">نَ لْشْي، عَلَتَلَ نَن كٍرٍن قَمَ بَتُدٍ،</para>
  <para style="q" vid="ZEC 14:9">عَ شِلِ نَن فبَنسَن قَلَمَ.<verse eid="ZEC 14:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ZEC 14:10"/>دَرِ سَلَمُ بْشِ رَبِلِنيِ بِرِن</para>
  <para style="q" vid="ZEC 14:10">قِندِ مَ نّ مّرّ رَ،</para>
  <para style="q" vid="ZEC 14:10">كٍلِقٍ فٍبَ، سَ دْشْ رِ مْن نَ،</para>
  <para style="q" vid="ZEC 14:10">دَرِ سَلَمُ يِرٍقَنيِ مَ.</para>
  <para style="q" vid="ZEC 14:10">دَرِ سَلَمُ شَ قٍ عِتٍمَ نّ، عَ شَ نْي قَ يٍنسٍن يّ</para>
  <para style="q" vid="ZEC 14:10">كٍلِقٍ بُنيَمِن نَادّ مَ، سَ دْشْ نَادّ سِنفٍ رَ،</para>
  <para style="q" vid="ZEC 14:10">هَن تُنشُي نَادّ، هَن شَنَنّلِ كٌورٍ بَنشِ،</para>
  <para style="q" vid="ZEC 14:10">هَن مَنفّ شَ وّنِ يَءِلَندٍ.<verse eid="ZEC 14:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ZEC 14:11"/>مِشِيٍ سَبَتِمَ نّ تَا كُي،</para>
  <para style="q" vid="ZEC 14:11">عٍ مُ هَلَكِمَ سْنْن.</para>
  <para style="q" vid="ZEC 14:11">دَرِ سَلَمُ لُمَ نّ بْحّسَ كُي.<verse eid="ZEC 14:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="ZEC 14:12"/>عَلَتَلَ قَمَ نّ قُرٍ حَاشِ سِندٍ سِيٍ مَ</para>
  <para style="q" vid="ZEC 14:12">نَشٍيٍ دَرِ سَلَمُ فٍرٍشِ.</para>
  <para style="q" vid="ZEC 14:12">عٍ قَتٍ كِرِ بِرِن بْرْ مَ نّ بٍينُ عٍ شَ قَشَ.</para>
  <para style="q" vid="ZEC 14:12">عٍ يَيٍ بْرْ مَ نّ عٍ يَ يِلِ كُي،</para>
  <para style="q" vid="ZEC 14:12">عٍ نّنيِ بْرْ مَ نّ عٍ دّ كُي.<verse eid="ZEC 14:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="ZEC 14:13"/>نَ لْشْي، عَلَتَلَ مِشِيٍ يَ عِسٌمَ نّ،</para>
  <para style="q" vid="ZEC 14:13">عٍ عٍ بٌورٍ سُشُ، عٍ عٍ بٌورٍ بْنبْ.<verse eid="ZEC 14:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="ZEC 14:14"/>يُدَيَكَيٍ فٍرٍ تِمَ نّ دَرِ سَلَمُ.</para>
  <para style="q" vid="ZEC 14:14">عٍ نَاقُلِ بَمَ نّ سِيٍ يِ رَ نَشٍيٍ نَ عٍ رَبِلِنيِ،</para>
  <para style="q" vid="ZEC 14:14">شّيمَ، فبٍتِ، نُن دُفِ فبٍفبٍ.<verse eid="ZEC 14:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="ZEC 14:15"/>نَ قُرٍ حَاشِ مْولِ ندٍ قَن سِنمَ نّ شُرُ سٍ بِرِن مَ؛</para>
  <para style="q" vid="ZEC 14:15">سٌييٍ، سٌقَلٍيٍ، حْشْمّيٍ.<verse eid="ZEC 14:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="ZEC 14:16"/>دَرِ سَلَمُ يَشُي نَشٍيٍ مُ قَشَشِ نَ كُي،</para>
  <para style="q" vid="ZEC 14:16">نٍيٍ لُمَ نّ تٍ رَ حّ بِرِن مَنفّ عَلَتَلَ بَتُدٍ،</para>
  <para style="q" vid="ZEC 14:16">عٍ شَ بَفٍ تِ سَلِ رَبَ نَ.<verse eid="ZEC 14:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="ZEC 14:17"/>شَ دُنِحَ شَبِلّ ندٍ تٌندِ سِفَدٍ دَرِ سَلَمُ</para>
  <para style="q" vid="ZEC 14:17">مَنفّ عَلَتَلَ بَتُدٍ،</para>
  <para style="q" vid="ZEC 14:17">تُنّ مُ سِنمَ عٍ شَ بْشِ مَ.<verse eid="ZEC 14:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="ZEC 14:18"/>شَ مِسِرَ شَبِلّ ندٍ تٌندِ سِفَدٍ،</para>
  <para style="q" vid="ZEC 14:18">تُنّ مُ فٌرٌ مَ مّننِ.</para>
  <para style="q" vid="ZEC 14:18">عَلَتَلَ شَ قُرٍ حَاشِ نَن نَ كِ،</para>
  <para style="q" vid="ZEC 14:18">عَ نَشَن نَفٌرٌ سِيٍ مَ،</para>
  <para style="q" vid="ZEC 14:18">نَشٍيٍ تٌندِشِ سِفَدٍ بَفٍ تِ سَلِ رَبَدٍ.<verse eid="ZEC 14:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="ZEC 14:19"/>عَلَتَلَ مِسِرَ نُن سِ بِرِن حَشَنكَتَمَ نَ كِ نّ،</para>
  <para style="q" vid="ZEC 14:19">نَشٍيٍ تٌندِ سِفَدٍ بَفٍ تِ سَلِ رَبَدٍ.<verse eid="ZEC 14:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="ZEC 14:20"/>نَ لْشْي، بِرِن قِندِ مَ عَلَتَلَ فبٍ نَن نَ.</para>
  <para style="q" vid="ZEC 14:20">عَ قَمَ نّ سّبّدٍ تْلْنيِيٍ مَ نَشٍيٍ فبَكُشِ سٌييٍ رَ،</para>
  <para style="q" vid="ZEC 14:20">«عَلَتَلَ فبٍ.»</para>
  <para style="q" vid="ZEC 14:20">تُندٍ نَشٍيٍ سُبٍ فبَنسَن حِنمَ</para>
  <para style="q" vid="ZEC 14:20">عَلَتَلَ شَ هْرْ مْبَنشِ كُي،</para>
  <para style="q" vid="ZEC 14:20">نٍيٍ سّنِيّنمَ نّ عَلْ يِرَبَسٍيٍ</para>
  <para style="q" vid="ZEC 14:20">نَشٍيٍ رَوَلِمَ سّرّشّبَدٍ سّيتِ مَ.<verse eid="ZEC 14:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="ZEC 14:21"/>تُندٍ بِرِن نَشٍيٍ نَ دَرِ سَلَمُ نُن يُدَيَ،</para>
  <para style="q" vid="ZEC 14:21">نٍيٍ بِرِن سّنِيّنمَ نّ،</para>
  <para style="q" vid="ZEC 14:21">نٍيٍ بِرِن قِندِ مَ نّ مَنفّ عَلَتَلَ فبٍ رَ.</para>
  <para style="q" vid="ZEC 14:21">مِشِ بِرِن نَشٍيٍ قَمَ سّرّشّ بَدٍ،</para>
  <para style="q" vid="ZEC 14:21">نٍيٍ قَمَ نّ تُندٍ ندٍيٍ رَ عَلَكٌ عٍ شَ كُرِ سٌ.</para>
  <para style="q" vid="ZEC 14:21">نَ لْشْي، كَنَان كَاقِرِ يٌ مُ سٌمَ</para>
  <para style="q" vid="ZEC 14:21">مَنفّ عَلَتَلَ شَ بَنشِ كُي.<verse eid="ZEC 14:21"/></para>
  <chapter eid="ZEC 14"/>
</usx>
