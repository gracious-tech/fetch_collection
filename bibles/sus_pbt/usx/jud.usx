<usx version="3.0">
  <book code="JUD" style="id">Rough: OB, BW. Rework: Nov 02. Checked with team: Dec 02.</book>
  <para style="h">يُدٍ</para>
  <para style="toc1">عَلَ شَ مَسٍنيِ عَننَبِ يُدٍ نَشَن سّبّ</para>
  <para style="toc2">يُدٍ</para>
  <para style="mt">عَلَ شَ مَسٍنيِ</para>
  <para style="mt">عَننَبِ يُدٍ نَشَن سّبّ</para>
  <para style="imt">مَسٍنيِ ندٍ يِ كِتَابُي شَ قٍ رَ</para>
  <para style="ip">عَننَبِ يُدٍ نَن يِ بَتَاشّ سّبّ عَلَ شَنُنتٍنيِيٍ مَ، عَ قِندِ كِتَابُي نَن نَ مِشِ بِرِن بّ نَشٍيٍ وَ مَ بِرَقٍ عَلَ شَ سّرِيّ قْشْ رَ. نَ دَنشَنِيَتْي حَمَ، عَننَبِ يُدٍ يِ بَتَاشّ سّبّشِ نَشَن مَ، مِشِ ندٍيٍ نُ بَرَ سٌ عٍ تَفِ عَلَكٌ عٍ شَ عَلَ شَ شَرَنيِ مَقِندِ عٍ وَشْنكِ رَ. نَ مِشِ حَاشِيٍ حّرّ كِ نُ بَرَ قِندِ قٍ شُنفبٍ رَ نَ عِسَيَنكَيٍ بّ، ندٍيٍ قَ بِرَ عٍ شَ وُلٍ مَسٍنيِ قْشْ رَ.</para>
  <para style="ip">نَ نَ عَ رَ، عَننَبِ يُدٍ نَشَ وْيّنيِ شْرْشْي قَلَ عٍ بّ نَ شَرَنيِ شَ قٍ رَ. عَ نَشَ دَنشَنِيَتْييٍ رَ سِ عَ قَنيِ رَ، عٍ نَشَ لُ سّنِيّنتَرٍحَ كُي. عَ نَشَ عَ مَسٍن عٍ بّ عَ قِيشّ رَ، عَ نَ مِشِ مْولِ يَهَننَمَ نَن سْتْمَ. تّمُي دَنفِشِ مِشِ فبٍفبٍ نَشٍيٍ نُ نَ عَلَ شَ كِرَ شْن مَ، عٍ مّي نّ عَلَ شَ سّرِيّ رَ، نَ نَشَ قِندِ حَشَنكَتّ شُنفبٍ رَ عٍ بّ. عَننَبِ يُدٍ مُ تِنشِ نَ مْولِ شَ رَبَ نَ دَنشَنِيَتْييٍ رَ.</para>
  <para style="ip">وٌن قَن شَ نُ نَ مَرَ سِ رَ مّ. مِشِ فبٍفبٍ نَ دُنِحَ نَشٍيٍ عَلَ شِلِ قَلَمَ، كْنْ عٍ مُ عَلَ شَ سّرِيّ رَبَتُمَ. عَلَتَلَ كِتَابُي لُشِ وٌن يِ رَ نَ نَن مَ عَلَكٌ وٌن شَ مَسٍنيِ بِرِن سَ سِكٍيلِ مَ، وٌن شَ عَ مَتٌ شَ عَ قِندِشِ نْندِ نَن نَ، شَ نَ مُ عَ رَ شَ سٍنتَنّ شَ وُلٍ نَ عَ رَ. عَلَ شَ وٌن نَتَنفَ نَ دِينّلَ وُلٍ قَلّيٍ مَ. عَمِنَ.</para>
  <para style="imte">عَلَ شَ مَسٍنيِ</para>
  <para style="imte">عَننَبِ يُدٍ نَشَن سّبّ</para>
  <para style="cl">سٌرَ</para>
  <chapter number="1" style="c" sid="JUD 1"/>
  <para style="p">
    <verse number="1" style="v" sid="JUD 1:1"/>ﭑ تَن يُدٍ نَن يِ كِ، عَلَ شَ مِشِ سُفَندِشِ عِسَ شَ كٌنيِ، نُن يَكِ نفَشَكٍرٍنمَ. ﭑ نَ يِ بَتَاشّ سّبّقٍ مِشِيٍ نَن مَ، بَبَ عَلَ نَشٍيٍ شِلِشِ، عَ نَشٍيٍ شَنُشِ، نُن عَلَ شَ مِشِ سُفَندِشِ عِسَ نَشٍيٍ مَكَنتَشِ. <verse eid="JUD 1:1"/><verse number="2" style="v" sid="JUD 1:2"/>عَلَ شَ كِنِكِنِ، بْحّسَ، نُن شَنُنتٍيَ فبٌ وٌ يِ.<verse eid="JUD 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JUD 1:3"/>ﭑ شَنُنتٍنيِيٍ، ﭑ بَرَ وَ بَتَاشّ سّبّقٍ وٌ مَ وٌن مَ كِسِ شَ قٍ رَ. ﭑ بَرَ وَ نَ رَبَقٍ عَلَكٌ ﭑ شَ وٌ رَلِمَنِيَ، وٌ شَ فٍرٍ سٌ وٌن مَ دَنشَنِيَ شَ قٍ رَ، نَشَن حَن بَرَ فّ مَسٍندٍ كٍرٍنيِ رَ سّنِيّنتْييٍ بّ. <verse eid="JUD 1:3"/><verse number="4" style="v" sid="JUD 1:4"/>مِشِ ندٍيٍ بَرَ سٌ وٌ تَفِ، نَشٍيٍ شَ حَشَنكَتّ حَن بَرَ سّبّ عَ رَكُيَ. كَاقِرِيٍ نَن عٍ رَ، نَشٍيٍ وٌن مَرِفِ عَلَ شَ هِننّ مَقِندِ مَ، عَلَكٌ عٍ شَ لُ قٍ حَاشِيٍ كُي، عٍ شَ عٍ كٌبٍ رَ سٌ وٌن كَرَ مْشْ كٍرٍنيِ رَ، وٌن مَرِفِ عِسَ، عَلَ شَ مِشِ سُفَندِشِ.<verse eid="JUD 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JUD 1:5"/>هَلِ وٌ عَ كٌلٌن، ﭑ وَ مَ وٌ رَتُقٍ قٍ دَنفِشِ ندٍيٍ نَن مَ. مَرِفِ تٌ فّ عِسِرَيِلَ حَمَ رَ مِنِدٍ مِسِرَ بْشِ مَ، عَ نَشَ عِسِرَيِلَكَ دَنشَنِيَتَرٍيٍ سْنتْ. <verse eid="JUD 1:5"/><verse number="6" style="v" sid="JUD 1:6"/>مَلٍكّ ندٍيٍ قَن تٌ عٍ يّتّ لُ بِنيّتَرٍحَ كُي، عٍ عٍ شْنيِ بّحِن، عَلَ نَشَ عٍ رَ سٌ فٍيلِ كُي، عٍ شَ لُ دِ مِ كُي هَن كِيتِ شُنفبٍ سَ لْشْي. <verse eid="JUD 1:6"/><verse number="7" style="v" sid="JUD 1:7"/>سٌدٌ مَ نُن فٌمٌرَ، عَ نُن عٍ رَبِلِنيِ، عٍ تٌ عٍ يّتّ رَقِ قٍ حَاشِيٍ مَ، عٍ نُن عٍ بٌورٍ نُ كَقُ مْولِ ندٍ رَ نَشَن مُ لَنمَ عَدَ مَدِيٍ تَفِ، عَلَ نَشَ عٍ قِندِ مِسَالِ رَ، عَ عٍ رَ سٌ تّ شْورَ نَشَن مُ شُبٍنمَ عَبَدَن.<verse eid="JUD 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JUD 1:8"/>كْنْ نَ مِشِ نَشٍيٍ بَرَ سٌ وٌ تَفِ، عٍ لَامَتُنيِ ندٍيٍ تٌمَ نَشٍيٍ عَ نِيَ عٍ شَ سّنِيّنتَرٍحَ رَبَ، عٍ مَرِفِ شَ يَامَرِ مَتَندِ، عٍ مَلٍكّيٍ كٌنبِ. <verse eid="JUD 1:8"/><verse number="9" style="v" sid="JUD 1:9"/>مَلٍكّ مَنفّ مِنكَيِلُ تٌ وْيّن عِبُلِسَ بّ عَننَبِ مُنسَ قُرٍ شَ قٍ رَ، مِنكَيِلُ مُ سُو سَ عِبُلِسَ شَ وْيّنيِ يَابِدٍ كٌنبِ رَ. عَ عَ قَلَ نّ فبَنسَن، «عَلَ شَ عِ مَكِيتِ.» <verse eid="JUD 1:9"/><verse number="10" style="v" sid="JUD 1:10"/>كْنْ نَ مِشِيٍ كٌنبِ تِمَ قٍ ندٍ شَ قٍ رَ، عٍ مُ نَشَن كٌلٌن. عٍ نَشَن كٌلٌن عٍ يّتّ رَ، عَ وُلَ سُبٍ شَشِلِتَرٍيٍ دَاشِ، نَ قَن مُ قِندِ سٍسٍ رَ قٌ عٍ كَنَسٍ. <verse eid="JUD 1:10"/><verse number="11" style="v" sid="JUD 1:11"/>حَشَنكَتّ نَ عٍ بّ. عٍ بَرَ بِرَ كَبِلَ شَ مِسَالِ قْشْ رَ. عٍ بَرَ بِرَ كْبِرِ قْشْ رَ عَلْ بَلَمِ، عٍ قَ لْي. عٍ بَرَ مَتَندِ تِ عَلْ كٌرَ، عٍ شُن قَ رَكَنَ.<verse eid="JUD 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JUD 1:12"/>نَ مِشِيٍ بَرَ وٌ شَ نفَشَكٍرٍنيَ مَلَنيِيٍ مَنْشْ. عٍ عٍ دّفٍمَ وٌ يَ مَ، عٍ مّينِمَ عٍ يّتّ نَن فبَنسَن مَ، عٍ مُ يَافِمَ. عٍ لُشِ عَلْ نُشُييٍ، قٌيٍ نَشٍيٍ رَحّرّ مَ، كْنْ عٍ مُ قَمَ تُنّ رَ. عٍ لُشِ عَلْ سَنسِ نَشٍيٍ مُ بٌفِ رَ مِنِمَ عٍ بٌفِ تّمُي. عٍ تٌ تَلَ، عٍ بَرَ قَشَ سَنمَيَ قِرِن. <verse eid="JUD 1:12"/><verse number="13" style="v" sid="JUD 1:13"/>عٍ لُشِ عَلْ بَا مْرْنيِيٍ نَشٍيٍ شُنقّ رَ مِنِمَ. نَ شُنقّ مِسَالِشِ نَ مِشِيٍ شَ قٍ حَاشِيٍ نَن نَ. عٍ لُشِ عَلْ تُنبُي نَشٍيٍ رَفَتَشِ كٌورٍ مَ، عٍ نُ لِنتَن دِ مِ كُي عَبَدَن.<verse eid="JUD 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JUD 1:14"/>عٍنٌكِ، عَدَ مَ تٌلٌبِتّ سٌلٌقٍرٍ ندٍ، نَشَ يِ مَسٍنيِ قَلَ عَلَ شِلِ رَ عٍ شَ قٍ رَ، «مَرِفِ نَ قَقٍ، عَ نُن عَ شَ سّنِيّنتْي وُلُ وُلُ، <verse eid="JUD 1:14"/><verse number="15" style="v" sid="JUD 1:15"/>عَلَكٌ عَ شَ عَدَ مَدِ بِرِن مَكِيتِ. كَاقِرِيٍ شَ مَكِيتِ عٍ شَ قٍ حَاشِ رَبَشِيٍ مَ. كَاقِرِيٍ شَ مَكِيتِ عٍ شَ كٌنبِيٍ شَ قٍ رَ، عٍ نَشَن قَلَمَ مَرِفِ شُن مَ.» <verse eid="JUD 1:15"/><verse number="16" style="v" sid="JUD 1:16"/>نَ مِشِ مْولِيٍ لُمَ نّ سْنشْ رَ، عٍ مُ حّلّشِنمَ، عٍ بِرَ مَ عٍ يّتّ وَشْنقٍ نَن تُن قْشْ رَ، عٍ دّ عِفبٌ، عٍ مِشِ مَدَشُمَ وْيّنيِ حْشُنمّ رَ عَلَكٌ عٍ شَ سٍ سْتْ.<verse eid="JUD 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JUD 1:17"/>كْنْ وٌ تَن، ﭑ شَنُنتٍنيِيٍ، وٌ شَ رَتُ وٌن مَرِفِ عِسَ شَ شّيرَيٍ شَ مَسٍنيِيٍ مَ. <verse eid="JUD 1:17"/><verse number="18" style="v" sid="JUD 1:18"/>عٍ نُ بَرَ عَ قَلَ وٌ بّ، «وَشَتِ دْنشْي، مِشِيٍ قَمَ نّ يٌدٍ عَلَ مَ، عٍ بِرَ عٍ وَشْنقٍ تِنشِنتَرٍيٍ قْشْ رَ.» <verse eid="JUD 1:18"/><verse number="19" style="v" sid="JUD 1:19"/>نَ مِشِ مْولِيٍ نَ وٌ تَفِ. عٍ وٌ شَ لَنيِ كَنَمَ نّ. عٍ بِرَ مَ عٍ يّتّ شَشِلِ نَن قْشْ رَ. عَلَ شَشِلِ سّنِيّنشِ مُ نَ عٍ بْحّ عِ.<verse eid="JUD 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JUD 1:20"/>كْنْ وٌ تَن، ﭑ شَنُنتٍنيِيٍ، وٌ شَ وٌ شَ دَنشَنِيَ سّنِيّنشِ رَ سَبَتِ. وٌ شَ عَلَ مَشَندِ عَ شَشِلِ سّنِيّنشِ سَابُي رَ. <verse eid="JUD 1:20"/><verse number="21" style="v" sid="JUD 1:21"/>وٌ شَ لُ عَلَ شَ شَنُنتٍيَ بُن مَ، عَلَكٌ وٌ مَرِفِ عِسَ، عَلَ شَ مِشِ سُفَندِشِ، شَ كِنِكِنِ وٌ مَ، عَ شَ وٌ رَكِسِ. <verse eid="JUD 1:21"/><verse number="22" style="v" sid="JUD 1:22"/>وٌ شَ كِنِكِنِ مِشِيٍ مَ نَشٍيٍ سِيكّشِ، <verse eid="JUD 1:22"/><verse number="23" style="v" sid="JUD 1:23"/>وٌ شَ عٍ رَتَنفَ تّ مَ. وٌ مَن شَ كِنِكِنِ بٌورٍيٍ قَن مَ فَاشُي كُي، كْنْ وٌ شَ مّينِ وٌ يّتّ مَ عٍ يَ مَ، عَلَكٌ وٌ قَن نَشَ قَ وٌ يّتّ قِندِ سّنِيّنتَرٍيٍ رَ.<verse eid="JUD 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JUD 1:24"/>عَلَ تَنتُ، نَشَن نْمَ وٌن نَكِسِدٍ وٌن مَ يُنُبِ بِرِن مَ، نَشَن نْمَ وٌن مَسٍندٍ سّنِيّنيِ نُن سّيوّ رَ عَ شَ نْرّ كُي. <verse eid="JUD 1:24"/><verse number="25" style="v" sid="JUD 1:25"/>عَلَ تَنتُ، نَشَن قِرِن ندٍ مُ نَ، نَشَن بَرَ وٌن نَكِسِ عَ شَ مِشِ سُفَندِشِ عِسَ سَابُي رَ. نْرّ، شُننَكٍلِ، سّنبّ، نُن نْي نَ عَ بّ بٍينُن دُنِحَ شَ قْلْ، يَكْسِ، نُن وَشَتِ نَشَن سَ قَمَ عَبَدَن. عَمِنَ.<verse eid="JUD 1:25"/></para>
  <chapter eid="JUD 1"/>
</usx>
