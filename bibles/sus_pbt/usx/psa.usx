<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PSA" style="id"/>
  <para style="h">يَبُرَ</para>
  <para style="toc1">يَبُرَ دَوُدَ</para>
  <para style="toc2">يَبُرَ</para>
  <para style="toc3">يَب</para>
  <para style="mt">يَبُرَ دَوُدَ</para>
  <para style="imt">مَسٍنيِ ندٍ يِ كِتَابُي شَ قٍ رَ</para>
  <para style="ip">يِ كِتَابُي قِندِشِ بّيتِ كِتَابُي نَن نَ. عَننَبِ دَوُدَ نَشَ يِ بّيتِ وُيَشِيٍ سّبّ عَلَ سَابُي رَ، عَ عٍ مَلَن كِتَابُي كُي دَنشَنِيَتْييٍ بّ. عَ نَشَ بّيتِ ندٍيٍ سَ كِتَابُي كُي نَمِحْنمّ فبّتّيٍ نَشٍيٍ سّبّ عَلْ عَسَقِ يَبُرَ ٥٠. بّيتِبَيٍ نُ يِ بّيتِيٍ بَمَ عَلَ شَ هْرْ مْبَنشِ كُي سَلِ تّمُي. دَوُدَ تٌ بّيتِ ندٍيٍ سّبّ، عَ نَشَ يَامَرِ قِ بّيتِبَيٍ مَ نَ بّيتِ لَنمَ عَ شَ بَ كِ نَشّ يَبُرَ ٣‏؛٣، ٤‏؛١. تٌ دَنشَنِيَتْييٍ قَن نْمَ يِ بّيتِيٍ بَدٍ عٍ فبٍ كِ.</para>
  <para style="ip">بَقٍ نَ رَ، يِ بّيتِيٍ قِندِشِ مِسَالِ شُنفبٍ نَن نَ دَنشَنِيَتْييٍ بّ كَبِ تّمُي شْنكُيٍ. مِشِ نْمَ رَكْرْ سِدٍ يِ بّيتِيٍ كُي عَ عَلَ وَ مَ نّ مِشِيٍ شَ عٍ بْحّ شَ قٍ مَسٍن عَ بّ. شَ كْنتْقِلِ ندٍ نَ مِشِيٍ قُرِ كُي، عَلَ تِنمَ عٍ شَ نَ مَسٍن عَ بّ، عَ قِندِ عَلَ مَشَندِ رَ. شَ مِشِيٍ نَ سٌقٍ قَهَامُي كُي عَلَ شَ فبٌي شَ قٍ رَ، عٍ نْمَ نَ قَن مَسٍندٍ عَلَ بّ، عَ قِندِ عَلَ مَتْشْي رَ. عَدَ مَدِ لَنمَ عَ شَ نَ قٍ مْولِ بِرِن مَسٍن عٍ مَرِفِ عَلَ بّ. عَلَ وَ مَ نَ دّ مَسَرّ مْولِ شْن مَ عَ تَن نُن دَنشَنِيَتْييٍ تَفِ.</para>
  <para style="ip">عَلَ شَ عِ مَلِ يِ شَرَنيِ رَ، عَ شَ عَ نِيَ عِ قَن شَ مَسٍنيِ تِ عَلَ بّ نَشَن نَ عِ قُرِ كُي، عَلَكٌ عَ قَن شَ عِ يَابِ، وٌ دّ شَ قَن. عَمِنَ.</para>
  <para style="imte">يَبُرَ دَوُدَ</para>
  <chapter number="1" style="c" sid="PSA 1"/>
  <para style="s1">كِرَ قِرِنيِ</para>
  <para style="s2">عَلَ شَ سّرِيّ</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 1:1"/>حّلّشِنيِ نَ عَدَ مَ نَن بّ،</para>
  <para style="q" vid="PSA 1:1">نَشَن مُ بِرَ مَ مِشِ حَاشِ شَ مَرَ سِ قْشْ رَ،</para>
  <para style="q" vid="PSA 1:1">نَشَن مُ عَ حّرّ مَ يُنُبِتْي قْشْ رَ،</para>
  <para style="q" vid="PSA 1:1">نَشَن مُ عَ مَكْرّ مَ مِشِيٍ رَ،</para>
  <para style="q" vid="PSA 1:1">نَشٍيٍ يٌمَ عَلَ قٍ مَ.<verse eid="PSA 1:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 1:2"/>حّلّشِنيِ نَ عَدَ مَ نَن بّ،</para>
  <para style="q" vid="PSA 1:2">عَلَتَلَ شَ سّرِيّ رَقَن نَشَن مَ،</para>
  <para style="q" vid="PSA 1:2">نَشَن عَ حْشْ سَمَ عَلَتَلَ شَ سّرِيّ شْن مَ كْي نُن يَنيِ.<verse eid="PSA 1:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 1:3"/>نَ عَدَ مَ مَنِيّ</para>
  <para style="q" vid="PSA 1:3">وُرِ بِلِ رَ نَشَن تِشِ شُرٍ دّ.</para>
  <para style="q" vid="PSA 1:3">عَ بٌفِمَ عَ وَشَتِ.</para>
  <para style="q" vid="PSA 1:3">عَ بُرّشّ مُ لِسِمَ.</para>
  <para style="q" vid="PSA 1:3">نَ عَدَ مَ، قٍقٍ سُشُمَ، عَ سْونّيَمَ نّ عَ بّ.<verse eid="PSA 1:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 1:4"/>كْنْ عَ مُ نَ كِ شّ مِشِ حَاشِيٍ تَن بّ.</para>
  <para style="q" vid="PSA 1:4">عٍ تَن مَنِيّ مَالٍ لَفِ رَ قٌيٍ نَشَن شَنِنمَ.<verse eid="PSA 1:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 1:5"/>مِشِ حَاشِيٍ بْنْمَ نّ كِيتِ وَشَتِ،</para>
  <para style="q" vid="PSA 1:5">عٍ مُ لُمَ تِنشِن مِشِيٍ يَ مَ.</para>
  <para style="q" vid="PSA 1:5">لُدٍ مُ نَ عٍ بّ.<verse eid="PSA 1:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 1:6"/>عَلَتَلَ مّينِمَ تِنشِنتْييٍ مَ عَ شَ كِرَ شْن مَ،</para>
  <para style="q" vid="PSA 1:6">كْنْ مِشِ حَاشِ تَن شَ كِرَ قِندِ مَ فبَلٌي كِرَ نَن نَ.<verse eid="PSA 1:6"/></para>
  <chapter eid="PSA 1"/>
  <chapter number="2" style="c" sid="PSA 2"/>
  <para style="s1">عَلَ شَ مِشِ سُفَندِشِ</para>
  <para style="s2">عَلَ شَ سّرِيّ</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 2:1"/>مُنقٍ رَ سِيٍ بْحّ تٍشِ قُقَقُ؟<verse eid="PSA 2:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 2:2"/>دُنِحَ مَنفّيٍ بَرَ كٍلِ،</para>
  <para style="q" vid="PSA 2:2">شُنمَتِيٍ بَرَ تِ عَلَتَلَ</para>
  <para style="q" vid="PSA 2:2">نُن عَ شَ مِشِ سُفَندِشِ كَنكٍ.<verse eid="PSA 2:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 2:3"/>نَ دُنِحَ مَنفّيٍ نَشّ،</para>
  <para style="q" vid="PSA 2:3">«وٌن شَ وٌن بَ عٍ يِ رَ،</para>
  <para style="q" vid="PSA 2:3">وٌن شَ مِنِ عٍ شَ نْي بُن مَ.»<verse eid="PSA 2:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 2:4"/>مَرِفِ نَشَن نَ كٌورٍ مَ،</para>
  <para style="q" vid="PSA 2:4">نَ نَ يٍلٍقٍ عٍ مَ.<verse eid="PSA 2:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 2:5"/>عَ شْنْمَ عٍ مَ،</para>
  <para style="q" vid="PSA 2:5">عَ عٍ مَفَاشُمَ.<verse eid="PSA 2:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 2:6"/>عَلَ شَ مَسٍنيِ نَن يَ،</para>
  <para style="q" vid="PSA 2:6">«ﭑ تَن نَن مَنفّ سُفَندِ،</para>
  <para style="q" vid="PSA 2:6">ﭑ عَ دْشْ سِيٌنِ فٍيَ قَرِ، ﭑ مَ يِرٍ سّنِيّنشِ.»<verse eid="PSA 2:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 2:7"/>نَ مَنفّ سُفَندِشِ شَ مَسٍنيِ نَن يَ،</para>
  <para style="q" vid="PSA 2:7">«ﭑ شَ عَلَتَلَ شَ نَتّ مَسٍن وٌ بّ.</para>
  <para style="q" vid="PSA 2:7">عَلَ بَرَ عَ مَسٍن ﭑ بّ، ‹تٌ، عِ بَرَ قِندِ ﭑ مَ دِ رَ.</para>
  <para style="q" vid="PSA 2:7">ﭑ تَن بَرَ قِندِ عِ بَبَ رَ.<verse eid="PSA 2:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 2:8"/>عِ شَ ﭑ مَشَندِ ﭑ شَ سِ بِرِن قِ عِ مَ،</para>
  <para style="q" vid="PSA 2:8">عٍ شَ قِندِ كّ رَ عِ بّ.</para>
  <para style="q" vid="PSA 2:8">دُنِحَ بِرِن شَ قِندِ عِ فبٍ رَ.<verse eid="PSA 2:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 2:9"/>عِ عٍ يَمَرِ مَ سَوُرِ رَ،</para>
  <para style="q" vid="PSA 2:9">عِ عٍ كَنَمَ عَلْ وُرٍ قّحّ بْو مَ كِ نَشّ،</para>
  <para style="q" vid="PSA 2:9">عَ كٍبٍلَيٍ يٍنسٍن يّ.›»<verse eid="PSA 2:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 2:10"/>يَكْسِ وٌ تَن مَنفّيٍ، وٌ شَشِلِ سْتْ.</para>
  <para style="q" vid="PSA 2:10">كُنتِفِيٍ، وٌ بِرَ نْندِ قْشْ رَ.<verse eid="PSA 2:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 2:11"/>وٌ عَلَتَلَ بَتُ فَاشُي رَ،</para>
  <para style="q" vid="PSA 2:11">وٌ سّيوَ عَ شَ قٍ رَ،</para>
  <para style="q" vid="PSA 2:11">وٌ فَاشُ عَ يَ رَ.<verse eid="PSA 2:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 2:12"/>وٌ وٌ شُن سِن عَ شَ مِشِ سُفَندِشِ بّ.</para>
  <para style="q" vid="PSA 2:12">شَ نَ مُ عَ رَ، عَ وٌ هَلَكِمَ نّ وٌ شَ دُنِحّءِفِرِ كُي.</para>
  <para style="q" vid="PSA 2:12">عَلَ شَ شْنّ دّشّمَ عَلْ تّ نُ سٌ قِيلِ رَ.</para>
  <para style="q" vid="PSA 2:12">حّلّشِنيِ نَ عَدَ مَ نَن بّ،</para>
  <para style="q" vid="PSA 2:12">نَشَن كَنتَرِ قٍنمَ عَلَ رَ.<verse eid="PSA 2:12"/></para>
  <chapter eid="PSA 2"/>
  <chapter number="3" style="c" sid="PSA 3"/>
  <para style="s1">دَوُدَ نُن عَ شَ دِ عَبِسَلٌمِ</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 3:1"/>دَوُدَ شَ بّيتِ عَ نُ عَ فِمَ عَ شَ دِ عَبِسَلٌمِ مَ تّمُي نَشّ.<verse eid="PSA 3:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 3:2"/>عَلَتَلَ، ﭑ يَشُييٍ بَرَ وُيَ.</para>
  <para style="q" vid="PSA 3:2">ﭑ فٍرٍقَيٍ بَرَ فبٌ.<verse eid="PSA 3:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 3:3"/>مِشِ وُيَشِ عَ قَلَمَ،</para>
  <para style="q" vid="PSA 3:3">عَلَ مُ نْمَ ﭑ نَكِسِدٍ. <char style="qs">حّنفِ رَتٍ.</char><verse eid="PSA 3:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 3:4"/>كْنْ عِ تَن عَلَتَلَ، عِ قِندِشِ ﭑ كَنتَمَ نَن نَ.</para>
  <para style="q" vid="PSA 3:4">ﭑ مَ بِنيّ نُن ﭑ مَ شُننَكٍلِ قَتَنشِ عِ تَن نَن نَ.<verse eid="PSA 3:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 3:5"/>ﭑ نَن ﭑ شُي رَتٍ عَلَ مَ،</para>
  <para style="q" vid="PSA 3:5">عَ ﭑ يَابِمَ كٍلِ عَ شَ فٍيَ سّنِيّنشِ قَرِ. <char style="qs">حّنفِ رَتٍ.</char><verse eid="PSA 3:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 3:6"/>ﭑ نَن ﭑ سَمَ، ﭑ شَ شِ،</para>
  <para style="q" vid="PSA 3:6">ﭑ مَن شُنُمَ شَشِلِ سَ كُي،</para>
  <para style="q" vid="PSA 3:6">بَرِ مَ عَلَتَلَ نَن نَ ﭑ دّ مّنمَ رَ.<verse eid="PSA 3:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 3:7"/>ﭑ مُ فَاشُمَ يِ حَمَ دُنِحَ يَ رَ،</para>
  <para style="q" vid="PSA 3:7">نَشٍيٍ مُ وَ مَ ﭑ مَ قٍ شْن مَ.<verse eid="PSA 3:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 3:8"/>عَلَتَلَ يَندِ، ﭑ نَكِسِ، ﭑ مَرِفِ عَلَ.</para>
  <para style="q" vid="PSA 3:8">عِ ﭑ يَشُييٍ دّ رَفَرِنمَ نّ،</para>
  <para style="q" vid="PSA 3:8">عِ مِشِ حَاشِ حِنيِيٍ مَفِرَ مَ نّ.<verse eid="PSA 3:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 3:9"/>مَرَكِسِمَ نَن نَ عَلَتَلَ رَ.</para>
  <para style="q" vid="PSA 3:9">عِ شَ بَرَكّ سَ عِ شَ حَمَ شَ قٍ. <char style="qs">حّنفِ رَتٍ.</char><verse eid="PSA 3:9"/></para>
  <chapter eid="PSA 3"/>
  <chapter number="4" style="c" sid="PSA 4"/>
  <para style="s1">عَلَتَلَ كٍرٍن نَن نْمَ ﭑ كَنتَدٍ</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 4:1"/>دَوُدَ شَ بّيتِ بّيتِبَيٍ شَ مَنفّ بّ. عَ شَ بَ كْرَ شُي رَ.<verse eid="PSA 4:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 4:2"/>ﭑ مَرِفِ عَلَ تِنشِنشِ، ﭑ نَ ﭑ شُي رَتٍ عِ مَ،</para>
  <para style="q" vid="PSA 4:2">يَندِ عَ رَتِن ﭑ بّ.</para>
  <para style="q" vid="PSA 4:2">ﭑ مَ تْورّ كُي، عِ ﭑ بْحّ سَمَ.</para>
  <para style="q" vid="PSA 4:2">هِننّ ﭑ نَ، ﭑ مَ دُبّ سُشُ.<verse eid="PSA 4:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 4:3"/>عَدَ مَدِيٍ، وٌ ﭑ مَ بِنيّ مَسَرَ مَ يَافِ رَ هَن مُن تّمُي؟</para>
  <para style="q" vid="PSA 4:3">وٌ بِرَ مَ قٍ قُقَقُ نُن وُلٍ قْشْ رَ هَن مُن تّمُي؟<verse eid="PSA 4:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 4:4"/>وٌ شَ عَ كٌلٌن عَلَتَلَ بَرَ تِنشِنتْي سُفَندِ.</para>
  <para style="q" vid="PSA 4:4">ﭑ نَن ﭑ شُي رَتٍ عَلَتَلَ مَ، عَ عَ رَ مّمَ نّ.<verse eid="PSA 4:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 4:5"/>وٌ قَن شَ فَاشُ،</para>
  <para style="q" vid="PSA 4:5">وٌ فبِلٍن يُنُبِ قٍ قْشْ رَ.</para>
  <para style="q" vid="PSA 4:5">وٌ وٌ يّتّ رَ سِ كْي رَ،</para>
  <para style="q" vid="PSA 4:5">وٌ شَ وٌ رَشَرَ.<verse eid="PSA 4:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 4:6"/>وٌ شَ سّرّشّ بَ تِنشِنيِ كُي،</para>
  <para style="q" vid="PSA 4:6">وٌ شَ وٌ يّتّ تَشُ عَلَتَلَ رَ.<verse eid="PSA 4:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 4:7"/>مِشِ فبٍفبٍ عَ قَلَمَ،</para>
  <para style="q" vid="PSA 4:7">«ندٍ نْمَ هّيرِ مَسٍندٍ وٌن بّ؟»</para>
  <para style="q" vid="PSA 4:7">عَلَتَلَ، عِ شَ نْرّ مَسٍن مُشُ بّ.<verse eid="PSA 4:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 4:8"/>عِ بَرَ ﭑ بْحّ رَقٍ سّيوّ رَ</para>
  <para style="q" vid="PSA 4:8">دَنفِقٍ شّ شَبَ تّمُي رَ.<verse eid="PSA 4:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 4:9"/>ﭑ نَ ﭑ سَ، ﭑ شِمَ بْحّسَ كُي،</para>
  <para style="q" vid="PSA 4:9">بَرِ مَ عِ تَن عَلَتَلَ، عِ كٍرٍن نَن نْمَ ﭑ كَنتَدٍ.<verse eid="PSA 4:9"/></para>
  <chapter eid="PSA 4"/>
  <chapter number="5" style="c" sid="PSA 5"/>
  <para style="s1">ﭑ سٌمَ عَلَ شْنيِ</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 5:1"/>دَوُدَ شَ بّيتِ بّيتِبَيٍ شَ مَنفّ بّ شُلٍ شُي رَ<verse eid="PSA 5:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 5:2"/>عَلَتَلَ، عِ تُلِ مَتِ ﭑ مَ مَشَندِ رَ،</para>
  <para style="q" vid="PSA 5:2">عِ شَ ﭑ مَ تْورّ كٌلٌن.<verse eid="PSA 5:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 5:3"/>ﭑ مَرِفِ عَلَ، عِ تُلِ مَتِ ﭑ مَ مَشَندِ رَ،</para>
  <para style="q" vid="PSA 5:3">ﭑ نَ عِ تَن نَن مَشَندِقٍ.<verse eid="PSA 5:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 5:4"/>عَلَتَلَ، كُيٍ نّ عِبَمَ، عِ ﭑ شُي رَ مّمَ.</para>
  <para style="q" vid="PSA 5:4">فّيسّفّ، ﭑ نَن ﭑ يّتّ رَفبِلٍنمَ عِ مَ، ﭑ عِ مّمّ.<verse eid="PSA 5:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 5:5"/>عِ مُ حّلّشِنمَ قٍ كٌبِ رَ.</para>
  <para style="q" vid="PSA 5:5">قٍ حَاشِ مُ نْمَ مَكْرّدٍ عِ يِرٍ رَ.<verse eid="PSA 5:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 5:6"/>يّتّ عِفبٌي مُ تِمَ عِ يَ عِ.</para>
  <para style="q" vid="PSA 5:6">عِ تِنشِنتَرٍيٍ بِرِن شْنشِ.<verse eid="PSA 5:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 5:7"/>عِ وُلٍ قَلّ رَهَلَكِمَ.</para>
  <para style="q" vid="PSA 5:7">عِ قَشَتِيٍ نُن يَنقَنتٍيٍ شْنمَ.<verse eid="PSA 5:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 5:8"/>كْنْ ﭑ تَن سٌمَ عِ شَ بَنشِ كُي عِ شَ قٌنِسِرٍيَ سَابُي نَن نَ.</para>
  <para style="q" vid="PSA 5:8">ﭑ نَن ﭑ عِفٌرٌ مَ عِ شَ هْرْ مْبَنشِ سّنِيّنشِ كُي فَاشُي رَ.<verse eid="PSA 5:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 5:9"/>عَلَتَلَ، ﭑ يَشُييٍ شَ قٍ رَ،</para>
  <para style="q" vid="PSA 5:9">ﭑ شُن تِ عِ شَ تِنشِنيِ رَ،</para>
  <para style="q" vid="PSA 5:9">عِ شَ كِرَ يَءِلَن ﭑ يَ رَ.<verse eid="PSA 5:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 5:10"/>نْندِ مُ نَ ﭑ يَشُييٍ شَ مَسٍنيِ سٍسٍ كُي.</para>
  <para style="q" vid="PSA 5:10">عٍ يُفٍ مُ قَن.</para>
  <para style="q" vid="PSA 5:10">عٍ شَ وْيّنيِ مِشِ رَقِلِمَ نّ،</para>
  <para style="q" vid="PSA 5:10">بَرِ مَ عٍ دّ عِحْشُن.<verse eid="PSA 5:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 5:11"/>عَلَ، عٍ حَشَنكَتَ.</para>
  <para style="q" vid="PSA 5:11">عٍ شَ يَنقّ شَ فبِلٍن عٍ مَ.</para>
  <para style="q" vid="PSA 5:11">عٍ كٍرِ عٍ شَ قٍ كٌبِ مَ،</para>
  <para style="q" vid="PSA 5:11">بَرِ مَ عٍ بَرَ عِ مَتَندِ.<verse eid="PSA 5:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 5:12"/>كْنْ مِشِ نَشَن بِرِن عَ يّتّ تَشُمَ عِ رَ،</para>
  <para style="q" vid="PSA 5:12">عٍ بِرِن شَ سّيوَ،</para>
  <para style="q" vid="PSA 5:12">عٍ شَ حّلّشِنيِ نَشَ حْن عَبَدَن.</para>
  <para style="q" vid="PSA 5:12">عِ شِلِ رَقَنشِ مِشِ نَشٍيٍ مَ، عٍ مَكَنتَ،</para>
  <para style="q" vid="PSA 5:12">عٍ شَ سّيوَ عِ شَ قٍ رَ،<verse eid="PSA 5:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 5:13"/>بَرِ مَ عِ تَن عَلَتَلَ، عِ بَرَكّ سَمَ مِشِ تِنشِنشِ شَ قٍ.</para>
  <para style="q" vid="PSA 5:13">عِ شَ هِننّ نَشَن عٍ رَبِلِنشِ،</para>
  <para style="q" vid="PSA 5:13">عَ بَرَ قِندِ عٍ شَ كَنتَرِ رَ.<verse eid="PSA 5:13"/></para>
  <chapter eid="PSA 5"/>
  <chapter number="6" style="c" sid="PSA 6"/>
  <para style="s1">قُرٍ مَ وَ شُي</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 6:1"/>دَوُدَ شَ بّيتِ بّيتِبَيٍ شَ مَنفّ بّ. عَ شَ بَ كْرَ لُوتِ سٌلٌمَسَشَن شُي رَ.<verse eid="PSA 6:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 6:2"/>عَلَتَلَ، عِ نَشَ ﭑ حَشَنكَتَ عِ شَ شْنّ كُي،</para>
  <para style="q" vid="PSA 6:2">عِ نَشَ ﭑ تْورْ عِ شَ بْحّ تٍ كُي.<verse eid="PSA 6:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 6:3"/>عَلَتَلَ، هِننّ ﭑ نَ، ﭑ بَرَ هَلَكِ.</para>
  <para style="q" vid="PSA 6:3">عَلَتَلَ، ﭑ نَيَلَن، ﭑ شْرِيٍ نَ سّرّنقٍ نّ يِ كِ.<verse eid="PSA 6:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 6:4"/>ﭑ نِي بِرِن نَ سّرّنقٍ تْورّ رَ.</para>
  <para style="q" vid="PSA 6:4">عَلَتَلَ، هَن تّمُي مُندُن قَ؟<verse eid="PSA 6:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 6:5"/>عَلَتَلَ، قَ ﭑ نِي رَكِسِ.</para>
  <para style="q" vid="PSA 6:5">ﭑ نَتَنفَ عِ شَ قٌنِسِرٍيَ شَ قٍ رَ.<verse eid="PSA 6:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 6:6"/>مِشِ مُ نْمَ رَتُدٍ عِ مَ فَبُرِ كُي.</para>
  <para style="q" vid="PSA 6:6">ندٍ نْمَ عِ تَنتُدٍ عَلِفِيَمَ؟<verse eid="PSA 6:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 6:7"/>ﭑ بَرَ تْورْ هَن ﭑ سّنبّ بِرِن بَرَ حْن.</para>
  <para style="q" vid="PSA 6:7">كْي يٌ كْي ﭑ وَ مَ،</para>
  <para style="q" vid="PSA 6:7">هَن ﭑ مَ سَدٍ بِرِن بُندَ ﭑ يَ يٍ رَ.<verse eid="PSA 6:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 6:8"/>سُننُنيِ بَرَ ﭑ يَ مَقْورْ.</para>
  <para style="q" vid="PSA 6:8">ﭑ مُ سٍسٍ تٌقٍ ﭑ يَشُييٍ شَ فبٌي شَ قٍ رَ.<verse eid="PSA 6:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 6:9"/>وٌ وٌ مَسِفَ ﭑ نَ، وٌ تَن تِنشِنتَرٍيٍ،</para>
  <para style="q" vid="PSA 6:9">بَرِ مَ ﭑ وَ شُي بَرَ عَلَتَلَ لِ.<verse eid="PSA 6:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 6:10"/>عَلَتَلَ بَرَ ﭑ مَ مَشَندِ مّ.</para>
  <para style="q" vid="PSA 6:10">عَلَتَلَ بَرَ ﭑ مَ دُبّ سُشُ.<verse eid="PSA 6:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 6:11"/>ﭑ يَشُييٍ بِرِن يَافِمَ نّ، هَن عٍ عٍ فِ.<verse eid="PSA 6:11"/></para>
  <chapter eid="PSA 6"/>
  <chapter number="7" style="c" sid="PSA 7"/>
  <para style="s1">كِيتِسَ قَنيِ نَن نَ عَلَ رَ</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 7:1"/>دَوُدَ شَ بّيتِ مْولِ ندٍ عَلَتَلَ بّ كُسِ بُنيَمِنكَ شَ قٍ رَ.<verse eid="PSA 7:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 7:2"/>ﭑ مَرِفِ عَلَتَلَ، عِ تَن نَن نَ ﭑ كَنتَمَ رَ.</para>
  <para style="q" vid="PSA 7:2">ﭑ نَتَنفَ ﭑ يَشُييٍ مَ، ﭑ بَ عٍ يِ رَ،<verse eid="PSA 7:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 7:3"/>عٍ نَشَ ﭑ قَشَ عَلْ يّتّ مِشِ قَشَمَ كِ نَشّ.</para>
  <para style="q" vid="PSA 7:3">عَ نَ نَشَن سُشُ، نَ مُ بَمَ عَ يِ رَ.<verse eid="PSA 7:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 7:4"/>ﭑ مَرِفِ عَلَتَلَ،</para>
  <para style="q" vid="PSA 7:4">شَ ﭑ بَرَ كْبِرِ رَ مُرُتَ،<verse eid="PSA 7:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 7:5"/>شَ ﭑ بَرَ قٍ حَاشِ رَبَ مِشِ رَ،</para>
  <para style="q" vid="PSA 7:5">مُشُ نُن نَشَن دْشْشِ بْحّسَ كُي،</para>
  <para style="q" vid="PSA 7:5">شَ ﭑ بَرَ ﭑ فٍرٍقَ مُحَ تْوحّفّ كُي،<verse eid="PSA 7:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 7:6"/>ﭑ يَشُييٍ شَ ﭑ كٍرِ، عٍ شَ ﭑ مَسْتْ،</para>
  <para style="q" vid="PSA 7:6">عٍ شَ ﭑ مَبٌرٌن، عٍ ﭑ قَشَ.<verse eid="PSA 7:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 7:7"/>عَلَتَلَ، ﭑ مَلِ، عِ بْحّ شَ تٍ ﭑ يَشُييٍ مَ.</para>
  <para style="q" vid="PSA 7:7">ﭑ دّ مّن، سّرِيّ نَ عِ تَن نَشَن يِ رَ.<verse eid="PSA 7:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 7:8"/>عِ شَ نْي شَ لُ حَمَيٍ شُن،</para>
  <para style="q" vid="PSA 7:8">عٍ شَ لُ عِ شَ يَامَرِ بُن مَ.<verse eid="PSA 7:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 7:9"/>عَلَتَلَ، حَمَيٍ مَكِيتِ.</para>
  <para style="q" vid="PSA 7:9">عَلَتَلَ، ﭑ مَ نْندِ مَكّنّن عٍ بّ</para>
  <para style="q" vid="PSA 7:9">ﭑ مَ تِنشِنيِ نُن ﭑ مَ سّرِيّ بّرّ رَ.<verse eid="PSA 7:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 7:10"/>دَنيِ سَ قٍ كٌبِ رَبَيٍ شَ قٍ مَ.</para>
  <para style="q" vid="PSA 7:10">سّنبّ قِ مِشِ تِنشِنشِيٍ مَ</para>
  <para style="q" vid="PSA 7:10">عِ تَن، عَلَ نَشَن تِنشِن،</para>
  <para style="q" vid="PSA 7:10">نَشَن بِرِن سٌندٌن مَ قٍ كٌلٌن.<verse eid="PSA 7:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 7:11"/>عَلَ، ﭑ كَنتَمَ نَ عِ تَن نَن نَ،</para>
  <para style="q" vid="PSA 7:11">نَشَن مِشِ تِنشِنشِ رَكِسِمَ.<verse eid="PSA 7:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 7:12"/>كِيتِسَ قَنيِ نَن نَ عَلَ رَ،</para>
  <para style="q" vid="PSA 7:12">نَشَن شْنْمَ تِنشِنتَرٍيٍ مَ تّمُي بِرِن.<verse eid="PSA 7:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 7:13"/>شَ مِشِ حَاشِيٍ مُ فبِلٍن عٍ يُفٍ قْشْ رَ،</para>
  <para style="q" vid="PSA 7:13">عَلَ عَ شَ سَنتِدّفّمَ رَلُفَنمَ نّ،</para>
  <para style="q" vid="PSA 7:13">عَ عَ شَ شَلِ مَشِرِ.<verse eid="PSA 7:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 7:14"/>عَلَ نَ قَشَتِسٍ يَءِلَنمَ مِشِ حَاشِيٍ نَن شِلِ مَ،</para>
  <para style="q" vid="PSA 7:14">عَ عَ شَ تَنبّيٍ دّ قِندِ تّ رَ.<verse eid="PSA 7:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PSA 7:15"/>مِشِ حَاشِ لُمَ قٍ حَاشِ نَن تُن نَبَ رَ.</para>
  <para style="q" vid="PSA 7:15">عَ عَ حْشْ سَ عَ شْن مَ هَن عَ قِندِ عَ رَ.<verse eid="PSA 7:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 7:16"/>عَ يِلِ فٍمَ هَن عَ تِلِن،</para>
  <para style="q" vid="PSA 7:16">عَ قَ بِرَ عَ يّتّ شَ يِلِ فٍشِ كُي.<verse eid="PSA 7:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 7:17"/>عَ شَ قٍ حَاشِ نُن عَ شَ فٍرٍفِرِ بَرَ فبِلٍن عَ مَ.<verse eid="PSA 7:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="PSA 7:18"/>ﭑ عَلَتَلَ تَنتُمَ نّ عَ شَ تِنشِنيِ شَ قٍ رَ.</para>
  <para style="q" vid="PSA 7:18">ﭑ سُوكِ بَمَ نّ عَلَتَلَ شِلِ رَ، عَلَ شِلِ شُنفبٍ كَنيِ.<verse eid="PSA 7:18"/></para>
  <chapter eid="PSA 7"/>
  <chapter number="8" style="c" sid="PSA 8"/>
  <para style="s1">شِلِ شُنفبٍ كَنيِ نَن لَنشِ عَلَ مَ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 8:1"/>دَوُدَ شَ بّيتِ بّيتِبَيٍ شَ مَنفّ بّ. عَ شَ بَ مَشَسٍ لُوتِ دَاشِ شُي رَ.<verse eid="PSA 8:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 8:2"/>مُشُ مَرِفِ عَلَتَلَ!</para>
  <para style="q" vid="PSA 8:2">شِلِ شُنفبٍ كَنيِ نَن لَنشِ عِ مَ دُنِحَ بّندّ قُحِ قَرِ،</para>
  <para style="q" vid="PSA 8:2">عِ تَن نَشَن مَ نْرّ نَ كٌورٍ مَ.<verse eid="PSA 8:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 8:3"/>دِ مّيٍ نُن دِيْرّيٍ عِ سّنبّ مَتْشْمَ،</para>
  <para style="q" vid="PSA 8:3">عِ عِ يَشُييٍ نُن عِ فٍرٍقَيٍ دّ بَلَنمَ نَ مَتْشْي رَ.<verse eid="PSA 8:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 8:4"/>ﭑ نَ كٌورٍ مَتٌ،</para>
  <para style="q" vid="PSA 8:4">عِ نَشَن يَءِلَنشِ عِ بّلّشّ رَ، كِكٍ عَ نُن تُنبُييٍ،<verse eid="PSA 8:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 8:5"/>ﭑ نَن ﭑ يّتّ مَشْرِنمَ نّ،</para>
  <para style="q" vid="PSA 8:5">«مُنسٍ لَنشِ عَدَ مَ مَ</para>
  <para style="q" vid="PSA 8:5">عِ تٌ عِ مَحْشُنمَ عَ شَ قٍ مَ؟</para>
  <para style="q" vid="PSA 8:5">مُنسٍ لَنشِ عَدَ مَدِ مَ</para>
  <para style="q" vid="PSA 8:5">عِ تٌ عِ حّنفِ سَمَ عَ شَ قٍ شْن مَ؟<verse eid="PSA 8:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 8:6"/>عِ عَ دَاشِ كِ نَشّ،</para>
  <para style="q" vid="PSA 8:6">عَ فبٍ مُ لُشِ عَ شَ قِندِ مَلٍكّ رَ.</para>
  <para style="q" vid="PSA 8:6">عِ بَرَ بِنيّ نُن قِسَمَنتٍيَ قِ عَ مَ.<verse eid="PSA 8:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 8:7"/>عِ بَرَ يَامَرِ سٌ عَ يِ رَ عِ شَ دَالِسٍيٍ بِرِن شُن مَ.</para>
  <para style="q" vid="PSA 8:7">عِ بَرَ دُنِحَ قِندِ عَ سَنيِ بُن مَ سٍ رَ؛<verse eid="PSA 8:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 8:8"/>يّشّييٍ، نِنفٍيٍ، وُلَءِ سُبٍيٍ،<verse eid="PSA 8:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 8:9"/>شْنِ نَشٍيٍ حّرّ مَ كٌورٍ مَ،</para>
  <para style="q" vid="PSA 8:9">يّشّ نَشٍيٍ بِرِن حّرّ مَ بَا مَ.<verse eid="PSA 8:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 8:10"/>مُشُ مَرِفِ عَلَتَلَ!</para>
  <para style="q" vid="PSA 8:10">شِلِ شُنفبٍ كَنيِ نَن لَنشِ عِ مَ دُنِحَ بّندّ قُحِ قَرِ!»<verse eid="PSA 8:10"/></para>
  <chapter eid="PSA 8"/>
  <chapter number="9" style="c" sid="PSA 9"/>
  <para style="s1">عَلَتَلَ كٌلٌنشِ عَ شَ تِنشِنيِ نَن مَ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 9:1"/>دَوُدَ شَ بّيتِ بّيتِبَيٍ شَ مَنفّ بّ. عَ شَ بَ عَلْ بّيتِ نَشَن شِلِ «دِ شَ قَشّ.»<verse eid="PSA 9:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 9:2"/>عَلَتَلَ، ﭑ عِ تَنتُمَ ﭑ سٌندٌنيِ بِرِن نَ،</para>
  <para style="q" vid="PSA 9:2">ﭑ عِ شَ وَلِ قَنيِ عِشَرَنمَ مِشِ بِرِن بّ.<verse eid="PSA 9:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 9:3"/>ﭑ سّيوَ مَ نّ عِ شَ قٍ رَ،</para>
  <para style="q" vid="PSA 9:3">عِ تَن عَلَتَلَ شِلِ شُنفبٍ كَنيِ،</para>
  <para style="q" vid="PSA 9:3">ﭑ عِ مَتْشْ بّيتِ رَ.<verse eid="PSA 9:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 9:4"/>ﭑ يَشُييٍ فبِلٍنمَ نّ عٍ كٍلِدٍ.</para>
  <para style="q" vid="PSA 9:4">شَ عٍ بَرَ تِ عِ يَ عِ،</para>
  <para style="q" vid="PSA 9:4">عٍ سَنيِيٍ مُ شَنمَ بْشِ،</para>
  <para style="q" vid="PSA 9:4">عٍ نِي مُ شَنمَ دُنِحَ،<verse eid="PSA 9:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 9:5"/>بَرِ مَ عِ شَ تِنشِنيِ كُي،</para>
  <para style="q" vid="PSA 9:5">عِ تَن مَنفّ بَرَ كِيتِ سٌ ﭑ يِ.<verse eid="PSA 9:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 9:6"/>عِ بَرَ سِ فبّتّيٍ كَلَمُ،</para>
  <para style="q" vid="PSA 9:6">عِ قٍ كٌبِ رَبَيٍ رَهَلَكِمَ،</para>
  <para style="q" vid="PSA 9:6">عِ عٍ شِلِ رَلْيمَ نّ هَن دُنِحَ حْن.<verse eid="PSA 9:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 9:7"/>عِ بَرَ عٍ شَ تَايٍ سْنتْ،</para>
  <para style="q" vid="PSA 9:7">نَ تَا سْنتْشِيٍ لُمَ نّ نَ كِ هَن،</para>
  <para style="q" vid="PSA 9:7">عٍ شَ قٍ نّيمُ مِشِيٍ رَ!<verse eid="PSA 9:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 9:8"/>عَلَتَلَ شَ مَنفّيَ تِشِ، دَنيِ مُ نَ عَ مَ.</para>
  <para style="q" vid="PSA 9:8">عَ شَ كِبَنيِ دْشْشِ كِيتِ سَقٍ نَن مَ.<verse eid="PSA 9:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 9:9"/>عَ دُنِحَ مَكِيتِمَ تِنشِنيِ كُي،</para>
  <para style="q" vid="PSA 9:9">عَ دْشْشِ سِيٍ شُن مَ تِنشِنيِ كُي.<verse eid="PSA 9:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 9:10"/>تْورْ مِشِيٍ كَنتَمَ نَن نَ عَلَتَلَ رَ،</para>
  <para style="q" vid="PSA 9:10">عٍ رَتَنفَمَ نَ عَ تَن نَن نَ عٍ شَ كْنتْقِلِيٍ كُي.<verse eid="PSA 9:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 9:11"/>عَلَتَلَ، عِ كٌلٌنمَ لَشِ عِ رَ،</para>
  <para style="q" vid="PSA 9:11">بَرِ مَ عِ سِنفٍ مُ نُ عِ قٍنمَ رَبٌلٌ.<verse eid="PSA 9:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 9:12"/>عَلَتَلَ دْشْشِ عَ شَ فٍيَ سّنِيّنشِ شُن،</para>
  <para style="q" vid="PSA 9:12">وٌن شَ عَ تَنتُ بّيتِيٍ رَ.</para>
  <para style="q" vid="PSA 9:12">عَ بَرَ قٍ نَشٍيٍ رَبَ،</para>
  <para style="q" vid="PSA 9:12">وٌن شَ نٍيٍ مَسٍن سِ بِرِن بّ.<verse eid="PSA 9:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 9:13"/>عَلَ رَتُشِ وُلِ قِلِشِ مَ،</para>
  <para style="q" vid="PSA 9:13">عَ قَن نَ حْشْمَ نّ.</para>
  <para style="q" vid="PSA 9:13">عَ تْورْ مِشِيٍ وَ شُي دَنشُنشِ.<verse eid="PSA 9:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PSA 9:14"/>عَلَتَلَ، كِنِكِنِ ﭑ مَ.</para>
  <para style="q" vid="PSA 9:14">عِ شَ ﭑ مَتٌ.</para>
  <para style="q" vid="PSA 9:14">عَ مَتٌ ﭑ يَشُييٍ نَ ﭑ تْورْقٍ كِ نَشّ.</para>
  <para style="q" vid="PSA 9:14">عِ تَن نَشَن ﭑ نَكِسِمَ سَيَ كِرَ مَ،<verse eid="PSA 9:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 9:15"/>عَلَكٌ ﭑ شَ عِ تَنتُ سِيٌنِ حَمَ تَفِ،</para>
  <para style="q" vid="PSA 9:15">ﭑ شَ سّيوَ عِ شَ كِسِ رَ.<verse eid="PSA 9:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 9:16"/>سِيٍ نُ فَنتَنيِ نَشَن تٍشِ عٍ يَشُييٍ بّ،</para>
  <para style="q" vid="PSA 9:16">عٍ بَرَ عٍ يّتّ سَنيِيٍ سُشُ عَ رَ.<verse eid="PSA 9:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 9:17"/>عَلَتَلَ كٌلٌنشِ عَ شَ تِنشِنيِ نَن مَ.</para>
  <para style="q" vid="PSA 9:17">تِنشِنتَرٍيٍ سُشُمَ عٍ يّتّ بّلّشّ قْشِ نَن سَابُي رَ.<verse eid="PSA 9:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 9:18"/>مَتَندِلَ نَشٍيٍ نّيمُمَ عَلَ مَ،</para>
  <para style="q" vid="PSA 9:18">عٍ بِرِن نَحْنمَ عَلِفِيَمَ نّ.<verse eid="PSA 9:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 9:19"/>عَلَ قَمَ رَتُدٍ تْورْ مِشِ مَ،</para>
  <para style="q" vid="PSA 9:19">عَ مُ نّيمُمَ عٍ مَ عَبَدَن.<verse eid="PSA 9:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="PSA 9:20"/>عَلَتَلَ، كٍلِ، عِ نَشَ عَ لُ عَدَ مَ شَ نْ عِ رَ.</para>
  <para style="q" vid="PSA 9:20">عَ مَكِيتِ.<verse eid="PSA 9:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 9:21"/>عَلَتَلَ، عِ شَ عٍ مَفَاشُ.</para>
  <para style="q" vid="PSA 9:21">عٍ شَ عَ كٌلٌن عِبُنَدَ مَ فبَنسَن نَن عٍ رَ.<verse eid="PSA 9:21"/></para>
  <chapter eid="PSA 9"/>
  <chapter number="10" style="c" sid="PSA 10"/>
  <para style="s1">عِ نَشَ نّيمُ سٍتَرٍ مَ</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 10:1"/>عَلَتَلَ، عِ عِ مَكُيَشِ ﭑ نَ مُنقٍ رَ؟</para>
  <para style="q" vid="PSA 10:1">عِ عِ نْشُنشِ مُشُ مَ مُشُ شَ تْورّ كُي مُنقٍ رَ؟<verse eid="PSA 10:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 10:2"/>يّتّ عِفبٌي سٍتَرٍيٍ تْورْ مَ،</para>
  <para style="q" vid="PSA 10:2">عَ شَ مَحْشُنيِ كٌبِ نْمَ عٍ رَ.<verse eid="PSA 10:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 10:3"/>عَ عَ يّتّ عِفبٌمَ عَ شَ وَلِ حَاشِ شَ قٍ رَ.</para>
  <para style="q" vid="PSA 10:3">عَلَتَلَ شْنْمَ عَ شَ نَاقُلِ سْتْ كِ مَ.<verse eid="PSA 10:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 10:4"/>مِشِ حَاشِ يّتّ عِفبٌي نَشّ،</para>
  <para style="q" vid="PSA 10:4">«عَلَ مُ نَ! عَ مُ نْمَ سٍسٍ رَبَدٍ ﭑ نَ!»</para>
  <para style="q" vid="PSA 10:4">عَ شَ مَحْشُنيِ بِرِن نَن يَ.<verse eid="PSA 10:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 10:5"/>عَ شَ وَلِ بِرِن سْونّيَمَ نّ.</para>
  <para style="q" vid="PSA 10:5">عَ مُ فَاشُمَ عَلَ شَ كِيتِ يَ رَ.</para>
  <para style="q" vid="PSA 10:5">عَ يٌمَ عَ يَشُييٍ مَ.<verse eid="PSA 10:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 10:6"/>عَ مَحْشُنمَ عَ بْحّ مَ،</para>
  <para style="q" vid="PSA 10:6">«سٍسٍ مُ عَ نِيَمَ ﭑ بِرَ.</para>
  <para style="q" vid="PSA 10:6">تْورّ مَن مُ ﭑ سُشُمَ.»<verse eid="PSA 10:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 10:7"/>عَ دّ مِشِ دَنكَمَ، عَ وُلٍ قَلَ.</para>
  <para style="q" vid="PSA 10:7">عَ قٍ حَاشِ تِنشِنتَرٍ نَن تُن قَلَمَ.<verse eid="PSA 10:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 10:8"/>عَ مِشِ مّلّنمَ تَا قَرِ مَ،</para>
  <para style="q" vid="PSA 10:8">عَ شَ مِشِ قَنيِ قَشَ.</para>
  <para style="q" vid="PSA 10:8">عَ مُ تَفَنمَ قٍ حَاشِ رَبَقٍ رَ مِشِ قَنيِ رَ.<verse eid="PSA 10:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 10:9"/>عَ سٍتَرٍيٍ مّلّنمَ عَلْ يّتّ.</para>
  <para style="q" vid="PSA 10:9">عَ عٍ سُشُ عَ شَ فَنتَنيِ رَ.<verse eid="PSA 10:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 10:10"/>نَ سٍتَرٍيٍ لُمَ عَ شَ نْي بُن مَ.<verse eid="PSA 10:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 10:11"/>عَ عَ قَلَمَ عَ بْحّ كُي،</para>
  <para style="q" vid="PSA 10:11">«عَلَ مُ سٍسٍ تٌمَ.</para>
  <para style="q" vid="PSA 10:11">عَ يَ رَشِشِ.»<verse eid="PSA 10:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 10:12"/>عَلَتَلَ كٍلِ! عِ نَشَ نّيمُ سٍتَرٍ مَ.<verse eid="PSA 10:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 10:13"/>مُنقٍ رَ مِشِ حَاشِ يٌمَ عَلَ مَ؟</para>
  <para style="q" vid="PSA 10:13">مُنقٍ رَ عَ عَ قَلَمَ عَ يّتّ بّ،</para>
  <para style="q" vid="PSA 10:13">«عَلَ مُ ﭑ حَشَنكَتَمَ»؟<verse eid="PSA 10:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 10:14"/>كْنْ عَلَ، عِ تْورّ نُن نِمِسّ تٌمَ.</para>
  <para style="q" vid="PSA 10:14">عِ تْورْ مِشِيٍ مَلِمَ.</para>
  <para style="q" vid="PSA 10:14">نَشَن مُ نْمَ عَ يّتّ كَنتَدٍ،</para>
  <para style="q" vid="PSA 10:14">عَ عَ يّتّ تَشُمَ عِ تَن نَ نَ.</para>
  <para style="q" vid="PSA 10:14">عِ تَن نَن نَ كِرِدِ مَلِمَ رَ.<verse eid="PSA 10:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 10:15"/>مِشِ حَاشِ سّنبّ كَنَ!</para>
  <para style="q" vid="PSA 10:15">عٍ حَشَنكَتَ عٍ شَ قٍ حَاشِ شَ قٍ رَ!</para>
  <para style="q" vid="PSA 10:15">عٍ رَلْي يِ دُنِحَ مَ!<verse eid="PSA 10:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 10:16"/>مَنفّ نَن عَلَتَلَ رَ.</para>
  <para style="q" vid="PSA 10:16">نَ مُ كَنَمَ عَبَدَن.</para>
  <para style="q" vid="PSA 10:16">كُيٍ بَتُي مُ لُمَ عَ شَ بْشِ مَ.<verse eid="PSA 10:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 10:17"/>عَلَتَلَ، عِ عِ تُلِ تِشِ مِشِ مَفٌرٌشِيٍ رَ.</para>
  <para style="q" vid="PSA 10:17">عِ لِمَنِيَ قِمَ عٍ مَ.</para>
  <para style="q" vid="PSA 10:17">عِ عٍ شَ مَشَندِ سُشُمَ.<verse eid="PSA 10:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 10:18"/>عِ تْورْ مِشِ نُن كِرِدِ كَنتَمَ،</para>
  <para style="q" vid="PSA 10:18">عَلَكٌ عَدَ مَدِ نَشَن قِندِشِ بّندّ رَ،</para>
  <para style="q" vid="PSA 10:18">عَ نَشَ عٍ مَفَاشُ.<verse eid="PSA 10:18"/></para>
  <chapter eid="PSA 10"/>
  <chapter number="11" style="c" sid="PSA 11"/>
  <para style="s1">تِنشِنيِ رَقَن عَلَ مَ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 11:1"/>دَوُدَ شَ بّيتِ بّيتِبَيٍ شَ مَنفّ بّ</para>
  <para style="q" vid="PSA 11:1">ﭑ بَرَ عَلَتَلَ قِندِ ﭑ يِفِ رَ.</para>
  <para style="q" vid="PSA 11:1">وٌ عَ قَلَمَ ﭑ بّ دِ،</para>
  <para style="q" vid="PSA 11:1">«عِ عِ فِ عَلْ شْنِ نَشَن تُفَنمَ سِفَقٍ رَ فٍيَ مَ،<verse eid="PSA 11:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 11:2"/>بَرِ مَ مِشِ حَاشِيٍ بَرَ عٍ شَ شَلِيٍ تٌنفٌ،</para>
  <para style="q" vid="PSA 11:2">عٍ شَ مِشِ بْحّ قَنيِيٍ قَشَ.»<verse eid="PSA 11:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 11:3"/>شَ سّرِيّ مُ نَ مِشِيٍ تَفِ سْنْن،</para>
  <para style="q" vid="PSA 11:3">تِنشِنتْي قَ مُنسٍ رَبَمَ؟<verse eid="PSA 11:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 11:4"/>عَلَتَلَ نَ عَ شَ هْرْ مْبَنشِ سّنِيّنشِ كُي.</para>
  <para style="q" vid="PSA 11:4">عَ شَ كِبَنيِ نَ عَرِيَننَ.</para>
  <para style="q" vid="PSA 11:4">عَ عَدَ مَدِيٍ مَتٌمَ عَ قَنيِ رَ،</para>
  <para style="q" vid="PSA 11:4">عَ شَ عَ كٌلٌن نَشَن نَ عٍ سٌندٌنيِ كُي.<verse eid="PSA 11:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 11:5"/>عَلَتَلَ تِنشِنتْي نُن تِنشِنتَرٍ مَتٌمَ.</para>
  <para style="q" vid="PSA 11:5">فبَلٌي رَقَن نَشٍيٍ مَ، عَ نٍيٍ رَحَاشُ.<verse eid="PSA 11:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 11:6"/>عَ تِنشِنتَرٍ لُمَ تْورّ مْولِ بِرِن كُي.</para>
  <para style="q" vid="PSA 11:6">نَ لُمَ نّ عَلْ تّ وٌلٍنشِ نُن قٌيٍ حَاشِ.<verse eid="PSA 11:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 11:7"/>عَلَتَلَ تِنشِن.</para>
  <para style="q" vid="PSA 11:7">تِنشِنيِ رَقَن عَ مَ.</para>
  <para style="q" vid="PSA 11:7">تِنشِنتْي قَمَ عَ يَتَفِ تٌدٍ.<verse eid="PSA 11:7"/></para>
  <chapter eid="PSA 11"/>
  <chapter number="12" style="c" sid="PSA 12"/>
  <para style="s1">حَاشُحَ بَرَ فبٌ يّ</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 12:1"/>دَوُدَ شَ بّيتِ بّيتِبَيٍ شَ مَنفّ بّ. عَ شَ بَ كْرَ لُوتِ سٌلٌمَسَشَن شُي رَ.<verse eid="PSA 12:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 12:2"/>عَلَتَلَ، مُشُ رَكِسِ!</para>
  <para style="q" vid="PSA 12:2">لَنلَنتٍيَ مُ نَ سْنْن،</para>
  <para style="q" vid="PSA 12:2">نْندِ قَلّيٍ بَرَ حْن عَدَ مَدِيٍ تَفِ.<verse eid="PSA 12:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 12:3"/>كَنكَن عَ بٌورٍ تْوحّفّمَ،</para>
  <para style="q" vid="PSA 12:3">عَ عَ يَنقَمَ وْيّن حْشُنمّ رَ.</para>
  <para style="q" vid="PSA 12:3">قِلَنكَقُي نَن عٍ رَ.<verse eid="PSA 12:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 12:4"/>عَلَتَلَ شَ عٍ دّ بَلَن. عٍ دّ عِفبٌ.<verse eid="PSA 12:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 12:5"/>عٍ نَشّ، «مُشُ سّنبّ فبٌ، مُشُ قَتَ وْيّندٍ.</para>
  <para style="q" vid="PSA 12:5">ندٍ نْمَ مُشُ رَ؟»<verse eid="PSA 12:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 12:6"/>عَلَتَلَ عَ مَسٍنمَ،</para>
  <para style="q" vid="PSA 12:6">«ﭑ كٍلِمَ تْورْ مِشِ نُن سٍتَرٍ شَ قٍ رَ يَ.</para>
  <para style="q" vid="PSA 12:6">ﭑ عٍ رَتَنفَمَ مِشِيٍ مَ نَشٍيٍ عٍ حَشَنكَتَمَ.»<verse eid="PSA 12:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 12:7"/>عَلَتَلَ شَ مَسٍنيِ سّنِيّن.</para>
  <para style="q" vid="PSA 12:7">عَ لُمَ عَلْ فبٍتِ</para>
  <para style="q" vid="PSA 12:7">مِشِ نَشَن نَشُنُمَ سَنيَ سٌلٌقٍرٍ</para>
  <para style="q" vid="PSA 12:7">عَلَكٌ عَ فبِ شَ بَ.<verse eid="PSA 12:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 12:8"/>عَلَتَلَ، عِ تْورْ مِشِ كَنتَمَ،</para>
  <para style="q" vid="PSA 12:8">عِ مُشُ رَتَنفَمَ يِ مِشِ مْولِ مَ تّمُي بِرِن.<verse eid="PSA 12:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 12:9"/>نَ مِشِ حَاشِيٍ عٍ مَحّرّ مَ يِرٍ بِرِن،</para>
  <para style="q" vid="PSA 12:9">حَاشُحَ بَرَ فبٌ يّ عَدَ مَدِيٍ يَ مَ.<verse eid="PSA 12:9"/></para>
  <chapter eid="PSA 12"/>
  <chapter number="13" style="c" sid="PSA 13"/>
  <para style="s1">هَن مُن تّمُي؟</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 13:1"/>دَوُدَ شَ بّيتِ بّيتِبَيٍ شَ مَنفّ بّ<verse eid="PSA 13:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 13:2"/>عَلَتَلَ، عِ نّيمُمَ ﭑ مَ هَن مُن تّمُي؟</para>
  <para style="q" vid="PSA 13:2">عِ عِ نْشُنمَ ﭑ مَ هَن مُن تّمُي؟<verse eid="PSA 13:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 13:3"/>ﭑ بْحّ تْورْ مَ هَن مُن تّمُي؟</para>
  <para style="q" vid="PSA 13:3">ﭑ سٌندٌنيِ حَشَنكَتَمَ هَن مُن تّمُي؟</para>
  <para style="q" vid="PSA 13:3">ﭑ لُمَ ﭑ يَشُييٍ بُن مَ هَن مُن تّمُي؟<verse eid="PSA 13:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 13:4"/>ﭑ مَرِفِ عَلَتَلَ، عَ مَتٌ، عِ شَ ﭑ يَابِ.</para>
  <para style="q" vid="PSA 13:4">تِ ﭑ قَنفَ رَ، شَ نَ مُ ﭑ قَشَمَ نّ،<verse eid="PSA 13:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 13:5"/>ﭑ يَشُييٍ قَ عَ قَلَ، «ﭑ بَرَ نْ عَ رَ.»</para>
  <para style="q" vid="PSA 13:5">ﭑ يَشُييٍ حّلّشِنمَ نّ ﭑ مَ بِرّ رَ.<verse eid="PSA 13:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 13:6"/>كْنْ ﭑ تَن بَرَ لَ عِ شَ هِننّ رَ،</para>
  <para style="q" vid="PSA 13:6">ﭑ بْحّ بَرَ حّلّشِن عِ شَ كِسِ شَ قٍ رَ.</para>
  <para style="q" vid="PSA 13:6">ﭑ بّيتِ بَمَ عَلَتَلَ بّ عَ شَ هِننّ نَن مَ.<verse eid="PSA 13:6"/></para>
  <chapter eid="PSA 13"/>
  <chapter number="14" style="c" sid="PSA 14"/>
  <para style="s1">حَاشُحَ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 14:1"/>دَوُدَ شَ بّيتِ بّيتِبَيٍ شَ مَنفّ بّ</para>
  <para style="q" vid="PSA 14:1">شَشِلِتَرٍ عَ قَلَمَ عَ بْحّ كُي، «عَلَ مُ نَ.»</para>
  <para style="q" vid="PSA 14:1">عَ بْحّ بَرَ كَنَ، عَ حَاشُحَ نَن تُن نَبَمَ.</para>
  <para style="q" vid="PSA 14:1">قٍ قَنيِ رَبَيٍ مُ نَ سْنْن.<verse eid="PSA 14:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 14:2"/>عَلَتَلَ عَ يَ رَفٌرٌقٍ عَدَ مَدِيٍ مَ كٍلِ عَرِيَننَ،</para>
  <para style="q" vid="PSA 14:2">عَ شَ عَ تٌ شَ لْننِلَ ندٍ نَ نَ نَشَن عَلَ قٍنمَ.<verse eid="PSA 14:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 14:3"/>كْنْ بِرِن بَرَ كِرَ بّحِن، عٍ حَاشُ.</para>
  <para style="q" vid="PSA 14:3">هَلِ قٍ قَنيِ رَبَمَ كٍرٍن مُ نَ سْنْن.<verse eid="PSA 14:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 14:4"/>مَحْشُنيِ قَنيِ مُ نَ قٍ كٌبِ رَبَيٍ بّ؟</para>
  <para style="q" vid="PSA 14:4">عٍ نَ ﭑ مَ حَمَ شَ فٍينِ نَن تُن دٌنقٍ.</para>
  <para style="q" vid="PSA 14:4">عٍ مُ عَلَتَلَ شِلِمَ قٍقٍ مَ.<verse eid="PSA 14:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 14:5"/>كْنْ عٍ قَمَ سّرّندٍ عَلَ يَ رَ،</para>
  <para style="q" vid="PSA 14:5">نَشَن نَ تِنشِنتْييٍ يَ مَ.<verse eid="PSA 14:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 14:6"/>وٌ بَرَ وَ سٍتَرٍيٍ وَشْنقٍ كَنَقٍ،</para>
  <para style="q" vid="PSA 14:6">كْنْ عٍ كَنتَ مَرِفِ عَلَتَلَ نَ نَ.<verse eid="PSA 14:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 14:7"/>ندٍ قَمَ كِسِ رَ عِسِرَيِلَ بّ كٍلِقٍ سِيٌن؟</para>
  <para style="q" vid="PSA 14:7">عَلَتَلَ نَن قَمَ عَ شَ حَمَ رَ مِنِدٍ كٌنيِيَ كُي.</para>
  <para style="q" vid="PSA 14:7">يَشُبَ بْنسْي سّيوَ مَ نّ، عِسِرَيِلَ حّلّشِنمَ نّ!<verse eid="PSA 14:7"/></para>
  <chapter eid="PSA 14"/>
  <chapter number="15" style="c" sid="PSA 15"/>
  <para style="s1">سَلِ مِشِ</para>
  <para style="s2">عَلَ شَ سّرِيّ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 15:1"/>دَوُدَ شَ بّيتِ</para>
  <para style="q" vid="PSA 15:1">عَلَتَلَ، ندٍ نْمَ لُدٍ عِ شَ سَلِدٍ كُي؟</para>
  <para style="q" vid="PSA 15:1">ندٍ نْمَ سَبَتِدٍ عِ شَ فٍيَ سّنِيّنشِ قَرِ؟<verse eid="PSA 15:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 15:2"/>مِشِ نَشَن حّرّ مَ تِنشِنيِ كِرَ شْن مَ،</para>
  <para style="q" vid="PSA 15:2">نَشَن قٍ قَنيِ رَبَمَ،</para>
  <para style="q" vid="PSA 15:2">نَشَن نْندِ قَلَمَ عَ بْحّ قِيشّ رَ.<verse eid="PSA 15:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 15:3"/>عَ مُ مِشِ مَقَلَمَ،</para>
  <para style="q" vid="PSA 15:3">عَ مُ قٍ حَاشِ رَبَمَ عَ بٌورٍ رَ،</para>
  <para style="q" vid="PSA 15:3">عَ مَن مُ عَ رَيَافِمَ.<verse eid="PSA 15:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 15:4"/>عَ عَ مَكُيَمَ مِشِ رَ نَشَن مُ رَقَن عَلَ مَ،</para>
  <para style="q" vid="PSA 15:4">كْنْ عَ مِشِ بِنيَمَ نَشَن فَاشُمَ عَلَ يَ رَ.</para>
  <para style="q" vid="PSA 15:4">هَلِ عَ تْورْ مَ، عَ مُ عَ شَ مَرَكَلِ مَسَرَ مَ.<verse eid="PSA 15:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 15:5"/>عَ مُ مِشِ دٌنِمَ كْبِرِ رَ عَلَكٌ عَ شَ فٍينِ سْتْ.</para>
  <para style="q" vid="PSA 15:5">عَ مُ كْبِرِ رَ سُشُمَ عَ شَ وُلٍ سَ مِشِ شُن مَ.</para>
  <para style="q" vid="PSA 15:5">يِ مِشِ مْولِ مُ دِنكٌنمَ عَبَدَن.<verse eid="PSA 15:5"/></para>
  <chapter eid="PSA 15"/>
  <chapter number="16" style="c" sid="PSA 16"/>
  <para style="s1">عَلَ شَنُنتٍنيِ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 16:1"/>دَوُدَ شَ سُوكِ</para>
  <para style="q" vid="PSA 16:1">عَلَ، عِ شَ ﭑ كَنتَ!</para>
  <para style="q" vid="PSA 16:1">ﭑ مَ كَنتَرِ نَ عِ يِ رَ.<verse eid="PSA 16:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 16:2"/>عَلَتَلَ، ﭑ مَرِفِ نَن عِ رَ.</para>
  <para style="q" vid="PSA 16:2">ﭑ مَ قٍ قَنيِ بِرِن نَ عِ تَن نَن يِ.<verse eid="PSA 16:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 16:3"/>يِ بْشِ سّنِيّنتْييٍ رَقَن ﭑ مَ.</para>
  <para style="q" vid="PSA 16:3">مِشِ شُنفبٍ نَن عٍ رَ.<verse eid="PSA 16:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 16:4"/>كُيٍ بَتُييٍ شَ تْورّ فبٌمَ نّ.</para>
  <para style="q" vid="PSA 16:4">كْنْ ﭑ تَن مُ سّرّشّ وُلِ دَاشِ بَمَ كُيٍيٍ بّ.</para>
  <para style="q" vid="PSA 16:4">ﭑ دّ مُ عٍ شِلِ قَلَمَ.<verse eid="PSA 16:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 16:5"/>سٍسٍ مُ نَ ﭑ يِ رَ، قٌ عَلَتَلَ.</para>
  <para style="q" vid="PSA 16:5">ﭑ وَشْنقٍ بِرِن، عَلَ نَن عَ رَ.</para>
  <para style="q" vid="PSA 16:5">ﭑ مَ دُنِحّءِفِرِ بِرِن نَ عَلَ يِ رَ.<verse eid="PSA 16:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 16:6"/>عَلَ نَشَن سٌشِ ﭑ يِ رَ نَ قَن ﭑ بّ،</para>
  <para style="q" vid="PSA 16:6">ﭑ بَرَ حّلّشِن عَ رَ.<verse eid="PSA 16:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 16:7"/>ﭑ بَرَ عَلَتَلَ تَنتُ، عَ مَرَ سِ قِمَ ﭑ مَ.</para>
  <para style="q" vid="PSA 16:7">هَلِ كْي رَ، ﭑ شَشِلِ سْتْمَ نّ.<verse eid="PSA 16:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 16:8"/>لْشْ يٌ لْشْ ﭑ شَشِلِ تِشِ عَلَتَلَ رَ.</para>
  <para style="q" vid="PSA 16:8">شَ عَ نَ ﭑ سّيتِ مَ، ﭑ مُ بِرَ مَ.<verse eid="PSA 16:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 16:9"/>ﭑ بْحّ حّلّشِنمَ نّ،</para>
  <para style="q" vid="PSA 16:9">ﭑ شَشِلِ سّيوَ مَ نّ،</para>
  <para style="q" vid="PSA 16:9">ﭑ قَتٍ قَن مَلَبُمَ نّ بْحّسَ كُي،<verse eid="PSA 16:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 16:10"/>بَرِ مَ عِ مُ ﭑ نِي رَبّحِنمَ عَلِفِيَمَ.</para>
  <para style="q" vid="PSA 16:10">عِ مُ عِ شَنُنتٍنيِ لُمَ فَبُرِ كُي.<verse eid="PSA 16:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 16:11"/>عِ سِمَيَ كِرَ مَسٍنمَ ﭑ بّ.</para>
  <para style="q" vid="PSA 16:11">حّلّشِنيِ فبٍفبٍ نَ عِ يِرٍ.</para>
  <para style="q" vid="PSA 16:11">قٍ قَنيِ مُ حْنمَ عِ يِرٍ قَنيِ مَ عَبَدَن.<verse eid="PSA 16:11"/></para>
  <chapter eid="PSA 16"/>
  <chapter number="17" style="c" sid="PSA 17"/>
  <para style="s1">ﭑ مَ كِيتِ بٌلٌن</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 17:1"/>دَوُدَ شَ عَلَ مَشَندِ</para>
  <para style="q" vid="PSA 17:1">عَلَتَلَ، ﭑ مَ مَشَندِ رَ مّ تِنشِنيِ شَ قٍ رَ.</para>
  <para style="q" vid="PSA 17:1">عِ تُلِ مَتِ ﭑ وَ شُي رَ.</para>
  <para style="q" vid="PSA 17:1">عِ تُلِ مَتِ ﭑ مَ مَشَندِ شُي رَ وُلٍ مُ نَ نَشَن كُي.<verse eid="PSA 17:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 17:2"/>عِ شَ ﭑ مَ كِيتِ بٌلٌن،</para>
  <para style="q" vid="PSA 17:2">بَرِ مَ نَشَن تِنشِن، عِ نَ كٌلٌن.<verse eid="PSA 17:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 17:3"/>عِ نَ ﭑ بْحّ مَتٌ كْي رَ،</para>
  <para style="q" vid="PSA 17:3">عِ نَ ﭑ مَ دُنِحّءِفِرِ مَتٌ يَنيِ رَ،</para>
  <para style="q" vid="PSA 17:3">عِ مُ تَنتَنيِ يٌ تٌمَ ﭑ نَ.</para>
  <para style="q" vid="PSA 17:3">ﭑ مُ تِنمَ وْيّن حَاشِ شَ مِنِ ﭑ دّ عِ.<verse eid="PSA 17:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 17:4"/>مِشِ فبّتّيٍ قٍ حَاشِ رَبَمَ،</para>
  <para style="q" vid="PSA 17:4">كْنْ ﭑ تَن بَرَ عِ شَ يَامَرِ سُشُ.</para>
  <para style="q" vid="PSA 17:4">ﭑ مُ بِرَ مَ سُوتٍيٍ شَ كِرَيٍ قْشْ رَ.<verse eid="PSA 17:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 17:5"/>ﭑ بِرَ مَ عِ تَن نَن قْشْ رَ،</para>
  <para style="q" vid="PSA 17:5">ﭑ مُ نَ كِرَ بّحِنمَ.<verse eid="PSA 17:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 17:6"/>عَلَ، ﭑ عِ شِلِمَ نّ، بَرِ مَ عِ يَابِ قِمَ مِشِ مَ.</para>
  <para style="q" vid="PSA 17:6">يَندِ، عِ شَ عِ تُلِ مَتِ ﭑ مَ مَشَندِ رَ.<verse eid="PSA 17:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 17:7"/>عِ شَ هِننّ مُشُ رَ،</para>
  <para style="q" vid="PSA 17:7">عِ تَن نَشَن مِشِيٍ رَكِسِمَ عٍ يَشُييٍ مَ،</para>
  <para style="q" vid="PSA 17:7">نَشٍيٍ يِفِيَ قٍنمَ عِ رَ.<verse eid="PSA 17:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 17:8"/>مّينِ ﭑ مَ عَلْ عِ يَ قِرِنيِيٍ.</para>
  <para style="q" vid="PSA 17:8">ﭑ نْشُن عَلْ تْشّيْرّ</para>
  <para style="q" vid="PSA 17:8">نَشَن عَ نْشُنمَ عَ نفَ فَبُتٍنيِيٍ بُن مَ.<verse eid="PSA 17:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 17:9"/>نَ نَ عَ تٌمَ، مِشِ حَاشِ نَشٍيٍ ﭑ نَبِلِنشِ،</para>
  <para style="q" vid="PSA 17:9">عٍ مُ نْمَ ﭑ نَ.<verse eid="PSA 17:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 17:10"/>يّتّ عِفبٌي نَن عٍ رَ، عٍ دّ عِفبٌ.<verse eid="PSA 17:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 17:11"/>عٍ بَرَ قَ ﭑ قْشْ رَ يَكْسِ،</para>
  <para style="q" vid="PSA 17:11">عٍ ﭑ نَبِلِن، عٍ عَلَكٌ عٍ شَ ﭑ قَشَ.<verse eid="PSA 17:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 17:12"/>عٍ لُشِ عَلْ يّتّ نَشَن سُبٍ قٍنمَ،</para>
  <para style="q" vid="PSA 17:12">عَلْ يّتّ كَامّشِيٍ نَشٍيٍ فبَتَشِ سُبٍ قَشَدٍ.<verse eid="PSA 17:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 17:13"/>عَلَتَلَ، كٍلِ! ﭑ يَشُييٍ فٍرٍ، عِ شَ نْ عٍ رَ.</para>
  <para style="q" vid="PSA 17:13">ﭑ نَتَنفَ مِشِ حَاشِيٍ مَ عِ شَ سَنتِدّفّمَ رَ.<verse eid="PSA 17:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 17:14"/>ﭑ نَتَنفَ نَ دُنِحَ مِشِ مْولِيٍ مَ،</para>
  <para style="q" vid="PSA 17:14">نَشٍيٍ عٍ مَسُندِ سْتْمَ يِ دُنِحّءِفِرِ فبَنسَن كُي.</para>
  <para style="q" vid="PSA 17:14">عٍ رَلُفَ نَ مَسُندِ رَ، عِ نَشَن نَفَتَشِ عٍ بّ.</para>
  <para style="q" vid="PSA 17:14">عٍ شَ دِيٍ قَن شَ وَ سَ نَ رَ،</para>
  <para style="q" vid="PSA 17:14">عَ دْنشْي شَ لُ عٍ شَ مَمَدِيٍ بّ!<verse eid="PSA 17:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 17:15"/>كْنْ ﭑ تَن قَمَ نّ عِ يَتَفِ تٌدٍ تِنشِنيِ سَابُي رَ.</para>
  <para style="q" vid="PSA 17:15">ﭑ نَ شُنُ، ﭑ وَ سَمَ نّ عِ يَتَفِ رَ.<verse eid="PSA 17:15"/></para>
  <chapter eid="PSA 17"/>
  <chapter number="18" style="c" sid="PSA 18"/>
  <para style="s1">عَلَ سّنبّ مَفَاشُشِ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 18:1"/>عَلَتَلَ شَ كٌنيِ دَوُدَ شَ بّيتِ بّيتِبَيٍ شَ مَنفّ بّ. عَ يِ بّيتِ نَن بَ عَلَتَلَ بّ عَ تٌ عَ رَتَنفَ سْلُ نُن عَ يَشُي بِرِن مَ.<verse eid="PSA 18:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 18:2"/>عَلَتَلَ، ﭑ سّنبّ نُن ﭑ شَنُنتٍنيِ نَن عِ رَ.<verse eid="PSA 18:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 18:3"/>ﭑ نَكِسِمَ عَلَتَلَ لُمَ عَلْ قَنيٍ، عَ قِندِ ﭑ بّ تّتّ رَ.</para>
  <para style="q" vid="PSA 18:3">ﭑ مَرِفِ عَلَ لُمَ عَلْ فّمّ شُنفبٍ، ﭑ يِفِيَمَ دّننَشّ.</para>
  <para style="q" vid="PSA 18:3">سّنبّمَ نَن عَ رَ نَشَن ﭑ نَكِسِمَ،</para>
  <para style="q" vid="PSA 18:3">نَشَن ﭑ مَكَنتَمَ.<verse eid="PSA 18:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 18:4"/>ﭑ شَ عَ قَلَ ﭑ شُي عِتٍشِ رَ؛</para>
  <para style="q" vid="PSA 18:4">عَلَ تَنتُ! عَلَ بَرَ ﭑ نَكِسِ ﭑ يَشُييٍ مَ.<verse eid="PSA 18:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 18:5"/>سَيَ نُ بَرَ ﭑ نَبِلِن،</para>
  <para style="q" vid="PSA 18:5">قَشّ نُ بَرَ فبَكُ ﭑ شُن مَ.<verse eid="PSA 18:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 18:6"/>لَاشِرَ نُ بَرَ مَكْرّ ﭑ نَ،</para>
  <para style="q" vid="PSA 18:6">فَبُرِ نُ بَرَ عَ دّ رَبِ ﭑ يَ رَ.<verse eid="PSA 18:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 18:7"/>ﭑ عَلَتَلَ مَشَندِ مَ ﭑ مَ تْورّ كُي،</para>
  <para style="q" vid="PSA 18:7">ﭑ نَن ﭑ مَرِفِ عَلَ شِلِمَ ﭑ شُي عِتٍشِ رَ.</para>
  <para style="q" vid="PSA 18:7">عَ ﭑ شُي مّمَ عَ شَ هْرْ مْبَنشِ كُي،</para>
  <para style="q" vid="PSA 18:7">عَ عَ تُلِ مَتِمَ ﭑ وَ شُي رَ.<verse eid="PSA 18:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 18:8"/>بْشِ نَشَ سّرّن،</para>
  <para style="q" vid="PSA 18:8">فٍيَ نَشَ رَ مَشَ عَلَ شَ شْنّ شَ قٍ رَ.<verse eid="PSA 18:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 18:9"/>عَ شَ شْنّ نَشَ لُ عَلْ تُورِ نَشَن تٍمَ،</para>
  <para style="q" vid="PSA 18:9">عَلْ تّ نَشَن مِنِمَ عَ دّ عِ،</para>
  <para style="q" vid="PSA 18:9">عَلْ تّ وٌلٍ دّشّشِ.<verse eid="PSA 18:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 18:10"/>عَلَ نَشَ كُيٍ عِبْو قِرِن نَ، عَ فٌرٌ،</para>
  <para style="q" vid="PSA 18:10">عَ سَنيِيٍ تِشِ نُشُي عِقْورْشِ قَرِ.<verse eid="PSA 18:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 18:11"/>عَ تِ مَلٍكّ شُن مَ،</para>
  <para style="q" vid="PSA 18:11">عَ حّرّ كٌورٍ مَ قٌيٍ قَرِ.<verse eid="PSA 18:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 18:12"/>عَ عَ نْشُن دِ مِ كُي،</para>
  <para style="q" vid="PSA 18:12">تُنّ نُن نُشُي عِقْورْشِيٍ تَفِ.<verse eid="PSA 18:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 18:13"/>سٍيَمَكْنيِ نَشَ مِنِ عَ يَ رَ نُشُييٍ كُي.</para>
  <para style="q" vid="PSA 18:13">بَلَبَلَنيِ نُن تّ نَشَ فٌرٌ.<verse eid="PSA 18:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 18:14"/>عَلَتَلَ شُي نَشَ لُ عَلْ فَلَنيِ كٍلِقٍ كٌورٍ،</para>
  <para style="q" vid="PSA 18:14">عَلَ شِلِ شُنفبٍ كَنيِ نَشَ عَ شُي رَ مِنِ،</para>
  <para style="q" vid="PSA 18:14">بَلَبَلَنيِ نُن تّ قَن نَشَ فٌرٌ.<verse eid="PSA 18:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 18:15"/>عَ نَشَ عَ شَ تَنبّيٍ وٌلِ،</para>
  <para style="q" vid="PSA 18:15">عَ عَ يَشُييٍ رَيٍنسٍن سٍيَمَكْنيِ يَ رَ.<verse eid="PSA 18:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 18:16"/>بَا نُن بْشِ نَشَ رَبِ عَلَتَلَ شَ شْنّ يَ رَ.<verse eid="PSA 18:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PSA 18:17"/>عَلَتَلَ نَشَ ﭑ سُشُ كٍلِقٍ كٌورٍ مَ،</para>
  <para style="q" vid="PSA 18:17">عَ ﭑ بَ يٍ شْورَ.<verse eid="PSA 18:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 18:18"/>عَ نَشَ ﭑ نَتَنفَ ﭑ يَشُي سّنبّمَيٍ مَ،</para>
  <para style="q" vid="PSA 18:18">ﭑ شْنمِشِ نَشٍيٍ سّنبّ فبٌ ﭑ بّ.<verse eid="PSA 18:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 18:19"/>عٍ نَشَ ﭑ فٍرٍ ﭑ مَ تْورّ كُي،</para>
  <para style="q" vid="PSA 18:19">كْنْ عَلَتَلَ نَشَ ﭑ نَتَنفَ.<verse eid="PSA 18:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 18:20"/>عَ نَشَ ﭑ نَمِنِ فبَلٌي كُي عَ شَ شَنُنتٍيَ سَابُي رَ.<verse eid="PSA 18:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 18:21"/>عَلَتَلَ بَرَ ﭑ مَ تِنشِنيِ سَرٍ رَفبِلٍن ﭑ مَ،</para>
  <para style="q" vid="PSA 18:21">عَ بَرَ ﭑ مَلِ ﭑ مَ كّوَلِ سّنِيّنشِ شَ قٍ رَ.<verse eid="PSA 18:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 18:22"/>ﭑ بَرَ لُ عَلَتَلَ شَ كِرَ شْن،</para>
  <para style="q" vid="PSA 18:22">ﭑ مُ ﭑ مَرِفِ عَلَ بّحِن كٌبِحَ رَ.<verse eid="PSA 18:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 18:23"/>ﭑ بَرَ عَ شَ سّرِيّ بِرِن سُشُ،</para>
  <para style="q" vid="PSA 18:23">ﭑ مُ تٌندِشِ عَ شَ يَامَرِيٍ رَبَتُدٍ.<verse eid="PSA 18:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 18:24"/>ﭑ بَرَ تِنشِن عَ يَ رَ،</para>
  <para style="q" vid="PSA 18:24">ﭑ مُ تِن بِرَدٍ يُنُبِ قْشْ رَ.<verse eid="PSA 18:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 18:25"/>عَلَتَلَ بَرَ ﭑ مَ تِنشِنيِ سَرٍ رَفبِلٍن ﭑ مَ،</para>
  <para style="q" vid="PSA 18:25">عَ بَرَ ﭑ مَلِ ﭑ مَ كّوَلِ سّنِيّنشِ شَ قٍ رَ.<verse eid="PSA 18:25"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="26" style="v" sid="PSA 18:26"/>عِ دُفُتّفّحَ مَسٍنمَ دُفُتّفّحَ كَنيِ بّ.</para>
  <para style="q" vid="PSA 18:26">عِ تِنشِنيِ مَسٍنمَ تِنشِنتْي بّ.<verse eid="PSA 18:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 18:27"/>عِ سّنِيّنيِ مَسٍنمَ سّنِيّنتْي بّ،</para>
  <para style="q" vid="PSA 18:27">كْنْ عِ كْوتَ ندٍ رَبَمَ مِشِ حَاشِ رَ.<verse eid="PSA 18:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 18:28"/>عِ يّتّ مَفٌرٌي رَكِسِمَ نّ،</para>
  <para style="q" vid="PSA 18:28">كْنْ عِ يّتّ عِفبٌي تَن مَفٌرٌ مَ نّ.<verse eid="PSA 18:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 18:29"/>عَلَتَلَ، عِ تَن نَن نَءِيَلَنيِ رَ ﭑ بّ.</para>
  <para style="q" vid="PSA 18:29">ﭑ مَرِفِ عَلَ، ﭑ بَ دِ مِ كُي.<verse eid="PSA 18:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 18:30"/>شَ وٌن بِرِن نَ عَ رَ،</para>
  <para style="q" vid="PSA 18:30">ﭑ مُ فَاشُمَ فَلِ شُنفبٍ فٍرٍدٍ.</para>
  <para style="q" vid="PSA 18:30">ﭑ نْمَ فٍرٍ شْرْشْي رَ عَلَ شَ مَلِ سَابُي رَ.<verse eid="PSA 18:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 18:31"/>عَلَ شَ كِرَ قَن.</para>
  <para style="q" vid="PSA 18:31">عَلَتَلَ شَ مَسٍنيِ تِنشِن.</para>
  <para style="q" vid="PSA 18:31">عَ مِشِيٍ كَنتَمَ نَشٍيٍ يِفِيَ قٍنمَ عَ رَ.<verse eid="PSA 18:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 18:32"/>عَلَ فبّتّ مُ نَ، قٌ عَلَتَلَ.</para>
  <para style="q" vid="PSA 18:32">سّنبّمَ مُ نَ، قٌ وٌن مَرِفِ عَلَ.<verse eid="PSA 18:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 18:33"/>عَلَ نَن سّنبّ قِمَ ﭑ مَ،</para>
  <para style="q" vid="PSA 18:33">عَ ﭑ نَحّرّ سّنِيّنيِ كُي.<verse eid="PSA 18:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 18:34"/>عَ ﭑ مَلِمَ ﭑ شَ لُ عَلْ شٍلِ،</para>
  <para style="q" vid="PSA 18:34">نَشَن قَتَ حّرّدٍ يِرٍ شْرْشْي.<verse eid="PSA 18:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 18:35"/>عَ بَرَ ﭑ نَقَلَ فٍرٍ كُي،</para>
  <para style="q" vid="PSA 18:35">عَ ﭑ مَلِمَ شَلِ قَنيِ رَوَلِدٍ.<verse eid="PSA 18:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 18:36"/>عِ بَرَ ﭑ شُن نَكٍلِ،</para>
  <para style="q" vid="PSA 18:36">عِ بَرَ ﭑ تٌنفٌ عِ شْنيّ عِ،</para>
  <para style="q" vid="PSA 18:36">عِ بَرَ عِ حّنفِ سَ ﭑ شْن مَ.</para>
  <para style="q" vid="PSA 18:36">نَ نَن عَ نِيَشِ ﭑ دَرِيّ سْتْشِ،<verse eid="PSA 18:36"/></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 18:37"/>ﭑ سّنبّ سْتْشِ، عَلَكٌ ﭑ نَشَ بِرَ.<verse eid="PSA 18:37"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="38" style="v" sid="PSA 18:38"/>ﭑ بِرَ مَ ﭑ يَشُييٍ قْشْ رَ هَن ﭑ عٍ سُشُ.</para>
  <para style="q" vid="PSA 18:38">ﭑ مُ فبِلٍنمَ عٍ قْشْ رَ قٌ ﭑ نْ عٍ رَ.<verse eid="PSA 18:38"/></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 18:39"/>ﭑ نٍيٍ رَبِرَ مَ نّ هَن عٍ مُ نْ كٍلِدٍ سْنْن،</para>
  <para style="q" vid="PSA 18:39">عٍ قَ لُ ﭑ سَنيِ بُن.<verse eid="PSA 18:39"/></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 18:40"/>عِ سّنبّ سٌمَ ﭑ يِ رَ ﭑ مَ فٍرٍ كُي.</para>
  <para style="q" vid="PSA 18:40">عِ ﭑ يَشُييٍ رَفٌرٌ مَ ﭑ بُن مَ،<verse eid="PSA 18:40"/></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 18:41"/>عِ عَ نِيَ ﭑ شَ نْ عٍ رَ.</para>
  <para style="q" vid="PSA 18:41">ﭑ شْنمِشِيٍ مُ وْيّنمَ سْنْن.<verse eid="PSA 18:41"/></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 18:42"/>عٍ مِشِيٍ شِلِمَ عٍ شَ قَ عٍ مَلِ،</para>
  <para style="q" vid="PSA 18:42">كْنْ مِشِ يٌ مُ عٍ رَكِسِمَ.</para>
  <para style="q" vid="PSA 18:42">عٍ عَلَتَلَ شِلِمَ، كْنْ عَ قَن مُ عٍ يَابِمَ.<verse eid="PSA 18:42"/></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 18:43"/>ﭑ عٍ لُشُتَمَ نّ عٍ قَ لُ عَلْ شُبٍ،</para>
  <para style="q" vid="PSA 18:43">قٌيٍ نَشَن شَنِنمَ.</para>
  <para style="q" vid="PSA 18:43">ﭑ عٍ بٌرٌنمَ عَلْ بّندّ.<verse eid="PSA 18:43"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="44" style="v" sid="PSA 18:44"/>عِ بَرَ ﭑ نَتَنفَ حَمَ مُرُتَشِ مَ،</para>
  <para style="q" vid="PSA 18:44">عِ قَ ﭑ قِندِ سِيٍ شُنيِ رَ.</para>
  <para style="q" vid="PSA 18:44">ﭑ مُ نَشَن كٌلٌن نَ بَرَ لُ ﭑ بُن مَ.<verse eid="PSA 18:44"/></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 18:45"/>عٍ ﭑ شُي رَبَتُمَ،</para>
  <para style="q" vid="PSA 18:45">شْحّيٍ وْيّن حْشُنمّ قَلَمَ ﭑ بّ.<verse eid="PSA 18:45"/></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 18:46"/>عٍ مُ سُو سَمَ ﭑ يَ رَ.</para>
  <para style="q" vid="PSA 18:46">عٍ مِنِمَ عٍ شَ تّتّ مَكَنتَشِ كُي فَاشُي رَ.<verse eid="PSA 18:46"/></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 18:47"/>عَلَتَلَ سّنبّ مُ حْنمَ عَبَدَن.</para>
  <para style="q" vid="PSA 18:47">تَنتُي نَ ﭑ مَ كَنتَمَ بّ.</para>
  <para style="q" vid="PSA 18:47">تَنتُي نَ ﭑ مَرِفِ عَلَ مَرَكِسِمَ بّ.<verse eid="PSA 18:47"/></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 18:48"/>عَلَ نَن ﭑ فبٍحْشْمَ.</para>
  <para style="q" vid="PSA 18:48">عَلَ نَن سِيٍ رَبِرَ مَ ﭑ مَ نْي بُن مَ.<verse eid="PSA 18:48"/></para>
  <para style="q">
    <verse number="49" style="v" sid="PSA 18:49"/>عَلَ نَن ﭑ نَتَنفَمَ ﭑ يَشُييٍ مَ.</para>
  <para style="q" vid="PSA 18:49">عِ تَن نَن ﭑ عِتٍمَ ﭑ يَشُييٍ شُن مَ.</para>
  <para style="q" vid="PSA 18:49">عِ تَن نَن ﭑ نَتَنفَمَ سُوتٍيٍ مَ.<verse eid="PSA 18:49"/></para>
  <para style="q">
    <verse number="50" style="v" sid="PSA 18:50"/>عَلَتَلَ، ﭑ عِ تَنتُمَ سِيٍ تَفِ نَ بِرِن نَن مَ،</para>
  <para style="q" vid="PSA 18:50">ﭑ بّيتِ بَمَ نّ عِ بّ.<verse eid="PSA 18:50"/></para>
  <para style="q">
    <verse number="51" style="v" sid="PSA 18:51"/>عَ شُننَكٍلِ نُن هِننّ قِمَ نّ عَ شَ مِشِ سُفَندِشِ مَ،</para>
  <para style="q" vid="PSA 18:51">نَشَن قِندِ مَنفّ دَوُدَ نُن عَ شَ دِيٍ رَ عَبَدَن.<verse eid="PSA 18:51"/></para>
  <chapter eid="PSA 18"/>
  <chapter number="19" style="c" sid="PSA 19"/>
  <para style="s1">عَلَ شَ نْرّ نُن سّرِيّ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 19:1"/>دَوُدَ شَ بّيتِ بّيتِبَيٍ شَ مَنفّ بّ<verse eid="PSA 19:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 19:2"/>كٌورٍ عَلَ شَ نْرّ مَسٍنمَ.</para>
  <para style="q" vid="PSA 19:2">كٌورٍ وَلَشّ عَلَ شَ وَلِ مَسٍنمَ.<verse eid="PSA 19:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 19:3"/>يَنيِ لْننِ مَسٍنمَ لْشْ يٌ لْشْ.</para>
  <para style="q" vid="PSA 19:3">دِ مِ شَشِلِ مَسٍنمَ كْي يٌ كْي.<verse eid="PSA 19:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 19:4"/>شُي يَتِ يَتِ مُ عَ رَ،</para>
  <para style="q" vid="PSA 19:4">وْيّنيِ قَن مُ عَ رَ.</para>
  <para style="q" vid="PSA 19:4">تُلِ مُ نْمَ عٍ شُي مّدٍ.<verse eid="PSA 19:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 19:5"/>عٍ قْشِ تٌمَ دُنِحَ بِرِن مَ.</para>
  <para style="q" vid="PSA 19:5">عٍ قْشِ يِرٍ مَكُيٍ بِرِن لِمَ،</para>
  <para style="q" vid="PSA 19:5">هَن سٌفٍ سَ سَمَ كَنكِرَ نَشَن كُي.<verse eid="PSA 19:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 19:6"/>سٌفٍ مِنِمَ نّ عَلْ شّمّ نَشَن بَشِ فِنّ دْشْدٍ،</para>
  <para style="q" vid="PSA 19:6">عَ قَ مِنِ عَ شَ كٌنكٌي كُي،</para>
  <para style="q" vid="PSA 19:6">عَلْ مِشِ شُنفبٍ نَشَن حّرّ مَ عَ يّتّ شَ كِرَ شْن.<verse eid="PSA 19:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 19:7"/>عَ حّرّ قْلْمَ سٌفٍتٍدٍ، عَ سَ حْن سٌفٍفٌرٌدٍ.</para>
  <para style="q" vid="PSA 19:7">سٍسٍ مُ نْمَ عَ وُيٍنيِ بَدٍ.<verse eid="PSA 19:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 19:8"/>عَلَتَلَ شَ سّرِيّ، سّرِيّ قَنيِ نَ عَ رَ.</para>
  <para style="q" vid="PSA 19:8">عَ سّنبّ قِمَ مِشِ مَ.</para>
  <para style="q" vid="PSA 19:8">عَلَتَلَ شَ نْندِ، نْندِ يَتِ نَ عَ رَ.</para>
  <para style="q" vid="PSA 19:8">عَ لْننِتَرٍ قِندِ مَ لْننِلَ رَ.<verse eid="PSA 19:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 19:9"/>عَلَتَلَ شَ نْي، نْي تِنشِنشِ نَ عَ رَ.</para>
  <para style="q" vid="PSA 19:9">عَ مِشِ بْحّ رَحّلّشِنمَ نّ.</para>
  <para style="q" vid="PSA 19:9">عَلَتَلَ شَ مَسٍنيِ، مَسٍنيِ تِنسٍشِ نَ عَ رَ.</para>
  <para style="q" vid="PSA 19:9">عَ مِشِ شَشِلِ يَ رَبِمَ نّ.<verse eid="PSA 19:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 19:10"/>عَلَتَلَ شَ يَرَفَاشُي، قٍ سّنِيّنشِ نَ عَ رَ.</para>
  <para style="q" vid="PSA 19:10">عَ مُ حْنمَ عَبَدَن.</para>
  <para style="q" vid="PSA 19:10">عَلَتَلَ شَ يَامَرِ، يَامَرِ قَنيِ نَ عَ رَ.</para>
  <para style="q" vid="PSA 19:10">عَ بِرِن تِنشِن.<verse eid="PSA 19:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 19:11"/>عَلَ شَ يَامَرِ، عَ قَن شّيمَ بّ،</para>
  <para style="q" vid="PSA 19:11">عَ قَن دَنفِ شّيمَ قَنيِ بِرِن نَ.</para>
  <para style="q" vid="PSA 19:11">عَلَ شَ يَامَرِ، عَ حْشُن كُمِ بّ،</para>
  <para style="q" vid="PSA 19:11">عَ حْشُن دَنفِ كُمِ قَنيِ بِرِن نَ.<verse eid="PSA 19:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 19:12"/>عِ شَ كٌنيِ شَشِلِ سْتْمَ نّ عِ شَ سّرِيّ كُي.</para>
  <para style="q" vid="PSA 19:12">عَ فٍينِ فبٍفبٍ تٌمَ نّ نَا.<verse eid="PSA 19:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 19:13"/>ندٍ نْمَ عَ يّتّ كَن يُفٍ حَاشِيٍ بِرِن كٌلٌندٍ؟</para>
  <para style="q" vid="PSA 19:13">عِ شَ ﭑ مَ يُنُبِ نْشُنشِ شَقَرِ ﭑ مُ نَشَن كٌلٌن.<verse eid="PSA 19:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 19:14"/>عِ شَ ﭑ مَ يُنُبِ مَكّنّنشِ مَكُيَ ﭑ نَ.</para>
  <para style="q" vid="PSA 19:14">عَ نَشَ ﭑ سُشُ سّنبّ رَ.</para>
  <para style="q" vid="PSA 19:14">نَ تّمُي ﭑ قَمَ قِندِدٍ مِشِ تِنشِنشِ رَ،</para>
  <para style="q" vid="PSA 19:14">نَشَن مُ يُنُبِ حَاشِ رَبَمَ.<verse eid="PSA 19:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 19:15"/>وْيّنيِ نَشَن كٍلِمَ ﭑ دّ عِ،</para>
  <para style="q" vid="PSA 19:15">عَ نُن وْيّنيِ نَشَن كٍلِمَ ﭑ بْحّ مَ،</para>
  <para style="q" vid="PSA 19:15">عَلَ شَ نَ تٌنفٌ ﭑ بّ حّلّشِنيِ رَ.</para>
  <para style="q" vid="PSA 19:15">عَلَتَلَ، ﭑ كَنتَمَ نَن عِ رَ، عِ بَرَ ﭑ شُنسَرَ.<verse eid="PSA 19:15"/></para>
  <chapter eid="PSA 19"/>
  <chapter number="20" style="c" sid="PSA 20"/>
  <para style="s1">عَلَ شَ مَنفّ مَلِ</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 20:1"/>دَوُدَ شَ بّيتِ بّيتِبَيٍ شَ مَنفّ بّ<verse eid="PSA 20:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 20:2"/>عَلَتَلَ شَ عِ يَابِ عِ شَ تْورّ كُي.</para>
  <para style="q" vid="PSA 20:2">يَشُبَ مَرِفِ عَلَ شَ عِ رَتَنفَ.<verse eid="PSA 20:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 20:3"/>عَلَ شَ عِ مَلِ كٍلِقٍ عَ شَ يِرٍ سّنِيّنشِ،</para>
  <para style="q" vid="PSA 20:3">عَ شَ عِ مَلِ كٍلِقٍ سِيٌن فٍيَ قَرِ.<verse eid="PSA 20:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 20:4"/>عَلَ شَ عِ شَ سّرّشّ بِرِن سُشُ،</para>
  <para style="q" vid="PSA 20:4">عَ شَ حّلّشِن عِ شَ سّرّشّ فَن دَاشِيٍ رَ. <char style="qs">حّنفِ رَتٍ.</char><verse eid="PSA 20:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 20:5"/>عَلَ شَ عِ وَشْنقٍ قِ عِ مَ،</para>
  <para style="q" vid="PSA 20:5">عَ شَ عِ شَ وَلِ سْونّيَ عِ بّ.<verse eid="PSA 20:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 20:6"/>وٌن وٌن شُي عِتٍمَ حّلّشِنيِ كُي.</para>
  <para style="q" vid="PSA 20:6">وٌن وٌن مَ تْنشُمَ عِتٍمَ وٌن مَرِفِ عَلَ شِلِ رَ.</para>
  <para style="q" vid="PSA 20:6">عَلَتَلَ شَ عِ شَ مَشَندِ بِرِن نَسُشُ.<verse eid="PSA 20:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 20:7"/>ﭑ عَ كٌلٌن عَ عَلَتَلَ عَ شَ مِشِ سُفَندِشِ رَكِسِمَ نّ.</para>
  <para style="q" vid="PSA 20:7">عَ عَ يَابِمَ نّ عَ سّنبّ رَ كٍلِقٍ رَ عَ شَ يِرٍ سّنِيّنشِ.<verse eid="PSA 20:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 20:8"/>ندٍ لَمَ عَ شَ سْورِ رَفِسٍ رَ،</para>
  <para style="q" vid="PSA 20:8">ندٍ لَمَ عَ شَ سٌييٍ رَ،</para>
  <para style="q" vid="PSA 20:8">كْنْ وٌن تَن لَشِ وٌن مَرِفِ عَلَتَلَ شِلِ نَن نَ.<verse eid="PSA 20:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 20:9"/>سٌييٍ تَن بِرَ مَ نّ،</para>
  <para style="q" vid="PSA 20:9">كْنْ وٌن تَن تِشِ تُن.<verse eid="PSA 20:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 20:10"/>عَلَتَلَ شَ مَنفّ رَكِسِ،</para>
  <para style="q" vid="PSA 20:10">عَ شَ وٌن مَ مَشَندِ سُشُ.<verse eid="PSA 20:10"/></para>
  <chapter eid="PSA 20"/>
  <chapter number="21" style="c" sid="PSA 21"/>
  <para style="s1">مَنفّ بَرَكَتْي</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 21:1"/>دَوُدَ شَ بّيتِ بّيتِبَيٍ شَ مَنفّ بّ<verse eid="PSA 21:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 21:2"/>عَلَتَلَ، مَنفّ بَرَ سّيوَ عِ سّنبّ رَ.</para>
  <para style="q" vid="PSA 21:2">عَ شَ حّلّشِنيِ فبٌ بَرِ مَ عِ بَرَ عَ رَكِسِ.<verse eid="PSA 21:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 21:3"/>عِ بَرَ عَ وَشْنقٍ رَبَ،</para>
  <para style="q" vid="PSA 21:3">عِ بَرَ عَ شَ دُبّ سُشُ. <char style="qs">حّنفِ رَتٍ.</char><verse eid="PSA 21:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 21:4"/>عِ قَمَ بَرَكّ رَ عَ بّ،</para>
  <para style="q" vid="PSA 21:4">عِ تْنشُمَ مَنفّ دَاشِ دْشْمَ عَ شُن مَ،</para>
  <para style="q" vid="PSA 21:4">عَ يَءِلَنشِ شّيمَ رَ.<verse eid="PSA 21:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 21:5"/>عَ بَرَ عِ مَشَندِ عَ شَ سِمَيَ شَ قٍ رَ.</para>
  <para style="q" vid="PSA 21:5">عِ بَرَ نَ مَشَندِ سُشُ،</para>
  <para style="q" vid="PSA 21:5">عَ شَ سِمَيَ شْن نَشَ كُيَ هَن.<verse eid="PSA 21:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 21:6"/>عِ تٌ عَ رَكِسِ، عَ شَ بِنيّ نَشَ فبٌ.</para>
  <para style="q" vid="PSA 21:6">عِ نَشَ شُننَكٍلِ نُن بِنيّ قِ عَ مَ.<verse eid="PSA 21:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 21:7"/>عِ نَشَ عَ قِندِ بَرَكَتْي شُنفبٍ رَ.</para>
  <para style="q" vid="PSA 21:7">عِ نَشَ عَ رَ سّيوَ عِ يَ عِ.<verse eid="PSA 21:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 21:8"/>مَنفّ لَمَ عَلَتَلَ نَن نَ.</para>
  <para style="q" vid="PSA 21:8">عَ مُ بِرَ مَ عَلَ شِلِ شُنفبٍ شَ هِننّ سَابُي رَ.<verse eid="PSA 21:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 21:9"/>عِ قَمَ عِ يَشُي بِرِن سُشُدٍ.</para>
  <para style="q" vid="PSA 21:9">عِ قَمَ نْدٍ عِ شْنمِشِيٍ رَ.<verse eid="PSA 21:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 21:10"/>عِ نَ قَ، عِ عٍ حْنمَ نّ،</para>
  <para style="q" vid="PSA 21:10">عَلْ تّ بٍلٍبٍلٍ وُرِ فَنمَ كِ نَشّ.</para>
  <para style="q" vid="PSA 21:10">عَلَتَلَ شْنْمَ عٍ مَ هَن تّ عٍ فَن.<verse eid="PSA 21:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 21:11"/>عِ بْنسْييٍ بَمَ نّ دُنِحَ مَ، عِ عَدَ مَدِيٍ رَحْن.<verse eid="PSA 21:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 21:12"/>عٍ بَرَ وَ قٍ حَاشِ رَبَقٍ عِ رَ.</para>
  <para style="q" vid="PSA 21:12">عٍ بَرَ كَتَ هَن،</para>
  <para style="q" vid="PSA 21:12">كْنْ نَ مُ قِندِشِ سْونّيَ يٌ رَ عٍ بّ،<verse eid="PSA 21:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 21:13"/>بَرِ مَ عِ تَن نَن قَمَ عٍ رَفِدٍ عِ شَ شَلِ رَ.<verse eid="PSA 21:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 21:14"/>عَلَتَلَ، عِ شَ عِ سّنبّ مَسٍن عٍ بّ.</para>
  <para style="q" vid="PSA 21:14">مُشُ وَ مَ بّيتِ بَقٍ عِ يَ شْرِ،</para>
  <para style="q" vid="PSA 21:14">مُشُ شَ عِ مَتْشْ عِ سّنبّ شَ قٍ رَ.<verse eid="PSA 21:14"/></para>
  <chapter eid="PSA 21"/>
  <chapter number="22" style="c" sid="PSA 22"/>
  <para style="s1">عَلَ، عِ نَشَ عِ مَكُيَ ﭑ نَ</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 22:1"/>دَوُدَ شَ بّيتِ بّيتِبَيٍ شَ مَنفّ بّ. عَ شَ بَ عَلْ بّيتِ نَشَن شِلِ «سُبَشّ شٍلِ.»<verse eid="PSA 22:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 22:2"/>عَلَ، ﭑ مَرِفِ عَلَ، عِ ﭑ نَبٌلٌشِ مُنقٍ رَ؟</para>
  <para style="q" vid="PSA 22:2">عِ كِسِ مَكُيَ ﭑ نَ، عِ مُ ﭑ وَ شُي رَ مّ؟<verse eid="PSA 22:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 22:3"/>ﭑ مَرِفِ عَلَ، كْي نُن يَنيِ، ﭑ عِ شِلِمَ،</para>
  <para style="q" vid="PSA 22:3">كْنْ عِ مُ ﭑ مَ شِلِ رَتِنمَ.<verse eid="PSA 22:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 22:4"/>كْنْ عِ تَن سّنِيّنتْي،</para>
  <para style="q" vid="PSA 22:4">عِ شَ كِبَنيِ رَبِلِنشِ عِسِرَيِلَ شَ تَنتُي رَ.<verse eid="PSA 22:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 22:5"/>مُشُ بٍنبَيٍ بَرَ دَنشَنِيَ عِ مَ.</para>
  <para style="q" vid="PSA 22:5">عِ بَرَ عٍ رَكِسِ عٍ شَ دَنشَنِيَ سَابُي رَ.<verse eid="PSA 22:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 22:6"/>عٍ تٌ عِ شِلِ، عِ نَشَ عٍ شْرّيَ.</para>
  <para style="q" vid="PSA 22:6">عٍ بَرَ دَنشَنِيَ عِ مَ.</para>
  <para style="q" vid="PSA 22:6">عِ مُ عٍ لُ يَافِ كُي.<verse eid="PSA 22:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 22:7"/>كْنْ ﭑ تَن بَرَ قِندِ مِشِ شُرِ رَ عَلْ دٌندٌلِ،</para>
  <para style="q" vid="PSA 22:7">عَلْ مِشِ مُ نَ ﭑ تَن نَ.</para>
  <para style="q" vid="PSA 22:7">عَدَ مَدِيٍ ﭑ نَيَافِمَ، مِشِيٍ ﭑ مَيٍلٍمَ.<verse eid="PSA 22:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 22:8"/>مِشِ نَشَن بِرِن ﭑ تٌمَ،</para>
  <para style="q" vid="PSA 22:8">عٍ يٌمَ ﭑ مَ.</para>
  <para style="q" vid="PSA 22:8">عٍ دّ ثّتّسِمَ ﭑ مَ،</para>
  <para style="q" vid="PSA 22:8">عٍ عٍ بّلّشّسٌلٍ تِمَ ﭑ مَ عَ حَاشِ رَ.<verse eid="PSA 22:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 22:9"/>عٍ نَشّ، «عِ يَ تِ عَلَتَلَ رَ.</para>
  <para style="q" vid="PSA 22:9">عَ عِ رَكِسِمَ، عَ عِ رَتَنفَمَ،</para>
  <para style="q" vid="PSA 22:9">بَرِ مَ عِ رَقَن عَ مَ!»<verse eid="PSA 22:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 22:10"/>عٍٍ عَلَ، عِ بَرَ ﭑ نَمِنِ ﭑ نفَ تّيفّ،</para>
  <para style="q" vid="PSA 22:10">عِ بَرَ ﭑ سَ عَ كَنكٍ مَ.<verse eid="PSA 22:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 22:11"/>ﭑ شَشِلِ تِشِ عِ رَ كَقِ ﭑ بَرِ تّمُي.</para>
  <para style="q" vid="PSA 22:11">عِ قِندِشِ ﭑ مَرِفِ عَلَ رَ كَقِ ﭑ بَشِ قٌيٍ تٌدٍ.<verse eid="PSA 22:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 22:12"/>عِ نَشَ عِ مَكُيَ ﭑ نَ،</para>
  <para style="q" vid="PSA 22:12">بَرِ مَ كْنتْقِلِ بَرَ وُيَ ﭑ شُن.</para>
  <para style="q" vid="PSA 22:12">مَلِلَ يٌ مُ نَ ﭑ قّ مَ.<verse eid="PSA 22:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 22:13"/>سّنبّمَيٍ بَرَ ﭑ نَبِلِن عَلْ بَسَن تُورَيٍ.<verse eid="PSA 22:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 22:14"/>عٍ دّ رَبِشِ عَلْ يّتّ شَاحّيٍ.<verse eid="PSA 22:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 22:15"/>ﭑ نِي نَ بَقٍ ﭑ قَتٍ، ﭑ شْرِيٍ نَ بَقٍ عٍ رَدْشْدٍيٍ.</para>
  <para style="q" vid="PSA 22:15">ﭑ بْحّ مُ سَمَ، لِمَنِيَ بَرَ بَ ﭑ يِ.<verse eid="PSA 22:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 22:16"/>ﭑ سّنبّ دٌلٌشِ عَلْ بٌورَ.</para>
  <para style="q" vid="PSA 22:16">ﭑ نّنيِ بَرَ كَنكَن ﭑ كْن نَ.</para>
  <para style="q" vid="PSA 22:16">عِ نَ ﭑ مَقِندِقٍ بّندّ رَ.<verse eid="PSA 22:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 22:17"/>مِشِ حَاشِ فَلِ بَرَ ﭑ نَبِلِن عَلْ بَرٍيٍ.</para>
  <para style="q" vid="PSA 22:17">عٍ بَرَ ﭑ بّلّشّ نُن ﭑ سَنيِ تُنبَ.<verse eid="PSA 22:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 22:18"/>ﭑ شْرِ بِرِن سَشِ كّنّ مَ.</para>
  <para style="q" vid="PSA 22:18">عٍ يَ بَنبَنشِ ﭑ نَ.<verse eid="PSA 22:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 22:19"/>عٍ ﭑ مَ دُفِيٍ عِتَشُنمَ عٍ بٌرٍ مَ،</para>
  <para style="q" vid="PSA 22:19">عٍ ﭑ مَ دُفِ قَنيِ مَتٌمَ عَ لَنمَ عَ شَ لُ نَشَن بّ.<verse eid="PSA 22:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="PSA 22:20"/>عَلَتَلَ، عِ نَشَ عِ مَكُيَ ﭑ نَ!</para>
  <para style="q" vid="PSA 22:20">ﭑ مَ سّنبّمَ نَن عِ رَ.</para>
  <para style="q" vid="PSA 22:20">عِ شَ عِ شُلُن ﭑ مَلِدٍ.<verse eid="PSA 22:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 22:21"/>عِ شَ ﭑ نِي رَكِسِ سَنتِدّفّمَ مَ.</para>
  <para style="q" vid="PSA 22:21">عِ شَ ﭑ نَتَنفَ نَ بَرٍيٍ مَ.<verse eid="PSA 22:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 22:22"/>عِ شَ ﭑ نَكِسِ نَ يّتّيٍ مَ.</para>
  <para style="q" vid="PSA 22:22">عِ شَ ﭑ نَكِسِ نَ تُورَيٍ قٍرِيٍ مَ.<verse eid="PSA 22:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="PSA 22:23"/>ﭑ عِ شِلِ مَسٍنمَ نّ ﭑ مَ مِشِيٍ بّ،</para>
  <para style="q" vid="PSA 22:23">ﭑ عِ مَتْشْمَ نّ حَمَ تَفِ.<verse eid="PSA 22:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 22:24"/>وٌ تَن نَشَن فَاشُمَ عَلَتَلَ يَ رَ،</para>
  <para style="q" vid="PSA 22:24">وٌ شَ عَ تَنتُ.</para>
  <para style="q" vid="PSA 22:24">وٌ تَن نَشَن كٍلِشِ وٌ بٍنبَ يَشُبَ بْنسْي،</para>
  <para style="q" vid="PSA 22:24">وٌ شَ عَ مَتْشْ.</para>
  <para style="q" vid="PSA 22:24">وٌ تَن نَشَن كٍلِمَ عِسِرَيِلَ بْنسْي،</para>
  <para style="q" vid="PSA 22:24">وٌ شَ فَاشُ عَ يَ رَ.<verse eid="PSA 22:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 22:25"/>عَلَ مُ يٌمَ مِسِكِينّ شَ تْورّ مَ.</para>
  <para style="q" vid="PSA 22:25">عَ مُ عَ يّتّ نْشُنمَ عَ مَ شّ،</para>
  <para style="q" vid="PSA 22:25">عَ عَ شَ مَشَندِ سُشُمَ نّ.<verse eid="PSA 22:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 22:26"/>عَلَ، ﭑ عِ مَتْشْمَ حَمَ شُنفبٍ يَ مَ.</para>
  <para style="q" vid="PSA 22:26">ﭑ قَمَ ﭑ مَ لَايِدِ رَكَمَلِدٍ مِشِيٍ بّ،</para>
  <para style="q" vid="PSA 22:26">نَشٍيٍ فَاشُمَ عَلَ يَ رَ.<verse eid="PSA 22:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 22:27"/>مِشِ مَفٌرٌشِيٍ قَمَ عٍ دّفٍدٍ، هَن عٍ وَ سَ.</para>
  <para style="q" vid="PSA 22:27">نَشٍيٍ عَلَتَلَ قٍنمَ، عٍ قَمَ عَ مَتْشْدٍ.</para>
  <para style="q" vid="PSA 22:27">عَلَ شَ سِمَيَ قِ وٌ مَ.<verse eid="PSA 22:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 22:28"/>دُنِحَ بِرِن قَمَ رَتُدٍ عَلَتَلَ شَ قٍ مَ،</para>
  <para style="q" vid="PSA 22:28">عٍ مَن بِرِن عٍ يَ رَقِندِ مَ عَ مَ.</para>
  <para style="q" vid="PSA 22:28">سِ بِرِن قَمَ عٍ مَفٌرٌدٍ عَ بّ،<verse eid="PSA 22:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 22:29"/>بَرِ مَ بِرِن نَ عَلَتَلَ شَ مَنفّيَ نَن بُن.</para>
  <para style="q" vid="PSA 22:29">عَ سِ بِرِن يَمَرِ مَ.<verse eid="PSA 22:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 22:30"/>دُنِحَ سّنبّمَيٍ نَ فّ عٍ دّفٍدٍ،</para>
  <para style="q" vid="PSA 22:30">عٍ بِرِن قَمَ عٍ مَفٌرٌدٍ عَلَ بّ.</para>
  <para style="q" vid="PSA 22:30">نَشٍيٍ بِرِن قِندِ مَ بّندّ رَ،</para>
  <para style="q" vid="PSA 22:30">عٍ قَمَ عٍ شُن سِندٍ عَلَ بّ.</para>
  <para style="q" vid="PSA 22:30">عٍ مُ نْمَ عٍ يّتّ نِي رَتَنفَدٍ.<verse eid="PSA 22:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 22:31"/>عَدَ مَدِيٍ بِرِن قَمَ عَلَ بَتُدٍ.</para>
  <para style="q" vid="PSA 22:31">عٍ عٍ مَرِفِ شَ قٍ قَلَمَ عٍ بٌرٍ بّ.<verse eid="PSA 22:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 22:32"/>عَلَ قَمَ عَ شَ تِنشِنيِ مَسٍندٍ</para>
  <para style="q" vid="PSA 22:32">مِشِ بِرِن بّ نَشٍيٍ قَمَ بَرِدٍ.</para>
  <para style="q" vid="PSA 22:32">عَلَ بَرَ نَ رَفِرِ.<verse eid="PSA 22:32"/></para>
  <chapter eid="PSA 22"/>
  <chapter number="23" style="c" sid="PSA 23"/>
  <para style="s1">عَلَتَلَ ﭑ مّينِمَ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="d">دَوُدَ شَ بّيتِ</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 23:1"/>عَلَتَلَ ﭑ مّينِمَ</para>
  <para style="q" vid="PSA 23:1">عَلْ شُرُ سٍ كَنتّ عَ شَ شُرُ سٍ مّينِمَ كِ نَشّ.</para>
  <para style="q" vid="PSA 23:1">سٍ بِرِن نَ ﭑ يِ رَ ﭑ هَيِ نَ نَشَن مَ.<verse eid="PSA 23:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 23:2"/>عَلَتَلَ ﭑ شَنِنمَ قٍ قَنيِ مَ،</para>
  <para style="q" vid="PSA 23:2">عَلْ شُرُ سٍ كَنتّ شُرُ سٍيٍ شَنِنمَ حٌوفٍ قَنيِ مَ كِ نَشّ،</para>
  <para style="q" vid="PSA 23:2">عَلْ عَ عٍ شُن تِمَ يٍ رَشَرَشِ رَ كِ نَشّ.<verse eid="PSA 23:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 23:3"/>عَ سّنبّ قِمَ ﭑ مَ.</para>
  <para style="q" vid="PSA 23:3">عَ ﭑ تِمَ كِرَ تِنشِنشِ شْن، بَرِ مَ عَلَتَلَ نَن عَ رَ.<verse eid="PSA 23:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 23:4"/>هَلِ ﭑ حّرّ دِ مِ كُي، ﭑ مُ فَاشُمَ،</para>
  <para style="q" vid="PSA 23:4">بَرِ مَ عِ نَ ﭑ سّيتِ مَ.</para>
  <para style="q" vid="PSA 23:4">عِ ﭑ كَنتَمَ، عِ ﭑ شُن تِمَ يِرٍ قَنيِ رَ.<verse eid="PSA 23:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 23:5"/>عِ دٌنسٍ رَقَلَمَ ﭑ بّ ﭑ يَشُييٍ يَ شْرِ.</para>
  <para style="q" vid="PSA 23:5">عِ سٍ شِرِ حْشُنمّ سَمَ ﭑ مَ.</para>
  <para style="q" vid="PSA 23:5">عِ ﭑ مَ ثْوتِ رَقٍمَ مِنسٍ رَ عَ قَنيِ رَ.<verse eid="PSA 23:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 23:6"/>هّيرِ نُن هِننّنتٍيَ بِرَ مَ ﭑ قْشْ رَ ﭑ مَ دُنِحّءِفِرِ كُي.</para>
  <para style="q" vid="PSA 23:6">ﭑ لُمَ نّ عَلَ شَ هْرْ مْلِنفِرَ كُي لْشْ يٌ لْشْ،</para>
  <para style="q" vid="PSA 23:6">هَن ﭑ مَ دُنِحّءِفِرِ حْن.<verse eid="PSA 23:6"/></para>
  <chapter eid="PSA 23"/>
  <chapter number="24" style="c" sid="PSA 24"/>
  <para style="s1">ندٍ سٌمَ عَلَ شَ هْرْ مْبَنشِ كُي؟</para>
  <para style="s2">عَلَ شَ سّرِيّ</para>
  <para style="d">دَوُدَ شَ بّيتِ</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 24:1"/>عَلَتَلَ نَن فبٍ نَ بْشِ نُن عَ عِسٍيٍ بِرِن نَ،</para>
  <para style="q" vid="PSA 24:1">دُنِحَ نُن عَدَ مَدِ بِرِن.<verse eid="PSA 24:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 24:2"/>عَ تَن نَن بْشِ دْشْشِ بَايٍ نُن شُرٍيٍ تَفِ.<verse eid="PSA 24:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 24:3"/>ندٍ نْمَ تٍدٍ عَلَتَلَ شَ فٍيَ قَرِ؟</para>
  <para style="q" vid="PSA 24:3">ندٍ نْمَ سٌدٍ عَ شَ هْرْ مْبَنشِ كُي؟<verse eid="PSA 24:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 24:4"/>نَشَن شَ وَلِ قَن،</para>
  <para style="q" vid="PSA 24:4">نَشَن بْحّ سّنِيّن،</para>
  <para style="q" vid="PSA 24:4">نَشَن مُ بِرَ مَ قٍ قُقَقُ قْشْ رَ،</para>
  <para style="q" vid="PSA 24:4">نَشَن مُ وُلٍ قَلَمَ،</para>
  <para style="q" vid="PSA 24:4">نَ كَنيِ نَن سٌمَ عَلَ شَ هْرْ مْبَنشِ كُي.<verse eid="PSA 24:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 24:5"/>عَلَتَلَ بَرَكّ سَمَ عَ مَ،</para>
  <para style="q" vid="PSA 24:5">عَ رَكِسِمَ عَلَ عَ سَرٍ رَفبِلٍنمَ عَ مَ.<verse eid="PSA 24:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 24:6"/>يِ مِشِ مْولِ نَن عَلَ قٍنمَ.</para>
  <para style="q" vid="PSA 24:6">يَشُبَ شَ مِشِيٍ وَ مَ عَلَ كٌلٌنقٍ. <char style="qs">حّنفِ رَتٍ.</char><verse eid="PSA 24:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 24:7"/>تّتّ نَادّيٍ شَ رَبِ،</para>
  <para style="q" vid="PSA 24:7">هْرْ مْبَنشِ نَادّ قٌرِيٍ قَن شَ رَبِ.</para>
  <para style="q" vid="PSA 24:7">نْرّ كَنيِ نَ سٌقٍ.<verse eid="PSA 24:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 24:8"/>ندٍ نَ يِ نْرّ كَنيِ رَ؟</para>
  <para style="q" vid="PSA 24:8">عَلَتَلَ سّنبّمَ نَن عَ رَ،</para>
  <para style="q" vid="PSA 24:8">عَلَتَلَ، نَشَن سّنبّ فبٌ فٍرٍ كُي.<verse eid="PSA 24:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 24:9"/>تّتّ نَادّيٍ شَ رَبِ،</para>
  <para style="q" vid="PSA 24:9">هْرْ مْبَنشِ نَادّ قٌرِيٍ قَن شَ رَبِ.</para>
  <para style="q" vid="PSA 24:9">نْرّ كَنيِ نَ سٌقٍ.<verse eid="PSA 24:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 24:10"/>ندٍ نَ يِ نْرّ كَنيِ رَ؟</para>
  <para style="q" vid="PSA 24:10">مَنفّ عَلَتَلَ نَن نْرّ كَنيِ رَ.<verse eid="PSA 24:10"/></para>
  <chapter eid="PSA 24"/>
  <chapter number="25" style="c" sid="PSA 25"/>
  <para style="s1">عَلَ، هِننّ ﭑ نَ</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">دَوُدَ فبٍ</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 25:1"/>ﭑ شَشِلِ تِشِ عِ تَن عَلَتَلَ نَن نَ.<verse eid="PSA 25:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 25:2"/>ﭑ مَرِفِ عَلَ، ﭑ بَرَ ﭑ يّتّ تَشُ عِ رَ</para>
  <para style="q" vid="PSA 25:2">عَلَكٌ يَافِ نَشَ ﭑ سْتْ،</para>
  <para style="q" vid="PSA 25:2">عَلَكٌ ﭑ يَشُييٍ نَشَ ﭑ مَيٍلٍ.<verse eid="PSA 25:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 25:3"/>نَشَن يٌ لَ عِ رَ، نَ كَنيِ مُ يَافِ سْتْمَ،</para>
  <para style="q" vid="PSA 25:3">كْنْ يَنقَنتٍ تَن، يَافِ سْتْمَ نّ عَ قَنيِ رَ.<verse eid="PSA 25:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 25:4"/>عَلَتَلَ، عِ شَ كِرَ مَسٍن ﭑ بّ،</para>
  <para style="q" vid="PSA 25:4">ﭑ شَرَن عِ شَ كِرَ رَ.<verse eid="PSA 25:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 25:5"/>ﭑ نَحّرّ عِ شَ نْندِ كِرَ شْن،</para>
  <para style="q" vid="PSA 25:5">عِ مَن شَ ﭑ مَتِنكَن عِ شَ كِرَ رَ،</para>
  <para style="q" vid="PSA 25:5">بَرِ مَ عِ تَن عَلَ نَن ﭑ نَكِسِمَ.</para>
  <para style="q" vid="PSA 25:5">ﭑ شَشِلِ تِشِ عِ رَ لْشْي بِرِن.<verse eid="PSA 25:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 25:6"/>عَلَتَلَ، عِ مَحْشُن عِ شَ مَرَقَنيِ نُن عِ شَ قٌنِسِرٍيَ مَ،</para>
  <para style="q" vid="PSA 25:6">بَرِ مَ عٍ نَ نَ كَبِ دُنِحَ قْلّ.<verse eid="PSA 25:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 25:7"/>عِ نَشَ عِ مَحْشُن ﭑ مَ يُنُبِ مَ،</para>
  <para style="q" vid="PSA 25:7">ﭑ نَشَن نَبَشِ ﭑ مَ سّفّتَلَيَ كُي،</para>
  <para style="q" vid="PSA 25:7">ﭑ عِ رَشْنْشِ تّمُي نَشّ.</para>
  <para style="q" vid="PSA 25:7">عَلَتَلَ، عِ مَحْشُن ﭑ مَ عِ شَ قٌنِسِرٍيَ كُي،</para>
  <para style="q" vid="PSA 25:7">بَرِ مَ عِ قَن.<verse eid="PSA 25:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 25:8"/>عَلَتَلَ قَن، عَ تِنشِن.</para>
  <para style="q" vid="PSA 25:8">نَ نَن عَ تٌشِ عَ كِرَ مَسٍنمَ يُنُبِتْييٍ بّ.<verse eid="PSA 25:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 25:9"/>عَ تَن نَن مِشِ مَفٌرٌشِ رَحّرّ مَ تِنشِنيِ كُي.</para>
  <para style="q" vid="PSA 25:9">عَ عٍ مَتِنكَنمَ عَ شَ كِرَ رَ.<verse eid="PSA 25:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 25:10"/>عَلَتَلَ شَ قٌنِسِرٍيَ نُن تِنشِنيِ نَ مِشِيٍ بّ،</para>
  <para style="q" vid="PSA 25:10">نَشٍيٍ عَ شَ سَاتّ نُن عَ شَ يَامَرِ مَبَنبَنمَ.<verse eid="PSA 25:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 25:11"/>عَلَتَلَ، ﭑ مَ يُنُبِيٍ شَقَرِ عِ شِلِ شَ قٍ رَ،</para>
  <para style="q" vid="PSA 25:11">بَرِ مَ عٍ مُ شُرُن.<verse eid="PSA 25:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 25:12"/>ندٍ فَاشُمَ عَلَتَلَ يَ رَ؟</para>
  <para style="q" vid="PSA 25:12">عَلَتَلَ كِرَ مَسٍنمَ نَ كَنيِ بّ</para>
  <para style="q" vid="PSA 25:12">عَ لَنمَ عَ شَ حّرّ نَشَن مَ.<verse eid="PSA 25:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 25:13"/>عَ عَلِفِيَمَ لِمَ نّ سّيوّ كُي.</para>
  <para style="q" vid="PSA 25:13">عَ بْنسْي قَن قَمَ سَبَتِدٍ يِ بْشِ مَ.<verse eid="PSA 25:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 25:14"/>عَلَتَلَ عَ شَ فُندٌ مَسٍنمَ مِشِيٍ بّ،</para>
  <para style="q" vid="PSA 25:14">نَشٍيٍ فَاشُ عَ يَ رَ.</para>
  <para style="q" vid="PSA 25:14">عَ عَ شَ سَاتّ مَسٍنمَ نّ عٍ بّ.<verse eid="PSA 25:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 25:15"/>ﭑ شَشِلِ تِشِ عَلَتَلَ رَ لْشْي بِرِن</para>
  <para style="q" vid="PSA 25:15">بَرِ مَ عَ تَن نَن ﭑ نَتَنفَمَ قٍ حَاشِ مَ.<verse eid="PSA 25:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 25:16"/>عَلَتَلَ، يَندِ، هِننّ ﭑ نَ،</para>
  <para style="q" vid="PSA 25:16">بَرِ مَ تْورْ مِشِ نَن ﭑ نَ،</para>
  <para style="q" vid="PSA 25:16">ﭑ مَلِمَ قَن مُ نَ.<verse eid="PSA 25:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 25:17"/>ﭑ بْحّ بَرَ تْورْ. ﭑ نَمِنِ نَ تْورّ كُي.<verse eid="PSA 25:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 25:18"/>عِ يَ رَ سِفَ ﭑ مَ سُننُنيِ نُن ﭑ مَ حَشَنكَتّ مَ،</para>
  <para style="q" vid="PSA 25:18">عِ شَ دِحّ ﭑ مَ يُنُبِ بِرِن مَ.<verse eid="PSA 25:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 25:19"/>عِ شَ عَ مَتٌ ﭑ يَشُييٍ وُيَشِ كِ نَشّ.</para>
  <para style="q" vid="PSA 25:19">عٍ ﭑ شْنشِ عَ حَاشِ رَ.<verse eid="PSA 25:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 25:20"/>ﭑ نِي مَكَنتَ، عِ شَ ﭑ نَتَنفَ،</para>
  <para style="q" vid="PSA 25:20">عَلَكٌ يَافِ نَشَ ﭑ سْتْ عِ شَ نِينِ بُن مَ.<verse eid="PSA 25:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 25:21"/>سّرِيّ نُن تِنشِنيِ شَ ﭑ كَنتَ</para>
  <para style="q" vid="PSA 25:21">بَرِ مَ ﭑ شَشِلِ تِشِ عِ تَن نَ.<verse eid="PSA 25:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 25:22"/>عَلَ، عِسِرَيِلَ شُنسَرَ عَ شَ تْورّ بِرِن مَ.<verse eid="PSA 25:22"/></para>
  <chapter eid="PSA 25"/>
  <chapter number="26" style="c" sid="PSA 26"/>
  <para style="s1">تِنشِنتْي حّرّ كِ</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">دَوُدَ فبٍ</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 26:1"/>عَلَتَلَ، عِ شَ ﭑ مَ كِيتِ سَ،</para>
  <para style="q" vid="PSA 26:1">بَرِ مَ ﭑ حّرّ كِ تِنشِن.</para>
  <para style="q" vid="PSA 26:1">ﭑ بَرَ ﭑ يّتّ تَشُ عِ رَ،</para>
  <para style="q" vid="PSA 26:1">ﭑ مُ بِرَ مَ.<verse eid="PSA 26:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 26:2"/>عَلَتَلَ، ﭑ بْحّ مَتٌ،</para>
  <para style="q" vid="PSA 26:2">ﭑ سٌندٌنيِ مَكِيتِ،<verse eid="PSA 26:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 26:3"/>بَرِ مَ ﭑ لَشِ عِ شَ هِننّ رَ،</para>
  <para style="q" vid="PSA 26:3">ﭑ مَن ﭑ حّرّ مَ عِ شَ سّرِيّ مَ.<verse eid="PSA 26:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 26:4"/>ﭑ مُ لُمَ وُلٍ قَلّيٍ يَ مَ،</para>
  <para style="q" vid="PSA 26:4">ﭑ مُ حّرّ مَ قِلَنكَقُييٍ تَفِ.<verse eid="PSA 26:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 26:5"/>قٍ كٌبِ رَبَيٍ مُ رَقَن ﭑ مَ،</para>
  <para style="q" vid="PSA 26:5">ﭑ تَن نُن مِشِ حَاشِيٍ مُ لُمَ يِرٍ كٍرٍن.<verse eid="PSA 26:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 26:6"/>عَلَتَلَ، ﭑ نَن ﭑ حّرّ كِ رَ سّنِيّن،</para>
  <para style="q" vid="PSA 26:6">ﭑ مَن لُمَ نّ عِ شَ سّرّشّبَدٍ.<verse eid="PSA 26:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 26:7"/>ﭑ تَنتُي بّيتِ بَمَ،</para>
  <para style="q" vid="PSA 26:7">ﭑ عِ شَ كَابَنَكٌي مَسٍنمَ.<verse eid="PSA 26:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 26:8"/>عَلَتَلَ، عِ شَ هْرْ مْبَنشِ رَقَن ﭑ مَ،</para>
  <para style="q" vid="PSA 26:8">عِ شَ نْرّ نَ دّننَشّ.<verse eid="PSA 26:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 26:9"/>عِ نَشَ ﭑ نِي بَ عَلْ يُنُبِتْييٍ نُن قَشَتِيٍ.<verse eid="PSA 26:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 26:10"/>عٍ قٍ حَاشِيٍ رَبَمَ،</para>
  <para style="q" vid="PSA 26:10">عٍ كْبِرِ رَ سُشُمَ تِنشِنتَرٍيَ رَ.<verse eid="PSA 26:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 26:11"/>كْنْ ﭑ تَن لُمَ تِنشِنيِ كُي.</para>
  <para style="q" vid="PSA 26:11">ﭑ شُن سَرَ، عِ شَ دِحّ.<verse eid="PSA 26:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 26:12"/>ﭑ حّرّ كِ تِنشِن.</para>
  <para style="q" vid="PSA 26:12">ﭑ عَلَتَلَ تَنتُمَ نّ مَلَنيِيٍ كُي.<verse eid="PSA 26:12"/></para>
  <chapter eid="PSA 26"/>
  <chapter number="27" style="c" sid="PSA 27"/>
  <para style="s1">عِ شَشِلِ تِ عَلَتَلَ رَ</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">دَوُدَ فبٍ</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 27:1"/>عَلَتَلَ نَن نَ ﭑ مَ نَءِيَلَنيِ رَ.</para>
  <para style="q" vid="PSA 27:1">ﭑ نَكِسِمَ نَ عَ رَ.</para>
  <para style="q" vid="PSA 27:1">ﭑ لَن ﭑ شَ فَاشُ ندٍ يَ رَ؟</para>
  <para style="q" vid="PSA 27:1">ﭑ مَ دُنِحّءِفِرِ نَ عَلَتَلَ نَن مَ نِينِ بُن مَ.</para>
  <para style="q" vid="PSA 27:1">ﭑ لَن ﭑ شَ فَاشُ ندٍ يَ رَ؟<verse eid="PSA 27:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 27:2"/>ﭑ فٍرٍقَيٍ نُن ﭑ يَشُي نَشٍيٍ قٍ حَاشِ رَبَمَ،</para>
  <para style="q" vid="PSA 27:2">عٍ نَ قَ ﭑ نَهَلَكِدٍ،</para>
  <para style="q" vid="PSA 27:2">عٍ تَن نَن بِرَ مَ.<verse eid="PSA 27:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 27:3"/>هَلِ سْورِ فَالِ ﭑ نَبِلِن،</para>
  <para style="q" vid="PSA 27:3">ﭑ بْحّ مُ سّرّنمَ.</para>
  <para style="q" vid="PSA 27:3">هَلِ سْورِ فَالِ قَ ﭑ فٍرٍدٍ،</para>
  <para style="q" vid="PSA 27:3">ﭑ بْحّ سُو سَمَ نّ.<verse eid="PSA 27:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 27:4"/>ﭑ قٍ كٍرٍن نَن مَشْرِن عَلَتَلَ مَ،</para>
  <para style="q" vid="PSA 27:4">ﭑ نَ نَ نَن قٍنقٍ.</para>
  <para style="q" vid="PSA 27:4">ﭑ وَ مَ لُقٍ عَلَتَلَ شَ هْرْ مْبَنشِ نَن كُي</para>
  <para style="q" vid="PSA 27:4">ﭑ مَ دُنِحّءِفِرِ بِرِن،</para>
  <para style="q" vid="PSA 27:4">عَلَكٌ ﭑ شَشِلِ شَ تِ عَلَتَلَ شَ قٍ قَنيِ رَ،</para>
  <para style="q" vid="PSA 27:4">ﭑ مَن شَ نْ عَ شَ هْرْ مْبَنشِ مَتٌدٍ.<verse eid="PSA 27:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 27:5"/>عَ ﭑ نَتَنفَمَ نّ تْورّ مَ هْرْ مْبَنشِ كُي.</para>
  <para style="q" vid="PSA 27:5">عَ ﭑ نْشُنمَ نّ نَ نِينِ بُن مَ.</para>
  <para style="q" vid="PSA 27:5">عَ ﭑ نَتٍمَ نّ فٍيَ قَرِ.<verse eid="PSA 27:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 27:6"/>عَ ﭑ شُن نَكٍلِمَ نّ ﭑ يَشُييٍ يَ شْرِ نَشٍيٍ ﭑ نَبِلِنشِ.</para>
  <para style="q" vid="PSA 27:6">ﭑ سّرّشّ بَمَ نّ عَ شَ هْرْ مْبَنشِ كُي حّلّشِنيِ رَ.</para>
  <para style="q" vid="PSA 27:6">ﭑ سُوكِ بَ، ﭑ بّيتِ بَ عَلَتَلَ بّ.<verse eid="PSA 27:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 27:7"/>عَلَتَلَ، عِ تُلِ مَتِ ﭑ شُي رَ، ﭑ نَ عِ مَشَندِقٍ.</para>
  <para style="q" vid="PSA 27:7">هِننّ ﭑ نَ، عِ مَن شَ ﭑ يَابِ.<verse eid="PSA 27:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 27:8"/>ﭑ بْحّ وَ مَ عِ قٍنقٍ.</para>
  <para style="q" vid="PSA 27:8">عَلَتَلَ، ﭑ عِ قٍنمَ نّ.<verse eid="PSA 27:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 27:9"/>عِ نَشَ عِ كٌبٍ تِ ﭑ نَ.</para>
  <para style="q" vid="PSA 27:9">عِ نَشَ مّي عِ شَ كٌنيِ رَ شْنّ كُي.</para>
  <para style="q" vid="PSA 27:9">عِ تَن نَن نَ ﭑ مَلِمَ رَ.</para>
  <para style="q" vid="PSA 27:9">ﭑ مَ مَرَكِسِمَ عَلَ، عِ نَشَ ﭑ نَبٌلٌ،</para>
  <para style="q" vid="PSA 27:9">عِ نَشَ ﭑ نَبّحِن.<verse eid="PSA 27:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 27:10"/>شَ ﭑ نفَ نُن ﭑ بَ ﭑ نَبٌلٌ،</para>
  <para style="q" vid="PSA 27:10">عَلَتَلَ تَن عَ مَكْرّ مَ نّ ﭑ نَ.<verse eid="PSA 27:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 27:11"/>عَلَتَلَ، عِ شَ كِرَ مَسٍن ﭑ بّ.</para>
  <para style="q" vid="PSA 27:11">ﭑ شُن تِ كِرَ تِنشِنشِ رَ،</para>
  <para style="q" vid="PSA 27:11">عَلَكٌ ﭑ يَشُييٍ نَشَ ﭑ سُشُ.<verse eid="PSA 27:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 27:12"/>عِ نَشَ ﭑ نَبٌلٌ ﭑ يَشُييٍ شَ عٍ سَفٌ رَبَ ﭑ نَ،</para>
  <para style="q" vid="PSA 27:12">بَرِ مَ عٍ بَرَ قِندِ تْوحّفّلَيٍ رَ ﭑ بّ.</para>
  <para style="q" vid="PSA 27:12">قٍ كٌبِ رَبَيٍ نَن لَنشِ عٍ مَ.<verse eid="PSA 27:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 27:13"/>ﭑ لَشِ عَ رَ ﭑ عَلَتَلَ شَ قٍ قَنيِ تٌمَ نّ</para>
  <para style="q" vid="PSA 27:13">يِ دُنِحَ بّندّ قُحِ قَرِ.<verse eid="PSA 27:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PSA 27:14"/>عِ شَشِلِ تِ عَلَتَلَ رَ.</para>
  <para style="q" vid="PSA 27:14">عِ سّنبّ شُن شَ مَسَ، عِ شَ لِمَنِيَ.</para>
  <para style="q" vid="PSA 27:14">عِ شَشِلِ تِ عَلَتَلَ رَ.<verse eid="PSA 27:14"/></para>
  <chapter eid="PSA 27"/>
  <chapter number="28" style="c" sid="PSA 28"/>
  <para style="s1">عَلَ حّنفِ دْشْشِ عَ شَ مِشِيٍ شْن مَ</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">دَوُدَ فبٍ</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 28:1"/>عَلَتَلَ، ﭑ بَرَ عِ شِلِ.</para>
  <para style="q" vid="PSA 28:1">عِ شَ سّنبّ لُمَ ﭑ بّ عَلْ قَنيٍ.</para>
  <para style="q" vid="PSA 28:1">عِ تُلِ مَتِ ﭑ نَ، شَ نَ مُ عَ رَ ﭑ لُمَ عَلْ قَشَ مِشِ.<verse eid="PSA 28:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 28:2"/>ﭑ نَ ﭑ بّلّشّ عِتٍ عِ بّ عِ شَ يِرٍ سّنِيّنشِ مَبِرِ،</para>
  <para style="q" vid="PSA 28:2">عِ شَ ﭑ مَ مَشَندِ شُي رَ مّ.<verse eid="PSA 28:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 28:3"/>عِ نَشَ ﭑ لُ عَلْ مِشِ حَاشِيٍ نُن تِنشِنتَرٍيٍ.</para>
  <para style="q" vid="PSA 28:3">عٍ عٍ بٌورٍ يَنقَمَ، عٍ بْحّ مُ قَن.<verse eid="PSA 28:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 28:4"/>عٍ شَ وَلِ كٌبِ سَرٍ رَفبِلٍن عٍ مَ.</para>
  <para style="q" vid="PSA 28:4">عٍ نَشَن نَبَشِ مِشِيٍ رَ، عِ شَ نَ رَبَ عٍ قَن نَ.</para>
  <para style="q" vid="PSA 28:4">عَ لَنمَ عٍ شَ نَ مْولِ سْتْ،<verse eid="PSA 28:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 28:5"/>بَرِ مَ عٍ مُ عَلَتَلَ شَ وَلِ كٌلٌن.</para>
  <para style="q" vid="PSA 28:5">عَ قَمَ عٍ رَبِرَدٍ، عٍ مُ كٍلِ سْنْن.<verse eid="PSA 28:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 28:6"/>عَلَتَلَ تَنتُ،</para>
  <para style="q" vid="PSA 28:6">عَ بَرَ ﭑ مَ دُبّ سُشُ.<verse eid="PSA 28:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 28:7"/>عَلَتَلَ نَن نَ ﭑ سّنبّ نُن ﭑ كَنتَمَ رَ.</para>
  <para style="q" vid="PSA 28:7">ﭑ شَشِلِ تِشِ عَ تَن نَن نَ نَشَن ﭑ مَلِمَ.</para>
  <para style="q" vid="PSA 28:7">ﭑ بْحّ سّيوَ مَ نّ، ﭑ قَ بّيتِ بَ عَ بّ.<verse eid="PSA 28:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 28:8"/>عَلَتَلَ نَن عَ شَ حَمَ سّنبّ رَ،</para>
  <para style="q" vid="PSA 28:8">عَ قِندِ عَ شَ مِشِ سُفَندِشِ كَنتَمَ رَ.<verse eid="PSA 28:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 28:9"/>عِ شَ حَمَ رَكِسِ، عِ شَ بَرَكّ رَفٌرٌ عٍ مَ.</para>
  <para style="q" vid="PSA 28:9">مّينِ عٍ مَ</para>
  <para style="q" vid="PSA 28:9">عَلْ شُرُ سٍ دّ مَدٌنيِ مّينِمَ عَ شَ فْورّ مَ كِ نَشّ.</para>
  <para style="q" vid="PSA 28:9">عِ حّنفِ دْشْ عٍ شْن مَ عَبَدَن.<verse eid="PSA 28:9"/></para>
  <chapter eid="PSA 28"/>
  <chapter number="29" style="c" sid="PSA 29"/>
  <para style="s1">عَلَتَلَ شُي مَفَاشُشِ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="d">دَوُدَ شَ بّيتِ</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 29:1"/>مَلٍكّيٍ، وٌ عَلَتَلَ مَتْشْ،</para>
  <para style="q" vid="PSA 29:1">عَ شَ بِنيّ نُن عَ سّنبّ شَ قٍ رَ.<verse eid="PSA 29:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 29:2"/>وٌ شَ عَلَتَلَ مَتْشْ،</para>
  <para style="q" vid="PSA 29:2">وٌ شَ عَ بَتُ عَ نْرّ سّنِيّنشِ كُي.<verse eid="PSA 29:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 29:3"/>عَلَتَلَ شُي مّمَ بَا مَ،</para>
  <para style="q" vid="PSA 29:3">عَلَ بِنيّ كَنيِ شُي لُمَ عَلْ فَلَنيِ،</para>
  <para style="q" vid="PSA 29:3">عَ عَ شُي رَ سِفَمَ بَا شُنفبٍيٍ مَ.<verse eid="PSA 29:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 29:4"/>عَلَتَلَ شُي سّنبّ فبٌ،</para>
  <para style="q" vid="PSA 29:4">عَ مَفَاشُ.<verse eid="PSA 29:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 29:5"/>عَلَتَلَ شُي وُرِ بِلِ شُنفبٍيٍ عِفِرَ مَ،</para>
  <para style="q" vid="PSA 29:5">عَلْ نَشٍيٍ نَ لِبَن بْشِ مَ.<verse eid="PSA 29:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 29:6"/>عَلَتَلَ لِبَن وُرِ بِلِيٍ عِتُفَنمَ عَلْ نِنفٍ دِ،</para>
  <para style="q" vid="PSA 29:6">عَ سِرِيٌن فٍيَ عِتُفَنمَ عَلْ سّشّ عِ نِنفٍ.<verse eid="PSA 29:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 29:7"/>عَلَتَلَ شُي تّ رَيٍنسٍنمَ عَلْ سٍيَمَكْنيِ.<verse eid="PSA 29:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 29:8"/>عَلَتَلَ شُي كَدٍ سِ فبٍنفبٍرٍنيِ رَ سّرّنمَ.<verse eid="PSA 29:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 29:9"/>عَلَتَلَ شُي عَ نِيَمَ شٍلِيٍ نُن سِيٍ شَ بَرِ.</para>
  <para style="q" vid="PSA 29:9">حَمَ بِرِن عٍ شُي عِتٍمَ عَ شَ هْرْ مْبَنشِ كُي،</para>
  <para style="q" vid="PSA 29:9">عَ عَ قَلَ، «مَتْشْي نَ عَلَ بّ!»<verse eid="PSA 29:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 29:10"/>عَلَتَلَ نُ نَ عَ شَ كِبَنيِ كُي دُنِحَ بَنبَرَن يّ تّمُي نَشّ.</para>
  <para style="q" vid="PSA 29:10">عَ شَ مَنفّيَ مُ حْنمَ عَبَدَن.<verse eid="PSA 29:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 29:11"/>عَلَتَلَ نَن سّنبّ قِمَ عَ شَ حَمَ مَ،</para>
  <para style="q" vid="PSA 29:11">عَ بَرَكّ نُن بْحّسَ قِمَ عٍ مَ.<verse eid="PSA 29:11"/></para>
  <chapter eid="PSA 29"/>
  <chapter number="30" style="c" sid="PSA 30"/>
  <para style="s1">عَلَ شَ شْنّ مُ بُمَ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 30:1"/>دَوُدَ شَ بّيتِ عَ نَشَن سّبّ عَلَ شَ هْرْ مْبَنشِ شَ قٍ رَ<verse eid="PSA 30:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 30:2"/>ﭑ بَرَ عِ مَتْشْ عَلَتَلَ،</para>
  <para style="q" vid="PSA 30:2">بَرِ مَ عِ بَرَ ﭑ نَكٍلِ.</para>
  <para style="q" vid="PSA 30:2">عِ مُ تِن ﭑ يَشُييٍ شَ شُننَكٍلِ سْتْ ﭑ شُن مَ.<verse eid="PSA 30:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 30:3"/>ﭑ مَرِفِ عَلَتَلَ، ﭑ تٌ عِ شِلِ،</para>
  <para style="q" vid="PSA 30:3">عِ نَشَ ﭑ نَيَلَن.<verse eid="PSA 30:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 30:4"/>عَلَتَلَ، عِ نَشَ ﭑ نِي رَكِسِ سَيَ مَ،</para>
  <para style="q" vid="PSA 30:4">عِ مُ تِن ﭑ شَ فٌرٌ فَبُرِ كُي.<verse eid="PSA 30:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 30:5"/>دَنشَنِيَتْييٍ، وٌ شَ بّيتِ بَ عَلَتَلَ بّ،</para>
  <para style="q" vid="PSA 30:5">وٌ شَ عَ شِلِ مَتْشْ.<verse eid="PSA 30:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 30:6"/>عَ شَ شْنّ مُ بُمَ،</para>
  <para style="q" vid="PSA 30:6">كْنْ عَ هِننّمَ عِ رَ عِ شَ سِمَيَ بِرِن كُي.</para>
  <para style="q" vid="PSA 30:6">نُنمَرٍ، مِشِيٍ وَ مَ، كْنْ فّيسّفّ عٍ قَ حّلّشِن.<verse eid="PSA 30:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 30:7"/>ﭑ بْحّسَ سْتْ تّمُي نَشّ ﭑ نَشَ عَ قَلَ،</para>
  <para style="q" vid="PSA 30:7">«ﭑ مُ نْمَ بِرَدٍ.»<verse eid="PSA 30:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 30:8"/>عَلَتَلَ، تّمُي دَنفِشِ عِ نَشَ ﭑ سّنبّ لُ عَلْ فٍيَ،</para>
  <para style="q" vid="PSA 30:8">كْنْ يَكْسِ عِ بَرَ عِ نْشُن ﭑ مَ.</para>
  <para style="q" vid="PSA 30:8">ﭑ بْحّ بَرَ عِقُ.<verse eid="PSA 30:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 30:9"/>عَلَتَلَ، ﭑ نَشَ عِ شِلِ، ﭑ نَشَ عِ مَشَندِ.<verse eid="PSA 30:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 30:10"/>ﭑ نَشَ عَ قَلَ عِ بّ،</para>
  <para style="q" vid="PSA 30:10">«ﭑ مَ قَشّ قِندِ مَ فٍينِ مُندُن نَ عِ بّ؟</para>
  <para style="q" vid="PSA 30:10">شَ ﭑ بَرَ فٌرٌ فَبُرِ كُي،</para>
  <para style="q" vid="PSA 30:10">نَ نْمَ قِندِدٍ مَتْشْي رَ عِ بّ؟</para>
  <para style="q" vid="PSA 30:10">نَ نْمَ عِ شَ لَنلَنتٍيَ مَسٍندٍ دُنِحَ بّ؟»<verse eid="PSA 30:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 30:11"/>عَلَتَلَ، عِ تُلِ مَتِ ﭑ نَ، عِ شَ كِنِكِنِ ﭑ مَ.</para>
  <para style="q" vid="PSA 30:11">عَلَتَلَ، ﭑ مَلِ.<verse eid="PSA 30:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 30:12"/>عِ بَرَ ﭑ مَ نِمِسّ مَسَرَ سّيوّ رَ.</para>
  <para style="q" vid="PSA 30:12">عِ بَرَ ﭑ مَ سُننُن دٌنمَ مَسَرَ حّلّشِن دٌنمَ رَ.<verse eid="PSA 30:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 30:13"/>ﭑ مَرِفِ عَلَتَلَ، نَ نَ عَ رَ ﭑ مُ دُندُ مَ،</para>
  <para style="q" vid="PSA 30:13">ﭑ تَنتُي بّيتِ بَمَ نّ عِ بّ عَبَدَن.<verse eid="PSA 30:13"/></para>
  <chapter eid="PSA 30"/>
  <chapter number="31" style="c" sid="PSA 31"/>
  <para style="s1">لَقٍ عَلَ رَ</para>
  <para style="s2">عَلَ مَشَندِ نُن عَلَ مَتْشْي</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 31:1"/>دَوُدَ شَ بّيتِ بّيتِبَيٍ شَ مَنفّ بّ<verse eid="PSA 31:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 31:2"/>عَلَتَلَ، ﭑ بَرَ ﭑ شَشِلِ تِ عِ رَ.</para>
  <para style="q" vid="PSA 31:2">عِ نَشَ تِن ﭑ شَ لُ يَافِ كُي،</para>
  <para style="q" vid="PSA 31:2">عِ شَ كِيتِ قَنيِ سَ ﭑ مَ.<verse eid="PSA 31:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 31:3"/>عِ شَ عِ تُلِ مَتِ ﭑ نَ، ﭑ نَكِسِ.</para>
  <para style="q" vid="PSA 31:3">عِ شَ لُ ﭑ بّ عَلْ قَنيٍ،</para>
  <para style="q" vid="PSA 31:3">عَلْ يِرٍ مَكَنتَشِ عَلَكٌ ﭑ شَ كِسِ.<verse eid="PSA 31:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 31:4"/>ﭑ مَ سّنبّمَ نُن ﭑ مَ كَنتَمَ نَن عِ رَ.</para>
  <para style="q" vid="PSA 31:4">عِ شَ ﭑ شُن تِ كِرَ قَنيِ شْن عِ شِلِ قَنيِ شَ قٍ رَ.<verse eid="PSA 31:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 31:5"/>ﭑ يَشُييٍ بَرَ يّلّ عِتَلَ ﭑ يَ رَ،</para>
  <para style="q" vid="PSA 31:5">كْنْ عِ قَمَ ﭑ نَتَنفَدٍ نَ مَ.<verse eid="PSA 31:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 31:6"/>ﭑ بَرَ ﭑ شَشِلِ تِ عِ رَ.</para>
  <para style="q" vid="PSA 31:6">عَلَتَلَ نْندِ مَرِفِ، عِ بَرَ ﭑ نَكِسِ.<verse eid="PSA 31:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 31:7"/>كُيٍ بَتُي مُ رَقَن ﭑ مَ،</para>
  <para style="q" vid="PSA 31:7">ﭑ تَن، نَن ﭑ تَشُمَ عَلَتَلَ نَن نَ.<verse eid="PSA 31:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 31:8"/>ﭑ سّيوَ مَ نّ عِ شَ هِننّ شَ قٍ رَ،</para>
  <para style="q" vid="PSA 31:8">بَرِ مَ عِ بَرَ ﭑ مَ تْورّيٍ تٌ،</para>
  <para style="q" vid="PSA 31:8">ﭑ سٌندٌنيِ نَ حَشَنكَتَ، عِ نَ كٌلٌن.<verse eid="PSA 31:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 31:9"/>عِ مُ ﭑ سٌشِ ﭑ يَشُييٍ يِ رَ، عِ بَرَ ﭑ شْرّيَ.<verse eid="PSA 31:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 31:10"/>عَلَتَلَ، هِننّ ﭑ نَ،</para>
  <para style="q" vid="PSA 31:10">بَرِ مَ ﭑ نَ تْورْقٍ.</para>
  <para style="q" vid="PSA 31:10">ﭑ قَتٍ بِرِن بَرَ بَ ﭑ مَ.<verse eid="PSA 31:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 31:11"/>ﭑ مَ سِمَيَ نَ حْنقٍ تْورّ كُي.</para>
  <para style="q" vid="PSA 31:11">ﭑ مَ دُنِحّءِفِرِ شْرْشْ.</para>
  <para style="q" vid="PSA 31:11">ﭑ سّنبّ بَرَ حْن ﭑ مَ يُنُبِ شَ قٍ رَ.</para>
  <para style="q" vid="PSA 31:11">ﭑ قَتٍ بَرَ كَنَ <verse eid="PSA 31:11"/><verse number="12" style="v" sid="PSA 31:12"/>ﭑ يَشُييٍ شَ قٍ رَ.</para>
  <para style="q" vid="PSA 31:12">ﭑ بَرَ يَافِ ﭑ دْشْبٌورٍيٍ شْن مَ.</para>
  <para style="q" vid="PSA 31:12">ﭑ بٌورٍيٍ، شَ نَ مُ عَ رَ نَشٍيٍ ﭑ تٌمَ تَا كُي،</para>
  <para style="q" vid="PSA 31:12">عٍ عٍ فِمَ نّ ﭑ مَ.<verse eid="PSA 31:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 31:13"/>عٍ بِرِن بَرَ نّيمُ ﭑ مَ عَلْ ﭑ حَن بَرَ قَشَ.</para>
  <para style="q" vid="PSA 31:13">ﭑ لُشِ عَلْ سٍ لْيشِ.<verse eid="PSA 31:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 31:14"/>ﭑ بَرَ ﭑ يَشُييٍ شُي مّ.</para>
  <para style="q" vid="PSA 31:14">فبَلٌي نَ ﭑ نَبِلِنيِ.</para>
  <para style="q" vid="PSA 31:14">عٍ بَرَ لَن عَ مَ عٍ شَ ﭑ قَشَ.<verse eid="PSA 31:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 31:15"/>كْنْ ﭑ تَن بَرَ ﭑ تَشُ عِ رَ، عِ تَن ﭑ مَرِفِ عَلَتَلَ.<verse eid="PSA 31:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 31:16"/>ﭑ نَ عِ سَفٌي.</para>
  <para style="q" vid="PSA 31:16">ﭑ نَتَنفَ ﭑ يَشُييٍ مَ نَشٍيٍ وَ مَ ﭑ حَشَنكَتَقٍ.<verse eid="PSA 31:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 31:17"/>عِ شَ عِ شَ كٌنيِ تٌ، ﭑ نَكِسِ عِ شَ هِننّ رَ.<verse eid="PSA 31:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 31:18"/>عَلَتَلَ، ﭑ نَ عِ شِلِ، عِ نَشَ ﭑ لُ يَافِ كُي.</para>
  <para style="q" vid="PSA 31:18">عَلَ شَ مِشِ حَاشِيٍ رَيَافِ،</para>
  <para style="q" vid="PSA 31:18">عَلَ شَ عٍ رَ سَبَرِ قَشّ رَ.<verse eid="PSA 31:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 31:19"/>عَلَ شَ عٍ شُي رَدُندُ،</para>
  <para style="q" vid="PSA 31:19">بَرِ مَ يِ وُلٍ قَلّيٍ عٍ يّتّ عِفبٌمَ، عٍ يٌ تِنشِنتْييٍ مَ.<verse eid="PSA 31:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="PSA 31:20"/>عِ شَ هِننّ فبٌ،</para>
  <para style="q" vid="PSA 31:20">عِ نَشَن نَفَتَشِ عِ يَرَفَاشُييٍ بّ،</para>
  <para style="q" vid="PSA 31:20">نَشٍيٍ عِ شَ كَنتَرِ قٍنمَ.<verse eid="PSA 31:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 31:21"/>عِ بَرَ عٍ يِفِيَ عَلَكٌ قٍ كٌبِ رَبَيٍ نَشَ عٍ سُشُ.</para>
  <para style="q" vid="PSA 31:21">عِ بَرَ عٍ رَتَنفَ وُلٍ قَلّيٍ مَ.<verse eid="PSA 31:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 31:22"/>عَلَتَلَ تَنتُ، بَرِ مَ عَ بَرَ هِننّ ﭑ نَ ﭑ مَ تْورّ كُي.<verse eid="PSA 31:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 31:23"/>ﭑ مَ فَاشُي كُي، ﭑ نُ بَرَ عَ قَلَ،</para>
  <para style="q" vid="PSA 31:23">«عِ بَرَ عِ نْشُن ﭑ مَ،»</para>
  <para style="q" vid="PSA 31:23">كْنْ عِ بَرَ ﭑ مَ مَشَندِ سُشُ.<verse eid="PSA 31:23"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="24" style="v" sid="PSA 31:24"/>دَنشَنِيَتْييٍ، وٌ شَ عَلَتَلَ شَنُ.</para>
  <para style="q" vid="PSA 31:24">عَلَتَلَ تٌفٌندِيَتْييٍ رَكِسِمَ نّ،</para>
  <para style="q" vid="PSA 31:24">كْنْ عَ يّتّ عِفبٌي حَشَنكَتَمَ نّ.<verse eid="PSA 31:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 31:25"/>وٌ تَن نَشٍيٍ وٌ شَشِلِ تِشِ عَلَتَلَ رَ،</para>
  <para style="q" vid="PSA 31:25">وٌ وٌ سّنبّ سٌ، وٌ شَ لِمَنِيَ.<verse eid="PSA 31:25"/></para>
  <chapter eid="PSA 31"/>
  <chapter number="32" style="c" sid="PSA 32"/>
  <para style="s1">عَلَ يُنُبِ شَقَرِقٍ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="d">دَوُدَ شَ لْننِ بّيتِ</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 32:1"/>حّلّشِنيِ نَ عَدَ مَ بّ</para>
  <para style="q" vid="PSA 32:1">نَشَن شَ يُنُبِ بَرَ بَ،</para>
  <para style="q" vid="PSA 32:1">نَشَن شَ قٍ كٌبِ بَرَ شَقَرِ.<verse eid="PSA 32:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 32:2"/>حّلّشِنيِ نَ عَدَ مَ بّ</para>
  <para style="q" vid="PSA 32:2">عَلَتَلَ بَرَ دِحّ نَشَن مَ قٍ كٌبِ مَ،</para>
  <para style="q" vid="PSA 32:2">عَ نُن مَءِقُي مُ نَ نَشَن شَشِلِ يَ مَ.<verse eid="PSA 32:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 32:3"/>دَنمِ ﭑ دُندُشِ، ﭑ مُ نْمَ مِنِدٍ تْورّ كُي.</para>
  <para style="q" vid="PSA 32:3">ﭑ نُ تْورْ مَ نّ يَنيِ بِرِن نَ.<verse eid="PSA 32:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 32:4"/>كْي نُن يَنيِ عِ شَ تْورّ نَ ﭑ قَرِ.</para>
  <para style="q" vid="PSA 32:4">ﭑ سّنبّ بَرَ كَنَ،</para>
  <para style="q" vid="PSA 32:4">عَ بَرَ لُ عَلْ فبٍنفبٍرٍن يِرٍ.<verse eid="PSA 32:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 32:5"/>ﭑ بَرَ ﭑ مَ يُنُبِ مَسٍن عِ بّ،</para>
  <para style="q" vid="PSA 32:5">ﭑ مُ ﭑ مَ يُنُبِ نْشُنشِ قَ.</para>
  <para style="q" vid="PSA 32:5">ﭑ بَرَ عَ قَلَ،</para>
  <para style="q" vid="PSA 32:5">«قٌ ﭑ شَ ﭑ مَ يُنُبِ يَ شَرَن عَلَتَلَ بّ.»</para>
  <para style="q" vid="PSA 32:5">عِ تَن عَلَتَلَ بَرَ ﭑ مَ يُنُبِ بَ ﭑ مَ.<verse eid="PSA 32:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 32:6"/>مِشِ تِنشِنشِ بِرِن شَ عِ مَشَندِ عَ وَشَتِ.</para>
  <para style="q" vid="PSA 32:6">شَ تْورّ فبٌ عَلْ بَنبَرَنيِ،</para>
  <para style="q" vid="PSA 32:6">عَ مُ سٍسٍ نِيَمَ عَ رَ.<verse eid="PSA 32:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 32:7"/>ﭑ مَ كَنتَرِ لَنشِ عِ تَن نَن مَ.</para>
  <para style="q" vid="PSA 32:7">عِ مَن سُننُنيِ بَمَ ﭑ مَ.</para>
  <para style="q" vid="PSA 32:7">ﭑ عِ تَنتُمَ نّ عِ شَ مَرَتَنفّ شَ قٍ رَ.<verse eid="PSA 32:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 32:8"/>ﭑ وٌ شَرَنمَ نّ كِرَ رَ</para>
  <para style="q" vid="PSA 32:8">وٌ لَن وٌ شَ بِرَ نَشَن قْشْ رَ.</para>
  <para style="q" vid="PSA 32:8">ﭑ وٌ رَ سِمَ نّ،</para>
  <para style="q" vid="PSA 32:8">ﭑ نَن ﭑ حّنفِ سَمَ نّ وٌ شَ قٍ شْن مَ.<verse eid="PSA 32:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 32:9"/>وٌ نَشَ لُ عَلْ سٌي،</para>
  <para style="q" vid="PSA 32:9">شَ نَ مُ عَ رَ سٌقَلٍ شَشِلِتَرٍ،</para>
  <para style="q" vid="PSA 32:9">نَشَن مُ رَحّرّ مَ قٌ كَرَقٌي رَ.<verse eid="PSA 32:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 32:10"/>قٍ شْنّ فبٍفبٍ رَفَتَشِ مِشِ حَاشِ بّ،</para>
  <para style="q" vid="PSA 32:10">كْنْ نَشَن عَ شَشِلِ تِشِ عَلَتَلَ رَ،</para>
  <para style="q" vid="PSA 32:10">عَلَ شَ قٌنِسِرٍيَ نَ كَنيِ رَبِلِنمَ نّ.<verse eid="PSA 32:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 32:11"/>مِشِ تِنشِنشِيٍ، وٌ سّيوَ عَلَتَلَ رَ،</para>
  <para style="q" vid="PSA 32:11">وٌ مَن شَ حّلّشِن.</para>
  <para style="q" vid="PSA 32:11">وٌ عَلَ تَنتُ حّلّشِنيِ كُي وٌ شُي عِتٍشِ رَ،</para>
  <para style="q" vid="PSA 32:11">وٌ تَن مِشِ تِنشِنشِيٍ بِرِن.<verse eid="PSA 32:11"/></para>
  <chapter eid="PSA 32"/>
  <chapter number="33" style="c" sid="PSA 33"/>
  <para style="s1">عَلَ نَ وْيّن، عَ قٍ رَفِرِ مَ نّ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 33:1"/>تِنشِنتْييٍ، وٌ شَ عَلَتَلَ مَتْشْ وٌ شُي عِتٍشِ رَ.</para>
  <para style="q" vid="PSA 33:1">تِنشِنتْييٍ لَن عٍ شَ عَلَ مَتْشْ.<verse eid="PSA 33:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 33:2"/>وٌ شَ عَلَتَلَ تَنتُ كْرَ رَ،</para>
  <para style="q" vid="PSA 33:2">وٌ شَ بّيتِ بَ كْرَ رَ لُوتِ قُ دَاشِ.<verse eid="PSA 33:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 33:3"/>وٌ شَ بّيتِ نّينّ بَ عَ بّ،</para>
  <para style="q" vid="PSA 33:3">وٌ شَ نَ رَبَ مَشَسٍيٍ رَ وٌ شُي عِتٍشِ رَ.<verse eid="PSA 33:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 33:4"/>عَلَتَلَ شَ مَسٍنيِ تِنشِن،</para>
  <para style="q" vid="PSA 33:4">عَ عَ شَ وَلِ بِرِن نَبَمَ سْوبّ رَ.<verse eid="PSA 33:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 33:5"/>تِنشِنيِ نُن سّرِيّ رَقَن عَ مَ،</para>
  <para style="q" vid="PSA 33:5">دُنِحَ بِرِن نَقٍشِ عَلَتَلَ شَ هِننّ رَ.<verse eid="PSA 33:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 33:6"/>عَلَتَلَ نَشَ كٌورٍ دَا عَ شَ وْيّنيِ رَ.</para>
  <para style="q" vid="PSA 33:6">عَ تٌ وْيّن كٍرٍن قَلَ، تُنبُييٍ نَشَ مِنِ كٍرٍن نَ.<verse eid="PSA 33:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 33:7"/>عَ نَشَ بَا قَن مَلَن يِرٍ كٍرٍن،</para>
  <para style="q" vid="PSA 33:7">عَ شَ يٍ رَفَتَ.<verse eid="PSA 33:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 33:8"/>بْشِ بِرِن شَ فَاشُ عَلَتَلَ يَ رَ.</para>
  <para style="q" vid="PSA 33:8">دُنِحَ مِشِ بِرِن شَ عَ بِنيَ.<verse eid="PSA 33:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 33:9"/>عَ نَ وْيّن، عَ قٍ رَفِرِ مَ نّ.</para>
  <para style="q" vid="PSA 33:9">عَ نَ يَامَرِ قِ، عَ رَبَمَ نّ.<verse eid="PSA 33:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 33:10"/>عَلَتَلَ سِيٍ شَ نَتّيٍ كَنَمَ نّ.</para>
  <para style="q" vid="PSA 33:10">عَ مُ عٍ شَ وَلِ سْونّيَمَ.<verse eid="PSA 33:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 33:11"/>كْنْ عَلَتَلَ شَ قٍ رَفِرِشِيٍ بُمَ عَبَدَن.</para>
  <para style="q" vid="PSA 33:11">عَ وَشْنقٍ سْونّيَمَ نّ وَشَتِ بِرِن.<verse eid="PSA 33:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 33:12"/>حّلّشِنيِ نَ سِ بّ نَشَن مَرِفِ قِندِشِ عَلَتَلَ رَ.</para>
  <para style="q" vid="PSA 33:12">حّلّشِنيِ نَ بْنسْي بّ عَلَتَلَ نَشَن سُفَندِشِ.<verse eid="PSA 33:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 33:13"/>عَلَتَلَ عَ يَ رَفٌرٌ مَ دُنِحَ مَ كٍلِقٍ عَرِيَننَ،</para>
  <para style="q" vid="PSA 33:13">عَ مِشِ بِرِن مَتٌ.<verse eid="PSA 33:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 33:14"/>كٍلِقٍ عَ شْنيِ، عَ دُنِحَ مِشِ بِرِن مَتٌمَ نّ.<verse eid="PSA 33:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 33:15"/>نَشَن عَدَ مَدِيٍ بْحّ دَاشِ،</para>
  <para style="q" vid="PSA 33:15">عَ عَ حّنفِ سَمَ عٍ شَ وَلِيٍ شْن.<verse eid="PSA 33:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 33:16"/>مَنفّ يٌ مُ كِسِمَ عَ شَ سْورِيٍ سَابُي رَ.</para>
  <para style="q" vid="PSA 33:16">سْورِ قَن مُ كِسِمَ عَ يّتّ سّنبّ رَ.<verse eid="PSA 33:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 33:17"/>سْورِ حْشْ عَ مَ عَ شَ سٌي نْمَ عَ رَكِسِدٍ،</para>
  <para style="q" vid="PSA 33:17">كْنْ نَ تَن مُ قِندِ مَ كِسِ رَ عَ بّ.<verse eid="PSA 33:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 33:18"/>عَلَتَلَ نَن مّينِمَ مِشِيٍ مَ</para>
  <para style="q" vid="PSA 33:18">نَشٍيٍ فَاشُمَ عَ يَ رَ،</para>
  <para style="q" vid="PSA 33:18">نَشٍيٍ عٍ شَشِلِ تِمَ عَ شَ هِننّ رَ،<verse eid="PSA 33:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 33:19"/>عَلَكٌ عٍ نِي نَشَ لَاشِرَ،</para>
  <para style="q" vid="PSA 33:19">عَلَكٌ عٍ شَ بَلٌ كَامّ وَشَتِ.<verse eid="PSA 33:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 33:20"/>وٌن شَشِلِ تِشِ عَلَتَلَ نَن نَ.</para>
  <para style="q" vid="PSA 33:20">عَ تَن نَن وٌن مَلِمَ رَ،</para>
  <para style="q" vid="PSA 33:20">عَ تَن نَن وٌن كَنتَمَ رَ.<verse eid="PSA 33:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 33:21"/>وٌن بْحّيٍ سّيوَشِ عَ تَن نَن مَ قٍ رَ،</para>
  <para style="q" vid="PSA 33:21">بَرِ مَ وٌن بَرَ لَ عَ شِلِ سّنِيّنشِ رَ.<verse eid="PSA 33:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 33:22"/>عَلَتَلَ، عِ شَ هِننّ مُشُ رَ،</para>
  <para style="q" vid="PSA 33:22">بَرِ مَ مُشُ شَشِلِ تِشِ عِ تَن نَن نَ.<verse eid="PSA 33:22"/></para>
  <chapter eid="PSA 33"/>
  <chapter number="34" style="c" sid="PSA 34"/>
  <para style="s1">عَلَ يَرَفَاشُييٍ سَرٍ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 34:1"/>دَوُدَ تٌ عَ يّتّ قِندِ دَشُي رَ عَبِمٍلٍكِ يَ عِ عَلَكٌ عَ شَ عَ بّحِن، عَ نَشَ يِ بّيتِ سّبّ.<verse eid="PSA 34:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 34:2"/>ﭑ عَلَتَلَ تَنتُمَ وَشَتِ بِرِن.</para>
  <para style="q" vid="PSA 34:2">عَ شَ مَتْشْي مُ بَمَ ﭑ دّ عِ.<verse eid="PSA 34:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 34:3"/>ﭑ عَلَتَلَ مَتْشْمَ ﭑ بْحّ كُي.</para>
  <para style="q" vid="PSA 34:3">تْورْ مِشِيٍ قَمَ نّ نَ مّدٍ، عٍ قَ سّيوَ.<verse eid="PSA 34:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 34:4"/>وٌن بِرِن شَ عَلَتَلَ بِنيَ،</para>
  <para style="q" vid="PSA 34:4">وٌن شَ عَ شِلِ مَتْشْ.<verse eid="PSA 34:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 34:5"/>ﭑ تٌ عَلَتَلَ مَشَندِ، عَ نَشَ ﭑ يَابِ،</para>
  <para style="q" vid="PSA 34:5">عَ ﭑ مَ فَاشُي بِرِن بَ ﭑ يِ.<verse eid="PSA 34:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 34:6"/>نَشَن نَ عَ يَ تِ عَلَ رَ،</para>
  <para style="q" vid="PSA 34:6">عَ سّيوَ مَ نّ، عَ مُ يَافِمَ.<verse eid="PSA 34:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 34:7"/>شَ تْورْ مِشِ عَ شُي رَ مِنِ،</para>
  <para style="q" vid="PSA 34:7">عَلَتَلَ عَ مّمَ نّ، عَ قَ عَ رَكِسِ عَ شَ تْورّ كُي.<verse eid="PSA 34:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 34:8"/>عَلَتَلَ شَ مَلٍكّ عَلَ يَرَفَاشُييٍ رَبِلِنمَ نّ،</para>
  <para style="q" vid="PSA 34:8">عَ عٍ كَنتَ.<verse eid="PSA 34:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 34:9"/>وٌ عَ مَتٌ، عَلَتَلَ قَن دٍ!</para>
  <para style="q" vid="PSA 34:9">حّلّشِنيِ نَ عَدَ مَ بّ نَشَن شَشِلِ تِشِ عَ رَ.<verse eid="PSA 34:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 34:10"/>سّنِيّنتْييٍ، وٌ شَ فَاشُ عَلَتَلَ يَ رَ،</para>
  <para style="q" vid="PSA 34:10">عَلَكٌ وٌ هَيِ بِرِن شَ قَن.<verse eid="PSA 34:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 34:11"/>كَامّ يّتّيٍ سُشُمَ نّ،</para>
  <para style="q" vid="PSA 34:11">كْنْ عَلَتَلَ قٍنمَيٍ هَيِ بِرِن قَنمَ نّ.<verse eid="PSA 34:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 34:12"/>ﭑ مَ دِيٍ، وٌ قَ، وٌ شَ قَ وٌ تُلِ مَتِ ﭑ نَ.</para>
  <para style="q" vid="PSA 34:12">ﭑ شَ عَلَتَلَ يَرَفَاشُي مَسٍن وٌ بّ.<verse eid="PSA 34:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 34:13"/>ندٍ وَ مَ سِمَيَ شْنكُيٍ شْن؟</para>
  <para style="q" vid="PSA 34:13">ندٍ وَ مَ لُقٍ سّيوّ كُي تّمُي بِرِن؟<verse eid="PSA 34:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 34:14"/>شَ وٌ وَ مَ نَ شْن،</para>
  <para style="q" vid="PSA 34:14">وْيّن حَاشِيٍ نَشَ مِنِ وٌ دّ عِ،</para>
  <para style="q" vid="PSA 34:14">وٌ نَشَ وُلٍ يٌ قَلَ.<verse eid="PSA 34:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 34:15"/>وٌ شَ قٍ حَاشِ لُ نَ، وٌ شَ قٍ قَنيِ رَبَ.</para>
  <para style="q" vid="PSA 34:15">وٌ شَ وٌ تُننَبّشِ بْحّسَ قٍنقٍ رَ.<verse eid="PSA 34:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 34:16"/>عَلَتَلَ تِنشِنتْييٍ تٌمَ نّ،</para>
  <para style="q" vid="PSA 34:16">عَ عَ تُلِ مَتِمَ عٍ وَ شُي رَ.<verse eid="PSA 34:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 34:17"/>عَلَتَلَ عَ كٌبٍ سٌمَ قٍ كٌبِ رَبَيٍ رَ،</para>
  <para style="q" vid="PSA 34:17">عَلَكٌ عٍ شِلِ شَ نّيمُ دُنِحَ رَ.<verse eid="PSA 34:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 34:18"/>تِنشِنتْييٍ نَ عٍ مَوَ عَلَتَلَ بّ،</para>
  <para style="q" vid="PSA 34:18">عَ عَ تُلِ مَتِمَ نّ عٍ رَ،</para>
  <para style="q" vid="PSA 34:18">عَ عٍ بَ عٍ شَ تْورّيٍ كُي.<verse eid="PSA 34:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 34:19"/>عَلَتَلَ لُمَ مِشِ قّ مَ نَشَن سُننُنشِ عَ بْحّ مَ،</para>
  <para style="q" vid="PSA 34:19">عَ مِشِ رَكِسِمَ نَشَن شَشِلِ بَرَ عِقُ.<verse eid="PSA 34:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="PSA 34:20"/>تْورّ فبٍفبٍ تِنشِنتْي لِمَ نّ،</para>
  <para style="q" vid="PSA 34:20">كْنْ عَلَتَلَ عَ رَكِسِمَ نَ بِرِن مَ.<verse eid="PSA 34:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 34:21"/>عَلَتَلَ مّينِمَ نّ عَ مَ،</para>
  <para style="q" vid="PSA 34:21">سٍسٍ مُ عَ تٌمَ.<verse eid="PSA 34:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 34:22"/>قٍ حَاشِ نَن مِشِ حَاشِ قَشَمَ.</para>
  <para style="q" vid="PSA 34:22">تِنشِنتْي يَشُييٍ قَمَ حَشَنكَتَدٍ.<verse eid="PSA 34:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 34:23"/>عَلَتَلَ عَ شَ كٌنيِيٍ شُن سَرَ مَ نّ.</para>
  <para style="q" vid="PSA 34:23">نَشَن عَ شَشِلِ تِمَ عَلَ رَ،</para>
  <para style="q" vid="PSA 34:23">نَ مُ كِيتِ حَاشِ سْتْمَ.<verse eid="PSA 34:23"/></para>
  <chapter eid="PSA 34"/>
  <chapter number="35" style="c" sid="PSA 35"/>
  <para style="s1">مِشِ حَاشِ سَرٍ</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">دَوُدَ فبٍ</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 35:1"/>عَلَتَلَ، عِ شَ مِشِ تْورْ نَشَن وَ مَ ﭑ تْورْقٍ.</para>
  <para style="q" vid="PSA 35:1">نَشَن وَ مَ ﭑ فٍرٍقٍ، نَ كَنيِ فٍرٍ.<verse eid="PSA 35:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 35:2"/>كٍلِ، عِ شَ ﭑ مَلِ عِ شَ فٍرٍ سٌسٍ رَ.<verse eid="PSA 35:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 35:3"/>عِ شَ شَلِ نُن تَنبّ شَ عِتٍ ﭑ يَشُييٍ شِلِ مَ.</para>
  <para style="q" vid="PSA 35:3">عَ قَلَ ﭑ بّ، عَ عِ تَن نَن ﭑ مَ مَرَكِسِمَ رَ.<verse eid="PSA 35:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 35:4"/>عَلَ شَ ﭑ يَشُييٍ رَيَافِ، عَ شَ عٍ شَشِلِ عِقُ،</para>
  <para style="q" vid="PSA 35:4">نَشٍيٍ وَ مَ ﭑ قَشَقٍ.</para>
  <para style="q" vid="PSA 35:4">نَشٍيٍ قٍ حَاشِيٍ مَشِرِ مَ ﭑ شُن مَ،</para>
  <para style="q" vid="PSA 35:4">عَلَ شَ عٍ رَيَافِ، عَ شَ عٍ كٍرِ.<verse eid="PSA 35:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 35:5"/>عٍ شَ لُ عَلْ مَالٍ لَفِ قٌيٍ نَشَن نَيٍنسٍنمَ.</para>
  <para style="q" vid="PSA 35:5">عَلَتَلَ شَ مَلٍكّ شَ عٍ كٍرِ.<verse eid="PSA 35:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 35:6"/>عَلَ شَ عٍ لُ دِ مِ كُي،</para>
  <para style="q" vid="PSA 35:6">عَلَ شَ عٍ شَ كِرَ مَسَلَشُن.</para>
  <para style="q" vid="PSA 35:6">عَلَتَلَ شَ مَلٍكّ شَ عٍ كٍرِ.<verse eid="PSA 35:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 35:7"/>عٍ بَرَ يّلّ عِتَلَ ﭑ يَ رَ،</para>
  <para style="q" vid="PSA 35:7">عٍ بَرَ يِلِ فٍ ﭑ بِرَ مَ دّننَشّ،</para>
  <para style="q" vid="PSA 35:7">عَلَكٌ عٍ شَ ﭑ قَشَ هَلِ ﭑ مُ قٍ حَاشِ يٌ رَبَشِ عٍ رَ.<verse eid="PSA 35:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 35:8"/>عَلَ شَ نَ سَرٍ رَفبِلٍن عٍ مَ.</para>
  <para style="q" vid="PSA 35:8">عَلَ شَ عٍ سُشُ يّلّ كُي، عَلَ شَ عٍ رَبِرَ يِلِ كُي.<verse eid="PSA 35:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 35:9"/>نَ تّمُي ﭑ بْحّ حّلّشِنمَ نّ عَلَتَلَ رَ.</para>
  <para style="q" vid="PSA 35:9">ﭑ سّيوَ مَ نّ عَ شَ مَرَكِسِ شَ قٍ رَ.<verse eid="PSA 35:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 35:10"/>ﭑ بْحّ عَ قَلَمَ نّ،</para>
  <para style="q" vid="PSA 35:10">«عَلَتَلَ، عِ مَنِيّ مُ نَ.</para>
  <para style="q" vid="PSA 35:10">ندٍ نْمَ تْورْ مِشِ رَتَنفَدٍ سّنبّمَ مَ؟</para>
  <para style="q" vid="PSA 35:10">ندٍ نْمَ سٍتَرٍ رَتَنفَدٍ مُحّتِيٍ مَ؟»<verse eid="PSA 35:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 35:11"/>وُلٍ قَلّيٍ ﭑ تْوحّفّمَ،</para>
  <para style="q" vid="PSA 35:11">عٍ نُ قٍ قَلَ عٍ مُ نَشَن كٌلٌن.<verse eid="PSA 35:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 35:12"/>عٍ ﭑ مَ قٍ قَنيِ سَرٍ رَفبِلٍنمَ قٍ حَاشِيٍ رَ.</para>
  <para style="q" vid="PSA 35:12">مِشِ بِرِن بَرَ ﭑ نَبٌلٌ.<verse eid="PSA 35:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 35:13"/>كْنْ عٍ تَن نُ قُرَشِ تّمُي نَشّ،</para>
  <para style="q" vid="PSA 35:13">ﭑ نُ لُمَ سُننُن نَ عٍ بّ،</para>
  <para style="q" vid="PSA 35:13">ﭑ نُ قَ سُنيِ سُشُ، ﭑ عَلَ مَشَندِ عٍ بّ تّمُي بِرِن.<verse eid="PSA 35:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 35:14"/>ﭑ سُننُنشِ عٍ بّ عَلْ ﭑ سُننُنمَ ﭑ بٌورٍ بّ كِ نَشّ،</para>
  <para style="q" vid="PSA 35:14">شَ نَ مُ عَ رَ ﭑ نفَشَكٍرٍنيِ بّ.</para>
  <para style="q" vid="PSA 35:14">ﭑ كِنِكِنِشِ عٍ بّ عَلْ ﭑ كِنِكِنِمَ ﭑ نفَ بّ كِ نَشّ.<verse eid="PSA 35:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 35:15"/>كْنْ تْورّ تٌ ﭑ تَن لِ، عٍ بِرِن نَشَ حّلّشِن.</para>
  <para style="q" vid="PSA 35:15">عٍ نَشَ كَقُ عٍ بٌرٍ مَ ﭑ شِلِ مَ،</para>
  <para style="q" vid="PSA 35:15">عٍ شَ ﭑ حَشَنكَتَ، عٍ شَ ﭑ نَهَلَكِ.<verse eid="PSA 35:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 35:16"/>مِشِ حَاشِيٍ نُن كٌنبِتِيٍ،</para>
  <para style="q" vid="PSA 35:16">عٍ بِرِن ﭑ مَ قٍ شْنشِ، عٍ نُ يٍلٍ.<verse eid="PSA 35:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 35:17"/>ﭑ مَرِفِ، مُنقٍ رَ عِ تِنمَ نَ مْولِ شَ رَبَ؟</para>
  <para style="q" vid="PSA 35:17">ﭑ نِي رَتَنفَ عٍ شَ فٍرٍ مَ، ﭑ نِي رَكِسِ يِ يّتّيٍ مَ.<verse eid="PSA 35:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 35:18"/>نَ كُي ﭑ عِ تَنتُمَ نّ مَلَنيِ شُنفبٍ كُي،</para>
  <para style="q" vid="PSA 35:18">ﭑ عِ مَتْشْمَ حَمَ فبٍفبٍ تَفِ.<verse eid="PSA 35:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PSA 35:19"/>عَلَ شَ ﭑ نَتَنفَ ﭑ يَشُييٍ مَ،</para>
  <para style="q" vid="PSA 35:19">نَشٍيٍ وَ مَ يٌقٍ ﭑ مَ.</para>
  <para style="q" vid="PSA 35:19">عَلَ شَ ﭑ نَتَنفَ ﭑ شْنمِشِيٍ</para>
  <para style="q" vid="PSA 35:19">نَشٍيٍ وَ مَ ﭑ كٌنبِقٍ هَلِ ﭑ مُ قٍ يٌ رَبَشِ عٍ رَ.<verse eid="PSA 35:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 35:20"/>عٍ مُ وْيّن قَنيِ يٌ قَلَمَ،</para>
  <para style="q" vid="PSA 35:20">عٍ مِشِ قَنيِ مَدَشُمَ تُن.<verse eid="PSA 35:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 35:21"/>عٍ ﭑ تْوحّفّمَ عَ قَلَقٍ رَ، «مُشُ بَرَ عَ تٌ.»<verse eid="PSA 35:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 35:22"/>عَلَتَلَ، عِ بَرَ نَ بِرِن تٌ. عِ نَشَ دُندُ دٍ.</para>
  <para style="q" vid="PSA 35:22">ﭑ مَرِفِ، عِ نَشَ عِ مَكُيَ ﭑ نَ.<verse eid="PSA 35:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 35:23"/>ﭑ مَرِفِ عَلَ، كٍلِ،</para>
  <para style="q" vid="PSA 35:23">عِ شَ ﭑ شُن مَفٍرٍ سٌ،</para>
  <para style="q" vid="PSA 35:23">عِ شَ ﭑ شُن مَقَلَ.<verse eid="PSA 35:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 35:24"/>ﭑ مَرِفِ عَلَتَلَ، عِ شَ ﭑ مَ كِيتِ سَ عِ شَ تِنشِنيِ رَ،</para>
  <para style="q" vid="PSA 35:24">عَلَكٌ ﭑ يَشُييٍ نَشَ ﭑ مَيٍلٍ.<verse eid="PSA 35:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 35:25"/>عِ نَشَ تِن عٍ شَ عَ قَلَ،</para>
  <para style="q" vid="PSA 35:25">«مُشُ بَرَ نْ عَ رَ، مُشُ بَرَ عَ مَسْتْ.»<verse eid="PSA 35:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 35:26"/>عَلَ شَ ﭑ شْنمِشِيٍ رَيَافِ،</para>
  <para style="q" vid="PSA 35:26">ﭑ يَشُييٍ شَشِلِ شَ عِقُ.<verse eid="PSA 35:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 35:27"/>عَلَ شَ ﭑ شَنُنتٍنيِيٍ رَ سّيوَ،</para>
  <para style="q" vid="PSA 35:27">نَشٍيٍ عَ قَلَمَ عٍ شُي عِتٍشِ رَ،</para>
  <para style="q" vid="PSA 35:27">«تَنتُي نَ عَلَتَلَ بّ</para>
  <para style="q" vid="PSA 35:27">نَشَن عَ شَ كٌنيِ لُمَ بْحّسَ كُي.»<verse eid="PSA 35:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 35:28"/>ﭑ عِ شَ تِنشِنيِ مَسٍنمَ نّ،</para>
  <para style="q" vid="PSA 35:28">ﭑ عِ تَنتُمَ نّ تّمُي بِرِن.<verse eid="PSA 35:28"/></para>
  <chapter eid="PSA 35"/>
  <chapter number="36" style="c" sid="PSA 36"/>
  <para style="s1">عَدَ مَ شَ حَاشُحَ نُن عَلَ شَ هِننّ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 36:1"/>عَلَتَلَ شَ كٌنيِ دَوُدَ شَ بّيتِ بّيتِبَيٍ شَ مَنفّ بّ<verse eid="PSA 36:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 36:2"/>ﭑ بَرَ مِشِ حَاشِ شَ مَتَندِ مَحْشُن ﭑ بْحّ كُي.</para>
  <para style="q" vid="PSA 36:2">عَ مُ عَ كٌلٌن عَ لَنمَ عَ شَ فَاشُ عَلَ يَ رَ.<verse eid="PSA 36:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 36:3"/>عَ عَ يّتّ عِفبٌمَ هَن عَ مُ نْمَ عَ شَ يُنُبِ تٌدٍ،</para>
  <para style="q" vid="PSA 36:3">عَ مُ نْمَ عَ حّرّ كِ شْندٍ.<verse eid="PSA 36:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 36:4"/>عَ شَ وْيّنيِ حَاشُ، عَ نُ مِشِ مَدَشُ تُن.</para>
  <para style="q" vid="PSA 36:4">عَ مُ قٍ قَنيِ يٌ كٌلٌن.<verse eid="PSA 36:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 36:5"/>عَ قٍ حَاشِ مَحْشُنمَ كْي رَ، عَ قَ كِرَ حَاشِ سُشُ،</para>
  <para style="q" vid="PSA 36:5">بَرِ مَ عَ مُ تٌندِ مَ قٍ كٌبِ لُدٍ.<verse eid="PSA 36:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 36:6"/>عَلَتَلَ، عِ شَ هِننّ كٌورٍ لِمَ،</para>
  <para style="q" vid="PSA 36:6">عِ شَ دُفُتّفّحَ سِفَمَ هَن نُشُي.<verse eid="PSA 36:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 36:7"/>عِ شَ تِنشِنيِ فبٌ عَلْ فٍيَيٍ.</para>
  <para style="q" vid="PSA 36:7">عِ شَ كِيتِ تِلِن عَلْ بَا.</para>
  <para style="q" vid="PSA 36:7">عِ تَن نَن عَدَ مَدِيٍ نُن سُبٍيٍ رَكِسِمَ.<verse eid="PSA 36:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 36:8"/>عَلَ، عِ شَ هِننّ قَن.</para>
  <para style="q" vid="PSA 36:8">عَدَ مَدِيٍ بِرِن يِفِيَ سْتْمَ نّ عِ يِ رَ،</para>
  <para style="q" vid="PSA 36:8">عَلْ تْشْي يْرّيٍ لُمَ عٍ نفَ فَبُتٍنيِيٍ بُن مَ كِ نَشّ.<verse eid="PSA 36:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 36:9"/>عٍ وَ سَمَ عِ شَ نّمّ نَن نَ،</para>
  <para style="q" vid="PSA 36:9">عِ شَ قٍ قَنيِ لُمَ عٍ بّ عَلْ يٍ شِنبٍلِ.<verse eid="PSA 36:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 36:10"/>عِ تَن نَن فبَنسَن نْمَ عَدَ مَ رَبَلٌدٍ.</para>
  <para style="q" vid="PSA 36:10">عِ شَ نَءِيَلَنيِ بَرَ مُشُ شَ كِرَ عِيَلَن.<verse eid="PSA 36:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 36:11"/>عِ شَ هِننّ عِ كٌلٌنمَيٍ رَ،</para>
  <para style="q" vid="PSA 36:11">عِ شَ عِ شَ تِنشِنيِ مَسٍن تِنشِنتْييٍ بّ.<verse eid="PSA 36:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 36:12"/>عِ شَ ﭑ نَتَنفَ يّتّ عِفبٌييٍ مَ،</para>
  <para style="q" vid="PSA 36:12">عِ نَشَ عَ لُ مِشِ حَاشِيٍ شَ ﭑ كٍرِ.<verse eid="PSA 36:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 36:13"/>تِنشِنتَرٍيٍ بِرَ مَ نّ،</para>
  <para style="q" vid="PSA 36:13">عٍ مُ نْمَ كٍلِدٍ سْنْن.<verse eid="PSA 36:13"/></para>
  <chapter eid="PSA 36"/>
  <chapter number="37" style="c" sid="PSA 37"/>
  <para style="s1">مِشِ حَاشِ نُن مِشِ قَنيِ مَسُندِ</para>
  <para style="s2">عَلَ شَ سّرِيّ</para>
  <para style="d">دَوُدَ فبٍ</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 37:1"/>عِ نَشَ كْنتْقِلِ مِشِ حَاشِيٍ رَ.</para>
  <para style="q" vid="PSA 37:1">عِ نَشَ تِن لُدٍ عَلْ عٍ تَن.<verse eid="PSA 37:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 37:2"/>عٍ لِسِمَ نّ مَقُرٍن عَلْ حٌوفٍ،</para>
  <para style="q" vid="PSA 37:2">عٍ قَشَمَ نّ عَلْ سَنسِيٍ.<verse eid="PSA 37:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 37:3"/>عِ شَ عِ تَشُ عَلَتَلَ رَ، عِ شَ قٍ قَنيِ رَبَتُ.</para>
  <para style="q" vid="PSA 37:3">عِ شَ لُ يِ بْشِ مَ، نْندِ شَ قِندِ عِ شَ بَلٌي رَ.<verse eid="PSA 37:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 37:4"/>عَلَتَلَ شَ قِندِ عِ وَشْنقٍ رَ.</para>
  <para style="q" vid="PSA 37:4">نَ كُي عَ عِ وَشْنقٍ رَفِرِ مَ نّ.<verse eid="PSA 37:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 37:5"/>عِ عِ شَشِلِ تِ عَلَتَلَ رَ، عَ بِرِن تَشُ عَ رَ.</para>
  <para style="q" vid="PSA 37:5">عَ تَن نَن قٍ رَفِرِ مَ.<verse eid="PSA 37:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 37:6"/>عَلَ قَمَ عِ شَ نْندِ مَكّنّندٍ</para>
  <para style="q" vid="PSA 37:6">عَلْ عَ سٌفٍ رَ مِنِمَ كِ نَشّ فّيسّفّ.</para>
  <para style="q" vid="PSA 37:6">عَ عِ شَ شُننَكٍلِ مَكّنّنمَ</para>
  <para style="q" vid="PSA 37:6">عَلْ سٌفٍ نَشَن يَنبَمَ يَنيِ رَ.<verse eid="PSA 37:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 37:7"/>عِ بْحّ رَشَرَ عَلَتَلَ يَ عِ،</para>
  <para style="q" vid="PSA 37:7">عِ شَ مَمّ تِ، عَلَ نَ نَ.</para>
  <para style="q" vid="PSA 37:7">عِ نَشَ مِشِ حَاشِ تْونّ هَلِ عَ شَ قٍ بِرِن سْونّيَشِ.<verse eid="PSA 37:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 37:8"/>عِ نَشَ شْنْ، عِ عِ بْحّ مَفٌرٌ.</para>
  <para style="q" vid="PSA 37:8">نَ تْونّ لُ نَ، عَ مُ قٍيٍ سْونّيَمَ عِ بّ.<verse eid="PSA 37:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 37:9"/>عَلَ قَمَ مِشِ حَاشِيٍ رَحْندٍ،</para>
  <para style="q" vid="PSA 37:9">كْنْ نَشٍيٍ عٍ شَشِلِ تِشِ عَلَ رَ،</para>
  <para style="q" vid="PSA 37:9">عٍ قَمَ يِ بْشِ سْتْدٍ كّ رَ.<verse eid="PSA 37:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 37:10"/>عَ مُ بُمَ مِشِ حَاشِيٍ شَ لْي دُنِحَ مَ.</para>
  <para style="q" vid="PSA 37:10">عٍ مُ تٌمَ دّدّ.<verse eid="PSA 37:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 37:11"/>نَشٍيٍ بْحّيٍ مَفٌرٌشِ،</para>
  <para style="q" vid="PSA 37:11">عٍ تَن نَن قَمَ يِ بْشِ سْتْدٍ كّ رَ، عٍ لُ بْحّسَ كُي.<verse eid="PSA 37:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 37:12"/>تِنشِنتَرٍ تِنشِنتْي يَنقَمَ، عَ شْنْ عَ مَ.<verse eid="PSA 37:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 37:13"/>كْنْ مَرِفِ يٍلٍمَ نَ مِشِ حَاشِ مَ،</para>
  <para style="q" vid="PSA 37:13">بَرِ مَ عَ عَ كٌلٌن عَ قَمَ نَشَن سْتْدٍ.<verse eid="PSA 37:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 37:14"/>مِشِ حَاشِيٍ سَنتِدّفّمَ بَمَ عَ تّي عِ،</para>
  <para style="q" vid="PSA 37:14">عٍ شَلِ قَن سُشُ،</para>
  <para style="q" vid="PSA 37:14">عَلَكٌ عٍ شَ مِسِكِينّ نُن سٍتَرٍ تْورْ،</para>
  <para style="q" vid="PSA 37:14">عٍ شَ تِنشِنتْي كْن نَشَبَ.<verse eid="PSA 37:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 37:15"/>كْنْ عٍ تَن نَن قَمَ قَشَدٍ عٍ يّتّ شَ سَنتِدّفّمَ سَابُي رَ.</para>
  <para style="q" vid="PSA 37:15">عٍ شَ شَلِيٍ قَمَ فِرَدٍ.<verse eid="PSA 37:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 37:16"/>سٍ شُرِ نَشَن نَ تِنشِنتْي يِ رَ،</para>
  <para style="q" vid="PSA 37:16">عَ قِسَ مِشِ حَاشِيٍ شَ بَننَيَ بّ،<verse eid="PSA 37:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 37:17"/>بَرِ مَ عَلَتَلَ عٍ سّنبّ كَنَمَ نّ،</para>
  <para style="q" vid="PSA 37:17">عَ قَ تِنشِنتْي مَلِ.<verse eid="PSA 37:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 37:18"/>عَلَتَلَ حّنفِ سَشِ مِشِ قَنيِ شْن.</para>
  <para style="q" vid="PSA 37:18">عٍ كّ بُمَ نّ عَبَدَن.<verse eid="PSA 37:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 37:19"/>عٍ مُ يَافِمَ تْورّ تّمُي، عٍ لُفَمَ نّ كَامّ وَشَتِ.<verse eid="PSA 37:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 37:20"/>كْنْ مِشِ حَاشِيٍ قَشَمَ نّ.</para>
  <para style="q" vid="PSA 37:20">عَلَتَلَ يَشُييٍ لُمَ نّ عَلْ قِيلِ،</para>
  <para style="q" vid="PSA 37:20">نَشَن سّشّ لِسِمَ، عَ قَ فَن.<verse eid="PSA 37:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 37:21"/>مِشِ حَاشِ دٌنِ تٌنفٌمَ نّ، كْنْ عٍ مُ عَ قِمَ.</para>
  <para style="q" vid="PSA 37:21">مِشِ قَنيِ تَن مِشِيٍ كِمَ عَ شَ قٌنِسِرٍيَ كُي.<verse eid="PSA 37:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 37:22"/>عَلَتَلَ شَ بَرَكَتْييٍ يِ بْشِ سْتْمَ نّ كّ رَ،</para>
  <para style="q" vid="PSA 37:22">كْنْ عَلَ نَشَن دَنكَمَ، نَ كَنيِ قَمَ هَلَكِدٍ.<verse eid="PSA 37:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="PSA 37:23"/>نَشَن حّرّ كِ رَقَن عَلَتَلَ مَ،</para>
  <para style="q" vid="PSA 37:23">عَ نَ كَنيِ مَلِمَ نّ عَ شَ دُنِحّءِفِرِ كُي.<verse eid="PSA 37:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 37:24"/>هَلِ عَ سَ دِنكٌن، عَ مُ بِرَ مَ،</para>
  <para style="q" vid="PSA 37:24">بَرِ مَ عَ بّلّشّ نَ عَلَتَلَ يِ رَ.<verse eid="PSA 37:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 37:25"/>كَبِ ﭑ دِ مّدِ تّمُي، هَن ﭑ شّمْشِ رَ،</para>
  <para style="q" vid="PSA 37:25">ﭑ مُ تِنشِنتْي كٍرٍن تٌشِ عَلَ نَشَن نَبّحِنشِ،</para>
  <para style="q" vid="PSA 37:25">نَشَن شَ دِيٍ تَامِ مَكُلَمَ.<verse eid="PSA 37:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 37:26"/>تِنشِنتْي كِ تِمَ، عَ مِشِيٍ دٌنِمَ.</para>
  <para style="q" vid="PSA 37:26">عَ شَ دِيٍ بَرَكّ سْتْمَ نّ.<verse eid="PSA 37:26"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="27" style="v" sid="PSA 37:27"/>عِ شَ قٍ كٌبِ لُ نَ، عِ شَ قٍ قَنيِ رَبَ.</para>
  <para style="q" vid="PSA 37:27">نَ كُي عِ سِمَيَ شْنكُيٍ سْتْمَ نّ.<verse eid="PSA 37:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 37:28"/>سّرِيّ رَقَن عَلَتَلَ مَ.</para>
  <para style="q" vid="PSA 37:28">عَ مُ عَ شَ هِننّنتٍيٍ رَبّحِنمَ.</para>
  <para style="q" vid="PSA 37:28">عَ عٍ كَنتَمَ نّ عَبَدَن.</para>
  <para style="q" vid="PSA 37:28">كْنْ مِشِ حَاشِيٍ بْنسْي قَمَ نّ هَلَكِدٍ.<verse eid="PSA 37:28"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="29" style="v" sid="PSA 37:29"/>تِنشِنتْييٍ قَمَ نّ يِ بْشِ سْتْدٍ كّ رَ،</para>
  <para style="q" vid="PSA 37:29">عٍ لُ بٍ عَبَدَن.<verse eid="PSA 37:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 37:30"/>تِنشِنتْي لْننِ نَن مَسٍنمَ،</para>
  <para style="q" vid="PSA 37:30">سّرِيّ نَن مِنِمَ عَ دّ كُي.<verse eid="PSA 37:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 37:31"/>عَ مَرِفِ عَلَ شَ سّرِيّ نَ عَ بْحّ كُي،</para>
  <para style="q" vid="PSA 37:31">عَ مُ بِرَ مَ كِرَ شْن.<verse eid="PSA 37:31"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="32" style="v" sid="PSA 37:32"/>مِشِ حَاشِ تِنشِنتْي يَنقَمَ، عَ شَ عَ قَشَ.<verse eid="PSA 37:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 37:33"/>كْنْ عَلَتَلَ مُ تِنشِنتْي لُمَ عَ يَشُييٍ سَفٌي.</para>
  <para style="q" vid="PSA 37:33">عَ مُ تِنمَ عٍ شَ عَ تْوحّفّ كِيتِ تّمُي.<verse eid="PSA 37:33"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="34" style="v" sid="PSA 37:34"/>عِ شَشِلِ تِ عَلَتَلَ رَ، عَ شَ كِرَ سُشُ،</para>
  <para style="q" vid="PSA 37:34">عَلَكٌ عَ شَ عِ رَكٍلِ، عِ شَ يِ بْشِ سْتْ كّ رَ.</para>
  <para style="q" vid="PSA 37:34">نَ تّمُي عِ مِشِ حَاشِيٍ تٌمَ نّ عٍ هَلَكِشِ.<verse eid="PSA 37:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 37:35"/>تّمُي دَنفِشِ ﭑ بَرَ سّنبّمَ حَاشِ ندٍ تٌ.</para>
  <para style="q" vid="PSA 37:35">عَ شُنفبٌ عَلْ وُرِ تٌقَنيِ.<verse eid="PSA 37:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 37:36"/>كْنْ ﭑ تٌ دَنفِ عَ يِرٍ عَ قِرِن ندٍ،</para>
  <para style="q" vid="PSA 37:36">ﭑ نَشَ عَ لِ عَ شَ قٍ شُبٍن.</para>
  <para style="q" vid="PSA 37:36">ﭑ نَشَ عَ قٍن، كْنْ ﭑ مُ عَ تٌ.<verse eid="PSA 37:36"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="37" style="v" sid="PSA 37:37"/>عِ شَ مِشِ قَنيِ نَن مَتٌ، تِنشِنتْي نَن عِفبّ.</para>
  <para style="q" vid="PSA 37:37">نَ مِشِ مْولِ قِندِ مَ بَرَكَتْي نَن نَ.<verse eid="PSA 37:37"/></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 37:38"/>كْنْ يُنُبِتْييٍ تَن قَمَ نّ سْنتْدٍ،</para>
  <para style="q" vid="PSA 37:38">عٍ بْنسْي بِرِن قَ هَلَكِ.<verse eid="PSA 37:38"/></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 37:39"/>عَلَتَلَ تِنشِنتْييٍ رَكِسِمَ نّ،</para>
  <para style="q" vid="PSA 37:39">عَ قِندِ عٍ شَ مَكَنتَمَ رَ عٍ شَ تْورّ كُي.<verse eid="PSA 37:39"/></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 37:40"/>عَ عٍ مَلِمَ نّ، عَ عٍ رَتَنفَ.</para>
  <para style="q" vid="PSA 37:40">عَ عٍ رَتَنفَ مِشِ حَاشِيٍ مَ، عَ عٍ رَكِسِ،</para>
  <para style="q" vid="PSA 37:40">بَرِ مَ عٍ يِفِيَشِ عَ تَن نَن مَ.<verse eid="PSA 37:40"/></para>
  <chapter eid="PSA 37"/>
  <chapter number="38" style="c" sid="PSA 38"/>
  <para style="s1">ﭑ سّنبّ بَرَ كَنَ</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 38:1"/>دَوُدَ شَ مَشَندِ بّيتِ<verse eid="PSA 38:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 38:2"/>عَلَتَلَ، عِ نَشَ ﭑ حَشَنكَتَ عِ شَ شْنّ كُي،</para>
  <para style="q" vid="PSA 38:2">عِ نَشَ ﭑ هَلَكِ عِ شَ بْحّتٍ كُي.<verse eid="PSA 38:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 38:3"/>عِ بَرَ ﭑ مَشْنْ عِ شَ تَنبّ رَ، عِ بَرَ ﭑ نَبِرَ.<verse eid="PSA 38:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 38:4"/>يَلَنيِ يٌ مُ نَ ﭑ بّ عِ شَ شْنّ كُي.</para>
  <para style="q" vid="PSA 38:4">ﭑ مَ يُنُبِ بَرَ عَ نِيَ ﭑ قَتٍ بِرِن شَ تْورْ.<verse eid="PSA 38:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 38:5"/>ﭑ مَ يُنُبِيٍ بَرَ فبٌ ﭑ شُن مَ.</para>
  <para style="q" vid="PSA 38:5">نَ كٌتٍ بَرَ بِنيَ، ﭑ مُ عَ نْمَ سْنْن.<verse eid="PSA 38:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 38:6"/>ﭑ مَ قِيٍ بَرَ فبٌ، عٍ شِرِ بَرَ حَاشُ.</para>
  <para style="q" vid="PSA 38:6">نَ بِرِن قَتَنشِ ﭑ مَ شَشِلِتَرٍحَ نَن نَ.<verse eid="PSA 38:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 38:7"/>ﭑ بْحّ بَرَ كَنَ، شُننَكٍلِ مُ نَ ﭑ بّ.</para>
  <para style="q" vid="PSA 38:7">ﭑ لُمَ قّيحّن نَ سُننُنيِ نَن كُي.<verse eid="PSA 38:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 38:8"/>ﭑ قَتٍ بِرِن وٌلٍنشِ، يَلَنيِ يٌ مُ نَ سْنْن.<verse eid="PSA 38:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 38:9"/>ﭑ سّنبّ بَرَ كَنَ، ﭑ قَتٍ بِرِن بَرَ بَ ﭑ مَ.</para>
  <para style="q" vid="PSA 38:9">ﭑ بْحّ تْورْشِ تُن.<verse eid="PSA 38:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 38:10"/>ﭑ مَرِفِ، عِ ﭑ وَشْنقٍ كٌلٌن،</para>
  <para style="q" vid="PSA 38:10">ﭑ مَ تْورّ مُ نْشُنشِ عِ مَ.<verse eid="PSA 38:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 38:11"/>ﭑ بْحّ مُ سَشِ، ﭑ سّنبّ بَرَ حْن.</para>
  <para style="q" vid="PSA 38:11">ﭑ يَ مُ نَءِيَلَنيِ تٌمَ سْنْن.<verse eid="PSA 38:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 38:12"/>ﭑ شَنُنتٍنيِيٍ نُن ﭑ بٌورٍيٍ بَرَ كٍلِ ﭑ شُن مَ</para>
  <para style="q" vid="PSA 38:12">ﭑ مَ قُرٍ شَ قٍ رَ، ﭑ نفَشَكٍرٍنيِيٍ بَرَ عٍ مَكُيَ ﭑ نَ.<verse eid="PSA 38:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 38:13"/>نَشٍيٍ وَ مَ ﭑ قَشَقٍ، عٍ بَرَ يّلّ عِتَلَ ﭑ يَ رَ.</para>
  <para style="q" vid="PSA 38:13">نَشٍيٍ وَ مَ ﭑ تْورْقٍ، عٍ بَرَ ﭑ كٌنبِ،</para>
  <para style="q" vid="PSA 38:13">عٍ ﭑ تْوحّفّمَ تّمُي بِرِن.<verse eid="PSA 38:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 38:14"/>كْنْ ﭑ مُ ﭑ تُلِ مَتِ نَ وْيّنيِيٍ رَ،</para>
  <para style="q" vid="PSA 38:14">ﭑ مُ ﭑ دّ رَبِ ﭑ شَ عٍ يَابِ.<verse eid="PSA 38:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 38:15"/>ﭑ لُمَ عَلْ تُلِ شْرِ، ﭑ لُمَ عَلْ بٌبٌي.<verse eid="PSA 38:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 38:16"/>عَلَتَلَ، ﭑ شَشِلِ تِشِ عِ تَن نَن نَ.</para>
  <para style="q" vid="PSA 38:16">ﭑ مَرِفِ عَلَ، عِ تَن نَن فبَنسَن نْمَ ﭑ يَابِدٍ.<verse eid="PSA 38:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 38:17"/>ﭑ نَشّ، «عِ نَشَ تِن ﭑ يَشُييٍ شَ يٌ ﭑ مَ،</para>
  <para style="q" vid="PSA 38:17">عٍ شَ حّلّشِن ﭑ مَ تْورّ شَ قٍ رَ.»<verse eid="PSA 38:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 38:18"/>عَ فبٍ مُ لُشِ ﭑ شَ بِرَ،</para>
  <para style="q" vid="PSA 38:18">ﭑ نَ تْورْقٍ تّمُي بِرِن.<verse eid="PSA 38:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 38:19"/>ﭑ بَرَ ﭑ تِ ﭑ مَ يُنُبِ رَبَشِيٍ رَ،</para>
  <para style="q" vid="PSA 38:19">ﭑ يَنفٌي نَشٍيٍ رَبَشِ، نَ قٍ بَرَ ﭑ كْنتْقِلِ.<verse eid="PSA 38:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 38:20"/>ﭑ يَشُييٍ تَن كّندّ، عٍ سّنبّ فبٌ.</para>
  <para style="q" vid="PSA 38:20">ﭑ شْنمِشِيٍ بَرَ وُيَ، هَلِ نْندِ مُ نَ عٍ بّ.<verse eid="PSA 38:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 38:21"/>نَشٍيٍ قٍ قَنيِ مَسَرَ مَ قٍ حَاشِ رَ، عٍ ﭑ تْورْ مَ،</para>
  <para style="q" vid="PSA 38:21">بَرِ مَ ﭑ تَن بِرَ مَ قٍ قَنيِ نَن قْشْ رَ.<verse eid="PSA 38:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 38:22"/>عَلَتَلَ، عِ نَشَ ﭑ نَبّحِن.</para>
  <para style="q" vid="PSA 38:22">ﭑ مَرِفِ عَلَ، عِ نَشَ عِ مَكُيَ ﭑ نَ.<verse eid="PSA 38:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 38:23"/>ﭑ مَرِفِ، عِ شَ قَ مَقُرٍن ﭑ مَلِدٍ.</para>
  <para style="q" vid="PSA 38:23">ﭑ مَرِفِ، ﭑ مَ مَرَكِسِمَ نَن عِ رَ.<verse eid="PSA 38:23"/></para>
  <chapter eid="PSA 38"/>
  <chapter number="39" style="c" sid="PSA 39"/>
  <para style="s1">عَدَ مَ لُمَ عَلْ قٌيٍ</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 39:1"/>دَوُدَ شَ بّيتِ بّيتِبَيٍ شَ مَنفّ يٍدُتُن بّ<verse eid="PSA 39:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 39:2"/>ﭑ بَرَ عَ قَلَ، «ﭑ قٍ بِرِن نَبَمَ،</para>
  <para style="q" vid="PSA 39:2">عَلَكٌ ﭑ نَشَ يُنُبِ رَبَ ﭑ دّ رَ.</para>
  <para style="q" vid="PSA 39:2">ﭑ قٍ بِرِن نَبَمَ،</para>
  <para style="q" vid="PSA 39:2">عَلَكٌ ﭑ نَشَ نَ وْيّنيِ مْولِ قَلَ مِشِ حَاشِيٍ يَ شْرِ.»<verse eid="PSA 39:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 39:3"/>ﭑ مَ تْورّ شُنفبٍ كُي،</para>
  <para style="q" vid="PSA 39:3">ﭑ نَشَ دُندُ، ﭑ مُ سٍسٍ قَلَ، ﭑ نَشَ ﭑ سَبَرِ تُن.<verse eid="PSA 39:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 39:4"/>ﭑ بْحّ نُ سَتُنمَ، ﭑ مَ تْورّ نَشَ لُ عَلْ تّ دّشّشِ.</para>
  <para style="q" vid="PSA 39:4">نَ بَرَ عَ نِيَ ﭑ شَ يِ وْيّنيِ قَلَ،<verse eid="PSA 39:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 39:5"/>«عَلَتَلَ، عَ مَسٍن ﭑ بّ ﭑ قَشَمَ تّمُي مُندُن،</para>
  <para style="q" vid="PSA 39:5">ﭑ مَ سِمَيَ سِفَمَ هَن مِندٍن،</para>
  <para style="q" vid="PSA 39:5">عَلَكٌ ﭑ شَ ﭑ سّنبّ شَ شُرُنيِ كٌلٌن.<verse eid="PSA 39:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 39:6"/>عِ بَرَ ﭑ مَ سِمَيَ رَدُنكٍ، عَ شْن مُ كُيَ سْنْن.</para>
  <para style="q" vid="PSA 39:6">عَدَ مَ لُمَ عَلْ قٌيٍ نَشَن دَنفِمَ.» <char style="qs">حّنفِ رَتٍ.</char><verse eid="PSA 39:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 39:7"/>عَدَ مَ لُشِ نّ عَلْ نِينِ، نَشَن مِنِمَ، عَ قَ دَنفِ.</para>
  <para style="q" vid="PSA 39:7">عَ نَاقُلِ مَلَنمَ، كْنْ نَشَن قَمَ عَ سْتْدٍ،</para>
  <para style="q" vid="PSA 39:7">عَ مُ نَ كٌلٌن.<verse eid="PSA 39:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 39:8"/>ﭑ مَرِفِ، ﭑ قَ ﭑ شَشِلِ تِمَ ندٍ رَ؟</para>
  <para style="q" vid="PSA 39:8">عِ تَن نَن فبَنسَن نْمَ ﭑ مَلِدٍ.<verse eid="PSA 39:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 39:9"/>ﭑ نَكِسِ ﭑ مَ يُنُبِيٍ بِرِن مَ.</para>
  <para style="q" vid="PSA 39:9">عِ نَشَ ﭑ نَيَافِ دَشُييٍ يَ شْرِ.<verse eid="PSA 39:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 39:10"/>ﭑ بَرَ دُندُ، ﭑ مُ سٍسٍ قَلَمَ،</para>
  <para style="q" vid="PSA 39:10">بَرِ مَ عِ تَن نَن نَ وَلِقٍ.<verse eid="PSA 39:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 39:11"/>عِ شَ قُرٍ بَ ﭑ مَ، بٍينُ عِ شَ ﭑ نَحْن تْورّ كُي.<verse eid="PSA 39:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 39:12"/>عِ مِشِ حَشَنكَتَمَ عَ شَ يُنُبِ شَ قٍ رَ.</para>
  <para style="q" vid="PSA 39:12">نَشَن نَقَن عَدَ مَ مَ، عِ نَ بَمَ عَ يِ.</para>
  <para style="q" vid="PSA 39:12">نَ قٍ لُمَ نّ عَلْ كُلِ نَشَن بٌفِسٍ قَنيِ شُن نَكَنَمَ</para>
  <para style="q" vid="PSA 39:12">بٍينُ مِشِ شَ عَ مَتٌنفٌ.</para>
  <para style="q" vid="PSA 39:12">عَدَ مَدِ مِسَالِشِ قٌيٍ نَن نَ نَشَن دَنفِمَ. <char style="qs">حّنفِ رَتٍ.</char><verse eid="PSA 39:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 39:13"/>عَلَتَلَ، ﭑ مَ دُبّ سُشُ،</para>
  <para style="q" vid="PSA 39:13">عِ شَ عِ تُلِ مَتِ ﭑ مَ مَشَندِ رَ.</para>
  <para style="q" vid="PSA 39:13">عِ شَ ﭑ وَ شُي مّ، بَرِ مَ عِ شَ شْحّ نَن ﭑ نَ.</para>
  <para style="q" vid="PSA 39:13">ﭑ لُمَ عَلْ ﭑ بٍنبَيٍ،</para>
  <para style="q" vid="PSA 39:13">ﭑ مُ بُمَ يِ دُنِحَ بّندّ قُحِ قَرِ.<verse eid="PSA 39:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 39:14"/>عِ شَ عِ شَ حَشَنكَتّ رَفبِلٍن ﭑ قْشْ رَ سِندٍن،</para>
  <para style="q" vid="PSA 39:14">شَ نَ مُ عَ رَ ﭑ قَشَمَ نّ.<verse eid="PSA 39:14"/></para>
  <chapter eid="PSA 39"/>
  <chapter number="40" style="c" sid="PSA 40"/>
  <para style="s1">ﭑ مُ نْمَ دُندُدٍ</para>
  <para style="s2">عَلَ مَشَندِ نُن عَلَ مَتْشْي</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 40:1"/>دَوُدَ شَ بّيتِ بّيتِبَيٍ شَ مَنفّ بّ<verse eid="PSA 40:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 40:2"/>ﭑ بَرَ ﭑ شَشِلِ تِ عَلَتَلَ رَ،</para>
  <para style="q" vid="PSA 40:2">عَ بَرَ عَ تُلِ مَتِ ﭑ نَ.<verse eid="PSA 40:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 40:3"/>عَ بَرَ ﭑ بَ بٌورَ شْورَ،</para>
  <para style="q" vid="PSA 40:3">عَ ﭑ سَنيِ رَدِكِ قَنيٍ رَ.<verse eid="PSA 40:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 40:4"/>عَ بَرَ بّيتِ نّينّ سَ ﭑ بْحّ مَ</para>
  <para style="q" vid="PSA 40:4">نَشَن قِندِشِ تَنتُي رَ عَلَ بّ.</para>
  <para style="q" vid="PSA 40:4">مِشِ فبٍفبٍ نَ نَ مّ، عٍ فَاشُمَ نّ عَلَ يَ رَ،</para>
  <para style="q" vid="PSA 40:4">عٍ عٍ يّتّ تَشُ عَلَتَلَ رَ.<verse eid="PSA 40:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 40:5"/>حّلّشِنيِ نَ عَدَ مَ نَن بّ</para>
  <para style="q" vid="PSA 40:5">نَشَن عَ شَشِلِ تِشِ عَلَتَلَ رَ،</para>
  <para style="q" vid="PSA 40:5">نَشَن مُ عَ كٌبٍ رَتٌشِ يّتّ عِفبٌي مَ،</para>
  <para style="q" vid="PSA 40:5">نَشَن مُ عَ كٌبٍ رَتٌشِ كُيٍ بَتُقٍ مَ.<verse eid="PSA 40:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 40:6"/>ﭑ مَرِفِ عَلَتَلَ،</para>
  <para style="q" vid="PSA 40:6">عِ بَرَ عِ شَ قٍ قَنيِ فبٍفبٍ مَسٍن مُشُ بّ.</para>
  <para style="q" vid="PSA 40:6">عِ مَنِيّ مُ نَ.</para>
  <para style="q" vid="PSA 40:6">ﭑ وَ مَ نَ بِرِن تَفِ رَبَقٍ مِشِيٍ بّ،</para>
  <para style="q" vid="PSA 40:6">كْنْ عِ شَ قٍ قَنيِ وُيَ هَن عَ بَرَ دَنفِ عَ عِ.<verse eid="PSA 40:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 40:7"/>عِ مُ وَ مَ سّرّشّ تُن شَ شْن مَ.</para>
  <para style="q" vid="PSA 40:7">عِ بَرَ ﭑ تُلِ رَبِ.</para>
  <para style="q" vid="PSA 40:7">عِ مُ وَ مَ سّرّشّ فَن دَاشِ شْن مَ،</para>
  <para style="q" vid="PSA 40:7">عِ مُ وَ مَ سّرّشّ يُنُبِ شَقَرِ دَاشِ قَن شْن مَ.<verse eid="PSA 40:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 40:8"/>ﭑ بَرَ قَ كِتَابُي مَكُنتَنشِ رَ نَشَن سّبّشِ ﭑ بّ.<verse eid="PSA 40:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 40:9"/>ﭑ مَرِفِ عَلَ، ﭑ بَرَ تِن عِ وَشْنقٍ مَ.</para>
  <para style="q" vid="PSA 40:9">عِ شَ سّرِيّ نَ ﭑ سٌندٌنيِ كُي.<verse eid="PSA 40:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 40:10"/>ﭑ تِنشِنيِ مَسٍنمَ حَمَ بّ.</para>
  <para style="q" vid="PSA 40:10">عِ شَ عَ كٌلٌن عَلَتَلَ، ﭑ مُ قَمَ دُندُدٍ عِ شَ قٍ مَ.<verse eid="PSA 40:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 40:11"/>ﭑ مُ نْمَ دُندُدٍ عِ شَ نْندِ مَ.</para>
  <para style="q" vid="PSA 40:11">ﭑ عِ شَ قٍ قَنيِ نُن عِ شَ مَرَكِسِ قٍ قَلَمَ نّ.</para>
  <para style="q" vid="PSA 40:11">ﭑ مُ عِ شَ قٌنِسِرٍيَ نُن عِ شَ نْندِ نْشُنمَ حَمَ مَ.<verse eid="PSA 40:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 40:12"/>عِ تَن عَلَتَلَ، عِ مُ قَمَ تٌندِدٍ ﭑ بّ عِ شَ مَرَقَنيِ مَ.</para>
  <para style="q" vid="PSA 40:12">عِ شَ قٌنِسِرٍيَ نُن عِ شَ نْندِ ﭑ كَنتَمَ نّ تّمُي بِرِن.<verse eid="PSA 40:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 40:13"/>تْورّ فبٍفبٍ بَرَ ﭑ نَبِلِن.</para>
  <para style="q" vid="PSA 40:13">ﭑ مَ يُنُبِ قَن بَرَ فبٌ هَن عَ بَرَ دَنفِ عَ عِ.</para>
  <para style="q" vid="PSA 40:13">عٍ بَرَ وُيَ دَنفِقٍ ﭑ شُنسّشّيٍ رَ.</para>
  <para style="q" vid="PSA 40:13">لِمَنِيَ بَرَ بَ ﭑ يِ رَ.<verse eid="PSA 40:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 40:14"/>عَلَتَلَ، يَندِ، ﭑ نَتَنفَ.</para>
  <para style="q" vid="PSA 40:14">عَلَتَلَ، يَندِ، ﭑ مَلِ.<verse eid="PSA 40:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 40:15"/>نَشٍيٍ وَ مَ ﭑ نِي بَقٍ،</para>
  <para style="q" vid="PSA 40:15">نَشٍيٍ وَ مَ ﭑ مَ قٍ حَاشِ شْن مَ،</para>
  <para style="q" vid="PSA 40:15">عٍ بِرِن شَ مَكُيَ ﭑ نَ يَافِ كُي.<verse eid="PSA 40:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 40:16"/>نَشٍيٍ ﭑ مَيٍلٍمَ، يَافِ شَ عٍ دّ عِشَرَ.<verse eid="PSA 40:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PSA 40:17"/>نَشٍيٍ بِرِن بِرَشِ عِ قْشْ رَ،</para>
  <para style="q" vid="PSA 40:17">عٍ شَ سّيوَ، عٍ شَ حّلّشِن عِ شَ قٍ رَ.</para>
  <para style="q" vid="PSA 40:17">نَشٍيٍ وَ مَ عِ شَ كِسِ شْن مَ،</para>
  <para style="q" vid="PSA 40:17">عٍ شَ عَ قَلَ تّمُي بِرِن، «تَنتُي نَ عَلَتَلَ بّ.»<verse eid="PSA 40:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 40:18"/>سٍتَرٍ نُن مِسِكِينّ نَن نَ ﭑ نَ،</para>
  <para style="q" vid="PSA 40:18">كْنْ مَرِفِ بَرَ رَتُ ﭑ مَ قٍ مَ.</para>
  <para style="q" vid="PSA 40:18">عِ تَن نَن نَ ﭑ مَ مَلِمَ رَ عَ نُن ﭑ نَكِسِمَ.</para>
  <para style="q" vid="PSA 40:18">ﭑ مَرِفِ عَلَتَلَ، عِ نَشَ دُفُندِ!<verse eid="PSA 40:18"/></para>
  <chapter eid="PSA 40"/>
  <chapter number="41" style="c" sid="PSA 41"/>
  <para style="s1">قُرٍ مَ عَلَ مَشَندِقٍ</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 41:1"/>دَوُدَ شَ بّيتِ بّيتِبَيٍ شَ مَنفّ بّ<verse eid="PSA 41:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 41:2"/>حّلّشِنيِ نَ مِشِ بّ نَشَن هِننّمَ تْورْ مِشِ رَ.</para>
  <para style="q" vid="PSA 41:2">عَلَتَلَ عَ رَتَنفَمَ نّ عَ شَ تْورّ مَ.<verse eid="PSA 41:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 41:3"/>عَلَتَلَ عَ رَتَنفَمَ نّ، عَ عَ رَبَلٌ.</para>
  <para style="q" vid="PSA 41:3">عَ حّلّشِنمَ نّ دُنِحَ.</para>
  <para style="q" vid="PSA 41:3">عِ مُ عَ لُمَ عَ يَشُييٍ سَفٌي.<verse eid="PSA 41:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 41:4"/>عَلَتَلَ عَ مَلِمَ نّ عَ قُرَ تّمُي، عَ عَ رَيَلَن.<verse eid="PSA 41:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 41:5"/>ﭑ عَ قَلَمَ عَ بّ،</para>
  <para style="q" vid="PSA 41:5">«عَلَتَلَ، هِننّ ﭑ نَ.</para>
  <para style="q" vid="PSA 41:5">ﭑ نَيَلَن بَرِ مَ ﭑ بَرَ يُنُبِ رَبَ عِ رَ.»<verse eid="PSA 41:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 41:6"/>ﭑ يَشُييٍ وْيّن حَاشِيٍ قَلَمَ، عٍ نَشّ،</para>
  <para style="q" vid="PSA 41:6">«عَ قَشَمَ مُن تّمُي؟</para>
  <para style="q" vid="PSA 41:6">عَ شِلِ لْيمَ مُن لْشْي؟»<verse eid="PSA 41:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 41:7"/>نَشَن قَمَ ﭑ شّيبُدٍ عَ قِلَنكَقُي وْيّنيِ قَلَمَ.</para>
  <para style="q" vid="PSA 41:7">قٍ حَاشِ فبٌ عَ بْحّ كُي.</para>
  <para style="q" vid="PSA 41:7">عَ نَ كٍلِ ﭑ شُن مَ، عَ نَ مْولِ قَلَمَ.<verse eid="PSA 41:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 41:8"/>ﭑ شْنمِشِيٍ ﭑ مَ قٍ مَكْلِكْلِمَ عٍ بٌورٍ بّ،</para>
  <para style="q" vid="PSA 41:8">عٍ شَ ﭑ تْورْ.<verse eid="PSA 41:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 41:9"/>عٍ نَشّ، «قُرٍ حَاشِ بَرَ عَ سُشُ،</para>
  <para style="q" vid="PSA 41:9">عَ بَرَ تَفَن، عَ مُ كٍلِمَ سْنْن.»<verse eid="PSA 41:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 41:10"/>هَلِ ﭑ دّقَنبٌورٍ، ﭑ نُ لَشِ نَشَن نَ،</para>
  <para style="q" vid="PSA 41:10">مُشُ نُن نَشَن نُ مُشُ دّفٍمَ يِرٍ كٍرٍن،</para>
  <para style="q" vid="PSA 41:10">نَ بَرَ عَ كٌبٍ تِ ﭑ نَ.<verse eid="PSA 41:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 41:11"/>عَلَتَلَ، هِننّ ﭑ نَ، عِ شَ ﭑ نَكٍلِ،</para>
  <para style="q" vid="PSA 41:11">عَلَكٌ ﭑ شَ ﭑ يَشُييٍ سَرٍ رَفبِلٍن عٍ مَ.<verse eid="PSA 41:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 41:12"/>ﭑ عَ كٌلٌن ﭑ نَقَن عِ مَ،</para>
  <para style="q" vid="PSA 41:12">بَرِ مَ عِ مُ ﭑ لُمَ ﭑ يَشُييٍ سَفٌي.<verse eid="PSA 41:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 41:13"/>عِ ﭑ مَلِمَ نّ بَرِ مَ ﭑ تِنشِن.</para>
  <para style="q" vid="PSA 41:13">عِ بَرَ تِن ﭑ شَ لُ عِ سّيتِ مَ عَبَدَن.<verse eid="PSA 41:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 41:14"/>تَنتُي نَ عِسِرَيِلَ مَرِفِ عَلَتَلَ بّ عَبَدَن.</para>
  <para style="q" vid="PSA 41:14">عَمِنَ. عَمِنَ.<verse eid="PSA 41:14"/></para>
  <chapter eid="PSA 41"/>
  <chapter number="42" style="c" sid="PSA 42"/>
  <para style="s1">ﭑ سٌندٌنيِ نِمِسَشِ مُنقٍ رَ؟</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 42:1"/>كٌرَ شَ دِيٍ شَ لْننِ بّيتِ بّيتِبَيٍ شَ مَنفّ بّ<verse eid="PSA 42:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 42:2"/>عَلَ، ﭑ وَ مَ لُقٍ عِ يِرٍ.</para>
  <para style="q" vid="PSA 42:2">ﭑ عِ قٍنمَ عَلْ شٍلِ يٍ قٍنمَ كِ نَشّ.<verse eid="PSA 42:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 42:3"/>ﭑ هَيِ نَ عَلَ حِحّ مَ.</para>
  <para style="q" vid="PSA 42:3">ﭑ عَ يِرٍ لِمَ مُن تّمُي؟<verse eid="PSA 42:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 42:4"/>يَكْسِ ﭑ وَ مَ كْي رَ،</para>
  <para style="q" vid="PSA 42:4">ﭑ وَ مَ يَنيِ رَ.</para>
  <para style="q" vid="PSA 42:4">مِشِ ﭑ مَشْرِنمَ،</para>
  <para style="q" vid="PSA 42:4">«عِ مَرِفِ عَلَ نَ مِندٍن؟»<verse eid="PSA 42:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 42:5"/>ﭑ نَ رَتُ يِ قٍ مَ، ﭑ بْحّ سّيوَ مَ نّ.</para>
  <para style="q" vid="PSA 42:5">سِنفٍ ﭑ نُ حَمَ رَحّرّ مَ عَلَ شَ هْرْ مْبَنشِ نَن كُي،</para>
  <para style="q" vid="PSA 42:5">عٍ نُ بّيتِ بَقٍ حّلّشِنيِ كُي،</para>
  <para style="q" vid="PSA 42:5">عٍ تَنتُي رَ سِفَ عَلَ مَ.<verse eid="PSA 42:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 42:6"/>مُنقٍ رَ ﭑ سٌندٌنيِ نِمِسَشِ؟</para>
  <para style="q" vid="PSA 42:6">مُنقٍ رَ ﭑ بْحّ سُننُنشِ؟</para>
  <para style="q" vid="PSA 42:6">ﭑ شَ ﭑ شَشِلِ تِ عَلَ رَ،</para>
  <para style="q" vid="PSA 42:6">ﭑ مَن شَ عَ تَنتُ عَ شَ كِسِ شَ قٍ رَ.<verse eid="PSA 42:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 42:7"/>ﭑ مَرِفِ عَلَ، ﭑ بْحّ نِمِسَشِ ﭑ يّتّ كَن مَ قٍ رَ.</para>
  <para style="q" vid="PSA 42:7">نَ نَ عَ رَ ﭑ نَن ﭑ نَتُمَ عِ مَ يُرُدّن،</para>
  <para style="q" vid="PSA 42:7">ﭑ نَ دّننَشّ يِ تّمُي،</para>
  <para style="q" vid="PSA 42:7">شٍرِ مٌن نُن مِسَرِ فٍيَيٍ نَ دّننَشّ.<verse eid="PSA 42:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 42:8"/>ﭑ مَ تْورّ شُن نَن تُن مَسَقٍ.</para>
  <para style="q" vid="PSA 42:8">عَ لُمَ عَلْ سُسُي يٍ نَشَن سِنمَ شُرٍ يٍ شُن.<verse eid="PSA 42:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 42:9"/>عَلَتَلَ هِننّمَ ﭑ نَ يَنيِ رَ،</para>
  <para style="q" vid="PSA 42:9">ﭑ قَن بّيتِ بَمَ عَ بّ كْي رَ.</para>
  <para style="q" vid="PSA 42:9">ﭑ عَلَ مَشَندِ مَ نَشَن ﭑ نَبَلٌمَ.<verse eid="PSA 42:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 42:10"/>ﭑ بَرَ عَ قَلَ عَلَ بّ،</para>
  <para style="q" vid="PSA 42:10">نَشَن سّنبّ فبٌ عَلْ قَنيٍ،</para>
  <para style="q" vid="PSA 42:10">«عِ نّيمُشِ ﭑ مَ مُنقٍ رَ؟</para>
  <para style="q" vid="PSA 42:10">عِ ﭑ لُشِ تْورّ كُي</para>
  <para style="q" vid="PSA 42:10">ﭑ يَشُييٍ شَ نْي بُن مَ مُنقٍ رَ؟»<verse eid="PSA 42:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 42:11"/>ﭑ يَشُييٍ ﭑ تْورْ مَ كٌنبِ رَ لْشْ يٌ لْشْ.</para>
  <para style="q" vid="PSA 42:11">عٍ ﭑ مَشْرِنمَ، «عِ مَرِفِ عَلَ نَ مِندٍن؟»<verse eid="PSA 42:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 42:12"/>ﭑ سٌندٌنيِ نِمِسَشِ مُنقٍ رَ؟</para>
  <para style="q" vid="PSA 42:12">ﭑ بْحّ سُننُنشِ مُنقٍ رَ؟</para>
  <para style="q" vid="PSA 42:12">ﭑ شَ ﭑ شَشِلِ تِ عَلَ رَ،</para>
  <para style="q" vid="PSA 42:12">ﭑ مَن شَ عَ تَنتُ عَ شَ كِسِ شَ قٍ رَ.</para>
  <para style="q" vid="PSA 42:12">ﭑ مَرِفِ نَن نَ ﭑ مَ مَرَكِسِمَ رَ.<verse eid="PSA 42:12"/></para>
  <chapter eid="PSA 42"/>
  <chapter number="43" style="c" sid="PSA 43"/>
  <para style="s1">ﭑ بْحّ سُننُنشِ مُنقٍ رَ؟</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 43:1"/>عَلَ، عِ شَ ﭑ مَ كِيتِ سَ.</para>
  <para style="q" vid="PSA 43:1">عِ شَ ﭑ شُن مَقَلَ حَمَ دَنشَنِيَتَرٍ شْن مَ.</para>
  <para style="q" vid="PSA 43:1">عِ شَ ﭑ نَتَنفَ يَنقَنتٍيٍ نُن وُلٍ قَلّيٍ مَ.<verse eid="PSA 43:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 43:2"/>عَلَ ﭑ مَ كَنتَمَ نَ عِ تَن نَن نَ،</para>
  <para style="q" vid="PSA 43:2">عِ ﭑ نَبّحِنشِ مُنقٍ رَ؟</para>
  <para style="q" vid="PSA 43:2">عِ ﭑ لُشِ تْورّ كُي ﭑ يَشُييٍ شَ نْي بُن مَ مُنقٍ رَ؟<verse eid="PSA 43:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 43:3"/>عِ شَ ﭑ مَ كِرَ عِيَلَن عِ شَ نْندِ رَ،</para>
  <para style="q" vid="PSA 43:3">عِ شَ ﭑ شُن تِ سِفَقٍ رَ عِ يِرٍ عِ شَ فٍيَ سّنِيّنشِ قَرِ.<verse eid="PSA 43:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 43:4"/>ﭑ نَن ﭑ مَكْرّ مَ نّ عَلَ شَ سّرّشّبَدٍ رَ،</para>
  <para style="q" vid="PSA 43:4">عَلَ نَشَن قِندِشِ ﭑ مَ سّيوّ نُن ﭑ مَ حّلّشِنيِ رَ.</para>
  <para style="q" vid="PSA 43:4">ﭑ بّيتِ بَمَ ﭑ مَرِفِ عَلَ بّ كْرَ رَ.<verse eid="PSA 43:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 43:5"/>ﭑ سٌندٌنيِ نِمِسَشِ مُنقٍ رَ؟</para>
  <para style="q" vid="PSA 43:5">ﭑ بْحّ سُننُنشِ مُنقٍ رَ؟</para>
  <para style="q" vid="PSA 43:5">ﭑ شَ ﭑ شَشِلِ تِ عَلَ رَ،</para>
  <para style="q" vid="PSA 43:5">ﭑ مَن شَ عَ تَنتُ عَ شَ كِسِ شَ قٍ رَ.<verse eid="PSA 43:5"/></para>
  <chapter eid="PSA 43"/>
  <chapter number="44" style="c" sid="PSA 44"/>
  <para style="s1">مُشُ مُ عِ شَ سَاتّ كَنَمَ</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 44:1"/>كٌرَ شَ دِيٍ شَ لْننِ بّيتِ بّيتِبَيٍ شَ مَنفّ بّ<verse eid="PSA 44:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 44:2"/>عَلَ، مُشُ بَرَ عَ مّ مُشُ بٍنبَيٍ سَابُي رَ،</para>
  <para style="q" vid="PSA 44:2">عِ وَلِ نَشَن نَبَشِ تّمُي دَنفِشِ.<verse eid="PSA 44:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 44:3"/>عِ بَرَ سِيٍ كٍرِ بٍ</para>
  <para style="q" vid="PSA 44:3">عَلَكٌ مُشُ بٍنبَيٍ شَ سَبَتِ يِ بْشِ مَ.<verse eid="PSA 44:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 44:4"/>عٍ مُ بٍ سْتْ عٍ شَ سَنتِدّفّمَ شَ رَ،</para>
  <para style="q" vid="PSA 44:4">عٍ مُ كِسِ سْتْ عٍ يّتّ سّنبّ شَ رَ.</para>
  <para style="q" vid="PSA 44:4">عِ تَن نَن سّنبّ بَرَ عٍ رَكِسِ،</para>
  <para style="q" vid="PSA 44:4">عِ تَن نَن شَ هِننّ بَرَ قِندِ نَ سَابُي رَ.<verse eid="PSA 44:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 44:5"/>عَلَ، عِ تَن نَن قِندِ ﭑ مَ مَنفّ رَ.</para>
  <para style="q" vid="PSA 44:5">يَندِ، عِ شَ يَشُبَ بْنسْي رَكِسِ.<verse eid="PSA 44:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 44:6"/>مُشُ قَمَ مُشُ يَشُييٍ رَفبِلٍندٍ عِ تَن نَن سَابُي رَ،</para>
  <para style="q" vid="PSA 44:6">مُشُ قَمَ عٍ رَفٌرٌدٍ عِ شِلِ رَ.<verse eid="PSA 44:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 44:7"/>ﭑ مُ ﭑ شَشِلِ تِشِ ﭑ مَ شَلِ شَ رَ،</para>
  <para style="q" vid="PSA 44:7">ﭑ مَ سَنتِدّفّمَ مُ نْمَ ﭑ نَكِسِدٍ.<verse eid="PSA 44:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 44:8"/>كْنْ عِ تَن نَن مُشُ رَتَنفَمَ مُشُ يَشُييٍ مَ،</para>
  <para style="q" vid="PSA 44:8">عِ تَن نَن مُشُ شْنمِشِيٍ رَيَافِمَ.<verse eid="PSA 44:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 44:9"/>مُشُ عَلَ نَن مَتْشْمَ تّمُي بِرِن،</para>
  <para style="q" vid="PSA 44:9">مُشُ عِ تَن نَن شِلِ تَنتُمَ عَبَدَن. <char style="qs">حّنفِ رَتٍ.</char><verse eid="PSA 44:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 44:10"/>كْنْ يَكْسِ عِ بَرَ مُشُ رَبّحِن،</para>
  <para style="q" vid="PSA 44:10">عِ بَرَ مُشُ رَيَافِ.</para>
  <para style="q" vid="PSA 44:10">عِ مُ مُشُ شَ سْورِيٍ مَلِمَ سْنْن.<verse eid="PSA 44:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 44:11"/>عِ بَرَ مُشُ رَفِ مُشُ يَشُييٍ يَ رَ، نَشٍيٍ مُشُ شْنشِ،</para>
  <para style="q" vid="PSA 44:11">نٍيٍ بَرَ مُشُ هَرِفٍ بِرِن بَ مُشُ يِ رَ.<verse eid="PSA 44:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 44:12"/>عِ بَرَ مُشُ رَبّحِن عَلَكٌ عٍ شَ مُشُ قَشَ عَلْ شُرُ سٍيٍ،</para>
  <para style="q" vid="PSA 44:12">عِ بَرَ مُشُ رَيٍنسٍن حَمَنّ فبّتّيٍ مَ.<verse eid="PSA 44:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 44:13"/>عِ بَرَ عِ شَ حَمَ مَتِ سَرٍ شُرِ رَ،</para>
  <para style="q" vid="PSA 44:13">نَشَن مُ قِندِ مَ فٍينِ رَ عِ بّ.<verse eid="PSA 44:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 44:14"/>عِ بَرَ مُشُ رَيَافِ مُشُ دْشْبٌورٍيٍ شْن مَ.</para>
  <para style="q" vid="PSA 44:14">مُشُ رَبِلِنيِيٍ يٌمَ مُشُ مَ.<verse eid="PSA 44:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 44:15"/>عِ بَرَ عَ نِيَ سِ فبّتّيٍ شَ مُشُ مَيٍلٍ،</para>
  <para style="q" vid="PSA 44:15">عٍ نُ عٍ شُنيِيٍ لِنتَن مُشُ مَ.<verse eid="PSA 44:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 44:16"/>ﭑ شَشِلِ عِقُشِ تّمُي بِرِن، ﭑ بَرَ يَافِ.<verse eid="PSA 44:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 44:17"/>نَشٍيٍ ﭑ شْنشِ، نٍيٍ ﭑ مَيٍلٍمَ، عٍ ﭑ كٌنبِمَ.</para>
  <para style="q" vid="PSA 44:17">عٍ وَ مَ عٍ فبٍحْشْقٍ.<verse eid="PSA 44:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="PSA 44:18"/>هَلِ يِ بِرِن تٌ رَبَشِ مُشُ رَ،</para>
  <para style="q" vid="PSA 44:18">مُشُ مُ نّيمُشِ عِ مَ،</para>
  <para style="q" vid="PSA 44:18">مُشُ مُ عِ شَ سَاتّ كَنَشِ.<verse eid="PSA 44:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 44:19"/>مُشُ بْحّ مُ فبِلٍنشِ عِ قْشْ رَ،</para>
  <para style="q" vid="PSA 44:19">مُشُ مُ مُشُ مَكُيَشِ عِ شَ كِرَ رَ،<verse eid="PSA 44:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 44:20"/>نَشَن عَ نِيَمَ عِ شَ مُشُ لُ وُلَبَرٍيٍ تَفِ،</para>
  <para style="q" vid="PSA 44:20">مُشُ شَ قَشَ.<verse eid="PSA 44:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 44:21"/>شَ مُشُ سَ نّيمُ مُشُ مَرِفِ عَلَ شِلِ مَ،</para>
  <para style="q" vid="PSA 44:21">شَ نَ مُ عَ رَ مُشُ نَشَ عَلَ فبّتّيٍ بَتُ،<verse eid="PSA 44:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 44:22"/>عَلَ مُ عَ كٌلٌنمَ شّ؟</para>
  <para style="q" vid="PSA 44:22">عَ مُ مِشِ فُندٌ بِرِن كٌلٌن؟<verse eid="PSA 44:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 44:23"/>كْنْ مِشِيٍ نَ مُشُ قَشَقٍ عَلْ شُرُ سٍيٍ.</para>
  <para style="q" vid="PSA 44:23">عٍ نَ رَبَمَ تّمُي بِرِن عِ تَن نَن مَ قٍ رَ.<verse eid="PSA 44:23"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="24" style="v" sid="PSA 44:24"/>ﭑ مَرِفِ، شُنُ. عِ شِقٍ مُنقٍ رَ؟</para>
  <para style="q" vid="PSA 44:24">كٍلِ، عِ نَشَ مّي مُشُ رَ تّمُي بِرِن.<verse eid="PSA 44:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 44:25"/>عِ يَتَفِ نْشُنمَ مُشُ مَ مُنقٍ رَ؟</para>
  <para style="q" vid="PSA 44:25">عِ نّيمُشِ مُشُ شَ تْورّ نُن يَافِ مَ مُنقٍ رَ؟<verse eid="PSA 44:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 44:26"/>مُشُ بِرَ نّ بْشِ، مُشُ مُ نْمَ كٍلِدٍ سْنْن.<verse eid="PSA 44:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 44:27"/>يَندِ، كٍلِ، قَ مُشُ مَلِ.</para>
  <para style="q" vid="PSA 44:27">عِ شَ مُشُ شُن سَرَ عِ شَ هِننّ شَ قٍ رَ.<verse eid="PSA 44:27"/></para>
  <chapter eid="PSA 44"/>
  <chapter number="45" style="c" sid="PSA 45"/>
  <para style="s1">مَنفّ شَ قُتِ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 45:1"/>كٌرَ شَ دِيٍ شَ لْننِ بّيتِ بّيتِبَيٍ شَ مَنفّ بّ. عَ شَ بَ عَلْ بّيتِ نَشَن شِلِ «قُفٍ تٌقَنيِيٍ.» شَنُنتٍيَ سِفِ.<verse eid="PSA 45:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 45:2"/>وْيّن قَنيِيٍ بَرَ ﭑ بْحّ رَقٍ.</para>
  <para style="q" vid="PSA 45:2">ﭑ شَ يِ وَلِ رَبَ مَنفّ بّ.</para>
  <para style="q" vid="PSA 45:2">ﭑ نّنيِ لُمَ نّ عَلْ سّبّلِتِ قَنيِ شَ كَلٍ.<verse eid="PSA 45:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 45:3"/>عِ تٌقَن عَدَ مَدِ بِرِن بّ،</para>
  <para style="q" vid="PSA 45:3">عِ قَتَ وْيّن حْشُنمّ تِدٍ،</para>
  <para style="q" vid="PSA 45:3">بَرِ مَ عَلَ بَرَكّ سَمَ عِ شَ قٍ مَ تّمُي بِرِن.<verse eid="PSA 45:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 45:4"/>عِ شَ عِ شَ سَنتِدّفّمَ شِرِ عِ تَفِ،</para>
  <para style="q" vid="PSA 45:4">عَلَكٌ عِ شَ شُننَكٍلِ نُن عِ شَ بِنيّ شَ كٌلٌن.</para>
  <para style="q" vid="PSA 45:4">سْورِ سّنبّمَ نَن عِ رَ.<verse eid="PSA 45:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 45:5"/>عِ سّنبّ فبٌ.</para>
  <para style="q" vid="PSA 45:5">تٍ عِ شَ سْورِ رَفِسٍ قَرِ، نْندِ، مَفٌرٌي، نُن تِنشِنيِ شَ قٍ رَ.</para>
  <para style="q" vid="PSA 45:5">عِ شَ قٍ شُنفبٍ رَبَ.<verse eid="PSA 45:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 45:6"/>عِ شَ تَنبّيٍ مَفَاشُ.</para>
  <para style="q" vid="PSA 45:6">عٍ قَمَ عِ يَشُييٍ سٌندٌنيِ سْشْدٍ،</para>
  <para style="q" vid="PSA 45:6">سِيٍ بِرَ مَ نّ عِ سَنيِيٍ بُن.<verse eid="PSA 45:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 45:7"/>«عَلَ، عِ شَ مَنفّ كِبَنيِ بُمَ نّ عَبَدَن.</para>
  <para style="q" vid="PSA 45:7">تِنشِنيِ نَن قِندِشِ عِ شَ مَنفّيَ تْنشُمَ رَ.»<verse eid="PSA 45:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 45:8"/>تِنشِنيِ نَن نَقَن عِ مَ.</para>
  <para style="q" vid="PSA 45:8">حَاشُيحَ مُ رَقَن عِ مَ قٍقٍ مَ.</para>
  <para style="q" vid="PSA 45:8">نَ نَن عَ تٌشِ عِ مَرِفِ عَلَ بَرَ عِ سُفَندِ سّيوّ كُي.</para>
  <para style="q" vid="PSA 45:8">قِسَمَنتٍ نَن عِ رَ دَنفِقٍ عِ بٌورٍيٍ رَ.<verse eid="PSA 45:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 45:9"/>لَبُندّ نُن سٍ شِرِ حْشُنمّ نَ عِ شَ دُفِ مَ.</para>
  <para style="q" vid="PSA 45:9">شُلُنيِ تِمَ عِ شَ مَنفّ بَنشِ تٌقَنيِ كُي.</para>
  <para style="q" vid="PSA 45:9">كْرَيٍ حّلّشِنيِ شُي رَ مِنِمَ عِ بّ.<verse eid="PSA 45:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 45:10"/>مَنفّيٍ شَ دِ فِنّيٍ لُمَ عِ سّيتِ مَ،</para>
  <para style="q" vid="PSA 45:10">عِ شَ فِنّ قَن نَ عِ قّ مَ، عَ مَشِرِشِ شّيمَ تٌقَنيِ رَ.<verse eid="PSA 45:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 45:11"/>ﭑ مَ دِ فِنّ، عِ تُلِ مَتِ ﭑ نَ.</para>
  <para style="q" vid="PSA 45:11">عِ نَشَ كَنكَن عِ بْنسْي مَ،</para>
  <para style="q" vid="PSA 45:11">شَ نَ مُ عَ رَ عِ شَ دٍنبَيَ نُن عِ بَبَ مَ.<verse eid="PSA 45:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 45:12"/>عِ شَ عِ عِفٌرٌ مَنفّ بّ</para>
  <para style="q" vid="PSA 45:12">نَشَن قِندِشِ عِ مَرِفِ رَ.</para>
  <para style="q" vid="PSA 45:12">عِ تٌقَن، عِ رَقَن عَ مَ كِ قَنيِ.<verse eid="PSA 45:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 45:13"/>تِرٍكَيٍ قَمَ بُنسٍيٍ رَ عِ بّ،</para>
  <para style="q" vid="PSA 45:13">نَاقُلِ كَنيِيٍ قَن قَنمَ عِ بِنيَدٍ.<verse eid="PSA 45:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PSA 45:14"/>مَنفّ شَ دِ فِنّ سٌمَ بَنشِ كُي،</para>
  <para style="q" vid="PSA 45:14">عَ مَشِرِشِ دُفِ تٌقَنيِ رَ، شّيمَ نَ عَ مَ.<verse eid="PSA 45:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 45:15"/>عَ شَ كٌنيِ فِنّيٍ عَ مَتِمَ مَنفّ شْن.</para>
  <para style="q" vid="PSA 45:15">مَنفّ قَن مَشِرِشِ دُفِ تٌقَنيِ رَ.<verse eid="PSA 45:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 45:16"/>فِنّ سٌ تّمُي، مِشِ بِرِن حّلّشِنشِ،</para>
  <para style="q" vid="PSA 45:16">عٍ شُلُنيِ تِمَ.<verse eid="PSA 45:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PSA 45:17"/>عِ شَ دِيٍ قَمَ لُدٍ عَلْ عِ بٍنبَيٍ،</para>
  <para style="q" vid="PSA 45:17">عٍ قِندِ مَنفّيٍ رَ بْشِ بِرِن شُن مَ.<verse eid="PSA 45:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 45:18"/>ﭑ عِ تَن قِندِ مَ شِلِ كَنيِ نَن نَ عَبَدَن.</para>
  <para style="q" vid="PSA 45:18">بْنسْي بِرِن عِ مَتْشْمَ نّ وَشَتِ يٌ وَشَتِ.<verse eid="PSA 45:18"/></para>
  <chapter eid="PSA 45"/>
  <chapter number="46" style="c" sid="PSA 46"/>
  <para style="s1">وٌن مُ فَاشُمَ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 46:1"/>كٌرَ شَ دِيٍ شَ بّيتِ بّيتِبَيٍ شَ مَنفّ بّ فِنّدِ مّدِ شُي دَاشِ<verse eid="PSA 46:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 46:2"/>عَلَ، وٌن كَنتَمَ نَن عَ رَ.</para>
  <para style="q" vid="PSA 46:2">وٌن مَ كَنتَرِ نَ عَ يِ رَ.</para>
  <para style="q" vid="PSA 46:2">عَ وٌن مَلِمَ وٌن مَ تْورّ بِرِن كُي.<verse eid="PSA 46:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 46:3"/>شَ بْشِ سَ سّرّن، وٌن مُ فَاشُمَ.</para>
  <para style="q" vid="PSA 46:3">شَ فٍيَ سَ بِرَ بَا مَ، وٌن مُ فَاشُمَ.<verse eid="PSA 46:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 46:4"/>شَ مْرْنيِيٍ سَ شَاحّ، وٌن مُ فَاشُمَ.</para>
  <para style="q" vid="PSA 46:4">شَ فٍيَ سَ عَ عِمَشَ، عَ سّرّن، وٌن مُ فَاشُمَ.<verse eid="PSA 46:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 46:5"/>شُرٍ نَن عَ رَ، نَشَن سَلٌنيِيٍ عَلَ شَ تَا رَ سّيوَ مَ.</para>
  <para style="q" vid="PSA 46:5">عَلَ شِلِ شُنفبٍ كَنيِ شَ هْرْ مْلِنفِرَ سّنِيّنشِ نَ مّننِ نّ.<verse eid="PSA 46:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 46:6"/>عَلَ نَ نَ تَا كُي، نَ تَا مُ عَ رَ مَشَمَ،</para>
  <para style="q" vid="PSA 46:6">عَ عَ مَلِمَ سُبَشّ نّقّ عَ لِ.<verse eid="PSA 46:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 46:7"/>سِيٍ سْنشْي رَتٍمَ،</para>
  <para style="q" vid="PSA 46:7">مَنفّيَيٍ بِرَ مَ نّ.</para>
  <para style="q" vid="PSA 46:7">عَلَ نّقّ عَ شُي رَ مِنِ،</para>
  <para style="q" vid="PSA 46:7">دُنِحَ بِرِن شُنُنمَ نّ.<verse eid="PSA 46:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 46:8"/>مَنفّ عَلَتَلَ نَ وٌن سّيتِ مَ.</para>
  <para style="q" vid="PSA 46:8">وٌن مَ كَنتَرِ نَ يَشُبَ مَرِفِ عَلَ يِ رَ.<verse eid="PSA 46:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 46:9"/>وٌ قَ عَلَتَلَ شَ وَلِ مَتٌ،</para>
  <para style="q" vid="PSA 46:9">عَ فبَلٌي نَشَن لُشِ بْشِ مَ.<verse eid="PSA 46:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 46:10"/>عَ تَن نَن فٍرٍ حْنمَ دُنِحَ بِرِن مَ.</para>
  <para style="q" vid="PSA 46:10">عَ شَلِ فِرَ مَ نّ.</para>
  <para style="q" vid="PSA 46:10">عَ تَنبّ كَنَمَ نّ،</para>
  <para style="q" vid="PSA 46:10">عَ مَكَنتَسٍ فَن.<verse eid="PSA 46:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 46:11"/>«وٌ وٌ رَشَرَ، وٌ شَ عَ كٌلٌن عَلَ نَ ﭑ تَن نَن نَ.</para>
  <para style="q" vid="PSA 46:11">ﭑ سِ بِرِن يَمَرِ مَ.</para>
  <para style="q" vid="PSA 46:11">ﭑ مَ يَامَرِ نَ دُنِحَ بِرِن مَ.»<verse eid="PSA 46:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 46:12"/>عَلَتَلَ نَ وٌن سّيتِ مَ،</para>
  <para style="q" vid="PSA 46:12">وٌن مَ كَنتَرِ نَ يَشُبَ مَرِفِ عَلَ يِ رَ.<verse eid="PSA 46:12"/></para>
  <chapter eid="PSA 46"/>
  <chapter number="47" style="c" sid="PSA 47"/>
  <para style="s1">عَلَ قِسَمَنتٍ مَنفّ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 47:1"/>كٌرَ شَ دِيٍ شَ بّيتِ بّيتِبَيٍ شَ مَنفّ بّ<verse eid="PSA 47:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 47:2"/>وٌ تَن سِيٍ بِرِن، وٌ وٌ بّلّشّ بْنبْ،</para>
  <para style="q" vid="PSA 47:2">وٌ سْنشْ، وٌ شُي عِتٍ حّلّشِنيِ كُي عَلَ بّ!<verse eid="PSA 47:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 47:3"/>عَلَتَلَ شِلِ شُنفبٍ كَنيِ مَفَاشُ.</para>
  <para style="q" vid="PSA 47:3">مَنفّ شُنفبٍ نَن عَ رَ دُنِحَ بِرِن شُن مَ.<verse eid="PSA 47:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 47:4"/>عَ بَرَ سِيٍ رَفٌرٌ وٌن بُن مَ،</para>
  <para style="q" vid="PSA 47:4">عٍ شَ لُ وٌن سَفٌي.<verse eid="PSA 47:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 47:5"/>عَ بَرَ بْشِ قِ وٌن مَ كّ رَ،</para>
  <para style="q" vid="PSA 47:5">نَشَن قِندِشِ يَشُبَ بْنسْي شَ شُننَكٍلِ رَ.</para>
  <para style="q" vid="PSA 47:5">عَ وٌن شَنُ. <char style="qs">حّنفِ رَتٍ.</char><verse eid="PSA 47:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 47:6"/>عَلَ تٍمَ حّلّشِن شُي نَن تَفِ،</para>
  <para style="q" vid="PSA 47:6">عَ قَمَ سَرَيٍ قٍ شُي مَ.<verse eid="PSA 47:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 47:7"/>وٌ بّيتِ بَ عَلَ بّ، وٌ بّيتِ بَ!</para>
  <para style="q" vid="PSA 47:7">وٌ بّيتِ بَ وٌن مَ مَنفّ بّ، وٌ بّيتِ بَ!<verse eid="PSA 47:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 47:8"/>عَلَ نَن مَنفّ رَ دُنِحَ بِرِن شُن مَ،</para>
  <para style="q" vid="PSA 47:8">وٌ شَ لْننِ بّيتِ بَ.<verse eid="PSA 47:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 47:9"/>عَلَ مَفٌرٌشِ مَنفّ كِبَنيِ سّنِيّنشِ كُي،</para>
  <para style="q" vid="PSA 47:9">سِ بِرِن مَنفّ نَن عَ رَ.<verse eid="PSA 47:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 47:10"/>سِيٍ شَ مَنفّيٍ كَقُمَ عِبُرَهِمَ مَرِفِ عَلَ شَ حَمَ مَ،</para>
  <para style="q" vid="PSA 47:10">بَرِ مَ عَلَ نَن عَ رَفِرِ مَنفّيٍ شَ دُنِحَ كَنتَ.</para>
  <para style="q" vid="PSA 47:10">عَلَ نَ سٍ بِرِن شُن.<verse eid="PSA 47:10"/></para>
  <chapter eid="PSA 47"/>
  <chapter number="48" style="c" sid="PSA 48"/>
  <para style="s1">عَلَ شَ تَا سِيٌن</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 48:1"/>كٌرَ شَ دِيٍ شَ بّيتِ. سِفِ سّنِيّنشِ.<verse eid="PSA 48:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 48:2"/>عَلَتَلَ فبٌ.</para>
  <para style="q" vid="PSA 48:2">عَ لَنمَ وٌن شَ عَ مَتْشْ</para>
  <para style="q" vid="PSA 48:2">عَ شَ تَا كُي عَ شَ فٍيَ سّنِيّنشِ قَرِ.<verse eid="PSA 48:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 48:3"/>عَلَ شَ فٍيَ سِيٌن تٌقَن،</para>
  <para style="q" vid="PSA 48:3">عَ رَقَن دُنِحَ بِرِن مَ.</para>
  <para style="q" vid="PSA 48:3">نَ قِندِ مَنفّ شُنفبٍ شَ تَا نَن نَ.<verse eid="PSA 48:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 48:4"/>عَلَ عَ حّنفِ سَمَ عَ شَ تَا مَكَنتَشِ شْن،</para>
  <para style="q" vid="PSA 48:4">عَ بَرَ عَ يّتّ قِندِ عَ كَنتَمَ رَ.<verse eid="PSA 48:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 48:5"/>مَنفّيٍ تٌ عٍ مَلَن سِيٌن فٍرٍ شِلِ مَ،<verse eid="PSA 48:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 48:6"/>عٍ نَشَ كَابَ نَ تٌقٍ رَ.</para>
  <para style="q" vid="PSA 48:6">عٍ نَشَ فَاشُ، عٍ قَ عٍ فِ.<verse eid="PSA 48:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 48:7"/>عٍ تٌ فَاشُ نَ يَ رَ،</para>
  <para style="q" vid="PSA 48:7">عٍ نَشَ سّرّن عَلْ فِنّ نَشَن نَ دِ بَرِقٍ،<verse eid="PSA 48:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 48:8"/>شَ نَ مَرَ عَلْ تَرَ سِسِ شَ كُنكُييٍ</para>
  <para style="q" vid="PSA 48:8">قٌيٍ شُنفبٍ نَشٍيٍ عِمَشَمَ.<verse eid="PSA 48:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 48:9"/>وٌن مَرِفِ عَلَ كَابَنَكٌ نَشَن نَبَشِ عَ شَ تَا كُي،</para>
  <para style="q" vid="PSA 48:9">وٌن بَرَ نَ مّ، وٌن بَرَ نَ تٌ.</para>
  <para style="q" vid="PSA 48:9">مَنفّ عَلَتَلَ نَ تَا رَكِسِمَ تّمُي بِرِن. <char style="qs">حّنفِ رَتٍ.</char><verse eid="PSA 48:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 48:10"/>عَلَ، مُشُ نَ سٌ عِ شَ هْرْ مْلِنفِرَ كُي،</para>
  <para style="q" vid="PSA 48:10">مُشُ رَتُمَ عِ شَ هِننّ نَن مَ.<verse eid="PSA 48:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 48:11"/>عَلَ شِلِ شُنفبٍ كَنيِ،</para>
  <para style="q" vid="PSA 48:11">عِ شِلِ تَنتُمَ نّ دُنِحَ يِرٍ بِرِن.</para>
  <para style="q" vid="PSA 48:11">عِ شَ مَنفّيَ تِنشِن.<verse eid="PSA 48:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 48:12"/>حَمَ حّلّشِنمَ نّ سِيٌن فٍيَ قَرِ،</para>
  <para style="q" vid="PSA 48:12">يُدَكَيٍ سّيوَ مَ نّ عِ شَ كِيتِ شَ قٍ رَ.<verse eid="PSA 48:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 48:13"/>وٌ شَ سِيٌن مَبِلِن،</para>
  <para style="q" vid="PSA 48:13">وٌ شَ عَ شَ سْورِ تِدٍيٍ كْنتِ.<verse eid="PSA 48:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 48:14"/>وٌ شَ عَ تّتّ نُن عَ يِرٍ مَكَنتَشِيٍ مَتٌ،</para>
  <para style="q" vid="PSA 48:14">عَلَكٌ وٌ شَ نَ قَلَ وٌ شَ دِيٍ بّ.<verse eid="PSA 48:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 48:15"/>عَلَ نَن نَ وٌن مَرِفِ عَلَ رَ عَبَدَن.</para>
  <para style="q" vid="PSA 48:15">عَ وٌن نَحّرّ مَ هَن عَلِفِيَمَ.<verse eid="PSA 48:15"/></para>
  <chapter eid="PSA 48"/>
  <chapter number="49" style="c" sid="PSA 49"/>
  <para style="s1">عَلِفِيَمَ سِفَقٍ مُ كَنَمَ</para>
  <para style="s2">عَلَ شَ سّرِيّ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 49:1"/>كٌرَ شَ دِيٍ شَ بّيتِ بّيتِبَيٍ شَ مَنفّ بّ<verse eid="PSA 49:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 49:2"/>وٌ وٌ تُلِ مَتِ يِ رَ، وٌ تَن حَمَ بِرِن.</para>
  <para style="q" vid="PSA 49:2">دُنِحَ حَمَ بِرِن، وٌ وٌ تُلِ مَتِ ﭑ نَ.<verse eid="PSA 49:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 49:3"/>تِدٍ شُرِ كَنيِ، تِدٍ شُنفبٍ كَنيِ،</para>
  <para style="q" vid="PSA 49:3">سٍتَرٍ عَ نُن سٍ كَنيِ،</para>
  <para style="q" vid="PSA 49:3">وٌ بِرِن شَ وٌ تُلِ مَتِ.<verse eid="PSA 49:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 49:4"/>ﭑ قَمَ وْيّنيِ هَفِفّ نَن قَلَدٍ وٌ بّ،</para>
  <para style="q" vid="PSA 49:4">ﭑ بْحّ شَشِلِ قَنيِ نَشَن مَحْشُنشِ.<verse eid="PSA 49:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 49:5"/>ﭑ نَن ﭑ تُلِ تِشِ تَالِ رَ،</para>
  <para style="q" vid="PSA 49:5">ﭑ قَمَ نَ تَفِ رَبَدٍ وٌ بّ كْرَ شُي رَ.<verse eid="PSA 49:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 49:6"/>مُنقٍرَ ﭑ قَ فَاشُمَ فبَلٌي لْشْي يَ رَ،</para>
  <para style="q" vid="PSA 49:6">ﭑ يَشُييٍ شَ قٍ كٌبِ ﭑ نَبِلِنمَ تّمُي نَشّ؟<verse eid="PSA 49:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 49:7"/>عٍ لَشِ عٍ شَ بَننَيَ نَن نَ،</para>
  <para style="q" vid="PSA 49:7">عٍ نُ قَ عٍ يّتّ مَتْشْ عٍ هَرِفٍ شَ فبٌي رَ.<verse eid="PSA 49:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 49:8"/>عٍ مُ نْمَ عٍ بٌرٍ شُنسَرَدٍ،</para>
  <para style="q" vid="PSA 49:8">عٍ مُ نْمَ عٍ شُنسَرٍ قِدٍ عَلَ مَ.<verse eid="PSA 49:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 49:9"/>عٍ نِي شُنسَرٍ شْرْشْ،</para>
  <para style="q" vid="PSA 49:9">عٍ مُ نْمَ عَ قِدٍ عَبَدَن.<verse eid="PSA 49:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 49:10"/>عٍ تَن مُ قَشَمَ؟</para>
  <para style="q" vid="PSA 49:10">عٍ مُ سِفَمَ عَلِفِيَمَ؟<verse eid="PSA 49:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 49:11"/>وٌن عَ تٌمَ، لْننِلَيٍ قَشَمَ،</para>
  <para style="q" vid="PSA 49:11">لْننِتَرٍيٍ قَن قَشَمَ نّ.</para>
  <para style="q" vid="PSA 49:11">عٍ قَ عٍ هَرِفٍ لُ مِشِ فبّتّيٍ يِ رَ.<verse eid="PSA 49:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 49:12"/>مِشِ نَشٍيٍ عٍ شِلِيٍ سَشِ بْشِيٍ شُن مَ،</para>
  <para style="q" vid="PSA 49:12">عٍ مَحْشُنشِ نّ عٍ شَ بَنشِيٍ لُمَ نّ نَا عَبَدَن،</para>
  <para style="q" vid="PSA 49:12">عٍ شْنيِ مُ كَنَمَ كٍلِ لَنقَنمَيٍ مَ،</para>
  <para style="q" vid="PSA 49:12">عَ سَ دْشْ لَنقَنمَ فبّتّيٍ رَ.<verse eid="PSA 49:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 49:13"/>هَلِ مِشِ شُنفبٍ، عَ مُ بُمَ.</para>
  <para style="q" vid="PSA 49:13">عَ قَشَمَ نّ عَلْ سُبٍيٍ.<verse eid="PSA 49:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 49:14"/>مِشِ نَشٍيٍ لَشِ عٍ يّتّ رَ، عٍ شَ كِرَ نَن يَ.</para>
  <para style="q" vid="PSA 49:14">عٍ شُي رَقَن نَشٍيٍ مَ، نٍيٍ بِرَ مَ نّ عٍ قْشْ رَ.<verse eid="PSA 49:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 49:15"/>عٍ عَلِفِيَمَ لِمَ نّ.</para>
  <para style="q" vid="PSA 49:15">قَشّ عٍ رَلْيمَ نّ.</para>
  <para style="q" vid="PSA 49:15">مِشِ تِنشِنشِيٍ عٍ مَبٌرٌنمَ نّ.</para>
  <para style="q" vid="PSA 49:15">عٍ شَ تٌقَنيِ كَنَمَ نّ.</para>
  <para style="q" vid="PSA 49:15">عَلِفِيَمَ قِندِ مَ نّ عٍ شْنيِ رَ.<verse eid="PSA 49:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 49:16"/>كْنْ عَلَ ﭑ نِي شُنسَرَ مَ نّ عَلِفِيَمَ،</para>
  <para style="q" vid="PSA 49:16">عَ ﭑ شَنِن. <char style="qs">حّنفِ رَتٍ.</char><verse eid="PSA 49:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PSA 49:17"/>مِشِ نَ قِندِ بَننَ رَ، عَ هَرِفٍ نَ فبٌ،</para>
  <para style="q" vid="PSA 49:17">عِ نَشَ فَاشُ،<verse eid="PSA 49:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 49:18"/>بَرِ مَ عَ مُ سٍسٍ شَنِنمَ عَلِفِيَمَ.</para>
  <para style="q" vid="PSA 49:18">عَ هَرِفٍ مُ بِرَ مَ عَ قْشْ رَ.<verse eid="PSA 49:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 49:19"/>عَ حّلّشِنمَ نّ عَ هَرِفٍ رَ عَ شَ دُنِحّءِفِرِ كُي،</para>
  <para style="q" vid="PSA 49:19">بَرِ مَ بِرِن عَ مَتْشْمَ نَ شَ قٍ رَ،<verse eid="PSA 49:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 49:20"/>كْنْ عَ قَ سِفَ عَلِفِيَمَ</para>
  <para style="q" vid="PSA 49:20">عَ عَ بٍنبَيٍ لِ نَ،</para>
  <para style="q" vid="PSA 49:20">نَشٍيٍ مُ دُنِحَ تٌمَ سْنْن.<verse eid="PSA 49:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 49:21"/>شَ بَننَ مِشِ شَشِلِ مُ نَ،</para>
  <para style="q" vid="PSA 49:21">عَ لُشِ نّ عَلْ سُبٍ نَشٍيٍ قَشَمَ.<verse eid="PSA 49:21"/></para>
  <chapter eid="PSA 49"/>
  <chapter number="50" style="c" sid="PSA 50"/>
  <para style="s1">سّرّشّ نَشَن نَقَن عَلَ مَ</para>
  <para style="s2">عَلَ شَ سّرِيّ</para>
  <para style="d">عَسَقِ شَ بّيتِ</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 50:1"/>عَلَتَلَ نَ وْيّنقٍ.</para>
  <para style="q" vid="PSA 50:1">عَ نَ دُنِحَ بِرِن شِلِقٍ،</para>
  <para style="q" vid="PSA 50:1">كٍلِ سٌفٍتٍدٍ هَن سٌفٍفٌرٌدٍ.<verse eid="PSA 50:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 50:2"/>كٍلِقٍ سِيٌن،</para>
  <para style="q" vid="PSA 50:2">عَلَ شَ تٌقَنيِ يَنبَمَ.<verse eid="PSA 50:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 50:3"/>وٌن مَرِفِ عَلَ نَ قَقٍ،</para>
  <para style="q" vid="PSA 50:3">عَ مُ دُندُشِ.</para>
  <para style="q" vid="PSA 50:3">تّ بٍلٍبٍلٍ نَ عَ يَ رَ،</para>
  <para style="q" vid="PSA 50:3">قٌيٍ شُنفبٍ قَن نَ عَ رَبِلِنيِ.<verse eid="PSA 50:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 50:4"/>عَ شُي تٍمَ كٌورٍ مَ،</para>
  <para style="q" vid="PSA 50:4">عَ شُي فٌرٌ مَ بْشِ</para>
  <para style="q" vid="PSA 50:4">كِيتِ سَدٍ عَ شَ مِشِيٍ بّ.<verse eid="PSA 50:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 50:5"/>«ﭑ بَتُلَيٍ،</para>
  <para style="q" vid="PSA 50:5">نَشٍيٍ لَايِدِ تٌنفٌشِ ﭑ بّ سّرّشّ رَ،</para>
  <para style="q" vid="PSA 50:5">وٌ شَ وٌ مَلَن.»<verse eid="PSA 50:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 50:6"/>عَلَ شَ مَسٍنيِ تِنشِنشِ كٍلِمَ كٌورٍ نَن مَ،</para>
  <para style="q" vid="PSA 50:6">بَرِ مَ كِيتِسَ نَن نَ عَلَ رَ.<verse eid="PSA 50:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 50:7"/>«ﭑ مَ مِشِيٍ، وٌ وٌ تُلِ مَتِ، ﭑ شَ وْيّن.</para>
  <para style="q" vid="PSA 50:7">عِسِرَيِلَ، ﭑ بَرَ وٌ كَلَمُ.</para>
  <para style="q" vid="PSA 50:7">عَلَ نَن ﭑ نَ، وٌ مَرِفِ عَلَ.<verse eid="PSA 50:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 50:8"/>ﭑ مُ شْنْشِ وٌ شَ سّرّشّيٍ شَ قٍ رَ.</para>
  <para style="q" vid="PSA 50:8">وٌ سّرّشّ فَن دَاشِيٍ بَمَ ﭑ بّ تّمُي بِرِن.<verse eid="PSA 50:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 50:9"/>ﭑ مُ تُورَ تٌنفٌمَ وٌ شْنيِ.</para>
  <para style="q" vid="PSA 50:9">ﭑ مُ سِ كٌنتٌنيِ قَن تٌنفٌمَ وٌ شَ كُلّ.<verse eid="PSA 50:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 50:10"/>ﭑ فبٍ نَن نَ سُبٍ بِرِن نَ وُلَ عِ.</para>
  <para style="q" vid="PSA 50:10">ﭑ فبٍ نَن نَ سُبٍ بِرِن نَ فٍيَيٍ مَ.<verse eid="PSA 50:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 50:11"/>ﭑ فبٍ نَن نَ شْنِ بِرِن نَ كٌورٍ مَ.</para>
  <para style="q" vid="PSA 50:11">ﭑ فبٍ نَن نَ سُبٍ بِرِن نَ قِيلِ مَ.<verse eid="PSA 50:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 50:12"/>شَ كَامّ ﭑ سُشُمَ نُ، ﭑ مَ قَلَمَ وٌ تَن بّ.</para>
  <para style="q" vid="PSA 50:12">ﭑ فبٍ نَن نَ دُنِحَ بِرِن نَ.<verse eid="PSA 50:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 50:13"/>ﭑ تَن تُورَ سُبٍ دٌنمَ؟ عَدٍ.</para>
  <para style="q" vid="PSA 50:13">ﭑ تَن سِ كٌنتٌنيِ وُلِ مِنمَ؟ عَدٍ.<verse eid="PSA 50:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 50:14"/>عَ لَنمَ وٌ شَ تَنتُي رَ سِفَ ﭑ مَ،</para>
  <para style="q" vid="PSA 50:14">نَ شَ قِندِ وٌ شَ سّرّشّيٍ رَ.</para>
  <para style="q" vid="PSA 50:14">وٌ شَ وٌ شَ لَايِدِيٍ رَكَمَلِ ﭑ بّ، ﭑ تَن عَلَ شِلِ شُنفبٍ كَنيِ.<verse eid="PSA 50:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 50:15"/>وٌ شَ ﭑ شِلِ وٌ شَ تْورّ كُي.</para>
  <para style="q" vid="PSA 50:15">ﭑ قَمَ وٌ رَتَنفَدٍ،</para>
  <para style="q" vid="PSA 50:15">وٌ قَن قَمَ ﭑ مَتْشْدٍ.»<verse eid="PSA 50:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 50:16"/>عَلَ شَ مَسٍنيِ نَن يَ، مِشِ حَاشِيٍ بّ،</para>
  <para style="q" vid="PSA 50:16">«وٌ نَ ﭑ مَ يَامَرِ نُن ﭑ مَ سَاتّ دُرُ سِقٍ مُنقٍ رَ؟<verse eid="PSA 50:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 50:17"/>ﭑ مَ سّرِيّ مُ رَقَن وٌ مَ.</para>
  <para style="q" vid="PSA 50:17">وٌ مُ ﭑ مَ وْيّنيِ دَنشُنمَ.<verse eid="PSA 50:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 50:18"/>وٌ نُن مُحّتِيٍ نَ عَ رَ.</para>
  <para style="q" vid="PSA 50:18">وٌ نُن يّنّ رَبَيٍ نَ عَ رَ.<verse eid="PSA 50:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 50:19"/>قٍ حَاشِ نَن تُن مِنِمَ وٌ دّ عِ،</para>
  <para style="q" vid="PSA 50:19">وٌ وُلٍ نَن تُن قَلَمَ.<verse eid="PSA 50:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 50:20"/>وٌ نُن نَشَن نفَ كٍرٍن عَ رَ،</para>
  <para style="q" vid="PSA 50:20">وٌ نَ تْوحّفّمَ.<verse eid="PSA 50:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 50:21"/>وٌ نَشَن نَبَشِ، نَ نَن يَ.</para>
  <para style="q" vid="PSA 50:21">هَن يَكْسِ ﭑ بَرَ ﭑ سَبَرِ.</para>
  <para style="q" vid="PSA 50:21">وٌ حْشْ عَ مَ عَ ﭑ نَ وٌ سّيتِ مَ،</para>
  <para style="q" vid="PSA 50:21">كْنْ ﭑ قَمَ شَاحّدٍ وٌ مَ،</para>
  <para style="q" vid="PSA 50:21">ﭑ قَمَ عَ بِرِن يَ بَدٍ وٌ بّ.<verse eid="PSA 50:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 50:22"/>وٌ شَ يِ قٍ مّ،</para>
  <para style="q" vid="PSA 50:22">وٌ تَن نَشٍيٍ نّيمُشِ عَلَ مَ،</para>
  <para style="q" vid="PSA 50:22">شَ نَ مَرَ ﭑ وٌ شَ قٍ كَنَمَ نّ.</para>
  <para style="q" vid="PSA 50:22">مِشِ يٌ مُ وٌ رَتَنفَمَ.<verse eid="PSA 50:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 50:23"/>نَشَن تَنتُي سّرّشّ بَمَ ﭑ بّ،</para>
  <para style="q" vid="PSA 50:23">نَ مِشِ بَرَ ﭑ مَتْشْ.</para>
  <para style="q" vid="PSA 50:23">مِشِ نَشَن عَ حّرّ كِ مَتٌمَ عَ قَنيِ رَ،</para>
  <para style="q" vid="PSA 50:23">ﭑ قَمَ ﭑ تَن عَلَ شَ مَرَكِسِ مَسٍندٍ عَ بّ.»<verse eid="PSA 50:23"/></para>
  <chapter eid="PSA 50"/>
  <chapter number="51" style="c" sid="PSA 51"/>
  <para style="s1">دَوُدَ شَ يُنُبِ</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 51:1"/>دَوُدَ شَ بّيتِ بّيتِبَيٍ شَ مَنفّ بّ. <verse eid="PSA 51:1"/><verse number="2" style="v" sid="PSA 51:2"/>عَننَبِ نَتَن وْيّنقٍ دَوُدَ بّ عَ يُنُبِ رَبَ بَتِسٍبَ رَ تّمُي نَشّ.<verse eid="PSA 51:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 51:3"/>عَلَ، هِننّ ﭑ نَ عَلْ عِ دَرِشِ عَ رَ كِ نَشّ.</para>
  <para style="q" vid="PSA 51:3">دِحّ ﭑ مَ قٍ حَاشِ مَ عِ شَ بْحّ قَنيِ سَابُي رَ.<verse eid="PSA 51:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 51:4"/>عِ شَ ﭑ نَسّنِيّن ﭑ مَ قٍ كٌبِ بِرِن مَ.</para>
  <para style="q" vid="PSA 51:4">عِ شَ ﭑ مَ يُنُبِ شَقَرِ.<verse eid="PSA 51:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 51:5"/>ﭑ بَرَ ﭑ مَ يُنُبِ كٌلٌن.</para>
  <para style="q" vid="PSA 51:5">ﭑ مُ نْمَ نّيمُدٍ نَ مَ.<verse eid="PSA 51:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 51:6"/>ﭑ نَ قٍ حَاشِ رَبَشِ عِ كٍرٍن نَن نَ.</para>
  <para style="q" vid="PSA 51:6">ﭑ نَشَن نَبَشِ عَ مُ رَقَن عِ مَ.</para>
  <para style="q" vid="PSA 51:6">عِ نَ ﭑ مَكِيتِ،</para>
  <para style="q" vid="PSA 51:6">نْندِ لُمَ نّ عِ بّ.<verse eid="PSA 51:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 51:7"/>ﭑ بَرِشِ يُنُبِ قٍ نَن كُي،</para>
  <para style="q" vid="PSA 51:7">كَبِ نفَ قُرِ بَ نّينّ رَ.<verse eid="PSA 51:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 51:8"/>كْنْ نْندِ نَ لُ مِشِ بْحّ كُي،</para>
  <para style="q" vid="PSA 51:8">نَ نَن نَقَن عِ مَ.</para>
  <para style="q" vid="PSA 51:8">نَ لْننِ مَسٍن ﭑ بّ.<verse eid="PSA 51:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 51:9"/>ﭑ سّنِيّن هِسٌثِ بُرّشّ رَ،</para>
  <para style="q" vid="PSA 51:9">عَلَكٌ ﭑ شَ قِيشّ.</para>
  <para style="q" vid="PSA 51:9">ﭑ سّنِيّن،</para>
  <para style="q" vid="PSA 51:9">عَلَكٌ ﭑ شَ قِيشّ قْين عَلْ شِحّ.<verse eid="PSA 51:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 51:10"/>حّلّشِنيِ نُن سّيوّ قِ ﭑ مَ،</para>
  <para style="q" vid="PSA 51:10">عَلَكٌ ﭑ بْحّ شَ سَ.<verse eid="PSA 51:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 51:11"/>عِ كٌبٍ تِ ﭑ مَ يُنُبِ رَ،</para>
  <para style="q" vid="PSA 51:11">عِ شَ ﭑ مَ قٍ كٌبِ بِرِن بَ ﭑ مَ.<verse eid="PSA 51:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 51:12"/>ﭑ مَرِفِ عَلَ، ﭑ بْحّ مَقِندِ بْحّ سّنِيّنشِ رَ،</para>
  <para style="q" vid="PSA 51:12">شَشِلِ قَنيِ قِ ﭑ مَ.<verse eid="PSA 51:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 51:13"/>عِ نَشَ ﭑ مَكُيَ عِ يَ تٌدٍ رَ.</para>
  <para style="q" vid="PSA 51:13">عِ نَشَ عِ شَشِلِ سّنِيّنشِ بَ ﭑ يِ رَ.<verse eid="PSA 51:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 51:14"/>كِسِ سّيوّ نُن لِمَنِيَ قِ ﭑ مَ</para>
  <para style="q" vid="PSA 51:14">نَشَن ﭑ مَلِمَ.<verse eid="PSA 51:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 51:15"/>ﭑ عِ شَ كِرَ مَسٍنمَ نّ عِ مَتَندِلَيٍ بّ،</para>
  <para style="q" vid="PSA 51:15">عَلَكٌ عٍ مَن شَ بِرَ عِ قْشْ رَ.<verse eid="PSA 51:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 51:16"/>ﭑ نَكِسِمَ عَلَ،</para>
  <para style="q" vid="PSA 51:16">ﭑ بَرَ مِشِ قَشَ.</para>
  <para style="q" vid="PSA 51:16">يَندِ، ﭑ شُنسَرَ،</para>
  <para style="q" vid="PSA 51:16">عَلَكٌ ﭑ شَ عِ شَ قٍ قَنيِ مَسٍن.<verse eid="PSA 51:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 51:17"/>ﭑ مَرِفِ، نَ نِيَ ﭑ بّ،</para>
  <para style="q" vid="PSA 51:17">ﭑ شَ عِ تَنتُ.<verse eid="PSA 51:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 51:18"/>سّرّشّ مُ رَقَن عِ مَ،</para>
  <para style="q" vid="PSA 51:18">شَ نَ مُ عَ رَ ﭑ نَ بَمَ نّ عِ بّ نُ.</para>
  <para style="q" vid="PSA 51:18">عِ مُ وَ مَ سّرّشّ فَن دَاشِ شْن.<verse eid="PSA 51:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 51:19"/>سّرّشّ قَنيِ قِندِشِ يّتّ مَفٌرٌي نَن نَ.</para>
  <para style="q" vid="PSA 51:19">عَلَ وَ مَ يِ سّرّشّ مْولِ نَن شْن مَ.<verse eid="PSA 51:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="PSA 51:20"/>عِ شَ هِننّ سِيٌنِ رَ،</para>
  <para style="q" vid="PSA 51:20">عِ شَ دَرِ سَلَمُ تّتّ رَكٍلِ.<verse eid="PSA 51:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 51:21"/>نَ تّمُي عِ حّلّشِنمَ نّ سّرّشّ تِنشِنشِ</para>
  <para style="q" vid="PSA 51:21">نُن سّرّشّ فَن دَاشِ رَ.</para>
  <para style="q" vid="PSA 51:21">نَ تّمُي تُورَيٍ نَن بَمَ سّرّشّ رَ عِ شَ سّرّشّبَدٍ.<verse eid="PSA 51:21"/></para>
  <chapter eid="PSA 51"/>
  <chapter number="52" style="c" sid="PSA 52"/>
  <para style="s1">دّ حَاشِ</para>
  <para style="s2">عَلَ شَ سّرِيّ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 52:1"/>دَوُدَ شَ لْننِ بّيتِ بّيتِبَيٍ شَ مَنفّ بّ. <verse eid="PSA 52:1"/><verse number="2" style="v" sid="PSA 52:2"/>مَسٍنيِ نَن يَ دٌوٍفٍ عٍدٌنكَ شَ قٍ رَ، نَشَن عَ قَلَ سْلُ بّ عَ دَوُدَ نَ عَشِمٍلٍكِ شْنيِ.<verse eid="PSA 52:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 52:3"/>عِ عِ يّتّ عِفبٌمَ قٍ كٌبِ رَبَقٍ رَ مُنقٍ رَ؟</para>
  <para style="q" vid="PSA 52:3">عَلَ شَ هِننّ بُمَ نّ عَبَدَن.<verse eid="PSA 52:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 52:4"/>عِ دّ لُمَ عَلْ قِنّ نَشَن قٍ حَاشِ رَبَمَ.</para>
  <para style="q" vid="PSA 52:4">يَنقَنتٍ نَن عِ رَ.<verse eid="PSA 52:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 52:5"/>قٍ حَاشِ رَقَن عِ مَ دَنفِقٍ قٍ قَنيِ رَ.</para>
  <para style="q" vid="PSA 52:5">وُلٍ رَقَن عِ مَ دَنفِقٍ نْندِ رَ. <char style="qs">حّنفِ رَتٍ.</char><verse eid="PSA 52:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 52:6"/>عِ وْيّن شُي شَاحّ، عِ دّ مُ قَن.<verse eid="PSA 52:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 52:7"/>نَ كُي عَلَ قَمَ عِ رَهَلَكِدٍ تّمُي بِرِن.</para>
  <para style="q" vid="PSA 52:7">عَ عِ سُشُمَ نّ، عَ عِ كٍرِ عِ شَ بَنشِ كُي، عَ عِ كٍرِ دُنِحَ مَ. <char style="qs">حّنفِ رَتٍ.</char><verse eid="PSA 52:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 52:8"/>تِنشِنتْي نَشٍيٍ قِندِ مَ سٍيدٍيٍ رَ</para>
  <para style="q" vid="PSA 52:8">عٍ قَمَ يٍلٍدٍ نَ كَنيِ مَ يِ كِ نّ،<verse eid="PSA 52:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 52:9"/>«وٌ نَ مِشِ مَتٌ،</para>
  <para style="q" vid="PSA 52:9">نَشَن مُ نُ عَ شَشِلِ تِشِ عَلَ رَ.</para>
  <para style="q" vid="PSA 52:9">عَ نَشَ لَ عَ شَ نَاقُلِ رَ،</para>
  <para style="q" vid="PSA 52:9">عَ عَ يّتّ كَنتَ عَ شَ يَنقَنتٍيَ رَ.<verse eid="PSA 52:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 52:10"/>كْنْ، ﭑ تَن نَشَن لَشِ عَلَ شَ هِننّ رَ،</para>
  <para style="q" vid="PSA 52:10">ﭑ مَ قٍ بِرِن نَ سْونّيَقٍ</para>
  <para style="q" vid="PSA 52:10">عَلْ عٌلِوِ وُرِ تٌقَنيِ نَشَن نَ عَلَ شْنيِ.»<verse eid="PSA 52:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 52:11"/>ﭑ عِ تَنتُمَ نّ عَبَدَن عِ شَ وَلِ شَ قٍ رَ.</para>
  <para style="q" vid="PSA 52:11">ﭑ شَشِلِ تِشِ عِ شِلِ قَنيِ نَن نَ عِ شَ دَنشَنِيَتْييٍ تَفِ،</para>
  <para style="q" vid="PSA 52:11">بَرِ مَ عِ قَن.<verse eid="PSA 52:11"/></para>
  <chapter eid="PSA 52"/>
  <chapter number="53" style="c" sid="PSA 53"/>
  <para style="s1">شَشِلِتَرٍ شَ مَسٍنيِ</para>
  <para style="s2">عَلَ شَ سّرِيّ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 53:1"/>دَوُدَ شَ لْننِ بّيتِ بّيتِبَيٍ شَ مَنفّ بّ. عَ شَ بَ شُلٍ شُي رَ.<verse eid="PSA 53:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 53:2"/>شَشِلِتَرٍ عَ قَلَمَ عَ بْحّ كُي، «عَلَ مُ نَ.»</para>
  <para style="q" vid="PSA 53:2">عٍ قٍ هَرَ مُشِيٍ رَبَمَ، عٍ مُ تِنشِن.</para>
  <para style="q" vid="PSA 53:2">مِشِ يٌ مُ نَ نَشَن قٍ قَنيِ رَبَمَ.<verse eid="PSA 53:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 53:3"/>عَلَ عَ يَ رَفٌرٌ مَ عَدَ مَدِيٍ مَ كٍلِقٍ عَرِيَننَ،</para>
  <para style="q" vid="PSA 53:3">عَ شَ عٍ مَتٌ شَ شَشِلِمَ ندٍ نَ نَ نَشَن عَلَ قٍنمَ.<verse eid="PSA 53:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 53:4"/>كْنْ بِرِن بَرَ مَكُيَ عَلَ رَ، عٍ نُ قٍ حَاشِ رَبَ.</para>
  <para style="q" vid="PSA 53:4">هَلِ مِشِ كٍرٍن مُ نَ نَشَن قٍ قَنيِ رَبَمَ.<verse eid="PSA 53:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 53:5"/>تِنشِنتَرٍيٍ شَشِلِ مُ نَ؟</para>
  <para style="q" vid="PSA 53:5">عٍ نُ ﭑ مَ حَمَ تْورْ تُن.</para>
  <para style="q" vid="PSA 53:5">عٍ مُ عَلَ شِلِمَ قٍوٌ.<verse eid="PSA 53:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 53:6"/>عٍ قَمَ سّرّندٍ فَاشُي رَ نَ نَن مَ،</para>
  <para style="q" vid="PSA 53:6">بَرِ مَ عَلَ قَمَ نَ مِشِ مْولِيٍ رَيٍنسٍندٍ،</para>
  <para style="q" vid="PSA 53:6">نَشٍيٍ وَ مَ وٌ تْورْقٍ.<verse eid="PSA 53:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 53:7"/>ندٍ كٍلِمَ سِيٌن عَ شَ عِسِرَيِلَ رَكِسِ؟</para>
  <para style="q" vid="PSA 53:7">عَلَ نَ عَ شَ حَمَ رَ مِنِ كٌنيِيَ كُي،</para>
  <para style="q" vid="PSA 53:7">يَشُبَ بْنسْي سّيوَ مَ نّ، عِسِرَيِلَ حّلّشِنمَ نّ.<verse eid="PSA 53:7"/></para>
  <chapter eid="PSA 53"/>
  <chapter number="54" style="c" sid="PSA 54"/>
  <para style="s1">ﭑ مَرِفِ تِمَ ﭑ بُن مَ</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 54:1"/>دَوُدَ شَ لْننِ بّيتِ بّيتِبَيٍ شَ مَنفّ بّ. عَ شَ بَ كْرَ شُي رَ. <verse eid="PSA 54:1"/><verse number="2" style="v" sid="PSA 54:2"/>سِقِكَيٍ تٌ عَ قَلَ سْلُ بّ عَ دَوُدَ عَ نْشُنشِ عٍ شْنيِ، دَوُدَ نَشَ يِ بّيتِ بَ.<verse eid="PSA 54:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 54:3"/>عَلَ، ﭑ نَكِسِ عِ شِلِ رَ، ﭑ مَ كِيتِ سَ عِ سّنبّ رَ.<verse eid="PSA 54:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 54:4"/>عَلَ، ﭑ مَ دُبّ سُشُ، عِ تُلِ مَتِ ﭑ مَ وْيّنيِ رَ.<verse eid="PSA 54:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 54:5"/>شْحّ ندٍيٍ بَرَ كٍلِ ﭑ شِلِ مَ،</para>
  <para style="q" vid="PSA 54:5">مِشِ كٌبِ نَشٍيٍ وَ مَ ﭑ قَشَقٍ.</para>
  <para style="q" vid="PSA 54:5">عٍ مُ عَلَ كٌلٌن قٍقٍ مَ. <char style="qs">حّنفِ رَتٍ.</char><verse eid="PSA 54:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 54:6"/>عَلَ ﭑ مَلِمَ، ﭑ مَرِفِ تِمَ ﭑ بُن مَ.<verse eid="PSA 54:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 54:7"/>عَ ﭑ يَشُييٍ شَ كٌبِحَ سَرٍ رَفبِلٍنمَ عٍ مَ.</para>
  <para style="q" vid="PSA 54:7">عِ شَ عٍ هَلَكِ عِ شَ دُفُتّفّحَ كُي.<verse eid="PSA 54:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 54:8"/>ﭑ بَرَ عَ حَنِفٍ ﭑ شَ سّرّشّ بَ عِ بّ.</para>
  <para style="q" vid="PSA 54:8">عَلَتَلَ، ﭑ عِ شِلِ تَنتُمَ نّ بَرِ مَ عِ قَن،<verse eid="PSA 54:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 54:9"/>عِ مَن ﭑ نَكِسِمَ ﭑ مَ تْورّ كُي، ﭑ قَ نْ ﭑ يَشُييٍ رَ.<verse eid="PSA 54:9"/></para>
  <chapter eid="PSA 54"/>
  <chapter number="55" style="c" sid="PSA 55"/>
  <para style="s1">يَنقَنتٍيٍ</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 55:1"/>دَوُدَ شَ لْننِ بّيتِ بّيتِبَيٍ شَ مَنفّ بّ. عَ شَ بَ كْرَ شُي رَ.<verse eid="PSA 55:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 55:2"/>عَلَ، ﭑ مَ دُبّ سُشُ،</para>
  <para style="q" vid="PSA 55:2">عِ نَشَ عِ نْشُن ﭑ مَ مَشَندِ مَ.<verse eid="PSA 55:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 55:3"/>عِ تُلِ مَتِ ﭑ نَ، عِ شَ ﭑ يَابِ.</para>
  <para style="q" vid="PSA 55:3">شَنمّرِ نُن فَاشُي بَرَ فّ ﭑ سُشُدٍ<verse eid="PSA 55:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 55:4"/>ﭑ يَشُييٍ شَ وْيّنيِ شَ قٍ رَ،</para>
  <para style="q" vid="PSA 55:4">عَ نُن مِشِ حَاشِيٍ شَ وَلِ كٌبِ شَ قٍ رَ.</para>
  <para style="q" vid="PSA 55:4">عٍ وَ مَ ﭑ تْورْقٍ، عٍ ﭑ تْوحّفّمَ شْنّ كُي.<verse eid="PSA 55:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 55:5"/>ﭑ بْحّ بَرَ سّرّن، ﭑ سٌندٌنيِ بَرَ فَاشُ قَشّ يَ رَ.<verse eid="PSA 55:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 55:6"/>فَاشُي نُن سّرّنيِ بَرَ ﭑ سُشُ عَ حَاشِ رَ.</para>
  <para style="q" vid="PSA 55:6">نَ بَرَ ﭑ نَتَفَن.<verse eid="PSA 55:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 55:7"/>شَ فَبُتٍنيِ نَن نُ نَ ﭑ بّ نُ عَلْ فَنبّ،</para>
  <para style="q" vid="PSA 55:7">ﭑ نُ بَرَ سِفَ يِفِيَ قٍندٍ نُ،<verse eid="PSA 55:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 55:8"/>ﭑ نُ ﭑ فِمَ نّ، ﭑ سِفَ يِرٍ مَكُيٍ،</para>
  <para style="q" vid="PSA 55:8">ﭑ سِفَمَ وُلَ عِ نّ نُ. <char style="qs">حّنفِ رَتٍ.</char><verse eid="PSA 55:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 55:9"/>ﭑ شَ ﭑ فِ مَقُرٍن، عَلْ قٌيٍ شُنفبٍ.<verse eid="PSA 55:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 55:10"/>ﭑ مَرِفِ، قٍ كٌبِ رَبَيٍ رَيٍنسٍن يّ.</para>
  <para style="q" vid="PSA 55:10">عِ نَشَ عٍ لُ عٍ شَ لَن قٍ كٌبِ مَ،</para>
  <para style="q" vid="PSA 55:10">بَرِ مَ كٌبِحَ نُن فٍرٍ بَرَ فبٌ تَا كُي.<verse eid="PSA 55:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 55:11"/>كْي نُن يَنيِ رَ قٍ كٌبِ رَبَيٍ تَا رَبِلِنمَ،</para>
  <para style="q" vid="PSA 55:11">عٍ شَ قٍ حَاشِ نُن تِنشِنتَرٍيَ رَبَ تَا كُي.<verse eid="PSA 55:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 55:12"/>عٍ بَرَ قٍ بِرِن كَنَ.</para>
  <para style="q" vid="PSA 55:12">فبّسّنشْننّيَ نُن مَءِقُي بَرَ فبٌ تَا كُي.<verse eid="PSA 55:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 55:13"/>شَ يَشُي نَن تُن ﭑ كٌنبِمَ نُ، ﭑ دِحّمَ.</para>
  <para style="q" vid="PSA 55:13">شَ ﭑ شْنمِشِ نَن تُن كٍلِمَ ﭑ شِلِ مَ نُ،</para>
  <para style="q" vid="PSA 55:13">ﭑ نَن ﭑ نْشُنمَ نّ عَ مَ نُ.<verse eid="PSA 55:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PSA 55:14"/>كْنْ عِ تَن ﭑ لَنقَنمَ نَن عِ رَ، ﭑ شَنُنتٍنيِ، ﭑ دّقَنبٌورٍ.<verse eid="PSA 55:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 55:15"/>وٌن دّ قَن، وٌن بِرِن سِفَمَ عَلَ شَ هْرْ مْبَنشِ.<verse eid="PSA 55:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 55:16"/>عٍ شَ عٍ تّرّننَ قَشّ رَ،</para>
  <para style="q" vid="PSA 55:16">عٍ شَ فٌرٌ فَبُرِ كُي عٍ حِحّ رَ،</para>
  <para style="q" vid="PSA 55:16">بَرِ مَ عٍ عٍ حّرّ مَ قٍ حَاشِيٍ نَن تُن كُي.<verse eid="PSA 55:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PSA 55:17"/>كْنْ ﭑ بَرَ عَلَ شِلِ. عَلَتَلَ ﭑ نَكِسِمَ نّ.<verse eid="PSA 55:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 55:18"/>ﭑ فبٍلٍفبٍلٍمَ كْي عَ نُن يَنيِ رَ. عَ بَرَ ﭑ شُي مّ.<verse eid="PSA 55:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 55:19"/>ﭑ يَشُييٍ تٌ وُيَ، عَ بَرَ ﭑ نَتَنفَ نَ فٍرٍ مَ.<verse eid="PSA 55:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 55:20"/>عَلَ نَشَن نَ عَ شَ كِبَنيِ كُي كَبِ عَ قْلّ،</para>
  <para style="q" vid="PSA 55:20">عَ عَ تُلِ مَتِمَ ﭑ نَ، عَ قَ ﭑ يَشُييٍ رَبِرَ، <char style="qs">حّنفِ رَتٍ</char></para>
  <para style="q" vid="PSA 55:20">بَرِ مَ عٍ تٌندِشِ تُوبِدٍ.</para>
  <para style="q" vid="PSA 55:20">عٍ مُ فَاشُ عَلَ يَ رَ.<verse eid="PSA 55:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 55:21"/>يِ مِشِيٍ بَرَ عٍ بٌرٍ فٍرٍ، عٍ سَاتّ كَنَ.<verse eid="PSA 55:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 55:22"/>عٍ دّ عِحْشُن عَلْ شِحّ، كْنْ فٍرٍ نَ عٍ بْحّ كُي.</para>
  <para style="q" vid="PSA 55:22">عٍ شَ وْيّنيِ سَلَشُن عَلْ تُرٍ،</para>
  <para style="q" vid="PSA 55:22">كْنْ عٍ مِشِ تْورْ مَ عَلْ سَنتِدّفّمَ نَشَن بَشِ عَ تّي عِ.<verse eid="PSA 55:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 55:23"/>عِ شَ عِ شَشِلِ تِ عَلَتَلَ رَ، عَ عِ مَلِمَ نّ.</para>
  <para style="q" vid="PSA 55:23">عَ مُ تِنمَ تِنشِنتْي شَ بِرَ.<verse eid="PSA 55:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 55:24"/>عَلَ، يِ فٍرٍ سٌي نُن يِ يَنقَنتٍيٍ شَنِن عَلِفِيَمَ.</para>
  <para style="q" vid="PSA 55:24">عِ نَشَ عٍ شَ سِمَيَ كْنتِ رَكَمَلِ.</para>
  <para style="q" vid="PSA 55:24">عَلَ، ﭑ بَرَ ﭑ تَشُ عِ رَ.<verse eid="PSA 55:24"/></para>
  <chapter eid="PSA 55"/>
  <chapter number="56" style="c" sid="PSA 56"/>
  <para style="s1">ﭑ مُ فَاشُمَ سْنْن</para>
  <para style="s2">عَلَ مَشَندِ نُن عَلَ مَتْشْي</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 56:1"/>دَوُدَ شَ سُوكِ بّيتِبَيٍ شَ مَنفّ بّ. عَ شَ بَ عَلْ بّيتِ نَشَن شِلِ، «فَنبّ نَ وُرِ مَكُيٍ قَرِ.» عَ عَ بَ قِلِسِتَكَيٍ عَ سُشُ تّمُي نَشّ فَتِ.<verse eid="PSA 56:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 56:2"/>عَلَ، هِننّ ﭑ نَ بَرِ مَ مِشِيٍ نَ ﭑ فٍرٍقٍ.</para>
  <para style="q" vid="PSA 56:2">عٍ فٍرٍ تِمَ ﭑ بّ تّمُي بِرِن.<verse eid="PSA 56:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 56:3"/>ﭑ يَشُييٍ قّيحّنمَ فٍرٍ رَ.</para>
  <para style="q" vid="PSA 56:3">عَلَ شُنفبٍ، ﭑ فٍرٍقَيٍ بَرَ وُيَ.<verse eid="PSA 56:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 56:4"/>ﭑ نَ فَاشُ تّمُي نَشّ،</para>
  <para style="q" vid="PSA 56:4">ﭑ نَن ﭑ شَشِلِ تِمَ عِ تَن نَن نَ.<verse eid="PSA 56:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 56:5"/>ﭑ عَلَ شَ مَسٍنيِ مَتْشْمَ.</para>
  <para style="q" vid="PSA 56:5">ﭑ مُ فَاشُمَ سْنْن،</para>
  <para style="q" vid="PSA 56:5">بَرِ مَ ﭑ بَرَ لَ عَلَ رَ.</para>
  <para style="q" vid="PSA 56:5">عِبُنَدَ مَ فبَنسَن نْمَ مُنسٍ رَبَدٍ ﭑ نَ؟<verse eid="PSA 56:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 56:6"/>تّمُي بِرِن ﭑ يَشُييٍ وَ مَ ﭑ تْورْقٍ عٍ شَ وْيّنيِ رَ.</para>
  <para style="q" vid="PSA 56:6">ﭑ مَ قٍقٍ مُ رَقَنشِ عٍ مَ.<verse eid="PSA 56:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 56:7"/>عٍ لَنشِ ﭑ مَ حَشَنكَتّ مَ،</para>
  <para style="q" vid="PSA 56:7">عٍ بِرَ ﭑ قْشْ رَ يِرٍ بِرِن عَلَكٌ عٍ شَ ﭑ قَشَ.<verse eid="PSA 56:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 56:8"/>عِ نَشَ تِن عٍ شَ رَتَنفَ عٍ شَ قٍ حَاشِيٍ مَ.</para>
  <para style="q" vid="PSA 56:8">عَلَ، عِ شَ شْنّ شَ عٍ رَبِرَ.<verse eid="PSA 56:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 56:9"/>عِ ﭑ مَ دُنِحّءِفِرِ كٌلٌن، عِ ﭑ يَيٍ تٌشِ.</para>
  <para style="q" vid="PSA 56:9">ﭑ مَ تْورّ بِرِن سّبّشِ عِ يِ رَ.<verse eid="PSA 56:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 56:10"/>ﭑ نَ عِ شِلِ تّمُي نَشّ،</para>
  <para style="q" vid="PSA 56:10">ﭑ يَشُييٍ فبِلٍنمَ نّ ﭑ قْشْ رَ.</para>
  <para style="q" vid="PSA 56:10">ﭑ عَ كٌلٌن ﭑ نُن عَلَ نَ عَ رَ.<verse eid="PSA 56:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 56:11"/>ﭑ عَلَ شَ وْيّنيِ مَتْشْمَ،</para>
  <para style="q" vid="PSA 56:11">ﭑ عَلَتَلَ شَ مَسٍنيِ مَتْشْمَ.<verse eid="PSA 56:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 56:12"/>ﭑ مُ فَاشُمَ سْنْن، بَرِ مَ ﭑ بَرَ لَ عَلَ رَ.</para>
  <para style="q" vid="PSA 56:12">عِبُنَدَ مَ فبَنسَن نْمَ مُنسٍ رَبَدٍ ﭑ نَ؟<verse eid="PSA 56:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 56:13"/>عَلَ، ﭑ شَ ﭑ مَ لَايِدِ رَكَمَلِ عِ بّ،</para>
  <para style="q" vid="PSA 56:13">ﭑ مَ تَنتُي سّرّشّيٍ رَ،<verse eid="PSA 56:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 56:14"/>بَرِ مَ عِ بَرَ ﭑ نَتَنفَ قَشّ مَ.</para>
  <para style="q" vid="PSA 56:14">عِ مُ تِن ﭑ شَ بِرَ،</para>
  <para style="q" vid="PSA 56:14">عَلَكٌ ﭑ شَ حّرّ عِ شَ كِرَ شْن مَ يِ بّندّ قُحِ قَرِ.<verse eid="PSA 56:14"/></para>
  <chapter eid="PSA 56"/>
  <chapter number="57" style="c" sid="PSA 57"/>
  <para style="s1">ﭑ بَرَ لِمَنِيَ سْتْ</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 57:1"/>دَوُدَ شَ سُوكِ بّيتِبَيٍ شَ مَنفّ بّ. عَ شَ بَ عَلْ بّيتِ نَشَن شِلِ «عِ نَشَ هَلَكِ تِ.» دَوُدَ نَشَ يِ بَ عَ تٌ عَ فِ سْلُ مَ، عَ سَ سٌ قْنمّ كُي.<verse eid="PSA 57:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 57:2"/>عَلَ، هِننّ ﭑ نَ، يَندِ عِ شَ هِننّ ﭑ نَ.</para>
  <para style="q" vid="PSA 57:2">ﭑ مَرَتَنفّ قٍنمَ عِ يِرٍ</para>
  <para style="q" vid="PSA 57:2">عَلْ تْشّيْرّ عَ قٍنمَ عَ نفَ فَبُتٍنيِ بُن مَ كِ نَشّ</para>
  <para style="q" vid="PSA 57:2">هَن قٍ شْرْشْي شَ دَنفِ.<verse eid="PSA 57:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 57:3"/>ﭑ بَرَ عَلَ شِلِ شُنفبٍ كَنيِ مَشَندِ</para>
  <para style="q" vid="PSA 57:3">نَشَن ﭑ مَ قٍ بِرِن سْونّيَمَ.<verse eid="PSA 57:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 57:4"/>ﭑ شْنمِشِيٍ ﭑ حَشَنكَتَمَ تّمُي نَشّ،</para>
  <para style="q" vid="PSA 57:4">عَلَ ﭑ نَكِسِمَ نّ كٍلِقٍ عَرِيَننَ، <char style="qs">حّنفِ رَتٍ</char></para>
  <para style="q" vid="PSA 57:4">عَ هِننّ نُن نْندِ رَفٌرٌ مَ ﭑ مَ.<verse eid="PSA 57:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 57:5"/>يّتّيٍ بَرَ ﭑ نَبِلِن،</para>
  <para style="q" vid="PSA 57:5">ﭑ سَشِ عٍ تَفِ، عٍ تَن نَشٍيٍ عَدَ مَدِيٍ قَشَمَ.</para>
  <para style="q" vid="PSA 57:5">عٍ حِنيِيٍ لُشِ عَلْ تَنبّيٍ،</para>
  <para style="q" vid="PSA 57:5">عٍ نّنيِيٍ لُشِ عَلْ سَنتِدّفّمَ نَشَن بَشِ عَ تّي عِ.<verse eid="PSA 57:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 57:6"/>عَلَ، عِ شَ عِ شَ بِنيّ مَسٍن كٌورٍ مَ،</para>
  <para style="q" vid="PSA 57:6">عِ شَ عَ مَسٍن بْشِ مَ.<verse eid="PSA 57:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 57:7"/>عٍ بَرَ يّلّ تِ ﭑ يَ رَ، عَ فبٍ مُ لُشِ ﭑ شَ سٌ عَ رَ.</para>
  <para style="q" vid="PSA 57:7">عٍ بَرَ يِلِ فٍ ﭑ يَ رَ، كْنْ عٍ تَن نَن بِرَشِ عَ كُي. <char style="qs">حّنفِ رَتٍ.</char><verse eid="PSA 57:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 57:8"/>عَلَ، ﭑ بْحّ بَرَ لِمَنِيَ، ﭑ بَرَ لِمَنِيَ سْتْ.</para>
  <para style="q" vid="PSA 57:8">ﭑ بّيتِ بَمَ نّ، ﭑ عِ تَنتُمَ نّ.<verse eid="PSA 57:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 57:9"/>ﭑ بْحّ بَرَ كٍلِ ﭑ نَ،</para>
  <para style="q" vid="PSA 57:9">ﭑ شَ ﭑ مَ كْرَيٍ تٌنفٌ، ﭑ شَ بّيتِ بَ هَن سُبَشّ.<verse eid="PSA 57:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 57:10"/>مَرِفِ، ﭑ عِ تَنتُمَ نّ سِيٍ تَفِ.</para>
  <para style="q" vid="PSA 57:10">ﭑ بّيتِ بَمَ نّ عِ بّ بْنسْييٍ تَفِ.<verse eid="PSA 57:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 57:11"/>عِ شَ هِننّ كٌورٍ لِمَ نّ،</para>
  <para style="q" vid="PSA 57:11">عِ شَ تِنشِنيِ تٍمَ نّ هَن نُشُييٍ.<verse eid="PSA 57:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 57:12"/>عَلَ، عِ شَ عِ شَ بِنيّ مَسٍن كٌورٍ مَ،</para>
  <para style="q" vid="PSA 57:12">عِ شَ عَ مَسٍن بْشِ مَ.<verse eid="PSA 57:12"/></para>
  <chapter eid="PSA 57"/>
  <chapter number="58" style="c" sid="PSA 58"/>
  <para style="s1">عَدَ مَدِيٍ سَرٍ</para>
  <para style="s2">عَلَ شَ سّرِيّ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 58:1"/>دَوُدَ شَ سُوكِ بّيتِبَيٍ شَ مَنفّ بّ. عَ شَ بَ عَلْ بّيتِ نَشَن شِلِ «عِ نَشَ كَسَرّ تِ».<verse eid="PSA 58:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 58:2"/>وٌ شَ وْيّنيِ مُ تِنشِن.</para>
  <para style="q" vid="PSA 58:2">عَدَ مَدِيٍ، وٌ نْمَ كِيتِ سَدٍ نْندِ رَ؟<verse eid="PSA 58:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 58:3"/>عَدٍ، وٌ قٍ حَاشِ رَبَمَ وٌ بْحّ كُي،</para>
  <para style="q" vid="PSA 58:3">وٌ قٍ حَاشِ رَبَمَ يِ بْشِ مَ،</para>
  <para style="q" vid="PSA 58:3">وٌ مِشِ رَتَنتَنمَ دُنِحَ مَ.<verse eid="PSA 58:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 58:4"/>كَقِ عٍ بَرِ تّمُي، عٍ قِندِشِ مِشِ حَاشِ نَن نَ.</para>
  <para style="q" vid="PSA 58:4">وُلٍ قَلّيٍ بَرَ لْي كَبِ عٍ بَرِ لْشْي.<verse eid="PSA 58:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 58:5"/>عٍ شَ شْنّ لُشِ نّ عَلْ بْشِمَسٍ شْنّ،</para>
  <para style="q" vid="PSA 58:5">عَلْ بْشِمَسٍ نَشَن مُ بْشِمَسٍ سُشُي شُي رَ مّمَ.<verse eid="PSA 58:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 58:6"/>هَلِ بْشِمَسٍ سُشُي قَنيِ، عَ مُ نْمَ عَ سُشُدٍ.<verse eid="PSA 58:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 58:7"/>عَلَ، عِ شَ عٍ حِنيِ كَنَ عٍ دّ عِ،</para>
  <para style="q" vid="PSA 58:7">بَرِ مَ عٍ لُشِ نّ عَلْ يّتّ.</para>
  <para style="q" vid="PSA 58:7">عَلَتَلَ، عِ شَ عٍ دّ وَنوَن.<verse eid="PSA 58:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 58:8"/>عٍ حْنمَ نّ عَلْ يٍ نَشَن عِقِلِمَ بْشِ.</para>
  <para style="q" vid="PSA 58:8">عٍ شَ تَنبّ مُ حّرّ مَ سّنبّ رَ.<verse eid="PSA 58:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 58:9"/>عَ لُمَ عَلْ بٌي نَشَن قَتٍ لْيمَ لِنفِ كُي.</para>
  <para style="q" vid="PSA 58:9">عَ لُمَ عَلْ دِ نَشَن بَشِ عَ نفَ قَتٍ عِ، عَ مُ قٌيٍ تٌ.<verse eid="PSA 58:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 58:10"/>بٍينُن تُندٍ شَ قُرَ يٍفٍ مَلِنسِنشِ رَ،</para>
  <para style="q" vid="PSA 58:10">شَ نَ مُ عَ رَ يٍفٍ شَرٍ رَ،</para>
  <para style="q" vid="PSA 58:10">عَلَ عٍ كْمَ نّ، عَ عٍ وْلّ عَ عِ.<verse eid="PSA 58:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 58:11"/>مِشِ تِنشِنشِ قَمَ حّلّشِندٍ</para>
  <para style="q" vid="PSA 58:11">بَرِ مَ عَ قَمَ فبٍحْشْي سْتْدٍ.</para>
  <para style="q" vid="PSA 58:11">عَ قَمَ عَ سَنيِ مَشَدٍ مِشِ حَاشِ وُلِ رَ.<verse eid="PSA 58:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 58:12"/>عَدَ مَدِيٍ قَمَ عَ قَلَدٍ،</para>
  <para style="q" vid="PSA 58:12">«عِيٌ، عَلَ مِشِ تِنشِنشِ سَرٍ قِمَ.</para>
  <para style="q" vid="PSA 58:12">عِيٌ، عَلَ كِيتِ سَمَ نّ دُنِحَ مَ.»<verse eid="PSA 58:12"/></para>
  <chapter eid="PSA 58"/>
  <chapter number="59" style="c" sid="PSA 59"/>
  <para style="s1">بَرٍ شَاحّيٍ</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 59:1"/>دَوُدَ شَ سُوكِ بّيتِبَيٍ شَ مَنفّ بّ. عَ شَ بَ عَلْ بّيتِ نَشَن شِلِ «عِ نَشَ هَلَكِ تِ». عَ نَشَ عَ بَ سْلُ تٌ سْورِيٍ شّي عٍ شَ دَوُدَ قَشَ عَ شَ بَنشِ كُي.<verse eid="PSA 59:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 59:2"/>ﭑ مَرِفِ عَلَ، ﭑ نَتَنفَ ﭑ يَشُييٍ مَ.</para>
  <para style="q" vid="PSA 59:2">ﭑ مَ قٍ شَ تٍ دَنفِقٍ ﭑ يَشُييٍ شَ قٍ رَ.<verse eid="PSA 59:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 59:3"/>ﭑ نَتَنفَ تِنشِنتَرٍيٍ مَ.</para>
  <para style="q" vid="PSA 59:3">ﭑ نَكِسِ قَشّتِيٍ مَ،<verse eid="PSA 59:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 59:4"/>بَرِ مَ عٍ وَ مَ ﭑ قَشَقٍ.</para>
  <para style="q" vid="PSA 59:4">سّنبّمَيٍ نَ عٍ مَلَنقٍ ﭑ شِلِ مَ،</para>
  <para style="q" vid="PSA 59:4">هَلِ ﭑ مُ قِندِ قٍ كٌبِ رَبَ رَ،</para>
  <para style="q" vid="PSA 59:4">هَلِ ﭑ مُ يُنُبِ يٌ رَبَ عَلَتَلَ رَ.<verse eid="PSA 59:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 59:5"/>هَلِ ﭑ مُ نَ قٍ حَاشِ رَبَقٍ،</para>
  <para style="q" vid="PSA 59:5">عٍ عٍ فِمَ ﭑ قْشْ رَ، عٍ شَ ﭑ فٍرٍ.</para>
  <para style="q" vid="PSA 59:5">كٍلِ، عِ قَ ﭑ مَلِ! يَندِ ﭑ مَ قٍ مَتٌ.<verse eid="PSA 59:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 59:6"/>عِسِرَيِلَ مَرِفِ عَلَتَلَ، مَنفّ عَلَ، كٍلِ،</para>
  <para style="q" vid="PSA 59:6">عِ شَ سِ دَنشَنِيَتَرٍيٍ رَتْن.</para>
  <para style="q" vid="PSA 59:6">عِ نَشَ دِحّ يِ يَنقَنتٍ تِنشِنتَرٍيٍ مَ. <char style="qs">حّنفِ رَتٍ.</char><verse eid="PSA 59:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 59:7"/>عٍ قَمَ كْي رَ عَلْ بَرٍ شَاحّيٍ عٍ قَ تَا رَبِلِن.<verse eid="PSA 59:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 59:8"/>عٍ دّ لُمَ عَلْ بَرٍ دّ شُنقّ مِنِمَ نَشَن كُي.</para>
  <para style="q" vid="PSA 59:8">عٍ شَ وْيّنيِ مِشِ تْورْ مَ عَلْ سَنتِدّفّمَ.</para>
  <para style="q" vid="PSA 59:8">عٍ نَشّ، «ندٍ نْمَ وٌن مَ وْيّنيِ مّدٍ؟»<verse eid="PSA 59:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 59:9"/>كْنْ عَلَتَلَ، عِ تَن نَن يٍلٍمَ عٍ مَ.</para>
  <para style="q" vid="PSA 59:9">عِ سِ دَنشَنِيَتَرٍيٍ بِرِن مَيٍلٍمَ.<verse eid="PSA 59:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 59:10"/>ﭑ نَن ﭑ يّتّ رَتَنفَمَ عٍ سّنبّ مَ عِ تَن نَن سَابُي رَ.</para>
  <para style="q" vid="PSA 59:10">عَلَ نَن نَ ﭑ مَ كَنتَمَ رَ.<verse eid="PSA 59:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 59:11"/>ﭑ مَرِفِ عَلَ، نَشَن شَ هِننّ فبٌ،</para>
  <para style="q" vid="PSA 59:11">عِ شَ تِ ﭑ يَ رَ،</para>
  <para style="q" vid="PSA 59:11">عِ شَ ﭑ يَشُييٍ رَبِرَ.<verse eid="PSA 59:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 59:12"/>ﭑ مَرِفِ، ﭑ مَ كَنتَمَ، عِ نَشَ عٍ قَشَ كٍرٍن نَ.</para>
  <para style="q" vid="PSA 59:12">عِ شَ عٍ رَبِرَ عَلَكٌ ﭑ مَ حَمَ نَشَ نّيمُ عِ سّنبّ مَ.<verse eid="PSA 59:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 59:13"/>عٍ يُنُبِ رَبَمَ عٍ شَ وْيّنيِيٍ رَ.</para>
  <para style="q" vid="PSA 59:13">عِ شَ عٍ سُشُ عٍ شَ يّتّ عِفبٌحَ كُي.</para>
  <para style="q" vid="PSA 59:13">عٍ دَنكّيٍ نُن وُلٍيٍ نَن تُن قَلَمَ.<verse eid="PSA 59:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 59:14"/>عِ شَ عٍ رَحْن عِ شَ شْنّ رَ، عَلَكٌ عٍ نَشَ تٌ سْنْن،</para>
  <para style="q" vid="PSA 59:14">عَلَكٌ عٍ شَ عَ كٌلٌن عَلَ نَن مَنفّ رَ</para>
  <para style="q" vid="PSA 59:14">يَشُبَ بْنسْي نُن دُنِحَ بِرِن شُن مَ. <char style="qs">حّنفِ رَتٍ.</char><verse eid="PSA 59:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PSA 59:15"/>عٍ قَمَ كْي رَ عَلْ بَرٍ شَاحّيٍ عٍ قَ تَا رَبِلِن.<verse eid="PSA 59:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 59:16"/>بَرٍيٍ دٌنسٍ قٍنمَ يِرٍ بِرِن كْي رَ،</para>
  <para style="q" vid="PSA 59:16">كْنْ عٍ مُ لُفَمَ.<verse eid="PSA 59:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 59:17"/>ﭑ عِ سّنبّ مَتْشْمَ بّيتِ رَ.</para>
  <para style="q" vid="PSA 59:17">ﭑ عِ شَ هِننّ مَتْشْمَ فّيسّفّ،</para>
  <para style="q" vid="PSA 59:17">بَرِ مَ ﭑ مَ كَنتَمَ نَن عِ رَ،</para>
  <para style="q" vid="PSA 59:17">عِ ﭑ كَنتَمَ ﭑ مَ تْورّ كُي.<verse eid="PSA 59:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 59:18"/>ﭑ مَ سّنبّمَ، ﭑ بّيتِ بَمَ عِ بّ.</para>
  <para style="q" vid="PSA 59:18">ﭑ مَرِفِ عَلَ نَن ﭑ كَنتَمَ رَ،</para>
  <para style="q" vid="PSA 59:18">ﭑ مَرِفِ عَلَ نَن ﭑ هِننّمَ ﭑ نَ.<verse eid="PSA 59:18"/></para>
  <chapter eid="PSA 59"/>
  <chapter number="60" style="c" sid="PSA 60"/>
  <para style="s1">عَلَ قَمَ شُننَكٍلِ رَ</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 60:1"/>دَوُدَ شَ لْننِ سُوكِ بّيتِبَيٍ شَ مَنفّ بّ. عَ شَ بَ عَلْ بّيتِ نَشَن شِلِ «قُفٍ تٌقَنيِ عَلْ عَلَ شَ سَاتّ.» <verse eid="PSA 60:1"/><verse number="2" style="v" sid="PSA 60:2"/>عِسِرَيِلَ تٌ سِرٍنِكَيٍ فٍرٍ، عٍ يِ بّيتِ بَ نَ تّمُي نّ. عٍ نُ كٍلِشِ مٍسٌثٌتَمِيَ نُن سٌبَ بْشِ مَ. يٌوَبَ نَشَ عٍدٌنكَ وُلُ قُ نُن قِرِن قَشَ قٌلٍ كُي قْشْي نَ دّننَشّ.<verse eid="PSA 60:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 60:3"/>عَلَ، عِ بَرَ مُشُ رَلْي،</para>
  <para style="q" vid="PSA 60:3">عِ بَرَ ندٍ بَ مُشُ شَ فَلِ رَ،</para>
  <para style="q" vid="PSA 60:3">عِ بَرَ شْنْ مُشُ مَ،</para>
  <para style="q" vid="PSA 60:3">كْنْ يَكْسِ، عِ شَ سّنبّ قِ مُشُ مَ.<verse eid="PSA 60:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 60:4"/>عِ بَرَ بْشِ رَ سّرّن،</para>
  <para style="q" vid="PSA 60:4">عِ بَرَ عَ عِبْو.</para>
  <para style="q" vid="PSA 60:4">عِ شَ نَ يَءِلَن مُشُ بّ</para>
  <para style="q" vid="PSA 60:4">بَرِ مَ بْشِ وَ مَ كَنَقٍ.<verse eid="PSA 60:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 60:5"/>عِ بَرَ قٍ شْرْشْييٍ دْشْ عِ شَ مِشِيٍ مَ،</para>
  <para style="q" vid="PSA 60:5">هَن عٍ بَرَ لُ عَلْ سِيسِلَ.<verse eid="PSA 60:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 60:6"/>كْنْ نَشٍيٍ فَاشُشِ عِ يَ رَ،</para>
  <para style="q" vid="PSA 60:6">عِ بَرَ تْنشُمَ سٌ عٍ يِ رَ،</para>
  <para style="q" vid="PSA 60:6">عٍ شَ نْ عٍ يَشُييٍ رَ.<verse eid="PSA 60:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 60:7"/>عِ شَ عِ شَنُنتٍنيِيٍ رَكِسِ عِ سّنبّ رَ،</para>
  <para style="q" vid="PSA 60:7">عِ شَ مُشُ شَ دُبّ سُشُ.<verse eid="PSA 60:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 60:8"/>عَلَ شَ مَسٍنيِ نَن يَ،</para>
  <para style="q" vid="PSA 60:8">عَ نَشَن قَلَشِ هْرْ مْبَنشِ سّنِيّنشِ كُي،</para>
  <para style="q" vid="PSA 60:8">«ﭑ سِكٍمِ تَا قِمَ نّ وٌ مَ شُننَكٍلِ كُي،</para>
  <para style="q" vid="PSA 60:8">ﭑ سُكْتِ فٍيَ لَنبَنيِ قَن قِ وٌ مَ.<verse eid="PSA 60:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 60:9"/>فَلَدِ بْشِ، ﭑ فبٍ. مَنَسِ بْشِ، ﭑ فبٍ.</para>
  <para style="q" vid="PSA 60:9">عٍقِرَ مِكَيٍ نَن قِندِ مَ ﭑ مَ فٍرٍ سٌي رَ.</para>
  <para style="q" vid="PSA 60:9">ﭑ مَنفّ دْشْمَ نّ يُدَيَ.<verse eid="PSA 60:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 60:10"/>مٌوَبَكَيٍ قِندِ مَ ﭑ مَ كٌنيِيٍ نَن نَ.</para>
  <para style="q" vid="PSA 60:10">عٍدٌن قِندِ ﭑ مَ بْشِ رَ.</para>
  <para style="q" vid="PSA 60:10">ﭑ فٍرٍ شُي رَتٍمَ نّ قِلِسِتَ.»<verse eid="PSA 60:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 60:11"/>عَلَ، ندٍ نْمَ ﭑ شَنِندٍ نَ تَا مَكَنتَشِ كُي؟</para>
  <para style="q" vid="PSA 60:11">ندٍ نْمَ ﭑ شَنِندٍ هَن عٍدٌن بْشِ مَ؟<verse eid="PSA 60:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 60:12"/>عِ تَن فبَنسَن، عِ تَن نَشَن مُشُ رَلْي،</para>
  <para style="q" vid="PSA 60:12">عِ تَن نَشَن مُ نُ نَ مُشُ شَ سْورِيٍ سّيتِ مَ.<verse eid="PSA 60:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 60:13"/>مُشُ مَلِ مُشُ يَشُييٍ فٍرٍدٍ.</para>
  <para style="q" vid="PSA 60:13">عَدَ مَدِ شَ مَلِ، سٍسٍ مُ عَ رَ،<verse eid="PSA 60:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 60:14"/>كْنْ عَلَ شَ مَلِ تَن قَمَ مُشُ يَشُي بِرِن هَلَكِدٍ.<verse eid="PSA 60:14"/></para>
  <chapter eid="PSA 60"/>
  <chapter number="61" style="c" sid="PSA 61"/>
  <para style="s1">كٍلِقٍ يِرٍ مَكُيٍ</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 61:1"/>دَوُدَ شَ بّيتِ بّيتِبَيٍ شَ مَنفّ بّ. عَ شَ بَ كْرَ شُي رَ.<verse eid="PSA 61:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 61:2"/>عَلَ، عِ تُلِ مَتِ ﭑ مَ مَشَندِ رَ.</para>
  <para style="q" vid="PSA 61:2">ﭑ مَ مَشَندِ رَ مّ.<verse eid="PSA 61:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 61:3"/>ﭑ عِ مَشَندِ مَ كٍلِقٍ رَ بْشِ مَكُيٍ.</para>
  <para style="q" vid="PSA 61:3">ﭑ بْحّ مُ سَشِ.</para>
  <para style="q" vid="PSA 61:3">ﭑ شَنِن فٍيَ قَرِ نَشَن عِتٍ دَنفِقٍ ﭑ نَ.<verse eid="PSA 61:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 61:4"/>عِ قِندِشِ ﭑ بّ يِرٍ نَن نَ</para>
  <para style="q" vid="PSA 61:4">ﭑ كَنتَشِ دّننَشّ ﭑ يَشُييٍ يَ عِ.<verse eid="PSA 61:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 61:5"/>ﭑ وَ مَ لُقٍ عِ شْنيِ تّمُي بِرِن.</para>
  <para style="q" vid="PSA 61:5">ﭑ وَ مَ لُقٍ عِ شَ كَنتَرِ كُي،</para>
  <para style="q" vid="PSA 61:5">عَلْ شْنِ يْرّ لُمَ عَ نفَ فَبُتٍنيِ بُن مَ كِ نَشّ.<verse eid="PSA 61:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 61:6"/>ﭑ مَرِفِ عَلَ، عِ بَرَ عِ تُلِ مَتِ ﭑ مَ مَشَندِ رَ.</para>
  <para style="q" vid="PSA 61:6">عِ بَرَ كّ قِ ﭑ مَ،</para>
  <para style="q" vid="PSA 61:6">نُن مِشِ بِرِن مَ نَشٍيٍ فَاشُشِ عِ شِلِ يَ رَ.<verse eid="PSA 61:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 61:7"/>مَنفّ شَ سِمَيَ شُنمَسَ،</para>
  <para style="q" vid="PSA 61:7">عَلَكٌ عَ شَ بُ عَ فبٍفبٍ رَ.<verse eid="PSA 61:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 61:8"/>عَ شَ مَنفّيَ شَ بُ عِ يَ عِ تّمُي بِرِن،</para>
  <para style="q" vid="PSA 61:8">عِ شَ هِننّ عَ رَ، عِ شَ قِندِ عَ دُفُتّفّ رَ.<verse eid="PSA 61:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 61:9"/>عِيٌ، ﭑ مُ تَفَنمَ بّيتِ بَقٍ رَ عِ شِلِ بِنيٍ بّ،</para>
  <para style="q" vid="PSA 61:9">بَرِ مَ عِ ﭑ مَ مَشَندِ يَابِمَ تّمُي بِرِن.<verse eid="PSA 61:9"/></para>
  <chapter eid="PSA 61"/>
  <chapter number="62" style="c" sid="PSA 62"/>
  <para style="s1">عَلَ شَ بْحّسَ</para>
  <para style="s2">عَلَ شَ سّرِيّ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 62:1"/>دَوُدَ شَ بّيتِ بّيتِبَيٍ شَ مَنفّ يٍدُتُن بّ<verse eid="PSA 62:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 62:2"/>ﭑ بْحّ سَشِ عَلَ نَن سَابُي رَ،</para>
  <para style="q" vid="PSA 62:2">ﭑ مَ كِسِ قَتَنشِ عَ تَن نَن نَ.<verse eid="PSA 62:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 62:3"/>عَ لُشِ ﭑ بّ عَلْ قَنيٍ،</para>
  <para style="q" vid="PSA 62:3">ﭑ مَ مَرَكِسِمَ نُن ﭑ مَكَنتَمَ نَن عَ رَ.</para>
  <para style="q" vid="PSA 62:3">ﭑ مُ نْمَ بِرَدٍ سْنْن.<verse eid="PSA 62:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 62:4"/>وٌ دُتُنمَ مِشِيٍ مَ هَن مُن تّمُي،</para>
  <para style="q" vid="PSA 62:4">وٌ شَ عٍ رَبِرَ، عَلْ بَنشِ نُن تّتّ قٌرِ؟<verse eid="PSA 62:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 62:5"/>عٍ وُلٍ قَلَمَ عَلَكٌ عٍ شَ مِشِيٍ بَ يِرٍ قَنيِ عٍ نُ دّننَشّ.</para>
  <para style="q" vid="PSA 62:5">عٍ دُبّ تِمَ عٍ دّ رَ، كْنْ عٍ دَنكّ تَن تِمَ عٍ بْحّ رَ. <char style="qs">حّنفِ رَتٍ.</char><verse eid="PSA 62:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 62:6"/>ﭑ بْحّسَ سْتْمَ عَلَ نَن نَ،</para>
  <para style="q" vid="PSA 62:6">بَرِ مَ ﭑ شَشِلِ تِشِ عَ تَن نَن نَ.<verse eid="PSA 62:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 62:7"/>عَ لُشِ عَلْ قَنيٍ نَ عَ رَ ﭑ بّ،</para>
  <para style="q" vid="PSA 62:7">ﭑ مَ مَرَكِسِمَ نُن ﭑ مَ مَكَنتَمَ نَن عَ رَ.</para>
  <para style="q" vid="PSA 62:7">ﭑ مُ نْمَ بِرَدٍ سْنْن.<verse eid="PSA 62:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 62:8"/>ﭑ مَ كِسِ نُن ﭑ مَ بِنيّ نَ عَلَ نَن يِ.</para>
  <para style="q" vid="PSA 62:8">عَلَ ﭑ مَكَنتَمَ نَن عَ رَ، ﭑ يِفِ تِدٍ نَن عَ رَ.<verse eid="PSA 62:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 62:9"/>حَمَ، وٌ شَ وٌ تَشُ عَ رَ،</para>
  <para style="q" vid="PSA 62:9">وٌ شَ وٌ شَ كْنتْقِلِ مَسٍن عَ بّ.</para>
  <para style="q" vid="PSA 62:9">عَ تَن نَن نْمَ وٌن مَلِدٍ. <char style="qs">حّنفِ رَتٍ.</char><verse eid="PSA 62:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 62:10"/>عَدَ مَدِيٍ لُمَ عَلْ قٌيٍ نَشَن دَنفِمَ.</para>
  <para style="q" vid="PSA 62:10">مِشِ شُنفبٍ قِندِ مَ مِشِ شُرِ رَ،</para>
  <para style="q" vid="PSA 62:10">شَ عٍ شَ قٍ بَرَ مَنِيَ، عَ يٍلٍبُ عَلْ قٌيٍ.<verse eid="PSA 62:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 62:11"/>وٌ نَشَ هَرِفٍ قٍن قٍ كٌبِ رَ،</para>
  <para style="q" vid="PSA 62:11">وٌ نَشَ عَ قٍن مُحّ رَ.</para>
  <para style="q" vid="PSA 62:11">شَ وٌ شَ نَاقُلِ سَ فبٌ،</para>
  <para style="q" vid="PSA 62:11">وٌ نَشَ وٌ شَشِلِ تِ نَ رَ.<verse eid="PSA 62:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 62:12"/>عَلَ بَرَ قٍ قِرِن قَلَ ﭑ نَشٍيٍ مّشِ.</para>
  <para style="q" vid="PSA 62:12">كٍرٍن، سّنبّ نَ عَلَ بّ.<verse eid="PSA 62:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 62:13"/>عَ قِرِن ندٍ، ﭑ مَرِفِ نَن هِننّنتٍ رَ،</para>
  <para style="q" vid="PSA 62:13">بَرِ مَ عَ مِشِيٍ سَرٍ رَفبِلٍنمَ عٍ مَ.<verse eid="PSA 62:13"/></para>
  <chapter eid="PSA 62"/>
  <chapter number="63" style="c" sid="PSA 63"/>
  <para style="s1">عَلَ شَ هِننّ قَن سِمَيَ بّ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 63:1"/>دَوُدَ شَ بّيتِ، عَ نَشَن بَ يُدَيَ، عَ تٌ نُ فبٍنفبٍرٍنيِ مَ تّمُي نَشّ<verse eid="PSA 63:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 63:2"/>عَلَ نَن ﭑ مَرِفِ رَ.</para>
  <para style="q" vid="PSA 63:2">عَلَ ﭑ عِ قٍنمَ، بَرِ مَ ﭑ هَيِ نَ عِ مَ،</para>
  <para style="q" vid="PSA 63:2">عَلْ قَتٍ هَيِ تٌ نَ يٍ مَ فبٍنفبٍرٍنيِ مَ.<verse eid="PSA 63:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 63:3"/>ﭑ لُمَ عِ شَ هْرْ مْبَنشِ كُي</para>
  <para style="q" vid="PSA 63:3">عَلَكٌ ﭑ شَ عِ سّنبّ نُن عِ شَ بِنيّ تٌ.<verse eid="PSA 63:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 63:4"/>عِ شَ هِننّ قَن سِمَيَ بّ.</para>
  <para style="q" vid="PSA 63:4">ﭑ بَرَ عِ مَتْشْ.<verse eid="PSA 63:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 63:5"/>ﭑ عِ تَنتُمَ ﭑ مَ سِمَيَ بِرِن كُي،</para>
  <para style="q" vid="PSA 63:5">ﭑ نَن ﭑ بّلّشّيٍ عِتٍمَ عِ مَبِرِ.<verse eid="PSA 63:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 63:6"/>ﭑ بْنسْي وَ سَمَ نّ عِ تَنتُقٍ رَ سّيوّ كُي.<verse eid="PSA 63:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 63:7"/>ﭑ نَ ﭑ سَ ﭑ عِ شَ قٍ مَحْشُنمَ كْي بِرِن،<verse eid="PSA 63:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 63:8"/>بَرِ مَ عِ تَن نَن ﭑ مَلِمَ.</para>
  <para style="q" vid="PSA 63:8">ﭑ سّيوَ مَ نّ عِ نِينِ بُن مَ.<verse eid="PSA 63:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 63:9"/>ﭑ نِي بَرَ قَتُ عِ مَ، عِ بّلّشّ لُمَ نّ ﭑ بُن مَ.<verse eid="PSA 63:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 63:10"/>نَشٍيٍ كَتَمَ ﭑ قَشَدٍ، عٍ تَن نَن قَشَمَ.<verse eid="PSA 63:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 63:11"/>سَنتِدّفّمَ قَمَ نّ عٍ سْشْدٍ،</para>
  <para style="q" vid="PSA 63:11">وُلَءِ بَرٍيٍ قَ عٍ عِبْودٍ.<verse eid="PSA 63:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 63:12"/>مَنفّ سّيوَ مَ نّ عَلَ شَ قٍ رَ.</para>
  <para style="q" vid="PSA 63:12">نَشٍيٍ عٍ كَلِمَ عَلَ شِلِ رَ، نٍيٍ قَمَ نّ عَ مَتْشْدٍ.</para>
  <para style="q" vid="PSA 63:12">كْنْ وُلٍ قَلّيٍ دّيٍ بَلَنمَ نّ.<verse eid="PSA 63:12"/></para>
  <chapter eid="PSA 63"/>
  <chapter number="64" style="c" sid="PSA 64"/>
  <para style="s1">عَدَ مَ شَ مَحْشُنيِ تِلِن</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 64:1"/>دَوُدَ شَ بّيتِ بّيتِبَيٍ شَ مَنفّ بّ<verse eid="PSA 64:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 64:2"/>عَلَ، عِ تُلِ مَتِ ﭑ وَ شُي رَ،</para>
  <para style="q" vid="PSA 64:2">ﭑ نَتَنفَ ﭑ يَشُييٍ مَ.<verse eid="PSA 64:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 64:3"/>ﭑ نْشُن مِشِ حَاشِيٍ مَ</para>
  <para style="q" vid="PSA 64:3">نَشٍيٍ وَ مَ ﭑ تْورْقٍ تِنشِنتَرٍيَ كُي.<verse eid="PSA 64:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 64:4"/>عٍ دّ شَاحّ عَلْ سَنتِدّفّمَ،</para>
  <para style="q" vid="PSA 64:4">عٍ شَ وْيّن حَاشِيٍ لُمَ عَلْ تَنبّيٍ.<verse eid="PSA 64:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 64:5"/>عٍ مُ فَاشُمَ تِنشِنتْي يَ رَ،</para>
  <para style="q" vid="PSA 64:5">عٍ لُمَ عَ حَشَنكَتَ رَ تُن.<verse eid="PSA 64:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 64:6"/>عٍ دّ كٌبِ، عٍ يّلّ عِتَلَمَ مِشِ يَ رَ.</para>
  <para style="q" vid="PSA 64:6">عٍ نَشّ، «ندٍ نَ كٌلٌنمَ؟»<verse eid="PSA 64:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 64:7"/>عٍ يَنقَنتٍيَ يَءِلَنمَ، عٍ عَ قَلَ،</para>
  <para style="q" vid="PSA 64:7">«وٌن شَ كٍلِ عَ يَنقَ شِلِ مَ. عَ سْونّيَمَ نّ.»</para>
  <para style="q" vid="PSA 64:7">عَدَ مَ شَ مَحْشُنيِ تِلِن.<verse eid="PSA 64:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 64:8"/>كْنْ عَلَ نَ تَنبّيٍ وٌلِ، عٍ عٍ لِمَ نّ كٍرٍن نَ.<verse eid="PSA 64:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 64:9"/>عٍ بَرَ وُلٍ قَلَ.</para>
  <para style="q" vid="PSA 64:9">نَشٍيٍ عٍ تٌمَ، عٍ عٍ فِمَ نّ.<verse eid="PSA 64:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 64:10"/>نَ فَاشُي عَدَ مَ بِرِن سُشُمَ نّ.</para>
  <para style="q" vid="PSA 64:10">عٍ عَلَ شَ وَلِ مَسٍنمَ،</para>
  <para style="q" vid="PSA 64:10">عٍ عَ شَ وَلِ كٌلٌنمَ نّ.<verse eid="PSA 64:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 64:11"/>تِنشِنتْي سّيوَ مَ نّ عَلَتَلَ رَ،</para>
  <para style="q" vid="PSA 64:11">عَ قَ لُ عَ نِينِ بُن مَ.</para>
  <para style="q" vid="PSA 64:11">سٌندٌن قَنيِ كَنيِ حّلّشِنمَ نّ.<verse eid="PSA 64:11"/></para>
  <chapter eid="PSA 64"/>
  <chapter number="65" style="c" sid="PSA 65"/>
  <para style="s1">سَابُي قَنيِ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 65:1"/>دَوُدَ شَ بّيتِ بّيتِبَيٍ شَ مَنفّ بّ<verse eid="PSA 65:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 65:2"/>مَتْشْي نَ عِ تَن عَلَ بّ سِيٌنِ فٍيَ قَرِ.</para>
  <para style="q" vid="PSA 65:2">مُشُ لَايِدِ نَشَن تٌنفٌشِ عِ بّ،</para>
  <para style="q" vid="PSA 65:2">مُشُ نَ بِرِن نَكَمَلِمَ نّ.<verse eid="PSA 65:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 65:3"/>عَلَ، عِ مُشُ شَ مَشَندِ بِرِن مّمَ نّ.</para>
  <para style="q" vid="PSA 65:3">دُنِحَ بِرِن قَمَ نّ بِرَدٍ عِ قْشْ رَ.<verse eid="PSA 65:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 65:4"/>تَنتَنيِ تٌ نْ مُشُ رَ، عِ بَرَ مُشُ شَ يُنُبِ شَقَرِ.<verse eid="PSA 65:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 65:5"/>عِ نَشَن سُفَندِ مَ عَ شَ مَكْرّ عِ شَ سَلِدٍ رَ،</para>
  <para style="q" vid="PSA 65:5">نَ حّلّشِنمَ نّ بَرِ مَ عَ بُمَ نّ عِ شْنيِ.</para>
  <para style="q" vid="PSA 65:5">مُشُ بَرَ وَ سَ عِ شَ قٍ قَنيِ رَ،</para>
  <para style="q" vid="PSA 65:5">قٍ سّنِيّنشِ نَشَن كٍلِشِ عِ شَ هْرْ مْلِنفِرَ.<verse eid="PSA 65:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 65:6"/>عِ مُشُ شَ مَشَندِ يَابِمَ كَابَنَكٌ نُن تِنشِنيِ رَ.</para>
  <para style="q" vid="PSA 65:6">عَلَ، عِ بَرَ قِندِ مُشُ رَكِسِمَ رَ.</para>
  <para style="q" vid="PSA 65:6">دُنِحَ يِرٍ بِرِن شَشِلِ تِشِ عِ رَ.<verse eid="PSA 65:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 65:7"/>عِ بَرَ فٍيَ دَا عِ سّنبّ رَ</para>
  <para style="q" vid="PSA 65:7">بَرِ مَ سّنبّمَ نَن عِ رَ.<verse eid="PSA 65:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 65:8"/>عِ بَرَ بَا شُي رَدُندُ، مْرْنيِ شُي مُ نَ.</para>
  <para style="q" vid="PSA 65:8">عِ بَرَ حَمَ قَن مَسَبَرِ.<verse eid="PSA 65:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 65:9"/>دُنِحَ بِرِن فَاشُمَ نّ عِ شَ كَابَنَكٌي يَ رَ.</para>
  <para style="q" vid="PSA 65:9">كٍلِقٍ سٌفٍتٍدٍ هَن سٌفٍفٌرٌدٍ،</para>
  <para style="q" vid="PSA 65:9">عٍ بِرِن عٍ حّلّشِن شُي رَ مِنِمَ نّ عِ شَ قٍ رَ.<verse eid="PSA 65:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 65:10"/>عِ بْشِ مّينِ، عَ عَ رَقٍ قٍ قَنيِ رَ.</para>
  <para style="q" vid="PSA 65:10">عِ شُرٍ رَقٍمَ يٍ رَ عَلَكٌ مِشِيٍ شَ بَلٌي سْتْ.<verse eid="PSA 65:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 65:11"/>عِ تُنّ يٍ سَمَ بْشِ مَ عَلَكٌ بْشِ شَ بْرْشْ سَنسِ بّ.</para>
  <para style="q" vid="PSA 65:11">عِ بَرَكّ سَمَ شّ مَ، عَ شَ قَن.<verse eid="PSA 65:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 65:12"/>شّ شَبَ تّمُي عِ قٍ قَنيِ رَ مِنِمَ نّ.</para>
  <para style="q" vid="PSA 65:12">عِ شَ سَنسِ سَسٍ رَقٍمَ نّ، هَن عَ قِلِ عَ مَ.<verse eid="PSA 65:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 65:13"/>فبٍنفبٍرٍنيِ قِيلِيٍ نُن فٍيَيٍ قَنمَ نّ.<verse eid="PSA 65:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 65:14"/>شُرُ سٍيٍ يِرِوَ مَ نّ قِيلِ مَ.</para>
  <para style="q" vid="PSA 65:14">سَنسِ يِرِوَ مَ نّ فٍيَ بُنيِيٍ.</para>
  <para style="q" vid="PSA 65:14">نَ بِرِن، عَلَ شَ قٍ قَنيِ نَن مَسٍنمَ وٌن بّ سّيوّ كُي.<verse eid="PSA 65:14"/></para>
  <chapter eid="PSA 65"/>
  <chapter number="66" style="c" sid="PSA 66"/>
  <para style="s1">عَلَ شَ كَابَنَكٌي مَفَاشُ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="d">بّيتِ نُن سُوكِ بّيتِبَيٍ شَ مَنفّ بّ</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 66:1"/>عَدَ مَدِيٍ بِرِن شُي شَ عِتٍ سّيوّ رَ عَلَ بّ.<verse eid="PSA 66:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 66:2"/>وٌ شَ عَ شِلِ بِنيَ بّيتِ رَ،</para>
  <para style="q" vid="PSA 66:2">وٌ شَ عَ بِنيَ مَتْشْي رَ.<verse eid="PSA 66:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 66:3"/>وٌ شَ عَ قَلَ عَلَ بّ،</para>
  <para style="q" vid="PSA 66:3">«عِ شَ كَابَنَكٌي مَفَاشُ.</para>
  <para style="q" vid="PSA 66:3">عِ سّنبّ فبٌ هَن. هَلِ عِ يَشُييٍ سّرّنمَ عِ يَ رَ.<verse eid="PSA 66:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 66:4"/>دُنِحَ بِرِن عِ بَتُمَ،</para>
  <para style="q" vid="PSA 66:4">عٍ عِ بِنيَ بّيتِ رَ، عٍ عِ شِلِ مَتْشْ.» <char style="qs">حّنفِ رَتٍ.</char><verse eid="PSA 66:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 66:5"/>وٌ قَ عَلَ شَ وَلِ مَتٌدٍ.</para>
  <para style="q" vid="PSA 66:5">عَ نَ قٍ رَبَ عَدَ مَدِيٍ تَفِ، نَ مَفَاشُ.<verse eid="PSA 66:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 66:6"/>عَ بَا قِندِ شَرٍ رَ،</para>
  <para style="q" vid="PSA 66:6">عَ مِشِ رَفِرِ شُرٍ مَ عٍ سَنيِ شَرَشِ رَ.</para>
  <para style="q" vid="PSA 66:6">نَ كُي، وٌن حّلّشِنمَ نّ عَ رَ.<verse eid="PSA 66:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 66:7"/>عَ دُنِحَ يَمَرِ مَ سّنبّ رَ عَبَدَن.</para>
  <para style="q" vid="PSA 66:7">عَ يَ تِشِ سِيٍ رَ، مَتَندِلَيٍ مُ نْمَ كٍلِدٍ سْنْن. <char style="qs">حّنفِ رَتٍ.</char><verse eid="PSA 66:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 66:8"/>سِيٍ، وٌ شَ وٌن مَرِفِ عَلَ تَنتُ،</para>
  <para style="q" vid="PSA 66:8">وٌ شَ وٌ شُي رَ مِنِ عَ مَتْشْقٍ رَ.<verse eid="PSA 66:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 66:9"/>عَ بَرَ سِمَيَ قِ وٌن مَ،</para>
  <para style="q" vid="PSA 66:9">عَ مُ تِن وٌن شَ بِرَ،<verse eid="PSA 66:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 66:10"/>بَرِ مَ عَلَ وٌن بْحّ كٌلٌن.</para>
  <para style="q" vid="PSA 66:10">عَ بَرَ وٌن مَتٌ عَلْ مِشِ فبٍتِ مَتٌمَ كِ نَشّ</para>
  <para style="q" vid="PSA 66:10">عَ عَ رَشُنُ عَلَكٌ عَ فبِ شَ بَ.<verse eid="PSA 66:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 66:11"/>عِ بَرَ مُشُ شُن تِ يّلّ كُي رَ،</para>
  <para style="q" vid="PSA 66:11">عِ مَن بَرَ كٌتٍ دْشْ مُشُ شُن مَ.<verse eid="PSA 66:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 66:12"/>عِ بَرَ عَ لُ مِشِيٍ شَ نْ مُشُ رَ،</para>
  <para style="q" vid="PSA 66:12">مُشُ شَ تْورْ يٍ نُن تّ شْورَ.</para>
  <para style="q" vid="PSA 66:12">كْنْ عَ رَحْنيِ، عِ بَرَ مُشُ شُن تِ دَشَمُي يِرٍ رَ.<verse eid="PSA 66:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 66:13"/>ﭑ قَمَ سّرّشّ فَن دَاشِ رَ عِ شَ بَنشِ كُي،</para>
  <para style="q" vid="PSA 66:13">ﭑ نَن ﭑ مَ لَايِدِ رَكَمَلِمَ نّ،<verse eid="PSA 66:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 66:14"/>ﭑ نَشٍيٍ قَلَ ﭑ دّ رَ ﭑ نُ تْورّ كُي تّمُي نَشّ.<verse eid="PSA 66:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 66:15"/>ﭑ شُرُ سٍ تُرَشِيٍ بَمَ نّ سّرّشّ فَن دَاشِ رَ،</para>
  <para style="q" vid="PSA 66:15">عَلْ يّشّي كٌنتٌنيِيٍ، تُورَيٍ، نُن سِ دٌنبِيٍ. <char style="qs">حّنفِ رَتٍ.</char><verse eid="PSA 66:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 66:16"/>وٌ قَ، وٌ شَ وٌ تُلِ مَتِ،</para>
  <para style="q" vid="PSA 66:16">وٌ تَن نَشٍيٍ فَاشُمَ عَلَ يَ رَ.</para>
  <para style="q" vid="PSA 66:16">ﭑ شَ عَ مَسٍن عَلَ نَشَن نَبَشِ ﭑ بّ.<verse eid="PSA 66:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 66:17"/>ﭑ بَرَ عَ شِلِ، ﭑ بَرَ عَ مَتْشْ.<verse eid="PSA 66:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 66:18"/>شَ يَنقَنتٍيَ نُ نَ ﭑ بْحّ كُي نُ،</para>
  <para style="q" vid="PSA 66:18">ﭑ مَرِفِ مُ نُ عَ تُلِ مَتِمَ ﭑ نَ.<verse eid="PSA 66:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 66:19"/>كْنْ عَلَ بَرَ ﭑ شُي رَ مّ،</para>
  <para style="q" vid="PSA 66:19">عَ ﭑ مَ دُبّ سُشُ.<verse eid="PSA 66:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 66:20"/>تَنتُي نَ عَلَ بّ نَشَن بَرَ ﭑ مَ مَشَندِ شُي مّ،</para>
  <para style="q" vid="PSA 66:20">عَ مَن بَرَ هِننّ ﭑ نَ.<verse eid="PSA 66:20"/></para>
  <chapter eid="PSA 66"/>
  <chapter number="67" style="c" sid="PSA 67"/>
  <para style="s1">سِ بِرِن شَ عَلَ شَ مَرَكِسِ كٌلٌن</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 67:1"/>بّيتِ نُن سُوكِ بّيتِبَيٍ شَ مَنفّ بّ. عَ شَ بَ كْرَ شُي رَ.<verse eid="PSA 67:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 67:2"/>عَلَ شَ هِننّ وٌن نَ،</para>
  <para style="q" vid="PSA 67:2">عَلَ شَ بَرَكّ رَفٌرٌ وٌن مَ،</para>
  <para style="q" vid="PSA 67:2">عَلَ شَ نَءِيَلَنيِ شَ يَنبَ وٌن مَ، <char style="qs">حّنفِ رَتٍ</char><verse eid="PSA 67:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 67:3"/>عَلَكٌ عَ شَ كِرَيٍ شَ كٌلٌن دُنِحَ مَ،</para>
  <para style="q" vid="PSA 67:3">عَلَكٌ سِ بِرِن شَ عَ شَ مَرَكِسِ كٌلٌن.<verse eid="PSA 67:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 67:4"/>عَلَ، سِيٍ شَ عِ تَنتُ، سِ بِرِن شَ عِ تَنتُ.<verse eid="PSA 67:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 67:5"/>عٍ شَ بّيتِ بَ حّلّشِنيِ كُي،</para>
  <para style="q" vid="PSA 67:5">بَرِ مَ عِ سِيٍ مَكِيتِمَ نْندِ رَ،</para>
  <para style="q" vid="PSA 67:5">عِ تَن نَن عٍ رَحّرّ مَ يِ دُنِحَ بّندّ قُحِ قَرِ. <char style="qs">حّنفِ رَتٍ.</char><verse eid="PSA 67:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 67:6"/>عَلَ، سِيٍ شَ عِ تَنتُ،</para>
  <para style="q" vid="PSA 67:6">سِ بِرِن شَ عِ تَنتُ.<verse eid="PSA 67:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 67:7"/>بْشِ بَرَ دَشَمُي رَ مِنِ وٌن بّ،</para>
  <para style="q" vid="PSA 67:7">تَنتُي نَ وٌن مَرِفِ عَلَ بّ.<verse eid="PSA 67:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 67:8"/>عَلَ شَ بَرَكّ سَ وٌن مَ،</para>
  <para style="q" vid="PSA 67:8">دُنِحَ بِرِن شَ فَاشُ عَ يَ رَ.<verse eid="PSA 67:8"/></para>
  <chapter eid="PSA 67"/>
  <chapter number="68" style="c" sid="PSA 68"/>
  <para style="s1">عَلَ نَن دُنِحَ مَنفّ رَ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 68:1"/>دَوُدَ شَ بّيتِ بّيتِبَيٍ شَ مَنفّ بّ<verse eid="PSA 68:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 68:2"/>عَلَ شَ كٍلِ، عَ يَشُييٍ شَ يٍنسٍن يّ.</para>
  <para style="q" vid="PSA 68:2">نَشٍيٍ عَ شْنمَ، عٍ شَ عٍ فِ عَ يَ رَ.<verse eid="PSA 68:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 68:3"/>عِ عِ يَشُييٍ رَلْيمَ نّ</para>
  <para style="q" vid="PSA 68:3">عَلْ قٌيٍ تّ تُورِ رَلْيمَ كِ نَشّ.</para>
  <para style="q" vid="PSA 68:3">كَاقِرِ لْيمَ نّ عَلَ يَ عِ،</para>
  <para style="q" vid="PSA 68:3">عَلْ تُرٍ شُنُمَ تّ عِ كِ نَشّ.<verse eid="PSA 68:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 68:4"/>كْنْ مِشِ تِنشِنشِ حّلّشِنمَ نّ،</para>
  <para style="q" vid="PSA 68:4">عٍ عٍ سّيوّ شُي عِتٍمَ نّ عَلَ يَ عِ.</para>
  <para style="q" vid="PSA 68:4">عٍ تَن لُمَ نَ حّلّشِنيِ نَن كُي.<verse eid="PSA 68:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 68:5"/>وٌن شَ بّيتِ بَ عَلَ بّ، وٌن شَ عَ شِلِ مَتْشْ بّيتِ رَ.</para>
  <para style="q" vid="PSA 68:5">نَشَن حّرّ مَ نُشُي قَرِ، وٌن شَ عَ رَ سّنّ.</para>
  <para style="q" vid="PSA 68:5">عَ شِلِ عَلَتَلَ.</para>
  <para style="q" vid="PSA 68:5">وٌن شَ وٌن سّيوّ شُي رَتٍ عَ مَ.<verse eid="PSA 68:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 68:6"/>عَلَ، مِسِكِينّ بَبَ نَن عَ رَ.</para>
  <para style="q" vid="PSA 68:6">عَلَ، كَاحّ مَكَنتّ نَن عَ رَ.</para>
  <para style="q" vid="PSA 68:6">عَلَ شْنيِ سّنِيّن.<verse eid="PSA 68:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 68:7"/>عَلَ دٍنبَيَ قِمَ دٍنبَيَتَرٍ مَ،</para>
  <para style="q" vid="PSA 68:7">عَلَ شْرّيَ قِمَ فٍيلِمَنِيٍ مَ، عٍ حّلّشِنمَ نّ.</para>
  <para style="q" vid="PSA 68:7">كْنْ عَلَ مَتَندِيٍ لُمَ نّ فبٍنفبٍرٍنيِ مَ.<verse eid="PSA 68:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 68:8"/>عَلَ، عِ نُ نَ عِ شَ حَمَ يَ رَ وُلَ عِ تّمُي نَشّ،<verse eid="PSA 68:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 68:9"/>بْشِ بِرِن نُ سّرّنمَ نّ.</para>
  <para style="q" vid="PSA 68:9">تُنّ يٍ نُ فٌرٌ مَ عَلَ يَ عِ،</para>
  <para style="q" vid="PSA 68:9">عِسِرَيِلَ مَرِفِ عَلَ، نَشَن نَ سِيٌنِ.<verse eid="PSA 68:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 68:10"/>عَلَ نُ تُنّ يٍ رَفٌرٌ مَ بْشِ مَ،</para>
  <para style="q" vid="PSA 68:10">عَ شَ سّنبّ قِ عَ شَ بْشِ تَفَنشِ مَ.<verse eid="PSA 68:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 68:11"/>عِ بَرَ عِ شَ حَمَ رَ سَبَتِ نَا.</para>
  <para style="q" vid="PSA 68:11">عِ بَرَ تْورْ مِشِ مَلِ نَا.</para>
  <para style="q" vid="PSA 68:11">عِ نَ بِرِن نَبَشِ نّ بَرِ مَ عِ قَن.<verse eid="PSA 68:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 68:12"/>مَرِفِ مَسٍنيِ قَنيِ سٌمَ عَ شَ شّيرَيٍ يِ رَ.</para>
  <para style="q" vid="PSA 68:12">فَلِ بٍلٍبٍلٍ نَن عٍ رَ. عٍ نَشّ،<verse eid="PSA 68:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 68:13"/>«فٍرٍ سٌي مَنفّيٍ نَ عٍ فِقٍ،</para>
  <para style="q" vid="PSA 68:13">عٍ نَ عٍ فِقٍ وٌ يَ رَ.</para>
  <para style="q" vid="PSA 68:13">وٌ شَ فِنّيٍ نَشٍيٍ لُشِ بَنشِ،</para>
  <para style="q" vid="PSA 68:13">عٍ قَمَ يِ فٍرٍ نَاقُلِ عِتَشُندٍ.<verse eid="PSA 68:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 68:14"/>وٌ قَمَ وٌ مَلَبُدٍ وٌ شَ شُرُ سٍيٍ قّ مَ.</para>
  <para style="q" vid="PSA 68:14">عَلَ مّينِمَ نّ عَ شَ حَمَ مَ</para>
  <para style="q" vid="PSA 68:14">عَلْ عَ مّينِمَ فَنبّيٍ مَ كِ نَشّ.</para>
  <para style="q" vid="PSA 68:14">عٍ فَبُتٍنيِ لُمَ عَلْ فبٍتِ نُن شّيمَ نَن نَ عٍ مَ.»<verse eid="PSA 68:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 68:15"/>عَلَ شِلِ شُنفبٍ كَنيِ بَرَ مَنفّيٍ رَيٍنسٍن</para>
  <para style="q" vid="PSA 68:15">سَلَمٌن فٍيَ مَ بَلَبَلَنيِ سَابُي رَ.<verse eid="PSA 68:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 68:16"/>بَسَن فٍيَ، عَلَ نَشَن دَاشِ، كٌندٍ وُيَشِ نَشَن بّ،<verse eid="PSA 68:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 68:17"/>وٌ نَ عَلَ شَ فٍيَ سُفَندِشِ مَتٌقٍ تْونّ رَ مُنقٍ رَ،</para>
  <para style="q" vid="PSA 68:17">عَ بَرَ عَ شَ هْرْ مْلِنفِرَ تِ دّننَشّ؟</para>
  <para style="q" vid="PSA 68:17">عَلَ لُمَ نّ مّننِ تّمُي بِرِن.<verse eid="PSA 68:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 68:18"/>عَلَتَلَ شَ فٍرٍ سٌي شَ فِسٍيٍ وُيَ دَنفِ وُلُ قُ رَ.</para>
  <para style="q" vid="PSA 68:18">عَ شَ فٍرٍ سٌي قَن دَنفِ وُلُ وُلُيٍ رَ.</para>
  <para style="q" vid="PSA 68:18">عَلَ نَ عٍ يَ مَ.</para>
  <para style="q" vid="PSA 68:18">سِنَيِ فٍيَ نَ يِرٍ سّنِيّنشِ كُي.<verse eid="PSA 68:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 68:19"/>ﭑ مَرِفِ عَلَتَلَ، عِ بَرَ تٍ كٌورٍ مَ.</para>
  <para style="q" vid="PSA 68:19">عِ بَرَ فٍيلِمَنِيٍ شَنِن.</para>
  <para style="q" vid="PSA 68:19">عَدَ مَدِيٍ بَرَ عِ بُحَ،</para>
  <para style="q" vid="PSA 68:19">مَتَندِلَيٍ قَن بَرَ وَ سٌقٍ عِ شْنيِ.<verse eid="PSA 68:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 68:20"/>تَنتُي نَ عِ بّ لْشْي بِرِن،</para>
  <para style="q" vid="PSA 68:20">عَ وٌن مَ كٌتٍ شَنِنقٍ لْشْ يٌ لْشْ.</para>
  <para style="q" vid="PSA 68:20">وٌن مَ مَرَكِسِمَ نَ عَلَ نَن نَ.<verse eid="PSA 68:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 68:21"/>وٌن مَرِفِ عَلَتَلَ وٌن نَكٍلِمَ نّ قَشّ مَ.</para>
  <para style="q" vid="PSA 68:21">وٌن مَ مَرَكِسِمَ نَ عَلَ نَن نَ.<verse eid="PSA 68:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 68:22"/>عَلَ عَ يَشُييٍ شُنيِ كَنَمَ نّ.</para>
  <para style="q" vid="PSA 68:22">نَشٍيٍ حّرّ كِرَ حَاشِ شْن مَ،</para>
  <para style="q" vid="PSA 68:22">عَ نٍيٍ قَن شُن شْرِ بْو مَ نّ.<verse eid="PSA 68:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 68:23"/>مَرِفِ نَشّ، «ﭑ قَمَ نّ عٍ رَ كٍلِقٍ بَسَن،</para>
  <para style="q" vid="PSA 68:23">ﭑ قَ عٍ رَ كٍلِقٍ بَا مَ،<verse eid="PSA 68:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 68:24"/>عَلَكٌ وٌ شَ قَ عٍ وُلِ تٌ وٌ سَنلَابٍ رَ.</para>
  <para style="q" vid="PSA 68:24">وٌ شَ بَرٍيٍ قَن عٍ دٌنمَ نّ.»<verse eid="PSA 68:24"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="25" style="v" sid="PSA 68:25"/>عَلَ، مُشُ بَرَ عِ تٌ قَ رَ حَمَ يَ مَ.</para>
  <para style="q" vid="PSA 68:25">عَلَ نُن عَ شَ مَنفّ سُفَندِشِ نَ سٌقٍ هْرْ مْلِنفِرَ كُي.<verse eid="PSA 68:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 68:26"/>بّيتِبَيٍ نَ يَرٍ، كْرَ بْنبْييٍ نَ عٍ قْشْ رَ،</para>
  <para style="q" vid="PSA 68:26">فِنّيٍ نَ مَشَسٍ رَ مَشَقٍ عٍ رَبِلِنيِ.<verse eid="PSA 68:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 68:27"/>وٌ شَ عَلَ تَنتُ مَلَنيِيٍ،</para>
  <para style="q" vid="PSA 68:27">عِسِرَيِلَ شَ دِيٍ، وٌ شَ عَلَتَلَ تَنتُ.<verse eid="PSA 68:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 68:28"/>بُنيَمِن نَن يَ،</para>
  <para style="q" vid="PSA 68:28">نَشَن بَرِشِ دْنشْي رَ.</para>
  <para style="q" vid="PSA 68:28">عَ تَن نَن قِندِشِ عٍ شَ مَنفّ رَ.</para>
  <para style="q" vid="PSA 68:28">يُدَيَ مَنفّيٍ نَن يَ، عٍ نُن عٍ شَ مِشِيٍ.</para>
  <para style="q" vid="PSA 68:28">سَبُلٌن مَنفّيٍ نَن يَ،</para>
  <para style="q" vid="PSA 68:28">نَقَتَلِ مَنفّيٍ نَن يَ.<verse eid="PSA 68:28"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="29" style="v" sid="PSA 68:29"/>عَلَ، عِ شَ مَسٍنيِ تِ سّنبّ رَ.</para>
  <para style="q" vid="PSA 68:29">عِ شَ عِ سّنبّ مَسٍن عَلْ تّمُي دَنفِشِ.<verse eid="PSA 68:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 68:30"/>عِ شَ بَنشِ نَ دَرِ سَلَمُ.</para>
  <para style="q" vid="PSA 68:30">مَنفّيٍ قَمَ عِ بُحَدٍ نَا.<verse eid="PSA 68:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 68:31"/>عِ شَ شَاحّ مِسِرَ مَ،</para>
  <para style="q" vid="PSA 68:31">نَشَن مَنِيّ مَلِ شُنفبٍ رَ نَشَن نَ يٍ شْورَ.</para>
  <para style="q" vid="PSA 68:31">عَ لُمَ عَلْ تُورَ فَلِ، نِنفٍ يْرّيٍ بِرَشِ نَشٍيٍ قْشْ رَ.</para>
  <para style="q" vid="PSA 68:31">نَ نِنفٍ يْرّيٍ لُمَ عَلْ سِ فبّتّيٍ</para>
  <para style="q" vid="PSA 68:31">نَشٍيٍ دُوتِ قِمَ مِسِرَ مَ.</para>
  <para style="q" vid="PSA 68:31">سِ فبّتّيٍ نَشٍيٍ وَ مَ فٍرٍ شْن، عِ شَ عٍ رَيٍنسٍن يّ.<verse eid="PSA 68:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 68:32"/>مِسِرَ شّيرَيٍ، عَ نُن كُسِ شّيرَيٍ، شَ قَ دُوتِ رَ عَلَ بّ.<verse eid="PSA 68:32"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="33" style="v" sid="PSA 68:33"/>مَنفّ نَشٍيٍ بِرِن نَ دُنِحَ، نُن عَ رَبِلِنيِ،</para>
  <para style="q" vid="PSA 68:33">وٌ شَ بّيتِ بَ عَلَ بّ، وٌ شَ عَلَتَلَ تَنتُ،<verse eid="PSA 68:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 68:34"/>نَشَن حّرّ مَ نُشُي قَرِ كٌورٍ مَ كَبِ عَ رَكُيَ،</para>
  <para style="q" vid="PSA 68:34">نَشَن فَلَنيِ شُي رَ مِنِمَ سّنبّ رَ.<verse eid="PSA 68:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 68:35"/>وٌ شَ عَ كٌلٌن، عَلَ سّنبّ فبٌ.</para>
  <para style="q" vid="PSA 68:35">عَ عِسِرَيِلَ يَمَرِ مَ عَ سّنبّ رَ،</para>
  <para style="q" vid="PSA 68:35">سّنبّ نَشَن كٍلِمَ كٌورٍ مَ.<verse eid="PSA 68:35"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="36" style="v" sid="PSA 68:36"/>عَلَ، عِ نَ عِ شَ هْرْ مْلِنفِرَ كُي.</para>
  <para style="q" vid="PSA 68:36">عَلَ، عِ مَفَاشُ.</para>
  <para style="q" vid="PSA 68:36">عِسِرَيِلَ مَرِفِ عَلَ سّنبّ قِمَ نّ عَ شَ حَمَ مَ.</para>
  <para style="q" vid="PSA 68:36">عَلَ تَنتُ!<verse eid="PSA 68:36"/></para>
  <chapter eid="PSA 68"/>
  <chapter number="69" style="c" sid="PSA 69"/>
  <para style="s1">ﭑ نَ بِرِقٍ</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 69:1"/>دَوُدَ شَ بّيتِ بّيتِبَيٍ شَ مَنفّ بّ. عَ شَ بَ عَلْ بّيتِ نَشَن شِلِ، «قُفٍ تٌقَنيِيٍ.»<verse eid="PSA 69:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 69:2"/>عَلَ، ﭑ نَكِسِ!</para>
  <para style="q" vid="PSA 69:2">يٍ بَرَ تٍ هَن ﭑ كْنيِ.<verse eid="PSA 69:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 69:3"/>ﭑ نَ بِرِقٍ بٌورَ تِلِنشِ كُي،</para>
  <para style="q" vid="PSA 69:3">ﭑ سَنيِ مُ تِدٍ يٌ سْتْقٍ.</para>
  <para style="q" vid="PSA 69:3">ﭑ نَ مَدُلَقٍ يٍ شْورَ.<verse eid="PSA 69:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 69:4"/>ﭑ بَرَ عِ شِلِ هَن ﭑ بَرَ تَفَن،</para>
  <para style="q" vid="PSA 69:4">ﭑ شُي يٌ مُ نَ سْنْن،</para>
  <para style="q" vid="PSA 69:4">ﭑ يَ بَرَ ﭑ شْنْ عِ قٍنقٍ رَ.<verse eid="PSA 69:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 69:5"/>ﭑ شْنمِشِيٍ بَرَ وُيَ دَنفِ ﭑ شُنسّشّ رَ.</para>
  <para style="q" vid="PSA 69:5">سّنبّمَيٍ نَن عٍ رَ نَشٍيٍ وَ مَ ﭑ قَشَقٍ.</para>
  <para style="q" vid="PSA 69:5">عٍ قِندِ ﭑ يَشُييٍ رَ هَلِ ﭑ مُ قٍقٍ رَبَشِ عٍ رَ.</para>
  <para style="q" vid="PSA 69:5">ﭑ مُ قٍ حَاشِ يٌ رَبَشِ عٍ رَ،</para>
  <para style="q" vid="PSA 69:5">كْنْ عٍ وَ مَ ﭑ شَ سَرٍ ندٍ قِ.<verse eid="PSA 69:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 69:6"/>عَلَ، عِ ﭑ مَ تَنتَنيِ كٌلٌن،</para>
  <para style="q" vid="PSA 69:6">ﭑ مَ يُنُبِيٍ مُ نْشُنشِ عِ مَ.<verse eid="PSA 69:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 69:7"/>مَنفّ عَلَتَلَ، عِ نَشَ عَ لُ</para>
  <para style="q" vid="PSA 69:7">دَنشَنِيَتْييٍ شَ يَافِ ﭑ مَ قٍ رَ.</para>
  <para style="q" vid="PSA 69:7">عِسِرَيِلَ مَرِفِ عَلَ، عِ نَشَ عَ لُ</para>
  <para style="q" vid="PSA 69:7">عِ قٍنمَيٍ شَ عِقُ ﭑ مَ قٍ رَ.<verse eid="PSA 69:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 69:8"/>عٍ ﭑ كٌنبِمَ عِ تَن نَن مَ قٍ رَ.</para>
  <para style="q" vid="PSA 69:8">ﭑ بَرَ يَافِ هَن.<verse eid="PSA 69:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 69:9"/>ﭑ شُنيَيٍ مُ ﭑ كٌلٌن سْنْن،</para>
  <para style="q" vid="PSA 69:9">ﭑ بَرَ لُ ﭑ تَارَيٍ بّ عَلْ شْحّ ندٍ.<verse eid="PSA 69:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 69:10"/>ﭑ وَ مَ عِ وَشْنقٍ رَبَقٍ.</para>
  <para style="q" vid="PSA 69:10">عِ كٌنبِمَيٍ بَرَ قِندِ ﭑ يَشُييٍ رَ.<verse eid="PSA 69:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 69:11"/>ﭑ وَ مَ، ﭑ سُنمَ.</para>
  <para style="q" vid="PSA 69:11">نَ بِرِن مَن كُي، مِشِيٍ ﭑ كٌنبِمَ.<verse eid="PSA 69:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 69:12"/>ﭑ سُننُن دٌنمَ رَفٌرٌ مَ ﭑ مَ، عٍ ﭑ مَيٍلٍمَ.<verse eid="PSA 69:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 69:13"/>نَشٍيٍ دْشْشِ تَا سٌدٍ دّ رَ، نٍيٍ ﭑ مَقَلَمَ،</para>
  <para style="q" vid="PSA 69:13">سِيسِلَيٍ ﭑ مَيٍلٍمَ سِفِ رَ.<verse eid="PSA 69:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PSA 69:14"/>كْنْ عَلَتَلَ، ﭑ بَرَ عِ مَشَندِ.</para>
  <para style="q" vid="PSA 69:14">عَلَ عِ شَ هِننّ ﭑ نَ بَرِ مَ عِ شَ هِننّ فبٌ.<verse eid="PSA 69:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 69:15"/>ﭑ نَكِسِ عَلَكٌ ﭑ نَشَ بِرِ بٌورَ شْورَ،</para>
  <para style="q" vid="PSA 69:15">ﭑ نَتَنفَ ﭑ شْنمِشِيٍ مَ.<verse eid="PSA 69:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 69:16"/>عِ نَشَ تِن ﭑ شَ مَدُلَ، يٍ نَشَ ﭑ نَلْي،</para>
  <para style="q" vid="PSA 69:16">ﭑ نَشَ فٌرٌ عَلِفِيَمَ.<verse eid="PSA 69:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 69:17"/>عَلَتَلَ، ﭑ شُي رَتِن،</para>
  <para style="q" vid="PSA 69:17">عِ تَن نَشَن قَن، نَشَن شَ هِننّ فبٌ.</para>
  <para style="q" vid="PSA 69:17">عِ شَ كِنِكِنِ ﭑ مَ، عِ شَ ﭑ مَلِ.<verse eid="PSA 69:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 69:18"/>عِ نَشَ عِ نْشُن عِ شَ كٌنيِ مَ.</para>
  <para style="q" vid="PSA 69:18">ﭑ نَ تْورّ كُي، يَندِ ﭑ مَلِ.<verse eid="PSA 69:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 69:19"/>عِ شَ عِ مَكْرّ ﭑ نَ،</para>
  <para style="q" vid="PSA 69:19">عِ شَ ﭑ شُنسَرَ، عِ شَ ﭑ نَكِسِ ﭑ يَشُييٍ مَ.<verse eid="PSA 69:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="PSA 69:20"/>عِ بَرَ ﭑ مَ تْورّ نُن ﭑ مَ يَافِ كٌلٌن،</para>
  <para style="q" vid="PSA 69:20">ﭑ يَشُييٍ بِرِن نَ عِ يَ عِ.<verse eid="PSA 69:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 69:21"/>كٌنبِ بَرَ ﭑ بْحّ كَنَ هَن ﭑ بَرَ قُرَ.</para>
  <para style="q" vid="PSA 69:21">ﭑ هَيِ نَ كِنِكِنِ مَ، كْنْ عَ مُ نَ.</para>
  <para style="q" vid="PSA 69:21">ﭑ هَيِ نَ مِشِ مَدُندُ مَيٍ مَ، كْنْ عٍ مُ تٌمَ.<verse eid="PSA 69:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 69:22"/>عٍ ثْسْنّ سَمَ ﭑ مَ دٌنسٍ،</para>
  <para style="q" vid="PSA 69:22">عٍ مِنسٍ شْنّ سٌمَ ﭑ يِ رَ، يٍ حْشْي رَ.<verse eid="PSA 69:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 69:23"/>عٍ شَ تٍيبِلِ شَ قِندِ فَنتَنيِ رَ عٍ بّ،</para>
  <para style="q" vid="PSA 69:23">عٍ شَ نَاقُلِ شَ قِندِ يّلّ رَ نَشَن عٍ سُشُمَ.<verse eid="PSA 69:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 69:24"/>عٍ يَ شَ عِقْورْ، عٍ شَ دْنشُ.</para>
  <para style="q" vid="PSA 69:24">عٍ تَفِ شَ عٍ شْنْ هَن عٍ شَ بِرَ.<verse eid="PSA 69:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 69:25"/>عِ شَ شْنْ عٍ مَ، عٍ شَ نَ تّ كٌلٌن.<verse eid="PSA 69:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 69:26"/>عٍ شَ فْورّ شَ حْن،</para>
  <para style="q" vid="PSA 69:26">عَدَ مَدِيٍ نَشَ لُ عٍ شْنيِ سْنْن،<verse eid="PSA 69:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 69:27"/>بَرِ مَ عٍ تْورْ مِشِيٍ شَ تْورّ شُن مَسَمَ،</para>
  <para style="q" vid="PSA 69:27">عِ نَشٍيٍ حَشَنكَتَ.</para>
  <para style="q" vid="PSA 69:27">عٍ مِشِيٍ مَيٍلٍمَ، عِ نَشٍيٍ هَلَكِ.<verse eid="PSA 69:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 69:28"/>عِ شَ عٍ شَ يُنُبِ بِرِن تٌ،</para>
  <para style="q" vid="PSA 69:28">عَلَكٌ عٍ نَشَ عِ شَ كِسِ سْتْ سْنْن.<verse eid="PSA 69:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 69:29"/>عٍ شِلِيٍ شَ بَ سِمَيَ سّبّلِ كُي،</para>
  <para style="q" vid="PSA 69:29">عٍ نَشَ لُ تِنشِنتْييٍ يَ مَ.<verse eid="PSA 69:29"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="30" style="v" sid="PSA 69:30"/>ﭑ تَن نَ تْورْقٍ يِ تّمُي،</para>
  <para style="q" vid="PSA 69:30">عَلَ، عِ شَ ﭑ نَكِسِ، عِ شَ ﭑ نَكٍلِ.<verse eid="PSA 69:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 69:31"/>ﭑ قَمَ عَلَ شِلِ مَتْشْدٍ بّيتِ رَ،</para>
  <para style="q" vid="PSA 69:31">ﭑ قَمَ تَنتُي رَ سِفَدٍ عَ مَ.<verse eid="PSA 69:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 69:32"/>نَ رَقَن عَلَتَلَ مَ دَنفِقٍ سّرّشّ رَ،</para>
  <para style="q" vid="PSA 69:32">هَلِ نِنفٍ كَمَلِشِ نَ عَ رَ،</para>
  <para style="q" vid="PSA 69:32">هَلِ تُورَ قٍرِ كَنيِ نَ عَ رَ، تٌرٍيٍ نَ نَشَن بّ.<verse eid="PSA 69:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 69:33"/>تْورْ مِشِيٍ سّيوَ مَ نّ نَ تٌقٍ رَ.</para>
  <para style="q" vid="PSA 69:33">نَشٍيٍ عَلَ قٍنمَ، عٍ سِمَيَ شْنكُيٍ سْتْمَ نّ.<verse eid="PSA 69:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 69:34"/>عَلَتَلَ عَ تُلِ مَتِمَ سٍتَرٍيٍ رَ،</para>
  <para style="q" vid="PSA 69:34">عَ مُ نّيمُمَ عَ شَ مِشِيٍ مَ عٍ شَ تْورّ كُي.<verse eid="PSA 69:34"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="35" style="v" sid="PSA 69:35"/>كٌورٍ نُن بْشِ شَ عَ مَتْشْ،</para>
  <para style="q" vid="PSA 69:35">بَا نُن يّشّييٍ شَ عَ بِنيَ.<verse eid="PSA 69:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 69:36"/>عَلَ قَمَ سِيٌنِ رَكِسِدٍ،</para>
  <para style="q" vid="PSA 69:36">عَ يُدَ تَايٍ تِمَ نّ.</para>
  <para style="q" vid="PSA 69:36">عَ مَن حَمَ سَبَتِ نَا،</para>
  <para style="q" vid="PSA 69:36">نَا شَ قِندِ عٍ فبٍ رَ.<verse eid="PSA 69:36"/></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 69:37"/>نَ قِندِ مَ عَ شَ كٌنيِيٍ شَ مَمَدِيٍ كّ نَن نَ.</para>
  <para style="q" vid="PSA 69:37">عَلَ شَنُنتٍنيِيٍ قَمَ نّ لُدٍ نَا.<verse eid="PSA 69:37"/></para>
  <chapter eid="PSA 69"/>
  <chapter number="70" style="c" sid="PSA 70"/>
  <para style="s1">عَلَ قٍنمَيٍ شَ سّيوَ</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 70:1"/>دَوُدَ شَ مَشَندِ بّيتِ بّيتِبَيٍ شَ مَنفّ بّ<verse eid="PSA 70:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 70:2"/>عَلَ، ﭑ نَكِسِ!</para>
  <para style="q" vid="PSA 70:2">عَلَتَلَ، قَ ﭑ مَلِ مَقُرٍن.<verse eid="PSA 70:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 70:3"/>عَلَ شَ مِشِيٍ رَيَافِ نَشٍيٍ وَ مَ ﭑ قَشَقٍ.</para>
  <para style="q" vid="PSA 70:3">عَلَ شَ عٍ كٍرِ،</para>
  <para style="q" vid="PSA 70:3">عَلَ شَ عٍ يَ عِقُ، نَشٍيٍ وَ مَ ﭑ تْورْقٍ.<verse eid="PSA 70:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 70:4"/>عَلَ شَ عٍ كٍرِ يَافِ كُي، نَشٍيٍ عَ قَلَمَ ﭑ بّ، «عِ شَ تْورْ!»<verse eid="PSA 70:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 70:5"/>عِ قٍنمَيٍ شَ سّيوَ.</para>
  <para style="q" vid="PSA 70:5">نَشٍيٍ وَ مَ عِ شَ كِسِ شْن، عٍ شَ عَلَ مَتْشْ تّمُي بِرِن.<verse eid="PSA 70:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 70:6"/>عَلَ، ﭑ قِندِشِ مِسِكِينّ نُن تْورْ مِشِ نَن نَ،</para>
  <para style="q" vid="PSA 70:6">قَ ﭑ مَلِ، عِ نَشَ دُفُندِ.<verse eid="PSA 70:6"/></para>
  <chapter eid="PSA 70"/>
  <chapter number="71" style="c" sid="PSA 71"/>
  <para style="s1">قٌرِ شَ مَشَندِ</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 71:1"/>عَلَتَلَ، ﭑ كَنتَمَ نَ عِ تَن نَن نَ،</para>
  <para style="q" vid="PSA 71:1">عِ نَشَ تِن ﭑ شَ لُ يَافِ كُي.<verse eid="PSA 71:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 71:2"/>عِ شَ ﭑ نَكِسِ، عِ شَ ﭑ مَلِ عِ شَ تِنشِنيِ كُي.</para>
  <para style="q" vid="PSA 71:2">عِ تُلِ مَتِ ﭑ نَ، عِ ﭑ نَكِسِ.<verse eid="PSA 71:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 71:3"/>عِ شَ ﭑ كَنتَ.</para>
  <para style="q" vid="PSA 71:3">عِ بَرَ عَ قَلَ ﭑ بّ ﭑ شَ لُ عِ شَ نِينِ بُن مَ تّمُي بِرِن،</para>
  <para style="q" vid="PSA 71:3">عَلَكٌ ﭑ شَ كِسِ.</para>
  <para style="q" vid="PSA 71:3">ﭑ كَنتَمَ نَ عِ تَن نَن نَ.<verse eid="PSA 71:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 71:4"/>ﭑ مَرِفِ عَلَ، ﭑ نَتَنفَ مِشِ حَاشِيٍ سّنبّ مَ،</para>
  <para style="q" vid="PSA 71:4">ﭑ نَتَنفَ شْننَنتٍ تِنشِنتَرٍيٍ مَ.<verse eid="PSA 71:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 71:5"/>ﭑ مَرِفِ عَلَتَلَ، ﭑ شَشِلِ تِشِ عِ تَن نَن نَ</para>
  <para style="q" vid="PSA 71:5">كَبِ ﭑ دِ مّدِ تّمُي،<verse eid="PSA 71:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 71:6"/>كَبِ ﭑ نُ نَ ﭑ نفَ تّيفّ عِ.</para>
  <para style="q" vid="PSA 71:6">عِ تَن نَن عَ نِيَ ﭑ شَ بَرِ.</para>
  <para style="q" vid="PSA 71:6">ﭑ عِ مَتْشْمَ تّمُي بِرِن.<verse eid="PSA 71:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 71:7"/>ﭑ قِندِشِ مِسَالِ نَن نَ مِشِ وُيَشِ بّ،</para>
  <para style="q" vid="PSA 71:7">بَرِ مَ ﭑ كَنتَمَ سّنبّمَ نَ عِ تَن نَن نَ.<verse eid="PSA 71:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 71:8"/>ﭑ عِ مَتْشْمَ تّمُي بِرِن.<verse eid="PSA 71:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 71:9"/>عِ نَشَ مّي ﭑ نَ ﭑ مَ قٌرِحَ كُي،</para>
  <para style="q" vid="PSA 71:9">عِ نَشَ ﭑ نَبّحِن ﭑ مَ سّنبّتَرٍيَ كُي.<verse eid="PSA 71:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 71:10"/>ﭑ يَشُييٍ ﭑ مَقَلَمَ،</para>
  <para style="q" vid="PSA 71:10">عٍ وْيّنمَ عٍ بٌرَ رَ عَلَكٌ عٍ شَ ﭑ قَشَ.<verse eid="PSA 71:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 71:11"/>عٍ نَشّ، «عَلَ بَرَ عَ رَبٌلٌ،</para>
  <para style="q" vid="PSA 71:11">وٌن شَ بِرَ عَ قْشْ رَ، وٌن شَ عَ سُشُ.</para>
  <para style="q" vid="PSA 71:11">مِشِ يٌ مُ نْمَ عَ رَتَنفَدٍ.»<verse eid="PSA 71:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 71:12"/>عَلَ، عِ نَشَ عِ مَكُيَ ﭑ نَ.</para>
  <para style="q" vid="PSA 71:12">ﭑ مَرِفِ عَلَ، قَ ﭑ مَلِ مَقُرٍن.<verse eid="PSA 71:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 71:13"/>عَلَ شَ عٍ رَيَافِ، عَ شَ عٍ رَحْن، نَشٍيٍ ﭑ تْوحّفّمَ.</para>
  <para style="q" vid="PSA 71:13">عَلَ شَ عٍ رَيَافِ، عَ شَ عٍ يَ عِقُ، نَشٍيٍ وَ مَ ﭑ تْورْقٍ.<verse eid="PSA 71:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 71:14"/>ﭑ شَشِلِ تِشِ عِ رَ كُدّ عِ.</para>
  <para style="q" vid="PSA 71:14">ﭑ لُمَ عِ مَتْشْ رَ تّمُي بِرِن.<verse eid="PSA 71:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 71:15"/>ﭑ عِ شَ تِنشِنيِ نُن عِ شَ كِسِ تَنتُمَ لْشْي بِرِن،</para>
  <para style="q" vid="PSA 71:15">بَرِ مَ عٍ وُيَ هَن ﭑ حَن مُ نْمَ عٍ بِرِن كٌلٌندٍ.<verse eid="PSA 71:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 71:16"/>ﭑ عِ شَ كَابَنَكٌ رَبَشِيٍ مَتْشْمَ نّ.</para>
  <para style="q" vid="PSA 71:16">ﭑ مَرِفِ عَلَتَلَ، ﭑ قَمَ عِ شَ تِنشِنيِ فبَنسَن مَسٍندٍ.<verse eid="PSA 71:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PSA 71:17"/>عَلَ، عِ نَ ﭑ شَرَنقٍ كَبِ ﭑ دِ مّدِ تّمُي.</para>
  <para style="q" vid="PSA 71:17">هَن يَ ﭑ عِ شَ كَابَنَكٌي مَتْشْمَ.<verse eid="PSA 71:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 71:18"/>عَلَ، عِ نَشَ ﭑ نَبّحِن يَكْسِ،</para>
  <para style="q" vid="PSA 71:18">ﭑ بَرَ قٌرِ، ﭑ شُنسّشّ قَن بَرَ قُفَ.</para>
  <para style="q" vid="PSA 71:18">عِ نَشَ ﭑ نَبّحِن</para>
  <para style="q" vid="PSA 71:18">عَلَكٌ ﭑ شَ عِ سّنبّ مَسٍن تٌ نُن تِنَ مِشِيٍ بّ.<verse eid="PSA 71:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 71:19"/>عَلَ، عِ شَ تِنشِنيِ فبٌ عَلْ فٍيَ.</para>
  <para style="q" vid="PSA 71:19">عِ شَ كَابَنَكٌ وُيَ.</para>
  <para style="q" vid="PSA 71:19">عِ مَنِيّ نَ مِندٍن؟<verse eid="PSA 71:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 71:20"/>هَلِ عِ تٌ بَرَ عَ نِيَ مُشُ شَ تْورْ، مُشُ شَ هَلَكِ،</para>
  <para style="q" vid="PSA 71:20">عِ قَمَ مُشُ رَكِسِدٍ،</para>
  <para style="q" vid="PSA 71:20">عِ قَمَ مُشُ رَكٍلِدٍ فَبُرِ تِلِنشِ كُي.<verse eid="PSA 71:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 71:21"/>عِ شَ ﭑ شُن نَكٍلِ، عِ شَ ﭑ مَدُندُ.<verse eid="PSA 71:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 71:22"/>ﭑ مَرِفِ عَلَ، نَ كُي ﭑ عِ تَنتُمَ نّ كْرَ رَ</para>
  <para style="q" vid="PSA 71:22">عِ شَ دُفُتّفّحَ شَ قٍ رَ.</para>
  <para style="q" vid="PSA 71:22">عِسِرَيِلَ شَ سّنِيّنتْي، ﭑ بّيتِ بَمَ عِ بّ كْرَ رَ.<verse eid="PSA 71:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 71:23"/>ﭑ بّيتِ بَمَ نّ عِ بّ، ﭑ عِ مَتْشْ،</para>
  <para style="q" vid="PSA 71:23">بَرِ مَ عِ بَرَ ﭑ شُن سَرَ.<verse eid="PSA 71:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 71:24"/>ﭑ عِ شَ تِنشِنيِ مَتْشْمَ نّ تّمُي بِرِن،</para>
  <para style="q" vid="PSA 71:24">بَرِ مَ نَشٍيٍ نُ وَ مَ ﭑ تْورْقٍ،</para>
  <para style="q" vid="PSA 71:24">عٍ بَرَ لُ يَافِ كُي.<verse eid="PSA 71:24"/></para>
  <chapter eid="PSA 71"/>
  <chapter number="72" style="c" sid="PSA 72"/>
  <para style="s1">عِسِرَيِلَ مَنفّ</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">سُلٍمَنِ فبٍ</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 72:1"/>عَلَ، عِ شَ عَ نِيَ مَنفّ شَ كِيتِ تِنشِنشِ سَ.</para>
  <para style="q" vid="PSA 72:1">عِ شَ تِنشِنيِ شَ لُ مَنفّ شَ دِ دّ عِ.<verse eid="PSA 72:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 72:2"/>نَ كُي عَ شَ عِ شَ حَمَ مَكِيتِ نْندِ رَ،</para>
  <para style="q" vid="PSA 72:2">عَ شَ تِنشِن تْورْ مِشِيٍ بّ.<verse eid="PSA 72:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 72:3"/>مَسٍنيِ شَ تِ فٍيَيٍ قَرِ، حَمَ بْحّ سَشِ رَ،</para>
  <para style="q" vid="PSA 72:3">شِبَارُي شَ يٍنسٍن بْشِ مَ، تِنشِنيِ نَن حَمَ يَمَرِ مَ.<verse eid="PSA 72:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 72:4"/>مَنفّ شَ سّرِيّ رَبَ تْورْ مِشِيٍ بّ،</para>
  <para style="q" vid="PSA 72:4">عَ شَ سٍتَرٍ شَ دِيٍ رَكِسِ، عَ شَ عٍ فٍرٍقَيٍ رَيٍنسٍن.<verse eid="PSA 72:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 72:5"/>مِشِيٍ شَ فَاشُ عِ يَ رَ عَبَدَن،</para>
  <para style="q" vid="PSA 72:5">دَنمِ سٌفٍ نُن كِكٍ يَنبَمَ.<verse eid="PSA 72:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 72:6"/>مَنفّ شَ لُ عَلْ تُنّ نَشَن بِرَ مَ شّيٍ مَ،</para>
  <para style="q" vid="PSA 72:6">نَشَن بْشِ رَقَنمَ.<verse eid="PSA 72:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 72:7"/>تِنشِنتْي شَ قٍ قَنمَ نَ وَشَتِ نّ،</para>
  <para style="q" vid="PSA 72:7">دَنمِ كِكٍ يَنبَمَ، بْحّسَ فبٌمَ نّ.<verse eid="PSA 72:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 72:8"/>عَ شَ مَنفّيَ فبٌمَ نّ،</para>
  <para style="q" vid="PSA 72:8">سَ قْلْ سٌفٍتٍدٍ هَن عَ سَ دْشْ سٌفٍفٌرٌدٍ رَ،</para>
  <para style="q" vid="PSA 72:8">عَ قْلْ عٍقِرَتِ شُرٍ مَ هَن سَ دْشْ بْشِ دَنيِ رَ.<verse eid="PSA 72:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 72:9"/>مِشِ نَشٍيٍ نَ وُلَ عِ، عٍ شِنبِ سِنمَ نّ عَ بُن مَ،</para>
  <para style="q" vid="PSA 72:9">عَ يَشُييٍ لُ عَ سَنيِ بُن مَ.<verse eid="PSA 72:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 72:10"/>تَرَ سِسِ مَنفّيٍ نُن سُرِ مَنفّيٍ قَمَ نّ بُحَيٍ رَ.</para>
  <para style="q" vid="PSA 72:10">سٍيبَ نُن سٍبَ مَنفّيٍ قَن دُوتِ قِمَ نّ عَ مَ.<verse eid="PSA 72:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 72:11"/>مَنفّ بِرِن عٍ شِنبِ سِنمَ نّ عَ بُن مَ،</para>
  <para style="q" vid="PSA 72:11">سِيٍ بِرِن لُ عَ شَ يَامَرِ بُن مَ.<verse eid="PSA 72:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 72:12"/>نَ كُي سٍتَرٍيٍ قَمَ نّ عَ شِلِدٍ مَرَكِسِمَ.</para>
  <para style="q" vid="PSA 72:12">عَ مِسِكِينّ سّنبّتَرٍ مَلِمَ نّ.<verse eid="PSA 72:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 72:13"/>عَ كِنِكِنِمَ نّ سّنبّتَرٍيٍ نُن سٍتَرٍيٍ مَ،</para>
  <para style="q" vid="PSA 72:13">عَ تْورْ مِشِيٍ رَكِسِ.<verse eid="PSA 72:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 72:14"/>عَ عٍ شْرّيَمَ نّ مَءِقُي نُن قٍ كٌبِيٍ مَ،</para>
  <para style="q" vid="PSA 72:14">بَرِ مَ عٍ قِندِشِ عَ شَنُنتٍنيِيٍ نَن نَ.<verse eid="PSA 72:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 72:15"/>عَ شَ مَنفّيَ شَ بُ!</para>
  <para style="q" vid="PSA 72:15">عَ سٍيبَ بْشِ شَ شّيمَ سْتْمَ نّ.</para>
  <para style="q" vid="PSA 72:15">مِشِيٍ شَ عَلَ مَشَندِ عَ بّ تّمُي بِرِن،</para>
  <para style="q" vid="PSA 72:15">عٍ نَشَ تَفَن دُبَدٍ عَ بّ.<verse eid="PSA 72:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 72:16"/>عَلَ دٌنسٍ يِرِوَ مَ نّ بْشِ كُي.</para>
  <para style="q" vid="PSA 72:16">فٍيَيٍ رَقٍمَ نّ سَنسِيٍ رَ،</para>
  <para style="q" vid="PSA 72:16">عٍ بٌفِيٍ لُ عَلْ سَنسِ بٌفِ نَشٍيٍ نَ لِبَن.</para>
  <para style="q" vid="PSA 72:16">مِشِيٍ فبٌمَ نّ تَا كُي عَلْ بْشِ سّشّ.<verse eid="PSA 72:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 72:17"/>مَنفّ عَلَ شِلِ فبٌ عَبَدَن!</para>
  <para style="q" vid="PSA 72:17">دَن مُ نَ عَ شِلِ مَ سٌفٍ بُن مَ.</para>
  <para style="q" vid="PSA 72:17">سِ بِرِن بَرَكّ سْتْمَ نّ عَ سَابُي رَ،</para>
  <para style="q" vid="PSA 72:17">عٍ قَ عَ مَتْشْ.<verse eid="PSA 72:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="PSA 72:18"/>عِسِرَيِلَ مَرِفِ عَلَتَلَ تَنتُ.</para>
  <para style="q" vid="PSA 72:18">عَ كٍرٍن نَن كَابَنَكٌي رَبَمَ.<verse eid="PSA 72:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 72:19"/>عَ شِلِ شُنفبٍ شَ تَنتُ عَبَدَن.</para>
  <para style="q" vid="PSA 72:19">دُنِحَ بِرِن شَ عَ شَ بِنيّ كٌلٌن.</para>
  <para style="q" vid="PSA 72:19">عَمِنَ! عَمِنَ!<verse eid="PSA 72:19"/></para>
  <para style="b"/>
  <para style="d">
    <verse number="20" style="v" sid="PSA 72:20"/>يِسَيِ شَ دِ دَوُدَ شَ مَشَندِيٍ رَحْنيِ نَن نَ كِ.<verse eid="PSA 72:20"/></para>
  <chapter eid="PSA 72"/>
  <chapter number="73" style="c" sid="PSA 73"/>
  <para style="s1">حَاشُحَ سَرٍ</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 73:1"/>عَسَقِ شَ بّيتِ</para>
  <para style="q" vid="PSA 73:1">نْندِ هَفِفّ نَن يَ؛ عَلَ قَن عِسِرَيِلَ بّ،</para>
  <para style="q" vid="PSA 73:1">عَ قَن مِشِيٍ بّ نَشٍيٍ سٌندٌنيِ سّنِيّنشِ.<verse eid="PSA 73:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PSA 73:2"/>عَ فبٍ مُ نُ لُشِ ﭑ تَن يَتِ شَ بَ كِرَ مَ،</para>
  <para style="q" vid="PSA 73:2">ﭑ سَنيِيٍ شَ بِرَ كِرَ فبّتّ قْشْ رَ.<verse eid="PSA 73:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 73:3"/>ﭑ نُ يّتّ عِفبٌي تْونّمَ،</para>
  <para style="q" vid="PSA 73:3">ﭑ تٌ عَ تٌ مِشِ حَاشِيٍ قِندِشِ نَاقُلِ كَنيِيٍ رَ.<verse eid="PSA 73:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 73:4"/>سٍسٍ مُ عٍ عِقُمَ هَن عٍ شَ قَشّ، عٍ قَتٍ يَلَنشِ تُن.<verse eid="PSA 73:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 73:5"/>عٍ مُ عَدَ مَدِيٍ شَ تْورّ كٌلٌن،</para>
  <para style="q" vid="PSA 73:5">عٍ مُ حَشَنكَتَشِ عَلْ بٌورٍيٍ.<verse eid="PSA 73:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 73:6"/>يّتّ عِفبٌحَ قِندِشِ شُنمَسٍ نَن نَ عٍ بّ،</para>
  <para style="q" vid="PSA 73:6">عٍ مِشِ تْورْ مَ لْشْ يٌ لْشْ.<verse eid="PSA 73:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 73:7"/>عٍ عٍ يَ تِمَ سٍ بِرِن نَ،</para>
  <para style="q" vid="PSA 73:7">عٍ وَشْنقٍ بَرَ دَنفِ عَ عِ.<verse eid="PSA 73:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 73:8"/>عٍ يٌمَ مِشِ مَ،</para>
  <para style="q" vid="PSA 73:8">عٍ قٍ حَاشِ حَنِفٍمَ يّتّ عِفبٌحَ كُي.<verse eid="PSA 73:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 73:9"/>عٍ عَلَ قٍ مَبٍرٍ مَ، عٍ دّ مُ دِكِمَ سٍسٍ قَلَقٍ رَ دُنِحَ مَ.<verse eid="PSA 73:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 73:10"/>نَ نَن عَ رَ، عَلَ شَ حَمَ عَ شُن تِمَ عٍ رَ،</para>
  <para style="q" vid="PSA 73:10">عٍ لَ عٍ شَ وْيّنيِيٍ رَ.<verse eid="PSA 73:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 73:11"/>عٍ نَشّ، «عَلَ تَن وٌن حّرّ كِ كٌلٌنمَ دِ؟</para>
  <para style="q" vid="PSA 73:11">قَهَامُي مُندُن نَ عَ بّ؟»<verse eid="PSA 73:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 73:12"/>مِشِ حَاشِيٍ نَ نَ كِ نّ.</para>
  <para style="q" vid="PSA 73:12">عٍ بْحّ سَشِ نَاقُلِ يِرِوَقٍ كُي.<verse eid="PSA 73:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 73:13"/>ﭑ حْشْ عَ مَ، «ﭑ نَن ﭑ بْحّ رَ سّنِيّنشِ نّ قُ.</para>
  <para style="q" vid="PSA 73:13">ﭑ فبِلٍنقٍ قٍ كٌبِيٍ قْشْ رَ، نَ مُ قَنشِ ﭑ بّ.<verse eid="PSA 73:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 73:14"/>ﭑ حَشَنكَتَشِ تّمُي بِرِن،</para>
  <para style="q" vid="PSA 73:14">لْشْ يٌ لْشْ ندٍ سَمَ ﭑ مَ كٌتٍ شُن.»<verse eid="PSA 73:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 73:15"/>شَ ﭑ سَ نَ مْولِ قَلَ نُ،</para>
  <para style="q" vid="PSA 73:15">ﭑ بَرَ يَنقَنتٍيَ رَبَ عِ شَ دِيٍ رَ نُ.<verse eid="PSA 73:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 73:16"/>عَوَ، ﭑ نَشَ قَهَامُي قٍن يِ قٍ مَ.</para>
  <para style="q" vid="PSA 73:16">نَ نُ شْرْشْ ﭑ بّ،<verse eid="PSA 73:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 73:17"/>هَن ﭑ سٌ لْشْي عَلَ شَ هْرْ مْلِنفِرَ كُي،</para>
  <para style="q" vid="PSA 73:17">ﭑ قَ عَ مَحْشُن قٍ نَشَن قٍ كٌبِ رَبَيٍ لِمَ.<verse eid="PSA 73:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 73:18"/>عِ عٍ تِمَ كِرَ سَلَشُنشِ نَن شْن مَ،</para>
  <para style="q" vid="PSA 73:18">عِ قَ عٍ شُن نَكَنَ.<verse eid="PSA 73:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 73:19"/>عٍ شَ قٍ حْنمَ كٍرٍنيِ نَن نَ، قٍ مَفَاشُشِ عٍ شَنِنمَ نّ.<verse eid="PSA 73:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 73:20"/>مَرِفِ، عَلْ شِيٍ دَنفِمَ كِ نَشّ مِشِ شُنُ تّمُي،</para>
  <para style="q" vid="PSA 73:20">عِ نَ كٍلِ، عٍ قَن شَ قٍ بَمَ عِ يَ عِ نَ كِ نّ.<verse eid="PSA 73:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="PSA 73:21"/>ﭑ بْحّ تٌ نُ مَحَاشُمَ،</para>
  <para style="q" vid="PSA 73:21">عَ نُ لُشِ نّ ﭑ بّ عَلْ تَنبّ نَن ﭑ سْشْمَ.<verse eid="PSA 73:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 73:22"/>دَشُي نَن نُ ﭑ نَ، ﭑ مُ نُ سٍسٍ قَهَامُشِ.</para>
  <para style="q" vid="PSA 73:22">ﭑ نُ لُشِ نّ عَلْ شُرُ سٍ شَشِلِتَرٍ عِ يَ عِ.<verse eid="PSA 73:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 73:23"/>كْنْ هَن يَ ﭑ نَ عِ سّيتِ مَ،</para>
  <para style="q" vid="PSA 73:23">ﭑ يِرٍقَنيِ بّلّشّ سُشُشِ عِ يِ رَ.<verse eid="PSA 73:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 73:24"/>عِ ﭑ نَحّرّ مَ عِ شَ مَرَ سِ رَ،</para>
  <para style="q" vid="PSA 73:24">عِ مَن ﭑ نَسّنّمَ نّ عِ شَ نْرّ كُي.<verse eid="PSA 73:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 73:25"/>ندٍ فبّتّ نَ ﭑ يِ رَ كٌورٍ مَ؟</para>
  <para style="q" vid="PSA 73:25">بَ عِ تَن نَ، سٍسٍ فبّتّ شْلِ مُ ﭑ مَ يِ دُنِحَ مَ.<verse eid="PSA 73:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 73:26"/>ﭑ قَتٍ نُن ﭑ شَشِلِ تَفَنمَ نّ،</para>
  <para style="q" vid="PSA 73:26">كْنْ عَلَ ﭑ بْحّ سَمَ نّ عَبَدَن.<verse eid="PSA 73:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 73:27"/>نَشٍيٍ عٍ مَكُيَمَ عِ رَ، بْنْ مِشِ نَن عٍ رَ.</para>
  <para style="q" vid="PSA 73:27">عِ مِشِيٍ دّ بَلَنمَ، نَشٍيٍ بِرِن عِ قِنسِرِوَلِمَ.<verse eid="PSA 73:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 73:28"/>كْنْ ﭑ مَ هّيرِ قِندِشِ ﭑ مَسٌقٍ نَن نَ عَلَ رَ.</para>
  <para style="q" vid="PSA 73:28">ﭑ بَرَ مَرِفِ عَلَتَلَ سُفَندِ ﭑ شُن تَشُدٍ رَ،</para>
  <para style="q" vid="PSA 73:28">عَلَكٌ ﭑ شَ عِ شَ وَلِ قَنيِيٍ بِرِن مَسٍن دُنِحَ بّ.<verse eid="PSA 73:28"/></para>
  <chapter eid="PSA 73"/>
  <chapter number="74" style="c" sid="PSA 74"/>
  <para style="s1">عَلَ شَ هْرْ مْلِنفِرَ كَنَشِ شَ قٍ</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">عَسَقِ شَ لْننِ بّيتِ</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 74:1"/>عَلَ، مُنقٍ رَ عِ مُشُ رَبّحِنشِ كٍرٍنيِ رَ؟</para>
  <para style="q" vid="PSA 74:1">مُنقٍ رَ عِ شَ شْنّ تُرُ مَ عِ شَ حَمَ شِلِ مَ عِ نَشَن نَبَلٌقٍ؟<verse eid="PSA 74:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 74:2"/>عِ شَ رَتُ عِ شَ حَمَ مَ عِ نَشَن شُن سَرَشِ،</para>
  <para style="q" vid="PSA 74:2">عِ كّ قِمَ نَشَن مَ،</para>
  <para style="q" vid="PSA 74:2">عِ سَبَتِشِ نَشَن يَ مَ سِيٌن فٍيَ مَ.<verse eid="PSA 74:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 74:3"/>عِ شَ عَ يِرٍ مَتٌ عَ يَشُييٍ نَشَن كَنَشِ،</para>
  <para style="q" vid="PSA 74:3">عِ شَ عِ شَ هْرْ مْبَنشِ تٌ عٍ نَشَن كَسَرَشِ.<verse eid="PSA 74:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 74:4"/>عِ يَشُييٍ بَرَ عٍ شُي عِتٍ عِ شَ نَرَلَن بَنشِ كُي،</para>
  <para style="q" vid="PSA 74:4">عٍ بَرَ عٍ شَ قّلّكِيٍ رَتٍ نَا.<verse eid="PSA 74:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 74:5"/>عٍ نُ لُشِ عَلْ بٍيرَ كَنيِ نَشٍيٍ قْتْنيِ سّفّمَ.<verse eid="PSA 74:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 74:6"/>عٍ بَرَ هْرْ مْلِنفِرَ شُنمَسٍيٍ كَنَ بٍيرَ نُن دّرّ مَيٍ رَ،<verse eid="PSA 74:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 74:7"/>عٍ نَا فَن تّ رَ.</para>
  <para style="q" vid="PSA 74:7">عٍ بَرَ نَ يِرٍ مَبٍرٍ عِ شِلِ سَبَتِشِ دّننَشّ.<verse eid="PSA 74:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 74:8"/>عٍ نُ عَ قَلَمَ نّ عٍ بْحّ مَ، «وٌن شَ عٍ سْنتْ!»</para>
  <para style="q" vid="PSA 74:8">عٍ بَرَ عَلَ شَ بَتُدٍيٍ بِرِن فَن.<verse eid="PSA 74:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 74:9"/>عِ شَ كَابَنَكٌي مُ تٌمَ،</para>
  <para style="q" vid="PSA 74:9">نَمِحْنمّيٍ قَن مُ نَ مُشُ يَ مَ كْرّ.</para>
  <para style="q" vid="PSA 74:9">مُشُ مُ عَ كٌلٌن يِ قٍ بُمَ هَن تّمُي مُندُن.<verse eid="PSA 74:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 74:10"/>عٍٍ عَلَ، يَشُي مَيٍلٍ تِمَ هَن تّمُي مُندُن؟</para>
  <para style="q" vid="PSA 74:10">دَنيِ مُ نَ عٍ شَ كٌنبِيٍ مَ؟<verse eid="PSA 74:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 74:11"/>مُنقٍ رَ عِ مُ عِ سّنبّ مَفَاشُشِ مَسٍن عٍ بّ؟</para>
  <para style="q" vid="PSA 74:11">عِ شَ كٍلِ، عِ شَ عٍ سْنتْ!<verse eid="PSA 74:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 74:12"/>كَبِ تّمُي شْنكُيٍ، عَلَ نَن نَ ﭑ مَ مَنفّ رَ،</para>
  <para style="q" vid="PSA 74:12">عَ تَن نَشَن قِندِشِ شُننَكٍلِ سَابُي رَ دُنِحَ مَ.<verse eid="PSA 74:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 74:13"/>عِ تَن نَن بَا عِبْو عِ سّنبّ رَ،</para>
  <para style="q" vid="PSA 74:13">عِ دَالِسٍ مَفَاشُشِيٍ شُنيِيٍ عِبُتُشُن نَا.<verse eid="PSA 74:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 74:14"/>عِ تَن نَن عٍ شُنيِيٍ عِبُتُشُن،</para>
  <para style="q" vid="PSA 74:14">عِ عٍ قِ دٌنسٍ رَ وُلَءِ سُبٍيٍ مَ.<verse eid="PSA 74:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 74:15"/>عِ تَن نَن دُلٌنيِيٍ نُن شُرٍيٍ رَبْو،</para>
  <para style="q" vid="PSA 74:15">عِ تَن نَن دَبٌنيِيٍ رَشْرِ، نَشٍيٍ مُ دَرِشِ شْرِ رَ.<verse eid="PSA 74:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 74:16"/>يَنيِ نُن كْي قِندِشِ عِ فبٍ نَن نَ،</para>
  <para style="q" vid="PSA 74:16">كِكٍ نُن سٌفٍ، عِ تَن نَن عٍ دَاشِ.<verse eid="PSA 74:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 74:17"/>عِ تَن نَن بْشِيٍ نَانِنيِيٍ بِرِن سَشِ.</para>
  <para style="q" vid="PSA 74:17">عِ تَن نَن سٌفٌقُرٍ نُن حّمّ دَا.<verse eid="PSA 74:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="PSA 74:18"/>عِ شَ رَتُ عَ مَ عَ مُشُ يَشُييٍ نَ عِ تَن عَلَتَلَ نَن مَبٍرٍقٍ،</para>
  <para style="q" vid="PSA 74:18">حَمَ شَشِلِتَرٍ نَ عِ شِلِ بّشُقٍ!<verse eid="PSA 74:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 74:19"/>يَندِ، عِ نَشَ عِ شَ حَمَ شَنُشِ رَبٌلٌ</para>
  <para style="q" vid="PSA 74:19">عَلْ فَنبّ دِ رَبٌلٌمَ سّفّ يِ رَ كِ نَشّ.</para>
  <para style="q" vid="PSA 74:19">عِ نَشَ نّيمُ عِ شَ مِسِكِينّيٍ مَ.<verse eid="PSA 74:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 74:20"/>عِ شَ عِ حْشْ سَ عِ شَ سَاتّ مَ،</para>
  <para style="q" vid="PSA 74:20">بَرِ مَ قٍ كٌبِيٍ بَرَ فبٌ يِ بْشِ مَ هَن عَ بَرَ دَنفِ عَ عِ.<verse eid="PSA 74:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 74:21"/>عِ نَشَ تْورْ مِشِيٍ لُ عٍ شَ يَافِ كُي.</para>
  <para style="q" vid="PSA 74:21">مِسِكِينّيٍ نُن سٍتَرٍيٍ شَ عِ شِلِ مَتْشْ.<verse eid="PSA 74:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 74:22"/>عَلَ، عِ شَ كٍلِ عِ شِلِ شُنمَقَلَقٍ رَ.</para>
  <para style="q" vid="PSA 74:22">عِ شَ رَتُ شَشِلِتَرٍ شَ مَبٍرٍ مَ.<verse eid="PSA 74:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 74:23"/>عِ نَشَ نّيمُ عِ يَشُييٍ شَ وْيّنيِيٍ مَ،</para>
  <para style="q" vid="PSA 74:23">عِ نَشَ نّيمُ عِ فٍرٍقَيٍ شَ سْنشْي مَ نَشَن مُ حْنمَ.<verse eid="PSA 74:23"/></para>
  <chapter eid="PSA 74"/>
  <chapter number="75" style="c" sid="PSA 75"/>
  <para style="s1">عَلَ شَ كِيتِ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 75:1"/>عَسَقِ شَ بّيتِ بّيتِبَيٍ مَنفّ بّ. عَ شَ بَ عَلْ بّيتِ نَشَن شِلِ «عِ نَشَ كَسَرّ تِ.»<verse eid="PSA 75:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 75:2"/>مُشُ مَرِفِ عَلَ، مُشُ بَرَ عِ مَتْشْ.</para>
  <para style="q" vid="PSA 75:2">مَتْشْي نَ عِ بّ، عِ تَن نَشَن نَ مُشُ سّيتِ مَ،</para>
  <para style="q" vid="PSA 75:2">عِ تَن نَشَن شَ كَابَنَكٌي قَلَمَ يِرٍ بِرِن.<verse eid="PSA 75:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 75:3"/>عِ نَشّ، «ﭑ مَ وَشَتِ سُفَندِشِ نَ عَ لِ،</para>
  <para style="q" vid="PSA 75:3">ﭑ تَن نَن كِيتِ سَمَ تِنشِنيِ رَ.<verse eid="PSA 75:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 75:4"/>دُنِحَ نُن عَ شَ مِشِيٍ قَمَ شُنُدٍ،</para>
  <para style="q" vid="PSA 75:4">كْنْ ﭑ تَن نَن عَ كِنكِيٍ سّنبّ سٌمَ.<verse eid="PSA 75:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 75:5"/>ﭑ عَ قَلَمَ يّتّ عِفبٌي نُن مِشِ كٌبِيٍ بّ،</para>
  <para style="q" vid="PSA 75:5">‹وٌ نَشَ وٌ يّتّ عِفبٌ، وٌ نَشَ وٌ شُنيِ عِتٍ.<verse eid="PSA 75:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 75:6"/>وٌ نَشَ وٌ شُنيِ عِتٍ كٌورٍ مَ،</para>
  <para style="q" vid="PSA 75:6">وٌ بَ يّتّ عِفبٌحَ وْيّنيِ قَلَقٍ رَ.›»<verse eid="PSA 75:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 75:7"/>وٌ شَ عَ كٌلٌن شُننَكٍلِ مُ كٍلِمَ سٌفٍتٍدٍ،</para>
  <para style="q" vid="PSA 75:7">عَ مُ كٍلِمَ سٌفٍفٌرٌدٍ، عَ مُ كٍلِمَ فبٍنفبٍرٍنيِ مَ.<verse eid="PSA 75:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 75:8"/>عَلَ نَن كِيتِ سَمَ،</para>
  <para style="q" vid="PSA 75:8">عَ مِشِ ندٍ شَ قٍ رَفٌرٌ، عَ مِشِ ندٍ شَ قٍ عِتٍ.<verse eid="PSA 75:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 75:9"/>تْنبِلِ ندٍ نَ عَلَتَلَ شْنيّ،</para>
  <para style="q" vid="PSA 75:9">وّنِ شَاحّ رَقَلَشِ نَ نَشَن كُي.</para>
  <para style="q" vid="PSA 75:9">عَ نَ سٌمَ دُنِحَ مِشِ حَاشِيٍ نَن يِ،</para>
  <para style="q" vid="PSA 75:9">عٍ عَ مِن هَن عَ حْن.<verse eid="PSA 75:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 75:10"/>ﭑ نَ مَسٍنيِ تِمَ تّمُي بِرِن،</para>
  <para style="q" vid="PSA 75:10">ﭑ يَشُبَ مَرِفِ عَلَ مَتْشْمَ بّيتِ رَ.<verse eid="PSA 75:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 75:11"/>«ﭑ مِشِ حَاشِيٍ شَ يّتّ عِفبٌحَ شُن نَكَنَمَ نّ،</para>
  <para style="q" vid="PSA 75:11">ﭑ تِنشِنتْييٍ شُن نَكٍلِ.»<verse eid="PSA 75:11"/></para>
  <chapter eid="PSA 75"/>
  <chapter number="76" style="c" sid="PSA 76"/>
  <para style="s1">عَلَ شَ شُننَكٍلِ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 76:1"/>عَسَقِ شَ بّيتِ بّيتِبَيٍ شَ مَنفّ بّ. عَ شَ بَ كْرَ شُي رَ.<verse eid="PSA 76:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 76:2"/>عَلَ كٌلٌنشِ يُدَيَ بْشِ مَ، عَ شِلِ فبٌ عِسِرَيِلَ.<verse eid="PSA 76:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 76:3"/>عَ شْنيِ نَ سَلَمُ، عَ شَ بَنشِ نَ سِيٌن.<verse eid="PSA 76:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 76:4"/>عَ فٍرٍ سٌسٍيٍ عَلْ شَلِيٍ، وُرٍ لٍقَيٍ، نُن سَنتِدّفّمَيٍ كَنَ مّننِ نّ.<verse eid="PSA 76:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 76:5"/>عِ شَ نْرّ فبٌ عَلْ كٌيِنمَ،</para>
  <para style="q" vid="PSA 76:5">نَشَن فبِلٍن كٍلِقٍ فٍيَيٍ مَ، سُبٍيٍ وُيَ دّننَشّ.<verse eid="PSA 76:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 76:6"/>عِ بَرَ نْ سّنبّمَيٍ رَ، نَشٍيٍ مُ شُنُمَ سْنْن،</para>
  <para style="q" vid="PSA 76:6">نَشٍيٍ مُ نْ فٍرٍ تِدٍ عِ كَنكٍ.<verse eid="PSA 76:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 76:7"/>عِ تَن يَشُبَ مَرِفِ عَلَ تٌ كٍلِ عٍ شِلِ مَ،</para>
  <para style="q" vid="PSA 76:7">عٍ شَ سٌي رَفِيٍ نُن عٍ شَ سٌي نَشَ هَلَكِ.<verse eid="PSA 76:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 76:8"/>عِ مَفَاشُ! عِ شَ شْنّ كُي، ندٍ سُو سَمَ عِ يَ رَ؟<verse eid="PSA 76:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 76:9"/>عِ تٌ كِيتِ سَ كٌورٍ مَ، دُنِحَ نَشَ سَبَرِ فَاشُي كُي.<verse eid="PSA 76:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 76:10"/>عِ شَ كِيتِ نَشَ تْورْ مِشِيٍ رَكِسِ.<verse eid="PSA 76:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 76:11"/>عِ شَ شْنّ عِبُنَدَ مَ مَبِرِ قِندِشِ عِ مَتْشْي نَن نَ.</para>
  <para style="q" vid="PSA 76:11">عِ شَ بْحّتٍ لُشِ نّ عَلْ بّلّتِ عِ عِ تَفِ عِشِرِ مَ نَشَن نَ فٍرٍ كُي.<verse eid="PSA 76:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 76:12"/>وٌ شَ وٌ شَ دَاكَن نَكَمَلِ وٌ مَرِفِ عَلَتَلَ بّ،</para>
  <para style="q" vid="PSA 76:12">وٌ شَ قَ سّرّشّيٍ رَ عَ شْن مَ،</para>
  <para style="q" vid="PSA 76:12">وٌ تَن نَشٍيٍ بِرِن عَ رَبِلِنشِ.<verse eid="PSA 76:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 76:13"/>عَ تَن نَن حّنفِ بَمَ سّنبّمَيٍ قَتٍ عِ،</para>
  <para style="q" vid="PSA 76:13">عَ مَفَاشُ دُنِحَ مَنفّيٍ بّ.<verse eid="PSA 76:13"/></para>
  <chapter eid="PSA 76"/>
  <chapter number="77" style="c" sid="PSA 77"/>
  <para style="s1">عَلَ شَ مَرَتَنفّ مُ مَسَرَ مَ</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 77:1"/>عَسَقِ شَ بّيتِ بّيتِبَيٍ شَ مَنفّ يٍدُتُن بّ<verse eid="PSA 77:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 77:2"/>ﭑ نَن ﭑ شُي رَتٍقٍ عَلَ نَن مَ.</para>
  <para style="q" vid="PSA 77:2">عَ عَ تُلِ مَتِمَ نّ ﭑ شُي رَ.<verse eid="PSA 77:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 77:3"/>لْشْ شْرْشْييٍ نَ قَ ﭑ مَ، ﭑ نَن ﭑ مَرِفِ شِلِمَ نّ.</para>
  <para style="q" vid="PSA 77:3">كْي رَ، ﭑ نَن ﭑ بّلّشّ عِتَلَ عَ بّ،</para>
  <para style="q" vid="PSA 77:3">كْنْ ﭑ مُ مَدُندُي سْتْمَ.<verse eid="PSA 77:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 77:4"/>ﭑ نَن ﭑ نَتُ عَلَ مَ، ﭑ وَ ﭑ بْحّ مَ.</para>
  <para style="q" vid="PSA 77:4">ﭑ نَن ﭑ مَحْشُن عَ مَ، لِمَنِيَ بَ ﭑ يِ.<verse eid="PSA 77:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 77:5"/>عِ مُ تِنمَ ﭑ شَ شِ.</para>
  <para style="q" vid="PSA 77:5">ﭑ شَشِلِ عِقُشِ، حَن ﭑ مُ نْمَ وْيّندٍ.<verse eid="PSA 77:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 77:6"/>ﭑ نَن ﭑ مَحْشُنمَ وَشَتِ دَنفِشِيٍ مَ.<verse eid="PSA 77:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 77:7"/>ﭑ نَن ﭑ نَتُمَ نٍيٍ مَ ﭑ مَ بّيتِيٍ سَابُي رَ.</para>
  <para style="q" vid="PSA 77:7">ﭑ نَن ﭑ يّتّ مَشْرِن،<verse eid="PSA 77:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 77:8"/>«ﭑ مَرِفِ مّيمَ نّ عِبُنَدَ مَ رَ عَبَدَن؟</para>
  <para style="q" vid="PSA 77:8">عَ مُ هِننّمَ مِشِيٍ رَ سْنْن؟<verse eid="PSA 77:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 77:9"/>دَنيِ نَ عَ شَ قَنيِ مَ؟</para>
  <para style="q" vid="PSA 77:9">عَ تٌندِ مَ عَ شَ لَايِدِيٍ كَمَلِدٍ؟<verse eid="PSA 77:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 77:10"/>عَ بَرَ نّيمُ عَ شَ هِننّ مَ؟</para>
  <para style="q" vid="PSA 77:10">عَ شَ شْنّ بَرَ نْ عَ شَ كِنِكِنِ رَ؟<verse eid="PSA 77:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 77:11"/>ﭑ مَ تْورّ كُي عَ لُمَ ﭑ بّ</para>
  <para style="q" vid="PSA 77:11">عَلْ عَلَ شِلِ شُنفبٍ كَنيِ نَ مَسَرَقٍ.»<verse eid="PSA 77:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 77:12"/>عَ لَنمَ ﭑ شَ رَتُ عَلَتَلَ شَ وَلِيٍ مَ،</para>
  <para style="q" vid="PSA 77:12">عَ شَ كَابَنَكٌي عَ نَشٍيٍ رَبَشِ تّمُي دَنفِشِ.<verse eid="PSA 77:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 77:13"/>ﭑ نَن ﭑ شَشِلِ رَ سِفَمَ نّ عِ شَ كّوَلِ بِرِن مَ،</para>
  <para style="q" vid="PSA 77:13">ﭑ نَن ﭑ مَحْشُنمَ نّ عِ شَ وَلِيٍ مَ.<verse eid="PSA 77:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 77:14"/>عَلَ، عِ شَ كِرَ سّنِيّن.</para>
  <para style="q" vid="PSA 77:14">عَلَ فبّتّ مُ نَ، عِ مَنِيّ مُ نَ!<verse eid="PSA 77:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 77:15"/>عِ تَن عَلَ نَن كَابَنَكٌي رَبَمَ،</para>
  <para style="q" vid="PSA 77:15">عِ قٍ مَفَاشُشِيٍ مَسٍن حَمَنّيٍ تَفِ.<verse eid="PSA 77:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 77:16"/>عِ عِ شَ حَمَ شُن سَرَشِ عِ سّنبّ نَن نَ،</para>
  <para style="q" vid="PSA 77:16">يَشُبَ نُن يُسُقُ شَ مَمَدِيٍ.<verse eid="PSA 77:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PSA 77:17"/>عَلَ، بَا شُنفبٍ تٌ عِ تٌ،</para>
  <para style="q" vid="PSA 77:17">عَ دُلٌنيِ نَشَ سّرّن.<verse eid="PSA 77:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 77:18"/>نُشُييٍ نَشَ يٍ فبٍفبٍ رَفٌرٌ،</para>
  <para style="q" vid="PSA 77:18">فَلَنيِ نَشَ بُلَ كٌورٍ مَ،</para>
  <para style="q" vid="PSA 77:18">سٍيَمَكْنيِيٍ نَشَ لُ عَلْ تَنبّ وٌلِشِيٍ.<verse eid="PSA 77:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 77:19"/>عِ شَ سَرِنيِ شُي نَشَ بُلَ،</para>
  <para style="q" vid="PSA 77:19">سٍيَمَكْنيِ نَشَ دُنِحَ عِيَلَن،</para>
  <para style="q" vid="PSA 77:19">بْشِ نَشَ عَ عِمَشَ، عَ سّرّن.<verse eid="PSA 77:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 77:20"/>عِ نَشَ كِرَ رَبْو بَا مَ،</para>
  <para style="q" vid="PSA 77:20">عِ دَنفِ يٍ شُنفبٍ تَفِ، كْنْ عِ قْشِ مُ تٌ.<verse eid="PSA 77:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 77:21"/>عِ نَشَ عِ شَ حَمَ رَحّرّ عَلْ شُرُ سٍ فْورّ</para>
  <para style="q" vid="PSA 77:21">عَننَبِ مُنسَ نُن هَرُنَ سَابُي رَ.<verse eid="PSA 77:21"/></para>
  <chapter eid="PSA 77"/>
  <chapter number="78" style="c" sid="PSA 78"/>
  <para style="s1">عَلَ نُن عِسِرَيِلَ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 78:1"/>عَسَقِ شَ لْننِ بّيتِ</para>
  <para style="q" vid="PSA 78:1">ﭑ مَ حَمَ، وٌ وٌ تُلِ مَتِ ﭑ مَ شَرَنيِ رَ،</para>
  <para style="q" vid="PSA 78:1">وٌ وٌ، تُلِ مَتِ ﭑ مَ مَسٍنيِ رَ.<verse eid="PSA 78:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 78:2"/>ﭑ مِسَالِ ندٍ قَلَمَ وٌ بّ،</para>
  <para style="q" vid="PSA 78:2">ﭑ قٍ دَنفِشِيٍ مَدْشْ،<verse eid="PSA 78:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 78:3"/>مُشُ قٍ نَشٍيٍ مّ، مُشُ قٍ نَشٍيٍ كٌلٌن،</para>
  <para style="q" vid="PSA 78:3">مُشُ بَبَيٍ سَابُي رَ.<verse eid="PSA 78:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 78:4"/>مُشُ مُ نٍيٍ نْشُنمَ عٍ بْنسْييٍ مَ،</para>
  <para style="q" vid="PSA 78:4">مُشُ عَلَتَلَ شَ مَتْشْي قَلَمَ نّ عٍ شَنبِرَتِيٍ بّ،</para>
  <para style="q" vid="PSA 78:4">مُشُ عَ سّنبّ نُن عَ شَ كَابَنَكٌي مَسٍنمَ نّ عٍ بّ.<verse eid="PSA 78:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 78:5"/>عَلَ بَرَ يَامَرِيٍ مَسٍن يَشُبَ بّ،</para>
  <para style="q" vid="PSA 78:5">عَ سّرِيّ سَ عِسِرَيِلَ بْشِ كُي،</para>
  <para style="q" vid="PSA 78:5">عَ وٌن بٍنبَيٍ يَمَرِ عٍ شَ نَ مَسٍن عٍ شَ دِيٍ بّ،<verse eid="PSA 78:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 78:6"/>عَلَكٌ دِ نَشٍيٍ قَمَ تِنَ، نٍيٍ شَ نْ عَ كٌلٌندٍ،</para>
  <para style="q" vid="PSA 78:6">عٍ قَن شَ عَ مَسٍن عٍ فبٍ دِيٍ بّ عٍ قَمَ نَشٍيٍ بَرِدٍ.<verse eid="PSA 78:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 78:7"/>نَ كُي عٍ قَمَ عٍ شَ لَنلَنتٍيَ سَدٍ عَلَ مَ،</para>
  <para style="q" vid="PSA 78:7">عٍ مُ نّيمُمَ عَ شَ وَلِ شُنفبٍيٍ مَ،</para>
  <para style="q" vid="PSA 78:7">عٍ عٍ حْشْ سَمَ نّ عَ شَ يَامَرِيٍ شْن مَ.<verse eid="PSA 78:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 78:8"/>عٍ مُ لُمَ عَلْ عٍ بٍنبَيٍ،</para>
  <para style="q" vid="PSA 78:8">نَشٍيٍ تُلِ شْرْشْ، نَشٍيٍ قِندِ مَتَندِلَيٍ رَ،</para>
  <para style="q" vid="PSA 78:8">نَشٍيٍ تُن مُ رَبّشِ،</para>
  <para style="q" vid="PSA 78:8">نَشٍيٍ شَشِلِ مُ تِشِ عَلَ كٍرٍن نَ.<verse eid="PSA 78:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 78:9"/>عٍقِرَ مِكَيٍ شَلِ كَنيِيٍ نَشَ عٍ كٌبٍ سٌ فٍرٍ رَ،<verse eid="PSA 78:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 78:10"/>عٍ مُ عَلَ شَ سَاتّ رَكَمَلِ،</para>
  <para style="q" vid="PSA 78:10">عٍ مُ بِرَ عَ شَ سّرِيّ قْشْ رَ.<verse eid="PSA 78:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 78:11"/>عٍ نَشَ نّيمُ عَ شَ وَلِ مَفَاشُشِيٍ رَ،</para>
  <para style="q" vid="PSA 78:11">عَ نُن عَ شَ كَابَنَكٌي رَ عَ نَشٍيٍ مَسٍن عٍ بّ.<verse eid="PSA 78:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 78:12"/>عَ كَابَنَكٌ رَبَ نّ عٍ بٍنبَيٍ يَ شْرِ مِسِرَ، سٌوَن قِيلِ مَ.<verse eid="PSA 78:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 78:13"/>عَ نَشَ بَا عِبْو، عَ عٍ رَفِرِ، عَ يٍ رَتِ عَلْ بِلِشِ.<verse eid="PSA 78:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 78:14"/>عَ نَشَ عٍ رَحّرّ نُشُي سَابُي رَ يَنيِ رَ،</para>
  <para style="q" vid="PSA 78:14">عَ نَشَ عٍ رَحّرّ تّ يَنبّ رَ كْي رَ.<verse eid="PSA 78:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 78:15"/>عَ نَشَ قَنيٍ عِبْو فبٍنفبٍرٍنيِ مَ،</para>
  <para style="q" vid="PSA 78:15">عَ يٍ فبٍفبٍ رَ مِنِ نَ كُي عَلْ دَبٌنيِ.<verse eid="PSA 78:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 78:16"/>عَ نَشَ يٍ رَ مِنِ فّمّ لٌنفٌرِ رَ، عَ لُ عَلْ شُرٍ.<verse eid="PSA 78:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PSA 78:17"/>كْنْ عٍ مُ فبِلٍن عٍ شَ يُنُبِ رَبَقٍ قْشْ رَ،</para>
  <para style="q" vid="PSA 78:17">عٍ قَ عَلَ مَتَندِ فبٍنفبٍرٍنيِ مَ.<verse eid="PSA 78:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 78:18"/>عٍ نَشَ عَلَ مَتٌ دٌنسٍيٍ مَشْرِنقٍ رَ.<verse eid="PSA 78:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 78:19"/>عٍ نَشَ عَلَ مَبٍرٍ عَ قَلَقٍ رَ،</para>
  <para style="q" vid="PSA 78:19">«عَلَ نْمَ وٌن نَبَلٌدٍ يِ فبٍنفبٍرٍنيِ كُي؟<verse eid="PSA 78:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 78:20"/>عَ بَرَ يٍ رَ مِنِ قَنيٍ كُي،</para>
  <para style="q" vid="PSA 78:20">كْنْ عَ نْمَ تَامِ قَن قِدٍ عٍ مَ؟»<verse eid="PSA 78:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="PSA 78:21"/>عَلَ تٌ نَ مّ، عَ نَشَ شْنْ كِ قَنيِ رَ،</para>
  <para style="q" vid="PSA 78:21">عَ قَ تّ رَدّشّ يَشُبَ شَ حَمَ شِلِ مَ،</para>
  <para style="q" vid="PSA 78:21">عَ قَ شْنْ عِسِرَيِلَ حَمَ مَ،<verse eid="PSA 78:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 78:22"/>بَرِ مَ عٍ مُ نُ لَشِ عَلَ رَ،</para>
  <para style="q" vid="PSA 78:22">عٍ مُ عٍ شَشِلِ تِشِ عَ شَ كِسِ رَ.<verse eid="PSA 78:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 78:23"/>نَ كُي عَلَ نَشَ يَامَرِ قِ كٌورٍ نَادّيٍ شَ رَبِ،<verse eid="PSA 78:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 78:24"/>«مَنَ» شَ فٌرٌ عٍ مَ بَلٌي رَ،</para>
  <para style="q" vid="PSA 78:24">نَشَن قِندِ كٌورٍ تَامِ رَ.<verse eid="PSA 78:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 78:25"/>بِرِن نَشَ نَ سّنبّمَيٍ شَ تَامِ دٌن، عٍ قَ وَ سَ نَ رَ.<verse eid="PSA 78:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 78:26"/>عَلَ نَشَ قٌيٍ رَقَ كٍلِ سٌفٍتٍدٍ بِرِ،</para>
  <para style="q" vid="PSA 78:26">عَ قٌيٍ رَقَ عَ سّنبّ رَ كٍلِ يِرٍقَنيِ مَ،<verse eid="PSA 78:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 78:27"/>نَشَن عَ نِيَ شْنِيٍ شَ فٌرٌ عٍ مَ</para>
  <para style="q" vid="PSA 78:27">عَ فبٍفبٍ رَ عَلْ شُبٍ نُن بَا دّ مّيّنيِ.<verse eid="PSA 78:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 78:28"/>عَ نَشَ عٍ فبٍفبٍ رَيٌلٌن عٍ يٌنكِندٍ تَفِ،</para>
  <para style="q" vid="PSA 78:28">عٍ شَ كِرِ بَنشِيٍ رَبِلِنيِ مَ.<verse eid="PSA 78:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 78:29"/>عٍ نَشَ نَ دٌن هَن عٍ وَ سَ.</para>
  <para style="q" vid="PSA 78:29">عَلَ نُ بَرَ عٍ هَيِ لِ.<verse eid="PSA 78:29"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="30" style="v" sid="PSA 78:30"/>كْنْ هَلِ عٍ تٌ نُ بَرَ دٌنسٍ سْتْ،</para>
  <para style="q" vid="PSA 78:30">عَ مُ بُ <verse eid="PSA 78:30"/><verse number="31" style="v" sid="PSA 78:31"/>عَلَ شَ شْنّ مَن نَشَ فٌرٌ عٍ مَ،</para>
  <para style="q" vid="PSA 78:31">عَ عِسِرَيِلَ سّنبّمَيٍ نُن عٍ قٌنِكٍ قَشَ.<verse eid="PSA 78:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 78:32"/>هَلِ نَ بِرِن تٌ رَبَ، حَمَ مُ تِن فبِلٍندٍ عٍ شَ يُنُبِيٍ قْشْ رَ.</para>
  <para style="q" vid="PSA 78:32">عٍ مُ لَ عَلَ شَ كَابَنَكٌي رَ.<verse eid="PSA 78:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 78:33"/>نَ كُي عَ نَشَ عٍ لُ عٍ شَ قُيَنتٍ كُي،</para>
  <para style="q" vid="PSA 78:33">هَن عٍ شَ قٍ نَشَ رَحْن فَاشُي كُي.<verse eid="PSA 78:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 78:34"/>قٌ قَشّ نَ دُتُن عٍ مَ، عٍ قَ سٌ عَلَ قٍنقٍ،</para>
  <para style="q" vid="PSA 78:34">عٍ عٍ يّتّ رَفبِلٍن عَ مَ،<verse eid="PSA 78:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 78:35"/>عٍ عٍ رَتُ عَ عَلَ نَن عٍ سّنبّ رَ،</para>
  <para style="q" vid="PSA 78:35">عَ عَلَ شِلِ شُنفبٍ كَنيِ نَن عٍ رَكِسِمَ رَ.<verse eid="PSA 78:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 78:36"/>كْنْ عٍ نُ وَ مَ عَ مَدَشُقٍ عٍ شَ وْيّنيِيٍ نَن نَ،</para>
  <para style="q" vid="PSA 78:36">عٍ وُلٍ قَلَ عَ بّ عٍ دّ رَ.<verse eid="PSA 78:36"/></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 78:37"/>عَ شَ قٍ مُ نُ نَ عٍ بْحّ مَ،</para>
  <para style="q" vid="PSA 78:37">عٍ مُ نُ بِرَ مَ عَ شَ سَاتّ قْشْ رَ.<verse eid="PSA 78:37"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="38" style="v" sid="PSA 78:38"/>كْنْ عَلَ تٌ قِندِ هِننّنتٍ رَ،</para>
  <para style="q" vid="PSA 78:38">عَ نَشَ عٍ شَ يُنُبِيٍ شَقَرِ، عَ عٍ حَشَنكَتَقٍ لُ نَا.</para>
  <para style="q" vid="PSA 78:38">عَ نَشَ دِحّ عٍ مَ سَنيَ وُيَشِ،</para>
  <para style="q" vid="PSA 78:38">عَ مُ تِن عَ شَ شْنّ بِرِن شَ مِنِ.<verse eid="PSA 78:38"/></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 78:39"/>عَ نُ عَ كٌلٌن عَ بّندّ نَن تُن لَنشِ عٍ مَ،</para>
  <para style="q" vid="PSA 78:39">عٍ حّنفِ نَ دَن، عَ مُ فبِلٍن سْنْن.<verse eid="PSA 78:39"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="40" style="v" sid="PSA 78:40"/>سَنمَيَ يٍرِ عٍ مُرُتَمَ عَ مَ فبٍنفبٍرٍنيِ مَ،</para>
  <para style="q" vid="PSA 78:40">سَنمَيَ يٍرِ عٍ عَ رَشْنْمَ نَ يِرٍ مَشَرٍ مَ؟<verse eid="PSA 78:40"/></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 78:41"/>عٍ نُ لُمَ عَلَ مَتٌ رَ،</para>
  <para style="q" vid="PSA 78:41">عٍ نُ تِ عِسِرَيِلَ شَ سّنِيّنتْي كَنكٍ.<verse eid="PSA 78:41"/></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 78:42"/>عٍ مُ عٍ رَتُ عَ سّنبّ مَ.</para>
  <para style="q" vid="PSA 78:42">عٍ نّيمُ عَ مَ عَ عٍ رَكِسِ عٍ فٍرٍقَيٍ مَ تّمُي نَشّ.<verse eid="PSA 78:42"/></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 78:43"/>عٍ نّيمُ عَ شَ تْنشُمَيٍ مَ عَ نَشٍيٍ مَسٍن مِسِرَ بْشِ مَ.</para>
  <para style="q" vid="PSA 78:43">عٍ نّيمُ عَ شَ كَابَنَكٌي مَ عَ نَشٍيٍ رَبَ سٌوَن قِيلِ مَ.<verse eid="PSA 78:43"/></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 78:44"/>عَ نَشَ عٍ شَ نِلِ شُرٍ نُن عَ سَلٌنيِيٍ قِندِ وُلِ رَ</para>
  <para style="q" vid="PSA 78:44">هَن عٍ مُ نْ نَ يٍ مِندٍ.<verse eid="PSA 78:44"/></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 78:45"/>عَ نَشَ شّيرِيٍ رَدِن عٍ مَ عٍ هَلَكِقٍ رَ.</para>
  <para style="q" vid="PSA 78:45">عَ نَشَ لَنشَنسَرِ مَيٍ مَلَن مّننِ عٍ كَسَرَقٍ رَ.<verse eid="PSA 78:45"/></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 78:46"/>عَ نَشَ تُفُمِيٍ رَدِن عٍ شَ شّيٍ مَ،</para>
  <para style="q" vid="PSA 78:46">كَتٌي نَشَ شّ بٌفِ دٌن فبِكِ.<verse eid="PSA 78:46"/></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 78:47"/>عَ نَشَ عٍ شَ وّنِ سَنسِيٍ كَنَ بَلَبَلَنيِ رَ،</para>
  <para style="q" vid="PSA 78:47">عَ نَشَ عٍ شَ سِكٌمٌرٌ بِلِيٍ تُشُنسَن تُنّ شِنبٍلِ رَ.<verse eid="PSA 78:47"/></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 78:48"/>بَلَبَلَنيِ نَشَ عٍ شَ شُرُ سٍيٍ قَشَ،</para>
  <para style="q" vid="PSA 78:48">فَلَنيِ نَشَ عٍ شَ فْورّيٍ سْنتْ.<verse eid="PSA 78:48"/></para>
  <para style="q">
    <verse number="49" style="v" sid="PSA 78:49"/>عَ نَشَ عَ شَ شْنّ شْرْشْي رَ مِنِ عٍ مَ،</para>
  <para style="q" vid="PSA 78:49">عَ بْحّ نَشَ تٍ عٍ مَ،</para>
  <para style="q" vid="PSA 78:49">هَن عَ نَشَ مَلٍكّ كَسَرَتِيٍ رَفٌرٌ عٍ شِلِ مَ.<verse eid="PSA 78:49"/></para>
  <para style="q">
    <verse number="50" style="v" sid="PSA 78:50"/>عَ نَشَ عَ شَ شْنّ قُلُن عٍ مَ،</para>
  <para style="q" vid="PSA 78:50">عَ مُ عٍ نِي رَتَنفَ قَشّ مَ، عَ قٍ شْرْشْييٍ رَدِن عٍ مَ.<verse eid="PSA 78:50"/></para>
  <para style="q">
    <verse number="51" style="v" sid="PSA 78:51"/>عَ نَشَ مِسِرَ دِ سِنفٍ بِرِن قَشَ،</para>
  <para style="q" vid="PSA 78:51">عٍ هَمِ بْنسْييٍ قٌنِكٍ بِرِن قَشَ.<verse eid="PSA 78:51"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="52" style="v" sid="PSA 78:52"/>نَ نَن عَ رَ عَ نَشَ عَ شَ حَمَ رَ مِنِ عَلْ يّشّي فْورّ،</para>
  <para style="q" vid="PSA 78:52">عَ نَشَ عٍ رَحّرّ عَلْ شُرُ سٍيٍ فبٍنفبٍرٍنيِ مَ.<verse eid="PSA 78:52"/></para>
  <para style="q">
    <verse number="53" style="v" sid="PSA 78:53"/>عَ نَشَ عٍ شَنِن بْحّسَ كُي فَاشُي يٌ مُ عٍ سْتْ،</para>
  <para style="q" vid="PSA 78:53">كْنْ عَ نَشَ عٍ يَشُييٍ مَدُلَ بَا مَ.<verse eid="PSA 78:53"/></para>
  <para style="q">
    <verse number="54" style="v" sid="PSA 78:54"/>نَ كِ، عَ نَشَ عٍ شَنِن عَ شَ بْشِ سّنِيّنشِ مَ،</para>
  <para style="q" vid="PSA 78:54">عَ شَ فٍيَ عَ نَشَن سْتْ عَ سّنبّ رَ.<verse eid="PSA 78:54"/></para>
  <para style="q">
    <verse number="55" style="v" sid="PSA 78:55"/>عَ نَشَ بْنسْييٍ كٍرِ عٍ يَ رَ،</para>
  <para style="q" vid="PSA 78:55">عَ قَ نَ بْشِيٍ عِتَشُن عِسِرَيِلَ بْنسْييٍ مَ كّ رَ،</para>
  <para style="q" vid="PSA 78:55">عَ مّننِ قِندِ عٍ سَبَتِدٍ رَ.<verse eid="PSA 78:55"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="56" style="v" sid="PSA 78:56"/>كْنْ عٍ مَن نَشَ فٍرٍفِرِ عَلَ شِلِ شُنفبٍ كَنيِ مَ،</para>
  <para style="q" vid="PSA 78:56">عٍ تٌندِ عَ شَ يَامَرِيٍ رَبَتُدٍ.<verse eid="PSA 78:56"/></para>
  <para style="q">
    <verse number="57" style="v" sid="PSA 78:57"/>عٍ نَشَ عٍ مَكُيَ عَلَ رَ،</para>
  <para style="q" vid="PSA 78:57">عٍ قِندِ يَنقَنتٍ رَ عَلْ عٍ بٍنبَيٍ عَ رَبَشِ كِ نَشّ،</para>
  <para style="q" vid="PSA 78:57">عٍ لُ عَلْ شَلِ كَنَشِ.<verse eid="PSA 78:57"/></para>
  <para style="q">
    <verse number="58" style="v" sid="PSA 78:58"/>عٍ نَشَ عَ رَشْنْ عٍ شَ كُيٍ بَتُدٍيٍ رَ،</para>
  <para style="q" vid="PSA 78:58">عٍ عَ رَتْونّ عٍ شَ وُرِ مَسٌلِشِيٍ رَ.<verse eid="PSA 78:58"/></para>
  <para style="q">
    <verse number="59" style="v" sid="PSA 78:59"/>عَلَ تٌ نَ قٍ مّ، عَ نَشَ شْنْ كِ قَنيِ، عَ عِسِرَيِلَ رَبٌلٌ.<verse eid="PSA 78:59"/></para>
  <para style="q">
    <verse number="60" style="v" sid="PSA 78:60"/>عَ نَشَ عَ شَ لِنفِرَ رَبّحِن سِلٌ،</para>
  <para style="q" vid="PSA 78:60">عَ نُ نَشَن تِشِ مِشِيٍ تَفِ.<verse eid="PSA 78:60"/></para>
  <para style="q">
    <verse number="61" style="v" sid="PSA 78:61"/>عَ نَشَ عَ شَ سَاتّ كَنكِرَ لُ يَشُي سَفٌي،</para>
  <para style="q" vid="PSA 78:61">عٍ كَنكَن عَ شَ نْرّ شَ تْنشُمَ مَ.<verse eid="PSA 78:61"/></para>
  <para style="q">
    <verse number="62" style="v" sid="PSA 78:62"/>عَ تٌ شْنْ عَ شَ حَمَ عِسِرَيِلَ مَ،</para>
  <para style="q" vid="PSA 78:62">عَ نَشَ عَ نِيَ عٍ شَ سْنتْ سَنتِدّفّمَ رَ.<verse eid="PSA 78:62"/></para>
  <para style="q">
    <verse number="63" style="v" sid="PSA 78:63"/>عٍ شَ قٌنِكٍيٍ نَشَ فَن تّ رَ،</para>
  <para style="q" vid="PSA 78:63">عٍ شَ فِنّدِ مّدِيٍ مُ مَتْشْي سْتْ،<verse eid="PSA 78:63"/></para>
  <para style="q">
    <verse number="64" style="v" sid="PSA 78:64"/>عٍ شَ سّرّشّدُبّيٍ نَشَ قَشَ سَنتِدّفّمَ رَ،</para>
  <para style="q" vid="PSA 78:64">عٍ شَ كَاحّ فِنّيٍ قَن مُ وَ.<verse eid="PSA 78:64"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="65" style="v" sid="PSA 78:65"/>مَرِفِ نَشَ كٍلِ</para>
  <para style="q" vid="PSA 78:65">عَلْ مِشِ نَشَن كٍلِشِ شِ شْلِ مَ،</para>
  <para style="q" vid="PSA 78:65">عَلْ سْورِ نَشَن نْمَ عَ شَ سِيسِ رَ.<verse eid="PSA 78:65"/></para>
  <para style="q">
    <verse number="66" style="v" sid="PSA 78:66"/>عَ نَشَ عَ يَشُييٍ بْنبْ،</para>
  <para style="q" vid="PSA 78:66">عَ عٍ لُ يَافِ كُي نَشَن مُ حْنمَ.<verse eid="PSA 78:66"/></para>
  <para style="q">
    <verse number="67" style="v" sid="PSA 78:67"/>عَ نَشَ يُسُقُ بْنسْي رَبّحِن،</para>
  <para style="q" vid="PSA 78:67">عَ تٌندِ عٍقِرَ مِ بْنسْي سُفَندِدٍ.<verse eid="PSA 78:67"/></para>
  <para style="q">
    <verse number="68" style="v" sid="PSA 78:68"/>عَ نَشَ يُدَ بْنسْي سُفَندِ،</para>
  <para style="q" vid="PSA 78:68">عَ نُن سِيٌن فٍيَ نَشَن نُ رَقَنشِ عَ مَ.<verse eid="PSA 78:68"/></para>
  <para style="q">
    <verse number="69" style="v" sid="PSA 78:69"/>عَ نَشَ عَ شَ هْرْ مْلِنفِرَ تِ عَلْ يِرٍ عِتٍشِ،</para>
  <para style="q" vid="PSA 78:69">عَلْ عَ دُنِحَ تِشِ كِ نَشّ، عَ شَ بُ شْنكُيٍ رَ.<verse eid="PSA 78:69"/></para>
  <para style="q">
    <verse number="70" style="v" sid="PSA 78:70"/>عَ نَشَ عَ شَ كٌنيِ دَوُدَ سُفَندِ،</para>
  <para style="q" vid="PSA 78:70">عَ عَ تٌنفٌ فْورّ يَ مَ،<verse eid="PSA 78:70"/></para>
  <para style="q">
    <verse number="71" style="v" sid="PSA 78:71"/>عَ نُ مّينِقٍ يّشّي مَ دّننَشّ،</para>
  <para style="q" vid="PSA 78:71">عَلَكٌ عَ شَ مّينِ عَلَ شَ حَمَ مَ،</para>
  <para style="q" vid="PSA 78:71">نَشَن قِندِشِ يَشُبَ بْنسْي عِسِرَيِلَ رَ.<verse eid="PSA 78:71"/></para>
  <para style="q">
    <verse number="72" style="v" sid="PSA 78:72"/>دَوُدَ نَشَ مّينِ عٍ مَ عَ بْحّ قِيشّ رَ،</para>
  <para style="q" vid="PSA 78:72">عَ عٍ مَسُشُ شَشِلِمَيَ رَ.<verse eid="PSA 78:72"/></para>
  <chapter eid="PSA 78"/>
  <chapter number="79" style="c" sid="PSA 79"/>
  <para style="s1">عَلَ فبٍحْشْقٍ</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 79:1"/>عَسَقِ شَ بّيتِ</para>
  <para style="q" vid="PSA 79:1">عَلَ، سِيٍ بَرَ سٌ عِ شَ بْشِ كُي،</para>
  <para style="q" vid="PSA 79:1">عٍ عِ شَ هْرْ مْلِنفِرَ قِندِ يِرٍ سّنِيّنتَرٍ رَ،</para>
  <para style="q" vid="PSA 79:1">عٍ دَرِ سَلَمُ كَنَ.<verse eid="PSA 79:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 79:2"/>عٍ بَرَ عِ شَ كٌنيِيٍ قُرٍيٍ قِندِ شْنِيٍ شَ بَلٌي رَ،</para>
  <para style="q" vid="PSA 79:2">عٍ بَرَ عِ شَنُنتٍنيِيٍ سٌ وُلَءِ سُبٍ يِ رَ.<verse eid="PSA 79:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 79:3"/>عٍ بَرَ عٍ سْنتْ دَرِ سَلَمُ رَبِلِنيِ، عٍ مُ رَفَتَ.<verse eid="PSA 79:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 79:4"/>سِ نَشٍيٍ نَ مُشُ رَبِلِنيِ عٍ مُشُ كٌنبِمَ،</para>
  <para style="q" vid="PSA 79:4">عٍ يٌمَ مُشُ مَ.<verse eid="PSA 79:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 79:5"/>عَلَتَلَ، عِ شْنْمَ نّ مُشُ مَ عَبَدَن؟</para>
  <para style="q" vid="PSA 79:5">عِ شَ تْونّ دَنمَ مُن تّمُي؟<verse eid="PSA 79:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 79:6"/>عِ شَ شْنْ حَمَنّيٍ مَ نَشٍيٍ مُ عِ كٌلٌن،</para>
  <para style="q" vid="PSA 79:6">عِ شَ شْنْ مَنفّيَيٍ مَ نَشٍيٍ مُ عِ بَتُمَ،<verse eid="PSA 79:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 79:7"/>بَرِ مَ عٍ بَرَ عِسِرَيِلَ شُن نَكَنَ،</para>
  <para style="q" vid="PSA 79:7">عٍ بَرَ عَ شَ لِنفِرَ رَبِرَ.<verse eid="PSA 79:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 79:8"/>عِ نَشَ رَتُ مُشُ شَ يُنُبِ دَنفِشِيٍ مَ.</para>
  <para style="q" vid="PSA 79:8">عِ شَ هِننّ مُشُ رَ مَقُرٍن،</para>
  <para style="q" vid="PSA 79:8">بَرِ مَ سّنبّ يٌ مُ نَ مُشُ بّ سْنْن.<verse eid="PSA 79:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 79:9"/>كَقُ مُشُ مَ، مُشُ رَكِسِمَ عَلَ،</para>
  <para style="q" vid="PSA 79:9">عِ شِلِ شَ نْرّ شَ قٍ رَ.</para>
  <para style="q" vid="PSA 79:9">عِ شَ مُشُ رَكِسِ،</para>
  <para style="q" vid="PSA 79:9">عِ شَ مُشُ شَ يُنُبِيٍ شَقَرِ عِ شِلِ شَ قٍ رَ.<verse eid="PSA 79:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 79:10"/>مُنقٍ رَ حَمَنّيٍ عَ قَلَمَ،</para>
  <para style="q" vid="PSA 79:10">«عٍ مَرِفِ عَلَ نَ مِندٍن؟»</para>
  <para style="q" vid="PSA 79:10">عٍ شَ عَ كٌلٌن عِ قَمَ عِ شَ كٌنيِيٍ وُلِ فبٍحْشْدٍ مُشُ يَ شْرِ.<verse eid="PSA 79:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 79:11"/>عِ شَ عِ تُلِ مَتِ فٍيلِمَنِيٍ وَ شُي رَ،</para>
  <para style="q" vid="PSA 79:11">عِ سّنبّ شَ نٍيٍ رَكِسِ نَشٍيٍ شَ كِيتِسَيٍ وَ مَ عٍ قَشَقٍ.<verse eid="PSA 79:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 79:12"/>ﭑ مَرِفِ، عِ شَ سَرٍ دْشْ سٌلٌقٍرٍ رَفبِلٍن نَ سِيٍ مَ،</para>
  <para style="q" vid="PSA 79:12">نَشٍيٍ بَرَ عِ بّشُ.<verse eid="PSA 79:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 79:13"/>نَ كُي، مُشُ تَن عِ شَ حَمَ قَن قَمَ نّ عِ بَتُدٍ،</para>
  <para style="q" vid="PSA 79:13">مُشُ تَن عِ شَ شُرُ سٍيٍ قَمَ نّ عِ شَ مَتْشْي مَسٍندٍ مُشُ بْنسْي بّ عَبَدَن.<verse eid="PSA 79:13"/></para>
  <chapter eid="PSA 79"/>
  <chapter number="80" style="c" sid="PSA 80"/>
  <para style="s1">عَلَ مّينِقٍ عَ شَ سَنسِيٍ مَ</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 80:1"/>عَسَقِ شَ بّيتِ بّيتِبَيٍ شَ مَنفّ بّ. عَ شَ بَ عَلْ بّيتِ نَشَن شِلِ «قُفٍ تٌقَنيِيٍ عَلْ عَلَ شَ سَاتّ.»<verse eid="PSA 80:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 80:2"/>عِسِرَيِلَ كَنتَمَ، عِ عِ تُلِ مَتِ ﭑ نَ،</para>
  <para style="q" vid="PSA 80:2">عِ تَن نَشَن يُسُقُ بْنسْي رَحّرّ مَ عَلْ شُرُ سٍ فْورّ.</para>
  <para style="q" vid="PSA 80:2">عِ شَ عِ شَ نْرّ مَسٍن،</para>
  <para style="q" vid="PSA 80:2">عِ تَن نَشَن مَفٌرٌشِ مَلٍكّ مَسٌلِشِيٍ تَفِ.<verse eid="PSA 80:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 80:3"/>عِ سّنبّ رَ مِنِ عٍقِرَ مِ، بُنيَمِن، نُن مَنَسِ بْنسْي يَ عِ،</para>
  <para style="q" vid="PSA 80:3">عِ شَ مُشُ رَكِسِ.<verse eid="PSA 80:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 80:4"/>عَلَ، عِ شَ مُشُ رَفبِلٍن،</para>
  <para style="q" vid="PSA 80:4">عِ شَ هِننّ مُشُ رَ عَلَكٌ مُشُ شَ كِسِ سْتْ.<verse eid="PSA 80:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 80:5"/>مَنفّ عَلَ، عِ تٌندِ مَ عِ شَ حَمَ شَ مَشَندِ سُشُدٍ</para>
  <para style="q" vid="PSA 80:5">عِ شَ شْنّ شَ قٍ رَ هَن مُن تّمُي؟<verse eid="PSA 80:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 80:6"/>عِ عٍ رَبَلٌمَ عٍ يَيٍ رَ،</para>
  <para style="q" vid="PSA 80:6">عِ عٍ يَيٍ قِمَ عٍ مَ مِنسٍ رَ هَن مُن تّمُي؟<verse eid="PSA 80:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 80:7"/>عِ بَرَ لَنتَرٍيَ رَ سٌ مُشُ نُن مُشُ دْشْبٌورٍيٍ تَفِ،</para>
  <para style="q" vid="PSA 80:7">عٍ يٌمَ مُشُ مَ.<verse eid="PSA 80:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 80:8"/>مَنفّ عَلَ، عِ شَ مُشُ رَفبِلٍن،</para>
  <para style="q" vid="PSA 80:8">عِ شَ هِننّ مُشُ رَ عَلَكٌ مُشُ شَ كِسِ سْتْ.<verse eid="PSA 80:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 80:9"/>عِ وّنِ بِلِ ندٍ تَلَ نّ مِسِرَ نَشَن قِندِشِ عِ شَ حَمَ رَ.</para>
  <para style="q" vid="PSA 80:9">عِ نَشَ سِيٍ ندٍيٍ كٍرِ يِرٍ ندٍ، عِ قَ عَ تَن سِ نَا.<verse eid="PSA 80:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 80:10"/>عِ تٌ نَ يِرٍ يَءِلَن عَ بّ،</para>
  <para style="q" vid="PSA 80:10">عَ نَشَ عَ سَنكٍيٍ مَسْرْن، عَ بْشِ رَقٍ.<verse eid="PSA 80:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 80:11"/>فٍيَيٍ نَشَ لُ عَ شَ نِينِ بُن مَ،</para>
  <para style="q" vid="PSA 80:11">عَ سَلٌنيِيٍ نُ شُنفبٌ عَلْ سّدِرِ وُرِيٍ.<verse eid="PSA 80:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 80:12"/>عَ سَلٌنيِيٍ نُ كُيَ رَ هَن عٍ بَا نُن شُرٍ دّ لِ.<verse eid="PSA 80:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 80:13"/>كْنْ عِ تَن بَرَ عَ شَ تّتّ كَنَ،</para>
  <para style="q" vid="PSA 80:13">دَنفِ مِشِيٍ قَ عَ بٌفِ بَ.<verse eid="PSA 80:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 80:14"/>وُلَءِ شْسّيٍ نَا يٍفٍلٍنمَ،</para>
  <para style="q" vid="PSA 80:14">بُورُنيِ سُبٍيٍ قَن بَلٌمَ عَ بٌفِيٍ رَ. مُنقٍ رَ؟<verse eid="PSA 80:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PSA 80:15"/>مَنفّ عَلَ يَندِ، عِ شَ فبِلٍن قَ رَ،</para>
  <para style="q" vid="PSA 80:15">عِ يَ رَفٌرٌ مُشُ مَ كٍلِ كٌورٍ،</para>
  <para style="q" vid="PSA 80:15">عِ مُشُ مَتٌ، كِنِكِنِ نَ وّنِ بِلِ مَ،<verse eid="PSA 80:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 80:16"/>عِ نَشَن سِ عِ يّتّ بّ عِ بّلّشّ رَ.<verse eid="PSA 80:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 80:17"/>يَكْسِ عَ بَرَ فَن، عَ سّفّ عِ شَ شْنّ سَابُي رَ.<verse eid="PSA 80:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 80:18"/>عِ بّلّشّ شَ لُ عَدَ مَ شَ دِ مَ، نَشَن نَ عِ يِرٍقَنيِ مَ،</para>
  <para style="q" vid="PSA 80:18">عِ نَشَن شُن نَكٍلِشِ.<verse eid="PSA 80:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 80:19"/>مُشُ مُ مُشُ مَكُيَمَ عِ رَ سْنْن.</para>
  <para style="q" vid="PSA 80:19">عِ شَ كِسِ قِ مُشُ مَ عَلَكٌ مُشُ مَن شَ عِ بَتُ.<verse eid="PSA 80:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 80:20"/>مَنفّ عَلَ، عِ شَ مُشُ رَفبِلٍن،</para>
  <para style="q" vid="PSA 80:20">عِ شَ هِننّ مُشُ رَ عَلَكٌ مُشُ شَ كِسِ سْتْ.<verse eid="PSA 80:20"/></para>
  <chapter eid="PSA 80"/>
  <chapter number="81" style="c" sid="PSA 81"/>
  <para style="s1">تُلِ مَتِقٍ عَلَ مَ</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 81:1"/>عَسَقِ شَ بّيتِ بّيتِبَيٍ شَ مَنفّ بّ. عَ شَ بَ مَشَسٍ لُوتِ دَاشِ شُي رَ.<verse eid="PSA 81:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 81:2"/>وٌ شَ سّيوَ شُي رَتٍ عَلَ مَ،</para>
  <para style="q" vid="PSA 81:2">نَشَن قِندِشِ وٌن سّنبّ رَ.</para>
  <para style="q" vid="PSA 81:2">وٌ وٌ شُي رَ سِفَ يَشُبَ مَرِفِ عَلَ مَ.<verse eid="PSA 81:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 81:3"/>وٌ شَ بّيتِ بَ مَشَسٍ نُن كْرَ شُي رَ.<verse eid="PSA 81:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 81:4"/>وٌ شَ قٍرِ قٍ كِكٍ نّينّ تٍ تّمُي،</para>
  <para style="q" vid="PSA 81:4">وٌن مَ سَلِ لْشْي نَ عَ رَ.<verse eid="PSA 81:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 81:5"/>نَ قِندِشِ عَلَ شَ سّرِيّ نَن نَ عِسِرَيِلَ بّ،</para>
  <para style="q" vid="PSA 81:5">يَشُبَ مَرِفِ عَلَ شَ يَامَرِ نَ عَ رَ.<verse eid="PSA 81:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 81:6"/>يَامَرِ نَ عَ رَ عَلَ نَشَن سٌ يُسُقُ بْنسْي يِ رَ،</para>
  <para style="q" vid="PSA 81:6">عَ تٌ مِنِ مِسِرَ بْشِ شِلِ مَ.</para>
  <para style="b" vid="PSA 81:6"/>
  <para style="q" vid="PSA 81:6">ﭑ نَشَ شُي ندٍ مّ ﭑ مُ نَشَن كٌلٌن، عَ نَشّ،<verse eid="PSA 81:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 81:7"/>«ﭑ بَرَ كٌتٍ بَ عٍ شُن مَ،</para>
  <para style="q" vid="PSA 81:7">ﭑ بَرَ دٍبٍ بِنيٍ بَ عٍ بّلّشّيٍ.<verse eid="PSA 81:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 81:8"/>وٌ تٌ ﭑ شِلِ وٌ شَ حَشَنكَتّ كُي،</para>
  <para style="q" vid="PSA 81:8">ﭑ نَشَ وٌ رَكِسِ، ﭑ نَشَ وٌ يَابِ كٍلِقٍ سٍسَرِنيِ يِرٍ،</para>
  <para style="q" vid="PSA 81:8">ﭑ نَشَ وٌ مَتٌ مٍرِبَ يٍ يِرٍ.<verse eid="PSA 81:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 81:9"/>ﭑ مَ حَمَ عِسِرَيِلَ، وٌ وٌ تُلِ مَتِ ﭑ مَ مَرَ سِ رَ.<verse eid="PSA 81:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 81:10"/>وٌ نَشَ عَلَ فبّتّ بَتُ،</para>
  <para style="q" vid="PSA 81:10">وٌ نَشَ وٌ شِنبِ سِن عَلَ فبّتّ مَ.<verse eid="PSA 81:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 81:11"/>ﭑ تَن نَن نَ وٌ مَرِفِ عَلَ رَ،</para>
  <para style="q" vid="PSA 81:11">نَشَن وٌ رَ مِنِ مِسِرَ بْشِ رَ.</para>
  <para style="q" vid="PSA 81:11">وٌ وٌ دّ رَبِ عَ بٍلٍبٍلٍ رَ، ﭑ عَ رَقٍمَ نّ.»<verse eid="PSA 81:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 81:12"/>«كْنْ ﭑ مَ حَمَ مُ عَ تُلِ مَتِشِ ﭑ نَ،</para>
  <para style="q" vid="PSA 81:12">عِسِرَيِلَ مُ ﭑ شُي رَتِنمّ.<verse eid="PSA 81:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 81:13"/>نَ كُي ﭑ نَشَ عٍ لُ عٍ شَ بْحّ شْرْشْيَ كُي،</para>
  <para style="q" vid="PSA 81:13">عٍ شَ حّرّ عٍ يّتّ شَشِلِ مَ.<verse eid="PSA 81:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 81:14"/>شَ عَ سَ لِ نُ ﭑ مَ حَمَ نَشَ عَ تُلِ مَتِ ﭑ نَ،</para>
  <para style="q" vid="PSA 81:14">شَ عِسِرَيِلَ سَ تِن ﭑ مَ كِرَ رَ نُ،<verse eid="PSA 81:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 81:15"/>ﭑ قَمَ نّ عَ يَشُي بِرِن نَيَافِدٍ كٍرٍن نَ،</para>
  <para style="q" vid="PSA 81:15">ﭑ عٍ رَفٌرٌ تّمُي بِرِن.<verse eid="PSA 81:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 81:16"/>عَلَتَلَ يَشُييٍ قَمَ فَاشُدٍ عَ يَ رَ،</para>
  <para style="q" vid="PSA 81:16">عٍ هَلَكِ عَبَدَن.<verse eid="PSA 81:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 81:17"/>كْنْ ﭑ وٌ تَن بَلٌمَ نّ دٌنسٍ قَنيِ رَ،</para>
  <para style="q" vid="PSA 81:17">ﭑ كُمِ رَ مِنِمَ نّ فّمّ كُي وٌ بّ.»<verse eid="PSA 81:17"/></para>
  <chapter eid="PSA 81"/>
  <chapter number="82" style="c" sid="PSA 82"/>
  <para style="s1">عَلَ شَ كِيتِ عَ شَ سّنبّمَيٍ بّ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 82:1"/>عَسَقِ شَ بّيتِ</para>
  <para style="q" vid="PSA 82:1">عَلَ تِشِ عَ شَ مَلَنيِ يَ رَ،</para>
  <para style="q" vid="PSA 82:1">عَ كِيتِ سَقٍ كٌورٍ سّنبّمَيٍ يَ مَ.<verse eid="PSA 82:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 82:2"/>«وٌ كِيتِ سَمَ كٌبِحَ رَ هَن مُن تّمُي؟</para>
  <para style="q" vid="PSA 82:2">وٌ نْندِ قِمَ مِشِ حَاشِيٍ مَ مُنقٍ رَ؟<verse eid="PSA 82:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 82:3"/>وٌ شَ مِسِكِينّيٍ نُن كِرِدِيٍ شَ كِيتِ سَ سّرِيّ كِ مَ.</para>
  <para style="q" vid="PSA 82:3">وٌ شَ سٍتَرٍيٍ نُن قُشَرِلَيٍ رَتَنفَ كِيتِ حَاشِ مَ.<verse eid="PSA 82:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 82:4"/>وٌ شَ سٍتَرٍيٍ نُن تْورْ مِشِيٍ رَكِسِ.</para>
  <para style="q" vid="PSA 82:4">وٌ شَ عٍ بَ مِشِ كٌبِيٍ بّلّشّيٍ عِ.»<verse eid="PSA 82:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 82:5"/>كْنْ عٍ مُ قَهَامُي سْتْ نَ قٍقٍ مَ.</para>
  <para style="q" vid="PSA 82:5">عٍ عٍ حّرّ مَ دِ مِ نَن كُي تُن.</para>
  <para style="q" vid="PSA 82:5">دُنِحَ سَنبُنيِ بِرِن سّرّنمَ.<verse eid="PSA 82:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 82:6"/>ﭑ عَ قَلَ نّ، «كٌورٍ سّنبّمَيٍ نَن وٌ رَ،</para>
  <para style="q" vid="PSA 82:6">عَلَ شِلِ شُنفبٍ كَنيِ شَ دِيٍ نَن وٌ بِرِن نَ،<verse eid="PSA 82:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 82:7"/>كْنْ وٌ قَشَمَ نّ عَلْ عَدَ مَدِيٍ،</para>
  <para style="q" vid="PSA 82:7">وٌ بِرَ مَ نّ عَلْ دُنِحَ مَنفّيٍ.»<verse eid="PSA 82:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 82:8"/>عِ تَن عَلَ، كٍلِ، عِ شَ دُنِحَ مَكِيتِ،</para>
  <para style="q" vid="PSA 82:8">بَرِ مَ عِ تَن نَن فبٍ نَ سِيٍ بِرِن نَ.<verse eid="PSA 82:8"/></para>
  <chapter eid="PSA 82"/>
  <chapter number="83" style="c" sid="PSA 83"/>
  <para style="s1">عِسِرَيِلَ يَشُييٍ</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 83:1"/>عَسَقِ شَ بّيتِ<verse eid="PSA 83:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 83:2"/>عٍٍ عَلَ، عِ نَشَ عِ سَبَرِ!</para>
  <para style="q" vid="PSA 83:2">عَلَ، عِ نَشَ لُ دُندُي كُي،<verse eid="PSA 83:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 83:3"/>بَرِ مَ عِ يَشُييٍ مُ عٍ رَشَرَشِ،</para>
  <para style="q" vid="PSA 83:3">عِ شْنمَيٍ بَرَ عٍ شُنيِيٍ عِكٍلِ.<verse eid="PSA 83:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 83:4"/>عٍ نَ يَنقّ شْرْشْي مَشِرِقٍ عِ شَ حَمَ شِلِ مَ،</para>
  <para style="q" vid="PSA 83:4">عٍ نَ عٍ بٌورٍ بْحّ رَتٍقٍ عِ شَنُنتٍنيِيٍ شِلِ مَ.<verse eid="PSA 83:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 83:5"/>عٍ نَشّ، «وٌن شَ عٍ شِلِ حْن سِيٍ يَ مَ،</para>
  <para style="q" vid="PSA 83:5">عَلَكٌ بِرِن شَ نّيمُ عِسِرَيِلَ شِلِ مَ.»<verse eid="PSA 83:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 83:6"/>عٍ بَرَ لَن عٍ بٌورٍ مَ عِ شِلِ مَ.<verse eid="PSA 83:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 83:7"/>عٍدٌنكَيٍ، سُمَيِلَ بْنسْي، مٌوَبَكَيٍ، هَفَرِكَيٍ،<verse eid="PSA 83:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 83:8"/>فٍبَلَكَيٍ، عَمٌنِكَيٍ، عَمَلّكِكَيٍ،</para>
  <para style="q" vid="PSA 83:8">قِلِسِتَكَيٍ، تِرٍكَيٍ،<verse eid="PSA 83:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 83:9"/>نُن عَسِرِيَكَيٍ بِرِن بَرَ كَقُ لٌتِ بْنسْي مَ.<verse eid="PSA 83:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 83:10"/>عِ شَ عٍ بْنبْ عَلْ عِ عَ رَبَ مَدِيَنكَيٍ رَ كِ نَشّ.</para>
  <para style="q" vid="PSA 83:10">عِ شَ عٍ بْنبْ عَلْ عِ عَ رَبَ مَنفّ يَبِنِ نَ كِ نَشّ،</para>
  <para style="q" vid="PSA 83:10">عَ نُن عَ شَ سْورِ مَنفّ سِسٍرَ رَ كِ نَشّ كِسٌن شُرٍ يِرٍ.<verse eid="PSA 83:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 83:11"/>عٍ سْنتْ نّ عٍندٌرِ،</para>
  <para style="q" vid="PSA 83:11">عٍ قُرٍ نَشَ لُ بْشِ مَ، عٍ مُ رَفَتَ.<verse eid="PSA 83:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 83:12"/>عِ شَ قٍ شْرْشْي رَبَ عٍ شَ كُنتِفِيٍ رَ،</para>
  <para style="q" vid="PSA 83:12">عَلْ عِ رَبَ عٌرٍبِ نُن سٍيبِ رَ كِ نَشّ.</para>
  <para style="q" vid="PSA 83:12">عٍ شَ يَرٍرَتِيٍ شَ لُ عَلْ سّبَ نُن سَلَمُنَ، نَشٍيٍ عَ قَلَ،<verse eid="PSA 83:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 83:13"/>«وٌن شَ عَلَ شَ حَمَ شَ بْشِ قِندِ وٌن فبٍ رَ.»<verse eid="PSA 83:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 83:14"/>ﭑ مَرِفِ عَلَ، عِ شَ نَ مِشِيٍ لُ عَلْ سّشّ، قٌيٍ نَشَن شَنِنمَ.<verse eid="PSA 83:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 83:15"/>عِ شَ عٍ شُن نَكَنَ عَلْ تّ قْتْنيِ فَنمَ كِ نَشّ فٍيَيٍ قَرِ.<verse eid="PSA 83:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 83:16"/>عِ شَ بِرَ عٍ قْشْ رَ شْنّ كُي عَلْ تُرُننَادّ مَفَاشُشِ.<verse eid="PSA 83:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 83:17"/>مَرِفِ، عِ شَ عٍ رَيَافِ عَلَكٌ عٍ شَ فبِلٍن عِ مَ.<verse eid="PSA 83:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 83:18"/>يَافِ نُن فَاشُي شَ لُ عٍ بْحّ مَ،</para>
  <para style="q" vid="PSA 83:18">عِ شَ عٍ بْنسْي رَحْن عَبَدَن.<verse eid="PSA 83:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 83:19"/>عٍ شَ عَ كٌلٌن عَ عِ تَن نَن شِلِ عَلَتَلَ،</para>
  <para style="q" vid="PSA 83:19">عَ عَلَ شِلِ شُنفبٍ كَنيِ نَ عِ تَن نَن نَ دُنِحَ شُن نَ.<verse eid="PSA 83:19"/></para>
  <chapter eid="PSA 83"/>
  <chapter number="84" style="c" sid="PSA 84"/>
  <para style="s1">سِفَقٍ رَ سَلِدٍ شُنفبٍ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 84:1"/>كٌرَ شَ دِيٍ شَ بّيتِ بّيتِبَيٍ شَ مَنفّ بّ. عَ شَ بَ مَشَسٍ لُوتِ دَاشِ شُي رَ.<verse eid="PSA 84:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 84:2"/>مَنفّ عَلَتَلَ، عِ شَ لِنفِرَ تٌقَن!<verse eid="PSA 84:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 84:3"/>ﭑ وَ مَ سٌقٍ عِ شَ تّتّ كُي ﭑ بْحّ بِرِن نَ.</para>
  <para style="q" vid="PSA 84:3">نَ وَشْنيِ مِنِمَ ﭑ دّ عِ عِ تَن عَلَ نَن بّ، عِ تَن نَشَن حِحّ عَ رَ.<verse eid="PSA 84:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 84:4"/>هَلِ شْنِ شُنشُرِيٍ عَلْ تُرُننَ نُن دٍبٍلِنيِ</para>
  <para style="q" vid="PSA 84:4">عٍ تّي سَمَ عِ شَ سّرّشّبَدٍ سّيتِ مَ عٍ شَ دِيٍ لُمَ دّننَشّ.</para>
  <para style="q" vid="PSA 84:4">عِ تَن عَلَتَلَ سّنبّمَ، ﭑ مَ مَنفّ نُن ﭑ مَرِفِ،<verse eid="PSA 84:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 84:5"/>سّيوّ نَ مِشِيٍ بّ، نَشٍيٍ سَبَتِشِ عِ شَ بَنشِ كُي.</para>
  <para style="q" vid="PSA 84:5">عٍ لُمَ عِ مَتْشْ رَ دّننَشّ عَبَدَن. <char style="qs">حّنفِ رَتٍ.</char><verse eid="PSA 84:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 84:6"/>سّيوّ نَ مِشِيٍ بّ نَشٍيٍ سّنبّ لَنشِ عِ تَن عَلَ مَ،</para>
  <para style="q" vid="PSA 84:6">نَشٍيٍ كِرَ سُشُشِ سِفَقٍ رَ سَلِدٍ شُنفبٍ.<verse eid="PSA 84:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 84:7"/>عٍ بَكَ فُلُنبَ عِفِرِ مَ تّمُي نَشّ،</para>
  <para style="q" vid="PSA 84:7">عٍ يٍ دُلٌنيِيٍ تٌ نّ، تُنّ يٍ فبٍفبٍ بَرَ نَا رَقٍ.<verse eid="PSA 84:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 84:8"/>عٍ كٍلِ يِرٍ قَنيِ ندٍ، عٍ سِفَ يِرٍ قَنيِ فبّتّ.</para>
  <para style="q" vid="PSA 84:8">عٍ نَ بِرِن تٌ نّ كِرَ شْن سِفَقٍ رَ عَلَ يِرٍ</para>
  <para style="q" vid="PSA 84:8">عٍ عٍ يّتّ مَسٍن عَ بّ دّننَشّ.<verse eid="PSA 84:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 84:9"/>ﭑ مَرِفِ عَلَتَلَ سّنبّمَ، ﭑ مَ دُبّ سُشُ!</para>
  <para style="q" vid="PSA 84:9">يَشُبَ مَرِفِ عَلَ، عِ ﭑ مَ مَشَندِ رَ مّ. <char style="qs">حّنفِ رَتٍ.</char><verse eid="PSA 84:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 84:10"/>عَلَ، هِننّ عِ شَ مِشِ سُفَندِشِ رَ</para>
  <para style="q" vid="PSA 84:10">نَشَن قِندِشِ مُشُ شَ وُرٍ لٍقَ رَ.<verse eid="PSA 84:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 84:11"/>شِ كٍرٍن نَدَنفِقٍ عِ شَ بَنشِ كُي،</para>
  <para style="q" vid="PSA 84:11">نَ حْشُن دَنفِقٍ شِ وُلُ وُلُ رَ يِرٍ فبّتّ.</para>
  <para style="q" vid="PSA 84:11">ﭑ لُقٍ عِ شَ بَنشِ دّ رَ، نَ قَن لُقٍ رَ تِنشِنتَرٍيٍ شْنيِ،<verse eid="PSA 84:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 84:12"/>بَرِ مَ عَلَ شُنفبٍ قِندِشِ وٌن مَ كَنتَرِ نَن نَ،</para>
  <para style="q" vid="PSA 84:12">عَ هِننّ نُن بِنيّ قِمَ نّ وٌن مَ.</para>
  <para style="q" vid="PSA 84:12">عَ مُ تٌندِ مَ تِنشِنتَرٍيٍ كِدٍ هّيرِ رَ.<verse eid="PSA 84:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 84:13"/>مَرِفِ سّنبّمَ، هّيرِ نَ مِشِ بّ نَشَن عَ يّتّ تَشُمَ عِ رَ.<verse eid="PSA 84:13"/></para>
  <chapter eid="PSA 84"/>
  <chapter number="85" style="c" sid="PSA 85"/>
  <para style="s1">عَلَ شَ هِننّ</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 85:1"/>كٌرَ شَ دِيٍ شَ بّيتِ بّيتِبَيٍ شَ مَنفّ بّ<verse eid="PSA 85:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 85:2"/>مَرِفِ، عِ شَنُنتٍيَ مَسٍنمَ عِ شَ حَمَ بّ،</para>
  <para style="q" vid="PSA 85:2">عِ يَشُبَ بْنسْي شُن نَكٍلِمَ.<verse eid="PSA 85:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 85:3"/>عِ دِحّمَ عِ شَ حَمَ شَ قٍ حَاشِيٍ مَ،</para>
  <para style="q" vid="PSA 85:3">عِ عَ شَ يُنُبِيٍ بِرِن شَقَرِ مَ. <char style="qs">حّنفِ رَتٍ.</char><verse eid="PSA 85:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 85:4"/>عِ عِ شَ شْنّ رَفبِلٍنمَ عَ قْشْ رَ،</para>
  <para style="q" vid="PSA 85:4">عِ دِحّمَ عَ مَ.<verse eid="PSA 85:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 85:5"/>عَلَ، عِ مَن شَ مُشُ رَكِسِ،</para>
  <para style="q" vid="PSA 85:5">عِ مَن شَ هِننّ مُشُ رَ.<verse eid="PSA 85:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 85:6"/>عِ شْنْمَ نّ مُشُ مَ عَبَدَن؟</para>
  <para style="q" vid="PSA 85:6">نَ شْنّ مُ بَمَ مُشُ شَ يِ وَشَتِ كُي؟<verse eid="PSA 85:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 85:7"/>عِ مُ نْمَ دِحّدٍ مُ مَ،</para>
  <para style="q" vid="PSA 85:7">عِ شَ حَمَ شَ كِسِ، عٍ شَ سّيوَ؟<verse eid="PSA 85:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 85:8"/>عَلَتَلَ، عِ شَ دُفُتّفّحَ مَسٍن مُشُ بّ، عِ شَ مُشُ رَكِسِ.<verse eid="PSA 85:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 85:9"/>ﭑ نَن ﭑ تُلِ مَتِمَ نّ ﭑ مَرِفِ عَلَ شَ مَسٍنيِ رَ،</para>
  <para style="q" vid="PSA 85:9">بَرِ مَ عَ بْحّسَ نَن قِمَ عَ شَ حَمَ تِنشِنشِ مَ.</para>
  <para style="q" vid="PSA 85:9">عَلَ شَ عٍ مَلِ فبِلٍنقٍ رَ عٍ شَ دَشُحَ مَ.<verse eid="PSA 85:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 85:10"/>عَ كِسِ يَتِ يَتِ نَن قِمَ مِشِيٍ مَ نَشٍيٍ فَاشُمَ عَ يَ رَ،</para>
  <para style="q" vid="PSA 85:10">عَلَكٌ عَ شَ نْرّ شَ سَبَتِ وٌن مَ بْشِ كُي.<verse eid="PSA 85:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 85:11"/>دُفُتّفّحَ نُن نْندِ نَ يِرٍ كٍرٍن.</para>
  <para style="q" vid="PSA 85:11">تِنشِنيِ نُن بْحّسَ حّرّ مَ كِرَ كٍرٍن شْن.<verse eid="PSA 85:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 85:12"/>نْندِ كٍلِمَ لَنبَنيِ مَ،</para>
  <para style="q" vid="PSA 85:12">تِنشِنيِ كٍلِمَ كٌورٍ مَ.<verse eid="PSA 85:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 85:13"/>عَلَتَلَ هّرِ قِمَ نّ وٌن مَ،</para>
  <para style="q" vid="PSA 85:13">عَلَكٌ وٌن مَ بْشِ شَ دَشَمُي رَ مِنِ.<verse eid="PSA 85:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 85:14"/>تِنشِنيِ حّرّ مَ عَ يَ رَ،</para>
  <para style="q" vid="PSA 85:14">عَ قِندِ سَنيِ قْشِ رَ كِرَ شْن مَ.<verse eid="PSA 85:14"/></para>
  <chapter eid="PSA 85"/>
  <chapter number="86" style="c" sid="PSA 86"/>
  <para style="s1">ﭑ هَيِ نَ عَلَ مَ</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 86:1"/>دَوُدَ شَ عَلَ مَشَندِ</para>
  <para style="q" vid="PSA 86:1">مَرِفِ، عِ عِ تُلِ مَتِ ﭑ نَ، عِ شَ ﭑ يَابِ.</para>
  <para style="q" vid="PSA 86:1">مِسِكِينّ قُشَرِشِ نَ ﭑ نَ.<verse eid="PSA 86:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 86:2"/>عِ شَ ﭑ مَكَنتَ، عِ دُفُتّفّ نَ ﭑ نَ.</para>
  <para style="q" vid="PSA 86:2">ﭑ مَرِفِ عَلَ، عِ شَ عِ شَ كٌنيِ دِ رَكِسِ نَشَن عَ تَشُشِ عِ رَ.<verse eid="PSA 86:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 86:3"/>كِنِكِنِ ﭑ مَ، ﭑ مَرِفِ،</para>
  <para style="q" vid="PSA 86:3">بَرِ مَ ﭑ عِ شِلِمَ لْشْي بِرِن.<verse eid="PSA 86:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 86:4"/>عِ شَ سّيوّ قِ عِ شَ كٌنيِ دِ مَ،</para>
  <para style="q" vid="PSA 86:4">ﭑ شَشِلِ تِشِ عِ تَن نَن نَ، ﭑ مَرِفِ.<verse eid="PSA 86:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 86:5"/>عِ تَن مَرِفِ، عِ قَن، عِ كِنِكِنِ،</para>
  <para style="q" vid="PSA 86:5">عِ شَ دُفُتّفّحَ فبٌ مِشِيٍ بّ نَشٍيٍ بِرِن عِ شِلِمَ.<verse eid="PSA 86:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 86:6"/>مَرِفِ، عِ شَ عِ تُلِ مَتِ ﭑ مَ مَشَندِ رَ،</para>
  <para style="q" vid="PSA 86:6">عِ شَ ﭑ مَ دُبّ سُشُ.<verse eid="PSA 86:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 86:7"/>ﭑ عِ شِلِمَ ﭑ مَ تْورّ كُي، بَرِ مَ عِ ﭑ نَتِنمَ.<verse eid="PSA 86:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 86:8"/>ﭑ مَرِفِ، عِ مَنِيّ مُ نَ عَلَيٍ تَفِ،</para>
  <para style="q" vid="PSA 86:8">عِ شَ كَابَنَكٌييٍ دَنفِ وَلِ بِرِن نَ.<verse eid="PSA 86:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 86:9"/>عِ سِ نَشٍيٍ دَا دُنِحَ مَ، نٍيٍ قَمَ نّ عٍ شِنبِ سِندٍ عِ بُن مَ،</para>
  <para style="q" vid="PSA 86:9">عٍ عِ شِلِ مَتْشْ،<verse eid="PSA 86:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 86:10"/>بَرِ مَ عِ فبٌ، عِ مَن كَابَنَكٌي رَبَمَ.</para>
  <para style="q" vid="PSA 86:10">عِ تَن كٍرٍن ثٍتِ نَ نَن عَلَ رَ.<verse eid="PSA 86:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 86:11"/>ﭑ مَرِفِ، عِ شَ عِ شَ كِرَ مَسٍن ﭑ بّ،</para>
  <para style="q" vid="PSA 86:11">ﭑ شَ ﭑ حّرّ عِ شَ نْندِ كُي.</para>
  <para style="q" vid="PSA 86:11">بْحّ قَنيِ قِ ﭑ مَ، عَلَكٌ ﭑ شَ فَاشُ عِ شِلِ يَ رَ.<verse eid="PSA 86:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 86:12"/>ﭑ عِ مَتْشْمَ ﭑ بْحّ قِيشّ بِرِن نَ، ﭑ مَرِفِ عَلَ.</para>
  <para style="q" vid="PSA 86:12">ﭑ عِ شِلِ مَتْشْمَ نّ عَبَدَن،<verse eid="PSA 86:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 86:13"/>بَرِ مَ عِ شَ هِننّ تِلِن.</para>
  <para style="q" vid="PSA 86:13">عِ بَرَ ﭑ نِي رَتَنفَ قَشّ مَ.<verse eid="PSA 86:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PSA 86:14"/>عٍٍ عَلَ، يّتّ عِفبٌي ندٍيٍ بَرَ كٍلِ ﭑ شِلِ مَ،</para>
  <para style="q" vid="PSA 86:14">فبَلٌتْييٍ وَ مَ ﭑ قَشَقٍ.</para>
  <para style="q" vid="PSA 86:14">عٍ مُ عِ كٌلٌن قٍوٌ.<verse eid="PSA 86:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 86:15"/>كْنْ ﭑ مَرِفِ، عِ تَن نَن قِندِشِ عَلَ رَ،</para>
  <para style="q" vid="PSA 86:15">نَشَن كِنِكِنِمَ، نَشَن هِننّمَ عِبُنَدَ مَ رَ،</para>
  <para style="q" vid="PSA 86:15">نَشَن بْحّ مُ تٍمَ مَقُرٍن،</para>
  <para style="q" vid="PSA 86:15">نَشَن مُ تَفَنمَ دُفُتّفّحَ نُن شَنُنتٍيَ مَ.<verse eid="PSA 86:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 86:16"/>عِ شَ عِ يَ رَقِندِ ﭑ مَ، عِ شَ هِننّ ﭑ نَ.</para>
  <para style="q" vid="PSA 86:16">عِ شَ سّنبّ قِ عِ شَ كٌنيِ دِ مَ،</para>
  <para style="q" vid="PSA 86:16">عِ شَ عِ شَ كٌنيِ فِنّ شَ دِ رَكِسِ.<verse eid="PSA 86:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 86:17"/>تْنشُمَ ندٍ رَ مِنِ ﭑ بّ سٍيدٍ رَ،</para>
  <para style="q" vid="PSA 86:17">عَلَكٌ نَشٍيٍ ﭑ شْنشِ، عٍ شَ عَ تٌ، عٍ شَ يَافِ،</para>
  <para style="q" vid="PSA 86:17">عِ شَ مَلِ نُن عِ شَ مَدُندُي شَ قٍ رَ.<verse eid="PSA 86:17"/></para>
  <chapter eid="PSA 86"/>
  <chapter number="87" style="c" sid="PSA 87"/>
  <para style="s1">بَرِقٍ سِيٌنِ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 87:1"/>كٌرَ شَ دِيٍ شَ بّيتِ</para>
  <para style="q" vid="PSA 87:1">عَلَتَلَ شَ تَا تِشِ فٍيَ سّنِيّنشِيٍ قَرِ.<verse eid="PSA 87:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 87:2"/>سِيٌنِ نَادّيٍ رَقَن مَرِفِ مَ،</para>
  <para style="q" vid="PSA 87:2">دَنفِ يَشُبَ شَ لِنفِرَ بِرِن نَ.<verse eid="PSA 87:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 87:3"/>مِشِيٍ عَلَ شَ تَا مَتْشْمَ عَ قَنيِ رَ <char style="qs">حّنفِ رَتٍ.</char><verse eid="PSA 87:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 87:4"/>«ﭑ شَ عَ قَلَ رَشَبِ نُن بَبِلْن ﭑ كٌلٌنمَ،</para>
  <para style="q" vid="PSA 87:4">عَ نُن قِلِسِتَ، تِرٍ، نُن كُسِ.<verse eid="PSA 87:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 87:5"/>عَ قَلَشِ سِيٌنِكَيٍ شَ قٍ رَ،</para>
  <para style="q" vid="PSA 87:5">‹عٍ تٌ بَرِشِ نَا، مَرِفِ عَلَ عٍ مَكَنتَمَ نّ.›»<verse eid="PSA 87:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 87:6"/>عَلَتَلَ بَرَ عَ سّبّ سِيٍ شَ بُكِ كُي،</para>
  <para style="q" vid="PSA 87:6">«يِ تَن بَرِشِ نَا.» <char style="qs">حّنفِ رَتٍ.</char><verse eid="PSA 87:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 87:7"/>بّيتِبَيٍ عَ قَلَمَ عٍ شُي عِتٍشِ رَ،</para>
  <para style="q" vid="PSA 87:7">«ﭑ مَ سَابُي بِرِن نَ عِ تَن نّ.»<verse eid="PSA 87:7"/></para>
  <chapter eid="PSA 87"/>
  <chapter number="88" style="c" sid="PSA 88"/>
  <para style="s1">سَيَ كِرَ</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 88:1"/>كٌرَ شَ دِيٍ شَ بّيتِ بّيتِبَيٍ شَ مَنفّ بّ. عَ شَ بَ شُلٍ رَ. هٍمَن عٍسِرَكَ شَ لْننِ بّيتِ.<verse eid="PSA 88:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 88:2"/>مَرِفِ، ﭑ نَكِسِمَ عَلَ،</para>
  <para style="q" vid="PSA 88:2">ﭑ عِ شِلِمَ يَنيِ نُن كْي رَ.<verse eid="PSA 88:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 88:3"/>عِ شَ ﭑ مَ مَشَندِ سُشُ،</para>
  <para style="q" vid="PSA 88:3">عِ شَ ﭑ مَ دُبّ تٌنفٌ.<verse eid="PSA 88:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 88:4"/>ﭑ بَرَ تْورْ ﭑ مَ دُنِحّءِفِرِ كُي،</para>
  <para style="q" vid="PSA 88:4">يَكْسِ ﭑ بَرَ مَكْرّ سَيَ رَ.<verse eid="PSA 88:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 88:5"/>ﭑ نَ مِشِيٍ يَ مَ نَشٍيٍ نَ سَيَ كِرَ شْن مَ.</para>
  <para style="q" vid="PSA 88:5">ﭑ سّنبّ يٌ مُ نَ سْنْن.<verse eid="PSA 88:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 88:6"/>عَ لُشِ نّ عَلْ ﭑ حَن سَشِ قُرٍيٍ تَفِ فَبُرِ كُي،</para>
  <para style="q" vid="PSA 88:6">عِ مُ رَتُشِ نَشٍيٍ شَ قٍ مَ سْنْن،</para>
  <para style="q" vid="PSA 88:6">نَشٍيٍ بَرَ مَكُيَ عِ شَ هِننّ رَ.<verse eid="PSA 88:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 88:7"/>عِ بَرَ ﭑ نَ سٌ يِلِ تِلِنشِ كُي دِ مِ شْورَ.<verse eid="PSA 88:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 88:8"/>عِ شَ شْنّ بَرَ دُتُن ﭑ مَ،</para>
  <para style="q" vid="PSA 88:8">عَ ﭑ مَكٌتٌ عَلْ بَا مْرْنيِ مِشِ مَكٌتٌمَ كِ نَشّ. <char style="qs">حّنفِ رَتٍ.</char><verse eid="PSA 88:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 88:9"/>عِ بَرَ ﭑ دّقَنبٌورٍيٍ مَكُيَ ﭑ نَ،</para>
  <para style="q" vid="PSA 88:9">عِ بَرَ عٍ بْحّيٍ رَحَاشُ عٍ مَ.</para>
  <para style="q" vid="PSA 88:9">ﭑ لُمَ بَنشِ كُي، ﭑ مُ مِنِمَ قٍقٍ مَ.<verse eid="PSA 88:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 88:10"/>ﭑ مَرِفِ، ﭑ عِ شِلِمَ لْشْ يٌ لْشْ يَيٍ رَ،</para>
  <para style="q" vid="PSA 88:10">ﭑ نَ ﭑ بّلّشّيٍ تِشِ عِ بّ.<verse eid="PSA 88:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 88:11"/>عِ كَابَنَكٌي رَبَمَ مِشِ قَشَشِيٍ نَن بّ؟</para>
  <para style="q" vid="PSA 88:11">عٍ نْمَ كٍلِدٍ، عٍ عِ مَتْشْ؟<verse eid="PSA 88:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 88:12"/>عِ شَ دُفُتّفّحَ شَ قٍ قَلَمَ فَبُرِ كُي؟</para>
  <para style="q" vid="PSA 88:12">عِ شَ شَنُنتٍيَ مَسٍنمَ نَا؟<verse eid="PSA 88:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 88:13"/>عِ شَ كَابَنَكٌ تٌمَ عَلِفِيَمَ؟</para>
  <para style="q" vid="PSA 88:13">عِ شَ تِنشِنيِ كٌلٌنمَ يِرٍ دّننَشّ شَ قٍ بَرَ نّيمُ مِشِ رَ؟<verse eid="PSA 88:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PSA 88:14"/>ﭑ مَرِفِ، ﭑ تَن عِ شِلِمَ،</para>
  <para style="q" vid="PSA 88:14">فّيسّفّ يٌ فّيسّفّ ﭑ عِ مَشَندِ مَ.<verse eid="PSA 88:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 88:15"/>مَرِفِ، عِ تٌندِ مَ ﭑ بّ مُنقٍ رَ؟</para>
  <para style="q" vid="PSA 88:15">عِ عِ كٌبٍ سٌمَ ﭑ نَ مُنقٍ رَ؟<verse eid="PSA 88:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 88:16"/>ﭑ نَ تْورّ كُي كَبِ ﭑ دِ مّدِ تّمُي.</para>
  <para style="q" vid="PSA 88:16">ﭑ فَاشُشِ، شَشِلِسَ بِرِن بَرَ بَ ﭑ يِ رَ.<verse eid="PSA 88:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 88:17"/>عِ شَ شْنّ سّنبّ بَرَ دَنفِ عَ عِ،</para>
  <para style="q" vid="PSA 88:17">عِ شَ قٍ مَفَاشُشِيٍ بَرَ نْ ﭑ نَ.<verse eid="PSA 88:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 88:18"/>عٍ ﭑ نَبِلِنشِ عَلْ بَنبَرَنيِ،</para>
  <para style="q" vid="PSA 88:18">عٍ دُ سُ ﭑ شُن نَ.<verse eid="PSA 88:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 88:19"/>عِ بَرَ ﭑ شَنُنتٍنيِيٍ بِرِن مَكُيَ ﭑ نَ،</para>
  <para style="q" vid="PSA 88:19">ﭑ دْشْبٌورٍ بَرَ كٍلِ ﭑ شُن مَ.<verse eid="PSA 88:19"/></para>
  <chapter eid="PSA 88"/>
  <chapter number="89" style="c" sid="PSA 89"/>
  <para style="s1">عَلَ شَ سَاتّ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 89:1"/>عٍتَنِ عٍسِرَكَ شَ لْننِ بّيتِ<verse eid="PSA 89:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 89:2"/>ﭑ بّيتِ بَمَ ﭑ مَرِفِ شَ دُفُتّفّحَ شَ قٍ رَ.</para>
  <para style="q" vid="PSA 89:2">ﭑ نَ مَسٍنمَ نّ بْنسْي بِرِن بّ، عَ قَلَقٍ رَ،<verse eid="PSA 89:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 89:3"/>«عِ شَ دُفُتّفّحَ مَبَنبَنشِ كٌورٍ مَ عَبَدَن.</para>
  <para style="q" vid="PSA 89:3">عِ شَ هِننّ مُ كَنَمَ.»<verse eid="PSA 89:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 89:4"/>«ﭑ بَرَ سَاتّ شِرِ ﭑ نُن ﭑ مَ مِشِ سُفَندِشِ رَ،</para>
  <para style="q" vid="PSA 89:4">ﭑ بَرَ يِ كّرّ تٌنفٌ ﭑ مَ كٌنيِ دِ دَوُدَ بّ.<verse eid="PSA 89:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 89:5"/>‹ﭑ عِ بْنسْي رَ سَبَتِمَ نّ عَبَدَن،</para>
  <para style="q" vid="PSA 89:5">ﭑ عِ شَ كِبَنيِ تِ تّمُي بِرِن.›» <char style="qs">حّنفِ رَتٍ.</char><verse eid="PSA 89:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 89:6"/>ﭑ مَرِفِ، نَشٍيٍ نَ كٌورٍ مَ عٍ عِ مَتْشْمَ،</para>
  <para style="q" vid="PSA 89:6">مَلٍكّيٍ عِ تَنتُمَ عِ شَ دُفُتّفّحَ شَ قٍ رَ.<verse eid="PSA 89:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 89:7"/>ندٍ نَ كٌورٍ مَ نَشَن مَنِيَمَ مَرِفِ عَلَ رَ؟</para>
  <para style="q" vid="PSA 89:7">ندٍ لُشِ عَلْ مَرِفِ عَلَ مَلٍكّيٍ يَ مَ؟<verse eid="PSA 89:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 89:8"/>عَلَ مَفَاشُ عَ شَ سّنِيّنتْييٍ شَ مَلَنيِ،</para>
  <para style="q" vid="PSA 89:8">عٍ بِرِن عٍ مَفٌرٌ عَ بّ.<verse eid="PSA 89:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 89:9"/>مَرِفِ عَلَ، ندٍ سّنبّ فبٌ عَلْ عِ تَن مَنفّ عَلَ؟</para>
  <para style="q" vid="PSA 89:9">عِ شَ دُفُتّفّحَ نَ يِرٍ بِرِن.<verse eid="PSA 89:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 89:10"/>عِ تَن نَن بَا يَمَرِ مَ،</para>
  <para style="q" vid="PSA 89:10">عِ عَ مْرْنيِيٍ رَشَرَ.<verse eid="PSA 89:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 89:11"/>عِ تَن نَن نْ مِسِرَ رَ، عِ عَ سْنتْ.</para>
  <para style="q" vid="PSA 89:11">عِ عِ يَشُييٍ رَيٍنسٍن عِ سّنبّ رَ.<verse eid="PSA 89:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 89:12"/>عِ تَن نَن فبٍ كٌورٍ رَ، عِ تَن نَن فبٍ بْشِ رَ.</para>
  <para style="q" vid="PSA 89:12">عِ تَن نَن دُنِحَ بِرِن دَا.<verse eid="PSA 89:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 89:13"/>سٍ نَشَن نَ كْولَ مَ، سٍ نَشَن نَ يِرٍقَنيِ مَ،</para>
  <para style="q" vid="PSA 89:13">عِ تَن نَن عَ بِرِن دَاشِ.</para>
  <para style="q" vid="PSA 89:13">تَبٌرٌ نُن شٍرِ مٌن فٍيَيٍ عِ شِلِ مَتْشْمَ.<verse eid="PSA 89:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 89:14"/>عِ سّنبّ فبٌ.<verse eid="PSA 89:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 89:15"/>تِنشِنيِ نُن نْندِ نَن نَ عِ شَ كِبَنيِ سَنبُنيِ رَ،</para>
  <para style="q" vid="PSA 89:15">شَنُنتٍيَ نُن دُفُتّفّحَ قَن تِشِ عِ يَ رَ.<verse eid="PSA 89:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 89:16"/>مَرِفِ، سّيوّ نَ حَمَ بّ نَشَن عِ شِلِ مَتْشْمَ،</para>
  <para style="q" vid="PSA 89:16">عٍ عٍ حّرّ مَ عِ شَ نَءِيَلَنيِ نَن مَ.<verse eid="PSA 89:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 89:17"/>عٍ سّيوَ مَ عِ شِلِ شَ قٍ رَ،</para>
  <para style="q" vid="PSA 89:17">عٍ شُن نَكٍلِمَ عِ شَ تِنشِنيِ سَابُي رَ.<verse eid="PSA 89:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 89:18"/>عِ تَن نَن قِندِشِ عٍ شَ نَءِيَلَنيِ نُن عٍ سّنبّ رَ.</para>
  <para style="q" vid="PSA 89:18">مُشُ سّنبّ فبٌ عِ شَ هِننّ شَ قٍ رَ.<verse eid="PSA 89:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 89:19"/>مُشُ مَرِفِ نَن نَ مُشُ كَنتَمَ نُن مُشُ شَ مَنفّ رَ،</para>
  <para style="q" vid="PSA 89:19">عِسِرَيِلَ شَ سّنِيّنتْي نَ عَ رَ.<verse eid="PSA 89:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="PSA 89:20"/>عِ وْيّن نّ عِ شَ حَمَ بّ لَامَتُنيِ رَ، عَ قَلَقٍ رَ،</para>
  <para style="q" vid="PSA 89:20">«ﭑ بَرَ سّنبّ قِ فٍرٍ سٌي ندٍ مَ،</para>
  <para style="q" vid="PSA 89:20">ﭑ نَشَن شُن نَكٍلِشِ حَمَ تَفِ.<verse eid="PSA 89:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 89:21"/>ﭑ بَرَ ﭑ مَ كٌنيِ دَوُدَ تٌ،</para>
  <para style="q" vid="PSA 89:21">ﭑ تُرٍ سّنِيّنشِ سُرُ سُرُ عَ شُنيِ مَ سُفَندِ رَ.<verse eid="PSA 89:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 89:22"/>ﭑ نَ ﭑ بّلّشّ رَ سٌمَ عَ بُن مَ،</para>
  <para style="q" vid="PSA 89:22">ﭑ سّنبّ قِمَ نّ عَ مَ عَ قَنيِ رَ.<verse eid="PSA 89:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 89:23"/>عَ يَشُي مُ عَ تّرّننَمَ،</para>
  <para style="q" vid="PSA 89:23">تِنشِنتَرٍ مُ عَ تْورْ مَ.<verse eid="PSA 89:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 89:24"/>ﭑ عَ يَشُييٍ عِبُتُشُنمَ نّ،</para>
  <para style="q" vid="PSA 89:24">ﭑ عَ شْنمَيٍ بْنبْمَ نّ.<verse eid="PSA 89:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 89:25"/>ﭑ شَنُنتٍيَ نُن ﭑ مَ دُفُتّفّحَ لُمَ نّ عَ مَ،</para>
  <para style="q" vid="PSA 89:25">عَ سّنبّ فبٌمَ ﭑ شِلِ نَن سَابُي رَ.<verse eid="PSA 89:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 89:26"/>بَايٍ نُن شُرٍيٍ بِرِن سَمَ نّ عَ شَ مَنفّيَ بُن مَ.<verse eid="PSA 89:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 89:27"/>عَ عَ قَلَمَ نّ ﭑ بّ،</para>
  <para style="q" vid="PSA 89:27">‹ﭑ بَبَ نَن عِ رَ، ﭑ مَرِفِ عَلَ، ﭑ مَ مَرَكِسِمَ.›<verse eid="PSA 89:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 89:28"/>ﭑ عَ قِندِ مَ نّ ﭑ مَ دِ سِنفٍ رَ،</para>
  <para style="q" vid="PSA 89:28">نَشَن شُنفبٌ دُنِحَ مَنفّيٍ بِرِن بّ.<verse eid="PSA 89:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 89:29"/>ﭑ نَ ﭑ مَ دُفُتّفّحَ مَبَنبَنمَ نّ عَ بّ،</para>
  <para style="q" vid="PSA 89:29">مُشُ سَاتّ نَشَن شِرِشِ، عَ مُ كَنَمَ عَبَدَن.<verse eid="PSA 89:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 89:30"/>ﭑ عَ بْنسْي رَ سَبَتِمَ نّ،</para>
  <para style="q" vid="PSA 89:30">ﭑ عَ شَ مَنفّ كِبَنيِ مَبَنبَنمَ نّ قَننِ كٌورٍ نَ.<verse eid="PSA 89:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 89:31"/>عَ شَ دِيٍ نَ ﭑ مَ سّرِيّ رَبٌلٌ،</para>
  <para style="q" vid="PSA 89:31">عٍ مُ عٍ حّرّ ﭑ مَ يَامَرِ بُن مَ،<verse eid="PSA 89:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 89:32"/>عٍ ﭑ شُي مَتَندِ، عٍ مُ ﭑ وَشْنقٍ سُشُ،<verse eid="PSA 89:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 89:33"/>ﭑ عٍ بْنبْمَ لُشُسِنيِ نَن نَ،</para>
  <para style="q" vid="PSA 89:33">ﭑ عٍ حَشَنكَتَمَ قُرٍ حَاشِيٍ رَ.<verse eid="PSA 89:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 89:34"/>كْنْ ﭑ مُ ﭑ مَ دُفُتّفّحَ بَمَ عَ مَ.</para>
  <para style="q" vid="PSA 89:34">ﭑ مُ ﭑ شُي يَنقَمَ،<verse eid="PSA 89:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 89:35"/>ﭑ مُ ﭑ مَ سَاتّ كَنَمَ،</para>
  <para style="q" vid="PSA 89:35">ﭑ مَن مُ ﭑ شُي مَسَرَ مَ.<verse eid="PSA 89:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 89:36"/>ﭑ نَ ﭑ كَلِشِ ﭑ مَ سّنِيّنيِ رَ،</para>
  <para style="q" vid="PSA 89:36">ﭑ مُ عَننَبِ دَوُدَ يَنقَمَ.<verse eid="PSA 89:36"/></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 89:37"/>عَ بْنسْي كِسِمَ نّ عَبَدَن،</para>
  <para style="q" vid="PSA 89:37">عَ شَ كِبَنيِ لُمَ نّ ﭑ يَ عِ عَلْ سٌفٍ،<verse eid="PSA 89:37"/></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 89:38"/>عَ رَ سَبَتِمَ نّ عَلْ كِكٍ،</para>
  <para style="q" vid="PSA 89:38">نَشَن قِندِ مَ سٍيدٍحْشْيَ رَ عَبَدَن.» <char style="qs">حّنفِ رَتٍ.</char><verse eid="PSA 89:38"/></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 89:39"/>كْنْ عِ تَن بَرَ عِ شَ مِشِ سُفَندِشِ مَكُيَ عِ رَ،</para>
  <para style="q" vid="PSA 89:39">عِ بَرَ مّي عَ رَ، عِ شْنْ عَ مَ.<verse eid="PSA 89:39"/></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 89:40"/>عِ بَرَ عِ شَ سَاتّ كَنَ عِ شَ كٌنيِ بّ،</para>
  <para style="q" vid="PSA 89:40">عِ عَ بَ عَ شَ كِبَنيِ كُي.<verse eid="PSA 89:40"/></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 89:41"/>عِ بَرَ عَ شَ تّتّ بْو، عِ بَرَ عَ مَكَنتَدٍ كَنَ.<verse eid="PSA 89:41"/></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 89:42"/>مِشِ نَشٍيٍ دَنفِمَ، عٍ هَرِفٍ بَمَ نَا.</para>
  <para style="q" vid="PSA 89:42">عَ دْشْبٌورٍيٍ يٌمَ عَ مَ.<verse eid="PSA 89:42"/></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 89:43"/>عِ بَرَ عَ يَشُييٍ سّنبّ سٌ، هَن عٍ بَرَ سّيوَ.<verse eid="PSA 89:43"/></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 89:44"/>عِ مُ عَ شَ سَنتِدّفّمَ وَلِ رَ سْونّيَ،</para>
  <para style="q" vid="PSA 89:44">عِ مُ عَ مَلِشِ فٍرٍ كُي.<verse eid="PSA 89:44"/></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 89:45"/>عِ بَرَ عَ شَ قٍ رَشُبٍن،</para>
  <para style="q" vid="PSA 89:45">عِ بَرَ عَ شَ كِبَنيِ وٌلِ بْشِ.<verse eid="PSA 89:45"/></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 89:46"/>عِ بَرَ ندٍ بَ عَ شَ قٌنِكٍيَ رَ،</para>
  <para style="q" vid="PSA 89:46">عِ يَافِ دُ سُ عَ شُن نَ. <char style="qs">حّنفِ رَتٍ.</char><verse eid="PSA 89:46"/></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 89:47"/>عَلَتَلَ، عِ عِ نْشُنمَ ﭑ مَ هَن مُن تّمُي؟</para>
  <para style="q" vid="PSA 89:47">عِ شَ شْنّ دّشّمَ عَلْ تّ هَن مُن لْشْي؟<verse eid="PSA 89:47"/></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 89:48"/>عِ شَ رَتُ عَ مَ ﭑ مَ سِمَيَ دُنكٍ كِ نَشّ.</para>
  <para style="q" vid="PSA 89:48">عِ عِبُنَدَ مَ دَاشِ قُيَن نَن نَ؟<verse eid="PSA 89:48"/></para>
  <para style="q">
    <verse number="49" style="v" sid="PSA 89:49"/>ندٍ بَلٌشِ نَشَن مُ قَشَمَ؟</para>
  <para style="q" vid="PSA 89:49">ندٍ نْمَ عَ يّتّ بَدٍ سَيَ كِرَ شْن مَ؟<verse eid="PSA 89:49"/></para>
  <para style="q">
    <verse number="50" style="v" sid="PSA 89:50"/>ﭑ مَرِفِ، عِ شَ دُفُتّفّحَ سِنفٍ نَ مِندٍن،</para>
  <para style="q" vid="PSA 89:50">عِ عِ كَلِ نَشَن نَ دَوُدَ بّ عِ شَ تِنشِنيِ كُي؟<verse eid="PSA 89:50"/></para>
  <para style="q">
    <verse number="51" style="v" sid="PSA 89:51"/>ﭑ مَرِفِ، عِ شَ عِ حْشْ سَ عِ شَ كٌنيِيٍ شَ يَافِ شْن مَ.</para>
  <para style="q" vid="PSA 89:51">عِ شَ نَ كٌتٍ تٌ مِشِ وُيَشِيٍ نَشَن دْشْ ﭑ شُن مَ.<verse eid="PSA 89:51"/></para>
  <para style="q">
    <verse number="52" style="v" sid="PSA 89:52"/>ﭑ مَرِفِ، عِ شَ عِ رَتُ عَ مَ عِ يَشُييٍ ﭑ مَبٍرٍ مَ كِ نَشّ،</para>
  <para style="q" vid="PSA 89:52">ﭑ تَن عِ شَ مِشِ سُفَندِشِ.<verse eid="PSA 89:52"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="53" style="v" sid="PSA 89:53"/>تَنتُي نَ مَرِفِ بّ عَبَدَن. عَمِنَ. عَمِنَ.<verse eid="PSA 89:53"/></para>
  <chapter eid="PSA 89"/>
  <chapter number="90" style="c" sid="PSA 90"/>
  <para style="s1">عَدَ مَ بِرِن قَشَمَ نّ</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 90:1"/>عَلَ شَ مِشِ مُنسَ شَ عَلَ مَشَندِ</para>
  <para style="q" vid="PSA 90:1">ﭑ مَرِفِ، عِ تَن قِندِشِ مُشُ كَنتَمَ نَن نَ عَبَدَن.<verse eid="PSA 90:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 90:2"/>بٍينُن فٍيَيٍ نُن دُنِحَ شَ دَا،</para>
  <para style="q" vid="PSA 90:2">عِ تَن نَن نُ نَ عَلَ رَ عَبَدَن.<verse eid="PSA 90:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 90:3"/>عِ عِبُنَدَ مَ رَفبِلٍنمَ بّندّ عِ.</para>
  <para style="q" vid="PSA 90:3">عِ نَ نَن قَلَ، «عَدَ مَدِ شَ فبِلٍن بّندّ.»<verse eid="PSA 90:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 90:4"/>حّ وُلُ كٍرٍن لُشِ نّ عِ بّ</para>
  <para style="q" vid="PSA 90:4">عَلْ لْشْ كٍرٍن نَشَن بَرَ دَنفِ،</para>
  <para style="q" vid="PSA 90:4">عَلْ وَشَتِ كٍرٍن نَشَن بَرَ دَنفِ كْي كُي.<verse eid="PSA 90:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 90:5"/>عِ عَ نِيَ عَدَ مَدِ مُ كٍلِ عَ شَ شِشْلِ مَ.</para>
  <para style="q" vid="PSA 90:5">عَ لُشِ عَلْ حٌوفٍ نَشَن مِنِمَ عَ يّتّ رَ.<verse eid="PSA 90:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 90:6"/>عَ كٍلِ سُبَشّ مَ، عَ قُفَ،</para>
  <para style="q" vid="PSA 90:6">نُنمَرٍ تّمُي عَ حَن بَرَ لِسِ، عَ شَرَ.<verse eid="PSA 90:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 90:7"/>عِ شَ شْنّ مُشُ حْنمَ نّ،</para>
  <para style="q" vid="PSA 90:7">عَ مُشُ مَفَاشُ.<verse eid="PSA 90:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 90:8"/>عِ مُشُ شَ يُنُبِ بِرِن كٌلٌن،</para>
  <para style="q" vid="PSA 90:8">هَلِ مُشُ شَ قٍ حَاشِ نَشٍيٍ قِندِشِ فُندٌ رَ.<verse eid="PSA 90:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 90:9"/>مُشُ شَ سِمَيَ بِرِن لُمَ عِ شَ شْنّ بُن مَ.</para>
  <para style="q" vid="PSA 90:9">مُشُ شَ دُنِحّءِفِرِ شَ بُي بِرِن، حّنفِ رَتٍ كٍرٍن.<verse eid="PSA 90:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 90:10"/>مُشُ شَ سِمَيَ بُمَ حّ تٌنفٌ سٌلٌقٍرٍ،</para>
  <para style="q" vid="PSA 90:10">حّ تٌنفٌ سٌلٌمَسَشَن شَ عَ سْونّيَ،</para>
  <para style="q" vid="PSA 90:10">كْنْ نَ بِرِن قِندِشِ تْورّ نُن حَشَنكَتّ نَن نَ.</para>
  <para style="q" vid="PSA 90:10">سِمَيَ دَنفِمَ نّ مَقُرٍن مَقُرٍن، عَ مُشُ لُ دِ مِ كُي.<verse eid="PSA 90:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 90:11"/>ندٍ عِ شَ شْنّ سّنبّ كٌلٌن؟</para>
  <para style="q" vid="PSA 90:11">ندٍ فَاشُمَ نَ يَ رَ؟<verse eid="PSA 90:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 90:12"/>عَ مُشُ رَتُ سِمَيَ رَحْنيِ مَ،</para>
  <para style="q" vid="PSA 90:12">عَلَكٌ مُشُ شَ شَشِلِ سْتْ مُشُ شَ دُنِحّءِفِرِ كُي.<verse eid="PSA 90:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 90:13"/>ﭑ مَرِفِ، عِ شَ عِ يَ رَقِندِ مُشُ مَ</para>
  <para style="q" vid="PSA 90:13">عِ شَ شْنّ بُمَ هَن مُن تّمُي؟</para>
  <para style="q" vid="PSA 90:13">كِنِكِنِ عِ شَ كٌنيِ دِيٍ مَ.<verse eid="PSA 90:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 90:14"/>كُيٍ نَ عِبَ، عِ شَ مُشُ رَوَ سَ عِ شَ دُفُتّفّحَ رَ،</para>
  <para style="q" vid="PSA 90:14">عَلَكٌ مُشُ شَ سّيوَ مُشُ شَ سِمَيَ بِرِن كُي.<verse eid="PSA 90:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 90:15"/>عِ تْورّ شَسَبِ نَشَن دْشْ مُشُ مَ،</para>
  <para style="q" vid="PSA 90:15">عِ يَافِ شَسَبِ نَشَن سَ مُشُ مَ،</para>
  <para style="q" vid="PSA 90:15">عِ مَن شَ مُشُ رَ سّيوَ نَ شَسَبِ رَ.<verse eid="PSA 90:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 90:16"/>عِ شَ عِ شَ كَابَنَكٌي مَسٍن مُشُ بّ، عِ شَ كٌنيِيٍ.</para>
  <para style="q" vid="PSA 90:16">عِ شَ نْرّ شَ مِنِ مُشُ شَ دِيٍ مَ.<verse eid="PSA 90:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 90:17"/>مُشُ مَرِفِ عَلَ شَ تٌقَنيِ شَ لُ مُشُ يَ عِ.</para>
  <para style="q" vid="PSA 90:17">عَ شَ مُشُ شَ وَلِ سْونّيَ،</para>
  <para style="q" vid="PSA 90:17">عَ شَ بَرَكَ سَ مُشُ شَ وَلِ مَ!<verse eid="PSA 90:17"/></para>
  <chapter eid="PSA 90"/>
  <chapter number="91" style="c" sid="PSA 91"/>
  <para style="s1">فَاشُتَرٍحَ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 91:1"/>نَشَن لُمَ عَلَ شِلِ شُنفبٍ كَنيِ شَ كَنتَرِ بُن مَ،</para>
  <para style="q" vid="PSA 91:1">عَ عَ مَلَبُمَ نّ عَلَ شَ كَنتّ كُي.<verse eid="PSA 91:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 91:2"/>ﭑ نَ عَ مَسٍنمَ عَلَتَلَ بّ،</para>
  <para style="q" vid="PSA 91:2">«عِ تَن نَن نَ ﭑ مَ كَنتَرِ نُن ﭑ مَكَنتَدٍ رَ،</para>
  <para style="q" vid="PSA 91:2">عِ تَن ﭑ مَرِفِ عَلَ، ﭑ لَشِ نَشَن نَ.»<verse eid="PSA 91:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 91:3"/>عَ تَن نَن عِ رَتَنفَمَ فَنتَنيِيٍ مَ نَشٍيٍ تٍمَ عِ بّ،</para>
  <para style="q" vid="PSA 91:3">عَ عِ رَتَنفَ وُفَنيِ مَ.<verse eid="PSA 91:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 91:4"/>عَ عِ مَكَنتَمَ نّ</para>
  <para style="q" vid="PSA 91:4">عَلْ تْشْي عَ شَ دِيٍ مَكَنتَمَ كِ نَشّ</para>
  <para style="q" vid="PSA 91:4">عَ فَبُتٍنيِ بُن مَ.</para>
  <para style="q" vid="PSA 91:4">عَ شَ دُفُتّفّحَ لُمَ نّ عَلْ سْورِ شَ وُرٍ لٍقَ.<verse eid="PSA 91:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 91:5"/>عِ مُ فَاشُمَ فبَلٌي رَ كْي رَ،</para>
  <para style="q" vid="PSA 91:5">عِ مُ فَاشُمَ شَلِيٍ رَ يَنيِ رَ،<verse eid="PSA 91:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 91:6"/>عِ مُ فَاشُمَ وُفَنيِ رَ دِ مِ كُي،</para>
  <para style="q" vid="PSA 91:6">عِ مُ فَاشُمَ قُرٍ حَاشِ رَ سٌفٍ بُن مَ.<verse eid="PSA 91:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 91:7"/>مِشِ وُلُ نْمَ نّ بِرَدٍ عِ كْولَ مَ،</para>
  <para style="q" vid="PSA 91:7">مِشِ وُلُ قُ نْمَ بِرَدٍ عِ يِرٍقَنيِ مَ،</para>
  <para style="q" vid="PSA 91:7">كْنْ سٍسٍ مُ عِ تٌمَ.<verse eid="PSA 91:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 91:8"/>عِ نَ بِرِن تٌمَ نّ عِ يَ عِ،</para>
  <para style="q" vid="PSA 91:8">عِ قِندِ سٍيدٍ رَ تِنشِنتَرٍ شَ حَشَنكَتّ مَ،<verse eid="PSA 91:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 91:9"/>بَرِ مَ عِ بَرَ لَ عِ مَرِفِ رَ، عَ بَرَ قِندِ عِ شَ كَنتَرِ رَ.</para>
  <para style="q" vid="PSA 91:9">عَلَ شِلِ شُنفبٍ كَنيِ قِندِشِ عِ شَ مَكَنتَدٍ نَن نَ.<verse eid="PSA 91:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 91:10"/>سٍسٍ مُ عِ لِمَ،</para>
  <para style="q" vid="PSA 91:10">وُفَنيِ يٌ مُ سٌمَ عِ شْنيِ،<verse eid="PSA 91:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 91:11"/>بَرِ مَ عَ عَ شَ مَلٍكّيٍ يَمَرِ مَ عٍ شَ عِ مَكَنتَ يِرٍ بِرِن.<verse eid="PSA 91:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 91:12"/>عٍ عِ تٌنفٌمَ نّ عٍ بّلّشّيٍ كُي،</para>
  <para style="q" vid="PSA 91:12">عَلَكٌ عِ نَشَ عِ سَنيِ رَدِن فّمّ رَ.<verse eid="PSA 91:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 91:13"/>عِ نْمَ يّتّيٍ نُن بْشِمَسٍيٍ رَ،</para>
  <para style="q" vid="PSA 91:13">عِ سّنبّ دَنفِ بَرَتّيٍ نُن بِيدَيٍ رَ.<verse eid="PSA 91:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PSA 91:14"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="PSA 91:14">«عَ تٌ لَشِ ﭑ نَ، ﭑ عَ رَكِسِمَ نّ.</para>
  <para style="q" vid="PSA 91:14">ﭑ عَ مَكَنتَمَ نّ بَرِ مَ عَ ﭑ شِلِ كٌلٌن.<verse eid="PSA 91:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 91:15"/>عَ نَ ﭑ شِلِ، ﭑ عَ يَابِمَ نّ.</para>
  <para style="q" vid="PSA 91:15">تْورّ نَ عَ لِ، ﭑ لُمَ نّ عَ سّيتِ مَ.</para>
  <para style="q" vid="PSA 91:15">ﭑ عَ رَكِسِمَ نّ، ﭑ عَ شُن نَكٍلِ.<verse eid="PSA 91:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 91:16"/>ﭑ سِمَيَ شْنكُيٍ قِمَ نّ عَ مَ،</para>
  <para style="q" vid="PSA 91:16">ﭑ نَ ﭑ مَ كِسِ مَسٍن عَ بّ.»<verse eid="PSA 91:16"/></para>
  <chapter eid="PSA 91"/>
  <chapter number="92" style="c" sid="PSA 92"/>
  <para style="s1">سِمَيَ كَمَلِشِ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 92:1"/>بّيتِ نَشَن بَمَ مَلَبُي لْشْي<verse eid="PSA 92:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 92:2"/>مَرِفِ بَتُقٍ قٍ قَنيِ نَ عَ رَ.</para>
  <para style="q" vid="PSA 92:2">عَلَ شِلِ شُنفبٍ كَنيِ، عَ لَنمَ عِ شِلِ شَ مَتْشْ بّيتِ رَ.<verse eid="PSA 92:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 92:3"/>كُيٍ عِبَ، عَ لَنمَ عِ شَ شَنُنتٍيَ شَ مَتْشْ،</para>
  <para style="q" vid="PSA 92:3">كْي كُي، مُشُ شَ عِ تَنتُ عِ شَ دُفُتّفّحَ شَ قٍ رَ.<verse eid="PSA 92:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 92:4"/>مَتْشْي شَ بَ كْرَ لُوتِ قُ دَاشِ شُي رَ نُن عَدَ مَدِ شُي رَ.<verse eid="PSA 92:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 92:5"/>مَرِفِ، ﭑ حّلّشِنمَ عِ شَ كَابَنَكٌي رَ،</para>
  <para style="q" vid="PSA 92:5">ﭑ نَن ﭑ سّيوّ شُي عِتٍمَ عِ شَ وَلِ شَ قٍ رَ.<verse eid="PSA 92:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 92:6"/>مَرِفِ، عِ نَشَن نَبَمَ، عَ مَكَابَ، عِ شَشِلِ تِلِن.<verse eid="PSA 92:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 92:7"/>شَشِلِتَرٍ مُ سٍسٍ كٌلٌنمَ نَ كُي،</para>
  <para style="q" vid="PSA 92:7">عَ مُ قَهَامُي سْتْمَ عِ شَ قٍ مَ.<verse eid="PSA 92:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 92:8"/>عَلَ كٌلٌنتَرٍيٍ لُمَ عَلْ سَنسِ</para>
  <para style="q" vid="PSA 92:8">نَشَن بُلَمَ قِيلِ مَ، عَ قُفَ،</para>
  <para style="q" vid="PSA 92:8">كْنْ نَ دَنفِ شَنبِ، عَ حْن عَبَدَن.<verse eid="PSA 92:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 92:9"/>كْنْ عِ تَن مَرِفِ، مَتْشْي نَ عِ بّ تّمُي بِرِن.<verse eid="PSA 92:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 92:10"/>ﭑ مَرِفِ، عِ يَشُييٍ هَلَكِمَ نّ،</para>
  <para style="q" vid="PSA 92:10">عِ قٍ كٌبِ رَبَيٍ بِرِن نَيٍنسٍن يّ.<verse eid="PSA 92:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 92:11"/>عِ سّنبّ قِمَ نّ ﭑ مَ عَلْ سّشّ نِنفٍ،</para>
  <para style="q" vid="PSA 92:11">عِ تُرٍ قَنيِ سَ ﭑ مَ.<verse eid="PSA 92:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 92:12"/>ﭑ يَيٍ عَ تٌمَ ﭑ فٍرٍقَيٍ شُن فٌرٌ مَ كِ نَشّ،</para>
  <para style="q" vid="PSA 92:12">ﭑ تُلِ عٍ فِ شُي مّ.<verse eid="PSA 92:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 92:13"/>تِنشِنتْييٍ شَ قٍ قَنمَ نّ عَلْ تُفِ بِلِ،</para>
  <para style="q" vid="PSA 92:13">عٍ شَ قٍ تٍ عَلْ سّدِرِ وُرِ بِلِ نَشٍيٍ نَ لِبَن.<verse eid="PSA 92:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 92:14"/>عٍ سَبَتِشِ عَلَتَلَ شَ هْرْ مْبَنشِ تّتّ كُي،</para>
  <para style="q" vid="PSA 92:14">عٍ شَ قٍ قَنمَ نّ وٌن مَرِفِ عَلَ يَ عِ.<verse eid="PSA 92:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 92:15"/>هَلِ عٍ قٌرِشِ عٍ شُنسّشّ قِيشّشِ،</para>
  <para style="q" vid="PSA 92:15">سّنبّ نَ عٍ بّ قٍ قَنيِ رَبَقٍ رَ،<verse eid="PSA 92:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 92:16"/>عَلَكٌ عٍ شَ عَ مَسٍن،</para>
  <para style="q" vid="PSA 92:16">«عَلَتَلَ تِنشِن، ﭑ تِشِ عَ شَ سّرِيّ نَن قَرِ،</para>
  <para style="q" vid="PSA 92:16">تِنشِنتَرٍيَ يٌ مُ نَ عَ مَ.»<verse eid="PSA 92:16"/></para>
  <chapter eid="PSA 92"/>
  <chapter number="93" style="c" sid="PSA 93"/>
  <para style="s1">مَنفّ عَلَ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 93:1"/>مَرِفِ عَلَتَلَ نَن نَ مَنفّ رَ.</para>
  <para style="q" vid="PSA 93:1">شُننَكٍلِ نَ عَ يِ، عَ سّنبّ فبٌ.</para>
  <para style="q" vid="PSA 93:1">عَ شَ دُنِحَ شَنشِ، عَ مُ سّرّنمَ.<verse eid="PSA 93:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PSA 93:2"/>عِ شَ مَنفّيَ قْلّ مُ نَ، عَ دَن مُ نَ.</para>
  <para style="q" vid="PSA 93:2">عِ تَن نَن نَ عَلَ رَ عَبَدَن.<verse eid="PSA 93:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 93:3"/>مَرِفِ، بَا مْرْنيِ رَوُندُ مَ عَلْ فَلَنيِ،</para>
  <para style="q" vid="PSA 93:3">فَلَنيِ نَشَن فٌرٌ مَ، عَ بُلَ.<verse eid="PSA 93:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 93:4"/>عِ سّنبّ فبٌ نَ شُي بّ،</para>
  <para style="q" vid="PSA 93:4">عِ شَ شُننَكٍلِ دَنفِ بَا مْرْنيِيٍ رَ.</para>
  <para style="q" vid="PSA 93:4">مَرِفِ سّنبّ فبٌ كٌورٍ مَ.<verse eid="PSA 93:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 93:5"/>عِ شَ سّرِيّ شَنشِ، سّنِيّنتْي نَن لَنشِ عِ مَ عَبَدَن.<verse eid="PSA 93:5"/></para>
  <chapter eid="PSA 93"/>
  <chapter number="94" style="c" sid="PSA 94"/>
  <para style="s1">عَلَ شَ حَشَنكَتّ</para>
  <para style="s2">عَلَ شَ سّرِيّ</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 94:1"/>ﭑ مَرِفِ عَلَ نَشَن عَ فبٍحْشْمَ،</para>
  <para style="q" vid="PSA 94:1">عِ شَ عِ مَكّنّن عِ شَ نْرّ كُي.<verse eid="PSA 94:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 94:2"/>عِ تَن نَشَن دُنِحَ كِيتِ سَمَ، عِ شَ كٍلِ،</para>
  <para style="q" vid="PSA 94:2">عِ شَ يّتّ عِفبٌي شَ وَلِيٍ رَفبِلٍن عٍ مَ.<verse eid="PSA 94:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 94:3"/>ﭑ مَرِفِ، عَ لَنمَ مِشِ كٌبِيٍ شُن شَ رَكٍلِ هَن مُن تّمُي؟<verse eid="PSA 94:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 94:4"/>عَ لَنمَ مِشِ حَاشِيٍ شَ عٍ يّتّ مَتْشْ تُن عٍ شَ يّتّ عِفبٌحَ كُي؟<verse eid="PSA 94:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 94:5"/>عَلَتَلَ، عٍ عِ شَ حَمَ تْورْ مَ، عٍ عِ شَ مِشِيٍ هَلَكِمَ.<verse eid="PSA 94:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 94:6"/>عٍ كَاحّ فِنّيٍ نُن شْحّ قَشَمَ، عٍ كِرِدِيٍ نِي بَمَ.<verse eid="PSA 94:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 94:7"/>عٍ نُ قَ عَ قَلَ، «عَلَتَلَ مُ يِ قٍيٍ تٌمَ،</para>
  <para style="q" vid="PSA 94:7">يَشُبَ مَرِفِ عَلَ مُ يِ رَكْرْ سِمَ.»<verse eid="PSA 94:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 94:8"/>وٌ تَن شَشِلِتَرٍيٍ، نَشٍيٍ لُمَ حَمَ تَفِ،</para>
  <para style="q" vid="PSA 94:8">وٌ شَشِلِ سْتْمَ مُن تّمُي؟<verse eid="PSA 94:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 94:9"/>نَشَن تُلِ دَاشِ، نَ لُمَ عَ مُ قٍ مّ؟</para>
  <para style="q" vid="PSA 94:9">نَشَن يَ دَاشِ، نَ لُمَ عَ مُ سٍ تٌ؟<verse eid="PSA 94:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 94:10"/>نَشَن حَمَنّيٍ شُرُ مَ، نَ مُ عٍ حَشَنكَتَمَ؟</para>
  <para style="q" vid="PSA 94:10">عَ تَن نَن شَشِلِ قِمَ عِبُنَدَ مَ مَ.<verse eid="PSA 94:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 94:11"/>عَلَتَلَ عَ كٌلٌن عَ عَدَ مَدِيٍ شَ مَحْشُنيِيٍ نَ نّ قُقَقُ.<verse eid="PSA 94:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 94:12"/>عَلَتَلَ، سّيوّ نَ مِشِ بّ عِ نَشَن مَتِنشِنمَ،</para>
  <para style="q" vid="PSA 94:12">عِ نَشَن مَتِنشِنمَ عِ شَ سّرِيّ رَ،<verse eid="PSA 94:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 94:13"/>عَلَكٌ عَ شَشِلِ شَ سَ تْورّ لْشْييٍ،</para>
  <para style="q" vid="PSA 94:13">هَن مِشِ حَاشِيٍ عٍ فبٍ حَشَنكَتّ سْتْمَ تّمُي نَشّ.<verse eid="PSA 94:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 94:14"/>عَلَتَلَ مُ عَ شَ حَمَ رَبٌلٌمَ،</para>
  <para style="q" vid="PSA 94:14">عَ مُ عَ شَ مِشِيٍ رَبّحِنمَ.<verse eid="PSA 94:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 94:15"/>كِيتِ تِنشِنشِ قَمَ نّ سَدٍ،</para>
  <para style="q" vid="PSA 94:15">تِنشِنتْييٍ بْحّ بِرَ مَ نّ نَ قْشْ رَ.<verse eid="PSA 94:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 94:16"/>ندٍ ﭑ شُن مَقَلَمَ مِشِ حَاشِيٍ شْن مَ؟</para>
  <para style="q" vid="PSA 94:16">ندٍ تِمَ ﭑ بّ مِشِ كٌبِيٍ شِلِ مَ؟<verse eid="PSA 94:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 94:17"/>شَ ﭑ مَرِفِ مُ قِندِ ﭑ مَلِمَ رَ نُ،</para>
  <para style="q" vid="PSA 94:17">ﭑ مَ قٍ دَنمَ نّ فَبُرِ كُي نُ.<verse eid="PSA 94:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 94:18"/>ﭑ مَرِفِ، ﭑ نَ مَحْشُن عَ ﭑ سَنيِ مُ تِمَ سْنْن،</para>
  <para style="q" vid="PSA 94:18">عِ شَ دُفُتّفّحَ ﭑ دّ مّنمَ.<verse eid="PSA 94:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 94:19"/>ﭑ مَ كْنتْقِلِيٍ نَ وُيَ،</para>
  <para style="q" vid="PSA 94:19">عِ عٍ بَمَ ﭑ مَ، عِ قَ ﭑ نَسّيوَ.<verse eid="PSA 94:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="PSA 94:20"/>عِ نْمَ تِندٍ مَنفّيَ تِنشِنتَرٍ رَ،</para>
  <para style="q" vid="PSA 94:20">نَشَن يَامَرِ تِمَ قٍ كٌبِ رَ؟<verse eid="PSA 94:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 94:21"/>عٍ كَقُمَ عٍ بٌرٍ مَ تِنشِنتْي قَشَقٍ رَ،</para>
  <para style="q" vid="PSA 94:21">عٍ مِشِ تْوحّفّ كِيتِ كُي.<verse eid="PSA 94:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 94:22"/>كْنْ مَرِفِ نَن نَ ﭑ كَنتَمَ رَ،</para>
  <para style="q" vid="PSA 94:22">عَ لُمَ عَلْ قَنيٍ ﭑ سَبَتِمَ نَشَن قَرِ.<verse eid="PSA 94:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 94:23"/>عَ عٍ شَ وَلِ كٌبِيٍ رَفبِلٍنمَ نّ عٍ مَ،</para>
  <para style="q" vid="PSA 94:23">عَ عٍ شُن نَكَنَ عٍ شَ حَاشُحَ رَ.</para>
  <para style="q" vid="PSA 94:23">مُشُ مَرِفِ عَلَ عٍ سْنتْمَ نّ.<verse eid="PSA 94:23"/></para>
  <chapter eid="PSA 94"/>
  <chapter number="95" style="c" sid="PSA 95"/>
  <para style="s1">مَنفّ عَلَ مَتٌقٍ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 95:1"/>وٌن شَ بّيتِ بَ مَرِفِ بّ سّيوّ رَ،</para>
  <para style="q" vid="PSA 95:1">وٌن شَ وٌن شُي عِتٍ وٌن نَكِسِمَ سّنبّمَ بّ.<verse eid="PSA 95:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 95:2"/>وٌن شَ عَ مَتْشْ،</para>
  <para style="q" vid="PSA 95:2">وٌن شَ عَ مَتْشْي بَ عَ بّ بّيتِيٍ رَ،<verse eid="PSA 95:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 95:3"/>بَرِ مَ عَلَتَلَ، عَلَ شُنفبٍ نَ عَ رَ،</para>
  <para style="q" vid="PSA 95:3">نَشَن قِندِشِ مَنفّ شُنفبٍ رَ سّنبّمَيٍ بِرِن شُن مَ.<verse eid="PSA 95:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 95:4"/>يِرٍ تِلِنشِ نَ عَ بّلّشّ.</para>
  <para style="q" vid="PSA 95:4">فٍيَ شُنتَفِيٍ قِندِشِ عَ فبٍ نَن نَ،<verse eid="PSA 95:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 95:5"/>عَلْ بَا نُن بْشِ عَ نَشٍيٍ دَاشِ عَ بّلّشّ رَ.<verse eid="PSA 95:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 95:6"/>وٌ قَ، وٌن شَ سُيِدِ، وٌن شَ وٌن عِفٌرٌ،</para>
  <para style="q" vid="PSA 95:6">وٌن شَ وٌن شِنبِ سِن عَلَتَلَ يَ عِ نَشَن وٌن دَا،<verse eid="PSA 95:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 95:7"/>بَرِ مَ عَ تَن نَن وٌن مَرِفِ عَلَ رَ.</para>
  <para style="q" vid="PSA 95:7">وٌن قِندِشِ عَ شَ حَمَ نَن نَ عَ نَشَن دّ مَدٌنمَ،</para>
  <para style="q" vid="PSA 95:7">عَلْ شُرُ سٍ دّ مَدٌنيِ مّينِمَ فْورّ مَ كِ نَشّ.</para>
  <para style="b" vid="PSA 95:7"/>
  <para style="q" vid="PSA 95:7">وٌ شَ عَ شُي مّ تٌ.<verse eid="PSA 95:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 95:8"/>وٌ نَشَ وٌ بْحّيٍ رَشْرْشْ عَلْ نَشَن نَبَشِ مٍرِبَ،</para>
  <para style="q" vid="PSA 95:8">عَلْ نَشَن نَبَشِ مَسَ فبٍنفبٍرٍنيِ مَ تّمُي دَنفِشِ.<verse eid="PSA 95:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 95:9"/>وٌ بٍنبَيٍ ﭑ مَتٌ نّ نَ لْشْي،</para>
  <para style="q" vid="PSA 95:9">هَلِ عٍ تٌ نُ بَرَ ﭑ وَلِ قْشِ تٌ.<verse eid="PSA 95:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 95:10"/>نَ بْنسْي شَ قٍ نَشَ رَحَاشُ ﭑ مَ حّ تٌنفٌ نَانِ بُن مَ.</para>
  <para style="q" vid="PSA 95:10">ﭑ نَشَ عَ قَلَ، «حَمَ شُرُتَرٍ نَن يِ كِ،</para>
  <para style="q" vid="PSA 95:10">نَشَن مُ ﭑ وَشْنقٍ كٌلٌن.»<verse eid="PSA 95:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 95:11"/>نَ كُي ﭑ نَشَ ﭑ كَلِ ﭑ مَ شْنّ كُي،</para>
  <para style="q" vid="PSA 95:11">«عٍ مُ سٌمَ ﭑ مَ مَلَبُدٍ كُي قٍقٍ مَ!»<verse eid="PSA 95:11"/></para>
  <chapter eid="PSA 95"/>
  <chapter number="96" style="c" sid="PSA 96"/>
  <para style="s1">كِيتِسَ نَ قَقٍ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 96:1"/>وٌ بّيتِ نّينّ ندٍ بَ عَلَتَلَ بّ!</para>
  <para style="q" vid="PSA 96:1">دُنِحَ بِرِن شَ بّيتِ بَ عَلَتَلَ بّ!<verse eid="PSA 96:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 96:2"/>وٌ بّيتِ بَ مَرِفِ بّ، وٌ عَ شِلِ مَتْشْ.</para>
  <para style="q" vid="PSA 96:2">وٌ شَ عَ شَ كِسِ مَسٍن مِشِيٍ بّ تّمُي بِرِن.<verse eid="PSA 96:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 96:3"/>وٌ شَ عَ شَ نْرّ قَلَ سِ بِرِن بّ،</para>
  <para style="q" vid="PSA 96:3">وٌ عَ شَ كَابَنَكٌي مَسٍن حَمَ بِرِن تَفِ.<verse eid="PSA 96:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 96:4"/>مَرِفِ عَلَ فبٌ، عَ لَنمَ وٌن شَ عَ مَتْشْ،</para>
  <para style="q" vid="PSA 96:4">نَشَن دَنفِ سّنبّمَيٍ بِرِن نَ.<verse eid="PSA 96:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 96:5"/>سِيٍ بِرَ مَ عَلَ نَشٍيٍ قْشْ رَ،</para>
  <para style="q" vid="PSA 96:5">عٍ قِندِشِ كُيٍيٍ قُقَقُ فبَنسَن نَن نَ،</para>
  <para style="q" vid="PSA 96:5">كْنْ عَلَتَلَ نَن كٌورٍ دَا.<verse eid="PSA 96:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 96:6"/>نْرّ نُن نَءِيَلَنيِ كٍلِمَ عَ تَن نَن مَ،</para>
  <para style="q" vid="PSA 96:6">سّنبّ نُن نَءِيَلَنيِ لُمَ نّ عَ شَ هْرْ مْبَنشِ كُي.<verse eid="PSA 96:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 96:7"/>بْنسْي بِرِن، وٌ شَ تَنتُي رَ سِفَ عَلَتَلَ مَ،</para>
  <para style="q" vid="PSA 96:7">وٌ عَلَتَلَ مَتْشْ عَ شُننَكٍلِ نُن عَ شَ سّنبّ شَ قٍ رَ.<verse eid="PSA 96:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 96:8"/>وٌ شَ عَ شِلِ بِنيَ عَلْ عَ لَنمَ وٌ شَ عَ رَبَ كِ نَشّ.</para>
  <para style="q" vid="PSA 96:8">وٌ شَ قَ هَدِيَ رَ، وٌ شَ عَ رَ سٌ عَ شَ هْرْ مْبَنشِ تّتّ كُي.<verse eid="PSA 96:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 96:9"/>وٌ شَ سُيِدِ مَرِفِ بّ عَ شَ نْرّ يَ عِ.</para>
  <para style="q" vid="PSA 96:9">دُنِحَ بِرِن شَ سّرّن عَ يَ رَ.<verse eid="PSA 96:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 96:10"/>وٌ شَ عَ قَلَ سِ بِرِن بّ، «عَلَتَلَ نَن نَ مَنفّ رَ.</para>
  <para style="q" vid="PSA 96:10">دُنِحَ شَنشِ، عَ مُ عَ عِمَشَمَ.</para>
  <para style="q" vid="PSA 96:10">عَلَ حَمَيٍ مَكِيتِمَ تِنشِنيِ رَ.<verse eid="PSA 96:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 96:11"/>كٌورٍ شَ سّيوَ، بْشِ شَ حّلّشِن.</para>
  <para style="q" vid="PSA 96:11">بَا نُن عَ كُي عِسٍيٍ شَ وُندُ سّيوّ رَ.<verse eid="PSA 96:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 96:12"/>شّيٍ نُن عٍ شَ بٌفِ سٍيٍ شُي شَ عِتٍ،</para>
  <para style="q" vid="PSA 96:12">وٌندِ وُرِ بِلِيٍ شَ عٍ سّيوَ شُي عِتٍ<verse eid="PSA 96:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 96:13"/>عَلَتَلَ يَ رَ نَشَن قَقٍ.</para>
  <para style="q" vid="PSA 96:13">عَ قَقٍ دُنِحَ مَكِيتِدٍ.</para>
  <para style="q" vid="PSA 96:13">عَ دُنِحَ مَكِيتِمَ تِنشِنيِ نَن نَ،</para>
  <para style="q" vid="PSA 96:13">عَ حَمَيٍ مَكِيتِ نْندِ رَ.»<verse eid="PSA 96:13"/></para>
  <chapter eid="PSA 96"/>
  <chapter number="97" style="c" sid="PSA 97"/>
  <para style="s1">مَنفّ عَلَ مَفَاشُ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 97:1"/>عَلَتَلَ نَن نَ مَنفّ رَ.</para>
  <para style="q" vid="PSA 97:1">دُنِحَ شَ حّلّشِن، سُرِيٍ شَ سّيوَ.<verse eid="PSA 97:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 97:2"/>نُشُي نُن كُيٍ عِقْورْشِ عَ رَبِلِنمَ.</para>
  <para style="q" vid="PSA 97:2">عَ شَ كِبَنيِ دْشْشِ تِنشِنيِ نُن نْندِ قَرِ.<verse eid="PSA 97:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 97:3"/>تّ تِشِ عَ يَ رَ، عَ عَ يَشُييٍ بِرِن فَنمَ عَ رَبِلِنيِ.<verse eid="PSA 97:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 97:4"/>عَ دُنِحَ عِيَلَنمَ عَ شَ سٍيَمَكْنيِيٍ رَ،</para>
  <para style="q" vid="PSA 97:4">دُنِحَ مِشِيٍ نَ عَ تٌ، عٍ سّرّنمَ نّ.<verse eid="PSA 97:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 97:5"/>فٍيَيٍ شُنُمَ دُنِحَ مَرِفِ عَلَتَلَ يَ رَ عَلْ كُمِ دٌلٍ.<verse eid="PSA 97:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 97:6"/>كٌورٍ عَ شَ تِنشِنيِ مَسٍنمَ،</para>
  <para style="q" vid="PSA 97:6">سِ بِرِن عَ شَ نْرّ تٌمَ.<verse eid="PSA 97:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 97:7"/>كُيٍ بَتُيٍ قَمَ نّ يَافِدٍ عَ يَ رَ،</para>
  <para style="q" vid="PSA 97:7">سّنبّمَيٍ عٍ قٍلٍنمَ نّ عَ بُن مَ.<verse eid="PSA 97:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 97:8"/>سِيٌنِكَيٍ نَ عَ شُي مّ، عٍ سّيوَ مَ نّ،</para>
  <para style="q" vid="PSA 97:8">يُدَيَكَيٍ حّلّشِنمَ نّ عِ تَن عَلَتَلَ شَ كِيتِ رَ،<verse eid="PSA 97:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 97:9"/>بَرِ مَ عِ تَن مَرِفِ شُن نَكٍلِشِ سّنبّمَيٍ بِرِن بّ.<verse eid="PSA 97:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 97:10"/>عَلَتَلَ شَنُنتٍنيِ شَ قٍ حَاشِ شْن.</para>
  <para style="q" vid="PSA 97:10">عَلَتَلَ عَ بَتُلَيٍ مَكَنتَمَ نّ، عَ عٍ بَ مِشِ كٌبِيٍ بّلّشّ.<verse eid="PSA 97:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 97:11"/>نَءِيَلَنيِ نَ تِنشِنتْييٍ نَن بّ،</para>
  <para style="q" vid="PSA 97:11">سّيوّ نَ مِشِيٍ بّ نَشٍيٍ بْحّ قِيشّ.<verse eid="PSA 97:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 97:12"/>تِنشِنتْييٍ، وٌ سّيوَ مَرِفِ رَ،</para>
  <para style="q" vid="PSA 97:12">وٌ شَ تَنتُي رَ سِفَ عَ شِلِ سّنِيّنشِ مَ.<verse eid="PSA 97:12"/></para>
  <chapter eid="PSA 97"/>
  <chapter number="98" style="c" sid="PSA 98"/>
  <para style="s1">بّيتِ نّينّ بَمَ عَلَتَلَ بّ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 98:1"/>بّيتِ</para>
  <para style="q" vid="PSA 98:1">وٌ بّيتِ نّينّ بَ عَلَتَلَ بّ،</para>
  <para style="q" vid="PSA 98:1">بَرِ مَ عَ بَرَ كَابَنَكٌي رَبَ،</para>
  <para style="q" vid="PSA 98:1">عَ بّلّشّ سّنبّمَ بَرَ شُننَكٍلِ سْتْ عَ بّ.<verse eid="PSA 98:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 98:2"/>مَرِفِ بَرَ عَ شَ كِسِ مَسٍن،</para>
  <para style="q" vid="PSA 98:2">عَ بَرَ عَ شَ تِنشِنيِ سَ كّنّ مَ حَمَنّيٍ يَ عِ.<verse eid="PSA 98:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 98:3"/>عَ مُ نّيمُ عَ شَ دُفُتّفّحَ نُن عَ شَ شَنُنتٍيَ مَ عِسِرَيِلَ بْنسْي مَبِرِ.</para>
  <para style="q" vid="PSA 98:3">دُنِحَ بِرِن بَرَ وٌن مَرِفِ عَلَ شَ كِسِ تٌ.<verse eid="PSA 98:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 98:4"/>دُنِحَ بِرِن شَ عَلَتَلَ مَتْشْ،</para>
  <para style="q" vid="PSA 98:4">عٍ شَ بّيتِ بَ سّيوّ كُي.<verse eid="PSA 98:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 98:5"/>وٌ شَ عَلَتَلَ مَتْشْ كْرَ شُي نُن بّيتِ رَ،<verse eid="PSA 98:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 98:6"/>وٌ شَ سَرَيٍ قٍ سّيوّ رَ وٌ مَنفّ عَلَتَلَ يَ عِ.<verse eid="PSA 98:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 98:7"/>بَا نُن دُنِحَ شَ عٍ شُي رَ مِنِ،<verse eid="PSA 98:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 98:8"/>شُرٍيٍ شَ عٍ بّلّشّيٍ بْنبْ،</para>
  <para style="q" vid="PSA 98:8">فٍيَيٍ شَ عٍ شُي عِتٍ سّيوّ رَ <verse eid="PSA 98:8"/><verse number="9" style="v" sid="PSA 98:9"/>عَلَتَلَ يَ رَ،</para>
  <para style="q" vid="PSA 98:9">بَرِ مَ عَ قَقٍ دُنِحَ مَكِيتِدٍ.</para>
  <para style="q" vid="PSA 98:9">عَ دُنِحَ مَكِيتِمَ تِنشِنيِ نَن نَ،</para>
  <para style="q" vid="PSA 98:9">عَ حَمَيٍ مَكِيتِمَ نْندِ رَ.<verse eid="PSA 98:9"/></para>
  <chapter eid="PSA 98"/>
  <chapter number="99" style="c" sid="PSA 99"/>
  <para style="s1">مَنفّ عَلَتَلَ سّنِيّن</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 99:1"/>عَلَ دْشْشِ عَ شَ كِبَنيِ كُي كٍرُبِمِ مَلٍكّيٍ تَفِ.</para>
  <para style="q" vid="PSA 99:1">عَ شَ حَمَ تِشِ فَاشُي كُي، بْشِ نَ سّرّنقٍ.<verse eid="PSA 99:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 99:2"/>عَلَتَلَ فبٌ سِيٌنِ، عَ تِشِ سِيٍ بِرِن شُن مَ.<verse eid="PSA 99:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 99:3"/>عٍ شَ عِ شِلِ شُنفبٍ مَفَاشُشِ مَتْشْ عَ شَ سّنِيّنيِ شَ قٍ رَ.<verse eid="PSA 99:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 99:4"/>مَنفّ سّنبّ شَ مَتْشْ،</para>
  <para style="q" vid="PSA 99:4">تِنشِنيِ رَقَن عَ مَ،</para>
  <para style="q" vid="PSA 99:4">عَ كِيتِ سَمَ نْندِ رَ يَشُبَ شَ بْشِ مَ.<verse eid="PSA 99:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 99:5"/>وٌ مَرِفِ عَلَتَلَ مَتْشْ،</para>
  <para style="q" vid="PSA 99:5">وٌ وٌ مَفٌرٌ عَ بُن مَ عَ شَ سّنِيّنيِ شَ قٍ رَ.<verse eid="PSA 99:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 99:6"/>مُنسَ نُن هَرُنَ نُ نَ عَ شَ سّرّشّدُبّيٍ يَ مَ،</para>
  <para style="q" vid="PSA 99:6">عَننَبِ سَمُوٍلِ نُ نَ مِشِيٍ يَ مَ نَشٍيٍ عَ مَشَندِ مَ.</para>
  <para style="q" vid="PSA 99:6">عٍ تٌ عَ شِلِ، عَ نَشَ عٍ يَابِ.<verse eid="PSA 99:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 99:7"/>عَ تٌ سّرِيّ نُن يَامَرِ مَسٍن عٍ بّ نُشُي كُي،</para>
  <para style="q" vid="PSA 99:7">عٍ نَشَ عَ شُي سُشُ.<verse eid="PSA 99:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 99:8"/>مُشُ مَرِفِ عَلَتَلَ، عِ بَرَ عٍ شَ مَشَندِ سُشُ.</para>
  <para style="q" vid="PSA 99:8">عِ تٌ عِسِرَيِلَ حَشَنكَتَ عٍ شَ يُنُبِ شَ قٍ رَ،</para>
  <para style="q" vid="PSA 99:8">عِ مَن بَرَ دِحّ عٍ مَ.<verse eid="PSA 99:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 99:9"/>وٌ شَ وٌ مَرِفِ عَلَتَلَ مَتْشْ،</para>
  <para style="q" vid="PSA 99:9">وٌ شَ وٌ شِنبِ سِن عَ شَ فٍيَ سّنِيّنشِ قَرِ،</para>
  <para style="q" vid="PSA 99:9">بَرِ مَ وٌن مَرِفِ عَلَتَلَ سّنِيّن!<verse eid="PSA 99:9"/></para>
  <chapter eid="PSA 99"/>
  <chapter number="100" style="c" sid="PSA 100"/>
  <para style="s1">تَنتُي بّيتِ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 100:1"/>تَنتُي بّيتِ</para>
  <para style="q" vid="PSA 100:1">دُنِحَ بِرِن شَ عَلَتَلَ مَتْشْ!<verse eid="PSA 100:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 100:2"/>وٌ شَ عَلَتَلَ بَتُ سّيوّ كُي.</para>
  <para style="q" vid="PSA 100:2">وٌ شَ قَ عَ يَ عِ وٌ سّيوّ شُي عِتٍشِ رَ.<verse eid="PSA 100:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 100:3"/>وٌ شَ عَ كٌلٌن عَلَتَلَ نَن وٌ مَرِفِ عَلَ رَ.</para>
  <para style="q" vid="PSA 100:3">عَ تَن نَن وٌن دَاشِ، وٌن قِندِشِ عَ فبٍ نَن نَ.</para>
  <para style="q" vid="PSA 100:3">وٌن قِندِشِ عَ شَ حَمَ نَن نَ،</para>
  <para style="q" vid="PSA 100:3">نَشَن لُشِ عَلْ عَ شَ شُرُ سٍ فْورّ عَ نَشَن دّ مَدٌنمَ.<verse eid="PSA 100:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 100:4"/>وٌ سٌ عَ شَ نَادّيٍ رَ عَ تَنتُقٍ رَ،</para>
  <para style="q" vid="PSA 100:4">وٌ سٌ عَ شَ هْرْ مْبَنشِ تّتّ كُي عَ مَتْشْقٍ رَ!</para>
  <para style="q" vid="PSA 100:4">وٌ تَنتُي رَ سِفَ عَ مَ، وٌ عَ شِلِ مَتْشْ،<verse eid="PSA 100:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 100:5"/>بَرِ مَ عَلَتَلَ قَن، عَ شَ شَنُنتٍيَ بُمَ نّ عَبَدَن،</para>
  <para style="q" vid="PSA 100:5">عَ شَ دُفُتّفّحَ مُ حْنمَ دُنِحَ بّندّ قُحِ قَرِ مَ.<verse eid="PSA 100:5"/></para>
  <chapter eid="PSA 100"/>
  <chapter number="101" style="c" sid="PSA 101"/>
  <para style="s1">دَوُدَ شَ نَتّيٍ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 101:1"/>دَوُدَ شَ بّيتِ</para>
  <para style="q" vid="PSA 101:1">ﭑ دُفُتّفّحَ نُن تِنشِنيِ مَتْشْمَ نّ.</para>
  <para style="q" vid="PSA 101:1">ﭑ بّيتِ بَمَ عِ تَن نَن بّ عَلَتَلَ.<verse eid="PSA 101:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 101:2"/>ﭑ قٍ بِرِن نَبَمَ لُقٍ رَ تِنشِنتْي شَ كِرَ شْن.</para>
  <para style="q" vid="PSA 101:2">عِ قَمَ ﭑ يِرٍ مُن تّمُي؟</para>
  <para style="q" vid="PSA 101:2">ﭑ نَ ﭑ حّرّ مَ نّ ﭑ بْحّ قِيشّشِ رَ ﭑ مَ مِشِيٍ تَفِ.<verse eid="PSA 101:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 101:3"/>ﭑ مُ ﭑ يَ تِمَ قٍ تِنشِنتَرٍ رَ،</para>
  <para style="q" vid="PSA 101:3">ﭑ مُ تِنمَ يَنقَنتٍ شَ كِرَ رَ،</para>
  <para style="q" vid="PSA 101:3">ﭑ نُن عٍ تَن مُ لَنمَ قٍ يٌ مَ.<verse eid="PSA 101:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 101:4"/>ﭑ تَن نُن مِشِ حَاشِ تَفِ كُيَ،</para>
  <para style="q" vid="PSA 101:4">ﭑ مُ وَ مَ يُنُبِ شْن.<verse eid="PSA 101:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 101:5"/>ﭑ مِشِ دّ بَلَنمَ نّ نَشَن عَ بٌورٍ مَقَلَمَ.</para>
  <para style="q" vid="PSA 101:5">ﭑ مُ تِنمَ يّتّ مَتْشْي نُن يّتّ عِفبٌحَ رَ.<verse eid="PSA 101:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 101:6"/>ﭑ نَ ﭑ حْشْ سَمَ نّ يِ بْشِ دُفُتّفّيٍ شْن مَ،</para>
  <para style="q" vid="PSA 101:6">عَلَكٌ عٍ شَ لُ ﭑ سّيتِ مَ.</para>
  <para style="q" vid="PSA 101:6">ﭑ وَ مَ تِنشِنتْييٍ نَن شْن مَ، عٍ شَ ﭑ مَلِ.<verse eid="PSA 101:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 101:7"/>يَنقَنتٍيٍ مُ لُمَ ﭑ مَ مِشِيٍ يَ مَ،</para>
  <para style="q" vid="PSA 101:7">وُلٍ قَلّيٍ مُ تِمَ ﭑ يَ عِ.<verse eid="PSA 101:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 101:8"/>فّيسّفّ بِرِن ﭑ مِشِ كٌبِيٍ سْنتْمَ نّ،</para>
  <para style="q" vid="PSA 101:8">عَلَكٌ نَ مِشِ مْولِ نَشَ لُ عَلَتَلَ شَ تَا كُي.<verse eid="PSA 101:8"/></para>
  <chapter eid="PSA 101"/>
  <chapter number="102" style="c" sid="PSA 102"/>
  <para style="s1">قُرٍ مَ شَ مَشَندِ</para>
  <para style="s2">عَلَ مَشَندِ نُن عَلَ مَتْشْي</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 102:1"/>تْورْ مِشِ نَشَن عَلَتَلَ مَشَندِقٍ عَ شَ تْورّ كُي.<verse eid="PSA 102:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 102:2"/>عَلَتَلَ، عِ شَ ﭑ مَ مَشَندِ سُشُ،</para>
  <para style="q" vid="PSA 102:2">عِ شَ عِ تُلِ مَتِ ﭑ وَ شُي رَ.<verse eid="PSA 102:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 102:3"/>عِ نَشَ عِ كٌبٍ سٌ ﭑ نَ ﭑ مَ تْورّ كُي.</para>
  <para style="q" vid="PSA 102:3">عِ شَ ﭑ مَ مَشَندِ سُشُ مَقُرٍن.<verse eid="PSA 102:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 102:4"/>ﭑ مَ سِمَيَ نَ لْيقٍ عَلْ تُورِ لْيمَ كُيٍ مَ كِ نَشّ،</para>
  <para style="q" vid="PSA 102:4">ﭑ شْرِيٍ نَ حْنقٍ عَلْ يٍفٍ فَنمَ تّ رَ كِ نَشّ،<verse eid="PSA 102:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 102:5"/>ﭑ بْحّ نَ لِسِقٍ عَلْ سّشّ نَشَن نَ قِيلِ مَ.</para>
  <para style="q" vid="PSA 102:5">ﭑ مُ دٌنسٍ دٌنمَ سْنْن.<verse eid="PSA 102:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 102:6"/>ﭑ نَ وَ ﭑ شُي عِتٍشِ رَ، ﭑ شْرِيٍ بِرِن مَكّنّنمَ نّ.<verse eid="PSA 102:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 102:7"/>ﭑ بَرَ لُ عَلْ شُندِ نَشَن تٌمَ وُلَ عِ،</para>
  <para style="q" vid="PSA 102:7">عَلْ كٌوقٌلٍ نَشَن نَ بَنشِ تٌنبٌلٌنيِ كُي.<verse eid="PSA 102:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 102:8"/>ﭑ مُ نْمَ شِدٍ.</para>
  <para style="q" vid="PSA 102:8">ﭑ كِرٌشِ عَلْ شْنِ نَشَن نَ كٍرٍنيِ مَ بَنشِ قَرِ.<verse eid="PSA 102:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 102:9"/>ﭑ يَشُييٍ يٌمَ ﭑ مَ لْشْي بِرِن،</para>
  <para style="q" vid="PSA 102:9">عٍ ﭑ شِلِ رَوَلِمَ دَنكّ وْيّنيِ رَ.<verse eid="PSA 102:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 102:10"/>ﭑ دّ رَقٍشِ تّشُبٍ رَ عَلْ دٌنسٍ،</para>
  <para style="q" vid="PSA 102:10">ﭑ يَيٍ سِلْنمَ ﭑ مَ مِنسٍ شُن مَ<verse eid="PSA 102:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 102:11"/>عِ شَ بْحّتٍ نُن عِ شَ شْنّ شَ قٍ رَ.</para>
  <para style="q" vid="PSA 102:11">عِ بَرَ ﭑ كٍرِ ثٌن!<verse eid="PSA 102:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 102:12"/>ﭑ مَ سِمَيَ بَرَ لُ عَلْ نِينِ نَشَن لْيمَ دِ مِ كُي،</para>
  <para style="q" vid="PSA 102:12">عَلْ سّشّ نَشَن لِسِمَ قِيلِ مَ.<verse eid="PSA 102:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 102:13"/>كْنْ عِ تَن عَلَتَلَ لُمَ نّ عِ شَ كِبَنيِ كُي عَبَدَن،</para>
  <para style="q" vid="PSA 102:13">عِ شِلِ مُ لْيمَ دُنِحَ مَ.<verse eid="PSA 102:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 102:14"/>عِ قَمَ نّ كٍلِدٍ عِ شَ كِنِكِنِ سِيٌنِ مَ،</para>
  <para style="q" vid="PSA 102:14">بَرِ مَ عَ لَنشِ عِ شَ هِننّ عَ رَ يِ وَشَتِ سُفَندِشِ مَ.<verse eid="PSA 102:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 102:15"/>عَ فّمّيٍ نُن عَ بْشِ رَقَن عِ شَ كٌنيِ دِيٍ مَ.<verse eid="PSA 102:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 102:16"/>سِيٍ بِرِن قَمَ فَاشُدٍ عَلَتَلَ شِلِ يَ رَ،</para>
  <para style="q" vid="PSA 102:16">مَنفّيٍ بِرِن قَمَ عٍ شِنبِ سِندٍ عِ شَ نْرّ يَ رَ.<verse eid="PSA 102:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 102:17"/>عَلَتَلَ مَن قَمَ نّ سِيٌنِ تِدٍ،</para>
  <para style="q" vid="PSA 102:17">عَ عَ يّتّ مَسٍن عَ شَ نْرّ كُي.<verse eid="PSA 102:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 102:18"/>عَ عَ يَ رَقِندِ مَ نّ مِسِكِينّ شَ مَشَندِ مَ،</para>
  <para style="q" vid="PSA 102:18">عَ مُ يٌ عَ شَ دُبّ مَ.<verse eid="PSA 102:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PSA 102:19"/>نَ شَ سّبّ بْنسْييٍ بّ نَشٍيٍ قَمَ،</para>
  <para style="q" vid="PSA 102:19">عَلَكٌ مِشِ نَشٍيٍ مُ دَاشِ سِندٍن عٍ شَ عَلَتَلَ مَتْشْ،<verse eid="PSA 102:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 102:20"/>بَرِ مَ عَ عَ يَ رَفٌرٌ مَ وٌن مَ كٍلِقٍ عَ شَ يِرٍ سّنِيّنشِ عِتٍشِ.</para>
  <para style="q" vid="PSA 102:20">عَلَتَلَ بْشِ مَتٌمَ كٍلِقٍ كٌورٍ مَ،<verse eid="PSA 102:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 102:21"/>عَلَكٌ عَ شَ فٍيلِمَنِيٍ وَ شُي رَ مّ،</para>
  <para style="q" vid="PSA 102:21">عَ شَ مِشِيٍ رَتَنفَ نَشٍيٍ نَ قَشّ شَ كِرَ مَ،<verse eid="PSA 102:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 102:22"/>عَلَكٌ عٍ شَ عَلَتَلَ شِلِ مَسٍن سِيٌنِ تَا كُي،</para>
  <para style="q" vid="PSA 102:22">عٍ شَ عَ مَتْشْ بّيتِ رَ دَرِ سَلَمُ،<verse eid="PSA 102:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 102:23"/>سِيٍ نَ عٍ مَلَن تّمُي نَشّ عَلَتَلَ بَتُقٍ رَ.<verse eid="PSA 102:23"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="24" style="v" sid="PSA 102:24"/>عَ بَرَ ﭑ مَ سّنبّ بَ ﭑ يِ رَ ﭑ مَ دُنِحّءِفِرِ كُي،</para>
  <para style="q" vid="PSA 102:24">عَ بَرَ ﭑ مَ سِمَيَ رَدُنكٍ.<verse eid="PSA 102:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 102:25"/>ﭑ نَشَ عَ قَلَ عَ بّ، «ﭑ مَرِفِ عَلَ،</para>
  <para style="q" vid="PSA 102:25">عِ نَشَ ﭑ نِي بَ ﭑ مَ سِمَيَ تَفِ رَ،</para>
  <para style="q" vid="PSA 102:25">عِ تَن نَشَن بُمَ عَبَدَن،<verse eid="PSA 102:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 102:26"/>عِ تَن نَن دُنِحَ دَا،</para>
  <para style="q" vid="PSA 102:26">عِ تَن نَن كٌورٍ عِتَلَ عِ شْنيّ رَ.<verse eid="PSA 102:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 102:27"/>عٍ تَن حْنمَ نّ، كْنْ عِ تَن بُمَ نّ عَبَدَن،</para>
  <para style="q" vid="PSA 102:27">عٍ بِرِن قٌرِ مَ نّ عَلْ سٌسٍ، كْنْ عِ تَن عٍ مَسَرَ مَ نّ عَلْ دٌنمَ.</para>
  <para style="q" vid="PSA 102:27">عِ عٍ مَسَرَ مَ نّ، عَلْ دٌنمَ نَشَن نَفٌرٌ مَ، عَ وْلّ.<verse eid="PSA 102:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 102:28"/>كْنْ عِ تَن مُ مَسَرَ مَ، عِ مُ حْنمَ عَبَدَن.<verse eid="PSA 102:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 102:29"/>عِ شَ كٌنيِيٍ شَ دِيٍ قَمَ نّ سَبَتِدٍ بٍ،</para>
  <para style="q" vid="PSA 102:29">عٍ بْنسْي قَ بُ شَشِلِسَ كُي عِ يَ عِ.»<verse eid="PSA 102:29"/></para>
  <chapter eid="PSA 102"/>
  <chapter number="103" style="c" sid="PSA 103"/>
  <para style="s1">عَلَ شَ مَرَقَنيِ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 103:1"/>دَوُدَ شَ بّيتِ</para>
  <para style="q" vid="PSA 103:1">ﭑ شَ عَلَتَلَ تَنتُ ﭑ نِي بِرِن نَ،</para>
  <para style="q" vid="PSA 103:1">ﭑ شَ عَ شِلِ سّنِيّنشِ مَتْشْ.<verse eid="PSA 103:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 103:2"/>ﭑ شَ عَلَتَلَ تَنتُ ﭑ نِي بِرِن نَ،</para>
  <para style="q" vid="PSA 103:2">ﭑ نَشَ نّيمُ عَ شَ هِننّ مَ.<verse eid="PSA 103:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 103:3"/>عَ تَن نَن دِحّمَ عِ شَ يُنُبِيٍ مَ،</para>
  <para style="q" vid="PSA 103:3">عَ عِ شَ قُرٍيٍ رَيَلَن،<verse eid="PSA 103:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 103:4"/>عَ عِ رَتَنفَ قَشّ مَ،</para>
  <para style="q" vid="PSA 103:4">عَ عِ رَبِلِن عَ شَ شَنُنتٍيَ نُن عَ شَ كِنِكِنِ رَ.<verse eid="PSA 103:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 103:5"/>عَ هِننّمَ عِ رَ عِ شَ دُنِحّءِفِرِ كُي،</para>
  <para style="q" vid="PSA 103:5">عَلَكٌ عِ مَن شَ سّنبّ سْتْ عِ شَ قٌرِحَ كُي عَلْ سّفّ.<verse eid="PSA 103:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 103:6"/>عَلَتَلَ حّرّ مَ تِنشِنيِ كُي،</para>
  <para style="q" vid="PSA 103:6">عَ كِيتِ تِنشِنشِ سَمَ تْورْ مِشِيٍ بّ.<verse eid="PSA 103:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 103:7"/>عَ بَرَ عَ شَ كِرَ مَسٍن عَننَبِ مُنسَ بّ،</para>
  <para style="q" vid="PSA 103:7">عَ عَ شَ كَابَنَكٌييٍ مَسٍن عِسِرَيِلَكَيٍ بّ.<verse eid="PSA 103:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 103:8"/>عَلَتَلَ كِنِكِنِمَ مِشِيٍ مَ، عَ هِننّ عٍ رَ،</para>
  <para style="q" vid="PSA 103:8">عَ مُ شْنْمَ عٍ مَ مَقُرٍن مَقُرٍن، عَ شَ شَنُنتٍيَ فبٌ.<verse eid="PSA 103:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 103:9"/>عَ مُ مِشِيٍ تْورْ مَ تّمُي بِرِن،</para>
  <para style="q" vid="PSA 103:9">عَ شَ شْننَنتٍيَ مُ بُمَ.<verse eid="PSA 103:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 103:10"/>عَ مُ وٌن حَشَنكَتَمَ وٌن مَ يُنُبِ رَبَشِ كِ مَ،</para>
  <para style="q" vid="PSA 103:10">عَ مُ وٌن مَ يُنُبِ سَرٍ رَفبِلٍنمَ وٌن مَ.<verse eid="PSA 103:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 103:11"/>كٌورٍ عِتٍشِ بْشِ شُن مَ كِ نَشّ،</para>
  <para style="q" vid="PSA 103:11">عَ شَ شَنُنتٍيَ قَن فبٌشِ نَ كِ نّ عَ يَرَفَاشُييٍ بّ.<verse eid="PSA 103:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 103:12"/>سٌفٍتٍدٍ مَكُيَشِ سٌفٍفٌرٌدٍ رَ كِ نَشّ،</para>
  <para style="q" vid="PSA 103:12">عَ وٌن مَ يُنُبِيٍ قَن مَكُيَشِ وٌن نَ نَ كِ نّ.<verse eid="PSA 103:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 103:13"/>بَبَيٍ كِنِكِنِمَ عٍ شَ دِيٍ مَ كِ نَشّ،</para>
  <para style="q" vid="PSA 103:13">عَلَتَلَ قَن كِنِكِنِمَ عَ يَرَفَاشُييٍ مَ نَ كِ نّ،<verse eid="PSA 103:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 103:14"/>بَرِ مَ عَ عَ كٌلٌن وٌن يَءِلَنشِ سٍ نَشَن نَ،</para>
  <para style="q" vid="PSA 103:14">عَ رَتُشِ عَ مَ عَ بّندّ نَن وٌن نَ.<verse eid="PSA 103:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 103:15"/>عَدَ مَدِيٍ شَ سِمَيَ مَنِيَ سَنسِ رَ نَشَن قُفَمَ قِيلِ مَ،<verse eid="PSA 103:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 103:16"/>كْنْ قٌيٍ نَ بْنبْ عَ رَ، عَ شَرَ مَ نّ، عَ لْي.<verse eid="PSA 103:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 103:17"/>كْنْ عَلَتَلَ عَ يَرَفَاشُييٍ شَنُمَ نّ عَبَدَن،</para>
  <para style="q" vid="PSA 103:17">عَ شَ تِنشِنيِ بِرَ مَ نّ عٍ بْنسْييٍ قْشْ رَ،<verse eid="PSA 103:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 103:18"/>نَشٍيٍ عَ شَ سَاتّ بِنيَمَ،</para>
  <para style="q" vid="PSA 103:18">عٍ عَ شَ سّرِيّ رَبَتُ.<verse eid="PSA 103:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 103:19"/>عَلَتَلَ بَرَ عَ شَ كِبَنيِ دْشْ كٌورٍ مَ،</para>
  <para style="q" vid="PSA 103:19">عَ دُنِحَ بِرِن يَمَرِ.<verse eid="PSA 103:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="PSA 103:20"/>وٌ تَن مَلٍكّيٍ، وٌ شَ عَلَتَلَ تَنتُ،</para>
  <para style="q" vid="PSA 103:20">وٌ تَن نَشٍيٍ سّنبّ فبٌ، وٌ تَن نَشٍيٍ عَ رَبَتُمَ.<verse eid="PSA 103:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 103:21"/>وٌ تَن سّنبّمَ نَشٍيٍ نَ كٌورٍ مَ، وٌ شَ عَلَتَلَ تَنتُ،</para>
  <para style="q" vid="PSA 103:21">وٌ تَن نَشٍيٍ عَ وَشْنقٍ رَبَمَ.<verse eid="PSA 103:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 103:22"/>وٌ تَن بِرِن نَشٍيٍ دَاشِ، وٌ شَ عَلَتَلَ تَنتُ يِرٍ بِرِن عَ شَ مَنفّيَ بُن مَ.</para>
  <para style="q" vid="PSA 103:22">ﭑ شَ عَلَتَلَ تَنتُ ﭑ نِي بِرِن نَ.<verse eid="PSA 103:22"/></para>
  <chapter eid="PSA 103"/>
  <chapter number="104" style="c" sid="PSA 104"/>
  <para style="s1">عَلَتَلَ شَ دَالِسٍيٍ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 104:1"/>ﭑ شَ عَلَتَلَ تَنتُ ﭑ نِي بِرِن نَ.</para>
  <para style="b" vid="PSA 104:1"/>
  <para style="q" vid="PSA 104:1">ﭑ مَرِفِ عَلَتَلَ، عِ سّنبّ فبٌ،</para>
  <para style="q" vid="PSA 104:1">نْرّ نُن يَنبّ نَ عِ مَ،<verse eid="PSA 104:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 104:2"/>عَ لُشِ عَلْ نَءِيَلَنيِ يَتِ قِندِشِ عِ شَ فُبَ نَن نَ.</para>
  <para style="q" vid="PSA 104:2">عِ كٌورٍ عِتَلَشِ عَلْ دُفِ شُنفبٍ عِ سَبَتِشِ نَشَن بُن مَ،<verse eid="PSA 104:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 104:3"/>عِ شَ كٌنكٌي تِشِ نُشُييٍ قَرِ يٍ رَفَتَشِ دّننَشّ.</para>
  <para style="q" vid="PSA 104:3">عِ نُشُييٍ قِندِ عِ شَ حّرّ سٍ رَ،</para>
  <para style="q" vid="PSA 104:3">عِ عِ حّرّ قٌيٍ قَرِ.<verse eid="PSA 104:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 104:4"/>عِ قٌيٍ شّيمَ عِ شَ مَسٍنيِ رَ،</para>
  <para style="q" vid="PSA 104:4">عِ تّ رَ سَنبَمَ عِ شَ وَلِ رَبَقٍ رَ.<verse eid="PSA 104:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 104:5"/>عَلَ دُنِحَ تِشِ نّ عَلْ بَنشِ تِشِ كِ نَشّ،</para>
  <para style="q" vid="PSA 104:5">عَ مُ عَ مَمَشَمَ قٍوٌ.<verse eid="PSA 104:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 104:6"/>عَ بَا دُ سُ نّ عَ شُن مَ عَلْ دُفِ،</para>
  <para style="q" vid="PSA 104:6">عَ فٍيَيٍ شُنتَفِ مَكٌتٌ.<verse eid="PSA 104:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 104:7"/>عِ تٌ شَاحّ يٍ مَ، عَ عَ فِ عِ شَ فَلَنيِ شُي مَ،<verse eid="PSA 104:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 104:8"/>فٍيَيٍ نُن فُلُنبَيٍ قَ لُ يِرٍ عِ نُ وَ دّننَشّ شْن.<verse eid="PSA 104:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 104:9"/>عِ نَانِنيِ سَشِ يٍ بّ عَ مُ تُفَنمَ نَشَن شُن مَ،</para>
  <para style="q" vid="PSA 104:9">عَلَكٌ عَ نَشَ فبِلٍن دِن نَ شَرٍ مَ.<verse eid="PSA 104:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 104:10"/>عِ دُلٌنيِيٍ قِندِ شُرٍيٍ رَ،</para>
  <para style="q" vid="PSA 104:10">نَشٍيٍ سُسُمَ فٍيَ لٌنفٌرِيٍ رَ،<verse eid="PSA 104:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 104:11"/>عَ يٍ شْلِ بَ بُرُنيِ سُبٍيٍ بِرِن مَ،</para>
  <para style="q" vid="PSA 104:11">عَ يٍ شْلِ بَ وُلَءِ سٌقَلٍيٍ مَ.<verse eid="PSA 104:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 104:12"/>شْنِيٍ سَبَتِشِ نٍيٍ قّ مَ،</para>
  <para style="q" vid="PSA 104:12">عٍ عٍ شُي رَ مِنِمَ وُرِ سَلٌنيِيٍ كْن نَ بُرّشّيٍ لٌنفٌرِ رَ.<verse eid="PSA 104:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 104:13"/>عِ فٍيَيٍ بُندَ مَ يٍ رَ كٍلِ كٌورٍ مَ،</para>
  <para style="q" vid="PSA 104:13">بْشِ وَ سَمَ عِ شَ وَلِ رَ.<verse eid="PSA 104:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 104:14"/>عِ حٌوفٍ رَ مِنِمَ شُرُ سٍيٍ بّ،</para>
  <para style="q" vid="PSA 104:14">عِ سَنسِيٍ رَبُلَمَ عَدَ مَدِيٍ بّ،</para>
  <para style="q" vid="PSA 104:14">عٍ بَلٌي سْتْمَ نَشٍيٍ رَ.<verse eid="PSA 104:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 104:15"/>عِ وّنِ قِمَ مِشِيٍ مَ، نَشَن عٍ بْحّ رَقَنمَ عٍ مَ،</para>
  <para style="q" vid="PSA 104:15">عِ تُرٍ رَ مِنِمَ عٍ بّ، نَشَن عٍ كِرِ رَتٌقَنمَ،</para>
  <para style="q" vid="PSA 104:15">عِ عٍ بَلٌمَ دٌنسٍ رَ، نَشَن سّنبّ قِمَ عٍ مَ.<verse eid="PSA 104:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 104:16"/>لِبَن وُرِ بِلِيٍ، مَرِفِ نَشٍيٍ سِشِ،</para>
  <para style="q" vid="PSA 104:16">عٍ بَرَ يٍ سْتْ عَ قَنيِ رَ،<verse eid="PSA 104:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 104:17"/>شْنِيٍ عٍ تّي سَمَ عٍ كْن نَ.</para>
  <para style="q" vid="PSA 104:17">فبٌنفبٌي عٍ تّي سَمَ سِثِرّ وُرِ بِلِيٍ كْن نَ،<verse eid="PSA 104:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 104:18"/>وُلَءِ سِيٍ شِمَ فٍيَيٍ قَرِ،</para>
  <para style="q" vid="PSA 104:18">سَفَلٍيٍ لُمَ فّمّ لٌنفٌرِيٍ رَ.<verse eid="PSA 104:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PSA 104:19"/>عِ كِكٍ يَءِلَنشِ سَلِ وَشَتِيٍ كٌلٌنقٍ نَن نَ.</para>
  <para style="q" vid="PSA 104:19">سٌفٍ عَ دُلَ تّمُي كٌلٌن.<verse eid="PSA 104:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 104:20"/>عِ دِ مِ رَقَمَ كْي رَ، بُرُن سُبٍيٍ حّرّ مَ تّمُي نَشّ.<verse eid="PSA 104:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 104:21"/>يّتّيٍ نَ عٍ شُي رَ مِنِ دٌنسٍ قٍنقٍ رَ، عَلَ عٍ كِمَ بَلٌي رَ.<verse eid="PSA 104:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 104:22"/>سٌفٍ نّقّ مِنِ، عٍ فبِلٍن عٍ شَ قْنمّيٍ رَ.<verse eid="PSA 104:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 104:23"/>مِشِيٍ تَن مِنِ، عٍ سَ قّيحّن وَلِدٍ.<verse eid="PSA 104:23"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="24" style="v" sid="PSA 104:24"/>عَلَتَلَ، عِ شَ دَالِسٍيٍ وُيَ.</para>
  <para style="q" vid="PSA 104:24">عِ عٍ بِرِن دَاشِ شَشِلِمَيَ نَن نَ.</para>
  <para style="q" vid="PSA 104:24">بْشِ رَقٍشِ عِ شَ دَالِسٍيٍ رَ،<verse eid="PSA 104:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 104:25"/>بَا قَن نَقٍشِ عِ شَ دَالِسٍيٍ رَ،</para>
  <para style="q" vid="PSA 104:25">ندٍيٍ شُرُن، ندٍيٍ شُنفبٌ، عٍ وُيَ.<verse eid="PSA 104:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 104:26"/>كُنكُي شُنفبٍيٍ حّرّ مَ مّننِ قَرِ،</para>
  <para style="q" vid="PSA 104:26">ثٍرٍ مُي حّرّ مَ بَا بُن مَ حّلّشِنيِ رَ.<verse eid="PSA 104:26"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="27" style="v" sid="PSA 104:27"/>يِ دَالِسٍ بِرِن عٍ شَشِلِ تِشِ عِ تَن نَن نَ عٍ بَلٌي شَ قٍ رَ.<verse eid="PSA 104:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 104:28"/>عِ نَ عٍ كِ، عٍ عَ سْتْمَ نّ عِ سَابُي رَ، عٍ وَ سَ.<verse eid="PSA 104:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 104:29"/>عِ نَ عٍ كُمَ، عٍ فَاشُمَ نّ.</para>
  <para style="q" vid="PSA 104:29">عِ نَ عٍ حّنفِ بَ، عٍ قَشَمَ نّ، عٍ فبِلٍن بّندّ.<verse eid="PSA 104:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 104:30"/>عِ نَ عِ حّنفِ رَ سٌ عٍ قَتٍ، عٍ مَن بَلٌ،</para>
  <para style="q" vid="PSA 104:30">بْشِ مَن قَ قَن.<verse eid="PSA 104:30"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="31" style="v" sid="PSA 104:31"/>عَلَتَلَ شَ نْرّ شَ بُ عَبَدَن!</para>
  <para style="q" vid="PSA 104:31">عَلَتَلَ شَ سّيوَ عَ شَ دَالِيٍ رَ!<verse eid="PSA 104:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 104:32"/>عَ نَ بْشِ مَتٌ، عَ سّرّنمَ نّ،</para>
  <para style="q" vid="PSA 104:32">عَ نَ دِن فٍيَيٍ رَ، عٍ فَنمَ نّ.<verse eid="PSA 104:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 104:33"/>ﭑ عَلَتَلَ مَتْشْمَ نّ قَننِ ﭑ بَلٌشِ،</para>
  <para style="q" vid="PSA 104:33">ﭑ بّيتِ بَمَ نّ ﭑ مَرِفِ عَلَ بّ قَننِ ﭑ نَ دُنِحَ مَ.<verse eid="PSA 104:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 104:34"/>ﭑ مَ دُبّ شَ رَقَن عَ مَ.</para>
  <para style="q" vid="PSA 104:34">ﭑ سّيوَ مَ نّ عَلَتَلَ شَ قٍ رَ.<verse eid="PSA 104:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 104:35"/>كْنْ يُنُبِتْييٍ تَن شَ لْي دُنِحَ مَ.</para>
  <para style="q" vid="PSA 104:35">مِشِ حَاشِيٍ نَشَ لُ نَا سْنْن!</para>
  <para style="q" vid="PSA 104:35">ﭑ بَرَ عَلَتَلَ مَتْشْ ﭑ نِي بِرِن نَ.</para>
  <para style="q" vid="PSA 104:35">وٌ عَلَتَلَ تَنتُ!<verse eid="PSA 104:35"/></para>
  <chapter eid="PSA 104"/>
  <chapter number="105" style="c" sid="PSA 105"/>
  <para style="s1">عِسِرَيِلَ شَ شْرّيَ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 105:1"/>وٌ عَلَتَلَ شِلِ مَتْشْ،</para>
  <para style="q" vid="PSA 105:1">وٌ عَ شَ كَابَنَكٌي مَسٍن حَمَيٍ تَفِ.<verse eid="PSA 105:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 105:2"/>وٌ بّيتِ بَ عَ بّ عَ شَ كَابَنَكٌييٍ شَ قٍ رَ.<verse eid="PSA 105:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 105:3"/>وٌ شَ سّيوَ عَ شِلِ سّنِيّنشِ شَ قٍ رَ،</para>
  <para style="q" vid="PSA 105:3">مِشِ نَشٍيٍ عَلَتَلَ قٍنمَ، عٍ شَ حّلّشِن.<verse eid="PSA 105:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 105:4"/>وٌ شَ عَلَتَلَ شَ سّنبّ قٍن،</para>
  <para style="q" vid="PSA 105:4">وٌ شَ كَتَ لُدٍ عَ يَ عِ تّمُي بِرِن.<verse eid="PSA 105:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 105:5"/>وٌ شَ رَتُ عَ شَ كَابَنَكٌي مَ،</para>
  <para style="q" vid="PSA 105:5">وٌ نَشَ نّيمُ عَ شَ كِيتِ مَ،<verse eid="PSA 105:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 105:6"/>وٌ تَن عَلَ شَ كٌنيِ عِبُرَهِمَ بْنسْي،</para>
  <para style="q" vid="PSA 105:6">وٌ تَن يَشُبَ شَ دِيٍ عَ نَشٍيٍ سُفَندِ.<verse eid="PSA 105:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 105:7"/>عَ تَن نَن وٌن مَرِفِ عَلَتَلَ رَ،</para>
  <para style="q" vid="PSA 105:7">عَ كِيتِ سَمَ دُنِحَ بِرِن مَ.<verse eid="PSA 105:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 105:8"/>عَلَتَلَ عَ رَتُمَ عَ شَ سَاتّ مَ تّمُي بِرِن،</para>
  <para style="q" vid="PSA 105:8">عَ مُ نّيمُمَ عَ شَ لَايِدِ مَ عَبَدَن،<verse eid="PSA 105:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 105:9"/>عَ نَشَن تٌنفٌشِ عِبُرَهِمَ نُن عِسِيَفَ بّ مَرَكَلِ رَ.<verse eid="PSA 105:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 105:10"/>عَ بَرَ نَ نَتّ تٌنفٌ يَشُبَ بّ،</para>
  <para style="q" vid="PSA 105:10">عَ بَرَ نَ سَاتّ شِرِ عِسِرَيِلَ رَ،<verse eid="PSA 105:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 105:11"/>عَ مَسٍنقٍ رَ، «ﭑ بَرَ كَنَان بْشِ قِ وٌ مَ كّ رَ.»<verse eid="PSA 105:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 105:12"/>بٍينُ عٍ شَ وُيَ مّننِ،<verse eid="PSA 105:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 105:13"/>عٍ نُ نَ لِنتَنقٍ تُن،<verse eid="PSA 105:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 105:14"/>عَلَ مُ تِن مِشِ يٌ شَ نْ عٍ رَ.</para>
  <para style="q" vid="PSA 105:14">عَ نَشَ عَ شْرْشْ حَمَنّ مَنفّيٍ بّ عَ قَلَقٍ رَ،<verse eid="PSA 105:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 105:15"/>«وٌ نَشَ ﭑ مَ حَمَ سُفَندِشِ تْورْ دٍ،</para>
  <para style="q" vid="PSA 105:15">وٌ نَشَ قٍ حَاشِ رَبَ ﭑ مَ نَمِحْنمّيٍ رَ.»<verse eid="PSA 105:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 105:16"/>بٍينُ عَلَ شَ كَامّ رَفٌرٌ دُنِحَ مَ،</para>
  <para style="q" vid="PSA 105:16">عَ بَلٌي بَ دُنِحَ يِ رَ،<verse eid="PSA 105:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 105:17"/>عَ نَشَ عَ شَ مِشِ ندٍ يُسُقُ رَ سِفَ عٍ يَرَ كٌنيِيَ كُي.<verse eid="PSA 105:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 105:18"/>عَ سَنيِيٍ نُن عَ كْنيِ نُ بَلَنشِ يْلْنشْنيِ رَ،<verse eid="PSA 105:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 105:19"/>هَن عَلَ شَ لَايِدِ نَشَ كَمَلِ،</para>
  <para style="q" vid="PSA 105:19">عَ نْندِ قِ عَ مَ تّمُي نَشّ.<verse eid="PSA 105:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 105:20"/>نَ تّمُي مَنفّ شُنفبٍ نَشَ يَامَرِ قِ عَ شَ مِنِ فٍيلِ كُي،</para>
  <para style="q" vid="PSA 105:20">عَ شَ قُلُن.<verse eid="PSA 105:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 105:21"/>مَنفّ نَشَ يُسُقُ قِندِ عَ شَ بَنشِ شُنيِ رَ،</para>
  <para style="q" vid="PSA 105:21">عَ عَ فبٍ سٍ بِرِن سَ عَ نْي بُن مَ،<verse eid="PSA 105:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 105:22"/>عَلَكٌ مَنفّ شَ مِشِيٍ شَ لُ عَ وَشْن كِ،</para>
  <para style="q" vid="PSA 105:22">بْشِ قٌرِيٍ شَ شَشِلِ سْتْ عَ سَابُي رَ.<verse eid="PSA 105:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="PSA 105:23"/>نَ دَنفِ شَنبِ، عِسِرَيِلَ حَمَ يَشُبَ بْنسْي نَشَ قَ مِسِرَ،</para>
  <para style="q" vid="PSA 105:23">عٍ سَبَتِ هَمِ شَ بْشِ مَ.<verse eid="PSA 105:23"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="24" style="v" sid="PSA 105:24"/>عَلَ نَشَ عَ شَ حَمَ وُيَ دَنفِقٍ عٍ يَشُييٍ رَ.<verse eid="PSA 105:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 105:25"/>عَ نَشَ مِسِرَكَيٍ بْحّ مَسَرَ،</para>
  <para style="q" vid="PSA 105:25">هَن عٍ قَ عَ شَ حَمَ شْن، عٍ نَتّ حَاشِ تٌنفٌ عٍ شَ قٍ رَ.<verse eid="PSA 105:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 105:26"/>نَ تّمُي عَ نَشَ عَ شَ كٌنيِ دِ مُنسَ شّي،</para>
  <para style="q" vid="PSA 105:26">عَ نُن عَ شَ مِشِ سُفَندِشِ هَرُنَ.<verse eid="PSA 105:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 105:27"/>عٍ نَشَ عَلَ شَ تْنشُمَيٍ مَكَابَشِيٍ رَبَ،</para>
  <para style="q" vid="PSA 105:27">هَمِ شَ بْشِ شَ مِشِيٍ تَفِ.<verse eid="PSA 105:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 105:28"/>عٍ تٌ عَلَ شَ مَسٍنيِ تِ مِسِرَكَيٍ بّ،</para>
  <para style="q" vid="PSA 105:28">عَلَ نَشَ دِ مِ رَ سِن بْشِ مَ، كُيٍ نَشَ عِقْورْ.<verse eid="PSA 105:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 105:29"/>عَ نَشَ مّننِ يٍ مَقِندِ وُلِ رَ، يّشّيٍ قَ قَشَ.<verse eid="PSA 105:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 105:30"/>عٍ شَ بْشِ نَشَ رَقٍ لَنشَنسَرِ مَيٍ رَ،</para>
  <para style="q" vid="PSA 105:30">عٍ سٌ هَن مَنفّ شَ بَنشِ كُي.<verse eid="PSA 105:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 105:31"/>عَ نَشَ يَامَرِ قِ شّيرِيٍ نُن سَاسِيٍ شَ دِن بْشِ بِرِن نَ.<verse eid="PSA 105:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 105:32"/>عَ نَشَ بَلَبَلَنيِ نُن تُنّ رَفٌرٌ بْشِ مَ،</para>
  <para style="q" vid="PSA 105:32">سٍيَمَكْنيِ نَشَ دِن مّننِ رَ.<verse eid="PSA 105:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 105:33"/>عَ نَشَ عٍ شَ وّنِ بِلِيٍ نُن عٍ شَ شْرّ بِلِيٍ كَنَ،</para>
  <para style="q" vid="PSA 105:33">عَ نُن وُرِ بِلِيٍ بِرِن نَشٍيٍ نُ نَ عٍ شَ بْشِ مَ.<verse eid="PSA 105:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 105:34"/>عَ نَشَ يَامَرِ قِ كَتٌي شَ وُيَ هَن،<verse eid="PSA 105:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 105:35"/>عٍ قَ سَنسِيٍ بِرِن كَنَ مِسِرَ بْشِ مَ،</para>
  <para style="q" vid="PSA 105:35">عٍ بْشِ دَشَمُي بِرِن دٌن.<verse eid="PSA 105:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 105:36"/>عَ رَحْنيِ عَ نَشَ دِ سِنفٍ بِرِن قَشَ عٍ شَ بْشِ كُي،</para>
  <para style="q" vid="PSA 105:36">عٍ نَشٍيٍ بَرِ عٍ سّنبّ رَ.<verse eid="PSA 105:36"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="37" style="v" sid="PSA 105:37"/>عَلَ نَشَ عَ شَ حَمَ رَ مِنِ كْبِرِ نُن شّيمَ رَ،</para>
  <para style="q" vid="PSA 105:37">مِشِ يٌ مُ قَشَ عٍ يَ مَ.<verse eid="PSA 105:37"/></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 105:38"/>مِسِرَكَيٍ نَشَ سّيوَ عٍ شَ مِنِ رَ،</para>
  <para style="q" vid="PSA 105:38">بَرِ مَ عٍ نُ بَرَ فَاشُ عِسِرَيِلَكَيٍ يَ رَ.<verse eid="PSA 105:38"/></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 105:39"/>عَلَ نَشَ نُشُي عِتَلَ عٍ شُن مَ يَنيِ رَ،</para>
  <para style="q" vid="PSA 105:39">عَ تّ تِ كٌورٍ مَ كْي رَ نَءِيَلَنيِ رَ.<verse eid="PSA 105:39"/></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 105:40"/>عٍ تٌ عَ مَشَندِ، عَ نَشَ قَ كْنكْلّيٍ رَ عٍ بّ،</para>
  <para style="q" vid="PSA 105:40">نَشَن قِندِشِ كٌورٍ بَلٌي رَ عٍ بّ.<verse eid="PSA 105:40"/></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 105:41"/>عَ نَشَ قَنيٍ رَبِ، عَ يٍ رَ مِنِ عٍ بّ،</para>
  <para style="q" vid="PSA 105:41">عَلْ شُرٍ نَشَن حّرّ مَ فبٍنفبٍرٍن يِرٍ تَفِ.<verse eid="PSA 105:41"/></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 105:42"/>عَلَ تٌ رَتُ عَ شَ لَايِدِ سّنِيّنشِ مَ،</para>
  <para style="q" vid="PSA 105:42">عَ نَشَن تٌنفٌ عَ شَ كٌنيِ دِ عِبُرَهِمَ بّ،<verse eid="PSA 105:42"/></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 105:43"/>عَ نَشَ عَ شَ حَمَ رَ مِنِ سّيوّ كُي،</para>
  <para style="q" vid="PSA 105:43">عَ عَ رَفِرِ عَ شَ مِشِ سُفَندِشِيٍ شَ حّلّشِن بّيتِ بَ.<verse eid="PSA 105:43"/></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 105:44"/>عَ نَشَ سِ فبّتّيٍ شَ بْشِ قِ عٍ مَ،</para>
  <para style="q" vid="PSA 105:44">حَمَنّيٍ شَ نَاقُلِ نَشَ قِندِ عٍ فبٍ رَ،<verse eid="PSA 105:44"/></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 105:45"/>عَلَكٌ عٍ شَ عَلَ شُي سُشُ،</para>
  <para style="q" vid="PSA 105:45">عٍ شَ عَ شَ يَامَرِيٍ رَبَتُ.</para>
  <para style="b" vid="PSA 105:45"/>
  <para style="q" vid="PSA 105:45">وٌ شَ عَلَتَلَ مَتْشْ!<verse eid="PSA 105:45"/></para>
  <chapter eid="PSA 105"/>
  <chapter number="106" style="c" sid="PSA 106"/>
  <para style="s1">نّيمُقٍ عَلَ شَ شَنُنتٍيَ مَ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 106:1"/>وٌ شَ عَلَتَلَ مَتْشْ.</para>
  <para style="b" vid="PSA 106:1"/>
  <para style="q" vid="PSA 106:1">وٌ شَ عَ تَنتُ بَرِ مَ عَ قَن،</para>
  <para style="q" vid="PSA 106:1">عَ شَ شَنُنتٍيَ بُمَ عَبَدَن.<verse eid="PSA 106:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 106:2"/>ندٍ عَلَتَلَ شَ وَلِ شُنفبٍ مَسٍنمَ،</para>
  <para style="q" vid="PSA 106:2">ندٍ عَ شَ مَتْشْي بَمَ؟<verse eid="PSA 106:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 106:3"/>سّيوّ نَ تِنشِنتْييٍ بّ،</para>
  <para style="q" vid="PSA 106:3">نَشٍيٍ بِرَ مَ تِنشِنيِ قْشْ رَ لْشْي بِرِن.<verse eid="PSA 106:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 106:4"/>عَلَتَلَ، عِ شَ رَتُ ﭑ مَ عِ هِننّمَ عِ شَ حَمَ رَ تّمُي نَشّ،</para>
  <para style="q" vid="PSA 106:4">عِ نَ عٍ رَكِسِ، عِ شَ ﭑ قَن مَلِ،<verse eid="PSA 106:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 106:5"/>عَلَكٌ ﭑ شَ عِ شَ مِشِ سُفَندِشِيٍ شَ هّرِ سْتْ،</para>
  <para style="q" vid="PSA 106:5">ﭑ شَ سّيوَ عِ شَ حَمَ رَ،</para>
  <para style="q" vid="PSA 106:5">ﭑ شَ حّلّشِن عِ كّ تٌنفٌمَيٍ يَ مَ.<verse eid="PSA 106:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 106:6"/>مُشُ بَرَ يُنُبِ رَبَ عَلْ مُشُ بٍنبَيٍ،</para>
  <para style="q" vid="PSA 106:6">مُشُ بَرَ قٍ كٌبِيٍ رَبَ حَاشُحَ كُي.<verse eid="PSA 106:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 106:7"/>مُشُ بٍنبَيٍ تٌ نُ نَ مِسِرَ بْشِ مَ،</para>
  <para style="q" vid="PSA 106:7">عٍ مُ عٍ حْشْ سَ عِ شَ كَابَنَكٌي شْن مَ،</para>
  <para style="q" vid="PSA 106:7">عٍ مُ رَتُ عِ شَ شَنُنتٍيَ مَ.</para>
  <para style="q" vid="PSA 106:7">عٍ نَشَ عٍ كٌبٍ رَ سٌ عِ رَ شُلُنيُمِ بَا قّ مَ.<verse eid="PSA 106:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 106:8"/>كْنْ عَ نَشَ عٍ رَكِسِ عَ شِلِ شَ قٍ رَ،</para>
  <para style="q" vid="PSA 106:8">عَلَكٌ عَ شَ عَ سّنبّ مَسٍن.<verse eid="PSA 106:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 106:9"/>عَ تٌ شَاحّ شُلُنيُمِ بَا مَ، عَ نَشَ شْرِ،</para>
  <para style="q" vid="PSA 106:9">عٍ نَشَ عَ عِفِرِ عَ شَرَشِ رَ.<verse eid="PSA 106:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 106:10"/>عَ نَشَ عٍ رَكِسِ عٍ شْنمِشِيٍ بّلّشّ عِ،</para>
  <para style="q" vid="PSA 106:10">عَ عٍ شُنسَرَ عٍ يَشُييٍ بّلّشّ.<verse eid="PSA 106:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 106:11"/>يٍ نَشَ دُ سُ عٍ يَشُييٍ شُن نَ،</para>
  <para style="q" vid="PSA 106:11">هَلِ مِشِ كٍرٍن عَ مُ كِسِ.<verse eid="PSA 106:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 106:12"/>نَ كُي عٍ نَشَ لَ عَ شَ مَسٍنيِ رَ،</para>
  <para style="q" vid="PSA 106:12">عٍ عَ مَتْشْ بّيتِ رَ.<verse eid="PSA 106:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 106:13"/>كْنْ عَ مُ بُ، عٍ مَن نَشَ نّيمُ عَ شَ وَلِيٍ مَ،</para>
  <para style="q" vid="PSA 106:13">عٍ تٌندِ عَ وَشْنقٍ رَبَدٍ.<verse eid="PSA 106:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 106:14"/>عٍ نَشَ بِرَ عٍ يّتّ وَشْنقٍ قْشْ رَ فبٍنفبٍرٍنيِ مَ،</para>
  <para style="q" vid="PSA 106:14">عٍ عَلَتَلَ مَتٌ.<verse eid="PSA 106:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 106:15"/>عَ نَشَ عٍ وَشْنسٍ سٌ عٍ يِ رَ،</para>
  <para style="q" vid="PSA 106:15">كْنْ نَ دَنفِ شَنبِ، عَ نَشَ عٍ رَحْن.<verse eid="PSA 106:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 106:16"/>عَلَ شَ حَمَ نَشَ مُنسَ نُن هَرُنَ تْونّ،</para>
  <para style="q" vid="PSA 106:16">نَشٍيٍ قِندِشِ عَلَتَلَ شَ كٌنيِ سّنِيّنشِيٍ رَ.<verse eid="PSA 106:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 106:17"/>بْشِ نَشَ عَ رَبِ،</para>
  <para style="q" vid="PSA 106:17">عَ دَتَن نُن عَبِرَ مِ شَ مِشِيٍ رَفٌرٌ عَ كُي.<verse eid="PSA 106:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 106:18"/>تّ نَشَ عٍ قْشِرَبِرّ حَاشِيٍ فَن.<verse eid="PSA 106:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 106:19"/>عٍ نَشَ نِنفٍ مِسَالِ يَءِلَن وُرٍ رَ،</para>
  <para style="q" vid="PSA 106:19">عٍ عَ بَتُ كُيٍ رَ.<verse eid="PSA 106:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 106:20"/>نِنفٍ نَشَن سّشّ دٌنمَ،</para>
  <para style="q" vid="PSA 106:20">عٍ نَشَ نَ مِسَالِ قِندِ عٍ مَرِفِ عَلَتَلَ حْشْي رَ.<verse eid="PSA 106:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 106:21"/>عٍ نَشَ نّيمُ عٍ رَكِسِمَ عَلَ مَ،</para>
  <para style="q" vid="PSA 106:21">نَشَن قٍ شُنفبٍيٍ رَبَ مِسِرَ،<verse eid="PSA 106:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 106:22"/>نَشَن كَابَنَكٌييٍ رَبَ هَمِ بْشِ مَ،</para>
  <para style="q" vid="PSA 106:22">نَشَن قٍ مَفَاشُشِيٍ رَبَ شُلُنيُمِ بَا مَ.<verse eid="PSA 106:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 106:23"/>عَلَ نُ وَ مَ عٍ سْنتْقٍ،</para>
  <para style="q" vid="PSA 106:23">كْنْ عَ شَ مِشِ سُفَندِشِ مُنسَ نَشَ عَ مَشَندِ،</para>
  <para style="q" vid="PSA 106:23">عَ شَ عَ شَ شْنّ شْرْشْي لُ نَ.<verse eid="PSA 106:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 106:24"/>عٍ نَشَ تٌندِ عَ شَ بْشِ قَنيِ سُشُدٍ،</para>
  <para style="q" vid="PSA 106:24">عٍ مُ لَ عَ شَ لَايِدِ رَ.<verse eid="PSA 106:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 106:25"/>عٍ نَشَ تِ عَلَتَلَ كَنكٍ عٍ شَ كِرِ بَنشِيٍ كُي،</para>
  <para style="q" vid="PSA 106:25">عٍ مُ عَ شُي سُشُ.<verse eid="PSA 106:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 106:26"/>نَ كُي عَ نَشَ لَايِدِ تٌنفٌ عٍ بّ،</para>
  <para style="q" vid="PSA 106:26">عَ شَ عٍ قَشَ فبٍنفبٍرٍنيِ مَ،<verse eid="PSA 106:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 106:27"/>عَ شَ عٍ بْنسْي قَشَ حَمَنّيٍ تَفِ،</para>
  <para style="q" vid="PSA 106:27">عَ شَ عٍ رَيٍنسٍن دُنِحَ مَ.<verse eid="PSA 106:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 106:28"/>عٍ نَشَ بَلِ ثٍيٌرِ بَتُ،</para>
  <para style="q" vid="PSA 106:28">عٍ سّرّشّ سُبٍ دٌن نَشَن بَشِ مِشِ قَشَشِيٍ بّ.<verse eid="PSA 106:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 106:29"/>عٍ نَشَ عَلَ رَشْنْ عٍ شَ قٍ كٌبِيٍ رَ،</para>
  <para style="q" vid="PSA 106:29">هَن عَ نَشَ قُرٍ حَاشِ ندٍ رَفٌرٌ عٍ مَ.<verse eid="PSA 106:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 106:30"/>قِنٍشَسِ تٌ كٍلِ، عَ نَشَ عَلَ مَشَندِ عٍ بّ،</para>
  <para style="q" vid="PSA 106:30">قُرٍ حَاشِ نَشَ بَ عٍ رَ.<verse eid="PSA 106:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 106:31"/>مِشِ نَشَ نَ تِنشِنيِ كٌلٌن عَ بّ عَبَدَن.<verse eid="PSA 106:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 106:32"/>عَلَتَلَ شَ حَمَ نَشَ عَ رَشْنْ مٍرِبَ شُرٍ قّ مَ.</para>
  <para style="q" vid="PSA 106:32">عَننَبِ مُنسَ نَشَ تْورْ عٍ شَ قٍ رَ،<verse eid="PSA 106:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 106:33"/>عَ تٌ وْيّن شْرْشْي قَلَ عٍ شَ عَلَ مَتَندِ شَ قٍ رَ.<verse eid="PSA 106:33"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="34" style="v" sid="PSA 106:34"/>عٍ مُ كَنَان سِيٍ سْنتْ عَلْ عَلَتَلَ عٍ يَمَرِ كِ نَشّ.<verse eid="PSA 106:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 106:35"/>عٍ نَشَ سَبَتِ عٍ يَ مَ، عٍ بِرَ عٍ نَامُنيِيٍ قْشْ رَ.<verse eid="PSA 106:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 106:36"/>عٍ نَشَ نٍيٍ شَ كُيٍيٍ بَتُ، نَ قَ قِندِ فَنتَنيِ رَ عٍ بّ.<verse eid="PSA 106:36"/></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 106:37"/>عٍ نَشَ عٍ شَ دِ شّمّيٍ نُن عٍ شَ دِ فِنّ بَ سّرّشّ رَ حِننّيٍ بّ.<verse eid="PSA 106:37"/></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 106:38"/>عٍ تٌ عٍ شَ دِيٍ قَشَ سّرّشّ رَ كَنَان شَ كُيٍيٍ بّ،</para>
  <para style="q" vid="PSA 106:38">عٍ نَشَ بْشِ قِندِ بْشِ سّنِيّنتَرٍ رَ.<verse eid="PSA 106:38"/></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 106:39"/>عٍ عٍ يّتّ قِندِ مِشِ سّنِيّنتَرٍ رَ نَ كِ نّ،</para>
  <para style="q" vid="PSA 106:39">عٍ عٍ مَرِفِ يَنقَ.<verse eid="PSA 106:39"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="40" style="v" sid="PSA 106:40"/>نَ كُي عَلَتَلَ نَشَ شْنْ عَ شَ حَمَ مَ،</para>
  <para style="q" vid="PSA 106:40">عَ كّ تٌنفٌمَيٍ مُ رَقَنشِ عَ مَ سْنْن.<verse eid="PSA 106:40"/></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 106:41"/>عَ نَشَ عٍ رَبٌلٌ سِ فبّتّيٍ يِ رَ،</para>
  <para style="q" vid="PSA 106:41">عٍ يَشُييٍ نَشَ عٍ يَمَرِ.<verse eid="PSA 106:41"/></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 106:42"/>عٍ يَشُييٍ نَشَ نْ عٍ رَ،</para>
  <para style="q" vid="PSA 106:42">عٍ قَ لُ عٍ سّنبّ بُن مَ.<verse eid="PSA 106:42"/></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 106:43"/>سَنيَ وُيَشِ عَلَ نَشَ عٍ رَكِسِ،</para>
  <para style="q" vid="PSA 106:43">كْنْ عٍ مُ فبِلٍن عَ مَتَندِقٍ رَ.</para>
  <para style="q" vid="PSA 106:43">نَ كُي عٍ نَشَ لْي عٍ شَ يُنُبِيٍ شَ قٍ رَ.<verse eid="PSA 106:43"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="44" style="v" sid="PSA 106:44"/>كْنْ عَلَ نَشَ عٍ تْورّ تٌ،</para>
  <para style="q" vid="PSA 106:44">عَ نَشَ عٍ وَ شُي مّ.<verse eid="PSA 106:44"/></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 106:45"/>عَ نَشَ رَتُ عَ شَ سَاتّ مَ،</para>
  <para style="q" vid="PSA 106:45">عَ كِنِكِنِ عٍ مَ عَ شَ شَنُنتٍيَ تِلِنشِ شَ قٍ رَ.<verse eid="PSA 106:45"/></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 106:46"/>عَ نَشَ عَ نِيَ مِشِيٍ شَ كِنِكِنِ عٍ مَ كٌنيِيَ كُي.<verse eid="PSA 106:46"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="47" style="v" sid="PSA 106:47"/>مُشُ مَرِفِ عَلَتَلَ، مُشُ رَكِسِ.</para>
  <para style="q" vid="PSA 106:47">عِ شَ مُشُ رَ مِنِ سِيٍ تَفِ،</para>
  <para style="q" vid="PSA 106:47">عَلَكٌ مُشُ شَ عِ شِلِ سّنِيّنشِ تَنتُ،</para>
  <para style="q" vid="PSA 106:47">مُشُ شَ سّيوَ عِ مَتْشْقٍ رَ.<verse eid="PSA 106:47"/></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 106:48"/>تَنتُي نَ عِسِرَيِلَ مَرِفِ عَلَتَلَ بّ عَبَدَن!</para>
  <para style="q" vid="PSA 106:48">حَمَ بِرِن شَ عَ قَلَ؛ «عَمِنَ!»</para>
  <para style="q" vid="PSA 106:48">وٌ شَ عَلَ مَتْشْ!<verse eid="PSA 106:48"/></para>
  <chapter eid="PSA 106"/>
  <chapter number="107" style="c" sid="PSA 107"/>
  <para style="s1">تَنتُي سّرّشّ كِسِ شَ قٍ رَ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 107:1"/>وٌ عَلَتَلَ تَنتُ، بَرِ مَ عَ قَن،</para>
  <para style="q" vid="PSA 107:1">عَ شَ شَنُنتٍيَ بُمَ عَبَدَن!<verse eid="PSA 107:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 107:2"/>عَلَتَلَ نَشَن شُن سَرَ،</para>
  <para style="q" vid="PSA 107:2">عَ نَشٍيٍ بَشِ عٍ يَشُييٍ يِ رَ،<verse eid="PSA 107:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 107:3"/>عَ نَشٍيٍ رَ مِنِشِ سِيٍ تَفِ سٌفٍتٍدٍ نُن سٌفٍفٌرٌدٍ مَبِرِ،</para>
  <para style="q" vid="PSA 107:3">عَ نَشٍيٍ قَشِ كٍلِقٍ كْولَ نُن بَا مَبِرِ،</para>
  <para style="q" vid="PSA 107:3">عٍ بِرِن شَ عَلَتَلَ تَنتُ.<verse eid="PSA 107:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 107:4"/>ندٍيٍ لْيشِ فبٍنفبٍرٍنيِ مَ،</para>
  <para style="q" vid="PSA 107:4">عٍ مُ سَبَتِدٍ يٌ تٌشِ.<verse eid="PSA 107:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 107:5"/>كَامّ نُن يٍ شْلِ نُ عٍ هَلَكِمَ،</para>
  <para style="q" vid="PSA 107:5">لِمَنِيَ نَشَ بَ عٍ يِ.<verse eid="PSA 107:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 107:6"/>عٍ تٌ عٍ دّ رَوَ عَلَتَلَ بّ عٍ شَ تْورّ كُي،</para>
  <para style="q" vid="PSA 107:6">عَ نَشَ عٍ قُلُن عٍ شَ حَشَنكَتّ مَ.<verse eid="PSA 107:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 107:7"/>عَ نَشَ عٍ رَحّرّ كِرَ تِنشِنشِ ندٍ شْن مَ،</para>
  <para style="q" vid="PSA 107:7">عَلَكٌ عٍ شَ يِرٍ قَنيِ تٌ عٍ سَبَتِمَ دّننَشّ.<verse eid="PSA 107:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 107:8"/>عٍ شَ عَلَتَلَ تَنتُ عَ شَ شَنُنتٍيَ شَ قٍ رَ،</para>
  <para style="q" vid="PSA 107:8">نُن عَ شَ كَابَنَكٌييٍ شَ قٍ رَ عَ نَشَن نَبَشِ عَدَ مَدِيٍ بّ،<verse eid="PSA 107:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 107:9"/>بَرِ مَ عَ يٍ شْلِ بَمَ مِشِيٍ مَ،</para>
  <para style="q" vid="PSA 107:9">عَ كَامّتْييٍ رَوَ سَمَ دٌنسٍ قَنيِيٍ رَ.<verse eid="PSA 107:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 107:10"/>ندٍيٍ نُ سَبَتِشِ دِ مِ كُي نُن قَشّ شَ نْي بُن مَ،</para>
  <para style="q" vid="PSA 107:10">فٍيلِ شْرْشْي كُي، يْلْنشْنيِ مَبَلَنشِ عٍ مَ.<verse eid="PSA 107:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 107:11"/>بَرِ مَ عٍ مُرُتَ نّ عَلَ شَ مَسٍنيِ شِلِ مَ،</para>
  <para style="q" vid="PSA 107:11">عٍ عَلَ شَ مَرَ سِ شْن.<verse eid="PSA 107:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 107:12"/>عَ نَشَ عٍ بْحّ مَقِيشّ تْورّ رَ.</para>
  <para style="q" vid="PSA 107:12">عٍ نَشَ دَفَلَن يّ، مِشِ يٌ مُ عٍ مَلِ.<verse eid="PSA 107:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 107:13"/>عٍ نَشَ مَرِفِ مَشَندِ نِمِسّ كُي،</para>
  <para style="q" vid="PSA 107:13">عَ نَشَ عٍ رَكِسِ عٍ شَ حَشَنكَتّ مَ.<verse eid="PSA 107:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 107:14"/>عَ نَشَ عٍ رَ مِنِ دِ مِ كُي نُن قَشّ شَ نْي بُنمَ،</para>
  <para style="q" vid="PSA 107:14">عَ نَشَ لُوتِيٍ بٌلٌن عٍ نُ شِرِشِ نَشٍيٍ رَ.<verse eid="PSA 107:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 107:15"/>عٍ شَ مَرِفِ بَتُ عَ شَ دُفُتّفّحَ شَ قٍ رَ،</para>
  <para style="q" vid="PSA 107:15">نُن عَ شَ وَلِ مَكَابَشِيٍ شَ قٍ رَ عَدَ مَدِيٍ بّ.<verse eid="PSA 107:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 107:16"/>بَرِ مَ عَ بَرَ وُرٍ نَادّيٍ وُرُ،</para>
  <para style="q" vid="PSA 107:16">عَ كٌندٌنيِيٍ كَنَ.<verse eid="PSA 107:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 107:17"/>شَشِلِتَرٍيٍ نُ بَرَ عٍ يّتّ سُشُ عٍ شَ مُرُتّ نُن عٍ شَ قٍ حَاشِيٍ رَ، عٍ لُ نِمِسّ كُي.<verse eid="PSA 107:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 107:18"/>دٌنسٍ بِرِن بَرَ نُ رَحَاشُ عٍ مَ،</para>
  <para style="q" vid="PSA 107:18">عٍ نُ قَ نَ قَشّ نَن دّءِ.<verse eid="PSA 107:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 107:19"/>عٍ شَ نَ شْرْرْي كُي، عٍ نَشَ عٍ شُي رَتٍ عَلَتَلَ مَ،</para>
  <para style="q" vid="PSA 107:19">عَ نَشَ عٍ رَكِسِ عٍ شَ شْرْرْي مَ.<verse eid="PSA 107:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 107:20"/>عَ نَشَ عَ شَ مَسٍنيِ رَ سَنبَ عٍ مَ، عَ عٍ رَيَلَن،</para>
  <para style="q" vid="PSA 107:20">عَ عٍ بَ عٍ شَ حَشَنكَتّ كُي.<verse eid="PSA 107:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 107:21"/>عٍ شَ مَرِفِ تَنتُ عَ شَ دُفُتّفّحَ نُن عَ شَ وَلِ مَكَابَشِيٍ شَ قٍ رَ عَدَ مَدِيٍ بّ.<verse eid="PSA 107:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 107:22"/>عٍ شَ سّرّشّيٍ بَ عَ شَ وَلِ قَنيِيٍ كٌلٌن قٍ رَ عَ بّ.</para>
  <para style="q" vid="PSA 107:22">عٍ مَن شَ عَ شَ وَلِ قَنيِيٍ عِقَلَ عٍ شُي عِتٍشِ رَ سّيوّ كُي!<verse eid="PSA 107:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 107:23"/>نَشٍيٍ نُ بِيَاسِمَ كُنكُي شُنفبٍيٍ كُي بَا مَ،</para>
  <para style="q" vid="PSA 107:23">عٍ مَن نُ يُلّيَ رَبَ يٍيٍ شُن مَ،<verse eid="PSA 107:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 107:24"/>نٍيٍ بَرَ مَرِفِ وَلِ قْشِيٍ</para>
  <para style="q" vid="PSA 107:24">نُن عَ شَ وَلِ مَكَابَشِيٍ تٌ بَا مَ.<verse eid="PSA 107:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 107:25"/>عَ نَشَ مَسٍنيِ تِ، تُرُننَادّ قٌيٍ نَشَ كٍلِ</para>
  <para style="q" vid="PSA 107:25">عَ مْرْنيِيٍ رَ مَشَ،<verse eid="PSA 107:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 107:26"/>عَ نُ بِيَاسِلَيٍ شَ كُنكُي عِتٍ عَ نُ عَ سِن،</para>
  <para style="q" vid="PSA 107:26">عٍ نُ نَ حَشَنكَتّ كُي.<verse eid="PSA 107:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 107:27"/>عٍ شُن نَشَ مَفِ عَ رَ عٍ نَشَ لُ عَلْ سِيسِلَيٍ.</para>
  <para style="q" vid="PSA 107:27">عٍ شَ شَشِلِمَيَ بِرِن نَشَ لُ عٍ مَ قُ.<verse eid="PSA 107:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 107:28"/>عٍ شَ نِمِسّ كُي عٍ نَشَ مَرِفِ شِلِ عٍ شُي عِتٍشِ رَ،</para>
  <para style="q" vid="PSA 107:28">عَ نَشَ عٍ رَتَنفَ نَ فبَلٌي مَ.<verse eid="PSA 107:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 107:29"/>عَ نَشَ تُرُننَادّ قٌيٍ عِتِ، عَ عَ مَسَبَرِ،</para>
  <para style="q" vid="PSA 107:29">مْرْنيِيٍ نَشَ عٍ رَشَرَ.<verse eid="PSA 107:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 107:30"/>عٍ نَشَ سّيوَ نٍيٍ شَ مَرَشَرّ رَ،</para>
  <para style="q" vid="PSA 107:30">عَ نَشَ عٍ شُنتِ عٍ وَشْندٍ رَ.<verse eid="PSA 107:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 107:31"/>عٍ شَ مَرِفِ تَنتُ عَ شَ دُفُتّفّحَ نُن عَ وَلِ مَكَابَشِيٍ شَ قٍ رَ عَدَ مَدِيٍ بّ!<verse eid="PSA 107:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 107:32"/>عٍ شَ عَ شَ قٍ فبٌ حَمَ بّ،</para>
  <para style="q" vid="PSA 107:32">عٍ شَ عَ مَتْشْ قٌرِيٍ شَ مَلَنيِ!<verse eid="PSA 107:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 107:33"/>عَ شُرٍ شُنفبٍيٍ مَسَرَ مَ فبٍنفبٍرٍنيِ رَ،</para>
  <para style="q" vid="PSA 107:33">عَ دُلٌنيِ قِندِ بْشِ مَشَرٍ رَ.<verse eid="PSA 107:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 107:34"/>عَ بْشِ قَنيِ قِندِ مَ قْشْي يِرٍ رَ،</para>
  <para style="q" vid="PSA 107:34">نَ بْشِكَيٍ شَ قٍ حَاشِ شَ قٍ رَ.<verse eid="PSA 107:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 107:35"/>عَ فبٍنفبٍرٍنيِ قِندِ مَ شُرٍ رَ</para>
  <para style="q" vid="PSA 107:35">عَ يِرٍ مَشَرٍ قِندِ شُرٍ فُلِ رَ،<verse eid="PSA 107:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 107:36"/>عَ كَامّتْييٍ رَ سَبَتِ نَا،</para>
  <para style="q" vid="PSA 107:36">عٍ تَا تِ نَا عٍ سَبَتِدٍ.<verse eid="PSA 107:36"/></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 107:37"/>عٍ شّ سَمَ، عٍ وُرِ بِلِيٍ سِمَ</para>
  <para style="q" vid="PSA 107:37">نَشٍيٍ بٌفِ بَرَكَمَ.<verse eid="PSA 107:37"/></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 107:38"/>عَ دُبَمَ عٍ بّ، عٍ وُيَ،</para>
  <para style="q" vid="PSA 107:38">عَ مُ سٍسٍ بَمَ عٍ شَ شُرُ سٍ كْنتِ رَ.<verse eid="PSA 107:38"/></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 107:39"/>ندٍيٍ فبٍيٍ شُرُنمَ،</para>
  <para style="q" vid="PSA 107:39">تْورّ نُن حَشَنكَتّ رَ.<verse eid="PSA 107:39"/></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 107:40"/>عَ مَرَحَاشُي دُ سُمَ قٌرِيٍ شُن نَ،</para>
  <para style="q" vid="PSA 107:40">عَ عٍ رَلْي فبٍنفبٍرٍنيِ مَ كِرَيٍ مُ دّننَشّ مَ،<verse eid="PSA 107:40"/></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 107:41"/>عَ مِسِكِينّيٍ بَمَ تْورّ كُي،</para>
  <para style="q" vid="PSA 107:41">عَ عٍ شَ دٍنبَيَيٍ رَوُيَ عَلْ شُرُ سٍيٍ.<verse eid="PSA 107:41"/></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 107:42"/>مِشِ تِنشِنشِيٍ نَ تٌمَ عٍ حّلّشِنمَ عَ رَ،</para>
  <para style="q" vid="PSA 107:42">كْنْ تِنشِنتَرٍيٍ بِرِن دّ بَلَنمَ نّ.<verse eid="PSA 107:42"/></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 107:43"/>شَشِلِمَ نَشَن نَ، عَ شَ عَ حْشْ سَ يِ قٍ بِرِن شْنمَ،</para>
  <para style="q" vid="PSA 107:43">عَ شَ مَرِفِ شَ دُفُتّفّحَ قَهَامُ.<verse eid="PSA 107:43"/></para>
  <chapter eid="PSA 107"/>
  <chapter number="108" style="c" sid="PSA 108"/>
  <para style="s1">شُننَكٍلِ عَلَ سَابُي رَ</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 108:1"/>دَوُدَ شَ بّيتِ<verse eid="PSA 108:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 108:2"/>عَلَ، ﭑ بَرَ نَتّ تٌنفٌ ﭑ بْحّ كُي.</para>
  <para style="q" vid="PSA 108:2">ﭑ مَرِفِ شُننَكٍلِ كَنيِ، ﭑ ﭑ شُي رَ مِنِمَ نّ بّيتِيٍ رَ.<verse eid="PSA 108:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 108:3"/>ﭑ ﭑ مَ كْرَيٍ نُن ﭑ مَ مَشَسٍيٍ بٍرٍ مَ نّ سُبَشّ مَ.<verse eid="PSA 108:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 108:4"/>ﭑ مَرِفِ، ﭑ عِ بَتُمَ نّ سِيٍ تَفِ،</para>
  <para style="q" vid="PSA 108:4">ﭑ عِ مَتْشْمَ نّ بّيتِ رَ حَمَنّيٍ يَ مَ،<verse eid="PSA 108:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 108:5"/>بَرِ مَ عِ شَ دُفُتّفّحَ فبٌ دَنفِ كٌورٍ رَ،</para>
  <para style="q" vid="PSA 108:5">عِ شَ شَنُنتٍيَ عِتٍ عَلْ نُشُييٍ.<verse eid="PSA 108:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 108:6"/>عَلَ، عِ شُنيِ رَكٍلِ كٌورٍ مَ،</para>
  <para style="q" vid="PSA 108:6">عِ شَ نْرّ شَ لُ بْشِ بِرِن شُن مَ،<verse eid="PSA 108:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 108:7"/>عَلَكٌ عِ شَنُنتٍنيِيٍ شَ كِسِ عِ سّنبّ سَابُي رَ.</para>
  <para style="q" vid="PSA 108:7">يَندِ، ﭑ مَ دُبَ سُشُ.<verse eid="PSA 108:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 108:8"/>عَلَ بَرَ وْيّن عَ شَ لِنفِرَ سّنِيّنشِ كُي،</para>
  <para style="q" vid="PSA 108:8">«ﭑ ﭑ شُن نَكٍلِمَ نّ،</para>
  <para style="q" vid="PSA 108:8">ﭑ سِكٍمِ بْشِ عِتَشُن،</para>
  <para style="q" vid="PSA 108:8">ﭑ سُكْتِ فُلُنبَ سْتْمَ نّ.<verse eid="PSA 108:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 108:9"/>ﭑ فبٍ نَن فَلَدِ رَ، ﭑ فبٍ نَن مَنَسِ رَ.</para>
  <para style="q" vid="PSA 108:9">عٍقِرَ مِ بْشِ تَن لُمَ نّ عَلْ ﭑ شُن مَكَنتَسٍ،</para>
  <para style="q" vid="PSA 108:9">يُدَيَ قِندِ ﭑ مَ مُنيَاتِ رَ.<verse eid="PSA 108:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 108:10"/>ﭑ ﭑ سَنيِ مَشَمَ مٌوَبَ بْشِ مَ،</para>
  <para style="q" vid="PSA 108:10">ﭑ ﭑ مَ سَنكِرِ وٌلِمَ عٍدٌن نَن مَ عَ شَ قِندِ ﭑ فبٍ رَ.</para>
  <para style="q" vid="PSA 108:10">ﭑ فٍرٍ تِ شُي مّمَ نّ قِلِسِتَ بْشِ مَ.»<verse eid="PSA 108:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 108:11"/>«ندٍ ﭑ شُن تِمَ تَا مَكَنتَشِ رَ؟</para>
  <para style="q" vid="PSA 108:11">ندٍ ﭑ شَنِنمَ عٍدٌن بْشِ مَ؟<verse eid="PSA 108:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 108:12"/>عَلَ مُ عَ رَ، نَشَن مُشُ رَبّحِنشِ فٍرٍ كُي؟<verse eid="PSA 108:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 108:13"/>عِ شَ قَ مُشُ مَلِدٍ، عِ شَ مُشُ بَ مُشُ يَشُييٍ يِ رَ.</para>
  <para style="q" vid="PSA 108:13">عَدَ مَدِيٍ شَ مَلِ قُقَقُ نَ عَ رَ.<verse eid="PSA 108:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 108:14"/>وٌن قَمَ وٌن سّنبّ رَ مِنِدٍ عَلَ شَ مَلِ سَابُي رَ.</para>
  <para style="q" vid="PSA 108:14">عَ تَن نَن قَمَ وٌن يَشُييٍ عِوُرُدٍ.»<verse eid="PSA 108:14"/></para>
  <chapter eid="PSA 108"/>
  <chapter number="109" style="c" sid="PSA 109"/>
  <para style="s1">تْوحّفّلَ شَ مَشَندِ</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 109:1"/>دَوُدَ شَ بّيتِ بّيتِبَيٍ شَ مَنفّ بّ</para>
  <para style="q" vid="PSA 109:1">ﭑ مَرِفِ عَلَ، ﭑ نَشَن مَتْشْمَ، عِ نَشَ لُ دُندُي كُي،<verse eid="PSA 109:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 109:2"/>بَرِ مَ مِشِ حَاشِيٍ نَ وُلٍ قَلَقٍ ﭑ شُن مَ.</para>
  <para style="q" vid="PSA 109:2">عٍ دّ مُ قَن، عٍ وُلٍ قَلَ تُن.<verse eid="PSA 109:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 109:3"/>عٍ نَ ﭑ نَبِلِنقٍ شْننَنتٍيَ وْيّنيِيٍ رَ،</para>
  <para style="q" vid="PSA 109:3">هَلِ ﭑ مُ قٍ حَاشِ يٌ رَبَشِ عٍ رَ.<verse eid="PSA 109:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 109:4"/>ﭑ نَ قٍ قَنيِ رَبَ عٍ بّ، عٍ ﭑ فٍرٍ.</para>
  <para style="q" vid="PSA 109:4">ﭑ عَ رَفبِلٍنمَ عِ تَن عَلَ نَن مَ.<verse eid="PSA 109:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 109:5"/>عٍ ﭑ مَ وَلِ قَنيِ سَرٍ رَفبِلٍنمَ ﭑ مَ عَ كٌبِ رَ،</para>
  <para style="q" vid="PSA 109:5">ﭑ مَ شَنُنتٍيَ، عٍ نَ مَسَرَ مَ ﭑ بّ شْننَنتٍيَ رَ.<verse eid="PSA 109:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 109:6"/>عِ شَ نَ تْوحّفّتْي تَشُ مِشِ كٌبِ ندٍ رَ،</para>
  <para style="q" vid="PSA 109:6">عَ دّقَنبٌورٍ شَ عَ يَنقَ.<verse eid="PSA 109:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 109:7"/>عَ نَ مَكِيتِ، كِيتِ شَ كَنَ عَ رَ.</para>
  <para style="q" vid="PSA 109:7">عِ نَشَ عَ شَ مَشَندِ سُشُ.<verse eid="PSA 109:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 109:8"/>عَ شَ سِمَيَ شَ دُنكٍ كْتِ.</para>
  <para style="q" vid="PSA 109:8">مِشِ فبّتّ شَ عَ شَ وَلِ تٌنفٌ.<verse eid="PSA 109:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 109:9"/>عَ شَ دِيٍ شَ قِندِ كِرِدِيٍ رَ،</para>
  <para style="q" vid="PSA 109:9">عَ شَ فِنّ شَ قِندِ كَاحّ رَ.<verse eid="PSA 109:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 109:10"/>عَ شَ دِيٍ شَ قِندِ حّرّتِيٍ رَ نَشٍيٍ كُلّ مَتِمَ تُن.</para>
  <para style="q" vid="PSA 109:10">عٍ شَ مَكُيَ عٍ بَرِدٍ رَ نَشَن بَرَ كَنَ.<verse eid="PSA 109:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 109:11"/>دٌنِقَ شَ عَ كّ بِرِن تٌنفٌ،</para>
  <para style="q" vid="PSA 109:11">عَ شَ فٍينِ بِرِن شَ قِندِ سِ فبّتّيٍ فبٍ رَ.<verse eid="PSA 109:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 109:12"/>مِشِ يٌ نَشَ كِنِكِنِ عَ مَ،</para>
  <para style="q" vid="PSA 109:12">مِشِ يٌ نَشَ هِننّ عَ شَ كِرِدِيٍ رَ.<verse eid="PSA 109:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 109:13"/>عَ بْنسْي شَ سْنتْ،</para>
  <para style="q" vid="PSA 109:13">عٍ شِلِيٍ شَ نّيمُ مِشِيٍ رَ.<verse eid="PSA 109:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 109:14"/>عَلَتَلَ شَ رَتُ عَ شَ قٍ كٌبِيٍ مَ،</para>
  <para style="q" vid="PSA 109:14">عَ نفَ شَ يُنُبِ نَشَ شَقَرِ.<verse eid="PSA 109:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 109:15"/>عَلَتَلَ شَ رَتُ نَ يُنُبِيٍ مَ تّمُي بِرِن،</para>
  <para style="q" vid="PSA 109:15">عَ شَ عٍ شَ قٍ رَنّيمُ دُنِحَ رَ،<verse eid="PSA 109:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 109:16"/>بَرِ مَ عٍ مُ دُفُتّفّحَ رَكَمَلِمَ،</para>
  <para style="q" vid="PSA 109:16">عٍ مِسِكِينّيٍ نُن قُشَرِلَيٍ تْورْ مَ،</para>
  <para style="q" vid="PSA 109:16">هَن عٍ قَشَ سُننُنيِ كُي.<verse eid="PSA 109:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 109:17"/>نَشَن مِشِ دَنكَمَ، نَ كَنيِ شَ دَنكّ سْتْ.</para>
  <para style="q" vid="PSA 109:17">نَشَن دُبَمَ مِشِيٍ بّ، عَ شَ بَرَكّ سْتْ.<verse eid="PSA 109:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 109:18"/>دَنكّ شَ رَفٌرٌ عَ مَ</para>
  <para style="q" vid="PSA 109:18">عَلْ عَ دٌنمَ رَفٌرٌ مَ عَ مَ كِ نَشّ.</para>
  <para style="q" vid="PSA 109:18">عَ شَ سٌ عَ قَتٍ عِ عَلْ يٍ،</para>
  <para style="q" vid="PSA 109:18">عَ شَ سٌ عَ شْرِيٍ عَلْ تُرٍ.<verse eid="PSA 109:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 109:19"/>عَ شَ لُ عَ مَ عَلْ عَ شَ سٌسٍ لُمَ عَ مَ كِ نَشّ،</para>
  <para style="q" vid="PSA 109:19">عَ شَ بِلِن عَ مَ عَلْ عَ بّلّتِ بِلِنمَ عَ تَفِ كِ نَشّ تّمُي بِرِن.<verse eid="PSA 109:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 109:20"/>عَلَتَلَ شَ نَ سَرٍ قِ ﭑ مَ يَشُييٍ بّ،</para>
  <para style="q" vid="PSA 109:20">نَشٍيٍ قٍ كٌبِ قَلَمَ ﭑ شُن مَ.<verse eid="PSA 109:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="PSA 109:21"/>كْنْ عِ تَن ﭑ مَرِفِ عَلَتَلَ،</para>
  <para style="q" vid="PSA 109:21">عِ شَ هِننّ ﭑ نَ عِ شِلِ شَ قٍ رَ،</para>
  <para style="q" vid="PSA 109:21">عِ شَ ﭑ نَكِسِ عِ شَ دُفُتّفّحَ قَنيِ سَابُي رَ.<verse eid="PSA 109:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 109:22"/>ﭑ لُشِ نّ عَلْ مِسِكِينّ قُشَرِلَ،</para>
  <para style="q" vid="PSA 109:22">نَشَن بْحّ نَ تْورْقٍ كِ قَنيِ رَ.<verse eid="PSA 109:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 109:23"/>ﭑ مَ قٍ حْنقٍ عَلْ نِينِ نَشَن كُيَمَ نُنمَرٍ رَ.</para>
  <para style="q" vid="PSA 109:23">مِشِ ﭑ كٍرِ مَ عَلْ كَتٌي كٍرِ مَ كِ نَشّ.<verse eid="PSA 109:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 109:24"/>ﭑ شِنبِيٍ سّرّنمَ، ﭑ قَتٍ حْنمَ،</para>
  <para style="q" vid="PSA 109:24">سُنيِ شَ قٍ رَ.<verse eid="PSA 109:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 109:25"/>عٍ ﭑ نَيَافِمَ تّمُي بِرِن.</para>
  <para style="q" vid="PSA 109:25">عٍ نَ ﭑ تٌ، عٍ يٌمَ ﭑ مَ تُن.<verse eid="PSA 109:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 109:26"/>ﭑ مَرِفِ عَلَ، عِ شَ ﭑ مَلِ،</para>
  <para style="q" vid="PSA 109:26">عِ شَ ﭑ نَكِسِ عِ شَ دُفُتّفّحَ شَ قٍ رَ.<verse eid="PSA 109:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 109:27"/>عٍ شَ عَ كٌلٌن، عِ سّنبّ نَ ﭑ مَلِقٍ.<verse eid="PSA 109:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 109:28"/>عٍ تَن ﭑ دَنكَمَ،</para>
  <para style="q" vid="PSA 109:28">كْنْ عِ بَرَكّ نَن قِمَ ﭑ مَ.</para>
  <para style="q" vid="PSA 109:28">يَافِ قَمَ نّ دُ سُدٍ عٍ شُن نَ،</para>
  <para style="q" vid="PSA 109:28">كْنْ ﭑ تَن عِ شَ كٌنيِ دِ، ﭑ سّيوَ مَ نّ.<verse eid="PSA 109:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 109:29"/>ﭑ يَشُييٍ شَ عِقُ،</para>
  <para style="q" vid="PSA 109:29">عٍ شَ يَافِ شَ دُ سُ عٍ شُن نَ.<verse eid="PSA 109:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 109:30"/>ﭑ عَلَتَلَ تَنتُمَ نّ ﭑ شُي عِتٍشِ رَ،</para>
  <para style="q" vid="PSA 109:30">ﭑ عَ مَتْشْمَ نّ حَمَ يَ مَ،<verse eid="PSA 109:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 109:31"/>بَرِ مَ عَ تِشِ مِسِكِينّ سّيتِ مَ،</para>
  <para style="q" vid="PSA 109:31">عَ شَ عٍ رَتَنفَ مِشِيٍ مَ نَشٍيٍ وَ مَ عٍ قَشَقٍ.<verse eid="PSA 109:31"/></para>
  <chapter eid="PSA 109"/>
  <chapter number="110" style="c" sid="PSA 110"/>
  <para style="s1">عَلَتَلَ نَن مَنفّ شُنفبٍ دْشْمَ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="d">دَوُدَ شَ بّيتِ</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 110:1"/>عَلَتَلَ شَ مَسٍنيِ ﭑ مَرِفِ بّ؛</para>
  <para style="q" vid="PSA 110:1">«عِ مَفٌرٌ ﭑ يِقَنيِ مَ،</para>
  <para style="q" vid="PSA 110:1">هَن ﭑ شَ عِ سَنيِ تِ عِ يَشُييٍ قَرِ.»<verse eid="PSA 110:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PSA 110:2"/>عَلَتَلَ عِ سّنبّ رَفبٌمَ نّ كٍلِقٍ سِيٌنِ،</para>
  <para style="q" vid="PSA 110:2">هَن عِ عِ يَشُييٍ يَمَرِ.<verse eid="PSA 110:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 110:3"/>عِ شَ سْورِيٍ لُمَ نّ عِ قْشْ رَ فٍرٍ كُي.</para>
  <para style="q" vid="PSA 110:3">نَ كُيٍ نَ عِبَ سُبَشّ مَ،</para>
  <para style="q" vid="PSA 110:3">عِ سّنبّ فبٌمَ نّ سّنِيّنيِ كُي عَلْ عِ قٌنِكٍ وَشَتِ.<verse eid="PSA 110:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 110:4"/>عَلَتَلَ بَرَ عَ كَلِ يِ لَايِدِ رَ،</para>
  <para style="q" vid="PSA 110:4">نَشَن مُ كَنَمَ؛</para>
  <para style="q" vid="PSA 110:4">«ﭑ بَرَ عِ قِندِ سّرّشّدُبّ رَ عَبَدَن،</para>
  <para style="q" vid="PSA 110:4">عَ مٍلٍكِسٍدٍكِ دَاشِ.»<verse eid="PSA 110:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 110:5"/>مَرِفِ لُمَ عِ يِقَنيِ مَ،</para>
  <para style="q" vid="PSA 110:5">عَ مَنفّيٍ كَنَمَ نّ عَ شَ شْنّ لْشْي.<verse eid="PSA 110:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 110:6"/>عَ عَ شَ كِيتِ رَحّرّ مَ نّ حَمَنّيٍ قَرِ،</para>
  <para style="q" vid="PSA 110:6">عَ عٍ سْنتْ، عَ مَنفّ شُنفبٍ ندٍ شُن نَكَنَ.<verse eid="PSA 110:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 110:7"/>مَنفّ شُرٍ يٍ مِنمَ كِرَ عِ.</para>
  <para style="q" vid="PSA 110:7">عَ شُن نَكٍلِمَ نَ نَن مَ.<verse eid="PSA 110:7"/></para>
  <chapter eid="PSA 110"/>
  <chapter number="111" style="c" sid="PSA 111"/>
  <para style="s1">عَلَ مَتْشْمَ قٍ نَشٍيٍ مَ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 111:1"/>وٌ عَلَتَلَ مَتْشْ!</para>
  <para style="b" vid="PSA 111:1"/>
  <para style="q" vid="PSA 111:1">ﭑ عَلَتَلَ بَتُمَ نّ ﭑ بْحّ بِرِن نَ،</para>
  <para style="q" vid="PSA 111:1">تِنشِنتْييٍ نُن حَمَ يَ مَ.<verse eid="PSA 111:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 111:2"/>مَرِفِ شَ وَلِيٍ مَكَابَ.</para>
  <para style="q" vid="PSA 111:2">عٍ رَقَن مِشِيٍ مَ نَشٍيٍ تِنمَ عٍ مَتٌدٍ.<verse eid="PSA 111:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 111:3"/>عَ شَ وَلِيٍ نْرْشِ،</para>
  <para style="q" vid="PSA 111:3">عَ شَ تِنشِنيِ بُمَ نّ عَبَدَن.<verse eid="PSA 111:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 111:4"/>عَ عَ نِيَ بِرِن شَ رَتُ عَ شَ كَابَنَكٌي مَ.</para>
  <para style="q" vid="PSA 111:4">عَلَتَلَ هِننّمَ عَدَ مَدِيٍ رَ، عَ كِنِكِنِ عٍ مَ.<verse eid="PSA 111:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 111:5"/>عَ بَلٌي قِمَ مِشِ مَ نَشَن فَاشُمَ عَ يَ رَ،</para>
  <para style="q" vid="PSA 111:5">عَ رَتُ عَ شَ سَاتّ مَ عَبَدَن.<verse eid="PSA 111:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 111:6"/>عَ بَرَ عَ شَ وَلِ سّنبّ مَسٍن عَ شَ حَمَ بّ،</para>
  <para style="q" vid="PSA 111:6">حَمَنّ فبّتّيٍ كّ سٌقٍ رَ عٍ يِ.<verse eid="PSA 111:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 111:7"/>عَ وَلِمَ نْندِ نُن تِنشِنيِ نَن قَرِ.</para>
  <para style="q" vid="PSA 111:7">عَ شَ يَامَرِيٍ قِندِ مَ سّرِيّ قَنيِ نَن نَ،<verse eid="PSA 111:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 111:8"/>نَشٍيٍ مُ كَنَمَ عَبَدَن،</para>
  <para style="q" vid="PSA 111:8">عَدَ مَدِيٍ لَنمَ عٍ شَ نَشٍيٍ رَكَمَلِ.<verse eid="PSA 111:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 111:9"/>عَ بَرَ عَ شَ حَمَ شُن سَرَ،</para>
  <para style="q" vid="PSA 111:9">عَ بَرَ عَ شَ سَاتّ مَبَنبَن عَبَدَن.</para>
  <para style="q" vid="PSA 111:9">عَ شِلِ سّنِيّن، عَ مَفَاشُ.<verse eid="PSA 111:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 111:10"/>شَشِلِمَيَ قْلْمَ عَلَتَلَ يَرَفَاشُي نَن مَ.</para>
  <para style="q" vid="PSA 111:10">مِشِ نَشَن فَاشُمَ عَلَ يَ رَ،</para>
  <para style="q" vid="PSA 111:10">عَ شَشِلِ قَنيِ سْتْمَ نّ.</para>
  <para style="q" vid="PSA 111:10">عَدَ مَدِيٍ لَنمَ عٍ شَ عَ مَتْشْ عَبَدَن.<verse eid="PSA 111:10"/></para>
  <chapter eid="PSA 111"/>
  <chapter number="112" style="c" sid="PSA 112"/>
  <para style="s1">تِنشِنتْي سَرٍ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 112:1"/>وٌ مَرِفِ عَلَ مَتْشْ!</para>
  <para style="q" vid="PSA 112:1">هّيرِ نَ مِشِ بّ نَشَن فَاشُمَ مَرِفِ يَ رَ،</para>
  <para style="q" vid="PSA 112:1">نَشَن تِنمَ عَ شَ يَامَرِيٍ رَبَتُدٍ.<verse eid="PSA 112:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PSA 112:2"/>عَ بْنسْي سّنبّ فبٌمَ نّ بْشِ مَ.</para>
  <para style="q" vid="PSA 112:2">بَرَكّ لُمَ تِنشِنتْي نَن مَ.<verse eid="PSA 112:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 112:3"/>نَاقُلِ نُن بَننَيَ لُمَ عَ يِ رَ،</para>
  <para style="q" vid="PSA 112:3">عَ شَ تِنشِنيِ شَنشِ عَبَدَن.<verse eid="PSA 112:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 112:4"/>يَنبّ مِنِمَ دِ مِ كُي تِنشِنتْي بّ،</para>
  <para style="q" vid="PSA 112:4">نَشَن كِنِكِنِمَ عَ بٌورٍ مَ،</para>
  <para style="q" vid="PSA 112:4">نَشَن هِننّمَ عَدَ مَدِيٍ رَ،</para>
  <para style="q" vid="PSA 112:4">نَشَن لُمَ حّرّ رَ تِنشِنيِ كُي.<verse eid="PSA 112:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 112:5"/>بَرَكّ لُمَ مِشِ بّ نَشَن مِشِيٍ كِمَ،</para>
  <para style="q" vid="PSA 112:5">نَشَن تِنمَ مِشِ دٌنِدٍ،</para>
  <para style="q" vid="PSA 112:5">نَشَن وَلِمَ تِنشِنيِ رَ.<verse eid="PSA 112:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 112:6"/>نَ كَنيِ مُ بِرَ مَ،</para>
  <para style="q" vid="PSA 112:6">مِشِيٍ مُ نّيمُمَ عَ شَ تِنشِنيِ مَ.<verse eid="PSA 112:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 112:7"/>عَ مُ فَاشُمَ شِبَارُ حَاشِ يَ رَ،</para>
  <para style="q" vid="PSA 112:7">بَرِ مَ عَ شَشِلِ تِشِ عَلَتَلَ رَ، عَ بْحّ شَنشِ.<verse eid="PSA 112:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 112:8"/>عَ بْحّ رَشَرَ، فَاشُي يٌ مُ عَ مَ.</para>
  <para style="q" vid="PSA 112:8">عَ رَحْنيِ، عَ نْمَ نّ عَ يَشُييٍ رَ.<verse eid="PSA 112:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 112:9"/>عَ مِسِكِينّ كِمَ،</para>
  <para style="q" vid="PSA 112:9">عَ حّرّ مَ تِنشِنيِ كُي تّمُي بِرِن،</para>
  <para style="q" vid="PSA 112:9">عَ شُن نَكٍلِمَ تُن.<verse eid="PSA 112:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 112:10"/>مِشِ حَاشِ تْورْ مَ نَ تٌقٍ رَ،</para>
  <para style="q" vid="PSA 112:10">عَ عَ حِنيِ مَشِنمَ،</para>
  <para style="q" vid="PSA 112:10">عَ شَ قٍ شُن نَكَنَمَ.</para>
  <para style="q" vid="PSA 112:10">مِشِ حَاشِيٍ شَ نَتّ مُ كَمَلِمَ قٍقٍ مَ.<verse eid="PSA 112:10"/></para>
  <chapter eid="PSA 112"/>
  <chapter number="113" style="c" sid="PSA 113"/>
  <para style="s1">عَلَتَلَ مَنِيّ مُ نَ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 113:1"/>وٌ عَلَتَلَ مَتْشْ!</para>
  <para style="q" vid="PSA 113:1">عَلَتَلَ شَ كٌنيِ دِيٍ، وٌ شَ عَ مَتْشْ.</para>
  <para style="q" vid="PSA 113:1">وٌ عَلَتَلَ شِلِ مَتْشْ.<verse eid="PSA 113:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 113:2"/>تَنتُي نَ عَلَتَلَ بّ عَبَدَن.<verse eid="PSA 113:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 113:3"/>تَنتُي نَ عَلَتَلَ بّ يِرٍ بِرِن،</para>
  <para style="q" vid="PSA 113:3">كٍلِقٍ سٌفٍتٍدٍ مَبِرِ، هَن سٌفٍفٌرٌدٍ.<verse eid="PSA 113:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 113:4"/>عَلَتَلَ شَ نْي نَ حَمَنّيٍ شُن مَ،</para>
  <para style="q" vid="PSA 113:4">عَ شَ نْرّ نَ كٌورٍ مَ.<verse eid="PSA 113:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 113:5"/>ندٍ مَنِيّ وٌن مَرِفِ عَلَتَلَ رَ،</para>
  <para style="q" vid="PSA 113:5">نَشَن مَفٌرٌشِ عَ شَ كِبَنيِ كُي كٌورٍ مَ،<verse eid="PSA 113:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 113:6"/>نَشَن عَ يَ رَفٌرٌ مَ كٌورٍ نُن بْشِ مَ.<verse eid="PSA 113:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 113:7"/>عَ مِسِكِينّ شُن نَكٍلِمَ،</para>
  <para style="q" vid="PSA 113:7">عَ تْورْ مِشِ بَمَ عَ شَ سٍتَرٍحَ كُي.<verse eid="PSA 113:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 113:8"/>عَ عَ تِمَ عَ شَ كُنتِفِيٍ سّيتِ مَ.<verse eid="PSA 113:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 113:9"/>عَ دِ فبٍفبٍ قِمَ فِنّ دِبَرِتَرٍ مَ،</para>
  <para style="q" vid="PSA 113:9">عَلَكٌ عَ شَ سّيوَ سْتْ عَ شَ دِيٍ يَ مَ.</para>
  <para style="b" vid="PSA 113:9"/>
  <para style="q" vid="PSA 113:9">وٌ عَلَتَلَ مَتْشْ!<verse eid="PSA 113:9"/></para>
  <chapter eid="PSA 113"/>
  <chapter number="114" style="c" sid="PSA 114"/>
  <para style="s1">عِسِرَيِلَ بْشِ عَلَ شَ حَمَ رَ سّنّقٍ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 114:1"/>يَشُبَ بْنسْي نَشَن قِندِشِ عِسِرَيِلَ رَ،</para>
  <para style="q" vid="PSA 114:1">عٍ نَشَ مِنِ مِسِرَ شَ كٌنيِيَ رَ،<verse eid="PSA 114:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 114:2"/>عٍ سَبَتِ يُدَيَ عَلَ شَ هْرْ مْلِنفِرَ لُشِ دّننَشّ.</para>
  <para style="q" vid="PSA 114:2">عِسِرَيِلَ بْشِ نَشَ قِندِ عَلَ شَ مَنفّيَ رَ.<verse eid="PSA 114:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 114:3"/>شُلُنيُمِ بَا تٌ عِسِرَيِلَ حَمَ تٌ،</para>
  <para style="q" vid="PSA 114:3">عَ نَشَ رَبِ مَقُرٍن.</para>
  <para style="q" vid="PSA 114:3">يُرُدّن شُرٍ تٌ عٍ تٌ قَ رَ،</para>
  <para style="q" vid="PSA 114:3">عَ مَن نَشَ كِرَ قِ عٍ مَ.<verse eid="PSA 114:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 114:4"/>عِسِرَيِلَ فٍيَيٍ تٌ عٍ تٌ،</para>
  <para style="q" vid="PSA 114:4">عٍ نَشَ تُفَن تُفَن حّلّشِنيِ رَ،</para>
  <para style="q" vid="PSA 114:4">عَلْ يّشّي كٌنتٌنيِيٍ نُن يّشّي يْرّيٍ تُفَنمَ كِ نَشّ.<verse eid="PSA 114:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 114:5"/>مُنسٍ عَ نِيَشِ نَ بَا شَ رَبِ مَقُرٍن؟</para>
  <para style="q" vid="PSA 114:5">مُنسٍ عَ نِيَشِ يُرُدّن شُرٍ كِرَ قِشِ عٍ مَ؟<verse eid="PSA 114:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 114:6"/>مُنسٍ عَ نِيَشِ عِسِرَيِلَ فٍيَيٍ شَ حّلّشِن</para>
  <para style="q" vid="PSA 114:6">عَلْ يّشّي كٌنتٌنيِيٍ نُن يّشّيٍ يْرّيٍ؟<verse eid="PSA 114:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 114:7"/>دُنِحَ بِرِن شَ سّرّن مَرِفِ يَ رَ،</para>
  <para style="q" vid="PSA 114:7">نَشَن قِندِ يَشُبَ مَرِفِ عَلَ رَ،<verse eid="PSA 114:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 114:8"/>نَشَن يٍ دُلٌنيِ رَ مِنِ قَنيٍ شْرْشْي كُي.<verse eid="PSA 114:8"/></para>
  <chapter eid="PSA 114"/>
  <chapter number="115" style="c" sid="PSA 115"/>
  <para style="s1">عَلَتَلَ فبٌ كُيٍيٍ بّ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 115:1"/>مَتْشْي مُ لَنمَ مُشُ تَن بّ،</para>
  <para style="q" vid="PSA 115:1">مَتْشْي لَنمَ عَلَتَلَ نَن بّ،</para>
  <para style="q" vid="PSA 115:1">عَ شَ هِننّ نُن دُفُتّفّحَ شَ قٍ رَ.<verse eid="PSA 115:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 115:2"/>مُنقٍ رَ حَمَنّيٍ عَ قَلَمَ،</para>
  <para style="q" vid="PSA 115:2">«عٍ شَ عَلَ نَ مِندٍن؟»<verse eid="PSA 115:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 115:3"/>مُشُ مَرِفِ عَلَ نَ كٌورٍ مَ،</para>
  <para style="q" vid="PSA 115:3">عَ عَ وَشْنقٍ بِرِن نَبَمَ.<verse eid="PSA 115:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 115:4"/>كْنْ عٍ شَ كُيٍيٍ يَءِلَنشِ شّيمَ نُن فبٍتِ نَن نَ،</para>
  <para style="q" vid="PSA 115:4">عٍ يّتّ بّلّشّيٍ سَابُي رَ.<verse eid="PSA 115:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 115:5"/>دّ نَ عٍ بّ، كْنْ عٍ مُ وْيّنمَ،</para>
  <para style="q" vid="PSA 115:5">يَ نَ عٍ بّ، كْنْ عٍ مُ سٍ تٌمَ،<verse eid="PSA 115:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 115:6"/>تُلِ نَ عٍ بّ، كْنْ عٍ مُ شُي مّمَ،</para>
  <para style="q" vid="PSA 115:6">حْي نَ عٍ بّ، كْنْ عٍ مُ سٍ شِرِ مّمَ.<verse eid="PSA 115:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 115:7"/>بّلّشّ نَ عٍ بّ، كْنْ عٍ مُ سٍ مَسُشُمَ،</para>
  <para style="q" vid="PSA 115:7">سَنيِ نَ عٍ بّ، كْنْ عٍ مُ عٍ حّرّ مَ.</para>
  <para style="q" vid="PSA 115:7">شُي يٌ مُ مِنِمَ عٍ كْن نَ!<verse eid="PSA 115:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 115:8"/>عٍ يَءِلَنمَيٍ قَمَ نّ لُدٍ عَلْ عٍ تَن.</para>
  <para style="q" vid="PSA 115:8">مِشِ نَشٍيٍ عٍ شَشِلِ تِمَ عٍ رَ عٍ قِندِ مَ سّنبّتَرٍيٍ نَن نَ.<verse eid="PSA 115:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 115:9"/>عِسِرَيِلَ بْنسْي، عِ شَشِلِ تِ عَلَتَلَ رَ،</para>
  <para style="q" vid="PSA 115:9">نَشَن قِندِ عِ شَ دّ مّرِ نُن عِ كَنتَمَ رَ.<verse eid="PSA 115:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 115:10"/>هَرُنَ بْنسْي، عِ شَشِلِ تِ عَلَتَلَ رَ،</para>
  <para style="q" vid="PSA 115:10">نَشَن قِندِ عِ شَ دّ مّرِ نُن عِ كَنتَمَ رَ.<verse eid="PSA 115:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 115:11"/>وٌ تَن نَشٍيٍ قِندِشِ عَلَ يَرَفَاشُييٍ رَ،</para>
  <para style="q" vid="PSA 115:11">وٌ وٌ شَشِلِ تِ عَلَتَلَ رَ،</para>
  <para style="q" vid="PSA 115:11">نَشَن قِندِ عِ شَ دّ مّرِ نُن عِ كَنتَمَ رَ.<verse eid="PSA 115:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 115:12"/>مَرِفِ عَ حْشْ سَشِ وٌن شْن مَ.</para>
  <para style="q" vid="PSA 115:12">عَ وٌن بَرَكَمَ نّ.</para>
  <para style="q" vid="PSA 115:12">عِسِرَيِلَ بْنسْي يٌ، هَرُنَ بْنسْي يٌ،<verse eid="PSA 115:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 115:13"/>نُن عَلَ يَرَفَاشُييٍ بِرِن يٌ،</para>
  <para style="q" vid="PSA 115:13">عٍ بَرَكّ سْتْمَ نّ.<verse eid="PSA 115:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PSA 115:14"/>عَلَتَلَ شَ وٌ تَن نُن وٌ شَ دِيٍ يِرِوَ.<verse eid="PSA 115:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 115:15"/>عَلَتَلَ نَشَن كٌورٍ نُن بْشِ دَا،</para>
  <para style="q" vid="PSA 115:15">عَ شَ بَرَكّ قِ وٌ مَ.<verse eid="PSA 115:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 115:16"/>عَلَتَلَ نَن فبٍ كٌورٍ رَ،</para>
  <para style="q" vid="PSA 115:16">كْنْ عَ نَشَ دُنِحَ تَن قِ عَدَ مَدِيٍ مَ.<verse eid="PSA 115:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 115:17"/>مِشِ قَشَشِيٍ شَ مُ عَلَتَلَ مَتْشْمَ،</para>
  <para style="q" vid="PSA 115:17">مِشِ نَشٍيٍ سِفَمَ عَلِفِيَمَ عٍ مُ نْمَ مَتْشْي رَبَدٍ،<verse eid="PSA 115:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 115:18"/>كْنْ وٌن تَن نَشٍيٍ نَ دُنِحَ،</para>
  <para style="q" vid="PSA 115:18">عَ لَنمَ وٌن شَ تَنتُي رَ سِفَ عَلَتَلَ مَ،</para>
  <para style="q" vid="PSA 115:18">قْلْ يِ تّمُي مَ هَن دَن مُ نَشَن مَ.</para>
  <para style="b" vid="PSA 115:18"/>
  <para style="q" vid="PSA 115:18">وٌ عَلَتَلَ مَتْشْ!<verse eid="PSA 115:18"/></para>
  <chapter eid="PSA 115"/>
  <chapter number="116" style="c" sid="PSA 116"/>
  <para style="s1">عَلَ شَ كِسِ قَشّ مَ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 116:1"/>ﭑ عَلَتَلَ شَنُمَ بَرِ مَ عَ ﭑ شُي مّمَ.</para>
  <para style="q" vid="PSA 116:1">عَ نَشَ كِنِكِنِ ﭑ وَ شُي مَ.<verse eid="PSA 116:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 116:2"/>عَ تٌ عَ تُلِ مَتِ ﭑ نَ،</para>
  <para style="q" vid="PSA 116:2">ﭑ عَ مَشَندِ مَ نّ ﭑ مَ سِمَيَ بِرِن كُي.<verse eid="PSA 116:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 116:3"/>قَشّ لُوتِ نُ بَرَ ﭑ شِرِ،</para>
  <para style="q" vid="PSA 116:3">عَلِفِيَمَ تْورّ نُ بَرَ ﭑ لِ،</para>
  <para style="q" vid="PSA 116:3">نِمِسّ نُن كْنتْقِلِ نُ بَرَ نْ ﭑ نَ،<verse eid="PSA 116:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 116:4"/>كْنْ نَ تّمُي ﭑ نَشَ عَلَتَلَ مَشَندِ،</para>
  <para style="q" vid="PSA 116:4">«عَلَتَلَ، يَندِ، ﭑ نَكِسِ!»<verse eid="PSA 116:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 116:5"/>هِننّنتٍ نَن عَلَتَلَ رَ، عَ تِنشِن.</para>
  <para style="q" vid="PSA 116:5">وٌن مَرِفِ عَلَ كِنِكِنِمَ وٌن مَ.<verse eid="PSA 116:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 116:6"/>عَ مِشِ مَفٌرٌشِ كَنتَمَ.</para>
  <para style="q" vid="PSA 116:6">ﭑ سّنبّ تٌ حْن، عَ نَشَ ﭑ نَكِسِ.<verse eid="PSA 116:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 116:7"/>ﭑ شَ ﭑ نِي رَشَرَ،</para>
  <para style="q" vid="PSA 116:7">بَرِ مَ عَلَتَلَ بَرَ قٍ قَنيِ رَبَ ﭑ بّ.<verse eid="PSA 116:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 116:8"/>عَلَتَلَ، عِ بَرَ ﭑ نِي رَتَنفَ قَشّ مَ،</para>
  <para style="q" vid="PSA 116:8">عِ يَيٍ بَ ﭑ يَ رَ،</para>
  <para style="q" vid="PSA 116:8">عِ ﭑ سَنيِ سّنبّ سٌ،<verse eid="PSA 116:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 116:9"/>عَلَكٌ ﭑ شَ حّرّ عِ تَن عَلَتَلَ يَ رَ مِشِ بَلٌشِ يَ مَ.<verse eid="PSA 116:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 116:10"/>ﭑ تٌ نُ ﭑ شَشِلِ تِمَ عِ رَ،</para>
  <para style="q" vid="PSA 116:10">ﭑ نَشَ عَ قَلَ عِ بّ، «ﭑ نَ تْورْقٍ.»<verse eid="PSA 116:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 116:11"/>لِمَنِيَ تٌ بَ ﭑ يِ رَ،</para>
  <para style="q" vid="PSA 116:11">ﭑ نَشَ عَ قَلَ، «وُلٍ قَلّ نَن مِشِ بِرِن نَ.»<verse eid="PSA 116:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 116:12"/>عَلَتَلَ، ﭑ عِ سَرٍ قِمَ دِ، عِ شَ هِننّ شَ قٍ رَ؟<verse eid="PSA 116:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 116:13"/>ﭑ عِ شَ مَرَتَنفّ مَسٍنمَ نّ حَمَ بّ،</para>
  <para style="q" vid="PSA 116:13">عَلَتَلَ شِلِ مَتْشْقٍ رَ.<verse eid="PSA 116:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 116:14"/>ﭑ نَ ﭑ مَ لَايِدِيٍ رَكَمَلِمَ نّ عَلَتَلَ بّ،</para>
  <para style="q" vid="PSA 116:14">عَ شَ حَمَ بِرِن يَ شْرِ.<verse eid="PSA 116:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PSA 116:15"/>عَلَتَلَ عَ حْشْ سَمَ نّ عَ بَتُلَيٍ شَ سِمَيَ شْن مَ.<verse eid="PSA 116:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 116:16"/>عِ تَن عَلَتَلَ شَ كٌنيِ دِ نَن ﭑ نَ،</para>
  <para style="q" vid="PSA 116:16">عِ شَ كٌنيِ فِنّ شَ دِ،</para>
  <para style="q" vid="PSA 116:16">عِ نَشَن نَقُلُنشِ سَيَ لُوتِ رَ.<verse eid="PSA 116:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PSA 116:17"/>ﭑ تَنتُي سّرّشّ بَمَ نّ عِ بّ،</para>
  <para style="q" vid="PSA 116:17">ﭑ عِ شِلِ مَتْشْمَ نّ.<verse eid="PSA 116:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 116:18"/>ﭑ نَ ﭑ مَ لَايِدِيٍ رَكَمَلِمَ نّ عَلَتَلَ بّ،</para>
  <para style="q" vid="PSA 116:18">عَ شَ حَمَ بِرِن يَ شْرِ،<verse eid="PSA 116:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 116:19"/>عَلَتَلَ شَ بَنشِ تّتّ كُي،</para>
  <para style="q" vid="PSA 116:19">دَرِ سَلَمُ حَمَ يَ شْرِ.</para>
  <para style="b" vid="PSA 116:19"/>
  <para style="q" vid="PSA 116:19">وٌ مَرِفِ مَتْشْ!<verse eid="PSA 116:19"/></para>
  <chapter eid="PSA 116"/>
  <chapter number="117" style="c" sid="PSA 117"/>
  <para style="s1">عَلَ شَ شَنُنتٍيَ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 117:1"/>سِ بِرِن شَ عَلَتَلَ مَتْشْ،</para>
  <para style="q" vid="PSA 117:1">بْنسْي بِرِن شَ عَ تَنتُ،<verse eid="PSA 117:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 117:2"/>بَرِ مَ عَ شَ شَنُنتٍيَ فبٌ وٌن مَبِرِ،</para>
  <para style="q" vid="PSA 117:2">عَ شَ دُفُتّفّحَ مُ حْنمَ عَبَدَن.</para>
  <para style="b" vid="PSA 117:2"/>
  <para style="q" vid="PSA 117:2">وٌ عَلَتَلَ مَتْشْ!<verse eid="PSA 117:2"/></para>
  <chapter eid="PSA 117"/>
  <chapter number="118" style="c" sid="PSA 118"/>
  <para style="s1">شَشِلِ تِقٍ عَلَتَلَ رَ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 118:1"/>وٌ عَلَتَلَ تَنتُ بَرِ مَ عَ قَن،</para>
  <para style="q" vid="PSA 118:1">عَ شَ شَنُنتٍيَ مُ حْنمَ عَبَدَن.<verse eid="PSA 118:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PSA 118:2"/>عِسِرَيِلَ شَ عَ قَلَ،</para>
  <para style="q" vid="PSA 118:2">«عَ شَ شَنُنتٍيَ مُ حْنمَ عَبَدَن!»<verse eid="PSA 118:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 118:3"/>هَرُنَ بْنسْي شَ عَ قَلَ،</para>
  <para style="q" vid="PSA 118:3">«عَ شَ شَنُنتٍيَ مُ حْنمَ عَبَدَن!»<verse eid="PSA 118:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 118:4"/>عَلَ يَرَفَاشُييٍ شَ عَ قَلَ،</para>
  <para style="q" vid="PSA 118:4">«عَ شَ شَنُنتٍيَ مُ حْنمَ عَبَدَن!»<verse eid="PSA 118:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 118:5"/>ﭑ مَ تْورّ كُي، ﭑ نَشَ عَلَتَلَ مَشَندِ.</para>
  <para style="q" vid="PSA 118:5">عَ نَشَ ﭑ مَ دُبَ سُشُ ﭑ قُلُنقٍ رَ.<verse eid="PSA 118:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 118:6"/>عَلَتَلَ نَ ﭑ سّيتِ مَ، ﭑ مُ فَاشُمَ قٍقٍ مَ.</para>
  <para style="q" vid="PSA 118:6">عَدَ مَدِ نْمَ مُنسٍ نِيَدٍ ﭑ نَ؟<verse eid="PSA 118:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 118:7"/>عَلَتَلَ نَ ﭑ قْشْ رَ، عَ ﭑ مَلِمَ.</para>
  <para style="q" vid="PSA 118:7">ﭑ قَمَ نّ نْدٍ ﭑ يَشُييٍ رَ.<verse eid="PSA 118:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 118:8"/>شَشِلِ تِقٍ عَلَتَلَ رَ، نَ نَن قَن بٍينُن شَشِلِ تِقٍ عَدَ مَدِ رَ.<verse eid="PSA 118:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 118:9"/>يّتّ تَشُقٍ عَلَتَلَ رَ دَنفِ يّتّ تَشُقٍ دُنِحَ مَنفّيٍ رَ.<verse eid="PSA 118:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 118:10"/>سِ بِرِن نُ ﭑ نَبِلِنشِ ﭑ فٍرٍ شِلِ مَ،</para>
  <para style="q" vid="PSA 118:10">كْنْ عَلَتَلَ نَشَ عَ نِيَ ﭑ شَ نْ عٍ رَ.<verse eid="PSA 118:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 118:11"/>عٍ نُ ﭑ نَبِلِنشِ عَ حَاشِ رَ،</para>
  <para style="q" vid="PSA 118:11">كْنْ ﭑ نَشَ نْ عٍ رَ عَلَتَلَ شِلِ رَ.<verse eid="PSA 118:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 118:12"/>عٍ نَشَ دِن ﭑ نَ عَلْ كُمِ تْنسْي،</para>
  <para style="q" vid="PSA 118:12">كْنْ عٍ نَشَ حْن عَلْ سّشّ شَرَشِ فَنمَ كِ نَشّ.</para>
  <para style="q" vid="PSA 118:12">عَلَتَلَ نَن عَ نِيَ ﭑ شَ نْ عٍ رَ.<verse eid="PSA 118:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 118:13"/>عٍ نُ ﭑ مَتُتُنمَ سّنبّ رَ،</para>
  <para style="q" vid="PSA 118:13">عَ فبٍ مُ نُ لُشِ ﭑ شَ بِرَ،</para>
  <para style="q" vid="PSA 118:13">كْنْ عَلَتَلَ نَشَ ﭑ مَلِ.<verse eid="PSA 118:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 118:14"/>عَلَتَلَ نَن نَ ﭑ سّنبّ نُن ﭑ مَ سّيوّ رَ،</para>
  <para style="q" vid="PSA 118:14">عَ بَرَ ﭑ نَكِسِ!<verse eid="PSA 118:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PSA 118:15"/>سّيوّ نُن شُننَكٍلِ شُي نَشَ مِنِ تِنشِنتْييٍ شْنيِ عَ قَلَقٍ رَ،<verse eid="PSA 118:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 118:16"/>«عَلَتَلَ نَشَ وَلِ سّنبّ رَ!</para>
  <para style="q" vid="PSA 118:16">عَ نَشَ عَ مَنفّيَ مَسٍن،</para>
  <para style="q" vid="PSA 118:16">عَ كَابَنَكٌي رَبَ.»<verse eid="PSA 118:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PSA 118:17"/>ﭑ مُ قَشَ، ﭑ نَشَ كِسِ،</para>
  <para style="q" vid="PSA 118:17">عَلَكٌ ﭑ شَ عَلَتَلَ شَ كَابَنَكٌي مَسٍن حَمَ بّ.<verse eid="PSA 118:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 118:18"/>عَلَتَلَ بَرَ ﭑ حَشَنكَتَ،</para>
  <para style="q" vid="PSA 118:18">كْنْ عَ مُ ﭑ لُشِ ﭑ شَ قَشَ.<verse eid="PSA 118:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PSA 118:19"/>وٌ تِنشِنيِ نَادّيٍ رَبِ ﭑ بّ،</para>
  <para style="q" vid="PSA 118:19">ﭑ سٌمَ مّننِ عَلَتَلَ تَنتُقٍ رَ.<verse eid="PSA 118:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 118:20"/>عَلَتَلَ شَ نَادّ نَن يِ كِ،</para>
  <para style="q" vid="PSA 118:20">تِنشِنتْييٍ سٌمَ نَشَن كُي.<verse eid="PSA 118:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 118:21"/>ﭑ عِ تَنتُمَ نّ، بَرِ مَ عِ بَرَ ﭑ مَ دُبَ سُشُ،</para>
  <para style="q" vid="PSA 118:21">عِ بَرَ قِندِ ﭑ نَكِسِمَ رَ.<verse eid="PSA 118:21"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="22" style="v" sid="PSA 118:22"/>بَنشِتِيٍ مّي فّمّ نَشَن نَ،</para>
  <para style="q" vid="PSA 118:22">نَ بَرَ قِندِ بَنشِ سَنفَنتِمّ رَ.<verse eid="PSA 118:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 118:23"/>نَ كٍلِشِ مَرِفِ نَن مَ.</para>
  <para style="q" vid="PSA 118:23">كَابَنَكٌي نَ عَ رَ وٌن تَن بّ.<verse eid="PSA 118:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 118:24"/>لْشْي نَن يِ كِ عَلَتَلَ نَشَن حَنِفٍشِ،</para>
  <para style="q" vid="PSA 118:24">وٌن شَ حّلّشِن، وٌن شَ سّيوَ عَ شَ قٍ رَ.<verse eid="PSA 118:24"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="25" style="v" sid="PSA 118:25"/>يَندِ عَلَتَلَ، مُشُ رَكِسِ!</para>
  <para style="q" vid="PSA 118:25">يَندِ عَلَتَلَ، مُشُ شُن نَكٍلِ.<verse eid="PSA 118:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 118:26"/>بَرَكَ نَ مِشِ مَ نَشَن قَقٍ مَرِفِ شِلِ رَ.</para>
  <para style="q" vid="PSA 118:26">مُشُ عَلَتَلَ مَتْشْمَ عَ شَ بَنشِ كُي.<verse eid="PSA 118:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 118:27"/>مَرِفِ نَن نَ عَلَتَلَ رَ،</para>
  <para style="q" vid="PSA 118:27">نَشَن شَ نْرّ بَرَ يَنبَ وٌن مَ.</para>
  <para style="q" vid="PSA 118:27">وٌ شَ سّرّشّ شِرِ سّرّشّبَدٍ سّيتِ مَ.<verse eid="PSA 118:27"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="28" style="v" sid="PSA 118:28"/>ﭑ مَرِفِ عَلَ نَن عِ رَ، ﭑ عِ تَنتُمَ نّ،</para>
  <para style="q" vid="PSA 118:28">ﭑ مَرِفِ عَلَ نَن عِ رَ، ﭑ عِ مَتْشْمَ نّ.<verse eid="PSA 118:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 118:29"/>وٌ عَلَتَلَ تَنتُ بَرِ مَ عَ قَن.</para>
  <para style="q" vid="PSA 118:29">عَ شَ شَنُنتٍيَ مُ حْنمَ عَبَدَن.<verse eid="PSA 118:29"/></para>
  <chapter eid="PSA 118"/>
  <chapter number="119" style="c" sid="PSA 119"/>
  <para style="s1">عَلَ شَ سّرِيّ كٍرٍنيِ</para>
  <para style="s2">عَلَ شَ سّرِيّ</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 119:1"/>سّيوّ نَ مِشِيٍ بّ نَشٍيٍ حّرّ كِ تِنشِن،</para>
  <para style="q" vid="PSA 119:1">نَشٍيٍ بِرَشِ عَلَتَلَ شَ سّرِيّ قْشْ رَ.<verse eid="PSA 119:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 119:2"/>سّيوّ نَ مِشِيٍ بّ نَشٍيٍ عَلَ شَ مَسٍنيِ مّمَ،</para>
  <para style="q" vid="PSA 119:2">نَشٍيٍ عَ قٍنمَ عٍ بْحّ بِرِن نَ.<verse eid="PSA 119:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 119:3"/>نٍيٍ مُ تِنشِنتَرٍيَ رَبَمَ قٍقٍ مَ،</para>
  <para style="q" vid="PSA 119:3">عٍ بِرَ مَ عَلَ شَ كِرَ نَن قْشْ رَ.<verse eid="PSA 119:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 119:4"/>عِ بَرَ عِ سَفٌ مَسٍن مُشُ بّ،</para>
  <para style="q" vid="PSA 119:4">عَلَكٌ مُشُ شَ مُشُ حْشْ سَ عَ شْن مَ عَ قَنيِ رَ.<verse eid="PSA 119:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 119:5"/>ﭑ وَ مَ قٍ بِرِن نَبَقٍ</para>
  <para style="q" vid="PSA 119:5">عَلَكٌ ﭑ شَ عِ شَ يَامَرِيٍ رَبَتُ.<verse eid="PSA 119:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 119:6"/>نَ كُي ﭑ مُ قَمَ يَافِدٍ عِ وَشْنقٍ شَ قٍ رَ.<verse eid="PSA 119:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 119:7"/>ﭑ نَ عِ شَ يَامَرِيٍ كٌلٌن،</para>
  <para style="q" vid="PSA 119:7">ﭑ عِ بَتُمَ نّ ﭑ بْحّ قِيشّ رَ.<verse eid="PSA 119:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 119:8"/>ﭑ عِ شَ يَامَرِيٍ رَتِنمّمَ نّ،</para>
  <para style="q" vid="PSA 119:8">عِ نَشَ مّ ﭑ نَ كٍرٍنيِ رَ.<verse eid="PSA 119:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 119:9"/>قٌنِكٍ حّرّ مَ سّنِيّنيِ كُي دِ؟</para>
  <para style="q" vid="PSA 119:9">عَ بِرَ عِ شَ مَسٍنيِ قْشْ رَ.<verse eid="PSA 119:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 119:10"/>ﭑ عِ قٍنمَ ﭑ بْحّ بِرِن نَن نَ.</para>
  <para style="q" vid="PSA 119:10">عِ نَشَ ﭑ لُ ﭑ شَ مَكُيَ عِ شَ يَامَرِيٍ رَ.<verse eid="PSA 119:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 119:11"/>ﭑ عِ شَ مَسٍنيِ رَفَتَمَ نّ ﭑ بْحّ مَ،</para>
  <para style="q" vid="PSA 119:11">عَلَكٌ ﭑ نَشَ يُنُبِ رَبَ عِ رَ.<verse eid="PSA 119:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 119:12"/>مَتْشْي نَ عِ بّ عَلَتَلَ.</para>
  <para style="q" vid="PSA 119:12">عِ شَ يَامَرِيٍ مَسٍن ﭑ بّ.<verse eid="PSA 119:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 119:13"/>ﭑ عِ شَ سّرِيّ دُرُ سِمَ نّ،</para>
  <para style="q" vid="PSA 119:13">عِ نَشَن مَسٍنشِ عِ كّرّ رَ.<verse eid="PSA 119:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 119:14"/>ﭑ سّيوَشِ بِرَقٍ رَ عِ شَ مَسٍنيِ قْشْ رَ،</para>
  <para style="q" vid="PSA 119:14">عَلْ ﭑ نَ قِندِ بَننَ بٍلٍبٍلٍ رَ.<verse eid="PSA 119:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 119:15"/>ﭑ ﭑ حْشْ سَشِ عِ سَفٌ شْن مَ،</para>
  <para style="q" vid="PSA 119:15">ﭑ عِ شَ كِرَ مَتٌمَ نّ.<verse eid="PSA 119:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 119:16"/>عِ شَ يَامَرِيٍ رَقَن ﭑ مَ،</para>
  <para style="q" vid="PSA 119:16">ﭑ مُ نّيمُمَ عِ شَ مَسٍنيِ مَ.<verse eid="PSA 119:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PSA 119:17"/>قٍ قَنيِ رَبَ ﭑ تَن، عِ شَ كٌنيِ دِ بّ،</para>
  <para style="q" vid="PSA 119:17">عَلَكٌ ﭑ شَ كِسِ، ﭑ شَ عِ شَ مَسٍنيِ رَتِنمّ.<verse eid="PSA 119:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 119:18"/>ﭑ يَ رَبِ عَلَكٌ ﭑ شَ عِ شَ سّرِيّ قَنيِ عِفبّ.<verse eid="PSA 119:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 119:19"/>شْحّ نَن لَنشِ ﭑ مَ يِ دُنِحَ مَ،</para>
  <para style="q" vid="PSA 119:19">عِ نَشَ عِ شَ يَامَرِيٍ نْشُن ﭑ مَ.<verse eid="PSA 119:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 119:20"/>ﭑ هَيِ نَ عِ شَ تِنشِنيِ مَ.<verse eid="PSA 119:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 119:21"/>عِ عِ شُي رَتٍمَ يّتّ عِفبٌي شِلِ مَ،</para>
  <para style="q" vid="PSA 119:21">مِشِ دَنكَشِ نَشٍيٍ عِ شَ يَامَرِيٍ رَبّحِنمَ.<verse eid="PSA 119:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 119:22"/>عِ شَ ﭑ نَتَنفَ يَافِ نُن مَرَحَاشُي مَ،</para>
  <para style="q" vid="PSA 119:22">بَرِ مَ ﭑ عِ شَ مَسٍنيِ سُشُشِ.<verse eid="PSA 119:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 119:23"/>هَلِ مَنفّيٍ ﭑ تْوحّفّمَ،</para>
  <para style="q" vid="PSA 119:23">عِ شَ كٌنيِ دِ عَ حْشْ سَمَ نّ عِ شَ يَامَرِيٍ نَن شْن مَ.<verse eid="PSA 119:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 119:24"/>عِ شَ مَسٍنيِ رَقَن ﭑ مَ،</para>
  <para style="q" vid="PSA 119:24">عٍ ﭑ نَسِمَ عَ قَنيِ رَ.<verse eid="PSA 119:24"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="25" style="v" sid="PSA 119:25"/>ﭑ نَ تْورّ شُنفبٍ كُي.</para>
  <para style="q" vid="PSA 119:25">يَندِ، عِ شَ ﭑ نَكِسِ عِ شَ مَسٍنيِ رَ.<verse eid="PSA 119:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 119:26"/>ﭑ تٌ ﭑ مَ حّرّ كِ مَسٍن عِ بّ، عِ ﭑ يَابِ نّ.</para>
  <para style="q" vid="PSA 119:26">يَندِ، عِ شَ عِ شَ يَامَرِ مَسٍن ﭑ بّ.<verse eid="PSA 119:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 119:27"/>ﭑ مَلِ عِ سَفٌ قَهَامُقٍ رَ،</para>
  <para style="q" vid="PSA 119:27">عَلَكٌ ﭑ شَ ﭑ حْشْ سَ عِ شَ كَابَنَكٌي شْن مَ.<verse eid="PSA 119:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 119:28"/>ﭑ نَ وَقٍ نِمِسّ مَ.</para>
  <para style="q" vid="PSA 119:28">ﭑ شُن نَكٍلِ عَلْ عِ عَ لَايِدِشِ كِ نَشّ.<verse eid="PSA 119:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 119:29"/>وُلٍ قَلَقٍ مَكُيَ ﭑ نَ.</para>
  <para style="q" vid="PSA 119:29">هِننّ ﭑ نَ عِ شَ سّرِيّ سَابُي رَ.<verse eid="PSA 119:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 119:30"/>ﭑ بَرَ دُفُتّفّحَ كِرَ سُفَندِ،</para>
  <para style="q" vid="PSA 119:30">ﭑ بْحّ بِرَ مَ عِ شَ سّرِيّ نَن قْشْ رَ.<verse eid="PSA 119:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 119:31"/>عَلَتَلَ، ﭑ شِرِشِ عِ شَ سّرِيّ نَن نَ،</para>
  <para style="q" vid="PSA 119:31">عِ نَشَ ﭑ لُ يَافِ كُي.<verse eid="PSA 119:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 119:32"/>ﭑ نَ ﭑ حّرّقٍ عِ شَ يَامَرِيٍ شَ كِرَ نَن شْن مَ،</para>
  <para style="q" vid="PSA 119:32">بَرِ مَ عِ بَرَ عَ نِيَ عِ وَشْنقٍ شَ لُ ﭑ بْحّ مَ.<verse eid="PSA 119:32"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="33" style="v" sid="PSA 119:33"/>عَلَتَلَ، ﭑ مَتِنشِن عِ شَ يَامَرِيٍ رَ،</para>
  <para style="q" vid="PSA 119:33">عَلَكٌ ﭑ شَ لُ عِ شَ كِرَ شْن مَ ﭑ مَ سِمَيَ بِرِن كُي.<verse eid="PSA 119:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 119:34"/>شَشِلِ قَنيِ قِ ﭑ مَ،</para>
  <para style="q" vid="PSA 119:34">عَلَكٌ ﭑ شَ ﭑ حْشْ سَ عِ شَ سّرِيّ شْن مَ،</para>
  <para style="q" vid="PSA 119:34">ﭑ مَن شَ عَ رَبَتُ ﭑ بْحّ بِرِن نَ<verse eid="PSA 119:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 119:35"/>ﭑ نَحّرّ عِ شَ يَامَرِيٍ شَ كِرَ شْن مَ،</para>
  <para style="q" vid="PSA 119:35">بَرِ مَ عٍ رَقَن ﭑ مَ<verse eid="PSA 119:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 119:36"/>ﭑ بْحّ رَقِندِ عِ شَ مَسٍنيِ مَ،</para>
  <para style="q" vid="PSA 119:36">عِ نَشَ عَ رَقِندِ بَننَيَ تِنشِنتَرٍيَ مَ.<verse eid="PSA 119:36"/></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 119:37"/>ﭑ يَيٍ بَ سٍيٍ رَ نَشٍيٍ حْنمَ،</para>
  <para style="q" vid="PSA 119:37">ﭑ نَكِسِ عِ شَ كِرَ شْن مَ.<verse eid="PSA 119:37"/></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 119:38"/>عِ شَ لَايِدِ رَكَمَلِ عِ شَ كٌنيِ دِ بّ،</para>
  <para style="q" vid="PSA 119:38">عِ نَشَن نَفَتَشِ عِ يَرَفَاشُييٍ يَ رَ.<verse eid="PSA 119:38"/></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 119:39"/>ﭑ بَ يَافِ كُي ﭑ فَاشُشِ نَشَن يَ رَ،</para>
  <para style="q" vid="PSA 119:39">بَرِ مَ عِ شَ سّرِيّ قَن.<verse eid="PSA 119:39"/></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 119:40"/>ﭑ وَ مَ بِرَقٍ عِ شَ مَسٍنيِ قْشْ رَ عَ قَنيِ رَ.</para>
  <para style="q" vid="PSA 119:40">ﭑ نَكِسِ عِ شَ تِنشِنيِ كُي.<verse eid="PSA 119:40"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="41" style="v" sid="PSA 119:41"/>عَلَتَلَ، قَ عِ شَ شَنُنتٍيَ نُن عِ شَ كِسِ رَ ﭑ بّ،</para>
  <para style="q" vid="PSA 119:41">عَلْ عِ عَ لَايِدِ كِ نَشّ.<verse eid="PSA 119:41"/></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 119:42"/>نَ تّمُي، ﭑ نْمَ نّ ﭑ مَبٍرٍ مَ يَابِدٍ،</para>
  <para style="q" vid="PSA 119:42">بَرِ مَ ﭑ تَن لَشِ عِ شَ مَسٍنيِ رَ.<verse eid="PSA 119:42"/></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 119:43"/>عِ نَشَ نْندِ مَسٍنيِ بَ ﭑ دّ عِ،</para>
  <para style="q" vid="PSA 119:43">بَرِ مَ ﭑ شَشِلِ تِشِ عِ شَ كِيتِ رَ.<verse eid="PSA 119:43"/></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 119:44"/>ﭑ عِ شَ سّرِيّ رَبَتُمَ نّ عَبَدَن.<verse eid="PSA 119:44"/></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 119:45"/>ﭑ لُمَ شْرّيَ نَن كُي،</para>
  <para style="q" vid="PSA 119:45">بَرِ مَ ﭑ نَ عِ سَفٌ نَن قٍنقٍ.<verse eid="PSA 119:45"/></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 119:46"/>ﭑ عِ شَ مَسٍنيِ قَلَمَ نّ مَنفّيٍ بّ،</para>
  <para style="q" vid="PSA 119:46">ﭑ مُ قَمَ لُدٍ يَافِ كُي.<verse eid="PSA 119:46"/></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 119:47"/>بِرَقٍ عِ شَ يَامَرِيٍ قْشْ رَ، نَ رَقَن ﭑ مَ.<verse eid="PSA 119:47"/></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 119:48"/>ﭑ نَ ﭑ بّلّشّيٍ عِتٍمَ تَنتُي رَ</para>
  <para style="q" vid="PSA 119:48">عِ شَ يَامَرِيٍ شَ قٍ رَ، نَشٍيٍ رَقَن ﭑ مَ.</para>
  <para style="q" vid="PSA 119:48">ﭑ وَ مَ ﭑ حْشْ سَقٍ عِ شَ سّرِيّيٍ شْن مَ.<verse eid="PSA 119:48"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="49" style="v" sid="PSA 119:49"/>عِ شَ رَتُ عِ شَ مَسٍنيِ مَ،</para>
  <para style="q" vid="PSA 119:49">عِ نَشَن مَسٍن عِ شَ كٌنيِ دِ بّ،</para>
  <para style="q" vid="PSA 119:49">نَشَن شَشِلِ سَ قِمَ ﭑ مَ يَرٍ.<verse eid="PSA 119:49"/></para>
  <para style="q">
    <verse number="50" style="v" sid="PSA 119:50"/>ﭑ مَدُندُ مَ ﭑ مَ تْورّ كُي</para>
  <para style="q" vid="PSA 119:50">عِ شَ لَايِدِ نَن سَابُي رَ.<verse eid="PSA 119:50"/></para>
  <para style="q">
    <verse number="51" style="v" sid="PSA 119:51"/>يّتّ عِفبٌي ﭑ مَيٍلٍمَ نّ،</para>
  <para style="q" vid="PSA 119:51">كْنْ ﭑ مُ عِ شَ سّرِيّ كِرَ بّحِنمَ.<verse eid="PSA 119:51"/></para>
  <para style="q">
    <verse number="52" style="v" sid="PSA 119:52"/>عَلَتَلَ، ﭑ تٌ ﭑ نَتُ عِ شَ كِيتِ تِنشِنشِيٍ مَ</para>
  <para style="q" vid="PSA 119:52">عِ نَشَن سَشِ تّمُي دَنفِشِ،</para>
  <para style="q" vid="PSA 119:52">ﭑ بْحّ لِمَنِيَمَ نّ.<verse eid="PSA 119:52"/></para>
  <para style="q">
    <verse number="53" style="v" sid="PSA 119:53"/>ﭑ بْحّ تٍشِ عَ حَاشِ رَ تِنشِنتَرٍيٍ شِلِ مَ</para>
  <para style="q" vid="PSA 119:53">نَشٍيٍ عِ شَ سّرِيّ رَبٌلٌمَ.<verse eid="PSA 119:53"/></para>
  <para style="q">
    <verse number="54" style="v" sid="PSA 119:54"/>ﭑ سَبَتِ دّدّ، ﭑ بّيتِ بَمَ نّ عِ شَ يَامَرِيٍ شَ قٍ رَ.<verse eid="PSA 119:54"/></para>
  <para style="q">
    <verse number="55" style="v" sid="PSA 119:55"/>كْي رَ ﭑ نَ ﭑ نَتُمَ نّ عِ شِلِ مَ.</para>
  <para style="q" vid="PSA 119:55">عَلَتَلَ، ﭑ قَمَ نّ عِ شَ سّرِيّيٍ رَتِنمّدٍ.<verse eid="PSA 119:55"/></para>
  <para style="q">
    <verse number="56" style="v" sid="PSA 119:56"/>ﭑ دَرِشِ عِ سَفٌ رَبَتُقٍ نَن نَ.<verse eid="PSA 119:56"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="57" style="v" sid="PSA 119:57"/>عَلَتَلَ، عِ تِدٍ فبٌ ﭑ بّ.</para>
  <para style="q" vid="PSA 119:57">ﭑ بَرَ لَايِدِ تٌنفٌ عِ شَ مَسٍنيِ رَبَتُقٍ رَ.<verse eid="PSA 119:57"/></para>
  <para style="q">
    <verse number="58" style="v" sid="PSA 119:58"/>ﭑ وَ مَ لُقٍ عِ سّيتِ مَ ﭑ بْحّ بِرِن نَ.</para>
  <para style="q" vid="PSA 119:58">هِننّ ﭑ نَ عَلْ عِ عَ مَسٍن كِ نَشّ.<verse eid="PSA 119:58"/></para>
  <para style="q">
    <verse number="59" style="v" sid="PSA 119:59"/>ﭑ تٌ ﭑ حّرّ كِ مَتٌ،</para>
  <para style="q" vid="PSA 119:59">ﭑ بَرَ فبِلٍن عِ شَ مَسٍنيِ مَ.<verse eid="PSA 119:59"/></para>
  <para style="q">
    <verse number="60" style="v" sid="PSA 119:60"/>ﭑ فبَتَمَ نّ،</para>
  <para style="q" vid="PSA 119:60">ﭑ مُ دُفُندِ مَ عِ شَ يَامَرِيٍ رَبَتُقٍ رَ.<verse eid="PSA 119:60"/></para>
  <para style="q">
    <verse number="61" style="v" sid="PSA 119:61"/>هَلِ مِشِ حَاشِيٍ كَنكَن ﭑ مَ،</para>
  <para style="q" vid="PSA 119:61">ﭑ مُ نّيمُمَ عِ شَ سّرِيّيٍ مَ.<verse eid="PSA 119:61"/></para>
  <para style="q">
    <verse number="62" style="v" sid="PSA 119:62"/>كْي تَفِ، ﭑ كٍلِمَ نّ، ﭑ عِ مَتْشْ عِ شَ كِيتِ تِنشِنشِ شَ قٍ رَ.<verse eid="PSA 119:62"/></para>
  <para style="q">
    <verse number="63" style="v" sid="PSA 119:63"/>عِ يَرَفَاشُي بِرِن قِندِشِ ﭑ حّرّبٌورٍ نَن نَ،</para>
  <para style="q" vid="PSA 119:63">نُن نَشٍيٍ عِ سَفٌ رَبَتُمَ.<verse eid="PSA 119:63"/></para>
  <para style="q">
    <verse number="64" style="v" sid="PSA 119:64"/>عَلَتَلَ عِ شَ شَنُنتٍيَ نَ دُنِحَ بِرِن مَ،</para>
  <para style="q" vid="PSA 119:64">ﭑ شَرَن عِ شَ يَامَرِيٍ رَ.<verse eid="PSA 119:64"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="65" style="v" sid="PSA 119:65"/>عَلَتَلَ، عِ بَرَ قٍ قَنيِ رَبَ ﭑ تَن عِ شَ كٌنيِ بّ،</para>
  <para style="q" vid="PSA 119:65">عَلْ عِ عَ لَايِدِشِ كِ نَشّ.<verse eid="PSA 119:65"/></para>
  <para style="q">
    <verse number="66" style="v" sid="PSA 119:66"/>ﭑ شَرَن قٍ تَفِ رَ سَدٍ نُن قٍ كٌلٌنيِ رَ، بَرِ مَ ﭑ لَشِ عِ شَ يَامَرِيٍ رَ.<verse eid="PSA 119:66"/></para>
  <para style="q">
    <verse number="67" style="v" sid="PSA 119:67"/>ﭑ نُ بَرَ لْي بٍيمَنُ عِ شَ ﭑ مَ قٍ مَفٌرٌ،</para>
  <para style="q" vid="PSA 119:67">كْنْ يَكْسِ قَ ﭑ نَ عِ شَ مَسٍنيِ نَن نَبَتُقٍ.<verse eid="PSA 119:67"/></para>
  <para style="q">
    <verse number="68" style="v" sid="PSA 119:68"/>عِ قَن، عِ قٍ قَنيِ رَبَمَ،</para>
  <para style="q" vid="PSA 119:68">ﭑ شَرَن عِ شَ يَامَرِيٍ رَ.<verse eid="PSA 119:68"/></para>
  <para style="q">
    <verse number="69" style="v" sid="PSA 119:69"/>هَلِ يّتّ عِفبٌي وُلٍ سَمَ ﭑ شُن،</para>
  <para style="q" vid="PSA 119:69">ﭑ عِ شَ يَامَرِيٍ رَبَتُمَ نّ ﭑ بْحّ بِرِن نَ.<verse eid="PSA 119:69"/></para>
  <para style="q">
    <verse number="70" style="v" sid="PSA 119:70"/>عٍ بْحّ شْرْشْ عَلْ فّمّ،</para>
  <para style="q" vid="PSA 119:70">كْنْ عِ شَ سّرِيّ حْشُن ﭑ بّ.<verse eid="PSA 119:70"/></para>
  <para style="q">
    <verse number="71" style="v" sid="PSA 119:71"/>ﭑ مَ تْورّ بَرَ ﭑ مَلِ عِ شَ يَامَرِيٍ كٌلٌنقٍ رَ.<verse eid="PSA 119:71"/></para>
  <para style="q">
    <verse number="72" style="v" sid="PSA 119:72"/>عِ شَ مَسٍنيِ قَن ﭑ بّ شّيمَ نُن فبٍتِ رَ.<verse eid="PSA 119:72"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="73" style="v" sid="PSA 119:73"/>عِ تَن نَن ﭑ دَاشِ، عِ تَن نَن ﭑ نَقَلَشِ عِ شْنيّ رَ.</para>
  <para style="q" vid="PSA 119:73">قَهَامُي قِ ﭑ مَ عِ شَ يَامَرِيٍ كٌلٌنقٍ رَ.<verse eid="PSA 119:73"/></para>
  <para style="q">
    <verse number="74" style="v" sid="PSA 119:74"/>عِ يَرَفَاشُييٍ شَ سّيوَ ﭑ تٌقٍ رَ،</para>
  <para style="q" vid="PSA 119:74">بَرِ مَ ﭑ شَشِلِ تِشِ عِ شَ مَسٍنيِ رَ.<verse eid="PSA 119:74"/></para>
  <para style="q">
    <verse number="75" style="v" sid="PSA 119:75"/>عَلَتَلَ، ﭑ عَ كٌلٌن عِ شَ كِيتِ تِنشِنشِ رَ،</para>
  <para style="q" vid="PSA 119:75">ﭑ عَ كٌلٌن عِ ﭑ مَ قٍ مَفٌرٌشِ شَنُنتٍيَ نَن مَ.<verse eid="PSA 119:75"/></para>
  <para style="q">
    <verse number="76" style="v" sid="PSA 119:76"/>يَندِ، عِ شَ شَنُنتٍيَ شَ ﭑ مَدُندُ،</para>
  <para style="q" vid="PSA 119:76">عَلْ عِ عَ لَايِدِ ﭑ تَن، عِ شَ كٌنيِ بّ كِ نَشّ.<verse eid="PSA 119:76"/></para>
  <para style="q">
    <verse number="77" style="v" sid="PSA 119:77"/>عِ شَ كِنِكِنِ ﭑ مَ عَلَكٌ ﭑ شَ كِسِ،</para>
  <para style="q" vid="PSA 119:77">بَرِ مَ عِ شَ سّرِيّ رَقَن ﭑ مَ.<verse eid="PSA 119:77"/></para>
  <para style="q">
    <verse number="78" style="v" sid="PSA 119:78"/>يّتّ عِفبٌي شَ يَافِ سْتْ،</para>
  <para style="q" vid="PSA 119:78">بَرِ مَ ﭑ مُ قٍ يٌ رَبَشِ عٍ رَ عٍ ﭑ تْورْ مَ نَشَن مَ.</para>
  <para style="q" vid="PSA 119:78">ﭑ تَن حْشْ سَمَ عِ سَفٌ نَن شْن مَ.<verse eid="PSA 119:78"/></para>
  <para style="q">
    <verse number="79" style="v" sid="PSA 119:79"/>عِ يَرَفَاشُييٍ شَ فبِلٍن ﭑ مَ،</para>
  <para style="q" vid="PSA 119:79">عَ نُن نَشٍيٍ عِ شَ مَسٍنيِ كٌلٌن.<verse eid="PSA 119:79"/></para>
  <para style="q">
    <verse number="80" style="v" sid="PSA 119:80"/>ﭑ بْحّ شَ عِ شَ يَامَرِيٍ سُشُ،</para>
  <para style="q" vid="PSA 119:80">عَلَكٌ يَافِ نَشَ قَ دُ سُ ﭑ شُن نَ.<verse eid="PSA 119:80"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="81" style="v" sid="PSA 119:81"/>عَ شْلِ ﭑ مَ ﭑ شَ عِ شَ كِسِ سْتْ،</para>
  <para style="q" vid="PSA 119:81">كْنْ ﭑ شَشِلِ تِشِ عِ شَ مَسٍنيِ نَن نَ.<verse eid="PSA 119:81"/></para>
  <para style="q">
    <verse number="82" style="v" sid="PSA 119:82"/>ﭑ عِ شَ لَايِدِ رَكَمَلِشِ مَمّقٍ.</para>
  <para style="q" vid="PSA 119:82">ﭑ عَ قَلَمَ ﭑ بْحّ كُي، «عِ ﭑ مَدُندُ مَ مُن تّمُي؟»<verse eid="PSA 119:82"/></para>
  <para style="q">
    <verse number="83" style="v" sid="PSA 119:83"/>ﭑ لُشِ عَلْ كُندِ نَشَن نَ رَشَرَقٍ،</para>
  <para style="q" vid="PSA 119:83">كْنْ ﭑ مُ نّيمُمَ عِ شَ يَامَرِيٍ رَ.<verse eid="PSA 119:83"/></para>
  <para style="q">
    <verse number="84" style="v" sid="PSA 119:84"/>ﭑ شَ مَمّ تِ هَن مُن تّمُي،</para>
  <para style="q" vid="PSA 119:84">بٍينُن عِ شَ ﭑ يَشُييٍ حَشَنكَتَ؟<verse eid="PSA 119:84"/></para>
  <para style="q">
    <verse number="85" style="v" sid="PSA 119:85"/>يّتّ عِفبٌي فَنتَنيِ تِمَ ﭑ يَ رَ.</para>
  <para style="q" vid="PSA 119:85">سّرِيّ مُ نَ كِ.<verse eid="PSA 119:85"/></para>
  <para style="q">
    <verse number="86" style="v" sid="PSA 119:86"/>عِ شَ يَامَرِ بِرِن تِنشِن.</para>
  <para style="q" vid="PSA 119:86">ﭑ نَتَنفَ تْوحّفّ مَ.<verse eid="PSA 119:86"/></para>
  <para style="q">
    <verse number="87" style="v" sid="PSA 119:87"/>عَ فبٍ مُ لُشِ عٍ شَ ﭑ مَ قٍ كَنَ،</para>
  <para style="q" vid="PSA 119:87">كْنْ ﭑ تٌندِ نّ عِ شَ يَامَرِيٍ رَبٌلٌدٍ.<verse eid="PSA 119:87"/></para>
  <para style="q">
    <verse number="88" style="v" sid="PSA 119:88"/>ﭑ نَكِسِ عِ شَ شَنُنتٍيَ رَ،</para>
  <para style="q" vid="PSA 119:88">عَلَكٌ ﭑ شَ عِ شَ مَسٍنيِ سُشُ.<verse eid="PSA 119:88"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="89" style="v" sid="PSA 119:89"/>عَلَتَلَ، عِ شَ مَسٍنيِ نَ كٌورٍ مَ عَبَدَن.<verse eid="PSA 119:89"/></para>
  <para style="q">
    <verse number="90" style="v" sid="PSA 119:90"/>عِ شَ شَنُنتٍيَ بُمَ نّ كٍلِقٍ تٌ بْنسْي مَ هَن بْنسْي نَشٍيٍ سَ قَمَ.</para>
  <para style="q" vid="PSA 119:90">عِ دُنِحَ شَنشِ نَن دَا.<verse eid="PSA 119:90"/></para>
  <para style="q">
    <verse number="91" style="v" sid="PSA 119:91"/>عِ شَ سّرِيّ بُمَ هَن تٌ،</para>
  <para style="q" vid="PSA 119:91">بِرِن نَ عِ شَ مَنفّيَ نَن بُن مَ.<verse eid="PSA 119:91"/></para>
  <para style="q">
    <verse number="92" style="v" sid="PSA 119:92"/>شَ ﭑ مُ سّيوَ عِ شَ سّرِيّ رَ نُ،</para>
  <para style="q" vid="PSA 119:92">ﭑ بَرَ بْنْ ﭑ مَ تْورّ كُي نُ.<verse eid="PSA 119:92"/></para>
  <para style="q">
    <verse number="93" style="v" sid="PSA 119:93"/>ﭑ مُ نّيمُمَ عِ شَ مَسٍنيِ رَ قٍوٌ،</para>
  <para style="q" vid="PSA 119:93">بَرِ مَ عِ ﭑ كِسِشِ عٍ تَن نَن سَابُي رَ.<verse eid="PSA 119:93"/></para>
  <para style="q">
    <verse number="94" style="v" sid="PSA 119:94"/>ﭑ بَرَ ﭑ يّتّ قِ عِ مَ، ﭑ نَكِسِ.</para>
  <para style="q" vid="PSA 119:94">ﭑ تِنمَ عِ سَفٌ سُشُقٍ رَ.<verse eid="PSA 119:94"/></para>
  <para style="q">
    <verse number="95" style="v" sid="PSA 119:95"/>مِشِ حَاشِيٍ وَ مَ ﭑ قَشَقٍ،</para>
  <para style="q" vid="PSA 119:95">كْنْ ﭑ تَن حْشْ سَشِ عِ شَ مَسٍنيِ شْن مَ.<verse eid="PSA 119:95"/></para>
  <para style="q">
    <verse number="96" style="v" sid="PSA 119:96"/>ﭑ عَ كٌلٌن دُنِحَ قٍ بِرِن حْنمَ نّ،</para>
  <para style="q" vid="PSA 119:96">كْنْ عِ شَ سّرِيّ مُ كَنَمَ عَبَدَن.<verse eid="PSA 119:96"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="97" style="v" sid="PSA 119:97"/>عِ شَ سّرِيّ رَقَن ﭑ مَ.</para>
  <para style="q" vid="PSA 119:97">ﭑ نَ ﭑ حْشْ سَشِ عَ شْن مَ كُدّ.<verse eid="PSA 119:97"/></para>
  <para style="q">
    <verse number="98" style="v" sid="PSA 119:98"/>عِ شَ يَامَرِيٍ ﭑ قِندِ مَ قَهَامُلَ نَن نَ</para>
  <para style="q" vid="PSA 119:98">دَنفِ ﭑ يَشُييٍ رَ، بَرِ مَ عٍ نَ ﭑ بْحّ كُي تّمُي بِرِن.<verse eid="PSA 119:98"/></para>
  <para style="q">
    <verse number="99" style="v" sid="PSA 119:99"/>ﭑ شَشِلِ قَن ﭑ كَرَ مْشْيٍ شَشِلِ بّ،</para>
  <para style="q" vid="PSA 119:99">بَرِ مَ ﭑ نَ ﭑ حْشْ سَشِ عِ شَ مَسٍنيِ نَن شْن مَ.<verse eid="PSA 119:99"/></para>
  <para style="q">
    <verse number="100" style="v" sid="PSA 119:100"/>ﭑ قٍ كٌلٌن دَنفِقٍ قٌرِيٍ رَ،</para>
  <para style="q" vid="PSA 119:100">بَرِ مَ ﭑ عِ سَفٌ رَبَتُشِ.<verse eid="PSA 119:100"/></para>
  <para style="q">
    <verse number="101" style="v" sid="PSA 119:101"/>ﭑ بَرَ ﭑ سَنيِ بَ كِرَ حَاشِيٍ شْن مَ،</para>
  <para style="q" vid="PSA 119:101">ﭑ شَ بِرَ عِ شَ مَسٍنيِ قْشْ رَ.<verse eid="PSA 119:101"/></para>
  <para style="q">
    <verse number="102" style="v" sid="PSA 119:102"/>ﭑ مُ عِ شَ سّرِيّ بّحِن،</para>
  <para style="q" vid="PSA 119:102">بَرِ مَ عِ تَن نَن يَتِ ﭑ شَرَن نَ رَ.<verse eid="PSA 119:102"/></para>
  <para style="q">
    <verse number="103" style="v" sid="PSA 119:103"/>عِ شَ مَسٍنيِ حْشُن ﭑ دّ كُي دَنفِ كُمِ رَ.<verse eid="PSA 119:103"/></para>
  <para style="q">
    <verse number="104" style="v" sid="PSA 119:104"/>ﭑ شَشِلِ قَنيِ سْتْ عِ سَفٌ نَن نَ.</para>
  <para style="q" vid="PSA 119:104">نَ كُي ﭑ بَرَ كِرَ حَاشِيٍ تَن شْن.<verse eid="PSA 119:104"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="105" style="v" sid="PSA 119:105"/>عِ شَ مَسٍنيِ قِندِشِ لَنثُي نَن نَ ﭑ سَن تِدٍ،</para>
  <para style="q" vid="PSA 119:105">عَ قِندِ نَءِيَلَنيِ رَ ﭑ مَ كِرَ شْن مَ.<verse eid="PSA 119:105"/></para>
  <para style="q">
    <verse number="106" style="v" sid="PSA 119:106"/>ﭑ بَرَ لَايِدِ تٌنفٌ نَشَن مُ كَنَمَ،</para>
  <para style="q" vid="PSA 119:106">ﭑ قَمَ نّ بِرَدٍ عِ شَ سّرِيّ تِنشِنشِ قْشْ رَ.<verse eid="PSA 119:106"/></para>
  <para style="q">
    <verse number="107" style="v" sid="PSA 119:107"/>ﭑ بَرَ تْورْ عَ فبٍ رَ.</para>
  <para style="q" vid="PSA 119:107">عَلَتَلَ، ﭑ نَكِسِ عِ شَ مَسٍنيِ رَ.<verse eid="PSA 119:107"/></para>
  <para style="q">
    <verse number="108" style="v" sid="PSA 119:108"/>عَلَتَلَ، ﭑ بَرَ عِ مَشَندِ،</para>
  <para style="q" vid="PSA 119:108">عِ شَ ﭑ مَ مَتْشْي سُشُ سّرّشّ رَ،</para>
  <para style="q" vid="PSA 119:108">عِ شَ ﭑ شَرَن عِ سَفٌ رَ.<verse eid="PSA 119:108"/></para>
  <para style="q">
    <verse number="109" style="v" sid="PSA 119:109"/>ﭑ نِي نَ قَشّ يَ عِ تّمُي بِرِن،</para>
  <para style="q" vid="PSA 119:109">كْنْ ﭑ مُ نّيمُمَ عِ شَ سّرِيّ مَ.<verse eid="PSA 119:109"/></para>
  <para style="q">
    <verse number="110" style="v" sid="PSA 119:110"/>مِشِ حَاشِيٍ فَنتَنيِ تٍمَ ﭑ بّ،</para>
  <para style="q" vid="PSA 119:110">كْنْ ﭑ مُ ﭑ مَكُيَمَ عِ سَفٌ رَ.<verse eid="PSA 119:110"/></para>
  <para style="q">
    <verse number="111" style="v" sid="PSA 119:111"/>عِ شَ مَسٍنيِ قِندِشِ ﭑ كّ نَن نَ عَبَدَن،</para>
  <para style="q" vid="PSA 119:111">عَ ﭑ بْحّ رَ سّيوَ مَ نّ.<verse eid="PSA 119:111"/></para>
  <para style="q">
    <verse number="112" style="v" sid="PSA 119:112"/>ﭑ بْحّ بِرَ مَ نّ عِ شَ يَامَرِيٍ قْشْ رَ عَبَدَن.<verse eid="PSA 119:112"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="113" style="v" sid="PSA 119:113"/>ﭑ قِلَنكَقُي شْنمَ،</para>
  <para style="q" vid="PSA 119:113">كْنْ عِ شَ سّرِيّ رَقَن ﭑ مَ.<verse eid="PSA 119:113"/></para>
  <para style="q">
    <verse number="114" style="v" sid="PSA 119:114"/>ﭑ كَنتَرِ نُن ﭑ مَكَنتَمَ نَ عِ تَن نَن نَ،</para>
  <para style="q" vid="PSA 119:114">ﭑ شَشِلِ تِشِ عِ شَ مَسٍنيِ رَ.<verse eid="PSA 119:114"/></para>
  <para style="q">
    <verse number="115" style="v" sid="PSA 119:115"/>وٌ وٌ مَسِفَ ﭑ نَ، وٌ تَن مِشِ كٌبِيٍ،</para>
  <para style="q" vid="PSA 119:115">عَلَكٌ ﭑ شَ عَلَ شَ يَامَرِيٍ رَتِنمّ.<verse eid="PSA 119:115"/></para>
  <para style="q">
    <verse number="116" style="v" sid="PSA 119:116"/>ﭑ دّ مّن عَلْ عِ عَ لَايِدِ كِ نَشّ، عَلَكٌ ﭑ شَ كِسِ.</para>
  <para style="q" vid="PSA 119:116">عِ نَشَ قٍ كَنَ ﭑ شَشِلِ تِشِ نَشَن نَ.<verse eid="PSA 119:116"/></para>
  <para style="q">
    <verse number="117" style="v" sid="PSA 119:117"/>عِ شَ تِ ﭑ قَنفَ رَ، عَلَكٌ ﭑ شَ كِسِ.</para>
  <para style="q" vid="PSA 119:117">ﭑ يَ تِشِ عِ شَ يَامَرِيٍ رَ.<verse eid="PSA 119:117"/></para>
  <para style="q">
    <verse number="118" style="v" sid="PSA 119:118"/>عِ شَ تٌندِ مِشِيٍ رَ نَشٍيٍ عٍ مَكُيَمَ عِ شَ سّرِيّ رَ،</para>
  <para style="q" vid="PSA 119:118">بَرِ مَ مَدَشُحَ نُن وُلٍ نَ عٍ شَ قٍ بِرِن كُي.<verse eid="PSA 119:118"/></para>
  <para style="q">
    <verse number="119" style="v" sid="PSA 119:119"/>عِ مِشِ كٌبِيٍ حْنمَ نّ يِ دُنِحَ مَ،</para>
  <para style="q" vid="PSA 119:119">عَلْ شَبُي فبٍتِ فبِ بَمَ كِ نَشّ.</para>
  <para style="q" vid="PSA 119:119">نَ نَن عَ رَ عِ شَ مَسٍنيِ رَقَن ﭑ مَ.<verse eid="PSA 119:119"/></para>
  <para style="q">
    <verse number="120" style="v" sid="PSA 119:120"/>ﭑ قَتٍ سّرّنمَ عِ شَ مَفَاشُي رَ،</para>
  <para style="q" vid="PSA 119:120">ﭑ هَنمّشِ عِ شَ كِيتِ رَ.<verse eid="PSA 119:120"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="121" style="v" sid="PSA 119:121"/>ﭑ وَلِمَ نْندِ نُن تِنشِنيِ نَن نَ.</para>
  <para style="q" vid="PSA 119:121">عِ نَشَ ﭑ لُ ﭑ يَشُييٍ يِ رَ.<verse eid="PSA 119:121"/></para>
  <para style="q">
    <verse number="122" style="v" sid="PSA 119:122"/>عِ شَ ﭑ مَ قٍ سْونّيَ عِ سّنبّ رَ،</para>
  <para style="q" vid="PSA 119:122">عِ نَشَ لُ يّتّ عِفبٌي شَ نْ ﭑ نَ.<verse eid="PSA 119:122"/></para>
  <para style="q">
    <verse number="123" style="v" sid="PSA 119:123"/>ﭑ يَ تِشِ عِ شَ كِسِ رَ تّمُي بِرِن،</para>
  <para style="q" vid="PSA 119:123">عَ نُن عِ شَ مَسٍنيِ تِنشِنشِ.<verse eid="PSA 119:123"/></para>
  <para style="q">
    <verse number="124" style="v" sid="PSA 119:124"/>هِننّ عِ شَ كٌنيِ رَ عِ شَ شَنُنتٍيَ كُي.</para>
  <para style="q" vid="PSA 119:124">ﭑ شَرَن عِ شَ يَامَرِيٍ رَ.<verse eid="PSA 119:124"/></para>
  <para style="q">
    <verse number="125" style="v" sid="PSA 119:125"/>قَهَامُي قِ ﭑ تَن، عِ شَ كٌنيِ مَ،</para>
  <para style="q" vid="PSA 119:125">عَلَكٌ ﭑ شَ عِ شَ مَسٍنيِ كُي كٌلٌن.<verse eid="PSA 119:125"/></para>
  <para style="q">
    <verse number="126" style="v" sid="PSA 119:126"/>مِشِيٍ نَ عِ شَ سّرِيّ مَتَندِقٍ.</para>
  <para style="q" vid="PSA 119:126">عَلَتَلَ، عَ لَنمَ عِ شَ تِ عٍ يَ رَ يَكْسِ.<verse eid="PSA 119:126"/></para>
  <para style="q">
    <verse number="127" style="v" sid="PSA 119:127"/>عِ شَ يَامَرِيٍ رَقَنشِ ﭑ مَ دَنفِقٍ شّيمَ قَنيِ رَ،<verse eid="PSA 119:127"/></para>
  <para style="q">
    <verse number="128" style="v" sid="PSA 119:128"/>ﭑ تٌ عَ مَحْشُن عِ سَفٌ تِنشِن،</para>
  <para style="q" vid="PSA 119:128">ﭑ كِرَ بِرِن شْنمَ نّ نَشَن مُ قِندِ نْندِ رَ.<verse eid="PSA 119:128"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="129" style="v" sid="PSA 119:129"/>عِ شَ مَسٍنيِ ﭑ دّ عِشَرَ مَ،</para>
  <para style="q" vid="PSA 119:129">ﭑ عَ رَبَتُمَ نَ نَن مَ.<verse eid="PSA 119:129"/></para>
  <para style="q">
    <verse number="130" style="v" sid="PSA 119:130"/>عِ شَ مَسٍنيِ كُي مَتٌقٍ،</para>
  <para style="q" vid="PSA 119:130">عَ شَشِلِ قِمَ نّ شَشِلِتَرٍيٍ مَ.<verse eid="PSA 119:130"/></para>
  <para style="q">
    <verse number="131" style="v" sid="PSA 119:131"/>عَ نَ ﭑ نِي رَ ﭑ شَ عِ سَفٌ كٌلٌن.<verse eid="PSA 119:131"/></para>
  <para style="q">
    <verse number="132" style="v" sid="PSA 119:132"/>عِ يَ رَقِندِ ﭑ مَ، عِ شَ هِننّ ﭑ نَ،</para>
  <para style="q" vid="PSA 119:132">عَلْ عِ دَرِشِ عَ رَبَ رَ كِ نَشّ عِ شَنُنتٍنيِيٍ بّ.<verse eid="PSA 119:132"/></para>
  <para style="q">
    <verse number="133" style="v" sid="PSA 119:133"/>عِ شَ ﭑ تِ عِ شَ مَسٍنيِ قَرِ،</para>
  <para style="q" vid="PSA 119:133">عِ نَشَ لُ قٍ حَاشِ يٌ شَ نْ ﭑ نَ.<verse eid="PSA 119:133"/></para>
  <para style="q">
    <verse number="134" style="v" sid="PSA 119:134"/>ﭑ بَ عَدَ مَدِيٍ شَ نْي بُن مَ،</para>
  <para style="q" vid="PSA 119:134">عَلَكٌ ﭑ شَ عِ شَ يَامَرِيٍ رَتِنمّ.<verse eid="PSA 119:134"/></para>
  <para style="q">
    <verse number="135" style="v" sid="PSA 119:135"/>عِ يَتَفِ نْرّ رَيَنبَ عِ شَ كٌنيِ مَ،</para>
  <para style="q" vid="PSA 119:135">عِ شَ ﭑ شَرَن عِ شَ يَامَرِيٍ رَ.<verse eid="PSA 119:135"/></para>
  <para style="q">
    <verse number="136" style="v" sid="PSA 119:136"/>ﭑ لُمَ وَ رَ عَ فبٍ رَ،</para>
  <para style="q" vid="PSA 119:136">بَرِ مَ ﭑ عَ كٌلٌن مِشِيٍ مُ عِ شَ سّرِيّ رَتِنمّمَ.<verse eid="PSA 119:136"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="137" style="v" sid="PSA 119:137"/>عَلَتَلَ عِ تِنشِن، عِ شَ كِيتِيٍ قَن تِنشِن.<verse eid="PSA 119:137"/></para>
  <para style="q">
    <verse number="138" style="v" sid="PSA 119:138"/>عِ شَ مَسٍنيِ تِنشِن، عَ مَن قِندِشِ نْندِ يَتِ نَن نَ.<verse eid="PSA 119:138"/></para>
  <para style="q">
    <verse number="139" style="v" sid="PSA 119:139"/>ﭑ بْحّ رَحَاشُمَ نّ ﭑ مَ،</para>
  <para style="q" vid="PSA 119:139">بَرِ مَ ﭑ يَشُييٍ مُ عٍ تُلِ مَتِمَ عِ شَ مَسٍنيِ رَ.<verse eid="PSA 119:139"/></para>
  <para style="q">
    <verse number="140" style="v" sid="PSA 119:140"/>عِ شَ مَسٍنيِ بَرَ عَ يّتّ شَ نْندِ مَسٍن،</para>
  <para style="q" vid="PSA 119:140">عَ رَقَن ﭑ تَن عِ شَ كٌنيِ مَ.<verse eid="PSA 119:140"/></para>
  <para style="q">
    <verse number="141" style="v" sid="PSA 119:141"/>هَلِ ﭑ شُرُن، مِشِيٍ يٌمَ ﭑ مَ،</para>
  <para style="q" vid="PSA 119:141">ﭑ مُ نّيمُمَ عِ سَفٌ مَ.<verse eid="PSA 119:141"/></para>
  <para style="q">
    <verse number="142" style="v" sid="PSA 119:142"/>عِ شَ تِنشِنيِ بُمَ عَبَدَن.</para>
  <para style="q" vid="PSA 119:142">عِ شَ سّرِيّ نْندِ نَ عَ رَ.<verse eid="PSA 119:142"/></para>
  <para style="q">
    <verse number="143" style="v" sid="PSA 119:143"/>سُننُنيِ نُن تْورّ ﭑ سُشُشِ،</para>
  <para style="q" vid="PSA 119:143">كْنْ عِ شَ يَامَرِيٍ نْشُن ﭑ بّ.<verse eid="PSA 119:143"/></para>
  <para style="q">
    <verse number="144" style="v" sid="PSA 119:144"/>عِ شَ سّرِيّيٍ تِنشِن عَبَدَن.</para>
  <para style="q" vid="PSA 119:144">قَهَامُي قِ ﭑ مَ عَلَكٌ ﭑ شَ كِسِ.<verse eid="PSA 119:144"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="145" style="v" sid="PSA 119:145"/>عَلَتَلَ، ﭑ نَ ﭑ دّ رَوَقٍ عِ بّ ﭑ بْحّ بِرِن نَ.</para>
  <para style="q" vid="PSA 119:145">ﭑ يَابِ، عَلَكٌ ﭑ شَ نْ عِ شَ يَامَرِيٍ رَتِنمّدٍ.<verse eid="PSA 119:145"/></para>
  <para style="q">
    <verse number="146" style="v" sid="PSA 119:146"/>ﭑ نَ ﭑ دّ رَوَقٍ عِ بّ.</para>
  <para style="q" vid="PSA 119:146">ﭑ نَكِسِ، عَلَكٌ ﭑ شَ نْ عِ سَفٌ رَبَدٍ.<verse eid="PSA 119:146"/></para>
  <para style="q">
    <verse number="147" style="v" sid="PSA 119:147"/>ﭑ كٍلِمَ بٍيمَنُ سُبَشّ شَ عَ لِ،</para>
  <para style="q" vid="PSA 119:147">ﭑ عِ مَشَندِ عِ شَ ﭑ دّ مّن.</para>
  <para style="q" vid="PSA 119:147">ﭑ شَشِلِ تِشِ عِ شَ مَسٍنيِ نَن نَ.<verse eid="PSA 119:147"/></para>
  <para style="q">
    <verse number="148" style="v" sid="PSA 119:148"/>ﭑ مُ شِمَ كْي رَ،</para>
  <para style="q" vid="PSA 119:148">ﭑ نَ ﭑ مَحْشُنمَ عِ شَ مَسٍنيِ نَن تُن مَ.<verse eid="PSA 119:148"/></para>
  <para style="q">
    <verse number="149" style="v" sid="PSA 119:149"/>عِ عِ تُلِ مَتِ ﭑ شُي رَ عِ شَ شَنُنتٍيَ شَ قٍ رَ.</para>
  <para style="q" vid="PSA 119:149">عَلَتَلَ، ﭑ نَكِسِ عِ شَ كِيتِ بّرّ رَ.<verse eid="PSA 119:149"/></para>
  <para style="q">
    <verse number="150" style="v" sid="PSA 119:150"/>مِشِيٍ بَرَ مَسٌ ﭑ نَ،</para>
  <para style="q" vid="PSA 119:150">نَشٍيٍ وَ مَ قٍ حَاشِيٍ شْن.</para>
  <para style="q" vid="PSA 119:150">عٍ مَكُيَ عِ شَ سّرِيّ رَ.<verse eid="PSA 119:150"/></para>
  <para style="q">
    <verse number="151" style="v" sid="PSA 119:151"/>كْنْ عِ تَن عَلَتَلَ، عِ مَكْرّ ﭑ نَ،</para>
  <para style="q" vid="PSA 119:151">عِ شَ يَامَرِيٍ قِندِشِ نْندِ نَن نَ.<verse eid="PSA 119:151"/></para>
  <para style="q">
    <verse number="152" style="v" sid="PSA 119:152"/>ﭑ عَ كٌلٌن كَبِ عَ رَكُيَ،</para>
  <para style="q" vid="PSA 119:152">عِ بَرَ عِ شَ مَسٍنيِ مَبَنبَن عَلَكٌ عَ شَ بُ عَبَدَن.<verse eid="PSA 119:152"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="153" style="v" sid="PSA 119:153"/>ﭑ مَ تْورّ مَتٌ، عِ شَ ﭑ نَكِسِ،</para>
  <para style="q" vid="PSA 119:153">بَرِ مَ ﭑ مُ نّيمُشِ عِ شَ سّرِيّ مَ.<verse eid="PSA 119:153"/></para>
  <para style="q">
    <verse number="154" style="v" sid="PSA 119:154"/>عِ شَ ﭑ شُن مَقَلَ، عِ شَ ﭑ شُن سَرَ.</para>
  <para style="q" vid="PSA 119:154">ﭑ نَكِسِ عَلْ عِ عَ لَايِدِ كِ نَشّ.<verse eid="PSA 119:154"/></para>
  <para style="q">
    <verse number="155" style="v" sid="PSA 119:155"/>كِسِ مَكُيَ مِشِ حَاشِيٍ رَ،</para>
  <para style="q" vid="PSA 119:155">بَرِ مَ عٍ مُ بِرَ مَ عِ شَ يَامَرِيٍ قْشْ رَ.<verse eid="PSA 119:155"/></para>
  <para style="q">
    <verse number="156" style="v" sid="PSA 119:156"/>عَلَتَلَ، عِ شَ كِنِكِنِ فبٌ.</para>
  <para style="q" vid="PSA 119:156">ﭑ نَكِسِ عِ شَ كِيتِ بّرّ رَ.<verse eid="PSA 119:156"/></para>
  <para style="q">
    <verse number="157" style="v" sid="PSA 119:157"/>ﭑ فٍرٍقَيٍ وُيَ،</para>
  <para style="q" vid="PSA 119:157">كْنْ ﭑ مُ فبِلٍن عِ سَفٌ قْشْ رَ.<verse eid="PSA 119:157"/></para>
  <para style="q">
    <verse number="158" style="v" sid="PSA 119:158"/>عِ يَنقَمَيٍ تٌقٍ رَحَاشُ ﭑ مَ،</para>
  <para style="q" vid="PSA 119:158">بَرِ مَ عٍ مُ عِ شَ مَسٍنيِ سُشُمَ.<verse eid="PSA 119:158"/></para>
  <para style="q">
    <verse number="159" style="v" sid="PSA 119:159"/>عَ مَتٌ، عِ شَ يَامَرِيٍ رَقَن ﭑ مَ.</para>
  <para style="q" vid="PSA 119:159">عَلَتَلَ، ﭑ نَكِسِ عِ شَ شَنُنتٍيَ شَ قٍ رَ.<verse eid="PSA 119:159"/></para>
  <para style="q">
    <verse number="160" style="v" sid="PSA 119:160"/>عِ شَ مَسٍنيِ نْندِ نَ عَ رَ،</para>
  <para style="q" vid="PSA 119:160">عِ شَ كِيتِ تِنشِنشِ بُمَ نّ عَبَدَن.<verse eid="PSA 119:160"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="161" style="v" sid="PSA 119:161"/>مَنفّيٍ ﭑ تْورْ مَ هَلِ ﭑ مُ قٍ حَاشِ يٌ رَبَشِ عٍ رَ،</para>
  <para style="q" vid="PSA 119:161">كْنْ ﭑ فَاشُمَ عِ شَ مَسٍنيِ يَ رَ ﭑ بْحّ بِرِن نَ.<verse eid="PSA 119:161"/></para>
  <para style="q">
    <verse number="162" style="v" sid="PSA 119:162"/>ﭑ سّيوَشِ عِ شَ لَايِدِ رَ،</para>
  <para style="q" vid="PSA 119:162">عَلْ مِشِ نَشَن فٍينِ شُنفبٍ سْتْشِ.<verse eid="PSA 119:162"/></para>
  <para style="q">
    <verse number="163" style="v" sid="PSA 119:163"/>ﭑ وُلٍ شْنشِ، عَ رَحَاشُ ﭑ مَ،</para>
  <para style="q" vid="PSA 119:163">كْنْ عِ شَ سّرِيّ ﭑ شَنُنتٍنيِ نَ عَ رَ.<verse eid="PSA 119:163"/></para>
  <para style="q">
    <verse number="164" style="v" sid="PSA 119:164"/>ﭑ عِ مَتْشْمَ سَنمَيَ سٌلٌقٍرٍ لْشْ يٌ لْشْ</para>
  <para style="q" vid="PSA 119:164">عِ شَ كِيتِ تِنشِنشِ شَ قٍ رَ.<verse eid="PSA 119:164"/></para>
  <para style="q">
    <verse number="165" style="v" sid="PSA 119:165"/>بْحّسَ فبٍفبٍ نَن نَ مِشِيٍ بّ،</para>
  <para style="q" vid="PSA 119:165">عِ شَ سّرِيّ رَقَنشِ نَشٍيٍ مَ.</para>
  <para style="q" vid="PSA 119:165">قٍقٍ مُ عٍ رَبِرَ مَ.<verse eid="PSA 119:165"/></para>
  <para style="q">
    <verse number="166" style="v" sid="PSA 119:166"/>عَلَتَلَ، ﭑ شَشِلِ تِشِ عِ شَ كِسِ رَ،</para>
  <para style="q" vid="PSA 119:166">ﭑ بِرَ مَ نّ عِ شَ يَامَرِيٍ قْشْ رَ.<verse eid="PSA 119:166"/></para>
  <para style="q">
    <verse number="167" style="v" sid="PSA 119:167"/>ﭑ عِ شَ مَسٍنيِ سُشُمَ نّ،</para>
  <para style="q" vid="PSA 119:167">بَرِ مَ عٍ رَقَن ﭑ مَ كِ قَنيِ رَ.<verse eid="PSA 119:167"/></para>
  <para style="q">
    <verse number="168" style="v" sid="PSA 119:168"/>ﭑ بِرَ مَ نّ عِ سَفٌ نُن عِ شَ مَسٍنيِ قْشْ رَ.</para>
  <para style="q" vid="PSA 119:168">عِ ﭑ حّرّ كِ بِرِن كٌلٌن.<verse eid="PSA 119:168"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="169" style="v" sid="PSA 119:169"/>عَلَتَلَ، عِ شَ ﭑ مَ دُبَ سُشُ.</para>
  <para style="q" vid="PSA 119:169">قَهَامُي قِ ﭑ مَ عِ شَ مَسٍنيِ سَابُي رَ.<verse eid="PSA 119:169"/></para>
  <para style="q">
    <verse number="170" style="v" sid="PSA 119:170"/>ﭑ مَ مَشَندِ شَ عِ لِ.</para>
  <para style="q" vid="PSA 119:170">ﭑ نَكِسِ عَلْ عِ عَ لَايِدِ كِ نَشّ.<verse eid="PSA 119:170"/></para>
  <para style="q">
    <verse number="171" style="v" sid="PSA 119:171"/>عِ مَتْشْي شَ مِنِ ﭑ دّ عِ،</para>
  <para style="q" vid="PSA 119:171">بَرِ مَ عِ ﭑ شَرَنقٍ عِ شَ يَامَرِيٍ نَن نَ.<verse eid="PSA 119:171"/></para>
  <para style="q">
    <verse number="172" style="v" sid="PSA 119:172"/>ﭑ دّ شَ بّيتِ ندٍ بَ عِ شَ مَسٍنيِ شَ قٍ رَ،</para>
  <para style="q" vid="PSA 119:172">بَرِ مَ عِ شَ يَامَرِيٍ بِرِن تِنشِن.<verse eid="PSA 119:172"/></para>
  <para style="q">
    <verse number="173" style="v" sid="PSA 119:173"/>عِ شَ قَ ﭑ دّ مّن،</para>
  <para style="q" vid="PSA 119:173">بَرِ مَ ﭑ عِ سَفٌ نَن سُفَندِشِ.<verse eid="PSA 119:173"/></para>
  <para style="q">
    <verse number="174" style="v" sid="PSA 119:174"/>عَلَتَلَ، ﭑ نِي نَ عِ شَ كِسِ مَ،</para>
  <para style="q" vid="PSA 119:174">عِ شَ سّرِيّ ﭑ نَسّيوَ مَ نّ.<verse eid="PSA 119:174"/></para>
  <para style="q">
    <verse number="175" style="v" sid="PSA 119:175"/>عِ شَ ﭑ نَكِسِ عَلَكٌ ﭑ شَ نْ عِ مَتْشْدٍ.</para>
  <para style="q" vid="PSA 119:175">عِ شَ كِيتِيٍ شَ ﭑ دّ مّن.<verse eid="PSA 119:175"/></para>
  <para style="q">
    <verse number="176" style="v" sid="PSA 119:176"/>ﭑ نَبّحِنشِ نّ عَلْ يّشّ لْيشِ.</para>
  <para style="q" vid="PSA 119:176">عِ شَ ﭑ تَن عِ شَ كٌنيِ قٍن،</para>
  <para style="q" vid="PSA 119:176">بَرِ مَ ﭑ مُ نّيمُشِ عِ شَ يَامَرِيٍ مَ.<verse eid="PSA 119:176"/></para>
  <chapter eid="PSA 119"/>
  <chapter number="120" style="c" sid="PSA 120"/>
  <para style="s1">رَتَنفَقٍ فٍرٍ مَ</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 120:1"/>بِيَاسِلَيٍ شَ بّيتِ ندٍ</para>
  <para style="q" vid="PSA 120:1">ﭑ نَ عَلَتَلَ مَشَندِ ﭑ مَ تْورّ كُي،</para>
  <para style="q" vid="PSA 120:1">عَ ﭑ يَابِمَ نّ.<verse eid="PSA 120:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 120:2"/>عَلَتَلَ، ﭑ نَتَنفَ وُلٍ قَلّيٍ دّ مَ،</para>
  <para style="q" vid="PSA 120:2">نَشٍيٍ مِشِيٍ مَدَشُمَ.<verse eid="PSA 120:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 120:3"/>مِشِ مَدَشُي، عَ قَمَ مُنسٍ رَبَدٍ؟<verse eid="PSA 120:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 120:4"/>عَ قَمَ سْشْي نَن تِدٍ تَنبّ رَلُفَنشِيٍ رَ،</para>
  <para style="q" vid="PSA 120:4">عَ قَمَ فَنيِ تِدٍ تّ وٌلٍيٍ رَ.<verse eid="PSA 120:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 120:5"/>عَ شْرْشْ ﭑ بّ لُقٍ رَ مٍسٍكِ بْشِ مَ،</para>
  <para style="q" vid="PSA 120:5">عَ شْرْشْ ﭑ بّ لُقٍ رَ كٍدَرِ بْنسْي يَ مَ.<verse eid="PSA 120:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 120:6"/>ﭑ بَرَ بُ يِ مِشِيٍ يَ مَ، نَشٍيٍ بْحّسَ شْنشِ.<verse eid="PSA 120:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 120:7"/>ﭑ تَن نَ بْحّسَ نَن بّ،</para>
  <para style="q" vid="PSA 120:7">كْنْ ﭑ نّقّ وْيّن، عٍ تَن وَ مَ فٍرٍ نَن شْن مَ.<verse eid="PSA 120:7"/></para>
  <chapter eid="PSA 120"/>
  <chapter number="121" style="c" sid="PSA 121"/>
  <para style="s1">دّ مّرِ كٍلِمَ عَلَ مَ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 121:1"/>بِيَاسِلَيٍ شَ بّيتِ ندٍ</para>
  <para style="q" vid="PSA 121:1">ﭑ نَ ﭑ يَ رَتٍمَ فٍيَيٍ مَبِرِ.</para>
  <para style="q" vid="PSA 121:1">ﭑ مَ دّ مّرِ كٍلِمَ مِندٍن؟<verse eid="PSA 121:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 121:2"/>ﭑ مَ دّ مّرِ قَتَنمَ عَلَتَلَ نَن نَ،</para>
  <para style="q" vid="PSA 121:2">نَشَن كٌورٍ نُن بْشِ دَاشِ.<verse eid="PSA 121:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 121:3"/>عَ مُ تِنمَ عِ شَ بِرَ.</para>
  <para style="q" vid="PSA 121:3">عَ عِ كَنتَمَ، عَ مُ كِنسْنمَ.<verse eid="PSA 121:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 121:4"/>عِسِرَيِلَ كَنتَمَ مُ كِنسْنمَ، عَ مُ شِمَ.<verse eid="PSA 121:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 121:5"/>عَلَتَلَ نَن عِ كَنتَمَ.</para>
  <para style="q" vid="PSA 121:5">عَ قِندِشِ نِينِ نَن نَ عِ بّ،<verse eid="PSA 121:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 121:6"/>عَلَكٌ سٌفٍ نَشَ عِ تْورْ يَنيِ رَ،</para>
  <para style="q" vid="PSA 121:6">كِكٍ نَشَ عِ تْورْ كْي رَ.<verse eid="PSA 121:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 121:7"/>عَلَتَلَ عِ رَتَنفَمَ نّ تْورّ بِرِن مَ،</para>
  <para style="q" vid="PSA 121:7">عَ عِ نِي مَكَنتَمَ.<verse eid="PSA 121:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 121:8"/>عِ نَ مِنِ، عَلَتَلَ لُمَ نّ عِ سّيتِ مَ.</para>
  <para style="q" vid="PSA 121:8">عِ نَ سٌ، عَلَتَلَ بِرَ مَ نّ عِ قْشْ رَ.</para>
  <para style="q" vid="PSA 121:8">عَ نَ عِ سّيتِ مَ يَكْسِ، عَ نَ عِ سّيتِ مَ عَبَدَن.<verse eid="PSA 121:8"/></para>
  <chapter eid="PSA 121"/>
  <chapter number="122" style="c" sid="PSA 122"/>
  <para style="s1">بْحّسَ شَ لُ دَرِ سَلَمُ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 122:1"/>بِيَاسِلَيٍ شَ بّيتِ ندٍ دَوُدَ نَشَن سّبّ</para>
  <para style="q" vid="PSA 122:1">ﭑ بَرَ سّيوَ ﭑ بِيَاسِ بٌورٍيٍ شَ وْيّنيِ مَ، عَ قَلَقٍ رَ،</para>
  <para style="q" vid="PSA 122:1">«وٌن شّي عَلَتَلَ شَ بَنشِ!»<verse eid="PSA 122:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PSA 122:2"/>«يَكْسِ مُشُ سَنيِيٍ تِشِ عِ تَن دَرِ سَلَمُ سٌدٍ دّ رَ.»<verse eid="PSA 122:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 122:3"/>دَرِ سَلَمُ تَا نَ عَ رَ نَشَن تِشِ لَنيِ كُي.<verse eid="PSA 122:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 122:4"/>عَلَتَلَ شَ مِشِيٍ تٍمَ نّ نَا عٍ بْنسْي كِ مَ</para>
  <para style="q" vid="PSA 122:4">عَلَكٌ عٍ شَ عَلَتَلَ شِلِ مَتْشْ عَلْ عَ يَمَرِشِ كِ نَشّ.<verse eid="PSA 122:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 122:5"/>كِيتِسَ شَ كِبَنيِيٍ دْشْشِ مّننِ نّ،</para>
  <para style="q" vid="PSA 122:5">دَوُدَ بْنسْي شَ مَنفّ كِبَنيِيٍ.<verse eid="PSA 122:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 122:6"/>وٌ بْحّسَ مَشَندِ دَرِ سَلَمُ بّ!</para>
  <para style="q" vid="PSA 122:6">«عَلَ شَ عِ شَنُنتٍنيِيٍ رَتَنفَ قٍ شْرْشْي مَ.<verse eid="PSA 122:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 122:7"/>عَلَ شَ عَ نِيَ بْحّسَ شَ لُ عِ شَ تّتّ كُي.</para>
  <para style="q" vid="PSA 122:7">عَلَ شَ عِ رَتَنفَ فٍرٍ مَ.»<verse eid="PSA 122:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 122:8"/>ﭑ نفَشَكٍرٍنيِيٍ نُن ﭑ شَنُنتٍنيِيٍ شَ قٍ رَ،</para>
  <para style="q" vid="PSA 122:8">ﭑ عَ قَلَمَ نّ، «بْحّسَ شَ لُ وٌ بّ!<verse eid="PSA 122:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 122:9"/>ﭑ عِ شَ هّيرِ قٍنمَ نّ وٌن مَرِفِ عَلَتَلَ شَ هْرْ مْلِنفِرَ شَ قٍ رَ.»<verse eid="PSA 122:9"/></para>
  <chapter eid="PSA 122"/>
  <chapter number="123" style="c" sid="PSA 123"/>
  <para style="s1">عَلَ شَ كٌنيِيٍ</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 123:1"/>بِيَاسِلَيٍ شَ بّيتِ ندٍ</para>
  <para style="q" vid="PSA 123:1">ﭑ نَ ﭑ يَ رَتٍمَ عِ تَن نَن نَ،</para>
  <para style="q" vid="PSA 123:1">عِ تَن نَشَن مَ كِبَنيِ نَ كٌورٍ مَ.<verse eid="PSA 123:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 123:2"/>مُشُ يَيٍ تِشِ مُشُ مَرِفِ عَلَتَلَ نَن نَ عَ شَ كِنِكِنِ شَ قٍ رَ،</para>
  <para style="q" vid="PSA 123:2">عَلْ كٌنيِيٍ يَيٍ تِشِ عٍ مَرِفِ رَ كِ نَشّ.<verse eid="PSA 123:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 123:3"/>عَلَتَلَ، كِنِكِنِ مُشُ مَ،</para>
  <para style="q" vid="PSA 123:3">بَرِ مَ حَمَ بَرَ يٌ مُشُ مَ،<verse eid="PSA 123:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 123:4"/>يّتّ عِفبٌي بَرَ مُشُ مَبٍرٍ.<verse eid="PSA 123:4"/></para>
  <chapter eid="PSA 123"/>
  <chapter number="124" style="c" sid="PSA 124"/>
  <para style="s1">عَلَ شَ مَرَتَنفّ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 124:1"/>بِيَاسِلَيٍ شَ بّيتِ ندٍ دَوُدَ نَشَن سّبّ</para>
  <para style="q" vid="PSA 124:1">عِسِرَيِلَ حَمَ شَ عَ قَلَ؛</para>
  <para style="q" vid="PSA 124:1">شَ عَلَتَلَ مُ لُ وٌن سّيتِ مَ نُ،<verse eid="PSA 124:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 124:2"/>شَ عَلَتَلَ مُ وٌن مَلِ فٍرٍ كُي نُ،<verse eid="PSA 124:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 124:3"/>نَ فٍرٍقَيٍ بَرَ وٌن شُن نَكَنَ عٍ شَ شْنّ رَ نُ،<verse eid="PSA 124:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 124:4"/>عَلْ بَنبَرَنيِ دِنمَ شُرٍ مَ كِ نَشّ،<verse eid="PSA 124:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 124:5"/>عَ قَ مِشِيٍ مَدُلَ يٍ شْورَ سّنبّ رَ.<verse eid="PSA 124:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 124:6"/>تَنتُي نَ عَلَتَلَ بّ،</para>
  <para style="q" vid="PSA 124:6">نَشَن مُ تِن عٍ شَ نْ وٌن نَ.<verse eid="PSA 124:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 124:7"/>وٌن بَرَ كِسِ عَلْ شْنِ نَشَن كِسِشِ فَنتَنيِ رَ.</para>
  <para style="q" vid="PSA 124:7">فَنتَنيِ بَرَ كَنَ، يّلّ بَرَ بْو عَ رَ،</para>
  <para style="q" vid="PSA 124:7">وٌن بَرَ عٍ لُ نَا.<verse eid="PSA 124:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 124:8"/>وٌن مَ دّ مّرِ نَ عَلَتَلَ شِلِ نَن نَ،</para>
  <para style="q" vid="PSA 124:8">نَشَن كٌورٍ نُن بْشِ دَاشِ.<verse eid="PSA 124:8"/></para>
  <chapter eid="PSA 124"/>
  <chapter number="125" style="c" sid="PSA 125"/>
  <para style="s1">عَلَتَلَ عَ شَ حَمَ رَبِلِنقٍ</para>
  <para style="s2">عَلَ شَ سّرِيّ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 125:1"/>بِيَاسِلَيٍ شَ بّيتِ ندٍ</para>
  <para style="q" vid="PSA 125:1">نَشٍيٍ عٍ شَشِلِ تِمَ عَلَتَلَ رَ،</para>
  <para style="q" vid="PSA 125:1">عٍ سّنبّ سْتْمَ نّ عَلْ سِيٌنِ فٍيَ</para>
  <para style="q" vid="PSA 125:1">نَشَن مُ سّرّنمَ، عَ بُ عَبَدَن.<verse eid="PSA 125:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 125:2"/>دَرِ سَلَمُ رَبِلِنشِ فٍيَيٍ رَ كِ نَشّ،</para>
  <para style="q" vid="PSA 125:2">عَلَتَلَ عَ شَ حَمَ قَن نَبِلِنشِ نَ كِ نّ عَبَدَن.<verse eid="PSA 125:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 125:3"/>مَنفَسَنيِ حَاشِ مُ تِنشِنتْي شَ بْشِ يَمَرِ مَ،</para>
  <para style="q" vid="PSA 125:3">عَلَكٌ تِنشِنتْي بّلّشّ نَشَ لَن قٍ حَاشِ.<verse eid="PSA 125:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 125:4"/>عَلَتَلَ، هِننّ مِشِ قَنيِيٍ رَ، نَشٍيٍ بْحّ قِيشّ،<verse eid="PSA 125:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 125:5"/>كْنْ عِ تَن عَلَتَلَ، عِ شَ تِنشِنتَرٍيٍ كٍرِ عٍ يُفٍ مَ.</para>
  <para style="b" vid="PSA 125:5"/>
  <para style="q" vid="PSA 125:5">عَلَ شَ بْحّسَ لُ عِسِرَيِلَ بْشِ مَ.<verse eid="PSA 125:5"/></para>
  <chapter eid="PSA 125"/>
  <chapter number="126" style="c" sid="PSA 126"/>
  <para style="s1">عَلَ مِشِ شْرّيَقٍ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 126:1"/>بِيَاسِلَيٍ شَ بّيتِ ندٍ</para>
  <para style="q" vid="PSA 126:1">عَلَتَلَ تٌ فٍيلِمَنِيٍ رَفبِلٍن سِيٌنِ،</para>
  <para style="q" vid="PSA 126:1">عَ لُ نّ مُشُ بّ عَلْ شِيٍ.<verse eid="PSA 126:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 126:2"/>مُشُ نَشَ يٍلٍ، مُشُ نَشَ بّيتِ بَ سّيوّ رَ.</para>
  <para style="q" vid="PSA 126:2">سِيٍ نُ عَ قَلَمَ نّ عٍ بٌرٍ بّ،</para>
  <para style="q" vid="PSA 126:2">«عَلَتَلَ بَرَ كَابَنَكٌي رَبَ يِيٍ بّ.»<verse eid="PSA 126:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 126:3"/>عِيٌ، عَلَتَلَ بَرَ كَابَنَكٌي رَبَ مُشُ بّ،</para>
  <para style="q" vid="PSA 126:3">مُشُ سّيوَشِ كِ قَنيِ رَ.<verse eid="PSA 126:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 126:4"/>عَلَتَلَ، مُشُ هَرِفٍ رَفبِلٍن مُشُ مَ</para>
  <para style="q" vid="PSA 126:4">عَلْ يٍ رَفبِلٍنمَ نٍفٍوِ بْشِ شُرٍ شْرِشِيٍ رَ كِ نَشّ.<verse eid="PSA 126:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 126:5"/>مِشِ نَشٍيٍ شّ سَمَ يَيٍ رَ،</para>
  <para style="q" vid="PSA 126:5">عٍ قَمَ نّ عَ شَبَدٍ سّيوّ كُي.<verse eid="PSA 126:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 126:6"/>مِشِ نَشَن سِفَمَ سَنسِ سِدٍ، عٍ نَ وَقٍ،</para>
  <para style="q" vid="PSA 126:6">نَ مِشِ فبِلٍنمَ نّ بَلٌي رَ، عَ سّيوَشِ.<verse eid="PSA 126:6"/></para>
  <chapter eid="PSA 126"/>
  <chapter number="127" style="c" sid="PSA 127"/>
  <para style="s1">عَلَ نَن بَنشِ تِقٍ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 127:1"/>بِيَاسِلَيٍ شَ بّيتِ ندٍ سُلٍمَنِ نَشَن بَ</para>
  <para style="q" vid="PSA 127:1">شَ عَلَتَلَ شَ مُ بَنشِ تِ، عَ تِمَيٍ وَلِمَ نّ قُقَقُ.</para>
  <para style="q" vid="PSA 127:1">شَ عَلَتَلَ شَ مُ تَا مَكَنتَمَ، عَ كَنتَمَيٍ وَلِمَ نّ قُقَقُ.<verse eid="PSA 127:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 127:2"/>وٌ كٍلِمَ سُبَشّ مَ، وٌ وَلِمَ هَن كْي رَ بَلٌي سْتْقٍ رَ.</para>
  <para style="q" vid="PSA 127:2">نَ كُي وٌ وَلِمَ تُن.</para>
  <para style="q" vid="PSA 127:2">كْنْ عَلَ عَ شَنُنتٍنيِيٍ مَن كِمَ عٍ سَ تّمُي.<verse eid="PSA 127:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 127:3"/>دِيٍ قِندِ مَ نّ كّ رَ مِشِ بّ عَلَتَلَ نَشَن كِمَ،</para>
  <para style="q" vid="PSA 127:3">قٍ قَنيِ سَرٍ نَن عٍ رَ، نَشٍيٍ كٍلِمَ عَ تَن مَ.<verse eid="PSA 127:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 127:4"/>دِيٍ نَشٍيٍ سْتْشِ قٌنِكٍ تّمُي،</para>
  <para style="q" vid="PSA 127:4">نٍيٍ تِدٍ لُمَ نّ عَلْ سْورِيٍ شَ شَلِيٍ.<verse eid="PSA 127:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 127:5"/>بَرَكّ نَ مِشِ بّ نَشَن شَ شَلِ سَسٍ رَقٍشِ.</para>
  <para style="q" vid="PSA 127:5">عَ يَشُييٍ مُ نْمَ عَ رَيَافِدٍ حَمَ يَ عِ.<verse eid="PSA 127:5"/></para>
  <chapter eid="PSA 127"/>
  <chapter number="128" style="c" sid="PSA 128"/>
  <para style="s1">دِ قِندِشِ بَرَكَ نَن نَ</para>
  <para style="s2">عَلَ شَ سّرِيّ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 128:1"/>بِيَاسِلَيٍ شَ بّيتِ ندٍ</para>
  <para style="q" vid="PSA 128:1">سّيوّ نَ عَلَتَلَ شَ يَرَفَاشُي نَن بّ،</para>
  <para style="q" vid="PSA 128:1">نَشَن حّرّ مَ عَ شَ كِرَ شْن مَ.<verse eid="PSA 128:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 128:2"/>عِ شَ وَلِ فٍينِ لُمَ عِ تَن نَن بّ،</para>
  <para style="q" vid="PSA 128:2">عَ قِندِ سّيوّ نُن هَرِفٍ رَ عِ بّ.<verse eid="PSA 128:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 128:3"/>عِ شَ فِنّ لُمَ نّ عَلْ وُرِ بٌفِلَ عِ شَ بَنشِ كُي،</para>
  <para style="q" vid="PSA 128:3">عِ شَ دِيٍ لُمَ نّ عَلْ وُرِ نّينّيٍ عِ شَ تٍيبِلِ سّيتِ مَ.<verse eid="PSA 128:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 128:4"/>عَ نَ نَ كِ نّ عَلَتَلَ شَ يَرَفَاشُي بّ،</para>
  <para style="q" vid="PSA 128:4">عَ بَرَكَشِ.<verse eid="PSA 128:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 128:5"/>عَلَتَلَ شَ عِ بَرَكَ كٍلِقٍ سِيٌنِ.</para>
  <para style="q" vid="PSA 128:5">عِ شَ دَرِ سَلَمُ هَرِفٍ تٌ عِ شَ سِمَيَ بِرِن كُي.<verse eid="PSA 128:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 128:6"/>عِ شَ عِ شَ دِيٍ شَ دِيٍ تٌ.</para>
  <para style="b" vid="PSA 128:6"/>
  <para style="q" vid="PSA 128:6">عَلَ شَ بْحّسَ لُ عِسِرَيِلَ بْشِ مَ.<verse eid="PSA 128:6"/></para>
  <chapter eid="PSA 128"/>
  <chapter number="129" style="c" sid="PSA 129"/>
  <para style="s1">عَلَ شُننَكٍلِ قِقٍ تْورْ مِشِ مَ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 129:1"/>بِيَاسِلَيٍ شَ بّيتِ ندٍ</para>
  <para style="q" vid="PSA 129:1">عِسِرَيِلَ شَ عَ قَلَ؛</para>
  <para style="q" vid="PSA 129:1">ﭑ فٍرٍقَيٍ بَرَ ﭑ تْورْ كَبِ ﭑ قٌنِكٍ تّمُي.<verse eid="PSA 129:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 129:2"/>عٍ بَرَ ﭑ تْورْ عَ حَاشِ رَ كَبِ عَ قْلّ،</para>
  <para style="q" vid="PSA 129:2">كْنْ عٍ مُ نْ ﭑ نَ.<verse eid="PSA 129:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 129:3"/>عٍ بَرَ ﭑ قَرِ عِبْو عَلْ شّ سَيٍ بْشِ بْو مَ كِ نَشّ.<verse eid="PSA 129:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 129:4"/>كْنْ عَلَتَلَ تِنشِن.</para>
  <para style="q" vid="PSA 129:4">عَ بَرَ مِشِ كٌبِيٍ شَ لُوتِ شِرِشِيٍ بٌلٌن.<verse eid="PSA 129:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 129:5"/>عَلَ شَ سِيٌنِ شْنمِشِيٍ رَيَافِ.<verse eid="PSA 129:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 129:6"/>عَلَ شَ عٍ لُ عَلْ بَنشِ قَرِ حٌوفٍ،</para>
  <para style="q" vid="PSA 129:6">نَشَن شَرَ مَ بٍينُن عَ شَ تَلَ،<verse eid="PSA 129:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 129:7"/>نَشَن مُ قِندِ مَ بَلٌي رَ شّ سَيٍ بّ.<verse eid="PSA 129:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 129:8"/>دَنفِ مِشِيٍ نَشَ دُبَ وٌ بّ، عَ قَلَقٍ رَ،</para>
  <para style="q" vid="PSA 129:8">«عَلَ شَ وٌ بَرَكَ.</para>
  <para style="q" vid="PSA 129:8">مُشُ بَرَ دُبَ وٌ بّ عَلَتَلَ شِلِ رَ.»<verse eid="PSA 129:8"/></para>
  <chapter eid="PSA 129"/>
  <chapter number="130" style="c" sid="PSA 130"/>
  <para style="s1">عَلَتَلَ مَرَكِسِمَ</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 130:1"/>بِيَاسِلَيٍ شَ بّيتِ ندٍ</para>
  <para style="q" vid="PSA 130:1">عَلَتَلَ، ﭑ عِ شِلِمَ ﭑ مَ تْورّ تِلِنشِ نَن كُي.<verse eid="PSA 130:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 130:2"/>ﭑ مَرِفِ، عِ شَ عِ تُلِ مَتِ ﭑ شُي رَ،</para>
  <para style="q" vid="PSA 130:2">عِ شَ ﭑ مَ مَشَندِ رَ مّ كِنِكِنِ كُي.<verse eid="PSA 130:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 130:3"/>شَ عِ تَن عَلَتَلَ رَتُمَ مِشِيٍ شَ يُنُبِيٍ مَ،</para>
  <para style="q" vid="PSA 130:3">ندٍ نْمَ تِدٍ عِ يَ رَ سْنْن؟<verse eid="PSA 130:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 130:4"/>كْنْ عِ تَن يُنُبِيٍ شَقَرِ مَ نّ.</para>
  <para style="q" vid="PSA 130:4">نَ كُي مِشِ فَاشُمَ نّ عِ يَ رَ.<verse eid="PSA 130:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 130:5"/>ﭑ شَشِلِ تِشِ عَلَتَلَ نَن نَ ﭑ نِي بِرِن نَ،</para>
  <para style="q" vid="PSA 130:5">ﭑ يَ تِشِ عَ شَ مَسٍنيِ نَن نَ.<verse eid="PSA 130:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 130:6"/>ﭑ شَشِلِ نَشَن تِشِ ﭑ مَرِفِ رَ،</para>
  <para style="q" vid="PSA 130:6">نَ دَنفِ تَا مَكَنتّ شَ مَمّ تِ رَ كُيٍ عِبَ رَ.</para>
  <para style="q" vid="PSA 130:6">عَ فبٌ نَ بّ.<verse eid="PSA 130:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 130:7"/>عِسِرَيِلَ، عِ شَ عِ شَشِلِ تِ عَلَتَلَ رَ،</para>
  <para style="q" vid="PSA 130:7">بَرِ مَ عِ شَ شَنُنتٍيَ نَ عَ بْحّ كُي،</para>
  <para style="q" vid="PSA 130:7">عَ عِ شُنسَرٍ بِرِن قِمَ نّ.<verse eid="PSA 130:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 130:8"/>عَ تَن نَن عِسِرَيِلَ شُن سَرَ مَ عَ شَ يُنُبِيٍ بِرِن مَ.<verse eid="PSA 130:8"/></para>
  <chapter eid="PSA 130"/>
  <chapter number="131" style="c" sid="PSA 131"/>
  <para style="s1">دَنشَنِيَتْي شَ مَرَشَرّ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 131:1"/>بِيَاسِلَيٍ شَ بّيتِ ندٍ دَوُدَ نَشَن بَ</para>
  <para style="q" vid="PSA 131:1">عَلَتَلَ، يّتّ عِفبٌي مُ ﭑ نَ،</para>
  <para style="q" vid="PSA 131:1">ﭑ مُ لَ ﭑ يّتّ رَ.</para>
  <para style="q" vid="PSA 131:1">ﭑ مُ سٌمَ قٍيٍ يَ مَ نَشٍيٍ سّنبّ فبٌ ﭑ بّ،</para>
  <para style="q" vid="PSA 131:1">نَشٍيٍ دَنفِ ﭑ مَ قَهَامُي رَ.<verse eid="PSA 131:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 131:2"/>ﭑ نَشَن نَبَشِ، ﭑ نَ ﭑ سَبَرِشِ نّ،</para>
  <para style="q" vid="PSA 131:2">ﭑ نَ ﭑ نِي رَشَرَ عَلْ دِ دّ بَشِ.<verse eid="PSA 131:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 131:3"/>عِسِرَيِلَ، عِ شَ عِ شَشِلِ تِ عَلَتَلَ رَ تّمُي بِرِن.<verse eid="PSA 131:3"/></para>
  <chapter eid="PSA 131"/>
  <chapter number="132" style="c" sid="PSA 132"/>
  <para style="s1">عَلَ شَ لَايِدِ دَوُدَ نُن دَرِ سَلَمُ بّ</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 132:1"/>بِيَاسِلَيٍ شَ بّيتِ ندٍ</para>
  <para style="q" vid="PSA 132:1">عَلَتَلَ، عِ شَ رَتُ دَوُدَ مَ</para>
  <para style="q" vid="PSA 132:1">عَ نُن عَ شَ تْورّ بِرِن مَ.<verse eid="PSA 132:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PSA 132:2"/>عَ نَشَ عَ رَكَلِ عَلَتَلَ بّ،</para>
  <para style="q" vid="PSA 132:2">عَ نَشَ عَ رَكَلِ يَشُبَ مَرِفِ عَلَ سّنبّمَ بّ،<verse eid="PSA 132:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 132:3"/>«ﭑ مُ سٌمَ ﭑ شْنيِ، ﭑ مُ ﭑ سَمَ،<verse eid="PSA 132:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 132:4"/>ﭑ مُ ﭑ يَ مَشِمَ،</para>
  <para style="q" vid="PSA 132:4">ﭑ مُ ﭑ يَ مَفِرَ مَ،<verse eid="PSA 132:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 132:5"/>هَن ﭑ سَ لِنفِرَ سْتْمَ يَشُبَ مَرِفِ عَلَ سّنبّمَ بّ تّمُي نَشّ.»<verse eid="PSA 132:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 132:6"/>وٌن نُ بَرَ عَ شَ قٍ مّ عٍقَرَتَ بْشِ مَ.</para>
  <para style="q" vid="PSA 132:6">وٌن نَشَ عَ لِ يَارَ شَ شّ مَ.<verse eid="PSA 132:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 132:7"/>«وٌن شّي عَ شَ هْرْ مْلِنفِرَ يِرٍ،</para>
  <para style="q" vid="PSA 132:7">وٌن شَ وٌن شِنبِ سِن عَ سَنتِدٍ يَ عِ.<verse eid="PSA 132:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 132:8"/>عَلَتَلَ، كٍلِ عِ شَ تَلُ عِ سَبَتِدٍ،</para>
  <para style="q" vid="PSA 132:8">عِ تَن نُن عِ شَ سَاتّ كَنكِرَ.<verse eid="PSA 132:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 132:9"/>عِ شَ سّرّشّدُبّيٍ شَ لُ شُننَكٍلِ كُي،</para>
  <para style="q" vid="PSA 132:9">عِ دُفُتّفّيٍ شَ عٍ سّيوّ شُي رَتٍ.»<verse eid="PSA 132:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 132:10"/>عِ شَ كٌنيِ دَوُدَ شَ قٍ رَ،</para>
  <para style="q" vid="PSA 132:10">عِ نَشَ مّي عِ شَ مَنفّ سُفَندِشِ رَ.<verse eid="PSA 132:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 132:11"/>عَلَتَلَ عَ كَلِ نّ دَوُدَ بّ،</para>
  <para style="q" vid="PSA 132:11">مَرَكَلِ نَشَن مُ كَنَمَ،</para>
  <para style="q" vid="PSA 132:11">عَ نَشّ، «ﭑ عِ بْنسْي ندٍ نَن دْشْمَ عِ شَ كِبَنيِ مَ.<verse eid="PSA 132:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 132:12"/>شَ عِ شَ دِيٍ سَ ﭑ مَ سَاتّ بِنيَ،</para>
  <para style="q" vid="PSA 132:12">عٍ ﭑ مَ يَامَرِيٍ رَبَتُ،</para>
  <para style="q" vid="PSA 132:12">عٍ شَ دِيٍ قَن لُمَ نّ عِ شَ كِبَنيِ مَ عَبَدَن.»<verse eid="PSA 132:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 132:13"/>بَرِ مَ عَلَتَلَ بَرَ سِيٌنِ سُفَندِ،</para>
  <para style="q" vid="PSA 132:13">مّننِ نَن نَقَنشِ عَ مَ عَ سَبَتِدٍ رَ.<verse eid="PSA 132:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 132:14"/>عَ نَشّ، «ﭑ سَبَتِدٍ نَن بٍ رَ عَبَدَن.</para>
  <para style="q" vid="PSA 132:14">ﭑ دْشْمَ بٍ ﭑ مَ كِبَنيِ كُي بَرِ مَ بٍ رَقَنشِ ﭑ مَ.<verse eid="PSA 132:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 132:15"/>ﭑ بَرَكّ سَمَ نّ سِيٌنِكَيٍ مَ،</para>
  <para style="q" vid="PSA 132:15">ﭑ بَلٌي قِ عٍ شَ مِسِكِينّيٍ مَ.<verse eid="PSA 132:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 132:16"/>ﭑ كِسِ قِمَ نّ عٍ شَ سّرّشّدُبّيٍ مَ،</para>
  <para style="q" vid="PSA 132:16">عٍ دُفُتّفّيٍ بّيتِ بَمَ نّ سّيوّ كُي.»<verse eid="PSA 132:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="PSA 132:17"/>«بٍ ﭑ دَوُدَ سّنبّ رَكٍلِمَ نّ،</para>
  <para style="q" vid="PSA 132:17">ﭑ نَءِيَلَنيِ رَ مِنِمَ نّ ﭑ مَ مِشِ سُفَندِشِ بّ.<verse eid="PSA 132:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 132:18"/>ﭑ يَافِ دُ سُمَ نّ عَ يَشُييٍ شُن نَ،</para>
  <para style="q" vid="PSA 132:18">كْنْ ﭑ نْرّ دُ سُمَ عَ تَن نَن شُن نَ.»<verse eid="PSA 132:18"/></para>
  <chapter eid="PSA 132"/>
  <chapter number="133" style="c" sid="PSA 133"/>
  <para style="s1">عَلَ شَ حَمَ شَ لَنيِ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 133:1"/>بِيَاسِلَيٍ شَ بّيتِ ندٍ دَوُدَ نَشَن بَ</para>
  <para style="q" vid="PSA 133:1">نفَشَكٍرٍنيِيٍ لَنمَ عٍ شَ لُ لَنيِ كُي.</para>
  <para style="q" vid="PSA 133:1">قٍ قَنيِ يَتِ يَتِ نَن نَ كِ.<verse eid="PSA 133:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 133:2"/>نَ قَن عَلْ تُرٍ نَشَن سُرُ سُرُ مَ هَرُنَ شُنيِ مَ،</para>
  <para style="q" vid="PSA 133:2">عَ قَ فٌرٌ عَ دّشَبٍ مَ،</para>
  <para style="q" vid="PSA 133:2">هَن عَ دُفِ لِ.<verse eid="PSA 133:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 133:3"/>نَ لُمَ نّ عَلْ شِنِ نَشَن فٌرٌ مَ شٍرِ مٌن نُن سِيٌنِ فٍيَيٍ مَ،</para>
  <para style="q" vid="PSA 133:3">بَرِ مَ عَلَتَلَ بَرَكّ نُن كِسِ رَفٌرٌ مَ نَا عَبَدَن.<verse eid="PSA 133:3"/></para>
  <chapter eid="PSA 133"/>
  <chapter number="134" style="c" sid="PSA 134"/>
  <para style="s1">دُبَ سّرّشّدُبّ بّ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 134:1"/>بِيَاسِلَيٍ شَ بّيتِ ندٍ</para>
  <para style="q" vid="PSA 134:1">وٌ تَن عَلَتَلَ شَ كٌنيِيٍ،</para>
  <para style="q" vid="PSA 134:1">وٌ شَ عَلَتَلَ مَتْشْ،</para>
  <para style="q" vid="PSA 134:1">وٌ تَن نَشٍيٍ وَلِمَ كْي رَ عَلَتَلَ شَ هْرْ مْبَنشِ كُي.<verse eid="PSA 134:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 134:2"/>وٌ شَ وٌ بّلّشّ عِتٍ هْرْ مْبَنشِ كُي عَلَتَلَ مَتْشْقٍ رَ.<verse eid="PSA 134:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 134:3"/>عَلَتَلَ نَشَن كٌورٍ نُن بْشِ دَا،</para>
  <para style="q" vid="PSA 134:3">عَ شَ بَرَكّ سَ وٌ مَ كٍلِقٍ سِيٌنِ.<verse eid="PSA 134:3"/></para>
  <chapter eid="PSA 134"/>
  <chapter number="135" style="c" sid="PSA 135"/>
  <para style="s1">عِسِرَيِلَ شَ مَتْشْي</para>
  <para style="s2">عَلَتَلَ مَتْشْي</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 135:1"/>وٌ مَرِفِ عَلَتَلَ مَتْشْ،</para>
  <para style="q" vid="PSA 135:1">وٌ عَ شِلِ مَتْشْ.</para>
  <para style="q" vid="PSA 135:1">عَلَتَلَ شَ كٌنيِيٍ، وٌ شَ عَ مَتْشْ،<verse eid="PSA 135:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 135:2"/>وٌ تَن نَشٍيٍ وَلِمَ عَلَتَلَ شَ هْرْ مْبَنشِ كُي،</para>
  <para style="q" vid="PSA 135:2">وٌن تَن نَشٍيٍ وَلِمَ عَلَ شَ بَنشِ تّتّ كُي.<verse eid="PSA 135:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 135:3"/>وٌ شَ عَلَتَلَ مَتْشْ، بَرِ مَ عَ قَن.</para>
  <para style="q" vid="PSA 135:3">وٌ شَ بّيتِ بَ عَ شِلِ مَتْشْقٍ رَ،</para>
  <para style="q" vid="PSA 135:3">بَرِ مَ عَ رَقَن عَ مَ.<verse eid="PSA 135:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 135:4"/>عَلَتَلَ بَرَ يَشُبَ سُفَندِ عَ يّتّ بّ،</para>
  <para style="q" vid="PSA 135:4">عَلَكٌ عِسِرَيِلَ شَ قِندِ عَ شَ حَمَ قَنيِ رَ.<verse eid="PSA 135:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 135:5"/>ﭑ تَن عَ كٌلٌن عَ عَلَتَلَ فبٌ،</para>
  <para style="q" vid="PSA 135:5">وٌن مَرِفِ دَنفِ عَلَيٍ بِرِن نَ.<verse eid="PSA 135:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 135:6"/>عَلَتَلَ عَ وَشْنقٍ رَبَمَ نّ كٌورٍ نُن بْشِ مَ،</para>
  <para style="q" vid="PSA 135:6">عَ عَ رَبَمَ نّ بَا تِلِنشِيٍ مَ.<verse eid="PSA 135:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 135:7"/>عَ نُشُييٍ رَتٍمَ كٍلِ دُنِحَ تُنشُنيِ نَانِ مَ،</para>
  <para style="q" vid="PSA 135:7">عَ تُنّ رَقَ نُن سٍيَمَكْنيِ،</para>
  <para style="q" vid="PSA 135:7">عَ قٌيٍ شُنفبٍ رَ مِنِ عَ رَفَتَدٍ كُي.<verse eid="PSA 135:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 135:8"/>عَ مِسِرَ دِ سِنفٍيٍ بِرِن قَشَ،</para>
  <para style="q" vid="PSA 135:8">كٍلِ مِشِيٍ مَ هَن عَ سَ شُرُ سٍيٍ لِ.<verse eid="PSA 135:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 135:9"/>عَ نَشَ تْنشُمَيٍ نُن كَابَنَكٌي رَبَ مِسِرَ،</para>
  <para style="q" vid="PSA 135:9">قِرَوُنَ نُن عَ شَ وَلِكّيٍ بِرِن شِلِ مَ.<verse eid="PSA 135:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 135:10"/>عَ نَشَ سِيٍ وُيَشِ بْنبْ،</para>
  <para style="q" vid="PSA 135:10">عَ مَنفّ سّنبّمَ فبٍفبٍ قَشَ.<verse eid="PSA 135:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 135:11"/>عَ نَشَ عَمٌرِكَيٍ شَ مَنفّ سِشْن،</para>
  <para style="q" vid="PSA 135:11">بَسَن مَنفّ عٌفٌ، نُن كَنَان مَنفّ بِرِن شَ بْشِ تٌنفٌ،<verse eid="PSA 135:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 135:12"/>عَ نَشَ عَ قِ عَ شَ حَمَ عِسِرَيِلَ مَ كّ رَ.<verse eid="PSA 135:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 135:13"/>عَلَتَلَ، عِ شِلِ مُ لْيمَ عَبَدَن،</para>
  <para style="q" vid="PSA 135:13">عِ شِلِ عِقَلَمَ نّ تّمُي بِرِن،<verse eid="PSA 135:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 135:14"/>بَرِ مَ عَلَتَلَ قَمَ نّ عَ شَ حَمَ فبٍحْشْدٍ،</para>
  <para style="q" vid="PSA 135:14">عَ قَ كِنِكِنِ عَ شَ كٌنيِيٍ مَ.<verse eid="PSA 135:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PSA 135:15"/>سِ نَشٍيٍ مُ عَلَ كٌلٌن،</para>
  <para style="q" vid="PSA 135:15">عٍ كُيٍيٍ يَءِلَنمَ شّيمَ نُن فبٍتِ نَن نَ عٍ بّلّشّيٍ رَ.<verse eid="PSA 135:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 135:16"/>دّ نَ نَ كُيٍيٍ بّ، كْنْ عٍ مُ وْيّنمَ.</para>
  <para style="q" vid="PSA 135:16">يَيٍ نَ عٍ بّ، كْنْ عٍ مُ سٍ تٌمَ.<verse eid="PSA 135:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 135:17"/>تُلِيٍ نَ عٍ بّ، كْنْ عٍ مُ قٍ مّمَ.</para>
  <para style="q" vid="PSA 135:17">حّنفِ يٌ مُ عٍ قَتٍ عِ.<verse eid="PSA 135:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 135:18"/>عٍ رَقَلَمَيٍ شَ لُ عَلْ عٍ تَن،</para>
  <para style="q" vid="PSA 135:18">عَ نُن نَشٍيٍ بِرِن لَمَ عٍ رَ.<verse eid="PSA 135:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PSA 135:19"/>عِسِرَيِلَكَيٍ، وٌ تَن شَ عَلَتَلَ تَنتُ.</para>
  <para style="q" vid="PSA 135:19">هَرُنَ بْنسْي، وٌ شَ عَلَتَلَ تَنتُ.<verse eid="PSA 135:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 135:20"/>لٍوِ بْنسْي، وٌ شَ عَلَتَلَ تَنتُ.</para>
  <para style="q" vid="PSA 135:20">وٌ تَن عَلَ يَرَفَاشُييٍ، وٌ شَ عَلَتَلَ تَنتُ.<verse eid="PSA 135:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 135:21"/>تَنتُي نَ عَلَتَلَ بّ كٍلِقٍ سِيٌنِ.</para>
  <para style="q" vid="PSA 135:21">تَنتُي نَ عَلَتَلَ بّ نَشَن سَبَتِشِ دَرِ سَلَمُ.</para>
  <para style="q" vid="PSA 135:21">وٌ شَ عَلَتَلَ مَتْشْ!<verse eid="PSA 135:21"/></para>
  <chapter eid="PSA 135"/>
  <chapter number="136" style="c" sid="PSA 136"/>
  <para style="s1">تَنتُي نَ عَلَ بّ عَ شَ شَنُنتٍيَ شَ قٍ رَ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 136:1"/>وٌ عَلَتَلَ تَنتُ، بَرِ مَ عَ قَن،</para>
  <para style="q2" vid="PSA 136:1">دَن مُ نَ عَ شَ شَنُنتٍيَ مَ.<verse eid="PSA 136:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 136:2"/>وٌ عَلَتَلَ تَنتُ نَشَن دَنفِ عَلَيٍ بِرِن نَ،</para>
  <para style="q2" vid="PSA 136:2">بَرِ مَ دَن مُ نَ عَ شَ شَنُنتٍيَ مَ.<verse eid="PSA 136:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 136:3"/>وٌ مَرِفِيٍ شَ مَرِفِ تَنتُ،</para>
  <para style="q2" vid="PSA 136:3">بَرِ مَ دَن مُ نَ عَ شَ شَنُنتٍيَ مَ.<verse eid="PSA 136:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 136:4"/>وٌ شَ عَ تَن تَنتُ،</para>
  <para style="q" vid="PSA 136:4">عَ تَن نَشَن كٍرٍن كَابَنَكٌي رَبَمَ،</para>
  <para style="q2" vid="PSA 136:4">بَرِ مَ دَن مُ نَ عَ شَ شَنُنتٍيَ مَ،<verse eid="PSA 136:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 136:5"/>عَ تَن نَشَن كٌورٍ دَاشِ عَ شَ قَهَامُي رَ،</para>
  <para style="q2" vid="PSA 136:5">بَرِ مَ دَن مُ نَ عَ شَ شَنُنتٍيَ مَ،<verse eid="PSA 136:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 136:6"/>عَ تَن نَشَن بْشِ عِتَلَ يٍيٍ قَرِ،</para>
  <para style="q2" vid="PSA 136:6">بَرِ مَ دَن مُ نَ عَ شَ شَنُنتٍيَ مَ،<verse eid="PSA 136:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 136:7"/>عَ تَن نَشَن يَنبَ سٍ شُنفبٍيٍ دَاشِ،</para>
  <para style="q2" vid="PSA 136:7">بَرِ مَ دَن مُ نَ عَ شَ شَنُنتٍيَ مَ،<verse eid="PSA 136:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="PSA 136:8"/>سٌفٍ، عَلَكٌ عَ شَ يَنيِ عِيَلَن،</para>
  <para style="q2" vid="PSA 136:8">بَرِ مَ دَن مُ نَ عَ شَ شَنُنتٍيَ مَ،<verse eid="PSA 136:8"/></para>
  <para style="q2">
    <verse number="9" style="v" sid="PSA 136:9"/>كِكٍ نُن تُنبُييٍ، عَلَكٌ عٍ شَ كْي عِيَلَن،</para>
  <para style="q2" vid="PSA 136:9">بَرِ مَ دَن مُ نَ عَ شَ شَنُنتٍيَ مَ.<verse eid="PSA 136:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 136:10"/>وٌ شَ عَ تَن نَن تَنتُ،</para>
  <para style="q" vid="PSA 136:10">عَ تَن نَشَن مِسِرَكَيٍ شَ دِ سِنفٍيٍ قَشَ،</para>
  <para style="q2" vid="PSA 136:10">بَرِ مَ دَن مُ نَ عَ شَ شَنُنتٍيَ مَ،<verse eid="PSA 136:10"/></para>
  <para style="q">
    <verse number="11‏-12" style="v" sid="PSA 136:11-12"/>عَ تَن نَشَن عِسِرَيِلَ رَ مِنِ مِسِرَ بْشِ مَ عَ سّنبّ نُن عَ شَ نْي رَ،</para>
  <para style="q2" vid="PSA 136:11-12">بَرِ مَ دَن مُ نَ عَ شَ شَنُنتٍيَ مَ،<verse eid="PSA 136:11-12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 136:13"/>عَ تَن نَشَن شُلُنيُمِ بَا عِبٌلٌن قِرِن نَ،</para>
  <para style="q2" vid="PSA 136:13">بَرِ مَ دَن مُ نَ عَ شَ شَنُنتٍيَ مَ،<verse eid="PSA 136:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 136:14"/>عَ تَن نَشَن عِسِرَيِلَكَيٍ رَدَنفِ بَا تَفِ،</para>
  <para style="q2" vid="PSA 136:14">بَرِ مَ دَن مُ نَ عَ شَ شَنُنتٍيَ مَ،<verse eid="PSA 136:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 136:15"/>عَ تَن نَشَن قِرَوُنَ نُن عَ شَ حَمَ رَ سِن شُلُنيُمِ بَا شْورَ،</para>
  <para style="q2" vid="PSA 136:15">بَرِ مَ دَن مُ نَ عَ شَ شَنُنتٍيَ مَ.<verse eid="PSA 136:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="PSA 136:16"/>وٌ شَ عَ تَن نَن تَنتُ،</para>
  <para style="q" vid="PSA 136:16">عَ تَن نَشَن عَ شَ حَمَ رَدَنفِ فبٍنفبٍرٍنيِ رَ،</para>
  <para style="q2" vid="PSA 136:16">بَرِ مَ دَن مُ نَ عَ شَ شَنُنتٍيَ مَ،<verse eid="PSA 136:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 136:17"/>عَ تَن نَشَن مَنفّ شُنفبٍيٍ قَشَ،</para>
  <para style="q2" vid="PSA 136:17">بَرِ مَ دَن مُ نَ عَ شَ شَنُنتٍيَ مَ،<verse eid="PSA 136:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 136:18"/>عَ تَن نَشَن مَنفّ سّنبّمَيٍ قَشَ،</para>
  <para style="q2" vid="PSA 136:18">بَرِ مَ دَن مُ نَ عَ شَ شَنُنتٍيَ مَ،<verse eid="PSA 136:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 136:19"/>عَلْ عَمٌرِ مَنفّ سِشْن،</para>
  <para style="q2" vid="PSA 136:19">بَرِ مَ دَن مُ نَ عَ شَ شَنُنتٍيَ مَ،<verse eid="PSA 136:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 136:20"/>عَلْ بَسَن مَنفّ عٌفٌ،</para>
  <para style="q2" vid="PSA 136:20">بَرِ مَ دَن مُ نَ عَ شَ شَنُنتٍيَ مَ،<verse eid="PSA 136:20"/></para>
  <para style="q">
    <verse number="21‏-22" style="v" sid="PSA 136:21-22"/>عَ تَن نَشَن عٍ شَ بْشِ قِ عَ شَ كٌنيِ عِسِرَيِلَ مَ كّ رَ،</para>
  <para style="q" vid="PSA 136:21-22">بَرِ مَ دَن مُ نَ عَ شَ شَنُنتٍيَ مَ.<verse eid="PSA 136:21-22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="PSA 136:23"/>وٌ شَ عَ تَن نَن تَنتُ،</para>
  <para style="q" vid="PSA 136:23">عَ تَن نَشَن رَتُشِ مُشُ شَ كٌنيِيَ مَ،</para>
  <para style="q2" vid="PSA 136:23">بَرِ مَ دَن مُ نَ عَ شَ شَنُنتٍيَ مَ،<verse eid="PSA 136:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 136:24"/>عَ تَن نَشَن مُشُ بَشِ مُشُ يَشُييٍ يِ رَ،</para>
  <para style="q2" vid="PSA 136:24">بَرِ مَ دَن مُ نَ عَ شَ شَنُنتٍيَ مَ،<verse eid="PSA 136:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 136:25"/>عَ تَن نَشَن نّمّ قِمَ عَ شَ دَالِ بِرِن مَ،</para>
  <para style="q2" vid="PSA 136:25">بَرِ مَ دَن مُ نَ عَ شَ شَنُنتٍيَ مَ.<verse eid="PSA 136:25"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="26" style="v" sid="PSA 136:26"/>وٌ عَلَ تَنتُ نَشَن نَ كٌورٍ مَ،</para>
  <para style="q2" vid="PSA 136:26">بَرِ مَ دَن مُ نَ عَ شَ شَنُنتٍيَ مَ.<verse eid="PSA 136:26"/></para>
  <chapter eid="PSA 136"/>
  <chapter number="137" style="c" sid="PSA 137"/>
  <para style="s1">عِسِرَيِلَ شَ كٌنيِيَ بَبِلْن بْشِ مَ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 137:1"/>مُشُ نُ دْشْشِ بَبِلْن شُرٍيٍ دّ رَ سِيٌنِ شَ قٍ رَتُقٍ رَ.<verse eid="PSA 137:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 137:2"/>مُشُ نُ بَرَ مُشُ شَ كْرَيٍ فبَكُ وُرِ بِلِيٍ كْن نَ.<verse eid="PSA 137:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 137:3"/>مُشُ يَشُييٍ نُ سِيٌنِ بّيتِيٍ مَشْرِن مُشُ مَ،</para>
  <para style="q" vid="PSA 137:3">عٍ نُ وَ مَ بّيتِ سّيوَشِ ندٍ شْن.</para>
  <para style="q" vid="PSA 137:3">عٍ نَشّ، «سِيٌنِ بّيتِ ندٍ بَ مُشُ بّ.»<verse eid="PSA 137:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 137:4"/>مُشُ نْمَ بّيتِ بَدٍ عَلَتَلَ بّ يِ كٌنيِيَ كُي دِ؟<verse eid="PSA 137:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 137:5"/>دَرِ سَلَمُ، شَ ﭑ نّيمُ عِ مَ، ﭑ بّلّشّ نَشَ نْ كْرَ رَبٍرٍدٍ سْنْن،<verse eid="PSA 137:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 137:6"/>ﭑ نّنيِ شَ كَنكَن ﭑ دّ كُي.</para>
  <para style="q" vid="PSA 137:6">نَ شَ رَبَ ﭑ نَ شَ عَ سَ لِ ﭑ نَشَ نّيمُ دَرِ سَلَمُ مَ،</para>
  <para style="q" vid="PSA 137:6">شَ عَ شَ قٍ مُ قِندِ ﭑ مَ سّيوّ رَ.<verse eid="PSA 137:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 137:7"/>عَلَتَلَ، عِ شَ رَتُ عٍدٌنكَيٍ شَ قٍ رَبَ مَ دَرِ سَلَمُ شَ نِمِسّ لْشْي.</para>
  <para style="q" vid="PSA 137:7">عٍ تَن نَن نُ عَ قَلَمَ،</para>
  <para style="q" vid="PSA 137:7">«وٌن شَ عَ كَنَ هَن وٌن سَ عَ بَ عَ بُنيِ رَ.»<verse eid="PSA 137:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 137:8"/>بَبِلْن، وٌ شَ شُننَفٌرٍ بَرَ فّ حَنِفٍدٍ،</para>
  <para style="q" vid="PSA 137:8">سّيوّ نَ عَ بّ نَشَن عِ سَرٍ رَفبِلٍنمَ عِ مَ،</para>
  <para style="q" vid="PSA 137:8">عِ قٍ حَاشِ نَشَن نَبَشِ مُشُ رَ.<verse eid="PSA 137:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 137:9"/>سّيوّ نَ مِشِ بّ نَشَن عِ شَ دِيٍ سُشُمَ،</para>
  <para style="q" vid="PSA 137:9">عَ عٍ بُتُشُن قَنيٍ قَرِ.<verse eid="PSA 137:9"/></para>
  <chapter eid="PSA 137"/>
  <chapter number="138" style="c" sid="PSA 138"/>
  <para style="s">عَلَ بَتُقٍ بْحّ بِرِن نَ</para>
  <para style="d">دَوُدَ شَ بّيتِ</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 138:1"/>ﭑ عِ بَتُمَ نّ ﭑ بْحّ بِرِن نَ،</para>
  <para style="q" vid="PSA 138:1">ﭑ عِ مَتْشْ عَلَيٍ يَ عِ.<verse eid="PSA 138:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 138:2"/>ﭑ نَ ﭑ شِنبِ سِنمَ نّ عِ شَ هْرْ مْلِنفِرَ مَبِرِ،</para>
  <para style="q" vid="PSA 138:2">ﭑ عِ شِلِ مَتْشْ عِ شَ شَنُنتٍيَ نُن دُفُتّفّحَ شَ قٍ رَ،</para>
  <para style="q" vid="PSA 138:2">بَرِ مَ عِ بَرَ عِ شِلِ نُن عِ شَ مَسٍنيِ رَتٍ قٍ بِرِن شُن نَ.<verse eid="PSA 138:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 138:3"/>ﭑ تٌ عِ شِلِ، عِ نَشَ ﭑ يَابِ،</para>
  <para style="q" vid="PSA 138:3">عِ نَشَ ﭑ نَلِمَنِيَ عِ سّنبّ رَ.<verse eid="PSA 138:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 138:4"/>مَنفّ نَشٍيٍ بِرِن نَ يِ دُنِحَ مَ،</para>
  <para style="q" vid="PSA 138:4">عٍ نَ عِ شَ مَسٍنيِ رَ مّ، عٍ شَ عِ مَتْشْ.<verse eid="PSA 138:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 138:5"/>عٍ شَ عَلَتَلَ شَ كِرَ مَتْشْ،</para>
  <para style="q" vid="PSA 138:5">بَرِ مَ عَلَتَلَ شَ نْرّ فبٌ.<verse eid="PSA 138:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 138:6"/>هَلِ عَلَتَلَ نَ كٌورٍ مَ،</para>
  <para style="q" vid="PSA 138:6">عَ مّينِمَ نّ مِشِ مَفٌرٌشِيٍ مَ،</para>
  <para style="q" vid="PSA 138:6">كْنْ عَ مَكُيَمَ نّ يّتّ عِفبٌييٍ رَ.<verse eid="PSA 138:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 138:7"/>ﭑ نَ لُ تْورّ كُي، عِ ﭑ نَكِسِمَ نّ،</para>
  <para style="q" vid="PSA 138:7">عِ ﭑ يَشُييٍ شَ شْنّ شُن نَكَنَمَ نّ،</para>
  <para style="q" vid="PSA 138:7">عِ قَ ﭑ نَكِسِ عِ سّنبّ رَ.<verse eid="PSA 138:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 138:8"/>عَلَتَلَ ﭑ مَ قٍيٍ رَكَمَلِمَ نّ.</para>
  <para style="q" vid="PSA 138:8">عَلَتَلَ، دَن مُ نَ عِ شَ شَنُنتٍيَ مَ.</para>
  <para style="q" vid="PSA 138:8">عِ نَشَ عِ شَ دَالِيٍ رَبٌلٌ.<verse eid="PSA 138:8"/></para>
  <chapter eid="PSA 138"/>
  <chapter number="139" style="c" sid="PSA 139"/>
  <para style="s1">عَلَ مِشِيٍ كٌلٌنقٍ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 139:1"/>دَوُدَ شَ بّيتِ بّيتِبَيٍ شَ مَنفّ بّ</para>
  <para style="q" vid="PSA 139:1">عَلَتَلَ، عِ ﭑ بْحّ بِرِن كٌلٌن.<verse eid="PSA 139:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 139:2"/>عِ ﭑ دْشْ تّمُي كٌلٌن، عِ ﭑ كٍلِ تّمُي كٌلٌن،</para>
  <para style="q" vid="PSA 139:2">عِ ﭑ مَ مَحْشُنيِيٍ بِرِن كٌلٌن</para>
  <para style="q" vid="PSA 139:2">بٍينُن ﭑ شَ عٍ مَحْشُن.<verse eid="PSA 139:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 139:3"/>عِ ﭑ حّرّ تّمُي كٌلٌن، عِ ﭑ سَ تّمُي كٌلٌن،</para>
  <para style="q" vid="PSA 139:3">عِ ﭑ مَ كِرَيٍ بِرِن كٌلٌن.<verse eid="PSA 139:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 139:4"/>بٍينُن وْيّنيِ شَ مِنِ ﭑ دّ عِ،</para>
  <para style="q" vid="PSA 139:4">عِ تَن حَن بَرَ عَ بِرِن كٌلٌن.<verse eid="PSA 139:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 139:5"/>عِ ﭑ نَبِلِنمَ نّ عِ شْنيّيٍ رَ.<verse eid="PSA 139:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 139:6"/>نَ قٍ كٌلٌنيِ مَكَابَشِ فبٌ ﭑ تَن بّ،</para>
  <para style="q" vid="PSA 139:6">عَ دَنفِ ﭑ مَ قَهَامُي رَ.<verse eid="PSA 139:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 139:7"/>ﭑ سِفَمَ مِندٍن، ﭑ شَ ﭑ مَكُيَ عِ شَشِلِ رَ؟</para>
  <para style="q" vid="PSA 139:7">ﭑ نَ ﭑ فِمَ مِندٍن، ﭑ شَ ﭑ نْشُن عِ مَ؟<verse eid="PSA 139:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 139:8"/>شَ ﭑ سَ تٍ كٌورٍ نّ، عِ نَ مّننِ.</para>
  <para style="q" vid="PSA 139:8">شَ ﭑ سَ فٌرٌ عَلِفِيَمَ نّ، ﭑ عِ لِمَ نّ نَا.<verse eid="PSA 139:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 139:9"/>شَ ﭑ سَ كٍلِ سُبَشّ مَ، ﭑ بَا عِفِرِ،<verse eid="PSA 139:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 139:10"/>عِ بّلّشّ ﭑ نَحّرّ مَ نّ، عِ سّنبّ ﭑ مَلِمَ نّ.<verse eid="PSA 139:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 139:11"/>شَ عَ سَ لِ ﭑ قَ عَ قَلَ،</para>
  <para style="q" vid="PSA 139:11">«ﭑ نْمَ ﭑ نْشُندٍ دِ مِ كُي نَءِيَلَنيِ مُ نَ دّننَشّ،»<verse eid="PSA 139:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 139:12"/>عِ ﭑ تٌمَ نّ نَ دِ مِ كُي عَلْ ﭑ نَ سٌفٍ نَن بُن مَ.<verse eid="PSA 139:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 139:13"/>عِ تَن نَن ﭑ نِي دَاشِ،</para>
  <para style="q" vid="PSA 139:13">عِ تَن نَن ﭑ نَقَلَشِ ﭑ نفَ تّيفّ.<verse eid="PSA 139:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 139:14"/>ﭑ عِ مَتْشْمَ نّ بَرِ مَ ﭑ دَا كِ مَكَابَ.</para>
  <para style="q" vid="PSA 139:14">عِ شَ وَلِ مَنِيّ مُ نَ.</para>
  <para style="q" vid="PSA 139:14">ﭑ نَ كٌلٌنشِ عَ قَنيِ رَ.<verse eid="PSA 139:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 139:15"/>ﭑ قَتٍ كِ مُ نُ نْشُنشِ عِ مَ</para>
  <para style="q" vid="PSA 139:15">عَ تٌ يَءِلَنشِ فُندٌ كُي.<verse eid="PSA 139:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 139:16"/>عِ يَيٍ نَشَ ﭑ تٌ بٍينُن ﭑ شَ قِندِ عَ رَ.</para>
  <para style="q" vid="PSA 139:16">ﭑ مَ لْشْييٍ بِرِن نُ سّبّشِ عِ شَ بُكِ كُي بٍينُن ﭑ شَ دَالِ.<verse eid="PSA 139:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 139:17"/>عَلَ، عِ شَ مَحْشُنيِيٍ فبٌ، عٍ تِلِن.<verse eid="PSA 139:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 139:18"/>شَ ﭑ سَ عٍ كْنتِمَ نّ نُ، عٍ وُيَ مّيّنيِ شْرِ بّ.</para>
  <para style="q" vid="PSA 139:18">نَ بِرِن كُي، ﭑ لُمَ عِ يِ.<verse eid="PSA 139:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PSA 139:19"/>عَلَ، يَندِ، عِ شَ مِشِ حَاشِيٍ قَشَ،</para>
  <para style="q" vid="PSA 139:19">عِ شَ قَشّتِيٍ مَكُيَ ﭑ نَ.<verse eid="PSA 139:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 139:20"/>عِ يَشُييٍ قٍ حَاشِ قَلَمَ عِ شَ قٍ رَ، عٍ عِ شِلِ كَنَمَ.<verse eid="PSA 139:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 139:21"/>عَلَتَلَ، عَ مُ لَنمَ ﭑ شَ عِ شْنمِشِيٍ شْن؟</para>
  <para style="q" vid="PSA 139:21">عَ مُ لَنمَ عِ مَتَندِلَيٍ شَ رَحَاشُ ﭑ مَ؟<verse eid="PSA 139:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 139:22"/>ﭑ عٍ شْنمَ نّ. عٍ بَرَ قِندِ ﭑ يَشُييٍ رَ.<verse eid="PSA 139:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="PSA 139:23"/>عَلَ عِ شَ ﭑ بْحّ كُي مَتٌ،</para>
  <para style="q" vid="PSA 139:23">عِ شَ ﭑ مَ كْنتْقِلِ كٌلٌن.<verse eid="PSA 139:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 139:24"/>عَ مَتٌ شَ ﭑ نَ كِرَ كٌبِ ندٍ نَن شْن مَ،</para>
  <para style="q" vid="PSA 139:24">عِ نَشَن شْنشِ.</para>
  <para style="q" vid="PSA 139:24">شَ عَ نَ نَ كِ نّ، عِ شَ ﭑ تِ كِسِ كِرَ نَن شْن مَ.<verse eid="PSA 139:24"/></para>
  <chapter eid="PSA 139"/>
  <chapter number="140" style="c" sid="PSA 140"/>
  <para style="s1">مِشِ كٌبِ عَلْ بْشِمَسٍ</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 140:1"/>دَوُدَ شَ بّيتِ بّيتِبَيٍ شَ مَنفّ بّ<verse eid="PSA 140:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 140:2"/>عَلَتَلَ، ﭑ نَتَنفَ مِشِ حَاشِيٍ يِ رَ،</para>
  <para style="q" vid="PSA 140:2">نَشٍيٍ وَ مَ ﭑ تْورْقٍ،<verse eid="PSA 140:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 140:3"/>نَشٍيٍ نَتّ تٌنفٌمَ عٍ بْحّ مَ فٍرٍ مَسٌقٍ رَ لْشْ يٌ لْشْ.<verse eid="PSA 140:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 140:4"/>عٍ شَ وْيّنيِ شْنْ عَلْ بْشِمَسٍ شَ شْنّ. <char style="qs">حّنفِ رَتٍ.</char><verse eid="PSA 140:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 140:5"/>عَلَتَلَ، عِ شَ ﭑ نَتَنفَ مِشِ حَاشِيٍ بّلّشّ عِ.</para>
  <para style="q" vid="PSA 140:5">عِ شَ ﭑ نَتَنفَ مِشِ كٌبِيٍ مَ نَشٍيٍ وَ مَ ﭑ نَبِرَقٍ.<verse eid="PSA 140:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 140:6"/>عِ شَ ﭑ نَتَنفَ يّتّ عِفبٌي شَ فَنتَنيِ نُن لُوتِيٍ مَ،</para>
  <para style="q" vid="PSA 140:6">نَشٍيٍ يّلّيٍ عِتَلَمَ ﭑ مَ كِرَيٍ رَ ﭑ سُشُقٍ رَ.<verse eid="PSA 140:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 140:7"/>عَلَتَلَ، ﭑ مَرِفِ عَلَ نَن عِ رَ.</para>
  <para style="q" vid="PSA 140:7">عِ شَ عِ تُلِ مَتِ ﭑ وَ شُي رَ.<verse eid="PSA 140:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 140:8"/>عَلَتَلَ، ﭑ نَكِسِمَ سّنبّمَ،</para>
  <para style="q" vid="PSA 140:8">نَشَن ﭑ نَتَنفَمَ ﭑ فٍرٍ لْشْي،<verse eid="PSA 140:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 140:9"/>عِ نَشَ تِن مِشِ كٌبِيٍ وَشْنقٍ رَ،</para>
  <para style="q" vid="PSA 140:9">عِ نَشَ نَ سْونّيَ عٍ بّ عَلَكٌ عٍ شُن نَشَ قَ رَكٍلِ. <char style="qs">حّنفِ رَتٍ.</char><verse eid="PSA 140:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 140:10"/>ﭑ فٍرٍقَيٍ شَ قٍ حَاشِ مَشِرِشِيٍ شَ فبِلٍن عٍ مَ.<verse eid="PSA 140:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 140:11"/>تّ وٌلٍ شَ دْشْ عٍ شُن نَ،</para>
  <para style="q" vid="PSA 140:11">عٍ شَ رَدِن تّ شْورَ، عٍ نَشَ قَ مِنِ نَ كُي سْنْن.<verse eid="PSA 140:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 140:12"/>قٍ حَاشِ رَبَيٍ نَشَ سَبَتِ يِ بْشِ مَ،</para>
  <para style="q" vid="PSA 140:12">تْورّ نَن تُن شَ رَفِرِ عٍ مَ.<verse eid="PSA 140:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="PSA 140:13"/>ﭑ عَ كٌلٌن عَلَتَلَ كِيتِ قَنيِ سَمَ نّ مِسِكِينّيٍ بّ،</para>
  <para style="q" vid="PSA 140:13">عَ نْندِ قِمَ سٍتَرٍيٍ مَ.<verse eid="PSA 140:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 140:14"/>تِنشِنتْييٍ عِ شِلِ مَتْشْمَ نّ،</para>
  <para style="q" vid="PSA 140:14">نْندِلَيٍ كِسِمَ نّ عِ يَ عِ.<verse eid="PSA 140:14"/></para>
  <chapter eid="PSA 140"/>
  <chapter number="141" style="c" sid="PSA 141"/>
  <para style="s1">مِشِ حَاشِيٍ شَ فَنتَنيِ</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 141:1"/>دَوُدَ شَ بّيتِ</para>
  <para style="q" vid="PSA 141:1">عَلَتَلَ، ﭑ بَرَ عِ مَشَندِ، عِ شُلُن ﭑ مَلِقٍ رَ،</para>
  <para style="q" vid="PSA 141:1">عِ شَ عِ تُلِ مَتِ ﭑ مَ مَشَندِ رَ.<verse eid="PSA 141:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 141:2"/>ﭑ مَ دُبَ شَ تٍ عِ مَبِرِ عَلْ سُرَيِ شِرِ،</para>
  <para style="q" vid="PSA 141:2">ﭑ مَ بّلّشّ تِ شَ لُ عَلْ نُنمَرٍ سّرّشّ.<verse eid="PSA 141:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 141:3"/>عَلَتَلَ، ﭑ دّ مَكَنتَ</para>
  <para style="q" vid="PSA 141:3">عَلَكٌ قٍ حَاشِ يٌ نَشَ مِنِ ﭑ دّ كُي.<verse eid="PSA 141:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 141:4"/>عِ نَشَ تِن ﭑ بْحّ شَ سِفَ قٍ حَاشِ مَ،</para>
  <para style="q" vid="PSA 141:4">ﭑ نَشَ لَن وَلِ كٌبِ رَبَيٍ مَ ﭑ مَ فٍينِ شَ قٍ رَ.<verse eid="PSA 141:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 141:5"/>شَ تِنشِنتْي ﭑ بْنبْ، عَ قَن ﭑ بّ،</para>
  <para style="q" vid="PSA 141:5">عَ شَ شُرُي قَن عَلْ لَبُندّ نَشَن سَمَ ﭑ قَتٍ مَ.</para>
  <para style="q" vid="PSA 141:5">ﭑ مُ تٌندِ مَ نَ قٍ رَ.</para>
  <para style="q" vid="PSA 141:5">كْنْ ﭑ عَلَ مَشَندِ مَ عَ شَ مِشِ حَاشِ وَشْنقٍ كَنَ.<verse eid="PSA 141:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 141:6"/>عٍ شَ كِيتِسَيٍ شَ رَدِن فٍلٍنيِ رَ.</para>
  <para style="q" vid="PSA 141:6">مِشِ حَاشِيٍ شَ عَ كٌلٌن ﭑ مَ مَسٍنيِ قَن.<verse eid="PSA 141:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 141:7"/>عٍ شَ عَ قَلَ، «مُشُ شْرِيٍ بَرَ يٍنسٍن عَلِفِيَمَ،</para>
  <para style="q" vid="PSA 141:7">عَلْ شّ سَ بْشِ بُشَمَ كِ نَشّ.»<verse eid="PSA 141:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 141:8"/>كْنْ ﭑ مَرِفِ عَلَتَلَ، ﭑ يَ تِشِ عِ تَن نَ.</para>
  <para style="q" vid="PSA 141:8">ﭑ كَنتَرِ تٌمَ عِ سّيتِ مَ، عِ نَشَ ﭑ نِي رَبٌلٌ.<verse eid="PSA 141:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 141:9"/>ﭑ نَتَنفَ فَنتَنيِيٍ مَ عٍ نَشٍيٍ تٍمَ ﭑ بّ،</para>
  <para style="q" vid="PSA 141:9">ﭑ نَتَنفَ مِشِ حَاشِيٍ شَ يّلّيٍ مَ.<verse eid="PSA 141:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 141:10"/>عٍ تَن شَ سُشُ نٍيٍ رَ، ﭑ تَن شَ كِسِ.<verse eid="PSA 141:10"/></para>
  <chapter eid="PSA 141"/>
  <chapter number="142" style="c" sid="PSA 142"/>
  <para style="s1">دَنشَنِيَتْي شَ كَنتَرِ</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 142:1"/>دَوُدَ شَ لْننِ بّيتِ عَ تٌ نُ نَ قْنمّ رَ<verse eid="PSA 142:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 142:2"/>ﭑ نَ ﭑ شُي رَتٍمَ عَلَتَلَ نَن مَ كِنِكِنِ شَ قٍ رَ.<verse eid="PSA 142:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 142:3"/>ﭑ نَ ﭑ مَ كْنتْقِلِ دّنتّفّمَ عَ تَن نَن بّ،</para>
  <para style="q" vid="PSA 142:3">ﭑ نَ ﭑ مَ نِمِسّ يَ بَ عَ بّ.<verse eid="PSA 142:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 142:4"/>لِمَنِيَ نَ بَ ﭑ يِ رَ، عِ تَن ﭑ سِفَدٍ كٌلٌن.</para>
  <para style="q" vid="PSA 142:4">عٍ بَرَ فَنتَنيِ تٍ ﭑ بّ ﭑ مَ كِرَ رَ.<verse eid="PSA 142:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 142:5"/>ﭑ نَبِلِنيِ مَتٌ؛ مِشِ يٌ مُ نَ ﭑ بّ،</para>
  <para style="q" vid="PSA 142:5">كَنتَرِ مُ نَ ﭑ بّ، مّينِمَ يٌ مُ نَ ﭑ بّ.<verse eid="PSA 142:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 142:6"/>عَلَتَلَ، عِ تَن نَن كٍرٍن ثٍتِ نَ ﭑ بّ سْنْن.</para>
  <para style="q" vid="PSA 142:6">عِ كٍرٍن نَن قِندِشِ ﭑ كَنتَمَ رَ يِ دُنِحَ بّندّ قُحِ قَرِ.<verse eid="PSA 142:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 142:7"/>عِ شَ ﭑ وَ شُي مّ، بَرِ مَ ﭑ سّنبّ بِرِن بَرَ حْن.</para>
  <para style="q" vid="PSA 142:7">ﭑ بَ ﭑ كٍرِ مَيٍ يِ رَ، بَرِ مَ عٍ سّنبّ فبٌ ﭑ بّ.<verse eid="PSA 142:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 142:8"/>ﭑ نَمِنِ فٍيلِ كُي، عَلَكٌ ﭑ شَ عِ شِلِ مَتْشْ.</para>
  <para style="q" vid="PSA 142:8">نَ كُي تِنشِنتْييٍ قَمَ نّ عٍ مَلَندٍ ﭑ يِرٍ عِ شَ هِننّ شَ قٍ رَ.<verse eid="PSA 142:8"/></para>
  <chapter eid="PSA 142"/>
  <chapter number="143" style="c" sid="PSA 143"/>
  <para style="s1">عَلَ شَ مَشَندِ هَفِفّ</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">دَوُدَ شَ بّيتِ</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 143:1"/>عَلَتَلَ، عِ تُلِ مَتِ ﭑ مَ مَشَندِ رَ،</para>
  <para style="q" vid="PSA 143:1">عِ شَ كِنِكِنِ ﭑ وَ شُي مَ.</para>
  <para style="q" vid="PSA 143:1">عِ شَ ﭑ مَ دُبَ سُشُ عِ شَ دُفُتّفّحَ نُن عِ شَ تِنشِنيِ شَ قٍ رَ.<verse eid="PSA 143:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 143:2"/>عِ نَشَ عِ شَ كٌنيِ مَكِيتِ، بَرِ مَ دَالِ يٌ مُ تِنشِن عِ يَ عِ.<verse eid="PSA 143:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 143:3"/>ﭑ يَشُي بِرَ مَ نّ ﭑ قْشْ رَ،</para>
  <para style="q" vid="PSA 143:3">عَ ﭑ بٌرٌنمَ نّ بْشِ مَ،</para>
  <para style="q" vid="PSA 143:3">عَ ﭑ لُمَ نّ قَشّ نِينِ بُن مَ عَلْ قَشَمِشِيٍ.<verse eid="PSA 143:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 143:4"/>نَ كُي ﭑ شَشِلِ بَرَ عِقُ. لِمَنِيَ بَرَ بَ ﭑ يِ.<verse eid="PSA 143:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 143:5"/>ﭑ نَتُمَ نّ لْشْي دَنفِشِيٍ مَ،</para>
  <para style="q" vid="PSA 143:5">ﭑ نَ ﭑ شَشِلِ رَ سِفَمَ عِ شَ وَلِ بِرِن مَ،</para>
  <para style="q" vid="PSA 143:5">ﭑ نَ ﭑ حْشْ رَ سِفَ عِ شَ دَالِيٍ مَ.<verse eid="PSA 143:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 143:6"/>ﭑ نَ ﭑ بّلّشّ عِتَلَمَ نّ عِ بّ،</para>
  <para style="q" vid="PSA 143:6">ﭑ نِي عِ قٍنمَ نّ عَلْ فبٍنفبٍرٍنيِ يٍ قٍنمَ كِ نَشّ. <char style="qs">حّنفِ رَتٍ.</char><verse eid="PSA 143:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 143:7"/>عَلَتَلَ، يَندِ، عِ شُلُن ﭑ يَابِقٍ رَ.</para>
  <para style="q" vid="PSA 143:7">لِمَنِيَ بَرَ فّ بَدٍ ﭑ يِ رَ.</para>
  <para style="q" vid="PSA 143:7">عِ نَشَ عِ كٌبٍ رَ سٌ ﭑ نَ،</para>
  <para style="q" vid="PSA 143:7">شَ نَ مُ ﭑ لُمَ نّ عَلْ قَشَمِشِيٍ.<verse eid="PSA 143:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 143:8"/>كُيٍ نَ عِبَ، عِ شَ عِ شَ دُفُتّفّحَ مَسٍن ﭑ بّ،</para>
  <para style="q" vid="PSA 143:8">بَرِ مَ ﭑ شَشِلِ تِشِ عِ تَن نَن نَ.</para>
  <para style="q" vid="PSA 143:8">ﭑ حّرّ كِرَ مَسٍن ﭑ بّ،</para>
  <para style="q" vid="PSA 143:8">بَرِ مَ ﭑ شَشِلِ تِشِ عِ تَن نَن نَ.<verse eid="PSA 143:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 143:9"/>عَلَتَلَ، ﭑ نَتَنفَ ﭑ يَشُييٍ مَ،</para>
  <para style="q" vid="PSA 143:9">بَرِ مَ ﭑ كَنتَرِ سْتْمَ عِ نِينِ نَن بُن مَ.<verse eid="PSA 143:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 143:10"/>ﭑ شَرَن عِ وَشْنقٍ رَبَقٍ رَ،</para>
  <para style="q" vid="PSA 143:10">بَرِ مَ عِ تَن نَن نَ ﭑ مَرِفِ عَلَ رَ.</para>
  <para style="q" vid="PSA 143:10">عِ شَشِلِ سّنِيّنشِ شَ ﭑ تِ كِرَ قَنيِ شْن مَ.<verse eid="PSA 143:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 143:11"/>عَلَتَلَ، عِ شَ ﭑ نَكِسِ عِ شِلِ شَ قٍ رَ،</para>
  <para style="q" vid="PSA 143:11">عِ شَ ﭑ بَ تْورّ كُي عِ شَ تِنشِنيِ شَ قٍ رَ،<verse eid="PSA 143:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 143:12"/>عِ شَ ﭑ يَشُييٍ دّ بَلَن عِ شَ دُفُتّفّحَ شَ قٍ رَ،</para>
  <para style="q" vid="PSA 143:12">عِ شَ ﭑ فٍرٍقَيٍ شُن نَكَنَ،</para>
  <para style="q" vid="PSA 143:12">بَرِ مَ عِ شَ كٌنيِ نَن لَنشِ ﭑ مَ.<verse eid="PSA 143:12"/></para>
  <chapter eid="PSA 143"/>
  <chapter number="144" style="c" sid="PSA 144"/>
  <para style="s1">مُنسٍ نَ عَدَ مَدِ رَ عَلَ بّ؟</para>
  <para style="s2">عَلَ مَشَندِ</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 144:1"/>دَوُدَ شَ بّيتِ</para>
  <para style="q" vid="PSA 144:1">تَنتُي نَ عَلَتَلَ بّ، نَشَن قِندِشِ ﭑ مَ قَنيٍ رَ،</para>
  <para style="q" vid="PSA 144:1">نَشَن ﭑ بّلّشّ رَوَلِمَ عَ شَ فٍرٍ كُي،<verse eid="PSA 144:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 144:2"/>نَشَن قِندِشِ ﭑ شَنُنتٍنيِ سّنبّمَ رَ،</para>
  <para style="q" vid="PSA 144:2">نَشَن قِندِشِ ﭑ كَنتَمَ نُن ﭑ نَكِسِمَ رَ،</para>
  <para style="q" vid="PSA 144:2">نَشَن نْمَ ﭑ يَشُييٍ رَ عَلَكٌ ﭑ شَ كَنتَرِ سْتْ.<verse eid="PSA 144:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 144:3"/>عَلَتَلَ، مُنسٍ نَ عَدَ مَ رَ عِ تٌ قَ مّينِشِ عَ مَ؟</para>
  <para style="q" vid="PSA 144:3">مُنسٍ نَ عَدَ مَ شَ دِ رَ عِ تٌ قَ عِ حْشْ سَشِ عَ شْن مَ؟<verse eid="PSA 144:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 144:4"/>عَدَ مَدِ لُشِ نّ عَلْ حّنفِ قٌيٍ،</para>
  <para style="q" vid="PSA 144:4">عَ شَ سِمَيَ دَنفِمَ نّ عَلْ نِينِ دَنفِمَ كِ نَشّ.<verse eid="PSA 144:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 144:5"/>عَلَتَلَ، عِ شَ كٌورٍ رَبِ عِ فٌرٌقٍ رَ،</para>
  <para style="q" vid="PSA 144:5">عِ قَ دِن فٍيَيٍ رَ عَلَكٌ تُورِ شَ تٍ.<verse eid="PSA 144:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 144:6"/>عِ شَ سٍيَمَكْنيِ رَبُلَ يَشُييٍ رَيٍنسٍنقٍ رَ.</para>
  <para style="q" vid="PSA 144:6">شَلِيٍ وٌلِ عَلَكٌ عٍ شَ سِفَ.<verse eid="PSA 144:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 144:7"/>عِ شَ عِ بّلّشّ عِتَلَ كٍلِقٍ كٌورٍ مَ،</para>
  <para style="q" vid="PSA 144:7">عَلَكٌ عِ شَ ﭑ نَكِسِ، عِ شَ ﭑ نَتَنفَ ﭑ يَشُييٍ مَ</para>
  <para style="q" vid="PSA 144:7">عَلْ مِشِ رَتَنفَمَ مْرْنيِيٍ مَ كِ نَشّ.<verse eid="PSA 144:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 144:8"/>ﭑ نَكِسِ وُلٍ قَلّيٍ مَ نَشٍيٍ وَ مَ ﭑ مَدَشُقٍ.<verse eid="PSA 144:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="PSA 144:9"/>عَلَ، ﭑ بّيتِ نّينّ بَمَ نّ عِ بّ ﭑ مَ كْرَ لُوتِ قُ دَاشِ شُي رَ.<verse eid="PSA 144:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 144:10"/>ﭑ عِ مَتْشْمَ نّ، عِ تَن نَشَن مَنفّيٍ شُن نَكٍلِمَ،</para>
  <para style="q" vid="PSA 144:10">نَشَن عِ شَ كٌنيِ دَوُدَ رَتَنفَمَ سَنتِدّفّمَ حَاشِ مَ.<verse eid="PSA 144:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="PSA 144:11"/>ﭑ نَكِسِ، ﭑ نَتَنفَ ﭑ يَشُييٍ مَ،</para>
  <para style="q" vid="PSA 144:11">نَشَن وُلٍ قَلَمَ مِشِ مَدَشُقٍ رَ.<verse eid="PSA 144:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 144:12"/>نَ تّمُي مُشُ شَ دِ شّمّيٍ قَنمَ نّ عَلْ وُرِ بِلِيٍ،</para>
  <para style="q" vid="PSA 144:12">مُشُ شَ دِ فِنّيٍ تٌقَنمَ نّ عَلْ كْنتِفِبَ،</para>
  <para style="q" vid="PSA 144:12">نَشٍيٍ مَسٌلِشِ مَنفّ بَنشِ كُي.<verse eid="PSA 144:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 144:13"/>مُشُ شَ بَنشِيٍ رَقٍمَ نّ دَشَمُي مْولِ بِرِن نَ،</para>
  <para style="q" vid="PSA 144:13">مُشُ شَ فْورّيٍ وُيَمَ نّ عَ وُلُ وُلُ مَ،<verse eid="PSA 144:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 144:14"/>مُشُ شَ نِنفٍيٍ شُنفبٌمَ نّ،</para>
  <para style="q" vid="PSA 144:14">لَنيُرُ يٌ مُ لُمَ عٍ مَ،</para>
  <para style="q" vid="PSA 144:14">عٍ قُرِ مُ بِرَ مَ،</para>
  <para style="q" vid="PSA 144:14">سْنشْي مُ مّمَ مُشُ مَلَندٍيٍ.<verse eid="PSA 144:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PSA 144:15"/>سّيوّ نَ حَمَ بّ عَلَ قَمَ يِ قٍ مْولِ رَبَدٍ نَشَن نَ.</para>
  <para style="q" vid="PSA 144:15">سّيوّ نَ حَمَ بّ عَلَتَلَ قِندِشِ نَشَن مَرِفِ عَلَ رَ.<verse eid="PSA 144:15"/></para>
  <chapter eid="PSA 144"/>
  <chapter number="145" style="c" sid="PSA 145"/>
  <para style="s1">عَلَ شَ كَابَنَكٌي نُن شَنُنتٍيَ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="d">دَوُدَ شَ عَلَ مَتْشْي</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 145:1"/>ﭑ مَ مَنفّ عَلَ، ﭑ عِ مَتْشْمَ نّ،</para>
  <para style="q" vid="PSA 145:1">ﭑ عِ شِلِ تَنتُمَ نّ عَبَدَن.<verse eid="PSA 145:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 145:2"/>لْشْ يٌ لْشْ ﭑ عِ مَتْشْمَ نّ،</para>
  <para style="q" vid="PSA 145:2">ﭑ عِ شِلِ تَنتُمَ نّ عَبَدَن.<verse eid="PSA 145:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 145:3"/>عَلَتَلَ سّنبّ فبٌ، مَتْشْي بِرِن نَ عَ تَن نَن بّ،</para>
  <para style="q" vid="PSA 145:3">عَدَ مَدِ مُ نْمَ سٌدٍ نَ بِرِن كُي.<verse eid="PSA 145:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 145:4"/>يِ وَشَتِ مِشِيٍ قَمَ نّ عِ شَ كَابَنَكٌي قَلَدٍ بٌورٍ وَشَتِ مِشِيٍ بّ.<verse eid="PSA 145:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 145:5"/>عٍ قَمَ نّ عِ شَ نْرّ تٌقَنيِ مَسٍندٍ.</para>
  <para style="q" vid="PSA 145:5">ﭑ لُمَ نّ عِ شَ كَابَنَكٌي مَحْشُن نَ.<verse eid="PSA 145:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 145:6"/>عٍ قَمَ نّ عِ سّنبّ مَفَاشُشِ شَ قٍ قَلَدٍ.</para>
  <para style="q" vid="PSA 145:6">ﭑ لُمَ نّ عِ شَ كَابَنَكٌي مَسٍن نَ.<verse eid="PSA 145:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 145:7"/>عٍ قَمَ نّ حّلّشِندٍ عِ شَ هِننّ شُنفبٍ رَ،</para>
  <para style="q" vid="PSA 145:7">عٍ عِ شَ تِنشِنيِ مَسٍنمَ نّ بّيتِ سّيوَشِ رَ.<verse eid="PSA 145:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="PSA 145:8"/>عَلَتَلَ هِننّ مِشِ رَ، عَ كِنِكِنِ،</para>
  <para style="q" vid="PSA 145:8">عَ دِحّشِ، عَ شَ شَنُنتٍيَ فبٌ.<verse eid="PSA 145:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 145:9"/>عَلَتَلَ قٍ قَنيِ رَبَمَ مِشِ بِرِن بّ،</para>
  <para style="q" vid="PSA 145:9">عَ كِنِكِنِ عَ شَ دَالِ بِرِن مَ.<verse eid="PSA 145:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 145:10"/>عَلَتَلَ، عِ شَ دَالِيٍ بِرِن عِ مَتْشْمَ نّ،</para>
  <para style="q" vid="PSA 145:10">عِ شَ سّنِيّنتْييٍ عِ تَنتُمَ نّ.<verse eid="PSA 145:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 145:11"/>عٍ عِ شَ مَنفّيَ شُنفبٍ شَ قٍ مَسٍنمَ نّ،</para>
  <para style="q" vid="PSA 145:11">عٍ عِ سّنبّ شَ قٍ قَلَمَ نّ،<verse eid="PSA 145:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 145:12"/>عَلَكٌ مِشِيٍ شَ عِ شَ كَابَنَكٌي كٌلٌن،</para>
  <para style="q" vid="PSA 145:12">عَ نُن عِ شَ مَنفّيَ نْرْشِ.<verse eid="PSA 145:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 145:13"/>عِ شَ مَنفّيَ مُ حْنمَ نّ،</para>
  <para style="q" vid="PSA 145:13">عِ شَ نْي بُمَ نّ عَبَدَن.<verse eid="PSA 145:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PSA 145:14"/>عَلَتَلَ بِرَ مِشِ مَلِمَ،</para>
  <para style="q" vid="PSA 145:14">عَ مِشِ مَفٌرٌشِ شُن نَكٍلِمَ نّ.<verse eid="PSA 145:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 145:15"/>دُنِحَ بِرِن عَ شَشِلِ تِشِ عِ رَ،</para>
  <para style="q" vid="PSA 145:15">عِ تَن نَن عٍ بَلٌمَ عَ وَشَتِ.<verse eid="PSA 145:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 145:16"/>عِ تَن نَن عِ بّلّشّ رَبِمَ،</para>
  <para style="q" vid="PSA 145:16">عِ بِرِن نَوَ سَ عٍ هَيِ نَ نَشَن مَ.<verse eid="PSA 145:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 145:17"/>عَلَتَلَ تِنشِن عَ شَ قٍ بِرِن كُي،</para>
  <para style="q" vid="PSA 145:17">عَ دُفُتّفّشِ عَ شَ دَالِيٍ مَ.<verse eid="PSA 145:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 145:18"/>عَلَتَلَ مَكْرّ عَ مَشَندِلَيٍ رَ،</para>
  <para style="q" vid="PSA 145:18">نَشٍيٍ عَ مَشَندِ مَ عٍ بْحّ قِيشّ رَ.<verse eid="PSA 145:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 145:19"/>عَ عَ يَرَفَاشُييٍ وَشْنقٍ رَبَمَ نّ،</para>
  <para style="q" vid="PSA 145:19">عَ عٍ شَ دُبَ سُشُمَ نّ، عَ عٍ رَكِسِ.<verse eid="PSA 145:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 145:20"/>عَلَتَلَ عَ شَنُنتٍنيِيٍ مَكَنتَمَ نّ،</para>
  <para style="q" vid="PSA 145:20">كْنْ عَ مِشِ حَاشِيٍ بِرِن سْنتْمَ نّ.<verse eid="PSA 145:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 145:21"/>ﭑ دّ عَلَتَلَ مَتْشْمَ نّ.</para>
  <para style="q" vid="PSA 145:21">دَالِ شَ عَ شِلِ سّنِيّنشِ مَتْشْ تّمُي بِرِن.<verse eid="PSA 145:21"/></para>
  <chapter eid="PSA 145"/>
  <chapter number="146" style="c" sid="PSA 146"/>
  <para style="s1">عَلَ شَ مَلِ فبٌ عَدَ مَ شَ مَلِ بّ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 146:1"/>وٌ عَلَتَلَ مَتْشْ!</para>
  <para style="b" vid="PSA 146:1"/>
  <para style="q" vid="PSA 146:1">ﭑ نِي شَ عَلَتَلَ مَتْشْ،<verse eid="PSA 146:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 146:2"/>ﭑ شَ عَ مَتْشْ ﭑ مَ سِمَيَ بِرِن نَ.</para>
  <para style="q" vid="PSA 146:2">ﭑ ﭑ مَرِفِ عَلَتَلَ مَتْشْمَ نّ بّيتِ رَ، قَننِ ﭑ نَ ﭑ نِي رَ.<verse eid="PSA 146:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 146:3"/>وٌ نَشَ وٌ يّتّ تَشُ مِشِ شُنفبٍيٍ رَ،</para>
  <para style="q" vid="PSA 146:3">بَرِ مَ عَدَ مَدِيٍ نَ عٍ رَ، نَشٍيٍ مُ نْمَ مِشِ رَكِسِدٍ.<verse eid="PSA 146:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 146:4"/>عٍ نِي بَمَ نّ عٍ قَتٍ عِ، عٍ فبِلٍن بّندّ.</para>
  <para style="q" vid="PSA 146:4">نَ لْشْي يَتِ، عٍ نَشَن حَنِفٍشِ، نَ بِرِن حْنمَ نّ.<verse eid="PSA 146:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="PSA 146:5"/>سّيوّ نَ مِشِ بّ، يَشُبَ مَرِفِ عَلَ نَشَن مَلِمَ.</para>
  <para style="q" vid="PSA 146:5">سّيوّ نَ مِشِ بّ، نَشَن عَ شَشِلِ تِمَ عَ مَرِفِ عَلَتَلَ رَ،<verse eid="PSA 146:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 146:6"/>عَلَ نَشَن كٌورٍ نُن بْشِ دَا،</para>
  <para style="q" vid="PSA 146:6">عَلَ نَشَن بَا نُن عَ كُي سٍيٍ بِرِن دَا،</para>
  <para style="q" vid="PSA 146:6">دُفُتّفّحَ نَ عَلَ نَشَن بّ عَبَدَن.<verse eid="PSA 146:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 146:7"/>عَلَتَلَ تْوحّفّتْييٍ شُن مَقَلَمَ،</para>
  <para style="q" vid="PSA 146:7">عَ دٌنسٍ قِمَ كَامّتْييٍ مَ،</para>
  <para style="q" vid="PSA 146:7">عَ فٍيلِمَنِيٍ رَ مِنِمَ فٍيلِ كُي،<verse eid="PSA 146:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 146:8"/>عَ دْنشُييٍ يَ رَبْو مَ،</para>
  <para style="q" vid="PSA 146:8">عَ مِشِ مَفٌرٌشِيٍ شُن نَكٍلِمَ،</para>
  <para style="q" vid="PSA 146:8">عَ تِنشِنتْييٍ شَنُمَ،<verse eid="PSA 146:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 146:9"/>عَ مّينِمَ شْحّيٍ مَ،</para>
  <para style="q" vid="PSA 146:9">عَ كِرِدِيٍ نُن كَاحّ فِنّيٍ بُن تِمَ،</para>
  <para style="q" vid="PSA 146:9">كْنْ عَ مِشِ حَاشِيٍ تَن شُن نَكَنَمَ نّ.<verse eid="PSA 146:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 146:10"/>سِيٌنِ، وٌ مَرِفِ عَلَتَلَ شَ مَنفّيَ مُ حْنمَ عَبَدَن.</para>
  <para style="q" vid="PSA 146:10">وٌ شَ عَلَتَلَ مَتْشْ!<verse eid="PSA 146:10"/></para>
  <chapter eid="PSA 146"/>
  <chapter number="147" style="c" sid="PSA 147"/>
  <para style="s1">عَلَ سّنبّ مَنِيّ مُ نَ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 147:1"/>وٌ عَلَتَلَ مَتْشْ.</para>
  <para style="q" vid="PSA 147:1">عَ لَنمَ عَلَتَلَ شَ مَتْشْ بّيتِ رَ.</para>
  <para style="q" vid="PSA 147:1">قٍ قَنيِ نَ عَ رَ.<verse eid="PSA 147:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="PSA 147:2"/>عَلَتَلَ نَ فبِلٍنقٍ دَرِ سَلَمُ تِ رَ،</para>
  <para style="q" vid="PSA 147:2">عَ عِسِرَيِلَ شَ مِشِ رَقَمَ نّ كٍلِقٍ كٌنيِيَ كُي،<verse eid="PSA 147:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 147:3"/>عَ تْورْ مِشِيٍ رَلِمَنِيَمَ،</para>
  <para style="q" vid="PSA 147:3">عَ عٍ رَيَلَنمَ عٍ شَ قُرٍ كُي.<verse eid="PSA 147:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="PSA 147:4"/>عَلَتَلَ تُنبُييٍ كْنتِ كٌلٌن،</para>
  <para style="q" vid="PSA 147:4">عَ عٍ بِرِن شِلِمَ عٍ شِلِ رَ.<verse eid="PSA 147:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 147:5"/>وٌن مَرِفِ عَلَتَلَ سّنبّ فبٌ،</para>
  <para style="q" vid="PSA 147:5">دَن مُ نَ عَ شَ قَهَامُي مَ.<verse eid="PSA 147:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 147:6"/>عَلَتَلَ مِشِ مَفٌرٌشِ بُن تِمَ،</para>
  <para style="q" vid="PSA 147:6">كْنْ عَ يّتّ عِفبٌي شَ قٍ كَنَمَ.<verse eid="PSA 147:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 147:7"/>وٌ شَ بّيتِ بَ عَلَتَلَ بّ تَنتُي رَ،</para>
  <para style="q" vid="PSA 147:7">وٌ شَ بّيتِ بَ عَلَ بّ كْرَيٍ شُي رَ.<verse eid="PSA 147:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 147:8"/>عَ تَن نَن نُشُي رَ مِنِمَ كٌورٍ مَ،</para>
  <para style="q" vid="PSA 147:8">عَ تُنّ رَقَ بْشِ مَ،</para>
  <para style="q" vid="PSA 147:8">عَ سَنسِيٍ رَ سٌلِ فٍيَيٍ قَرِ.<verse eid="PSA 147:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 147:9"/>عَ شُرُ سٍيٍ رَبَلٌمَ،</para>
  <para style="q" vid="PSA 147:9">عَ دٌنسٍ قِمَ شَشَ يْرّيٍ مَ، عٍ نَ عٍ شُي رَ مِنِ تّمُي نَشّ.<verse eid="PSA 147:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="PSA 147:10"/>سٌي سّنبّ مُ قِندِشِ قٍقٍ رَ عَلَ بّ.</para>
  <para style="q" vid="PSA 147:10">شّمّ شَ سّنبّ مُ قِندِشِ قٍقٍ رَ عَلَ بّ.<verse eid="PSA 147:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 147:11"/>عَلَ يَرَفَاشُييَ نَن نَقَنمَ عَ مَ.</para>
  <para style="q" vid="PSA 147:11">عَلَ وَ مَ مِشِ شْن نَشَن شَشِلِ تِشِ عَ شَ شَنُنتٍيَ رَ.<verse eid="PSA 147:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="PSA 147:12"/>دَرِ سَلَمُ، عِ شَ عَلَتَلَ مَتْشْ.</para>
  <para style="q" vid="PSA 147:12">سِيٌنِ، عِ شَ عَلَ تَنتُ،<verse eid="PSA 147:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 147:13"/>بَرِ مَ عَ تَن نَن عِ شَ نَادّ مَكَنتَمَ،</para>
  <para style="q" vid="PSA 147:13">عَ تَن نَن بَرَكّ سَمَ عِ شَ حَمَ مَ.<verse eid="PSA 147:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 147:14"/>عَ بْحّسَ قِمَ عِ شَ بْشِ مَ،</para>
  <para style="q" vid="PSA 147:14">عَ دٌنسٍ قَنيِ قِمَ عِ مَ.<verse eid="PSA 147:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="PSA 147:15"/>عَلَتَلَ دُنِحَ يَمَرِ مَ،</para>
  <para style="q" vid="PSA 147:15">عَ عَ وَشْنقٍ رَيٍنسٍنمَ مَقُرٍن مَقُرٍن.<verse eid="PSA 147:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 147:16"/>عَ بَلَبَلَنيِ رَفٌرٌ مَ نّ عَلْ فّسّ قُتٍ،</para>
  <para style="q" vid="PSA 147:16">عَ نَ رَيٍنسٍن عَلْ تّ شُبٍ.<verse eid="PSA 147:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 147:17"/>عَ رَفٌرٌ بْشِ مَ، ندٍ نْمَ تِدٍ نَ شِنبٍلِ يَ رَ؟<verse eid="PSA 147:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 147:18"/>عَ نَ عَ شُي رَ مِنِ عٍ مَ، عٍ شُنُمَ نّ،</para>
  <para style="q" vid="PSA 147:18">عَ نَ قٌيٍ رَقَ، بَلَبَلَنيِ مَن قِندِ مَ نّ يٍ رَ.<verse eid="PSA 147:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="PSA 147:19"/>عَلَتَلَ بَرَ عَننَبِ يَشُبَ رَكٌلٌن عَ شَ مَسٍنيِ رَ،</para>
  <para style="q" vid="PSA 147:19">عَ بَرَ عَ شَ سّرِيّ نُن عَ شَ يَامَرِيٍ مَسٍن عِسِرَيِلَ بّ.<verse eid="PSA 147:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 147:20"/>عَ مُ نَ مْولِ رَفِرِشِ سِ فبّتّ يٌ بّ.</para>
  <para style="q" vid="PSA 147:20">نٍيٍ لُمَ عَلَ شَ سّرِيّيٍ كٌلٌنتَرٍيَ نَن كُي.</para>
  <para style="b" vid="PSA 147:20"/>
  <para style="q" vid="PSA 147:20">وٌ شَ عَلَتَلَ مَتْشْ!<verse eid="PSA 147:20"/></para>
  <chapter eid="PSA 147"/>
  <chapter number="148" style="c" sid="PSA 148"/>
  <para style="s1">دُنِحَ شَ عَلَ مَتْشْ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 148:1"/>وٌ عَلَتَلَ مَتْشْ!</para>
  <para style="b" vid="PSA 148:1"/>
  <para style="q" vid="PSA 148:1">وٌ عَلَتَلَ مَتْشْ كٍلِقٍ كٌورٍ مَ.</para>
  <para style="q" vid="PSA 148:1">وٌ عَ مَتْشْ يِرٍ عِتٍشِ كُي.<verse eid="PSA 148:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 148:2"/>عَلَتَلَ شَ مَلٍكّيٍ شَ عَ مَتْشْ،</para>
  <para style="q" vid="PSA 148:2">عَ شَ فَلِيٍ شَ عَ مَتْشْ كٌورٍ مَ.<verse eid="PSA 148:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 148:3"/>سٌفٍ نُن كِكٍ شَ عَ مَتْشْ،</para>
  <para style="q" vid="PSA 148:3">تُنبُي دّشّشِيٍ قَن شَ عَ مَتْشْ.<verse eid="PSA 148:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 148:4"/>كٌورٍ شَ عَ مَتْشْ، عَ نُن يٍ نَشَن تٌمَ نَا.<verse eid="PSA 148:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 148:5"/>عٍ بِرِن شَ عَلَتَلَ شِلِ مَتْشْ،</para>
  <para style="q" vid="PSA 148:5">بَرِ مَ عَ يَمَرِ نَن قِ، عٍ نَشَ دَا.<verse eid="PSA 148:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 148:6"/>عَ نَشَ عٍ تِ عٍ تِدٍ، عٍ شَ لُ نَا عَبَدَن.</para>
  <para style="q" vid="PSA 148:6">عَ نَشَ نَ سّرِيّ سَ، نَشَن مُ كَنَمَ.<verse eid="PSA 148:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="PSA 148:7"/>وٌ عَلَتَلَ مَتْشْ كٍلِقٍ بْشِ مَ.</para>
  <para style="q" vid="PSA 148:7">بَا نُن نِمَسٍ بِرِن نَشٍيٍ نَ بَا تِلِنيِ كُي،<verse eid="PSA 148:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 148:8"/>سٍيَمَكْنيِ، بَلَبَلَنيِ، كُندَ، نُشُييٍ،</para>
  <para style="q" vid="PSA 148:8">نُن قٌيٍ شُنفبٍ نَشَن عَ شَ يَامَرِ رَتِنمّمَ،<verse eid="PSA 148:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 148:9"/>فٍيَيٍ نُن تٍنتٍنيِيٍ، وُرِ بٌفِلَيٍ نُن سّدِرِ بِلِيٍ،<verse eid="PSA 148:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 148:10"/>وُلَءِ سُبٍيٍ نُن شُرُ سٍيٍ، بُبُسٍيٍ نُن شْنِيٍ،<verse eid="PSA 148:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 148:11"/>دُنِحَ مَنفّيٍ نُن سِيٍ،</para>
  <para style="q" vid="PSA 148:11">مَنفّدِيٍ نُن دُنِحَ كُنتِفِيٍ،<verse eid="PSA 148:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 148:12"/>قٌنِكٍيٍ نُن فِنّدِ مّدِيٍ، دِ مّيٍ نُن قٌرِيٍ،<verse eid="PSA 148:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 148:13"/>عٍ بِرِن شَ عَلَتَلَ شِلِ مَتْشْ،</para>
  <para style="q" vid="PSA 148:13">بَرِ مَ عَ شِلِ فبَنسَن نَن عِتٍشِ،</para>
  <para style="q" vid="PSA 148:13">عَ نْرّ دَنفِ كٌورٍ نُن بْشِ رَ.<verse eid="PSA 148:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="PSA 148:14"/>عَ بَرَ مَنفّ سّنبّمَ رَكٍلِ عَ شَ حَمَ شُن نَ،</para>
  <para style="q" vid="PSA 148:14">عَ شَ سّنِيّنتْييٍ نَشَن مَتْشْمَ،</para>
  <para style="q" vid="PSA 148:14">سّنِيّنتْييٍ نَشَن قِندِشِ عِسِرَيِلَ عَ شَ حَمَ شَنُشِ رَ.</para>
  <para style="b" vid="PSA 148:14"/>
  <para style="q" vid="PSA 148:14">وٌ عَلَتَلَ مَتْشْ!<verse eid="PSA 148:14"/></para>
  <chapter eid="PSA 148"/>
  <chapter number="149" style="c" sid="PSA 149"/>
  <para style="s1">بّيتِ نّينّ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 149:1"/>وٌ عَلَتَلَ مَتْشْ!</para>
  <para style="b" vid="PSA 149:1"/>
  <para style="q" vid="PSA 149:1">وٌ بّيتِ نّينّ بَ عَ بّ،</para>
  <para style="q" vid="PSA 149:1">وٌ مَتْشْي رَبَ عَ بَتُلَيٍ تَفِ.<verse eid="PSA 149:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 149:2"/>عِسِرَيِلَ شَ سّيوَ عَ دَالِ مَرِفِ رَ.</para>
  <para style="q" vid="PSA 149:2">سِيٌنِ حَمَ شَ سّيوَ عٍ شَ مَنفّ رَ.<verse eid="PSA 149:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 149:3"/>عٍ شَ عَ شِلِ مَتْشْ قَرٍ بٌرٌن يِ رَ،</para>
  <para style="q" vid="PSA 149:3">عٍ شَ بّيتِيٍ بَ مَشَسٍ نُن كْرَ شُي رَ،<verse eid="PSA 149:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 149:4"/>بَرِ مَ عَلَتَلَ سّيوَشِ عَ شَ حَمَ رَ،</para>
  <para style="q" vid="PSA 149:4">عَ كِسِ قِمَ نّ يّتّ مَفٌرٌي مَ.<verse eid="PSA 149:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 149:5"/>عَ شَ سّنِيّنتْييٍ شَ سّيوَ يِ بِنيّ رَ،</para>
  <para style="q" vid="PSA 149:5">عٍ شَ عٍ سّيوّ شُي عِتٍ هَلِ عٍ شَ سَدٍيٍ مَ.<verse eid="PSA 149:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 149:6"/>عَلَ مَتْشْي شَ لُ عٍ دّ عِ.</para>
  <para style="q" vid="PSA 149:6">نَ لُشِ عَلْ سَنتِدّفّمَ شَاحّشِ عٍ بّلّشّ كُي،<verse eid="PSA 149:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 149:7"/>عٍ نَشَن نَوَلِمَ عٍ فبٍ حْشْقٍ رَ،</para>
  <para style="q" vid="PSA 149:7">سِ حَاشِيٍ حَشَنكَتَقٍ رَ.<verse eid="PSA 149:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 149:8"/>عٍ عٍ يَشُييٍ شَ مَنفّيٍ سَمَ نّ يْلْنشْنيِيٍ رَ،</para>
  <para style="q" vid="PSA 149:8">عٍ عٍ شَ يَرٍرَتِيٍ شِرِ مَ نّ عَ شْرْشْي رَ،<verse eid="PSA 149:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 149:9"/>نَ قَ قِندِ عٍ شَ كٌبِحَ سَرٍ رَ.</para>
  <para style="q" vid="PSA 149:9">شُننَكٍلِ بٍلٍبٍلٍ نَن نَ كِ عَلَ شَ سّنِيّنتْييٍ بّ.</para>
  <para style="b" vid="PSA 149:9"/>
  <para style="q" vid="PSA 149:9">وٌ شَ عَلَتَلَ مَتْشْ!<verse eid="PSA 149:9"/></para>
  <chapter eid="PSA 149"/>
  <chapter number="150" style="c" sid="PSA 150"/>
  <para style="s1">بِرِن عَلَ مَتْشْقٍ</para>
  <para style="s2">عَلَ مَتْشْي</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 150:1"/>وٌ عَلَتَلَ مَتْشْ!</para>
  <para style="b" vid="PSA 150:1"/>
  <para style="q" vid="PSA 150:1">وٌ شَ عَلَ مَتْشْ عَ شَ هْرْ مْبَنشِ كُي.</para>
  <para style="q" vid="PSA 150:1">وٌ شَ عَ مَتْشْ كٌورٍ مَ.<verse eid="PSA 150:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 150:2"/>وٌ شَ عَ مَتْشْ عَ شَ كَابَنَكٌي شَ قٍ رَ.</para>
  <para style="q" vid="PSA 150:2">وٌ شَ عَ مَتْشْ عَ سّنبّ شُنفبٍ شَ قٍ رَ.<verse eid="PSA 150:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="PSA 150:3"/>وٌ شَ عَ مَتْشْ قٍرِ شُي نُن كْرَ شُي رَ،<verse eid="PSA 150:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 150:4"/>وٌ شَ عَ مَتْشْ مَشَسٍ نُن قَرٍ بٌرٌن يِ رَ،</para>
  <para style="q" vid="PSA 150:4">وٌ شَ عَ مَتْشْ كْرَ مَنِيّ نُن شُلٍ شُي رَ،<verse eid="PSA 150:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 150:5"/>وٌ شَ عَ مَتْشْ مَشَسٍ شُي عِتٍشِ رَ.<verse eid="PSA 150:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="PSA 150:6"/>نِمَسٍ بِرِن شَ عَلَتَلَ مَتْشْ.</para>
  <para style="b" vid="PSA 150:6"/>
  <para style="q" vid="PSA 150:6">وٌ عَلَتَلَ مَتْشْ!<verse eid="PSA 150:6"/></para>
  <chapter eid="PSA 150"/>
</usx>
