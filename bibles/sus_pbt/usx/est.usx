<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="EST" style="id"/>
  <para style="h">عٍسِتَ شَ تَرُشُي</para>
  <para style="toc1">عٍسِتَ شَ تَرُشُي</para>
  <para style="toc2">عٍسِتَ شَ تَرُشُي</para>
  <para style="toc3">عٍست</para>
  <para style="mt">عٍسِتَ شَ تَرُشُي</para>
  <para style="imt1">مَسٍنيِ ندٍ يِ كِتَابُي شَ قٍ رَ</para>
  <para style="ip">عَلَتَلَ نُ بَرَ عِسِرَيِلَ بْنسْي سَ عٍ يَشُي بَبِلْنكَيٍ سَفٌي عٍ شَ يُنُبِيٍ شَ قٍ رَ. عٍ نَشَ بُ نَا كٌنيِيَ كُي حّ وُيَشِيٍ بُن مَ. عَ رَحْنيِ سِ فبّتّيٍ قَن نَشَ نْ يُوِقِ يَشُي سِنفٍيٍ رَ، يُوِقِيٍ قَ لُ نٍيٍ شَ مَنفّيَ بُن مَ. يِ كِتَابُي قٍ قَلَمَ نَشَن دَنفِ ثٍرِ سٍ بْشِ مَ يُوِقِ ندٍيٍ شَ قٍ رَ، نَشٍيٍ نُ شِلِ مٌرٌدٍكَيِ نُن عٍسِتَ.</para>
  <para style="ip">يُوِقِيٍ شَ دِينّ نُ سّرِيّ ندٍ مَسٍنمَ، نَشَن مُ نُ رَقَنشِ كَاقِرِ سّنبّمَ ندٍ مَ ثٍرِ سٍ بْشِ مَ، نَشَن نُ شِلِ هَمَن. عَ نُ وَ مَ مِشِ بِرِن شَ عَ شِنبِ سِن بْشِ مَ عَ بِنيَقٍ رَ، كْنْ مٌرٌدٍكَيِ مُ نُ وَ مَ نَ رَبَقٍ، بَرِ مَ عَ نُ نَ مْولِ رَبَمَ عَلَتَلَ فبَنسَن نَن بّ. نَ كُي يُوِقِيٍ شَ قٍ مُ نُ رَقَنشِ عَ مَ، عَ قَ نَتّ تٌنفٌ عَ شَ عٍ تْورْ.</para>
  <para style="ip">كْنْ عَلَ مّينِمَ عَ شَ حَمَ مَ، عَ عٍ مَلِ عٍ شَ تْورّ كُي. مٌرٌدٍكَيِ تَارَ شَ دِ فِنّمَ عٍسِتَ نُ بَرَ قِندِ ثٍرِ سٍ مَنفّ فِنّ رَ عَ شَ تٌقَنيِ نُن عَ شَ تِنشِنيِ شَ قٍ رَ. نَ قٍ نَشَ عَ نِيَ عَ شَ نْ مَنفّ شُنفبٍ مَيَندِدٍ عَ شَ عَ مَلِ يِ قٍ كُي. هَمَن وَشْنقٍ حَاشِ مُ سْونّيَ، بَرِ مَ عَلَ نُ بَرَ عَ شَ مِشِ عٍسِتَ لُ ثٍرِ سٍ مَنفّ سّيتِ مَ عَلَ وَشْن وَشَتِ مَ. عَلَ شَ مَنفّيَ فبٌ مَنفّيَ بِرِن بّ. عَمِنَ.</para>
  <para style="imte">عٍسِتَ شَ تَرُشُي</para>
  <chapter number="1" style="c" sid="EST 1"/>
  <para style="s">مَنفّ فِنّ قَسَتِ تٌندِقٍ مَنفّ عَسُيٍرُ سُ بّ</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 1:1"/>مَنفّ ندٍ نُ نَ نَشَن نُ شِلِ عَسُيٍرُ سُ. عَ شَ مَنفّيَ قْلْ عِنِدِيَ بْشِ نَن مَ، هَن عَ سَ دْشْ عٍتِيٌثِ بْشِ رَ. بْشِ كّمّ مْشْحّن نُن سٌلٌقٍرٍ نَن نُ نَ عَ شَ نْي بُن مَ. <verse eid="EST 1:1"/><verse number="2" style="v" sid="EST 1:2"/>نَ وَشَتِ، عَ نُ دْشْشِ سُسٍ نّ، عَ شَ مَنفَتَا.<verse eid="EST 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EST 1:3"/>عَ شَ مَنفّيَ حّ سَشَن ندٍ، عَ نَشَ شُلُنيِ تِ عَ شَ مَنفّدِيٍ نُن عَ شَ وَلِكّيٍ بّ. ثٍرِ سٍ نُن مٍدِيَ سْورِ مَنفّيٍ، كُنتِفِيٍ، نُن بْشِ فٌمِنَيٍ نَشَ قَ. <verse eid="EST 1:3"/><verse number="4" style="v" sid="EST 1:4"/>مَنفّ عَسُيٍرُ سُ نَشَ عَ شَ نَاقُلِ، نُن عَ شَ دَرِيّ مَسٍن عٍ بّ شِ كّمّ تٌنفٌ سٌلٌمَسَشَن بُن مَ.<verse eid="EST 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EST 1:5"/>نَ تٌ دَنفِ، مَنفّ نَشَ شُلُنيِ تِ سُسٍكَ بِرِن بّ عَ شَ تّتّ كُي. شِ سٌلٌقٍرٍ بُن مَ، بَننَ نُن سٍتَرٍ بِرِن نَشَ قَ نَ شُلُنيِ. <verse eid="EST 1:5"/><verse number="6" style="v" sid="EST 1:6"/>مَنفّ بَنشِ نَشَ رَقٍ كِ قَنيِ رَ. دُفِ قِيشّيٍ نُن دُفِ قْورّيٍ نُ فبَكُشِ لُوتِ قِيشّيٍ نُن لُوتِ فبٍيلِيٍ رَ. دُفِيٍ فبَكُشِ لُوتِيٍ مَ فبٍتِ شُرُندّيٍ رَ. نَ بِرِن نُ شِرِشِ فّمّ دْشْشِ تٌقَنيِيٍ رَ. شّيمَ كِبَنيِ نُن فبٍتِ كِبَنيِ تٌقَنيِيٍ نُ نَ. بْشِ فبَاتَ نُ يَءِلَنشِ فّمّ تٌقَنيِ مْولِ مْولِيٍ رَ. <verse eid="EST 1:6"/><verse number="7" style="v" sid="EST 1:7"/>مَنفّ نَشَ وّنِ فبٍفبٍ عِتَشُن مِشِيٍ مَ، عٍ شَ نَ مِن شّيمَ ثْوتِ مْولِ وُيَشِيٍ كُي. <verse eid="EST 1:7"/><verse number="8" style="v" sid="EST 1:8"/>وّنِ شَسَبِ نَشَن عٍ كّنّن، عٍ نَشَ نَ مِن، بَرِ مَ مَنفّ نُ بَرَ عَ شَ وَلِكّيٍ يَمَرِ، عٍ شَ مِشِيٍ وَشْنقٍ رَبَ.<verse eid="EST 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EST 1:9"/>مَنفّ فِنّ قَسَتِ قَن نَشَ شُلُنيِ تِ فِنّيٍ بّ مَنفّ عَسُيٍرُ سُ شَ بَنشِ كُي.<verse eid="EST 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EST 1:10"/>شُلُنيِ شِ سٌلٌقٍرٍ ندٍ، مَنفّ عَسُيٍرُ سُ تٌ سِيسِ وّنِ رَ، عَ نَشَ عَ شَ بَتُلَ سٌلٌقٍرٍ شِلِ. يِ شّمّ سٌلٌقٍرٍ نُ شِلِ مٍهُمَن، بِسِتَ، شَرَبٌنَ، بِفِتَ، عَبَفِتَ، سّتَرِ، نُن كَرَكَسِ. <verse eid="EST 1:10"/><verse number="11" style="v" sid="EST 1:11"/>مَنفّ نَشَ عَ قَلَ عٍ بّ، عٍ شَ قَ مَنفّ فِنّ قَسَتِ رَ عَ شْن مَ. عَ شَ عَ مَشِرِ عَ قَنيِ رَ، مَنفّ فِنّ تْنشُمَ شَ دْشْ عَ شُن مَ، عَلَكٌ حَمَ نُن مَنفّدِ بِرِن شَ عَ شَ تٌقَنيِ تٌ. فِنّ تٌقَنيِ نَن نُ نَ قَسَتِ رَ. <verse eid="EST 1:11"/><verse number="12" style="v" sid="EST 1:12"/>كْنْ مَنفّ فِنّ قَسَتِ نَشَ تٌندِ مَنفّ شَ يَامَرِ رَ، شّيرَيٍ نَشَن مَسٍن عَ بّ. نَ نَشَ مَنفّ شْنْ كِ قَنيِ.<verse eid="EST 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EST 1:13"/>عَوَ، مَنفّ نَشَ عَ شَ لْننِلَ سٌلٌقٍرٍ شِلِ نَشٍيٍ نُ سّرِيّ نُن نَامُنيِ كٌلٌن عَ قَنيِ رَ. <verse eid="EST 1:13"/><verse number="14" style="v" sid="EST 1:14"/>يِ مَنفّدِ سٌلٌقٍرٍ نَن يَ؛ كَسّنَ، سّتَرَ، عَدَ مَتَ، تَرَ سِسِ، مّرّ سِ، مَرَ سٍنَ، نُن مٍمُكَن. يِ مٍدِيَكَيٍ نُن ثٍرِ سٍكَيٍ تِدٍ نُ فبٌ بِرِن بّ، بَرِ مَ عٍ تَن نَن نُ نَ مَنفّ سّيتِ مَ. <verse eid="EST 1:14"/><verse number="15" style="v" sid="EST 1:15"/>مَنفّ نَشَ عٍ مَشْرِن، «ﭑ تَن مَنفّ عَسُيٍرُ سُ بَرَ شّيرَيٍ رَ سِفَ مَنفّ فِنّ قَسَتِ مَ عَ شَ قَ، كْنْ عَ بَرَ تٌندِ ﭑ مَ يَامَرِ سُشُدٍ. سّرِيّ كِ مَ، عَ لَنمَ ﭑ شَ مُنسٍ رَبَ عَ رَ؟»<verse eid="EST 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EST 1:16"/>مٍمُكَن نَشَ عَ مَسٍن مَنفّ نُن مَنفّدِيٍ بّ، «مَنفّ فِنّ قَسَتِ مُ قٍ حَاشِ رَبَشِ عِ تَن مَنفّ فبَنسَن شَ رَ، عَ مَن بَرَ قٍ حَاشِ رَبَ مَنفّدِيٍ نُن حَمَيٍ رَ نَشٍيٍ نَ عِ شَ مَنفّيَ بُن مَ. <verse eid="EST 1:16"/><verse number="17" style="v" sid="EST 1:17"/>فِنّيٍ نَ عَ مّ تّمُي نَشّ، مَنفّ فِنّ بَرَ عَ شَ مْرِ مَتَندِ، بْشِ فِنّيٍ بِرِن قَن لُمَ نّ عٍ شَ مْرِيٍ مَتَندِ رَ. فِنّيٍ عَ قَلَمَ نّ، ‹مَنفّ عَسُيٍرُ سُ شّيرَ رَ سِفَ نّ مَنفّ فِنّ قَسَتِ مَ عَ شَ قَ، كْنْ عَ مُ تِن.› <verse eid="EST 1:17"/><verse number="18" style="v" sid="EST 1:18"/>ثٍرِ سٍ نُن مٍدِيَ مَنفّدِيٍ شَ فِنّيٍ نَ يِ قٍ مّ تّمُي نَشّ، عٍ قَن تٌندِ مَ نّ عٍ شَ مْرِيٍ بِنيَدٍ. نَ نَ رَبَ مَرَحَاشُي نُن بِنيَتَرٍحَ مُ حْنمَ. <verse eid="EST 1:18"/><verse number="19" style="v" sid="EST 1:19"/>مَنفّ، شَ عِ بَرَ تِن، عَ لَنمَ عِ شَ مَنفّ فِنّ قَسَتِ يَمَرِ عَ نَشَ قَ عِ يِرٍ سْنْن. فِنّ فبّتّ تٌنفٌ نَشَن قِسَ عَ بّ، نَ شَ قِندِ مَنفّ فِنّ رَ. نَ يَامَرِ شَ سّبّ ثٍرِ سٍكَيٍ نُن مٍدِيَكَيٍ شَ سّرِيّ كُي، نَشَن مُ نْمَ مَسَرَدٍ. <verse eid="EST 1:19"/><verse number="20" style="v" sid="EST 1:20"/>فِنّ بِرِن نَ يِ يَامَرِ شُنفبٍ مّ عِ شَ مَنفّيَ بُن مَ، عٍ قَمَ نّ عٍ شَ مْرِيٍ بِنيَدٍ كِ قَنيِ رَ، كٍلِقٍ فِنّ شُرِ مَ، هَن فِنّ شُنفبٍ.»<verse eid="EST 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EST 1:21"/>نَ مَرَ سِ نَشَ رَقَن مَنفّ نُن مَنفّدِيٍ مَ. عَسُيٍرُ سُ نَشَ عَ رَبَ عَلْ مٍمُكَن عَ قَلَ كِ نَشّ. <verse eid="EST 1:21"/><verse number="22" style="v" sid="EST 1:22"/>عَ نَشَ بَتَاشّيٍ رَ سَنبَ عَ شَ بْشِ بِرِن مَ عٍ فبٍ سّبّلِ رَ نُن عٍ يّتّ بَرِ شُي رَ. نَ كّيدِ نَشّ عَ شّمّ بِرِن شَ قِندِ دٍنبَيَ شُنيِ رَ، عَ نُن عَ شَ دٍنبَيَ مِشِ بِرِن شَ عَ بَرِ شُي قَلَ.<verse eid="EST 1:22"/></para>
  <chapter eid="EST 1"/>
  <chapter number="2" style="c" sid="EST 2"/>
  <para style="s">عٍسِتَ قِندِقٍ مَنفّ فِنّ رَ</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 2:1"/>نَ دَنفِ شَنبِ، مَنفّ بْحّ نَشَ فٌرٌ. عَ نَشَ رَتُ مَنفّ فِنّ قَسَتِ شَ قٍ رَبَشِ مَ، عَ نُن عَ يّتّ نَتّ نَشَن تٌنفٌشِ عَ شَ قٍ رَ. <verse eid="EST 2:1"/><verse number="2" style="v" sid="EST 2:2"/>مَنفّ شَ بَتُلَيٍ نَشَ عَ قَلَ عَ بّ، «فِنّدِ مّدِ تٌقَنيِ ندٍيٍ شَ قٍن عِ بّ. <verse eid="EST 2:2"/><verse number="3" style="v" sid="EST 2:3"/>يَامَرِ قِ عِ شَ بْشِ بِرِن مَ، عٍ شَ قَ فِنّدِ مّدِ تٌقَنيِيٍ بِرِن نَ عِ شَ مَنفَتَا سُسٍ. عٍ شَ لُ عِ شَ فِنّيٍ شَ بَنشِ كُي. هٍفٍ، عِ شَ وَلِكّ بَنَشِ نَشَن مّينِمَ عِ شَ فِنّيٍ مَ، نَ شَ عَ حّنفِ سَ عٍ شْن مَ، عَلَكٌ ندٍ شَ سَ عٍ شَ تٌقَنيِ شُن مَ. <verse eid="EST 2:3"/><verse number="4" style="v" sid="EST 2:4"/>فِنّ نَشَن نَ رَقَن عِ مَ عٍ يَ مَ، نَ شَ قِندِ مَنفّ فِنّ قَسَتِ حْشْي رَ.» يِ وْيّنيِ نَشَ مَنفّ كّنّن، عَ نَشَ نَ رَبَ.<verse eid="EST 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EST 2:5"/>يُوِقِ ندٍ نُ نَ سُسٍ نَشَن نُ شِلِ مٌرٌدٍكَيِ. عَ قِندِ يَيِرِ شَ دِ نَن نَ، سِمٍيِ شَ مَمَدِ، كِسُ تٌلٌبِتّ كٍلِقٍ بُنيَمِن بْنسْي مَ. <verse eid="EST 2:5"/><verse number="6" style="v" sid="EST 2:6"/>بَبِلْن مَنفّ نٍبُكَدَنسَرِ نَن قَ عَ رَ كٌنيِيَ كُي، عَ نُن يُدَيَ مَنفّ يٍكٌنِيَ نُن عِسِرَيِلَكَ فبّتّيٍ. <verse eid="EST 2:6"/><verse number="7" style="v" sid="EST 2:7"/>مٌرٌدٍكَيِ بَبَ شُنيَ شَ دِ فِنّ هَدَ سَ، عٍ نُ نَشَن مَ عٍسِتَ، عَ نُ نَ مٌرٌدٍكَيِ نَن يِ رَ، كَبِ عَ بَبَ نُن عَ نفَ قَشَ تّمُي. عَ نَشَ عَ شُرُ، عَ عَ قِندِ عَ شَ دِ رَ. فِنّدِ مّدِ تٌقَنيِ نَن نُ عَ رَ.<verse eid="EST 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EST 2:8"/>مَنفّ شَ يَامَرِ تٌ مَسٍن عَ شَ بْشِ مِشِيٍ بّ، عٍ نَشَ قَ دِ فِنّ وُيَشِ رَ هٍفٍ شْن مَ سُسٍ. عٍسِتَ نُ نَ عٍ يَ مَ. <verse eid="EST 2:8"/><verse number="9" style="v" sid="EST 2:9"/>عَ تٌ رَقَن هٍفٍ مَ، هٍفٍ نَشَ قَتٍ رَتٌقَن تُرٍ، دٌنسٍ قَنيِ، نُن كٌنيِ فِنّ سٌلٌقٍرٍ سٌ عَ يِ رَ. عَ نَشَ عٍ يِفِيَ مَنفّ شَ فِنّيٍ شَ بَنشِ كُي دّننَشّ قَن يِرٍ بِرِن بّ.<verse eid="EST 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EST 2:10"/>عٍسِتَ نُ قَتَنشِ بْنسْي نُن سِ نَشَن نَ، عَ مُ نَ مَسٍن مِشِ يٌ بّ، بَرِ مَ مٌرٌدٍكَيِ نُ بَرَ نَ تْنيِ دْشْ عَ مَ. <verse eid="EST 2:10"/><verse number="11" style="v" sid="EST 2:11"/>لْشْي بِرِن مٌرٌدٍكَيِ نُ عَ مَكْرّ مَ مَنفّ شَ فِنّيٍ شَ بَنشِ رَ، عَ شَ عٍسِتَ شَ قٍ شِبَارُي كٌلٌن.<verse eid="EST 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EST 2:12"/>نَ فِنّيٍ بِرِن نَشَ كِكٍ قُ نُن قِرِن نَبَ مَنفّ شَ فِنّيٍ شَ بَنشِ كُي. كِكٍ سٍننِ بُن مَ، تُرٍ نُن لَبُندّ مْولِ ندٍيٍ نُ مَسٌمَ عٍ مَ. نَ دَنفِ شَنبِ، تُرٍ نُن لَبُندّ مْولِ فبّتّيٍ نُ مَسٌمَ عٍ مَ. نَ حّ كٍرٍن تٌ كَمَلِ، فِنّيٍ نَشَ نْ عٍ يّتّ مَسٍندٍ مَنفّ بّ. <verse eid="EST 2:12"/><verse number="13" style="v" sid="EST 2:13"/>فِنّيٍ نّ سِفَمَ مَنفّ شْن مَ، عٍ وَ سٍسٍ شَنِنقٍ عٍ شُن مَ، عٍ نُ نَ سٌمَ نّ عٍ يِ رَ. <verse eid="EST 2:13"/><verse number="14" style="v" sid="EST 2:14"/>فِنّيٍ نُ سٌمَ مَنفّ شْنيِ نُنمَرٍ تّمُي نّ، عٍ قَ فبِلٍن مَنفّ شَ فِنّيٍ شَ بَنشِ قِرِن ندٍ كُي. مّننِ مَنفّ شَ كٌنيِ بَنَشِ سَاسَفَسِ نُ مّينِمَ عٍ مَ. نَ شَنبِ عٍ مُ فبِلٍنمَ مَنفّ شْنيِ، قٌ نَشَن نَ عَ كّنّن عٍ يَ مَ، عَ نَ شِلِ.<verse eid="EST 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EST 2:15"/>عَبِشَيِلِ شَ دِ عٍسِتَ، مٌرٌدٍكَيِ نَشَن شُرُشِ، نَ شَ تّمُي تٌ عَ لِ سِفَقٍ رَ مَنفّ شْنيِ، عَ مُ سٍسٍ شَنِن عَ شُن مَ قٌ مَنفّ شَ وَلِكّ هٍفٍ نَشَن قَلَ عَ بّ. عٍسِتَ نُ رَقَن مِشِ بِرِن مَ. <verse eid="EST 2:15"/><verse number="16" style="v" sid="EST 2:16"/>عٍ نَشَ عٍسِتَ رَ سٌ مَنفّ عَسُيٍرُ سُ شُن مَ عَ شَ مَنفّيَ حّ سٌلٌقٍرٍ ندٍ رَ، تٍبٍتِ كِكٍ قُ ندٍ رَ. <verse eid="EST 2:16"/><verse number="17" style="v" sid="EST 2:17"/>عٍسِتَ نَشَ رَقَن مَنفّ مَ دَنفِ فِنّيٍ بِرِن نَ. عَ شَ شَنُنتٍيَ تٌ لُ مَنفّ بْحّ كُي دَنفِ فِنّدِ مّدِيٍ بِرِن نَ، عَ نَشَ عَ قِندِ مَنفّ فِنّ قَسَتِ حْشْي رَ. <verse eid="EST 2:17"/><verse number="18" style="v" sid="EST 2:18"/>مَنفّ نَشَ شُلُنيِ بٍلٍبٍلٍ تِ عٍسِتَ بّ، عَ عَ شَ كُنتِفِيٍ نُن عَ شَ وَلِكّيٍ بِرِن شِلِ. عَ نَ لْشْي قِندِ مَلَبُي لْشْي رَ عَ شَ حَمَ بّ، عَ عٍ بِرِن بُحَ مَنفّ كِ مَ.<verse eid="EST 2:18"/></para>
  <para style="s">مٌرٌدٍكَيِ مَنفّ رَتَنفَقٍ</para>
  <para style="p">
    <verse number="19" style="v" sid="EST 2:19"/>فِنّدِ مّدِيٍ تٌ مَلَن سَنيَ قِرِن ندٍ رَ، مٌرٌدٍكَيِ نُ دْشْشِ مَنفّ شَ بَنشِ نَادّ رَ. <verse eid="EST 2:19"/><verse number="20" style="v" sid="EST 2:20"/>عٍسِتَ مُ نُ عَ بْنسْي نُن عَ شَ مِشِيٍ شَ قٍ قَلَشِ مِشِ يٌ بّ، عَلْ مٌرٌدٍكَيِ نُ بَرَ عَ يَمَرِ كِ نَشّ. عٍسِتَ نُ لُمَ عَ شُي سُشُ رَ، عَلْ عَ دَرِشِ عَ رَ كِ نَشّ كَبِ عَ دِ مّدِ تّمُي.<verse eid="EST 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EST 2:21"/>لْشْي ندٍ مٌرٌدٍكَيِ نُ دْشْشِ مَنفّ شَ بَنشِ نَادّ سّيتِ مَ. بِفِتَنَ نُن تّرّ سِ، نَشٍيٍ نُ نَ مَنفّ شَ بَنشِ سٌدٍ دّ مَكَنتَقٍ، عٍ نَشَ شْنْ مَنفّ عَسُيٍرُ سُ مَ، عٍ قَ نَتّ تٌنفٌ عٍ شَ عَ قَشَ. <verse eid="EST 2:21"/><verse number="22" style="v" sid="EST 2:22"/>مٌرٌدٍكَيِ تٌ نَ مّ، عَ نَشَ عَ قَلَ مَنفّ فِنّ عٍسِتَ بّ، عَلَكٌ عَ شَ نَ مَسٍن مَنفّ بّ عَ شِلِ رَ. <verse eid="EST 2:22"/><verse number="23" style="v" sid="EST 2:23"/>مَنفّ تٌ نَ قٍ شْن نَقٍن، عَ نَشَ عَ كٌلٌن نْندِ نَ عَ رَ. عَ نَشَ نَ شّمّ قِرِنيِيٍ فبَكُ وُرِ مَ عٍ قَشَقٍ رَ. نَ بِرِن نَشَ سّبّ تَرُشُي بُكِ كُي مَنفّ يَ شْرِ.<verse eid="EST 2:23"/></para>
  <chapter eid="EST 2"/>
  <chapter number="3" style="c" sid="EST 3"/>
  <para style="s">هَمَن وَ مَ يُوِقِيٍ قَشَقٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 3:1"/>نَ دَنفِ شَنبِ، مَنفّ عَسُيٍرُ سُ نَشَ هَمّدَتَ عَفَفَكَ شَ دِ هَمَن بِنيَ، عَ عَ تِ مَنفّدِيٍ بِرِن شُن مَ. <verse eid="EST 3:1"/><verse number="2" style="v" sid="EST 3:2"/>مَنفّ شَ مِشِيٍ بِرِن نُ عٍ شِنبِ سِنمَ هَمَن بُن مَ، عَلْ مَنفّ عٍ يَمَرِ كِ نَشّ. كْنْ مٌرٌدٍكَيِ تَن نُ تٌندِ مَ نّ عَ شِنبِ سِندٍ عَ بُن مَ، عَ مَن مُ عَ قٍلٍنمَ عَ بّ بْشِ مَ. <verse eid="EST 3:2"/><verse number="3" style="v" sid="EST 3:3"/>مَنفّ شَ مِشِيٍ نَشَ مٌرٌدٍكَيِ مَشْرِن، «عِ مَنفّ شَ يَامَرِ مَتَندِ مَ مُنقٍ رَ؟» <verse eid="EST 3:3"/><verse number="4" style="v" sid="EST 3:4"/>عٍ نُ لُمَ مٌرٌدٍكَيِ مَشْرِن نَ نَ قٍ مَ، كْنْ عَ مُ عَ تُلِ مَتِمَ عٍ رَ. سَ نَ قَرِ، عَ نُ بَرَ عَ قَلَ عٍ بّ عَ يُوِقِ نَ عَ رَ. نَ تّمُي، عٍ نَشَ نَ دّنتّفّ هَمَن بّ، عٍ شَ عَ مَتٌ عَ نَشَن نَبَمَ.<verse eid="EST 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EST 3:5"/>هَمَن تٌ عَ تٌ مٌرٌدٍكَيِ مُ تِنمَ عَ شِنبِ سِندٍ عَ بُن مَ، عَ نَشَ شْنْ كِ قَنيِ. <verse eid="EST 3:5"/><verse number="6" style="v" sid="EST 3:6"/>عَ تٌ عَ كٌلٌن، يُوِقِ نَن مٌرٌدٍكَيِ رَ، عَ مُ تِن عَ تَن فبَنسَن شَ تْورْ دٍ قَ. عَ نُ وَ مَ عَ شَ مِشِ بِرِن نَن نَهَلَكِقٍ قَ، يُوِقِ نَشٍيٍ بِرِن نُ نَ عَسُيٍرُ سُ شَ مَنفّيَ بُن مَ.<verse eid="EST 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EST 3:7"/>عَوَ، مَنفّ عَسُيٍرُ سُ شَ مَنفّيَ حّ قُ نُن قِرِن ندٍ، كِكٍ سِنفٍ، نَشَن شِلِ نِسَن، هَمَن نَشَ سٍمَتٌي مَشْرِن، عَ شَ عَ كٌلٌن عَ لَنمَ عَ شَ يُوِقِيٍ قَشَ كِكٍ نُن لْشْي نَشَن مَ. سٍمَتٌي نَشَ عَ تٌ نَ لَنشِ كِكٍ قُ نُن قِرِن ندٍ نَن مَ، نَشَن شِلِ عَدَرِ.<verse eid="EST 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EST 3:8"/>نَ تّمُي هَمَن نَشَ عَ مَسٍن مَنفّ عَسُيٍرُ سُ بّ، «سِ ندٍ نَ عِ شَ حَمَ يَ مَ، نَشَن يٍنسٍنشِ عِ شَ مَنفّيَ يِرٍ بِرِن. عٍ شَ سّرِيّ مُ لُشِ عَلْ سِ فبّتّيٍ شَ سّرِيّ، بَرِ مَ عٍ تٌندِ مَ عِ شَ يَامَرِيٍ يَتِ سُشُدٍ. عَ مُ لَنمَ عٍ شَ سَبَتِ عِ شَ بْشِ مَ. <verse eid="EST 3:8"/><verse number="9" style="v" sid="EST 3:9"/>مَنفّ، شَ عِ تِنشِ، يَامَرِ قِ عٍ شَ هَلَكِ. ﭑ تَن يَتِ بَرَ تِن كْبِرِ فبٍتِ كٌلٍ وُلُ قُ قِدٍ عِ شَ مِشِيٍ مَ نَشٍيٍ يِ وَلِ رَكَمَلِمَ.»<verse eid="EST 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EST 3:10"/>مَنفّ نَشَ عَ شَ تْنشُمَ بَ عَ بّلّشّسٌلٍ رَ، عَ نَشَ عَ سٌ هَمّدَتَ شَ دِ هَمَن يِ رَ، نَ عَفَفَكَ نَشَن نُ قِندِشِ يُوِقِيٍ يَشُي رَ. <verse eid="EST 3:10"/><verse number="11" style="v" sid="EST 3:11"/>مَنفّ نَشَ عَ قَلَ عَ بّ، «عِ شَ عِ شَ كْبِرِ رَفَتَ. عِ مَن شَ عِ وَشْنقٍ رَبَ يِ مِشِيٍ رَ.»<verse eid="EST 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EST 3:12"/>نَ كِكٍ سِنفٍ، شِ قُ نُن سَشَن ندٍ، هَمَن نَشَ مَنفّ شَ سّبّلِتِيٍ مَلَن، عٍ شَ عَ شَ يَامَرِ سّبّ مَنفّ رَ سِمَيٍ، بْشِ فٌمِنَيٍ، نُن سِ بِرِن مَنفّدِيٍ مَ. بَتَاشّيٍ نَشَ سّبّ سِ بِرِن شَ سّبّلِ كِ مَ نُن سِ بِرِن بَرِ شُي رَ. عٍ نَشَ نٍيٍ سّبّ مَنفّ عَسُيٍرُ سُ شِلِ رَ. عٍ مَن نَشَ مَنفّ شَ تْنشُمَ قْشِ سَ نَ كّيدِيٍ مَ. <verse eid="EST 3:12"/><verse number="13" style="v" sid="EST 3:13"/>شّيرَيٍ نَشَ سِفَ نَ كّيدِيٍ رَ مَنفَتَا يِرٍ بِرِن مَ. عَ نُ سّبّشِ كّيدِيٍ كُي، كِكٍ قُ نُن قِرِن ندٍ، كِكٍ نَشَن شِلِ عَدَرِ، نَ شِ قُ نُن سَشَن ندٍ، يُوِقِ بِرِن شَ قَشَ، دِ مّدِ يٌ، قٌرِ يٌ، دِيْرّ يٌ، فِنّ يٌ. عٍ سْتْسٍ بِرِن شَ لُ مِشِ فبّتّيٍ بّ. يِ بِرِن شَ رَبَ نَ لْشْي نّ. <verse eid="EST 3:13"/><verse number="14" style="v" sid="EST 3:14"/>عَ نُ لَن نّ يِ يَامَرِ شَ قِ مِشِ بِرِن مَ، عَلَكٌ عٍ شَ نْ نَ رَبَدٍ نَ لْشْي.<verse eid="EST 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EST 3:15"/>مَنفّ شَ شّيرَيٍ نَشَ سِفَ عٍ فِ رَ عَلْ مَنفّ عَ قَلَ كِ نَشّ. عَسُيٍرُ سُ نُن هَمَن نَشَ لُ يِرٍ كٍرٍن عٍ شَ وّنِ مِن، كْنْ مِشِ نَشٍيٍ نُ نَ سُسٍ مَنفَتَا، عٍ بِرِن بْحّ نَشَ مِنِ عَ عِ.<verse eid="EST 3:15"/></para>
  <chapter eid="EST 3"/>
  <chapter number="4" style="c" sid="EST 4"/>
  <para style="s">مٌرٌدٍكَيِ عٍسِتَ مَيَندِقٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 4:1"/>مٌرٌدٍكَيِ تٌ يِ قٍ بِرِن مّ، عَ نَشَ عَ شَ دُفِ عِبْو عَ مَ، عَ سُننُن دٌنمَ رَفٌرٌ عَ مَ، عَ تّ شُبٍ مَسٌ عَ قَتٍ مَ، عَ مِنِ تَا كُي عَ وَ مَ عَ شُي عِتٍشِ رَ. <verse eid="EST 4:1"/><verse number="2" style="v" sid="EST 4:2"/>عَ نَشَ سِفَ هَن مَنفّ شْنيِ، كْنْ عَ مُ نْ سٌدٍ، بَرِ مَ سُننُن دٌنمَ كَنيِ مُ دَشَ سٌقٍ نَا. <verse eid="EST 4:2"/><verse number="3" style="v" sid="EST 4:3"/>مَنفّ شَ يَامَرِ تٌ سٌ تَا بِرِن كُي، يُوِقِيٍ نَشَ وَ عٍ شُي عِتٍشِ رَ سُننُنيِ كُي. عٍ نَشَ سُننُن دٌنمَ رَفٌرٌ عٍ مَ، عٍ تّ شُبٍ مَسٌ عٍ قَتٍ مَ. عٍ نَشَ نَ بِرِن نَبَ سُنيِ كُي.<verse eid="EST 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EST 4:4"/>عٍسِتَ شَ كٌنيِ فِنّيٍ نُن شّمّ بَنَشِ نَشٍيٍ نُ مّينِمَ عَ مَ، عٍ تٌ مٌرٌدٍكَيِ شَ قٍ قَلَ عٍسِتَ بّ، سُننُنيِ نَشَ عَ بْحّ سُشُ عَ حَاشِ رَ. عَ نَشَ دُفِ ندٍ رَ سَنبَ مٌرٌدٍكَيِ مَ، كْنْ عَ مُ تِن عَ شَ سُننُن دٌنمَ رَتٍدٍ عَ مَ. <verse eid="EST 4:4"/><verse number="5" style="v" sid="EST 4:5"/>عٍسِتَ نَشَ هَتَكِ شِلِ، شّمّ بَنَشِ مَنفّ نَشَن يَمَرِ عَ شَ مّينِ عٍسِتَ مَ. عَ نَشَ عَ شّي مٌرٌدٍكَيِ شْن مَ، عَلَكٌ عَ شَ عَ كٌلٌن عَ سُننُنشِ قٍ نَشَن مَ.<verse eid="EST 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EST 4:6"/>هَتَكِ نَشَ سَ مٌرٌدٍكَيِ لِ تَا كُي مَنفّ شَ بَنشِ سٌدٍ دّ رَ. <verse eid="EST 4:6"/><verse number="7" style="v" sid="EST 4:7"/>هَمَن نَشَن نَبَ، عَ نُن عَ كْبِرِ شَسَبِ نَشَن لَايِدِ مَنفّ بّ يُوِقِيٍ قَشَقٍ رَ، مٌرٌدٍكَيِ نَشَ نَ بِرِن دّنتّفّ هَتَكِ بّ. <verse eid="EST 4:7"/><verse number="8" style="v" sid="EST 4:8"/>عَ نَشَ نَ بَتَاشّ مَسٍن عَ بّ نَشَن شَرَنشِ سُسٍ تَا كُي يُوِقِيٍ قَشَقٍ شَ قٍ رَ. مٌرٌدٍكَيِ نَشَ عَ قَلَ عَ بّ عَ شَ نَ كّيدِ سٌ عٍسِتَ يِ رَ، عَ مَن شَ دّنتّفّ سَ عَ بّ. عَ نُ وَ مَ نّ عٍسِتَ شَ مَنفّ مَيَندِ يُوِقِيٍ بّ، عَلَكٌ عَ بْنسْي نَشَ تْورْ.<verse eid="EST 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EST 4:9"/>هَتَكِ نَشَ فبِلٍن عٍسِتَ يِرٍ، عَ نَشَ مٌرٌدٍكَيِ شَ مَسٍنيِ بِرِن تَفِ رَبَ عَ بّ. <verse eid="EST 4:9"/><verse number="10" style="v" sid="EST 4:10"/>عٍسِتَ تٌ نَ مّ، عَ مَن نَشَ هَتَكِ شّي مٌرٌدٍكَيِ شْن مَ، عَ شَ سَ يِ قَلَ عَ بّ، <verse eid="EST 4:10"/><verse number="11" style="v" sid="EST 4:11"/>«مَنفّ شَ وَلِكّيٍ نُن عَ شَ مِشِ بِرِن عَ كٌلٌن فِنّ يٌ، شّمّ يٌ نَشَن سِفَمَ مَنفّ يِرٍ بٍينُ مَنفّ شَ عَ شِلِ، نَ كَنيِ لَنمَ سّرِيّ كِ مَ عَ شَ قَشَ. شَ مَنفّ سَ تِن، عَ عَ شَ سَوُرِ شّيمَ دَاشِ عِتَلَ عَ بّ، عَ نْمَ دِحّدٍ نَ كَنيِ مَ. كْنْ عَ شِ تٌنفٌ سَشَن نَن يَ، مَنفّ مُ ﭑ شِلِ!»<verse eid="EST 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EST 4:12"/>هَتَكِ تٌ نَ قَلَ مٌرٌدٍكَيِ بّ، <verse eid="EST 4:12"/><verse number="13" style="v" sid="EST 4:13"/>مٌرٌدٍكَيِ نَشَ عٍسِتَ يَابِ، عَ نَشّ، «عٍسِتَ، هَلِ عِ تٌ نَ مَنفّ نَن شْنيِ، عِ نَشَ عَ مَحْشُن دٍ عَ عِ كٍرٍن نْمَ كِسِدٍ يُوِقِيٍ يَ مَ. <verse eid="EST 4:13"/><verse number="14" style="v" sid="EST 4:14"/>شَ عِ دُندُ يِ قٍ مَ، سَابُي فبّتّ مِنِمَ نّ يُوِقِيٍ بّ، كْنْ عِ تَن نُن عِ شَبِلّ هَلَكِمَ نّ. ندٍ عَ كٌلٌن شَ عِ قِندِشِ مَنفّ فِنّ رَ يِ لْشْي يَتِ يَتِ نَن مَ قٍ رَ؟»<verse eid="EST 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EST 4:15"/>نَ كُي عٍسِتَ نَشَ مٌرٌدٍكَيِ يَابِ يِ وْيّنيِ رَ، <verse eid="EST 4:15"/><verse number="16" style="v" sid="EST 4:16"/>«سِفَ، عِ سَ سُسٍ يُوِقِيٍ بِرِن مَلَن، وٌ شَ سُنيِ سُشُ ﭑ بّ. وٌ نَشَ يٍ مِن، وٌ نَشَ وٌ دّفٍ يَنيِ سَشَن نُن كْي سَشَن بُن مَ. ﭑ تَن نُن ﭑ مَ كٌنيِيٍ قَن سُنيِ سُشُمَ نَ كِ نّ. نَ دَنفِ شَنبِ، ﭑ سِفَمَ نّ مَنفّ يِرٍ، هَلِ تْنيِ تٌ دْشْشِ نَ مَ. شَ عٍ ﭑ قَشَ، عَوَ يِرٍ.» <verse eid="EST 4:16"/><verse number="17" style="v" sid="EST 4:17"/>نَ تّمُي مٌرٌدٍكَيِ نَشَ عٍسِتَ وَشْنقٍ رَبَ، عَلْ عَ قَلَ عَ بّ كِ نَشّ.<verse eid="EST 4:17"/></para>
  <chapter eid="EST 4"/>
  <chapter number="5" style="c" sid="EST 5"/>
  <para style="s">عٍسِتَ سِفَقٍ مَنفّ عَسُيٍرُ سُ شْن مَ</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 5:1"/>سُنيِ شِ سَشَن ندٍ، عٍسِتَ نَشَ عَ مَشِرِ مَنفّ فِنّ دُفِيٍ رَ، عَ سَ سِفَ مَنفّ يِرٍ. مَنفّ نُ دْشْشِ عَ شَ كِبَنيِ كُي، عَ يَ تِشِ نَادّ رَ. <verse eid="EST 5:1"/><verse number="2" style="v" sid="EST 5:2"/>عَ تٌ مَنفّ فِنّ عٍسِتَ تٌ، عَ تِشِ نَا، عَ شَ قٍ نَشَ رَقَن عَ مَ. مَنفّ نَشَ عَ شَ سَوُرِ شّيمَ دَاشِ عِتَلَ عَ بّ، عٍسِتَ نَشَ عَ بّلّشّ دِن نَ سَوُرِ شُنيِ رَ. <verse eid="EST 5:2"/><verse number="3" style="v" sid="EST 5:3"/>مَنفّ نَشَ عَ مَشْرِن، «مَنفّ فِنّ عٍسِتَ، مُنسٍ نِيَشِ؟ عِ وَ مَ مُنسٍ شْن مَ؟ ﭑ مُ تٌندِ مَ، هَلِ عِ وَ مَ ﭑ مَ مَنفّيَ تَفِ نَن شْن مَ.»<verse eid="EST 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EST 5:4"/>عٍسِتَ نَشَ عَ يَابِ، «مَنفّ، شَ عَ سَ عِ كّنّن، ﭑ وَ مَ عَ شْن مَ وٌ نُن هَمَن شَ قَ ﭑ شْنيِ تٌ، وٌن بِرِن شَ وٌن دّفٍ عَ قَنيِ رَ عِ شَ بِنيّ بُن مَ.» <verse eid="EST 5:4"/><verse number="5" style="v" sid="EST 5:5"/>مَنفّ نَشَ شّيرَ رَ سِفَ هَمَن مَ كٍرٍن نَ، عَلَكٌ عٍ شَ سَ عٍسِتَ وَشْنقٍ رَبَ. <verse eid="EST 5:5"/><verse number="6" style="v" sid="EST 5:6"/>مَنفّ نُن هَمَن نَشَ سِفَ عٍسِتَ شْنيِ، عٍ عٍ دّفٍ يِرٍ كٍرٍن. عٍ نُ نَ وّنِ مِنقٍ تّمُي نَشّ، مَنفّ نَشَ عٍسِتَ مَشْرِن، «عٍسِتَ، عِ وَ مَ نَشَن شْن مَ، عَ قَلَ ﭑ بّ. ﭑ مُ تٌندِ مَ. عِ وَشْنقٍ نَ مُنسٍ رَ؟ هَلِ عِ وَ مَ ﭑ مَ مَنفّيَ تَفِ نَن شْن مَ، ﭑ عَ سٌمَ نّ عِ يِ رَ.» <verse eid="EST 5:6"/><verse number="7" style="v" sid="EST 5:7"/>عٍسِتَ نَشَ مَنفّ يَابِ، عَ نَشّ، «ﭑ وَ مَ نَشَن شْن مَ، <verse eid="EST 5:7"/><verse number="8" style="v" sid="EST 5:8"/>شَ عِ بَرَ تِن عَ رَ، عَ شْلِ ﭑ مَ وٌ نُن هَمَن مَن شَ قَ ﭑ شْنيِ تِنَ. نَ تّمُي، وٌن نَ فّ وٌن دّفٍدٍ، ﭑ نَ ﭑ وَشْنقٍ قَلَمَ عِ بّ.»<verse eid="EST 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EST 5:9"/>نَ لْشْي هَمَن نُ سّيوَشِ كِ قَنيِ، كْنْ عَ تٌ مٌرٌدٍكَيِ تٌ مَنفّ شَ بَنشِ سٌدٍ دّ رَ، عَ بْحّ نَشَ تٍ عَ حَاشِ رَ، بَرِ مَ مٌرٌدٍكَيِ تٌندِشِ عَ بِنيَدٍ، عَ مُ فَاشُشِ عَ يَ رَ قٍقٍ مَ. <verse eid="EST 5:9"/><verse number="10" style="v" sid="EST 5:10"/>نَ كُي هَمَن نَشَ عَ سَبَرِ، عَ فبِلٍن عَ شْنيِ. مّننِ عَ نَشَ عَ بٌورٍيٍ نُن عَ شَ فِنّ سّرّ سِ شِلِ. <verse eid="EST 5:10"/><verse number="11" style="v" sid="EST 5:11"/>عَ نَشَ عَ يّتّ عِفبٌ قْلْ عَ شَ نَاقُلِ شَ قٍ رَ، عَ شَ دِ وُيَشِ شَ قٍ رَ، نُن عَ تِدٍ شَ قٍ رَ، مَنفّ نَشَن قِشِ عَ مَ كُنتِفِيٍ نُن مَنفّدِيٍ تَفِ.<verse eid="EST 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EST 5:12"/>هَمَن نَشَ عَ قَلَ عٍ بّ، «سَقٍ نَ بِرِن شُن مَ، مَنفّ فِنّ عٍسِتَ ﭑ تَن كٍرٍن نَن شِلِ، عَ مُشُ نُن مَنفّ شَ سَ مُشُ دّفٍ عَ شْنيِ تٌ. تِنَ قَن، مُشُ مَن سِفَمَ نّ نَا. <verse eid="EST 5:12"/><verse number="13" style="v" sid="EST 5:13"/>كْنْ نَ بِرِن مُ قِندِ مَ سّيوّ رَ ﭑ بّ، دَنمِ ﭑ نَ يُوِقِ مٌرٌدٍكَيِ تٌمَ مَنفّ شَ بَنشِ سٌدٍ دّ رَ.»<verse eid="EST 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EST 5:14"/>عَ شَ فِنّ سّرّ سِ نُن عَ بٌورٍيٍ نَشَ عَ قَلَ عَ بّ، «عِ نَشَن نَبَمَ، تِنَ فّيسّفّ، عِ شَ وُرِ كُيٍ نْنفْن يَ تٌنفٌ سُولِ تِ، عِ قَ مَنفّ مَيَندِ مٌرٌدٍكَيِ شَ فبَكُ نَ كْن نَ. نَ كُي وٌ نُن مَنفّ سِفَمَ نّ عٍسِتَ شْنيِ سّيوّ كُي.» نَ قٍ نَشَ رَقَن هَمَن مَ كِ قَنيِ رَ، عَ قَ نَ وُرِ تِ نَا.<verse eid="EST 5:14"/></para>
  <chapter eid="EST 5"/>
  <chapter number="6" style="c" sid="EST 6"/>
  <para style="s">مَنفّ مٌرٌدٍكَيِ بِنيَقٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 6:1"/>نَ كْي رَ مَنفّ مُ نْ شِدٍ. عَ نَشَ شّيرَ رَ سِفَ بُكِيٍ تٌنفٌدٍ نَشٍيٍ نُ قِندِشِ مَنفّيَ شَ تَرُشُي رَ. نَ نَشَ شَرَن مَنفّ بّ. <verse eid="EST 6:1"/><verse number="2" style="v" sid="EST 6:2"/>عٍ نَشَ قٍ ندٍ شَرَن مٌرٌدٍكَيِ شَ قٍ رَ. عَ نُ بَرَ عَ كٌلٌن مَنفّ بَنشِ كَنتَمَيٍ بِفِتَنَ نُن تّرّ سِ نُ وَ مَ مَنفّ عَسُيٍرُ سُ قَشَقٍ نّ. <verse eid="EST 6:2"/><verse number="3" style="v" sid="EST 6:3"/>نَ كُي مَنفّ نَشَ عَ شَ بَتُلَيٍ مَشْرِن، «وٌن مٌرٌدٍكَيِ بِنيَ دِ نَ قٍ مَ؟» مَنفّ شَ بَتُلَيٍ نَشَ عَ يَابِ، «قٍقٍ مُ نُ رَبَ عَ بّ سِندٍن.»<verse eid="EST 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EST 6:4"/>مَنفّ مَن نَشَ عٍ مَشْرِن، «ندٍ بَشِ سٌدٍ ﭑ مَ بَنشِ كُي يَكْسِ؟» هَمَن نُ بَرَ سٌ مَنفّ شْنيِ، عَلَكٌ عَ شَ عَ مَيَندِ مٌرٌدٍكَيِ شَ فبَكُ وُرِ مَ، نَشَن نُ بَرَ فّ تِدٍ نَا. <verse eid="EST 6:4"/><verse number="5" style="v" sid="EST 6:5"/>نَ نَ عَ رَ مَنفّ شَ بَتُلَيٍ نَشَ مَنفّ يَابِ، «هَمَن نَن بٍ.» مَنفّ نَشَ عَ قَلَ عٍ بّ، «عَ شَ قَ ﭑ يِرٍ.» <verse eid="EST 6:5"/><verse number="6" style="v" sid="EST 6:6"/>هَمَن تٌ سٌ، مَنفّ نَشَ عَ مَشْرِن، «مِشِ ندٍ نَ ﭑ وَ مَ نَشَن بِنيَقٍ كِ قَنيِ. ﭑ لَن ﭑ شَ مُنسٍ رَبَ نَ كَنيِ بّ؟» هَمَن نَشَ عَ مَحْشُن عَ بْحّ مَ، «مِشِ فبّتّ مُ نَ مَنفّ وَ مَ نَشَن بِنيَقٍ بَقٍ ﭑ تَن نَ.» <verse eid="EST 6:6"/><verse number="7" style="v" sid="EST 6:7"/>نَ كُي هَمَن نَشَ مَنفّ يَابِ، «مَنفّ، عِ وَ مَ مِشِ نَشَن بِنيَقٍ، <verse eid="EST 6:7"/><verse number="8" style="v" sid="EST 6:8"/>عَ لَنمَ مَنفّ دُفِ، مَنفّ بَرَ نَشَن نَفٌرٌ عَ مَ، عَ شَ نَ رَفٌرٌ نَ مِشِ مَ. عٍ مَن شَ قَ سٌي ندٍ رَ عِ بَرَ دْشْ نَشَن قَرِ، مَنفّ تْنشُمَ سَشِ نَشَن مَ. <verse eid="EST 6:8"/><verse number="9" style="v" sid="EST 6:9"/>عِ شَ مِشِ شُنفبٍ ندٍ شَ نَ دُفِ رَفٌرٌ نَ مِشِ مَ، عِ وَ مَ نَشَن بِنيَقٍ. عَ نَ تٍ سٌي قَرِ، بٌورٍ شَ عَ رَحّرّ تَا كُي، عَ شَ سِفَ مَسٍنيِ تِ رَ، ‹وٌ عَ مَتٌ مَنفّ نَشَن نَبَمَ مِشِ بّ، عَ وَ مَ نَشَن بِنيَقٍ.›»<verse eid="EST 6:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EST 6:10"/>عَوَ، مَنفّ نَشَ عَ قَلَ هَمَن بّ، «عِ شُلُن، عِ سَ دُفِ نُن سٌي تٌنفٌ، عِ قَ عِ شَ وْيّنيِ بِرِن نَكَمَلِ مٌرٌدٍكَيِ بّ، نَ يُوِقِ نَشَن دْشْمَ مَنفّ شَ بَنشِ سٌدٍ دّ رَ. عِ نَشَ نّيمُ عِ قَلَ شُي سٍسٍ مَ.» <verse eid="EST 6:10"/><verse number="11" style="v" sid="EST 6:11"/>نَ تّمُي هَمَن نَشَ سَ دُفِ نُن سٌي تٌنفٌ. عَ نَشَ مَنفّ دُفِ رَفٌرٌ مٌرٌدٍكَيِ مَ. مٌرٌدٍكَيِ تٌ تٍ سٌي قَرِ، هَمَن نَشَ سٌي رَحّرّ تَا كُي عَ مَسٍنقٍ رَ حَمَ بّ، «‹وٌ عَ مَتٌ مَنفّ نَشَن نَبَمَ مِشِ بّ، عَ وَ مَ نَشَن بِنيَقٍ.›»<verse eid="EST 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EST 6:12"/>عٍ تٌ فّ نَ رَبَدٍ، مٌرٌدٍكَيِ نَشَ فبِلٍن مَنفّ شَ بَنشِ سٌدٍ دّ رَ، هَمَن تَن نَشَ عَ شُلُن سِفَقٍ رَ عَ شْنيِ، عَ يَتَفِ عِشْنْشِ. <verse eid="EST 6:12"/><verse number="13" style="v" sid="EST 6:13"/>هَمَن تٌ نَ بِرِن قَلَ عَ شَ فِنّ سّرّ سِ نُن عَ دّقَنبٌورٍيٍ بّ، عٍ نَشَ عَ يَابِ، «شَ يِ مٌرٌدٍكَيِ، يُوِقِ بْنسْي نَ عَ رَ، عِ مُ نْمَ تِدٍ عَ كَنكٍ. عِ قَمَ نّ عِ يّتّ شُن نَكَنَدٍ تُن!»<verse eid="EST 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EST 6:14"/>نَ تّمُي يَتِ مَنفّ شَ مِشِ ندٍيٍ نَشَ قَ عَ شِلِدٍ، عَ شَ سِفَ مَنفّ فِنّ عٍسِتَ شْنيِ عَ دّفٍدٍ.<verse eid="EST 6:14"/></para>
  <chapter eid="EST 6"/>
  <chapter number="7" style="c" sid="EST 7"/>
  <para style="s">عٍسِتَ شَ مَيَندِ</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 7:1"/>مَنفّ نُن هَمَن نَشَ سِفَ مَنفّ فِنّ عٍسِتَ شْنيِ عٍ دّفٍدٍ. <verse eid="EST 7:1"/><verse number="2" style="v" sid="EST 7:2"/>نَ سِفّ قِرِن ندٍ كُي، مَنفّ نُ وّنِ مِنمَ تّمُي نَشّ، عَ مَن نَشَ فبِلٍن عٍسِتَ مَشْرِن نَ، «عٍسِتَ، عِ وَ مَ نَشَن شْن مَ، عَ قَلَ ﭑ بّ عَلَكٌ ﭑ شَ نَ رَبَ. مُنسٍ شْلِ عِ مَ؟ هَلِ عِ وَ مَ ﭑ مَ مَنفّيَ تَفِ نَن شْن مَ، ﭑ عَ قِمَ نّ عِ مَ.»<verse eid="EST 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EST 7:3"/>مَنفّ فِنّ عٍسِتَ نَشَ عَ يَابِ، «مَنفّ، شَ عِ سَ تِن، ﭑ وَ مَ قٍ نَشَن شْن مَ، عِ شَ ﭑ تَن نُن ﭑ بْنسْي رَكِسِ. <verse eid="EST 7:3"/><verse number="4" style="v" sid="EST 7:4"/>ﭑ تَن نُن ﭑ مَ مِشِيٍ بَرَ مَتِ، عَلَكٌ مُشُ شَ هَلَكِ، مُشُ شَ قَشَ، مُشُ شَ حْن قٍوٌ. شَ عٍ مُشُ مَتِ كٌنيِيٍ فبَنسَن نَن نَ نُ، ﭑ مُ قٍقٍ قَلَمَ عِ بّ نُ، ﭑ دُندُ مَ نّ تُن، بَرِ مَ نَ قٍ مُ شْرْشْ نُ هَن ﭑ شَ مَنفّ تْورْ.»<verse eid="EST 7:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EST 7:5"/>مَنفّ عَسُيٍرُ سُ نَشَ مَنفّ فِنّ عٍسِتَ مَشْرِن كٍرٍن نَ، «ندٍ سُو سَشِ يِ قٍ مْولِ مَحْشُندٍ؟ نَ كَنيِ نَ مِندٍن؟» <verse eid="EST 7:5"/><verse number="6" style="v" sid="EST 7:6"/>عٍسِتَ نَشَ عَ يَابِ، «مُشُ يَشُي شُنفبٍ، نَشَن وَ مَ مُشُ تْورْقٍ، نَ قِندِشِ يِ هَمَن مِشِ كٌبِ نَن نَ.» هَمَن تٌ نَ وْيّنيِ مّ، فَاشُي نَشَ عَ سُشُ عَ حَاشِ رَ.<verse eid="EST 7:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EST 7:7"/>مَنفّ بْحّ نَشَ تٍ، عَ مِنِ تَندٍ مَ. هَمَن تٌ عَ كٌلٌن مَنفّ حَن بَرَ نَتّ تٌنفٌ عَ شَ قٍ رَ، عَ نَشَ لُ مَنفّ فِنّ عٍسِتَ قّ مَ، عَ شَ عَ مَيَندِ عَ شَ عَ رَكِسِ. <verse eid="EST 7:7"/><verse number="8" style="v" sid="EST 7:8"/>هَمَن تٌ عَ قٍلٍن مَنفّ فِنّ عٍسِتَ بُن مَ، مَنفّ سٌ تّمُي نَن نَ كِ كٍلِقٍ تَندٍ مَ. مَنفّ نَشَ سْنشْي رَتٍ، «يِ شّمّ نَ مُنسٍ رَبَقٍ يِ كِ؟ عَ مَن وَ مَ دُتُنقٍ مَنفّ فِنّ عٍسِتَ نَن مَ ﭑ يَ شْرِ ﭑ مَ بَنشِ كُي؟» مَنفّ قّقّ نَ وْيّنيِ قَلَ، مِشِيٍ نَشَ هَمَن يَتَفِ مَكٌتٌ، عٍ عَ شَنِن.<verse eid="EST 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EST 7:9"/>شَرَبٌنَ، مَنفّ شَ مِشِ ندٍ، نَشَ عَ قَلَ مَنفّ بّ، «هَمَن حَن بَرَ وُرِ تِ عَ شْنيِ، عَ نُ وَ مَ مٌرٌدٍكَيِ فبَكُقٍ دّننَشّ، مٌرٌدٍكَيِ نَشَن نُ بَرَ مَنفّ رَكِسِ. نَ وُرِ عِتٍ نْنفْن يَ تٌنفٌ سُولِ.» عَوَ، مَنفّ نَشَ عَ يَمَرِ، «هَمَن شَ فبَكُ مّننِ نّ.» <verse eid="EST 7:9"/><verse number="10" style="v" sid="EST 7:10"/>نَ نَ عَ رَ هَمَن نَشَ فبَكُ نَ وُرِ مَ، نَشَن نُ تِشِ مٌرٌدٍكَيِ شِلِ مَ عَ قَشَقٍ رَ. نَ دَنفِ شَنبِ، مَنفّ بْحّ نَشَ فٌرٌ.<verse eid="EST 7:10"/></para>
  <chapter eid="EST 7"/>
  <chapter number="8" style="c" sid="EST 8"/>
  <para style="s">يُوِقِيٍ شُننَكٍلِ سْتْقٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 8:1"/>نَ لْشْي مَنفّ عَسُيٍرُ سُ نَشَ يُوِقِيٍ يَشُي هَمَن شَ سٍ بِرِن قِ مَنفّ فِنّ عٍسِتَ مَ. مٌرٌدٍكَيِ نَشَ عَ يّتّ مَسٍن مَنفّ بّ، بَرِ مَ عٍسِتَ نُ بَرَ عَ قَلَ مَنفّ بّ عَ مٌرٌدٍكَيِ قِندِشِ عَ تَارَ نَن نَ. <verse eid="EST 8:1"/><verse number="2" style="v" sid="EST 8:2"/>مَنفّ نَشَ عَ شَ تْنشُمَ بَ عَ يّتّ بّلّشّ رَ، عَ نَشَن نَسُشُ هَمَن يِ، عَ عَ سٌ مٌرٌدٍكَيِ يِ رَ. عٍسِتَ نَشَ هَمَن هَرِفٍ بِرِن تَشُ مٌرٌدٍكَيِ رَ.<verse eid="EST 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EST 8:3"/>نَ تّمُي عٍسِتَ نَشَ عَ مَقٍلٍن مَنفّ بُن مَ، عَ عَ مَيَندِ عَ نَشَ هَمَن عَفَفَكَ وَشْنقٍ كٌبِ رَبَ يُوِقِيٍ رَ. <verse eid="EST 8:3"/><verse number="4" style="v" sid="EST 8:4"/>مَنفّ نَشَ عَ شَ مَنفّيَ سَوُرِ شّيمَ دَاشِ عِتَلَ عٍسِتَ مَبِرِ. نَ نَن عَ نِيَ عٍسِتَ نَشَ كٍلِ عَ تِ عَ يَ عِ. <verse eid="EST 8:4"/><verse number="5" style="v" sid="EST 8:5"/>عَ نَشَ عَ مَسٍن عَ بّ، «مَنفّ، شَ عِ تِن، شَ ﭑ مَ قٍ رَقَن عِ مَ، شَ عِ بَرَ نَتّ تٌنفٌ، شَ عِ ﭑ شَنُشِ يَندِ عِ شَ كّيدِ سّبّ نَشَن هَمّدَتَ شَ دِ عَفَفَكَ هَمَن شَ يَامَرِ كَنَمَ، يَامَرِ نَشَن قِ يُوِقِيٍ قَشَقٍ رَ عِ شَ مَنفّيَ بِرِن كُي. <verse eid="EST 8:5"/><verse number="6" style="v" sid="EST 8:6"/>ﭑ تَن مُ نْمَ ﭑ يَ تِدٍ ﭑ مَ مِشِيٍ رَ تْورّ نُن فبَلٌي شَ عٍ سْتْ.»<verse eid="EST 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EST 8:7"/>عَوَ، مَنفّ عَسُيٍرُ سُ نَشَ عَ مَسٍن مَنفّ فِنّ عٍسِتَ نُن يُوِقِ مٌرٌدٍكَيِ بّ، «ﭑ بَرَ هَمَن قَشَ، بَرِ مَ عَ نُ وَ مَ يُوِقِيٍ هَلَكِقٍ نّ. ﭑ مَن بَرَ هَمَن هَرِفٍ قِ عٍسِتَ مَ. <verse eid="EST 8:7"/><verse number="8" style="v" sid="EST 8:8"/>يَكْسِ وٌ نَشَن نَبَمَ، وٌ شَ كّيدِ سّبّ ﭑ شِلِ رَ، نَشَن نْمَ يُوِقِيٍ شَ قٍ قَندٍ. وٌ شَ ﭑ مَ مَنفّ تْنشُمَ سَ عَ مَ، بَرِ مَ شَ ﭑ مَ تْنشُمَ نَ عَ مَ، نَ يَامَرِ مُ نْمَ مَسَرَدٍ.»<verse eid="EST 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EST 8:9"/>نَ لْشْي يَتِ، عٍ نَشَ سّبّلِتِيٍ مَشِلِ. مٌرٌدٍكَيِ نَشَ يَامَرِ قِ عٍ مَ نَشَن نَبَمَ يُوِقِيٍ شَ قٍ رَ. عٍ نَشَ نَ بَتَاشّ سّبّ مَنفّ رَ سِمَيٍ، فٌمِنَيٍ، نُن مَنفّدِيٍ بِرِن مَ نَشٍيٍ نُ نَ بْشِ كّمّ مْشْحّن نُن سٌلٌقٍرٍ شُن مَ، كٍلِقٍ عِنِديَ مَ، هَن عٍتِيٌثِ. كَنكَن فبٍ نُ سّبّشِ عَ شَ سّبّلِ كِ مَ نُن عَ بَرِ شُي رَ. يُوِقِيٍ قَن نَشَ عٍ فبٍ سْتْ عٍ شَ سّبّلِ كِ مَ نُن عٍ بَرِ شُي رَ. نَ رَبَ كِكٍ سَشَن ندٍ نّ، كِكٍ نَشَن شِلِ «سِقَن،» نَ شِ مْشْحّن نُن سَشَن ندٍ لْشْي. <verse eid="EST 8:9"/><verse number="10" style="v" sid="EST 8:10"/>نَ بَتَاشّيٍ نَشَ سّبّ مَنفّ شِلِ رَ، عَ شَ تْنشُمَ نَشَ سَ عٍ مَ. شّيرَ نَشٍيٍ نُ لَن عٍ شَ بَتَاشّيٍ رَ سَنبَ، نٍيٍ نَشَ سِفَ عٍ فِ رَ مَنفّ شَ سٌي قَنيِيٍ قَرِ.<verse eid="EST 8:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EST 8:11"/>مَنفّ شَ كّيدِ عَ مَسٍن نّ، يُوِقِيٍ نْمَ عٍ مَلَندٍ عٍ شَ عٍ يّتّ شُن مَفٍرٍ. شَ مِشِ يٌ وَ مَ عٍ فٍرٍقٍ، مَنفّ بَرَ تِن يُوِقِيٍ شَ عٍ قَشَ، عٍ نُن عٍ شَ فِنّيٍ نُن عٍ شَ دِيٍ. عٍ مَن نْمَ عٍ هَرِفٍ بِرِن تٌنفٌدٍ. <verse eid="EST 8:11"/><verse number="12" style="v" sid="EST 8:12"/>يِ يَامَرِ نُ لَنشِ عَ شَ رَبَ مَنفّ عَسُيٍرُ سُ شَ مَنفّيَ بِرِن كُي، عَدَ كِكٍ، حّ كِكٍ قُ نُن قِرِن ندٍ، عَ شِ قُ نُن سَشَن ندٍ مَ. <verse eid="EST 8:12"/><verse number="13" style="v" sid="EST 8:13"/>نَ يَامَرِ نُ سّبّشِ كّيدِيٍ مَ، بْشِ يٌ بْشِ شَ عٍ فبٍ سْتْ عَلَكٌ بِرِن شَ عَ كٌلٌن، يُوِقِيٍ قَن شَ رّدِ عٍ فبٍحْشْدٍ عٍ يَشُييٍ مَ. <verse eid="EST 8:13"/><verse number="14" style="v" sid="EST 8:14"/>مَنفّ تٌ يَامَرِ قِ، شّيرَيٍ نَشَ سِفَ عٍ فِ رَ مَنفّ شَ سٌي قَنيِيٍ قَرِ. يِ يَامَرِ نَشَ شَرَن سُسٍ مَنفَتَا كُي.<verse eid="EST 8:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EST 8:15"/>مٌرٌدٍكَيِ نَشَ مِنِ مَنفّ شَ بَنشِ كُي، مَنفّ دُفِ قْورّ نُن عَ قِيشّ رَفٌرٌشِ عَ مَ، مَنفّ تْنشُمَ شّيمَ دَاشِ دْشْشِ عَ شُن مَ، نُن دٌنمَ شُنفبٍ فبٍيلِ رَفٌرٌشِ عَ مَ. سُسٍكَيٍ بِرِن نَشَ سّيوَ، عٍ عٍ شُي رَتٍ حّلّشِنيِ كُي. <verse eid="EST 8:15"/><verse number="16" style="v" sid="EST 8:16"/>يُوِقِيٍ نَشَ سّيوَ كِ قَنيِ رَ عٍ شَ شُننَكٍلِ شَ قٍ رَ. <verse eid="EST 8:16"/><verse number="17" style="v" sid="EST 8:17"/>يِرٍ بِرِن نُن تَا بِرِن مَنفّ شَ يَامَرِ شَرَنشِ دّننَشّ، يُوِقِيٍ نَشَ شُلُنيِ تِ سّيوّ كُي. مِشِ وُيَشِ نَشٍيٍ كٍلِشِ سِ فبّتّيٍ يَ مَ، عٍ نَشَ عٍ يّتّ قِندِ يُوِقِيٍ رَ، بَرِ مَ عٍ نُ بَرَ فَاشُ عٍ يَ رَ.<verse eid="EST 8:17"/></para>
  <chapter eid="EST 8"/>
  <chapter number="9" style="c" sid="EST 9"/>
  <para style="s">يُوِقِيٍ يَشُييٍ قَشَقٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 9:1"/>عَدَ كِكٍ قُ نُن قِرِن ندٍ، شِ قُ نُن سَشَن ندٍ تٌ عَ لِ، مَنفّ شَ يَامَرِ نُ لَنمَ عَ شَ رَبَ. نَ لْشْي مَ يُوِقِيٍ يَشُييٍ نُ وَ مَ عٍ مَسْتْقٍ، كْنْ قٍيٍ نَشَ مَسَرَ، يُوِقِيٍ نَشَ نْ عٍ رَ. <verse eid="EST 9:1"/><verse number="2" style="v" sid="EST 9:2"/>مَنفّ عَسُيٍرُ سُ شَ مَنفّيَ يِرٍ بِرِن، يُوِقِيٍ نَشَ عٍ مَلَن عٍ يَشُييٍ فٍرٍدٍ. مِشِ يٌ مُ نْ تِدٍ عٍ يَ رَ، سِيٍ بِرِن نَشَ فَاشُ. <verse eid="EST 9:2"/><verse number="3" style="v" sid="EST 9:3"/>بْشِ بِرِن مَنفّدِيٍ، مَنفّ رَ سِمَيٍ، فٌمِنَيٍ، نُن مَنفّ شَ مِشِيٍ نَشَ يُوِقِيٍ مَلِ، بَرِ مَ عٍ نُ فَاشُشِ مٌرٌدٍكَيِ يَ رَ. <verse eid="EST 9:3"/><verse number="4" style="v" sid="EST 9:4"/>مٌرٌدٍكَيِ نُ بَرَ قِندِ مِشِ شُنفبٍ رَ مَنفّ بَنشِ كُي. عَ شِلِ قَنيِ نَشَ يِرٍ بِرِن لِ، عَ تِدٍ شُن نُ مَسَمَ تُن. <verse eid="EST 9:4"/><verse number="5" style="v" sid="EST 9:5"/>نَ نَ عَ رَ يُوِقِيٍ نَشَ عٍ يَشُييٍ بْنبْ سَنتِدّفّمَ رَ، عٍ عٍ قَشَ. عٍ نَشَ عٍ وَشْنقٍ بِرِن نَبَ عٍ يَشُييٍ رَ.<verse eid="EST 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EST 9:6"/>يُوِقِيٍ نَشَ مِشِ كّمّ سُولِ قَشَ سُسٍ مَنفَتَا. <verse eid="EST 9:6"/><verse number="7" style="v" sid="EST 9:7"/>عٍ مَن نَشَ ثَرَ سَندَتَ، دَلِقْن، عَسِثَتَ، <verse eid="EST 9:7"/><verse number="8" style="v" sid="EST 9:8"/>ثٌرَتَ، عَدَلِيَ، عَرِدَتَ، <verse eid="EST 9:8"/><verse number="9" style="v" sid="EST 9:9"/>ثَرَ مَسَتَ، عَرِ سَيِ، عَرِدَيِ، عٍ نُن قَيٍسَتَ بِرِن قَشَ. <verse eid="EST 9:9"/><verse number="10" style="v" sid="EST 9:10"/>نَ مِشِ قُ قِندِ هَمّدَتَ شَ دِ هَمَن شَ دِيٍ نَن نَ، يُوِقِيٍ يَشُي. عٍ نَشَ نَ مِشِيٍ قَشَ، كْنْ عٍ مُ مِشِ يٌ هَرِفٍ تٌنفٌ.<verse eid="EST 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EST 9:11"/>نَ لْشْي يَتِ، مَنفّ نَشَ عَ كٌلٌن مِشِ نَشَن شَسَبِ قَشَشِ سُسٍ مَنفَتَا. <verse eid="EST 9:11"/><verse number="12" style="v" sid="EST 9:12"/>مَنفّ نَشَ عَ قَلَ مَنفّ فِنّ عٍسِتَ بّ، «يُوِقِيٍ بَرَ مِشِ كّمّ سُولِ قَشَ سُسٍ مَنفَتَا، عَ نُن هَمَن شَ دِ قُ. شَ عٍ بَرَ نَ مْولِ رَبَ يِ تَا كُي، عٍ مُنسٍ رَبَشِ يِرٍ فبّتّيٍ ﭑ مَ مَنفّيَ كُي؟ كْنْ عِ وَ مَ نَشَن شْن، ﭑ نَ رَبَمَ نّ عِ بّ. عِ وَشْنقٍ نَ مُنسٍ رَ دِ؟ نَ بِرِن نَبَمَ نّ عِ بّ.» <verse eid="EST 9:12"/><verse number="13" style="v" sid="EST 9:13"/>عٍسِتَ نَشَ عَ يَابِ، «شَ عِ بَرَ تِن، يُوِقِ نَشٍيٍ نَ سُسٍ، عٍ مَن شَ نْ عٍ فبٍحْشْدٍ تِنَ. هَمَن شَ دِ قُ شَ فبَكُ وُرِ مَ.» <verse eid="EST 9:13"/><verse number="14" style="v" sid="EST 9:14"/>مَنفّ نَشَ يَامَرِ قِ عَ شَ رَبَ عَلْ عٍسِتَ عَ قَلَشِ كِ نَشّ. نَ يَامَرِ نَشَ شَرَن سُسٍكَيٍ بّ. هَمَن شَ دِ قُ قَن نَشَ فبَكُ وُرِ مَ. <verse eid="EST 9:14"/><verse number="15" style="v" sid="EST 9:15"/>عَدَ كِكٍ شِ قُ نُن نَانِ ندٍ رَ، يُوِقِيٍ مَن نَشَ عٍ مَلَن، عٍ شّمّ كّمّ سَشَن قَشَ تَا كُي، كْنْ عٍ مُ عٍ هَرِفٍ يٌ تٌنفٌ.<verse eid="EST 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EST 9:16"/>يُوِقِ نَشٍيٍ نُ نَ بْشِ فبّتّيٍ مَ، نٍيٍ قَن نَشَ عٍ مَلَن، عٍ يّتّ شُن مَفٍرٍدٍ عٍ يَشُييٍ مَ. عٍ نَشَ عٍ يَشُي مِشِ وُلُ تٌنفٌ سٌلٌقٍرٍ عَ نُن سُولِ قَشَ، كْنْ عٍ قَن مُ نٍيٍ هَرِفٍ يٌ تٌنفٌ. <verse eid="EST 9:16"/><verse number="17" style="v" sid="EST 9:17"/>نَ بِرِن نَبَ عَدَ كِكٍ شِ قُ نُن سَشَن ندٍ نّ. عَ شِ قُ نُن نَانِ ندٍ رَ، يُوِقِيٍ نَشَ عٍ مَلَبُ سّيوّ كُي، عٍ شُلُنيِ تِ. <verse eid="EST 9:17"/><verse number="18" style="v" sid="EST 9:18"/>يُوِقِ نَشٍيٍ نُ نَ سُسٍ، نٍيٍ نَشَ عٍ يَشُييٍ فٍرٍ نَ شِ قُ نُن سَشَن ندٍ نُن قُ نُن نَانِ ندٍ مَ. عٍ نَشَ عٍ مَلَبُ سّيوّ كُي عَ شِ قُ نُن سُولِ ندٍ لْشْي، عٍ شُلُنيِ قَن تِ. <verse eid="EST 9:18"/><verse number="19" style="v" sid="EST 9:19"/>نَ نَن عَ تٌشِ يُوِقِ نَشٍيٍ نَ دَاشَيٍ، نٍيٍ شُلُنيِ تِمَ عَدَ كِكٍ شِ قُ نُن نَانِ ندٍ مَ سّيوّ كُي، كَنكَن عَ دْشْبٌورٍ بُحَمَ نَ تّمُي.<verse eid="EST 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EST 9:20"/>مٌرٌدٍكَيِ نَشَ نَ قٍ بِرِن سّبّ بَتَاشّيٍ كُي يُوِقِيٍ مَ، نَشٍيٍ نُ يِرٍ مَكُيٍيٍ نُن يِرٍ مَكْرْشِيٍ عَسُيٍرُ سُ شَ مَنفّيَ كُي. <verse eid="EST 9:20"/><verse number="21" style="v" sid="EST 9:21"/>عَ نَشَ عَ سّبّ، يُوِقِيٍ شَ عَدَ كِكٍ شِ قُ نُن نَانِ ندٍ نُن عَ شِ قُ نُن سُولِ ندٍ قِندِ سَلِ لْشْييٍ رَ حّ يٌ حّ، <verse eid="EST 9:21"/><verse number="22" style="v" sid="EST 9:22"/>بَرِ مَ عٍ عٍ يّتّ سْتْ عٍ يَشُييٍ يِ رَ نَ تّمُي نّ، عٍ شَ تْورّ قِندِ حّلّشِنيِ نَن نَ، عٍ شَ سُننُنيِ قِندِ سّيوّ نَن نَ. نَ لْشْييٍ عَ لَن نّ عٍ شَ عٍ دْشْبٌورٍيٍ بُحَ، عٍ مَن شَ سٍتَرٍيٍ كِ. <verse eid="EST 9:22"/><verse number="23" style="v" sid="EST 9:23"/>يُوِقِيٍ نَشَ مٌرٌدٍكَيِ شَ يَامَرِ سُشُ، نَ نَشَ قِندِ نَامُنيِ رَ عٍ بّ حّ يٌ حّ.<verse eid="EST 9:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EST 9:24"/>عٍ نَ بِرِن نَبَ نّ بَرِ مَ هَمّدَتَ عَفَفَكَ شَ دِ هَمَن، يُوِقِيٍ يَشُي، نُ بَرَ وَ يُوِقِيٍ بِرِن هَلَكِقٍ. عَ نُ بَرَ حّلِ بْنبْ، نَشَن شِلِ ثُرِ، عَلَكٌ عَ شَ عٍ هَلَكِ، عَ شَ عٍ سْنتْ. <verse eid="EST 9:24"/><verse number="25" style="v" sid="EST 9:25"/>كْنْ عٍسِتَ نُ بَرَ سِفَ مَنفّ يِرٍ. مَنفّ نَشَ كّيدِ سّبّ يِ كِ، «هَمَن نُ وَ مَ قٍ حَاشِ نَشَن نَبَقٍ يُوِقِيٍ رَ، نَ شَ فبِلٍن عَ مَ. عَ شَ دِيٍ قَن شَ فبَكُ وُرِ مَ.» <verse eid="EST 9:25"/><verse number="26" style="v" sid="EST 9:26"/>نَ نَن عَ تٌشِ يِ لْشْييٍ شِلِ قَلَمَ «ثُرِيٍ،» بَرِ مَ عٍ بَرِ شُي رَ عٍ حّلِ شِلِ قَلَمَ، «ثُرِ.» بَتَاشّ سّبّلِ تٌ كَمَلِ نَ كِ، <verse eid="EST 9:26"/><verse number="27" style="v" sid="EST 9:27"/>يُوِقِيٍ نَشَ نَ لْشْي قِرِنيِيٍ قِندِ سَلِ لْشْييٍ رَ. نَ نَشَ قِندِ نَامُنيِ رَ عٍ تَن نُن عٍ بْنسْي بّ، نُن مِشِيٍ بّ نَشٍيٍ سٌمَ عٍ شَ دِينّ كُي. عٍ شَ يِ لْشْي قِرِنيِيٍ بِنيَ حّ يٌ حّ، عٍ شَ قٍ بِرِن نَبَ عَلْ مٌرٌدٍكَيِ عَ يَمَرِ كِ نَشّ. <verse eid="EST 9:27"/><verse number="28" style="v" sid="EST 9:28"/>حّ نَشٍيٍ سَ قَمَ، يُوِقِيٍ شَ دٍنبَيَيٍ نَشٍيٍ نَ يِرٍ بِرِن، عٍ شَ يِ ثُرِ لْشْييٍ بِنيَ، عَلَكٌ عٍ تَن نُن عٍ بْنسْي نَشَ نّيمُ يِ قٍ دَنفِشِ مَ.<verse eid="EST 9:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EST 9:29"/>عَوَ، عَبِشَيِلِ شَ دِ عٍسِتَ، نَشَن قِندِشِ مَنفّ فِنّ رَ، عَ نُن مٌرٌدٍكَيِ، عٍ نَشَ يِ بَتَاشّ مَنفّ دَاشِ قِرِن ندٍ سّبّ ثُرِ سَلِ شَ قٍ رَ. <verse eid="EST 9:29"/><verse number="30" style="v" sid="EST 9:30"/>عٍ نَشَ بَتَاشّيٍ رَ سِفَ يُوِقِيٍ بِرِن مَ، نَشٍيٍ نُ نَ مَنفّ عَسُيٍرُ سُ شَ بْشِ كّمّ مْشْحّن نُن سٌلٌقٍرٍ بِرِن كُي، عَلَكٌ مِشِيٍ شَ حّرّ بْحّسَ نُن تِنشِنيِ كُي. <verse eid="EST 9:30"/><verse number="31" style="v" sid="EST 9:31"/>عٍ مَن نَشَ عَ مَسٍن يُوِقِيٍ بّ، عٍ شَ ثُرِ سَلِ لْشْييٍ رَبَ عَ وَشَتِ يَتِ مَ، عَلْ مٌرٌدٍكَيِ نُن مَنفّ فِنّ عٍسِتَ عٍ يَمَرِشِ كِ نَشّ. عٍ تَن نُن عٍ بْنسْي بِرِن شَ سُنيِ سُشُ، عٍ شَ عَلَ مَشَندِ. <verse eid="EST 9:31"/><verse number="32" style="v" sid="EST 9:32"/>مَنفّ فِنّ عٍسِتَ شَ يَامَرِيٍ ثُرِ سَلِيٍ شَ قٍ رَ، نَ نَشَ قِندِ سّرِيّ رَ، عٍ قَ سّبّ يِ كِتَابُي كُي.<verse eid="EST 9:32"/></para>
  <chapter eid="EST 9"/>
  <chapter number="10" style="c" sid="EST 10"/>
  <para style="s">مٌرٌدٍكَيِ نُن مَنفّ عَسُيٍرُ سُ سّنبّ</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 10:1"/>مَنفّ عَسُيٍرُ سُ نَشَ دُوتِ مَشِلِ مِشِ بِرِن مَ، كٍلِقٍ شَرٍ مَ هَن سُرِيٍ مَ. <verse eid="EST 10:1"/><verse number="2" style="v" sid="EST 10:2"/>مَنفّ سّنبّ نُن عَ شَ لِمَنِيَ بِرِن سّبّشِ ثٍرِ سٍ نُن مٍدِيَ مَنفّيٍ شَ تَرُشُي كُي. مٌرٌدٍكَيِ تِدٍ فبٌ كِ، نَ قَن سّبّشِ نَ كُي. <verse eid="EST 10:2"/><verse number="3" style="v" sid="EST 10:3"/>مٌرٌدٍكَيِ يُوِقِ نَشَ قِندِ مَنفّ عَسُيٍرُ سُ شَ مِشِ شُنفبٍ رَ، عَ مَن نَشَ قِندِ مِشِ كّندّ رَ يُوِقِيٍ بّ. عٍ نَشَ عَ شَنُ كِ قَنيِ، بَرِ مَ عَ نُ وَلِ قَنيِ رَبَمَ عٍ بّ عَلَكٌ يُوِقِيٍ شَ قٍ شَ سِفَ يَرٍ مَ.<verse eid="EST 10:3"/></para>
  <chapter eid="EST 10"/>
</usx>
