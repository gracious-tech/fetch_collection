<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="LEV" style="id"/>
  <para style="h">لٍوِ سّرّشّدُبّ</para>
  <para style="toc1">لٍوِ سّرّشّدُبّ بْنسْي شَ سّرِيّ</para>
  <para style="toc2">لٍوِ سّرّشّدُبّ</para>
  <para style="toc3">لٍو</para>
  <para style="mt">تَوُرٍتَ مُنسَ</para>
  <para style="mt">لٍوِ سّرّشّدُبّ بْنسْي شَ سّرِيّ</para>
  <para style="imt">مَسٍنيِ ندٍ يِ كِتَابُي شَ قٍ رَ</para>
  <para style="ip">عَلَتَلَ نَشَ عَ شَ سّرِيّ مَسٍن عَ شَ حَمَ بّ عَننَبِ مُنسَ سَابُي رَ. نَ سّرِيّ سّبّشِ كِتَابُي سُولِ كُي نَشٍيٍ بِرِن نَلَنشِ شِلِ قَلَمَ «تَوُرٍتَ مُنسَ.» عِسِرَيِلَ قْلْشِ كِ نَشّ نُن عٍ بِرَشِ سّرِيّ نَشَن قْشْ رَ، نَ بِرِن سّبّشِ نَ كِتَابُييٍ نَن كُي.</para>
  <para style="ip">«لٍوِ سّرّشّدُبّ بْنسْي شَ سّرِيّ» قِندِشِ كِتَابُي سَشَن ندٍ نَن نَ تَوُرٍتَ مُنسَ كُي. عَ سّبّشِ مِشِيٍ نَن بّ نَشٍيٍ نُ عَلَ شَ وَلِ رَبَمَ عِسِرَيِلَكَيٍ يَ مَ. نَ مِشِيٍ قِندِشِ لٍوِ بْنسْي نَن نَ. لٍوِ نُ قِندِشِ عَننَبِ يَشُبَ شَ دِ ندٍ نَن نَ. عَلَ نُ بَرَ يَامَرِ قِ عَ لٍوِ شَ دِيٍ شَ قِندِ سَلِدٍ وَلِكّيٍ نُن سّرّشّدُبّيٍ رَ.</para>
  <para style="ip">عَ نُ لَنمَ عَلَ شَ وَلِ شَ رَبَ عَ رَبَ كِ مَ. نَ كُي عَننَبِ مُنسَ نَشَ نَ بِرِن سّبّ كِتَابُي كُي عَلَكٌ دِينّ يَرٍرَتِيٍ نُن عِسِرَيِلَ حَمَ شَ نَ سّرِيّ كٌلٌن، عٍ شَ بِرَ نَ قْشْ رَ. قٍ فبٍفبٍ سّبّشِ يِ كِتَابُي كُي سّرّشّيٍ شَ قٍ رَ. عَلَ نُ وَ مَ نٍيٍ شَ بَ عٍ بَ كِ مَ. عَ مَن نَشَ وَ عَدَ مَ شَ حّرّ سّنِيّنيِ كُي، عَلْ عَلَ نُ وَ مَ عَ شْن مَ كِ نَشّ عَ شَ حَمَ بّ. عَ يَامَرِ وُيَشِ قِشِ نّ عَلَكٌ عَدَ مَ شَ عَلَ وَشْنقٍ كٌلٌن.</para>
  <para style="ip">تٌ مِشِيٍ نْمَ لْننِ فبٍفبٍ تٌدٍ يِ كِتَابُي كُي. وٌن شَ عَ كٌلٌن عَلَتَلَ مُ يَامَرِيٍ قِشِ مِشِيٍ مَ قُقَقُ. شَ عَلَ بَرَ سّرِيّ ندٍ سٌ عَدَ مَ يِ رَ، عَ نَ رَبَشِ قٍ ندٍ نَن مَ. عَلَ وَ مَ عَ شَ مِشِيٍ شَ سّنِيّن بَرِ مَ عَ عَ كٌلٌن عٍ هّيرِ نَن تٌمَ نَ كِرَ سّنِيّنشِ شْن مَ. شَ وٌن بِرَ عَلَ شَ مَرَ سِ قْشْ رَ، وٌن قٍ قَنيِ سْتْمَ نّ دُنِحَ، وٌن مَن عَ سْتْ عَلِفِيَمَ. عَلَ شَ وٌن مَلِ عَلَكٌ حَنِفٍ شَ لُ وٌن بْحّ كُي، وٌن شَ دُنِحَ عِفِرِ عَلْ وٌن دَا مَرِفِ وٌن نَسِشِ كِ نَشّ. عَمِنَ.</para>
  <para style="imte">تَوُرٍتَ مُنسَ</para>
  <para style="imte">لٍوِ سّرّشّدُبّ بْنسْي شَ سّرِيّ</para>
  <chapter number="1" style="c" sid="LEV 1"/>
  <para style="s">سّرّشّ فَن دَاشِ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 1:1"/>عَلَتَلَ نَشَ عَننَبِ مُنسَ شِلِ عَ شَ هْرْ مْلِنفِرَ كُي، عَ عَ مَسٍن عَ بّ، <verse eid="LEV 1:1"/><verse number="2" style="v" sid="LEV 1:2"/>«عَ قَلَ عِسِرَيِلَكَيٍ بّ، نَشَن نَ وَ سّرّشّ بَقٍ ﭑ تَن عَلَتَلَ بّ، عَ شَ شُرُ سٍ لَنمَ شَ نَ مُ عَ رَ شُرُ سٍ شُنفبٍ بَ. <verse eid="LEV 1:2"/><verse number="3" style="v" sid="LEV 1:3"/>شَ عَ وَ مَ شُرُ سٍ شُنفبٍ نَن بَقٍ سّرّشّ فَن دَاشِ رَ، قٌ عَ شَ قِندِ تُورَ رَ لَنيُرُ مُ نَ نَشَن مَ. عَ شَ قَ نَ رَ ﭑ تَن عَلَتَلَ شَ هْرْ مْلِنفِرَ سٌدٍ دّ رَ، عَلَكٌ ﭑ شَ عَ تٌنفٌ. <verse eid="LEV 1:3"/><verse number="4" style="v" sid="LEV 1:4"/>سّرّشّبَ شَ عَ بّلّشّ سَ شُرُ سٍ شُن تَفِ، عَلَكٌ ﭑ تَن عَلَتَلَ شَ نَ سّرّشّ تٌنفٌ، عَ شَ قِندِ عَ شُنسَرٍ رَ عَ شَ يُنُبِ شَ قٍ رَ. <verse eid="LEV 1:4"/><verse number="5" style="v" sid="LEV 1:5"/>نَ تُورَ شَ قَشَ ﭑ تَن عَلَتَلَ يَ عِ. هَرُنَ شَ دِ سّرّشّدُبّيٍ شَ قَ نَ تُورَ وُلِ رَ، عٍ شَ عَ كَسَن سّرّشّبَدٍ سّيتِيٍ مَ، سّرّشّبَدٍ نَشَن نَ ﭑ مَ هْرْ مْلِنفِرَ سٌدٍ دّ رَ. <verse eid="LEV 1:5"/><verse number="6" style="v" sid="LEV 1:6"/>عٍ شَ تُورَ بُرَ، عٍ قَ عَ عِسّفّ. <verse eid="LEV 1:6"/><verse number="7" style="v" sid="LEV 1:7"/>هَرُنَ شَ دِ سّرّشّدُبّيٍ شَ يٍفٍ رَدْشْ، عٍ تّ رَدّشّ. <verse eid="LEV 1:7"/><verse number="8" style="v" sid="LEV 1:8"/>عٍ مَن شَ سّرّشّ سُبٍ، عَ شُنيِ، نُن عَ تُرٍ سَ تّ عِ سّرّشّبَدٍ. <verse eid="LEV 1:8"/><verse number="9" style="v" sid="LEV 1:9"/>عَ قُرِنفّ نُن عَ سَنيِيٍ شَ رَشَ. سّرّشّدُبّ شَ نَ بِرِن فَن سّرّشّبَدٍ. سّرّشّ فَن دَاشِ نَ عَ رَ نَشَن شِرِ رَقَن ﭑ تَن عَلَتَلَ مَ.»<verse eid="LEV 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 1:10"/>«شَ مِشِ وَ مَ سّرّشّ فَن دَاشِ بَقٍ شُرُ سٍ لَنمَ رَ، عَ شَ قِندِ يّشّي كٌنتٌنيِ رَ، شَ نَ مُ عَ رَ سِكْتّ، لَنيُرُ مُ نَ نَشَن مَ. <verse eid="LEV 1:10"/><verse number="11" style="v" sid="LEV 1:11"/>سّرّشّبَ شَ نَ كْن نَشَبَ سّرّشّبَدٍ كْولَ مَبِرِ ﭑ تَن عَلَتَلَ يَ عِ. هَرُنَ شَ دِ سّرّشّدُبّيٍ شَ عَ وُلِ تٌنفٌ، عٍ شَ عَ كَسَن سّرّشّبَدٍ سّيتِيٍ مَ. <verse eid="LEV 1:11"/><verse number="12" style="v" sid="LEV 1:12"/>عٍ نَ فّ سُبٍ عِشَبَدٍ، سّرّشّدُبّ شَ عَ سُبٍ، عَ شُنيِ، نُن عَ تُرٍ سَ تّ سّرّشّبَدٍ قَرِ. <verse eid="LEV 1:12"/><verse number="13" style="v" sid="LEV 1:13"/>سّرّشّبَ شَ سّرّشّ قُرِنفّ نُن عَ سَنيِيٍ رَشَ. سّرّشّدُبّ شَ نَ بِرِن فَن سّرّشّبَدٍ. سّرّشّ فَن دَاشِ نَ عَ رَ نَشَن شِرِ رَقَن ﭑ تَن عَلَتَلَ مَ.»<verse eid="LEV 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 1:14"/>«شَ عَ وَ مَ شْنِ بَقٍ سّرّشّ فَن دَاشِ رَ ﭑ تَن عَلَتَلَ بّ، قٌ عَ شَ قِندِ كٌلٌكٌندٍ نَن نَ، شَ نَ مُ عَ رَ فَنبّ يْرّ رَ. <verse eid="LEV 1:14"/><verse number="15" style="v" sid="LEV 1:15"/>سّرّشّدُبّ شَ قَ عَ رَ سّرّشّبَدٍ، عَ عَ شُنيِ بٌلٌن عَ دّ عِ، عَ عَ سَ تّ، عَ عَ فَن. عَ وُلِ شَ عِقِلِ سّرّشّبَدٍ سّيتِيٍ مَ. <verse eid="LEV 1:15"/><verse number="16" style="v" sid="LEV 1:16"/>عَ شَ عَ فّمّ بْوتْ بَ، عَ عَ وْلّ تّ عِ شُبٍ شُن، سّرّشّبَدٍ سٌفٍتٍدٍ مَبِرِ رَ. <verse eid="LEV 1:16"/><verse number="17" style="v" sid="LEV 1:17"/>سّرّشّدُبّ شَ عَ سُشُ عَ فَبُتٍنيِيٍ مَ، عَ عَ عِبْو. عَ شَ عَ فَن، عَ قِندِ سّرّشّ فَن دَاشِ رَ، نَشَن شِرِ رَقَن ﭑ تَن عَلَتَلَ مَ.»<verse eid="LEV 1:17"/></para>
  <chapter eid="LEV 1"/>
  <chapter number="2" style="c" sid="LEV 2"/>
  <para style="s">سَنسِ شْرِ سّرّشّ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 2:1"/>«شَ مِشِ وَ مَ سّرّشّ بَقٍ ﭑ تَن عَلَتَلَ بّ نَشَن قِندِشِ سَنسِ شْرِ رَ، عَ شَ عَ لُشُتَ عَ قَنيِ رَ. عَ شَ تُرٍ سَ عَ قَرِ، عَ سُرَيِ قَن سَ تُرٍ قَرِ. <verse eid="LEV 2:1"/><verse number="2" style="v" sid="LEV 2:2"/>عَ شَ نَ سٌ هَرُنَ شَ دِ سّرّشّدُبّيٍ يِ رَ. سّرّشّدُبّ ندٍ شَ سَنسِ شْرِ لُشُتَشِ بّلّشّ يَ كٍرٍن كْ، تُرٍ سَشِ نَشَن قَرِ، عَ نُن سُرَيِ، عَ شَ عَ سَ تّ عِ. نَ شَ فَن ﭑ تَن عَلَتَلَ بّ، عَ شَ قِندِ تْنشُمَ رَ نَ سّرّشّ بِرِن شَ قٍ رَ. سّرّشّ فَن دَاشِ نَ عَ رَ نَشَن شِرِ رَقَن ﭑ تَن عَلَتَلَ مَ. <verse eid="LEV 2:2"/><verse number="3" style="v" sid="LEV 2:3"/>سَنسِ شْرِ لُشُتَشِ نَشَن لُشِ نَا قِندِ مَ هَرُنَ نُن عَ شَ دِيٍ نَن فبٍ رَ. عَ سّنِيّن بَرِ مَ عَ بَشِ سّرّشّ فَنشِ نَن نَ نَشَن بَشِ ﭑ تَن عَلَتَلَ بّ.»<verse eid="LEV 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 2:4"/>«شَ مِشِ وَ مَ سّرّشّ بَقٍ ﭑ تَن عَلَتَلَ بّ نَشَن قِندِشِ تَامِ فَنشِ رَ، عَ شَ نَ يَءِلَن سَنسِ شْرِ لُشُتَشِ رَ لّبِنِ مُ نَ نَشَن شُن. تُرٍ شَ مَسُنبُ نَ قَن نَ. تَامِ لّبِنِتَرٍ شُنشُرِيٍ قَن نْمَ يَءِلَندٍ، تُرٍ مَسٌشِ نَشٍيٍ مَ.»<verse eid="LEV 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 2:5"/>«شَ مِشِ وَ مَ سّرّشّ بَقٍ نَشَن قِندِشِ تَامِ فِلِنشِ رَ، عَ شَ نَ يَءِلَن سَنسِ شْرِ لُشُتَشِ رَ لّبِنِ مُ نَ نَشَن شُن. تُرٍ شَ مَسُنبُ نَ قَن نَ. <verse eid="LEV 2:5"/><verse number="6" style="v" sid="LEV 2:6"/>عَ نَ فّ فِلِندٍ، عَ شَ عِفِرَ، تُرٍ سَ عَ مَ، عَ شَ قِندِ سّرّشّ رَ.»<verse eid="LEV 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 2:7"/>«شَ مِشِ وَ مَ سّرّشّ بَقٍ نَشَن قِندِشِ تَامِ رَ نَشَن فَنشِ تُندٍ كُي، عَ شَ نَ يَءِلَن سَنسِ شْرِ لُشُتَشِ نُن تُرٍ رَ. <verse eid="LEV 2:7"/><verse number="8" style="v" sid="LEV 2:8"/>عَ لَنمَ مِشِ شَ قَ نَ سّرّشّ مْولِ رَ ﭑ تَن عَلَتَلَ بّ. شَ نَ بَرَ سٌ سّرّشّدُبّ يِ رَ، عَ نَ شَنِنمَ سّرّشّبَدٍ. <verse eid="LEV 2:8"/><verse number="9" style="v" sid="LEV 2:9"/>عَ شَ ندٍ تٌنفٌ نَشَن قِندِ مَ تْنشُمَ رَ، عَ شَ نَ فَن سّرّشّبَدٍ قَرِ، عَ شَ قِندِ سّرّشّ رَ، نَشَن شِرِ رَقَن ﭑ تَن عَلَتَلَ مَ. <verse eid="LEV 2:9"/><verse number="10" style="v" sid="LEV 2:10"/>سَنسِ شْرِ دِنشِ نَشَن لُشِ عَ قِندِ مَ هَرُنَ نُن عَ شَ دِيٍ نَن فبٍ رَ. عَ سّنِيّن بَرِ مَ عَ بَشِ سّرّشّ فَنشِ نَن نَ نَشَن بَشِ ﭑ تَن عَلَتَلَ بّ.»<verse eid="LEV 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 2:11"/>«سّرّشّ نَشَن بِرِن بَمَ ﭑ تَن عَلَتَلَ بّ، لّبِنِ يٌ نَشَ لُ عَ شُن. عَ مُ لَن وٌ شَ سّرّشّ فَن دَاشِ يٌ بَ ﭑ تَن عَلَتَلَ بّ لّبِنِ نَ نَشَن شُن، شَ نَ مُ عَ رَ كُمِ. <verse eid="LEV 2:11"/><verse number="12" style="v" sid="LEV 2:12"/>وٌ نْمَ لّبِنِ نُن كُمِ سَدٍ سَنسِ بٌفِ سِنفٍيٍ شُن مَ نَشٍيٍ بَمَ سّرّشّ رَ ﭑ تَن عَلَتَلَ بّ، كْنْ عٍ نَشَ فَن سّرّشّبَدٍ قَرِ. <verse eid="LEV 2:12"/><verse number="13" style="v" sid="LEV 2:13"/>قْشْي شَ سَ نَ سّرّشّ مْولِ بِرِن مَ، بَرِ مَ نَ بَرَ قِندِ سَاتّ تْنشُمَ رَ وٌ تَن نُن وٌ مَرِفِ عَلَ تَفِ. قْشْي شَ سَ وٌ شَ سّرّشّ بِرِن مَ.»<verse eid="LEV 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 2:14"/>«شَ وٌ وَ مَ سّرّشّ بَقٍ ﭑ تَن عَلَتَلَ بّ وٌ شَ سَنسِ بٌفِ سِنفٍ رَ، وٌ شَ تْنسْي نّينّ فَن، <verse eid="LEV 2:14"/><verse number="15" style="v" sid="LEV 2:15"/>وٌ تُرٍ نُن سُرَيِ سَ عَ شُن، عَ شَ قِندِ سَنسِ بٌفِ سِنفٍ سّرّشّ رَ. <verse eid="LEV 2:15"/><verse number="16" style="v" sid="LEV 2:16"/>سّرّشّدُبّ شَ ندٍ تٌنفٌ نَ سَنسِ شْرِ، تُرٍ، نُن سُرَيِ رَ، نَ شَ قِندِ تْنشُمَ رَ. عَ شَ نَ فَن سّرّشّبَدٍ قَرِ. عَ شَ قِندِ سّرّشّ رَ، نَشَن شِرِ رَقَن ﭑ تَن عَلَتَلَ مَ.»<verse eid="LEV 2:16"/></para>
  <chapter eid="LEV 2"/>
  <chapter number="3" style="c" sid="LEV 3"/>
  <para style="s">شَنُنتٍيَ سّرّشّ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 3:1"/>«شَ مِشِ وَ مَ شُرُ سٍ شُنفبٍ بَقٍ شَنُنتٍيَ سّرّشّ رَ ﭑ تَن عَلَتَلَ بّ، شُرُ سٍ شّمّمَ، شَ نَ مُ عَ رَ فِنّمَ، عَ شَ قِندِ شُرُ سٍ رَ لَنيُرُ يٌ مُ نَ نَشَن مَ. <verse eid="LEV 3:1"/><verse number="2" style="v" sid="LEV 3:2"/>عَ شَ عَ بّلّشّ سَ نَ شُرُ سٍ شُن تَفِ ﭑ تَن عَلَ شَ هْرْ مْلِنفِرَ سٌدٍ دّ رَ، عَ عَ كْن نَشَبَ. هَرُنَ شَ دِ سّرّشّدُبّيٍ شَ نَ شُرُ سٍ وُلِ كَسَن سّرّشّبَدٍ سّيتِيٍ مَ. <verse eid="LEV 3:2"/><verse number="3" style="v" sid="LEV 3:3"/>شَنُنتٍيَ سّرّشّ كُي، عَ لَنمَ تُرٍ نَشَن نَ قُرِنفّ سّيتِ مَ، عَ شَ فَن تّ عِ ﭑ تَن عَلَتَلَ يَ عِ، <verse eid="LEV 3:3"/><verse number="4" style="v" sid="LEV 3:4"/>عَ نُن عَ فُنفُي قِرِنيِ، عٍ تُرٍ، نُن لَارٍ نَشَن نَ عَ بْحّ مَ. <verse eid="LEV 3:4"/><verse number="5" style="v" sid="LEV 3:5"/>هَرُنَ شَ دِيٍ شَ نَ بِرِن فَن سّرّشّ فَن دَاشِ شُن مَ، نَشَن نَ فَنقٍ سّرّشّبَدٍ قَرِ. عَ شَ قِندِ سٍ شِرِ حْشُنمّ رَ ﭑ تَن عَلَتَلَ بّ.»<verse eid="LEV 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 3:6"/>«شَ مِشِ وَ مَ شُرُ سٍ لَنمَ بَقٍ شَنُنتٍيَ سّرّشّ رَ ﭑ تَن عَلَتَلَ بّ، شُرُ سٍ شّمّمَ، شَ نَ مُ عَ رَ فِنّمَ، عَ شَ قِندِ شُرُ سٍ رَ لَنيُرُ يٌ مُ نَ نَشَن مَ. <verse eid="LEV 3:6"/><verse number="7" style="v" sid="LEV 3:7"/>شَ مِشِ وَ مَ يّشّي بَقٍ سّرّشّ رَ، عَ شَ نَ مَسٍن ﭑ تَن عَلَتَلَ بّ. <verse eid="LEV 3:7"/><verse number="8" style="v" sid="LEV 3:8"/>عَ شَ عَ بّلّشّ سَ عَ شُن تَفِ، عَ قَ عَ كْن نَشَبَ ﭑ تَن عَلَ شَ هْرْ مْلِنفِرَ سٌدٍ دّ رَ. هَرُنَ شَ دِ سّرّشّدُبّيٍ شَ نَ شُرُ سٍ وُلِ كَسَن سّرّشّبَدٍ سّيتِيٍ مَ. <verse eid="LEV 3:8"/><verse number="9" style="v" sid="LEV 3:9"/>يِ شَنُنتٍيَ سّرّشّ كُي، عَ لَنمَ عَ تُرٍ، عَ شُلِ، تُرٍ نَشَن نَ قُرِنفّ سّيتِ مَ، <verse eid="LEV 3:9"/><verse number="10" style="v" sid="LEV 3:10"/>عَ فُنفُي قِرِنيِ، عٍ تُرٍ، نُن لَارٍ نَشَن نَ عَ بْحّ مَ، نَ بِرِن شَ فَن تّ عِ ﭑ تَن عَلَتَلَ يَ عِ. <verse eid="LEV 3:10"/><verse number="11" style="v" sid="LEV 3:11"/>سّرّشّدُبّ شَ نَ فَن سّرّشّبَدٍ قَرِ. تّ شَ نَ بِرِن فَن. نَ بَرَ قِندِ سّرّشّ فَن دَاشِ رَ ﭑ تَن عَلَتَلَ بّ.»<verse eid="LEV 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 3:12"/>«شَ مِشِ وَ مَ سِ بَقٍ سّرّشّ رَ، عَ شَ نَ مَسٍن ﭑ تَن عَلَتَلَ بّ. <verse eid="LEV 3:12"/><verse number="13" style="v" sid="LEV 3:13"/>عَ شَ عَ بّلّشّ سَ عَ شُن تَفِ، عَ قَ عَ كْن نَشَبَ ﭑ تَن عَلَ شَ هْرْ مْلِنفِرَ سٌدٍ دّ رَ، هَرُنَ شَ دِ سّرّشّدُبّيٍ شَ نَ شُرُ سٍ وُلِ كَسَن سّرّشّبَدٍ سّيتِيٍ مَ. <verse eid="LEV 3:13"/><verse number="14" style="v" sid="LEV 3:14"/>يِ شَنُنتٍيَ سّرّشّ كُي، عَ لَنمَ عَ تُرٍ نَشَن نَ قُرِنفّ سّيتِ مَ، <verse eid="LEV 3:14"/><verse number="15" style="v" sid="LEV 3:15"/>عَ فُنفُي قِرِنيِ، عٍ تُرٍ، نُن لَارٍ نَشَن نَ عَ بْحّ مَ، نَ بِرِن شَ فَن تّ عِ ﭑ تَن عَلَتَلَ يَ عِ. <verse eid="LEV 3:15"/><verse number="16" style="v" sid="LEV 3:16"/>سّرّشّدُبّ شَ نَ فَن سّرّشّبَدٍ قَرِ. تّ شَ نَ بِرِن فَن. نَ بَرَ قِندِ سّرّشّ فَن دَاشِ رَ ﭑ تَن عَلَتَلَ بّ نَشَن شِرِ رَقَن ﭑ مَ.»<verse eid="LEV 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 3:17"/>«مِشِ يٌ نَشَ سُبٍ تُرٍ دٌن، مِشِ يٌ نَشَ سُبٍ وُلِ مِن. وٌ سَبَتِ دّدّ، نَ بَرَ قِندِ يَامَرِ رَ نَشَن مُ كَنَمَ عَبَدَن.»<verse eid="LEV 3:17"/></para>
  <chapter eid="LEV 3"/>
  <chapter number="4" style="c" sid="LEV 4"/>
  <para style="s">يُنُبِ شَقَرِ سّرّشّ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 4:1"/>عَلَتَلَ نَشَ عَ مَسٍن عَننَبِ مُنسَ بّ، <verse eid="LEV 4:1"/><verse number="2" style="v" sid="LEV 4:2"/>«عَ قَلَ عِسِرَيِلَكَيٍ بّ، شَ مِشِ ندٍ سَ يُنُبِ رَبَ، كْنْ عَ مُ كٍلِ عَ حَنِفٍ مَ، عَ شَ بِرَ يِ سّرِيّ قْشْ رَ. <verse eid="LEV 4:2"/><verse number="3" style="v" sid="LEV 4:3"/>شَ سّرّشّدُبّ كُنتِفِ سَ عَلَ شَ يَامَرِ ندٍ مَتَندِ، نَ قَ قِندِ يُنُبِ رَ حَمَ بّ، عَ لَنمَ عَ شَ تُورَ بَ سّرّشّ رَ ﭑ تَن عَلَتَلَ بّ، لَنيُرُ مُ نَ نَشَن مَ، عَلَكٌ نَ شَ قِندِ يُنُبِ شَقَرِ سّرّشّ رَ عَ بّ. <verse eid="LEV 4:3"/><verse number="4" style="v" sid="LEV 4:4"/>عَ شَ تُورَ شَنِن ﭑ تَن عَلَ شَ هْرْ مْلِنفِرَ سٌدٍ دّ رَ ﭑ يَ عِ، عَ عَ بّلّشّ سَ عَ شُن تَفِ، عَ قَ عَ كْن نَشَبَ ﭑ تَن عَلَتَلَ يَ عِ. <verse eid="LEV 4:4"/><verse number="5" style="v" sid="LEV 4:5"/>سّرّشّدُبّ كُنتِفِ شَ نَ تُورَ وُلِ شَنِن ﭑ مَ هْرْ مْلِنفِرَ كُي، <verse eid="LEV 4:5"/><verse number="6" style="v" sid="LEV 4:6"/>عَ عَ بّلّشّسٌلٍ رَفٌرٌ نَ وُلِ شْورَ، عَ عَ كَسَن سَنيَ سٌلٌقٍرٍ دُفِ يَ رَ نَشَن فبَكُشِ يِرٍ سّنِيّنشِ مَ ﭑ تَن عَلَتَلَ يَ عِ. <verse eid="LEV 4:6"/><verse number="7" style="v" sid="LEV 4:7"/>سّرّشّدُبّ شَ وُلِ ندٍ سَ قٍرِيٍ مَ نَشٍيٍ نَ سُرَيِ سّرّشّبَدٍ تُنشُنيِ نَانِ رَ، نَشَن نَ ﭑ تَن عَلَتَلَ يَ عِ ﭑ مَ هْرْ مْلِنفِرَ كُي. وُلِ نَشَن لُشِ، عَ شَ نَ عِقِلِ سّرّشّ فَن دَاشِ سّرّشّبَدٍ لَنبَنيِ مَ، نَشَن نَ ﭑ تَن عَلَتَلَ شَ هْرْ مْلِنفِرَ سٌدٍ دّ رَ. <verse eid="LEV 4:7"/><verse number="8" style="v" sid="LEV 4:8"/>عَ شَ تُرٍ بِرِن بَ تُورَ مَ نَشَن قِندِشِ يُنُبِ شَقَرِ سّرّشّ رَ، تُرٍ نَشَن نَ عَ قُرِنفّ سّيتِ مَ، <verse eid="LEV 4:8"/><verse number="9" style="v" sid="LEV 4:9"/>عَ فُنفُي قِرِنيِ، عٍ تُرٍ، نُن لَارٍ نَشَن نَ عَ بْحّ مَ. <verse eid="LEV 4:9"/><verse number="10" style="v" sid="LEV 4:10"/>عَ شَ نَ رَبَ عَلْ شَنُنتٍيَ سّرّشّ رَبَمَ كِ نَشّ. سّرّشّدُبّ شَ نَ فَن سّرّشّ فَن دَاشِ سّرّشّبَدٍ قَرِ. <verse eid="LEV 4:10"/><verse number="11" style="v" sid="LEV 4:11"/>كْنْ تُورَ كِرِ، عَ سُبٍ، عَ شُنيِ، عَ سَنيِيٍ، عَ قُرِنفّ، نُن عَ حَحّ، <verse eid="LEV 4:11"/><verse number="12" style="v" sid="LEV 4:12"/>نَ تُورَ دْنشْي بِرِن شَ شَنِن حَمَ يٌنكِندٍ قَرِ مَ، يِرٍ سّنِيّنشِ، تّ شُبٍ وْلّمَ دّننَشّ. مّننِ عَ شَ فَن تّ رَ نَ تّ شُبٍ قَرِ.»<verse eid="LEV 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 4:13"/>«شَ عِسِرَيِلَ حَمَ بِرِن نَن سَ ﭑ تَن عَلَ شَ يَامَرِ ندٍ مَتَندِشِ، كْنْ نَ مُ كٍلِ عٍ حَنِفٍ مَ، نَ قِندِ مَ يُنُبِ رَ عٍ بّ. <verse eid="LEV 4:13"/><verse number="14" style="v" sid="LEV 4:14"/>عٍ نَ قَهَامُي سْتْ نَ مَ تّمُي نَشّ، حَمَ شَ تُورَ يْرّ بَ سّرّشّ رَ ﭑ تَن عَلَتَلَ بّ هْرْ مْلِنفِرَ سٌدٍ دّ رَ نَشَن قِندِ مَ يُنُبِ شَقَرِ سّرّشّ رَ عٍ بّ. <verse eid="LEV 4:14"/><verse number="15" style="v" sid="LEV 4:15"/>حَمَ قٌرِيٍ شَ عٍ بّلّشّ سَ تُورَ شُن تَفِ ﭑ تَن عَلَتَلَ يَ عِ، عٍ عَ كْن نَشَبَ. <verse eid="LEV 4:15"/><verse number="16" style="v" sid="LEV 4:16"/>سّرّشّدُبّ كُنتِفِ شَ نَ تُورَ وُلِ شَنِن ﭑ تَن عَلَ شَ هْرْ مْلِنفِرَ كُي، <verse eid="LEV 4:16"/><verse number="17" style="v" sid="LEV 4:17"/>عَ عَ بّلّشّسٌلٍ رَفٌرٌ نَ وُلِ شْورَ، عَ عَ كَسَن سَنيَ سٌلٌقٍرٍ دُفِ يَ رَ نَشَن فبَكُشِ يِرٍ سّنِيّنشِ مَ ﭑ تَن عَلَتَلَ يَ عِ. <verse eid="LEV 4:17"/><verse number="18" style="v" sid="LEV 4:18"/>سّرّشّدُبّ شَ وُلِ ندٍ سَ قٍرِيٍ مَ نَشٍيٍ نُ نَ سّرّشّبَدٍ تُنشُنيِ نَانِ رَ، نَشَن نَ ﭑ تَن عَلَتَلَ يَ عِ ﭑ مَ هْرْ مْلِنفِرَ كُي. وُلِ نَشَن لُشِ، عَ شَ نَ عِقِلِ سّرّشّ فَن دَاشِ سّرّشّبَدٍ لَنبَنيِ مَ، نَشَن نَ ﭑ مَ هْرْ مْلِنفِرَ سٌدٍ دّ رَ. <verse eid="LEV 4:18"/><verse number="19" style="v" sid="LEV 4:19"/>عَ شَ تُرٍ بِرِن بَ تُورَ مَ، عَ نَ فَن سّرّشّبَدٍ قَرِ. <verse eid="LEV 4:19"/><verse number="20" style="v" sid="LEV 4:20"/>عَ شَ يِ تُورَ بَ سّرّشّ رَ عَلْ نَشَن بَمَ يُنُبِ شَقَرِ سّرّشّ رَ. عٍ بَ كِ بِرِن كٍرٍن. نَ كُي، سّرّشّدُبّ سّرّشّ بَمَ نَشَن قِندِ مَ عٍ شُنسَرٍ رَ، عَلَكٌ عٍ شَ يُنُبِيٍ شَ شَقَرِ. <verse eid="LEV 4:20"/><verse number="21" style="v" sid="LEV 4:21"/>عَ شَ نَ تُورَ شَنِن حَمَ يٌنكِندٍ قَرِ مَ، عَ شَ عَ فَن عَلْ بٌورٍ تُورَ فَنمَ كِ نَشّ. نَ قِندِ مَ يُنُبِ شَقَرِ سّرّشّ نَن نَ حَمَ بّ.»<verse eid="LEV 4:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 4:22"/>«شَ مَنفّ ندٍ عَ مَرِفِ عَلَتَلَ شَ يَامَرِ ندٍ مَتَندِ، كْنْ نَ مُ كٍلِ عَ حَنِفٍ مَ، نَ قِندِ مَ يُنُبِ رَ عَ بّ. <verse eid="LEV 4:22"/><verse number="23" style="v" sid="LEV 4:23"/>عَ نَ قَهَامُي سْتْ نَ مَ تّمُي نَشّ، عَ شَ سِكْتّ بَ سّرّشّ رَ، لَنيُرُ مُ نَ نَشَن مَ. <verse eid="LEV 4:23"/><verse number="24" style="v" sid="LEV 4:24"/>عَ شَ عَ بّلّشّ سَ سِكْتّ شُن تَفِ مَ ﭑ تَن عَلَتَلَ يَ عِ، عَ عَ كْن نَشَبَ سّرّشّ فَن دَاشِيٍ كْن نَشَبَمَ دّننَشّ. يُنُبِ شَقَرِ سّرّشّ نَ عَ رَ. <verse eid="LEV 4:24"/><verse number="25" style="v" sid="LEV 4:25"/>سّرّشّدُبّ شَ عَ بّلّشّسٌلٍ رَفٌرٌ نَ وُلِ شْورَ نَشَن بَشِ يُنُبِ شَ قٍ رَ، عَ ندٍ سَ قٍرِيٍ مَ نَشٍيٍ نَ سّرّشّ فَن دَاشِ سّرّشّبَدٍ تُنشُنيِ نَانِ رَ. وُلِ نَشَن لُشِ، عَ شَ نَ عِقِلِ سّرّشّ فَن دَاشِ سّرّشّبَدٍ لَنبَنيِ مَ. <verse eid="LEV 4:25"/><verse number="26" style="v" sid="LEV 4:26"/>عَ شَ نَ تُرٍ بِرِن فَن سّرّشّبَدٍ قَرِ، عَلْ شَنُنتٍيَ سّرّشّ رَبَمَ كِ نَشّ. نَ كُي سّرّشّدُبّ شُنسَرٍ سّرّشّ بَمَ مَنفّ بّ، عَلَكٌ عَ شَ يُنُبِ شَ شَقَرِ.»<verse eid="LEV 4:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 4:27"/>«شَ مِشِ ندٍ سَ عَ مَرِفِ عَلَتَلَ شَ يَامَرِ ندٍ مَتَندِ، كْنْ نَ مُ كٍلِ عَ حَنِفٍ مَ، نَ قِندِ مَ يُنُبِ رَ عَ بّ. <verse eid="LEV 4:27"/><verse number="28" style="v" sid="LEV 4:28"/>عَ نَ قَهَامُي سْتْ نَ مَ تّمُي نَشّ، عَ شَ سِ فِنّ بَ سّرّشّ رَ، لَنيُرُ مُ نَ نَشَن مَ، عَ شَ يُنُبِ شَ قٍ رَ. <verse eid="LEV 4:28"/><verse number="29" style="v" sid="LEV 4:29"/>عَ شَ عَ بّلّشّ سَ نَ يُنُبِ شَقَرِ سّرّشّ شُن تَفِ، عَ عَ كْن نَشَبَ سّرّشّ فَن دَاشِيٍ كْن نَشَبَمَ دّننَشّ. <verse eid="LEV 4:29"/><verse number="30" style="v" sid="LEV 4:30"/>سّرّشّدُبّ شَ عَ بّلّشّسٌلٍ رَفٌرٌ نَ وُلِ شْورَ نَشَن بَشِ يُنُبِ شَ قٍ رَ، عَ ندٍ سَ قٍرِيٍ مَ نَشٍيٍ نَ سّرّشّ فَن دَاشِ سّرّشّبَدٍ تُنشُنيِ نَانِ رَ. وُلِ نَشَن لُشِ، عَ شَ نَ عِقِلِ سّرّشّ فَن دَاشِ سّرّشّبَدٍ لَنبَنيِ مَ. <verse eid="LEV 4:30"/><verse number="31" style="v" sid="LEV 4:31"/>عَ شَ نَ تُرٍ بِرِن بَ سِ مَ، عَلْ شَنُنتٍيَ سّرّشّ رَبَمَ كِ نَشّ، عَ نَ فَن سّرّشّبَدٍ قَرِ، عَ شَ قِندِ سٍ شِرِ حْشُنمّ رَ ﭑ تَن عَلَتَلَ بّ. نَ كُي سّرّشّدُبّ شُنسَرٍ سّرّشّ بَمَ نَ مِشِ بّ، عَلَكٌ عَ شَ يُنُبِ شَ شَقَرِ.»<verse eid="LEV 4:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LEV 4:32"/>«شَ عَ يّشّي بَمَ يُنُبِ شَقَرِ سّرّشّ رَ، قٌ عَ شَ قِندِ يّشّي فِنّمَ لَنيُرُ مُ نَ نَشَن مَ. <verse eid="LEV 4:32"/><verse number="33" style="v" sid="LEV 4:33"/>عَ شَ عَ بّلّشّ سَ نَ يُنُبِ شَقَرِ سّرّشّ شُن تَفِ، عَ عَ كْن نَشَبَ سّرّشّ فَن دَاشِيٍ كْن نَشَبَمَ دّننَشّ. <verse eid="LEV 4:33"/><verse number="34" style="v" sid="LEV 4:34"/>سّرّشّدُبّ شَ عَ بّلّشّسٌلٍ رَفٌرٌ نَ وُلِ شْورَ نَشَن بَشِ يُنُبِ شَقَرِ سّرّشّ رَ، عَ ندٍ سَ قٍرِيٍ مَ نَشٍيٍ نَ سّرّشّ فَن دَاشِ سّرّشّبَدٍ تُنشُنيِ نَانِ رَ. وُلِ نَشَن لُشِ، عَ شَ نَ عِقِلِ سّرّشّ فَن دَاشِ سّرّشّبَدٍ لَنبَنيِ مَ. <verse eid="LEV 4:34"/><verse number="35" style="v" sid="LEV 4:35"/>عَ شَ نَ تُرٍ بِرِن بَ يّشّي مَ، عَلْ شَنُنتٍيَ سّرّشّ رَبَمَ كِ نَشّ، عَ شَ نَ فَن سّرّشّيٍ قَرِ نَشٍيٍ فَنمَ سّرّشّبَدٍ قَرِ. نَ كُي سّرّشّدُبّ شُنسَرٍ سّرّشّ بَمَ نَ مِشِ بّ، عَلَكٌ عَ شَ يُنُبِ شَ شَقَرِ.»<verse eid="LEV 4:35"/></para>
  <chapter eid="LEV 4"/>
  <chapter number="5" style="c" sid="LEV 5"/>
  <para style="s">يُنُبِ ندٍيٍ نُن عٍ شَ سّرّشّيٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 5:1"/>«شَ مِشِ ندٍ سَ عَ مّ عٍ سٍيدٍيٍ شِلِمَ كِيتِ ندٍ مَ، كْنْ عَ فُندِ سٍيدٍيَشِ قٍ نَشَن مَ عَ مُ نَ قَلَ حَمَ بّ، نَ يُنُبِ لُمَ عَ شُن مَ. <verse eid="LEV 5:1"/><verse number="2" style="v" sid="LEV 5:2"/>شَ مِشِ دِن سٍ سّنِيّنتَرٍ رَ عَ مُ عَ كٌلٌن، عَلْ سُبٍ رَهَرَ مُشِ بِنبِ، شَ نَ مُ عَ رَ شُرُ سٍ سّنِيّنتَرٍ بِنبِ، شَ نَ مُ عَ رَ بُبُسٍ سّنِيّنتَرٍ بِنبِ، نَ مِشِ قَن قِندِ مَ نّ مِشِ سّنِيّنتَرٍ رَ، عَ يُنُبِ سْتْ نَ كُي. <verse eid="LEV 5:2"/><verse number="3" style="v" sid="LEV 5:3"/>شَ مِشِ ندٍ سَ دِن سٍ سّنِيّنتَرٍ رَ نَشَن كٍلِشِ عَدَ مَدِ قَتٍ مَ، عَ قَ لِ عَ مُ عَ كٌلٌن نَ تّمُي، شَ عَ سَ عَ كٌلٌن تّمُي نَشّ، عَ قِندِ مَ سّنِيّنتَرٍ رَ، عَ يُنُبِ سْتْمَ نَ كُي. <verse eid="LEV 5:3"/><verse number="4" style="v" sid="LEV 5:4"/>شَ مِشِ ندٍ سَ عَ كَلِ قُقَقُ، قٍ قَنيِ شَ نَ مُ عَ رَ قٍ حَاشِ رَ، عَ قَ نّيمُ نَ مَ، عَ نَ رَتُ نَ قٍ مَ تّمُي نَشّ، عَ قِندِ مَ سّنِيّنتَرٍ رَ، عَ يُنُبِ سْتْ نَ كُي.»<verse eid="LEV 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 5:5"/>«نَشَن نَ يُنُبِ مْولِ رَبَمَ، عَ لَنمَ عَ شَ عَ تِ نَ رَ. <verse eid="LEV 5:5"/><verse number="6" style="v" sid="LEV 5:6"/>عَ شَ يّشّي فِنّ، شَ نَ مُ عَ رَ سِ فِنّ بَ يّتّ رَفبِلٍن سّرّشّ رَ ﭑ تَن عَلَتَلَ بّ. نَ كُي سّرّشّدُبّ يُنُبِ شَقَرِ سّرّشّ بَمَ عَ بّ، عَلَكٌ عَ شَ يُنُبِ شَ شَقَرِ.»<verse eid="LEV 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 5:7"/>«شَ قّيرّ مُ نَ عَ يِ رَ نَ سّرّشّ شَ قٍ رَ، عَ شَ كٌلٌكٌندٍ قِرِن شَ نَ مُ عَ رَ فَنبّ قِرِن بَ سّرّشّ رَ ﭑ تَن عَلَتَلَ بّ. كٍرٍن شَ قِندِ يُنُبِ شَقَرِ سّرّشّ رَ، بٌورٍ شَ قِندِ سّرّشّ فَن دَاشِ رَ. <verse eid="LEV 5:7"/><verse number="8" style="v" sid="LEV 5:8"/>عَ شَ عٍ شَنِن سّرّشّدُبّ شْن، سّرّشّدُبّ شَ يُنُبِ شَقَرِ سّرّشّ نَن سِنفٍ بَ. عَ شَ عَ كْنيِ فِرَ، كْنْ عَ نَشَ عَ شُنيِ بَ عَ دّ عِ. <verse eid="LEV 5:8"/><verse number="9" style="v" sid="LEV 5:9"/>عَ عَ وُلِ ندٍ كَسَنمَ سّرّشّبَدٍ سّيتِ مَ، وُلِ نَشَن لُشِ، عَ نَ عِقِلِمَ سّرّشّبَدٍ لَنبَنيِ. يُنُبِ شَقَرِ سّرّشّ نَ عَ رَ. <verse eid="LEV 5:9"/><verse number="10" style="v" sid="LEV 5:10"/>سّرّشّدُبّ شَ نَ شْنِ قِرِن ندٍ بَ سّرّشّ فَن دَاشِ رَ عَ رَبَ كِ مَ. نَ كُي، سّرّشّدُبّ شُنسَرٍ سّرّشّ بَمَ عَ بّ عَ شَ يُنُبِ رَبَشِ شَ قٍ رَ، عَلَكٌ عَ شَ شَقَرِ.»<verse eid="LEV 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 5:11"/>«شَ قّيرّ مُ نَ عَ يِ رَ كٌلٌكٌندٍ قِرِن، شَ نَ مُ عَ رَ فَنبّ قِرِن سْتْقٍ رَ، عَ شَ سَنسِ شْرِ دِنشِ كٌنبٌ يَ كٍرٍن نُن عَ تَفِ بَ يُنُبِ شَقَرِ سّرّشّ رَ. عَ نَشَ تُرٍ، شَ نَ مُ عَ رَ سُرَيِ سَ نَ قَرِ دٍ، بَرِ مَ يُنُبِ شَقَرِ سّرّشّ نَ عَ رَ. <verse eid="LEV 5:11"/><verse number="12" style="v" sid="LEV 5:12"/>عَ شَ نَ شَنِن سّرّشّدُبّ شْن مَ، سّرّشّدُبّ سُشُ كٍرٍن فَنمَ سّرّشّبَدٍ قَرِ تْنشُمَ رَ. عَ نَ رَبَمَ سّرّشّيٍ قَرِ نَشٍيٍ فَنمَ سّرّشّبَدٍ قَرِ، بَرِ مَ يُنُبِ شَقَرِ سّرّشّ نَ عَ رَ. <verse eid="LEV 5:12"/><verse number="13" style="v" sid="LEV 5:13"/>نَ كُي سّرّشّدُبّ شُنسَرٍ سّرّشّ بَمَ عَ بّ، عَلَكٌ عَ شَ يُنُبِ رَبَشِ شَ شَقَرِ. سَنسِ شْرِ دِنشِ نَشَن لُشِ عَ قِندِ مَ سّرّشّدُبّ نَن فبٍ رَ.»<verse eid="LEV 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 5:14"/>عَلَتَلَ نَشَ عَ مَسٍن عَننَبِ مُنسَ بّ، <verse eid="LEV 5:14"/><verse number="15" style="v" sid="LEV 5:15"/>«شَ مِشِ ندٍ سَ سٍ ندٍ تٌنفٌ نَشَن قِندِشِ ﭑ تَن عَلَتَلَ فبٍ رَ، كْنْ عَ مُ عَ كٌلٌن عَ نَ يُنُبِ مْولِ رَبَشِ، عَ شَ يّشّي كٌنتٌنيِ بَ يّتّ رَفبِلٍن سّرّشّ رَ ﭑ تَن عَلَتَلَ بّ عَ شَ يُنُبِ شَ قٍ رَ. عَ مُ لَنمَ لَنيُرُ يٌ شَ لُ نَ يّشّي مَ، عَ سَرٍ قَن شَ لَن سَرٍ مَ نَشَن نَوَلِمَ هْرْ مْلِنفِرَ كُي. <verse eid="LEV 5:15"/><verse number="16" style="v" sid="LEV 5:16"/>عَ شَ نَ سٍ تٌنفٌشِ رَفبِلٍن سّرّشّدُبّ مَ، عَ مَن شَ كْبِرِ سَ نَ قَرِ. نَ قِندِ مَ كْبِرِ نَشَن نَ، عَ نَ سٍ سَرٍ نَن عِتَشُنمَ دْشْ سُولِ رَ، عَ قَ دْشْ كٍرٍن بَ عَ رَ، عَ نَ سٌ سّرّشّدُبّ يِ رَ. نَ كُي سّرّشّدُبّ شُنسَرٍ سّرّشّ بَمَ عَ بّ سِكْتّ رَ نَشَن قِندِ يّتّ رَفبِلٍن سّرّشّ رَ، عَلَكٌ عَ شَ يُنُبِ شَ شَقَرِ. <verse eid="LEV 5:16"/><verse number="17" style="v" sid="LEV 5:17"/>مِشِ نَشَن يُنُبِ رَبَمَ، عَ ﭑ تَن عَلَتَلَ شَ يَامَرِ ندٍ مَتَندِ، هَلِ عَ مُ عَ كٌلٌن، نَ بَرَ يُنُبِ سْتْ، قٌ عَ شَ نَ سَرٍ قِ. <verse eid="LEV 5:17"/><verse number="18" style="v" sid="LEV 5:18"/>عَ لَنمَ عَ شَ سِكْتّ بَ يّتّ رَفبِلٍن سّرّشّ رَ، لَنيُرُ مُ نَ نَشَن مَ، نَشَن سَرٍ لَنمَ سّرِيّ مَ. نَ كُي سّرّشّدُبّ شُنسَرٍ سّرّشّ بَمَ عَ بّ عَ شَ يُنُبِ شَ قٍ رَ، عَ نَشَن نَبَشِ عَ مُ عَ كٌلٌن، عَلَكٌ عَ شَ يُنُبِ شَ شَقَرِ. <verse eid="LEV 5:18"/><verse number="19" style="v" sid="LEV 5:19"/>نَ بَرَ قِندِ يّتّ رَفبِلٍن سّرّشّ رَ، بَرِ مَ عَ يُنُبِ سْتْ نّ ﭑ تَن عَلَتَلَ رَ.»<verse eid="LEV 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 5:20"/>عَلَتَلَ نَشَ عَ مَسٍن عَننَبِ مُنسَ بّ، <verse eid="LEV 5:20"/><verse number="21" style="v" sid="LEV 5:21"/>«شَ مِشِ ندٍ سَ يُنُبِ سْتْ، عَ قٍ حَاشِ رَبَ ﭑ تَن عَلَتَلَ رَ، عَلْ عَ نفَشَكٍرٍنيِ مَدَشُقٍ سٍ ندٍ شَ قٍ رَ، نَشَن نُ بَرَ تَشُ عَ رَ، شَ نَ مُ عَ رَ عَ نَشَن مُحَ، شَ نَ مُ عَ رَ عَ نَشَن بَشِ عَ بٌورٍ يِ رَ قُنمَلَيَ رَ، <verse eid="LEV 5:21"/><verse number="22" style="v" sid="LEV 5:22"/>شَ نَ مُ عَ رَ سٍ لْيشِ عَ نَشَن تٌشِ، عَ قَ وُلٍ قَلَ نَ شَ قٍ رَ كَلِ رَ، <verse eid="LEV 5:22"/><verse number="23" style="v" sid="LEV 5:23"/>نَ يُنُبِ رَبَ مْولِ لَنمَ عَ شَ نَ سٍ مُحَشِ رَفبِلٍن. شَ عَ مُحَشِ نّ بَ، شَ عَ تَشُشِ نّ عَ رَ بَ، شَ سٍ لْيشِ نَ عَ رَ عَ نَشَن تٌشِ بَ، <verse eid="LEV 5:23"/><verse number="24" style="v" sid="LEV 5:24"/>شَ سٍ نَ عَ رَ وُلٍ قَلَ نَشَن مَ قٍ رَ كَلِ رَ، عَ شَ نَ رَفبِلٍن عَ كَنيِ مَ كٍرٍن نَ، عَ مَن شَ كْبِرِ سَ نَ قَرِ. نَ قِندِ مَ كْبِرِ نَشَن نَ، عَ نَ سٍ سَرٍ نَن عِتَشُنمَ دْشْ سُولِ رَ، عَ قَ دْشْ كٍرٍن بَ عَ رَ، عَ نَ سٌ نَ كَنيِ يِ رَ. <verse eid="LEV 5:24"/><verse number="25" style="v" sid="LEV 5:25"/>عَ مَن شَ يّشّي كٌنتٌنيِ شَنِن سّرّشّدُبّ يِرٍ يّتّ رَفبِلٍن سّرّشّ رَ عَلَتَلَ بّ. قِ يٌ نَشَ لُ نَ يّشّي مَ، عَ سَرٍ قَن شَ لَن سّرِيّ مَ. <verse eid="LEV 5:25"/><verse number="26" style="v" sid="LEV 5:26"/>نَ كُي سّرّشّدُبّ شُنسَرٍ سّرّشّ بَمَ عَ بّ ﭑ تَن عَلَتَلَ يَ عِ، عَلَكٌ عَ شَ يُنُبِ، عَ نَشَن نَبَشِ، نَ شَ شَقَرِ.»<verse eid="LEV 5:26"/></para>
  <chapter eid="LEV 5"/>
  <chapter number="6" style="c" sid="LEV 6"/>
  <para style="s">سّرِيّ سّرّشّدُبّيٍ بّ</para>
  <para style="s">سّرّشّ فَن دَاشِ سّرِيّ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 6:1"/>عَلَتَلَ نَشَ عَ مَسٍن عَننَبِ مُنسَ بّ، <verse eid="LEV 6:1"/><verse number="2" style="v" sid="LEV 6:2"/>«يِ يَامَرِ سٌ هَرُنَ نُن عَ شَ دِيٍ يِ رَ؛ سّرِيّ نَن يَ سّرّشّ فَن دَاشِ شَ قٍ رَ. سّرّشّ فَن دَاشِ شَ لُ سّرّشّبَدٍ قَرِ كْي رَ، عَ شَ فَن هَن فّيسّفّ. <verse eid="LEV 6:2"/><verse number="3" style="v" sid="LEV 6:3"/>سّرّشّدُبّ شَ دٌنمَ رَفٌرٌ عَ مَ، عَ شَ وَنتَنيِ قِيشّ قَنيِ سٌ عَ رَ، عَ شَ تّ شُبٍ بَ سّرّشّ فَن دَاشِ بُن مَ، عَ عَ سَ سّرّشّبَدٍ سّيتِ مَ. <verse eid="LEV 6:3"/><verse number="4" style="v" sid="LEV 6:4"/>عَ نَ فّ نَ وَلِ رَ، عَ شَ عَ شَ دُفِ قَنيِ بَ عَ مَ، عَ شَ دُفِ فبّتّ رَفٌرٌ عَ مَ، عَلَكٌ عَ شَ نَ تّ شُبٍ شَنِن حَمَ يٌنكِندٍ قَرِ مَ، يِرٍ سّنِيّنشِ. <verse eid="LEV 6:4"/><verse number="5" style="v" sid="LEV 6:5"/>تّ نَشَن دّشّشِ سّرّشّبَدٍ بُن مَ، نَ نَشَ شُبٍن. فّيسّفّ بِرِن سّرّشّدُبّ شَ يٍفٍ رَدْشْ، عَ شَ تّ شُرُ، عَ سّرّشّ فَن دَاشِ سَ نَ قَرِ. عَ شَنُنتٍيَ سّرّشّيٍ تُرٍ قَن فَنمَ نَا نّ. <verse eid="LEV 6:5"/><verse number="6" style="v" sid="LEV 6:6"/>نَ تّ دّشّمَ تّمُي بِرِن سّرّشّبَدٍ بُن مَ، عَ مُ شُبٍنمَ.»<verse eid="LEV 6:6"/></para>
  <para style="s">سَنسِ شْرِ دِنشِ سّرِيّ</para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 6:7"/>«سّرِيّ نَن يَ سَنسِ شْرِ دِنشِ سّرّشّ شَ قٍ رَ. هَرُنَ شَ دِيٍ شَ قَ نَ سّرّشّ رَ سّرّشّبَدٍ ﭑ تَن عَلَتَلَ يَ عِ. <verse eid="LEV 6:7"/><verse number="8" style="v" sid="LEV 6:8"/>سّرّشّدُبّ شَ سُشُ كٍرٍن كْ سَنسِ شْرِ دِنشِ رَ، عَ نُن تُرٍ، عَ نُن سُرَيِ نَشَن بِرِن سَمَ عَ قَرِ، عَ شَ نَ بِرِن فَن سّرّشّ تْنشُمَ رَ سّرّشّبَدٍ قَرِ. نَ شِرِ رَقَن ﭑ تَن عَلَتَلَ مَ. <verse eid="LEV 6:8"/><verse number="9" style="v" sid="LEV 6:9"/>نَشَن لُشِ، هَرُنَ نُن عَ شَ دِيٍ شَ نَ دٌن عَ لّبِنِتَرٍ رَ، هْرْ مْلِنفِرَ تّتّ سّنِيّنشِ كُي. <verse eid="LEV 6:9"/><verse number="10" style="v" sid="LEV 6:10"/>عَ مُ لَنمَ عَ شَ حِن لّبِنِ رَ، بَرِ مَ عَ قَتَنشِ ﭑ مَ سّرّشّ فَن دَاشِيٍ نَن نَ نَشٍيٍ سّنِيّنشِ هَن عَلْ يُنُبِ شَقَرِ سّرّشّ نُن يّتّ رَفبِلٍن سّرّشّ. <verse eid="LEV 6:10"/><verse number="11" style="v" sid="LEV 6:11"/>هَرُنَ شَ دِ شّمّيٍ نْمَ نَ دٌندٍ. يَامَرِ نَ عَ رَ وٌ بْنسْي بّ نَشَن مُ كَنَمَ عَبَدَن. مِشِ نَشَن بِرِن عَ مَكْرّ مَ نَ سّرّشّ فَن دَاشِيٍ رَ نَشٍيٍ بَمَ ﭑ تَن عَلَتَلَ بّ، نَ كَنيِيٍ سّنِيّنمَ نّ.»<verse eid="LEV 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 6:12"/>عَلَتَلَ نَشَ عَ مَسٍن عَننَبِ مُنسَ بّ، <verse eid="LEV 6:12"/><verse number="13" style="v" sid="LEV 6:13"/>«هَرُنَ تِمَ سّرّشّدُبّ كُنتِفِ رَ لْشْي نَشّ، عَ لَنمَ عَ تَن هَرُنَ نُن عَ شَ دِيٍ شَ سَنسِ شْرِ قَنيِ دِنشِ كٌنبٌ يَ كٍرٍن بَ سّرّشّ رَ. نَ سّرّشّ تَفِ بَمَ فّيسّفّ، بٌورٍ تَفِ بَمَ نُنمَرٍ. نَ مْولِ شَ رَبَ مِشِ تِمَ سّرّشّدُبّ كُنتِفِ رَ تّمُي نَشّ. <verse eid="LEV 6:13"/><verse number="14" style="v" sid="LEV 6:14"/>يِ سَنسِ شْرِ دِنشِ شَ فِلِن تُندٍ كُي، تُرٍ شَ سَ عَ مَ. عَ نَ حْن، عَ شُنتُنيِيٍ شَ فَن تّ شْورَ، عَ شَ قِندِ شِرِ حْشُنمّ رَ عَلَتَلَ بّ. <verse eid="LEV 6:14"/><verse number="15" style="v" sid="LEV 6:15"/>سّرّشّدُبّ نَشَن قِندِ مَ هَرُنَ حْشْي رَ شَ نَ سّرّشّ مْولِ بَ. عَ شَ رَبَ نَ كِ نّ تّمُي بِرِن ﭑ تَن عَلَتَلَ يَ عِ. نَ سّرّشّ بِرِن شَ فَن. <verse eid="LEV 6:15"/><verse number="16" style="v" sid="LEV 6:16"/>سّرّشّدُبّ شَ سّرّشّ بِرِن شَ فَن، عٍ نَشَ نَ سٍسٍ دٌن.»<verse eid="LEV 6:16"/></para>
  <para style="s">يُنُبِ شَقَرِ سّرّشّ سّرِيّ</para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 6:17"/>عَلَتَلَ نَشَ عَ مَسٍن عَننَبِ مُنسَ بّ، <verse eid="LEV 6:17"/><verse number="18" style="v" sid="LEV 6:18"/>«يِ يَامَرِ سٌ هَرُنَ نُن عَ شَ دِيٍ يِ رَ؛ ‹سّرِيّ نَن يَ يُنُبِ شَقَرِ سّرّشّ شَ قٍ رَ. يُنُبِ شَقَرِ سّرّشّ كْن نَشَبَمَ سّرّشّ فَن دَاشِ كْن نَشَبَدٍ نّ، بَرِ مَ سٍ سّنِيّنشِ نَ عَ رَ. <verse eid="LEV 6:18"/><verse number="19" style="v" sid="LEV 6:19"/>سّرّشّدُبّ نَشَن يُنُبِ شَقَرِ سّرّشّ بَمَ، عَ نَ دٌنمَ ﭑ تَن عَلَ شَ هْرْ مْلِنفِرَ تّتّ سّنِيّنشِ نَن كُي. <verse eid="LEV 6:19"/><verse number="20" style="v" sid="LEV 6:20"/>نَشَن يٌ دِنمَ نَ سّرّشّ رَ، نَ كَنيِ سّنِيّنمَ نّ. شَ نَ وُلِ سَ كَسَن دُفِ ندٍ مَ، نَ دُفِ شَ شَ يِرٍ سّنِيّنشِ. <verse eid="LEV 6:20"/><verse number="21" style="v" sid="LEV 6:21"/>شَ نَ سُبٍ حِنمَ تُندٍ مْولِ ندٍ كُي نَشَن مَنِيَ قّحّ رَ، عَ نَ فّ عَ حِندٍ، نَ تُندٍ شَ كَنَ. شَ عَ حِنمَ تُندٍ كُي نَشَن يَءِلَنشِ يْشُي رَ، نَ تُندٍ شَ مَشَ عَ قَنيِ رَ يٍ رَ. <verse eid="LEV 6:21"/><verse number="22" style="v" sid="LEV 6:22"/>شّمّ سّرّشّدُبّ بِرِن شَ نَ دٌن، بَرِ مَ سّرّشّ سّنِيّنشِ نَ عَ رَ. <verse eid="LEV 6:22"/><verse number="23" style="v" sid="LEV 6:23"/>كْنْ مِشِ يٌ نَشَ يُنُبِ شَقَرِ سّرّشّ دٌن، نَشَن وُلِ شَنِنمَ هْرْ مْلِنفِرَ كُي شُنسَرٍ رَ. نَ سّرّشّ مْولِ شَ فَن تّ رَ.›»<verse eid="LEV 6:23"/></para>
  <chapter eid="LEV 6"/>
  <chapter number="7" style="c" sid="LEV 7"/>
  <para style="s">يّتّ رَفبِلٍن سّرّشّ سّرِيّ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 7:1"/>«يّتّ رَفبِلٍن سّرّشّ سّرِيّ نَن يَ؛ سّرّشّ سّنِيّنشِ نَ عَ رَ. <verse eid="LEV 7:1"/><verse number="2" style="v" sid="LEV 7:2"/>يّتّ رَفبِلٍن سّرّشّ كْن نَشَبَمَ سّرّشّ فَن دَاشِ كْن نَشَبَدٍ نّ. عَ وُلِ شَ كَسَن سّرّشّبَدٍ سّيتِيٍ مَ. <verse eid="LEV 7:2"/><verse number="3" style="v" sid="LEV 7:3"/>عَ تُرٍ بِرِن، عَ شُلِ، عَ تُرٍ نَشَن نَ عَ قُرِنفّ سّيتِ مَ، <verse eid="LEV 7:3"/><verse number="4" style="v" sid="LEV 7:4"/>عَ فُنفُي قِرِنيِ، عٍ تُرٍ، نُن لَارٍ نَشَن نَ عَ بْحّ مَ، نَ بِرِن شَ بَ سّرّشّ رَ. <verse eid="LEV 7:4"/><verse number="5" style="v" sid="LEV 7:5"/>سّرّشّدُبّ شَ نَ بِرِن فَن سّرّشّبَدٍ قَرِ سّرّشّ فَن دَاشِ رَ عَلَتَلَ بّ. يّتّ رَفبِلٍن سّرّشّ نَ عَ رَ. <verse eid="LEV 7:5"/><verse number="6" style="v" sid="LEV 7:6"/>شّمّ سّرّشّدُبّيٍ نَن نَ دٌنمَ يِرٍ سّنِيّنشِ كُي، بَرِ مَ سّرّشّ سّنِيّنشِ نَ عَ رَ. <verse eid="LEV 7:6"/><verse number="7" style="v" sid="LEV 7:7"/>يُنُبِ شَقَرِ سّرّشّ نُن يّتّ رَفبِلٍن سّرّشّ، عٍ سّرِيّ بِرِن كٍرٍن. سّرّشّدُبّ نَشَن نَ شُنسَرٍ سّرّشّ بَشِ، عَ تَن نَن نَ سُبٍ دٌنمَ. <verse eid="LEV 7:7"/><verse number="8" style="v" sid="LEV 7:8"/>سّرّشّ فَن دَاشِ كِرِ قَن لُمَ سّرّشّدُبّ يِ رَ نَشَن نَ بَشِ سّرّشّ رَ.»<verse eid="LEV 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 7:9"/>«سَنسِ شْرِ دِنشِ سّرّشّ نَشَن فَنشِ نُن نَشَن فِلِنشِ، عٍ قَن قِندِ مَ سّرّشّدُبّ نَن فبٍ رَ، نَشَن عٍ بَشِ سّرّشّ رَ. <verse eid="LEV 7:9"/><verse number="10" style="v" sid="LEV 7:10"/>سَنسِ شْرِ دِنشِ سّرّشّ نَشَن مُ فَنشِ، تُرٍ فبَنسَن نَن سَشِ عَ مَ، شَ نَ مُ عَ رَ تُرٍ مُ سَشِ عَ مَ، نٍيٍ قِندِ مَ هَرُنَ شَ دِ بِرِن نَن فبٍ رَ.»<verse eid="LEV 7:10"/></para>
  <para style="s">شَنُنتٍيَ سّرّشّ سّرِيّ</para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 7:11"/>«شَنُنتٍيَ سّرّشّيٍ سّرِيّ نَن يَ، نَشَن بَمَ ﭑ تَن عَلَتَلَ بّ. <verse eid="LEV 7:11"/><verse number="12" style="v" sid="LEV 7:12"/>شَ مِشِ ندٍ وَ مَ تَنتُي سّرّشّ بَقٍ، عَ مَن شَ تَامِ لّبِنِتَرٍيٍ يَءِلَن تُرٍ رَ، عَ نُن تَامِ شُنشُرِيٍ تُرٍ سَشِ نَشٍيٍ مَ، نُن تَامِ شُنشُرِ نَشٍيٍ رَ مُلَنشِ تُرٍ رَ. <verse eid="LEV 7:12"/><verse number="13" style="v" sid="LEV 7:13"/>عَ نَ شَنُنتٍيَ سّرّشّ بَمَ تّمُي نَشّ، نَشَن قِندِشِ تَنتُي سّرّشّ رَ، عَ شَ تَامِ قَن حِن لّبِنِ نَ نَشَن شُن. <verse eid="LEV 7:13"/><verse number="14" style="v" sid="LEV 7:14"/>ندٍ شَ بَ نَ تَامِ مْولِ بِرِن نَ، عَ قِندِ سّرّشّدُبّ فبٍ رَ، نَشَن شَنُنتٍيَ سّرّشّ وُلِ كَسَنمَ سّرّشّبَدٍ سّيتِيٍ مَ. <verse eid="LEV 7:14"/><verse number="15" style="v" sid="LEV 7:15"/>نَ شَنُنتٍيَ سّرّشّ سُبٍ دٌنمَ عَ بَ لْشْي نّ، سٍسٍ نَشَ لُ هَن فّيسّفّ.»<verse eid="LEV 7:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 7:16"/>«شَ لَايِدِ سّرّشّ بَمَ، شَ نَ مُ عَ رَ سّرّشّ حَنِفٍشِ، نَ سُبٍ شَ دٌن عَ بَ لْشْي نّ، كْنْ شَ ندٍ سَ لُ عَ نْمَ دٌندٍ فّيسّفّ قَن. <verse eid="LEV 7:16"/><verse number="17" style="v" sid="LEV 7:17"/>شَ عَ دْنشْي سَ لُ هَن نَ قَن كُيٍ عِبَ، نَ سُبٍ شَ فَن فبِكِ نَ شِ سَشَن ندٍ لْشْي مَ. <verse eid="LEV 7:17"/><verse number="18" style="v" sid="LEV 7:18"/>شَ مِشِ ندٍ سَ عَ يّتّ شَ شَنُنتٍيَ سّرّشّ سُبٍ دٌن نَ شِ سَشَن ندٍ لْشْي مَ، عَلَ مُ عَ شَ سّرّشّ تٌنفٌمَ. عَ لُمَ عَلْ عَ مُ سّرّشّ يٌ بَشِ، بَرِ مَ نَ سُبٍ قِندِشِ سٍ سّنِيّنتَرٍ نَن نَ. مِشِ نَشَن نَ رَبَمَ، عَ يُنُبِ سْتْمَ نَ كُي.»<verse eid="LEV 7:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 7:19"/>«سّرّشّ سُبٍ نَشَن دِنمَ سٍ سّنِيّنتَرٍ رَ، عَ مُ لَنمَ نَ سُبٍ شَ دٌن. قٌ عَ شَ فَن نّ فبِكِ. مِشِ سّنِيّنشِ نَن نْمَ نَ شَنُنتٍيَ سّرّشّ سُبٍ دٌندٍ، <verse eid="LEV 7:19"/><verse number="20" style="v" sid="LEV 7:20"/>كْنْ سّنِيّنتَرٍ مُ نْمَ ﭑ تَن عَلَتَلَ شَ شَنُنتٍيَ سّرّشّ دٌندٍ، عَ رَ مِنِمَ نّ عِسِرَيِلَ حَمَ يَ مَ. <verse eid="LEV 7:20"/><verse number="21" style="v" sid="LEV 7:21"/>مِشِ نَشَن عَ بّلّشّ دِنمَ سٍ سّنِيّنتَرٍ رَ نَشَن كٍلِشِ عَدَ مَدِ مَ، شَ نَ مُ عَ رَ عَ بّلّشّ دِن سُبٍ سّنِيّنتَرٍ رَ، شَ نَ مُ عَ رَ سٍ فبّتّ نَشَن مُ سّنِيّنشِ، شَ نَ كَنيِ قَ ﭑ تَن عَلَتَلَ شَ شَنُنتٍيَ سّرّشّ دٌن، عَ رَ مِنِمَ نّ عِسِرَيِلَ حَمَ يَ مَ.»<verse eid="LEV 7:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 7:22"/>عَلَتَلَ نَشَ عَ مَسٍن عَننَبِ مُنسَ بّ، <verse eid="LEV 7:22"/><verse number="23" style="v" sid="LEV 7:23"/>«عَ قَلَ عِسِرَيِلَكَيٍ بّ، ‹وٌ نَشَ نِنفٍ، يّشّي، نُن سِ تُرٍ دٌن. <verse eid="LEV 7:23"/><verse number="24" style="v" sid="LEV 7:24"/>وٌ نْمَ شُرُ سٍ تُرٍ رَوَلِدٍ عَلْ وٌ وَ مَ عَ شْن مَ كِ نَشّ شَ عَ قَشَ عَ يّتّ مَ، شَ نَ مُ عَ رَ سُبٍ شَاحّ ندٍ نَشَ عَ قَشَ، كْنْ وٌ مُ نْمَ عَ دٌندٍ. <verse eid="LEV 7:24"/><verse number="25" style="v" sid="LEV 7:25"/>نَشَن يٌ تُرٍ دٌنمَ، نَشَن نْمَ رَوَلِدٍ سّرّشّ فَن دَاشِ رَ ﭑ تَن عَلَتَلَ بّ، نَ كَنيِ رَ مِنِمَ نّ عِسِرَيِلَ حَمَ يَ مَ. <verse eid="LEV 7:25"/><verse number="26" style="v" sid="LEV 7:26"/>وٌ مَن مُ لَنمَ وٌ شَ شْنِ وُلِ، شَ نَ مُ عَ رَ شُرُ سٍ وُلِ يٌ مِن يِرٍ بِرِن وٌ نَ دّننَشّ. <verse eid="LEV 7:26"/><verse number="27" style="v" sid="LEV 7:27"/>نَشَن يٌ وُلِ مِنمَ، نَ كَنيِ رَ مِنِمَ نّ عِسِرَيِلَ حَمَ يَ مَ.›»<verse eid="LEV 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LEV 7:28"/>عَلَتَلَ نَشَ عَ مَسٍن عَننَبِ مُنسَ بّ، <verse eid="LEV 7:28"/><verse number="29" style="v" sid="LEV 7:29"/>«عَ قَلَ عِسِرَيِلَكَيٍ بّ، ‹نَشَن شَنُنتٍيَ سّرّشّ بَمَ ﭑ تَن عَلَتَلَ بّ، عَ شَ ﭑ تَن عَلَتَلَ فبٍ قِ ﭑ مَ. <verse eid="LEV 7:29"/><verse number="30" style="v" sid="LEV 7:30"/>عَ شَ نَ شُرُ سٍ تُرٍ نُن عَ سِسِ شَنِن ﭑ تَن عَلَتَلَ يِرٍ عَلَكٌ عَ شَ فَن تّ رَ ﭑ تَن عَلَتَلَ بّ. عَ لَنمَ عَ شَ نَ شُرُ سٍ سِسِ لِنتَن ﭑ تَن عَلَتَلَ يَ عِ عَ مَسٍنقٍ رَ ﭑ بّ، نَ قِندِشِ ﭑ تَن نَن فبٍ رَ. <verse eid="LEV 7:30"/><verse number="31" style="v" sid="LEV 7:31"/>سّرّشّدُبّ شَ نَ تُرٍ فَن سّرّشّبَدٍ قَرِ. نَ شُرُ سٍ كَنكٍ لُمَ هَرُنَ نُن عَ شَ دِيٍ نَن بّ. <verse eid="LEV 7:31"/><verse number="32" style="v" sid="LEV 7:32"/>وٌ شَ شَنُنتٍيَ سّرّشّيٍ كُي، وٌ مَن شَ شُرُ سٍ يِرٍقَنيِ تَبٍ قِ سّرّشّدُبّ مَ. <verse eid="LEV 7:32"/><verse number="33" style="v" sid="LEV 7:33"/>شُرُ سٍ يِرٍقَنيِ تَبٍ شَ قِندِ سّرّشّدُبّ نَن فبٍ رَ نَشَن بَرَ وُلِ نُن تُرٍ بَ شَنُنتٍيَ سّرّشّ رَ. <verse eid="LEV 7:33"/><verse number="34" style="v" sid="LEV 7:34"/>ﭑ بَرَ نَتّ تٌنفٌ نَشَن مُ كَنَمَ عَبَدَن، عِسِرَيِلَكَيٍ شَ شَنُنتٍيَ سّرّشّيٍ كُي، عٍ شُرُ سٍ كَنكٍ نَشَن لِنتَنشِ ﭑ تَن عَلَ يَ عِ، عَ نُن شُرُ سٍ يِرٍقَنيِ تَبٍ عٍ نَشَن بَشِ، نَ بِرِن شَ قِندِ سّرّشّدُبّ هَرُنَ نُن عَ شَ دِيٍ فبٍ رَ. <verse eid="LEV 7:34"/><verse number="35" style="v" sid="LEV 7:35"/>كَبِ هَرُنَ نُن عَ شَ دِيٍ قِندِ ﭑ تَن عَلَ شَ سّرّشّدُبّيٍ رَ، عٍ نَ نَن سْتْمَ ﭑ تَن عَلَتَلَ شَ سّرّشّ فَن دَاشِيٍ يَ مَ. <verse eid="LEV 7:35"/><verse number="36" style="v" sid="LEV 7:36"/>عٍ تٌ قِندِ سّرّشّدُبّيٍ رَ، ﭑ تَن عَلَتَلَ نَشَ نَ يَامَرِ قِ عِسِرَيِلَكَيٍ مَ. يَامَرِ نَ عَ رَ نَشَن مُ كَنَمَ عَبَدَن.›»<verse eid="LEV 7:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LEV 7:37"/>سّرِيّ نَن نَ كِ سّرّشّيٍ شَ قٍ رَ، سّرّشّ فَن دَاشِ، سَنسِ شْرِ دِنشِ سّرّشّ، يُنُبِ شَقَرِ سّرّشّ، يّتّ رَفبِلٍن سّرّشّ، سّرّشّدُبّ تِ سّرّشّ، نُن شَنُنتٍيَ سّرّشّ. <verse eid="LEV 7:37"/><verse number="38" style="v" sid="LEV 7:38"/>عَلَتَلَ نُ بَرَ نَ بِرِن مَسٍن عَننَبِ مُنسَ بّ تُرُ سِنِنَ فٍيَ قَرِ عَ تٌ عِسِرَيِلَكَيٍ يَمَرِ عٍ شَ قَ سّرّشّيٍ رَ تُرُ سِنِنَ فبٍنفبٍرٍنيِ مَ.<verse eid="LEV 7:38"/></para>
  <chapter eid="LEV 7"/>
  <chapter number="8" style="c" sid="LEV 8"/>
  <para style="s">سّرّشّدُبّيٍ دْشْ سّرّشّ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 8:1"/>عَلَتَلَ نَشَ عَ مَسٍن عَننَبِ مُنسَ بّ، <verse eid="LEV 8:1"/><verse number="2" style="v" sid="LEV 8:2"/>«هَرُنَ نُن عَ شَ دِيٍ شِلِ هْرْ مْلِنفِرَ سٌدٍ دّ رَ. عِ شَ قَ عٍ شَ دُفِ سّنِيّنشِيٍ رَ، عَ نُن تُرٍ سّنِيّنشِ، تُورَ نَشَن بَمَ يُنُبِ شَقَرِ سّرّشّ رَ، يّشّي كٌنتٌنيِ قِرِن، نُن دٍبٍ، تَامِ لّبِنِتَرٍيٍ نَ نَشَن كُي. <verse eid="LEV 8:2"/><verse number="3" style="v" sid="LEV 8:3"/>عِ شَ عِسِرَيِلَ حَمَ بِرِن مَلَن هْرْ مْلِنفِرَ سٌدٍ دّ رَ.» <verse eid="LEV 8:3"/><verse number="4" style="v" sid="LEV 8:4"/>عَننَبِ مُنسَ نَشَ عَلَتَلَ شَ يَامَرِ رَكَمَلِ، حَمَ قَن نَشَ عٍ مَلَن هْرْ مْلِنفِرَ سٌدٍ دّ رَ.<verse eid="LEV 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 8:5"/>عَننَبِ مُنسَ نَشَ عَ قَلَ حَمَ بّ، «عَلَتَلَ بَرَ ﭑ يَمَرِ ﭑ شَ يِ رَبَ.» <verse eid="LEV 8:5"/><verse number="6" style="v" sid="LEV 8:6"/>عَننَبِ مُنسَ نَشَ هَرُنَ نُن عَ شَ دِيٍ مَسٌ، عَ نَشَ عٍ مَشَ يٍ رَ. <verse eid="LEV 8:6"/><verse number="7" style="v" sid="LEV 8:7"/>عَ نَشَ دُفِ سّنِيّنشِيٍ رَفٌرٌ هَرُنَ مَ، عَ نَشَ عَ تَفِ شِرِ بّلّتِ رَ، عَ فُبَ رَفٌرٌ عَ مَ، عَ سّرّشّدُبّ دٌنمَ رَفٌرٌ نَ قَرِ، عَ عَ تَفِ شِرِ بّلّتِ رَ. <verse eid="LEV 8:7"/><verse number="8" style="v" sid="LEV 8:8"/>عَ نَشَ كَنكٍ مَكٌتٌسٍ رَفٌرٌ عَ كْن مَ، عَ فّمّ قِرِن سَ نَ كُي نَشٍيٍ قِندِشِ عَلَ وَشْنقٍ مَسٍنسٍ رَ. <verse eid="LEV 8:8"/><verse number="9" style="v" sid="LEV 8:9"/>عَ نَشَ شُنمَسٍ دْشْ هَرُنَ شُنيِ مَ، عَ تْنشُمَ سّنِيّنشِ شّيمَ دَاشِ سَ نَ مَ، عَلْ عَلَتَلَ مُنسَ يَمَرِ كِ نَشّ.<verse eid="LEV 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 8:10"/>عَننَبِ مُنسَ نَشَ تُرٍ سّنِيّنشِ تٌنفٌ، عَ ندٍ مَسٌ عَلَ شَ هْرْ مْلِنفِرَ مَ، نُن سٍ نَشَن بِرِن نَ عَ كُي. عَ نٍيٍ رَ سّنِيّن نَ كِ نّ. <verse eid="LEV 8:10"/><verse number="11" style="v" sid="LEV 8:11"/>عَ نَشَ تُرٍ كَسَن سّرّشّبَدٍ مَ سَنيَ سٌلٌقٍرٍ، عَ نُن سّرّشّبَدٍ يِرَبَسٍيٍ، يٍ رَفَتَدٍ شُنفبٍ، نُن نَ سَشِ سٍ نَشَن قَرِ، عَلَكٌ عٍ شَ سّنِيّن. <verse eid="LEV 8:11"/><verse number="12" style="v" sid="LEV 8:12"/>عَ مَن نَشَ تُرٍ ندٍ سَ هَرُنَ شُنيِ مَ، عَلَكٌ هَرُنَ قَن شَ سّنِيّن. <verse eid="LEV 8:12"/><verse number="13" style="v" sid="LEV 8:13"/>عَننَبِ مُنسَ نَشَ هَرُنَ شَ دِيٍ مَسٌ، عَ دُفِ سّنِيّنشِيٍ رَفٌرٌ عٍ قَن مَ. عَ نَشَ عٍ تَفِ نُن عٍ شُنيِ شِرِ دُفِ رَ، عَلْ عَلَتَلَ عَ يَمَرِشِ كِ نَشّ.<verse eid="LEV 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 8:14"/>عَننَبِ مُنسَ تٌ قَ تُورَ يُنُبِ شَقَرِ سّرّشّ رَ، هَرُنَ نُن عَ شَ دِيٍ نَشَ عٍ بّلّشّيٍ سَ نَ تُورَ شُن تَفِ. <verse eid="LEV 8:14"/><verse number="15" style="v" sid="LEV 8:15"/>عَننَبِ مُنسَ نَشَ عَ كْن نَشَبَ، عَ نَشَ عَ وُلِ ندٍ تٌنفٌ، عَ عَ مَسٌ سّرّشّبَدٍ قٍرِيٍ مَ نَشٍيٍ نُ نَ سّرّشّبَدٍ تُنشُنيِ نَانِ رَ. عَ نَشَ نَ رَبَ عَ بّلّشّسٌلٍ رَ، عَلَكٌ عَ شَ سّرّشّبَدٍ رَ سّنِيّن. عَ نَشَ وُلِ دْنشْي عِقِلِ سّرّشّبَدٍ سّيتِيٍ مَ. عَ سّرّشّبَدٍ رَ سّنِيّن نَ كِ نّ بَرِ مَ عَ قِندِ شُنسَرَدٍ نَن نَ. <verse eid="LEV 8:15"/><verse number="16" style="v" sid="LEV 8:16"/>عَننَبِ مُنسَ مَن نَشَ تُرٍ تٌنفٌ نَشَن نُ نَ نِنفٍ قُرِنفّ رَبِلِنيِ، عَ نُن لَارٍ نَشَن نُ نَ عَ بْحّ قَرِ، نُن عَ فُنفُي شْرِ قِرِنيِيٍ نُن عٍ تُرٍ. عَ نَشَ نٍيٍ بِرِن سَ تّ عِ سّرّشّبَدٍ قَرِ. <verse eid="LEV 8:16"/><verse number="17" style="v" sid="LEV 8:17"/>كْنْ عَ نَشَ تُورَ فُندِ، عَ كِرِ، عَ سُبٍ، نُن عَ حَحّ فَن تّ رَ حَمَ يٌنكِندٍ قَرِ مَ، عَلْ عَلَتَلَ عَ يَمَرِشِ كِ نَشّ.<verse eid="LEV 8:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 8:18"/>عَننَبِ مُنسَ نَشَ قَ يّشّي كٌنتٌنيِ رَ نَشَن قِندِ سّرّشّ فَن دَاشِ رَ. هَرُنَ نُن عَ شَ دِيٍ نَشَ عٍ بّلّشّيٍ سَ نَ يّشّي شُن تَفِ. <verse eid="LEV 8:18"/><verse number="19" style="v" sid="LEV 8:19"/>عَننَبِ مُنسَ نَشَ عَ كْن نَشَبَ، عَ عَ وُلِ ندٍ كَسَن سّرّشّبَدٍ سّيتِيٍ مَ. <verse eid="LEV 8:19"/><verse number="20" style="v" sid="LEV 8:20"/>عَ نَشَ يّشّي عِشَبَ عَ شُنتُنيِيٍ رَ. عَ نَشَ عَ شُنيِ، عَ شُنتُنيِيٍ، نُن عَ تُرٍ فَن تّ عِ. <verse eid="LEV 8:20"/><verse number="21" style="v" sid="LEV 8:21"/>عَ نَشَ يّشّي قُرِنفّ نُن عَ سَنيِيٍ رَشَ، عَ يّشّي كٌنتٌنيِ فُندِ بِرِن فَن تّ رَ سّرّشّبَدٍ قَرِ سّرّشّ فَن دَاشِ رَ، نَشَن شِرِ رَقَن عَلَتَلَ مَ. عَ نَ بِرِن نَبَ نّ عَلْ عَلَتَلَ عَ يَمَرِشِ كِ نَشّ.<verse eid="LEV 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 8:22"/>عَننَبِ مُنسَ نَشَ يّشّي كٌنتٌنيِ قِرِن ندٍ تٌنفٌ نَشَن قِندِ سّرّشّدُبّ دْشْ سّرّشّ رَ. هَرُنَ نُن عَ شَ دِيٍ نَشَ عٍ بّلّشّيٍ سَ نَ يّشّي شُن تَفِ. <verse eid="LEV 8:22"/><verse number="23" style="v" sid="LEV 8:23"/>عَننَبِ مُنسَ نَشَ عَ كْن نَشَبَ، عَ عَ وُلِ ندٍ تٌنفٌ، عَ عَ سَ هَرُنَ يِرٍقَنيِ تُلِ مَ، عَ يِرٍقَنيِ بّلّشّكُرَ مَ، نُن عَ سَنكُرَ مَ. <verse eid="LEV 8:23"/><verse number="24" style="v" sid="LEV 8:24"/>عَ نَشَ هَرُنَ شَ دِيٍ قَن مَسٌ، عَ نَشَ وُلِ ندٍ سَ عٍ يِرٍقَنيِ تُلِيٍ مَ، عٍ يِرٍقَنيِ بّلّشّكُرَ مَ، نُن عٍ يِرٍقَنيِ سَنكُرَ مَ. عَ نَشَ عَ وُلِ ندٍ كَسَن سّرّشّبَدٍ سّيتِيٍ مَ. <verse eid="LEV 8:24"/><verse number="25" style="v" sid="LEV 8:25"/>عَ نَشَ نَ يّشّي تُرٍ تٌنفٌ، عَ نُن عَ شُلِ، عَ قُرِنفّ تُرٍ، لَارٍ نَشَن نَ عَ بْحّ قَرِ، عَ فُنفُي شْرِ قِرِنيِيٍ نُن عٍ تُرٍ، نُن عَ يِرٍقَنيِ تَبٍ.<verse eid="LEV 8:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 8:26"/>عَننَبِ مُنسَ نَشَ دٍبٍ تٌنفٌ تَامِ لّبِنِتَرٍيٍ نَ نَشَن كُي، نَشَن نُ دْشْشِ عَلَتَلَ يَ عِ. عَ نَشَ تَامِ لّبِنِتَرٍ كٍرٍن بَ نَ، عَ نُن تَامِ كٍرٍن نَشَن يَءِلَنشِ تُرٍ رَ، عَ نُن تَامِ لَنمَدِ كٍرٍن. عَ نَشَ عٍ سَ نَ يّشّي تُرٍ نُن عَ يِرٍقَنيِ تَبٍ قَرِ. <verse eid="LEV 8:26"/><verse number="27" style="v" sid="LEV 8:27"/>عَ نَشَ نَ بِرِن سٌ هَرُنَ نُن عَ شَ دِيٍ يِ رَ، عٍ قَ نَ لِنتَن عَلَتَلَ يَ عِ عَلَكٌ عَ شَ عَ كٌلٌن عَ فبٍ نَ عَ رَ. <verse eid="LEV 8:27"/><verse number="28" style="v" sid="LEV 8:28"/>نَ دَنفِ شَنبِ، عَننَبِ مُنسَ نَشَ عٍ رَ سُشُ عٍ يِ رَ، عَ نَشَ عٍ سَ تّ سّرّشّبَدٍ قَرِ، سّرّشّ فَن دَاشِ نُ نَ دّننَشّ. سّرّشّدُبّ دْشْ سّرّشّ نَ عَ رَ، نَشَن فَن شِرِ رَقَن عَلَتَلَ مَ.<verse eid="LEV 8:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 8:29"/>عَننَبِ مُنسَ نَشَ يّشّي كٌنتٌنيِ كَنكٍ تٌنفٌ نَ سّرّشّدُبّ دْشْ سّرّشّ رَ، عَ قَ نَ لِنتَن عَلَتَلَ يَ عِ عَ مَسٍنقٍ رَ عَ بّ. نَ نَشَ قِندِ عَننَبِ مُنسَ فبٍ رَ عَلْ عَلَتَلَ عَ يَمَرِشِ كِ نَشّ.<verse eid="LEV 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LEV 8:30"/>عَننَبِ مُنسَ نَشَ تُرٍ سّنِيّنشِ ندٍ تٌنفٌ، عَ نُن وُلِ ندٍ نَشَن نُ نَ سّرّشّبَدٍ قَرِ، عَ نَشَ عَ كَسَن هَرُنَ نُن عَ شَ دُفِيٍ مَ، عَ عَ كَسَن هَرُنَ شَ دِيٍ نُن عٍ شَ دُفِيٍ قَن مَ، عَلَكٌ عٍ تَن نُن عٍ شَ دُفِيٍ بِرِن شَ سّنِيّن.<verse eid="LEV 8:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 8:31"/>مُنسَ نَشَ عَ قَلَ هَرُنَ نُن عَ شَ دِيٍ بّ، «وٌ سُبٍ حِن هْرْ مْلِنفِرَ سٌدٍ دّ رَ، وٌ شَ عَ دٌن مّننِ، عَ نُن تَامِ نَشَن نَ دٍبٍ كُي نَشَن قِندِ سّرّشّدُبّ دْشْ سّرّشّ رَ. ﭑ بَرَ يَامَرِ قِ، هَرُنَ نُن عَ شَ دِيٍ شَ نَ دٌن. <verse eid="LEV 8:31"/><verse number="32" style="v" sid="LEV 8:32"/>تَامِ نُن سُبٍ نَشَن لُشِ، وٌ شَ نَ دْنشْي فَن. <verse eid="LEV 8:32"/><verse number="33" style="v" sid="LEV 8:33"/>وٌ نَشَ كٍلِ هْرْ مْلِنفِرَ سٌدٍ دّ رَ شِ سٌلٌقٍرٍ بُن مَ، هَن وٌ شَ دْشْي وَشَتِ كَمَلِمَ تّمُي نَشّ. <verse eid="LEV 8:33"/><verse number="34" style="v" sid="LEV 8:34"/>نَشَن نَبَشِ تٌ، عَلَتَلَ عَ يَمَرِشِ وٌ يُنُبِ شُنسَرٍ شَ قٍ نَن نَ. <verse eid="LEV 8:34"/><verse number="35" style="v" sid="LEV 8:35"/>نَ نَ عَ تٌشِ، وٌ لُمَ هْرْ مْلِنفِرَ سٌدٍ دّ رَ شِ سٌلٌقٍرٍ بُن مَ، كْي نُن يَنيِ، عَلْ عَلَتَلَ ﭑ يَمَرِشِ عَ رَ كِ نَشّ، عَلَكٌ وٌ نَشَ قَشَ.» <verse eid="LEV 8:35"/><verse number="36" style="v" sid="LEV 8:36"/>هَرُنَ نُن عَ شَ دِيٍ نَشَ عَلَتَلَ شَ يَامَرِ بِرِن نَبَ نَ كِ عَ نَشَن مَسٍنشِ عٍ بّ عَننَبِ مُنسَ سَابُي رَ.<verse eid="LEV 8:36"/></para>
  <chapter eid="LEV 8"/>
  <chapter number="9" style="c" sid="LEV 9"/>
  <para style="s">سّرّشّدُبّيٍ شَ سّرّشّ سِنفٍيٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 9:1"/>شِ سٌلٌمَسَشَن لْشْي، عَننَبِ مُنسَ نَشَ هَرُنَ نُن عَ شَ دِيٍ، نُن عِسِرَيِلَ قٌرِيٍ شِلِ. <verse eid="LEV 9:1"/><verse number="2" style="v" sid="LEV 9:2"/>عَ نَشَ عَ مَسٍن هَرُنَ بّ، «عِ شَ سّرّشّ قِرِن مَسٍن عَلَتَلَ بّ، تُورَ دِ نَشَن قِندِ مَ يُنُبِ شَقَرِ سّرّشّ رَ، عَ نُن يّشّي كٌنتٌنيِ نَشَن قِندِ مَ سّرّشّ فَن دَاشِ رَ، لَنيُرُ مُ نَ نَشَن مَ. <verse eid="LEV 9:2"/><verse number="3" style="v" sid="LEV 9:3"/>عِ شَ عَ قَلَ عِسِرَيِلَكَيٍ بّ، ‹وٌ شَ سِكْتّ كٍرٍن بَ يُنُبِ شَقَرِ سّرّشّ رَ. وٌ شَ تُورَ دِ نُن يّشّي دِ نَشٍيٍ بَرَ حّ كٍرٍن سْتْ، لَنيُرُ مُ نَ نَشٍيٍ مَ، وٌ شَ عٍ بَ سّرّشّ فَن دَاشِ رَ. <verse eid="LEV 9:3"/><verse number="4" style="v" sid="LEV 9:4"/>وٌ شَ تُورَ نُن يّشّي كٌنتٌنيِ بَ شَنُنتٍيَ سّرّشّ رَ عَلَتَلَ بّ. وٌ شَ تَامِ قَن بَ سّرّشّ رَ، تُرٍ سُنبُشِ نَشَن نَ. وٌ شَ نَ بِرِن بَ بَرِ مَ عَلَتَلَ مِنِمَ نّ وٌ مَ تٌ.›»<verse eid="LEV 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 9:5"/>حَمَ نَشَ سّرّشّيٍ شَنِن هْرْ مْلِنفِرَ سٌدٍ دّ رَ عَلْ عَننَبِ مُنسَ عٍ يَمَرِشِ كِ نَشّ. عٍ بِرِن نَشَ عٍ مَكْرّ هْرْ مْلِنفِرَ رَ، عٍ تِ عَلَتَلَ يَ عِ. <verse eid="LEV 9:5"/><verse number="6" style="v" sid="LEV 9:6"/>عَننَبِ مُنسَ نَشَ عَ مَسٍن عٍ بّ، «وٌ شَ عَلَتَلَ شَ يَامَرِ رَبَتُ عَلَكٌ عَ شَ عَ نْرّ مَسٍن وٌ بّ.»<verse eid="LEV 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 9:7"/>عَننَبِ مُنسَ نَشَ عَ مَسٍن هَرُنَ بّ، «عِ مَسٌ سّرّشّبَدٍ رَ. عِ شَ يُنُبِ شَقَرِ سّرّشّ نُن سّرّشّ فَن دَاشِ بَ شُنسَرٍ رَ عِ يّتّ بّ، عَ نُن حَمَ بّ. عِ شَ حَمَ شَ سّرّشّ قَن بَ عٍ بّ شُنسَرٍ رَ عَلْ عَلَتَلَ عَ يَمَرِشِ كِ نَشّ.»<verse eid="LEV 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 9:8"/>هَرُنَ تٌ عَ مَسٌ سّرّشّبَدٍ رَ، عَ نَشَ تُورَ دِ كْن نَشَبَ عَ يّتّ يُنُبِ شَقَرِ سّرّشّ رَ. <verse eid="LEV 9:8"/><verse number="9" style="v" sid="LEV 9:9"/>عَ شَ دِيٍ نَشَ تُورَ وُلِ سٌ عَ يِ رَ. عَ نَشَ عَ بّلّشّسٌلٍ رَ سِن وُلِ شْورَ، عَ ندٍ سَ قٍرِيٍ مَ نَشٍيٍ نُ نَ سّرّشّبَدٍ تُنشُنيِ نَانِ رَ. عَ نَشَ وُلِ دْنشْي عِقِلِ سّرّشّبَدٍ لَنبَنيِ مَ. <verse eid="LEV 9:9"/><verse number="10" style="v" sid="LEV 9:10"/>شُرُ سٍ تُرٍ، عَ فُنفُييٍ، نُن لَارٍ نَشَن نَ عَ بْحّ مَ، عَ نَشَ نَ بِرِن فَن سّرّشّبَدٍ قَرِ يُنُبِ شَقَرِ سّرّشّ رَ عَلْ عَلَتَلَ عَننَبِ مُنسَ يَمَرِشِ عَ رَ كِ نَشّ. <verse eid="LEV 9:10"/><verse number="11" style="v" sid="LEV 9:11"/>كْنْ عَ نَشَ عَ سُبٍ نُن عَ كِرِ فَن حَمَ يٌنكِندٍ قَرِ مَ.<verse eid="LEV 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 9:12"/>نَ دَنفِ شَنبِ، هَرُنَ نَشَ سّرّشّ فَن دَاشِ كْن نَشَبَ. عَ شَ دِيٍ نَشَ نَ وُلِ سٌ عَ يِ رَ، عَ قَ عَ كَسَن سّرّشّبَدٍ سّيتِيٍ مَ. <verse eid="LEV 9:12"/><verse number="13" style="v" sid="LEV 9:13"/>عٍ نَشَ سّرّشّ شُنتُنيِيٍ نُن عَ شُنيِ سٌ عَ يِ رَ، عَ نَ بِرِن فَن سّرّشّبَدٍ قَرِ. <verse eid="LEV 9:13"/><verse number="14" style="v" sid="LEV 9:14"/>عَ تٌ فّ عَ قُرِنفّ نُن عَ سَنيِيٍ رَشَدٍ، عَ نَشَ عٍ فَن عٍ نُن سّرّشّ فَن دَاشِ رَ سّرّشّبَدٍ قَرِ.<verse eid="LEV 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 9:15"/>هَرُنَ فّ شَنبِ نَ رَ، عَ نَشَ حَمَ شَ سِكْتّ كْن نَشَبَ، عَ شَ قِندِ يُنُبِ شَقَرِ سّرّشّ رَ حَمَ بّ. عَ نَ رَبَ نّ عَلْ عَ عَ سِنفٍ رَبَ كِ نَشّ. <verse eid="LEV 9:15"/><verse number="16" style="v" sid="LEV 9:16"/>عَ نَشَ سّرّشّ فَن دَاشِ بَ عَ سّرِيّ كِ مَ. <verse eid="LEV 9:16"/><verse number="17" style="v" sid="LEV 9:17"/>عَ نَشَ سَنسِ شْرِ دِنشِ سُشُ كٍرٍن فَن سّرّشّبَدٍ قَرِ سّرّشّ فَن دَاشِ بَ تّمُي فّيسّفّ. <verse eid="LEV 9:17"/><verse number="18" style="v" sid="LEV 9:18"/>عَ نَشَ تُورَ نُن يّشّي كٌنتٌنيِ كْن نَشَبَ شَنُنتٍيَ سّرّشّ رَ حَمَ بّ. عَ شَ دِيٍ نَشَ نَ وُلِ سٌ عَ يِ، عَ عَ كَسَن سّرّشّبَدٍ سّيتِيٍ مَ. <verse eid="LEV 9:18"/><verse number="19" style="v" sid="LEV 9:19"/>عٍ نَشَ تُورَ نُن يّشّي كٌنتٌنيِ تُرٍ تٌنفٌ، نَشَن نَ عٍ شُلِ نُن عٍ قُرِنفّ مَبِرِ، عَ نُن عٍ فُنفُييٍ، عَ نُن لَارٍ نَشَن نَ عٍ بْحّ مَ، <verse eid="LEV 9:19"/><verse number="20" style="v" sid="LEV 9:20"/>عٍ نَشَ نَ بِرِن سَ سُبٍ كَنكٍ مَ سّرّشّبَدٍ قَرِ، عٍ عَ بِرِن فَن. <verse eid="LEV 9:20"/><verse number="21" style="v" sid="LEV 9:21"/>هَرُنَ نَشَ سّرّشّ سُبٍيٍ كَنكٍ نُن عٍ يِرٍقَنيِ تَبٍ عِتٍ، عَ عٍ لِنتَن عَلَتَلَ يَ عِ عَ مَسٍنقٍ رَ عَ بّ، عَلْ عَننَبِ مُنسَ عَ يَمَرِشِ كِ نَشّ.<verse eid="LEV 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 9:22"/>هَرُنَ نَشَ عَ بّلّشّيٍ عِتَلَ، عَ دُبَ حَمَ بّ. عَ تٌ يُنُبِ شَقَرِ سّرّشّ، سّرّشّ فَن دَاشِ، نُن شَنُنتٍيَ سّرّشّ بَ، عَ نَشَ فٌرٌ كٍلِقٍ سّرّشّبَدٍ سّيتِيٍ مَ. <verse eid="LEV 9:22"/><verse number="23" style="v" sid="LEV 9:23"/>عَننَبِ مُنسَ نُن هَرُنَ نَشَ سٌ هْرْ مْلِنفِرَ كُي. عٍ تٌ مِنِ، عٍ نَشَ دُبَ حَمَ بّ. نَ تّمُي عَلَتَلَ شَ نْرّ نَشَ مِنِ حَمَ مَ. <verse eid="LEV 9:23"/><verse number="24" style="v" sid="LEV 9:24"/>عَلَتَلَ نَشَ تّ رَفٌرٌ سّرّشّبَدٍ قَرِ، عَ سّرّشّ فَن دَاشِ نُن تُرٍ فَن. حَمَ تٌ نَ تٌ، عٍ نَشَ عٍ شُي عِتٍ سّيوّ رَ، عٍ عٍ قٍلٍن بْشِ مَ.<verse eid="LEV 9:24"/></para>
  <chapter eid="LEV 9"/>
  <chapter number="10" style="c" sid="LEV 10"/>
  <para style="s">هَرُنَ شَ دِ قِرِنيِيٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 10:1"/>هَرُنَ شَ دِ قِرِنيِيٍ، نَدَبٌ نُن عَبِهُ نَشَ سُرَيِ فَنسٍيٍ تٌنفٌ، عٍ تّ سَ عٍ كُي، عٍ سُرَيِ فَن عَلَتَلَ يَ عِ. كْنْ عٍ مُ نَ تّ تٌنفٌ عَلَ شَ سّرِيّ كِ مَ. <verse eid="LEV 10:1"/><verse number="2" style="v" sid="LEV 10:2"/>نَ نَ عَ تٌ، عَلَتَلَ نَشَ تّ رَفٌرٌ عٍ مَ، عٍ قَشَ عَ شَ هْرْ مْلِنفِرَ يِرٍ سّنِيّنشِ كُي. <verse eid="LEV 10:2"/><verse number="3" style="v" sid="LEV 10:3"/>عَننَبِ مُنسَ نَشَ عَ قَلَ هَرُنَ بّ، «عَلَتَلَ وٌ رَكٌلٌنشِ نّ يِ رَ، عَ تٌ عَ قَلَ، ‹نَشٍيٍ مَكْرّ ﭑ نَ، عٍ شَ عَ كٌلٌن ﭑ سّنِيّن، حَمَ شَ ﭑ بِنيَ.›» هَرُنَ نَشَ دُندُ يٍن.<verse eid="LEV 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 10:4"/>عَننَبِ مُنسَ نَشَ مِكَيٍلِ نُن عٍلِسَقَن شِلِ، هَرُنَ بَبَ شُنيَ يُسِيّلِ شَ دِيٍ. عَ نَشَ عَ قَلَ عٍ بّ، «وٌ شَ وٌ نفَشَكٍرٍنيِيٍ قُرٍيٍ شَنِن حَمَ يٌنكِندٍ قَرِ مَ، دّننَشّ مَكُيَ يِرٍ سّنِيّنشِ رَ.» <verse eid="LEV 10:4"/><verse number="5" style="v" sid="LEV 10:5"/>عٍ نَشَ عٍ قُرٍيٍ شَنِن حَمَ يٌنكِندٍ قَرِ مَ، عَلْ عَننَبِ مُنسَ عٍ يَمَرِشِ كِ نَشّ. عٍ نُ بَرَ سّرّشّدُبّ دُفِيٍ لُ عٍ قُرٍيٍ مَ.<verse eid="LEV 10:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 10:6"/>عَننَبِ مُنسَ نَشَ عَ قَلَ هَرُنَ نُن عَ شَ دِيٍ بّ، عٍلٍيَسَرِ نُن عِتَمَرِ، «وٌ نَشَ وٌ شُنسّشّ رَبّحِن، وٌ نَشَ وٌ شَ دُفِيٍ قَن عِبْو. وٌ نَشَ سٍسٍ رَبَ نَشَن نْمَ سُننُنيِ مَسٍندٍ يِ مِشِيٍ شَ قَشّ شَ قٍ رَ، عَلَكٌ عَلَتَلَ نَشَ شْنْ حَمَ مَ، عَ وٌ قَن قَشَ. وٌ نفَشَكٍرٍنيِ عِسِرَيِلَكَيٍ تَن نْمَ سُننُندٍ يِ مِشِيٍ شَ قٍ رَ عَلَتَلَ نَشٍيٍ قَشَشِ تّ رَ. <verse eid="LEV 10:6"/><verse number="7" style="v" sid="LEV 10:7"/>وٌ نَشَ كٍلِ عَلَ شَ هْرْ مْلِنفِرَ سٌدٍ دّ رَ يِ سَشَنيِ، عَلَكٌ وٌ نَشَ قَشَ. عَلَتَلَ شَ مِشِ سُفَندِشِيٍ نَن وٌ تَن نَ.» عٍ نَشَ عَننَبِ مُنسَ شَ يَامَرِ رَبَتُ.<verse eid="LEV 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 10:8"/>عَلَتَلَ نَشَ عَ مَسٍن هَرُنَ بّ، <verse eid="LEV 10:8"/><verse number="9" style="v" sid="LEV 10:9"/>«وٌ نَ سٌ هْرْ مْلِنفِرَ كُي، وٌ نَشَ وّنِ مِن. وٌ نَشَ مِنسٍ يٌ مِن نَشَن مِشِ سِيسِمَ، شَ نَ مُ عَ رَ وٌ قَشَمَ نّ. نَ سّرِيّ مُ كَنَمَ وٌ بْنسْي بّ عَبَدَن. <verse eid="LEV 10:9"/><verse number="10" style="v" sid="LEV 10:10"/>نَ نَن عَ نِيَمَ وٌ نْمَ عَلَ فبٍ نُن عَدَ مَدِ فبٍ تَفِ رَبَدٍ، سّنِيّنيِ نُن سّنِيّنتَرٍحَ. <verse eid="LEV 10:10"/><verse number="11" style="v" sid="LEV 10:11"/>نَ قَن عَ نِيَمَ نّ وٌ شَ نْ عِسِرَيِلَكَيٍ شَرَندٍ عَلَتَلَ شَ يَامَرِيٍ رَ، عَ نَشٍيٍ قِشِ عٍ مَ عَننَبِ مُنسَ سَابُي رَ.»<verse eid="LEV 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 10:12"/>عَننَبِ مُنسَ نَشَ عَ قَلَ هَرُنَ نُن عَ شَ دِ دْنشْييٍ بّ، عٍلٍيَسَرِ نُن عِتَمَرِ، «سَنسِ شْرِ دِنشِ نَشَن بَشِ سّرّشّ رَ عَلَتَلَ بّ، كْنْ نَشَن بِرِن مُ فَنشِ تّ رَ، وٌ شَ نَ دٌن سّرّشّبَدٍ قّ مَ. وٌ نَشَ لّبِنِ سَ عَ شُن مَ دٍ، بَرِ مَ عَ سّنِيّن. <verse eid="LEV 10:12"/><verse number="13" style="v" sid="LEV 10:13"/>وٌ شَ عَ دٌن يِرٍ سّنِيّنشِ، بَرِ مَ عَ فَنشِ عَلَتَلَ بّ سّرّشّ فَن دَاشِيٍ نَن قّ مَ. نَ قِندِشِ عِ فبٍ نُن عِ شَ دِيٍ فبٍ نَن نَ. عَلَتَلَ سّرّشّدُبّيٍ يَمَرِشِ نَ نَن نَ. <verse eid="LEV 10:13"/><verse number="14" style="v" sid="LEV 10:14"/>وٌ مَن شَ سّرّشّ سُبٍ كَنكٍ نُن تَبٍ دٌن يِرٍ سّنِيّنشِ نّ، نَشٍيٍ بَرَ لِنتَن عَلَ يَ عِ، عَ مَسٍنقٍ رَ عَ بّ. نٍيٍ قِندِشِ وٌ فبٍ نَن نَ، عِ تَن، عِ شَ دِ شّمّيٍ، نُن عِ شَ دِ فِنّيٍ. عَلَ بَرَ نَ يَامَرِ قِ عِسِرَيِلَكَيٍ مَ عٍ شَ شَنُنتٍيَ سّرّشّيٍ شَ قٍ رَ. <verse eid="LEV 10:14"/><verse number="15" style="v" sid="LEV 10:15"/>تُرٍ نَشَن فَنمَ يٌ، تَبٍ نَشَن بَمَ يٌ، نُن كَنكٍ نَشَن لِنتَنمَ يٌ، عٍ شَ نَ بِرِن مَسٍن عَلَتَلَ بّ، نَ قَ قِندِ عِ فبٍ نُن عِ شَ دِيٍ فبٍ رَ، عَلْ عَلَتَلَ عَ يَمَرِشِ كِ نَشّ. سّرِيّ نَ عَ رَ نَشَن مُ كَنَمَ عَبَدَن.»<verse eid="LEV 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 10:16"/>عَننَبِ مُنسَ تٌ سِكْتّ شَ قٍ مَشْرِن، نَشَن بَ يُنُبِ شَقَرِ سّرّشّ رَ، عَ نَشَ عَ مّ عَ عٍ نُ بَرَ عَ بِرِن فَن تّ رَ، عَ نَشَ شْنْ عٍلٍيَسَرِ نُن عِتَمَرِ مَ، هَرُنَ شَ دِيٍ نَشٍيٍ مُ قَشَ. عَ نَشَ عَ قَلَ عٍ بّ، <verse eid="LEV 10:16"/><verse number="17" style="v" sid="LEV 10:17"/>«مُنقٍ رَ وٌ مُ يِ يُنُبِ شَقَرِ سّرّشّ سُبٍ دٌنشِ يِرٍ سّنِيّنشِ؟ سّرّشّ سّنِيّنشِ نَ عَ رَ عَلَتَلَ نَشَن قِشِ وٌ مَ، عَلَكٌ عِسِرَيِلَ حَمَ شَ يُنُبِ شَ شَقَرِ، عَ قِندِ شُنسَرٍ رَ عٍ بّ عَلَتَلَ يَ عِ. <verse eid="LEV 10:17"/><verse number="18" style="v" sid="LEV 10:18"/>يِ سّرّشّ وُلِ تٌ مُ سٌشِ يِرٍ سّنِيّنشِ مَ هْرْ مْلِنفِرَ كُي، عَ نُ لَن نّ وٌ شَ عَ سُبٍ دٌن يِرٍ سّنِيّنشِ نّ، عَلْ عَلَ ﭑ يَمَرِشِ عَ رَ كِ نَشّ.» <verse eid="LEV 10:18"/><verse number="19" style="v" sid="LEV 10:19"/>هَرُنَ نَشَ عَننَبِ مُنسَ يَابِ، «تٌ عٍ بَرَ عٍ شَ يُنُبِ شَقَرِ سّرّشّ نُن عٍ شَ سّرّشّ فَن دَاشِ بَ عَلَتَلَ يَ عِ، كْنْ ﭑ تٌ بَرَ يِ قٍ شْرْشْي مْولِ سْتْ، عَلَتَلَ نْمَ تِندٍ ﭑ شَ يُنُبِ شَقَرِ سّرّشّ سُبٍ دٌن تٌ؟» <verse eid="LEV 10:19"/><verse number="20" style="v" sid="LEV 10:20"/>عَننَبِ مُنسَ تٌ نَ يَابِ مّ، عَ نَشَ تِن عَ رَ.<verse eid="LEV 10:20"/></para>
  <chapter eid="LEV 10"/>
  <chapter number="11" style="c" sid="LEV 11"/>
  <para style="s">دٌنسٍ رَدَشَشِ نُن دٌنسٍ رَهَرَ مُشِ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 11:1"/>عَلَتَلَ نَشَ عَ مَسٍن عَننَبِ مُنسَ نُن هَرُنَ بّ، <verse eid="LEV 11:1"/><verse number="2" style="v" sid="LEV 11:2"/>«وٌ شَ عَ قَلَ عِسِرَيِلَكَيٍ بّ، سُبٍ نَشٍيٍ رَدَشَشِ وٌ بّ، نٍيٍ نَن يَ؛ <verse eid="LEV 11:2"/><verse number="3" style="v" sid="LEV 11:3"/>سُبٍ تٌرٍ كَنيِيٍ نَشٍيٍ تٌرٍ عِتَشُنشِ قِرِنيِ رَ، عٍ مَن عٍ شَ دٌنسٍ رَتٍمَ عٍ دّ عِ عٍ نُ عَ عِدٌن. وٌ نْمَ نَ سُبٍ مْولِ دٌندٍ.»<verse eid="LEV 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 11:4"/>«كْنْ ندٍيٍ نَ نَشٍيٍ دٌنسٍ رَتٍمَ عٍ دّ عِ عٍ نُ عَ عِدٌن، عٍ تٌرٍ تَن مُ عِتَشُنشِ قِرِنيِ رَ. نٍيٍ رَهَرَ مُشِ وٌ مَ. حْشْمّ رَهَرَ مُشِ وٌ مَ، بَرِ مَ عَ دٌنسٍ رَتٍمَ عَ دّ عِ عَ نُ عَ عِدٌن، كْنْ عَ تٌرٍ مُ عِتَشُنشِ قِرِنيِ رَ. <verse eid="LEV 11:4"/><verse number="5" style="v" sid="LEV 11:5"/>يٍرٍ مَنِيّ ندٍ قَن دٌنسٍ رَتٍمَ عَ دّ عِ عَ نُ عَ عِدٌن، كْنْ عَ تٌرٍ مُ عِتَشُنشِ قِرِنيِ رَ. عَ رَهَرَ مُشِ وٌ مَ. <verse eid="LEV 11:5"/><verse number="6" style="v" sid="LEV 11:6"/>يٍرٍ قَن دٌنسٍ رَتٍمَ عَ دّ عِ عَ نُ عَ عِدٌن، كْنْ عَ تٌرٍ مُ عِتَشُنشِ قِرِنيِ رَ. عَ رَهَرَ مُشِ وٌ مَ. <verse eid="LEV 11:6"/><verse number="7" style="v" sid="LEV 11:7"/>شْسّ تَن، عَ تٌرٍ عِتَشُنشِ قِرِنيِ رَ، كْنْ عَ مُ دٌنسٍ رَتٍمَ عَ دّ عِ عَ نُ عَ عِدٌن. عَ رَهَرَ مُشِ وٌ مَ. <verse eid="LEV 11:7"/><verse number="8" style="v" sid="LEV 11:8"/>وٌ نَشَ نَ سُبٍيٍ دٌن، وٌ نَشَ دِن عٍ بِنبِيٍ رَ. عٍ رَهَرَ مُشِ وٌ مَ.»<verse eid="LEV 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 11:9"/>«يّشّ نَشٍيٍ نَ يٍ شْورَ، وٌ نْمَ نَشٍيٍ دٌندٍ، نٍيٍ نَن يَ؛ شَلٍ كَنيِ نُن بّلّ كَنيِ نَشٍيٍ نَ بَا مَ، شَ نَ مُ عَ رَ شُرٍ كُي. <verse eid="LEV 11:9"/><verse number="10" style="v" sid="LEV 11:10"/>كْنْ يّشّ نَشٍيٍ نَ بَا مَ، شَ نَ مُ عَ رَ شُرٍ كُي، بّلّ مُ نَ نَشٍيٍ مَ، شَ نَ مُ عَ رَ شَلٍ مُ نَ نَشٍيٍ مَ، عٍ رَهَرَ مُشِ وٌ مَ. <verse eid="LEV 11:10"/><verse number="11" style="v" sid="LEV 11:11"/>عٍ رَهَرَ مُشِ وٌ مَ، وٌ نَشَ عٍ سُبٍ دٌن. عٍ بِنبِيٍ قَن رَهَرَ مُشِ وٌ مَ. <verse eid="LEV 11:11"/><verse number="12" style="v" sid="LEV 11:12"/>يّشّ بِرِن بّلّ نُن شَلٍ مُ نَ نَشٍيٍ مَ، عٍ رَهَرَ مُشِ وٌ مَ.»<verse eid="LEV 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 11:13"/>«شْنِ رَهَرَ مُشِيٍ نَن يَ وٌ مُ لَن وٌ شَ نَشٍيٍ دٌن؛ يُبّ، سّفّ، شَرُ مَ فبْنتْي، <verse eid="LEV 11:13"/><verse number="14" style="v" sid="LEV 11:14"/>عَ نُن نٍيٍ مَنِيّ بِرِن. <verse eid="LEV 11:14"/><verse number="15" style="v" sid="LEV 11:15"/>شَاشَ قَن، وٌ نَشَ نَ دٌن عَ نُن عَ مَنِيّ بِرِن. <verse eid="LEV 11:15"/><verse number="16" style="v" sid="LEV 11:16"/>شُندِ، كٌوقٌلٍ، عَ نُن تَفَرَنتٌنفٌي، <verse eid="LEV 11:16"/><verse number="17" style="v" sid="LEV 11:17"/>وٌ نَشَ عٍ دٌن عَ نُن نٍيٍ مَنِيّ بِرِن. <verse eid="LEV 11:17"/><verse number="18" style="v" sid="LEV 11:18"/>فبْنفبٌي، يٍدْنمّ، <verse eid="LEV 11:18"/><verse number="19" style="v" sid="LEV 11:19"/>لَابَ، تُكّ، عَ نُن نٍيٍ مَنِيّ بِرِن، وٌ نَشَ عٍ دٌن.»<verse eid="LEV 11:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 11:20"/>«نِمَسٍ فَبُتٍنيِ نُن سَنيِ نَ نَشٍيٍ مَ، عٍ رَهَرَ مُشِ وٌ مَ. <verse eid="LEV 11:20"/><verse number="21" style="v" sid="LEV 11:21"/>كْنْ نَ نِمَسٍ مْولِيٍ يَ مَ، نَشٍيٍ تُفَنمَ، وٌ نْمَ نٍيٍ تَن دٌندٍ، <verse eid="LEV 11:21"/><verse number="22" style="v" sid="LEV 11:22"/>عَلْ كَتٌي، تُفُمِيٍ، نُن نٍيٍ مَنِيّ بِرِن. <verse eid="LEV 11:22"/><verse number="23" style="v" sid="LEV 11:23"/>كْنْ، نِمَسٍ فَبُتٍنيِ نُن سَنيِ نَ نَشٍيٍ مَ، عٍ رَهَرَ مُشِ وٌ مَ.»<verse eid="LEV 11:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 11:24"/>«شَ وٌ دِنمَ سُبٍ سّنِيّنتَرٍ رَ، وٌ قِندِ مَ مِشِ سّنِيّنتَرٍ رَ هَن نُنمَرٍ رَ. <verse eid="LEV 11:24"/><verse number="25" style="v" sid="LEV 11:25"/>نَشَن عٍ بِنبِيٍ مَشَنِنمَ، نَ كَنيِ لَن نّ عَ شَ عَ شَ دُفِيٍ شَ، عَ مَن قَ قِندِ مِشِ سّنِيّنتَرٍ رَ هَن نُنمَرٍ رَ. قٌ عَ شَ عَ شَ دُفِيٍ شَ. <verse eid="LEV 11:25"/><verse number="26" style="v" sid="LEV 11:26"/>سُبٍ نَشٍيٍ بِرِن تٌرٍ مُ عِتَشُنشِ قِرِنيِ رَ، عَ نُن نَشٍيٍ دٌنسٍ دٌنمَ، كْنْ عَ مُ فبِلٍنمَ عَ رَتٍ رَ عٍ دّ عِ عٍ نُ عَ عِدٌن، نٍيٍ رَهَرَ مُشِ وٌ مَ. نَشَن دِنمَ نَ مْولِ رَ عَ قِندِ مَ مِشِ سّنِيّنتَرٍ رَ. <verse eid="LEV 11:26"/><verse number="27" style="v" sid="LEV 11:27"/>سُبٍ بِرِن تٌرٍ مُ نَ نَشٍيٍ بّ، عٍ عٍ حّرّ عٍ سَنيِ نَانِيٍ شُن نَ، عٍ رَهَرَ مُشِ وٌ مَ. نَشَن دِنمَ عٍ بِنبِيٍ رَ نَ قِندِ مَ مِشِ سّنِيّنتَرٍ رَ هَن نُنمَرٍ رَ. <verse eid="LEV 11:27"/><verse number="28" style="v" sid="LEV 11:28"/>عٍ رَهَرَ مُشِ وٌ مَ. نَشَن عٍ بِنبِيٍ مَشَنِنمَ، نَ كَنيِ لَن نّ عَ شَ عَ شَ دُفِيٍ شَ، عَ مَن قَ قِندِ مِشِ سّنِيّنتَرٍ رَ هَن نُنمَرٍ رَ.»<verse eid="LEV 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 11:29"/>«نِمَسٍ نَشَن بِرِن لُمَ يِلِيٍ كُي، عٍ هَرَ مُشِ وٌ بّ. عٍ شِلِيٍ نَن يَ؛ بَلٍ، حّنّ، كَسَ، <verse eid="LEV 11:29"/><verse number="30" style="v" sid="LEV 11:30"/>بٌنبٌلِكَ، كٌولٌ، نُن نٍيٍ مَنِيّيٍ. <verse eid="LEV 11:30"/><verse number="31" style="v" sid="LEV 11:31"/>نَ نِمَسٍ شُنشُرِ مْولِيٍ رَهَرَ مُشِ وٌ مَ. نَشَن دِنمَ عٍ بِنبِيٍ رَ عَ قِندِ مَ مِشِ سّنِيّنتَرٍ رَ هَن نُنمَرٍ رَ. <verse eid="LEV 11:31"/><verse number="32" style="v" sid="LEV 11:32"/>شَ عٍ بِنبِيٍ سَ بِرَ سٍ ندٍ قَرِ، نَ قَن قِندِ مَ سٍ سّنِيّنتَرٍ رَ، عَلْ سٍ سَ سٍ وُرِ دَاشِ، دُفِ، شُرُ سٍ كِرِ شَرَشِ، بّكِ، شَ نَ مُ عَ رَ يِرَبَسٍ ندٍ. عَ لَنمَ نَ سٍ مْولِ شَ سَ يٍ شْورَ هَن نُنمَرٍ رَ عَلَكٌ عَ شَ سّنِيّن. <verse eid="LEV 11:32"/><verse number="33" style="v" sid="LEV 11:33"/>شَ نَ نِمَسٍ مْولِ بِرَ قّحّ ندٍ كُي، قّحّ نُن عَ كُي سٍ بِرِن قِندِ مَ سٍ سّنِيّنتَرٍ رَ. نَ قّحّ شَ كَنَ. <verse eid="LEV 11:33"/><verse number="34" style="v" sid="LEV 11:34"/>يٍ نَشَن نُ نَ نَ قّحّ كُي، عَ نَ سَ دٌنسٍ ندٍ مَ، نَ دٌنسٍ قَن قِندِ مَ سٍ سّنِيّنتَرٍ رَ. مِنسٍ يٌ نَشَن نُ نَ نَ قّحّ كُي، عَ قَن قِندِ مَ سٍ سّنِيّنتَرٍ رَ. <verse eid="LEV 11:34"/><verse number="35" style="v" sid="LEV 11:35"/>شَ نَ نِمَسٍ مْولِ بِنبِ بِرَ سٍ يٌ مَ، نَ قِندِ مَ سٍ سّنِيّنتَرٍ رَ، عَلْ تَامِ فَنسٍ، شَ نَ مُ عَ رَ تُندٍ. عٍ تٌ قِندِ سٍ سّنِيّنتَرٍيٍ رَ، عَ لَنمَ وٌ شَ عٍ كَنَ. <verse eid="LEV 11:35"/><verse number="36" style="v" sid="LEV 11:36"/>كْنْ شَ عٍ بِنبِ سَ بِرَ دُلٌنيِ نَن كُي، شَ نَ مُ عَ رَ يٍ رَفَتَدٍ ندٍ، نٍيٍ تَن مُ قِندِ مَ سٍ سّنِيّنتَرٍيٍ رَ. كْنْ مِشِ نَشَن عَ بّلّشّ دِنمَ عٍ بِنبِيٍ رَ، نَ قِندِ مَ مِشِ سّنِيّنتَرٍ رَ. <verse eid="LEV 11:36"/><verse number="37" style="v" sid="LEV 11:37"/>شَ عَ بِنبِ بِرَ سَنسِ شْرِ مَ نَشَن سِمَ، نَ مُ قِندِ مَ سٍ سّنِيّنتَرٍ رَ. <verse eid="LEV 11:37"/><verse number="38" style="v" sid="LEV 11:38"/>كْنْ شَ عَ بِنبِ بِرَ سَنسِ شْرِ تَن مَ نَشَن نَ يٍ شْورَ، نَ سَنسِ شْرِ قِندِ مَ سٍ سّنِيّنتَرٍ رَ وٌ بّ.»<verse eid="LEV 11:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LEV 11:39"/>«شَ شُرُ سٍ رَدَشَشِ ندٍ قَشَ، مِشِ قَ دِن عَ بِنبِ رَ، نَ كَنيِ قِندِ مَ سّنِيّنتَرٍ رَ هَن نُنمَرٍ رَ. <verse eid="LEV 11:39"/><verse number="40" style="v" sid="LEV 11:40"/>نَشَن نَ عَ سُبٍ دٌن، نَ كَنيِ لَن نّ عَ شَ عَ شَ دُفِيٍ شَ، عَ مَن قَ قِندِ سّنِيّنتَرٍ رَ هَن نُنمَرٍ رَ. نَشَن نَ سُبٍ بِنبِ مَشَنِن، نَ كَنيِ لَن نّ عَ شَ عَ شَ دُفِيٍ شَ، عَ مَن قَ قِندِ سّنِيّنتَرٍ رَ هَن نُنمَرٍ رَ.»<verse eid="LEV 11:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="LEV 11:41"/>«نِمَسٍ نَشَن بِرِن عَ بُبُمَ بْشِ مَ، نٍيٍ بِرِن رَهَرَ مُشِ وٌ مَ. عَ مُ لَنمَ وٌ شَ نٍيٍ دٌن. <verse eid="LEV 11:41"/><verse number="42" style="v" sid="LEV 11:42"/>بُبُسٍيٍ نُن نِمَسٍ شُنشُرِ نَشٍيٍ حّرّ مَ عٍ سَنيِ نَانِ شُن نَ، شَ نَ مُ عَ رَ عٍ سَنيِ وُيَشِ شُن نَ، عٍ سٍسٍ مُ رَدَشَشِ. وٌ نَشَ عٍ دٌن. <verse eid="LEV 11:42"/><verse number="43" style="v" sid="LEV 11:43"/>وٌ نَشَ وٌ يّتّ قِندِ سّنِيّنتَرٍ رَ نَ نِمَسٍ مْولِ سَابُي رَ. وٌ نَشَ عٍ دٌن. <verse eid="LEV 11:43"/><verse number="44" style="v" sid="LEV 11:44"/>عَلَتَلَ نَن ﭑ نَ، وٌ مَرِفِ عَلَ. وٌ شَ وٌ يّتّ قِ ﭑ تَن نَن مَ. وٌ شَ سّنِيّن، بَرِ مَ ﭑ تَن سّنِيّن. وٌ نَشَ وٌ يّتّ قِندِ سّنِيّنتَرٍ رَ نَ نِمَسٍ شُنشُرِ سَابُي رَ نَشٍيٍ لُمَ حّرّ رَ بْشِ مَ.»<verse eid="LEV 11:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LEV 11:45"/>«ﭑ تَن نَن عَلَتَلَ رَ نَشَن وٌ رَ مِنِشِ مِسِرَ بْشِ مَ، عَلَكٌ ﭑ شَ قِندِ وٌ مَرِفِ عَلَ رَ. وٌ شَ سّنِيّن، بَرِ مَ ﭑ تَن سّنِيّن. <verse eid="LEV 11:45"/><verse number="46" style="v" sid="LEV 11:46"/>سّرِيّ نَن نَ كِ سُبٍيٍ، شْنِيٍ، يّشّييٍ، نُن بُبُسٍيٍ شَ قٍ رَ. <verse eid="LEV 11:46"/><verse number="47" style="v" sid="LEV 11:47"/>نَ كُي وٌ نْمَ سُبٍ سّنِيّنشِ نُن سُبٍ سّنِيّنتَرٍ تَفِ رَبَ كٌلٌندٍ، سُبٍ رَدَشَشِ نُن سُبٍ رَهَرَ مُشِ.»<verse eid="LEV 11:47"/></para>
  <chapter eid="LEV 11"/>
  <chapter number="12" style="c" sid="LEV 12"/>
  <para style="s">دِنفّ شَ سّرّشّ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 12:1"/>عَلَتَلَ نَشَ عَ مَسٍن عَننَبِ مُنسَ بّ، <verse eid="LEV 12:1"/><verse number="2" style="v" sid="LEV 12:2"/>«عَ قَلَ عِسِرَيِلَكَيٍ بّ، شَ فِنّ ندٍ سَ تّيفّ، عَ دِ شّمّ بَرِ، عَ قِندِ مَ سّنِيّنتَرٍ رَ شِ سٌلٌقٍرٍ بُن مَ، عَلْ عَ كِكٍ وَلِمَ تّمُي نَشّ. <verse eid="LEV 12:2"/><verse number="3" style="v" sid="LEV 12:3"/>شِ سٌلٌمَسَشَن لْشْي، دِ شَ سُننَ. <verse eid="LEV 12:3"/><verse number="4" style="v" sid="LEV 12:4"/>نَ شِ سٌلٌقٍرٍ شَنبِ، دِنفّ لُمَ سّنِيّنتَرٍحَ كُي شِ تٌنفٌ سَشَن نُن سَشَن بُن مَ عَ وُلِ شَ قٍ رَ نَشَن مِنِشِ عَ مَ عَ دِ بَرِ تّمُي. عَ مُ لَنمَ عَ شَ دِن سٍ سّنِيّنشِ رَ، عَ مُ لَنمَ عَ شَ سٌ يِرٍ سّنِيّنشِ كُي هَن مَرَ سّنِيّنيِ وَشَتِ شَ كَمَلِ.»<verse eid="LEV 12:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 12:5"/>«شَ دِنفّ دِ فِنّ بَرِ، عَ لُمَ سّنِيّنتَرٍحَ كُي لْشْشُن قِرِن، عَلْ عَ كِكٍ وَلِمَ تّمُي نَشّ. نَ شَنبِ عَ شَ مَرَ سّنِيّنيِ وَشَتِ بُمَ شِ تٌنفٌ سٍننِ نُن سٍننِ، عَ وُلِ شَ قٍ رَ نَشَن مِنِشِ عَ دِ بَرِ تّمُي. <verse eid="LEV 12:5"/><verse number="6" style="v" sid="LEV 12:6"/>عَ شَ مَرَ سّنِيّنيِ وَشَتِ نَ كَمَلِ، دِ شّمّ، شَ نَ مُ عَ رَ دِ فِنّ شَ قٍ رَ، عَ شَ يّشّي حّ كٍرٍن دَاشِ شَنِن سّرّشّدُبّ شْن مَ هْرْ مْلِنفِرَ سٌدٍ دّ رَ. عَ شَ نَ بَ سّرّشّ فَن دَاشِ رَ. عَ مَن شَ كٌلٌكٌندٍ يْرّ، شَ نَ مُ عَ رَ فَنبّ بَ يُنُبِ شَقَرِ سّرّشّ رَ. <verse eid="LEV 12:6"/><verse number="7" style="v" sid="LEV 12:7"/>سّرّشّدُبّ شَ نَ سّرّشّيٍ بَ عَلَتَلَ بّ، عَ قِندِ نَ فِنّ شَ شُنسَرٍ رَ. نَ تّمُي عَ سّنِيّنمَ نّ نَ وُلِ شَ قٍ رَ. سّرِيّ نَن نَ كِ فِنّ بّ نَشَن دِ شّمّ بَرِ مَ، شَ نَ مُ عَ رَ دِ فِنّ. <verse eid="LEV 12:7"/><verse number="8" style="v" sid="LEV 12:8"/>شَ قّيرّ مُ نَ عَ يِ عَ شَ يّشّي سْتْ، عَ نْمَ فَنبّ قِرِن شَنِندٍ، شَ نَ مُ عَ رَ كٌلٌكٌندٍ قِرِن. كٍرٍن شَ بَ سّرّشّ فَن دَاشِ رَ، بٌورٍ شَ بَ يُنُبِ شَقَرِ سّرّشّ رَ. سّرّشّدُبّ شَ نَ بَ، عَ قِندِ شُنسَرٍ رَ فِنّ بّ، عَ قَ سّنِيّن.»<verse eid="LEV 12:8"/></para>
  <chapter eid="LEV 12"/>
  <chapter number="13" style="c" sid="LEV 13"/>
  <para style="s">قُرٍيٍ مِشِ قَتٍ مَ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 13:1"/>عَلَتَلَ نَشَ عَ مَسٍن عَننَبِ مُنسَ نُن هَرُنَ بّ، <verse eid="LEV 13:1"/><verse number="2" style="v" sid="LEV 13:2"/>«شَ مِشِ قَتٍ كِرِ يِرٍ ندٍ قُنتُ، شَ نَ مُ عَ رَ عَ قِيشّ، شَ نَ مُ عَ رَ عَ قِندِ قِ رَ، وٌ شَ نَ كَنيِ شَنِن سّرّشّدُبّ هَرُنَ يِرٍ، شَ نَ مُ عَ رَ عَ شَ دِ ندٍ يِرٍ. <verse eid="LEV 13:2"/><verse number="3" style="v" sid="LEV 13:3"/>قُرٍ نَشَن نَ عَ قَتٍ، سّرّشّدُبّ شَ نَ مَتٌ. شَ قَتٍ شَبٍ بَرَ قِيشّ نَ قِ يِرٍ، قِ قَن بَرَ تِلِن، عَ سُبٍ لِ، قُرٍ حَاشِ نَ عَ رَ. سّرّشّدُبّ شَ مَسٍنيِ تِ، نَ كَنيِ بَرَ قِندِ سّنِيّنتَرٍ رَ. <verse eid="LEV 13:3"/><verse number="4" style="v" sid="LEV 13:4"/>شَ قُرٍ يَ مُ عِتِلِن عَ نَ كِرِ نَن فبَنسَن قَرِ، قَتٍ شَبٍ مُ قِيشّشِ نَ لٌنفٌرِ، سّرّشّدُبّ شَ قُرٍ مَ يَمَرِ عَ شَ لُ عَ كٍرٍنيِ مَ لْشْشُن كٍرٍن. <verse eid="LEV 13:4"/><verse number="5" style="v" sid="LEV 13:5"/>عَ شِ سٌلٌقٍرٍ ندٍ لْشْي، سّرّشّدُبّ مَن شَ عَ مَتٌ. شَ عَ سَ لِ قُرٍ مُ نَ لَنتَنقٍ، عَ مَن شَ قُرٍ مَ يَمَرِ عَ شَ لُ عَ كٍرٍنيِ مَ لْشْشُن كٍرٍن. <verse eid="LEV 13:5"/><verse number="6" style="v" sid="LEV 13:6"/>عَ شِ سٌلٌقٍرٍ ندٍ لْشْي، سّرّشّدُبّ مَن شَ عَ مَتٌ عَ سَنمَيَ قِرِن ندٍ. شَ قُرٍ حِنفِ بَرَ مَسَرَ، عَ مَن مُ لَنتَنقٍ، سّرّشّدُبّ شَ مَسٍنيِ تِ، نَ كَنيِ بَرَ سّنِيّن. قُرٍ نَ عَ رَ نَشَن مُ حَاشُ. عَ شَ عَ شَ دُفِيٍ شَ، عَ قِندِ مِشِ سّنِيّنشِ رَ. <verse eid="LEV 13:6"/><verse number="7" style="v" sid="LEV 13:7"/>كْنْ شَ سّرّشّدُبّ بَرَ عَ مَتٌ، قُرٍ بَرَ لَنتَن يّ نَ مَسٍنيِ دَنفِ شَنبِ، قُرٍ مَ مَن شَ فبِلٍن سّرّشّدُبّ يِرٍ تّمُي فبّتّ. <verse eid="LEV 13:7"/><verse number="8" style="v" sid="LEV 13:8"/>سّرّشّدُبّ مَن شَ عَ مَتٌ. شَ قُرٍ بَرَ لَنتَن يّ، سّرّشّدُبّ شَ مَسٍنيِ تِ، نَ كَنيِ بَرَ قِندِ سّنِيّنتَرٍ رَ، قُرٍ حَاشِ نَ عَ رَ.»<verse eid="LEV 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 13:9"/>«شَ قُرٍ حَاشِ بَرَ لُ مِشِ ندٍ كِرِ مَ، عٍ شَ عَ شَنِن سّرّشّدُبّ يِرٍ. <verse eid="LEV 13:9"/><verse number="10" style="v" sid="LEV 13:10"/>عَ شَ عَ مَتٌ. شَ نَ مِشِ كِرِ بَرَ قِيشّ يِرٍ ندٍ، عَ قَ قُنتُ، قَتٍ شَبٍ قَن قَ قِيشّ نَ لٌنفٌرِ، عَ بُلَ، سُبٍ مِنِ كّنّ مَ، <verse eid="LEV 13:10"/><verse number="11" style="v" sid="LEV 13:11"/>قُرٍ حَاشِ نَ عَ رَ نَشَن مُ دَندَنمَ. سّرّشّدُبّ شَ مَسٍنيِ تِ، نَ كَنيِ بَرَ قِندِ مِشِ سّنِيّنتَرٍ رَ. هَلِ عَ مُ لُ عَ كٍرٍنيِ مَ وَشَتِ دِ بُن مَ سْنْن، سّرّشّدُبّ مَن شَ عَ مَتٌ. نَ تَن بَرَ فّ قِندِدٍ مِشِ سّنِيّنتَرٍ رَ. <verse eid="LEV 13:11"/><verse number="12" style="v" sid="LEV 13:12"/>شَ سّرّشّدُبّ بَرَ عَ تٌ عَ نَ قِ حَاشِ بِرِن بَرَ بَرِ قْلْ، نَشَن نُ نَ قُرٍ مَ قَتٍ مَ، كٍلِقٍ عَ سَنيِيٍ مَ هَن عَ شُنيِ، <verse eid="LEV 13:12"/><verse number="13" style="v" sid="LEV 13:13"/>عَ شَ مَسٍنيِ تِ، نَ كَنيِ بَرَ سّنِيّن، بَرِ مَ قِ بِرِن بَرَ بَرِ قْلْ. عَ بَرَ سّنِيّن. <verse eid="LEV 13:13"/><verse number="14" style="v" sid="LEV 13:14"/>كْنْ شَ، قُرٍ سَ بُلَ، سُبٍ مِنِ كّنّ مَ، نَ كَنيِ بَرَ قِندِ مِشِ سّنِيّنتَرٍ رَ. <verse eid="LEV 13:14"/><verse number="15" style="v" sid="LEV 13:15"/>سّرّشّدُبّ نَ قُرٍ بُلَشِ تٌ، عَ شَ مَسٍنيِ تِ، قِ بُلَشِ مُ سّنِيّن، قُرٍ حَاشِ نَ عَ رَ. <verse eid="LEV 13:15"/><verse number="16" style="v" sid="LEV 13:16"/>شَ سُبٍ بُلَشِ قَ بَرِ، قُرٍ مَ شَ سِفَ سّرّشّدُبّ يِرٍ. <verse eid="LEV 13:16"/><verse number="17" style="v" sid="LEV 13:17"/>عَ شَ عَ مَتٌ. شَ قُرٍ بَرَ بَرِ، سّرّشّدُبّ شَ مَسٍنيِ تِ، قُرٍ مَ بَرَ سّنِيّن. <verse eid="LEV 13:17"/><verse number="18" style="v" sid="LEV 13:18"/>شَ سُورِ مِنِ مِشِ مَ، عَ قَ يَلَن، <verse eid="LEV 13:18"/><verse number="19" style="v" sid="LEV 13:19"/>كْنْ نَ كِرِ قَ قِيشّ، شَ نَ مُ عَ رَ عَ فبٍيلِ، نَ كَنيِ شَ سِفَ سّرّشّدُبّ يِرٍ. <verse eid="LEV 13:19"/><verse number="20" style="v" sid="LEV 13:20"/>عَ شَ عَ مَتٌ. شَ قُرٍ يَ بَرَ عِتِلِن، عَ سُبٍ لِ، قَتٍ شَبٍ بَرَ قِيشّ نَ لٌنفٌرِ، سّرّشّدُبّ شَ مَسٍنيِ تِ، نَ كَنيِ بَرَ قِندِ مِشِ سّنِيّنتَرٍ رَ. قُرٍ حَاشِ نَ عَ رَ، نَشَن مِنِشِ سُورِ قْشِ. <verse eid="LEV 13:20"/><verse number="21" style="v" sid="LEV 13:21"/>شَ سّرّشّدُبّ مُ قَتٍ شَبٍ قِيشّ تٌ، قِ قَن مُ تِلِن، عَ مُ سُبٍ لِشِ، عَ مُ قِيشّ عَ فبٍ رَ، قُرٍ مَ شَ لُ عَ كٍرٍنيِ مَ لْشْشُن كٍرٍن. <verse eid="LEV 13:21"/><verse number="22" style="v" sid="LEV 13:22"/>شَ قُرٍ بَرَ لَنتَن يّ عَ قَتٍ مَ، سّرّشّدُبّ شَ مَسٍنيِ تِ، نَ كَنيِ بَرَ قِندِ مِشِ سّنِيّنتَرٍ رَ، قُرٍ حَاشِ نَ عَ رَ. <verse eid="LEV 13:22"/><verse number="23" style="v" sid="LEV 13:23"/>كْنْ شَ قُرٍ مُ مَسَرَشِ عَ مُ لَنتَنشِ عَ عِ، سُورِ بَرِشِ نَ عَ رَ. سّرّشّدُبّ شَ مَسٍنيِ تِ، نَ كَنيِ مِشِ سّنِيّنشِ نَ عَ رَ.»<verse eid="LEV 13:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 13:24"/>«شَ مِشِ قَتٍ بَرَ فَن تّ رَ تّمُي دَنفِشِ، عَ كِرِ قَ بَرِ، كْنْ قُرٍ فبٍيلِ، شَ نَ مُ عَ رَ قُرٍ قِيشّ قَ مِنِ نَ قْشِ، <verse eid="LEV 13:24"/><verse number="25" style="v" sid="LEV 13:25"/>سّرّشّدُبّ شَ نَ مَتٌ. شَ قُرٍ مَ قَتٍ شَبٍ بَرَ قِيشّ نَ قْشِ، قُرٍ بَرَ تِلِن، عَ سُبٍ لِ، قُرٍ حَاشِ نَ عَ رَ، نَشَن بَرَ مِنِ قَتٍ مَ كِرِ دّننَشّ نُ فَنشِ. نَ سّرّشّدُبّ شَ مَسٍنيِ تِ، نَ كَنيِ بَرَ قِندِ مِشِ سّنِيّنتَرٍ رَ، بَرِ مَ قُرٍ حَاشِ نَ عَ رَ. <verse eid="LEV 13:25"/><verse number="26" style="v" sid="LEV 13:26"/>كْنْ شَ سّرّشّدُبّ مُ قَتٍ شَبٍ قِيشّ تٌ قُرٍ مَ، قِ قَن يَ مُ عِتِلِن، عَ مُ سُبٍ لِشِ، عَ مُ قِيشّ عَ فبٍ رَ، سّرّشّدُبّ شَ نَ كَنيِ يَمَرِ عَ شَ لُ عَ كٍرٍنيِ مَ لْشْشُن كٍرٍن. <verse eid="LEV 13:26"/><verse number="27" style="v" sid="LEV 13:27"/>سّرّشّدُبّ شَ عَ مَتٌ شِ سٌلٌقٍرٍ ندٍ لْشْي. شَ قُرٍ بَرَ لَنتَن يّ عَ قَتٍ مَ، سّرّشّدُبّ شَ مَسٍنيِ تِ، نَ كَنيِ بَرَ قِندِ مِشِ سّنِيّنتَرٍ رَ، قُرٍ حَاشِ نَ عَ رَ. <verse eid="LEV 13:27"/><verse number="28" style="v" sid="LEV 13:28"/>كْنْ شَ قُرٍ مُ مَسَرَشِ، عَ مُ لَنتَنشِ عَ عِ، عَ مُ قِيشّ عَلْ عَ سِنفٍ، عَ قَتَنشِ نَ كِرِ فَنشِ نَن نَ. سّرّشّدُبّ شَ مَسٍنيِ تِ، نَ كَنيِ مِشِ سّنِيّنشِ نَ عَ رَ. نَرِ نَ عَ رَ كِرِ دّننَشّ فَن.»<verse eid="LEV 13:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 13:29"/>«شَ قُرٍ لُ شّمّ، شَ نَ مُ عَ رَ فِنّ شُنيِ مَ، شَ نَ مُ عَ رَ عَ كٍنكٍنيِ مَ، <verse eid="LEV 13:29"/><verse number="30" style="v" sid="LEV 13:30"/>سّرّشّدُبّ شَ نَ قُرٍ مَتٌ. شَ قِ يَ بَرَ عِتِلِن، عَ سُبٍ لِ، قَتٍ شَبٍ قِيشّ، عَ شُرُن، سّرّشّدُبّ شَ مَسٍنيِ تِ، نَ كَنيِ بَرَ قِندِ مِشِ سّنِيّنتَرٍ رَ. قُرٍ حَاشِ نَ عَ رَ نَشَن بَرَ لُ عَ شُنيِ مَ، شَ نَ مُ عَ رَ عَ كٍنكٍنيِ مَ. <verse eid="LEV 13:30"/><verse number="31" style="v" sid="LEV 13:31"/>شَ سّرّشّدُبّ سَ عَ تٌ قُرٍ يَ مُ عِتِلِنقٍ، عَ مُ سُبٍ لِقٍ، قَتٍ شَبٍ قْورّ مُ نَ، عَ شَ قُرٍ مَ يَمَرِ عَ شَ لُ عَ كٍرٍنيِ مَ شِ سٌلٌقٍرٍ بُن مَ. <verse eid="LEV 13:31"/><verse number="32" style="v" sid="LEV 13:32"/>سّرّشّدُبّ شَ نَ قُرٍ مَتٌ شِ سٌلٌقٍرٍ ندٍ لْشْي. شَ قُرٍ مُ لَنتَنقٍ عَ عِ، قَتٍ شَبٍ مُ قِيشّ نَ لٌنفٌرِ، قِ يَ مُ عِتِلِنشِ، عَ مُ سُبٍ لِشِ، <verse eid="LEV 13:32"/><verse number="33" style="v" sid="LEV 13:33"/>نَ كَنيِ شَ عَ شُنسّشّ نُن عَ دّشَبٍ بِ عَ شَ عَ بَ قِ رَ. سّرّشّدُبّ مَن شَ قُرٍ مَ يَمَرِ عَ شَ لُ عَ كٍرٍنيِ مَ لْشْشُن كٍرٍن. <verse eid="LEV 13:33"/><verse number="34" style="v" sid="LEV 13:34"/>سّرّشّدُبّ شَ نَ قُرٍ مَن مَتٌ شِ سٌلٌقٍرٍ ندٍ لْشْي. شَ عَ مُ لَنتَنشِ عَ عِ، عَ يَ مُ عِتِلِنشِ، عَ مُ سُبٍ لِشِ، سّرّشّدُبّ شَ مَسٍنيِ تِ، نَ كَنيِ مِشِ سّنِيّنشِ نَ عَ رَ. عَ شَ عَ شَ دُفِيٍ شَ، عَ سّنِيّن. <verse eid="LEV 13:34"/><verse number="35" style="v" sid="LEV 13:35"/>كْنْ سّرّشّدُبّ شَ مَسٍنيِ دَنفِ شَنبِ، شَ قُرٍ بَرَ لَنتَن يّ قُرٍ مَ قَتٍ مَ، <verse eid="LEV 13:35"/><verse number="36" style="v" sid="LEV 13:36"/>سّرّشّدُبّ مَن شَ عَ مَتٌ. شَ قُرٍ بَرَ لَنتَن يّ، هَلِ سّرّشّدُبّ مُ قَتٍ شَبٍ قِيشّ قٍن. نَ كَنيِ بَرَ قِندِ مِشِ سّنِيّنتَرٍ رَ. <verse eid="LEV 13:36"/><verse number="37" style="v" sid="LEV 13:37"/>كْنْ شَ نَ قُرٍ مُ لَنتَنشِ عَ عِ، قَتٍ شَبٍ قْورّ ندٍ تَن بَرَ مِنِ، قُرٍ بَرَ يَلَن. نَ كَنيِ مِشِ سّنِيّنشِ نَ عَ رَ. سّرّشّدُبّ شَ مَسٍنيِ تِ، نَ كَنيِ مِشِ سّنِيّنشِ نَ عَ رَ.»<verse eid="LEV 13:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="LEV 13:38"/>«شَ شّمّ، شَ نَ مُ عَ رَ فِنّ قَتٍ كِرِ بَرَ قِيشّ يِرٍ ندٍيٍ، <verse eid="LEV 13:38"/><verse number="39" style="v" sid="LEV 13:39"/>سّرّشّدُبّ شَ نَ مَتٌ. شَ نَ مُ قِيشّ عَ فبٍ رَ، كَسِ مْولِ ندٍ فبَنسَن نَ عَ رَ. عَ سّنِيّن.»<verse eid="LEV 13:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LEV 13:40"/>«شَ مِشِ ندٍ شُنسّشّ بَرَ مَكْن، تّرّرّ كَنيِ نَ عَ رَ، عَ مُ حَاشُ. نَ كَنيِ سّنِيّن. <verse eid="LEV 13:40"/><verse number="41" style="v" sid="LEV 13:41"/>شَ مِشِ ندٍ شُنسّشّ مَكْنشِ عَ تِفِ دّ بِرِ فبَنسَن نّ، تّرّرّ نَ عَ رَ عَ مُ حَاشُ. نَ كَنيِ سّنِيّن. <verse eid="LEV 13:41"/><verse number="42" style="v" sid="LEV 13:42"/>كْنْ شَ قُرٍ قِيشّ، شَ نَ مُ عَ رَ قُرٍ فبٍيلِ مِنِ عَ شُنيِ مَ، شَ نَ مُ عَ رَ عَ تِفِ مَ، قُرٍ حَاشِ نَ عَ رَ. <verse eid="LEV 13:42"/><verse number="43" style="v" sid="LEV 13:43"/>سّرّشّدُبّ شَ نَ مَتٌ. شَ نَ قُرٍ قُنتُ نَشَن مِنِشِ عَ شُنيِ مَ، عَ قِيشّ، شَ نَ مُ عَ رَ عَ فبٍيلِ عَلْ قُرٍ حَاشِ نَ كِ نَشّ، <verse eid="LEV 13:43"/><verse number="44" style="v" sid="LEV 13:44"/>قُرٍ مَ نَ عَ رَ، عَ مُ سّنِيّنشِ. سّرّشّدُبّ شَ مَسٍنيِ تِ، نَ كَنيِ بَرَ قِندِ مِشِ سّنِيّنتَرٍ رَ. قُرٍ نَ عَ شُنيِ مَ.»<verse eid="LEV 13:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="LEV 13:45"/>«نَ قُرٍ حَاشِ كَنيِ شَ دُفِ عِبْوشِ رَفٌرٌ عَ مَ، عَ شَ عَ شُنيِ بِ، عَ شَ عَ دّ شَبٍ مَكٌتٌ عَ بّلّشّ رَ، عَ نُ عَ قَلَ عَ شُي عِتٍشِ رَ ‹سّنِيّنتَرٍ، سّنِيّنتَرٍ.› <verse eid="LEV 13:45"/><verse number="46" style="v" sid="LEV 13:46"/>دَنمِ نَ قُرٍ حَاشِ نَ عَ مَ، عَ مُ سّنِيّن. قٌ عَ شَ لُ عَ كٍرٍنيِ مَ حَمَ يٌنكِندٍ قَرِ مَ.»<verse eid="LEV 13:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LEV 13:47"/>«نَ قُرٍ حَاشِ نْمَ لُدٍ دُفِ مَ نَشَن يَءِلَنشِ شُرُ سٍ شَبٍ رَ، شَ نَ مُ عَ رَ فّسّ قُتٍ رَ. <verse eid="LEV 13:47"/><verse number="48" style="v" sid="LEV 13:48"/>عَ مَن نْمَ لُدٍ سٍ ندٍ دّنبّشِ مَ نَشَن يَءِلَنشِ شُرُ سٍ شَبٍ رَ، شَ نَ مُ عَ رَ فّسّ قُتٍ رَ. عَ مَن نْمَ لُدٍ سٍ ندٍ مَ نَشَن يَءِلَنشِ شُرُ سٍ كِرِ رَ. <verse eid="LEV 13:48"/><verse number="49" style="v" sid="LEV 13:49"/>شَ نَ قُرٍ بَرَ عِقْورْ، شَ نَ مُ عَ رَ عَ بَرَ فبٍيلِ دُفِ مَ، كِرِ مَ، شَ نَ مُ عَ رَ سٍ دّنبّشِ مَ، قُرٍ حَاشِ نَ عَ رَ. عَ شَ مَسٍن سّرّشّدُبّ بّ، عَ شَ نَ مَتٌ. <verse eid="LEV 13:49"/><verse number="50" style="v" sid="LEV 13:50"/>نَ قُرٍ نَ سٍ نَشَن مَ، نَ سٍ شَ رَفَتَ يِرٍ ندٍ عَ كٍرٍنيِ مَ شِ سٌلٌقٍرٍ بُن مَ. <verse eid="LEV 13:50"/><verse number="51" style="v" sid="LEV 13:51"/>شِ سٌلٌقٍرٍ ندٍ لْشْي سّرّشّدُبّ مَن شَ عَ مَتٌ. شَ نَ قُرٍ بَرَ لَنتَن يّ عِ نَ دُفِ مَ، شَ نَ مُ عَ رَ نَ سٍ دّنبّشِ مَ، شَ نَ مُ عَ رَ نَ كِرِ مَ، قُرٍ حَاشِ نَ عَ رَ. نَ بَرَ قِندِ سٍ سّنِيّنتَرٍ رَ. <verse eid="LEV 13:51"/><verse number="52" style="v" sid="LEV 13:52"/>سّرّشّدُبّ شَ سٍ بِرِن فَن نَ قُرٍ نَ سٍ نَشَن مَ، دُفِ نَشَن يَءِلَنشِ شُرُ سٍ شَبٍ رَ، دُفِ نَشَن يَءِلَنشِ فّسّ قُتٍ رَ، دُفِ دّنبّشِ، شَ نَ مُ عَ رَ كِرِ. <verse eid="LEV 13:52"/><verse number="53" style="v" sid="LEV 13:53"/>كْنْ شَ سّرّشّدُبّ بَرَ عَ مَتٌ، نَ قُرٍ مُ لَنتَنشِ نَ سٍيٍ مَ، <verse eid="LEV 13:53"/><verse number="54" style="v" sid="LEV 13:54"/>عَ شَ يَامَرِ قِ نَ سٍيٍ شَ مَشَ يٍ رَ، عٍ شَ سَ عٍ كٍرٍنيِ مَ شِ سٌلٌقٍرٍ بُن مَ سَنمَيَ قِرِن ندٍ. <verse eid="LEV 13:54"/><verse number="55" style="v" sid="LEV 13:55"/>عَ نَ فّ مَشَدٍ، سّرّشّدُبّ مَن شَ نَ مَتٌ. شَ قُرٍ مُ مَسَرَشِ، هَلِ عَ مَن مُ لَنتَنشِ عَ عِ، نَ قِندِشِ سٍ سّنِيّنتَرٍ نَن نَ. عَ بِرِن شَ فَن تّ رَ، هَلِ قُرٍ نَ عَ لَهَلّ كٍرٍنيِ فبَنسَن نَن مَ. <verse eid="LEV 13:55"/><verse number="56" style="v" sid="LEV 13:56"/>شَ سّرّشّدُبّ بَرَ عَ تٌ قُرٍ مُ قِيشّ عَلْ سِنفٍ، عَ شَ نَ يِرٍ فبَنسَن بَ نَ. <verse eid="LEV 13:56"/><verse number="57" style="v" sid="LEV 13:57"/>كْنْ شَ قُرٍ نَ لَنتَنقٍ عَ عِ دُفِ مَ، شَ نَ مُ عَ رَ دُفِ دّنبّشِ مَ، شَ نَ مُ عَ رَ كِرِ مَ، قُرٍ حَاشِ نَ عَ رَ، قٌ نَ شَ فَن تّ رَ. <verse eid="LEV 13:57"/><verse number="58" style="v" sid="LEV 13:58"/>شَ قُرٍ بَرَ بَ دُفِ مَ، شَ نَ مُ عَ رَ دُفِ دّنبّشِ مَ، شَ نَ مُ عَ رَ كِرِ مَ يٍ رَ عَ قِرِن ندٍ، عَ بَرَ سّنِيّن.»<verse eid="LEV 13:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="LEV 13:59"/>سّرِيّ نَن نَ كِ قُرٍ حَاشِ شَ قٍ رَ نَشَن نْمَ لُدٍ دُفِ ندٍ مَ نَشَن يَءِلَنشِ شُرُ سٍ شَبٍ رَ، شَ نَ مُ عَ رَ فّسّ قُتٍ رَ، عَ نُن دُفِ ندٍ مَ نَشَن دّنبّشِ، عَ نُن كِرِ ندٍ مَ. نَ سّرِيّ نْمَ عَ مَسٍندٍ شَ سٍ ندٍ سّنِيّن، شَ نَ مُ عَ مُ سّنِيّن.<verse eid="LEV 13:59"/></para>
  <chapter eid="LEV 13"/>
  <chapter number="14" style="c" sid="LEV 14"/>
  <para style="s">قُرٍ مَ سّنِيّنتَرٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 14:1"/>عَلَتَلَ نَشَ عَ مَسٍن عَننَبِ مُنسَ بّ، <verse eid="LEV 14:1"/><verse number="2" style="v" sid="LEV 14:2"/>«مَرَ سّنِيّنيِ لْشْي، قُرٍ حَاشِ كَنيِ شَ سِفَ سّرّشّدُبّ شْن. <verse eid="LEV 14:2"/><verse number="3" style="v" sid="LEV 14:3"/>سّرّشّدُبّ شَ سِفَ حَمَ يٌنكِندٍ قَرِ مَ نَ قُرٍ مَ مَتٌدٍ. شَ عَ بَرَ يَلَن، <verse eid="LEV 14:3"/><verse number="4" style="v" sid="LEV 14:4"/>سّرّشّدُبّ شَ يَامَرِ قِ، عَ شَ قَ شْنِ حِحّ رَدَشَشِ قِرِن نَ، عٍ نُن سّدِرِ وُرِ، فّرّ مْولِ ندٍ، نُن هِسٌثِ وُرِ قُرٍ مَ بّ. <verse eid="LEV 14:4"/><verse number="5" style="v" sid="LEV 14:5"/>سّرّشّدُبّ شَ يَامَرِ قِ، عٍ شَ شْنِ كٍرٍن كْن نَشَبَ قّحّ ندٍ شُن مَ، دُلٌن يٍ نَ نَشَن كُي. <verse eid="LEV 14:5"/><verse number="6" style="v" sid="LEV 14:6"/>عَ شَ شْنِ حِحّ تٌنفٌ، عَ نُن سّدِرِ وُرِ، فّرّ مْولِ ندٍ، نُن هِسٌثِ وُرِ، عَ شَ عٍ بِرِن دُكُلُ شْنِ وُلِ شْورَ عٍ نَشَن كْن نَشَبَشِ دُلٌن يٍ شُن مَ. <verse eid="LEV 14:6"/><verse number="7" style="v" sid="LEV 14:7"/>عَ شَ نَ كَسَن سَنمَيَ سٌلٌقٍرٍ نَ قُرٍ مَ مَ، نَشَن لَنمَ عَ شَ سّنِيّن. سّرّشّدُبّ شَ مَسٍنيِ تِ، نَ مِشِ بَرَ قِندِ مِشِ سّنِيّنشِ رَ. نَ تّمُي عَ شَ شْنِ حِحّ بّحِن وُلَ عِ.»<verse eid="LEV 14:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 14:8"/>«نَشَن وَ مَ سّنِيّنقٍ، عَ شَ عَ شَ دُفِيٍ شَ، عَ شَ عَ قَتٍ مَشَبٍ بِ، عَ شَ عَ مَشَ يٍ رَ. نَ كُي، عَ سّنِيّنمَ نّ. نَ دَنفِ شَنبِ عَ نْمَ سٌدٍ حَمَ يٌنكِندٍ كُي، كْنْ عَ مُ نْمَ سٌدٍ عَ شَ كِرِ بَنشِ تَن كُي شِ سٌلٌقٍرٍ. <verse eid="LEV 14:8"/><verse number="9" style="v" sid="LEV 14:9"/>شِ سٌلٌقٍرٍ ندٍ لْشْي، عَ مَن شَ عَ شُنسّشّ بِ، عَ دّ شَبٍ، عَ يَ شِنبِ شَبٍ، عَ نُن عَ قَتٍ مَشَبٍ بِرِن. عَ مَن شَ عَ شَ دُفِيٍ شَ، عَ شَ عَ قَتٍ مَشَ. نَ كُي، عَ سّنِيّنمَ نّ. <verse eid="LEV 14:9"/><verse number="10" style="v" sid="LEV 14:10"/>شِ سٌلٌمَسَشَن ندٍ لْشْي، عَ شَ يّشّييْرّ شّمّمَ قِرِن تٌنفٌ، عَ نُن يّشّي فِنّمَ، حّ كٍرٍن دَاشِ، لَنيُرُ مُ نَ نَشٍيٍ مَ. عَ مَن شَ سَنسِ شْرِ دِنشِ كٌنبٌ يَ كٍرٍن نُن عَ تَفِ سْتْ، تُرٍ مَسُنبُشِ نَشَن نَ، عَ نُن تُرٍ سِفَاتِ يَ كٍرٍن نَشَن قِندِ مَ سّرّشّ رَ. <verse eid="LEV 14:10"/><verse number="11" style="v" sid="LEV 14:11"/>سّرّشّدُبّ شَ قُرٍ مَ نُن عَ شَ سّرّشّ تِ ﭑ تَن عَلَتَلَ يَ عِ هْرْ مْلِنفِرَ سٌدٍ دّ رَ. <verse eid="LEV 14:11"/><verse number="12" style="v" sid="LEV 14:12"/>عَ شَ يّشّييْرّ كٍرٍن تٌنفٌ، عَ شَ عَ بَ يّتّ رَفبِلٍن سّرّشّ رَ، عَ نُن تُرٍ سِفَاتِ يَ كٍرٍن. عَ شَ نٍيٍ لِنتَن ﭑ تَن عَلَتَلَ يَ عِ. <verse eid="LEV 14:12"/><verse number="13" style="v" sid="LEV 14:13"/>عَ شَ نَ يّشّي كْن نَشَبَ يِرٍ سّنِيّنشِ يُنُبِ شَقَرِ سّرّشّ نُن سّرّشّ فَن دَاشِ بَمَ دّننَشّ. سّرّشّدُبّ نَن فبٍ يّتّ رَفبِلٍن سّرّشّ نُن يُنُبِ شَقَرِ سّرّشّ رَ. سّرّشّ سّنِيّنشِ نَن عٍ رَ. <verse eid="LEV 14:13"/><verse number="14" style="v" sid="LEV 14:14"/>سّرّشّدُبّ شَ يّتّ رَفبِلٍن سّرّشّ وُلِ ندٍ تٌنفٌ، عَ شَ عَ سَ قُرٍ مَ يِرٍقَنيِ تُلِ مَ، عَ بّلّشّكُرَ يِرٍقَنيِ مَ، نُن عَ سَنكُرَ يِرٍقَنيِ مَ. <verse eid="LEV 14:14"/><verse number="15" style="v" sid="LEV 14:15"/>عَ مَن شَ نَ تُرٍ سِفَاتِ يَ كٍرٍن عِقِلِ عَ يّتّ كْولَ بّلّشّ كُي. <verse eid="LEV 14:15"/><verse number="16" style="v" sid="LEV 14:16"/>عَ شَ عَ بّلّشّسٌلٍ يِرٍقَنيِ سِن تُرٍ كُي، عَ نُ بَرَ نَشَن سَ عَ كْولَ بّلّشّ كُي، عَ شَ نَ تُرٍ كَسَن دْشْ سٌلٌقٍرٍ ﭑ تَن عَلَتَلَ يَ عِ. <verse eid="LEV 14:16"/><verse number="17" style="v" sid="LEV 14:17"/>تُرٍ نَشَن لُشِ سّرّشّدُبّ بّلّشّ كُي، عَ شَ ندٍ سَ قُرٍ مَ يِرٍقَنيِ تُلِ مَ، عَ نُن عَ بّلّشّكُرَ يِرٍقَنيِ مَ، عَ نُن عَ سَنكُرَ يِرٍقَنيِ مَ يّتّ رَفبِلٍن سّرّشّ وُلِ قَرِ. <verse eid="LEV 14:17"/><verse number="18" style="v" sid="LEV 14:18"/>تُرٍ دْنشْي نَشَن لُشِ سّرّشّدُبّ يِ رَ، عَ شَ نَ سَ قُرٍ مَ شُنيِ مَ. سّرّشّدُبّ شَ عَ شُن سَرَ ﭑ تَن عَلَتَلَ يَ عِ. <verse eid="LEV 14:18"/><verse number="19" style="v" sid="LEV 14:19"/>سّرّشّدُبّ شَ يُنُبِ شَقَرِ سّرّشّ بَ، عَ شَ عَ شُن سَرَ عَ شَ سّنِيّنتَرٍحَ مَ. نَ دَنفِ شَنبِ عَ شَ نَ سّرّشّ فَن دَاشِ كْن نَشَبَ. <verse eid="LEV 14:19"/><verse number="20" style="v" sid="LEV 14:20"/>عَ شَ سّرّشّ فَن دَاشِ نُن سَنسِ شْرِ دِنشِ سّرّشّ بَ سّرّشّبَدٍ قَرِ. عَ شَ قُرٍ مَ شُن سَرَ عَلَكٌ عَ شَ سّنِيّن.»<verse eid="LEV 14:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LEV 14:21"/>«شَ سٍتَرٍ نَن نَ قُرٍ مَ رَ، قّيرّ مُ نَ عَ يِ نَ سّرّشّ شَ قٍ رَ، عَ شَ يّشّييْرّ كٍرٍن فبَنسَن بَ يّتّ رَفبِلٍن سّرّشّ رَ، نَشَن لِنتَنمَ ﭑ تَن عَلَتَلَ يَ عِ عَ شَ قِندِ قُرٍ مَ شَ شُنسَرٍ رَ. عَ شَ سَنسِ شْرِ دِنشِ كٌنبٌ يَ تَفِ سْتْ، تُرٍ مَسُنبُشِ نَشَن نَ، عَ نُن تُرٍ سِفَاتِ يَ كٍرٍن، <verse eid="LEV 14:21"/><verse number="22" style="v" sid="LEV 14:22"/>نُن فَنبّ قِرِن، شَ نَ مُ عَ رَ كٌلٌكٌندٍ يْرّ قِرِن. كٍرٍن شَ قِندِ يُنُبِ شَقَرِ سّرّشّ رَ، بٌورٍ سّرّشّ فَن دَاشِ. <verse eid="LEV 14:22"/><verse number="23" style="v" sid="LEV 14:23"/>شِ سٌلٌمَسَشَن ندٍ لْشْي، عَ شَ قَ نَ سّرّشّيٍ رَ سّرّشّدُبّ شْن هْرْ مْلِنفِرَ سٌدٍ دّ رَ ﭑ تَن عَلَتَلَ يَ عِ، عَلَكٌ عَ شَ سّنِيّن. <verse eid="LEV 14:23"/><verse number="24" style="v" sid="LEV 14:24"/>سّرّشّدُبّ شَ يّتّ رَفبِلٍن سّرّشّ يّشّي نُن تُرٍ سِفَاتِ يَ كٍرٍن لِنتَن ﭑ تَن عَلَتَلَ يَ عِ. <verse eid="LEV 14:24"/><verse number="25" style="v" sid="LEV 14:25"/>عَ شَ نَ يّشّييْرّ كْن نَشَبَ يّتّ رَفبِلٍن سّرّشّ رَ. عَ شَ عَ وُلِ ندٍ تٌنفٌ، عَ شَ نَ سَ قُرٍ مَ يِرٍقَنيِ تُلِ مَ، عَ يِرٍقَنيِ بّلّشّكُرَ مَ، عَ نُن عَ يِرٍقَنيِ سَنكُرَ مَ. <verse eid="LEV 14:25"/><verse number="26" style="v" sid="LEV 14:26"/>عَ شَ تُرٍ ندٍ عِقِلِ عَ يّتّ كْولَ بّلّشّ كُي. <verse eid="LEV 14:26"/><verse number="27" style="v" sid="LEV 14:27"/>عَ شَ نَ تُرٍ كَسَن سَنمَيَ سٌلٌقٍرٍ عَ بّلّشّسٌلٍ يِرٍقَنيِ رَ ﭑ تَن عَلَتَلَ يَ عِ. <verse eid="LEV 14:27"/><verse number="28" style="v" sid="LEV 14:28"/>تُرٍ نَشَن نَ عَ بّلّشّ كُي، عَ شَ دٌندٌرٌنتِ تٌنفٌ، عَ نَ سَ قُرٍ مَ يِرٍقَنيِ تُلِ مَ، عَ يِرٍقَنيِ بّلّشّكُرَ مَ، عَ نُن عَ يِرٍقَنيِ سَنكُرَ مَ وُلِ قَرِ نَشَن كٍلِ يّتّ رَفبِلٍن سّرّشّ مَ. <verse eid="LEV 14:28"/><verse number="29" style="v" sid="LEV 14:29"/>تُرٍ نَشَن لُشِ عَ بّلّشّ كُي، عَ شَ نَ سَ نَ قُرٍ مَ شُنيِ مَ، عَلَكٌ عَ شُن شَ سَرَ ﭑ تَن عَلَتَلَ يَ عِ. <verse eid="LEV 14:29"/><verse number="30" style="v" sid="LEV 14:30"/>سّرّشّدُبّ شَ فَنبّ كٍرٍن بَ، شَ نَ مُ عَ رَ كٌلٌكٌندٍ يْرّ، سّرّشّيٍ يَ مَ قُرٍ مَ نَشٍيٍ سْتْشِ. <verse eid="LEV 14:30"/><verse number="31" style="v" sid="LEV 14:31"/>عَ شَ كٍرٍن بَ يُنُبِ شَقَرِ سّرّشّ رَ، بٌورٍ شَ قِندِ سّرّشّ فَن دَاشِ رَ، عَ نُن سَنسِ شْرِ دِنشِ. سّرّشّدُبّ قُرٍ مَ شُن سَرَ مَ ﭑ تَن عَلَتَلَ يَ عِ نَ كِ نّ. <verse eid="LEV 14:31"/><verse number="32" style="v" sid="LEV 14:32"/>سّرِيّ نَن نَ كِ مَرَ سّنِيّنيِ شَ قٍ رَ قُرٍ مَيٍ بّ نَشٍيٍ قِندِشِ سٍتَرٍيٍ رَ.»<verse eid="LEV 14:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LEV 14:33"/>عَلَتَلَ نَشَ عَ مَسٍن عَننَبِ مُنسَ نُن هَرُنَ بّ، <verse eid="LEV 14:33"/><verse number="34" style="v" sid="LEV 14:34"/>«وٌ نَ سٌ كَنَان بْشِ مَ، ﭑ نَشَن قِمَ وٌ مَ كّ رَ، شَ قُرٍ حَاشِ سَ مِنِ وٌ شَ بَنشِ كَنكٍيٍ مَ مّننِ، <verse eid="LEV 14:34"/><verse number="35" style="v" sid="LEV 14:35"/>بَنشِ كَنيِ شَ سَ عَ قَلَ سّرّشّدُبّ بّ، ‹ﭑ بَرَ قُرٍ حَاشِ تٌ ﭑ مَ بَنشِ مَ.› <verse eid="LEV 14:35"/><verse number="36" style="v" sid="LEV 14:36"/>سّرّشّدُبّ شَ يَامَرِ قِ، عٍ شَ سٍ بِرِن نَمِنِ بَنشِ كُي بٍينُ عَ شَ سِفَ قُرٍ حَاشِ مَتٌدٍ، عَلَكٌ سٍ نَشَن نَ بَنشِ كُي، نَ نَشَ قِندِ سٍ سّنِيّنتَرٍ رَ. عٍ نَ فّ نَ رَبَدٍ، سّرّشّدُبّ شَ سِفَ نَ بَنشِ مَتٌدٍ.»<verse eid="LEV 14:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LEV 14:37"/>«سّرّشّدُبّ شَ نَ قُرٍ مَتٌ. شَ قُرٍ قْورْ، شَ نَ مُ عَ رَ عَ فبٍيلِ، عَ مَن يَ نَشَ عِتِلِن، عَ بَنشِ كَنكٍ سُشُ، <verse eid="LEV 14:37"/><verse number="38" style="v" sid="LEV 14:38"/>سّرّشّدُبّ شَ مِنِ بَنشِ كُي، عَ شَ بَنشِ نَادّ بَلَن لْشُن كٍرٍن. <verse eid="LEV 14:38"/><verse number="39" style="v" sid="LEV 14:39"/>شِ سٌلٌقٍرٍ ندٍ لْشْي، سّرّشّدُبّ مَن شَ فبِلٍن نَا. شَ قُرٍ بَرَ لَنتَن يّ عِ بَنشِ كَنكٍ مَ، <verse eid="LEV 14:39"/><verse number="40" style="v" sid="LEV 14:40"/>سّرّشّدُبّ شَ يَامَرِ قِ، بَنشِ فّمّيٍ شَ بَ نَ قُرٍ نَ دّننَشّ، عٍ شَ عٍ وْلّ تَا قَرِ مَ يِرٍ سّنِيّنتَرٍ. <verse eid="LEV 14:40"/><verse number="41" style="v" sid="LEV 14:41"/>بَنشِ كَنكٍ شَ مَشْولِن بَنشِ كُي. نَشَن بَمَ، نَ شَ وٌلِ تَا قَرِ مَ يِرٍ سّنِيّنتَرٍ. <verse eid="LEV 14:41"/><verse number="42" style="v" sid="LEV 14:42"/>فّمّ فبّتّيٍ شَ سَ بٌورٍيٍ حْشْي رَ، بَنشِ كَنكٍ شَ مَسٌ عَ نّينّ رَ.»<verse eid="LEV 14:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="LEV 14:43"/>«نَ وَلِ بِرِن دَنفِ شَنبِ، شَ قُرٍ حَاشِ مَن مِنِ بَنشِ مَ، <verse eid="LEV 14:43"/><verse number="44" style="v" sid="LEV 14:44"/>سّرّشّدُبّ شَ فبِلٍن نَ مَتٌ رَ. شَ قُرٍ بَرَ لَنتَن يّ بَنشِ كُي، قُرٍ حَاشِ نَ عَ رَ، عَ قِندِشِ سٍ سّنِيّنتَرٍ نَن نَ. <verse eid="LEV 14:44"/><verse number="45" style="v" sid="LEV 14:45"/>نَ بَنشِ شَ رَبِرَ، عَ فّمّيٍ، عَ وُرِيٍ، نُن عَ مَسٌ بّندّ بِرِن شَ وْلّ تَا قَرِ مَ يِرٍ سّنِيّنتَرٍ. <verse eid="LEV 14:45"/><verse number="46" style="v" sid="LEV 14:46"/>نَشَن يٌ سٌمَ نَ بَنشِ كُي عَ بَلَن شَنبِ، نَ كَنيِ قَن قِندِ مَ مِشِ سّنِيّنتَرٍ نَن نَ هَن نُنمَرٍ رَ. <verse eid="LEV 14:46"/><verse number="47" style="v" sid="LEV 14:47"/>نَشَن نَ عَ سَ نَ بَنشِ كُي، شَ نَ مُ عَ رَ عَ عَ دّفٍ نَا، نَ لَنمَ عَ شَ عَ شَ دُفِيٍ شَ.»<verse eid="LEV 14:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="LEV 14:48"/>«نَ بَنشِ يَءِلَن شَنبِ، شَ سّرّشّدُبّ سَ فبِلٍن نَ بَنشِ كُي، عَ قَ عَ تٌ قُرٍ مُ لَنتَنشِ عَ عِ، عَ شَ مَسٍنيِ تِ، نَ بَنشِ بَرَ سّنِيّن، قُرٍ بَرَ حْن نَا. <verse eid="LEV 14:48"/><verse number="49" style="v" sid="LEV 14:49"/>نَ بَنشِ كَنيِ شَ نَ مَرَ سّنِيّنيِ رَكَمَلِ سّرّشّ بَقٍ رَ. عَ شَ شْنِ قِرِن، سّدِرِ وُرِ، فّرّ مْولِ ندٍ، نُن هِسٌثِ وُرِ سْتْ. <verse eid="LEV 14:49"/><verse number="50" style="v" sid="LEV 14:50"/>عَ شَ شْنِ كٍرٍن كْن نَشَبَ قّحّ ندٍ شُن مَ دُلٌن يٍ نَ نَشَن كُي. <verse eid="LEV 14:50"/><verse number="51" style="v" sid="LEV 14:51"/>عَ شَ سّدِرِ وُرِ، هِسٌثِ وُرِ، فّرّ مْولِ ندٍ، نُن شْنِ حِحّ سِن شْنِ كْن نَشَبَ وُلِ شْورَ، نَشَن نَ دُلٌن يٍ كُي. عَ شَ عَ كَسَن بَنشِ مَ سَنمَيَ سٌلٌقٍرٍ. <verse eid="LEV 14:51"/><verse number="52" style="v" sid="LEV 14:52"/>عَ شَ بَنشِ رَ سّنِيّن شْنِ وُلِ، دُلٌن يٍ، شْنِ حِحّ، سّدِرِ وُرِ، هِسٌثِ وُرِ، نُن فّرّ مْولِ ندٍ رَ. <verse eid="LEV 14:52"/><verse number="53" style="v" sid="LEV 14:53"/>عَ شَ شْنِ حِحّ بّحِن تَا قَرِ مَ وُلَ عِ. نَ كُي، نَ بَنشِ شَ قٍ حَاشِ حْنمَ نّ، عَ سّنِيّن.»<verse eid="LEV 14:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="LEV 14:54"/>«سّرِيّ نَن نَ كِ قُرٍ حَاشِيٍ شَ قٍ رَ نَشٍيٍ مِنِمَ مِشِ قَتٍ مَ، <verse eid="LEV 14:54"/><verse number="55" style="v" sid="LEV 14:55"/>دُفِيٍ مَ، بَنشِيٍ مَ، <verse eid="LEV 14:55"/><verse number="56" style="v" sid="LEV 14:56"/>نَشٍيٍ قُنتُمَ، نَشٍيٍ بُلَمَ، نَشٍيٍ قِيشّمَ، <verse eid="LEV 14:56"/><verse number="57" style="v" sid="LEV 14:57"/>عَلَكٌ عَ شَ كٌلٌن شَ سٍ سّنِيّنشِ نَن عَ رَ، شَ نَ مُ عَ رَ عَ مُ سّنِيّنشِ. سّرِيّ نَن نَ كِ نَ قُرٍ حَاشِ شَ قٍ رَ.»<verse eid="LEV 14:57"/></para>
  <chapter eid="LEV 14"/>
  <chapter number="15" style="c" sid="LEV 15"/>
  <para style="s">كْرْ سِلَ كَنيِ</para>
  <para style="s">نُن فِنّ شَ كِكٍ وَلِ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 15:1"/>عَلَتَلَ نَشَ عَ مَسٍن عَننَبِ مُنسَ نُن هَرُنَ بّ، <verse eid="LEV 15:1"/><verse number="2" style="v" sid="LEV 15:2"/>«وٌ شَ عَ قَلَ عِسِرَيِلَكَيٍ بّ، كْرْ سِلَ كَنيِ بَرَ قِندِ مِشِ سّنِيّنتَرٍ رَ. <verse eid="LEV 15:2"/><verse number="3" style="v" sid="LEV 15:3"/>كْرْ سِلَ كَنيِ بَرَ قِندِ مِشِ سّنِيّنتَرٍ رَ هَلِ كْرْ سِلَ مُ نَ مِنِقٍ سِندٍن، كْنْ عَ نَ عَ قَتٍ كُي. <verse eid="LEV 15:3"/><verse number="4" style="v" sid="LEV 15:4"/>كْرْ سِلَ كَنيِ سَمَ سَدٍ نَشَن مَ، سٍ سّنِيّنتَرٍ نَ عَ رَ. عَ دْشْ فٌنيِ نَشَن يٌ مَ، نَ قَن سٍ سّنِيّنتَرٍ نَ عَ رَ. <verse eid="LEV 15:4"/><verse number="5" style="v" sid="LEV 15:5"/>نَشَن نَ دِن عَ شَ سَدٍ رَ، نَ كَنيِ شَ عَ شَ دُفِيٍ شَ، عَ شَ عَ يّتّ مَشَ يٍ رَ. عَ قِندِ مَ مِشِ سّنِيّنتَرٍ نَن نَ هَن نُنمَرٍ رَ. <verse eid="LEV 15:5"/><verse number="6" style="v" sid="LEV 15:6"/>نَشَن دْشْمَ عَ شَ فٌنيِ مَ، نَ كَنيِ شَ عَ شَ دُفِيٍ شَ، عَ شَ عَ يّتّ مَشَ يٍ رَ. عَ قِندِ مَ مِشِ سّنِيّنتَرٍ نَن نَ هَن نُنمَرٍ رَ. <verse eid="LEV 15:6"/><verse number="7" style="v" sid="LEV 15:7"/>نَشَن يٌ دِن نَ قُرٍ مَ قَتٍ رَ، نَ كَنيِ شَ عَ شَ دُفِيٍ شَ، عَ شَ عَ يّتّ مَشَ يٍ رَ. عَ قِندِ مَ مِشِ سّنِيّنتَرٍ نَن نَ هَن نُنمَرٍ رَ. <verse eid="LEV 15:7"/><verse number="8" style="v" sid="LEV 15:8"/>شَ قُرٍ مَ دّ يٍ بْشُن مِشِ سّنِيّنشِ ندٍ مَ، نَ كَنيِ شَ عَ شَ دُفِيٍ شَ، عَ شَ عَ يّتّ مَشَ. عَ قِندِ مَ مِشِ سّنِيّنتَرٍ نَن نَ هَن نُنمَرٍ رَ. <verse eid="LEV 15:8"/><verse number="9" style="v" sid="LEV 15:9"/>دْشْسٍ نَشَن سَمَ سٌي مَ، شَ نَ مُ عَ رَ حْشْمّ مَ، شَ قُرٍ مَ دْشْ نَ قَرِ، نَ دْشْسٍ قِندِ مَ سٍ سّنِيّنتَرٍ نَن نَ. <verse eid="LEV 15:9"/><verse number="10" style="v" sid="LEV 15:10"/>نَشَن نَ دِن سٍسٍ رَ قُرٍ مَ بَرَ دْشْ نَشَن قَرِ، نَ كَنيِ بَرَ قِندِ مِشِ سّنِيّنتَرٍ رَ هَن نُنمَرٍ رَ. نَ كَنيِ شَ عَ شَ دُفِيٍ شَ، عَ شَ عَ يّتّ مَشَ. <verse eid="LEV 15:10"/><verse number="11" style="v" sid="LEV 15:11"/>قُرٍ مَ بّلّشّ سّنِيّنتَرٍ كَنيِ دِنمَ مِشِ نَشَن نَ، نَ شَ عَ شَ دُفِيٍ شَ، عَ شَ عَ يّتّ مَشَ يٍ رَ. عَ قِندِ مَ مِشِ سّنِيّنتَرٍ نَن نَ هَن نُنمَرٍ رَ. <verse eid="LEV 15:11"/><verse number="12" style="v" sid="LEV 15:12"/>قُرٍ مَ دِنمَ قّحّ نَشَن نَ، نَ شَ كَنَ. شَ يِرَبَسٍ وُرِ دَاشِ نَ عَ رَ، عَ لَن عَ شَ مَشَ يٍ رَ.»<verse eid="LEV 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 15:13"/>«كْرْ سِلَ كَنيِ نَ يَلَن، عَ مَمّ تِمَ نّ لْشُن كٍرٍن بٍينُ عَ شَ قِندِ مِشِ سّنِيّنشِ رَ. عَ شَ عَ شَ دُفِيٍ شَ، عَ شَ عَ مَشَ دُلٌنيِ يٍ رَ. عَ سّنِيّنمَ نَ كِ نّ. <verse eid="LEV 15:13"/><verse number="14" style="v" sid="LEV 15:14"/>شِ سٌلٌمَسَشَن ندٍ لْشْي، عَ شَ فَنبّ قِرِن تٌنفٌ، شَ نَ مُ عَ رَ كٌلٌكٌندٍ يْرّ قِرِن، عَ سَ عٍ سٌ سّرّشّدُبّ يِ رَ ﭑ تَن عَلَتَلَ يَ عِ هْرْ مْلِنفِرَ سٌدٍ دّ رَ. <verse eid="LEV 15:14"/><verse number="15" style="v" sid="LEV 15:15"/>سّرّشّدُبّ شَ شْنِ كٍرٍن بَ يُنُبِ شَقَرِ سّرّشّ رَ، بٌورٍ سّرّشّ فَن دَاشِ. نَ كُي، كْرْ سِلَ كَنيِ بَرَ عَ شُن سَرَ ﭑ تَن عَلَتَلَ يَ عِ.»<verse eid="LEV 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 15:16"/>«شَ شّمّ ندٍ عَ شَ وَنتَنيِ نْشْ، عَ شَ عَ قَتٍ بِرِن مَشَ. عَ قِندِ مَ مِشِ سّنِيّنتَرٍ نَن نَ هَن نُنمَرٍ رَ. <verse eid="LEV 15:16"/><verse number="17" style="v" sid="LEV 15:17"/>دُفِ نُن كِرِ نَشَن بِرِن نْشْ، عٍ شَ مَشَ يٍ رَ، عٍ قَن قِندِ مَ نّ سٍ سّنِيّنتَرٍ هَن نُنمَرٍ رَ. <verse eid="LEV 15:17"/><verse number="18" style="v" sid="LEV 15:18"/>شَ شّمّ نُن فِنّ كَقُ عٍ بٌورٍ رَ، عٍ شَ عٍ قَتٍ مَشَ. عٍ قِندِ مَ مِشِ سّنِيّنتَرٍيٍ نَن نَ هَن نُنمَرٍ رَ.»<verse eid="LEV 15:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 15:19"/>«فِنّ نَشَن نَ عَ شَ كِكٍ وَلِ كُي، عَ قِندِ مَ مِشِ سّنِيّنتَرٍ نَن نَ لْشُن كٍرٍن بُن مَ. نَشَن نَ دِن عَ رَ، عَ قَن قِندِ مَ مِشِ سّنِيّنتَرٍ رَ هَن نُنمَرٍ رَ. <verse eid="LEV 15:19"/><verse number="20" style="v" sid="LEV 15:20"/>فِنّ نَشَن نَ عَ شَ كِكٍ وَلِ كُي، عَ سَمَ سَدٍ نَشَن مَ، سٍ سّنِيّنتَرٍ نَ عَ رَ. عَ دْشْ سٍسٍ نَشَن مَ، نَ قَن سٍ سّنِيّنتَرٍ نَ عَ رَ. <verse eid="LEV 15:20"/><verse number="21" style="v" sid="LEV 15:21"/>نَشَن يٌ نَ دِن عَ شَ سَدٍ رَ، نَ كَنيِ شَ عَ شَ دُفِيٍ شَ، عَ شَ عَ يّتّ مَشَ يٍ رَ. عَ قِندِ مَ مِشِ سّنِيّنتَرٍ نَن نَ هَن نُنمَرٍ رَ. <verse eid="LEV 15:21"/><verse number="22" style="v" sid="LEV 15:22"/>نَشَن يٌ نَ دْشْ عَ شَ فٌنيِ مَ، نَ كَنيِ شَ عَ شَ دُفِيٍ شَ، عَ شَ عَ يّتّ مَشَ يٍ رَ. عَ قِندِ مَ مِشِ سّنِيّنتَرٍ نَن نَ هَن نُنمَرٍ رَ. <verse eid="LEV 15:22"/><verse number="23" style="v" sid="LEV 15:23"/>شَ سٍ ندٍ سَشِ نَ سَدٍ مَ، شَ نَ مُ عَ رَ نَ فٌنيِ مَ عَ نُ دْشْشِ نَشَن مَ، نَشَن دِنمَ نَ سٍ رَ عَ قِندِ مَ مِشِ سّنِيّنتَرٍ نَن نَ هَن نُنمَرٍ رَ. <verse eid="LEV 15:23"/><verse number="24" style="v" sid="LEV 15:24"/>شَ شّمّ ندٍ نُن نَ فِنّ كَقُ، عَ شَ كِكٍ وَلِ وُلِ قَ سَ عَ قَتٍ مَ، عَ قَن قِندِ مَ مِشِ سّنِيّنتَرٍ نَن نَ لْشْشُن كٍرٍن بُن مَ. عَ نَ سَ سَدٍ يٌ مَ، نَ قَن قِندِ مَ سٍ سّنِيّنتَرٍ نَن نَ.»<verse eid="LEV 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="LEV 15:25"/>«شَ وُلِ لُ مِنِ رَ فِنّ مَ، نَشَن مُ قِندِشِ عَ شَ كِكٍ وَلِ وُلِ رَ، شَ نَ مُ عَ رَ عَ شَ كِكٍ وَلِ تّمُي شْن نَشَ كُيَ، عَ قِندِ مَ مِشِ سّنِيّنتَرٍ نَن نَ عَلْ فِنّ نَشَن نَ عَ شَ كِكٍ وَلِ كُي. <verse eid="LEV 15:25"/><verse number="26" style="v" sid="LEV 15:26"/>عَ نَ عَ سَ سَدٍ نَشَن مَ، شَ نَ مُ عَ رَ عَ دْشْ فٌنيِ نَشَن مَ، نَ بِرِن قِندِ مَ نّ سٍ سّنِيّنتَرٍ رَ عَلْ عَ شَ كِكٍ وَلِ تّمُي. <verse eid="LEV 15:26"/><verse number="27" style="v" sid="LEV 15:27"/>نَشَن دِنمَ نَ سٍيٍ رَ، نَ كَنيِ شَ عَ شَ دُفِيٍ شَ، عَ شَ عَ قَتٍ مَشَ يٍ رَ. عَ قِندِ مَ مِشِ سّنِيّنتَرٍ نَن نَ هَن نُنمَرٍ رَ.»<verse eid="LEV 15:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LEV 15:28"/>«وُلِ نَ بَ مِنِقٍ، نَ فِنّ شَ مَمّ تِ لْشْشُن كٍرٍن، عَ قَ سّنِيّن. <verse eid="LEV 15:28"/><verse number="29" style="v" sid="LEV 15:29"/>شِ سٌلٌقٍرٍ ندٍ لْشْي، عَ شَ فَنبّ قِرِن، شَ نَ مُ عَ رَ كٌلٌكٌندٍ يْرّ قِرِن تٌنفٌ، عَ شَ عٍ شَنِن سّرّشّدُبّ شْن هْرْ مْلِنفِرَ سٌدٍ دّ رَ. <verse eid="LEV 15:29"/><verse number="30" style="v" sid="LEV 15:30"/>سّرّشّدُبّ شَ شْنِ كٍرٍن بَ يُنُبِ شَقَرِ سّرّشّ رَ، بٌورٍ سّرّشّ فَن دَاشِ. سّرّشّدُبّ شُنسَرٍ سّرّشّ بَمَ نَ فِنّ بّ ﭑ تَن عَلَتَلَ يَ عِ نَ كِ نّ.»<verse eid="LEV 15:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 15:31"/>«وٌ شَ عِسِرَيِلَكَيٍ مَكُيَ سّنِيّنتَرٍحَ رَ، شَ نَ مُ عَ رَ، عٍ نَ عٍ مَكْرّ ﭑ مَ هْرْ مْلِنفِرَ رَ نَشَن نَ وٌ تَفِ، عٍ قَشَمَ نّ.»<verse eid="LEV 15:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LEV 15:32"/>«سّرِيّ نَن نَ كِ كْرْ سِلَ شَ قٍ رَ، عَ نُن شّمّ نَشَن عَ شَ وَنتَنيِ نْشْمَ، <verse eid="LEV 15:32"/><verse number="33" style="v" sid="LEV 15:33"/>فِنّ نَشَن نَ كِكٍ وَلِ كُي، كْرْ سِلَ نَشَن مِنِمَ شّمّ نُن فِنّ قَتٍ عِ، نُن شّمّ نَشَن نُن فِنّ سّنِيّنتَرٍ كَقُمَ.»<verse eid="LEV 15:33"/></para>
  <chapter eid="LEV 15"/>
  <chapter number="16" style="c" sid="LEV 16"/>
  <para style="s">شُنسَرٍ لْشْي</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 16:1"/>هَرُنَ شَ دِ قِرِنيِ تٌ قَشَ عٍ يّتّ مَسٍنقٍ رَ عَلَتَلَ بّ، عَلَتَلَ نَشَ عَ مَسٍن عَننَبِ مُنسَ بّ، <verse eid="LEV 16:1"/><verse number="2" style="v" sid="LEV 16:2"/>«عَ قَلَ عِ تَارَ هَرُنَ بّ، عَ نَ سٌ هْرْ مْلِنفِرَ كُي، عَ نَشَ لُ دَنفِ رَ دُفِ فبَكُشِ رَ شَ عَ دَنفِ تّمُي مُ عَ لِشِ، عَلَكٌ عَ نَشَ قَشَ. يِرٍ سّنِيّنشِ نَ عَ رَ سَاتّ كَنكِرَ نَ دّننَشّ. شُنسَرَدٍ نَ نَ سَاتّ كَنكِرَ نَن قَرِ، ﭑ مِنِمَ نُشُي كُي دّننَشّ.»<verse eid="LEV 16:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 16:3"/>«هَرُنَ شَ سٌ هْرْ مْلِنفِرَ كُي تُورَ رَ، نَشَن بَمَ يُنُبِ شَقَرِ سّرّشّ رَ، عَ نُن يّشّي كٌنتٌنيِ سّرّشّ فَن دَاشِ رَ. <verse eid="LEV 16:3"/><verse number="4" style="v" sid="LEV 16:4"/>عَ شَ فُبَ سّنِيّنشِ فّسّ قُتٍ دَاشِ رَفٌرٌ عَ مَ، عَ شَ وَنتَنيِ فّسّ قُتٍ دَاشِ سٌ. عَ شَ عَ تَفِ عِشِرِ بّلّتِ فّسّ قُتٍ دَاشِ رَ، عَ شَ شُنمَسٍ دْشْ عَ شُنيِ مَ. عَ نَ فّ عَ مَشَدٍ، عَ شَ نَ دُفِ سّنِيّنشِ بِرِن نَفٌرٌ عَ مَ. <verse eid="LEV 16:4"/><verse number="5" style="v" sid="LEV 16:5"/>عِسِرَيِلَ حَمَ شَ سِكْتّ قِرِن سٌ عَ يِ رَ يُنُبِ شَقَرِ سّرّشّ رَ، عَ نُن يّشّي كٌنتٌنيِ كٍرٍن سّرّشّ فَن دَاشِ رَ. <verse eid="LEV 16:5"/><verse number="6" style="v" sid="LEV 16:6"/>هَرُنَ شَ تُورَ بَ عَ يّتّ شَ يُنُبِ شَقَرِ سّرّشّ رَ عَلَكٌ عَ تَن نُن عَ شَ دٍنبَيَ شُن شَ سَرَ. <verse eid="LEV 16:6"/><verse number="7" style="v" sid="LEV 16:7"/>عَ شَ نَ سِكْتّ قِرِنيِ تِ ﭑ تَن عَلَتَلَ يَ عِ، هْرْ مْلِنفِرَ سٌدٍ دّ رَ. <verse eid="LEV 16:7"/><verse number="8" style="v" sid="LEV 16:8"/>عَ شَ ﭑ تَن عَلَ مَشَندِ عَ شَ تْنشُمَ مَسٍن ﭑ بّ نَ سِكْتّ قِرِنيِ شَ قٍ رَ. كٍرٍن شَ قِندِ ﭑ تَن عَلَتَلَ فبٍ رَ، بٌورٍ شَ لُ سٍنتَنّ بّ وُلَ عِ. <verse eid="LEV 16:8"/><verse number="9" style="v" sid="LEV 16:9"/>سِكْتّ نَشَن سُفَندِشِ ﭑ تَن عَلَتَلَ فبٍ رَ، هَرُنَ شَ عَ بَ يُنُبِ شَقَرِ سّرّشّ رَ. <verse eid="LEV 16:9"/><verse number="10" style="v" sid="LEV 16:10"/>سِكْتّ نَشَن سُفَندِشِ عَ شَ قِندِ سٍنتَنّ فبٍ رَ، نَ مُ قَشَمَ. هَرُنَ شَ عَ تِ ﭑ تَن عَلَتَلَ يَ عِ، عَ شَ قِندِ شُنسَرٍ رَ، عَ شَ عَ بّحِن سِفَقٍ رَ وُلَ عِ سٍنتَنّ بّ. <verse eid="LEV 16:10"/><verse number="11" style="v" sid="LEV 16:11"/>هَرُنَ شَ تُورَ بَ عَ يّتّ شَ يُنُبِ شَقَرِ سّرّشّ رَ، عَ شَ قِندِ عَ تَن نُن عَ شَ دٍنبَيَ شُنسَرٍ رَ. عَ شَ نَ تُورَ كْن نَشَبَ يُنُبِ شَقَرِ سّرّشّ رَ. <verse eid="LEV 16:11"/><verse number="12" style="v" sid="LEV 16:12"/>عَ شَ سُرَيِ فَنسٍ رَقٍ تّ وٌلٍ رَ نَشَن تٌنفٌشِ سّرّشّبَدٍ قَرِ ﭑ تَن عَلَتَلَ يَ عِ. عَ شَ سُرَيِ قُحِ بّلّشّ يَ قِرِن قَن تٌنفٌ. عَ شَ نَ بِرِن شَنِن دُفِ فبَكُشِ شَنبِ رَ يِرٍ سّنِيّنشِ كُي. <verse eid="LEV 16:12"/><verse number="13" style="v" sid="LEV 16:13"/>عَ شَ نَ سُرَيِ فَن ﭑ تَن عَلَتَلَ يَ عِ، عَلَكٌ تُورِ نَشَن تٍمَ نَ شَ سَاتّ كَنكِرَ نْشُن عَ مَ عَلَكٌ عَ نَشَ قَشَ. <verse eid="LEV 16:13"/><verse number="14" style="v" sid="LEV 16:14"/>عَ شَ تُورَ وُلِ ندٍ تٌنفٌ عَ بّلّشّسٌلٍ رَ، عَ شَ عَ كَسَن سَاتّ كَنكِرَ مَكٌتٌ سٍ مَ شُنسَرَدٍ سٌفٍتٍدٍ بِرِ سَنمَيَ سٌلٌقٍرٍ، عَ مَن شَ عَ كَسَن نَ مَكٌتٌ سٍ يَ رَ. <verse eid="LEV 16:14"/><verse number="15" style="v" sid="LEV 16:15"/>عَ شَ سِكْتّ كْن نَشَبَ حَمَ شَ يُنُبِ شَقَرِ سّرّشّ رَ، عَ قَ عَ وُلِ شَنِن دُفِ فبَكُشِ شَنبِ رَ. عَ شَ نَ وُلِ كَسَن سَاتّ كَنكِرَ مَكٌتٌ سٍ مَ نُن سَاتّ كَنكِرَ مَكٌتٌ سٍ يَ رَ، عَلْ عَ رَبَشِ تُورَ وُلِ رَ كِ نَشّ.»<verse eid="LEV 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 16:16"/>«نَ كِ عَ شُنسَرٍ سْتْمَ يِرٍ سّنِيّنشِ بّ عِسِرَيِلَكَيٍ شَ سّنِيّنتَرٍحَ، عٍ شَ قٍ كٌبِيٍ، نُن عٍ شَ يُنُبِيٍ شَ قٍ رَ. عَ شَ عَ رَبَ نَ كِ هْرْ مْلِنفِرَ قَن بّ، نَشَن تِشِ عِسِرَيِلَكَ سّنِيّنتَرٍيٍ تَفِ. <verse eid="LEV 16:16"/><verse number="17" style="v" sid="LEV 16:17"/>مِشِ يٌ نَشَ لُ هْرْ مْلِنفِرَ كُي هَن هَرُنَ مِنِمَ يِرٍ سّنِيّنشِ قِسَمَنتٍ كُي تّمُي نَشّ. عَ شَ عَ تَن نُن عَ شَ دٍنبَيَ شُن سَرَ، عَ نُن عِسِرَيِلَ حَمَ بِرِن. <verse eid="LEV 16:17"/><verse number="18" style="v" sid="LEV 16:18"/>عَ شَ سِفَ سّرّشّبَدٍ يِرٍ نَشَن نَ ﭑ تَن عَلَتَلَ يَ عِ، عَ قَ شُنسَرٍ بَ نَ سّرّشّبَدٍ بّ. عَ شَ تُورَ نُن سِكْتّ وُلِ سَ قٍرِيٍ مَ نَشٍيٍ نُ نَ سّرّشّبَدٍ تُنشُنيِ نَانِيٍ رَ. <verse eid="LEV 16:18"/><verse number="19" style="v" sid="LEV 16:19"/>عَ شَ وُلِ كَسَن عَ بّلّشّسٌلٍ رَ سَنيَ سٌلٌقٍرٍ سّرّشّبَدٍ مَ، عَلَكٌ عَ شَ سّنِيّن عِسِرَيِلَكَيٍ شَ سّنِيّنتَرٍحَ شَ قٍ رَ.»<verse eid="LEV 16:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 16:20"/>«هَرُنَ نَ فّ شُنسَرٍ بَدٍ يِرٍ سّنِيّنشِ، هْرْ مْلِنفِرَ، نُن سّرّشّبَدٍ بّ، عَ شَ سِكْتّ بٌورٍ مَسٌ نَشَن مُ نُ قَشَ. <verse eid="LEV 16:20"/><verse number="21" style="v" sid="LEV 16:21"/>عَ شَ عَ بّلّشّ قِرِنيِيٍ سَ نَ سِكْتّ شُن تَفِ، عَ قَ عِسِرَيِلَكَيٍ شَ سّنِيّنتَرٍحَ، عٍ شَ قٍ كٌبِيٍ، نُن عٍ شَ يُنُبِ بِرِن مَسٍن ﭑ تَن عَلَ بّ. عَ نَ فّ نَ كٌتٍ بِرِن سَدٍ سِكْتّ شُن، عَ شَ نَ سِكْتّ بّحِن وُلَ عِ مِشِ ندٍ سَابُي رَ نَشَن بَرَ تِن نَ وَلِ رَ. <verse eid="LEV 16:21"/><verse number="22" style="v" sid="LEV 16:22"/>نَ سِكْتّ يُنُبِ بِرِن شَنِنمَ عَ شُن مَ وُلَ عِ، عَ بّحِن دّننَشّ.»<verse eid="LEV 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 16:23"/>«نَ دَنفِ شَنبِ، هَرُنَ شَ سٌ هْرْ مْلِنفِرَ كُي، عَ شَ عَ شَ دُفِ فّسّ قُتٍ دَاشِيٍ بَ، عَ نَشٍيٍ رَفٌرٌشِ عَ مَ بٍينُ عَ شَ سٌ يِرٍ سّنِيّنشِ كُي. عَ شَ نٍيٍ لُ نَ. <verse eid="LEV 16:23"/><verse number="24" style="v" sid="LEV 16:24"/>عَ شَ عَ مَشَ يٍ رَ يِرٍ سّنِيّنشِ كُي، عَ دُفِ فبّتّيٍ رَفٌرٌ عَ مَ. عَ نَ فّ، عَ شَ مِنِ، عَ سّرّشّ فَن دَاشِ قِرِن بَ، كٍرٍن عَ يّتّ بّ، بٌورٍ حَمَ بّ. عَ شُنسَرٍ سْتْمَ عَ يّتّ بّ نُن حَمَ بّ نَ كُي. <verse eid="LEV 16:24"/><verse number="25" style="v" sid="LEV 16:25"/>عَ مَن شَ يُنُبِ شَقَرِ سّرّشّ تُرٍ فَن سّرّشّبَدٍ قَرِ.»<verse eid="LEV 16:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 16:26"/>«نَشَن سِكْتّ بّحِن وُلَ عِ سٍنتَنّ بّ، نَ لَن عَ شَ عَ شَ دُفِيٍ شَ، عَ عَ قَتٍ مَشَ، عَ قَ فبِلٍن حَمَ يٌنكِندٍ. <verse eid="LEV 16:26"/><verse number="27" style="v" sid="LEV 16:27"/>تُورَ نُن سِكْتّ نَشٍيٍ بَشِ يُنُبِ شَقَرِ سّرّشّ رَ، نَشٍيٍ وُلِ قِندِ شُنسَرٍ رَ يِرٍ سّنِيّنشِ، نٍيٍ لَن عٍ شَ شَنِن حَمَ يٌنكِندٍ قَرِ مَ، عٍ كِرِ، عٍ سُبٍ، نُن عٍ حَحّ بِرِن شَ فَن تّ رَ. <verse eid="LEV 16:27"/><verse number="28" style="v" sid="LEV 16:28"/>نَشَن نَ وَلِ رَبَمَ، عَ شَ عَ شَ دُفِيٍ شَ، عَ شَ عَ قَتٍ مَشَ يٍ رَ، عَ قَ فبِلٍن حَمَ يٌنكِندٍ.»<verse eid="LEV 16:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 16:29"/>«سّرِيّ نَن نَ كِ وٌ بّ نَشَن مُ كَنَمَ عَبَدَن. كِكٍ سٌلٌقٍرٍ ندٍ، شِ قُ لْشْي، وٌ شَ سُنيِ سُشُ، وٌ نَشَ وَلِ يٌ رَبَ، وٌ تَن، نُن مِشِ نَشٍيٍ سَبَتِشِ نَا كْنْ عٍ مُ قِندِ عِسِرَيِلَكَيٍ رَ. <verse eid="LEV 16:29"/><verse number="30" style="v" sid="LEV 16:30"/>نَ قِندِ مَ شُنسَرٍ لْشْي رَ وٌ بّ، عَلَكٌ وٌ شَ سّنِيّن، وٌ شَ يُنُبِ بِرِن شَ شَقَرِ ﭑ تَن عَلَتَلَ يَ عِ. <verse eid="LEV 16:30"/><verse number="31" style="v" sid="LEV 16:31"/>نَ قِندِ مَ مَلَبُي نُن سَلِ لْشْي رَ وٌ بّ. وٌ شَ سُنيِ سُشُ نَ لْشْي. يِ سّرِيّ مُ كَنَمَ عَبَدَن.»<verse eid="LEV 16:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LEV 16:32"/>«عَلَ نَشَن سُفَندِشِ، عَ نَشَن تِشِ سّرّشّدُبّ كُنتِفِ رَ، نَ نَن وٌ شُن سَرَ مَ. عَ لُمَ عَ بَبَ شَ وَلِ رَبَ رَ. عَ لُمَ سّرّشّدُبّ دُفِ سّنِيّنشِيٍ رَفٌرٌ رَ عَ مَ. <verse eid="LEV 16:32"/><verse number="33" style="v" sid="LEV 16:33"/>عَ لُمَ يِرٍ سّنِيّنشِ، هْرْ مْلِنفِرَ، سّرّشّبَدٍ، سّرّشّدُبّيٍ نُن عِسِرَيِلَ حَمَ بِرِن شُن سَرَ رَ. <verse eid="LEV 16:33"/><verse number="34" style="v" sid="LEV 16:34"/>يِ سّرِيّ مُ كَنَمَ عَبَدَن، عَلَكٌ حّ بِرِن شُنسَرٍ شَ بَ عِسِرَيِلَكَيٍ بّ عٍ شَ يُنُبِ بِرِن مَ قٍ رَ.»</para>
  <para style="p" vid="LEV 16:34">عٍ عَلَتَلَ شَ يَامَرِ بِرِن سُشُ عَلْ عَ مَسٍنشِ عَننَبِ مُنسَ بّ كِ نَشّ.<verse eid="LEV 16:34"/></para>
  <chapter eid="LEV 16"/>
  <chapter number="17" style="c" sid="LEV 17"/>
  <para style="s">سّرّشّ بَمَ دّننَشّ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 17:1"/>عَلَتَلَ نَشَ عَ مَسٍن عَننَبِ مُنسَ بّ، <verse eid="LEV 17:1"/><verse number="2" style="v" sid="LEV 17:2"/>«عَ قَلَ هَرُنَ بّ نُن عَ شَ دِيٍ بّ، عَ نُن عِسِرَيِلَكَ بِرِن بّ، عَلَتَلَ يِ نَن يَمَرِشِ. <verse eid="LEV 17:2"/><verse number="3" style="v" sid="LEV 17:3"/>عِسِرَيِلَكَ نَشَن نِنفٍ، شَ نَ مُ عَ رَ يّشّي، شَ نَ مُ عَ رَ سِ بَمَ سّرّشّ رَ حَمَ يٌنكِندٍ كُي، شَ نَ مُ عَ رَ حَمَ يٌنكِندٍ قَرِ مَ، <verse eid="LEV 17:3"/><verse number="4" style="v" sid="LEV 17:4"/>عَ مُ عَ شَنِنمَ هْرْ مْلِنفِرَ سٌدٍ دّ شَ رَ عَلَكٌ عَ شَ عَ قِ ﭑ تَن عَلَتَلَ مَ هْرْ مْلِنفِرَ يِرٍ، نَ كَنيِ لُمَ نّ عَلْ قَشّتِ. عَ بَرَ قَشّ تِ، عَ لَنمَ نَ كَنيِ شَ كٍرِ حَمَ يَ مَ. <verse eid="LEV 17:4"/><verse number="5" style="v" sid="LEV 17:5"/>يِ يَامَرِ وَ مَ عَ مَسٍنقٍ نّ عَ عِسِرَيِلَكَيٍ مُ لَنمَ عٍ شَ سّرّشّ بَ بُرُنيِ. عٍ شَ قَ شَنُنتٍيَ سّرّشّ رَ سّرّشّدُبّ نَن شْن ﭑ تَن عَلَتَلَ يَ عِ ﭑ مَ هْرْ مْلِنفِرَ سٌدٍ دّ رَ. <verse eid="LEV 17:5"/><verse number="6" style="v" sid="LEV 17:6"/>سّرّشّدُبّ شَ نَ وُلِ كَسَن ﭑ تَن عَلَتَلَ شَ سّرّشّبَدٍ سّيتِيٍ مَ هْرْ مْلِنفِرَ سٌدٍ دّ رَ، عَ مَن شَ نَ تُرٍ فَن تّ عِ، عَ شَ قِندِ شِرِ قَنيِ رَ ﭑ تَن عَلَتَلَ بّ. <verse eid="LEV 17:6"/><verse number="7" style="v" sid="LEV 17:7"/>عِسِرَيِلَكَيٍ نَشَ سِكْتّ سّرّشّ بَ كُيٍ بّ سْنْن دٍ. نَ قِندِ مَ يَنقَنتٍيَ نَن نَ ﭑ تَن عَلَتَلَ مَبِرِ. يِ يَامَرِ مُ كَنَمَ عَبَدَن.»<verse eid="LEV 17:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 17:8"/>«عَ قَلَ عٍ بّ، عِسِرَيِلَكَ، شَ نَ مُ عَ رَ شْحّ نَشَن سَبَتِشِ عٍ تَفِ، شَ عَ سّرّشّ فَن دَاشِ، شَ نَ مُ عَ رَ سّرّشّ فبّتّ بَ، <verse eid="LEV 17:8"/><verse number="9" style="v" sid="LEV 17:9"/>عَ مُ عَ شَنِن هْرْ مْلِنفِرَ سٌدٍ دّ رَ، عَلَكٌ عَ شَ قِ ﭑ تَن عَلَتَلَ مَ، نَ كَنيِ كٍرِ مَ نّ عَ شَ حَمَ تَفِ.»<verse eid="LEV 17:9"/></para>
  <para style="s">وُلِ مِنقٍ تْنيِ</para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 17:10"/>«شَ عِسِرَيِلَكَ ندٍ، شَ نَ مُ عَ رَ شْحّ ندٍ نَشَن سَبَتِشِ عِسِرَيِلَ بْشِ مَ عَ نَشَ وُلِ مِن، ﭑ فبِلٍنمَ نّ نَ كَنيِ قْشْ رَ، ﭑ قَ عَ كٍرِ عَ شَ حَمَ يَ مَ، <verse eid="LEV 17:10"/><verse number="11" style="v" sid="LEV 17:11"/>بَرِ مَ سُبٍ نِي بَرَ لُ عَ وُلِ يَ مَ. ﭑ بَرَ وُلِ قِندِ وٌ شُنسَرٍ رَ، نَشَن بَمَ سّرّشّ رَ سّرّشّبَدٍ قَرِ. وُلِ نَن نَ شُنسَرٍ رَ. <verse eid="LEV 17:11"/><verse number="12" style="v" sid="LEV 17:12"/>نَ نَ عَ رَ، ﭑ بَرَ عِسِرَيِلَكَيٍ يَمَرِ عٍ نَشَ وُلِ مِن. وٌ شَ شْحّ نَشٍيٍ سَبَتِشِ عِسِرَيِلَ بْشِ مَ، عٍ قَن نَشَ وُلِ مِن دٍ. <verse eid="LEV 17:12"/><verse number="13" style="v" sid="LEV 17:13"/>شَ عِسِرَيِلَكَ، شَ نَ مُ عَ رَ شْحّ ندٍ نَشَن نَ وٌ تَفِ، سَ سُبٍ ندٍ، شَ نَ مُ عَ رَ شْنِ ندٍ قَشَ نَشَن دَشَ عَ شَ دٌن، عَ شَ نَ وُلِ عِقِلِ بْشِ مَ، عَ بّندّ سَ عَ قَرِ، <verse eid="LEV 17:13"/><verse number="14" style="v" sid="LEV 17:14"/>بَرِ مَ سُبٍ نِي نَ عَ وُلِ نَن يَ مَ. نَ نَ عَ رَ، ﭑ بَرَ عِسِرَيِلَكَيٍ يَمَرِ وٌ نَشَ سُبٍ وُلِ يٌ مِن، بَرِ مَ سُبٍ نِي نَ عَ وُلِ نَن يَ مَ. نَشَن يٌ نَ رَبَ، عَ قَمَ كٍرِدٍ عِسِرَيِلَ حَمَ يَ مَ.»<verse eid="LEV 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 17:15"/>«شَ عِسِرَيِلَكَ، شَ نَ مُ عَ رَ شْحّ ندٍ نَشَن نَ وٌ تَفِ، نَ سُبٍ دٌن نَشَن قَشَشِ عَ يّتّ مَ، شَ نَ مُ عَ رَ سُبٍ فبّتّ نَشَن قَشَشِ كِ فبّتّ رَ، نَ كَنيِ شَ عَ شَ دُفِيٍ شَ يٍ رَ، عَ مَن شَ عَ يّتّ مَشَ. عَ مُ سّنِيّنمَ هَن نُنمَرٍ رَ. <verse eid="LEV 17:15"/><verse number="16" style="v" sid="LEV 17:16"/>شَ عَ مُ عَ شَ دُفِيٍ شَ، شَ عَ مُ عَ يّتّ مَشَ، نَ سّنِيّنتَرٍحَ لُمَ نّ عَ مَ.»<verse eid="LEV 17:16"/></para>
  <chapter eid="LEV 17"/>
  <chapter number="18" style="c" sid="LEV 18"/>
  <para style="s">كَقُي سّرِيّ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 18:1"/>عَلَتَلَ نَشَ عَ مَسٍن عَننَبِ مُنسَ بّ، <verse eid="LEV 18:1"/><verse number="2" style="v" sid="LEV 18:2"/>«عَ قَلَ عِسِرَيِلَكَيٍ بّ عَلَتَلَ نَن ﭑ نَ، وٌ مَرِفِ عَلَ. <verse eid="LEV 18:2"/><verse number="3" style="v" sid="LEV 18:3"/>وٌ نَشَ مِسِرَكَيٍ شَ نَامُنيِيٍ رَبَ، وٌ نُ نَ دّننَشّ. وٌ مَن نَشَ كَنَانكَيٍ قَن مَ نَامُنيِيٍ رَبَ، ﭑ وٌ شَنِنمَ دّننَشّ. وٌ نَشَ بِرَ عٍ شَ سّرِيّ قْشْ رَ. <verse eid="LEV 18:3"/><verse number="4" style="v" sid="LEV 18:4"/>وٌ شَ ﭑ تَن نَن مَ سّرِيّ نُن ﭑ مَ يَامَرِيٍ رَبَتُ، بَرِ مَ عَلَتَلَ نَن ﭑ نَ، وٌ مَرِفِ عَلَ. <verse eid="LEV 18:4"/><verse number="5" style="v" sid="LEV 18:5"/>وٌ شَ بِرَ ﭑ مَ سّرِيّ نُن ﭑ مَ يَامَرِيٍ نَن قْشْ رَ. مِشِ نَشَن نٍيٍ رَبَتُمَ، عَ سِمَيَ سْتْمَ نٍيٍ نَن سَابُي رَ. عَلَتَلَ نَن ﭑ نَ.»<verse eid="LEV 18:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 18:6"/>«وٌ نَشَ كَقُ وٌ نُن وٌ بَرِ مَ. عَلَتَلَ نَن ﭑ نَ.»<verse eid="LEV 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 18:7"/>«وٌ نَشَ كَقُ وٌ نُن وٌ نفَ، نَشَن قِندِشِ وٌ بَبَ شَ فِنّ رَ. وٌ نفَ نَن وٌ نفَ رَ، وٌ نَشَ كَقُ عَ رَ.»<verse eid="LEV 18:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 18:8"/>«وٌ نَشَ كَقُ وٌ نُن وٌ نَندٍن، نَشَن قِندِشِ وٌ بَبَ شَ فِنّ رَ.»<verse eid="LEV 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 18:9"/>«وٌ نَشَ كَقُ وٌ نُن وٌ مَافِنّ، نَشَن قِندِشِ وٌ بَبَ شَ نَ مُ عَ رَ وٌ نفَ شَ دِ رَ، نَشَن بَرِشِ وٌ شْنيِ شَ نَ مُ عَ رَ يِرٍ فبّتّ.»<verse eid="LEV 18:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 18:10"/>«وٌ نَشَ كَقُ وٌ نُن وٌ شَ دِ شّمّ شَ دِ فِنّ، وٌ نَشَ كَقُ وٌ نُن وٌ شَ دِ فِنّ شَ دِ فِنّ. عٍ قَتَنشِ وٌ يّتّ قَتٍ نَن نَ.»<verse eid="LEV 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 18:11"/>«وٌ نَشَ كَقُ وٌ نُن وٌ بَبَ شَ فِنّ فبّتّ شَ دِ فِنّ، وٌ بَبَ نَشَن بَرِشِ. وٌ مَافِنّ نَ عَ رَ.»<verse eid="LEV 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 18:12"/>«وٌ نَشَ كَقُ وٌ نُن وٌ بَبَ مَافِنّ رَ. وٌ بَبَ بَرِبٌورٍ نَ عَ رَ.»<verse eid="LEV 18:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 18:13"/>«وٌ نَشَ كَقُ وٌ نُن وٌ نفَ شُنيَ، شَ نَ مُ عَ رَ عَ تَارَ. وٌ نفَ بَرِبٌورٍ نَ عَ رَ.»<verse eid="LEV 18:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 18:14"/>«وٌ نَشَ كَقُ وٌ نُن وٌ بَبَ شُنيَ شَ فِنّ، شَ نَ مُ عَ رَ عَ تَارَ شَ فِنّ. وٌ بَبَ شُنيَ شَ نَ مُ عَ رَ عَ تَارَ نَن فبٍ قِندِشِ نَ فِنّيٍ رَ. وٌ نفَ نُن وٌ مَمَ نَن لَنشِ عٍ مَ.»<verse eid="LEV 18:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 18:15"/>«وٌ نَشَ كَقُ وٌ نُن وٌ شَ دِ شَ فِنّ، وٌ شَ دِ نَن شَ فِنّ عَ رَ.»<verse eid="LEV 18:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 18:16"/>«وٌ نَشَ كَقُ وٌ نُن وٌ شُنيَ، شَ نَ مُ عَ رَ وٌ تَارَ شَ فِنّ.»<verse eid="LEV 18:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 18:17"/>«شَ وٌ نُن فِنّ ندٍ بَرَ كَقُ، وٌ نُن عَ شَ دِ فِنّ تَن نَشَ كَقُ دٍ. وٌ نُن عَ شَ دِ شّمّ شَ دِ فِنّ نَشَ كَقُ دٍ، وٌ نُن عَ شَ دِ فِنّ شَ دِ فِنّ نَشَ كَقُ دٍ. بَرِبٌورٍ مَيٍ نَ عٍ رَ، نَ قٍ مْولِ مُ قَن.»<verse eid="LEV 18:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 18:18"/>«وٌ نُن وٌ شَ فِنّ شُنيَ نَشَ كَقُ دٍ، شَ نَ مُ عَ رَ عَ تَارَ، وٌ شَ فِنّ شَ سِمَيَ كُي. نَ قٍ قَمَ نّ تْونّ رَ.»<verse eid="LEV 18:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 18:19"/>«وٌ نُن فِنّ نَشَ كَقُ عَ شَ كِكٍ وَلِ كُي دٍ، بَرِ مَ عَ مُ سّنِيّنشِ نَ تّمُي.»<verse eid="LEV 18:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 18:20"/>«سَدٍ قٍ نَشَ لُ وٌ نُن وٌ مَلَنبٌورٍ شَ فِنّ تَفِ دٍ، نَ قِندِ مَ سّنِيّنتَرٍحَ نَن نَ.»<verse eid="LEV 18:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LEV 18:21"/>«وٌ نَشَ وٌ شَ دِ يٌ بَ سّرّشّ رَ مْلْكْ كُيٍ بّ. وٌ نَشَ وٌ مَرِفِ عَلَ شِلِ بّشُ. عَلَتَلَ نَن ﭑ نَ.»<verse eid="LEV 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 18:22"/>«شّمّ نَشَ كَقُ نُن شّمّ رَ. قٍ حَاشِ نَ عَ رَ. شّمّ لَنمَ عٍ نُن فِنّ نَن شَ كَقُ.»<verse eid="LEV 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 18:23"/>«شّمّ نَشَ كَقُ نُن سُبٍ رَ. فِنّ قَن نَشَ كَقُ نُن سُبٍ رَ. نَ قٍ مْولِ مُ قَن قٍوٌ.»<verse eid="LEV 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 18:24"/>«وٌ نَشَ وٌ مَنْشْ يِ قٍ مْولِيٍ رَ، عَلْ نَ سِيٍ عَ رَبَشِ كِ نَشّ ﭑ نَشٍيٍ كٍرِ وٌ يَ رَ. <verse eid="LEV 18:24"/><verse number="25" style="v" sid="LEV 18:25"/>عٍ شَ قٍ حَاشِيٍ بَرَ بْشِ يَتِ مَنْشْ. ﭑ عٍ رَتْنشِ نَ نَن مَ، عٍ مُ لُمَ يِ بْشِ مَ سْنْن. <verse eid="LEV 18:25"/><verse number="26" style="v" sid="LEV 18:26"/>وٌ تَن عِسِرَيِلَكَيٍ نُن شْحّ نَشٍيٍ نَ وٌ تَفِ، وٌ شَ ﭑ مَ سّرِيّ نُن ﭑ مَ يَامَرِيٍ رَبَتُ. وٌ نَشَ يِ قٍ شْنشِيٍ رَبَ دٍ. <verse eid="LEV 18:26"/><verse number="27" style="v" sid="LEV 18:27"/>بٍكَيٍ نُ بَرَ نَ مْولِ رَبَ بٍينُ وٌ شَ قَ. يِ بْشِ قِندِ يِرٍ سّنِيّنتَرٍ رَ نَ نَن مَ. <verse eid="LEV 18:27"/><verse number="28" style="v" sid="LEV 18:28"/>شَ وٌ قَن بِرَ نَ مْولِ قْشْ رَ، وٌ قَن كٍرِ مَ نّ يِ بْشِ مَ. <verse eid="LEV 18:28"/><verse number="29" style="v" sid="LEV 18:29"/>مِشِ يٌ نَشَن نَ مْولِ رَبَمَ، عَ كٍلِمَ نّ عَ شَ حَمَ يَ مَ. <verse eid="LEV 18:29"/><verse number="30" style="v" sid="LEV 18:30"/>وٌ شَ ﭑ مَ يَامَرِيٍ رَبَتُ، وٌ نَشَ نَ قٍ شْنشِيٍ رَبَ عَلْ مِشِ نَشٍيٍ نُ نَ بٍ بٍينُ وٌ شَ قَ. وٌ نَشَ قِندِ مِشِ سّنِيّنتَرٍيٍ رَ. عَلَتَلَ نَن ﭑ نَ، وٌ مَرِفِ عَلَ.»<verse eid="LEV 18:30"/></para>
  <chapter eid="LEV 18"/>
  <chapter number="19" style="c" sid="LEV 19"/>
  <para style="s">تِنشِنيِ نَشَن نَقَن عَلَ مَ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 19:1"/>عَلَتَلَ نَشَ عَ مَسٍن عَننَبِ مُنسَ بّ، <verse eid="LEV 19:1"/><verse number="2" style="v" sid="LEV 19:2"/>«عَ قَلَ عِسِرَيِلَكَيٍ بّ، وٌ شَ سّنِيّن، بَرِ مَ ﭑ تَن سّنِيّن، وٌ مَرِفِ عَلَتَلَ. <verse eid="LEV 19:2"/><verse number="3" style="v" sid="LEV 19:3"/>بِرِن شَ عٍ نفَ نُن عٍ بَبَ بِنيَ. بِرِن شَ مَلَبُي لْشْي سّرِيّ رَبَتُ. عَلَتَلَ نَن ﭑ نَ، وٌ مَرِفِ عَلَ.»<verse eid="LEV 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 19:4"/>«وٌ نَشَ كُيٍيٍ بَتُ، وٌ نَشَ وُرٍ رَشُنُ كُيٍ يَءِلَنقٍ رَ. عَلَتَلَ نَن ﭑ نَ، وٌ مَرِفِ عَلَ.»<verse eid="LEV 19:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 19:5"/>«وٌ شَ شَنُنتٍيَ سّرّشّ بَ ﭑ تَن عَلَتَلَ بّ عَ رَبَ كِ مَ. <verse eid="LEV 19:5"/><verse number="6" style="v" sid="LEV 19:6"/>سّرّشّ سُبٍ شَ دٌن عَ قَشَ لْشْي، شَ نَ مُ عَ رَ نَ كُيٍ عِبَ. سُبٍ نَ شِ سَشَن تِ، نَ شَ سَ تّ عِ. <verse eid="LEV 19:6"/><verse number="7" style="v" sid="LEV 19:7"/>نَشَن لُمَ هَن شِ سَشَن، عَ رَهَرَ مُشِ، عَ مُ لَن نَ مْولِ شَ دٌن. <verse eid="LEV 19:7"/><verse number="8" style="v" sid="LEV 19:8"/>نَشَن نَ رَبَمَ، عَ نَ سَرٍ سْتْمَ نّ، بَرِ مَ عَ بَرَ ﭑ تَن عَلَتَلَ شَ سٍ سّنِيّنشِ يٍلٍبُ. نَ كَنيِ رَ مِنِمَ نّ عِسِرَيِلَ حَمَ يَ مَ.»<verse eid="LEV 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 19:9"/>«وٌ نَ شّ شَبَ وٌ شْنيِ، وٌ نَشَ عَ تُشُييٍ شَبَ. بَلٌي نَشَن بِرَ مَ بْشِ مَ، وٌ شَ نَ لُ نَا. <verse eid="LEV 19:9"/><verse number="10" style="v" sid="LEV 19:10"/>وٌ نَ وّنِ بٌفِ بَ وٌ شَ سَنسِيٍ كْن نَ، وٌ نَشَ فبِلٍن عَ مَ عَ قِرِن ندٍ. بٌفِ نَشٍيٍ قَن يٌلٌنمَ عٍ يّتّ مَ، وٌ شَ نٍيٍ قَن لُ نَ سٍتَرٍيٍ بّ، عَ نُن مِشِيٍ بّ نَشٍيٍ كٍلِشِ حَمَنّ فبّتّيٍ مَ. عَلَتَلَ نَن ﭑ نَ، وٌ مَرِفِ عَلَ.»<verse eid="LEV 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 19:11"/>«وٌ نَشَ مُحّ تِ. وٌ نَشَ وُلٍ قَلَ. وٌ نَشَ وٌ بٌورٍ يَنقَ. <verse eid="LEV 19:11"/><verse number="12" style="v" sid="LEV 19:12"/>وٌ نَشَ وٌ كَلِ ﭑ شِلِ رَ وُلٍ قَرِ، بَرِ مَ نَ كُي وٌ وٌ مَرِفِ عَلَ شِلِ نَن كَنَمَ. عَلَتَلَ نَن ﭑ نَ.»<verse eid="LEV 19:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 19:13"/>«وٌ نَشَ وٌ نفَشَكٍرٍنيِ تْورْ، وٌ نَشَ عَ مُحَ. وٌ نَشَ وٌ شَ وَلِكّ شَ وَلِ سَرٍ لُ هَن تِنَ.»<verse eid="LEV 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 19:14"/>«وٌ نَشَ تُلِشْرِ كٌنبِ، وٌ نَشَ دْنشُي رَبِرَ. وٌ شَ فَاشُ ﭑ تَن عَلَ يَ رَ. عَلَتَلَ نَن ﭑ نَ.»<verse eid="LEV 19:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 19:15"/>«وٌ نَشَ كِيتِ سَ تِنشِنتَرٍيَ رَ. وٌ نَشَ سٍتَرٍ رَقِسَ عَ بٌورٍ بّ، وٌ نَشَ بَننَ رَقِسَ عَ بٌورٍ بّ. وٌ شَ كِيتِ بِرِن سَ تِنشِنيِ رَ. <verse eid="LEV 19:15"/><verse number="16" style="v" sid="LEV 19:16"/>وٌ نَشَ وٌ بٌورٍ مَقَلَ. وٌ نَشَ وٌ بٌورٍ تْوحّفّ عَلَكٌ عَ شَ قَشَ. عَلَتَلَ نَن ﭑ نَ. <verse eid="LEV 19:16"/><verse number="17" style="v" sid="LEV 19:17"/>وٌ نَشَ وٌ نفَشَكٍرٍنيِ شْن. وٌ شَ وٌ بٌورٍ رَ سِ، عَلَكٌ وٌ نَشَ يُنُبِ سْتْ عَ شَ قٍ رَ. <verse eid="LEV 19:17"/><verse number="18" style="v" sid="LEV 19:18"/>وٌ نَشَ وٌ فبٍحْشْ. وٌ نَشَ فبّسّنشْننّيَ رَفَتَ وٌ سٌندٌنيِ كُي وٌ نفَشَكٍرٍنيِ بّ. وٌ شَ وٌ بٌورٍ شَنُ عَلْ وٌ وٌ يّتّ شَنُمَ كِ نَشّ. عَلَتَلَ نَن ﭑ نَ.»<verse eid="LEV 19:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 19:19"/>«وٌ شَ ﭑ مَ يَامَرِيٍ رَبَتُ. وٌ نَشَ شُرُ سٍ مْولِ قِرِن رَتٍ عٍ بٌورٍ مَ. وٌ نَشَ سَنسِ مْولِ قِرِن سِ شّ كٍرٍن مَ. وٌ نَشَ دُفِ رَفٌرٌ وٌ مَ نَشَن دّفّشِ فّسّ مْولِ قِرِن نَ.»<verse eid="LEV 19:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 19:20"/>«شَ شّمّ ندٍ نُن كٌنيِ فِنّ ندٍ كَقُ شّمّ فبّتّ نَشَن شَ كٌتٍ دْشْشِ، نَشَن شُن مُ سَرَشِ سِندٍن، نَشَن مُ شْرّيَشِ، عٍ شَ حَشَنكَتَ. كْنْ وٌ نَشَ عٍ قَشَ، بَرِ مَ كٌنيِ فِنّ نَن عَ رَ. <verse eid="LEV 19:20"/><verse number="21" style="v" sid="LEV 19:21"/>نَ شّمّ شَ يّشّي كٌنتٌنيِ بَ يّتّ رَفبِلٍن سّرّشّ رَ ﭑ تَن عَلَتَلَ بّ هْرْ مْلِنفِرَ سٌدٍ دّ رَ. <verse eid="LEV 19:21"/><verse number="22" style="v" sid="LEV 19:22"/>سّرّشّدُبّ شَ نَ يّشّي كٌنتٌنيِ قِندِ شُنسَرٍ رَ عَ بّ ﭑ تَن عَلَتَلَ يَ عِ، عَ شَ قِندِ يّتّ رَفبِلٍن سّرّشّ رَ عَلَكٌ عَ شَ يُنُبِ شَ شَقَرِ.»<verse eid="LEV 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 19:23"/>«وٌ نَ سٌ بْشِ كُي ﭑ نَشَن قِمَ وٌ مَ، وٌ نَشَ وٌ شَ سَنسِ سِشِيٍ بٌفِيٍ دٌن سِندٍن هَن حّ سَشَن. عٍ مُ سّنِيّن، عٍ لُشِ عَلْ سُننّتَرٍ. وٌ نَشَ عٍ دٌن. <verse eid="LEV 19:23"/><verse number="24" style="v" sid="LEV 19:24"/>نَشٍيٍ قَن بٌفِمَ حّ نَانِ ندٍ مَ، نَ بِرِن قِمَ ﭑ تَن عَلَتَلَ نَن مَ، عَ شَ قِندِ ﭑ مَ مَتْشْي رَ. <verse eid="LEV 19:24"/><verse number="25" style="v" sid="LEV 19:25"/>نَشٍيٍ بٌفِمَ حّ سُولِ ندٍ مَ، نَ تَن بِرِن قِندِ مَ وٌ بَلٌي نَن نَ. عَلَتَلَ نَن ﭑ نَ، وٌ مَرِفِ عَلَ.»<verse eid="LEV 19:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 19:26"/>«وٌ نَشَ سُبٍ يٌ دٌن وٌ مُ نَشَن كْن نَشَبَشِ، عَ وُلِ شَ مِنِ. وٌ نَشَ سٍمَتٌي وَلِ رَبَ، وٌ نَشَ دُورٍيَ رَبَ. <verse eid="LEV 19:26"/><verse number="27" style="v" sid="LEV 19:27"/>وٌ نَشَ وٌ شُنسّشّ مَشَبَ وٌ شُنيِ سّيتِيٍ مَ عَ رَدِفِلِنشِ رَ، وٌ نَشَ وٌ دّ شَبٍ سّيتِيٍ مَشَبَ، <verse eid="LEV 19:27"/><verse number="28" style="v" sid="LEV 19:28"/>وٌ نَشَ وٌ قَتٍ مَشَبَ حْنيِ تٌ سٌشِ وٌ مَ. وٌ نَشَ ثِرِنتِ تِ وٌ قَتٍ مَ. عَلَتَلَ نَن ﭑ نَ.»<verse eid="LEV 19:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 19:29"/>«وٌ نَشَ وٌ شَ دِ فِنّ مَتِ لَنفٌي رَ، عَلَكٌ وٌ شَ بْشِ نَشَ بِرَ لَنفٌيحَ قْشْ رَ، عَ شَ رَقٍ قٍ حَاشِيٍ رَ. <verse eid="LEV 19:29"/><verse number="30" style="v" sid="LEV 19:30"/>وٌ شَ ﭑ مَ مَلَبُي لْشْييٍ بِنيَ، عَ نُن ﭑ مَ يِرٍ سّنِيّنشِ. عَلَتَلَ نَن ﭑ نَ.»<verse eid="LEV 19:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 19:31"/>«وٌ نَشَ مِشِ قٍن نَشَن مِشِ قَشَشِيٍ رَوْيّنمَ. وٌ نَشَ بِرَ سٍمَتٌييٍ قْشْ رَ، شَ نَ مُ عَ رَ وٌ قِندِ مَ سّنِيّنتَرٍيٍ نَن نَ. عَلَتَلَ نَن ﭑ نَ، وٌ مَرِفِ عَلَ.»<verse eid="LEV 19:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LEV 19:32"/>«وٌ شَ مِشِ مْشِيٍ بِنيَ، نَشٍيٍ شُنسّشّ بَرَ قِيشّ. وٌ شَ فَاشُ وٌ مَرِفِ عَلَ يَ رَ. عَلَتَلَ نَن ﭑ نَ.»<verse eid="LEV 19:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LEV 19:33"/>«وٌ نَشَ مِشِ رَوَلِ عَ حَاشِ رَ، نَشٍيٍ كٍلِشِ حَمَنّ فبّتّ عٍ شَ سَبَتِ وٌ شَ بْشِ كُي. <verse eid="LEV 19:33"/><verse number="34" style="v" sid="LEV 19:34"/>وٌ شَ نَ شْحّ مْولِ رَ سّنّ عَلْ وٌ نفَشَكٍرٍنيِ. وٌ شَ عَ شَنُ عَلْ وٌ وٌ يّتّ شَنُمَ كِ نَشّ. وٌ قَن نُ نَ شْحّيَ نَن كُي مِسِرَ بْشِ مَ. عَلَتَلَ نَن ﭑ نَ، وٌ مَرِفِ عَلَ.»<verse eid="LEV 19:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="LEV 19:35"/>«وٌ نَشَ تِنشِنتَرٍيَ يٌ رَبَ، كِيتِ سَدٍ، سٍ كُيّيَ مَنِيَدٍ، سٍ بِنيّ مَنِيَدٍ، سٍ رَقٍ دَاشِ مَنِيَدٍ. <verse eid="LEV 19:35"/><verse number="36" style="v" sid="LEV 19:36"/>وٌ شَ سِكٍيلِ شَ كَمَلِ. وٌ سٍ مَنِيَسٍ كَمَلِشِيٍ رَوَلِ. عَلَتَلَ نَن ﭑ نَ، وٌ مَرِفِ عَلَ، نَشَن وٌ رَ مِنِشِ مِسِرَ بْشِ مَ. <verse eid="LEV 19:36"/><verse number="37" style="v" sid="LEV 19:37"/>وٌ شَ ﭑ مَ سّرِيّ نُن ﭑ مَ يَامَرِ بِرِن نَبَتُ. عَلَتَلَ نَن ﭑ نَ.»<verse eid="LEV 19:37"/></para>
  <chapter eid="LEV 19"/>
  <chapter number="20" style="c" sid="LEV 20"/>
  <para style="s">قٍ شْنشِيٍ عَلَ مَبِرِ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 20:1"/>عَلَتَلَ نَشَ عَ مَسٍن عَننَبِ مُنسَ بّ، <verse eid="LEV 20:1"/><verse number="2" style="v" sid="LEV 20:2"/>«عَ قَلَ عِسِرَيِلَكَيٍ بّ، شَ عِسِرَيِلَكَ ندٍ، شَ نَ مُ عَ رَ شْحّ ندٍ نَشَن سَبَتِشِ عِسِرَيِلَ بْشِ مَ، عَ شَ دِ ندٍ بَ سّرّشّ رَ مْلْكْ كُيٍ بّ، حَمَ شَ نَ كَنيِ مَفْنْ فّمّيٍ رَ هَن عَ شَ قَشَ. <verse eid="LEV 20:2"/><verse number="3" style="v" sid="LEV 20:3"/>ﭑ تَن قَن فبِلٍنمَ نّ نَ مِشِ قْشْ رَ، ﭑ عَ رَ مِنِ حَمَ يَ مَ، بَرِ مَ عَ بَرَ ﭑ مَ يِرٍ سّنِيّنشِ يٍلٍبُ، عَ بَرَ ﭑ شِلِ سّنِيّنشِ كَنَ نَ سّرّشّ مْولِ رَ مْلْكْ كُيٍ بّ. <verse eid="LEV 20:3"/><verse number="4" style="v" sid="LEV 20:4"/>شَ حَمَ عَ يَ رَشِ نَ قٍ مَ، عٍ تٌندِ مِشِ قَشَدٍ، نَشَن عَ شَ دِ بَشِ سّرّشّ رَ مْلْكْ بّ، <verse eid="LEV 20:4"/><verse number="5" style="v" sid="LEV 20:5"/>ﭑ تَن فبِلٍنمَ نّ نَ مِشِ نُن عَ شَبِلّ قْشْ رَ، ﭑ نٍيٍ كٍرِ عٍ شَ حَمَ يَ مَ، عَ نُن مِشِ بِرِن نَشٍيٍ ﭑ يَنقَمَ مْلْكْ كُيٍ شَ قٍ رَ.»<verse eid="LEV 20:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 20:6"/>«شَ مِشِ ندٍ ﭑ يَنقَ، عَ بِرَ سٍمَتٌي قْشْ رَ، عَ نُن مِشِ نَشَن مِشِ قَشَشِيٍ رَوْيّنمَ، ﭑ فبِلٍنمَ نَ كَنيِ قْشْ رَ، ﭑ عَ كٍرِ عَ شَ حَمَ يَ مَ. <verse eid="LEV 20:6"/><verse number="7" style="v" sid="LEV 20:7"/>وٌ شَ وٌ حّرّ سّنِيّنيِ كُي، عَلَكٌ وٌ شَ سّنِيّن، بَرِ مَ عَلَتَلَ نَن ﭑ نَ، وٌ مَرِفِ عَلَ. <verse eid="LEV 20:7"/><verse number="8" style="v" sid="LEV 20:8"/>وٌ شَ ﭑ مَ يَامَرِيٍ رَبَتُ، وٌ شَ عٍ رَتِنمّ. عَلَتَلَ نَن ﭑ نَ، نَشَن وٌ رَ سّنِيّنمَ.»<verse eid="LEV 20:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 20:9"/>«نَشَن يٌ عَ بَبَ دَنكَ، شَ نَ مُ عَ رَ عَ نفَ، وٌ شَ نَ كَنيِ قَشَ. عَ تَن نَن عَ قَشَ قٍ رَفِرِشِ، بَرِ مَ عَ بَرَ عَ بَبَ دَنكَ، شَ نَ مُ عَ رَ عَ نفَ.»<verse eid="LEV 20:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 20:10"/>«شَ شّمّ ندٍ يّنّ رَبَ عَ مَلَن بٌورٍ شَ فِنّ رَ، نَ شّمّ نُن نَ فِنّ شَ قَشَ عٍ شَ لَنفٌيحَ شَ قٍ رَ.»<verse eid="LEV 20:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 20:11"/>«شَ شّمّ ندٍ كَقُ نُن عَ بَبَ شَ فِنّ رَ، عَ بَرَ قٍ حَاشِ رَبَ عَ بَبَ رَ. وٌ شَ نَ شّمّ نُن نَ فِنّ قَشَ عٍ شَ يُنُبِ شَ قٍ رَ.»<verse eid="LEV 20:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 20:12"/>«شَ شّمّ ندٍ كَقُ نُن عَ شَ دِ شَ فِنّ رَ، وٌ شَ عٍ قِرِنيِ بِرِن قَشَ نَ يُنُبِ شَ قٍ رَ، بَرِ مَ نَ قٍ مْولِ مُ قَن قٍوٌ.»<verse eid="LEV 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 20:13"/>«شَ شّمّ ندٍ كَقُ نُن شّمّ فبّتّ رَ عَلْ شّمّ دَرِشِ عَ رَبَ رَ فِنّ رَ كِ نَشّ، وٌ شَ عٍ قِرِنيِ بِرِن قَشَ نَ قٍ شْنشِ شَ قٍ رَ.»<verse eid="LEV 20:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 20:14"/>«شَ شّمّ ندٍ كَقُ نُن فِنّ رَ نُن نَ شَ دِ فِنّ رَ، عٍ بَرَ قٍ حَاشِ رَبَ. وٌ شَ عٍ فَن تّ رَ، شّمّ نُن فِنّ، عَلَكٌ نَ قٍ شْنشِ مْولِ نَشَ لُ وٌ تَفِ.»<verse eid="LEV 20:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 20:15"/>«شَ شّمّ ندٍ كَقُ نُن سُبٍ رَ، وٌ شَ نَ شّمّ نُن نَ سُبٍ بِرِن قَشَ.»<verse eid="LEV 20:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 20:16"/>«شَ فِنّ ندٍ عَ مَسٌ سُبٍ رَ كَقُ بٌورٍحَ رَ، وٌ شَ نَ فِنّ نُن نَ سُبٍ قَشَ نَ قٍ حَاشِ شَ قٍ رَ.»<verse eid="LEV 20:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 20:17"/>«شَ شّمّ ندٍ كَقُ نُن عَ مَافِنّ رَ، عَ بَبَ شَ دِ فِنّ، شَ نَ مُ عَ رَ عَ نفَ شَ دِ فِنّ، قٍ مَيَافِشِ نَن عَ رَ. وٌ شَ عٍ كٍرِ عٍ شَ حَمَ يَ مَ، بَرِ مَ شّمّ بَرَ كَقُ نُن عَ مَافِنّ رَ. نَ كٌتٍ شَ لُ عَ شُن مَ.»<verse eid="LEV 20:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 20:18"/>«شَ شّمّ ندٍ كَقُ نُن فِنّ رَ نَشَن نَ عَ شَ كِكٍ وَلِ كُي، عَ وُلِ نَشَ مِنِ كّنّ مَ. عٍ قِرِنيِ بِرِن شَ كٍرِ حَمَ يَ مَ نَ قٍ مَ.»<verse eid="LEV 20:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 20:19"/>«وٌ نَشَ كَقُ نُن وٌ نفَ شُنيَ، شَ نَ مُ عَ رَ وٌ نفَ تَارَ رَ، شَ نَ مُ عَ رَ وٌ بَبَ مَافِنّ رَ، بَرِ مَ وٌ بَرِبٌورٍ نَن عٍ رَ. نَشَن نَ مْولِ رَبَمَ نَ كٌتٍ شَ لُ عَ شُن مَ.»<verse eid="LEV 20:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 20:20"/>«شَ شّمّ ندٍ كَقُ نُن عَ بَبَ شُنيَ شَ فِنّ رَ، شَ نَ مُ عَ رَ عَ بَبَ تَارَ شَ فِنّ رَ، عٍ نَ كٌتٍ شَنِنمَ نّ. عٍ بِرِن قَمَ قَشَدٍ دِبَرِتَرٍحَ نَن كُي.»<verse eid="LEV 20:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LEV 20:21"/>«شَ شّمّ ندٍ كَقُ نُن عَ شُنيَ شَ فِنّ رَ، شَ نَ مُ عَ رَ عَ كَقُ نُن عَ تَارَ شَ فِنّ رَ، عَ بَرَ قٍ سّنِيّنتَرٍ رَبَ. عٍ بِرِن قَمَ قَشَدٍ دِبَرِتَرٍحَ نَن كُي.»<verse eid="LEV 20:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 20:22"/>«وٌ شَ ﭑ مَ سّرِيّ نُن ﭑ مَ يَامَرِ بِرِن نَبَتُ، وٌ شَ نَ بِرِن نَبَ، عَلَكٌ وٌ مُ قَمَ كٍرِدٍ كِ نَشّ بْشِ مَ ﭑ وٌ رَ سَبَتِمَ دّننَشّ. <verse eid="LEV 20:22"/><verse number="23" style="v" sid="LEV 20:23"/>وٌ نَشَ بِرَ نَ بْشِ سِيٍ شَ سّرِيّ قْشْ رَ، ﭑ قَمَ نَشٍيٍ كٍرِدٍ وٌ يَ رَ. عٍ نَشَن نَبَمَ نَ مُ رَقَنشِ ﭑ مَ قٍوٌ. <verse eid="LEV 20:23"/><verse number="24" style="v" sid="LEV 20:24"/>ﭑ بَرَ عَ قَلَ وٌ بّ نَ بْشِ قِندِ مَ وٌ فبٍ رَ. ﭑ بَرَ نَ بْشِ قِ وٌ مَ، شِحّ نُن كُمِ فبٍفبٍ نَ دّننَشّ. عَلَتَلَ نَن ﭑ نَ، وٌ مَرِفِ عَلَ، نَشَن وٌ سُفَندِشِ سِيٍ تَفِ. <verse eid="LEV 20:24"/><verse number="25" style="v" sid="LEV 20:25"/>وٌ شَ سُبٍ رَهَرَ مُشِيٍ نُن سُبٍ رَدَشَشِيٍ تَفِ رَ سَ، عٍ نُن شْنِ رَهَرَ مُشِيٍ نُن شْنِ رَدَشَشِيٍ، عَلَكٌ وٌ نَشَ قِندِ سّنِيّنتَرٍيٍ رَ عٍ سَابُي رَ. ﭑ بَرَ تْنيِ دْشْ نَ سُبٍيٍ، نَ شْنِيٍ، نُن نَ بْشِمَسٍيٍ رَ. عٍ مُ سّنِيّن. <verse eid="LEV 20:25"/><verse number="26" style="v" sid="LEV 20:26"/>وٌ شَ قِندِ ﭑ مَ حَمَ سّنِيّنشِ رَ، بَرِ مَ ﭑ تَن عَلَتَلَ نَن سّنِيّن. ﭑ بَرَ وٌ سُفَندِ سِيٍ تَفِ، عَلَكٌ وٌ شَ قِندِ ﭑ فبٍ رَ.»<verse eid="LEV 20:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 20:27"/>«مِشِ يٌ نَشَن مِشِ قَشَشِيٍ رَوْيّنمَ، شَ نَ مُ عَ رَ عَ قِندِ سٍمَتٌي رَ، وٌ شَ عَ مَفْنْ فّمّيٍ رَ هَن عَ شَ قَشَ. عَ تَن نَن عَ قَشَ قٍ رَفِرِشِ.»<verse eid="LEV 20:27"/></para>
  <chapter eid="LEV 20"/>
  <chapter number="21" style="c" sid="LEV 21"/>
  <para style="s">سّرّشّدُبّ شَ سّنِيّنيِ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 21:1"/>عَلَتَلَ نَشَ عَ مَسٍن عَننَبِ مُنسَ بّ، «عَ قَلَ هَرُنَ شَ دِ سّرّشّدُبّيٍ بّ، سّرّشّدُبّ نَشَ عَ يّتّ قِندِ سّنِيّنتَرٍ رَ عَ شَ مِشِ ندٍ قُرٍ سَابُي رَ، <verse eid="LEV 21:1"/><verse number="2" style="v" sid="LEV 21:2"/>قٌ عَ شَ مِشِ كّندّ ندٍ عَلْ عَ نفَ، عَ بَبَ، عَ شَ دِ شّمّ، عَ شَ دِ فِنّ، عَ شُنيَ شّمّمَ، عَ تَارَ شّمّمَ، <verse eid="LEV 21:2"/><verse number="3" style="v" sid="LEV 21:3"/>نُن عَ مَافِنّ، فِنّدِ مّدِ نَ نَشَن نَ، عَ مُ دْشْشِ شّمّ تَا سِندٍن، عَ نَ عَ شْنيِ. سّرّشّدُبّ نَ دِن عٍ قُرٍ رَ، عَ قِندِ مَ نّ مِشِ سّنِيّنتَرٍ رَ. <verse eid="LEV 21:3"/><verse number="4" style="v" sid="LEV 21:4"/>عَ مُ لَنمَ سّرّشّدُبّ شَ قِندِ سّنِيّنتَرٍ رَ عَ شَ فِنّ قُرٍ شَ قٍ رَ، شَ نَ مُ عَ رَ عَ شَ فِنّ شَ مِشِيٍ قُرٍ شَ قٍ رَ.»<verse eid="LEV 21:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 21:5"/>«شَ حْنقٍ بَرَ عَ لِ، عَ مُ لَنمَ سّرّشّدُبّ شَ عَ شُنيِ بِ، شَ نَ مُ عَ رَ عَ دّ شَبٍيٍ سّيتِ مَشَبَ، شَ نَ مُ عَ رَ عَ قَتٍ مَشَبَ. <verse eid="LEV 21:5"/><verse number="6" style="v" sid="LEV 21:6"/>عٍ شَ سّنِيّن عٍ مَرِفِ عَلَ بّ. عٍ نَشَ عٍ مَرِفِ عَلَ شِلِ كَنَ، بَرِ مَ عٍ تَن نَن سّرّشّ فَن دَاشِيٍ بَمَ ﭑ تَن عَلَتَلَ بّ، نَشٍيٍ لُشِ عَلْ ﭑ مَ دٌنسٍ. عٍ لَن عٍ شَ سّنِيّن نَ نَن مَ. <verse eid="LEV 21:6"/><verse number="7" style="v" sid="LEV 21:7"/>عَ مُ لَنمَ سّرّشّدُبّ شَ لَنفٌي فِنّ دْشْ، شَ نَ مُ عَ رَ فِنّ قُتِ كَنّ، شَ نَ مُ عَ رَ فِنّ شّمّ مّيشِ نَشَن نَ. سّرّشّدُبّ تَن سّنِيّن عَ مَرِفِ عَلَ بّ. <verse eid="LEV 21:7"/><verse number="8" style="v" sid="LEV 21:8"/>وٌ شَ عَ كٌلٌن مِشِ سّنِيّنشِ رَ، بَرِ مَ عَ تَن نَن سّرّشّيٍ قِمَ عَلَ مَ نَشٍيٍ لُشِ عَلْ دٌنسٍ. وٌ شَ عَ كٌلٌن عَ سّنِيّن، بَرِ مَ ﭑ تَن عَلَتَلَ سّنِيّن، ﭑ تَن نَشَن وٌ رَ سّنِيّنمَ. <verse eid="LEV 21:8"/><verse number="9" style="v" sid="LEV 21:9"/>شَ سّرّشّدُبّ شَ دِ فِنّ ندٍ عَ يّتّ رَيَافِمَ قِندِقٍ رَ لَنفٌي رَ، عَ بَرَ عَ بَبَ رَيَافِ. عَ لَنمَ نَ فِنّ شَ فَن تّ رَ.»<verse eid="LEV 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 21:10"/>«سّرّشّدُبّ كُنتِفِ نَشَن سُفَندِشِ عَ نفَشَكٍرٍنيِيٍ تَفِ، عٍ تُرٍ سّنِيّنشِ سَ عَ مَ، عٍ دُفِ سّنِيّنشِ رَفٌرٌ عَ مَ، نَ نَشَ عَ شُنسّشّ كَنَ، عَ نَشَ عَ شَ دُفِ عِبْو. <verse eid="LEV 21:10"/><verse number="11" style="v" sid="LEV 21:11"/>عَ نَشَ سٌ قُرٍ شُن مَ، عَ نَشَ قِندِ سّنِيّنتَرٍ رَ قُرٍ شَ قٍ رَ، هَلِ عَ بَبَ شَ نَ مُ عَ رَ عَ نفَ. <verse eid="LEV 21:11"/><verse number="12" style="v" sid="LEV 21:12"/>عَ نَشَ مِنِ يِرٍ سّنِيّنشِ كُي، عَ نَشَ عَ مَرِفِ عَلَ شَ هْرْ مْلِنفِرَ مَنْشْ، بَرِ مَ ﭑ تَن عَلَ نَن عَ سُفَندِشِ، تُرٍ سّنِيّنشِ سَشِ عَ شُنيِ مَ. عَلَتَلَ نَن ﭑ نَ. <verse eid="LEV 21:12"/><verse number="13" style="v" sid="LEV 21:13"/>عَ شَ فِنّدِ مّدِ دْشْ فِنّ رَ. <verse eid="LEV 21:13"/><verse number="14" style="v" sid="LEV 21:14"/>عَ نَشَ كَاحّ فِنّ دْشْ، عَ نَشَ فِنّ رَبّحِنشِ دْشْ، عَ نَشَ لَنفٌي دْشْ، عَ نَشَ فِنّ دْشْ فِنّدِ مّدِ مُ نَشَن نَ. عَ شَ فِنّدِ مّدِ تٌنفٌ فِنّ رَ عَ شَ مِشِيٍ يَ مَ، <verse eid="LEV 21:14"/><verse number="15" style="v" sid="LEV 21:15"/>عَلَكٌ عَ نَشَ عَ بْنسْي رَيَافِ. عَلَتَلَ نَن ﭑ نَ نَشَن عَ رَ سّنِيّنمَ.»<verse eid="LEV 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 21:16"/>عَلَتَلَ نَشَ عَ مَسٍن عَننَبِ مُنسَ بّ، <verse eid="LEV 21:16"/><verse number="17" style="v" sid="LEV 21:17"/>«عَ قَلَ هَرُنَ بّ، مِشِ مَبّنشِ يٌ نَشَ سّرّشّدُبّ وَلِ رَبَ، عَ سّرّشّ سَ سّرّشّبَدٍ مَ ﭑ تَن عَلَ بّ. نَ مُ لَنمَ عَبَدَن. <verse eid="LEV 21:17"/><verse number="18" style="v" sid="LEV 21:18"/>مَبّنيِيٍ نَن يَ نَشٍيٍ مُ دَشَ عٍ شَ عٍ مَسٌ سّرّشّبَدٍ رَ؛ نَشَن يَ مُ قَن، نَشَن مُ نْمَ حّرّدٍ عَ قَنيِ رَ، نَشَن سَلٌنسٍ ندٍ كَنَشِ، <verse eid="LEV 21:18"/><verse number="19" style="v" sid="LEV 21:19"/>نَشَن بّلّشّ، شَ نَ مُ عَ رَ سَنيِ فِرَشِ، <verse eid="LEV 21:19"/><verse number="20" style="v" sid="LEV 21:20"/>نَشَن كُنتِنشِ، نَشَن شَ كُيّ مُ كَمَلِشِ، نَشَن يَ مُ قَنشِ، قَتٍ كِرِ قُرٍ نَ نَشَن مَ، نُن شّمّ بَنَشِ. <verse eid="LEV 21:20"/><verse number="21" style="v" sid="LEV 21:21"/>مَبّنيِ يٌ قَتَن سّرّشّدُبّ هَرُنَ شَبِلّ رَ، عَ نَشَ عَ مَسٌ ﭑ تَن عَلَتَلَ شَ سّرّشّبَدٍ رَ سّرّشّ فَن دَاشِ بَقٍ رَ عَ مَرِفِ عَلَ بّ. <verse eid="LEV 21:21"/><verse number="22" style="v" sid="LEV 21:22"/>عَ نْمَ ﭑ تَن عَلَ شَ دٌنسٍ سّنِيّنشِ مْولِ بِرِن دٌندٍ، <verse eid="LEV 21:22"/><verse number="23" style="v" sid="LEV 21:23"/>كْنْ عَ مُ لَن عَ شَ عَ مَسٌ يِرٍ سّنِيّنشِ قِسَمَنتٍ شَ دُفِ رَ، شَ نَ مُ عَ رَ سّرّشّبَدٍ رَ. عَ نَشَ ﭑ مَ يِرٍ سّنِيّنشِ شِلِ كَنَ، بَرِ مَ عَلَتَلَ نَن ﭑ نَ، نَشَن عَ رَ سّنِيّنمَ.» <verse eid="LEV 21:23"/><verse number="24" style="v" sid="LEV 21:24"/>عَننَبِ مُنسَ نَشَ نَ مَسٍنيِ تِ هَرُنَ، عَ شَ دِيٍ، نُن عِسِرَيِلَكَ بِرِن بّ.<verse eid="LEV 21:24"/></para>
  <chapter eid="LEV 21"/>
  <chapter number="22" style="c" sid="LEV 22"/>
  <para style="s">سّرّشّيٍ نُن مَرَ سّنِيّنيِ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 22:1"/>عَلَتَلَ نَشَ عَ مَسٍن عَننَبِ مُنسَ بّ، <verse eid="LEV 22:1"/><verse number="2" style="v" sid="LEV 22:2"/>«عَ قَلَ هَرُنَ نُن عَ شَ دِيٍ بّ، عٍ شَ عِسِرَيِلَكَيٍ شَ سّرّشّ سّنِيّنشِيٍ بَ عَ بَ كِ مَ، بَرِ مَ عٍ نٍيٍ قِمَ ﭑ تَن نَن مَ. سّرّشّدُبّيٍ نَشَ ﭑ شِلِ سّنِيّنشِ كَنَ. عَلَتَلَ نَن ﭑ نَ.»<verse eid="LEV 22:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 22:3"/>«عَ قَلَ عٍ بّ، شَ عٍ بْنسْي مِشِ ندٍ سَ قِندِ سّنِيّنتَرٍ رَ، عَ نَشَ عَ مَسٌ عِسِرَيِلَكَيٍ شَ سّرّشّ رَ عٍ نَشٍيٍ قِمَ ﭑ تَن عَلَتَلَ مَ، نَ كَنيِ كٍرِ مَ نّ ﭑ يَ عِ. عَلَتَلَ نَن ﭑ نَ.»<verse eid="LEV 22:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 22:4"/>«كُنّ قُرٍ نَ مِشِ يٌ مَ هَرُنَ بْنسْي يَ مَ، شَ نَ مُ عَ رَ كْرْ سِلَ قُرٍ، نَ مُ لَن عَ شَ سّرّشّ سّنِيّنشِ دٌن قٌ عَ شَ فّ سّنِيّندٍ. عَ مَن مُ لَن مِشِ شَ نَ رَبَ شَ عَ بَرَ دِن مِشِ ندٍ رَ نَشَن بَرَ دِن مِشِ قُرٍ رَ. شَ يٍ سّنِيّنتَرٍ نَ مِنِقٍ مِشِ شّمّيَ كُي، عَ مُ لَن عَ شَ سّرّشّ سّنِيّنشِ دٌن. <verse eid="LEV 22:4"/><verse number="5" style="v" sid="LEV 22:5"/>شَ مِشِ ندٍ بَرَ دِن بُبُسٍ رَ، شَ نَ مُ عَ رَ مِشِ سّنِيّنتَرٍ رَ، نَ مُ لَن عَ شَ سّرّشّ سّنِيّنشِ دٌن. <verse eid="LEV 22:5"/><verse number="6" style="v" sid="LEV 22:6"/>نَشَن نَ رَبَمَ، نَ كَنيِ قِندِ مَ سّنِيّنتَرٍ نَن نَ هَن نُنمَرٍ. بٍينُ عَ شَ نَ سّرّشّ سّنِيّنشِ دٌن، عَ شَ عَ قَتٍ مَشَ. <verse eid="LEV 22:6"/><verse number="7" style="v" sid="LEV 22:7"/>سٌفٍ نَ فٌرٌ، عَ بَرَ سّنِيّن، عَ نْمَ سّرّشّ سّنِيّنشِ دٌندٍ سْنْن، بَرِ مَ عَ بَلٌي نَ عَ رَ.»<verse eid="LEV 22:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 22:8"/>«سّرّشّدُبّ نَشَ سُبٍ دٌن نَشَن قَشَشِ عَ يّتّ مَ. عَ مَن نَشَ سُبٍ دٌن سُبٍ فبّتّ نَشَن قَشَشِ، عَلَكٌ عَ نَشَ قِندِ سّنِيّنتَرٍ رَ. عَلَتَلَ نَن ﭑ نَ.»<verse eid="LEV 22:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 22:9"/>«سّرّشّدُبّيٍ شَ ﭑ مَ يَامَرِيٍ رَبَتُ عٍ بَلٌي شَ قٍ رَ، عَلَكٌ عٍ نَشَ يُنُبِ سْتْ، عٍ قَ قَشَ. عَلَتَلَ نَن ﭑ نَ، نَشَن عٍ رَ سّنِيّنمَ. <verse eid="LEV 22:9"/><verse number="10" style="v" sid="LEV 22:10"/>مِشِ يٌ نَشَ سّرّشّ سّنِيّنشِ دٌن شَ سّرّشّدُبّ مُ عَ رَ. هَلِ سّرّشّدُبّ شَ شْحّ، شَ نَ مُ عَ رَ عَ شَ وَلِكّ مُ لَنمَ عَ شَ عَ دٌن. <verse eid="LEV 22:10"/><verse number="11" style="v" sid="LEV 22:11"/>كْنْ سّرّشّدُبّ شَ كٌنيِ، عَ نَشَن سَرَ كْبِرِ رَ، عَ نُن نَ كٌنيِ شَ دٍنبَيَ تَن نْمَ سّرّشّدُبّ بَلٌي دٌندٍ. <verse eid="LEV 22:11"/><verse number="12" style="v" sid="LEV 22:12"/>سّرّشّدُبّ شَ دِ فِنّ نَشَن دْشْشِ شّمّ عَلَ كٌلٌنتَرٍ شْن مَ، نَشَ سّرّشّ سّنِيّنشِ دٌن. <verse eid="LEV 22:12"/><verse number="13" style="v" sid="LEV 22:13"/>سّرّشّدُبّ شَ دِ فِنّ نَشَن قِندِشِ كَاحّ فِنّ رَ، شَ نَ مُ عَ رَ شّمّ مّيشِ نَشَن نَ عٍ مُ دِ بَرِ، عَ فبِلٍن عَ بَبَ شْنيِ عَلْ عَ نُ نَ نَا كِ نَشّ عَ دِ مّدِ رَ، نَ فِنّ نْمَ عَ بَبَ بَلٌي دٌندٍ. مِشِ يٌ نَشَن مُ قِندِ عِسِرَيِلَكَ رَ، نَ مُ لَنمَ عَ شَ نَ مْولِ دٌن. <verse eid="LEV 22:13"/><verse number="14" style="v" sid="LEV 22:14"/>شَ مِشِ ندٍ سَ سّرّشّ سّنِيّنشِ دٌن كٌلٌنتَرٍيَ مَ، عَ لَن عَ شَ عَ حْشْي قِ كْبِرِ رَ، عَ مَن شَ ندٍ سَ نَ قَرِ. نَ قِندِ مَ كْبِرِ نَشَن نَ، عَ نَ دٌنسٍ سَرٍ نَن عِتَشُنمَ دْشْ سُولِ رَ، عَ قَ دْشْ كٍرٍن بَ عَ رَ، عَ نَ سٌ سّرّشّدُبّ يِ رَ. <verse eid="LEV 22:14"/><verse number="15" style="v" sid="LEV 22:15"/>سّرّشّدُبّيٍ نَشَ قٍ رَبَ ﭑ تَن عَلَتَلَ شَ سّرّشّ سّنِيّنشِيٍ رَ، عَ مُ لَن نَشَن شَ رَبَ <verse eid="LEV 22:15"/><verse number="16" style="v" sid="LEV 22:16"/>عَلَكٌ عٍ نَشَ يُنُبِ سْتْ نَ سّرّشّيٍ شَ قٍ رَ عٍ نَشٍيٍ دٌنشِ. عَلَتَلَ نَن ﭑ نَ، نَشَن عٍ رَ سّنِيّنمَ.»<verse eid="LEV 22:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 22:17"/>عَلَتَلَ نَشَ عَ مَسٍن عَننَبِ مُنسَ بّ، <verse eid="LEV 22:17"/><verse number="18" style="v" sid="LEV 22:18"/>«عَ قَلَ هَرُنَ، عَ شَ دِيٍ، نُن عِسِرَيِلَكَيٍ بِرِن بّ، عِسِرَيِلَكَيٍ بِرِن، عَ نُن شْحّ نَشٍيٍ سَبَتِشِ عِسِرَيِلَ بْشِ مَ، مِشِ نَشَن سّرّشّ فَن دَاشِ بَمَ ﭑ تَن عَلَتَلَ بّ لَايِدِ ندٍ رَكَمَلِقٍ رَ، شَ نَ مُ عَ رَ عَ يّتّ حَنِفٍ رَبَقٍ رَ، <verse eid="LEV 22:18"/><verse number="19" style="v" sid="LEV 22:19"/>عَ لَن عَ شَ تُورَ نَن بَ، شَ نَ مُ عَ رَ يّشّي كٌنتٌنيِ، شَ نَ مُ عَ رَ سِكْتّ، لَنيُرُ مُ نَ نَشَن مَ. <verse eid="LEV 22:19"/><verse number="20" style="v" sid="LEV 22:20"/>وٌ نَشَ شُرُ سٍ يٌ بَ لَنيُرُ نَ نَشَن مَ، بَرِ مَ ﭑ تَن عَلَ مُ نَ مْولِ رَ سُشُمَ. <verse eid="LEV 22:20"/><verse number="21" style="v" sid="LEV 22:21"/>شَ مِشِ ندٍ وَ مَ شُرُ سٍ شُنفبٍ، شَ نَ مُ عَ رَ شُرُ سٍ لَنمَ بَقٍ شَنُنتٍيَ سّرّشّ رَ ﭑ تَن عَلَتَلَ بّ، لَايِدِ ندٍ رَكَمَلِقٍ رَ، شَ نَ مُ عَ رَ حَنِفٍ رَبَقٍ رَ، نَ شُرُ سٍ قَتٍ شَ قَن، لَنيُرُ يٌ نَشَ لُ عَ مَ، شَ نَ مُ عَ رَ ﭑ تَن عَلَ مُ عَ رَ سُشُمَ. <verse eid="LEV 22:21"/><verse number="22" style="v" sid="LEV 22:22"/>وٌ نَشَ شُرُ سٍ يٌ بَ نَشَن يَ مُ قَن، نَشَن مَشْنْشِ، نَشَن مَبّنشِ، قُرٍ نَ نَشَن كِرِ مَ. وٌ نَشَ نَ مْولِ سَ ﭑ تَن عَلَتَلَ شَ سّرّشّبَدٍ قَرِ، عَ شَ قِندِ سّرّشّ فَن دَاشِ رَ. <verse eid="LEV 22:22"/><verse number="23" style="v" sid="LEV 22:23"/>عِ نْمَ نِنفٍ، شَ نَ مُ عَ رَ يّشّي كّحَ حَاشِ بَدٍ حَنِفٍ سّرّشّ رَ، كْنْ عِ مُ نْمَ نَ بَدٍ لَايِدِ رَكَمَلِ سّرّشّ رَ دٍ. <verse eid="LEV 22:23"/><verse number="24" style="v" sid="LEV 22:24"/>وٌ نَشَ شُرُ سٍ بَنَشِ، شّمّيَ كَنَشِ، شَ نَ مُ عَ رَ شّمّيَ مُ نَشَن بّ، بَ سّرّشّ رَ ﭑ تَن عَلَتَلَ بّ. وٌ نَشَ نَ مْولِ بَ سّرّشّ رَ وٌ شَ بْشِ مَ. <verse eid="LEV 22:24"/><verse number="25" style="v" sid="LEV 22:25"/>وٌ نَشَ نَ شُرُ سٍ مْولِ رَ سُشُ شْحّيٍ يِ رَ، وٌ شَ عٍ بَ سّرّشّ رَ وٌ مَرِفِ عَلَ بّ، بَرِ مَ عٍ قَتٍ مُ قَنشِ، عٍ مُ كَمَلِشِ. ﭑ تَن عَلَ مُ نٍيٍ رَ سُشُمَ.»<verse eid="LEV 22:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 22:26"/>عَلَتَلَ نَشَ عَ مَسٍن عَننَبِ مُنسَ بّ، <verse eid="LEV 22:26"/><verse number="27" style="v" sid="LEV 22:27"/>«نِنفٍ يْرّ، يّشّي يْرّ، نُن سِ يْرّ نَ بَرِ، عٍ شَ لُ عٍ نفَ بُن مَ شِ سٌلٌقٍرٍ، بٍينُ عٍ شَ قِندِ سّرّشّ فَن دَاشِ رَ ﭑ تَن عَلَتَلَ بّ. <verse eid="LEV 22:27"/><verse number="28" style="v" sid="LEV 22:28"/>وٌ نَشَ نِنفٍ، شَ نَ مُ عَ رَ يّشّي، نُن عَ شَ دِ كْن نَشَبَ لْشْي كٍرٍن كُي.»<verse eid="LEV 22:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 22:29"/>«وٌ شَ تَنتُي سّرّشّ بَ ﭑ تَن عَلَتَلَ بّ عَ بَ كِ مَ عَلَكٌ ﭑ شَ عَ سُشُ. <verse eid="LEV 22:29"/><verse number="30" style="v" sid="LEV 22:30"/>وٌ شَ نَ سّرّشّ دٌن نَ لْشْي يَتِ، عَ نَشَ لُ هَن فّيسّفّ. عَلَتَلَ نَن ﭑ نَ.»<verse eid="LEV 22:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 22:31"/>«وٌ شَ ﭑ مَ يَامَرِيٍ رَبَتُ، وٌ شَ عٍ سُشُ. عَلَتَلَ نَن ﭑ نَ. <verse eid="LEV 22:31"/><verse number="32" style="v" sid="LEV 22:32"/>وٌ نَشَ ﭑ شِلِ سّنِيّنشِ كَنَ. عِسِرَيِلَكَيٍ بِرِن شَ عَ كٌلٌن ﭑ سّنِيّن. عَلَتَلَ نَن ﭑ نَ، نَشَن وٌ رَ سّنِيّنمَ. <verse eid="LEV 22:32"/><verse number="33" style="v" sid="LEV 22:33"/>ﭑ تَن نَن وٌ رَ مِنِ مِسِرَ بْشِ رَ، ﭑ شَ قِندِ وٌ مَرِفِ عَلَ رَ. عَلَتَلَ نَن ﭑ نَ.»<verse eid="LEV 22:33"/></para>
  <chapter eid="LEV 22"/>
  <chapter number="23" style="c" sid="LEV 23"/>
  <para style="s">عِسِرَيِلَ سَلِ لْشْييٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 23:1"/>عَلَتَلَ نَشَ عَ مَسٍن عَننَبِ مُنسَ بّ، <verse eid="LEV 23:1"/><verse number="2" style="v" sid="LEV 23:2"/>«عَ قَلَ عِسِرَيِلَكَيٍ بّ، ﭑ تَن عَلَتَلَ شَ سَلِ لْشْييٍ نَن يَ، نَشٍيٍ سّنِيّنشِ وٌ بّ. <verse eid="LEV 23:2"/><verse number="3" style="v" sid="LEV 23:3"/>وٌ شَ وَلِ شِ سٍننِ، كْنْ شِ سٌلٌقٍرٍ ندٍ قِندِشِ مَلَبُي لْشْي نَن نَ، مَلَنيِ سّنِيّنشِ رَبَمَ لْشْي نَشّ. وٌ نَشَ وَلِ يٌ رَبَ نَ لْشْي. نَ قِندِشِ ﭑ تَن عَلَتَلَ نَن فبٍ رَ. وٌ شَ نَ سّرِيّ سُشُ وٌ سَبَتِدٍ بِرِن.»<verse eid="LEV 23:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 23:4"/>«ﭑ تَن عَلَتَلَ شَ سَلِ لْشْي فبّتّيٍ نَن يَ، وٌ حَمَ مَشِلِمَ لْشْي نَشٍيٍ مَ؛ <verse eid="LEV 23:4"/><verse number="5" style="v" sid="LEV 23:5"/>كِكٍ سِنفٍ، شِ قُ نُن نَانِ ندٍ، سٌفٍ دُلَ تّمُي، سَيَمَلٍكّ دَنفِ سَلِ سّرّشّ شَ بَ ﭑ تَن عَلَتَلَ بّ. <verse eid="LEV 23:5"/><verse number="6" style="v" sid="LEV 23:6"/>ﭑ تَن عَلَتَلَ شَ تَامِ لّبِنِتَرٍ سَلِ قْلْمَ نَ كِكٍ شِ قُ نُن سُولِ ندٍ لْشْي نّ. وٌ شَ تَامِ لّبِنِتَرٍيٍ دٌن نَ شِ سٌلٌقٍرٍ بُن مَ. <verse eid="LEV 23:6"/><verse number="7" style="v" sid="LEV 23:7"/>نَ سَلِ شِ سِنفٍ كُي، وٌ شَ مَلَنيِ سّنِيّنشِ رَبَ. وٌ نَشَ وَلِ يٌ رَبَ نَ لْشْي. <verse eid="LEV 23:7"/><verse number="8" style="v" sid="LEV 23:8"/>وٌ شَ سّرّشّيٍ فَن دَاشِيٍ بَ ﭑ تَن عَلَتَلَ بّ نَ شِ سٌلٌقٍرٍ بُن مَ. شِ سٌلٌقٍرٍ ندٍ لْشْي، وٌ مَن شَ مَلَنيِ سّنِيّنشِ رَبَ. وٌ نَشَ وَلِ يٌ رَبَ نَ لْشْي.»<verse eid="LEV 23:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 23:9"/>عَلَتَلَ نَشَ عَ مَسٍن عَننَبِ مُنسَ بّ، <verse eid="LEV 23:9"/><verse number="10" style="v" sid="LEV 23:10"/>«عَ قَلَ عِسِرَيِلَكَيٍ بّ، وٌ نَ سٌ بْشِ مَ ﭑ نَشَن قِمَ وٌ مَ، وٌ نَ شّ شَبَ، وٌ شَ عَ شِرِ سِنفٍ شَنِن سّرّشّدُبّ شْن. <verse eid="LEV 23:10"/><verse number="11" style="v" sid="LEV 23:11"/>سّرّشّدُبّ شَ نَ مَسٍن ﭑ تَن عَلَتَلَ بّ مَلَبُي لْشْي دَنفِ شَنبِ، عَلَكٌ ﭑ شَ عَ سُشُ وٌ بّ. <verse eid="LEV 23:11"/><verse number="12" style="v" sid="LEV 23:12"/>وٌ نَ شِرِ سِنفٍ مَسٍنمَ ﭑ تَن عَلَتَلَ بّ لْشْي نَشّ، وٌ مَن شَ يّشّي قَنيِ حّ كٍرٍن دَاشِ بَ سّرّشّ فَن دَاشِ رَ ﭑ بّ، <verse eid="LEV 23:12"/><verse number="13" style="v" sid="LEV 23:13"/>عَ نُن سَنسِ شْرِ دِنشِ كٌنبٌ يَ كٍرٍن نَشَن مَسُنبُشِ تُرٍ رَ. نَ قِندِ مَ سّرّشّ فَن دَاشِ رَ ﭑ تَن عَلَتَلَ بّ نَشَن شِرِ رَقَن ﭑ مَ. وٌ مَن شَ وّنِ لِتِرِ كٍرٍن بَ وّنِ سّرّشّ رَ. <verse eid="LEV 23:13"/><verse number="14" style="v" sid="LEV 23:14"/>وٌ نَشَن سْتْ شّ شَبَ تّمُي، وٌ نَشَ سٍسٍ دٌن، تَامِ، تْنسْي فَنشِ، نُن سَنسِ شْرِ رَ، بٍينُ وٌ شَ نَ سّرّشّ بَ وٌ مَرِفِ عَلَ بّ. سّرِيّ نَن نَ كِ وٌ بْنسْي بّ وٌ سَبَتِدٍ بِرِن. نَ مُ كَنَمَ عَبَدَن.»<verse eid="LEV 23:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 23:15"/>«قْلْ مَلَبُي لْشْي كُيٍ عِبَ مَ، وٌ نَ شِرِ سِنفٍ لِنتَنمَ عَلَتَلَ يَ عِ سّرّشّ رَ لْشْي نَشّ، لْشُن سٌلٌقٍرٍ شَ دَنفِ. <verse eid="LEV 23:15"/><verse number="16" style="v" sid="LEV 23:16"/>عَ شِ تٌنفٌ سُولِ ندٍ، مَلَبُي لْشْي شِ سٌلٌقٍرٍ ندٍ كُيٍ عِبَ، وٌ مَن شَ سّرّشّ بَ ﭑ تَن عَلَتَلَ بّ دَشَمُي نّينّ رَ. <verse eid="LEV 23:16"/><verse number="17" style="v" sid="LEV 23:17"/>وٌ شَ قَ تَامِ قِرِن نَ وٌ نَشَن لِنتَنمَ ﭑ تَن عَلَتَلَ يَ عِ سّرّشّ رَ، كٍلِقٍ رَ وٌ شْنيِيٍ. وٌ شَ عٍ يَءِلَن سَنسِ شْرِ لُشُتَشِ كٌنبٌ يَ كٍرٍن نَ، وٌ لّبِنِ سُنبُ عَ رَ. بٌفِسٍ سِنفٍ سّرّشّ نَن نَ كِ ﭑ تَن عَلَتَلَ بّ. <verse eid="LEV 23:17"/><verse number="18" style="v" sid="LEV 23:18"/>وٌ مَن شَ يّشّي قَنيِ حّ كٍرٍن دَاشِ سٌلٌقٍرٍ سَ نَ تَامِ قَرِ، تُورَ لَنمَ كٍرٍن، نُن يّشّي كٌنتٌنيِ قِرِن نَشٍيٍ بَمَ سّرّشّ فَن دَاشِيٍ رَ. وٌ مَن شَ سَنسِ شْرِ لُشُتَشِ نُن وّنِ سّرّشّ سَ نٍيٍ قَرِ. نٍيٍ فَن شِرِ نَقَن ﭑ تَن عَلَتَلَ مَ. <verse eid="LEV 23:18"/><verse number="19" style="v" sid="LEV 23:19"/>وٌ مَن شَ سِكْتّ كٍرٍن بَ يُنُبِ شَقَرِ سّرّشّ رَ، عَ نُن يّشّي قِرِن حّ كٍرٍن دَاشِ، نَشٍيٍ قِندِ مَ شَنُنتٍيَ سّرّشّ رَ. <verse eid="LEV 23:19"/><verse number="20" style="v" sid="LEV 23:20"/>سّرّشّدُبّ نَ بِرِن لِنتَنمَ ﭑ تَن عَلَتَلَ يَ عِ سّرّشّ رَ، نَ تَامِ سِنفٍيٍ، نُن نَ يّشّي قِرِنيِيٍ. عٍ بِرِن قِمَ ﭑ تَن عَلَتَلَ نَن مَ، عٍ قَ لُ سّرّشّدُبّ بّ. <verse eid="LEV 23:20"/><verse number="21" style="v" sid="LEV 23:21"/>نَ لْشْي وٌ شَ مَلَنيِ سّنِيّنشِ رَبَ. وٌ نَشَ وَلِ يٌ رَبَ نَ لْشْي. سّرِيّ نَ عَ رَ وٌ بْنسْي بّ يِرٍ بِرِن عَبَدَن. <verse eid="LEV 23:21"/><verse number="22" style="v" sid="LEV 23:22"/>وٌ نَ شّ شَبَ وٌ شْنيِ، وٌ نَشَ عَ تُشُييٍ شَبَ. بَلٌي نَشَن بِرَ مَ بْشِ مَ، وٌ شَ نَ لُ نَا سٍتَرٍيٍ بّ، عَ نُن مِشِيٍ بّ نَشٍيٍ كٍلِشِ حَمَنّ فبّتّيٍ مَ. عَلَتَلَ نَن ﭑ نَ، وٌ مَرِفِ عَلَ.»<verse eid="LEV 23:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 23:23"/>عَلَتَلَ نَشَ عَ مَسٍن عَننَبِ مُنسَ بّ، <verse eid="LEV 23:23"/><verse number="24" style="v" sid="LEV 23:24"/>«عَ قَلَ عِسِرَيِلَكَيٍ بّ، كِكٍ سٌلٌقٍرٍ ندٍ، شِ سِنفٍ، وٌ شَ وٌ مَلَبُ نَ لْشْي، وٌ شَ حَمَ مَشِلِ سَرَ شُي رَ، وٌ مَلَنيِ سّنِيّنشِ رَبَ. <verse eid="LEV 23:24"/><verse number="25" style="v" sid="LEV 23:25"/>وٌ نَشَ وَلِ يٌ رَبَ نَ لْشْي، وٌ شَ سّرّشّ فَن دَاشِيٍ بَ ﭑ تَن عَلَتَلَ بّ.»<verse eid="LEV 23:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 23:26"/>عَلَتَلَ نَشَ عَ مَسٍن عَننَبِ مُنسَ بّ، <verse eid="LEV 23:26"/><verse number="27" style="v" sid="LEV 23:27"/>«كِكٍ سٌلٌقٍرٍ ندٍ، شِ قُ ندٍ شَ قِندِ شُنسَرٍ لْشْي رَ. وٌ شَ مَلَنيِ سّنِيّنشِ رَبَ، وٌ شَ سُنيِ سُشُ، وٌ شَ سّرّشّ فَن دَاشِيٍ بَ ﭑ تَن عَلَتَلَ بّ. <verse eid="LEV 23:27"/><verse number="28" style="v" sid="LEV 23:28"/>وٌ نَشَ وَلِ يٌ رَبَ نَ لْشْي، بَرِ مَ شُنسَرٍ لْشْي نَ عَ رَ، وٌ شُن سَرَ مَ وٌ مَرِفِ عَلَتَلَ يَ عِ لْشْي نَشّ. <verse eid="LEV 23:28"/><verse number="29" style="v" sid="LEV 23:29"/>مِشِ نَشَن تٌندِ مَ سُنيِ سُشُدٍ نَ لْشْي، نَ كَنيِ رَ مِنِمَ نّ عَ شَ حَمَ يَ مَ. <verse eid="LEV 23:29"/><verse number="30" style="v" sid="LEV 23:30"/>مِشِ نَشَن وَلِ يٌ رَبَمَ نَ لْشْي، ﭑ عَ سْنتْمَ نّ عَ شَ حَمَ تَفِ. <verse eid="LEV 23:30"/><verse number="31" style="v" sid="LEV 23:31"/>وٌ نَشَ وَلِ يٌ رَبَ. سّرِيّ نَ عَ رَ وٌ بْنسْي بِرِن بّ يِرٍ بِرِن، نَشَن مُ كَنَمَ عَبَدَن. <verse eid="LEV 23:31"/><verse number="32" style="v" sid="LEV 23:32"/>نَ قِندِ مَ مَلَبُي لْشْي نَن نَ وٌ بّ. وٌ شَ سُنيِ سُشُ قْلْقٍ نَ كِكٍ شِ سٌلٌمَنَانِ لْشْي نُنمَرٍ رَ، هَن عَ شِ قُ لْشْي نُنمَرٍ رَ.»<verse eid="LEV 23:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="LEV 23:33"/>عَلَتَلَ نَشَ عَ مَسٍن عَننَبِ مُنسَ بّ، <verse eid="LEV 23:33"/><verse number="34" style="v" sid="LEV 23:34"/>«عَ قَلَ عِسِرَيِلَكَيٍ بّ، كِكٍ سٌلٌقٍرٍ ندٍ شِ قُ نُن سُولِ ندٍ، بَفٍ تِ سَلِ قْلْمَ، عَ بُ شِ سٌلٌقٍرٍ ﭑ تَن عَلَتَلَ شَ بِنيّ بُن مَ. <verse eid="LEV 23:34"/><verse number="35" style="v" sid="LEV 23:35"/>سَلِ شِ سِنفٍ مَلَنيِ سّنِيّنشِ رَبَمَ نّ. وٌ نَشَ وَلِ يٌ رَبَ نَ لْشْي. <verse eid="LEV 23:35"/><verse number="36" style="v" sid="LEV 23:36"/>وٌ شَ سّرّشّ فَن دَاشِيٍ بَ ﭑ تَن عَلَتَلَ بّ شِ سٌلٌقٍرٍ بُن مَ. شِ سٌلٌمَسَشَن ندٍ وٌ شَ مَلَنيِ سّنِيّنشِ رَبَ. وٌ شَ سّرّشّ فَن دَاشِيٍ بَ ﭑ تَن عَلَتَلَ بّ. سَلِ شُنفبٍ نَ عَ رَ، وٌ نَشَ وَلِ يٌ رَبَ.»<verse eid="LEV 23:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="LEV 23:37"/>«ﭑ تَن عَلَتَلَ شَ سَلِ لْشْي شُنفبٍيٍ نَن نَ كِ وٌ بّ. وٌ شَ سّرّشّ فَن دَاشِيٍ، سَنسِ شْرِ سّرّشّيٍ، نُن وّنِ سّرّشّيٍ بَ عَ بَ تّمُي. <verse eid="LEV 23:37"/><verse number="38" style="v" sid="LEV 23:38"/>وٌ شَ ﭑ تَن عَلَتَلَ شَ مَلَبُي لْشْييٍ رَبَتُ، وٌ شَ شَنُنتٍيَ سّرّشّيٍ، وٌ شَ لَايِدِ سّرّشّيٍ، عَ نُن وٌ شَ حَنِفٍ سّرّشّيٍ وٌ نَشٍيٍ قِمَ ﭑ مَ، وٌ شَ عٍ رَكَمَلِ.»<verse eid="LEV 23:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="LEV 23:39"/>«كِكٍ سٌلٌقٍرٍ ندٍ شِ قُ نُن سُولِ ندٍ، وٌ فّ شَنبِ وٌ شَ شّيٍ بٌفِسٍيٍ مَلَندٍ، وٌ شَ سَلِ رَبَ ﭑ تَن عَلَتَلَ بّ شِ سٌلٌقٍرٍ بُن مَ. سَلِ شِ سِنفٍ نُن عَ شِ سٌلٌمَسَشَن ندٍ قِندِشِ مَلَبُي لْشْييٍ نَن نَ. <verse eid="LEV 23:39"/><verse number="40" style="v" sid="LEV 23:40"/>سَلِ شِ سِنفٍ، وٌ شَ بٌفِسٍ قَنيِيٍ بَ سَنسِ بِلِيٍ كْن نَ، تُفِ قّنسّيٍ، نُن وُرِ تٌقَنيِ حِنفِيٍ. وٌ شَ سّيوَ وٌ مَرِفِ عَلَتَلَ يَ عِ شِ سٌلٌقٍرٍ بُن مَ. <verse eid="LEV 23:40"/><verse number="41" style="v" sid="LEV 23:41"/>وٌ شَ يِ سَلِ رَبَ عَلَتَلَ بّ حّ يٌ حّ شِ سٌلٌقٍرٍ بُن مَ. سّرِيّ نَ عَ رَ وٌ بْنسْي بِرِن بّ نَشَن مُ كَنَمَ عَبَدَن. وٌ شَ نَ سَلِ رَبَ كِكٍ سٌلٌقٍرٍ ندٍ كُي. <verse eid="LEV 23:41"/><verse number="42" style="v" sid="LEV 23:42"/>وٌ شَ شِ بَفٍيٍ كُي نَ شِ سٌلٌقٍرٍ بُن مَ. عِسِرَيِلَكَيٍ بِرِن شَ شِ بَفٍيٍ كُي، <verse eid="LEV 23:42"/><verse number="43" style="v" sid="LEV 23:43"/>عَلَكٌ وٌ بْنسْييٍ شَ عَ كٌلٌن عَ ﭑ عَ نِيَشِ نّ وٌ بٍنبَيٍ شَ شِ بَفٍيٍ كُي ﭑ عٍ رَ مِنِ مِسِرَ بْشِ رَ تّمُي نَشّ. عَلَتَلَ نَن ﭑ نَ، وٌ مَرِفِ عَلَ.»<verse eid="LEV 23:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LEV 23:44"/>عَننَبِ مُنسَ شَ مَسٍنيِ نَن نَ كِ، عَ نَشَن مَسٍن عِسِرَيِلَكَيٍ بّ عَلَتَلَ شَ سَلِيٍ شَ قٍ رَ.<verse eid="LEV 23:44"/></para>
  <chapter eid="LEV 23"/>
  <chapter number="24" style="c" sid="LEV 24"/>
  <para style="s">يِرٍ سّنِيّنشِ لَنثُي</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 24:1"/>عَلَتَلَ نَشَ عَ مَسٍن عَننَبِ مُنسَ بّ، <verse eid="LEV 24:1"/><verse number="2" style="v" sid="LEV 24:2"/>«عِسِرَيِلَكَيٍ يَمَرِ، عٍ شَ قَ عٌلِوِ تُرٍ قَنيِ رَ عِ شْن، عَلَكٌ لَنثُييٍ شَ دّشّ تّمُي بِرِن. <verse eid="LEV 24:2"/><verse number="3" style="v" sid="LEV 24:3"/>هَرُنَ شَ عَ حّنفِ سَ لَنثُييٍ شْن، نَشٍيٍ نَ هْرْ مْلِنفِرَ كُي، يِرٍ سّنِيّنشِ سّيتِ مَ. سَاتّ كَنكِرَ نَ نَ يِرٍ سّنِيّنشِ قِسَمَنتٍ نَن كُي، دُفِ فبَكُشِ عَ سٌدٍ دّ رَ. عَ شَ عَ نِيَ لَنثُييٍ شَ نُ دّشّ ﭑ تَن عَلَتَلَ يَ عِ تّمُي بِرِن، كٍلِقٍ نُنمَرٍ رَ هَن فّيسّفّ. سّرِيّ نَ عَ رَ وٌ بْنسْي بّ عَبَدَن. <verse eid="LEV 24:3"/><verse number="4" style="v" sid="LEV 24:4"/>هَرُنَ شَ عَ حّنفِ سَ لَنثُييٍ شْن نَشٍيٍ دْشْشِ لَنثُي دْشْ سٍ شّيمَ دَاشِيٍ قَرِ ﭑ تَن عَلَتَلَ يَ عِ.»<verse eid="LEV 24:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 24:5"/>«وٌ شَ تَامِ قُ نُن قِرِن يَءِلَن سَنسِ شْرِ لُشُتَشِ قَنيِ رَ، تَامِ كٍرٍن، سَنسِ شْرِ دِنشِ كٌنبٌ يَ كٍرٍن. <verse eid="LEV 24:5"/><verse number="6" style="v" sid="LEV 24:6"/>وٌ شَ عٍ سَ سَقّ قِرِن، سٍننِ نَ سّيتِ كٍرٍن، سٍننِ نَ سّيتِ بٌورٍ، تٍيبِلِ قَرِ ﭑ تَن عَلَتَلَ يَ عِ. <verse eid="LEV 24:6"/><verse number="7" style="v" sid="LEV 24:7"/>وٌ شَ سُرَيِ قَنيِ سَ تَامِ سَقّيٍ سّيتِ مَ، نَشَن قَمَ فَندٍ تَامِ حْشْي رَ ﭑ تَن عَلَتَلَ بّ. <verse eid="LEV 24:7"/><verse number="8" style="v" sid="LEV 24:8"/>تَامِ شَ سَ تٍيبِلِ قَرِ مَلَبُي لْشْي بِرِن. سّرِيّ نَ عَ رَ عِسِرَيِلَكَيٍ بّ عَبَدَن. <verse eid="LEV 24:8"/><verse number="9" style="v" sid="LEV 24:9"/>هَرُنَ نُن عَ شَ دِيٍ شَ نَ تَامِيٍ دٌن يِرٍ سّنِيّنشِ، بَرِ مَ سّرّشّ سّنِيّنشِ نَ عَ رَ، نَشٍيٍ قِشِ عَلَتَلَ مَ عَ فَن دَاشِ رَ. سّرِيّ نَ عَ رَ نَشَن مُ كَنَمَ عَبَدَن.»<verse eid="LEV 24:9"/></para>
  <para style="s">عَلَ شَ سّرِيّ مَتَندِيٍ</para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 24:10"/>لْشْي ندٍ مِشِ ندٍ نَشَ سٌ عِسِرَيِلَكَيٍ يَ مَ. عَ نفَ قِندِ عِسِرَيِلَكَ نَن نَ، كْنْ عَ بَبَ نَشَ قِندِ مِسِرَكَ رَ. فٍرٍ نَشَ بِرَ عَ عِ نَ مِشِ نُن عِسِرَيِلَكَ ندٍ تَفِ. <verse eid="LEV 24:10"/><verse number="11" style="v" sid="LEV 24:11"/>نَ كُي، نَ عِسِرَيِلَ فِنّ شَ دِ نَشَ عَلَتَلَ شِلِ بّشُ، عَ عَ كٌنبِ. عٍ نَشَ عَ شَنِن عَننَبِ مُنسَ شْن نَ قٍ مَ. نَ مِشِ نفَ شِلِ نّ سٍلٌمِتِ، دِبِرِ شَ دِ فِنّ، دَنَ بْنسْي. <verse eid="LEV 24:11"/><verse number="12" style="v" sid="LEV 24:12"/>عٍ نَشَ عَ سُشُ عَ قَنيِ رَ هَن عَلَتَلَ يَتِ نَشَ عَ شَ قٍ يَ عِبَ عٍ بّ.<verse eid="LEV 24:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 24:13"/>عَلَتَلَ نَشَ عَ مَسٍن عَننَبِ مُنسَ بّ، <verse eid="LEV 24:13"/><verse number="14" style="v" sid="LEV 24:14"/>«حَمَ شَ يِ كٌنبِتِ شَنِن حَمَ يٌنكِندٍ قَرِ مَ. نَشٍيٍ نَ كٌنبِ مّشِ، نٍيٍ شَ عٍ بّلّشّيٍ سَ عَ شُنيِ، حَمَ بِرِن قَ عَ مَفْنْ فّمّ رَ هَن عَ قَشَ. <verse eid="LEV 24:14"/><verse number="15" style="v" sid="LEV 24:15"/>عِ شَ عَ قَلَ عِسِرَيِلَكَيٍ بّ، مِشِ يٌ نَشَن ﭑ تَن عَلَ كٌنبِمَ، نَ يُنُبِ كٌتٍ لُمَ عَ شُن مَ. <verse eid="LEV 24:15"/><verse number="16" style="v" sid="LEV 24:16"/>نَشَن نَ ﭑ تَن عَلَتَلَ شِلِ بّشُ، حَمَ بِرِن شَ عَ مَفْنْ فّمّ رَ هَن عَ شَ قَشَ. شَ عَ قِندِ شْحّ رَ، شَ عَ قِندِ بٍكَ رَ، عَ شَ قَشَ بَرِ مَ عَ بَرَ ﭑ تَن عَلَتَلَ بّشُ.»<verse eid="LEV 24:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 24:17"/>«مِشِ نَشَن نَ عَدَ مَدِ قَشَ، عَ قَن شَ قَشَ. <verse eid="LEV 24:17"/><verse number="18" style="v" sid="LEV 24:18"/>مِشِ نَشَن نَ مِشِ ندٍ شَ شُرُ سٍ قَشَ، عَ شَ عَ حْشْي سٌ عَ يِ. نِي حْشْي شَ قِ نِي رَ. <verse eid="LEV 24:18"/><verse number="19" style="v" sid="LEV 24:19"/>مِشِ نَشَن نَ عَ بٌورٍ مَشْنْ، عَ قَن شَ مَشْنْ نَ كِ. <verse eid="LEV 24:19"/><verse number="20" style="v" sid="LEV 24:20"/>مَشْنّ حْشْي مَشْنّ نَن نَ. يَ حْشْي يَ نَن نَ، حِنيِ حْشْي نَ حِنيِ نَن نَ. عَ شَ مَشْنْ عَلْ عَ عَ رَبَشِ عَ بٌورٍ رَ كِ نَشّ. <verse eid="LEV 24:20"/><verse number="21" style="v" sid="LEV 24:21"/>مِشِ نَشَن نَ مِشِ شَ شُرُ سٍ قَشَ، عَ شَ عَ حْشْي قِ، كْنْ مِشِ نَشَن نَ عَدَ مَدِ قَشَ، نَ كَنيِ قَن شَ قَشَ. <verse eid="LEV 24:21"/><verse number="22" style="v" sid="LEV 24:22"/>سّرِيّ كٍرٍن نَ عَ رَ وٌ بِرِن بّ، شْحّيٍ نُن عِسِرَيِلَكَيٍ. عَلَتَلَ نَن ﭑ نَ، وٌ مَرِفِ عَلَ.»<verse eid="LEV 24:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 24:23"/>عَننَبِ مُنسَ تٌ فّ نَ مَسٍنيِ تِدٍ عِسِرَيِلَكَيٍ بّ، حَمَ نَشَ نَ كٌنبِتِ شَنِن حَمَ يٌنكِندٍ قَرِ مَ، عٍ عَ مَفْنْ فّمّ رَ هَن عَ قَشَ. نَ كُي عٍ نَشَ عَلَتَلَ شَ يَامَرِ سُشُ عَلْ عَننَبِ مُنسَ عَ مَسٍنشِ عٍ بّ كِ نَشّ.<verse eid="LEV 24:23"/></para>
  <chapter eid="LEV 24"/>
  <chapter number="25" style="c" sid="LEV 25"/>
  <para style="s">مَلَبُي حّ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 25:1"/>عَلَتَلَ نَشَ عَ مَسٍن عَننَبِ مُنسَ بّ تُرُ سِنِنَ فٍيَ قَرِ، <verse eid="LEV 25:1"/><verse number="2" style="v" sid="LEV 25:2"/>«عَ قَلَ عِسِرَيِلَكَيٍ بّ، وٌ نَ سٌ بْشِ كُي ﭑ نَشَن قِمَ وٌ مَ، وٌ شَ عَ لُ بْشِ شَ مَلَبُ ﭑ تَن عَلَتَلَ شَ بِنيّ بُن مَ. <verse eid="LEV 25:2"/><verse number="3" style="v" sid="LEV 25:3"/>وٌ شَ شّ وَلِ سُشُ، وٌ شَ مّينِ وّنِ بِلِيٍ مَ، وٌ شَ عٍ بٌفِيٍ بَ. وٌ شَ نَ بِرِن نَبَ حّ سٍننِ بُن مَ، <verse eid="LEV 25:3"/><verse number="4" style="v" sid="LEV 25:4"/>كْنْ حّ سٌلٌقٍرٍ ندٍ وٌ شَ عَ لُ بْشِ شَ عَ مَلَبُ ﭑ تَن عَلَتَلَ شَ بِنيّ بُن مَ. وٌ نَشَ شّ وَلِ رَبَ، وٌ نَشَ قٍقٍ رَبَ وّنِ بِلِيٍ رَ نَ حّ كُي. <verse eid="LEV 25:4"/><verse number="5" style="v" sid="LEV 25:5"/>سَنسِ بٌفِ نَشٍيٍ بُلَمَ عٍ يّتّ مَ، وٌ نَشَ عٍ شَبَ. وّنِ بٌفِيٍ نَشٍيٍ بٌفِمَ عٍ يّتّ مَ، وٌ شَ عٍ لُ نَا بَرِ مَ مَلَبُي حّ نَ عَ رَ بْشِ بّ. <verse eid="LEV 25:5"/><verse number="6" style="v" sid="LEV 25:6"/>بْشِ نَشَن نَمِنِمَ نَ مَلَبُي حّ كُي، وٌ بِرِن نْمَ نَ دٌندٍ، وٌ تَن، وٌ شَ كٌنيِيٍ، وٌ شَ وَلِكّيٍ، وٌ شَ شْحّيٍ، <verse eid="LEV 25:6"/><verse number="7" style="v" sid="LEV 25:7"/>وٌ شَ شُرُ سٍيٍ، عَ نُن بُرُنيِ سُبٍ نَشٍيٍ نَ بْشِ كُي. بْشِ نَشَن نَمِنِ عَ يّتّ رَ نَ حّ رَ، نَ نَن قِندِ مَ وٌ بَلٌي رَ.»<verse eid="LEV 25:7"/></para>
  <para style="s">شْرّيَ حّ</para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 25:8"/>«وٌ شَ مَلَبُي حّ سٌلٌقٍرٍ كْنتِ، حّ تٌنفٌ نَانِ نُن سٌلٌمَنَانِ، حّ سٌلٌقٍرٍ دْشْ سٌلٌقٍرٍ. <verse eid="LEV 25:8"/><verse number="9" style="v" sid="LEV 25:9"/>عَ كِكٍ سٌلٌقٍرٍ شِ قُ ندٍ، وٌ شَ سَرَيٍ قٍ حَمَ بّ بْشِ بِرِن كُي، عَ قِندِ مَ شُنسَرٍ لْشْي نَن نَ. <verse eid="LEV 25:9"/><verse number="10" style="v" sid="LEV 25:10"/>نَ حّ تٌنفٌ سُولِ ندٍ شَ قِندِ شْرّيَ حّ رَ بْشِ مِشِ بِرِن بّ. كٌنيِ بِرِن شَ شْرّيَ سْتْ، كَنكَن شَ فبِلٍن عَ شْنيِ عَ شَبِلّ يَ مَ. <verse eid="LEV 25:10"/><verse number="11" style="v" sid="LEV 25:11"/>نَ حّ تٌنفٌ سُولِ ندٍ قِندِ مَ شْرّيَ حّ نَن نَ وٌ بّ. وٌ نَشَ سَنسِ شْرِيٍ سِ، وٌ نَشَ سَنسِ بٌفِيٍ نُن وّنِ بٌفِيٍ بَ نَشٍيٍ بُلَمَ عٍ يّتّ مَ، <verse eid="LEV 25:11"/><verse number="12" style="v" sid="LEV 25:12"/>شْرّيَ حّ نَن نَ رَ، وَشَتِ سّنِيّنشِ نَ عَ رَ وٌ بّ. بْشِ دَشَمُي شَ قِندِ وٌ شَ بَلٌي رَ.»<verse eid="LEV 25:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 25:13"/>«نَ شْرّيَ حّ كُي، بِرِن شَ فبِلٍن عٍ شَ بْشِ مَ. <verse eid="LEV 25:13"/><verse number="14" style="v" sid="LEV 25:14"/>شَ وٌ بْشِ مَتِمَ وٌ نفَشَكٍرٍنيِ مَ، شَ نَ مُ عَ رَ وٌ بَرَ ندٍ سَرَ وٌ نفَشَكٍرٍنيِ مَ، وٌ نَشَ وٌ بٌورٍ تْورْ نَ كُي. <verse eid="LEV 25:14"/><verse number="15" style="v" sid="LEV 25:15"/>وٌ شَ نَ سَرَ سَرٍ تِنشِنشِ رَ، نَشَن حّيٍ كْنتِمَ كٍلِقٍ شْرّيَ حّ وَشَتِ. وٌ نفَشَكٍرٍنيِ شَ نَ مَتِ وٌ مَ سّرِيّ كِ مَ. عَ شَ شّ شَبَ حّ كْنتِ نَشٍيٍ لُشِ بٍينُ شْرّيَ حّ شَ عَ لِ. <verse eid="LEV 25:15"/><verse number="16" style="v" sid="LEV 25:16"/>شَ حّ وُيَشِ لُشِ، عَ سَرٍ شَ مَتٍ نَ كِ. شَ حّ وُيَشِ مُ لُشِ، عَ سَرٍ شَ مَفٌرٌ. وٌ شَ عَ مَتٌ شّ شَبَمَ سَنمَيَ يٍرِ بٍينُ شْرّيَ حّ شَ عَ لِ. <verse eid="LEV 25:16"/><verse number="17" style="v" sid="LEV 25:17"/>وٌ نَشَ وٌ بٌورٍ تْورْ نَ كُي. وٌ شَ فَاشُ وٌ مَرِفِ عَلَ يَ رَ. عَلَتَلَ نَن ﭑ نَ، وٌ مَرِفِ عَلَ.»<verse eid="LEV 25:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 25:18"/>«وٌ شَ ﭑ مَ سّرِيّ سُشُ، وٌ شَ ﭑ مَ يَامَرِيٍ رَبَتُ، عَلَكٌ وٌ شَ لُ يِ بْشِ مَ بْحّسَ كُي. <verse eid="LEV 25:18"/><verse number="19" style="v" sid="LEV 25:19"/>بْشِ دَشَمُي قَمَ وٌ وَ سَدٍ، وٌ مَن سَبَتِمَ بْحّسَ كُي. <verse eid="LEV 25:19"/><verse number="20" style="v" sid="LEV 25:20"/>شَ وٌ سَ مَشْرِنيِ تِ يِ كِ، ‹شَ وٌن مُ سٍسٍ سِمَ حّ سٌلٌقٍرٍ ندٍ كُي، شَ وٌن مُ سَنسِ شَبَمَ نَ تّمُي، وٌن بَلٌمَ مُنسٍ رَ قَ؟› <verse eid="LEV 25:20"/><verse number="21" style="v" sid="LEV 25:21"/>ﭑ تَن نَن بَرَكَ رَفٌرٌ مَ وٌ مَ حّ سٍننِ ندٍ كُي، نَشَن قِندِ مَ بَلٌي رَ وٌ بّ حّ سَشَن بُن مَ. <verse eid="LEV 25:21"/><verse number="22" style="v" sid="LEV 25:22"/>وٌ شَ سَنسِ شْرِ سِ حّ سٌلٌمَسَشَن ندٍ كُي، كْنْ وٌ دٌنسٍ رَفَتَشِ نَن دٌنمَ هَن حّ سٌلٌمَنَانِ ندٍ. دٌنسٍ نَشَن نَفَتَشِ، نَ وٌ رَلِمَ نّ هَن بَلٌي نّينّ سَ مِنِمَ تّمُي نَشّ.»<verse eid="LEV 25:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 25:23"/>«وٌ نَشَ بْشِ مَتِ عَ شَ لُ وٌ بٌورٍ يِ رَ عَبَدَن، بَرِ مَ ﭑ تَن نَن فبٍ بْشِ رَ. وٌ لُشِ نّ عَلْ شْحّيٍ نَشٍيٍ يِفِيَشِ ﭑ شْنيِ. <verse eid="LEV 25:23"/><verse number="24" style="v" sid="LEV 25:24"/>سّرِيّ كِ مَ، وٌ شَ تِن يِ بْشِ بِرِن شُن شَ سَرَ. <verse eid="LEV 25:24"/><verse number="25" style="v" sid="LEV 25:25"/>شَ وٌ نفَشَكٍرٍنيِ ندٍ عَ شَ بْشِ مَتِ عَ شَ سٍتَرٍحَ مَ، عَ بَرِبٌورٍ ندٍ شَ نَ بْشِ مَتِشِ شُن سَرَ. <verse eid="LEV 25:25"/><verse number="26" style="v" sid="LEV 25:26"/>شَ عَ بَرِبٌورٍ مُ نَ نَشَن نْمَ نَ بْشِ شُن سَرَدٍ، كْنْ عَ تَن نَشَ سَ نَ شُنسَرٍ قّيرّ سْتْ عَ يّتّ رَ، <verse eid="LEV 25:26"/><verse number="27" style="v" sid="LEV 25:27"/>عَ شَ بْشِ سَرٍ كْنتِ سّرِيّ كِ مَ، كٍلِقٍ عَ سَرَ تّمُي، عَ قَ نَ حْشْي رَفبِلٍن عَ سَرَ مِشِ مَ، عَلَكٌ عَ شَ فبِلٍن عَ شَ بْشِ مَسْتْ رَ. <verse eid="LEV 25:27"/><verse number="28" style="v" sid="LEV 25:28"/>كْنْ شَ عَ مُ نَ شُنسَرٍ قّيرّ سْتْ، نَ بْشِ شَ لُ عَ سَرَ مِشِ يِ رَ هَن شْرّيَ حّ رَ. نَ تّمُي بْشِ كَنيِ مَن شَ فبِلٍن عَ شَ بْشِ مَسْتْ رَ.»<verse eid="LEV 25:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 25:29"/>«شَ مِشِ ندٍ سَ عَ شَ بَنشِ مَتِ نَشَن نَ تَا كُي تّتّ رَبِلِنشِ نَشَن نَ، عَ نْمَ نَ بَنشِ شُن سَرَدٍ حّ كٍرٍن بُن مَ. <verse eid="LEV 25:29"/><verse number="30" style="v" sid="LEV 25:30"/>شَ نَ بَنشِ شُن مُ سَرَ نَ حّ كُي، عَ لُمَ نّ عَ سَرَ مِشِ نُن عَ بْنسْي يِ رَ عَبَدَن. هَلِ شْرّيَ حّ كُي عَ سَرَ مِشِ مُ كٍلِمَ نَا. <verse eid="LEV 25:30"/><verse number="31" style="v" sid="LEV 25:31"/>كْنْ بَنشِ نَشٍيٍ تِشِ تَا شُنشُرِيٍ كُي، نَشٍيٍ مُ رَبِلِنشِ تّتّ رَ، نٍيٍ لُمَ عَلْ بْشِ. عٍ نْمَ شُن سَرَدٍ. نَشَن نَ مْولِ سَرَ مَ، عَ لَنمَ عَ شَ مِنِ نَ بَنشِ شْرّيَ حّ رَ.»<verse eid="LEV 25:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="LEV 25:32"/>«لٍوِكَيٍ تَن نْمَ عٍ شَ بَنشِيٍ شُن سَرَدٍ عٍ شَ تَايٍ كُي تّمُي بِرِن. <verse eid="LEV 25:32"/><verse number="33" style="v" sid="LEV 25:33"/>نَشَن بَرَ لٍوِكَ ندٍ شَ بَنشِ سَرَ، عَ مِنِمَ نّ نَ كُي شْرّيَ حّ تّمُي، بَرِ مَ بَنشِ نَشٍيٍ نَ لٍوِكَيٍ شَ تَايٍ كُي، نٍيٍ قِندِشِ لٍوِكَيٍ نَن فبٍ رَ عِسِرَيِلَ حَمَ تَفِ. <verse eid="LEV 25:33"/><verse number="34" style="v" sid="LEV 25:34"/>شّ نَشٍيٍ نَ لٍوِكَيٍ شَ تَايٍ رَبِلِنيِ، نٍيٍ مُ نْمَ مَتِدٍ، بَرِ مَ لٍوِكَيٍ نَن فبٍ عٍ رَ عَبَدَن.»<verse eid="LEV 25:34"/></para>
  <para style="s">دٌنِ سّرِيّ</para>
  <para style="p">
    <verse number="35" style="v" sid="LEV 25:35"/>«شَ وٌ نفَشَكٍرٍنيِ ندٍ قِندِ سٍتَرٍ رَ، قّيرّ مُ نَ عَ يِ رَ عَ بَلٌمَ نَشَن نَ، عَ لَنمَ وٌ شَ عَ مَلِ عَلْ شْحّ، عَ شَ لُ وٌ قّ مَ. <verse eid="LEV 25:35"/><verse number="36" style="v" sid="LEV 25:36"/>وٌ نَشَ رِبَ سَ عَ شَ دٌنِ شُن مَ. وٌ شَ فَاشُ وٌ مَرِفِ عَلَ يَ رَ. وٌ شَ وٌ نفَشَكٍرٍنيِ يِفِيَ. <verse eid="LEV 25:36"/><verse number="37" style="v" sid="LEV 25:37"/>وٌ نَشَ رِبَ سَ عَ شَ دٌنِ شُن مَ، وٌ نَشَ رِبَ سَ عَ شَ دٌنسٍ سَرٍ شُن مَ. <verse eid="LEV 25:37"/><verse number="38" style="v" sid="LEV 25:38"/>عَلَتَلَ نَن ﭑ نَ، وٌ مَرِفِ عَلَ، نَشَن وٌ رَ مِنِشِ مِسِرَ بْشِ كُي، ﭑ شَ كَنَان بْشِ قِ وٌ مَ، ﭑ شَ قِندِ وٌ مَرِفِ عَلَ رَ.»<verse eid="LEV 25:38"/></para>
  <para style="s">مِشِ شُن سَرَ سّرِيّ</para>
  <para style="p">
    <verse number="39" style="v" sid="LEV 25:39"/>«شَ وٌ نفَشَكٍرٍنيِ ندٍ عَ يّتّ مَتِ وٌ مَ عَ شَ سٍتَرٍحَ مَ، وٌ نَشَ كٌنيِ وَلِ دْشْ عَ مَ. <verse eid="LEV 25:39"/><verse number="40" style="v" sid="LEV 25:40"/>عَ شَ لُ عَلْ وٌ شَ وَلِكّ، شَ نَ مُ عَ رَ وٌ شَ شْحّ هَن شْرّيَ حّ وَشَتِ. <verse eid="LEV 25:40"/><verse number="41" style="v" sid="LEV 25:41"/>نَ تّمُي، عَ تَن نُن عَ شَ دِيٍ شَ شْرّيَ، عٍ شَ فبِلٍن عٍ شَبِلّ مَ، عٍ بٍنبَيٍ شَ بْشِ مَ، <verse eid="LEV 25:41"/><verse number="42" style="v" sid="LEV 25:42"/>بَرِ مَ ﭑ مَ وَلِكّيٍ نَن عِسِرَيِلَكَيٍ رَ، ﭑ نَشٍيٍ رَ مِنِشِ مِسِرَ بْشِ رَ. عَ مُ لَنمَ عٍ شَ مَتِ كٌنيِيَ رَ. <verse eid="LEV 25:42"/><verse number="43" style="v" sid="LEV 25:43"/>وٌ نَشَ عٍ يَمَرِ عَ حَاشِ رَ، وٌ شَ فَاشُ وٌ مَرِفِ عَلَ يَ رَ. <verse eid="LEV 25:43"/><verse number="44" style="v" sid="LEV 25:44"/>شَ وٌ وَ مَ كٌنيِيٍ شْن، وٌ شَ عٍ سَرَ سِ فبّتّيٍ تَفِ، نَشٍيٍ نَ وٌ رَبِلِنيِ. عٍ تَن نَن شَ قِندِ وٌ شَ كٌنيِيٍ رَ. <verse eid="LEV 25:44"/><verse number="45" style="v" sid="LEV 25:45"/>وٌ مَن نْمَ كٌنيِيٍ سَرَدٍ سِ فبّتّيٍ شَ مِشِيٍ يَ مَ نَشٍيٍ دْشْشِ وٌ تَفِ، عَ نُن عٍ شَبِلّيٍ مِشِ نَشٍيٍ بَرِشِ وٌ شَ بْشِ كُي. نٍيٍ نْمَ قِندِدٍ وٌ شَ كٌنيِيٍ رَ. <verse eid="LEV 25:45"/><verse number="46" style="v" sid="LEV 25:46"/>وٌ نْمَ عٍ لُدٍ وٌ شَ دِيٍ يِ رَ كّ رَ. عٍ نْمَ لُدٍ كٌنيِيَ كُي عَبَدَن، كْنْ وٌ نفَشَكٍرٍنيِ عِسِرَيِلَكَيٍ مُ نْمَ لُدٍ عٍ نفَشَكٍرٍنيِ شَ يَامَرِ شْرْشْي بُن مَ.»<verse eid="LEV 25:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="LEV 25:47"/>«شَ وٌ نفَشَكٍرٍنيِ سٍتَرٍ ندٍ عَ يّتّ مَتِ شْحّ بَننَشِ مَ وٌ شَ بْشِ كُي، شَ نَ مُ عَ رَ نَ شْحّ شَبِلّ مِشِ ندٍ مَ، <verse eid="LEV 25:47"/><verse number="48" style="v" sid="LEV 25:48"/>وٌ نفَشَكٍرٍنيِ بَرِبٌورٍ ندٍ نْمَ عَ شُن سَرَدٍ. <verse eid="LEV 25:48"/><verse number="49" style="v" sid="LEV 25:49"/>عَ سْشْ، شَ نَ مُ عَ رَ عَ سْشْ شَ دِ، شَ نَ مُ عَ رَ عَ بَرِبٌورٍ ندٍ فبّتّ، نْمَ عَ شُن سَرَدٍ. شَ عَ قَن قّيرّ سْتْ، عَ نْمَ عَ يّتّ شُن سَرَدٍ. <verse eid="LEV 25:49"/><verse number="50" style="v" sid="LEV 25:50"/>عَ شَ نَ شُنسَرٍ كْنتِ سّرِيّ كِ مَ، كٍلِقٍ عَ سَرَ حّ مَ، هَن شْرّيَ حّ رَ. عَ شَ نَ حْشْي رَفبِلٍن عَ كَنيِ مَ، عَ شَ لُ عَلْ وَلِ سَرٍ. <verse eid="LEV 25:50"/><verse number="51" style="v" sid="LEV 25:51"/>شَ حّ وُيَشِ لُشِ، عَ شُنسَرٍ شَ فبٌ نَ كِ عَ كَنيِ مَبِرِ. <verse eid="LEV 25:51"/><verse number="52" style="v" sid="LEV 25:52"/>شَ حّ وُيَشِ مُ لُشِ بٍينُ شْرّيَ حّ شَ عَ لِ، عَ شُنسَرٍ شَ لَن نَ حّ شَسَبِ مَ. <verse eid="LEV 25:52"/><verse number="53" style="v" sid="LEV 25:53"/>عَ نْمَ لُدٍ عَلْ وَلِكّ عَ كَنيِ شْنيِ، كْنْ عَ مُ لَنمَ عَ كَنيِ شَ عَ يَمَرِ عَ حَاشِ رَ. <verse eid="LEV 25:53"/><verse number="54" style="v" sid="LEV 25:54"/>شَ عَ مُ نْمَ عَ يّتّ شُن سَرَدٍ يِ قّيرّ مْولِ يٌ رَ، عَ تَن نُن عَ شَ دِيٍ شَ لُ عٍ كَنيِ يِ رَ هَن شْرّيَ حّ رَ، <verse eid="LEV 25:54"/><verse number="55" style="v" sid="LEV 25:55"/>بَرِ مَ ﭑ تَن نَن مَ وَلِكّيٍ نَ عِسِرَيِلَكَيٍ رَ، ﭑ نَشٍيٍ رَ مِنِشِ مِسِرَ بْشِ رَ. عَلَتَلَ نَن ﭑ نَ، وٌ مَرِفِ عَلَ.»<verse eid="LEV 25:55"/></para>
  <chapter eid="LEV 25"/>
  <chapter number="26" style="c" sid="LEV 26"/>
  <para style="s">بَرَكّ نُن دَنكّ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 26:1"/>«وٌ نَشَ كُيٍ يٌ يَءِلَن، وٌ نَشَ عَلَ ندٍ رَقَلَ، وٌ نَشَ فّمّ بَتُ دَاشِ دْشْ، وٌ نَشَ فّمّ مَسٌلِشِ بَتُ، بَرِ مَ عَلَتَلَ نَن ﭑ نَ، وٌ مَرِفِ عَلَ. <verse eid="LEV 26:1"/><verse number="2" style="v" sid="LEV 26:2"/>وٌ شَ ﭑ مَ مَلَبُي لْشْييٍ رَبَتُ، وٌ شَ ﭑ مَ يِرٍ سّنِيّنشِ بِنيَ. عَلَتَلَ نَن ﭑ نَ.»<verse eid="LEV 26:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 26:3"/>«شَ وٌ ﭑ مَ سّرِيّ سُشُ، شَ وٌ ﭑ مَ يَامَرِيٍ رَبَتُ، <verse eid="LEV 26:3"/><verse number="4" style="v" sid="LEV 26:4"/>ﭑ تُنّ رَفٌرٌ مَ نّ وٌ بّ عَ وَشَتِ، بْشِ دَشَمُي رَ مِنِمَ نّ، سَنسِيٍ بٌفِمَ نّ شّ مَ. <verse eid="LEV 26:4"/><verse number="5" style="v" sid="LEV 26:5"/>سَنسِ بْنبْ تّمُي بُمَ نّ هَن وّنِ بٌفِ بَ تّمُي. وّنِ بٌفِ بَ تّمُي قَن بُمَ نّ هَن سَنسِ سِ تّمُي. وٌ وَ سَمَ نّ بَلٌي رَ، وٌ سَبَتِ وٌ شَ بْشِ مَ بْحّسَ كُي. <verse eid="LEV 26:5"/><verse number="6" style="v" sid="LEV 26:6"/>ﭑ هِننّمَ وٌ رَ عَلَكٌ وٌ شَ شِ بْحّسَ كُي، عَلَكٌ بُرُنيِ سُبٍيٍ نُن فٍرٍ سٌي نَشَ وٌ تْورْ وٌ شْنيِ. <verse eid="LEV 26:6"/><verse number="7" style="v" sid="LEV 26:7"/>وٌ نْمَ نّ وٌ يَشُييٍ رَ سَنتِدّفّمَ رَ. <verse eid="LEV 26:7"/><verse number="8" style="v" sid="LEV 26:8"/>وٌ شَ سْورِ سُولِ قَمَ نّ وٌ يَشُي مِشِ كّمّ كٍرِدٍ. وٌ شَ سْورِ كّمّ قَمَ وٌ يَشُي مِشِ وُلُ قُ كٍرِدٍ. وٌ قَمَ نْدٍ وٌ يَشُييٍ رَ فٍرٍ كُي. <verse eid="LEV 26:8"/><verse number="9" style="v" sid="LEV 26:9"/>وٌن بِرِن نَ عَ رَ. ﭑ دِ وُيَشِ قِمَ نّ وٌ مَ، ﭑ وٌ رَوُيَ. ﭑ نَن ﭑ مَ سَاتّ رَكَمَلِمَ نّ وٌ بّ. <verse eid="LEV 26:9"/><verse number="10" style="v" sid="LEV 26:10"/>وٌ يَلَ مَالٍ دٌنمَ نّ هَن مَالٍ شَبَ تّمُي. وٌ عَ قٌرِ بَمَ نّ عَ سَسٍيٍ كُي عَ شَ فبٌي مَ، عَلَكٌ وٌ شَ نْ مَالٍ نّينّ رَفَتَدٍ. <verse eid="LEV 26:10"/><verse number="11" style="v" sid="LEV 26:11"/>ﭑ لُمَ نّ وٌ سّيتِ مَ، ﭑ مُ مّيمَ وٌ رَ. <verse eid="LEV 26:11"/><verse number="12" style="v" sid="LEV 26:12"/>ﭑ حّرّ مَ نّ وٌ يَ مَ. وٌ مَرِفِ عَلَ نَن ﭑ نَ، وٌ قَن بَرَ قِندِ ﭑ مَ حَمَ رَ. <verse eid="LEV 26:12"/><verse number="13" style="v" sid="LEV 26:13"/>عَلَتَلَ نَن ﭑ نَ، وٌ مَرِفِ عَلَ، نَشَن وٌ رَ مِنِ مِسِرَ بْشِ رَ عَلَكٌ وٌ نَشَ لُ عٍ يِ رَ. ﭑ بَرَ كٌنيِيَ كٌتٍ بَ وٌ شُن مَ، عَلَكٌ وٌ شَ حّرّ شُننَكٍلِ كُي.»<verse eid="LEV 26:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 26:14"/>«كْنْ، شَ وٌ مُ ﭑ شُي رَ مّ، شَ وٌ مُ ﭑ مَ يَامَرِيٍ بِرِن نَبَتُ، <verse eid="LEV 26:14"/><verse number="15" style="v" sid="LEV 26:15"/>شَ وٌ مُ ﭑ مَ سّرِيّ سُشُ، شَ وٌ مُ بِرَ ﭑ وَشْنقٍ قْشْ رَ، شَ وٌ ﭑ مَ سَاتّ كَنَ، <verse eid="LEV 26:15"/><verse number="16" style="v" sid="LEV 26:16"/>ﭑ يِ نَن نَبَمَ وٌ رَ؛ ﭑ يِهَدِ رَفٌرٌ مَ نّ وٌ مَ، ﭑ وٌ رَقُرَ مَ نّ قُرٍ حَاشِ رَ نَشَن وٌ يَيٍ كَنَمَ، نَشَن وٌ بْحّ تْورْ مَ. وٌ سَنسِ شْرِيٍ سِمَ نّ قُقَقُ، بَرِ مَ وٌ يَشُييٍ نَ بِرِن دٌنمَ نّ. <verse eid="LEV 26:16"/><verse number="17" style="v" sid="LEV 26:17"/>ﭑ فبِلٍنمَ نّ وٌ قْشْ رَ. وٌ يَشُييٍ نْمَ نّ وٌ رَ، وٌ شْننَنتٍيٍ وٌ يَمَرِ مَ نّ. وٌ لُمَ فَاشُي نَن كُي، وٌ نُ وٌ فِ هَلِ مِشِ مُ نَ وٌ قْشْ رَ.»<verse eid="LEV 26:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 26:18"/>«كْنْ نَ بِرِن كُي، وٌ مُ قَمَ ﭑ شُي رَ مّدٍ. ﭑ وٌ حَشَنكَتَمَ هَن سَنمَيَ سٌلٌقٍرٍ وٌ شَ يُنُبِيٍ شَ قٍ رَ. <verse eid="LEV 26:18"/><verse number="19" style="v" sid="LEV 26:19"/>ﭑ وٌ شَ يّتّ عِفبٌحَ كَنَمَ نّ. ﭑ كٌورٍ بَلَنمَ نّ وٌ يَ رَ هَن وٌ شَ بْشِ شْرْشْ عَلْ وُرٍ فبٍيلِ. <verse eid="LEV 26:19"/><verse number="20" style="v" sid="LEV 26:20"/>وٌ سّنبّ حْنمَ نّ قُقَقُ. وٌ شَ بْشِ تٌندِ مَ نّ دَشَمُي رَ مِنِدٍ، وٌ شَ سَنسِيٍ مُ بٌفِمَ سْنْن.»<verse eid="LEV 26:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LEV 26:21"/>«شَ وٌ لُ ﭑ مَتَندِ رَ، شَ وٌ مُ ﭑ شُي رَ مّ، ﭑ وٌ حَشَنكَتَمَ هَن سَنمَيَ سٌلٌقٍرٍ وٌ شَ يُنُبِيٍ شَ قٍ رَ. <verse eid="LEV 26:21"/><verse number="22" style="v" sid="LEV 26:22"/>ﭑ بُرُنيِ سُبٍيٍ رَقَمَ نّ وٌ شِلِ مَ. عٍ وٌ شَ دِيٍ قَشَمَ نّ، عٍ وٌ شَ شُرُ سٍيٍ عِبْو، عٍ وٌ سْنتْ هَن مِشِ حْن كِرَيٍ شْن مَ.»<verse eid="LEV 26:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 26:23"/>«نَ بِرِن نَبَ شَنبِ وٌ رَ، شَ وٌ مُ تِن ﭑ مَ سّرِيّ رَ، شَ وٌ لُ ﭑ مَتَندِ رَ، <verse eid="LEV 26:23"/><verse number="24" style="v" sid="LEV 26:24"/>ﭑ قٍ شْرْشْي رَقَمَ نّ وٌ مَ، ﭑ وٌ حَشَنكَتَ هَن سَنمَيَ سٌلٌقٍرٍ وٌ شَ يُنُبِيٍ شَ قٍ رَ. <verse eid="LEV 26:24"/><verse number="25" style="v" sid="LEV 26:25"/>ﭑ فٍرٍ رَكٍلِمَ نّ وٌ مَ ﭑ مَ سَاتّ كَنَشِ شَ قٍ رَ. وٌ نَ وٌ نْشُن وٌ شَ تَا مَكَنتَشِيٍ كُي، ﭑ وٌ رَقُرَ مَ نّ قُرٍ حَاشِ رَ، وٌ قَ لُ وٌ يَشُييٍ سَفٌي. <verse eid="LEV 26:25"/><verse number="26" style="v" sid="LEV 26:26"/>ﭑ كَامّ رَدِنمَ وٌ مَ تّمُي نَشّ، فِنّ قُ تَامِ فَنمَ نّ تَامِ فَنسٍ كٍرٍن كُي. عٍ نَ عِتَشُن عَ شُنشُرِ رَ، عٍ عَ شَنِن وٌ شْن مَ وٌ عَ دٌن، كْنْ عَ مُ وٌ وَ سَمَ.»<verse eid="LEV 26:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 26:27"/>«نَ بِرِن نَبَ شَنبِ وٌ رَ، شَ وٌ مُ وٌ تُلِ مَتِ ﭑ نَ، شَ وٌ تٌندِ ﭑ وَشْنقٍ سُشُدٍ، <verse eid="LEV 26:27"/><verse number="28" style="v" sid="LEV 26:28"/>ﭑ قٍ شْرْشْي رَقَمَ نّ وٌ مَ، ﭑ وٌ حَشَنكَتَ هَن سَنمَيَ سٌلٌقٍرٍ وٌ شَ يُنُبِيٍ شَ قٍ رَ. <verse eid="LEV 26:28"/><verse number="29" style="v" sid="LEV 26:29"/>وٌ قَمَ وٌ شَ دِيٍ سُبٍ يَتِ دٌندٍ. <verse eid="LEV 26:29"/><verse number="30" style="v" sid="LEV 26:30"/>ﭑ وٌ شَ كُيٍ بَتُدٍيٍ كَنَمَ نّ نَشٍيٍ نَ فٍيَيٍ قَرِ. ﭑ وٌ شَ فّمّيٍ رَبِرَ مَ نّ، وٌ نَشٍيٍ بَتُمَ. ﭑ قُرٍيٍ مَلَنمَ نّ وٌ شَ كُيٍيٍ قَرِ. ﭑ وٌ رَبّحِنمَ نّ، <verse eid="LEV 26:30"/><verse number="31" style="v" sid="LEV 26:31"/>ﭑ وٌ شَ تَايٍ قِندِ فبٍنفبٍرٍنيِ رَ، ﭑ وٌ شَ بَتُدٍيٍ كَنَ، ﭑ تٌندِ وٌ شَ سّرّشّيٍ سُشُدٍ سْنْن. <verse eid="LEV 26:31"/><verse number="32" style="v" sid="LEV 26:32"/>ﭑ نَ فّ وٌ شَ بْشِ كَنَدٍ، وٌ يَشُييٍ يَتِ قَمَ كَابَدٍ نَ شَ قٍ رَ. <verse eid="LEV 26:32"/><verse number="33" style="v" sid="LEV 26:33"/>ﭑ وٌ رَيٍنسٍنمَ نّ حَمَنّ فبّتّيٍ مَ، ﭑ وٌ حَشَنكَتَمَ نّ سَنتِدّفّمَ رَ. وٌ شَ بْشِ كَنَمَ نّ، مِشِ يٌ مُ لُمَ وٌ شَ تَايٍ كُي.»<verse eid="LEV 26:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LEV 26:34"/>«نَ وَشَتِ بُن مَ وٌ شَ بْشِ مَلَبُمَ نّ. وٌ نَ وٌ يَشُييٍ يِرٍ تّمُي نَشّ، وٌ شَ بْشِ قَنمَ نّ مَلَبُي سَابُي رَ. <verse eid="LEV 26:34"/><verse number="35" style="v" sid="LEV 26:35"/>وٌ شَ بْشِ مَلَبُي سْتْمَ نَ وَشَتِ نَن كُي عَ مُ نَشَن سْتْ وٌ نُ نَ مّننِ تّمُي نَشّ. <verse eid="LEV 26:35"/><verse number="36" style="v" sid="LEV 26:36"/>نَشٍيٍ مُ قَشَمَ نَ فٍرٍيٍ كُي، نٍيٍ لُمَ نّ فَاشُي كُي عٍ يَشُييٍ يِرٍ، هَلِ وُرِ بُرّشّ نَن دِن عٍ رَ، قٌ عٍ عٍ فِ. عٍ عٍ فِمَ نّ، عٍ بِرَ هَلِ سَنتِدّفّمَ كَنيِ يٌ مُ نَ عٍ قْشْ رَ. <verse eid="LEV 26:36"/><verse number="37" style="v" sid="LEV 26:37"/>عٍ بِرَ مَ نّ عٍ بٌورٍ قَرِ، عَلْ سَنتِدّفّمَ كَنيِ نَن عٍ قْشْ رَ، عَ قَ لِ مِشِ يٌ مُ نَ عٍ قْشْ رَ. وٌ مُ نْمَ تِدٍ وٌ يَشُييٍ يَ رَ. <verse eid="LEV 26:37"/><verse number="38" style="v" sid="LEV 26:38"/>وٌ سْنتْمَ نّ سِ فبّتّيٍ تَفِ، وٌ يَشُييٍ نْمَ نّ وٌ رَ. <verse eid="LEV 26:38"/><verse number="39" style="v" sid="LEV 26:39"/>نَشٍيٍ مُ قَشَمَ فٍرٍ كُي وٌ يَ مَ، نٍيٍ قَمَ نّ قَشَدٍ عٍ يَشُييٍ شَ بْشِ مَ عٍ شَ يُنُبِيٍ نُن عٍ بٍنبَيٍ شَ يُنُبِيٍ شَ قٍ رَ.»<verse eid="LEV 26:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="LEV 26:40"/>«عٍ قَمَ عٍ شَ يُنُبِيٍ نُن عٍ بٍنبَيٍ شَ يُنُبِيٍ مَسٍندٍ ﭑ بّ، عَ نُن عٍ نَشَن نَبَشِ ﭑ نَ مَتَندِ كُي. <verse eid="LEV 26:40"/><verse number="41" style="v" sid="LEV 26:41"/>ﭑ قَن عٍ تْورْ مَ نّ عٍ يَشُييٍ شَ بْشِ كُي، عَلَكٌ مِشِ نَشٍيٍ عٍ يّتّ قِشِ ﭑ مَ، عٍ شَ مَفٌرٌ. عٍ شَ عٍ شَ يُنُبِيٍ سَرٍ قِ. <verse eid="LEV 26:41"/><verse number="42" style="v" sid="LEV 26:42"/>نَ تّمُي ﭑ نَن ﭑ حْشْ سَمَ نّ ﭑ مَ سَاتّ شْن مَ نَشَن نَ ﭑ تَن، نُن يَشُبَ، عِسِيَفَ، نُن عِبُرَهِمَ تَفِ. ﭑ مُ نّيمُمَ نَ بْشِ مَ. <verse eid="LEV 26:42"/><verse number="43" style="v" sid="LEV 26:43"/>بْشِ قَمَ نّ مَلَبُدٍ نَ تّمُي، بَرِ مَ عِسِرَيِلَكَيٍ بَرَ سِفَ ثٌن عٍ شَ يُنُبِ سَرٍ قِدٍ. عٍ بَرَ ﭑ مَ سّرِيّ بّحِن، عٍ بَرَ يٌ ﭑ مَ يَامَرِيٍ مَ.»<verse eid="LEV 26:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="LEV 26:44"/>«كْنْ، ﭑ نَ عٍ كٍرِ سِفَقٍ رَ عٍ يَشُييٍ يِرٍ تّمُي نَشّ، ﭑ مُ عٍ رَبّحِنمَ هَن عٍ شَ سْنتْ. ﭑ مُ ﭑ مَ سَاتّ كَنَمَ عٍ تَن مَ قٍ رَ، بَرِ مَ عَلَتَلَ نَن ﭑ نَ، عٍ مَرِفِ عَلَ. <verse eid="LEV 26:44"/><verse number="45" style="v" sid="LEV 26:45"/>ﭑ نَن ﭑ حْشْ سَمَ نّ ﭑ مَ سَاتّ سِنفٍ شْن مَ، ﭑ عٍ رَ مِنِ مِسِرَ بْشِ رَ سِيٍ يَ شْرِ تّمُي نَشّ، عَلَكٌ ﭑ شَ قِندِ عٍ مَرِفِ عَلَ رَ. عَلَتَلَ نَن ﭑ نَ.»<verse eid="LEV 26:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="LEV 26:46"/>عَلَتَلَ شَ سّرِيّ، عَ شَ يَامَرِيٍ، نُن عَ شَ مَسٍنيِيٍ نَن نَ كِ عَلَتَلَ نَشٍيٍ مَسٍنشِ عِسِرَيِلَكَيٍ بّ عَننَبِ مُنسَ سَابُي رَ تُرُ سِنِنَ فٍيَ قَرِ.<verse eid="LEV 26:46"/></para>
  <chapter eid="LEV 26"/>
  <chapter number="27" style="c" sid="LEV 27"/>
  <para style="s">مِشِ نَشٍيٍ عٍ يّتّ قِشِ عَلَ مَ</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 27:1"/>عَلَتَلَ نَشَ عَ مَسٍن عَننَبِ مُنسَ بّ، <verse eid="LEV 27:1"/><verse number="2" style="v" sid="LEV 27:2"/>«عَ قَلَ عِسِرَيِلَكَيٍ بّ، شَ مِشِ ندٍ لَايِدِ تٌنفٌ، عَ شَ مِشِ ندٍ قِ ﭑ تَن عَلَتَلَ مَ، عَ نْمَ عَ شُن سَرَدٍ يِ كْبِرِ شَسَبِ نَن نَ. <verse eid="LEV 27:2"/><verse number="3" style="v" sid="LEV 27:3"/>شَ شّمّ نَ عَ رَ نَشَن شَ سِمَيَ كٍلِمَ حّ مْشْحّن هَن حّ تٌنفٌ سٍننِ، عَ شُن سَرَ مَ فبٍتِ كٌلٍ تٌنفٌ سُولِ نَن نَ نَشَن مَنِيَمَ يِرٍ سّنِيّنشِ مَنِيَسٍ رَ. <verse eid="LEV 27:3"/><verse number="4" style="v" sid="LEV 27:4"/>شَ فِنّ نَ عَ رَ، عَ شُن سَرَ مَ فبٍتِ كٌلٍ تٌنفٌ سَشَن نُن عَ تَفِ نَن نَ. <verse eid="LEV 27:4"/><verse number="5" style="v" sid="LEV 27:5"/>شَ دِ شّمّ نَ عَ رَ نَشَن شَ سِمَيَ كٍلِمَ حّ سُولِ هَن حّ مْشْحّن، عَ شُن سَرَ مَ فبٍتِ كِلٌ مْشْحّن نَن نَ. شَ فِنّ دِ مّدِ نَ عَ رَ، عَ شُن سَرَ مَ فبٍتِ كٌلٍ قُ نَن نَ. <verse eid="LEV 27:5"/><verse number="6" style="v" sid="LEV 27:6"/>شَ دِ شّمّ نَ عَ رَ نَشَن مُ حّ سُولِ سْتْشِ سِندٍن، عَ شُن سَرَ مَ فبٍتِ كٌلٍ سُولِ نَن نَ. شَ دِ فِنّ نَ عَ رَ، عَ شُن سَرَ مَ فبٍتِ كٌلٍ سَشَن نَن نَ. <verse eid="LEV 27:6"/><verse number="7" style="v" sid="LEV 27:7"/>شَ شّمْشِ نَ عَ رَ نَشَن شَ سِمَيَ دَنفِمَ حّ تٌنفٌ سٍننِ رَ، عَ شُن سَرَ مَ فبٍتِ كٌلٍ قُ نُن سُولِ نَن نَ. شَ حّلّشّقٌرِ نَ عَ رَ، عَ شُن سَرَ مَ فبٍتِ كٌلٍ قُ نَن نَ. <verse eid="LEV 27:7"/><verse number="8" style="v" sid="LEV 27:8"/>شَ سٍتَرٍ بَرَ نَ لَايِدِ تٌنفٌ، نَشَن مُ نْمَ نَ شُنسَرٍ شَسَبِ قِدٍ، عَ لَن عَ شَ عَ يّتّ مَسٍن سّرّشّدُبّ بّ نَشَن قَمَ شُنسَرٍ شَسَبِ قَلَدٍ عَ بّ عَ نْمَ نَشَن نَ.»<verse eid="LEV 27:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 27:9"/>«شَ مِشِ ندٍ لَايِدِ تٌنفٌ شُرُ سٍ ندٍ قِقٍ رَ، نَشَن نْمَ بَدٍ سّرّشّ رَ ﭑ تَن عَلَتَلَ بّ، نَ شُرُ سٍ شَ قِ ﭑ تَن عَلَتَلَ مَ. عَ بَرَ سّنِيّن. <verse eid="LEV 27:9"/><verse number="10" style="v" sid="LEV 27:10"/>شُرُ سٍ فبّتّ مُ قِمَ عَ مَسَرٍ رَ، عَ قَن بَ، عَ مُ قَن بَ. شَ وٌ نَ رَبَمَ، عٍ قِرِنيِ بَرَ قِندِ سٍ سّنِيّنشِ رَ. <verse eid="LEV 27:10"/><verse number="11" style="v" sid="LEV 27:11"/>شَ سُبٍ رَهَرَ مُشِ نَ عَ رَ، نَشَن مُ بَمَ سّرّشّ رَ ﭑ تَن عَلَتَلَ بّ، عَ شَ شَنِن سّرّشّدُبّ شْن. <verse eid="LEV 27:11"/><verse number="12" style="v" sid="LEV 27:12"/>سّرّشّدُبّ شَ شُنسَرٍ ندٍ قَلَ سُبٍ كّحَ مَ. نَ شَ قِندِ عَ سَرٍ رَ. <verse eid="LEV 27:12"/><verse number="13" style="v" sid="LEV 27:13"/>شَ عَ كَنيِ وَ مَ نَ سُبٍ شُن سَرَقٍ، عَ شَ نَ سَرٍ قِ، عَ مَن شَ كْبِرِ ندٍ سَ نَ قَرِ. نَ قِندِ مَ كْبِرِ نَشَن نَ، عَ نَ سٍ سَرٍ نَن عِتَشُنمَ دْشْ سُولِ رَ، عَ قَ دْشْ كٍرٍن بَ عَ رَ، عَ نَ قِ شُنسَرٍ رَ.»<verse eid="LEV 27:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 27:14"/>«شَ مِشِ ندٍ عَ شَ بَنشِ قِ ﭑ تَن عَلَتَلَ مَ، سّرّشّدُبّ شَ نَ سَرٍ قَلَ بَنشِ كّحَ مَ. نَ شَ قِندِ عَ سَرٍ رَ. <verse eid="LEV 27:14"/><verse number="15" style="v" sid="LEV 27:15"/>شَ عَ كَنيِ وَ مَ عَ شُن سَرَقٍ، عَ شَ نَ سَرٍ قِ، عَ مَن شَ كْبِرِ ندٍ سَ نَ قَرِ. نَ قِندِ مَ كْبِرِ نَشَن نَ، عَ نَ بَنشِ سَرٍ نَن عِتَشُنمَ دْشْ سُولِ رَ، عَ قَ دْشْ كٍرٍن بَ عَ رَ، عَ نَ قِ شُنسَرٍ رَ. نَ تّمُي بَنشِ شَ فبِلٍن عَ كَنيِ مَ.»<verse eid="LEV 27:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 27:16"/>«شَ مِشِ ندٍ عَ شَ شّ قِ ﭑ تَن عَلَتَلَ مَ، عَ سَرٍ قَتَنمَ سَنسِ شْرِ شَسَبِ نَن نَ نَشَن نْمَ فَرَنسَندٍ نَا. فبٍتِ كٌلٍ تٌنفٌ سُولِ شَ قِ قُندٍنيِ مَنِيّ بُسَلِ نَانِ شَسَبِ رَ. <verse eid="LEV 27:16"/><verse number="17" style="v" sid="LEV 27:17"/>شَ عَ عَ شَ شّ قِ شْرّيَ حّ نَن كُي، عَ سَرٍ مُ مَسَرَ مَ. <verse eid="LEV 27:17"/><verse number="18" style="v" sid="LEV 27:18"/>شَ عَ عَ شَ شّ قِ شْرّيَ حّ دَنفِ شَنبِ نّ، سّرّشّدُبّ شَ حّيٍ كْنتِ نَشٍيٍ لُشِ بٍينُ شْرّيَ حّ فبّتّ شَ قَ. عَ شَ ندٍ بَ شّ سَرٍ رَ نَ سّرِيّ كُي. <verse eid="LEV 27:18"/><verse number="19" style="v" sid="LEV 27:19"/>شَ شّ كَنيِ وَ مَ عَ شَ شّ شُن سَرَقٍ، عَ شَ نَ سَرٍ قِ، عَ مَن شَ كْبِرِ ندٍ سَ نَ قَرِ. نَ قِندِ مَ كْبِرِ نَشَن نَ، عَ نَ شّ سَرٍ نَن عِتَشُنمَ دْشْ سُولِ رَ، عَ قَ دْشْ كٍرٍن بَ عَ رَ، عَ نَ قِ شُنسَرٍ رَ. نَ تّمُي شّ شَ لُ عَ يِ رَ. <verse eid="LEV 27:19"/><verse number="20" style="v" sid="LEV 27:20"/>شَ عَ مُ شّ شُن سَرَ، عَ قَ عَ مَتِ مِشِ فبّتّ مَ، عَ مُ نْمَ عَ شُن سَرَدٍ سْنْن. <verse eid="LEV 27:20"/><verse number="21" style="v" sid="LEV 27:21"/>شْرّيَ حّ نَ عَ لِ، نَ شّ كَنيِ نّينّ شَ كٍلِ نَ بْشِ مَ. بْشِ بَرَ سّنِيّن، عَ بَرَ لُ عَلْ بْشِ نَشَن نَتْنشِ. عَ بَرَ قِندِ عَلَتَلَ فبٍ رَ، سّرّشّدُبّيٍ شَ نَ رَوَلِ. <verse eid="LEV 27:21"/><verse number="22" style="v" sid="LEV 27:22"/>شَ مِشِ بَرَ شّ سَرَشِ قِ عَلَتَلَ مَ، نَشَن مُ نَ عَ شَبِلّ كّ يَ مَ، <verse eid="LEV 27:22"/><verse number="23" style="v" sid="LEV 27:23"/>سّرّشّدُبّ شَ عَ سَرٍ قَلَ عَ سّرِيّ كِ مَ. عَ نَ كٌلٌنمَ حّ شَسَبِ نَن مَ نَشٍيٍ لُشِ بٍينُ شْرّيَ حّ شَ عَ لِ. نَ كَنيِ شَ عَ سَرٍ قِ نَ لْشْي يَتِ، بَرِ مَ عَ سّنِيّن ﭑ تَن عَلَتَلَ بّ. <verse eid="LEV 27:23"/><verse number="24" style="v" sid="LEV 27:24"/>شْرّيَ حّ نَ عَ لِ، نَ شّ فبِلٍنمَ نَ شّ كَنيِ سِنفٍ نَن مَ، بٌورٍ عَ سَرَ نَشَن مَ. <verse eid="LEV 27:24"/><verse number="25" style="v" sid="LEV 27:25"/>نَ سَرٍيٍ بِرِن مَنِيَمَ يِرٍ سّنِيّنشِ شَ سٍ مَنِيَ كِ نَن مَ. عَ كٌلٍ كٍرٍن لَنشِ فَرَ مُ قُ نَن مَ.»<verse eid="LEV 27:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 27:26"/>«مِشِ يٌ مُ نْمَ عَ شَ شُرُ سٍ دِ سِنفٍ قِدٍ ﭑ تَن عَلَتَلَ مَ، بَرِ مَ عَ حَن قِندِشِ ﭑ تَن عَلَتَلَ فبٍ نَن نَ. شُرُ سٍ شُنفبٍ نُن عَ لَنمَ دِ سِنفٍ بِرِن قِندِشِ ﭑ تَن نَن فبٍ رَ. <verse eid="LEV 27:26"/><verse number="27" style="v" sid="LEV 27:27"/>مِشِ نْمَ سُبٍ رَهَرَ مُشِ شَ دِ سِنفٍ شُن سَرَدٍ. نَ مِشِ شَ عَ سَرٍ قِ، عَ مَن شَ كْبِرِ ندٍ سَ نَ قَرِ. نَ قِندِ مَ كْبِرِ نَشَن نَ، عَ نَ سُبٍ سَرٍ نَن عِتَشُنمَ دْشْ سُولِ رَ، عَ قَ دْشْ كٍرٍن بَ عَ رَ، عَ نَ قِ عَ شُنسَرٍ رَ. شَ عَ كَنيِ مُ عَ شُن سَرَ مَ، عَ شَ عَ مَتِ عَ سَرٍ رَ.»<verse eid="LEV 27:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="LEV 27:28"/>«كْنْ سٍ ندٍيٍ نَ مِشِ نَشٍيٍ قِمَ ﭑ تَن عَلَتَلَ مَ عَ بْحّ بِرِن نَ عٍ قِندِ ﭑ فبٍ رَ، عَدَ مَ مُ نْمَ نٍيٍ شُن سَرَدٍ سْنْن. نٍيٍ بَرَ سّنِيّن، نٍيٍ بَرَ قِندِ ﭑ تَن عَلَتَلَ فبَنسَن فبٍ رَ. نٍيٍ نْمَ قِندِدٍ مِشِ، شُرُ سٍ، شّ، شَ نَ مُ عَ رَ سٍ فبّتّ رَ. <verse eid="LEV 27:28"/><verse number="29" style="v" sid="LEV 27:29"/>مِشِ سٍ نَشٍيٍ قِمَ ﭑ تَن عَلَتَلَ مَ نَ مْولِ رَ، عٍ شُن مُ نْمَ سَرَدٍ، قٌ عٍ شَ قَشَ نّ.»<verse eid="LEV 27:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="LEV 27:30"/>«بْشِ قَرِلّ بِرِن قِندِ مَ ﭑ تَن عَلَتَلَ نَن فبٍ رَ، سَنسِ شْرِ نَشَن نَمِنِمَ نُن وُرِ بِلِ نَشَن بٌفِمَ. نَ قَرِلّ بِرِن قِمَ ﭑ تَن عَلَتَلَ نَن مَ. <verse eid="LEV 27:30"/><verse number="31" style="v" sid="LEV 27:31"/>شَ مِشِ ندٍ وَ مَ عَ شَ قَرِلّ شُن سَرَقٍ، عَ شَ عَ سَرٍ قِ، عَ مَن شَ كْبِرِ ندٍ سَ نَ قَرِ. نَ قِندِ مَ كْبِرِ نَشَن نَ، عَ نَ سٍ سَرٍ نَن عِتَشُنمَ دْشْ سُولِ رَ، عَ قَ دْشْ كٍرٍن بَ عَ رَ، عَ نَ قِ عَ شُنسَرٍ رَ. <verse eid="LEV 27:31"/><verse number="32" style="v" sid="LEV 27:32"/>شُرُ سٍ قَرِلّ بِرِن قِندِ مَ ﭑ تَن عَلَتَلَ نَن فبٍ رَ، شُرُ سٍ شُنفبٍ نُن عَ لَنمَ، شُرُ سٍ دّمَدٌنيِ نَشَن بِرِن كْنتِمَ. نَ قَرِلّ بِرِن قِمَ ﭑ تَن عَلَتَلَ نَن مَ. <verse eid="LEV 27:32"/><verse number="33" style="v" sid="LEV 27:33"/>شُرُ سٍيٍ مُ مَتٌمَ شَ عَ قَن، شَ عَ مُ قَن. شُرُ سٍ مُ نْمَ مَسَرَدٍ شُرُ سٍ فبّتّ رَ، شَ نَ مُ عَ رَ نَ قِرِنيِ بِرِن سّنِيّنمَ نّ، عٍ قِندِ ﭑ تَن عَلَتَلَ فبٍ رَ، عٍ سٍسٍ مُ نْمَ شُن سَرَدٍ سْنْن.»<verse eid="LEV 27:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="LEV 27:34"/>عَلَتَلَ شَ يَامَرِيٍ نَن نَ كِ، عَ نَشٍيٍ سٌ عَننَبِ مُنسَ يِ رَ تُرُ سِنِنَ فٍيَ قَرِ عِسِرَيِلَكَيٍ بّ.<verse eid="LEV 27:34"/></para>
  <chapter eid="LEV 27"/>
</usx>
