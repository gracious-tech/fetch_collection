<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1TH" style="id">Rough: John Mark, Mar 02.</book>
  <para style="h">تّسَلٌنِكِ عِ</para>
  <para style="toc1">عَلَ شَ مَسٍنيِ سِنفٍ عَننَبِ ثْلُ نَشَن سّبّ تّسَلٌنِكِ دَنشَنِيَتْي حَمَ مَ</para>
  <para style="toc2">تّسَلٌنِكِ عِ</para>
  <para style="mt">عَلَ شَ مَسٍنيِ سِنفٍ</para>
  <para style="mt">عَننَبِ ثْلُ نَشَن سّبّ</para>
  <para style="mt">تّسَلٌنِكِ دَنشَنِيَتْي حَمَ مَ</para>
  <para style="imt">مَسٍنيِ ندٍ يِ كِتَابُي شَ قٍ رَ</para>
  <para style="ip">يِ كِتَابُي قِندِشِ بَتَاشّ سِنفٍ نَن نَ عَلَ شَ شّيرَ ثْلُ نُن عَ وَلِبٌورٍيٍ نَشَن سّبّ دَنشَنِيَتْي حَمَ مَ نَشٍيٍ نُ سَبَتِشِ تّسَلٌنِكِ.</para>
  <para style="ip">بٍينُن عٍ شَ يِ بَتَاشّ سّبّ، ثْلُ نُن سِلِقَنُ نُ بَرَ كَوَندِ تِ تّسَلٌنِكِ. عَلَ تٌ عٍ شَ وَلِ بَرَكَ، نَا مِشِ وُيَشِ نَشَ فبِلٍن كُيٍ بَتُقٍ قْشْ رَ، عٍ دَنشَنِيَ عَلَ مَ نَشَن عَ شَ مِشِ سُفَندِشِ شّيشِ دُنِحَ رَكِسِدٍ. كْنْ ثْلُ نُن سِلِقَنُ مُ نْ بُدٍ تّسَلٌنِكِ تَا كُي، عٍ فِ كْي نَن نَ بَرِ مَ مِشِ كٌبِ ندٍيٍ نُ بَرَ حَمَ بْحّ رَتٍ عٍ شِلِ مَ. يِ قٍ بِرِن تَفِ رَبَشِ عِسَ شَ شّيرَيٍ شَ تَرُشُي كِتَابُي كُي، سٌرَ ١٧.</para>
  <para style="ip">ثْلُ نُن سِلِقَنُ تٌ عَتّن لِ، عٍ نَشَ كْنتْقِلِ تّسَلٌنِكِ دَنشَنِيَتْييٍ بّ بَرِ مَ عٍ مُ نُ عَ كٌلٌن شَ عٍ شَ دَنشَنِيَ سَبَتِشِ. نَ كُي، عٍ نَشَ تِمٌتٍ شّي عَلَكٌ عَ شَ تّسَلٌنِكِ دَنشَنِيَتْييٍ حَنِفٍ كٌلٌن، عَ شَ عٍ رَلِمَنِيَ عٍ شَ دَنشَنِيَ كُي. تِمٌتٍ تٌ فبِلٍن، عَ نَشَ دّنتّفّ سَ ثْلُ نُن سِلِقَنُ بّ. عَلَ شَشِلِ سّنِيّنشِ نَشَ مَسٍنيِ قِ عٍ مَ تّسَلٌنِكِكَيٍ بّ، عٍ نَشَ يِ بَتَاشّ سّبّ.</para>
  <para style="ip">يِ كِتَابُي تِدٍ تٌ بَرَ مِنِ تّسَلٌنِكِ دَنشَنِيَتْييٍ بّ، عَ لْننِ قِ عٍ مَ، عَ عٍ رَلِمَنِيَ، عَ تِدٍ نَ وٌن قَن بّ. عَ عَ مَسٍنمَ وٌن بّ عَ عَلَ وٌن شِلِشِ نّ وٌن شَ وٌن حّرّ سّنِيّنيِ كُي، وٌن شَ فبِلٍن سّنِيّنتَرٍحَ قْشْ رَ. عَ مَن عَ مَسٍنمَ عَ وَلِ تِدٍ فبٌ دَنشَنِيَتْي بّ. عَ لَنمَ وٌن شَ بَلٌ وٌن يِلٍنقُرٍ نَن نَ. يِ كِتَابُي مَن لِمَنِيَ قِمَ وٌن مَ بَرِ مَ عَ عَ مَسٍنمَ وٌن بّ عَ عَلَ شَ مِشِ سُفَندِشِ عِسَ قَمَ نّ عَ شَ دَنشَنِيَتْييٍ قْشْ رَ، عٍ حِحّ نُن عَ لَاشِرَشِ، عَ عٍ شَنِن عَلَ شْنيِ عٍ سَ لُمَ دّننَشّ عَبَدَن.</para>
  <para style="ip">تّسَلٌنِكِ دَنشَنِيَتْييٍ قِندِشِ مِسَالِ نَن نَ وٌن بّ بَرِ مَ هَلِ عٍ تٌ حَشَنكَتّ فبٍفبٍ سْتْ، عٍ شَن نّ دَنشَنِيَ كُي، عٍ عٍ شَشِلِ تِ عَلَ رَ. عَلَ شَ وٌن مَلِ وٌن مَ دَنشَنِيَ شَ تِلِن، وٌن شَ وٌن تُننَبّشِ عَلَ شَ كِرَ قَنيِ شْن مَ. عَلَ شَ وٌن نَتَنفَ سّنِيّنتَرٍحَ مَ، وٌن نَشَ قَ يَافِ مَرِفِ فبِلٍن لْشْي. عَلَ شَ وٌن مَلِ عَرِيَننَ كِرَ شْن مَ. عَمِنَ.</para>
  <para style="imte">عَلَ شَ مَسٍنيِ سِنفٍ</para>
  <para style="imte">عَننَبِ ثْلُ نَشَن سّبّ</para>
  <para style="imte">تّسَلٌنِكِ دَنشَنِيَتْي حَمَ مَ</para>
  <para style="cl">سٌرَ</para>
  <chapter number="1" style="c" sid="1TH 1"/>
  <para style="s">شّيبُي</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 1:1"/>ثْلُ، سِلِقَنُ، نُن تِمٌتٍ نَن يِ كِ، كَتَرَبِ بَبَ عَلَ نُن عَ شَ مِشِ سُفَندِشِ مَرِفِ عِسَ شَ دَنشَنِيَتْي حَمَ مَ نَشٍيٍ نَ تّسَلٌنِكِ.</para>
  <para style="p" vid="1TH 1:1">عَلَ شَ هِننّ نُن بْحّسَ قِ وٌ مَ.<verse eid="1TH 1:1"/></para>
  <para style="s">عَلَ تَنتُقٍ تّسَلٌنِكِكَيٍ شَ قٍ رَ</para>
  <para style="p">
    <verse number="2" style="v" sid="1TH 1:2"/>وَشَتِ بِرِن مُشُ عَلَ تَنتُمَ وٌ شَ قٍ رَ، مُشُ مَن عَ مَشَندِ مَ وٌ بّ. تّمُي بِرِن <verse eid="1TH 1:2"/><verse number="3" style="v" sid="1TH 1:3"/>مُشُ وٌ شَ قٍ قَلَمَ وٌن بَبَ عَلَ بّ. مُشُ عَ تَنتُمَ نّ وٌ شَ وَلِ مَ نَشَن كٍلِشِ وٌ شَ دَنشَنِيَ نُن وٌ شَ شَنُنتٍيَ مَ. مُشُ عَ تَنتُمَ نّ بَرِ مَ وٌ وٌ تُننَبّشِشِ وٌ شَشِلِ تِقٍ رَ عَلَ شَ مِشِ سُفَندِشِ مَرِفِ عِسَ رَ.<verse eid="1TH 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1TH 1:4"/>ﭑ نفَشَكٍرٍنيِيٍ، وٌ تَن عَلَ شَنُنتٍنيِيٍ، مُشُ عَ كٌلٌن عَ عَلَ بَرَ وٌ سُفَندِ. <verse eid="1TH 1:4"/><verse number="5" style="v" sid="1TH 1:5"/>مُشُ تٌ شِبَارُ قَنيِ مَسٍن وٌ بّ، عَ مُ قِندِ مُشُ دّ وْيّنيِ فبَنسَن شَ رَ. عَلَ شَشِلِ سّنِيّنشِ نَشَ سّنبّ قِ مُشُ شَ شِبَارُ قَنيِ كَوَندِقٍ مَ، مُشُ دَنشَنِيَشِ عَ مَ. وٌ عَ كٌلٌن يَتِ مُشُ نُ حّرّ مَ كِ نَشّ وٌ شَ قٍ رَ، مُشُ نُ نَ وٌ يَ مَ تّمُي نَشّ. <verse eid="1TH 1:5"/><verse number="6" style="v" sid="1TH 1:6"/>وٌ بَرَ قِندِ مُشُ نُن مَرِفِ قْشِ رَبَيٍ رَ. هَلِ وٌ تٌ حَشَنكَتّ فبٍفبٍ سْتْ، وٌ عَلَ شَ مَسٍنيِ سُشُ نّ حّلّشِنيِ رَ، حّلّشِنيِ نَشَن قَتَن عَلَ شَشِلِ سّنِيّنشِ رَ.<verse eid="1TH 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1TH 1:7"/>نَ كُي، وٌ بَرَ قِندِ مِسَالِ رَ دَنشَنِيَتْي بِرِن بّ نَشٍيٍ نَ مَسٍدٌن نُن عَكَيِ. <verse eid="1TH 1:7"/><verse number="8" style="v" sid="1TH 1:8"/>عَلَ شَ مَسٍنيِ بَرَ رَيٍنسٍن يّ وٌ سَابُي رَ. عَ مُ رَيٍنسٍنشِ مَسٍدٌن نُن عَكَيِ فبَنسَن شَ مَ. يِرٍ بِرِن بَرَ عَ كٌلٌن وٌ دَنشَنِيَشِ عَلَ مَ كِ نَشّ. نَ كُي، مُشُ مُ سٍسٍ قَلَمَ سْنْن نَ شَ قٍ رَ. <verse eid="1TH 1:8"/><verse number="9" style="v" sid="1TH 1:9"/>نَ مِشِ نَشٍيٍ بَرَ وٌ شَ قٍ مّ، عٍ تَن نَن قَمَ وٌ شَ قٍ قَلَدٍ، وٌ مُشُ رَ سّنّ كِ نَشّ، وٌ مَن فبِلٍن كُيٍيٍ قْشْ رَ كِ نَشّ، وٌ قَ بِرَ عَلَ حِحّ قْشْ رَ نَشَن قِندِشِ نْندِ رَ. <verse eid="1TH 1:9"/><verse number="10" style="v" sid="1TH 1:10"/>عٍ مَن وٌ شَ قٍ قَلَمَ، وٌ عَلَ شَ دِ مَمّشِ كِ نَشّ كٍلِقٍ كٌورٍ مَ. نَ نَن قِندِشِ عِسَ رَ، عَلَ نَشَن نَكٍلِ قَشّ مَ، عِسَ نَشَن وٌن نَتَنفَمَ شْنّ مَ نَشَن نَ قَقٍ.<verse eid="1TH 1:10"/></para>
  <chapter eid="1TH 1"/>
  <chapter number="2" style="c" sid="1TH 2"/>
  <para style="s">ثْلُ نُن تّسَلٌنِكِ دَنشَنِيَتْي حَمَ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 2:1"/>ﭑ نفَشَكٍرٍنيِيٍ، وٌ تَن يَتِ عَ كٌلٌن عَ مُشُ قَقٍ وٌ يِرٍ نَ مُ قِندِشِ قٍ قُقَقُ رَ. <verse eid="1TH 2:1"/><verse number="2" style="v" sid="1TH 2:2"/>وٌ عَ كٌلٌن، مُشُ نُ بَرَ حَشَنكَتّ نُن تْورّ سْتْ قِلِثِ. كْنْ مُشُ نَشَ مُشُ شَشِلِ تِ وٌن مَرِفِ عَلَ رَ، مُشُ لِمَنِيَ عَلَكٌ مُشُ شَ وٌ كَوَندِ عَلَ شَ شِبَارُ قَنيِ رَ، هَلِ فٍرٍ مَسٌي فبٍفبٍ تٌ نُ نَا. <verse eid="1TH 2:2"/><verse number="3" style="v" sid="1TH 2:3"/>مُشُ شَ كَوَندِ مُ قَتَنشِ وُلٍ شَ رَ، عَ مُ قَتَنشِ حَنِفٍ سّنِيّنتَرٍ شَ رَ، عَ مُ قَتَنشِ يَنقَنتٍيَ شَ رَ. <verse eid="1TH 2:3"/><verse number="4" style="v" sid="1TH 2:4"/>عَلَ تٌ بَرَ مُشُ مَتٌ، عَ بَرَ عَ شَ شِبَارُ قَنيِ تَشُ مُشُ رَ. نَ كُي، مُشُ مُ وْيّنمَ شّ دٍ عَلَكٌ مُشُ شَ رَقَن مِشِيٍ مَ. مُشُ وْيّنمَ نّ عَلَكٌ مُشُ شَ عَلَ نَن كّنّن نَشَن وٌن سٌندٌنيِيٍ مَتٌمَ. <verse eid="1TH 2:4"/><verse number="5" style="v" sid="1TH 2:5"/>وٌ عَ كٌلٌن يَتِ، عَلَ قَن عَ كٌلٌن، مُشُ مُ دّءِحْشُنيِ وْيّنيِ يٌ قَلَشِ وٌ بّ. مُشُ مُ كَوَندِ تِشِ شّ عَلَكٌ مُشُ شَ سٍ ندٍ سْتْ. <verse eid="1TH 2:5"/><verse number="6" style="v" sid="1TH 2:6"/>مُشُ هَيِ مُ نَ مِشِيٍ شَ مَتْشْي مَ، عَ نَ قِندِ وٌ تَن نَ، عَ نَ قِندِ مِشِ فبّتّيٍ رَ.<verse eid="1TH 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1TH 2:7"/>عَلَ شَ مِشِ سُفَندِشِ شَ شّيرَيٍ تٌ نَ مُشُ رَ، مُشُ نُ نْمَ مُشُ شَ قٍ كٌتٍ دْشْدٍ وٌ شُن مَ، كْنْ مُشُ مُ تِن. مُشُ نَشَ مّينِ وٌ مَ، عَلْ دِنفّ مّينِمَ عَ شَ دِيٍ مَ كِ نَشّ. <verse eid="1TH 2:7"/><verse number="8" style="v" sid="1TH 2:8"/>مُشُ وٌ شَنُشِ نّ هَن مُشُ نَشَ مُشُ يّتّ يَتِ قِ وٌ مَ سَقٍ عَلَ شَ شِبَارُ قَنيِ شُن مَ مُشُ وٌ كَوَندِ نَشَن نَ. وٌ شَ قٍ نُ بَرَ شْرْشْ مُشُ مَ كِ قَنيِ. <verse eid="1TH 2:8"/><verse number="9" style="v" sid="1TH 2:9"/>ﭑ نفَشَكٍرٍنيِيٍ، وٌ شَ وٌ مَحْشُن مُشُ شَ وَلِ نُن مُشُ شَ تْورّ مَ. مُشُ وَكِلِ نّ كْي نُن يَنيِ عَلَكٌ مُشُ شَ كْنتْقِلِ نَشَ لُ وٌ سٍسٍ مَ، مُشُ نُ عَلَ شَ شِبَارُ قَنيِ كَوَندِقٍ وٌ بّ تّمُي نَشّ. <verse eid="1TH 2:9"/><verse number="10" style="v" sid="1TH 2:10"/>مُشُ حّرّشِ سّنِيّنيِ نُن تِنشِنيِ نَن نَ وٌ شَ قٍ رَ، مَرَكْرْ سِ يٌ مُ نَ مُشُ مَ. وٌ بَرَ قِندِ نَ قٍ سٍيدٍيٍ رَ، وٌ نُن عَلَ. <verse eid="1TH 2:10"/><verse number="11" style="v" sid="1TH 2:11"/>وٌ عَ كٌلٌن يَتِ، عَ مُشُ نَ وٌ بِرِن بّ، عَلْ بَبّ نُن عَ شَ دِيٍ نَ كِ نَشّ. <verse eid="1TH 2:11"/><verse number="12" style="v" sid="1TH 2:12"/>مُشُ بَرَ وٌ رَلِمَنِيَ، مُشُ بَرَ وٌ مَقُرُكُ، مُشُ بَرَ وٌ مَيَندِ عَلَكٌ وٌ حّرّ كِ شَ عَلَ كّنّن، نَشَن وٌ شِلِشِ وٌ شَ لُ عَ شَ مَنفّيَ نِينِ بُن مَ، وٌ شَ عَ شَ نْرّ كٌلٌن.<verse eid="1TH 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 2:13"/>نَ نَن عَ تٌشِ مُشُ عَلَ نُوَلِ سَمَ تّمُي بِرِن بَرِ مَ مُشُ تٌ وٌ كَوَندِ عَلَ شَ مَسٍنيِ رَ، وٌ مُ عَ سُشُشِ شّ عَلْ مِشِ وْيّن شُي. وٌ عَ كٌلٌن نّ عَ عَ قِندِشِ عَلَ شَ مَسٍنيِ نَن يَتِ رَ نَشَن سّنبّ نَ وَلِقٍ وٌ تَن دَنشَنِيَتْييٍ يَ مَ. <verse eid="1TH 2:13"/><verse number="14" style="v" sid="1TH 2:14"/>ﭑ نفَشَكٍرٍنيِيٍ، وٌ بَرَ مَنِيَ عَلَ شَ دَنشَنِيَتْي حَمَيٍ رَ نَشٍيٍ دَنشَنِيَشِ عَ شَ مِشِ سُفَندِشِ عِسَ مَ يُدَيَ بْشِ مَ. وٌ بَرِبٌورٍيٍ وٌ تْورْ كِ نَشّ، يُوِقِيٍ قَن يُدَيَ دَنشَنِيَتْي حَمَيٍ تْورْ نَ كِ نّ. <verse eid="1TH 2:14"/><verse number="15" style="v" sid="1TH 2:15"/>عٍ تَن يُوِقِيٍ نَن مَرِفِ عِسَ نُن نَمِحْنمّيٍ قَشَ، عٍ مُشُ قَن حَشَنكَتَ. عٍ شَ قٍ مُ عَلَ كّنّنشِ. عٍ تٌ مُشُ تْورْ مَ مُشُ شَ كَوَندِ وَلِ كُي، عٍ حَاشُمَ مِشِ بِرِن نَ. <verse eid="1TH 2:15"/><verse number="16" style="v" sid="1TH 2:16"/>عٍ مُ وَ مَ مُشُ شَ سِ فبّتّيٍ كَوَندِ عَلَكٌ نٍيٍ شَ كِسِ. نَ كُي، عٍ نَ عٍ شَ يُنُبِ نَن تُن شُن مَسَقٍ. كْنْ عَلَ شَ شْنّ بَرَ عٍ سُشُ.<verse eid="1TH 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1TH 2:17"/>ﭑ نفَشَكٍرٍنيِيٍ، مُشُ بَرَ مَكُيَ وٌ يَ تٌدٍ رَ وَشَتِ ندٍ بُن، كْنْ مُشُ بْحّ تَن مُ مَكُيَشِ وٌ رَ. وٌ شْلِ مُشُ سُشُمَ كِ قَنيِ رَ. مُشُ بَرَ قٍ بِرِن نَبَ عَلَكٌ مُشُ مَن شَ وٌ تٌ. <verse eid="1TH 2:17"/><verse number="18" style="v" sid="1TH 2:18"/>مُشُ نُ بَرَ وَ فبِلٍنقٍ وٌ يِرٍ. ﭑ تَن ثْلُ وَ نّ ﭑ شَ وٌ يِرٍ لِ سَنمَيَ وُيَشِ، كْنْ سٍنتَنّ نَن مُشُ مَتْورْ. <verse eid="1TH 2:18"/><verse number="19" style="v" sid="1TH 2:19"/>مَرِفِ عِسَ فبِلٍن لْشْي، مُشُ حْشْ تِمَ عَلَ رَ ندٍ شَ قٍ رَ؟ مُشُ حّلّشِنمَ ندٍ شَ قٍ رَ؟ مُشُ مَتْشْي سْتْمَ ندٍ شَ قٍ رَ؟ وٌ تَن شَ مُ عَ رَ؟ <verse eid="1TH 2:19"/><verse number="20" style="v" sid="1TH 2:20"/>عِيٌ، وٌ تَن نَن قِندِشِ مُشُ شَ شُننَكٍلِ نُن مُشُ شَ سّيوّ رَ.<verse eid="1TH 2:20"/></para>
  <chapter eid="1TH 2"/>
  <chapter number="3" style="c" sid="1TH 3"/>
  <para style="s">ثْلُ تِمٌتٍ شّيقٍ تّسَلٌنِكِ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 3:1"/>نَ كُي، مُشُ بْحّ تٌ مُ نْشِ سَدٍ، مُشُ بَرَ عَ حَنِفٍ مُشُ تَن شَ لُ عَتّن، <verse eid="1TH 3:1"/><verse number="2" style="v" sid="1TH 3:2"/>مُشُ شَ وٌن نفَشَكٍرٍنيِ تِمٌتٍ شّي وٌ مَ. مُشُ وَلِبٌورٍ نَ عَ رَ عَلَ شَ وَلِ كُي نَشَن قِندِ عَلَ شَ مِشِ سُفَندِشِ شَ شِبَارُ قَنيِ كَوَندِلَ رَ. مُشُ عَ شّيشِ نّ عَلَكٌ عَ شَ وٌ سّنبّ سٌ، عَ شَ وٌ رَلِمَنِيَ وٌ شَ دَنشَنِيَ كُي، <verse eid="1TH 3:2"/><verse number="3" style="v" sid="1TH 3:3"/>عَلَكٌ وٌ شَ حَشَنكَتّ نَشَ وٌ هَنمّ. وٌ قَن يَتِ عَ كٌلٌن، نَ حَشَنكَتّ نَن نَفِرِشِ وٌن مَ. <verse eid="1TH 3:3"/><verse number="4" style="v" sid="1TH 3:4"/>هَلِ مُشُ نُ نَ وٌ يَ مَ تّمُي نَشّ، مُشُ نُ عَ قَلَمَ نّ وٌ بّ، عَ مِشِيٍ قَمَ وٌن حَشَنكَتَدٍ. وٌ بَرَ عَ تٌ قَ، نَ نَن قَ رَبَشِ.<verse eid="1TH 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1TH 3:5"/>نَ نَن عَ رَ، ﭑ بْحّ تٌ مُ نُ سَشِ سْنْن، ﭑ نَشَ تِمٌتٍ شّي نَا عَلَكٌ عَ شَ عَ كٌلٌن وٌ شَ دَنشَنِيَ نَ كِ نَشّ. ﭑ نُ فَاشُشِ نّ وٌ بّ سٍنتَنّ مِشِ رَتَنتَنيِ قَ وٌ رَتَنتَنقٍ، مُشُ شَ وَلِ قَ قِندِ وَلِ قُقَقُ رَ. <verse eid="1TH 3:5"/><verse number="6" style="v" sid="1TH 3:6"/>كْنْ تِمٌتٍ تٌ بَشِ فبِلٍندٍ مُشُ يِرٍ كٍلِ وٌ شْنيِ، عَ بَرَ شِبَارُ قَنيِ قَلَ مُشُ بّ وٌ شَ دَنشَنِيَ نُن وٌ شَ شَنُنتٍيَ شَ قٍ رَ. عَ نَشّ، عَ وٌ رَتُشِ مُشُ شَ قٍ رَ سّيوّ كُي، عَ مُشُ تٌ شْلِ نَ وٌ مَ، عَلْ وٌ قَن تٌ شْلِ تٌ نَ مُشُ قَن مَ. <verse eid="1TH 3:6"/><verse number="7" style="v" sid="1TH 3:7"/>نَ كُي، ﭑ نفَشَكٍرٍنيِيٍ، هَلِ مُشُ تٌ نَ تْورّ نُن حَشَنكَتّ كُي، مُشُ بَرَ رَلِمَنِيَ وٌ شَ دَنشَنِيَ شَ قٍ رَ. <verse eid="1TH 3:7"/><verse number="8" style="v" sid="1TH 3:8"/>يَكْسِ مُشُ بْحّ بَرَ سَ سْنْن، بَرِ مَ مُشُ بَرَ عَ كٌلٌن عَ وٌ شَ دَنشَنِيَ شَنشِ مَرِفِ. <verse eid="1TH 3:8"/><verse number="9" style="v" sid="1TH 3:9"/>مُشُ مُ عَ كٌلٌن سْنْن مُشُ نْمَ عَلَ تَنتُدٍ كِ نَشّ وٌ شَ قٍ رَ. دَنيِ يٌ مُ نَ مُشُ شَ سّيوّ مَ وٌ شَ قٍ رَ عَلَ شَ قٍ رَ. <verse eid="1TH 3:9"/><verse number="10" style="v" sid="1TH 3:10"/>كْي نُن يَنيِ مُشُ نَ عَ مَشَندِقٍ مُشُ نِي بِرِن نَ، مُشُ شَ نْ وٌ تٌدٍ، عَلَكٌ نَشَن لُشِ وٌ شَ دَنشَنِيَ رَ، مُشُ شَ نَ رَكَمَلِ.<verse eid="1TH 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1TH 3:11"/>عَلَ يّتّ يَتِ، وٌن بَبَ، عَ نُن وٌن مَرِفِ عِسَ شَ كِرَ بْو مُشُ بّ عَلَكٌ مُشُ شَ وٌ يِرٍ مَسْتْ. <verse eid="1TH 3:11"/><verse number="12" style="v" sid="1TH 3:12"/>شَنُنتٍيَ نَشَن نَ وٌ بّ وٌ دٌرٌ تَفِ، عَ نُن وٌ نُن مِشِ بِرِن تَفِ، عَلَ شَ نَ شُن مَسَ كِ قَنيِ رَ، عَلْ مُشُ قَن وٌ شَنُشِ كِ نَشّ. <verse eid="1TH 3:12"/><verse number="13" style="v" sid="1TH 3:13"/>عَلَ شَ وٌ سٌندٌنيِيٍ سّنبّ سٌ عَلَكٌ وٌن مَرِفِ عِسَ نَ فبِلٍن لْشْ نَشّ عَ نُن عَ شَ سّنِيّنتْييٍ رَ، وٌ شَ نْ تِدٍ وٌن بَبَ عَلَ يَ عِ سّنِيّنيِ نُن تِنشِنيِ كُي.<verse eid="1TH 3:13"/></para>
  <chapter eid="1TH 3"/>
  <chapter number="4" style="c" sid="1TH 4"/>
  <para style="s">حّرّقٍ سّنِيّنيِ كُي</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 4:1"/>ﭑ نفَشَكٍرٍنيِيٍ، مُشُ بَرَ وٌ تِنكَن وٌ لَن وٌ شَ وٌ حّرّ كِ نَشّ عَلَ وَشْنيِ مَ. هَن يَ وٌ نَ نَ نَن شُن مَ. يَكْسِ، مُشُ وٌ مَشَندِ مَ، مُشُ وٌ مَيَندِ مَرِفِ عِسَ شِلِ رَ، وٌ شَ نُ نَ شُن مَسَ. <verse eid="1TH 4:1"/><verse number="2" style="v" sid="1TH 4:2"/>وٌ عَ كٌلٌن يَتِ مُشُ وٌ شَرَنشِ نَشَن نَ مَرِفِ عِسَ شِلِ رَ. <verse eid="1TH 4:2"/><verse number="3" style="v" sid="1TH 4:3"/>عَلَ سَفٌ نَ عَ رَ وٌ شَ سّنِيّن. وٌ نَشَ لَنفٌيحَ رَبَ. <verse eid="1TH 4:3"/><verse number="4" style="v" sid="1TH 4:4"/>كَنكَن شَ عَ يّتّ سُشُ سّنِيّنيِ نُن تِنشِنيِ كُي. <verse eid="1TH 4:4"/><verse number="5" style="v" sid="1TH 4:5"/>وٌ نَشَ بِرَ لَنفٌيحَ قْشْ رَ، عَلْ عَلَ كٌلٌنتَرٍيٍ عَ رَبَمَ كِ نَشّ. <verse eid="1TH 4:5"/><verse number="6" style="v" sid="1TH 4:6"/>مِشِ يٌ نَشَ يُنُبِ رَبَ عَ نفَشَكٍرٍنيِ رَ، عَ قُ عَ مَ نَ قٍ كُي، بَرِ مَ مَرِفِ نَ قٍ مْولِ بِرِن مَكِيتِمَ نّ. مُشُ بَرَ نَ قَلَ وٌ بّ، مُشُ مَن فبِلٍن نّ عَ قَلَ رَ وٌ بّ. <verse eid="1TH 4:6"/><verse number="7" style="v" sid="1TH 4:7"/>عَلَ وٌن شِلِشِ نّ وٌن شَ وٌن حّرّ سّنِيّنيِ كُي، وٌن شَ فبِلٍن سّنِيّنتَرٍحَ قْشْ رَ. <verse eid="1TH 4:7"/><verse number="8" style="v" sid="1TH 4:8"/>نَ كُي، مِشِ نَشَن تٌندِ مَ يِ قٍيٍ رَبَتُدٍ، عَ مُ تٌندِشِ عِبُنَدَ مَ شَ بّ، عَ تٌندِشِ عَلَ نَن بّ نَشَن عَ شَشِلِ سّنِيّنشِ قِشِ وٌ مَ.<verse eid="1TH 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 4:9"/>هَلِ مُشُ مُ وٌ رَ سِ نفَشَكٍرٍنيِيٍ شَنُقٍ مَ، بَرِ مَ عَلَ نَن بَرَ وٌ تِنكَن وٌ شَ وٌ بٌرٍ شَنُ. <verse eid="1TH 4:9"/><verse number="10" style="v" sid="1TH 4:10"/>وٌ نَ نَن يَتِ رَبَقٍ نفَشَكٍرٍنيِيٍ رَ نَشٍيٍ نَ مَسٍدٌن بْشِ بِرِن كُي. كْنْ مُشُ عَ قَلَمَ نّ وٌ بّ، ﭑ نفَشَكٍرٍنيِيٍ، وٌ مَن شَ نُ نَ شُن مَسَ. <verse eid="1TH 4:10"/><verse number="11" style="v" sid="1TH 4:11"/>وٌ شَ قٍ بِرِن نَبَ عَلَكٌ وٌ شَ لُ بْحّسَ كُي. وٌ شَ مّينِ وٌ يّتّ مَ. وٌ شَ نُ وَلِ وٌ بّلّشّ رَ عَلْ مُشُ عَ مَسٍن وٌ بّ كِ نَشّ. <verse eid="1TH 4:11"/><verse number="12" style="v" sid="1TH 4:12"/>نَ كُي، وٌ حّرّ كِ قِندِ مَ عَ قَنيِ نَن نَ دَنشَنِيَتَرٍيٍ تَفِ، وٌ مَن مُ وٌ شَ قٍ كٌتٍ دْشْمَ مِشِ فبّتّ يٌ شُن مَ.<verse eid="1TH 4:12"/></para>
  <para style="s">دَنشَنِيَتْييٍ شَ تَا مَسَرّ</para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 4:13"/>ﭑ نفَشَكٍرٍنيِيٍ، مُشُ مُ وَ مَ وٌ شَ لُ قَهَامُتَرٍحَ كُي مِشِيٍ شَ قٍ رَ نَشٍيٍ بَرَ لَاشِرَ. عَ مُ لَن وٌ شَ سُننُن عَلْ مِشِ نَشٍيٍ مُ عٍ شَشِلِ تِشِ عَلَ رَ. <verse eid="1TH 4:13"/><verse number="14" style="v" sid="1TH 4:14"/>وٌن لَشِ عَ رَ عَ عِسَ بَرَ قَشَ، عَ مَن قَ كٍلِ قَشّ مَ. نَ كُي، وٌن مَن لَشِ عَ رَ عَ عَلَ قَمَ قَشَمِشِيٍ قَن نَكٍلِدٍ نَشٍيٍ نُ دَنشَنِيَشِ عِسَ مَ، عَ عٍ رَتٍ عٍ نُن عِسَ. <verse eid="1TH 4:14"/><verse number="15" style="v" sid="1TH 4:15"/>مَرِفِ شَ مَسٍنيِ نَن يَ، مُشُ نَشَن قَلَمَ وٌ بّ؛ وٌن تَن نَشٍيٍ حِحّ عَ رَ، مَرِفِ قَ تّمُي نَشٍيٍ لِمَ دُنِحَ مَ، وٌن سِنفٍ شَ مُ تٍمَ مِشِ قَشَشِيٍ بّ. <verse eid="1TH 4:15"/><verse number="16" style="v" sid="1TH 4:16"/>مَرِفِ يّتّ يَتِ نَن قَمَ فٌرٌدٍ كٍلِ كٌورٍ مَ. يَامَرِ قِمَ نّ شُي عِتٍشِ رَ. مَلٍكّ كُنتِفِ قَمَ نّ عَ شُي عِتٍدٍ. عَلَ شَ سَرَ شُي مِنِمَ نّ. عِسَ شَ دَنشَنِيَتْي نَشٍيٍ بَرَ قَشَ، نٍيٍ نَن سِنفٍ كٍلِمَ. <verse eid="1TH 4:16"/><verse number="17" style="v" sid="1TH 4:17"/>نَ دَنفِ شَنبِ، وٌن تَن نَشٍيٍ حِحّ لُشِ دُنِحَ، وٌن قَن تٍمَ نّ، وٌن نٍيٍ لِ نُشُي كُي، وٌن بِرِن سَ نَرَلَن مَرِفِ يِرٍ كُيٍ مَ. وٌن لُمَ نّ مَرِفِ سّيتِ مَ سْنْن عَبَدَن. <verse eid="1TH 4:17"/><verse number="18" style="v" sid="1TH 4:18"/>نَ كُي، وٌ شَ وٌ بٌرٍ رَلِمَنِيَ نَ مَسٍنيِ رَ.<verse eid="1TH 4:18"/></para>
  <chapter eid="1TH 4"/>
  <chapter number="5" style="c" sid="1TH 5"/>
  <para style="s">مَرِفِ قَ لْشْي</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 5:1"/>ﭑ نفَشَكٍرٍنيِيٍ، هَلِ ﭑ مُ سٍسٍ قَلَ وٌ بّ وَشَتِ نُن لْشْييٍ شَ قٍ رَ يِ قٍيٍ سَ رَبَمَ تّمُي نَشّ. <verse eid="1TH 5:1"/><verse number="2" style="v" sid="1TH 5:2"/>وٌ قَن يَتِ عَ كٌلٌن عَ قَنيِ رَ، عَ مَرِفِ شَ لْشْي قَمَ نّ عَلْ مُحّتِ قَمَ كْي رَ كِ نَشّ. <verse eid="1TH 5:2"/><verse number="3" style="v" sid="1TH 5:3"/>مِشِيٍ نّ لَنيِ نُن بْحّسَ شَ قٍ قَلَمَ تّمُي نَشّ، فبَلٌي دُ سُمَ عٍ شُن مَ نَ تّمُي نّ، عَلْ قُرُفِنّ دِقُرِ نَ كٍلِ عَ رَ. عٍ مُ تَنفَمَ عَ مَ مُكُ.<verse eid="1TH 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1TH 5:4"/>كْنْ وٌ تَن، نفَشَكٍرٍنيِيٍ، وٌ مُ نَ دِ مِ شَ كُي. نَ لْشْي مُ لَنمَ عَ شَ وٌ تّرّننَ عَلْ مُحّتِ. <verse eid="1TH 5:4"/><verse number="5" style="v" sid="1TH 5:5"/>وٌ بِرِن قِندِشِ نَءِيَلَنيِ نُن يَنيِ دِيٍ نَن نَ. كْي نُن دِ مِ دِيٍ شَ مُ وٌن نَ. <verse eid="1TH 5:5"/><verse number="6" style="v" sid="1TH 5:6"/>نَ كُي، وٌن نَشَ شِ عَلْ بٌورٍيٍ. وٌن شَ قٍيٍ رَ سَشَ عَ قَنيِ رَ، وٌن نَشَ يَنقَ. <verse eid="1TH 5:6"/><verse number="7" style="v" sid="1TH 5:7"/>نَشٍيٍ شِمَ، عٍ شِمَ كْي نَن نَ. نَشٍيٍ سِيسِمَ، عٍ سِيسِمَ كْي نَن نَ. <verse eid="1TH 5:7"/><verse number="8" style="v" sid="1TH 5:8"/>وٌن تَن نَشٍيٍ قِندِشِ يَنيِ مِشِيٍ رَ، وٌن شَ مّينِ وٌن يّتّ مَ. وٌن شَ دَنشَنِيَ نُن شَنُنتٍيَ رَ سَبَتِ، وٌن شَ وٌن شَشِلِ تِ كِسِ رَ. نٍيٍ تِدٍ لُمَ نّ وٌن بّ عَلْ كَنكٍ مَكَنتَسٍ نُن شُن مَكَنتَسٍ تِدٍ لُمَ فٍرٍ سٌي بّ كِ نَشّ. <verse eid="1TH 5:8"/><verse number="9" style="v" sid="1TH 5:9"/>عَلَ مُ عَ رَفِرِشِ وٌن مَ، عَ شَ شْنّ شَ وٌن لِ. عَ عَ رَفِرِشِ نّ وٌن تَن شَ كِسِ نَن سْتْ مَرِفِ عِسَ سَابُي رَ، عَلَ شَ مِشِ سُفَندِشِ <verse eid="1TH 5:9"/><verse number="10" style="v" sid="1TH 5:10"/>نَشَن قَشَ وٌن مَ قٍ رَ. نَ نَن عَ تٌشِ، شَ مُشُ حِحّ نَن عَ رَ، شَ مُشُ قَشَشِ نَن عَ رَ، مُشُ قَمَ نّ سَبَتِدٍ عَ عِ. <verse eid="1TH 5:10"/><verse number="11" style="v" sid="1TH 5:11"/>نَ كُي، وٌ شَ وٌ بٌرٍ رَلِمَنِيَ، وٌ شَ وٌ بٌرٍ سّنبّ سٌ عَلْ وٌ دَرِشِ عَ رَبَ رَ كِ نَشّ.<verse eid="1TH 5:11"/></para>
  <para style="s">مَرَ سِ نُن شّيبُي دْنشْي</para>
  <para style="p">
    <verse number="12" style="v" sid="1TH 5:12"/>ﭑ نفَشَكٍرٍنيِيٍ، مُشُ بَرَ وٌ مَيَندِ وٌ شَ مِشِيٍ بِنيَ نَشٍيٍ نَ وَلِقٍ وٌ تَفِ، وٌ رَ سِقٍ نُن وٌ رَحّرّقٍ رَ مَرِفِ شَ قٍ كُي. <verse eid="1TH 5:12"/><verse number="13" style="v" sid="1TH 5:13"/>وٌ شَ عٍ بِنيَ عَ قَنيِ رَ شَنُنتٍيَ كُي عٍ شَ وَلِ شَ قٍ رَ.</para>
  <para style="p" vid="1TH 5:13">لَنيِ نَن شَ لُ وٌ شَ دَنشَنِيَتْي حَمَ تَفِ.<verse eid="1TH 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1TH 5:14"/>ﭑ نفَشَكٍرٍنيِيٍ، مُشُ مَن بَرَ وٌ مَشَندِ، وٌ شَ تُننَشْنّيٍ رَ سِ، وٌ شَ لِمَنِيَتَرٍيٍ رَلِمَنِيَ، وٌ شَ سّنبّتَرٍيٍ مَلِ، وٌ دِحّ مِشِ بِرِن بّ.<verse eid="1TH 5:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1TH 5:15"/>وٌ شَ عَ مَتٌ عَ قَنيِ رَ مِشِ يٌ نَشَ قٍ كٌبِ حْشْ قٍ كٌبِ رَ. وٌ شَ نُ قٍ قَنيِ نَن تُن نَبَ وٌ بٌرٍ بّ، عَ نُن مِشِ بِرِن بّ.<verse eid="1TH 5:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="1TH 5:16"/>وٌ شَ سّيوَ تّمُي بِرِن.<verse eid="1TH 5:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="1TH 5:17"/>وٌ شَ عَلَ مَشَندِ وَشَتِ بِرِن.<verse eid="1TH 5:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="1TH 5:18"/>وٌ شَ عَلَ تَنتُ قٍ بِرِن كُي. نَ قِندِشِ عَلَ سَفٌ نَن نَ وٌ بّ، وٌ تَن نَشٍيٍ دَنشَنِيَشِ عَ شَ مِشِ سُفَندِشِ عِسَ مَ.<verse eid="1TH 5:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="1TH 5:19"/>وٌ نَشَ عَلَ شَشِلِ سّنِيّنشِ شْلْن نَفٌرٌ.<verse eid="1TH 5:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="1TH 5:20"/>وٌ نَشَ وٌ تُلِ شْرْشْ نَمِحْنمّيٍ شَ مَسٍنيِيٍ مَ،<verse eid="1TH 5:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="1TH 5:21"/>كْنْ وٌ شَ قٍ بِرِن مَتٌ عَ قَنيِ رَ.</para>
  <para style="q" vid="1TH 5:21">شَ قٍقٍ قَن، وٌ شَ نَ سُشُ فبٍن.<verse eid="1TH 5:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="1TH 5:22"/>شَ قٍقٍ كٌبِ، وٌ شَ وٌ مَكُيَ نَ رَ ثٌن!<verse eid="1TH 5:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1TH 5:23"/>عَلَ شَ وٌ رَ سّنِيّن عَ كِ نُن عَ كّحَ مَ، عَ تَن عَلَ نَشَن بْحّسَ قِمَ. عَلَ شَ وٌ شَشِلِ نُن وٌ نِي نُن وٌ قَتٍ رَتَنفَ، مَرَكْرْ سِ يٌ نَشَ لُ وٌ مَ وٌن مَرِفِ عِسَ قَ تّمُي. <verse eid="1TH 5:23"/><verse number="24" style="v" sid="1TH 5:24"/>نَشَن وٌ شِلِشِ، عَ نَ عَ شُي شَنبِ رَ، عَ قَمَ نّ عَ رَبَدٍ.<verse eid="1TH 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1TH 5:25"/>ﭑ نفَشَكٍرٍنيِيٍ، وٌ عَلَ مَشَندِ مُشُ بّ. <verse eid="1TH 5:25"/><verse number="26" style="v" sid="1TH 5:26"/>وٌ شَ نفَشَكٍرٍنيِيٍ بِرِن شّيبُ سُنبُي سّنِيّنشِ رَ. <verse eid="1TH 5:26"/><verse number="27" style="v" sid="1TH 5:27"/>ﭑ بَرَ وٌ يَمَرِ مَرِفِ شِلِ رَ وٌ شَ يِ بَتَاشّ شَرَن نفَشَكٍرٍنيِيٍ بِرِن بّ.<verse eid="1TH 5:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1TH 5:28"/>عَلَ شَ هِننّ قِ وٌ مَ وٌن مَرِفِ عِسَ سَابُي رَ، عَ شَ مِشِ سُفَندِشِ.<verse eid="1TH 5:28"/></para>
  <chapter eid="1TH 5"/>
</usx>
