<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2TI" style="id">Rough: OB, BW. Rework: Nov 02. Checked with team: Dec 02.</book>
  <para style="h">تِمٌتٍ عِِ</para>
  <para style="toc1">عَلَ شَ مَسٍنيِ قِرِن ندٍ عَننَبِ ثْلُ نَشَن سّبّ تِمٌتٍ مَ</para>
  <para style="toc2">تِمٌتٍ عِِ</para>
  <para style="mt">عَلَ شَ مَسٍنيِ قِرِن ندٍ</para>
  <para style="mt">عَننَبِ ثْلُ نَشَن سّبّ تِمٌتٍ مَ</para>
  <para style="imt">مَسٍنيِ ندٍ يِ كِتَابُي شَ قٍ رَ</para>
  <para style="ip">عَننَبِ ثْلُ تٌ نُ نَ فٍيلِ كُي رْ مَ، عَ نَشَ بَتَاشّ ندٍ قَن سّبّ عَ مَلِمَ تِمٌتٍ مَ. عَ حَن نُ بَرَ كٍرٍن سّبّ عَ مَ نُ، كْنْ عَ مَن نَشَ عَ قِرِن ندٍ سّبّ، عَلَكٌ عَ شَ فبِلٍن سّرِيّ ندٍيٍ مَ. عَننَبِ ثْلُ نُ بَرَ تْورْ عَ فبٍ رَ فٍيلِ كُي، مِشِ يٌ مُ نُ نَ عَ قّ مَ نَشَن نُ عَ مَلِمَ. عَ نَ بِرِن مَسٍنمَ يِ بَتَاشّ كُي، بَرِ مَ تِمٌتٍ نُ لُشِ نّ عَلْ ثْلُ شَ دِ.</para>
  <para style="ip">عَننَبِ ثْلُ نَشَ سّرِيّ قَلَ تِمٌتٍ بّ نَ بَتَاشّ سِنفٍ كُي نَشَن نُ نْمَ عَ مَلِدٍ دَنشَنِيَتْي حَمَ شَ وَلِ كُي. يِ بَتَاشّ كُي، عَ لُشِ عَلْ ثْلُ وَ مَ تِمٌتٍ رَلِمَنِيَقٍ عَ يّتّ شَ دَنشَنِيَ شَ قٍ رَ. ثْلُ عَ يّتّ شَ تْورّيٍ نُن عَ حّرّ كِ مَسٍنمَ عَ بّ، عَلَكٌ عٍ شَ قِندِ مِسَالِ رَ تِمٌتٍ بّ.</para>
  <para style="ip">عَننَبِ ثْلُ شَ بَتَاشّ قِرِن ندٍ كُي، عَ تِمٌتٍ رَتُمَ تِمٌتٍ دَنشَنِيَشِ كِ نَشّ، عَ نُن عَ عَلَ شَ وَلِ سُشُشِ كِ نَشّ. تِمٌتٍ كِتَابُي كٌلٌن عَ مَمَ نُن عَ نفَ نَن سَابُي رَ. نَ شَرَنيِ تِدٍ نُ فبٌ تِمٌتٍ بّ عَلَكٌ عَ شَ قِندِ عَلَ شَ وَلِكّ رَ عَ شَ دُنِحّءِفِرِ كُي.</para>
  <para style="ip">نَ كِتَابُي تِدٍ نُ فبٌ تِمٌتٍ بّ، عَ تِدٍ مَن نُ فبٌ مِشِيٍ بّ عَ نَشٍيٍ كَوَندِ. عَلَ شَ مَسٍنيِ نَشَن سّبّشِ كِتَابُي كُي عَ قِندِشِ لْننِ بٍلٍبٍلٍ نَن نَ، عَدَ مَدِ هَيِ نَ نَشَن مَ. شَ مِشِيٍ مُ بِرَ نَ قْشْ رَ، عٍ شَ دُنِحّءِفِرِ نُن عٍ شَ عَلِفِيَمَ مُ سْونّيَمَ عٍ بّ.</para>
  <para style="ip">عَننَبِ ثْلُ نَ قَن مَسٍنمَ يِ كِتَابُي كُي. عَ وَشَتِ دْنشْي شَ قٍيٍ قَلَمَ تِمٌتٍ بّ عَلَكٌ عَ شَ كَوَندِ تِ سّنبّ رَ، شَ نَ مُ عَ رَ مِشِيٍ لُمَ تَنتَنيِ نَن كُي نَشٍيٍ قَمَ عٍ رَلْيدٍ عَبَدَن. عَلَ شَ وٌن نَتَنفَ نَ مَ. عَلَ شَ لْننِ قَنيِ قِ وٌن قَن مَ عَلَكٌ يَرٍ شَ سْونّيَ وٌن بّ. عَمِنَ.</para>
  <para style="imte">عَلَ شَ مَسٍنيِ قِرِن ندٍ</para>
  <para style="imte">عَننَبِ ثْلُ نَشَن سّبّ تِمٌتٍ مَ</para>
  <para style="cl">سٌرَ</para>
  <chapter number="1" style="c" sid="2TI 1"/>
  <para style="s">لِمَنِيَ</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 1:1"/>ﭑ تَن ثْلُ نَن يِ كِ، نَشَن قِندِشِ عَلَ شَ مِشِ سُفَندِشِ عِسَ شَ شّيرَ رَ عَلَ وَشْنكِ. لَايِدِ تٌنفٌشِ وٌن بّ كِسِ شَ قٍ رَ عَلَ شَ مِشِ سُفَندِشِ عِسَ سَابُي نَن نَ. <verse eid="2TI 1:1"/><verse number="2" style="v" sid="2TI 1:2"/>ﭑ نَ يِ بَتَاشّ سّبّقٍ تِمٌتٍ نَن مَ، نَشَن قِندِشِ ﭑ مَ دِ مَشَنُشِ رَ. بَبَ عَلَ نُن وٌن مَرِفِ عِسَ، عَلَ شَ مِشِ سُفَندِشِ، عٍ شَ هِننّ، كِنِكِنِ، نُن بْحّسَ قِ عِ مَ.<verse eid="2TI 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 1:3"/>ﭑ بَرَ عَلَ تَنتُ، ﭑ نَشَن بَتُمَ حَنِفٍ قِيشّ رَ عَلْ ﭑ بٍنبَيٍ عَ رَبَشِ كِ نَشّ. ﭑ عَلَ مَشَندِ مَ نّ عِ بّ كْي نُن يَنيِ رَ، <verse eid="2TI 1:3"/><verse number="4" style="v" sid="2TI 1:4"/>بَرِ مَ ﭑ نَن ﭑ نَتُشِ عِ يَيٍ نَن مَ. ﭑ مَن نُ وَ مَ عِ تٌقٍ هَن، عَلَكٌ ﭑ شَ سّيوَ عَ قَنيِ رَ. <verse eid="2TI 1:4"/><verse number="5" style="v" sid="2TI 1:5"/>ﭑ مَن ﭑ نَتُشِ عِ شَ دَنشَنِيَ نَن مَ، قِلَنكَقُيحَ مُ نَ نَشَن كُي، نَشَن نُ نَ عِ مَمَ لٌوِ سِ قَن يِ رَ، عَ نُن عِ نفَ عٍوُنِسٍ. ﭑ عَ كٌلٌن عِ قَن دَنشَنِيَشِ نَ كِ نّ.<verse eid="2TI 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 1:6"/>نَ كُي، ﭑ بَرَ عِ رَلِمَنِيَ عِ شَ عَلَ سّنبّ رَوَلِ، عَ نَشَن قِشِ عِ مَ ﭑ تٌ ﭑ بّلّشّ سَ عِ شُنيِ مَ. <verse eid="2TI 1:6"/><verse number="7" style="v" sid="2TI 1:7"/>عَلَ مُ فَاشُ شَشِلِ شَ سٌشِ وٌن يِ رَ. عَ بَرَ شَشِلِ قِ وٌن مَ نَشَن قِندِشِ سّنبّ، شَنُنتٍيَ، نُن يّتّ سُشُي رَ. <verse eid="2TI 1:7"/><verse number="8" style="v" sid="2TI 1:8"/>عِ نَشَ يَافِ وٌن مَرِفِ شَ سٍيدٍحْشْيَ بَدٍ. عِ مَن نَشَ يَافِ ﭑ نَ، ﭑ تَن نَشَن نَ فٍيلِ كُي وٌن مَرِفِ شَ قٍ رَ. عَ لَنمَ وٌن بِرِن شَ تْورْ عِسَ شَ شِبَارُ قَنيِ شَ قٍ رَ عَلَ سّنبّ سَابُي رَ. <verse eid="2TI 1:8"/><verse number="9" style="v" sid="2TI 1:9"/>عَ تَن نَن وٌن نَكِسِشِ، عَ تَن نَن وٌن شِلِشِ عَ شَ سّنِيّنيِ مَ. عَ مُ نَ رَبَشِ وٌن مَ كّوَلِ سَابُي شَ رَ، عَ نَ حَنِفٍشِ عَ يّتّ نَن نَ. عَ هِننّشِ وٌن نَ عَ شَ مِشِ سُفَندِشِ عِسَ شَ قٍ نَن نَ كَقِ دُنِحَ قْلّ.<verse eid="2TI 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2TI 1:10"/>يَكْسِ وٌن بَرَ نَ هِننّ تٌ وٌن نَكِسِمَ عِسَ شَ قَ كُي، عَلَ شَ مِشِ سُفَندِشِ. عَ بَرَ قَشّ سّنبّ كَنَ، عَ كِسِ قٍ رَ مِنِ عَ شَ شِبَارُ قَنيِ سَابُي رَ، عَلَكٌ عَدَ مَ نَشَ قَشَ سْنْن. <verse eid="2TI 1:10"/><verse number="11" style="v" sid="2TI 1:11"/>عَلَ ﭑ قِندِشِ كَوَندِلَ، شّيرَ، نُن كَرَ مْشْ نَن نَ نَ شِبَارُ قَنيِ شَ قٍ رَ. <verse eid="2TI 1:11"/><verse number="12" style="v" sid="2TI 1:12"/>ﭑ نَ تْورْقٍ نَ وَلِ نَن شَ قٍ رَ، كْنْ ﭑ مُ يَافِمَ نَ رَ، بَرِ مَ ﭑ عَ كٌلٌن ﭑ دَنشَنِيَشِ نَشَن مَ. ﭑ بَرَ لَ عَ رَ عَ نْمَ ﭑ مَ كِسِ رَفَتَدٍ هَن نَ لْشْي. <verse eid="2TI 1:12"/><verse number="13" style="v" sid="2TI 1:13"/>ﭑ نْندِ نَشَن مَسٍنشِ عِ بّ، نَ شَ قِندِ عِ شَ مِسَالِ رَ، عِ بِرَ مَ نَشَن قْشْ رَ دَنشَنِيَ نُن شَنُنتٍيَ رَ، عَلْ عَلَ شَ مِشِ سُفَندِشِ عِسَ وَ مَ عَ شْن مَ كِ نَشّ. <verse eid="2TI 1:13"/><verse number="14" style="v" sid="2TI 1:14"/>عَلَ نَشَن تَشُشِ عِ رَ، عِ شَ مّينِ نَ مَ عَلَ شَشِلِ سّنِيّنشِ سَابُي رَ، نَشَن سَبَتِشِ وٌن عِ.<verse eid="2TI 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2TI 1:15"/>عِ عَ كٌلٌن عَسِكَيٍ بِرِن بَرَ ﭑ نَبٌلٌ، عَلْ قِفٍلٌ نُن هٍرٍ مٌفٍنٍ. <verse eid="2TI 1:15"/><verse number="16" style="v" sid="2TI 1:16"/>عَلَ شَ كِنِكِنِ عٌنٍسِقٌرٌ نُن عَ شَ دٍنبَيَ مَ، بَرِ مَ عَ نُ لُمَ ﭑ نَلِمَنِيَ رَ. عَ مُ يَافِ ﭑ نَ ﭑ تٌ نَ فٍيلِ كُي. <verse eid="2TI 1:16"/><verse number="17" style="v" sid="2TI 1:17"/>عَ تٌ قَ رْ مَ، عَ نَشَ ﭑ قٍن هَن عَ نَشَ ﭑ تٌ. <verse eid="2TI 1:17"/><verse number="18" style="v" sid="2TI 1:18"/>مَرِفِ شَ كِنِكِنِ عَ مَ نَ كِيتِ لْشْي. عِ عَ كٌلٌن دَنفِ بِرِن نَ عَ ﭑ مَلِشِ كِ نَشّ عٍقّسّ.<verse eid="2TI 1:18"/></para>
  <chapter eid="2TI 1"/>
  <chapter number="2" style="c" sid="2TI 2"/>
  <para style="s">تْورّ</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 2:1"/>ﭑ مَ دِ، عِ شَ عِ سّنبّ سٌ عَلَ شَ مِشِ سُفَندِشِ عِسَ شَ هِننّ شَ قٍ رَ. <verse eid="2TI 2:1"/><verse number="2" style="v" sid="2TI 2:2"/>عِ نَشَن مّشِ ﭑ نَ سٍيدٍ فبٍفبٍ يَ شْرِ، عِ شَ نَ مَسٍنيِ تَشُ عِ دُفُتّفّيٍ رَ، نَشٍيٍ قَن نْمَ مِشِ فبّتّيٍ رَشَرَندٍ نَ رَ. <verse eid="2TI 2:2"/><verse number="3" style="v" sid="2TI 2:3"/>وٌن بِرِن شَ وَكِلِ تْورّ كُي، بَرِ مَ عَلَ شَ مِشِ سُفَندِشِ عِسَ شَ سْورِ قَنيِيٍ نَن وٌن نَ. <verse eid="2TI 2:3"/><verse number="4" style="v" sid="2TI 2:4"/>سْورِ نَشَن نَ فٍرٍ كُي، عَ مُ بِرَ مَ دُنِحَ قٍ قْشْ رَ، عَ بِرَ مَ عَ شَ مَنفّ وَشْنقٍ نَن قْشْ رَ. <verse eid="2TI 2:4"/><verse number="5" style="v" sid="2TI 2:5"/>مِشِ نَشَن سِفَشِ فِ فبَتَ رَبَدٍ، شَ عَ مُ عَ فِ عَ سّرِيّ كِ مَ، عَ مُ فٍينِمَ. <verse eid="2TI 2:5"/><verse number="6" style="v" sid="2TI 2:6"/>مِشِ نَشَن شّ رَوَلِمَ، عَ تَن نَن لَنمَ عَ شَ بٌفِ سِنفٍيٍ سْتْ. <verse eid="2TI 2:6"/><verse number="7" style="v" sid="2TI 2:7"/>عِ حْشْ سَ ﭑ مَ مَسٍنيِ بِرِن شْن مَ، مَرِفِ قَهَامُي قِمَ نّ عِ مَ نَ قٍيٍ مَ.<verse eid="2TI 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 2:8"/>عِ شَ رَتُ عَلَ شَ مِشِ سُفَندِشِ عِسَ مَ، نَشَن كٍلِشِ قَشّ مَ، نَشَن قَتَنشِ دَوُدَ بْنسْي رَ، عَلْ عِسَ شَ شِبَارُ قَنيِ عَ مَسٍنشِ كِ نَشّ، ﭑ نَشَن كَوَندِقٍ. <verse eid="2TI 2:8"/><verse number="9" style="v" sid="2TI 2:9"/>نَ شِبَارُ قَنيِ نَن مَ قٍ عَ نِيَشِ، ﭑ نَ تْورْقٍ فٍيلِ كُي عَلْ قٍ كٌبِ رَبَمَ، كْنْ عَلَ شَ مَسٍنيِ تَن مُ بَلَنشِ. <verse eid="2TI 2:9"/><verse number="10" style="v" sid="2TI 2:10"/>نَ نَن عَ رَ ﭑ تْورّ مْولِ بِرِن شَنِنمَ، عَلَكٌ مِشِ سُفَندِشِيٍ شَ كِسِ سْتْ عَلَ شَ مِشِ سُفَندِشِ عِسَ سَابُي رَ، عٍ لُ عَ شَ نْرّ كُي عَبَدَن.<verse eid="2TI 2:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="2TI 2:11"/>مَسٍنيِ هَفِفّ نَن يَ؛</para>
  <para style="q" vid="2TI 2:11">شَ وٌن نُن عِسَ بَرَ قَشَ،</para>
  <para style="q" vid="2TI 2:11">وٌن نُن عِسَ مَن كٍلِمَ نّ قَشّ مَ.<verse eid="2TI 2:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="2TI 2:12"/>شَ وٌن تُننَبّشِ،</para>
  <para style="q" vid="2TI 2:12">وٌن لُمَ نّ عِسَ شَ مَنفّيَ كُي.</para>
  <para style="q" vid="2TI 2:12">شَ وٌن نَ عَ رَبٌلٌ،</para>
  <para style="q" vid="2TI 2:12">عَ قَن وٌن نَبٌلٌمَ نّ.<verse eid="2TI 2:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="2TI 2:13"/>شَ وٌن مُ لُ وٌن شُي شَنبِ رَ،</para>
  <para style="q" vid="2TI 2:13">عَ تَن لُمَ نّ عَ شُي شَنبِ رَ،</para>
  <para style="q" vid="2TI 2:13">بَرِ مَ عَ مُ نْمَ عَ يّتّ رَبٌلٌدٍ.<verse eid="2TI 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 2:14"/>عِ شَ مِشِ بِرِن نَتُ عَلَ يَ عِ، عَ عَ لَنمَ عٍ شَ فٍرٍ لُ نَ مَسٍنيِ ندٍيٍ شَ قٍ رَ. نَ وْيّنيِ مْولِ تِدٍ يٌ مُ نَ. عَ عَ رَ مّمَيٍ نَن شُن نَكَنَمَ تُن. <verse eid="2TI 2:14"/><verse number="15" style="v" sid="2TI 2:15"/>عِ شَ عِ يّتّ مَسٍن عَلَ بّ، عَلْ مِشِ نَشَن وَلِ قْشِ مُ مَيَافِ، عَ قَتَ نْندِ مَسٍندٍ مِشِيٍ بّ عَ مَسٍن كِ مَ. <verse eid="2TI 2:15"/><verse number="16" style="v" sid="2TI 2:16"/>وْيّن حَاشِ قُقَقُ لُ نَ، بَرِ مَ نَشٍيٍ نَ مْولِ قَلَمَ، عٍ شَ كَاقِرِحَ شُن نَن تُن مَسَمَ. <verse eid="2TI 2:16"/><verse number="17" style="v" sid="2TI 2:17"/>عٍ شَ وْيّنيِ فبٌمَ نّ عَلْ قُرٍ حَاشِ، نَشَن مِشِ قَشَمَ. هُمٍنٍيٌ نُن قِلٍتٌ نَ نٍيٍ نَن يَ مَ. <verse eid="2TI 2:17"/><verse number="18" style="v" sid="2TI 2:18"/>عٍ بَرَ مَكُيَ نْندِ رَ، عٍ قَ عَ قَلَ مِشِيٍ حَن بَرَ كٍلِ قَشّ مَ. عٍ بَرَ مِشِ ندٍيٍ شَ دَنشَنِيَ كَنَ نَ وْيّنيِ مْولِ رَ.<verse eid="2TI 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 2:19"/>كْنْ عَلَ شَ بَنشِ تِشِ يِ مَسٍنيِ نَن قَرِ؛ «عَلَ عَ كٌلٌن، مِشِ نَشَن قِندِشِ عَ فبٍ رَ.» عَ مَن عَ مَسٍنشِ؛ «عَدَ مَدِ نَشَن مَرِفِ شِلِ قَلَمَ، عَ شَ تِنشِنتَرٍيَ رَبّحِن.» <verse eid="2TI 2:19"/><verse number="20" style="v" sid="2TI 2:20"/>سٍ سَسٍ مْولِ فبٍفبٍ نَن نَ بَنشِ شُنفبٍ كُي. ندٍ قَن يَءِلَنشِ شّيمَ نَن نَ، شَ نَ مُ عَ رَ فبٍتِ. ندٍ يَءِلَنشِ وُرِ نَن نَ، شَ نَ مُ عَ رَ بّندّ. ندٍ بِنيّ وَلِ رَبَمَ، ندٍ قَن بِنيّتَرٍ وَلِ رَبَمَ. <verse eid="2TI 2:20"/><verse number="21" style="v" sid="2TI 2:21"/>مِشِ نَشَن عَ يّتّ رَ سّنِيّنمَ، عَ لُمَ نّ عَلْ وَلِ بِنيّ رَبَمَ سٍ سَسٍ نَشَن كُي. عَ تٌ سّنِيّن، عَ مَرِفِ نْمَ عَ رَوَلِدٍ وَلِ قَنيِ بِرِن كُي.<verse eid="2TI 2:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 2:22"/>قٌنِكٍ وَشْنقٍ لُ نَ. وٌ نُن مِشِ نَشٍيٍ مَرِفِ شِلِمَ بْحّ سّنِيّنشِ رَ، وٌ شَ نُ تِنشِنيِ، دَنشَنِيَ، شَنُنتٍيَ، نُن بْحّسَ قٍن. <verse eid="2TI 2:22"/><verse number="23" style="v" sid="2TI 2:23"/>وْيّنيِ تِدٍتَرٍ قُقَقُ لُ نَ، بَرِ مَ عِ عَ كٌلٌن نَ مْولِ قِندِ مَ فٍرٍ نَن نَ. <verse eid="2TI 2:23"/><verse number="24" style="v" sid="2TI 2:24"/>عَ مُ لَنمَ مَرِفِ شَ وَلِكّ شَ سْنشْ. عَ لَنمَ عَ شَ قِندِ مِشِ دِحّشِ رَ نَشَن قَتَ مِشِ شَرَندٍ، عَ مَن وَكِلِ تْورّ رَ. <verse eid="2TI 2:24"/><verse number="25" style="v" sid="2TI 2:25"/>عَ لَنمَ عَ شَ مَتَندِلَيٍ مَتِنشِن وْيّنيِ حْشُنمّ رَ، عَلَكٌ عَلَ شَ عَ نِيَ عٍ شَ تُوبِ، عٍ شَ نْندِ كٌلٌن، <verse eid="2TI 2:25"/><verse number="26" style="v" sid="2TI 2:26"/>عٍ شَ شَشِلِ سْتْ، عٍ شَ عٍ بَ عِبُلِسَ شَ فَنتَنيِ رَ. عِبُلِسَ بَرَ عٍ سُشُ فَنتَنيِ رَ، عَلَكٌ عٍ شَ لُ عَ شَ يَامَرِ بُن مَ.<verse eid="2TI 2:26"/></para>
  <chapter eid="2TI 2"/>
  <chapter number="3" style="c" sid="2TI 3"/>
  <para style="s">وَشَتِ دْنشْي</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 3:1"/>عِ شَ عَ كٌلٌن، قٍ شْرْشْييٍ قَمَ نّ دُنِحَ لِدٍ وَشَتِ دْنشْي، <verse eid="2TI 3:1"/><verse number="2" style="v" sid="2TI 3:2"/>بَرِ مَ عَدَ مَدِيٍ بِرَ مَ عٍ يّتّ وَشْنقٍ نَن قْشْ رَ، كْبِرِ رَقَنمَ نّ عٍ مَ، عٍ عٍ يّتّ عِفبٌمَ، عٍ لَمَ عٍ يّتّ رَ، عٍ عَلَ رَ سْتْمَ، عٍ عٍ بَرِ مَيٍ مَتَندِ مَ، عٍ قِنسِرِوَلِيَ رَبَمَ، عٍ مُ عَلَ شَ قٍ بِنيَمَ، <verse eid="2TI 3:2"/><verse number="3" style="v" sid="2TI 3:3"/>عٍ مُ كِنِكِنِمَ، عٍ مُ دِحّمَ، عٍ مِشِ مَقَلَمَ، عٍ شُرُتَرٍحَ رَبَمَ، عٍ عٍ بٌورٍ تْورْ مَ، عٍ مِشِ قَنيِ شْنمَ، <verse eid="2TI 3:3"/><verse number="4" style="v" sid="2TI 3:4"/>عٍ مِشِ يَنقَمَ، عٍ بٌفٌنمَ قٍيٍ مَ، عٍ بْحّ فبٌ، عٍ وَشْنقٍ رَقَن عٍ مَ دَنفِ عَلَ شَ قٍ رَ. <verse eid="2TI 3:4"/><verse number="5" style="v" sid="2TI 3:5"/>عَ لُشِ نّ عَلْ عٍ دِينّ نَن نَبَتُمَ، كْنْ عٍ بَرَ عٍ كٌبٍ رَ سٌ عَ سّنبّ رَ. عِ شَ عِ مَكُيَ نَ مِشِ مْولِيٍ رَ.<verse eid="2TI 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 3:6"/>عٍ سٌمَ دٍنبَيَيٍ كُي، عٍ قَ فِنّ سّنبّتَرٍيٍ مَبّندُن، نَشٍيٍ قِندِشِ يُنُبِتْييٍ رَ، نَشٍيٍ بِرَ مَ قٍ حَاشِ مْولِ بِرِن قْشْ رَ. <verse eid="2TI 3:6"/><verse number="7" style="v" sid="2TI 3:7"/>نَ فِنّ مْولِ شَرَنمَ تّمُي بِرِن، كْنْ عٍ مُ قَهَامُي سْتْمَ نْندِ مَ. <verse eid="2TI 3:7"/><verse number="8" style="v" sid="2TI 3:8"/>نَ مِشِ نَشٍيٍ سٌمَ دٍنبَيَيٍ كُي، عٍ لُمَ نّ عَلْ يَننّسِ نُن يَنبّرّ سِ نَشٍيٍ عَننَبِ مُنسَ مَتَندِ. نَ مِشِيٍ نْندِ قَن مَتَندِ مَ نّ، عٍ شَشِلِ بَرَ كَنَ. عٍ شَ دَنشَنِيَ شْن مُ كُيَمَ. <verse eid="2TI 3:8"/><verse number="9" style="v" sid="2TI 3:9"/>كْنْ عٍ مُ سِفَمَ يَرٍ سْنْن، بَرِ مَ مِشِ بِرِن قَمَ نّ عٍ شَ دَشُحَ كٌلٌندٍ، عَلْ يَننّسِ نُن يَنبّرّ سِ شَ قٍ نُ كٌلٌنشِ كِ نَشّ.<verse eid="2TI 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2TI 3:10"/>كْنْ عِ تَن، عِ بَرَ ﭑ مَ شَرَنيِ كٌلٌن، ﭑ حّرّ كِ، ﭑ حَنِفٍ، ﭑ مَ دَنشَنِيَ، ﭑ مَ دِحّ، ﭑ مَ شَنُنتٍيَ، ﭑ مَ تُننَبّشِ، <verse eid="2TI 3:10"/><verse number="11" style="v" sid="2TI 3:11"/>ﭑ مَ حَشَنكَتّ، عَ نُن ﭑ مَ تْورّ. تْورّ مْولِ مُندُن نَ، ﭑ مُ نَشَن سْتْ عَنتِيْكِ، عِكٌنِيٌن، نُن لِسِتِرٍ؟ حَشَنكَتّ مُندُن مُ ﭑ لِشِ نَا؟ مَرِفِ بَرَ ﭑ نَكِسِ نَ بِرِن كُي. <verse eid="2TI 3:11"/><verse number="12" style="v" sid="2TI 3:12"/>نْندِ نَ عَ رَ عَ مِشِ نَشَن بِرِن وَ مَ بِرَقٍ عَلَ شَ مِشِ سُفَندِشِ عِسَ شَ سّرِيّ قْشْ رَ، عَ نَ كَنيِ تْورّ سْتْمَ نّ. <verse eid="2TI 3:12"/><verse number="13" style="v" sid="2TI 3:13"/>كْنْ مِشِ حَاشِيٍ نُن قِلَنكَقُييٍ شَ قٍ كٌبِيٍ شُن نَن تُن لُمَ مَسَ رَ، عٍ قَ بٌورٍيٍ مَدَشُ، عٍ عٍ يّتّ مَدَشُ.<verse eid="2TI 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 3:14"/>عِ شَ عِ شِرِ سّرِيّ رَ عِ نَشَن شَرَنشِ، عِ دَنشَنِيَشِ نَشَن مَ. عِ عَ كٌلٌن عِ نَ سْتْشِ نَشَن نَ. <verse eid="2TI 3:14"/><verse number="15" style="v" sid="2TI 3:15"/>كَبِ عِ دِ مّدِ تّمُي، عِ كِتَابُي سّنِيّنشِيٍ كٌلٌن، نَشٍيٍ نْمَ لْننِ قِدٍ عِ مَ. نَ لْننِ قِندِ مَ كِسِ نَن نَ مِشِيٍ بّ، نَشٍيٍ دَنشَنِيَشِ عَلَ شَ مِشِ سُفَندِشِ عِسَ مَ. <verse eid="2TI 3:15"/><verse number="16" style="v" sid="2TI 3:16"/>كِتَابُي سّنِيّنشِ بِرِن قَتَنشِ عَلَ نَن نَ. عَ قَن شَرَنيِ رَ، عَ قَن يَابِ رَ، عَ قَن مَتِنشِنسٍ رَ، عَ قَن تِنشِنيِ مَسٍنقٍ رَ، <verse eid="2TI 3:16"/><verse number="17" style="v" sid="2TI 3:17"/>عَلَكٌ عَلَ شَ مِشِ شَ نْ وَلِ قَنيِ بِرِن نَبَدٍ.<verse eid="2TI 3:17"/></para>
  <chapter eid="2TI 3"/>
  <chapter number="4" style="c" sid="2TI 4"/>
  <para style="s">كَوَندِ تِقٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 4:1"/>ﭑ بَرَ عِ يَمَرِ عَلَ يَ شْرِ، ﭑ بَرَ عِ يَمَرِ عَلَ شَ مِشِ سُفَندِشِ عِسَ يَ شْرِ، نَشَن قَمَ مِشِ حِحّيٍ نُن مِشِ قَشَشِيٍ مَكِيتِدٍ، نَشَن قَمَ عَ شَ مَنفّيَ نِينِ رَ مِنِدٍ، <verse eid="2TI 4:1"/><verse number="2" style="v" sid="2TI 4:2"/>عِ شَ عَلَ شَ مَسٍنيِ كَوَندِ، عِ شَ وَكِلِ تّمُي بِرِن، عِ شَ مِشِيٍ مَتِنشِن، عِ شَ مِشِيٍ شَ يُنُبِيٍ مَسٍن عٍ بّ، عِ شَ عٍ رَلِمَنِيَ، عِ شَ عٍ شَرَن. عِ شَ نَ بِرِن نَبَ دِحّ كُي. <verse eid="2TI 4:2"/><verse number="3" style="v" sid="2TI 4:3"/>وَشَتِ نَ قَقٍ مِشِيٍ مُ تِنمَ شَرَنيِ تِنشِنشِ رَ تّمُي نَشّ. عٍ كَرَ مْشْ وُيَشِ قٍنمَ نّ، نَشٍيٍ مَسٍنيِ مْولِ ندٍ تِمَ نَشَن نَقَن عٍ تُلِ مَ. <verse eid="2TI 4:3"/><verse number="4" style="v" sid="2TI 4:4"/>عٍ فبِلٍنمَ نّ نْندِ قْشْ رَ، عٍ قَ عٍ تُلِ مَتِ كِينِيٍ رَ. <verse eid="2TI 4:4"/><verse number="5" style="v" sid="2TI 4:5"/>كْنْ عِ تَن، عِ شَ عِ يّتّ مَتَشَسِ قٍ بِرِن كُي، عِ شَ عِ تُننَبّشِ تْورّ كُي، عِ شَ عَلَ شَ شِبَارُ قَنيِ رَيٍنسٍن، عِ شَ عِ شَ وَلِ رَكَمَلِ.<verse eid="2TI 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 4:6"/>ﭑ تَن حَن بَرَ قِندِ سّرّشّ رَ عَلَ بّ. عَ فبٍ مُ لُشِ ﭑ شَ تَا مَسَرَ. <verse eid="2TI 4:6"/><verse number="7" style="v" sid="2TI 4:7"/>ﭑ بَرَ ﭑ مَ فٍرٍ قَنيِ سٌ، ﭑ بَرَ ﭑ مَ حّرّ رَحْن، ﭑ بَرَ لُ دَنشَنِيَ كُي. <verse eid="2TI 4:7"/><verse number="8" style="v" sid="2TI 4:8"/>شُننَكٍلِ سَرٍ رَفَتَشِ ﭑ بّ، نَشَن قِندِشِ تِنشِنيِ رَ مَرِفِ كِيتِسَ تِنشِنشِ نَشَن قِمَ ﭑ مَ نَ لْشْي. ﭑ كٍرٍن شَ مُ عَ رَ، عَ نَ قِمَ مِشِ بِرِن نَن مَ، عَ قَقٍ رَقَن نَشٍيٍ مَ.<verse eid="2TI 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2TI 4:9"/>عِ شَ كَتَ قَقٍ رَ ﭑ يِرٍ مَقُرٍن مَقُرٍن، <verse eid="2TI 4:9"/><verse number="10" style="v" sid="2TI 4:10"/>بَرِ مَ دٍ مَسِ بَرَ ﭑ نَبّحِن دُنِحَ قٍ شَ قٍ رَ، عَ سِفَ تّسَلٌنِكِ. كِرٍ سٍن بَرَ سِفَ فَلَتِ، تِتٌ بَرَ سِفَ دَلَمَتِيَ. <verse eid="2TI 4:10"/><verse number="11" style="v" sid="2TI 4:11"/>لُكِ فبَنسَن نَن نَ ﭑ سّيتِ مَ. عِ شَ قَ مَرَكِ رَ، بَرِ مَ عَ نْمَ ﭑ مَلِدٍ ﭑ مَ وَلِ كُي عَ قَنيِ رَ. <verse eid="2TI 4:11"/><verse number="12" style="v" sid="2TI 4:12"/>ﭑ بَرَ تِكِكٍ شّي عٍقّسّ. <verse eid="2TI 4:12"/><verse number="13" style="v" sid="2TI 4:13"/>عِ نّ قَمَ، عِ شَ قَ نَ شِنبٍلِ دٌنمَ رَ، ﭑ نَشَن لُشِ تِرٌيَسِ، كَرَثٌ شْنيِ، عَ نُن ﭑ مَ بُكِيٍ. نَ سّبّلِ نَشٍيٍ تِشِ شُرُ سٍ كِرِ مَ، عٍ تِدٍ فبٌ دَنفِ بِرِن نَ، عِ شَ قَ عٍ قَن نَ. <verse eid="2TI 4:13"/><verse number="14" style="v" sid="2TI 4:14"/>عَلٍسَندِرٍ شَبُي بَرَ قٍ حَاشِ فبٍفبٍ رَبَ ﭑ نَ. مَرِفِ قَمَ عَ سَرٍ رَفبِلٍندٍ عَ مَ. <verse eid="2TI 4:14"/><verse number="15" style="v" sid="2TI 4:15"/>عِ شَ عِ يّتّ رَتَنفَ عَ مَ، بَرِ مَ عَ مُشُ شَ كَوَندِ مَتَندِ نّ عَ حَاشِ رَ.<verse eid="2TI 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 4:16"/>ﭑ تٌ ﭑ يّتّ شُنمَقَلَ كِيتِ بَنشِ كُي عَ سِنفٍ، ﭑ مَلِمَ يٌ مُ نُ نَ. بِرِن ﭑ نَبٌلٌ نّ. عَلَ شَ دِحّ عٍ مَ عٍ قٍ نَشَن نَبَشِ. <verse eid="2TI 4:16"/><verse number="17" style="v" sid="2TI 4:17"/>عَلَ نَن ﭑ مَلِشِ، عَ سّنبّ سٌ ﭑ يِ رَ، عَلَكٌ ﭑ شَ كَوَندِ تِ عَ قَنيِ رَ سِ بِرِن بّ. عَلَ نَشَ ﭑ نَتَنفَ يّتّ مَفَاشُشِ مَ. <verse eid="2TI 4:17"/><verse number="18" style="v" sid="2TI 4:18"/>مَرِفِ مَن قَمَ ﭑ نَتَنفَدٍ مِشِيٍ شَ وَلِ كٌبِ بِرِن مَ، عَ قَ ﭑ نَكِسِ، ﭑ شَ سٌ عَ شَ مَنفّيَ نِينِ بُن مَ عَرِيَننَ. مَتْشْي نَ عَلَ بّ عَبَدَن.<verse eid="2TI 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 4:19"/>ثِرِ سِلَ نُن عَكِلَ شّيبُ ﭑ بّ، عَ نُن عٌنٍسِقٌرٌ شَ دٍنبَيَ. <verse eid="2TI 4:19"/><verse number="20" style="v" sid="2TI 4:20"/>عٍرَ سِتٌ بَرَ لُ كٌرِنتِ. ﭑ بَرَ تِرٌقِمٌ لُ مِلٍتٌ، بَرِ مَ عَ مُ نُ يَلَنشِ. <verse eid="2TI 4:20"/><verse number="21" style="v" sid="2TI 4:21"/>عِ شَ كَتَ قَقٍ رَ بٍينُن حّمّ شَ سٌ. عٍوُبُلٌ، ثُدّن، لِنٌسِ، كٍلٌدِيَ، نُن وٌن نفَشَكٍرٍنيِ بِرِن بَرَ عِ شّيبُ. <verse eid="2TI 4:21"/><verse number="22" style="v" sid="2TI 4:22"/>مَرِفِ شَ سَبَتِ عِ بْحّ عِ، عَلَ شَ هِننّ وٌ بِرِن نَ.<verse eid="2TI 4:22"/></para>
  <chapter eid="2TI 4"/>
</usx>
