<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JOB" style="id"/>
  <para style="h">عَيُبَ</para>
  <para style="toc1">عَيُبَ شَ تَرُشُي</para>
  <para style="toc2">عَيُبَ</para>
  <para style="toc3">عَيُ</para>
  <para style="mt">عَيُبَ شَ تَرُشُي</para>
  <para style="imt">مَسٍنيِ ندٍ يِ كِتَابُي شَ قٍ رَ</para>
  <para style="ip">يِ كِتَابُي قِندِشِ عَيُبَ شَ تَرُشُي نَن نَ نَشَن مَسٍنيِ هَفِفّ مَسٍنمَ عَدَ مَدِيٍ بِرِن بّ. كَبِ وٌن بٍنبَ عَدَ مَ نُن نّنّ مَهَوَ تٌ يُنُبِ رَبَ، مِشِ بِرِن نَ دُنِحَ عِفِرِقٍ نَ تْورّ نَن كُي. نَ تْورّ نْمَ عَ نِيَدٍ مِشِيٍ شَ شْنْ عَلَ مَ، عٍ قَ عَ مَشْرِن مُنقٍ رَ عَ عٍ لُمَ عٍ شَ تْورْ. شَ مِشِيٍ حْشْ عَ مَ عَ عٍ بَرَ عٍ حّرّ تِنشِنيِ كُي عَلَ يَ عِ، نَ يَابِ قِقٍ شْرْشْ.</para>
  <para style="ip">عَيُبَ شَ قٍ نُ نَ نَ كِ نّ. عَ بٌورٍيٍ نَشَ عَ قَلَ عَ بّ عَ تْورّ حَاشِ عَ سْتْ عَ شَ يُنُبِيٍ نَن مَ قٍ رَ. عَيُبَ مُ تِن نَ يَابِ رَ، عَ قَ عَ قَلَ نَ مُ عَ رَ. نَ كُي عَ نُ وَ مَ عَلَ شَ كِيتِ شْن عَلَكٌ عَ شَ عَ كٌلٌن عَ حَشَنكَتَشِ قٍ نَشَن مَ. عَ رَحْنيِ عَلَ نَشَ عَ مَسٍن عَيُبَ بّ عَ عَ مُ نْمَ عَلَتَلَ شَ قٍ رَبَ كِ قَهَامُدٍ. عَيُبَ تٌ سٌ نَ قٍ كُي عَ بْحّ بِرِن نَ، عَ شَشِلِ نَشَ سَ.</para>
  <para style="ip">كْنْ بَقٍ نَ مَسٍنيِ رَ، سّرِيّ فبّتّ تٌمَ يِ تَرُشُي كُي نَشَن تِدٍ فبٌ. عَلَ تٌ بَرَكّ سَ عَيُبَ شَ قٍ مَ عَ شَ تِنشِنيِ شَ قٍ رَ، سٍنتَنّ نَشَ عَيُبَ تْوحّفّ عَ قَلَقٍ رَ عَلَ بّ عَ عَيُبَ نُ بِرَ مَ عَلَ وَشْنقٍ قْشْ رَ عَلَكٌ عَ شَ بَرَكّ سْتْ تُن. عَلَ نُ وَ مَ عَ مَسٍنقٍ سٍنتَنّ بّ عَ عَ شَ تِنشِنتْي عَيُبَ نُ نَ عَلَ شَ سّرِيّ رَتِنمّقٍ قٍ فبّتّ نَن مَ. عَلَ نَشَ تِن تْورّ شَ دْشْ عَيُبَ مَ، عَلَكٌ سٍنتَنّ شَ عَ تٌ نَ تْورّ مُ نُ نْمَ عَ نِيَدٍ عَيُبَ شَ عَلَ شَ سّرِيّ بّحِن.</para>
  <para style="ip">نَ كُي وٌن بِرِن نْمَ عَ كٌلٌندٍ عَ مُ لَنمَ وٌن شَ بِرَ عَلَتَلَ قْشْ رَ عَلَكٌ وٌن شَ بَرَكّ تُن سْتْ. عَ لَنمَ وٌن شَ عَلَ شُي سُشُ بَرِ مَ وٌن دَا مَرِفِ نَن نَ عَلَتَلَ رَ. شَ وٌن بَرَكّ سْتْ، شَ وٌن مُ عَ سْتْ، عَ لَنمَ وٌن شَ وٌن مَرِفِ عَلَتَلَ بَتُ وٌن مَ قٍ بِرِن كُي. عَلَ شَ وٌن مَلِ نَ رَبَدٍ. عَمِنَ.</para>
  <para style="imte">عَيُبَ شَ تَرُشُي</para>
  <chapter number="1" style="c" sid="JOB 1"/>
  <para style="s">عَلَتَلَ نُن سٍنتَنّ شَ دّ مَسَرّ سِنفٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 1:1"/>شّمّ ندٍ نُ نَ عُسُ بْشِ مَ نَشَن نُ شِلِ عَيُبَ. مِشِ هَفِفّ نَن نُ لَنشِ عَ مَ، عَ مَتِنشِن. عَ نُ فَاشُمَ عَلَ يَ رَ، عَ مُ نُ بِرَ مَ قٍ حَاشِ قْشْ رَ. <verse eid="JOB 1:1"/><verse number="2" style="v" sid="JOB 1:2"/>دِ شّمّ سٌلٌقٍرٍ نُن دِ فِنّ سَشَن نُ نَ عَ يِ رَ. <verse eid="JOB 1:2"/><verse number="3" style="v" sid="JOB 1:3"/>عَ شَ فْورّ نُ لَنشِ يّشّي وُلُ سٌلٌقٍرٍ، حْشْمّ وُلُ سَشَن، نِنفٍ وُلُ كٍرٍن، عَ نُن سٌقَلٍ كّمّ سُولِ نَن مَ. وَلِكّ فبٍفبٍ سَشِ نَ نَن قَرِ. بِنيّ نُ سَشِ يِ شّمّ مَ دَنفِ مِشِ بِرِن نَ نَ سٌفٍتٍدٍ بِرِ رَ.<verse eid="JOB 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JOB 1:4"/>عَ شَ دِيٍ نُ شُلُنيِ تِمَ نّ عٍ بٌورٍ شْنيِيٍ، عٍ نُ عٍ مَافِنّيٍ شِلِ عَلَكٌ عٍ بِرِن شَ نُ عٍ دّفٍ يِرٍ كٍرٍن. <verse eid="JOB 1:4"/><verse number="5" style="v" sid="JOB 1:5"/>شُلُنيِيٍ نَ بَ عَ رَ، عَيُبَ نُ سّرّشّ فَن دَاشِيٍ بَمَ نّ عَ شَ دِ بِرِن بّ عٍ رَ سّنِيّنقٍ رَ. عَ نُ عَ مَحْشُنمَ نّ عَ تّمُندٍ عٍ بَرَ يُنُبِ ندٍ سْتْ، شَ نَ مُ عَ رَ عٍ بَرَ عَلَ دَنكَ عٍ بْحّ كُي. نَ كُي عَيُبَ نُ لُمَ سّرّشّ بَ رَ عٍ بّ تّمُي بِرِن.<verse eid="JOB 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JOB 1:6"/>لْشْي ندٍ عَلَ شَ مَلٍكّيٍ نَشَ قَ عَلَتَلَ يِرٍ. سٍنتَنّ قَن نُ نَ عٍ يَ مَ. <verse eid="JOB 1:6"/><verse number="7" style="v" sid="JOB 1:7"/>عَلَتَلَ نَشَ سٍنتَنّ مَشْرِن، «عِ كٍلِشِ مِندٍن؟» سٍنتَنّ نَشَ عَ يَابِ، «ﭑ كٍلِشِ دُنِحَ عِحّرّدٍ.» <verse eid="JOB 1:7"/><verse number="8" style="v" sid="JOB 1:8"/>عَلَتَلَ مَن نَشَ عَ مَشْرِن، «عِ بَرَ ﭑ مَ كٌنيِ عَيُبَ رَكْرْ سِ؟ عَ مَنِيّ يٌ مُ نَ دُنِحَ مَ. عَ قَن، عَ تِنشِن. عَلَ يَرَفَاشُي نَن عَ رَ، قٍ حَاشِ مُ رَقَن عَ مَ.» <verse eid="JOB 1:8"/><verse number="9" style="v" sid="JOB 1:9"/>سٍنتَنّ نَشَ عَ يَابِ، «عَيُبَ شَ فَاشُي عِ يَ رَ تُن مُ عَ رَ؟ <verse eid="JOB 1:9"/><verse number="10" style="v" sid="JOB 1:10"/>عِ مُ عَ كَنتَشِ شّ، عَ تَن، عَ شَ دٍنبَيَ، نُن عَ هَرِفٍ بِرِن؟ عِ بَرَ بَرَكّ سَ عَ سُشُقٍ بِرِن مَ، عَلَكٌ عَ شَ فْورّ شَ فبٌ تُن. <verse eid="JOB 1:10"/><verse number="11" style="v" sid="JOB 1:11"/>كْنْ شَ عَ سَ لِ عِ نَشَ دِن عَ هَرِفٍ رَ، ﭑ شَ عَ قَلَ عِ بّ، عَ قَمَ نّ عِ دَنكَدٍ كٍرٍن نَ.» <verse eid="JOB 1:11"/><verse number="12" style="v" sid="JOB 1:12"/>عَلَتَلَ نَشَ عَ قَلَ سٍنتَنّ بّ، «عَوَ يِرٍ، ﭑ بَرَ عَ هَرِفٍ بِرِن سَ عِ سَفٌي، كْنْ عِ نَشَ عَ فُندِ تْورْ دٍ.» نَ تّمُي سٍنتَنّ نَشَ كٍلِ عَلَتَلَ يِرٍ.<verse eid="JOB 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JOB 1:13"/>لْشْي ندٍ عَيُبَ شَ دِيٍ نُ نَ شُلُنيِ تِقٍ عٍ تَارَ شْنيِ. <verse eid="JOB 1:13"/><verse number="14" style="v" sid="JOB 1:14"/>شّيرَ ندٍ نَشَ قَ عَيُبَ يِرٍ، عَ عَ قَلَ عَ بّ، «عِ شَ وَلِكّيٍ نُ نَ نِنفٍيٍ رَوَلِقٍ شّ مَ، سٌقَلٍيٍ قَن نُ نَ عٍ دّ مَدٌنقٍ نَ لٌنفٌرِ. <verse eid="JOB 1:14"/><verse number="15" style="v" sid="JOB 1:15"/>سٍبَكَ ندٍيٍ نَشَ دِن عِ شَ وَلِكّيٍ رَ، عٍ عٍ قَشَ سَنتِدّفّمَ رَ. عٍ مَن نِنفٍيٍ قَن شَنِن. ﭑ كٍرٍن ثٍتِ نَن نْ ﭑ يّتّ بَدٍ عٍ يِ. ﭑ قَشِ نَ قٍ نَن دّنتّفّدٍ عِ بّ.»<verse eid="JOB 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JOB 1:16"/>نَ مُ فّ نَ مَسٍنيِ رَ، شّيرَ فبّتّ نَشَ قَ، عَ عَ قَلَ عَيُبَ بّ، «عَلَ بَرَ عَ رَفِرِ فَلَنيِ شَ فٌرٌ عِ شَ يّشّييٍ نُن عٍ مَكَنتَمَيٍ مَ. عَ بَرَ عٍ بِرِن قَشَ. ﭑ كٍرٍن ثٍتِ نَن نْ ﭑ يّتّ بَدٍ عٍ يِ. ﭑ قَشِ نَ قٍ نَن دّنتّفّدٍ عِ بّ.»<verse eid="JOB 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JOB 1:17"/>نَ قَن مُ فّ عَ شَ مَسٍنيِ رَ، شّيرَ فبّتّ نَشَ قَ، عَ عَ قَلَ عَيُبَ بّ، «كَلِدِكَ، فَالِ دْشْ سَشَن بَرَ بَفَن عِ شَ حْشْمّيٍ مَ، عٍ عٍ مَكَنتَمَيٍ قَشَ سَنتِدّفّمَ رَ، عٍ حْشْمّيٍ شَنِن. ﭑ كٍرٍن ثٍتِ نَن نْ ﭑ بَدٍ عٍ يِ. ﭑ قَشِ نَ قٍ نَن دّنتّفّدٍ عِ بّ.»<verse eid="JOB 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JOB 1:18"/>نَ قَن مُ فّ عَ شَ مَسٍنيِ رَ، شّيرَ فبّتّ نَشَ قَ، عَ عَ قَلَ عَيُبَ بّ، «عِ شَ دِيٍ تٌ نُ نَ شُلُنيِ تِقٍ عٍ تَارَ شْنيِ. <verse eid="JOB 1:18"/><verse number="19" style="v" sid="JOB 1:19"/>قٌيٍ بٍلٍبٍلٍ قَشِ نَ تّمُي نّ كٍلِ فبٍنفبٍرٍنيِ مَ، عَ بَنشِ رَبِرَ عِ شَ دِيٍ مَ. عٍ بِرِن بَرَ قَشَ. ﭑ كٍرٍن ثٍتِ نَن كِسِشِ. ﭑ قَشِ نَ نَن دّنتّفّدٍ عِ بّ.»<verse eid="JOB 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JOB 1:20"/>نَ كُي عَيُبَ نَشَ كٍلِ، عَ عَ شَ دٌنمَ عِبْو عَ مَ، عَ عَ شُنيِ بِ سُننُنيِ مَ، عَ قَ عَ رَقٍلٍن بْشِ مَ. <verse eid="JOB 1:20"/><verse number="21" style="v" sid="JOB 1:21"/>عَ نَشَ عَ قَلَ،</para>
  <para style="q" vid="JOB 1:21">«ﭑ قَشِ دُنِحَ ﭑ مَفٍلِ نَن نَ ﭑ بَرِ تّمُي،</para>
  <para style="q" vid="JOB 1:21">ﭑ مَن فبِلٍنمَ ﭑ مَفٍلِ نَن نَ ﭑ سِفَ تّمُي.</para>
  <para style="q" vid="JOB 1:21">عَلَتَلَ بَرَ ﭑ كِ هَرِفٍ رَ،</para>
  <para style="q" vid="JOB 1:21">عَلَتَلَ مَن بَرَ نَ هَرِفٍ بَ ﭑ يِ.</para>
  <para style="q" vid="JOB 1:21">تَنتُي نَ عَلَ بّ.»<verse eid="JOB 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JOB 1:22"/>نَ بِرِن كُي، عَيُبَ مُ يُنُبِ يٌ رَبَ، عَ مُ قٍ كٌبِ يٌ قَلَ عَلَ بّ.<verse eid="JOB 1:22"/></para>
  <chapter eid="JOB 1"/>
  <chapter number="2" style="c" sid="JOB 2"/>
  <para style="s">عَلَتَلَ نُن سٍنتَنّ شَ دّ مَسَرّ قِرِن ندٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 2:1"/>لْشْي ندٍ عَلَتَلَ شَ مَلٍكّيٍ مَن نَشَ قَ عَ يِرٍ، سٍنتَنّ مَن نُ نَ عٍ تَفِ. <verse eid="JOB 2:1"/><verse number="2" style="v" sid="JOB 2:2"/>عَلَتَلَ نَشَ سٍنتَنّ مَشْرِن، «عِ كٍلِشِ مِندٍن؟» سٍنتَنّ نَشَ عَ يَابِ، «ﭑ كٍلِشِ دُنِحَ عِحّرّدٍ.» <verse eid="JOB 2:2"/><verse number="3" style="v" sid="JOB 2:3"/>عَلَتَلَ مَن نَشَ عَ مَشْرِن، «عِ بَرَ ﭑ مَ كٌنيِ عَيُبَ رَكْرْ سِ؟ عَ مَنِيّ يٌ مُ نَ دُنِحَ مَ. عَ قَن، عَ تِنشِن. عَلَ يَرَفَاشُي نَن عَ رَ، قٍ حَاشِ مُ رَقَن عَ مَ. هَن يَ عَ شَ تِنشِنيِ مُ مَسَرَ، هَلِ عِ تٌ وَشِ ﭑ شَ عَ هَلَكِ تُن.» <verse eid="JOB 2:3"/><verse number="4" style="v" sid="JOB 2:4"/>سٍنتَنّ نَشَ عَ يَابِ، «عَدَ مَ قٍ بِرِن نَبَمَ عَ قَتٍ شَ تْورّ مَتَنفَقٍ نَن نَ. عَ نْمَ عَ هَرِفٍ بِرِن مَسَرَدٍ يَلَنيِ رَ. <verse eid="JOB 2:4"/><verse number="5" style="v" sid="JOB 2:5"/>شَ عِ عَ قَتٍ يَتِ تْورْ مَ، عَ عِ دَنكَمَ نّ كٍرٍن نَ.» <verse eid="JOB 2:5"/><verse number="6" style="v" sid="JOB 2:6"/>عَلَتَلَ نَشَ عَ قَلَ سٍنتَنّ بّ، «عَوَ يِرٍ، ﭑ بَرَ عَ قَتٍ سَ عِ سَفٌي، كْنْ عِ نَشَ عَ قَشَ دٍ.»<verse eid="JOB 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JOB 2:7"/>نَ تّمُي سٍنتَنّ نَشَ كٍلِ عَلَتَلَ يِرٍ. عَ نَشَ سُورِيٍ عِكٌنكٌن عَيُبَ قَتٍ بِرِن مَ، كٍلِ عَ سَنيِ كُي مَ هَن عَ شُنتَفِ. <verse eid="JOB 2:7"/><verse number="8" style="v" sid="JOB 2:8"/>عَيُبَ نَشَ دْشْ تّ شُبٍ شْورَ سُننُنيِ كُي، عَ نُ عَ قَتٍ شْولِن قّحّ كٍبٍلٍ رَ. <verse eid="JOB 2:8"/><verse number="9" style="v" sid="JOB 2:9"/>عَ شَ فِنّ نَشَ عَ قَلَ عَ بّ، «هَن يَ عِ نَ عِ شَ تِنشِنيِ كُي؟ عَلَ رَ سْتْ سْنْن، عِ شَ قَشَ.» <verse eid="JOB 2:9"/><verse number="10" style="v" sid="JOB 2:10"/>كْنْ عَيُبَ نَشَ عَ يَابِ، «عِ وْيّنقٍ نّ نَ كِ عَلْ شَشِلِتَرٍ. شَ وٌن تِنمَ عَلَ شَ هّرِ رَ، عَ مُ لَنمَ وٌن شَ تِن عَ شَ شْرْشْي قَن نَ؟» نَ كُي عَيُبَ مُ يُنُبِ يٌ سْتْ عَ شَ وْيّنيِيٍ كُي.<verse eid="JOB 2:10"/></para>
  <para style="s">عَيُبَ نُن عَ بٌورٍ سَشَنيِيٍ</para>
  <para style="p">
    <verse number="11" style="v" sid="JOB 2:11"/>عَيُبَ بٌورٍ سَشَنيِيٍ تٌ عَ شَ تْورّ شَ قٍ مّ، عٍ نَشَ كٍلِ عٍ شْنيِ سِفَقٍ رَ عَيُبَ يِرٍ. عٍ شِلِ؛ عٍلِقَسِ تٍمَنكَ، بِلِدَدَ سُوشَكَ، نُن سٌقَرَ نَامَكَ. عٍ نَشَ لُ يِرٍ كٍرٍن، عٍ لَن قٍ كٍرٍن مَ، عٍ شَ سَ عَيُبَ كُنقَ بَ، عٍ شَ عَ مَدُندُ. <verse eid="JOB 2:11"/><verse number="12" style="v" sid="JOB 2:12"/>عٍ تٌ سَ عَ تٌ كٍلِ يِرٍ مَكُيٍ، عٍ نَشَ سَن عَ مَ، عٍ بْنبْ فبٍلٍفبٍلٍقٍ رَ. عٍ نَشَ عٍ شَ دٌنمَيٍ عِبْو عٍ مَ، عٍ شُبٍ مَسٌ عٍ مَ سُننُنيِ كُي. <verse eid="JOB 2:12"/><verse number="13" style="v" sid="JOB 2:13"/>عٍ نَشَ دْشْ عَيُبَ سّيتِ مَ بْشِ، هَن شِ سٌلٌقٍرٍ. مِشِ يٌ مُ وْيّن كٍرٍن قَلَ عَ بّ، بَرِ مَ عٍ عَ تٌ نّ، عَ شَ تْورّ نُ فبٌ كِ قَنيِ رَ.<verse eid="JOB 2:13"/></para>
  <chapter eid="JOB 2"/>
  <chapter number="3" style="c" sid="JOB 3"/>
  <para style="s1">عَيُبَ شَ مَسٍنيِ</para>
  <para style="s2">«عَيُبَ نِمِسَقٍ عَ شَ بَرِ رَ »</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 3:1"/>نَ بِرِن تٌ دَنفِ، عَيُبَ نَشَ عَ بَرِ لْشْي دَنكَ <verse eid="JOB 3:1"/><verse number="2" style="v" sid="JOB 3:2"/>يِ مَسٍنيِ رَ؛<verse eid="JOB 3:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 3:3"/>«ﭑ بَرِ لْشْي شَ نّيمُ دُنِحَ رَ.</para>
  <para style="q" vid="JOB 3:3">نَ كْي رَ عٍ نَشّ، ‹دِ شّمّ نَ عَ رَ.›<verse eid="JOB 3:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 3:4"/>عَلَ شَ نَ لْشْي قِندِ دِ مِ رَ،</para>
  <para style="q" vid="JOB 3:4">نَ لْشْي شَ نّيمُ عَ رَ،</para>
  <para style="q" vid="JOB 3:4">عَ شَ تْنيِ دْشْ سٌفٍ يَنبَقٍ رَ نَ لْشْي كُي.<verse eid="JOB 3:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 3:5"/>عَلَ شَ نَ لْشْي قِندِ دِ مِ رَ،</para>
  <para style="q" vid="JOB 3:5">عَ شَ نُشُي عِقْورّ دُ سُ عَ شُن نَ،</para>
  <para style="q" vid="JOB 3:5">عَ شَ لُ دِ مِ مَفَاشُشِ كُي.<verse eid="JOB 3:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 3:6"/>عَلَ شَ نَ كْي عِقْورْ،</para>
  <para style="q" vid="JOB 3:6">عَ شَ نَ بَ كْنتِ رَ حّ كُي،</para>
  <para style="q" vid="JOB 3:6">عَ شَ نَ بَ كْنتِ رَ كِكٍ كُي.<verse eid="JOB 3:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 3:7"/>عَلَ شَ نَ كْي كُمَ دِ رَ،</para>
  <para style="q" vid="JOB 3:7">سّيوّ شُي يٌ نَشَ عِتٍ.<verse eid="JOB 3:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 3:8"/>عَ شَ قِندِ دَنكّ تِ سٍ رَ مَندُرُلَيٍ بّ،</para>
  <para style="q" vid="JOB 3:8">نَشٍيٍ نِنفِنَنفّ شِلِمَ.<verse eid="JOB 3:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 3:9"/>نَ لْشْي سُبَشّ تُنبُييٍ نَشَ يَنبَ،</para>
  <para style="q" vid="JOB 3:9">كُيٍ نَشَ عِبَ،</para>
  <para style="q" vid="JOB 3:9">نَءِيَلَنيِ يٌ نَشَ مِنِ،<verse eid="JOB 3:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 3:10"/>بَرِ مَ عَ مُ سٍسٍ رَبَ نَشَن</para>
  <para style="q" vid="JOB 3:10">نُ نْمَ ﭑ بَرِقٍ دَندٍ،</para>
  <para style="q" vid="JOB 3:10">نَشَن نُ نْمَ ﭑ نْشُندٍ ﭑ مَ تْورّ مَ.<verse eid="JOB 3:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="JOB 3:11"/>مُنقٍ رَ ﭑ نفَ قُرِ مُ بِرَ نُ؟</para>
  <para style="q" vid="JOB 3:11">مُنقٍ رَ ﭑ مُ قَشَ نُ بٍينُ ﭑ شَ بَرِ؟<verse eid="JOB 3:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 3:12"/>مُنقٍ رَ ﭑ نفَ ﭑ نَسّنّشِ عَ سَن مَ،</para>
  <para style="q" vid="JOB 3:12">عَ شِحّ قِ ﭑ مَ؟<verse eid="JOB 3:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 3:13"/>شَ نَ مُ عَ رَ، يِ تّمُي ﭑ بّلّشِ بْحّسَ كُي نُ<verse eid="JOB 3:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 3:14"/>مَنفّيٍ نُن رَ سِمَيٍ قّ مَ،</para>
  <para style="q" vid="JOB 3:14">نَشٍيٍ شَ بَنشِيٍ بَرَ فّ كَنَدٍ،<verse eid="JOB 3:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 3:15"/>نَشٍيٍ نُ بَرَ شّيمَ نُن فبٍتِ فبٍفبٍ سْتْ.<verse eid="JOB 3:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 3:16"/>مُنقٍ رَ عٍ مُ ﭑ نَفَتَ،</para>
  <para style="q" vid="JOB 3:16">عَلْ دِيْرّ نَشَن مُ وَشِ،</para>
  <para style="q" vid="JOB 3:16">نَشَن مُ مِنِ كّنّ مَ؟<verse eid="JOB 3:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 3:17"/>فَبُرِ تَن كُي، مِشِ حَاشِيٍ مُ نْمَ سٍسٍ رَ،</para>
  <para style="q" vid="JOB 3:17">مِشِ تَفَنشِيٍ عٍ مَلَبُمَ نّ.<verse eid="JOB 3:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 3:18"/>كٌنيِيٍ بْحّسَ سْتْمَ نّ،</para>
  <para style="q" vid="JOB 3:18">عٍ مُ عٍ كَنيِ شُي مّمَ فَبُرِ كُي.<verse eid="JOB 3:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 3:19"/>دِ مّدِيٍ نُن قٌرِيٍ نَ مّننِ،</para>
  <para style="q" vid="JOB 3:19">كٌنيِيٍ عٍ يّتّ سْتْمَ نَا.<verse eid="JOB 3:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="JOB 3:20"/>مُنقٍ رَ عَلَ عَ نِيَمَ عَدَ مَدِيٍ شَ مِنِ كّنّ مَ،</para>
  <para style="q" vid="JOB 3:20">نَشٍيٍ قِندِ تْورْ مِشِيٍ رَ،</para>
  <para style="q" vid="JOB 3:20">نَشٍيٍ نِمِسَشِ عٍ شَ دُنِحّءِفِرِ كُي،<verse eid="JOB 3:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 3:21"/>نَشٍيٍ قَشّ شْلِ مَوَ مَ، كْنْ عٍ مُ قَشَ،</para>
  <para style="q" vid="JOB 3:21">نَشٍيٍ قَشّ قٍنمَ دَنفِ نَاقُلِ رَ،<verse eid="JOB 3:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 3:22"/>نَشٍيٍ حّلّشِنمَ فَبُرِ لِقٍ رَ؟<verse eid="JOB 3:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 3:23"/>مُنقٍ رَ مِشِ بَرِ مَ،</para>
  <para style="q" vid="JOB 3:23">عَلَ كِرَ بَلَنشِ نَشَن يَ رَ،</para>
  <para style="q" vid="JOB 3:23">عَلَ نَشَن نَشّتّنمَ يِرٍ بِرِن؟<verse eid="JOB 3:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 3:24"/>ﭑ مَ دٌنسٍ قِندِشِ ﭑ مَ تْورّ نَن نَ،</para>
  <para style="q" vid="JOB 3:24">ﭑ مَ مِنسٍ قِندِشِ ﭑ يَيٍ نَن نَ.<verse eid="JOB 3:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 3:25"/>ﭑ نَ فَاشُ قٍ نَشَن نَ،</para>
  <para style="q" vid="JOB 3:25">نَ نَن ﭑ لِمَ.</para>
  <para style="q" vid="JOB 3:25">قٍ نَشَن نَ ﭑ نَسّرّن،</para>
  <para style="q" vid="JOB 3:25">ﭑ نَ نَن سْتْمَ.<verse eid="JOB 3:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 3:26"/>بْحّسَ مُ نَ ﭑ بّ،</para>
  <para style="q" vid="JOB 3:26">ﭑ مُ نْمَ ﭑ سَبَرِدٍ.</para>
  <para style="q" vid="JOB 3:26">مَلَبُي مُ نَ ﭑ بّ، قٌ تْورّ.»<verse eid="JOB 3:26"/></para>
  <chapter eid="JOB 3"/>
  <chapter number="4" style="c" sid="JOB 4"/>
  <para style="s1">عٍلِقَسِ تٍمَنكَ شَ مَسٍنيِ سِنفٍ</para>
  <para style="s2">«تِنشِنتْي مُ تْورْ مَ»</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 4:1"/>عٍلِقَسِ تٍمَنكَ نَشَ عَ قَلَ،<verse eid="JOB 4:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 4:2"/>«عَيُبَ، عِ هَاكّ تٌ ﭑ بّ ﭑ شَ وْيّن.</para>
  <para style="q" vid="JOB 4:2">ﭑ مُ نْمَ دُندُدٍ.<verse eid="JOB 4:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 4:3"/>عِ بَرَ مِشِ فبٍفبٍ شَرَن،</para>
  <para style="q" vid="JOB 4:3">عِ بَرَ عٍ رَلِمَنِيَ.<verse eid="JOB 4:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 4:4"/>عِ شَ مَسٍنيِيٍ بَرَ مِشِيٍ مَلِ،</para>
  <para style="q" vid="JOB 4:4">عِ شَ وْيّنيِيٍ بَرَ عٍ سّنبّ سٌ.<verse eid="JOB 4:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 4:5"/>يَكْسِ عِ تَن نَن تٌ قَ نَ تْورْقٍ،</para>
  <para style="q" vid="JOB 4:5">لِمَنِيَ بَرَ بَ عِ تَن يِ.<verse eid="JOB 4:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 4:6"/>عِ مُ عِ شَشِلِ تِ عِ شَ دَنشَنِيَ رَ عَلَ مَ؟</para>
  <para style="q" vid="JOB 4:6">عِ مُ لَمَ عِ شَ تِنشِنيِ رَ؟<verse eid="JOB 4:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 4:7"/>عِ بَرَ مِشِ قَنيِ تٌ هَلَكِشِ تْورّ مَ؟</para>
  <para style="q" vid="JOB 4:7">تِنشِنتْي نْمَ بْنْدٍ؟<verse eid="JOB 4:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 4:8"/>ﭑ نَشَن نَكْرْ سِشِ، قٍ حَاشِ رَبَيٍ نَن تْورْ مَ.<verse eid="JOB 4:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 4:9"/>عَلَ عٍ شُن نَكَنَمَ عَ شَ شْنّ كُي.<verse eid="JOB 4:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 4:10"/>يّتّ شَ يِرِندِنيِ نُن بَرَتّ شَ حَرَندَنيِ مَفَاشُ،</para>
  <para style="q" vid="JOB 4:10">كْنْ عٍ حِنيِيٍ قَمَ نّ مَفِرَدٍ.<verse eid="JOB 4:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 4:11"/>يّتّ يَتِ قَشَمَ كَامّ رَ،</para>
  <para style="q" vid="JOB 4:11">عَ شَ دِيٍ يٍنسٍن يّ.»<verse eid="JOB 4:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="JOB 4:12"/>«مَسٍنيِ ندٍ بَرَ قَلَ ﭑ بّ عَ فُندٌ كِ مَ،</para>
  <para style="q" vid="JOB 4:12">ﭑ تُلِ بَرَ عَ مَكْلِكْلِ شُي مّ.<verse eid="JOB 4:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 4:13"/>شِيٍ سَ تّمُي كْي تَفِ،<verse eid="JOB 4:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 4:14"/>فَاشُي نَشَ ﭑ سُشُ هَن ﭑ قَتٍ نَشَ سّرّن.<verse eid="JOB 4:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 4:15"/>تُبَرِ ندٍ نَشَ دَنفِ ﭑ يَ عِ.</para>
  <para style="q" vid="JOB 4:15">ﭑ قَتٍ شَبٍيٍ نَشَ كٍلِ، عٍ تِ.<verse eid="JOB 4:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 4:16"/>تُبَرِ نُ تِشِ نَا.</para>
  <para style="q" vid="JOB 4:16">ﭑ عَ تٌ نّ، كْنْ مِشِ يٌ عَ رَ ﭑ مُ عَ كٌلٌن.</para>
  <para style="q" vid="JOB 4:16">ﭑ بَرَ مِشِ مَنِيّ تَن تٌ.</para>
  <para style="q" vid="JOB 4:16">ﭑ نَشَ شُي ندٍ مّ يِ مَكْلِكْلِ رَ،<verse eid="JOB 4:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 4:17"/>‹عَدَ مَدِ تِنشِن عَلَ يَ عِ؟ عَ سّنِيّن عَ مَرِفِ يَ عِ؟<verse eid="JOB 4:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 4:18"/>شَ عَلَ مُ لَ عَ شَ مَلٍكّيٍ رَ عَ شَ وَلِكّيٍ،</para>
  <para style="q" vid="JOB 4:18">شَ عَ تَنتَنيِ تٌمَ نٍيٍ مَ،<verse eid="JOB 4:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 4:19"/>عِبُنَدَ مَ فٌ، نَشَن يَءِلَنشِ بّندّ رَ،</para>
  <para style="q" vid="JOB 4:19">نَشَن نْمَ عِوُرُدٍ عَلْ كَارِ؟<verse eid="JOB 4:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 4:20"/>عَدَ مَدِيٍ قَشَمَ لْشْ يٌ لْشْ،</para>
  <para style="q" vid="JOB 4:20">سٍسٍ مُ نَ كَنَمَ.<verse eid="JOB 4:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 4:21"/>عٍ شَ سِمَيَ لُوتِ بٌلٌنمَ نّ،</para>
  <para style="q" vid="JOB 4:21">عٍ قَشَ قَهَامُتَرٍحَ كُي.›»<verse eid="JOB 4:21"/></para>
  <chapter eid="JOB 4"/>
  <chapter number="5" style="c" sid="JOB 5"/>
  <para style="s1">عٍلِقَسِ تٍمَنكَ شَ مَسٍنيِ قِرِن ندٍ</para>
  <para style="s2">«عَيُبَ، عَلَ مَشَندِ»</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 5:1"/>«يَكْسِ، عِ شَ شِلِ تِ عِ شُي عِتٍشِ رَ.</para>
  <para style="q" vid="JOB 5:1">ندٍ عِ يَابِمَ؟</para>
  <para style="q" vid="JOB 5:1">عِ سّنِيّنتْي مُندُن شِلِمَ؟<verse eid="JOB 5:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 5:2"/>فبّسّنشْننّيَ شَشِلِتَرٍ قَشَمَ نّ،</para>
  <para style="q" vid="JOB 5:2">تْونّ لْننِتَرٍ هَلَكِمَ نّ.<verse eid="JOB 5:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 5:3"/>ﭑ بَرَ شَشِلِتَرٍ ندٍ تٌ،</para>
  <para style="q" vid="JOB 5:3">عَ شَ قٍ سْونّيَمَ،</para>
  <para style="q" vid="JOB 5:3">كْنْ نَ عِكْرّشِ رَ ﭑ نَشَ يِ دَنكّ بِرَ عَ قْشْ رَ.<verse eid="JOB 5:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 5:4"/>‹مَلِ بِرِن شَ بَ عَ شَ دِيٍ يِ رَ،</para>
  <para style="q" vid="JOB 5:4">كِيتِ شَ كَنَ عٍ رَ،</para>
  <para style="q" vid="JOB 5:4">مِشِ يٌ نَشَ عٍ مَلِ نَ كُي.<verse eid="JOB 5:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 5:5"/>كَامّتْييٍ شَ عَ شَ شّ دٌن،</para>
  <para style="q" vid="JOB 5:5">عٍ شَ بَلٌي بِرِن بَ عَ يِ رَ هَلِ نَشَن نَ تُنبٍ شْورَ.</para>
  <para style="q" vid="JOB 5:5">مِشِيٍ شَ مِلَ عَ شَ نَاقُلِ مَ، عٍ شَ عَ بَ عَ يِ.›<verse eid="JOB 5:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 5:6"/>تْورّ نُن حَشَنكَتّ قَمَ نّ.<verse eid="JOB 5:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 5:7"/>عَدَ مَدِ تْورْ مَ نّ عَ شَ دُنِحّءِفِرِ كُي.</para>
  <para style="q" vid="JOB 5:7">نَ مُ كَنَمَ، عَلْ تّ نَ رَدّشّ،</para>
  <para style="q" vid="JOB 5:7">عَ قُلٍقُلٍ تٍقٍ قَن تٌ مُ كَنَمَ.<verse eid="JOB 5:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 5:8"/>شَ ﭑ تَن نَن عَ رَ نُ، ﭑ عَلَتَلَ نَن مَشَندِ مَ،</para>
  <para style="q" vid="JOB 5:8">ﭑ نَن ﭑ مَ تْورّ مَسٍن عَ بّ.<verse eid="JOB 5:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 5:9"/>عَ كَابَنَكٌي رَبَمَ،</para>
  <para style="q" vid="JOB 5:9">عَ شَ قٍ شُنفبٍيٍ مُ كْنتِمَ.<verse eid="JOB 5:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 5:10"/>عَ تُنّ رَفٌرٌ بْشِ مَ،</para>
  <para style="q" vid="JOB 5:10">عَ يٍ رَ سِفَ شّ مَ.<verse eid="JOB 5:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 5:11"/>عَ تْورْ مِشِ شَ قٍ عِتٍمَ،</para>
  <para style="q" vid="JOB 5:11">عَ مِشِ سُننُنشِ رَكِسِمَ.<verse eid="JOB 5:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 5:12"/>عَ مِشِ كْوتَشِ شَ قٍ شُن نَكَنَمَ،</para>
  <para style="q" vid="JOB 5:12">عَلَكٌ عٍ وَشْنقٍ نَشَ سْونّيَ.<verse eid="JOB 5:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 5:13"/>عَ مِشِ مَدَشُي سُشُمَ فَنتَنيِ رَ،</para>
  <para style="q" vid="JOB 5:13">عَ يَنقَنتٍ وَشْنقٍ كَنَمَ.<verse eid="JOB 5:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 5:14"/>عٍ شَ يَنيِ قِندِ مَ عٍ بّ دِ مِ رَ،</para>
  <para style="q" vid="JOB 5:14">عٍ لُمَ عَلْ دْنشُي نَشٍيٍ مُ سٍ تٌمَ.<verse eid="JOB 5:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 5:15"/>عَلَتَلَ تْورْ مِشِ رَتَنفَمَ وْيّن شْرْشْي مَ،</para>
  <para style="q" vid="JOB 5:15">نَشَن كٍلِمَ يَنقَنتٍيٍ دّ كُي.</para>
  <para style="q" vid="JOB 5:15">عَ عٍ رَتَنفَمَ سّنبّمَ شَ قٍ حَاشِ مَ.<verse eid="JOB 5:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 5:16"/>شَشِلِ تِدٍ لُمَ نّ تْورْ مِشِ بّ.</para>
  <para style="q" vid="JOB 5:16">تِنشِنتَرٍ دّ بَلَنمَ نّ.<verse eid="JOB 5:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 5:17"/>حّلّشِنيِ نَ عَدَ مَ بّ عَلَ نَشَن شُرُ مَ.</para>
  <para style="q" vid="JOB 5:17">وٌ نَشَ تٌندِ عَلَ سّنبّ كَنيِ شَ شُرُي رَ،<verse eid="JOB 5:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 5:18"/>بَرِ مَ عَ قِ نَشَن سَمَ مِشِ مَ، عَ نَ قَن دَندَنمَ،</para>
  <para style="q" vid="JOB 5:18">عَ قٍ شْنّ نَشَن نَمِنِمَ، عَ نَ رَيَلَنمَ.<verse eid="JOB 5:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 5:19"/>عَ مُ تٌندِ مَ عِ رَتَنفَدٍ تْورّ مَ،</para>
  <para style="q" vid="JOB 5:19">عَ عِ رَكِسِمَ تْورّ بِرِن كُي.<verse eid="JOB 5:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 5:20"/>كَامّ نَ سِن بْشِ مَ، عَ عِ رَتَنفَمَ نّ قَشّ مَ،</para>
  <para style="q" vid="JOB 5:20">فٍرٍ نَ مِنِ، عَ عِ رَتَنفَمَ سَنتِدّفّمَ مَ.<verse eid="JOB 5:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 5:21"/>عَ عِ رَتَنفَمَ نّ وْيّن حَاشِ مَ،</para>
  <para style="q" vid="JOB 5:21">عَ عِ بَ فبَلٌي كُي.<verse eid="JOB 5:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 5:22"/>عِ مُ فَاشُمَ كَامّ يَ رَ،</para>
  <para style="q" vid="JOB 5:22">عِ مُ سّرّنمَ سُبٍ شَاحّ يَ رَ،<verse eid="JOB 5:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 5:23"/>بَرِ مَ سَاتّ لُمَ نّ عِ نُن دُنِحَ كُي عِسٍيٍ تَفِ،</para>
  <para style="q" vid="JOB 5:23">فّمّيٍ نُن سُبٍيٍ مُ عِ تْورْ مَ سْنْن.<verse eid="JOB 5:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 5:24"/>بْحّسَ لُمَ نّ عِ شْنيِ،</para>
  <para style="q" vid="JOB 5:24">مُحّ يٌ مُ تِمَ عِ شَ فْورّ.<verse eid="JOB 5:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 5:25"/>عِ شَ دِيٍ وُيَمَ نّ،</para>
  <para style="q" vid="JOB 5:25">عِ بْنسْي فبٌمَ نّ عَلْ بُرُنيِ سّشّ.<verse eid="JOB 5:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 5:26"/>عِ مُ فَبُرِ لِمَ، عِ شَ سِمَيَ مُ كَمَلِشِ،</para>
  <para style="q" vid="JOB 5:26">عَلْ مَالٍ قَن تٌ مُ شَبَمَ عَ شَبَ تّمُي مُ عَ لِشِ.<verse eid="JOB 5:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 5:27"/>مُشُ بَرَ يِ نْندِ كٌلٌن،</para>
  <para style="q" vid="JOB 5:27">عِ قَن شَ عَ رَ مّ، عِ شَ عَ قَهَامُ.»<verse eid="JOB 5:27"/></para>
  <chapter eid="JOB 5"/>
  <chapter number="6" style="c" sid="JOB 6"/>
  <para style="s1">عَيُبَ شَ مَسٍنيِ سِنفٍ</para>
  <para style="s2">«ﭑ مَ تْورّ فبٌ ﭑ مَ قٍ حَاشِيٍ بّ.»</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 6:1"/>عَيُبَ نَشَ عَ يَابِ،<verse eid="JOB 6:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 6:2"/>«شَ ﭑ مَ تْورّ سَ مَنِيَمَ نُ،</para>
  <para style="q" vid="JOB 6:2">شَ عَ سَ سَمَ سِكٍيلِ مَ نُ،<verse eid="JOB 6:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 6:3"/>عَ بِنيّ دَنفِمَ نّ بَا مّيّنيِ رَ.</para>
  <para style="q" vid="JOB 6:3">نَ نَن عَ تٌشِ يُسِ يٌ مُ نَ ﭑ مَ وْيّنيِيٍ مَ.<verse eid="JOB 6:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 6:4"/>عَلَ سّنبّ كَنيِ شَ تَنبّ بَرَ ﭑ سْشْ،</para>
  <para style="q" vid="JOB 6:4">نَ شْنّ بَرَ تٍ ﭑ شَشِلِ رَ.</para>
  <para style="q" vid="JOB 6:4">عَلَ نَ ﭑ فٍرٍقٍ عَ حَاشِ رَ.<verse eid="JOB 6:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 6:5"/>حٌوفٍ قَنشِ دّننَشّ، سٌقَلٍ وَ مَ مّننِ؟</para>
  <para style="q" vid="JOB 6:5">نِنفٍ وَ شُي مّيمَ عَ شَ دٌنسٍ يَ عِ؟<verse eid="JOB 6:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 6:6"/>بَندٍ دٌنمَ قْشّ شَنبِ؟</para>
  <para style="q" vid="JOB 6:6">تْشّلّ حِنتَرٍ حْشُن؟<verse eid="JOB 6:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 6:7"/>ﭑ مُ نُ وَ مَ نَشَن شْن،</para>
  <para style="q" vid="JOB 6:7">نَ بَرَ قِندِ ﭑ بَلٌي رَ هَلِ نَ قَ كَنَشِ.<verse eid="JOB 6:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 6:8"/>عَلَ شَ ﭑ مَ دُبّ سُشُ ﭑ بّ،</para>
  <para style="q" vid="JOB 6:8">عَ شَ ﭑ وَشْنقٍ رَكَمَلِ.<verse eid="JOB 6:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 6:9"/>عَلَ شَ ﭑ شُن نَكَنَ،</para>
  <para style="q" vid="JOB 6:9">عَ شَ ﭑ قَشَ.<verse eid="JOB 6:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 6:10"/>نَ كُي، ﭑ مَدُندُي سْتْمَ نّ،</para>
  <para style="q" vid="JOB 6:10">هَلِ ﭑ تٌ يِ تْورّ بِرِن كٌلٌنشِ،</para>
  <para style="q" vid="JOB 6:10">ﭑ سّيوَ ﭑ تٌ مُ فبِلٍن عَلَ سّنِيّنتْي شَ يَامَرِ قْشْ رَ.<verse eid="JOB 6:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 6:11"/>ﭑ نَن ﭑ شَشِلِ تِمَ سّنبّ مُندُن نَ قَ؟</para>
  <para style="q" vid="JOB 6:11">ﭑ مَ دِحّ مُنسٍ قَنمَ ﭑ مَ سْنْن؟<verse eid="JOB 6:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 6:12"/>ﭑ سّنبّ فبٌ عَلْ قَنيٍ؟</para>
  <para style="q" vid="JOB 6:12">ﭑ قَتٍ شْرْشْ عَلْ وُرٍ؟<verse eid="JOB 6:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 6:13"/>ندٍ نْمَ ﭑ مَلِدٍ؟</para>
  <para style="q" vid="JOB 6:13">سّنبّ مُندُن لُشِ ﭑ مَ؟»<verse eid="JOB 6:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="JOB 6:14"/>«تْورْ مِشِ هَيِ نَ عَ دُفُتّفّ شَ مَلِ مَ،</para>
  <para style="q" vid="JOB 6:14">هَلِ نَ مُ سَ فَاشُمَ عَلَ سّنبّ كَنيِ يَ رَ.<verse eid="JOB 6:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 6:15"/>ﭑ نفَشَكٍرٍنيِيٍ بَرَ ﭑ يَنقَ،</para>
  <para style="q" vid="JOB 6:15">عَلْ شُرٍ نَشَن شْرِ مَ.<verse eid="JOB 6:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 6:16"/>حّمّ تّمُي، يٍ بَنبَرَن يّ، عَ رَدُندَ،<verse eid="JOB 6:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 6:17"/>كْنْ سٌفٌقُرٍ رَ، يٍ بِرِن شْرِ.<verse eid="JOB 6:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 6:18"/>بِيَاسِلَيٍ كِرَ بَمَ عَ مَ يٍ قٍنقٍ رَ،</para>
  <para style="q" vid="JOB 6:18">عٍ قَ لْي فبٍنفبٍرٍن يِرٍ.<verse eid="JOB 6:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 6:19"/>تٍمَ بِيَاسِلَيٍ عٍ شُن تِمَ يٍ يِرٍ رَ.</para>
  <para style="q" vid="JOB 6:19">سٍيبَكَيٍ قَن عٍ شَشِلِ تِمَ نَ شُرٍ رَ،<verse eid="JOB 6:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 6:20"/>كْنْ عٍ نَ مّننِ لِ، عٍ شُرٍ شْرِشِ نَن تٌمَ.</para>
  <para style="q" vid="JOB 6:20">نَ كُي لِمَنِيَ بَمَ نّ عٍ يِ رَ.<verse eid="JOB 6:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 6:21"/>وٌ لُشِ نَ كِ نّ ﭑ بّ.</para>
  <para style="q" vid="JOB 6:21">وٌ بَرَ فَاشُ ﭑ مَ تْورّ يَ رَ.<verse eid="JOB 6:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 6:22"/>ﭑ شٌرٌ نُ، ﭑ نُ وٌ مَكُلَ نّ،</para>
  <para style="q" vid="JOB 6:22">وٌ شَ ﭑ شُن سَرَ وٌ شَ نَاقُلِ ندٍ رَ؟<verse eid="JOB 6:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 6:23"/>ﭑ وٌ مَكُلَ نّ،</para>
  <para style="q" vid="JOB 6:23">وٌ شَ ﭑ شُن سَرَ ﭑ يَشُي فبٍيلِ ندٍ مَ؟<verse eid="JOB 6:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 6:24"/>وٌ ﭑ شَرَن.</para>
  <para style="q" vid="JOB 6:24">وٌ ﭑ مَ تَنتَنيِ مَسٍن ﭑ بّ،</para>
  <para style="q" vid="JOB 6:24">عَلَكٌ ﭑ شَ ﭑ سَبَرِ.<verse eid="JOB 6:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 6:25"/>نْندِ تَن مُ مِشِ يٌ تْورْ مَ.</para>
  <para style="q" vid="JOB 6:25">كْنْ وٌ شَ مَسٍنيِيٍ تَن قَلَ شُن؟<verse eid="JOB 6:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 6:26"/>وٌ بَرَ كِيتِ سَ،</para>
  <para style="q" vid="JOB 6:26">وٌ مُ وٌ تُلِ مَتِشِ تْورْ مِشِ تَن شَ وْيّنيِ رَ.<verse eid="JOB 6:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 6:27"/>وٌ قَتَ كِيتِ حَاشِ سَدٍ كِرِدِيٍ مَ.</para>
  <para style="q" vid="JOB 6:27">وٌ مُ يَنقَنتٍيَ بَ وٌ بٌورٍ يّتّ يَتِ رَ.<verse eid="JOB 6:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 6:28"/>كْسِ قَ يَندِ، وٌ وٌ يَ تِ ﭑ نَ.</para>
  <para style="q" vid="JOB 6:28">ﭑ مُ وُلٍ قَلَمَ وٌ بّ.<verse eid="JOB 6:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 6:29"/>وٌ شَ كِيتِ تِنشِنشِ سَ،</para>
  <para style="q" vid="JOB 6:29">عَلَكٌ ﭑ شِلِ قَنيِ نَشَ كَنَ.<verse eid="JOB 6:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="JOB 6:30"/>وٌ قٍ قَلّ حَاشِ مّمَ ﭑ نَ؟</para>
  <para style="q" vid="JOB 6:30">ﭑ مُ قَتَ قٍ قَنيِ نُن قٍ حَاشِ تَفِ رَ سَدٍ؟»<verse eid="JOB 6:30"/></para>
  <chapter eid="JOB 6"/>
  <chapter number="7" style="c" sid="JOB 7"/>
  <para style="s1">عَيُبَ شَ مَسٍنيِ سِنفٍ دّ عِدْشْي</para>
  <para style="s2">«عَ عَ مَوَقٍ عَلَ بّ»</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 7:1"/>«مِشِ شَ قٍ مُ لُشِ شّ دُنِحَ مَ عَلْ سْورِ؟</para>
  <para style="q" vid="JOB 7:1">عَ شَ دُنِحّءِفِرِ مُ لُشِ شّ عَلْ وَلِكّ؟<verse eid="JOB 7:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 7:2"/>كٌنيِ فبَتَمَ كْي شَ سٌ،</para>
  <para style="q" vid="JOB 7:2">وَلِكّ فبَتَمَ عَ سَرٍ رَ.<verse eid="JOB 7:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 7:3"/>ﭑ تَن قَن، ﭑ كّ بَرَ قِندِ تْورّ رَ،</para>
  <para style="q" vid="JOB 7:3">ﭑ مَ وَلِ سَرٍ بَرَ قِندِ شْنّ رَ.<verse eid="JOB 7:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 7:4"/>ﭑ نّ ﭑ سَمَ، ﭑ لُ رَ عَ مَنّ،</para>
  <para style="q" vid="JOB 7:4">‹ﭑ كٍلِمَ تّمُي مُندُن؟›</para>
  <para style="q" vid="JOB 7:4">شِشْلِ مُ ﭑ تَن بّ،</para>
  <para style="q" vid="JOB 7:4">تْورّ نَن تُن عَ رَ كْي بِرِن كُي.<verse eid="JOB 7:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 7:5"/>كُلِ دِنقٍ ﭑ قَتٍ رَ،</para>
  <para style="q" vid="JOB 7:5">ﭑ كِرِ نَ بْرْقٍ، يَلٍيٍ تِقٍ عَ مَ.<verse eid="JOB 7:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 7:6"/>ﭑ مَ سِمَيَ شُلُن مَبْي شَ مَبْي وُرِ بّ.<verse eid="JOB 7:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 7:7"/>عَلَ، عِ شَ رَتُ عَ مَ ﭑ مَ سِمَيَ حّنفِ نَن تُن عَ رَ،</para>
  <para style="q" vid="JOB 7:7">ﭑ يَيٍ مُ قٍ قَنيِ تٌمَ كْرّ.<verse eid="JOB 7:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 7:8"/>يَ نَشَن تِشِ ﭑ نَ،</para>
  <para style="q" vid="JOB 7:8">نَ مُ ﭑ تٌمَ سْنْن،</para>
  <para style="q" vid="JOB 7:8">عَ فبٍ مُ لُشِ ﭑ شَ لْي عِ مَ.<verse eid="JOB 7:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 7:9"/>كُندَ نَ تٍ، عَ مَن لْي.</para>
  <para style="q" vid="JOB 7:9">عَدَ مَدِ قَن نَ سِفَ عَلِفِيَمَ، عَ مُ فبِلٍنمَ قَ رَ.<verse eid="JOB 7:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 7:10"/>عَ مُ فبِلٍنمَ عَ شْنيِ سْنْن،</para>
  <para style="q" vid="JOB 7:10">عَ شَ قْشْي مُ رَتُمَ عَ شَ قٍ مَ سْنْن.<verse eid="JOB 7:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 7:11"/>نَ نَن عَ تٌشِ ﭑ مُ ﭑ دّ سُشُمَ،</para>
  <para style="q" vid="JOB 7:11">ﭑ نَن ﭑ مَ تْورّ عِقَلَمَ نّ،</para>
  <para style="q" vid="JOB 7:11">ﭑ نَن ﭑ مَوَ ﭑ مَ شْرْرْي كُي.<verse eid="JOB 7:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 7:12"/>ﭑ قِندِشِ عِ بّ بَا نَن نَ،</para>
  <para style="q" vid="JOB 7:12">شَ نَ مُ عَ رَ، دَالِسٍ شُن سٌلٌقٍرٍ كَنيِ،</para>
  <para style="q" vid="JOB 7:12">عِ تٌ قَ بِرَشِ ﭑ مَ قٍ قْشْ رَ يِ مْولِ رَ؟<verse eid="JOB 7:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 7:13"/>ﭑ نَ عَ قَلَ، ‹ﭑ شَ ﭑ سَ، ﭑ شَ شِ، عَلَكٌ ﭑ شَ ﭑ مَ تْورّ مَيَنقَ،›<verse eid="JOB 7:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 7:14"/>عِ ﭑ مَفَاشُ شِيٍ نُن لَامَتُنيِ حَاشِيٍ رَ.<verse eid="JOB 7:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 7:15"/>قَشّ نَن تُن شْلِ قَ ﭑ مَ تٌ،</para>
  <para style="q" vid="JOB 7:15">دَنفِ يِ شْرِيٍ رَ نَشٍيٍ لُشِ ﭑ بّ يِ كِ.<verse eid="JOB 7:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 7:16"/>ﭑ مَ سِمَيَ بَرَ رَحَاشُ ﭑ مَ،</para>
  <para style="q" vid="JOB 7:16">ﭑ مُ وَ مَ بُقٍ دُنِحَ مَ سْنْن.</para>
  <para style="q" vid="JOB 7:16">ﭑ بّحِن، ﭑ نِي تِدٍ مُ نَ سْنْن.<verse eid="JOB 7:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 7:17"/>مُنسٍ نَ عَدَ مَ رَ</para>
  <para style="q" vid="JOB 7:17">نَشَن عَ نِيَمَ عِ شَ عِ حْشْ سَ عَ شْن مَ،<verse eid="JOB 7:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 7:18"/>عِ نُ عَ مَتٌ تّمُي بِرِن؟<verse eid="JOB 7:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 7:19"/>عِ عِ يَيٍ بَمَ ﭑ نَ تّمُي مُندُن؟</para>
  <para style="q" vid="JOB 7:19">عِ ﭑ لُمَ ﭑ يّتّ رَ مُن لْشْي؟<verse eid="JOB 7:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 7:20"/>شَ ﭑ بَرَ يُنُبِ رَبَ عِ رَ،</para>
  <para style="q" vid="JOB 7:20">نَ قَلَ ﭑ بّ، عِ تَن نَشَن عَدَ مَدِ مَتٌمَ.</para>
  <para style="q" vid="JOB 7:20">ﭑ تَن يٍفٍتِشِ عِ يِ رَ مُنقٍ رَ مَتٌي رَ؟<verse eid="JOB 7:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 7:21"/>مُنقٍ رَ عِ مُ دِحّ ﭑ مَ قٍ كٌبِ مَ؟</para>
  <para style="q" vid="JOB 7:21">مُنقٍ رَ عِ مُ ﭑ مَ يُنُبِ شَقَرِ؟</para>
  <para style="q" vid="JOB 7:21">عَ فبٍ مُ لُشِ ﭑ شَ قِندِ بّندّ رَ.</para>
  <para style="q" vid="JOB 7:21">نَ تّمُي عِ مُ ﭑ تٌمَ سْنْن.»<verse eid="JOB 7:21"/></para>
  <chapter eid="JOB 7"/>
  <chapter number="8" style="c" sid="JOB 8"/>
  <para style="s1">بِلِدَدَ سُوشَكَ شَ مَسٍنيِ سِنفٍ</para>
  <para style="s2">«هَاكّ مُ سِفَمَ عَلِفِيَمَ.»</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 8:1"/>بِلِدَدَ سُوشَكَ نَشَ عَ مَسٍن،<verse eid="JOB 8:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 8:2"/>«عِ يِ وْيّنيِ مْولِ قَلَمَ هَن تّمُي مُندُن؟</para>
  <para style="q" vid="JOB 8:2">عِ شَ وْيّنيِ لُشِ نّ عَلْ قٌيٍ.<verse eid="JOB 8:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 8:3"/>عَلَ نْمَ نْندِ مَقِندِدٍ وُلٍ رَ؟</para>
  <para style="q" vid="JOB 8:3">عَلَ سّنبّ كَنيِ نْمَ تِنشِنيِ عِقُدٍ؟<verse eid="JOB 8:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 8:4"/>شَ عِ شَ دِيٍ يُنُبِ نَن نَبَشِ عَ رَ،</para>
  <para style="q" vid="JOB 8:4">عَ عٍ حَشَنكَتَشِ نَ نَن مَ.<verse eid="JOB 8:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 8:5"/>شَ عِ تَن عَلَ قٍنمَ،</para>
  <para style="q" vid="JOB 8:5">شَ عِ عَلَ سّنبّ كَنيِ مَكُلَمَ،<verse eid="JOB 8:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 8:6"/>شَ يُنُبِ مُ نَ عِ مَ،</para>
  <para style="q" vid="JOB 8:6">شَ عِ تِنشِن،</para>
  <para style="q" vid="JOB 8:6">عَلَ عَ حّنفِ سَمَ نّ عِ شْن مَ،</para>
  <para style="q" vid="JOB 8:6">عَ عِ رَ سَبَتِ عِ شَ تِنشِنيِ كُي.<verse eid="JOB 8:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 8:7"/>عِ هَرِفٍ دْنشْي قَمَ دَنفِدٍ نَ سِنفٍ رَ.»<verse eid="JOB 8:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="JOB 8:8"/>«قَهَامُي قٍن وٌن بَبَيٍ رَ،</para>
  <para style="q" vid="JOB 8:8">عِ شَ شَشِلِ سْتْ نٍيٍ بٍنبَيٍ قَن نَ.<verse eid="JOB 8:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 8:9"/>وٌن تَن مُ بُشِ دُنِحَ مَ،</para>
  <para style="q" vid="JOB 8:9">شَشِلِ شْنكُيٍ مُ نَ وٌن بّ.<verse eid="JOB 8:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 8:10"/>عٍ مُ قَهَامُي قِمَ شّ عِ مَ؟</para>
  <para style="q" vid="JOB 8:10">عٍ عٍ شَشِلِ شَ مَسٍنيِيٍ تِمَ عِ بّ يِ كِ؛<verse eid="JOB 8:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 8:11"/>وٌقِرِ بُلَمَ شَرٍ مَ؟</para>
  <para style="q" vid="JOB 8:11">شُرٍ عِ بَارٍ قِندِ مَ عَ رَ يٍ مُ دّننَشّ؟<verse eid="JOB 8:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 8:12"/>هَلِ عَ نَ عَ بِلِ مَ، عَ مُ شَبَشِ،</para>
  <para style="q" vid="JOB 8:12">عَ لِسِمَ مَقُرٍن دَنفِ حٌوفٍ بِرِن نَ.<verse eid="JOB 8:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 8:13"/>نَ نَن قَمَ رَبَدٍ مِشِيٍ رَ،</para>
  <para style="q" vid="JOB 8:13">نَشٍيٍ نّيمُمَ عَلَ مَ.</para>
  <para style="q" vid="JOB 8:13">تِنشِنتَرٍ شَشِلِ تِدٍ حْنمَ نَ كِ نّ.<verse eid="JOB 8:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 8:14"/>عَ شَشِلِ تِدٍ بَرَ كَنَ،</para>
  <para style="q" vid="JOB 8:14">عَلْ مِشِ نَشَن عَ كِلْنمَ سَيّلّ تّي رَ.<verse eid="JOB 8:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 8:15"/>عَ نَ عَ كِلْن نَ رَ، عَ كَنَمَ نّ، عَ كَنيِ بِرَ.<verse eid="JOB 8:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 8:16"/>عَ لُمَ عَلْ سَنسِ، يٍ نَشَن كُي رَقٍشِ،</para>
  <para style="q" vid="JOB 8:16">عَ عَ سَلٌنيِ عِيَن سٌفٍ لِنلِنيِ يَ مَ لَاكْي شُن مَ،<verse eid="JOB 8:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 8:17"/>عَ عَ سَنكٍيٍ سْتِ فّمّ مَلَنشِ لٌنفٌرِ رَ.<verse eid="JOB 8:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 8:18"/>شَ عِ نَ سَنسِ تَلَ نَا،</para>
  <para style="q" vid="JOB 8:18">عَ لِسِمَ نّ،<verse eid="JOB 8:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 8:19"/>عَ مُ قَنمَ مّننِ سْنْن.</para>
  <para style="q" vid="JOB 8:19">سَنسِ فبّتّ مَن قَ بُلَ عَ نُ نَ دّننَشّ.<verse eid="JOB 8:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 8:20"/>عَلَ مُ تِنشِنتْي رَوْلّمَ،</para>
  <para style="q" vid="JOB 8:20">عَ مُ تِنشِنتَرٍ سّنبّ سٌمَ.<verse eid="JOB 8:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 8:21"/>عَ فبٍ مُ لُشِ عَ شَ عِ رَ سّيوَ،</para>
  <para style="q" vid="JOB 8:21">عِ شَ مَتْشْي قَلّ رَ عِ قَمَ نَشَن تِدٍ.<verse eid="JOB 8:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 8:22"/>عِ شْنمِشِيٍ قَمَ لُدٍ يَافِ كُي،</para>
  <para style="q" vid="JOB 8:22">عٍ شْنيِيٍ قَ بِرَ.»<verse eid="JOB 8:22"/></para>
  <chapter eid="JOB 8"/>
  <chapter number="9" style="c" sid="JOB 9"/>
  <para style="s1">عَيُبَ شَ مَسٍنيِ قِرِن ندٍ</para>
  <para style="s2">«عَلَ شَ كِيتِ شْرْشْ»</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 9:1"/>عَيُبَ نَشَ عَ يَابِ،<verse eid="JOB 9:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 9:2"/>«ﭑ نَ بِرِن كٌلٌنشِ نْندِ رَ.</para>
  <para style="q" vid="JOB 9:2">عَلَ نْمَ نْندِ قِدٍ عَدَ مَ مَ دِ؟<verse eid="JOB 9:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 9:3"/>شَ عَلَ نَ كِيتِ سَقٍ،</para>
  <para style="q" vid="JOB 9:3">عَدَ مَ تَن مُ نْمَ عَ دّ تٌنفٌدٍ عَ كَنكٍ رَ.<verse eid="JOB 9:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 9:4"/>عَ تَن نَن فبٍ نَ لْننِ نُن سّنبّ رَ،</para>
  <para style="q" vid="JOB 9:4">ندٍ نْمَ تِدٍ عَ كَنكٍ؟<verse eid="JOB 9:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 9:5"/>عَلَ نْمَ فٍيَيٍ تَلَدٍ عٍ تِدٍ،</para>
  <para style="q" vid="JOB 9:5">عَ عٍ مَقِندِ عَ شَ شْنّ كُي.<verse eid="JOB 9:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 9:6"/>عَ نْمَ بْشِ بُنيِ رَ سّرّندٍ،</para>
  <para style="q" vid="JOB 9:6">عَ عَ بْو عَ رَ.<verse eid="JOB 9:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 9:7"/>عَ نْمَ سٌفٍ نُن تُنبُييٍ عِقْورْدٍ.<verse eid="JOB 9:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 9:8"/>عَ تَن نَن كٌورٍ عِتَلَ،</para>
  <para style="q" vid="JOB 9:8">عَ عَ حّرّ بَا مْرْنيِيٍ قَرِ.<verse eid="JOB 9:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 9:9"/>عَ تَن نَن تُنبُي بِرِن سَ،</para>
  <para style="q" vid="JOB 9:9">كَنكَن نَ عَ يِرٍ.<verse eid="JOB 9:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 9:10"/>عَ بَرَ قٍ شُنفبٍيٍ رَبَ</para>
  <para style="q" vid="JOB 9:10">وٌن مُ نْمَ نَشٍيٍ قَهَامُدٍ.</para>
  <para style="q" vid="JOB 9:10">عَ شَ كَابَنَكٌي مُ نْمَ كْنتِدٍ.<verse eid="JOB 9:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 9:11"/>عَ نْمَ دَنفِدٍ ﭑ سّيتِ مَ، ﭑ مُ عَ تٌ.</para>
  <para style="q" vid="JOB 9:11">عَ لْي، ﭑ مُ نْ عَ تٌدٍ.<verse eid="JOB 9:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 9:12"/>ندٍ نْمَ عَ شَ سٍ تٌنفٌشِ رَفبِلٍندٍ؟</para>
  <para style="q" vid="JOB 9:12">ندٍ نْمَ عَ قَلَدٍ عَ بّ، ‹عِ نَ مُنسٍ رَبَقٍ؟›<verse eid="JOB 9:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 9:13"/>عَلَ مُ فبِلٍنمَ عَ شَ شْنّ قْشْ رَ.</para>
  <para style="q" vid="JOB 9:13">يّتّ عِفبٌي شَشِلِ تِدٍ بِرِن بِرَ مَ عَ يَ عِ.<verse eid="JOB 9:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 9:14"/>ﭑ تَن، ﭑ عَ يَابِمَ دِ؟</para>
  <para style="q" vid="JOB 9:14">ﭑ وْيّن مْولِ مُندُن قَلَمَ عَ بّ؟<verse eid="JOB 9:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 9:15"/>هَلِ نْندِ سَ نَ ﭑ بّ، ﭑ مُ نْمَ تِدٍ عَ كَنكٍ.</para>
  <para style="q" vid="JOB 9:15">ﭑ مَ كِيتِسَ مَدِحّقٍ نَن تُن لُمَ ﭑ يِ.<verse eid="JOB 9:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 9:16"/>شَ ﭑ سَ عَ شِلِ، عَ نَشَ ﭑ يَابِ،</para>
  <para style="q" vid="JOB 9:16">ﭑ مُ لَمَ عَ رَ عَ بَرَ عَ تُلِ مَتِ ﭑ نَ،<verse eid="JOB 9:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 9:17"/>بَرِ مَ عَ بَرَ ﭑ تْورْ عَ فبٍ رَ،</para>
  <para style="q" vid="JOB 9:17">عَ بَرَ ﭑ حَشَنكَتَ نَ كِ تُن.<verse eid="JOB 9:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 9:18"/>عَ مُ ﭑ لُمَ ﭑ شَ مَلَبُ،</para>
  <para style="q" vid="JOB 9:18">عَ بَرَ ﭑ مَ شْنّ شُن مَسَ عَ حَاشِ رَ<verse eid="JOB 9:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 9:19"/>ﭑ مُ نْمَ عَ رَ،</para>
  <para style="q" vid="JOB 9:19">بَرِ مَ عَ سّنبّ فبٌ ﭑ بّ.</para>
  <para style="q" vid="JOB 9:19">مُشُ نُن عَلَ مُ نْمَ مَكِيتِدٍ،</para>
  <para style="q" vid="JOB 9:19">بَرِ مَ كِيتِسَ مُ نَ مُشُ تَفِ.<verse eid="JOB 9:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 9:20"/>هَلِ ﭑ سَ تِنشِن نُ، ﭑ دّ مُ نْندِ قِمَ ﭑ مَ.</para>
  <para style="q" vid="JOB 9:20">هَلِ يُنُبِ مُ نَ ﭑ مَ نُ، ﭑ دّ كِيتِ رَكَنَمَ نّ ﭑ نَ.<verse eid="JOB 9:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 9:21"/>يُنُبِ نَ ﭑ مَ؟ ﭑ مُ عَ كٌلٌن</para>
  <para style="q" vid="JOB 9:21">ﭑ نِمِسَشِ ﭑ مَ دُنِحّءِفِرِ نَن تُن نَ.<verse eid="JOB 9:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 9:22"/>ﭑ تَن بّ، عَ بِرِن كٍرٍن،</para>
  <para style="q" vid="JOB 9:22">بَرِ مَ عَلَ تِنشِنتْي نُن تِنشِنتَرٍ بِرِن حَشَنكَتَمَ.<verse eid="JOB 9:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 9:23"/>فبَلٌي نَ تِنشِنتْي لِ،</para>
  <para style="q" vid="JOB 9:23">عَلَ مُ نَ تْورّ تٌمَ.<verse eid="JOB 9:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 9:24"/>تِنشِنتَرٍ نَ بْشِ ندٍ سْتْ تِنشِنتَرٍيَ كُي،</para>
  <para style="q" vid="JOB 9:24">عَلَ عَ نِيَمَ كِيتِسَيٍ شَ تِن نَ رَ.</para>
  <para style="q" vid="JOB 9:24">شَ عَلَ مُ عَ رَ، ندٍ عَ رَ قَ؟<verse eid="JOB 9:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 9:25"/>ﭑ مَ سِمَيَ شُلُن فِلَ بّ،</para>
  <para style="q" vid="JOB 9:25">عَ حْنمَ بٍينُن ﭑ شَ هّيرِ سْتْ.<verse eid="JOB 9:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 9:26"/>ﭑ مَ سِمَيَ دَنفِمَ عَلْ كُنكُي،</para>
  <para style="q" vid="JOB 9:26">عَلْ سّفّ نَشَن فٌرٌ مَ تْشّيْرّ مَ.<verse eid="JOB 9:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 9:27"/>ﭑ نَ عَ قَلَ،</para>
  <para style="q" vid="JOB 9:27">‹ﭑ شَ نّيمُ ﭑ مَ مَوَ مَ،</para>
  <para style="q" vid="JOB 9:27">ﭑ شَ بَ سُننُنشِ،</para>
  <para style="q" vid="JOB 9:27">ﭑ شَ ﭑ سّنبّ سٌ،›<verse eid="JOB 9:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 9:28"/>ﭑ مَ تْورّ نَن بِرِن لُمَ ﭑ مَفَاشُ رَ.</para>
  <para style="q" vid="JOB 9:28">ﭑ عَ كٌلٌن عِ مُ نْندِ قِمَ ﭑ مَ.<verse eid="JOB 9:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 9:29"/>ﭑ تٌ بَرَ يُنُبِ سْتْ،</para>
  <para style="q" vid="JOB 9:29">ﭑ نْندِ قٍنمَ ﭑ يّتّ بّ مُنقٍ رَ؟<verse eid="JOB 9:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="JOB 9:30"/>هَلِ ﭑ سَ ﭑ مَشَ نّ يٍ تِنسٍشِ رَ،</para>
  <para style="q" vid="JOB 9:30">هَلِ ﭑ سَ ﭑ بّلّشّيٍ مَشَ شْسِ بَ سٍ رَ،<verse eid="JOB 9:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="JOB 9:31"/>عِ ﭑ نَفٌرٌ مَ نّ بٌورَ،</para>
  <para style="q" vid="JOB 9:31">ﭑ شَ رَحَاشُ ﭑ مَ دُفِيٍ مَ.<verse eid="JOB 9:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="JOB 9:32"/>عَلَ مُ لُشِ عَلْ عَدَ مَدِ،</para>
  <para style="q" vid="JOB 9:32">ﭑ نْمَ نَشَن شِلِدٍ كِيتِ مَ،</para>
  <para style="q" vid="JOB 9:32">عَلَكٌ ﭑ شَ ﭑ فبٍ قَلَ،</para>
  <para style="q" vid="JOB 9:32">كِيتِسَ شَ كِيتِ سَ مُشُ تَفِ.<verse eid="JOB 9:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="JOB 9:33"/>كِيتِسَ يٌ مُ نَ</para>
  <para style="q" vid="JOB 9:33">نَشَن نْمَ كِيتِ سَدٍ ﭑ نُن عَلَ تَفِ.<verse eid="JOB 9:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="JOB 9:34"/>عَلَ شَ عَ شَ وُرِ بْنبْ تِ سٍ بَ ﭑ شُن مَ،</para>
  <para style="q" vid="JOB 9:34">عَ شَ عَ شَ قٍ مَفَاشُشِ بَ ﭑ يِ رَ،<verse eid="JOB 9:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="JOB 9:35"/>عَلَكٌ ﭑ شَ نْ وْيّندٍ عَ رَ فَاشُتَرٍحَ كُي.</para>
  <para style="q" vid="JOB 9:35">كْنْ ﭑ مَ قٍ تٌ مُ نَ كِ شّ، ﭑ شَ لُ ﭑ كٍرٍن.»<verse eid="JOB 9:35"/></para>
  <chapter eid="JOB 9"/>
  <chapter number="10" style="c" sid="JOB 10"/>
  <para style="s1">عَيُبَ شَ مَسٍنيِ قِرِن ندٍ دّ عِدْشْي</para>
  <para style="s2">«عَيُبَ مَشْرِنيِ تِقٍ عَلَ مَ»</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 10:1"/>«ﭑ مَ دُنِحّءِفِرِ بَرَ رَحَاشُ ﭑ نِي مَ.</para>
  <para style="q" vid="JOB 10:1">نَ كُي ﭑ شَ ﭑ فبٍ قَلَ.</para>
  <para style="q" vid="JOB 10:1">شْنّ نَشَن نَ ﭑ قُرِ كُي، ﭑ شَ نَ مَكّنّن.<verse eid="JOB 10:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 10:2"/>ﭑ بَرَ عَ قَلَ عَلَ بّ، عِ نَشَ ﭑ سُشُ.</para>
  <para style="q" vid="JOB 10:2">عِ شَ ﭑ نَكٌلٌن عِ ﭑ سُشُشِ قٍ نَشَن مَ.<verse eid="JOB 10:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 10:3"/>ﭑ تْورْقٍ رَقَن عِ مَ،</para>
  <para style="q" vid="JOB 10:3">ﭑ تَن نَشَن قِندِشِ عِ شَ دَالِسٍ رَ؟</para>
  <para style="q" vid="JOB 10:3">تِنشِنتَرٍ وَشْنقٍ رَقَن عِ مَ؟<verse eid="JOB 10:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 10:4"/>عِ قٍ تٌ كِ مُ مَكُيَ عَدَ مَدِ قٍ تٌ كِ رَ؟<verse eid="JOB 10:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 10:5"/>عِ شَ سِمَيَ مَنِيَ عَدَ مَدِ فبٍ رَ؟<verse eid="JOB 10:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 10:6"/>عِ ﭑ تْورْقٍ مُنقٍ رَ؟</para>
  <para style="q" vid="JOB 10:6">عِ نَ ﭑ مَ يُنُبِيٍ قٍنقٍ مُنقٍ رَ؟<verse eid="JOB 10:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 10:7"/>عِ حَن ﭑ مَ تِنشِنيِ كٌلٌن،</para>
  <para style="q" vid="JOB 10:7">عِ حَن عَ كٌلٌن مِشِ يٌ مُ ﭑ نَتَنفَمَ عِ بّلّشّ عِ.<verse eid="JOB 10:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 10:8"/>عِ تَن نَن ﭑ دَاشِ،</para>
  <para style="q" vid="JOB 10:8">عِ تَن نَن ﭑ سْنتْمَ.<verse eid="JOB 10:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 10:9"/>عِ شَ رَتُ عَ مَ عَ عِ ﭑ دَاشِ بّندّ نَن نَ.</para>
  <para style="q" vid="JOB 10:9">عِ مَن وَ مَ ﭑ نَفبِلٍنقٍ مّننِ نّ؟<verse eid="JOB 10:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 10:10"/>عِ بَرَ ﭑ يَءِلَن عَلْ مِشِ</para>
  <para style="q" vid="JOB 10:10">نَشَن شِحّ يَءِلَنمَ دٌنسٍ قَنيِ رَ.<verse eid="JOB 10:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 10:11"/>عِ بَرَ ﭑ قَتٍ بِرِن يَءِلَن،</para>
  <para style="q" vid="JOB 10:11">كِرِ، سُبٍ، شْرِ، نُن قَسّ.<verse eid="JOB 10:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 10:12"/>عِ بَرَ ﭑ مَ سِمَيَ شْن كُيَ،</para>
  <para style="q" vid="JOB 10:12">عِ بَرَ هِننّ ﭑ نَ،</para>
  <para style="q" vid="JOB 10:12">عِ بَرَ عِ حّنفِ سَ ﭑ نِي شْن مَ.»<verse eid="JOB 10:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="JOB 10:13"/>«كْنْ يَكْسِ ﭑ بَرَ عَ كٌلٌن</para>
  <para style="q" vid="JOB 10:13">نَشَن نُ نَ عِ شَشِلِ مَ ﭑ مَ قٍ رَ.<verse eid="JOB 10:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 10:14"/>عِ بَرَ وَ ﭑ مَ يُنُبِ تٌقٍ،</para>
  <para style="q" vid="JOB 10:14">عَلَكٌ عِ شَ تٌندِ دِحّدٍ ﭑ مَ.<verse eid="JOB 10:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 10:15"/>شَ يُنُبِ نَ ﭑ مَ، حَشَنكَتّ نَ ﭑ بّ.</para>
  <para style="q" vid="JOB 10:15">شَ يُنُبِ مُ نَ ﭑ مَ، ﭑ نَ يَافِ كُي،</para>
  <para style="q" vid="JOB 10:15">ﭑ مُ نْمَ ﭑ شُنيِ يَتِ رَكٍلِدٍ.<verse eid="JOB 10:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 10:16"/>شَ ﭑ سَ ﭑ شُنيِ رَكٍلِ،</para>
  <para style="q" vid="JOB 10:16">عِ ﭑ بْنبْمَ عِ سّنبّ مَفَاشُشِ رَ،</para>
  <para style="q" vid="JOB 10:16">عَلْ يّتّ سّنبّمَ عَ رَبَمَ كِ نَشّ.<verse eid="JOB 10:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 10:17"/>عِ شَ شْنّ نَ شُن مَسَقٍ ﭑ مَ قٍ رَ،</para>
  <para style="q" vid="JOB 10:17">عِ شَ حَشَنكَتّ بَرَ فبٌ يّ.<verse eid="JOB 10:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 10:18"/>عِ ﭑ نَمِنِشِ ﭑ نفَ تّيفّ عِ مُنقٍ رَ؟</para>
  <para style="q" vid="JOB 10:18">شَ ﭑ سَ قَشَ نَا نّ نُ، مِشِ يٌ مُ نُ ﭑ تٌمَ،<verse eid="JOB 10:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 10:19"/>ﭑ مُ بَلٌمَ نُ،</para>
  <para style="q" vid="JOB 10:19">ﭑ نُ تٌنفٌمَ نّ ﭑ نفَ تّيفّ،</para>
  <para style="q" vid="JOB 10:19">ﭑ نَفٌرٌ فَبُرِ كُي كٍرٍن نَ.<verse eid="JOB 10:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 10:20"/>نَشَن لُشِ ﭑ مَ سِمَيَ رَ، عَ مُ فبٌ سْنْن.</para>
  <para style="q" vid="JOB 10:20">يَندِ، عِ شَ فبِلٍن ﭑ قْشْ رَ قَ،</para>
  <para style="q" vid="JOB 10:20">سّيوّ دٌندٌرٌنتِ شَ لُ ﭑ بّ<verse eid="JOB 10:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 10:21"/>بٍينُ ﭑ شَ سِفَ عَلِفِيَمَ،</para>
  <para style="q" vid="JOB 10:21">دِ مِ نَ دّننَشّ.</para>
  <para style="q" vid="JOB 10:21">ﭑ مُ فبِلٍنمَ دُنِحَ مَ سْنْن.<verse eid="JOB 10:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 10:22"/>دِ مِ شُنفبٍ نَ عَلِفِيَمَ.</para>
  <para style="q" vid="JOB 10:22">عَدَ مَ شَشِلِ عِقُمَ نَا.</para>
  <para style="q" vid="JOB 10:22">مّننِ نَءِيَلَنيِ يَتِ نَن قِندِ مَ دِ مِ رَ.»<verse eid="JOB 10:22"/></para>
  <chapter eid="JOB 10"/>
  <chapter number="11" style="c" sid="JOB 11"/>
  <para style="s1">سٌقَرَ شَ مَسٍنيِ سِنفٍ</para>
  <para style="s2">«عَيُبَ، عِ شَ تُوبِ عَلَ مَ»</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 11:1"/>سٌقَرَ نَامَكَ نَشَ عَ قَلَ،<verse eid="JOB 11:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 11:2"/>«عَ مُ لَن مِشِ شَ عِ شَ يِ مَسٍنيِ فبٍفبٍ يَابِ؟</para>
  <para style="q" vid="JOB 11:2">مَسٍنيِ رَتٌقَنشِ مُ نْندِ قِمَ مَسٍنيِ مَ.<verse eid="JOB 11:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 11:3"/>عِ حْشْ عَ مَ عَ مِشِ دُندُ مَ عِ شَ وْيّنيِيٍ مَ،</para>
  <para style="q" vid="JOB 11:3">عِ شَ يٌ عَلَ مَ، مِشِ يٌ مُ عِ رَيَافِ؟<verse eid="JOB 11:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 11:4"/>عِ نَشّ، ‹سٍسٍ مُ لُشِ ﭑ مَ لْننِ رَ،</para>
  <para style="q" vid="JOB 11:4">ﭑ بَرَ سّنِيّن عَلَ يَ عِ.›<verse eid="JOB 11:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 11:5"/>شَ عَلَ سَ وْيّن عِ بّ نُ،<verse eid="JOB 11:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 11:6"/>عَ عَ شَ لْننِ فُندٌ مَسٍنمَ نّ عِ بّ،</para>
  <para style="q" vid="JOB 11:6">نَشَن دَنفِمَ عَدَ مَدِ شَ قٍ تٌ كِ رَ.<verse eid="JOB 11:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 11:7"/>عِ نْمَ عَلَ شَ تِلِنيِ كٌلٌندٍ؟</para>
  <para style="q" vid="JOB 11:7">عِ نْمَ عَلَ سّنبّ كَنيِ شَشِلِ بِرِن قَهَامُدٍ؟<verse eid="JOB 11:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 11:8"/>نَ لْننِ عِتٍ كٌورٍ شَ مَءِتٍ بّ،</para>
  <para style="q" vid="JOB 11:8">عَ تِلِن عَلِفِيَمَ بّ.</para>
  <para style="q" vid="JOB 11:8">عِ نْمَ سٌدٍ نَ كُي؟<verse eid="JOB 11:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 11:9"/>عَ كُيَ بْشِ بّ،</para>
  <para style="q" vid="JOB 11:9">عَ شَ فبٌي دَنفِ بَا رَ.<verse eid="JOB 11:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 11:10"/>شَ عَلَ سَ مِشِ سُشُ،</para>
  <para style="q" vid="JOB 11:10">عَ قَ عَ مَكِيتِ،</para>
  <para style="q" vid="JOB 11:10">نْندِ لُمَ نَ كَنيِ بّ؟<verse eid="JOB 11:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 11:11"/>عَلَ مِشِ حَاشِيٍ كٌلٌنمَ،</para>
  <para style="q" vid="JOB 11:11">عَ تِنشِنتَرٍيٍ تٌمَ.<verse eid="JOB 11:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 11:12"/>شَشِلِتَرٍ مُ نْمَ قِندِدٍ لْننِلَ رَ،</para>
  <para style="q" vid="JOB 11:12">عَلْ سٌقَلٍ قَن تٌ مُ نْمَ قِندِدٍ عَدَ مَدِ رَ.<verse eid="JOB 11:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 11:13"/>شَ عِ تَن عِ يّتّ رَفبِلٍن عَلَ مَ،</para>
  <para style="q" vid="JOB 11:13">شَ عِ عِ بّلّشّ عِتَلَ عَ بّ،<verse eid="JOB 11:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 11:14"/>شَ عِ فبِلٍن تِنشِنتَرٍيَ قْشْ رَ،</para>
  <para style="q" vid="JOB 11:14">شَ عِ عَ مَتَنفَ عِ شَ دٍنبَيَ كُي،<verse eid="JOB 11:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 11:15"/>نَ كُي عِ شُننَكٍلِ سْتْمَ نّ،</para>
  <para style="q" vid="JOB 11:15">عِ سّنبّ سْتْ، عِ لِمَنِيَ عَ قَنيِ رَ.<verse eid="JOB 11:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 11:16"/>نَ تّمُي عِ نّيمُمَ نّ عِ شَ تْورّ مَ،</para>
  <para style="q" vid="JOB 11:16">عَلْ شُرٍ نَشَن بَرَ دَنفِ عَ رَكُيَ.<verse eid="JOB 11:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 11:17"/>عِ شَ دُنِحّءِفِرِ يَنبَمَ نّ عَلْ سٌفٍ،</para>
  <para style="q" vid="JOB 11:17">عِ شَ دِ مِ بَمَ نّ، عَ لُ عَلْ كُيٍ نَ عِبَ.<verse eid="JOB 11:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 11:18"/>عِ بْحّ عَ رَشَرَ مَ نّ، شَشِلِ تِدٍ لُ عِ بّ،</para>
  <para style="q" vid="JOB 11:18">قٍ حَاشِ عَ مَكُيَمَ نّ عِ رَ،</para>
  <para style="q" vid="JOB 11:18">عِ شِ شْلِ قَنيِ رَبَ.<verse eid="JOB 11:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 11:19"/>عِ نَ عِ سَ، مِشِ يٌ مُ عِ شَ شِ شْلِ كَنَمَ عِ مَ.</para>
  <para style="q" vid="JOB 11:19">مِشِيٍ قَمَ نّ عِ شَ هِننّ عٍ رَ.<verse eid="JOB 11:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 11:20"/>كْنْ تِنشِنتَرٍيٍ شَ قٍ شُن نَكَنَمَ نّ،</para>
  <para style="q" vid="JOB 11:20">عٍ مُ كِسِمَ، قَشّ نَن عٍ مَمّشِ.»<verse eid="JOB 11:20"/></para>
  <chapter eid="JOB 11"/>
  <chapter number="12" style="c" sid="JOB 12"/>
  <para style="s1">عَيُبَ شَ مَسٍنيِ سَشَن ندٍ</para>
  <para style="s2">«دَالِسٍ بِرِن نَ عَلَ شْنيّ عِ.»</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 12:1"/>عَيُبَ نَشَ عَ يَابِ،<verse eid="JOB 12:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 12:2"/>«دُنِحَ شُي نَن نَ وٌ كْن نَ.</para>
  <para style="q" vid="JOB 12:2">عَ لُشِ نّ يِ كِ عَلْ لْننِ بِرِن نَ وٌ تَن فبَنسَن يِ رَ.<verse eid="JOB 12:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 12:3"/>كْنْ ﭑ تَن قَن، شَشِلِ نَ ﭑ بّ عَلْ وٌ تَن.</para>
  <para style="q" vid="JOB 12:3">وٌ مُ قِسَ ﭑ بّ دٍ.</para>
  <para style="q" vid="JOB 12:3">وٌ نَشَن قَلَشِ، ندٍ مُ نْمَ نَ كٌلٌندٍ؟<verse eid="JOB 12:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 12:4"/>ﭑ نَ عَلَ مَشَندِ،</para>
  <para style="q" vid="JOB 12:4">عَلَكٌ ﭑ شَ يَابِ ندٍ سْتْ عَ رَ،</para>
  <para style="q" vid="JOB 12:4">تِنشِنتْي قِندِ عَ بٌورٍيٍ بّ مَيٍلٍ سٍ رَ.<verse eid="JOB 12:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 12:5"/>مِشِيٍ نَشٍيٍ مُ نَ تْورّ كُي،</para>
  <para style="q" vid="JOB 12:5">عٍ يٌمَ تْورْ مِشِ شَ تْورّ مَ.</para>
  <para style="q" vid="JOB 12:5">عٍ عَ قَلَمَ عٍ نُن نَ تْورّ نَن لَن.<verse eid="JOB 12:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 12:6"/>كْنتْقِلِ يٌ مُ نَ مُحّتِيٍ شْنيِ.</para>
  <para style="q" vid="JOB 12:6">كُيٍ بَتُييٍ عَلَ شِلِ مَبٍرٍ مَ،</para>
  <para style="q" vid="JOB 12:6">كْنْ عٍ بْحّ سَشِ.<verse eid="JOB 12:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 12:7"/>مَشْرِنيِ تِ سُبٍيٍ مَ وُلَ عِ، عٍ شَ عِ رَلْننِ.</para>
  <para style="q" vid="JOB 12:7">شْنِيٍ قَن شَ نَ مَسٍن عِ بّ.<verse eid="JOB 12:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 12:8"/>بْشِ مَتٌ، نَ قَن شَ قِندِ لْننِ رَ عِ بّ.</para>
  <para style="q" vid="JOB 12:8">يّشّيٍ مَشْرِن بَا مَ،</para>
  <para style="q" vid="JOB 12:8">نٍيٍ قَن شَ نَ مَسٍن عِ بّ.<verse eid="JOB 12:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 12:9"/>عٍ بِرِن عَ كٌلٌن عَلَتَلَ قْشِ نَن نَ كِ.<verse eid="JOB 12:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 12:10"/>دَالِسٍ بِرِن نِي نَ عَ شْنيّ عِ،</para>
  <para style="q" vid="JOB 12:10">عَدَ مَدِ بِرِن حّنفِ قَتَنشِ عَ تَن نَن نَ.<verse eid="JOB 12:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 12:11"/>عَدَ مَ شَ عَ حْشْ سَ يِ مَسٍنيِيٍ شْن مَ،</para>
  <para style="q" vid="JOB 12:11">عَلْ عَ دّ عَ حْشْ سَمَ دٌنسٍ شْن مَ كِ نَشّ.<verse eid="JOB 12:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 12:12"/>لْننِ نَ قٌرِيٍ يِ رَ،</para>
  <para style="q" vid="JOB 12:12">سِمَيَ شْنكُيٍ نَن شَشِلِ قِمَ مِشِ مَ.<verse eid="JOB 12:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 12:13"/>لْننِ نُن سّنبّ نَ عَلَ نَن يِ رَ،</para>
  <para style="q" vid="JOB 12:13">مَرَ سِ نُن شَشِلِ قَنيِ نَ عَ تَن نَن بّ.<verse eid="JOB 12:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 12:14"/>شَ عَلَ سٍ كَنَ، عَ مُ نْمَ رَقَلَدٍ سْنْن.</para>
  <para style="q" vid="JOB 12:14">شَ عَ تَن نَن مِشِ بَلَنشِ، نَ كَنيِ مُ مِنِمَ.<verse eid="JOB 12:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 12:15"/>شَ عَلَ كَنكَن تُنّ مَ، سٍ بِرِن شَرَ مَ نّ.</para>
  <para style="q" vid="JOB 12:15">شَ عَ عَ بّحِن، عَ بَنبَرَن يّ بْشِ مَ.<verse eid="JOB 12:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 12:16"/>سّنبّ نُن نْندِ نَ عَ تَن نَن يِ رَ.</para>
  <para style="q" vid="JOB 12:16">مِشِ نَشَن مَدَشُشِ نُن مِشِ مَدَشُي، عٍ بِرِن عَ فبٍ.<verse eid="JOB 12:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 12:17"/>عَ نْمَ مَرَ سِمَيٍ سُشُدٍ،</para>
  <para style="q" vid="JOB 12:17">عَ نْمَ كِيتِسَيٍ شَشِلِ عِقُدٍ.<verse eid="JOB 12:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 12:18"/>مَنفّ يْلْنشْنيِ نَشَن سَشِ مِشِيٍ مَ،</para>
  <para style="q" vid="JOB 12:18">عَلَ نَ بَمَ نّ عٍ مَ، عَ عَ سَ مَنفّ تَن مَ.<verse eid="JOB 12:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 12:19"/>عَلَ سّرّشّدُبّيٍ شَنِنمَ كٌنيِيَ كُي،</para>
  <para style="q" vid="JOB 12:19">عَ مَنفَسَنيِ رَبِرَ.<verse eid="JOB 12:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 12:20"/>عَ مَسٍنيِ بَمَ مَرَ سِمَيٍ يِ،</para>
  <para style="q" vid="JOB 12:20">عَ قٌرِيٍ شَ لْننِ مَقِندِ مَ.<verse eid="JOB 12:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 12:21"/>عَ كُنتِفِيٍ رَيَافِمَ،</para>
  <para style="q" vid="JOB 12:21">عَ سّنبّمَيٍ عِفٌرٌ مَ.<verse eid="JOB 12:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 12:22"/>عَ فُندٌي مَكّنّنمَ،</para>
  <para style="q" vid="JOB 12:22">عَ دِ مِ قِندِ نَءِيَلَنيِ رَ.<verse eid="JOB 12:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 12:23"/>عَ حَمَنّيٍ شُن نَكٍلِمَ،</para>
  <para style="q" vid="JOB 12:23">عَ مَن عٍ شُن نَكَنَ.</para>
  <para style="q" vid="JOB 12:23">عَ عٍ رَ سِفَ، عَ مَن عٍ رَقَ.<verse eid="JOB 12:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 12:24"/>عَ شَشِلِ بَمَ حَمَنّيٍ مَنفّيٍ يِ رَ،</para>
  <para style="q" vid="JOB 12:24">عَ عٍ رَلْي فبٍنفبٍرٍنيِ مَ.<verse eid="JOB 12:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 12:25"/>عٍ لُمَ عَلْ دْنشُييٍ نَشٍيٍ مُ نَءِيَلَنيِ تٌمَ،</para>
  <para style="q" vid="JOB 12:25">عٍ لُمَ عَلْ سِيسِلَيٍ كِرَ عِقُمَ نَشٍيٍ مَ.»<verse eid="JOB 12:25"/></para>
  <chapter eid="JOB 12"/>
  <chapter number="13" style="c" sid="JOB 13"/>
  <para style="s1">عَيُبَ شَ مَسٍنيِ سَشَن ندٍ دّ عِدْشْي</para>
  <para style="s2">«دَالِسٍ بِرِن نَ عَلَ شْنيّ عِ»</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 13:1"/>«عِيٌ، ﭑ يَ بَرَ نَ بِرِن تٌ،</para>
  <para style="q" vid="JOB 13:1">ﭑ تُلِ بَرَ نَ مّ.<verse eid="JOB 13:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 13:2"/>وٌ نَشَن كٌلٌن، ﭑ تَن قَن نَ كٌلٌن.</para>
  <para style="q" vid="JOB 13:2">وٌ مُ قِسَ ﭑ بّ.<verse eid="JOB 13:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 13:3"/>ﭑ تَن وَ مَ نّ فبَنسَن،</para>
  <para style="q" vid="JOB 13:3">ﭑ شَ وْيّن عَلَ سّنبّ كَنيِ رَ،</para>
  <para style="q" vid="JOB 13:3">ﭑ وَ مَ ﭑ يّتّ نَن شُن مَقَلَقٍ عَ بّ.<verse eid="JOB 13:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 13:4"/>وٌ تَن بَرَ ﭑ تْوحّفّ.</para>
  <para style="q" vid="JOB 13:4">وٌ مُ قَشِ سٍرِ يٌ رَ ﭑ بّ.<verse eid="JOB 13:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 13:5"/>شَ وٌ وٌ سَبَرِشِ نّ نُ، نَ نَن قِسَ.</para>
  <para style="q" vid="JOB 13:5">نَ نُ نْمَ قِندِدٍ نّ لْننِ رَ.<verse eid="JOB 13:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 13:6"/>وٌ شَ وٌ تُلِ مَتِ ﭑ مَ مَسٍنيِ رَ،</para>
  <para style="q" vid="JOB 13:6">وٌ شَ ﭑ شُنمَقَلَ وْيّنيِيٍ رَ مّ.<verse eid="JOB 13:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 13:7"/>وٌ تَن وَ مَ وْيّن تِنشِنتَرٍيٍ نَن قَلَقٍ عَلَ شِلِ رَ؟</para>
  <para style="q" vid="JOB 13:7">وٌ وَ مَ وُلٍ نَن قَلَقٍ وٌ مَرِفِ شِلِ رَ؟<verse eid="JOB 13:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 13:8"/>وٌ وَ مَ عَلَ مَلِقٍ نّ؟</para>
  <para style="q" vid="JOB 13:8">وٌ وَ مَ عَلَ نَن شُن مَقَلَقٍ؟<verse eid="JOB 13:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 13:9"/>وٌ مُنسٍ رَبَمَ شَ عَ سَ وٌ سٌندٌنيِيٍ مَتٌ؟</para>
  <para style="q" vid="JOB 13:9">وٌ نْمَ عَلَ مَدَشُدٍ عَلْ وٌ مِشِ مَدَشُمَ كِ نَشّ؟<verse eid="JOB 13:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 13:10"/>ﭑ عَ كٌلٌن، عَ وٌ رَكْرْ سِمَ نّ شَ وٌ تَنتَنمَ وٌ شَ فُندٌي كُي.<verse eid="JOB 13:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 13:11"/>وٌ مُ فَاشُمَ عَ سّنبّ يَ رَ؟</para>
  <para style="q" vid="JOB 13:11">وٌ مُ فَاشُمَ عَ شَ شْنّ يَ رَ؟<verse eid="JOB 13:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 13:12"/>وٌ شَ مَسٍنيِيٍ لُمَ عَلْ تّ شُبٍ،</para>
  <para style="q" vid="JOB 13:12">وٌ مَكَنتَ سٍيٍ سّنبّ مُ نَ.<verse eid="JOB 13:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 13:13"/>وٌ وٌ سَبَرِ، وٌ عَ لُ ﭑ شَ وْيّن.</para>
  <para style="q" vid="JOB 13:13">قٍ نَشَن ﭑ لِمَ، نَ ﭑ لِمَ نّ.<verse eid="JOB 13:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 13:14"/>ﭑ سُو سَشِ ﭑ يّتّ رَ مِنِدٍ كّنّ مَ مُنقٍ رَ،</para>
  <para style="q" vid="JOB 13:14">هَلِ نَ تٌ نْمَ قِندِدٍ نّ قَشّ رَ ﭑ بّ؟<verse eid="JOB 13:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 13:15"/>هَلِ عَلَ ﭑ قَشَ، ﭑ نَن ﭑ شَشِلِ تِمَ عَ تَن نَن نَ.</para>
  <para style="q" vid="JOB 13:15">ﭑ نَن ﭑ يّتّ شُن مَقَلَمَ عَ تَن نَن يَ عِ.<verse eid="JOB 13:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 13:16"/>نَ يَتِ نْمَ قِندِدٍ كِسِ رَ ﭑ بّ،</para>
  <para style="q" vid="JOB 13:16">بَرِ مَ تِنشِنتَرٍ مُ سُو سَمَ تِدٍ عَ يَ عِ.<verse eid="JOB 13:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 13:17"/>وٌ ﭑ مَ مَسٍنيِيٍ رَ مّ،</para>
  <para style="q" vid="JOB 13:17">وٌ وٌ تُلِ مَتِ عٍ رَ.»<verse eid="JOB 13:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="JOB 13:18"/>«وٌ عَ لُ ﭑ شَ ﭑ فبٍ قَلَ،</para>
  <para style="q" vid="JOB 13:18">ﭑ عَ كٌلٌن نْندِ لُمَ نّ ﭑ بّ.<verse eid="JOB 13:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 13:19"/>ندٍ نْمَ ﭑ مَ يُنُبِ مَسٍندٍ ﭑ بّ؟</para>
  <para style="q" vid="JOB 13:19">شَ نَ رَبَ،</para>
  <para style="q" vid="JOB 13:19">ﭑ دُندُ مَ نّ، ﭑ تِن قَشَقٍ رَ.»<verse eid="JOB 13:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="JOB 13:20"/>«عَلَ، قٍ قِرِن فبَنسَن نَبَ ﭑ بّ،</para>
  <para style="q" vid="JOB 13:20">عَلَكٌ ﭑ نَشَ نْشُن عِ مَ سْنْن.<verse eid="JOB 13:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 13:21"/>عِ شْنيّ بَ ﭑ مَ،</para>
  <para style="q" vid="JOB 13:21">عِ مَن شَ بَ ﭑ مَفَاشُقٍ.<verse eid="JOB 13:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 13:22"/>نَ تّمُي ﭑ شِلِ قَ، ﭑ عِ يَابِمَ نّ،</para>
  <para style="q" vid="JOB 13:22">شَ نَ مُ عَ رَ ﭑ نْمَ نّ وْيّندٍ، عِ ﭑ يَابِ.<verse eid="JOB 13:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 13:23"/>ﭑ مَ يُنُبِ نُن ﭑ مَ قٍ حَاشِ شَسَبِ لَنشِ مُنسٍ مَ؟</para>
  <para style="q" vid="JOB 13:23">ﭑ مَ يُنُبِ نُن ﭑ مَ قٍ حَاشِ مَسٍن ﭑ بّ.<verse eid="JOB 13:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 13:24"/>عِ مّيشِ ﭑ نَ مُنقٍ رَ؟</para>
  <para style="q" vid="JOB 13:24">عِ ﭑ قِندِشِ عِ يَشُي رَ مُنقٍ رَ؟<verse eid="JOB 13:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 13:25"/>عِ وَ مَ سّنبّ شُرِ كَنيِ نَن نَسّرّنقٍ؟</para>
  <para style="q" vid="JOB 13:25">عِ وَ مَ بِرَقٍ مِشِ شُرُدِ نَن قْشْ رَ؟<verse eid="JOB 13:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 13:26"/>عِ بَرَ ﭑ حَشَنكَتَ عَ حَاشِ رَ</para>
  <para style="q" vid="JOB 13:26">ﭑ مَ يُنُبِيٍ شَ قٍ رَ ﭑ نَشٍيٍ رَبَشِ ﭑ قٌنِكٍ تّمُي رَ.<verse eid="JOB 13:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 13:27"/>عِ يْلْنشْنيِ نَن سَشِ ﭑ سَنيِيٍ مَ،</para>
  <para style="q" vid="JOB 13:27">عَلَكٌ عِ شَ ﭑ حّرّ كِ بِرِن كٌلٌن،</para>
  <para style="q" vid="JOB 13:27">عِ شَ نَانِنيِ سَ ﭑ مَ حّرّ مَ.<verse eid="JOB 13:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 13:28"/>ﭑ قَتٍ نَ بْرْقٍ نّ يِ كِ،</para>
  <para style="q" vid="JOB 13:28">عَلْ دُفِ شِيٍيٍ نَشَن شِنشِ.»<verse eid="JOB 13:28"/></para>
  <chapter eid="JOB 13"/>
  <chapter number="14" style="c" sid="JOB 14"/>
  <para style="s1">عَيُبَ شَ مَسٍنيِ نَانِ ندٍ</para>
  <para style="s2">«عَدَ مَ شَ دُنِحّءِفِرِ شْرْشْ»</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 14:1"/>«عَدَ مَ، فِنّ بَرِ دِ،</para>
  <para style="q" vid="JOB 14:1">عَ شَ سِمَيَ دُنكٍ، كْنتْقِلِ فبٌ عَ مَ.<verse eid="JOB 14:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 14:2"/>عَ لُشِ نّ عَلْ قُفٍ نَشَن مِنِمَ، عَ قَ شَبَ.</para>
  <para style="q" vid="JOB 14:2">عَ لُشِ نّ عَلْ نِينِ نَشَن مُ بُمَ.<verse eid="JOB 14:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 14:3"/>عِ وَ مَ ﭑ مَنِيَقٍ نَ نَن نَ، عِ شَ ﭑ مَكِيتِ؟<verse eid="JOB 14:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 14:4"/>ندٍ نْمَ سّنِيّنيِ رَ مِنِدٍ سّنِيّنتَرٍحَ كُي؟</para>
  <para style="q" vid="JOB 14:4">مِشِ يٌ!<verse eid="JOB 14:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 14:5"/>شَ عِ تَن نَن مِشِ شَ سِمَيَ كْنتِ رَفِرِشِ،</para>
  <para style="q" vid="JOB 14:5">شَ عِ تَن نَن نَتّ تٌنفٌشِ عَ شَ سِمَيَ كْنتِ دَندٍ مَ،<verse eid="JOB 14:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 14:6"/>عِ شَ فبِلٍن عَ قْشْ رَ،</para>
  <para style="q" vid="JOB 14:6">عَلَكٌ عَ شَ عَ مَلَبُ</para>
  <para style="q" vid="JOB 14:6">عَلْ وَلِكّ عَ مَلَبُمَ كِ نَشّ وَلِ رَحْنيِ.»<verse eid="JOB 14:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="JOB 14:7"/>«شَ وُرِ بِلِ نَ عَ رَ نُ،</para>
  <para style="q" vid="JOB 14:7">عَ نَ شَبَ، عَ شُنتُنيِ مَن فبِلٍنمَ نّ حِنفِ رَ،</para>
  <para style="q" vid="JOB 14:7">عَ سَلٌنيِيٍ مَن قَن.<verse eid="JOB 14:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 14:8"/>شَ عَ سَنكٍ سَ بُ بْشِ بُن مَ،</para>
  <para style="q" vid="JOB 14:8">عَ شُنتُنيِ تَن نَشَ قَشَ بّندّ كُي،<verse eid="JOB 14:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 14:9"/>تُنّ بِرّ، عَ مَن نْمَ قِندِدٍ عَ رَ عَلْ عَ سِنفٍ.<verse eid="JOB 14:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 14:10"/>كْنْ عَدَ مَدِ تَن،</para>
  <para style="q" vid="JOB 14:10">شَ عَ قَشَ، عَ سّنبّ بِرِن حْنمَ نّ،</para>
  <para style="q" vid="JOB 14:10">عَ مُ بَلٌشِ سْنْن.<verse eid="JOB 14:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 14:11"/>بَا نُن شُرٍ نْمَ شْرِدٍ،<verse eid="JOB 14:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 14:12"/>كْنْ عَدَ مَدِ لَاشِرَشِ مُ كٍلِمَ،</para>
  <para style="q" vid="JOB 14:12">قٌ كٌورٍ شَ حْن، عَ قَ شُنُ.<verse eid="JOB 14:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="JOB 14:13"/>عَ شْلِ ﭑ مَ عِ شَ ﭑ نْشُن عَلِفِيَمَ،</para>
  <para style="q" vid="JOB 14:13">هَن عِ شَ شْنّ دَنفِمَ تّمُي نَشّ، عِ قَ رَتُ ﭑ مَ.<verse eid="JOB 14:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 14:14"/>كْنْ عَدَ مَ نَ قَشَ، عَ مَن فبِلٍنمَ بَلٌ رَ؟</para>
  <para style="q" vid="JOB 14:14">ﭑ مَمّ تِمَ نّ ﭑ مَ وَلِ كُي،</para>
  <para style="q" vid="JOB 14:14">هَن ﭑ حْشْي قَ تّمُي.<verse eid="JOB 14:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 14:15"/>عِ نَ ﭑ شِلِ، ﭑ قَمَ عِ شَ شِلِ رَتِندٍ،</para>
  <para style="q" vid="JOB 14:15">بَرِ مَ عِ وَ مَ نّ عِ شَ دَالِ شْن.<verse eid="JOB 14:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 14:16"/>يَكْسِ عِ ﭑ سَنيِ تٌنفٌ كِ بِرِن عِفبّمَ.</para>
  <para style="q" vid="JOB 14:16">عِ مُ ﭑ مَ يُنُبِيٍ تٌمَ.<verse eid="JOB 14:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 14:17"/>ﭑ مَ قٍ حَاشِيٍ نْشُن بّكِ كُي،</para>
  <para style="q" vid="JOB 14:17">ﭑ مَ يُنُبِيٍ شَقَرِ!»<verse eid="JOB 14:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="JOB 14:18"/>«كْنْ فٍيَ بِرَ مَ عَ يٍنسٍن يّ،</para>
  <para style="q" vid="JOB 14:18">قَنيٍ تَلَ عَ يِرٍ،<verse eid="JOB 14:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 14:19"/>يٍ كِرَ رَبْو فّمّيٍ شْن مَ،</para>
  <para style="q" vid="JOB 14:19">عَ بْشِ بّندّ شَنِن عَ شُن.</para>
  <para style="q" vid="JOB 14:19">عِ قَن عَدَ مَدِ شَشِلِ تِدٍ رَبَمَ نَ كِ نّ.<verse eid="JOB 14:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 14:20"/>عِ نْمَ عَدَ مَ رَ، عَ قَ قَشَ.</para>
  <para style="q" vid="JOB 14:20">عِ نَ فّ عَ تْورْدٍ، عِ عَ شَنِن عَلِفِيَمَ.<verse eid="JOB 14:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 14:21"/>شَ عَ شَ دِيٍ بِنيّ سْتْمَ،</para>
  <para style="q" vid="JOB 14:21">عَ مُ نَ كٌلٌن.</para>
  <para style="q" vid="JOB 14:21">شَ بِنيّ بَمَ عٍ مَ،</para>
  <para style="q" vid="JOB 14:21">عَ مُ نَ تٌمَ.<verse eid="JOB 14:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 14:22"/>عَدَ مَ شَ تْورّ فبٌ دُنِحَ بّندّ قُحِ قَرِ،</para>
  <para style="q" vid="JOB 14:22">عَ بْحّ لُمَ سُننُنيِ كُي.»<verse eid="JOB 14:22"/></para>
  <chapter eid="JOB 14"/>
  <chapter number="15" style="c" sid="JOB 15"/>
  <para style="s1">عٍلِقَسِ تٍمَنكَ شَ مَسٍنيِ قِرِن ندٍ</para>
  <para style="s2">«عَيُبَ شَ وْيّنيِ مُ قَن»</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 15:1"/>عٍلِقَسِ تٍمَنكَ نَشَ عَ قَلَ،<verse eid="JOB 15:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 15:2"/>«لْننِلَ شَ يَابِ نْمَ مَنِيَدٍ قٌيٍ رَ؟</para>
  <para style="q" vid="JOB 15:2">عَ يّتّ عِفبٌمَ نَ نَن نَ؟<verse eid="JOB 15:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 15:3"/>عَ نْمَ عَ شُن مَقَلَدٍ وْيّنيِ قُقَقُ رَ؟</para>
  <para style="q" vid="JOB 15:3">عَ نْمَ مَسٍنيِ قَلَدٍ نَشَن تِدٍ مُ نَ؟<verse eid="JOB 15:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 15:4"/>عِ نَ بِنيّ بَقٍ عَلَ مَ،</para>
  <para style="q" vid="JOB 15:4">عِ نَ لِمَنِيَ بَقٍ مِشِيٍ يِ رَ عَلَ بَتُقٍ رَ.<verse eid="JOB 15:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 15:5"/>عِ شَ قٍ حَاشِ نَن عَ نِيَقٍ عِ شَ وْيّن نَ كِ.</para>
  <para style="q" vid="JOB 15:5">عِ وَ مَ مِشِيٍ مَدَشُقٍ عِ دّ رَ.<verse eid="JOB 15:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 15:6"/>عِ دّ يَتِ نَن قِندِشِ سٍيدٍ رَ عِ شَ قٍ حَاشِيٍ مَ.</para>
  <para style="q" vid="JOB 15:6">ﭑ تَن مُ عَ رَ.»<verse eid="JOB 15:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="JOB 15:7"/>«عَدَ مَ سِنفٍ عِ تَن نَن نَ؟</para>
  <para style="q" vid="JOB 15:7">عِ سِنفٍ دَا فٍيَيٍ بّ؟<verse eid="JOB 15:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 15:8"/>عِ عَلَ شَ فُندٌ رَ مّ نّ،</para>
  <para style="q" vid="JOB 15:8">عَلَكٌ عِ شَ لْننِ سْتْ عِ يّتّ كَن بّ؟<verse eid="JOB 15:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 15:9"/>عِ مُنسٍ كٌلٌن مُشُ تَن مُ نَشَن كٌلٌن؟</para>
  <para style="q" vid="JOB 15:9">عِ قَهَامُي مُندُن سْتْشِ مُشُ تَن مُ نَشَن سْتْشِ؟<verse eid="JOB 15:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 15:10"/>قٌرِيٍ نَ مُشُ يَ مَ نَشٍيٍ قٌرِ عِ بَبَ بّ.<verse eid="JOB 15:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 15:11"/>عِ مُ لِمَنِيَ سْتْ عَلَ شَ مَسٍنيِيٍ كُي،</para>
  <para style="q" vid="JOB 15:11">مُشُ نَشٍيٍ قَلَ عِ بّ مَرَقَنيِ رَ؟»<verse eid="JOB 15:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="JOB 15:12"/>«عِ بْحّ تٍشِ مُنقٍ رَ،</para>
  <para style="q" vid="JOB 15:12">هَن عِ يَ بَرَ فبٍيلِ عَ عِ،<verse eid="JOB 15:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 15:13"/>عِ دّ نُ قَ وْيّنيِيٍ قَلَ شْنّ كُي عَلَ بّ؟<verse eid="JOB 15:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 15:14"/>عَدَ مَدِ سّنِيّن؟</para>
  <para style="q" vid="JOB 15:14">فِنّ بَرِ دِ تِنشِن؟<verse eid="JOB 15:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 15:15"/>شَ عَلَ مُ لَمَ عَ شَ سّنِيّنتْييٍ رَ،</para>
  <para style="q" vid="JOB 15:15">شَ كٌورٍ يَتِ مُ سّنِيّن عَلَ يَ عِ،<verse eid="JOB 15:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 15:16"/>عَدَ مَدِ فٌ، نَشَن بَرَ كَنَ،</para>
  <para style="q" vid="JOB 15:16">نَشَن قٍ حَاشِ رَبَمَ تّمُي بِرِن؟»<verse eid="JOB 15:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="JOB 15:17"/>«عِ تُلِ مَتِ ﭑ نَ، ﭑ شَ نَ تَفِ رَبَ عِ بّ.</para>
  <para style="q" vid="JOB 15:17">ﭑ قٍ نَشَن تٌشِ،</para>
  <para style="q" vid="JOB 15:17">ﭑ شَ نَ قَلَ عِ بّ،<verse eid="JOB 15:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 15:18"/>لْننِلَيٍ نَشَن مَسٍنشِ،</para>
  <para style="q" vid="JOB 15:18">عٍ نَشَن سْتْ عٍ بَبَيٍ رَ عٍ مُ عَ نْشُن.<verse eid="JOB 15:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 15:19"/>عَلَ بْشِ قِشِ عٍ تَن نَن مَ،</para>
  <para style="q" vid="JOB 15:19">شْحّ فبّتّ يٌ مُ نُ نَ سِندٍن.<verse eid="JOB 15:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 15:20"/>مِشِ حَاشِ تْورْ مَ نّ عَ شَ سِمَيَ بِرِن كُي،</para>
  <para style="q" vid="JOB 15:20">كْنتِ سَشِ عَ شَ سِمَيَ مَ.<verse eid="JOB 15:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 15:21"/>عَ هَلَكِ قٍ مّمَ،</para>
  <para style="q" vid="JOB 15:21">مُحّتِيٍ بَفَنمَ عَ مَ، عٍ عَ شَ بْحّسَ كَنَ.<verse eid="JOB 15:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 15:22"/>عَ عَ كٌلٌن عَ مُ كِسِمَ،</para>
  <para style="q" vid="JOB 15:22">سَنتِدّفّمَ نَ عَ مَمّقٍ.<verse eid="JOB 15:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 15:23"/>عَ عَ لِنتَنمَ بَلٌ قٍندٍ،</para>
  <para style="q" vid="JOB 15:23">عَ عَ كٌلٌن عَ مُ رَتَنفَمَ دِ مِ مَ.<verse eid="JOB 15:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 15:24"/>تْورّ نُن كْنتْقِلِ بَرَ عَ مَفَاشُ،</para>
  <para style="q" vid="JOB 15:24">عٍ فٍرٍ تِمَ عَلْ مَنفّ نُن عَ شَ سْورِيٍ،<verse eid="JOB 15:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 15:25"/>بَرِ مَ عَ بَرَ عَ يّتّ عِفبٌ عَلَ مَ،</para>
  <para style="q" vid="JOB 15:25">عَ بَرَ سُو سَ عَلَ سّنبّ كَنيِ رَ.<verse eid="JOB 15:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 15:26"/>عَ بَرَ سُو سَ عَلَ فٍرٍدٍ عَ شَ وُرٍ لٍقَيٍ بُن مَ.<verse eid="JOB 15:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 15:27"/>عَ بَرَ شُنفبٌ هَن عَ قُرِ شَلّ بَرَ دْشْ،<verse eid="JOB 15:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 15:28"/>كْنْ عَ قَمَ سَبَتِدٍ تَا كَنَشِيٍ نَن كُي،</para>
  <para style="q" vid="JOB 15:28">نَشٍيٍ نَ بِرَقٍ،</para>
  <para style="q" vid="JOB 15:28">مِشِيٍ مُ نَ دّننَشّ.<verse eid="JOB 15:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 15:29"/>عَ شَ نَاقُلِ حْنمَ نّ،</para>
  <para style="q" vid="JOB 15:29">عَ شَ بَننَيَ كَنَ.</para>
  <para style="q" vid="JOB 15:29">بَرَكّ مُ لُمَ عَ شَ سٍ سْتْي مَ سْنْن.<verse eid="JOB 15:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="JOB 15:30"/>عَ مُ نْمَ كٍلِدٍ دِ مِ كُي.</para>
  <para style="q" vid="JOB 15:30">عَ بْنسْي قَمَ فَندٍ،</para>
  <para style="q" vid="JOB 15:30">عَ سْنتْ عَلَ كّرّ قٌيٍ رَ.»<verse eid="JOB 15:30"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="31" style="v" sid="JOB 15:31"/>«شَ عَ شَشِلِ تِمَ قٍ قُقَقُ رَ،</para>
  <para style="q" vid="JOB 15:31">عَ قٍ قُقَقُ نَن سْتْمَ.<verse eid="JOB 15:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="JOB 15:32"/>بٍينُن عَ شَ سِمَيَ شَ كَمَلِ،</para>
  <para style="q" vid="JOB 15:32">عَ قَمَ حَشَنكَتّ سْتْدٍ.<verse eid="JOB 15:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="JOB 15:33"/>عَ لُمَ عَلْ سَنسِ بٌفِ نَشٍيٍ بَمَ عٍ شِندٍ رَ،</para>
  <para style="q" vid="JOB 15:33">عَلْ سَنسِ قُفٍ نَشٍيٍ بِرَ مَ.<verse eid="JOB 15:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="JOB 15:34"/>تِنشِنتَرٍ شَ دٍنبَيَ مُ فبٌمَ،</para>
  <para style="q" vid="JOB 15:34">مِشِ نَشٍيٍ كْبِرِ رَ سُشُمَ تِنشِنتَرٍيَ كُي،</para>
  <para style="q" vid="JOB 15:34">عٍ شَ بَنشِيٍ فَنمَ نّ تّ رَ.<verse eid="JOB 15:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="JOB 15:35"/>قٍ حَاشِ مَحْشُنقٍ قِندِ مَ تْورّ نَن نَ.</para>
  <para style="q" vid="JOB 15:35">نَ مَحْشُنيِ قَمَ عَ كَنيِ يَنقَدٍ.»<verse eid="JOB 15:35"/></para>
  <chapter eid="JOB 15"/>
  <chapter number="16" style="c" sid="JOB 16"/>
  <para style="s1">عَيُبَ شَ مَسٍنيِ سُولِ ندٍ</para>
  <para style="s2">«عَيُبَ شَ سٍيدٍ نَ كٌورٍ مَ»</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 16:1"/>عَيُبَ نَشَ عَ يَابِ،<verse eid="JOB 16:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 16:2"/>«ﭑ بَرَ وٌ شَ مَسٍنيِ مَنِيّ فبٍفبٍ مّ.</para>
  <para style="q" vid="JOB 16:2">وٌ مُ قَتَ مِشِ مَدُندُدٍ.<verse eid="JOB 16:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 16:3"/>وٌ شَ مَسٍنيِيٍ مَنِيَ قٌيٍ رَ.</para>
  <para style="q" vid="JOB 16:3">عٍ حْنمَ تّمُي مُندُن؟</para>
  <para style="q" vid="JOB 16:3">ﭑ مَ يَابِيٍ بَرَ وٌ رَشْنْ؟<verse eid="JOB 16:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 16:4"/>شَ وٌ تَن نَن نُ نَ تْورْقٍ،</para>
  <para style="q" vid="JOB 16:4">ﭑ تَن قَن نُ نْمَ وْيّندٍ نّ عَلْ وٌ تَن،</para>
  <para style="q" vid="JOB 16:4">ﭑ وٌ تْوحّفّ، ﭑ يٌ وٌ مَ.<verse eid="JOB 16:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 16:5"/>كْنْ ﭑ تَن مُ نُ نَ رَبَمَ،</para>
  <para style="q" vid="JOB 16:5">ﭑ وٌ سّنبّ سٌمَ ﭑ مَ وْيّنيِيٍ نَن نَ نُ،</para>
  <para style="q" vid="JOB 16:5">ﭑ دّ وٌ رَلِمَنِيَ.»<verse eid="JOB 16:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="JOB 16:6"/>«ﭑ مَ وْيّنيِ مُ ﭑ مَ تْورّ بَمَ،</para>
  <para style="q" vid="JOB 16:6">ﭑ مَ سَبَرِ قَن مُ عَ مَكُيَمَ ﭑ نَ.<verse eid="JOB 16:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 16:7"/>يَكْسِ قَ، ﭑ بَرَ تَفَن.</para>
  <para style="q" vid="JOB 16:7">عَلَ، عِ بَرَ ﭑ مَ دٍنبَيَ بِرِن هَلَكِ.<verse eid="JOB 16:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 16:8"/>عِ بَرَ ﭑ قَتٍ بِرِن بَ ﭑ مَ،</para>
  <para style="q" vid="JOB 16:8">نَ بَرَ قِندِ سٍيدٍ رَ ﭑ شِلِ مَ.<verse eid="JOB 16:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 16:9"/>عَلَ شَ شْنّ بَرَ دُتُن ﭑ مَ،</para>
  <para style="q" vid="JOB 16:9">عَ بَرَ ﭑ تْورْ عَ حَاشِ رَ،</para>
  <para style="q" vid="JOB 16:9">عَلْ ﭑ يَشُي نْمَ عَ رَبَدٍ كِ نَشّ.<verse eid="JOB 16:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 16:10"/>ﭑ يَشُييٍ قٍ حَاشِ قَلَمَ ﭑ مَ قٍ رَ،</para>
  <para style="q" vid="JOB 16:10">عٍ ﭑ نَيَافِمَ، عٍ ﭑ بْنبْمَ.</para>
  <para style="q" vid="JOB 16:10">عٍ بِرِن عٍ مَلَنمَ ﭑ شِلِ مَ.<verse eid="JOB 16:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 16:11"/>عَلَ مُ ﭑ نَتَنفَ قٌنِكٍ كَرِنشِيٍ مَ،</para>
  <para style="q" vid="JOB 16:11">عَ ﭑ سٌ مِشِ حَاشِيٍ يِ رَ.<verse eid="JOB 16:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 16:12"/>ﭑ نُ بْحّسَ نَن كُي،</para>
  <para style="q" vid="JOB 16:12">كْنْ عَ نَشَ ﭑ سُشُ،</para>
  <para style="q" vid="JOB 16:12">عَ ﭑ عِمَشَ، عَ ﭑ شُن نَكَنَ.</para>
  <para style="q" vid="JOB 16:12">ﭑ بَرَ لُ عَلْ سٍ عَ لُمَ نَشَن بْنبْ رَ.<verse eid="JOB 16:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 16:13"/>عَ شَ تَنبّيٍ ﭑ نَبِلِنشِ يِرٍ بِرِن،</para>
  <para style="q" vid="JOB 16:13">عٍ بَرَ ﭑ بْحّ سْشْ كِنِكِنِتَرٍحَ كُي،</para>
  <para style="q" vid="JOB 16:13">عٍ ﭑ قُرِنفّيٍ رَ مِنِ كّنّ مَ.<verse eid="JOB 16:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 16:14"/>عَ ﭑ فٍرٍ مَ عَلْ فٍرٍ سٌي شَاحّ.<verse eid="JOB 16:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 16:15"/>ﭑ بَرَ سُننُن دٌنمَ رَفٌرٌ ﭑ قَتٍ مَ،</para>
  <para style="q" vid="JOB 16:15">ﭑ بَرَ ﭑ شُن سِن بْشِ مَ.<verse eid="JOB 16:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 16:16"/>وَ بَرَ ﭑ يَيٍ فبٍيلِ،</para>
  <para style="q" vid="JOB 16:16">سَيَ بَرَ مَكْرّ ﭑ نَ.<verse eid="JOB 16:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 16:17"/>كْنْ ﭑ مُ قٍ حَاشِ يٌ رَبَشِ.</para>
  <para style="q" vid="JOB 16:17">ﭑ نُ عَلَ مَشَندِ مَ سّنِيّنيِ نَن كُي.<verse eid="JOB 16:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 16:18"/>بّندّ، عِ نَشَ دُ سُ ﭑ وُلِ شُن نَ،</para>
  <para style="q" vid="JOB 16:18">عَ لُ ﭑ وَ شُي شَ مَكّنّن يِرٍ بِرِن.»<verse eid="JOB 16:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="JOB 16:19"/>«كٍلِقٍ يَكْسِ مَ قَ، ﭑ مَ سٍيدٍ نَ كٌورٍ مَ،</para>
  <para style="q" vid="JOB 16:19">ﭑ شُنمَقَلَمَ نَ يِرٍ عِتٍشِ.<verse eid="JOB 16:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 16:20"/>ﭑ بٌورٍيٍ نَ يٌقٍ ﭑ مَ،</para>
  <para style="q" vid="JOB 16:20">كْنْ ﭑ نَن ﭑ مَوَ مَ عَلَ نَن بّ.<verse eid="JOB 16:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 16:21"/>ﭑ سٍيدٍ شَ ﭑ شُن مَقَلَ عَلَ شْن مَ،</para>
  <para style="q" vid="JOB 16:21">عَلْ مِشِ عَ بٌورٍ شُن مَقَلَمَ كِ نَشّ،<verse eid="JOB 16:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 16:22"/>عَ شَ ﭑ شُن مَقَلَ بَرِ مَ عَ فبٍ مُ لُشِ ﭑ شَ سِفَ،</para>
  <para style="q" vid="JOB 16:22">ﭑ مُ فبِلٍنمَ سِفّ نَشَن كُي.»<verse eid="JOB 16:22"/></para>
  <chapter eid="JOB 16"/>
  <chapter number="17" style="c" sid="JOB 17"/>
  <para style="s1">عَيُبَ شَ مَسٍنيِ سُولِ ندٍ دّ عِدْشْي</para>
  <para style="s2">«ﭑ شَشِلِ تِشِ فَبُرِ نَن نَ»</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 17:1"/>«ﭑ نَ ﭑ نِي مَفَفَقٍ،</para>
  <para style="q" vid="JOB 17:1">عَ فبٍ مُ لُشِ ﭑ مَ سِمَيَ رَ،</para>
  <para style="q" vid="JOB 17:1">فَبُرِ عَ دّ رَبِشِ ﭑ يَ رَ.<verse eid="JOB 17:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 17:2"/>مِشِيٍ نَ يٌقٍ ﭑ مَ،</para>
  <para style="q" vid="JOB 17:2">ﭑ مُ نْمَ شِدٍ.<verse eid="JOB 17:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 17:3"/>عَلَ، يَندِ، تَانِ ﭑ بّ،</para>
  <para style="q" vid="JOB 17:3">مِشِ فبّتّ يٌ مُ تِنمَ نَ رَبَدٍ،<verse eid="JOB 17:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 17:4"/>بَرِ مَ عِ بَرَ ﭑ بٌورٍيٍ شَشِلِ بَلَن.</para>
  <para style="q" vid="JOB 17:4">عِ نَشَ عَ لُ عٍ شَ نْ ﭑ نَ.<verse eid="JOB 17:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 17:5"/>عٍ لُمَ عَلْ شّمّ نَشَن دٌنسٍ قِمَ مِشِ فبّتّيٍ مَ،</para>
  <para style="q" vid="JOB 17:5">عَ شَ دِ كَامّشِ يَ شْرِ.<verse eid="JOB 17:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 17:6"/>مِشِ بِرِن ﭑ مَيٍلٍمَ،</para>
  <para style="q" vid="JOB 17:6">عٍ عٍ دّ يٍ بْشُنمَ ﭑ يَتَفِ.<verse eid="JOB 17:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 17:7"/>ﭑ يَ مُ قَ سٍسٍ تٌمَ مَرَحَاشُي شَ قٍ رَ،</para>
  <para style="q" vid="JOB 17:7">ﭑ قَتٍ بِرِن بَرَ بَ ﭑ مَ.<verse eid="JOB 17:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 17:8"/>تِنشِنتْييٍ كَابَمَ ﭑ مَ،</para>
  <para style="q" vid="JOB 17:8">عٍ قَ شْنْ تِنشِنتَرٍيٍ مَ.<verse eid="JOB 17:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 17:9"/>تِنشِنتْي لُمَ عَ شَ كِرَ شْن،</para>
  <para style="q" vid="JOB 17:9">سّنِيّنتْي سّنبّ شُن مَسَمَ.<verse eid="JOB 17:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 17:10"/>وٌ تَن بِرِن نْمَ قَدٍ،</para>
  <para style="q" vid="JOB 17:10">كْنْ ﭑ مُ لَشِ عَ رَ شَ ﭑ لْننِلَ كٍرٍن تٌمَ وٌ يَ مَ.<verse eid="JOB 17:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 17:11"/>ﭑ مَ سِمَيَ كْنتِ بَرَ حْن،</para>
  <para style="q" vid="JOB 17:11">ﭑ مُ فّشِ ﭑ مَ وَلِيٍ رَ،</para>
  <para style="q" vid="JOB 17:11">ﭑ وَشْنقٍ مُ سْونّيَشِ ﭑ بّ.<verse eid="JOB 17:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 17:12"/>يِ تِنشِنتَرٍيٍ قٍ مَقِندِ مَ،</para>
  <para style="q" vid="JOB 17:12">عَ قَلَقٍ رَ عَ دِ مِ نَن نَ نَءِيَلَنيِ رَ.</para>
  <para style="q" vid="JOB 17:12">عٍ نَشّ عَ نَءِيَلَنيِ بَرَ مَكْرّ،</para>
  <para style="q" vid="JOB 17:12">كْنْ عٍ نَ قَلَمَ دِ مِ نَن كُي.<verse eid="JOB 17:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 17:13"/>ﭑ شَشِلِ تِشِ عَلِفِيَمَ نَن نَ قَ،</para>
  <para style="q" vid="JOB 17:13">ﭑ شَ سَ بّلّ دِ مِ كُي،<verse eid="JOB 17:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 17:14"/>فَبُرِ شَ قِندِ ﭑ بَبَ رَ،</para>
  <para style="q" vid="JOB 17:14">كُلِ شَ قِندِ نفَ نُن ﭑ مَافِنّ رَ.<verse eid="JOB 17:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 17:15"/>ﭑ شَشِلِ تِشِ مُنسٍ رَ سْنْن؟</para>
  <para style="q" vid="JOB 17:15">ﭑ شَشِلِ تِدٍ يٌ مُ نَ قَ.<verse eid="JOB 17:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 17:16"/>ﭑ شَشِلِ تِدٍ نَ عَلِفِيَمَ نَن نَ،</para>
  <para style="q" vid="JOB 17:16">ﭑ فٌرٌ مَ دّننَشّ بّندّ شْورَ.»<verse eid="JOB 17:16"/></para>
  <chapter eid="JOB 17"/>
  <chapter number="18" style="c" sid="JOB 18"/>
  <para style="s1">بِلِدَدَ سُوشَكَ شَ مَسٍنيِ قِرِن ندٍ</para>
  <para style="s2">«مِشِ حَاشِيٍ شَ شُننَكَنّ»</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 18:1"/>بِلِدَدَ سُوشَكَ نَشَ عَ قَلَ،<verse eid="JOB 18:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 18:2"/>«وٌ يِ مَسٍنيِ مْولِ دَنمَ تّمُي مُندُن؟</para>
  <para style="q" vid="JOB 18:2">وٌ شَ شَشِلِ سْتْ عَلَكٌ وٌن شَ وْيّن عَ قَنيِ رَ.<verse eid="JOB 18:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 18:3"/>وٌ مُشُ مَحْشُنشِ سُبٍيٍ رَ مُنقٍ رَ؟</para>
  <para style="q" vid="JOB 18:3">مُنقٍ رَ مُشُ قِندِشِ وٌ بّ شَشِلِتَرٍ رَ؟<verse eid="JOB 18:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 18:4"/>عَيُبَ، عِ تَن نَشَن شْنْشِ،</para>
  <para style="q" vid="JOB 18:4">دُنِحَ شَ دَن عِ شَ قٍ رَ؟</para>
  <para style="q" vid="JOB 18:4">فٍيَ شَ تَلَ عِ بّ عَ تِدٍ؟»<verse eid="JOB 18:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="JOB 18:5"/>«ﭑ شَ عَ قَلَ وٌ بّ،</para>
  <para style="q" vid="JOB 18:5">مِشِ حَاشِ شَ قٍ حْنمَ نّ،</para>
  <para style="q" vid="JOB 18:5">عَلْ تّ شُبٍنمَ كِ نَشّ،</para>
  <para style="q" vid="JOB 18:5">عَ بَ نَءِيَلَنيِ رَ مِنِقٍ.<verse eid="JOB 18:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 18:6"/>عَ شَ دٍنبَيَ شَ قٍ حْنمَ نّ،</para>
  <para style="q" vid="JOB 18:6">عَ يّتّ شَ قٍ دَنمَ نّ.<verse eid="JOB 18:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 18:7"/>عَ مُ عَ حّرّ مَ سّنبّ رَ سْنْن،</para>
  <para style="q" vid="JOB 18:7">عَ وَشْنقٍ قَمَ نّ عَ شُن نَكَنَدٍ.<verse eid="JOB 18:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 18:8"/>عَ بَرَ سُشُ يّلّ رَ،</para>
  <para style="q" vid="JOB 18:8">عَ مُ مِنِمَ نَشَن كُي سْنْن.<verse eid="JOB 18:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 18:9"/>فَنتَنيِ بَرَ عَ سَنيِ سُشُ،</para>
  <para style="q" vid="JOB 18:9">عَ مُ عَ بَمَ نَشَن يِ سْنْن.<verse eid="JOB 18:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 18:10"/>فَنتَنيِ لُوتِ نُ نْشُنشِ بّندّ بُن مَ،</para>
  <para style="q" vid="JOB 18:10">فَنتَنيِ نُ تٍشِ سَنكِرَ شْن مَ.<verse eid="JOB 18:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 18:11"/>فَاشُي بَرَ عَ سُشُ عَ شَ قٍ بِرِن كُي.<verse eid="JOB 18:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 18:12"/>كَامّ بَرَ عَ سُشُ،</para>
  <para style="q" vid="JOB 18:12">عَ بَرَ لُ تْورّ كُي.<verse eid="JOB 18:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 18:13"/>عَ قَتٍ بَرَ بَ عَ مَ،</para>
  <para style="q" vid="JOB 18:13">عَ سَلٌنسٍ نَ بْرْقٍ سَيَ كِرَ شْن مَ.<verse eid="JOB 18:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 18:14"/>عَ بَرَ كٍلِ عَ شْنيِ عَ نُ لَشِ دّننَشّ رَ،</para>
  <para style="q" vid="JOB 18:14">عَ نَ سِفَقٍ مَنفّ مَفَاشُشِ يِرٍ.<verse eid="JOB 18:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 18:15"/>عِ نْمَ لُدٍ عَ شَ بَنشِ كُي،</para>
  <para style="q" vid="JOB 18:15">عَ فبٍ مُ لُشِ سْنْن.</para>
  <para style="q" vid="JOB 18:15">عَلِفِيَمَ بَرَ قِندِ عَ شْنيِ رَ.<verse eid="JOB 18:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 18:16"/>عَ سَنكٍيٍ بَرَ شَرَ،</para>
  <para style="q" vid="JOB 18:16">عَ سَلٌنيِيٍ بَرَ لِسِ.<verse eid="JOB 18:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 18:17"/>دُنِحَ مِشِيٍ بَرَ نّيمُ عَ مَ،</para>
  <para style="q" vid="JOB 18:17">عٍ مُ رَتُمَ عَ شِلِ مَ سْنْن.<verse eid="JOB 18:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 18:18"/>عَ بَرَ كٍلِ نَءِيَلَنيِ كُي،</para>
  <para style="q" vid="JOB 18:18">عَ سٌ دِ مِ كُي دُنِحَ قَرِ مَ.<verse eid="JOB 18:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 18:19"/>دِ مُ عَ بّ، عِ قَ عَ عِ نّ مَمَدِ.</para>
  <para style="q" vid="JOB 18:19">عَ نُ سَبَتِشِ دّننَشّ،</para>
  <para style="q" vid="JOB 18:19">بْنسْي يٌ مُ عَ بّ مّننِ سْنْن.<verse eid="JOB 18:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 18:20"/>بْنسْي نَشٍيٍ سَ قَمَ، كٍلِ سٌفٍتٍدٍ نُن سٌفٍفٌرٌدٍ،</para>
  <para style="q" vid="JOB 18:20">نٍيٍ قَمَ نّ كَابَدٍ عَ شَ شُننَكَنّ مَ،</para>
  <para style="q" vid="JOB 18:20">فَاشُي قَ عٍ سُشُ.<verse eid="JOB 18:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 18:21"/>تِنشِنتَرٍ شَ مَرَحْنيِ لُمَ نَ كِ نّ،</para>
  <para style="q" vid="JOB 18:21">عَلَ كٌلٌنتَرٍ شَ قٍ رَبَمَ نَ كِ نّ.»<verse eid="JOB 18:21"/></para>
  <chapter eid="JOB 18"/>
  <chapter number="19" style="c" sid="JOB 19"/>
  <para style="s1">عَيُبَ شَ مَسٍنيِ سٍننِ ندٍ</para>
  <para style="s2">«ﭑ نَكِسِمَ نَ قَقٍ»</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 19:1"/>عَيُبَ نَشَ عَ يَابِ،<verse eid="JOB 19:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 19:2"/>«وٌ قَمَ ﭑ تْورْدٍ هَن تّمُي مُندُن؟</para>
  <para style="q" vid="JOB 19:2">وٌ ﭑ بْحّ هَلَكِمَ وٌ شَ مَسٍنيِ رَ هَن تّمُي مُندُن؟<verse eid="JOB 19:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 19:3"/>عَ دْشْ قُ نَن يِ كِ وٌ ﭑ كٌنبِمَ،</para>
  <para style="q" vid="JOB 19:3">ﭑ تْورْقٍ مُ وٌ يَافِمَ؟<verse eid="JOB 19:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 19:4"/>شَ نْندِ نَ عَ رَ، ﭑ نَ يُنُبِ كُي،</para>
  <para style="q" vid="JOB 19:4">عَوَ، نَ يُنُبِ لُمَ ﭑ تَن نَن مَ.<verse eid="JOB 19:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 19:5"/>شَ وٌ وَ مَ عَ مَسٍنقٍ ﭑ بّ عَ وٌ قِسَ ﭑ بّ،</para>
  <para style="q" vid="JOB 19:5">شَ وٌ وَ مَ ﭑ مَ تْورّ قِندِقٍ ﭑ مَ يُنُبِ رَ،<verse eid="JOB 19:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 19:6"/>وٌ شَ عَ كٌلٌن شْنّ نَشَن نَ ﭑ مَ،</para>
  <para style="q" vid="JOB 19:6">نَ قَتَنشِ عَلَ نَن نَ،</para>
  <para style="q" vid="JOB 19:6">عَ تَن نَن ﭑ سُشُشِ عَ شَ يّلّ رَ.<verse eid="JOB 19:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 19:7"/>شَ ﭑ سَ فبٍلٍفبٍلٍ ﭑ مَ شْنّ شَ قٍ رَ،</para>
  <para style="q" vid="JOB 19:7">ﭑ مُ يَابِ يٌ سْتْمَ.</para>
  <para style="q" vid="JOB 19:7">شَ ﭑ سَ وَ كِيتِ شَ سَ،</para>
  <para style="q" vid="JOB 19:7">كِيتِ تِنشِنشِ يٌ مُ سَمَ.<verse eid="JOB 19:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 19:8"/>عَلَ بَرَ كِرَ عِبٌلٌن ﭑ يَ رَ،</para>
  <para style="q" vid="JOB 19:8">ﭑ مُ نْمَ دَنفِدٍ،</para>
  <para style="q" vid="JOB 19:8">عَ بَرَ ﭑ مَ كِرَ عِقْورْ ﭑ مَ.<verse eid="JOB 19:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 19:9"/>عَ بَرَ ﭑ شُن نَكَنَ،</para>
  <para style="q" vid="JOB 19:9">عَ بَرَ بِنيّ بِرِن بَ ﭑ مَ.<verse eid="JOB 19:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 19:10"/>عَ بَرَ ﭑ مَ قٍ بِرِن نَبِرَ.</para>
  <para style="q" vid="JOB 19:10">عَ بَرَ ﭑ شَشِلِ تِدٍ تَلَ عَلْ سَنسِ بِلِ تَلَمَ كِ نَشّ.<verse eid="JOB 19:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 19:11"/>عَ بَرَ شْنْ ﭑ مَ عَ حَاشِ رَ،</para>
  <para style="q" vid="JOB 19:11">ﭑ بَرَ قِندِ عَ يَشُي رَ.<verse eid="JOB 19:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 19:12"/>عَ شَ فٍرٍ سٌي بَرَ ﭑ نَبِلِن،</para>
  <para style="q" vid="JOB 19:12">عٍ نَ ﭑ فٍرٍقٍ،</para>
  <para style="q" vid="JOB 19:12">ﭑ مُ نْمَ ﭑ فِدٍ عٍ مَ.<verse eid="JOB 19:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 19:13"/>عَ بَرَ ﭑ نفَشَكٍرٍنيِيٍ مَكُيَ ﭑ نَ،</para>
  <para style="q" vid="JOB 19:13">ﭑ كٌلٌنمَيٍ بَرَ يٍنسٍن يّ.<verse eid="JOB 19:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 19:14"/>ﭑ دْشْبٌورٍيٍ بَرَ ﭑ نَبّحِن،</para>
  <para style="q" vid="JOB 19:14">ﭑ دّقَنبٌورٍيٍ بَرَ ﭑ نَبٌلٌ.<verse eid="JOB 19:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 19:15"/>ﭑ مَ شْحّيٍ نُن ﭑ مَ كٌنيِيٍ،</para>
  <para style="q" vid="JOB 19:15">نٍيٍ مُ ﭑ كٌلٌن سْنْن.<verse eid="JOB 19:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 19:16"/>ﭑ نَ ﭑ مَ كٌنيِ شِلِ،</para>
  <para style="q" vid="JOB 19:16">هَلِ ﭑ عَ مَيَندِ،</para>
  <para style="q" vid="JOB 19:16">عَ مُ ﭑ مَ شِلِ رَتِنمَ.<verse eid="JOB 19:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 19:17"/>ﭑ دّ شِرِ بَرَ رَحَاشُ ﭑ مَ فِنّ مَ،</para>
  <para style="q" vid="JOB 19:17">ﭑ مَ قٍ مُ رَقَن ﭑ نفَشَكٍرٍنيِيٍ مَ.<verse eid="JOB 19:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 19:18"/>دِ مّيٍ يَتِ يٌمَ ﭑ مَ.<verse eid="JOB 19:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 19:19"/>ﭑ فُندٌ شِرِ بٌورٍ بَرَ ﭑ شْن،</para>
  <para style="q" vid="JOB 19:19">ﭑ شَنُنتٍنيِيٍ بَرَ ﭑ يَنقَ.<verse eid="JOB 19:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 19:20"/>ﭑ قَتٍ بِرِن بَرَ بَ ﭑ مَ،</para>
  <para style="q" vid="JOB 19:20">ﭑ شْرِيٍ مِنِ كّنّ مَ.</para>
  <para style="q" vid="JOB 19:20">سٍسٍ مُ لُشِ سْنْن.<verse eid="JOB 19:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 19:21"/>ﭑ بٌورٍيٍ، وٌ كِنِكِنِ ﭑ مَ،</para>
  <para style="q" vid="JOB 19:21">يَندِ، وٌ كِنِكِنِ ﭑ مَ،</para>
  <para style="q" vid="JOB 19:21">بَرِ مَ عَلَ نَن ﭑ بْنبْشِ.<verse eid="JOB 19:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 19:22"/>مُنقٍ رَ وٌ ﭑ تْورْ مَ عَلْ عَلَ عَ رَبَشِ كِ نَشّ؟</para>
  <para style="q" vid="JOB 19:22">وٌ مُ نُ وَ سَ سِندٍن؟»<verse eid="JOB 19:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="JOB 19:23"/>«شَ ﭑ مَ وْيّنيِيٍ سّبّشِ بُكِ كُي نُ،<verse eid="JOB 19:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 19:24"/>شَ عٍ مَسٌلِشِ فّمّ مَ وُرٍ رَ نُ،</para>
  <para style="q" vid="JOB 19:24">نَ تّمُي عٍ بُمَ نّ نُ عَبَدَن.<verse eid="JOB 19:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 19:25"/>كْنْ ﭑ تَن عَ كٌلٌن ﭑ نَكِسِمَ حِحّ نَ عَ رَ.</para>
  <para style="q" vid="JOB 19:25">عَ قَمَ وْيّنيِ دْنشْي قَلَدٍ دُنِحَ مَ.<verse eid="JOB 19:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 19:26"/>ﭑ قَتٍ نَ فّ بْرْدٍ،</para>
  <para style="q" vid="JOB 19:26">ﭑ تَن يَتِ قَمَ نّ عَلَ تٌدٍ.<verse eid="JOB 19:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 19:27"/>ﭑ تَن نَن يَتِ قَمَ عَ تٌدٍ ﭑ يَيٍ رَ،</para>
  <para style="q" vid="JOB 19:27">عَ مُ مَتَالِمَ ﭑ بّ.</para>
  <para style="q" vid="JOB 19:27">نَ كُي ﭑ بْحّ سّيوَ مَ نّ عَ قَنيِ رَ.<verse eid="JOB 19:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 19:28"/>وٌ تَن نَشٍيٍ مَشْرِنيِ تِمَ،</para>
  <para style="q" vid="JOB 19:28">‹وٌن عَ تْورْقٍ مُنقٍ رَ؟›</para>
  <para style="q" vid="JOB 19:28">وٌ قَمَ ﭑ مَ نْندِ كٌلٌندٍ.<verse eid="JOB 19:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 19:29"/>وٌ شَ فَاشُ سَنتِدّفّمَ يَ رَ،</para>
  <para style="q" vid="JOB 19:29">بَرِ مَ حَشَنكَتّ وٌ سْتْمَ نّ وٌ شَ قٍ حَاشِيٍ مَ.</para>
  <para style="q" vid="JOB 19:29">نَ كُي وٌ قَمَ عَ كٌلٌندٍ عَ كِيتِسَ ندٍ نَ.»<verse eid="JOB 19:29"/></para>
  <chapter eid="JOB 19"/>
  <chapter number="20" style="c" sid="JOB 20"/>
  <para style="s1">سٌقَرَ شَ مَسٍنيِ قِرِن ندٍ</para>
  <para style="s2">«تْورّ نَن نَ تِنشِنتَرٍ كّ رَ»</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 20:1"/>سٌقَرَ نَامَكَ نَشَ عَ قَلَ،<verse eid="JOB 20:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 20:2"/>«عِ شَ مَسٍنيِ بَرَ ﭑ تْورْ،</para>
  <para style="q" vid="JOB 20:2">قٌ ﭑ شَ عِ يَابِ.<verse eid="JOB 20:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 20:3"/>ﭑ بَرَ مَرَكْرْ سِ ندٍ مّ</para>
  <para style="q" vid="JOB 20:3">نَشَن بَرَ ﭑ شَشِلِ عِقُ.</para>
  <para style="q" vid="JOB 20:3">ﭑ عِ يَابِمَ ﭑ مَ لْننِ رَ نَ نَن مَ.<verse eid="JOB 20:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 20:4"/>عِ مُ عَ كٌلٌن كَبِ عَدَ مَ نَشَ دَا، عَ لُ دُنِحَ مَ،<verse eid="JOB 20:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 20:5"/>مِشِ حَاشِيٍ شَ شُننَكٍلِ مُ بُمَ؟</para>
  <para style="q" vid="JOB 20:5">عٍ شَ حّلّشِنيِ دُنكٍ؟<verse eid="JOB 20:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 20:6"/>هَلِ عَ شَ قٍ فبٌ يّ،</para>
  <para style="q" vid="JOB 20:6">هَلِ عَ شُنيِ كٌورٍ لِ،<verse eid="JOB 20:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 20:7"/>عَ قَمَ سْنتْدٍ عَ لُ عَلْ سٍ نَشَن تِدٍ مُ نَ،</para>
  <para style="q" vid="JOB 20:7">عَ كٌلٌنمَيٍ نُ قَ مَشْرِنيِ تِ، ‹عَ نَ مِندٍن؟›<verse eid="JOB 20:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 20:8"/>عَ دَنفِمَ نّ عَلْ شِيٍ.<verse eid="JOB 20:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 20:9"/>عَ كٌلٌنمَيٍ مُ عَ تٌمَ سْنْن،</para>
  <para style="q" vid="JOB 20:9">عَ لْيمَ نّ عَ شَ مِشِيٍ مَ.<verse eid="JOB 20:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 20:10"/>عَ شَ دِيٍ سٍتَرٍيٍ كِمَ سٍيٍ رَ، عٍ بَبَ نَشٍيٍ مُحَ.</para>
  <para style="q" vid="JOB 20:10">عٍ بَبَ شَ نَاقُلِ فبِلٍنمَ نّ نَ مِشِيٍ مَ.<verse eid="JOB 20:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 20:11"/>سّنبّ نَشَن نُ نَ عَ يِ رَ عَ قٌنِكٍ رَ،</para>
  <para style="q" vid="JOB 20:11">نَ بِرِن كَنَمَ نّ، عَ قِندِ بّندّ رَ.<verse eid="JOB 20:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 20:12"/>قٍ حَاشِ نَ رَقَن مِشِ مَ،</para>
  <para style="q" vid="JOB 20:12">عَ قَ نَ رَفَتَ عَ قُرِ كُي،<verse eid="JOB 20:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 20:13"/>عَ مُ عَ بّحِن،</para>
  <para style="q" vid="JOB 20:13">عَ مُ فبِلٍن نَ قْشْ رَ،<verse eid="JOB 20:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 20:14"/>عَ شَ دٌنسٍ قِندِ مَ ثْسْنّ نَن نَ عَ قُرِ كُي.<verse eid="JOB 20:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 20:15"/>عَ نَاقُلِ نَشَن دٌنشِ،</para>
  <para style="q" vid="JOB 20:15">عَ قَمَ نَ بْشُندٍ.</para>
  <para style="q" vid="JOB 20:15">عَلَ يَتِ نَ بَمَ نّ عَ قُرِ كُي.<verse eid="JOB 20:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 20:16"/>عَ بْشِمَسٍ شَ شْنّ نَن بّسُمَ،</para>
  <para style="q" vid="JOB 20:16">بِيدَ نَن عَ قَشَمَ.<verse eid="JOB 20:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 20:17"/>عَ هَرِفٍ نَشَن سْتْشِ،</para>
  <para style="q" vid="JOB 20:17">نَشَن بَرَ فبٌ يّ عَلْ شُرٍ،<verse eid="JOB 20:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 20:18"/>عَ نَ بِرِن نَفبِلٍنمَ نّ،</para>
  <para style="q" vid="JOB 20:18">عَ مُ نْمَ نَ سٍسٍ دٌندٍ.</para>
  <para style="q" vid="JOB 20:18">نَ مُ قِندِ مَ حّلّشِنيِ رَ عَ بّ،<verse eid="JOB 20:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 20:19"/>بَرِ مَ عَ بَرَ سٍ بَ تْورْ مِشِيٍ يِ رَ.</para>
  <para style="q" vid="JOB 20:19">عَ بَرَ عٍ شَ بَنشِيٍ بَ عٍ يِ رَ،</para>
  <para style="q" vid="JOB 20:19">عَ مُ نَشٍيٍ تِشِ.<verse eid="JOB 20:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 20:20"/>وَ سَبَلِ نَن تٌ نُ عَ رَ عَ شَ مِلّ كُي،</para>
  <para style="q" vid="JOB 20:20">عَ هَرِفٍ كٍرٍن مُ رَتَنفَمَ.<verse eid="JOB 20:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 20:21"/>عَ تٌ نُ سٍ بِرِن مَحْشُنشِ عَ يّتّ نَن بّ،</para>
  <para style="q" vid="JOB 20:21">عَ شَ هّيرِ مُ بُمَ.<verse eid="JOB 20:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 20:22"/>عَ نّ نَ عَ شَ قَنيِ تَفِ،</para>
  <para style="q" vid="JOB 20:22">تْورْ سِن تّمُي نَن نَ كِ عَ مَ.<verse eid="JOB 20:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 20:23"/>عَ دّفٍ تّمُي، عَلَ قَمَ عَ تْورْدٍ عَ شَ شْنّ رَ،</para>
  <para style="q" vid="JOB 20:23">نَ تْورّ قَ قِندِ عَ شَ دٌنسٍ رَ.<verse eid="JOB 20:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 20:24"/>شَ فٍرٍ سٌسٍ لَنمَدِ مُ عَ تْورْ،</para>
  <para style="q" vid="JOB 20:24">فٍرٍ سٌسٍ شُنفبٍ نَن نَوَلِمَ عَ شِلِ مَ.<verse eid="JOB 20:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 20:25"/>هَلِ عَ تَنبّ تَلَ عٍ عَ سْشْشِ نَشَن نَ،</para>
  <para style="q" vid="JOB 20:25">قٍ مَفَاشُشِ فبّتّ قَمَ نّ عَ لِدٍ.<verse eid="JOB 20:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 20:26"/>عَ شَ نَاقُلِ بِرِن لُمَ دِ مِ نَن كُي،</para>
  <para style="q" vid="JOB 20:26">تّ قَ نَ بِرِن فَن عَ شْنيِ.<verse eid="JOB 20:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 20:27"/>عَلَ عَ شَ يُنُبِ مَكّنّن مَ،</para>
  <para style="q" vid="JOB 20:27">عَدَ مَدِيٍ نَ سَرٍ رَفبِلٍن عَ مَ.<verse eid="JOB 20:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 20:28"/>عَ شَ نَاقُلِ بِرِن سِفَمَ نّ</para>
  <para style="q" vid="JOB 20:28">عَلَ شَ شْنّ لْشْي.<verse eid="JOB 20:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 20:29"/>عَلَ نَ نَن قِمَ مِشِ حَاشِ مَ كّ رَ.</para>
  <para style="q" vid="JOB 20:29">نَ بَرَ قِندِ عَلَ حَنِفٍ رَ نَ مِشِ مْولِ بّ.»<verse eid="JOB 20:29"/></para>
  <chapter eid="JOB 20"/>
  <chapter number="21" style="c" sid="JOB 21"/>
  <para style="s">عَيُبَ شَ مَسٍنيِ سٌلٌقٍرٍ ندٍ</para>
  <para style="s2">«مُنقٍ رَ تِنشِنتَرٍيٍ مُ تْورْ مَ؟»</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 21:1"/>عَيُبَ نَشَ عَ يَابِ،<verse eid="JOB 21:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 21:2"/>«وٌ وٌ تُلِ مَتِ ﭑ مَ مَسٍنيِ رَ.</para>
  <para style="q" vid="JOB 21:2">وٌ شَ نَ رَبَ ﭑ بّ.<verse eid="JOB 21:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 21:3"/>وٌ دِحّ ﭑ بّ، ﭑ شَ وْيّن.</para>
  <para style="q" vid="JOB 21:3">ﭑ نَ فّ، وٌ قَ يٌ ﭑ مَ.<verse eid="JOB 21:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 21:4"/>ﭑ نَن ﭑ شُن مَوَشِ مِشِ نَن شِلِ مَ؟</para>
  <para style="q" vid="JOB 21:4">قْلْ يِ تّمُي مَ، ﭑ دِحّمَ مُنقٍ رَ قَ؟<verse eid="JOB 21:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 21:5"/>وٌ وٌ يَ تِ ﭑ نَ، وٌ شَ ﭑ قَتٍ عِفبّ.</para>
  <para style="q" vid="JOB 21:5">وٌ مُ كَابَشِ شّ ﭑ قَتٍ مَ؟<verse eid="JOB 21:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 21:6"/>ﭑ نَن ﭑ مَحْشُن عَ مَ،</para>
  <para style="q" vid="JOB 21:6">فَاشُي نَن ﭑ سُشُمَ،</para>
  <para style="q" vid="JOB 21:6">ﭑ قَتٍ بِرِن نُ سّرّن ﭑ مَ.»<verse eid="JOB 21:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="JOB 21:7"/>«مُنقٍ رَ مِشِ حَاشِيٍ بُمَ دُنِحَ مَ؟</para>
  <para style="q" vid="JOB 21:7">مُنقٍ رَ عٍ قِندِ مَ شّمْشِ سّنبّمَيٍ رَ؟<verse eid="JOB 21:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 21:8"/>عٍ شَ دِيٍ شُن نَكٍلِمَ،</para>
  <para style="q" vid="JOB 21:8">عٍ بْنسْييٍ قَن قٍ قَنيِ سْتْمَ عٍ يَ حِحّ رَ.<verse eid="JOB 21:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 21:9"/>عٍ شَ دٍنبَيَيٍ لُمَ بْحّسَ كُي،</para>
  <para style="q" vid="JOB 21:9">فَاشُي يٌ مُ عٍ مَ،</para>
  <para style="q" vid="JOB 21:9">عَلَ قَن مُ عٍ تْورْ مَ.<verse eid="JOB 21:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 21:10"/>عٍ شَ تُورَيٍ سّنبّ فبٌ،</para>
  <para style="q" vid="JOB 21:10">عٍ تٍمَ عٍ شَ نِنفٍ فِنّيٍ مَ،</para>
  <para style="q" vid="JOB 21:10">نٍيٍ دِيٍ بَرِ مَ، عٍ قُرِ مُ بِرَ مَ.<verse eid="JOB 21:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 21:11"/>نَ مِشِ حَاشِيٍ شَ دِيٍ قَرٍ بٌرٌنمَ،<verse eid="JOB 21:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 21:12"/>عٍ سِفِ سَمَ مَشَسٍيٍ، كْرَ، نُن شُلٍ شُي رَ.<verse eid="JOB 21:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 21:13"/>عٍ شَ سِمَيَ كَمَلِمَ هّيرِ كُي،</para>
  <para style="q" vid="JOB 21:13">عٍ مَن قَ قَشَ قَشّ سْونّيَشِ رَ.»<verse eid="JOB 21:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="JOB 21:14"/>«عَ نُن، عٍ نُ عَ قَلَمَ نّ عَلَ بّ عٍ شَ سِمَيَ كُي،</para>
  <para style="q" vid="JOB 21:14">‹عِ مَكُيَ مُشُ رَ، مُشُ مُ وَ مَ عِ شَ سّرِيّ كٌلٌنقٍ.<verse eid="JOB 21:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 21:15"/>مُشُ عَلَ سّنبّ كَنيِ رَبَتُمَ مُنقٍ رَ؟</para>
  <para style="q" vid="JOB 21:15">عَ مَشَندِقٍ قِندِ مَ فٍينِ مُندُن نَ مُشُ بّ؟›<verse eid="JOB 21:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 21:16"/>ﭑ عَ كٌلٌن عٍ هَرِفٍ مُ نُ قَتَنشِ عٍ يّتّ شَ رَ،</para>
  <para style="q" vid="JOB 21:16">ﭑ نَن ﭑ مَكُيَمَ مِشِ حَاشِيٍ شَ مَرَ سِ رَ نَ نَن مَ.<verse eid="JOB 21:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 21:17"/>كْنْ هَلَكِ مِشِ حَاشِيٍ لِمَ تّمُي بِرِن نّ؟</para>
  <para style="q" vid="JOB 21:17">عَلَ فبَلٌي فبٍفبٍ رَفِرِ مَ عٍ مَ عَ شَ شْنّ كُي؟<verse eid="JOB 21:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 21:18"/>عٍ شَ قٍ كَنَمَ عَ فبٍ رَ،</para>
  <para style="q" vid="JOB 21:18">عَلْ مَالٍ لَفِ قٌيٍ نَشَن نَ قَنَقَنَنمَ؟<verse eid="JOB 21:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 21:19"/>عَلَ حَشَنكَتّ رَفَتَمَ عٍ شَ دِيٍ بّ؟</para>
  <para style="q" vid="JOB 21:19">مُنقٍ رَ عَ مُ عٍ تَن يَتِ حَشَنكَتَمَ؟<verse eid="JOB 21:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 21:20"/>عَ لَنمَ عٍ تَن يَتِ شَ عٍ شَ تْورّ تٌ عٍ يَ رَ،</para>
  <para style="q" vid="JOB 21:20">عٍ تَن يَتِ شَ عَلَ سّنبّ كَنيِ شَ شْنّ كٌلٌن.<verse eid="JOB 21:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 21:21"/>شَ مِشِ حَاشِ فّ قَشَدٍ،</para>
  <para style="q" vid="JOB 21:21">عَ مُ عَ شَ دٍنبَيَ شَ تْورّ كٌلٌنمَ.<verse eid="JOB 21:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 21:22"/>عَدَ مَدِ نْمَ لْننِ ندٍ قِدٍ عَلَ مَ،</para>
  <para style="q" vid="JOB 21:22">مَنفّيَ بِرِن نَ نَشَن مَ يَامَرِ بُن مَ؟<verse eid="JOB 21:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 21:23"/>مِشِ ندٍ قَشَمَ بْحّسَ كُي،</para>
  <para style="q" vid="JOB 21:23">عَ سّنبّ فبٌ، كْنتْقِلِ يٌ مُ لُ عَ مَ،<verse eid="JOB 21:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 21:24"/>عَ قَتٍ قَن، عَ شْرِيٍ شْرْشْ فبٍن.<verse eid="JOB 21:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 21:25"/>كْنْ مِشِ فبّتّ تَن قَشَمَ تْورّ كُي،</para>
  <para style="q" vid="JOB 21:25">عَ مُ هّيرِ يٌ نّمُننّمُن.<verse eid="JOB 21:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 21:26"/>نَ مِشِ قِرِنيِ بِرِن سَمَ بّندّ نّ،</para>
  <para style="q" vid="JOB 21:26">كُلِ قَ عٍ دٌن.<verse eid="JOB 21:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 21:27"/>ﭑ وٌ شَ مَحْشُنيِيٍ كٌلٌن عَ قَنيِ رَ،</para>
  <para style="q" vid="JOB 21:27">وٌ وَ مَ نْندِ رَكَنَقٍ ﭑ نَ نَشٍيٍ شَقٍ رَ.<verse eid="JOB 21:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 21:28"/>وٌ نَشّ، ‹كُنتِفِ شَ بَنشِ نَ مِندٍن؟</para>
  <para style="q" vid="JOB 21:28">مِشِ حَاشِ شْنيِ نَ دِ؟›<verse eid="JOB 21:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 21:29"/>كْنْ وٌ مُ مَشْرِنيِ تِشِ بِيَاسِلَيٍ مَ؟</para>
  <para style="q" vid="JOB 21:29">وٌ مُ وٌ تُلِ مَتِشِ عٍ شَ دّنتّفّ رَ؟<verse eid="JOB 21:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="JOB 21:30"/>مِشِ حَاشِ مُ فبَلٌي سْتْمَ فبَلٌي لْشْي،</para>
  <para style="q" vid="JOB 21:30">عَ رَتَنفَمَ نّ نَ شْنّ مَ.<verse eid="JOB 21:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="JOB 21:31"/>ندٍ تِمَ عَ يَ عِ عَ عَ مَكِيتِ؟</para>
  <para style="q" vid="JOB 21:31">ندٍ عَ شَ وَلِ كٌبِ سَرٍ رَفبِلٍنمَ عَ مَ؟<verse eid="JOB 21:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="JOB 21:32"/>مِشِيٍ عَ شَنِنمَ فَبُرِ،</para>
  <para style="q" vid="JOB 21:32">عٍ مَن قَ بِنيّ سَ عَ مَ مّننِ.<verse eid="JOB 21:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="JOB 21:33"/>فَبُرِ بّندّ مُ عَ تْورْ مَ،</para>
  <para style="q" vid="JOB 21:33">عَ بِنيّ سْتْ حَمَ فبٍفبٍ رَ.<verse eid="JOB 21:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="JOB 21:34"/>نَ كُي، وٌ ﭑ مَدُندُ مَ مَدُندُي قُيَن نَ دِ؟</para>
  <para style="q" vid="JOB 21:34">مَدَشُي مَسٍنيِيٍ نَن تُن نَ وٌ شَ لْننِ مَسٍنيِيٍ كُي.»<verse eid="JOB 21:34"/></para>
  <chapter eid="JOB 21"/>
  <chapter number="22" style="c" sid="JOB 22"/>
  <para style="s1">عٍلِقَسِ تٍمَنكَ شَ مَسٍنيِ سَشَن ندٍ</para>
  <para style="s2">«عَيُبَ شَ فبِلٍن عَلَ مَ»</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 22:1"/>عٍلِقَسِ تٍمَنكَ نَشَ عَ قَلَ،<verse eid="JOB 22:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 22:2"/>«عَدَ مَ تِدٍ نَ عَلَ بّ؟</para>
  <para style="q" vid="JOB 22:2">عَدٍ، عَدَ مَ لْننِشِ نْمَ عَ يّتّ فبَنسَن نَن مَلِدٍ.<verse eid="JOB 22:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 22:3"/>عِ شَ تِنشِنيِ قِندِ مَ فٍينِ مُندُن نَ عَلَ سّنبّ كَنيِ بّ؟</para>
  <para style="q" vid="JOB 22:3">عِ لُقٍ نْندِ كُي، نَ عَلَ مَلِمَ دِ؟<verse eid="JOB 22:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 22:4"/>عَلَ نَ عِ حَشَنكَتَقٍ عِ شَ تِنشِنيِ نَن شَ قٍ رَ؟</para>
  <para style="q" vid="JOB 22:4">عَ نَ كِيتِ حَاشِ سَقٍ عِ مَ نَ نَن مَ؟<verse eid="JOB 22:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 22:5"/>عِ شَ قٍ حَاشِ مُ فبٌشِ شّ؟</para>
  <para style="q" vid="JOB 22:5">عِ شَ يُنُبِيٍ مُ وُيَشِ شّ هَن عَ دَنفِ عَ عِ؟<verse eid="JOB 22:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 22:6"/>عِ بَرَ سٍيٍ رَ سُشُ سّيكّ رَ عِ نفَشَكٍرٍنيِيٍ يِ رَ.</para>
  <para style="q" vid="JOB 22:6">عِ بَرَ عٍ شَ سٌسٍيٍ يَتِ بَ عٍ مَ،</para>
  <para style="q" vid="JOB 22:6">عِ عٍ مَفٍلِ تِ.<verse eid="JOB 22:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 22:7"/>عِ مُ نُ مِشِ كِمَ يٍ رَ، يٍ شْلِ نُ نَشَن مَ،</para>
  <para style="q" vid="JOB 22:7">عِ مُ نُ كَامّتْي كِمَ دٌنسٍ رَ.<verse eid="JOB 22:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 22:8"/>عِ نُ بْشِ سٌمَ سّنبّمَ نَن يِ رَ،</para>
  <para style="q" vid="JOB 22:8">نَا قِندِ يّتّ عِفبٌي سَبَتِدٍ رَ.<verse eid="JOB 22:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 22:9"/>عِ نُ كَاحّ فِنّيٍ نُن كِرِدِيٍ كٍرِ نّ عٍ بّلّشّ عِفٍلِ رَ.<verse eid="JOB 22:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 22:10"/>نَ نَن عَ تٌشِ عِ رَبِلِنشِ فَنتَنيِيٍ رَ،</para>
  <para style="q" vid="JOB 22:10">قٍ مَفَاشُشِيٍ عِ سْتْشِ.<verse eid="JOB 22:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 22:11"/>عِ مُ نَ دِ مِ حَاشِ تٌقٍ؟</para>
  <para style="q" vid="JOB 22:11">عِ مُ نَ يٍ تٌقٍ عِ مَدُلَقٍ نَشَن شْورَ؟»<verse eid="JOB 22:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="JOB 22:12"/>«عَلَ مُ نَ كٌورٍ مَ؟</para>
  <para style="q" vid="JOB 22:12">تُنبُييٍ مَتٌ، عٍ عِتٍشِ كِ نَشّ.<verse eid="JOB 22:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 22:13"/>عِ قَ عَ قَلَمَ مُنقٍ رَ،</para>
  <para style="q" vid="JOB 22:13">‹عَلَ مُنسٍ كٌلٌن؟</para>
  <para style="q" vid="JOB 22:13">عَلَ نَشَن نَ نُشُييٍ قَرِ مَ،</para>
  <para style="q" vid="JOB 22:13">نَ نْمَ كِيتِ سَدٍ بٍ؟<verse eid="JOB 22:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 22:14"/>نُشُييٍ نَ عَلَ نُن عَدَ مَيٍ نَن تَفِ.</para>
  <para style="q" vid="JOB 22:14">عَلَ عَ حّرّ مَ كٌورٍ مَ،</para>
  <para style="q" vid="JOB 22:14">كْنْ عَ مُ نْمَ عَدَ مَيٍ تٌدٍ.›<verse eid="JOB 22:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 22:15"/>عِ وَ مَ لُقٍ نَ كِرَ قٌرِ نَن شْن مَ،</para>
  <para style="q" vid="JOB 22:15">تِنشِنتَرٍيٍ نَ دّننَشّ كَبِ تّمُي شْننَكُيٍ؟<verse eid="JOB 22:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 22:16"/>عٍ قَشَ نّ عٍ شَ سِمَيَ كْنتِ مُ كَمَلِ،</para>
  <para style="q" vid="JOB 22:16">عَلْ يٍ بَنبَرَنشِ سٍ شَنِنمَ كِ نَشّ.<verse eid="JOB 22:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 22:17"/>عٍ عَ قَلَ نّ عَلَ بّ،</para>
  <para style="q" vid="JOB 22:17">‹فبِلٍن مُشُ قْشْ رَ.</para>
  <para style="q" vid="JOB 22:17">عَلَ سّنبّ كَنيِ نْمَ مُنسٍ رَبَدٍ مُشُ بّ؟›<verse eid="JOB 22:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 22:18"/>كْنْ عَلَ نَن هَرِفٍ فبٍفبٍ قِ عٍ مَ.</para>
  <para style="q" vid="JOB 22:18">نَ نَن عَ تٌمَ ﭑ مُ ﭑ تُلِ مَتِمَ مِشِ حَاشِيٍ شَ مَرَ سِ رَ.<verse eid="JOB 22:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 22:19"/>تِنشِنتْييٍ مِشِ حَاشِيٍ شَ هَلَكِ تٌمَ نّ،</para>
  <para style="q" vid="JOB 22:19">عَ قِندِ عٍ بّ حّلّشِنيِ رَ.</para>
  <para style="q" vid="JOB 22:19">مِشِ قَنيِيٍ يٌمَ نّ عٍ مَ، عٍ عَ قَلَ،<verse eid="JOB 22:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 22:20"/>‹مُشُ يَشُييٍ بَرَ سْنتْ،</para>
  <para style="q" vid="JOB 22:20">تّ بَرَ عٍ شَ نَاقُلِ فَن.›<verse eid="JOB 22:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 22:21"/>نَ كُي، عِ تَن شَ عِ شَ قٍ يَءِلَن عِ تَن نُن عَلَ تَفِ،</para>
  <para style="q" vid="JOB 22:21">عَلَكٌ عِ شَ بْحّسَ سْتْ، عِ مَن شَ هّيرِ كٌلٌن.<verse eid="JOB 22:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 22:22"/>عِ شَ تِن عَ شَ مَرَ سِ رَ،</para>
  <para style="q" vid="JOB 22:22">عِ شَ عَ شَ مَسٍنيِ مَسْتْ عِ بْحّ كُي.<verse eid="JOB 22:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 22:23"/>شَ عِ مَن فبِلٍنمَ عَلَ سّنبّ كَنيِ مَ،</para>
  <para style="q" vid="JOB 22:23">عَ قَمَ عِ شُن نَكٍلِدٍ.</para>
  <para style="q" vid="JOB 22:23">عِ شَ قٍ حَاشِ مَكُيَ عِ شْنيِ رَ،<verse eid="JOB 22:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 22:24"/>عِ شَ شّيمَ وٌلِ شُرٍ مَ،</para>
  <para style="q" vid="JOB 22:24">نَ شّيمَ نَشَن كٍلِشِ عٌقِرِ بْشِ مَ.<verse eid="JOB 22:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 22:25"/>نَ تّمُي عَلَ سّنبّ كَنيِ نَن قِندِ مَ عِ هَرِفٍ رَ،</para>
  <para style="q" vid="JOB 22:25">عَ قِندِ عِ شَ شّيمَ نُن فبٍتِ حْشْي رَ.<verse eid="JOB 22:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 22:26"/>عَلَ سّنبّ كَنيِ نَن قَمَ رَقَندٍ عِ مَ</para>
  <para style="q" vid="JOB 22:26">دَنفِقٍ قٍ بِرِن نَ.</para>
  <para style="q" vid="JOB 22:26">عِ قَمَ عِ شَشِلِ تِدٍ عَ تَن نَن نَ.<verse eid="JOB 22:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 22:27"/>عِ نَ عَ مَشَندِ، عَ عِ شَ دُبّ سُشُمَ نّ.</para>
  <para style="q" vid="JOB 22:27">نَ تّمُي عِ شَ عِ فبٍ لَايِدِ رَكَمَلِ عَ مَبِرِ.<verse eid="JOB 22:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 22:28"/>عَ عِ شَ نَتّيٍ سْونّيَمَ نّ،</para>
  <para style="q" vid="JOB 22:28">عَ تّ يَنبَمَ عِ بّ عِ شَ كِرَيٍ بِرِن شْن مَ.<verse eid="JOB 22:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 22:29"/>عَلَ عَ نِيَمَ نّ عِ شَ مِشِ مَفٌرٌشِ رَكٍلِ،</para>
  <para style="q" vid="JOB 22:29">بَرِ مَ عَ لُمَ نَ مِشِ مْولِ مَلِ رَ.<verse eid="JOB 22:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="JOB 22:30"/>عَ نْمَ يُنُبِتْي يَتِ رَكِسِدٍ،</para>
  <para style="q" vid="JOB 22:30">عِ شَ سّنِيّنيِ سَابُي رَ.»<verse eid="JOB 22:30"/></para>
  <chapter eid="JOB 22"/>
  <chapter number="23" style="c" sid="JOB 23"/>
  <para style="s1">عَيُبَ شَ مَسٍنيِ سٌلٌمَسَشَن ندٍ</para>
  <para style="s2">«عَلَ نَ مِندٍن؟»</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 23:1"/>عَيُبَ نَشَ عَ يَابِ،<verse eid="JOB 23:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 23:2"/>«تٌ قَن ﭑ مَ يَشَسٍرِ مَسَ شْرْشْ،</para>
  <para style="q" vid="JOB 23:2">عَ شَ كٌتٍ فبٌ ﭑ شُن،</para>
  <para style="q" vid="JOB 23:2">ﭑ سّنبّ بَرَ حْن.<verse eid="JOB 23:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 23:3"/>شَ عَ سَ لِ ﭑ نُ نْمَ عَلَ تٌدٍ نُ،</para>
  <para style="q" vid="JOB 23:3">شَ عَ سَ لِ ﭑ نُ نْمَ سِفَدٍ عَ شْنيِ نُ،<verse eid="JOB 23:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 23:4"/>ﭑ نَن ﭑ شَشِلِ كُي عِقٍيٍ بِرِن قَلَمَ نّ عَ بّ نُ.<verse eid="JOB 23:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 23:5"/>نَ كُي ﭑ نُ نْمَ نّ عَ شَ يَابِ كٌلٌندٍ،</para>
  <para style="q" vid="JOB 23:5">عَلَكٌ ﭑ شَ قَهَامُي سْتْ نَ كُي.<verse eid="JOB 23:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 23:6"/>عَ قَمَ عَ سّنبّ بِرِن نَمِنِدٍ ﭑ مَ كِيتِقٍ رَ؟</para>
  <para style="q" vid="JOB 23:6">عَدٍ، عَ عَ يَيٍ نَن تِمَ ﭑ نَ تُن.<verse eid="JOB 23:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 23:7"/>نَ تّمُي عَ ﭑ مَ تِنشِنيِ تٌمَ نّ،</para>
  <para style="q" vid="JOB 23:7">عَ قَ نْندِ قِ ﭑ مَ.»<verse eid="JOB 23:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="JOB 23:8"/>«كْنْ عَلَ مُ تٌمَ سٌفٍتٍدٍ،</para>
  <para style="q" vid="JOB 23:8">عَ مُ تٌمَ سٌفٍفٌرٌدٍ.<verse eid="JOB 23:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 23:9"/>ﭑ عَ قٍنمَ كْولَ مَ،</para>
  <para style="q" vid="JOB 23:9">ﭑ عَ قٍنمَ يِرٍقَنيِ مَ،</para>
  <para style="q" vid="JOB 23:9">كْنْ عَ مُ تٌمَ.<verse eid="JOB 23:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 23:10"/>كْنْ عَ تَن ﭑ تٌمَ عَ قَنيِ رَ.</para>
  <para style="q" vid="JOB 23:10">عَ نَ فّ ﭑ تٌدٍ، عَ نْندِ قِمَ ﭑ مَ.<verse eid="JOB 23:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 23:11"/>ﭑ بِرَشِ نّ عَ قْشْ رَ،</para>
  <para style="q" vid="JOB 23:11">ﭑ عَ شَ سّرِيّ بِرِن نَبَتُ.<verse eid="JOB 23:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 23:12"/>ﭑ مُ عَ شَ يَامَرِيٍ بّحِنشِ.</para>
  <para style="q" vid="JOB 23:12">عَ وَشْنقٍ قِندِشِ نّ ﭑ وَشْنقٍ رَ.»<verse eid="JOB 23:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="JOB 23:13"/>«ندٍ نْمَ عَ شَ نَتّ تٌنفٌشِ مَسَرَدٍ؟</para>
  <para style="q" vid="JOB 23:13">عَ وَ مَ نَشَن شْن، عَ نَ نَن نَبَمَ.<verse eid="JOB 23:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 23:14"/>عَ نَشَن حَنِفٍشِ ﭑ مَ قٍ رَ،</para>
  <para style="q" vid="JOB 23:14">عَ قَمَ نَ نَن نَفِرِدٍ ﭑ مَ.</para>
  <para style="q" vid="JOB 23:14">عَ قَمَ قٍ فبّتّيٍ قَن سَدٍ نَ قَرِ.<verse eid="JOB 23:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 23:15"/>نَ نَن عَ تٌمَ ﭑ فَاشُمَ عَ يَ رَ.</para>
  <para style="q" vid="JOB 23:15">ﭑ نَ عَ شَ قٍ مَحْشُن، ﭑ مُ سُو سَمَ.<verse eid="JOB 23:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 23:16"/>عَلَ بَرَ لِمَنِيَ بَ ﭑ يِ،</para>
  <para style="q" vid="JOB 23:16">عَلَ سّنبّ كَنيِ بَرَ ﭑ مَفَاشُ،<verse eid="JOB 23:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 23:17"/>كْنْ ﭑ مُ دُندُ مَ نَ دِ مِ شَ قٍ رَ،</para>
  <para style="q" vid="JOB 23:17">نَ دِ مِ مُ نْمَ ﭑ نَ.»<verse eid="JOB 23:17"/></para>
  <chapter eid="JOB 23"/>
  <chapter number="24" style="c" sid="JOB 24"/>
  <para style="s1">عَيُبَ شَ مَسٍنيِ سٌلٌمَسَشَن ندٍ دّ عِدْشْي</para>
  <para style="s2">«عَلَ كِيتِ سَمَ تّمُي مُندُن؟»</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 24:1"/>«مُنقٍ رَ عَلَ سّنبّ كَنيِ مُ لْشْي رَفَتَشِ كِيتِ سَقٍ مَ؟</para>
  <para style="q" vid="JOB 24:1">مُنقٍ رَ عَ شَ مِشِيٍ مُ نَ لْشْي كٌلٌنشِ؟<verse eid="JOB 24:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 24:2"/>مِشِيٍ نَانِنيِيٍ تْنشُمَ مَسِفَمَ،</para>
  <para style="q" vid="JOB 24:2">عٍ شُرُ سٍيٍ مُحَمَ، عٍ عٍ رَفبّنفبّن يِرٍ فبّتّ.<verse eid="JOB 24:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 24:3"/>كِرِدِيٍ شَ سٌقَلٍ مُحَمَ عٍ مَ،</para>
  <para style="q" vid="JOB 24:3">كَاحّ فِنّ شَ نِنفٍ رَ سُشُمَ عَ يِ رَ سّيكّ رَ.<verse eid="JOB 24:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 24:4"/>عٍ سٍتَرٍيٍ شَ كِرَ بَلَنمَ عٍ يَ رَ،</para>
  <para style="q" vid="JOB 24:4">عٍ تْورْ مِشِيٍ كَرَشَنمَ عٍ شَ عٍ نْشُن.<verse eid="JOB 24:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 24:5"/>تْورْ مِشِيٍ مِنِمَ سُبَشّ مَ بَلٌي قٍندٍ عٍ شَ دِيٍ بّ،</para>
  <para style="q" vid="JOB 24:5">عٍ وَلِمَ عَلْ سٌقَلٍ فبٍنفبٍرٍنيِ مَ،</para>
  <para style="q" vid="JOB 24:5">عٍ مُ دٌنسٍ يٌ سْتْمَ.<verse eid="JOB 24:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 24:6"/>عٍ شّ شَبَمَ تِنشِنتَرٍيٍ بّ،</para>
  <para style="q" vid="JOB 24:6">عٍ عٍ شَ سَنسِ بٌفِيٍ بَمَ عٍ بّ.<verse eid="JOB 24:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 24:7"/>عٍ كْي رَدَنفِمَ شِنبٍلِ رَ،</para>
  <para style="q" vid="JOB 24:7">دُفِ يٌ مُ عٍ يِ رَ عٍ نَشَن قٍلٍنمَ عٍ مَ.<verse eid="JOB 24:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 24:8"/>تُنّ عٍ بُندَ مَ نَشَن كٍلِمَ فٍيَيٍ كْن نَ،</para>
  <para style="q" vid="JOB 24:8">بَفٍ تٌ مُ عٍ بّ، عٍ عٍ شِدٍ قٍنمَ فّمّيٍ لٌنفٌرِ رَ.<verse eid="JOB 24:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 24:9"/>كِرِدِ نفَ شِحّيٍ بَمَ عٍ دّ عِ،</para>
  <para style="q" vid="JOB 24:9">سّيكّ رَ سُشُمَ سٍتَرٍيٍ يِ رَ.<verse eid="JOB 24:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 24:10"/>نٍيٍ مَفٍلِ نَن سِفَمَ.</para>
  <para style="q" vid="JOB 24:10">عٍ كٌتٍ شَنِنمَ كَامّ رَ عٍ مَ.<verse eid="JOB 24:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 24:11"/>عٍ سَنسِ شْرِيٍ وُرُ مَ، عٍ تُرٍ بَ عَ عِ،</para>
  <para style="q" vid="JOB 24:11">عٍ وّنِ بٌفِ بٌرٌنمَ، عٍ وّنِ بَ عَ عِ.</para>
  <para style="q" vid="JOB 24:11">عٍ نَ بِرِن نَبَمَ يٍ شْلِ رَ عٍ مَ.<verse eid="JOB 24:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 24:12"/>مِشِيٍ عٍ مَوَ مَ تَا كُي.</para>
  <para style="q" vid="JOB 24:12">مِشِ مَشْنْشِيٍ شِلِ تِمَ،</para>
  <para style="q" vid="JOB 24:12">كْنْ عَلَ فبٍ قٍ يٌ مُ نَ نَ قٍيٍ.»<verse eid="JOB 24:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="JOB 24:13"/>«مِشِ حَاشِيٍ، نٍيٍ مُ نَءِيَلَنيِ كٌلٌن،</para>
  <para style="q" vid="JOB 24:13">عٍ مُ نَ كِرَيٍ كٌلٌن،</para>
  <para style="q" vid="JOB 24:13">عٍ مُ عٍ حّرّ مَ نٍيٍ شْن مَ.<verse eid="JOB 24:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 24:14"/>قَشّتِ كٍلِمَ سُبَشّ مَ،</para>
  <para style="q" vid="JOB 24:14">عَ تْورْ مِشِ نُن سٍتَرٍ قَشَ،</para>
  <para style="q" vid="JOB 24:14">عَ مُحّ تِ كْي رَ.<verse eid="JOB 24:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 24:15"/>كُيٍ نَ عِقْورْ، يّنّلَ عَ قَلَمَ،</para>
  <para style="q" vid="JOB 24:15">‹مِشِ يٌ مُ ﭑ تٌمَ،›</para>
  <para style="q" vid="JOB 24:15">عَ قَ مِنِ دُفِ دُ سُشِ عَ يَتَفِ شُن نَ.<verse eid="JOB 24:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 24:16"/>كْي رَ مُحّتِيٍ نَادّيٍ كَنَمَ،</para>
  <para style="q" vid="JOB 24:16">يَنيِ رَ عٍ عٍ يّتّ مَبَلَن بَنشِيٍ كُي.</para>
  <para style="q" vid="JOB 24:16">نَءِيَلَنيِ مُ رَقَن عٍ مَ هَلِ.<verse eid="JOB 24:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 24:17"/>عٍ تَن، كْي قِندِشِ عٍ بّ عٍ شَ يَنيِ نَن نَ،</para>
  <para style="q" vid="JOB 24:17">دِ مِ نَن عٍ مَلِمَ.»<verse eid="JOB 24:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="JOB 24:18"/>«بَنبَرَنيِ قَمَ تِنشِنتَرٍ شَنِندٍ،</para>
  <para style="q" vid="JOB 24:18">عَ دَنكَشِ نَن عَ رَ دُنِحَ مَ.</para>
  <para style="q" vid="JOB 24:18">عَ مُ وّنِ بِلِيٍ تٌمَ سْنْن.<verse eid="JOB 24:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 24:19"/>عَلِفِيَمَ يُنُبِتْي شَ قٍ دَنمَ نّ،</para>
  <para style="q" vid="JOB 24:19">عَلْ سٌفٍ لِنلِنيِ بَلَبَلَنيِ يٍ شْرِ مَ كِ نَشّ.<verse eid="JOB 24:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 24:20"/>فِنّ نَشَن شِحّ قِشِ يُنُبِتْي مَ،</para>
  <para style="q" vid="JOB 24:20">نَ نّيمُمَ نّ عَ مَ،</para>
  <para style="q" vid="JOB 24:20">كُلِيٍ تَن قَ عَ دٌن.</para>
  <para style="q" vid="JOB 24:20">مِشِ يٌ مُ رَتُمَ عَ مَ سْنْن.</para>
  <para style="q" vid="JOB 24:20">نَ كُي عَ شَ تِنشِنتَرٍيَ بَرَ تَلَ</para>
  <para style="q" vid="JOB 24:20">عَلْ سَنسِ تَلَمَ كِ نَشّ.<verse eid="JOB 24:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 24:21"/>عَ قٍ حَاشِ رَبَمَ فِنّ دِبَرِتَرٍ رَ،</para>
  <para style="q" vid="JOB 24:21">عَ مُ كِنِكِنِمَ كَاحّ فِنّ مَ.<verse eid="JOB 24:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 24:22"/>كْنْ عَلَ نَشَن قَتَ نَ تُورَيٍ سُشُدٍ سّنبّ رَ،</para>
  <para style="q" vid="JOB 24:22">عٍ نِي رَحَاشُ عٍ مَ،<verse eid="JOB 24:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 24:23"/>عَ نٍيٍ لُمَ عٍ شَ بْحّسَ كُي،</para>
  <para style="q" vid="JOB 24:23">عَ قَ بِرَ مِشِ فبّتّيٍ تَن مَ قٍ قْشْ رَ.<verse eid="JOB 24:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 24:24"/>مِشِ مِنِمَ وَشَتِ ندٍ نَن نَبَدٍ،</para>
  <para style="q" vid="JOB 24:24">كْنْ نَ وَشَتِ نَ كَمَلِ،</para>
  <para style="q" vid="JOB 24:24">عَ شَ قٍ شُبٍن عَ حْن.</para>
  <para style="q" vid="JOB 24:24">عَدَ مَدِ لُشِ نّ عَلْ مَالٍ نَ مْ شّ شُن مَ،</para>
  <para style="q" vid="JOB 24:24">مَالٍ شَبٍيٍ قَ عَ شَبَ.»<verse eid="JOB 24:24"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="25" style="v" sid="JOB 24:25"/>«ندٍ نْمَ ﭑ مَ مَسٍنيِ مَتَندِدٍ؟</para>
  <para style="q" vid="JOB 24:25">ندٍ نْمَ عَ قَلَدٍ نْندِ مُ عَ رَ؟»<verse eid="JOB 24:25"/></para>
  <chapter eid="JOB 24"/>
  <chapter number="25" style="c" sid="JOB 25"/>
  <para style="s1">بِلِدَدَ سُوشَكَ شَ مَسٍنيِ سَشَن ندٍ</para>
  <para style="s2">«مَنفّيَ نَ عَلَ نَن يِ»</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 25:1"/>بِلِدَدَ سُوشَكَ نَشَ عَ قَلَ،<verse eid="JOB 25:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 25:2"/>«مَنفّيَ نَ عَلَ نَن يِ،</para>
  <para style="q" vid="JOB 25:2">قٌ وٌن شَ فَاشُ عَ يَ رَ.</para>
  <para style="q" vid="JOB 25:2">عَ تَن نَن بْحّسَ رَفِرِ مَ كٌورٍ مَ.<verse eid="JOB 25:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 25:3"/>عَ شَ فَلِ كْنتِ نْمَ كٌلٌندٍ؟</para>
  <para style="q" vid="JOB 25:3">ندٍ نَ عَ شَ سٌفٍ يَنبّ مُ نَشَن لِمَ؟<verse eid="JOB 25:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 25:4"/>عَدَ مَ تِنشِنمَ دِ عَلَ يَ عِ؟</para>
  <para style="q" vid="JOB 25:4">فِنّ بَرِ دِ سّنِيّنمَ دِ؟<verse eid="JOB 25:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 25:5"/>شَ كِكٍ شَ يَنبّ يّتّ يَتِ مُ فبٌ عَلَ بّ،</para>
  <para style="q" vid="JOB 25:5">شَ تُنبُييٍ مُ سّنِيّن عَ يَ عِ،<verse eid="JOB 25:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 25:6"/>عَدَ مَدِ فٌ، نَشَن شُرُن عَلْ كُلِ،</para>
  <para style="q" vid="JOB 25:6">نَشَن قِندِشِ كُلِ يْرّ دِ فبَنسَن نَ؟»<verse eid="JOB 25:6"/></para>
  <chapter eid="JOB 25"/>
  <chapter number="26" style="c" sid="JOB 26"/>
  <para style="s1">عَيُبَ شَ مَسٍنيِ سٌلٌمَنَانِ ندٍ</para>
  <para style="s2">«ندٍ نْمَ عَلَ سّنبّ قَهَامُدٍ؟»</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 26:1"/>عَيُبَ نَشَ عَ يَابِ،<verse eid="JOB 26:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 26:2"/>«عِ قَتَ سّنبّتَرٍ مَلِدٍ.</para>
  <para style="q" vid="JOB 26:2">عِ قَتَ مِشِ رَلِمَنِيَدٍ.<verse eid="JOB 26:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 26:3"/>عِ قَتَ لْننِتَرٍ رَ سِدٍ.</para>
  <para style="q" vid="JOB 26:3">عِ شَشِلِ قَنيِ مَسٍنمَ،<verse eid="JOB 26:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 26:4"/>كْنْ عِ نَ مَسٍنمَ ندٍ بّ؟</para>
  <para style="q" vid="JOB 26:4">ندٍ نَ شَشِلِ قِشِ عِ مَ؟»<verse eid="JOB 26:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="JOB 26:5"/>«مِشِ قَشَشِيٍ سّرّنمَ بَا نُن بْشِ بُن مَ.<verse eid="JOB 26:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 26:6"/>عَلِفِيَمَ نَادّ رَبِشِ عَلَ يَ تٌدٍ رَ،</para>
  <para style="q" vid="JOB 26:6">عَ نَا عِفبّشِ.<verse eid="JOB 26:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 26:7"/>عَلَ نَن كٌورٍ دَاشِ، عَ عَ سِنفَن كُيٍ مَ،</para>
  <para style="q" vid="JOB 26:7">عَ بْشِ سِنفَن عَ يّتّ مَ.<verse eid="JOB 26:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 26:8"/>عَ تُنّ يٍ رَفَتَمَ نُشُييٍ كُي،</para>
  <para style="q" vid="JOB 26:8">يٍ شَ بِنيّ مَن مُ نْ عٍ بْودٍ.<verse eid="JOB 26:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 26:9"/>عَ عَ شَ كِبَنيِ يَ مَكٌتٌشِ نُشُييٍ نَن نَ.<verse eid="JOB 26:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 26:10"/>عَ نَانِنيِ سَشِ نَءِيَلَنيِ نُن دِ مِ تَفِ.<verse eid="JOB 26:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 26:11"/>كٌورٍ سّرّنمَ، عَ كَابَمَ عَلَ شَاحّ شُي مّقٍ رَ.<verse eid="JOB 26:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 26:12"/>عَ سّنبّ بَا عِمَشَمَ،</para>
  <para style="q" vid="JOB 26:12">عَ بَا يّشّيٍ مَفَاشُشِ عِبْو مَ عَ شَشِلِ قَنيِ رَ.<verse eid="JOB 26:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 26:13"/>عَ كّرّ قٌيٍ كٌورٍ رَ سّنِيّنمَ،</para>
  <para style="q" vid="JOB 26:13">عَ بّلّشّ بْشِمَسٍ فِشِ سْشْمَ.<verse eid="JOB 26:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 26:14"/>شَ يٍيٍ قِندِشِ عَ شَ وَلِ شُرِيٍ نَن نَ،</para>
  <para style="q" vid="JOB 26:14">وٌن مُ نْمَ نَشٍيٍ قَهَامُدٍ عَ قَنيِ رَ،</para>
  <para style="q" vid="JOB 26:14">ندٍ نْمَ عَ سّنبّ مَفَاشُشِ تَن قَهَامُدٍ؟»<verse eid="JOB 26:14"/></para>
  <chapter eid="JOB 26"/>
  <chapter number="27" style="c" sid="JOB 27"/>
  <para style="s1">عَيُبَ شَ مَسٍنيِ سٌلٌمَنَانِ ندٍ دّ عِدْشْي</para>
  <para style="s2">«قٌ ﭑ شَ نْندِ قَلَ»</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 27:1"/>عَيُبَ مَن نَشَ مَسٍنيِ تِ؛<verse eid="JOB 27:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 27:2"/>«ﭑ بَرَ ﭑ كَلِ عَلَ سّنبّ كَنيِ رَ،</para>
  <para style="q" vid="JOB 27:2">نَشَن مُ نْندِ قِمَ ﭑ مَ،</para>
  <para style="q" vid="JOB 27:2">نَشَن بَرَ ﭑ نَقٍ شْنّ رَ،<verse eid="JOB 27:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 27:3"/>دَنمِ ﭑ حّنفِمَ،</para>
  <para style="q" vid="JOB 27:3">دَنمِ ﭑ حّنفِ نَشَن قَتَنشِ عَلَ رَ نَ نَن ﭑ قَتٍ عِ،<verse eid="JOB 27:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 27:4"/>تِنشِنتَرٍيَ مُ مِنِمَ ﭑ دّ عِ،</para>
  <para style="q" vid="JOB 27:4">ﭑ مُ وُلٍ قَلَمَ.<verse eid="JOB 27:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 27:5"/>هَن ﭑ قَشَ، ﭑ مُ نْندِ قِمَ وٌ مَ،</para>
  <para style="q" vid="JOB 27:5">ﭑ مُ ﭑ يّتّ تْوحّفّمَ.<verse eid="JOB 27:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 27:6"/>ﭑ تَن عَ كٌلٌن ﭑ تِنشِن،</para>
  <para style="q" vid="JOB 27:6">سٍسٍ مَن مُ ﭑ بَمَ مّننِ.</para>
  <para style="q" vid="JOB 27:6">ﭑ مُ ﭑ مَ قٍ حَاشِ يٌ كٌلٌن.»<verse eid="JOB 27:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="JOB 27:7"/>«ﭑ يَشُي شَ سُشُ عَلْ مِشِ حَاشِ،</para>
  <para style="q" vid="JOB 27:7">ﭑ فٍرٍقَ شَ سُشُ عَلْ تِنشِنتَرٍ.<verse eid="JOB 27:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 27:8"/>عَلَ نَ نَتّ تٌنفٌ عَ شَ نَ مِشِ مْولِيٍ قَشَ،</para>
  <para style="q" vid="JOB 27:8">شَشِلِ تِدٍ يٌ مُ لُمَ عٍ بّ،<verse eid="JOB 27:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 27:9"/>عَلَ نٍيٍ مَشَندِ شُي تٌنفٌمَ عٍ تْورْ تّمُي؟<verse eid="JOB 27:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 27:10"/>عَلَ رَقَن نَ مِشِ مْولِ مَ؟</para>
  <para style="q" vid="JOB 27:10">عَ عَلَ مَشَندِ مَ تّمُي بِرِن؟»<verse eid="JOB 27:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="JOB 27:11"/>«ﭑ شَ عَلَ سّنبّ مَسٍن وٌ بّ،</para>
  <para style="q" vid="JOB 27:11">ﭑ مُ عَلَ سّنبّ كَنيِ وَشْنقٍ نْشُنمَ وٌ مَ.<verse eid="JOB 27:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 27:12"/>وٌ بِرِن بَرَ يِ تٌ عَ قَنيِ رَ،</para>
  <para style="q" vid="JOB 27:12">وٌ قَ وْيّنيِ قُقَقُ قَلَمَ مُنقٍ رَ؟»<verse eid="JOB 27:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="JOB 27:13"/>«عَلَ نَشَن نَفِرِ مَ مِشِ حَاشِ مَ،</para>
  <para style="q" vid="JOB 27:13">عَلَ سّنبّ كَنيِ نَشَن سٌمَ عَ يِ رَ كّ رَ،</para>
  <para style="q" vid="JOB 27:13">نَ نَن يِ كِ؛<verse eid="JOB 27:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 27:14"/>عَ شَ دِيٍ نَ وُيَ، عٍ قَشَمَ سَنتِدّفّمَ نَن نَ،</para>
  <para style="q" vid="JOB 27:14">عَ شَ مَمَدِيٍ قَشَ كَامّ رَ.<verse eid="JOB 27:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 27:15"/>عَ شَ مِشِ ندٍيٍ نَ لُ،</para>
  <para style="q" vid="JOB 27:15">نٍيٍ قَ قَشَ عَ شَنبِ،</para>
  <para style="q" vid="JOB 27:15">عٍ شَ كَاحّ فِنّيٍ مُ وَ مَ عٍ شَ قٍ رَ.<verse eid="JOB 27:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 27:16"/>عَ شَ نَاقُلِ نَ فبٌ يّ عَلْ مّيّنيِ،</para>
  <para style="q" vid="JOB 27:16">عَ شَ دُفِ نَ وُيَ عَلْ بّندّ فبٍفبٍ مَلَنشِ،<verse eid="JOB 27:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 27:17"/>عَ تَن نَن نَ مَلَنشِ،</para>
  <para style="q" vid="JOB 27:17">كْنْ تِنشِنتْي نَن نَ دُفِ رَفٌرٌ مَ عَ مَ،</para>
  <para style="q" vid="JOB 27:17">سّنِيّنتْي نَن نَ نَاقُلِ سْتْمَ.<verse eid="JOB 27:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 27:18"/>عَ شَ بَنشِ لُمَ عَلْ تُرُنتُرُنيِ،</para>
  <para style="q" vid="JOB 27:18">عَلْ شْنِ كٍرِ شَ بَفٍ دِ.<verse eid="JOB 27:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 27:19"/>عَ بَننَشِ نَن عَ سَمَ،</para>
  <para style="q" vid="JOB 27:19">كْنْ عَ رَفَتَمَ عَ تْورْشِ نَن نَ.</para>
  <para style="q" vid="JOB 27:19">عَ نَ عَ يَ رَبِ، سٍسٍ مُ نَ عَ يِ رَ سْنْن.<verse eid="JOB 27:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 27:20"/>فَاشُي عَ سُشُمَ تّرّننَ رَ،</para>
  <para style="q" vid="JOB 27:20">عَلْ بَنبَرَنيِ، عَلْ تُرُننَادّ كْي كُي.<verse eid="JOB 27:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 27:21"/>قٌيٍ شُنفبٍ عَ شَنِنمَ،</para>
  <para style="q" vid="JOB 27:21">عَ عَ تَلَ عَ سَبَتِدٍ.<verse eid="JOB 27:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 27:22"/>تَنبّيٍ وٌلِمَ عَ مَ، عَ مُ بَمَ عَ رَ،</para>
  <para style="q" vid="JOB 27:22">قٌ عَ شَ عَ فِ نّ.<verse eid="JOB 27:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 27:23"/>مِشِيٍ حّلّشِنمَ نّ عَ شَ شُننَكَنّ رَ،</para>
  <para style="q" vid="JOB 27:23">عٍ يٌ عَ مَ.»<verse eid="JOB 27:23"/></para>
  <chapter eid="JOB 27"/>
  <chapter number="28" style="c" sid="JOB 28"/>
  <para style="s1">عَيُبَ شَ مَسٍنيِ سٌلٌمَنَانِ ندٍ دّ عِدْشْي مَن</para>
  <para style="s2">«لْننِ نَ مِندٍن؟»</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 28:1"/>«يِرٍ نَ نَ فبٍتِ بَمَ بْشِ مَ دّننَشّ،</para>
  <para style="q" vid="JOB 28:1">شّيمَ رَشُنُدٍ قَن نَ نَ.<verse eid="JOB 28:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 28:2"/>يِرٍ نَ نَ وُرٍ بَمَ بْشِ مَ دّننَشّ،</para>
  <para style="q" vid="JOB 28:2">فّمّ رَشُنُشِ قَن وُرٍ فبٍيلِ رَ مِنِمَ.<verse eid="JOB 28:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 28:3"/>مِشِ يِلِ فٍمَ بْشِ بُن دِ مِ كُي نَ سٍيٍ قٍنقٍ رَ.<verse eid="JOB 28:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 28:4"/>عٍ يِلِ فٍمَ وُلَ عِ،</para>
  <para style="q" vid="JOB 28:4">دّننَشّ مَكُيَ مِشِ سَبَتِدٍ رَ.</para>
  <para style="q" vid="JOB 28:4">مّننِ مِشِ فٌرٌ مَ لُوتِ مَ بْشِ بُن مَ.<verse eid="JOB 28:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 28:5"/>بَلٌي مِنِمَ بْشِ قَرِ،</para>
  <para style="q" vid="JOB 28:5">كْنْ عَ بُنيِ تَن لُمَ عَلْ تّ نَن يِرِيِرِ مَ.<verse eid="JOB 28:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 28:6"/>مّننِ عٍ فّمّ تٌقَنيِيٍ تٌمَ،</para>
  <para style="q" vid="JOB 28:6">عٍ شّيمَ قُحِ رَ مِنِمَ.<verse eid="JOB 28:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 28:7"/>شْنِ شَاحّ مُ مّننِ كِرَ كٌلٌن،</para>
  <para style="q" vid="JOB 28:7">سّفّ مُ مّننِ تٌمَ.<verse eid="JOB 28:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 28:8"/>سُبٍ مَفَاشُشِ مُ عٍ حّرّ مَ مّننِ،</para>
  <para style="q" vid="JOB 28:8">يّتّ مُ دَنفِمَ نَا.<verse eid="JOB 28:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 28:9"/>كْنْ عَدَ مَ تَن فّمّ شْرْشْي فٍمَ،</para>
  <para style="q" vid="JOB 28:9">هَن عَ فٍيَ بُنيِ لِ.<verse eid="JOB 28:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 28:10"/>عَ يِلِ فٍمَ فّمّ كُي،</para>
  <para style="q" vid="JOB 28:10">عَلَكٌ عَ شَ نَاقُلِ تٌ.<verse eid="JOB 28:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 28:11"/>عَ يٍ كِرَ بَلَنمَ،</para>
  <para style="q" vid="JOB 28:11">عَ تّ شَنِنمَ نَا عَلَكٌ عَ شَ سٍ نْشُنشِ تٌ.»<verse eid="JOB 28:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="JOB 28:12"/>«كْنْ لْننِ تَن تٌمَ مِندٍن؟</para>
  <para style="q" vid="JOB 28:12">شَشِلِ قَنيِ لُدٍ نَ مِندٍن نَ؟<verse eid="JOB 28:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 28:13"/>عَدَ مَ مُ لْننِ تِدٍ كٌلٌن.</para>
  <para style="q" vid="JOB 28:13">لْننِ مُ تٌمَ دُنِحَ مِشِ بَلٌشِيٍ تَفِ.<verse eid="JOB 28:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 28:14"/>عَ مُ تٌمَ دَبٌنيِ شُنفبٍ كُي،</para>
  <para style="q" vid="JOB 28:14">عَ مُ تٌمَ بَا مَ.<verse eid="JOB 28:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 28:15"/>عَ مُ سَرَ مَ شّيمَ رَ،</para>
  <para style="q" vid="JOB 28:15">عَ مُ سْتْمَ فبٍتِ رَ.<verse eid="JOB 28:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 28:16"/>عَ مُ سَمَ سِكٍيلِ مَ شّيمَ سّيتِ مَ،</para>
  <para style="q" vid="JOB 28:16">شَ نَ مُ عَ رَ فّمّ تٌقَنيِيٍ سّيتِ مَ.<verse eid="JOB 28:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 28:17"/>عَ مَنِيّ مُ نَ.</para>
  <para style="q" vid="JOB 28:17">عَ مَنِيّ مُ قِندِ شّيمَ رَ،</para>
  <para style="q" vid="JOB 28:17">عَ مُ قِندِ فّمّ تِنسٍشِ رَ،</para>
  <para style="q" vid="JOB 28:17">عَ مُ قِندِ شّيمَ ثْوتِ تٌقَنيِ رَ.<verse eid="JOB 28:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 28:18"/>لْننِ تِدٍ فبٌ دِيَمَن بّ،</para>
  <para style="q" vid="JOB 28:18">عَ سْتْقٍ تِدٍ فبٌ فّمّ تٌقَنيِ بّ نَشَن تٌمَ بَا مَ.<verse eid="JOB 28:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 28:19"/>لْننِ مَنِيّ مُ قِندِ فّمّ تٌقَنيِ رَ،</para>
  <para style="q" vid="JOB 28:19">نَشَن كٍلِشِ يِرٍ مَكُيٍ.</para>
  <para style="q" vid="JOB 28:19">عَ مُ مَنِيَمَ سِكٍيلِ رَ عَلْ شّيمَ.»<verse eid="JOB 28:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="JOB 28:20"/>«نَ كُي، لْننِ كٍلِشِ مِندٍن؟</para>
  <para style="q" vid="JOB 28:20">شَشِلِ قَنيِ لُدٍ نَ مِندٍن نَ؟<verse eid="JOB 28:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 28:21"/>عَ نْشُنشِ نِمَسٍيٍ مَ نَشٍيٍ نَ بْشِ مَ،</para>
  <para style="q" vid="JOB 28:21">عَ نْشُنشِ شْنِيٍ مَ نَشٍيٍ نَ كٌورٍ مَ.<verse eid="JOB 28:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 28:22"/>عَلِفِيَمَ بَرَ عَ شَ قٍ ندٍ مّ،</para>
  <para style="q" vid="JOB 28:22">كْنْ عَ مُ عَ كٌلٌن.<verse eid="JOB 28:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 28:23"/>عَلَ نَن لْننِ كِرَ كٌلٌن،</para>
  <para style="q" vid="JOB 28:23">عَ تَن نَن عَ لِنفِرَ تٌمَ،<verse eid="JOB 28:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 28:24"/>بَرِ مَ عَ تَن نَن دُنِحَ نُن كٌورٍ عِفبّمَ هَن عٍ دَندٍ.<verse eid="JOB 28:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 28:25"/>عَ تٌ فّ قٌيٍ نُن يٍ عِتَشُندٍ،<verse eid="JOB 28:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 28:26"/>عَ تٌ فّ تُنّ، سٍيَمَكْنيِ، نُن فَلَنيِ يَمَرِدٍ،<verse eid="JOB 28:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 28:27"/>عَوَ، عَ نَشَ لْننِ رَ مِنِ، عَ عَ مَتٌ عَ قَنيِ رَ.<verse eid="JOB 28:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 28:28"/>نَ كُي عَ نَشَ عَ قَلَ عَدَ مَدِيٍ بّ،</para>
  <para style="q" vid="JOB 28:28">عَلَ شَ يَرَفَاشُي قِندِشِ لْننِ نَن نَ،</para>
  <para style="q" vid="JOB 28:28">قٍ حَاشِ بّحِنقٍ قِندِشِ شَشِلِ قَنيِ نَن نَ.»<verse eid="JOB 28:28"/></para>
  <chapter eid="JOB 28"/>
  <chapter number="29" style="c" sid="JOB 29"/>
  <para style="s1">عَيُبَ شَ مَسٍنيِ دْنشْي</para>
  <para style="s2">«ﭑ مَ تّمُي قَنيِ دَنفِشِ»</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 29:1"/>عَيُبَ نَشَ يِ مَسٍنيِ تِ؛<verse eid="JOB 29:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 29:2"/>«شَ ﭑ مَ تّمُي دَنفِشِيٍ نَن عَ رَ يِ كِ نُ،</para>
  <para style="q" vid="JOB 29:2">عَلَ نُ مّينِمَ ﭑ مَ تّمُي نَشّ.<verse eid="JOB 29:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 29:3"/>عَ شَ نَءِيَلَنيِ تٌ نُ نَ ﭑ شُن مَ،</para>
  <para style="q" vid="JOB 29:3">عَ تٌ نُ تّ تِمَ ﭑ بّ كِرَ شْن مَ دِ مِ كُي.<verse eid="JOB 29:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 29:4"/>ﭑ سّنبّ نُ فبٌ نَ تّمُي،</para>
  <para style="q" vid="JOB 29:4">ﭑ نُن عَلَ دّ نُ قَن.<verse eid="JOB 29:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 29:5"/>نَ تّمُي عَلَ سّنبّ كَنيِ نُ نَ ﭑ سّيتِ مَ،</para>
  <para style="q" vid="JOB 29:5">ﭑ مَ دِيٍ قَن نُ نَ ﭑ نَبِلِنيِ.<verse eid="JOB 29:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 29:6"/>ﭑ مَ قٍ بِرِن نُ سْونّيَشِ،</para>
  <para style="q" vid="JOB 29:6">شِحّ نُن تُرٍ نُ فبٌ ﭑ يِ رَ.»<verse eid="JOB 29:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="JOB 29:7"/>«ﭑ تٌ نُ سِفَمَ تَا سٌدٍ دّ رَ،</para>
  <para style="q" vid="JOB 29:7">حَمَ نُ نَ دّننَشّ،<verse eid="JOB 29:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 29:8"/>قٌنِكٍيٍ نُ كِرَ عِبَمَ نّ ﭑ بّ،</para>
  <para style="q" vid="JOB 29:8">قٌرِيٍ نُ كٍلِ عٍ تِ ﭑ بِنيَقٍ مَ.<verse eid="JOB 29:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 29:9"/>كُنتِفِيٍ نُ عٍ سَبَرِ مَ نّ ﭑ يَ رَ،<verse eid="JOB 29:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 29:10"/>مَنفّيٍ نُ وْيّنيِ سٌ ﭑ يِ، عٍ تَن دُندُ،<verse eid="JOB 29:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 29:11"/>بَرِ مَ نَشَن نَ ﭑ شُي مّ، عَ قٍ قَنيِ قَلَ ﭑ مَ قٍ رَ.</para>
  <para style="q" vid="JOB 29:11">نَشٍيٍ نُ ﭑ تٌمَ، ﭑ نُ رَقَنمَ عٍ مَ.<verse eid="JOB 29:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 29:12"/>ﭑ نُ تْورْ مِشِيٍ مَلِمَ،</para>
  <para style="q" vid="JOB 29:12">ﭑ نُ كِرِدِيٍ كِمَ، بٌورٍيٍ نُ نّيمُمَ نَشٍيٍ مَ.<verse eid="JOB 29:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 29:13"/>مِشِ نَشَن نُ نَ سَيَ كِرَ شْن مَ،</para>
  <para style="q" vid="JOB 29:13">نَ نُ دُبَمَ نّ ﭑ بّ.</para>
  <para style="q" vid="JOB 29:13">ﭑ نُ كَاحّ فِنّ بْحّ رَ سّيوَ مَ.<verse eid="JOB 29:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 29:14"/>ﭑ نُ ﭑ حّرّ مَ تِنشِنيِ كُي،</para>
  <para style="q" vid="JOB 29:14">نْندِ نُ قِندِشِ ﭑ يُفٍ نَن نَ.<verse eid="JOB 29:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 29:15"/>ﭑ نُ قِندِشِ سَابُي قَنيِ نَن نَ دْنشُي نُن مَبّنيِ بّ.<verse eid="JOB 29:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 29:16"/>ﭑ نُ قِندِشِ بَبّ نَن نَ سٍتَرٍيٍ بّ،</para>
  <para style="q" vid="JOB 29:16">ﭑ شْحّيٍ مَلِ عٍ شَ تْورّ كُي.<verse eid="JOB 29:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 29:17"/>ﭑ نُ تِنشِنتَرٍيٍ شَ قٍ شُن نَكَنَمَ،</para>
  <para style="q" vid="JOB 29:17">ﭑ مِسِكِينّ رَتَنفَ عٍ شَ قٍ كٌبِيٍ مَ.<verse eid="JOB 29:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 29:18"/>ﭑ نُ عَ مَحْشُنمَ سَيَ ﭑ لِمَ هّيرِ نَن كُي،</para>
  <para style="q" vid="JOB 29:18">ﭑ مَ سِمَيَ قَ كَمَلِ عَلْ بَا دّ رَ مّيّنيِ.<verse eid="JOB 29:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 29:19"/>ﭑ نُ عَ مَحْشُنمَ ﭑ مَ دُنِحّءِفِرِ سْونّيَمَ نّ،</para>
  <para style="q" vid="JOB 29:19">عَلْ سَنسِ نَشَن سَنكٍ بَرَ يٍ لِ، عَ سَلٌنيِ شِنِ سْتْ.<verse eid="JOB 29:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 29:20"/>ﭑ نُ عَ مَحْشُنمَ ﭑ شُن نَكٍلِمَ نّ تّمُي بِرِن،</para>
  <para style="q" vid="JOB 29:20">ﭑ تَنبّ وٌلِ سّنبّ رَ.»<verse eid="JOB 29:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="JOB 29:21"/>«مِشِيٍ نُ عٍ تُلِ مَتِمَ نّ ﭑ نَ،</para>
  <para style="q" vid="JOB 29:21">عٍ عٍ سَبَرِ ﭑ مَ مَرَ سِ رَ مّقٍ رَ.<verse eid="JOB 29:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 29:22"/>ﭑ مَ مَسٍنيِيٍ نُ رَقَنمَ عٍ مَ،</para>
  <para style="q" vid="JOB 29:22">عٍ مُ نُ عٍ مَتَندِ مَ.<verse eid="JOB 29:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 29:23"/>عٍ نُ ﭑ مَمّمَ عَلْ مِشِ تُنّ مَمّمَ كِ نَشّ،</para>
  <para style="q" vid="JOB 29:23">عٍ ﭑ مَ وْيّنيِ بِرِن سُشُ سّيوّ كُي.<verse eid="JOB 29:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 29:24"/>عٍ نَ ﭑ يَتَفِ تٌ،</para>
  <para style="q" vid="JOB 29:24">عٍ بِرِن نُ عٍ شَشِلِ تِمَ ﭑ نَ.<verse eid="JOB 29:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 29:25"/>ﭑ نُ عٍ رَحّرّ مَ،</para>
  <para style="q" vid="JOB 29:25">ﭑ نُ لُشِ نّ عٍ بّ عَلْ عٍ شَ مَنفّ،</para>
  <para style="q" vid="JOB 29:25">نَشَن دْشْشِ كِبَنيِ كُي عٍ تَفِ،</para>
  <para style="q" vid="JOB 29:25">عَ نُ تْورْ مِشِيٍ مَدُندُ.»<verse eid="JOB 29:25"/></para>
  <chapter eid="JOB 29"/>
  <chapter number="30" style="c" sid="JOB 30"/>
  <para style="s1">عَيُبَ شَ مَسٍنيِ دْنشْي دّ عِدْشْي</para>
  <para style="s2">«عَيُبَ شَ سّيوّ بَرَ قِندِ سُننُنيِ رَ»</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 30:1"/>«كْنْ يَكْسِ تَن، قٌنِكٍيٍ ﭑ مَيٍلٍمَ،</para>
  <para style="q" vid="JOB 30:1">نَشٍيٍ بَبَيٍ نُ قِندِشِ ﭑ بّ قُيَنتٍيٍ رَ،</para>
  <para style="q" vid="JOB 30:1">ﭑ نُ يٌمَ نَشٍيٍ مَ.<verse eid="JOB 30:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 30:2"/>عٍ يُسِ مُ نُ نَ ﭑ بّ،</para>
  <para style="q" vid="JOB 30:2">بَرِ مَ سّنبّ يٌ مُ نُ عٍ بّ.<verse eid="JOB 30:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 30:3"/>كَامّتْي نَن نُ عٍ رَ،</para>
  <para style="q" vid="JOB 30:3">نَشٍيٍ نُ سِفَمَ فبٍنفبٍرٍن يِرٍ بَلٌي قٍندٍ.<verse eid="JOB 30:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 30:4"/>عٍ نُ حٌوفٍيٍ مَتَلَمَ قْتْنيِيٍ كُي،</para>
  <para style="q" vid="JOB 30:4">وُرِ سَنكٍيٍ فبَنسَن نَن نُ قِندِ مَ عٍ شَ دٌنيِ رَ.<verse eid="JOB 30:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 30:5"/>مِشِيٍ نُ عٍ كٍرِ مَ حَمَ يَ مَ،</para>
  <para style="q" vid="JOB 30:5">عَلْ مُحّتِ كٍرِ مَ كِ نَشّ.<verse eid="JOB 30:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 30:6"/>عٍ نُ يِفِيَمَ فّمّ لٌنفٌرِيٍ نَن نَ فٍيَيٍ كْن نَ،<verse eid="JOB 30:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 30:7"/>شَ نَ مُ عَ رَ كُنسِيٍ بُن مَ.<verse eid="JOB 30:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 30:8"/>قُيَنتٍيٍ نَن نُ عٍ رَ،</para>
  <para style="q" vid="JOB 30:8">نَشٍيٍ نُ بَرَ كٍرِ بْشِ كُي.»<verse eid="JOB 30:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="JOB 30:9"/>«كْنْ يَكْسِ قَ، نٍيٍ نَن ﭑ مَيٍلٍمَ</para>
  <para style="q" vid="JOB 30:9">عٍ شَ سِفِيٍ نُن عٍ شَ مَسٍنيِيٍ رَ يِ كِ.<verse eid="JOB 30:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 30:10"/>ﭑ مَ قٍ مُ رَقَن عٍ مَ.</para>
  <para style="q" vid="JOB 30:10">عٍ دّ يٍ بْشُنمَ ﭑ يَتَفِ مَ،</para>
  <para style="q" vid="JOB 30:10">عٍ نُ قَ عٍ مَكُيَ ﭑ نَ.<verse eid="JOB 30:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 30:11"/>كَبِ عَلَ ﭑ نَبٌلٌ ﭑ مَ تْورّ كُي،</para>
  <para style="q" vid="JOB 30:11">عٍ شَ مَيٍلٍ مُ حْنمَ.<verse eid="JOB 30:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 30:12"/>يِ مِشِ يَ مَحْشُنشِيٍ كٍلِمَ ﭑ شِلِ مَ،</para>
  <para style="q" vid="JOB 30:12">عٍ نُ فَنتَنيِ حَاشِيٍ تٍ ﭑ بّ.<verse eid="JOB 30:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 30:13"/>عٍ ﭑ مَ كِرَ عِبٌلٌنمَ ﭑ يَ رَ.<verse eid="JOB 30:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 30:14"/>عٍ لُمَ عَلْ سْورِ حَاشِيٍ،</para>
  <para style="q" vid="JOB 30:14">نَشٍيٍ سٌمَ تَا كُي تّتّ يَلٍ رَ.<verse eid="JOB 30:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 30:15"/>فَاشُي بَرَ ﭑ سُشُ،</para>
  <para style="q" vid="JOB 30:15">ﭑ مَ قٍ شُن بَرَ رَكَنَ،</para>
  <para style="q" vid="JOB 30:15">ﭑ مَ كِسِ بَرَ دَنفِ ﭑ نَ عَلْ نُشُي دَنفِمَ كِ نَشّ.»<verse eid="JOB 30:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="JOB 30:16"/>«يَكْسِ، عَ فبٍ مُ لُشِ ﭑ مَ سِمَيَ شَ حْن،</para>
  <para style="q" vid="JOB 30:16">ﭑ مَ تْورّ بَرَ كَمَلِ.<verse eid="JOB 30:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 30:17"/>ﭑ مَ تْورّ بَرَ فبٌ يّ،</para>
  <para style="q" vid="JOB 30:17">ﭑ مُ شِمَ كْي رَ سْنْن.<verse eid="JOB 30:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 30:18"/>عَ لُمَ عَلْ دُفِ ندٍ نَن شِرِشِ ﭑ كْنيِ مَ،</para>
  <para style="q" vid="JOB 30:18">عَ شَ ﭑ قَشَ.<verse eid="JOB 30:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 30:19"/>عَلَ بَرَ ﭑ نَفٌرٌ هَن</para>
  <para style="q" vid="JOB 30:19">ﭑ بَرَ لُ عَلْ بٌورَ، شَ نَ مُ عَ رَ تّ شُبٍ.»<verse eid="JOB 30:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="JOB 30:20"/>«عَلَ، ﭑ بَرَ عِ شِلِ، كْنْ عِ مُ عَ رَتِنشِ.</para>
  <para style="q" vid="JOB 30:20">ﭑ بَرَ تِ عِ يَ عِ، عَلَكٌ عِ شَ ﭑ تٌ.<verse eid="JOB 30:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 30:21"/>عِ بَرَ تْورّ حَاشِ دْشْ ﭑ مَ،</para>
  <para style="q" vid="JOB 30:21">عِ سّنبّ بَرَ نْ ﭑ نَ.<verse eid="JOB 30:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 30:22"/>عَ لُشِ عَلْ تُرُننَادّ بَرَ ﭑ نَتٍ كٌورٍ مَ.<verse eid="JOB 30:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 30:23"/>ﭑ عَ كٌلٌن عِ نَ ﭑ شَنِنقٍ عَلِفِيَمَ نّ،</para>
  <para style="q" vid="JOB 30:23">دُنِحَ مِشِ بِرِن سِفَمَ دّننَشّ.»<verse eid="JOB 30:23"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="24" style="v" sid="JOB 30:24"/>«كْنْ مِشِ نَشَن نَ سَيَ كِرَ شْن مَ،</para>
  <para style="q" vid="JOB 30:24">نَ مُ عَلَ مَشَندِ مَ شّ؟</para>
  <para style="q" vid="JOB 30:24">مِشِ نَشَن نَ تْورّ كُي،</para>
  <para style="q" vid="JOB 30:24">نَ مُ عَلَ مَكُلَمَ شّ؟<verse eid="JOB 30:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 30:25"/>ﭑ مُ ﭑ يَ يٍ رَ مِنِ تْورْ مِشِ بّ نُ؟</para>
  <para style="q" vid="JOB 30:25">ﭑ مُ كِنِكِنِ سٍتَرٍ مَ نُ؟<verse eid="JOB 30:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 30:26"/>ﭑ وَ هّيرِ نَن شْن مَ،</para>
  <para style="q" vid="JOB 30:26">كْنْ حَشَنكَتّ نَن ﭑ لِشِ.</para>
  <para style="q" vid="JOB 30:26">ﭑ وَ لُقٍ نَءِيَلَنيِ نَن كُي،</para>
  <para style="q" vid="JOB 30:26">كْنْ دِ مِ نَن دُ سُشِ ﭑ شُن نَ.<verse eid="JOB 30:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 30:27"/>ﭑ بْحّ نَ تْورْقٍ لْشْي بِرِن.<verse eid="JOB 30:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 30:28"/>ﭑ نَ دِ مِ كُي،</para>
  <para style="q" vid="JOB 30:28">نَءِيَلَنيِ يٌ مُ نَ.</para>
  <para style="q" vid="JOB 30:28">ﭑ تِشِ حَمَ تَفِ، ﭑ نُ قَ وَ ﭑ شُي عِتٍشِ رَ.<verse eid="JOB 30:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 30:29"/>ﭑ بَرَ لُ عَلْ وُلَ عِ بَرٍيٍ نُن بُرُنيِ شْنِ حَاشِيٍ.<verse eid="JOB 30:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="JOB 30:30"/>ﭑ كِرِ بَرَ قْورْ ﭑ مَ،</para>
  <para style="q" vid="JOB 30:30">ﭑ قَتٍ بِرِن كُي نَ عِفَنقٍ.<verse eid="JOB 30:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="JOB 30:31"/>ﭑ مَ كْرَ سُننُنيِ شُي تِمَ،</para>
  <para style="q" vid="JOB 30:31">ﭑ مَ شُلٍ حْن قٍ وَ شُي رَ مِنِمَ.»<verse eid="JOB 30:31"/></para>
  <chapter eid="JOB 30"/>
  <chapter number="31" style="c" sid="JOB 31"/>
  <para style="s1">عَيُبَ شَ مَسٍنيِ دْنشْي رَحْنيِ</para>
  <para style="s2">«يُنُبِ سَرٍ نَن يَ»</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 31:1"/>«ﭑ نَتّ تٌنفٌ نّ،</para>
  <para style="q" vid="JOB 31:1">ﭑ نَشَ يَبُ فِنّدِ مّدِ رَ.<verse eid="JOB 31:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 31:2"/>عَلَ مُنسٍ حَنِفٍمَ ﭑ بّ كٌورٍ مَ؟</para>
  <para style="q" vid="JOB 31:2">عَلَ سّنبّ كَنيِ كّ مُندُن قِمَ ﭑ مَ كٍلِقٍ رَ عَ مَ؟<verse eid="JOB 31:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 31:3"/>سٍتَرٍحَ مُ رَفَتَشِ مِشِ حَاشِ شَ بّ؟</para>
  <para style="q" vid="JOB 31:3">حَشَنكَتّ مُ تِنشِنتَرٍ شَ لِمَ؟<verse eid="JOB 31:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 31:4"/>عَلَ مُ نُ ﭑ قْشِ بِرِن مَتٌمَ شّ؟</para>
  <para style="q" vid="JOB 31:4">عَ مُ نُ ﭑ مَ سَنتٌنفٌي بِرِن كْنتِمَ شّ؟»<verse eid="JOB 31:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="JOB 31:5"/>«شَ ﭑ بَرَ ﭑ حّرّ وُلٍ كُي،</para>
  <para style="q" vid="JOB 31:5">شَ ﭑ بَرَ مِشِ مَدَشُ،<verse eid="JOB 31:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 31:6"/>عَلَ شَ ﭑ مَنِيَ سِكٍيلِ تِنشِنشِ رَ.</para>
  <para style="q" vid="JOB 31:6">عَ ﭑ مَ تِنشِنيِ تٌمَ نّ.<verse eid="JOB 31:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 31:7"/>شَ ﭑ بَرَ كِرَ تِنشِنشِ بّحِن،</para>
  <para style="q" vid="JOB 31:7">شَ ﭑ بْحّ بَرَ بِرَ ﭑ يَ وَشْنقٍ قْشْ رَ،</para>
  <para style="q" vid="JOB 31:7">شَ ﭑ بَرَ ﭑ مَنْشْ قٍ حَاشِ رَ،<verse eid="JOB 31:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 31:8"/>مِشِ فبّتّيٍ شَ ﭑ مَ سَنسِ سِشِيٍ بٌفِ دٌن،</para>
  <para style="q" vid="JOB 31:8">ﭑ مَ سَنسِ سِشِيٍ بِرِن شَ مَتَلَ بْشِ مَ.<verse eid="JOB 31:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 31:9"/>شَ فِنّ شْلِ بَرَ ﭑ سُشُ،</para>
  <para style="q" vid="JOB 31:9">شَ ﭑ بَرَ بِرَ ﭑ دْشْبٌورٍ شَ فِنّ قْشْ رَ،<verse eid="JOB 31:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 31:10"/>ﭑ مَ فِنّ شَ بَندٍ حِن شّمّ فبّتّ بّ،</para>
  <para style="q" vid="JOB 31:10">عَ تَن نُن نَ شَ كَقُ،<verse eid="JOB 31:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 31:11"/>بَرِ مَ يّنّ قِندِشِ قٍ حَاشِ نَن نَ،</para>
  <para style="q" vid="JOB 31:11">كِيتِسَيٍ نَشَن مَكِيتِمَ عَ شْرْشْي رَ.<verse eid="JOB 31:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 31:12"/>يّنّ، تّ نَن عَ رَ نَشَن سِفَمَ فَنيِ تِ رَ هَن يَهَننَمَ،</para>
  <para style="q" vid="JOB 31:12">عَ مِشِ هَرِفٍ بِرِن شُن نَكَنَ.»<verse eid="JOB 31:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="JOB 31:13"/>«شَ ﭑ مُ قِندِ مِشِ تِنشِنشِ رَ نُ ﭑ مَ كٌنيِيٍ مَبِرِ،</para>
  <para style="q" vid="JOB 31:13">مُشُ تٌ نُ فَلَنبُمَ،<verse eid="JOB 31:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 31:14"/>ﭑ عَلَ يَابِمَ دِ نُ؟</para>
  <para style="q" vid="JOB 31:14">ﭑ نَن ﭑ يّتّ شُن مَقَلَمَ دِ نُ؟<verse eid="JOB 31:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 31:15"/>عَلَ كٍرٍن شَ مُ مُشُ بِرِن دَاشِ مُشُ نفَ تّيفّ عِ؟</para>
  <para style="q" vid="JOB 31:15">عَلَ كٍرٍن شَ مُ مُشُ بِرِن نَبَلٌشِ مُشُ نفَ شِحّ رَ؟»<verse eid="JOB 31:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="JOB 31:16"/>«شَ ﭑ مُ سٍتَرٍيٍ كِ نُ،</para>
  <para style="q" vid="JOB 31:16">شَ ﭑ مُ كَاحّ فِنّ مَلِ نُ،<verse eid="JOB 31:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 31:17"/>شَ ﭑ كٍرٍن بَرَ ﭑ مَ دٌنسٍ دٌن،</para>
  <para style="q" vid="JOB 31:17">ﭑ مُ كِرِدِ كِ،<verse eid="JOB 31:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 31:18"/>ﭑ نَشَن شُرُ، ﭑ قِندِ عَ بّ بَبّ رَ كَبِ عَ يْرّ رَ،</para>
  <para style="q" vid="JOB 31:18">نَشَن نفَ كَاحّ فِنّ بَرَ لُ ﭑ شْنيِ كَبِ عَ تّيفّشِ عَ مَ،<verse eid="JOB 31:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 31:19"/>شَ ﭑ مُ تْورْ مِشِ كِ دُفِ رَ نُ،<verse eid="JOB 31:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 31:20"/>نَ كَنيِ لُ عَ مُ دُبَ ﭑ بّ</para>
  <para style="q" vid="JOB 31:20">نَ دُفِ شَ قٍ رَ نَشَن كٍلِشِ ﭑ مَ يّشّييٍ شَبٍ مَ،<verse eid="JOB 31:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 31:21"/>شَ ﭑ بَرَ كِرِدِ ندٍ تْورْ،</para>
  <para style="q" vid="JOB 31:21">ﭑ تٌ عَ كٌلٌنشِ كِيتِسَيٍ نْندِ قِمَ ﭑ مَ،<verse eid="JOB 31:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 31:22"/>ﭑ بّلّشّ شَ بٌلٌن ﭑ تُنكِ مَ،</para>
  <para style="q" vid="JOB 31:22">ﭑ شْرِيٍ شَ مَفِرَ،<verse eid="JOB 31:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 31:23"/>بَرِ مَ ﭑ فَاشُ عَلَ شَ حَشَنكَتّ يَ رَ عَ فبٍ رَ،</para>
  <para style="q" vid="JOB 31:23">ﭑ مُ نْمَ سٍسٍ رَ عَ سّنبّ يَ عِ.»<verse eid="JOB 31:23"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="24" style="v" sid="JOB 31:24"/>«شَ ﭑ بَرَ ﭑ شَشِلِ تِ ﭑ مَ شّيمَ رَ،</para>
  <para style="q" vid="JOB 31:24">شَ ﭑ بَرَ لَ ﭑ مَ نَاقُلِ رَ،<verse eid="JOB 31:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 31:25"/>شَ ﭑ بَرَ حّلّشِن ﭑ هَرِفٍ شَ فبٌي رَ،</para>
  <para style="q" vid="JOB 31:25">ﭑ نَشَن سْتْ ﭑ مَ دُنِحّءِفِرِ كُي،<verse eid="JOB 31:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 31:26"/>شَ ﭑ بَرَ ﭑ يَ تِ سٌفٍ نُن كِكٍ شَ يَنبّ رَ،<verse eid="JOB 31:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 31:27"/>ﭑ قَ نٍيٍ بَتُ ﭑ بْحّ كُي فُندٌ رَ،</para>
  <para style="q" vid="JOB 31:27">ﭑ نَن ﭑ بّلّشّ سُنبُ عٍ شَ بِنيّ بُن مَ،<verse eid="JOB 31:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 31:28"/>عَلَ شَ ﭑ حَشَنكَتَ،</para>
  <para style="q" vid="JOB 31:28">بَرِ مَ نَ قٍ مْولِ مُ قَن،</para>
  <para style="q" vid="JOB 31:28">ﭑ بَرَ قِندِ يَنقَنتٍ رَ عَلَ مَبِرِ.»<verse eid="JOB 31:28"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="29" style="v" sid="JOB 31:29"/>«ﭑ بَرَ حّلّشِن ﭑ شْنمَ شَ تْورّ رَ،</para>
  <para style="q" vid="JOB 31:29">ﭑ سّيوَ عَ شَ حَشَنكَتّ رَ،<verse eid="JOB 31:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="JOB 31:30"/>ﭑ تَن نَشَن مُ نُ تِنمَ عَ دَنكَدٍ ﭑ دّ رَ،</para>
  <para style="q" vid="JOB 31:30">ﭑ شَ نَ يُنُبِ مْولِ رَبَ؟<verse eid="JOB 31:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="JOB 31:31"/>ﭑ مَ شْحّيٍ بِرِن مُ نُ عَ قَلَمَ شّ؛</para>
  <para style="q" vid="JOB 31:31">‹عَ ﭑ دّ وَ سَشِ سُبٍ رَ›؟<verse eid="JOB 31:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="JOB 31:32"/>ﭑ نُ بِيَاسِلَيٍ يِفِيَمَ نّ عَلَكٌ عٍ نَشَ شِ تَندٍ.<verse eid="JOB 31:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="JOB 31:33"/>ﭑ بَرَ ﭑ مَ قٍ حَاشِيٍ نْشُن ﭑ بْحّ كُي عَلْ</para>
  <para style="q" vid="JOB 31:33">عَدَ مَدِيٍ دَرِشِ عَ رَ كِ نَشّ؟ عَدٍ.<verse eid="JOB 31:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="JOB 31:34"/>ﭑ بَرَ فَاشُ حَمَ شَ وْيّنيِ رَ،</para>
  <para style="q" vid="JOB 31:34">شَ نَ مُ عَ رَ ﭑ شَبِلّ شَ وْيّنيِ رَ،</para>
  <para style="q" vid="JOB 31:34">ﭑ قَ لُ ﭑ شْنيِ نْشُنيِ كُي ﭑ مُ نْندِ قَلَ؟ عَدٍ.»<verse eid="JOB 31:34"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="35" style="v" sid="JOB 31:35"/>«شَ مِشِ نَ نَشَن تِنمَ عَ تُلِ مَتِدٍ ﭑ نَ،</para>
  <para style="q" vid="JOB 31:35">ﭑ مَ مَسٍنيِ دْنشْي نَن نَ كِ.</para>
  <para style="q" vid="JOB 31:35">عَلَ شَ ﭑ يَابِ.</para>
  <para style="q" vid="JOB 31:35">عَ نَشَن تٌمَ ﭑ مَ، عَ شَ نَ سّبّ،<verse eid="JOB 31:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="JOB 31:36"/>ﭑ شَ نَ دْشْ ﭑ شُن مَ،</para>
  <para style="q" vid="JOB 31:36">ﭑ شَ عَ فبَكُ ﭑ كْن مَ.<verse eid="JOB 31:36"/></para>
  <para style="q">
    <verse number="37" style="v" sid="JOB 31:37"/>ﭑ دّنتّفّ سَمَ نّ عَ بّ،</para>
  <para style="q" vid="JOB 31:37">عَلْ مِشِ دّنتّفّ سَمَ مَنفّ بّ كِ نَشّ.<verse eid="JOB 31:37"/></para>
  <para style="q">
    <verse number="38" style="v" sid="JOB 31:38"/>شَ ﭑ مَ بْشِ ندٍ بَرَ شْنْ ﭑ شِلِ مَ،</para>
  <para style="q" vid="JOB 31:38">شَ مِشِ ندٍ يَ يٍ بَرَ سِلْن نَ،<verse eid="JOB 31:38"/></para>
  <para style="q">
    <verse number="39" style="v" sid="JOB 31:39"/>شَ ﭑ بَرَ دٌنسٍ ندٍ دٌن ﭑ مُ عَ رَوَلِمَ سَرٍ قِ،</para>
  <para style="q" vid="JOB 31:39">شَ ﭑ بَرَ عَ كَنيِ تْورْ،<verse eid="JOB 31:39"/></para>
  <para style="q">
    <verse number="40" style="v" sid="JOB 31:40"/>مّنفِ نَشَن نَ ﭑ مَ بْشِ مَ، نَ شَ قِندِ تُنبٍ رَ،</para>
  <para style="q" vid="JOB 31:40">ﭑ مَ قُندٍنيِ شَ قِندِ حٌوفٍ حَاشِ رَ.»</para>
  <para style="b" vid="JOB 31:40"/>
  <para style="q" vid="JOB 31:40">عَيُبَ شَ مَسٍنيِ دْنشْي نَن نَ كِ.<verse eid="JOB 31:40"/></para>
  <chapter eid="JOB 31"/>
  <chapter number="32" style="c" sid="JOB 32"/>
  <para style="s1">عٍلِهُ شَ مَسٍنيِ سِنفٍ</para>
  <para style="s2">«عَلَ نَن لْننِ قِمَ مِشِ مَ»</para>
  <para style="p">
    <verse number="1" style="v" sid="JOB 32:1"/>يِ شّمّ سَشَنيِيٍ نَشَ بَ عَيُبَ شَ وْيّنيِ يَابِقٍ، بَرِ مَ عَ نُ عَ يّتّ قِندِشِ نْندِ قَلّ نَن نَ. <verse eid="JOB 32:1"/><verse number="2" style="v" sid="JOB 32:2"/>نَ كُي عٍلِهُ، بَرَكٍيلِ بُو سِكَ شَ دِ، نَشَن قَتَن رَ مَ شَبِلّ رَ، عَ بْحّ نَشَ تٍ عَيُبَ شِلِ مَ، بَرِ مَ نَ نُ عَ يّتّ قِندِشِ نْندِ قَلّ نَن نَ عَلَ يَ عِ. <verse eid="JOB 32:2"/><verse number="3" style="v" sid="JOB 32:3"/>عَ بْحّ نَشَ تٍ عَ بٌورٍ سَشَنيِيٍ شِلِ مَ، بَرِ مَ عٍ مُ نُ نْمَ عَيُبَ يَابِدٍ هَلِ عٍ تٌ عَ كٌلٌنشِ نْندِ مُ نُ عَ بّ. <verse eid="JOB 32:3"/><verse number="4" style="v" sid="JOB 32:4"/>نَ مِشِ سَشَنيِيٍ تٌ نُ مْشِ عَ بّ، عٍلِهُ مَمّ تِ نَ نَن مَ وْيّنقٍ رَ عَيُبَ بّ. <verse eid="JOB 32:4"/><verse number="5" style="v" sid="JOB 32:5"/>عٍلِهُ نُ بَرَ عَ تٌ، يَابِ يٌ مُ نُ نَ يِ مِشِ سَشَنيِيٍ يِ رَ قَ. نَ كُي عَ بْحّ نَشَ تٍ.<verse eid="JOB 32:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JOB 32:6"/>عٍلِهُ، بَرَكٍيلِ بُو سِكَ شَ دِ، نَشَ عَ قَلَ،</para>
  <para style="q" vid="JOB 32:6">«قٌنِكٍ نَن ﭑ نَ، قٌرِيٍ نَن وٌ تَن نَ.</para>
  <para style="q" vid="JOB 32:6">ﭑ فَاشُ ﭑ مَ مَرَكٌلٌنيِ سَدٍ وٌ يَ عِ نَ نَن مَ.<verse eid="JOB 32:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 32:7"/>ﭑ نَشّ، ‹قٌرِ نَن قَتَ وْيّندٍ،</para>
  <para style="q" vid="JOB 32:7">عَ شَ سِمَيَ شْنكُيٍ شَ قٍ رَ.›<verse eid="JOB 32:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 32:8"/>كْنْ عَلَ سّنبّ كَنيِ نَن شَشِلِ قِمَ عَدَ مَ مَ.<verse eid="JOB 32:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 32:9"/>سِمَيَ شْنكُيٍ فبَنسَن شَ مُ شَشِلِمَيَ قِمَ مِشِ مَ،</para>
  <para style="q" vid="JOB 32:9">قٌرِيٍ فبَنسَن شَ مُ قِندِشِ نْندِ كَنيِيٍ رَ.<verse eid="JOB 32:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 32:10"/>نَ كُي ﭑ بَرَ وٌ مَشَندِ،</para>
  <para style="q" vid="JOB 32:10">وٌ شَ وٌ تُلِ مَتِ ﭑ مَ مَرَكٌلٌنيِ رَ.»<verse eid="JOB 32:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="JOB 32:11"/>«ﭑ بَرَ وٌ شَ مَسٍنيِ رَحْنيِ مَمّ،</para>
  <para style="q" vid="JOB 32:11">ﭑ بَرَ ﭑ تُلِ مَتِ وٌ شَ مَسٍنيِ بِرِن نَ،</para>
  <para style="q" vid="JOB 32:11">وٌ نَشَن قَلَشِ عَيُبَ شَ قٍ رَ.<verse eid="JOB 32:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 32:12"/>ﭑ بَرَ وٌ شَ مَسٍنيِيٍ رَ مّ،</para>
  <para style="q" vid="JOB 32:12">كْنْ وٌ مُ نْشِ عَيُبَ يَابِدٍ،</para>
  <para style="q" vid="JOB 32:12">وٌ مُ نْشِ نْندِ مَكّنّندٍ عَ بّ.<verse eid="JOB 32:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 32:13"/>وٌ نَشَ عَ قَلَ دٍ،</para>
  <para style="q" vid="JOB 32:13">‹وٌن تَن بَرَ فّ لْننِ سْتْدٍ.</para>
  <para style="q" vid="JOB 32:13">وٌن شَ لُ عَلَ شَ يِ شّمّ رَقَهَامُ،</para>
  <para style="q" vid="JOB 32:13">عَدَ مَدِ مُ نْمَ نَ رَبَدٍ.›<verse eid="JOB 32:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 32:14"/>عَيُبَ مُ عَ شَ مَسٍنيِ تِشِ ﭑ تَن شَ شِلِ مَ.</para>
  <para style="q" vid="JOB 32:14">ﭑ قَن مَن مُ عَ يَابِمَ وٌ شَ مَسٍنيِيٍ رَ.»<verse eid="JOB 32:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="JOB 32:15"/>«لِمَنِيَ بَرَ بَ وٌ يِ رَ.</para>
  <para style="q" vid="JOB 32:15">يَابِ يٌ مُ نَ سْنْن وٌ نَشَن تِمَ.<verse eid="JOB 32:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 32:16"/>ﭑ بَرَ وٌ شَ مَسٍنيِ دَندٍ تٌ،</para>
  <para style="q" vid="JOB 32:16">يَابِ يٌ مُ مِنِمَ وٌ دّ كُي قَ.<verse eid="JOB 32:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 32:17"/>يَكْسِ ﭑ شَ ﭑ فبٍ قَلَ،</para>
  <para style="q" vid="JOB 32:17">ﭑ تَن قَن شَ ﭑ مَ لْننِ مَسٍن كْرّ،<verse eid="JOB 32:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 32:18"/>بَرِ مَ قٍ فبٍفبٍ نَ ﭑ قُرِ كُي.</para>
  <para style="q" vid="JOB 32:18">ﭑ شَشِلِ نَ ﭑ تُتُنقٍ،<verse eid="JOB 32:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 32:19"/>عَلْ وّنِ نّينّ نَشَن شُقُشُقُقٍ،</para>
  <para style="q" vid="JOB 32:19">عَ وَ مَ عَ سَسٍ بُلَقٍ.<verse eid="JOB 32:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 32:20"/>ﭑ شَ وْيّن عَلَكٌ ﭑ بْحّ شَ فٌرٌ.</para>
  <para style="q" vid="JOB 32:20">ﭑ دّ شَ يَابِ تِ.<verse eid="JOB 32:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 32:21"/>ﭑ مُ مِشِ يٌ رَقِسَمَ عَ بٌورٍ بّ،</para>
  <para style="q" vid="JOB 32:21">ﭑ مُ تَامِشِيَ رَبَمَ مِشِ يٌ بّ.<verse eid="JOB 32:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 32:22"/>ﭑ مُ قَتَ تَامِشِيَ رَ،</para>
  <para style="q" vid="JOB 32:22">ﭑ نَ نَ رَبَ، عَلَ ﭑ نَبٌلٌمَ نّ.»<verse eid="JOB 32:22"/></para>
  <chapter eid="JOB 32"/>
  <chapter number="33" style="c" sid="JOB 33"/>
  <para style="s1">عٍلِهُ شَ مَسٍنيِ سِنفٍ دّ عِدْشْي</para>
  <para style="s2">«شُنمَقَلَمَ شَ لُ عَدَ مَ بّ.»</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 33:1"/>«يَكْسِ عَيُبَ، عِ عِ تُلِ مَتِ ﭑ مَ مَسٍنيِ رَ،</para>
  <para style="q" vid="JOB 33:1">عِ شَ ﭑ مَ وْيّنيِ رَ مّ.<verse eid="JOB 33:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 33:2"/>ﭑ بَرَ ﭑ دّ رَبِ،</para>
  <para style="q" vid="JOB 33:2">ﭑ نّنيِ بَرَ كٍلِ.<verse eid="JOB 33:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 33:3"/>ﭑ مَ مَسٍنيِ كٍلِشِ ﭑ بْحّ قِيشّ نَن كُي،</para>
  <para style="q" vid="JOB 33:3">نْندِ نَن مِنِمَ ﭑ دّ عِ.<verse eid="JOB 33:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 33:4"/>عَلَ شَشِلِ بَرَ ﭑ دَا،</para>
  <para style="q" vid="JOB 33:4">عَلَ سّنبّ كَنيِ حّنفِ بَرَ ﭑ قِندِ مِشِ حِحّ رَ.<verse eid="JOB 33:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 33:5"/>شَ عِ نْمَ ﭑ يَابِدٍ،</para>
  <para style="q" vid="JOB 33:5">عِ شَ نَ رَبَ.<verse eid="JOB 33:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 33:6"/>وٌن قِرِن بِرِن لَن عَلَ يَ عِ.</para>
  <para style="q" vid="JOB 33:6">ﭑ قَن يَءِلَنشِ بّندّ نَن نَ.<verse eid="JOB 33:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 33:7"/>نَ كُي عِ نَشَ فَاشُ ﭑ يَ رَ.<verse eid="JOB 33:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 33:8"/>كْنْ عِ بَرَ وْيّنيِ ندٍ قَلَ،</para>
  <para style="q" vid="JOB 33:8">ﭑ نَشَن مّشِ ﭑ تُلِ رَ.<verse eid="JOB 33:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 33:9"/>عِ بَرَ عَ قَلَ،</para>
  <para style="q" vid="JOB 33:9">‹ﭑ سّنِيّن، ﭑ مُ يُنُبِ رَبَشِ،<verse eid="JOB 33:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 33:10"/>كْنْ عَلَ مَن نَ قٍ ندٍ تٌقٍ ﭑ نَ،</para>
  <para style="q" vid="JOB 33:10">ﭑ قِندِشِ عَ يَشُي رَ نَشَن مَ.<verse eid="JOB 33:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 33:11"/>عَ بَرَ ﭑ سَنيِ مَبَلَن يْلْنشْنيِ كُي،</para>
  <para style="q" vid="JOB 33:11">عَ نُ قَ ﭑ قْشِ بِرِن عِفبّ.›<verse eid="JOB 33:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="JOB 33:12"/>كْنْ ﭑ شَ عَ قَلَ عِ بّ،</para>
  <para style="q" vid="JOB 33:12">نْندِ مُ عِ بّ نَ قٍ كُي،</para>
  <para style="q" vid="JOB 33:12">بَرِ مَ عَلَ فبٌ مِشِ بّ.<verse eid="JOB 33:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 33:13"/>عِ وَ مَ عَلَ رَكِيتِقٍ مُنقٍ رَ؟</para>
  <para style="q" vid="JOB 33:13">عَ مُ يَابِ قِمَ عَ شَ قٍ رَبَشِ بِرِن مَ.<verse eid="JOB 33:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 33:14"/>عَلَ قٍ مَسٍنمَ وٌن بّ كِ ندٍ رَ،</para>
  <para style="q" vid="JOB 33:14">كْنْ وٌن مُ وٌن حْشْ سَمَ نَ شْن مَ.<verse eid="JOB 33:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 33:15"/>عَ نْمَ وْيّندٍ شِيٍ رَ كْي رَ،</para>
  <para style="q" vid="JOB 33:15">مِشِ شِمَ تّمُي نَشّ عٍ شَ سَدٍ مَ.<verse eid="JOB 33:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 33:16"/>عَ نْمَ عَدَ مَدِيٍ تُلِ رَبِدٍ نَ تّمُي،</para>
  <para style="q" vid="JOB 33:16">عَ عٍ رَكٌلٌن قٍيٍ رَ نَشٍيٍ كٍلِشِ عَ تَن مَ،<verse eid="JOB 33:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 33:17"/>عَلَكٌ عٍ شَ كِرَ حَاشِ بّحِن،</para>
  <para style="q" vid="JOB 33:17">عَ مَن شَ عٍ رَتَنفَ عٍ يّتّ كَن عِفبٌقٍ مَ.<verse eid="JOB 33:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 33:18"/>نَ كُي، عَ عٍ رَتَنفَمَ نّ فَبُرِ فبَلٌي مَ،</para>
  <para style="q" vid="JOB 33:18">عَ عٍ رَتَنفَ سَنتِدّفّمَ مَ.<verse eid="JOB 33:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 33:19"/>عَلَ مَن نْمَ مَسٍنيِ تِدٍ عَدَ مَدِ بّ عَ شَ تْورّ ندٍ رَ،</para>
  <para style="q" vid="JOB 33:19">نَشَن شْنّ سٌمَ هَن عَ شْرِيٍ كُي عَ شَ قُرٍ دَفِ تَفِ.<verse eid="JOB 33:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 33:20"/>دٌنسٍ يَتِ قَ رَحَاشُ عَ مَ،</para>
  <para style="q" vid="JOB 33:20">عَ مُ نْ عَ دّفٍدٍ.<verse eid="JOB 33:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 33:21"/>عَ قَتٍ بَ عَ مَ،</para>
  <para style="q" vid="JOB 33:21">عَ شْرِيٍ بِرِن سَ كّنّ مَ.<verse eid="JOB 33:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 33:22"/>عَ مَكْرّ عَلِفِيَمَ رَ،</para>
  <para style="q" vid="JOB 33:22">سَيَمَلٍكّ قَ عَ قْشْ رَ.»<verse eid="JOB 33:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="JOB 33:23"/>«كْنْ شَ شّيرَ شُنمَقَلَمَ ندٍ سَ لُ عَ بّ</para>
  <para style="q" vid="JOB 33:23">مَلٍكّ فَلِيٍ يَ مَ،</para>
  <para style="q" vid="JOB 33:23">نَشَن قَمَ تِنشِن كِ مَسٍندٍ نَ كَنيِ بّ،<verse eid="JOB 33:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 33:24"/>نَ كُي، شّيرَ شُنمَقَلَمَ قِندِ مَ سَابُي قَنيِ رَ عَ بّ،</para>
  <para style="q" vid="JOB 33:24">عَلَ هِننّ عَ رَ، عَ عَ مَسٍن عَلَ بّ،</para>
  <para style="q" vid="JOB 33:24">‹عَ رَكِسِ قَشّ مَ، ﭑ بَرَ عَ شُنسَرٍ بَ.›<verse eid="JOB 33:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 33:25"/>نَ كُي، عَ قَتٍ مَن فبِلٍنمَ دِ مّدِحَ،</para>
  <para style="q" vid="JOB 33:25">عَ مَن قٌنِكٍ سّنبّ سْتْ.<verse eid="JOB 33:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 33:26"/>عَدَ مَدِ نَ عَلَ هِننّنتٍ مَشَندِ،</para>
  <para style="q" vid="JOB 33:26">عَ عَلَ يَتَفِ تٌمَ نّ سّيوّ كُي،</para>
  <para style="q" vid="JOB 33:26">عَلَ قَ تِنشِنيِ قِ عَ مَ.<verse eid="JOB 33:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 33:27"/>نَ كَنيِ بّيتِ بَمَ نّ مِشِيٍ يَ عِ، عَ عَ قَلَ،</para>
  <para style="q" vid="JOB 33:27">‹ﭑ يُنُبِ رَبَشِ نّ،</para>
  <para style="q" vid="JOB 33:27">ﭑ تِنشِنيِ مَدَلِن،</para>
  <para style="q" vid="JOB 33:27">كْنْ نَ سَرٍ مُ رَفبِلٍنشِ ﭑ مَ عَ كِ مَ.<verse eid="JOB 33:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 33:28"/>عَلَ بَرَ ﭑ شْرّيَ،</para>
  <para style="q" vid="JOB 33:28">ﭑ تَن نَشَن شُن نُ تِشِ عَلِفِيَمَ رَ.</para>
  <para style="q" vid="JOB 33:28">عَ مَن بَرَ فبِلٍن نَءِيَلَنيِ مَسٍن نَ ﭑ بّ.›<verse eid="JOB 33:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 33:29"/>عَلَ نَن نَ رَبَمَ عَدَ مَ بّ،</para>
  <para style="q" vid="JOB 33:29">كٍرٍن، قِرِن، هَن سَشَن،<verse eid="JOB 33:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="JOB 33:30"/>عَلَكٌ عَ شَ عَ بَ قَشّ يِ،</para>
  <para style="q" vid="JOB 33:30">عَ شَ عَ لُ نَءِيَلَنيِ كُي.»<verse eid="JOB 33:30"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="31" style="v" sid="JOB 33:31"/>«عَيُبَ، عِ تُلِ مَتِ ﭑ نَ،</para>
  <para style="q" vid="JOB 33:31">عِ شَ عِ سَبَرِ، عِ شَ ﭑ مَ مَسٍنيِ رَ مّ.<verse eid="JOB 33:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="JOB 33:32"/>شَ يَابِ ندٍ نَ عِ بّ، عِ شَ نَ قَلَ،</para>
  <para style="q" vid="JOB 33:32">بَرِ مَ ﭑ وَ مَ نْندِ قِقٍ عِ مَ.<verse eid="JOB 33:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="JOB 33:33"/>كْنْ شَ نَ مُ عَ رَ، عِ تُلِ مَتِ ﭑ نَ،</para>
  <para style="q" vid="JOB 33:33">عِ شَ عِ سَبَرِ عَلَكٌ عِ شَ شَشِلِ سْتْ ﭑ نَ.»<verse eid="JOB 33:33"/></para>
  <chapter eid="JOB 33"/>
  <chapter number="34" style="c" sid="JOB 34"/>
  <para style="s1">عٍلِهُ شَ مَسٍنيِ قِرِن ندٍ</para>
  <para style="s2">«عَلَ شَ كِيتِ تِنشِن»</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 34:1"/>عٍلِهُ نَشَ عَ مَسٍن،<verse eid="JOB 34:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 34:2"/>«لْننِلَيٍ، وٌ وٌ تُلِ مَتِ.</para>
  <para style="q" vid="JOB 34:2">شَشِلِمَيٍ، وٌ ﭑ مَ مَسٍنيِ رَ مّ،<verse eid="JOB 34:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 34:3"/>بَرِ مَ تُلِ وْيّنيِ سٍنسِمَ،</para>
  <para style="q" vid="JOB 34:3">عَلْ نّنيِ دٌنسٍ سٍنسِمَ كِ نَشّ.<verse eid="JOB 34:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 34:4"/>وٌن شَ تِنشِنيِ سُفَندِ،</para>
  <para style="q" vid="JOB 34:4">وٌن شَ بِرَ قٍ قَنيِ قْشْ رَ.»<verse eid="JOB 34:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="JOB 34:5"/>«عَيُبَ نَشّ،</para>
  <para style="q" vid="JOB 34:5">‹ﭑ تِنشِن، كْنْ عَلَ مُ نْندِ قِشِ ﭑ مَ.<verse eid="JOB 34:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 34:6"/>هَلِ ﭑ تٌ تِنشِنشِ، عَ بَرَ ﭑ لُ عَلْ وُلٍ قَلّ.</para>
  <para style="q" vid="JOB 34:6">ﭑ مُ يُنُبِ يٌ رَبَشِ، كْنْ ﭑ نَ تْورّ حَاشِ كُي.›<verse eid="JOB 34:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 34:7"/>ندٍ يَافِ سْتْشِ دَنفِ عَيُبَ رَ؟<verse eid="JOB 34:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 34:8"/>عَ بَرَ عَ حّرّ تِنشِنتَرٍيَ كُي،</para>
  <para style="q" vid="JOB 34:8">عَ بَرَ لُ قٍ حَاشِ رَبَيٍ يَ مَ.<verse eid="JOB 34:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 34:9"/>عَ بَرَ عَ قَلَ،</para>
  <para style="q" vid="JOB 34:9">‹فٍينِ مُ نَ عَدَ مَدِ بّ</para>
  <para style="q" vid="JOB 34:9">نَشَن بِرَ مَ عَلَ وَشْنقٍ قْشْ رَ.›<verse eid="JOB 34:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 34:10"/>شَشِلِمَيٍ، وٌ وٌ تُلِ مَتِ ﭑ نَ.</para>
  <para style="q" vid="JOB 34:10">عَلَ نُن قٍ حَاشِ تَفِ عِكُيَ،</para>
  <para style="q" vid="JOB 34:10">عَلَ سّنبّ كَنيِ مُ تِنشِنتَرٍيَ كٌلٌن.<verse eid="JOB 34:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 34:11"/>عَ مِشِيٍ شَ قٍ رَبَشِ سَرٍ رَفبِلٍنمَ عٍ مَ،</para>
  <para style="q" vid="JOB 34:11">عَ كٌتٍ دْشْمَ عٍ شُن مَ عٍ نُن نَشَن لَن.<verse eid="JOB 34:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 34:12"/>عَلَ مُ نْمَ قٍ حَاشِ رَبَدٍ.</para>
  <para style="q" vid="JOB 34:12">عَلَ سّنبّ كَنيِ مُ نْمَ تِنشِنيِ كَنَدٍ.<verse eid="JOB 34:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 34:13"/>ندٍ عَ تِ عَ شَ دُنِحَ يَمَرِ؟</para>
  <para style="q" vid="JOB 34:13">ندٍ دُنِحَ تَشُشِ عَ رَ؟<verse eid="JOB 34:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 34:14"/>شَ عَلَ مُ عَ حّنفِ سَشِ عَدَ مَدِيٍ شْن مَ نُ،</para>
  <para style="q" vid="JOB 34:14">عَ قَ عَ شَشِلِ نُن عَ حّنفِ بَ عٍ يِ،<verse eid="JOB 34:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 34:15"/>عَدَ مَدِ بِرِن قَشَمَ كٍرٍنيِ نَن نَ نُ،</para>
  <para style="q" vid="JOB 34:15">عٍ قِندِ بّندّ رَ.<verse eid="JOB 34:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 34:16"/>شَ شَشِلِ قَنيِ نَ عِ يِ رَ،</para>
  <para style="q" vid="JOB 34:16">عِ شَ عِ تُلِ مَتِ ﭑ مَ مَسٍنيِ رَ.<verse eid="JOB 34:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 34:17"/>تِنشِنتَرٍ نْمَ دُنِحَ يَمَرِدٍ؟</para>
  <para style="q" vid="JOB 34:17">عِ تِنشِنتْي سّنبّمَ نَن كَلَمُمَ؟<verse eid="JOB 34:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 34:18"/>عِ نْمَ عَ قَلَدٍ مَنفّ بّ،</para>
  <para style="q" vid="JOB 34:18">‹مِشِ شُرِ دِ نَن عِ رَ؟›</para>
  <para style="q" vid="JOB 34:18">عِ نْمَ عَ قَلَدٍ كُنتِفِيٍ بّ،</para>
  <para style="q" vid="JOB 34:18">‹وٌ حَاشُ؟›<verse eid="JOB 34:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 34:19"/>عَلَ مُ مَنفّ رَقِسَ مِشِيٍ بّ،</para>
  <para style="q" vid="JOB 34:19">عَ مُ بَننَيٍ رَقِسَ سٍتَرٍيٍ بّ،</para>
  <para style="q" vid="JOB 34:19">بَرِ مَ عَ تَن نَن بِرِن دَاشِ.<verse eid="JOB 34:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 34:20"/>قَشّ مَن عٍ بِرِن تّرّننَمَ نّ.</para>
  <para style="q" vid="JOB 34:20">حَمَيٍ عٍ شُنيِ عِكٍلِمَ، كْي كُي عٍ بِرِن سْنتْ.</para>
  <para style="q" vid="JOB 34:20">سّنبّمَيٍ يَتِ قَشَمَ نّ قْيْفْنتْن.<verse eid="JOB 34:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 34:21"/>عَلَ عَدَ مَدِيٍ شَ كِرَ بِرِن مَتٌمَ،</para>
  <para style="q" vid="JOB 34:21">عَ عٍ قْشِ عِفبّ.<verse eid="JOB 34:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 34:22"/>دِ مِ مُ نَ نَشَن نْمَ تِنشِنتَرٍيٍ نْشُندٍ.<verse eid="JOB 34:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 34:23"/>عَلَ هَيِ مُ نَ تّمُي شْنكُيٍ مَ مِشِ مَكِيتِقٍ رَ.<verse eid="JOB 34:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 34:24"/>عَ نْمَ سّنبّمَيٍ شُن نَكَنَدٍ مَقُرٍنيِ رَ،</para>
  <para style="q" vid="JOB 34:24">عَ قَ مِشِ فبّتّيٍ دْشْ عٍ حْشْي رَ.<verse eid="JOB 34:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 34:25"/>عَ نَ عٍ شَ قٍ حَاشِ تٌ،</para>
  <para style="q" vid="JOB 34:25">عَ نْمَ عٍ بَدٍ دُنِحَ مَ كٍرٍنيِ رَ كْي كُي.<verse eid="JOB 34:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 34:26"/>عَ نْمَ عٍ بْنبْدٍ عَلْ مِشِ كٌبِ حَمَ يَ شْرِ،<verse eid="JOB 34:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 34:27"/>بَرِ مَ عٍ مّيشِ عَ شَ سّرِيّ نَن نَ،</para>
  <para style="q" vid="JOB 34:27">عٍ عَ شَ كِرَ بّحِن.<verse eid="JOB 34:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 34:28"/>عٍ بَرَ عَ نِيَ سٍتَرٍ وَ شُي شَ عَلَ لِ.</para>
  <para style="q" vid="JOB 34:28">عَلَ تْورْ مِشِ مَلِمَ.<verse eid="JOB 34:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 34:29"/>شَ عَلَ عَ سَبَرِ، ندٍ نْمَ عَ كَلَمُدٍ؟</para>
  <para style="q" vid="JOB 34:29">شَ عَلَ عَ نْشُن، ندٍ نْمَ عَ تٌدٍ؟</para>
  <para style="q" vid="JOB 34:29">عَدَ مَدِ مُ نْمَ نَ رَ، حَمَنّيٍ يَتِ مُ نْمَ نَ رَ.<verse eid="JOB 34:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="JOB 34:30"/>عَلَ مُ تِنشِنتَرٍ لُمَ مَنفّيَ كُي،</para>
  <para style="q" vid="JOB 34:30">عَلَكٌ عَ شَ فَنتَنيِ تٍ حَمَ بّ.<verse eid="JOB 34:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="JOB 34:31"/>نَ مِشِ مْولِ مُ عَ قَلَمَ عَلَ بّ،</para>
  <para style="q" vid="JOB 34:31">‹ﭑ بَرَ فبِلٍن قٍ حَاشِ قْشْ رَ ﭑ مَ حَشَنكَتّ شَ قٍ رَ.<verse eid="JOB 34:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="JOB 34:32"/>ﭑ قٍ حَاشِ نَشَن نَبَشِ،</para>
  <para style="q" vid="JOB 34:32">نَ مَسٍن ﭑ بّ، ﭑ مُ نَ رَبَمَ سْنْن؟›<verse eid="JOB 34:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="JOB 34:33"/>عَلَ لَنمَ عَ شَ عَ سَرٍ قِ؟</para>
  <para style="q" vid="JOB 34:33">عِ تَن نَن عَ مَتَندِقٍ، ﭑ تَن مُ عَ رَ،</para>
  <para style="q" vid="JOB 34:33">عِ تَن نَن يَابِ تِمَ.<verse eid="JOB 34:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="JOB 34:34"/>شَشِلِمَيٍ نُن لْننِلَيٍ نَشٍيٍ عٍ تُلِ مَتِشِ ﭑ نَ،</para>
  <para style="q" vid="JOB 34:34">مُشُ بِرِن بَرَ لَن يِ مَ؛<verse eid="JOB 34:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="JOB 34:35"/>عَيُبَ وْيّنقٍ شَشِلِتَرٍحَ نَن كُي،</para>
  <para style="q" vid="JOB 34:35">لْننِ مُ عَ يِ.<verse eid="JOB 34:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="JOB 34:36"/>عَيُبَ شَ حَشَنكَتَ هَن عَ دَندٍ،</para>
  <para style="q" vid="JOB 34:36">بَرِ مَ عَ شَ مَسٍنيِيٍ مُ تِنشِن.<verse eid="JOB 34:36"/></para>
  <para style="q">
    <verse number="37" style="v" sid="JOB 34:37"/>عَ شَ يُنُبِ شُن نَن تُن مَسَقٍ.</para>
  <para style="q" vid="JOB 34:37">عَ وْيّنمَ مُشُ بّ يّتّ عِفبٌحَ رَ،</para>
  <para style="q" vid="JOB 34:37">عَ عَ شَ عَلَ مَتَندِ شُن مَسَمَ عَ شَ وْيّنيِ رَ.»<verse eid="JOB 34:37"/></para>
  <chapter eid="JOB 34"/>
  <chapter number="35" style="c" sid="JOB 35"/>
  <para style="s1">عٍلِهُ شَ مَسٍنيِ سَشَن ندٍ</para>
  <para style="s2">«عَلَ عِ شَ قٍ كٌلٌن»</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 35:1"/>عٍلِهُ نَشَ عَ قَلَ،<verse eid="JOB 35:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 35:2"/>«عِ حْشْ عَ مَ نْندِ نَ عِ بّ عِ نَ عَ قَلَ،</para>
  <para style="q" vid="JOB 35:2">‹ﭑ مَ تِنشِنيِ قَتَنشِ عَلَ نَن نَ؟›<verse eid="JOB 35:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 35:3"/>عِ بَرَ عَ مَشْرِن،</para>
  <para style="q" vid="JOB 35:3">‹فٍينِ مُندُن نَ ﭑ بّ شَ ﭑ مُ يُنُبِ رَبَمَ؟›<verse eid="JOB 35:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 35:4"/>ﭑ تَن نَن عِ يَابِمَ نَ رَ، عِ تَن نُن عِ بٌورٍيٍ.<verse eid="JOB 35:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 35:5"/>كٌورٍ مَتٌ. نُشُي مُ نَ عِ شُن مَ شّ؟<verse eid="JOB 35:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 35:6"/>شَ عِ يُنُبِ رَبَ، نَ قِندِ مَ تْورّ رَ عَلَ نَن بّ؟</para>
  <para style="q" vid="JOB 35:6">شَ عِ عَ مَتَندِ، نَ قِندِ مَ كٌتٍ مُندُن نَ عَ بّ؟<verse eid="JOB 35:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 35:7"/>شَ عِ تِنشِن، نَ قِندِ مَ فٍينِ مُندُن نَ عَ تَن بّ؟<verse eid="JOB 35:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 35:8"/>عِ شَ قٍ حَاشِ نْمَ عَدَ مَدِ نَن فبَنسَن تْورْدٍ،</para>
  <para style="q" vid="JOB 35:8">عَدَ مَدِ نَشَن لُشِ عَلْ عِ تَن.</para>
  <para style="q" vid="JOB 35:8">عِ شَ تِنشِنيِ قَن نْمَ قِندِدٍ فٍينِ رَ عَدَ مَدِ نَن فبَنسَن بّ.<verse eid="JOB 35:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 35:9"/>مِشِيٍ عٍ وَ شُي مّمَ بَرِ مَ قٍ حَاشِ رَبَيٍ وُيَ.</para>
  <para style="q" vid="JOB 35:9">مِشِيٍ شِلِ تِمَ نَ كٌبِحَ شَ قٍ رَ.<verse eid="JOB 35:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 35:10"/>كْنْ مِشِ يٌ مُ عَ قَلَمَ،</para>
  <para style="q" vid="JOB 35:10">‹ﭑ دَا مَنفّ عَلَ نَ مِندٍن،</para>
  <para style="q" vid="JOB 35:10">ﭑ بّيتِ بَمَ نَشَن بّ كْي رَ،<verse eid="JOB 35:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 35:11"/>نَشَن لْننِ قِمَ عَدَ مَدِيٍ مَ</para>
  <para style="q" vid="JOB 35:11">دَنفِقٍ سُبٍيٍ رَ نَشٍيٍ نَ دُنِحَ مَ،</para>
  <para style="q" vid="JOB 35:11">دَنفِقٍ شْنِيٍ رَ نَشٍيٍ نَ كُيٍ مَ؟›<verse eid="JOB 35:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 35:12"/>مِشِيٍ شِلِ تِمَ، كْنْ عَ مُ عٍ يَابِمَ</para>
  <para style="q" vid="JOB 35:12">قٍ حَاشِ رَبَيٍ شَ يّتّ عِفبٌحَ شَ قٍ رَ.<verse eid="JOB 35:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 35:13"/>عٍ شِلِ تِمَ قُقَقُ،</para>
  <para style="q" vid="JOB 35:13">بَرِ مَ عَلَ مُ عَ تُلِ مَتِمَ عٍ رَ،</para>
  <para style="q" vid="JOB 35:13">عَلَ سّنبّ كَنيِ مُ عٍ شُي رَ مّمَ.<verse eid="JOB 35:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 35:14"/>كْنْ عِ تَن نَن عَ قَلَشِ عَ عِ مُ عَلَ تٌشِ،</para>
  <para style="q" vid="JOB 35:14">عِ شَ قٍ سَشِ عَ يَ عِ، عِ نَ عَ مَمّقٍ تُن.<verse eid="JOB 35:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 35:15"/>عَ مُ نُ شْنْ عِ شَ مَتَندِ وْيّنيِيٍ مَ سِندٍن.<verse eid="JOB 35:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 35:16"/>عَيُبَ، عِ بَرَ عِ دّ رَبِ قُقَقُ شَشِلِتَرٍحَ قَلَقٍ رَ.»<verse eid="JOB 35:16"/></para>
  <chapter eid="JOB 35"/>
  <chapter number="36" style="c" sid="JOB 36"/>
  <para style="s1">عٍلِهُ شَ مَسٍنيِ نَانِ ندٍ</para>
  <para style="s2">«عَلَ عَدَ مَ رَ سِمَ»</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 36:1"/>عٍلِهُ مَن نَشَ عَ قَلَ،<verse eid="JOB 36:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 36:2"/>«عِ شَ مَمّ تِ، ﭑ قَمَ ﭑ مَ لْننِ مَسٍندٍ عِ بّ عَلَ شَ قٍ كُي.<verse eid="JOB 36:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 36:3"/>ﭑ مَ لْننِ كٍلِمَ يِرٍ مَكُيٍ نّ.</para>
  <para style="q" vid="JOB 36:3">ﭑ نْندِ قِمَ نّ ﭑ دَا مَنفّ مَ.<verse eid="JOB 36:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 36:4"/>وُلٍ يٌ مُ نَ ﭑ مَ مَسٍنيِ كُي.</para>
  <para style="q" vid="JOB 36:4">عِ نُن نَشَن عَ رَ يِ كِ،</para>
  <para style="q" vid="JOB 36:4">تِنشِنتْي نَن عَ رَ نَشَن شَ لْننِ كَمَلِشِ.»<verse eid="JOB 36:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="JOB 36:5"/>«عَلَ سّنبّ فبٌ،</para>
  <para style="q" vid="JOB 36:5">عَ مُ يٌمَ مِشِ يٌ مَ.</para>
  <para style="q" vid="JOB 36:5">عَ سّنبّ فبٌ، عَ حَنِفٍ قَن.<verse eid="JOB 36:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 36:6"/>عَ مُ عَ لُمَ مِشِ حَاشِيٍ شَ بُ،</para>
  <para style="q" vid="JOB 36:6">عَ مّينِمَ تْورْ مِشِيٍ مَ.<verse eid="JOB 36:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 36:7"/>عَ مّينِمَ نّ تِنشِنتْييٍ مَ،</para>
  <para style="q" vid="JOB 36:7">عَ عٍ رَ سَبَتِ مَنفّيٍ سّيتِ مَ كِبَنيِ،</para>
  <para style="q" vid="JOB 36:7">عَ عٍ شَ قٍ عِتٍ عٍ شَ بُ عَبَدَن.<verse eid="JOB 36:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 36:8"/>كْنْ شَ عٍ سُشُشِ تْورّ نَن كُي،<verse eid="JOB 36:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 36:9"/>عَ عٍ شَ قٍ حَاشِيٍ مَسٍن عٍ بّ،</para>
  <para style="q" vid="JOB 36:9">عٍ نَشٍيٍ رَبَشِ عٍ شَ يّتّ عِفبٌحَ كُي.<verse eid="JOB 36:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 36:10"/>عَ مَرَ سِ قَنيِ قِ عٍ مَ،</para>
  <para style="q" vid="JOB 36:10">عَ عَ قَلَ عٍ بّ عٍ شَ تِنشِنتَرٍيَ بّحِن.<verse eid="JOB 36:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 36:11"/>شَ عٍ عٍ تُلِ مَتِمَ عَ رَ،</para>
  <para style="q" vid="JOB 36:11">عٍ نَ سّرِيّ رَبَتُ،</para>
  <para style="q" vid="JOB 36:11">عٍ شَ سِمَيَ شْن كُيَمَ نّ هّيرِ كُي،</para>
  <para style="q" vid="JOB 36:11">عٍ شَ قٍ بِرِن سْونّيَ.<verse eid="JOB 36:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 36:12"/>كْنْ شَ عٍ مُ عٍ تُلِ مَتِمَ عَ رَ،</para>
  <para style="q" vid="JOB 36:12">عٍ قَشَمَ نّ سَنتِدّفّمَ رَ لْننِتَرٍحَ كُي.<verse eid="JOB 36:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 36:13"/>تِنشِنتَرٍيٍ شْنْمَ،</para>
  <para style="q" vid="JOB 36:13">عٍ مُ عَلَ مَشَندِ مَ عَ نَ عٍ سُشُ تّمُي نَشّ.<verse eid="JOB 36:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 36:14"/>عٍ قَشَمَ عٍ قٌنِكٍ نَن نَ لَنفٌييٍ يَ مَ.<verse eid="JOB 36:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 36:15"/>كْنْ عَلَ تْورْ مِشِيٍ رَكِسِمَ نّ عٍ شَ تْورّ سَابُي رَ.</para>
  <para style="q" vid="JOB 36:15">تْورّ نَن مَرَ سِ قِمَ عٍ مَ.»<verse eid="JOB 36:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="JOB 36:16"/>«عَ وَ مَ عِ تَن قَن نَكِسِقٍ عِ شَ تْورّ كُي،</para>
  <para style="q" vid="JOB 36:16">عَلَكٌ تْورّ نَشَ عِ رَشّتّن،</para>
  <para style="q" vid="JOB 36:16">عَلَكٌ دٌنسٍ قَنيِ شَ لُ عِ يِ رَ.<verse eid="JOB 36:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 36:17"/>كْنْ عِ نَ عَ رَبَ عَلْ مِشِ حَاشِيٍ،</para>
  <para style="q" vid="JOB 36:17">حَشَنكَتّ نَشَن لَن عَ شَ دْشْ مِشِ حَاشِيٍ مَ،</para>
  <para style="q" vid="JOB 36:17">نَ كِيتِ تِنشِنشِ نَن دْشْمَ عِ قَن مَ.<verse eid="JOB 36:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 36:18"/>عِ نَشَ يٌ عَلَ مَ عِ شَ شْنّ كُي،</para>
  <para style="q" vid="JOB 36:18">عِ نَشَ فبِلٍن عَلَ قْشْ رَ سٍ ندٍ شَ قٍ رَ.<verse eid="JOB 36:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 36:19"/>عِ وَ شُي نْمَ عِ رَ مِنِدٍ عِ شَ تْورّ كُي؟</para>
  <para style="q" vid="JOB 36:19">عِ نْمَ نَ رَبَدٍ عِ يّتّ سّنبّ رَ؟<verse eid="JOB 36:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 36:20"/>كْي نَشَ قِندِ عِ بّ مِشِ تْورْ سٍ رَ،<verse eid="JOB 36:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 36:21"/>عِ نَشَ بِرَ قٍ حَاشِ قْشْ رَ عِ شَ تْورّ شَ قٍ رَ.<verse eid="JOB 36:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 36:22"/>قِسَمَنتٍ نَن عَلَ رَ عَ سّنبّ شَ قٍ رَ.</para>
  <para style="q" vid="JOB 36:22">ندٍ نْمَ عَ رَ سِدٍ؟<verse eid="JOB 36:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 36:23"/>ندٍ نْمَ عَ يَمَرِدٍ؟</para>
  <para style="q" vid="JOB 36:23">ندٍ نْمَ عَ قَلَدٍ، ‹عِ بَرَ تَنتَن؟›<verse eid="JOB 36:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 36:24"/>عِ شَ عَ شَ كّوَلِ مَتْشْ،</para>
  <para style="q" vid="JOB 36:24">عَلْ مِشِيٍ لُمَ عَ بَ رَ بّيتِ رَ كِ نَشّ.<verse eid="JOB 36:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 36:25"/>عَدَ مَدِ بِرِن بَرَ عَ شَ وَلِ تٌ،</para>
  <para style="q" vid="JOB 36:25">دُنِحَ بِرِن عَ تٌمَ كٍلِقٍ يِرٍ مَكُيٍ.<verse eid="JOB 36:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 36:26"/>عَلَ سّنبّ فبٌ،</para>
  <para style="q" vid="JOB 36:26">وٌن مُ نْمَ نَ بِرِن كٌلٌندٍ.</para>
  <para style="q" vid="JOB 36:26">وٌن مُ نْمَ عَ شَ عَبَدَن كْنتِ كٌلٌندٍ.<verse eid="JOB 36:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 36:27"/>عَ يٍ تٌنبِيٍ مَقِندِ مَ تُنّ رَ،</para>
  <para style="q" vid="JOB 36:27">عَ قَ عَ رَفٌرٌ بْشِ مَ.<verse eid="JOB 36:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 36:28"/>نُشُييٍ نَن تُنّ يٍ رَيٍنسٍنمَ عَدَ مَدِ بِرِن شُن مَ.<verse eid="JOB 36:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 36:29"/>ندٍ نْمَ نُشُي شَ وَلِ قَهَامُدٍ؟</para>
  <para style="q" vid="JOB 36:29">ندٍ نْمَ فَلَنيِ شَ قٍ كٌلٌندٍ؟<verse eid="JOB 36:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="JOB 36:30"/>عَ سٍيَمَكْنيِ رَفٌرٌ مَ بَا مَ،</para>
  <para style="q" vid="JOB 36:30">عَ نَءِيَلَنيِ شُنفبٍ رَ مِنِ.<verse eid="JOB 36:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="JOB 36:31"/>عَ حَمَنّ مَكِيتِمَ نٍيٍ نَن نَ.</para>
  <para style="q" vid="JOB 36:31">عَ بَلٌي قِمَ عٍ مَ عَ قَنيِ رَ.<verse eid="JOB 36:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="JOB 36:32"/>عَ سٍيَمَكْنيِ وٌلِمَ عَ وَشْندٍ.<verse eid="JOB 36:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="JOB 36:33"/>فَلَنيِ شُي مِشِيٍ رَكٌلٌنمَ نّ تُنّ شَ قَ مَ،</para>
  <para style="q" vid="JOB 36:33">هَلِ شُرُ سٍ فْورّيٍ قَن نَكٌلٌنمَ نّ،</para>
  <para style="q" vid="JOB 36:33">عٍ نُ قَ فبَتَ عٍ مَكْرّدٍ عٍ لِنفِرَ رَ.»<verse eid="JOB 36:33"/></para>
  <chapter eid="JOB 36"/>
  <chapter number="37" style="c" sid="JOB 37"/>
  <para style="s1">عٍلِهُ شَ مَسٍنيِ سُولِ ندٍ</para>
  <para style="s2">«عَلَ شَ كّوَلِ سّنبّ فبٌ»</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 37:1"/>«ﭑ بْحّ سّرّنمَ نَ نَن مَ.<verse eid="JOB 37:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 37:2"/>وٌ وٌ تُلِ مَتِ عَلَ شُي رَ،</para>
  <para style="q" vid="JOB 37:2">نَ شُي فبٍ نَشَن مِنِمَ عَ كّرّ عِ.<verse eid="JOB 37:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 37:3"/>عَ شَ سٍيَمَكْنيِ كٌورٍ بِرِن نَقٍمَ نّ،</para>
  <para style="q" vid="JOB 37:3">عَ دُنِحَ نَانِنيِ بِرِن لِ.<verse eid="JOB 37:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 37:4"/>نَ دَنفِ شَنبِ فَلَنيِ بُلَ.</para>
  <para style="q" vid="JOB 37:4">عَ لُمَ عَلْ عَلَ وَ مَ عَ شُي شُنفبٍ شَ مّ يِرٍ بِرِن.<verse eid="JOB 37:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 37:5"/>عَلَ شُي قِندِشِ كَابَنَكٌي نَن نَ.</para>
  <para style="q" vid="JOB 37:5">عَ قٍ شُنفبٍ رَبَمَ وٌن مُ نَشَن قَهَامُمَ.<verse eid="JOB 37:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 37:6"/>عَ عَ قَلَمَ بَلَبَلَنيِ بّ، ‹فٌرٌ بْشِ مَ.›</para>
  <para style="q" vid="JOB 37:6">عَ تُنّ يٍ قَن نَفٌرٌ عَ فبٍفبٍ رَ.<verse eid="JOB 37:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 37:7"/>عَ عَدَ مَدِيٍ شَ وَلِ بِرِن دَنمَ نّ كٍرٍنيِ رَ،</para>
  <para style="q" vid="JOB 37:7">عَلَكٌ عٍ شَ عَ كٌلٌن عَ تَن نَن نَ بِرِن نَفِرِ مَ.<verse eid="JOB 37:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 37:8"/>سُبٍ شَاحّيٍ قَن سٌمَ عٍ لِنفِرَ نَ تّمُي نّ.<verse eid="JOB 37:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 37:9"/>تُرُننَادّ قٌيٍ كٍلِمَ عَ يِرٍ،</para>
  <para style="q" vid="JOB 37:9">عَ سَ قِندِ قٌيٍ شِنبٍلِ رَ كْولَ مَ.<verse eid="JOB 37:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 37:10"/>عَلَ عَ حّنفِ قٌيٍ قِندِ مَ بَلَبَلَنيِ رَ</para>
  <para style="q" vid="JOB 37:10">عَ بَا يٍ قَرِ بِرِن نَشْرْشْ فبٍن،<verse eid="JOB 37:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 37:11"/>عَ نُشُييٍ رَشِنبٍلِ،</para>
  <para style="q" vid="JOB 37:11">عَ عَ شَ سٍيَمَكْنيِ لُ عٍ مَ.<verse eid="JOB 37:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 37:12"/>عَ شَ يَمَرِ نَن نَ بِرِن نَ،</para>
  <para style="q" vid="JOB 37:12">عَ تَن نَن نٍيٍ بِرِن نَحّرّ مَ دُنِحَ بّندّ قُحِ قَرِ،</para>
  <para style="q" vid="JOB 37:12">عَ وَشْنقٍ رَبَقٍ رَ.<verse eid="JOB 37:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 37:13"/>نَ بِرِن لُمَ عَلْ لُشُسِنيِ</para>
  <para style="q" vid="JOB 37:13">عَ بْشِ عِسٍيٍ شُنسِنمَ نَشَن نَ،</para>
  <para style="q" vid="JOB 37:13">شَ نَ مُ عَ رَ، عَلْ قٍ قَنيِ عَ هِننّمَ عٍ رَ نَشَن نَ.»<verse eid="JOB 37:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="JOB 37:14"/>«عَيُبَ، عِ شَ عِ تُلِ مَتِ ﭑ مَ مَسٍنيِ رَ.</para>
  <para style="q" vid="JOB 37:14">عِ شَ عَلَ شَ كَابَنَكٌي مَتٌ.<verse eid="JOB 37:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 37:15"/>عِ نَ بِرِن نَبَ كِ كٌلٌن عَلَ يِ رَ؟</para>
  <para style="q" vid="JOB 37:15">عَ سٍيَمَكْنيِ رَ مِنِمَ نُشُي كُي كِ نَشّ، عِ نَ كٌلٌن؟<verse eid="JOB 37:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 37:16"/>نُشُي لُمَ كٌورٍ مَ كِ نَشّ، عِ نَ قَن كٌلٌن؟</para>
  <para style="q" vid="JOB 37:16">نَ بِرِن قِندِشِ عَلَ شَ لْننِ شُنفبٍ نَن نَ</para>
  <para style="q" vid="JOB 37:16">نَشَن مَنِيّ مُ نَ.<verse eid="JOB 37:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 37:17"/>قٌيٍ قُرٍ نّقّ مِنِ،</para>
  <para style="q" vid="JOB 37:17">كُيٍ عِقُرَ مَ عِ تَن نَشَن مَ،<verse eid="JOB 37:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 37:18"/>عِ قَن نْمَ كٌورٍ وَلَشّ ندٍ يَءِلَندٍ عَلْ عَلَ؟<verse eid="JOB 37:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 37:19"/>مُشُ نَشَن مَسٍنمَ عَلَ بّ نَ قَلَ مُشُ بّ بَ.</para>
  <para style="q" vid="JOB 37:19">نَ لْننِ مْولِ مُ مُشُ يِ.<verse eid="JOB 37:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 37:20"/>ﭑ نَ وْيّن، قٌ مِشِ فبّتّ شَ نَ رَدَنفِ نّ عَ مَ؟</para>
  <para style="q" vid="JOB 37:20">قٌ قٍ ندٍ شَ قَلَ عَ بّ عَ قَ كٌلٌن سْتْ نَ مَ؟<verse eid="JOB 37:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 37:21"/>يَكْسِ سٌفٍ مُ تٌمَ نُشُييٍ شَنبِ رَ،</para>
  <para style="q" vid="JOB 37:21">قٌ قٌيٍ عٍ بَ عَ يَ مَ.»<verse eid="JOB 37:21"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="22" style="v" sid="JOB 37:22"/>«يَنبّ تٌقَنيِ ندٍ نَ كٍلِقٍ كْولَ مَ،</para>
  <para style="q" vid="JOB 37:22">نَشَن قِندِشِ عَلَ شَ نْرّ شُنفبٍ رَ.<verse eid="JOB 37:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 37:23"/>عَدَ مَ مُ نْمَ عَلَ سّنبّ كَنيِ لِدٍ.</para>
  <para style="q" vid="JOB 37:23">عَ سّنبّ فبٌ،</para>
  <para style="q" vid="JOB 37:23">عَ تِنشِن.</para>
  <para style="q" vid="JOB 37:23">عَ مُ نْمَ تِنشِنتْي تْورْدٍ.<verse eid="JOB 37:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 37:24"/>عَدَ مَ لَن عَ شَ فَاشُ عَلَ يَ رَ نَ نَن مَ.</para>
  <para style="q" vid="JOB 37:24">يّتّ عِفبٌي مُ رَقَن عَ مَ.»<verse eid="JOB 37:24"/></para>
  <chapter eid="JOB 37"/>
  <chapter number="38" style="c" sid="JOB 38"/>
  <para style="s1">عَلَ شَ مَسٍنيِ سِنفٍ عَيُبَ بّ</para>
  <para style="s2">«عَيُبَ، ﭑ يَابِ شَ عِ نْمَ»</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 38:1"/>عَلَ نَشَ عَيُبَ يَابِ تُرُننَادّ قٌيٍ كُي،</para>
  <para style="q" vid="JOB 38:1">عَ نَشّ،<verse eid="JOB 38:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 38:2"/>«ندٍ نَ ﭑ مَ وَلِيٍ يَ عِسٌقٍ عَ شَ شَشِلِتَرٍ وْيّنيِيٍ رَ؟<verse eid="JOB 38:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 38:3"/>عِ عِ تَفِ عِشِرِ فبٍن عَلْ فبَنفبَلَنيِ،</para>
  <para style="q" vid="JOB 38:3">ﭑ شَ مَشْرِنيِ ندٍيٍ تِ عِ مَ،</para>
  <para style="q" vid="JOB 38:3">عِ شَ ﭑ يَابِ.<verse eid="JOB 38:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 38:4"/>عِ نُ نَ مِندٍن ﭑ تٌ نُ دُنِحَ دَامَ؟</para>
  <para style="q" vid="JOB 38:4">نَ قَلَ بَ شَ لْننِ كَنيِ نَ عِ رَ.<verse eid="JOB 38:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 38:5"/>عِ عَ كٌلٌن ندٍ دُنِحَ مَنِيَشِ؟</para>
  <para style="q" vid="JOB 38:5">ندٍ عَ مَنِيّ لُوتِيٍ عِتَلَشِ؟<verse eid="JOB 38:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 38:6"/>دُنِحَ بُنيِ نَ مِندٍن؟</para>
  <para style="q" vid="JOB 38:6">ندٍ فّمّ تِشِ دُنِحَ نَ نَشَن قَرِ؟<verse eid="JOB 38:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 38:7"/>ندٍ نَ رَبَ تُنبُييٍ تٌ نُ عٍ سّيوّ شُي عِتٍمَ،</para>
  <para style="q" vid="JOB 38:7">مَلٍكّ بّيتِبَيٍ قَن تٌ نُ ﭑ شِلِ مَتْشْمَ؟»<verse eid="JOB 38:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="JOB 38:8"/>«ندٍ بَا نَادّيٍ بَلَن،</para>
  <para style="q" vid="JOB 38:8">ﭑ تٌ عَ رَ مِنِ بْشِ مَ؟<verse eid="JOB 38:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 38:9"/>ﭑ تَن نَن نُشُي رَفٌرٌ عَ مَ،</para>
  <para style="q" vid="JOB 38:9">ﭑ دِ مِ دُ سُ عَ شُن نَ،<verse eid="JOB 38:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 38:10"/>ﭑ عَ نَانِنيِ سَ عَلَكٌ عَ نَشَ دَنفِ مّننِ رَ.<verse eid="JOB 38:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 38:11"/>ﭑ تَن نَن دَندٍ سَ مْرْنيِيٍ بّ،</para>
  <para style="q" vid="JOB 38:11">عَلَكٌ عٍ نَشَ تٍ، عٍ عَ رَدَنفِ عَ عِ.»<verse eid="JOB 38:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="JOB 38:12"/>«عِ بَرَ يَامَرِ قِ لْشْي كٍرٍن عِ شَ سِمَيَ كُي سُبَشّ شَ مِنِ،<verse eid="JOB 38:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 38:13"/>عَ شَ مِشِ حَاشِيٍ رَتّرّننَ، عَ عٍ مَكّنّن؟<verse eid="JOB 38:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 38:14"/>دُنِحَ بِرِن مَكّنّنمَ نّ سُبَشّ نَءِيَلَنيِ كُي،</para>
  <para style="q" vid="JOB 38:14">عَ لُ عَلْ بّندّ بُندَ تْنشُمَ سَشِ نَشَن مَ.</para>
  <para style="q" vid="JOB 38:14">عَ يِرٍ بِرِن تٌمَ نّ عَلْ دُفِ مَحِنفِشِ.<verse eid="JOB 38:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 38:15"/>كْنْ مِشِ حَاشِيٍ تَن بَرَ كُمَ نَءِيَلَنيِ رَ،</para>
  <para style="q" vid="JOB 38:15">عٍ سّنبّ بَرَ كَنَ.»<verse eid="JOB 38:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="JOB 38:16"/>«عِ بَا يٍ كٍلِدٍ كٌلٌن؟</para>
  <para style="q" vid="JOB 38:16">عِ بَرَ بَا بُنيِ لِ؟<verse eid="JOB 38:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 38:17"/>عِ بَرَ عَلِفِيَمَ سٌدٍ دّ تٌ؟</para>
  <para style="q" vid="JOB 38:17">عِ بَرَ سَيَ نَادّ عِفبّ؟<verse eid="JOB 38:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 38:18"/>عِ دُنِحَ عِفبٌحَ كٌلٌن؟</para>
  <para style="q" vid="JOB 38:18">عَ قَلَ ﭑ بّ شَ عِ نَ قٍ بِرِن كٌلٌن.»<verse eid="JOB 38:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="JOB 38:19"/>«نَءِيَلَنيِ كٍلِمَ مِندٍن؟</para>
  <para style="q" vid="JOB 38:19">دِ مِ شْنيِ نَ مِندٍن؟<verse eid="JOB 38:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 38:20"/>عِ نَ يِرٍيٍ كٌلٌن؟</para>
  <para style="q" vid="JOB 38:20">عِ نَا سِفَ كِرَ كٌلٌن؟<verse eid="JOB 38:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 38:21"/>شَ عِ نَ بِرِن كٌلٌن، عَوَ عِ حَن نُ بَرَ بَرِ،</para>
  <para style="q" vid="JOB 38:21">عِ شَ سِمَيَ فبٌ.<verse eid="JOB 38:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 38:22"/>عِ بَلَبَلَنيِ رَفَتَدٍ كٌلٌن؟</para>
  <para style="q" vid="JOB 38:22">عِ بَرَ نَ يِرٍ تٌ؟<verse eid="JOB 38:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 38:23"/>ﭑ نَ بَلَبَلَنيِ رَفَتَشِ تْورّ تّمُي نَن يَ رَ،</para>
  <para style="q" vid="JOB 38:23">فٍرٍ تِ لْشْي يَ رَ.<verse eid="JOB 38:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 38:24"/>سٍيَمَكْنيِ كٍلِمَ مِندٍن عَ يٍنسٍن يّ؟</para>
  <para style="q" vid="JOB 38:24">قٌيٍ نَشَن كٍلِمَ سٌفٍتٍدٍ، نَ عَ حّرّ مَ دُنِحَ مَ دِ؟<verse eid="JOB 38:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 38:25"/>ندٍ تُنّ كِرَ رَبْو مَ،</para>
  <para style="q" vid="JOB 38:25">عَ سٍيَمَكْنيِ نُن فَلَنيِ يَمَرِ عٍ شَ مِنِ؟<verse eid="JOB 38:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 38:26"/>ندٍ عَ نِيَشِ تُنّ شَ بِرَ بْشِ مَ</para>
  <para style="q" vid="JOB 38:26">مِشِ مُ نَ دّننَشّ عَلْ فبٍنفبٍرٍن يِرٍ؟<verse eid="JOB 38:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 38:27"/>ندٍ عَ نِيَشِ حٌوفٍ شَ بُلَ وُلَ عِ؟<verse eid="JOB 38:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 38:28"/>ندٍ قِندِشِ تُنّ بَبَ رَ؟</para>
  <para style="q" vid="JOB 38:28">ندٍ شِنِ رَ مِنِمَ؟<verse eid="JOB 38:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 38:29"/>ندٍ بَلَبَلَنيِ دَاشِ نَشَن كٍلِمَ كٌورٍ مَ؟<verse eid="JOB 38:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="JOB 38:30"/>ندٍ عَ نِيَمَ بَا يٍ شَ شِنبٍلِ عَ شْرْشْ،</para>
  <para style="q" vid="JOB 38:30">عَ قِندِ بَلَبَلَنيِ رَ،</para>
  <para style="q" vid="JOB 38:30">عَ دُ سُ بَا شُن نَ عَ شْرْشْ عَلْ فّمّيٍ؟»<verse eid="JOB 38:30"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="31" style="v" sid="JOB 38:31"/>«عِ تَن نَن تُنبُييٍ سَ كٌورٍ مَ،</para>
  <para style="q" vid="JOB 38:31">كَنكَن شَ لُ عَ يِرٍ عَ تٌقَن كِ مَ؟<verse eid="JOB 38:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="JOB 38:32"/>عِ تَن نَن تُنبُييٍ رَ مِنِشِ عٍ وَشَتِ</para>
  <para style="q" vid="JOB 38:32">عَلَكٌ عَدَ مَدِيٍ شَ نْ سُبٍ تْنشُمَيٍ تٌدٍ عٍ يَ مَ؟<verse eid="JOB 38:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="JOB 38:33"/>عِ كٌورٍ يَمَرِ كِ كٌلٌن؟</para>
  <para style="q" vid="JOB 38:33">عِ بَرَ سٌ بْشِ يَءِلَن كِ كُي؟»<verse eid="JOB 38:33"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="34" style="v" sid="JOB 38:34"/>«عِ قَتَ نُشُييٍ يَمَرِدٍ عَلَكٌ يٍ شَ بَنبَرَن يّ؟<verse eid="JOB 38:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="JOB 38:35"/>عِ قَتَ سٍيَمَكْنيِ يَمَرِدٍ عَلَكٌ عٍ شَ عِ شَ وَلِ رَبَ؟</para>
  <para style="q" vid="JOB 38:35">عٍ لُمَ عِ شَ يَامَرِ بُن مَ، عَ قَلَقٍ رَ، ‹مُشُ نَ بٍ؟›<verse eid="JOB 38:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="JOB 38:36"/>ندٍ لْننِ رَ سٌشِ عَدَ مَدِ بْحّ كُي،</para>
  <para style="q" vid="JOB 38:36">عَ عَ شَشِلِ دَا؟<verse eid="JOB 38:36"/></para>
  <para style="q">
    <verse number="37" style="v" sid="JOB 38:37"/>شَشِلِمَ مُندُن نْمَ نُشُي بِرِن كْنتِدٍ؟</para>
  <para style="q" vid="JOB 38:37">ندٍ نْمَ يٍ رَفٌرٌدٍ كٍلِ كٌورٍ مَ،<verse eid="JOB 38:37"/></para>
  <para style="q">
    <verse number="38" style="v" sid="JOB 38:38"/>عَلَكٌ بْشِ شَ بُندَ، شُبٍ شَ قِندِ بٌورَ رَ؟»<verse eid="JOB 38:38"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="39" style="v" sid="JOB 38:39"/>«يّتّيٍ نّ سَشِ كَامّ رَ عٍ مَ،<verse eid="JOB 38:39"/></para>
  <para style="q">
    <verse number="40" style="v" sid="JOB 38:40"/>عِ تَن نَن سُبٍ قِمَ عٍ مَ عٍ شَ كَامّ بَ؟<verse eid="JOB 38:40"/></para>
  <para style="q">
    <verse number="41" style="v" sid="JOB 38:41"/>شَشَيٍ فٌ، عٍ شَ دِيٍ نّ وَ مَ كٌورٍ مَ،</para>
  <para style="q" vid="JOB 38:41">عِ تَن نَن عٍ بَلٌمَ؟»<verse eid="JOB 38:41"/></para>
  <chapter eid="JOB 38"/>
  <chapter number="39" style="c" sid="JOB 39"/>
  <para style="s1">عَلَ شَ مَسٍنيِ قِرِن ندٍ عَيُبَ بّ</para>
  <para style="s2">«ندٍ مّينِمَ سُبٍيٍ مَ؟»</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 39:1"/>«عِ وُلَ عِ سِ دِ بَرِ تّمُي كٌلٌن فٍيَيٍ قَرِ؟</para>
  <para style="q" vid="JOB 39:1">عِ بَرَ شٍلِ تٌ دِ بَرِ رَ؟<verse eid="JOB 39:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 39:2"/>عِ عٍ شَ قُرِ مَشَنِن كِكٍ كْنتِ كٌلٌن</para>
  <para style="q" vid="JOB 39:2">بٍينُ عٍ دِ بَرِ وَشَتِ شَ عَ لِ؟<verse eid="JOB 39:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 39:3"/>عٍ نَ عٍ سَ، عٍ دِ بَرِ مَ،</para>
  <para style="q" vid="JOB 39:3">عَلَكٌ عٍ شَ قُلُن عٍ قُرِ شَ شْنّ مَ.<verse eid="JOB 39:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 39:4"/>عٍ شَ دِيٍ نَ مْ،</para>
  <para style="q" vid="JOB 39:4">عٍ كٍلِ عٍ نفَ شُن مَ، عٍ مُ قَ سْنْن.»<verse eid="JOB 39:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="JOB 39:5"/>«ندٍ لُوتِ بَشِ سٌقَلٍ مَ،</para>
  <para style="q" vid="JOB 39:5">عَ عَ رَبّحِن وُلَ عِ؟<verse eid="JOB 39:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 39:6"/>ﭑ تَن نَن وُلَ قِندِشِ عَ شْنيِ رَ</para>
  <para style="q" vid="JOB 39:6">ﭑ عَ لُ يِرٍ، قْشّ سُنبُشِ بّندّ رَ دّننَشّ.<verse eid="JOB 39:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 39:7"/>تَا شَ وُندُي مُ رَقَن عَ مَ،</para>
  <para style="q" vid="JOB 39:7">عَ مُ تِنمَ مِشِيٍ شَ عَ رَحّرّ.<verse eid="JOB 39:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 39:8"/>عَ وُلَ عِسَمَ حٌوفٍ قٍندٍ عَ بَلٌسٍ رَ.»<verse eid="JOB 39:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="JOB 39:9"/>«عِ نْمَ سّشّ نِنفٍ رَوَلِدٍ؟</para>
  <para style="q" vid="JOB 39:9">عَ كْي رَدَنفِمَ عِ شَ فْورّ كُي؟<verse eid="JOB 39:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 39:10"/>عِ نْمَ عَ شِرِدٍ سَرِ رَ،</para>
  <para style="q" vid="JOB 39:10">عَ شَ بْشِ بُشَ عِ بّ؟<verse eid="JOB 39:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 39:11"/>عِ عِ يِفِ سُشُمَ عَ سّنبّ فبٍ رَ؟</para>
  <para style="q" vid="JOB 39:11">عِ نْمَ عِ شَ وَلِ شُنفبٍيٍ تَشُدٍ عَ رَ؟<verse eid="JOB 39:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 39:12"/>عِ نْمَ عَ شّيدٍ شّ شَبّ، عَ شَ عِ مَلِ عِ شَ بَلٌي رَ سٌدٍ؟»<verse eid="JOB 39:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="JOB 39:13"/>«شْنِ مْولِ ندٍ نَ نَ نَشَن</para>
  <para style="q" vid="JOB 39:13">فَبُتٍنيِ دُنكٍيٍ عِبْنبْمَ سّيوّ كُي،</para>
  <para style="q" vid="JOB 39:13">كْنْ عٍ مُ تٌقَن فبٌنفبٌي فَبُتٍنيِيٍ بّ.<verse eid="JOB 39:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 39:14"/>عَ عَ شّلّيٍ سَمَ بْشِ مَ،</para>
  <para style="q" vid="JOB 39:14">عَ عٍ لُ مّيّنيِ بُن مَ عَلَكٌ وُيٍنيِ شَ لُ عٍ مَ،<verse eid="JOB 39:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 39:15"/>عَ مُ عَ مَحْشُن سُبٍ ندٍ نْمَ تِدٍ عٍ قَرِ، عٍ بُلَ.<verse eid="JOB 39:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 39:16"/>عَ مُ مّينِمَ عَ شَ دِيٍ مَ،</para>
  <para style="q" vid="JOB 39:16">عَ لُمَ عَلْ عَ فبٍ مُ عٍ رَ.<verse eid="JOB 39:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 39:17"/>عَ نَ مْولِ رَبَمَ</para>
  <para style="q" vid="JOB 39:17">بَرِ مَ عَلَ مُ لْننِ نُن شَشِلِ قَنيِ قِشِ عَ مَ.<verse eid="JOB 39:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 39:18"/>كْنْ عَ نَ عَ فِ قْلْ،</para>
  <para style="q" vid="JOB 39:18">عَ سٌي رَفِيٍ نُن سٌي لُمَ نّ عَ شَنبِ رَ.»<verse eid="JOB 39:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="JOB 39:19"/>«عِ تَن نَن سٌي سّنبّ قِمَ عَ مَ؟</para>
  <para style="q" vid="JOB 39:19">عِ تَن نَن عَ كْنيِ شَبٍيٍ رَكُيَمَ؟<verse eid="JOB 39:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 39:20"/>عِ تَن نَن عَ نِيَمَ عَ شَ نْ تُفَندٍ عَلْ كَتٌي،</para>
  <para style="q" vid="JOB 39:20">عَ بِرِن مَفَاشُ عَ شُي رَ؟<verse eid="JOB 39:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 39:21"/>عَ بْشِ عِبٌرٌنمَ عَ سَنيِ رَ،</para>
  <para style="q" vid="JOB 39:21">عَ حّلّشِنشِ عَ سّنبّ رَ.<verse eid="JOB 39:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 39:22"/>عَ مُ فَاشُمَ سٍسٍ يَ رَ،</para>
  <para style="q" vid="JOB 39:22">عَ مُ عَ مَفبِلٍنمَ سَنتِدّفّمَ يَ عِ.<verse eid="JOB 39:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 39:23"/>تَنبّيٍ نُن عٍ سَسٍ فبَكُشِ عَ مَ،<verse eid="JOB 39:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 39:24"/>عَ فبَتَشِ تُفَنمَ، عَ شُلُن عَ فِدٍ فٍرٍ يِرٍ.<verse eid="JOB 39:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 39:25"/>فٍرٍ سَرَ نَ قٍ،</para>
  <para style="q" vid="JOB 39:25">عَ تَن كٍلِمَ نّ قَ كٍرٍن نَ عَ فٍرٍ سٌ كِ مَ.»<verse eid="JOB 39:25"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="26" style="v" sid="JOB 39:26"/>«عِ شَ لْننِ بَرَ عَ نِيَ</para>
  <para style="q" vid="JOB 39:26">سّفّ شَ عَ حّرّ كٌورٍ مَ سِفَقٍ رَ يِرٍقَنيِ مَ؟<verse eid="JOB 39:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 39:27"/>عِ تَن نَن يَامَرِ قِمَ عَ مَ عَ شَ عَ تّي سَ يِرٍ عِتٍشِ؟<verse eid="JOB 39:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 39:28"/>كْي رَ، عَ يِفِيَمَ فّمّ لٌنفٌرِ رَ فٍيَيٍ قَرِ.</para>
  <para style="q" vid="JOB 39:28">مّننِ نَن قِندِشِ عَ بّ عَ مَكَنتَدٍ نَن نَ.<verse eid="JOB 39:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 39:29"/>عَ سُبٍيٍ تٌمَ نَ يِرٍ مَكُيٍ نّ،</para>
  <para style="q" vid="JOB 39:29">عَ بَلٌمَ نَشٍيٍ رَ.<verse eid="JOB 39:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="JOB 39:30"/>سُبٍ شِندٍ حْشُن عَ شَ دِيْرّيٍ بّ.</para>
  <para style="q" vid="JOB 39:30">بِنبِ لُ دّدّ عَ نَ مّننِ.»<verse eid="JOB 39:30"/></para>
  <chapter eid="JOB 39"/>
  <chapter number="40" style="c" sid="JOB 40"/>
  <para style="s1">عَلَ شَ مَسٍنيِ سَشَن ندٍ عَيُبَ بّ</para>
  <para style="s2">«ندٍ مُ لَمَ عَلَ رَ؟»</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 40:1"/>عَلَتَلَ مَن نَشَ عَ مَسٍن عَيُبَ بّ،<verse eid="JOB 40:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 40:2"/>«عِ تَن نَشَن عَلَ سّنبّ كَنيِ كَلَمُمَ،</para>
  <para style="q" vid="JOB 40:2">عِ سُو سَمَ عَ رَكِيتِدٍ؟</para>
  <para style="q" vid="JOB 40:2">شَ لْننِلَ نَ عِ تَن نَ،</para>
  <para style="q" vid="JOB 40:2">يَابِ ندٍ تِ يِ بِرِن مَ بَ.»<verse eid="JOB 40:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 40:3"/>عَيُبَ نَشَ عَلَتَلَ يَابِ،<verse eid="JOB 40:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 40:4"/>«مِشِ شُرِ دِ نَن ﭑ نَ.</para>
  <para style="q" vid="JOB 40:4">ﭑ تَن عِ يَابِمَ مُنسٍ رَ؟</para>
  <para style="q" vid="JOB 40:4">ﭑ بَرَ ﭑ دّ سُشُ ﭑ بّلّشّ رَ، ﭑ دُندُ يٍن.<verse eid="JOB 40:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 40:5"/>ﭑ وْيّن نّ كٍرٍن،</para>
  <para style="q" vid="JOB 40:5">ﭑ نَشَ وْيّن قِرِن.</para>
  <para style="q" vid="JOB 40:5">نَ شَنبِ، ﭑ مُ سٍسٍ سَمَ نَ قَرِ سْنْن.»<verse eid="JOB 40:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="JOB 40:6"/>عَلَ مَن نَشَ عَ مَسٍن عَيُبَ بّ تُرُننَادّ قٌيٍ كُي،<verse eid="JOB 40:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 40:7"/>«عِ عِ تَفِ شِرِ فبٍن عَلْ فبَنفبَلَنيِ،</para>
  <para style="q" vid="JOB 40:7">ﭑ شَ مَشْرِنيِ ندٍيٍ تِ عِ مَ، عِ شَ ﭑ يَابِ.<verse eid="JOB 40:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 40:8"/>عِ مُ لَشِ عَ رَ ﭑ مَ كِيتِ تِنشِن؟</para>
  <para style="q" vid="JOB 40:8">عِ وَ مَ نْندِ بَقٍ ﭑ يِ رَ نّ، عَ شَ لُ عِ تَن بّ؟<verse eid="JOB 40:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 40:9"/>عِ سّنبّ فبٌ عَلَ فبٍ بّ؟</para>
  <para style="q" vid="JOB 40:9">عِ شُي مَفَاشُ عَلْ عَ فبٍ؟<verse eid="JOB 40:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 40:10"/>نَ كُي، عِ عِ مَشِرِ نْرّ نُن شُننَكٍلِ رَ بَ،</para>
  <para style="q" vid="JOB 40:10">عِ شَ تٌقَن، عِ شَ عِ سّنبّ مَسٍن.<verse eid="JOB 40:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 40:11"/>عِ شَ عِ شَ شْنّ مَفَاشُشِ رَ مِنِ بَ،</para>
  <para style="q" vid="JOB 40:11">عِ يّتّ عِفبٌييٍ شُن نَكَنَ.<verse eid="JOB 40:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 40:12"/>عٍ بِرِن كُنتَن،</para>
  <para style="q" vid="JOB 40:12">مِشِ حَاشِيٍ عِفبَنتُ عٍ يِرٍ.<verse eid="JOB 40:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 40:13"/>بّندّ رَدِن عٍ بِرِن شُن نَ،</para>
  <para style="q" vid="JOB 40:13">عٍ بَلَن فَبُرِ كُي.<verse eid="JOB 40:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 40:14"/>نَ تّمُي ﭑ قَن يّتّ يَتِ عِ مَتْشْمَ نّ،</para>
  <para style="q" vid="JOB 40:14">بَرِ مَ عِ يّتّ سّنبّ بَرَ عِ رَكِسِ.»<verse eid="JOB 40:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="JOB 40:15"/>«مَلِ مَتٌ بَ عَ قَنيِ رَ،</para>
  <para style="q" vid="JOB 40:15">نَ سُبٍ مَفَاشُشِ ﭑ نَشَن دَاشِ</para>
  <para style="q" vid="JOB 40:15">عَلْ ﭑ عِ قَن دَاشِ كِ نَشّ.</para>
  <para style="q" vid="JOB 40:15">عَ حٌوفٍ دٌنمَ عَلْ نِنفٍ.<verse eid="JOB 40:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 40:16"/>عَ سّنبّ فبٍ نَ عَ فُنفُي نّ،</para>
  <para style="q" vid="JOB 40:16">سّنبّ مَلَنشِ عَ قُرِ كِرِ بُن.<verse eid="JOB 40:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 40:17"/>عَ شُلِ سّنبّ فبٌ عَلْ كٌندٍ بِلِ،</para>
  <para style="q" vid="JOB 40:17">عَ سَنيِ قَسّيٍ وُيَ، عٍ فَدَرَ.<verse eid="JOB 40:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 40:18"/>عَ شْرِيٍ لُشِ عَلْ يْشُي، شَ نَ مُ عَ رَ وُرٍ.<verse eid="JOB 40:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 40:19"/>عَلَ شَ دَالِسٍ قِسَمَنتٍ نَن عَ رَ،</para>
  <para style="q" vid="JOB 40:19">كْنْ عَ فَاشُمَ عَلَ شَ سَنتِدّفّمَ يَ رَ.<verse eid="JOB 40:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 40:20"/>عَ عَ بَلٌي قٍنمَ فٍيَيٍ كْن سُبٍ شَاحّيٍ يَ مَ.<verse eid="JOB 40:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 40:21"/>عَ شِمَ نِينِ بُن مَ،</para>
  <para style="q" vid="JOB 40:21">عَ عَ نْشُن دَبٌنيِيٍ كُي.<verse eid="JOB 40:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 40:22"/>عَ عَ مَلَبُمَ وُرِ بِلِيٍ نِينِ بُن مَ،</para>
  <para style="q" vid="JOB 40:22">نَشٍيٍ نَ دَبٌن دّ رَ.<verse eid="JOB 40:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 40:23"/>دَبٌنيِ يٍ شَ فبٌي مُ عَ مَفَاشُمَ.</para>
  <para style="q" vid="JOB 40:23">يُرُدّن شُرٍ نَ بَنبَرَن يّ، عَ مُ عَ تْورْ مَ.<verse eid="JOB 40:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 40:24"/>عَ يَ رَبِشِ نْمَ سُشُدٍ؟</para>
  <para style="q" vid="JOB 40:24">عَ نْمَ سُشُدٍ فَنتَنيِ رَ، عَ حْي شَ تُنبَ؟»<verse eid="JOB 40:24"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="25" style="v" sid="JOB 40:25"/>«عِ نْمَ سْحّ سُشُدٍ كْنيِ رَ؟</para>
  <para style="q" vid="JOB 40:25">عِ نْمَ عَ دّ شِرِدٍ، عِ عَ بَ يٍ شْورَ؟<verse eid="JOB 40:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 40:26"/>عِ نْمَ عَ حْي، شَ نَ مُ عَ رَ عَ دّ تُنبَدٍ،</para>
  <para style="q" vid="JOB 40:26">عِ لُوتِ سَ عَ مَ؟<verse eid="JOB 40:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="JOB 40:27"/>عَ عِ مَيَندِ مَ عِ شَ عَ قُلُن؟</para>
  <para style="q" vid="JOB 40:27">عَ هَيِ نَ وْيّنيِ حْشُنمّ مَ عَ قَلَقٍ رَ عِ بّ؟<verse eid="JOB 40:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="JOB 40:28"/>وٌ سَاتّ شِرِ مَ؟</para>
  <para style="q" vid="JOB 40:28">عَ قِندِ مَ عِ شَ كٌنيِ رَ عَ شَ سِمَيَ كُي؟<verse eid="JOB 40:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="JOB 40:29"/>عِ نْمَ بٍرٍدٍ عَ رَ عَلْ شْنِ دِ؟</para>
  <para style="q" vid="JOB 40:29">عِ نْمَ عَ شِرِدٍ، عَ قِندِ عِ شَ دِيٍ شَ بٍرٍ سٍ رَ؟<verse eid="JOB 40:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="JOB 40:30"/>عِ نْمَ عَ مَتِدٍ؟</para>
  <para style="q" vid="JOB 40:30">يُلّيٍ عَ عِتَشُنمَ عٍ بٌرٍ مَ؟<verse eid="JOB 40:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="JOB 40:31"/>عِ نْمَ عَ كِرِ مَسْشْدٍ تَنبّيٍ رَ؟</para>
  <para style="q" vid="JOB 40:31">عِ نْمَ عَ شُنيِ سْشْدٍ سْشْسٍ ندٍ رَ؟<verse eid="JOB 40:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="JOB 40:32"/>فٍرٍ تِ عَ بّ،</para>
  <para style="q" vid="JOB 40:32">نَ مُ نّيمُمَ عِ رَ.</para>
  <para style="q" vid="JOB 40:32">عِ مُ نَ عِقِرِنمَ سْنْن.»<verse eid="JOB 40:32"/></para>
  <chapter eid="JOB 40"/>
  <chapter number="41" style="c" sid="JOB 41"/>
  <para style="s1">عَلَ شَ مَسٍنيِ نَانِ ندٍ عَيُبَ بّ</para>
  <para style="s2">«عَلَ شَ دَالِسٍ سّنبّمَ»</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 41:1"/>«مِشِ مُ نْمَ عَ رَ،</para>
  <para style="q" vid="JOB 41:1">عَ شَ تٌي فبَنسَن قِندِ مَ فَاشُي نَن نَ.<verse eid="JOB 41:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 41:2"/>شَ مِشِ مُ سُو سَمَ عَ يَ رَ،</para>
  <para style="q" vid="JOB 41:2">ندٍ قَ نْمَ سُو سَدٍ ﭑ تَن يَ رَ؟<verse eid="JOB 41:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 41:3"/>ندٍ ﭑ دٌنِشِ سٍ ندٍ رَ ﭑ نَشَن نَفبِلٍنمَ عَ مَ؟</para>
  <para style="q" vid="JOB 41:3">دُنِحَ بِرِن قِندِشِ ﭑ فبٍ نَن نَ.<verse eid="JOB 41:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 41:4"/>ﭑ مُ نْمَ دُندُدٍ نَ سْحّ شَ قٍ مَ،</para>
  <para style="q" vid="JOB 41:4">عَ سَلٌنسٍيٍ سّنبّ فبٌ، عَ مَن تٌقَن.<verse eid="JOB 41:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 41:5"/>عَ بُرَ قّيرّ نَ ندٍ بّ؟</para>
  <para style="q" vid="JOB 41:5">ندٍ مُ فَاشُمَ عَ حِنيِيٍ يَ رَ؟<verse eid="JOB 41:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 41:6"/>ندٍ نْمَ عَ دّ رَبِدٍ؟</para>
  <para style="q" vid="JOB 41:6">عَ حِنيِ مَفَاشُشِيٍ عَ دّ كُي رَقٍشِ.<verse eid="JOB 41:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="JOB 41:7"/>شَلٍيٍ قَتُشِ عَ كِرِ مَ عَلْ سْورِ شَ وُرٍ لٍقَ،<verse eid="JOB 41:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="JOB 41:8"/>عٍ شّتّنشِ عٍ بٌرٍ رَ،</para>
  <para style="q" vid="JOB 41:8">قٌيٍ سٌدٍ يَتِ مُ نَ عٍ تَفِ<verse eid="JOB 41:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="JOB 41:9"/>عٍ قَتُشِ عٍ بٌرٍ مَ عَ قَنيِ رَ.<verse eid="JOB 41:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="JOB 41:10"/>عَ نَ حّنفِ سّنبّ رَ،</para>
  <para style="q" vid="JOB 41:10">يَنبّ نَن لُمَ مِنِ رَ،</para>
  <para style="q" vid="JOB 41:10">عَ يَيٍ قَن لُشِ عَلْ فّيسّفّ سٌفٍ.<verse eid="JOB 41:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="JOB 41:11"/>تّ يِرِيِرِ مِنِمَ عَ دّ عِ،</para>
  <para style="q" vid="JOB 41:11">عٍ قُلٍقُلٍيٍ نُ قَ يٍنسٍن يّ كُيٍ مَ.<verse eid="JOB 41:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="JOB 41:12"/>تُورِ ندٍ مِنِمَ عَ حْي،</para>
  <para style="q" vid="JOB 41:12">نَ لُشِ نّ عَلْ قِقَ نَشَن دْشْشِ تّ مَ، عَ سَتُنقٍ.<verse eid="JOB 41:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="JOB 41:13"/>عَ حّنفِ قِندِ مَ تّ رَ،</para>
  <para style="q" vid="JOB 41:13">تّ يِرِيِرِ نُ قَ مِنِ عَ دّ عِ.<verse eid="JOB 41:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="JOB 41:14"/>سّنبّ شُتُنشِ عَ كْنيِ رَ،</para>
  <para style="q" vid="JOB 41:14">بِرِن فَاشُمَ عَ يَ رَ.<verse eid="JOB 41:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="JOB 41:15"/>عَ كِرِ شْرْشْ، عَ سّنبّ فبٌ.<verse eid="JOB 41:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="JOB 41:16"/>عَ كَنكٍ لُشِ عَلْ فّمّ شُنفبٍ.<verse eid="JOB 41:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="JOB 41:17"/>عَ نَ تِ، لِمَنِيَ بَمَ نّ سّنبّمَيٍ يِ رَ،</para>
  <para style="q" vid="JOB 41:17">عٍ سّرّن، عٍ عٍ فِ.<verse eid="JOB 41:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="JOB 41:18"/>سَنتِدّفّمَ نَ دِن عَ رَ،</para>
  <para style="q" vid="JOB 41:18">عَ مُ عَ شَبَمَ.</para>
  <para style="q" vid="JOB 41:18">تَنبّ مْولِ يٌ مُ نَ نَشَن نْمَ عَ سْشْدٍ.<verse eid="JOB 41:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="JOB 41:19"/>وُرٍ لُشِ نّ عَ بّ عَلْ سّشّ،</para>
  <para style="q" vid="JOB 41:19">يْشُي لُ عَ بّ عَلْ وُرِ بْرْشِ.<verse eid="JOB 41:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="JOB 41:20"/>عَ مُ فَاشُمَ تَنبّيٍ يَ رَ،</para>
  <para style="q" vid="JOB 41:20">لَاتِ كُنِ لُمَ عَ بّ عَلْ مَالٍ لَفِ.<verse eid="JOB 41:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="JOB 41:21"/>فبٍندٍفٍلَ لُمَ عَ بّ عَلْ سّشّ،</para>
  <para style="q" vid="JOB 41:21">تَنبّ شُنفبٍ مَيٍلٍ عَ بّ.<verse eid="JOB 41:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="JOB 41:22"/>بّلّ شّحّنشِ ندٍ نُن تُنبٍيٍ نَ عَ قُرِ بُنيِ،</para>
  <para style="q" vid="JOB 41:22">نٍيٍ لُمَ بٌورَ تِرِندِن نَ نّ عَلْ سَرِ تٌ يِرٍ بُشَمَ.<verse eid="JOB 41:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="JOB 41:23"/>عَ بَا عِشُقُشُقُمَ عَلْ يٍ نّ سَتُنمَ،</para>
  <para style="q" vid="JOB 41:23">عَ دَبٌنيِ لُ عَلْ تُرٍ نّ سَتُنمَ.<verse eid="JOB 41:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="JOB 41:24"/>عَ نَ عَ حّرّ يٍ شْورَ،</para>
  <para style="q" vid="JOB 41:24">مْرْنيِ قِيشّ نَن لُمَ تٍ رَ عَ شَنبِ رَ.<verse eid="JOB 41:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="JOB 41:25"/>مَنفّ يٌ مُ عَ بّ دُنِحَ،</para>
  <para style="q" vid="JOB 41:25">عَ دَاشِ نّ، فَاشُي يٌ مُ عَ يِ.<verse eid="JOB 41:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="JOB 41:26"/>عَ عَ يَ رَفٌرٌ مَ نّ دَالِسٍ يّتّ عِفبٌي مَ،</para>
  <para style="q" vid="JOB 41:26">عَ قِندِشِ سُبٍيٍ بِرِن مَ مَنفّ نَن نَ.»<verse eid="JOB 41:26"/></para>
  <chapter eid="JOB 41"/>
  <chapter number="42" style="c" sid="JOB 42"/>
  <para style="s1">عَيُبَ شَ يَابِ قِرِن ندٍ نُن عَلَ شَ مَسٍنيِ دْنشْي</para>
  <para style="q">
    <verse number="1" style="v" sid="JOB 42:1"/>عَيُبَ نَشَ عَلَتَلَ يَابِ،<verse eid="JOB 42:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="JOB 42:2"/>«ﭑ بَرَ عَ كٌلٌن عِ نْمَ قٍ بِرِن نَ،</para>
  <para style="q" vid="JOB 42:2">سٍسٍ مُ نْمَ عِ حَنِفٍ كَنَدٍ.<verse eid="JOB 42:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="JOB 42:3"/>عِ عَ مَسٍن نّ عِ شَ مَسٍنيِ كُي،</para>
  <para style="q" vid="JOB 42:3">‹ندٍ نَ ﭑ مَ وَلِيٍ يَ عِسٌقٍ عَ شَ شَشِلِتَرٍ وْيّنيِيٍ رَ؟›</para>
  <para style="q" vid="JOB 42:3">عِ نْندِ، ﭑ بَرَ وْيّن عَ شَشِلِتَرٍ دَاشِ،</para>
  <para style="q" vid="JOB 42:3">ﭑ مُ نُ عِ شَ كَابَنَكٌي قَهَامُشِ.</para>
  <para style="q" vid="JOB 42:3">عِ شَ قٍ رَبَشِيٍ فبٌ ﭑ شُنيِ بّ.<verse eid="JOB 42:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="JOB 42:4"/>عِ مَن عَ مَسٍن نّ،</para>
  <para style="q" vid="JOB 42:4">‹عِ تُلِ مَتِ ﭑ نَ، ﭑ شَ وْيّن.</para>
  <para style="q" vid="JOB 42:4">ﭑ شَ مَشْرِنيِ ندٍيٍ تِ عِ مَ،</para>
  <para style="q" vid="JOB 42:4">عِ شَ ﭑ يَابِ.›<verse eid="JOB 42:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="JOB 42:5"/>عَ سِنفٍ ﭑ نُ عِ شَ قٍ عِقَلّ نَن مّمَ،</para>
  <para style="q" vid="JOB 42:5">كْنْ يَكْسِ، ﭑ بَرَ سٌ نَ قٍ كُي.<verse eid="JOB 42:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="JOB 42:6"/>ﭑ عَ كٌلٌنشِ نَ نَن مَ ﭑ نَشَن نَبَشِ عَ مُ قَن.</para>
  <para style="q" vid="JOB 42:6">ﭑ بَرَ تُوبِ،</para>
  <para style="q" vid="JOB 42:6">ﭑ بَرَ ﭑ مَفٌرٌ بّندّ،</para>
  <para style="q" vid="JOB 42:6">ﭑ تّ شُبٍ مَسٌ ﭑ مَ سُننُنيِ كُي.»<verse eid="JOB 42:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JOB 42:7"/>عَلَتَلَ تٌ فّ عَ شَ مَسٍنيِ تِدٍ عَيُبَ بّ، عَ نَشَ عَ مَسٍن عٍلِقَسِ تٍمَنكَ بّ، «ﭑ بَرَ شْنْ عِ تَن نُن عِ بٌورٍ قِرِنيِيٍ مَ، بَرِ مَ وٌ مُ نْندِ قَلَشِ ﭑ مَ قٍ رَ، عَلْ ﭑ مَ كٌنيِ عَيُبَ عَ رَبَشِ كِ نَشّ. <verse eid="JOB 42:7"/><verse number="8" style="v" sid="JOB 42:8"/>نَ كُي وٌ نِنفٍ نُن يّشّي كٌنتٌنيِ سٌلٌقٍرٍ بَ سّرّشّ فَن دَاشِ رَ وٌ يّتّ بّ. وٌ سَ عَيُبَ قٍن، عَ شَ دُبَ وٌ بّ. وٌ مُ نْندِ قَلَشِ ﭑ مَ قٍ رَ عَلْ عَيُبَ عَ رَبَشِ كِ نَشّ، كْنْ ﭑ مُ وٌ حَشَنكَتَمَ وٌ شَ دَشُحَ مَ عَيُبَ شَ قٍ رَ.»<verse eid="JOB 42:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JOB 42:9"/>عٍلِقَسِ تٍمَنكَ، بِلِدَدَ سُوشَكَ، نُن سٌقَرَ نَامَكَ نَشَ قٍ بِرِن نَبَ عَلْ عَلَتَلَ عَ يَمَرِ عٍ رَ كِ نَشّ. عَلَتَلَ نَشَ عَيُبَ شَ دُبّ سُشُ. <verse eid="JOB 42:9"/><verse number="10" style="v" sid="JOB 42:10"/>عَيُبَ تٌ فّ دُبَدٍ عَ بٌورٍيٍ بّ، عَلَتَلَ نَشَ عَ هَرِفٍ بِرِن نَفبِلٍن عَ مَ. عَ مَن نَشَ نَ هَرِفٍ شُن مَسَ دْشْ قِرِن دَنفِقٍ عَ سِنفٍ رَ.<verse eid="JOB 42:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JOB 42:11"/>عَيُبَ شُنيَيٍ نُن عَ تَارَيٍ نُن عَ كٌلٌنمَ بِرِن نَشَ قَ عَ شّيبُدٍ عَ شْنيِ، عٍ عٍ دّفٍ يِرٍ كٍرٍن. عٍ نَشَ عَ نُ تْورْ سَ، عٍ عَ كُنقَ بَ تْورّ شَ قٍ رَ عَلَتَلَ نُ بَرَ نَشَن دْشْ عَ مَ. كَنكَن نَشَ كْبِرِ كٌلٍ كٍرٍن نُن شُرُندّ شّيمَ دَاشِ كٍرٍن قِ عَ مَ.<verse eid="JOB 42:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JOB 42:12"/>عَلَتَلَ نَشَ بَرَكّ سَ عَيُبَ دَنفِقٍ عَ سِنفٍ رَ. عَ نَشَ يّشّي وُلُ قُ نُن نَانِ سْتْ، حْشْمّ وُلُ سٍننِ، نِنفٍ وُلُ كٍرٍن، نُن سٌقَلٍ وُلُ كٍرٍن. <verse eid="JOB 42:12"/><verse number="13" style="v" sid="JOB 42:13"/>عَ نَشَ دِ شّمّ سٌلٌقٍرٍ نُن دِ فِنّ سَشَن سْتْ. <verse eid="JOB 42:13"/><verse number="14" style="v" sid="JOB 42:14"/>عَ شَ دِ فِنّ سِنفٍ نُ شِلِ نّ يٍمِمَ، عَ قِرِن ندٍ كٍسِيَ، عَ سَشَن ندٍ كٍرٍنَثُكُ. <verse eid="JOB 42:14"/><verse number="15" style="v" sid="JOB 42:15"/>فِنّ يٌ مُ نُ نَ نَ بْشِ مَ نَشَن نُ تٌقَن عَيُبَ شَ دِيٍ بّ. عٍ بَبَ نَشَ كّ قِ عٍ قَن مَ، عَلْ عَ رَبَشِ كِ نَشّ عٍ مَاشّمّيٍ بّ.<verse eid="JOB 42:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JOB 42:16"/>نَ دَنفِ شَنبِ، حّ كّمّ حّ تٌنفٌ نَانِ نَشَ سَ عَيُبَ شَ سِمَيَ شُن مَ. عَ نَشَ عَ شَ دِيٍ تٌ، عَ شَ مَمَدِيٍ، عَ تٌلٌبِتّيٍ، نُن عَ تٌلٌنتٌلٌنيِيٍ. <verse eid="JOB 42:16"/><verse number="17" style="v" sid="JOB 42:17"/>عَيُبَ شَ سِمَيَ كَمَلِشِ نّ عَ قَنيِ رَ، عَ قَ لَاشِرَ.<verse eid="JOB 42:17"/></para>
  <chapter eid="JOB 42"/>
</usx>
