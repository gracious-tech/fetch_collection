<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="GAL" style="id"/>
  <para style="h">فَلَتِ</para>
  <para style="toc1">عَلَ شَ مَسٍنيِ عَننَبِ ثْلُ نَشَن سّبّ فَلَتِ دَنشَنِيَتْي حَمَ مَ</para>
  <para style="toc2">فَلَتِ</para>
  <para style="mt">عَلَ شَ مَسٍنيِ</para>
  <para style="mt">عَننَبِ ثْلُ نَشَن سّبّ</para>
  <para style="mt">فَلَتِ دَنشَنِيَتْي حَمَ مَ</para>
  <para style="imt">مَسٍنيِ ندٍ يِ كِتَابُي شَ قٍ رَ</para>
  <para style="ip">يِ كِتَابُي قِندِشِ بَتَاشّ نَن نَ عَلَ شَ شّيرَ ثْلُ نَشَن سّبّ دَنشَنِيَتْي حَمَ مَ، نَشٍيٍ نُ سَبَتِشِ فَلَتِ بْشِ مَ. تّمُي دَنفِشِ، ثْلُ نُ بَرَ كَوَندِ تِ نَا، عَلَكٌ مِشِيٍ شَ دَنشَنِيَ عِسَ مَ. نَ بِرِن سّبّشِ عِسَ شَ شّيرَيٍ شَ تَرُشُي كُي، سٌرَ ١٣ نُن ١٤.</para>
  <para style="ip">عِسَ شَ وَلِ تٌ قْلْ عِسِرَيِلَ بْشِ مَ، دَنشَنِيَتْي سِنفٍيٍ يُوِقِيٍ نَن نُ فبٌ عٍ يَ مَ. يُوِقِ شِلِ بَ، عِسِرَيِلَ شِلِ بَ، بْنسْي كٍرٍن نَن شِلِ عَ رَ. عٍ نَشَ لَ عَ رَ عَ عِسَ نَن قِندِشِ عَلَ شَ مِشِ سُفَندِشِ رَ، عٍ شَ نَمِحْنمّيٍ نَشَن شَ قٍ مَسٍن عٍ شَ كِتَابُي كُي. عٍ مُ عِسَ شَ سّرِيّ تٌنفٌشِ عَلْ دِينّ نّينّ، بَرِ مَ عٍ عَ تٌشِ كِ نَشّ، عِسَ شَ سّرِيّ بَرَ يُوِقِيٍ شَ دِينّ رَكَمَلِ، عَلْ عَلَ نُ بَرَ عَ مَسٍن كِ نَشّ. نَ كُي، عٍ تٌ قِندِ عِسَيَنكَيٍ رَ، عٍ مُ عٍ شَ دِينّ سّرِيّ رَبّحِن نَشَن نُ سّبّشِ تَوُرٍتَ مُنسَ نُن يَبُرَ دَوُدَ كُي. عٍ نَشَ عِسَ شَ سّرِيّ سَ سّرِيّ بٌورٍ قَرِ.</para>
  <para style="ip">نَ سٍسٍ مُ نُ قِندِشِ قٍ شْرْشْي رَ نَ كَوَندِ نُ تِمَ تّمُي نَشّ يُوِقِيٍ نَن فبَنسَن بّ، كْنْ عِسَ شَ شّيرَيٍ تٌ نَ مَسٍنيِ كَوَندِ سِ فبّتّيٍ بّ، قٍ ندٍيٍ نَشَ مِنِ. سِ فبّتّيٍ تَن تٌ قِندِ عِسَيَنكَيٍ رَ، عٍ تَن مُ نُ تِنشِ يُوِقِيٍ شَ نَامُنيِيٍ شَ سَ عِسَ شَ سّرِيّ قَرِ، بَرِ مَ عِسَ شَ سّرِيّ نُ بَرَ عٍ وَ سَ.</para>
  <para style="ip">نَ كُي، يُوِقِ عِسَيَنكَ ندٍيٍ نَشَ سِ فبّتّ عِسَيَنكَيٍ شِلِ كَنَ عٍ شَ سُننَتَرٍيَ شَ قٍ رَ. عٍ نَشَ عَ قَلَ عَ عِسَيَنكَ نَشَن مُ سُننَشِ، عَ مُ فّشِ كِسِ سْتْدٍ. ثْلُ تٌ نَ شَشِلِ مّ، عَ نَشَ نَ قٍ مَتَندِ، عَ قَلَقٍ رَ شَ كِسِ سْتْمَ عِسَ شَ سّرّشّ سَابُي نَن نَ، مِشِ هَيِ مُ نَ سُننّ مَ كِسِ شَ قٍ رَ. عَ مُ عَ قَلَ سُننّ مُ قَن. عَ عَ قَلَ نّ سُننّ، شَ نَ مُ عَ رَ يَامَرِ فبّتّ، عَ مُ نْمَ مِشِ رَكِسِدٍ. عِسَ شَ سّرّشّ نَن فبَنسَن نْمَ نَ رَبَدٍ.</para>
  <para style="ip">نَ فَلَنبُي نَشَن سٌ يُوِقِ عِسَيَنكَيٍ نُن سِ فبّتّيٍ عِسَيَنكَيٍ تَفِ، عَ نْمَ شَشِلِ فبٍفبٍ قِدٍ وٌن قَن مَ. دِينّ قٍيٍ نَ نَ، عَ لَنمَ وٌن شَ نَشٍيٍ رَبَ، كْنْ عٍ مُ وٌن نَكِسِمَ. نَامُنيِ ندٍيٍ نَ نَ، وٌن نْمَ نَشٍيٍ رَبَدٍ، كْنْ عَ مُ لَنمَ وٌن شَ عٍ قِندِ تٍكُ رَ كِسِ شَ قٍ رَ. نَ بِرِن تَفِ رَ سَقٍ ندٍدِ شْرْشْ، كْنْ عَلَ شَ كِتَابُييٍ نْمَ لْننِ قِدٍ وٌن مَ نٍيٍ شَ قٍ رَ.</para>
  <para style="ip">بَقٍ نَ قٍ رَ، عَننَبِ ثْلُ شَ كِتَابُي فَلَتِ دَنشَنِيَتْييٍ بّ، عَ مَن دَنشَنِيَتْي حّرّ كِ مَسٍنمَ وٌن بّ. شَنُنتٍيَ نَن قِندِشِ عِسَيَنكَيٍ شَ يَامَرِ سِنفٍ رَ. عَلَ شَشِلِ سّنِيّنشِ، نَشَن سَبَتِشِ دَنشَنِيَتْي بْحّ كُي، نَ نَن عَ رَحّرّ مَ عَلَ شَ كِرَ شْن مَ. نَ تِدٍ فبٌ، بَرِ مَ شَ نَ مُ عَ رَ سٍنتَنّ قٍ بِرِن نَبَمَ نّ عَلَكٌ عَ شَ عَ رَحّرّ كِرَ فبّتّ شْن مَ، نَشَن قِندِشِ يُنُبِ كِرَ رَ. عَلَ شَ وٌن نَتَنفَ نَ مَ. عَمِنَ.</para>
  <para style="imte">عَلَ شَ مَسٍنيِ</para>
  <para style="imte">عَننَبِ ثْلُ نَشَن سّبّ</para>
  <para style="imte">فَلَتِ دَنشَنِيَتْي حَمَ مَ</para>
  <para style="cl">سٌرَ</para>
  <chapter number="1" style="c" sid="GAL 1"/>
  <para style="s">شّيبُي</para>
  <para style="p">
    <verse number="1‏-2" style="v" sid="GAL 1:1-2"/>ﭑ تَن ثْلُ نُن ﭑ نفَشَكٍرٍنيِيٍ، مُشُ بَرَ دَنشَنِيَتْي حَمَيٍ شّيبُ نَشٍيٍ نَ فَلَتِ بْشِ مَ. مِشِ يٌ مُ ﭑ شّيشِ. عَلَ شَ مِشِ سُفَندِشِ عِسَ نُن بَبَ عَلَ نَشَن عَ رَكٍلِشِ قَشّ مَ، عٍ تَن نَن ﭑ شّيشِ. <verse eid="GAL 1:1-2"/><verse number="3" style="v" sid="GAL 1:3"/>وٌن بَبَ عَلَ نُن وٌن مَرِفِ عِسَ، عَلَ شَ مِشِ سُفَندِشِ، عٍ شَ هِننّ نُن بْحّسَ قِ وٌ مَ. <verse eid="GAL 1:3"/><verse number="4" style="v" sid="GAL 1:4"/>عِسَ عَ يّتّ بَشِ سّرّشّ رَ وٌن مَ يُنُبِيٍ شَقَرِقٍ نَن نَ، عَ شَ وٌن نَتَنفَ يِ وَشَتِ حَاشِ مَ، عَلْ وٌن بَبَ عَلَ وَ مَ عَ شْن مَ كِ نَشّ. <verse eid="GAL 1:4"/><verse number="5" style="v" sid="GAL 1:5"/>تَنتُي نَ عَلَ بّ عَبَدَن. عَمِنَ.<verse eid="GAL 1:5"/></para>
  <para style="s">فَلَتِكَيٍ فبِلٍنقٍ عَلَ شَ كِرَ قْشْ رَ</para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 1:6"/>ﭑ دّ بَرَ عِشَرَ وٌ تٌ فبِلٍنقٍ وٌ شِلِمَ قْشْ رَ يِ عِكْرّشِ رَ، نَشَن بَرَ وٌ شِلِ عَ شَ مِشِ سُفَندِشِ شَ هِننّ سَابُي رَ. وٌ نَ بِرَقٍ مَسٍنيِ فبّتّ نَن قْشْ رَ، <verse eid="GAL 1:6"/><verse number="7" style="v" sid="GAL 1:7"/>نَشَن مُ قِندِشِ مَسٍنيِ قَنيِ رَ. مِشِ ندٍيٍ وَ مَ وٌ شَشِلِ عِقُقٍ، عٍ شَ عَلَ شَ مِشِ سُفَندِشِ شَ شِبَارُ قَنيِ مَقِندِ.<verse eid="GAL 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 1:8"/>كْنْ شَ عَ سَ لِ مُشُ تَن، شَ نَ مُ عَ رَ عَلَ شَ مَلٍكّ ندٍ نَشَ مَسٍنيِ تِ وٌ بّ، نَشَن مُ لَنشِ نَ مَسٍنيِ قَنيِ مَ نَشَن مَسٍنشِ وٌ بّ عَ سِنفٍ رَ، دَنكَرِ نَ نَ كَنيِ بّ. <verse eid="GAL 1:8"/><verse number="9" style="v" sid="GAL 1:9"/>ﭑ شَ فبِلٍن نَ مَ عَ قِرِن ندٍ. شَ مِشِ يٌ قَ مَسٍنيِ ندٍ تِدٍ وٌ بّ، نَشَن مُ لَنشِ نَ مَسٍنيِ قَنيِ مَ نَشَن مَسٍنشِ وٌ بّ عَ سِنفٍ رَ، دَنكَرِ نَ نَ كَنيِ بّ.<verse eid="GAL 1:9"/></para>
  <para style="s">ثْلُ شَ شّيرَيَ</para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 1:10"/>نَ كُي، ﭑ نَ ندٍ سَفٌ رَبَقٍ، عِبُنَدَ مَ بَ كَ عَلَ؟ وٌ حْشْ عَ مَ عَ ﭑ وَ مَ عَدَ مَدِ سَفٌ نَن نَبَقٍ؟ شَ نَ نَ عَ رَ نُ، ﭑ مُ قِندِ مَ عَلَ شَ مِشِ سُفَندِشِ شَ كٌنيِ رَ. <verse eid="GAL 1:10"/><verse number="11" style="v" sid="GAL 1:11"/>ﭑ نفَشَكٍرٍنيِيٍ، ﭑ شَ عَ قَلَ وٌ بّ عَ ﭑ شِبَارُ قَنيِ نَشَن عِبَمَ عَ مُ قَتَنشِ عَدَ مَ شَشِلِ شَ رَ. <verse eid="GAL 1:11"/><verse number="12" style="v" sid="GAL 1:12"/>ﭑ مُ عَ سْتْ مِشِ شَ رَ. مِشِ يٌ مُ ﭑ شَرَنشِ عَ رَ. عَلَ شَ مِشِ سُفَندِشِ عِسَ يَتِ نَن عَ مَسٍنشِ ﭑ بّ.<verse eid="GAL 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 1:13"/>وٌ بَرَ عَ مّ عَ سِنفٍ ﭑ نُ بِرَشِ يُوِقِيٍ شَ دِينّ قْشْ رَ سّنبّ رَ كِ نَشّ. ﭑ نُ عَلَ شَ دَنشَنِيَتْي حَمَيٍ حَشَنكَتَمَ نّ عَ حَاشِ رَ عَلَكٌ ﭑ شَ عٍ سْنتْ. <verse eid="GAL 1:13"/><verse number="14" style="v" sid="GAL 1:14"/>ﭑ شَرَنيِ نَشَن نَبَشِ يُوِقِيٍ شَ دِينّ كُي، عَ دَنفِ ﭑ بٌورٍيٍ شَ شَرَنيِ رَ. ﭑ نُ بِرَ مَ ﭑ بٍنبَيٍ شَ نَامُنيِيٍ قْشْ رَ سّنبّ نَن نَ.<verse eid="GAL 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 1:15"/>كْنْ عَلَ نُ بَرَ ﭑ سُفَندِ كَقِ ﭑ بَرِ تّمُي. عَ نَشَ ﭑ شِلِ عَ شَ هِننّ رَ، <verse eid="GAL 1:15"/><verse number="16" style="v" sid="GAL 1:16"/>عَ قَ عَ شَ دِ مَسٍن ﭑ بّ، عَلَكٌ ﭑ شَ عَ شَ قٍ كَوَندِ تِ سِ فبّتّيٍ تَفِ. عَ تٌ ﭑ شِلِ نَ مَ، ﭑ مُ مَرَ سِ قٍن مِشِ يٌ رَ، <verse eid="GAL 1:16"/><verse number="17" style="v" sid="GAL 1:17"/>ﭑ مُ سِفَ دَرِ سَلَمُ مِشِيٍ يِرٍ نَشٍيٍ سِنفٍ قِندِ عِسَ شَ شّيرَيٍ رَ ﭑ تَن بّ. ﭑ نَشَ سِفَ كٍرٍن نَ عَرَبُ بْشِ مَ. نَ دَنفِ شَنبِ ﭑ نَشَ فبِلٍن دَ مَسِ تَا كُي.<verse eid="GAL 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 1:18"/>حّ سَشَن تٌ دَنفِ، ﭑ نَشَ سِفَ دَرِ سَلَمُ، عَلَكٌ ﭑ شَ ثِيّرِ كٌلٌن. ﭑ نَشَ لُ عَ شْنيِ شِ قُ نُن سُولِ. <verse eid="GAL 1:18"/><verse number="19" style="v" sid="GAL 1:19"/>ﭑ مُ عِسَ شَ شّيرَ فبّتّ تٌ نَ تّمُي، قٌ عِسَ شُنيَ يَكِ. <verse eid="GAL 1:19"/><verse number="20" style="v" sid="GAL 1:20"/>ﭑ شَ عَ قَلَ وٌ بّ عَلَ يَ شْرِ، ﭑ نَشَن سّبّقٍ وٌ مَ، وُلٍ يٌ مُ نَ عَ كُي.<verse eid="GAL 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 1:21"/>نَ حّرّ دَنفِ شَنبِ، ﭑ نَشَ سِفَ سِرِيَ نُن سِلِسِ بْشِ مَ. <verse eid="GAL 1:21"/><verse number="22" style="v" sid="GAL 1:22"/>عِسَيَنكَ حَمَيٍ نَشٍيٍ نُ نَ يُدَيَ، نٍيٍ مُ نُ ﭑ كٌلٌنشِ نَ تّمُي، <verse eid="GAL 1:22"/><verse number="23" style="v" sid="GAL 1:23"/>كْنْ عٍ نُ بَرَ عَ مّ عَ مِشِ نَشَن نُ عٍ تْورْ مَ، عَ عَ بَرَ قِندِ دَنشَنِيَ كَوَندِلَ رَ. «سِنفٍ عَ نُ وَ مَ نَ دَنشَنِيَ شُن نَكَنَقٍ، كْنْ يَكْسِ عَ نَ عَ كَوَندِقٍ.» <verse eid="GAL 1:23"/><verse number="24" style="v" sid="GAL 1:24"/>نَ كُي، عٍ نَشَ عَلَ مَتْشْ ﭑ مَ قٍ رَ.<verse eid="GAL 1:24"/></para>
  <chapter eid="GAL 1"/>
  <chapter number="2" style="c" sid="GAL 2"/>
  <para style="s">ثْلُ نُن عِسَ شَ شّيرَيٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 2:1"/>حّ قُ نُن نَانِ تٌ دَنفِ كٍلِقٍ نَ بِيَاسِ سِنفٍ مَ، ﭑ مَن نَشَ فبِلٍن دَرِ سَلَمُ. بَرَنَبَسِ نُن تِتٌ نُ نَ ﭑ قْشْ رَ. <verse eid="GAL 2:1"/><verse number="2" style="v" sid="GAL 2:2"/>عَلَ نُ بَرَ عَ مَسٍن ﭑ بّ ﭑ شَ سِفَ نَا عَلَكٌ ﭑ شَ دّنتّفّ سَ عٍ بّ ﭑ شِبَارُ قَنيِ نَشَن عِبَمَ سِ فبّتّيٍ تَفِ. ﭑ مُ نَ دّنتّفّ سَ عٍ بِرِن شَ بّ، قٌ دَنشَنِيَتْي كُنتِفِيٍ، بَرِ مَ ﭑ مُ نُ وَ مَ ﭑ مَ وَلِ شُن شَ رَكَنَ.<verse eid="GAL 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GAL 2:3"/>كْنْ هَلِ تِتٌ فِرّكِكَ نَشَن نُ نَ ﭑ قْشْ رَ، عٍ مُ عَ كَرَشَن عَ شَ سُننَ. <verse eid="GAL 2:3"/><verse number="4" style="v" sid="GAL 2:4"/>مِشِ سُننَقٍ نُ بَرَ قِندِ حْشْنسْسْي رَ مُشُ تَفِ، بَرِ مَ مِشِ ندٍ نَشٍيٍ مُ قِندِشِ دَنشَنِيَتْييٍ رَ، نٍيٍ نَشَ سٌ مُشُ يَ مَ فُندٌ كُي. عٍ نُ وَ مَ وٌن مَ شْرّيَ نَن نَبّنقٍ، عَلَ شَ مِشِ سُفَندِشِ عِسَ نَشَن قِشِ وٌن مَ، عَلَكٌ وٌن مَن شَ فبِلٍن كٌنيِيَ كُي. <verse eid="GAL 2:4"/><verse number="5" style="v" sid="GAL 2:5"/>كْنْ مُشُ مُ تِن نَ شَشِلِ رَ قٍقٍ مَ، عَلَكٌ وٌ نَشَ بَ عِسَ شَ نْندِ كِرَ شْن مَ.<verse eid="GAL 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 2:6"/>ﭑ مُ ﭑ شَشِلِ تِشِ مِشِيٍ رَ حَمَ بِرَشِ نَشٍيٍ قْشْ رَ، بَرِ مَ عَلَ مُ مِشِ يٌ رَقِسَمَ عَ بٌورٍ بّ. عٍ تَن مُ سٍسٍ سَ ﭑ مَ مَسٍنيِ قَرِ. <verse eid="GAL 2:6"/><verse number="7" style="v" sid="GAL 2:7"/>عٍ نَشَ عَ تٌ عَلَ نَن نَ شّيرَيَ تَشُشِ ﭑ نَ، ﭑ شَ عِسَ شَ شِبَارُ قَنيِ عِبَ سِ فبّتّيٍ بّ، عَلْ ثِيّرِ عَ رَبَمَ يُوِقِيٍ بّ كِ نَشّ. <verse eid="GAL 2:7"/><verse number="8" style="v" sid="GAL 2:8"/>عَلَ نَشَن ثِيّرِ شّي عَ شَ وَلِ رَبَدٍ يُوِقِيٍ تَفِ، عَ تَن نَن ﭑ قَن شّي عَ شَ وَلِ رَبَدٍ سِ فبّتّيٍ تَفِ. <verse eid="GAL 2:8"/><verse number="9" style="v" sid="GAL 2:9"/>يَكِ، ثِيّرِ، نُن يَيَ نَشٍيٍ قِندِشِ كُنتِفِ شُنفبٍيٍ رَ دَنشَنِيَتْييٍ تَفِ، عٍ نَشَ ﭑ نُن بَرَنَبَسِ رَ سّنّ عَ نفَشَكٍرٍن كِ مَ عٍ تٌ عَ كٌلٌن عَلَ هِننّشِ ﭑ نَ كِ نَشّ. عٍ نَشَ لَن عَ مَ عَ مُشُ شَ شّيرَيَ رَبَ سِ فبّتّيٍ تَفِ، عٍ تَن قَن شَ عَ رَبَ يُوِقِيٍ تَفِ. <verse eid="GAL 2:9"/><verse number="10" style="v" sid="GAL 2:10"/>عٍ مَن نَشَ مُشُ مَيَندِ مُشُ شَ سٍتَرٍيٍ مَلِ مُشُ شَ وَلِ كُي. قٍ نَن نَ كِ ﭑ نُ وَ مَ نَشَن نَبَقٍ عَ قَنيِ رَ.<verse eid="GAL 2:10"/></para>
  <para style="s">يُوِقِيٍ نُن سِ فبّتّيٍ</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 2:11"/>ثِيّرِ تٌ قَ عَنتِيْكِ، ﭑ نَشَ عَ مَتَندِ، بَرِ مَ عَ نُ بَرَ تَنتَن. <verse eid="GAL 2:11"/><verse number="12" style="v" sid="GAL 2:12"/>بٍينُن يَكِ شَ مِشِ ندٍيٍ شَ سِفَ عَ يِرٍ، عَ نُ عَ دّفٍمَ عَ نُن سِ فبّتّيٍ. كْنْ عٍ تٌ عَ شْنيِ لِ، عَ نَشَ فبِلٍن مِشِيٍ قْشْ رَ نَشٍيٍ قِندِشِ سِ فبّتّيٍ رَ. عَ نُ بَرَ فَاشُ يَكِ شَ مِشِيٍ يَ رَ، بَرِ مَ عٍ نُ لَشِ عَ رَ عَ دَنشَنِيَتْييٍ لَنشِ نّ عٍ شَ سُننَ. <verse eid="GAL 2:12"/><verse number="13" style="v" sid="GAL 2:13"/>يُوِقِ فبّتّيٍ نَشَ بِرَ عَ شَ قِلَنكَقُيحَ قْشْ رَ، هَن عٍ نَشَ بَرَنَبَسِ قَن نَتَنتَن.<verse eid="GAL 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GAL 2:14"/>ﭑ تٌ عٍ شَ تِنشِنتَرٍيَ تٌ، نَشَن مُ لَنشِ عَلَ شَ نْندِ مَ، ﭑ نَشَ عَ قَلَ ثِيّرِ بّ عٍ بِرِن يَ شْرِ، «هَلِ عِ تٌ قِندِشِ يُوِقِ رَ، عِ نَ حّرّقٍ سِ فبّتّيٍ شَ نَامُنيِ كِ نَن مَ، نَشَن مُ قِندِ يُوِقِ شَ نَامُنيِ رَ. مُنقٍ رَ عِ عَ قَلَمَ سِ فبّتّيٍ بّ عٍ شَ حّرّ يُوِقِيٍ حّرّ كِ مَ؟»<verse eid="GAL 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 2:15"/>وٌن تَن نَشٍيٍ بَرِشِ يُوِقِيَ كُي، نَشٍيٍ مُ قِندِشِ يُنُبِتْييٍ رَ سِ فبّتّيٍ تَفِ، <verse eid="GAL 2:15"/><verse number="16" style="v" sid="GAL 2:16"/>وٌن عَ كٌلٌن مِشِ يٌ مُ نْمَ عَلَ شَ سّرِيّ بِرِن نَبَتُدٍ، عَ قَ لُ عَ مُ تَنتَن نَ شَ عَ قِندِ تِنشِنتْي رَ. عَ قِندِ مَ تِنشِنتْي رَ عَ تٌ دَنشَنِيَشِ عَلَ شَ مِشِ سُفَندِشِ عِسَ مَ. نَ كُي، وٌن بَرَ دَنشَنِيَ عَلَ شَ مِشِ سُفَندِشِ عِسَ مَ، عَلَكٌ وٌن شَ تِنشِن نَ دَنشَنِيَ سَابُي رَ. وٌن مُ نْمَ عَلَ شَ سّرِيّ بِرِن نَتِنمّدٍ، هَن وٌن شَ قِندِ تِنشِنتْييٍ رَ. مِشِ يٌ مُ نْمَ عَلَ شَ سّرِيّ بِرِن نَتِنمّدٍ، هَن عَ قَ قِندِ تِنشِنتْي رَ.<verse eid="GAL 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 2:17"/>شَ وٌن نَ تِنشِنيِ قٍنقٍ عَلَ شَ مِشِ سُفَندِشِ سَابُي رَ، وٌن قَ يُنُبِ ندٍ رَبَ، نَ عَ مَسٍنمَ يُنُبِ رَقَن عَلَ شَ مِشِ سُفَندِشِ مَ؟ عَستْقُلَهِ. <verse eid="GAL 2:17"/><verse number="18" style="v" sid="GAL 2:18"/>ﭑ مُ لَمَ عَ رَ سْنْن ﭑ نْمَ عَلَ شَ يَامَرِ بِرِن نَتِنمّدٍ، هَن ﭑ شَ قِندِ تِنشِنتْي رَ. شَ عَ سَ لِ ﭑ بَرَ فبِلٍن نَ شَشِلِ مَ، نَ مُ قِندِ عَلَ شَ سّرِيّ رَ. <verse eid="GAL 2:18"/><verse number="19" style="v" sid="GAL 2:19"/>ﭑ تٌ عَ تٌ ﭑ مُ نْمَ عَلَ شَ سّرِيّ بِرِن نَتِنمّدٍ، ﭑ نَشَ نَ شَشِلِ لُ نَ، عَلَكٌ ﭑ مَ حّرّ كِ قَنيِ شَ قِندِ تَنتُي رَ عَلَ بّ. <verse eid="GAL 2:19"/><verse number="20" style="v" sid="GAL 2:20"/>عَلَ شَ مِشِ سُفَندِشِ قَشَ كِ نَشّ وُرِ مَفَلَنبُشِ مَ، ﭑ وَشْنقٍ قَن بَرَ قَشَ نَ كِ. يَكْسِ ﭑ مُ بِرَ مَ ﭑ وَشْنقٍ قْشْ رَ. عَلَ شَ مِشِ سُفَندِشِ نَن ﭑ مَ دُنِحّءِفِرِ رَحّرّ مَ. ﭑ ﭑ مَ دُنِحّءِفِرِ رَحّرّ مَ دَنشَنِيَ نَن سَابُي رَ. ﭑ بَرَ دَنشَنِيَ عَلَ شَ دِ مَ نَشَن عَ يّتّ بَشِ سّرّشّ رَ ﭑ بّ عَ شَ شَنُنتٍيَ شَ قٍ رَ. <verse eid="GAL 2:20"/><verse number="21" style="v" sid="GAL 2:21"/>ﭑ مُ تِنمَ عَلَ شَ هِننّ رَبٌلٌدٍ. شَ عَ سَ لِ ﭑ نْمَ عَلَ شَ يَامَرِيٍ رَتِنمّدٍ هَن ﭑ شَ قِندِ تِنشِنتْي رَ، عَ لِمَ عَلَ شَ مِشِ سُفَندِشِ شَ قَشّ تِدٍ يٌ مُ نَ وٌن مَ كِسِ شَ قٍ رَ.<verse eid="GAL 2:21"/></para>
  <chapter eid="GAL 2"/>
  <chapter number="3" style="c" sid="GAL 3"/>
  <para style="s">دَنشَنِيَتْييٍ قِندِشِ عِبُرَهِمَ شَ دِيٍ نَن نَ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 3:1"/>وٌ تَن فَلَتِكَ شَشِلِتَرٍيٍ، ندٍ وٌ مَدَشُشِ؟ عَ مَسٍنشِ نّ وٌ بّ عَ قِيشّ رَ عَ عَلَ شَ مِشِ سُفَندِشِ بَنبَن نّ وُرِ مَفَلَنبُشِ مَ. <verse eid="GAL 3:1"/><verse number="2" style="v" sid="GAL 3:2"/>وٌ عَ قَلَ ﭑ بّ مُنسٍ عَ نِيَشِ وٌ شَ عَلَ شَشِلِ سّنِيّنشِ سْتْ. وٌ عَ سْتْشِ عَلَ شَ سّرِيّ رَتِنمّقٍ نَن سَابُي رَ، كَ وٌ عَ سْتْشِ نّ بَرِ مَ وٌ دَنشَنِيَشِ عَلَ شَ مَسٍنيِ مَ وٌ نَشَن مّشِ؟ <verse eid="GAL 3:2"/><verse number="3" style="v" sid="GAL 3:3"/>وٌ شَشِلِ مُ نَ؟ سِنفٍ وٌ شَشِلِ نُ تِشِ عَلَ شَشِلِ سّنِيّنشِ نَن نَ، كْنْ يَكْسِ وٌ لَشِ وٌ يّتّ كَن سّنبّ نَن نَ. مُنقٍ رَ؟ <verse eid="GAL 3:3"/><verse number="4" style="v" sid="GAL 3:4"/>وٌ بَرَ تْورْ عَلَ شَشِلِ سْتْقٍ رَ، يَكْسِ مُنقٍ رَ وٌ وَ مَ نَ بّحِنقٍ؟ نَ بَرَ قِندِ قٍ قُقَقُ رَ وٌ بّ؟ <verse eid="GAL 3:4"/><verse number="5" style="v" sid="GAL 3:5"/>عَلَ عَ شَشِلِ سّنِيّنشِ قِمَ وٌ مَ، عَ مَن كَابَنَكٌي رَبَمَ وٌ تَفِ. عَ وٌ كِمَ نّ، بَرِ مَ وٌ بَرَ عَ شَ سّرِيّيٍ رَبَتُ، كَ عَ وٌ كِمَ نّ بَرِ مَ وٌ بَرَ دَنشَنِيَ عَلَ شَ مَسٍنيِ مَ وٌ نَشَن مّشِ؟<verse eid="GAL 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 3:6"/>وٌ شَ عِبُرَهِمَ شَ قٍ مَتٌ. عَ تٌ دَنشَنِيَ عَلَ مَ، عَ نَشَ تِنشِنيِ سْتْ عَلَ مَبِرِ. <verse eid="GAL 3:6"/><verse number="7" style="v" sid="GAL 3:7"/>نَ نَن نَ كِ، مِشِ نَشَن دَنشَنِيَ عَلَ مَ، نَ بَرَ قِندِ عِبُرَهِمَ شَ دِ رَ. <verse eid="GAL 3:7"/><verse number="8" style="v" sid="GAL 3:8"/>كِتَابُي نَ نَن يَتِ قَلَ بٍينُن عَ شَ رَبَ، عَ قَلَقٍ رَ عَلَ قَمَ سِ فبّتّيٍ رَتِنشِندٍ عٍ شَ دَنشَنِيَ سَابُي رَ. عَ نَشَ نَ مَسٍنيِ قَنيِ مَسٍن سِنفٍ نُ، عَ تٌ عَ قَلَ عِبُرَهِمَ بّ، «سِ بِرِن قَمَ نّ دُبَ سْتْدٍ عِ تَن سَابُي رَ.» <verse eid="GAL 3:8"/><verse number="9" style="v" sid="GAL 3:9"/>نَ كُي، دَنشَنِيَتْي بِرِن دُبَ سْتْمَ نّ عَلْ عِبُرَهِمَ دَنشَنِيَتْي. <verse eid="GAL 3:9"/><verse number="10" style="v" sid="GAL 3:10"/>مِشِ نَشَن كَتَمَ عَلَ شَ يَامَرِيٍ رَتِنمّدٍ عَلَكٌ عَ شَ كِسِ سْتْ، نَ قِندِشِ مِشِ دَنكَشِ نَن نَ، بَرِ مَ عَ سّبّشِ كِتَابُي كُي، «مِشِ نَشَن مُ يَامَرِ بِرِن نَبَمَ، نَشٍيٍ سّبّشِ عَلَ شَ سّرِيّ كِتَابُي كُي، عَ دَنكَشِ.» <verse eid="GAL 3:10"/><verse number="11" style="v" sid="GAL 3:11"/>مِشِ يٌ مُ نْمَ عَلَ شَ يَامَرِيٍ بِرِن نَبَتُدٍ، نَ شَ عَ قِندِ تِنشِنتْي رَ. عَ سّبّشِ كِتَابُي كُي، «تِنشِنتْي كِسِمَ عَ شَ دَنشَنِيَ نَن سَابُي رَ.»<verse eid="GAL 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 3:12"/>عَ مَن سّبّشِ، «مِشِ نَشَن عَلَ شَ يَامَرِيٍ بِرِن نَبَتُمَ، عَ كِسِمَ نٍيٍ نَن سَابُي رَ.» شَشِلِ قِرِن نَن عَ رَ. نَشَن عَ شَشِلِ تِمَ دَنشَنِيَ رَ، عَ مُ نْمَ عَ شَشِلِ تِدٍ يَامَرِيٍ رَتِنمّقٍ رَ. <verse eid="GAL 3:12"/><verse number="13" style="v" sid="GAL 3:13"/>عَلَ شَ مِشِ سُفَندِشِ بَرَ وٌن شُنسَرَ دَنكّ مَ، وٌن نَشَن سْتْ بَرِ مَ وٌن مُ عَ شَ يَامَرِ بِرِن نَتِنمّشِ. عَ وٌن شُنسَرَ نّ، عَ تٌ وٌن مَ دَنكّ تٌنفٌ عَ شَ كٌتٍ رَ. عَ قِندِ مِشِ دَنكَشِ رَ عَ قَشَ كِ نَن مَ، بَرِ مَ عَ سّبّشِ كِتَابُي كُي، «دَنكّ نَ مِشِ بّ نَشَن فبَكُمَ وُرِ مَ.» <verse eid="GAL 3:13"/><verse number="14" style="v" sid="GAL 3:14"/>عَ بَرَ وٌن شُنسَرَ عَلَكٌ عَلَ هّيرِ نَشَن قِشِ عِبُرَهِمَ مَ، عَ شَ دَنفِ سِ فبّتّيٍ مَ عَلَ شَ مِشِ سُفَندِشِ عِسَ سَابُي رَ. نَ كُي، وٌن مَ دَنشَنِيَ سَابُي رَ، وٌن نْمَ عَلَ شَشِلِ سّنِيّنشِ سْتْدٍ نَشَن لَايِدِشِ وٌن بّ.<verse eid="GAL 3:14"/></para>
  <para style="s">عَلَ شَ سَاتّ نُن عِبُنَدَ مَ شَ وَلِ</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 3:15"/>ﭑ نفَشَكٍرٍنيِيٍ، ﭑ شَ مِسَالِ ندٍ مَسٍن وٌ بّ. مِشِ مُ نْمَ سَاتّ مَسَرَدٍ، شَ نَ مُ عَ رَ عَ كَنَدٍ، سَاتّ نَشَن تٌنفٌشِ عِبُنَدَ مَ شَ سّرِيّ كِ مَ. عَننَبِ عِبُرَهِمَ شَ سَاتّ لُمَ نَ كِ نّ. <verse eid="GAL 3:15"/><verse number="16" style="v" sid="GAL 3:16"/>عَلَ نَشَ لَايِدِ ندٍيٍ تٌنفٌ عِبُرَهِمَ نُن عَ شَ دِ بّ. كِتَابُي مُ عَ قَلَمَ «دِيٍ،» وْيّنيِ نَشَن وَ مَ عَ قَلَقٍ «مِشِ وُيَشِ.» كِتَابُي عَ قَلَمَ «عَ نُن عَ شَ دِ.» وْيّنيِ نَ عَ رَ نَشَن وَ مَ عَ قَلَقٍ «مِشِ كٍرٍن.» نَ مِشِ كٍرٍن قِندِشِ عَلَ شَ مِشِ سُفَندِشِ نَن نَ. <verse eid="GAL 3:16"/><verse number="17" style="v" sid="GAL 3:17"/>ﭑ وَ مَ نَشَن قَلَقٍ وٌ بّ، عَ عَلَ شَ سّرِيّ، نَشَن سّبّشِ حّ كّمّ نَانِ حّ تٌنفٌ سَشَن دَنفِ شَنبِ عَلَ شَ سَاتّتٌنفٌي عِبُرَهِمَ بّ، نَ سّرِيّ مُ نْمَ نَ لَايِدِ سِنفٍ كَنَدٍ. <verse eid="GAL 3:17"/><verse number="18" style="v" sid="GAL 3:18"/>شَ وٌن كِسِ سْتْمَ كّ رَ، بَرِ مَ وٌن عَلَ شَ يَامَرِيٍ رَتِنمّمَ، وٌن مُ عَ سْتْمَ سْنْن عَلَ شَ لَايِدِ سَابُي رَ. عَلَ عَ قِ عِبُرَهِمَ مَ لَايِدِ نَن نَ عَ يّتّ شَ هِننّ شَ قٍ رَ.<verse eid="GAL 3:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 3:19"/>شَ نَ نَن عَ رَ، مُنقٍ رَ عَلَ عَ نِيَ عَ شَ يَامَرِيٍ شَ سّبّ كِتَابُي كُي؟ عَ عَ شَ يَامَرِيٍ سّبّ نّ يُنُبِيٍ شَ قٍ رَ، بٍينُن عَ شَ دِ لَايِدِشِ شَ قَ. مَلٍكّيٍ نَشَ قَ نَ سّرِيّ رَ، عٍ نَ سٌ سَابُي ندٍ يِ رَ. <verse eid="GAL 3:19"/><verse number="20" style="v" sid="GAL 3:20"/>سَابُي تَن لُمَ مِشِ قِرِن نَن تَفِ، كْنْ عَلَ تَن، كٍرٍن نَن عَ رَ.<verse eid="GAL 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 3:21"/>عَلَ شَ سّرِيّ نُن عَلَ شَ لَايِدِيٍ عٍ بٌورٍ مَتَندِ مَ؟ عَدٍ دٍ! شَ وٌن نُ نْمَ كِسِ سْتْدٍ عَلَ شَ يَامَرِيٍ رَبَتُي نَن نَ نُ، نَ نُ نْمَ نّ وٌن قِندِدٍ تِنشِنتْييٍ رَ. <verse eid="GAL 3:21"/><verse number="22" style="v" sid="GAL 3:22"/>كْنْ عَلَ شَ كِتَابُي عَ مَسٍنشِ نّ وٌن بّ عَ دُنِحَ مِشِ بِرِن عَلَ شَ يَامَرِيٍ مَتَندِ مَ، عٍ قِندِ يُنُبِتْييٍ رَ. نَ كُي، عَلَ نَشَن لَايِدِشِ مِشِيٍ بّ، نَشٍيٍ لَمَ عَ رَ، عٍ قَ دَنشَنِيَ عَلَ شَ مِشِ سُفَندِشِ عِسَ مَ، عٍ نْمَ نَ سْتْدٍ.<verse eid="GAL 3:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GAL 3:23"/>بٍينُن مِشِ شَ نْ كِسِ سْتْدٍ دَنشَنِيَ سَابُي رَ، وٌن نُ نَ كَتَقٍ عَلَ شَ يَامَرِيٍ رَتِنمّدٍ، عَلَكٌ وٌن شَ كِسِ، كْنْ وٌن مُ نْ. <verse eid="GAL 3:23"/><verse number="24" style="v" sid="GAL 3:24"/>نَ كُي، سّرِيّ بَرَ وٌن شُرُ هَن بٍينُن عَلَ شَ مِشِ سُفَندِشِ شَ قَ عَلَكٌ وٌن شَ تِنشِنيِ سْتْ دَنشَنِيَ سَابُي رَ. <verse eid="GAL 3:24"/><verse number="25" style="v" sid="GAL 3:25"/>كْنْ دَنشَنِيَ تٌ بَرَ قَ، وٌن مُ نَ سّرِيّ شَ شُرُي بُن مَ سْنْن، <verse eid="GAL 3:25"/><verse number="26" style="v" sid="GAL 3:26"/>بَرِ مَ وٌ بِرِن بَرَ قِندِ عَلَ شَ دِيٍ رَ، وٌ تٌ دَنشَنِيَشِ عَلَ شَ مِشِ سُفَندِشِ عِسَ مَ. <verse eid="GAL 3:26"/><verse number="27" style="v" sid="GAL 3:27"/>وٌ تَن نَشٍيٍ بَرَ وٌ شُنشَ يٍ شْورَ عَلَ شَ مِشِ سُفَندِشِ شِلِ رَ، وٌ نُن عَلَ شَ مِشِ سُفَندِشِ نَن قَ عَ رَ. <verse eid="GAL 3:27"/><verse number="28" style="v" sid="GAL 3:28"/>يُوِقِ نُن فِرّكِ، كٌنيِ نُن شْرّ، شّمّ نُن فِنّ، وٌ بِرِن كٍرٍن عَلَ شَ مِشِ سُفَندِشِ عِسَ عِ. <verse eid="GAL 3:28"/><verse number="29" style="v" sid="GAL 3:29"/>شَ وٌ بَرَ قِندِ عِسَ عَلَ شَ مِشِ سُفَندِشِ فبٍ رَ، وٌ بَرَ قِندِ عِبُرَهِمَ شَ دِيٍ نُن كّتٌنفٌي رَ عَلْ عَلَ عَ لَايِدِشِ كِ نَشّ.<verse eid="GAL 3:29"/></para>
  <chapter eid="GAL 3"/>
  <chapter number="4" style="c" sid="GAL 4"/>
  <para style="s">كٌنيِ نُن دِ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 4:1"/>ﭑ وَ مَ نَشَن قَلَقٍ، كّ تٌنفٌمَ، عَ دِ مّدِ تّمُي، هَلِ عَ بَبَ كّ تٌ قِندِشِ عَ فبٍ رَ، عَ لُشِ عَلْ كٌنيِ نَشَن مُ فّشِ عَ يّتّ سْتْدٍ. <verse eid="GAL 4:1"/><verse number="2" style="v" sid="GAL 4:2"/>عَ لُمَ يَتِفِيٍ نُن كَرَ مْشْيٍ شَ يَامَرِ نَن بُن مَ، هَن عَ بَبَ نَ تِن تّمُي نَشّ عَ شَ عَ يّتّ سْتْ. <verse eid="GAL 4:2"/><verse number="3" style="v" sid="GAL 4:3"/>وٌن تَن قَن تٌ مُ نُ عَلَ شَ مِشِ سُفَندِشِ عِسَ كٌلٌن، وٌن نُ لُشِ نّ عَلْ دِ مّدِيٍ. وٌن نُ نَ دُنِحَ قٍ كٌبِيٍ شَ كٌنيِيَ نَن بُن مَ. <verse eid="GAL 4:3"/><verse number="4" style="v" sid="GAL 4:4"/>وَشَتِ تٌ كَمَلِ، عَلَ نَشَ عَ شَ دِ شّي دُنِحَ مَ فِنّ ندٍ سَابُي رَ. عَ نَشَ بَرِ عَلَ شَ سّرِيّ بُن مَ، <verse eid="GAL 4:4"/><verse number="5" style="v" sid="GAL 4:5"/>عَلَكٌ عَ شَ مِشِيٍ شُنسَرَ نَشٍيٍ نُ نَ عَلَ شَ سّرِيّ شَ كِيتِ بُن مَ. عَ نَشَ وٌن شُنسَرَ عَلَكٌ وٌن شَ قِندِ عَلَ شَ دِيٍ رَ. <verse eid="GAL 4:5"/><verse number="6" style="v" sid="GAL 4:6"/>وٌ تٌ قِندِ عَ شَ دِيٍ رَ، عَلَ نَشَ عَ شَ دِ شَشِلِ رَ سٌ وٌ بْحّ عِ، شَشِلِ نَشَن شِلِ تِمَ، «ن بَ.» <verse eid="GAL 4:6"/><verse number="7" style="v" sid="GAL 4:7"/>نَ نَن عَ رَ وٌ بَرَ مِنِ كٌنيِيَ كُي، وٌ بَرَ قِندِ عَلَ شَ دِيٍ رَ. وٌ تٌ قِندِشِ عَ شَ دِيٍ رَ، عَلَ مَن بَرَ وٌ قِندِ عَ كّتٌنفٌي رَ.<verse eid="GAL 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 4:8"/>سِنفٍ وٌ مُ نُ عَلَ كٌلٌن. دُنِحَ قٍ كٌبِيٍ نَن نُ قِندِشِ وٌ مَرِفِ رَ، عَ قَ لِ نٍيٍ نُن عَلَ تَفِ عِكُيَ. <verse eid="GAL 4:8"/><verse number="9" style="v" sid="GAL 4:9"/>يَكْسِ وٌ بَرَ عَلَ كٌلٌن. عَلَ بَرَ وٌ قَن كٌلٌن. مُنسٍ قَ عَ نِيَشِ سْنْن وٌ مَن فبِلٍنمَ نَ دُنِحَ قٍيٍ مَ نَشٍيٍ سّنبّ نُن تِدٍ مُ فبٌ؟ وٌ مَن وَ مَ لُقٍ عٍ شَ كٌنيِيَ بُن مَ؟ <verse eid="GAL 4:9"/><verse number="10" style="v" sid="GAL 4:10"/>وٌ مَن بَرَ بِرَ يَامَرِيٍ قْشْ رَ، نَشٍيٍ عَ قَلَمَ لْشْي ندٍيٍ نُن كِكٍ ندٍيٍ تِدٍ فبٌ عٍ بٌورٍ بّ. وٌ وَشَتِ ندٍيٍ نُن حّ ندٍيٍ رَقِسَ عٍ بٌورٍ بّ. <verse eid="GAL 4:10"/><verse number="11" style="v" sid="GAL 4:11"/>ﭑ فَاشُ نّ وٌ نَشَ ﭑ مَ شَرَنيِ رَبٌلٌ، ﭑ مَ وَلِ شَ لُ ﭑ مَ قُ.<verse eid="GAL 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 4:12"/>ﭑ نفَشَكٍرٍنيِيٍ، ﭑ بَرَ وٌ مَيَندِ، وٌ لُ عَلْ ﭑ تَن، بَرِ مَ ﭑ قَن لُشِ نّ عَلْ وٌ تَن. وٌ مُ قٍ كٌبِ يٌ رَبَ ﭑ نَ. <verse eid="GAL 4:12"/><verse number="13" style="v" sid="GAL 4:13"/>وٌ عَ كٌلٌن عَ ﭑ مَ قُرٍ نَن عَ نِيَ، عَ سِنفٍ سِنفٍ ﭑ شَ وٌ كَوَندِ عِسَ شَ مَسٍنيِ قَنيِ رَ. <verse eid="GAL 4:13"/><verse number="14" style="v" sid="GAL 4:14"/>نَ نُ شْرْشْ وٌ بّ، كْنْ ﭑ مَ قٍ مُ وٌ بْحّ رَحَاشُ وٌ مَ، وٌ مُ وٌ مَكُيَ ﭑ نَ. وٌ ﭑ نَسّنّ نّ عَلْ عَلَ شَ مَلٍكّ ندٍ، شَ نَ مُ عَ رَ عَلَ شَ مِشِ سُفَندِشِ عِسَ. <verse eid="GAL 4:14"/><verse number="15" style="v" sid="GAL 4:15"/>وٌ شَ نَ سّيوّ قٌرِ نَ مِندٍن؟ سِنفٍ ﭑ مَ قٍ نُ رَقَن وٌ مَ هَن وٌ نُ نْمَ تِندٍ وٌ يَيٍ يَتِ بَدٍ ﭑ بّ. <verse eid="GAL 4:15"/><verse number="16" style="v" sid="GAL 4:16"/>ﭑ نْندِ قَلَقٍ وٌ بّ، نَ بَرَ عَ نِيَ ﭑ شَ قِندِ وٌ يَشُي رَ؟ <verse eid="GAL 4:16"/><verse number="17" style="v" sid="GAL 4:17"/>نَ مِشِيٍ وَ مَ وٌ شَ بِرَ عٍ قْشْ رَ، كْنْ نَ مُ قِندِ مَ قٍ قَنيِ رَ وٌ بّ. عٍ وَ مَ وٌن تَفِ عِسٌقٍ، عَلَكٌ وٌ شَ لُ عٍ تَن مَبِرِ. <verse eid="GAL 4:17"/><verse number="18" style="v" sid="GAL 4:18"/>شَ وٌ فبَتَ قٍ قَنيِ رَبَقٍ رَ، نَ مُ حَاشُ. وٌ شَ نَ مْولِ رَبَ تّمُي بِرِن، هَلِ ﭑ مُ نَ وٌ يِرٍ. <verse eid="GAL 4:18"/><verse number="19" style="v" sid="GAL 4:19"/>ﭑ مَ دِيٍ، ﭑ مَن نَ تْورْقٍ وٌ بّ عَلْ فِنّ شَ تْورّ دِتِنيِ رَ، هَن عَلَ شَ مِشِ سُفَندِشِ حّرّ كِ سَبَتِمَ وٌ عِ تّمُي نَشّ. <verse eid="GAL 4:19"/><verse number="20" style="v" sid="GAL 4:20"/>عَ شْلِ ﭑ مَ وٌن بِرِن شَ لُ يِرٍ كٍرٍن، عَلَكٌ وٌن شَ وٌن بٌرٍ قَهَامُ، بَرِ مَ يَكْسِ ﭑ بَرَ هَنمّ وٌ شَ قٍ رَ.<verse eid="GAL 4:20"/></para>
  <para style="s">هَفَرَ نُن سَرَ شَ مِسَالِ</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 4:21"/>وٌ تَن نَشٍيٍ وَ مَ كِسِ سْتْقٍ عَلَ شَ يَامَرِيٍ رَتِنمّقٍ سَابُي رَ، وٌ مُ عَ كٌلٌن عَلَ شَ سّرِيّ نَشَن قَلَشِ؟ <verse eid="GAL 4:21"/><verse number="22" style="v" sid="GAL 4:22"/>عَ سّبّشِ كِتَابُي كُي عَ دِ قِرِن نَن نُ نَ عِبُرَهِمَ يِ رَ. كٌنيِ فِنّ نَشَ كٍرٍن بَرِ عَ بّ، شْرّ فِنّ قَن نَشَ دِ فبّتّ بَرِ عَ بّ. <verse eid="GAL 4:22"/><verse number="23" style="v" sid="GAL 4:23"/>عَ نَشَن سْتْ كٌنيِ فِنّ سَابُي رَ، نَ بَرِشِ نّ عَلْ عِبُنَدَ مَ بِرِن بَرِشِ كِ نَشّ، كْنْ عَ نَشَن سْتْ شْرّ فِنّ سَابُي رَ، عَ بَرِشِ لَايِدِ نَن كُي. <verse eid="GAL 4:23"/><verse number="24" style="v" sid="GAL 4:24"/>نَ فِنّ قِرِنيِ مِسَالِشِ سَاتّ قِرِن نَن نَ. سَاتّ نَشَن شِرِشِ سِنَيِ فٍيَ قَرِ نَن عَ نِيَمَ مِشِ شَ لُ كٌنيِيَ كُي. هَفَرَ مِسَالِشِ نَ سَاتّ نَن نَ، <verse eid="GAL 4:24"/><verse number="25" style="v" sid="GAL 4:25"/>نَشَن شِرِشِ سِنَيِ فٍيَ قَرِ عَرَبُ بْشِ مَ. عَ مِسَالِشِ دَرِ سَلَمُ قَن نَ، نَشَن نَ كٌنيِيَ كُي عَ نُن عَ شَ دِيٍ. <verse eid="GAL 4:25"/><verse number="26" style="v" sid="GAL 4:26"/>كْنْ دَرِ سَلَمُ نَشَن نَ عَرِيَننَ، شْرّ تَا نَن عَ رَ. وٌن نفَ نَن نَ كِ. <verse eid="GAL 4:26"/><verse number="27" style="v" sid="GAL 4:27"/>عَ سّبّشِ كِتَابُي كُي،</para>
  <para style="q" vid="GAL 4:27">«عِ تَن نَشَن مُ دِ بَرِ مَ، عِ شَ حّلّشِن.</para>
  <para style="q" vid="GAL 4:27">عِ تَن نَشَن مُ دِ بَرِ تْورّ كٌلٌن،</para>
  <para style="q" vid="GAL 4:27">عِ شُي رَ مِنِ، عَ عِتٍ حّلّشِنيِ كُي،</para>
  <para style="q" vid="GAL 4:27">بَرِ مَ فِنّ نَشَن شَ شّمّ بَرَ مّي عَ رَ،</para>
  <para style="q" vid="GAL 4:27">عَ شَ دِ وُيَمَ نّ،</para>
  <para style="q" vid="GAL 4:27">دَنفِ شّمّ تَا عِدْشْي رَ.»<verse eid="GAL 4:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GAL 4:28"/>وٌ تَن نفَشَكٍرٍنيِيٍ، وٌ بَرَ قِندِ لَايِدِ دِيٍ رَ عَلْ عِسِيَفَ. <verse eid="GAL 4:28"/><verse number="29" style="v" sid="GAL 4:29"/>نَ وَشَتِ، دِ نَشَن بَرِشِ عِبُنَدَ مَ كِ مَ، عَ نَشَ دِ بٌورٍ تْورْ، نَشَن بَرِشِ عَلَ شَشِلِ سّنبّ سَابُي رَ. هَن يَ عَ نَ نَ كِ نّ. <verse eid="GAL 4:29"/><verse number="30" style="v" sid="GAL 4:30"/>مُنسٍ سّبّشِ كِتَابُي كُي؟ عَ سّبّشِ، «عِ شَ كٌنيِ فِنّ نُن عَ شَ دِ كٍرِ، بَرِ مَ كٌنيِ فِنّ شَ دِ نُن شْرّ فِنّ شَ دِ مُ كّ عِتَشُنمَ.» <verse eid="GAL 4:30"/><verse number="31" style="v" sid="GAL 4:31"/>ﭑ نفَشَكٍرٍنيِيٍ، نَ نَن عَ رَ وٌن مُ قِندِشِ كٌنيِ فِنّ شَ دِيٍ شَ رَ. وٌن قِندِشِ شْرّ فِنّ شَ دِيٍ نَن نَ.<verse eid="GAL 4:31"/></para>
  <chapter eid="GAL 4"/>
  <chapter number="5" style="c" sid="GAL 5"/>
  <para style="s">دَنشَنِيَتْي شَ شْرّيَ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 5:1"/>عَلَ شَ مِشِ سُفَندِشِ بَرَ وٌن شُنسَرَ، عَلَكٌ وٌن شَ شْرّيَ سْتْ. نَ كُي، وٌ شَ تِ عَ قَنيِ رَ. وٌ نَشَ تِن كٌنيِيَ ندٍ يٌ شَ دْشْ وٌ قَرِ سْنْن.<verse eid="GAL 5:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="GAL 5:2"/>ﭑ تَن ثْلُ، ﭑ شَ نْندِ قَلَ وٌ بّ، شَ وٌ تِن نَ مِشِيٍ شَ وٌ سُننَ، عَلَ شَ مِشِ سُفَندِشِ شَ وَلِ تِدٍ يٌ مُ نَ وٌ بّ سْنْن. <verse eid="GAL 5:2"/><verse number="3" style="v" sid="GAL 5:3"/>ﭑ مَن شَ عَ قَلَ وٌ بّ، شّمّ نَشَن تِنمَ عٍ شَ عَ سُننَ، عَ لَنمَ عَ شَ عَلَ شَ يَامَرِ بِرِن نَتِنمّ. <verse eid="GAL 5:3"/><verse number="4" style="v" sid="GAL 5:4"/>وٌ تَن نَشٍيٍ وَ مَ تِنشِنيِ سْتْقٍ يَامَرِيٍ رَتِنمّقٍ سَابُي رَ، وٌ نُن عَلَ شَ مِشِ سُفَندِشِ تَفِ بَرَ عِكُيَ. عَلَ مُ هِننّمَ وٌ رَ سْنْن. <verse eid="GAL 5:4"/><verse number="5" style="v" sid="GAL 5:5"/>وٌن وٌن شَشِلِ تِمَ عَلَ شَشِلِ رَ وٌن مَ دَنشَنِيَ كُي، عَلَكٌ وٌن شَ تِنشِنيِ سْتْ وٌن شَشِلِ تِمَ نَشَن نَ. <verse eid="GAL 5:5"/><verse number="6" style="v" sid="GAL 5:6"/>شَ مِشِ بِرَشِ عَلَ شَ مِشِ سُفَندِشِ عِسَ قْشْ رَ، سُننّ نُن سُننَتَرٍيَ تِدٍ يٌ مُ نَ عَ بّ. قٍ كٍرٍن نَن تِدٍ فبٌ؛ مِشِ شَ دَنشَنِيَ عَلَ مَ، عَ شَ مِشِ شَنُ.<verse eid="GAL 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 5:7"/>وٌ نُ نَ حّرّقٍ عَ قَنيِ رَ. ثٍ، ندٍ عَ نِيَشِ وٌ شَ نْندِ رَبٌلٌ؟ <verse eid="GAL 5:7"/><verse number="8" style="v" sid="GAL 5:8"/>نَشَن وٌ بّندُنشِ نَ كِ، نَ مُ قِندِشِ عَلَ رَ نَشَن وٌ شِلِ. <verse eid="GAL 5:8"/><verse number="9" style="v" sid="GAL 5:9"/>لّبِنِ دٌندٌرٌنتِ نْمَ قَرِن فبٍفبٍ رَتٍدٍ. <verse eid="GAL 5:9"/><verse number="10" style="v" sid="GAL 5:10"/>ﭑ بَرَ لَ وٌ رَ عَلَ سَابُي رَ، مِشِ يٌ قَ عَ شَ قَ وٌ يَ عِسٌ، وٌ مُ تِنمَ نَ شَشِلِ مْولِ رَ. نَ كَنيِ قَمَ نّ عَ سَرٍ سْتْدٍ. <verse eid="GAL 5:10"/><verse number="11" style="v" sid="GAL 5:11"/>ﭑ نفَشَكٍرٍنيِيٍ، شَ عَ لِ نُ هَن يَ ﭑ نَ كَوَندِ تِقٍ مِشِيٍ شَ سُننَ، مُنقٍ رَ يُوِقِيٍ لُمَ ﭑ حَشَنكَتَ رَ؟ شَ عَ سَ لِ نُ ﭑ نَ كَوَندِ مْولِ تِمَ، عِسَ شَ سّرّشّ وُرِ مَفَلَنبُشِ مَ، عَ مُ قِندِ مَ وْيّن شْرْشْي رَ مِشِيٍ بّ نُ. <verse eid="GAL 5:11"/><verse number="12" style="v" sid="GAL 5:12"/>ﭑ وَ مَ نّ نَشٍيٍ نَ وٌ يَ عِسٌقٍ، هَلِ عٍ مُ عَ دَن سُننّ قٍ فبَنسَن مَ. عٍ شَ عٍ شّمّيَ بِرِن بَ نَ.<verse eid="GAL 5:12"/></para>
  <para style="s">دَنشَنِيَتْي حّرّ كِ</para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 5:13"/>ﭑ نفَشَكٍرٍنيِيٍ، عَلَ وَ مَ وٌ شَ لُ شْرّيَ كُي، كْنْ وٌ نَشَ نَ شْرّيَ مَقِندِ يُنُبِ رَ. وٌ وٌ بٌرٍ مَلِ شَنُنتٍيَ كُي. <verse eid="GAL 5:13"/><verse number="14" style="v" sid="GAL 5:14"/>عَلَ شَ سّرِيّ بِرِن نَ يِ يَامَرِ كٍرٍنيِ نَن كُي؛ وٌ شَ وٌ بٌورٍ عَدَ مَدِ شَنُ عَلْ وٌ يّتّ. <verse eid="GAL 5:14"/><verse number="15" style="v" sid="GAL 5:15"/>شَ وٌ لُمَ وٌ بٌرٍ تْورْ رَ، وٌ نُ وٌ بٌرٍ حَشَنكَتَ، وٌ عَ نِيَ دْيِن، شَ نَ مُ عَ رَ وٌ وٌ بٌرٍ شَ قٍ شُن نَكَنَمَ نّ.<verse eid="GAL 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GAL 5:16"/>ﭑ وَ مَ نَشَن قَلَقٍ وٌ بّ، وٌ شَ عَ لُ عَلَ شَشِلِ شَ وٌ رَحّرّ. وٌ نَشَ بِرَ وٌ يّتّ وَشْنقٍ حَاشِيٍ قْشْ رَ. <verse eid="GAL 5:16"/><verse number="17" style="v" sid="GAL 5:17"/>عَدَ مَ وَشْنقٍ حَاشِ نُن عَلَ شَشِلِ سّنِيّنشِ، عَ كٍرٍن مُ عَ رَ. نَ قِرِنيِ نَ عٍ بٌرٍ فٍرٍقٍ، عَلَكٌ وٌ نَشَ وٌ وَشْنقٍ رَبَ. <verse eid="GAL 5:17"/><verse number="18" style="v" sid="GAL 5:18"/>شَ عَلَ شَشِلِ نَ وٌ رَحّرّقٍ، وٌ شَشِلِ مُ تِمَ وٌ شَ يَامَرِ رَتِنمّشِيٍ رَ سْنْن.<verse eid="GAL 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 5:19"/>يُنُبِتْي وَشْنقٍيٍ نَن يَ؛ لَنفٌيحَ، سّنِيّنتَرٍحَ، سْن كٌبِ، <verse eid="GAL 5:19"/><verse number="20" style="v" sid="GAL 5:20"/>كُيٍ بَتُقٍ، دُورٍيَ، شْننَنتٍيَ، لَنتَرٍيَ، تْونّ، بْحّ تٍقٍ، فٍينِ قٍنقٍ عِ يّتّ بّ، سْنشْقٍ، بٌورٍ رَقِسَقٍ عَ بٌورٍ بّ، <verse eid="GAL 5:20"/><verse number="21" style="v" sid="GAL 5:21"/>مِلَنتٍيَ، سِيسِقٍ، شُلُنيِ حَاشِيٍ، نُن نَ مَنِيّيٍ. ﭑ مَن شَ عَ قَلَ وٌ بّ، مِشِ نَشٍيٍ حّرّ مَ نَ كِ، عٍ مُ عَرِيَننَ سْتْمَ كّ رَ مُكُ.<verse eid="GAL 5:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GAL 5:22"/>كْنْ عَلَ شَشِلِ سّنِيّنشِ شَ كّوَلِيٍ نَن يَ؛ شَنُنتٍيَ، سّيوّ، بْحّسَ، دِحّ، يَرَوَ سّ، قَنيِ، لَنلَنتٍيَ، <verse eid="GAL 5:22"/><verse number="23" style="v" sid="GAL 5:23"/>بْحّ بّشِيَ، نُن يّتّ سُشُي. تْنيِ يٌ مُ نَ نَ قٍ مْولِيٍ مَ. <verse eid="GAL 5:23"/><verse number="24" style="v" sid="GAL 5:24"/>عَلَ شَ مِشِ سُفَندِشِ عِسَ قْشِرَبِرّيٍ بَرَ يُنُبِتْي وَشْنقٍ رَبّحِن عَ نُن قٍ حَاشِ بِرِن. <verse eid="GAL 5:24"/><verse number="25" style="v" sid="GAL 5:25"/>وٌن تٌ كِسِ سْتْ عَلَ شَشِلِ سّنِيّنشِ سَابُي رَ، وٌن شَ بِرَ عَ قْشْ رَ. <verse eid="GAL 5:25"/><verse number="26" style="v" sid="GAL 5:26"/>وٌن نَشَ وٌن يّتّ عِفبٌ، وٌن نَشَ وٌن بٌرٍ رَشْنْ، وٌن نَشَ مِلَ وٌن بٌرٍ مَ.<verse eid="GAL 5:26"/></para>
  <chapter eid="GAL 5"/>
  <chapter number="6" style="c" sid="GAL 6"/>
  <para style="s">دَنشَنِيَتْييٍ شَ مَلِ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 6:1"/>ﭑ نفَشَكٍرٍنيِيٍ، شَ وٌ بَرَ مِشِ ندٍ سُشُ يُنُبِ كُي، وٌ تَن نَشٍيٍ شَ دَنشَنِيَ تِلِنشِ، وٌ شَ عَ مَقُرُكُ عَلَكٌ عَ شَ فبِلٍن عَلَ مَ. كْنْ وٌ شَ وٌ حّنفِ سَ وٌ يّتّ شْن مَ، عَلَكٌ وٌ قَن نَشَ بِرَ نَ يُنُبِ كُي. <verse eid="GAL 6:1"/><verse number="2" style="v" sid="GAL 6:2"/>وٌ وٌ بٌرٍ مَلِ وٌ شَ كٌتٍ شَنِندٍ. نَ كُي، وٌ عَلَ شَ مِشِ سُفَندِشِ شَ سّرِيّ نَن نَتِنمّمَ. <verse eid="GAL 6:2"/><verse number="3" style="v" sid="GAL 6:3"/>شَ مِشِ عَ يّتّ عِفبٌمَ، عَ نَ عَ يّتّ مَدَشُقٍ. <verse eid="GAL 6:3"/><verse number="4" style="v" sid="GAL 6:4"/>كَنكَن شَ عَ يّتّ حّرّ كِ مَتٌ، شَ عَ قَن، شَ عَ مُ قَن. عَ نَشَ عَ بٌورٍ حّرّ كِ مَتٌ، عَ قَ عَ قَلَ، «ﭑ قَن بٌورٍ بّ.» نَ كُي، عَ شَ عَ يّتّ كٍرٍن فبَنسَن مَتٌ، <verse eid="GAL 6:4"/><verse number="5" style="v" sid="GAL 6:5"/>عَلَكٌ كَنكَن شَ عَ يّتّ شَ كٌتٍ شَنِن.<verse eid="GAL 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 6:6"/>مِشِ نَشَن شَرَنيِ سْتْمَ عَلَ شَ مَسٍنيِ شَ قٍ رَ، عَ لَنمَ عَ شَ عَ كَرَ مْشْ كِ قٍ قَنيِ مْولِ بِرِن نَ.<verse eid="GAL 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 6:7"/>مِشِ يٌ نَشَ وٌ مَدَشُ. عَدَ مَدِ مُ نْمَ عَلَ مَدَشُدٍ. كَنكَن قَمَ عَ يّتّ شَ وَلِ سَرٍ سْتْدٍ نّ. <verse eid="GAL 6:7"/><verse number="8" style="v" sid="GAL 6:8"/>مِشِ نَشَن بِرَ مَ عَ يّتّ وَشْنقٍ حَاشِ قْشْ رَ، عَ قَمَ نّ سْنتْدٍ نَ شَشِلِ كٌبِ شَ قٍ رَ. كْنْ مِشِ نَشَن بِرَ مَ عَلَ شَشِلِ وَشْنقٍ قْشْ رَ، عَ قَمَ كِسِدٍ عَلَ شَشِلِ نَن سَابُي رَ. <verse eid="GAL 6:8"/><verse number="9" style="v" sid="GAL 6:9"/>وٌن نَشَ تَفَن قٍ قَنيِ رَبَقٍ رَ. شَ وٌن مُ تَفَن، وٌن قَمَ نّ سَرٍ قَنيِ سْتْدٍ عَ وَشَتِ. <verse eid="GAL 6:9"/><verse number="10" style="v" sid="GAL 6:10"/>شَ وٌن نْمَ قٍ قَنيِ ندٍ رَبَدٍ، وٌن شَ عَ رَبَ مِشِ بِرِن بّ. عَ فبٍنفبٍنيِ وٌن شَ عَ رَبَ وٌن نفَشَكٍرٍنيِ دَنشَنِيَتْييٍ بّ دَنفِقٍ مِشِ بِرِن نَ.<verse eid="GAL 6:10"/></para>
  <para style="s">حُنفُي</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 6:11"/>وٌ يِ سّبّلِ مَتٌ، عَ شْرِ شُنفبٌ، بَرِ مَ ﭑ نَ عَ سّبّقٍ ﭑ يّتّ بّلّشّ نَن نَ.<verse eid="GAL 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 6:12"/>مِشِ نَشٍيٍ نَ وٌ كَرَشَنقٍ وٌ شَ سُننَ، عٍ وَ مَ نّ حَمَ شَ عٍ مَتْشْ. عٍ نَ نَ رَبَقٍ نّ عَلَكٌ عٍ نَشَ حَشَنكَتّ سْتْ كَوَندِ شَ قٍ رَ، نَشَن عَلَ شَ مِشِ سُفَندِشِ شَ سّرّشّ مَسٍنمَ. <verse eid="GAL 6:12"/><verse number="13" style="v" sid="GAL 6:13"/>سُننَمِشِيٍ يَتِ مُ عَلَ شَ يَامَرِ بِرِن نَتِنمّمَ، كْنْ عٍ وَ مَ وٌ تَن شَ سُننَ، عَلَكٌ عٍ شَ شِلِ قَنيِ سْتْ نَ شَ قٍ رَ. <verse eid="GAL 6:13"/><verse number="14" style="v" sid="GAL 6:14"/>كْنْ ﭑ تَن، ﭑ وَ مَ شِلِ قَنيِ سْتْقٍ وٌن مَرِفِ عِسَ عَلَ شَ مِشِ سُفَندِشِ شَ سّرّشّ نَن مَ قٍ رَ، نَشَن بَرَ عَ نِيَ ﭑ حّرّ كِ نُن دُنِحَ حّرّ كِ، عٍ تَفِ شَ عِكُيَ. <verse eid="GAL 6:14"/><verse number="15" style="v" sid="GAL 6:15"/>سُننّ نُن سُننَتَرٍيَ تِدٍ يٌ مُ نَ نَ. قِندِقٍ مِشِ نّينّ رَ، نَ نَن تِدٍ فبٌ. <verse eid="GAL 6:15"/><verse number="16" style="v" sid="GAL 6:16"/>عَلَ شَ بْحّسَ نُن هِننّ قِ مِشِ بِرِن مَ نَشٍيٍ بِرَ مَ نَ سّرِيّ قْشْ رَ، عَ نُن عَ شَ حَمَ عِسِرَيِلَ.<verse eid="GAL 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 6:17"/>عَ دْنشْي رَ، مِشِ يٌ نَشَ ﭑ تْورْ، بَرِ مَ عِسَ شَ تْورّ قْشِ نَ ﭑ قَتٍ مَ. <verse eid="GAL 6:17"/><verse number="18" style="v" sid="GAL 6:18"/>ﭑ نفَشَكٍرٍنيِيٍ، وٌن مَرِفِ عِسَ، عَلَ شَ مِشِ سُفَندِشِ شَ هِننّ وٌ شَشِلِ رَ. عَمِنَ.<verse eid="GAL 6:18"/></para>
  <chapter eid="GAL 6"/>
</usx>
