<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="HOS" style="id"/>
  <para style="h">عَننَبِ هٌسٍ</para>
  <para style="toc1">عَلَ شَ مَسٍنيِ عَننَبِ هٌسٍ بّ</para>
  <para style="toc2">عَننَبِ هٌسٍ</para>
  <para style="toc3">هٌس</para>
  <para style="mt">عَلَ شَ مَسٍنيِ عَننَبِ هٌسٍ بّ</para>
  <para style="imt">مَسٍنيِ ندٍ يِ كِتَابُي شَ قٍ رَ</para>
  <para style="ip">عَلَتَلَ نَشَ مَسٍنيِ شْرْشْي تِ عِسِرَيِلَكَيٍ بّ عَننَبِ هٌسٍ سَابُي رَ. عَلَ نُ بَرَ عِسِرَيِلَ سُفَندِ عَ شَ قِندِ عَ شَ حَمَ رَ، عَ شَ لُ عَ شَ نِينِ بُن مَ، عَ شَ لُ عَ شَ يَامَرِ بُن مَ. كْنْ عِسِرَيِلَ مُ تِن نَ رَ. عٍ نَشَ بِرَ عَلَ فبّتّيٍ قْشْ رَ، عٍ قِندِ كُيٍ بَتُي رَ. عَلَ نَشَ شْنْ عٍ مَ عَ حَاشِ رَ، هَن عَ نَتّ تٌنفٌ عَ شَ عٍ لُ كَاقِرِ سَفٌي، عٍ شَ لُ كٌنيِيَ كُي.</para>
  <para style="ip">عَننَبِ هٌسٍ نَ مَسٍن نّ عِسِرَيِلَ بّ مِسَالِ ندٍ رَ نَشَن نْمَ قِندِدٍ تّرّننَ رَ وٌن بّ. عَ نَشَ عِسِرَيِلَ شَ وَلِ مَنِيَ لَنفٌيحَ رَ، عَ نَشَن نَبَمَ عَ شَ مْرِ رَ نَشَن نُ بَرَ عَ دْشْ سّرِيّ كِ مَ. عَ نَشّ لَنفٌي فِنّ نَشَن مّيمَ عَ شَ مْرِ قَنيِ رَ، نَشَن بَرَ قٍ قَنيِ مْولِ بِرِن نَبَ عَ بّ عَلَكٌ قُتِ شَ سَبَتِ، نَ فِنّ مْولِ بَرَ قِنسِرِوَلِيَ حَاشِ رَبَ. عِسِرَيِلَ عَ نَ مْولِ رَبَ نّ عَلَ رَ. عَلَ تٌ عٍ سُفَندِ، عَ نُ لَن نّ عٍ شَ لُ عَ سَفٌي، كْنْ عٍ مُ تِن نَ رَ. عٍ بِرَقٍ كُيٍ قْشْ رَ، نَ بَرَ لُ عَلْ يَنقَنتٍيَ لَنفٌي نَشَن نَبَمَ عَ شَ مْرِ قَنيِ رَ.</para>
  <para style="ip">نَ بِرِن كُي، عَلَ نُ نْمَ شْنْدٍ عَ شَ حَمَ مَ عَ حَاشِ رَ، عَ قَ عٍ بِرِن سْنتْ عٍ شَ يُنُبِ شَ قٍ رَ. كْنْ يِ كِتَابُي وَ مَ عَ مَسٍنقٍ نّ، عَلَ شَ شَنُنتٍيَ فبٌ عَدَ مَ بّ هَلِ نَ قِندِ يُنُبِتْي رَ. عَلَ مُ تَفَنمَ كِرَ قَنيِ مَسٍنقٍ يُنُبِتْي بّ عَلَكٌ عَ مَن شَ فبِلٍن عَلَ شَ نِينِ بُن مَ. عَ قٍ بِرِن نَبَمَ نّ عَلَكٌ عَدَ مَ شَ كِسِ، عَ شَ لُ كِرَ قَنيِ شْن مَ.</para>
  <para style="ip">عَلَ لَايِدِ نَشَن تٌنفٌ عِسِرَيِلَ بّ، عَ شَ عٍ رَفبِلٍن عٍ شَ وَلِ كٌبِ قْشْ رَ، عَ نَ لَايِدِ تٌنفٌمَ نّ وٌن قَن بّ. عَلَ وَ مَ وٌن نَمِنِقٍ سٍنتَنّ شَ يَامَرِ بُن مَ، عَ وَ مَ نّ وٌن شَ لُ عَ شَ دٍنبَيَ كُي كِسِ نُن هّيرِ نَ دّننَشّ. عَلَ شَ وٌن مَلِ تِنقٍ نَ رَ. عَمِنَ.</para>
  <para style="imte">عَلَ شَ مَسٍنيِ عَننَبِ هٌسٍ بّ</para>
  <chapter number="1" style="c" sid="HOS 1"/>
  <para style="s">عَننَبِ هٌسٍ شَ دٍنبَيَ</para>
  <para style="p">
    <verse number="1" style="v" sid="HOS 1:1"/>عَلَتَلَ نَشَ مَسٍنيِ تِ بٍيرِ شَ دِ هٌسٍ بّ، يُسِيَ، يٌتَمِ، عَشَسِ، نُن شٍسٍكِيَ مَنفّ شَ وَشَتِيٍ كُي يُدَيَ. يٍرٌبٌوَ مِ نَن نُ نَ عِسِرَيِلَ مَنفّ رَ.<verse eid="HOS 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="HOS 1:2"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ عَننَبِ هٌسٍ بّ؛ عَلَتَلَ نَشَ عَ قَلَ عَننَبِ هٌسٍ بّ، «سِفَ، عِ سَ لَنفٌي فِنّ ندٍ تٌنفٌ، عَ مَن شَ دِيٍ بَرِ عِ بّ، بَرِ مَ بٍكَيٍ لَنفٌيحَ نَن نَبَمَ عَلَتَلَ رَبّحِنقٍ كُي!» <verse eid="HOS 1:2"/><verse number="3" style="v" sid="HOS 1:3"/>هٌسٍ نَشَ سِفَ، عَ سَ فٌمٍرِ تٌنفٌ، دِبِلَيِمِ شَ دِ فِنّ. نَ نَشَ تّيفّ، عَ دِ بَرِ عَ بّ. <verse eid="HOS 1:3"/><verse number="4" style="v" sid="HOS 1:4"/>عَلَتَلَ نَشَ عَ مَسٍن هٌسٍ بّ، «عِ شَ عَ شِلِ سَ يِسِرٍيلِ، عَ فبٍ مُ لُشِ ﭑ شَ يٍهُ شَ دٍنبَيَ حَشَنكَتَ، بَرِ مَ عٍ قَشّ تِ نّ يِسِرٍيلِ. ﭑ عِسِرَيِلَ شَ مَنفّيَ حْنمَ نَ كِ نّ. <verse eid="HOS 1:4"/><verse number="5" style="v" sid="HOS 1:5"/>نَ لْشْي ﭑ عِسِرَيِلَ شَ فٍرٍ سٌي سّنبّ كَنَمَ نّ يِسِرٍيلِ تَا كُي.»<verse eid="HOS 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="HOS 1:6"/>فٌمٍرِ مَن نَشَ تّيفّ، عَ دِ فِنّ بَرِ. عَلَتَلَ نَشَ عَ مَسٍن هٌسٍ بّ، «عَ شِلِ سَ ‹مِشِ شْنشِ،› بَرِ مَ ﭑ مُ كِنِكِنِمَ عِسِرَيِلَ مَ، ﭑ مُ عَ شَ يُنُبِ شَقَرِ مَ سْنْن. <verse eid="HOS 1:6"/><verse number="7" style="v" sid="HOS 1:7"/>كْنْ ﭑ كِنِكِنِمَ نّ يُدَيَ تَن مَ، ﭑ قَ عَ رَكِسِ عَ مَرِفِ عَلَتَلَ سّنبّ رَ. ﭑ مُ عٍ رَكِسِمَ تَنبّ رَ، شَ نَ مُ عَ رَ سَنتِدّفّمَ رَ، فٍرٍ رَ، سٌييٍ رَ، نُن سٌي رَفِيٍ رَ.»<verse eid="HOS 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="HOS 1:8"/>فٌمٍرِ تٌ «مِشِ شْنشِ» دّ بَ، عَ مَن نَشَ تّيفّ، عَ دِ بَرِ عَ شَ مْرِ هٌسٍ بّ. <verse eid="HOS 1:8"/><verse number="9" style="v" sid="HOS 1:9"/>عَلَتَلَ نَشَ عَ مَسٍن، «عِ شَ عَ شِلِ سَ ‹ﭑ فبٍ مُ عَ رَ،› بَرِ مَ ﭑ مَ حَمَ مُ وٌ رَ سْنْن، وٌ مَرِفِ مُ ﭑ نَ سْنْن.»<verse eid="HOS 1:9"/></para>
  <chapter eid="HOS 1"/>
  <chapter number="2" style="c" sid="HOS 2"/>
  <para style="s">عِسِرَيِلَ فبِلٍنقٍ عَلَ مَ</para>
  <para style="q">
    <verse number="1" style="v" sid="HOS 2:1"/>عِسِرَيِلَكَيٍ قَمَ نّ وُيَدٍ</para>
  <para style="q" vid="HOS 2:1">عَلْ بَا دّ رَ مّيّنيِ،</para>
  <para style="q" vid="HOS 2:1">نَشَن مُ نْمَ مَنِيَدٍ،</para>
  <para style="q" vid="HOS 2:1">نَشَن مُ نْمَ كْنتِدٍ.</para>
  <para style="q" vid="HOS 2:1">سِنفٍ رَ، عَ نُ عَ قَلَمَ عٍ بّ دّننَشّ،</para>
  <para style="q" vid="HOS 2:1">«ﭑ مَ حَمَ مُ وٌ رَ،»</para>
  <para style="q" vid="HOS 2:1">عَ عَ قَلَمَ نّ عٍ بّ،</para>
  <para style="q" vid="HOS 2:1">«عَلَ حِحّ شَ دِيٍ.»<verse eid="HOS 2:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 2:2"/>يُدَ بْنسْييٍ نُن عِسِرَيِلَ بْنسْييٍ مَلَنمَ نّ،</para>
  <para style="q" vid="HOS 2:2">عٍ مَنفّ كٍرٍن سُفَندِ عٍ بِرِن بّ.</para>
  <para style="q" vid="HOS 2:2">نَ لْشْي شُنفبٍ عَلَ عٍ رَ مِنِمَ نّ كٌنيِيَ كُي،</para>
  <para style="q" vid="HOS 2:2">عَ عٍ رَ سَبَتِ عٍ شْنيِ.<verse eid="HOS 2:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="HOS 2:3"/>«وٌ شَ عَ قَلَ وٌ تَارَيٍ شَ قٍ رَ، ‹عَلَ شَ حَمَ.›</para>
  <para style="q" vid="HOS 2:3">وٌ شَ عَ قَلَ وٌ شُنيَيٍ شَ قٍ رَ، ‹عَلَ شَنُنتٍنيِيٍ.›<verse eid="HOS 2:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="HOS 2:4"/>وٌ شَ وٌ نفَ عِسِرَيِلَ كَلَمُ،</para>
  <para style="q" vid="HOS 2:4">بَرِ مَ ﭑ مَ فِنّ مُ عَ رَ،</para>
  <para style="q" vid="HOS 2:4">عَ شَ مْرِ مُ ﭑ قَن نَ!</para>
  <para style="q" vid="HOS 2:4">عَ شَ عَ شَ لَنفٌيحَ مَشِرِ سٍيٍ بَ عَ يَتَفِ مَ،</para>
  <para style="q" vid="HOS 2:4">عَ عَ شَ حّنفّيَ مَشِرِ سٍيٍ بَ عَ شِحّيٍ تَفِ.<verse eid="HOS 2:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="HOS 2:5"/>شَ نَ مُ عَ رَ، ﭑ عِسِرَيِلَ لُمَ عَ رَفٍلِ نَن نَ،</para>
  <para style="q" vid="HOS 2:5">عَلْ عَ نُ كِ نَشّ عَ بَرِ لْشْي.</para>
  <para style="q" vid="HOS 2:5">ﭑ عٍ شَ بْشِ مَقِندِ مَ نّ فبٍنفبٍرٍنيِ رَ،<verse eid="HOS 2:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 2:6"/>عَ قِندِ مَ يِرٍ مَشَرٍ نَن نَ.</para>
  <para style="q" vid="HOS 2:6">ﭑ عٍ قَشَمَ يٍ شْلِ نَن نَ.</para>
  <para style="q" vid="HOS 2:6">ﭑ مُ كِنِكِنِمَ عَ شَ دِيٍ مَ،</para>
  <para style="q" vid="HOS 2:6">بَرِ مَ لَنفٌي دِ نَن عٍ رَ.<verse eid="HOS 2:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="HOS 2:7"/>عٍ نفَ عٍ سْتْ لَنفٌيحَ نَن كُي.</para>
  <para style="q" vid="HOS 2:7">نَ بَرَ قِندِ يَافِ رَ عٍ بّ.</para>
  <para style="q" vid="HOS 2:7">عَ نَشَ عَ قَلَ، ‹ﭑ بِرَ مَ نّ ﭑ حّنفّيٍ قْشْ رَ،</para>
  <para style="q" vid="HOS 2:7">نَشٍيٍ دٌنسٍ نُن يٍ سٌمَ ﭑ يِ،</para>
  <para style="q" vid="HOS 2:7">نَشٍيٍ دُفِ قِمَ ﭑ مَ،</para>
  <para style="q" vid="HOS 2:7">نَشٍيٍ ﭑ كِمَ تُرٍ نُن مِنسٍ رَ.›<verse eid="HOS 2:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="HOS 2:8"/>ﭑ عِ شَ كِرَ قِندِ مَ تُنبٍ كُنسِ رَ نَ نَن مَ،</para>
  <para style="q" vid="HOS 2:8">ﭑ عِ رَبِلِن تّتّ رَ، عَلَكٌ عِ نَشَ كِرَ تٌ.<verse eid="HOS 2:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="HOS 2:9"/>عَ سِفَمَ عَ حّنفّيٍ قْشْ رَ،</para>
  <para style="q" vid="HOS 2:9">كْنْ عَ مُ عٍ مَسْتْمَ.</para>
  <para style="q" vid="HOS 2:9">عَ عٍ قٍنمَ، كْنْ عَ مُ عٍ تٌمَ.</para>
  <para style="q" vid="HOS 2:9">عَ عَ قَلَمَ نّ، ‹ﭑ شَ فبِلٍن ﭑ مَ مْرِ شْن،</para>
  <para style="q" vid="HOS 2:9">بَرِ مَ حّلّشِنيِ نُ نَ ﭑ بّ مّننِ دَنفِ يَكْسِ رَ.›<verse eid="HOS 2:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="HOS 2:10"/>عَ مُ عَ كٌلٌن قَ قَلَ ﭑ تَن نَن نُ بَلٌي سٌمَ عَ يِ،</para>
  <para style="q" vid="HOS 2:10">مّنفِ، تُرٍ، نُن مِنسٍ.</para>
  <para style="q" vid="HOS 2:10">ﭑ تَن نَن نُ فبٍتِ نُن شّيمَ قَن سٌمَ عَ يِ،</para>
  <para style="q" vid="HOS 2:10">كْنْ عَ نَشَ نَ بِرِن نَوَلِ بَلِ كُيٍ بّ.<verse eid="HOS 2:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="HOS 2:11"/>نَ نَن عَ تٌ ﭑ مَ مّنفِ نَ مْ، ﭑ عَ بَمَ عَ يِ.</para>
  <para style="q" vid="HOS 2:11">وّنِ بٌفِ بُندُ تّمُي، ﭑ نَ قَن بَمَ عَ يِ.</para>
  <para style="q" vid="HOS 2:11">شُرُ سٍ شَبٍ شَبَ تّمُي، ﭑ مُ تِنمَ عٍ شَ سٍ سْتْ،</para>
  <para style="q" vid="HOS 2:11">نَشَن نْمَ قِندِدٍ عٍ شَ دُفِيٍ رَ.<verse eid="HOS 2:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="HOS 2:12"/>يَكْسِ ﭑ شَ عَ رَيَافِ عَ حّنفّيٍ يَ شْرِ،</para>
  <para style="q" vid="HOS 2:12">عَلَكٌ مِشِ يٌ نَشَ عَ بَ ﭑ يِ رَ.<verse eid="HOS 2:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="HOS 2:13"/>ﭑ حّلّشِنيِ بِرِن بَمَ نّ عٍ يِ،</para>
  <para style="q" vid="HOS 2:13">عَلْ عٍ شَ مَلَبُي لْشْي سَلِ،</para>
  <para style="q" vid="HOS 2:13">عٍ شَ كِكٍ نّينّ سَلِ،</para>
  <para style="q" vid="HOS 2:13">عَ نُن عٍ شَ سَلِ بِرِن.<verse eid="HOS 2:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="HOS 2:14"/>ﭑ شَ عٍ شَ وّنِ بِلِيٍ، نُن عٍ شَ شْرّ بِلِيٍ كَنَ.</para>
  <para style="q" vid="HOS 2:14">عٍ نَشّ عَ نَ قِندِشِ عٍ شَ لَنفٌيحَ سَرٍ نَن نَ.</para>
  <para style="q" vid="HOS 2:14">ﭑ نَ سَنسِ بِرِن كَنَمَ نّ،</para>
  <para style="q" vid="HOS 2:14">عَ شَ قِندِ وُلَ رَ سُبٍيٍ سَبَتِمَ دّننَشّ.<verse eid="HOS 2:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="HOS 2:15"/>ﭑ عِسِرَيِلَ حَشَنكَتَمَ نّ،</para>
  <para style="q" vid="HOS 2:15">بَرِ مَ عَ سّرّشّ بَمَ بَلِ كُيٍ بّ،</para>
  <para style="q" vid="HOS 2:15">عَ لُ عَلْ لَنفٌي نَشَن عَ يّتّ مَشِرِ مَ دُفِ قَنيِ رَ،</para>
  <para style="q" vid="HOS 2:15">عَ بِرَ عَ حّنفّ قْشْ رَ.</para>
  <para style="q" vid="HOS 2:15">نَ كُي عَ نَشَ نّيمُ ﭑ تَن مَ.»</para>
  <para style="q" vid="HOS 2:15">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="HOS 2:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="HOS 2:16"/>«ﭑ عَ شَنِنمَ فبٍنفبٍرٍنيِ مَ نَ نَن مَ،</para>
  <para style="q" vid="HOS 2:16">ﭑ قَ وْيّنيِ حْشُنمّ قَلَ عَ بّ.<verse eid="HOS 2:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="HOS 2:17"/>عَ نَ كٍلِ مّننِ، ﭑ مَن وُرِ بٌفِلَيٍ قِ عَ مَ.</para>
  <para style="q" vid="HOS 2:17">عَكٌرِ فُلُنبَ قِندِ مَ نّ شَشِلِسَ رَ عَ بّ،</para>
  <para style="q" vid="HOS 2:17">عَ قَ سِفِ سَ عَلْ عَ قٌنِكٍ تّمُي</para>
  <para style="q" vid="HOS 2:17">عَلْ عَ مِنِ لْشْي مِسِرَ بْشِ رَ.»<verse eid="HOS 2:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="HOS 2:18"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ،</para>
  <para style="q" vid="HOS 2:18">«نَ لْشْي عِ ﭑ شِلِمَ نّ ‹ﭑ مَ مْرِ.›</para>
  <para style="q" vid="HOS 2:18">عِ مُ ﭑ شِلِمَ ‹ﭑ كَنيِ› سْنْن.<verse eid="HOS 2:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="HOS 2:19"/>ﭑ بَلِ كُيٍ شِلِيٍ بَمَ نّ عِ دّ عِ،</para>
  <para style="q" vid="HOS 2:19">عَلَكٌ عِ شَ نّيمُ عٍ مَ.<verse eid="HOS 2:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="HOS 2:20"/>نَ لْشْي ﭑ سَاتّ تٌنفٌمَ نّ عٍ بّ،</para>
  <para style="q" vid="HOS 2:20">نُن وُلَءِ سُبٍيٍ، شْنِيٍ، عَ نُن بُبُسٍيٍ رَ.</para>
  <para style="q" vid="HOS 2:20">ﭑ شَلِ، سَنتِدّفّمَ، نُن فٍرٍ بَمَ نّ عٍ شَ بْشِ مَ،</para>
  <para style="q" vid="HOS 2:20">عَلَكٌ عٍ شَ سَبَتِ نَا بْحّسَ كُي.<verse eid="HOS 2:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="HOS 2:21"/>ﭑ عِ قِندِ مَ ﭑ مَ فِنّ نَن نَ</para>
  <para style="q" vid="HOS 2:21">تِنشِنيِ، دُفُتّفّحَ، نُن هِننّ كُي.</para>
  <para style="q" vid="HOS 2:21">ﭑ مُ مّيمَ عِ رَ عَبَدَن.<verse eid="HOS 2:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="HOS 2:22"/>لَنلَنتٍيَ لُمَ نّ وٌن تَفِ،</para>
  <para style="q" vid="HOS 2:22">عِ قَ عَلَتَلَ كٌلٌن.»<verse eid="HOS 2:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="HOS 2:23"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ.</para>
  <para style="q" vid="HOS 2:23">«نَ لْشْي، ﭑ عِ شَ دُبّ سُشُمَ نّ.<verse eid="HOS 2:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="HOS 2:24"/>كٌورٍ تُنّ يٍ رَفٌرٌ مَ نّ بْشِ مَ.</para>
  <para style="q" vid="HOS 2:24">بْشِ بَلٌي رَ مِنِمَ نّ وٌ بّ.</para>
  <para style="q" vid="HOS 2:24">سَنسِيٍ وّنِ نُن تُرٍ قِمَ نّ وٌ مَ.</para>
  <para style="q" vid="HOS 2:24">يِسِرٍيلِ هَيِ بِرِن قَنمَ نّ.<verse eid="HOS 2:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="HOS 2:25"/>ﭑ عِسِرَيِلَ رَ سَبَتِمَ نّ نَ بْشِ مَ ﭑ يّتّ بّ.</para>
  <para style="q" vid="HOS 2:25">ﭑ نُ نَشَن مَ ‹مِشِ شْنشِ،›</para>
  <para style="q" vid="HOS 2:25">ﭑ كِنِكِنِمَ نّ عَ مَ.</para>
  <para style="q" vid="HOS 2:25">ﭑ نُ نَشَن مَ، ‹ﭑ مَ حَمَ مُ عَ رَ،›</para>
  <para style="q" vid="HOS 2:25">ﭑ عَ شِلِمَ نّ، ‹ﭑ مَ حَمَ.›</para>
  <para style="q" vid="HOS 2:25">عٍ قَن قَمَ ﭑ تَن نَن شِلِدٍ، ‹ﭑ مَرِفِ عَلَ.›»<verse eid="HOS 2:25"/></para>
  <chapter eid="HOS 2"/>
  <chapter number="3" style="c" sid="HOS 3"/>
  <para style="s">عَلَ شَ شَنُنتٍيَ عِسِرَيِلَ بّ</para>
  <para style="p">
    <verse number="1" style="v" sid="HOS 3:1"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، «عِ مَن شَ عِ شَ فِنّ شَنُ، هَلِ عَ تٌ يّنّ رَبَمَ عَ نُن عَ حّنفّيٍ رَ. نَ لُمَ نّ عَلْ عَلَتَلَ شَ شَنُنتٍيَ عِسِرَيِلَكَيٍ بّ، عٍ تَن نَشٍيٍ بِرَ مَ عَلَ فبّتّيٍ قْشْ رَ، عٍ نُ سّرّشّ بَ عٍ بّ.» <verse eid="HOS 3:1"/><verse number="2" style="v" sid="HOS 3:2"/>ﭑ نَشَ فبِلٍن نَ فِنّ شَ كٌتٍ دْشْ رَ فبٍتِ كٌلٍ قُ نُن سُولِ رَ، نُن مّنفِ بُسَلِ كٍرٍن نُن عَ تَفِ. <verse eid="HOS 3:2"/><verse number="3" style="v" sid="HOS 3:3"/>ﭑ نَشَ عَ قَلَ عَ بّ، «عِ شَ عِ رَشَرَ ﭑ شْنيِ. عِ نَشَ لَنفٌيحَ رَبَ سْنْن، عِ نَشَ شّمّ فبّتّ يٌ كٌلٌن قَ. ﭑ قَن لُمَ عِ بّ نَ كِ نّ.»<verse eid="HOS 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HOS 3:4"/>وَشَتِ شْننَكُيٍ كُي، عِسِرَيِلَ قَمَ نّ لُدٍ مَنفّ مُ نَ، يَرٍرَتِيٍ، سّرّشّيٍ، كُيٍيٍ، نُن عَلَ مَشْرِن سٍ شَنبِ. <verse eid="HOS 3:4"/><verse number="5" style="v" sid="HOS 3:5"/>نَ دَنفِ شَنبِ، عِسِرَيِلَكَيٍ فبِلٍنمَ نّ، عٍ قَ عٍ مَرِفِ عَلَتَلَ قٍن، عَ نُن عٍ شَ مَنفّ دَوُدَ. نَ تّمُي، عٍ قَمَ نّ فَاشُدٍ عَلَتَلَ يَ رَ، عٍ مَن لُ عَ شَ هِننّ بُن مَ تّمُي بِرِن.<verse eid="HOS 3:5"/></para>
  <chapter eid="HOS 3"/>
  <chapter number="4" style="c" sid="HOS 4"/>
  <para style="s">عِسِرَيِلَ شَ تِنشِنتَرٍيَ</para>
  <para style="q">
    <verse number="1" style="v" sid="HOS 4:1"/>عِسِرَيِلَكَيٍ، وٌ عَلَتَلَ شَ وْيّنيِ رَ مّ،</para>
  <para style="q" vid="HOS 4:1">بَرِ مَ كِيتِ نَ وٌ نُن عَلَتَلَ تَفِ.</para>
  <para style="q" vid="HOS 4:1">«نْندِ نُن هِننّ بَرَ حْن وٌ يَ مَ.</para>
  <para style="q" vid="HOS 4:1">وٌ مُ ﭑ كٌلٌنشِ عَلَ رَ وٌ شْنيِ سْنْن.<verse eid="HOS 4:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 4:2"/>دَنكّ مَتِقٍ، وُلٍ، قَشّ تِ، مُحّ، لَنفٌيحَ</para>
  <para style="q" vid="HOS 4:2">نَن فبَنسَن فبٌشِ وٌ يِ رَ.</para>
  <para style="q" vid="HOS 4:2">قَشّ تِمَ تّمُي بِرِن.<verse eid="HOS 4:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="HOS 4:3"/>وٌ شَ بْشِ قَمَ لُدٍ سُننُنيِ كُي نَ نَن مَ.</para>
  <para style="q" vid="HOS 4:3">نَشٍيٍ بِرِن سَبَتِشِ عَ مَ،</para>
  <para style="q" vid="HOS 4:3">عٍ قَشَمَ نّ عٍ نُن سُبٍيٍ، شْنِيٍ، نُن يّشّيٍ رَ.</para>
  <para style="q" vid="HOS 4:3">عٍ بِرِن قَشَمَ نّ.»<verse eid="HOS 4:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="HOS 4:4"/>«كْنْ مِشِ يٌ نَشَ كَلَمُي تِ،</para>
  <para style="q" vid="HOS 4:4">مِشِ يٌ نَشَ حَمَ رَكِيتِ.</para>
  <para style="q" vid="HOS 4:4">وٌ شَ حَمَ نَن وٌ تَن سّرّشّدُبّيٍ كَلَمُمَ.<verse eid="HOS 4:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="HOS 4:5"/>وٌ بِرَ مَ نّ يَنيِ رَ، وٌ بِرَ كْي رَ.</para>
  <para style="q" vid="HOS 4:5">هَلِ نَمِحْنمّيٍ، عٍ تَنتَنمَ.</para>
  <para style="q" vid="HOS 4:5">ﭑ قَمَ وٌ نفَ عِسِرَيِلَ قَشَدٍ نَ نَن مَ.<verse eid="HOS 4:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 4:6"/>ﭑ مَ حَمَ نَ قَشَقٍ، عَ كٌلٌنتَرٍيَ مَ.</para>
  <para style="q" vid="HOS 4:6">وٌ تٌ بَرَ وٌ مَكُيَ ﭑ كٌلٌنقٍ رَ،</para>
  <para style="q" vid="HOS 4:6">ﭑ قَن بَرَ وٌ مَكُيَ ﭑ مَ سّرّشّدُبّحَ رَ.</para>
  <para style="q" vid="HOS 4:6">وٌ تٌ بَرَ وٌ مَرِفِ عَلَ شَ سّرِيّ رَبّحِن،</para>
  <para style="q" vid="HOS 4:6">ﭑ قَن بَرَ وٌ شَ دِيٍ رَبّحِن.<verse eid="HOS 4:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="HOS 4:7"/>سّرّشّدُبّيٍ وُيَشِ كِ نَشّ،</para>
  <para style="q" vid="HOS 4:7">عٍ شَ يُنُبِيٍ قَن وُيَشِ نَ كِ نّ.</para>
  <para style="q" vid="HOS 4:7">ﭑ عٍ شَ بِنيّ مَسَرَ مَ يَافِ رَ نَ نَن مَ.<verse eid="HOS 4:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="HOS 4:8"/>عٍ بَلٌمَ ﭑ مَ حَمَ شَ سّرّشّيٍ رَ.</para>
  <para style="q" vid="HOS 4:8">نَ كُي، عٍ مَن نٍيٍ رَدِن يّ يُنُبِ رَبَقٍ مَ</para>
  <para style="q" vid="HOS 4:8">عٍ تَن يّتّ نَشَن نَبَمَ،</para>
  <para style="q" vid="HOS 4:8">عَلَكٌ عٍ مَن شَ سّرّشّ فبّتّيٍ سْتْ.<verse eid="HOS 4:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="HOS 4:9"/>حَمَ يٌ، سّرّشّدُبّيٍ يٌ،</para>
  <para style="q" vid="HOS 4:9">ﭑ عٍ بِرِن حَشَنكَتَمَ نّ عٍ شَ يُنُبِيٍ شَ قٍ رَ،</para>
  <para style="q" vid="HOS 4:9">ﭑ عٍ سَرٍ رَفبِلٍنمَ نّ عٍ مَ.»<verse eid="HOS 4:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="HOS 4:10"/>«عٍ عٍ دّفٍمَ نّ، كْنْ عٍ مُ قَمَ لُفَدٍ.</para>
  <para style="q" vid="HOS 4:10">عٍ كُيٍيٍ بَتُمَ نّ، كْنْ نٍيٍ مُ عٍ رَفٍينِمَ،</para>
  <para style="q" vid="HOS 4:10">بَرِ مَ عٍ بَرَ عَلَتَلَ رَبّحِن.<verse eid="HOS 4:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="HOS 4:11"/>عٍ لَنفٌيحَ رَبَمَ،</para>
  <para style="q" vid="HOS 4:11">عٍ بٍيرٍ مْولِ بِرِن مِنمَ.</para>
  <para style="q" vid="HOS 4:11">نَ نَن عٍ شَشِلِ كَنَشِ.<verse eid="HOS 4:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="HOS 4:12"/>ﭑ مَ حَمَ مَشْرِنيِ تِمَ كُيٍ مَ.</para>
  <para style="q" vid="HOS 4:12">عٍ يَابِ ندٍ سْتْمَ نَ وُرِ شُنتُنيِ رَ.</para>
  <para style="q" vid="HOS 4:12">لَنفٌيحَ رَبَقٍ بَرَ لُ عٍ بْحّ كُي.</para>
  <para style="q" vid="HOS 4:12">نَ بَرَ عٍ رَلْي،</para>
  <para style="q" vid="HOS 4:12">نَ بَرَ عٍ مَكُيَ عَلَ رَ.<verse eid="HOS 4:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="HOS 4:13"/>عٍ سّرّشّ بَمَ فٍيَيٍ قَرِ،</para>
  <para style="q" vid="HOS 4:13">مّننِ عٍ سُرَيِ قَن فَنمَ سّرّشّ رَ.</para>
  <para style="q" vid="HOS 4:13">عٍ نَ رَبَمَ وُرِ شُنفبٍيٍ بُن مَ، نِينِ فبٌ دّننَشّ.</para>
  <para style="q" vid="HOS 4:13">نَ كُي وٌ شَ دِ فِنّيٍ لَنفٌيحَ رَبَمَ،</para>
  <para style="q" vid="HOS 4:13">وٌ شَ مَمَدِيٍ قَن بَرَ قِندِ يّنّ رَبَيٍ رَ.»<verse eid="HOS 4:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="HOS 4:14"/>«ﭑ مُ قَمَ وٌ شَ دِ فِنّيٍ نُن وٌ شَ مَمَدِيٍ حَشَنكَتَدٍ عٍ شَ لَنفٌيحَ شَ قٍ رَ،</para>
  <para style="q" vid="HOS 4:14">بَرِ مَ وٌ تَن قَن حّنفّيٍ سُشُمَ.</para>
  <para style="q" vid="HOS 4:14">وٌ بِرِن سّرّشّ بَمَ كُيٍيٍ بّ.</para>
  <para style="q" vid="HOS 4:14">حَمَ شَشِلِتَرٍ لُمَ نَ فَنتَنيِ كُي.<verse eid="HOS 4:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="HOS 4:15"/>شَ عِسِرَيِلَ بَرَ بِرَ لَنفٌيحَ قْشْ رَ،</para>
  <para style="q" vid="HOS 4:15">وٌ تَن يُدَيَكَيٍ، وٌ نَشَ نَ مْولِ رَبَ.</para>
  <para style="q" vid="HOS 4:15">وٌ نَشَ سِفَ فِلِفَلِ، وٌ نَشَ تٍ بٍتِ عَوٍنِ.</para>
  <para style="q" vid="HOS 4:15">وٌ نَشَ وٌ كَلِ عَلَتَلَ شِلِ رَ مّننِ.<verse eid="HOS 4:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="HOS 4:16"/>شَ عِسِرَيِلَ لُمَ عَلْ نِنفٍ كَلَبَنتٍ،</para>
  <para style="q" vid="HOS 4:16">عَلَتَلَ مُ نْمَ عٍ رَبَلٌدٍ عَلْ يّشّي قَنيِيٍ،</para>
  <para style="q" vid="HOS 4:16">عٍ نَشٍيٍ دّ مَدٌنمَ قِيلِ شُنفبٍيٍ مَ.<verse eid="HOS 4:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="HOS 4:17"/>عٍقِرَ مِكَيٍ بَرَ كَنكَن كُيٍ مَ.</para>
  <para style="q" vid="HOS 4:17">وٌ شَ عٍ لُ نَ.<verse eid="HOS 4:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="HOS 4:18"/>عٍ شَ بٍيرٍ نَ حْن، عٍ شَ لَنفٌيحَ قَن تٌنفٌ.</para>
  <para style="q" vid="HOS 4:18">عٍ شَ مَنفّيٍ وَشِ يَافِ نَن تُن شْن مَ.<verse eid="HOS 4:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="HOS 4:19"/>قٌيٍ قَمَ عٍ رَ قَنَقَنَندٍ نَ نَن مَ.</para>
  <para style="q" vid="HOS 4:19">عٍ قَمَ نّ يَافِدٍ عٍ شَ سّرّشّيٍ شَ قٍ رَ.»<verse eid="HOS 4:19"/></para>
  <chapter eid="HOS 4"/>
  <chapter number="5" style="c" sid="HOS 5"/>
  <para style="s">عَلَ عِسِرَيِلَ مَكِيتِقٍ</para>
  <para style="q">
    <verse number="1" style="v" sid="HOS 5:1"/>«سّرّشّدُبّيٍ، وٌ يِ رَ مّ.</para>
  <para style="q" vid="HOS 5:1">عِسِرَيِلَكَيٍ، وٌ عَ مَتٌ.</para>
  <para style="q" vid="HOS 5:1">مَنفّ شَ دٍنبَيَ، وٌ وٌ تُلِ مَتِ.</para>
  <para style="q" vid="HOS 5:1">كِيتِ نَ وٌن تَفِ،</para>
  <para style="q" vid="HOS 5:1">بَرِ مَ وٌ بَرَ قِندِ فَنتَنيِ رَ مِسِثَ،</para>
  <para style="q" vid="HOS 5:1">وٌ بَرَ قِندِ يّلّ رَ تَبٌرٌ فٍيَ قَرِ.<verse eid="HOS 5:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 5:2"/>وٌ نَ مِشِ نَن تُن مَقَشَقٍ يِ كِ،</para>
  <para style="q" vid="HOS 5:2">ﭑ شَ ﭑ يَشَسٍرِ مَسَ وٌ بّ.»<verse eid="HOS 5:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="HOS 5:3"/>«ﭑ عٍقِرَ مِ كٌلٌن، عِسِرَيِلَ مُ نْشُنشِ ﭑ مَ.</para>
  <para style="q" vid="HOS 5:3">عٍقِرَ مِ نَ لَنفٌيحَ رَبَقٍ، عِسِرَيِلَ قَن بَرَ سٌ سّنِيّنتَرٍحَ كُي.<verse eid="HOS 5:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="HOS 5:4"/>عٍ شَ قٍ كٌبِيٍ بَرَ عٍ مَكُيَ عٍ مَرِفِ عَلَ رَ.</para>
  <para style="q" vid="HOS 5:4">لَنفٌيحَ شَشِلِ بَرَ لُ عٍ يَ مَ.</para>
  <para style="q" vid="HOS 5:4">عٍ مُ عَلَتَلَ كٌلٌن.<verse eid="HOS 5:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="HOS 5:5"/>عِسِرَيِلَ شَ يّتّ عِفبٌيَ نَن عَ نِيَمَ</para>
  <para style="q" vid="HOS 5:5">عٍ شَ بِرَ، عٍ نُن عٍقِرَ مِ.</para>
  <para style="q" vid="HOS 5:5">يُدَيَ قَن بِرَ مَ نّ عٍ شَ يُنُبِ سَابُي رَ.<verse eid="HOS 5:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 5:6"/>عٍ شُرُ سٍيٍ شَنِنمَ سّرّشّ رَ، عٍ شَ عَلَتَلَ قٍن،</para>
  <para style="q" vid="HOS 5:6">كْنْ عٍ مُ عَ تٌمَ بَرِ مَ عَ مَكُيَ عٍ رَ.<verse eid="HOS 5:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="HOS 5:7"/>عٍ بَرَ عَلَتَلَ يَنقَ، عٍ حّنفّ دِيٍ بَرِ.</para>
  <para style="q" vid="HOS 5:7">بٍينُن كِكٍ كٍرٍن، عٍ شَ بْشِ قَمَ نّ كَنَدٍ، عٍ قَ هَلَكِ.»<verse eid="HOS 5:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="HOS 5:8"/>«وٌ سَرَ قٍ فِبِيَ. وٌ شَ عَ قٍ رَ مَ.</para>
  <para style="q" vid="HOS 5:8">وٌ فٍرٍ سْنشْي عِتٍ بٍتِ عَوٍنِ.</para>
  <para style="q" vid="HOS 5:8">بُنيَمِنكَيٍ، يَشُييٍ نَ وٌ شَنبِ رَ.<verse eid="HOS 5:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="HOS 5:9"/>عٍقِرَ مِ حَشَنكَتَمَ نّ نَ لْشْي.</para>
  <para style="q" vid="HOS 5:9">عِسِرَيِلَ بْنسْي، ﭑ شَ نْندِ مَسٍن وٌ بّ.»<verse eid="HOS 5:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="HOS 5:10"/>«يُدَيَ كُنتِفِيٍ قَمَ نّ ﭑ مَ شْنّ كٌلٌندٍ،</para>
  <para style="q" vid="HOS 5:10">بَرِ مَ عٍ عِقُ بْشِ نَانِنيِيٍ مَ.<verse eid="HOS 5:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="HOS 5:11"/>عٍقِرَ مِكَيٍ قَن قَمَ نّ حَشَنكَتَدٍ،</para>
  <para style="q" vid="HOS 5:11">بَرِ مَ عٍ بِرَشِ عٍ يّتّ وَشْنقٍ نَن قْشْ رَ.<verse eid="HOS 5:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="HOS 5:12"/>ﭑ قِندِ مَ سُورِ نَن نَ عٍقِرَ مِ بْنسْي بّ،</para>
  <para style="q" vid="HOS 5:12">ﭑ لُ يُدَ بْنسْي بّ عَلْ قِ حَاشِ.<verse eid="HOS 5:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="HOS 5:13"/>عٍقِرَ مِ نُن يُدَيَ عَ كٌلٌن عٍ قُرَشِ.</para>
  <para style="q" vid="HOS 5:13">عٍقِرَ مِ سِفَمَ عَسِرِيَ،</para>
  <para style="q" vid="HOS 5:13">عَ شّيرَيٍ شّيمَ نَا مَنفّ شُنفبٍ شْن مَ،</para>
  <para style="q" vid="HOS 5:13">كْنْ عَ مُ نْمَ وٌ رَيَلَندٍ،</para>
  <para style="q" vid="HOS 5:13">عَ مُ نْمَ وٌ شَ قِيٍ بَرِدٍ.<verse eid="HOS 5:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="HOS 5:14"/>ﭑ لُمَ نّ عَلْ يّتّ عٍقِرَ مِ بّ،</para>
  <para style="q" vid="HOS 5:14">عَلْ يّتّ يْرّ يُدَيَ بّ.</para>
  <para style="q" vid="HOS 5:14">ﭑ نٍيٍ عِبْو مَ نّ، ﭑ سِفَ عٍ رَ،</para>
  <para style="q" vid="HOS 5:14">مِشِ يٌ مُ عٍ بَمَ ﭑ يِ.<verse eid="HOS 5:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="HOS 5:15"/>ﭑ شَ فبِلٍن ﭑ شْنيِ،</para>
  <para style="q" vid="HOS 5:15">هَن عٍ شَ عٍ شَ يُنُبِ كٌلٌن، عٍ قَ ﭑ قٍن.</para>
  <para style="q" vid="HOS 5:15">عٍ قَمَ نّ ﭑ قٍندٍ عٍ شَ تْورّ كُي.»<verse eid="HOS 5:15"/></para>
  <chapter eid="HOS 5"/>
  <chapter number="6" style="c" sid="HOS 6"/>
  <para style="s">عَلَتَلَ وَشْنقٍ</para>
  <para style="q">
    <verse number="1" style="v" sid="HOS 6:1"/>وٌ قَ بٍ، وٌن شَ فبِلٍن عَلَتَلَ مَ!</para>
  <para style="q" vid="HOS 6:1">عَ بَرَ وٌن تْورْ، كْنْ يَكْسِ عَ وٌن نَيَلَنمَ نّ.</para>
  <para style="q" vid="HOS 6:1">عَ بَرَ وٌن بْنبْ، كْنْ يَكْسِ عَ وٌن مَ قِيٍ مَشِرِ مَ نّ.<verse eid="HOS 6:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 6:2"/>شِ قِرِن نَ دَنفِ، عَ قَمَ نّ وٌن نَيَلَندٍ،</para>
  <para style="q" vid="HOS 6:2">عَ شِ سَشَن ندٍ عَ وٌن نَكٍلِ، وٌن قَ لُ عَ سّيتِ مَ.<verse eid="HOS 6:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="HOS 6:3"/>وٌن شَ عَلَتَلَ قٍن، وٌن شَ عَ كٌلٌن.</para>
  <para style="q" vid="HOS 6:3">عَلَ قَقٍ مُ كَنَمَ.</para>
  <para style="q" vid="HOS 6:3">لْشْ يٌ لْشْ كُيٍ عِبَمَ، حّمّ بِرِن تُنّ قَمَ.</para>
  <para style="q" vid="HOS 6:3">عَلَ قَن مُ تٌندِ مَ قَدٍ وٌن يِرٍ.<verse eid="HOS 6:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="HOS 6:4"/>«ﭑ مُنسٍ رَبَمَ عِ تَن نَ، عٍقِرَ مِ؟</para>
  <para style="q" vid="HOS 6:4">ﭑ مُنسٍ رَبَمَ عِ رَ، يُدَيَ؟</para>
  <para style="q" vid="HOS 6:4">عِ شَ هِننّ ﭑ مَبِرِ، لُشِ نّ عَلْ شِنِ نَشَن فٌرٌ مَ فّيسّفّ،</para>
  <para style="q" vid="HOS 6:4">كْنْ بٍينُن سٌفٍ شَ شْنْ، عَ حْن.<verse eid="HOS 6:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="HOS 6:5"/>ﭑ وٌ فٍرٍ مَ نَمِحْنمّيٍ شَ مَسٍنيِيٍ رَ نَ نَن مَ،</para>
  <para style="q" vid="HOS 6:5">ﭑ وٌ قَشَمَ نّ ﭑ مَ مَسٍنيِيٍ رَ.</para>
  <para style="q" vid="HOS 6:5">ﭑ مَ كِيتِيٍ قِيشّ عَلْ نَءِيَلَنيِ.<verse eid="HOS 6:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 6:6"/>هِننّ رَقَن ﭑ مَ دَنفِقٍ سّرّشّ رَ،</para>
  <para style="q" vid="HOS 6:6">عَلَ كٌلٌنقٍ دَنفِ سّرّشّ فَن دَاشِيٍ رَ.<verse eid="HOS 6:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="HOS 6:7"/>عٍ بَرَ ﭑ مَ سَاتّ كَنَ،</para>
  <para style="q" vid="HOS 6:7">عَلْ عَدَ مَدِيٍ دَرِشِ عَ رَ كِ نَشّ.</para>
  <para style="q" vid="HOS 6:7">عٍ بَرَ ﭑ يَنقَ.<verse eid="HOS 6:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="HOS 6:8"/>مِشِ حَاشِ وُيَ فَلَدِ، قَشّتِيٍ بَرَ فبٌ نَا.<verse eid="HOS 6:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="HOS 6:9"/>سّرّشّدُبّيٍ بَفَنمَ مِشِ مَ سِكٍمِ كِرَ شْن مَ عَلْ مُحّتِيٍ.</para>
  <para style="q" vid="HOS 6:9">نَ قَشّ تِقٍ، قٍ حَاشِ نَ عَ رَ.<verse eid="HOS 6:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="HOS 6:10"/>ﭑ بَرَ قٍ حَاشِيٍ تٌ عِسِرَيِلَكَيٍ تَفِ؛</para>
  <para style="q" vid="HOS 6:10">عٍقِرَ مِ بَرَ لَنفٌيحَ رَبَ، عِسِرَيِلَ بَرَ نْشْ.<verse eid="HOS 6:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="HOS 6:11"/>يُدَيَ، ﭑ نَ فّ ﭑ مَ حَمَ رَفبِلٍندٍ كٌنيِيَ كُي،</para>
  <para style="q" vid="HOS 6:11">ﭑ وٌ قَن حَشَنكَتَمَ نّ.»<verse eid="HOS 6:11"/></para>
  <chapter eid="HOS 6"/>
  <chapter number="7" style="c" sid="HOS 7"/>
  <para style="s">عٍقِرَ مِ شَ يُنُبِيٍ</para>
  <para style="q">
    <verse number="1" style="v" sid="HOS 7:1"/>«ﭑ تٌ وَ عِسِرَيِلَ رَيَلَنقٍ،</para>
  <para style="q" vid="HOS 7:1">عٍقِرَ مِ شَ يُنُبِ مَن نَشَ مَكّنّن.</para>
  <para style="q" vid="HOS 7:1">سَمَرِ شَ قٍ حَاشِ نَشَ مِنِ كّنّ مَ.</para>
  <para style="q" vid="HOS 7:1">نَ يَنقَنتٍيٍ مُحّ تِمَ، عٍ يٍنسٍن يّ يِرٍ بِرِن.<verse eid="HOS 7:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 7:2"/>عٍ عٍ مَحْشُن ﭑ مُ رَتُشِ عٍ شَ كٌبِحَ مَ،</para>
  <para style="q" vid="HOS 7:2">كْنْ ﭑ عٍ شَ وَلِ بِرِن تٌمَ نّ.<verse eid="HOS 7:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="HOS 7:3"/>يِ مِشِ كٌبِيٍ رَقَن مَنفّ مَ،</para>
  <para style="q" vid="HOS 7:3">كُنتِفِيٍ تِنمَ عٍ شَ وَلِ رَ.<verse eid="HOS 7:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="HOS 7:4"/>عٍ شَ لَنفٌيحَ فبٌ عَلْ تّ شُنفبٍ،</para>
  <para style="q" vid="HOS 7:4">تَامِ فَنيِ نَشَن نَدّشّمَ،</para>
  <para style="q" vid="HOS 7:4">عَ قَ وٌلٍن هَن عَ فّ قَرِن نَقَلَدٍ.<verse eid="HOS 7:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="HOS 7:5"/>كُنتِفِيٍ سِيسِمَ نّ مَنفّ شَ شُلُنيِ،</para>
  <para style="q" vid="HOS 7:5">مَنفّ قَن تِنشِ نَ قٍ مْولِ رَ.<verse eid="HOS 7:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 7:6"/>عٍ بْحّ بَرَ تٍ عَلْ تّ شُنفبٍ،</para>
  <para style="q" vid="HOS 7:6">عٍ عٍ مَسٌ مَنفّ رَ، عٍ شَ عَ يَنقَ.</para>
  <para style="q" vid="HOS 7:6">عٍ نَ قٍ بِرِن شِرِ مَ كْي نَن نَ</para>
  <para style="q" vid="HOS 7:6">عَلَكٌ فّيسّفّ عٍ شَ وَلِ حَاشِ شَ كَمَلِ.<verse eid="HOS 7:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="HOS 7:7"/>عٍ بْحّ نَشَ تٍ هَن عٍ كِيتِسَيٍ بِرِن نَبِرَ،</para>
  <para style="q" vid="HOS 7:7">عٍ عٍ شَ مَنفّيٍ بِرِن قَشَ.</para>
  <para style="q" vid="HOS 7:7">نَ مِشِ مْولِ مُ ﭑ مَ كِيتِ مَمّمَ قٍقٍ مَ.<verse eid="HOS 7:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="HOS 7:8"/>عٍقِرَ مِ وَ مَ لُقٍ نّ عَلْ سِ فبّتّيٍ،</para>
  <para style="q" vid="HOS 7:8">كْنْ عَ لُشِ نّ عَلْ تَامِ نَشَن فَنشِ عَ حَاشِ رَ.<verse eid="HOS 7:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="HOS 7:9"/>سِ فبّتّيٍ عَ سّنبّ كَنَمَ، كْنْ عَ مُ عَ كٌلٌن.</para>
  <para style="q" vid="HOS 7:9">عَ قٌرِشِ، كْنْ عَ مُ نَ رَكْرْ سِ.<verse eid="HOS 7:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="HOS 7:10"/>عِسِرَيِلَ عَ يّتّ عِفبٌمَ، عَ مُ فبِلٍن عَ مَرِفِ عَلَتَلَ مَ،</para>
  <para style="q" vid="HOS 7:10">عَ مُ بِرَ عَ شَ سّرِيّ قْشْ رَ.<verse eid="HOS 7:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="HOS 7:11"/>عٍقِرَ مِ لُشِ نّ عَلْ فَنبّ شَشِلِتَرٍ.</para>
  <para style="q" vid="HOS 7:11">عَ مِسِرَكَيٍ شِلِمَ، عَ سَاتّ تٌنفٌمَ عَسِرِيَكَيٍ بّ.<verse eid="HOS 7:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="HOS 7:12"/>عٍ نَ سِفَ نَا، ﭑ قَمَ نّ ﭑ مَ يّلّ وٌلِدٍ عٍ مَ،</para>
  <para style="q" vid="HOS 7:12">عٍ شَ بِرَ عَلْ شْنِ.</para>
  <para style="q" vid="HOS 7:12">ﭑ عٍ حَشَنكَتَمَ نّ، عَلْ عَ مَسٍنشِ عٍ بّ عٍ شَ مَلَنيِ كُي كِ نَشّ.<verse eid="HOS 7:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="HOS 7:13"/>حَشَنكَتّ نَ عٍ بّ، بَرِ مَ عٍ بَرَ عٍ فِ ﭑ شُن مَ.</para>
  <para style="q" vid="HOS 7:13">فبَلٌي نَ عٍ بّ، بَرِ مَ عٍ بَرَ ﭑ مَتَندِ.</para>
  <para style="q" vid="HOS 7:13">ﭑ نُ وَشِ نّ عٍ شُن سَرَقٍ، كْنْ عٍ وُلٍيٍ سَمَ ﭑ شُن مَ.<verse eid="HOS 7:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="HOS 7:14"/>عٍ يَيٍ رَ مِنِمَ عٍ شَ سَدٍ مَ،</para>
  <para style="q" vid="HOS 7:14">كْنْ عٍ مُ سُننُنشِ عٍ بْحّ مَ.</para>
  <para style="q" vid="HOS 7:14">عٍ عٍ مَلَنمَ عَلَكٌ عٍ شَ دٌنسٍ نُن وّنِ قٍن،</para>
  <para style="q" vid="HOS 7:14">كْنْ عٍ عٍ مَكُيَمَ ﭑ تَن نَ.<verse eid="HOS 7:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="HOS 7:15"/>ﭑ تَن نَن عٍ شُرُ، ﭑ تَن نَن سّنبّ قِ عٍ مَ،</para>
  <para style="q" vid="HOS 7:15">كْنْ عٍ قِنسِرِوَلِيَ رَبَمَ ﭑ نَ.<verse eid="HOS 7:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="HOS 7:16"/>عٍ مُ عٍ يَ تِمَ كٌورٍ رَ،</para>
  <para style="q" vid="HOS 7:16">عٍ يَنقّ تِمَ عَلْ يَنقّ يِلِ.</para>
  <para style="q" vid="HOS 7:16">نَ نَن عَ رَ، عٍ كُنتِفِيٍ قَشَمَ سَنتِدّفّمَ رَ،</para>
  <para style="q" vid="HOS 7:16">عٍ يَافِ مِسِرَ بْشِ مَ عٍ شَ وْيّنيِ شَ قٍ رَ.»<verse eid="HOS 7:16"/></para>
  <chapter eid="HOS 7"/>
  <chapter number="8" style="c" sid="HOS 8"/>
  <para style="s">عِسِرَيِلَ شَ كُيٍ بَتُي</para>
  <para style="q">
    <verse number="1" style="v" sid="HOS 8:1"/>«وٌ شَ فٍرٍ سَرَ قٍ!</para>
  <para style="q" vid="HOS 8:1">يَشُي فٌرٌ مَ نّ عَلَتَلَ شَ بَنشِ مَ عَلْ سّفّ،</para>
  <para style="q" vid="HOS 8:1">بَرِ مَ حَمَ بَرَ ﭑ مَ لَايِدِ كَنَ،</para>
  <para style="q" vid="HOS 8:1">عٍ نَشَ مُرُتَ ﭑ مَ سّرِيّ مَ.<verse eid="HOS 8:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 8:2"/>عٍ ﭑ شِلِمَ،</para>
  <para style="q" vid="HOS 8:2">‹مُشُ مَرِفِ عَلَ، مُشُ عِ كٌلٌن، مُشُ تَن، عِسِرَيِلَ.›<verse eid="HOS 8:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="HOS 8:3"/>عِسِرَيِلَ تٌ بَرَ قٍ قَنيِ بّحِن،</para>
  <para style="q" vid="HOS 8:3">يَشُي بِرَ مَ نّ عَ قْشْ رَ.<verse eid="HOS 8:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="HOS 8:4"/>عٍ بَرَ مَنفّيٍ تِ ﭑ مَ يَامَرِ مُ نَشَن نَ،</para>
  <para style="q" vid="HOS 8:4">عٍ بَرَ كُنتِفِيٍ تِ عٍ مُ ﭑ مَشْرِن.</para>
  <para style="b" vid="HOS 8:4"/>
  <para style="q" vid="HOS 8:4">عٍ بَرَ كُيٍيٍ رَقَلَ عٍ شَ فبٍتِ نُن شّيمَ رَ.</para>
  <para style="q" vid="HOS 8:4">نٍيٍ هَلَكِمَ نَ نَن مَ.<verse eid="HOS 8:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="HOS 8:5"/>سَمَرِكَيٍ، وٌ وٌ شَ نِنفٍ كُيٍ وْلّ.</para>
  <para style="q" vid="HOS 8:5">ﭑ بَرَ شْنْ وٌ مَ عَ حَاشِ رَ.</para>
  <para style="q" vid="HOS 8:5">وٌ وٌ يّتّ مَنْشْمَ يِ قٍ مْولِ رَ هَن مُن تّمُي؟<verse eid="HOS 8:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 8:6"/>يِ كُيٍ قَتَنشِ وٌ تَن عِسِرَيِلَ نَن نَ.</para>
  <para style="q" vid="HOS 8:6">مِشِ ندٍ نَن عَ رَقَلَشِ، عَلَ مُ عَ رَ!</para>
  <para style="q" vid="HOS 8:6">سَمَرِ شَ نِنفٍ كُيٍ قَمَ نّ بُتُشُندٍ.<verse eid="HOS 8:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="HOS 8:7"/>نَشَن حّرّ مَ قٍ حَاشِ كُي،</para>
  <para style="q" vid="HOS 8:7">فبَلٌي قَمَ نّ عَ لِدٍ.</para>
  <para style="q" vid="HOS 8:7">هَلِ مّنفِ تْنسْي كٍرٍن، عٍ مُ عَ سْتْمَ شّ مَ.</para>
  <para style="q" vid="HOS 8:7">سَنسِ نَشَن بُلَمَ، عَ مُ قِندِ مَ بَلٌي رَ.</para>
  <para style="q" vid="HOS 8:7">هَلِ ندٍ قِندِ عَ رَ، سِ فبّتّ نَن عَ دٌنمَ.<verse eid="HOS 8:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="HOS 8:8"/>عٍ بَرَ عِسِرَيِلَ شُن نَكَنَ،</para>
  <para style="q" vid="HOS 8:8">عٍ عٍ شَنِن حَمَنّ كٌنيِيَ كُي.<verse eid="HOS 8:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="HOS 8:9"/>عِسِرَيِلَكَيٍ بَرَ سِفَ عَسِرِيَ بْشِ مَ،</para>
  <para style="q" vid="HOS 8:9">عَلْ سٌقَلٍ نَشَن لُمَ عَ كٍرٍن.<verse eid="HOS 8:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="HOS 8:10"/>هَلِ عٍ مِشِ نَشٍيٍ سَرَشِ سِيٍ تَفِ عٍ كَنتَقٍ مَ،</para>
  <para style="q" vid="HOS 8:10">ﭑ عٍ بِرِن مَلَنمَ نّ،</para>
  <para style="q" vid="HOS 8:10">عَلَكٌ عٍ شَ تْورْ مَنفّيٍ شَ كٌتٍ بُن مَ.<verse eid="HOS 8:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="HOS 8:11"/>عٍقِرَ مِ بَرَ سّرّشّبَدٍيٍ رَوُيَ</para>
  <para style="q" vid="HOS 8:11">عَلَكٌ عٍ شَ يُنُبِيٍ شَ شَقَرِ،</para>
  <para style="q" vid="HOS 8:11">كْنْ نَ سّرّشّبَدٍيٍ بَرَ عَ نِيَ</para>
  <para style="q" vid="HOS 8:11">عٍ شَ يُنُبِيٍ سْتْ.<verse eid="HOS 8:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="HOS 8:12"/>ﭑ بَرَ ﭑ مَ سّرِيّيٍ بِرِن سّبّ، عٍ شَ نَ كٌلٌن،</para>
  <para style="q" vid="HOS 8:12">كْنْ عٍ مُ تِدٍ تٌشِ عَ مَ.<verse eid="HOS 8:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="HOS 8:13"/>عٍ سّرّشّيٍ بَمَ ﭑ بّ، عٍ نَ سُبٍ دٌن،</para>
  <para style="q" vid="HOS 8:13">كْنْ نَ مُ رَقَن عَلَتَلَ مَ.</para>
  <para style="q" vid="HOS 8:13">يَكْسِ، عَلَتَلَ قَمَ نّ عٍ حَشَنكَتَدٍ عٍ شَ يُنُبِيٍ شَ قٍ رَ،</para>
  <para style="q" vid="HOS 8:13">عٍ شَ فبِلٍن مِسِرَ بْشِ مَ.<verse eid="HOS 8:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="HOS 8:14"/>عِسِرَيِلَ بَرَ نّيمُ عَلَ مَ، نَشَن عٍ دَاشِ.</para>
  <para style="q" vid="HOS 8:14">عٍ نَ مَنفّ بَنشِيٍ تِقٍ.</para>
  <para style="q" vid="HOS 8:14">يُدَيَ قَن نَ تَايٍ تِقٍ، نَشٍيٍ سّنبّ فبٌ،</para>
  <para style="q" vid="HOS 8:14">كْنْ ﭑ نَ بِرِن فَنمَ نّ تّ رَ.»<verse eid="HOS 8:14"/></para>
  <chapter eid="HOS 8"/>
  <chapter number="9" style="c" sid="HOS 9"/>
  <para style="s">عِسِرَيِلَ شَ حَشَنكَتّ</para>
  <para style="q">
    <verse number="1" style="v" sid="HOS 9:1"/>عِسِرَيِلَ، عِ نَشَ حّلّشِن،</para>
  <para style="q" vid="HOS 9:1">عِ نَشَ سّيوَ عَلْ سِ فبّتّيٍ.</para>
  <para style="q" vid="HOS 9:1">عِ تٌ عِ مَرِفِ عَلَ بّحِن، عِ بَرَ قِندِ لَنفٌي رَ.</para>
  <para style="q" vid="HOS 9:1">لَنفٌي مَسُندِ بَرَ رَقَن عِ مَ،</para>
  <para style="q" vid="HOS 9:1">عِ نَشَن سْتْمَ لٌنيِ يِرٍ.<verse eid="HOS 9:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 9:2"/>وٌ مُ بَلٌي سْتْمَ لٌنيِ يِرٍ،</para>
  <para style="q" vid="HOS 9:2">وٌ مُ وّنِ سْتْمَ وّنِ بٌفِ بُندُ سٍ كُي.<verse eid="HOS 9:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="HOS 9:3"/>عٍ مُ لُمَ عَلَتَلَ شَ بْشِ مَ،</para>
  <para style="q" vid="HOS 9:3">عٍقِرَ مِ فبِلٍنمَ نّ مِسِرَ،</para>
  <para style="q" vid="HOS 9:3">عٍ قَمَ دٌنسٍ هَرَ مُشِيٍ دٌندٍ عَسِرِيَ بْشِ مَ.<verse eid="HOS 9:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="HOS 9:4"/>عٍ مُ سّرّشّ يٍ دَاشِيٍ بَمَ عَلَتَلَ بّ.</para>
  <para style="q" vid="HOS 9:4">عٍ شَ سّرّشّيٍ مُ رَقَنمَ عَ مَ،</para>
  <para style="q" vid="HOS 9:4">عٍ لُمَ عَلْ حْن يِرٍ تَامِ.</para>
  <para style="q" vid="HOS 9:4">نَشٍيٍ نٍيٍ دٌنمَ عٍ قِندِ مَ سّنِيّنتَرٍيٍ نَن نَ.</para>
  <para style="q" vid="HOS 9:4">نَ قِندِ مَ دٌنسٍ نَن نَ عٍ بّ،</para>
  <para style="q" vid="HOS 9:4">كْنْ عَ مُ قِندِ مَ سّرّشّ رَ عَلَتَلَ بّ عَ شَ هْرْ مْبَنشِ كُي.<verse eid="HOS 9:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="HOS 9:5"/>وٌ مُنسٍ رَبَمَ سَلِ لْشْي عَلَتَلَ يَ عِ؟<verse eid="HOS 9:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="HOS 9:6"/>هَلِ عٍ سَ عٍ رَتَنفَ فبَلٌي مَ،</para>
  <para style="q" vid="HOS 9:6">مِسِرَكَيٍ قَمَ نّ عٍ قَشَدٍ، عٍ عٍ رَفَتَ نٌقِ.</para>
  <para style="q" vid="HOS 9:6">عٍ شَ هَرِفٍ بِرِن لْيمَ نّ، عٍ شْنيِ قِندِ مَ نّ وُلَ رَ.<verse eid="HOS 9:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="HOS 9:7"/>حَشَنكَتّ لْشْييٍ نَ قَقٍ، يُنُبِ سَرٍ رَفبِلٍنمَ تّمُي نَشّ.</para>
  <para style="q" vid="HOS 9:7">عِسِرَيِلَ شَ نَ كٌلٌن.</para>
  <para style="q" vid="HOS 9:7">عِسِرَيِلَ شَ يُنُبِ فبٌ،</para>
  <para style="q" vid="HOS 9:7">نَ نَ عَ رَ عٍ نَمِحْنمّيٍ شْنمَ،</para>
  <para style="q" vid="HOS 9:7">عٍ دَشُي شِلِ سَ عٍ شُن مَ.<verse eid="HOS 9:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="HOS 9:8"/>عَلَ نُن نَمِحْنمّيٍ عٍقِرَ مِ كَنتَمَ،</para>
  <para style="q" vid="HOS 9:8">كْنْ مِشِيٍ تَن فَنتَنيِ تٍمَ نَمِحْنمّيٍ بّ.</para>
  <para style="q" vid="HOS 9:8">عٍ مُ رَقَن مِشِيٍ مَ عَلَ شَ هْرْ مْبَنشِ كُي.<verse eid="HOS 9:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="HOS 9:9"/>عٍقِرَ مِكَيٍ بَرَ سٌ يَنقَنتٍيَ كُي،</para>
  <para style="q" vid="HOS 9:9">عَلْ نَشَن نَبَشِ فِبِيَ.</para>
  <para style="q" vid="HOS 9:9">عَلَ مُ نّيمُشِ عٍ شَ يُنُبِ مَ،</para>
  <para style="q" vid="HOS 9:9">عَ قَمَ عٍ حَشَنكَتَدٍ نَ نَن مَ.<verse eid="HOS 9:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="HOS 9:10"/>«ﭑ تٌ عِسِرَيِلَ تٌ،</para>
  <para style="q" vid="HOS 9:10">عَ نُ قَن عَلْ بٌفِ سٍ نَشَن تٌمَ وُلَ عِ.</para>
  <para style="q" vid="HOS 9:10">وٌ بٍنبَيٍ نُ لُشِ نّ عَلْ شْرّ بٌفِ سِنفٍيٍ،</para>
  <para style="q" vid="HOS 9:10">كْنْ عٍ نَشَ بِرَ كُيٍ شْنشِ قْشْ رَ</para>
  <para style="q" vid="HOS 9:10">نَشَن نُ نَ ثٍيٌرِ.<verse eid="HOS 9:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="HOS 9:11"/>عٍقِرَ مِ شَ بِنيّ سِفَمَ نّ عَلْ شْنِ نَشَن تُفَنمَ.</para>
  <para style="q" vid="HOS 9:11">دِ بَرِ مُ نَ، تّيفّ مُ نَ.<verse eid="HOS 9:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="HOS 9:12"/>شَ عَ سَ عَ لِ عٍ نَشَ دِيٍ شُرُ، ﭑ عٍ بِرِن بَمَ نّ عٍ يِ.</para>
  <para style="q" vid="HOS 9:12">عٍ قٍ حَاشِ سْتْمَ نّ ﭑ نَ عٍ رَبٌلٌ تّمُي نَشّ.<verse eid="HOS 9:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="HOS 9:13"/>ﭑ بَرَ عٍقِرَ مِ تٌ عَ سَبَتِشِ يِرٍ قَنيِ، عَلْ تِرٍ نَ كِ نَشّ،</para>
  <para style="q" vid="HOS 9:13">كْنْ عٍقِرَ مِ شَ دِيٍ سٌمَ نّ قَشّتِيٍ يِ رَ.»<verse eid="HOS 9:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="HOS 9:14"/>عَلَتَلَ، عَ لَنمَ عِ شَ مُنسٍ رَبَ عٍ بّ؟</para>
  <para style="q" vid="HOS 9:14">عِ شَ فِنّ قُرُشِيٍ قُرِ كَنَ، عِ شَ عٍ شِحّ شَرَ.<verse eid="HOS 9:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="HOS 9:15"/>عٍ حَاشُي بِرِن مَسٍنشِ نّ فِلِفَلِ.</para>
  <para style="q" vid="HOS 9:15">مّننِ ﭑ بَرَ عٍ شْن قْلْ عٍ شَ قٍ حَاشِيٍ شَ قٍ رَ.</para>
  <para style="q" vid="HOS 9:15">عٍ مُ رَقَنمَ ﭑ مَ سْنْن.</para>
  <para style="q" vid="HOS 9:15">عٍ شَ كُنتِفِيٍ قِندِشِ مَتَندِلَيٍ نَن نَ.<verse eid="HOS 9:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="HOS 9:16"/>«ﭑ بَرَ عٍقِرَ مِ بْنبْ.</para>
  <para style="q" vid="HOS 9:16">عَ لُشِ نّ عَلْ سَنسِ نَشَن سَنكٍ بَرَ شَرَ،</para>
  <para style="q" vid="HOS 9:16">عَ مُ بٌفِمَ سْنْن.</para>
  <para style="q" vid="HOS 9:16">شَ عٍقِرَ مِكَيٍ قَ دِيٍ بَرِ،</para>
  <para style="q" vid="HOS 9:16">ﭑ عٍ هَلَكِمَ نّ.»<verse eid="HOS 9:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="HOS 9:17"/>ﭑ مَرِفِ عَلَ قَمَ نّ عٍ رَبّحِندٍ،</para>
  <para style="q" vid="HOS 9:17">بَرِ مَ عٍ مُ عٍ تُلِ مَتِشِ عَ رَ.</para>
  <para style="q" vid="HOS 9:17">عٍ قِندِ مَ نّ بِيَاسِلَيٍ رَ سِيٍ تَفِ.<verse eid="HOS 9:17"/></para>
  <chapter eid="HOS 9"/>
  <chapter number="10" style="c" sid="HOS 10"/>
  <para style="s">عِسِرَيِلَ شَ مَكِيتِ</para>
  <para style="q">
    <verse number="1" style="v" sid="HOS 10:1"/>عِسِرَيِلَ لُشِ نّ عَلْ سَنسِ بِلِ قَنيِ نَشَن بٌفِمَ عَ قَنيِ رَ.</para>
  <para style="q" vid="HOS 10:1">كْنْ عَ شَ بٌفِ تٌ وُيَ، عَ نَشَ سّرّشّبَدٍ قَن رَوُيَ.</para>
  <para style="q" vid="HOS 10:1">عَ شَ بْشِ تٌ تٌقَن، عَ نَشَ تْنشُمَ فّمّ تِ كُيٍ بّ.<verse eid="HOS 10:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 10:2"/>عٍ بْحّ مُ نَ عَلَتَلَ فبَنسَن شَ رَ،</para>
  <para style="q" vid="HOS 10:2">نَ نَ عَ رَ عٍ بَرَ يُنُبِ سْتْ.</para>
  <para style="q" vid="HOS 10:2">عَلَتَلَ عٍ شَ سّرّشّبَدٍيٍ رَبِرَ مَ نّ،</para>
  <para style="q" vid="HOS 10:2">عَ عٍ شَ تْنشُمَ فّمّيٍ كَنَ.<verse eid="HOS 10:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="HOS 10:3"/>يَكْسِ عٍ عَ قَلَمَ،</para>
  <para style="q" vid="HOS 10:3">«مَنفّ مُ نَ مُشُ شُن مَ،</para>
  <para style="q" vid="HOS 10:3">بَرِ مَ مُشُ مُ فَاشُمَ عَلَتَلَ يَ رَ سْنْن.</para>
  <para style="q" vid="HOS 10:3">مَنفّ نْمَ مُنسٍ رَبَدٍ مُشُ بّ؟»<verse eid="HOS 10:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="HOS 10:4"/>عٍ وْيّنمَ، عٍ عٍ كَلِمَ، عٍ سَاتّ تٌنفٌمَ،</para>
  <para style="q" vid="HOS 10:4">كْنْ نَ بِرِن قُقَقُ.</para>
  <para style="q" vid="HOS 10:4">كِيتِ قَنيِ مُ لُمَ عٍ يِ،</para>
  <para style="q" vid="HOS 10:4">عَلْ حٌوفٍ حَاشِ نَشَن بُلَمَ شّ مَ.<verse eid="HOS 10:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="HOS 10:5"/>سَمَرِكَيٍ قَمَ نّ كْنتْقِلِدٍ عٍ شَ نِنفٍ كُيٍيٍ شَ قٍ رَ</para>
  <para style="q" vid="HOS 10:5">نَشٍيٍ نَ بٍتِ عَوٍنِ.</para>
  <para style="q" vid="HOS 10:5">حَمَ وَ تِمَ، سّرّشّدُبّيٍ قَن سُننُنمَ،</para>
  <para style="q" vid="HOS 10:5">بَرِ مَ عٍ حّلّشِنشِ نَشَن نَ، نَ قَمَ نّ بَدٍ عٍ يِ رَ.<verse eid="HOS 10:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 10:6"/>نَ كُيٍيٍ شَنِنمَ نّ عَسِرِيَ بْشِ مَ،</para>
  <para style="q" vid="HOS 10:6">عَ قَ لُ مَنفّ شُنفبٍ مَ.</para>
  <para style="q" vid="HOS 10:6">عٍقِرَ مِ يَافِمَ نّ،</para>
  <para style="q" vid="HOS 10:6">بِرِن قَمَ نّ يٌدٍ عِسِرَيِلَ شَ كّوَلِ مَ.<verse eid="HOS 10:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="HOS 10:7"/>سَمَرِ نُن عَ مَنفّ شَنِنمَ نّ،</para>
  <para style="q" vid="HOS 10:7">عَلْ وُرِ شُنتُنيِ يٍ نَشَن شَنِنمَ.<verse eid="HOS 10:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="HOS 10:8"/>كُيٍ بَتُدٍيٍ نَشٍيٍ نَ بٍتِ عَوٍنِ، عٍ كَنَمَ نّ.</para>
  <para style="q" vid="HOS 10:8">نَ سّرّشّبَدٍيٍ، عِسِرَيِلَكَيٍ يُنُبِ رَبَ دّننَشّ،</para>
  <para style="q" vid="HOS 10:8">عٍ قِندِ مَ تُنبٍ يِرٍيٍ نَن نَ.</para>
  <para style="q" vid="HOS 10:8">عٍ قَمَ نّ عَ قَلَدٍ فٍيَيٍ بّ،</para>
  <para style="q" vid="HOS 10:8">«مُشُ مَكٌتٌ، مُشُ رَفَتَ!»<verse eid="HOS 10:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="HOS 10:9"/>«عِسِرَيِلَ، كَبِ وٌ نَشَ نَ يُنُبِ حَاشِ رَبَ فِبِيَ،</para>
  <para style="q" vid="HOS 10:9">وٌ نَ يُنُبِ سْتْقٍ تُن.</para>
  <para style="q" vid="HOS 10:9">حَشَنكَتّ قَمَ عٍ لِدٍ فِبِيَ نَ نَن مَ.<verse eid="HOS 10:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="HOS 10:10"/>عَ بَرَ ﭑ كّنّن ﭑ شَ عٍ هَلَكِ.</para>
  <para style="q" vid="HOS 10:10">سِيٍ قَمَ نّ عٍ فٍرٍدٍ، عٍ عٍ سُشُ عٍ شَ يُنُبِ فبٍفبٍ شَ قٍ رَ.<verse eid="HOS 10:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="HOS 10:11"/>عٍقِرَ مِ لُشِ نّ عَلْ نِنفٍ شُرُشِ، وَلِ رَقَن نَشَن مَ.</para>
  <para style="q" vid="HOS 10:11">ﭑ قَمَ نّ لُوتِ شِرِدٍ عَ شُنيِ مَ، عَ شَ وَلِ رَبَ ﭑ بّ.</para>
  <para style="q" vid="HOS 10:11">يُدَيَ قَن شَ وَلِ، يَشُبَ بْنسْي شَ كٌتٍ شَنِن.<verse eid="HOS 10:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="HOS 10:12"/>وٌ شَ وَلِ تِنشِنشِ رَبَ،</para>
  <para style="q" vid="HOS 10:12">عَلَكٌ وٌ شَ قٍ قَنيِ سْتْ.</para>
  <para style="q" vid="HOS 10:12">وٌ شَ وَكِلِ نّينّ تٌنفٌ،</para>
  <para style="q" vid="HOS 10:12">وٌ شَ عَلَتَلَ قٍن هَن عَ قَ تّمُي وٌ يِرٍ،</para>
  <para style="q" vid="HOS 10:12">عَ تِنشِنيِ لُ وٌ بْحّ كُي.<verse eid="HOS 10:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="HOS 10:13"/>كْنْ وٌ تَن مُ تِن نَ وَلِ تِنشِنشِ رَ.</para>
  <para style="q" vid="HOS 10:13">وٌ بَرَ قٍ حَاشِ رَبَ.</para>
  <para style="q" vid="HOS 10:13">يَنقَنتٍيَ نُن يّتّ عِفبٌحَ بَرَ فبٌ وٌ يِ رَ.</para>
  <para style="q" vid="HOS 10:13">وٌ بَرَ لَ وٌ شَ سْورِيٍ سّنبّ رَ،<verse eid="HOS 10:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="HOS 10:14"/>كْنْ عٍ يَ قَمَ عِسٌدٍ،</para>
  <para style="q" vid="HOS 10:14">عٍ شَ يِرٍ كَنتَشِيٍ قَمَ نّ كَنَدٍ،</para>
  <para style="q" vid="HOS 10:14">عَلْ نَ فٍرٍ لْشْي سَلَمَن شُتُ سْتْ بٍتِ عَرَبٍلِ شُن مَ تّمُي نَشّ.</para>
  <para style="q" vid="HOS 10:14">نَ لْشْي فِنّيٍ نُن عٍ شَ دِ بِرِن قَشَ نّ.<verse eid="HOS 10:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="HOS 10:15"/>نَ مْولِ قَمَ نّ بٍتٍلِ لِدٍ</para>
  <para style="q" vid="HOS 10:15">عَ شَ يُنُبِيٍ شَ قٍ رَ.</para>
  <para style="q" vid="HOS 10:15">سُبَشّ نَ عَ لِ، عِسِرَيِلَ مَنفّ قَشَمَ نّ.»<verse eid="HOS 10:15"/></para>
  <chapter eid="HOS 10"/>
  <chapter number="11" style="c" sid="HOS 11"/>
  <para style="s">عَلَ شَ كِنِكِنِ</para>
  <para style="q">
    <verse number="1" style="v" sid="HOS 11:1"/>«ﭑ عِسِرَيِلَ شَنُ نّ عَ دِ مّدِ تّمُي.</para>
  <para style="q" vid="HOS 11:1">ﭑ نَشَ ﭑ مَ دِ شِلِ عَ شَ كٍلِ مِسِرَ بْشِ مَ.<verse eid="HOS 11:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 11:2"/>كْنْ ﭑ تٌ نُ عٍ شِلِمَ، عٍ نَشَ عٍ مَكُيَ ﭑ نَ،</para>
  <para style="q" vid="HOS 11:2">عٍ سّرّشّ بَ بَلِ كُيٍيٍ بّ، عٍ سُرَيِ فَن فّمّ مَسٌلِشِيٍ بّ.<verse eid="HOS 11:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="HOS 11:3"/>ﭑ تَن نَن نُ عٍقِرَ مِ مَلِقٍ عَ شَ حّرّ كُي،</para>
  <para style="q" vid="HOS 11:3">كْنْ عٍ مُ عَ كٌلٌنشِ عَ ﭑ تَن نَن نُ مّينِقٍ عٍ مَ.<verse eid="HOS 11:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="HOS 11:4"/>ﭑ نُ نَ عٍ مَبّندُنقٍ مَرَقَنيِ نُن شَنُنتٍيَ رَ.</para>
  <para style="q" vid="HOS 11:4">ﭑ تَن نَن عٍ رَ مِنِ كٌنيِيَ كُي،</para>
  <para style="q" vid="HOS 11:4">عَلَكٌ عٍ شَ بَلٌ عَ قَنيِ رَ.<verse eid="HOS 11:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="HOS 11:5"/>يَكْسِ، هَلِ عٍ مُ قَ سَ فبِلٍن مِسِرَ بْشِ مَ،</para>
  <para style="q" vid="HOS 11:5">عَسِرِيَ نَن نْي سْتْمَ عٍ شُن نَ،</para>
  <para style="q" vid="HOS 11:5">بَرِ مَ عٍ بَرَ تٌندِ فبِلٍندٍ ﭑ مَ.<verse eid="HOS 11:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 11:6"/>نَ نَن عَ رَ سَنتِدّفّمَ قَمَ عٍ شَ تَايٍ لِدٍ،</para>
  <para style="q" vid="HOS 11:6">عَ قَ عٍ شْنيِ بِرِن كَنَ.</para>
  <para style="q" vid="HOS 11:6">عٍ وَشْنقٍ مُ سْونّيَمَ سْنْن.<verse eid="HOS 11:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="HOS 11:7"/>ﭑ مَ حَمَ بَرَ فبِلٍن ﭑ قْشْ رَ.</para>
  <para style="q" vid="HOS 11:7">هَلِ عٍ بِرِن ﭑ شِلِ، ﭑ مُ عٍ شُن نَكٍلِمَ.»<verse eid="HOS 11:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="HOS 11:8"/>«كْنْ عٍقِرَ مِ، ﭑ شَ عِ رَبّحِن دِ؟</para>
  <para style="q" vid="HOS 11:8">ﭑ شَ عِسِرَيِلَ رَبٌلٌ دِ؟</para>
  <para style="q" vid="HOS 11:8">ﭑ مُ نْمَ قٍ رَبَدٍ عِ رَ</para>
  <para style="q" vid="HOS 11:8">عَلْ ﭑ نَشَن نَبَشِ عَدَ مَهَ.</para>
  <para style="q" vid="HOS 11:8">ﭑ شَ عِ لُ عَلْ سٍبٌيِمِ؟</para>
  <para style="q" vid="HOS 11:8">تْورّ بَرَ ﭑ بْحّ سُشُ.</para>
  <para style="q" vid="HOS 11:8">ﭑ بَرَ كِنِكِنِ وٌ مَ.<verse eid="HOS 11:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="HOS 11:9"/>ﭑ بَرَ ﭑ مَ نَتّ مَسَرَ،</para>
  <para style="q" vid="HOS 11:9">ﭑ بْحّ بَرَ شِنبٍلِ.</para>
  <para style="q" vid="HOS 11:9">ﭑ بَرَ دِحّ عٍقِرَ مِ مَ، بَرِ مَ عَلَ نَن ﭑ نَ.</para>
  <para style="q" vid="HOS 11:9">عَدَ مَ مُ نَ ﭑ تَن نَ.</para>
  <para style="q" vid="HOS 11:9">سّنِيّنتْي نَن ﭑ نَ وٌ تَفِ.</para>
  <para style="q" vid="HOS 11:9">ﭑ بَرَ ﭑ مَ شْنّ لُ نَ.<verse eid="HOS 11:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="HOS 11:10"/>عٍ قَمَ نّ بِرَدٍ عَلَتَلَ قْشْ رَ.</para>
  <para style="q" vid="HOS 11:10">عَلَ نَ عَ شُي رَ مِنِ سّنبّ رَ عَلْ يّتّ مَفَاشُشِ،</para>
  <para style="q" vid="HOS 11:10">عٍ قَمَ نّ لُدٍ عَ شَنبِ رَ كٍلِقٍ سٌفٍفٌرٌدٍ مَبِرِ.<verse eid="HOS 11:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="HOS 11:11"/>عٍ كٍلِمَ نّ مِسِرَ بْشِ مَ عَلْ شْنِيٍ،</para>
  <para style="q" vid="HOS 11:11">عٍ كٍلِمَ نّ عَسِرِيَ بْشِ مَ عَلْ فَنبّيٍ.»</para>
  <para style="q" vid="HOS 11:11">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="HOS 11:11"/></para>
  <chapter eid="HOS 11"/>
  <chapter number="12" style="c" sid="HOS 12"/>
  <para style="s">عِسِرَيِلَ شَ يَنقَنتٍيَ</para>
  <para style="q">
    <verse number="1" style="v" sid="HOS 12:1"/>«عٍقِرَ مِ وَ مَ ﭑ مَدَشُقٍ.</para>
  <para style="q" vid="HOS 12:1">عِسِرَيِلَ وَ مَ ﭑ يَنقَقٍ.</para>
  <para style="q" vid="HOS 12:1">يُدَيَ تَن بِرَ مَ نّ عَلَ قْشْ رَ،</para>
  <para style="q" vid="HOS 12:1">عَ مُ لَنلَنتٍيَ كَنَ عَلَ سّنِيّنشِ مَبِرِ.<verse eid="HOS 12:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 12:2"/>عٍقِرَ مِ قٍ قُقَقُ قٍنمَ،</para>
  <para style="q" vid="HOS 12:2">عَ بِرَ مَ مِشِيٍ قْشْ رَ نَشٍيٍ نَ قُفٍ رَ.</para>
  <para style="q" vid="HOS 12:2">عَ شَ وُلٍيٍ نُن قٍ حَاشِيٍ فبٌ.</para>
  <para style="q" vid="HOS 12:2">عَ سَاتّ تٌنفٌمَ عَسِرِيَ بّ،</para>
  <para style="q" vid="HOS 12:2">عَ عٌلِوِ تُرٍ قِمَ نّ مِسِرَ مَنفّ مَ.<verse eid="HOS 12:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="HOS 12:3"/>عَلَ يُدَيَكَيٍ مَكِيتِمَ نّ،</para>
  <para style="q" vid="HOS 12:3">عَ يَشُبَ بْنسْي حَشَنكَتَمَ نّ،</para>
  <para style="q" vid="HOS 12:3">عَ قَ عَ شَ كّوَلِ سَرٍ رَفبِلٍن عَ مَ.»<verse eid="HOS 12:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="HOS 12:4"/>عٍ نَ عٍ نفَ قُرِ كُي، يَشُبَ نَشَ عَ تَارَ تِنفِلِنيِ سُشُ.</para>
  <para style="q" vid="HOS 12:4">عَ تٌ قٌرِ، عٍ نُن عَلَ نَشَ فٍرٍ سٌ.<verse eid="HOS 12:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="HOS 12:5"/>عٍ نُن مَلٍكّ نَشَ فٍرٍ سٌ، عَ شُتُ سْتْ عَ مَ.</para>
  <para style="q" vid="HOS 12:5">عَ نَشَ وَ، عَ عَ مَيَندِ عَ شَ هِننّ عَ رَ.</para>
  <para style="q" vid="HOS 12:5">يَشُبَ عَ تٌ نّ بٍتٍلِ.</para>
  <para style="q" vid="HOS 12:5">عٍ نُن عَلَ وْيّن مّننِ نّ.<verse eid="HOS 12:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 12:6"/>عَلَتَلَ نَن مَنفّ رَ.</para>
  <para style="q" vid="HOS 12:6">شِلِ شُنفبٍ كَنيِ نَن عَلَتَلَ رَ.<verse eid="HOS 12:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="HOS 12:7"/>عِ تَن شَ قَ عِ مَرِفِ عَلَ مَ،</para>
  <para style="q" vid="HOS 12:7">عِ نَشَ دُفُتّفّحَ كَنَ،</para>
  <para style="q" vid="HOS 12:7">عِ شَ سّرِيّ تِنشِنشِ سُشُ.</para>
  <para style="q" vid="HOS 12:7">عِ شَشِلِ تِ عِ مَرِفِ عَلَ رَ تّمُي بِرِن.<verse eid="HOS 12:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="HOS 12:8"/>يُلّ سِكٍيلِ وُلٍ رَوَلِمَ، عَ مِشِ تْورْ.<verse eid="HOS 12:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="HOS 12:9"/>عٍقِرَ مِ بَرَ عَ قَلَ،</para>
  <para style="q" vid="HOS 12:9">«ﭑ بَرَ بَننَ هَن!</para>
  <para style="q" vid="HOS 12:9">ﭑ بَرَ نَاقُلِ سْتْ ﭑ يّتّ سّنبّ رَ.</para>
  <para style="q" vid="HOS 12:9">ﭑ مُ يُنُبِ يٌ رَبَشِ.»<verse eid="HOS 12:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="HOS 12:10"/>«ﭑ تَن نَن عِ مَرِفِ عَلَتَلَ رَ،</para>
  <para style="q" vid="HOS 12:10">نَشَن عِ رَ مِنِشِ مِسِرَ بْشِ مَ.</para>
  <para style="q" vid="HOS 12:10">ﭑ مَن عِ رَدْشْمَ نّ كِرِ بَنشِيٍ كُي،</para>
  <para style="q" vid="HOS 12:10">عَلْ وٌن مَ سَلِ تّمُي دَنفِشِيٍ.<verse eid="HOS 12:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="HOS 12:11"/>ﭑ نُ وْيّنمَ نَمِحْنمّيٍ بّ،</para>
  <para style="q" vid="HOS 12:11">ﭑ لَامَتُنيِيٍ وُيَشِ سٌ عٍ يِ رَ.</para>
  <para style="q" vid="HOS 12:11">ﭑ نُ تَالِيٍ مَسٍنمَ وٌ بّ نَمِحْنمّيٍ سَابُي رَ.<verse eid="HOS 12:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="HOS 12:12"/>فَلَدِكَيٍ لُمَ نّ قٍ حَاشِ رَبَ رَ.</para>
  <para style="q" vid="HOS 12:12">نَ قٍ نَ عَ نِيَمَ ﭑ قَمَ عٍ شُن نَكَنَدٍ.</para>
  <para style="q" vid="HOS 12:12">عٍ نِنفٍيٍ بَمَ سّرّشّ رَ فِلِفَلِ،</para>
  <para style="q" vid="HOS 12:12">كْنْ ﭑ قَمَ نّ عٍ شَ سّرّشّبَدٍيٍ كَنَدٍ،</para>
  <para style="q" vid="HOS 12:12">عٍ شَ لُ عَلْ فّمّ مَلَنشِيٍ شّيٍ مَ.»<verse eid="HOS 12:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="HOS 12:13"/>يَشُبَ نَشَ عَ فِ عَرَ مِ بْشِ مَ.</para>
  <para style="q" vid="HOS 12:13">عِسِرَيِلَ نَشَ قِندِ شُرُ سٍيٍ دّ مَدٌنيِ رَ،</para>
  <para style="q" vid="HOS 12:13">عَلَكٌ عَ شَ فِنّ ندٍ سْتْ.<verse eid="HOS 12:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="HOS 12:14"/>عَلَتَلَ نَشَ عِسِرَيِلَ رَ مِنِ مِسِرَ بْشِ مَ</para>
  <para style="q" vid="HOS 12:14">نَمِحْنمّ ندٍ سَابُي رَ.</para>
  <para style="q" vid="HOS 12:14">عَلَتَلَ نَشَ مّينِ عِسِرَيِلَ مَ عَ شَ شّيرَيٍ سَابُي رَ.<verse eid="HOS 12:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="HOS 12:15"/>عٍقِرَ مِ بَرَ عَلَتَلَ رَشْنْ عَ حَاشِ رَ.</para>
  <para style="q" vid="HOS 12:15">عٍ مَرِفِ قَمَ نّ عٍ حَشَنكَتَدٍ عٍ شَ قَشّ تِشِيٍ شَ قٍ رَ،</para>
  <para style="q" vid="HOS 12:15">عَ قَ عٍ رَيَافِ.<verse eid="HOS 12:15"/></para>
  <chapter eid="HOS 12"/>
  <chapter number="13" style="c" sid="HOS 13"/>
  <para style="s">عَلَ شَ شْنّ</para>
  <para style="q">
    <verse number="1" style="v" sid="HOS 13:1"/>حَمَ نُ فَاشُمَ نّ عٍقِرَ مِ شَ وْيّنيِ يَ رَ،</para>
  <para style="q" vid="HOS 13:1">بَرِ مَ مِشِ بِنيّ نَن نُ عَ رَ،</para>
  <para style="q" vid="HOS 13:1">كْنْ عَ نَشَ يُنُبِ سْتْ بَلِ كُيٍ بَتُقٍ رَ، عَ قَ قَشَ.<verse eid="HOS 13:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 13:2"/>يَكْسِ عٍ مَن يُنُبِيٍ نَن نَبَمَ،</para>
  <para style="q" vid="HOS 13:2">عٍ كُيٍ رَقَلَمَ فبٍتِ رَ.</para>
  <para style="q" vid="HOS 13:2">عٍ كُيٍ يَءِلَنمَ،</para>
  <para style="q" vid="HOS 13:2">كْنْ شَبُي وَلِ فبَنسَن نَن عَ رَ.</para>
  <para style="q" vid="HOS 13:2">عٍ عَدَ مَدِيٍ بَمَ سّرّشّ رَ،</para>
  <para style="q" vid="HOS 13:2">عٍ نِنفٍ كُيٍ سُنبُمَ.<verse eid="HOS 13:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="HOS 13:3"/>نَ نَ عَ نِيَمَ عٍ قَمَ حْندٍ عَلْ كُندَ نَشَن فٌرٌ مَ فّيسّفّ،</para>
  <para style="q" vid="HOS 13:3">عَلْ شِنِ نَشَن يٌلٌنمَ فّيسّفّ،</para>
  <para style="q" vid="HOS 13:3">عَلْ مَالٍ لَفِ قٌيٍ نَشَن شَنِنمَ قٌيٍ رَ،</para>
  <para style="q" vid="HOS 13:3">عَلْ تُورِ نَشَن مِنِمَ كُرِ كُي.<verse eid="HOS 13:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="HOS 13:4"/>«ﭑ تَن نَن عِ مَرِفِ عَلَتَلَ رَ،</para>
  <para style="q" vid="HOS 13:4">نَشَن عِ رَ مِنِشِ مِسِرَ بْشِ مَ.</para>
  <para style="q" vid="HOS 13:4">عِ نَشَ عَلَ فبّتّ كٌلٌن قٌ ﭑ تَن.</para>
  <para style="q" vid="HOS 13:4">مَرَكِسِمَ مُ نَ عِ بّ بَ ﭑ تَن نَ.<verse eid="HOS 13:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="HOS 13:5"/>ﭑ حّنفِ سَشِ عِ شْن فبٍنفبٍرٍن يِرٍ.<verse eid="HOS 13:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 13:6"/>عٍ تٌ بَلٌي سْتْ، عٍ نَشَ لُفَ.</para>
  <para style="q" vid="HOS 13:6">عٍ تٌ لُفَ، عٍ نَشَ قِندِ يّتّ عِفبٌي رَ.</para>
  <para style="q" vid="HOS 13:6">نَ نَن عَ رَ عٍ نّيمُشِ ﭑ مَ.<verse eid="HOS 13:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="HOS 13:7"/>ﭑ لُمَ نّ عٍ بّ عَلْ يّتّ،</para>
  <para style="q" vid="HOS 13:7">نَشَن عَ نْشُنمَ كِرَ شْن هَن عَ سُبٍ سْتْ.<verse eid="HOS 13:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="HOS 13:8"/>ﭑ عٍ سُشُمَ نّ عَلْ سُبٍ شَاحّ، نَشَن مَ دِيٍ بَشِ عَ يِ.</para>
  <para style="q" vid="HOS 13:8">ﭑ عٍ عِبْو مَ نّ عَلْ يّتّ، نَشَن وُلَءِ سُبٍ قَشَمَ.</para>
  <para style="q" vid="HOS 13:8">وُلَ سُبٍيٍ مَن عٍ عِبْو مَ نّ.<verse eid="HOS 13:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="HOS 13:9"/>عِسِرَيِلَ، عِ بَرَ عِ يّتّ كَنَ،</para>
  <para style="q" vid="HOS 13:9">بَرِ مَ عِ بَرَ عِ مَلِمَ يَنقَ، نَشَن قِندِ ﭑ تَن نَ.<verse eid="HOS 13:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="HOS 13:10"/>عِ شَ مَنفّ نَ مِندٍن،</para>
  <para style="q" vid="HOS 13:10">نَشَن نُ لَنمَ عَ شَ وٌ رَكِسِ؟</para>
  <para style="q" vid="HOS 13:10">عِ شَ كِيتِسَيٍ نَ مِندٍن،</para>
  <para style="q" vid="HOS 13:10">عِ نُ وَ مَ نَشٍيٍ شْن عَلَكٌ عِ شَ مَنفّ نُن مَنفّدِيٍ سْتْ؟<verse eid="HOS 13:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="HOS 13:11"/>ﭑ تٌ شْنْ وٌ مَ، ﭑ بَرَ مَنفّ سٌ وٌ يِ رَ.</para>
  <para style="q" vid="HOS 13:11">يَكْسِ ﭑ عَ بَمَ نّ وٌ يِ رَ ﭑ مَ شْنّ كُي.<verse eid="HOS 13:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="HOS 13:12"/>عٍقِرَ مِ شَ قٍ حَاشِ بِرِن سّبّشِ،</para>
  <para style="q" vid="HOS 13:12">عَلَ مُ نّيمُمَ عَ شَ يُنُبِيٍ مَ.<verse eid="HOS 13:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="HOS 13:13"/>تْورّ قَمَ نّ عَ لِدٍ،</para>
  <para style="q" vid="HOS 13:13">عَلْ فِنّ نَشَن دِ بَرِ مَ.</para>
  <para style="q" vid="HOS 13:13">كْنْ دِ شَشِلِتَرٍ نَ عَ رَ.</para>
  <para style="q" vid="HOS 13:13">عَ بَرِ تّمُي نَ عَ لِ، عَ مُ تِنمَ مِنِدٍ عَ نفَ تّيفّ.»<verse eid="HOS 13:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="HOS 13:14"/>«ﭑ شَ عٍ شُن سَرَ عَلِفِيَمَ سّنبّ يِ؟</para>
  <para style="q" vid="HOS 13:14">ﭑ شَ عٍ رَكِسِ سَيَ مَ؟</para>
  <para style="q" vid="HOS 13:14">سَيَ، عِ شَ شْنّ نَ مِندٍن؟</para>
  <para style="q" vid="HOS 13:14">عَلِفِيَمَ، عِ شَ سّنبّ نَ مِندٍن؟</para>
  <para style="q" vid="HOS 13:14">ﭑ مُ كِنِكِنِمَ وٌ مَ قٍوٌ!<verse eid="HOS 13:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="HOS 13:15"/>هَلِ عَ سّنبّ فبٌ عَ نفَشَكٍرٍنيِيٍ تَفِ،</para>
  <para style="q" vid="HOS 13:15">عَلَتَلَ قٌيٍ شَرٍ رَقَمَ نّ</para>
  <para style="q" vid="HOS 13:15">كٍلِ فبٍنفبٍرٍنيِ سٌفٍتٍدٍ مَبِرِ،</para>
  <para style="q" vid="HOS 13:15">عَ قَ شُرٍيٍ نُن كْلْنيِيٍ شْرِدٍ.</para>
  <para style="q" vid="HOS 13:15">هَرِفٍ بِرِن بَمَ نّ عَ يِ رَ.»<verse eid="HOS 13:15"/></para>
  <chapter eid="HOS 13"/>
  <chapter number="14" style="c" sid="HOS 14"/>
  <para style="s">عِسِرَيِلَكَيٍ شَ تُوبِ عَلَتَلَ مَ</para>
  <para style="q">
    <verse number="1" style="v" sid="HOS 14:1"/>سَمَرِكَيٍ بَرَ يُنُبِ سْتْ عٍ مَرِفِ عَلَتَلَ مَتَندِقٍ رَ.</para>
  <para style="q" vid="HOS 14:1">نَ نَن عَ رَ عٍ قَشَمَ سَنتِدّفّمَ رَ،</para>
  <para style="q" vid="HOS 14:1">عٍ شَ دِيْرّيٍ وٌلِمَ نّ بْشِ مَ،</para>
  <para style="q" vid="HOS 14:1">عٍ شَ فِنّ قُرُشِيٍ قُرِ رَبْو مَ نّ.<verse eid="HOS 14:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="HOS 14:2"/>عِسِرَيِلَ، فبِلٍن عِ مَرِفِ عَلَتَلَ مَ،</para>
  <para style="q" vid="HOS 14:2">بَرِ مَ عِ شَ وَلِ كٌبِ بَرَ عِ رَبِرَ.<verse eid="HOS 14:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="HOS 14:3"/>وٌ تُوبِ عَلَتَلَ مَ، وٌ قَ يِ وْيّن قَنيِ قَلَ عَ بّ،</para>
  <para style="q" vid="HOS 14:3">«عِ شَ دِحّ مُشُ شَ يُنُبِيٍ مَ،</para>
  <para style="q" vid="HOS 14:3">عِ شَ هِننّ مُشُ رَ.</para>
  <para style="q" vid="HOS 14:3">مُشُ شَ تَنتُي بَ سّرّشّ رَ، تُورَيٍ شَ لُ نَ.<verse eid="HOS 14:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="HOS 14:4"/>عَسِرِيَ مُ نْمَ مُشُ رَكِسِدٍ،</para>
  <para style="q" vid="HOS 14:4">مُشُ مُ تٍمَ سٌييٍ قَرِ فٍرٍ شِلِ مَ.</para>
  <para style="q" vid="HOS 14:4">مُشُ مُ كُيٍيٍ شِلِمَ ‹مُشُ مَرِفِ عَلَ›</para>
  <para style="q" vid="HOS 14:4">نَشٍيٍ يَءِلَنشِ مِشِ بّلّشّ رَ.</para>
  <para style="q" vid="HOS 14:4">عِ تَن نَن فبَنسَن كِنِكِنِمَ كِرِدِيٍ مَ.»<verse eid="HOS 14:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="HOS 14:5"/>«ﭑ عٍ شَ يَنقَنتٍيَ يَءِلَنمَ نّ.</para>
  <para style="q" vid="HOS 14:5">ﭑ عٍ شَنُمَ نّ قٌنِسِرٍيَ رَ،</para>
  <para style="q" vid="HOS 14:5">بَرِ مَ ﭑ مَ شْنّ بَرَ فبِلٍن عٍ قْشْ رَ.<verse eid="HOS 14:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="HOS 14:6"/>ﭑ لُمَ نّ عِسِرَيِلَ بّ عَلْ شِنِ،</para>
  <para style="q" vid="HOS 14:6">عٍ تٌقَنمَ نّ عَلْ سَنسِ قُفَشِ.</para>
  <para style="q" vid="HOS 14:6">عٍ سَبَتِمَ نّ عَلْ وُرِ بِلِ قَنيِ نَشَن نَ لِبَن.<verse eid="HOS 14:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="HOS 14:7"/>عَ سَلٌنيِ كُيَمَ نّ.</para>
  <para style="q" vid="HOS 14:7">عَ تٌقَنمَ نّ عَلْ عٌلِوِ وُرِ،</para>
  <para style="q" vid="HOS 14:7">عَ شِرِ قَنيِ رَ مِنِمَ نّ عَلْ وٌندِ نَشَن نَ لِبَن.<verse eid="HOS 14:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="HOS 14:8"/>حَمَ مَن سَبَتِمَ نّ عِسِرَيِلَ بْشِ مَ عَلَ شَ نِينِ بُن مَ.</para>
  <para style="q" vid="HOS 14:8">عٍ شَ مّنفِ قَنمَ نّ.</para>
  <para style="q" vid="HOS 14:8">عٍ شَ قٍ حْشُنمَ نّ عَلْ وّنِ بٌفِ،</para>
  <para style="q" vid="HOS 14:8">عٍ قَ شِلِ قَنيِ سْتْ عَلْ لِبَن شَ وّنِ.<verse eid="HOS 14:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="HOS 14:9"/>عٍقِرَ مِ بْنسْي، مُنسٍ نَ ﭑ نُن كُيٍيٍ تَفِ؟</para>
  <para style="q" vid="HOS 14:9">ﭑ تَن نَن وٌ شَ دُبّ سُشُمَ،</para>
  <para style="q" vid="HOS 14:9">ﭑ نَن ﭑ حّنفِ سَمَ نّ وٌ شْن.</para>
  <para style="q" vid="HOS 14:9">ﭑ لُمَ نّ وٌ بّ عَلْ وُرِ شِندٍ قَنيِ.</para>
  <para style="q" vid="HOS 14:9">وٌ بَلٌي سْتْمَ ﭑ تَن نَن سَابُي رَ.»<verse eid="HOS 14:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="HOS 14:10"/>لْننِلَ يِ وْيّنيِ كٌلٌنمَ نّ.</para>
  <para style="q" vid="HOS 14:10">شَشِلِمَ يِ مَسٍنيِ قَهَامُمَ نّ.</para>
  <para style="q" vid="HOS 14:10">عَلَتَلَ شَ كِرَيٍ تِنشِن،</para>
  <para style="q" vid="HOS 14:10">تِنشِنتْييٍ حّرّ مَ نٍيٍ نَن شْن،</para>
  <para style="q" vid="HOS 14:10">كْنْ مَتَندِلَيٍ دِنكٌنمَ نٍيٍ نَن نَ.<verse eid="HOS 14:10"/></para>
  <chapter eid="HOS 14"/>
</usx>
