<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ISA" style="id"/>
  <para style="h">عَننَبِ عٍسَيِ</para>
  <para style="toc1">عَلَ شَ مَسٍنيِ عَننَبِ عٍسَيِ بّ</para>
  <para style="toc2">عَننَبِ عٍسَيِ</para>
  <para style="toc3">عٍسَ</para>
  <para style="mt">عَلَ شَ مَسٍنيِ عَننَبِ عٍسَيِ بّ</para>
  <para style="imt">مَسٍنيِ ندٍ يِ كِتَابُي شَ قٍ رَ</para>
  <para style="ip">عَننَبِ عٍسَيِ شَ كِتَابُي قِندِشِ مَسٍنيِ بٍلٍبٍلٍ نَن نَ دُنِحَ بِرِن بّ. عَلَتَلَ عَ شِلِشِ نّ، عَ شَ يُدَيَ مَنفّيٍ عٌسِيَسِ، يٌتَمِ، عَشَسِ، نُن شٍسٍكِيَ مَلِ عَ سَفٌ كٌلٌندٍ. مَنفّ ندٍيٍ نُ بِرَ مَ كُيٍيٍ قْشْ رَ، ندٍيٍ نُ عٍ يّتّ تَشُمَ مَنفّ بٌورٍيٍ رَ نَشٍيٍ سّنبّ فبٌ عٍ بّ. نَ بِرِن كُي عَننَبِ عٍسَيِ نَشَ عَ مَسٍن عٍ بّ، عَ عَلَتَلَ فبَنسَن نَن نْمَ مِشِ مَلِدٍ. كُيٍ تَن قِندِشِ وُرِ سّنبّتَرٍ نَن نَ. دُنِحَ مَنفّيٍ قَن قِندِشِ عِبُنَدَ مَ فبَنسَن نَن نَ، نَشٍيٍ مُ نْمَ سٍسٍ رَ عَلَ شَ مَرَفِرِ يَ رَ. عَلَتَلَ نَن قِندِشِ دُنِحَ مَنفّ سّنِيّنشِ رَ.</para>
  <para style="ip">عِسِرَيِلَ بْنسْي قُ نُن قِرِنيِ نُ قَتَنشِ مَنفّيَ قِرِن نَن نَ. نَشَن نُ نَ كْولَ مَبِرِ، عَ شِلِ عِسِرَيِلَ. نَشَن نُ نَ يِرٍقَنيِ مَبِرِ، عَ شِلِ يُدَيَ. عَننَبِ عٍسَيِ شَ كِتَابُي عَ مَسٍنمَ عٍ قِرِن بِرِن عَلَ مَتَندِشِ كِ نَشّ، عٍ قَ شَنِن كٌنيِيَ كُي حَمَنّ مَ نَ شَ قٍ رَ. بٍينُن نَ شَ رَبَ يُدَيَ، عَلَتَلَ نَشَ يِ مَسٍنيِ قِ عَ شَ نَمِحْنمّ مَ عَلَكٌ عَ شَ حَمَ شَ رَتَنفَ نَ بِرِن مَ، كْنْ حَمَ مُ تِن عٍ تُلِ مَتِدٍ عَلَ رَ. مَنفّ ندٍ عَلْ شٍسٍكِيَ نَشَ كَتَ بِرَدٍ عَلَ قْشْ رَ، كْنْ بٌورٍيٍ تَن مُ تِن نَ رَ قٍقٍ مَ.</para>
  <para style="ip">نَ كُي عَلَ شَ حَشَنكَتّ نَشَ بِرَ عٍ بِرِن قْشْ رَ، عٍ قَ شَنِن كٌنيِيَ كُي بَبِلْن بْشِ مَ. نَمِحْنمّ شَ كَوَندِ قِندِشِ مَرَ سِ نَن نَ وٌن بِرِن بّ. مِشِ نَشَن تٌندِ مَ عَ تُلِ مَتِدٍ عَلَتَلَ رَ، عَ شَ قٍ قَمَ نّ شُن نَكَنَدٍ. كْنْ عَننَبِ عٍسَيِ شَ مَسٍنيِ لُمَ نّ عَلْ بٌورٍ نَمِحْنمّيٍ شَ مَسٍنيِ. عٍ بِرِن عَ قَلَمَ عَ عِبُنَدَ مَ شَ يُنُبِيٍ عَ نِيَمَ نّ عٍ شَ حَشَنكَتّ سْتْ، كْنْ عٍ مَن عَلَ شَ هِننّ مَسٍنمَ نَشَن عَ نِيَمَ مِشِيٍ شَ تُوبِ، عٍ فبِلٍن عٍ شَ يُنُبِيٍ قْشْ رَ، عَلَ قَ عٍ رَكِسِ.</para>
  <para style="ip">عَلَ شَ كِسِ حْشُن. عَ قْلْمَ دُنِحَ نَن مَ، عَ قَ عَلِفِيَمَ لِ. مِشِ نَشٍيٍ بِرَ مَ عَلَ وَشْنقٍ قْشْ رَ، عٍ هّيرِ تٌمَ نّ نَ حّرّ كُي. دُنِحّءِفِرِ شْرْشْ، كْنْ نَشَن لُمَ عَلَ شَ قٍ كُي، عَ شُننَكٍلِ تٌمَ نّ. عَننَبِ عٍسَيِ مَن عَ مَسٍنمَ، يِ دُنِحَ نَ حْن، عَلَ قَمَ نّ عَ شَ حَمَ رَ سٌدٍ عَ شْنيِ، بْحّسَ نُن بَرَكَ لُمَ دّننَشّ. نَ كِسِ قَن. عَلَ شَ وٌن مَلِ نَ سْتْدٍ عَ شَ هِننّ سَابُي رَ. عَمِنَ.</para>
  <para style="imte">عَلَ شَ مَسٍنيِ عَننَبِ عٍسَيِ بّ</para>
  <chapter number="1" style="c" sid="ISA 1"/>
  <para style="s">عِسِرَيِلَ شَ سّرّشّ كَنَشِيٍ عَ شَ يُنُبِيٍ شَ قٍ رَ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 1:1"/>مَسٍنيِ نَشٍيٍ فٌرٌ عَمٌسُ شَ دِ عٍسَيِ مَ، يُدَيَ نُن دَرِ سَلَمُ شَ قٍ رَ، يُدَيَ مَنفّيٍ عٌسِيَسِ، يٌتَمِ، عَشَسِ، نُن شٍسٍكِيَ شَ وَشَتِ.<verse eid="ISA 1:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="ISA 1:2"/>عَلَتَلَ نَن مَسٍنيِ تِقٍ،</para>
  <para style="q" vid="ISA 1:2">كٌورٍ نُن بْشِ بِرِن شَ عٍ تُلِ مَتِ عَ رَ.</para>
  <para style="q" vid="ISA 1:2">عَلَتَلَ نَشّ،</para>
  <para style="q" vid="ISA 1:2">«ﭑ بَرَ دِيٍ شُرُ، ﭑ عٍ رَ مْ،</para>
  <para style="q" vid="ISA 1:2">كْنْ عٍ بَرَ مُرُتَ ﭑ مَ.<verse eid="ISA 1:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 1:3"/>نِنفٍ يَتِ عَ كَنيِ كٌلٌن،</para>
  <para style="q" vid="ISA 1:3">سٌقَلٍ قَن عَ كٌلٌن عَ كَنيِ دٌنسٍ سَمَ عَ بّ دّننَشّ.</para>
  <para style="q" vid="ISA 1:3">كْنْ عِسِرَيِلَ تَن مُ سٍسٍ كٌلٌن،</para>
  <para style="q" vid="ISA 1:3">ﭑ مَ حَمَ مُ سٍسٍ قَهَامُشِ.»<verse eid="ISA 1:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="ISA 1:4"/>حَشَنكَتّ نَ يِ حَمَ يُنُبِتْي بّ،</para>
  <para style="q" vid="ISA 1:4">نَشَن يُنُبِ كٌتٍ شَنِنمَ،</para>
  <para style="q" vid="ISA 1:4">نَشَن قِندِشِ قٍ حَاشِ رَبَيٍ رَ،</para>
  <para style="q" vid="ISA 1:4">نَشَن قِندِشِ دِ مُرُتَشِيٍ رَ.</para>
  <para style="q" vid="ISA 1:4">عٍ بَرَ مّ عَلَتَلَ رَ،</para>
  <para style="q" vid="ISA 1:4">عٍ عِسِرَيِلَ شَ سّنِيّنتْي مَبٍرٍ،</para>
  <para style="q" vid="ISA 1:4">عٍ عٍ كٌبٍ رَ سٌ عَ رَ.<verse eid="ISA 1:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="ISA 1:5"/>وٌ نَ حَشَنكَتّ قٍنقٍ مُنقٍ رَ؟</para>
  <para style="q" vid="ISA 1:5">وٌ تٌندِشِ فبِلٍندٍ عَلَتَلَ مَ مُنسٍ مَ؟</para>
  <para style="q" vid="ISA 1:5">وٌ بَرَ قُرَ وٌ شُنيِ مَ، وٌ تْورْشِ وٌ بْحّ مَ.<verse eid="ISA 1:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 1:6"/>كٍلِقٍ وٌ سَنيِ مَ هَن وٌ شُنيِ،</para>
  <para style="q" vid="ISA 1:6">وٌ شَ قٍقٍ مُ لَنشِ.</para>
  <para style="q" vid="ISA 1:6">وٌ شَ قِيٍ يَ مُ عِشَشِ، عٍ مُ مَشِرِشِ، تُرٍ يٌ مُ سَشِ عٍ مَ.<verse eid="ISA 1:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 1:7"/>وٌ شَ بْشِ بَرَ كَنَ، وٌ شَ تَايٍ بَرَ فَن.</para>
  <para style="q" vid="ISA 1:7">سِ فبّتّيٍ نَ وٌ شَ دَشَمُي دٌنقٍ وٌ يَ شْرِ،</para>
  <para style="q" vid="ISA 1:7">عٍ نَ عَ بِرِن تٌنفٌقٍ عٍ يّتّ بّ.<verse eid="ISA 1:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 1:8"/>سِيٌنِ تَا نَ عَ كٍرٍنيِ مَ عَلْ بَفٍ دِ شّ تَفِ،</para>
  <para style="q" vid="ISA 1:8">عَلْ لٍيلٍ نَشَن تِشِ مّرّ مَ،</para>
  <para style="q" vid="ISA 1:8">عَلْ تَا نَشَن نَبِلِنشِ يَشُييٍ رَ.<verse eid="ISA 1:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 1:9"/>شَ عَلَتَلَ سّنبّمَ مُ مِشِ ندٍيٍ رَكِسِ وٌن بّ نُ،</para>
  <para style="q" vid="ISA 1:9">وٌن بَرَ لُ نُ عَلْ سٌدٌ مَ نُن فٌمٌرَ تَايٍ.<verse eid="ISA 1:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="ISA 1:10"/>وٌ وٌ تُلِ مَتِ عَلَتَلَ شَ مَسٍنيِ رَ،</para>
  <para style="q" vid="ISA 1:10">وٌ تَن نَشٍيٍ مَنِيَشِ سٌدٌ مَ كُنتِفِيٍ رَ.</para>
  <para style="q" vid="ISA 1:10">وٌ شَ وٌن مَرِفِ عَلَتَلَ شَ سّرِيّ رَ مّ،</para>
  <para style="q" vid="ISA 1:10">وٌ تَن نَشٍيٍ لُشِ عَلْ فٌمٌرَ حَمَ.<verse eid="ISA 1:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 1:11"/>عَلَتَلَ نَشّ،</para>
  <para style="q" vid="ISA 1:11">«ﭑ مُنسٍ رَبَمَ وٌ شَ سّرّشّ وُيَشِيٍ رَ؟</para>
  <para style="q" vid="ISA 1:11">ﭑ بَرَ لُفَ يّشّ كٌنتٌنيِ سّرّشّيٍ رَ،</para>
  <para style="q" vid="ISA 1:11">ﭑ بَرَ لُفَ شُرُ سٍ بْرّفّشِيٍ تُرٍ رَ.</para>
  <para style="q" vid="ISA 1:11">تُورَيٍ، يّشّييٍ نُن سِ كٌنتٌنيِيٍ وُلِ مُ رَقَن ﭑ مَ.<verse eid="ISA 1:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 1:12"/>ندٍ وٌ شِلِشِ قَقٍ رَ ﭑ مَ هْرْ مْبَنشِ تّتّ كُي، تِقٍ رَ ﭑ يَ عِ؟<verse eid="ISA 1:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 1:13"/>وٌ بَ قَقٍ هَدِيَ قُقَقُ رَ.</para>
  <para style="q" vid="ISA 1:13">سُرَيِ شِرِ مُ رَقَن ﭑ مَ قٍقٍ مَ.</para>
  <para style="q" vid="ISA 1:13">وٌ شَ كِكٍ نّينّ سَلِيٍ، وٌ شَ مَلَبُي لْشْييٍ، وٌ شَ مَلَنيِيٍ، نُن وٌ شَ سَلِيٍ شُنفبٍيٍ،</para>
  <para style="q" vid="ISA 1:13">عٍ سٍسٍ مُ رَقَنشِ ﭑ مَ.<verse eid="ISA 1:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 1:14"/>ﭑ وٌ شَ كِكٍ نّينّ سَلِيٍ شْنشِ،</para>
  <para style="q" vid="ISA 1:14">وٌ شَ سَلِ بِرِن بَرَ ﭑ بْحّ رَحَاشُ ﭑ مَ.<verse eid="ISA 1:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 1:15"/>وٌ نَ وٌ بّلّشّيٍ عِتَلَ سَلِ كُي تّمُي نَشّ،</para>
  <para style="q" vid="ISA 1:15">ﭑ نَ ﭑ يَ رَفَلِمَ نّ عَلَكٌ ﭑ نَشَ قَ عَ تٌ.</para>
  <para style="q" vid="ISA 1:15">هَلِ وٌ مَشَندِيٍ بِرَ عٍ بٌورٍ قْشْ رَ،</para>
  <para style="q" vid="ISA 1:15">ﭑ مُ عٍ رَ مّمَ، بَرِ مَ قَشّتِيٍ نَن وٌ رَ.<verse eid="ISA 1:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 1:16"/>وٌ لُ قٍ قِيشّ كُي، وٌ وٌ يّتّ رَ سّنِيّن،</para>
  <para style="q" vid="ISA 1:16">وٌ بَ يُنُبِيٍ رَبَقٍ ﭑ يَ عِ.<verse eid="ISA 1:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 1:17"/>وٌ وٌ مَتِنكَن قٍ قَنيِ رَبَدٍ،</para>
  <para style="q" vid="ISA 1:17">وٌ لُ تِنشِنيِ كُي،</para>
  <para style="q" vid="ISA 1:17">وٌ مِشِ كٌبِيٍ مَكِيتِ،</para>
  <para style="q" vid="ISA 1:17">وٌ كِرِدِيٍ نُن كَاحّ فِنّيٍ شُن مَقَلَ.»<verse eid="ISA 1:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="ISA 1:18"/>عَلَتَلَ نَشّ، «وٌ قَ، وٌن شَ وْيّن.</para>
  <para style="q" vid="ISA 1:18">هَلِ وٌ شَ يُنُبِيٍ تٌ بَرَ وٌ مَنْشْ،</para>
  <para style="q" vid="ISA 1:18">وٌ نْمَ قِيشّدٍ قْين.</para>
  <para style="q" vid="ISA 1:18">هَلِ عٍ سَ شْسِ نّ عَلْ فَرّ فبٍيلِ،</para>
  <para style="q" vid="ISA 1:18">عٍ نْمَ نّ قِيشّدٍ عَلْ شُرُ سٍ قِيشّ قَتٍ مَشَبٍ.<verse eid="ISA 1:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 1:19"/>شَ وٌ تِن وٌ تُلِ مَتِدٍ ﭑ نَ،</para>
  <para style="q" vid="ISA 1:19">وٌ يِ بْشِ دَشَمُي دٌنمَ نّ،<verse eid="ISA 1:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 1:20"/>كْنْ شَ وٌ سَ تٌندِ ﭑ نَتِنمّدٍ،</para>
  <para style="q" vid="ISA 1:20">سَنتِدّفّمَ نَن وٌ سْنتْمَ.»</para>
  <para style="q" vid="ISA 1:20">عَلَتَلَ شُي نَن نَ كِ.<verse eid="ISA 1:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="ISA 1:21"/>يِ تَا لُشِ نّ عَلْ فِنّ نَشَن نُ دُفُتّفّشِ عَ شَ مْرِ مَ</para>
  <para style="q" vid="ISA 1:21">عَ قَ مّ عَ رَ، عَ قِندِ لَنفٌي فِنّ رَ.</para>
  <para style="q" vid="ISA 1:21">عَ سِنفٍ عَ نُ تِنشِن عَ قَنيِ رَ،</para>
  <para style="q" vid="ISA 1:21">كْنْ يَكْسِ عَ بَرَ قِندِ قَشَتِ رَ؟<verse eid="ISA 1:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 1:22"/>عِ شَ فبٍتِ بَرَ قِندِ سٍ كَنَشِ رَ،</para>
  <para style="q" vid="ISA 1:22">عِ شَ وّنِ بَرَ سُنبُ يٍ رَ.<verse eid="ISA 1:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 1:23"/>عِ شَ مَنفّيٍ بَرَ مُرُتَ، عٍ قِندِ مُحّتِيٍ رَ،</para>
  <para style="q" vid="ISA 1:23">بُحَ تِنشِنتَرٍ رَقَن نَشٍيٍ مَ.</para>
  <para style="q" vid="ISA 1:23">نَ كُي عٍ مُ كِرِدِيٍ مَلِمَ،</para>
  <para style="q" vid="ISA 1:23">عٍ مُ كِيتِ قَنيِ سَمَ كَاحّ فِنّ شَ تْورّ شَ قٍ رَ.<verse eid="ISA 1:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="ISA 1:24"/>عَلَتَلَ سّنبّمَ شُي نَن يَ، نَ شَ قٍ رَ.</para>
  <para style="q" vid="ISA 1:24">عِسِرَيِلَ مَرِفِ عَلَ سّنبّمَ نَشّ،</para>
  <para style="q" vid="ISA 1:24">«ﭑ حَشَنكَتّ دْشْمَ نّ ﭑ فٍرٍقَيٍ مَ،</para>
  <para style="q" vid="ISA 1:24">ﭑ نَ ﭑ فبٍ حْشْ ﭑ يَشُييٍ مَ.<verse eid="ISA 1:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="ISA 1:25"/>ﭑ فبِلٍنمَ نّ ﭑ يِ سَ رَ عِ مَ عَ شْرْشْي رَ،</para>
  <para style="q" vid="ISA 1:25">ﭑ عِ رَ سّنِيّن عَلْ فبٍتِ فبِ بَمَ كِ نَشّ تّ رَ،</para>
  <para style="q" vid="ISA 1:25">عَلَكٌ عِ شَ بَ تِنشِنتَرٍيَ مَ.<verse eid="ISA 1:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="ISA 1:26"/>ﭑ كِيتِسَ تِنشِنشِيٍ تِمَ نّ وٌ شُن عَلْ سِنفٍ،</para>
  <para style="q" vid="ISA 1:26">ﭑ مَرَ سِمَ قَنيِيٍ لُمَ نّ وٌ تَفِ عَلْ تّمُي دَنفِشِ.</para>
  <para style="q" vid="ISA 1:26">نَ دَنفِ شَنبِ، عِ شِلِ قَمَ نّ قَلَدٍ</para>
  <para style="q" vid="ISA 1:26">‹تَا تِنشِنشِ نَشَن دُفُتّفّشِ.›»<verse eid="ISA 1:26"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="27" style="v" sid="ISA 1:27"/>سِيٌنِ شُن سَرَ مَ نّ تِنشِنيِ رَ،</para>
  <para style="q" vid="ISA 1:27">تُوبِ مِشِيٍ كِسِمَ نّ تِنشِنيِ سَابُي رَ.<verse eid="ISA 1:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="ISA 1:28"/>كْنْ فبَلٌي فٌرٌ مَ نّ مُرُتّلَيٍ نُن يُنُبِتْييٍ مَ،</para>
  <para style="q" vid="ISA 1:28">هَلَكِ لُ مِشِيٍ قْشْ رَ، نَشٍيٍ عٍ كٌبٍ سٌمَ عَلَتَلَ رَ.<verse eid="ISA 1:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="ISA 1:29"/>وٌ قَمَ نّ يَافِدٍ قْتْنيِ رَ وٌ نُ كُيٍ بَتُمَ دّننَشّ.</para>
  <para style="q" vid="ISA 1:29">وٌ يَافِ بٍلٍبٍلٍ سْتْمَ نّ نَ يِرٍيٍ شَ قٍ رَ.<verse eid="ISA 1:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="ISA 1:30"/>وٌ قَمَ نّ لُدٍ عَلْ وُرِ بِلِ لِسِشِ،</para>
  <para style="q" vid="ISA 1:30">يٍ مُ نَ نَشَن مَ.<verse eid="ISA 1:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="ISA 1:31"/>سّنبّمَ سّنبّ حْنمَ نّ،</para>
  <para style="q" vid="ISA 1:31">عَ تَن نُن عَ شَ وَلِ بِرِن فَن،</para>
  <para style="q" vid="ISA 1:31">عَ رَكِسِمَ يٌ مُ لُ نَ.<verse eid="ISA 1:31"/></para>
  <chapter eid="ISA 1"/>
  <chapter number="2" style="c" sid="ISA 2"/>
  <para style="s">عَلَ شَ شُننَكٍلِ نُن عَ شَ شْنّ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 2:1"/>عَمٌسُ شَ دِ عَننَبِ عٍسَيِ شَ مَسٍنيِ نَن يَ يُدَ نُن دَرِ سَلَمُ شَ قٍ رَ.<verse eid="ISA 2:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 2:2"/>وَشَتِ دْنشْي عَلَتَلَ شَ بَنشِ تِشِ فٍيَ نَشَن قَرِ،</para>
  <para style="q" vid="ISA 2:2">نَ قَمَ نّ لُدٍ فٍيَيٍ بِرِن شُن مَ.</para>
  <para style="q" vid="ISA 2:2">سِ بِرِن عٍ شُن تِمَ نّ نَ يِرٍ عِتٍشِ رَ.<verse eid="ISA 2:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 2:3"/>بْنسْي وُيَشِ سِفَمَ نّ نَا، عٍ عَ قَلَ،</para>
  <para style="q" vid="ISA 2:3">«وٌ قَ، وٌن شَ تٍ عَلَتَلَ شَ فٍيَ قَرِ،</para>
  <para style="q" vid="ISA 2:3">يَشُبَ مَرِفِ عَلَ شَ بَنشِ نَ دّننَشّ.</para>
  <para style="q" vid="ISA 2:3">عَ وٌن شَرَنمَ نّ عَ شَ سّرِيّ رَ،</para>
  <para style="q" vid="ISA 2:3">عَلَكٌ وٌن شَ بِرَ عَ شَ كِرَ قْشْ رَ.»</para>
  <para style="q" vid="ISA 2:3">عَلَتَلَ شَ سّرِيّ مِنِمَ سِيٌنِ فٍيَ مَ،</para>
  <para style="q" vid="ISA 2:3">عَ شَ مَسٍنيِ قْلْمَ دَرِ سَلَمُ تَا كُي.<verse eid="ISA 2:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 2:4"/>عَلَتَلَ نَن كِيتِ سَمَ حَمَنّيٍ تَفِ،</para>
  <para style="q" vid="ISA 2:4">عَ قِندِ سِ وُيَشِ تَفِ عِبَمَ رَ.</para>
  <para style="q" vid="ISA 2:4">عٍ قَمَ عٍ شَ سَنتِدّفّمَيٍ شَبُدٍ كٍرِيٍ نَن نَ،</para>
  <para style="q" vid="ISA 2:4">عٍ عٍ شَ تَنبّيٍ قِندِ وْرْتّيٍ رَ.</para>
  <para style="q" vid="ISA 2:4">فٍرٍ حْنمَ نّ سِيٍ تَفِ،</para>
  <para style="q" vid="ISA 2:4">سْورِحَ مُ مَتِنكَنمَ سْنْن.<verse eid="ISA 2:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="ISA 2:5"/>يَشُبَ بْنسْي، وٌ قَ،</para>
  <para style="q" vid="ISA 2:5">وٌن شَ وٌن حّرّ عَلَتَلَ شَ نَءِيَلَنيِ مَ.<verse eid="ISA 2:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 2:6"/>عَلَتَلَ، عِ بَرَ عِ شَ حَمَ رَبٌلٌ،</para>
  <para style="q" vid="ISA 2:6">بَرِ مَ عٍ بِرَ مَ نَامُنيِيٍ قْشْ رَ،</para>
  <para style="q" vid="ISA 2:6">نَشٍيٍ كٍلِشِ سٌفٍتٍدٍ مَبِرِ.</para>
  <para style="q" vid="ISA 2:6">سٍ مَتٌي بَرَ وُيَ نَشٍيٍ وَلِمَ عَلْ قِلِسِتَكَيٍ.</para>
  <para style="q" vid="ISA 2:6">عِ شَ حَمَ نُن سِ عَلَ كٌلٌنتَرٍيٍ بَرَ لَنيِ شِرِ.<verse eid="ISA 2:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 2:7"/>عِ شَ حَمَ بَرَ شّيمَ نُن فبٍتِ فبٍفبٍ سْتْ،</para>
  <para style="q" vid="ISA 2:7">عٍ شَ نَاقُلِ مُ حْنمَ.</para>
  <para style="q" vid="ISA 2:7">عٍ شَ بْشِ بَرَ رَقٍ سْورِ شَ سٌييٍ نُن عٍ رَفِسٍيٍ رَ.<verse eid="ISA 2:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 2:8"/>كُيٍيٍ تٌمَ نّ يِرٍ بِرِن.</para>
  <para style="q" vid="ISA 2:8">كَنكَن عَ شِنبِ سِنمَ كُيٍيٍ بّ، عٍ نَشٍيٍ مَسٌلِشِ عٍ بّلّشّ رَ.<verse eid="ISA 2:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 2:9"/>عٍ قٍلٍنمَ نّ عٍ بّ، عٍ عٍ مَفٌرٌ عٍ بَتُقٍ رَ.</para>
  <para style="q" vid="ISA 2:9">نَ كُي، عِ نَشَ دِحّ عٍ مَ قٍوٌ.<verse eid="ISA 2:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="ISA 2:10"/>وٌ وٌ نْشُن قَنيٍيٍ تَفِ بْشِ مَ،</para>
  <para style="q" vid="ISA 2:10">عَلَكٌ وٌ شَ وٌ مَكُيَ عَلَتَلَ شَ شْنّ رَ،</para>
  <para style="q" vid="ISA 2:10">نَشَن قَمَ عَ شَ نْرّ مَكَابَشِ كُي.<verse eid="ISA 2:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 2:11"/>عَدَ مَدِ شَ يّتّ عِفبٌيَ مَفٌرٌ مَ نّ،</para>
  <para style="q" vid="ISA 2:11">مِشِيٍ شَ يّتّ عِتٍيَ كُنتِن.</para>
  <para style="q" vid="ISA 2:11">عَلَتَلَ كٍرٍن نَن عَ يّتّ عِتٍمَ نَ لْشْي.<verse eid="ISA 2:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 2:12"/>عَلَتَلَ سّنبّمَ شَ كِيتِ لْشْي قَمَ يّتّ عِفبٌي بّ.</para>
  <para style="q" vid="ISA 2:12">نَشٍيٍ بَرَ عٍ يّتّ عِتٍ، عَلَ قَمَ نّ عٍ رَفٌرٌدٍ.<verse eid="ISA 2:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 2:13"/>عَ لِبَن سّدِرِ بِلِ نُن بَسَن شَ وُرِ بِلِ عِتٍشِ بِرِن نَفٌرٌ مَ نّ.<verse eid="ISA 2:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 2:14"/>عَ فٍيَ عِتٍشِ قَن بَمَ نّ.<verse eid="ISA 2:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 2:15"/>عَ مِشِيٍ شَ بَنشِ مَكَنتَشِيٍ كَنَمَ نّ،</para>
  <para style="q" vid="ISA 2:15">عَ عٍ شَ تّتّيٍ رَبِرَ.<verse eid="ISA 2:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 2:16"/>عَ عٍ شَ كُنكُي شُنفبٍيٍ رَدُلَمَ نّ.<verse eid="ISA 2:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 2:17"/>عَلَتَلَ قَمَ نّ عَدَ مَدِ شَ يّتّ عِفبٌيَ رَفٌرٌدٍ،</para>
  <para style="q" vid="ISA 2:17">عَ مِشِيٍ شَ يّتّ عِتٍيَ كُنتِن.</para>
  <para style="q" vid="ISA 2:17">عَلَتَلَ كٍرٍن نَن عَ يّتّ عِتٍمَ نَ لْشْي.<verse eid="ISA 2:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 2:18"/>كُيٍ قٍ بِرِن كَنَمَ نّ.<verse eid="ISA 2:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="ISA 2:19"/>مِشِيٍ عٍ نْشُنمَ نّ قْنمّيٍ تَفِ فّمّ لٌنفٌرِ رَ،</para>
  <para style="q" vid="ISA 2:19">عٍ يِلِ فٍمَ نّ بْشِ كُي، عٍ قَ عٍ نْشُن عَلَتَلَ شَ شْنّ مَ،</para>
  <para style="q" vid="ISA 2:19">نَشَن قَمَ عَ شَ نْرّ مَكَابَشِ كُي،</para>
  <para style="q" vid="ISA 2:19">عَ نَ كٍلِ بْشِ رَ سّرّندٍ تّمُي نَشّ.<verse eid="ISA 2:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 2:20"/>نَ لْشْي، مِشِيٍ قَمَ نّ عٍ شَ كُيٍ وْلّدٍ بَلٍ نُن تُوكّ مَ،</para>
  <para style="q" vid="ISA 2:20">عٍ نُ نَشٍيٍ يَءِلَنشِ شّيمَ نُن فبٍتِ رَ عٍ بَتُقٍ رَ.<verse eid="ISA 2:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 2:21"/>عٍ عٍ نْشُنمَ نّ يِلِيٍ نُن قْنمّيٍ كُي قَنيٍ لٌنفٌرِ رَ،</para>
  <para style="q" vid="ISA 2:21">عٍ شَ عٍ مَكُيَ عَلَتَلَ شَ شْنّ رَ،</para>
  <para style="q" vid="ISA 2:21">نَشَن قَمَ عَ شَ نْرّ مَكَابَشِ كُي،</para>
  <para style="q" vid="ISA 2:21">عَ نَ كٍلِ بْشِ رَ سّرّندٍ تّمُي نَشّ.<verse eid="ISA 2:21"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="22" style="v" sid="ISA 2:22"/>وٌ بَ وٌ يّتّ تَشُقٍ عَدَ مَدِ رَ،</para>
  <para style="q" vid="ISA 2:22">حّنفِ كٍرٍن ثٍتِ نَ نَشَن بّ.</para>
  <para style="q" vid="ISA 2:22">تِدٍ مُندُن نَ عَ مَ؟<verse eid="ISA 2:22"/></para>
  <chapter eid="ISA 2"/>
  <chapter number="3" style="c" sid="ISA 3"/>
  <para style="s">حَشَسِ بِرَقٍ يُدَيَ كُي</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 3:1"/>مَرِفِ عَلَتَلَ سّنبّمَ بَرَ نَتّ تٌنفٌ</para>
  <para style="q" vid="ISA 3:1">دَرِ سَلَمُ نُن يُدَيَ شُن نَكَنَقٍ رَ.</para>
  <para style="q" vid="ISA 3:1">عَ شَ بَلٌي نُن يٍ بَ عٍ يِ رَ،<verse eid="ISA 3:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 3:2"/>عَ شَ عٍ شَ حَلَمَيٍ نُن عٍ شَ سْورِيٍ رَفٌرٌ،</para>
  <para style="q" vid="ISA 3:2">عَ شَ عٍ شَ كِيتِسَيٍ نُن نَمِحْنمّيٍ رَ سَبَرِ،</para>
  <para style="q" vid="ISA 3:2">عَ شَ عٍ شَ سٍمَتٌي نُن عٍ شَ قٌرِيٍ مَكُيَ عٍ بٌورٍ رَ،<verse eid="ISA 3:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 3:3"/>عَ شَ عٍ شَ سْورِ مَنفّيٍ، عٍ شَ مَرَ سِمَيٍ، عٍ شَ وَلِكّ قَنيِيٍ،</para>
  <para style="q" vid="ISA 3:3">نُن عٍ شَ مِشِ كْوتَشِ بِرِن بَ عٍ يِ رَ.<verse eid="ISA 3:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 3:4"/>ﭑ قَمَ قٌنِكٍيٍ نَن تِدٍ مَنفّيَ رَ عٍ شُن مَ،</para>
  <para style="q" vid="ISA 3:4">دِ مّيٍ نَن قَمَ دْشْدٍ عٍ قَرِ.<verse eid="ISA 3:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 3:5"/>كَنكَن قُمَ نّ عَ بٌورٍ مَ،</para>
  <para style="q" vid="ISA 3:5">قٌنِكٍيٍ تِمَ نّ شّمْشِيٍ كَنكٍ،</para>
  <para style="q" vid="ISA 3:5">قُيَنتٍيٍ قَن بَفَن مِشِ بِنيّ مَ.<verse eid="ISA 3:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="ISA 3:6"/>نَ كُي، مِشِ ندٍ عَ قَلَمَ نّ عَ بَرِ بٌورٍ ندٍ بّ،</para>
  <para style="q" vid="ISA 3:6">«دٌنمَ قَنيِ تٌ نَ عِ تَن يِ رَ،</para>
  <para style="q" vid="ISA 3:6">عِ شَ قِندِ مُشُ شَ يَرٍرَتِ رَ،</para>
  <para style="q" vid="ISA 3:6">عِ شَ مَنفّيَ تٌنفٌ يِ حَشَسِ كُي.»<verse eid="ISA 3:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 3:7"/>كْنْ عَ نفَشَكٍرٍنيِ عَ يَابِمَ نّ،</para>
  <para style="q" vid="ISA 3:7">«سٍرِبَ مُ نَ ﭑ نَ،</para>
  <para style="q" vid="ISA 3:7">دٌنمَ نُن دٌنسٍ يٌ مُ نَ ﭑ مَ بَنشِ كُي.</para>
  <para style="q" vid="ISA 3:7">وٌ نَشَ ﭑ قِندِ حَمَ شَ مَنفّ رَ.»<verse eid="ISA 3:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="ISA 3:8"/>دَرِ سَلَمُ نَ بِرَقٍ، يُدَيَ شُن نَ كَنَقٍ،</para>
  <para style="q" vid="ISA 3:8">بَرِ مَ عٍ عَلَتَلَ مَتَندِ مَ عٍ شَ وْيّنيِ نُن عٍ شَ وَلِ رَ،</para>
  <para style="q" vid="ISA 3:8">عٍ بَرَ مُرُتَ عَلَتَلَ شَ مَنفّيَ مَ.<verse eid="ISA 3:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 3:9"/>عٍ شَ كَارِنيِ قِندِ سٍيدٍ حَاشِ نَن نَ عٍ شِلِ مَ.</para>
  <para style="q" vid="ISA 3:9">عٍ يُنُبِ رَبَمَ كّنّ نَن مَ،</para>
  <para style="q" vid="ISA 3:9">عَلْ سٌدٌ مَكَ نَشٍيٍ مُ عٍ شَ يُنُبِ نْشُن.</para>
  <para style="q" vid="ISA 3:9">حَشَنكَتّ نَ عٍ بّ،</para>
  <para style="q" vid="ISA 3:9">عٍ نَ فبَلٌي نَن بّندُنقٍ عٍ يّتّ مَ نَ كِ.<verse eid="ISA 3:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="ISA 3:10"/>وٌ عَ قَلَ تِنشِنتْي بّ، عَ نَ كِرَ قَنيِ شْن مَ،</para>
  <para style="q" vid="ISA 3:10">عَ قَمَ نّ عَ شَ تِنشِنيِ سَرٍ سْتْدٍ.<verse eid="ISA 3:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 3:11"/>حَشَنكَتّ نَ مِشِ حَاشِ تَن بّ،</para>
  <para style="q" vid="ISA 3:11">فبَلٌي قَمَ نّ عَ لِدٍ عَ حَاشِ رَ،</para>
  <para style="q" vid="ISA 3:11">عَ قَمَ نّ عَ شَ تِنشِنتَرٍيَ سَرٍ سْتْدٍ.<verse eid="ISA 3:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="ISA 3:12"/>دِ مّيٍ نَن نَ ﭑ مَ حَمَ حَشَنكَتَقٍ،</para>
  <para style="q" vid="ISA 3:12">فِنّيٍ نَن نْي دْشْشِ عَ مَ،</para>
  <para style="q" vid="ISA 3:12">مَنفّيٍ نَ عَ رَلْيقٍ كِرَ حَاشِ شْن مَ.<verse eid="ISA 3:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 3:13"/>كْنْ عَلَتَلَ بَرَ عَ عِكٍلِ كِيتِسَ يِرٍ،</para>
  <para style="q" vid="ISA 3:13">عَ شَ كَلَمُي تِنشِنشِ مَسٍن، عَ شَ كِيتِ سَ نْندِ رَ.<verse eid="ISA 3:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 3:14"/>عَلَتَلَ نَ عَ شَ حَمَ كُنتِفِيٍ نُن عَ مَنفّيٍ مَكِيتِقٍ يِ وْيّنيِ رَ،</para>
  <para style="q" vid="ISA 3:14">«وٌ بَرَ ﭑ مَ حَمَ شُن نَكَنَ.</para>
  <para style="q" vid="ISA 3:14">وٌ بَرَ مِسِكِينّيٍ مُحَ.<verse eid="ISA 3:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 3:15"/>وٌن ﭑ مَ حَمَ هَلَكِمَ مُنقٍ رَ؟</para>
  <para style="q" vid="ISA 3:15">وٌ سٍتَرٍيٍ تْورْ مَ مُنقٍ رَ؟»</para>
  <para style="q" vid="ISA 3:15">مَرِفِ عَلَتَلَ سّنبّمَ شُي نَن نَ كِ.<verse eid="ISA 3:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="ISA 3:16"/>عَلَتَلَ نَشّ، «سِيٌنِ فِنّيٍ قِندِشِ يّتّ عِفبٌي نَن نَ،</para>
  <para style="q" vid="ISA 3:16">نَشٍيٍ عٍ حّرّ مَ عٍ شُنيِ رَكٍلِشِ،</para>
  <para style="q" vid="ISA 3:16">عٍ عٍ حّرّ مّرّ مّرّ رَ عٍ سَنكْنيِ شُنمَسٍيٍ نُ عٍ شُي رَ مِنِ.<verse eid="ISA 3:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 3:17"/>عَلَتَلَ قَمَ نّ سُورِ رَ مِنِدٍ عٍ شُنيِ مَ،</para>
  <para style="q" vid="ISA 3:17">عَ عٍ شُنسّشّ بِرِن بَ عٍ مَ.»<verse eid="ISA 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 3:18"/>نَ لْشْي، عَلَتَلَ عٍ شَ شُنمَسٍ بِرِن بَمَ نّ عٍ يِ رَ؛ عٍ شَ سَنكْنيِ شُنمَسٍ تٌقَنيِيٍ، عٍ شَ كْنمَفٌرٍ، عٍ شَ شُنمَسٍ نَشٍيٍ مِسَالِشِ كِكٍ رَ، <verse eid="ISA 3:18"/><verse number="19" style="v" sid="ISA 3:19"/>عٍ شَ تُلِرَ سٌي، عٍ شَ بّلّشّرَ سٌي، عٍ شَ مَقٍلٍنيِيٍ، <verse eid="ISA 3:19"/><verse number="20" style="v" sid="ISA 3:20"/>عٍ شَ شُن مَشِرِ سٍيٍ، عٍ شَ سَنكْنيِ شُنمَسٍيٍ، عٍ شَ بّلّتِيٍ، عٍ شَ لَبُندّ سَسٍيٍ، عٍ شَ مَكَنتَسٍيٍ، <verse eid="ISA 3:20"/><verse number="21" style="v" sid="ISA 3:21"/>عٍ شَ بّلّشّسٌلٍ شُرُندّيٍ، عٍ شَ حْي شُرُندّيٍ، <verse eid="ISA 3:21"/><verse number="22" style="v" sid="ISA 3:22"/>عٍ شَ شُلُن دُفِيٍ، عٍ شَ دٌنمَ كُيٍيٍ، عٍ شَ دٌنمَ قَرِ عِفٌرٌي، عٍ شَ فبْنقْييٍ، <verse eid="ISA 3:22"/><verse number="23" style="v" sid="ISA 3:23"/>عٍ شَ دُفِيٍ، عٍ شَ دٌنمَ بُنمَفٌرٍ، عٍ شَ شُنمَشِرِيٍ، نُن عٍ شَ مَقٍلٍنيِيٍ. عَلَتَلَ نَ بِرِن بَمَ نّ عٍ يِ رَ.<verse eid="ISA 3:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="ISA 3:24"/>سٍ بْرْشِ نَن قِندِ مَ عٍ شَ لَبُندّ رَ.</para>
  <para style="q" vid="ISA 3:24">لُوتِ نَن قِندِ مَ عٍ شَ بّلّتِ رَ.</para>
  <para style="q" vid="ISA 3:24">عٍ شُنيِ دّنبّشِ بِمَ نّ.</para>
  <para style="q" vid="ISA 3:24">بّكِ نَن قِندِ مَ عٍ شَ دُفِ رَ.</para>
  <para style="q" vid="ISA 3:24">عٍ قَتٍ كِرِ تٌقَنيِ فَنمَ نّ.<verse eid="ISA 3:24"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="25" style="v" sid="ISA 3:25"/>سَنتِدّفّمَ عٍ شَ مْرِيٍ قَشَمَ نّ،</para>
  <para style="q" vid="ISA 3:25">عٍ شَ حَلَمَيٍ قَشَمَ فٍرٍ نَن كُي.<verse eid="ISA 3:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="ISA 3:26"/>سِيٌنِ حَمَ وَ شُي مِنِمَ نّ سُننُنيِ كُي،</para>
  <para style="q" vid="ISA 3:26">عَلْ كَاحّ فِنّ نَشَن دْشْ بْشِ مَ، عَ وَ.<verse eid="ISA 3:26"/></para>
  <chapter eid="ISA 3"/>
  <chapter number="4" style="c" sid="ISA 4"/>
  <para style="s">حَشَنكَتّ رَحْنيِ</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 4:1"/>نَ لْشْي فِنّ سٌلٌقٍرٍ عَ قَلَمَ نّ شّمّ كٍرٍن بّ،</para>
  <para style="q" vid="ISA 4:1">«مُشُ شَ بَلٌي نُن مُشُ شَ مَشِرِ سٍيٍ شَ قِندِ مُشُ شَ كٌتٍ رَ،</para>
  <para style="q" vid="ISA 4:1">كْنْ عِ تَن شَ مُشُ دْشْ، عِ شِلِ شَ لُ مُشُ شُن،</para>
  <para style="q" vid="ISA 4:1">عَلَكٌ يَافِ شَ بَ مُشُ مَ.»<verse eid="ISA 4:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="ISA 4:2"/>نَ لْشْي عَلَتَلَ شَ سَلٌنيِ تٌقَنيِ مِنِمَ نّ عَ شَ نْرّ كُي،</para>
  <para style="q" vid="ISA 4:2">عِسِرَيِلَ بْشِ شَ دَشَمُي قَنيِ شَ لُ عَ شَ مِشِيٍ بّ نَشٍيٍ كِسِشِ.<verse eid="ISA 4:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 4:3"/>مِشِ نَشٍيٍ قَمَ لُدٍ سِيٌنِ نُن دَرِ سَلَمُ،</para>
  <para style="q" vid="ISA 4:3">عٍ قِندِ مَ نّ سّنِيّنتْييٍ رَ نَشٍيٍ شِلِ سّبّشِ كِسِ مِشِيٍ يَ مَ.<verse eid="ISA 4:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 4:4"/>مَرِفِ قَمَ نّ سِيٌنِ فِنّيٍ شَ سّنِيّنتَرٍحَ مَشَدٍ،</para>
  <para style="q" vid="ISA 4:4">عَ دَرِ سَلَمُكَيٍ رَ سّنِيّن عٍ شَ قَشّ تِقٍ مَ كِيتِ تِنشِنشِ سَابُي رَ،</para>
  <para style="q" vid="ISA 4:4">عَ قَ عٍ سَرٍ رَفبِلٍن عٍ مَ.<verse eid="ISA 4:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 4:5"/>نَ تّمُي عَلَتَلَ قَمَ سِيٌنِ فٍيَ مَكٌتٌدٍ نُشُي نُن تُورِ نَن نَ يَنيِ رَ،</para>
  <para style="q" vid="ISA 4:5">عَ تّ شُنفبٍ رَ مِنِ عٍ شُن مَ كْي رَ.</para>
  <para style="q" vid="ISA 4:5">عَ شَ نْرّ نَن لُمَ سٍ بِرِن شُن مَ،<verse eid="ISA 4:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 4:6"/>عَلْ بَفٍ شُنفبٍ نَشَن نِينِ مِشِ مَكَنتَمَ سٌفٍ مَ،</para>
  <para style="q" vid="ISA 4:6">عَ قِندِ يِرٍ كَنتَشِ رَ تُنّ فٌرٌ تّمُي.<verse eid="ISA 4:6"/></para>
  <chapter eid="ISA 4"/>
  <chapter number="5" style="c" sid="ISA 5"/>
  <para style="s">عَلَتَلَ شَ سَنسِ يِرٍ</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 5:1"/>ﭑ شَ بّيتِ بَ ﭑ شَنُنتٍنيِ بّ،</para>
  <para style="q" vid="ISA 5:1">ﭑ شَنُنتٍنيِ نَشَن بَرَ وّنِ شّ سَ.</para>
  <para style="q" vid="ISA 5:1">وّنِ شّ نُ نَ ﭑ شَنُنتٍنيِ يِ رَ بْشِ تُرَشِ مَ.<verse eid="ISA 5:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 5:2"/>عَ نَشَ بْشِ بُشَ، عَ فّمّيٍ مَتٌنفٌ، عَ سَنسِ قَنيِيٍ سِ عَ مَ.</para>
  <para style="q" vid="ISA 5:2">عَ نَشَ تِدٍ عِتٍشِ تِ نَا تَفِ،</para>
  <para style="q" vid="ISA 5:2">عَ يِلِ فٍ وّنِ بٌفِ بُندُ مَ دّننَشّ.</para>
  <para style="q" vid="ISA 5:2">عَ حْشْ نُ عَ مَ عَ سَنسِ قَمَ نّ وّنِ بٌفِ رَ مِنِدٍ،</para>
  <para style="q" vid="ISA 5:2">كْنْ عَ بٌفِ كَنَشِ نَن نَمِنِشِ.<verse eid="ISA 5:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="ISA 5:3"/>دَرِ سَلَمُكَيٍ نُن يُدَيَكَيٍ، وٌ كِيتِ ﭑ تَن نُن ﭑ مَ وّنِ شّ مَ.<verse eid="ISA 5:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 5:4"/>مُنسٍ مَن لُشِ، ﭑ مُ نَشَن نَبَشِ ﭑ مَ شّ بّ؟</para>
  <para style="q" vid="ISA 5:4">مُنقٍ رَ ﭑ شَشِلِ تٌ نُ تِشِ بٌفِ قَنيِ رَ، عَ قَ بٌفِ كَنَشِ رَ مِنِ ﭑ بّ؟<verse eid="ISA 5:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 5:5"/>ﭑ شَ عَ قَلَ وٌ بّ ﭑ نَشَن نَبَمَ ﭑ مَ شّ رَ.</para>
  <para style="q" vid="ISA 5:5">ﭑ سَنسَنيِ تَلَمَ نّ عَلَكٌ شُرُ سٍيٍ شَ عَ مَشِن.</para>
  <para style="q" vid="ISA 5:5">ﭑ تّتّ بَمَ نّ عَلَكٌ عَ شَ مَبٌرٌن.<verse eid="ISA 5:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 5:6"/>ﭑ عَ رَبٌلٌمَ نّ عَلَكٌ تُنبٍ نُن حٌوفٍ شَ بُلَ سَنسِ قَنيِ حْشْ رَ.</para>
  <para style="q" vid="ISA 5:6">ﭑ نُشُييٍ يَمَرِ مَ، عٍ نَشَ تُنّ يٌ رَيٌلٌن عَ مَ.<verse eid="ISA 5:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="ISA 5:7"/>نَ وّنِ شّ مِسَالِشِ عَلَتَلَ سّنبّمَ شَ حَمَ عِسِرَيِلَ نَن نَ،</para>
  <para style="q" vid="ISA 5:7">عَ مَن مِسَالِ يُدَيَ حَمَ قَن نَ.</para>
  <para style="q" vid="ISA 5:7">عَلَتَلَ نُ وَ مَ تِنشِنيِ نَن شْن، كْنْ عَ قَشّ تِقٍ نَن تُن تٌ نَا.</para>
  <para style="q" vid="ISA 5:7">عَ نُ وَ مَ قٍ قَنيِ نَن شْن، كْنْ عَ وَ شُي نَن تُن مّ نَا.<verse eid="ISA 5:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="ISA 5:8"/>حَشَنكَتّ نَ مِشِيٍ بّ، نَشٍيٍ بَنشِيٍ تِمَ عٍ قَرِ عِدْشْ،</para>
  <para style="q" vid="ISA 5:8">نَشٍيٍ شّيٍ دْشْمَ عٍ بٌرٍ رَ، هَن عٍ بْشِ بِرِن تٌنفٌ،</para>
  <para style="q" vid="ISA 5:8">عٍ تَن كٍرٍن فبَنسَن لُ نَا.<verse eid="ISA 5:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 5:9"/>عَلَتَلَ سّنبّمَ عَ مَسٍن نّ ﭑ بّ،</para>
  <para style="q" vid="ISA 5:9">«نَ بَنشِ فَلِيٍ قَمَ نّ تُشُنسَندٍ،</para>
  <para style="q" vid="ISA 5:9">مِشِ مُ سَبَتِمَ نَ بَنشِ تٌقَنيِيٍ كُي قَ.<verse eid="ISA 5:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 5:10"/>وّنِ شّ شُنفبٍ، بٌفِ دٌندٌرٌنتِ رَ مِنِمَ نّ.</para>
  <para style="q" vid="ISA 5:10">سَنسِ شْرِ فبٍفبٍ، قِندِ مَ مَالٍ دٌندٌرٌنتِ نَن نَ.»<verse eid="ISA 5:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="ISA 5:11"/>حَشَنكَتّ نَ مِشِيٍ بّ نَشٍيٍ كٍلِمَ سُبَشّ مَ سِفَقٍ رَ بٍيرٍ قٍندٍ،</para>
  <para style="q" vid="ISA 5:11">عٍ قَ نَ مِن هَن عٍ يَ فبٍيلِ كْي رَ.<verse eid="ISA 5:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 5:12"/>عٍ كْرَيٍ، مَشَسٍيٍ، نُن سَرَيٍ رَبٍرٍ مَ عٍ شَ شُلُنيِيٍ كُي،</para>
  <para style="q" vid="ISA 5:12">كْنْ عٍ مُ عَلَتَلَ شَ وَلِ تَن كٌلٌنمَ، عٍ مُ عَ بّلّشّ قْشِ تٌمَ.<verse eid="ISA 5:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 5:13"/>نَ قَهَامُتَرٍحَ نَن عَ نِيَمَ عٍ شَ شَنِن كٌنيِيَ كُي حَمَنّ مَ.</para>
  <para style="q" vid="ISA 5:13">عٍ شَ حَلَمَيٍ قَشَمَ نّ كَامّ رَ،</para>
  <para style="q" vid="ISA 5:13">عٍ شَ مِشِيٍ تْورْ مَ نّ يٍ شْلِ مَ.<verse eid="ISA 5:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 5:14"/>عَلِفِيَمَ نَادّ رَبِمَ نّ عٍ بّ،</para>
  <para style="q" vid="ISA 5:14">سِيٌنِ كُنتِفِيٍ نُن عٍ شَ حَمَ شَ سٌ نَا،</para>
  <para style="q" vid="ISA 5:14">عَ نُن تَا شُرُتَرٍيٍ نُن مِشِ حَاشِيٍ.<verse eid="ISA 5:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 5:15"/>عَدَ مَ شَ قٍ شُن نَكَنَمَ نّ،</para>
  <para style="q" vid="ISA 5:15">يّتّ عِفبٌي شَ قٍ فٌرٌ مَ نّ.<verse eid="ISA 5:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 5:16"/>كْنْ عَلَتَلَ سّنبّمَ تَنتُمَ نّ عَ شَ تِنشِنيِ شَ قٍ رَ.</para>
  <para style="q" vid="ISA 5:16">عَلَ سّنِيّنتْي عَ يّتّ مَسٍنمَ عَ شَ قٍ قَنيِيٍ نَن سَابُي رَ.<verse eid="ISA 5:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 5:17"/>نَ تّمُي يّشّييٍ عٍ دّ مَدٌنمَ نّ نَ يِرٍ كَنَشِيٍ مَ عَلْ عٍ نَ عٍ شْنيِ نّ،</para>
  <para style="q" vid="ISA 5:17">شْحّيٍ قَن بَلٌي تٌمَ نَا.<verse eid="ISA 5:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="ISA 5:18"/>حَشَنكَتّ نَ مِشِيٍ بّ، نَشٍيٍ يُنُبِيٍ بّندُنمَ عٍ يّتّ مَ وُلٍ رَ،</para>
  <para style="q" vid="ISA 5:18">نَشٍيٍ عٍ عٍ يّتّ شِرِ مَ قٍ حَاشِيٍ رَ عَلْ كٌتٍ نَشَن شِرِ مَ سٌقَلٍ قَرِ.<verse eid="ISA 5:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 5:19"/>نَ مِشِيٍ نُ قَ عَ قَلَ عٍ دّ رَ،</para>
  <para style="q" vid="ISA 5:19">«عَلَتَلَ شَ عَ شُلُن عَ شَ وَلِ رَبَ رَ، عَلَكٌ مُشُ شَ عَ تٌ.</para>
  <para style="q" vid="ISA 5:19">عِسِرَيِلَ مَرِفِ عَلَ سَفٌ سّنِيّنشِ شَ رَبَ، عَلَكٌ مُشُ شَ عَ كٌلٌن.»<verse eid="ISA 5:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="ISA 5:20"/>حَشَنكَتّ نَ مِشِيٍ بّ، نَشٍيٍ قٍ حَاشِ قِندِ مَ قٍ قَنيِ رَ،</para>
  <para style="q" vid="ISA 5:20">عٍ قٍ قَنيِ قِندِ قٍ حَاشِ رَ.</para>
  <para style="q" vid="ISA 5:20">عٍ دِ مِ شِلِ نَءِيَلَنيِ،</para>
  <para style="q" vid="ISA 5:20">عٍ نَءِيَلَنيِ شِلِ دِ مِ.</para>
  <para style="q" vid="ISA 5:20">قٍ شْنّ لُشِ نّ عَ بّ عَلْ قٍ حْشُنمّ،</para>
  <para style="q" vid="ISA 5:20">قٍ حْشُنمّ لُ عٍ بّ عَلْ قٍ شْنّ.<verse eid="ISA 5:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="ISA 5:21"/>حَشَنكَتّ نَ مِشِيٍ بّ، نَشٍيٍ عٍ يّتّ مَحْشُنشِ قٍ كٌلٌنيِيٍ رَ،</para>
  <para style="q" vid="ISA 5:21">عٍ عٍ يّتّ قِندِ شَشِلِمَيٍ رَ.<verse eid="ISA 5:21"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="22" style="v" sid="ISA 5:22"/>حَشَنكَتّ نَ مِشِيٍ بّ، نَشٍيٍ شِلِ شُنفبٍ سْتْمَ بٍيرٍ مِنقٍ كُي،</para>
  <para style="q" vid="ISA 5:22">عٍ قِسَ عٍ بٌورٍ بّ سِيسِ قٍ كُي.<verse eid="ISA 5:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 5:23"/>عٍ نْندِ قِ قُنمَلَ مَ كْبِرِ شَ قٍ رَ،</para>
  <para style="q" vid="ISA 5:23">عٍ نْندِ بَ نْندِ كَنيِ يِ رَ.<verse eid="ISA 5:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="ISA 5:24"/>نَ مِشِيٍ شَ قٍ شُن نَكَنَمَ نّ عَلْ سّشّ شَرَشِ فَنمَ كِ نَشّ.</para>
  <para style="q" vid="ISA 5:24">عٍ لُمَ نّ عَلْ سَنسِ نَشٍيٍ سَنكٍيٍ بْرْ مَ، عٍ قُفٍيٍ يٍنسٍن عَلْ شُبٍ،</para>
  <para style="q" vid="ISA 5:24">بَرِ مَ عٍ بَرَ مّ عَلَتَلَ سّنبّمَ شَ سّرِيّ رَ،</para>
  <para style="q" vid="ISA 5:24">عٍ عِسِرَيِلَ شَ سّنِيّنتْي شَ مَسٍنيِ مَبٍرٍ.<verse eid="ISA 5:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="ISA 5:25"/>نَ نَن عَ رَ عَلَتَلَ بْحّ تٍشِ عَ شَ حَمَ شِلِ مَ،</para>
  <para style="q" vid="ISA 5:25">عَ بّلّشّ عِتَلَشِ، عَ شَ عٍ بْنبْ.</para>
  <para style="q" vid="ISA 5:25">فٍيَيٍ بَرَ سّرّن، بِنبِيٍ بَرَ يٍنسٍن تَا كُي.</para>
  <para style="q" vid="ISA 5:25">هَلِ نَ بِرِن تٌ رَبَشِ، عَ شَ شْنّ مُ حْنشِ،</para>
  <para style="q" vid="ISA 5:25">عَ بّلّشّ مَن عِتَلَشِ عٍ شِلِ مَ.<verse eid="ISA 5:25"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="26" style="v" sid="ISA 5:26"/>عَلَتَلَ بَرَ تْنشُمَ مَسٍن حَمَنّ مَ،</para>
  <para style="q" vid="ISA 5:26">عَ عٍ شِلِ عٍ شَ قَ كٍلِقٍ يِرٍ مَكُيٍ.<verse eid="ISA 5:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="ISA 5:27"/>مِشِ تَفَنشِ يٌ مُ نَ عٍ يَ مَ،</para>
  <para style="q" vid="ISA 5:27">مِشِ يٌ سَنيِيٍ مُ بِنيَشِ عَ بُن مَ،</para>
  <para style="q" vid="ISA 5:27">مِشِ يٌ مُ كِنسْنقٍ عَ شَ شِ،</para>
  <para style="q" vid="ISA 5:27">مِشِ يٌ شَ بّلّتِ مُ قُلُنشِ عَ تَفِ،</para>
  <para style="q" vid="ISA 5:27">مِشِ يٌ شَ سَنكِرِ لُوتِ مُ بٌلٌنشِ.<verse eid="ISA 5:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="ISA 5:28"/>نَ مِشِيٍ شَ شَلِيٍ حْييٍ رَشَحّنشِ،</para>
  <para style="q" vid="ISA 5:28">عٍ شَ تَنبّ وٌلِ سٍيٍ بِرِن عِتَلَشِ عَ قَنيِ رَ،</para>
  <para style="q" vid="ISA 5:28">عٍ شَ سٌي تٌرٍيٍ شْرْشْ عَلْ فّمّ،</para>
  <para style="q" vid="ISA 5:28">عٍ شَ سْورِ رَفِسٍ سَنيِيٍ شُي فبٌ عَلْ تُرُننَادّ.<verse eid="ISA 5:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="ISA 5:29"/>عٍ حَرَندَن عَلْ يّتّ نَشَن سُبٍ سُشُمَ،</para>
  <para style="q" vid="ISA 5:29">عَ عَ شَنِن يِرٍ مَكُيٍ.<verse eid="ISA 5:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="ISA 5:30"/>نَ لْشْي عٍ حَرَندَنيِ مّمَ نّ عَلْ بَا مْرْنيِيٍ،</para>
  <para style="q" vid="ISA 5:30">تْورّ نَن تُن تٌمَ بْشِ مَ،</para>
  <para style="q" vid="ISA 5:30">نَءِيَلَنيِ قِندِ مَ دِ مِ نَن نَ،</para>
  <para style="q" vid="ISA 5:30">نُشُي عِقْورْشِيٍ لُ كٌورٍ مَ.<verse eid="ISA 5:30"/></para>
  <chapter eid="ISA 5"/>
  <chapter number="6" style="c" sid="ISA 6"/>
  <para style="s">عٍسَيِ قِندِقٍ عَلَ شَ شّيرَ رَ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 6:1"/>مَنفّ عٌسِيَسِ قَشَ حّ نَشَن نَ، ﭑ نَشَ ﭑ مَرِفِ عَلَ تٌ عَ شَ كِبَنيِ عِتٍشِ كُي. عَ شَ نْرّ نُ فبٌ، عَ شَ دٌنمَ شُنفبٍ نُ عِتَلَشِ عَ شَ هْرْ مْلِنفِرَ كُي. <verse eid="ISA 6:1"/><verse number="2" style="v" sid="ISA 6:2"/>مَلٍكّيٍ نُ نَ عَ شُن مَ. فَبُتٍنيِ سٍننِ نُ نَ كَنكَن بّ؛ فَبُتٍنيِ قِرِن نُ عٍ يَتَفِ مَكٌتٌشِ، قِرِن نُ عٍ سَنيِيٍ مَكٌتٌشِ، قِرِن نَن نُ عَ نِيَمَ عٍ شَ حّرّ كٌورٍ مَ. <verse eid="ISA 6:2"/><verse number="3" style="v" sid="ISA 6:3"/>عٍ نُ قَ عَ قَلَ عٍ بٌورٍ بّ عٍ شُي عِتٍشِ رَ،</para>
  <para style="q" vid="ISA 6:3">عَلَتَلَ سّنبّمَ سّنِيّن هَن!</para>
  <para style="q" vid="ISA 6:3">عَ شَ نْرّ دُنِحَ بِرِن لِمَ نّ!<verse eid="ISA 6:3"/></para>
  <para style="m">
    <verse number="4" style="v" sid="ISA 6:4"/>عٍ شُي نُ هْرْ مْبَنشِ نَادّيٍ رَ سّرّنمَ، بَنشِ قَ رَقٍ تُورِ رَ.<verse eid="ISA 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 6:5"/>نَ كُي ﭑ نَشَ فبٍلٍفبٍلٍ، «حَشَنكَتّ نَ ﭑ بّ، بَرِ مَ ﭑ قِندِشِ عَدَ مَدِ سّنِيّنتَرٍ نَن نَ، نَشَن سَبَتِشِ حَمَ سّنِيّنتَرٍ يَ مَ. ﭑ يَيٍ نَ ﭑ مَرِفِ عَلَ سّنبّمَ تٌ، ﭑ قَشَمَ نّ!»<verse eid="ISA 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 6:6"/>نَ تّمُي نَ مَلٍكّ كٍرٍن نَشَ تُفَن، عَ قَ ﭑ يِرٍ، تّ وٌلٍ كٍرٍن نَ عَ يِ رَ عَ نُ بَرَ نَشَن تٌنفٌ سّرّشّبَدٍ كُي. <verse eid="ISA 6:6"/><verse number="7" style="v" sid="ISA 6:7"/>عَ نَشَ عَ دْشْ ﭑ دّ رَ عَ قَ عَ قَلَ، «يِ تٌ بَرَ دِن عِ دّ رَ، عِ شَ تِنشِنتَرٍيَ بَرَ بَ، عِ شَ يُنُبِ بَرَ شَقَرِ.»<verse eid="ISA 6:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 6:8"/>ﭑ نَشَ ﭑ مَرِفِ شُي مّ عَ مَسٍن نَ، «ﭑ نَ ﭑ ندٍ شّيمَ؟ ندٍ سِفَمَ شّيرَ عِبَدٍ مُشُ بّ؟» ﭑ نَشَ عَ يَابِ، «ﭑ تَن نَن يَ. عِ شَ ﭑ تَن شّي.» <verse eid="ISA 6:8"/><verse number="9" style="v" sid="ISA 6:9"/>عَوَ، عَ نَشَ عَ قَلَ ﭑ بّ،</para>
  <para style="q" vid="ISA 6:9">«سَ عَ قَلَ يِ حَمَ بّ،</para>
  <para style="q" vid="ISA 6:9">‹وٌ وٌ تُلِ مَتِمَ ﭑ نَ، كْنْ وٌ مُ قَهَامُي سْتْ؟</para>
  <para style="q" vid="ISA 6:9">وٌ قٍ مَتٌمَ، كْنْ وٌ مُ عَ كُي كٌلٌن؟›<verse eid="ISA 6:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 6:10"/>عِ شَ يِ حَمَ شَشِلِ رَشْرْشْ،</para>
  <para style="q" vid="ISA 6:10">عِ شَ عٍ تُلِ دّ سّ، عِ شَ عٍ يَ رَفَلِ.</para>
  <para style="q" vid="ISA 6:10">عٍ يَ نُ نْمَ تٌ تِدٍ،</para>
  <para style="q" vid="ISA 6:10">عٍ تُلِ نُ نْمَ قٍ مّدٍ،</para>
  <para style="q" vid="ISA 6:10">عٍ شَشِلِ نُ نْمَ قَهَامُي سْتْدٍ،</para>
  <para style="q" vid="ISA 6:10">عٍ قَ تُوبِ، عٍ كِسِ.»<verse eid="ISA 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 6:11"/>ﭑ نَشَ عَ مَشْرِن، «ﭑ مَرِفِ، نَ بُمَ هَن تّمُي مُندُن؟» عَ نَشَ ﭑ يَابِ،</para>
  <para style="q" vid="ISA 6:11">«هَن عٍ شَ تَايٍ نَ فّ كَنَدٍ،</para>
  <para style="q" vid="ISA 6:11">مِشِيٍ شَ حْن نَا، عٍ شَ بَنشِ شَ بِرَ، عٍ شَ شّيٍ شَ فَن.<verse eid="ISA 6:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 6:12"/>هَن عَلَتَلَ نَ فّ حَمَ شَنِندٍ يِرٍ مَكُيٍ،</para>
  <para style="q" vid="ISA 6:12">عٍ شَ بْشِ قَ رَبّحِن.<verse eid="ISA 6:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 6:13"/>هَلِ مِشِ ندٍيٍ قَ كِسِ نَا،</para>
  <para style="q" vid="ISA 6:13">فبَلٌي مَن قَمَ نّ دِندٍ نَا رَ.»</para>
  <para style="b" vid="ISA 6:13"/>
  <para style="q" vid="ISA 6:13">«كْنْ وُرِ بِلِ شُنفبٍ نَ سّفّ،</para>
  <para style="q" vid="ISA 6:13">عَ سَنكٍ سّنِيّنشِ لُمَ نّ بْشِ بُن مَ.»<verse eid="ISA 6:13"/></para>
  <chapter eid="ISA 6"/>
  <chapter number="7" style="c" sid="ISA 7"/>
  <para style="s">عَلَتَلَ شَ مَسٍنيِ مَنفّ عَشَسِ بّ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 7:1"/>يُدَيَ مَنفّ عَشَسِ شَ وَشَتِ، نَشَن قِندِشِ يٌتَمِ شَ دِ نُن عٌسِيَسِ شَ مَمَدِ رَ، عَرَ مِ مَنفّ رٍ سِن نُن عِسِرَيِلَ مَنفّ ثٍكَ، رٍ مَلِيَهُ شَ دِ، عٍ نَشَ سِفَ دَرِ سَلَمُ فٍرٍدٍ، كْنْ عٍ مُ نْ عَ رَ.<verse eid="ISA 7:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 7:2"/>دَوُدَ بْنسْي مِشِيٍ تٌ عَ كٌلٌن عَ عَرَ مِكَيٍ بَرَ لَنيِ شِرِ عٍقِرَ مِ بْنسْي رَ، مَنفّ عَشَسِ نُن عَ شَ حَمَ نَشَ سّرّن فَاشُي كُي، عَلْ قٌيٍ وُرِ بِلِيٍ رَ مَشَمَ كِ نَشّ. <verse eid="ISA 7:2"/><verse number="3" style="v" sid="ISA 7:3"/>نَ تّمُي عَلَتَلَ نَشَ عَ مَسٍن عَننَبِ عٍسَيِ بّ، «عِ تَن نُن عِ شَ دِ سٍيَرَ يَسُبُ، وٌ شَ سِفَ مَنفّ عَشَسِ نَرَلَندٍ يٍ رَفَتَدٍ شُنفبٍ شَنبِ رَ، كِرَ نَشَن سِفَمَ دُفِ شَمَ دّننَشّ. <verse eid="ISA 7:3"/><verse number="4" style="v" sid="ISA 7:4"/>عَ قَلَ عَ بّ، ‹عِ نَشَ كْنتْقِلِ. عِ شَ لِمَنِيَ. هَلِ عِ مُ فَاشُ يِ مِشِ قِرِنيِ رَ، نَشٍيٍ لُمَ عَلْ تّ شُبٍنشِ نَشَن تُورِ تُن رَ مِنِمَ. عِ نَشَ فَاشُ عَرَ مِ مَنفّ رٍ سِن نُن رٍ مَلِيَهُ بْنسْي يَ رَ. <verse eid="ISA 7:4"/><verse number="5" style="v" sid="ISA 7:5"/>عَرَ مِكَيٍ، نُن رٍ مَلِيَهُ شَ مِشِيٍ عٍقِرَ مِكَيٍ بَرَ يَنقَنتٍيَ نَن شِرِ عِ شُن مَ نَ كِ، عَ قَلَقٍ رَ، <verse eid="ISA 7:5"/><verse number="6" style="v" sid="ISA 7:6"/>«وٌن شَ يُدَيَ فٍرٍ، وٌن شَ عَ يَ عِسٌ، وٌن شَ نْ عَ رَ، تَبٍيلِ شَ قِندِ عٍ شَ مَنفّ رَ.»›»<verse eid="ISA 7:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 7:7"/>كْنْ عَلَتَلَ شَ مَسٍنيِ نَن يَ نَ شَ قٍ رَ،</para>
  <para style="q" vid="ISA 7:7">«نَ مُ سْونّيَمَ، ﭑ مُ نَ رَبَمَ قٍوٌ،<verse eid="ISA 7:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 7:8"/>بَرِ مَ دَ مَسِ مَنفّ رٍ سِن نَن عَرَ مِ يَمَرِ مَ.</para>
  <para style="q" vid="ISA 7:8">حّ تٌنفٌ سٍننِ نُن سُولِ فبَنسَن نَن لُشِ،</para>
  <para style="q" vid="ISA 7:8">عٍقِرَ مِ بْنسْي شَ يٍنسٍن.<verse eid="ISA 7:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 7:9"/>سَمَرِ مَنفّ رٍ مَلِيَهُ نَن عٍقِرَ مِ يَمَرِ مَ.</para>
  <para style="q" vid="ISA 7:9">شَ وٌ مُ وٌ يّتّ تَشُ وٌ مَرِفِ عَلَ رَ،</para>
  <para style="q" vid="ISA 7:9">وٌ مُ كِسِمَ.»<verse eid="ISA 7:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 7:10"/>عَلَتَلَ نَشَ يِ مَسٍنيِ قَن تِ عَشَسِ بّ، عَ نَشّ، <verse eid="ISA 7:10"/><verse number="11" style="v" sid="ISA 7:11"/>«عِ شَ ﭑ تَن عِ مَرِفِ عَلَتَلَ مَشَندِ تْنشُمَ مَ ﭑ مَ مَسٍنيِ شَ قٍ رَ.» <verse eid="ISA 7:11"/><verse number="12" style="v" sid="ISA 7:12"/>عَشَسِ نَشَ عَ يَابِ، «ﭑ مُ سٍسٍ مَشَندِ مَ عِ مَ، بَرِ مَ ﭑ مُ وَ مَ عِ تَن عَلَتَلَ مَتٌقٍ سِيكّ كُي.»<verse eid="ISA 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 7:13"/>نَ كُي عَننَبِ عٍسَيِ نَشَ عَ قَلَ، «دَوُدَ بْنسْي، وٌ لُمَ مِشِيٍ رَتَفَن نَ، كْنْ يَكْسِ وٌ وَ مَ عَلَتَلَ نَن قَن نَتَفَنقٍ؟ <verse eid="ISA 7:13"/><verse number="14" style="v" sid="ISA 7:14"/>عَلَتَلَ يّتّ يَتِ قَمَ نّ تْنشُمَ ندٍ قِدٍ وٌ مَ؛ فِنّ دِ مّدِ ندٍ قَمَ تّفّدٍ، عَ دِ بَرِ، عَ نَ دِ شِلِ سَ عٍمَنُوّلِ، نَشَن قَسَرِشِ، ‹عَلَ نَ وٌن يَ مَ.› <verse eid="ISA 7:14"/><verse number="15" style="v" sid="ISA 7:15"/>عَ شِحّ قّنّ نُن كُمِ نَن دٌنمَ هَن عَ مْ، عَ نْ قٍ كٌبِ نُن قٍ قَنيِ تَفِ رَبَ كٌلٌندٍ. <verse eid="ISA 7:15"/><verse number="16" style="v" sid="ISA 7:16"/>كْنْ بٍينُن عَ شَ نَ سِمَيَ سْتْ، نَ مَنفّ قِرِنيِ عِ فَاشُشِ نَشٍيٍ رَ، نٍيٍ شَ بْشِيٍ قَمَ نّ كَنَدٍ. <verse eid="ISA 7:16"/><verse number="17" style="v" sid="ISA 7:17"/>نَ تّمُي عَلَتَلَ قَمَ نّ فبَلٌي ندٍ رَ وٌ شُن مَ نَشَن مُ كٌلٌنشِ وٌ نُن وٌ بَبَيٍ شَ وَشَتِ كَقِ عٍقِرَ مِ عَ مَكُيَشِ يُدَيَ رَ تّمُي نَشّ. عَلَتَلَ عَسِرِيَ مَنفّ نَن شّيمَ وٌ يِرٍ.»<verse eid="ISA 7:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 7:18"/>نَ لْشْي، عَلَتَلَ شّيرِيٍ رَقَمَ نّ كٍلِقٍ مِسِرَ شُرٍيٍ مَ، عَ نُن كُمِيٍ كٍلِقٍ عَسِرِيَ بْشِ مَ. <verse eid="ISA 7:18"/><verse number="19" style="v" sid="ISA 7:19"/>عٍ قَمَ نّ لُدٍ قٌلٍيٍ كُي، فّمّ لٌنفٌرِيٍ رَ، كُنسِيٍ قَرِ، نُن يٍ يِرٍيٍ. <verse eid="ISA 7:19"/><verse number="20" style="v" sid="ISA 7:20"/>نَ لْشْي مَرِفِ قَمَ نّ عَسِرِيَ مَنفّ رَ كٍلِقٍ شُرٍ شُنفبٍ نَاكِرِ مَ، عَ شَ وٌ رَيَافِ عَ حَاشِ رَ، عَلْ مِشِ نَشَن قَتٍ مَشَبٍ بِرِن مَبِمَ. <verse eid="ISA 7:20"/><verse number="21" style="v" sid="ISA 7:21"/>نَ لْشْي، مِشِ قَمَ نِنفٍ كٍرٍن نُن سِ قِرِن نَن فبَنسَن سْتْدٍ، <verse eid="ISA 7:21"/><verse number="22" style="v" sid="ISA 7:22"/>عٍ شِحّ قّنّ سْتْمَ نَشَن نَ. عٍ لُمَ نَ نُن كُمِ فبَنسَن نَن دٌن نَ. <verse eid="ISA 7:22"/><verse number="23" style="v" sid="ISA 7:23"/>نَ لْشْي، وّنِ بِلِ وُلُ كٍرٍن نُ نَ شّ نَشَن مَ، نَشَن سَرٍ نُ فبٍتِ كٌلٍ وُلُ كٍرٍن لِمَ، نَا قِندِ مَ نّ تُنبٍ نُن بَافِ يِرٍ رَ، <verse eid="ISA 7:23"/><verse number="24" style="v" sid="ISA 7:24"/>كٌيِنمَيٍ شَلِيٍ وٌلِمَ دّننَشّ. <verse eid="ISA 7:24"/><verse number="25" style="v" sid="ISA 7:25"/>شّيٍ نُ سَمَ فٍيَ نَشٍيٍ قَرِ، تُنبٍ نُن بَافِ دِنمَ نّ نَا رَ، مِشِ يٌ مُ سُو سَ سِفَدٍ نَا سْنْن. نَا قِندِ مَ شُرُ سٍيٍ مَدٌندٍ نَن فبَنسَن نَ.<verse eid="ISA 7:25"/></para>
  <chapter eid="ISA 7"/>
  <chapter number="8" style="c" sid="ISA 8"/>
  <para style="s">عَننَبِ عٍسَيِ شَ دِ شِلِ سَقٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 8:1"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، عَ نَشّ، «عِ شَ كّيدِ تٌنفٌ، عَ سّبّ كَلٍ رَ، ‹مَهٍرِ سَلَلِ هَسِ بَسِ،› نَشَن قَسَرِشِ ‹كَسَرّ تِ، سٍ بِرِن شَنِنمَ مَقُرٍن مَقُرٍن.› <verse eid="ISA 8:1"/><verse number="2" style="v" sid="ISA 8:2"/>عِ شَ سّرّشّدُبّ عُرِ نُن يٍبٍرٍكِيَ شَ دِ سَكَرِ شِلِ سٍيدٍيٍ رَ ﭑ بّ.»<verse eid="ISA 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 8:3"/>نَ تّمُي، ﭑ نَشَ ﭑ مَسٌ ﭑ مَ فِنّ رَ، عَ نَشَ تّفّ عَ دِ بَرِ. عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، «عَ شِلِ سَ، ‹مَهٍرِ سَلَلِ هَسِ بَسِ.› <verse eid="ISA 8:3"/><verse number="4" style="v" sid="ISA 8:4"/>بٍينُن نَ دِ شَ مْ، عَ قَ نْ عَ قَلَدٍ، ‹ﭑ نفَ، ﭑ بَ،› عَسِرِيَ مَنفّ قَمَ نّ نَاقُلِ شَنِندٍ عَ نَشَن تٌمَ دَ مَسِ تَا كُي نُن سَمَرِ بْشِ مَ.»<verse eid="ISA 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 8:5"/>عَلَتَلَ مَن نَشَ عَ مَسٍن ﭑ بّ، عَ نَشّ،<verse eid="ISA 8:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 8:6"/>«يِ حَمَ تٌ بَرَ سِلٌوَ شُرٍ شَ بَرَكَ بّحِن،</para>
  <para style="q" vid="ISA 8:6">عَلَ نَشَن قِشِ عٍ مَ،</para>
  <para style="q" vid="ISA 8:6">عٍ قَ بِرَ رٍ سِن نُن رٍ مَلِيَهُ شَ دِ شَ قٍ قْشْ رَ،<verse eid="ISA 8:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 8:7"/>ﭑ تَن عَلَتَلَ قَمَ نّ بَنبَرَنيِ شُنفبٍ رَ عٍ شِلِ مَ،</para>
  <para style="q" vid="ISA 8:7">نَشَن قِندِ عَسِرِيَ مَنفّ يّتّ عِفبٌي رَ.</para>
  <para style="q" vid="ISA 8:7">عَ سّنبّ لُمَ نّ عَلْ بَنبَرَنيِ نَشَن كٍلِمَ شُرٍ،</para>
  <para style="q" vid="ISA 8:7">عَ قَ دَنفِ بْشِ بِرِن مَ،<verse eid="ISA 8:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 8:8"/>عَ دِن يُدَيَ رَ، عَ تٍ هَن عَ فبٍ مُ نُ لُشِ مّننِكَيٍ قَن شَ مَدُلَ.</para>
  <para style="q" vid="ISA 8:8">عٍمَنُوّلِ، نَ قَمَ نّ وٌ شَ بْشِ بِرِن شُن نَكَنَدٍ.»<verse eid="ISA 8:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="ISA 8:9"/>«وٌ تَن حَمَنّ نَشٍيٍ نَ دُنِحَ،</para>
  <para style="q" vid="ISA 8:9">وٌ فٍرٍ شُي رَتٍ، كْنْ وٌ شُن نَكَنَمَ نّ.</para>
  <para style="q" vid="ISA 8:9">وٌ وٌ يّتّ يَءِلَن فٍرٍ شِلِ مَ، كْنْ وٌ قَشَمَ نّ.</para>
  <para style="q" vid="ISA 8:9">وٌ شَ تِ فٍرٍ كِ مَ، كْنْ وٌ بِرَ مَ نّ.<verse eid="ISA 8:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 8:10"/>وٌ نَتّيٍ تٌنفٌ، كْنْ عَ مُ سْونّيَمَ.</para>
  <para style="q" vid="ISA 8:10">وٌ لَنيِ شِرِ وٌ بٌورٍ تَفِ، كْنْ وٌ مُ تِمَ نّ،</para>
  <para style="q" vid="ISA 8:10">بَرِ مَ عَلَ نَ مُشُ يَ مَ.»<verse eid="ISA 8:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 8:11"/>عَلَتَلَ نَشَ ﭑ نَسِ سّنبّ رَ، عَ قَلَقٍ رَ ﭑ بّ، عَ ﭑ نَشَ بِرَ يِ حَمَ حّرّ كِ كٌبِ قْشْ رَ. عَ نَشّ،<verse eid="ISA 8:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 8:12"/>«عِ نَشَ يَنقَنتٍيَ شِلِ قَلَ قٍ مَ، يِ حَمَ عَ قَلَمَ قٍ نَشَن مَ يَنقَنتٍيَ.</para>
  <para style="q" vid="ISA 8:12">عِ نَشَ فَاشُ قٍ يَ رَ، يِ حَمَ فَاشُمَ قٍ نَشَن يَ رَ.<verse eid="ISA 8:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 8:13"/>عِ شَ مَنفّ عَلَتَلَ نَن كٌلٌن سّنِيّنتْي رَ،</para>
  <para style="q" vid="ISA 8:13">عِ شَ شَنمّ عَ تَن نَن شَ قٍ رَ،</para>
  <para style="q" vid="ISA 8:13">عِ شَ فَاشُ عَ تَن نَن يَ رَ.<verse eid="ISA 8:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 8:14"/>نَ كُي عَ قِندِ مَ نّ وٌ بّ يِرٍ سّنِيّنشِ رَ.</para>
  <para style="q" vid="ISA 8:14">كْنْ عِسِرَيِلَ بْنسْي قِرِنيِيٍ بّ،</para>
  <para style="q" vid="ISA 8:14">عَ قِندِ مَ نّ فّمّ رَ عٍ دِنمَ نَشَن نَ، عٍ قَ بِرَ،</para>
  <para style="q" vid="ISA 8:14">عَ قِندِ مَ نّ فَنتَنيِ رَ دَرِ سَلَمُكَيٍ بّ.<verse eid="ISA 8:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 8:15"/>مِشِ فبٍفبٍ عٍ سَنيِ رَدِنمَ نّ عَ رَ،</para>
  <para style="q" vid="ISA 8:15">عٍ بِرَ، عٍ عٍ مَشْنْ، عٍ شَنِن كٌنيِيَ كُي.»<verse eid="ISA 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 8:16"/>يِ سٍيدٍحْشْيَ نَشَن سّبّشِ، وٌ شَ تْنشُمَ سَ عَ مَ، وٌ شَ عَ رَفَتَ ﭑ مَ قْشِرَبِرّيٍ يِرٍ. <verse eid="ISA 8:16"/><verse number="17" style="v" sid="ISA 8:17"/>ﭑ تَن شَشِلِ تِشِ عَلَتَلَ رَ، نَشَن عَ كٌبٍ سٌشِ يَشُبَ بْنسْي رَ سِندٍن. ﭑ بَرَ ﭑ مَ لَنلَنتٍيَ سَ عَ مَ. <verse eid="ISA 8:17"/><verse number="18" style="v" sid="ISA 8:18"/>ﭑ تَن نُن ﭑ مَ دِيٍ، عَلَتَلَ نَشٍيٍ قِشِ ﭑ مَ، مُشُ قِندِشِ تْنشُمَيٍ نَن نَ عِسِرَيِلَ بْشِ مَ مَنفّ عَلَتَلَ بّ، نَشَن سَبَتِشِ سِيٌنِ فٍيَ قَرِ.<verse eid="ISA 8:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 8:19"/>مِشِ ندٍيٍ عَ قَلَمَ وٌ بّ، وٌ شَ سِفَ كَرَ مْشْييٍ يِرٍ، نَشٍيٍ مِشِ قَشَشِيٍ رَوْيّنمَ مَكْيِكْيِ رَ، وٌ شَ فُندٌ كٌلٌن. كْنْ عَ مُ لَنمَ مِشِيٍ شَ عٍ شَ مَشْرِنيِيٍ تِ عٍ مَرِفِ عَلَ تَن مَ؟ عَ لَنمَ مِشِ بَلٌشِ شَ مَشْرِنيِ تِ مِشِ قَشَشِ مَ؟ <verse eid="ISA 8:19"/><verse number="20" style="v" sid="ISA 8:20"/>وٌن شَ وٌن تُلِ مَتِ عَلَ شَ سّرِيّ رَ عَ سٍيدٍحْشْيَ قِشِ نَشَن مَ. شَ نَ مُ عَ رَ، حَمَ لُمَ دِ مِ نَن تُن كُي، <verse eid="ISA 8:20"/><verse number="21" style="v" sid="ISA 8:21"/>عٍ بْشِ عِفِرِ مَ كَامّ نُن كْنتْقِلِ نَن نَ. كَامّ نَ شْرْشْ عٍ مَ تّمُي نَشّ، عٍ عٍ يَ رَتٍمَ نّ كٌورٍ مَ، عٍ عٍ شَ مَنفّ نُن عٍ مَرِفِ عَلَ دَنكَ. <verse eid="ISA 8:21"/><verse number="22" style="v" sid="ISA 8:22"/>عٍ نَ فّ نَ رَبَدٍ، عٍ قَ عٍ يَ رَفٌرٌ دُنِحَ مَ، عٍ مُ سٍسٍ تٌمَ قٌ تْورّ، دِ مِ، نُن بْحّسَتَرٍيَ.<verse eid="ISA 8:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ISA 8:23"/>كْنْ نَ دِ مِ مُ لُمَ بْشِ مَ عَبَدَن، تْورّ مُ نْمَ نَ حَمَ رَ. سَبُلٌن نُن نَقَتَلِ بْشِ هَلَكِ نّ تّمُي دَنفِشِ، كْنْ نَ بْشِ نَشَن شِلِ قَلَمَ «حَمَنّ شَ فَلِلٍ،» نَ قَمَ نّ نْرْدٍ كٍلِقٍ بَا دّ رَ، هَن يُرُدّن نَاكِرِ مَ.<verse eid="ISA 8:23"/></para>
  <chapter eid="ISA 8"/>
  <chapter number="9" style="c" sid="ISA 9"/>
  <para style="s">دِ نَشَن قِندِ مَ مَنفّ رَ</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 9:1"/>حَمَ نَشَن نُ نَ عَ حّرّقٍ دِ مِ كُي،</para>
  <para style="q" vid="ISA 9:1">عٍ بَرَ نَءِيَلَنيِ شُنفبٍ تٌ.</para>
  <para style="q" vid="ISA 9:1">تْورّ شَ نْي نُ نَ نَشٍيٍ قَرِ،</para>
  <para style="q" vid="ISA 9:1">نَءِيَلَنيِ شُنفبٍ بَرَ يَنبَ عٍ مَ.<verse eid="ISA 9:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 9:2"/>عَلَتَلَ، عِ بَرَ نَ حَمَ شُن نَكٍلِ،</para>
  <para style="q" vid="ISA 9:2">عِ بَرَ سّيوّ شُنفبٍ قِ عٍ مَ.</para>
  <para style="q" vid="ISA 9:2">عٍ سّيوَشِ عِ يَ رَ</para>
  <para style="q" vid="ISA 9:2">عَلْ مِشِيٍ سّيوَ مَ سَنسِ شَبَ تّمُي كِ نَشّ،</para>
  <para style="q" vid="ISA 9:2">عَلْ مِشِيٍ سّيوَ مَ هَرِفٍ سْتْقٍ رَ كِ نَشّ.<verse eid="ISA 9:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="ISA 9:3"/>عٍ سّيوَشِ بَرِ مَ كٌتٍ بِنيٍ نَشَن نُ دّتّنشِ عٍ مَ،</para>
  <para style="q" vid="ISA 9:3">عِ بَرَ نَ بَ نَا،</para>
  <para style="q" vid="ISA 9:3">لُشُسِنيِ نَشَن نُ عٍ بْنبْمَ عٍ قَرِ مَ،</para>
  <para style="q" vid="ISA 9:3">عِ بَرَ نَ كَنَ عَلْ عِ مَدِيَنكَيٍ رَبِرَ تّمُي نَشّ.<verse eid="ISA 9:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 9:4"/>عٍ يَشُييٍ شَ سَنكِرِ نَشٍيٍ نُ عٍ مَبٌرٌنمَ،</para>
  <para style="q" vid="ISA 9:4">عٍ دٌنمَ نَشٍيٍ نْشْشِ وُلِ رَ،</para>
  <para style="q" vid="ISA 9:4">نٍيٍ بِرِن بَرَ وْلّ تّ شْورَ، عٍ فَن قٍوٌ.<verse eid="ISA 9:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 9:5"/>بَرِ مَ عَلَ بَرَ عَ نِيَ وٌن شَ دِ ندٍ سْتْ،</para>
  <para style="q" vid="ISA 9:5">عَ مَنفّيَ قِشِ نَشَن مَ.</para>
  <para style="q" vid="ISA 9:5">نَ دِ قَمَ شِلِدٍ يِ كِ نّ؛</para>
  <para style="q" vid="ISA 9:5">مَرَ سِمَ قِسَمَنتٍ، عَلَ سّنبّمَ،</para>
  <para style="q" vid="ISA 9:5">بَبَ نَشَن بُمَ عَبَدَن، بْحّسَ مَنفّ.<verse eid="ISA 9:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 9:6"/>عَ شَ مَنفّيَ نُن عَ شَ بْحّسَ مُ حْنمَ.</para>
  <para style="q" vid="ISA 9:6">عَ دْشْمَ نّ دَوُدَ شَ كِبَنيِ كُي عَبَدَن.</para>
  <para style="q" vid="ISA 9:6">عَ نَ مَنفّيَ رَبَمَ تِنشِنيِ نُن نْندِ نَن نَ،</para>
  <para style="q" vid="ISA 9:6">كٍلِقٍ يَكْسِ مَ هَن دَن مُ نَشَن مَ.</para>
  <para style="q" vid="ISA 9:6">مَنفّ عَلَتَلَ قَمَ نَ نَن نَبَدٍ،</para>
  <para style="q" vid="ISA 9:6">بَرِ مَ عَ مُ وَ مَ عَ قِرِن ندٍ شْن.<verse eid="ISA 9:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="ISA 9:7"/>مَرِفِ نُ بَرَ كِيتِ حَاشِ سَ يَشُبَ بْنسْي مَ،</para>
  <para style="q" vid="ISA 9:7">عَ نَشَن دْشْ عِسِرَيِلَ مَ.<verse eid="ISA 9:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 9:8"/>عٍقِرَ مِكَيٍ نُن سَمَرِكَيٍ نُ بَرَ نَ كٌلٌن،</para>
  <para style="q" vid="ISA 9:8">كْنْ عٍ نَشَ عَ قَلَ عٍ شَ يّتّ عِفبٌيَ كُي،<verse eid="ISA 9:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 9:9"/>«بِرِكِ بَنشِ بَرَ بِرَ، كْنْ مُشُ قَمَ عَ تِدٍ فّمّ مَسٌلِشِيٍ نَن نَ.</para>
  <para style="q" vid="ISA 9:9">سِكٌمٌرٌ بِلِيٍ بَرَ سّفّ، كْنْ مُشُ قَمَ سّدِرِ بِلِيٍ سِدٍ عٍ حْشْي رَ.»<verse eid="ISA 9:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 9:10"/>نَ وْيّنيِ مَ عَلَتَلَ قَمَ نّ رٍ سِن يَشُييٍ رَفٍينِدٍ عٍ شِلِ مَ،<verse eid="ISA 9:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 9:11"/>عَ قَمَ نّ عَرَ مِكَيٍ رَ كٍلِقٍ سٌفٍتٍدٍ،</para>
  <para style="q" vid="ISA 9:11">عَ قَ قِلِسِتَكَيٍ قَن نَ كٍلِ سٌفٍفٌرٌدٍ،</para>
  <para style="q" vid="ISA 9:11">عَلَكٌ عٍ شَ عِسِرَيِلَكَيٍ سْنتْ عَ حَاشِ رَ.</para>
  <para style="q" vid="ISA 9:11">هَلِ نَ بِرِن تٌ رَبَ،</para>
  <para style="q" vid="ISA 9:11">عَلَتَلَ شَ شْنّ مُ فبِلٍنشِ عٍ قْشْ رَ،</para>
  <para style="q" vid="ISA 9:11">عَ بّلّشّ مَن عِتٍشِ عٍ شِلِ مَ،<verse eid="ISA 9:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 9:12"/>بَرِ مَ حَمَ تَن تٌندِ نّ عَ يّتّ رَفبِلٍندٍ عَ بْنبْمَ مَ،</para>
  <para style="q" vid="ISA 9:12">عٍ مُ مَنفّ عَلَتَلَ قٍن.<verse eid="ISA 9:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 9:13"/>نَ كُي عَلَتَلَ عِسِرَيِلَ شُنيِ نُن عَ شُلِ بٌلٌنمَ نّ،</para>
  <para style="q" vid="ISA 9:13">عَ تُفِ بِلِ نُن كَلٍ شُنشُرِ رَبِرَ مَ نّ.<verse eid="ISA 9:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 9:14"/>عِسِرَيِلَ شُنيِ نَ عَ شَ يَرٍرَتِيٍ نَن نَ،</para>
  <para style="q" vid="ISA 9:14">عَ شُلِ نَ عَ شَ نَمِحْنمّ وُلٍ قَلّيٍ نَن نَ.<verse eid="ISA 9:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 9:15"/>نَ يَرٍرَتِيٍ بَرَ حَمَ رَلْي، عٍ بَرَ عٍ عِقُ.<verse eid="ISA 9:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 9:16"/>نَ نَن عَ رَ، عَلَتَلَ مُ حّلّشِنمَ عٍ شَ قٌنِكٍيٍ رَ،</para>
  <para style="q" vid="ISA 9:16">عَ مُ كِنِكِنِمَ عٍ شَ كِرِدِيٍ نُن كَاحّ فِنّيٍ مَ،</para>
  <para style="q" vid="ISA 9:16">بَرِ مَ عٍ بِرِن يُنُبِ حَاشِيٍ رَبَمَ،</para>
  <para style="q" vid="ISA 9:16">وْيّن كٌبِيٍ نَن تُن مِنِمَ عٍ دّ عِ.<verse eid="ISA 9:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="ISA 9:17"/>فبَلٌي نَ قَقٍ عٍ مَ عَلْ تّ نَشَن نَ قِلِ مَ،</para>
  <para style="q" vid="ISA 9:17">عَ قَ حٌوفٍ حَاشِ نُن تُنبٍ بِرِن فَن، تُورِ قَ تٍ كٌورٍ مَ.<verse eid="ISA 9:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 9:18"/>مَنفّ عَلَتَلَ شَ شْنّ بَرَ دُنِحَ رَ سّرّن،</para>
  <para style="q" vid="ISA 9:18">عَدَ مَدِيٍ بَرَ لُ عَلْ تّ نَشٍيٍ عٍ بٌورٍ فَن، مِشِ يٌ مُ كِسِ.<verse eid="ISA 9:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 9:19"/>عٍ بَرَ عٍ بٌورٍ مُحَ نَشَن نُ نَ عٍ يِرٍقَنيِ مَ،</para>
  <para style="q" vid="ISA 9:19">كْنْ عٍ نَشَ لُ كَامّ كُي.</para>
  <para style="q" vid="ISA 9:19">عٍ بَرَ ندٍ مُحَ نَشَن نُ نَ عٍ كْولَ مَ،</para>
  <para style="q" vid="ISA 9:19">كْنْ عٍ مُ وَ سَ، كَنكَن نَشَ دِن عَ بٌورٍ رَ.<verse eid="ISA 9:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 9:20"/>مَنَسِكَيٍ بَرَ عٍقِرَ مِكَيٍ تْورْ،</para>
  <para style="q" vid="ISA 9:20">عٍقِرَ مِكَيٍ بَرَ مَنَسِكَيٍ تْورْ،</para>
  <para style="q" vid="ISA 9:20">عٍ قِرِن بَرَ دِن يُدَيَ رَ.</para>
  <para style="b" vid="ISA 9:20"/>
  <para style="q" vid="ISA 9:20">هَلِ نَ بِرِن تٌ رَبَ،</para>
  <para style="q" vid="ISA 9:20">عَلَتَلَ شَ شْنّ مُ فبِلٍنشِ عٍ قْشْ رَ،</para>
  <para style="q" vid="ISA 9:20">عَ بّلّشّ مَن عِتٍشِ عٍ شِلِ مَ.<verse eid="ISA 9:20"/></para>
  <chapter eid="ISA 9"/>
  <chapter number="10" style="c" sid="ISA 10"/>
  <para style="s">عَلَتَلَ شْنْقٍ يَرٍرَتِ حَاشِيٍ مَ</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 10:1"/>حَشَنكَتّ نَ يَرٍرَتِيٍ بّ،</para>
  <para style="q" vid="ISA 10:1">نَشٍيٍ يَامَرِ حَاشِيٍ سّبّمَ، نَشٍيٍ تْوحّفّ تِمَ،<verse eid="ISA 10:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 10:2"/>عَلَكٌ عٍ شَ مِسِكِينّ تْورْ كِيتِ حَاشِ رَ،</para>
  <para style="q" vid="ISA 10:2">عٍ تِنشِنتَرٍيَ رَبَ سٍتَرٍيٍ رَ نَشَن بَلٌي بَمَ كَاحّ فِنّيٍ نُن كِرِدِيٍ يِ رَ.<verse eid="ISA 10:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 10:3"/>وٌ مُنسٍ رَبَمَ دّنتّفّ سَ لْشْي عَلَتَلَ يَ عِ؟</para>
  <para style="q" vid="ISA 10:3">وٌ وٌ شَشِلِ تِمَ ندٍ رَ عَلَكٌ وٌ شَ رَتَنفَ؟<verse eid="ISA 10:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 10:4"/>وٌ بِرَ مَ نّ فٍيلِمَنِيٍ بُن مَ،</para>
  <para style="q" vid="ISA 10:4">وٌ بْنْ مِشِ قَشَشِيٍ يَ مَ.</para>
  <para style="q" vid="ISA 10:4">هَلِ نَ بِرِن تٌ رَبَمَ،</para>
  <para style="q" vid="ISA 10:4">عَلَتَلَ شَ شْنّ مُ فبِلٍنمَ وٌ قْشْ رَ،</para>
  <para style="q" vid="ISA 10:4">عَ بّلّشّ مَن عِتٍمَ نّ وٌ شِلِ مَ.<verse eid="ISA 10:4"/></para>
  <para style="s">عَسِرِيَ شَ حَشَنكَتّ</para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 10:5"/>حَشَنكَتّ نَ عَسِرِيَ بّ،</para>
  <para style="q" vid="ISA 10:5">نَشَن قِندِشِ ﭑ مَ وُرِ بْنبْ تِ سٍ رَ ﭑ مَ شْنّ كُي.</para>
  <para style="q" vid="ISA 10:5">ﭑ مَ فبٍندٍفٍلَ نَ عَ رَ.<verse eid="ISA 10:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 10:6"/>ﭑ عٍ تَن نَن شّيمَ حَمَنّ مُرُتَشِ شِلِ مَ،</para>
  <para style="q" vid="ISA 10:6">ﭑ عٍ تَن نَن نَسِفَمَ حَمَ شِلِ مَ، نَشَن ﭑ نَشْنْشِ،</para>
  <para style="q" vid="ISA 10:6">عَلَكٌ عٍ شَ نَاقُلِ بَ نَ حَمَ يِ رَ،</para>
  <para style="q" vid="ISA 10:6">عٍ قَ عٍ مَبٌرٌن تَا كُي عَلْ بٌورَ.<verse eid="ISA 10:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="ISA 10:7"/>كْنْ عَسِرِيَكَيٍ شَ نَتّ تَن نُ نَ قٍ فبّتّ نَن مَ.</para>
  <para style="q" vid="ISA 10:7">عٍ نُ بَرَ نَتّ تٌنفٌ عٍ شَ عٍ شُن نَكَنَ كٍرٍنيِ رَ،</para>
  <para style="q" vid="ISA 10:7">عَلْ عٍ لُمَ عَ رَبَ رَ دُنِحَ مَ كِ نَشّ.<verse eid="ISA 10:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 10:8"/>عٍ شَ مَنفّ نَشّ، «ﭑ مَ سْورِ يَرٍرَتِيٍ بِرِن مُ قِندِشِ مَنفّيٍ شَ رَ؟<verse eid="ISA 10:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 10:9"/>كَلَنٌ تَا مُ سْنتْ شّ عَلْ كَرَكٍمِسِ؟</para>
  <para style="q" vid="ISA 10:9">شَمَتَ قَن مُ قَشَ شّ عَلْ عَرَثَدِ؟</para>
  <para style="q" vid="ISA 10:9">سَمَرِ مُ كَنَ شّ عَلْ دَ مَسِ؟<verse eid="ISA 10:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 10:10"/>شَ ﭑ بَرَ نْ نَ بْشِيٍ رَ عَ نُن عٍ شَ كُيٍيٍ،</para>
  <para style="q" vid="ISA 10:10">كُيٍ نَشٍيٍ سّنبّ فبٌ دَرِ سَلَمُ نُن سَمَرِ فبٍيٍ بّ،<verse eid="ISA 10:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 10:11"/>ﭑ مُ نَ مْولِ رَبَمَ شّ دَرِ سَلَمُ قَن نُن عَ شَ كُيٍيٍ رَ؟</para>
  <para style="q" vid="ISA 10:11">ﭑ نَشَن نَبَشِ سَمَرِ نُن عَ شَ كُيٍ رَ،</para>
  <para style="q" vid="ISA 10:11">ﭑ مُ نْمَ شّ نَ قَن نَبَدٍ دَرِ سَلَمُ رَ شّ؟»<verse eid="ISA 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 10:12"/>«كْنْ ﭑ تَن عَلَتَلَ نَ فّ ﭑ مَ وَلِ بِرِن نَكَمَلِدٍ سِيٌنِ فٍيَ قَرِ نُن دَرِ سَلَمُ، ﭑ قَمَ نّ ﭑ يَ رَقِندِدٍ عَسِرِيَ مَنفّ مَ، ﭑ عَ شَ يّتّ عِفبٌيَ سَرٍ رَفبِلٍن عَ مَ، <verse eid="ISA 10:12"/><verse number="13" style="v" sid="ISA 10:13"/>بَرِ مَ عَ لُمَ عَ قَلَ رَ،</para>
  <para style="q" vid="ISA 10:13">‹ﭑ بَرَ يِ بِرِن نَبَ ﭑ يّتّ سّنبّ رَ،</para>
  <para style="q" vid="ISA 10:13">ﭑ مَ قَهَامُي نَن عَ نِيَ دُنِحَ بْشِ بِرِن شَ لُ ﭑ يِ رَ،</para>
  <para style="q" vid="ISA 10:13">ﭑ بَرَ سِيٍ شَ نَاقُلِ تٌنفٌ ﭑ يّتّ بّ،</para>
  <para style="q" vid="ISA 10:13">ﭑ بَرَ نْ مَنفّ بِرِن نَ، ﭑ قِندِشِ مَنفّ سّنبّمَ نَن نَ.<verse eid="ISA 10:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 10:14"/>ﭑ بَرَ ﭑ بّلّشّ عِتَلَ سِيٍ شَ بَننَيَ تَفِ،</para>
  <para style="q" vid="ISA 10:14">ﭑ قَ نَاقُلِ تٌنفٌ عَلْ مِشِ شْنِ شّلّيٍ بَمَ عَ تّي كُي كِ نَشّ.</para>
  <para style="q" vid="ISA 10:14">مِشِ يٌ مُ نْ تْنيِ دْشْدٍ ﭑ مَ.›»<verse eid="ISA 10:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="ISA 10:15"/>«بٍرَ كٌلٍ عَ يّتّ مَتْشْمَ عَ رَوَلِمَ بّ؟</para>
  <para style="q" vid="ISA 10:15">سّرَ عَ يّتّ مَتْشْمَ كَمُدّرِ بّ؟</para>
  <para style="q" vid="ISA 10:15">بْنبْ وُرِ نْمَ مِشِ بّلّشّ رَتٍدٍ؟</para>
  <para style="q" vid="ISA 10:15">لُشُسِنيِ نْمَ مِشِ بْنبْدٍ؟<verse eid="ISA 10:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 10:16"/>نَ كُي عَلَتَلَ سّنبّمَ قَمَ نّ عَ شَ سْورِ شُنفبٍيٍ شْسِدٍ،</para>
  <para style="q" vid="ISA 10:16">عَ قَ عٍ فَن تّ شْرْشْي رَ.<verse eid="ISA 10:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 10:17"/>عِسِرَيِلَ مَرِفِ عَلَتَلَ لُمَ نّ عَلْ تّ سّنِيّنشِ،</para>
  <para style="q" vid="ISA 10:17">نَشَن عٍ شَ تُنبٍ نُن بَافِ بِرِن فَنمَ لْشْ كٍرٍن.<verse eid="ISA 10:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 10:18"/>عِسِرَيِلَ شَ قْتْنيِ نُن عَ شَ شّيٍ شُن قَمَ نّ كَنَدٍ عَلْ قُرٍ مَ نَشَن نَ شْسِقٍ.<verse eid="ISA 10:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 10:19"/>دِ مّدِ يَتِ نْمَ عَ شَ وُرِ بِلِ دْنشْييٍ كْنتِدٍ نَشٍيٍ لُمَ عَ شَ قْتْنيِيٍ كُي.»<verse eid="ISA 10:19"/></para>
  <para style="s">عِسِرَيِلَ مِشِ دْنشْييٍ</para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 10:20"/>نَ لْشْي عِسِرَيِلَ مِشِ دْنشْييٍ مُ عٍ شَشِلِ تِمَ مِشِيٍ رَ سْنْن،</para>
  <para style="q" vid="ISA 10:20">نَشٍيٍ نُ بَرَ نْ عٍ رَ.</para>
  <para style="q" vid="ISA 10:20">يَشُبَ بْنسْي عٍ شَشِلِ تِمَ عَلَتَلَ نَن نَ،</para>
  <para style="q" vid="ISA 10:20">نَشَن قِندِشِ عِسِرَيِلَ شَ سّنِيّنتْي رَ.<verse eid="ISA 10:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 10:21"/>يَشُبَ بْنسْي مِشِ دْنشْييٍ قَمَ نّ فبِلٍندٍ عَلَ سّنبّمَ مَ.<verse eid="ISA 10:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 10:22"/>عِسِرَيِلَ، هَلِ عِ شَ حَمَ سَ فبٌ نّ</para>
  <para style="q" vid="ISA 10:22">عَلْ مّيّنيِ نَشَن نَ بَا دّ رَ،</para>
  <para style="q" vid="ISA 10:22">دٌندٌرٌنتِ نَن تُن فبِلٍنمَ عٍ شْنيِ.</para>
  <para style="q" vid="ISA 10:22">عَلَتَلَ بَرَ نَتّ تٌنفٌ تِنشِنيِ كُي عِسِرَيِلَكَيٍ سْنتْقٍ رَ.<verse eid="ISA 10:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 10:23"/>عَلَتَلَ سّنبّمَ قَمَ نّ نَ نَتّ رَكَمَلِدٍ بْشِ بِرِن كَنَقٍ رَ.<verse eid="ISA 10:23"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="24" style="v" sid="ISA 10:24"/>نَ كُي عَلَتَلَ سّنبّمَ بَرَ يِ مَسٍنيِ تِ، عَ نَشّ،</para>
  <para style="q" vid="ISA 10:24">«وٌ تَن، ﭑ مَ حَمَ نَشَن سَبَتِشِ سِيٌنِ،</para>
  <para style="q" vid="ISA 10:24">هَلِ وٌ مُ فَاشُ عَسِرِيَكَيٍ يَ رَ،</para>
  <para style="q" vid="ISA 10:24">نَشٍيٍ نَ وٌ بْنبْقٍ لُشُسِنيِ نُن وُرِ رَ،</para>
  <para style="q" vid="ISA 10:24">عَلْ مِسِرَكَيٍ نُ عَ رَبَمَ كِ نَشّ.<verse eid="ISA 10:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="ISA 10:25"/>عَ فبٍ مُ لُشِ ﭑ مَ شْنّ شَ فبِلٍن وٌ قْشْ رَ،</para>
  <para style="q" vid="ISA 10:25">عَ قَ عٍ تَن شُن نَكَنَ.»<verse eid="ISA 10:25"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="26" style="v" sid="ISA 10:26"/>عَلَتَلَ سّنبّمَ قَمَ نّ عَ شَ لُشُسِنيِ عِتٍدٍ عٍ شِلِ مَ،</para>
  <para style="q" vid="ISA 10:26">عَلْ عَ نَشَن نَبَ مَدِيَنكَيٍ شَ مَنفّ عٌرٍبِ رَ.</para>
  <para style="q" vid="ISA 10:26">عَ قَمَ نّ عَ شَ يِسُشُوُرِ عِتٍدٍ بَا شُن مَ،</para>
  <para style="q" vid="ISA 10:26">عَلْ عَ رَبَ مِسِرَ بْشِ مَ كِ نَشّ.<verse eid="ISA 10:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="ISA 10:27"/>نَ لْشْي عَلَ وٌ شَ كٌتٍ بِنيٍ بَمَ نّ وٌ تُنكِ مَ عٍ نَشَن سَشِ وٌ شُن مَ.</para>
  <para style="q" vid="ISA 10:27">وٌ شُن نَكٍلِمَ نّ هَن نَ كٌتٍ بِرِن بَ وٌ شُن مَ.<verse eid="ISA 10:27"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="28" style="v" sid="ISA 10:28"/>وٌ يَشُييٍ سٌمَ نّ عَيَتَ، عٍ دَنفِ مِفِرٌن رَ، عٍ كٌتٍ ندٍ لُ مِكِمَسِ.<verse eid="ISA 10:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="ISA 10:29"/>عٍ دَنفِمَ مّننِ نّ، عٍ يٌنكِن فٍبَلِ.</para>
  <para style="q" vid="ISA 10:29">فَاشُي رَ مَكَيٍ سُشُمَ نّ،</para>
  <para style="q" vid="ISA 10:29">مِشِيٍ عٍ فِمَ نّ سْلُ شَ بْشِ مَ فِبٍيَ.<verse eid="ISA 10:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="ISA 10:30"/>بَتِ فَلِمُكَيٍ نَ وَقٍ.</para>
  <para style="q" vid="ISA 10:30">«لَيِسَكَيٍ، وٌ شَ وٌ تُلِ مَتِ.</para>
  <para style="q" vid="ISA 10:30">عَنَتْتِكَيٍ، وٌ مَكِنِكِنِ.»<verse eid="ISA 10:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="ISA 10:31"/>مَدَ مٍنَكَيٍ نَ يٍسٍنقٍ،</para>
  <para style="q" vid="ISA 10:31">فٍبِمِكَيٍ نَ عٍ نْشُنقٍ.<verse eid="ISA 10:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="ISA 10:32"/>نَ لْشْي نَ يَشُييٍ دَنمَ نٌبٌ نّ،</para>
  <para style="q" vid="ISA 10:32">عٍ عٍ بّلّشّ رَ مَشَ سِيٌنِ فٍيَ شِلِ مَ دَرِ سَلَمُ.<verse eid="ISA 10:32"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="33" style="v" sid="ISA 10:33"/>مَرِفِ عَلَتَلَ سّنبّمَ مَتٌ،</para>
  <para style="q" vid="ISA 10:33">عَ نَ وُرِ بِلِ سَلٌنيِ بٌلٌنقٍ سّنبّ رَ.</para>
  <para style="q" vid="ISA 10:33">عَ نَ وُرِ بِلِ عِتٍشِ رَبِرَقٍ بْشِ مَ.<verse eid="ISA 10:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="ISA 10:34"/>عَ قَمَ نّ لِبَن قْتْنيِ بٍلٍبٍلٍ قْندٍ عَ شَ بٍرَ رَ.<verse eid="ISA 10:34"/></para>
  <chapter eid="ISA 10"/>
  <chapter number="11" style="c" sid="ISA 11"/>
  <para style="s">عَل مَسِيهُ شَ مَنفّيَ</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 11:1"/>سَلٌنيِ ندٍ بُلَمَ نّ يِسَيِ بْنسْي مَ،</para>
  <para style="q" vid="ISA 11:1">عَ سَنكٍ عَ نِيَمَ نّ عَ شَ بٌفِ قَنيِ رَ مِنِ.<verse eid="ISA 11:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 11:2"/>عَلَتَلَ شَشِلِ فٌرٌ مَ نّ عَ مَ،</para>
  <para style="q" vid="ISA 11:2">عَ قِندِ قَهَامُي، كٌلٌنيِ، مَرَ سِ، سّنبّ، نُن عَلَ يَرَفَاشُي رَ.<verse eid="ISA 11:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 11:3"/>عَ سّيوَ مَ نّ عَلَتَلَ شَ يَرَفَاشُي كُي.</para>
  <para style="q" vid="ISA 11:3">عَ مُ كِيتِ سَمَ قٍ تٌشِ شَ نَ مُ عَ رَ قٍ مّشِ تُن شَ مَ.<verse eid="ISA 11:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 11:4"/>عَ مِسِكِينّيٍ مَكِيتِمَ نّ تِنشِنيِ رَ،</para>
  <para style="q" vid="ISA 11:4">عَ نَتّ قَنيِ تٌنفٌ سٍتَرٍيٍ بّ.</para>
  <para style="q" vid="ISA 11:4">عَ دُنِحَ مَكِيتِمَ نّ عَ شْرْشْي رَ،</para>
  <para style="q" vid="ISA 11:4">عَ يَامَرِ قِ مِشِ حَاشِيٍ شَ سْنتْ.<verse eid="ISA 11:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 11:5"/>عَ قٍ بِرِن نَبَمَ تِنشِنيِ نَن نَ،</para>
  <para style="q" vid="ISA 11:5">عَ شَ لَايِدِ مُ كَنَمَ قٍوٌ.<verse eid="ISA 11:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="ISA 11:6"/>نَ لْشْي، وُلَءِ بَرٍ نُن يّشّي لُمَ نّ يِرٍ كٍرٍن،</para>
  <para style="q" vid="ISA 11:6">شُلُمَسٍ نُن سِ، نِنفٍ يْرّ نُن يّتّ،</para>
  <para style="q" vid="ISA 11:6">عٍ بِرِن لُمَ نّ يِرٍ كٍرٍن،</para>
  <para style="q" vid="ISA 11:6">دِ مّدِ ندٍ قَ عٍ دّ مَدٌن.<verse eid="ISA 11:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 11:7"/>نِنفٍ نُن بَرَتّ عٍ دّ مَدٌنمَ نّ يِرٍ كٍرٍن،</para>
  <para style="q" vid="ISA 11:7">عٍ شَ دِيٍ سَ يِرٍ كٍرٍن.</para>
  <para style="q" vid="ISA 11:7">يّتّ نُن نِنفٍ بِرِن قَمَ سّشّ نَن دٌندٍ.<verse eid="ISA 11:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 11:8"/>نَ لْشْي دِيْرّ بٍرٍ مَ نّ تَنبَلُنبٍ رَ،</para>
  <para style="q" vid="ISA 11:8">دِ مّدِ عَ بّلّشّ رَ سٌ سَفَلٍ يِلِ كُي.<verse eid="ISA 11:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 11:9"/>قٍ شْرْشْي يٌ مُ سْتْمَ ﭑ تَن عَلَتَلَ شَ فٍيَ سّنِيّنشِ قَرِ،</para>
  <para style="q" vid="ISA 11:9">دُنِحَ بِرِن ﭑ كٌلٌنمَ نّ عَلْ يّشّيٍ بَا كٌلٌنمَ كِ نَشّ.<verse eid="ISA 11:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="ISA 11:10"/>نَ لْشْي، يِسَيِ بْنسْي قِندِ مَ تْنشُمَ نَن نَ سِ بِرِن بّ،</para>
  <para style="q" vid="ISA 11:10">عٍ قَ عٍ شُن تِ عَ رَ بِنيّ كُي.<verse eid="ISA 11:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="ISA 11:11"/>نَ لْشْي، عَلَتَلَ مَن عَ شْنيّ عِتَلَمَ نّ</para>
  <para style="q" vid="ISA 11:11">عَ شَ حَمَ دْنشْي رَكِسِقٍ رَ،</para>
  <para style="q" vid="ISA 11:11">نَشٍيٍ نُ لُمَ عَسِرِيَ، مِسِرَ، ثَتِرٌ سِ، كُسِ، عٍلَمَ، سِنَرَ، شَمَتَ، نُن بَا سُرِيٍ مَ.<verse eid="ISA 11:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 11:12"/>عَ تْنشُمَ مَسٍنمَ نّ سِ بِرِن بّ.</para>
  <para style="q" vid="ISA 11:12">عَ عِسِرَيِلَ نُن يُدَيَ مِشِيٍ مَلَنمَ نّ،</para>
  <para style="q" vid="ISA 11:12">نَشٍيٍ نُ رَيٍنسٍنشِ دُنِحَ تُنشُن نَانِ مَ.<verse eid="ISA 11:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 11:13"/>عٍقِرَ مِ بْنسْي شَ تْونّ حْنمَ نّ،</para>
  <para style="q" vid="ISA 11:13">يُدَ بْنسْي شَ فٍرٍ مَسٌقٍ قَن حْنمَ نّ.</para>
  <para style="q" vid="ISA 11:13">عٍقِرَ مِ بْحّ شِنبٍلِمَ نّ يُدَيَ مَبِرِ،</para>
  <para style="q" vid="ISA 11:13">يُدَيَ قَن فٍرٍ لُمَ نّ.<verse eid="ISA 11:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 11:14"/>عٍ لَنمَ نّ قِلِسِتَكَيٍ فٍرٍقٍ مَ سٌفٍتٍدٍ مَبِرِ،</para>
  <para style="q" vid="ISA 11:14">عٍ عٍ يَشُييٍ قَن فٍرٍ نَشٍيٍ نَ سٌفٍفٌرٌدٍ مَبِرِ.</para>
  <para style="q" vid="ISA 11:14">عٍ نْمَ نّ عٍدٌنكَيٍ نُن مٌوَبَكَيٍ رَ،</para>
  <para style="q" vid="ISA 11:14">عَمٌنِكَيٍ قَن لُ عٍ سَفٌي.<verse eid="ISA 11:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 11:15"/>عَلَتَلَ بَا عِتَشُن نّ عَ شَ حَمَ بّ عٍ تٌ كٍلِ مِسِرَ بْشِ مَ.</para>
  <para style="q" vid="ISA 11:15">عَ عٍقِرَتِ شُرٍ قَن عِتَشُنمَ نّ عَ شَ قٌيٍ مَفَاشُشِ رَ،</para>
  <para style="q" vid="ISA 11:15">عَ قَ قِندِ كِرَ رَ، حَمَ نَشٍيٍ عِفِرِ مَ عٍ شَرَشِ رَ.<verse eid="ISA 11:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 11:16"/>عَلَتَلَ كِرَ قِمَ نّ عَ شَ حَمَ دْنشْي مَ،</para>
  <para style="q" vid="ISA 11:16">عَلَكٌ عٍ شَ كٍلِ عَسِرِيَ، عَلْ عٍ بٍنبَيٍ عِسِرَيِلَكَيٍ مِنِ مِسِرَ بْشِ رَ كِ نَشّ.<verse eid="ISA 11:16"/></para>
  <chapter eid="ISA 11"/>
  <chapter number="12" style="c" sid="ISA 12"/>
  <para style="s">مَرَكِسِ مَنفّ شَ مَتْشْي</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 12:1"/>نَ لْشْي وٌ قَمَ نّ عَ قَلَدٍ،</para>
  <para style="q" vid="ISA 12:1">«مُشُ بَرَ عِ تَن عَلَتَلَ مَتْشْ.</para>
  <para style="q" vid="ISA 12:1">عِ نُ بَرَ شْنْ مُشُ مَ،</para>
  <para style="q" vid="ISA 12:1">كْنْ عِ شَ شْنّ بَرَ فبِلٍن مُشُ قْشْ رَ،</para>
  <para style="q" vid="ISA 12:1">عِ قَ مُشُ مَدُندُ.<verse eid="ISA 12:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 12:2"/>مُشُ رَكِسِمَ نَن نَ عَلَ رَ.</para>
  <para style="q" vid="ISA 12:2">مُشُ بَرَ لَ عِ رَ، سٍسٍ مُ مُشُ مَفَاشُمَ سْنْن،</para>
  <para style="q" vid="ISA 12:2">بَرِ مَ عِ تَن عَلَتَلَ نَن نَ مُشُ سّنبّ رَ،</para>
  <para style="q" vid="ISA 12:2">عِ تَن نَن نَ مُشُ شَ كِسِ رَ.</para>
  <para style="q" vid="ISA 12:2">نَ بَرَ عَ نِيَ مُشُ شَ بّيتِ بَ عِ مَتْشْقٍ رَ.»<verse eid="ISA 12:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="ISA 12:3"/>وٌ قَمَ نّ يٍ بَدٍ كِسِ دُلٌنيِ كُي سّيوّ رَ.<verse eid="ISA 12:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 12:4"/>نَ لْشْي، وٌ قَمَ نّ عَ قَلَدٍ،</para>
  <para style="q" vid="ISA 12:4">«وٌ شَ عَلَتَلَ مَتْشْ،</para>
  <para style="q" vid="ISA 12:4">وٌ شَ عَ شِلِ مَسٍن دُنِحَ بّ،</para>
  <para style="q" vid="ISA 12:4">وٌ شَ عَ شَ وَلِ قَنيِيٍ قَلَ حَمَنّ مَ.<verse eid="ISA 12:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 12:5"/>وٌ شَ عَلَتَلَ مَتْشْ بّيتِيٍ رَ عَ شَ كَابَنَكٌي شَ قٍ رَ.</para>
  <para style="q" vid="ISA 12:5">وٌ شَ دُنِحَ بِرِن نَكٌلٌن عَ شَ نْرّ رَ.<verse eid="ISA 12:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 12:6"/>وٌ تَن سِيٌنِكَيٍ، وٌ شَ وٌ شُي رَ مِنِ سّيوّ رَ،</para>
  <para style="q" vid="ISA 12:6">بَرِ مَ عِسِرَيِلَ شَ سّنِيّنتْي سّنبّ فبٌ وٌ تَفِ!»<verse eid="ISA 12:6"/></para>
  <chapter eid="ISA 12"/>
  <chapter number="13" style="c" sid="ISA 13"/>
  <para style="s">بَبِلْن شَ قٍ رَحْنيِ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 13:1"/>عَلَتَلَ شَ مَسٍنيِ عَمٌسِ شَ دِ عَننَبِ عٍسَيِ بّ بَبِلْن شِلِ مَ.<verse eid="ISA 13:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 13:2"/>وٌ تْنشُمَ رَبَ فٍيَ قَرِ،</para>
  <para style="q" vid="ISA 13:2">وٌ وٌ شُي رَتٍ عٍ يَمَرِقٍ رَ،</para>
  <para style="q" vid="ISA 13:2">عٍ شَ كُنتِفِيٍ شَ نَادّيٍ عِفبُسَن.<verse eid="ISA 13:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 13:3"/>ﭑ بَرَ يَامَرِ قِ ﭑ مَ مِشِ سُفَندِشِيٍ مَ،</para>
  <para style="q" vid="ISA 13:3">ﭑ بَرَ ﭑ مَ حَلَمَيٍ شِلِ ﭑ مَ شْنّ مَسٍندٍ شُننَكٍلِ كُي.<verse eid="ISA 13:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="ISA 13:4"/>حَمَ شُي وُندُ مَ فٍيَيٍ قَرِ،</para>
  <para style="q" vid="ISA 13:4">حَمَيٍ نَ عٍ مَلَنقٍ نَا.</para>
  <para style="q" vid="ISA 13:4">مَنفّ عَلَتَلَ نَ عَ شَ سْورِيٍ شِلِقٍ فٍرٍ مَ،<verse eid="ISA 13:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 13:5"/>عٍ كٍلِشِ يِرٍ مَكُيٍ كٌورٍ بَانيِ.</para>
  <para style="q" vid="ISA 13:5">عَلَتَلَ نُن عَ شَ مِشِيٍ قَمَ نّ يِ بْشِ حَشَنكَتَدٍ عَ شَ شْنّ كُي.<verse eid="ISA 13:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="ISA 13:6"/>وٌ شَ فبٍلٍفبٍلٍ تْورّ كُي،</para>
  <para style="q" vid="ISA 13:6">بَرِ مَ عَلَتَلَ شَ لْشْي بَرَ مَكْرّ،</para>
  <para style="q" vid="ISA 13:6">عَ نَ قَقٍ عَلْ فبَلٌي نَشَن كٍلِشِ عَلَ سّنبّمَ مَ.<verse eid="ISA 13:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 13:7"/>مِشِيٍ سّنبّ حْنمَ نّ،</para>
  <para style="q" vid="ISA 13:7">لِمَنِيَ بَ عٍ بْحّ مَ.<verse eid="ISA 13:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 13:8"/>فَاشُي نُن تْورّ نْمَ نّ عٍ رَ،</para>
  <para style="q" vid="ISA 13:8">عٍ عٍ كُتُن شْنّ بّ عَلْ فِنّ دِ قُرِ نَ كٍلِ عَ رَ.</para>
  <para style="q" vid="ISA 13:8">فَاشُي بٍلٍبٍلٍ تٌمَ نّ عٍ يَتَفِيٍ مَ.<verse eid="ISA 13:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="ISA 13:9"/>عَلَتَلَ شَ لْشْي شْرْشْي نَ قَقٍ،</para>
  <para style="q" vid="ISA 13:9">عَ قَمَ نّ عَ شَ شْنّ رَ نَشَن بْشِ شُن نَكَنَمَ،</para>
  <para style="q" vid="ISA 13:9">نَشَن يُنُبِتْييٍ سْنتْمَ.<verse eid="ISA 13:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 13:10"/>تُنبُييٍ شَ يَنبّ حْنمَ نّ،</para>
  <para style="q" vid="ISA 13:10">سٌفٍ عِقْورْ مَ نّ، كِكٍ مُ يَنبَمَ سْنْن.<verse eid="ISA 13:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 13:11"/>ﭑ دُنِحَ رَتْنمَ نّ عَ شَ قٍ حَاشِ شَ قٍ رَ،</para>
  <para style="q" vid="ISA 13:11">ﭑ يُنُبِتْي حَشَنكَتَ عٍ شَ يُنُبِيٍ شَ قٍ رَ.</para>
  <para style="q" vid="ISA 13:11">ﭑ يّتّ عِفبٌي شُن نَكَنَمَ نّ،</para>
  <para style="q" vid="ISA 13:11">ﭑ قُنمَلَيٍ شَ نْي رَبِرَ.<verse eid="ISA 13:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 13:12"/>ﭑ عَدَ مَدِيٍ شُرُنمَ نّ،</para>
  <para style="q" vid="ISA 13:12">عَلْ شّيمَ قَنيِ شُرُنمَ كِ نَشّ.<verse eid="ISA 13:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 13:13"/>ﭑ تَن مَنفّ عَلَتَلَ، ﭑ كٌورٍ نُن بْشِ رَ سّرّنمَ نّ ﭑ مَ شْنّ كُي.<verse eid="ISA 13:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 13:14"/>مِشِيٍ لُمَ نّ عٍ فِ رَ عَلْ بٌلٍ نَشَن نَ وُلَ عِ،</para>
  <para style="q" vid="ISA 13:14">عٍ لُ عَلْ شُرُ سٍ كَنتَمَ مُ نَشَن قْشْ رَ.</para>
  <para style="q" vid="ISA 13:14">عٍ فبِلٍنمَ نّ عٍ شْنيِ عٍ كٍلِشِ دّننَشّ.<verse eid="ISA 13:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 13:15"/>عٍ نَشٍيٍ سُشُمَ كِرَ رَ، عٍ قَمَ نّ عٍ سْشْدٍ تَنبّ رَ،</para>
  <para style="q" vid="ISA 13:15">عٍ قَ قَشَدٍ سَنتِدّفّمَ رَ.<verse eid="ISA 13:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 13:16"/>عٍ شَ دِيٍ سْنتْمَ نّ عَ حَاشِ رَ عٍ يَ شْرِ،</para>
  <para style="q" vid="ISA 13:16">عٍ شَ بَنشِيٍ كَسَرَ، عٍ شَ فِنّيٍ مَسَ عٍ يَ شْرِ.<verse eid="ISA 13:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="ISA 13:17"/>ﭑ نَ بِرِن نَبَمَ مٍدٍكَيٍ نَن سَابُي رَ،</para>
  <para style="q" vid="ISA 13:17">فبٍتِ نُن شّيمَ مُ نَشٍيٍ مَدَشُمَ.<verse eid="ISA 13:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 13:18"/>عٍ شَ شَلِيٍ قٌنِكٍيٍ رَبِرَ مَ نّ،</para>
  <para style="q" vid="ISA 13:18">عٍ مُ كِنِكِنِمَ دِيْرّيٍ مَ،</para>
  <para style="q" vid="ISA 13:18">عٍ مُ كِنِكِنِمَ دِ مّدِيٍ مَ.<verse eid="ISA 13:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 13:19"/>عَلَتَلَ نَن بَبِلْن شَ قٍ شُن نَكَنَمَ،</para>
  <para style="q" vid="ISA 13:19">عَلْ عَ رَبَشِ سٌدٌ مَ نُن فٌمٌرَ رَ كِ نَشّ.</para>
  <para style="q" vid="ISA 13:19">بَبِلْن، نَشَن شَ نْرّ فبٌ دُنِحَ مَ،</para>
  <para style="q" vid="ISA 13:19">عَ بِرَ مَ نّ عَ شَ يّتّ عِفبٌحَ كُي.<verse eid="ISA 13:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 13:20"/>مِشِ يٌ مُ سَبَتِمَ مّننِ سْنْن.</para>
  <para style="q" vid="ISA 13:20">هَلِ بِيَاسِلَيٍ نُن شُرُ سٍ دّ مَدٌنيِيٍ مُ يٌنكِنمَ نَا.<verse eid="ISA 13:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 13:21"/>وُلَءِ سُبٍيٍ فبَنسَن نَن لُمَ نَا.</para>
  <para style="q" vid="ISA 13:21">وُلَءِ بَرٍيٍ نُن شُندِيٍ نَن شِمَ نَا بَنشِ كَنَشِيٍ كُي.</para>
  <para style="q" vid="ISA 13:21">وُلَءِ سِيٍ تٌمَ نّ نَا تُفَنقٍ رَ.</para>
  <para style="q" vid="ISA 13:21">سِكْتّ تٌمَ نّ نَا عٍ تُفَنمَ.<verse eid="ISA 13:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 13:22"/>شُلُمَسٍيٍ نَن لُمَ عٍ شُي رَ مِنِ رَ مَنفّ بَنشِيٍ كُي،</para>
  <para style="q" vid="ISA 13:22">وُلَءِ بَرٍيٍ عٍ حّرّ نَ لٌنفٌرِ بِرِن.</para>
  <para style="q" vid="ISA 13:22">بَبِلْن حَشَنكَتَ تّمُي بَرَ عَ لِ،</para>
  <para style="q" vid="ISA 13:22">عَ فبٍ مُ لُشِ سْنْن.<verse eid="ISA 13:22"/></para>
  <chapter eid="ISA 13"/>
  <chapter number="14" style="c" sid="ISA 14"/>
  <para style="s">بَبِلْن شَ حَشَنكَتّ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 14:1"/>عَلَتَلَ كِنِكِنِمَ نّ يَشُبَ بْنسْي مَ، عَ قَ عٍ رَ سَبَتِ عٍ شْنيِ عِسِرَيِلَ بْشِ مَ. شْحّيٍ قَن كَقُمَ نّ عٍ مَ، عٍ لُ لَنيِ كُي يَشُبَ بْنسْي يَ مَ. <verse eid="ISA 14:1"/><verse number="2" style="v" sid="ISA 14:2"/>سِيٍ عٍ مَلِمَ نّ سَبَتِدٍ عٍ شْنيِ، نَ سِيٍ قَ قِندِ عِسِرَيِلَ شَ كٌنيِيٍ رَ. مِشِ نَشٍيٍ نُ بَرَ عٍ سُشُ، عٍ تَن يَتِ بَرَ قِندِ عِسِرَيِلَ شَ كٌنيِيٍ رَ.<verse eid="ISA 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 14:3"/>عَلَتَلَ نَ مَلَبُي قِ وٌ مَ وٌ شَ تْورّ نُن قٍ شْرْشْي شَ قٍ رَ تّمُي نَشّ، عَ قَ وٌ رَ مِنِ وٌ شَ كٌنيِحَ وَلِ شْرْشْي كُي نَشَن نُ بَرَ دْشْ وٌ مَ، <verse eid="ISA 14:3"/><verse number="4" style="v" sid="ISA 14:4"/>وٌ قَمَ نّ يِ مَسٍنيِ تِدٍ بَبِلْن مَنفّ بّ،</para>
  <para style="q" vid="ISA 14:4">«مُنسٍ حَشَنكَتّ كَنيِ رَلْيشِ؟</para>
  <para style="q" vid="ISA 14:4">عَ تْورّ نَشَن دْشْشِ مِشِيٍ مَ، نَ حْنشِ دِ؟<verse eid="ISA 14:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 14:5"/>عَلَتَلَ بَرَ مِشِ حَاشِ شَ وُرِ بْنبْ تِ سٍ عِبٌلٌن،</para>
  <para style="q" vid="ISA 14:5">عَ بَرَ مَنفّ كٌبِ شَ مُنيَاتِ عِفِرَ،<verse eid="ISA 14:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 14:6"/>نَشَن نُ حَمَيٍ بْنبْمَ عَ شَ بْحّ تٍ رَ، نَشَن مُ دَنمَ</para>
  <para style="q" vid="ISA 14:6">نَشَن نُ نْي دْشْمَ حَمَنّيٍ مَ عَ شَ شْنّ كُي.»<verse eid="ISA 14:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="ISA 14:7"/>«يَكْسِ دُنِحَ نَ مَلَبُي نُن شَشِلِسَ نَن كُي قَ،</para>
  <para style="q" vid="ISA 14:7">بِرِن نَ عٍ شُي عِتٍقٍ سّيوّ كُي.<verse eid="ISA 14:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 14:8"/>هَلِ وُرِ بِلِ نَشٍيٍ نَ لِبَن، عٍ نَ حّلّشِنقٍ عِ شَ قٍ دَنيِ رَ، عٍ نُ قَ عَ قَلَ،</para>
  <para style="q" vid="ISA 14:8">‹كَقِ عِ بِرَ، مِشِ يٌ مُ مُشُ قْنمَ سْنْن.›<verse eid="ISA 14:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 14:9"/>عَلِفِيَمَ نَ عَ يَءِلَنقٍ عِ قَقٍ رَ.</para>
  <para style="q" vid="ISA 14:9">كُنتِفِيٍ قُرٍيٍ رَكٍلِمَ نّ عِ يَ رَ عَلِفِيَمَ دِ مِ كُي،</para>
  <para style="q" vid="ISA 14:9">سِ مَنفّيٍ بِرِن نَكٍلِمَ نّ عٍ شَ كِبَنيِيٍ كُي،<verse eid="ISA 14:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 14:10"/>عِ رَ سّنّقٍ يِ وْيّنيِ رَ،</para>
  <para style="q" vid="ISA 14:10">‹عِ قَن سّنبّ بَرَ كَنَ عَلْ مُشُ تَن،</para>
  <para style="q" vid="ISA 14:10">وٌن بِرِن بَرَ لُ يِرٍ كٍرٍن.<verse eid="ISA 14:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 14:11"/>عِ شَ يّتّ عِفبٌيَ بَرَ رَفٌرٌ فَبُرِ كُي،</para>
  <para style="q" vid="ISA 14:11">عِ شَ سِفِيٍ بَرَ دُندُ، كُلِيٍ بَرَ لُ عِ شَ سَدٍ مَ.›»<verse eid="ISA 14:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="ISA 14:12"/>«عِ بَرَ بِرَ كٍلِقٍ كٌورٍ مَ،</para>
  <para style="q" vid="ISA 14:12">عِ تَن نَشَن نُ يَنبَمَ عَلْ سُبَشّ لٌولٌي.</para>
  <para style="q" vid="ISA 14:12">عٍ بَرَ عِ رَبِرَ بْشِ، عِ تَن نَشَن نُ نْشِ حَمَنّيٍ رَ.<verse eid="ISA 14:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 14:13"/>عِ نُ عَ قَلَ نّ عِ بْحّ كُي،</para>
  <para style="q" vid="ISA 14:13">‹ﭑ تَن تٍمَ نّ هَن عَرِيَننَ،</para>
  <para style="q" vid="ISA 14:13">ﭑ قِندِ نَا مَنفّ رَ، ﭑ دْشْ ﭑ مَ كِبَنيِ كُي</para>
  <para style="q" vid="ISA 14:13">مَلَنيِ يَ مَ نَشَن نَبَمَ نَ فٍيَ سّنِيّنشِ قَرِ.<verse eid="ISA 14:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 14:14"/>ﭑ تٍمَ نّ نُشُي قَرِ، ﭑ لُ عَلْ عَلَ سّنبّمَ.›»<verse eid="ISA 14:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="ISA 14:15"/>«كْنْ عِ شَ نَتٍ بَرَ كَنَ، عٍ بَرَ عِ رَفٌرٌ كٍلِقٍ كٌورٍ مَ هَن فَبُرِ كُي،</para>
  <para style="q" vid="ISA 14:15">عِ شَ لُ يِلِ تِلِنشِ كُي عَلِفِيَمَ.<verse eid="ISA 14:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 14:16"/>قَشَ مِشِ نَشٍيٍ عِ تٌمَ نَا،</para>
  <para style="q" vid="ISA 14:16">نٍيٍ عٍ يَ بَنبَنمَ نّ عِ رَ، عٍ قَ عَ مَحْشُن،</para>
  <para style="q" vid="ISA 14:16">‹يِ نَن قِندِشِ نَ مِشِ رَ نَشَن نُ دُنِحَ عِمَشَمَ،</para>
  <para style="q" vid="ISA 14:16">نَشَن نُ مَنفّيَ كَنَمَ،<verse eid="ISA 14:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 14:17"/>نَشَن نُ دُنِحَ قِندِ مَ فبٍنفبٍرٍنيِ رَ عَ شَ تَايٍ كَنَقٍ رَ،</para>
  <para style="q" vid="ISA 14:17">نَشَن نُ تٌندِ مَ عَ شَ فٍيلِمَنِيٍ بّحِندٍ؟›»<verse eid="ISA 14:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="ISA 14:18"/>«حَمَنّ مَنفّيٍ بِرِن نَفَتَشِ عٍ شَ فَبُرِ بِنيّ نَن كُي،<verse eid="ISA 14:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 14:19"/>كْنْ عِ تَن مُ رَفَتَشِ عِ شَ فَبُرِ كُي،</para>
  <para style="q" vid="ISA 14:19">عَلْ سَلٌنيِ نَشَن سّفّمَ وُرِ مَ،</para>
  <para style="q" vid="ISA 14:19">عَلْ سْورِ نَشَن قَشَشِ سَنتِدّفّمَ رَ عَ لُ عَ بٌورٍيٍ قُرٍيٍ يَ مَ،</para>
  <para style="q" vid="ISA 14:19">عٍ بِرِن قَ فٌرٌ عَلِفِيَمَ يِلِ كُي.<verse eid="ISA 14:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 14:20"/>بِنيّ يٌ مُ لُمَ عِ شَ حْن قٍ كُي عَلْ عٍ تَن،</para>
  <para style="q" vid="ISA 14:20">بَرِ مَ عِ بَرَ عِ شَ بْشِ تُشُنسَن، عِ بَرَ عِ شَ حَمَ سْنتْ.»</para>
  <para style="b" vid="ISA 14:20"/>
  <para style="q" vid="ISA 14:20">«مِشِ حَاشِ شَ دِيٍ شِلِ نّيمُمَ نّ دُنِحَ رَ.<verse eid="ISA 14:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 14:21"/>عٍ شَ دِيٍ كْن شَ رَشَبَ عٍ بَبَيٍ شَ يُنُبِيٍ شَ قٍ رَ،</para>
  <para style="q" vid="ISA 14:21">عٍ نَشَ عٍ عِكٍلِ قَ، عٍ بْشِ سْتْ عٍ تَايٍ تِمَ دّننَشّ.<verse eid="ISA 14:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 14:22"/>ﭑ تَن عَلَتَلَ سّنبّمَ كٍلِمَ نّ عٍ شِلِ مَ،</para>
  <para style="q" vid="ISA 14:22">ﭑ بَبِلْن شِلِ نُن عَ بْنسْي دْنشْي رَحْنمَ نّ،</para>
  <para style="q" vid="ISA 14:22">عٍ شَ دِ يٌ مُ لُمَ نَا.<verse eid="ISA 14:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 14:23"/>ﭑ عٍ شْنيِ قِندِ مَ شُندِ يِرٍ نَن نَ يٍ حَاشِ لُمَ دّننَشّ.</para>
  <para style="q" vid="ISA 14:23">ﭑ نٍيٍ شُن نَكَنَمَ قٍوٌ.»</para>
  <para style="q" vid="ISA 14:23">عَلَتَلَ سّنبّمَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="ISA 14:23"/></para>
  <para style="s">عَسِرِيَ شَ حَشَنكَتّ</para>
  <para style="q">
    <verse number="24" style="v" sid="ISA 14:24"/>مَنفّ عَلَتَلَ بَرَ عَ كَلِ يِ مَسٍنيِ رَ،</para>
  <para style="q" vid="ISA 14:24">«ﭑ نَتّ نَشَن تٌنفٌشِ عَ قَمَ كَمَلِدٍ،</para>
  <para style="q" vid="ISA 14:24">ﭑ وَشْنقٍ مُ كَنَمَ.<verse eid="ISA 14:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="ISA 14:25"/>ﭑ عَسِرِيَ بُتُشُنمَ نّ ﭑ مَ بْشِ كُي،</para>
  <para style="q" vid="ISA 14:25">ﭑ عٍ بٌرٌنمَ نّ ﭑ مَ فٍيَيٍ قَرِ.</para>
  <para style="q" vid="ISA 14:25">عٍ شَ نْي بَمَ نّ ﭑ مَ حَمَ قَرِ،</para>
  <para style="q" vid="ISA 14:25">ﭑ عٍ شَ كٌتٍ بَمَ نّ ﭑ مَ مِشِيٍ شُن.»<verse eid="ISA 14:25"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="26" style="v" sid="ISA 14:26"/>نَتّ نَن نَ كِ نَشَن تٌنفٌشِ دُنِحَ بِرِن شِلِ مَ.</para>
  <para style="q" vid="ISA 14:26">عَلَتَلَ سّنبّمَ بّلّشّ نَن نَ كِ،</para>
  <para style="q" vid="ISA 14:26">عَ نَشَن عِتَلَشِ حَمَنّيٍ بِرِن شِلِ مَ.<verse eid="ISA 14:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="ISA 14:27"/>عَلَتَلَ بَرَ نَ نَتّ تٌنفٌ.</para>
  <para style="q" vid="ISA 14:27">ندٍ نَ كَنَمَ؟</para>
  <para style="q" vid="ISA 14:27">عَلَتَلَ نَن بّلّشّ عِتَلَشِ.</para>
  <para style="q" vid="ISA 14:27">ندٍ نَ عِسٌمَ؟<verse eid="ISA 14:27"/></para>
  <para style="s">قِلِسِتَ شَ حَشَنكَتّ</para>
  <para style="p">
    <verse number="28" style="v" sid="ISA 14:28"/>مَنفّ عَشَسِ قَشَ حّ نَشَن نَ، عَلَ يِ مَسٍنيِ نَن تِ،<verse eid="ISA 14:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="ISA 14:29"/>«قِلِسِتَكَيٍ، وٌ نَشَ سّيوَ وٌ يَشُييٍ بِرَقٍ رَ.</para>
  <para style="q" vid="ISA 14:29">كٍلِقٍ بْشِمَسٍ ندٍ مَ، بْشِمَسٍ فبّتّ نَن بَرِ مَ،</para>
  <para style="q" vid="ISA 14:29">نَشَن شُلُن، عَ شْنْ نَ سِنفٍ بّ.<verse eid="ISA 14:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="ISA 14:30"/>نَ كُي، مِسِكِينّيٍ قَمَ نّ بَلٌدٍ،</para>
  <para style="q" vid="ISA 14:30">تْورْ مِشِيٍ مَلَبُمَ نّ شَشِلِسَ كُي،</para>
  <para style="q" vid="ISA 14:30">كْنْ وٌ تَن قِلِسِتَكَيٍ، ﭑ وٌ قَشَمَ نّ كَامّ رَ،</para>
  <para style="q" vid="ISA 14:30">ﭑ وٌ بْنسْي دْنشْي سْنتْمَ نّ.<verse eid="ISA 14:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="ISA 14:31"/>وَ شُي شَ مِنِ وٌ يَ مَ،</para>
  <para style="q" vid="ISA 14:31">لِمَنِيَ شَ بَ وٌ يِ!</para>
  <para style="q" vid="ISA 14:31">تُورِ قْورّ نَ تٍقٍ كْولَ بِرِ رَ،</para>
  <para style="q" vid="ISA 14:31">سْورِ يٌ مُ بَشِ عٍ رَ.»<verse eid="ISA 14:31"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="32" style="v" sid="ISA 14:32"/>يَابِ مُندُن قِمَ سِيٍ شَ شّيرَيٍ مَ؟</para>
  <para style="q" vid="ISA 14:32">عٍ عَ قَلَمَ نّ، «عَلَتَلَ نَن سِيٌنِ شَ قٍ مَبَنبَنشِ،</para>
  <para style="q" vid="ISA 14:32">عَ عَ شَ حَمَ تْورْشِ كَنتَ.»<verse eid="ISA 14:32"/></para>
  <chapter eid="ISA 14"/>
  <chapter number="15" style="c" sid="ISA 15"/>
  <para style="s">مٌوَبَ شَ حَشَنكَتّ</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 15:1"/>مَسٍنيِ نَن يَ مٌوَبَ شَ قٍ رَ؛</para>
  <para style="q" vid="ISA 15:1">عَ شَ تَا عَرِ شُن بَرَ رَكَنَ كْي كٍرٍن كُي.</para>
  <para style="q" vid="ISA 15:1">عَ شَ تَا كِرِ شُن بَرَ رَكَنَ كْي كٍرٍن كُي.<verse eid="ISA 15:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 15:2"/>دِبٌنكَيٍ سِفَمَ نّ وَدٍ عٍ شَ كُيٍيٍ يِرٍ.</para>
  <para style="q" vid="ISA 15:2">مٌوَبَكَيٍ نَ وَقٍ عٍ شَ تَايٍ نٍبٌ نُن مٍدٍبَ شَ قٍ رَ،</para>
  <para style="q" vid="ISA 15:2">عٍ عٍ شُنيِ بِي، عٍ عٍ دّ شَبٍيٍ مَشَبَ سُننُنيِ كُي.<verse eid="ISA 15:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 15:3"/>عٍ حْنيِ دُفِيٍ رَفٌرٌ مَ عٍ مَ كِرَ رَ.</para>
  <para style="q" vid="ISA 15:3">عٍ بِرِن وَ مَ نّ عٍ شُي عِتٍشِ رَ عٍ شَ بَنشِيٍ كْن نَ نُن عٍ شَ تَا مَلَندٍيٍ كُي.<verse eid="ISA 15:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 15:4"/>شّسِبْنكَيٍ نُن عٍلٍيَلٍكَيٍ نَ فبٍلٍفبٍلٍقٍ،</para>
  <para style="q" vid="ISA 15:4">عٍ وَ شُي سَ مّمَ هَن يَهَسِ تَا كُي.</para>
  <para style="q" vid="ISA 15:4">مٌوَبَ سْورِيٍ نَ فبٍلٍفبٍلٍقٍ نَ نَن مَ،</para>
  <para style="q" vid="ISA 15:4">لِمَنِيَ بَرَ بَ عٍ يِ رَ.<verse eid="ISA 15:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="ISA 15:5"/>ﭑ بْحّ قَن نَ وَقٍ مٌوَبَكَيٍ شَ قٍ رَ.</para>
  <para style="q" vid="ISA 15:5">عٍ شَ مِشِيٍ عٍ فِمَ نّ هَن سٌوَرِ تَا، هَن عٍفٍلَتِ سٍلِسِيَ تَا.</para>
  <para style="q" vid="ISA 15:5">عٍ تٍمَ نّ وَ رَ لُشِتِ،</para>
  <para style="q" vid="ISA 15:5">عٍ وَ شٌرٌنَيِمِ كِرَ رَ،<verse eid="ISA 15:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 15:6"/>بَرِ مَ نِمِرِن شُرٍ بَرَ شْرِ،</para>
  <para style="q" vid="ISA 15:6">قِيلِيٍ بَرَ شَرَ، سَنسِيٍ بَرَ كَنَ، بُرّشّ شِندٍ يٌ مُ نَ سْنْن.<verse eid="ISA 15:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 15:7"/>نَ بَرَ عَ نِيَ عٍ شَ عٍ شَ سٍ دْنشْييٍ شَنِن كٌندٍ يِرٍ شُرٍ قّ مَ.<verse eid="ISA 15:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 15:8"/>مٌوَبَ وَ شُي مّمَ نّ نَانِنيِيٍ رَ،</para>
  <para style="q" vid="ISA 15:8">هَن عٍفٍلَيِمِ، هَن بٍيرَ عٍلِمِ.<verse eid="ISA 15:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 15:9"/>دِ مْن شُرٍيٍ رَفبٍيلِشِ وُلِ رَ،</para>
  <para style="q" vid="ISA 15:9">كْنْ ﭑ مُ فّشِ سِندٍن.</para>
  <para style="q" vid="ISA 15:9">فبَلٌي دِنمَ نّ مٌوَبَكَيٍ بِرِن نَ،</para>
  <para style="q" vid="ISA 15:9">نَشٍيٍ عٍ فِمَ، نُن نَشٍيٍ لُمَ عٍ شَ بْشِ مَ.<verse eid="ISA 15:9"/></para>
  <chapter eid="ISA 15"/>
  <chapter number="16" style="c" sid="ISA 16"/>
  <para style="s">مٌوَبَكَيٍ دّ مّرِ قٍنقٍ دَرِ سَلَمُ</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 16:1"/>وٌ شَ يّشّي كٌنتٌنيِ ندٍ رَ سَنبَ بْشِ مَنفّ شْن مَ،</para>
  <para style="q" vid="ISA 16:1">كٍلِقٍ سٍلَ نَشَن نَ مٌوَبَ وُلَ عِ، هَن سِيٌنِ فٍيَ تٌقَنيِ.<verse eid="ISA 16:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 16:2"/>مٌوَبَ فِنّيٍ عٍ فِمَ نّ عَرِنٌن شُرٍ عِفِرِدٍيٍ،</para>
  <para style="q" vid="ISA 16:2">كْنْ عٍ لُمَ نّ عَلْ شْنِ نَشٍيٍ كٍرِشِ عٍ تّي كُي.<verse eid="ISA 16:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 16:3"/>مٌوَبَكَيٍ نَشّ، «دَرِ سَلَمُكَيٍ، وٌ شَ وٌ بٌرٍ تٌ،</para>
  <para style="q" vid="ISA 16:3">وٌ شَ نَتّ ندٍ تٌنفٌ مُشُ شَ قٍ رَ.</para>
  <para style="q" vid="ISA 16:3">وٌ شَ مُشُ نْشُن وٌ شْنيِ،</para>
  <para style="q" vid="ISA 16:3">وٌ نَشَ مُشُ يَنقَ وٌن يَشُييٍ مَ.<verse eid="ISA 16:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 16:4"/>وٌ شَ مٌوَبَكَيٍ رَتَنفَ كَسَرَتِ مَ،</para>
  <para style="q" vid="ISA 16:4">نَشٍيٍ كَنتَرِ قٍنمَ وٌ شْنيِ، وٌ شَ عٍ مَكَنتَ.»</para>
  <para style="b" vid="ISA 16:4"/>
  <para style="q" vid="ISA 16:4">كَسَرَتِ قَمَ سِفَدٍ،</para>
  <para style="q" vid="ISA 16:4">عَ شَ نَتّ مُ كَمَلِمَ بْشِ كَنَقٍ رَ.<verse eid="ISA 16:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 16:5"/>مَنفّ كِبَنيِ قَمَ نّ مَبَنبَندٍ دُفُتّفّيَ رَ.</para>
  <para style="q" vid="ISA 16:5">تِنشِنتْي ندٍ نَشَن قَتَنشِ دَوُدَ بْنسْي رَ،</para>
  <para style="q" vid="ISA 16:5">نَشَن كِيتِ سَمَ نْندِ رَ تِنشِنتْييٍ بّ،</para>
  <para style="q" vid="ISA 16:5">عَ قَمَ نّ عَ مَفٌرٌدٍ عَ شَ كِبَنيِ كُي.<verse eid="ISA 16:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="ISA 16:6"/>مُشُ بَرَ مٌوَبَكَيٍ شَ يّتّ عِفبٌحَ كٌلٌن.</para>
  <para style="q" vid="ISA 16:6">عَ حْشْ عَ مَ عَ قِسَ مِشِ بِرِن بّ.</para>
  <para style="q" vid="ISA 16:6">عَ عَ يّتّ مَتْشْمَ تّمُي بِرِن،</para>
  <para style="q" vid="ISA 16:6">كْنْ نْندِ يٌ مُ نَ نَ مَتْشْي كُي.<verse eid="ISA 16:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 16:7"/>يَكْسِ مٌوَبَكَيٍ نَ وَقٍ عٍ شَ بْشِ شَ قٍ رَ،</para>
  <para style="q" vid="ISA 16:7">عٍ نَ سُننُنيِ كُي كِرٍ شَرٍ سٍتِ شَ دَشَمُي كَنّ شَ قٍ رَ.<verse eid="ISA 16:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 16:8"/>شّسِبْن نُن سِبِمَ وّنِ بِلِيٍ بَرَ كَنَ.</para>
  <para style="q" vid="ISA 16:8">حَمَنّ مَنفّيٍ بَرَ نٍيٍ بِرِن كَنَ،</para>
  <para style="q" vid="ISA 16:8">نَشٍيٍ نُ سِفَمَ يَاسّرِ تَا مَبِرِ، هَن فبٍنفبٍرٍنيِ مَ، هَن بَا دّ رَ.<verse eid="ISA 16:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 16:9"/>نَ كُي ﭑ قَن وَ مَ نّ يَاسّرِ سّيتِ مَ سِبِمَ وّنِ شّ شَ قٍ رَ.</para>
  <para style="q" vid="ISA 16:9">ﭑ يَيٍ شّسِبْن نُن عٍلٍيَلٍ لِمَ نّ،</para>
  <para style="q" vid="ISA 16:9">بَرِ مَ وٌ مُ سّيوّ شُي رَ مِنِمَ سْنْن وٌ شَ شّيٍ نُن وٌ شَ وّنِ بٌفِيٍ شَ قٍ رَ.<verse eid="ISA 16:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 16:10"/>سّيوّ شُي بَرَ حْن وٌ شَ سَنسِ يِرٍيٍ.</para>
  <para style="q" vid="ISA 16:10">حّلّشِن شُي مُ مّمَ وٌ شَ وّنِ شّيٍ يِرٍ سْنْن.</para>
  <para style="q" vid="ISA 16:10">وّنِ يَءِلَنمَيٍ مُ وّنِ بٌفِ بُندُ مَ سْنْن،</para>
  <para style="q" vid="ISA 16:10">عٍ مُ حّلّشِن سِفِ سَمَ نَ وَلِ شَ قٍ رَ.<verse eid="ISA 16:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 16:11"/>ﭑ بْحّ نَ تْورْقٍ مٌوَبَ شَ قٍ رَ،</para>
  <para style="q" vid="ISA 16:11">ﭑ سٌندٌنيِ نَ وَقٍ كِرِ شَرٍ سٍتِ شَ قٍ رَ.<verse eid="ISA 16:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 16:12"/>مٌوَبَكَيٍ بَرَ مِنِ سِفَقٍ رَ عٍ شَ كُيٍيٍ يِرٍ،</para>
  <para style="q" vid="ISA 16:12">عٍ شَ سَ عٍ شَ عَلَيٍ مَكُلَ،</para>
  <para style="q" vid="ISA 16:12">كْنْ نَ قَن قِندِ مَ قٍ قُقَقُ نَن نَ.<verse eid="ISA 16:12"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="13" style="v" sid="ISA 16:13"/>عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ مٌوَبَ شَ قٍ رَ، نَشَن مَسٍنشِ تّمُي دَنفِشِ. <verse eid="ISA 16:13"/><verse number="14" style="v" sid="ISA 16:14"/>كْنْ يَكْسِ عَلَتَلَ نَشّ، «بٍينُن حّ سَشَن شَ كَمَلِ، عَلْ عَ كَمَلِمَ وَلِكّ بّ عَ شَ لَنيِ كُي كِ نَشّ، مٌوَبَكَيٍ شَ شُننَكٍلِ حْنمَ نّ، عَ شَ حَمَ مَبٍرٍ. مِشِ دٌندٌرٌنتِ نَن نَتَنفَمَ فبَلٌي مَ.»<verse eid="ISA 16:14"/></para>
  <chapter eid="ISA 16"/>
  <chapter number="17" style="c" sid="ISA 17"/>
  <para style="s">دَ مَسِ شَ حَشَنكَتّ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 17:1"/>مَسٍنيِ نَن يَ دَ مَسِ شَ قٍ رَ؛</para>
  <para style="q" vid="ISA 17:1">دَ مَسِ تَا شُن نَكَنَمَ نّ.<verse eid="ISA 17:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 17:2"/>عَرٌوٍرِ تَايٍ رَبّحِنمَ نّ،</para>
  <para style="q" vid="ISA 17:2">عٍ قِندِ قِيلِ رَ شُرُ سٍ دّ مَدٌنمَ دّننَشّ.</para>
  <para style="q" vid="ISA 17:2">مِشِ يٌ مُ لُمَ نَا نَشَن شُرُ سٍيٍ تْورْ مَ.<verse eid="ISA 17:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 17:3"/>عٍقِرَ مِ تَا مَكَنتَشِ شُن نَكَنَمَ نّ.</para>
  <para style="q" vid="ISA 17:3">دَ مَسِ مُ قِندِ مَ مَنفَتَا رَ سْنْن.</para>
  <para style="q" vid="ISA 17:3">عَرَ مِ مِشِ دْنشْييٍ لُمَ نّ عَلْ عِسِرَيِلَكَيٍ.<verse eid="ISA 17:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="ISA 17:4"/>«نَ لْشْي يَشُبَ شَ دَرِيّ شُرُنمَ نّ،</para>
  <para style="q" vid="ISA 17:4">عَ قَتٍ شْسِمَ نّ.<verse eid="ISA 17:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 17:5"/>عَ لُمَ نّ عَلْ شّي شَبَ تّمُي رٍقَ فُلُنبَ كُي.</para>
  <para style="q" vid="ISA 17:5">سَنسِيٍ تِشِ، عٍ شَبَمَيٍ قَ عٍ شَبَ.<verse eid="ISA 17:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 17:6"/>بٌفِ كٍرٍن كٍرٍن نَن لُمَ عَ سَنسِ كْن نَ،</para>
  <para style="q" vid="ISA 17:6">عَلْ عٌلِوِ بٌفِ كٍرٍن كٍرٍن لُمَ عَ بِلِ كْن نَ كِ نَشّ،</para>
  <para style="q" vid="ISA 17:6">قِرِن شَ نَ مُ عَ رَ سَشَن لُ عَ كْن نَ،</para>
  <para style="q" vid="ISA 17:6">نَانِ شَ نَ مُ عَ رَ سُولِ تٌ سَلٌنيِ كٍرٍن مَ.»</para>
  <para style="q" vid="ISA 17:6">عِسِرَيِلَ مَرِفِ عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="ISA 17:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 17:7"/>نَ لْشْي مِشِيٍ قَمَ نّ دَالِ مَرِفِ تٌدٍ، نَشَن قِندِشِ عِسِرَيِلَ شَ سّنِيّنتْي رَ. <verse eid="ISA 17:7"/><verse number="8" style="v" sid="ISA 17:8"/>عٍ مُ عٍ يَ رَقِندِ مَ كُيٍيٍ مَ سْنْن، عٍ بّلّشّ نَشٍيٍ يَءِلَنشِ. عٍ مُ سِفَمَ سُرَيِ فَندٍ عٍ شَ وُرِ مَسٌلِشِيٍ يِرٍ، عٍ بّلّشّ سٌلٍ نَشٍيٍ رَقَلَشِ.<verse eid="ISA 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 17:9"/>نَ لْشْي عٍ شَ تَا سّنبّمَيٍ رَبّحِنمَ نّ، عٍ قِندِ قْتْنيِ رَ فٍيَ قَرِ، عَلْ عَمٌرِ شَ تَايٍ رَبّحِن كِ نَشّ عِسِرَيِلَكَيٍ يَ رَ. عَ بِرِن كَنَمَ نّ.<verse eid="ISA 17:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 17:10"/>وٌ بَرَ نّيمُ وٌ رَكِسِمَ عَلَ مَ،</para>
  <para style="q" vid="ISA 17:10">نَشَن قِندِشِ وٌ كَنتَمَ رَ.</para>
  <para style="q" vid="ISA 17:10">وٌ بَرَ سَنسِ قَنيِ سِ نَشَن كٍلِشِ يِرٍ مَكُيٍ.<verse eid="ISA 17:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 17:11"/>وٌ تٌ عٍ سِ، عٍ نَشَ بُلَ وٌ يَ شْرِ نَ كُيٍ عِبَ فّيسّفّ.</para>
  <para style="q" vid="ISA 17:11">عٍ نَشَ قُفَ كٍرٍن نَ، كْنْ عَ شَبَ تّمُي وٌ مُ بٌفِ يٌ تٌمَ نَا.</para>
  <para style="q" vid="ISA 17:11">وٌ لُمَ تْورّ نَن تُن كُي.<verse eid="ISA 17:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="ISA 17:12"/>حَشَنكَتّ شُنفبٍ نَن نَ كِ.</para>
  <para style="q" vid="ISA 17:12">حَمَ فبٍفبٍ نَ وُندُقٍ عَلْ بَا مْرْنيِ،</para>
  <para style="q" vid="ISA 17:12">عٍ نَ سْنشْي رَتٍقٍ عَلْ سُسُي بٍلٍبٍلٍ.<verse eid="ISA 17:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 17:13"/>كْنْ هَلِ عٍ وُندُ،</para>
  <para style="q" vid="ISA 17:13">عٍ عٍ فِمَ نّ عَلَتَلَ شَ شَاحّ يَ رَ،</para>
  <para style="q" vid="ISA 17:13">عٍ سِفَ يِرٍ مَكُيٍ عَلْ قٌيٍ مَالٍ لَفِ شَنِنمَ كِ نَشّ،</para>
  <para style="q" vid="ISA 17:13">عَلْ قٌيٍ سّشّ شَنِنمَ كِ نَشّ فٍيَيٍ قَرِ،</para>
  <para style="q" vid="ISA 17:13">عَلْ تُرُننَادّ شُبٍ رَكٍلِمَ كِ نَشّ.<verse eid="ISA 17:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 17:14"/>عٍ قَمَ فٍرٍ رَ نُنمَرٍ تّمُي نّ،</para>
  <para style="q" vid="ISA 17:14">كْنْ بٍينُن كُيٍ شَ عِبَ، سٍسٍ مُ لُمَ نَا سْنْن.</para>
  <para style="q" vid="ISA 17:14">نَشٍيٍ دُ سُمَ وٌن شُن نَ، عٍ قُ وٌن مَ،</para>
  <para style="q" vid="ISA 17:14">نٍيٍ شَ قٍ رَبَمَ نَ كِ نّ.</para>
  <para style="q" vid="ISA 17:14">نَشٍيٍ بَفَنمَ وٌن مَ، عٍ وٌن مَ نَاقُلِ تٌنفٌ، عٍ شَ قٍ رَحْنمَ نَ كِ نّ.<verse eid="ISA 17:14"/></para>
  <chapter eid="ISA 17"/>
  <chapter number="18" style="c" sid="ISA 18"/>
  <para style="s">كُسِ شَ حَشَنكَتّ</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 18:1"/>وٌ تَن نَشٍيٍ نَ كُسِ شُرٍيٍ نَاكِرِ مَ،</para>
  <para style="q" vid="ISA 18:1">شْنِ فَبُتٍنيِ شُي مّمَ دّننَشّ،<verse eid="ISA 18:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 18:2"/>نَشٍيٍ شّيرَيٍ شّيمَ كُنكُي كُي بَا مَ.</para>
  <para style="b" vid="ISA 18:2"/>
  <para style="q" vid="ISA 18:2">ﭑ تَن بَرَ شّيرَيٍ شُلُنشِيٍ شّي نَ سِ مَ،</para>
  <para style="q" vid="ISA 18:2">سِ بْنسْي كُيٍ رَيَبُشِ،</para>
  <para style="q" vid="ISA 18:2">نَشَن مَفَاشُ كَبِ عٍ قْلّ فٍرٍ شَ قٍ رَ،</para>
  <para style="q" vid="ISA 18:2">نَشَن سَبَتِشِ بْشِ مَ شُرٍ وُيَشِ نَ دّننَشّ.<verse eid="ISA 18:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="ISA 18:3"/>وٌ تَن دُنِحَ مِشِ بِرِن،</para>
  <para style="q" vid="ISA 18:3">نَشٍيٍ سَبَتِشِ وٌ شَ بْشِ مَ،</para>
  <para style="q" vid="ISA 18:3">وٌ نَ تْنشُمَ تٌ فٍيَ قَرِ، وٌ وٌ يَ تِ نَ رَ.</para>
  <para style="q" vid="ISA 18:3">وٌ نَ سَرٍ شُي مّ، وٌ وٌ تُلِ مَتِ نَ رَ،<verse eid="ISA 18:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 18:4"/>بَرِ مَ عَلَتَلَ يِ نَن مَسٍنشِ ﭑ بّ، عَ نَشّ،</para>
  <para style="q" vid="ISA 18:4">«ﭑ مَفٌرٌشِ ﭑ شْنيِ شَشِلِسَ كُي،</para>
  <para style="q" vid="ISA 18:4">عَلْ وُيٍنيِ لُشِ سَنسِ مَ سٌفٌقُرٍ تّمُي كِ نَشّ،</para>
  <para style="q" vid="ISA 18:4">عَلْ نُشُي نَ تِ شّ شُن مَ حّمّ رَ.»<verse eid="ISA 18:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 18:5"/>بٍينُن سَنسِ شَبَ تّمُي شَ عَ لِ،</para>
  <para style="q" vid="ISA 18:5">سَنسِ نَ فّ قُفَدٍ، كْنْ عَ بٌفِ مُ مِنِشِ سِندٍن،</para>
  <para style="q" vid="ISA 18:5">عَلَتَلَ قَمَ نّ سَنسِ قُفٍ بٌلٌندٍ قِنّ رَ،</para>
  <para style="q" vid="ISA 18:5">عَ قَ سَلٌنيِيٍ يَتِ مَسّفّ.<verse eid="ISA 18:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 18:6"/>عَ بٌفِ نَن لُمَ شْنِيٍ نُن وُلَءِ سُبٍ بّ،</para>
  <para style="q" vid="ISA 18:6">عٍ نَشَن دٌنمَ سٌفٌقُرٍ نُن حّمّ رَ.<verse eid="ISA 18:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 18:7"/>نَ تّمُي سِ سّنبّمَ ندٍ قَمَ نّ هَدِيَ رَ مَنفّ عَلَتَلَ بّ،</para>
  <para style="q" vid="ISA 18:7">سِ بْنسْي كُيٍ، رَيَبُشِ،</para>
  <para style="q" vid="ISA 18:7">نَشَن مَفَاشُ يِرٍ بِرِن،</para>
  <para style="q" vid="ISA 18:7">نَشَن شَ شُي قَلَ شْنْ.</para>
  <para style="q" vid="ISA 18:7">عٍ قَمَ نَ هَدِيَ رَ سِيٌنِ فٍيَ نَن قَرِ،</para>
  <para style="q" vid="ISA 18:7">عَلَتَلَ سّنبّمَ شِلِ مَتْشْمَ دّننَشّ.<verse eid="ISA 18:7"/></para>
  <chapter eid="ISA 18"/>
  <chapter number="19" style="c" sid="ISA 19"/>
  <para style="s">مِسِرَ شَ حَشَنكَتّ نُن عٍ شَ كِسِ</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 19:1"/>حَشَنكَتّ نَ مِسِرَ بّ.</para>
  <para style="q" vid="ISA 19:1">عَلَتَلَ نَ قَقٍ مِسِرَكَيٍ شِلِ مَ نُشُي قَرِ.</para>
  <para style="q" vid="ISA 19:1">عٍ شَ كُيٍيٍ نَ سّرّنقٍ عَ يَ رَ،</para>
  <para style="q" vid="ISA 19:1">فَاشُي بَرَ لُ عٍ بْحّ مَ.<verse eid="ISA 19:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="ISA 19:2"/>ﭑ مِسِرَكَيٍ رَدِنمَ نّ عٍ بٌورٍ رَ،</para>
  <para style="q" vid="ISA 19:2">كَنكَن نُ قَ عَ نفَشَكٍرٍنيِ نُن عَ دّ قَن بٌورٍ فٍرٍ تَا نُن مَنفّيَ شَ قٍ رَ.<verse eid="ISA 19:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 19:3"/>لِمَنِيَ بَمَ نّ مِسِرَكَيٍ يِ رَ،</para>
  <para style="q" vid="ISA 19:3">ﭑ عٍ شَ نَتّ بِرِن كَنَ نّ عٍ رَ.</para>
  <para style="q" vid="ISA 19:3">عٍ مَرَ سِ قٍنمَ نّ عٍ شَ عَلَيٍ رَ،</para>
  <para style="q" vid="ISA 19:3">عٍ عٍ بٍنبَ قَشَشِيٍ مَشَندِ سٍمَتٌييٍ نُن دُورٍيٍ سَابُي رَ.<verse eid="ISA 19:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 19:4"/>ﭑ مِسِرَكَيٍ سٌمَ نّ مَنفّيٍ يِ رَ نَشٍيٍ شَ قٍ مَشْرْشْ،</para>
  <para style="q" vid="ISA 19:4">نَشٍيٍ شَ يَامَرِ قِندِ تْورّ رَ حَمَ بّ.</para>
  <para style="q" vid="ISA 19:4">عَلَتَلَ سّنبّمَ شَ مَسٍنيِ نَن يَ.<verse eid="ISA 19:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="ISA 19:5"/>بَا نُن شُرٍيٍ يٍ شْرِ مَ نّ.<verse eid="ISA 19:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 19:6"/>يٍ نَشَن لُمَ شُرٍفُلِ، عَ بْرْ مَ نّ، عَ شِرِ حَاشِ قَ تٍ.</para>
  <para style="q" vid="ISA 19:6">سَنسِ بِرِن نَشٍيٍ نَ شُرٍ دّ رَ عٍ لِسِمَ نّ.<verse eid="ISA 19:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 19:7"/>هَلِ نَشٍيٍ نَ نِلِ شُرٍ شُنفبٍ دّ رَ، عَ سٌمَ بَا مَ دّننَشّ، عٍ قَن لِسِمَ نّ.</para>
  <para style="q" vid="ISA 19:7">شّ نَشٍيٍ نَ شُرٍ دّ رَ، عٍ شَرَ مَ نّ، قٌيٍ قَ عَ بِرِن شَنِن.<verse eid="ISA 19:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 19:8"/>يّشّ سُشُي بِرِن وَ مَ نّ،</para>
  <para style="q" vid="ISA 19:8">نَشٍيٍ كْنيِ نُن يّلّ وٌلِمَ شُرٍ مَ.<verse eid="ISA 19:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 19:9"/>نَشٍيٍ فّسّ رَوَلِمَ، عٍ قَن لُمَ نّ تْورّ كُي، لِمَنِيَ بَ عٍ يِ رَ.<verse eid="ISA 19:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 19:10"/>نَشٍيٍ دُفِيٍ رَوَلِمَ، عٍ شُن نَكَنَمَ نّ، عٍ بْحّ رَحَاشُ عٍ مَ.<verse eid="ISA 19:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="ISA 19:11"/>سٌوَن مَنفّيٍ مُ سٍسٍ قَهَامُمَ،</para>
  <para style="q" vid="ISA 19:11">قِرَوُنَ شَ مَرَ سِيٍ مُ شَشِلِ قَنيِ يٌ سْتْشِ يِ قٍ كُي.</para>
  <para style="q" vid="ISA 19:11">مِشِ عَ قَلَمَ دِ قِرَوُنَ بّ،</para>
  <para style="q" vid="ISA 19:11">«مُشُ تَن قِندِشِ لْننِلَيٍ نَن نَ،</para>
  <para style="q" vid="ISA 19:11">مَنفّ قٌرِيٍ شَ دِيٍ نَن مُشُ رَ؟»<verse eid="ISA 19:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 19:12"/>وٌ شَ لْننِلَيٍ نَ مِندٍن؟</para>
  <para style="q" vid="ISA 19:12">عٍ شَ وٌ رَكٌلٌن مَنفّ عَلَتَلَ قَمَ نَشَن نَبَدٍ مِسِرَ رَ.<verse eid="ISA 19:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 19:13"/>سٌوَن مَنفّيٍ قِندِشِ شَشِلِتَرٍ نَن نَ،</para>
  <para style="q" vid="ISA 19:13">نٌقَ مَنفّيٍ مُ فّشِ قَهَامُي سْتْدٍ.</para>
  <para style="q" vid="ISA 19:13">مِسِرَ بْنسْي يَرٍرَتِيٍ نَ مِسِرَكَيٍ رَلْيقٍ نّ.<verse eid="ISA 19:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 19:14"/>مَرِفِ بَرَ عٍ شَشِلِ يَ عِسٌ،</para>
  <para style="q" vid="ISA 19:14">عَلَكٌ عٍ شَ مِسِرَكَيٍ رَلْي عٍ شَ قٍ بِرِن كُي،</para>
  <para style="q" vid="ISA 19:14">عٍ قَ لُ عَلْ سِيسِلَ نَشَن بِرَ مَ عَ شَ بْشُنيِ مَ.<verse eid="ISA 19:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 19:15"/>مِسِرَكَيٍ مُ نْمَ سٍسٍ رَ عٍ شَ مَنفّيٍ نُن عٍ شَ كُنتِفِيٍ سَابُي رَ.<verse eid="ISA 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 19:16"/>نَ لْشْي مِسِرَكَيٍ نَ مَنفّ عَلَتَلَ شَ سّنبّ تٌ، عٍ سّرّنمَ نّ فَاشُي كُي عَلْ فِنّيٍ. <verse eid="ISA 19:16"/><verse number="17" style="v" sid="ISA 19:17"/>يُدَيَ شِلِ نَن قَمَ مِسِرَكَيٍ مَفَاشُدٍ عَ حَاشِ رَ، قٍ مَ عَلَتَلَ سّنبّمَ نَشَن نَتّشِ عٍ شِلِ مَ.<verse eid="ISA 19:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 19:18"/>نَ لْشْي تَا سُولِ نَن لُمَ مِسِرَ بْشِ مَ، نَشٍيٍ كَنَان شُي قَلَمَ، عٍ مَن لُ عَلَتَلَ سّنبّمَ يِ رَ. نَ تَا ندٍ قَمَ نّ شِلِدٍ هٍرٍ سِ.<verse eid="ISA 19:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 19:19"/>نَ لْشْي سّرّشّبَدٍ كٍرٍن لُمَ نّ عَلَتَلَ بّ مِسِرَ بْشِ تَفِ، تْنشُمَ فّمّ قَن تِمَ نّ عَ بّ مِسِرَ نَانِنيِ رَ. <verse eid="ISA 19:19"/><verse number="20" style="v" sid="ISA 19:20"/>نَ قِندِ مَ عَلَتَلَ سّنبّمَ شَ تْنشُمَ نُن سٍيدٍحْشْيَ نَن نَ مِسِرَ بّ. عٍ نَ عٍ شُي رَتٍ عَلَتَلَ مَ، عَ مَرَكِسِمَ شّيمَ نّ عٍ رَتَنفَدٍ عٍ شَ حَشَنكَتَمَيٍ مَ.<verse eid="ISA 19:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 19:21"/>نَ لْشْي عَلَتَلَ عَ يّتّ مَسٍنمَ نّ مِسِرَكَيٍ بّ، عٍ قَ عَ كٌلٌن عَلَ رَ. عٍ قَمَ عَ بَتُدٍ سّرّشّ نُن سَنسِ شْرِ هَدِيَ نَن نَ، عٍ كّرّ تٌنفٌ عَ بّ عٍ نَشَن نَكَمَلِمَ. <verse eid="ISA 19:21"/><verse number="22" style="v" sid="ISA 19:22"/>عَلَتَلَ فبَلٌي رَفٌرٌ مَ نّ مِسِرَكَيٍ مَ، كْنْ عٍ نَ عٍ يّتّ رَفبِلٍن عَ مَ، عَلَتَلَ مَن كِنِكِنِمَ نّ عٍ مَ عَ شَ هِننّ رَ.<verse eid="ISA 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ISA 19:23"/>نَ لْشْي كِرَ لُمَ نّ مِسِرَ نُن عَسِرِيَ تَفِ. عَسِرِيَكَيٍ سِفَمَ نّ مِسِرَ، مِسِرَكَيٍ قَن سِفَ عَسِرِيَ. عٍ مَلَنمَ نّ يِرٍ كٍرٍن عَلَتَلَ بَتُقٍ رَ.<verse eid="ISA 19:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ISA 19:24"/>نَ لْشْي عِسِرَيِلَ، مِسِرَ، نُن عَسِرِيَ، بَرَكّ لُمَ نّ عٍ سَشَنيِ بِرِن مَ دُنِحَ. <verse eid="ISA 19:24"/><verse number="25" style="v" sid="ISA 19:25"/>عَلَتَلَ سّنبّمَ دُبَمَ نّ عٍ بّ، عَ عَ مَسٍن، «بَرَكّ شَ لُ ﭑ مَ حَمَ مِسِرَ مَ، بَرَكّ شَ لُ ﭑ مَ دَالِسٍ عَسِرِيَ بّ، بَرَكّ شَ لُ ﭑ كّ تٌنفٌمَ عِسِرَيِلَ بّ.»<verse eid="ISA 19:25"/></para>
  <chapter eid="ISA 19"/>
  <chapter number="20" style="c" sid="ISA 20"/>
  <para style="s">تْنشُمَ مِسِرَ نُن كُسِ شَ قٍ رَ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 20:1"/>عَسِرِيَ مَنفّ سَرَفْن تٌ عَ شَ سْورِ مَنفّ شّ عَسِدٌدِ تَا فٍرٍدٍ، عَ قَ نْ عَ رَ، عَ عَ سُشُ، <verse eid="ISA 20:1"/><verse number="2" style="v" sid="ISA 20:2"/>عَلَتَلَ نَشَ يَامَرِ ندٍ قِ عَمٌسُ شَ دِ عَننَبِ عٍسَيِ مَ. عَ نَشّ، «عِ شَ عِ شَ سُننُنيِ دُفِ نُن عِ شَ سَنكِرِ بَ، عِ لُ نَ كِ قَ.» عٍسَيِ نَشَ عَ رَبَتُ، عَ قَ عَ حّرّ عَ مَفٍلِ رَ.<verse eid="ISA 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 20:3"/>حّ سَشَن تٌ دَنفِ، عَلَتَلَ نَشَ عَ مَسٍن، «ﭑ مَ كٌنيِ عٍسَيِ عَ حّرّشِ عَ مَفٍلِ نَن نَ يِ حّ سَشَن بُن مَ تْنشُمَ كِ مَ مِسِرَ نُن كُسِ شَ قٍ رَ. <verse eid="ISA 20:3"/><verse number="4" style="v" sid="ISA 20:4"/>عَسِرِيَ مَنفّ قَمَ مِسِرَكَ نُن كُسِكَ مِشِ سُشُشِيٍ شَنِندٍ نَ كِ نّ. دِ مّدِيٍ نُن قٌرِيٍ بِرِن سِفَمَ عٍ مَفٍلِ نَن نَ يَافِ كُي. <verse eid="ISA 20:4"/><verse number="5" style="v" sid="ISA 20:5"/>مِشِ نَشٍيٍ شَشِلِ نُ تِشِ مِسِرَ نُن كُسِ رَ، عٍ لُمَ فَاشُي نُن يَافِ نَن كُي. <verse eid="ISA 20:5"/><verse number="6" style="v" sid="ISA 20:6"/>نَ لْشْي نَشٍيٍ نُ سَبَتِشِ بَا دّ رَ عٍ عَ قَلَمَ نّ، ‹قٍ مَتٌ نَشَن نَبَشِ مِسِرَكَيٍ نُن كُسِكَيٍ رَ. مُشُ شَشِلِ نُ تِشِ عٍ تَن نَن نَ عٍ شَ مُشُ رَتَنفَ عَسِرِيَ مَ. يَكْسِ مُشُ قَ رَتَنفَمَ دِ قَ؟›»<verse eid="ISA 20:6"/></para>
  <chapter eid="ISA 20"/>
  <chapter number="21" style="c" sid="ISA 21"/>
  <para style="s">بَبِلْن شَ حَشَنكَتّ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 21:1"/>حَشَنكَتّ مَسٍنيِ نَن يَ فبٍنفبٍرٍنيِ بّ نَشَن نَ بَا دّ رَ.</para>
  <para style="q" vid="ISA 21:1">مِشِ مَفَاشُشِيٍ نَ قَقٍ عَلْ تُرُننَادّ</para>
  <para style="q" vid="ISA 21:1">كٍلِقٍ نٍفٍوِ فبٍنفبٍرٍنيِ مَ</para>
  <para style="q" vid="ISA 21:1">قٍ شْرْشْي كٍلِمَ دّننَشّ.<verse eid="ISA 21:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="ISA 21:2"/>ﭑ بَرَ لَامَتُنيِ مَفَاشُشِ تٌ.</para>
  <para style="q" vid="ISA 21:2">«يَنقَنتٍ نَ يَنقّ تِقٍ، كَسَرَتِ نَ كَسَرّ تِقٍ.</para>
  <para style="q" vid="ISA 21:2">عٍلَمَ، فٍرٍ تِ عَ بّ. مٍدِيَ، عَ رَبِلِن.</para>
  <para style="q" vid="ISA 21:2">ﭑ قَمَ تْورّ دَندٍ بَبِلْن قِندِشِ نَشَن سَابُي رَ.»<verse eid="ISA 21:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="ISA 21:3"/>«نَ كُي ﭑ قَتٍ يَتِ نَ تْورْقٍ عَلْ فِنّ دِ قُرِ نَ كٍلِ عَ رَ.</para>
  <para style="q" vid="ISA 21:3">ﭑ نَشَن تٌ، ﭑ نَشَن مّ، نَ بَرَ ﭑ كَابَ.<verse eid="ISA 21:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 21:4"/>ﭑ بْحّ نَ تْورْقٍ، ﭑ نَ سّرّنقٍ فَاشُي كُي.</para>
  <para style="q" vid="ISA 21:4">ﭑ نُ نَ بْحّسَ مَمّقٍ عَلَكٌ ﭑ شَ مَلَبُي سْتْ،</para>
  <para style="q" vid="ISA 21:4">كْنْ يَكْسِ نَ بَرَ قِندِ قٍ مَفَاشُشِ رَ ﭑ بّ.»<verse eid="ISA 21:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="ISA 21:5"/>«دٌنسٍ يَءِلَن، وٌن شَ وٌن دّفّ يِرٍ كٍرٍن.</para>
  <para style="q" vid="ISA 21:5">سْورِ يَرٍرَتِيٍ وٌ وٌ شَ كَنتَ سٍيٍ يَءِلَن.»<verse eid="ISA 21:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 21:6"/>عَلَتَلَ عَ مَسٍن نّ ﭑ بّ، عَ نَشّ،</para>
  <para style="q" vid="ISA 21:6">«يِرٍ مَكَنتّ تِ، عَلَكٌ عَ قٍ نَشَن تٌمَ عَ شَ نَ مَسٍن وٌ بّ.<verse eid="ISA 21:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 21:7"/>عَ قَمَ نّ سْورِيٍ تٌدٍ قِرِن قِرِن نَ، سٌييٍ، سٌقَلٍيٍ، نُن حْشْمّيٍ قَرِ.</para>
  <para style="q" vid="ISA 21:7">عَ شَ عٍ مَتٌ عَ قَنيِ رَ.»<verse eid="ISA 21:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="ISA 21:8"/>عَ مُ بُ، يِرٍ مَكَنتّ نَشَ عَ شُي رَ مِنِ عَلْ يّتّ شَاحّ، عَ قَلَقٍ رَ،</para>
  <para style="q" vid="ISA 21:8">«لْشْ يٌ لْشْ ﭑ تِمَ نَا قٍ مَتٌدٍ،</para>
  <para style="q" vid="ISA 21:8">كْي يٌ كْي ﭑ مَمّ تِمَ نَا.<verse eid="ISA 21:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 21:9"/>ﭑ سْورِ رَفِيٍ تٌمَ قَ رَ قِرِن قِرِن نَ.</para>
  <para style="q" vid="ISA 21:9">عٍ نَشّ، ‹بَبِلْن بَرَ بِرَ،</para>
  <para style="q" vid="ISA 21:9">عٍ شَ كُيٍيٍ بِرِن سَشِ بْشِ مَ شُنتُن شُنتُنيِ رَ.›<verse eid="ISA 21:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 21:10"/>وٌ تَن ﭑ مَ حَمَ نَشَن بَرَ بْنبْ عَلْ مَالٍ نَشَن نَ لٌنيِ مَ،</para>
  <para style="q" vid="ISA 21:10">عِسِرَيِلَ مَرِفِ عَلَتَلَ سّنبّمَ شَ مَسٍنيِ نَن يِ كِ.»<verse eid="ISA 21:10"/></para>
  <para style="s">دُ مَ شَ حَشَنكَتّ</para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 21:11"/>حَشَنكَتّ نَ دُ مَكَيٍ بّ.</para>
  <para style="q" vid="ISA 21:11">مِشِ ندٍ ﭑ شِلِمَ كٍلِقٍ سٍيِرِ، عَ نَشّ،</para>
  <para style="q" vid="ISA 21:11">«يِرٍ كَنتَمَ، مُنسٍ رَبَشِ يِ كْي رَ؟</para>
  <para style="q" vid="ISA 21:11">مُنسٍ دَنفِشِ نَا؟»<verse eid="ISA 21:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 21:12"/>يِرٍ كَنتَمَ قَ عَ يَابِ،</para>
  <para style="q" vid="ISA 21:12">«كُيٍ نَ عِبَقٍ، كْنْ كْي مَن سٌمَ نّ.</para>
  <para style="q" vid="ISA 21:12">شَ وٌ وَ مَ نَ كٌلٌنقٍ،</para>
  <para style="q" vid="ISA 21:12">وٌ مَن شَ قَ ﭑ مَشْرِن.</para>
  <para style="q" vid="ISA 21:12">عِيٌ، وٌ مَن شَ قَ.»<verse eid="ISA 21:12"/></para>
  <para style="s">عَرَبُ شَ حَشَنكَتّ</para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 21:13"/>حَشَنكَتّ نَ عَرَبُيٍ بّ.</para>
  <para style="q" vid="ISA 21:13">وٌ تَن دٍدَنكَ نَشٍيٍ يٌنكِنمَ كْي رَ عَرَبُ وُلَ عِ،<verse eid="ISA 21:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 21:14"/>وٌ شَ قَ يٍ رَ مِشِيٍ بّ يٍ شْلِ نَ نَشٍيٍ مَ.</para>
  <para style="q" vid="ISA 21:14">تٍمَكَيٍ وٌ شَ قَ تَامِ رَ مِشِ بّ<verse eid="ISA 21:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 21:15"/>نَشٍيٍ نَ عٍ فِقٍ سَنتِدّفّمَ يَ رَ نَشَن وَ مَ عٍ قَشَقٍ،</para>
  <para style="q" vid="ISA 21:15">نَشٍيٍ نَ عٍ فِقٍ شَلِ يَ رَ نَشَن وَ مَ عٍ سْنتْقٍ.<verse eid="ISA 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 21:16"/>عَلَتَلَ يِ نَن مَسٍنشِ ﭑ بّ، «حّ كٍرٍن نَن تُن لُشِ كٍدَرِ شَ قٍ شَ دَن، عَلْ وَلِكّ حّ كْنتِمَ كِ نَشّ. <verse eid="ISA 21:16"/><verse number="17" style="v" sid="ISA 21:17"/>كٍدَرِ شَ سْورِيٍ شَ شَلِيٍ شُرُنمَ نّ.» عَلَتَلَ نَن شُي عَ رَ، عِسِرَيِلَ مَرِفِ عَلَ.<verse eid="ISA 21:17"/></para>
  <chapter eid="ISA 21"/>
  <chapter number="22" style="c" sid="ISA 22"/>
  <para style="s">دَرِ سَلَمُ شَ حَشَنكَتّ</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 22:1"/>حَشَنكَتّ نَ فُلُنبَ بّ تٌي تِمَ دّننَشّ.</para>
  <para style="q" vid="ISA 22:1">مُنسٍ عَ نِيَشِ وٌ بِرِن تٍشِ وٌ شَ بَنشِيٍ قَرِ؟<verse eid="ISA 22:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 22:2"/>سِنفٍ وٌ نُ شُلُنيِ رَبَمَ، وٌ نُ وٌ شُي عِتٍ حّلّشِنيِ كُي،</para>
  <para style="q" vid="ISA 22:2">كْنْ يَكْسِ وٌ شَ قٍ نَ دِ؟</para>
  <para style="q" vid="ISA 22:2">وٌ شَ مِشِيٍ مُ قَشَ سَنتِدّفّمَ رَ،</para>
  <para style="q" vid="ISA 22:2">عٍ مُ قَشَ فٍرٍ كُي.<verse eid="ISA 22:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 22:3"/>وٌ شَ مَنفّيٍ نَن تُن عٍ فِشِ عٍ سِفَ يِرٍ مَكُيٍ.</para>
  <para style="q" vid="ISA 22:3">مِشِ نَشٍيٍ لُشِ، نٍيٍ بَرَ سُشُ فٍرٍ يٌ مُ سٌ.<verse eid="ISA 22:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 22:4"/>نَ كُي ﭑ نَشَ عَ قَلَ، «وٌ ﭑ لُ نَ، ﭑ شَ وَ عَ شْرْشْي رَ.</para>
  <para style="q" vid="ISA 22:4">وٌ نَشَ كَتَ ﭑ مَدُندُقٍ رَ ﭑ مَ حَمَ شَ كَسَرّ مَ.»<verse eid="ISA 22:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="ISA 22:5"/>عَلَتَلَ سّنبّمَ شَ لْشْي يَ عِسٌشِ نَن نُ عَ رَ،</para>
  <para style="q" vid="ISA 22:5">كَسَرّ نُن تْورّ نُ فبٌشِ تّمُي نَشّ فُلُنبَ كُي تٌي تِمَ دّننَشّ.</para>
  <para style="q" vid="ISA 22:5">تّتّ نُ بِرَ مَ، سْنشْي نُ تٍمَ فٍيَ قَرِ.<verse eid="ISA 22:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 22:6"/>عٍلَمَكَيٍ عٍ شَ شَلِ سَسٍ فبَكُمَ عٍ مَ،</para>
  <para style="q" vid="ISA 22:6">عٍ نُ سِفَمَ سْورِ رَفِسٍيٍ كُي نُن سٌي قَرِ.</para>
  <para style="q" vid="ISA 22:6">كِرِكَيٍ عٍ شَ وُرٍ لٍقَيٍ مَبَمَ.<verse eid="ISA 22:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 22:7"/>سْورِ نُ بَرَ وُيَ وٌ شَ فُلُنبَ قَنيِيٍ كُي،</para>
  <para style="q" vid="ISA 22:7">عٍ نُ وُيَ وٌ شَ تَا نَادّ رَ.<verse eid="ISA 22:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 22:8"/>سٍسٍ مُ لُشِ وٌ نُن وٌ يَشُييٍ تَفِ سْنْن.</para>
  <para style="q" vid="ISA 22:8">نَ لْشْي وٌ نَشَ فٍرٍ سٌسٍيٍ تٌنفٌ نَشَن نُ نُ مَنفّ شَ بَنشِ كُي.<verse eid="ISA 22:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 22:9"/>وٌ نَشَ عَ تٌ يَلٍ فبٍفبٍ نُ بَرَ تِ دَوُدَ شَ تَا تّتّ مَ.</para>
  <para style="q" vid="ISA 22:9">وٌ نَشَ يٍ رَفَتَ يِرٍ ندٍ لَنبَنيِ.<verse eid="ISA 22:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 22:10"/>وٌ نَشَ دَرِ سَلَمُ بَنشِيٍ مَتٌ، وٌ قَ ندٍ رَبِرَ عَلَكٌ وٌ شَ تّتّ سّنبّ سٌ.<verse eid="ISA 22:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 22:11"/>وٌ نَشَ يٍ رَفَتَدٍ يَءِلَن تّتّ قِرِنيِيٍ تَفِ،</para>
  <para style="q" vid="ISA 22:11">يٍ سَمَ نَشَن كُي كٍلِقٍ يٍ رَفَتَدٍ قٌرِ.</para>
  <para style="q" vid="ISA 22:11">كْنْ وٌ مُ وٌ يَ رَقِندِشِ عَلَ مَ نَشَن نُ بَرَ نَ قٌرِ يَءِلَن.</para>
  <para style="q" vid="ISA 22:11">وٌ مُ لَ عَ يَءِلَنمَ رَ نَشَن نُ بَرَ نَتّ تٌنفٌ نَ وَلِ شَ قٍ رَ كَقِ عَ رَكُيَ.<verse eid="ISA 22:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 22:12"/>ﭑ مَرِفِ عَلَتَلَ نُ بَرَ شِلِ تِ نَ لْشْي حَمَ شَ وَ سُننُنيِ كُي،</para>
  <para style="q" vid="ISA 22:12">وٌ شَ وٌ شُنيِيٍ بِ، وٌ شَ سُننُنيِ دُفِ رَفٌرٌ وٌ مَ.<verse eid="ISA 22:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 22:13"/>كْنْ وٌ مُ تِن نَ رَ، وٌ نَشَ شُلُنيِ تِ حّلّشِنيِ كُي،</para>
  <para style="q" vid="ISA 22:13">وٌ نِنفٍ نُن يّشّي قَشَ وٌ نَشٍيٍ دٌنمَ،</para>
  <para style="q" vid="ISA 22:13">وٌ وّنِ مِن عَ قَلَقٍ رَ،</para>
  <para style="q" vid="ISA 22:13">«وٌن شَ وٌن دّفٍ، وٌن شَ وٌ مِن، بَرِ مَ تِنَ وٌن قَشَمَ نّ.»<verse eid="ISA 22:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 22:14"/>عَلَتَلَ سّنبّمَ بَرَ عَ مَسٍن ﭑ بّ، عَ نَشّ،</para>
  <para style="q" vid="ISA 22:14">«وٌ شَ يِ يُنُبِ تَن مُ شَقَرِ مَ هَن وٌ قَشَ لْشْي.»</para>
  <para style="q" vid="ISA 22:14">مَنفّ عَلَتَلَ شُي نَن يِ كِ.<verse eid="ISA 22:14"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="15" style="v" sid="ISA 22:15"/>ﭑ مَنفّ عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، عَ نَشّ،</para>
  <para style="q" vid="ISA 22:15">«سِفَ مَنفّ بَنشِ شُنيِ سٍبِنَ يِرٍ، عَ قَلَ عَ بّ،<verse eid="ISA 22:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 22:16"/>‹عِ فبٍ نَ مُنسٍ رَ بٍ؟</para>
  <para style="q" vid="ISA 22:16">ندٍ نَ عِ بّ بٍ نَشَن عَ نِيَمَ عِ شَ فَبُرِ تٌقَنيِ فٍ يِ فٍيَ قَرِ؟<verse eid="ISA 22:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 22:17"/>عَ فبٍ مُ لُشِ، عَلَتَلَ شَ عِ سُشُ، عَ شَ عِ وٌلِ يِرٍ مَكُيٍ.</para>
  <para style="q" vid="ISA 22:17">عَ عِ مَشِرِ مَ نّ عَلْ كٌتٍ،<verse eid="ISA 22:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 22:18"/>عَ عِ وٌلِ بْشِ بٍلٍبٍلٍ ندٍ مَ.</para>
  <para style="q" vid="ISA 22:18">عِ تَن نُن عِ شَ سْورِ رَفِسٍ قَنيِيٍ شَ قٍ حْنمَ مّننِ نّ،</para>
  <para style="q" vid="ISA 22:18">عِ تَن نَشَن عِ شَ مَنفّ بْنسْي رَيَافِ.<verse eid="ISA 22:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 22:19"/>ﭑ عِ كٍرِ مَ نّ عِ شَ وَلِدٍ،</para>
  <para style="q" vid="ISA 22:19">ﭑ عِ تِدٍ بَمَ نّ عِ يِ رَ.›»<verse eid="ISA 22:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ISA 22:20"/>«نَ لْشْي ﭑ شِلِكِيَ شَ دِ عٍلِيَكِمِ شِلِمَ نّ، عَ شَ ﭑ مَ وَلِ رَبَ. <verse eid="ISA 22:20"/><verse number="21" style="v" sid="ISA 22:21"/>ﭑ عِ شَ مَنفّ فُبَ رَفٌرٌ مَ نّ عَ مَ، ﭑ عِ شَ بّلّتِ شِرِ عَ تَفِ، ﭑ قَ عِ شَ مَنفّيَ قِ عَ مَ. عَ قِندِ مَ دَرِ سَلَمُكَيٍ نُن يُدَيَكَيٍ بَبَ نَن نَ. <verse eid="ISA 22:21"/><verse number="22" style="v" sid="ISA 22:22"/>ﭑ دَوُدَ شَ مَنفّيَ سَابِ سٌمَ نّ عَ يِ رَ. عَ نَ نَادّ ندٍ رَبِ، مِشِ يٌ مُ عَ بَلَنمَ. عَ نَ نَادّ ندٍ بَلَن، مِشِ يٌ مُ عَ رَبِمَ. <verse eid="ISA 22:22"/><verse number="23" style="v" sid="ISA 22:23"/>عَ قَمَ نّ بِنيّ رَ عَ بَبَ بْنسْي بّ. ﭑ عَ تِمَ نّ عَلْ وُرِ دِ نَشَن بَنبَنشِ عَ قَنيِ رَ بَنشِ بِلِ مَ، <verse eid="ISA 22:23"/><verse number="24" style="v" sid="ISA 22:24"/>عَ بَبَ بْنسْي شَ قٍ بِرِن فبَكُمَ نَشَن نَ، قٍ شُنشُرِيٍ نُن قٍ شُنفبٍيٍ.»<verse eid="ISA 22:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ISA 22:25"/>مَنفّ عَلَتَلَ مَن نَشَ عَ مَسٍن، «كْنْ لْشْي ندٍ نَ وُرِ دِ نَشَن نُ بَنبَنشِ عَ قَنيِ رَ بَنشِ بِلِ مَ، عَ قَمَ نّ بٌلٌندٍ، عَ بِرَ عَ نُن قٍ نَشَن بِرِن نُ فبَكُشِ عَ رَ.» عَلَتَلَ شُي نَن نَ كِ.<verse eid="ISA 22:25"/></para>
  <chapter eid="ISA 22"/>
  <chapter number="23" style="c" sid="ISA 23"/>
  <para style="s">تِرٍ شَ حَشَنكَتّ</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 23:1"/>حَشَنكَتّ نَ تِرٍكَيٍ بّ.</para>
  <para style="q" vid="ISA 23:1">«تَرَ سِسِ كُنكُي كَنيِيٍ، وٌ شَ وٌ وَ شُي عِتٍ،</para>
  <para style="q" vid="ISA 23:1">بَرِ مَ تِرٍ بْشِ شُن بَرَ رَكَنَ.</para>
  <para style="q" vid="ISA 23:1">بَنشِ مُ لُمَ نَا سْنْن،</para>
  <para style="q" vid="ISA 23:1">وَقُ بِرِن بَرَ كَنَ.»</para>
  <para style="q" vid="ISA 23:1">سِثِرِكَ ندٍيٍ شَ مَسٍنيِ نَن نَ كِ.<verse eid="ISA 23:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="ISA 23:2"/>وٌ وٌ سَبَرِ، وٌ تَن نَشٍيٍ سَبَتِشِ بَا دّ رَ،</para>
  <para style="q" vid="ISA 23:2">وٌ تَن نَشٍيٍ قِندِشِ يُلّيٍ رَ سِدْن تَا كُي،</para>
  <para style="q" vid="ISA 23:2">وٌ تَن نَشٍيٍ بَرَ نَاقُلِ سْتْ يُلّيَ رَ وَقُ دّ سَابُي رَ.<verse eid="ISA 23:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 23:3"/>بَا بَرَ عَ نِيَ وٌ شَ سَنسِ شْرِ سْتْ كٍلِقٍ سِشٌرِ.</para>
  <para style="q" vid="ISA 23:3">دَشَمُي نَشَن مِنِ نِلِ شُرٍ دّ رَ، نَ نَن قِندِشِ بَننَيَ رَ وٌ بّ.</para>
  <para style="q" vid="ISA 23:3">حَمَنّيٍ شَ مَكِتِ شُنفبٍ رَبَ نّ وٌ شْنيِ.<verse eid="ISA 23:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="ISA 23:4"/>سِدْنكَيٍ، وٌ يَافِ، وٌ تَن نَشٍيٍ شَ نْي نُ نَ بَا شُن مَ.</para>
  <para style="q" vid="ISA 23:4">شُي ندٍ مِنِمَ كٍلِقٍ بَا مَ، عَ نَشّ،</para>
  <para style="q" vid="ISA 23:4">«ﭑ لُشِ نّ عَلْ دِ بَرِتَرٍ،</para>
  <para style="q" vid="ISA 23:4">نَشَن مُ دِ بَرِ شْنّ كٌلٌن،</para>
  <para style="q" vid="ISA 23:4">نَشَن مُ دِ يٌ بَرِ مَ،</para>
  <para style="q" vid="ISA 23:4">نَشَن مُ دِ يٌ رَ مْمَ، شّمّ شَ نَ مُ عَ رَ فِنّ.»<verse eid="ISA 23:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 23:5"/>مِسِرَكَيٍ نَ نَ شِبَارُ مّ تِرٍ شَ قٍ رَ،</para>
  <para style="q" vid="ISA 23:5">عٍ قَمَ نّ فَاشُدٍ.<verse eid="ISA 23:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="ISA 23:6"/>وٌ شَ سِفَ تَرَ سِسِ.</para>
  <para style="q" vid="ISA 23:6">وٌ تَن نَشٍيٍ نَ بَا دّ رَ، وٌ شَ وٌ وَ شُي عِتٍ.<verse eid="ISA 23:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 23:7"/>سِنفٍ وٌ شَ تَا نُ نَ حّلّشِنيِ نَن كُي،</para>
  <para style="q" vid="ISA 23:7">كْنْ يَكْسِ ندٍ وٌ شَ مِشِيٍ شَنِنشِ يِرٍ مَكُيٍ؟<verse eid="ISA 23:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 23:8"/>ندٍ يِ نَتّ تٌنفٌشِ تِرٍ شِلِ مَ،</para>
  <para style="q" vid="ISA 23:8">عَ تَن نَشَن نُ مَنفّ تِمَ،</para>
  <para style="q" vid="ISA 23:8">عَ تَن نَشَن شَ يُلّيٍ نُ قِندِشِ كُنتِفِيٍ رَ،</para>
  <para style="q" vid="ISA 23:8">عَ تَن نَشَن شَ يُلّيٍ نُ بِنيَشِ دُنِحَ بِرِن مَ؟<verse eid="ISA 23:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 23:9"/>عَلَتَلَ سّنبّمَ نَن يِ نَتّ تٌنفٌشِ،</para>
  <para style="q" vid="ISA 23:9">عَلَكٌ يّتّ عِفبٌيَ شَ كَنَ،</para>
  <para style="q" vid="ISA 23:9">شِلِ شُنفبٍ كَنيِيٍ شَ مَفٌرٌ.<verse eid="ISA 23:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="ISA 23:10"/>تَرَ سِسِكَيٍ، وٌ شَ بْشِ رَوَلِ عَلْ عَ رَبَمَ نِلِ شُرٍ دّ رَ كِ نَشّ،</para>
  <para style="q" vid="ISA 23:10">بَرِ مَ سِدْن نُن تِرٍ شَ وَقُيٍ مُ نَ سْنْن.<verse eid="ISA 23:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 23:11"/>عَلَتَلَ بَرَ عَ بّلّشّ عِتَلَ بَا شُن مَ،</para>
  <para style="q" vid="ISA 23:11">عَ بَرَ مَنفّيَيٍ رَ سّرّن.</para>
  <para style="q" vid="ISA 23:11">عَ بَرَ يَامَرِ قِ قٍنِسِيَ شَ يِرٍ مَكَنتَشِيٍ شَ كَنَ.<verse eid="ISA 23:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 23:12"/>عَ نَشّ، «عِ تَن سِدْن تَا تٌقَنيِ،</para>
  <para style="q" vid="ISA 23:12">عِ مُ لُمَ بٍرٍ رَ سْنْن،</para>
  <para style="q" vid="ISA 23:12">عٍ قَمَ نّ عِ شُن نَكَنَدٍ قٍوٌ.</para>
  <para style="q" vid="ISA 23:12">هَلِ وٌ وٌ فِ سِثِرِ سُرِ مَ،</para>
  <para style="q" vid="ISA 23:12">وٌ مُ بْحّسَ سْتْمَ.<verse eid="ISA 23:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 23:13"/>كَلِدٍ بْشِ مَتٌ بَ. عٍ شُن بَرَ رَكَنَ.</para>
  <para style="q" vid="ISA 23:13">عَسِرِيَكَيٍ بَرَ سَ وُلَءِ سُبٍيٍ سَفٌي.</para>
  <para style="q" vid="ISA 23:13">عٍ بَرَ عٍ شَ يِرٍ مَكَنتَشِيٍ رَبِلِن،</para>
  <para style="q" vid="ISA 23:13">عٍ قَ عٍ فٍرٍ هَن سٍسٍ مُ لُشِ سْنْن.»<verse eid="ISA 23:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="ISA 23:14"/>«تَرَ سِسِ كُنكُي كَنيِيٍ، وٌ شَ وٌ وَ شُي عِتٍ،</para>
  <para style="q" vid="ISA 23:14">بَرِ مَ وٌ شَ وَقُ مَكَنتَشِ شُن بَرَ رَكَنَ.»<verse eid="ISA 23:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 23:15"/>تِرٍ لُمَ نّيمُي نَن كُي هَن حّ تٌنفٌ سٌلٌقٍرٍ، مَنفّ كٍرٍن شَ بُي شَسَبِ. حّ تٌنفٌ سٌلٌقٍرٍ رَحْنيِ، قٍ قَمَ رَبَدٍ تِرٍ بّ عَلْ عَ قَلَشِ سِفِ كُي لَنفٌي فِنّ شَ قٍ رَ كِ نَشّ،<verse eid="ISA 23:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 23:16"/>«عِ تَن لَنفٌي فِنّ، بِرِن نّيمُشِ نَشَن مَ،</para>
  <para style="q" vid="ISA 23:16">عِ شَ كْرَ بْنبْ عَ قَنيِ رَ تَا كُي،</para>
  <para style="q" vid="ISA 23:16">عِ شَ سِفِ سَ عَلَكٌ مِشِيٍ شَ رَتُ عِ شَ قٍ مَ.»<verse eid="ISA 23:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ISA 23:17"/>حّ تٌنفٌ سٌلٌقٍرٍ رَحْنيِ، مَرِفِ عَ يَ رَقِندِ مَ نّ تِرٍ مَ. عَ فبِلٍنمَ نّ عَ شَ لَنفٌيحَ قٌرِ مَ، عَ عَ يّتّ سَ دُنِحَ مَنفّيَيٍ بِرِن سَفٌي كْبِرِ شَ قٍ رَ. <verse eid="ISA 23:17"/><verse number="18" style="v" sid="ISA 23:18"/>كْنْ عَ شَ فٍينِ قَمَ رَوَلِدٍ عَلَتَلَ شَ قٍ نَن كُي. عَ مُ نْمَ نَ رَفَتَدٍ عَ يّتّ بّ، عَ لُمَ مِشِيٍ نَن بّ نَشٍيٍ بِرَ مَ عَلَتَلَ قْشْ رَ، عَلَكٌ عٍ شَ دٌنمَ قَنيِيٍ نُن بَلٌي فبٍفبٍ سْتْ.<verse eid="ISA 23:18"/></para>
  <chapter eid="ISA 23"/>
  <chapter number="24" style="c" sid="ISA 24"/>
  <para style="s">دُنِحَ شَ حَشَنكَتّ</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 24:1"/>عَلَتَلَ قَمَ نّ دُنِحَ كَنَدٍ،</para>
  <para style="q" vid="ISA 24:1">سٍسٍ مُ لُ بْشِ مَ سْنْن،</para>
  <para style="q" vid="ISA 24:1">عَدَ مَدِيٍ يٍنسٍنمَ نّ.<verse eid="ISA 24:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 24:2"/>مِشِ بِرِن لُمَ تْورّ نَن كُي؛</para>
  <para style="q" vid="ISA 24:2">سّرّشّدُبّ نُن حَمَ، كُنتِفِ نُن كٌنيِ،</para>
  <para style="q" vid="ISA 24:2">فِنّ بَنشِ كَنيِ نُن كٌنيِ فِنّ، يُلّ نُن سَرٍ سٌي،</para>
  <para style="q" vid="ISA 24:2">يٍقُ تِ نُن سٍتَرٍ، دٌنِ تٌنفٌي نُن دٌنِ كَنيِ.<verse eid="ISA 24:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 24:3"/>دُنِحَ قَمَ نّ كَنَدٍ،</para>
  <para style="q" vid="ISA 24:3">عَ عِسٍيٍ بِرِن حْنمَ نّ عَ مَ.</para>
  <para style="q" vid="ISA 24:3">عَلَتَلَ شُي نَن نَ كِ.<verse eid="ISA 24:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="ISA 24:4"/>دُنِحَ تُشُنسَنمَ نّ، عَ عِشَرَ مَ نّ،</para>
  <para style="q" vid="ISA 24:4">كُنتِفِيٍ يَتِ هَلَكِمَ نّ.<verse eid="ISA 24:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 24:5"/>دُنِحَ مِشِيٍ بَرَ دُنِحَ كْسْ،</para>
  <para style="q" vid="ISA 24:5">عٍ بَرَ عٍ كٌبٍ سٌ سّرِيّ رَ،</para>
  <para style="q" vid="ISA 24:5">عٍ عَلَ شَ يَامَرِيٍ مَتَندِ،</para>
  <para style="q" vid="ISA 24:5">عٍ عَ شَ سَاتّ كَنَ.<verse eid="ISA 24:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 24:6"/>نَ نَن عَ رَ عَلَتَلَ دُنِحَ هَلَكِمَ،</para>
  <para style="q" vid="ISA 24:6">نَ كٌتٍ دُ سُ عَدَ مَدِيٍ شُن نَ،</para>
  <para style="q" vid="ISA 24:6">دُنِحَ مِشِيٍ مُ فبٌ سْنْن.<verse eid="ISA 24:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 24:7"/>شّ شَبَ تّمُي سَنسِيٍ شُرُنمَ نّ،</para>
  <para style="q" vid="ISA 24:7">شّ شَبَيٍ نِمِسَ.<verse eid="ISA 24:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 24:8"/>سَنبَنيِ نُن كْرَ شُي دَنمَ نّ،</para>
  <para style="q" vid="ISA 24:8">شُلُنيِ يٍنسٍن.<verse eid="ISA 24:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 24:9"/>مِشِيٍ مُ عٍ سّيوَ مَ سِفِ شُي رَ،</para>
  <para style="q" vid="ISA 24:9">دٌنسٍ يَتِ مُ رَقَنمَ عٍ مَ.<verse eid="ISA 24:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 24:10"/>تَا كَنَشِ لُمَ نَ كِ نّ تُن،</para>
  <para style="q" vid="ISA 24:10">عَ بَنشِيٍ بِرِن بَلَن.<verse eid="ISA 24:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 24:11"/>سْنشْي تٍمَ نّ تَا كُي مِنسٍ نُن دٌنسٍ شَ قٍ رَ.</para>
  <para style="q" vid="ISA 24:11">سّيوّ بَرَ حْن، حّلّشِنيِ بَرَ سِفَ.<verse eid="ISA 24:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 24:12"/>سْنتْي نَن تُن لُمَ تَا كُي قَ،</para>
  <para style="q" vid="ISA 24:12">تَا نَادّ كَنَ قٍوٌ.<verse eid="ISA 24:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="ISA 24:13"/>نَ حَشَنكَتّ نَ حْن دُنِحَ بّندّ قُحِ قَرِ حَمَنّيٍ تَفِ،</para>
  <para style="q" vid="ISA 24:13">نَ لُمَ نّ عَلْ عٌلِوِ بِلِ نَشَن عِمَشَمَ عَلَكٌ عَ بٌفِيٍ شَ بَ،</para>
  <para style="q" vid="ISA 24:13">نَ لُمَ نّ عَلْ سَنسِ تْنسْي كٍرٍن كٍرٍن نَشٍيٍ لُمَ شّ مَ شّ شَبَيٍ دَنفِ شَنبِ.<verse eid="ISA 24:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="ISA 24:14"/>كْنْ نَشٍيٍ نَ سٌفٍفٌرٌدٍ بِرِ،</para>
  <para style="q" vid="ISA 24:14">نٍيٍ عٍ شُي عِتٍمَ نّ سّيوّ رَ،</para>
  <para style="q" vid="ISA 24:14">عٍ بّيتِ بَ عَلَتَلَ مَتْشْقٍ رَ.<verse eid="ISA 24:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 24:15"/>نَشٍيٍ نَ سٌفٍتٍدٍ بِرِ،</para>
  <para style="q" vid="ISA 24:15">نٍيٍ عَلَتَلَ مَتْشْمَ نّ،</para>
  <para style="q" vid="ISA 24:15">عٍ عِسِرَيِلَ مَرِفِ عَلَتَلَ شِلِ مَتْشْ بَا سُرِيٍ مَ.<verse eid="ISA 24:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 24:16"/>كٍلِقٍ دُنِحَ تُنشُن نَانِيٍ رَ،</para>
  <para style="q" vid="ISA 24:16">وٌن بّيتِ مّمَ نّ نَشَن عَ قَلَمَ،</para>
  <para style="q" vid="ISA 24:16">«نْرّ كَنيِ نَن تِنشِنتْي رَ.»</para>
  <para style="b" vid="ISA 24:16"/>
  <para style="q" vid="ISA 24:16">كْنْ ﭑ تَن نَشَ عٍ يَابِ،</para>
  <para style="q" vid="ISA 24:16">«ﭑ شُن نَكَنَقٍ، ﭑ قَتٍ نَ بَقٍ ﭑ مَ.</para>
  <para style="q" vid="ISA 24:16">حَشَنكَتّ نَ ﭑ بّ.</para>
  <para style="q" vid="ISA 24:16">تِنشِنتَرٍيٍ بَرَ ﭑ يَنقَ عَ حَاشِ رَ.»<verse eid="ISA 24:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 24:17"/>فبَلٌي نَن وٌ لِمَ، وٌ تَن دُنِحَ مِشِيٍ.<verse eid="ISA 24:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 24:18"/>نَشَن نَ عَ فِ نَ فبَلٌي يَ رَ، عَ بِرَ مَ يِلِ نَن كُي.</para>
  <para style="q" vid="ISA 24:18">نَشَن نَ تٍ نَ يِلِ كُي، يّلّ نَن دُ سُمَ عَ شُن نَ.</para>
  <para style="q" vid="ISA 24:18">كٌورٍ وَلَشّ بِرَ مَ نّ،</para>
  <para style="q" vid="ISA 24:18">بْشِ قَن سّرّن.<verse eid="ISA 24:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 24:19"/>دُنِحَ كَنَمَ نّ، عَ عِبْو، عَ سّرّن.<verse eid="ISA 24:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 24:20"/>عَ دَفَلَنمَ نّ عَلْ سِيسِلَ،</para>
  <para style="q" vid="ISA 24:20">عَ عِمَشَ عَلْ بَفٍ تُرُننَادّ مِنِ تّمُي،</para>
  <para style="q" vid="ISA 24:20">بَرِ مَ عَ شَ يُنُبِيٍ بَرَ فبٌ.</para>
  <para style="q" vid="ISA 24:20">عَ بِرَ مَ نّ، عَ مُ كٍلِمَ سْنْن.<verse eid="ISA 24:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="ISA 24:21"/>نَ لْشْي عَلَتَلَ كٌورٍ دَالِيٍ نُن دُنِحَ مَنفّيٍ حَشَنكَتَمَ نّ عٍ شَ وَلِيٍ مَ.<verse eid="ISA 24:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 24:22"/>عٍ قَمَ نّ مَلَندٍ يِرٍ كٍرٍن عَلْ فٍيلِمَنِيٍ نَشٍيٍ نَ فٍيلِ كُي.</para>
  <para style="q" vid="ISA 24:22">عٍ بُمَ نّ نَا هَن عٍ قَ كِيتِ.<verse eid="ISA 24:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 24:23"/>كِكٍ نُن سٌفٍ لْيمَ نّ،</para>
  <para style="q" vid="ISA 24:23">مَنفّ عَلَتَلَ يَامَرِ تِمَ نّ سِيٌنِ فٍيَ قَرِ دَرِ سَلَمُ</para>
  <para style="q" vid="ISA 24:23">قٌرِيٍ يَ عِ عَ نْرّ قَنيِ بُن مَ.<verse eid="ISA 24:23"/></para>
  <chapter eid="ISA 24"/>
  <chapter number="25" style="c" sid="ISA 25"/>
  <para style="s">تْورْ مِشِ شَ كَنتَرِ نَ عَلَ نَن نَ</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 25:1"/>عَلَتَلَ، ﭑ مَرِفِ نَ عِ تَن نَن نَ.</para>
  <para style="q" vid="ISA 25:1">ﭑ عِ شِلِ مَتْشْمَ نّ عِ شَ قٍ مَكَابَشِيٍ شَ قٍ رَ،</para>
  <para style="q" vid="ISA 25:1">عِ نَشٍيٍ نَتّشِ كَبِ تّمُي شْنكُيٍ دُفُتّفّحَ كُي.<verse eid="ISA 25:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 25:2"/>عِ بَرَ مُشُ يَشُييٍ شَ تَا مَكَنتَشِ رَبِرَ،</para>
  <para style="q" vid="ISA 25:2">عَ قِندِ فّمّ يٍنسٍنشِيٍ رَ نَشَن مُ تِمَ سْنْن.<verse eid="ISA 25:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 25:3"/>نَ نَن عَ رَ حَمَ سّنبّمَيٍ عِ مَتْشْمَ نّ،</para>
  <para style="q" vid="ISA 25:3">سِ حَاشِيٍ قَ عِ بِنيَدٍ.<verse eid="ISA 25:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 25:4"/>عِ قِندِشِ مِسِكِينّ شَ كَنتَرِ نَن نَ،</para>
  <para style="q" vid="ISA 25:4">يِرٍ مَكَنتَشِ تْورْ مِشِ لُمَ دّننَشّ.</para>
  <para style="q" vid="ISA 25:4">عِ لُشِ عَلْ بَنشِ قَنيِ تُرُننَادّ كُي،</para>
  <para style="q" vid="ISA 25:4">عَلْ بَفٍ نَشَن تِشِ سٌفٍ يَ مَ.</para>
  <para style="q" vid="ISA 25:4">سِ حَاشِ مَنِيَشِ تُرُننَادّ نَن نَ نَشَن بْنبْمَ بَنشِ رَ،<verse eid="ISA 25:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 25:5"/>عَ لُ عَلْ وُيٍنيِ نَشَن نَ فبٍنفبٍرٍنيِ مَ.</para>
  <para style="q" vid="ISA 25:5">عِ حَمَنّ شَ سْنشْي رَشِنبٍلِمَ نّ،</para>
  <para style="q" vid="ISA 25:5">عَلْ نُشُي نِينِ ندٍ بَمَ سٌفٍ شَ وُيٍنيِ رَ كِ نَشّ.</para>
  <para style="q" vid="ISA 25:5">نَ حَمَ حَاشِ شَ سِفِ سَ دَنمَ نَ كِ نّ.<verse eid="ISA 25:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="ISA 25:6"/>يِ فٍيَ قَرِ، عَلَتَلَ سّنبّمَ قَمَ نّ شُلُنيِ بٍلٍبٍلٍ تِدٍ،</para>
  <para style="q" vid="ISA 25:6">حَمَ بِرِن شَ مِنسٍ نُن دٌنسٍ حْشُنمّيٍ لِ نَا.<verse eid="ISA 25:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 25:7"/>يِ فٍيَ قَرِ، عَلَتَلَ قَمَ نّ مَقٍلٍنيِ بَدٍ بْنسْي بِرِن مَ،<verse eid="ISA 25:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 25:8"/>عَ سَيَ شَ قٍ كَنَمَ نّ عَبَدَن.</para>
  <para style="q" vid="ISA 25:8">وٌن مَرِفِ عَلَتَلَ يَيٍ مَقُرُكُمَ نّ يَتَفِ بِرِن مَ،</para>
  <para style="q" vid="ISA 25:8">عَ عَ شَ حَمَ شَ يَافِ بِرِن بَ دُنِحَ يَ شْرِ.</para>
  <para style="q" vid="ISA 25:8">عَلَتَلَ شُي نَن نَ كِ.<verse eid="ISA 25:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 25:9"/>نَ لْشْي عٍ عَ قَلَمَ نّ،</para>
  <para style="q" vid="ISA 25:9">«وٌن مَرِفِ عَلَ نَن يِ كِ وٌن وٌن شَشِلِ تِشِ نَشَن نَ.</para>
  <para style="q" vid="ISA 25:9">عَ بَرَ وٌن نَكِسِ.</para>
  <para style="q" vid="ISA 25:9">عَلَتَلَ نَن يِ كِ وٌن وٌن شَشِلِ تِشِ نَشَن نَ.</para>
  <para style="q" vid="ISA 25:9">وٌن شَ سّيوَ عَ شَ كِسِ رَ.»<verse eid="ISA 25:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="ISA 25:10"/>عَلَتَلَ شْنيّ لُمَ نّ يِ فٍيَ قَرِ،</para>
  <para style="q" vid="ISA 25:10">كْنْ مٌوَبَكَيٍ مَبٌرٌنمَ نّ عَلْ سّشّ.<verse eid="ISA 25:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 25:11"/>عٍ كَتَمَ نّ عٍ شَ عٍ بَ عَ يِ رَ،</para>
  <para style="q" vid="ISA 25:11">كْنْ عَلَتَلَ عٍ شَ يّتّ عِفبٌيَ رَفٌرٌ مَ نّ،</para>
  <para style="q" vid="ISA 25:11">عَ عٍ سّنبّ بِرِن حْن.<verse eid="ISA 25:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 25:12"/>عَ عٍ شَ يِرٍ مَكَنتَشِيٍ رَبِرَ مَ نّ،</para>
  <para style="q" vid="ISA 25:12">عَ نَ بِرِن بُتُشُن هَن عَ قِندِ شُبٍ رَ.</para>
  <para style="q" vid="ISA 25:12">عَ عٍ شَ يّتّ عِفبٌيَ رَفٌرٌ مَ نّ قٍوٌ.<verse eid="ISA 25:12"/></para>
  <chapter eid="ISA 25"/>
  <chapter number="26" style="c" sid="ISA 26"/>
  <para style="s">تَا سّنبّمَ شَ بّيتِ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 26:1"/>نَ لْشْي عٍ يِ بّيتِ نَن بَمَ يُدَيَ بْشِ مَ؛</para>
  <para style="q" vid="ISA 26:1">عَلَ بَرَ تَا سّنبّمَ قِ وٌن مَ،</para>
  <para style="q" vid="ISA 26:1">نَشَن شَ تّتّ قِندِ مَ كِسِ رَ وٌن بّ.<verse eid="ISA 26:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 26:2"/>نَادّ شَ رَبِ، حَمَ تِنشِنشِ شَ سٌ،</para>
  <para style="q" vid="ISA 26:2">حَمَ نَشَن مُ لَنلَنتٍيَ كَنَ.<verse eid="ISA 26:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 26:3"/>مِشِ نَشَن حَنِفٍ قَن،</para>
  <para style="q" vid="ISA 26:3">عَ قِندِ مَ بْحّسَ كَنيِ نَن نَ،</para>
  <para style="q" vid="ISA 26:3">بَرِ مَ عَ لَشِ عِ رَ.<verse eid="ISA 26:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="ISA 26:4"/>وٌ وٌ يّتّ تَشُ عَلَتَلَ رَ تّمُي بِرِن،</para>
  <para style="q" vid="ISA 26:4">بَرِ مَ عَلَتَلَ نَن نَ عَلَ رَ نَشَن نَ عَبَدَن،</para>
  <para style="q" vid="ISA 26:4">نَشَن سّنبّ فبٌ عَلْ قَنيٍ.<verse eid="ISA 26:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 26:5"/>عَ بَرَ يّتّ عِفبٌي رَفٌرٌ،</para>
  <para style="q" vid="ISA 26:5">عَ عٍ شَ تَا عِتٍشِ عِفٌرٌ، عَ قِندِ شُبٍ رَ،<verse eid="ISA 26:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 26:6"/>مِسِكِينّيٍ نُن سٍتَرٍيٍ نَشَن عِبٌرٌنمَ.<verse eid="ISA 26:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="ISA 26:7"/>عِ تَن عَلَتَلَ تِنشِنشِ، عِ تِنشِنتْي شَ قٍ سْونّيَمَ نّ.<verse eid="ISA 26:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 26:8"/>مُشُ حّرّ مَ عِ شَ سّرِيّ نَن مَ، مُشُ شَشِلِ تِشِ عِ رَ.</para>
  <para style="q" vid="ISA 26:8">مُشُ عِ شِلِ مَتْشْمَ مُشُ بْحّ بِرِن نَ.<verse eid="ISA 26:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 26:9"/>مُشُ نِي يَتِ هَيِ نَ عِ مَ كْي رَ، عَ عِ قٍنمَ فّيسّفّ.</para>
  <para style="q" vid="ISA 26:9">عِ نَ عِ شَ كِيتِ سَ دُنِحَ مَ،</para>
  <para style="q" vid="ISA 26:9">نَ نَن دُنِحَ مِشِيٍ مَتِنكَنمَ تِنشِنيِ رَ.<verse eid="ISA 26:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 26:10"/>كْنْ مِشِ حَاشِيٍ تَن، هَلِ عٍ كِنِكِنِ عٍ مَ،</para>
  <para style="q" vid="ISA 26:10">عٍ مُ بِرَ مَ تِنشِنيِ قْشْ رَ.</para>
  <para style="q" vid="ISA 26:10">هَلِ حَمَ بِرِن بِرَ مَ تِنشِنيِ قْشْ رَ،</para>
  <para style="q" vid="ISA 26:10">عٍ تَن تٌندِ مَ نّ فبِلٍندٍ قٍ حَاشِ قْشْ رَ،</para>
  <para style="q" vid="ISA 26:10">عٍ مُ فَاشُمَ عَلَتَلَ شَ مَنفّيَ يَ رَ.<verse eid="ISA 26:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 26:11"/>عَلَتَلَ، عِ سّنبّ فبٌ، كْنْ عٍ مُ نَ تٌمَ.</para>
  <para style="q" vid="ISA 26:11">عِ شَنُنتٍيَ نَشَن سَشِ عِ شَ حَمَ مَ، عَ نِيَ عٍ شَ نَ تٌ،</para>
  <para style="q" vid="ISA 26:11">نَ شَ قِندِ عٍ بّ يَافِ رَ، عِ شَ تّ قَ عٍ فَن.<verse eid="ISA 26:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="ISA 26:12"/>عَلَتَلَ، عِ بَرَ بْحّسَ قِ مُشُ مَ،</para>
  <para style="q" vid="ISA 26:12">بَرِ مَ عِ تَن نَن مُشُ شَ وَلِ بِرِن نَكَمَلِمَ مُشُ بّ.<verse eid="ISA 26:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 26:13"/>مُشُ مَرِفِ عَلَتَلَ، مَرِفِ فبّتّيٍ بَرَ نْي دْشْ مُشُ مَ بَقٍ رَ عِ تَن نَ،</para>
  <para style="q" vid="ISA 26:13">كْنْ مُشُ عِ تَن نَن كٍرٍن بَتُمَ.<verse eid="ISA 26:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 26:14"/>نَ مَرِفِيٍ بَرَ قَشَ، عٍ مُ بَلٌمَ سْنْن،</para>
  <para style="q" vid="ISA 26:14">عٍ نِي مُ كٍلِمَ عَبَدَن.</para>
  <para style="q" vid="ISA 26:14">عِ بَرَ كٍلِ عٍ شِلِ مَ، عِ عٍ سْنتْ.</para>
  <para style="q" vid="ISA 26:14">عِ بَرَ عٍ شَ قٍ بِرِن نَلْي.<verse eid="ISA 26:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 26:15"/>عَلَتَلَ، عِ بَرَ عِ شَ حَمَنّ رَفبٌ يّ،</para>
  <para style="q" vid="ISA 26:15">عِ بَرَ عٍ شَ بْشِ نَانِنيِيٍ مَسَرَ، بْشِ شَ فبٌ.</para>
  <para style="q" vid="ISA 26:15">عِ بَرَ مَتْشْي سْتْ نَ قٍ كُي.<verse eid="ISA 26:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="ISA 26:16"/>عَلَتَلَ، عٍ نُ نَ عِ قٍنقٍ عِ شَ حَشَنكَتّ كُي،</para>
  <para style="q" vid="ISA 26:16">عٍ قَ عِ مَشَندِ.<verse eid="ISA 26:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 26:17"/>عٍ نُ عٍ شُي عِتٍمَ عِ مَ عَلْ فِنّ نَشَن نَ دِ بَرِقٍ تْورّ كُي.<verse eid="ISA 26:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 26:18"/>مُشُ بَرَ تْورْ نَ دِ بَرِقٍ كُي،</para>
  <para style="q" vid="ISA 26:18">كْنْ نَ قٍ قِندِشِ قُقَقُ نَن نَ.</para>
  <para style="q" vid="ISA 26:18">مُشُ مُ وَلِ يٌ رَبَشِ نَشَن قِندِشِ كِسِ رَ دُنِحَ بّ،</para>
  <para style="q" vid="ISA 26:18">عٍ مُ كِسِ سْتْ مُشُ سَابُي رَ.<verse eid="ISA 26:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 26:19"/>كْنْ عِ تَن نَن قَشَ مِشِيٍ رَكٍلِمَ قَشّ مَ.</para>
  <para style="q" vid="ISA 26:19">«وٌ تَن نَشٍيٍ سَشِ بّندّ بُن مَ،</para>
  <para style="q" vid="ISA 26:19">وٌ شَ كٍلِ، وٌ شَ سّيوَ.</para>
  <para style="q" vid="ISA 26:19">وٌ لُشِ نّ عَلْ شِنِ سٌفٍ نَشَن رَلْيمَ.</para>
  <para style="q" vid="ISA 26:19">وٌ قَن نَلْيمَ نَ كِ نّ.»<verse eid="ISA 26:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="ISA 26:20"/>ﭑ مَ حَمَ، وٌ شَ فبِلٍن وٌ شْنيِ،</para>
  <para style="q" vid="ISA 26:20">وٌ شَ نَادّ بَلَن سَابِ رَ.</para>
  <para style="q" vid="ISA 26:20">وٌ شَ وٌ نْشُن دٌندٌرٌنتِ هَن يِ شْنّ شَ دَنفِ سِندٍن.<verse eid="ISA 26:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 26:21"/>عَلَتَلَ قَمَ نّ كٍلِقٍ عَ شْنيِ،</para>
  <para style="q" vid="ISA 26:21">عَ قَ دُنِحَ مِشِيٍ رَتْن عٍ شَ يُنُبِيٍ شَ قٍ رَ.</para>
  <para style="q" vid="ISA 26:21">بْشِ وُلِ دّنتّفّمَ نّ عَ نَشَن مِنشِ،</para>
  <para style="q" vid="ISA 26:21">عَ مُ مِشِ قَشَشِيٍ رَفَتَمَ سْنْن.<verse eid="ISA 26:21"/></para>
  <chapter eid="ISA 26"/>
  <chapter number="27" style="c" sid="ISA 27"/>
  <para style="s">عِسِرَيِلَ شَ كِسِ</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 27:1"/>نَ لْشْي، عَلَتَلَ نِنفِنَنفّ مَفَاشُشِ حَشَنكَتَمَ نّ عَ شَ سَنتِدّفّمَ شُنفبٍ رَ.</para>
  <para style="q" vid="ISA 27:1">نَ شِلِ لٍوِتَن، عَ سَبَتِشِ بَا نَن مَ.</para>
  <para style="q" vid="ISA 27:1">عَ سُشُقٍ شْرْشْ، بَرِ مَ عَ سَلَشُن عَ فبٍ رَ،</para>
  <para style="q" vid="ISA 27:1">كْنْ عَلَتَلَ عَ سْنتْمَ نّ.<verse eid="ISA 27:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="ISA 27:2"/>نَ لْشْي، وٌ شَ بّيتِ بَ ﭑ مَ وّنِ بِلِ قَنيِيٍ شَ قٍ رَ.<verse eid="ISA 27:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 27:3"/>ﭑ تَن عَلَتَلَ نَن نَ عَ كَنتَمَ رَ.</para>
  <para style="q" vid="ISA 27:3">ﭑ يٍ سَمَ نّ عَ مَ تّمُي بِرِن.</para>
  <para style="q" vid="ISA 27:3">ﭑ عَ كَنتَمَ نّ كْي نُن يَنيِ رَ عَلَكٌ مِشِ يٌ نَشَ عَ تْورْ.<verse eid="ISA 27:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 27:4"/>ﭑ شْنْ شْنْ، كْنْ شَ ﭑ سَ تُنبٍيٍ لِ نَا،</para>
  <para style="q" vid="ISA 27:4">ﭑ عٍ فٍرٍ مَ نّ، ﭑ تّ دِن عٍ رَ.<verse eid="ISA 27:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 27:5"/>شَ عَ سَ لِ عٍ نَشَ قَ ﭑ يِرٍ لَنيِ شِرِدٍ،</para>
  <para style="q" vid="ISA 27:5">ﭑ تِنمَ نّ عَ رَ عَ قَنيِ رَ.<verse eid="ISA 27:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="ISA 27:6"/>لْشْي نَ قَقٍ، يَشُبَ بْنسْي عَ سَنكٍ سْرْنمَ نّ،</para>
  <para style="q" vid="ISA 27:6">عِسِرَيِلَ بْنسْي عَ سَلٌنيِيٍ نُن عَ قُفٍيٍ رَ مِنِ،</para>
  <para style="q" vid="ISA 27:6">عَ دُنِحَ رَقٍ عَ بٌفِيٍ رَ.<verse eid="ISA 27:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="ISA 27:7"/>عَلَتَلَ يَشُبَ بْنسْي بْنبْ نّ،</para>
  <para style="q" vid="ISA 27:7">عَلْ عَ عٍ يَشُييٍ بْنبْ كِ نَشّ؟</para>
  <para style="q" vid="ISA 27:7">عَ عٍ قَشَ نّ، عَلْ عَ عٍ قَشَ كِ نَشّ؟<verse eid="ISA 27:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 27:8"/>عَ شَ شْنّ نَشَ دِن عٍ رَ،</para>
  <para style="q" vid="ISA 27:8">عَ عٍ شَنِن عَلْ قٌيٍ شُنفبٍ.<verse eid="ISA 27:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 27:9"/>يَشُبَ بْنسْي شَ يُنُبِيٍ شَقَرِ نَ كِ نّ.</para>
  <para style="q" vid="ISA 27:9">نَ كُي، عٍ نَشَ كُيٍ سّرّشّبَدٍيٍ كَنَ،</para>
  <para style="q" vid="ISA 27:9">عٍ نَشَ عَسٍرَ وُرِ مَسٌلِشِيٍ بَ عٍ شَ بْشِ مَ،</para>
  <para style="q" vid="ISA 27:9">عٍ نَشَ كُيٍ شَ سُرَيِ فَنسٍيٍ كَنَ.<verse eid="ISA 27:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 27:10"/>تَا سّنبّمَيٍ بَرَ كِرٌ،</para>
  <para style="q" vid="ISA 27:10">عٍ قِندِ نّ يِرٍ رَبّحِنشِ رَ عَلْ فبٍنفبٍرٍنيِ.</para>
  <para style="q" vid="ISA 27:10">نِنفٍيٍ نُ لُمَ نَا عٍ دّ مَدٌندٍ،</para>
  <para style="q" vid="ISA 27:10">عٍ عٍ سَ، عٍ مّننِ وُرِ بُرّشّ بِرِن دٌن.<verse eid="ISA 27:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 27:11"/>وُرِ سَلٌنيِيٍ نَ شَرَ، فِنّيٍ نُ عٍ فَن تّ رَ.</para>
  <para style="q" vid="ISA 27:11">حَمَ شَشِلِتَرٍ نَن نُ عَ رَ.</para>
  <para style="q" vid="ISA 27:11">عٍ دَالِ مَنفّ مُ كِنِكِنِشِ عٍ مَ نَ نَن مَ.</para>
  <para style="q" vid="ISA 27:11">نَشَن عٍ دَاشِ، نَ مُ هِننّشِ عٍ رَ.<verse eid="ISA 27:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 27:12"/>نَ لْشْي، عَلَتَلَ وُرِ بِلِيٍ عِمَشَمَ نّ، كٍلِ عٍقِرَتِ شُرٍ دّ رَ هَن مِسِرَ شُرٍ دّ رَ. عَ وٌ تَن عِسِرَيِلَ شَ دِيٍ بِرِن مَتٌنفٌمَ نّ كٍرٍن كٍرٍن.<verse eid="ISA 27:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 27:13"/>نَ لْشْي، قٍرِ شُنفبٍ قٍمَ نّ، عَلَكٌ مِشِ نَشٍيٍ نُ لْيشِ عَسِرِيَ بْشِ مَ، عَ نُن نَشٍيٍ نُ يٍنسٍنشِ مِسِرَ بْشِ مَ، عٍ بِرِن فبِلٍنمَ نّ، عٍ قَ سُيِدِ عَلَتَلَ بّ فٍيَ سّنِيّنشِ قَرِ دَرِ سَلَمُ.<verse eid="ISA 27:13"/></para>
  <chapter eid="ISA 27"/>
  <chapter number="28" style="c" sid="ISA 28"/>
  <para style="s">حَشَنكَتّ نَ سَمَرِ بّ</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 28:1"/>حَشَنكَتّ نَ عٍقِرَ مِ تَا يّتّ عِفبٌي سِيسِلَيٍ بّ،</para>
  <para style="q" vid="ISA 28:1">نَشَن تِشِ فُلُنبَ كٌورٍ رَ،</para>
  <para style="q" vid="ISA 28:1">كْنْ عَ شَ تٌقَنيِ لُشِ نّ عَلْ سَنسِ قُفٍ لِسِشِ.<verse eid="ISA 28:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 28:2"/>سّنبّمَيٍ نَن قَقٍ يِ كِ مَرِفِ شِلِ رَ،</para>
  <para style="q" vid="ISA 28:2">نَشَن لُشِ عَلْ تُرُننَادّ قٌيٍ شُنفبٍ،</para>
  <para style="q" vid="ISA 28:2">عَلْ بَلَبَلَن تُنّ نَشَن سّنبّ سَمَرِ شُن نَفٌرٌ مَ.<verse eid="ISA 28:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 28:3"/>عٍقِرَ مِ تَا يّتّ عِفبٌي سِيسِلَيٍ بِرَ مَ نّ، عٍ مَبٌرٌن.<verse eid="ISA 28:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 28:4"/>نَ سَنسِ قُفٍ لِسِشِ نَشَن تِشِ فُلُنبَ كٌورٍ رَ،</para>
  <para style="q" vid="ISA 28:4">عَ لُشِ نّ عَلْ شْرّ بٌفِ مْشِ نَشَن دٌنمَ كٍرٍنيِ رَ.<verse eid="ISA 28:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="ISA 28:5"/>نَ لْشْي، عَلَتَلَ سّنبّمَ لُمَ نّ عَلْ مَنفّ كَتَنيِ تٌقَنيِ عَ شَ حَمَ دْنشْييٍ بّ.<verse eid="ISA 28:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 28:6"/>عَ شَشِلِ تِنشِنشِ قِمَ نّ كِيتِسَيٍ مَ،</para>
  <para style="q" vid="ISA 28:6">عَ سّنبّ قِ سْورِيٍ مَ نَشٍيٍ نَ فٍرٍ كُي.<verse eid="ISA 28:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="ISA 28:7"/>كْنْ وٌ شَ سّرّشّدُبّيٍ نُن نَمِحْنمّيٍ بَرَ لْي.</para>
  <para style="q" vid="ISA 28:7">بٍيرٍ عٍ دَفَلَنمَ نّ،</para>
  <para style="q" vid="ISA 28:7">عٍ دَشُ لَامَتُنيِ تٌ تّمُي،</para>
  <para style="q" vid="ISA 28:7">عٍ مُ قَتَ قٍ تَفِ رَبَدٍ.<verse eid="ISA 28:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 28:8"/>عٍ تِشِ عٍ يّتّ شَ بْشُنيِ تَفِ،</para>
  <para style="q" vid="ISA 28:8">عٍ بِرِن نْشْشِ عَ حَاشِ رَ.<verse eid="ISA 28:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="ISA 28:9"/>«عَلَ وَ مَ عٍ شَرَنقٍ؟</para>
  <para style="q" vid="ISA 28:9">عَ قَهَامُي قِمَ عٍ مَ؟</para>
  <para style="q" vid="ISA 28:9">عٍ لُشِ عَلْ دِيْرّ نَشٍيٍ دّ بَشِ عٍ نفَ شِحّ رَ.<verse eid="ISA 28:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 28:10"/>قٌ عَ شَ وْيّن عٍ بّ دِيْرّ دَاشِ.»<verse eid="ISA 28:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="ISA 28:11"/>عَلَتَلَ قَمَ عَ مَسٍندٍ يِ حَمَ بّ شْحّ سَابُي رَ،<verse eid="ISA 28:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 28:12"/>«مَلَبُدٍ نَن يِ كِ، وٌ شَ وٌ مَلَبُ.</para>
  <para style="q" vid="ISA 28:12">يِرٍ رَشَرَشِ نَ عَ رَ.»</para>
  <para style="q" vid="ISA 28:12">كْنْ عٍ مُ تِن عٍ تُلِ مَتِدٍ عَ رَ.<verse eid="ISA 28:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 28:13"/>نَ كُي عَلَتَلَ قَمَ نّ مَسٍنيِ تِدٍ عٍ بّ دِيْرّ دَاشِ،</para>
  <para style="q" vid="ISA 28:13">عَلَكٌ عٍ شُن شَ رَكَنَ، يَشُييٍ شَ عٍ سُشُ، عٍ عٍ شَنِن.<verse eid="ISA 28:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="ISA 28:14"/>عَوَ، وٌ تَن مِشِ مَيٍلٍيٍ،</para>
  <para style="q" vid="ISA 28:14">وٌ تَن نَشٍيٍ دَرِ سَلَمُ يَمَرِ مَ،</para>
  <para style="q" vid="ISA 28:14">وٌ وٌ تُلِ مَتِ عَلَتَلَ شَ مَسٍنيِ رَ.<verse eid="ISA 28:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 28:15"/>وٌ نَشّ، «مُشُ نُن سَيَ بَرَ سَاتَ،</para>
  <para style="q" vid="ISA 28:15">مُشُ نُن فَبُرِ بَرَ لَنيِ شِرِ.</para>
  <para style="q" vid="ISA 28:15">فبَلٌي يٌ مُ مُشُ لِمَ وٌن مَ كَنتَرِ كُي.»</para>
  <para style="q" vid="ISA 28:15">كْنْ عٍ نَ عٍ نْشُنقٍ وُلٍ شَنبِ رَ.<verse eid="ISA 28:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 28:16"/>عَلَتَلَ عٍ يَابِمَ نّ،</para>
  <para style="q" vid="ISA 28:16">«ﭑ بَرَ فّمّ هَفِفّ دْشْ سِيٌنِ،</para>
  <para style="q" vid="ISA 28:16">فّمّ قَنيِ نَشَن مُ كَنَمَ.</para>
  <para style="q" vid="ISA 28:16">لِمَنِيَ مُ بَمَ مِشِ يِ رَ نَشَن عَ تَشُمَ نَ فّمّ رَ.<verse eid="ISA 28:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 28:17"/>ﭑ بَرَ تِنشِنيِ تِ سّرِيّ رَ،</para>
  <para style="q" vid="ISA 28:17">ﭑ بَرَ نْندِ سَ كِيتِ كِ رَ.</para>
  <para style="q" vid="ISA 28:17">وٌ شَ وُلٍ نَشٍيٍ قِندِشِ وٌ شَ كَنتَرِ رَ،</para>
  <para style="q" vid="ISA 28:17">بَنبَرَنيِ قَمَ نّ عٍ شَنِندٍ.<verse eid="ISA 28:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 28:18"/>وٌ شَ سَاتّ، وٌ نُن سَيَ رَ، عَ كَنَمَ نّ،</para>
  <para style="q" vid="ISA 28:18">وٌ شَ لَنيِ، وٌ نُن فَبُرِ رَ، عَ قُلُنمَ نّ.</para>
  <para style="q" vid="ISA 28:18">فبَلٌي نْمَ نّ وٌ رَ عَ قَنيِ رَ.<verse eid="ISA 28:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 28:19"/>قٍ شْرْشْي نَ وٌ لِ، عَ وٌ شُن نَكَنَمَ نّ،</para>
  <para style="q" vid="ISA 28:19">فّيسّفّ يٌ فّيسّفّ، قّيحّن يٌ قّيحّن، كْي يٌ كْي.</para>
  <para style="q" vid="ISA 28:19">وٌ نَ سٌ يِ قٍ كُي، وٌ عِقُمَ نّ فَاشُي رَ.»<verse eid="ISA 28:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="ISA 28:20"/>«وٌ شَ سَدٍ شُرُن، وٌ مُ نْمَ وٌ سَدٍ عَ مَ.</para>
  <para style="q" vid="ISA 28:20">وٌ شَ شِنبٍلِ دُفِ شُرُن، عَ مُ وٌ كَنتَمَ شِنبٍلِ رَ.<verse eid="ISA 28:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 28:21"/>عَلَتَلَ كٍلِمَ نّ عَلْ عَ كٍلِ ثٍرَ سِمِ فٍيَ قَرِ كِ نَشّ،</para>
  <para style="q" vid="ISA 28:21">عَ شْنْمَ نّ عَلْ عَ شْنْ فَبَيٌن فُلُنبَ كُي كِ نَشّ،</para>
  <para style="q" vid="ISA 28:21">عَلَكٌ عَ شَ عَ شَ وَلِ مَكَابَشِ رَبَ.<verse eid="ISA 28:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 28:22"/>نَ كُي وٌ بَ مَيٍلٍ تِقٍ،</para>
  <para style="q" vid="ISA 28:22">عَلَكٌ عَ نَشَ قَ فبِلٍن وٌ شِرِ رَ،</para>
  <para style="q" vid="ISA 28:22">بَرِ مَ عَلَ بَرَ عَ شَ نَتّ مَسٍن ﭑ بّ بْشِ كَنَقٍ رَ.»<verse eid="ISA 28:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="ISA 28:23"/>«وٌ وٌ تُلِ مَتِ ﭑ شُي رَ،</para>
  <para style="q" vid="ISA 28:23">وٌ وٌ تُلِ مَتِ ﭑ مَ مَسٍنيِ رَ.<verse eid="ISA 28:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="ISA 28:24"/>شّ سَ شّ بُشَمَ تّمُي بِرِن؟</para>
  <para style="q" vid="ISA 28:24">عَ بّندّ رَ مَشَمَ لْشْي بِرِن؟<verse eid="ISA 28:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="ISA 28:25"/>عَ نَ فّ بْشِ بُشَدٍ، عَ مُ سَنسِ فَرَنسَنمَ؟</para>
  <para style="q" vid="ISA 28:25">عَ مُ سَنسِ شْرِ بِرِن وٌلِمَ عَ كِ مَ؟<verse eid="ISA 28:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="ISA 28:26"/>عَ مَرِفِ عَلَ عَ شَرَن عَ سِ كِ رَ.<verse eid="ISA 28:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="ISA 28:27"/>سَنسِ مْولِ ندٍ مُ بْنبْمَ وُرٍ رَ،</para>
  <para style="q" vid="ISA 28:27">عَ بْنبْمَ وُرِ نَن نَ.<verse eid="ISA 28:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="ISA 28:28"/>سَنسِ مْولِ فبّتّ نْمَ بْنبْدٍ وُرٍ رَ،</para>
  <para style="q" vid="ISA 28:28">كْنْ عَ مُ رَدَنفِمَ عَ عِ.<verse eid="ISA 28:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="ISA 28:29"/>نَ وَلِ كِ بِرِن قَتَنشِ عَلَتَلَ سّنبّمَ نَن مَ.</para>
  <para style="q" vid="ISA 28:29">عَ شَ وَلِيٍ مَكَابَ، عَ شَ قٍ قَنيِيٍ فبٌ.»<verse eid="ISA 28:29"/></para>
  <chapter eid="ISA 28"/>
  <chapter number="29" style="c" sid="ISA 29"/>
  <para style="s">حَشَنكَتّ نَ دَرِ سَلَمُ بّ</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 29:1"/>حَشَنكَتّ نَ عَرِيّلِ تَا بّ،</para>
  <para style="q" vid="ISA 29:1">مَنفّ دَوُدَ نُ سَبَتِشِ دّننَشّ.</para>
  <para style="q" vid="ISA 29:1">وٌ شَ نُ وٌ شَ سَلِيٍ رَبَ رَ حّ يٌ حّ عَلْ وٌ دَرِشِ عَ رَ كِ نَشّ،<verse eid="ISA 29:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 29:2"/>كْنْ ﭑ قَمَ نّ عَرِيّلِ شَ تّتّ رَبِلِندٍ،</para>
  <para style="q" vid="ISA 29:2">عَ قَ تْورْ فٍرٍ كُي، عَ شَ لُ عَلْ سّرّشّبَدٍ نَشَن دّشّشِ.<verse eid="ISA 29:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 29:3"/>ﭑ قَمَ نّ وٌ رَبِلِندٍ ﭑ مَ سْورِيٍ رَ،</para>
  <para style="q" vid="ISA 29:3">مُشُ شَ وَلِ رَبَ وٌ شَ تّتّ كَنَدٍ.<verse eid="ISA 29:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 29:4"/>وٌ شَ قٍ قَمَ نّ مَفٌرٌدٍ هَن عَ لُ عَلْ وٌ شُي نَ مِنِقٍ بْشِ نَن بُن مَ.</para>
  <para style="q" vid="ISA 29:4">وٌ شَ وْيّنيِ مَكْلِكْلِمَ نّ كٍلِقٍ فَبُرِ كُي.<verse eid="ISA 29:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 29:5"/>وٌ يَشُييٍ وُيَمَ نّ عَلْ شُبُتَنيِ،</para>
  <para style="q" vid="ISA 29:5">عٍ شَ سْورِيٍ لُمَ نّ عَلْ مَالٍ لَفِ قٌيٍ مَ.</para>
  <para style="q" vid="ISA 29:5">كْنْ نَ تّمُي يَ مَفِرّ كٍرٍن كُي،<verse eid="ISA 29:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 29:6"/>عَلَتَلَ سّنبّمَ قَمَ نّ سٍسَرِنيِ نُن فَلَنيِ رَ،</para>
  <para style="q" vid="ISA 29:6">بْشِ سّرّنمَ نّ، تُرُننَادّ فٌرٌ مَ نّ، تّ مِنِمَ نّ.<verse eid="ISA 29:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 29:7"/>نَ تّمُي عَرِيّلِ يَشُييٍ لْيمَ نّ كٍرٍن نَ،</para>
  <para style="q" vid="ISA 29:7">عٍ قَ لُ عَلْ شِيٍ حَاشِ مِشِ رَشُنُمَ تّمُي نَشّ.</para>
  <para style="q" vid="ISA 29:7">نَ سْورِيٍ نُن عٍ شَ فٍرٍ سٌ وَلِ بِرِن حْنمَ نّ قٍوٌ.<verse eid="ISA 29:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 29:8"/>عَ لُمَ نّ عَلْ كَامّتْي نَشَن شِيٍ سَ عَ نَ عَ دّفٍقٍ،</para>
  <para style="q" vid="ISA 29:8">كْنْ عَ قَ شُنُ كَامّ رَ عَ مَ.</para>
  <para style="q" vid="ISA 29:8">عَ لُمَ نّ عَلْ مِشِ نَشَن شِيٍ سَ عَ نَ يٍ مِنقٍ،</para>
  <para style="q" vid="ISA 29:8">كْنْ عَ قَ شُنُ يٍ شْلِ رَ عَ مَ.</para>
  <para style="q" vid="ISA 29:8">عَ لُمَ نَ كِ نّ نَ سْورِ فَلِ شَ قٍ رَ نَشَن نَ سِيٌنِ مِشِيٍ فٍرٍقٍ.<verse eid="ISA 29:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="ISA 29:9"/>عَ شَ قِندِ وٌ بّ تّرّننَ رَ، وٌ دّ شَ عِشَرَ.</para>
  <para style="q" vid="ISA 29:9">وٌ وٌ يَيٍ رَشِ، وٌ شَ قِندِ دْنشُييٍ رَ.</para>
  <para style="q" vid="ISA 29:9">وٌ نَ دَفَلَنقٍ سِيسِ دَاشِ، كْنْ بٍيرٍ مُ عَ رَ.<verse eid="ISA 29:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 29:10"/>عَلَتَلَ نَن وٌ رَشِشِ،</para>
  <para style="q" vid="ISA 29:10">عَ بَرَ وٌ شَ نَمِحْنمّيٍ يَيٍ بَلَن،</para>
  <para style="q" vid="ISA 29:10">عَ بَرَ وٌ شَ سٍمَتٌي شُنيِ مَكٌتٌ.<verse eid="ISA 29:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 29:11"/>يِ لَامَتُنيِ لُشِ نّ عَلْ سّبّلِ مَتْنشُمَشِ. نَ سٌمَ مِشِ نَن يِ نَشَن قَتَ عَ شَرَندٍ عَلَكٌ عَ شَ عَ شَرَن، كْنْ عَ قَ عَ يَابِ، «ﭑ مُ نْمَ عَ شَرَندٍ وٌ بّ، بَرِ مَ عَ بَلَنشِ تْنشُمَ رَ.» <verse eid="ISA 29:11"/><verse number="12" style="v" sid="ISA 29:12"/>شَ نَ مُ عَ رَ، عَ لُشِ عَلْ سّبّلِ نَشَن سٌمَ مِشِ شَرَنتَرٍ يِ رَ عَلَكٌ عَ شَ عَ شَرَن، كْنْ عَ قَ عَ يَابِ، «ﭑ تَن مُ قَتَ عَ شَرَندٍ.»<verse eid="ISA 29:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 29:13"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="ISA 29:13">«يِ حَمَ بَرَ قَ، عٍ شَ ﭑ مَتْشْ عٍ دّ رَ،</para>
  <para style="q" vid="ISA 29:13">كْنْ عٍ بْحّ تَن مَكُيَ ﭑ نَ.</para>
  <para style="q" vid="ISA 29:13">عٍ شَ بَتُي قِندِشِ عَدَ مَدِيٍ شَ يَامَرِ رَتِنمّقٍ نَن تُن نَ.<verse eid="ISA 29:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 29:14"/>نَ نَن عَ تٌشِ ﭑ مَن يِ حَمَ دّ عِشَرَ مَ نّ كَابَنَكٌي رَ.</para>
  <para style="q" vid="ISA 29:14">لْننِلَيٍ شَ لْننِ مُ فّمَ نَ كٌلٌندٍ،</para>
  <para style="q" vid="ISA 29:14">قٍ كٌلٌنيِيٍ مُ سٌمَ نَ قٍ كُي.<verse eid="ISA 29:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 29:15"/>حَشَنكَتّ نَ مِشِيٍ بّ نَشٍيٍ عٍ نْشُنمَ عَلَتَلَ مَ نَتّ كٌبِ رَبَقٍ رَ.</para>
  <para style="q" vid="ISA 29:15">عٍ تٌ عٍ شَ وَلِيٍ رَبَمَ دِ مِ نَن كُي،</para>
  <para style="q" vid="ISA 29:15">عٍ مَحْشُن، ‹ندٍ مُشُ تٌشِ؟ ندٍ عَ كٌلٌن مُشُ نَشَن نَبَمَ؟›<verse eid="ISA 29:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 29:16"/>وٌ شَ دَشُحَ سّنبّ فبٌ.</para>
  <para style="q" vid="ISA 29:16">بّندّ نْمَ لُدٍ عَلْ عَ يَءِلَنمَ؟</para>
  <para style="q" vid="ISA 29:16">سٍ يَءِلَنشِ نْمَ عَ قَلَدٍ عَ يَءِلَنمَ بّ، عَ مُ ﭑ يَءِلَنشِ؟</para>
  <para style="q" vid="ISA 29:16">قّحّ نْمَ عَ قَلَدٍ عَ يَءِلَنمَ بّ، عَ شَشِلِ مُ قَن؟»<verse eid="ISA 29:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="ISA 29:17"/>عَ فبٍ مُ لُشِ لِبَن وٌندِ شَ مَسَرَ شّ رَ،</para>
  <para style="q" vid="ISA 29:17">شّ قَن شَ مَسَرَ وٌندِ رَ.<verse eid="ISA 29:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 29:18"/>نَ لْشْي، تُلِ شْرِيٍ كِتَابُي شَرَنمَيٍ شُي مّمَ نّ،</para>
  <para style="q" vid="ISA 29:18">دْنشُييٍ قَن مِنِمَ نّ دِ مِ شْورَ، عٍ سٍ تٌ.<verse eid="ISA 29:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 29:19"/>يّتّ مَفٌرٌي سّيوَ مَ نّ عَلَتَلَ رَ،</para>
  <para style="q" vid="ISA 29:19">مِسِكِينّيٍ سّيوَ مَ نّ عِسِرَيِلَ شَ سّنِيّنتْي رَ.<verse eid="ISA 29:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 29:20"/>قُنمَلَ مُ لُمَ نَا سْنْن،</para>
  <para style="q" vid="ISA 29:20">مِشِ مَيٍلٍ لْيمَ نّ.</para>
  <para style="q" vid="ISA 29:20">قٍ كٌبِ رَبَيٍ لْيمَ نّ.<verse eid="ISA 29:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 29:21"/>عٍ مِشِ تْوحّفّمَ وُلٍ رَ، عٍ فَنتَنيِ عِتَلَمَ تِنشِنتْييٍ بّ.<verse eid="ISA 29:21"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="22" style="v" sid="ISA 29:22"/>يَشُبَ بْنسْي مَرِفِ شَ مَسٍنيِ نَن يَ نَشَن عِبُرَهِمَ شُن سَرَشِ؛</para>
  <para style="q" vid="ISA 29:22">«تٌ دَنفِ شَنبِ، يَشُبَ بْنسْي مُ يَافِمَ سْنْن،</para>
  <para style="q" vid="ISA 29:22">عَ بْحّ مُ رَحَاشُمَ عَ مَ.<verse eid="ISA 29:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 29:23"/>عَ شَ دِيٍ نَ ﭑ مَ وَلِيٍ تٌ عٍ تَفِ،</para>
  <para style="q" vid="ISA 29:23">عٍ ﭑ شِلِ بِنيَمَ نّ،</para>
  <para style="q" vid="ISA 29:23">عٍ عٍ مَفٌرٌ مَ نّ يَشُبَ شَ سّنِيّنتْي بّ،</para>
  <para style="q" vid="ISA 29:23">عٍ فَاشُمَ نّ عِسِرَيِلَ مَرِفِ عَلَ يَ رَ.<verse eid="ISA 29:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="ISA 29:24"/>مِشِ عِقُشِ قَهَامُي سْتْمَ نّ،</para>
  <para style="q" vid="ISA 29:24">سْنشْي رَتٍيٍ تِنمَ نّ لْننِ رَ.»<verse eid="ISA 29:24"/></para>
  <chapter eid="ISA 29"/>
  <chapter number="30" style="c" sid="ISA 30"/>
  <para style="s">حَشَنكَتّ بْنسْي مُرُتّلَ بّ</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 30:1"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ،</para>
  <para style="q" vid="ISA 30:1">«حَشَنكَتّ نَ بْنسْي مُرُتّلَ بّ.</para>
  <para style="q" vid="ISA 30:1">عٍ نَتّيٍ تٌنفٌمَ، نَشٍيٍ مُ كٍلِشِ ﭑ تَن مَ.</para>
  <para style="q" vid="ISA 30:1">عٍ سَاتّيٍ شِرِ مَ، ﭑ شَشِلِ مُ عٍ يَمَرِشِ نَشٍيٍ رَ.</para>
  <para style="q" vid="ISA 30:1">نَ كُي عٍ يُنُبِ شُن مَسَمَ تُن.<verse eid="ISA 30:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 30:2"/>عٍ سِفَمَ مِسِرَ، عٍ عٍ يّتّ تَشُ مّننِ مَنفّ رَ.</para>
  <para style="q" vid="ISA 30:2">عٍ وَ مَ لُقٍ عَ شَ كَنتّ بُن مَ.</para>
  <para style="q" vid="ISA 30:2">عٍ نَ بِرِن نَبَ ﭑ تَن شَنبِ.<verse eid="ISA 30:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 30:3"/>مِسِرَ مَنفّ شَ كَنتّ قِندِ مَ يَافِ نَن نَ وٌ بّ،</para>
  <para style="q" vid="ISA 30:3">لُقٍ عَ شَ نِينِ بُن مَ نَ وٌ تْورْ مَ نّ تُن.<verse eid="ISA 30:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 30:4"/>هَلِ وٌ كُنتِفِيٍ شّي سٌوَن نُن شَنّسِ مِسِرَ بْشِ مَ،<verse eid="ISA 30:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 30:5"/>عٍ بِرِن قَمَ لُدٍ يَافِ نَن كُي نَ حَمَ شَ قٍ رَ نَشَن مُ عٍ مَلِمَ.</para>
  <para style="q" vid="ISA 30:5">عٍ مُ وٌ دّ مّنمَ، عٍ وٌ رَيَافِمَ تُن.»<verse eid="ISA 30:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="ISA 30:6"/>حَشَنكَتّ نَ نٍفٍوِ فبٍنفبٍرٍنيِ سُبٍيٍ بّ.</para>
  <para style="q" vid="ISA 30:6">عٍ بْشِ شْرْشْي نَن عِفِرِ مَ يّتّيٍ نُن بْشِمَسٍيٍ نَ دّننَشّ،</para>
  <para style="q" vid="ISA 30:6">عٍ شَ بَننَيَ شَنِنقٍ رَ سٌقَلٍيٍ نُن حْشْمّيٍ قَرِ حَمَ شْن مَ،</para>
  <para style="q" vid="ISA 30:6">نَشَن مُ قَتَ عٍ مَلِدٍ قٍقٍ مَ.<verse eid="ISA 30:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 30:7"/>مِسِرَ شَ مَلِ قِندِ مَ قٍ قُقَقُ نَن تُن نَ!</para>
  <para style="q" vid="ISA 30:7">نَ نَن عَ رَ، ﭑ نَشَ يِ شِلِ سَ عَ شُن مَ؛ تُرُننَادّ تَفَنشِ.<verse eid="ISA 30:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="ISA 30:8"/>يِ قٍ سّبّ وَلَشّ مَ عٍ بّ،</para>
  <para style="q" vid="ISA 30:8">عَ سّبّ بُكِ مَ عَلَكٌ عَ شَ قِندِ سٍيدٍ رَ عَبَدَن.<verse eid="ISA 30:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 30:9"/>حَمَ مُرُتّلَ نَن عَ رَ، نَشَن عَ بٌورٍيٍ مَدَشُمَ،</para>
  <para style="q" vid="ISA 30:9">نَشَن مُ وَ مَ عَ تُلِ مَتِقٍ عَلَتَلَ شَ سّرِيّ رَ.<verse eid="ISA 30:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 30:10"/>عٍ عَ قَلَمَ سٍمَتٌي بّ، «وٌ نَشَ لَامَتُنيِيٍ تٌ.»</para>
  <para style="q" vid="ISA 30:10">عٍ عَ قَلَمَ نَمِحْنمّيٍ بّ، «وٌ نَشَ مَسٍنيِ تِنشِنشِ تِ.»</para>
  <para style="q" vid="ISA 30:10">عٍ نَشّ، «وٌ شَ مَسٍنيِ حْشُنمّيٍ تِ،</para>
  <para style="q" vid="ISA 30:10">وٌ شَ وْيّن قَنيِ قَلَ، هَلِ نْندِ مُ عَ رَ.<verse eid="ISA 30:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 30:11"/>وٌ شَ كٍلِ يِ كِرَ شْن مَ،</para>
  <para style="q" vid="ISA 30:11">وٌ شَ عِسِرَيِلَ شَ سّنِيّنتْي مَسٍنيِ لُ نَا.»<verse eid="ISA 30:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="ISA 30:12"/>عِسِرَيِلَ شَ سّنِيّنتْي شَ يَابِ نَن يَ،</para>
  <para style="q" vid="ISA 30:12">«وٌ تٌ تٌندِ يِ مَسٍنيِ رَ،</para>
  <para style="q" vid="ISA 30:12">وٌ قَ لَ تْورّ نُن مَدَشُي رَ،<verse eid="ISA 30:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 30:13"/>يِ يُنُبِ لُمَ نّ وٌ بّ عَلْ تّتّ كَنَشِ،</para>
  <para style="q" vid="ISA 30:13">نَشَن بِرَ مَ تّرّننَ رَ.<verse eid="ISA 30:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 30:14"/>عَ كَنَمَ نّ عَلْ قّحّ كَنَشِ،</para>
  <para style="q" vid="ISA 30:14">هَلِ تّ كْ سٍ، شَ نَ مُ عَ رَ يٍ بَسٍ مُ مِنِ عَ كُي.»<verse eid="ISA 30:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="ISA 30:15"/>مَرِفِ عَلَ نَشَن قِندِشِ عِسِرَيِلَ سّنِيّنتْي رَ، عَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="ISA 30:15">«شَ وٌ فبِلٍن ﭑ مَ، وٌ قَ وٌ رَشَرَ،</para>
  <para style="q" vid="ISA 30:15">ﭑ وٌ رَكِسِمَ نّ.</para>
  <para style="q" vid="ISA 30:15">شَ وٌ دْشْ، وٌ قَ وٌ تَشُ ﭑ نَ،</para>
  <para style="q" vid="ISA 30:15">ﭑ سّنبّ قِمَ نّ وٌ مَ.</para>
  <para style="q" vid="ISA 30:15">كْنْ وٌ مُ تِن نَ رَ.<verse eid="ISA 30:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 30:16"/>وٌ نَشّ، ‹عَدٍ، مُشُ تَن مُشُ فِمَ سٌييٍ نَن قَرِ.›</para>
  <para style="q" vid="ISA 30:16">عَوَ يِرٍ، وٌ قَمَ فِدٍ.</para>
  <para style="q" vid="ISA 30:16">وٌ نَشّ، ‹مُشُ تَن مُشُ فِمَ سٌي شُلُنشِيٍ نَن قَرِ.›</para>
  <para style="q" vid="ISA 30:16">عَوَ يِرٍ، كْنْ وٌ كٍرِ مَيٍ شُلُن وٌ بّ.<verse eid="ISA 30:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 30:17"/>وٌ وُلُ كٍرٍن، وٌ فِمَ نّ وٌ يَشُي كٍرٍن يَ رَ.</para>
  <para style="q" vid="ISA 30:17">شَ يَشُي سُولِ نَ عَ رَ، وٌ بِرِن وٌ فِمَ نّ،</para>
  <para style="q" vid="ISA 30:17">وٌ قَ لُ عَلْ فٍيَ وُرِ كٍرٍن فبَنسَن تِشِ نَشَن قَرِ.»<verse eid="ISA 30:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 30:18"/>كْنْ نَ كُي عَلَتَلَ نَ مَمّ تِقٍ عَلَكٌ عَ شَ هِننّ وٌ رَ.</para>
  <para style="q" vid="ISA 30:18">عَ قَمَ نّ كٍلِدٍ، عَ كِنِكِنِ وٌ مَ،</para>
  <para style="q" vid="ISA 30:18">بَرِ مَ عَلَتَلَ تِنشِن.</para>
  <para style="q" vid="ISA 30:18">سّيوّ نَ مِشِ بّ، نَشَن عَ شَشِلِ تِشِ عَ رَ.<verse eid="ISA 30:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="ISA 30:19"/>سِيٌنِكَيٍ، وٌ تَن نَشٍيٍ سَبَتِشِ دَرِ سَلَمُ،</para>
  <para style="q" vid="ISA 30:19">وٌ مُ يَيٍ رَ مِنِمَ سْنْن.</para>
  <para style="q" vid="ISA 30:19">وٌ نَ عَ شِلِ، عَ هِننّمَ نّ وٌ رَ،</para>
  <para style="q" vid="ISA 30:19">عَ نَ وٌ شُي مّ، عَ وٌ يَابِمَ نّ كٍرٍن نَ.<verse eid="ISA 30:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 30:20"/>هَلِ وٌ مَرِفِ عَ نِيَ وٌ شَ لُ قٍ شْرْشْي كُي،</para>
  <para style="q" vid="ISA 30:20">وٌ كَرَ مْشْييٍ مُ عٍ نْشُنمَ وٌ مَ سْنْن،</para>
  <para style="q" vid="ISA 30:20">وٌ قَمَ نّ عٍ تٌدٍ وٌ يَيٍ رَ.<verse eid="ISA 30:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 30:21"/>وٌ نَ سِفَ يِرٍقَنيِ مَ، وٌ نَ سِفَ كْولَ مَ،</para>
  <para style="q" vid="ISA 30:21">وٌ قَمَ نّ مَسٍنيِ مّدٍ وٌ شَنبِ رَ نَشَن عَ قَلَمَ وٌ بّ،</para>
  <para style="q" vid="ISA 30:21">«كِرَ قَنيِ نَن يَ، وٌ شَ وٌ حّرّ عَ شْن مَ.»<verse eid="ISA 30:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 30:22"/>نَ كُي وٌ شَ كُيٍ نَشٍيٍ يَءِلَنشِ فبٍتِ نُن شّيمَ رَ،</para>
  <para style="q" vid="ISA 30:22">وٌ قَمَ نّ نٍيٍ وٌلِدٍ عَلْ سٍ سّنِيّنتَرٍيٍ،</para>
  <para style="q" vid="ISA 30:22">وٌ قَ عَ قَلَ، «وٌ كٍلِ بٍ!»<verse eid="ISA 30:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="ISA 30:23"/>نَ تّمُي عَلَتَلَ تُنّ رَقَمَ نّ وٌ شَ سَنسِيٍ مَ،</para>
  <para style="q" vid="ISA 30:23">وٌ شَ بْشِ دَشَمُي فبٌمَ نّ.</para>
  <para style="q" vid="ISA 30:23">نَ تّمُي وٌ شَ شُرُ سٍيٍ سِفَمَ نّ عٍ دّ مَدٌندٍ قِيلِ شُنفبٍيٍ مَ.<verse eid="ISA 30:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="ISA 30:24"/>نِنفٍ نُن سٌقَلٍ نَشٍيٍ شّ بُشَمَ،</para>
  <para style="q" vid="ISA 30:24">عٍ قَمَ سٍ قَنيِ نَن دٌندٍ نَشَن نَقَلَشِ عٍ بّ.<verse eid="ISA 30:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="ISA 30:25"/>شُرٍيٍ وُيَمَ نّ وٌ شَ فٍيَيٍ قَرِ.</para>
  <para style="q" vid="ISA 30:25">نَ تّمُي قَشّ شُنفبٍ نَن تِمَ،</para>
  <para style="q" vid="ISA 30:25">يِرٍ سّنبّمَ عِتٍشِيٍ رَبِرَ مَ نّ.<verse eid="ISA 30:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="ISA 30:26"/>عَلَتَلَ قَمَ نّ عَ شَ حَمَ شَ مَشْنّيٍ نُن قِيٍ رَيَلَندٍ.</para>
  <para style="q" vid="ISA 30:26">نَ لْشْي كِكٍ يَنبَمَ نّ عَلْ سٌفٍ،</para>
  <para style="q" vid="ISA 30:26">سٌفٍ شَ يَنبّ قَن شُن مَسَمَ نّ دْشْ سٌلٌقٍرٍ.<verse eid="ISA 30:26"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="27" style="v" sid="ISA 30:27"/>عَلَتَلَ نَ قَقٍ كٍلِقٍ يِرٍ مَكُيٍ،</para>
  <para style="q" vid="ISA 30:27">عَ شْنْشِ عَ شْرْشْي رَ، عَ قَمَ نّ تُورِ بٍلٍبٍلٍ كُي.</para>
  <para style="q" vid="ISA 30:27">تّ مِنِمَ نّ عَ كّرّ كُي شْنّ شَ قٍ رَ.<verse eid="ISA 30:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="ISA 30:28"/>عَ حّنفِ لُشِ نّ عَلْ بَنبَرَنيِ نَشَن تٍمَ هَن مِشِ كْنيِ.</para>
  <para style="q" vid="ISA 30:28">عَ حَمَنّيٍ سُشُمَ نّ،</para>
  <para style="q" vid="ISA 30:28">عَ كَرَقٌي سَ عٍ مَ، عَ سٍ ندٍ رَ سٌ عٍ بَنفَنيِيٍ رَ،</para>
  <para style="q" vid="ISA 30:28">عَ عٍ شَنِن يِرٍ عٍ مُ وَ مَ سِفَقٍ دّننَشّ.<verse eid="ISA 30:28"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="29" style="v" sid="ISA 30:29"/>كْنْ وٌ تَن بّيتِ بَمَ نّ نَ لْشْي عَلْ سَلِ تّمُي،</para>
  <para style="q" vid="ISA 30:29">وٌ بْحّيٍ سّيوَ مَ نّ عَلْ مِشِ نَشٍيٍ شُلٍ قٍمَ سِفَقٍ رَ عَلَتَلَ شَ فٍيَ قَرِ،</para>
  <para style="q" vid="ISA 30:29">عَلَتَلَ نَشَن لُشِ عَلْ قَنيٍ عِسِرَيِلَ بّ.<verse eid="ISA 30:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="ISA 30:30"/>عَلَتَلَ عَ شُي شَاحّ رَ مِنِمَ نّ،</para>
  <para style="q" vid="ISA 30:30">عَ عَ سّنبّ مَسٍنمَ نّ شْنّ بٍلٍبٍلٍ نُن تّ كَسَرّ رَ.</para>
  <para style="q" vid="ISA 30:30">عَ قَمَ نّ سٍسَرِنيِ، فَلَنيِ، تُنّ شُنفبٍ، تُرُننَادّ، نُن بَلَبَلَنيِ رَ.<verse eid="ISA 30:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="ISA 30:31"/>عَلَتَلَ شُي قَمَ نّ عَسِرِيَكَيٍ بُتُشُندٍ،</para>
  <para style="q" vid="ISA 30:31">عَ عٍ رَبِرَ عَ شَ مَنفّيَ رَ.<verse eid="ISA 30:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="ISA 30:32"/>عَ نَ عٍ بْنبْ وُرِ شْرْشْي رَ تّمُي نَشّ،</para>
  <para style="q" vid="ISA 30:32">عَ شَ حَمَ بّيتِ بَمَ نّ مَشَسٍيٍ نُن كْرَيٍ شُي رَ.<verse eid="ISA 30:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="ISA 30:33"/>تّ يِرٍ بَرَ يَءِلَن مَنفّ شِلِ مَ عَ رَكُيَ.</para>
  <para style="q" vid="ISA 30:33">عَ تِلِن، عَ عِفبٌ.</para>
  <para style="q" vid="ISA 30:33">يٍفٍ فبٍفبٍ مَلَنشِ نَ تّ بٍلٍبٍلٍ شَ قٍ رَ.</para>
  <para style="q" vid="ISA 30:33">عَلَتَلَ حّنفِ لُشِ نّ عَلْ تّ حَاشِ نَشَن فَنمَ عَ قَنيِ رَ.<verse eid="ISA 30:33"/></para>
  <chapter eid="ISA 30"/>
  <chapter number="31" style="c" sid="ISA 31"/>
  <para style="s">مِسِرَ شَ مَلِ</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 31:1"/>حَشَنكَتّ نَ وٌ بّ،</para>
  <para style="q" vid="ISA 31:1">وٌ تَن نَشٍيٍ وٌ يّتّ تَشُمَ مِسِرَ رَ،</para>
  <para style="q" vid="ISA 31:1">وٌ تَن نَشٍيٍ لَمَ عٍ شَ سْورِ رَفِسٍ وُيَشِيٍ رَ،</para>
  <para style="q" vid="ISA 31:1">وٌ تَن نَشٍيٍ عٍ شَ سٌي رَفِمَيٍ مَتٌمَ.</para>
  <para style="q" vid="ISA 31:1">وٌ مُ عِسِرَيِلَ شَ سّنِيّنتْي قٍنمَ،</para>
  <para style="q" vid="ISA 31:1">وٌ مُ وَ مَ عَلَتَلَ شَ مَلِ شْن مَ.<verse eid="ISA 31:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 31:2"/>كْنْ عَلَ شَشِلِ نَن فبٌ،</para>
  <para style="q" vid="ISA 31:2">عَ قَتَ حَشَنكَتّ رَفٌرٌدٍ مِشِيٍ مَ.</para>
  <para style="q" vid="ISA 31:2">عَ شُي مُ كَنَمَ.</para>
  <para style="q" vid="ISA 31:2">عَ كٍلِمَ حَمَ حَاشِ شِلِ مَ،</para>
  <para style="q" vid="ISA 31:2">نَشٍيٍ مِشِ كٌبِيٍ مَلِمَ.<verse eid="ISA 31:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 31:3"/>مِسِرَكَيٍ مُ قِندِشِ عَلَ رَ،</para>
  <para style="q" vid="ISA 31:3">عَدَ مَدِيٍ نَن تُن نَ عٍ رَ.</para>
  <para style="q" vid="ISA 31:3">عٍ شَ سٌييٍ مُ قِندِشِ شَشِلِ شَ رَ،</para>
  <para style="q" vid="ISA 31:3">سُبٍ نَن تُن نَ عٍ رَ.</para>
  <para style="q" vid="ISA 31:3">عَلَتَلَ نَ كٍلِ تّمُي نَشّ مِشِيٍ شِلِ مَ،</para>
  <para style="q" vid="ISA 31:3">نَشَن مَلِ تِمَ يٌ، نَشَن مَلِ قٍنمَ يٌ،</para>
  <para style="q" vid="ISA 31:3">عَ عٍ بِرِن هَلَكِمَ نّ.<verse eid="ISA 31:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="ISA 31:4"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="ISA 31:4">«يّتّ نَ يِرِندِن عَ شَ سُبٍ سُشُشِ شُن مَ،</para>
  <para style="q" vid="ISA 31:4">هَلِ شُرُ سٍ دّ مَدٌنيِ فبٍفبٍيٍ كَتَمَ نّ عَ كٍرِدٍ،</para>
  <para style="q" vid="ISA 31:4">عَ مُ فَاشُمَ عٍ شَ سْنشْي رَتٍ يَ رَ،</para>
  <para style="q" vid="ISA 31:4">عَ مُ كٍلِمَ نَ سُبٍ شُن مَ قٍقٍ مَ.</para>
  <para style="q" vid="ISA 31:4">عَلَتَلَ سّنبّمَ قَن فٌرٌ مَ نّ فٍرٍ سٌدٍ سِيٌنِ فٍيَ قَرِ نَ كِ نّ.<verse eid="ISA 31:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 31:5"/>عَلَتَلَ سّنبّمَ دَرِ سَلَمُ مَكَنتَمَ نّ،</para>
  <para style="q" vid="ISA 31:5">عَلْ شْنِ عَ فَبُتٍنيِيٍ عِتَلَمَ عَ يْرّيٍ شُن مَ كِ نَشّ،</para>
  <para style="q" vid="ISA 31:5">عَ عٍ كَنتَ، عَ عٍ رَكِسِ، عَ عَ تِ عٍ شُن مَ.»<verse eid="ISA 31:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 31:6"/>عِسِرَيِلَكَيٍ، وٌ شَ فبِلٍن عَلَ مَ وٌ بَرَ وٌ مَكُيَ نَشَن نَ. <verse eid="ISA 31:6"/><verse number="7" style="v" sid="ISA 31:7"/>نَ لْشْي وٌ قَمَ نّ وٌ شَ كُيٍيٍ رَبّحِندٍ وٌ نَشٍيٍ يَءِلَنشِ فبٍتِ نُن شّيمَ رَ يُنُبِ شَ قٍ رَ.<verse eid="ISA 31:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 31:8"/>«عَسِرِيَكَيٍ قَمَ نّ سْنتْدٍ سَنتِدّفّمَ رَ،</para>
  <para style="q" vid="ISA 31:8">نَشَن مُ قَتَنشِ حّنفِ كَنيِ رَ.</para>
  <para style="q" vid="ISA 31:8">عٍ عٍ فِمَ نّ نَ يَ رَ، عٍ شَ قٌنِكٍيٍ شَنِنمَ نّ كٌنيِيَ كُي.<verse eid="ISA 31:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 31:9"/>عٍ شَ يِرٍ مَكَنتَشِ بِرَ مَ نّ فَاشُي كُي،</para>
  <para style="q" vid="ISA 31:9">لِمَنِيَ بَمَ نّ عٍ شَ سْورِ مَنفّيٍ يِ رَ فٍرٍ قَ تّمُي.»</para>
  <para style="q" vid="ISA 31:9">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ،</para>
  <para style="q" vid="ISA 31:9">نَشَن نَ فٍرٍ تّ رَدّشّمَ سِيٌنِ فٍيَ مَ دَرِ سَلَمُ كُي.<verse eid="ISA 31:9"/></para>
  <chapter eid="ISA 31"/>
  <chapter number="32" style="c" sid="ISA 32"/>
  <para style="s">مَنفّيَ تِنشِنشِ</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 32:1"/>مَنفّ قَمَ نّ مَنفّيَ رَحّرّدٍ تِنشِنيِ رَ،</para>
  <para style="q" vid="ISA 32:1">عَ شَ كُنتِفِيٍ كِيتِ سَمَ نّ سّرِيّ كِ مَ.<verse eid="ISA 32:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 32:2"/>كَنكَن لُمَ نّ عَلْ بَنشِ قَنيِ تُرُننَادّ دِنمَ نَشَن نَ،</para>
  <para style="q" vid="ISA 32:2">عَلْ شُرٍ نَشٍيٍ يٍ شَنِنمَ فبٍنفبٍرٍن يِرٍ،</para>
  <para style="q" vid="ISA 32:2">عَلْ فّمّ نِينِ بْشِ عِشَرَشِ مَ.<verse eid="ISA 32:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 32:3"/>نَ تّمُي يَ نَشٍيٍ سٍ قٍنمَ، نٍيٍ سٍ عِفبّمَ نّ.</para>
  <para style="q" vid="ISA 32:3">تُلِ نَشٍيٍ عٍ مَتِمَ، نٍيٍ قٍ مّمَ نّ.<verse eid="ISA 32:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 32:4"/>شَشِلِتَرٍيٍ قَمَ نّ قَهَامُي سْتْدٍ،</para>
  <para style="q" vid="ISA 32:4">بٌبٌي نّنيِ قَمَ نّ كٍلِدٍ، نٍيٍ قَ وْيّن عَ قَنيِ رَ.<verse eid="ISA 32:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 32:5"/>مِشِ كٌبِ مُ شِلِمَ كُنتِفِ،</para>
  <para style="q" vid="ISA 32:5">مِشِ تِنشِنتَرٍ مُ بِنيّ سْتْمَ سْنْن،<verse eid="ISA 32:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 32:6"/>بَرِ مَ عٍ مُ نْندِ قَلَمَ،</para>
  <para style="q" vid="ISA 32:6">عٍ مُ قٍ قَنيِ مَحْشُنمَ.</para>
  <para style="q" vid="ISA 32:6">عَ قٍ سّنِيّنشِ بْتّ رَبَمَ،</para>
  <para style="q" vid="ISA 32:6">عَ وُلٍ قَلَمَ عَلَتَلَ شَ قٍ رَ،</para>
  <para style="q" vid="ISA 32:6">عَ كَامّتْي لُمَ عَ شَ كَامّ كُي،</para>
  <para style="q" vid="ISA 32:6">عَ تٌندِ يٍ مَ مِشِ بّ، يٍ شْلِ نَ نَشَن مَ.<verse eid="ISA 32:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 32:7"/>مِشِ حَاشِ وَلِ كِ مُ قَن،</para>
  <para style="q" vid="ISA 32:7">عَ عَ مَتٌ عَ مِسِكِينّ شُن نَكَنَمَ تْوحّفّ رَ كِ نَشّ.<verse eid="ISA 32:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 32:8"/>كْنْ مِشِ قَنيِ تَن عَ مَتٌمَ نّ عَ قٍ قَنيِ رَبَمَ كِ نَشّ،</para>
  <para style="q" vid="ISA 32:8">عَ شُن نَكٍلِ عَ شَ وَلِ قَنيِ سَابُي رَ،<verse eid="ISA 32:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="ISA 32:9"/>بَننَ فِنّيٍ، وٌ شَ وٌ تُلِ مَتِ ﭑ شُي رَ.</para>
  <para style="q" vid="ISA 32:9">وٌ تَن نَشٍيٍ لَشِ وٌ يّتّ رَ، وٌ شَ ﭑ مَ مَسٍنيِ رَ مّ.<verse eid="ISA 32:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 32:10"/>بٍينُن حّ كٍرٍن شَ دَنفِ، وٌ سّرّنمَ نّ فَاشُي رَ،</para>
  <para style="q" vid="ISA 32:10">وٌ تَن نَشٍيٍ لَشِ وٌ يّتّ رَ،</para>
  <para style="q" vid="ISA 32:10">بَرِ مَ وّنِ بٌفِيٍ كَنَمَ نّ،</para>
  <para style="q" vid="ISA 32:10">شّ شَبّ قَن مُ قَنمَ.<verse eid="ISA 32:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 32:11"/>بَننَ فِنّيٍ، وٌ شَ وٌ مَفٌرٌ،</para>
  <para style="q" vid="ISA 32:11">وٌ تَن نَشٍيٍ لَشِ وٌ يّتّ رَ، وٌ شَ فَاشُ.</para>
  <para style="q" vid="ISA 32:11">وٌ شَ وٌ شَ دُفِ قَنيِ مَسَرَ كَاحّ دُفِ رَ.<verse eid="ISA 32:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 32:12"/>وٌ شَ وَ وٌ شَ وّنِ بٌفِ نُن شّ كَنَشِيٍ شَ قٍ رَ.<verse eid="ISA 32:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 32:13"/>وٌ شَ وَ ﭑ مَ حَمَ شَ بْشِ شَ قٍ رَ،</para>
  <para style="q" vid="ISA 32:13">نَشَن بَرَ قِندِ حٌوفٍ نُن تُنبٍ يِرٍ رَ.</para>
  <para style="q" vid="ISA 32:13">وٌ شَ وَ وٌ شَ تَايٍ شَ قٍ رَ حّلّشِنيِ حْنشِ دّننَشّ.<verse eid="ISA 32:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 32:14"/>وٌ شَ يِرٍ مَكَنتَشِ رَبٌلٌمَ نّ،</para>
  <para style="q" vid="ISA 32:14">وٌ شَ تَا قَنيِ قِندِ مَ نّ وُلَ رَ،</para>
  <para style="q" vid="ISA 32:14">سٌقَلٍ نُن شُرُ سٍيٍ دّ مَدٌنمَ دّننَشّ.<verse eid="ISA 32:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 32:15"/>عَ لُمَ نَ كِ نّ هَن عَلَ عَ شَشِلِ سّنِيّنشِ رَفٌرٌ مَ وٌن مَ تّمُي نَشّ كٍلِ كٌورٍ مَ.</para>
  <para style="q" vid="ISA 32:15">نَ تّمُي نَ فبٍنفبٍرٍنيِ قِندِ مَ نّ سَنسِ يِرٍ رَ،</para>
  <para style="q" vid="ISA 32:15">عَ فبٌ يّ عَلْ قْتْنيِ.<verse eid="ISA 32:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 32:16"/>سّرِيّ رَحّرّ مَ نّ فبٍنفبٍرٍنيِ مَ،</para>
  <para style="q" vid="ISA 32:16">تِنشِنيِ قَن سَبَتِمَ نّ سَنسِ يِرٍ.<verse eid="ISA 32:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 32:17"/>تِنشِنيِ شَ وَلِ قِندِ مَ بْحّسَ نَن نَ،</para>
  <para style="q" vid="ISA 32:17">عَ قِندِ شَشِلِسَ نُن كَنتَرِ رَ وَشَتِ بِرِن.<verse eid="ISA 32:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 32:18"/>ﭑ مَ حَمَ لُمَ نّ نَا بْحّسَ كُي، مَرَشَرّ كُي.<verse eid="ISA 32:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 32:19"/>هَلِ قْتْنيِ كَنَ، تَا بِرَ،<verse eid="ISA 32:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 32:20"/>هّيرِ نَن لُمَ وٌ بّ،</para>
  <para style="q" vid="ISA 32:20">وٌ تَن نَشٍيٍ سَنسِ سِمَ شُرٍ دّ رَ،</para>
  <para style="q" vid="ISA 32:20">وٌ تَن نَشٍيٍ تِنمَ وٌ شَ نِنفٍيٍ نُن وٌ شَ سٌقَلٍيٍ شَ عٍ دّ مَدٌن.<verse eid="ISA 32:20"/></para>
  <chapter eid="ISA 32"/>
  <chapter number="33" style="c" sid="ISA 33"/>
  <para style="s">فبَلٌي نُن كِسِ</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 33:1"/>حَشَنكَتّ نَ عِ بّ، عِ تَن نَشَن فبَلٌي رَبَمَ.</para>
  <para style="q" vid="ISA 33:1">حَشَنكَتّ نَ عِ بّ، عِ تَن نَشَن يَنقّ تِمَ.</para>
  <para style="q" vid="ISA 33:1">عِ نَ فّ نَ رَبَدٍ، عِ شُن قَ رَكَنَ، يَنقّ فبِلٍن عِ مَ.<verse eid="ISA 33:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="ISA 33:2"/>عَلَتَلَ هِننّ مُشُ رَ، مُشُ شَشِلِ تِشِ عِ تَن نَن نَ.</para>
  <para style="q" vid="ISA 33:2">عِ شَ مُشُ سّنبّ شُن مَسَ، عِ شَ مُشُ رَتَنفَ قٍ شْرْشْي مَ.<verse eid="ISA 33:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 33:3"/>سِيٍ عٍ فِمَ نّ عِ شُي يَ رَ،</para>
  <para style="q" vid="ISA 33:3">حَمَنّيٍ يٍنسٍنمَ نّ عِ شَ فٍرٍ شُي رَ.<verse eid="ISA 33:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="ISA 33:4"/>وٌ تَن سِيٍ، مِشِيٍ قَمَ نّ وٌ شَ نَاقُلِ سُشُدٍ،</para>
  <para style="q" vid="ISA 33:4">عَلْ كَتٌي دِنمَ شّ رَ كِ نَشّ.<verse eid="ISA 33:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="ISA 33:5"/>وٌ تَن سِيٌنِكَيٍ، عَلَتَلَ فبٌ، عَ سَبَتِشِ كٌورٍ نَن مَ.</para>
  <para style="q" vid="ISA 33:5">عَ تِنشِنيِ نُن نْندِ قِمَ نّ وٌ مَ.<verse eid="ISA 33:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 33:6"/>عَ وٌ بُن تِ.</para>
  <para style="q" vid="ISA 33:6">عَ كِسِ، شَشِلِ قَنيِ، نُن قَهَامُي رَفَتَمَ نّ وٌ بّ،</para>
  <para style="q" vid="ISA 33:6">وٌ تَن نَشٍيٍ فَاشُمَ عَ يَ رَ.<verse eid="ISA 33:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="ISA 33:7"/>وٌ عَ مَتٌ، حَلَمَيٍ نُن شّيرَيٍ نَ وَقٍ تَندٍ.<verse eid="ISA 33:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 33:8"/>مِشِ يٌ مُ تٌمَ كِرَيٍ مَ سْنْن.</para>
  <para style="q" vid="ISA 33:8">سَاتّ بَرَ كَنَ، سَاتّ سٍيدٍيٍ بَرَ يَافِ، بِنيّ يٌ مُ نَ سْنْن.<verse eid="ISA 33:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 33:9"/>بْشِ نَ سُننُنيِ نُن هَلَكِ نَن كُي.</para>
  <para style="q" vid="ISA 33:9">لِبَن شَ مّرّ بَرَ مَشَرَ،</para>
  <para style="q" vid="ISA 33:9">بَسَن نُن كَرٍ مٍلٍ قْتْنيِ بُرّشّيٍ نَ يٌلٌنقٍ.<verse eid="ISA 33:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="ISA 33:10"/>عَلَتَلَ نَشّ، «يَكْسِ ﭑ كٍلِمَ نّ قَ، وٌ قَ ﭑ مَتْشْ.<verse eid="ISA 33:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 33:11"/>وٌ تٌ نَتّ قُقَقُ تٌنفٌ، وٌ مَن قٍ قُقَقُ نَن سْتْمَ.</para>
  <para style="q" vid="ISA 33:11">وٌ حّنفِ لُشِ نّ عَلْ تّ نَشَن قَمَ وٌ فَندٍ.<verse eid="ISA 33:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 33:12"/>تّ دِنمَ نّ سِيٍ رَ، عٍ فَن عَلْ تُنبٍ مَسّفّشِ، سٍسٍ مُ لُ.»<verse eid="ISA 33:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="ISA 33:13"/>وٌ تَن نَشٍيٍ مَكُيَ ﭑ نَ، وٌ شَ وٌ تُلِ مَتِ ﭑ مَ قٍ رَبَشِيٍ رَ.</para>
  <para style="q" vid="ISA 33:13">وٌ تَن نَشٍيٍ مَكْرّ ﭑ نَ، وٌ شَ لَ ﭑ سّنبّ رَ.<verse eid="ISA 33:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 33:14"/>يُنُبِتْي نَشٍيٍ نَ سِيٌنِ، عٍ بَرَ فَاشُ.</para>
  <para style="q" vid="ISA 33:14">عَلَتَلَ يَشُييٍ بَرَ سّرّن قْلْ.</para>
  <para style="q" vid="ISA 33:14">«ندٍ نْمَ لُدٍ تّ كَسَرَتِ سّيتِ مَ؟</para>
  <para style="q" vid="ISA 33:14">ندٍ رَتَنفَمَ تّ شُبٍنتَرٍ مَ وٌن يَ مَ؟»<verse eid="ISA 33:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 33:15"/>مِشِ نَن عَ رَ نَشَن حّرّ مَ تِنشِنيِ رَ،</para>
  <para style="q" vid="ISA 33:15">نَشَن نْندِ قَلَمَ، نَشَن تٌندِ مَ فٍينِ سْتْ كِ حَاشِ رَ،</para>
  <para style="q" vid="ISA 33:15">نَشَن مُ عَ بّلّشّ عِتَلَمَ بُحَ كٌبِ بّ،</para>
  <para style="q" vid="ISA 33:15">نَشَن مُ عَ تُلِ مَتِمَ مِشِ قَشَقٍ نَتّ تٌنفٌي رَ،</para>
  <para style="q" vid="ISA 33:15">نَشَن مُ عَ شَشِلِ تِمَ قٍ حَاشِ رَ.<verse eid="ISA 33:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 33:16"/>نَ مِشِ مْولِ تَن سَبَتِمَ نّ فٍيَ قَرِ يِرٍ مَكَنتَشِ كُي،</para>
  <para style="q" vid="ISA 33:16">عَ بَلٌي نُن يٍ سْتْ عَ قَنيِ رَ.<verse eid="ISA 33:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="ISA 33:17"/>وٌ يَيٍ مَنفّ تٌمَ نّ عَ شَ تٌقَنيِ كُي،</para>
  <para style="q" vid="ISA 33:17">وٌ مَن قَ بْشِ تٌ نَشَن شَ فبٌي مُ حْنمَ.<verse eid="ISA 33:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 33:18"/>وٌ رَتُمَ نّ وٌ فَاشُ كِ مَ، عَ قَلَقٍ رَ،</para>
  <para style="q" vid="ISA 33:18">«نَ مَنفّ نَ مِندٍن؟ دُوتِ مَشِلِ فٌ؟ يِرٍ مَكَنتَشِ شُنمَتٌ فٌ؟»<verse eid="ISA 33:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 33:19"/>وٌ مُ قَمَ نَ بْنسْي يّتّ عِفبٌي تٌدٍ سْنْن،</para>
  <para style="q" vid="ISA 33:19">نَشٍيٍ شَ شُي قَهَامُقٍ شْرْشْ.<verse eid="ISA 33:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="ISA 33:20"/>سِيٌنِ مَتٌ، وٌن مَ سَلِ رَبَمَ دّننَشّ.</para>
  <para style="q" vid="ISA 33:20">مّننِ وٌ دَرِ سَلَمُ تٌمَ نّ،</para>
  <para style="q" vid="ISA 33:20">تَا نَشَن نَشَرَشِ، حَمَ نَشَن مُ تَلَمَ عٍ شْنيِ سْنْن.<verse eid="ISA 33:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 33:21"/>وٌن مَرِفِ سّنبّمَ لُمَ نّ نَا وٌن يَ مَ شُرٍيٍ سّيتِ مَ.</para>
  <para style="q" vid="ISA 33:21">وٌن يَشُييٍ مُ نْمَ تِدٍ نَ شُرٍيٍ مَ عٍ شَ كُنكُييٍ كُي،<verse eid="ISA 33:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 33:22"/>بَرِ مَ عَلَتَلَ نَن نَ وٌن مَ كِيتِسَ رَ،</para>
  <para style="q" vid="ISA 33:22">عَ سّرِيّ يَتِ نَن قِمَ وٌن مَ.</para>
  <para style="q" vid="ISA 33:22">عَلَتَلَ نَن نَ وٌن مَ مَنفّ رَ،</para>
  <para style="q" vid="ISA 33:22">عَ وٌن نَتَنفَمَ قٍ حَاشِ نَن مَ.<verse eid="ISA 33:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="ISA 33:23"/>وٌ تَن سِيٍ، وٌ شَ لُوتِيٍ بَرَ يْنتْن،</para>
  <para style="q" vid="ISA 33:23">وٌ شَ كُنكُي وُرِ مُ تِشِ،</para>
  <para style="q" vid="ISA 33:23">وٌ شَ بّلَ مُ فّشِ عِتَلَدٍ.</para>
  <para style="q" vid="ISA 33:23">نَ كُي وٌ شَ نَاقُلِ قَمَ نّ شَنِندٍ،</para>
  <para style="q" vid="ISA 33:23">هَلِ مَبّنيِيٍ نْمَ نَ رَبَدٍ.<verse eid="ISA 33:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="ISA 33:24"/>سِيٌنِكَ يٌ مُ عَ قَلَمَ، «ﭑ مُ يَلَنشِ.»</para>
  <para style="q" vid="ISA 33:24">عٍ شَ يُنُبِيٍ قَمَ نّ شَقَرِدٍ.<verse eid="ISA 33:24"/></para>
  <chapter eid="ISA 33"/>
  <chapter number="34" style="c" sid="ISA 34"/>
  <para style="s">عٍدٌن شَ كِيتِ</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 34:1"/>وٌ وٌ مَسٌ، وٌ تَن حَمَنّيٍ، عَلَكٌ وٌ شَ وٌ تُلِ مَتِ.</para>
  <para style="q" vid="ISA 34:1">سِيٍ، وٌ شَ وٌ تُلِ مَتِ ﭑ نَ عَ قَنيِ رَ.</para>
  <para style="q" vid="ISA 34:1">دُنِحَ حَمَ بِرِن شَ عٍ تُلِ مَتِ ﭑ مَ مَسٍنيِ رَ،<verse eid="ISA 34:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 34:2"/>بَرِ مَ عَلَتَلَ شْنْشِ حَمَنّ نُن عٍ شَ سْورِ فَالِ بِرِن مَ.</para>
  <para style="q" vid="ISA 34:2">عَ قَمَ نّ دِندٍ عٍ رَ، عَ عٍ رَتْن.<verse eid="ISA 34:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 34:3"/>عٍ شَ مِشِ قَشَشِيٍ مُ رَفَتَمَ.</para>
  <para style="q" vid="ISA 34:3">عٍ بِنبِيٍ بْرْ مَ نّ، عٍ شِرِ قَ تٍ كٌورٍ مَ.</para>
  <para style="q" vid="ISA 34:3">عٍ وُلِ عِقِلِمَ نّ فٍيَيٍ مَ.<verse eid="ISA 34:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="ISA 34:4"/>هَلِ تُنبُي نَشٍيٍ نَ كٌورٍ مَ، عٍ بِرَ مَ نّ،</para>
  <para style="q" vid="ISA 34:4">عَلْ بُرّشّيٍ نُن شْرّيٍ بِرَ مَ كِ نَشّ.</para>
  <para style="q" vid="ISA 34:4">كٌورٍ وَلَشّ مَكُنتَنمَ نّ عَلْ دَفِ.<verse eid="ISA 34:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 34:5"/>عَلَتَلَ نَشّ، «ﭑ مَ سَنتِدّفّمَ نَ فّ نَ وَلِ رَ،</para>
  <para style="q" vid="ISA 34:5">عَ فٌرٌ مَ نّ عٍدٌن حَمَ شِلِ مَ،</para>
  <para style="q" vid="ISA 34:5">ﭑ قَ عٍ سْنتْ كِيتِ شَ قٍ رَ.»<verse eid="ISA 34:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 34:6"/>وُلِ نَ عَلَتَلَ شَ سَنتِدّفّمَ مَ.</para>
  <para style="q" vid="ISA 34:6">عَ بَرَ فّ سّرّشّ كْن نَشَبَدٍ عَ رَ،</para>
  <para style="q" vid="ISA 34:6">شُرُ سٍيٍ وُلِ نُن تُرٍ نَ عَ مَ.</para>
  <para style="q" vid="ISA 34:6">عَلَتَلَ نَ سّرّشّ ندٍ كْن نَشَبَقٍ بٌسَرَ،</para>
  <para style="q" vid="ISA 34:6">عَ نَ قَشّ تِقٍ عَ حَاشِ رَ عٍدٌن بْشِ مَ.<verse eid="ISA 34:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 34:7"/>حَمَ سْنتْمَ نّ، سّشّ نِنفٍيٍ نُن تُورَيٍ قَن قَشَ،</para>
  <para style="q" vid="ISA 34:7">هَن بْشِ يَتِ بَرَ نْشْ نَ وُلِ بِرِن نَ.<verse eid="ISA 34:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 34:8"/>عَلَتَلَ شَ نَتّ نَن نَ كِ،</para>
  <para style="q" vid="ISA 34:8">عَلَكٌ سِيٌنِ فبٍ شَ حْشْ عٍدٌن شَ يَشُيَ شَ قٍ رَ.<verse eid="ISA 34:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 34:9"/>عٍدٌن شَ شُرٍيٍ نُن بْشِ لُمَ نّ عَلْ دٌلٍ، عَ قَ لُ فَن نَ.<verse eid="ISA 34:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 34:10"/>عَ مُ شُبٍنمَ كْي نُن يَنيِ رَ،</para>
  <para style="q" vid="ISA 34:10">عَ تُورِ لُمَ نّ تٍ رَ تُن.</para>
  <para style="q" vid="ISA 34:10">مّننِ قِندِ مَ فبٍنفبٍرٍنيِ يِرٍ نَن نَ عَبَدَن،</para>
  <para style="q" vid="ISA 34:10">مِشِ يٌ مُ دَنفِمَ نَا سْنْن.<verse eid="ISA 34:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 34:11"/>شْنِ نُن وُلَءِ سُبٍ مْولِ بِرِن لُمَ نّ نَا.</para>
  <para style="q" vid="ISA 34:11">عَلَتَلَ بَرَ نَتّ تٌنفٌ مّننِ شَ قِندِ فبٍنفبٍرٍن يِرٍ رَ.<verse eid="ISA 34:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 34:12"/>مّننِ مَنفّ مُ سٍسٍ تٌمَ نَا عٍ يَمَرِ مَ رَبَمَ نَشَن شُن نَ،</para>
  <para style="q" vid="ISA 34:12">عٍ شَ كُنتِفِيٍ يٍنسٍنمَ نّ قٍوٌ.<verse eid="ISA 34:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 34:13"/>مّننِ شَ يِرٍ مَكَنتَشِيٍ قِندِ مَ تُنبٍيٍ يِرٍ،</para>
  <para style="q" vid="ISA 34:13">عٍ شَ تَايٍ لُمَ نّ عَلْ وُلَءِ، وُلٍ بَرٍيٍ نُن شْنِيٍ لُمَ دّننَشّ.<verse eid="ISA 34:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 34:14"/>وُلَءِ سُبٍيٍ مْولِ بِرِن سَبَتِمَ نَا،<verse eid="ISA 34:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 34:15"/>بْشِمَسٍ عَ شَلّ سَمَ نّ نَا،</para>
  <para style="q" vid="ISA 34:15">عَ قَ عٍ رَ سّفّ، عَ عٍ كَنتَ.</para>
  <para style="q" vid="ISA 34:15">هَلِ يُبّيٍ سَبَتِمَ مّننِ نّ، عٍ قَ دِيٍ رَ سّفّ.<verse eid="ISA 34:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 34:16"/>عَلَتَلَ شَ سّبّلِ مَتٌ عَ قَنيِ رَ.</para>
  <para style="q" vid="ISA 34:16">يِ سُبٍ بِرِن قَمَ نّ لُدٍ نَا، عٍ قَ وُيَ.</para>
  <para style="q" vid="ISA 34:16">عَلَتَلَ بَرَ نَ نَتّ تٌنفٌ، عَ شَشِلِ يَتِ قَمَ نّ نَ رَكَمَلِدٍ.<verse eid="ISA 34:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 34:17"/>عَ تَن نَن يَتِ عٍ شَ قٍ مَتٌمَ، عَ نَ بْشِ عِتَشُن عٍ رَ،</para>
  <para style="q" vid="ISA 34:17">عَ قَ قِندِ عٍ فبٍ رَ عَبَدَن.<verse eid="ISA 34:17"/></para>
  <chapter eid="ISA 34"/>
  <chapter number="35" style="c" sid="ISA 35"/>
  <para style="s">عَلَ شَ كِرَ</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 35:1"/>حّلّشِنيِ شَ لُ فبٍنفبٍرٍن يِرٍ،</para>
  <para style="q" vid="ISA 35:1">سّيوّ شَ لُ وُلَءِ عَلْ سَنسِ قُفَشِيٍ يِرٍ.<verse eid="ISA 35:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 35:2"/>سَنسِ تٌقَنيِيٍ شَ لُ نَا،</para>
  <para style="q" vid="ISA 35:2">سّيوّ شُي شَ عِتٍ.</para>
  <para style="q" vid="ISA 35:2">عَ شَ لُ عَلْ لِبَن قْتْنيِ، عَ شَ تٌقَن عَلْ كَرٍ مٍلٍ فٍيَ نُن سَرْن يِرٍ.</para>
  <para style="q" vid="ISA 35:2">وٌن مَرِفِ عَلَتَلَ شَ نْرّ تٌمَ نّ نَا عَ قَنيِ رَ.<verse eid="ISA 35:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="ISA 35:3"/>وٌ تَن نَشٍيٍ بَرَ فَاشُ هَن وٌ بّلّشّ مُ سٍ سُشُمَ، وٌ شِنبِ قَ سّرّن،</para>
  <para style="q" vid="ISA 35:3">وٌ سّنبّ شَ سٌ.<verse eid="ISA 35:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 35:4"/>وٌ عَ قَلَ مِشِيٍ بّ نَشٍيٍ بَرَ فَاشُ،</para>
  <para style="q" vid="ISA 35:4">«وٌ شَ لِمَنِيَ، هَلِ وٌ مُ فَاشُ!</para>
  <para style="q" vid="ISA 35:4">وٌ مَرِفِ عَلَ بَرَ قَ وٌ فبٍ حْشْدٍ.</para>
  <para style="q" vid="ISA 35:4">عَ قَمَ وٌ رَكِسِدٍ عَ سّنبّ رَ.»<verse eid="ISA 35:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 35:5"/>نَ تّمُي، دْنشُييٍ يَ رَبْو مَ نّ، تُلِشْرِيٍ قٍ مّمَ نّ.<verse eid="ISA 35:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 35:6"/>مَبّنيِيٍ تُفَنمَ نّ عَلْ شٍلِ، بٌبٌي قَن سّيوّ شُي رَ مِنِمَ نّ،</para>
  <para style="q" vid="ISA 35:6">بَرِ مَ شُرٍيٍ مِنِمَ نّ فبٍنفبٍرٍنيِ مَ.<verse eid="ISA 35:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 35:7"/>بْشِ مَشَرَشِ مَقِندِ مَ نّ بَا رَ،</para>
  <para style="q" vid="ISA 35:7">دُلٌنيِ مِنِمَ نّ فبٍنفبٍرٍن يِرٍ.</para>
  <para style="q" vid="ISA 35:7">وُلَءِ بَرٍيٍ شْنيِ بَرَ قِندِ يٍ يِرٍ رَ.<verse eid="ISA 35:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 35:8"/>كِرَ مَبَمَ نَا نَشَن شِلِ قَلَمَ، «كِرَ سّنِيّنشِ.»</para>
  <para style="q" vid="ISA 35:8">مِشِ سّنِيّنتَرٍ مُ دَنفِمَ مّننِ، قٌ نَشَن لَنمَ عَ شَ دَنفِ نَ.</para>
  <para style="q" vid="ISA 35:8">شَشِلِتَرٍيٍ مُ تِمَ نَ كِرَ شْن مَ.<verse eid="ISA 35:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 35:9"/>يّتّيٍ نُن بُرُنيِ سُبٍ مُ تٌمَ نَا، قٌ لَسِرِ مِشِ.<verse eid="ISA 35:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 35:10"/>عَلَتَلَ نَشٍيٍ شْرّيَشِ، نٍيٍ نَن فبِلٍنمَ عٍ شْنيِ نَ كِرَ شْن مَ.</para>
  <para style="q" vid="ISA 35:10">عٍ سٌمَ نّ سِيٌنِ سّيوّ رَ نَشَن مُ حْنمَ.</para>
  <para style="q" vid="ISA 35:10">عٍ حّلّشِنمَ نّ تُن.</para>
  <para style="q" vid="ISA 35:10">سُننُنيِ نُن تْورّ بَمَ نّ عٍ مَ عَبَدَن.<verse eid="ISA 35:10"/></para>
  <chapter eid="ISA 35"/>
  <chapter number="36" style="c" sid="ISA 36"/>
  <para style="s">عَسِرِيَ مَنفّ شَ مَسٍنيِ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 36:1"/>مَنفّ شٍسٍكِيَ شَ مَنفّيَ حّ قُ نُن نَانِ ندٍ رَ، عَسِرِيَ مَنفّ سٍنَشٍرِبِ نَشَ نْ يُدَيَ تَا سّنبّمَيٍ رَ. <verse eid="ISA 36:1"/><verse number="2" style="v" sid="ISA 36:2"/>عَ تٌ فّ نَ رَبَدٍ، عَسِرِيَ مَنفّ نَشَ عَ شَ سْورِ مَنفّ شّي دَرِ سَلَمُ مَنفّ شْن مَ، كٍلِقٍ رَ لَكِسِ، عَ تَن نُن عَ شَ سْورِ سّنبّمَيٍ. عٍ نَشَ تِ يٍ يِرٍ شُنفبٍ قّ مَ، مِشِيٍ نُ فَرّ سٌمَ دّننَشّ. <verse eid="ISA 36:2"/><verse number="3" style="v" sid="ISA 36:3"/>شِلِكِيَ شَ دِ عٍلِيَكِمِ، مَنفّ شَ بَنشِ شُنيِ، مَنفّ شَ سّبّلِتِ سٍبٍنَ، نُن عَسَقِ شَ دِ يٌوَ، نَشَن قِندِشِ مَنفّ شَ كّيدِ رَفَتّ رَ، نٍيٍ نَشَ مِنِ عَسِرِيَكَيٍ رَلَندٍ.<verse eid="ISA 36:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 36:4"/>عَسِرِيَ مَنفّ رَ سِمَ سِنفٍ نَشَ يِ مَسٍنيِ تِ عٍ بّ، «وٌ عَ قَلَ شٍسٍكِيَ بّ، عَسِرِيَ مَنفّ شُنفبٍ يِ نَن مَسٍنشِ، ‹عِ شَشِلِ تِشِ مُنسٍ رَ؟ <verse eid="ISA 36:4"/><verse number="5" style="v" sid="ISA 36:5"/>عِ وْيّن قُقَقُ نَن تُن قَلَشِ! عِ حْشْ عَ مَ عِ بَرَ قّيرّ نُن سّنبّ سْتْ ﭑ فٍرٍقٍ رَ؟ عِ لَشِ ندٍ رَ، نَشَن عَ نِيَمَ عِ شَ ﭑ مَتَندِ؟ <verse eid="ISA 36:5"/><verse number="6" style="v" sid="ISA 36:6"/>عِ عِ شَ لَنلَنتٍيَ سَشِ مِسِرَكَيٍ نَن مَ قَ؟ عٍ لُشِ عَلْ وُرِ ثٌنثٌي نَشَن فِرَ مَ، عَ قَ عِ سْشْ عِ كِلْنمَ عَ رَ تّمُي نَشّ. مِسِرَ مَنفّ قِرَوُنَ نَ نَ كِ نّ مِشِ بِرِن بّ، نَشٍيٍ عٍ شَشِلِ تِشِ عَ رَ. <verse eid="ISA 36:6"/><verse number="7" style="v" sid="ISA 36:7"/>تّمُندٍ وٌ ﭑ يَابِمَ نّ، «مُشُ شَشِلِ تِشِ مُشُ مَرِفِ عَلَتَلَ نَن نَ.» كْنْ ﭑ شَ عَ قَلَ وٌ بّ شٍسٍكِيَ بَرَ فّ سّرّشّبَدٍيٍ كَنَدٍ فٍيَيٍ قَرِ، عَ قَ عَ قَلَ يُدَيَكَيٍ نُن دَرِ سَلَمُكَيٍ بّ، «وٌ عَلَتَلَ بَتُ دَرِ سَلَمُ شَ سّرّشّبَدٍ فبَنسَن نّ.»›»<verse eid="ISA 36:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 36:8"/>«شَ عِ سَ نْمَ سٌي رَفِ وُلُ قِرِن سْتْدٍ عِ شَ حَمَ يَ مَ، ﭑ مَرِفِ عَسِرِيَ مَنفّ سٌي قِمَ نّ عِ مَ، عٍ نَشٍيٍ رَفِمَ. <verse eid="ISA 36:8"/><verse number="9" style="v" sid="ISA 36:9"/>هَلِ عِ عِ شَشِلِ تِ مِسِرَكَيٍ رَ، سٌي رَفِيٍ نُن فِسٍيٍ شَ قٍ رَ، عِ سّنبّ شُرُن ﭑ مَ مَنفّ شَ مِشِ شُرِ دِ ندٍ نْقٍ رَ. <verse eid="ISA 36:9"/><verse number="10" style="v" sid="ISA 36:10"/>بَقٍ نَ رَ، وٌ مَرِفِ عَلَتَلَ شَ مُ وَشِ ﭑ شَ بٍ فٍرٍ؟ عَلَتَلَ نَن عَ قَلَشِ ﭑ بّ، ‹سِفَ، عِ نَ بْشِ كَنَ.›»<verse eid="ISA 36:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 36:11"/>نَ تّمُي عٍلِيَكِمِ، سٍبٍنَ، نُن يٌوَ نَشَ عَ قَلَ عَسِرِيَ مَنفّ رَ سِمَ بّ، «يَندِ، عِ شَ وْيّن مُشُ بّ عَرَ مِ شُي رَ، مُشُ تَن عِ شَ كٌنيِيٍ نَ شُي قَهَامُمَ. عِ نَشَ وْيّن مُشُ بّ يُدَ شُي رَ حَمَ يَ شْرِ نَشَن نَ تّتّ قَرِ مَ.» <verse eid="ISA 36:11"/><verse number="12" style="v" sid="ISA 36:12"/>كْنْ عَسِرِيَ مَنفّ رَ سِمَ نَشَ عٍ يَابِ، «ﭑ مَرِفِ ﭑ شّيشِ يِ مَسٍنيِ قَلَدٍ عِ شَ مَنفّ نُن عِ تَن نَن فبَنسَن بّ؟ ﭑ مُ وْيّنقٍ يِ مِشِيٍ قَن شَ بّ، نَشٍيٍ دْشْشِ تّتّ قَرِ يِ كِ، نَشٍيٍ قَمَ عٍ يّتّ شَ فبِ قُشِ دٌندٍ نُن عٍ يّتّ شْلِ مِندٍ نُن وٌ تَن نَ؟»<verse eid="ISA 36:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 36:13"/>مَنفّ رَ سِمَ نَشَ كٍلِ، عَ عَ قَلَ عَ شُي عِتٍشِ رَ يُدَيَ شُي رَ، عَ نَشّ، «وٌ وٌ تُلِ مَتِ عَسِرِيَ مَنفّ شُنفبٍ شَ مَسٍنيِ رَ، <verse eid="ISA 36:13"/><verse number="14" style="v" sid="ISA 36:14"/>‹وٌ نَشَ تِن شٍسٍكِيَ شَ وٌ مَدَشُ، بَرِ مَ عَ مُ قَتَ وٌ رَتَنفَدٍ ﭑ بّلّشّ عِ! <verse eid="ISA 36:14"/><verse number="15" style="v" sid="ISA 36:15"/>وٌ نَشَ تِن عَ شَ وٌ مَدَشُ وٌ شَشِلِ تِقٍ عَلَتَلَ رَ، عَ قَلَقٍ رَ، «عَلَتَلَ مُشُ رَكِسِمَ نّ، يِ تَا مُ لُمَ عَسِرِيَكَيٍ شَ مَنفّ سَفٌي.» <verse eid="ISA 36:15"/><verse number="16" style="v" sid="ISA 36:16"/>وٌ نَشَ وٌ تُلِ مَتِ شٍسٍكِيَ رَ دٍ! عَسِرِيَ مَنفّ يِ نَن قَلَشِ، «شَ وٌ تِن لُدٍ ﭑ مَ يَامَرِ بُن مَ، كَنكَن قَمَ نّ عَ شَ شّي بٌفِسٍيٍ دٌندٍ، كَنكَن عَ شَ كْلْنيِ يٍ مِن، <verse eid="ISA 36:16"/><verse number="17" style="v" sid="ISA 36:17"/>هَن ﭑ سَ قَمَ وٌ شَنِندٍ بْشِ ندٍ مَ تّمُي نَشّ، نَشَن لُشِ عَلْ وٌ شَ بْشِ، مّنفِ نُن وّنِ قَنيِ، تَامِ نُن وّنِ شّيٍ نَ دّننَشّ.» <verse eid="ISA 36:17"/><verse number="18" style="v" sid="ISA 36:18"/>وٌ نَشَ وٌ تُلِ مَتِ شٍسٍكِيَ رَ، نَشَن وَ مَ وٌ مَدَشُقٍ عَ قَلَقٍ رَ، «مَرِفِ عَلَتَلَ وٌن نَكِسِمَ نّ.» سِ فبّتّيٍ شَ عَلَيٍ نْ نّ عٍ شَ مِشِيٍ بَدٍ عَسِرِيَ مَنفّ بّلّشّ عِ؟ <verse eid="ISA 36:18"/><verse number="19" style="v" sid="ISA 36:19"/>شَمَتَ نُن عَرَثَدِ شَ عَلَيٍ فٌ؟ سٍقَرَوَيِمِ، هٍنَ نُن عِوَ شَ عَلَيٍ فٌ؟ نٍيٍ بَرَ سَمَرِ بَ ﭑ بّلّشّ عِ؟ <verse eid="ISA 36:19"/><verse number="20" style="v" sid="ISA 36:20"/>حَمَنّيٍ بِرِن شَ عَلَيٍ يَ مَ، عَلَ مُندُن عَ شَ مِشِيٍ رَكِسِشِ ﭑ بّلّشّ عِ؟ عَلَتَلَ تَن نْمَ دَرِ سَلَمُ رَتَنفَدٍ ﭑ مَ؟›»<verse eid="ISA 36:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 36:21"/>حَمَ نَشَ دُندُ، عٍ مُ عَ يَابِ، بَرِ مَ مَنفّ عَ قَلَ نّ، «وٌ نَشَ عَ يَابِ دٍ.» <verse eid="ISA 36:21"/><verse number="22" style="v" sid="ISA 36:22"/>شِلِكِيَ شَ دِ عٍلِيَكِمِ، مَنفّ شَ بَنشِ شُنيِ، سٍبٍنَ سّبّلِتِ، نُن عَسَقِ شَ دِ يٌوَ كّيدِ رَفَتّ، نٍيٍ نَشَ سِفَ مَنفّ شٍسٍكِيَ يِرٍ عٍ شَ سٌسٍيٍ عِبْوشِ رَ عٍ مَ سُننُنيِ كُي، عٍ قَ عَسِرِيَ مَنفّ رَ سِمَ شَ مَسٍنيِ دّنتّفّ عَ بّ.<verse eid="ISA 36:22"/></para>
  <chapter eid="ISA 36"/>
  <chapter number="37" style="c" sid="ISA 37"/>
  <para style="s">مَنفّ شٍسٍكِيَ مَرَ سِ قٍنقٍ عَننَبِ عٍسَيِ رَ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 37:1"/>مَنفّ شٍسٍكِيَ تٌ نَ قٍ مّ، عَ نَشَ عَ شَ دٌنمَ عِبْو عَ مَ، عَ بّكِ دُفِ رَفٌرٌ عَ مَ سُننُنيِ كُي، عَ قَ سِفَ عَلَتَلَ شَ بَنشِ كُي. <verse eid="ISA 37:1"/><verse number="2" style="v" sid="ISA 37:2"/>عَ نَشَ عَ شَ بَنشِ شُنيِ عٍلِيَكِمِ، عَ شَ سّبّلِتِ سٍبٍنَ، نُن سّرّشّدُبّ قٌرِيٍ شّي عَمٌسُ شَ دِ عَننَبِ عٍسَيِ شْن، بّكِ دُفِ رَفٌرٌشِ عٍ مَ. <verse eid="ISA 37:2"/><verse number="3" style="v" sid="ISA 37:3"/>عٍ نَشَ عَ قَلَ عَ بّ، شٍسٍكِيَ يِ نَن قَلَشِ، «تٌ قِندِشِ سُننُنيِ، حَشَنكَتّ، نُن بْحّ مَحَاشُ لْشْي نَن نَ. عَ لُشِ عَلْ دِيٍ بَرِ تّمُي بَرَ عَ لِ، كْنْ سّنبّ مُ نَ سْنْن عٍ شَ بَرِ. <verse eid="ISA 37:3"/><verse number="4" style="v" sid="ISA 37:4"/>عِ مَرِفِ عَلَتَلَ نَ عَسِرِيَ مَنفّ شَ شّيرَ شَ مَسٍنيِ مّ عَلَ حِحّ رَ سْتْقٍ رَ، تّمُندٍ عَ عَ حَشَنكَتَمَ نّ عَ شَ نَ وْيّنيِيٍ مَ. عِ شَ عَلَ مَشَندِ عَلَكٌ وٌن مَ مِشِ دْنشْييٍ نَشَ قَشَ.»<verse eid="ISA 37:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 37:5"/>مَنفّ شٍسٍكِيَ شَ مِشِيٍ نَشَ سِفَ عَننَبِ عٍسَيِ يِرٍ. <verse eid="ISA 37:5"/><verse number="6" style="v" sid="ISA 37:6"/>عٍسَيِ نَشَ عَ مَسٍن عٍ بّ، «وٌ عَ قَلَ وٌ شَ مَنفّ بّ، عَلَتَلَ يِ مَسٍنيِ نَن تِشِ، ‹عِ نَشَ فَاشُ عَسِرِيَ مَنفّ شَ شّيرَيٍ شَ مَرَ سْتْييٍ شَ قٍ رَ، عَ نَشٍيٍ قَلَشِ ﭑ بّ. <verse eid="ISA 37:6"/><verse number="7" style="v" sid="ISA 37:7"/>ﭑ قَمَ عَ شَشِلِ مَقِندِدٍ شِبَارُي ندٍ رَ، عَ قَ فبِلٍن عَ شْنيِ. ﭑ عَ قَشَمَ سَنتِدّفّمَ رَ مّننِ نّ.›»<verse eid="ISA 37:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 37:8"/>مَنفّ شَ شّيرَ تٌ فبِلٍن عَسِرِيَ مَنفّ يِرٍ، عَ نَشَ عَ لِ عَ شَ مَنفّ نُ بَرَ كٍلِ لَكِسِ، عَ نُ نَ لِبِنَ فٍرٍقٍ. <verse eid="ISA 37:8"/><verse number="9" style="v" sid="ISA 37:9"/>نَ تّمُي عَسِرِيَ مَنفّ نَشَ عَ كٌلٌن عَ كُسِ مَنفّ تِرِهَكَ نَ قَقٍ عَ فٍرٍدٍ. نَ كُي عَ مَن نَشَ شّيرَيٍ شّي شٍسٍكِيَ مَ، عَ قَلَقٍ رَ، <verse eid="ISA 37:9"/><verse number="10" style="v" sid="ISA 37:10"/>«وٌ عَ قَلَ يُدَيَ مَنفّ شٍسٍكِيَ بّ، ‹عِ شَ عَلَ، عِ لَشِ نَشَن نَ، نَ نَشَ عِ مَدَشُ دٍ عَ قَلَقٍ رَ، «دَرِ سَلَمُ مُ لُمَ عَسِرِيَ مَنفّ بّلّشّ عِ.» <verse eid="ISA 37:10"/><verse number="11" style="v" sid="ISA 37:11"/>عِ عَ كٌلٌن عَ قَنيِ رَ عَسِرِيَ مَنفّيٍ نَشَن نَبَشِ حَمَنّيٍ بِرِن نَ. عٍ عٍ سْنتْ نّ عَ حَاشِ رَ. عِ تَن قَ قَمَ عِ بَدٍ ﭑ يِ رَ دِ؟ <verse eid="ISA 37:11"/><verse number="12" style="v" sid="ISA 37:12"/>ﭑ بٍنبَيٍ سِ نَشٍيٍ بْنبْ، عٍ شَ عَلَيٍ عٍ رَتَنفَ نّ، عَلْ فٌسَن، شَرَنِ، رٍ سٍقَ، نُن عٍدٍن بْنسْي نَشٍيٍ نَ تٍلِ عَسَرِ؟ <verse eid="ISA 37:12"/><verse number="13" style="v" sid="ISA 37:13"/>شَمَتَ مَنفّ، عَرَثَدِ مَنفّ، سٍقَرَوَيِمِ مَنفّ، هٍنَ مَنفّ، نُن عِوَ مَنفّ نَ مِندٍن؟›»<verse eid="ISA 37:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 37:14"/>شٍسٍكِيَ نَشَ بَتَاشّ رَ سُشُ شّيرَيٍ يِ رَ، عَ نَشَ عَ شَرَن. نَ دَنفِ شَنبِ، عَ نَشَ تٍ عَلَتَلَ شَ بَنشِ، عَ عَ عِتَلَ عَلَتَلَ يَ عِ. <verse eid="ISA 37:14"/><verse number="15" style="v" sid="ISA 37:15"/>شٍسٍكِيَ نَشَ عَلَتَلَ مَشَندِ، عَ نَشّ، <verse eid="ISA 37:15"/><verse number="16" style="v" sid="ISA 37:16"/>«عِسِرَيِلَ مَرِفِ عَلَتَلَ، نَشَن مَفٌرٌشِ مَلٍكّيٍ تَفِ، عِ تَن نَن نَ دُنِحَ بِرِن مَرِفِ رَ، عِ تَن نَن كٌورٍ نُن بْشِ دَاشِ. <verse eid="ISA 37:16"/><verse number="17" style="v" sid="ISA 37:17"/>عَلَتَلَ، عِ عِ تُلِ مَتِ عَ قَنيِ رَ، عِ شَ سٍنَشٍرِبِ شَ مَسٍنيِ رَ مّ، نَشَن عَ شَ مِشِ شّيشِ عَلَ حِحّ رَ سْتْدٍ. <verse eid="ISA 37:17"/><verse number="18" style="v" sid="ISA 37:18"/>عَلَتَلَ، نْندِ نَ عَ رَ، عَسِرِيَ مَنفّيٍ بَرَ سِ بِرِن سْنتْ، عَ عٍ شَ قٍ شُن نَكَنَ. <verse eid="ISA 37:18"/><verse number="19" style="v" sid="ISA 37:19"/>عٍ نَشَ نٍيٍ شَ عَلَيٍ وٌلِ تّ عِ، عٍ عٍ كَنَ. عَ نْندِ كِ مَ، نَ كُيٍيٍ مُ قِندِشِ عَلَ رَ، بَرِ مَ عِبُنَدَ مَ نَن نٍيٍ يَءِلَنشِ وُرِ نُن فّمّ رَ. <verse eid="ISA 37:19"/><verse number="20" style="v" sid="ISA 37:20"/>يَندِ، مُشُ مَرِفِ عَلَتَلَ، عِ شَ مُشُ رَتَنفَ سٍنَشٍرِبِ مَ، عَلَكٌ دُنِحَ بِرِن شَ عَ كٌلٌن، عَ عِ تَن نَن كٍرٍن نَ عَلَ رَ.»<verse eid="ISA 37:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 37:21"/>عَوَ، عَمٌسُ شَ دِ عَننَبِ عٍسَيِ نَشَ شّيرَ شّي مَنفّ شٍسٍكِيَ مَ، عَ نَشّ، «عِسِرَيِلَ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ، ‹ﭑ بَرَ عِ شَ مَشَندِ سُشُ عِ نَشَن تِشِ عَسِرِيَ مَنفّ سٍنَشٍرِبِ شَ قٍ رَ. <verse eid="ISA 37:21"/><verse number="22" style="v" sid="ISA 37:22"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ عَ شِلِ مَ،</para>
  <para style="q" vid="ISA 37:22">سِيٌنِ تَا قَمَ نّ يٌدٍ عِ مَ،</para>
  <para style="q" vid="ISA 37:22">دَرِ سَلَمُ تٌقَنيِ قَ عِ مَبٍرٍدٍ.<verse eid="ISA 37:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 37:23"/>عِ ندٍ كٌنبِشِ، عِ ندٍ مَبٍرٍشِ؟</para>
  <para style="q" vid="ISA 37:23">عِ سْنشْشِ ندٍ مَ؟</para>
  <para style="q" vid="ISA 37:23">عِ بَرَ عِ يّتّ عِفبٌ عِسِرَيِلَ سّنِيّنتْي مَ.<verse eid="ISA 37:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="ISA 37:24"/>عِ شَ شّيرَيٍ بَرَ مَرِفِ رَ سْتْ.</para>
  <para style="q" vid="ISA 37:24">عِ بَرَ عَ قَلَ، «ﭑ تَن بَرَ تٍ هَن لِبَن فٍيَيٍ قَرِ</para>
  <para style="q" vid="ISA 37:24">ﭑ مَ فِسٍيٍ كُي.</para>
  <para style="q" vid="ISA 37:24">ﭑ سّدِرِ وُرِ عِتٍشِيٍ قْن،</para>
  <para style="q" vid="ISA 37:24">ﭑ سِثِرّ وُرِ تٌقَنيِيٍ سّفّ قْتْنيِ دّحّشِ كُي.<verse eid="ISA 37:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="ISA 37:25"/>ﭑ تِفِيٍ فٍ حَمَنّيٍ مَ، ﭑ عٍ يٍ مِن.</para>
  <para style="q" vid="ISA 37:25">ﭑ نِلِ شُرٍ سّنكِنّيٍ بِرِن شْرِ مَ نّ ﭑ سَنيِيٍ رَ.»›»<verse eid="ISA 37:25"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="26" style="v" sid="ISA 37:26"/>عَلَتَلَ نَشّ، «عِ مُ عَ مّشِ بَ،</para>
  <para style="q" vid="ISA 37:26">ﭑ بَرَ يِ قٍيٍ نَتّ نُ عَ رَكُيَ،</para>
  <para style="q" vid="ISA 37:26">كَقِ ﭑ عِ دَا تّمُي؟</para>
  <para style="q" vid="ISA 37:26">ﭑ قَ نَ عٍ رَبَقٍ نّ.</para>
  <para style="q" vid="ISA 37:26">عِ تَن قِندِشِ تَا سّنبّمَيٍ سْنتْمَ نَن تُن نَ،<verse eid="ISA 37:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="ISA 37:27"/>نَ تَا مِشِيٍ سّنبّ مُ نَ عٍ شَ تِ وٌ كَنكٍ.</para>
  <para style="q" vid="ISA 37:27">فَاشُي نُن يَافِ نَن تُن عٍ سْتْمَ.</para>
  <para style="q" vid="ISA 37:27">عٍ لُمَ نّ عَلْ حٌوفٍ شَرٍ، عَلْ سّشّ نَشَن نَ بَنشِ كْن نَ،</para>
  <para style="q" vid="ISA 37:27">عَلْ مّنفِ بِلِ نَشَن شَرَ مَ بٍينُن عَ شَ بٌفِ.<verse eid="ISA 37:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="ISA 37:28"/>كْنْ ﭑ عِ دْشْ تّمُي، عِ مِنِ تّمُي سِفَقٍ رَ فٍرٍ سٌدٍ، عِ قَ تّمُي، ﭑ نَ بِرِن كٌلٌن.</para>
  <para style="q" vid="ISA 37:28">عِ مَن نَ ﭑ مَتَندِ، ﭑ نَ قَن كٌلٌن.<verse eid="ISA 37:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="ISA 37:29"/>عِ تٌ بَرَ ﭑ مَتَندِ نَ كِ، عِ عِ يّتّ عِفبٌ ﭑ مَ،</para>
  <para style="q" vid="ISA 37:29">ﭑ نَ ﭑ مَ شُرُندّ فبَكُمَ نّ عِ حْي رَ،</para>
  <para style="q" vid="ISA 37:29">ﭑ نَ ﭑ مَ كَرَقٌي سْتِ عِ دّ كُي،</para>
  <para style="q" vid="ISA 37:29">ﭑ عِ رَفبِلٍن عِ كٍلِدٍ.»<verse eid="ISA 37:29"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="30" style="v" sid="ISA 37:30"/>عَلَتَلَ نَشّ، «شٍسٍكِيَ، تْنشُمَ نَن يَ عِ بّ؛</para>
  <para style="q" vid="ISA 37:30">تٌوقَرٍ وٌ سَنسِ شْرِ يٌلٌنشِ نَن دٌنمَ.</para>
  <para style="q" vid="ISA 37:30">تَمُنَ وٌ سَنسِ بَلِ نَن دٌنمَ.</para>
  <para style="q" vid="ISA 37:30">كْنْ تَمُنَ بٌورٍ، وٌ سَنسِيٍ نَن دٌنمَ وٌ نَشٍيٍ سِمَ وٌ عٍ شَبَ،</para>
  <para style="q" vid="ISA 37:30">وٌ وّنِ مِن نَشَن كٍلِمَ وّنِ بِلِيٍ مَ، وٌ نَشٍيٍ سِمَ.<verse eid="ISA 37:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="ISA 37:31"/>يُدَ بْنسْييٍ نَشٍيٍ كِسِمَ،</para>
  <para style="q" vid="ISA 37:31">نٍيٍ لُمَ نّ عَلْ وُرِ بِلِ</para>
  <para style="q" vid="ISA 37:31">نَشَن سَنكٍ نَ بْشِ بُن مَ،</para>
  <para style="q" vid="ISA 37:31">عَ قَ عَ بٌفِ رَ مِنِ.<verse eid="ISA 37:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="ISA 37:32"/>بَرِ مَ مِشِ ندٍيٍ رَتَنفَمَ نّ قَشّ مَ دَرِ سَلَمُ،</para>
  <para style="q" vid="ISA 37:32">سِيٌنِ مِشِ ندٍيٍ كِسِمَ نّ.</para>
  <para style="q" vid="ISA 37:32">عَلَتَلَ سّنبّمَ عَ مَقُرَ مَ نّ نَ بِرِن نَبَدٍ.»<verse eid="ISA 37:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="ISA 37:33"/>نَ كُي، عَلَتَلَ يِ مَسٍنيِ نَن تِشِ عَسِرِيَ مَنفّ شَ قٍ رَ،</para>
  <para style="q" vid="ISA 37:33">«عَ مُ سٌمَ يِ تَا كُي،</para>
  <para style="q" vid="ISA 37:33">عَ مُ شَلِ يٌ وٌلِمَ بٍ،</para>
  <para style="q" vid="ISA 37:33">عَ مُ تِمَ وٌ كَنكٍ عَ شَ وُرٍ لٍقَ رَ،</para>
  <para style="q" vid="ISA 37:33">عَ مُ بّندّ مَتٍمَ تُفَنقٍ رَ وٌ شَ تّتّ رَ.<verse eid="ISA 37:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="ISA 37:34"/>عَ فبِلٍنمَ عَ قَ كِرَ نَن نَ،</para>
  <para style="q" vid="ISA 37:34">عَ مُ سٌمَ يِ تَا كُي!</para>
  <para style="q" vid="ISA 37:34">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="ISA 37:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="ISA 37:35"/>ﭑ يِ تَا مَكَنتَمَ نّ،</para>
  <para style="q" vid="ISA 37:35">ﭑ عَ رَكِسِمَ نّ ﭑ شِلِ نُن ﭑ مَ كٌنيِ دَوُدَ شَ قٍ رَ.»<verse eid="ISA 37:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ISA 37:36"/>نَ كْي رَ عَلَتَلَ شَ مَلٍكّ نَشَ مِنِ، عَ سَ عَسِرِيَكَ وُلُ كّمّ تٌنفٌ سٌلٌمَسَشَن نُن سُولِ قَشَ. عَ دْنشْييٍ تٌ كٍلِ فّيسّفّ، عٍ نَشَ نَ قُرٍيٍ تٌ عٍ يَ مَ. <verse eid="ISA 37:36"/><verse number="37" style="v" sid="ISA 37:37"/>نَ كُي، عَسِرِيَ مَنفّ سٍنَشٍرِبِ نَشَ فبِلٍن عَ شْنيِ نِنٍوٍ. <verse eid="ISA 37:37"/><verse number="38" style="v" sid="ISA 37:38"/>لْشْي ندٍ، عَ تٌ نُ نَ سَلِقٍ عَ شَ عَلَ نِسِرِ شَ بَنشِ كُي، عَدَرَ مٍلٍكِ نُن سَرٍ سٍرِ نَشَ عَ قَشَ سَنتِدّفّمَ رَ، عٍ عٍ فِ عَرَرَتِ بْشِ مَ. عٍسَرِشَدٌنِ نَشَ تِ مَنفّ رَ عَ بَبَ سٍنَشٍرِبِ حْشْي رَ.<verse eid="ISA 37:38"/></para>
  <chapter eid="ISA 37"/>
  <chapter number="38" style="c" sid="ISA 38"/>
  <para style="s">شٍسٍكِيَ شَ يَلَنيِ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 38:1"/>نَ لْشْييٍ مَنفّ شٍسٍكِيَ نَشَ قُرَ عَ حَاشِ رَ. عَ فبٍ مُ نُ لُشِ عَ شَ قَشَ. عَمٌسُ شَ دِ عَننَبِ عٍسَيِ نَشَ سِفَ عَ يِرٍ، عَ عَ قَلَ عَ بّ، عَلَتَلَ يِ نَن مَسٍنشِ، «عِ شَ يَامَرِيٍ قِ عِ شَ مِشِيٍ مَ، بَرِ مَ عِ نَ قَشَقٍ نّ يِ كِ، عِ مُ كِسِمَ يِ قُرٍ مَ.» <verse eid="ISA 38:1"/><verse number="2" style="v" sid="ISA 38:2"/>شٍسٍكِيَ نَشَ عَ يَتَفِ مَقِندِ بَنشِ شَلّ مَ، عَ عَلَتَلَ مَشَندِ، عَ نَشّ، <verse eid="ISA 38:2"/><verse number="3" style="v" sid="ISA 38:3"/>«عَلَتَلَ، يَندِ هِننّ ﭑ نَ، عِ عَ كٌلٌن ﭑ نَن حّرّشِ نّ كِرَ تِنشِنشِ نَن شْن مَ ﭑ مَ دُنِحّءِفِرِ كُي ﭑ بْحّ قِيشّ رَ. ﭑ مُ عِ مَتَندِ، ﭑ مُ فبِلٍن عِ وَشْنقٍ قْشْ رَ.» شٍسٍكِيَ نَشَ وَ كِ قَنيِ رَ.<verse eid="ISA 38:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 38:4"/>عَننَبِ عٍسَيِ مُ نُ فّشِ مِنِدٍ مَنفّ بَنشِ تّتّ كُي، عَلَتَلَ مَن نَشَ عَ مَسٍن عَ بّ، عَ نَشّ، <verse eid="ISA 38:4"/><verse number="5" style="v" sid="ISA 38:5"/>«فبِلٍن عِ شَ سَ عَ قَلَ ﭑ مَ حَمَ يَرٍرَتِ شٍسٍكِيَ بّ، عِ بٍنبَ دَوُدَ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ، ‹ﭑ بَرَ عِ شَ مَشَندِ مّ، ﭑ بَرَ عِ يَيٍ تٌ. ﭑ عِ يَلَنمَ نّ، عَ شِ سَشَن ندٍ. ﭑ حّ قُ نُن سُولِ سَمَ نّ عِ شَ سِمَيَ شُن مَ. <verse eid="ISA 38:5"/><verse number="6" style="v" sid="ISA 38:6"/>ﭑ عِ تَن نُن يِ تَا رَتَنفَمَ نّ عَسِرِيَ مَنفّ مَ. ﭑ يِ تَا مَكَنتَمَ نّ ﭑ مَ كٌنيِ دَوُدَ شَ قٍ رَ.›»<verse eid="ISA 38:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 38:7"/>عَننَبِ عٍسَيِ نَشَ عَ يَابِ، «يِ نَن قِندِ مَ عَلَتَلَ شَ تْنشُمَ رَ عِ بّ، عَلَكٌ عِ شَ عَ كٌلٌن عَ عَلَتَلَ عَ شَ مَسٍنيِ رَكَمَلِمَ نّ. <verse eid="ISA 38:7"/><verse number="8" style="v" sid="ISA 38:8"/>عَلَ نَشّ، ‹ﭑ عَ نِيَمَ نّ سٌفٍ نِينِ شَ فبِلٍن عَ شَنبِ شَنبِ مَ دْشْ قُ عَشَسِ تٍدٍ مَ.›» نَ تّمُي، سٌفٍ نِينِ نَشَ مَفبِلٍن عَ شَنبِ شَنبِ مَ دْشْ قُ عَ فٌرٌشِ كِ نَشّ.<verse eid="ISA 38:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 38:9"/>يُدَيَ مَنفّ شٍسٍكِيَ شَ بّيتِ نَن يَ، عَ نَشَن سّبّشِ عَ تٌ يَلَن عَ شَ قُرٍ مَ؛<verse eid="ISA 38:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 38:10"/>ﭑ نُ عَ قَلَ نّ نُ،</para>
  <para style="q" vid="ISA 38:10">«عَ لَنمَ ﭑ شَ لَاشِرَ يِ وَشَتِ قَنيِ ﭑ مَ دُنِحّءِفِرِ كُي؟</para>
  <para style="q" vid="ISA 38:10">ﭑ مَ سِمَيَ شَ دُنكٍ نَ كِ؟»<verse eid="ISA 38:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 38:11"/>ﭑ مَن نُ عَ قَلَ نّ نُ،</para>
  <para style="q" vid="ISA 38:11">«ﭑ مُ عَلَتَلَ تٌمَ يِ دُنِحَ مَ سْنْن،</para>
  <para style="q" vid="ISA 38:11">ﭑ مَن مُ عِبُنَدَ مَ يٌ تٌمَ قَ نَشَن سَبَتِشِ يِ بّندّ قُحِ قَرِ.<verse eid="ISA 38:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 38:12"/>ﭑ مَ لِنفِرَ بَرَ تٌنفٌ ﭑ شُن،</para>
  <para style="q" vid="ISA 38:12">عَلْ شُرُ سٍ كَنتّ شَ لٍيلٍ عِتَلَمَ كِ نَشّ.</para>
  <para style="q" vid="ISA 38:12">ﭑ مَ سِمَيَ نَ مَقِلِنقٍ عَلْ مَبْي شَ فّسّ.</para>
  <para style="q" vid="ISA 38:12">مَبْي نَ فّ فّسّ سْشْدٍ، عَ دْنشْي نَشَن لُشِ، عَ نَ شَبَ.</para>
  <para style="q" vid="ISA 38:12">عَلَتَلَ، عِ تَن قَن، بٍينُن نُنمَرٍ شَ سٌ، عِ بَرَ ﭑ مَ سِمَيَ رَحْن.<verse eid="ISA 38:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 38:13"/>ﭑ نَشَ مَمّ تِ هَن فّيسّفّ،</para>
  <para style="q" vid="ISA 38:13">كْنْ عِ بَرَ ﭑ شْرِيٍ عِفِرَ عَلْ يّتّ عَ رَبَمَ كِ نَشّ.</para>
  <para style="q" vid="ISA 38:13">بٍينُن كْي شَ سٌ، عِ بَرَ دَن تِ ﭑ مَ سِمَيَ مَ.<verse eid="ISA 38:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 38:14"/>ﭑ نُ ﭑ شُي شُرُدِ رَ مِنِمَ نّ عَلْ دٍبٍلِن شْنِ،</para>
  <para style="q" vid="ISA 38:14">ﭑ نُ وَ مَ نّ عَلْ فَنبّ سُننُنشِ.</para>
  <para style="q" vid="ISA 38:14">ﭑ نُ ﭑ يَ رَتٍ كٌورٍ مَ، ﭑ نُ قَ عَ قَلَ،</para>
  <para style="q" vid="ISA 38:14">‹ﭑ مَرِفِ ﭑ نَ تْورْقٍ، عِ شَ ﭑ مَلِ.›»<verse eid="ISA 38:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="ISA 38:15"/>«ﭑ نْمَ نَ تَفِ رَبَدٍ دِ؟</para>
  <para style="q" vid="ISA 38:15">عَ تَن يَتِ بَرَ ﭑ يَابِ، عَ قَ ﭑ مَ دُبَ سُشُ.</para>
  <para style="q" vid="ISA 38:15">نَ كُي ﭑ قَمَ ﭑ حّرّدٍ يّتّ مَفٌرٍ نَن كُي ﭑ مَ سِمَيَ بِرِن نَ.<verse eid="ISA 38:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 38:16"/>ﭑ مَرِفِ، عِبُنَدَ مَ كِسِمَ نَ كِ نّ.</para>
  <para style="q" vid="ISA 38:16">ﭑ حّنفِقٍ تٌ نَ نَن مَ.»</para>
  <para style="b" vid="ISA 38:16"/>
  <para style="q" vid="ISA 38:16">«عِ تَن بَرَ ﭑ مَ يَلَنيِ رَفبِلٍن ﭑ مَ، ﭑ شَ كِسِ.<verse eid="ISA 38:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 38:17"/>عِ بَرَ ﭑ مَلِ نَ تْورّ كُي.</para>
  <para style="q" vid="ISA 38:17">عِ شَ شَنُنتٍيَ بَرَ ﭑ نَتَنفَ قَشّ مَ،</para>
  <para style="q" vid="ISA 38:17">عِ بَرَ ﭑ مَ يُنُبِيٍ بِرِن وٌلِ عِ كٌبٍ رَ.<verse eid="ISA 38:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 38:18"/>عِ عَ كٌلٌن عَ ﭑ مَ فَبُرِ مُ قِندِ مَ مَتْشْي رَ عِ بّ،</para>
  <para style="q" vid="ISA 38:18">سَيَ مُ عِ مَتْشْمَ،</para>
  <para style="q" vid="ISA 38:18">قَشَ مِشِيٍ قَن مُ عِ تَنتُمَ بّيتِ رَ.</para>
  <para style="q" vid="ISA 38:18">نَشٍيٍ فٌرٌ مَ فَبُرِ كُي، نٍيٍ شَشِلِ مُ تِشِ عِ شَ هِننّ رَ سْنْن.<verse eid="ISA 38:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 38:19"/>مِشِ حِحّ نَن عِ مَتْشْمَ، عَلْ ﭑ نَ عِ مَتْشْقٍ كِ نَشّ تٌ لْشْي.</para>
  <para style="q" vid="ISA 38:19">بَبَيٍ مَسٍنيِ تِمَ عٍ شَ دِيٍ بّ عِ شَ هِننّ شَ قٍ رَ.»<verse eid="ISA 38:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="ISA 38:20"/>عَلَتَلَ بَرَ ﭑ نَكِسِ.</para>
  <para style="q" vid="ISA 38:20">وٌن شَ بّيتِ بَ عَ بّ كْرَيٍ رَ عَ شَ هْرْ مْبَنشِ كُي.</para>
  <para style="q" vid="ISA 38:20">وٌن شَ لُ نَ رَبَ رَ وٌن مَ سِمَيَ بِرِن نَ.<verse eid="ISA 38:20"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="21" style="v" sid="ISA 38:21"/>عَننَبِ عٍسَيِ نُ بَرَ عَ قَلَ، عَ عٍ شَ قَ شْرّ بٌفِ يَءِلَن، عٍ عَ قَتُ مَنفّ شٍسٍكِيَ شَ قِ مَ، عَلَكٌ عَ شَ يَلَن. <verse eid="ISA 38:21"/><verse number="22" style="v" sid="ISA 38:22"/>شٍسٍكِيَ نُ بَرَ عَ يَابِ، «تْنشُمَ مُندُن عَ نِيَمَ ﭑ شَ عَ كٌلٌن ﭑ مَن نْمَ تٍدٍ عَلَتَلَ شَ هْرْ مْبَنشِ؟»<verse eid="ISA 38:22"/></para>
  <chapter eid="ISA 38"/>
  <chapter number="39" style="c" sid="ISA 39"/>
  <para style="s">شٍسٍكِيَ بَبِلْن مَنفّ شَ شّيرَيٍ رَ سّنّقٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 39:1"/>نَ تّمُي بَبِلْن مَنفّ مٍرٌدَكِ بَلَدَن نَشَ بَتَاشّ نُن بُحَ رَ سَنبَ شٍسٍكِيَ مَ، بَرِ مَ عَ نُ بَرَ شٍسٍكِيَ قُرَقٍ نُن عَ يَلَنقٍ مّ. <verse eid="ISA 39:1"/><verse number="2" style="v" sid="ISA 39:2"/>شٍسٍكِيَ نَشَ نَ شّيرَيٍ رَ سّنّ، عَ عَ شَ نَاقُلِ بِرِن مَسٍن عٍ بّ، عَلْ فبٍتِ، شّيمَ، سُرَيِ، لَبُندّ نُن تُرٍ شِرِ حْشُنمّ، عَ شَ فٍرٍ سٌسٍ رَفَتَدٍ نُن عَ شَ بَننَيَ بِرِن نَ دّننَشّ. سٍسٍ مُ لُ، شٍسٍكِيَ مُ نَشَن مَسٍن عٍ بّ عَ شَ بَنشِ نُن عَ شَ بْشِ كُي. <verse eid="ISA 39:2"/><verse number="3" style="v" sid="ISA 39:3"/>نَ دَنفِ شَنبِ، عَننَبِ عٍسَيِ نَشَ قَ شٍسٍكِيَ يِرٍ، عَ عَ مَشْرِن، «نَ مِشِيٍ مُنسٍ قَلَشِ عِ بّ؟ عٍ كٍلِشِ مِندٍن؟» شٍسٍكِيَ نَشَ عَ يَابِ، «عٍ كٍلِشِ بْشِ مَكُيٍ ندٍ نّ، دّننَشّ شِلِ بَبِلْن.» <verse eid="ISA 39:3"/><verse number="4" style="v" sid="ISA 39:4"/>عٍسَيِ مَن نَشَ عَ مَشْرِن، «عٍ مُنسٍ مَتٌشِ عِ شَ بَنشِ كُي؟» شٍسٍكِيَ نَشَ عَ يَابِ، «سٍ نَشَن بِرِن نَ ﭑ مَ بَنشِ كُي. سٍسٍ مُ لُشِ ﭑ شْنيِ ﭑ مُ نَشَن مَسٍنشِ عٍ بّ.»<verse eid="ISA 39:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 39:5"/>نَ كُي، عَننَبِ عٍسَيِ نَشَ عَ قَلَ شٍسٍكِيَ بّ، «عِ تُلِ مَتِ عَلَتَلَ شَ مَسٍنيِ رَ، <verse eid="ISA 39:5"/><verse number="6" style="v" sid="ISA 39:6"/>‹لْشْي نَ قَقٍ، يِ مِشِيٍ قَمَ نّ عِ هَرِفٍ بِرِن شَنِندٍ بَبِلْن، عِ بٍنبَيٍ نَشَن لُشِ عِ يِ رَ. عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ. <verse eid="ISA 39:6"/><verse number="7" style="v" sid="ISA 39:7"/>عٍ قَمَ نّ عِ شَ دِيٍ سُشُدٍ، عِ نَشٍيٍ بَرِشِ، عٍ عٍ بَنَ بَبِلْن مَنفّ بّ.›» <verse eid="ISA 39:7"/><verse number="8" style="v" sid="ISA 39:8"/>شٍسٍكِيَ نَشَ عَ قَلَ عٍسَيِ بّ، «عَلَتَلَ شَ مَسٍنيِ عِ نَشَن تِشِ، عَ قَن.» عَ نَ قَلَ نّ بَرِ مَ عَ نَشّ، «بْحّسَ نُن كَنتَرِ تَن لُمَ نّ بٍ، ﭑ مَ سِمَيَ بِرِن كُي.»<verse eid="ISA 39:8"/></para>
  <chapter eid="ISA 39"/>
  <chapter number="40" style="c" sid="ISA 40"/>
  <para style="s">عَلَ عَ شَ حَمَ شُنسَرَقٍ</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 40:1"/>عَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="ISA 40:1">«وٌ شَ ﭑ مَ حَمَ مَدُندُ عٍ شَ تْورّ كُي.<verse eid="ISA 40:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 40:2"/>وٌ شَ عَ قَلَ دَرِ سَلَمُ بّ عَ عَ شَ حَشَنكَتّ بَرَ حْن،</para>
  <para style="q" vid="ISA 40:2">عَ شَ يُنُبِيٍ سَرٍ بَرَ فّ قِدٍ،</para>
  <para style="q" vid="ISA 40:2">عَ عَلَتَلَ بَرَ نَ رَفبِلٍن عَ مَ هَن دْشْ قِرِن.»<verse eid="ISA 40:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="ISA 40:3"/>مِشِ ندٍ نَ عَ شُي رَ مِنِقٍ فبٍنفبٍرٍن يِرٍ عَ قَلَقٍ رَ،</para>
  <para style="q" vid="ISA 40:3">«وٌ شَ كِرَ يَءِلَن عَلَتَلَ بّ،</para>
  <para style="q" vid="ISA 40:3">وٌ سَنكِرَ مَتِنشِن وٌ مَرِفِ يَ رَ.<verse eid="ISA 40:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 40:4"/>فُلُنبَ شَ عِتٍ، فٍيَ شَ عِفٌرٌ،</para>
  <para style="q" vid="ISA 40:4">كِرَ حَاشِ شَ يَءِلَن عَ قَنيِ رَ.<verse eid="ISA 40:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 40:5"/>عَلَتَلَ شَ نْرّ مَكّنّنمَ نّ دَالِ بِرِن يَ شْرِ.»</para>
  <para style="q" vid="ISA 40:5">عَلَتَلَ شَ مَسٍنيِ يَتِ نَن نَ كِ.<verse eid="ISA 40:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="ISA 40:6"/>مِشِ ندٍ بَرَ عَ قَلَ ﭑ بّ، «عِ شُي رَتٍ.»</para>
  <para style="q" vid="ISA 40:6">ﭑ بَرَ عَ يَابِ، «ﭑ شَ مُنسٍ قَلَ؟»</para>
  <para style="q" vid="ISA 40:6">عَ نَشّ، «عَدَ مَ شَ نْرّ لُشِ نّ عَلْ سَنسِيٍ.<verse eid="ISA 40:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 40:7"/>عٍ لِسِمَ نّ، عَلَتَلَ شَ قٌيٍ عٍ قُفٍ كَنَ.</para>
  <para style="q" vid="ISA 40:7">عَدَ مَدِيٍ مَنِيَشِ سَنسِيٍ نَن نَ.<verse eid="ISA 40:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 40:8"/>سَنسِيٍ شَرَ مَ نّ، عٍ قُفٍ كَنَ،</para>
  <para style="q" vid="ISA 40:8">كْنْ عَلَتَلَ تَن شَ مَسٍنيِ مُ كَنَمَ عَبَدَن.»<verse eid="ISA 40:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="ISA 40:9"/>سِيٌنِ، عِ شَ تٍ فٍيَ عِتٍشِ ندٍ قَرِ.</para>
  <para style="q" vid="ISA 40:9">دَرِ سَلَمُ، عِ شَ عِ شُي عِتٍ سّنبّ رَ لِمَنِيَ كُي.</para>
  <para style="q" vid="ISA 40:9">عَ قَلَ يُدَيَ تَايٍ بّ، «وٌ مَرِفِ عَلَ نَ بٍ.»<verse eid="ISA 40:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 40:10"/>مَرِفِ عَلَتَلَ نَ قَقٍ سّنبّ رَ، نْي شَنشِ عَ بّلّشّ عِ.</para>
  <para style="q" vid="ISA 40:10">شُننَكٍلِ نَ عَ بّ.<verse eid="ISA 40:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 40:11"/>عَ مّينِمَ نّ عَ شَ شُرُ سٍيٍ مَ،</para>
  <para style="q" vid="ISA 40:11">عَ عَ شَ يّشّ يْرّيٍ تٌنفٌمَ نّ، عَ عٍ سَ عَ كَنكٍ مَ،</para>
  <para style="q" vid="ISA 40:11">عَ عٍ نفَيٍ رَفبّنفبّن.<verse eid="ISA 40:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="ISA 40:12"/>ندٍ بَا يٍ مَنِيَشِ عَ بّلّشّ كُي؟</para>
  <para style="q" vid="ISA 40:12">ندٍ كٌورٍ وَلَشّ مَنِيَشِ؟</para>
  <para style="q" vid="ISA 40:12">ندٍ دُنِحَ بّندّ مَنِيَشِ؟</para>
  <para style="q" vid="ISA 40:12">ندٍ فٍيَيٍ دْشْشِ سِكٍيلِ رَ؟<verse eid="ISA 40:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 40:13"/>ندٍ عَلَتَلَ شَشِلِ كٌلٌن؟</para>
  <para style="q" vid="ISA 40:13">ندٍ نْمَ مَرَ سِ قِدٍ عَ مَ؟<verse eid="ISA 40:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 40:14"/>ندٍ عَ يَمَرِ مَ؟ ندٍ عَ مَتِنكَنمَ؟</para>
  <para style="q" vid="ISA 40:14">ندٍ قٍ كٌلٌنيِ مَسٍنمَ عَ بّ؟</para>
  <para style="q" vid="ISA 40:14">ندٍ عَ مَسٍنمَ عَ بّ سٍ يَءِلَنمَ كِ نَشّ؟<verse eid="ISA 40:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="ISA 40:15"/>حَمَنّيٍ لُشِ نّ عَ بّ عَلْ سٍ شُنشُرِيٍ.</para>
  <para style="q" vid="ISA 40:15">عَ عٍ رَكٍلِمَ نّ عَ قَنيِ رَ.<verse eid="ISA 40:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 40:16"/>لِبَن سُبٍ بِرِن نَلَنشِ مُ سّرّشّ فَن دَاشِ لِمَ نَشَن دَشَ عَ بّ،</para>
  <para style="q" vid="ISA 40:16">لِبَن قْتْنيِ بٍلٍبٍلٍ مُ يٍفٍ لِمَ عَ شَ سّرّشّ فَنقٍ رَ.<verse eid="ISA 40:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 40:17"/>سٍسٍ مُ حَمَنّيٍ رَ عَ يَ عِ، عٍ قِندِشِ عَ بّ قٍ قُقَقُ نَن نَ.<verse eid="ISA 40:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 40:18"/>وٌ وَ مَ عَلَ مَنِيَقٍ ندٍ رَ؟</para>
  <para style="q" vid="ISA 40:18">وٌ عَ مِسَالِمَ مُنسٍ رَ؟<verse eid="ISA 40:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 40:19"/>يِرَوَلِ كُيٍ نَن مَسٌلِمَ،</para>
  <para style="q" vid="ISA 40:19">شَبُي شّيمَ رَدِن عَ مَ،</para>
  <para style="q" vid="ISA 40:19">عَ قَ فبٍتِ يْلْنشْنيِيٍ يَءِلَن عَ كُيٍ فبَكُمَ نَشَن نَ.<verse eid="ISA 40:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 40:20"/>سٍتَرٍيٍ وُرِ ندٍ نَن قٍنمَ نَشَن مُ كَنَمَ مَقُرٍن مَقُرٍن،</para>
  <para style="q" vid="ISA 40:20">عَ مِشِ قٍن نَشَن قَتَ عَ مَسٌلِدٍ عَلَكٌ عَ نَشَ بِرَ.<verse eid="ISA 40:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="ISA 40:21"/>وٌ مُ عَ كٌلٌن؟ وٌ مُ نَ قٍ مّشِ كَبِ تّمُي شْنكُيٍ؟</para>
  <para style="q" vid="ISA 40:21">وٌ مُ نَ قَهَامُشِ كَبِ دُنِحَ دَا تّمُي؟<verse eid="ISA 40:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 40:22"/>عَ تَن نَن سَبَتِشِ دُنِحَ بِرِن شُن مَ.</para>
  <para style="q" vid="ISA 40:22">دُنِحَ مِشِيٍ لُشِ نّ عَ بّ عَلْ كَتٌييٍ.</para>
  <para style="q" vid="ISA 40:22">عَ تَن كٌورٍ وَلَشّ عِتَلَشِ نّ عَلْ دُفِ نَشَن سَمَ لٍيلٍ مَ.<verse eid="ISA 40:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 40:23"/>عَ تَن نَن مَنفّيٍ شُن نَكَنَمَ، عَ مِشِ شُنفبٍيٍ شَ قٍ مَفٌرٌ.<verse eid="ISA 40:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="ISA 40:24"/>عٍ لُشِ نّ عَلْ سَنسِ نَشَن سِ تٌ،</para>
  <para style="q" vid="ISA 40:24">كْنْ بٍينُ عٍ شَ مْ، عَ قَ وُيٍنيِ رَدِن عٍ مَ نَشَن عٍ شَرَ مَ فبٍن.</para>
  <para style="q" vid="ISA 40:24">نَ تّمُي قٌيٍ شُنفبٍ عٍ شَنِنمَ نّ عَلْ سّشّ شَرٍ.<verse eid="ISA 40:24"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="25" style="v" sid="ISA 40:25"/>عَلَ سّنِيّنتْي شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="ISA 40:25">«وٌ ﭑ تَن عَلَ مَنِيَمَ ندٍ رَ؟</para>
  <para style="q" vid="ISA 40:25">ﭑ مِسَالِشِ ندٍ بّ؟<verse eid="ISA 40:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="ISA 40:26"/>وٌ وٌ يَيٍ رَكٍلِ كٌورٍ مَ.</para>
  <para style="q" vid="ISA 40:26">ندٍ نَ سٍ يَنبَشِيٍ دَاشِ؟</para>
  <para style="q" vid="ISA 40:26">عَلَ نَن عٍ يَمَرِ مَ، عَ عٍ شِلِيٍ كٌلٌن.</para>
  <para style="q" vid="ISA 40:26">عَ سّنبّ شَ سَابُي رَ، سٍسٍ مُ لُشِ عٍ مَ.»<verse eid="ISA 40:26"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="27" style="v" sid="ISA 40:27"/>«نَ كُي، وٌ تَن ﭑ مَ حَمَ،</para>
  <para style="q" vid="ISA 40:27">نَشَن قَتَنشِ يَشُبَ رَ، نَشَن قِندِشِ عِسِرَيِلَ رَ،</para>
  <para style="q" vid="ISA 40:27">مُنقٍ رَ وٌ عَ قَلَمَ،</para>
  <para style="q" vid="ISA 40:27">‹عَلَتَلَ مُ قٍ تٌشِ نَشَن دْشْشِ مُشُ مَ.</para>
  <para style="q" vid="ISA 40:27">مُشُ مَرِفِ عَلَتَلَ مُ وَ مَ مُشُ فبٍ حْشْقٍ.›<verse eid="ISA 40:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="ISA 40:28"/>وٌ مُ عَ كٌلٌن؟ وٌ مُ نَ قٍ مّشِ؟</para>
  <para style="q" vid="ISA 40:28">عَلَتَلَ قِندِشِ عَلَ نَن نَ كَبِ عَبَدَن،</para>
  <para style="q" vid="ISA 40:28">عَ دُنِحَ يَتِ نَن دَاشِ عَ قْلّ رَ.</para>
  <para style="q" vid="ISA 40:28">عَ مُ تَفَنمَ، دَنيِ مُ نَ عَ شَشِلِ مَ.<verse eid="ISA 40:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="ISA 40:29"/>عَ سّنبّ قِمَ نّ مِشِ تَفَنشِ مَ،</para>
  <para style="q" vid="ISA 40:29">عَ لِمَنِيَ قِ سّنبّتَرٍيٍ مَ.<verse eid="ISA 40:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="ISA 40:30"/>هَلِ دِ مّدِيٍ عٍ تَفَنمَ، سّفّتَلَيٍ بِرَ مَ،<verse eid="ISA 40:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="ISA 40:31"/>كْنْ نَشٍيٍ عٍ شَشِلِ تِمَ عَلَتَلَ رَ،</para>
  <para style="q" vid="ISA 40:31">نٍيٍ سّنبّ نّينّ سْتْمَ نّ، عٍ قَ تُفَن عَلْ سّفّيٍ.</para>
  <para style="q" vid="ISA 40:31">عٍ عٍ حّرّ، عٍ عٍ فِ، عٍ مُ تَفَنمَ قٍقٍ مَ.»<verse eid="ISA 40:31"/></para>
  <chapter eid="ISA 40"/>
  <chapter number="41" style="c" sid="ISA 41"/>
  <para style="s">عَلَ نَن نَ عِسِرَيِلَ شَ مَلِ رَ</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 41:1"/>«حَمَنّيٍ، وٌ وٌ سَبَرِ.</para>
  <para style="q" vid="ISA 41:1">سِ يٍنسٍنشِيٍ، وٌ لِمَنِيَ، وٌ شَ وٌ مَسٌ ﭑ مَ كِيتِ يِرٍ رَ.»<verse eid="ISA 41:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="ISA 41:2"/>«ندٍ مِشِ تِشِ كِرَ شْن مَ كٍلِ سٌفٍتٍدٍ،</para>
  <para style="q" vid="ISA 41:2">وٌ شَ كِيتِ سَمَ نَشَن شِلِ رَ؟</para>
  <para style="q" vid="ISA 41:2">ندٍ حَمَنّيٍ سَشِ عَ سَفٌي، عَ مَنفّيٍ شَ قٍ عِفٌرٌ عَ بّ؟</para>
  <para style="q" vid="ISA 41:2">عَ شَ سَنتِدّفّمَ عٍ شُن نَكَنَمَ نّ، عَ شَ شَلِ عٍ رَيٍنسٍن يّ.<verse eid="ISA 41:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 41:3"/>عَ عٍ كٍرِ مَ نّ سّنبّ رَ، عَ مَن سِفَ يِرٍ فبّتّ نَ رَبَدٍ.<verse eid="ISA 41:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 41:4"/>ندٍ نَ قٍيٍ رَفِرِشِ عَ شَ يَامَرِ رَ كَبِ دُنِحَ قْلّ؟</para>
  <para style="q" vid="ISA 41:4">ﭑ تَن عَلَتَلَ، نَشَن نَ قٍ قْلّ نُن قٍ رَحْنيِ رَ،</para>
  <para style="q" vid="ISA 41:4">ﭑ تَن بَرَ نَ مْولِ بِرِن نَفِرِ.»<verse eid="ISA 41:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="ISA 41:5"/>«حَمَنّيٍ فَاشُمَ نّ نَ بِرِن يَ رَ،</para>
  <para style="q" vid="ISA 41:5">سِيٍ سّرّن فَاشُي رَ دُنِحَ بِرِن.<verse eid="ISA 41:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 41:6"/>عٍ لِمَنِيَ قِمَ عٍ بٌرٍ مَ، عَ قَلَقٍ رَ، ‹وٌ وٌ سّنبّ سٌ!›<verse eid="ISA 41:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 41:7"/>يِرَوَلِيٍ عٍ بٌرٍ مَلِمَ عَلَكٌ شّيمَ شَ سَ كُيٍ مَ.</para>
  <para style="q" vid="ISA 41:7">عٍ نَشّ، ‹عَ قَن نَ كِ نّ.›</para>
  <para style="q" vid="ISA 41:7">عٍ كُيٍ بَنبَنمَ لَنتُمَيٍ رَ عَلَكٌ عَ نَشَ قَ بِرَ.»<verse eid="ISA 41:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="ISA 41:8"/>«كْنْ وٌ تَن عِسِرَيِلَ قِندِشِ ﭑ مَ كٌنيِ نَن نَ.</para>
  <para style="q" vid="ISA 41:8">ﭑ وٌ تَن يَشُبَ بْنسْي نَن سُفَندِشِ،</para>
  <para style="q" vid="ISA 41:8">نَشَن قَتَنشِ ﭑ شَنُنتٍنيِ عِبُرَهِمَ بْنسْي.<verse eid="ISA 41:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 41:9"/>ﭑ وٌ تٌنفٌشِ دُنِحَ تُنشُنيِيٍ نَن نَ، عَ قَلَقٍ رَ،</para>
  <para style="q" vid="ISA 41:9">‹ﭑ مَ كٌنيِ سُفَندِشِيٍ نَن وٌ رَ، ﭑ مُ مّمَ نَشٍيٍ رَ.›<verse eid="ISA 41:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 41:10"/>وٌ نَشَ فَاشُ، بَرِ مَ ﭑ نَ وٌ قْشْ رَ.</para>
  <para style="q" vid="ISA 41:10">وٌ نَشَ كْنتْقِلِ، بَرِ مَ ﭑ تَن نَن نَ وٌ مَرِفِ عَلَ رَ.</para>
  <para style="q" vid="ISA 41:10">ﭑ سّنبّ قِمَ وٌ مَ ﭑ بّلّشّ تِنشِنشِ نَن نَ.»<verse eid="ISA 41:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="ISA 41:11"/>«نَشٍيٍ بِرِن وٌ مَبٍرٍقٍ، عٍ قَمَ يَافِ نَن تُن سْتْدٍ.</para>
  <para style="q" vid="ISA 41:11">نَشٍيٍ وٌ قٍنقٍ فٍرٍ رَ، عٍ هَلَكِمَ نّ، عٍ حْن.<verse eid="ISA 41:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 41:12"/>وٌ نَ وٌ يَشُييٍ قٍن، وٌ مُ قَمَ عٍ تٌدٍ، بَرِ مَ عٍ لْيمَ نّ.</para>
  <para style="q" vid="ISA 41:12">نَشٍيٍ وٌ قٍنمَ فٍرٍ رَ، نٍيٍ حْنمَ نّ.<verse eid="ISA 41:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 41:13"/>نَ رَبَمَ نّ بَرِ مَ ﭑ تَن نَن نَ وٌ مَرِفِ عَلَتَلَ رَ،</para>
  <para style="q" vid="ISA 41:13">نَشَن وٌ بّلّشّ رَ سُشُ،</para>
  <para style="q" vid="ISA 41:13">عَ عَ قَلَ، ‹وٌ نَشَ فَاشُ، ﭑ قَقٍ وٌ مَلِدٍ.›<verse eid="ISA 41:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 41:14"/>يَشُبَ بْنسْي، وٌ نَشَ فَاشُ.</para>
  <para style="q" vid="ISA 41:14">عِسِرَيِلَ، وٌ وٌ سّنبّ سٌ.</para>
  <para style="q" vid="ISA 41:14">هَلِ وٌ قِندِشِ مِشِ شُنشُرِيٍ نَن نَ عَلْ كُلِ دِ،</para>
  <para style="q" vid="ISA 41:14">ﭑ تَن نَشَن لَنشِ وٌ رَكِسِمَ مَ، نَشَن قِندِشِ وٌ شَ سّنِيّنتْي رَ،</para>
  <para style="q" vid="ISA 41:14">ﭑ تَن يّتّ يَتِ قَمَ نّ وٌ مَلِدٍ.</para>
  <para style="q" vid="ISA 41:14">ﭑ شُي نَن نَ كِ.»<verse eid="ISA 41:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="ISA 41:15"/>«ﭑ عَ نِيَمَ نّ وٌ شَ سّنبّ مَفَاشُشِ سْتْ وٌ يَشُييٍ يَ رَ.</para>
  <para style="q" vid="ISA 41:15">وٌ لُمَ نّ عَلْ وُرٍ وَلِ سٍ نَشَن فٍيَيٍ رَبْو مَ، عَ عٍ قِندِ شُبٍ رَ.<verse eid="ISA 41:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 41:16"/>وٌ يَشُييٍ رَيٍنسٍنمَ نّ</para>
  <para style="q" vid="ISA 41:16">عَلْ شّ سَ نَشٍيٍ مَالٍ بْنبْ، قٌيٍ قَ مَالٍ لَفِ شَنِن.</para>
  <para style="q" vid="ISA 41:16">وٌ سّيوَ مَ نّ عَلَتَلَ رَ،</para>
  <para style="q" vid="ISA 41:16">وٌ عِسِرَيِلَ شَ سّنِيّنتْي تَنتُمَ نّ.»<verse eid="ISA 41:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="ISA 41:17"/>«مِسِكِينّيٍ نُن سٍتَرٍيٍ يٍ قٍنمَ، كْنْ عٍ مُ عَ تٌمَ.</para>
  <para style="q" vid="ISA 41:17">عٍ نّنيِ شَرَ مَ يٍ شْلِ رَ.</para>
  <para style="q" vid="ISA 41:17">كْنْ ﭑ تَن عَلَتَلَ، ﭑ عٍ شَ مَشَندِ تٌنفٌمَ نّ.</para>
  <para style="q" vid="ISA 41:17">ﭑ تَن عِسِرَيِلَ مَرِفِ عَلَ، ﭑ مُ نّيمُمَ عٍ مَ.<verse eid="ISA 41:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 41:18"/>ﭑ شُرٍيٍ رَبْو مَ نّ فٍيَ مَشَرَشِيٍ مَ،</para>
  <para style="q" vid="ISA 41:18">ﭑ دُلٌنيِ رَ مِنِمَ مَ فُلُنبَيٍ كُي.</para>
  <para style="q" vid="ISA 41:18">ﭑ فبٍنفبٍرٍنيِ مَقِندِ مَ نّ يٍ يِرٍ رَ.<verse eid="ISA 41:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 41:19"/>ﭑ سّدِرِ، كَسِيَ، مِرِتِ، نُن عٌلِوِ وُرِ بِلِيٍ سِمَ نّ فبٍنفبٍرٍنيِ مَ.</para>
  <para style="q" vid="ISA 41:19">ﭑ سِثِرّ، عٌرِ مِ، نُن بُيِسِ سَنسِ بِلِيٍ سِ وُلَ عِ،<verse eid="ISA 41:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 41:20"/>عَلَكٌ حَمَ شَ نَ تٌ، عٍ قَ قَهَامُي سْتْ،</para>
  <para style="q" vid="ISA 41:20">عَ نَ بِرِن قِندِشِ عِسِرَيِلَ شَ سّنِيّنتْي عَلَتَلَ سّنبّ وَلِ نَن نَ.»<verse eid="ISA 41:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="ISA 41:21"/>عَلَتَلَ نَشّ، «وٌ قَ، وٌ وٌ شَ مَرَكْرْ سِ مَسٍن ﭑ بّ.</para>
  <para style="q" vid="ISA 41:21">وٌ شَ نَ بِرِن تَفِ رَبَ عَ قَنيِ رَ يَشُبَ مَرِفِ بّ.<verse eid="ISA 41:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 41:22"/>وٌ شَ قَ وٌ شَ كُيٍيٍ رَ عَلَكٌ عٍ شَ عَ قَلَ مُشُ بّ قٍ نَشٍيٍ قَمَ رَبَدٍ.</para>
  <para style="q" vid="ISA 41:22">قٍ نَشٍيٍ سِنفٍ رَبَشِ، عٍ شَ عٍ رَبَ كِ قَلَ مُشُ بّ،</para>
  <para style="q" vid="ISA 41:22">عَلَكٌ مُشُ شَ شَشِلِ سْتْ نَ كُي.</para>
  <para style="q" vid="ISA 41:22">عٍ شَ عَ قَلَ مُشُ بّ قٍ نَشَن قَمَ رَبَدٍ،<verse eid="ISA 41:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 41:23"/>عَلَكٌ مُشُ شَ عَ كٌلٌن عَ عٍ قِندِشِ عَلَيٍ نَن نَ.</para>
  <para style="q" vid="ISA 41:23">عٍ شَ قٍ ندٍ رَبَ، عَ نَ قِندِ قٍقٍ يٌ رَ،</para>
  <para style="q" vid="ISA 41:23">نَشَن نْمَ مُشُ دّ عِشَرَدٍ، مُشُ شَ فَاشُ عٍ يَ رَ.<verse eid="ISA 41:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="ISA 41:24"/>وٌ تَن كُيٍيٍ، ‹وٌ مُ نْمَ نَ سٍسٍ رَ، وٌ تِدٍ يٌ مُ نَ.</para>
  <para style="q" vid="ISA 41:24">مِشِ نَشَن وٌ بَتُمَ، نَ مِشِ قِندِشِ مِشِ شْنشِ نَن نَ.›»<verse eid="ISA 41:24"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="25" style="v" sid="ISA 41:25"/>«ﭑ بَرَ مِشِ ندٍ رَكٍلِ كْولَ مَبِرِ،</para>
  <para style="q" vid="ISA 41:25">عَ قَمَ ﭑ شِلِ رَ كٍلِقٍ سٌفٍتٍدٍ مَبِرِ.</para>
  <para style="q" vid="ISA 41:25">عَ مَنفّيٍ عِبٌرٌنمَ نّ عَلْ قّحّ رَقَلّ بّندّ عِبٌرٌنمَ كِ نَشّ.<verse eid="ISA 41:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="ISA 41:26"/>ندٍ نَ قٍ مَسٍنشِ كَبِ عَ قْلّ، عَلَكٌ مُشُ شَ نَ كٌلٌن بٍينُن عَ شَ رَبَ؟</para>
  <para style="q" vid="ISA 41:26">ندٍ نَ قَلَشِ، عَلَكٌ مُشُ شَ عَ كٌلٌن نْندِ قَلّ نَن عَ رَ؟</para>
  <para style="q" vid="ISA 41:26">كُيٍ يٌ مُ نَ قٍ مَسٍن.</para>
  <para style="q" vid="ISA 41:26">كُيٍ يٌ مُ نَ شِبَارُي قِ.</para>
  <para style="q" vid="ISA 41:26">كُيٍ يٌ مُ عٍ شُي عِتٍ.<verse eid="ISA 41:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="ISA 41:27"/>ﭑ تَن نَن نَ سِنفٍ مَسٍن سِيٌنِ بّ،</para>
  <para style="q" vid="ISA 41:27">‹يِ نَن قَمَ رَبَدٍ.›</para>
  <para style="q" vid="ISA 41:27">ﭑ تَن شّيرَ نَن شّي دَرِ سَلَمُ.<verse eid="ISA 41:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="ISA 41:28"/>ﭑ نَشَن تٌمَ يِ كُيٍيٍ تَفِ،</para>
  <para style="q" vid="ISA 41:28">كٍرٍن مُ نَ نَشَن نْمَ مَسٍنيِ ندٍ تِدٍ،</para>
  <para style="q" vid="ISA 41:28">نَشَن نْمَ ﭑ مَ مَشْرِنيِيٍ يَابِدٍ.<verse eid="ISA 41:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="ISA 41:29"/>وٌ شَ عٍ مَتٌ؛ كُيٍ قُقَقُ نَن عٍ رَ!</para>
  <para style="q" vid="ISA 41:29">عٍ وَلِ قْشِ يٌ مُ نَ!</para>
  <para style="q" vid="ISA 41:29">سٍسٍ مُ نَ يِ كُيٍيٍ رَ!»<verse eid="ISA 41:29"/></para>
  <chapter eid="ISA 41"/>
  <chapter number="42" style="c" sid="ISA 42"/>
  <para style="s">عَلَتَلَ شَ كٌنيِ سُفَندِشِ</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 42:1"/>ﭑ مَ كٌنيِ سُفَندِشِ نَن يِ كِ، ﭑ حْشْ سَشِ نَشَن شْن مَ،</para>
  <para style="q" vid="ISA 42:1">ﭑ نَشَن شَنُمَ ﭑ نِي بِرِن نَ.</para>
  <para style="q" vid="ISA 42:1">ﭑ بَرَ ﭑ شَشِلِ رَفٌرٌ عَ مَ.</para>
  <para style="q" vid="ISA 42:1">عَ تِنشِنيِ مَسٍنمَ نّ حَمَنّيٍ بّ،<verse eid="ISA 42:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 42:2"/>كْنْ عَ مُ شَاحّمَ عٍ مَ، عَ مُ سْنشْي رَتٍمَ عٍ مَ،</para>
  <para style="q" vid="ISA 42:2">عَ مُ عَ يّتّ عِفبٌمَ.<verse eid="ISA 42:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 42:3"/>عَ مُ كَلٍ كُنتِنشِ عِفِرَ مَ،</para>
  <para style="q" vid="ISA 42:3">عَ مُ لَنثُي دّشّ شُرِ رَشُبٍنمَ.</para>
  <para style="q" vid="ISA 42:3">عَ كِيتِ سَمَ عَ سّرِيّ كِ نَن مَ.<verse eid="ISA 42:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 42:4"/>عَ مُ دَفَلَنمَ، عَ مُ بِرَ مَ،</para>
  <para style="q" vid="ISA 42:4">هَن عَ فّ تِنشِنيِ رَ سَبَتِدٍ دُنِحَ مَ.</para>
  <para style="q" vid="ISA 42:4">حَمَنّيٍ شَشِلِ تِمَ عَ شَ يَامَرِ تِنشِنشِ نَن نَ.<verse eid="ISA 42:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 42:5"/>عَلَتَلَ نْندِ كَنيِ شَ مَسٍنيِ نَن يَ،</para>
  <para style="q" vid="ISA 42:5">عَلَ نَشَن كٌورٍ دَا، عَ عَ وَلَشّ عِتَلَ،</para>
  <para style="q" vid="ISA 42:5">نَشَن بْشِ دَا، عَ نُن سٍ بِرِن نَشَن تٌمَ نَا،</para>
  <para style="q" vid="ISA 42:5">نَشَن حّنفِ قِشِ دُنِحَ مِشِيٍ مَ، عَلَكٌ عٍ شَ دُنِحَ عِفِرِ.<verse eid="ISA 42:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="ISA 42:6"/>«ﭑ تَن عَلَتَلَ نَن نَ،</para>
  <para style="q" vid="ISA 42:6">نَشَن عِ شّيشِ، نَشَن عِ مَكَنتَشِ،</para>
  <para style="q" vid="ISA 42:6">نَشَن عَ نِيَ عِ شَ قِندِ سَاتّ سَابُي رَ عِبُنَدَ مَ بّ،</para>
  <para style="q" vid="ISA 42:6">نَشَن عَ نِيَ عِ شَ قِندِ نَءِيَلَنيِ رَ حَمَنّيٍ بّ،<verse eid="ISA 42:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 42:7"/>عَلَكٌ عِ شَ دْنشُييٍ يَ رَبْو، عِ شَ فٍيلِمَنِيٍ رَ مِنِ فٍيلِ،</para>
  <para style="q" vid="ISA 42:7">عِ شَ مِشِيٍ شْرّيَ نَشٍيٍ نَ دِ مِ كُي.»<verse eid="ISA 42:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="ISA 42:8"/>«عَلَتَلَ نَن ﭑ نَ، ﭑ شِلِ نَن نَ كِ.</para>
  <para style="q" vid="ISA 42:8">ﭑ مُ وَ مَ ﭑ قِرِن ندٍ شْن،</para>
  <para style="q" vid="ISA 42:8">ﭑ مُ تِنمَ ﭑ مَ مَتْشْي شَ قِ كُيٍيٍ مَ.<verse eid="ISA 42:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 42:9"/>ﭑ مَ مَسٍنيِ سِنفٍيٍ بَرَ رَكَمَلِ،</para>
  <para style="q" vid="ISA 42:9">ﭑ مَن قٍ نّينّ مَسٍنمَ نّ وٌ بّ نَشَن قَمَ رَكَمَلِدٍ.</para>
  <para style="q" vid="ISA 42:9">ﭑ نٍيٍ شَ قٍ رَكٌلٌن وٌ رَ بٍينُ عٍ شَ رَبَ.»<verse eid="ISA 42:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="ISA 42:10"/>«وٌ شَ بّيتِ نّينّ بَ عَلَتَلَ بّ،</para>
  <para style="q" vid="ISA 42:10">وٌ عَ مَتْشْ سَ كٍلِ دُنِحَ بَانيِ رَ،</para>
  <para style="q" vid="ISA 42:10">وٌ تَن نَشٍيٍ بِيَاسِمَ بَا شُن مَ،</para>
  <para style="q" vid="ISA 42:10">وٌ تَن نَشٍيٍ بَلٌمَ بَا كُي،</para>
  <para style="q" vid="ISA 42:10">وٌ تَن نَشٍيٍ سَبَتِشِ حَمَنّيٍ كُي.<verse eid="ISA 42:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 42:11"/>فبٍنفبٍرٍنيِ نُن تَايٍ شَ عٍ شُي عِتٍ،</para>
  <para style="q" vid="ISA 42:11">كٍدَرِكَيٍ سَبَتِشِ دّننَشّ.</para>
  <para style="q" vid="ISA 42:11">سٍلَكَيٍ شَ عٍ سّيوّ شُي عِتٍ فٍيَيٍ قَرِ.<verse eid="ISA 42:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 42:12"/>عٍ شَ عَلَتَلَ مَتْشْ عَلْ عَ لَن عَ شَ مَتْشْ كِ نَشّ.</para>
  <para style="q" vid="ISA 42:12">حَمَنّ بِرِن شَ عَ مَتْشْ.<verse eid="ISA 42:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 42:13"/>عَلَتَلَ مِنِمَ نّ عَلْ حَلَمَ،</para>
  <para style="q" vid="ISA 42:13">عَ بْحّ تٍ فٍرٍ شَ قٍ رَ، عَ فٍرٍ سٌ شُي رَ مِنِ سّنبّ رَ.»<verse eid="ISA 42:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="ISA 42:14"/>«كَبِ عَ رَكُيَ ﭑ سَبَرِشِ، ﭑ دُندُشِ، ﭑ نَن ﭑ يّتّ سُشُشِ.</para>
  <para style="q" vid="ISA 42:14">كْنْ يَكْسِ ﭑ نَن ﭑ شُي رَ مِنِمَ عَلْ فِنّ نَشَن دِ بَرِقٍ.<verse eid="ISA 42:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 42:15"/>ﭑ سَنسِيٍ رَلِسِمَ نّ فٍيَيٍ قَرِ،</para>
  <para style="q" vid="ISA 42:15">فٍيَ قِندِ فبٍنفبٍرٍنيِ رَ.</para>
  <para style="q" vid="ISA 42:15">ﭑ شُرٍيٍ مَقِندِ مَ نّ شَرٍ رَ،</para>
  <para style="q" vid="ISA 42:15">ﭑ يٍ يِرٍيٍ شْرِ.<verse eid="ISA 42:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 42:16"/>ﭑ دْنشُييٍ رَحّرّ مَ نّ كِرَ ندٍ رَ، عٍ مُ نَشَن كٌلٌن،</para>
  <para style="q" vid="ISA 42:16">ﭑ دِ مِ قِندِ عٍ بّ نَءِيَلَنيِ رَ،</para>
  <para style="q" vid="ISA 42:16">ﭑ بْشِ مَفٍشِ قِندِ بْشِ سَشِ رَ عٍ حّرّ مَ دّننَشّ.</para>
  <para style="q" vid="ISA 42:16">ﭑ نَ نَن يَتِ رَبَمَ عٍ بّ، ﭑ مُ عٍ رَبّحِنمَ.<verse eid="ISA 42:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 42:17"/>نَشٍيٍ عٍ شَشِلِ تِشِ كُيٍيٍ رَ،</para>
  <para style="q" vid="ISA 42:17">عٍ فبِلٍنمَ نّ يَافِ كُي.</para>
  <para style="q" vid="ISA 42:17">نَ كُيٍيٍ يَءِلَنشِ وُرٍ رَشُنُشِ نَن تُن نَ،</para>
  <para style="q" vid="ISA 42:17">كْنْ نَ مِشِيٍ عَ قَلَمَ عٍ بّ، ‹وٌ قِندِشِ وٌن مَ عَلَيٍ نَن نَ.›»<verse eid="ISA 42:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="ISA 42:18"/>«تُلِشْرِيٍ، وٌ وٌ تُلِ مَتِ.</para>
  <para style="q" vid="ISA 42:18">دْنشُييٍ، وٌ وٌ يَ تِ ﭑ نَ.<verse eid="ISA 42:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 42:19"/>ندٍ دْنشُشِ، شَ ﭑ مَ كٌنيِ شَ مُ عَ رَ؟</para>
  <para style="q" vid="ISA 42:19">ندٍ تُلِ شْرِشِ، شَ ﭑ ﭑ مَ شّيرَ شَ مُ عَ رَ؟</para>
  <para style="q" vid="ISA 42:19">ندٍ دْنشُشِ، شَ ﭑ مَ كٌنيِ بْحّ سَشِ شَ مُ عَ رَ؟<verse eid="ISA 42:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 42:20"/>وٌ بَرَ قٍ فبٍفبٍ تٌ، كْنْ وٌ مُ وٌ حْشْ سَشِ عٍ شْن مَ.</para>
  <para style="q" vid="ISA 42:20">عٍ بَرَ عٍ تُلِ مَتِ، كْنْ عٍ مُ قٍقٍ قَهَامُشِ.<verse eid="ISA 42:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 42:21"/>تِنشِنيِ تٌ رَقَن عَلَتَلَ مَ،</para>
  <para style="q" vid="ISA 42:21">عَ بَرَ وَ عَ شَ سّرِيّ بِنيَقٍ، حَمَ شَ عَ كٌلٌن.<verse eid="ISA 42:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 42:22"/>كْنْ يِ حَمَ شُن بَرَ رَكَنَ،</para>
  <para style="q" vid="ISA 42:22">عٍ سُشُشِ يِلِ نُن فٍيلِ نَن كُي.</para>
  <para style="q" vid="ISA 42:22">عٍ يَشُييٍ بَرَ عٍ شَنِن، مِشِ يٌ مُ نَ نَشَن عٍ رَكِسِمَ،</para>
  <para style="q" vid="ISA 42:22">مِشِ يٌ مُ نَ نَشَن مَشَندِ تِمَ عٍ بّ عٍ شَ فبِلٍن.»<verse eid="ISA 42:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="ISA 42:23"/>ندٍ عَ تُلِ مَتِمَ نَ قٍيٍ رَ وٌ يَ مَ؟</para>
  <para style="q" vid="ISA 42:23">ندٍ عَ حْشْ سَمَ نَ قٍيٍ شْن مَ تّمُي نَشَن سَ قَمَ؟<verse eid="ISA 42:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="ISA 42:24"/>ندٍ يَشُبَ سٌشِ مُحّتِ يِ رَ؟</para>
  <para style="q" vid="ISA 42:24">ندٍ عِسِرَيِلَ سٌشِ كَسَرَتِيٍ يِ رَ؟</para>
  <para style="q" vid="ISA 42:24">عَلَتَلَ شَ مُ عَ رَ، وٌن يُنُبِ رَبَشِ نَشَن نَ؟</para>
  <para style="q" vid="ISA 42:24">عٍ مُ وَشِ حّرّقٍ عَ شَ كِرَ شَ شْن مَ،</para>
  <para style="q" vid="ISA 42:24">عٍ مَن مُ عٍ تُلِ مَتِشِ عَ شَ سّرِيّ شَ رَ.<verse eid="ISA 42:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="ISA 42:25"/>نَ كُي عَ نَشَ عَ شَ شْنّ دُ سُ عِسِرَيِلَ شُن نَ،</para>
  <para style="q" vid="ISA 42:25">عَ نِيَ فٍرٍ شَ عٍ شُن نَكَنَ.</para>
  <para style="q" vid="ISA 42:25">نَ تّ بَرَ دّشّ عٍ رَبِلِنيِ،</para>
  <para style="q" vid="ISA 42:25">كْنْ عٍ مُ عٍ حْشْ سَشِ نَ شْن مَ.<verse eid="ISA 42:25"/></para>
  <chapter eid="ISA 42"/>
  <chapter number="43" style="c" sid="ISA 43"/>
  <para style="s">عِسِرَيِلَ رَكِسِمَ كٍرٍنيِ</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 43:1"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ،</para>
  <para style="q" vid="ISA 43:1">نَشَن يَشُبَ دَاشِ،</para>
  <para style="q" vid="ISA 43:1">نَشَن عِسِرَيِلَ يَءِلَنشِ بّندّ رَ؛</para>
  <para style="q" vid="ISA 43:1">«هَلِ وٌ مُ فَاشُ، بَرِ مَ ﭑ بَرَ وٌ شُن سَرَ،</para>
  <para style="q" vid="ISA 43:1">ﭑ بَرَ وٌ شِلِ وٌ شِلِ رَ، بَرِ مَ ﭑ فبٍ نَن وٌ رَ.<verse eid="ISA 43:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 43:2"/>وٌ نَ بَا عِفِرِ، وٌن بِرِن نَن عَ رَ.</para>
  <para style="q" vid="ISA 43:2">وٌ نَ شُرٍ عِفِرِ، عَ مُ وٌ شَنِنمَ.</para>
  <para style="q" vid="ISA 43:2">وٌ نَ دَنفِ تّ شْورَ، عَ مُ وٌ فَنمَ، عَ مُ وٌ تْورْ مَ،<verse eid="ISA 43:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 43:3"/>بَرِ مَ ﭑ تَن عَلَتَلَ نَن نَ وٌ مَرِفِ عَلَ رَ،</para>
  <para style="q" vid="ISA 43:3">عِسِرَيِلَ شَ سّنِيّنتْي، وٌ رَكِسِمَ.</para>
  <para style="q" vid="ISA 43:3">ﭑ مِسِرَ نَن قِشِ عِ شُنسَرٍ رَ،</para>
  <para style="q" vid="ISA 43:3">ﭑ عٍتِيٌثِ نُن سٍبَ قِشِ وٌ حْشْي نَن نَ.<verse eid="ISA 43:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 43:4"/>وٌ تِدٍ تٌ فبٌ ﭑ بّ ﭑ مَ شَنُنتٍيَ شَ قٍ رَ،</para>
  <para style="q" vid="ISA 43:4">ﭑ مِشِيٍ نَن بَمَ وٌ حْشْي رَ، ﭑ حَمَ قِ وٌ نِي رَكِسِقٍ رَ.<verse eid="ISA 43:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 43:5"/>وٌ نَشَ فَاشُ، ﭑ نَ وٌ قْشْ رَ.</para>
  <para style="q" vid="ISA 43:5">ﭑ قَمَ نّ وٌ بْنسْي رَ، كٍلِقٍ سٌفٍتٍدٍ نُن سٌفٍفٌرٌدٍ مَبِرِ،<verse eid="ISA 43:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 43:6"/>ﭑ قَمَ وٌ شِلِدٍ كٍلِقٍ يِرٍقَنيِ نُن كْولَ مَ.</para>
  <para style="q" vid="ISA 43:6">‹وٌ قَ ﭑ مَ دِيٍ رَ، كٍلِقٍ يِرٍ مَكُيٍ،<verse eid="ISA 43:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 43:7"/>عٍ بِرِن نَشٍيٍ شِلِشِ ﭑ شِلِ رَ،</para>
  <para style="q" vid="ISA 43:7">ﭑ نَشَن دَاشِ ﭑ مَ نْرّ شَ قٍ رَ.›<verse eid="ISA 43:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 43:8"/>حَمَيٍ شَ قَ نَشٍيٍ يَ نَ كْنْ عٍ مُ سٍ تٌمَ،</para>
  <para style="q" vid="ISA 43:8">عٍ تُلِ نَ كْنْ عٍ مُ قٍ مّمَ.<verse eid="ISA 43:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 43:9"/>حَمَيٍ نُن سِيٍ شَ عٍ مَلَن.</para>
  <para style="q" vid="ISA 43:9">ندٍ نَ عٍ يَ مَ نَشَن نُ بَرَ يِ قٍ مَسٍن وٌن بّ بٍينُ عَ شَ رَبَ؟</para>
  <para style="q" vid="ISA 43:9">عٍ شَ سٍيدٍيٍ رَ مِنِ، نَشٍيٍ نْمَ عَ قٍ رَقِيشّدٍ،</para>
  <para style="q" vid="ISA 43:9">عَلَكٌ بٌورٍيٍ شَ عَ كٌلٌن عَ نْندِ نَ عَ رَ.»<verse eid="ISA 43:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="ISA 43:10"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ،</para>
  <para style="q" vid="ISA 43:10">«وٌ تَن نَن نَ ﭑ مَ سٍيدٍيٍ رَ، ﭑ مَ كٌنيِ سُفَندِشِ،</para>
  <para style="q" vid="ISA 43:10">عَلَكٌ وٌ شَ ﭑ كٌلٌن، وٌ شَ لَ ﭑ نَ.</para>
  <para style="q" vid="ISA 43:10">عَلَ يٌ مُ نُ نَ ﭑ يَ رَ، عَلَ يٌ مُ قَمَ ﭑ شَنبِ رَ.<verse eid="ISA 43:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 43:11"/>ﭑ تَن كٍرٍن نَن نَ عَلَتَلَ رَ.</para>
  <para style="q" vid="ISA 43:11">مِشِ رَكِسِمَ يٌ مُ نَ بَقٍ ﭑ تَن نَ.<verse eid="ISA 43:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 43:12"/>ﭑ تَن نَن نْندِ مَسٍنشِ، ﭑ تَن نَن وٌ رَكِسِشِ،</para>
  <para style="q" vid="ISA 43:12">ﭑ تَن نَن قٍ نّينّ مَسٍنمَ وٌ بّ.</para>
  <para style="q" vid="ISA 43:12">عَلَ شْحّ ندٍ شَ مُ ﭑ نَ وٌ تَفِ.</para>
  <para style="q" vid="ISA 43:12">وٌ تَن نَن نَ ﭑ مَ سٍيدٍيٍ رَ عَ ﭑ كٍرٍن نَن نَ عَلَ رَ.<verse eid="ISA 43:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 43:13"/>كَبِ قْلْ قْلّ ﭑ تَن نَن عَلَ رَ.</para>
  <para style="q" vid="ISA 43:13">مِشِ يٌ مُ نْمَ مِشِ بَدٍ ﭑ بّلّشّ،</para>
  <para style="q" vid="ISA 43:13">مِشِ يٌ مُ نْمَ ﭑ مَ قٍ رَبَشِ مَسَرَدٍ.»<verse eid="ISA 43:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="ISA 43:14"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ،</para>
  <para style="q" vid="ISA 43:14">عَلَ نَشَن وٌ شُن سَرَ،</para>
  <para style="q" vid="ISA 43:14">عَلَ نَشَن قِندِشِ عِسِرَيِلَ شَ سّنِيّنتْي رَ.</para>
  <para style="q" vid="ISA 43:14">عَ نَشّ، «ﭑ يَامَرِ قِمَ نّ بَبِلْن فٍيلِمَنِيٍ شَ قَ عٍ شَ كُنكُييٍ كُي،</para>
  <para style="q" vid="ISA 43:14">عٍ نُ لَشِ نَشٍيٍ رَ.<verse eid="ISA 43:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 43:15"/>عَلَتَلَ نَ ﭑ تَن نَن نَ، وٌ شَ سّنِيّنتْي،</para>
  <para style="q" vid="ISA 43:15">نَشَن عِسِرَيِلَ دَا، نَشَن قِندِشِ وٌ شَ مَنفّ رَ.»<verse eid="ISA 43:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="ISA 43:16"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ، عَلَ نَشَن كِرَ بْو بَا تَفِ،</para>
  <para style="q" vid="ISA 43:16">نَشَن دَنفِدٍ رَ مِنِ مْرْنيِيٍ شْورَ،<verse eid="ISA 43:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 43:17"/>نَشَن عَ نِيَ سْورِ رَفِ سٍيٍ نُن سٌي رَفِيٍ شَ كَتَ دَنفِدٍ مّننِ،</para>
  <para style="q" vid="ISA 43:17">عٍ قَ لُ بَا شْورَ عَبَدَن، عٍ مُ تٍ.</para>
  <para style="q" vid="ISA 43:17">نَ سْورِ فَلِ شُبٍنشِ نّ عَلْ لَنثُي شُبٍنمَ كِ نَشّ.<verse eid="ISA 43:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 43:18"/>«وٌ نَشَ وٌ مَحْشُن قٍ سِنفٍيٍ مَ،</para>
  <para style="q" vid="ISA 43:18">وٌ قٍ قٌرِيٍ لُ نَ.<verse eid="ISA 43:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 43:19"/>وٌ مُ عَ تٌشِ، ﭑ نَ قٍ نّينّيٍ رَبَقٍ؟</para>
  <para style="q" vid="ISA 43:19">وٌ مُ فّشِ نَ كٌلٌندٍ؟</para>
  <para style="q" vid="ISA 43:19">ﭑ نَ كِرَ ندٍ بْوقٍ فبٍنفبٍرٍنيِ مَ،</para>
  <para style="q" vid="ISA 43:19">ﭑ نَ شُرٍيٍ رَ مِنِقٍ يِرٍ مَشَرَشِ مَ.<verse eid="ISA 43:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 43:20"/>بُرُنيِ دَالِسٍ ﭑ مَتْشْمَ،</para>
  <para style="q" vid="ISA 43:20">عَلْ وُلَءِ بَرٍ نُن شُندِ، بَرِ مَ ﭑ يٍ رَ مِنِمَ فبٍنفبٍرٍنيِ مَ،</para>
  <para style="q" vid="ISA 43:20">ﭑ شُرٍ شُنفبٍيٍ رَبْو يِرٍ مَشَرَشِ مَ،</para>
  <para style="q" vid="ISA 43:20">عَلَكٌ ﭑ مَ حَمَ سُفَندِشِ شَ يٍ مِن،<verse eid="ISA 43:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 43:21"/>عَلَكٌ ﭑ حَمَ نَشَن دَاشِ عَ شَ ﭑ مَتْشْ.»<verse eid="ISA 43:21"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="22" style="v" sid="ISA 43:22"/>«يَشُبَ، وٌ مُ مَشَندِ تِمَ ﭑ شِلِ رَ.</para>
  <para style="q" vid="ISA 43:22">عِسِرَيِلَ، وٌ مُ قٍقٍ رَبَقٍ بِرَقٍ رَ ﭑ قْشْ رَ.<verse eid="ISA 43:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 43:23"/>وٌ مُ تِن يّشّييٍ بَدٍ سّرّشّ رَ ﭑ بّ،</para>
  <para style="q" vid="ISA 43:23">وٌ مُ تِن ﭑ بِنيَدٍ سّرّشّيٍ رَ.</para>
  <para style="q" vid="ISA 43:23">ﭑ مُ كٌتٍ دْشْشِ وٌ شُن مَ سَنسِ سّرّشّ رَ،</para>
  <para style="q" vid="ISA 43:23">ﭑ مُ وٌ كَرَشَن سُرَيِ فَنقٍ رَ.<verse eid="ISA 43:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="ISA 43:24"/>وٌ مُ لَبُندّ قَنيِ سَرَ ﭑ بّ،</para>
  <para style="q" vid="ISA 43:24">وٌ مُ نِنفٍ تُرٍ فبٍفبٍ بَ سّرّشّ رَ.</para>
  <para style="q" vid="ISA 43:24">وٌ نَشَن نَبَشِ، وٌ بَرَ ﭑ نَتَفَن وٌ شَ يُنُبِيٍ رَ،</para>
  <para style="q" vid="ISA 43:24">وٌ بَرَ ﭑ نَشْنْ وٌ شَ حَاشُحَ رَ.»<verse eid="ISA 43:24"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="25" style="v" sid="ISA 43:25"/>«ﭑ تَن نَن عَ رَ، نَشَن عِ شَ يُنُبِيٍ شَقَرِ مَ ﭑ شِلِ شَ قٍ رَ،</para>
  <para style="q" vid="ISA 43:25">ﭑ قَ نّيمُ عِ شَ يُنُبِيٍ مَ قٍوٌ.<verse eid="ISA 43:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="ISA 43:26"/>عِ شَ عِ شَ قٍ دَنفِشِ مَسٍن ﭑ بّ،</para>
  <para style="q" vid="ISA 43:26">وٌن شَ عَ مَتٌ كِيتِ نَ كِ نَشّ.<verse eid="ISA 43:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="ISA 43:27"/>عِ بٍنبَ سِنفٍ يُنُبِ رَبَ نّ.</para>
  <para style="q" vid="ISA 43:27">عِ شَ يَرٍرَتِ مُرُتَ نّ ﭑ شِلِ مَ.<verse eid="ISA 43:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="ISA 43:28"/>نَ نَن عَ رَ، ﭑ قَمَ عِ شَ سّرّشّدُبّيٍ رَيَافِدٍ،</para>
  <para style="q" vid="ISA 43:28">نَشٍيٍ وَلِمَ ﭑ مَ هْرْ مْلِنفِرَ كُي.</para>
  <para style="q" vid="ISA 43:28">ﭑ عَ نِيَمَ نّ يَشُبَ بْنسْي شُن شَ رَكَنَ،</para>
  <para style="q" vid="ISA 43:28">عِسِرَيِلَ بْنسْي شَ يَافِ.»<verse eid="ISA 43:28"/></para>
  <chapter eid="ISA 43"/>
  <chapter number="44" style="c" sid="ISA 44"/>
  <para style="s">كُيٍ يَءِلَنمَ شَ وَلِ</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 44:1"/>«ﭑ مَ كٌنيِ يَشُبَ بْنسْي، وٌ شَ وٌ تُلِ مَتِ،</para>
  <para style="q" vid="ISA 44:1">ﭑ مَ حَمَ سُفَندِشِ عِسِرَيِلَ، وٌ شَ ﭑ شُي رَ مّ.<verse eid="ISA 44:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 44:2"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ،</para>
  <para style="q" vid="ISA 44:2">نَشَن وٌ دَاشِ وٌ نفَ تّيفّ عِ،</para>
  <para style="q" vid="ISA 44:2">نَشَن وٌ بُن تِمَ.</para>
  <para style="q" vid="ISA 44:2">ﭑ مَ كٌنيِ يَشُبَ، هَلِ عِ مُ هَنمّ،</para>
  <para style="q" vid="ISA 44:2">وٌ تَن يٍسُرُن ﭑ نَشَن سُفَندِشِ،<verse eid="ISA 44:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 44:3"/>بَرِ مَ ﭑ يٍ رَفٌرٌ مَ نّ وٌ شَ بْشِ مَشَرَشِ مَ،</para>
  <para style="q" vid="ISA 44:3">ﭑ شُرٍ رَ مِنِمَ نّ فبٍنفبٍرٍن يِرٍ مَ.</para>
  <para style="q" vid="ISA 44:3">ﭑ نَن ﭑ شَشِلِ رَفٌرٌ مَ نّ وٌ بْنسْي مَ،</para>
  <para style="q" vid="ISA 44:3">ﭑ بَرَكّ سَمَ نّ وٌ شَ دِيٍ مَ.<verse eid="ISA 44:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 44:4"/>عٍ قَنمَ نّ عَلْ حٌوفٍ نَشَن تٌمَ قِيلِ تَفِ،</para>
  <para style="q" vid="ISA 44:4">عَلْ وُرِ نَشٍيٍ سِشِ شُرٍ دّ عِ.<verse eid="ISA 44:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 44:5"/>ندٍ عَ قَلَمَ نّ، ‹عَلَتَلَ فبٍ نَن ﭑ نَ،›</para>
  <para style="q" vid="ISA 44:5">عَ يَشُبَ شِلِ سَ عَ شُن مَ.</para>
  <para style="q" vid="ISA 44:5">ندٍ عَ سّبّمَ نّ عَ بّلّشّ مَ، ‹عَلَتَلَ فبٍ،›</para>
  <para style="q" vid="ISA 44:5">عَ عِسِرَيِلَ شِلِ سَ عَ شُن مَ.»<verse eid="ISA 44:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="ISA 44:6"/>«عَلَتَلَ شَ مَسٍنيِ نَن يَ،</para>
  <para style="q" vid="ISA 44:6">عَلَتَلَ سّنبّمَ نَشَن قِندِشِ عِسِرَيِلَ مَنفّ نُن عَ رَكِسِمَ رَ.</para>
  <para style="q" vid="ISA 44:6">ﭑ تَن نَن نَ قٍ قْلّ رَ، ﭑ تَن نَن نَ قٍ رَحْنيِ رَ.</para>
  <para style="q" vid="ISA 44:6">عَلَ فبّتّ يٌ مُ نَ بَقٍ ﭑ تَن نَ.<verse eid="ISA 44:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 44:7"/>ندٍ مَنِيَشِ ﭑ تَن نَ؟ عَ شَ نَ قَلَ.</para>
  <para style="q" vid="ISA 44:7">نَ كَنيِ شَ وْيّن بَ، عَ شَ قٍ دَنفِشِ مَسٍن كَبِ ﭑ مَ حَمَ دَا تّمُي.</para>
  <para style="q" vid="ISA 44:7">عَ شَ قٍ مَسٍن نَشَن قَمَ رَبَدٍ، عِيٌ عَ شَ نَ قَلَ كّنّ مَ.<verse eid="ISA 44:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 44:8"/>وٌ نَشَ فَاشُ، وٌ نَشَ سّرّن.</para>
  <para style="q" vid="ISA 44:8">ﭑ مُ نَ مَسٍنشِ وٌ بّ شّ، بٍينُ نَ قٍيٍ شَ رَبَ؟</para>
  <para style="q" vid="ISA 44:8">ﭑ مَ سٍيدٍيٍ نَن وٌ رَ.</para>
  <para style="q" vid="ISA 44:8">عَلَ فبّتّ نَ نَ، بَ ﭑ تَن نَ؟</para>
  <para style="q" vid="ISA 44:8">عَدٍ، قَنيٍ فبّتّ مُ نَ هَلِ كٍرٍن.»<verse eid="ISA 44:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="ISA 44:9"/>قُيَنتٍيٍ نَن كُيٍ يَءِلَنمَيٍ رَ.</para>
  <para style="q" vid="ISA 44:9">عٍ شَ وَلِ تِدٍ يٌ مُ نَ.</para>
  <para style="q" vid="ISA 44:9">عٍ شَ سٍيدٍيٍ يَ مُ نَ، عٍ شَشِلِ عِقُشِ.</para>
  <para style="q" vid="ISA 44:9">عٍ قَمَ لُدٍ نَ يَافِ نَن كُي.<verse eid="ISA 44:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 44:10"/>ندٍ كُيٍ يَءِلَنمَ، نَشَن مُ نْمَ عَ مَلِدٍ قٍقٍ رَ؟<verse eid="ISA 44:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 44:11"/>نَ كَنيِيٍ يَافِمَ نّ.</para>
  <para style="q" vid="ISA 44:11">عَدَ مَدِ نَن تُن نَ عٍ رَ.</para>
  <para style="q" vid="ISA 44:11">عٍ بِرِن شَ عٍ مَلَن، عٍ شَ تِ ﭑ يَ رَ.</para>
  <para style="q" vid="ISA 44:11">ﭑ عٍ بِرِن نَفٌرٌ مَ نّ فَاشُي نُن حَشَنكَتّ رَ.<verse eid="ISA 44:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="ISA 44:12"/>كُيٍ يَءِلَنمَ وُرٍ شَبُمَ تّ شْورَ،</para>
  <para style="q" vid="ISA 44:12">عَ كُيٍيٍ يَءِلَن دّرّ مَ رَ، عَ عَ رَوَلِ عَ يّتّ سّنبّ رَ.</para>
  <para style="q" vid="ISA 44:12">كَامّ نُن يٍ شْلِ لُمَ نّ عَ سُشُ رَ، عَ قَ تَفَن.<verse eid="ISA 44:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 44:13"/>كَمُدّرِ لُوتِ عِتَلَمَ نّ عَ مَنِيَقٍ رَ، عَ عَ كْورِن.</para>
  <para style="q" vid="ISA 44:13">عَ وَلِ قْلْ وَلِ سٍيٍ رَ،</para>
  <para style="q" vid="ISA 44:13">عَ عَ يَءِلَن هَن عَ لُ عَلْ مِشِ تٌقَنيِ نَشَن تِمَ عَ شَ بَنشِ كُي.<verse eid="ISA 44:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 44:14"/>عَ نُ وُرِ ندٍيٍ سِ قْتْنيِ يِرٍ،</para>
  <para style="q" vid="ISA 44:14">عَ مَمّ تِ هَن تُنّ يٍ عَ رَ مْ، عَ قَ عَ سّفّ.<verse eid="ISA 44:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 44:15"/>عَ ندٍ قِندِ يٍفٍ رَ، عَلَكٌ شِنبٍلِ نَشَ عَ سُشُ،</para>
  <para style="q" vid="ISA 44:15">عَ ندٍ رَوَلِ تَامِ فَنقٍ رَ.</para>
  <para style="q" vid="ISA 44:15">كْنْ نَشَن لُشِ، عَ نَ قِندِ عَلَ رَ عَ نَشَن بَتُمَ،</para>
  <para style="q" vid="ISA 44:15">عَ كُيٍ رَقَلَ، عَ سُيِدِ عَ بّ.<verse eid="ISA 44:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 44:16"/>عَ سّيتِ قِندِ يٍفٍ رَ،</para>
  <para style="q" vid="ISA 44:16">عَ سُبٍ فَنمَ نَشَن نَ،</para>
  <para style="q" vid="ISA 44:16">عَ قَ عَ دّفٍ، عَ عَ قَلَ، «يِ تّ قَن. شِنبٍلِ مُ ﭑ سُشُمَ بٍ.»<verse eid="ISA 44:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 44:17"/>عَ وُرِ دْنشْي نَن قِندِ مَ عَ شَ كُيٍ عَلَ رَ،</para>
  <para style="q" vid="ISA 44:17">عَ سُيِدِ نَشَن بّ عَ بَتُقٍ رَ.</para>
  <para style="q" vid="ISA 44:17">عَ مَشَندِ تِ عَ بّ، عَ قَلَقٍ رَ،</para>
  <para style="q" vid="ISA 44:17">«ﭑ نَكِسِ، بَرِ مَ عِ تَن نَن ﭑ مَ عَلَ رَ.»<verse eid="ISA 44:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 44:18"/>كْنْ نَ مِشِ مُ فّشِ قَهَامُي سْتْدٍ.</para>
  <para style="q" vid="ISA 44:18">عَ لُشِ عَلْ دْنشُي نَشَن مُ سٍ تٌمَ،</para>
  <para style="q" vid="ISA 44:18">عَ شَشِلِ مُ قَتَ قٍيٍ تَفِ رَبَدٍ.<verse eid="ISA 44:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 44:19"/>سٍسٍ مُ عَ عَ بْحّ رَتِمَ سْنْن، عَ شَ عَ مَحْشُن،</para>
  <para style="q" vid="ISA 44:19">«ﭑ بَرَ وُرِ سّيتِ سَ تّ عِ،</para>
  <para style="q" vid="ISA 44:19">عَلَكٌ ﭑ شَ تَامِ نُن سُبٍ فَن عَ تّ وٌلٍ رَ ﭑ نَشَن دٌنمَ.</para>
  <para style="q" vid="ISA 44:19">عَ لَنمَ ﭑ شَ نَ وُرِ دْنشْي رَقَلَ كُيٍ رَ عَلَ نَشَن شْنمَ؟</para>
  <para style="q" vid="ISA 44:19">ﭑ شَ ﭑ سُيِدِ وُرِ شُنتُنيِ بّ؟»<verse eid="ISA 44:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 44:20"/>نَ كُيٍ يَءِلَنمَ بِرَ مَ سٍ نَن قْشْ رَ نَشَن قِندِ مَ تّ شُبٍ رَ.</para>
  <para style="q" vid="ISA 44:20">عَ بْحّ بَرَ عَ يّتّ يَنقَ.</para>
  <para style="q" vid="ISA 44:20">عَ مُ قَتَ عَ يّتّ رَكِسِدٍ،</para>
  <para style="q" vid="ISA 44:20">عَ مَن مُ شَشِلِ سْتْ عَ قَلَقٍ رَ، «ﭑ نَشَن تِشِ ﭑ بّلّشّ رَ وُلٍ عَلَ نَن عَ رَ.»<verse eid="ISA 44:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="ISA 44:21"/>«يَشُبَ بْنسْي، وٌ شَ رَتُ يِ قٍيٍ مَ،</para>
  <para style="q" vid="ISA 44:21">وٌ تَن عِسِرَيِلَ حَمَ نَشَن قِندِشِ ﭑ مَ كٌنيِ رَ.</para>
  <para style="q" vid="ISA 44:21">ﭑ وٌ دَا نّ، عَلَكٌ وٌ شَ قِندِ ﭑ مَ كٌنيِ رَ.</para>
  <para style="q" vid="ISA 44:21">عِسِرَيِلَ، ﭑ مُ نّيمُمَ وٌ مَ.<verse eid="ISA 44:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 44:22"/>ﭑ بَرَ وٌ شَ يُنُبِيٍ شَقَرِ، وٌ نَشَن سْتْ وٌ شَ مُرُتّ كُي،</para>
  <para style="q" vid="ISA 44:22">ﭑ بَرَ نٍيٍ بَ نَا عَلْ نُشُي بَمَ كٌورٍ مَ كِ نَشّ.</para>
  <para style="q" vid="ISA 44:22">وٌ شَ فبِلٍن ﭑ مَ، بَرِ مَ ﭑ بَرَ وٌ شُن سَرَ.»<verse eid="ISA 44:22"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="23" style="v" sid="ISA 44:23"/>كٌورٍ شَ سّيوَ عَلَتَلَ شَ وَلِ شَ قٍ رَ.</para>
  <para style="q" vid="ISA 44:23">بْشِ بُنيِ شَ عَ شُي رَ مِنِ.</para>
  <para style="q" vid="ISA 44:23">فٍيَيٍ شَ عٍ شُي عِتٍ عَلْ وُرِ نَشٍيٍ نَ قْتْنيِ كُي،</para>
  <para style="q" vid="ISA 44:23">بَرِ مَ عَلَتَلَ بَرَ يَشُبَ شُن سَرَ،</para>
  <para style="q" vid="ISA 44:23">عَ بَرَ عَ نْرّ مَسٍن عِسِرَيِلَ يَ مَ.<verse eid="ISA 44:23"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="24" style="v" sid="ISA 44:24"/>وٌ رَكِسِمَ عَلَتَلَ شَ مَسٍنيِ نَن يَ نَشَن وٌ رَقَلَشِ وٌ نفَ تّيفّ،</para>
  <para style="q" vid="ISA 44:24">«ﭑ تَن، عَلَتَلَ نَن ﭑ نَ، نَشَن قٍ بِرِن دَاشِ،</para>
  <para style="q" vid="ISA 44:24">نَشَن كٌورٍ عِتَلَ،</para>
  <para style="q" vid="ISA 44:24">نَشَن بْشِ رَقَلَ عَ بّلّشّ رَ،<verse eid="ISA 44:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="ISA 44:25"/>نَشَن نَمِحْنمّ وُلٍ قَلّيٍ شَ تْنشُمَيٍ كَنَ،</para>
  <para style="q" vid="ISA 44:25">نَشَن سٍمَتٌي رَيَافِ،</para>
  <para style="q" vid="ISA 44:25">نَشَن لْننِلَيٍ شَ مَرَ سِ مَقِندِ لْننِتَرٍحَ رَ،<verse eid="ISA 44:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="ISA 44:26"/>نَشَن عَ شَ نَمِحْنمّ كٌنيِيٍ شَ مَسٍنيِيٍ رَكَمَلِ،</para>
  <para style="q" vid="ISA 44:26">نَشَن عَ شَ شّيرَيٍ شُي قِندِ نْندِ رَ،</para>
  <para style="q" vid="ISA 44:26">نَشَن عَ مَسٍنمَ دَرِ سَلَمُ شَ قٍ رَ، ‹حَمَ قَمَ سَبَتِدٍ نَا،›</para>
  <para style="q" vid="ISA 44:26">نَشَن عَ مَسٍنمَ يُدَيَ تَايٍ شَ قٍ رَ، ‹عٍ مَن قَمَ نّ تِدٍ،›<verse eid="ISA 44:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="ISA 44:27"/>نَشَن عَ قَلَمَ بَا بّ، ‹شَرَ، ﭑ عِ شَ يٍ رَشْرِ مَ نّ،›<verse eid="ISA 44:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="ISA 44:28"/>نَشَن مَنفّ سِرُ سِ شّيمَ عَ سَفٌ رَبَدٍ، عَلْ شُرُ سٍ مَدٌنيِ عَ رَبَمَ كِ نَشّ،</para>
  <para style="q" vid="ISA 44:28">نَشَن عَ مَسٍنمَ دَرِ سَلَمُ شَ قٍ رَ، ‹عَ مَن شَ تِ،›</para>
  <para style="q" vid="ISA 44:28">نَشَن عَ مَسٍنمَ هْرْ مْبَنشِ شَ قٍ رَ، ‹عَ مَن شَ تِ!›»<verse eid="ISA 44:28"/></para>
  <chapter eid="ISA 44"/>
  <chapter number="45" style="c" sid="ISA 45"/>
  <para style="s">عَلَ شَ وَلِ نُن سِرُ سِ</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 45:1"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ عَ شَ مِشِ سُفَندِشِ سِرُ سِ بّ،</para>
  <para style="q" vid="ISA 45:1">عَ نَشَن شّيشِ حَمَنّيٍ شُن نَكَنَقٍ رَ، عٍ شَ لُ عَ شَ يَامَرِ بُن مَ،</para>
  <para style="q" vid="ISA 45:1">عَ نَادّ رَبِشِ نَشَن بّ عَلَكٌ عَ شَ وَلِ شَ سْونّيَ.<verse eid="ISA 45:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 45:2"/>«ﭑ تِمَ نّ عِ يَ رَ، ﭑ تٍنتٍنيِ مَفٌرٌ عِ بّ،</para>
  <para style="q" vid="ISA 45:2">ﭑ وُرٍ فبٍيلِ نَادّيٍ كَنَ، ﭑ وُرٍ نَادّيٍ يٍنسٍن يّ عِ يَ رَ.<verse eid="ISA 45:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 45:3"/>ﭑ نَاقُلِ نْشُنشِ قِمَ نّ عِ مَ،</para>
  <para style="q" vid="ISA 45:3">عَلَكٌ عِ شَ عَ كٌلٌن ﭑ تَن نَن عِسِرَيِلَ مَرِفِ عَلَتَلَ رَ،</para>
  <para style="q" vid="ISA 45:3">نَشَن عِ شِلِشِ عِ شِلِ يَتِ رَ.<verse eid="ISA 45:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 45:4"/>ﭑ مَ كٌنيِ يَشُبَ شَ قٍ رَ،</para>
  <para style="q" vid="ISA 45:4">ﭑ مَ حَمَ سُفَندِشِ عِسِرَيِلَ،</para>
  <para style="q" vid="ISA 45:4">ﭑ عِ شِلِشِ عِ شِلِ نَن نَ، ﭑ بِنيّ قِمَ نّ عِ مَ هَلِ عِ تٌ مُ ﭑ كٌلٌنشِ سِندٍن.<verse eid="ISA 45:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 45:5"/>ﭑ تَن نَن نَ عَلَتَلَ رَ،</para>
  <para style="q" vid="ISA 45:5">عَلَ فبّتّ يٌ مُ نَ بَقٍ ﭑ تَن نَ.</para>
  <para style="q" vid="ISA 45:5">ﭑ سّنبّ قِمَ نّ عِ مَ هَلِ عِ تٌ مُ ﭑ كٌلٌنشِ سِندٍن.<verse eid="ISA 45:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 45:6"/>نَ كُي مِشِ بِرِن قَمَ نّ عَ كٌلٌندٍ عَ عَلَ كٍرٍنيِ نَن ﭑ نَ،</para>
  <para style="q" vid="ISA 45:6">كٍلِقٍ سٌفٍتٍدٍ هَن سٌفٍفٌرٌدٍ،</para>
  <para style="q" vid="ISA 45:6">عَلَ فبّتّ يٌ مُ نَ.<verse eid="ISA 45:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 45:7"/>ﭑ تَن نَن كٌورٍ عِيَلَنمَ، ﭑ دِ مِ رَ سِن،</para>
  <para style="q" vid="ISA 45:7">ﭑ تَن نَن هّرِ رَ مِنِمَ، ﭑ فبَلٌي رَبَ.</para>
  <para style="q" vid="ISA 45:7">ﭑ تَن عَلَتَلَ نَ ﭑ نَ قٍيٍ بِرِن نَبَمَ.»<verse eid="ISA 45:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="ISA 45:8"/>«تُنّ يٍ شَ فٌرٌ كٍلِقٍ كٌورٍ مَ، نُشُي شَ رَبِ يٍ رَ مِنِقٍ رَ.</para>
  <para style="q" vid="ISA 45:8">بْشِ قَن شَ رَبِ نَ يٍ سْتْقٍ رَ.</para>
  <para style="q" vid="ISA 45:8">كِسِ شَ سْتْ عَلْ سَنسِ بُلَمَ كِ نَشّ، تِنشِنيِ شَ لُ نَ.</para>
  <para style="q" vid="ISA 45:8">ﭑ تَن عَلَتَلَ نَن نَ بِرِن دَاشِ.»<verse eid="ISA 45:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="ISA 45:9"/>حَشَنكَتّ نَ مِشِ بّ، نَشَن عَ يَءِلَنمَ مَتَندِ مَ،</para>
  <para style="q" vid="ISA 45:9">نَشَن قِندِشِ قّحّ شُنتُنيِ تُن نَ.</para>
  <para style="q" vid="ISA 45:9">بّندّ دٌلٌشِ عَ قَلَمَ قّحّ يَءِلَنمَ بّ،</para>
  <para style="q" vid="ISA 45:9">«عِ ﭑ يَءِلَنقٍ مُنسٍ رَ؟ عِ شَ وَلِ مُ قَن!»<verse eid="ISA 45:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 45:10"/>حَشَنكَتّ نَ مِشِ بّ، نَشَن عَ قَلَمَ عَ بَبَ نُن عَ نفَ بّ،</para>
  <para style="q" vid="ISA 45:10">«وٌ مُنسٍ بَرِشِ؟»<verse eid="ISA 45:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="ISA 45:11"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ،</para>
  <para style="q" vid="ISA 45:11">عِسِرَيِلَ شَ سّنِيّنتْي نَشَن وٌ دَاشِ،</para>
  <para style="q" vid="ISA 45:11">«وٌ وَ مَ ﭑ مَشْرِنقٍ تِنَ قٍ نَن مَ ﭑ نَشَن نَبَمَ ﭑ مَ دِيٍ رَ؟</para>
  <para style="q" vid="ISA 45:11">وٌ وَ مَ ﭑ يَمَرِقٍ ﭑ مَ وَلِ شَ قٍ نَن نَ؟<verse eid="ISA 45:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 45:12"/>ﭑ تَن نَن بْشِ يَءِلَنشِ، ﭑ قَ مِشِ دَا عَ قَرِ.</para>
  <para style="q" vid="ISA 45:12">ﭑ تَن نَن كٌورٍ عِتَلَ ﭑ بّلّشّ رَ، ﭑ تُنبُييٍ يَمَرِ.<verse eid="ISA 45:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 45:13"/>ﭑ تَن نَن مَن سِرُ سِ شّيمَ ﭑ مَ تِنشِنيِ شَ قٍ رَ.</para>
  <para style="q" vid="ISA 45:13">ﭑ كِرَ رَبْو مَ نّ عَ بّ عَلَكٌ عَ شَ ﭑ مَ تَا تِ،</para>
  <para style="q" vid="ISA 45:13">عَ شَ ﭑ مَ حَمَ شْرْيَ شُنسَرٍ شَنبِ.»</para>
  <para style="q" vid="ISA 45:13">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="ISA 45:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="ISA 45:14"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ،</para>
  <para style="q" vid="ISA 45:14">«مِسِرَ نُن عٍتِيٌثِ شَ نَاقُلِ لُمَ نّ عِ يِ رَ،</para>
  <para style="q" vid="ISA 45:14">سٍبَكَيٍ قِندِ مَ نّ عِ شَ كٌنيِيٍ رَ،</para>
  <para style="q" vid="ISA 45:14">عٍ بِرَ عِ قْشْ رَ يْلْنشْنيِ كُي، عٍ سُيِدِ عِ بّ، عٍ عَ قَلَ عِ بّ،</para>
  <para style="q" vid="ISA 45:14">‹عَلَ نَ عِ قْشْ رَ، عَ مَنِيّ مُ نَ، عَلَ فبّتّ مُ نَ.›»<verse eid="ISA 45:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="ISA 45:15"/>عِسِرَيِلَ مَرِفِ عَلَ، عَ رَكِسِمَ،</para>
  <para style="q" vid="ISA 45:15">عَلَ نَن عِ رَ، نَشَن مُ عَ يّتّ مَسٍنمَ كّنّ مَ.<verse eid="ISA 45:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 45:16"/>كُيٍ يَءِلَنمَيٍ قَمَ نّ لُدٍ يَافِ كُي، عٍ عٍ بِرِن شَنِن،<verse eid="ISA 45:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 45:17"/>كْنْ عَلَتَلَ عِسِرَيِلَ تَن رَكِسِمَ نّ عَبَدَن،</para>
  <para style="q" vid="ISA 45:17">عَ مُ قَمَ يَافِدٍ قٍوٌ.<verse eid="ISA 45:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 45:18"/>عَلَتَلَ نَشَن كٌورٍ دَاشِ، نَشَن قِرِن ندٍ مُ نَ،</para>
  <para style="q" vid="ISA 45:18">نَشَن دُنِحَ دَاشِ عَ كِ نُن عَ كّحَ نَن مَ،</para>
  <para style="q" vid="ISA 45:18">عَ قَ عَدَ مَدِيٍ رَ سَبَتِ عَ مَ،</para>
  <para style="q" vid="ISA 45:18">عَ قَ عَ قَلَ، «عَلَتَلَ نَن نَ، عَلَ فبّتّ يٌ مُ نَ.<verse eid="ISA 45:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 45:19"/>ﭑ مُ وْيّنشِ دُنشُي شَ رَ دٍ.</para>
  <para style="q" vid="ISA 45:19">ﭑ مُ عَ قَلَ يَشُبَ بْنسْي بّ عٍ شَ ﭑ قٍن نَ كِ تُن.</para>
  <para style="q" vid="ISA 45:19">ﭑ تَن عَلَتَلَ نْندِ نَن قَلَمَ، ﭑ تِنشِنيِ نَن مَسٍنمَ.»<verse eid="ISA 45:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="ISA 45:20"/>«وٌ وٌ مَلَن، وٌ قَ، وٌ وٌ مَسٌ، وٌ تَن مِشِ فِشِيٍ كٍلِقٍ حَمَنّيٍ مَ،</para>
  <para style="q" vid="ISA 45:20">كُيٍ بَتُييٍ مُ سٍسٍ كٌلٌن،</para>
  <para style="q" vid="ISA 45:20">عٍ كُيٍ مَشَندِ مَ نَشٍيٍ مُ نْمَ مِشِ رَكِسِدٍ.<verse eid="ISA 45:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 45:21"/>وٌ وٌ شُي رَ مِنِ، وٌ شَ مَرَكٌلٌنيِ تِ عٍ بّ.</para>
  <para style="q" vid="ISA 45:21">عٍ شَ عٍ بٌرٍ رَ سِ.</para>
  <para style="q" vid="ISA 45:21">ندٍ يِ مَسٍنيِ تِشِ كَبِ تّمُي شْنكُيٍ؟ ﭑ تَن شَ مُ عَ رَ؟</para>
  <para style="q" vid="ISA 45:21">عَلَ فبّتّ يٌ مُ نَ بَقٍ ﭑ تَن نَ،</para>
  <para style="q" vid="ISA 45:21">عَلَ نَشَن تِنشِن، نَشَن مِشِ رَكِسِمَ.<verse eid="ISA 45:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 45:22"/>وٌ شَ فبِلٍن ﭑ مَ، وٌ تَن نَشٍيٍ كٍلِمَ دُنِحَ تُنشُنيِيٍ مَ،</para>
  <para style="q" vid="ISA 45:22">عَلَكٌ وٌ شَ كِسِ سْتْ،</para>
  <para style="q" vid="ISA 45:22">بَرِ مَ عَلَ فبّتّ يٌ مُ نَ بَقٍ ﭑ تَن نَ.<verse eid="ISA 45:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 45:23"/>ﭑ بَرَ ﭑ كَلِ ﭑ يّتّ رَ نْندِ كِ مَ،</para>
  <para style="q" vid="ISA 45:23">ﭑ مَ مَسٍنيِ مُ كَنَمَ قٍقٍ مَ.</para>
  <para style="q" vid="ISA 45:23">شِنبِ بِرِن سِنمَ نّ ﭑ بُن مَ،</para>
  <para style="q" vid="ISA 45:23">كَلِ بِرِن نَبَمَ ﭑ تَن نَن شِلِ رَ.<verse eid="ISA 45:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="ISA 45:24"/>حَمَ عَ قَلَمَ نّ ﭑ بّ،</para>
  <para style="q" vid="ISA 45:24">‹تِنشِنيِ نُن سّنبّ تٌمَ عِ تَن عَلَتَلَ نَن فبَنسَن يِ.›»</para>
  <para style="b" vid="ISA 45:24"/>
  <para style="q" vid="ISA 45:24">مِشِ نَشٍيٍ نُ مُرُتَشِ عَ مَ،</para>
  <para style="q" vid="ISA 45:24">عٍ قَمَ نّ عَ يِرٍ يَافِ كُي.<verse eid="ISA 45:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="ISA 45:25"/>كْنْ عِسِرَيِلَ بْنسْي فبٍ حْشْمَ نّ عَلَتَلَ سَابُي رَ،</para>
  <para style="q" vid="ISA 45:25">عٍ قَ شُننَكٍلِ سْتْ.<verse eid="ISA 45:25"/></para>
  <chapter eid="ISA 45"/>
  <chapter number="46" style="c" sid="ISA 46"/>
  <para style="s">بَبِلْن شَ عَلَيٍ</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 46:1"/>بَبِلْن شَ كُيٍ بٍلِ عَ شِنبِ سِنمَ.</para>
  <para style="q" vid="ISA 46:1">عَ شَ كُيٍ نٍبٌ قَن عَ قٍلٍنمَ بْشِ مَ.</para>
  <para style="q" vid="ISA 46:1">سٌقَلٍيٍ عٍ بّندُنمَ شَنِن سٍ قَرِ.</para>
  <para style="q" vid="ISA 46:1">نَ كٌتٍ بِنيَ، عَ سٌقَلٍيٍ رَتَفَنمَ نّ.<verse eid="ISA 46:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 46:2"/>عٍ مُ نْ نَ كُيٍيٍ رَتَنفَدٍ.</para>
  <para style="q" vid="ISA 46:2">عٍ بِرِن شَ سِفَ كٌنيِيَ كُي.<verse eid="ISA 46:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="ISA 46:3"/>«يَشُبَ بْنسْي، وٌ وٌ تُلِ مَتِ ﭑ نَ.</para>
  <para style="q" vid="ISA 46:3">عِسِرَيِلَكَ نَشٍيٍ لُشِ، وٌ وٌ تُلِ مَتِ ﭑ نَ.</para>
  <para style="q" vid="ISA 46:3">كَبِ وٌ بَرِشِ تّمُي نَشّ، ﭑ بَرَ وٌ شَنِن ﭑ بّلّشّ، ﭑ بَرَ وٌ بُن تِ.<verse eid="ISA 46:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 46:4"/>ﭑ نُ نَ رَبَ نّ هَن وٌ قٌرِ وَشَتِ.</para>
  <para style="q" vid="ISA 46:4">وٌ شُنسّشّ تٌ نُ قِيشّمَ، ﭑ تَن نَن مَن نُ وٌ بُن تِمَ.</para>
  <para style="q" vid="ISA 46:4">ﭑ تٌ وٌ دَا، ﭑ مَن نُ وٌ مَلِمَ نّ، ﭑ وٌ شَنِن، ﭑ وٌ رَكِسِ.<verse eid="ISA 46:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 46:5"/>وٌ ﭑ مَ مَنِيّ تٌمَ مِندٍن؟ وٌ ﭑ قِرِن ندٍ كٌلٌن؟<verse eid="ISA 46:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 46:6"/>نَاقُلِ كَنيِ شّيمَ نُن فبٍتِ رَ مِنِمَ، عَ عَ سَ سِكٍيلِ قَرِ،</para>
  <para style="q" vid="ISA 46:6">عَلَكٌ شَبُي شَ كُيٍ ندٍ يَءِلَن عَ بّ،</para>
  <para style="q" vid="ISA 46:6">عَ عَ شِنبِ سِنمَ نَشَن بّ عَ بَتُقٍ رَ.<verse eid="ISA 46:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 46:7"/>عٍ نَ تٌنفٌ، عٍ عَ دْشْ عٍ تُنكِ قَرِ، عٍ عَ شَنِن يِرٍ، عٍ عَ تِمَ دّننَشّ.</para>
  <para style="q" vid="ISA 46:7">مّننِ عَ تِشِ تُن، عَ مُ سِفَمَ دّدّ.</para>
  <para style="q" vid="ISA 46:7">هَلِ مِشِ ندٍ عَ مَوَ عَ بّ، عَ مُ عَ يَابِمَ،</para>
  <para style="q" vid="ISA 46:7">عَ مُ مِشِ رَتَنفَمَ عَ شَ تْورّ مَ.»<verse eid="ISA 46:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="ISA 46:8"/>«وٌ تَن مُرُتّلَيٍ، وٌ شَ رَتُ نَ قٍيٍ مَ، عَلَكٌ وٌ شَ نْ كِسِدٍ.<verse eid="ISA 46:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 46:9"/>وٌ شَ رَتُ ﭑ نَشَن نَبَشِ تّمُي دَنفِشِ.</para>
  <para style="q" vid="ISA 46:9">عَلَ فبّتّ يٌ مُ نَ بَقٍ ﭑ تَن نَ، ﭑ قِرِن ندٍ مُ نَ.<verse eid="ISA 46:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 46:10"/>عَلَ فبّتّ مُ نَ نَشَن قٍ مَسٍنمَ بٍينُن عَ شَ رَبَ،</para>
  <para style="q" vid="ISA 46:10">نَشَن نْمَ عَ قَلَدٍ،</para>
  <para style="q" vid="ISA 46:10">‹ﭑ وَشْنقٍ قَمَ نّ رَكَمَلِدٍ. ﭑ تَن نَن عَ رَفِرِ مَ.›<verse eid="ISA 46:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 46:11"/>ﭑ تَن نَن شْنِ ندٍ شِلِمَ كٍلِقٍ سٌفٍتٍدٍ مَبِرِ،</para>
  <para style="q" vid="ISA 46:11">نَشَن ﭑ وَشْنقٍ رَبَمَ ﭑ بّ.</para>
  <para style="q" vid="ISA 46:11">عِيٌ، ﭑ نَشَن قَلَشِ، ﭑ عَ رَبَمَ نّ،</para>
  <para style="q" vid="ISA 46:11">ﭑ نَشَن نَتّشِ، ﭑ عَ رَكَمَلِمَ نّ.<verse eid="ISA 46:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 46:12"/>وٌ وٌ تُلِ مَتِ ﭑ نَ، وٌ تَن نَشٍيٍ شَشِلِ شْرْشْ،</para>
  <para style="q" vid="ISA 46:12">وٌ تَن نَشٍيٍ مَكُيَشِ تِنشِنيِ رَ.<verse eid="ISA 46:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 46:13"/>ﭑ مَ كِيتِ تِنشِنشِ بَرَ مَكْرّ، عَ مُ مَكُيَ قٍوٌ.</para>
  <para style="q" vid="ISA 46:13">ﭑ قَمَ ﭑ مَ كِسِ قَن نَ، عَ مُ بُمَ.</para>
  <para style="q" vid="ISA 46:13">ﭑ سِيٌن رَكِسِمَ نّ،</para>
  <para style="q" vid="ISA 46:13">ﭑ نَن ﭑ مَ نْرّ رَفٌرٌ مَ نّ عِسِرَيِلَ مَ.»<verse eid="ISA 46:13"/></para>
  <chapter eid="ISA 46"/>
  <chapter number="47" style="c" sid="ISA 47"/>
  <para style="s">بَبِلْن بِرَقٍ</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 47:1"/>«بَبِلْن تَا، كٍلِ عِ شَ كِبَنيِ كُي، عِ دْشْ بْشِ مَ.</para>
  <para style="q" vid="ISA 47:1">عِ شَ تٌقَنيِ نُن عِ شَ بَننَيَ بَمَ نّ عِ يِ.<verse eid="ISA 47:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 47:2"/>وَلِ سٍيٍ تٌنفٌ كُرِ سٌقٍ رَ.</para>
  <para style="q" vid="ISA 47:2">عِ شَ مَقٍلٍنيِ بَمَ نّ عِ مَ، عِ شَ دُفِ مَتٍ، عِ شُرٍ عِفِرِ عِ مَفٍلِ رَ.<verse eid="ISA 47:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 47:3"/>عِ حَءِبْمَ نّ يَافِ كُي،</para>
  <para style="q" vid="ISA 47:3">ﭑ قَمَ نّ ﭑ فبٍ حْشْدٍ كِنِكِنِ شَنبِ.»<verse eid="ISA 47:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 47:4"/>عَلَتَلَ سّنبّمَ نَن قِندِ مُشُ شُنسَرَ مَ رَ، عِسِرَيِلَ شَ سّنِيّنتْي.<verse eid="ISA 47:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="ISA 47:5"/>«بَبِلْن حَمَ، وٌ دْشْ، وٌ وٌ دّ بَلَن.</para>
  <para style="q" vid="ISA 47:5">وٌ شَ مَنفّيَ بَرَ حْن.<verse eid="ISA 47:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 47:6"/>ﭑ نُ شْنْشِ ﭑ مَ حَمَ مَ، ﭑ قَ عٍ كّ تٌنفٌمَيٍ شُن نَكَنَ.</para>
  <para style="q" vid="ISA 47:6">ﭑ نَشَ عٍ لُ وٌ سَفٌي، كْنْ وٌ مُ كِنِكِنِ عٍ مَ قٍقٍ مَ.</para>
  <para style="q" vid="ISA 47:6">هَلِ قٌرِيٍ، وٌ بَرَ عٍ حَشَنكَتَ عَ حَاشِ رَ.<verse eid="ISA 47:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 47:7"/>وٌ نُ عَ قَلَمَ نّ، ‹ﭑ مَ مَنفّيَ مُ حْنمَ عَبَدَن!›</para>
  <para style="q" vid="ISA 47:7">كْنْ وٌ مُ وٌ حْشْ سَشِ قٍ شْن مَ نَشَن نْمَ وٌ لِدٍ.»<verse eid="ISA 47:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="ISA 47:8"/>«يَكْسِ وٌ وٌ تُلِ مَتِ ﭑ نَ،</para>
  <para style="q" vid="ISA 47:8">وٌ تَن بَننَ نَشٍيٍ عَ مَحْشُنشِ عَ قٍقٍ مُ نْمَ وٌ تْورْدٍ،</para>
  <para style="q" vid="ISA 47:8">نَشٍيٍ عَ قَلَمَ، ‹ﭑ كٍرٍن نَن تِدٍ فبٌ دُنِحَ،</para>
  <para style="q" vid="ISA 47:8">ﭑ مُ قِندِ مَ كَاحّ رَ، ﭑ مَ دِيٍ مُ بَمَ ﭑ يِ.›<verse eid="ISA 47:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 47:9"/>كْنْ ﭑ شَ عَ قَلَ وٌ بّ، نَ قٍ قِرِنيِيٍ وٌ لِمَ نّ قّيحّن كٍرٍن كُي.</para>
  <para style="q" vid="ISA 47:9">وٌ فَنمَ نّ وٌ شَ دِيٍ رَ، وٌ قِندِ كَاحّ رَ</para>
  <para style="q" vid="ISA 47:9">هَلِ وٌ دُورٍيَ نُن كَرَ مْشْ وَلِ رَوُيَ.<verse eid="ISA 47:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 47:10"/>وٌ نُ لَشِ وٌ شَ حَاشُحَ نَن نَ،</para>
  <para style="q" vid="ISA 47:10">وٌ حْشْ عَ مَ نَ مُ تٌمَ.</para>
  <para style="q" vid="ISA 47:10">وٌ شَ قٍ كٌلٌنيِ بَرَ وٌ مَدَشُ.</para>
  <para style="q" vid="ISA 47:10">وٌ بَرَ عَ قَلَ وٌ بْحّ مَ، ‹ﭑ كٍرٍن نَن بٍ، ﭑ تَن نَن فبَنسَن تِدٍ فبٌ.›<verse eid="ISA 47:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 47:11"/>فبَلٌي قَمَ نّ وٌ لِدٍ، وٌ مُ نْمَ وٌ يّتّ رَتَنفَدٍ نَشَن مَ وٌ شَ نَاقُلِ رَ،</para>
  <para style="q" vid="ISA 47:11">فبَلٌي نَشَن وٌ تّرّننَمَ.»<verse eid="ISA 47:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="ISA 47:12"/>«وٌ تٌ لَشِ نَ قٍ مْولِ نَن نَ، وٌ شَ لُ وٌ شَ دُورٍيَ،</para>
  <para style="q" vid="ISA 47:12">نُن وٌ شَ مَندُرُيَ كُي وٌ دَرِشِ نَشَن نَ.</para>
  <para style="q" vid="ISA 47:12">وٌ عَ مَحْشُن عَ نَ سْونّيَمَ نّ وٌ بّ، وٌ قَ فٍينِ وٌ يَشُي شُن مَ،<verse eid="ISA 47:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 47:13"/>كْنْ نَ بِرِن قَمَ نّ وٌ رَتَفَندٍ.</para>
  <para style="q" vid="ISA 47:13">وٌ شَ سٍ مَتٌي شِلِ، نَشٍيٍ كٌورٍ مَتٌمَ، عٍ قٍ قَلَ نَشَن قَمَ وٌ لِدٍ.<verse eid="ISA 47:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 47:14"/>نٍيٍ تَن قَن لُمَ نّ عَلْ سّشّ نَشَن فَنمَ تّ رَ.</para>
  <para style="q" vid="ISA 47:14">عٍ مُ نْمَ عٍ يّتّ رَكِسِدٍ تّ شْورَ.</para>
  <para style="q" vid="ISA 47:14">سٍسٍ مُ لُمَ عٍ يِ رَ، هَلِ تّ شُنشُرِ عٍ دْشْمَ نَشَن سّيتِ مَ شِنبٍلِ تّمُي.<verse eid="ISA 47:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 47:15"/>عٍ مُ نْمَ قٍقٍ رَبَدٍ وٌ بّ،</para>
  <para style="q" vid="ISA 47:15">هَلِ وٌ تٌ بَرَ وٌ شَشِلِ تِ عٍ رَ كَبِ وٌ دِ مّدِ تّمُي.</para>
  <para style="q" vid="ISA 47:15">عٍ سِفَمَ نّ يَرٍ عٍ شَ كِرَ حَاشِ شْن مَ.</para>
  <para style="q" vid="ISA 47:15">مِشِ يٌ مُ نْمَ وٌ رَكِسِدٍ.»<verse eid="ISA 47:15"/></para>
  <chapter eid="ISA 47"/>
  <chapter number="48" style="c" sid="ISA 48"/>
  <para style="s">عِسِرَيِلَ نُن عَلَ شَ لَنيِ</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 48:1"/>«يَشُبَ بْنسْي نَشَن شِلِ عِسِرَيِلَ، نَشَن قَتَنشِ يُدَيَ رَ،</para>
  <para style="q" vid="ISA 48:1">وٌ وٌ تُلِ مَتِ ﭑ نَ.</para>
  <para style="q" vid="ISA 48:1">وٌ تَن نَشٍيٍ وٌ كَلِمَ عَلَتَلَ شِلِ رَ،</para>
  <para style="q" vid="ISA 48:1">وٌ تَن نَشٍيٍ عِسِرَيِلَ مَرِفِ عَلَ مَشَندِ مَ تِنشِنتَرٍيَ كُي،<verse eid="ISA 48:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 48:2"/>وٌ تَن نَشٍيٍ وٌ يّتّ شِلِمَ تَا سّنِيّنشِ كَنيِيٍ،</para>
  <para style="q" vid="ISA 48:2">وٌ تَن نَشٍيٍ وٌ شَشِلِ تِمَ عِسِرَيِلَ مَرِفِ عَلَتَلَ رَ،<verse eid="ISA 48:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 48:3"/>ﭑ نَشَن مَسٍنشِ وٌ بّ تّمُي دَنفِشِ، ﭑ بَرَ فّ نَ رَفِرِدٍ.<verse eid="ISA 48:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 48:4"/>ﭑ تٌ عَ كٌلٌن وٌ شَشِلِ شْرْشْ عَلْ وُرٍ،<verse eid="ISA 48:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 48:5"/>ﭑ نَشَ وٌ رَكٌلٌن نَ قٍ رَ بٍينُن عَ شَ رَبَ،</para>
  <para style="q" vid="ISA 48:5">عَلَكٌ وٌ نَشَ قَ عَ قَلَ،</para>
  <para style="q" vid="ISA 48:5">‹مُشُ شَ كُيٍ وُرِ دَاشِيٍ نُن وُرٍ دَاشِيٍ نَن نَ قٍ نَتّشِ.›<verse eid="ISA 48:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 48:6"/>وٌ بَرَ نَ مّ؟ وٌ بَرَ سٌ نَ قٍ كُي؟»</para>
  <para style="b" vid="ISA 48:6"/>
  <para style="q" vid="ISA 48:6">«يَكْسِ ﭑ قٍ نّينّيٍ مَسٍنمَ نّ وٌ بّ،</para>
  <para style="q" vid="ISA 48:6">نَشٍيٍ نُ بَرَ نْشُن وٌ مَ.<verse eid="ISA 48:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 48:7"/>نٍيٍ مِنِشِ يِ وَشَتِ نّ،</para>
  <para style="q" vid="ISA 48:7">وٌ مُ نُ نَشٍيٍ كٌلٌن.</para>
  <para style="q" vid="ISA 48:7">نَ كُي وٌ مُ نْمَ عَ قَلَدٍ، ‹عِيٌ، مُشُ نُ نٍيٍ كٌلٌن.›<verse eid="ISA 48:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 48:8"/>وٌ مُ نَ قٍيٍ قَهَامُشِ تّمُي دَنفِشِ بَرِ مَ وٌ تُلِ شْرْشْ.</para>
  <para style="q" vid="ISA 48:8">يَنقَنتٍيٍ نَن وٌ رَ كَبِ وٌ بَرِ تّمُي.<verse eid="ISA 48:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 48:9"/>ﭑ شِلِ شَ قٍ رَ، ﭑ مُ ﭑ مَ شْنّ رَ مِنِ وٌ مَ كٍرٍنيِ رَ.</para>
  <para style="q" vid="ISA 48:9">ﭑ مَ مَتْشْي شَ قٍ رَ، ﭑ مُ وٌ رَبٌلٌ.<verse eid="ISA 48:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 48:10"/>ﭑ بَرَ وٌ مَتٌ، كْنْ ﭑ مُ عَ رَبَشِ عَلْ شَبُي عَ رَبَمَ كِ نَشّ فبٍتِ رَ.</para>
  <para style="q" vid="ISA 48:10">ﭑ وٌ مَتٌمَ تْورّ نَن سَابُي رَ.<verse eid="ISA 48:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 48:11"/>ﭑ يِ رَبَمَ ﭑ يّتّ بّ عَلَكٌ ﭑ شِلِ نَشَ كَنَ،</para>
  <para style="q" vid="ISA 48:11">عَلَكٌ ﭑ مَ مَتْشْي نَشَ قِ ﭑ قِرِن ندٍ مَ.»<verse eid="ISA 48:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="ISA 48:12"/>«يَشُبَ بْنسْي، وٌ وٌ تُلِ مَتِ ﭑ نَ.</para>
  <para style="q" vid="ISA 48:12">عِسِرَيِلَ ﭑ نَشَن شِلِشِ، وٌ وٌ تُلِ مَتِ ﭑ نَ.</para>
  <para style="q" vid="ISA 48:12">ﭑ تَن نَن نَ عَ سِنفٍ رَ، ﭑ تَن نَن نَ عَ دْنشْي رَ.<verse eid="ISA 48:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 48:13"/>ﭑ بّلّشّ نَن دُنِحَ بُنيِ سَشِ،</para>
  <para style="q" vid="ISA 48:13">ﭑ سّنبّ نَن كٌورٍ عِتَلَشِ.</para>
  <para style="q" vid="ISA 48:13">ﭑ نَ عٍ شِلِ، عٍ تِمَ نّ كٍرٍن نَ.»<verse eid="ISA 48:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="ISA 48:14"/>«وٌ شَ وٌ مَلَن، وٌ شَ وٌ تُلِ مَتِ ﭑ نَ.</para>
  <para style="q" vid="ISA 48:14">كُيٍ مُندُن بَرَ يِ قٍ مَسٍن وٌ بّ بٍينُن عَ شَ رَبَ؟</para>
  <para style="q" vid="ISA 48:14">عَلَتَلَ بَرَ مِشِ ندٍ سُفَندِ نَشَن عَ سَفٌي رَبَمَ بَبِلْن نَ،</para>
  <para style="q" vid="ISA 48:14">نَشَن عٍ شِلِ شُن نَكَنَمَ.<verse eid="ISA 48:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 48:15"/>عِيٌ، ﭑ تَن يَتِ بَرَ ﭑ مَ مَسٍنيِ تِ،</para>
  <para style="q" vid="ISA 48:15">ﭑ بَرَ عَ شِلِ، عَ شَ نَ وَلِ رَكَمَلِ.»<verse eid="ISA 48:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="ISA 48:16"/>«وٌ وٌ مَسٌ ﭑ نَ، وٌ شَ وٌ تُلِ مَتِ.</para>
  <para style="q" vid="ISA 48:16">كَبِ عَ قْلّ، ﭑ مُ وْيّن دُنشُي رَ.</para>
  <para style="q" vid="ISA 48:16">نَ قٍ رَبَمَ ﭑ يَ شْرِ.»</para>
  <para style="b" vid="ISA 48:16"/>
  <para style="q" vid="ISA 48:16">يَكْسِ، ﭑ مَرِفِ عَلَتَلَ نَ ﭑ شّيقٍ، عَ عَ شَشِلِ رَفٌرٌشِ ﭑ مَ.<verse eid="ISA 48:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="ISA 48:17"/>وٌ رَكِسِمَ عَلَتَلَ، عِسِرَيِلَ شَ سّنِيّنتْي، عَ شَ مَسٍنيِ نَن يَ،</para>
  <para style="q" vid="ISA 48:17">«ﭑ تَن قِندِشِ وٌ مَرِفِ عَلَتَلَ نَن نَ،</para>
  <para style="q" vid="ISA 48:17">نَشَن وٌ شَ قٍ سْونّيَ كِ مَسٍنمَ،</para>
  <para style="q" vid="ISA 48:17">نَشَن وٌ رَحّرّ مَ حّرّ كِ قَنيِ رَ.<verse eid="ISA 48:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 48:18"/>شَ وٌ وٌ حْشْ سَ ﭑ مَ سّرِيّ شْن مَ نُ،</para>
  <para style="q" vid="ISA 48:18">بْحّسَ نُن كِسِ نُ فبٌمَ نّ وٌ يِ رَ عَلْ يٍ نَشَن نَ بَا مَ.<verse eid="ISA 48:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 48:19"/>وٌ بْنسْي نُ وُيَمَ نّ عَلْ مّيّنيِ نَشَن نَ بَا دّ رَ،</para>
  <para style="q" vid="ISA 48:19">وٌ شَ دِيٍ شِلِيٍ مُ نُ بَمَ ﭑ يَ عِ.<verse eid="ISA 48:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 48:20"/>وٌ شَ كٍلِ بَبِلْن سّيوّ شُي رَ.</para>
  <para style="q" vid="ISA 48:20">وٌ شَ نَ مَسٍن دُنِحَ بِرِن بّ.</para>
  <para style="q" vid="ISA 48:20">وٌ شَ عَ قَلَ، ‹عَلَتَلَ بَرَ عَ كٌنيِ يَشُبَ شُن سَرَ.›<verse eid="ISA 48:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 48:21"/>يٍ شْلِ مُ لُمَ عٍ مَ فبٍنفبٍرٍنيِ مَ،</para>
  <para style="q" vid="ISA 48:21">عَ قَنيٍ عِبْو مَ، عَ يٍ رَ مِنِ عَ كُي.<verse eid="ISA 48:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 48:22"/>مِشِ حَاشِ شَ قٍ مُ سْونّيَمَ.»</para>
  <para style="q" vid="ISA 48:22">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="ISA 48:22"/></para>
  <chapter eid="ISA 48"/>
  <chapter number="49" style="c" sid="ISA 49"/>
  <para style="s">عَلَتَلَ شَ كٌنيِ</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 49:1"/>سِ يٍنسٍنشِيٍ، وٌ شَ وٌ تُلِ مَتِ ﭑ نَ.</para>
  <para style="q" vid="ISA 49:1">يِرٍ مَكُيٍيٍ، وٌ شَ وٌ حْشْ سَ ﭑ وْيّن شُي شْن مَ.</para>
  <para style="q" vid="ISA 49:1">عَلَتَلَ ﭑ شِلِ نّ كَبِ ﭑ نفَ تّفّ،</para>
  <para style="q" vid="ISA 49:1">عَ نَشَ ﭑ شِلِ قَلَ بٍينُن ﭑ شَ مِنِ قٌيٍ رَ.<verse eid="ISA 49:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 49:2"/>عَ نَشَ ﭑ دّ لُ عَلْ سَنتِدّفّمَ شّحّنشِ عَ بّلّشّ،</para>
  <para style="q" vid="ISA 49:2">عَ نَشَ ﭑ قِندِ شَلِ حْي رَ مٍلُشِ رَ،</para>
  <para style="q" vid="ISA 49:2">عَ نَشَ ﭑ سَ عَ شَ شَلِ فبْنقْي كُي.<verse eid="ISA 49:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 49:3"/>عَ نَشَ عَ قَلَ ﭑ بّ، «عِسِرَيِلَ، ﭑ مَ كٌنيِ نَن عِ رَ،</para>
  <para style="q" vid="ISA 49:3">ﭑ نَ ﭑ مَ نْرّ مَسٍنمَ نَشَن سَابُي رَ.»<verse eid="ISA 49:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 49:4"/>كْنْ ﭑ نَشَ عَ يَابِ، «ﭑ مَ وَلِ مُ سْونّيَشِ،</para>
  <para style="q" vid="ISA 49:4">ﭑ بَرَ كَتَ، كْنْ قُقَقُ نَ عَ رَ.</para>
  <para style="q" vid="ISA 49:4">ﭑ مَ وَلِ سَرٍ نَ ﭑ مَرِفِ عَلَتَلَ نَن يِ.»<verse eid="ISA 49:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="ISA 49:5"/>نَ كُي عَلَتَلَ نَشَ مَسٍنيِ ندٍ تِ،</para>
  <para style="q" vid="ISA 49:5">نَشَن ﭑ دَا ﭑ نفَ تّفّ عِ، ﭑ شَ قِندِ عَ شَ كٌنيِ رَ،</para>
  <para style="q" vid="ISA 49:5">عَلَكٌ ﭑ شَ يَشُبَ بْنسْي رَفبِلٍن عَ مَ،</para>
  <para style="q" vid="ISA 49:5">عِسِرَيِلَ حَمَ مَن شَ مَلَن عَ قّ مَ.</para>
  <para style="q" vid="ISA 49:5">عَلَتَلَ بَرَ بِنيّ شُنفبٍ قِ ﭑ مَ،</para>
  <para style="q" vid="ISA 49:5">عَ تَن نَشَن قِندِشِ ﭑ سّنبّ رَ.<verse eid="ISA 49:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 49:6"/>عَ نَشّ، «يَشُبَ بْنسْي عِسِرَيِلَ رَفبِلٍنقٍ ﭑ مَ،</para>
  <para style="q" vid="ISA 49:6">وَلِ نَ عَ رَ نَشَن شُرُن عِ بّ ﭑ مَ كٌنيِ.</para>
  <para style="q" vid="ISA 49:6">ﭑ مَن عِ قِندِ مَ نّ نَءِيَلَنيِ رَ سِ فبّتّيٍ بّ،</para>
  <para style="q" vid="ISA 49:6">عَلَكٌ ﭑ مَ كِسِ شَ مَسٍن دُنِحَ يِرٍ بِرِن.»<verse eid="ISA 49:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="ISA 49:7"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ،</para>
  <para style="q" vid="ISA 49:7">عَلَتَلَ نَشَن قِندِشِ عِسِرَيِلَ شُنسَرَ مَ رَ، عِسِرَيِلَ شَ سّنِيّنتْي،</para>
  <para style="q" vid="ISA 49:7">وٌن بْنسْي نَشَن شْنشِ،</para>
  <para style="q" vid="ISA 49:7">نَشَن وَلِشِ مَنفّيٍ بّ،</para>
  <para style="q" vid="ISA 49:7">«مَنفّيٍ نَ وٌ تٌ، عٍ تِمَ نّ،</para>
  <para style="q" vid="ISA 49:7">كُنتِفِيٍ نَ وٌ تٌ، عٍ عٍ شِنبِ سِنمَ نّ وٌ بُن مَ،</para>
  <para style="q" vid="ISA 49:7">بَرِ مَ دُفُتّفّ عَلَتَلَ نَشَن عِسِرَيِلَ شَ سّنِيّنتْي رَ،</para>
  <para style="q" vid="ISA 49:7">نَ نَن وٌ سُفَندِشِ.»<verse eid="ISA 49:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="ISA 49:8"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ،</para>
  <para style="q" vid="ISA 49:8">«ﭑ وٌ يَابِمَ يَابِ تّمُي نّ،</para>
  <para style="q" vid="ISA 49:8">ﭑ وٌ رَكِسِمَ كِسِ لْشْي نّ.</para>
  <para style="q" vid="ISA 49:8">ﭑ وٌ مَكَنتَمَ نّ،</para>
  <para style="q" vid="ISA 49:8">ﭑ وٌ تِمَ نّ عَلْ حَمَ ﭑ سَاتّ تٌنفٌ نَشَن بّ،</para>
  <para style="q" vid="ISA 49:8">عَلَكٌ وٌ شَ بْشِ شَ قَن، نَشَن كَنَشِ عَ شَ يَءِلَن.<verse eid="ISA 49:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 49:9"/>فٍيلِمَنِيٍ مِنِمَ نّ،</para>
  <para style="q" vid="ISA 49:9">مِشِ نَشٍيٍ نَ دِ مِ شْورَ، نٍيٍ شْرّيَ سْتْمَ نّ.<verse eid="ISA 49:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 49:10"/>عٍ لُمَ نّ عَلْ شُرُ سٍيٍ نَشٍيٍ عٍ دّ مَدٌنمَ قِيلِيٍ مَ،</para>
  <para style="q" vid="ISA 49:10">كَامّ نُن يٍ شْلِ مُ عٍ سُشُمَ،</para>
  <para style="q" vid="ISA 49:10">كُيٍقُرٍ نُن سٌفٍ شْنّ مُ عٍ تْورْ مَ.</para>
  <para style="q" vid="ISA 49:10">عٍ رَهِننّمَ نَن لُمَ عٍ رَحّرّ رَ،</para>
  <para style="q" vid="ISA 49:10">عَ عٍ شُن تِ دُلٌن يِرٍ رَ.<verse eid="ISA 49:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 49:11"/>تٍنتٍنيِ رَفٌرٌ مَ نّ، يِلِ رَقٍ،</para>
  <para style="q" vid="ISA 49:11">عَلَكٌ عٍ شَ كِرَ شَ قَن.<verse eid="ISA 49:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 49:12"/>عٍ قَمَ نّ كٍلِقٍ يِرٍ مَكُيٍ،</para>
  <para style="q" vid="ISA 49:12">كٍلِقٍ كْولَ نُن سٌفٍفٌرٌدٍ مَ،</para>
  <para style="q" vid="ISA 49:12">كٍلِقٍ عَسُوَن بْشِ مَ.»<verse eid="ISA 49:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="ISA 49:13"/>«نَشٍيٍ نَ كٌورٍ مَ، عٍ شَ عٍ سّيوّ شُي عِتٍ،</para>
  <para style="q" vid="ISA 49:13">نَشٍيٍ نَ بْشِ مَ، عٍ شَ حّلّشِن،</para>
  <para style="q" vid="ISA 49:13">نَشٍيٍ نَ فٍيَيٍ قَرِ، عٍ شَ بّيتِ بَ،</para>
  <para style="q" vid="ISA 49:13">بَرِ مَ عَلَتَلَ عَ شَ حَمَ مَدُندُ مَ نّ،</para>
  <para style="q" vid="ISA 49:13">عَ كِنِكِنِ تْورْ مِشِيٍ مَ.»<verse eid="ISA 49:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="ISA 49:14"/>كْنْ سِيٌنكَيٍ نُ عَ قَلَمَ نّ،</para>
  <para style="q" vid="ISA 49:14">«عَلَتَلَ بَرَ مُشُ رَبٌلٌ،</para>
  <para style="q" vid="ISA 49:14">مُشُ مَرِفِ بَرَ نّيمُ مُشُ مَ.»<verse eid="ISA 49:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="ISA 49:15"/>«دِنفّ نْمَ نّيمُدٍ عَ شَ دِيْرّ مَ؟</para>
  <para style="q" vid="ISA 49:15">عَ مُ كِنِكِنِمَ شّ عَ شَ دِ مَ؟</para>
  <para style="q" vid="ISA 49:15">هَلِ عَ تَن نّيمُ،</para>
  <para style="q" vid="ISA 49:15">ﭑ تَن مُ نّيمُمَ وٌ مَ.<verse eid="ISA 49:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 49:16"/>وٌ شِلِيٍ كٌرِنشِ ﭑ بّلّشّ كُي،</para>
  <para style="q" vid="ISA 49:16">ﭑ يَيٍ تِشِ نّ عِ شَ بَنشِ رَ تّمُي بِرِن.<verse eid="ISA 49:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 49:17"/>وٌ شَ دِيٍ نَ فبِلٍنقٍ وٌ شْنيِ.</para>
  <para style="q" vid="ISA 49:17">نَشٍيٍ وٌ تْورْشِ، نٍيٍ نَ كٍلِقٍ وٌ شُن مَ.<verse eid="ISA 49:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 49:18"/>وٌ وٌ يَ عِتٍ. وٌ شَ دِيٍ بَرَ عٍ مَلَن، عٍ نَ قَقٍ.</para>
  <para style="q" vid="ISA 49:18">ﭑ تَن عَلَتَلَ بَرَ ﭑ كَلِ ﭑ يّتّ رَ،</para>
  <para style="q" vid="ISA 49:18">وٌ شَ مِشِيٍ قَمَ نّ لُدٍ وٌ سّيتِ مَ،</para>
  <para style="q" vid="ISA 49:18">عَلْ دُفِ تٌقَنيِيٍ لُمَ فِنّ مَ كِ نَشّ عَ شَ قُتِ شِرِ لْشْي.»<verse eid="ISA 49:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="ISA 49:19"/>«هَلِ وٌ يَشُييٍ تٌ وٌ شْنيِ كَنَشِ، عٍ وٌ شَ حَمَ رَيٍنسٍن يّ،</para>
  <para style="q" vid="ISA 49:19">يَكْسِ وٌ قَمَ نّ وُيَدٍ هَن وٌ فبٌ وٌ شَ بْشِ بّ.</para>
  <para style="q" vid="ISA 49:19">مِشِ نَشٍيٍ كَسَرّ تِشِ وٌ شْنيِ، عٍ بَرَ سِفَ.<verse eid="ISA 49:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 49:20"/>وٌ شَ دِ نَشٍيٍ بَرِشِ يِ تْورْ وَشَتِ،</para>
  <para style="q" vid="ISA 49:20">عٍ قَمَ نّ عَ قَلَدٍ، ‹بٍ شُرُن وٌن بّ.</para>
  <para style="q" vid="ISA 49:20">وٌن شَ يِرٍ نّينّ تِ وٌن لُمَ دّننَشّ.›<verse eid="ISA 49:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 49:21"/>نَ تّمُي وٌ قَمَ نّ عَ قَلَدٍ،</para>
  <para style="q" vid="ISA 49:21">‹ندٍ يِ دِيٍ بَرِشِ ﭑ بّ؟</para>
  <para style="q" vid="ISA 49:21">مِشِ رَبّحِنشِ نَن نُ نَ ﭑ نَ.</para>
  <para style="q" vid="ISA 49:21">عَلَ نُ بَرَ ﭑ نَبٌلٌ، عَ مّي ﭑ نَ.</para>
  <para style="q" vid="ISA 49:21">ندٍ يِ دِيٍ رَ مْشِ؟</para>
  <para style="q" vid="ISA 49:21">ﭑ كٍرٍن ثٍتِ نَن نُ عَ رَ.</para>
  <para style="q" vid="ISA 49:21">يِ دِيٍ كٍلِشِ مِندٍن؟›»<verse eid="ISA 49:21"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="22" style="v" sid="ISA 49:22"/>وٌن مَرِفِ عَلَتَلَ شَ مَسٍنيِ نَن يَ،</para>
  <para style="q" vid="ISA 49:22">«ﭑ نَن ﭑ بّلّشّ عِتٍمَ نّ حَمَنّيٍ بّ،</para>
  <para style="q" vid="ISA 49:22">ﭑ تْنشُمَ مَسٍن عٍ بّ،</para>
  <para style="q" vid="ISA 49:22">عَلَكٌ عٍ شَ قَ وٌ شَ دِ شّمّيٍ رَ عٍ بّلّشّ،</para>
  <para style="q" vid="ISA 49:22">عٍ شَ قَ وٌ شَ دِ فِنّيٍ رَ عٍ تُنكِ مَ.<verse eid="ISA 49:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 49:23"/>مَنفّيٍ مّينِمَ نّ وٌ شَ دِيٍ مَ،</para>
  <para style="q" vid="ISA 49:23">مَنفّ فِنّيٍ عٍ رَ مْ.</para>
  <para style="q" vid="ISA 49:23">نَ مِشِ شُنفبٍيٍ عٍ شِنبِ سِنمَ نّ وٌ بُن مَ،</para>
  <para style="q" vid="ISA 49:23">عٍ وٌ سَنيِيٍ مَسُنبُمَ نّ.</para>
  <para style="q" vid="ISA 49:23">نَ كُي وٌ قَمَ نّ عَ كٌلٌندٍ عَ عَلَتَلَ نَ ﭑ تَن نَن نَ.</para>
  <para style="q" vid="ISA 49:23">مِشِ نَشٍيٍ عٍ شَشِلِ تِمَ ﭑ نَ، نَ كَنيِ مُ يَافِمَ.»<verse eid="ISA 49:23"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="24" style="v" sid="ISA 49:24"/>سْورِ شَ سٍ تٌنفٌشِ نْمَ رَ سُشُدٍ عَ يِ رَ؟</para>
  <para style="q" vid="ISA 49:24">سّنبّمَ شَ مِشِ سُشُشِ نْمَ بَدٍ عَ يِ رَ؟<verse eid="ISA 49:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="ISA 49:25"/>عَلَتَلَ وٌ يَابِمَ يِ كِ نّ؛</para>
  <para style="q" vid="ISA 49:25">«عِيٌ، ﭑ سْورِ شَ سٍ تٌنفٌشِ رَ سُشُمَ نّ عَ يِ رَ،</para>
  <para style="q" vid="ISA 49:25">ﭑ سّنبّمَ شَ مِشِ سُشُشِ بَمَ نّ عَ يِ رَ.</para>
  <para style="q" vid="ISA 49:25">ﭑ وٌ فٍرٍقَيٍ فٍرٍ مَ نّ، ﭑ وٌ شَ دِيٍ رَكِسِ.<verse eid="ISA 49:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="ISA 49:26"/>نَشٍيٍ وٌ حَشَنكَتَمَ، عٍ قَمَ نّ عٍ يّتّ سُبٍ دٌندٍ،</para>
  <para style="q" vid="ISA 49:26">عٍ سِيسِمَ نّ عٍ يّتّ وُلِ رَ.</para>
  <para style="q" vid="ISA 49:26">نَ كُي عِبُنَدَ مَ بِرِن عَ كٌلٌنمَ نّ،</para>
  <para style="q" vid="ISA 49:26">عَ ﭑ تَن نَن عَلَتَلَ رَ، وٌ رَكِسِمَ، وٌ شُنسَرَ مَ، يَشُبَ شَ سّنبّمَ.»<verse eid="ISA 49:26"/></para>
  <chapter eid="ISA 49"/>
  <chapter number="50" style="c" sid="ISA 50"/>
  <para style="s">يُنُبِ سَرٍ</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 50:1"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="ISA 50:1">«ﭑ كّيدِ مُندُن سّبّشِ ﭑ شَ مّي وٌ نفَ رَ؟</para>
  <para style="q" vid="ISA 50:1">ﭑ سَرٍ مُندُن سْتْشِ وٌ مَتِقٍ رَ؟</para>
  <para style="q" vid="ISA 50:1">وٌ مَتِشِ وٌ يّتّ شَ يُنُبِيٍ نَن مَ قٍ رَ.</para>
  <para style="q" vid="ISA 50:1">ﭑ مّيشِ وٌ نفَ رَ عَ شَ مَتَندِ نَن مَ.<verse eid="ISA 50:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 50:2"/>مُنقٍ رَ وٌ مُ ﭑ يَابِمَ؟</para>
  <para style="q" vid="ISA 50:2">مُنقٍ رَ وٌ مُ تِمَ ﭑ يَ رَ؟</para>
  <para style="q" vid="ISA 50:2">وٌ عَ مَحْشُنشِ نّ ﭑ بّلّشّ مُ قَتَ وٌ قُلُندٍ؟</para>
  <para style="q" vid="ISA 50:2">وٌ عَ مَحْشُنشِ نّ ﭑ سّنبّ مُ نْمَ وٌ رَكِسِدٍ؟</para>
  <para style="q" vid="ISA 50:2">ﭑ مَ وْيّن كٍرٍن نْمَ بَا شَرَدٍ.</para>
  <para style="q" vid="ISA 50:2">ﭑ نْمَ شُرٍ قِندِدٍ فبٍنفبٍرٍنيِ رَ، يّشّيٍ شَ قَشَ، عٍ شَ بْرْ.<verse eid="ISA 50:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 50:3"/>ﭑ قَتَ كٌورٍ رَقْورْدٍ،</para>
  <para style="q" vid="ISA 50:3">عَلْ مِشِ نَ كَاحّ دُفِ رَفٌرٌشِ عَ مَ.»<verse eid="ISA 50:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="ISA 50:4"/>ﭑ مَرِفِ عَلَتَلَ بَرَ مَسٍنيِ سٌ ﭑ يِ رَ</para>
  <para style="q" vid="ISA 50:4">نَشَن نْمَ مِشِ تَفَنشِ مَلِدٍ.</para>
  <para style="q" vid="ISA 50:4">عَ ﭑ نَ نَشُنُمَ فّيسّفّ بِرِن، عَ ﭑ تُلِ عِبَمَ،</para>
  <para style="q" vid="ISA 50:4">عَلَكٌ ﭑ شَ ﭑ تُلِ مَتِ عَ رَ عَلْ شَرَندِ قَنيِ.<verse eid="ISA 50:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 50:5"/>ﭑ مَرِفِ عَلَتَلَ بَرَ ﭑ تُلِ رَبِ،</para>
  <para style="q" vid="ISA 50:5">ﭑ تَن مُ تٌندِ مَ بِرَدٍ عَ قْشْ رَ.<verse eid="ISA 50:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 50:6"/>ﭑ نَن ﭑ قَرِ تِمَ نّ ﭑ يَشُييٍ شَ ﭑ بْنبْ.</para>
  <para style="q" vid="ISA 50:6">ﭑ نَ ﭑ شّرّ قَن تِمَ نّ عٍ شَ ﭑ دّ شَبٍ مَتَلَ.</para>
  <para style="q" vid="ISA 50:6">ﭑ مُ ﭑ يَ تَفِ نْشُن عٍ شَ كٌنبِيٍ مَ،</para>
  <para style="q" vid="ISA 50:6">ﭑ مُ تٌندِ عٍ شَ عٍ دّ يٍ بْشُن ﭑ مَ.<verse eid="ISA 50:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="ISA 50:7"/>ﭑ مَرِفِ عَلَتَلَ تٌ ﭑ مَلِ،</para>
  <para style="q" vid="ISA 50:7">ﭑ مُ يَافِ، ﭑ مُ ﭑ فِ.</para>
  <para style="q" vid="ISA 50:7">ﭑ لُمَ نّ عَلْ قَنيٍ، بَرِ مَ ﭑ عَ كٌلٌن ﭑ مُ لُمَ يَافِ كُي.<verse eid="ISA 50:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 50:8"/>نَشَن ﭑ فبٍ حْشْمَ عَ نَ ﭑ سّيتِ مَ.</para>
  <para style="q" vid="ISA 50:8">ندٍ وَ مَ ﭑ سْنشْقٍ؟ وٌن شَ وْيّن.</para>
  <para style="q" vid="ISA 50:8">ندٍ وَ مَ ﭑ كَلَمُقٍ؟ كِيتِ شَ سَ.<verse eid="ISA 50:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 50:9"/>ﭑ مَرِفِ عَلَتَلَ نَن ﭑ مَلِقٍ.</para>
  <para style="q" vid="ISA 50:9">ندٍ نْمَ عَ رَ؟</para>
  <para style="q" vid="ISA 50:9">عٍ شَ كَلَمُي كَنَمَ نّ عَلْ دُفِ قٌرِ تٍيسٍ نَشَن دٌنمَ.<verse eid="ISA 50:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="ISA 50:10"/>ندٍ فَاشُمَ عَلَتَلَ يَ رَ وٌ يَ مَ،</para>
  <para style="q" vid="ISA 50:10">عَ عَلَ شَ كٌنيِ شُي سُشُ؟</para>
  <para style="q" vid="ISA 50:10">نَشَن بِرِن نَ حّرّقٍ دِ مِ شْورَ نَءِيَلَنيِ شَنبِ،</para>
  <para style="q" vid="ISA 50:10">عَ شَ عَ شَشِلِ تِ عَلَتَلَ شِلِ رَ، عَ لَ عَ رَ.<verse eid="ISA 50:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 50:11"/>ﭑ شَ عَ قَلَ وٌ بّ،</para>
  <para style="q" vid="ISA 50:11">وٌ تَن نَشٍيٍ تّ رَدّشّمَ،</para>
  <para style="q" vid="ISA 50:11">وٌ قَ تَنبّ رَشَحّنمَ فٍرٍ شِلِ مَ،</para>
  <para style="q" vid="ISA 50:11">ﭑ قَمَ نّ وٌ تْورْدٍ عَ شْرْشْي رَ.<verse eid="ISA 50:11"/></para>
  <chapter eid="ISA 50"/>
  <chapter number="51" style="c" sid="ISA 51"/>
  <para style="s">عِسِرَيِلَ قَتَنشِ دّننَشّ رَ</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 51:1"/>«وٌ وٌ تُلِ مَتِ ﭑ نَ، وٌ تَن نَشٍيٍ تِنشِنيِ نُن عَلَتَلَ قٍنقٍ.</para>
  <para style="q" vid="ISA 51:1">وٌ شَ وٌ يَ تِ قَنيٍ رَ عَلَتَلَ وٌ رَ مِنِشِ دّننَشّ.<verse eid="ISA 51:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 51:2"/>وٌ شَ وٌ يَ تِ وٌ بَبَ عِبُرَهِمَ نُن وٌ نفَ سَرَ رَ نَشٍيٍ وٌ بَرِشِ.</para>
  <para style="q" vid="ISA 51:2">ﭑ تٌ عَ شِلِ عَ كٍرٍن نَن نُ عَ رَ،</para>
  <para style="q" vid="ISA 51:2">كْنْ ﭑ تٌ فّ دُبَدٍ عَ بّ،</para>
  <para style="q" vid="ISA 51:2">عَ قِندِ نّ بْنسْي وُيَشِ بٍنبَ رَ.<verse eid="ISA 51:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 51:3"/>عَلَتَلَ سِيٌن مَدُندُ مَ نّ،</para>
  <para style="q" vid="ISA 51:3">عَ كِنِكِنِ عَ شَ كَسَرّ بِرِن مَ.</para>
  <para style="q" vid="ISA 51:3">عَلَتَلَ عَ شَ فبٍنفبٍرٍنيِ قِندِ مَ نّ يِرٍ قَنيِ رَ عَلْ عٍدٍن بْشِ،</para>
  <para style="q" vid="ISA 51:3">عَ عَ شَ بْشِ رَتٌقَنمَ نّ عَلْ عَ دَرِشِ عَ رَ كِ نَشّ.</para>
  <para style="q" vid="ISA 51:3">سّيوّ نُن حّلّشِنيِ لُ نَا،</para>
  <para style="q" vid="ISA 51:3">سُوكِ نُن بّيتِ بَ تّمُي بِرِن.»<verse eid="ISA 51:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="ISA 51:4"/>«ﭑ مَ حَمَ، وٌ وٌ تُلِ مَتِ ﭑ نَ.</para>
  <para style="q" vid="ISA 51:4">ﭑ مَ سِ، وٌ شَ ﭑ شُي رَ مّ.</para>
  <para style="q" vid="ISA 51:4">سّرِيّ قَتَنشِ ﭑ تَن نَن نَ،</para>
  <para style="q" vid="ISA 51:4">ﭑ مَ كِيتِ تِنشِنشِ قِندِ مَ نّ نَءِيَلَنيِ رَ سِيٍ بّ.<verse eid="ISA 51:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 51:5"/>ﭑ مَ كِيتِ تِنشِنشِ بَرَ مَكْرّ،</para>
  <para style="q" vid="ISA 51:5">ﭑ مَ كِسِ نَ قَقٍ،</para>
  <para style="q" vid="ISA 51:5">سِيٍ قَمَ نّ عٍ شَشِلِ تِدٍ ﭑ سّنبّ رَ.<verse eid="ISA 51:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 51:6"/>وٌ وٌ يَ رَتٍ كٌورٍ مَ.</para>
  <para style="q" vid="ISA 51:6">مّننِ لْيمَ نّ عَلْ قٌيٍ تُورِ رَلْيمَ كِ نَشّ.</para>
  <para style="q" vid="ISA 51:6">وٌ وٌ يَ تِ بْشِ رَ.</para>
  <para style="q" vid="ISA 51:6">مّننِ حْنمَ نّ عَلْ دُفِ قٌرِ.</para>
  <para style="q" vid="ISA 51:6">مّننِكَيٍ قَشَمَ نّ عَلْ تُفِتُفِ.</para>
  <para style="q" vid="ISA 51:6">كْنْ ﭑ مَ كِسِ تَن عَبَدَن نَن عَ رَ،</para>
  <para style="q" vid="ISA 51:6">ﭑ مَ تِنشِنيِ مُ كَنَمَ.»<verse eid="ISA 51:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="ISA 51:7"/>«وٌ شَ وٌ تُلِ مَتِ ﭑ شُي رَ، وٌ نَشَن كٌلٌن تِنشِنيِ رَ.</para>
  <para style="q" vid="ISA 51:7">ﭑ مَ سّرِيّ سَبَتِشِ وٌ بْحّ كُي.</para>
  <para style="q" vid="ISA 51:7">وٌ نَشَ فَاشُ مِشِيٍ شَ مَبٍرٍ يَ رَ،</para>
  <para style="q" vid="ISA 51:7">وٌ نَشَ وٌ فِ عٍ شَ سْنشْي يَ رَ.<verse eid="ISA 51:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 51:8"/>نِمَسٍ شُنشُرِيٍ عٍ دٌنمَ نّ عَلْ دُفِ،</para>
  <para style="q" vid="ISA 51:8">تٍيسٍ عٍ رَحْن عَلْ فّسّ قُتٍ.</para>
  <para style="q" vid="ISA 51:8">كْنْ ﭑ مَ تِنشِنيِ بُمَ نّ عَبَدَن،</para>
  <para style="q" vid="ISA 51:8">ﭑ مَ كِسِ لُمَ نّ بْنسْي يَ مَ تّمُي بِرِن.»<verse eid="ISA 51:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="ISA 51:9"/>عَلَتَلَ، عِ شَ كٍلِ سّنبّ رَ.</para>
  <para style="q" vid="ISA 51:9">عِ شَ كٍلِ عَلْ سِنفٍ رَ.</para>
  <para style="q" vid="ISA 51:9">عِ تَن شَ مُ مِسِرَكَيٍ بْنبْ عَلْ وُلَءِ سُبٍ مَفَاشُشِ؟<verse eid="ISA 51:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 51:10"/>عِ تَن شَ مُ بَا شُنفبٍ رَشْرِ،</para>
  <para style="q" vid="ISA 51:10">عِ قَ كِرَ عِبْو بَا تَفِ عِ شَ مِشِ رَكِسِشِيٍ دَنفِمَ دّننَشّ؟<verse eid="ISA 51:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 51:11"/>عَلَتَلَ شَ مِشِ شْرّيَشِيٍ فبِلٍنمَ نّ،</para>
  <para style="q" vid="ISA 51:11">عٍ قَ سٌ سِيٌن كُي بّيتِ رَ،</para>
  <para style="q" vid="ISA 51:11">سّيوّ نَن لُمَ عٍ بّ عَبَدَن.</para>
  <para style="q" vid="ISA 51:11">عٍ بْحّ رَقَنشِ عٍ مَ، حّلّشِنيِ لُمَ نّ عٍ سٌندٌنيِ كُي.</para>
  <para style="q" vid="ISA 51:11">نِمِسّ نُن يَيٍ مَكُيَمَ نّ عٍ رَ.<verse eid="ISA 51:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="ISA 51:12"/>«ﭑ تَن نَن وٌ بْحّ مَدُندُ مَ.</para>
  <para style="q" vid="ISA 51:12">ندٍ نْمَ فَاشُدٍ عَدَ مَدِ يَ رَ،</para>
  <para style="q" vid="ISA 51:12">نَشَن قَشَمَ، نَشَن حْنمَ عَلْ سّشّ؟<verse eid="ISA 51:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 51:13"/>مُنقٍ رَ وٌ قَ نّيمُشِ وٌ دَالِمَ عَلَتَلَ مَ،</para>
  <para style="q" vid="ISA 51:13">نَشَن كٌورٍ عِتَلَشِ، عَ بْشِ بُنيِ سَ؟</para>
  <para style="q" vid="ISA 51:13">مُنقٍ رَ وٌ لُمَ فَاشُي كُي تّمُي بِرِن وٌ يَشُييٍ يَ رَ نَشٍيٍ وَ مَ وٌ تْورْقٍ؟</para>
  <para style="q" vid="ISA 51:13">وٌ فَاشُمَ عٍ يَ رَ مُنقٍ رَ؟<verse eid="ISA 51:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 51:14"/>عَ فبٍ مُ لُشِ، وٌ شَ فٍيلِمَنِيٍ قَمَ نّ شْرّيَ سْتْدٍ،</para>
  <para style="q" vid="ISA 51:14">عٍ مُ قَشَمَ فٍيلِ كُي، عٍ مُ قَشَمَ كَامّ رَ.<verse eid="ISA 51:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 51:15"/>ﭑ تَن نَن نَ وٌ مَرِفِ عَلَتَلَ رَ،</para>
  <para style="q" vid="ISA 51:15">نَشَن بَا عِمَشَمَ، عَ مْرْنيِيٍ رَ مِنِ.</para>
  <para style="q" vid="ISA 51:15">ﭑ شِلِ نّ عَلَتَلَ سّنبّمَ.<verse eid="ISA 51:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 51:16"/>ﭑ نَن ﭑ مَ مَسٍنيِ سَشِ نّ عِ دّ عِ،</para>
  <para style="q" vid="ISA 51:16">ﭑ نَ ﭑ بّلّشّ تِ عِ شُن مَ،</para>
  <para style="q" vid="ISA 51:16">ﭑ تَن نَشَن كٌورٍ عِتَلَ، ﭑ بْشِ بُنيِ سَ،</para>
  <para style="q" vid="ISA 51:16">نَشَن سِيٌنكَيٍ شِلِمَ، ‹ﭑ مَ حَمَ.›»<verse eid="ISA 51:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="ISA 51:17"/>«دَرِ سَلَمُكَيٍ، وٌ كٍلِ كٍرٍن نَ،</para>
  <para style="q" vid="ISA 51:17">وٌ تَن نَشٍيٍ عَلَتَلَ شَ مِنسٍ شْرْشْي مِنشِ،</para>
  <para style="q" vid="ISA 51:17">وٌ تَن نَشٍيٍ عَ شَ شْنّ كٌلٌنشِ،</para>
  <para style="q" vid="ISA 51:17">عَ تٌ دِن وٌ رَ، عَ قَ عَ لُ وٌ شَ بِرَ عَلْ سِيسِلَيٍ.<verse eid="ISA 51:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 51:18"/>عَ شَ دِ يٌ مُ نُ نَ نَشَن عَ مَلِمَ عَ شَ حّرّ كُي،</para>
  <para style="q" vid="ISA 51:18">نَشَن لُ عَ سّيتِ مَ عَ سُشُقٍ رَ.<verse eid="ISA 51:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 51:19"/>نَ فبَلٌي شْرْشْي بَرَ وٌ سْتْ،</para>
  <para style="q" vid="ISA 51:19">كَسَرّ نُن سْنتْي، كَامّ نُن فٍرٍ،</para>
  <para style="q" vid="ISA 51:19">ندٍ نْمَ وٌ مَدُندُدٍ؟<verse eid="ISA 51:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 51:20"/>وٌ شَ دِيٍ بَرَ بِرَ، عٍ سَشِ كِرَ شُنيِ رَ،</para>
  <para style="q" vid="ISA 51:20">عَلْ شٍلِ نَشَن سُشُشِ يّلّ رَ.</para>
  <para style="q" vid="ISA 51:20">عَلَتَلَ شَ شْنّ بَرَ دِن عٍ رَ، عَ بَرَ عٍ حَشَنكَتَ عَ حَاشِ رَ.»<verse eid="ISA 51:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="ISA 51:21"/>نَ كُي وٌ تَن تْورْ مِشِيٍ، وٌ شَ وٌ تُلِ مَتِ يِ مَسٍنيِ رَ</para>
  <para style="q" vid="ISA 51:21">وٌ تَن نَشٍيٍ لُشِ عَلْ سِيسِلَيٍ بٍيرٍ شَنبِ.<verse eid="ISA 51:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 51:22"/>وٌ مَرِفِ عَلَتَلَ نَشَن عَ شَ حَمَ مَكَنتَمَ،</para>
  <para style="q" vid="ISA 51:22">عَ شَ مَسٍنيِ نَن يَ،</para>
  <para style="q" vid="ISA 51:22">«عَوَ، ﭑ مُ شْنْشِ وٌ مَ سْنْن،</para>
  <para style="q" vid="ISA 51:22">نَ شْنّ مُ وٌ لِمَ سْنْن.<verse eid="ISA 51:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 51:23"/>ﭑ مَ شْنّ سِفَمَ وٌ يَشُييٍ نَن مَ نَشٍيٍ بَرَ وٌ تْورْ،</para>
  <para style="q" vid="ISA 51:23">عٍ قَ عَ قَلَ ‹وٌ وٌ قٍلٍن بْشِ مَ، مُشُ شَ تِ وٌ قَرِ.›</para>
  <para style="q" vid="ISA 51:23">عٍ بَرَ وٌ تْورْ نَ كِ، عٍ قَ حّرّ وٌ قَرِ عَلْ بْشِ.»<verse eid="ISA 51:23"/></para>
  <chapter eid="ISA 51"/>
  <chapter number="52" style="c" sid="ISA 52"/>
  <para style="s">شِبَارُ قَنيِ دَرِ سَلَمُ بّ</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 52:1"/>سِيٌنِكَيٍ، وٌ شَ كٍلِ سّنبّ رَ،</para>
  <para style="q" vid="ISA 52:1">وٌ شَ دُفِ تٌقَنيِ رَفٌرٌ وٌ مَ، وٌ تَن تَا سّنِيّنشِ.</para>
  <para style="q" vid="ISA 52:1">سُننَتَرٍيٍ نُن سّنِيّنتَرٍيٍ مُ سٌمَ وٌ شْنيِ سْنْن.<verse eid="ISA 52:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 52:2"/>دَرِ سَلَمُكَيٍ، وٌ شَ كٍلِ، وٌ شُبٍ بَ وٌ مَ، وٌ دْشْ كِبَنيِ كُي.</para>
  <para style="q" vid="ISA 52:2">يْلْنشْنيِ شَ بَ وٌ كْنيِ مَ.<verse eid="ISA 52:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 52:3"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ،</para>
  <para style="q" vid="ISA 52:3">«عٍ وٌ مَتِشِ نّ قُقَقُ، وٌ شُن مُ سَرَ مَ كْبِرِ رَ.»<verse eid="ISA 52:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 52:4"/>عَلَتَلَ سّنبّمَ شَ مَسٍنيِ نَن يَ،</para>
  <para style="q" vid="ISA 52:4">«سِنفٍ ﭑ مَ حَمَ نُ نَ مِسِرَ بْشِ نَن مَ كٌنيِيَ كُي.</para>
  <para style="q" vid="ISA 52:4">نَ دَنفِ شَنبِ، عَسِرِيَكَيٍ نَشَ عٍ حَشَنكَتَ، عٍ عٍ شَنِن.<verse eid="ISA 52:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 52:5"/>يَكْسِ نَ قِندِشِ مُنسٍ رَ ﭑ بّ؟</para>
  <para style="q" vid="ISA 52:5">عٍ بَرَ ﭑ مَ حَمَ شَنِن قُقَقُ، عٍ قَ يٌ عٍ مَ عٍ شَ يَامَرِ كُي.»</para>
  <para style="q" vid="ISA 52:5">عَلَتَلَ شَ مَسٍنيِ نَن يَ،</para>
  <para style="q" vid="ISA 52:5">«تّمُي بِرِن ﭑ شِلِ نَ كَنَقٍ.<verse eid="ISA 52:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 52:6"/>نَ كُي ﭑ بَرَ نَتّ تٌنفٌ عَ ﭑ مَ حَمَ قَمَ نّ ﭑ شِلِ كٌلٌندٍ،</para>
  <para style="q" vid="ISA 52:6">عٍ قَ عَ كٌلٌن عَ ﭑ تَن نَن يِ مَسٍنيِ تِشِ، عَ ﭑ تَن نَن نَ عٍ سّيتِ مَ.»<verse eid="ISA 52:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="ISA 52:7"/>شّيرَ تٌقٍ قَ رَ فٍيَ قَرِ، قٍ قَنيِ نَ عَ رَ.</para>
  <para style="q" vid="ISA 52:7">عَ قَمَ نّ شِبَارُ قَنيِ رَ نَشَن بْحّسَ قِمَ مِشِ مَ،</para>
  <para style="q" vid="ISA 52:7">نَشَن قِندِ مَ كِسِ رَ،</para>
  <para style="q" vid="ISA 52:7">نَشَن عَ مَسٍنمَ سِيٌنِ بّ، «وٌ مَرِفِ عَلَ نَن مَنفّ رَ!»<verse eid="ISA 52:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 52:8"/>وٌ وٌ تُلِ مَتِ وٌ كَنتَمَيٍ رَ،</para>
  <para style="q" vid="ISA 52:8">عٍ بَرَ عٍ شُي عِتٍ سّيوّ رَ.</para>
  <para style="q" vid="ISA 52:8">عَلَتَلَ نَ فبِلٍن سِيٌنِ، عٍ قَمَ نّ عَ تٌدٍ عٍ يَيٍ رَ.<verse eid="ISA 52:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 52:9"/>دَرِ سَلَمُكَيٍ، وٌ بِرِن شَ وٌ شُي عِتٍ سّيوّ رَ،</para>
  <para style="q" vid="ISA 52:9">بَرِ مَ عَلَتَلَ نَ عَ شَ حَمَ مَيٌتٌقٍ،</para>
  <para style="q" vid="ISA 52:9">عَ نَ دَرِ سَلَمُ شُن سَرَقٍ.<verse eid="ISA 52:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 52:10"/>عَلَتَلَ نَ عَ سّنبّ سّنِيّنشِ مَسٍنقٍ حَمَنّ مَ.</para>
  <para style="q" vid="ISA 52:10">دُنِحَ بِرِن قَمَ نّ عَلَتَلَ شَ كِسِ تٌدٍ.<verse eid="ISA 52:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="ISA 52:11"/>وٌ سِفَ، وٌ سِفَ.</para>
  <para style="q" vid="ISA 52:11">وٌ نَشَ وٌ مَسٌ سٍ سّنِيّنتَرٍ يٌ رَ.</para>
  <para style="q" vid="ISA 52:11">وٌ شَ مِنِ نَ كُي سّنِيّنيِ كُي،</para>
  <para style="q" vid="ISA 52:11">وٌ تَن نَشٍيٍ هْرْ مْلِنفِرَ سٍيٍ شَنِنمَ عَلَتَلَ بّ.<verse eid="ISA 52:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 52:12"/>كْنتْقِلِ نَشَ عَ نِيَ وٌ شَ فبَتَ،</para>
  <para style="q" vid="ISA 52:12">فَاشُي نَشَ عَ نِيَ وٌ شَ وٌ فِ،</para>
  <para style="q" vid="ISA 52:12">بَرِ مَ عَلَتَلَ نَن تِشِ وٌ يَ رَ،</para>
  <para style="q" vid="ISA 52:12">عِسِرَيِلَ مَرِفِ عَلَ نَن تِشِ وٌ شَنبِ رَ.<verse eid="ISA 52:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="ISA 52:13"/>«ﭑ مَ كٌنيِ شَ قٍ سْونّيَمَ نّ،</para>
  <para style="q" vid="ISA 52:13">عَ شَ قٍ تٍ، عَ شُن نَكٍلِ، عَ تِدٍ شُنفبٍ سْتْ.<verse eid="ISA 52:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 52:14"/>عَ شَ قٍ مَفٌرٍ قِندِ مَ تّرّننَ نَن نَ مِشِ فبٍفبٍ بّ،</para>
  <para style="q" vid="ISA 52:14">عَ لَهَلّ مَقِندِ، عَ مُ لُ عَدَ مَ كِ مَ سْنْن،<verse eid="ISA 52:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 52:15"/>عَ مَن مَنفّيٍ دّ عِشَرَ مَ نّ مَرَ سّنِيّنيِ رَ،</para>
  <para style="q" vid="ISA 52:15">عَ نَشَن قِمَ بْنسْي فبٍفبٍ مَ.</para>
  <para style="q" vid="ISA 52:15">عٍ قِندِ مَ نّ سٍيدٍيٍ رَ قٍ ندٍ مَ، عٍ مُ نَشَن سِنفٍ تٌشِ،</para>
  <para style="q" vid="ISA 52:15">عٍ قَهَامُي سْتْمَ نّ قٍ ندٍ شَ قٍ رَ، عٍ مُ نَشَن سِنفٍ مّشِ.»<verse eid="ISA 52:15"/></para>
  <chapter eid="ISA 52"/>
  <chapter number="53" style="c" sid="ISA 53"/>
  <para style="s">عَلَ شَ كٌنيِ قِندِقٍ سّرّشّ رَ</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 53:1"/>ندٍ لَشِ وٌن مَ مَسٍنيِ رَ؟</para>
  <para style="q" vid="ISA 53:1">ندٍ عَلَتَلَ سّنبّ تٌشِ؟<verse eid="ISA 53:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 53:2"/>عَ شَ كٌنيِ لُ نّ عَلْ سَنسِ شُرِ، نَشَن تِشِ بْشِ شَرٍ مَ.</para>
  <para style="q" vid="ISA 53:2">عَ تٌ كِ مُ نُ رَيَبُ، عَ شَ تٌقَنيِ مُ فبٌ.<verse eid="ISA 53:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 53:3"/>مِشِ رَحَاشُشِ نَن نُ عَ رَ حَمَ مُ تِنشِ نَشَن نَ.</para>
  <para style="q" vid="ISA 53:3">تْورْ مِشِ نَن نُ عَ رَ، نَشَن دَرِشِ حَشَنكَتّ رَ.</para>
  <para style="q" vid="ISA 53:3">مِشِيٍ مُ تِنشِ عٍ يَ تِدٍ عَ بّ.</para>
  <para style="q" vid="ISA 53:3">عٍ نُ يٌ عَ مَ، عٍ مُ تِدٍ يٌ قِشِ عَ مَ.<verse eid="ISA 53:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="ISA 53:4"/>عَ بَرَ وٌن مَ تْورّ قِندِ عَ فبٍ رَ،</para>
  <para style="q" vid="ISA 53:4">عَ بَرَ وٌن مَ كْنتْقِلِ قِندِ عَ فبٍ رَ.</para>
  <para style="q" vid="ISA 53:4">وٌن تَن بَرَ عَ مَحْشُن عَ عَلَ نَن عَ دَنكَشِ،</para>
  <para style="q" vid="ISA 53:4">عَ عَ شَ تْورّ قَتَنشِ عَلَ نَن نَ.<verse eid="ISA 53:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 53:5"/>كْنْ عَ سْشْ نّ وٌن مَ يُنُبِيٍ شَ قٍ رَ،</para>
  <para style="q" vid="ISA 53:5">عَ بُتُشُن وٌن مَ حَاشُحَ شَ قٍ رَ.</para>
  <para style="q" vid="ISA 53:5">عَ حَشَنكَتّ سْتْ نّ عَلَكٌ وٌن شَ يَلَنيِ سْتْ،</para>
  <para style="q" vid="ISA 53:5">عَ شَ قِيٍ قِندِشِ كِسِ نَن نَ وٌن بّ.<verse eid="ISA 53:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 53:6"/>وٌن بِرِن نُ لْيشِ نّ عَلْ شُرُ سٍ نَشٍيٍ يٍنسٍنمَ وُلَ عِ،</para>
  <para style="q" vid="ISA 53:6">كَنكَن نَشَ سِفَ عَ شَ كِرَ شْن مَ.</para>
  <para style="q" vid="ISA 53:6">كْنْ عَلَتَلَ بَرَ وٌن مَ يُنُبِيٍ كٌتٍ دْشْ عَ شُن.<verse eid="ISA 53:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="ISA 53:7"/>تْورّ نُن قٍ شْرْشْي تٌ عَ لِ،</para>
  <para style="q" vid="ISA 53:7">عَ مُ عَ دّ رَبِ هَلِ كٍرٍن.</para>
  <para style="q" vid="ISA 53:7">عَ لُ نّ عَلْ يّشّي نَشَن شَنِنقٍ عَ قَشَدٍ.</para>
  <para style="q" vid="ISA 53:7">عَ عَ سَبَرِ نّ تْورّ كُي،</para>
  <para style="q" vid="ISA 53:7">عَلْ يّشّي شَبٍ مَشَبَ تّمُي.<verse eid="ISA 53:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 53:8"/>عَ تٌ فّ كِيتِ تِنشِنتَرٍ سْتْدٍ، عَ نَشَ قَشَ.</para>
  <para style="q" vid="ISA 53:8">ندٍ نْ عَ بَدٍ دُنِحَ مِشِيٍ يِ رَ؟</para>
  <para style="q" vid="ISA 53:8">عَ حَشَنكَتَشِ ﭑ مَ حَمَ شَ يُنُبِيٍ نَن مَ قٍ رَ.<verse eid="ISA 53:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 53:9"/>عٍ نُ وَ مَ عَ قُرٍ رَفَتَقٍ مِشِ حَاشِيٍ نَن يَ مَ،</para>
  <para style="q" vid="ISA 53:9">كْنْ عَ رَحْنيِ عَ رَفَتَ مِشِ بَننَشِيٍ نَن يَ مَ،</para>
  <para style="q" vid="ISA 53:9">بَرِ مَ عَ مُ مِشِ تْورْ، عَ مُ مِشِ مَدَشُ.<verse eid="ISA 53:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="ISA 53:10"/>عَلَتَلَ بَرَ نَتّ تٌنفٌ عَ شَ عَ حَشَنكَتَ تْورّ رَ،</para>
  <para style="q" vid="ISA 53:10">كْنْ سّرّشّ نَ بَ يُنُبِيٍ شَ قٍ رَ،</para>
  <para style="q" vid="ISA 53:10">عَ قَمَ نّ عَ بْنسْي تٌدٍ، عَ بُ عَبَدَن.</para>
  <para style="q" vid="ISA 53:10">عَلَتَلَ وَشْنقٍ رَكَمَلِمَ عَ تَن نَن سَابُي رَ.<verse eid="ISA 53:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 53:11"/>عَ نَ فّ عَ شَ وَلِ رَبَدٍ،</para>
  <para style="q" vid="ISA 53:11">عَ قَمَ نّ سّيوَدٍ.</para>
  <para style="b" vid="ISA 53:11"/>
  <para style="q" vid="ISA 53:11">«ﭑ مَ كٌنيِ تِنشِنشِ حَمَ قِندِ مَ نّ تِنشِنتْييٍ رَ،</para>
  <para style="q" vid="ISA 53:11">عَ عٍ شُن سَرَ عٍ شَ يُنُبِيٍ شَ قٍ رَ.<verse eid="ISA 53:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 53:12"/>ﭑ تِدٍ شُنفبٍ سٌمَ نّ عَ يِ رَ،</para>
  <para style="q" vid="ISA 53:12">عَ شُننَكٍلِ سَرٍ سْتْ سّنبّ رَ،</para>
  <para style="q" vid="ISA 53:12">عَ تٌ قَشَ مَتَندِلَيٍ يِ رَ،</para>
  <para style="q" vid="ISA 53:12">عَ نُ بَرَ عَ يّتّ قِ سّرّشّ رَ مِشِ فبٍفبٍ شَ يُنُبِيٍ شَ قٍ رَ.»<verse eid="ISA 53:12"/></para>
  <chapter eid="ISA 53"/>
  <chapter number="54" style="c" sid="ISA 54"/>
  <para style="s">سِيٌنِ شَ شُننَكٍلِ</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 54:1"/>«دِبَرِتَرٍ، نَشٍيٍ مُ نْمَ دِ بَرِدٍ، وٌ شَ سّيوَ،</para>
  <para style="q" vid="ISA 54:1">وٌ شَ بّيتِ بَ، وٌ تَن نَشٍيٍ مُ دِ سْتْشِ سِندٍن.</para>
  <para style="q" vid="ISA 54:1">وٌ قَمَ نّ دِ وُيَشِ سْتْدٍ دَنفِقٍ فِنّ فبّتّيٍ رَ.</para>
  <para style="q" vid="ISA 54:1">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.»<verse eid="ISA 54:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="ISA 54:2"/>«وٌ شَ وٌ شْنيِ رَشُنفبٌ،</para>
  <para style="q" vid="ISA 54:2">وٌ شَ ندٍ سَ وٌ شَ بَنشِيٍ شَ فبٌي شُن،</para>
  <para style="q" vid="ISA 54:2">وٌ شَ نَ بِرِن يَءِلَن عَ قَنيِ رَ،<verse eid="ISA 54:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 54:3"/>بَرِ مَ وٌ يِرِوَ مَ نّ يِرٍقَنيِ نُن كْولَ مَ وٌ شَ بْشِ كُي.</para>
  <para style="q" vid="ISA 54:3">وٌ شَ مِشِيٍ حَمَنّ ندٍ مِشِيٍ كٍرِ مَ نّ،</para>
  <para style="q" vid="ISA 54:3">عٍ قَ سَبَتِ عٍ شَ تَايٍ كُي.<verse eid="ISA 54:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 54:4"/>هَلِ وٌ مُ هَنمّ، وٌ مُ يَافِ يٌ سْتْمَ.</para>
  <para style="q" vid="ISA 54:4">وٌ نَشَ فَاشُ نَ يَ رَ، وٌ شَ قٍ مُ رَفٌرٌ مَ نّ.</para>
  <para style="q" vid="ISA 54:4">وٌ قَمَ نّ نّيمُدٍ نَ يَافِ شَ قٍ رَ وٌ نَشَن سْتْ وٌ قٌنِكٍ تّمُي،</para>
  <para style="q" vid="ISA 54:4">وٌ مُ لُ رَ مَحْشُن نَ وٌ شَ كَاحّ قٍ رَ،<verse eid="ISA 54:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 54:5"/>بَرِ مَ وٌ دَالِ مَنفّ مّينِمَ وٌ مَ</para>
  <para style="q" vid="ISA 54:5">عَلْ شّمّ مّينِمَ عَ شَ فِنّ مَ كِ نَشّ،</para>
  <para style="q" vid="ISA 54:5">نَشَن شِلِ قَلَمَ وٌ مَرِفِ عَلَتَلَ سّنبّمَ،</para>
  <para style="q" vid="ISA 54:5">نَشَن قِندِشِ عِسِرَيِلَ شَ سّنِيّنتْي رَ،</para>
  <para style="q" vid="ISA 54:5">نَشَن وٌ رَكِسِمَ،</para>
  <para style="q" vid="ISA 54:5">نَشَن شِلِ عَلَ دُنِحَ كَنيِ.<verse eid="ISA 54:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 54:6"/>عَلَتَلَ قَمَ نّ وٌ رَفبِلٍندٍ عَ مَ،</para>
  <para style="q" vid="ISA 54:6">عَلْ فِنّ نَشَن نُ بَرَ رَبٌلٌ، عَ قَ لُ تْورّ كُي،</para>
  <para style="q" vid="ISA 54:6">عَلْ سُنفبُتُنيِ نَشَن شَ مْرِ بَرَ مّي عَ رَ.</para>
  <para style="q" vid="ISA 54:6">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.»<verse eid="ISA 54:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="ISA 54:7"/>«عَلَ نَشّ، ‹ﭑ عِ رَبٌلٌ نّ تّمُي دُنكٍ دِ،</para>
  <para style="q" vid="ISA 54:7">كْنْ ﭑ مَن عِ مَسٌمَ نّ ﭑ نَ ﭑ مَ شَنُنتٍيَ شُنفبٍ كُي.<verse eid="ISA 54:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 54:8"/>ﭑ عِ كٍرِ بْحّتٍ شُنفبٍ نَن كُي تّمُي دُنكٍ دِ،</para>
  <para style="q" vid="ISA 54:8">كْنْ ﭑ مَن كِنِكِنِمَ نّ عِ مَ مَرَقَنيِ كُي عَبَدَن.›</para>
  <para style="q" vid="ISA 54:8">ﭑ تَن عَلَتَلَ وٌ كَنتَمَ شَ مَسٍنيِ نَن نَ كِ.»<verse eid="ISA 54:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="ISA 54:9"/>«عَ لُمَ نّ ﭑ بّ عَلْ نُهَ شَ تّمُي،</para>
  <para style="q" vid="ISA 54:9">ﭑ تٌ ﭑ كَلِ عَ بَنبَرَنيِ مُ دُنِحَ كَنَمَ سْنْن.</para>
  <para style="q" vid="ISA 54:9">ﭑ بَرَ ﭑ كَلِ عَ ﭑ مُ شْنْمَ وٌ مَ، ﭑ مُ وٌ سْنتْمَ سْنْن.<verse eid="ISA 54:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 54:10"/>هَلِ فٍيَيٍ سَ سّرّنقٍ نّ، تٍنتٍنيِيٍ نَشَ فِرَ عَ رَ،</para>
  <para style="q" vid="ISA 54:10">ﭑ مَ شَنُنتٍيَ مُ نْمَ شُرُندٍ وٌ بّ،</para>
  <para style="q" vid="ISA 54:10">ﭑ مُ مَ بْحّسَ سَاتّ كَنَمَ ﭑ نَشَن تٌنفٌشِ وٌن بّ.</para>
  <para style="q" vid="ISA 54:10">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ نَشَن كِنِكِنِمَ وٌ مَ.»<verse eid="ISA 54:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="ISA 54:11"/>«وٌ تَن بْنسْي حَشَنكَتَشِ،</para>
  <para style="q" vid="ISA 54:11">نَشٍيٍ بَرَ تْورْ كِنِكِنِتَرٍحَ كُي،</para>
  <para style="q" vid="ISA 54:11">ﭑ مَن وٌ شَ تَا تِمَ نّ فّمّ قَنيِ قَرِ،</para>
  <para style="q" vid="ISA 54:11">ﭑ وٌ رَشُنمَ دِيَمَن نَ،<verse eid="ISA 54:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 54:12"/>ﭑ وٌ شَ يِرٍ عِتٍشِ يَءِلَنمَ فّمّ تٌقَنيِيٍ نَن نَ،</para>
  <para style="q" vid="ISA 54:12">ﭑ وٌ شَ نَادّيٍ رَشُنمَ فّمّ رَيَبُشِيٍ رَ،</para>
  <para style="q" vid="ISA 54:12">ﭑ وٌ شَ تّتّ تِ فّمّ يَنبَشِيٍ رَ.<verse eid="ISA 54:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 54:13"/>وٌ شَ دِيٍ بِرِن بِرَ مَ نّ عَلَتَلَ قْشْ رَ،</para>
  <para style="q" vid="ISA 54:13">عٍ شَ قٍ بِرِن سْونّيَ.<verse eid="ISA 54:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 54:14"/>ﭑ تٌ وٌ فبٍ حْشْمَ، وٌ مَن قَمَ نّ تِدٍ سّنبّ رَ.</para>
  <para style="q" vid="ISA 54:14">وٌ يَشُييٍ مُ وٌ تْورْ مَ سْنْن،</para>
  <para style="q" vid="ISA 54:14">وٌ مُ لُمَ فَاشُي كُي.</para>
  <para style="q" vid="ISA 54:14">وٌ مُ فَاشُمَ قٍقٍ يَ رَ سْنْن.<verse eid="ISA 54:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 54:15"/>شَ فٍرٍ سَ بُلَ وٌ شِلِ مَ،</para>
  <para style="q" vid="ISA 54:15">نَ مُ كٍلِشِ ﭑ تَن شَ مَ.</para>
  <para style="q" vid="ISA 54:15">ﭑ شَ عَ قَلَ وٌ بّ، وٌ فٍرٍقَيٍ شَ قٍ كَنَمَ نّ.<verse eid="ISA 54:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 54:16"/>ﭑ تَن نَن شَبُي دَا،</para>
  <para style="q" vid="ISA 54:16">نَشَن وُرٍ رَشُنُمَ تّ رَ، عَ قَ فٍرٍ سٌسٍ يَءِلَن.</para>
  <para style="q" vid="ISA 54:16">نَ كُي ﭑ مَن قَ سْورِ دَا، نَشَن عَ يَشُييٍ شَ قٍ كَنَمَ.<verse eid="ISA 54:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 54:17"/>كْنْ فٍرٍ سٌسٍ نَشَن بِرِن يَءِلَنشِ وٌ تَن شِلِ مَ،</para>
  <para style="q" vid="ISA 54:17">ﭑ عَ نِيَمَ نّ عٍ مُ وٌ لِ قٍقٍ مَ.</para>
  <para style="q" vid="ISA 54:17">نَشَن يٌ وٌ تْوحّفّ، كِيتِ نَن كَنَمَ نَ كَنيِ رَ.</para>
  <para style="q" vid="ISA 54:17">عَلَتَلَ عَ شَ كٌنيِيٍ فبٍ حْشْمَ نّ.</para>
  <para style="q" vid="ISA 54:17">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.»<verse eid="ISA 54:17"/></para>
  <chapter eid="ISA 54"/>
  <chapter number="55" style="c" sid="ISA 55"/>
  <para style="s">عَلَ شَ كِسِ عِبُنَدَ مَ بّ</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 55:1"/>«يٍ شْلِ نَ وٌ تَن نَشٍيٍ مَ،</para>
  <para style="q" vid="ISA 55:1">وٌ قَ يٍ يِرٍ، وٌ شَ قَ يٍ مِن.</para>
  <para style="q" vid="ISA 55:1">هَلِ كْبِرِ مُ نَ وٌ يِ رَ،</para>
  <para style="q" vid="ISA 55:1">وٌ قَ، وٌ شَ قَ دٌنسٍ سْتْ، وٌ شَ وٌ دّفٍ.</para>
  <para style="q" vid="ISA 55:1">وٌ قَ، وٌ شَ وّنِ نُن شِحّ مِن هَلِ وٌ مُ عَ سَرٍ قِ.<verse eid="ISA 55:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 55:2"/>مُنقٍ رَ وٌ كْبِرِ بَمَ سٍيٍ شَ قٍ رَ نَشٍيٍ مُ قِندِ بَلٌي رَ؟</para>
  <para style="q" vid="ISA 55:2">مُنقٍ رَ وٌ وَلِ رَبَمَ نَشَن تِدٍ مُ نَ وٌ بّ؟</para>
  <para style="q" vid="ISA 55:2">وٌ وٌ تُلِ مَتِ ﭑ نَ،</para>
  <para style="q" vid="ISA 55:2">وٌ شَ وٌ بَلٌ قٍ قَنيِ رَ</para>
  <para style="q" vid="ISA 55:2">نَشَن سّيوّ قِمَ وٌ مَ.<verse eid="ISA 55:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 55:3"/>وٌ وٌ تُلِ مَتِ ﭑ نَ،</para>
  <para style="q" vid="ISA 55:3">وٌ شَ قَ ﭑ يِرٍ عَلَكٌ وٌ شَ بَلٌي سْتْ.</para>
  <para style="q" vid="ISA 55:3">نَ كُي ﭑ قَمَ شَنُنتٍيَ سَاتّ شِرِدٍ وٌن تَفِ نَشَن مُ كَنَمَ.</para>
  <para style="q" vid="ISA 55:3">نَ لُمَ نّ عَلْ ﭑ سَاتّ نَشَن شِرِ عَننَبِ دَوُدَ نُن ﭑ تَن تَفِ عَ سّرِيّ كِ مَ،<verse eid="ISA 55:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 55:4"/>ﭑ نَشَن تِشِ سٍيدٍ رَ سِيٍ بّ،</para>
  <para style="q" vid="ISA 55:4">عَ قِندِ مَنفّ شُنفبٍ رَ عٍ بّ.<verse eid="ISA 55:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 55:5"/>وٌ قَمَ نّ سِيٍ شِلِدٍ وٌ مُ نَشٍيٍ كٌلٌن،</para>
  <para style="q" vid="ISA 55:5">سِيٍ قَمَ نّ وٌ يِرٍ نَشٍيٍ مُ نُ وٌ كٌلٌن،</para>
  <para style="q" vid="ISA 55:5">بَرِ مَ وٌ مَرِفِ عَلَتَلَ، عِسِرَيِلَ شَ سّنِيّنتْي قَمَ نّ بِنيّ قِدٍ وٌ مَ.<verse eid="ISA 55:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 55:6"/>وٌ شَ فبِلٍن عَلَتَلَ مَ، عَ تٌ نْمَ تٌدٍ.</para>
  <para style="q" vid="ISA 55:6">وٌ شَ عَ شِلِ، عَ تٌ نَ يِرٍ مَكْرّشِ.<verse eid="ISA 55:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 55:7"/>مِشِ حَاشِ شَ فبِلٍن عَ شَ كِرَ كٌبِ قْشْ رَ،</para>
  <para style="q" vid="ISA 55:7">يُنُبِتْي شَ عَ شَ نَتّ لُ نَا.</para>
  <para style="q" vid="ISA 55:7">عَ شَ فبِلٍن وٌن مَرِفِ عَلَتَلَ مَ،</para>
  <para style="q" vid="ISA 55:7">عَلَكٌ عَ شَ كِنِكِنِ عَ مَ،</para>
  <para style="q" vid="ISA 55:7">عَ شَ عَ شَ يُنُبِيٍ شَقَرِ.<verse eid="ISA 55:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 55:8"/>ﭑ مَ مَحْشُنيِيٍ نُن وٌ تَن شَ مَحْشُنيِيٍ، عٍ كٍرٍن مُ عَ رَ.</para>
  <para style="q" vid="ISA 55:8">ﭑ مَ كِرَيٍ نُن وٌ شَ كِرَيٍ قَن، عٍ كٍرٍن مُ عَ رَ.</para>
  <para style="q" vid="ISA 55:8">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.»<verse eid="ISA 55:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="ISA 55:9"/>«كٌورٍ مَكُيَشِ بْشِ رَ كِ نَشّ،</para>
  <para style="q" vid="ISA 55:9">ﭑ مَ كِرَ مَكُيَشِ وٌ فبٍيٍ رَ نَ كِ نّ.</para>
  <para style="q" vid="ISA 55:9">ﭑ مَ مَحْشُنيِيٍ مَكُيَ وٌ فبٍيٍ رَ ثٌن.<verse eid="ISA 55:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 55:10"/>تُنّ نَ فٌرٌ بْشِ مَ،</para>
  <para style="q" vid="ISA 55:10">عَ مُ فبِلٍنمَ قٌ عَ بْشِ بُندَ، عَ سَنسِيٍ رَقَن، نَشٍيٍ عَدَ مَدِيٍ بِرِن نَبَلٌمَ.<verse eid="ISA 55:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 55:11"/>ﭑ مَ مَسٍنيِ قَن نَ نَ كِ نّ نَشَن مِنِمَ ﭑ دّ عِ.</para>
  <para style="q" vid="ISA 55:11">عَ مُ فبِلٍنمَ ﭑ مَ قٌ عَ ﭑ سَفٌي رَكَمَلِ،</para>
  <para style="q" vid="ISA 55:11">عَ ﭑ وَشْنقٍ رَبَ، ﭑ عَ شّيشِ نَشَن مَ.<verse eid="ISA 55:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 55:12"/>وٌ مِنِمَ سّيوّ نُن بْحّسَ نَن كُي،</para>
  <para style="q" vid="ISA 55:12">فٍيَيٍ يَتِ حّلّشِنيِ سِفِ سَمَ نّ وٌ يَ رَ،</para>
  <para style="q" vid="ISA 55:12">دَاشَ سَنسِيٍ عٍ بّلّشّ بْنبْمَ نّ وٌ بّ.<verse eid="ISA 55:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 55:13"/>سِثِرّ وُرِ بُلَمَ نّ تُنبٍ سَنسِ نُ نَ دّننَشّ،</para>
  <para style="q" vid="ISA 55:13">وُرِ فبّتّيٍ بُلَمَ نّ حٌوفٍ حَاشِ نُ نَ دّننَشّ.</para>
  <para style="q" vid="ISA 55:13">نَ بِرِن قِندِ مَ تْنشُمَ نَن نَ عَلَتَلَ شَ قٍ رَ،</para>
  <para style="q" vid="ISA 55:13">تْنشُمَ نَشَن مُ كَنَمَ عَبَدَن.»<verse eid="ISA 55:13"/></para>
  <chapter eid="ISA 55"/>
  <chapter number="56" style="c" sid="ISA 56"/>
  <para style="s">بْنسْي فبّتّيٍ كِسِ سْتْقٍ</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 56:1"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="ISA 56:1">«وٌ بِرَ نْندِ نُن تِنشِنيِ قْشْ رَ،</para>
  <para style="q" vid="ISA 56:1">بَرِ مَ ﭑ مَ كِسِ نَ قَقٍ،</para>
  <para style="q" vid="ISA 56:1">عَ فبٍ مُ لُشِ ﭑ مَ تِنشِنيِ شَ تٌ.<verse eid="ISA 56:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 56:2"/>بَرَكَ نَ مِشِ بّ نَشَن وَلِمَ نَ كِ،</para>
  <para style="q" vid="ISA 56:2">نَشَن نَ سّرِيّ سُشُمَ عَ قَنيِ رَ،</para>
  <para style="q" vid="ISA 56:2">نَشَن عَ حْشْ سَمَ مَلَبُ لْشْي شَ قٍ شْن مَ،</para>
  <para style="q" vid="ISA 56:2">عَ مُ عَ مَبٍرٍ، عَ مُ عَ بّلّشّ تِ وَلِ حَاشِ مَ.»<verse eid="ISA 56:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="ISA 56:3"/>«شْحّ نَشَن عَ شَشِلِ تِ عَلَتَلَ رَ،</para>
  <para style="q" vid="ISA 56:3">نَ نَشَ عَ قَلَ،</para>
  <para style="q" vid="ISA 56:3">‹عَلَتَلَ ﭑ بَمَ نّ عَ شَ حَمَ يَ مَ ﭑ مَ شْحّيَ شَ قٍ رَ.›</para>
  <para style="q" vid="ISA 56:3">مِشِ بَنَشِ نَشَ عَ قَلَ،</para>
  <para style="q" vid="ISA 56:3">‹ﭑ لُشِ نّ عَلَ بّ عَلْ وُرِ شَرَشِ نَشَن تِدٍ مُ فبٌ.›»<verse eid="ISA 56:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 56:4"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="ISA 56:4">«مِشِ بَنَشِ نَشٍيٍ عٍ حْشْ سَمَ مَلَبُي لْشْي شَ قٍ شْن مَ،</para>
  <para style="q" vid="ISA 56:4">نَشٍيٍ ﭑ وَشْنقٍ رَبَمَ،</para>
  <para style="q" vid="ISA 56:4">نَشٍيٍ ﭑ مَ سَاتّ مَبَنبَنمَ،<verse eid="ISA 56:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 56:5"/>ﭑ تْنشُمَ ندٍ تِمَ نّ نٍيٍ بّ ﭑ مَ بَنشِ كُي،</para>
  <para style="q" vid="ISA 56:5">نَشَن تِدٍ دَنفِ دِ بَرِقٍ رَ.</para>
  <para style="q" vid="ISA 56:5">ﭑ عٍ شِلِ شُنفبٌمَ نّ عَبَدَن،</para>
  <para style="q" vid="ISA 56:5">نَ بِنيّ مُ بَمَ عٍ مَ قٍقٍ مَ.<verse eid="ISA 56:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 56:6"/>شْحّ نَشٍيٍ عٍ شَشِلِ تِمَ عَلَتَلَ رَ،</para>
  <para style="q" vid="ISA 56:6">عٍ بِرَ عَ شِلِ قْشْ رَ شَنُنتٍيَ كُي،</para>
  <para style="q" vid="ISA 56:6">عٍ عَ بَتُ،</para>
  <para style="q" vid="ISA 56:6">عٍ عٍ حْشْ سَ عَ شَ مَلَبُي لْشْي شَ قٍ شْن مَ،</para>
  <para style="q" vid="ISA 56:6">عٍ مُ عَ مَبٍرٍ،</para>
  <para style="q" vid="ISA 56:6">نَشٍيٍ ﭑ مَ سَاتّ مَبَنبَنمَ،<verse eid="ISA 56:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 56:7"/>ﭑ عٍ شَنِنمَ نّ ﭑ مَ فٍيَ سّنِيّنشِ مَ،</para>
  <para style="q" vid="ISA 56:7">عٍ شَ سّيوَ ﭑ مَ بَنشِ كُي مِشِ ﭑ مَشَندِ مَ دّننَشّ.</para>
  <para style="q" vid="ISA 56:7">ﭑ عٍ شَ سّرّشّ فَن دَاشِ نُن عٍ شَ سّرّشّ فبّتّيٍ سُشُمَ نّ ﭑ مَ سّرّشّبَدٍ قَرِ،</para>
  <para style="q" vid="ISA 56:7">بَرِ مَ ﭑ مَ بَنشِ شِلِ قَلَمَ نّ ‹سَلِدٍ بَنشِ سِ بِرِن بّ.›<verse eid="ISA 56:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 56:8"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ، عَلَ نَشَن عِسِرَيِلَ دِ رَيٍنسٍنشِيٍ مَلَنمَ،</para>
  <para style="q" vid="ISA 56:8">عَ نَشّ، ‹ﭑ مَن عٍ مَلَنمَ نّ ﭑ يِرٍ.›»<verse eid="ISA 56:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="ISA 56:9"/>وٌ تَن سُبٍ نَشٍيٍ نَ بُرُنيِ،</para>
  <para style="q" vid="ISA 56:9">وٌ قَ وٌ دّ مَدٌن.<verse eid="ISA 56:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 56:10"/>عٍ كَنتَمَيٍ لُشِ نّ عَلْ دْنشُييٍ،</para>
  <para style="q" vid="ISA 56:10">عٍ مُ فّشِ قَهَامُي سْتْدٍ.</para>
  <para style="q" vid="ISA 56:10">عٍ لُشِ نّ عَلْ بَرٍ نَشٍيٍ مُ نْمَ وٌنوٌندٍ،</para>
  <para style="q" vid="ISA 56:10">عٍ سَشِ تّمُي بِرِن، شِ شْلِ نَن تُن حْشُن عٍ بّ.<verse eid="ISA 56:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 56:11"/>عٍ لُشِ نّ عَلْ بَرٍ نَشٍيٍ مُ لُفَمَ عٍ شَ دٌنسٍ رَ.</para>
  <para style="q" vid="ISA 56:11">عٍ لُشِ نّ عَلْ شُرُ سٍ كَنتّيٍ نَشٍيٍ مُ فّشِ قَهَامُي سْتْدٍ،</para>
  <para style="q" vid="ISA 56:11">كَنكَن بِرَشِ عَ يّتّ شَ كِرَ نَن قْشْ رَ فٍينِ شَ قٍ رَ.<verse eid="ISA 56:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 56:12"/>عٍ عَ قَلَمَ عٍ بٌورٍيٍ بّ،</para>
  <para style="q" vid="ISA 56:12">«وٌ قَ، وٌن شَ بٍيرٍ قٍن، وٌن شَ سِسِ.</para>
  <para style="q" vid="ISA 56:12">تِنَ قَن وٌن شَ فبِلٍن نَ رَبَ رَ.</para>
  <para style="q" vid="ISA 56:12">تّمُندٍ تِنَ قَمَ نّ قِسَدٍ تٌ بّ.»<verse eid="ISA 56:12"/></para>
  <chapter eid="ISA 56"/>
  <chapter number="57" style="c" sid="ISA 57"/>
  <para style="s">بْحّسَ كَنيِ</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 57:1"/>تِنشِنتْي نَ سَيَ كِرَ شْن مَ،</para>
  <para style="q" vid="ISA 57:1">كْنْ مِشِ يٌ مُ عَ حْشْ سَ نَ هِننّتْي شَ قٍ شْن مَ.</para>
  <para style="q" vid="ISA 57:1">مِشِيٍ مُ عَ كٌلٌن عَ عَلَ نَن تِنشِنتْييٍ بَمَ تْورّ كُي.<verse eid="ISA 57:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 57:2"/>نَشَن لُمَ تِنشِنيِ شَ كِرَ شْن مَ،</para>
  <para style="q" vid="ISA 57:2">عَ مَلَبُي قَنيِ سْتْمَ نّ يَرٍ.<verse eid="ISA 57:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="ISA 57:3"/>«كْنْ وٌ تَن سٍمَتٌي بْنسْي،</para>
  <para style="q" vid="ISA 57:3">نَشٍيٍ قَتَنشِ يّنّ نُن لَنفٌيحَ رَ، وٌ قَ بٍ.<verse eid="ISA 57:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 57:4"/>وٌ ندٍ مَيٍلٍقٍ؟ وٌ ندٍ مَبٍرٍقٍ وٌ دّ رَ؟</para>
  <para style="q" vid="ISA 57:4">مَتَندِلَيٍ نَن وٌ رَ نَشٍيٍ قَتَنشِ وُلٍ قَلّيٍ رَ.<verse eid="ISA 57:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 57:5"/>وٌ يّنّ رَبَمَ وُرِيٍ بُن مَ مِشِ كُيٍيٍ بَتُمَ دّننَشّ.</para>
  <para style="q" vid="ISA 57:5">وٌ دِيٍ قَشَمَ سّرّشّ رَ قٌلٍ كُي نَ كُيٍيٍ بّ.<verse eid="ISA 57:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 57:6"/>نَ كُيٍيٍ قِندِشِ وٌ شَ عَلَيٍ نَن نَ وٌ بِرَ مَ نَشٍيٍ قْشْ رَ.</para>
  <para style="q" vid="ISA 57:6">وٌ مِنسٍ سّرّشّ بَمَ عٍ بّ، وٌ سَنسِ شْرِ قِمَ عٍ مَ.</para>
  <para style="q" vid="ISA 57:6">عَ مُ لَنمَ ﭑ شَ ﭑ فبٍ حْشْ نَ قٍ مَ؟»<verse eid="ISA 57:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="ISA 57:7"/>«وٌ بَرَ سَدٍ يَءِلَن فٍيَ قَرِ وٌ سّرّشّيٍ بَمَ دّننَشّ.<verse eid="ISA 57:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 57:8"/>وٌ وٌ شَ كُيٍ تْنشُمَيٍ تِمَ وٌ شَ نَادّ سّيتِ مَ.</para>
  <para style="q" vid="ISA 57:8">وٌ بَرَ فبِلٍن ﭑ تَن قْشْ رَ، وٌ قَ كُيٍيٍ شِلِ عٍ شَ سَ وٌ قّ مَ سَدٍ مَ.</para>
  <para style="q" vid="ISA 57:8">وٌ تٌ فّ سَاتّ شِرِدٍ وٌ بٌرٍ تَفِ، وٌ نَشَ سَدٍ قٍ رَبَ.<verse eid="ISA 57:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 57:9"/>وٌ بَرَ تُرٍ نُن لَبُندّ شَنِن وٌ شَ مَنفّ شْن،</para>
  <para style="q" vid="ISA 57:9">وٌ بَرَ شّيرَيٍ شّي هَن عَلِفِيَمَ.<verse eid="ISA 57:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 57:10"/>نَ بِرِن قِندِشِ تَفَنيِ نَن نَ وٌ بّ،</para>
  <para style="q" vid="ISA 57:10">كْنْ وٌ مَن تٌندِشِ فبِلٍندٍ نَ قْشْ رَ.</para>
  <para style="q" vid="ISA 57:10">وٌ وٌ سّنبّ نَن تُن سٌقٍ، لُقٍ رَ نَ كِرَ شْن مَ.»<verse eid="ISA 57:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="ISA 57:11"/>«ثٍ، وٌ كْنتْقِلِشِ ندٍ شَ قٍ رَ، نَشَن عَ نِيَمَ وٌ شَ نّيمُ ﭑ مَ؟</para>
  <para style="q" vid="ISA 57:11">وٌ فَاشُشِ ندٍ يَ رَ، نَشَن عَ نِيَمَ وٌ مُ ﭑ مَ قٍ مَتٌ سْنْن؟</para>
  <para style="q" vid="ISA 57:11">مُنسٍ عَ نِيَشِ وٌ شَ ﭑ يَنقَ؟</para>
  <para style="q" vid="ISA 57:11">ﭑ تٌ دُندُشِ عَ شْنكُيٍ رَ، نَ نَن عَ نِيَشِ وٌ مُ فَاشُشِ ﭑ يَ رَ سْنْن؟<verse eid="ISA 57:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 57:12"/>ﭑ وٌ مَكِيتِمَ نّ وٌ شَ وَلِ مَ، وٌ نَشَن شِلِمَ وَلِ قَنيِ.</para>
  <para style="q" vid="ISA 57:12">نَ مُ قَنمَ وٌ بّ قٍقٍ مَ.<verse eid="ISA 57:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 57:13"/>وٌ شَ وٌ شَ كُيٍيٍ شِلِ.</para>
  <para style="q" vid="ISA 57:13">وٌن شَ عَ مَتٌ شَ عٍ نْمَ وٌ مَلِدٍ.</para>
  <para style="q" vid="ISA 57:13">قٌيٍ عٍ شَنِنمَ نّ!</para>
  <para style="q" vid="ISA 57:13">كْنْ نَشَن يٌ نَ عَ شَشِلِ تِ ﭑ تَن نَ،</para>
  <para style="q" vid="ISA 57:13">عَ يِ بْشِ سْتْمَ نّ كّ رَ،</para>
  <para style="q" vid="ISA 57:13">عَ تٍ ﭑ مَ فٍيَ سّنِيّنشِ نَن قَرِ.»<verse eid="ISA 57:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="ISA 57:14"/>عَلَتَلَ عَ قَلَمَ نّ،</para>
  <para style="q" vid="ISA 57:14">«وٌ وَكِلِ، وٌ شَ كِرَ يَءِلَن،</para>
  <para style="q" vid="ISA 57:14">وٌ شَ سٍ حَاشِ بِرِن بَ ﭑ مَ حَمَ يَ رَ!»<verse eid="ISA 57:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 57:15"/>مَرِفِ عَلَ، نَشَن مَ قٍ مُ كَنَمَ عَبَدَن،</para>
  <para style="q" vid="ISA 57:15">نَشَن شِلِ سّنِيّن، عَ شَ مَسٍنيِ نَن يَ،</para>
  <para style="q" vid="ISA 57:15">«ﭑ سَبَتِشِ كٌورٍ نَن نَ سّنِيّنيِ كُي.</para>
  <para style="q" vid="ISA 57:15">ﭑ مِشِ شِلِمَ نّ ﭑ سّيتِ مَ نَشَن بْحّ تْورْشِ،</para>
  <para style="q" vid="ISA 57:15">نَشَن بَرَ عَ يّتّ مَفٌرٌ.</para>
  <para style="q" vid="ISA 57:15">ﭑ وَ مَ عٍ رَلِمَنِيَقٍ،</para>
  <para style="q" vid="ISA 57:15">ﭑ وَ مَ عٍ شُن نَكٍلِقٍ.<verse eid="ISA 57:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 57:16"/>ﭑ مُ وَ مَ ﭑ مَ شْنّ شَ بُ عٍ قْشْ رَ،</para>
  <para style="q" vid="ISA 57:16">شَ نَ مُ ﭑ نَ ﭑ شَشِلِ قِشِ مِشِ نَشٍيٍ مَ، نٍيٍ تَفَنمَ نّ.<verse eid="ISA 57:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 57:17"/>عِسِرَيِلَ تٌ مِلَ يُنُبِ رَبَقٍ مَ،</para>
  <para style="q" vid="ISA 57:17">ﭑ نَشَ عٍ حَشَنكَتَ، ﭑ عٍ رَبٌلٌ،</para>
  <para style="q" vid="ISA 57:17">كْنْ عٍ شَ مُرُتّ نَن تُن شُن نُ مَسَمَ.<verse eid="ISA 57:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 57:18"/>ﭑ بَرَ عٍ وَلِ كِ يَتِ تٌ،</para>
  <para style="q" vid="ISA 57:18">كْنْ ﭑ عٍ دَندَنمَ نّ، ﭑ عٍ مَلِ، ﭑ عٍ بْحّ دْشْ،<verse eid="ISA 57:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 57:19"/>عَلَكٌ عٍ مَن شَ بّيتِ بَ ﭑ بّ.</para>
  <para style="q" vid="ISA 57:19">ﭑ تَن عَلَتَلَ نَشّ،</para>
  <para style="q" vid="ISA 57:19">‹بْحّسَ شَ لُ يِرٍ مَكُيٍكَيٍ بّ!</para>
  <para style="q" vid="ISA 57:19">ﭑ عٍ رَيَلَنمَ نّ.›<verse eid="ISA 57:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 57:20"/>كْنْ مِشِ حَاشِيٍ تَن لُمَ نّ عَلْ بَا مْرْنيِيٍ،</para>
  <para style="q" vid="ISA 57:20">نَشٍيٍ مُ رَشَرَ، نَشٍيٍ نْشْي تُن نَتٍمَ.<verse eid="ISA 57:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 57:21"/>ﭑ تَن عَلَتَلَ نَشّ،</para>
  <para style="q" vid="ISA 57:21">‹بْحّسَ يٌ مُ نَ مِشِ حَاشِيٍ تَن بّ.›»<verse eid="ISA 57:21"/></para>
  <chapter eid="ISA 57"/>
  <chapter number="58" style="c" sid="ISA 58"/>
  <para style="s">سُنيِ قَنيِ</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 58:1"/>«عِ شَ عِ شُي عِتٍ عَلْ سَرَ قٍ شُي،</para>
  <para style="q" vid="ISA 58:1">عَ قَلَقٍ رَ ﭑ مَ حَمَ بّ عٍ بَرَ مُرُتَ،</para>
  <para style="q" vid="ISA 58:1">يَشُبَ بْنسْي بَرَ يُنُبِ سْتْ.<verse eid="ISA 58:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 58:2"/>لْشْ يٌ لْشْ عٍ يَ رَقِندِشِ ﭑ مَ.</para>
  <para style="q" vid="ISA 58:2">عَ لُشِ نّ عَلْ عٍ وَ مَ ﭑ وَشْنيِ نَن كٌلٌنقٍ،</para>
  <para style="q" vid="ISA 58:2">عَلْ حَمَ نَشَن وَ مَ تِنشِنيِ شْن،</para>
  <para style="q" vid="ISA 58:2">نَشَن مُ فبِلٍنشِ عَلَ شَ يَامَرِ قْشْ رَ.</para>
  <para style="q" vid="ISA 58:2">عٍ ﭑ مَشَندِ مَ كِيتِ تِنشِنشِ سَقٍ رَ،</para>
  <para style="q" vid="ISA 58:2">عَ لُشِ نّ عَلْ عٍ نَ وَ عَلَ شَ مَكْرّ عٍ رَ.»<verse eid="ISA 58:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="ISA 58:3"/>«كْنْ عٍ عَ قَلَمَ، ‹مُنقٍ رَ مُشُ سُنمَ، كْنْ عِ مُ عَ سُشُمَ؟</para>
  <para style="q" vid="ISA 58:3">مُنقٍ رَ مُشُ مُشُ سُيِدِ مَ عِ بّ، كْنْ عِ مُ عَ تٌمَ؟›</para>
  <para style="q" vid="ISA 58:3">ﭑ شَ عَ قَلَ وٌ بّ وٌ شَ سُنيِ كُي وٌ وٌ يّتّ وَشْنقٍ نَن تُن نَبَمَ،</para>
  <para style="q" vid="ISA 58:3">وٌ كٌتٍ شْرْشْي دْشْ وٌ شَ وَلِكّيٍ شُن مَ.<verse eid="ISA 58:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 58:4"/>وٌ سُنشِ تّمُي نَشّ، وٌ وٌ بٌرٍ فٍرٍ مَ،</para>
  <para style="q" vid="ISA 58:4">وٌ سْنشْي رَتٍمَ، وٌ وٌ بٌرٍ بْنبْ مِشِ كٌبِحَ كُي.</para>
  <para style="q" vid="ISA 58:4">ﭑ مُ نَ سُنيِ مْولِ سُشُمَ قٍوٌ!<verse eid="ISA 58:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 58:5"/>ﭑ وَ مَ سُنيِ نَشَن شْن، نَ قِندِ مَ مِشِ شَ سُيِدِ نَن تُن نَ؟</para>
  <para style="q" vid="ISA 58:5">مِشِ عَ تِفِ تِقٍ بْشِ، عَلْ مَالٍ مْشِ قٌيٍ نَشَن رَ مَشَمَ،</para>
  <para style="q" vid="ISA 58:5">نَ كٍرٍن قِندِ مَ سُنيِ رَ؟</para>
  <para style="q" vid="ISA 58:5">سُننُنيِ دُفِ رَفٌرٌقٍ مِشِ مَ، شُبٍ تٍقٍ مِشِ شُنيِ رَ،</para>
  <para style="q" vid="ISA 58:5">نَ شِلِ قَلَمَ سُنيِ قَنيِ نَشَن نَقَن عَلَتَلَ مَ؟»<verse eid="ISA 58:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="ISA 58:6"/>«ﭑ وَ مَ سُنيِ مْولِ نَشَن شْن،</para>
  <para style="q" vid="ISA 58:6">وٌ شَ فبِلٍن تِنشِنتَرٍيَ قْشْ رَ، وٌ شَ كٌتٍ شْرْشْي بَ مِشِ شُن مَ.</para>
  <para style="q" vid="ISA 58:6">فٍيلِمَنِ شَ شْرّيَ، كٌتٍ شْرْشْي شَ بَ مِشِ شُن مَ.<verse eid="ISA 58:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 58:7"/>وٌ شَ دٌنسٍ قِ كَامّتْي مَ،</para>
  <para style="q" vid="ISA 58:7">وٌ شَ شِدٍ قِ مِشِ مَ عَ مُ نَشَن يِ،</para>
  <para style="q" vid="ISA 58:7">وٌ شَ دُفِ رَفٌرٌ مِشِ مَ عَ مُ نَشَن يِ،</para>
  <para style="q" vid="ISA 58:7">وٌ نَشَ عَ لُ وٌ نفَشَكٍرٍنيِ شَ سِفَ عَ بّلّشّ عِفٍلِ رَ.<verse eid="ISA 58:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 58:8"/>نَ كُي وٌ يَنبَمَ نّ عَلْ سُبَشّ لٌولٌي،</para>
  <para style="q" vid="ISA 58:8">وٌ يَلَنمَ مَقُرٍن مَقُرٍن،</para>
  <para style="q" vid="ISA 58:8">وٌ شَ تِنشِنيِ كٌلٌنمَ نّ وٌ يَ رَ،</para>
  <para style="q" vid="ISA 58:8">عَلَتَلَ شَ نْرّ وٌ كَنتَمَ نّ وٌ شَنبِ رَ.<verse eid="ISA 58:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 58:9"/>نَ تّمُي وٌ عَلَتَلَ مَشَندِ مَ نّ، عَ قَ نَ سُشُ.</para>
  <para style="q" vid="ISA 58:9">وٌ نَ عَ شِلِ عَ شَ وٌ مَلِ، عَ وٌ شَ شِلِ رَتِنمَ نّ، ‹ﭑ نَ بٍ.›»</para>
  <para style="b" vid="ISA 58:9"/>
  <para style="q" vid="ISA 58:9">«شَ وٌ مُ مِشِ تْورْ مَ،</para>
  <para style="q" vid="ISA 58:9">شَ وٌ مُ مِشِ تْوحّفّمَ،<verse eid="ISA 58:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 58:10"/>شَ وٌ كَامّتْي مَلِمَ،</para>
  <para style="q" vid="ISA 58:10">شَ وٌ تْورْ مِشِ كِمَ،</para>
  <para style="q" vid="ISA 58:10">نَ كُي وٌ يَنبَمَ نّ دِ مِ كُي، وٌ قَ دِ مِ كَنَ عَلْ سٌفٍ يَنيِ تَفِ.<verse eid="ISA 58:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 58:11"/>عَلَتَلَ وٌ رَحّرّ مَ نّ تّمُي بِرِن،</para>
  <para style="q" vid="ISA 58:11">عَ وٌ هَيِ قَنمَ نّ وٌ بّ هَلِ تّمُي شْرْشْي كُي.</para>
  <para style="q" vid="ISA 58:11">عَ سّنبّ قِمَ نّ وٌ مَ،</para>
  <para style="q" vid="ISA 58:11">وٌ قَ لُ عَلْ لَاكْي يٍ مُ شْرِ مَ نَشَن مَ.<verse eid="ISA 58:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 58:12"/>وٌ شَ حَمَ قَمَ نّ وٌ شَ يِرٍ كَنَشِيٍ تِدٍ عَلْ عَ سِنفٍ.</para>
  <para style="q" vid="ISA 58:12">عٍ قَمَ نّ وٌ شِلِ قَلَدٍ، ‹تَا بِلِتِيٍ، بَنشِتِيٍ، نُن تَا يَلَنمَيٍ.›»<verse eid="ISA 58:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="ISA 58:13"/>«شَ وٌ مَلَبُي لْشْي سّرِيّ رَبَتُ،</para>
  <para style="q" vid="ISA 58:13">شَ وٌ مُ وٌ وَشْنقٍ رَبَ ﭑ مَ لْشْي سّنِيّنشِ كُي،</para>
  <para style="q" vid="ISA 58:13">شَ وٌ سّيوَ نَ لْشْي شَ قٍ رَ،</para>
  <para style="q" vid="ISA 58:13">وٌ عَ بِنيَ وٌ شَ حّرّ كِ قَنيِ رَ،</para>
  <para style="q" vid="ISA 58:13">وٌ مُ تِن وْيّنيِ قُقَقُ رَ،<verse eid="ISA 58:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 58:14"/>نَ كُي وٌ قَمَ نّ سّيوَدٍ عَلَتَلَ شَ قٍ كُي،</para>
  <para style="q" vid="ISA 58:14">ﭑ قَ وٌ شَ قٍ عِتٍ وٌ شَ بْشِ قَنيِ مَ،</para>
  <para style="q" vid="ISA 58:14">وٌ شَ حّلّشِنيِ نَ وٌ بٍنبَ يَشُبَ كّ نَن نَ.»</para>
  <para style="b" vid="ISA 58:14"/>
  <para style="q" vid="ISA 58:14">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="ISA 58:14"/></para>
  <chapter eid="ISA 58"/>
  <chapter number="59" style="c" sid="ISA 59"/>
  <para style="s">تِنشِنتَرٍحَ رَحْنيِ</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 59:1"/>عَلَتَلَ قَتَ وٌ رَكِسِدٍ،</para>
  <para style="q" vid="ISA 59:1">عَ قَتَ وٌ شَ دُبَ رَ مّدٍ،<verse eid="ISA 59:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 59:2"/>كْنْ وٌ شَ وَلِ حَاشِ نَن وٌ مَكُيَشِ وٌ مَرِفِ عَلَ رَ،</para>
  <para style="q" vid="ISA 59:2">وٌ شَ يُنُبِيٍ نَن عَ يَتَفِ نْشُنشِ وٌ مَ.</para>
  <para style="q" vid="ISA 59:2">نَ نَن عَ رَ، عَ مُ وٌ شَ مَشَندِ سُشُمَ.<verse eid="ISA 59:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 59:3"/>وُلِ نَ وٌ بّلّشّيٍ مَ، يُنُبِ نَ وٌ مَ.</para>
  <para style="q" vid="ISA 59:3">وٌ وُلٍ قَلَمَ، قٍ حَاشِ نَ وٌ دّ كُي.<verse eid="ISA 59:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 59:4"/>مِشِ يٌ مُ بِرَ مَ كِيتِ تِنشِنشِ قْشْ رَ،</para>
  <para style="q" vid="ISA 59:4">نْندِ تِدٍ مُ نَ وٌ شَ كِيتِقٍ كُي.</para>
  <para style="q" vid="ISA 59:4">وٌ بِرَ مَ وْيّنيِ قُقَقُ نَن قْشْ رَ،</para>
  <para style="q" vid="ISA 59:4">وٌ وُلٍيٍ قَلَمَ نَشٍيٍ تْورّ نُن قٍ حَاشِ رَ مِنِمَ.<verse eid="ISA 59:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 59:5"/>وٌ لُشِ نّ عَلْ بْشِمَسٍ شّلّ.</para>
  <para style="q" vid="ISA 59:5">نَشَن نَ دٌنمَ، عَ كَنيِ قَشَمَ نّ.</para>
  <para style="q" vid="ISA 59:5">نَ شَلّ نَ بُلَ، بْشِمَسٍ نَن مِنِمَ.</para>
  <para style="q" vid="ISA 59:5">وٌ لُشِ نّ عَلْ سَيّلّ.<verse eid="ISA 59:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 59:6"/>عَ فّسّ مُ قِندِ مَ دُفِ رَ.</para>
  <para style="q" vid="ISA 59:6">عَ نَشَن يَءِلَنمَ نَ مُ نْمَ عَ مَكٌتٌدٍ.</para>
  <para style="q" vid="ISA 59:6">قٍ حَاشِ نَ عَ رَ، نَشَن مُ تِنشِن قٍوٌ.<verse eid="ISA 59:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 59:7"/>عٍ شُلُن قٍ حَاشِ رَبَدٍ،</para>
  <para style="q" vid="ISA 59:7">عٍ فبَتَ مِشِ تْوحّفّدٍ، عٍ عَ قَشَ.</para>
  <para style="q" vid="ISA 59:7">عٍ شَ مَحْشُنيِ كٌبِ، عٍ قٍ شُن نَكَنَمَ نَن تُن.<verse eid="ISA 59:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 59:8"/>عٍ مُ وَ مَ بْحّسَ شْن مَ،</para>
  <para style="q" vid="ISA 59:8">تِنشِنيِ يٌ مُ نَ عٍ شَ كِرَ شْن مَ.</para>
  <para style="q" vid="ISA 59:8">عٍ كِرَ مَدَلِنشِيٍ نَن يَءِلَنشِ،</para>
  <para style="q" vid="ISA 59:8">نَشَن مِشِ شُن تِمَ تِنشِنتَرٍيَ شْن.<verse eid="ISA 59:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="ISA 59:9"/>نَ نَن عَ رَ، وٌن مَكُيَشِ تِنشِنيِ رَ،</para>
  <para style="q" vid="ISA 59:9">عَ مُ نْمَ وٌن لِدٍ.</para>
  <para style="q" vid="ISA 59:9">وٌن نَءِيَلَنيِ نَن قٍنمَ،</para>
  <para style="q" vid="ISA 59:9">كْنْ دِ مِ نَن تُن سِنمَ وٌن مَ.</para>
  <para style="q" vid="ISA 59:9">وٌن كُيٍ عِبَ نَن مَمّقٍ، كْنْ وٌن لُمَ كْي تَن نَن كُي.<verse eid="ISA 59:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 59:10"/>وٌن نَ وٌن سَنتِدٍ قٍنقٍ عَلْ دْنشُي نَشَن حّرّ مَ عَ يِرٍ مَسُشُ مَ.</para>
  <para style="q" vid="ISA 59:10">وٌن بِرَ مَ يَنيِ رَ، عَلْ وٌن نَ حّرّقٍ دِ مِ نَن كُي.</para>
  <para style="q" vid="ISA 59:10">وٌن لُشِ نّ عَلْ مِشِ قَشَشِ سّنبّمَيٍ تَفِ.<verse eid="ISA 59:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 59:11"/>وٌن شُرُندُنمَ عَلْ بُرُن سُبٍيٍ،</para>
  <para style="q" vid="ISA 59:11">وٌن وَ شُي رَ مِنِمَ عَلْ فَنبّ.</para>
  <para style="q" vid="ISA 59:11">وٌن فبٍ حْشْي نَن قٍنقٍ، كْنْ وٌن مُ عَ سْتْمَ.</para>
  <para style="q" vid="ISA 59:11">وٌن شَشِلِ تِشِ كِسِ نَن نَ، كْنْ عَ مَكُيَ وٌن نَ.<verse eid="ISA 59:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="ISA 59:12"/>مُشُ نَ نَ كِ نّ، بَرِ مَ مُشُ شَ يُنُبِيٍ وُيَ،</para>
  <para style="q" vid="ISA 59:12">عٍ قِندِشِ سٍيدٍ نَن نَ مُشُ شِلِمَ.</para>
  <para style="q" vid="ISA 59:12">مُشُ شَ يُنُبِيٍ تٌمَ نّ مُشُ يَ مَ،</para>
  <para style="q" vid="ISA 59:12">مُشُ بَرَ عٍ كٌلٌن، مُشُ بَرَ مُشُ تِ عٍ رَ.<verse eid="ISA 59:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 59:13"/>مُشُ بَرَ عِ مَتَندِ، مُشُ بَرَ عِ يَنقَ.</para>
  <para style="q" vid="ISA 59:13">مُشُ بَرَ فبِلٍن مُشُ مَرِفِ عَلَ قْشْ رَ.</para>
  <para style="q" vid="ISA 59:13">مُشُ بَرَ قٍ شْرْشْي دْشْ مُشُ نفَشَكٍرٍنيِيٍ مَ،</para>
  <para style="q" vid="ISA 59:13">مُشُ بَرَ وُلٍ قَلَ نَشٍيٍ قَتَنشِ مُشُ بْحّ كُي.<verse eid="ISA 59:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 59:14"/>مُشُ نُن تِنشِنيِ تَفِ عِكُيَ.</para>
  <para style="q" vid="ISA 59:14">نْندِ مُ تٌمَ وٌن يَ مَ سْنْن.</para>
  <para style="q" vid="ISA 59:14">يَنقَنتٍيَ فبٌ.<verse eid="ISA 59:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 59:15"/>نْندِ تٌ شْنْ، تِنشِنتْي نَن تُن تْورْ مَ.</para>
  <para style="b" vid="ISA 59:15"/>
  <para style="q" vid="ISA 59:15">عَلَتَلَ تٌ عَ تٌ، عَ تِنشِنيِ مُ نَ سْنْن، نَ مُ رَقَن عَ مَ.<verse eid="ISA 59:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 59:16"/>عَ عَ تٌشِ نّ مِشِ يٌ مُ نِمِسَشِ،</para>
  <para style="q" vid="ISA 59:16">عَ عَ دّ رَوَ عَلَتَلَ شْن مَ نَ قٍ مَ.</para>
  <para style="q" vid="ISA 59:16">نَ كُي عَ بَرَ نَ كِسِ وَلِ سُشُ عَ يّتّ رَ عَ شَ تِنشِنيِ شَ قٍ مَ.<verse eid="ISA 59:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 59:17"/>عَ شَ تِنشِنيِ لُشِ نّ عَلْ كَنكٍ مَكَنتَسٍ،</para>
  <para style="q" vid="ISA 59:17">عَ شَ كِسِ لُ عَلْ عَ شُنيِ مَكَنتَسٍ.</para>
  <para style="q" vid="ISA 59:17">فبٍحْشْي لُشِ نّ عَ بّ عَلْ دٌنمَ عَ نَشَن نَفٌرٌ مَ عَ مَ،</para>
  <para style="q" vid="ISA 59:17">عَ شَ وَكِلِ لُ عَ بّ عَلْ شِنبٍلِ دٌنمَ.<verse eid="ISA 59:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 59:18"/>عَلَ كَنكَن سَرٍ قِمَ نّ عَ شَ وَلِ رَ،</para>
  <para style="q" vid="ISA 59:18">عَ شْنْ عَ يَشُييٍ مَ يِرٍ مَكُيٍ،</para>
  <para style="q" vid="ISA 59:18">عَ عٍ سَرٍ قِ.<verse eid="ISA 59:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 59:19"/>عِبُنَدَ مَ فَاشُمَ نّ عَلَتَلَ شِلِ يَ رَ،</para>
  <para style="q" vid="ISA 59:19">عٍ عَ شَ نْرّ بِنيَ كٍلِقٍ سٌفٍتٍدٍ مَ هَن سٌفٍفٌرٌدٍ،</para>
  <para style="q" vid="ISA 59:19">بَرِ مَ عَلَتَلَ سّنبّ عٍ لِمَ نّ عَلْ يٍ نَشَن دِكِ بْو مَ عَ رَ.<verse eid="ISA 59:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="ISA 59:20"/>«شُنسَرَ مَ نَ قَقٍ سِيٌن،</para>
  <para style="q" vid="ISA 59:20">يَشُبَ بْنسْي بّ نَشٍيٍ تُوبِمَ عٍ شَ يُنُبِيٍ شَ قٍ رَ.</para>
  <para style="q" vid="ISA 59:20">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.»<verse eid="ISA 59:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="ISA 59:21"/>عَلَتَلَ نَشّ، «ﭑ مَ سَاتّ نَن يَ عٍ بّ؛</para>
  <para style="q" vid="ISA 59:21">‹ﭑ شَشِلِ نَشَن فٌرٌشِ عِ مَ،</para>
  <para style="q" vid="ISA 59:21">نَ ﭑ مَ مَسٍنيِ نَشَن سَشِ عِ دّ عِ،</para>
  <para style="q" vid="ISA 59:21">نٍيٍ مُ كٍلِمَ وٌ شُن مَ،</para>
  <para style="q" vid="ISA 59:21">نٍيٍ مُ كٍلِمَ وٌ شَ دِيٍ شُن مَ،</para>
  <para style="q" vid="ISA 59:21">نٍيٍ مُ كٍلِمَ عٍ قَن شَ دِيٍ شُن مَ عَبَدَن.›</para>
  <para style="q" vid="ISA 59:21">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.»<verse eid="ISA 59:21"/></para>
  <chapter eid="ISA 59"/>
  <chapter number="60" style="c" sid="ISA 60"/>
  <para style="s">دَرِ سَلَمُ شَ دَرِيّ</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 60:1"/>«وٌ كٍلِ، وٌ شَ نَءِيَلَنيِ بَرَ قَ،</para>
  <para style="q" vid="ISA 60:1">عَلَتَلَ شَ نْرّ بَرَ تِ وٌ مَ.<verse eid="ISA 60:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 60:2"/>دِ مِ بَرَ دُ سُ بْشِ بِرِن شُن نَ،</para>
  <para style="q" vid="ISA 60:2">كُيٍ بَرَ عِقْورْ نَ حَمَيٍ مَ،</para>
  <para style="q" vid="ISA 60:2">كْنْ عَلَتَلَ بَرَ تِ وٌ شُن مَ،</para>
  <para style="q" vid="ISA 60:2">عَ شَ نْرّ بَرَ لُ وٌ يَ مَ.<verse eid="ISA 60:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 60:3"/>حَمَنّيٍ قَمَ نّ وٌ شَ نْرّ مَ،</para>
  <para style="q" vid="ISA 60:3">مَنفّيٍ بّندُنمَ نّ وٌ شَ لٌولٌي شَ يَنبّ مَ.»<verse eid="ISA 60:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="ISA 60:4"/>«وٌ وٌ يَ رَفٍ وٌ رَبِلِنيِ.</para>
  <para style="q" vid="ISA 60:4">عٍ بِرِن مَلَنشِ وٌ يِرٍ،</para>
  <para style="q" vid="ISA 60:4">وٌ شَ دِيٍ قَقٍ كٍلِقٍ يِرٍ مَكُيٍ،</para>
  <para style="q" vid="ISA 60:4">وٌ شَ دِ فِنّيٍ دْشْشِ مِشِيٍ تُنكِ قَرِ.<verse eid="ISA 60:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 60:5"/>وٌ نَ نَ تٌ، وٌ سّيوَ مَ نّ هّرِ رَ،</para>
  <para style="q" vid="ISA 60:5">وٌ بْحّ حّلّشِن.</para>
  <para style="q" vid="ISA 60:5">بَننَيَ نَشَن نَ بَا نَاكِرِ مَ عَ قِندِ مَ نّ وٌ فبٍ رَ،</para>
  <para style="q" vid="ISA 60:5">حَمَنّيٍ شَ بَننَيَ قَ لُ وٌ شْنيِ.<verse eid="ISA 60:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 60:6"/>حْشْمّ فَلِ وُيَمَ نّ وٌ شَ بْشِ مَ،</para>
  <para style="q" vid="ISA 60:6">قَقٍ رَ كٍلِقٍ مَدِيَن نُن عٍقَ بْشِ مَ.</para>
  <para style="q" vid="ISA 60:6">نَشٍيٍ قَمَ كٍلِقٍ سٍيبَ،</para>
  <para style="q" vid="ISA 60:6">عٍ قَمَ شّيمَ نُن سُرَيِ نَن نَ،</para>
  <para style="q" vid="ISA 60:6">عٍ نُ عَلَتَلَ مَتْشْ.<verse eid="ISA 60:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 60:7"/>كٍدَرِ شَ شُرُ سٍيٍ مَلَنمَ نّ وٌ شْنيِ،</para>
  <para style="q" vid="ISA 60:7">نٍبَيٌتِ يّشّي كٌنتٌنيِيٍ لُ وٌ سَفٌي،</para>
  <para style="q" vid="ISA 60:7">ندٍيٍ بَ سّرّشّ فَن دَاشِ رَ ﭑ مَ سّرّشّبَدٍ قَرِ.</para>
  <para style="q" vid="ISA 60:7">ﭑ مَ هْرْ مْبَنشِ يَنبَمَ نّ ﭑ مَ نْرّ رَ.»<verse eid="ISA 60:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="ISA 60:8"/>«لَابَ قِيشّيٍ حّرّ مَ كٌورٍ مَ عَلْ فَنبّ نَشٍيٍ فبِلٍنمَ عٍ شْنيِ.<verse eid="ISA 60:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 60:9"/>حَمَنّيٍ شَشِلِ تِشِ ﭑ نَ،</para>
  <para style="q" vid="ISA 60:9">تَرَ سِسِ كُنكُييٍ نَ يَرٍ قَقٍ رَ وٌ شَ دِيٍ رَ كٍلِقٍ يِرٍ مَكُيٍ.</para>
  <para style="q" vid="ISA 60:9">عٍ قَمَ نّ فبٍتِ نُن شّيمَ رَ وٌ مَرِفِ عَلَتَلَ بِنيَقٍ رَ،</para>
  <para style="q" vid="ISA 60:9">عِسِرَيِلَ شَ سّنِيّنتْي نَشَن بَرَ وٌ شُن نَكٍلِ.»<verse eid="ISA 60:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="ISA 60:10"/>«شْحّيٍ يَتِ قَمَ نّ وٌ شَ تّتّ رَكٍلِدٍ،</para>
  <para style="q" vid="ISA 60:10">حَمَنّيٍ مَنفّيٍ وَلِمَ نّ وٌ بّ.</para>
  <para style="q" vid="ISA 60:10">هَلِ ﭑ تٌ وٌ حَشَنكَتَ ﭑ مَ شْنّ كُي،</para>
  <para style="q" vid="ISA 60:10">ﭑ قَمَ نّ هِننّدٍ وٌ رَ ﭑ مَ كِنِكِنِ شَ قٍ رَ.<verse eid="ISA 60:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 60:11"/>هَلِ وٌ مُ وٌ شَ تَا نَادّيٍ بَلَن،</para>
  <para style="q" vid="ISA 60:11">بَرِ مَ مِشِيٍ قَمَ نّ نَاقُلِ رَ كٍلِقٍ حَمَنّ مَ،</para>
  <para style="q" vid="ISA 60:11">عٍ شَ مَنفّيٍ تِشِ يَرٍ.<verse eid="ISA 60:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 60:12"/>سِ يٌ نَشَن تٌندِ مَ وَلِدٍ وٌ بّ، عَ شُن نَكَنَمَ نّ.»<verse eid="ISA 60:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="ISA 60:13"/>«لِبَن شَ وُرِ قَنيِيٍ شَنِنمَ نّ وٌ شْنيِ،</para>
  <para style="q" vid="ISA 60:13">عَلَكٌ ﭑ مَ هْرْ مْبَنشِ شَ رَكٍلِ،</para>
  <para style="q" vid="ISA 60:13">نْرّ شَ لُ ﭑ سَنيِ تِدٍ.<verse eid="ISA 60:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 60:14"/>وٌ فٍرٍقَيٍ شَ دِيٍ قَمَ نّ عٍ يّتّ مَفٌرٌدٍ وٌ بّ،</para>
  <para style="q" vid="ISA 60:14">وٌ يَشُييٍ عٍ شِنبِ سِن وٌ بُن مَ.</para>
  <para style="q" vid="ISA 60:14">عٍ قَمَ نّ وٌ شِلِ قَلَدٍ، ‹سِيٌنِ، عِسِرَيِلَ مَرِفِ سّنِيّنشِ عَلَتَلَ شَ تَا.›»<verse eid="ISA 60:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="ISA 60:15"/>«هَلِ ﭑ وٌ رَبٌلٌ نّ نُ،</para>
  <para style="q" vid="ISA 60:15">مِشِ يٌ مُ لُ وٌ شَ بْشِ مَ،</para>
  <para style="q" vid="ISA 60:15">ﭑ قَمَ نّ وٌ قِندِدٍ سِ شُنفبٍ رَ،</para>
  <para style="q" vid="ISA 60:15">نَشَن لُمَ شُننَكٍلِ كُي عَبَدَن.<verse eid="ISA 60:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 60:16"/>حَمَنّيٍ شَ مَنفّيٍ شِحّ قِمَ نّ وٌ مَ.</para>
  <para style="q" vid="ISA 60:16">نَ كُي وٌ عَ كٌلٌنمَ نّ عَ ﭑ تَن نَن نَ عَلَتَلَ رَ،</para>
  <para style="q" vid="ISA 60:16">وٌ رَكِسِمَ، وٌ شُنسَرَ مَ، يَشُبَ مَرِفِ سّنبّمَ.<verse eid="ISA 60:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 60:17"/>ﭑ شّيمَ قِمَ نّ وٌ مَ وُرٍ فبٍيلِ حْشْي رَ،</para>
  <para style="q" vid="ISA 60:17">ﭑ فبٍتِ قِ وٌ مَ وُرٍ حْشْي رَ،</para>
  <para style="q" vid="ISA 60:17">ﭑ وُرٍ فبٍيلِ قِ وٌ مَ وُرِ حْشْي رَ،</para>
  <para style="q" vid="ISA 60:17">ﭑ وُرٍ قِ وٌ مَ فّمّ حْشْي رَ.</para>
  <para style="q" vid="ISA 60:17">بْحّسَ نُن تِنشِنيِ نَن قِندِ مَ وٌ شَ مَنفّيٍ رَ.<verse eid="ISA 60:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 60:18"/>قٍ كٌبِ مُ تٌمَ وٌ شَ بْشِ مَ،</para>
  <para style="q" vid="ISA 60:18">فبَلٌي مُ وٌ شْنيِ لِمَ.</para>
  <para style="q" vid="ISA 60:18">وٌ شَ تّتّ شِلِ قَلَمَ نّ ‹كِسِ،›</para>
  <para style="q" vid="ISA 60:18">وٌ شَ تَا نَادّ شِلِ قَلَ ‹مَتْشْي.›<verse eid="ISA 60:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 60:19"/>سٌفٍ شَ مُ يِرٍ عِيَلَنمَ وٌ بّ يَنيِ رَ سْنْن،</para>
  <para style="q" vid="ISA 60:19">كِكٍ شَ مُ يِرٍ عِيَلَنمَ وٌ بّ كْي رَ سْنْن.</para>
  <para style="q" vid="ISA 60:19">عَ كٍلِمَ عَلَتَلَ يَتِ نَن مَ،</para>
  <para style="q" vid="ISA 60:19">عَ عَ شَ نْرّ قِمَ نّ وٌ مَ عَبَدَن.<verse eid="ISA 60:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 60:20"/>سٌفٍ نُن كِكٍ مُ دُلَمَ سْنْن،</para>
  <para style="q" vid="ISA 60:20">عَلَتَلَ نَن قِندِ مَ وٌ شَ نَءِيَلَنيِ رَ تّمُي بِرِن.</para>
  <para style="q" vid="ISA 60:20">وٌ شَ سُننُنيِ تّمُي حْنمَ نّ.<verse eid="ISA 60:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 60:21"/>وٌ شَ حَمَ لُمَ تِنشِنيِ نَن كُي،</para>
  <para style="q" vid="ISA 60:21">وٌ شَ بْشِ لُ وٌ بّ عَبَدَن.</para>
  <para style="q" vid="ISA 60:21">وٌ لُشِ نّ عَلْ سَنسِ سٌلِيٍ ﭑ نَشٍيٍ سِشِ ﭑ بّلّشّ رَ،</para>
  <para style="q" vid="ISA 60:21">عَلَكٌ ﭑ شَ ﭑ مَ نْرّ مَسٍن دُنِحَ بّ.<verse eid="ISA 60:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 60:22"/>هَلِ وٌ شُرُن، وٌ سّنبّ لُمَ نّ عَلْ فَلِ بٍلٍبٍلٍ.</para>
  <para style="q" vid="ISA 60:22">عَلَتَلَ نَن ﭑ نَ.</para>
  <para style="q" vid="ISA 60:22">ﭑ يِ وَلِ رَبَمَ نّ مَقُرٍن مَقُرٍن.»<verse eid="ISA 60:22"/></para>
  <chapter eid="ISA 60"/>
  <chapter number="61" style="c" sid="ISA 61"/>
  <para style="s">عَلَ شَ شّيرَ كِسِشِ</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 61:1"/>ﭑ مَرِفِ عَلَتَلَ شَشِلِ نَ ﭑ مَ،</para>
  <para style="q" vid="ISA 61:1">بَرِ مَ عَ بَرَ ﭑ سُفَندِ شِبَارُ قَنيِ كَوَندِدٍ تْورْ مِشِيٍ بّ،</para>
  <para style="q" vid="ISA 61:1">ﭑ شَ عٍ بْحّ نِمِسَشِ رَيَلَن.</para>
  <para style="q" vid="ISA 61:1">عَ بَرَ ﭑ شّي فٍيلِمَنِيٍ شْرّيَدٍ،</para>
  <para style="q" vid="ISA 61:1">ﭑ شَ مِشِيٍ رَ مِنِ عٍ شَ دِ مِ كُي.<verse eid="ISA 61:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 61:2"/>ﭑ شَ مِشِيٍ رَكٌلٌن عَ عَلَتَلَ شَ هِننّ تّمُي بَرَ قَ،</para>
  <para style="q" vid="ISA 61:2">عَ عٍ فبٍ حْشْمَ نّ.</para>
  <para style="q" vid="ISA 61:2">عَ قَمَ نّ عٍ مَدُندُدٍ،<verse eid="ISA 61:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 61:3"/>عَ شَ هِننّ رَ عَ نَشَن قِمَ سِيٌنِكَيٍ مَ، نَشٍيٍ نَ سُننُنيِ كُي.</para>
  <para style="q" vid="ISA 61:3">عَ دَرِيّ قِمَ نّ عٍ مَ عٍ شَ تْورّ حْشْي رَ،</para>
  <para style="q" vid="ISA 61:3">عَ عٍ وَ شُي مَدُندُ مَ سّيوّ نَن نَ.</para>
  <para style="q" vid="ISA 61:3">عٍ شَ نِمِسّ قِندِ مَ مَتْشْي نَن نَ.</para>
  <para style="q" vid="ISA 61:3">عٍ شِلِ قَلَمَ نّ «كٌندٍ قَنيِ عَلَتَلَ نَشَن سِشِ،»</para>
  <para style="q" vid="ISA 61:3">عَلَكٌ عَ شَ عَ نْرّ مَسٍن دُنِحَ مَ.<verse eid="ISA 61:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 61:4"/>عٍ عٍ شَ تَا كَنَشِ يَءِلَنمَ نّ،</para>
  <para style="q" vid="ISA 61:4">عٍ عٍ شَ تّتّ بِرَشِ رَكٍلِ،</para>
  <para style="q" vid="ISA 61:4">عٍ شَ يِرٍ كَنَشِ قٌرِ قِندِ يِرٍ قَنيِ رَ.<verse eid="ISA 61:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 61:5"/>شْحّيٍ قَمَ نّ وٌ شَ شُرُ سٍيٍ دّ مَدٌندٍ،</para>
  <para style="q" vid="ISA 61:5">عٍ وٌ شَ شّيٍ رَوَلِمَ نّ.<verse eid="ISA 61:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 61:6"/>وٌ تَن شِلِ قَلَمَ نّ «عَلَتَلَ شَ سّرّشّدُبّ،</para>
  <para style="q" vid="ISA 61:6">نَشٍيٍ عَلَ شَ وَلِ رَبَمَ.»<verse eid="ISA 61:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="ISA 61:7"/>«ﭑ مَ حَمَ شَ يَافِ مَسَرَ مَ هّيرِ فبٍفبٍ نَن نَ،</para>
  <para style="q" vid="ISA 61:7">عٍ كّ بٍلٍبٍلٍ نَن سْتْمَ عٍ شَ يَافِ حْشْ رَ.</para>
  <para style="q" vid="ISA 61:7">عٍ يِرٍ بٍلٍبٍلٍ سْتْمَ نّ عٍ شَ بْشِ سِنفٍ تَفِ،</para>
  <para style="q" vid="ISA 61:7">عٍ قَ سّيوَ عَبَدَن.»<verse eid="ISA 61:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="ISA 61:8"/>«تِنشِنيِ نَن نَقَن ﭑ تَن عَلَتَلَ مَ،</para>
  <para style="q" vid="ISA 61:8">كْنْ قُنمَيَ رَحَاشُ ﭑ مَ كِ قَنيِ.</para>
  <para style="q" vid="ISA 61:8">ﭑ مِشِ سَرٍ قِمَ ﭑ شُي بّرّ نَن نَ،</para>
  <para style="q" vid="ISA 61:8">ﭑ مُ ﭑ مَ سَاتّ كَنَمَ عَبَدَن.<verse eid="ISA 61:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 61:9"/>عٍ بْنسْي كٌلٌنمَ نّ سِيٍ تَفِ،</para>
  <para style="q" vid="ISA 61:9">عٍ بْنسْي لُمَ نّ بْنسْي فبّتّ يَ مَ.</para>
  <para style="q" vid="ISA 61:9">مِشِ نَشٍيٍ عٍ تٌمَ،</para>
  <para style="q" vid="ISA 61:9">عٍ عَ كٌلٌن عَلَتَلَ شَ حَمَ بَرَكَشِ نَن عٍ رَ.»<verse eid="ISA 61:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="ISA 61:10"/>ﭑ بَرَ سّيوَ عَلَتَلَ رَ كِ قَنيِ،</para>
  <para style="q" vid="ISA 61:10">ﭑ حّلّشِنشِ ﭑ مَرِفِ عَلَ شَ قٍ رَ،</para>
  <para style="q" vid="ISA 61:10">بَرِ مَ عَ بَرَ ﭑ نَكِسِ،</para>
  <para style="q" vid="ISA 61:10">عَ بَرَ ﭑ مَتِنشِن،</para>
  <para style="q" vid="ISA 61:10">عَلْ فُبَ رَفٌرٌ مَ مِشِ مَ كِ نَشّ.</para>
  <para style="q" vid="ISA 61:10">عَ لُشِ نّ عَلْ تْنشُمَ نَشَن تِمَ سّرّشّدُبّ شُن مَ،</para>
  <para style="q" vid="ISA 61:10">عَلْ كْنمَفٌرٍ نَشَن فبَكُمَ كْن مَ.<verse eid="ISA 61:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 61:11"/>عَلَتَلَ تِنشِنيِ نُن مَتْشْي رَ مِنِمَ نّ دُنِحَ يَ مَ،</para>
  <para style="q" vid="ISA 61:11">عَلْ سَنسِ شْرِيٍ قِندِ مَ سٌلِيٍ رَ كِ نَشّ لَاكْي تَفِ.<verse eid="ISA 61:11"/></para>
  <chapter eid="ISA 61"/>
  <chapter number="62" style="c" sid="ISA 62"/>
  <para style="s">سِيٌنِ شَ قُتِ</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 62:1"/>«ﭑ مُ دُندُ مَ سِيٌنِ شَ قٍ رَ،</para>
  <para style="q" vid="ISA 62:1">ﭑ مُ تَفَنمَ دَرِ سَلَمُ شَ قٍ رَ،</para>
  <para style="q" vid="ISA 62:1">هَن عٍ فبٍ حْشْمَ تّمُي نَشّ،</para>
  <para style="q" vid="ISA 62:1">هَن عٍ كِسِ سْتْ.<verse eid="ISA 62:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 62:2"/>نَ تّمُي حَمَنّيٍ وٌ شَ تِنشِنيِ تٌمَ نّ،</para>
  <para style="q" vid="ISA 62:2">عٍ شَ مَنفّيٍ كَابَمَ نّ وٌ شَ دَرِيّ مَ.</para>
  <para style="q" vid="ISA 62:2">عَلَتَلَ شِلِ نّينّ قِمَ نّ وٌ مَ.<verse eid="ISA 62:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 62:3"/>وٌ قِندِ مَ نّ حَمَ تٌقَنيِ رَ عَلَتَلَ بّلّشّ كُي،</para>
  <para style="q" vid="ISA 62:3">وٌ شَ مَنفّيَ يَنبَ عَ يِ.<verse eid="ISA 62:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 62:4"/>عٍ مُ وٌ شِلِ قَلَمَ سْنْن ‹بْشِ رَبٌلٌشِ،›</para>
  <para style="q" vid="ISA 62:4">شَ نَ مُ عَ رَ ‹بْشِ كَنَشِ.›</para>
  <para style="q" vid="ISA 62:4">عٍ وٌ شِلِ قَلَمَ نّ ‹ﭑ مَ بَاتّ،›</para>
  <para style="q" vid="ISA 62:4">عٍ وٌ شَ بْشِ شِلِ قَلَ ‹فِنّ دْشْي.›</para>
  <para style="q" vid="ISA 62:4">عٍ وٌ شِلِمَ نَ كِ نّ بَرِ مَ عَلَ وٌ شَنُشِ،</para>
  <para style="q" vid="ISA 62:4">عَ بَرَ وٌ شَ بْشِ تٌنفٌ عَ يّتّ بّ</para>
  <para style="q" vid="ISA 62:4">عَلْ شّمّ فِنّ تٌنفٌمَ كِ نَشّ.<verse eid="ISA 62:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 62:5"/>وٌ قَن وٌ شَ بْشِ تٌنفٌمَ وٌ يّتّ بّ نَ كِ نّ،</para>
  <para style="q" vid="ISA 62:5">عَلَ قَن حّلّشِن وٌ رَ.<verse eid="ISA 62:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 62:6"/>ﭑ كَنتَمَيٍ تِمَ نّ دَرِ سَلَمُ تّتّ قَرِ،</para>
  <para style="q" vid="ISA 62:6">نَشٍيٍ لُمَ عَلَ مَشَندِ رَ وٌ بّ يَنيِ نُن كْي رَ.</para>
  <para style="q" vid="ISA 62:6">وٌ تَن نَشٍيٍ عَلَتَلَ شِلِمَ،</para>
  <para style="q" vid="ISA 62:6">وٌ نَشَ تَفَن نَ رَبَ رَ،<verse eid="ISA 62:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 62:7"/>وٌ نَشَ وٌ سَبَرِ</para>
  <para style="q" vid="ISA 62:7">هَن عَ شَ دَرِ سَلَمُ رَ سَبَتِ،</para>
  <para style="q" vid="ISA 62:7">عَ قَ قِندِ تَنتُي رَ دُنِحَ بِرِن مَ.»<verse eid="ISA 62:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="ISA 62:8"/>عَلَتَلَ عَ كَلِشِ نّ عَ سّنبّ رَ،</para>
  <para style="q" vid="ISA 62:8">«ﭑ مُ عِ شَ دٌنسٍ سَمَ عِ يَشُييٍ بّلّشّ سْنْن،</para>
  <para style="q" vid="ISA 62:8">عٍ مُ وٌ شَ وّنِ نّينّ مِنمَ</para>
  <para style="q" vid="ISA 62:8">وٌ نَشَن نَوَلِشِ.<verse eid="ISA 62:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 62:9"/>نَشٍيٍ شّ سَمَ، نٍيٍ نَن عَ دٌنمَ تَنتُي رَ عَلَتَلَ بّ.</para>
  <para style="q" vid="ISA 62:9">نَشٍيٍ وّنِ بٌفِ بُندُ مَ، نٍيٍ نَن عَ مِنمَ ﭑ مَ هْرْ مْبَنشِ بُنتُنيِ رَ.»<verse eid="ISA 62:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="ISA 62:10"/>«وٌ مِنِ تَا كُي نَادّيٍ رَ،</para>
  <para style="q" vid="ISA 62:10">وٌ سَ ﭑ مَ حَمَ شَ كِرَ رَقَلَ!</para>
  <para style="q" vid="ISA 62:10">وٌ عَ يَءِلَن، وٌ فّمّيٍ بَ كِرَيٍ رَ!</para>
  <para style="q" vid="ISA 62:10">وٌ شَ تْنشُمَ تِ سِيٍ بّ.<verse eid="ISA 62:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 62:11"/>عَلَتَلَ شَ مَسٍنيِ نَن يِ كِ دُنِحَ بّ،</para>
  <para style="q" vid="ISA 62:11">‹وٌ عَ قَلَ سِيٌنِكَيٍ بّ،</para>
  <para style="q" vid="ISA 62:11">وٌ رَكِسِمَ نَ قَقٍ.</para>
  <para style="q" vid="ISA 62:11">عَ قَمَ وٌ سَرٍ رَ.›<verse eid="ISA 62:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 62:12"/>عٍ شِلِ قَلَمَ نّ ‹حَمَ سّنِيّنشِ،›</para>
  <para style="q" vid="ISA 62:12">عَلَتَلَ نَشَن شُن سَرَشِ.</para>
  <para style="q" vid="ISA 62:12">وٌ شِلِ قَلَمَ نّ ‹حَمَ قٍنشِ،› ‹حَمَ نَشَن مُ رَبٌلٌشِ.›»<verse eid="ISA 62:12"/></para>
  <chapter eid="ISA 62"/>
  <chapter number="63" style="c" sid="ISA 63"/>
  <para style="s">فبٍحْشْي لْشْي</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 63:1"/>ندٍ نَ قَقٍ كٍلِقٍ عٍدٌن بْشِ مَ،</para>
  <para style="q" vid="ISA 63:1">دُفِ فبٍيلِ رَفٌرٌشِ نَشَن مَ،</para>
  <para style="q" vid="ISA 63:1">دُفِ نَشَن يَءِلَنشِ بٌسَرَ تَا كُي؟</para>
  <para style="q" vid="ISA 63:1">عَ سّنبّ فبٌ، عَ تٌقَن.</para>
  <para style="q" vid="ISA 63:1">عَ قَ عَ قَلَ، «ﭑ شَ عَ قَلَ وٌ بّ نْندِ كِ مَ،</para>
  <para style="q" vid="ISA 63:1">ﭑ قَشِ وٌ رَكِسِدٍ نّ!»<verse eid="ISA 63:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="ISA 63:2"/>«مُنقٍ رَ عِ شَ دُفِ فبٍيلِشِ عَلْ مِشِ نَشَن وّنِ بٌفِ بُندُ مَ؟»<verse eid="ISA 63:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 63:3"/>«ﭑ تَن كٍرٍن بَرَ وَلِ عَلْ مِشِ نَشَن وّنِ بُندُ مَ.</para>
  <para style="q" vid="ISA 63:3">سِ يٌ مُ ﭑ مَلِشِ نَ وَلِ كُي.</para>
  <para style="q" vid="ISA 63:3">ﭑ بَرَ عٍ بٌرٌن ﭑ مَ شْنّ كُي،</para>
  <para style="q" vid="ISA 63:3">عٍ وُلِ قَ كَسَن ﭑ مَ دُفِ مَ هَن عَ فبٍيلِ سٌي.<verse eid="ISA 63:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 63:4"/>ﭑ بْحّ نُ وَ مَ فبٍ حْشْي نَن شْن.</para>
  <para style="q" vid="ISA 63:4">شُنسَرٍ تّمُي بَرَ عَ لِ.<verse eid="ISA 63:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 63:5"/>ﭑ مُ مِشِ تٌ نَشَن ﭑ مَلِمَ،</para>
  <para style="q" vid="ISA 63:5">نَ كُي ﭑ بَرَ كِسِ وَلِ سُشُ ﭑ يّتّ رَ،</para>
  <para style="q" vid="ISA 63:5">ﭑ مَ شْنّ قَ ﭑ تُتُن يَرٍ.<verse eid="ISA 63:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 63:6"/>ﭑ بَرَ سِيٍ بٌرٌن ﭑ مَ شْنّ كُي،</para>
  <para style="q" vid="ISA 63:6">عٍ قَ لُ عَلْ سِيسِلَيٍ، عٍ وُلِ لُ بْشِ مَ.»<verse eid="ISA 63:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="ISA 63:7"/>ﭑ عَلَتَلَ شَ هِننّ قٍ قَلَمَ نّ وٌ بّ.</para>
  <para style="q" vid="ISA 63:7">وٌن شَ عَ تَنتُ عَ شَ قٍ رَبَشِيٍ شَ قٍ رَ،</para>
  <para style="q" vid="ISA 63:7">عَ نَشَن نَبَشِ وٌن بّ.</para>
  <para style="q" vid="ISA 63:7">عَ بَرَ قٍ قَنيِ وُيَشِ رَبَ عِسِرَيِلَ بْنسْي بّ،</para>
  <para style="q" vid="ISA 63:7">عَ شَ هِننّ نُن كِنِكِنِ سَابُي رَ.<verse eid="ISA 63:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 63:8"/>عَ عَ قَلَ نّ، «ﭑ لَشِ عَ رَ ﭑ مَ حَمَ نَن يِ كِ،</para>
  <para style="q" vid="ISA 63:8">مَءِقُيَ مُ نَ نَشٍيٍ يَ مَ!»</para>
  <para style="q" vid="ISA 63:8">نَ كُي عَ نَشَ قِندِ عٍ رَكِسِمَ رَ.<verse eid="ISA 63:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 63:9"/>عٍ شَ تْورّ شَ قٍ نُ عَ تْورْ مَ،</para>
  <para style="q" vid="ISA 63:9">كْنْ عَ قَقٍ بَرَ قِندِ عٍ شُنسَرٍ رَ.</para>
  <para style="q" vid="ISA 63:9">عَ بَرَ عٍ تٌنفٌ،</para>
  <para style="q" vid="ISA 63:9">عَ عٍ شَنِن عَ شَ شَنُنتٍيَ نُن كِنِكِنِ كُي كَبِ تّمُي شْن كُيٍ.<verse eid="ISA 63:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 63:10"/>كْنْ عٍ نَشَ مُرُتَ عَ مَ،</para>
  <para style="q" vid="ISA 63:10">عٍ قَ عَ شَشِلِ سّنِيّنشِ تْورْ.</para>
  <para style="q" vid="ISA 63:10">نَ كُي عَ نَشَ عٍ بّحِن،</para>
  <para style="q" vid="ISA 63:10">عَ قِندِ عٍ يَشُي رَ عٍ فٍرٍقَ.<verse eid="ISA 63:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="ISA 63:11"/>حَمَ بَرَ عَ مَحْشُن قٍ سِنفٍيٍ مَ،</para>
  <para style="q" vid="ISA 63:11">نَشَن نَبَشِ عَننَبِ مُنسَ شَ وَشَتِ.</para>
  <para style="q" vid="ISA 63:11">عٍ بَرَ عٍ يّتّ مَشْرِن،</para>
  <para style="q" vid="ISA 63:11">«عَلَ نَشَن عِسِرَيِلَكَيٍ رَفِرِ شُلُنيُمِ بَا مَ،</para>
  <para style="q" vid="ISA 63:11">نَ نَ مِندٍن؟</para>
  <para style="q" vid="ISA 63:11">عَلَ نَشَن عَ شَ حَمَ تٌنفٌ عَلْ شُرُ سٍ دّ مَدٌنيِ،</para>
  <para style="q" vid="ISA 63:11">نَ نَ مِندٍن؟</para>
  <para style="q" vid="ISA 63:11">عَلَ نَشَن عَ شَشِلِ سّنِيّنشِ رَفٌرٌ عَ شَ حَمَ مَ،</para>
  <para style="q" vid="ISA 63:11">نَ نَ مِندٍن؟<verse eid="ISA 63:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 63:12"/>عَلَ نَشَن مُنسَ مَلِ عَ سّنبّ كَرَلَنكٍ رَ،</para>
  <para style="q" vid="ISA 63:12">نَشَن بَا عِبْو عٍ يَ رَ عٍ رَفِرِقٍ رَ،</para>
  <para style="q" vid="ISA 63:12">عَلَكٌ عَ شِلِ شَ بِنيَ عَبَدَن،<verse eid="ISA 63:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 63:13"/>نَ نَ مِندٍن؟»</para>
  <para style="q" vid="ISA 63:13">نَ كُي عٍ مُ بِرَ.</para>
  <para style="q" vid="ISA 63:13">عٍ سّنبّ نُ فبٌ عَلْ سٌي نَشَن عَ فِمَ.<verse eid="ISA 63:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 63:14"/>عَلَتَلَ شَشِلِ نُ مَلَبُي قِمَ عٍ مَ،</para>
  <para style="q" vid="ISA 63:14">عٍ قَ لُ عَلْ نِنفٍ نَشَن حٌوفٍ دٌنمَ قِيلِ مَ.</para>
  <para style="q" vid="ISA 63:14">عِ بَرَ عِ شَ حَمَ رَحّرّ نَ كِ.</para>
  <para style="q" vid="ISA 63:14">عِ بَرَ شِلِ قَنيِ سْتْ نَ مَ.<verse eid="ISA 63:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="ISA 63:15"/>عِ شَ عِ يَ رَفٌرٌ كٍلِ كٌورٍ مَ،</para>
  <para style="q" vid="ISA 63:15">كٍلِقٍ عِ شَ كِبَنيِ سّنِيّنشِ كُي،</para>
  <para style="q" vid="ISA 63:15">نَشَن عِتٍشِ، نَشَن لُمَ نْرّ كُي،</para>
  <para style="q" vid="ISA 63:15">عِ قَ عَ مَتٌ عِ شَ شَنُنتٍيَ نُن سّنبّ نَ عٍ يّتّ مَسٍنقٍ دِ؟</para>
  <para style="q" vid="ISA 63:15">عِ شَ هِننّ نُن كِنِكِنِ مَكُيَ مُشُ رَ.<verse eid="ISA 63:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 63:16"/>كْنْ هَلِ عِبُرَهِمَ نُن عِسِرَيِلَ نّيمُ مُشُ مَ،</para>
  <para style="q" vid="ISA 63:16">عِ تَن نَن نَ مُشُ بَبَ رَ.</para>
  <para style="q" vid="ISA 63:16">عَلَتَلَ نَن مُشُ بَبَ رَ،</para>
  <para style="q" vid="ISA 63:16">مُشُ شُنسَرَ مَ كَبِ تّمُي شْنكُيٍ.<verse eid="ISA 63:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="ISA 63:17"/>مُنقٍ رَ عِ عَ نِيَمَ، مُشُ شَ عِ شَ كِرَ رَبّحِن؟</para>
  <para style="q" vid="ISA 63:17">مُنقٍ رَ عِ مُشُ بْحّ شْرْشْمَ هَن مُشُ شَ سُسَ عِ رَ؟</para>
  <para style="q" vid="ISA 63:17">مُشُ مَرِفِ، عِ شَ مُشُ رَفبِلٍن عِ شَ يَرَفَاشُي كُي.<verse eid="ISA 63:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 63:18"/>عِ شَ هْرْ مْبَنشِ نُ نَ مُشُ بّلّشّ،</para>
  <para style="q" vid="ISA 63:18">كْنْ يَكْسِ مُشُ يَشُييٍ بَرَ مّننِ بٌرٌن.<verse eid="ISA 63:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 63:19"/>عِ فبٍ نَن مُشُ رَ كَبِ تّمُي شْنكُيٍ،</para>
  <para style="q" vid="ISA 63:19">كْنْ عٍ تَن مُ تِنشِ عِ شَ يَامَرِ رَ،</para>
  <para style="q" vid="ISA 63:19">عٍ مُ عِ شِلِ قَلَمَ.</para>
  <para style="b" vid="ISA 63:19"/>
  <para style="q" vid="ISA 63:19">شَ عِ سَ كٌورٍ رَبِ نّ نُ فٌرٌقٍ رَ دُنِحَ،</para>
  <para style="q" vid="ISA 63:19">فٍيَيٍ سّرّنمَ نّ عِ يَ رَ نُ.<verse eid="ISA 63:19"/></para>
  <chapter eid="ISA 63"/>
  <chapter number="64" style="c" sid="ISA 64"/>
  <para style="s">عِسِرَيِلَ شَ مَشْرِنيِ</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 64:1"/>دُنِحَ رَكٌلٌن عِ شِلِ سّنبّمَ رَ،</para>
  <para style="q" vid="ISA 64:1">عَلَكٌ سِيٍ شَ سّرّن فَاشُي كُي عِ يَ رَ.</para>
  <para style="q" vid="ISA 64:1">عَ شَ لُ عَلْ يٍفٍ نَشَن دّشّمَ،</para>
  <para style="q" vid="ISA 64:1">عَ قَ يٍ سَتُن عَ شْرْشْي رَ.<verse eid="ISA 64:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 64:2"/>عِ بَرَ كَابَنَكٌي رَبَ نَشٍيٍ بَرَ مُشُ تّرّننَ،</para>
  <para style="q" vid="ISA 64:2">عِ بَرَ فٌرٌ، فٍيَيٍ قَ سّرّن عِ يَ رَ.<verse eid="ISA 64:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 64:3"/>يِ قٍ مْولِ مُ كٌلٌنشِ سِندٍن.</para>
  <para style="q" vid="ISA 64:3">عِ كٍرٍن نَن بَرَ نَ قٍ مْولِ كٌلٌن،</para>
  <para style="q" vid="ISA 64:3">عِ تَن نَشَن مِشِ مَلِمَ نَشٍيٍ لَشِ عِ رَ.<verse eid="ISA 64:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 64:4"/>عِ قَ نّ مِشِ مَلِدٍ نَشٍيٍ تِنمَ تِنشِنيِ رَ،</para>
  <para style="q" vid="ISA 64:4">نَشٍيٍ وَ مَ بِرَقٍ عِ شَ كِرَ قْشْ رَ.</para>
  <para style="b" vid="ISA 64:4"/>
  <para style="q" vid="ISA 64:4">كْنْ مُشُ تَن بَرَ يُنُبِ رَبَ،</para>
  <para style="q" vid="ISA 64:4">عِ قَ شْنْ مُشُ مَ.</para>
  <para style="q" vid="ISA 64:4">مُشُ نْمَ كِسِدٍ سْنْن؟<verse eid="ISA 64:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 64:5"/>مُشُ بِرِن بَرَ قِندِ مِشِ سّنِيّنتَرٍ رَ.</para>
  <para style="q" vid="ISA 64:5">مُشُ نَشَن نَبَمَ عِ بّ عَ نْشْشِ عَلْ دُنكٌبِ.</para>
  <para style="q" vid="ISA 64:5">مُشُ شَ قٍ لُشِ نّ عَلْ بُرّشّ لِسِشِ.</para>
  <para style="q" vid="ISA 64:5">مُشُ شَ يُنُبِيٍ نَ مُشُ شَنِنقٍ عَلْ قٌيٍ بُرّشّ شَنِنمَ كِ نَشّ.<verse eid="ISA 64:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 64:6"/>كْنْ مِشِ يٌ مُ نَ مُشُ يَ مَ نَشَن عِ شِلِمَ،</para>
  <para style="q" vid="ISA 64:6">عٍ مُ عِ شَ قٍ سُشُمَ،</para>
  <para style="q" vid="ISA 64:6">بَرِ مَ عِ بَرَ عِ يّتّ مَكُيَ مُشُ رَ،</para>
  <para style="q" vid="ISA 64:6">عِ بَرَ مُشُ تْورْ مُشُ شَ يُنُبِ شَ قٍ رَ.<verse eid="ISA 64:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="ISA 64:7"/>كْنْ يَكْسِ، مُشُ مَرِفِ، مُشُ بَبَ،</para>
  <para style="q" vid="ISA 64:7">مُشُ بَرَ لُ عَلْ بّندّ دٌلٌشِ عِ يِ رَ،</para>
  <para style="q" vid="ISA 64:7">عِ نَشَن نَوَلِمَ عَ شَ قِندِ قّحّ تٌقَنيِ رَ.</para>
  <para style="q" vid="ISA 64:7">مُشُ تَن نَن عِ بّلّشّ وَلِ قْشِ مَسٍنمَ.<verse eid="ISA 64:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 64:8"/>عِ نَشَ شْنْ مُشُ مَ مَرِفِ.</para>
  <para style="q" vid="ISA 64:8">عِ نَشَ رَتُ مُشُ شَ يُنُبِيٍ مَ.</para>
  <para style="q" vid="ISA 64:8">عِ يَ تِ مُشُ رَ، عِ شَ حَمَ.<verse eid="ISA 64:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 64:9"/>عِ شَ تَا سّنِيّنشِيٍ بَرَ قِندِ فبٍنفبٍرٍن يِرٍ رَ،</para>
  <para style="q" vid="ISA 64:9">سِيٌنِ بَرَ قِندِ يِرٍ مَشَرَشِ رَ،</para>
  <para style="q" vid="ISA 64:9">دَرِ سَلَمُ بَرَ كَنَ،<verse eid="ISA 64:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 64:10"/>عِ شَ هْرْ مْبَنشِ مُشُ نُ سّيوَشِ نَشَن نَ،</para>
  <para style="q" vid="ISA 64:10">نَ بَرَ فَن.</para>
  <para style="q" vid="ISA 64:10">مُشُ هَرِفٍ قَنيِ بِرِن بَرَ كَنَ.<verse eid="ISA 64:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 64:11"/>نَ بِرِن كُي، عِ تٌندِشِ مُشُ مَلِدٍ؟</para>
  <para style="q" vid="ISA 64:11">عِ عِ سَبَرِ مَ هَن مُن تّمُي؟</para>
  <para style="q" vid="ISA 64:11">عِ مُشُ حَشَنكَتَمَ نَن تُي؟<verse eid="ISA 64:11"/></para>
  <chapter eid="ISA 64"/>
  <chapter number="65" style="c" sid="ISA 65"/>
  <para style="s">كِيتِ نُن كِسِ</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 65:1"/>«ﭑ بَرَ ﭑ يّتّ مَسٍن مِشِيٍ بٍ نَشٍيٍ مُ نُ ﭑ شِلِشِ،</para>
  <para style="q" vid="ISA 65:1">مِشِيٍ بَرَ ﭑ تٌ نَشٍيٍ مُ نُ ﭑ قٍنمَ.</para>
  <para style="q" vid="ISA 65:1">ﭑ بَرَ عَ قَلَ، ‹ﭑ تَن نَن يَ،›</para>
  <para style="q" vid="ISA 65:1">سِ ندٍ بّ نَشَن مُ نُ شِلِمَ.<verse eid="ISA 65:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 65:2"/>ﭑ نَ ﭑ بّلّشّ تِ نّ لْشْي بِرِن حَمَ تُلِ شْرْشْشِ بّ،</para>
  <para style="q" vid="ISA 65:2">نَشَن حّرّ مَ كِرَ حَاشِ شْن عٍ يّتّ وَشْنيِ قٍنقٍ رَ.<verse eid="ISA 65:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 65:3"/>نَ حَمَ كَتَمَ تّمُي بِرِن ﭑ نَشْنْقٍ رَ.</para>
  <para style="q" vid="ISA 65:3">عٍ سّرّشّيٍ بَمَ سَنسِ يِرٍ،</para>
  <para style="q" vid="ISA 65:3">عٍ سُرَيِ قَن فَن سّرّشّ رَ عٍ شَ عَلَيٍ بّ.<verse eid="ISA 65:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 65:4"/>عٍ دْشْمَ فَبُرِ سّيتِ مَ كْي رَ،</para>
  <para style="q" vid="ISA 65:4">عٍ شْسّ سُبٍ دٌن، عَ نُن سٍ سّنِيّنتَرٍ فبّتّيٍ.<verse eid="ISA 65:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ISA 65:5"/>عٍ عَ قَلَمَ مِشِيٍ بّ، ‹وٌ نَشَ وٌ مَسٌ ﭑ نَ دٍ،</para>
  <para style="q" vid="ISA 65:5">بَرِ مَ ﭑ سّنِيّنشِ دَنفِقٍ وٌ رَ.›</para>
  <para style="q" vid="ISA 65:5">نَ مِشِ مْولِ شَ قٍ شْرْشْ</para>
  <para style="q" vid="ISA 65:5">عَلْ تُورِ نَشَن تٍمَ تّ يِرٍ، عَ سِفَ مِشِ مَ.»<verse eid="ISA 65:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="ISA 65:6"/>«يِ نَن سّبّشِ ﭑ يَ عِ،</para>
  <para style="q" vid="ISA 65:6">ﭑ مُ دُندُ مَ نَ مَ قٍوٌ.</para>
  <para style="q" vid="ISA 65:6">ﭑ نَ سَرٍ بِرِن قِمَ نّ عٍ مَ.<verse eid="ISA 65:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="ISA 65:7"/>ﭑ تَن وٌ مَرِفِ نَشّ،</para>
  <para style="q" vid="ISA 65:7">‹ﭑ وٌ شَ يُنُبِ سَرٍ قِمَ نّ،</para>
  <para style="q" vid="ISA 65:7">وٌ تَن نُن وٌ بٍنبَيٍ مَ،</para>
  <para style="q" vid="ISA 65:7">بَرِ مَ وٌ نُ سّرّشّيٍ بَمَ فٍيَيٍ نَن قَرِ،</para>
  <para style="q" vid="ISA 65:7">وٌ نُ قٍ حَاشِ رَبَ ﭑ نَ مّننِ.</para>
  <para style="q" vid="ISA 65:7">نَ كُي ﭑ وٌ شَ يُنُبِ سَرٍ قِمَ نّ وٌ مَ،</para>
  <para style="q" vid="ISA 65:7">وٌ شَ قٍ حَاشِيٍ شَ قٍ رَ.›»<verse eid="ISA 65:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="ISA 65:8"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ،</para>
  <para style="q" vid="ISA 65:8">«مِشِ نَ بٌفِ ندٍ بُندُقٍ تّمُي نَشّ،</para>
  <para style="q" vid="ISA 65:8">عٍ قَ وَ نَ بٌفِ وْلّقٍ،</para>
  <para style="q" vid="ISA 65:8">مِشِ فبّتّ عَ قَلَمَ نّ عٍ بّ،</para>
  <para style="q" vid="ISA 65:8">‹عِ نَشَ نَ وْلّ. يٍ ندٍ مَن لُشِ عَ كُي.›</para>
  <para style="q" vid="ISA 65:8">ﭑ قَن نَ مْولِ رَبَمَ نّ ﭑ قْشِرَبِرّيٍ رَ.</para>
  <para style="q" vid="ISA 65:8">ﭑ مُ عٍ بِرِن حَشَنكَتَمَ.<verse eid="ISA 65:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 65:9"/>ﭑ يَشُبَ شَ دِ ندٍيٍ رَكٍلِمَ نّ،</para>
  <para style="q" vid="ISA 65:9">ﭑ يُدَ شَ دِ ندٍيٍ كِ ﭑ مَ فٍيَيٍ رَ.</para>
  <para style="q" vid="ISA 65:9">ﭑ نَ ﭑ مَ فٍيَيٍ قِمَ نّ ﭑ مَ حَمَ سُفَندِشِ مَ،</para>
  <para style="q" vid="ISA 65:9">عٍ شَ سَبَتِ نَا، عَ قَ قِندِ عٍ كّ رَ.<verse eid="ISA 65:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 65:10"/>سَرْن قِيلِ قِمَ نّ عٍ مَ عٍ شُرُ سٍيٍ مَدٌنمَ دّننَشّ،</para>
  <para style="q" vid="ISA 65:10">عَكٌرِ فُلُنبَ قِندِ مَ مَلَبُدٍ نَن نَ عٍ شَ فْورّ بٍ.</para>
  <para style="q" vid="ISA 65:10">ﭑ نَ بِرِن نَبَمَ نّ ﭑ مَ حَمَ بّ نَشَن ﭑ قٍنمَ.»<verse eid="ISA 65:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="ISA 65:11"/>«كْنْ وٌ تَن نَشٍيٍ وٌ كٌبٍ سٌشِ ﭑ تَن عَلَتَلَ رَ،</para>
  <para style="q" vid="ISA 65:11">وٌ قَ نّيمُ ﭑ مَ فٍيَ سّنِيّنشِ مَ،</para>
  <para style="q" vid="ISA 65:11">وٌ قَ سّرّشّ بَ وٌ شَ عَلَيٍ بّ،</para>
  <para style="q" vid="ISA 65:11">نَشَن شِلِمَ فَدِ ‹شُننَقَنيِ كَنيِ›</para>
  <para style="q" vid="ISA 65:11">شَ نَ مُ عَ رَ، نَشَن شِلِمَ مٍنِ ‹مَرَفِرِ كَنيِ،›<verse eid="ISA 65:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 65:12"/>ﭑ بَرَ نَتّ تٌنفٌ وٌ تَن حَشَنكَتَمَ سَنتِدّفّمَ نَن نَ،</para>
  <para style="q" vid="ISA 65:12">وٌ بِرِن قَ قَشَ.</para>
  <para style="q" vid="ISA 65:12">ﭑ بَرَ وٌ شِلِ، كْنْ وٌ مُ قَ.</para>
  <para style="q" vid="ISA 65:12">ﭑ بَرَ وْيّن، كْنْ وٌ مُ وٌ تُلِ مَتِ.</para>
  <para style="q" vid="ISA 65:12">وٌ بَرَ قٍ حَاشِ رَبَ نَشَن مُ رَقَن ﭑ مَ قٍوٌ.»<verse eid="ISA 65:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="ISA 65:13"/>نَ كُي وٌ مَرِفِ عَلَ يِ نَن قَلَ،</para>
  <para style="q" vid="ISA 65:13">«ﭑ مَ كٌنيِيٍ عٍ دّفٍمَ نّ،</para>
  <para style="q" vid="ISA 65:13">كْنْ ﭑ وٌ تَن لُمَ كَامّ نَن كُي.</para>
  <para style="q" vid="ISA 65:13">ﭑ مَ كٌنيِيٍ عٍ مِنمَ،</para>
  <para style="q" vid="ISA 65:13">كْنْ يٍ شْلِ لُمَ نّ وٌ تَن مَ.</para>
  <para style="q" vid="ISA 65:13">ﭑ مَ كٌنيِيٍ سّيوَ مَ نّ،</para>
  <para style="q" vid="ISA 65:13">كْنْ يَافِ دُ سُمَ نّ وٌ تَن شُن نَ.<verse eid="ISA 65:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="ISA 65:14"/>ﭑ مَ كٌنيِيٍ بّيتِ بَمَ سّيوّ نَن كُي،</para>
  <para style="q" vid="ISA 65:14">كْنْ وٌ تَن وَ مَ نّ تْورّ كُي، وٌ بْحّ قَ رَحَاشُ وٌ مَ.<verse eid="ISA 65:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 65:15"/>وٌ شِلِ قِندِ مَ نّ دَنكّ رَ ﭑ مَ حَمَ تَفِ.</para>
  <para style="q" vid="ISA 65:15">عَلَتَلَ سّنبّمَ وٌ قَشَمَ نّ،</para>
  <para style="q" vid="ISA 65:15">كْنْ عَ شِلِ نّينّ قِمَ نّ عَ شَ كٌنيِيٍ مَ.<verse eid="ISA 65:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 65:16"/>مِشِ نَشَن دُبّ رَبَمَ يِ بْشِ مَ،</para>
  <para style="q" vid="ISA 65:16">عَ نَ رَبَمَ نْندِ نَن كُي عَلَ شِلِ رَ.</para>
  <para style="q" vid="ISA 65:16">مِشِ نَشَن كَلِ تِمَ يِ بْشِ مَ،</para>
  <para style="q" vid="ISA 65:16">عَ نَ رَبَمَ نْندِ نَن كُي عَلَ شِلِ رَ.</para>
  <para style="q" vid="ISA 65:16">تْورّ دَنفِشِ نّيمُمَ نّ ﭑ نَ، عَ بَ ﭑ يَ عِ.»<verse eid="ISA 65:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="ISA 65:17"/>«وٌ شَ عَ كٌلٌن ﭑ قَمَ نّ كٌورٍ نُن بْشِ نّينّ دَادٍ.</para>
  <para style="q" vid="ISA 65:17">مِشِ مُ رَتُمَ قٍ قٌرِيٍ مَ سْنْن.<verse eid="ISA 65:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="ISA 65:18"/>كْنْ ﭑ مَ دَالِ، وٌ شَ سّيوَ عَبَدَن،</para>
  <para style="q" vid="ISA 65:18">بَرِ مَ ﭑ دَرِ سَلَمُ دَامَ نّ عَ شَ وٌ رَ سّيوَ هَن.<verse eid="ISA 65:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="ISA 65:19"/>ﭑ سّيوَ مَ نّ دَرِ سَلَمُ تَفِ،</para>
  <para style="q" vid="ISA 65:19">ﭑ قٍ قَنيِ رَبَ ﭑ مَ مِشِيٍ بّ،</para>
  <para style="q" vid="ISA 65:19">وَ شُي مُ مّمَ سْنْن.<verse eid="ISA 65:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="ISA 65:20"/>دِ يٌ مُ قَشَمَ عَ يْرّ رَ سْنْن،</para>
  <para style="q" vid="ISA 65:20">مِشِ مْشِ يٌ قَن مُ قَشَمَ قٌ عَ شَ سِمَيَ كَمَلِ.</para>
  <para style="q" vid="ISA 65:20">مِشِ نَشَن حّ كّمّ سِمَيَ سْتْمَ، عَ قَ قَشَ،</para>
  <para style="q" vid="ISA 65:20">عَ لُمَ نّ عَلْ عَ نَ قَشَ عَ دِ مّدِ تّمُي، عَ قِندِ مِشِ دَنكَشِ رَ.<verse eid="ISA 65:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="ISA 65:21"/>عٍ بَنشِيٍ تِمَ نّ، عٍ سَبَتِ عٍ كُي.</para>
  <para style="q" vid="ISA 65:21">عٍ وُرِ بِلِيٍ سِمَ نّ، عٍ عٍ بٌفِ دٌن.<verse eid="ISA 65:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="ISA 65:22"/>عٍ مُ بَنشِيٍ تِمَ سْنْن، مِشِ فبّتّيٍ قَ سَبَتِ نٍيٍ كُي.</para>
  <para style="q" vid="ISA 65:22">عٍ مُ سَنسِ سِمَ سْنْن، مِشِ فبّتّيٍ قَ نَ بٌفِ دٌن.</para>
  <para style="q" vid="ISA 65:22">ﭑ مَ حَمَ بُمَ نّ، عَلْ وُرِ شُنفبٍيٍ.</para>
  <para style="q" vid="ISA 65:22">ﭑ مَ مِشِ سُفَندِشِيٍ سّيوَ مَ نّ عٍ شَ وَلِ رَ.<verse eid="ISA 65:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="ISA 65:23"/>عٍ مُ وَلِمَ قُ رَ، عٍ شَ دِيٍ مُ فبَلٌي سْتْمَ.</para>
  <para style="q" vid="ISA 65:23">عٍ قِندِ مَ عَلَ بْنسْي بَرَكَشِ نَن نَ،</para>
  <para style="q" vid="ISA 65:23">عٍ تَن نُن عٍ شَ دِيٍ لُمَ نَ كِ نّ عَبَدَن.<verse eid="ISA 65:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="ISA 65:24"/>بٍينُ عٍ شَ ﭑ مَشَندِ، عَ لِمَ نّ ﭑ حَن بَرَ عٍ شُي سُشُ.</para>
  <para style="q" vid="ISA 65:24">بٍينُ عٍ شَ فّ قٍ ندٍ قَلَدٍ، ﭑ حَن بَرَ نَ مّ.<verse eid="ISA 65:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="ISA 65:25"/>شُلُمَسٍ نُن سِ لُمَ نّ كُلّ كٍرٍن.</para>
  <para style="q" vid="ISA 65:25">يّتّ نُن نِنفٍ حٌوفٍ دٌنمَ نّ يِرٍ كٍرٍن.</para>
  <para style="q" vid="ISA 65:25">كْنْ بْشِمَسٍ لُمَ عَ بَلٌ رَ شُبُتَنيِ نَن نَ.</para>
  <para style="q" vid="ISA 65:25">عٍ مُ قٍ يٌ كَنَمَ ﭑ مَ فٍيَ سّنِيّنشِ قَرِ.»</para>
  <para style="q" vid="ISA 65:25">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="ISA 65:25"/></para>
  <chapter eid="ISA 65"/>
  <chapter number="66" style="c" sid="ISA 66"/>
  <para style="s">كِيتِ نُن كِسِ</para>
  <para style="q">
    <verse number="1" style="v" sid="ISA 66:1"/>مَرِفِ شَ مَسٍنيِ نَن يَ،</para>
  <para style="q" vid="ISA 66:1">«كٌورٍ نَن نَ ﭑ مَ كِبَنيِ رَ،</para>
  <para style="q" vid="ISA 66:1">دُنِحَ نَن نَ ﭑ سَن تِدٍ رَ.</para>
  <para style="q" vid="ISA 66:1">بَنشِ مْولِ مُندُن نْمَ تِدٍ ﭑ تَن بّ؟</para>
  <para style="q" vid="ISA 66:1">يِرٍ مُندُن نْمَ قِندِدٍ ﭑ مَلَبُدٍ رَ؟<verse eid="ISA 66:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ISA 66:2"/>ﭑ بّلّشّ نَن سٍيٍ بِرِن نَقَلَشِ نَشٍيٍ نَ دُنِحَ.»</para>
  <para style="q" vid="ISA 66:2">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.</para>
  <para style="b" vid="ISA 66:2"/>
  <para style="q" vid="ISA 66:2">«مِشِ نَشَن نَقَن ﭑ مَ،</para>
  <para style="q" vid="ISA 66:2">عَ قِندِشِ يّتّ مَفٌرٍ نَن نَ،</para>
  <para style="q" vid="ISA 66:2">عَ فَاشُ ﭑ يَ رَ، عَ ﭑ شُي سُشُ.<verse eid="ISA 66:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ISA 66:3"/>كْنْ مِشِ نَشَن نِنفٍ بَمَ سّرّشّ رَ فبَنسَن،</para>
  <para style="q" vid="ISA 66:3">نَ تَن لُمَ نّ عَلْ قَشّتِ.</para>
  <para style="q" vid="ISA 66:3">مِشِ نَشَن يّشّي بَمَ سّرّشّ رَ فبَنسَن،</para>
  <para style="q" vid="ISA 66:3">نَ تَن لُمَ نّ عَلْ مِشِ نَشَن بَرٍ كْنيِ فِرَ مَ.</para>
  <para style="q" vid="ISA 66:3">مِشِ نَشَن سَنسِ شْرِ بَمَ سّرّشّ رَ فبَنسَن،</para>
  <para style="q" vid="ISA 66:3">نَ تَن لُمَ نّ عَلْ مِشِ نَشَن شْسّ وُلِ بَمَ سّرّشّ رَ.</para>
  <para style="q" vid="ISA 66:3">مِشِ نَشَن سُرَيِ فَنمَ سّرّشّ رَ فبَنسَن،</para>
  <para style="q" vid="ISA 66:3">نَ تَن لُمَ نّ عَلْ كُيٍ بَتُي.</para>
  <para style="q" vid="ISA 66:3">عٍ بَرَ عٍ شَ كِرَ سُفَندِ،</para>
  <para style="q" vid="ISA 66:3">كِرَ نَشَن قِندِشِ سّنِيّنتَرٍحَ شْنشِ رَ.<verse eid="ISA 66:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ISA 66:4"/>نَ كُي ﭑ قَن عٍ حَشَنكَتَمَ نّ،</para>
  <para style="q" vid="ISA 66:4">ﭑ قٍ مَفَاشُشِ رَفٌرٌ مَ نّ عٍ مَ،</para>
  <para style="q" vid="ISA 66:4">بَرِ مَ ﭑ تٌ عٍ شِلِ، عٍ مُ ﭑ مَ شِلِ رَتِنشِ،</para>
  <para style="q" vid="ISA 66:4">ﭑ تٌ وْيّن، عٍ مُ عٍ تُلِ مَتِ ﭑ نَ.</para>
  <para style="q" vid="ISA 66:4">عٍ بَرَ قٍ حَاشِ رَبَ ﭑ يَ شْرِ،</para>
  <para style="q" vid="ISA 66:4">عٍ بَرَ كِرَ سُفَندِ، نَشَن مُ رَقَن ﭑ مَ.»<verse eid="ISA 66:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="ISA 66:5"/>وٌ شَ وٌ تُلِ مَتِ عَلَتَلَ شُي رَ،</para>
  <para style="q" vid="ISA 66:5">وٌ تَن نَشٍيٍ فَاشُشِ عَ يَ رَ،</para>
  <para style="q" vid="ISA 66:5">«وٌ نفَشَكٍرٍنيِ نَشٍيٍ وٌ شْنمَ،</para>
  <para style="q" vid="ISA 66:5">عٍ وٌ كٍرِ ﭑ شِلِ شَ قٍ رَ، عٍ نَشّ،</para>
  <para style="q" vid="ISA 66:5">‹وٌ شَ عَلَتَلَ تَنتُ عَلَكٌ مُشُ شَ وٌ شَ سّيوّ تٌ.›</para>
  <para style="q" vid="ISA 66:5">كْنْ عٍ قَمَ نّ يَافِدٍ.<verse eid="ISA 66:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ISA 66:6"/>وٌ بَرَ نَ سْنشْي مّ كٍلِقٍ تَا كُي،</para>
  <para style="q" vid="ISA 66:6">كٍلِقٍ عَلَ شَ هْرْ مْبَنشِ كُي؟</para>
  <para style="q" vid="ISA 66:6">عَلَتَلَ نَ عَ يَشُييٍ سَرٍ قِقٍ.</para>
  <para style="q" vid="ISA 66:6">نَ قِندِشِ نَ شُي نَن نَ وٌ نَشَن مّمَ.»<verse eid="ISA 66:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="ISA 66:7"/>بٍينُ دِ بَرِ شْنّ شَ عَ لِ،</para>
  <para style="q" vid="ISA 66:7">عَ حَن فّ دِ بَرِدٍ.</para>
  <para style="q" vid="ISA 66:7">بٍينُ تْورّ شَ قَ،</para>
  <para style="q" vid="ISA 66:7">عَ حَن بَرَ دِ شّمّ سْتْ.<verse eid="ISA 66:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ISA 66:8"/>ندٍ سِنفٍ بَرَ يِ قٍ مْولِ مّ؟</para>
  <para style="q" vid="ISA 66:8">ندٍ سِنفٍ بَرَ يِ قٍ مْولِ تٌ؟</para>
  <para style="q" vid="ISA 66:8">حَمَنّ نْمَ قِندِدٍ عَ رَ لْشْي كٍرٍن كُي؟</para>
  <para style="q" vid="ISA 66:8">بْنسْي نْمَ سّنبّ سْتْدٍ تّمُي كٍرٍن كُي؟</para>
  <para style="q" vid="ISA 66:8">كْنْ سِيٌنِ بَرَ قٌيٍ تٌ كٍرٍن نَ.<verse eid="ISA 66:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ISA 66:9"/>وٌ مَرِفِ عَلَتَلَ نَشّ،</para>
  <para style="q" vid="ISA 66:9">«ﭑ مِشِ مَلِمَ هَن عٍ دِ بَرِ تّمُي، ﭑ قَ عٍ رَبٌلٌ نَ كُي؟</para>
  <para style="q" vid="ISA 66:9">فِنّ قُرِ نَ مْ، ﭑ مُ قَمَ نَ دِ بَرِ سْونّيَدٍ شّ؟»<verse eid="ISA 66:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ISA 66:10"/>وٌ تَن دَرِ سَلَمُ رَقَن نَشٍيٍ مَ،</para>
  <para style="q" vid="ISA 66:10">وٌ شَ سّيوَ عَ شَ قٍ رَ.</para>
  <para style="q" vid="ISA 66:10">وٌ تَن نَشٍيٍ وَ مَ عَ بّ،</para>
  <para style="q" vid="ISA 66:10">وٌ شَ حّلّشِن عَ شَ قٍ رَ.<verse eid="ISA 66:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ISA 66:11"/>وٌ قَمَ نّ عَ شِحّ مِندٍ هَن وٌ لُفَ،</para>
  <para style="q" vid="ISA 66:11">وٌ بْحّسَ سْتْ عَ سَابُي رَ،</para>
  <para style="q" vid="ISA 66:11">عَ وٌ هَيِ بِرِن قَن.<verse eid="ISA 66:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="ISA 66:12"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ،</para>
  <para style="q" vid="ISA 66:12">«ﭑ بْحّسَ قِمَ نّ عَ مَ عَلْ شُرٍ شُنفبٍ،</para>
  <para style="q" vid="ISA 66:12">ﭑ حَمَنّ نَاقُلِ شَنِنمَ نّ عَ شْن مَ عَلْ بَنبَرَنيِ.</para>
  <para style="q" vid="ISA 66:12">عَ قَمَ نّ مّينِدٍ وٌ مَ عَلْ دِنفّ مّينِمَ عَ شَ دِ مَ كِ نَشّ.<verse eid="ISA 66:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="ISA 66:13"/>ﭑ وٌ شَ تْورّ بَمَ نّ وٌ مَ عَلْ دِنفّ عَ شَ دِ شَ تْورّ بَمَ كِ نَشّ.</para>
  <para style="q" vid="ISA 66:13">نَ بِرِن تٌمَ نّ دَرِ سَلَمُ.»<verse eid="ISA 66:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="ISA 66:14"/>وٌ نَ نَ تٌ، وٌ بْحّ سّيوَ مَ نّ،</para>
  <para style="q" vid="ISA 66:14">وٌ شَ قٍ سْونّيَ عَلْ حٌوفٍ نَشَن تٌمَ قِيلِ مَ.</para>
  <para style="q" vid="ISA 66:14">عَلَتَلَ عَ سّنبّ مَسٍنمَ نّ عَ شَ كٌنيِيٍ بّ،</para>
  <para style="q" vid="ISA 66:14">عَ يَشُي قَمَ نّ عَ شَ شْنّ كٌلٌندٍ.<verse eid="ISA 66:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="ISA 66:15"/>عَلَتَلَ نَن نَ كِ، عَ نَ قَقٍ تّ شْورَ،</para>
  <para style="q" vid="ISA 66:15">عَ حّرّ مَ قٌيٍ شُنفبٍ قَرِ.</para>
  <para style="q" vid="ISA 66:15">عَ عَ شَ شْنّ رَفٌرٌ مَ نّ سّنبّ رَ،</para>
  <para style="q" vid="ISA 66:15">عَ حَشَنكَتّ تِ تّ رَ.<verse eid="ISA 66:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="ISA 66:16"/>عَلَتَلَ عَ شَ كِيتِ سَمَ نّ تّ نُن سَنتِدّفّمَ رَ،</para>
  <para style="q" vid="ISA 66:16">عَ قَ مِشِ فبٍفبٍ سْنتْدٍ.<verse eid="ISA 66:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ISA 66:17"/>عَلَتَلَ نَشّ، «مِشِ نَشٍيٍ سّرّشّ بَمَ وٌندِ كُي، عٍ قَ شْسّ نُن بَلٍ سُبٍ دٌن، عَ نُن دٌنسٍ سّنِيّنتَرٍ فبّتّيٍ عَلَتَلَ نَشٍيٍ شْنشِ، عٍ شَ قٍ قَمَ نّ رَحْندٍ كٍرٍنيِ رَ.»<verse eid="ISA 66:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 66:18"/>«ﭑ قَمَ نّ سِ بِرِن مَلَندٍ، سِ نَشٍيٍ شُي وُيَشِ قَلَمَ، ﭑ قَ ﭑ مَ نْرّ مَسٍن عٍ بّ عٍ شَ قٍ رَبَشِيٍ نُن عٍ شَ مَحْشُنيِيٍ شَ قٍ رَ. <verse eid="ISA 66:18"/><verse number="19" style="v" sid="ISA 66:19"/>ﭑ تْنشُمَ ندٍ لُمَ نّ عٍ تَفِ، ﭑ قَ عٍ شَ مِشِ كِسِشِيٍ شّي بْنسْييٍ تَفِ، عَلْ تَرَ سِسِ، ثُلُ، لُدُ شَلِ وٌلِيٍ، تُبَلِ، يَوَنِ، نُن سِ فبّتّ نَشٍيٍ نَ يِرٍ مَكُيٍيٍ، نَشٍيٍ مُ ﭑ شِلِ كٌلٌن، نَشٍيٍ مُ ﭑ مَ نْرّ تٌشِ سِندٍن. ﭑ مَ شّيرَيٍ قَمَ نّ ﭑ مَ نْرّ مَسٍندٍ عٍ بّ. <verse eid="ISA 66:19"/><verse number="20" style="v" sid="ISA 66:20"/>عٍ مَن قَمَ نّ وٌ نفَشَكٍرٍنيِيٍ رَ نَشٍيٍ تٌمَ نَ حَمَنّيٍ تَفِ. عٍ قَمَ نّ عٍ رَ ﭑ مَ فٍيَ سّنِيّنشِ قَرِ عَلْ سّرّشّ قَمَ كِ نَشّ. عٍ قَمَ نّ عٍ رَ سٌييٍ نُن حْشْمّيٍ قَرِ، عٍ تِشِ سَرّتِيٍ كُي. عٍ قَمَ نّ نَ بِرِن نَ عَلْ عِسِرَيِلَكَيٍ قَمَ عٍ شَ هَدِيَيٍ رَ سٍسَسٍ سّنِيّنشِيٍ كُي كِ نَشّ عَلَتَلَ شَ هْرْ مْبَنشِ كُي. <verse eid="ISA 66:20"/><verse number="21" style="v" sid="ISA 66:21"/>ﭑ سّرّشّدُبّ ندٍيٍ سُفَندِ مَ نّ عٍ قَن يَ مَ، عٍ شَ لُ لٍوِ بْنسْي سّيتِ مَ.»<verse eid="ISA 66:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 66:22"/>«ﭑ تَن عَلَتَلَ، ﭑ شَ عَ قَلَ وٌ بّ، عَ ﭑ قَمَ نّ كٌورٍ نّينّ نُن بْشِ نّينّ يَءِلَندٍ وٌ بّ. نَ بُمَ كِ نَشّ، وٌ شِلِ نُن وٌ بْنسْي بُمَ نَ كِ نّ عَبَدَن. <verse eid="ISA 66:22"/><verse number="23" style="v" sid="ISA 66:23"/>كٍلِ كِكٍ نّينّ سّرّشّ مَ هَن كِكٍ نّينّ سّرّشّ فبّتّ، كٍلِ مَلَبُ لْشْي مَ هَن مَلَبُ لْشْي فبّتّ، عِبُنَدَ مَ بِرِن قَمَ نّ سُيِدِدٍ ﭑ يَ عِ. <verse eid="ISA 66:23"/><verse number="24" style="v" sid="ISA 66:24"/>عٍ مِشِ قَشَشِيٍ تٌمَ نّ نَشٍيٍ مُرُتَشِ ﭑ مَ. نِمَسٍيٍ عٍ قُرٍيٍ دٌنمَ نّ، تّ قَن عٍ سُبٍ فَن، عٍ قَ قِندِ قٍ مَفَاشُشِ رَ عَدَ مَدِيٍ بّ.»<verse eid="ISA 66:24"/></para>
  <chapter eid="ISA 66"/>
</usx>
