<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="DEU" style="id"/>
  <para style="h">مَسٍنيِ دْنشْي</para>
  <para style="toc1">عَننَبِ مُنسَ شَ مَسٍنيِ دْنشْي</para>
  <para style="toc2">مَسٍنيِ دْنشْي</para>
  <para style="toc3">دْن</para>
  <para style="mt">تَوُرٍتَ مُنسَ</para>
  <para style="mt">عَننَبِ مُنسَ شَ مَسٍنيِ دْنشْي</para>
  <para style="imt">مَسٍنيِ ندٍ يِ كِتَابُي شَ قٍ رَ</para>
  <para style="ip">عَلَ عَ شَ مَسٍنيِ سِنفٍيٍ قِشِ وٌن مَ عَننَبِ مُنسَ نَن سَابُي رَ. نَ مَسٍنيِ دْشْ سُولِيٍ قِندِشِ كِتَابُي كٍرٍن نَن نَ، نَشَن شِلِ قَلَمَ تَوُرٍتَ مُنسَ. عَ دْشْ سِنفٍ عَلَ شَ حَمَ قْلْ كِ نَن مَسٍنمَ. عَلَ تٌ عَننَبِ عِبُرَهِمَ سُفَندِ، عَ عَ شّي كَنَان بْشِ مَ، عَ شَ دِيٍ نَشَ قِندِ بْنسْي بٍلٍبٍلٍ رَ مّننِ. عَننَبِ يَشُبَ وَشَتِ، كَامّ نَشَ دِن بْشِ رَ عٍ نُ دّننَشّ. عَننَبِ يَشُبَ شَ دِيٍ نَشَ سِفَ مِسِرَ بْشِ مَ بَلٌي قٍندٍ. عَلَ نَشَ عَ رَفِرِ، عٍ شَ عٍ شُنيَ يُسُقُ لِ نَا. عَننَبِ يُسُقُ نَشَ عٍ مَلِ عَ قَنيِ رَ.</para>
  <para style="ip">عَلَ نَشَ نَ بْنسْي مَلِ هَن عٍ قِندِ سِ بٍلٍبٍلٍ رَ. حّ وُيَشِ تٌ دَنفِ، مِسِرَ مَنفّ نَشَ فَاشُ قْلْ عٍ يَ رَ. عَ نَشَ عٍ قِندِ كٌنيِيٍ رَ عَلَكٌ عٍ نَشَ نْ مِسِرَكَيٍ رَ. نَ كٌنيِيَ نَشَ بُ هَن عَلَ عَننَبِ مُنسَ شّي تّمُي نَشّ. عَلَ نَشَ عَ مَلِ شْرّيَ قِدٍ عَ شَ مِشِيٍ مَ. عٍ نَشَ مِنِ مِسِرَ بْشِ مَ عَلَ سّنبّ سَابُي رَ، نَشَن بَا بْتِنِ مَبَ عَلَكٌ عٍ شَ عَ عِفِرِ عٍ سَنيِ رَ.</para>
  <para style="ip">نَ كَابَنَكٌ بٍلٍبٍلٍ شَنبِ، عَلَ نَشَ عٍ شُن تِ كَنَان بْشِ رَ، عَ دّننَشّ قِ عٍ مَ. كِرَ رَ، عَلَ نَشَ مِنِ عٍ مَ تُرُ سِنِنَ فٍيَ قَرِ. عَ نَشَ عَ شَ يَامَرِ قُ قِ عَننَبِ مُنسَ مَ، عٍ سّبّشِ فّمّ وَلَشّ مَ. عَلَ مَن نَشَ سّرِيّ فبّتّ قَلَ عَننَبِ مُنسَ بّ عَلَكٌ حَمَ شَ لُ عٍ مَرِفِ سَفٌي. كْنْ حَمَ نَشَ عَلَتَلَ مَتَندِ سَنيَ وُيَشِ فبٍنفبٍرٍنيِ مَ. نَ تَرُشُي بِرِن سّبّشِ تَوُرٍتَ مُنسَ نَن كُي.</para>
  <para style="ip">بٍينُن عٍ شَ كَنَان بْشِ سْتْ، عَننَبِ مُنسَ نَشَ عٍ مَلَن يِرٍ كٍرٍن. مّننِ عَ نَشَ يِ تَرُشُي بِرِن مَدْشْ عٍ بّ. عَ مَن نَشَ فبِلٍن عَلَ شَ سّرِيّ بِرِن مَ عَلَكٌ عٍ نَشَ نّيمُ عَ مَ كَنَان. عَ تٌ فّ نَ بِرِن تَفِ رَبَ عٍ بّ، عٍ نَشَ لَايِدِ تٌنفٌ بِرَقٍ رَ عَلَ شَ سّرِيّ قْشْ رَ. نَ مَسٍنيِ دْشْ سُولِ ندٍ بِرِن شِلِ قَلَمَ، «عَننَبِ مُنسَ شَ مَسٍنيِ دْنشْي.» نَ دَنفِ شَنبِ، عَننَبِ مُنسَ نَشَ لَاشِرَيَ فٍيَ قَرِ.</para>
  <para style="ip">يِ كِتَابُي لْننِ قِمَ وٌن مَ عَلَكٌ وٌن شَ عَلَ شَ سّرِيّ كٌلٌن. عَلَ شَ وٌن مَلِ نَ كٌلٌنقٍ رَ. عَمِنَ.</para>
  <para style="imte">تَوُرٍتَ مُنسَ</para>
  <para style="imte">عَننَبِ مُنسَ شَ مَسٍنيِ دْنشْي</para>
  <chapter number="1" style="c" sid="DEU 1"/>
  <para style="s">عَننَبِ مُنسَ شَ مَسٍنيِ سِنفٍ</para>
  <para style="s">كٍلِقٍ شٌرٍبٍ فٍيَ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 1:1"/>وْيّنيِيٍ نَن يِ كِ، عَننَبِ مُنسَ نَشَن مَسٍن عِسِرَيِلَكَيٍ بِرِن بّ. نَ تّمُي عَ نُ نَ يُرُدّن سٌفٍتٍدٍ بِرِ رَ، فبٍنفبٍرٍنيِ مَ نَشَن نَ عَرَبَ، سُقِ يَ تَفِ، ثَرَن، تٌقٍلِ، لَبَن، شَسٍرٌتِ، نُن دِ سَهَبِ لٌنفٌرِ. <verse eid="DEU 1:1"/><verse number="2" style="v" sid="DEU 1:2"/>كٍلِ شٌرٍبٍ فٍيَ هَن كَدٍ سِ بَرِنٍيَ كِرَ رَ مِنِقٍ رَ سٍيِرِ فٍيَيٍ بِرِ، شِ قُ نُن كٍرٍن حّرّ نَ عَ رَ. <verse eid="DEU 1:2"/><verse number="3" style="v" sid="DEU 1:3"/>عٍ شَ كٍلِ حّ تٌنفٌ نَانِ ندٍ مَ مِسِرَ، عَ كِكٍ قُ نُن كٍرٍن ندٍ، شِ سِنفٍ، عَننَبِ مُنسَ نَشَ عَلَتَلَ شَ يَامَرِ مَسٍن عِسِرَيِلَكَيٍ بّ. <verse eid="DEU 1:3"/><verse number="4" style="v" sid="DEU 1:4"/>نَ تّمُي عَننَبِ مُنسَ نُ بَرَ شُتُ سْتْ سِشْن مَ، عَمٌرِ مَنفّ، نَشَن نُ سَبَتِشِ شّسِبْن، عَ نُن عٌفٌ، بَسَن مَنفّ، نَشَن نُ سَبَتِشِ عَسَتَرٌتِ نُن عٍدٍرٍيِ. <verse eid="DEU 1:4"/><verse number="5" style="v" sid="DEU 1:5"/>يُرُدّن سٌفٍتٍدٍ بِرِ مٌوَبَ بْشِ مَ، عَننَبِ مُنسَ نَشَ عَلَ شَ سّرِيّ تَفِ رَبَ عٍ بّ. نَ وْيّنيِ نَن يِ كِ.<verse eid="DEU 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="DEU 1:6"/>«وٌن نُ نَ شٌرٍبٍ فٍيَ يِرٍ تّمُي نَشّ، وٌن مَرِفِ عَلَتَلَ يِ نَن مَسٍن وٌن بّ، ‹وٌ بَرَ بُ يِ فٍيَ بُن مَ. <verse eid="DEU 1:6"/><verse number="7" style="v" sid="DEU 1:7"/>وٌ تِ كِرَ شْن مَ قَ. وٌ شَ سِفَ فٍيَ مَ عَمٌرِكَيٍ نَ دّننَشّ، نُن نَ لٌنفٌرِ بِرِن، عَرَبَ بْشِ مَ، فٍيَ بِرِ، سٍقٍلَ نُن نٍفٍوِ بِرِ، بَا دّ رَ، هَن كَنَان بْشِ مَ، هَن لِبَن سَ دْشْ عٍقِرَتِ شُرٍ بٍلٍبٍلٍ رَ. <verse eid="DEU 1:7"/><verse number="8" style="v" sid="DEU 1:8"/>وٌ شَ نَ بْشِ مَتٌ، ﭑ نَشَن قِشِ وٌ مَ. وٌ سِفَ، وٌ شَ نَ تٌنفٌ، بَرِ مَ ﭑ تَن عَلَتَلَ يَتِ نَن نَ بْشِ لَايِدِ تٌنفٌشِ وٌ بٍنبَيٍ بّ، عِبُرَهِمَ، عِسِيَفَ، عَ نُن يَشُبَ، عَ نُن عٍ بْنسْي بِرِن هَلِ عٍ دَنفِ شَنبِ.›»<verse eid="DEU 1:8"/></para>
  <para style="s">عَننَبِ مُنسَ شَ كِيتِسَيٍ</para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 1:9"/>«نَ تّمُي ﭑ يِ نَن قَلَ وٌ بّ، ‹ﭑ تَن كٍرٍن مُ نْمَ وٌ شَ قٍ نْدٍ. <verse eid="DEU 1:9"/><verse number="10" style="v" sid="DEU 1:10"/>وٌ مَرِفِ عَلَتَلَ بَرَ وٌ رَفبٌ يّ. يَكْسِ وٌ بَرَ فبٌ يّ عَلْ تُنبُييٍ نَشٍيٍ نَ كٌورٍ مَ. <verse eid="DEU 1:10"/><verse number="11" style="v" sid="DEU 1:11"/>وٌ بٍنبَيٍ مَرِفِ عَلَتَلَ شَ وٌ رَوُيَ هَن. عَ شَ بَرَكَ سَ وٌ شَ قٍ عَلْ عَ مَسٍن كِ نَشّ. <verse eid="DEU 1:11"/><verse number="12" style="v" sid="DEU 1:12"/>ﭑ تَن كٍرٍن نْمَ وٌ شَ كَلَمُييٍ مَكِيتِدٍ دِ؟ <verse eid="DEU 1:12"/><verse number="13" style="v" sid="DEU 1:13"/>وٌ كُنتِفِ لْننِلَيٍ سُفَندِ، نَشٍيٍ كٌلٌنشِ وٌ بْنسْييٍ يَ مَ. ﭑ نٍيٍ نَن قِندِ مَ حَمَ يَرٍرَتِيٍ رَ.› <verse eid="DEU 1:13"/><verse number="14" style="v" sid="DEU 1:14"/>وٌ نَشَ ﭑ يَابِ، عَ ﭑ مَ مَحْشُنيِ، عَ مَحْشُن قَنيِ نَ عَ رَ. <verse eid="DEU 1:14"/><verse number="15" style="v" sid="DEU 1:15"/>ﭑ نَشَ وٌ شَ يَرٍرَتِيٍ تٌنفٌ، وٌ شَ كُنتِفِ لْننِلَ نَشٍيٍ كٌلٌنشِ وٌ بْنسْي يَ مَ. ﭑ نَشَ عٍ قِندِ مِشِ وُلُ، مِشِ كّمّ، مِشِ تٌنفٌ سُولِ، مِشِ قُ شُنيِيٍ رَ. ﭑ نَشَ عٍ قِندِ يَرٍرَتِيٍ رَ وٌ بْنسْييٍ يَ مَ. <verse eid="DEU 1:15"/><verse number="16" style="v" sid="DEU 1:16"/>نَ تّمُي ﭑ نَشَ يَامَرِ سٌ وٌ مَكِيتِمَيٍ يِ رَ. ﭑ نَشّ، ‹وٌ شَ وٌ تُلِ مَتِ وٌ بَرِبٌورٍيٍ رَ. وٌ شَ بِرِن مَكِيتِ سّرِيّ كّحَ مَ، وٌ نفَشَكٍرٍنيِيٍ تَفِ نُن عٍ تَن نُن شْحّيٍ تَفِ. <verse eid="DEU 1:16"/><verse number="17" style="v" sid="DEU 1:17"/>وٌ نَشَ تِ مِشِ يٌ شْن مَ كِيتِ سَدٍ. وٌ نَشَ شُرُنيِ نُن فبٌي مَتٌ. وٌ نَشَ فَاشُ مِشِ يٌ يَ رَ، بَرِ مَ كِيتِسَ نَ عَلَ نَن نَ. شَ كِيتِ سَ شْرْشْ وٌ بّ هَن، وٌ قَ عَ رَ ﭑ شْن، ﭑ تَن كِيتِ سَمَ.› <verse eid="DEU 1:17"/><verse number="18" style="v" sid="DEU 1:18"/>نَ كِ ﭑ بَرَ قٍ بِرِن مَسٍن وٌ بّ، عَ لَن وٌ شَ نَشَن نَبَ.»<verse eid="DEU 1:18"/></para>
  <para style="s">عَلَ مَتَندِقٍ كَدٍ سِ</para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 1:19"/>«نَ تٌ دَنفِ، وٌن نَشَ كٍلِ شٌرٍبٍ فٍيَ، وٌن مِنِ فبٍنفبٍرٍنيِ مَفَاشُشِ رَ وٌ بَرَ دّننَشّ تٌ. وٌن نَشَ بِرَ كِرَ قْشْ رَ نَشَن سِفَمَ عَمٌرِ فٍيَيٍ بِرِ رَ، عَلْ وٌن مَرِفِ عَلَتَلَ عَ مَسٍن وٌن بّ كِ نَشّ. وٌن نَشَ سٌ كَدٍ سِ بَرِنٍيَ. <verse eid="DEU 1:19"/><verse number="20" style="v" sid="DEU 1:20"/>ﭑ نَشَ عَ قَلَ وٌ بّ، ‹وٌ بَرَ عَمٌرِ فٍيَيٍ لِ، وٌن مَرِفِ عَلَتَلَ دّننَشّ قِشِ وٌن مَ. <verse eid="DEU 1:20"/><verse number="21" style="v" sid="DEU 1:21"/>وٌ عَ مَتٌ، وٌ مَرِفِ عَلَتَلَ بَرَ يِ بْشِ تِ وٌن يَ عِ. وٌ سِفَ، وٌ شَ نَ تٌنفٌ عَلْ وٌ بٍنبَيٍ مَرِفِ عَلَتَلَ عَ قَلَشِ وٌ بّ كِ نَشّ. وٌ نَشَ فَاشُ، وٌ شَ لِمَنِيَ.›»<verse eid="DEU 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 1:22"/>«نَ تّمُي، وٌ بِرِن نَشَ قَ ﭑ يِرٍ، وٌ قَ عَ قَلَ ﭑ بّ، ‹وٌن شَ مِشِيٍ شّي، عٍ شَ سِفَ يِ بْشِ مَ، عٍ شَ نَا رَبّن. نَ شَ قِندِ نٍيٍ قَن مَ وَلِ رَ، عَلَكٌ وٌن شَ عَ كٌلٌن وٌن لَن وٌن شَ وٌن حّرّ كِرَ نَشَن شْن عَ نُن وٌن سِفَمَ تَا نَشٍيٍ.› <verse eid="DEU 1:22"/><verse number="23" style="v" sid="DEU 1:23"/>وٌ شَ مَحْشُنيِ نَشَ قِندِ ﭑ بّ قٍ قَنيِ رَ. نَ نَن عَ تٌ ﭑ نَشَ شّمّ مِشِ قُ نُن قِرِن مَيٍفٍتِ وٌ يَ مَ، وٌ بْنسْي كٍرٍن كٍرٍن مَ تَفِ. <verse eid="DEU 1:23"/><verse number="24" style="v" sid="DEU 1:24"/>عٍ نَشَ سِفَ فٍيَيٍ بِرِ رَ هَن عٍ نَشَ فُلُنبَ لِ نَشَن شِلِ عٍسٍكٌلِ. عٍ نَشَ نَا رَبّن. <verse eid="DEU 1:24"/><verse number="25" style="v" sid="DEU 1:25"/>عٍ نَشَ يِ بْشِ بٌفِسٍيٍ بَ، عٍ قَ عٍ مَسٍن وٌن بّ. عٍ نَشَ دّنتّفّ سَ وٌن بّ يِ كِ، ‹وٌن مَرِفِ عَلَتَلَ بْشِ قَنيِ نَن قِشِ وٌن مَ.› <verse eid="DEU 1:25"/><verse number="26" style="v" sid="DEU 1:26"/>كْنْ وٌ مُ تِن تٍدٍ، وٌ نَشَ تٌندِ وٌ مَرِفِ عَلَتَلَ شَ يَامَرِ رَ. <verse eid="DEU 1:26"/><verse number="27" style="v" sid="DEU 1:27"/>وٌ عَ مَشْرْشْ نّ وٌ شَ كِرِ بَنشِيٍ كُي. وٌ نَشَ عَ قَلَ، ‹شْننَنتٍيَ نَ شّيشِ، عَلَتَلَ وٌن تٌنفٌشِ مِسِرَ بْشِ مَ. عَ وَ مَ وٌن سٌقٍ عَمٌرِكَيٍ نَن يِ رَ عَلَكٌ عٍ شَ وٌن هَلَكِ. <verse eid="DEU 1:27"/><verse number="28" style="v" sid="DEU 1:28"/>وٌن سِفَمَ مِندٍن؟ لِمَنِيَ مُ نَ وٌن بّ، بَرِ مَ وٌن نفَشَكٍرٍنيِيٍ بَرَ عَ قَلَ وٌن بّ عَ مّننِكَيٍ سّنبّ فبٌ. عٍ مَن فبَنفبَلَن وٌن بّ، نُن نَ تَايٍ شَ قٍ مَشْرْشْ. تّتّ نَشَن نَا رَبِلِنشِ، عَ عِتٍ هَن. مُشُ عَنَكِ بْنسْييٍ يَتِ تٌ نّ.›»<verse eid="DEU 1:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="DEU 1:29"/>«ﭑ نَشَ عَ قَلَ وٌ بّ، ‹وٌ نَشَ سِيكّ. وٌ نَشَ فَاشُ عٍ يَ رَ! <verse eid="DEU 1:29"/><verse number="30" style="v" sid="DEU 1:30"/>وٌ مَرِفِ عَلَتَلَ نَشَن حّرّ مَ وٌ يَ رَ، عَ فٍرٍ سٌمَ نّ وٌ بّ عَلْ عَ عَ رَبَشِ وٌ يَ شْرِ كِ نَشّ مِسِرَ بْشِ مَ هَن فبٍنفبٍرٍنيِ مَ. <verse eid="DEU 1:30"/><verse number="31" style="v" sid="DEU 1:31"/>وٌ مَن بَرَ عَ تٌ، وٌ مَرِفِ عَلَتَلَ قَشِ نّ وٌ رَ عَلْ شّمّ عَ شَ دِ شَنِنمَ كِ نَشّ، وٌ حّرّشِ كِرَ نَشَن بِرِن نَ هَن وٌ نَشَ قَ بٍ لِ. <verse eid="DEU 1:31"/><verse number="32" style="v" sid="DEU 1:32"/>كْنْ نَ بِرِن كُي، وٌ مُ نُ لَشِ وٌ مَرِفِ عَلَتَلَ رَ. <verse eid="DEU 1:32"/><verse number="33" style="v" sid="DEU 1:33"/>عَ تَن نَن تِ وٌ يَ رَ، عَ يِرٍ قٍن وٌ بّ وٌ لُمَ دّننَشّ. كْي رَ عَ تَن نَن نُ كِرَ عِيَلَنمَ وٌ بّ تّ رَ. يَنيِ قَن نَ، عَ قِندِ نُشُي رَ، عَ تِ وٌ يَ رَ. <verse eid="DEU 1:33"/><verse number="34" style="v" sid="DEU 1:34"/>عَلَتَلَ نَشَ وٌ شُرُتُشُرُتُ شُي مّ. عَ شَ شْنّ كُي، عَ نَشَ عَ رَكَلِ، <verse eid="DEU 1:34"/><verse number="35" style="v" sid="DEU 1:35"/>«يِ مِشِ كٌبِ يٌ مُ سٌمَ يِ بْشِ قَنيِ مَ، ﭑ نَشَن لَايِدِشِ وٌ بَبَيٍ بّ <verse eid="DEU 1:35"/><verse number="36" style="v" sid="DEU 1:36"/>قٌ كَلٍبِ، يٍقُنٍ شَ دِ. عَ تَن عَ تٌمَ نّ. عَ بْشِ دّننَشّ حّرّشِ، نَ قِندِ مَ نّ عَ فبٍ نُن عَ بْنسْي فبٍ رَ، بَرِ مَ عَ بَرَ بِرَ ﭑ تَن عَلَتَلَ شَ كِرَ قْشْ رَ.»›»<verse eid="DEU 1:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="DEU 1:37"/>«وٌ تَن شَ قٍ رَ عَلَتَلَ بَرَ شْنْ ﭑ قَن مَ. عَ نَشَ عَ مَسٍن، ‹عِ تَن يّتّ يَتِ مُ سٌمَ يِ بْشِ مَ. <verse eid="DEU 1:37"/><verse number="38" style="v" sid="DEU 1:38"/>يٌسُوٍ، نُنُ شَ دِ، عِ مَلِمَ، نَن قَمَ سٌدٍ. لِمَنِيَ قِ عَ مَ، بَرِ مَ عَ تَن نَن تِمَ عِسِرَيِلَكَيٍ يَ رَ يِ بْشِ مَسْتْقٍ رَ، عَ شَ قِندِ عٍ كّ رَ. <verse eid="DEU 1:38"/><verse number="39" style="v" sid="DEU 1:39"/>وٌ شَ دِيٍ، وٌ عَ قَلَشِ نَشٍيٍ بّ، عٍ قِندِ مَ فٍيلِمَنِيٍ رَ. عٍ تَن نَشَن مُ قٍ كٌبِ نُن قٍ قَنيِ تَفِ رَبَ كٌلٌنشِ، عٍ تَن نَن قَمَ سٌدٍ نَ بْشِ مَ. ﭑ قَمَ نَ بْشِ قِدٍ عٍ تَن نَن مَ. عَ قِندِ مَ عٍ تَن نَن فبٍ رَ. <verse eid="DEU 1:39"/><verse number="40" style="v" sid="DEU 1:40"/>كْنْ وٌ تَن مَن شَ وٌ مَقِندِ فبِلٍنقٍ رَ فبٍنفبٍرٍنيِ بِرِ رَ، سِفَقٍ كَلٍ بَا مَبِرِ.›»<verse eid="DEU 1:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="DEU 1:41"/>«وٌ نَشَ عَ يَابِ، ‹مُشُ بَرَ قِندِ يُنُبِتْي رَ عَلَتَلَ يَ عِ، كْنْ يَكْسِ مُشُ قَ وَ مَ سِفَقٍ فٍرٍ سٌدٍ نّ، عَلْ مُشُ مَرِفِ عَلَتَلَ مُشُ يَمَرِشِ عَ رَ كِ نَشّ.› كَنكَن نَشَ فٍرٍ سٌسٍ تٌنفٌ، بَرِ مَ وٌ عَ مَحْشُن نّ عَ يِ فٍيَ تَا مَسْتْقٍ عَ قِندِ مَ سْونّيَ رَ. <verse eid="DEU 1:41"/><verse number="42" style="v" sid="DEU 1:42"/>نَ نَن عَ تٌ عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، ‹عَ قَلَ عٍ بّ، وٌ نَشَ سِفَ فٍرٍ سٌدٍ دٍ، بَرِ مَ ﭑ مُ نَ وٌ يَ مَ. وٌ نَشَ سِفَ دٍ، وٌ يَشُييٍ نَشَ قَ وٌ بْنبْ.› <verse eid="DEU 1:42"/><verse number="43" style="v" sid="DEU 1:43"/>ﭑ يِ مَرَ سِ قِشِ نّ وٌ مَ، كْنْ وٌ مُ تِن وٌ تُلِ مَتِدٍ ﭑ نَ. وٌ نَشَ عَلَتَلَ شُي مَتَندِ، وٌ نَشَ تٍ يّتّ عِفبٌحَ كُي فٍيَ قَرِ. <verse eid="DEU 1:43"/><verse number="44" style="v" sid="DEU 1:44"/>نَ تّمُي عَمٌرِكَ نَشٍيٍ نُ سَبَتِشِ فٍيَ قَرِ عٍ نَشَ مِنِ وٌ فٍرٍدٍ عَلْ كُمِ دِنمَ مِشِ رَ كِ نَشّ. عٍ نَشَ وٌ بْنبْ كٍلِ سٍيِرِ هَن هٌرٌ مَ. <verse eid="DEU 1:44"/><verse number="45" style="v" sid="DEU 1:45"/>وٌ تٌ فبِلٍن، وٌ نَشَ وَ عَلَتَلَ يَ عِ، كْنْ عَلَتَلَ مُ عَ تُلِ مَتِ وٌ وَ شُي رَ. <verse eid="DEU 1:45"/><verse number="46" style="v" sid="DEU 1:46"/>وٌ مَن نَشَ لُ كَدٍ سِ، وٌ بُ نَا عَلْ وٌ سِنفٍ بُي نَشَن نَبَ.»<verse eid="DEU 1:46"/></para>
  <chapter eid="DEU 1"/>
  <chapter number="2" style="c" sid="DEU 2"/>
  <para style="s">عِسِرَيِلَكَيٍ تَايٍ مَبِلِنقٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 2:1"/>«نَ شَنبِ وٌن نَشَ فبِلٍن فبٍنفبٍرٍنيِ كِرَ سُشُ رَ سِفَقٍ كَلٍ بَا مَبِرِ، عَلْ عَلَتَلَ عَ مَسٍن ﭑ بّ كِ نَشّ. وٌن نَشَ شِ وُيَشِ رَبَ سٍيِرِ فٍيَيٍ رَبِلِنيِ.»<verse eid="DEU 2:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="DEU 2:2"/>«عَلَتَلَ نَشَ عَ قَلَ ﭑ بّ، <verse eid="DEU 2:2"/><verse number="3" style="v" sid="DEU 2:3"/>‹وٌ بَرَ يِ فٍيَ مَبِلِن عَ فبٍ رَ. وٌ وٌ مَقِندِ سِفَقٍ رَ كْولَ مَ.› <verse eid="DEU 2:3"/><verse number="4" style="v" sid="DEU 2:4"/>عَ نَشَ عَ قَلَ ﭑ بّ ﭑ شَ يِ يَامَرِ قِ وٌ مَ. وٌ قَمَ دَنفِدٍ سٍيِرِ بْشِ سّيتِ مَ، وٌ نفَشَكٍرٍنيِيٍ نَ دّننَشّ، عٍسَيُ بْنسْي. عٍ قَمَ نّ فَاشُدٍ وٌ يَ رَ، كْنْ وٌ وٌ يّتّ مَسُشُ عٍ فٍرٍقٍ رَ، <verse eid="DEU 2:4"/><verse number="5" style="v" sid="DEU 2:5"/>بَرِ مَ ﭑ مُ سٍسٍ سٌمَ وٌ يِ رَ عٍ شَ بْشِ مَ، هَلِ سَنيِ تِدٍ. ﭑ بَرَ سٍيِرِ فٍيَيٍ قِ عٍسَيُ مَ. <verse eid="DEU 2:5"/><verse number="6" style="v" sid="DEU 2:6"/>وٌ نَ وَ دٌنسٍ نُن يٍ نَشَن شْن قٌ وٌ عَ سَرَ عٍ مَ فبٍتِ رَ. <verse eid="DEU 2:6"/><verse number="7" style="v" sid="DEU 2:7"/>وٌ مَرِفِ عَلَتَلَ بَرَ بَرَكَ سَ وٌ وَلِ قْشِ. عَ بَرَ عَ حْشْ سَ وٌ شَ قٍ شْن مَ وٌ نُ يِ فبٍنفبٍرٍنيِ عِفِرِ مَ تّمُي نَشّ. يِ حّ تٌنفٌ نَانِ بُن مَ، وٌ بِرِن نَن نُ عَ رَ. سٍسٍ شَ قٍ مُ شْرْشْ وٌ مَ.»<verse eid="DEU 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 2:8"/>«وٌن نَشَ دَنفِ وٌن نفَشَكٍرٍنيِيٍ رَ يِرٍ مَكُيٍ، عٍسَيُ بْنسْي نَشَن سَبَتِشِ سٍيِرِ بْشِ مَ. وٌن مَن نَشَ دَنفِ عَرَبَ، عٍلَتَ، عٍسِيٌن فٍبٍرِ كِرَ رَ يِرٍ مَكُيٍ. نَ شَنبِ وٌن نَشَ وٌن مَقِندِ، وٌن مٌوَبَ فبٍنفبٍرٍنيِ كِرَ سُشُ.»<verse eid="DEU 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 2:9"/>«عَلَتَلَ نَشَ عَ قَلَ ﭑ بّ، ‹وٌ نَشَ فٍرٍ فِرِ مٌوَبَكَيٍ مَ دٍ. وٌ نَشَ فٍرٍ تِ عٍ بّ دٍ، بَرِ مَ ﭑ مُ قَمَ سٍسٍ سٌدٍ وٌ يِ رَ عٍ شْنيِ. ﭑ بَرَ عَرِ بْشِ قِ لٌتِ مَ.›»<verse eid="DEU 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 2:10"/>سِنفٍ رَ، عٍمِكَيٍ نَن نُ نَ عَرِ بْشِ مَ. حَمَ فبَنفبَلَنيِ نَن نُ عٍ رَ. عٍ وُيَ، عٍ قَن كُيَ عَلْ عَنَكِ بْنسْييٍ. <verse eid="DEU 2:10"/><verse number="11" style="v" sid="DEU 2:11"/>مِشِ ندٍيٍ نَشَ عٍ مَحْشُن رٍقَكَيٍ رَ، نَشٍيٍ مَنِيَ عَنَكِ بْنسْييٍ رَ، كْنْ مٌوَبَكَيٍ نُ عٍ شِلِمَ نّ عٍمِكَيٍ. <verse eid="DEU 2:11"/><verse number="12" style="v" sid="DEU 2:12"/>نَشَن قِندِ سٍيِرِ بْشِ رَ، شٌرِكَيٍ نَن سِنفٍ نُ نَ نَا. عٍسَيُ بْنسْي نَشَ عٍ مَسُشُ، عٍ عٍ قَشَ. عٍ تَن نَشَ سَبَتِ نَا. عِسِرَيِلَكَيٍ قَن قَمَ نَ مْولِ نَن نَبَدٍ بْشِ مَ عَلَتَلَ نَ دّننَشّ قِ عٍ مَ.<verse eid="DEU 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="DEU 2:13"/>«عَلَتَلَ نَشَ عَ قَلَ ﭑ بّ، ‹يَكْسِ، وٌ كٍلِ، وٌ شَ سٍرٍدٍ شُرٍ عِفِرِ.›» وٌن نَشَ نَ رَبَ. <verse eid="DEU 2:13"/><verse number="14" style="v" sid="DEU 2:14"/>حّ تٌنفٌ سَشَن نُن سٌلٌمَسَشَن دَنفِ نّ كَبِ وٌن كٍلِ لْشْي كَدٍ سِ بَرِنٍيَ هَن وٌن فِرِ لْشْي سٍرٍدٍ شُرٍ رَ. نَ وَشَتِ كُي فٍرٍ سٌي نَشٍيٍ نُ نَ، نٍيٍ بِرِن نُ بَرَ قَشَ عَلْ عَلَتَلَ عَ رَكَلِ عٍ بّ كِ نَشّ. <verse eid="DEU 2:14"/><verse number="15" style="v" sid="DEU 2:15"/>عَلَتَلَ نَشَ عٍ تُشُنسَن هَن عٍ بِرِن نَشَ هَلَكِ.<verse eid="DEU 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 2:16"/>نَ فٍرٍ سٌي تٌ بَرَ هَلَكِ حَمَ تَفِ، <verse eid="DEU 2:16"/><verse number="17" style="v" sid="DEU 2:17"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، <verse eid="DEU 2:17"/><verse number="18" style="v" sid="DEU 2:18"/>«وٌ قَ سِفَقٍ دَنفِدٍ مٌوَبَ نَانِنيِ نَن نَ سِفَقٍ عَرِ بْشِ مَ. <verse eid="DEU 2:18"/><verse number="19" style="v" sid="DEU 2:19"/>وٌ مَكْرّ مَ نّ عَمٌنِكَيٍ رَ. وٌ نَشَ فٍرٍ فِرِ عٍ مَ دٍ. وٌ نَشَ عٍ قٍن فٍرٍ رَ، بَرِ مَ ﭑ مُ قَمَ سٍسٍ سٌدٍ وٌ يِ رَ عٍ شَ بْشِ مَ. ﭑ نَا قِشِ لٌتِ بْنسْي نَن مَ.»<verse eid="DEU 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="DEU 2:20"/>عٍ نُ يِ بْشِ مَحْشُنشِ رٍقَكَيٍ نَن فبٍ رَ. كَبِ تّمُي شْننَكُيٍ رٍقَكَيٍ نَن نُ سَبَتِشِ نَا. عَمٌنِكَيٍ نُ عٍ شِلِمَ نّ سَمِسُمِكَيٍ. <verse eid="DEU 2:20"/><verse number="21" style="v" sid="DEU 2:21"/>حَمَ سّنبّمَ نَن نُ لَنشِ عٍ مَ، عٍ وُيَ، عٍ مَن فبَنفبَلَن عَلْ عَنَكِ بْنسْي. كْنْ عَلَتَلَ نَشَ عٍ هَلَكِ عَمٌنِكَيٍ سَابُي رَ. نَا نَشَ قِندِ عَمٌنِكَيٍ فبٍ رَ، عٍ نَشَ سَبَتِ نَا. <verse eid="DEU 2:21"/><verse number="22" style="v" sid="DEU 2:22"/>عَلَتَلَ نَشَ نَ مْولِ رَبَ عٍسَيُ شَ دِيٍ بّ نَشٍيٍ سَبَتِشِ سٍيِرِ بْشِ مَ. عَ تٌ نُ شٌرِكَيٍ هَلَكِمَ عٍ سَابُي رَ، نَا نَشَ قِندِ عٍ فبٍ رَ. عٍ سَبَتِشِ مّننِ نّ هَن يَكْسِ. <verse eid="DEU 2:22"/><verse number="23" style="v" sid="DEU 2:23"/>نَشَن قِندِ عَوِكَيٍ تَن نَ، نَشٍيٍ نُ سَبَتِشِ تَايٍ كُي هَن فَسَ، عٍ نَشَ هَلَكِ كَقَتٌرٌكَيٍ سَابُي رَ. نَا نَشَ قِندِ كَقَتٌرٌكَيٍ فبٍ رَ، عٍ نَشَ سَبَتِ نَا. كَقَتٌرٌكَيٍ نَشَ كٍلِ كَقَتٌرٌ.<verse eid="DEU 2:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="DEU 2:24"/>عَلَتَلَ نَشَ عَ مَسٍن وٌن بّ، «وٌ تِ كِرَ شْن مَ، وٌ شَ عَرِنٌن شُرٍ عِفِرِ. وٌ عَ مَتٌ، ﭑ بَرَ سِشْن عَمٌرِكَ شّسِبْن مَنفّ سٌ وٌ يِ رَ نُن عَ شَ بْشِ. يَكْسِ، وٌ نَ تٌنفٌ، وٌ عٍ فٍرٍ. <verse eid="DEU 2:24"/><verse number="25" style="v" sid="DEU 2:25"/>تٌ ﭑ قَمَ نّ وٌ شَ قٍ مَفَاشُي لُدٍ دُنِحَ مِشِ بِرِن مَ. عٍ نَ وٌ شِلِ مّ، عٍ قَمَ نّ سّرّندٍ فبِرِفبِرِ.»<verse eid="DEU 2:25"/></para>
  <para style="s">سِشْن مَنفّيَ سْتْ كِ</para>
  <para style="p">
    <verse number="26" style="v" sid="DEU 2:26"/>«ﭑ شّيرَ شّي نّ سِشْن، شّسِبْن مَنفّ مَ، كٍلِقٍ رَ كٍدٍ مٌتِ فبٍنفبٍرٍنيِ مَ. ﭑ نَشَ يِ بْحّسَ مَسٍنيِ تِ عَ بّ، <verse eid="DEU 2:26"/><verse number="27" style="v" sid="DEU 2:27"/>‹مُشُ وَ مَ عِ شَ بْشِ عِفِرِقٍ. مُشُ مُشُ حّرّ مَ كِرَ نَن تُن شْن مَ. مُشُ مُ سِفَمَ كْولَ مَ، مُشُ مُ سِفَمَ يِرٍقَنيِ مَ. <verse eid="DEU 2:27"/><verse number="28" style="v" sid="DEU 2:28"/>مُشُ دٌنسٍ نُن يٍ نَشَن مِنمَ، مُشُ قَمَ نّ عَ بِرِن سَرٍ قِدٍ عِ مَ فبٍتِ رَ. عَ لُ كَنسَن مُشُ شَ دَنفِ عِ شَ بْشِ مَ مُشُ سَنيِ رَ. <verse eid="DEU 2:28"/><verse number="29" style="v" sid="DEU 2:29"/>عٍسَيُ بْنسْييٍ نَشٍيٍ سَبَتِشِ سٍيِرِ بْشِ مَ، نُن مٌوَبَكَيٍ نَشٍيٍ سَبَتِشِ عَرِ بْشِ مَ، نٍيٍ نَشَ مُشُ سَفٌي سَ دَنفِقٍ رَ عٍ شَ بْشِ مَ. عِ قَن شَ مُشُ سَفٌي سَ مُشُ شَ يُرُدّن شُرٍ عِفِرِ، مُشُ شَ سٌ بْشِ مَ مُشُ مَرِفِ عَلَتَلَ دّننَشّ قِشِ مُشُ مَ.› <verse eid="DEU 2:29"/><verse number="30" style="v" sid="DEU 2:30"/>كْنْ شّسِبْن مَنفّ سِشْن نَشَ تٌندِ مُشُ سَفٌي قِدٍ دَنفِقٍ رَ عَ شَ بْشِ مَ، بَرِ مَ وٌ مَرِفِ عَلَتَلَ نُ بَرَ عَ شَشِلِ رَشْرْشْ. عَ نَشَ عَ بْحّ بَلَن عَلَكٌ عَ شَ عَ سٌ وٌ يِ رَ عَلْ وٌ عَ تٌشِ كِ نَشّ تٌ.»<verse eid="DEU 2:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="DEU 2:31"/>«عَلَتَلَ نَشَ عَ قَلَ ﭑ بّ، ‹عِ بَرَ عَ تٌ، ﭑ بَرَ فّ سِشْن نُن عَ شَ بْشِ سٌدٍ عِ يِ رَ. نَا تٌنفٌ عِ فبٍ.› <verse eid="DEU 2:31"/><verse number="32" style="v" sid="DEU 2:32"/>سِشْن نُن عَ شَ حَمَ بِرِن نَشَ كٍلِ قَقٍ رَ وٌن فٍرٍدٍ يَهَسِ. <verse eid="DEU 2:32"/><verse number="33" style="v" sid="DEU 2:33"/>وٌن مَرِفِ عَلَتَلَ نَشَ عٍ سٌ وٌن يِ رَ شُننَكٍلِ كُي. وٌن نَشَ نْلَ سْتْ عٍ مَ، عَ تَن، عَ شَ دِيٍ عَ نُن عَ شَ حَمَ بِرِن. <verse eid="DEU 2:33"/><verse number="34" style="v" sid="DEU 2:34"/>وٌن نَشَ نَ تَايٍ بِرِن سُشُ، وٌن نَشَ عٍ بِرِن كَنَ. وٌن مَن نَشَ شّمّيٍ، نُن فِنّيٍ، عَ نُن دِ مّيٍ بِرِن قَشَ. وٌن مُ مِشِ يٌ لُ عَ حِحّ رَ، <verse eid="DEU 2:34"/><verse number="35" style="v" sid="DEU 2:35"/>كْنْ وٌن مُ سٍسٍ تٌنفٌ قٌ شُرُ سٍيٍ عَ نُن سٍ شْرِ نَشٍيٍ نُ نَ نَ تَايٍ كُي. <verse eid="DEU 2:35"/><verse number="36" style="v" sid="DEU 2:36"/>كٍلِ عَرٌوٍرِ عَرِنٌن شُرٍ دّ رَ، عَ نُن تَا نَشَن نَ فٍيَ لَنبَنيِ، سِفَقٍ رَ هَن فَلَدِ، تَا يٌ سّنبّ مُ دَنفِ وٌن نَ. وٌن مَرِفِ عَلَتَلَ نَشَ عَ بِرِن سٌ وٌن يِ رَ. <verse eid="DEU 2:36"/><verse number="37" style="v" sid="DEU 2:37"/>كْنْ وٌ مُ وٌ مَكْرّ عَمٌنِكَيٍ شَ بْشِ رَ، يَبٌكٌ شُرٍ دّ بِرِن، تَا نَشٍيٍ نَ فٍيَ قَرِ، عَ نُن عَلَتَلَ تْنيِ دْشْ وٌن مَ بْشِ نَشٍيٍ فٍرٍقٍ رَ.»<verse eid="DEU 2:37"/></para>
  <chapter eid="DEU 2"/>
  <chapter number="3" style="c" sid="DEU 3"/>
  <para style="s">بَسَن بْشِ مَسْتْ كِ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 3:1"/>«وٌن نَشَ وٌن مَقِندِ تٍقٍ رَ بَسَن كِرَ شْن مَ. عٌفٌ، بَسَن مَنفّ، نَشَ مِنِ وٌن فٍرٍدٍ عٍدٍرِ، عَ تَن نُن عَ شَ حَمَ بِرِن. <verse eid="DEU 3:1"/><verse number="2" style="v" sid="DEU 3:2"/>عَلَتَلَ نَشَ عَ قَلَ ﭑ بّ، ‹عِ نَشَ فَاشُ عَ يَ رَ، بَرِ مَ ﭑ عَ نِيَمَ نّ عِ شُتُ سْتْ عَ تَن نُن عَ شَ حَمَ بِرِن مَ نُن عَ شَ بْشِ. عِ شَ نْ عَ رَ عَلْ عِ عَ رَبَشِ عَمٌرِكَيٍ شَ مَنفّ سِشْن نَ كِ نَشّ.› <verse eid="DEU 3:2"/><verse number="3" style="v" sid="DEU 3:3"/>وٌن مَرِفِ عَلَتَلَ نَشَ عَ نِيَ وٌن شَ شُتُ سْتْ بَسَن مَنفّ عٌفٌ نُن عَ شَ حَمَ بِرِن مَ. وٌن نَشَ عٍ بِرِن قَشَ، مِشِ يٌ مُ لُ. <verse eid="DEU 3:3"/><verse number="4" style="v" sid="DEU 3:4"/>نَ تّمُي وٌن نُ بَرَ عٍ شَ تَايٍ بِرِن سُشُ. نَ تَا يٌ مُ لُ وٌن مُ دّننَشّ سُشُ، تَا تٌنفٌ سٍننِ نَ عَ رَ نَشَن نَ عَرَفٌبٌ رَبِلِنيِ. نَ تَا بِرِن نُ نَ عٌفٌ شَ مَنفّيَ نَن بُن مَ بَسَن بْشِ مَ. <verse eid="DEU 3:4"/><verse number="5" style="v" sid="DEU 3:5"/>نَ تَايٍ بِرِن نُ رَبِلِنشِ تّتّ عِتٍشِيٍ نَن نَ، نُن نَادّ مَبَلَنشِيٍ رَ. تَا فبٍفبٍ قَن نُ نَ تّتّ مُ نُ نَشٍيٍ رَبِلِنشِ. <verse eid="DEU 3:5"/><verse number="6" style="v" sid="DEU 3:6"/>وٌن نَشَ نَ لٌنفٌرِ تَا بِرِن كَنَ عَلْ وٌن عَ رَبَ شّسِبْن، سِشْن مَنفّ شَ بْشِ رَ كِ نَشّ. وٌن نَشَ شّمّيٍ، نُن فِنّيٍ، عَ نُن دِ مّيٍ بِرِن قَشَ، <verse eid="DEU 3:6"/><verse number="7" style="v" sid="DEU 3:7"/>كْنْ وٌن نَشَ عٍ شَ شُرُ سٍيٍ نُن عٍ هَرِفٍ تَن شَنِن.»<verse eid="DEU 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 3:8"/>«وٌن عَ رَبَ نَ كِ نّ. نَ وَشَتِ وٌن نَشَ بْشِيٍ رَ سُشُ، نَشٍيٍ نُ نَ يُرُدّن سٌفٍتٍدٍ بِرِ، عَمٌرِكَيٍ شَ مَنفّ قِرِنيِيٍ يِ رَ. نَ لٌنفٌرِ كٍلِ عَرِنٌن شُرٍ هَن شٍرِ مٌن فٍيَ. <verse eid="DEU 3:8"/><verse number="9" style="v" sid="DEU 3:9"/>سِدْنكَيٍ نَ فٍيَ شِلِ قَلَمَ نّ سِرِيٌن. عَمٌرِكَيٍ تَن نَ شِلِ قَلَمَ سٍنِرِ. <verse eid="DEU 3:9"/><verse number="10" style="v" sid="DEU 3:10"/>تَا نَشٍيٍ بِرِن نَ لَنبَنيِ مَ، وٌن نَشَ عٍ بِرِن مَسْتْ، عَ نُن فَلَدِ بْشِ رَبِلِنيِ بِرِن، سِفَقٍ رَ بَسَن مَ سَ دْشْ سَلِكَ نُن عٍدٍرِ رَ. نَ تَا بِرِن نُ نَ عٌفٌ شَ مَنفّيَ نَن بُن مَ بَسَن بْشِ مَ. <verse eid="DEU 3:10"/><verse number="11" style="v" sid="DEU 3:11"/>بَسَن مَنفّ عٌفٌ نَن كٍرٍن مُ قَشَ رٍقَكَيٍ يَ مَ. عَ شَ وُرٍ سَدٍ نُ نَ رَابَ نّ، عَمٌنِكَيٍ شَ مَنفَتَا. عَ كُيّ نُ سِفَشِ نْنفْن سٌلٌمَنَانِ، عَ عِفبٌي نْنفْن نَانِ.»<verse eid="DEU 3:11"/></para>
  <para style="s">فَلَدِ نُن بَسَن بْشِ عِتَشُنيِ</para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 3:12"/>«نَ تّمُي وٌن نَشَ شُتُ سْتْ نَ بْشِ مَ. كٍلِقٍ عَرٌوٍرِ سِفَقٍ رَ عَرِنٌن شُرٍ مَ، عَ نُن فَلَدٍ فٍيَ سّيتِ، نُن عَ تَايٍ، ﭑ نَشَ نَ بِرِن سٌ رُبٍن نُن فَدِ بْنسْي يِ رَ. <verse eid="DEU 3:12"/><verse number="13" style="v" sid="DEU 3:13"/>ﭑ نَشَ فَلَدٍ سّيتِ دْنشْي نُن عٌفٌ شَ مَنفّيَ نَشَن نَ بَسَن بْشِ مَ سٌ مَنَسِ بْنسْي سّيتِ يِ رَ. عَرَفٌبٌ رَبِلِنيِ نُن بَسَن نُ كٌلٌنشِ رٍقَكَيٍ شَ بْشِ نَن نَ. <verse eid="DEU 3:13"/><verse number="14" style="v" sid="DEU 3:14"/>مَنَسِ شَ دِ يَيِرِ نَشَ عَرَفٌبٌ بْشِ قِندِ عَ فبٍ رَ، هَن فٍسُرِكَيٍ نُن مَاكَكَيٍ نَانِنيِ رَ. عَ نَشَ عَ شِلِ سَ بَسَن شُن مَ، نَشَن شِلِ قَلَمَ هَن يَكْسِ يَيِرِ تَا. <verse eid="DEU 3:14"/><verse number="15" style="v" sid="DEU 3:15"/>ﭑ نَشَ فَلَدٍ سٌ مَكِرِ يِ رَ. <verse eid="DEU 3:15"/><verse number="16" style="v" sid="DEU 3:16"/>ﭑ نَشَ فَلَدٍ سّيتِ سٌ رُبٍن بْنسْي عَ نُن فَدِ بْنسْي يِ رَ، هَن عَ سَ دْشْ عَرِنٌن شُرٍ رَ. شُرٍ نَن نَ نَانِنيِ رَ، هَن عَ سَ دْشْ يَبٌكٌ شُرٍ رَ عَمٌنِكَيٍ نَانِنيِ رَ، <verse eid="DEU 3:16"/><verse number="17" style="v" sid="DEU 3:17"/>عَ نُن عَرَبَ بْشِ نَشَن نُن يُرُدّن نَانِنيِ بَشِ، كٍلِ كِنٍرٍتِ بَا مَ، عَ سَ دْشْ عَرَبَ قْشّ بَا رَ، نَشَن نَ ثِسِفَ لَنبَنيِ مَ سٌفٍتٍدٍ.»<verse eid="DEU 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="DEU 3:18"/>«نَ تّمُي ﭑ نَشَ يِ يَامَرِ قِ وٌ مَ، ‹وٌ مَرِفِ عَلَتَلَ بَرَ يِ بْشِ قِ وٌ مَ عَلَكٌ عَ شَ قِندِ وٌ فبٍ رَ. وٌ تَن شّمّ كّندّيٍ، وٌ قِندِ مَ نّ وٌ نفَشَكٍرٍنيِ عِسِرَيِلَكَيٍ شَ سْورِيٍ رَ. <verse eid="DEU 3:18"/><verse number="19" style="v" sid="DEU 3:19"/>وٌ شَ فِنّيٍ نُن وٌ شَ دِيْرّيٍ، نُن وٌ شَ شُرُ سٍيٍ نَن فبَنسَن قَمَ لُدٍ تَايٍ كُي ﭑ نَشٍيٍ سٌشِ وٌ يِ رَ. ﭑ نَ عَ كٌلٌن شُرُ سٍيٍ فبٍفبٍ نَ وٌ يِ رَ. <verse eid="DEU 3:19"/><verse number="20" style="v" sid="DEU 3:20"/>وٌ سْورِحَ رَبَمَ نّ هَن وٌ مَرِفِ عَلَتَلَ مَلَبُي قِمَ وٌ نفَشَكٍرٍنيِيٍ مَ تّمُي نَشّ. وٌ مَرِفِ عَلَتَلَ بْشِ قِمَ عٍ مَ يُرُدّن نَاكِرِ نَن مَ. نَ تّمُي كَنكَن قَمَ فبِلٍندٍ عَ شَ بْشِ مَ ﭑ نَشَن سٌشِ عَ يِ رَ.›»<verse eid="DEU 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="DEU 3:21"/>«نَ تّمُي ﭑ نَشَ يَامَرِ سٌ يٌسُوٍ يِ رَ. ﭑ قَ عَ قَلَ عَ بّ، ‹عِ يَ بَرَ قٍيٍ بِرِن تٌ عِ مَرِفِ عَلَتَلَ نَشٍيٍ رَبَشِ يِ مَنفّ قِرِنيِيٍ رَ. عَلَتَلَ قَمَ نّ نَ رَبَدٍ مَنفَتَا بِرِن عِ نَ دَنفِ دّننَشّ. <verse eid="DEU 3:21"/><verse number="22" style="v" sid="DEU 3:22"/>عِ نَشَ فَاشُ عٍ يَ رَ، بَرِ مَ عِ مَرِفِ عَلَتَلَ نَن قَمَ عٍ فٍرٍدٍ وٌ بّ.›»<verse eid="DEU 3:22"/></para>
  <para style="s">عَننَبِ مُنسَ مُ سٌمَ كَنَان</para>
  <para style="p">
    <verse number="23" style="v" sid="DEU 3:23"/>«نَ تّمُي ﭑ نَشَ عَلَتَلَ مَشَندِ، <verse eid="DEU 3:23"/><verse number="24" style="v" sid="DEU 3:24"/>‹ﭑ مَرِفِ عَلَتَلَ، عِ بَرَ عِ شَ قِسَمَنتٍيَ نُن عِ سّنبّ مَسٍن عِ شَ كٌنيِ بّ. عَلَ فبّتّ يٌ مُ نَ كٌورٍ مَ عَ نُن بْشِ نَشَن نْمَ عِ قْشِ عَ نُن عِ شَ كَابَنَكٌي رَبَدٍ. <verse eid="DEU 3:24"/><verse number="25" style="v" sid="DEU 3:25"/>ﭑ بَرَ عِ مَيَندِ، عَ لُ ﭑ شَ نْ يُرُدّن شُرٍ عِفِرِدٍ، عَلَكٌ ﭑ شَ نَ بْشِ قَنيِ نُن عَ شَ فٍيَ قَنيِيٍ تٌ نَشَن نَ نَاكِرِ مَ، عَ نُن لِبَن.› <verse eid="DEU 3:25"/><verse number="26" style="v" sid="DEU 3:26"/>كْنْ وٌ تَن شَ قٍ رَ، عَلَتَلَ نَشَ شْنْ ﭑ مَ. عَ مُ ﭑ دَنشُن. عَلَتَلَ نَشَ عَ قَلَ ﭑ بّ، ‹عَ مُ لَن عِ شَ يِ وْيّنيِ قَلَ ﭑ بّ سْنْن. <verse eid="DEU 3:26"/><verse number="27" style="v" sid="DEU 3:27"/>تٍ ثِسِفَ فٍيَ شُنتَفِ، عِ شَ سٌفٍفٌرٌدٍ بِرِ، كْولَ بِرِ، يِرٍقَنيِ بِرِ، عَ نُن سٌفٍتٍدٍ بِرِ مَتٌ، كْنْ عِ شَ عَ كٌلٌن عَ قَنيِ رَ عِ مُ يُرُدّن عِفِرِ مَ. <verse eid="DEU 3:27"/><verse number="28" style="v" sid="DEU 3:28"/>عِ شَ يَامَرِ سٌ يٌسُوٍ يِ رَ، عِ شَ لِمَنِيَ نُن سّنبّ قِ عَ مَ، بَرِ مَ عَ تَن نَن قَمَ تِدٍ حَمَ يَ رَ يُرُدّن عِفِرِقٍ رَ. عِ بْشِ نَشَن تٌمَ، يٌسُوٍ قَمَ نّ نَ بْشِ سٌدٍ عِسِرَيِلَ يِ رَ، عَ قِندِ عٍ كّ بْشِ رَ.› <verse eid="DEU 3:28"/><verse number="29" style="v" sid="DEU 3:29"/>نَ نَن عَ تٌشِ، وٌن نَشَ لُ فُلُنبَ بٍتِ ثٍيٌرِ يَتَفِ.<verse eid="DEU 3:29"/></para>
  <chapter eid="DEU 3"/>
  <chapter number="4" style="c" sid="DEU 4"/>
  <para style="s">عَلَ شَ سّرِيّ رَبَقٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 4:1"/>«يَكْسِ، عِسِرَيِلَ، وٌ وٌ تُلِ مَتِ. وٌ شَ بِرَ سّرِيّ نُن يَامَرِ قْشْ رَ ﭑ وٌ شَرَنقٍ نَشٍيٍ رَ يِ كِ، عَلَكٌ وٌ شَ سِمَيَ سْتْ، وٌ مَن شَ بْشِ سْتْ وٌ بَبَيٍ مَرِفِ عَلَتَلَ نَشَن قِشِ وٌ مَ. <verse eid="DEU 4:1"/><verse number="2" style="v" sid="DEU 4:2"/>وٌ نَشَ سٍسٍ سَ يَامَرِ شُن، ﭑ نَشَن قَلَشِ وٌ بّ. وٌ مَن نَشَ سٍسٍ بَ عَ رَ. وٌ شَ وٌ مَرِفِ عَلَتَلَ شَ يَامَرِ رَوَلِ عَلْ ﭑ نَ قَلَشِ وٌ بّ كِ نَشّ.»<verse eid="DEU 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="DEU 4:3"/>«وٌ يَيٍ بَرَ قٍيٍ تٌ عَلَتَلَ نَشٍيٍ رَبَشِ ثٍيٌرِ. وٌ مَرِفِ عَلَتَلَ بَرَ مِشِ بِرِن قَشَ نَشٍيٍ بَلِ بَتُشِ ثٍيٌرِ. <verse eid="DEU 4:3"/><verse number="4" style="v" sid="DEU 4:4"/>كْنْ وٌ تَن نَشٍيٍ بِرَشِ وٌ مَرِفِ عَلَتَلَ شَ قٍ قْشْ رَ، وٌ بِرِن مَن نَ سِمَيَ كُي هَن تٌ.»<verse eid="DEU 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="DEU 4:5"/>«وٌ عَ كٌلٌن، ﭑ بَرَ وٌ شَرَن سّرِيّ نُن يَامَرِ رَ عَلْ ﭑ مَرِفِ عَلَتَلَ عَ يَمَرِشِ ﭑ نَ كِ نَشّ، عَلَكٌ وٌ شَ عَ رَبَ بْشِ مَ دّننَشّ قِندِ مَ وٌ فبٍ رَ. <verse eid="DEU 4:5"/><verse number="6" style="v" sid="DEU 4:6"/>وٌ شَ عَ تِ شْرِ مَ، وٌ شَ عَ رَبَ، عَ شَ قِندِ لْننِ رَ وٌ بّ، عَ شَ شَشِلِ قِ وٌ مَ. سِ فبّتّيٍ نَ يِ سّرِيّيٍ كٌلٌن، عٍ قَمَ نّ عَ قَلَدٍ، ‹يِ سِ قِندِشِ لْننِلَ قَنيِيٍ نَن نَ.› <verse eid="DEU 4:6"/><verse number="7" style="v" sid="DEU 4:7"/>سِ مُندُن شَ عَلَ مَكْرّشِ عَ رَ عَلْ وٌن مَرِفِ عَلَتَلَ عَ مَكْرّ مَ وٌن نَ كِ نَشّ وٌن نَ عَ مَشَندِ تّمُي نَشّ؟ <verse eid="DEU 4:7"/><verse number="8" style="v" sid="DEU 4:8"/>سّرِيّ نُن يَامَرِ تِنشِنشِ نَ سِ مُندُن بّ عَلْ وٌن مَ سّرِيّ ﭑ نَشَن سٌشِ وٌ يِ رَ يِ كِ؟ <verse eid="DEU 4:8"/><verse number="9" style="v" sid="DEU 4:9"/>وٌ شَ قٍيٍ رَفَتَ وٌ شَشِلِ مَ لْشْي بِرِن وٌ شَ سِمَيَ كُي، وٌ نَشٍيٍ تٌشِ. وٌ نَشَ نّيمُ نٍيٍ مَ، عٍ نَشَ بَ وٌ بْحّ مَ. وٌ شَ عٍ مَسٍن وٌ شَ دِيٍ نُن وٌ شَ مَمَدِيٍ بّ.»<verse eid="DEU 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 4:10"/>«وٌ وٌ مَحْشُن لْشْي مَ وٌ تِ وٌ مَرِفِ عَلَتَلَ يَ عِ لْشْي نَشّ، شٌرٍبٍ فٍيَ قَرِ. نَ لْشْي عَلَتَلَ نَشَ عَ قَلَ ﭑ بّ، ‹حَمَ بِرِن شَ مَلَن ﭑ يِرٍ. ﭑ شَ ﭑ مَ سّرِيّ قَلَ عٍ بّ عَلَكٌ عٍ شَ فَاشُ ﭑ يَ رَ عٍ شَ دُنِحّءِفِرِ كُي. عٍ مَن شَ عَ شَرَن عٍ شَ دِيٍ قَن نَ.› <verse eid="DEU 4:10"/><verse number="11" style="v" sid="DEU 4:11"/>وٌ نَشَ وٌ مَسٌ فٍيَ بُنيِ رَ. تّ نُ بَرَ دِن فٍيَ رَ هَن كٌورٍ مَ. دِ مِ، نُشُي، نُن كُندَ نَشَ فٌرٌ. <verse eid="DEU 4:11"/><verse number="12" style="v" sid="DEU 4:12"/>عَلَتَلَ نَشَ وْيّن وٌ بّ تّ تَفِ. وٌ نَشَ عَ وْيّن شُي مّ، كْنْ وٌ مُ سٍسٍ تٌ. وٌ نُ عَ شُي نَن تُن مّمَ. <verse eid="DEU 4:12"/><verse number="13" style="v" sid="DEU 4:13"/>عَ نَشَ عَ شَ سَاتّ مَسٍن وٌ بّ، وٌ نَشَن نَوَلِمَ. عَ نَشَ نَ يَامَرِ قُ سّبّ فّمّ وَلَشّ قِرِنيِ مَ. <verse eid="DEU 4:13"/><verse number="14" style="v" sid="DEU 4:14"/>نَ وَشَتِ، عَلَتَلَ نَشَ ﭑ يَامَرِ ﭑ شَ وٌ شَرَن سّرِيّ نُن يَامَرِ رَ، عَلَكٌ وٌ شَ عَ رَبَ بْشِ مَ نَشَن قِندِ مَ وٌ فبٍ رَ.»<verse eid="DEU 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 4:15"/>«وٌ نَشَ وٌ يّتّ رَنّيمُ لْشْي مَ دٍ عَلَتَلَ وْيّن وٌ بّ لْشْي نَشّ، شٌرٍبٍ فٍيَ قَرِ تّ تَفِ، وٌ مُ عَ فُندِ يَتِ تٌ. <verse eid="DEU 4:15"/><verse number="16" style="v" sid="DEU 4:16"/>وٌ نَشَ قِندِ يُنُبِتْي رَ دٍ كُيٍيٍ يَءِلَنقٍ رَ، نَشٍيٍ مِسَالِشِ شّمّ، فِنّ، <verse eid="DEU 4:16"/><verse number="17" style="v" sid="DEU 4:17"/>سُبٍ، شْنِ، <verse eid="DEU 4:17"/><verse number="18" style="v" sid="DEU 4:18"/>بُبُسٍيٍ نُن يّشّيٍ رَ نَشٍيٍ نَ يٍ مَ. <verse eid="DEU 4:18"/><verse number="19" style="v" sid="DEU 4:19"/>وٌ نَشَ وٌ يَيٍ رَتٍ كٌورٍ مَ دٍ، سٌفٍ بَتُقٍ رَ، شَ نَ مُ عَ رَ كِكٍ، شَ نَ مُ عَ رَ تُنبُييٍ. سٍ نَشٍيٍ بِرِن نَ كٌورٍ مَ، وٌ نَشَ وٌ عِفٌرٌ عٍ بّ، وٌ نَشَ عٍ بَتُ. وٌ مَرِفِ عَلَتَلَ نٍيٍ دَاشِ سِ بِرِن نَن بّ، نَشٍيٍ نَ دُنِحَ مَ. <verse eid="DEU 4:19"/><verse number="20" style="v" sid="DEU 4:20"/>كْنْ وٌ تَن، عَلَتَلَ وٌ رَ مِنِ نّ قٍ شْرْشْي كُي مِسِرَ بْشِ مَ عَلَكٌ وٌ شَ قِندِ عَ شَ حَمَ رَ، عَلْ وٌ نَ كِ نَشّ تٌ لْشْي.»<verse eid="DEU 4:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="DEU 4:21"/>«عَلَتَلَ نَشَ شْنْ ﭑ مَ وٌ شَ قٍ رَ. عَ نَشَ عَ كَلِ عَ ﭑ مُ يُرُدّن عِفِرِ مَ، ﭑ مُ قَمَ سٌدٍ يِ بْشِ قَنيِ مَ وٌ مَرِفِ عَلَتَلَ نَشَن قِشِ وٌ مَ كّ رَ. <verse eid="DEU 4:21"/><verse number="22" style="v" sid="DEU 4:22"/>ﭑ تَن، ﭑ قَمَ قَشَدٍ يِ بْشِ نَن مَ. ﭑ مُ قَمَ يُرُدّن عِفِرِدٍ قٍوٌ. كْنْ وٌ تَن قَمَ نّ عَ عِفِرِدٍ، نَ بْشِ قَنيِ قِندِ وٌ فبٍ رَ. <verse eid="DEU 4:22"/><verse number="23" style="v" sid="DEU 4:23"/>وٌ شَ وٌ حّنفِ سَ وٌ يّتّ شْن مَ عَلَكٌ وٌ نَشَ نّيمُ وٌ مَرِفِ عَلَتَلَ شَ سَاتّ مَ عَ نَشَن تٌنفٌشِ وٌ بّ. وٌ نَشَ كُيٍ يٌ يَءِلَن وٌ مَرِفِ عَلَتَلَ نَشٍيٍ رَتْنشِ وٌ مَ، <verse eid="DEU 4:23"/><verse number="24" style="v" sid="DEU 4:24"/>بَرِ مَ وٌ مَرِفِ عَلَتَلَ لُمَ عَلْ تّ نَشَن سٍ كَنَمَ، عَ مُ وَ مَ عَ قِرِن بٌورٍ شْن مَ.»<verse eid="DEU 4:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="DEU 4:25"/>«وٌ نَ دِيٍ نُن مَمَدِيٍ سْتْ تّمُي نَشّ، وٌ نَ بُ كِ نَشّ بْشِ مَ، شَ وٌ كُيٍ يَءِلَن سٍ ندٍ مِسَالِ رَ، شَ وٌ قٍ حَاشِ رَبَ وٌ مَرِفِ عَلَتَلَ يَ عِ نَشَن مُ رَقَن عَ مَ، <verse eid="DEU 4:25"/><verse number="26" style="v" sid="DEU 4:26"/>كٌورٍ نُن بْشِ نَن نَ وٌن سٍيدٍ رَ تٌ لْشْي، وٌ قَمَ نّ قَشَدٍ مَقُرٍن بْشِ مَ نَشَن قَمَ قِندِدٍ وٌ فبٍ رَ يُرُدّن نَاكِرِ مَ. وٌ مُ قَمَ سِمَيَ سْتْدٍ، وٌ هَلَكِمَ نّ. <verse eid="DEU 4:26"/><verse number="27" style="v" sid="DEU 4:27"/>عَلَتَلَ وٌ رَيٍنسٍنمَ نّ حَمَنّيٍ مَ. وٌ سِ قَمَ نّ شُرُندٍ حَمَيٍ تَفِ عَلَتَلَ نَ وٌ شَنِن دّننَشّ. <verse eid="DEU 4:27"/><verse number="28" style="v" sid="DEU 4:28"/>مّننِ وٌ قَمَ كُيٍيٍ نَن بَتُدٍ، مِشِيٍ نَشٍيٍ يَءِلَنشِ وُرِ رَ، شَ نَ مُ عَ رَ فّمّ، كُيٍ نَشٍيٍ مُ نْمَ سٍ تٌدٍ، عٍ مُ قٍ مّمَ، عٍ مُ عٍ دّفٍمَ، عٍ مُ سٍ شِرِ مّمَ. <verse eid="DEU 4:28"/><verse number="29" style="v" sid="DEU 4:29"/>مّننِ وٌ قَمَ نّ وٌ مَرِفِ عَلَتَلَ قٍندٍ. وٌ عَ تٌمَ نّ شَ وٌ عَ قٍن وٌ بْحّ قَنيِ رَ، وٌ حَنِفٍ بِرِن نَ. <verse eid="DEU 4:29"/><verse number="30" style="v" sid="DEU 4:30"/>وٌ شَ تْورّ كُي نَ قٍ بِرِن وٌ لِمَ نّ. نَ تّمُي وٌ قَمَ فبِلٍندٍ وٌ مَرِفِ عَلَتَلَ مَ، وٌ عَ شُي مّمَ نّ، <verse eid="DEU 4:30"/><verse number="31" style="v" sid="DEU 4:31"/>بَرِ مَ وٌ مَرِفِ عَلَتَلَ، عَلَ نَ عَ رَ نَشَن كِنِكِنِمَ مِشِ مَ، نَشَن مُ وٌ رَبّحِنمَ، نَشَن مُ وٌ هَلَكِمَ. عَ مُ قَمَ نّيمُدٍ سَاتّ مَ عَ رَكَلِ نَشَن نَ وٌ بَبَيٍ بّ.»<verse eid="DEU 4:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="DEU 4:32"/>«وٌ وٌ مَحْشُن قٍ قٌرِيٍ مَ نَشٍيٍ بَرَ دَنفِ دُنِحَ مَ كَبِ عَلَ عَدَ مَ دَاشِ تّمُي نَشّ. قٍ كَابَنَكٌي فبّتّ قَن بَرَ رَبَ نَ شَنبِ رَ؟ ندٍ بَرَ نَ قٍ مْولِ مَنِيّ مّ سِندٍن؟ <verse eid="DEU 4:32"/><verse number="33" style="v" sid="DEU 4:33"/>حَمَ فبّتّ ندٍ نَ نَ بَ، نَشٍيٍ بَرَ عَلَ شُي مّ تّ تَفِ، عَ مَن قَ سِمَيَ سْتْ عَلْ نَشَن بَرَ رَبَ وٌ تَن بّ؟ <verse eid="DEU 4:33"/><verse number="34" style="v" sid="DEU 4:34"/>عَلَ مُندُن بَرَ حَمَ بَ حَمَ فبّتّ يِ رَ حَشَنكَتّ رَ، تْنشُمَ رَ، كَابَنَكٌي رَ، فٍرٍ بٍلٍبٍلٍ رَ، قٍ مَفَاشُشِيٍ رَ، عَلْ وٌ مَرِفِ عَلَتَلَ نَشَن نَبَ وٌ بّ مِسِرَ بْشِ مَ وٌ يَ شْرِ؟»<verse eid="DEU 4:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="DEU 4:35"/>«نَ بَرَ قِيشّ وٌ بّ عَلَكٌ وٌ شَ لَ عَ رَ عَ عَلَتَلَ كٍرٍن ثٍتِ نَن عَلَ رَ، عَلَ فبّتّ يٌ مُ نَ قٌ عَ كٍرٍن. <verse eid="DEU 4:35"/><verse number="36" style="v" sid="DEU 4:36"/>عَ نَشَ عَ شُي رَ مِنِ كٌورٍ مَ عَلَكٌ وٌ شَ فَاشُ عَ يَ رَ. عَ نَشَ تّ بٍلٍبٍلٍ مَسٍن وٌ بّ بْشِ قَرِ، عَ وْيّن وٌ بّ عَ تَفِ. <verse eid="DEU 4:36"/><verse number="37" style="v" sid="DEU 4:37"/>عَ نَشَ وٌ بَبَيٍ شَنُ، عَ نَشَ عٍ بْنسْي قَن سُفَندِ هَلِ عٍ دَنفِ شَنبِ. نَ نَن عَ تٌشِ عَ وٌ رَ مِنِشِ سّنبّ رَ مِسِرَ بْشِ مَ. <verse eid="DEU 4:37"/><verse number="38" style="v" sid="DEU 4:38"/>عَ سِيٍ كٍرِ وٌ بّ نَشٍيٍ سّنبّ فبٌ وٌ تَن بّ، عَ عٍ شَ بْشِ سٌ وٌ يِ رَ كّ رَ عَلْ وٌ عَ تٌشِ كِ نَشّ تٌ. <verse eid="DEU 4:38"/><verse number="39" style="v" sid="DEU 4:39"/>وٌ لَن نّ وٌ شَ عَ كٌلٌن تٌ لْشْي وٌ بْحّ كُي، عَ عَلَتَلَ كٍرٍن ثٍتِ نَن نَ عَلَ رَ كٌورٍ نُن بْشِ مَ. عَلَ فبّتّ مُ نَ نَ قٌ عَ كٍرٍن. <verse eid="DEU 4:39"/><verse number="40" style="v" sid="DEU 4:40"/>وٌ عَ شَ سّرِيّ نُن عَ شَ يَامَرِ رَبَتُ، ﭑ نَشَن سٌقٍ وٌ يِ رَ تٌ لْشْي، عَلَكٌ وٌ شَ هّيرِ سْتْ وٌ تَن نُن وٌ بْنسْي، هَلِ وٌ دَنفِ شَنبِ، عَلَكٌ وٌ مَن شَ سِمَيَ شْنكُيٍ سْتْ بْشِ مَ وٌ مَرِفِ عَلَتَلَ دّننَشّ قِشِ وٌ مَ عَبَدَن.»<verse eid="DEU 4:40"/></para>
  <para style="s">مِشِ رَتَنفَ تَايٍ</para>
  <para style="p">
    <verse number="41" style="v" sid="DEU 4:41"/>عَننَبِ مُنسَ نَشَ تَا سَشَن سُفَندِ يُرُدّن سٌفٍتٍدٍ بِرِ. <verse eid="DEU 4:41"/><verse number="42" style="v" sid="DEU 4:42"/>نٍيٍ نَشَ قِندِ مِشِ رَتَنفَ تَايٍ رَ قَشَتِيٍ بّ نَشٍيٍ قَشّ تِمَ، كْنْ عٍ مُ عَ حَنِفٍشِ. نَ قَشّتِ نْمَ لُدٍ يِ تَا كٍرٍن كٍرٍن نَ مَ كُي عَلَكٌ عَ نِي شَ رَتَنفَ فبٍحْشْي مَ. <verse eid="DEU 4:42"/><verse number="43" style="v" sid="DEU 4:43"/>نَ تَايٍ قِندِ بٍتٍسٍرِ نَن نَ فبٍنفبٍرٍنيِ مَ فٍيَ قَرِ، رُبٍنكَيٍ شْنيِ، رَ مٌتِ تَا نَشَن نَ فَلٍدٍ، فَدِكَيٍ شْنيِ، عَ نُن فٌلَن، تَا نَشَن نَ بَسَن بْشِ مَ مَنَسِكَيٍ شْنيِ.<verse eid="DEU 4:43"/></para>
  <para style="s">عَننَبِ مُنسَ شَ مَسٍنيِ قِرِن ندٍ</para>
  <para style="p">
    <verse number="44" style="v" sid="DEU 4:44"/>عَلَ شَ سّرِيّ نَن يَ، عَننَبِ مُنسَ نَشَن مَسٍنشِ عِسِرَيِلَكَيٍ بّ. <verse eid="DEU 4:44"/><verse number="45" style="v" sid="DEU 4:45"/>مَسٍنيِ، سّرِيّ، نُن يَامَرِ نَن يَ، عَننَبِ مُنسَ نَشَن قَلَ عِسِرَيِلَكَيٍ بّ عٍ نُ مِنِمَ مِسِرَ بْشِ رَ تّمُي نَشّ. <verse eid="DEU 4:45"/><verse number="46" style="v" sid="DEU 4:46"/>نَ تّمُي، عٍ نُ نَ يُرُدّن نَاكِرِ نَن مَ، فُلُنبَ بٍتِ ثٍيٌرِ يَ تَفِ، عَمٌرِكَيٍ شَ مَنفّ سِشْن شَ بْشِ مَ. سِشْن نُ سَبَتِشِ شّسِبْن نّ. عَننَبِ مُنسَ نُن عِسِرَيِلَكَيٍ تٌ مِنِ مِسِرَ بْشِ مَ، عٍ نَشَ نْلَ سْتْ سِشْن مَ. <verse eid="DEU 4:46"/><verse number="47" style="v" sid="DEU 4:47"/>عٍ نَشَ عَ شَ بْشِ رَ سُشُ عَ يِ رَ، عَ نُن بَسَن مَنفّ عٌفٌ شَ بْشِ. يِ عَمٌرِكَيٍ شَ مَنفّ قِرِنيِيٍ نُ نَ يُرُدّن نَاكِرِ مَ سٌفٍتٍدٍ بِرِ. <verse eid="DEU 4:47"/><verse number="48" style="v" sid="DEU 4:48"/>يِ تَايٍ نُ سِفَشِ عَرٌوٍرِ هَن عَرِنٌن شُرٍ، سِفَقٍ رَ شٍرِ مٌن فٍيَ مَ، نَشَن شِلِ سِيٌن. <verse eid="DEU 4:48"/><verse number="49" style="v" sid="DEU 4:49"/>يِ تَايٍ نَن نُ عَرَبَ بْشِ مَ يُرُدّن نَاكِرِ مَ، سٌفٍتٍدٍ بِرِ، عَ سَ دْشْ عَرَبَ بَا رَ ثِسِفَ فٍيَ بُن مَ.<verse eid="DEU 4:49"/></para>
  <chapter eid="DEU 4"/>
  <chapter number="5" style="c" sid="DEU 5"/>
  <para style="s">يَامَرِ قُ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 5:1"/>عَننَبِ مُنسَ نَشَ عِسِرَيِلَ حَمَ مَشِلِ، عَ نَشَ عَ قَلَ عٍ بّ، «عِسِرَيِلَكَيٍ، وٌ وٌ تُلِ مَتِ يِ سّرِيّ نُن يَامَرِ رَ، ﭑ نَشَن قَلَقٍ وٌ بّ تٌ لْشْي. وٌ لَن وٌ شَ عَ شَرَن، وٌ شَ قّنتّن عَ رَبَ كِ مَ. <verse eid="DEU 5:1"/><verse number="2" style="v" sid="DEU 5:2"/>وٌن مَرِفِ عَلَتَلَ بَرَ سَاتّ تٌنفٌ وٌن بّ شٌرٍبٍ فٍيَ قَرِ. <verse eid="DEU 5:2"/><verse number="3" style="v" sid="DEU 5:3"/>عَلَتَلَ نُن وٌن بَبَيٍ شَ مُ يِ سَاتّ شِرِشِ. عَ شِرِشِ وٌن تَن نَن بِرِن تَفِ، وٌن تَن نَشٍيٍ نَ سِمَيَ كُي يِ وَشَتِ. <verse eid="DEU 5:3"/><verse number="4" style="v" sid="DEU 5:4"/>عَلَتَلَ وْيّن نّ وٌن بّ يَ نُن يَ تّ تَفِ فٍيَ قَرِ. <verse eid="DEU 5:4"/><verse number="5" style="v" sid="DEU 5:5"/>نَ تّمُي ﭑ تَن نَن نُ نَ وٌ نُن عَلَتَلَ تَفِ عَلَكٌ ﭑ شَ عَلَتَلَ شَ مَسٍنيِ يَ شَرَن وٌ بّ، بَرِ مَ وٌ نُ فَاشُشِ تّ يَ رَ. وٌ مُ تٍ فٍيَ قَرِ. عَ نَشَ عَ مَسٍن وٌ بّ، <verse eid="DEU 5:5"/><verse number="6" style="v" sid="DEU 5:6"/>‹ﭑ تَن نَن نَ وٌ مَرِفِ عَلَتَلَ رَ. ﭑ تَن نَن وٌ رَ مِنِشِ مِسِرَ، وٌ نُ نَ كٌنيِيَ كُي دّننَشّ.›»<verse eid="DEU 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 5:7"/>«وٌ نَشَ عَلَ فبّتّ بَتُ قٌ ﭑ كٍرٍن.»<verse eid="DEU 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 5:8"/>«وٌ نَشَ كُيٍ يَءِلَن مِسَالِ يٌ رَ، سٍ يٌ رَ نَشٍيٍ نَ كٌورٍ نُن بْشِ مَ، نَشٍيٍ نَ يٍ بُن مَ. <verse eid="DEU 5:8"/><verse number="9" style="v" sid="DEU 5:9"/>وٌ نَشَ وٌ عِفٌرٌ عٍ بّ دٍ، وٌ نَشَ عٍ بَتُ دٍ، بَرِ مَ ﭑ تَن نَن نَ وٌ مَرِفِ عَلَتَلَ رَ، ﭑ مُ وَ مَ ﭑ قِرِن بٌورٍ شْن. شَ مِشِ ندٍ ﭑ مَتَندِ، ﭑ نَ كَنيِ حَشَنكَتَمَ نّ، عَ تَن نُن عَ بْنسْي هَن عَ سَ دْشْ عَ تٌلٌبِتّيٍ رَ، شَ نَ مُ عَ رَ عَ تٌلٌنتٌلٌنيِيٍ رَ نَشٍيٍ نَ ﭑ نَحَاشُ. <verse eid="DEU 5:9"/><verse number="10" style="v" sid="DEU 5:10"/>كْنْ ﭑ قٍ قَنيِ رَبَمَ نّ بْنسْي وُلُ بّ ﭑ نَقَن نَشٍيٍ مَ، نَشٍيٍ ﭑ مَ سّرِيّ رَبَتُمَ.»<verse eid="DEU 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="DEU 5:11"/>«وٌ نَشَ وٌ مَرِفِ عَلَتَلَ شِلِ يٍلٍقُ، بَرِ مَ عَلَتَلَ مِشِ حَشَنكَتَمَ نّ نَشَن نَ رَبَمَ.»<verse eid="DEU 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 5:12"/>«وٌ لَن نّ وٌ شَ قّنتّن مَلَبُي لْشْي مَ، وٌ شَ عَ بِنيَ عَلْ وٌ مَرِفِ عَلَتَلَ عَ يَمَرِشِ وٌ بّ كِ نَشّ. <verse eid="DEU 5:12"/><verse number="13" style="v" sid="DEU 5:13"/>شِ سٍننِ نَن نَ وٌ بّ لْشْشُنيِ كُي وَلِ لْشْييٍ رَ، وٌ شَ وَلِ بِرِن نَبَقٍ رَ. <verse eid="DEU 5:13"/><verse number="14" style="v" sid="DEU 5:14"/>عَ شِ سٌلٌقٍرٍ ندٍ قِندِشِ وٌ مَرِفِ عَلَتَلَ شَ مَلَبُي لْشْي نَن نَ. وٌ نَشَ وَلِ يٌ رَبَ نَ لْشْي كٍلِ وٌ تَن مَ، عَ سَ وٌ شَ دِيٍ لِ، وٌ شَ كٌنيِيٍ، وٌ شَ نِنفٍيٍ، وٌ شَ سٌقَلٍيٍ، وٌ شَ شُرُ سٍ مْولِ بِرِن، هَن عَ سَ وٌ شَ شْحّيٍ لِ نَشٍيٍ نَ وٌ شْنيِ، عَلَكٌ وٌ شَ كٌنيِيٍ قَن شَ عٍ مَلَبُ عَلْ وٌ تَن. <verse eid="DEU 5:14"/><verse number="15" style="v" sid="DEU 5:15"/>وٌ نَشَ نّيمُ كٌنيِ نَن نُ وٌ رَ مِسِرَ. ﭑ نَشَ وٌ رَ مِنِ نَ كٌنيِيَ كُي، عَ كٍلِ ﭑ سّنبّ مَ. ﭑ عَ قَلَشِ وٌ بّ نَ نَن مَ، وٌ شَ مَلَبُي لْشْي بِنيَ.»<verse eid="DEU 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 5:16"/>«وٌ شَ وٌ بَبَ نُن وٌ نفَ بِنيَ عَلْ وٌ مَرِفِ عَلَتَلَ عَ يَمَرِشِ وٌ بّ كِ نَشّ، عَلَكٌ وٌ شَ سِمَيَ شْنكُيٍ نُن سّيوّ سْتْ بْشِ مَ وٌ مَرِفِ عَلَتَلَ نَشَن قِمَ وٌ مَ.»<verse eid="DEU 5:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="DEU 5:17"/>«وٌ نَشَ قَشّ تِ.»<verse eid="DEU 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="DEU 5:18"/>«وٌ نَشَ يّنّ رَبَ.»<verse eid="DEU 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 5:19"/>«وٌ نَشَ مُحّ تِ.»<verse eid="DEU 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="DEU 5:20"/>«وٌ نَشَ وُلٍ سٍيدٍحْشْيَ رَبَ وٌ بٌورٍ شُن.»<verse eid="DEU 5:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="DEU 5:21"/>«وٌ نَشَ مِلَ وٌ بٌورٍ شَ فِنّ مَ، عَ شَ بَنشِ، عَ شَ شّ، عَ شَ كٌنيِ، عَ شَ نِنفٍ، عَ شَ سٌقَلٍ، نُن سٍ نَشَن بِرِن قِندِشِ عَ فبٍ رَ.»<verse eid="DEU 5:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 5:22"/>«عَلَتَلَ يِ قٍيٍ نَن مَسٍن وٌ شَ مَلَنيِ كُي، عَ شُي عِتٍشِ رَ، فٍيَ قَرِ، تّ تَفِ، نُشُي نُن كُندَ تَفِ. عَ مُ سٍسٍ سَ عَ شُن مَ. عَ نَشَ عٍ سّبّ فّمّ وَلَشّ قِرِن مَ، عَ عٍ سٌ ﭑ يِ رَ.»<verse eid="DEU 5:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="DEU 5:23"/>«وٌ يِ شُي مّ كُيٍ عِقْورّ كُي تّمُي نَشّ، تّ تَفِ، فٍيَ قَرِ، وٌ نَشَ وٌ مَسٌ ﭑ نَ، وٌ نُن وٌ شَ مَنفّيٍ نُن كُنتِفِيٍ. <verse eid="DEU 5:23"/><verse number="24" style="v" sid="DEU 5:24"/>وٌ نَشَ عَ قَلَ، ‹مُشُ مَرِفِ عَلَتَلَ بَرَ عَ شَ نْرّ نُن عَ شَ فبٌي مَسٍن مُشُ بّ. مُشُ بَرَ عَ شُي مّ وْيّن نَ تّ تَفِ. مُشُ بَرَ عَ كٌلٌن تٌ عَ عَلَ نْمَ وْيّندٍ مِشِ بّ، نَ كَنيِ مَن قَ لُ عَ مُ قَشَ. <verse eid="DEU 5:24"/><verse number="25" style="v" sid="DEU 5:25"/>يَكْسِ، مُشُ قَ مُشُ مَكْرّ مَ قَشّ رَ مُنقٍ رَ؟ يِ تّ مُشُ قَشَمَ نّ. شَ مُشُ مَن مُشُ تُلِ مَتِ وٌن مَرِفِ عَلَتَلَ شُي رَ، مُشُ قَشَمَ نّ. <verse eid="DEU 5:25"/><verse number="26" style="v" sid="DEU 5:26"/>مِشِ مُندُن لُشِ عَلْ وٌن تَن نَشَن بَرَ عَلَتَلَ شُي مّ عَ وْيّنمَ تّ تَفِ، نَ كَنيِ مَن قَ لُ عَ مُ قَشَ؟ <verse eid="DEU 5:26"/><verse number="27" style="v" sid="DEU 5:27"/>عِ تَن مُنسَ، عِ مَسٌ وٌن مَرِفِ عَلَتَلَ رَ، عِ شَ عِ تُلِ مَتِ عَ شَ مَسٍنيِ رَ، عَلَكٌ عِ شَ نَ مَدَنفِ مُشُ بّ، مُشُ مُشُ تُلِ مَتِمَ نّ عِ رَ، مُشُ مَن قَ عَ شُي رَبَتُ.›»<verse eid="DEU 5:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="DEU 5:28"/>«عَلَتَلَ نَشَ وٌ شَ وْيّنيِ مّ، وٌ نَشَن قَلَشِ ﭑ بّ. عَ نَشَ عَ مَسٍن ﭑ بّ، ‹ﭑ بَرَ حَمَ قَلَ شُي مّ. عٍ نَشَن بِرِن قَلَشِ نْندِ نَ عَ رَ. <verse eid="DEU 5:28"/><verse number="29" style="v" sid="DEU 5:29"/>شَ ﭑ مَ قٍ فَاشُي لُ عٍ بْحّ مَ تّمُي بِرِن، عٍ مَن نَشَ ﭑ مَ يَامَرِ رَبَتُ، عٍ تَن نُن عٍ بْنسْي قَمَ نّ هّيرِ سْتْدٍ عَبَدَن. <verse eid="DEU 5:29"/><verse number="30" style="v" sid="DEU 5:30"/>سِفَ عِ شَ سَ عَ قَلَ عٍ بّ، عٍ شَ سٌ عٍ شَ كِرِ بَنشِيٍ بُن مَ. <verse eid="DEU 5:30"/><verse number="31" style="v" sid="DEU 5:31"/>كْنْ عِ تَن شَ لُ ﭑ قّ مَ بٍ. ﭑ شَ ﭑ مَ سّرِيّ نُن يَامَرِ بِرِن مَسٍن عِ بّ، عِ لَن عِ شَ عٍ شَرَن نَشَن نَ، عَلَكٌ عٍ شَ نْ نَ رَحّرّدٍ بْشِ مَ ﭑ قَمَ دّننَشّ قِدٍ عٍ مَ.› <verse eid="DEU 5:31"/><verse number="32" style="v" sid="DEU 5:32"/>وٌ مَرِفِ عَلَتَلَ نَشَن مَسٍنشِ وٌ بّ، وٌ شَ وٌ تُلِ مَتِ نَ رَ، وٌ مَن شَ عَ رَبَتُ. وٌ نَشَ سِفَ كْولَ مَ، وٌ نَشَ سِفَ يِرٍقَنيِ مَ. <verse eid="DEU 5:32"/><verse number="33" style="v" sid="DEU 5:33"/>وٌ شَ بِرَ يِ كِرَ قَنيِ نَن قْشْ رَ وٌن مَرِفِ عَلَتَلَ نَشَن مَسٍنشِ، عَلَكٌ وٌ نَشَ قَشَ، وٌ قَ سِمَيَ شْنكُيٍ سْتْ سّيوّ كُي بْشِ مَ وٌ قَمَ دّننَشّ سْتْدٍ.»<verse eid="DEU 5:33"/></para>
  <chapter eid="DEU 5"/>
  <chapter number="6" style="c" sid="DEU 6"/>
  <para style="s">عَلَ شَ مَرَقَنيِ نُن عَ شَ سّرِيّ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 6:1"/>«سّرِيّ، يَامَرِ، نُن مَسٍنيِ نَن يِ كِ، وٌ مَرِفِ عَلَتَلَ نَشَن سٌشِ ﭑ يِ رَ عَلَكٌ ﭑ شَ عَ شَرَن وٌ رَ، وٌ شَ نْ عَ رَبَدٍ بْشِ مَ عَ قَقٍ نَشَن قِدٍ وٌ مَ. <verse eid="DEU 6:1"/><verse number="2" style="v" sid="DEU 6:2"/>وٌ شَ فَاشُ وٌن مَرِفِ عَلَتَلَ يَ رَ. وٌ شَ سِمَيَ كُي، وٌ تَن، وٌ شَ دِيٍ، عَ نُن وٌ شَ مَمَدِيٍ، وٌ شَ يِ سّرِيّ نُن يِ يَامَرِ بِرِن نَبَ ﭑ نَشَن سٌشِ وٌ يِ رَ، عَلَكٌ وٌ شَ سِمَيَ شْنكُيٍ سْتْ. <verse eid="DEU 6:2"/><verse number="3" style="v" sid="DEU 6:3"/>عِسِرَيِلَكَيٍ، وٌ وٌ حّنفِ سَ يِ بِرِن شْن مَ، وٌ مَن شَ قّنتّن عَ رَبَ كِ مَ. وٌ قَمَ نّ هّيرِ سْتْدٍ، وٌ قَمَ نّ قِندِدٍ حَمَ فبٍفبٍ رَ يِ بْشِ مَ شِحّ نُن كُمِ فبٍفبٍ نَ دّننَشّ، عَلْ وٌ بٍنبَيٍ مَرِفِ عَلَتَلَ عَ قَلَشِ وٌ بّ كِ نَشّ. <verse eid="DEU 6:3"/><verse number="4" style="v" sid="DEU 6:4"/>عِسِرَيِلَكَيٍ، وٌ وٌ تُلِ مَتِ. وٌن مَرِفِ عَلَتَلَ كٍرٍن ثٍتِ نَ عَ رَ. <verse eid="DEU 6:4"/><verse number="5" style="v" sid="DEU 6:5"/>وٌ لَن نّ وٌ شَ وٌ مَرِفِ عَلَتَلَ شَنُ وٌ بْحّ قِيشّشِ رَ، وٌ نِي رَ، عَ نُن وٌ سّنبّ بِرِن نَ. <verse eid="DEU 6:5"/><verse number="6" style="v" sid="DEU 6:6"/>ﭑ يِ مَسٍنيِ نَشَن شَرَنشِ وٌ بّ يِ كِ، عَ شَ لُ وٌ بْحّ مَ. <verse eid="DEU 6:6"/><verse number="7" style="v" sid="DEU 6:7"/>وٌ قَمَ نّ عَ مَبَنبَندٍ وٌ شَ دِيٍ بّ تّمُي بِرِن، شَ وٌ نَ بَنشِ كُي، شَ وٌ نَ بِيَاسِقٍ، كْي نُن يَنيِ رَ. <verse eid="DEU 6:7"/><verse number="8" style="v" sid="DEU 6:8"/>عَ شَ شِرِ وٌ بّلّشّ نُن وٌ تِفِ رَ تْنشُمَ رَ. <verse eid="DEU 6:8"/><verse number="9" style="v" sid="DEU 6:9"/>وٌ شَ عَ سّبّ وٌ شَ بَنشِ نُن وٌ شَ نَادّ مَ.»<verse eid="DEU 6:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 6:10"/>«وٌ مَرِفِ عَلَتَلَ نَ وٌ شَنِن تّمُي نَشّ بْشِ مَ عَ نَ دّننَشّ سٌقٍ وٌ يِ رَ، عَلْ عَ رَكَلِ وٌ بَبَيٍ عِبُرَهِمَ، عِسِيَفَ، عَ نُن يَشُبَ بّ كِ نَشّ، وٌ قَمَ نّ تَا بٍلٍبٍلٍ تٌقَنيِيٍ سْتْدٍ وٌ مُ نَشٍيٍ تِشِ، <verse eid="DEU 6:10"/><verse number="11" style="v" sid="DEU 6:11"/>بَنشِ رَقٍشِيٍ هَرِفٍ مْولِ بِرِن نَ وٌ مُ نَشٍيٍ قٍنشِ، كْلْنيِيٍ وٌ مُ نَشٍيٍ فٍشِ، وّنِ بِلِيٍ نُن عٌلِوِ بِلِيٍ وٌ مُ نَشٍيٍ سِشِ. <verse eid="DEU 6:11"/><verse number="12" style="v" sid="DEU 6:12"/>وٌ نَ وٌ دّفٍ هَن وٌ نَشَ وَ سَ تّمُي نَشّ، وٌ نَشَ نّيمُ وٌ مَرِفِ عَلَتَلَ مَ دٍ، نَشَن وٌ رَ مِنِشِ كٌنيِيَ كُي مِسِرَ بْشِ مَ. <verse eid="DEU 6:12"/><verse number="13" style="v" sid="DEU 6:13"/>وٌ شَ فَاشُ وٌ مَرِفِ عَلَتَلَ يَ رَ. وٌ شَ عَ كٍرٍن نَن بَتُ. وٌ شَ وٌ كَلِ عَ شِلِ نَن نَ. <verse eid="DEU 6:13"/><verse number="14" style="v" sid="DEU 6:14"/>وٌ نَشَ عَلَ فبّتّيٍ بَتُ دٍ، مِشِيٍ نَشٍيٍ بَتُمَ وٌ رَبِلِنيِ، <verse eid="DEU 6:14"/><verse number="15" style="v" sid="DEU 6:15"/>بَرِ مَ وٌ مَرِفِ عَلَتَلَ مُ وَ مَ عَ قِرِن ندٍ شْن. شَ نَ مُ عَ رَ عَ شْنْمَ نّ وٌ مَ، عَ مَن قَ وٌ قَشَ.»<verse eid="DEU 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 6:16"/>«وٌ نَشَ وٌ مَرِفِ عَلَتَلَ مَتٌ دٍ، عَلْ وٌ نَشَن نَبَ مَسَ. <verse eid="DEU 6:16"/><verse number="17" style="v" sid="DEU 6:17"/>وٌ شَ وٌ مَرِفِ عَلَتَلَ شَ سّرِيّ، عَ شَ مَسٍنيِ، نُن عَ شَ يَامَرِ رَبَتُ تِنشِنيِ كُي عَ نَشَن سٌشِ وٌ يِ رَ. <verse eid="DEU 6:17"/><verse number="18" style="v" sid="DEU 6:18"/>وٌ شَ وٌ حّرّ تِنشِنيِ كِرَ رَ. عَلَتَلَ وَ مَ قٍ نَشَن بِرِن شْن مَ، وٌ لَن وٌ شَ نَ نَن نَبَ. نَ تّمُي وٌ قَمَ نّ هّيرِ سْتْدٍ، وٌ قَ بْشِ قَنيِ سْتْ عَلَتَلَ عَ كَلِ نَشَن نَ وٌ بَبَيٍ بّ. <verse eid="DEU 6:18"/><verse number="19" style="v" sid="DEU 6:19"/>وٌ وٌ يَشُييٍ كٍرِ مَ نّ عَلْ عَلَتَلَ عَ مَسٍنشِ كِ نَشّ.»<verse eid="DEU 6:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="DEU 6:20"/>«وٌ شَ دِيٍ نَ وٌ مَشْرِن تّمُي نَشّ، ‹مُنسٍ نَ يِ مَسٍنيِ، يِ سّرِيّ، نُن يِ يَامَرِ رَ، وٌن مَرِفِ عَلَتَلَ نَشَن سٌشِ وٌن يِ رَ يِ كِ؟› <verse eid="DEU 6:20"/><verse number="21" style="v" sid="DEU 6:21"/>وٌ قَمَ نّ عٍ يَابِدٍ، ‹قِرَوُنَ شَ كٌنيِيٍ نَن نُ مُشُ رَ مِسِرَ بْشِ مَ، عَلَتَلَ قَ مُشُ رَ مِنِ نَا عَ سّنبّ رَ. <verse eid="DEU 6:21"/><verse number="22" style="v" sid="DEU 6:22"/>عَلَتَلَ نَشَ تْنشُمَ نُن كَابَنَكٌ بٍلٍبٍلٍ مَفَاشُشِيٍ رَبَ مُشُ يَ شْرِ مِسِرَكَيٍ رَ، قِرَوُنَ نُن عَ شَ دٍنبَيَ بِرِن نَ. <verse eid="DEU 6:22"/><verse number="23" style="v" sid="DEU 6:23"/>عَ مُشُ رَ مِنِ نّ مِسِرَ عَلَكٌ عَ شَ مُشُ شَنِن بْشِ مَ، عَ عَ كَلِ دّننَشّ شَ قٍ رَ وٌن بَبَيٍ بّ سٌقٍ رَ وٌن يِ رَ. <verse eid="DEU 6:23"/><verse number="24" style="v" sid="DEU 6:24"/>نَ تّمُي عَلَتَلَ نَشَ مُشُ يَامَرِ، عَ مُشُ شَ يِ سّرِيّ بِرِن نَوَلِ عَ رَوَلِ كِ مَ. شَ وٌن فَاشُ وٌن مَرِفِ عَلَتَلَ يَ رَ، عَ هّيرِ نُن سِمَيَ شْنكُيٍ قِمَ نّ وٌن مَ عَلْ عَ نَ عَ رَبَقٍ كِ نَشّ يَكْسِ. <verse eid="DEU 6:24"/><verse number="25" style="v" sid="DEU 6:25"/>شَ وٌن سَ وٌن مَرِفِ عَلَتَلَ شَ يَامَرِ بِرِن نَبَتُ عَلْ عَ مَسٍنشِ وٌن بّ كِ نَشّ، نَ قِندِ مَ نّ تِنشِنيِ رَ وٌن بّ.›»<verse eid="DEU 6:25"/></para>
  <chapter eid="DEU 6"/>
  <chapter number="7" style="c" sid="DEU 7"/>
  <para style="s">عِسِرَيِلَ نُن كَنَانكَيٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 7:1"/>«وٌ مَرِفِ عَلَتَلَ نَ وٌ شَنِن بْشِ مَ تّمُي نَشّ، عَ دّننَشّ قِمَ وٌ مَ، عَ قَمَ نّ سِ سٌلٌقٍرٍ كٍرِدٍ نَشٍيٍ قِندِ شِتِكَيٍ، فِرِفَسَكَيٍ، عَمٌرِكَيٍ، كَنَانكَيٍ، ثٍرٍ سِكَيٍ، هِوِكَيٍ نُن يٍبُسُكَيٍ رَ، سِ سٌلٌقٍرٍ نَشٍيٍ سّنبّ فبٌ وٌ بّ، عٍ مَن وُيَ وٌ بّ. <verse eid="DEU 7:1"/><verse number="2" style="v" sid="DEU 7:2"/>وٌ مَرِفِ عَلَتَلَ نَ عٍ لُ وٌ سَفٌي تّمُي نَشّ، وٌ شُتُ سْتْمَ نّ عٍ مَ، وٌ عٍ هَلَكِ. وٌ نَشَ سَاتّ شِرِ وٌ تَفِ، وٌ مَن نَشَ كِنِكِنِ عٍ مَ. <verse eid="DEU 7:2"/><verse number="3" style="v" sid="DEU 7:3"/>وٌ نُن عٍ تَن نَشَ قُتِ مَلَن دٍ. وٌ نَشَ وٌ شَ دِ فِنّيٍ قِ عٍ شَ دِ شّمّيٍ مَ، وٌ نَشَ فِنّيٍ قَن قٍن عٍ رَ وٌ شَ دِ شّمّيٍ بّ. <verse eid="DEU 7:3"/><verse number="4" style="v" sid="DEU 7:4"/>شَ نَ مُ عَ رَ يِ شْحّيٍ قَمَ نّ وٌ شَ دِيٍ رَتَنتَندٍ، عٍ شَ عَلَ فبّتّيٍ بَتُ. عَلَتَلَ شْنْمَ نّ وٌ مَ نَ تّمُي، عَ مَن قَ وٌ قَشَ مَقُرٍنيِ رَ. <verse eid="DEU 7:4"/><verse number="5" style="v" sid="DEU 7:5"/>كِرَ نَن يِ كِ وٌ لَن وٌ شَ مِنِ نَشَن نَ يِ مِشِيٍ بّ. وٌ شَ عٍ شَ سّرّشّبَدٍيٍ عَ نُن عٍ شَ فّمّ بَتُشِيٍ بِرِن كَنَ. وٌ شَ عٍ شَ عَسٍرَ وُرِ مَسٌلِشِيٍ بٌلٌن، وٌ شَ عٍ شَ كُيٍ بِرِن فَن.»<verse eid="DEU 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="DEU 7:6"/>«وٌ بَرَ قِندِ وٌ مَرِفِ عَلَتَلَ شَ حَمَ رَ. وٌ مَرِفِ عَلَتَلَ بَرَ وٌ تَن نَن سُفَندِ دُنِحَ حَمَ تَفِ بّندّ قُحِ قَرِ، عَلَكٌ وٌ شَ قِندِ عَ يّتّ يَتِ فبٍ رَ. <verse eid="DEU 7:6"/><verse number="7" style="v" sid="DEU 7:7"/>عَلَتَلَ مُ وٌ سُفَندِشِ وٌ شَ حَمَ شَسَبِ شَ قٍ شَ رَ، بَرِ مَ وٌ شُرُن سِ بِرِن بّ. <verse eid="DEU 7:7"/><verse number="8" style="v" sid="DEU 7:8"/>عَلَتَلَ وٌ تَن نَن سُفَندِشِ عَ شَ شَنُنتٍيَ شَ قٍ رَ. عَ بَرَ وَ سَاتّ رَكَمَلِقٍ عَ نَشَن تٌنفٌ وٌ بٍنبَيٍ بّ. نَ نَن عَ تٌشِ عَ وٌ رَ مِنِشِ بْشِ مَ عَ سّنبّ رَ وٌ نُ نَ كٌنيِيَ كُي دّننَشّ. عَ نَشَ وٌ بَ قِرَوُنَ يِ رَ، مِسِرَ مَنفّ. <verse eid="DEU 7:8"/><verse number="9" style="v" sid="DEU 7:9"/>وٌ شَ عَ كٌلٌن وٌ مَرِفِ عَلَتَلَ، نَن كٍرٍن ثٍتِ نَ عَلَ رَ. عَلَ قِندِشِ قٌنِسِرٍ مَنفّ نَن نَ نَشَن عَ شَ سَاتّ رَكَمَلِمَ، نَشَن هّيرِ فبٍفبٍ قِمَ وٌ مَ. عَ نَ رَبَمَ وٌ بْنسْييٍ بّ نَشٍيٍ قَمَ وٌ شَنبِ رَ، نَشٍيٍ عَ شَنُمَ، عٍ مَن عَ شَ يَامَرِيٍ رَبَتُ. <verse eid="DEU 7:9"/><verse number="10" style="v" sid="DEU 7:10"/>كْنْ عَ فبِلٍنمَ نّ مِشِيٍ قْشْ رَ نَشٍيٍ عَ شْنمَ، عَ عَ شْننَنتٍيٍ رَلْيمَ نّ كٍرٍن نَ. <verse eid="DEU 7:10"/><verse number="11" style="v" sid="DEU 7:11"/>وٌ شَ قّنتّن ﭑ مَ يَامَرِ نُن ﭑ مَ سّرِيّ مَ ﭑ نَشَن سٌشِ وٌ يِ رَ تٌ لْشْي.»<verse eid="DEU 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 7:12"/>«شَ وٌ وٌ حّنفِ سَ يِ يَامَرِ شْن مَ، وٌ نَشَ قّنتّن عَ مَ، وٌ مَرِفِ عَلَتَلَ قَمَ عَ شَ سَاتّ رَكَمَلِدٍ، عَ هّيرِ قِمَ نّ وٌ مَ عَلْ عَ رَكَلِشِ وٌ بٍنبَيٍ بّ كِ نَشّ. <verse eid="DEU 7:12"/><verse number="13" style="v" sid="DEU 7:13"/>عَ وٌ شَنُمَ نّ، عَ بَرَكّ سَ وٌ شَ قٍ، عَ مَن وٌ رَوُيَ. عَ دِ فبٍفبٍ بَرِقٍ رَفِرِ وٌ مَ. وٌ قَ بْشِ دَشَمُي قَن سْتْدٍ، مّنفِ، وّنِ نّينّ نُن تُرٍ. عَ مَن قَ وٌ شَ نِنفٍيٍ نُن وٌ شَ شُرُ سٍيٍ رَوُيَ. عَ يِ بِرِن نَبَمَ نّ بْشِ مَ، عَ رَكَلِ نَشَن نَ وٌ بَبَيٍ بّ سٌقٍ رَ وٌ يِ. <verse eid="DEU 7:13"/><verse number="14" style="v" sid="DEU 7:14"/>عَ وٌ بَرَكَمَ نّ دَنفِقٍ سِ بِرِن نَ. دِبَرِتَرٍ مُ قَمَ لُدٍ وٌ يَ مَ، شّمّ بَ، فِنّ بَ، شَ نَ مُ عَ رَ شُرُ سٍ. <verse eid="DEU 7:14"/><verse number="15" style="v" sid="DEU 7:15"/>عَلَتَلَ وٌ رَتَنفَمَ نّ قُرٍ دْشْي مْولِ بِرِن مَ، عَ نُن قٍ حَاشِ بِرِن مَ وٌ نَشٍيٍ كٌلٌنشِ مِسِرَ بْشِ مَ. كْنْ عَ يِ قُرٍ رَ سَنبَمَ مِشِيٍ نَن مَ نَشٍيٍ نَ وٌ رَحَاشُ. <verse eid="DEU 7:15"/><verse number="16" style="v" sid="DEU 7:16"/>وٌ لَن نّ وٌ شَ مِشِ بِرِن قَشَ، وٌ مَرِفِ عَلَتَلَ نَشٍيٍ سٌمَ وٌ يِ رَ. وٌ نَشَ كِنِكِنِ عٍ مَ، وٌ مَن نَشَ عٍ شَ عَلَيٍ بَتُ، عَلَكٌ عٍ نَشَ وٌ رَتَنتَن.»<verse eid="DEU 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="DEU 7:17"/>«وٌ قَمَ عَ مَحْشُندٍ وٌ بْحّ مَ، ‹يِ سِيٍ فبٌ دَنفِقٍ وٌن تَن نَ. وٌن تَن نْلَ سْتْمَ نٍيٍ مَ دِ؟› <verse eid="DEU 7:17"/><verse number="18" style="v" sid="DEU 7:18"/>كْنْ، وٌ نَشَ فَاشُ عٍ يَ رَ. وٌ شَ رَتُ وٌ مَرِفِ عَلَتَلَ نَشَن نَبَشِ قِرَوُنَ نُن مِسِرَ بْشِ رَ. <verse eid="DEU 7:18"/><verse number="19" style="v" sid="DEU 7:19"/>وٌ بَرَ قٍ شْرْشْييٍ تٌ نَشٍيٍ دْشْشِ عٍ مَ، تْنشُمَيٍ نُن كَابَنَكٌي نَشٍيٍ رَبَشِ. وٌ بَرَ وٌ مَرِفِ عَلَتَلَ سّنبّ تٌ عَ وٌ رَ مِنِ كِ نَشّ مِسِرَ بْشِ مَ. نَ نَن عَ تٌمَ وٌ مَرِفِ عَلَتَلَ نَ مْولِ رَبَمَ حَمَنّ بِرِن نَ وٌ فَاشُشِ نَشٍيٍ يَ رَ. <verse eid="DEU 7:19"/><verse number="20" style="v" sid="DEU 7:20"/>وٌ مَرِفِ عَلَتَلَ قَمَ نّ وٌ يَشُييٍ بِرِن هَلَكِدٍ، هَلِ نَشٍيٍ نْشُنمَ وٌ مَ. <verse eid="DEU 7:20"/><verse number="21" style="v" sid="DEU 7:21"/>وٌ نَشَ فَاشُ عٍ يَ رَ، بَرِ مَ وٌ نُن وٌ مَرِفِ عَلَتَلَ نَ عَ رَ، عَلَ بٍلٍبٍلٍ نَشَن مَفَاشُ.»<verse eid="DEU 7:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 7:22"/>«وٌ مَرِفِ عَلَتَلَ قَمَ نّ يِ حَمَ كٍرِدٍ عَ شُرِ شُرِ رَ وٌ يَ عِ. وٌ مُ نْمَ عٍ بِرِن قَشَدٍ وَشَتِ كٍرٍن بُن، شَ نَ مُ عَ رَ وُلَ عِ سُبٍيٍ قَمَ نّ وُيَدٍ، عٍ وٌ تْورْ. <verse eid="DEU 7:22"/><verse number="23" style="v" sid="DEU 7:23"/>وٌ مَرِفِ عَلَتَلَ قَمَ نّ يِ مِشِيٍ سٌدٍ وٌ يِ رَ. عٍ عِقُمَ نّ كِرَ مَ، هَن عٍ سَ هَلَكِ. <verse eid="DEU 7:23"/><verse number="24" style="v" sid="DEU 7:24"/>عَ قَمَ نّ عٍ شَ مَنفّيٍ سٌدٍ وٌ يِ رَ، وٌ عٍ شِلِ رَلْي. مِشِ يٌ مُ نْمَ تِدٍ وٌ كَنكٍ. وٌ عٍ بِرِن هَلَكِمَ نّ.»<verse eid="DEU 7:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="DEU 7:25"/>«وٌ عٍ شَ عَلَ يَءِلَنشِيٍ فَنمَ نّ. وٌ نَشَ مِلَ عٍ شَ شّيمَ نُن فبٍتِ مَ نَشَن نَ كُيٍيٍ مَ. وٌ نَشَ نَ قِندِ وٌ فبٍ رَ عَلَكٌ عَ نَشَ قِندِ وٌ قَن بّ فَنتَنيِ رَ، بَرِ مَ قٍ نَن نَ كِ وٌ مَرِفِ عَلَتَلَ نَشَن نَهَرَ مُشِ. <verse eid="DEU 7:25"/><verse number="26" style="v" sid="DEU 7:26"/>وٌ نَشَ نَ كُيٍ مْولِ حَاشِ رَ سٌ وٌ شَ بَنشِ كُي دٍ، عَلَكٌ وٌ نَشَ هَلَكِ عَلْ كُيٍيٍ. وٌ نٍيٍ قِندِ مَ سٍ حَاشِ نَن نَ بَرِ مَ عَ رَهَرَ مُشِ.»<verse eid="DEU 7:26"/></para>
  <chapter eid="DEU 7"/>
  <chapter number="8" style="c" sid="DEU 8"/>
  <para style="s">نّيمُقٍ عَلَتَلَ مَ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 8:1"/>«وٌ شَ يِ يَامَرِ بِرِن نَبَ ﭑ نَشَن شَرَنقٍ وٌ بّ تٌ لْشْي. نَ نَن قَمَ عَ نِيَدٍ وٌ شَ سِمَيَ سْتْ، وٌ قَ قِندِ حَمَ فبٍفبٍ رَ. نَ تّمُي، وٌ نْمَ يِ بْشِ سْتْدٍ عَلْ عَلَتَلَ عَ رَكَلِشِ وٌ بَبَيٍ بّ كِ نَشّ. <verse eid="DEU 8:1"/><verse number="2" style="v" sid="DEU 8:2"/>وٌ شَ وٌ مَحْشُن حّرّ شْنكُيٍ مَ وٌ مَرِفِ عَلَتَلَ نَشَن نَفِرِ وٌ مَ يِ فبٍنفبٍرٍنيِ عِفِرِقٍ رَ يِ حّ تٌنفٌ نَانِ بُن مَ. عَ يِ قٍ شْرْشْييٍ رَبَشِ نّ وٌ رَ، عَلَكٌ وٌ شَ وٌ يّتّ مَفٌرٌ، عَ شَ وٌ مَتٌ، عَ شَ نْ عَ كٌلٌندٍ قٍ نَشَن نَ وٌ سٌندٌنمّ مَ. عَ مَن شَ نْ عَ كٌلٌندٍ شَ وٌ وَ مَ عَ شَ سّرِيّ مَبَنبَنقٍ. <verse eid="DEU 8:2"/><verse number="3" style="v" sid="DEU 8:3"/>عَ بَرَ وٌ شَ قٍ مَفٌرٌ، عَ بَرَ وٌ رَشِ كَامّ رَ. عَ بَرَ مَنَ سٌ وٌ يِ رَ، وٌ نُن وٌ بٍنبَيٍ مُ دٌنسٍ نَشَن كٌلٌن. عَ عَ مَسٍن وٌ بّ نَ كِ نّ، عَ عِبُنَدَ مَ مُ نْمَ بَلٌدٍ دٌنسٍ شَ كَنسَن شُن نَ، كْنْ مَسٍنيِ قَن بِرِن نَ نَشَن قَتَنشِ عَلَتَلَ رَ. <verse eid="DEU 8:3"/><verse number="4" style="v" sid="DEU 8:4"/>وٌ شَ دٌنمَيٍ مُ حْنشِ، وٌ سَنيِيٍ مُ قُنتُشِ يِ حّ تٌنفٌ نَانِ بُن مَ. <verse eid="DEU 8:4"/><verse number="5" style="v" sid="DEU 8:5"/>وٌ لَن نّ وٌ شَ عَ كٌلٌن عَ وٌ مَرِفِ عَلَتَلَ نَ وٌ شُرُقٍ نّ عَلْ بَبَ عَ شَ دِ شُرُ مَ كِ نَشّ. <verse eid="DEU 8:5"/><verse number="6" style="v" sid="DEU 8:6"/>وٌ وٌ مَرِفِ عَلَتَلَ شَ يَامَرِ مَبَنبَن، وٌ شَ وٌ يّتّ سُشُ عَلْ عَ وَ مَ عَ شْن مَ كِ نَشّ، وٌ مَن شَ فَاشُ عَ يَ رَ.»<verse eid="DEU 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 8:7"/>«وٌ مَرِفِ عَلَتَلَ وٌ رَ سٌمَ نّ بْشِ قَنيِ مَ شُرٍيٍ نُن دُلٌنيِيٍ نَ دّننَشّ. يٍ فبٍفبٍ نَ نَ بْشِ بُن مَ، عَ مَن مِنِمَ فُلُنبَ نُن فٍيَ قَرِ. <verse eid="DEU 8:7"/><verse number="8" style="v" sid="DEU 8:8"/>بْشِ نَ عَ رَ مّنفِ، قُندٍنيِ مَنِيّ، وّنِ بِلِ، شْرّ، كِنكِرِنسِ، عٌلِوِ، نُن كُمِ نَ دّننَشّ. <verse eid="DEU 8:8"/><verse number="9" style="v" sid="DEU 8:9"/>تَامِ مُ حْنمَ سْنْن، سٍ بِرِن قَمَ نّ لُدٍ وٌ يِ رَ. وُرٍ قَمَ نّ مِنِدٍ فّمّيٍ كُي، وُرٍ فبٍيلِ قَن سْتْمَ نّ فٍيَ كُي.»<verse eid="DEU 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 8:10"/>«وٌ نَ وٌ دّفٍ هَن وٌ نَشَ لُفَ، وٌ شَ وٌ مَرِفِ عَلَتَلَ تَنتُ يِ بْشِ قَنيِ شَ قٍ رَ. <verse eid="DEU 8:10"/><verse number="11" style="v" sid="DEU 8:11"/>وٌ نَشَ وٌ يّتّ رَنّيمُ وٌ مَرِفِ عَلَتَلَ شَ قٍ مَ دٍ، تٌندِقٍ عَ شَ يَامَرِ نُن عَ شَ سّرِيّ رَبَتُقٍ رَ، ﭑ نَشَن شَرَنشِ وٌ بّ تٌ لْشْي. <verse eid="DEU 8:11"/><verse number="12" style="v" sid="DEU 8:12"/>وٌ نَ وٌ دّفٍ هَن وٌ نَشَ لُفَ، وٌ نَ بَنشِيٍ تِ، وٌ نَشَ سَبَتِ عٍ كُي، <verse eid="DEU 8:12"/><verse number="13" style="v" sid="DEU 8:13"/>وٌ شَ شُرُ سٍيٍ شُنفبٍ نُن عَ لَنمَيٍ نَ وُيَ، وٌ شَ فبٍتِ نُن وٌ شَ شّيمَ نَ فبٌ، وٌ هَرِفٍ بِرِن نَ فبٌ، <verse eid="DEU 8:13"/><verse number="14" style="v" sid="DEU 8:14"/>وٌ شَ قّنتّن وٌ يّتّ مَ عَ قَنيِ رَ عَلَكٌ وٌ نَشَ وٌ يّتّ عِفبٌ هَن وٌ شَ نّيمُ وٌ مَرِفِ عَلَتَلَ مَ، نَشَن وٌ رَ مِنِشِ مِسِرَ بْشِ مَ كٌنيِيَ كُي. <verse eid="DEU 8:14"/><verse number="15" style="v" sid="DEU 8:15"/>عَ بَرَ وٌ رَدَنفِ فبٍنفبٍرٍن يِرٍ مَفَاشُشِ رَ، بْشِمَسٍ شْنّ كَنيِ نُن تَلِ نَ دّننَشّ، يٍ مُ نَ بْشِ نَشَن مَ. عَ نَشَ يٍ رَ مِنِ قَنيٍ كُي. <verse eid="DEU 8:15"/><verse number="16" style="v" sid="DEU 8:16"/>عَ نَشَ مَنَ دٌنسٍ سٌ وٌ يِ رَ فبٍنفبٍرٍنيِ مَ، وٌ بٍنبَيٍ مُ نُ نَشَن كٌلٌن، عَلَكٌ عَ شَ وٌ شَ قٍ مَفٌرٌ، عَ شَ وٌ مَتٌ، عَ قَ نْ قٍ قَنيِ رَبَدٍ وٌ بّ. <verse eid="DEU 8:16"/><verse number="17" style="v" sid="DEU 8:17"/>وٌ نَشَ عَ مَحْشُن دٍ عَ وٌ سّنبّ نُن وٌ شَ كْوتَ نَن يِ هَرِفٍ قِشِ وٌ مَ. <verse eid="DEU 8:17"/><verse number="18" style="v" sid="DEU 8:18"/>وٌ شَ وٌ رَتُ وٌ مَرِفِ عَلَتَلَ مَ، عَ تَن نَن يِ سّنبّ قِمَ وٌ مَ، عَلَكٌ وٌ شَ نَ هَرِفٍ بِرِن سْتْ. عَ مَن بَرَ سَاتّ مَسٍن وٌ بّ تٌ لْشْي عَ نَشَن تٌنفٌ عَ نُن وٌ بَبَيٍ رَ.»<verse eid="DEU 8:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 8:19"/>«شَ وٌ نّيمُ وٌ مَرِفِ عَلَتَلَ مَ، شَ وٌ بِرَ عَلَ فبّتّيٍ بَتُقٍ قْشْ رَ، شَ وٌ تُوبِ عٍ بّ، شَ وٌ وٌ مَفٌرٌ عٍ بّ، ﭑ شَ عَ قَلَ وٌ بّ تٌ لْشْي، وٌ هَلَكِمَ نّ. <verse eid="DEU 8:19"/><verse number="20" style="v" sid="DEU 8:20"/>عِيٌ، وٌ هَلَكِمَ نّ عَلْ عَلَتَلَ سِ فبّتّيٍ هَلَكِشِ كِ نَشّ وٌ يَ شْرِ، بَرِ مَ وٌ مُ وٌ تُلِ مَتِشِ وٌ مَرِفِ عَلَتَلَ شَ مَسٍنيِ رَ.»<verse eid="DEU 8:20"/></para>
  <chapter eid="DEU 8"/>
  <chapter number="9" style="c" sid="DEU 9"/>
  <para style="s">عِسِرَيِلَكَيٍ عَلَ مَتَندِقٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 9:1"/>«عِسِرَيِلَكَيٍ وٌ وٌ تُلِ مَتِ. تٌ لْشْي وٌ نَ سِفَقٍ يُرُدّن نَن عِفِرِدٍ. وٌ قَمَ نّ سِيٍ رَفِدٍ نَشٍيٍ فبٌ وٌ بّ، عٍ سّنبّ دَنفِ وٌ رَ. وٌ قَ عٍ شَ تَايٍ تٌنفٌ نَشٍيٍ تّتّ عِتٍشِ هَن. <verse eid="DEU 9:1"/><verse number="2" style="v" sid="DEU 9:2"/>وٌ قَمَ عَنَكِ شَ دِيٍ نَن مَسْتْدٍ، مِشِ سّنبّمَيٍ نَشٍيٍ فبَنفبَلَن، وٌ نَشٍيٍ كٌلٌن عَ قَنيِ رَ. وٌ بَرَ عَ مّ، عٍ عَ قَلَمَ، ‹ندٍ نْمَ تِدٍ عَنَكِ شَ دِيٍ يَ عِ؟› <verse eid="DEU 9:2"/><verse number="3" style="v" sid="DEU 9:3"/>وٌ نْمَ عَ كٌلٌندٍ يَكْسِ، عَ وٌ مَرِفِ عَلَتَلَ نَ عَ حّرّقٍ وٌ يَ رَ، عَلْ تّ نَشَن سٍ بِرِن كَنَمَ. عَ تَن نَن يَتِ عٍ هَلَكِمَ، عَ عٍ شَ قٍ مَفٌرٌ وٌ يَ شْرِ. وٌ عٍ كٍرِ مَ نّ، وٌ عٍ بِرِن هَلَكِمَ نّ عَلْ وٌ مَرِفِ عَلَتَلَ عَ مَسٍنشِ وٌ بّ كِ نَشّ. <verse eid="DEU 9:3"/><verse number="4" style="v" sid="DEU 9:4"/>وٌ مَرِفِ عَلَتَلَ نَ عٍ كٍرِ وٌ يَ رَ تّمُي نَشّ، وٌ نَشَ وٌ يّتّ مَتْشْ دٍ هَن وٌ شَ عَ قَلَ، ‹عَلَتَلَ نَ عَ شّيشِ مُشُ يِ بْشِ مَسْتْشِ مُشُ شَ تِنشِنيِ سَابُي رَ.› عٍ شَ قٍ كٌبِ رَبَ نَ عَ تٌشِ عَلَتَلَ عٍ كٍرِشِ بٍينُن وٌ شَ بٍ لِ. <verse eid="DEU 9:4"/><verse number="5" style="v" sid="DEU 9:5"/>وٌ نَشَ عَ مَحْشُن دٍ عَ وٌ بٍ سْتْشِ وٌ شَ تِنشِنيِ نُن وٌ شَ قَنيِ نَن مَ. عَلَتَلَ يِ سِيٍ كٍرِ مَ عٍ شَ يُفٍ كٌبِ نَن مَ، عَ مَن شَ نَتّ رَكَمَلِ عَ نَشَن تٌنفٌ وٌ بَبَيٍ عِبُرَهِمَ، عِسِيَفَ، نُن يَشُبَ بّ. <verse eid="DEU 9:5"/><verse number="6" style="v" sid="DEU 9:6"/>وٌ شَ عَ كٌلٌن وٌ شَ تِنشِنيِ شَ مُ عَ نِيَشِ وٌ مَرِفِ عَلَتَلَ يِ بْشِ قَنيِ سٌشِ وٌ يِ رَ عَ شَ قِندِ وٌ فبٍ رَ. حَمَ شُرُتَرٍ نَن نَ وٌ رَ.»<verse eid="DEU 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 9:7"/>«وٌ شَ وٌ رَتُ عَ مَ وٌ وٌ مَرِفِ عَلَتَلَ رَشْنْ كِ نَشّ فبٍنفبٍرٍنيِ مَ. وٌ نَشَ نّيمُ وٌ كٍلِ لْشْي مَ مِسِرَ، هَن وٌ سٌ لْشْي بٍ، وٌ نُ شُرُتَرٍحَ رَبَمَ نّ وٌ مَرِفِ عَلَتَلَ رَ. <verse eid="DEU 9:7"/><verse number="8" style="v" sid="DEU 9:8"/>وٌ عَلَتَلَ رَشْنْ نّ شٌرٍبٍ فٍيَ قَرِ هَن عَ نَشَ وَ وٌ قَشَقٍ. <verse eid="DEU 9:8"/><verse number="9" style="v" sid="DEU 9:9"/>ﭑ تٌ تٍ فٍيَ قَرِ عَلَكٌ ﭑ شَ وَلَشّ فّمّ دَاشِ تٌنفٌ نَشَن قِندِ سَاتّ رَ عَلَتَلَ نُن وٌن تَن تَفِ، ﭑ نَشَ يَنيِ تٌنفٌ نَانِ نُن كْي تٌنفٌ نَانِ رَبَ فٍيَ قَرِ، ﭑ مُ تَامِ دٌن، ﭑ مُ يٍ قَن مِن. <verse eid="DEU 9:9"/><verse number="10" style="v" sid="DEU 9:10"/>عَلَتَلَ نَشَ يِ وَلَشّ فّمّ دَاشِ قِرِنيِيٍ سٌ ﭑ يِ رَ، عَ نَشَن سّبّ عَ شْنيّ رَ. عَلَتَلَ نَشَن قَلَ وٌ بّ تّ تَفِ، وٌ نُ مَلَنشِ لْشْي نَشّ فٍيَ قَرِ، نَ بِرِن سّبّشِ وَلَشّ مَ.»<verse eid="DEU 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="DEU 9:11"/>«يِ يَنيِ تٌنفٌ نَانِ نُن يِ كْي تٌنفٌ نَانِ دَنفِ شَنبِ، عَلَتَلَ نَشَ يِ وَلَشّ فّمّ دَاشِ قِرِنيِ سٌ ﭑ يِ رَ نَشَن قِندِ سَاتّ رَ. <verse eid="DEU 9:11"/><verse number="12" style="v" sid="DEU 9:12"/>عَلَتَلَ نَشَ عَ قَلَ ﭑ بّ، ‹كٍلِ، عِ شَ فٌرٌ مَقُرٍن بَرِ مَ عِ شَ حَمَ عِ نَشَن نَمِنِشِ مِسِرَ بْشِ رَ، عٍ بَرَ يَنفٌي بٍلٍبٍلٍ رَبَ، عٍ بَرَ عٍ بَ كِرَ مَ ﭑ نَشَن مَسٍن عٍ بّ، عٍ بَرَ كُيٍ يَءِلَن وُرٍ رَشُنُشِ رَ.› <verse eid="DEU 9:12"/><verse number="13" style="v" sid="DEU 9:13"/>عَلَتَلَ مَن نَشَ يِ مَسٍن ﭑ بّ، ‹ﭑ بَرَ عَ تٌ يِ حَمَ، حَمَ شُرُتَرٍ نَ عَ رَ. <verse eid="DEU 9:13"/><verse number="14" style="v" sid="DEU 9:14"/>كٍلِ بٍ، ﭑ شَ عٍ هَلَكِ، ﭑ شَ عٍ شِلِ حْن دُنِحَ مَ. ﭑ عِ مَقِندِ مَ حَمَ فبٍفبٍ رَ نَشَن سّنبّ فبٌ، عٍ مَن وُيَ، دَنفِ بٌورٍ حَمَ رَ.› <verse eid="DEU 9:14"/><verse number="15" style="v" sid="DEU 9:15"/>ﭑ نَشَ فٌرٌ فٍيَ قَرِ، نَشَن نُ لُشِ عَلْ عَ نَ تّ نَن تَفِ، نَ وَلَشّ قِرِنيِيٍ سُشُشِ ﭑ يِ رَ، عَلَ شَ سَاتّ سّبّشِ نَشٍيٍ مَ. <verse eid="DEU 9:15"/><verse number="16" style="v" sid="DEU 9:16"/>نَ تّمُي ﭑ نَشَ عَ تٌ وٌ بَرَ يُنُبِ قٍ رَبَ وٌ مَرِفِ عَلَتَلَ رَ. وٌ نِنفٍ يَءِلَن وُرٍ رَشُنُشِ رَ. وٌ وٌ بَ كِرَ مَ عَلَتَلَ نَشَن مَسٍن وٌ بّ. <verse eid="DEU 9:16"/><verse number="17" style="v" sid="DEU 9:17"/>ﭑ نَشَ يِ وَلَشّ فّمّ دَاشِ قِرِنيِيٍ سُشُ ﭑ بّلّشّ قِرِنيِ رَ، ﭑ قَ عٍ وْلّ، عٍ نَشَ عِبْو وٌ يَ شْرِ.»<verse eid="DEU 9:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="DEU 9:18"/>«ﭑ نَشَ بِرَ بْشِ عَلَتَلَ يَ عِ عَلْ ﭑ نَشَن نَبَ عَ سِنفٍ. ﭑ نَشَ لُ نَا يَنيِ تٌنفٌ نَانِ نُن كْي تٌنفٌ نَانِ، ﭑ مُ تَامِ دٌن، ﭑ مُ يٍ قَن مِن. ﭑ نَ بِرِن نَبَ وٌ شَ يُنُبِ نَن مَ قٍ رَ، نَشَن نَحَاشُشِ عَلَتَلَ مَ، عَ عَ رَشْنْ. <verse eid="DEU 9:18"/><verse number="19" style="v" sid="DEU 9:19"/>ﭑ نَشَ فَاشُ عَلَتَلَ شَ شْنّ رَ عَ شْنْشِ وٌ مَ نَشَن مَ هَن عَ وَ وٌ هَلَكِقٍ. كْنْ عَلَتَلَ مَن نَشَ ﭑ مَ مَشَندِ سُشُ. <verse eid="DEU 9:19"/><verse number="20" style="v" sid="DEU 9:20"/>عَ بْحّ نُ تٍشِ هَرُنَ نَن مَ عَ فبٍ رَ هَن عَ وَ عَ هَلَكِقٍ، كْنْ ﭑ نَشَ عَلَ مَشَندِ هَرُنَ قَن بّ. <verse eid="DEU 9:20"/><verse number="21" style="v" sid="DEU 9:21"/>ﭑ نَشَ نِنفٍ تٌنفٌ وٌ نَشَن يَءِلَنشِ، نَشَن قِندِشِ وٌ شَ يُنُبِ قٍ رَ، ﭑ عَ وٌلِ تّ شْورَ، ﭑ عَ عِوُرُ هَن عَ قِندِ شُبٍ رَ. ﭑ نَشَ نَ شُبٍ عِبَفَن سُسُي يٍ شْورَ نَشَن كٍلِمَ فٍيَ كْن نَ.»<verse eid="DEU 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 9:22"/>«وٌ مَن بَرَ عَلَتَلَ رَشْنْ تَبٍرَ، مَسَ، نُن كِبِرٌتِ هَتَاوَ. <verse eid="DEU 9:22"/><verse number="23" style="v" sid="DEU 9:23"/>عَلَتَلَ تٌ وٌ شّي كٍلِقٍ كَدٍ سِ بَرِنٍيَ يِ شّيرَيَ رَ، ‹وٌ سِفَ، وٌ شَ بْشِ تٌنفٌ ﭑ نَشَن سٌشِ وٌ يِ رَ،› وٌ نَشَ وٌ مَرِفِ عَلَتَلَ شُي مَتَندِ. وٌ مُ لَ عَ قَلَ شُي رَ، وٌ مُ نَ قَن سُشُ نْندِ رَ. <verse eid="DEU 9:23"/><verse number="24" style="v" sid="DEU 9:24"/>كَبِ ﭑ نَشَ سَ وٌ كٌلٌن، وٌ شُرُتَرٍ قٍ نَن تُن نَبَقٍ عَلَتَلَ رَ.»<verse eid="DEU 9:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="DEU 9:25"/>«عَلَتَلَ تٌ وَ وٌ قَشَقٍ، ﭑ نَشَ ﭑ قٍلٍن بْشِ مَ، ﭑ عَ مَشَندِ يَنيِ تٌنفٌ نَانِ نُن كْي تٌنفٌ نَانِ بُن مَ. <verse eid="DEU 9:25"/><verse number="26" style="v" sid="DEU 9:26"/>ﭑ نَشَ عَلَتَلَ مَشَندِ، ‹مَرِفِ عَلَتَلَ، عِ نَشَ عِ يّتّ شَ حَمَ هَلَكِ، عِ حَمَ نَشَن شَ شْرّيَ سٌشِ عَ يِ عِ شَ فبٌي سَابُي رَ، عِ نَشَن نَمِنِشِ مِسِرَ بْشِ مَ عِ سّنبّ رَ. <verse eid="DEU 9:26"/><verse number="27" style="v" sid="DEU 9:27"/>عِ رَتُ عِ شَ كٌنيِيٍ مَ، عِبُرَهِمَ، عِسِيَفَ، نُن يَشُبَ. عِ نَشَ عِ كٌبٍ رَتٌ يِ حَمَ شَ شَشِلِ شْرْشْيَ مَ، عٍ شَ حَاشُي، نُن عٍ شَ يُنُبِ مَ، <verse eid="DEU 9:27"/><verse number="28" style="v" sid="DEU 9:28"/>عَلَكٌ مِسِرَكَيٍ نَشَ عَ قَلَ، «عَلَتَلَ مُ نْمَ يِ مِشِيٍ شَنِندٍ بْشِ مَ عَ دّننَشّ لَايِدِ تٌنفٌشِ عٍ بّ. عَ عٍ شْنشِ نّ. عَ عٍ رَ مِنِ عَلَكٌ عَ شَ سَ عٍ قَشَ فبٍنفبٍرٍنيِ مَ.» › <verse eid="DEU 9:28"/><verse number="29" style="v" sid="DEU 9:29"/>عَلَتَلَ عِ شَ حَمَ نَن لَنشِ عٍ مَ. عِ فبٍ نَن نَ عٍ رَ، عِ نَشٍيٍ شْرّيَشِ عِ سّنبّ نُن عِ شَ مَنفّيَ رَ.»<verse eid="DEU 9:29"/></para>
  <chapter eid="DEU 9"/>
  <chapter number="10" style="c" sid="DEU 10"/>
  <para style="s">عَلَ شَ شَنُنتٍيَ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 10:1"/>«نَ تّمُي عَلَتَلَ نَشَ يَامَرِ قِ ﭑ مَ. عَ نَشّ، ‹وَلَشّ فّمّ دَاشِ قِرِن يَءِلَن عَلْ عَ سِنفٍيٍ نُ كِ نَشّ. عِ مَن شَ كَنكِرَ وُرِ دَاشِ يَءِلَن. نَ تّمُي عِ شَ قَ ﭑ يِرٍ فٍيَ قَرِ. <verse eid="DEU 10:1"/><verse number="2" style="v" sid="DEU 10:2"/>ﭑ مَن فبِلٍنمَ نّ يِ سّرِيّ سّبّ رَ نَشَن نُ نَ بٌورٍ وَلَشّيٍ مَ، عِ نَشٍيٍ كَنَشِ. عِ قَمَ عٍ سَدٍ نَ كَنكِرَ نَن كُي.› <verse eid="DEU 10:2"/><verse number="3" style="v" sid="DEU 10:3"/>ﭑ نَشَ كَنكِرَ يَءِلَن وُرِ مْولِ ندٍ رَ نَشَن شْرْشْ. ﭑ نَشَ وَلَشّ فّمّ دَاشِ قِرِن قَن يَءِلَن نَشَن مَنِيَ بٌورٍيٍ رَ. ﭑ نَشَ تٍ عٍ رَ فٍيَ قَرِ. <verse eid="DEU 10:3"/><verse number="4" style="v" sid="DEU 10:4"/>عَلَتَلَ نَشَ سّبّلِ تِ يِ وَلَشّ نّينّيٍ مَ، عَلْ نَشَن سِنفٍ نُ سّبّشِ بٌورٍيٍ مَ. يِ يَامَرِ قُ، عَ نَشٍيٍ يَشَرَن وٌ بّ فٍيَ قَرِ تّ تَفِ وٌ نُ مَلَنشِ تّمُي نَشّ، عَلَتَلَ نَشَ عٍ سٌ ﭑ يِ رَ. <verse eid="DEU 10:4"/><verse number="5" style="v" sid="DEU 10:5"/>ﭑ نَشَ فٌرٌ فٍيَ قَرِ، ﭑ قَ عٍ سَ كَنكِرَ كُي، ﭑ نَشَن يَءِلَنشِ. عٍ نَشَ لُ نَا عَلْ عَلَتَلَ عَ قَلَ ﭑ بّ كِ نَشّ.»<verse eid="DEU 10:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="DEU 10:6"/>عِسِرَيِلَكَيٍ نَشَ كٍلِ بٍنٍ يَكَن كْلْنيِيٍ رَ سِفَقٍ رَ مٌسٍرَ. هَرُنَ لَاشِرَ مّننِ نّ، عَ نَشَ بّندّ سْتْ نَا. عَ شَ دِ عٍلٍيَسَرِ نَشَ قِندِ عَ حْشْي رَ سّرّشّدُبّحَ كُي. <verse eid="DEU 10:6"/><verse number="7" style="v" sid="DEU 10:7"/>نَ دَنفِ شَنبِ عِسِرَيِلَكَيٍ نَشَ سِفَ فُدُفٌدَ. عٍ تٌ كٍلِ فُدُفٌدَ، عٍ نَشَ سِفَ يٌتٌبَتَ، شُرٍ فبٍفبٍ نَ بْشِ نَشَن مَ. <verse eid="DEU 10:7"/><verse number="8" style="v" sid="DEU 10:8"/>نَ وَشَتِ بُن مَ، عَلَتَلَ نَشَ وَلِ تَشُ لٍوِ بْنسْي رَ، عٍ شَ قِندِ كَنكِرَ شَنِنيِيٍ رَ، عٍ شَ تِ عَلَتَلَ يَ عِ عَ شَ وَلِ رَبَقٍ مَ، عٍ مَن شَ دُبَ حَمَ بّ عَلَتَلَ شِلِ رَ. نَ نَن نَبَقٍ هَن تٌ لْشْي. <verse eid="DEU 10:8"/><verse number="9" style="v" sid="DEU 10:9"/>نَ قٍ نَ عَ تٌشِ لٍوِ بْنسْي مُ كّ سْتْشِ عٍ نفَشَكٍرٍنيِيٍ يَ مَ. عَلَتَلَ نَن نَ عٍ تَن مَلِمَ رَ عَلْ عَ عَ قَلَ كِ نَشّ.<verse eid="DEU 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 10:10"/>«ﭑ نَشَ لُ فٍيَ قَرِ يَنيِ تٌنفٌ نَانِ نُن كْي تٌنفٌ نَانِ عَلْ ﭑ نَشَن نَبَ سِنفٍ رَ. عَلَتَلَ مَن نَشَ ﭑ مَ مَشَندِ سُشُ، بَرِ مَ عَ مُ وَشِ وٌ قَشَقٍ. <verse eid="DEU 10:10"/><verse number="11" style="v" sid="DEU 10:11"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، ‹حَمَ رَحّرّ. عٍ شَ سٌ بْشِ مَ ﭑ نَن نَكَلِشِ نَشَن نَ عٍ بَبَيٍ بّ سٌقٍ رَ عٍ يِ.›»<verse eid="DEU 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 10:12"/>«يَكْسِ قَ، عِسِرَيِلَكَيٍ وٌ مَرِفِ عَلَتَلَ وَ مَ وٌ شَ مُنسٍ رَبَ؟ عَ وَ مَ نّ وٌ شَ فَاشُ عَ يَ رَ عَلَكٌ وٌ شَ وٌ حّرّ عَ شَ كِرَ شْن مَ، وٌ شَ عَ شَنُ، وٌ شَ عَ رَبَتُ وٌ بْحّ قِيشّ نُن وٌ نِي بِرِن نَ. <verse eid="DEU 10:12"/><verse number="13" style="v" sid="DEU 10:13"/>عَلَتَلَ وَ مَ نّ وٌ شَ عَ شَ يَامَرِ رَبَ، وٌ شَ عَ شَ سّرِيّ رَبَتُ، ﭑ نَشَن سٌشِ وٌ يِ رَ تٌ لْشْي، عَلَكٌ وٌ شَ سِمَيَ شَ قَن. <verse eid="DEU 10:13"/><verse number="14" style="v" sid="DEU 10:14"/>وٌ مَرِفِ عَلَتَلَ نَن فبٍ نَ كٌورٍ نُن بْشِ رَ، عَ نُن سٍ نَشَن بِرِن نَ عَ مَ. <verse eid="DEU 10:14"/><verse number="15" style="v" sid="DEU 10:15"/>عَلَتَلَ وٌ بَبَيٍ نَن شَنُ. يَكْسِ قَ وٌ تَن نَن نَ عٍ بْنسْي رَ، عَ وٌ تَن نَن سُفَندِشِ بٌورٍ سِيٍ تَفِ، عَلْ وٌ عَ تٌشِ كِ نَشّ تٌ لْشْي.»<verse eid="DEU 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 10:16"/>«وٌ لَن نّ وٌ شَ وٌ شَشِلِ رَ سّنِيّن، وٌ نَشَ شُرُتَرٍحَ رَبَ سْنْن، <verse eid="DEU 10:16"/><verse number="17" style="v" sid="DEU 10:17"/>بَرِ مَ وٌ مَرِفِ عَلَتَلَ كٍرٍن ثٍتِ نَن نَ عَلَ رَ، مَنفّيٍ شَ مَنفّ، عَلَ بٍلٍبٍلٍ سّنبّمَ مَفَاشُشِ، نَشَن مُ مِشِ رَقِسَ عَ بٌورٍ بّ، نَشَن مُ كِيتِ حَاشِ كْبِرِ رَ سُشُمَ. <verse eid="DEU 10:17"/><verse number="18" style="v" sid="DEU 10:18"/>عَ تَن نَن كِرِدِيٍ نُن كَاحّ فِنّيٍ كَنتَمَ رَ. شْحّيٍ رَقَن عَ مَ، عَ دٌنسٍ نُن سٌسٍ سٌمَ عٍ يِ رَ. <verse eid="DEU 10:18"/><verse number="19" style="v" sid="DEU 10:19"/>وٌ تَن قَن، وٌ هِننّ شْحّيٍ رَ نَشٍيٍ نَ وٌ يَ مَ. وٌ شَ وٌ مَحْشُن شْحّ نَن نُ نَ وٌ تَن قَن نَ مِسِرَ بْشِ مَ. <verse eid="DEU 10:19"/><verse number="20" style="v" sid="DEU 10:20"/>وٌ شَ فَاشُ وٌ مَرِفِ عَلَتَلَ يَ رَ، وٌ شَ تُوبِ عَ بّ، وٌ شَ بِرَ عَ قْشْ رَ، وٌ مَن شَ وٌ رَكَلِ عَ تَن نَن شِلِ رَ. <verse eid="DEU 10:20"/><verse number="21" style="v" sid="DEU 10:21"/>عَ تَن نَن نَ وٌ شَ نْرّ رَ. عَ تَن نَن نَ وٌ مَرِفِ عَلَ رَ، نَشَن كَابَنَكٌي نُن قٍ مَفَاشُشِيٍ رَبَشِ وٌ يَ شْرِ. <verse eid="DEU 10:21"/><verse number="22" style="v" sid="DEU 10:22"/>وٌ بَبَيٍ نُ قَمَ تّمُي نَشّ مِسِرَ، عٍ مُ نُ دَنفِشِ مِشِ تٌنفٌ سٌلٌقٍرٍ رَ. يَكْسِ وٌ مَرِفِ عَلَتَلَ بَرَ وٌ رَوُيَ دَنفِ تُنبُييٍ رَ نَشٍيٍ نَ كٌورٍ مَ.»<verse eid="DEU 10:22"/></para>
  <chapter eid="DEU 10"/>
  <chapter number="11" style="c" sid="DEU 11"/>
  <para style="s">وٌن مَ شَنُنتٍيَ عَلَ بّ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 11:1"/>وٌ شَ وٌ مَرِفِ عَلَتَلَ شَنُ، وٌ تُوبِ عَ بّ، وٌ شَ عَ شَ يَامَرِ، عَ شَ سّرِيّ، عَ شَ مَسٍنيِ، نُن عَ شَ تْنيِ رَبَتُ تّمُي بِرِن.<verse eid="DEU 11:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="DEU 11:2"/>وٌ شَ عَ كٌلٌن تٌ لْشْي وٌ شَ دِيٍ مُ عَلَتَلَ شَ كَابَنَكٌ مَفَاشُشِيٍ تٌشِ عٍ يَ رَ. عٍ مُ وٌ مَرِفِ عَلَتَلَ شَ سّرِيّ مّشِ عٍ تُلِ رَ. <verse eid="DEU 11:2"/><verse number="3" style="v" sid="DEU 11:3"/>عٍ مُ عَ شَ لَامَتُنيِيٍ تٌشِ مِسِرَ، عَ نُن عَ نَشَن نَبَشِ قِرَوُنَ نُن عَ شَ بْشِ بِرِن نَ. <verse eid="DEU 11:3"/><verse number="4" style="v" sid="DEU 11:4"/>عٍ مَن مُ قٍ تٌشِ عَ نَشَن نَبَشِ مِسِرَ سْورِيٍ رَ، عٍ شَ سٌي نُن فِسٍيٍ رَ. عٍ مُ عَ تٌ عَلَ مِسِرَ سْورِيٍ مَدُلَشِ كَلٍ بَا مَ كِ نَشّ، عٍ تٌ بِرَ وٌ قْشْ رَ، عَلَتَلَ قَ عٍ بِرِن هَلَكِ كٍرٍنيِ رَ. <verse eid="DEU 11:4"/><verse number="5" style="v" sid="DEU 11:5"/>عٍ مَن مُ قٍيٍ تٌشِ عَ نَشٍيٍ رَبَ فبٍنفبٍرٍنيِ مَ بٍينُن وٌ شَ بٍ لِ. <verse eid="DEU 11:5"/><verse number="6" style="v" sid="DEU 11:6"/>عَ نَشَ وٌ رَتَنفَ دَتَن نُن عَبِرَ مِ مَ، نَشٍيٍ قِندِ عٍلِيَبِ شَ دِ شّمّيٍ رَ رُبٍن بْنسْي يَ مَ. عِسِرَيِلَكَيٍ بِرِن يَ شْرِ، بْشِ نَشَ عَ رَبِ، عَ قَ عَ رَشُتُ عٍ نُن عٍ شَ دٍنبَيَيٍ بِرِن مَ، عٍ شَ كِرِ بَنشِيٍ، نُن مِشِ بِرِن مَ نَشٍيٍ نُ بِرَشِ عٍ قْشْ رَ. <verse eid="DEU 11:6"/><verse number="7" style="v" sid="DEU 11:7"/>وٌ تَن نَن يَتِ بَرَ قٍ بٍلٍبٍلٍيٍ تٌ عَلَتَلَ نَشٍيٍ رَبَشِ.<verse eid="DEU 11:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 11:8"/>نَ نَن عَ تٌشِ، وٌ لَن وٌ شَ يِ سّرِيّ رَبَتُ ﭑ نَشَن شَرَنقٍ وٌ بّ تٌ لْشْي، عَلَكٌ وٌ شَ لِمَنِيَ سْتْ يِ بْشِ مَسْتْقٍ رَ وٌ نَ سِفَقٍ دّننَشّ. <verse eid="DEU 11:8"/><verse number="9" style="v" sid="DEU 11:9"/>وٌ شَ يِ رَبَ عَلَكٌ وٌ شَ بُ بْشِ مَ عَلَتَلَ عَ كَلِشِ نَشَن شَ قٍ رَ، عَ سٌقٍ رَ وٌ بَبَيٍ نُن عٍ بْنسْييٍ يِ، شِحّ نُن كُمِ فبٍفبٍ نَ بْشِ نَشَن مَ. <verse eid="DEU 11:9"/><verse number="10" style="v" sid="DEU 11:10"/>وٌ قَمَ بْشِ نَشَن سْتْدٍ، عَ مُ لُشِ عَلْ مِسِرَ بْشِ، وٌ كٍلِشِ دّننَشّ. مِسِرَ تَن، وٌ نَ فّ شّ سَدٍ، قٌ وٌ نُ يٍ مَشَنِن عَ مَ لَاكْي دَاشِ وٌ سَنيِ رَ. <verse eid="DEU 11:10"/><verse number="11" style="v" sid="DEU 11:11"/>وٌ قَمَ بْشِ نَشَن سْتْدٍ، فٍيَ نُن فُلُنبَ يِرٍ نَ عَ رَ، تُنّ يٍ نَشَن نَقَنمَ عَ قَنيِ رَ. <verse eid="DEU 11:11"/><verse number="12" style="v" sid="DEU 11:12"/>بْشِ نَ عَ رَ وٌ مَرِفِ عَلَتَلَ حّنفِ سَشِ نَشَن شْن. عَ مَن قَ مّينِ عَ مَ، كٍلِ حّ قْلّ هَن حّ حْنيِ.<verse eid="DEU 11:12"/></para>
  <para style="s">عَلَ شَ لَايِدِ</para>
  <para style="p">
    <verse number="13" style="v" sid="DEU 11:13"/>شَ وٌ يِ سّرِيّ رَتِنمّ عَ قَنيِ رَ ﭑ نَشَن شَرَنشِ وٌ بّ يِ كِ تٌ لْشْي، شَ وٌ وٌ مَرِفِ عَلَتَلَ شَنُ، وٌ عَ شَ سّرِيّ رَبَ بْحّ قِيشّ رَ نُن وٌ نِي رَ، <verse eid="DEU 11:13"/><verse number="14" style="v" sid="DEU 11:14"/>عَ تُنّ رَقَمَ نّ وٌ شَ بْشِ مَ، حّمّ عَ نُن سٌفٌقُرٍ، عَلَكٌ وٌ شَ هَرِفٍ قَنيِ سْتْ، عَلْ مّنفِ، وّنِ نّينّ، عَ نُن تُرٍ. <verse eid="DEU 11:14"/><verse number="15" style="v" sid="DEU 11:15"/>عَ مَن حٌوفٍ قَن نَقَنمَ نّ وٌ شَ بْشِ مَ وٌ شَ شُرُ سٍيٍ نَشَن دٌنمَ. وٌ بَلٌي فبٍفبٍ سْتْمَ نّ، وٌ عَ دٌن هَن وٌ لُفَ. <verse eid="DEU 11:15"/><verse number="16" style="v" sid="DEU 11:16"/>وٌ شَ قٍ مْولِ بِرِن نَبَ عَلَكٌ قٍقٍ يٌ نَشَ وٌ بَ يِ كِرَ قَنيِ شْن مَ. وٌ نَشَ وٌ عِفٌرٌ عَلَ فبّتّيٍ بَتُقٍ رَ. <verse eid="DEU 11:16"/><verse number="17" style="v" sid="DEU 11:17"/>شَ وٌ نَ قٍ مْولِ رَبَ، عَلَتَلَ شْنْمَ نّ وٌ مَ. نَ تّمُي عَ عَ نِيَمَ نّ تُنّ مُ قَ سْنْن، سَنسِ يٌ مُ قَنمَ بْشِ مَ سْنْن، وٌ قَ هَلَكِ يِ بْشِ مَ عَلَتَلَ نَشَن سٌشِ وٌ يِ رَ.<verse eid="DEU 11:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="DEU 11:18"/>وٌ شَ يِ سّرِيّ رَ سَبَتِ وٌ بْحّ مَ نُن وٌ نِي رَ. وٌ ندٍ شِرِ وٌ بّلّشّ نُن وٌ تِفِ رَ تْنشُمَ رَ، عَلَكٌ وٌ نَشَ نّيمُ عَ رَ. <verse eid="DEU 11:18"/><verse number="19" style="v" sid="DEU 11:19"/>وٌ شَ عَ شَرَن وٌ شَ دِيٍ رَ وٌ شَ بَنشِيٍ كُي، وٌ شَ بِيَاسِيٍ كُي، وٌ سَ تّمُي، وٌ كٍلِ تّمُي. <verse eid="DEU 11:19"/><verse number="20" style="v" sid="DEU 11:20"/>وٌ شَ عَ سّبّ وٌ شَ بَنشِيٍ نُن وٌ شَ نَادّيٍ مَ. <verse eid="DEU 11:20"/><verse number="21" style="v" sid="DEU 11:21"/>نَ نَن عَ تٌمَ وٌ شَ سِمَيَ نُن وٌ شَ دِيٍ شَ سِمَيَ شْن كُيَمَ بْشِ مَ عَلَتَلَ نَشَن لَايِدِشِ وٌ بٍنبَيٍ بّ هَن دُنِحَ رَحْنيِ. <verse eid="DEU 11:21"/><verse number="22" style="v" sid="DEU 11:22"/>شَ وٌ يِ سّرِيّ رَبَتُ عَ رَبَتُ كِ مَ، ﭑ نَشَن شَرَنشِ وٌ بّ، شَ وٌ وٌ مَرِفِ عَلَتَلَ شَنُ، شَ وٌ وٌ حّرّ عَ شَ كِرَ شْن مَ، شَ وٌ بِرَ عَ قْشْ رَ، <verse eid="DEU 11:22"/><verse number="23" style="v" sid="DEU 11:23"/>عَلَتَلَ قَمَ نّ يِ سِيٍ بِرِن كٍرِدٍ وٌ يَ شْرِ، وٌ قَ نْ عٍ رَ، نَشٍيٍ فبَنفبَلَن وٌ بّ، نَشٍيٍ سّنبّ فبٌ وٌ بّ. <verse eid="DEU 11:23"/><verse number="24" style="v" sid="DEU 11:24"/>وٌ نَ وٌ سَنيِ تِ دّننَشّ بِرِن مَ، نَا قِندِ مَ وٌ فبٍ نَن نَ. وٌ شَ بْشِ عِتَلَمَ كٍلِ فبٍنفبٍرٍنيِ مَ هَن لِبَن، كٍلِ عٍقِرَتِ شُرٍ مَ هَن مٍدِتٍرَن بَا رَ. <verse eid="DEU 11:24"/><verse number="25" style="v" sid="DEU 11:25"/>مِشِ يٌ مُ سُو سَمَ تِدٍ وٌ يَ رَ. وٌ نَ سِفَ بْشِ نَشَن يٌ مَ، وٌ مَرِفِ عَلَتَلَ عَ نِيَمَ نّ مّننِكَيٍ شَ فَاشُ وٌ يَ رَ، عٍ بْحّ مِنِ عَلْ عَ مَسٍنشِ وٌ بّ كِ نَشّ.<verse eid="DEU 11:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="DEU 11:26"/>وٌ عَ مَتٌ، ﭑ بَرَ بَرَكّ نُن دَنكّ سَ وٌ يَ عِ تٌ. <verse eid="DEU 11:26"/><verse number="27" style="v" sid="DEU 11:27"/>شَ وٌ وٌ مَرِفِ عَلَتَلَ شَ سّرِيّ رَبَتُ عَ رَبَتُ كِ مَ، ﭑ نَشَن سٌشِ وٌ يِ رَ تٌ، وٌ بَرَكّ سْتْمَ نّ. <verse eid="DEU 11:27"/><verse number="28" style="v" sid="DEU 11:28"/>كْنْ شَ وٌ مُ وٌ مَرِفِ عَلَتَلَ شَ سّرِيّ رَتِنمّ، شَ وٌ وٌ بَ كِرَ شْن مَ ﭑ نَشَن سٌشِ وٌ يِ رَ تٌ، شَ وٌ بِرَ عَلَ فبّتّيٍ قْشْ رَ وٌ مُ نَشٍيٍ كٌلٌن، وٌ دَنكّ نَن سْتْمَ.<verse eid="DEU 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="DEU 11:29"/>وٌ مَرِفِ عَلَتَلَ نَ وٌ شَنِن بْشِ مَ عَ قَمَ نَشَن سٌدٍ وٌ يِ رَ، وٌ دُبّ مَسٍنيِ تِمَ فَرِ سِمِ فٍيَ نَن قَرِ، وٌ دَنكّ مَسٍنيِ تِمَ عٍبَلِ فٍيَ نَن قَرِ. <verse eid="DEU 11:29"/><verse number="30" style="v" sid="DEU 11:30"/>نَ فٍيَيٍ نَ يُرُدّن نَاكِرِ نَن مَ، كِرَ شَنبِ رَ نَشَن نَ سٌفٍفٌرٌدٍ، كَنَانكَيٍ شَ بْشِ مَ نَشٍيٍ سَبَتِشِ عَرَبَ، فِلِفَلِ يَ تَفِ، مٌرٍ وُرِ بٍلٍبٍلٍ قّ مَ. <verse eid="DEU 11:30"/><verse number="31" style="v" sid="DEU 11:31"/>وٌ نَ يُرُدّن عِفِرِ سِفَقٍ رَ بْشِ مَ وٌ مَرِفِ عَلَتَلَ دّننَشّ سٌقٍ وٌ يِ رَ، مّننِ قِندِ مَ وٌ فبٍ نَن نَ، وٌ مَن قَ سَبَتِ نَا. <verse eid="DEU 11:31"/><verse number="32" style="v" sid="DEU 11:32"/>وٌ لَن نّ وٌ شَ قّنتّن يِ سّرِيّ نُن يِ يَامَرِيٍ مَ، ﭑ نَشٍيٍ سٌشِ وٌ يِ رَ تٌ لْشْي.<verse eid="DEU 11:32"/></para>
  <chapter eid="DEU 11"/>
  <chapter number="12" style="c" sid="DEU 12"/>
  <para style="s">سَلِ شَ سّرِيّ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 12:1"/>وٌ شَ يِ سّرِيّ نُن يَامَرِيٍ رَبَتُ بْشِ مَ، وٌ بَبَيٍ مَرِفِ عَلَتَلَ دّننَشّ سٌقٍ وٌ يِ رَ. <verse eid="DEU 12:1"/><verse number="2" style="v" sid="DEU 12:2"/>وٌ شَ يِرٍ بِرِن كَنَ فٍيَيٍ قَرِ نُن قْتْنيِيٍ كُي، يِ سِيٍ كُيٍيٍ بَتُمَ دّننَشّ. وٌ قَمَ يِ سِيٍ كٍرِدٍ. <verse eid="DEU 12:2"/><verse number="3" style="v" sid="DEU 12:3"/>وٌ شَ عٍ شَ سّرّشّبَدٍيٍ كَنَ، وٌ شَ عٍ شَ فّمّ تْنشُمَيٍ كَنَ، وٌ شَ عٍ شَ عَسٍرِ وُرِ مَسٌلِشِيٍ فَن، وٌ شَ عٍ شَ كُيٍيٍ رَبِرَ، وٌ شَ عٍ شِلِيٍ حْن نَا.<verse eid="DEU 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="DEU 12:4"/>وٌ نَشَ وٌ مَرِفِ عَلَتَلَ بَتُ نَ مْولِ رَ دٍ. <verse eid="DEU 12:4"/><verse number="5" style="v" sid="DEU 12:5"/>وٌ شَ عَلَتَلَ قٍن يِرٍ ندٍ عَ دّننَشّ سُفَندِ مَ وٌ بْنسْي يَ مَ. نَ قِندِ مَ عَلَ شَ يِرٍ نَن نَ، عَ شِلِ مَتْشْمَ دّننَشّ. وٌ شَ سِفَ مّننِ <verse eid="DEU 12:5"/><verse number="6" style="v" sid="DEU 12:6"/>وٌ شَ سّرّشّيٍ مْولِ بِرِن بَدٍ، عَلْ سّرّشّ فَن دَاشِيٍ، سّرّشّ نَشٍيٍ مُ فَنمَ، قَرِلّيٍ، هَدِيَيٍ، سّرّشّ نَشٍيٍ بَمَ عَلَكٌ وٌ وَشْنقٍ شَ رَبَ، حَنِفٍ سّرّشّيٍ، نُن شُرُ سٍ دِ سِنفٍيٍ. <verse eid="DEU 12:6"/><verse number="7" style="v" sid="DEU 12:7"/>وٌ شَ وٌ شَ سّرّشّيٍ دٌن مّننِ، وٌ تَن نُن وٌ شَ دٍنبَيَيٍ. وٌ شَ حّلّشِن هَرِفٍ رَ، وٌ مَرِفِ عَلَتَلَ نَشَن قِشِ وٌ مَ.<verse eid="DEU 12:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 12:8"/>عَ مُ لَنمَ كَنكَن شَ عَ يّتّ وَشْنقٍ رَبَ، عَلْ وٌ عَ رَبَقٍ كِ نَشّ يَكْسِ، <verse eid="DEU 12:8"/><verse number="9" style="v" sid="DEU 12:9"/>وٌ تٌ مُ سٌ بْشِ مَ، وٌ مَرِفِ عَلَتَلَ دّننَشّ قِمَ وٌ مَ مَلَبُدٍ رَ. <verse eid="DEU 12:9"/><verse number="10" style="v" sid="DEU 12:10"/>كْنْ وٌ نَ يُرُدّن عِفِرِ، وٌ نَ سَبَتِ بْشِ مَ وٌ مَرِفِ عَلَتَلَ دّننَشّ قِمَ وٌ مَ، عَ قَمَ نّ وٌ رَتَنفَدٍ وٌ يَشُييٍ بِرِن مَ نَشٍيٍ نَ وٌ رَبِلِنيِ، وٌ قَ سَبَتِ نَا بْحّسَ كُي. <verse eid="DEU 12:10"/><verse number="11" style="v" sid="DEU 12:11"/>نَ تّمُي، مّننِ قِندِ مَ وٌ مَرِفِ عَلَتَلَ شَ يِرٍ سُفَندِشِ نَن نَ، عَ شِلِ مَتْشْمَ دّننَشّ. وٌ شَ وٌ شَ سّرّشّيٍ بَ مّننِ نّ، ﭑ نَشٍيٍ يَمَرِشِ وٌ رَ، عَلْ سّرّشّ فَن دَاشِيٍ، سّرّشّ نَشٍيٍ مُ فَنمَ، قَرِلّيٍ، هَدِيَيٍ، عَ نُن سّرّشّ نَشٍيٍ بَمَ عَلَكٌ وٌ وَشْنقٍ شَ رَبَ. <verse eid="DEU 12:11"/><verse number="12" style="v" sid="DEU 12:12"/>وٌ حّلّشِنمَ نّ وٌ مَرِفِ عَلَتَلَ رَ، وٌ تَن، وٌ شَ دِيٍ، وٌ شَ كٌنيِيٍ نُن لٍوِ شَ دِيٍ نَشٍيٍ نَ وٌ يَ مَ بَرِ مَ بْشِ مُ نَ عٍ تَن بّ نَشَن قِندِ عٍ كّ رَ.<verse eid="DEU 12:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="DEU 12:13"/>وٌ نَشَ وٌ شَ سّرّشّ فَن دَاشِيٍ بَ وٌ وَشْندٍ. <verse eid="DEU 12:13"/><verse number="14" style="v" sid="DEU 12:14"/>وٌ عٍ بَمَ يِرٍ نّ وٌ مَرِفِ عَلَتَلَ دّننَشّ سُفَندِ مَ وٌ بْنسْي يَ مَ. ﭑ نَشَن بِرِن يَمَرِشِ وٌ رَ، وٌ شَ عَ بِرِن نَبَ مّننِ. <verse eid="DEU 12:14"/><verse number="15" style="v" sid="DEU 12:15"/>كْنْ عِ نْمَ سُبٍ دٌن دَاشِ قَشَدٍ، عَلَ نَشَن قِشِ عِ مَ، يِرٍ بِرِن عِ نَ سَبَتِ دّننَشّ. مِشِ سّنِيّنشِ نُن مِشِ سّنِيّنتَرٍ نْمَ عَ دٌندٍ، عَلْ شٍلِ نُن تْوكّ. <verse eid="DEU 12:15"/><verse number="16" style="v" sid="DEU 12:16"/>كْنْ وٌ مُ لَن وٌ شَ سُبٍ وُلِ مِن، وٌ شَ عَ عِقِلِ بْشِ مَ عَلْ يٍ.<verse eid="DEU 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="DEU 12:17"/>وٌ مُ لَن وٌ شَ مّنفِ، وّنِ نّينّ، نُن تُرٍ دٌن وٌ شْنيِ، نَشٍيٍ قِندِ مَ وٌ شَ قَرِلّ رَ عَلَتَلَ بّ. وٌ مُ لَن وٌ شَ وٌ شَ شُرُ سٍ دِ سِنفٍيٍ قَن دٌن وٌ شْنيِ، وٌ نَشٍيٍ بَمَ سّرّشّ رَ عَلَتَلَ بّ، سّرّشّ نَشٍيٍ بَمَ عَلَكٌ وٌ وَشْنقٍ شَ رَبَ وٌ بّ، نُن وٌ شَ حَنِفٍ سّرّشّيٍ. وٌ مُ لَن وٌ شَ وٌ شَ بٌفِ سِنفٍيٍ قَن دٌن وٌ شْنيِ، وٌ نَشٍيٍ بَمَ سّرّشّ رَ. <verse eid="DEU 12:17"/><verse number="18" style="v" sid="DEU 12:18"/>وٌ لَن وٌ شَ نَ سٍيٍ بِرِن دٌن وٌ مَرِفِ عَلَتَلَ نَن يَ عِ عَ شَ يِرٍ سُفَندِشِ كُي. وٌ تَن، وٌ شَ دِيٍ، وٌ شَ كٌنيِيٍ، عَ نُن لٍوِ شَ دِيٍ نَشٍيٍ نَ وٌ يَ مَ، وٌ شَ نَ سّرّشّيٍ دٌن مّننِ حّلّشِنيِ كُي وٌ مَرِفِ عَلَتَلَ يَ عِ، عَ نَشَن قِشِ وٌ مَ. <verse eid="DEU 12:18"/><verse number="19" style="v" sid="DEU 12:19"/>وٌ وٌ حّنفِ سَ لٍوِ شَ دِيٍ شْن مَ عَ قَنيِ رَ. وٌ نَشَ نّيمُ عٍ مَ.<verse eid="DEU 12:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="DEU 12:20"/>وٌ مَرِفِ عَلَتَلَ نَ وٌ شَ بْشِ رَفبٌ يّ، عَلْ عَ عَ لَايِدِشِ وٌ بّ كِ نَشّ، شَ وٌ وَ سُبٍ نَن شْن مَ، وٌ نْمَ نَ دٌندٍ هَن وٌ وَ سَ. <verse eid="DEU 12:20"/><verse number="21" style="v" sid="DEU 12:21"/>شَ وٌ مَكُيَ عَلَتَلَ شَ يِرٍ سُفَندِشِ رَ عَ شِلِ مَتْشْمَ دّننَشّ، وٌ نْمَ شُرُ سٍيٍ قَشَدٍ، وٌ مَرِفِ نَشٍيٍ قِشِ وٌ مَ، وٌ قَ نَ سُبٍ دٌن ﭑ مَ سّرِيّ كِ مَ وٌ شْنيِيٍ هَن وٌ وَ سَ. <verse eid="DEU 12:21"/><verse number="22" style="v" sid="DEU 12:22"/>مِشِ سّنِيّنشِ نُن مِشِ سّنِيّنتَرٍ نْمَ عٍ دٌندٍ عَلْ شٍلِ نُن تْوكّ. <verse eid="DEU 12:22"/><verse number="23" style="v" sid="DEU 12:23"/>كْنْ وٌ مُ لَن وٌ شَ سُبٍ وُلِ مِن، بَرِ مَ وُلِ قِندِشِ نِي نَن نَ. عَ مُ لَن وٌ شَ سُبٍ نُن عَ وُلِ دٌن. <verse eid="DEU 12:23"/><verse number="24" style="v" sid="DEU 12:24"/>وٌ نَشَ وُلِ مِن، وٌ شَ عَ عِقِلِ بْشِ مَ عَلْ يٍ. <verse eid="DEU 12:24"/><verse number="25" style="v" sid="DEU 12:25"/>وٌ نَشَ عَ مِن عَلَكٌ وٌ شَ سّيوَ، وٌ تَن، نُن وٌ شَ دِيٍ هَلِ وٌ دَنفِ شَنبِ. وٌ شَ قٍ تِنشِنشِيٍ رَبَ، عَلَتَلَ وَ مَ نَشٍيٍ شْن.<verse eid="DEU 12:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="DEU 12:26"/>شَ وٌ وَ مَ سّرّشّ سّنِيّنشِ نَن بَقٍ عَلَتَلَ بّ، عَلَكٌ وٌ وَشْنقٍ شَ رَبَ وٌ بّ، وٌ شَ نَ سّرّشّ بَ يِرٍ نّ عَلَتَلَ دّننَشّ سُفَندِ مَ. <verse eid="DEU 12:26"/><verse number="27" style="v" sid="DEU 12:27"/>نَشَن قِندِشِ سّرّشّ فَن دَاشِ رَ، وٌ شَ نَ سُبٍ نُن نَ وُلِ سَ وٌ مَرِفِ عَلَتَلَ شَ سّرّشّبَدٍ. نَشَن قِندِشِ سّرّشّ بٌورٍ دَاشِ رَ، وٌ شَ عَ وُلِ عِقِلِ وٌ مَرِفِ عَلَتَلَ شَ سّرّشّبَدٍ، وٌ قَ عَ سُبٍ تَن دٌن.<verse eid="DEU 12:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="DEU 12:28"/>وٌ وٌ تُلِ مَتِ، وٌ لَن نّ وٌ شَ يِ سّرِيّ رَتِنمّ ﭑ نَشَن سٌشِ وٌ يِ رَ، عَلَكٌ وٌ شَ سّيوَ، وٌ تَن نُن وٌ شَ دِيٍ هَلِ وٌ قَشَ شَنبِ عَبَدَن، بَرِ مَ قٍ قَنيِ نَ عَ رَ نَشَن نَقَن وٌ مَرِفِ عَلَتَلَ مَ.<verse eid="DEU 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="DEU 12:29"/>وٌ مَرِفِ عَلَتَلَ نَ فّ سِيٍ هَلَكِدٍ وٌ سَابُي رَ، وٌ نَ سَبَتِ عٍ شَ بْشِ مَ، <verse eid="DEU 12:29"/><verse number="30" style="v" sid="DEU 12:30"/>وٌ شَ وٌ يّتّ رَتَنفَ عٍ شَ قٍ كٌبِ رَبَقٍ مَ، عٍ هَلَكِ شَنبِ. وٌ شَ وٌ يّتّ رَتَنفَ عٍ شَ عَلَيٍ مَشْرِنقٍ مَ. وٌ نَشَ عَ قَلَ، «يِ سِيٍ نُ تُوبِ رَبِرَ مَ عٍ بّ دِ؟ ﭑ قَن وَشِ نَ نَن نَبَقٍ.» <verse eid="DEU 12:30"/><verse number="31" style="v" sid="DEU 12:31"/>وٌ نَشَ نَ مْولِ رَبَ وٌ مَرِفِ عَلَتَلَ رَ، بَرِ مَ عٍ نُ قٍ كٌبِيٍ رَبَمَ عٍ شَ عَلَيٍ بّ عَلَتَلَ مُ وَ مَ نَشٍيٍ شْن. مِشِ نَن نُ عٍ رَ، نَشٍيٍ نُ عٍ شَ دِيٍ فَنمَ عٍ شَ كُيٍيٍ بّ سّرّشّ رَ.<verse eid="DEU 12:31"/></para>
  <chapter eid="DEU 12"/>
  <chapter number="13" style="c" sid="DEU 13"/>
  <para style="s">كُيٍ بَتُيٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 13:1"/>وٌ لَن نّ وٌ شَ يِ سّرِيّ رَبَ عَ رَبَ كِ مَ ﭑ نَشَن سٌشِ وٌ يِ رَ. وٌ نَشَ سٍسٍ بَ عَ رَ، وٌ مَن نَشَ سٍسٍ قَن سَ عَ شُن مَ. <verse eid="DEU 13:1"/><verse number="2" style="v" sid="DEU 13:2"/>شَ نَمِحْنمّ ندٍ، شَ نَ مُ عَ رَ وَلِيُ ندٍ، <verse eid="DEU 13:2"/><verse number="3" style="v" sid="DEU 13:3"/>سَ كَابَنَكٌي قٍ نُن تْنشُمَ قٍ رَبَ وٌ يَ شْرِ، عَ مَن قَ عَ قَلَ وٌ بّ، «وٌن بِرَ كُيٍ بَتُقٍ قْشْ رَ، وٌ تَن مُ عَلَيٍ نَشٍيٍ كٌلٌن،» <verse eid="DEU 13:3"/><verse number="4" style="v" sid="DEU 13:4"/>وٌ نَشَ وٌ تُلِ مَتِ نَ نَمِحْنمّ رَ عَ نُن نَ وَلِيُ رَ دٍ. وٌ مَرِفِ عَلَتَلَ نَن قَمَ وٌ مَتٌدٍ نَ كِ، عَلَكٌ عَ شَ نْ عَ كٌلٌندٍ شَ عَ شَ شَنُنتٍيَ نَ وٌ سٌندٌنمّ مَ، شَ وٌ عَ شَنُشِ وٌ نِي رَ. <verse eid="DEU 13:4"/><verse number="5" style="v" sid="DEU 13:5"/>وٌ لَن وٌ شَ تُوبِ رَبِرَ وٌ مَرِفِ عَلَتَلَ نَن كٍرٍن بّ، وٌ شَ فَاشُ عَ يَ رَ، وٌ شَ عَ شَ يَامَرِيٍ رَبَ، وٌ شَ عَ شُي رَبَتُ، وٌ شَ عَ كٍرٍن نَن بَتُ، وٌ شَ بِرَ عَ قْشْ رَ. <verse eid="DEU 13:5"/><verse number="6" style="v" sid="DEU 13:6"/>يِ نَمِحْنمّ نُن يِ وَلِيُ مْولِ لَن نّ عَ شَ قَشَ، بَرِ مَ عَ بَرَ وَ وٌ بْحّ رَتٍقٍ وٌ مَرِفِ عَلَتَلَ مَ نَشَن وٌ رَ مِنِشِ كٌنيِيَ كُي مِسِرَ بْشِ مَ. عٍ بَرَ وٌ بَ كِرَ شْن عَلَتَلَ وٌ تِشِ نَشَن نَ. وٌ شَ قٍ حَاشِ حْن وٌ تَفِ.<verse eid="DEU 13:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 13:7"/>شَ وٌ نفَشَكٍرٍنيِ، شَ نَ مُ عَ رَ وٌ شَ دِ، شَ نَ مُ عَ رَ وٌ شَ بَاتّ فِنّ، شَ نَ مُ عَ رَ وٌ بٌورٍ نَشَن نَقَنشِ وٌ مَ عَلْ وٌ يّتّ، سَ وٌ مَنَهَنّ عَلَكٌ وٌ شَ عَلَ فبّتّ بَتُ، وٌ تَن مُ نَشَن كٌلٌن، وٌ بَبَيٍ قَن مُ نَشَن كٌلٌن، <verse eid="DEU 13:7"/><verse number="8" style="v" sid="DEU 13:8"/>سِ فبّتّيٍ نَشٍيٍ بَتُشِ وٌ رَبِلِنيِ نُن نَشٍيٍ مَكُيَ وٌ رَ، كٍلِ بْشِ تُشُي مَ سَ دْشْ بٌورٍ تُشُي رَ، <verse eid="DEU 13:8"/><verse number="9" style="v" sid="DEU 13:9"/>وٌ نَشَ تِن عٍ شَ وْيّنيِ رَ، وٌ نَشَ وٌ تُلِ مَتِ عٍ رَ. وٌ نَشَ كِنِكِنِ عٍ مَ، وٌ نَشَ عٍ نْشُن، وٌ مَن نَشَ عٍ كَنتَ. <verse eid="DEU 13:9"/><verse number="10" style="v" sid="DEU 13:10"/>وٌ لَن نّ وٌ شَ نَ كَنيِ قَشَ، وٌ عَ فْنْ فّمّ رَ، حَمَ قَن قَ عَ مَفْنْ. <verse eid="DEU 13:10"/><verse number="11" style="v" sid="DEU 13:11"/>وٌ شَ عَ مَفْنْ هَن عَ شَ قَشَ، بَرِ مَ عَ بَرَ كَتَ عَ شَ وٌ رَفبِلٍن وٌ مَرِفِ عَلَتَلَ قْشْ رَ نَشَن وٌ رَ مِنِشِ كٌنيِيَ كُي مِسِرَ بْشِ مَ. <verse eid="DEU 13:11"/><verse number="12" style="v" sid="DEU 13:12"/>عِسِرَيِلَكَيٍ بِرِن نَ نَ قٍ مّ، عٍ لُمَ نّ فَاشُي كُي. نَ تّمُي نَ قٍ كٌبِ مْولِ مُ نْمَ رَبَدٍ وٌ تَفِ سْنْن.<verse eid="DEU 13:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="DEU 13:13"/>شَ وٌ عَ مّ تَا ندٍ شَ قٍ رَ، وٌ مَرِفِ عَلَتَلَ وٌ رَ سَبَتِمَ دّننَشّ، <verse eid="DEU 13:13"/><verse number="14" style="v" sid="DEU 13:14"/>عَ مّننِكَ ندٍيٍ عَ قَلَمَ عٍ بٌورٍيٍ بّ، «وٌن شَ كُيٍ نّينّ ندٍيٍ بَتُ،» <verse eid="DEU 13:14"/><verse number="15" style="v" sid="DEU 13:15"/>عَ لَنمَ وٌ شَ نَ مِشِ كٌبِيٍ شْن نَقٍن عَلَكٌ وٌ شَ عٍ كّحَ كٌلٌن. وٌ شَ عَ كٌلٌن شَ نَ قٍ كٌبِ بَرَ رَبَ وٌ تَفِ. <verse eid="DEU 13:15"/><verse number="16" style="v" sid="DEU 13:16"/>شَ عَ سَ نَ كِ نّ، وٌ شَ نَ تَاكَيٍ بِرِن قَشَ سَنتِدّفّمَ رَ. وٌ شَ نَ تَا هَلَكِ نُن عَ شَ شُرُ سٍيٍ بِرِن نَ. <verse eid="DEU 13:16"/><verse number="17" style="v" sid="DEU 13:17"/>وٌ عٍ هَرِفٍ بِرِن مَلَنمَ تَا تَفِ نّ، وٌ تّ سَ عَ مَ، وٌ تَا بِرِن فَن وٌ مَرِفِ عَلَتَلَ يَ عِ. نَا قَمَ قِندِدٍ بْشِ رَبّحِنشِ نَن نَ. مّننِ تَن مُ قِندِ مَ تَا رَ سْنْن. <verse eid="DEU 13:17"/><verse number="18" style="v" sid="DEU 13:18"/>وٌ نَشَ نَ سٍ رَتْنشِ سٍسٍ تٌنفٌ وٌ يّتّ بّ، وٌ نَ نَشَن فَنقٍ عَلَكٌ ندٍ شَ بَ عَلَتَلَ شَ شْنّ رَ، عَ شَ كِنِكِنِ وٌ مَ، عَ شَ وٌ رَوُيَ عَلْ عَ رَكَلِشِ كِ نَشّ وٌ بَبَيٍ بّ. <verse eid="DEU 13:18"/><verse number="19" style="v" sid="DEU 13:19"/>شَ وٌ تُوبِ رَبِرَ وٌ مَرِفِ عَلَتَلَ بّ عَ شَ سّرِيّ رَبَتُقٍ مَ، ﭑ نَشَن سٌشِ وٌ يِ رَ تٌ لْشْي، شَ وٌ قٍ تِنشِنشِ رَبَ وٌ مَرِفِ عَلَتَلَ يَ عِ، عَ قَمَ نّ نَ هّيرِ بِرِن قِدٍ وٌ مَ.<verse eid="DEU 13:19"/></para>
  <chapter eid="DEU 13"/>
  <chapter number="14" style="c" sid="DEU 14"/>
  <para style="s">حْنقٍ سّرِيّ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 14:1"/>مَرِفِ عَلَتَلَ شَ دِيٍ لَنشِ وٌ تَن نَن مَ. شَ قَشّ قَ سَ تِ، وٌ نَشَ وٌ يّتّ مَشَبَ، وٌ نَشَ وٌ شُنسّشّ بِ وٌ تِفِ دّ رَ. <verse eid="DEU 14:1"/><verse number="2" style="v" sid="DEU 14:2"/>وٌ بَرَ قِندِ وٌ مَرِفِ عَلَتَلَ شَ حَمَ سّنِيّنشِ رَ. عَ وٌ تَن نَن سُفَندِشِ بْشِ حَمَ بِرِن تَفِ، وٌ شَ قِندِ عَ فبٍ رَ.<verse eid="DEU 14:2"/></para>
  <para style="s">سُبٍ رَدَشَمُشِ نُن عَ رَدَشَمُتَرٍ</para>
  <para style="p">
    <verse number="3" style="v" sid="DEU 14:3"/>وٌ مُ لَن وٌ شَ سٍ سّنِيّنتَرٍ دٌن. <verse eid="DEU 14:3"/><verse number="4" style="v" sid="DEU 14:4"/>سُبٍيٍ نَن يِ كِ، وٌ لَن وٌ شَ نَشٍيٍ دٌن؛ نِنفٍ، يّشّي، سِ، <verse eid="DEU 14:4"/><verse number="5" style="v" sid="DEU 14:5"/>شٍلِ، فَالٍ، تْوكّ، مُنتُي، بُرُنيِ سِ، فٍيَ قَرِ سُبٍ نَشَن مَنِيَشِ يّشّي رَ، بٌلٍ، <verse eid="DEU 14:5"/><verse number="6" style="v" sid="DEU 14:6"/>سُبٍ نَشٍيٍ تٌرٍ عِتَشُنشِ، عٍ مَن نَ حٌوفٍ دٌن، عٍ فبِلٍن عَ رَتٍ رَ عٍ كْن نَ.<verse eid="DEU 14:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 14:7"/>كْنْ نَ سُبٍيٍ يَ مَ، نَشٍيٍ تٌرٍ عِتَشُنشِ قِرِنيِ رَ، نَشٍيٍ حٌوفٍ دٌنمَ، عٍ مَن قَ فبِلٍن عَ رَتٍ رَ عٍ كْن نَ، ندٍيٍ نَ عٍ يَ مَ وٌ نَشَ عٍ دٌن عَلْ حْشْمّ، يٍرٍ، نُن يٍرٍ مَنِيّ. عٍ قِندِشِ سُبٍ سّنِيّنتَرٍيٍ نَن نَ وٌ بّ، بَرِ مَ عٍ حٌوفٍ دٌنمَ، عٍ مَن قَ فبِلٍن عَ رَتٍ رَ عٍ كْن نَ، كْنْ عٍ تٌرٍ مُ عِتَشُنشِ قِرِنيِ رَ. <verse eid="DEU 14:7"/><verse number="8" style="v" sid="DEU 14:8"/>شْسّ نَشَن تٌرٍ عِتَشُنشِ قِرِنيِ رَ، كْنْ عَ مُ حٌوفٍ دٌنمَ، عَ مَن شَ فبِلٍن عَ رَتٍ رَ عَ كْن نَ، نَ نَن عَ قِندِشِ سُبٍ سّنِيّنتَرٍ رَ وٌ بّ. وٌ نَشَ نَ سُبٍ دٌن، وٌ مَن نَشَ وٌ بّلّشّ دِن عَ بِنبِ رَ.<verse eid="DEU 14:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 14:9"/>يّشّ نَشٍيٍ نَ يٍ شْورَ، بّلّيٍ نَ نَشٍيٍ بِرِن بّ عَ نُن شَلٍيٍ، وٌ لَن وٌ شَ نٍيٍ نَن دٌن. <verse eid="DEU 14:9"/><verse number="10" style="v" sid="DEU 14:10"/>كْنْ وٌ مُ لَن وٌ شَ يّشّ دٌن بّلّ مُ نَشَن بّ عَ نُن شَلٍ. وٌ شَ نٍيٍ كٌلٌن يّشّ سّنِيّنتَرٍ رَ.<verse eid="DEU 14:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="DEU 14:11"/>وٌ نْمَ شْنِ سّنِيّنشِ بِرِن دٌندٍ. <verse eid="DEU 14:11"/><verse number="12" style="v" sid="DEU 14:12"/>كْنْ شْنِيٍ شِلِيٍ نَن يِ كِ وٌ مُ لَن وٌ شَ نَشٍيٍ دٌن؛ يُبّ، سّفّ، شَرُ مَ فبْنتْي، <verse eid="DEU 14:12"/><verse number="13" style="v" sid="DEU 14:13"/>عَ نُن عٍ مَنِيّ بِرِن. <verse eid="DEU 14:13"/><verse number="14" style="v" sid="DEU 14:14"/>شَاشَ قَن وٌ نَشَ نَ دٌن عَ نُن عَ مَنِيّ بِرِن. <verse eid="DEU 14:14"/><verse number="15" style="v" sid="DEU 14:15"/>شُندِ، كٌوقٌلٍ، عَ نُن تَفَرَنتٌنفٌي، <verse eid="DEU 14:15"/><verse number="16" style="v" sid="DEU 14:16"/>وٌ نَشَ عٍ دٌن عَ نُن عٍ مَنِيّ بِرِن. <verse eid="DEU 14:16"/><verse number="17" style="v" sid="DEU 14:17"/>فبْنفبٌي، يٍدْنمّ، <verse eid="DEU 14:17"/><verse number="18" style="v" sid="DEU 14:18"/>لَابَ، تُكّ، عَ نُن عٍ مَنِيّ بِرِن، وٌ نَشَ عٍ دٌن. <verse eid="DEU 14:18"/><verse number="19" style="v" sid="DEU 14:19"/>نِمَسٍ شُنشُرِ فَبُتٍنيِ كَنيِ بِرِن رَهَرَ مُحَشِ. وٌ مُ لَن وٌ شَ عٍ دٌن. <verse eid="DEU 14:19"/><verse number="20" style="v" sid="DEU 14:20"/>وٌ لَن وٌ شَ نِمَسٍيٍ نَن دٌن نَشٍيٍ سّنِيّنشِ.<verse eid="DEU 14:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="DEU 14:21"/>وٌ نَشَ سُبٍ دٌن نَشَن قَشَشِ عَ يّتّ مَ. وٌ شَ عَ سٌ شْحّ عَلَ كٌلٌنتَرٍيٍ يِ رَ، نَشٍيٍ نَ وٌ شْنيِ، عَلَكٌ عٍ شَ عَ دٌن، شَ نَ مُ وٌ شَ عَ مَتِ مِشِ فبّتّيٍ مَ. وٌ تَن بَرَ قِندِ وٌ مَرِفِ عَلَتَلَ شَ حَمَ سّنِيّنشِ رَ.</para>
  <para style="p" vid="DEU 14:21">وٌ نَشَ سِ يْرّ حِن عَ نفَ شِحّ يٍ رَ.<verse eid="DEU 14:21"/></para>
  <para style="s">قَرِلّ</para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 14:22"/>وٌ سَنسِ نَشَن بِرِن نَوَلِمَ شّ مَ، وٌ لَن نّ وٌ شَ قَرِلّ بَ عَ رَ حّ يٌ حّ. <verse eid="DEU 14:22"/><verse number="23" style="v" sid="DEU 14:23"/>وٌ شَ نَ قَرِلّ دٌن يِرٍ وٌ مَرِفِ عَلَتَلَ شِلِ مَتْشْمَ دّننَشّ. وٌ شَ قَرِلّ قِندِ مَ وٌ شَ مّنفِ، وٌ شَ وّنِ نّينّ، وٌ شَ تُرٍ، وٌ شَ شُرُ سٍيٍ شَ دِ سِنفٍيٍ نَن نَ. وٌ شَ نَ بَ عَلَكٌ وٌ نْمَ فَاشُدٍ وٌ مَرِفِ عَلَتَلَ يَ رَ كِ نَشّ لْشْي بِرِن. <verse eid="DEU 14:23"/><verse number="24" style="v" sid="DEU 14:24"/>شَ عَ سَ لِ وٌ سَبَتِدٍ مَكُيَ وٌ مَرِفِ عَلَتَلَ شِلِ مَتْشْدٍ رَ، نَ كٌتٍ شَنِنقٍ شْرْشْمَ نّ وٌ بّ، بَرِ مَ وٌ مَرِفِ عَلَتَلَ بَرَ بَرَكّ فبٍفبٍ قِ وٌ مَ. <verse eid="DEU 14:24"/><verse number="25" style="v" sid="DEU 14:25"/>نَ تّمُي وٌ شَ وٌ شَ قَرِلّ مَسَرَ كْبِرِ رَ، وٌ قَ نَ شَنِن وٌ مَرِفِ عَلَتَلَ شِلِ مَتْشْدٍ. <verse eid="DEU 14:25"/><verse number="26" style="v" sid="DEU 14:26"/>مّننِ وٌ نْمَ شُرُ سٍيٍ، وّنِ، نُن وٌ وَشْنسٍ فبّتّ سَرَدٍ، عَلَكٌ وٌ نُن وٌ شَ دٍنبَيَيٍ شَ وٌ دّفٍ وٌ مَرِفِ عَلَتَلَ يَ عِ سّيوّ كُي. <verse eid="DEU 14:26"/><verse number="27" style="v" sid="DEU 14:27"/>وٌ نَشَ نّيمُ لٍوِكَيٍ مَ نَشٍيٍ سَبَتِشِ وٌ يَ مَ، بَرِ مَ سٍ مُ نَ عٍ بّ نَشَن قِندِ مَ عٍ كّ رَ.<verse eid="DEU 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="DEU 14:28"/>حّ سَشَن يٌ حّ سَشَن وٌ شَ وٌ شَ سَنسِ قَرِلّ بِرِن نَفَتَ وٌ شْنيِ. <verse eid="DEU 14:28"/><verse number="29" style="v" sid="DEU 14:29"/>نَ تّمُي لٍوِكَيٍ، كّ مُ نَ نَشٍيٍ بّ، وٌ شَ شْحّيٍ، كِرِدِيٍ، عَ نُن كَاحّ فِنّ نَشٍيٍ نَ وٌ يَ مَ، عٍ بِرِن شَ قَ عٍ دّفٍدٍ وٌ شْنيِ هَن عٍ لُفَ. نَ كُي وٌ مَرِفِ عَلَتَلَ قَمَ بَرَكّ سَدٍ وٌ شَ قٍ بِرِن مَ.<verse eid="DEU 14:29"/></para>
  <chapter eid="DEU 14"/>
  <chapter number="15" style="c" sid="DEU 15"/>
  <para style="s">دِحّقٍ دٌنِ مَ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 15:1"/>حّ سٌلٌقٍرٍ يٌ حّ سٌلٌقٍرٍ وٌ شَ دِحّ دٌنِيٍ مَ. <verse eid="DEU 15:1"/><verse number="2" style="v" sid="DEU 15:2"/>نَ سّرِيّ لَن عَ شَ رَبَ يِ كِ نّ؛ قّيرّ كَنيِيٍ نَشٍيٍ بِرِن دٌنِ بّحِنشِ عٍ نفَشَكٍرٍنيِ بّ، عٍ لَن نّ عٍ شَ دِحّ نَ دٌنِ مَ. وٌ مُ لَن وٌ شَ وٌ بٌورٍ نُن وٌ نفَشَكٍرٍنيِ حَشَنكَتَ دٌنِ قِقٍ مَ حّ كُي عَلَتَلَ نَشَن سُفَندِشِ. <verse eid="DEU 15:2"/><verse number="3" style="v" sid="DEU 15:3"/>وٌ لَن وٌ شَ دْشْ عَلَ كٌلٌنتَرٍ نَن نَ عَ شَ وٌ شَ دٌنِ قِ، كْنْ وٌ نَشَن دٌنِشِ وٌ نفَشَكٍرٍنيِ بّ، وٌ لَن نّ وٌ شَ دِحّ نَ مَ. <verse eid="DEU 15:3"/><verse number="4" style="v" sid="DEU 15:4"/>نَ نَن عَ تٌمَ سٍتَرٍ مُ كٌلٌنمَ وٌ يَ مَ، بَرِ مَ عَلَتَلَ بَرَكّ فبٍفبٍ سَمَ نّ وٌ شَ قٍ بْشِ مَ وٌ مَرِفِ عَلَتَلَ دّننَشّ سٌشِ وٌ يِ رَ كّ رَ، عَلَكٌ عَ شَ قِندِ وٌ فبٍ رَ. <verse eid="DEU 15:4"/><verse number="5" style="v" sid="DEU 15:5"/>عَ نَ رَبَمَ نّ شَ وٌ بِرَ وٌ مَرِفِ عَلَتَلَ شُي قْشْ رَ. وٌ شَ عَ شَ يَامَرِ رَبَتُ، ﭑ نَشَن قَلَشِ وٌ بّ تٌ لْشْي. <verse eid="DEU 15:5"/><verse number="6" style="v" sid="DEU 15:6"/>وٌ مَرِفِ عَلَتَلَ بَرَكّ سَمَ نّ وٌ شَ قٍ عَلْ عَ مَسٍن كِ نَشّ. وٌ كْبِرِ دٌنِمَ نّ حَمَ فبٍفبٍ بّ، كْنْ وٌ تَن مُ دٌنِ تٌنفٌمَ. وٌ قَمَ نّ دَنفِدٍ حَمَ فبٍفبٍ رَ، مِشِ يٌ مُ دَنفِمَ وٌ رَ.<verse eid="DEU 15:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 15:7"/>شَ سٍتَرٍ نَ وٌ نفَشَكٍرٍنيِيٍ يَ مَ وٌ نُن نَشٍيٍ سَبَتِشِ بْشِ كٍرٍن مَ وٌ مَرِفِ عَلَتَلَ دّننَشّ قِمَ وٌ مَ، وٌ نَشَ وٌ نِي رَشُتُ، وٌ شَ تٌندِ دٌنِ بّحِندٍ عٍ بّ. <verse eid="DEU 15:7"/><verse number="8" style="v" sid="DEU 15:8"/>وٌ لَنمَ نّ وٌ شَ عَ دٌنِ سّيوّ كُي عَ هَيِ نَ نَشَن مَ. <verse eid="DEU 15:8"/><verse number="9" style="v" sid="DEU 15:9"/>وٌ شَ وٌ مّينِ كِ قَنيِ رَ، شَشِلِ حَاشِ نَشَ نْ وٌ رَ عَ قَلَقٍ رَ، «عَ فبٍ مُ لُشِ حّ سٌلٌقٍرٍ ندٍ شَ عَ لِ، عَ لَن مِشِ شَ دِحّ دٌنِ مَ حّ نَشَن نَ.» وٌ شَ وٌ مّينِ، وٌ نَشَ كِنِكِنِتَرٍحَ مَسٍن وٌ نفَشَكٍرٍنيِ سٍتَرٍيٍ بّ تٌندِقٍ سٍ ندٍ سٌدٍ عَ يِ رَ. نَ نَ رَبَ، عَ عَ يَشَسٍرِ مَسَمَ نّ عَلَتَلَ بّ وٌ شَ قٍ رَ، وٌ قَ قِندِ يُنُبِتْي رَ. <verse eid="DEU 15:9"/><verse number="10" style="v" sid="DEU 15:10"/>وٌ لَن نّ وٌ شَ عَ كِ بْحّ قِيشّ رَ. وٌ نَ بْحّ قَنيِ نَشَن نَبَشِ نَ كِ، وٌ مَرِفِ عَلَتَلَ بَرَكّ سَمَ نّ وٌ شَ وَلِيٍ وٌ نَ سٌ نَشٍيٍ يٌ يَ مَ. <verse eid="DEU 15:10"/><verse number="11" style="v" sid="DEU 15:11"/>سٍتَرٍيٍ لُمَ نّ وٌ شَ بْشِ مَ، نَ نَن عَ تٌشِ ﭑ نَ عَ قَلَشِ وٌ بّ وٌ شَ هِننّ وٌ نفَشَكٍرٍنيِيٍ رَ، مِسِكِينّ عَ نُن سٍتَرٍ نَشٍيٍ نَ وٌ شَ بْشِ مَ.<verse eid="DEU 15:11"/></para>
  <para style="s">كٌنيِيٍ شْرّيَقٍ</para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 15:12"/>شَ وٌ نفَشَكٍرٍنيِ عٍبُرُ شّمّ، شَ نَ مُ عَ رَ فِنّ، عَ يّتّ مَتِ وٌ مَ كٌنيِ رَ، عَ وَلِمَ نّ وٌ بّ حّ سٍننِ. عَ حّ سٌلٌقٍرٍ ندٍ وٌ شَ عَ شْرّيَ. <verse eid="DEU 15:12"/><verse number="13" style="v" sid="DEU 15:13"/>وٌ مَن نَشَ عَ بّحِن عَ يِ عِفٍلِ رَ. <verse eid="DEU 15:13"/><verse number="14" style="v" sid="DEU 15:14"/>وٌ مَرِفِ عَلَتَلَ سٍ نَشَن بِرِن قِشِ وٌ مَ بَرَكّ رَ عَلْ يّشّي، سِ، مّنفِ، عَ نُن وّنِ، وٌ شَ نَ ندٍيٍ سٌ عَ يِ رَ. <verse eid="DEU 15:14"/><verse number="15" style="v" sid="DEU 15:15"/>وٌ وٌ رَتُ عَ مَ كٌنيِ نَن نُ وٌ قَن نَ مِسِرَ، وٌ مَرِفِ عَلَتَلَ قَ وٌ شُن سَرَ. نَ قٍ نَ عَ تٌشِ، ﭑ يِ سّرِيّ سٌشِ وٌ يِ رَ تٌ لْشْي.<verse eid="DEU 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 15:16"/>شَ كٌنيِ ندٍ قَ عَ قَلَ وٌ بّ عَ مُ كٍلِمَ وٌ شَ دٍنبَيَ يَ مَ بَرِ مَ وٌ بَرَ رَقَن عَ مَ، <verse eid="DEU 15:16"/><verse number="17" style="v" sid="DEU 15:17"/>نَ تّمُي وٌ سٍ تُنبَسٍ نَن تٌنفٌمَ. وٌ عَ تُلِ تُنبَ بَنشِ نَادّ مَ. نَ تّمُي عَ بَرَ قِندِ وٌ شَ كٌنيِ رَ كُدّ. وٌ نَ مْولِ نَن نَبَمَ وٌ شَ كٌنيِ فِنّ قَن نَ. <verse eid="DEU 15:17"/><verse number="18" style="v" sid="DEU 15:18"/>وٌ نَشَ نِمِسَ شْرّيَ قِقٍ رَ وٌ شَ كٌنيِ مَ، بَرِ مَ عَ شَ وَلِ حّ سٍننِ بُن مَ نَ بَرَ وٌ رَفٍينِ دْشْ قِرِن دَنفِ وَلِكّ سَرٍ رَ. نَ كُي وٌ مَرِفِ عَلَتَلَ بَرَكّ سَمَ نّ وٌ شَ وَلِ بِرِن مَ نَ شَ قٍ رَ.<verse eid="DEU 15:18"/></para>
  <para style="s">شُرُ سٍ دِ سِنفٍ</para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 15:19"/>وٌ شَ نِنفٍ، يّشّي، نُن سِ دِ شّمّ سِنفٍ نَشٍيٍ بَرِ مَ، عٍ بِرِن قِندِ مَ وٌ مَرِفِ عَلَتَلَ نَن فبٍ رَ. وٌ مُ لَن وٌ شَ نِنفٍ شّمّ دِ سِنفٍ رَوَلِ، وٌ مَن مُ لَن وٌ شَ يّشّي دِ شّمّ سِنفٍ شَبٍ مَشَبَ عَ مَ. <verse eid="DEU 15:19"/><verse number="20" style="v" sid="DEU 15:20"/>حّ يٌ حّ وٌ تَن نُن وٌ شَ دٍنبَيَ نَن نَ دٌنمَ يِرٍ، وٌ مَرِفِ عَلَتَلَ شَ يِرٍ سُفَندِشِ. <verse eid="DEU 15:20"/><verse number="21" style="v" sid="DEU 15:21"/>شَ عَ مَبّنشِ، شَ عَ يَ كَنَشِ، شَ نَ مُ قُرٍ فبّتّ نَ عَ مَ، وٌ نَشَ نَ قِ وٌ مَرِفِ عَلَتَلَ مَ سّرّشّ رَ. <verse eid="DEU 15:21"/><verse number="22" style="v" sid="DEU 15:22"/>وٌ نْمَ نَ دٌندٍ وٌ شْنيِ نّ، وٌ نُن مِشِ سّنِيّنشِيٍ، شَ نَ مُ عَ رَ، مِشِ سّنِيّنتَرٍيٍ، عَلْ وٌ شٍلِ نُن تْوكّ دٌنمَ كِ نَشّ. <verse eid="DEU 15:22"/><verse number="23" style="v" sid="DEU 15:23"/>كْنْ وٌ نَشَ سُبٍ وُلِ دٌن دٍ. وٌ عَ عِقِلِمَ بْشِ نَن مَ عَلْ يٍ.<verse eid="DEU 15:23"/></para>
  <chapter eid="DEU 15"/>
  <chapter number="16" style="c" sid="DEU 16"/>
  <para style="s">سَيَمَلٍكّ دَنفِ سَلِ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 16:1"/>عَبِبَ كِكٍ رَ، وٌ شَ سَيَمَلٍكّ دَنفِ سَلِ رَبَ وٌ مَرِفِ عَلَتَلَ شَ قٍ رَ، بَرِ مَ نَ كِكٍ كُي، وٌ مَرِفِ عَلَتَلَ وٌ رَ مِنِ مِسِرَ رَ كْي نَن نَ. <verse eid="DEU 16:1"/><verse number="2" style="v" sid="DEU 16:2"/>وٌ سّرّشّ نَشٍيٍ بَمَ وٌ مَرِفِ عَلَتَلَ بّ سَيَمَلٍكّ دَنفِ سَلِ لْشْي، عٍ تٌنفٌمَ شُرُ سٍ نَن يَ مَ؛ يّشّي، سِ، شَ نَ مُ عَ رَ نِنفٍ. نَ سّرّشّ بَمَ عَلَتَلَ شِلِ مَتْشْدٍ نّ.<verse eid="DEU 16:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="DEU 16:3"/>وٌ نَشَ تَامِ لّبِنِ دَاشِ دٌن نَ سَلِ شِ سٌلٌقٍرٍ بُن مَ. وٌ لَن وٌ شَ تَامِ لّبِنِتَرٍ نَن دٌن نَشَن قِندِ كِنِكِنِ تَامِ رَ. نَ نَن وٌ رَتُمَ لْشْي مَ وٌ فبَتَشِ مِنِ مِسِرَ بْشِ رَ لْشْي نَشّ. نَ عَ نِيَمَ نّ وٌ مُ نّيمُ وٌ مِنِ لْشْي مَ مِسِرَ بْشِ رَ. <verse eid="DEU 16:3"/><verse number="4" style="v" sid="DEU 16:4"/>نَ شِ سٌلٌقٍرٍ بُن مَ، عَ مُ لَن لّبِنِ سِيَ شَ تٌ وٌ شْنيِ، وٌ شَ بْشِ بِرِن مَ. وٌ سّرّشّ نَشَن بَمَ عَ شِ سِنفٍ نُنمَرٍ رَ، نَ مُ لَن عَ شَ لُ هَن فّيسّفّ.<verse eid="DEU 16:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="DEU 16:5"/>نَ سَيَمَلٍكّ دَنفِ سَلِ سّرّشّ مُ لَن عَ شَ رَبَ يِرٍ بِرِن، وٌ مَرِفِ عَلَتَلَ وٌ رَ سَبَتِشِ دّننَشّ. <verse eid="DEU 16:5"/><verse number="6" style="v" sid="DEU 16:6"/>وٌ عَ بَمَ يِرٍ كٍرٍن ثٍتِ نّ، وٌ مَرِفِ عَلَتَلَ شِلِ مَتْشْدٍ سّنِيّنشِ. نَ سّرّشّ بَمَ نُنمَرٍ نَن نَ سٌفٍ فٌرٌ تّمُي، وٌ مِنِ وَشَتِ نَشَن مَ مِسِرَ بْشِ رَ. <verse eid="DEU 16:6"/><verse number="7" style="v" sid="DEU 16:7"/>وٌ سُبٍ حِنمَ نّ، وٌ عَ دٌن يِرٍ وٌ مَرِفِ عَلَتَلَ دّننَشّ سُفَندِشِ. كُيٍ نَ عِبَ، وٌ قَ سِفَ وٌ شْنيِ. <verse eid="DEU 16:7"/><verse number="8" style="v" sid="DEU 16:8"/>شِ سٍننِ بُن مَ، وٌ تَامِ لّبِنِتَرٍ نَن دٌنمَ. عَ شِ سٌلٌقٍرٍ لْشْي وٌ مَلَنيِ بٍلٍبٍلٍ رَبَ وٌ مَرِفِ عَلَتَلَ شَ بِنيّ بُن مَ. وٌ نَشَ وَلِ يٌ رَبَ نَ لْشْي.<verse eid="DEU 16:8"/></para>
  <para style="s">شّ شَبّ سَلِ</para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 16:9"/>وٌ نَ مّنفِ شَبَ قْلْ، وٌ لْشْشُن سٌلٌقٍرٍ نَن كْنتِمَ، <verse eid="DEU 16:9"/><verse number="10" style="v" sid="DEU 16:10"/>وٌ قَ لْشُنيِيٍ سَلِ رَبَ وٌ مَرِفِ عَلَتَلَ بّ. وٌ مَرِفِ عَلَتَلَ بَرَكّ نَشَن قِشِ وٌ مَ وٌ سْتْسٍ رَ، وٌ شَ ندٍ بَ وٌ حَنِفٍ رَ نَ بَرَكّ بّرّ رَ. <verse eid="DEU 16:10"/><verse number="11" style="v" sid="DEU 16:11"/>وٌ سّيوَ مَ نّ وٌ مَرِفِ عَلَتَلَ رَ يِرٍ عَ دّننَشّ سُفَندِشِ عَ شِلِ قَلَقٍ رَ، وٌ تَن نُن وٌ شَ دِيٍ، وٌ شَ كٌنيِيٍ، لٍوِكَيٍ نَشٍيٍ نَ وٌ شْنيِ، شْحّيٍ، كِرِدِيٍ، عَ نُن كَاحّ فِنّيٍ. <verse eid="DEU 16:11"/><verse number="12" style="v" sid="DEU 16:12"/>وٌ شَ رَتُ كٌنيِ نَن نُ نَ وٌ رَ مِسِرَ بْشِ مَ. وٌ لَن نّ وٌ شَ يِ سّرِيّ رَحّرّ عَ رَحّرّ كِ مَ.<verse eid="DEU 16:12"/></para>
  <para style="s">بَفٍ تِ سَلِ</para>
  <para style="p">
    <verse number="13" style="v" sid="DEU 16:13"/>وٌ نَ فّ وٌ شَ سَنسِيٍ بْنبْدٍ لْنيِ مَ، وٌ نَشَ وّنِ بٌفِ قَن بُندُ، وٌ شَ بَفٍ تِ سَلِ رَبَ شِ سٌلٌقٍرٍ بُن مَ. <verse eid="DEU 16:13"/><verse number="14" style="v" sid="DEU 16:14"/>وٌ شَ سّيوَ نَ سَلِ كُي، وٌ تَن، وٌ شَ دِيٍ، وٌ شَ كٌنيِيٍ، لٍوِكَيٍ، شْحّيٍ، كِرِدِيٍ، عَ نُن كَاحّ فِنّيٍ نَشٍيٍ نَ وٌ شْنيِ. <verse eid="DEU 16:14"/><verse number="15" style="v" sid="DEU 16:15"/>وٌ يِ سَلِ رَبَمَ شِ سٌلٌقٍرٍ نَن بُن مَ وٌ مَرِفِ عَلَتَلَ بّ عَ نَ دّننَشّ سُفَندِ، بَرِ مَ وٌ مَرِفِ عَلَتَلَ بَرَكّ سَمَ نّ وٌ شَ شّ وَلِ نُن وٌ شَ وَلِ بِرِن مَ، وٌ قَ سّيوَ كِ قَنيِ رَ.<verse eid="DEU 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 16:16"/>حّ يٌ حّ، شّمّ نَشَن بِرِن نَ وٌ يَ مَ، عٍ لَن نّ عٍ شَ تِ عٍ مَرِفِ عَلَتَلَ يَ عِ سَنيَ سَشَن، يِرٍ عَ دّننَشّ سُفَندِشِ؛ تَامِ لّبِنِتَرٍ سَلِ، لْشُنيِيٍ سَلِ، عَ نُن بَفٍ تِ سَلِ. وٌ مُ لَن وٌ شَ سِفَ عَلَتَلَ مَ وٌ يِ عِفٍلِ رَ. <verse eid="DEU 16:16"/><verse number="17" style="v" sid="DEU 16:17"/>وٌ كٍرٍن كٍرٍن مَ قَمَ سّرّشّ نَن نَ وٌ نْشِ نَشَن نَ، وٌ مَرِفِ عَلَتَلَ نَشَن قِشِ وٌ مَ بَرَكّ رَ.<verse eid="DEU 16:17"/></para>
  <para style="s">سّرِيّ رَحّرّ كِ</para>
  <para style="p">
    <verse number="18" style="v" sid="DEU 16:18"/>تَايٍ بِرِن كُي، وٌ مَرِفِ عَلَتَلَ دّننَشّ قِشِ وٌ مَ، بْنسْي يٌ بْنسْي، وٌ كِيتِسَيٍ نَن سُفَندِ مَ، عٍ شَ حَمَ مَكِيتِ تِنشِنيِ كُي. <verse eid="DEU 16:18"/><verse number="19" style="v" sid="DEU 16:19"/>وٌ نَشَ تْوحّفّ كِيتِ سَ دٍ، وٌ مَن نَشَ تِ مِشِ يٌ شْن مَ. وٌ نَشَ تِن قٍ ندٍ شَ وٌ مَدَشُ، بَرِ مَ سٍ نْمَ نْندِ قَلّيٍ قِندِدٍ نّ دْنشُي رَ، عٍ نْندِ مَقِندِ وُلٍ رَ. <verse eid="DEU 16:19"/><verse number="20" style="v" sid="DEU 16:20"/>وٌ لَنمَ وٌ شَ كِيتِ تِنشِنشِ يَتِ نَن سَ، عَلَكٌ وٌ شَ سِمَيَ سْتْ، وٌ مَن شَ نْ بْشِ مَسْتْدٍ وٌ مَرِفِ عَلَتَلَ دّننَشّ قِشِ وٌ مَ.<verse eid="DEU 16:20"/></para>
  <para style="s">كُيٍ رَبَتُقٍ</para>
  <para style="p">
    <verse number="21" style="v" sid="DEU 16:21"/>وٌ مُ لَن وٌ شَ عَسٍرِ وُرِ مَسٌلِشِ تِ سّرّشّبَدٍ قّ مَ، وٌ دّننَشّ يَءِلَنشِ وٌ مَرِفِ عَلَتَلَ بّ. <verse eid="DEU 16:21"/><verse number="22" style="v" sid="DEU 16:22"/>وٌ نَشَ فّمّ تِ كُيٍ رَ، بَرِ مَ وٌ مَرِفِ عَلَتَلَ نَ قٍ مْولِ شْنشِ.<verse eid="DEU 16:22"/></para>
  <chapter eid="DEU 16"/>
  <chapter number="17" style="c" sid="DEU 17"/>
  <para style="s">سّرّشّ قَنيِ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 17:1"/>وٌ مُ لَن وٌ شَ نِنفٍ شَ نَ مُ يّشّي بَ سّرّشّ رَ وٌ مَرِفِ عَلَتَلَ بّ، نَشَن كّحَ مُ قَن، شَ نَ مُ عَ رَ نَشَن مَبّنشِ، بَرِ مَ وٌ مَرِفِ عَلَتَلَ نَ قٍ مْولِ شْنشِ.<verse eid="DEU 17:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="DEU 17:2"/>شَ وٌ مِشِ ندٍ تٌ وٌ شَ تَايٍ كُي، وٌ مَرِفِ عَلَتَلَ نَشٍيٍ قِشِ وٌ مَ، نَشَن عَلَ فبّتّ بَتُمَ، عَ بَرَ قٍ حَاشِ رَبَ نَشَن مُ رَقَن وٌ مَرِفِ عَلَتَلَ مَ. عَ بَرَ عَلَ شَ سَاتّ مَتَندِ <verse eid="DEU 17:2"/><verse number="3" style="v" sid="DEU 17:3"/>تُوبِ رَبِرَقٍ عَلَ فبّتّيٍ بّ، شَ نَ مُ سٌفٍ، كِكٍ، نُن تُنبُييٍ بّ. <verse eid="DEU 17:3"/><verse number="4" style="v" sid="DEU 17:4"/>وٌ نَ نَ قٍ مْولِ عِقَلّ مّ، وٌ شَ عَ شْن نَقٍن عَ قَنيِ رَ. وٌ نَ عَ كٌلٌن نَ قٍ شْنشِ بَرَ رَبَ عِسِرَيِلَ بْشِ مَ، <verse eid="DEU 17:4"/><verse number="5" style="v" sid="DEU 17:5"/>عَ نَ قِندِ شّمّ رَ، شَ نَ مُ فِنّ، وٌ عَ كَنيِ شَنِنمَ تَا سٌدٍ دّ نَن نَ، وٌ عَ مَفْنْ فّمّ رَ هَن عَ شَ قَشَ.<verse eid="DEU 17:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="DEU 17:6"/>مِشِ نَشَن لَن عَ شَ قَشَ، عَ مُ قَشَمَ سِندٍن قٌ عَ تٌنفٌ سٍيدٍ قِرِن شُي مَ، شَ نَ مُ عَ رَ سَشَن. عَ مُ لَن عَ شَ قَشَ سٍيدٍ كٍرٍن فبَنسَن شُي مَ. <verse eid="DEU 17:6"/><verse number="7" style="v" sid="DEU 17:7"/>سٍيدٍيٍ نَن سِنفٍ فّمّ وٌلِمَ عَ مَ عَ قَشَقٍ رَ، حَمَ دْنشْي قَن قَ عَ مَفْنْ. وٌ قٍ حَاشِ حْنمَ وٌ تَفِ نَ كِ نّ.<verse eid="DEU 17:7"/></para>
  <para style="s">كِيتِ مَفَاشُشِيٍ</para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 17:8"/>شَ قَشَ كِيتِ بَرَ قَ، شَ نَ مُ عَ رَ فَلَنبُي، شَ نَ مُ مَشْنّ، نَشَن قِندِشِ كِيتِ شْرْشْي رَ وٌ بّ تَا كُي، وٌ شَ سِفَ يِرٍ وٌ مَرِفِ عَلَتَلَ دّننَشّ سُفَندِشِ. <verse eid="DEU 17:8"/><verse number="9" style="v" sid="DEU 17:9"/>وٌ سِفَمَ لٍوِكَ سّرّشّدُبّيٍ نَن شْن، عَ نُن كِيتِسَيٍ نَشٍيٍ نَ وٌ شُن مَ، وٌ عَ تَفِ رَبَ عٍ بّ. عٍ عَ قَلَمَ وٌ بّ نَ تّمُي عَ لَن كِيتِ شَ سَ كِ نَشّ. <verse eid="DEU 17:9"/><verse number="10" style="v" sid="DEU 17:10"/>عٍ نَشَن قَلَمَ وٌ بّ يِرٍ، وٌ مَرِفِ عَلَتَلَ دّننَشّ سُفَندِشِ، وٌ كِيتِ بٌلٌنمَ نَ كِ نّ. عٍ نَشَن قَلَمَ وٌ بّ، وٌ شَ نَ بِرِن نَبَ. <verse eid="DEU 17:10"/><verse number="11" style="v" sid="DEU 17:11"/>عٍ سّرِيّ نَشَن بِرِن قَلَمَ وٌ بّ، وٌ شَ نَ رَبَ. وٌ نَشَ بِنيَ يِرٍقَنيِ مَ، شَ نَ مُ كْولَ مَ. <verse eid="DEU 17:11"/><verse number="12" style="v" sid="DEU 17:12"/>شَ مِشِ ندٍ، عَ شَ يّتّ عِفبٌحَ كُي، مُ عَ تُلِ مَتِ كِيتِسَيٍ نُن سّرّشّدُبّيٍ رَ، وٌ مَرِفِ عَلَتَلَ نَشٍيٍ سُفَندِشِ عَ شَ وَلِ رَبَقٍ مَ، نَ كَنيِ لَنمَ نّ عَ شَ قَشَ. وٌ قٍ حَاشِ حْنمَ وٌ تَفِ نَ كِ نّ عِسِرَيِلَ. <verse eid="DEU 17:12"/><verse number="13" style="v" sid="DEU 17:13"/>حَمَ بِرِن قَمَ لُدٍ فَاشُي نَن كُي نَ تّمُي. عٍ نَ يِ قٍ مّ نَشَن نَبَشِ، مِشِ فبّتّ يٌ مُ سُو سَمَ نَ يّتّ عِفبٌحَ مْولِ رَبَدٍ قَ.<verse eid="DEU 17:13"/></para>
  <para style="s">مَنفّيَ</para>
  <para style="p">
    <verse number="14" style="v" sid="DEU 17:14"/>وٌ نَ سٌ بْشِ مَ تّمُي نَشّ، وٌ مَرِفِ عَلَتَلَ دّننَشّ قِمَ وٌ مَ، وٌ نَ سَبَتِ نَا، تّمُندٍ وٌ قَمَ نّ عَ مَحْشُندٍ وٌ قَن شَ وٌ فبٍ مَنفّ سْتْ عَلْ بٌورٍ سِ نَشٍيٍ وٌ رَبِلِنشِ. <verse eid="DEU 17:14"/><verse number="15" style="v" sid="DEU 17:15"/>وٌ مَرِفِ عَلَتَلَ نَ مِشِ نَشَن سُفَندِ، نَ نَن قَمَ قِندِدٍ وٌ شَ مَنفّ رَ. وٌ نَشَ تِن شْحّ شَ قِندِ وٌ شَ مَنفّ رَ، وٌ نفَشَكٍرٍنيِ مُ نَشَن نَ. <verse eid="DEU 17:15"/><verse number="16" style="v" sid="DEU 17:16"/>عَ مُ لَن سٌي فبٍفبٍ شَ لُ وٌ شَ مَنفّ يِ رَ. عَ مُ لَن عَ شَ مِشِيٍ رَ سَنبَ مِسِرَ عٍ سَرَدٍ، بَرِ مَ عَلَتَلَ عَ قَلَشِ نّ وٌ بّ، عَ وٌ نَشَ سِفَ نَ بْشِ مَ سْنْن. <verse eid="DEU 17:16"/><verse number="17" style="v" sid="DEU 17:17"/>عَ مُ لَن عَ شَ فِنّ فبٍفبٍ دْشْ. نَ قٍيٍ نَن قَمَ عَ رَفبِلٍندٍ عَلَتَلَ قْشْ رَ. عَ مُ لَن عَ شَ فبٍتِ فبٍفبٍ نُن شّيمَ فبٍفبٍ مَلَن.<verse eid="DEU 17:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="DEU 17:18"/>مَنفّ نَ دْشْ عَ شَ مَنفّ كِبَنيِ تّمُي نَشّ، سّرِيّ كِتَابُي نَشَن نَفَتَشِ لٍوِكَ سّرّشّدُبّيٍ يِ رَ، عَ شَ نَ مِسَالِ يَءِلَن عَ يّتّ بّ. <verse eid="DEU 17:18"/><verse number="19" style="v" sid="DEU 17:19"/>عَ شَ نَ كِتَابُي رَفَتَ عَ قّ مَ، عَ شَ عَ شَرَن لْشْي بِرِن عَ شَ سِمَيَ كُي، عَلَكٌ عَ شَ فَاشُ عَ مَرِفِ عَلَتَلَ يَ رَ، عَ مَن شَ نْ عَ شَ سّرِيّ نُن عَ شَ يَامَرِ رَبَتُدٍ نَشَن سّبّشِ عَ كُي. <verse eid="DEU 17:19"/><verse number="20" style="v" sid="DEU 17:20"/>نَ قٍ نَن قَمَ عَ نِيَدٍ، عَ مُ عَ يّتّ رَقِسَ عَ نفَشَكٍرٍنيِيٍ بّ، عَ مَن مُ تَنتَن سّرِيّ مَ، عَ مُ بِنيَ يِرٍقَنيِ مَ نُن كْولَ مَ. نَ تّمُي عَ مَنفّيَ شْنكُيٍ سْتْمَ نّ، عَ تَن نُن عَ شَ دِيٍ عِسِرَيِلَ حَمَ تَفِ.<verse eid="DEU 17:20"/></para>
  <chapter eid="DEU 17"/>
  <chapter number="18" style="c" sid="DEU 18"/>
  <para style="s">سّرّشّدُبّيٍ شَ وَلِ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 18:1"/>لٍوِكَ سّرّشّدُبّيٍ نُن لٍوِ شَبِلّ دْنشْييٍ مُ قَمَ بْشِ سْتْدٍ كّ رَ عَلْ عِسِرَيِلَ دِ بٌورٍيٍ. عٍ بَلٌي قِندِ مَ سّرّشّ فَن دَاشِيٍ نَن نَ نَشٍيٍ بَمَ عَلَتَلَ بّ. <verse eid="DEU 18:1"/><verse number="2" style="v" sid="DEU 18:2"/>عٍ مُ قَمَ كّ سْتْدٍ عٍ نفَشَكٍرٍنيِيٍ تَفِ. عَلَتَلَ نَن قِندِ مَ عٍ كّ رَ عَلْ عَ عَ مَسٍن عٍ بّ كِ نَشّ. <verse eid="DEU 18:2"/><verse number="3" style="v" sid="DEU 18:3"/>لٍوِكَ سّرّشّدُبّيٍ مَبِرِ قِندِ مَ سّرّشّيٍ نَن نَ عِسِرَيِلَكَيٍ قَمَ نَشٍيٍ بَدٍ عَلْ نِنفٍيٍ، شَ نَ مُ عَ رَ يّشّييٍ. عَ لَنمَ سُبٍ بّلّشّ، عَ بَنفَنيِ، نُن عَ قُرِ نَن شَ سٌ سّرّشّدُبّيٍ يِ رَ. <verse eid="DEU 18:3"/><verse number="4" style="v" sid="DEU 18:4"/>وٌ مَن قَ بْشِ دَشَمُي سِنفٍ سٌ عٍ يِ رَ؛ مّنفِ، وّنِ نّينّ، تُرٍ، عَ نُن وٌ يّشّي شَبٍ نَشَن سِنفٍ مَشَبَمَ. <verse eid="DEU 18:4"/><verse number="5" style="v" sid="DEU 18:5"/>وٌ مَرِفِ عَلَتَلَ لٍوِ بْنسْي نَن سُفَندِشِ بْنسْي بِرِن تَفِ، عَلَكٌ عٍ تَن نُن عٍ شَ دِيٍ شَ نْ عَلَتَلَ شِلِ بِنيَدٍ تّمُي بِرِن.<verse eid="DEU 18:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="DEU 18:6"/>شَ لٍوِكَ ندٍ وَ كٍلِقٍ عِسِرَيِلَ تَا كُي عَ نَ دّننَشّ، سِفَقٍ رَ يِرٍ عَلَتَلَ دّننَشّ سُفَندِشِ، <verse eid="DEU 18:6"/><verse number="7" style="v" sid="DEU 18:7"/>مّننِ، عَ لَنمَ عَ شَ عَ مَرِفِ عَلَتَلَ شَ وَلِ رَبَ عَ نُن عَ نفَشَكٍرٍنيِ لٍوِكَيٍ رَ نَشٍيٍ نَ نَا. <verse eid="DEU 18:7"/><verse number="8" style="v" sid="DEU 18:8"/>عَ لَن نّ عَ شَ بَلٌي سْتْ عَلْ سّرّشّدُبّ بٌورٍيٍ، بَقٍ عَ هَرِفٍ رَ عَ قَشِ نَشَن نَ عَ شُن مَ، عَ بَرَ نَشَن سْتْ.<verse eid="DEU 18:8"/></para>
  <para style="s">سٍمَتٌي نُن دُورٍيٍ</para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 18:9"/>وٌ نَ سٌ تّمُي نَشّ بْشِ مَ، وٌ مَرِفِ عَلَتَلَ نَشَن قِمَ وٌ مَ، وٌ مُ لَن وٌ شَ سٌ وَلِ حَاشِيٍ يَ مَ مّننِكَيٍ نَ نَشٍيٍ كُي. <verse eid="DEU 18:9"/><verse number="10" style="v" sid="DEU 18:10"/>مِشِ نَشَ مِنِ وٌ يَ مَ دٍ نَشَن عَ شَ دِ فَنمَ سّرّشّ رَ، نَشَن قِندِ مَ سٍمَتٌي رَ، يَ كَنيِ رَ، دُورٍ رَ، كْرْ مِشِ رَ، <verse eid="DEU 18:10"/><verse number="11" style="v" sid="DEU 18:11"/>نَشَن كَرَ مْشْ وَلِ رَبَمَ، نَشَن وْيّنمَ بَرِيٍ، حِننّيٍ، نُن مِشِ قَشَشِيٍ رَ. <verse eid="DEU 18:11"/><verse number="12" style="v" sid="DEU 18:12"/>وٌ مَرِفِ عَلَتَلَ نَ مِشِ مْولِ شْنشِ. نَ قٍ كٌبِيٍ نَ عَ تٌشِ، وٌ مَرِفِ عَلَتَلَ يِ سِيٍ هَلَكِمَ وٌ يَ رَ. <verse eid="DEU 18:12"/><verse number="13" style="v" sid="DEU 18:13"/>وٌ شَ لُ وٌ مَرِفِ عَلَتَلَ وَشْنكِ. <verse eid="DEU 18:13"/><verse number="14" style="v" sid="DEU 18:14"/>وٌ قَمَ سِ نَشٍيٍ هَلَكِدٍ نَ كِ، عٍ بِرَشِ سٍمَتٌي شُي نَن قْشْ رَ، كْنْ وٌ مَرِفِ عَلَتَلَ مُ تِنمَ وٌ تَن شَ نَ رَبَ.<verse eid="DEU 18:14"/></para>
  <para style="s">نَمِحْنمّ وَلِ</para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 18:15"/>وٌ مَرِفِ عَلَتَلَ قَمَ نَمِحْنمّ ندٍ رَكٍلِدٍ وٌ يَ مَ، نَشَن لُمَ عَلْ ﭑ تَن. وٌ شَ وٌ تُلِ مَتِ عَ رَ. <verse eid="DEU 18:15"/><verse number="16" style="v" sid="DEU 18:16"/>وٌ نَ نَن يَتِ مَشْرِن وٌ مَرِفِ عَلَتَلَ مَ، وٌ نُ مَلَنشِ لْشْي نَشّ شٌرٍبٍ فٍيَ قَرِ. وٌ نَشَ عَ قَلَ، «مُشُ مُ وَ مَ مُشُ مَرِفِ عَلَتَلَ شُي مّقٍ قَ. مُشُ مُ وَ مَ يِ تّ بٍلٍبٍلٍ قَن تٌقٍ كْرّ، عَلَكٌ مُشُ نَشَ قَشَ.» <verse eid="DEU 18:16"/><verse number="17" style="v" sid="DEU 18:17"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، «عٍ قٍ قَنيِ نَن قَلَشِ ﭑ بّ. <verse eid="DEU 18:17"/><verse number="18" style="v" sid="DEU 18:18"/>ﭑ قَمَ نّ نَمِحْنمّ ندٍ رَكٍلِدٍ عٍ يَ مَ، نَشَن لُشِ عَلْ عِ تَن. ﭑ قَمَ ﭑ مَ مَسٍنيِ قِدٍ عَ مَ، عَ قَ نَ تَفِ رَبَ عٍ بّ. <verse eid="DEU 18:18"/><verse number="19" style="v" sid="DEU 18:19"/>مِشِ ندٍ نَ لُ، عَ مُ عَ تُلِ مَتِ نَ نَمِحْنمّ شَ مَسٍنيِ رَ عَ نَشَن تِمَ ﭑ شِلِ رَ، ﭑ تَن يّتّ يَتِ نَن نَ كَنيِ مَكِيتِمَ.»<verse eid="DEU 18:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="DEU 18:20"/>«كْنْ شَ نَمِحْنمّ يّتّ عِفبٌي ندٍ قَ مَسٍنيِ تِ ﭑ شِلِ رَ، ﭑ مُ نَشَن قِشِ عَ مَ، شَ نَ مُ عَ مَسٍنيِ تِ عَلَ فبّتّ شِلِ رَ، عَ لَنمَ نّ نَ كَنيِ شَ قَشَ. <verse eid="DEU 18:20"/><verse number="21" style="v" sid="DEU 18:21"/>تّمُندٍ وٌ قَمَ نّ وٌ يّتّ مَشْرِندٍ، ‹وٌن نْمَ عَ كٌلٌندٍ دِ شَ يِ وْيّنيِ قَتَنشِ عَلَتَلَ نَن نَ؟› <verse eid="DEU 18:21"/><verse number="22" style="v" sid="DEU 18:22"/>شَ نَمِحْنمّ مَسٍنيِ تِ عَلَتَلَ شِلِ رَ، عَ قَ لُ عَ مُ كَمَلِ، نَ نَن نَ كِ عَ شَ مَسٍنيِ مُ قَتَنشِ عَلَتَلَ رَ. نَمِحْنمّ نَن نَ قَلَشِ عَ شَ يّتّ عِفبٌحَ كُي. هَلِ وٌ مُ فَاشُ عَ يَ رَ.»<verse eid="DEU 18:22"/></para>
  <chapter eid="DEU 18"/>
  <chapter number="19" style="c" sid="DEU 19"/>
  <para style="s">مِشِ رَتَنفَ تَايٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 19:1"/>وٌ مَرِفِ عَلَتَلَ نَ قَ سِيٍ هَلَكِدٍ وٌ يَ رَ، عَ قَ عٍ شَ بْشِ سٌ وٌ يِ رَ، وٌ قَ سَبَتِ عٍ شَ تَايٍ نُن عٍ شَ بَنشِيٍ كُي، <verse eid="DEU 19:1"/><verse number="2" style="v" sid="DEU 19:2"/>وٌ شَ تَا سَشَن سُفَندِ نَ بْشِ تَفِ، وٌ مَرِفِ عَلَتَلَ نَشَن قِشِ وٌ مَ. <verse eid="DEU 19:2"/><verse number="3" style="v" sid="DEU 19:3"/>وٌ شَ بْشِ مَنِيَ، وٌ مَرِفِ عَلَتَلَ نَشَن قِشِ وٌ مَ كّ رَ، وٌ قَ عَ عِتَشُن دْشْ سَشَن. نَ نَن عَ تٌمَ قَشَتِ ندٍ نْمَ سِفَدٍ نَ تَا ندٍ كُي، عَلَكٌ عَ نِي شَ رَتَنفَ.<verse eid="DEU 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="DEU 19:4"/>مِشِ نَشَن قَشّ تِشِ، عَ مُ عَ رَكٍلِشِ عَ مَ، نَ قَشَتِ مْولِ نَن فبَنسَن نْمَ سٌدٍ يِ تَا ندٍ كُي عَ نِي رَتَنفَقٍ رَ. <verse eid="DEU 19:4"/><verse number="5" style="v" sid="DEU 19:5"/>مِسَالِ نَن يَ؛ شَ مِشِ سِفَ قْتْنيِ وُرِ سّفّدٍ، عَ نُن عَ بٌورٍ، عَ شَ بٍيرَ قَ كٌرٍن، عَ دِن عَ بٌورٍ رَ، نَ قَ قَشَ، نَ قَشَتِ مْولِ تَن نْمَ سٌدٍ يِ تَا ندٍ كُي عَ نِي رَتَنفَقٍ رَ. <verse eid="DEU 19:5"/><verse number="6" style="v" sid="DEU 19:6"/>عَ شَ نَ رَبَ عَلَكٌ مِشِ نَشَن وَ مَ نَ قُرٍ فبٍحْشْقٍ عَ شَ بْحّتٍ كُي، عَ نَشَ نْ قَشّتِ لِدٍ كِرَ رَ، عَ قَ عَ قَشَ. نَ مُ لَنمَ، بَرِ مَ شْننَنتٍيَ يٌ مُ نُ نَ عَ بّ نَ مِشِ قَشَشِ شَ قٍ رَ. <verse eid="DEU 19:6"/><verse number="7" style="v" sid="DEU 19:7"/>ﭑ يِ يَامَرِ قِشِ وٌ مَ نَ نَن مَ. وٌ شَ تَا سَشَن سُفَندِ، نٍيٍ شَ قِندِ مِشِ رَتَنفَ تَايٍ رَ.<verse eid="DEU 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 19:8"/>شَ وٌ مَرِفِ عَلَتَلَ وٌ شَ بْشِ رَفبٌ يّ عَلْ عَ رَكَلِ كِ نَشّ وٌ بَبَيٍ بّ، شَ عَ يِ بْشِ بِرِن سٌ وٌ يِ رَ عَ نَشَن لَايِدِشِ وٌ بَبَيٍ بّ، <verse eid="DEU 19:8"/><verse number="9" style="v" sid="DEU 19:9"/>شَ وٌ يِ يَامَرِ رَبَ عَ رَبَ كِ مَ ﭑ نَشَن قَلَشِ وٌ بّ تٌ لْشْي، وٌ مَرِفِ عَلَتَلَ نَشَ رَقَن وٌ مَ، وٌ نَشَ بِرَ عَ شَ كِرَ قْشْ رَ، نَ تّمُي وٌ مَن شَ تَا سَشَن سُفَندِ، وٌ شَ عٍ سَ يِ تَا سَشَنيِ بٌورٍ شُن مَ. <verse eid="DEU 19:9"/><verse number="10" style="v" sid="DEU 19:10"/>نَ كُي، مِشِ تْوحّفّشِ مُ قَشَمَ وٌ شَ بْشِ مَ، وٌ مَرِفِ عَلَتَلَ نَشَن قِشِ وٌ مَ كّ رَ.<verse eid="DEU 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="DEU 19:11"/>كْنْ شَ مِشِ ندٍ عَ يَشُي شْن، عَ عَ مّلّن، عَ عَ قَشَ، عَ قَ سٌ يِ تَا ندٍ كُي، <verse eid="DEU 19:11"/><verse number="12" style="v" sid="DEU 19:12"/>نَ تَا قٌرِيٍ لَن نّ عٍ شَ عَ سُشُ، عٍ عَ شَنِن مِشِ شْن مَ نَشَن وَ مَ نَ قُرٍ فبٍحْشْقٍ، عَلَكٌ قَشّتِ شَ قَشَ. <verse eid="DEU 19:12"/><verse number="13" style="v" sid="DEU 19:13"/>وٌ نَشَ كِنِكِنِ يٌ تِ نَ كَنيِ مَ. وٌ نَ قَشَتِ مْولِ حْنمَ نَ كِ نّ عِسِرَيِلَ بْشِ مَ، عَلَكٌ بْحّسَ شَ لُ وٌ يِ رَ.<verse eid="DEU 19:13"/></para>
  <para style="s">بْشِ نَانِنيِ نُن سٍيدٍ وُلٍ قَلّ</para>
  <para style="p">
    <verse number="14" style="v" sid="DEU 19:14"/>وٌ نَ سَبَتِ بْشِ مَ وٌ مَرِفِ عَلَتَلَ نَشَن قِشِ وٌ مَ كّ رَ، وٌ نَشَ نَانِنيِ تْنشُمَيٍ مَسِفَ دٍ وٌ بٍنبَيٍ نَشٍيٍ دْشْ. <verse eid="DEU 19:14"/><verse number="15" style="v" sid="DEU 19:15"/>مِشِ نَشَن يُنُبِ قٍ رَبَشِ، شَ نَ مُ عَ رَ هَاكّ، نَ كَنيِ مُ لَن عَ شَ مَكِيتِ مِشِ كٍرٍن شَ سٍيدٍ بَشِ مَ. نَ مْولِ مَكِيتِمَ سٍيدٍ قِرِن، شَ نَ مُ، سٍيدٍ سَشَن شُي نَن مَ.<verse eid="DEU 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 19:16"/>شَ سٍيدٍ حَاشِ بَ ندٍ سَ مِشِ ندٍ تْوحّفّ قٍ ندٍ مَ، <verse eid="DEU 19:16"/><verse number="17" style="v" sid="DEU 19:17"/>يِ فٍرٍ مِشِ قِرِنيِيٍ لَن نّ عٍ شَ سِفَ عَلَتَلَ شَ هْرْ مْبَنشِ كُي، عٍ سَ عٍ شَ فَلَنبُي يَشَرَن سّرّشّدُبّيٍ نُن كِيتِسَيٍ بّ نَشٍيٍ نَ نَ وَشَتِ. <verse eid="DEU 19:17"/><verse number="18" style="v" sid="DEU 19:18"/>كِيتِسَيٍ عَ قٍ شْن نَقٍنمَ نّ عَ كِ نُن عَ كّحَ مَ. عٍ نَ عَ كٌلٌن سٍيدٍ وُلٍ نَن سَشِ عَ نفَشَكٍرٍنيِ شُن مَ، <verse eid="DEU 19:18"/><verse number="19" style="v" sid="DEU 19:19"/>عَ نفَشَكٍرٍنيِ نُ وَ مَ عَ مَكِيتِقٍ كِ نَشّ، وٌ شَ نَ كِيتِ رَفبِلٍن عَ مَ. وٌ قٍ حَاشِ حْنمَ وٌ تَفِ نَ كِ نّ. <verse eid="DEU 19:19"/><verse number="20" style="v" sid="DEU 19:20"/>مِشِ فبّتّيٍ نَ نَ قٍ مّ، فَاشُي نَن لُمَ عٍ مَ، عٍ مُ سُو سَمَ نَ قٍ كٌبِ مْولِ رَبَدٍ قَ. <verse eid="DEU 19:20"/><verse number="21" style="v" sid="DEU 19:21"/>وٌ نَشَ كِنِكِنِ نَ مِشِ مْولِ مَ. شَ عَ مِشِ نَن قَشَشِ، وٌ عَ قَن قَشَ. شَ عَ مِشِ يَ نَن كَنَشِ، وٌ عَ قَن يَ كَنَ. شَ عَ مِشِ حِنيِ نَن فِرَشِ، وٌ عَ قَن حِنيِ فِرَ. شَ عَ مِشِ بّلّشّ نَن بٌلٌنشِ، وٌ عَ قَن بّلّشّ بٌلٌن. شَ عَ مِشِ سَنيِ نَن بٌلٌنشِ، وٌ عَ قَن سَنيِ بٌلٌن.<verse eid="DEU 19:21"/></para>
  <chapter eid="DEU 19"/>
  <chapter number="20" style="c" sid="DEU 20"/>
  <para style="s">فٍرٍ سّرِيّ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 20:1"/>وٌ نَ سِفَ وٌ يَشُييٍ فٍرٍدٍ، وٌ قَ عَ تٌ عٍ شَ سٌييٍ، فٍرٍ سٌسٍيٍ، نُن سْورِيٍ دَنفِ وٌ فبٍ رَ، هَلِ وٌ مُ فَاشُ. وٌ مَرِفِ عَلَتَلَ نَشَن وٌ رَ مِنِشِ مِسِرَ بْشِ رَ، عَ نَ وٌ قْشْ رَ. <verse eid="DEU 20:1"/><verse number="2" style="v" sid="DEU 20:2"/>وٌ نّ وٌ يَءِلَنمَ تّمُي نَشّ فٍرٍ سٌقٍ مَ، سّرّشّدُبّ نَن تِمَ عَ وْيّن حَمَ بّ، <verse eid="DEU 20:2"/><verse number="3" style="v" sid="DEU 20:3"/>«عِسِرَيِلَ، وٌ وٌ تُلِ مَتِ! تٌ لْشْي وٌ قَشِ وٌ يَشُييٍ نَن فٍرٍدٍ. لِمَنِيَ نَشَ بَ وٌ يِ رَ دٍ، وٌ نَشَ فَاشُ، وٌ بْحّ نَشَ مِنِ عَ عِ، وٌ نَشَ سّرّن، <verse eid="DEU 20:3"/><verse number="4" style="v" sid="DEU 20:4"/>بَرِ مَ وٌ مَرِفِ عَلَتَلَ نَ وٌ قْشْ رَ وٌ يَشُييٍ فٍرٍدٍ. عَ عٍ رَيَرَبِمَ نّ وٌ بّ، وٌ قَ شُتُ سْتْ عٍ مَ.»<verse eid="DEU 20:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="DEU 20:5"/>نَ تّمُي مَنفّ شَ كُنتِفِيٍ شَ سْورِيٍ مَشْرِن، «مِشِ ندٍ نَ وٌ يَ مَ، نَشَن بَرَ فّ بَنشِ تِدٍ كْنْ عَ مُ سٌشِ عَ كُي سِندٍن؟ نَ كَنيِ شَ فبِلٍن عَ شْنيِ، بَرِ مَ شَ عَ قَشَ فٍرٍ كُي، مِشِ فبّتّ قَمَ نّ سٌدٍ عَ شَ بَنشِ كُي. <verse eid="DEU 20:5"/><verse number="6" style="v" sid="DEU 20:6"/>مِشِ ندٍ نَ وٌ يَ مَ بٍ، نَشَن وّنِ بِلِ سِشِ، عَ مُ عَ بٌفِ بَشِ سِندٍن؟ نَ كَنيِ شَ فبِلٍن عَ شْنيِ، بَرِ مَ شَ عَ قَشَ فٍرٍ كُي، مِشِ فبّتّ قَمَ نّ عَ شَ وّنِ بٌفِ بَدٍ. <verse eid="DEU 20:6"/><verse number="7" style="v" sid="DEU 20:7"/>مِشِ ندٍ نَ وٌ يَ مَ بٍ، نَشَن بَرَ وَ فِنّ شْن، كْنْ عَ مُ عَ قُتِشِ سِندٍن؟ نَ كَنيِ شَ فبِلٍن عَ شْنيِ، بَرِ مَ شَ عَ قَشَ فٍرٍ كُي، مِشِ فبّتّ قَمَ نّ عَ شَ فِنّ قُتِدٍ.» <verse eid="DEU 20:7"/><verse number="8" style="v" sid="DEU 20:8"/>مَنفّ شَ كُنتِفِيٍ مَن شَ سْورِيٍ مَشْرِن، «مِشِ ندٍ نَ وٌ يَ مَ بٍ لِمَنِيَ بَشِ نَشَن يِ، عَ فَاشُ؟ نَ كَنيِ قَن شَ فبِلٍن عَ شْنيِ عَلَكٌ عَ نَشَ لِمَنِيَ بَ عَ بٌورٍيٍ قَن يِ.» <verse eid="DEU 20:8"/><verse number="9" style="v" sid="DEU 20:9"/>مَنفّ شَ كُنتِفِيٍ نَ فّ وْيّندٍ حَمَ رَ، عٍ شَ مَنفّيٍ تِ يِ سْورِ شُندّيٍ يَ رَ.<verse eid="DEU 20:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 20:10"/>وٌ نَ وٌ مَكْرّ وٌ يَشُييٍ شَ تَايٍ رَ فٍرٍ سٌ كِ مَ، وٌ شَ لَنيِ مَشْرِن عٍ مَ. <verse eid="DEU 20:10"/><verse number="11" style="v" sid="DEU 20:11"/>شَ عٍ تِن نَ رَ، عٍ تَا نَادّ رَبِ وٌ بّ، عٍ بِرِن شَ لُ وٌ شَ يَامَرِ نَن بُن مَ، عٍ نُ دُوتِ قِ. <verse eid="DEU 20:11"/><verse number="12" style="v" sid="DEU 20:12"/>كْنْ شَ عٍ مُ تِن لَنيِ رَ، عٍ قَ وٌ يَابِ فٍرٍ رَ، نَ تّمُي وٌ شَ نَ تَا بِلِن. <verse eid="DEU 20:12"/><verse number="13" style="v" sid="DEU 20:13"/>وٌ مَرِفِ عَلَتَلَ عٍ رَيَرَبِمَ نّ وٌ بّ. وٌ شَ شّمّ بِرِن قَشَ سَنتِدّفّمَ رَ، <verse eid="DEU 20:13"/><verse number="14" style="v" sid="DEU 20:14"/>وٌ شَ فِنّيٍ، دِ مّيٍ، شُرُ سٍيٍ، نُن سٍ نَشَن بِرِن نَ تَا كُي، وٌ شَ عَ تٌنفٌ وٌ يّتّ بّ سّيوّ كُي. وٌ مَرِفِ عَلَتَلَ بَرَ نَ قِ وٌ مَ.<verse eid="DEU 20:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 20:15"/>وٌ شَ نَ مْولِ رَبَ تَايٍ قَن نَ، نَشٍيٍ مَكُيَ وٌ رَ، نَشٍيٍ مُ نَ تَايٍ يَ مَ وٌ قَمَ سَبَتِدٍ دّننَشّ. <verse eid="DEU 20:15"/><verse number="16" style="v" sid="DEU 20:16"/>كْنْ وٌ نَشَ سٍسٍ لُ عَ حِحّ رَ تَايٍ كُي، وٌ مَرِفِ عَلَتَلَ قَمَ نَشٍيٍ قِدٍ وٌ مَ كّ رَ. <verse eid="DEU 20:16"/><verse number="17" style="v" sid="DEU 20:17"/>وٌ شِتِكَيٍ، عَمٌرِكَيٍ، كَنَانكَيٍ، ثٍرٍ سِكَيٍ، هِوِكَيٍ، نُن يٍبُسُكَيٍ بِرِن هَلَكِمَ نّ عَلْ وٌ مَرِفِ عَلَتَلَ عَ مَسٍنشِ وٌ بّ كِ نَشّ، <verse eid="DEU 20:17"/><verse number="18" style="v" sid="DEU 20:18"/>عَلَكٌ عٍ نَشَ وٌ شَرَن نَ قٍ شْنشِيٍ رَبَقٍ رَ عٍ نَشٍيٍ رَبَمَ عٍ شَ عَلَيٍ بّ، نَ قَ قِندِ يُنُبِ قٍ رَ وٌ بّ وٌ مَرِفِ عَلَتَلَ مَبِرِ.<verse eid="DEU 20:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 20:19"/>وٌ نَ تَا ندٍ بِلِن عَ فٍرٍقٍ مَ، عَ مُ لَن وٌ شَ بٍيرَ تٌنفٌ سَنسِيٍ سّفّ شِلِ مَ. عٍ قِندِ مَ وٌ بَلٌسٍ نَن نَ. نَ دَاشَ سَنسِيٍ شَ مُ قِندِشِ وٌ فٍرٍقَيٍ رَ. <verse eid="DEU 20:19"/><verse number="20" style="v" sid="DEU 20:20"/>سَنسِ نَشٍيٍ بٌفِ مُ نْمَ دٌندٍ، وٌ نْمَ نٍيٍ تَن سّفّدٍ عٍ شَ قِندِ فٍرٍ سٌسٍ رَ وٌ بّ تَا مِشِيٍ شِلِ مَ، وٌ نُن نَشٍيٍ نَ فٍرٍقٍ هَن عٍ سَ رَيَرَبِمَ وٌ بّ تّمُي نَشّ.<verse eid="DEU 20:20"/></para>
  <chapter eid="DEU 20"/>
  <chapter number="21" style="c" sid="DEU 21"/>
  <para style="s">قَشَتِ كٌلٌنتَرٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 21:1"/>شَ عَ سَ لِ وٌ نَشَ مِشِ ندٍ قُرٍ تٌ بْشِ مَ بُرُنيِ، وٌ مَرِفِ عَلَتَلَ دّننَشّ قِشِ وٌ مَ، كْنْ وٌ مُ عَ قَشَمَ كٌلٌن سِندٍن، <verse eid="DEU 21:1"/><verse number="2" style="v" sid="DEU 21:2"/>وٌ شَ قٌرِيٍ نُن وٌ شَ كِيتِسَيٍ شَ عَ مَتٌ تَا مُندُن مَكْرّشِ نَ قُرٍ رَ. <verse eid="DEU 21:2"/><verse number="3" style="v" sid="DEU 21:3"/>عٍ نَ تَا كٌلٌن نَشَن مَكْرّشِ نَ رَ، نَ تَا قٌرِيٍ شَ نِنفٍ فِنّ تٌنفٌ، نَشَن سِنفٍ مُ نُ وَلِ، وُرِ مُ نُ شِرِ نَشَن كْن مَ، <verse eid="DEU 21:3"/><verse number="4" style="v" sid="DEU 21:4"/>عٍ شَ عَ شَنِن شُرٍ ندٍ مَ، نَشَن مُ شْرِ مَ، سَنسِ مُ رَوَلِمَ دّننَشّ، عٍ شَ عَ كٌبٍ فِرَ يٍ شْورَ. <verse eid="DEU 21:4"/><verse number="5" style="v" sid="DEU 21:5"/>نَ بِرِن شَ رَبَ لٍوِ شَ دِ سّرّشّدُبّيٍ يَ شْرِ، بَرِ مَ وٌ مَرِفِ عَلَتَلَ نٍيٍ نَن سُفَندِشِ عَ شَ وَلِ رَبَقٍ مَ، عٍ شَ دُبَ مِشِ بّ عَلَتَلَ شِلِ رَ، عٍ شَ كِيتِ سَ فٍرٍ شَ قٍ رَ.<verse eid="DEU 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="DEU 21:6"/>قٌرِ نَشٍيٍ بِرِن نَ تَا كُي نَشَن مَكْرّشِ قُرٍ يِرٍ رَ، عٍ شَ عٍ بّلّشّيٍ رَشَ نِنفٍ فِنّ قَرِ، عٍ نَشَن قَشَشِ شُرٍ كُي. <verse eid="DEU 21:6"/><verse number="7" style="v" sid="DEU 21:7"/>عٍ شَ عَ قَلَ، «مُشُ تَن شَ مُ قَشّ تِشِ، مُشُ مُ عَ رَبَمَ قَن كٌلٌن. <verse eid="DEU 21:7"/><verse number="8" style="v" sid="DEU 21:8"/>عَلَتَلَ، عِ شَ عِسِرَيِلَ حَمَ شُن سَرَ، عِ نَشَن شْرّيَشِ. يَندِ، عِ نَشَ قَشّ كٌتٍ دْشْ عِسِرَيِلَ شُن مَ، عٍ قْشِ مُ نَ نَشَن نَ.» نَ تّمُي عَلَتَلَ قَمَ نّ عٍ شُن سَرَدٍ. <verse eid="DEU 21:8"/><verse number="9" style="v" sid="DEU 21:9"/>وٌ نْمَ رَتَنفَدٍ يِ قَشّ تِقٍ مْولِ مَ، شَ وٌ عَلَتَلَ وَشْنقٍ رَبَمَ.<verse eid="DEU 21:9"/></para>
  <para style="s">فٍرٍ شَ فٍيلِمَنِيٍ</para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 21:10"/>وٌ نَ سِفَ وٌ يَشُييٍ فٍرٍدٍ، شَ وٌ مَرِفِ عَلَتَلَ عٍ رَيَرَبِ وٌ بّ، وٌ عٍ قِندِ وٌ شَ فٍيلِمَنِيٍ رَ، <verse eid="DEU 21:10"/><verse number="11" style="v" sid="DEU 21:11"/>تّمُندٍ مِشِ ندٍ يَ قَمَ نّ سِندٍ فٍيلِمَنِ فِنّ تٌقَنيِ ندٍ مَ. شَ نَ كَنيِ وَ مَ عَ دْشْقٍ نّ، <verse eid="DEU 21:11"/><verse number="12" style="v" sid="DEU 21:12"/>عَ نْمَ عَ شَنِندٍ عَ شْنيِ. نَ فِنّ شَ عَ يّتّ شُنيِ بِ، عَ عَ بّلّشّ شَلٍ مَشَبَ، <verse eid="DEU 21:12"/><verse number="13" style="v" sid="DEU 21:13"/>عَ دُفِ قَنيِ رَفٌرٌ عَ مَ. عَ شَ سَبَتِ عَ شَ مْرِ شْنيِ، عَ قَ عَ بَبَ نُن عَ نفَ شَ حْنقٍ رَبَ كِكٍ كٍرٍن بُن مَ. نَ دَنفِ شَنبِ شّمّ نْمَ عَ قِندِدٍ عَ شَ فِنّ رَ. <verse eid="DEU 21:13"/><verse number="14" style="v" sid="DEU 21:14"/>شَ عَ سَ لِ عَ شَ قٍ نَشَ رَحَاشُ عَ مَ، عَ نْمَ عَ بّحِندٍ عَ شَ سِفَ عَ وَشْندٍ، كْنْ عَ مُ لَنمَ عَ شَ عَ مَتِ كْبِرِ رَ، عَ مُ لَنمَ عَ شَ قِندِ عَ شَ كٌنيِ رَ، بَرِ مَ عَ نُ بَرَ قِندِ عَ شَ فِنّ رَ.<verse eid="DEU 21:14"/></para>
  <para style="s">دِ قٌرِ تِدٍ</para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 21:15"/>شَ عَ سَ لِ فِنّ قِرِن نَ شّمّ ندٍ يِ رَ، كٍرٍن قَ رَقَن عَ مَ دَنفِ بٌورٍ رَ، كْنْ عٍ قِرِنيِيٍ بَرَ دِ بَرِ عَ بّ، عَ مُ لَنمَ عَ شَ بَاتّ فِنّ شَ دِ رَقِسَ عَ بٌورٍ شَ دِ بّ، <verse eid="DEU 21:15"/><verse number="16" style="v" sid="DEU 21:16"/>عَ قَ قٌرِحَ تِدٍ قِ بَاتّ فِنّ شَ دِ مَ، عَ قَ عَ لِ نَ فِنّ بٌورٍ نَن سِنفٍ دِ بَرِشِ عَ بّ. <verse eid="DEU 21:16"/><verse number="17" style="v" sid="DEU 21:17"/>عَ لَنمَ عَ شَ عَ كٌلٌن فِنّ نَشَن نَحَاشُشِ عَ مَ نَ كِ، نَ نَن مَ دِ قِندِشِ دِ سِنفٍ رَ. عَ هَرِفٍ دْشْ قِرِن نَن سٌمَ دِ قٌرِ يِ رَ، بَرِ مَ نَ نَن قِندِشِ عَ شَ قٌنِكٍ دِ رَ. عَ تَن نَن لَنمَ عَ شَ دِ قٌرِحَ تِدٍ سْتْ.<verse eid="DEU 21:17"/></para>
  <para style="s">دِ شُرُتَرٍ</para>
  <para style="p">
    <verse number="18" style="v" sid="DEU 21:18"/>شَ عَ سَ لِ شّمّ ندٍ نَشَ دِ شّمّ كَلَبَنتٍ شُرُتَرٍ بَرِ، نَشَن مُ عَ تُلِ مَتِشِ عَ بَبَ نُن عَ نفَ شُي رَ، نَشَن تٌندِ مَ بِرَدٍ عٍ شَ سّرِيّ قْشْ رَ، <verse eid="DEU 21:18"/><verse number="19" style="v" sid="DEU 21:19"/>عَ لَنمَ نَ دِ بَبَ نُن عَ نفَ شَ عَ سُشُ، عٍ شَ عَ شَنِن قٌرِيٍ شْن مَ تَا سٌدٍ دّ رَ. <verse eid="DEU 21:19"/><verse number="20" style="v" sid="DEU 21:20"/>عٍ شَ عَ قَلَ عٍ بّ، «مُشُ شَ دِ نَشَن يِ كِ، عَ شُرُتَرٍ، عَ كَلَبَنتٍ. مُشُ قٍ نَشَن بِرِن قَلَمَ عَ بّ، عَ مُ عَ تُلِ مَتِمَ عَ رَ، قٌ وَيُحَ رَبَقٍ نُن سِيسِ قٍ.» <verse eid="DEU 21:20"/><verse number="21" style="v" sid="DEU 21:21"/>نَ كُي، عَ شَ تَا شّمّ بِرِن شَ عَ مَفْنْ فّمّ رَ، هَن عَ قَشَ. وٌ قٍ حَاشِ حْنمَ وٌ تَفِ نَ كِ نّ. عِسِرَيِلَكَيٍ نَ نَ قٍ مّ، فَاشُي لُمَ نّ عٍ بِرِن مَ.<verse eid="DEU 21:21"/></para>
  <para style="s">مِشِ فبَكُشِ قُرٍ</para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 21:22"/>شَ عَ سَ لِ وٌ بَرَ مِشِ فبَكُ وُرِ كْن نَ، نَشَن بَرَ يُنُبِ قٍ رَبَ عَ لَن عَ شَ قَشَ نَشَن مَ، <verse eid="DEU 21:22"/><verse number="23" style="v" sid="DEU 21:23"/>عَ قُرٍ مُ لَن عَ شَ لُ وُرِ كْن نَ هَن فّيسّفّ. عَ لَن نّ عَ شَ رَفَتَ نَ لْشْي كٍرٍنيِ، بَرِ مَ عَلَ بَرَ قُرٍ فبَكُشِ دَنكَ. وٌ وٌ مّينِ كِ قَنيِ رَ، شَ نَ مُ عَ رَ نَ قُرٍ فبَكُشِ نَن بْشِ دَنكَمَ، وٌ مَرِفِ عَلَتَلَ دّننَشّ قِشِ وٌ مَ كّ رَ.<verse eid="DEU 21:23"/></para>
  <chapter eid="DEU 21"/>
  <chapter number="22" style="c" sid="DEU 22"/>
  <para style="s">شُرُ سٍ نُن سٍ لْيشِيٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 22:1"/>وٌ نَ وٌ نفَشَكٍرٍنيِ شَ نِنفٍ، شَ نَ مُ عَ رَ عَ شَ يّشّي تٌ، عَ مُرُتَشِ، وٌ نَشَ وٌ كٌبٍ تِ عَ رَ. وٌ لَن نّ وٌ شَ عَ شَنِن عَ كَنيِ شْن مَ. <verse eid="DEU 22:1"/><verse number="2" style="v" sid="DEU 22:2"/>شَ وٌ نفَشَكٍرٍنيِ يِرٍ مَكُيَ، شَ نَ مُ وٌ مُ عَ كَنيِ كٌلٌن، وٌ شَ شُرُ سٍ شَنِن وٌ شْنيِ. وٌ عَ رَفَتَ هَن بٍينُن وٌ عَ كَنيِ تٌمَ تّمُي نَشّ، وٌ قَ عَ سٌ عَ يِ رَ. <verse eid="DEU 22:2"/><verse number="3" style="v" sid="DEU 22:3"/>وٌ نَ مْولِ نَن نَبَمَ وٌ نفَشَكٍرٍنيِ شَ سٌقَلٍ قَن نَ، عَ شَ دٌنمَ، عَ نُن عَ فبٍ سٍ نَشَن بِرِن لْيشِ عَ مَ. وٌ مُ لَن وٌ شَ وٌ كٌبٍ تِ عَ رَ. <verse eid="DEU 22:3"/><verse number="4" style="v" sid="DEU 22:4"/>شَ وٌ بَرَ وٌ نفَشَكٍرٍنيِ شَ سٌقَلٍ، شَ نَ مُ عَ رَ عَ شَ نِنفٍ تٌ، عَ بَرَ بِرَ كِرَ شْن مَ، وٌ مُ لَن وٌ شَ وٌ كٌبٍ تِ عَ رَ. وٌ لَن نّ وٌ شَ كَقُ عَ مَ عَ رَكٍلِدٍ.<verse eid="DEU 22:4"/></para>
  <para style="s">شّمّ نَشٍيٍ عٍ يّتّ قِندِ مَ فِنّ رَ</para>
  <para style="p">
    <verse number="5" style="v" sid="DEU 22:5"/>فِنّ مُ لَن عَ شَ شّمّ دُفِ سٌ. شّمّ قَن مُ لَن عَ شَ فِنّ دُفِ سٌ. مِشِ نَشٍيٍ نَ قٍ مْولِ رَبَمَ، نَ كَنيِيٍ مُ رَقَن مَرِفِ عَلَتَلَ مَ.<verse eid="DEU 22:5"/></para>
  <para style="s">كِنِكِنِقٍ دَالِسٍيٍ مَ</para>
  <para style="p">
    <verse number="6" style="v" sid="DEU 22:6"/>وٌ نَ عَ تٌ كِرَ شْن مَ، شْنِ بَرَ عَ تّي سَ وُرِ كْن نَ، شَ نَ مُ عَ رَ بْشِ مَ، عَ نفَ قٍلٍنشِ عَ شّلّ مَ، شَ نَ مُ عَ رَ عَ شَ دِيٍ مَ، وٌ مُ لَن وٌ شَ عَ نفَ نُن عَ شَ دِيٍ بِرِن تٌنفٌ. <verse eid="DEU 22:6"/><verse number="7" style="v" sid="DEU 22:7"/>وٌ لَن نّ وٌ شَ عَ نفَ تَن نَبّحِن، عَ شَ سِفَ، وٌ قَ دِيٍ تَن تٌنفٌ. نَ كُي وٌ قَمَ نّ سِمَيَ شْنكُيٍ نُن هّيرِ سْتْدٍ.<verse eid="DEU 22:7"/></para>
  <para style="s">مِشِ رَتَنفَ كِ</para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 22:8"/>شَ وٌ بَنشِ نّينّ تِ، وٌ لَن نّ وٌ شَ بِلِشِ ندٍ رَبِلِن بَنشِ قُفٍ رَ، عَلَكٌ مِشِ نَشٍيٍ تٍمَ نَا، عٍ نَشَ بِرَ، عٍ قَ قَشَ وٌ سَابُي رَ.<verse eid="DEU 22:8"/></para>
  <para style="s">سٍ مَسُنبُقٍ</para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 22:9"/>وٌ مُ لَن وٌ شَ سَنسِ فبّتّ سِ وٌ شَ وّنِ بِلِيٍ يَ مَ، شَ نَ مُ عَ رَ عَ بٌفِ قَمَ قِندِدٍ سٍ رَهَرَ مُشِ نَن نَ. <verse eid="DEU 22:9"/><verse number="10" style="v" sid="DEU 22:10"/>وٌ نّ يِرٍ بُشَمَ، وٌ مُ لَن وٌ شَ نِنفٍ نُن سٌقَلٍ شِرِ عٍ بٌورٍ رَ سَرِ رَ. <verse eid="DEU 22:10"/><verse number="11" style="v" sid="DEU 22:11"/>وٌ مُ لَن وٌ شَ سٌسٍ رَفٌرٌ وٌ مَ نَشَن مَسُنبُشِ دُفِ يّشّي شَبٍ دَاشِ نُن فّسّ قُتٍ دَاشِ رَ.<verse eid="DEU 22:11"/></para>
  <para style="s">مَقٍلٍنيِ</para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 22:12"/>وٌ فّسّ نَن نَقَلَمَ ثٌنثٌن نَ وٌ عَ سِنفَن وٌ شَ دُفِ تُشُي نَانِيٍ رَ، وٌ نَشَن قٍلٍنمَ وٌ مَ.<verse eid="DEU 22:12"/></para>
  <para style="s">فِنّ قٍ كِيتِ</para>
  <para style="p">
    <verse number="13" style="v" sid="DEU 22:13"/>شَ عَ سَ لِ شّمّ ندٍ نَشَ فِنّ دْشْ، عٍ كَقُ، كْنْ عَ شَ قٍ تٌ رَحَاشُ شّمّ مَ، <verse eid="DEU 22:13"/><verse number="14" style="v" sid="DEU 22:14"/>عَ عَ شِلِ كَنَ وْيّن كٌبِ رَ، عَ نُ قَ عَ قَلَ، «ﭑ بَرَ يِ فِنّ دْشْ، كْنْ مُشُ تٌ كَقُ ﭑ نَشَ عَ لِ عَ بَرَ قُتِ كَنَ،» <verse eid="DEU 22:14"/><verse number="15" style="v" sid="DEU 22:15"/>نَ تّمُي فِنّ بَبَ نُن عَ نفَ شَ فِنّدِ مّدِ دُفِ شَنِن تَا قٌرِيٍ شْن مَ تَا سٌدٍ دّ رَ، نَشَن عَ مَسٍنشِ عَ عٍ شَ دِ قُتِ رَ سٌشِ. <verse eid="DEU 22:15"/><verse number="16" style="v" sid="DEU 22:16"/>عَ بَبَ شَ عَ تَفِ رَبَ، «ﭑ بَرَ ﭑ مَ دِ فِنّ قِ يِ شّمّ مَ، كْنْ عَ مُ رَقَن عَ مَ سْنْن. <verse eid="DEU 22:16"/><verse number="17" style="v" sid="DEU 22:17"/>عَ قَ وُلٍ نَن سَقٍ عَ شُن مَ عَ عَ مُ قُتِ رَ سٌشِ.» نَ تّمُي تّمّدِ شَ مِشِيٍ شَ نَ فِنّدِ مّدِ دُفِ عِتَلَ تَا قٌرِيٍ يَ عِ.<verse eid="DEU 22:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="DEU 22:18"/>تَا قٌرِيٍ نَ نَ تٌ، عٍ شَ نَ شّمّ سُشُ، عٍ شَ عَ حَشَنكَتَ. <verse eid="DEU 22:18"/><verse number="19" style="v" sid="DEU 22:19"/>عٍ نَ عَ مَكِيتِ، عٍ شَ عَلَمَنِ بٌلٌن عَ مَ نَشَن قِندِ مَ كْبِرِ كٌلٍ كّمّ سٌقٍ رَ تّمّدِ بَبَ يِ رَ، عِسِرَيِلَ فِنّ شِلِ كَنَقٍ مَ. نَ شَنبِ عَ لَن نّ فِنّ شَ فبِلٍن شّمّ شْنيِ، نَ شّمّ نَشَ مّي عَ رَ عَبَدَن.<verse eid="DEU 22:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="DEU 22:20"/>كْنْ شَ قُتِ كَنَقٍ قَ سَ قِندِ نْندِ رَ، فِنّدِ مّدِ دُفِ يٌ مُ نَ نَشَن عَ مَسٍنمَ عَ بَرَ قُتِ رَ سٌ، <verse eid="DEU 22:20"/><verse number="21" style="v" sid="DEU 22:21"/>نَ فِنّ شَ شَنِن عَ بَبَ شَ بَنشِ سٌدٍ دّ رَ، تَا مِشِيٍ قَ عَ مَفْنْ فّمّ رَ هَن عَ قَشَ، بَرِ مَ عَ بَرَ قٍ كٌبِ رَبَ فِنّ مُ لَن عَ شَ نَشَن نَبَ عِسِرَيِلَ بْشِ مَ، شّمّ قٍ كٌلٌنقٍ رَ عَ نَ عَ بَبَ شَ نْي بُن مَ تّمُي نَشّ. وٌ قٍ حَاشِ حْنمَ وٌ تَفِ نَ كِ نّ.<verse eid="DEU 22:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 22:22"/>شَ وٌ شّمّ سُشُ، عٍ نُن فِنّ شّمّ تَا عِدْشْي سَشِ، نَ قٍ كٌبِ رَبَ قِرِنيِيٍ لَن نّ عٍ شَ قَشَ، فِنّ نُن شّمّ. وٌ قٍ حَاشِ حْنمَ نَ كِ نّ وٌ تَفِ عِسِرَيِلَ بْشِ مَ.<verse eid="DEU 22:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="DEU 22:23"/>شَ شّمّ نَرَلَن فِنّ دِ مّدِ ندٍ رَ تَا كُي، كٌتٍ بَرَ دْشْ نَشَن مَ قٍ رَ، عَ قَ عَ قُتِ كَنَ، <verse eid="DEU 22:23"/><verse number="24" style="v" sid="DEU 22:24"/>وٌ شَ نَ مِشِ قِرِنيِيٍ شَنِن تَا سٌدٍ دّ رَ، وٌ عٍ مَفْنْ فّمّ رَ هَن عٍ شَ قَشَ. يِ فِنّ دِ مّدِ قَشَشِ نّ، بَرِ مَ عَ مُ سْنشْي رَتٍشِ تَا كُي. شّمّ قَن قَشَشِ نّ، بَرِ مَ عَ بَرَ فِنّ قُتِ كَنَ كٌتٍ بَرَ دْشْ نَشَن مَ قٍ رَ. وٌ قٍ حَاشِ حْنمَ وٌ تَفِ نَ كِ نّ.<verse eid="DEU 22:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="DEU 22:25"/>كْنْ شَ شّمّ نَرَلَن فِنّ دِ مّدِ رَ وُلَ عِ، كٌتٍ بَرَ دْشْ نَشَن مَ قٍ رَ، عَ نَشَ دُتُن عَ مَ، عَ عَ قُتِ كَنَ، نَ شّمّ نَن كٍرٍن لَن عَ شَ قَشَ. <verse eid="DEU 22:25"/><verse number="26" style="v" sid="DEU 22:26"/>وٌ نَشَ قٍقٍ رَبَ فِنّ دِ مّدِ تَن نَ، بَرِ مَ عَ مُ قٍ حَاشِ يٌ رَبَشِ عَ لَن عَ شَ قَشَ نَشَن مَ. يِ قٍ مَنِيَشِ نّ عَلْ شّمّ نَشَن وَشِ عَ بٌورٍ قَشَقٍ. <verse eid="DEU 22:26"/><verse number="27" style="v" sid="DEU 22:27"/>نَ نَرَلَنيِ رَبَشِ وُلَ نّ. هَلِ يِ فِنّ دِ مّدِ شّمّ كَنيِ سْنشْي رَتٍ نُ، مِشِ يٌ مُ سْتْمَ نَشَن نْمَ عَ رَتَنفَدٍ.<verse eid="DEU 22:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="DEU 22:28"/>شَ شّمّ نَرَلَن فِنّ دِ مّدِ رَ كٌتٍ مُ نُ دْشْ نَشَن مَ قٍ رَ، عَ نَشَ بَفَن عَ مَ، عَ عَ قُتِ كَنَ، مِشِ ندٍ قَ عٍ سُشُ نَ قٍ شُن، <verse eid="DEU 22:28"/><verse number="29" style="v" sid="DEU 22:29"/>نَ شّمّ كْبِرِ كٌلٍ تٌنفٌ سُولِ نَن سٌمَ فِنّ بَبَ يِ رَ، عَ قَ يِ فِنّ دْشْ، بَرِ مَ عَ بَرَ عَ قُتِ كَنَ. عَ شَ سِمَيَ كُي، عَ مُ لَن عَ شَ مّي نَ فِنّ رَ.<verse eid="DEU 22:29"/></para>
  <chapter eid="DEU 22"/>
  <chapter number="23" style="c" sid="DEU 23"/>
  <para style="s">لَنفٌيحَ مْولِ ندٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 23:1"/>مِشِ يٌ مُ لَن عَ نُن عَ بَبَ شَ فِنّ شَ كَقُ. عَ تَنَ قٍ نَن نَ رَ عَ بَبَ مَبِرِ.<verse eid="DEU 23:1"/></para>
  <para style="s">مِشِ نَشٍيٍ مُ لَن عٍ شَ لَن عَلَتَلَ شَ مَلَنيِ</para>
  <para style="p">
    <verse number="2" style="v" sid="DEU 23:2"/>مِشِ نَشَن شّمّيَ كَنَشِ، شَ نَ مُ عَ رَ عَ بٌلٌنشِ، نَ كَنيِ مُ لَن عَ شَ سِفَ عَلَتَلَ شَ مَلَنيِ. <verse eid="DEU 23:2"/><verse number="3" style="v" sid="DEU 23:3"/>يَنفَمَدِ قَن مُ سِفَمَ عَلَتَلَ شَ مَلَنيِ هَلِ عَ بْنسْي قُ ندٍ.<verse eid="DEU 23:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="DEU 23:4"/>عَمٌنِكَيٍ نُن مٌوَبَكَيٍ مُ سِفَمَ عَلَتَلَ شَ مَلَنيِ هَلِ عٍ بْنسْي قُ ندٍ. <verse eid="DEU 23:4"/><verse number="5" style="v" sid="DEU 23:5"/>عَ لُمَ عٍ بّ نَ كِ نّ كُدّءِ بَرِ مَ يِ حَمَيٍ مُ قَ وٌ رَلَندٍ تَامِ نُن يٍ رَ، وٌ نُ نَ كِرَ شْن مَ تّمُي نَشّ وٌ كٍلِشِ مِسِرَ. عٍ بٍيٌرِ شَ دِ شّمّ بَلَمِ نَن سَرٍ قِ وٌ دَنكَقٍ مَ ثٍتٌرِ، مٍسٌثٌتَمِيَ بْشِ مَ. <verse eid="DEU 23:5"/><verse number="6" style="v" sid="DEU 23:6"/>كْنْ وٌ مَرِفِ عَلَتَلَ مُ تِن عَ تُلِ مَتِدٍ بَلَمِ رَ. عَ نَشَ نَ دَنكّ مَسَرَ بَرَكّ رَ بَرِ مَ وٌ رَقَن وٌ مَرِفِ عَلَتَلَ مَ. <verse eid="DEU 23:6"/><verse number="7" style="v" sid="DEU 23:7"/>وٌ نَشَ وٌ حّنفِ سَ عٍ شَ بْحّسَ نُن عٍ شَ بَلٌي قٍ شْن مَ وٌ شَ سِمَيَ كُي.<verse eid="DEU 23:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 23:8"/>وٌ نَشَ قٍ حَاشِ يٌ رَبَ عٍدٌنكَيٍ رَ، بَرِ مَ وٌ نفَشَكٍرٍنيِ نَن نَ عٍ رَ. وٌ نَشَ قٍ حَاشِ يٌ نِيَ مِسِرَكَيٍ رَ، بَرِ مَ وٌ سَشَنيِ رَبَ نّ عٍ شَ بْشِ مَ. <verse eid="DEU 23:8"/><verse number="9" style="v" sid="DEU 23:9"/>عٍ قَمَ بْنسْي نَشٍيٍ سْتْدٍ، قٌ عٍ تٌلٌبِتّيٍ، نٍيٍ نَن قَمَ سِفَدٍ عَلَتَلَ شَ مَلَنيِ.<verse eid="DEU 23:9"/></para>
  <para style="s">سْورِ تّتّ كُي شَ سّنِيّنيِ</para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 23:10"/>وٌ نَ مِنِ قَقٍ رَ تِدٍ وٌ يَشُييٍ يَ رَ، وٌ لَن نّ وٌ شَ وٌ يّتّ رَتَنفَ قٍ كٌبِ بِرِن مَ. <verse eid="DEU 23:10"/><verse number="11" style="v" sid="DEU 23:11"/>شَ شّمّ ندٍ نَ وٌ يَ مَ نَشَن مُ سّنِيّنشِ، عَ بَرَ مَكَنَ وَنتَنيِ كُي، عَ لَن نّ عَ شَ مِنِ سْورِ تّتّ قَرِ مَ. <verse eid="DEU 23:11"/><verse number="12" style="v" sid="DEU 23:12"/>نُنمَرٍ رَ، عَ نَ عَ مَشَ يٍ رَ، سٌفٍ فٌرٌ تّمُي عَ قَ سٌ سْورِ تّتّ كُي.<verse eid="DEU 23:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="DEU 23:13"/>وٌ قَمَ يِرٍ ندٍ نَن سُفَندِدٍ دّننَشّ مَكُيَ سْورِ تّتّ رَ، نَا شَ قِندِ سُتُرَدٍ رَ. <verse eid="DEU 23:13"/><verse number="14" style="v" sid="DEU 23:14"/>يِلِ فٍ سٍ ندٍ لَن نّ عَ شَ لُ وٌ شَ كٌتٍ عِ. وٌ نَ سِفَ سُتُرَدٍ، وٌ يِلِ فٍ. وٌ نَ فّ وٌ هَيِ رَبَدٍ، وٌ عَ مَكٌتٌ، وٌ قَ كٍلِ نَا. <verse eid="DEU 23:14"/><verse number="15" style="v" sid="DEU 23:15"/>وٌ شَ سْورِ تّتّ لَن نّ عَ شَ سّنِيّن، بَرِ مَ وٌ مَرِفِ عَلَتَلَ عَ مَحّرّ مَ عَ كُي وٌ كَنتَقٍ رَ، عَ مَن قَ وٌ يَشُييٍ رَيَرَبِ وٌ بّ. شَ عَ قٍ حَاشِ لِ سْورِ تّتّ كُي، عَ عَ مَكُيَمَ نّ وٌ رَ.<verse eid="DEU 23:15"/></para>
  <para style="s">سّرِيّ كٌنيِ شَ قٍ رَ</para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 23:16"/>شَ كٌنيِ ندٍ عَ فِ عَ كَنيِ مَ، عَ نَشَ سِفَ لُدٍ وٌ شْنيِ، وٌ نَشَ فبِلٍن عَ رَ عَ كَنيِ شْن مَ دٍ. <verse eid="DEU 23:16"/><verse number="17" style="v" sid="DEU 23:17"/>عَ لَن نّ عَ شَ سَبَتِ وٌ شَ تَا ندٍ كُي دّننَشّ نَ رَقَن عَ مَ. وٌ مَن نَشَ عَ تْورْ دٍ.<verse eid="DEU 23:17"/></para>
  <para style="s">لَنفٌيحَ</para>
  <para style="p">
    <verse number="18" style="v" sid="DEU 23:18"/>عِسِرَيِلَ شّمّ، شَ نَ مُ عَ فِنّ مُ لَن عَ شَ لَنفٌيحَ رَبَ. <verse eid="DEU 23:18"/><verse number="19" style="v" sid="DEU 23:19"/>لَنفٌي سَرٍ مُ لَن عَ شَ سٌ وٌ مَرِفِ عَلَتَلَ شَ هْرْ مْبَنشِ كُي لَايِدِ رَكَمَلِسٍ رَ، بَرِ مَ وٌ مَرِفِ عَلَتَلَ نَ قٍ مْولِ شْنشِ.<verse eid="DEU 23:19"/></para>
  <para style="s">دٌنِ نُن دَاكَن</para>
  <para style="p">
    <verse number="20" style="v" sid="DEU 23:20"/>وٌ نَ سٍ ندٍ دٌنِ وٌ نفَشَكٍرٍنيِ بّ، كْبِرِ، دٌنسٍ، شَ نَ مُ عَ رَ سٍ فبّتّ، وٌ نَشَ فٍينِ يٌ قٍن عَ قَرِ. <verse eid="DEU 23:20"/><verse number="21" style="v" sid="DEU 23:21"/>عَلَ كٌلٌنتَرٍ نَن لَنمَ عَ شَ وٌ شَ فٍينِ سَ، كْنْ وٌ نفَشَكٍرٍنيِ تَن مُ عَ رَ دٍ. وٌ نَ نَ سّرِيّ رَبَتُ بْشِ مَ وٌ قَمَ دّننَشّ سْتْدٍ، وٌ مَرِفِ عَلَتَلَ بَرَكّ سَمَ نّ وٌ عِسٌقٍ بِرِن مَ.<verse eid="DEU 23:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 23:22"/>وٌ نَ دَاكَن تٌنفٌ وٌ مَرِفِ عَلَتَلَ بّ، وٌ نَشَ تَشِرِ عَ رَبَقٍ مَ، شَ نَ مُ وٌ مَرِفِ عَلَتَلَ عَ مَشْرِنمَ نّ وٌ مَ، وٌ قَ قِندِدٍ يُنُبِتْييٍ رَ. <verse eid="DEU 23:22"/><verse number="23" style="v" sid="DEU 23:23"/>شَ وٌ مُ دَاكَن تٌنفٌشِ، يُنُبِ قٍ مُ نَ. <verse eid="DEU 23:23"/><verse number="24" style="v" sid="DEU 23:24"/>كْنْ شَ وٌ دَاكَن تٌنفٌ وٌ مَرِفِ عَلَتَلَ بّ، وٌ لَن نّ وٌ شَ عَ رَبَ كٍرٍن نَ عَ قَنيِ رَ. وٌ قَ عَ رَبَ عَلْ وٌ عَ حَنِفٍشِ وٌ دّ رَ كِ نَشّ.<verse eid="DEU 23:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="DEU 23:25"/>وٌ نْمَ وُرِ بٌفِ ندٍيٍ بَدٍ وٌ فبٍ مُ نَشٍيٍ رَ، وٌ عَ دٌن هَن وٌ لُفَ، كْنْ عَ مُ لَن وٌ شَ ندٍ سَ وٌ شَ كٌتٍ عِ. <verse eid="DEU 23:25"/><verse number="26" style="v" sid="DEU 23:26"/>وٌ نَ سٌ مّنفِ شّ قَن نَ، وٌ فبٍ مُ نَشَن نَ، وٌ نْمَ تْنسْي ندٍيٍ بَدٍ وٌ بّلّشّ رَ، كْنْ وٌ مُ لَن وٌ شَ وْرْتّ تٌنفٌ وٌ نفَشَكٍرٍنيِ شَ مّنفِ شِلِ مَ.<verse eid="DEU 23:26"/></para>
  <chapter eid="DEU 23"/>
  <chapter number="24" style="c" sid="DEU 24"/>
  <para style="s">شّمّ نُن فِنّ قَتَنقٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 24:1"/>عَ نْمَ عَ لِدٍ شّمّ ندٍ شَ فِنّ مُ رَقَنشِ عَ مَ سْنْن، عَ قَتَن كّيدِ سّبّ، عَ عَ سٌ عَ يِ رَ، عَ قَ عَ رَ سِفَ عَ بَبَ شْنيِ. <verse eid="DEU 24:1"/><verse number="2" style="v" sid="DEU 24:2"/>نَ تّمُي شَ نَ فِنّ دْشْ شّمّ فبّتّ شْن مَ، <verse eid="DEU 24:2"/><verse number="3" style="v" sid="DEU 24:3"/>عَ شَ قٍ رَحَاشُ نَ شّمّ قَن مَ، نَ قَن قَ قَتَن كّيدِ سّبّ، عَ عَ سٌ عَ يِ رَ، عَ قَ عَ رَ سِفَ عَ بَبَ شْنيِ، شَ نَ شّمّ قَ سَ قَشَ نّ، <verse eid="DEU 24:3"/><verse number="4" style="v" sid="DEU 24:4"/>شّمّ نَشَن سِنفٍ مّي نَ فِنّ رَ، نَ مُ لَن عَ شَ عَ قِندِ عَ شَ فِنّ رَ كْرّ، بَرِ مَ عَ بَرَ رَهَرَ مُحَ عَ مَ. عَلَتَلَ نَ قٍ مْولِ شْنشِ. وٌ مُ لَن وٌ شَ نَ يُنُبِ مْولِ رَبَ بْشِ مَ وٌ مَرِفِ عَلَتَلَ دّننَشّ قِشِ وٌ مَ كّ رَ.<verse eid="DEU 24:4"/></para>
  <para style="s">سّرِيّ نَشَن عِبُنَدَ مَ رَتَنفَمَ</para>
  <para style="p">
    <verse number="5" style="v" sid="DEU 24:5"/>شّمّ نَشَن بَشِ فِنّ دْشْدٍ، عَ مُ لَن عَ شَ سْورِحَ رَبَ وَشَتِ ندٍ بُن مَ. كْنتْقِلِ فبّتّ يٌ مُ لَن عَ شَ دْشْ عَ رَ حّ كٍرٍن بُن مَ، عَلَكٌ عَ شَ مّينِ عَ شَ فِنّ دْشْشِ مَ.<verse eid="DEU 24:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="DEU 24:6"/>وٌ مُ لَن وٌ شَ مُلُنيِ نُن كِلٍ رَ سُشُ مِشِ يِ سّيكّ رَ، شَ نَ مُ عَ رَ كِلٍ فبَنسَن، بَرِ مَ وٌ عَ بَلٌسٍ نَن بَمَ عَ يِ رَ نَ كِ.<verse eid="DEU 24:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 24:7"/>شَ عِسِرَيِلَكَ عَ نفَشَكٍرٍنيِ ندٍ سُشُ نْي رَ، عَ عَ قِندِ كٌنيِ رَ، شَ نَ مُ عَ عَ مَتِ، عَ لَن نّ نَ كَنيِ شَ قَشَ. وٌ قٍ حَاشِ حْنمَ وٌ تَفِ نَ كِ نّ.<verse eid="DEU 24:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 24:8"/>وٌ لَن نّ وٌ شَ قّنتّن كُنّ قُرٍ شَ قٍ رَ. ﭑ شَرَنيِ نَشَن سٌشِ لٍوِ شَ دِ سّرّشّدُبّيٍ يِ، وٌ لَن نّ وٌ شَ نَ رَبَ عَ رَبَ كِ مَ. <verse eid="DEU 24:8"/><verse number="9" style="v" sid="DEU 24:9"/>وٌ شَ رَتُ عَ مَ عَ وٌ مَرِفِ عَلَتَلَ نَشَن نَبَ مَرِيَمَ رَ وٌ كٍلِشِ مِسِرَ تّمُي نَشّ.<verse eid="DEU 24:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 24:10"/>وٌ نَ دٌنِ تِ وٌ نفَشَكٍرٍنيِ بّ، عَ مُ لَنمَ وٌ تَن شَ سٌ عَ شْنيِ عَ شَ سّيكّ سٍ تٌنفٌدٍ. <verse eid="DEU 24:10"/><verse number="11" style="v" sid="DEU 24:11"/>وٌ شَ لُ تَندٍ، وٌ شَ دٌنِقَ شَ قَ سّيكّ سٍ رَ وٌ شْن مَ، عَ عَ سٌ وٌ يِ رَ. <verse eid="DEU 24:11"/><verse number="12" style="v" sid="DEU 24:12"/>شَ سٍتَرٍ نَ عَ رَ، عَ قَ عَ شَ شِنبٍلِ دٌنمَ سٌ وٌ يِ سّيكّ سٍ رَ، وٌ مُ لَن وٌ شَ نَ رَفَتَ وٌ شْنيِ كْي رَ. <verse eid="DEU 24:12"/><verse number="13" style="v" sid="DEU 24:13"/>وٌ شَ عَ رَفبِلٍن عَ مَ سٌفٍ فٌرٌ وَشَتِ نّ، عَلَكٌ عَ شَ عَ قٍلٍن عَ مَ كْي رَ. نَ كُي عَ عَلَ مَشَندِ مَ نّ وٌ بّ. سٍتَرٍ مَلِقٍ نَ كِ عَ قِندِ مَ تِنشِنيِ نَن نَ وٌ نُن وٌ مَرِفِ عَلَتَلَ تَفِ.<verse eid="DEU 24:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="DEU 24:14"/>وٌ مُ لَن وٌ شَ وٌ شَ وَلِكّ سٍتَرٍيٍ تْورْ، عٍ قِندِ وٌ نفَشَكٍرٍنيِيٍ رَ، شَ نَ مُ عٍ قِندِ شْحّيٍ رَ. <verse eid="DEU 24:14"/><verse number="15" style="v" sid="DEU 24:15"/>لْشْي بِرِن وٌ لَن نّ وٌ شَ عٍ شَ وَلِ سَرٍ قِ عٍ مَ بٍينُن سٌفٍ شَ فٌرٌ، بَرِ مَ سٍتَرٍ نَن عٍ رَ، عٍ هَيِ نَ نَ مَ. شَ وٌ مُ نَ رَبَمَ، عَ مَوَ مَ نّ عَلَتَلَ بّ وٌ شَ قٍ رَ، وٌ قَ يُنُبِ سْتْ نَ كُي.<verse eid="DEU 24:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 24:16"/>دِ بَبَيٍ مُ لَن عٍ شَ قَشَ عٍ شَ دِيٍ شَ يُنُبِيٍ رَبَقٍ مَ. دِيٍ قَن مُ لَن عٍ شَ قَشَ عٍ بَبَيٍ شَ يُنُبِيٍ رَبَقٍ مَ. عِبُنَدَ مَ لَنمَ عَ شَ قَشَ عَ يّتّ شَ يُنُبِ رَبَشِ نَن مَ.<verse eid="DEU 24:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="DEU 24:17"/>وٌ نَشَ تِنشِنتَرٍيَ رَبَ مِشِيٍ رَ نَشٍيٍ قَشِ سَبَتِدٍ وٌ شَ بْشِ مَ. وٌ نَشَ كِرِدِيٍ تْورْ. وٌ نَشَ كَاحّ فِنّ شَ دٌنمَ تٌنفٌ سّيكّ رَ. <verse eid="DEU 24:17"/><verse number="18" style="v" sid="DEU 24:18"/>وٌ شَ رَتُ عَ مَ عَ وٌ مَرِفِ عَلَتَلَ وٌ شْرّيَشِ كِ نَشّ وٌ شَ كٌنيِيَ كُي مِسِرَ بْشِ مَ. نَ قٍ نَ عَ تٌشِ ﭑ يِ يَامَرِ قِشِ وٌ مَ.<verse eid="DEU 24:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 24:19"/>وٌ نَ فّ شّ شَبَدٍ، وٌ نَشَ فبِلٍن تْنسْي دْنشْييٍ تٌنفٌ رَ. وٌ شَ عٍ لُ شْحّيٍ، كِرِدِيٍ، نُن كَاحّ فِنّيٍ بّ، عَلَكٌ وٌ مَرِفِ عَلَتَلَ شَ بَرَكّ سَ وٌ شَ قٍ. <verse eid="DEU 24:19"/><verse number="20" style="v" sid="DEU 24:20"/>وٌ نَ فّ عٌلِوِ بِلِ عِقُيَنقُيَندٍ، وٌ نَشَ فبِلٍن بٌفِ دْنشْييٍ بَدٍ سَنسِيٍ كْن نَ. وٌ شَ عٍ لُ شْحّيٍ، كِرِدِيٍ، نُن كَاحّ فِنّيٍ بّ. <verse eid="DEU 24:20"/><verse number="21" style="v" sid="DEU 24:21"/>وٌ نَ فّ وّنِ بٌفِ بَدٍ، وٌ نَشَ فبِلٍن بٌفِ دْنشْييٍ بَ رَ. وٌ شَ عٍ لُ شْحّيٍ، كِرِدِيٍ، نُن كَاحّ فِنّيٍ بّ. <verse eid="DEU 24:21"/><verse number="22" style="v" sid="DEU 24:22"/>وٌ شَ رَتُ وٌ شَ كٌنيِيَ مَ مِسِرَ بْشِ مَ. نَ قٍ نَ عَ تٌشِ ﭑ يِ يَامَرِ قِشِ وٌ مَ.<verse eid="DEU 24:22"/></para>
  <chapter eid="DEU 24"/>
  <chapter number="25" style="c" sid="DEU 25"/>
  <para style="s">سّرِيّ لُشُسِنيِ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 25:1"/>شَ عَ سَ لِ مِشِ قِرِن نَشَ فٍرٍ، كِيتِسَ شَ عٍ مَتٌ تِنشِنيِ كُي سّرِيّ كِ مَ. <verse eid="DEU 25:1"/><verse number="2" style="v" sid="DEU 25:2"/>نْندِ مُ نَ نَشَن بّ، شَ عَ لَنمَ عَ شَ بْنبْ، نَ شَ رَبَ كِيتِسَ يَ شْرِ قٍ رَبَشِ بّرّ مَ. <verse eid="DEU 25:2"/><verse number="3" style="v" sid="DEU 25:3"/>نَ كُي، وٌ مُ لَن وٌ شَ دَنفِ لُشُسِنيِ يَ تٌنفٌ نَانِ رَ. شَ وٌ ندٍ سَ نَ قَرِ، وٌ بَرَ وٌ نفَشَكٍرٍنيِ رَيَرَبِ.<verse eid="DEU 25:3"/></para>
  <para style="s">نِنفٍ شَ وَلِ</para>
  <para style="p">
    <verse number="4" style="v" sid="DEU 25:4"/>وٌ نَ نِنفٍ رَوَلِ مّنفِ تُرُشُندٍ تّمُي نَشّ، وٌ مُ لَن وٌ شَ عَ دّ شِرِ.<verse eid="DEU 25:4"/></para>
  <para style="s">كَاحّ فِنّ دِتَرٍ</para>
  <para style="p">
    <verse number="5" style="v" sid="DEU 25:5"/>شَ نفَشَكٍرٍنمَ قِرِن سَبَتِ يِرٍ كٍرٍن، كٍرٍن قَ قَشَ عَ دِتَرٍ رَ، عَ شَ كَاحّ فِنّ مُ لَن عَ شَ دْشْ شّمّ فبّتّ شْن مَ شَبِلّ فبّتّ كُي. عَ لَن عَ شَ دْشْ عَ نِمْشْ نَن شْن مَ، عَ قِندِ عَ شَ فِنّ رَ. <verse eid="DEU 25:5"/><verse number="6" style="v" sid="DEU 25:6"/>نَ فِنّ دِ سِنفٍ نَشَن بَرِ مَ عَ نِمْشْ بّ، عَ شَ قِندِ عَ شَ مْرِ سِنفٍ شَ دِ نَن نَ كّ كِ مَ، عَلَكٌ عَ شَ مْرِ شِلِ نَشَ لْي عِسِرَيِلَ بْشِ مَ.<verse eid="DEU 25:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 25:7"/>شَ نَ شّمّ تٌندِ عَ نِمْشْ دْشْدٍ، كَاحّ فِنّ شَ سِفَ تَا قٌرِيٍ نَن شْن مَ كِيتِسَيٍ يِرٍ، عَ عَ تَفِ رَبَ عٍ بّ يِ كِ، «ﭑ نِمْشْ بَرَ تٌندِ بْنسْي قِدٍ عَ نفَشَكٍرٍنيِ مَ، عَ مُ تِنمَ عَ شَ سّرِيّ رَكَمَلِدٍ ﭑ تَن مَبِرِ.» <verse eid="DEU 25:7"/><verse number="8" style="v" sid="DEU 25:8"/>تَا قٌرِيٍ شَ نَ شّمّ شِلِ، عٍ شَ نَ قٍ مَتٌ. شَ نَ شّمّ تٌندِ عَ نفَشَكٍرٍنيِ شَ كَاحّ فِنّ دْشْدٍ، <verse eid="DEU 25:8"/><verse number="9" style="v" sid="DEU 25:9"/>كَاحّ فِنّ شَ عَ مَكْرّ عَ رَ تَا قٌرِيٍ يَ شْرِ، عَ شَ عَ نِمْشْ شَ سَنكِرِ بَ، عَ دّيٍ بْشُن عَ يَتَفِ، عَ قَلَقٍ رَ، «يِ مْولِ نَن لَن عَ شَ رَبَ شّمّ رَ نَشَن تٌندِ مَ بْنسْي قِدٍ عَ نفَشَكٍرٍنيِ مَ.» <verse eid="DEU 25:9"/><verse number="10" style="v" sid="DEU 25:10"/>نَ تّمُي عِسِرَيِلَ، نَ شّمّ شَ دٍنبَيَ شِلِ قَلَمَ نّ، «سَنكِرِ بَ شَ دٍنبَيَ.»<verse eid="DEU 25:10"/></para>
  <para style="s">دِنيِ نَشَن مُ لَن عَ شَ رَبَ فٍرٍ كُي</para>
  <para style="p">
    <verse number="11" style="v" sid="DEU 25:11"/>شَ عَ سَ لِ شّمّ قِرِن نَ فٍرٍقٍ، كٍرٍن شَ فِنّ قَ سِفَ عَ شَ مْرِ بَدٍ بٌورٍ يِ رَ عَ شّمّيَ سُشُقٍ رَ، <verse eid="DEU 25:11"/><verse number="12" style="v" sid="DEU 25:12"/>وٌ شَ نَ فِنّ بّلّشّ بٌلٌن، وٌ نَشَ كِنِكِنِ عَ مَ.<verse eid="DEU 25:12"/></para>
  <para style="s">تِنشِنيِ يُلّيَ كُي</para>
  <para style="p">
    <verse number="13" style="v" sid="DEU 25:13"/>وٌ نَشَ كِلٌي كَمَلِتَرٍ سَ وٌ شَ فبْنقْي كُي، ندٍيٍ بِنيَ، بٌورٍيٍ يٍلٍبُ. <verse eid="DEU 25:13"/><verse number="14" style="v" sid="DEU 25:14"/>وٌ نَشَ سٍ مَنِيَسٍ كَمَلِتَرٍ قَن لُ وٌ شْنيِ، ندٍيٍ شُنفبٌ، بٌورٍيٍ شُرُن. <verse eid="DEU 25:14"/><verse number="15" style="v" sid="DEU 25:15"/>كِلٌي كَمَلِشِ نُن سٍ مَنِيَسٍ كَمَلِشِ نَن لَن عَ شَ لُ وٌ يِ رَ. نَ تّمُي وٌ قَمَ نّ سِمَيَ شْنكُيٍ سْتْدٍ بْشِ مَ وٌ مَرِفِ عَلَتَلَ قَمَ دّننَشّ سٌدٍ وٌ يِ رَ. <verse eid="DEU 25:15"/><verse number="16" style="v" sid="DEU 25:16"/>مِشِ يٌ نَ مْولِ رَبَمَ، عَ مُ رَقَنمَ وٌ مَرِفِ عَلَتَلَ مَ.<verse eid="DEU 25:16"/></para>
  <para style="s">وٌ يَشُي عَمَلّكِكَيٍ</para>
  <para style="p">
    <verse number="17" style="v" sid="DEU 25:17"/>وٌ شَ رَتُ عَ مَ عَمَلّكِكَيٍ نَشَن نَبَ وٌ رَ وٌ تٌ كٍلِ مِسِرَ. <verse eid="DEU 25:17"/><verse number="18" style="v" sid="DEU 25:18"/>عٍ مُ فَاشُ عَلَ يَ رَ. عٍ مِنِ نّ وٌ مَ كِرَ شْن، عٍ شَنبِرَتِ تَفَنشِيٍ بْنبْ. <verse eid="DEU 25:18"/><verse number="19" style="v" sid="DEU 25:19"/>يَكْسِ، وٌ مَرِفِ عَلَتَلَ قَمَ نّ وٌ رَتَنفَدٍ وٌ يَشُييٍ مَ، نَشٍيٍ نَ وٌ رَبِلِنيِ بْشِ مَ عَ قَمَ دّننَشّ سٌدٍ وٌ يِ رَ. وٌ قَمَ عَمَلّكِكَيٍ رَهَلَكِدٍ، عَلَكٌ عٍ شِلِ شَ لْي دُنِحَ مَ. وٌ نَشَ نّيمُ عٍ شَ قٍ رَبَشِ مَ.<verse eid="DEU 25:19"/></para>
  <chapter eid="DEU 25"/>
  <chapter number="26" style="c" sid="DEU 26"/>
  <para style="s">بْشِ دَشَمُي سِنفٍ نُن قَرِلّ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 26:1"/>وٌ نَ سٌ بْشِ مَ وٌ مَرِفِ عَلَتَلَ نَشَن قِمَ وٌ مَ كّ رَ، عَ شَ قِندِ وٌ فبٍ رَ، وٌ شَ سَبَتِ نَا، <verse eid="DEU 26:1"/><verse number="2" style="v" sid="DEU 26:2"/>وٌ كٍرٍن كٍرٍن مَ قَمَ نَ دَشَمُي سِنفٍ سّيتِ بَدٍ وٌ مَرِفِ عَلَتَلَ بّ. وٌ عَ سَ دٍبٍ كُي، وٌ شَ عَ شَنِن يِرٍ، وٌ مَرِفِ عَلَتَلَ دّننَشّ سُفَندِشِ عَ شِلِ مَتْشْقٍ رَ. <verse eid="DEU 26:2"/><verse number="3" style="v" sid="DEU 26:3"/>وٌ شَ سِفَ سّرّشّدُبّيٍ شْن، نَشٍيٍ نَ نَا نَ وَشَتِ، وٌ شَ عَ قَلَ عٍ بّ، «تٌ لْشْي وٌن بَرَ سٌ بْشِ، وٌن مَرِفِ عَلَتَلَ دّننَشّ لَايِدِ وٌن بٍنبَيٍ بّ عَ سٌقٍ رَ وٌن يِ رَ.»<verse eid="DEU 26:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="DEU 26:4"/>سّرّشّدُبّ نَ دٍبٍ رَ سُشُمَ نّ وٌ يِ رَ، عَ عَ دْشْ وٌ مَرِفِ عَلَتَلَ شَ سّرّشّبَدٍ يَ عِ. <verse eid="DEU 26:4"/><verse number="5" style="v" sid="DEU 26:5"/>وٌ شَ يِ وْيّنيِ قَلَ وٌ مَرِفِ عَلَتَلَ بّ، «ﭑ بَبَ، عَرَ مِكَ نَن نُ عَ رَ نَشَن نُ عَ حّرّ مَ. عَ نَشَ فٌرٌ مِسِرَ مِشِ ندٍيٍ رَ، عَ سَشَنيِ رَبَ نَا. عٍ نَشَ وُيَ، هَن عٍ قِندِ سِ بٍلٍبٍلٍ سّنبّمَ رَ، <verse eid="DEU 26:5"/><verse number="6" style="v" sid="DEU 26:6"/>كْنْ مِسِرَكَيٍ تَن نَشَ مُشُ حَشَنكَتَ، عٍ مُشُ تْورْ، عٍ كٌنيِيَ شْرْشْي دْشْ مُشُ مَ. <verse eid="DEU 26:6"/><verse number="7" style="v" sid="DEU 26:7"/>مُشُ نَشَ مُشُ بٍنبَيٍ مَرِفِ عَلَتَلَ مَكُلَ، عَ شَ مُشُ مَلِ. عَ نَشَ مُشُ شَ مَشَندِ سُشُ، عَ مَن نَشَ مُشُ شَ مَنتْورْلِ تٌ، عٍ نُ قٍ حَاشِ نُن قٍ شْرْشْييٍ نَشٍيٍ دْشْمَ مُشُ مَ.»<verse eid="DEU 26:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 26:8"/>«عَلَتَلَ نَشَ مُشُ رَ مِنِ مِسِرَ بْشِ مَ سّنبّ مَفَاشُشِ، كَابَنَكٌي، نُن تْنشُمَيٍ رَ. <verse eid="DEU 26:8"/><verse number="9" style="v" sid="DEU 26:9"/>عَ نَشَ قَ مُشُ رَ هَن بٍ، عَ قَ يِ بْشِ سٌ مُشُ يِ رَ، شِحّ نُن كُمِ شّلّمَ دّننَشّ. <verse eid="DEU 26:9"/><verse number="10" style="v" sid="DEU 26:10"/>نَ نَن عَ تٌشِ، يَكْسِ ﭑ قَشِ يِ بْشِ دَشَمُي سِنفٍ رَ عِ تَن عَلَتَلَ شْن مَ، عِ نَشَن قِشِ ﭑ مَ.»</para>
  <para style="p" vid="DEU 26:10">وٌ شَ نَ دْشْ وٌ مَرِفِ عَلَتَلَ يَ عِ، وٌ عَ بَتُ. <verse eid="DEU 26:10"/><verse number="11" style="v" sid="DEU 26:11"/>وٌ شَ سّيوَ وٌ بٌورٍ رَ، وٌ تَن نُن لٍوِكَيٍ، عَ نُن شْحّ نَشٍيٍ نَ وٌ يَ مَ، بَرَكّ رَ، وٌ مَرِفِ عَلَتَلَ نَشَن قِشِ وٌ نُن وٌ شَ دٍنبَيَ مَ.<verse eid="DEU 26:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 26:12"/>حّ سَشَن يٌ حّ سَشَن نَ عَ لِ، وٌ شَ نَ حّ قَرِلّ قِ لٍوِكَيٍ، شْحّيٍ، كِرِدِيٍ، نُن كَاحّ فِنّيٍ مَ، نَشٍيٍ نَ وٌ شَ تَايٍ كُي. نٍيٍ قَن بَلٌي قِندِ مَ نَ نَن نَ. <verse eid="DEU 26:12"/><verse number="13" style="v" sid="DEU 26:13"/>نَ تّمُي، وٌ شَ عَ مَسٍن وٌ مَرِفِ عَلَتَلَ بّ، «نَشَن قِندِشِ عِ فبٍ رَ، ﭑ بَرَ عَ بِرِن نَمِنِ ﭑ شْنيِ. ﭑ بَرَ عَ سٌ لٍوِكَيٍ، شْحّيٍ، كِرِدِيٍ، نُن كَاحّ فِنّيٍ يِ عَلْ عِ عَ يَمَرِشِ كِ نَشّ مُشُ بّ. ﭑ مُ عِ شَ يَامَرِ مَتَندِشِ، ﭑ مُ نّيمُشِ كٍرٍن مَ. <verse eid="DEU 26:13"/><verse number="14" style="v" sid="DEU 26:14"/>ﭑ مُ قَرِلّ سِيَ دٌنشِ حْنيِ تٌ سٌ ﭑ مَ، شَ نَ مُ عَ رَ، ﭑ تٌ لُ سّنِيّنتَرٍحَ كُي. ﭑ مُ عَ قِشِ سّرّشّ رَ مِشِ قَشَشِ بّ. ﭑ بَرَ بِرَ عِ تَن، ﭑ مَرِفِ عَلَتَلَ، شُي نَن قْشْ رَ. عِ نَشَن يَمَرِشِ ﭑ بّ، ﭑ بَرَ نَ بِرِن نَبَ. <verse eid="DEU 26:14"/><verse number="15" style="v" sid="DEU 26:15"/>عِ شَ مُشُ مَتٌ، كٍلِقٍ عِ شَ كٌورٍ سّنِيّنشِ مَ. عِ شَ بَرَكّ سَ عِ شَ حَمَ عِسِرَيِلَ مَ، عِ شَ بَرَكّ سَ بْشِ مَ، عِ نَشَن قِشِ مُشُ مَ، عِ نَشَن لَايِدِشِ مُشُ بٍنبَيٍ بّ، شِحّ نُن كُمِ فبٍفبٍ نَ دّننَشّ.»<verse eid="DEU 26:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 26:16"/>تٌ لْشْي وٌ مَرِفِ عَلَتَلَ بَرَ وٌ يَمَرِ وٌ شَ عَ شَ مَسٍنيِ نُن عَ شَ سّرِيّ رَبَتُ عَ رَبَتُ كِ مَ. وٌ شَ وٌ حّنفِ سَ نَ سّرِيّ شْن مَ وٌ بْحّ قِيشّ رَ. <verse eid="DEU 26:16"/><verse number="17" style="v" sid="DEU 26:17"/>تٌ لْشْي وٌ بَرَ لَايِدِ تٌنفٌ عَلَتَلَ بّ، عَ عَ تَن نَن نَ وٌ مَرِفِ عَلَتَلَ رَ، عَ وٌ شَ حّرّ عَ شَ كِرَ شْن مَ، عَ وٌ شَ عَ شَ مَسٍنيِ، عَ شَ سّرِيّ، نُن عَ شَ يَامَرِ رَبَتُ. <verse eid="DEU 26:17"/><verse number="18" style="v" sid="DEU 26:18"/>وٌ سَاتّ تٌنفٌشِ نّ عَ بّ، عَ وٌ تَن نَن نَ عَ شَ حَمَ رَ، عَلْ عَ عَ قَلَشِ وٌ بّ كِ نَشّ. وٌ شَ بِرَ عَ شَ سّرِيّ قْشْ رَ، <verse eid="DEU 26:18"/><verse number="19" style="v" sid="DEU 26:19"/>عَلَكٌ عَ شَ قِسَمَنتٍيَ قِ وٌ مَ سِ بِرِن شُن مَ عَ نَشٍيٍ دَاشِ. وٌ شَ نْرّ، وٌ شِلِ، نُن وٌ سّنبّ شَ دَنفِ عٍ بِرِن نَ. وٌ شَ قِندِ حَمَ رَ نَشَن عَ شَ وَلِ رَبَمَ، عَلْ عَ مَسٍنشِ وٌ بّ كِ نَشّ.<verse eid="DEU 26:19"/></para>
  <chapter eid="DEU 26"/>
  <chapter number="27" style="c" sid="DEU 27"/>
  <para style="s">بَرَكّ نُن دَنكّ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 27:1"/>عَننَبِ مُنسَ نُن حَمَ قٌرِيٍ يِ مَسٍنيِ نَن تِ عِسِرَيِلَكَيٍ بّ، «وٌ شَ مّينِ يِ يَامَرِيٍ مَ، ﭑ نَشٍيٍ قِشِ وٌ مَ تٌ لْشْي. <verse eid="DEU 27:1"/><verse number="2" style="v" sid="DEU 27:2"/>وٌ نَ يُرُدّن شُرٍ عِفِرِ تّمُي نَشّ، سِفَقٍ رَ بْشِ مَ وٌ مَرِفِ عَلَتَلَ نَشَن قِمَ وٌ مَ، وٌ شَ فّمّ شُنفبٍ ندٍيٍ تِ، وٌ عٍ مَقِيشّ. <verse eid="DEU 27:2"/><verse number="3" style="v" sid="DEU 27:3"/>وٌ نَ يُرُدّن عِفِرِ سِفَقٍ رَ بْشِ مَ، وٌ مَرِفِ عَلَتَلَ نَشَن قِمَ وٌ مَ، شِحّ نُن كُمِ فبٍفبٍ نَ دّننَشّ، عَلْ وٌ بَبَيٍ مَرِفِ عَلَتَلَ عَ قَلَشِ وٌ بّ كِ نَشّ، <verse eid="DEU 27:3"/><verse number="4" style="v" sid="DEU 27:4"/>وٌ شَ يِ فّمّيٍ نَن تِ عٍبَلِ فٍيَ قَرِ، ﭑ بَشِ نَشٍيٍ شَ قٍ قَلَدٍ وٌ بّ يَ، وٌ قَ عٍ مَقِيشّ.»<verse eid="DEU 27:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="DEU 27:5"/>«مّننِ وٌ شَ سّرّشّبَدٍ يَءِلَن فّمّيٍ رَ وٌ مَرِفِ عَلَتَلَ بّ، وُرٍ مُ دِنشِ نَشٍيٍ رَ، <verse eid="DEU 27:5"/><verse number="6" style="v" sid="DEU 27:6"/>نَشٍيٍ مُ مَسٌلِشِ قٍقٍ مَ. وٌ شَ سّرّشّ فَن دَاشِ ندٍيٍ بَ وٌ مَرِفِ عَلَتَلَ بّ نَ سّرّشّبَدٍ قَرِ. <verse eid="DEU 27:6"/><verse number="7" style="v" sid="DEU 27:7"/>وٌ شَ شَنُنتٍيَ سّرّشّيٍ قَن بَ، وٌ نَشٍيٍ دٌنمَ سّيوّ كُي وٌ مَرِفِ عَلَتَلَ يَ عِ. <verse eid="DEU 27:7"/><verse number="8" style="v" sid="DEU 27:8"/>وٌ شَ عَلَ شَ سّرِيّ سّبّ نَ فّمّ تِشِيٍ مَ، عَلَكٌ حَمَ شَ نْ شَرَندٍ عَ قَنيِ رَ.»<verse eid="DEU 27:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 27:9"/>عَننَبِ مُنسَ نُن لٍوِكَ سّرّشّدُبّيٍ نَشَ يِ مَسٍنيِ تِ حَمَ بّ، «عِسِرَيِلَ حَمَ، وٌ وٌ سَبَرِ. وٌ شَ وٌ تُلِ مَتِ. تٌ لْشْي، وٌ بَرَ قِندِ وٌ مَرِفِ عَلَتَلَ شَ حَمَ رَ. <verse eid="DEU 27:9"/><verse number="10" style="v" sid="DEU 27:10"/>وٌ شَ بِرَ وٌ مَرِفِ عَلَتَلَ شُي قْشْ رَ. وٌ شَ عَ شَ مَسٍنيِ نُن عَ شَ سّرِيّ رَبَتُ عَ رَبَتُ كِ مَ، ﭑ نَشَن شَرَنقٍ وٌ بّ تٌ لْشْي.»<verse eid="DEU 27:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="DEU 27:11"/>نَ لْشْي كٍرٍنيِ، عَننَبِ مُنسَ مَن نَشَ يِ يَامَرِ سٌ حَمَ يِ رَ، <verse eid="DEU 27:11"/><verse number="12" style="v" sid="DEU 27:12"/>«وٌ نَ يُرُدّن عِفِرِ، سِمٍيْن بْنسْي، لٍوِ بْنسْي، يُدَ بْنسْي، عِسَكَرِ بْنسْي، يُسُقُ بْنسْي، نُن بُنيَمِن بْنسْي شَ تِ فَرِ سِمِ فٍيَ قَرِ، عٍ شَ دُبّيٍ تِ. <verse eid="DEU 27:12"/><verse number="13" style="v" sid="DEU 27:13"/>رُبٍن بْنسْي، فَدِ بْنسْي، عَسٍرِ بْنسْي، سَبُلٌن بْنسْي، دَنَ بْنسْي، نُن نَقَتَلِ بْنسْي شَ تِ عٍبَلِ فٍيَ قَرِ، عٍ شَ دَنكّيٍ تِ. <verse eid="DEU 27:13"/><verse number="14" style="v" sid="DEU 27:14"/>لٍوِ بْنسْي شَ نَ مَسٍنيِ مَدَنفِ عِسِرَيِلَ حَمَ بّ عٍ شُي عِتٍشِ رَ.»<verse eid="DEU 27:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 27:15"/>«دَنكّ نَ مِشِ بّ نَشَن كُيٍ مَسٌلِمَ، شَ نَ مُ عَ رَ عَ كُيٍ يَءِلَنمَ يْشُي رَشُنُشِ رَ، عَ تُوبِ عَ بّ دُنشُي رَ. عَلَتَلَ نَ سٍ مْولِ شْنشِ.» حَمَ بِرِن قَ عَ رَتِن، «عَمِنَ.»<verse eid="DEU 27:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 27:16"/>«دَنكّ نَ مِشِ بّ نَشَن عَ بَبَ نُن عَ نفَ رَيَافِمَ.» حَمَ بِرِن قَ عَ رَتِن، «عَمِنَ.»<verse eid="DEU 27:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="DEU 27:17"/>«دَنكّ نَ مِشِ بّ نَشَن نَانِنيِ تْنشُمَ مَسِفَمَ.» حَمَ بِرِن قَ عَ رَتِن، «عَمِنَ.»<verse eid="DEU 27:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="DEU 27:18"/>«دَنكّ نَ مِشِ بّ نَشَن دْنشُي رَتَنتَنمَ كِرَ مَ.» حَمَ بِرِن قَ عَ رَتِن، «عَمِنَ.»<verse eid="DEU 27:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 27:19"/>«دَنكّ نَ مِشِ بّ نَشَن سّرِيّ رَكَنَمَ شْحّ، كِرِدِ، شَ نَ مُ عَ رَ كَاحّ فِنّ رَ.» حَمَ بِرِن قَ عَ رَتِن، «عَمِنَ.»<verse eid="DEU 27:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="DEU 27:20"/>«دَنكّ نَ مِشِ بّ نَشَن سَمَ عَ بَبَ شَ فِنّ قّ مَ، عَ عَ بَبَ رَيَافِ.» حَمَ بِرِن قَ عَ رَتِن، «عَمِنَ.»<verse eid="DEU 27:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="DEU 27:21"/>«دَنكّ نَ مِشِ بّ نَشَن يّنّ رَبَمَ شُرُ سٍ رَ، نَ قِندِ شُرُ سٍ يٌ رَ.» حَمَ بِرِن قَ عَ رَتِن، «عَمِنَ.»<verse eid="DEU 27:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 27:22"/>«دَنكّ نَ مِشِ بّ نَشَن نُن عَ مَافِنّ كَقُمَ، عَ بَبَ شَ دِ فِنّ، شَ نَ مُ عَ نفَ شَ دِ فِنّ.» حَمَ بِرِن قَ عَ رَتِن، «عَمِنَ.»<verse eid="DEU 27:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="DEU 27:23"/>«دَنكّ نَ مِشِ بّ نَشَن نُن عَ بِتَنيِ فِنّمَ كَقُمَ.» حَمَ بِرِن قَ عَ رَتِن، «عَمِنَ.»<verse eid="DEU 27:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="DEU 27:24"/>«دَنكّ نَ مِشِ بّ نَشَن عَ بٌورٍ قَشَمَ نْشُنيِ كُي.» حَمَ بِرِن قَ عَ رَتِن، «عَمِنَ.»<verse eid="DEU 27:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="DEU 27:25"/>«دَنكّ نَ مِشِ بّ نَشَن كْبِرِ رَ سُشُمَ مِشِ تْوحّفّشِ قَشَقٍ رَ.» حَمَ بِرِن قَ عَ رَتِن، «عَمِنَ.»<verse eid="DEU 27:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="DEU 27:26"/>«دَنكّ نَ مِشِ بّ نَشَن تٌندِ مَ عَلَ شَ سّرِيّ رَبَتُدٍ.» حَمَ بِرِن قَ عَ رَتِن، «عَمِنَ.»<verse eid="DEU 27:26"/></para>
  <chapter eid="DEU 27"/>
  <chapter number="28" style="c" sid="DEU 28"/>
  <para style="s">بَرَكّ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 28:1"/>«شَ وٌ بِرَ وٌ مَرِفِ عَلَتَلَ شُي قْشْ رَ بْحّ قِيشّ رَ، شَ وٌ يِ يَامَرِيٍ رَبَتُ ﭑ نَشٍيٍ سٌشِ وٌ يِ رَ تٌ لْشْي، عَلَتَلَ وٌ قِندِ مَ نّ سِ قِسَمَنتٍ رَ سِ بِرِن تَفِ دُنِحَ كُي. <verse eid="DEU 28:1"/><verse number="2" style="v" sid="DEU 28:2"/>وٌ يِ بَرَكّ نَن سْتْمَ شَ وٌ بِرَ وٌ مَرِفِ عَلَتَلَ شُي قْشْ رَ.»<verse eid="DEU 28:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="DEU 28:3"/>عَ بَرَكّ سَمَ نّ تَاكَيٍ نُن دَاشَكَيٍ مَ، <verse eid="DEU 28:3"/><verse number="4" style="v" sid="DEU 28:4"/>عٍ شَ دِيٍ، دَشَمُي، يّشّييٍ، سِيٍ، نُن نِنفٍيٍ شُن مَسَمَ نّ. <verse eid="DEU 28:4"/><verse number="5" style="v" sid="DEU 28:5"/>عَ وٌ شَ سَفَيٍ رَقٍ بٌفِ سٍ رَ، عَ بَرَكّ سَ وٌ شَ قَرِن نَمَشَدٍيٍ.<verse eid="DEU 28:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="DEU 28:6"/>وٌ شَ سِمَيَ كُي، عَ بَرَكّ سَمَ نّ وٌ شَ قٍ بِرِن. <verse eid="DEU 28:6"/><verse number="7" style="v" sid="DEU 28:7"/>وٌ يَشُييٍ نَ قَ وٌ فٍرٍدٍ، عَلَتَلَ عٍ رَيَرَبِمَ نّ وٌ بّ. شَ عٍ سٌ كِرَ كٍرٍن نَن نَ، عٍ فبِلٍنمَ عٍ فِ رَ نّ وٌ يَ رَ كِرَ سٌلٌقٍرٍ شْن. <verse eid="DEU 28:7"/><verse number="8" style="v" sid="DEU 28:8"/>وٌ مَرِفِ عَلَتَلَ بَرَكّ سَمَ نّ وٌ شَ سَنسِ رَوَلِدٍ نُن وٌ نَ سٌ قٍ نَشَن بِرِن يَ مَ. عَ بَرَكّ سَ وٌ شَ قٍ بْشِ مَ، عَ دّننَشّ قِمَ وٌ مَ. <verse eid="DEU 28:8"/><verse number="9" style="v" sid="DEU 28:9"/>شَ وٌ وٌ مَرِفِ عَلَتَلَ شَ مَسٍنيِ رَبَ عَ رَبَ كِ مَ، وٌ مَن نَشَ بِرَ عَ وَشْنقٍ قْشْ رَ، عَ وٌ قِندِ مَ عَ يّتّ شَ حَمَ نَن نَ عَلْ عَ عَ رَكَلِشِ وٌ بّ كِ نَشّ. <verse eid="DEU 28:9"/><verse number="10" style="v" sid="DEU 28:10"/>بْشِ حَمَيٍ بِرِن عَ كٌلٌنمَ نّ نَ تّمُي، عَ وٌ تَن نَن سُفَندِشِ عَلَتَلَ شَ وَلِ رَبَقٍ مَ، عٍ فَاشُمَ نّ وٌ يَ رَ.<verse eid="DEU 28:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="DEU 28:11"/>عَلَتَلَ وٌ هَرِفٍ شُن مَسَمَ نّ بْشِ مَ عَ دّننَشّ سَاتّ تٌنفٌ وٌ بٍنبَيٍ بّ سٌقٍ رَ وٌ يِ. عَ وٌ شَ دِيٍ رَوُيَمَ نّ، عَ وٌ شَ شُرُ سٍيٍ رَوُيَ. <verse eid="DEU 28:11"/><verse number="12" style="v" sid="DEU 28:12"/>عَلَتَلَ يٍ رَفَتَدٍ رَبِمَ نّ وٌ بّ كٌورٍ مَ، تُنّ شَ قَ وٌ شَ بْشِيٍ مَ عَ وَشَتِ مَ، عَلَكٌ وٌ شَ وَلِيٍ شَ قَن. وٌ هَيِ مُ بِرَ مَ كْبِرِ دٌنِ قٍ مَ، قٌ وٌ تَن كْبِرِ دٌنِ شْحّيٍ بّ دٍ. <verse eid="DEU 28:12"/><verse number="13" style="v" sid="DEU 28:13"/>عَلَتَلَ وٌ تَن نَن قِندِ مَ سِ بِرِن مَ يَرٍرَتِ رَ. وٌ مُ لُمَ شَنبِ، وٌ قِسَمَنتٍيَ نَن سْتْمَ تّمُي بِرِن. وٌ مُ نِمِسَمَ قٍقٍ مَ، كْنْ قٌ وٌ شَ يِ يَامَرِ رَبَتُ نّ عَ رَبَتُ كِ مَ، ﭑ نَشَن شَرَنشِ وٌ رَ تٌ لْشْي وٌ مَرِفِ عَلَتَلَ شَ قٍ رَ. <verse eid="DEU 28:13"/><verse number="14" style="v" sid="DEU 28:14"/>قٍقٍ يٌ نَشَ عَ نِيَ وٌ شَ بَ يِ كِرَ شْن مَ ﭑ نَشَن قَلَشِ وٌ بّ. وٌ نَشَ بِرَ عَلَ فبّتّيٍ بَتُقٍ قْشْ رَ قٍقٍ مَ.<verse eid="DEU 28:14"/></para>
  <para style="s">دَنكّ</para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 28:15"/>شَ وٌ قَ تٌندِ وٌ مَرِفِ عَلَتَلَ بَتُدٍ، شَ وٌ تٌندِ عَ شَ يَامَرِيٍ نُن عَ شَ سّرِيّ رَبَدٍ، ﭑ نَشٍيٍ شَرَنشِ وٌ رَ تٌ لْشْي عَ شَ قٍ رَ، نَ تّمُي عَ قَمَ يِ دَنكّ نَن بِرَدٍ وٌ قْشْ رَ. <verse eid="DEU 28:15"/><verse number="16" style="v" sid="DEU 28:16"/>عَ تَاكَيٍ نُن دَاشَكَيٍ دَنكَمَ نّ. <verse eid="DEU 28:16"/><verse number="17" style="v" sid="DEU 28:17"/>عَ مُ بٌفِ سٍ سَمَ وٌ شَ سَفَيٍ كُي، عَ مَن مُ بَرَكّ سَمَ وٌ شَ قَرِن نَمَشَدٍيٍ. <verse eid="DEU 28:17"/><verse number="18" style="v" sid="DEU 28:18"/>عَ تٌندِ مَ نّ دِ قِدٍ وٌ مَ، وٌ مَن مُ بَلٌي سْتْمَ. وٌ شَ نِنفٍيٍ، يّشّييٍ، نُن سِيٍ شُن مُ مَسَمَ. <verse eid="DEU 28:18"/><verse number="19" style="v" sid="DEU 28:19"/>وٌ دَنكّ نَن سْتْمَ يِرٍ بِرِن وٌ شَ سِمَيَ كُي.<verse eid="DEU 28:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="DEU 28:20"/>وٌ نَ سٌ قٍقٍ يٌ نَشَن يَ مَ، عَ دَنكّ رَفٌرٌ مَ نّ وٌ مَ. عَ وٌ كُي عِقُمَ نّ عَلَكٌ وٌ شَ قٍ نَشَ سْونّيَ قٍقٍ مَ، وٌ شُن شَ رَ كَنَ، بَرِ مَ وٌ بَرَ قٍ حَاشِ رَبَ، وٌ مَن بَرَ فبِلٍن عَلَتَلَ قْشْ رَ.<verse eid="DEU 28:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="DEU 28:21"/>عَلَتَلَ قُرٍ حَاشِ رَدِنمَ نّ وٌ مَ، هَن وٌ حْن بْشِ مَ عَ دّننَشّ سٌمَ وٌ يِ رَ. <verse eid="DEU 28:21"/><verse number="22" style="v" sid="DEU 28:22"/>عَلَتَلَ عَ نِيَمَ نّ وٌ شَ شْسِ، وٌ قَتٍ شَ فَن، وٌ شَ قُرَ عَ حَاشِ رَ. عَ مَن بْشِ شَرَ، سَنسِيٍ فَن سٌفٍ بُن مَ، عٍ قَن قُرٍ حَاشِ سْتْ. عَ نَ بِرِن نَبَمَ نّ وٌ رَ، هَن وٌ لْي. <verse eid="DEU 28:22"/><verse number="23" style="v" sid="DEU 28:23"/>كٌورٍ نُن بْشِ شَرَ مَ نّ عَ شْرْشْي رَ. <verse eid="DEU 28:23"/><verse number="24" style="v" sid="DEU 28:24"/>عَلَتَلَ تُنّ مَقِندِ مَ نّ شُبٍ رَ، نَشَن فٌرٌ مَ وٌ شَ بْشِ مَ، عَ وٌ سْنتْ. <verse eid="DEU 28:24"/><verse number="25" style="v" sid="DEU 28:25"/>عَلَتَلَ سّنبّ قِمَ نّ وٌ يَشُييٍ مَ عٍ وٌ رَيَرَبِ. شَ وٌ عٍ فٍرٍ كِرَ كٍرٍن نَن نَ، وٌ وٌ فِمَ نّ عٍ يَ رَ كِرَ سٌلٌقٍرٍ شْن. نَشَن نَبَمَ وٌ رَ، عَ دُنِحَ بِرِن مَفَاشُمَ نّ. <verse eid="DEU 28:25"/><verse number="26" style="v" sid="DEU 28:26"/>وٌ بِنبِيٍ قِندِ مَ شْنِيٍ نُن وُلَءِ سُبٍيٍ شَ دٌنسٍ نَن نَ. مِشِ يٌ مُ قَمَ عٍ كٍرِدٍ.<verse eid="DEU 28:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="DEU 28:27"/>عَلَتَلَ سُورِ عِكٌنكٌنمَ نّ وٌ مَ عَلْ عَ نَشَن نَبَ مِسِرَكَيٍ رَ. عَ وٌ تْورْ مَ نّ مَنفّ قَشّ رَ، كَسِ، نُن شّحّنيِ نَشَن مُ يَلَنمَ. <verse eid="DEU 28:27"/><verse number="28" style="v" sid="DEU 28:28"/>عَلَتَلَ وٌ قِندِ مَ نّ دْنشُييٍ رَ، عَ دَشُي قُرٍ قَن قِ وٌ مَ. <verse eid="DEU 28:28"/><verse number="29" style="v" sid="DEU 28:29"/>يَنيِ رَ وٌ نّ وٌ حّرّ مَ، وٌ لُمَ كِرَ مّلّن نَ نّ عَلْ دْنشُييٍ. وٌ شَ وَلِ يٌ مُ قِندِ مَ عَ رَ، وٌ لُمَ تْورْ رَ نّ. مِشِيٍ قَمَ نّ وٌ هَرِفٍ بَدٍ وٌ يِ رَ، عٍ وٌ تْورْ عَ حَاشِ رَ. مَرَكِسِمَ يٌ مُ لُمَ وٌ بّ.<verse eid="DEU 28:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="DEU 28:30"/>وٌ نَ كٌتٍ دْشْ فِنّ شَ قٍ رَ، شّمّ فبّتّ عَ قُتِ كَنَمَ نّ. وٌ نَ بَنشِ تِ، وٌ مُ نْمَ سٌدٍ عَ كُي. وٌ نَ وّنِ بِلِيٍ سِ، وٌ مُ نْمَ عٍ بٌفِ بَدٍ. <verse eid="DEU 28:30"/><verse number="31" style="v" sid="DEU 28:31"/>وٌ شَ نِنفٍيٍ كْن نَشَبَمَ نّ وٌ يَ شْرِ، وٌ مُ نْ عٍ سُبٍ دٌندٍ. عٍ وٌ شَ سٌقَلٍ مُحَمَ نّ وٌ مَ، وٌ مُ عَ مَسْتْمَ. يَشُييٍ وٌ شَ شُرُ سٍ يْرّيٍ تٌنفٌمَ نّ، مِشِ يٌ مُ قَمَ وٌ مَلِدٍ. <verse eid="DEU 28:31"/><verse number="32" style="v" sid="DEU 28:32"/>سِ فبّتّ مِشِيٍ وٌ شَ دِيٍ سُشُمَ نّ وٌ يَ شْرِ، عٍ عٍ قِندِ كٌنيِيٍ رَ. وٌ تَفَنمَ نّ وٌ شَ دِيٍ مَمّدٍ، وٌ مُ نْمَ نَ يَشُييٍ رَ قٍقٍ مَ. <verse eid="DEU 28:32"/><verse number="33" style="v" sid="DEU 28:33"/>سِ ندٍ وٌ مُ نَشَن كٌلٌن عٍ بَلٌمَ وٌ شَ سَنسِيٍ نَن شُن نَ، وٌ شَ بْشِ دَشَمُي قِندِ مَ عٍ تَن نَن فبٍ رَ. عٍ وٌ رَوَلِمَ نّ، عٍ مَن قٍ حَاشِ رَبَ وٌ رَ. <verse eid="DEU 28:33"/><verse number="34" style="v" sid="DEU 28:34"/>نَ قٍ تٌقٍ وٌ قِندِ مَ نّ دَشُييٍ رَ.<verse eid="DEU 28:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="DEU 28:35"/>عَلَتَلَ قِ حَاشِ دْشْمَ نّ وٌ مَ، نَشَن مُ يَلَنمَ. عَ فٌرٌ مَ شِنبِيٍ نُن بّلّنيِيٍ نَن مَ، عَ قَ يٍنسٍن قَتٍ يِرٍ بِرِن نَ، كٍلِ وٌ شُنيِ مَ، عَ دْشْ وٌ سَنيِيٍ رَ. <verse eid="DEU 28:35"/><verse number="36" style="v" sid="DEU 28:36"/>عَلَتَلَ قَمَ نّ وٌ تَن نُن وٌ شَ مَنفّيٍ رَ سِفَدٍ بْشِ ندٍ مَ، وٌ تَن نُن وٌ بٍنبَيٍ مُ نَشَن كٌلٌن. مّننِ وٌ قَمَ نّ عَلَ فبّتّيٍ بَتُدٍ، نَشٍيٍ مَسٌلِشِ وُرِ نُن فّمّ رَ. <verse eid="DEU 28:36"/><verse number="37" style="v" sid="DEU 28:37"/>مّننِكَيٍ وٌ مَيٍلٍمَ نّ، عٍ يٌمَ وٌ مَ.<verse eid="DEU 28:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="DEU 28:38"/>وٌ سَنسِ شْرِ فبٍفبٍ رَوَلِمَ نّ وٌ شَ شّيٍ مَ، كْنْ وٌ دٌندٌرٌنتِ نَن شَبَمَ، بَرِ مَ كَتٌي دِنمَ نّ عَ بِرِن نَ. <verse eid="DEU 28:38"/><verse number="39" style="v" sid="DEU 28:39"/>وٌ وّنِ سَنسِ سِمَ نّ، وٌ مّينِ عَ مَ عَ قَنيِ رَ، كْنْ وٌ مُ عَ يٍ مِنمَ، بَرِ مَ كُلِ سٌمَ عٍ عِ نّ. <verse eid="DEU 28:39"/><verse number="40" style="v" sid="DEU 28:40"/>عٌلِوِ بِلِيٍ لُمَ نّ بْشِ يِرٍ بِرِن مَ، كْنْ وٌ مُ عٍ تُرٍ مَسٌمَ وٌ مَ، بَرِ مَ عٌلِوِ بٌفِيٍ بِرَ مَ نّ، عٍ مُ فبٍيلِ.<verse eid="DEU 28:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="DEU 28:41"/>وٌ دِيٍ بَرِ مَ نّ، كْنْ عٍ مُ لُمَ وٌ يِ، بَرِ مَ وٌ يَشُييٍ عٍ شَنِنمَ نّ. <verse eid="DEU 28:41"/><verse number="42" style="v" sid="DEU 28:42"/>وٌ شَ وُرِيٍ نُن بْشِ دَشَمُي قِندِ مَ كَتٌي نَن فبٍ رَ. <verse eid="DEU 28:42"/><verse number="43" style="v" sid="DEU 28:43"/>شْحّ نَشٍيٍ نَ وٌ يَ مَ، نٍيٍ سّنبّ شُن مَسَمَ نّ تّمُي بِرِن، كْنْ وٌ تَن شَ قٍ مَفٌرٌ مَ نّ. <verse eid="DEU 28:43"/><verse number="44" style="v" sid="DEU 28:44"/>قّيرّ لُمَ نّ عٍ يِ رَ، كْنْ وٌ تَن لُمَ سٍتَرٍحَ نَن كُي. عٍ قِندِ مَ نّ وٌ شَ يَرٍرَتِيٍ رَ، كْنْ وٌ تَن لُمَ عٍ شَنبِ رَ نّ.<verse eid="DEU 28:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="DEU 28:45"/>يِ دَنكّ بِرِن دْشْمَ نّ وٌ قَرِ، هَن وٌ بِرِن فّ هَلَكِدٍ، بَرِ مَ وٌ بَرَ تٌندِ وٌ مَرِفِ عَلَتَلَ شُي رَتِنمّدٍ. وٌ مُ عَ شَ يَامَرِ نُن عَ شَ سّرِيّ رَبَتُشِ عَ رَبَتُ كِ مَ. <verse eid="DEU 28:45"/><verse number="46" style="v" sid="DEU 28:46"/>نَ قِندِ مَ تْنشُمَ نُن دّءِشَرّ نَن نَ وٌ تَن نُن وٌ بْنسْي بّ عَبَدَن.<verse eid="DEU 28:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="DEU 28:47"/>وٌ تٌ مُ تِن وٌ مَرِفِ عَلَتَلَ بَتُدٍ سّيوّ نُن بْحّسَ كُي، قٍ قَنيِ بِرِن شَ لُ وٌ يِ رَ، <verse eid="DEU 28:47"/><verse number="48" style="v" sid="DEU 28:48"/>وٌ قَمَ نّ تْورْدٍ وٌ يَشُييٍ يِ رَ. كَامّ نُن يٍ شْلِ وٌ سُشُمَ نّ. وٌ تِمَ نّ وٌ مَفٍلِ رَ، وٌ لُمَ سٍتَرٍحَ نَن كُي. نَ كُي عَلَتَلَ قَمَ يْلْنشْنيِ سَدٍ وٌ كْنيِ مَ، هَن وٌ فّ هَلَكِدٍ. <verse eid="DEU 28:48"/><verse number="49" style="v" sid="DEU 28:49"/>عَ قَمَ نّ سِ رَ وٌ مُ نَشَن شَ شُي مّمَ كٍلِقٍ يِرٍ مَكُيٍ، عَ شَ فٌرٌ وٌ مَ عَلْ سّفّ فٌرٌ مَ تْشْي يْرّ مَ كِ نَشّ. <verse eid="DEU 28:49"/><verse number="50" style="v" sid="DEU 28:50"/>مِشِ كَارِنشِيٍ نَن عٍ رَ، نَشٍيٍ مُ قٌرِيٍ بِنيَمَ، نَشٍيٍ مُ كِنِكِنِمَ دِ مّيٍ مَ. <verse eid="DEU 28:50"/><verse number="51" style="v" sid="DEU 28:51"/>عٍ وٌ شَ شُرُ سٍ نُن وٌ شَ بَلٌي تٌنفٌ عٍ يّتّ بّ، وٌ شَ قَشَ كَامّ رَ. عٍ وٌ شَ مّنفِ، وّنِ، تُرٍ، نِنفٍ يْرّيٍ، يّشّييٍ، نُن سِيٍ بِرِن شَنِنمَ نّ. وٌ قَمَ نّ هَلَكِدٍ.<verse eid="DEU 28:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="DEU 28:52"/>عٍ قَمَ نّ وٌ شَ تَايٍ بِرِن نَبِلِندٍ، وٌ مَرِفِ عَلَتَلَ نَشٍيٍ سٌ وٌ يِ رَ. عٍ وٌ فٍرٍ مَ نّ هَن وٌ شَ تّتّ عِتٍشِ سّنبّمَيٍ يٌلٌن، وٌ لَشِ نَشٍيٍ رَ. <verse eid="DEU 28:52"/><verse number="53" style="v" sid="DEU 28:53"/>نَ فٍرٍيٍ كُي وٌ يَشُييٍ وٌ رَكَامّمَ نّ، هَن وٌ وٌ شَ دِيٍ سُبٍ يَتِ دٌن، دِيٍ وٌ مَرِفِ عَلَتَلَ نَشٍيٍ قِشِ وٌ مَ. <verse eid="DEU 28:53"/><verse number="54" style="v" sid="DEU 28:54"/>هَلِ شّمّ قَنيِ نَشَن لُمَ وٌ يَ مَ، عَ مُ كِنِكِنِمَ عَ نفَشَكٍرٍنمَ، عَ شَ فِنّ، نُن عَ شَ دِيٍ مَ. <verse eid="DEU 28:54"/><verse number="55" style="v" sid="DEU 28:55"/>عَ تٌندِ مَ نّ عَ شَ دِ سُبٍ عِتَشُندٍ عٍ رَ، بَرِ مَ نَ قِندِشِ عَ بَلٌي دْنشْي نَن نَ. وٌ يَشُييٍ نَ مَرَيَرَبِ سَمَ نّ وٌ قَرِ وٌ شَ تَايٍ بِرِن كُي. <verse eid="DEU 28:55"/><verse number="56" style="v" sid="DEU 28:56"/>هَلِ فِنّ قَنيِ نَشَن لُمَ وٌ يَ مَ، نَشَن مُ تِنمَ عَ سَنيِ يَتِ شَ مَنْشْ، نَ تَن قَن مُ كِنِكِنِمَ عَ شَ مْرِ قَنيِ نُن عَ شَ دِيٍ مَ. <verse eid="DEU 28:56"/><verse number="57" style="v" sid="DEU 28:57"/>عَ تٌندِ مَ نّ عَ شَ دِيْرّ سُبٍ عِتَشُندٍ عٍ نُن نَ شَنبِرَتٌي مَ عَ نَشَن بَرِشِ، بَرِ مَ عَ تَن وَ مَ نَ دٌنقٍ، عَ شَ لُ عَ تَن فبَنسَن بّ. وٌ يَشُييٍ قَمَ نَ تْورّ مْولِ نَن دْشْدٍ وٌ مَ.<verse eid="DEU 28:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="DEU 28:58"/>شَ وٌ مُ مّينِ يِ مَسٍنيِيٍ مَ نَشٍيٍ سّبّشِ يِ كِتَابُي كُي، شَ وٌ مُ فَاشُ وٌ مَرِفِ عَلَتَلَ شِلِ شُنفبٍ مَفَاشُشِ يَ رَ، <verse eid="DEU 28:58"/><verse number="59" style="v" sid="DEU 28:59"/>عَلَتَلَ قَمَ نّ قُرٍ حَاشِ مَفَاشُشِيٍ دْشْدٍ وٌ تَن نُن وٌ بْنسْي مَ، نَشَن مُ يَلَنمَ. <verse eid="DEU 28:59"/><verse number="60" style="v" sid="DEU 28:60"/>عَ قُرٍ حَاشِ عِكٌنكٌمَ نّ وٌ شُن نَ، وٌ نُ فَاشُشِ نَشَن يَ رَ مِسِرَ بْشِ مَ. نَ قُرٍ مْولِ وٌ سُشُمَ نّ، عَ نْ وٌ رَ. <verse eid="DEU 28:60"/><verse number="61" style="v" sid="DEU 28:61"/>عَلَتَلَ قُرٍ مْولِ فبٍفبٍ دْشْمَ نّ وٌ مَ، نَشٍيٍ شِلِ مُ سّبّشِ يِ كِتَابُي كُي، هَن وٌ بِرِن فّ سْنتْدٍ. <verse eid="DEU 28:61"/><verse number="62" style="v" sid="DEU 28:62"/>وٌ تَن نَشٍيٍ نُ وُيَ دَنفِ تُنبُييٍ رَ كٌورٍ مَ، وٌ كْنتِ شُرُنمَ نّ، بَرِ مَ وٌ بَرَ وٌ مَرِفِ عَلَتَلَ شُي مَتَندِ.<verse eid="DEU 28:62"/></para>
  <para style="p">
    <verse number="63" style="v" sid="DEU 28:63"/>عَلَتَلَ قٍ قَنيِ رَبَشِ وٌ بّ كِ نَشّ، عَ نُن عَ وٌ رَوُيَشِ كِ نَشّ، عَ قَمَ وٌ هَلَكِدٍ نَ كِ نّ مَن، وٌ قَ حْن بْشِ مَ عَ نَشَن قِ وٌ مَ. <verse eid="DEU 28:63"/><verse number="64" style="v" sid="DEU 28:64"/>عَ وٌ رَيٍنسٍن سِ بِرِن يَ مَ، كٍلِ دُنِحَ تُشُي مَ، سَ دْشْ بٌورٍ تُشُي رَ. وٌ قَمَ نّ عَلَ فبّتّيٍ بَتُدٍ، وُرِ نُن فّمّ دَاشِيٍ، وٌ تَن نُن وٌ بٍنبَيٍ مُ نَشٍيٍ كٌلٌن. <verse eid="DEU 28:64"/><verse number="65" style="v" sid="DEU 28:65"/>نَ سِيٍ تَفِ، وٌ مُ مَلَبُي يٌ سْتْمَ، وٌ مُ يِرٍ يٌ سْتْمَ وٌ سَبَتِمَ دّننَشّ. عَلَتَلَ وٌ بْحّيٍ رَتٍمَ نّ، عَ وٌ يَيٍ رَ مِنِ، عَ وٌ نِي تْورْ. <verse eid="DEU 28:65"/><verse number="66" style="v" sid="DEU 28:66"/>وٌ شَ سِمَيَ قِندِ مَ كْنتْقِلِ نَن نَ، فَاشُي قَمَ نّ وٌ رَ سّرّندٍ كْي نُن يَنيِ رَ. <verse eid="DEU 28:66"/><verse number="67" style="v" sid="DEU 28:67"/>وٌ نَ نَ قٍ مْولِ تٌ تّمُي نَشّ، فَاشُي قَمَ وٌ بْحّ رَقٍدٍ. فّيسّفّ، وٌ نُ قَ عَ قَلَ، «شَ نُنمَرٍ نَن نُ عَ رَ نُ!» نُنمَرٍ، وٌ نُ قَ عَ قَلَ، «شَ فّيسّفّ نَن نُ عَ رَ نُ!» <verse eid="DEU 28:67"/><verse number="68" style="v" sid="DEU 28:68"/>عَلَتَلَ وٌ شَنِنمَ نّ كُنكُييٍ كُي مِسِرَ، ﭑ عَ قَلَ وٌ بّ دّننَشّ مَ وٌ مُ نَا تٌمَ سْنْن. مّننِ، وٌ كَتَمَ نّ وٌ يّتّ مَتِدٍ وٌ يَشُييٍ مَ كٌنيِيٍ رَ، شّمّيٍ نُن فِنّيٍ، كْنْ مِشِ يٌ مُ وٌ سَرَ مَ.<verse eid="DEU 28:68"/></para>
  <para style="p">
    <verse number="69" style="v" sid="DEU 28:69"/>عَلَتَلَ يِ سَاتّ نَن سٌ عَننَبِ مُنسَ يِ رَ، عَ شَ عَ مَبَنبَن عٍ نُن عِسِرَيِلَكَيٍ تَفِ، مٌوَبَ بْشِ مَ. يِ سَاتّ نُن بٌورٍ سَاتّ تَفِ رَ سَ نَشَن تٌنفٌ شٌرٍبٍ فٍيَ قَرِ.<verse eid="DEU 28:69"/></para>
  <chapter eid="DEU 28"/>
  <chapter number="29" style="c" sid="DEU 29"/>
  <para style="s">عَلَ شَ سَاتّ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 29:1"/>عَننَبِ مُنسَ نَشَ عِسِرَيِلَ حَمَ بِرِن مَشِلِ، عَ عَ مَسٍن عٍ بّ، «وٌ نُ نَ مِسِرَ تّمُي نَشّ، وٌ قٍ تٌ نّ عَلَتَلَ نَشَن نَبَ قِرَوُنَ رَ، عَ شَ سْورِيٍ نُن عَ شَ بْشِ بِرِن نَ. <verse eid="DEU 29:1"/><verse number="2" style="v" sid="DEU 29:2"/>وٌ بَرَ قٍ شْرْشْييٍ تٌ، تْنشُمَيٍ نُن كَابَنَكٌي عَ نَشٍيٍ رَبَ عٍ رَ، <verse eid="DEU 29:2"/><verse number="3" style="v" sid="DEU 29:3"/>كْنْ هَن تٌ عَلَتَلَ مُ شَشِلِ قِ وٌ مَ نَشَن نْمَ يِ قٍيٍ كٌلٌندٍ. وٌ يَيٍ مُ عَ تٌمَ، وٌ تُلِ مَن مُ عَ مّمَ. <verse eid="DEU 29:3"/><verse number="4" style="v" sid="DEU 29:4"/>حّ تٌنفٌ نَانِ بُن مَ عَ وٌ رَتَنفَمَ فبٍنفبٍرٍنيِ كُي. وٌ شَ سٌسٍ نُن وٌ شَ سَنكِرِيٍ مُ كَنَ، <verse eid="DEU 29:4"/><verse number="5" style="v" sid="DEU 29:5"/>وٌ مُ تَامِ دٌن، وٌ مُ وّنِ نُن بٍيرٍ مِن. عَلَتَلَ بَرَ عَ حْشْ رَ سِفَ وٌ شَ قٍ شْن عَلَكٌ وٌ شَ نْ عَ كٌلٌندٍ عَ تَن نَن نَ وٌ مَرِفِ عَلَ رَ. <verse eid="DEU 29:5"/><verse number="6" style="v" sid="DEU 29:6"/>وٌ تٌ سٌ بٍ، شّسِبْن مَنفّ سِشْن، نُن بَسَن مَنفّ عٌفٌ، قَ نّ وٌ فٍرٍدٍ، كْنْ وٌ نَشَ نْ عٍ رَ. <verse eid="DEU 29:6"/><verse number="7" style="v" sid="DEU 29:7"/>وٌ نَشَ عٍ شَ بْشِيٍ تٌنفٌ، وٌ عَ عِتَشُن رُبٍن بْنسْي مَ، فَدِ بْنسْي مَ، نُن مَنَسِ بْنسْي سّيتِ كٍرٍن مَ. <verse eid="DEU 29:7"/><verse number="8" style="v" sid="DEU 29:8"/>نَ نَن عَ تٌشِ، وٌ لَنمَ وٌ شَ بِرَ يِ سَاتّ سّرِيّ قْشْ رَ، عَلَكٌ وٌ نَ سٌ قٍ نَشَن يٌ يَ مَ، عَ شَ سْونّيَ وٌ بّ.»<verse eid="DEU 29:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 29:9"/>«عِسِرَيِلَكَيٍ، وٌ تَن نَن مَلَنشِ يِ كِ تٌ لْشْي وٌ مَرِفِ عَلَتَلَ يَ عِ. بِرِن نَ بٍ، وٌ شَ مَنفّيٍ، وٌ شَ يَرٍرَتِيٍ، وٌ شَ قٌرِيٍ، وٌ شَ سْورِ مَنفّيٍ، <verse eid="DEU 29:9"/><verse number="10" style="v" sid="DEU 29:10"/>وٌ شَ فِنّيٍ، وٌ شَ دِيٍ، نُن شْحّيٍ نَشٍيٍ وُرِ سّفّمَ نُن يٍ بَمَ وٌ بّ. <verse eid="DEU 29:10"/><verse number="11" style="v" sid="DEU 29:11"/>وٌ مَرِفِ عَلَتَلَ بَرَ سَاتّ مَبَنبَن كَلِ رَ. وٌ نَ بٍ تٌ عَلَكٌ وٌ شَ نَ شِرِ، وٌ تَن نُن وٌ مَرِفِ عَلَتَلَ تَفِ. <verse eid="DEU 29:11"/><verse number="12" style="v" sid="DEU 29:12"/>نَ تّمُي وٌ تَن نَن نَ عَ شَ حَمَ رَ، نُن عَ تَن نَن نَ وٌ مَرِفِ عَلَ رَ، عَلْ عَ كَلِ وٌ بٍنبَيٍ عِبُرَهِمَ، عِسِيَفَ، نُن يَشُبَ بّ كِ نَشّ. <verse eid="DEU 29:12"/><verse number="13" style="v" sid="DEU 29:13"/>ﭑ مُ يِ سَاتّ مَبَنبَنشِ كَلِ رَ وٌ تَن فبَنسَن شَ بّ، <verse eid="DEU 29:13"/><verse number="14" style="v" sid="DEU 29:14"/>وٌ تَن نَشٍيٍ نَ بٍ وٌن مَرِفِ عَلَتَلَ يَ عِ. ﭑ عَ مَبَنبَنشِ وٌ بْنسْي نَن قَن بّ نَشٍيٍ مُ نُ بَرِ سِندٍن.»<verse eid="DEU 29:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 29:15"/>«وٌ عَ كٌلٌن وٌن بُشِ مِسِرَ بْشِ مَ كِ نَشّ، نُن وٌن دَنفِ سِ نَشٍيٍ شَ بْشِيٍ رَ. <verse eid="DEU 29:15"/><verse number="16" style="v" sid="DEU 29:16"/>وٌ بَرَ يِ كُيٍ شْنشِيٍ تٌ يِ سِيٍ نُ نَشٍيٍ بَتُمَ، كُيٍ نَشٍيٍ يَءِلَنشِ وُرِ، فّمّ، فبٍتِ، نُن شّيمَ رَ. <verse eid="DEU 29:16"/><verse number="17" style="v" sid="DEU 29:17"/>شّمّ يٌ، فِنّ يٌ، بْنسْي يٌ، شَبِلّ يٌ نَشَ فبِلٍن وٌ مَرِفِ عَلَتَلَ قْشْ رَ، بِرَقٍ رَ نَ سِيٍ شَ عَلَيٍ بَتُقٍ قْشْ رَ. وٌ يَ مَ، مِشِ يٌ نَشَ لُ عَلْ وُرِ سَنكٍ نَشَن ثْسْنّ شْنّ رَ مِنِمَ. <verse eid="DEU 29:17"/><verse number="18" style="v" sid="DEU 29:18"/>نَ مِشِ مْولِ نَشَن بَرَ فّ يِ كَلِ مّدٍ، كْنْ عَ قَ سّيوَ عَ بْحّ مَ عَ قَلَقٍ رَ، ‹سْونّيَ نَ ﭑ بّ، ﭑ شَ ﭑ يّتّ وَشْنقٍ رَبَ تّمُي بِرِن، حّمّ نُن سٌفٌقُرٍ،› <verse eid="DEU 29:18"/><verse number="19" style="v" sid="DEU 29:19"/>عَلَتَلَ مُ دِحّمَ نَ كَنيِ مَ. عَ قَمَ نّ عَ شَ شْنّ مَسٍندٍ عَ بّ عَ حَاشِ رَ، بَرِ مَ عَ مُ وَ مَ عَ قِرِن ندٍ شْن. عَ دَنكّ رَفٌرٌ مَ نّ عَ مَ، نَشٍيٍ سّبّشِ يِ كِتَابُي كُي. عَ عَ شِلِ رَلْيمَ نّ دُنِحَ مَ. <verse eid="DEU 29:19"/><verse number="20" style="v" sid="DEU 29:20"/>عَلَتَلَ نَ مِشِ مْولِ رَ مِنِمَ عِسِرَيِلَ حَمَ يَ مَ عَ دَنكّ كِ مَ، عَلْ عَ سَاتّ سّبّشِ كِ نَشّ يِ سّرِيّ كِتَابُي كُي.»<verse eid="DEU 29:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="DEU 29:21"/>«وٌ بْنسْييٍ نَشٍيٍ قَمَ وٌ شَنبِ رَ، عَ نُن شْحّيٍ نَشٍيٍ كٍلِمَ بْشِ مَكُيٍ مَ، عٍ قَمَ قُرٍيٍ نُن قٍ شْرْشْييٍ تٌدٍ، عَلَتَلَ نَشٍيٍ دْشْمَ وٌ شَ بْشِ مَ. <verse eid="DEU 29:21"/><verse number="22" style="v" sid="DEU 29:22"/>سٌدَ نُن قْشْي قَمَ لُدٍ بْشِ قَرِ. بْشِ مُ نْمَ رَوَلِدٍ، سٍسٍ مُ نْمَ قَندٍ، هَلِ بُرّشّ كٍرٍن عَ مُ نْمَ قِندِدٍ عَ رَ. بْشِ لُمَ نّ عَلْ سٌدٌ مَ، فٌمٌرَ، عَدَ مَهَ، نُن سٍبٌيِمِ، عَلَ تَا نَشٍيٍ كَنَ عَ شَ بْحّ شْنّ كُي. <verse eid="DEU 29:22"/><verse number="23" style="v" sid="DEU 29:23"/>نَ تّمُي سِ فبّتّيٍ قَمَ نّ مَشْرِنيِ تِدٍ، ‹عَلَتَلَ يِ بْشِ نِيَشِ يِ كِ مُنقٍ رَ؟ عَ بْحّ شْنْشِ يِ مْولِ رَ مُنقٍ رَ؟› <verse eid="DEU 29:23"/><verse number="24" style="v" sid="DEU 29:24"/>عٍ عٍ يَابِمَ نّ، ‹يِ قٍ رَبَشِ نّ بَرِ مَ يِ حَمَ بَرَ سَاتّ كَنَ، عٍ بٍنبَيٍ مَرِفِ عَلَتَلَ نَشَن تٌنفٌ عٍ بّ، عَ تٌ عٍ رَ مِنِ مِسِرَ بْشِ رَ. <verse eid="DEU 29:24"/><verse number="25" style="v" sid="DEU 29:25"/>عٍ بَرَ كُيٍيٍ بَتُ عٍ مُ نَشٍيٍ كٌلٌنشِ، عَلَتَلَ مُ تِنشِ نَشٍيٍ رَ. <verse eid="DEU 29:25"/><verse number="26" style="v" sid="DEU 29:26"/>نَ قٍ نَ عَ تٌشِ عَلَتَلَ يِ حَشَنكَتّ بِرِن دْشْشِ يِ بْشِ مَ عَ شَ شْنّ كُي عَلْ عَ شَ كِتَابُي عَ مَسٍنمَ كِ نَشّ. <verse eid="DEU 29:26"/><verse number="27" style="v" sid="DEU 29:27"/>عَ بَرَ عَ شَ شْنّ بٍلٍبٍلٍ دْشْ عَ شَ حَمَ مَ، عَ عٍ تٌنفٌ عٍ شَ بْشِ مَ، عَ عٍ كٍرِ بْشِ فبّتّ قَن مَ، عٍ نَ دّننَشّ يِ وَشَتِ.›»<verse eid="DEU 29:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="DEU 29:28"/>«قٍ نَشٍيٍ نْشُنشِ، وٌن مَرِفِ عَلَتَلَ نَن كٍرٍن ثٍتِ نٍيٍ كٌلٌن. قٍ نَشٍيٍ مَسٍنشِ وٌن بّ، نُن وٌن مَ دِيٍ بّ، نٍيٍ قِندِشِ وٌن فبٍ نَن نَ هَن دُنِحَ حْن. عَ لَنمَ وٌن شَ يِ سّرِيّ مَسٍنشِ بِرِن نَبَتُ.»<verse eid="DEU 29:28"/></para>
  <chapter eid="DEU 29"/>
  <chapter number="30" style="c" sid="DEU 30"/>
  <para style="s">عَلَ شَ لَايِدِ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 30:1"/>ﭑ بَرَكَ نُن دَنكَ نَشٍيٍ بِرِن قَلَشِ وٌ بّ، نٍيٍ قَمَ نّ كَمَلِدٍ. وٌ مَرِفِ عَلَتَلَ نَ وٌ رَيٍنسٍن يّ تّمُي نَشّ بْشِ فبّتّ مَ، وٌ وٌ مَحْشُن يِ قٍيٍ مَ. <verse eid="DEU 30:1"/><verse number="2" style="v" sid="DEU 30:2"/>شَ وٌ فبِلٍنمَ وٌ مَرِفِ عَلَتَلَ مَ، وٌ مَن عَ شُي سُشُ وٌ بْحّ نُن وٌ شَشِلِ كُي وٌ تَن نُن وٌ شَ دِيٍ، عَلْ ﭑ عَ مَسٍنشِ وٌ بّ كِ نَشّ تٌ لْشْي، <verse eid="DEU 30:2"/><verse number="3" style="v" sid="DEU 30:3"/>نَ تّمُي وٌ مَرِفِ عَلَتَلَ وٌ رَ مِنِمَ نّ كٌنيِيَ كُي، عَ كِنِكِنِ وٌ مَ، عَ وٌ بَ سِيٍ يَ مَ عَ وٌ رَيٍنسٍن يّ دّننَشّ. <verse eid="DEU 30:3"/><verse number="4" style="v" sid="DEU 30:4"/>هَلِ وٌ نَ يِرٍ مَكُيٍ كٌنيِيَ كُي، وٌ مَرِفِ عَلَتَلَ سِفَمَ نّ وٌ قٍندٍ، عَ قَ وٌ مَلَن <verse eid="DEU 30:4"/><verse number="5" style="v" sid="DEU 30:5"/>وٌ بٍنبَيٍ شَ بْشِ مَ، عَلَكٌ وٌ شَ نَا مَسْتْ، عَ قَ مّينِ وٌ مَ دَنفِقٍ وٌ بٍنبَيٍ رَ، عَ وٌ رَوُيَ دَنفِ عٍ رَ.<verse eid="DEU 30:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="DEU 30:6"/>نَ تّمُي وٌ مَرِفِ عَلَتَلَ يّتّ يَتِ وٌ بْنسْي بْحّ رَ سّنِيّنمَ نّ، عَلَكٌ وٌ شَ عَ شَنُ وٌ بْحّ نُن وٌ شَشِلِ بِرِن نَ. نَ كُي وٌ نْمَ سِمَيَ قَنيِ سْتْدٍ. <verse eid="DEU 30:6"/><verse number="7" style="v" sid="DEU 30:7"/>ﭑ يِ دَنكّ نَشٍيٍ بِرِن سّبّشِ وٌ بّ يِ كِ، نٍيٍ قَمَ دْشْدٍ وٌ يَشُييٍ نُن وٌ شْنمَيٍ نَن مَ. <verse eid="DEU 30:7"/><verse number="8" style="v" sid="DEU 30:8"/>نَ تّمُي وٌ مَن تُوبِ رَبِرَ مَ نّ عَ بّ، وٌ عَ شَ سّرِيّ سُشُ ﭑ نَشَن قِشِ وٌ مَ تٌ لْشْي. <verse eid="DEU 30:8"/><verse number="9" style="v" sid="DEU 30:9"/>وٌ مَرِفِ عَلَتَلَ بَرَكّ سَمَ نّ وٌ شَ قٍ بِرِن مَ. وٌ دِ فبٍفبٍ سْتْمَ نّ، وٌ شَ شُرُ سٍيٍ رَوُيَمَ نّ، وٌ شَ سَنسِيٍ قَنمَ نّ، بَرِ مَ وٌ قَمَ نّ رَقَندٍ عَلَتَلَ مَ عَلْ وٌ بٍنبَيٍ. <verse eid="DEU 30:9"/><verse number="10" style="v" sid="DEU 30:10"/>نَ نَن نَبَمَ، وٌ نَ وٌ تُلِ مَتِ عَ رَ تّمُي نَشّ، عَ شَ سّرِيّ نُن عَ شَ يَامَرِيٍ سُشُقٍ رَ، نَشٍيٍ سّبّشِ يِ كِتَابُي كُي. نَ تّمُي وٌ وٌ يّتّ رَفبِلٍنمَ نّ عَ مَ وٌ بْحّ قِيشّ رَ، وٌ شَشِلِ بِرِن نَ.<verse eid="DEU 30:10"/></para>
  <para style="s">عَلَ شَ سّرِيّ</para>
  <para style="p">
    <verse number="11" style="v" sid="DEU 30:11"/>ﭑ يِ سّرِيّ نَشَن قَلَشِ وٌ بّ يِ كِ تٌ لْشْي، عَ كٌلٌن يٌ مُ شْنْ وٌ بّ. <verse eid="DEU 30:11"/><verse number="12" style="v" sid="DEU 30:12"/>عَ مُ نَ كٌورٍ شَ مَ، عَلَكٌ عَ شَ قَلَ، «ندٍ نْمَ تٍدٍ كٌورٍ مَ عَ شَ سَ قَ عَ رَ وٌن بّ، عَ عَ شَرَن وٌن بّ عَلَكٌ وٌن شَ نْ عَ رَبَدٍ؟» <verse eid="DEU 30:12"/><verse number="13" style="v" sid="DEU 30:13"/>عَ مُ نَ بَا كِرِ قَن شَ مَ، عَلَكٌ عَ شَ قَلَ، «ندٍ نْمَ بَا عِفِرِدٍ عَ شَ سَ قَ عَ رَ وٌن بّ، عَ مَن شَ عَ شَرَن وٌن بّ عَلَكٌ وٌن شَ نْ عَ رَبَدٍ؟» <verse eid="DEU 30:13"/><verse number="14" style="v" sid="DEU 30:14"/>عَدٍ، يِ سّرِيّ نَ وٌ سّيتِ مَ نّ، وٌ دّ كُي، عَ نُن وٌ بْحّ مَ. وٌ نْمَ عَ رَبَدٍ.<verse eid="DEU 30:14"/></para>
  <para style="s">سِمَيَ سُفَندِ</para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 30:15"/>عِسِرَيِلَكَيٍ، وٌ عَ مَتٌ. تٌ لْشْي ﭑ بَرَ سِمَيَ نُن قٍ قَنيِ تِ سّيتِ، قَشّ نُن قٍ حَاشِ قَن بٌورٍ سّيتِ. <verse eid="DEU 30:15"/><verse number="16" style="v" sid="DEU 30:16"/>تٌ لْشْي وٌ تِن وٌ شَ وٌ مَرِفِ عَلَتَلَ شَنُ، وٌ شَ حّرّ عَ شَ كِرَ مَ، وٌ شَ بِرَ عَ شَ يَامَرِ، عَ شَ مَسٍنيِ، نُن عَ شَ سّرِيّ قْشْ رَ، عَلَكٌ وٌ شَ سِمَيَ قَنيِ سْتْ، وٌ شَ وُيَ، عَلَكٌ عَلَ شَ بَرَكّ سَ وٌ مَ يِرٍ عَ دّننَشّ قِندِ مَ وٌ فبٍ رَ. <verse eid="DEU 30:16"/><verse number="17" style="v" sid="DEU 30:17"/>كْنْ شَ وٌ فبِلٍن عَ قْشْ رَ، شَ وٌ تٌندِ عَ بّ، شَ وٌ بِرَ كُيٍ بَتُقٍ قْشْ رَ، <verse eid="DEU 30:17"/><verse number="18" style="v" sid="DEU 30:18"/>وٌ سْنتْمَ نّ قٍوٌ، وٌ مُ قَ بُدٍ بْشِ مَ وٌ قَمَ دّننَشّ سْتْدٍ يُرُدّن كِرِ مَ. <verse eid="DEU 30:18"/><verse number="19" style="v" sid="DEU 30:19"/>تٌ لْشْي كٌورٍ نُن بْشِ نَ ﭑ سٍيدٍ رَ، ﭑ بَرَ سِمَيَ نُن قٍ قَنيِ تِ وٌ بّ سّيتِ كٍرٍن نَ، قَشّ نُن قٍ حَاشِ قَن نَ بٌورٍ سّيتِ رَ. وٌ شَ سِمَيَ قَنيِ سُفَندِ، وٌ تَن نُن وٌ بْنسْييٍ. <verse eid="DEU 30:19"/><verse number="20" style="v" sid="DEU 30:20"/>وٌ شَ وٌ مَرِفِ عَلَتَلَ شَنُ، وٌ تُوبِ عَ بّ، وٌ عَ شَ قٍ سُشُ. وٌ نْمَ سِمَيَ سْتْدٍ نَ كِ نّ، وٌ قَ حّ فبٍفبٍ رَبَ بْشِ مَ، عَلَتَلَ دّننَشّ سَاتّ تٌنفٌ قِقٍ رَ وٌ بٍنبَ عِبُرَهِمَ، عِسِيَفَ، نُن يَشُبَ مَ.<verse eid="DEU 30:20"/></para>
  <chapter eid="DEU 30"/>
  <chapter number="31" style="c" sid="DEU 31"/>
  <para style="s">يٌسُوٍ قِندِقٍ عَننَبِ مُنسَ حْشْي رَ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 31:1"/>عَننَبِ مُنسَ نَشَ عَ قَلَ عِسِرَيِلَكَيٍ بِرِن بّ، <verse eid="DEU 31:1"/><verse number="2" style="v" sid="DEU 31:2"/>«ﭑ بَرَ حّ كّمّ حّ مْشْحّن سْتْ يِ تّمُي، ﭑ مُ نْمَ مَنفّيَ رَبَدٍ قَ. عَلَتَلَ حَن عَ قَلَ نّ ﭑ بّ عَ ﭑ مُ يُرُدّن عِفِرِ مَ. <verse eid="DEU 31:2"/><verse number="3" style="v" sid="DEU 31:3"/>وٌ مَرِفِ عَلَتَلَ يّتّ يَتِ نَن وٌ رَحّرّ مَ. عَ سِيٍ بِرِن قَشَمَ نّ نَشٍيٍ نَ نَاكِرِ مَ عَلَكٌ وٌ شَ عٍ شَ بْشِيٍ مَسْتْ. يٌسُوٍ نَن قِندِ مَ وٌ شَ مَنفّ رَ، عَلْ عَلَتَلَ عَ قَلَ كِ نَشّ. <verse eid="DEU 31:3"/><verse number="4" style="v" sid="DEU 31:4"/>عَلَتَلَ يِ سِيٍ هَلَكِمَ نّ عَلْ عَ سِشْن نُن عٌفٌ، عَمٌرِكَيٍ شَ مَنفّيٍ، هَلَكِ كِ نَشّ، نُن عٍ شَ بْشِيٍ. <verse eid="DEU 31:4"/><verse number="5" style="v" sid="DEU 31:5"/>عَ عٍ رَيَرَبِمَ نّ وٌ بّ. وٌ شَ عَ شَ يَامَرِ رَبَ عٍ شَ قٍ رَ. <verse eid="DEU 31:5"/><verse number="6" style="v" sid="DEU 31:6"/>وٌ لِمَنِيَ، وٌ شَ سّنبّ سْتْ، وٌ نَشَ فَاشُ عٍ يَ رَ، بَرِ مَ وٌ مَرِفِ عَلَتَلَ نَ وٌ كَنتَقٍ، عَ مُ وٌ رَبّحِنمَ قٍقٍ مَ.»<verse eid="DEU 31:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 31:7"/>عَننَبِ مُنسَ نَشَ يٌسُوٍ شِلِ، عَ نَشَ وْيّن عَ بّ عِسِرَيِلَكَيٍ بِرِن مَلَنشِ تَفِ، «عِ شَ لِمَنِيَ، عِ شَ سّنبّ سْتْ، بَرِ مَ عِ تَن نَن عِسِرَيِلَكَيٍ رَحّرّ مَ بْشِ مَ عَلَتَلَ دّننَشّ سَاتّ تٌنفٌشِ وٌ بٍنبَيٍ بّ. عِ تَن شَ عٍ شَ كّ سٌ عٍ يِ رَ. <verse eid="DEU 31:7"/><verse number="8" style="v" sid="DEU 31:8"/>عَلَتَلَ تِمَ نّ عِ يَ رَ، عَ مُ عِ رَبّحِنمَ. عَ مُ فبِلٍنمَ عِ قْشْ رَ قٍقٍ مَ. هَلِ عِ مُ فَاشُ، عِ مَن نَشَ عِ يّتّ رَبٌلٌ.»<verse eid="DEU 31:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 31:9"/>عَننَبِ مُنسَ تٌ يِ سّرِيّ سّبّ، عَ نَشَ عَ تَشُ سّرّشّدُبّيٍ رَ، لٍوِ شَ دِ نَشٍيٍ سَاتّ كَنكِرَ شَنِنمَ، نُن عِسِرَيِلَ قٌرِيٍ. <verse eid="DEU 31:9"/><verse number="10" style="v" sid="DEU 31:10"/>عَننَبِ مُنسَ نَشَ عَ مَسٍن عٍ بّ، «حّ سٌلٌقٍرٍ يٌ حّ سٌلٌقٍرٍ، وٌ دِحّمَ دٌنِ مَ حّ نَشَن نَ، وٌ يِ سّرِيّ شَرَنمَ بَفٍ تِ سَلِ لْشْي نّ. <verse eid="DEU 31:10"/><verse number="11" style="v" sid="DEU 31:11"/>وٌ عَ شَرَنمَ وٌ شُي عِتٍشِ نَن نَ عِسِرَيِلَكَيٍ بِرِن بّ، نَشٍيٍ قَشِ سَلِدٍ مَرِفِ عَلَتَلَ يَ عِ عَ شَ يِرٍ سُفَندِشِ. <verse eid="DEU 31:11"/><verse number="12" style="v" sid="DEU 31:12"/>بِرِن مَلَنمَ مّننِ نّ، شّمّ، فِنّ، دِ مّدِ، عَ نُن شْحّ نَشٍيٍ نَ وٌ شْنيِ، عَلَكٌ عٍ شَ يِ شَرَنيِ مّ، عٍ شَ وٌ مَرِفِ عَلَتَلَ بِنيَ، عٍ شَ بِرَ يِ سّرِيّ قْشْ رَ. <verse eid="DEU 31:12"/><verse number="13" style="v" sid="DEU 31:13"/>دِ مّ نَشٍيٍ مُ نُ عَ كٌلٌنشِ سِندٍن، عٍ قَن عَ مّمَ نّ. نَ كُي عٍ وٌ مَرِفِ عَلَتَلَ بِنيَ كِ كٌلٌن، وٌ نَ قَ بْشِ سْتْدٍ يُرُدّن نَاكِرِ مَ تّمُي نَشّ.»<verse eid="DEU 31:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="DEU 31:14"/>عَلَتَلَ نَشَ عَ مَسٍن عَننَبِ مُنسَ بّ، «عِ قَشَ تّمُي بَرَ مَكْرّ، يٌسُوٍ شِلِ، وٌ بِرِن شَ سِفَ ﭑ مَ هْرْ مْلِنفِرَ يِرٍ. مّننِ ﭑ قَ ﭑ مَ يَامَرِ قِ عَ مَ.» عَننَبِ مُنسَ نُن يٌسُوٍ نَشَ سِفَ عَلَ شَ هْرْ مْلِنفِرَ يِرٍ. <verse eid="DEU 31:14"/><verse number="15" style="v" sid="DEU 31:15"/>عَلَتَلَ نَشَ مِنِ عٍ مَ نُشُي كُي نَشَن نُ تٍمَ كِرِ بَنشِ سٌدٍ دّ رَ.<verse eid="DEU 31:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 31:16"/>عَلَتَلَ نَشَ عَ مَسٍن عَننَبِ مُنسَ بّ، «عِ قَ نَ قَشَقٍ نّ. عِ شَ قَشّ شَنبِ، عِسِرَيِلَ حَمَ قَمَ كُيٍيٍ نَن بَتُدٍ بْشِ مَ عٍ قَمَ سِفَدٍ دّننَشّ. عٍ فبِلٍنمَ نّ سَاتّ قْشْ رَ وٌن لَنشِ نَشَن مَ. <verse eid="DEU 31:16"/><verse number="17" style="v" sid="DEU 31:17"/>نَ تّمُي ﭑ بْحّ تٍمَ نّ، ﭑ شْنْ عٍ مَ هَن ﭑ عٍ رَبّحِن. ﭑ نَن ﭑ يَتَفِ نْشُنمَ نّ عٍ مَ، سِ فبّتّيٍ عٍ هَلَكِ، تْورّ نُن قٍ شْرْشْييٍ قَ دُ سُ عٍ شُن نَ. عِسِرَيِلَكَيٍ عَ كٌلٌنمَ نَ تّمُي نّ، يِ تْورّ عٍ لِشِ نّ بَرِ مَ ﭑ تَن، عٍ مَرِفِ عَلَ، مُ نَ عٍ يَ مَ سْنْن. <verse eid="DEU 31:17"/><verse number="18" style="v" sid="DEU 31:18"/>ﭑ نَن ﭑ يَتَفِ نْشُنمَ نّ عٍ مَ، بَرِ مَ عٍ بَرَ قٍ حَاشِ رَبَ كُيٍيٍ بَتُقٍ رَ.»<verse eid="DEU 31:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 31:19"/>«يَكْسِ عِ شَ بّيتِ سّبّ ﭑ نَشَن شَرَنمَ عِ بّ. مُنسَ، عِ شَ عَ شَرَن عِسِرَيِلَكَيٍ بّ عَلَكٌ عٍ نَشَ نّيمُ عَ مَ، عَ مَن شَ قِندِ سٍيدٍ رَ ﭑ تَن نُن عِسِرَيِلَكَيٍ تَفِ. <verse eid="DEU 31:19"/><verse number="20" style="v" sid="DEU 31:20"/>ﭑ قَمَ يِ حَمَ شَنِندٍ بْشِ مَ، شِحّ نُن كُمِ شّلّمَ دّننَشّ، عَلْ ﭑ نَن ﭑ كَلِشِ عٍ بَبَيٍ بّ كِ نَشّ. عٍ نَ بَلٌي دٌن عَ قَنيِ رَ هَن عٍ بٍلٍبٍلٍ، عٍ قَمَ بِرَدٍ عَلَ فبّتّيٍ قْشْ رَ، عٍ مَن ﭑ مَ سَاتّ كَنَ. <verse eid="DEU 31:20"/><verse number="21" style="v" sid="DEU 31:21"/>تْورّيٍ نُن قٍ شْرْشْييٍ قَ بِرَ عٍ قْشْ رَ، يِ بّيتِ قَن قِندِ مَ سٍيدٍ نَن نَ وٌن تَفِ. عٍ بْنسْي مُ نّيمُ عَ مَ. نَشَن نَ عٍ شَشِلِ كُي، ﭑ عَ كٌلٌن. عَ حَن تٌمَ عٍ يَ مَ بٍينُ عٍ شَ سٌ بْشِ كُي ﭑ نَن ﭑ كَلِشِ عٍ بّ نَشَن شَ قٍ رَ.» <verse eid="DEU 31:21"/><verse number="22" style="v" sid="DEU 31:22"/>نَ لْشْي عَننَبِ مُنسَ نَشَ نَ بّيتِ سّبّ، عَلَ نَشَن مَسٍنشِ. عَ نَشَ عَ شَرَن عِسِرَيِلَكَيٍ رَ.<verse eid="DEU 31:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="DEU 31:23"/>نَ شَنبِ عَلَتَلَ نَشَ عَ شَ يَامَرِ سٌ عَننَبِ يٌسُوٍ يِ رَ، نُنُ شَ دِ. عَ نَشَ عَ مَسٍن عَ بّ، «عِ شَ لِمَنِيَ، عِ شَ سّنبّ سْتْ. عِ تَن نَن عِسِرَيِلَكَيٍ رَ سٌمَ بْشِ مَ ﭑ نَن ﭑ كَلِشِ عٍ بّ نَشَن شَ قٍ رَ. وٌن بِرِن نَ عَ رَ.»<verse eid="DEU 31:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="DEU 31:24"/>عَننَبِ مُنسَ نَشَ عَلَ شَ سّرِيّ بِرِن سّبّ كِتَابُي كُي. <verse eid="DEU 31:24"/><verse number="25" style="v" sid="DEU 31:25"/>عَ تٌ فّ، عَ نَشَ وْيّن لٍوِكَيٍ رَ، نَشٍيٍ عَلَتَلَ شَ سَاتّ كَنكِرَ شَنِنمَ. عَ نَشَ عَ مَسٍن عٍ بّ، <verse eid="DEU 31:25"/><verse number="26" style="v" sid="DEU 31:26"/>«وٌ يِ كِتَابُي تٌنفٌ، عَلَ شَ سّرِيّ سّبّشِ نَشَن كُي، وٌ شَ عَ سَ وٌ مَرِفِ عَلَتَلَ شَ سَاتّ كَنكِرَ سّيتِ مَ. عَ شَ لُ مّننِ سٍيدٍ رَ عِسِرَيِلَكَيٍ بّ، <verse eid="DEU 31:26"/><verse number="27" style="v" sid="DEU 31:27"/>بَرِ مَ ﭑ وٌ شَشِلِ شْرْشْيَ كٌلٌن. كَنتَفبٍلٍ نَن وٌ رَ. شَ وٌ عَلَتَلَ مَتَندِ مَ ﭑ وٌ تَفِ تّمُي نَشّ، ﭑ قَشَ شَنبِ وٌ مَن عَ مَتَندِ مَ نّ. <verse eid="DEU 31:27"/><verse number="28" style="v" sid="DEU 31:28"/>يَكْسِ وٌ وٌ مَلَن ﭑ سّيتِ مَ، قٌرِيٍ نُن وٌ بْنسْي يَرٍرَتِيٍ، عَلَكٌ ﭑ شَ يِ مَسٍنيِ شَرَن وٌ بّ. كٌورٍ نُن بْشِ نَن قِندِ مَ سٍيدٍ رَ وٌ شِلِ مَ. <verse eid="DEU 31:28"/><verse number="29" style="v" sid="DEU 31:29"/>ﭑ عَ كٌلٌن ﭑ قَشَ شَنبِ، عِسِرَيِلَكَيٍ يُنُبِ قٍ رَبَمَ نّ، عٍ فبِلٍن كِرَ قْشْ رَ ﭑ نَشَن قَلَشِ عٍ بّ. عٍ نَ قٍ كٌبِ رَبَ نَشَن مُ رَقَن عَلَتَلَ مَ، نَ رَحْنيِ قَ قِندِ عٍ بّ نِمِسّ رَ بَرِ مَ عَ بْحّ تٍمَ نّ.»<verse eid="DEU 31:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="DEU 31:30"/>عَننَبِ مُنسَ نَشَ يِ بّيتِ بِرِن مَسٍن عِسِرَيِلَ حَمَ بّ.<verse eid="DEU 31:30"/></para>
  <chapter eid="DEU 31"/>
  <chapter number="32" style="c" sid="DEU 32"/>
  <para style="s">عَننَبِ مُنسَ شَ بّيتِ</para>
  <para style="b"/>
  <para style="q">
    <verse number="1" style="v" sid="DEU 32:1"/>«كٌورٍ، عِ تُلِ مَتِ ﭑ مَ وْيّنيِ رَ.</para>
  <para style="q" vid="DEU 32:1">بْشِ، عِ تُلِ مَتِ ﭑ قَلَ شُي رَ.<verse eid="DEU 32:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="DEU 32:2"/>ﭑ مَ شَرَنيِ شَ يٍنسٍن يّ عَلْ تُنّ يٍ.</para>
  <para style="q" vid="DEU 32:2">ﭑ مَ مَسٍنيِ شَ لُ عَلْ شِنِ،</para>
  <para style="q" vid="DEU 32:2">نَشَن دْشْمَ بُرّشّيٍ مَ.<verse eid="DEU 32:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="DEU 32:3"/>ﭑ قَ نَ عَلَتَلَ شِلِ نَن مَسٍنقٍ.</para>
  <para style="q" vid="DEU 32:3">وٌ شَ وٌن مَرِفِ عَلَ تَنتُ.»<verse eid="DEU 32:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="DEU 32:4"/>«عَلَتَلَ مَنِيَشِ قَنيٍ نَن نَ،</para>
  <para style="q" vid="DEU 32:4">نَشَن مِشِ كَنتَمَ.</para>
  <para style="q" vid="DEU 32:4">عَ وَلِمَ تِنشِنيِ نَن نَ.</para>
  <para style="q" vid="DEU 32:4">عَ شَ نَتّيٍ بِرِن قَن.</para>
  <para style="q" vid="DEU 32:4">عَ شَ وْيّنيِ مُ كَنَمَ،</para>
  <para style="q" vid="DEU 32:4">وُلٍ يٌ مُ نَ عَ دّ كُي.</para>
  <para style="q" vid="DEU 32:4">عَ تِنشِن.»<verse eid="DEU 32:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="DEU 32:5"/>«كْنْ وٌ تَن، حَمَ حَاشِ،</para>
  <para style="q" vid="DEU 32:5">وٌ بَرَ فٍرٍفِرِ عَلَتَلَ مَ.</para>
  <para style="q" vid="DEU 32:5">يَافِ نَ وٌ بّ.</para>
  <para style="q" vid="DEU 32:5">وٌ بَرَ قِندِ حَمَ كٌبِ رَ.<verse eid="DEU 32:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="DEU 32:6"/>حَمَ دَشُي، حَمَ شَشِلِتَرٍ،</para>
  <para style="q" vid="DEU 32:6">مِشِ لَن عَ شَ نَ قٍ مْولِ رَبَ عَ رَ؟</para>
  <para style="q" vid="DEU 32:6">وٌ بَبَ مُ لَنشِ عَ تَن شَ مَ، وٌ دَا مَرِفِ،</para>
  <para style="q" vid="DEU 32:6">نَشَن وٌ قِندِشِ عَ شَ حَمَ رَ؟<verse eid="DEU 32:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="DEU 32:7"/>وٌ وٌ مَحْشُن لْشْي دَنفِشِيٍ مَ،</para>
  <para style="q" vid="DEU 32:7">وٌ حّيٍ مَتٌ،</para>
  <para style="q" vid="DEU 32:7">وٌ وٌ بَبَيٍ نُن قٌرِيٍ مَشْرِن،</para>
  <para style="q" vid="DEU 32:7">عٍ شَ قٍ دَنفِشِيٍ تَفِ رَبَ وٌ بّ.<verse eid="DEU 32:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="DEU 32:8"/>عَلَ شِلِ شُنفبٍ كَنيِ نَشَ بْشِ عِتَشُن عَدَ مَدِيٍ مَ.</para>
  <para style="q" vid="DEU 32:8">عَ نَشَ بْشِيٍ نَانِنيِ سَ عِسِرَيِلَ شَ دِيٍ شَسَبِ مَ.<verse eid="DEU 32:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="DEU 32:9"/>عِسِرَيِلَ حَمَ نَشَ قِندِ عَ فبٍ رَ.</para>
  <para style="q" vid="DEU 32:9">عَلَتَلَ نَشَ يَشُبَ شَ دِيٍ قِندِ عَ يّتّ فبٍ رَ.»<verse eid="DEU 32:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="DEU 32:10"/>«عَ عِسِرَيِلَ تٌشِ فبٍنفبٍرٍن يِرٍ نّ.</para>
  <para style="q" vid="DEU 32:10">عَ نَشَ عَ حّنفِ سَ عَ شْن مَ،</para>
  <para style="q" vid="DEU 32:10">عَ نَشَ مّينِ عَ مَ عَلْ عَ يَ دِ قِرِنيِيٍ.<verse eid="DEU 32:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="DEU 32:11"/>عَ لُشِ نّ عَلْ سّفّ،</para>
  <para style="q" vid="DEU 32:11">نَشَن لُمَ عَ شَ دِيٍ شُن مَ،</para>
  <para style="q" vid="DEU 32:11">عَ عَ فَبُتٍنيِ عِتَلَ،</para>
  <para style="q" vid="DEU 32:11">عَ دِيٍ شَنِن.<verse eid="DEU 32:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="DEU 32:12"/>عَلَتَلَ كٍرٍن ثٍتِ نَن عَ شَ حَمَ كَنتَشِ.</para>
  <para style="q" vid="DEU 32:12">عَلَ فبّتّ يٌ مُ كَقُ عَ مَ.»<verse eid="DEU 32:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="DEU 32:13"/>«عَ نَشَ وٌ رَ سَبَتِ فٍيَ قَرِ.</para>
  <para style="q" vid="DEU 32:13">عَ نَشَ وٌ رَبَلٌ شّ سَنسِيٍ شُن نَ.</para>
  <para style="q" vid="DEU 32:13">عَ نَشَ كُمِ نُن تُرٍ رَ مِنِ وٌ بّ فّمّ لٌنفٌرِ رَ.<verse eid="DEU 32:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="DEU 32:14"/>عَ نَشَ نِنفٍ نُن يّشّي شِحّ قِ وٌ مَ.</para>
  <para style="q" vid="DEU 32:14">عَ نَشَ يّشّيٍ، سِيٍ، نُن سِ كٌنتٌنيِيٍ قِ وٌ مَ سُبٍ رَ</para>
  <para style="q" vid="DEU 32:14">كٍلِقٍ بَسَن بْشِ مَ.</para>
  <para style="q" vid="DEU 32:14">عَ نَشَ مّنفِ قِ وٌ مَ وٌ نَشَن دٌنمَ،</para>
  <para style="q" vid="DEU 32:14">عَ نَشَ وّنِ قِ وٌ مَ وٌ نَشَن مِنمَ.»<verse eid="DEU 32:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="DEU 32:15"/>«عِسِرَيِلَ تِنشِنشِ نَشَ بٍلٍبٍلٍ،</para>
  <para style="q" vid="DEU 32:15">عَ نَشَ قِندِ دِ قَنيِ رَ،</para>
  <para style="q" vid="DEU 32:15">كْنْ عَ بَرَ فبِلٍن عَلَ قْشْ رَ، عَ دَا مَرِفِ،</para>
  <para style="q" vid="DEU 32:15">عَ بَرَ عَ كَنتَمَ، عَ رَكِسِمَ رَيَافِ.<verse eid="DEU 32:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="DEU 32:16"/>عِسِرَيِلَ نَشَ عَلَ رَشْنْ</para>
  <para style="q" vid="DEU 32:16">بَرِ مَ عَ بِرَ نّ عَلَ فبّتّيٍ قْشْ رَ،</para>
  <para style="q" vid="DEU 32:16">عٍ قٍ حَاشِ رَبَ.<verse eid="DEU 32:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="DEU 32:17"/>عٍ نَشَ سّرّشّ بَ حِننّيٍ بّ،</para>
  <para style="q" vid="DEU 32:17">نَشٍيٍ مُ نَ عَلَ رَ،</para>
  <para style="q" vid="DEU 32:17">عٍ مُ نَشٍيٍ كٌلٌن سِندٍن،</para>
  <para style="q" vid="DEU 32:17">عٍ بَبَيٍ مُ نَشٍيٍ كٌلٌن.<verse eid="DEU 32:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="DEU 32:18"/>عِسِرَيِلَكَيٍ، وٌ بَرَ نّيمُ وٌ كَنتَمَ مَ</para>
  <para style="q" vid="DEU 32:18">نَشَن وٌ رَ مِنِشِ دُنِحَ مَ،</para>
  <para style="q" vid="DEU 32:18">نَشَن سِمَيَ قِمَ وٌ مَ.»<verse eid="DEU 32:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="DEU 32:19"/>«عَلَتَلَ تٌ بَرَ عَ شَ دِيٍ كّحَ تٌ،</para>
  <para style="q" vid="DEU 32:19">عَ نَشَ شْنْ عٍ مَ.<verse eid="DEU 32:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="DEU 32:20"/>عَ نَشَ عَ مَسٍن،</para>
  <para style="q" vid="DEU 32:20">‹ﭑ شَ فبِلٍن عٍ كَنتَقٍ قْشْ رَ،</para>
  <para style="q" vid="DEU 32:20">ﭑ قَ عَ مَتٌ قٍ نَشَن قَمَ عٍ لِدٍ.›</para>
  <para style="q" vid="DEU 32:20">عٍ مُ قَن.</para>
  <para style="q" vid="DEU 32:20">يَنقَنتٍ نَن عٍ رَ.<verse eid="DEU 32:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="DEU 32:21"/>عٍ بَرَ ﭑ نَشْنْ عَلَ وُلٍيٍ رَ.</para>
  <para style="q" vid="DEU 32:21">عٍ بَرَ ﭑ بْحّ رَتٍ كُيٍيٍ رَ.</para>
  <para style="q" vid="DEU 32:21">ﭑ تَن قَن عٍ رَشْنْمَ نّ مِشِيٍ رَ،</para>
  <para style="q" vid="DEU 32:21">حَمَ قَنيِ مُ نَ نَشٍيٍ رَ.</para>
  <para style="q" vid="DEU 32:21">ﭑ عٍ بْحّ رَتٍ سِ شَشِلِتَرٍ مَ.»<verse eid="DEU 32:21"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="22" style="v" sid="DEU 32:22"/>«عِيٌ، ﭑ مَ شْنّ بَرَ فبٌ يّ،</para>
  <para style="q" vid="DEU 32:22">هَن عَ بَرَ مِشِ قَشَشِيٍ رَ مَشَ.</para>
  <para style="q" vid="DEU 32:22">عَ لُمَ عَلْ تّ نَشَن بْشِ نُن عَ دَشَمُي فَنمَ،</para>
  <para style="q" vid="DEU 32:22">هَن عَ سَ دْشْ فٍيَيٍ سَنكٍ رَ.<verse eid="DEU 32:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="DEU 32:23"/>ﭑ قٍ حَاشِ رَفبٌمَ نّ عٍ قَرِ،</para>
  <para style="q" vid="DEU 32:23">ﭑ نَن ﭑ مَ شَلِيٍ بِرِن وٌلِمَ نّ.<verse eid="DEU 32:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="DEU 32:24"/>ﭑ كَامّ رَ سٌمَ بْشِ مَ،</para>
  <para style="q" vid="DEU 32:24">ﭑ قُرٍ حَاشِ رَ سَنبَمَ نّ عٍ مَ،</para>
  <para style="q" vid="DEU 32:24">ﭑ وُلَءِ سُبٍ مَفَاشُشِيٍ رَ مِنِمَ نّ عٍ مَ،</para>
  <para style="q" vid="DEU 32:24">عَ نُن بْشِمَسٍ شْنّ كَنيِيٍ.<verse eid="DEU 32:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="DEU 32:25"/>نَشٍيٍ نَ تَندٍ، قَنقٌرٍ نَن عٍ قَشَمَ.</para>
  <para style="q" vid="DEU 32:25">نَشٍيٍ نَ بَنشِ كُي، فَاشُي نَن عٍ قَشَمَ.</para>
  <para style="q" vid="DEU 32:25">عٍ بِرِن قَشَمَ نّ،</para>
  <para style="q" vid="DEU 32:25">شّمّ نُن فِنّ، دِ مّدِ نُن قٌرِ.»<verse eid="DEU 32:25"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="26" style="v" sid="DEU 32:26"/>«ﭑ نُ وَ مَ نّ عٍ بِرِن هَلَكِقٍ،</para>
  <para style="q" vid="DEU 32:26">عٍ شِلِ شَ لْي دُنِحَ مَ.<verse eid="DEU 32:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="DEU 32:27"/>كْنْ ﭑ مُ تِن يَشُييٍ شَ ﭑ مَيٍلٍ.</para>
  <para style="q" vid="DEU 32:27">ﭑ مُ وَ عٍ شَ عَ مَحْشُن</para>
  <para style="q" vid="DEU 32:27">عَ عٍ تَن نَن يِ وَلِ رَبَشِ،</para>
  <para style="q" vid="DEU 32:27">عَلَ شَ قْشِ مُ عَ رَ.<verse eid="DEU 32:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="DEU 32:28"/>شَشِلِ كَنيِ مُ نَ عٍ رَ،</para>
  <para style="q" vid="DEU 32:28">لْننِ مُ عٍ يِ.<verse eid="DEU 32:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="DEU 32:29"/>شَ لْننِ كَنيِ نَن عٍ رَ نُ،</para>
  <para style="q" vid="DEU 32:29">عٍ عٍ سِفَدٍ كٌلٌنمَ نّ نُ.<verse eid="DEU 32:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="DEU 32:30"/>يَشُي كٍرٍن تَن نْمَ عِسِرَيِلَكَ وُلُ كٍرٍن نَفِدٍ دِ؟</para>
  <para style="q" vid="DEU 32:30">يَشُي قِرِن نْمَ بِرَدٍ مِشِ وُلُ قُ قْشْ رَ دِ؟</para>
  <para style="q" vid="DEU 32:30">عِيٌ، شَ عٍ مَرِفِ، عٍ كَنتَمَ سَ عٍ لُ عٍ يَشُييٍ سَفٌي،</para>
  <para style="q" vid="DEU 32:30">نَ نْمَ نّ رَبَدٍ.<verse eid="DEU 32:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="DEU 32:31"/>يَشُييٍ يَتِ عَ كٌلٌن،</para>
  <para style="q" vid="DEU 32:31">عٍ شَ عَلَ عٍ كَنتَمَ مُ دَنفِ عِسِرَيِلَ مَرِفِ عَلَتَلَ رَ.<verse eid="DEU 32:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="DEU 32:32"/>عٍ شَ قٍ مُ دَنفِ سٌدٌ مَ نُن فٌمٌرَ رَ.</para>
  <para style="q" vid="DEU 32:32">عٍ بِرِن مَنِيَشِ وّنِ بِلِ نَن نَ</para>
  <para style="q" vid="DEU 32:32">نَشَن بٌفِ شْنّيٍ رَ مِنِمَ،<verse eid="DEU 32:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="DEU 32:33"/>نَشَن يٍ لُشِ عَلْ بْشِمَسٍ شْنّ.<verse eid="DEU 32:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="DEU 32:34"/>نَ بِرِن نَفَتَشِ فُندٌ نَن نَ ﭑ شْنيِ.<verse eid="DEU 32:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="DEU 32:35"/>عٍ نَ بِرَ،</para>
  <para style="q" vid="DEU 32:35">ﭑ نَن ﭑ فبٍحْشْمَ نّ.</para>
  <para style="q" vid="DEU 32:35">عَ فبٍفبٍ مُ لُشِ.</para>
  <para style="q" vid="DEU 32:35">عٍ يِفِ تّفّ لْشْي بَرَ مَكْرّ.»<verse eid="DEU 32:35"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="36" style="v" sid="DEU 32:36"/>«عَلَتَلَ قَمَ عَ شَ حَمَ مَكِيتِدٍ،</para>
  <para style="q" vid="DEU 32:36">كْنْ عَ مَن كِنِكِنِمَ نّ عٍ مَ،</para>
  <para style="q" vid="DEU 32:36">بَرِ مَ عٍ سّنبّ يٌ مُ نَ.</para>
  <para style="q" vid="DEU 32:36">مِشِ يٌ مُ نَ نَشَن نْمَ عٍ مَلِدٍ.<verse eid="DEU 32:36"/></para>
  <para style="q">
    <verse number="37" style="v" sid="DEU 32:37"/>عَلَ عٍ مَشْرِنمَ نّ قَ،</para>
  <para style="q" vid="DEU 32:37">‹وٌ شَ عَلَيٍ نَ مِندٍن،</para>
  <para style="q" vid="DEU 32:37">نَشٍيٍ نُ وٌ كَنتَمَ،<verse eid="DEU 32:37"/></para>
  <para style="q">
    <verse number="38" style="v" sid="DEU 32:38"/>وٌ نَشٍيٍ رَبَلٌشِ سُبٍ تُرٍ رَ،</para>
  <para style="q" vid="DEU 32:38">وٌ نُ وّنِ سٌمَ نَشٍيٍ يِ رَ؟</para>
  <para style="q" vid="DEU 32:38">عٍ شَ عٍ يّتّ مَسٍن وٌ بّ،</para>
  <para style="q" vid="DEU 32:38">عٍ شَ وٌ رَكِسِ، عٍ شَ وٌ رَتَنفَ.<verse eid="DEU 32:38"/></para>
  <para style="q">
    <verse number="39" style="v" sid="DEU 32:39"/>يَكْسِ وٌ شَ عَ كٌلٌن،</para>
  <para style="q" vid="DEU 32:39">ﭑ تَن نَن كٍرٍن ثٍتِ نْمَ مِشِ رَكِسِدٍ.</para>
  <para style="q" vid="DEU 32:39">عَلَ فبّتّ مُ نَ قٌ ﭑ كٍرٍن.</para>
  <para style="q" vid="DEU 32:39">ﭑ تَن نَن مِشِ قَشَمَ، ﭑ عَ رَكٍلِ.</para>
  <para style="q" vid="DEU 32:39">ﭑ تَن نَن مِشِ مَشْنْمَ، ﭑ عَ رَيَلَن.</para>
  <para style="q" vid="DEU 32:39">ندٍ فبّتّ نْمَ مِشِ ندٍ بَدٍ ﭑ بّلّشّ؟<verse eid="DEU 32:39"/></para>
  <para style="q">
    <verse number="40" style="v" sid="DEU 32:40"/>ﭑ كَلِ نَشَن تِ،</para>
  <para style="q" vid="DEU 32:40">ﭑ بّلّشّ تِشِ كٌورٍ مَ نَ نَن يِ كِ؛</para>
  <para style="q" vid="DEU 32:40">ﭑ حِحّ. ﭑ مُ قَشَمَ عَبَدَن!<verse eid="DEU 32:40"/></para>
  <para style="q">
    <verse number="41" style="v" sid="DEU 32:41"/>شَ ﭑ قَنقٌرٍ رَلُفَن،</para>
  <para style="q" vid="DEU 32:41">شَ ﭑ عَ سُشُ ﭑ بّلّشّ كُي،</para>
  <para style="q" vid="DEU 32:41">ﭑ نَن ﭑ فبٍحْشْمَ نّ ﭑ فٍرٍقَيٍ مَ،</para>
  <para style="q" vid="DEU 32:41">ﭑ سَرٍ قِمَ نّ ﭑ شْنمَيٍ مَ.<verse eid="DEU 32:41"/></para>
  <para style="q">
    <verse number="42" style="v" sid="DEU 32:42"/>ﭑ نَن ﭑ مَ شَلِيٍ رَ سِيسِمَ نّ وُلِ رَ،</para>
  <para style="q" vid="DEU 32:42">ﭑ مَ قَنقٌرٍ سُبٍ دٌنمَ نّ.</para>
  <para style="q" vid="DEU 32:42">فٍرٍ سٌي يٌ مُ كِسِمَ.›»<verse eid="DEU 32:42"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="43" style="v" sid="DEU 32:43"/>«سِ بِرِن شَ سّيوَ عَلَتَلَ شَ حَمَ رَ.</para>
  <para style="q" vid="DEU 32:43">عَلَتَلَ عَ شَ كٌنيِيٍ شَ قَشّ حْشْمَ نّ.</para>
  <para style="q" vid="DEU 32:43">عَ تْورّ دْشْمَ نّ عَ فٍرٍقَيٍ مَ.</para>
  <para style="q" vid="DEU 32:43">عَ عَ شَ حَمَ نُن عَ شَ بْشِ شُن سَرَ مَ نّ.»<verse eid="DEU 32:43"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="44" style="v" sid="DEU 32:44"/>عَننَبِ مُنسَ نُن عَننَبِ يٌسُوٍ، نُنُ شَ دِ، نَشَ يِ بّيتِ مَسٍنيِ بِرِن شَرَن حَمَ بّ عٍ شُي عِتٍشِ رَ. <verse eid="DEU 32:44"/><verse number="45" style="v" sid="DEU 32:45"/>عَننَبِ مُنسَ تٌ فّ عَلَتَلَ شَ مَسٍنيِ تِدٍ عِسِرَيِلَكَيٍ بّ، <verse eid="DEU 32:45"/><verse number="46" style="v" sid="DEU 32:46"/>عَ نَشَ عَ قَلَ عٍ بّ، «وٌ شَ يِ مَسٍنيِ سُشُ سّنبّ رَ ﭑ نَشَن شَرَنشِ وٌ بّ تٌ لْشْي. وٌ شَ عَ شَرَن وٌ شَ دِيٍ بّ، عَلَكٌ عٍ شَ نْ عَلَتَلَ شَ سّرِيّ رَبَتُدٍ عَ قَنيِ رَ. <verse eid="DEU 32:46"/><verse number="47" style="v" sid="DEU 32:47"/>مَسٍنيِ تِلِنشِ نَن يِ مَسٍنيِ رَ، عَ نَشَ لُ وٌ بّ عَلْ مَسٍنيِ قُقَقُي. عَ سِمَيَ نَن قِمَ وٌ مَ بْشِ مَ وٌ قَمَ دّننَشّ سْتْدٍ يُرُدّن نَاكِرِ مَ.»<verse eid="DEU 32:47"/></para>
  <para style="s">عَننَبِ مُنسَ شَ قَشّ حْفْنيِ</para>
  <para style="p">
    <verse number="48" style="v" sid="DEU 32:48"/>نَ لْشْي كٍرٍنيِ كُي، عَلَتَلَ نَشَ عَ مَسٍن عَننَبِ مُنسَ بّ، <verse eid="DEU 32:48"/><verse number="49" style="v" sid="DEU 32:49"/>«سِفَ عَبَرِ مِ فٍيَ لٌنفٌرِ، نٍبٌ فٍيَ قَرِ مٌوَبَ بْشِ مَ، يٍرِكٌ يَ تَفِ. مّننِ عِ شَ كَنَان بْشِ مَتٌ، ﭑ نَشَن قِمَ عِسِرَيِلَكَيٍ مَ. <verse eid="DEU 32:49"/><verse number="50" style="v" sid="DEU 32:50"/>عِ نَ تٍ فٍيَ قَرِ، عِ قَمَ سَيَ سْتْدٍ نَا، عِ عِ بٍنبَيٍ لِ عَلِفِيَمَ، عَلْ عِ تَارَ هَرُنَ شَ قٍ رَبَشِ كِ نَشّ هٌرٌ فٍيَ قَرِ. <verse eid="DEU 32:50"/><verse number="51" style="v" sid="DEU 32:51"/>وٌ نَ سْتْشِ نّ، بَرِ مَ وٌ مُ وٌ شَشِلِ تِ ﭑ نَ عِسِرَيِلَكَيٍ يَ شْرِ مٍرِبَ يٍ يِرٍ، كَدٍ سِ بِرِ رَ، سِنِ فبٍنفبٍرٍنيِ مَ. نَ كُي وٌ مُ تِن ﭑ بِنيَدٍ حَمَ يَ شْرِ. <verse eid="DEU 32:51"/><verse number="52" style="v" sid="DEU 32:52"/>نَ قٍ نَ عَ نِيَشِ عَ عِ نْمَ بْشِ تٌدٍ يِرٍ مَكُيٍ فبَنسَن نّ، ﭑ نَشَن قِشِ عِسِرَيِلَكَيٍ مَ، كْنْ عِ تَن فُندِ مُ سٌمَ نَا.»<verse eid="DEU 32:52"/></para>
  <chapter eid="DEU 32"/>
  <chapter number="33" style="c" sid="DEU 33"/>
  <para style="s">مُنسَ شَ دُبّ عِسِرَيِلَ بّ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 33:1"/>بٍينُ عَننَبِ مُنسَ شَ لَاشِرَ، عَلَ شَ مِشِ، عَ دُبَ نّ عِسِرَيِلَكَيٍ بّ. عَ شَ دُبّ مَسٍنيِ نَن يَ؛<verse eid="DEU 33:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="DEU 33:2"/>«عَلَتَلَ كٍلِ نّ تُرُ سِنِنَ فٍيَ قَرِ عَلْ سٌفٍ.</para>
  <para style="q" vid="DEU 33:2">عَ نَشَ تٍ سٍيِرِ بْشِ مَ عِسِرَيِلَكَيٍ نُ نَ دّننَشّ.</para>
  <para style="q" vid="DEU 33:2">عَ نَشَ كٍلِ ثَرَن فٍيَ يِرٍقَنيِ مَ،</para>
  <para style="q" vid="DEU 33:2">مَلٍكّ فبٍفبٍ بِرَشِ عَ قْشْ رَ.<verse eid="DEU 33:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="DEU 33:3"/>عَلَتَلَ عِسِرَيِلَ بْنسْي شَنُمَ.</para>
  <para style="q" vid="DEU 33:3">عَ عَ شَ مِشِيٍ كَنتَمَ،</para>
  <para style="q" vid="DEU 33:3">نَشٍيٍ بِرَ مَ عَ شَ سّرِيّ قْشْ رَ.<verse eid="DEU 33:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="DEU 33:4"/>عَننَبِ مُنسَ بَرَ عَ شَ سّرِيّ قِ وٌن مَ.</para>
  <para style="q" vid="DEU 33:4">نَ سّرِيّ قِندِشِ يَشُبَ بْنسْي شَ دَرِيّ مَتٍ نَن نَ.<verse eid="DEU 33:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="DEU 33:5"/>عَلَتَلَ قِندِشِ عِسِرَيِلَ شَ مَنفّ نَن نَ،</para>
  <para style="q" vid="DEU 33:5">حَمَ مَنفّيٍ شَ مَلَنيِ</para>
  <para style="q" vid="DEU 33:5">عٍ نُن عِسِرَيِلَ بْنسْييٍ بِرِن نَ.»<verse eid="DEU 33:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="DEU 33:6"/>«عَلَتَلَ شَ رُبٍن بْنسْي شَ سِمَيَ شُن مَسَ.</para>
  <para style="q" vid="DEU 33:6">عَ شَ مِشِيٍ شَ فبٌ.»<verse eid="DEU 33:6"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="7" style="v" sid="DEU 33:7"/>عَننَبِ مُنسَ يِ مَسٍنيِ نَن تِ يُدَ بْنسْي شَ قٍ رَ،</para>
  <para style="q" vid="DEU 33:7">«عَلَتَلَ شَ يُدَ بْنسْي شُي رَ مّ،</para>
  <para style="q" vid="DEU 33:7">عَلَكٌ عَ شَ فبِلٍن عَ شَ حَمَ مَ.</para>
  <para style="q" vid="DEU 33:7">عَ نَ كَتَقٍ.</para>
  <para style="q" vid="DEU 33:7">عَلَتَلَ شَ عَ مَلِ عَ يَشُييٍ يَ رَ.»<verse eid="DEU 33:7"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="8" style="v" sid="DEU 33:8"/>عَننَبِ مُنسَ يِ مَسٍنيِ نَن تِ لٍوِ بْنسْي شَ قٍ رَ،</para>
  <para style="q" vid="DEU 33:8">«عَلَتَلَ، عِ بَرَ عِ شَ تْنشُمَيٍ تُمِمِ نُن عُرِ مِ سٌ لٍوِ بْنسْي يِ رَ.</para>
  <para style="q" vid="DEU 33:8">بْنسْي تِنشِنشِ نَن عٍ رَ</para>
  <para style="q" vid="DEU 33:8">عِ نَشٍيٍ مَتٌ مَسَ،</para>
  <para style="q" vid="DEU 33:8">عِ نَشٍيٍ مَكِيتِ مٍرِبَ يٍ شَ قٍ رَ.<verse eid="DEU 33:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="DEU 33:9"/>عٍ مُ بِرَ مَ عٍ بَبَ نُن عٍ نفَ سَفٌي شَ قْشْ رَ،</para>
  <para style="q" vid="DEU 33:9">شَ نَ مُ عٍ نفَشَكٍرٍنيِيٍ نُن عٍ شَ دِيٍ،</para>
  <para style="q" vid="DEU 33:9">عٍ تَن بِرَ مَ عِ شَ مَسٍنيِ فبَنسَن نَن قْشْ رَ،</para>
  <para style="q" vid="DEU 33:9">عٍ بِرَ مَ عِ شَ سَاتّ نَن تُن قْشْ رَ.<verse eid="DEU 33:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="DEU 33:10"/>عٍ تَن نَن عِ شَ يَامَرِ مَسٍنمَ يَشُبَ بْنسْييٍ بّ،</para>
  <para style="q" vid="DEU 33:10">عٍ تَن نَن عِ شَ سّرِيّ رَشَرَنمَ عِسِرَيِلَكَيٍ بِرِن نَ.</para>
  <para style="q" vid="DEU 33:10">عٍ تَن نَن مَن سُرَيِ بَمَ سّرّشّ رَ،</para>
  <para style="q" vid="DEU 33:10">عٍ سّرّشّ فَن دَاشِ بَ عِ شَ سّرّشّبَدٍ.<verse eid="DEU 33:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="DEU 33:11"/>عَلَتَلَ، عِ شَ سّنبّ قِ عٍ مَ،</para>
  <para style="q" vid="DEU 33:11">عِ شَ بَرَكّ سَ عٍ شَ قٍ بِرِن،</para>
  <para style="q" vid="DEU 33:11">عِ شَ عٍ فٍرٍقَيٍ رَكٌرِ،</para>
  <para style="q" vid="DEU 33:11">عِ شَ عٍ يَشُييٍ رَبِرَ</para>
  <para style="q" vid="DEU 33:11">عَلَكٌ عٍ نَشَ فبِلٍن شَنبِ رَ قٍقٍ مَ.»<verse eid="DEU 33:11"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="12" style="v" sid="DEU 33:12"/>عَننَبِ مُنسَ يِ مَسٍنيِ نَن تِ بُنيَمِن بْنسْي شَ قٍ رَ،</para>
  <para style="q" vid="DEU 33:12">«عَلَتَلَ شَنُنتٍنيِ نَن لَنشِ عٍ مَ.</para>
  <para style="q" vid="DEU 33:12">عٍ مَرِفِ عَلَ عٍ رَتَنفَمَ نّ،</para>
  <para style="q" vid="DEU 33:12">عَ مَن لُمَ نّ عٍ تَفِ،</para>
  <para style="q" vid="DEU 33:12">عَ عٍ كَنتَمَ تّمُي بِرِن.»<verse eid="DEU 33:12"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="13" style="v" sid="DEU 33:13"/>عَننَبِ مُنسَ يِ مَسٍنيِ نَن تِ يُسُقُ بْنسْي شَ قٍ رَ،</para>
  <para style="q" vid="DEU 33:13">«عَلَتَلَ بَرَ بَرَكّ سَ عٍ شَ بْشِ.</para>
  <para style="q" vid="DEU 33:13">عٍ يٍ سْتْمَ نّ كٍلِ كٌورٍ مَ،</para>
  <para style="q" vid="DEU 33:13">عٍ يٍ سْتْ كٍلِ بْشِ بُن مَ.<verse eid="DEU 33:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="DEU 33:14"/>سٌفٍ سَنسِيٍ رَقَنمَ نّ،</para>
  <para style="q" vid="DEU 33:14">كِكٍ يٌ كِكٍ بٌفِيٍ فبٍيلِ لُمَ نّ نَا.<verse eid="DEU 33:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="DEU 33:15"/>عٍ دَشَمُي قَنيِ سْتْمَ نّ عٍ شَ فٍيَيٍ قَرِ،</para>
  <para style="q" vid="DEU 33:15">نَشٍيٍ تِشِ نَا كَبِ عَ قْلّ.<verse eid="DEU 33:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="DEU 33:16"/>عَلَ شَ يِ بْشِ دَشَمُي سٍ قَن.</para>
  <para style="q" vid="DEU 33:16">نَشَن وْيّن وُرِ بِلِ رَدّشّشِ كُي،</para>
  <para style="q" vid="DEU 33:16">عَ شَ هِننّ يُسُقُ رَ،</para>
  <para style="q" vid="DEU 33:16">عَ نَشَن سُفَندِشِ مَنفّ رَ عَ نفَشَكٍرٍنيِيٍ تَفِ.<verse eid="DEU 33:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="DEU 33:17"/>شُننَكٍلِ نَ يُسُقُ بّ.</para>
  <para style="q" vid="DEU 33:17">عَ سّنبّ فبٌ عَلْ نِنفٍ تُورَ،</para>
  <para style="q" vid="DEU 33:17">قٍرِ قِرِن نَن نَ عَ شَ فٍرٍ سٌسٍ رَ عَلْ سّشّ نِنفٍ.</para>
  <para style="q" vid="DEU 33:17">عَ سِيٍ بِرِن بْنبْمَ نٍيٍ نَن نَ هَن يِرٍ مَكُيٍ.</para>
  <para style="q" vid="DEU 33:17">عٍقِرَ مِ شَ دِ وُيَشِيٍ نَن عَ قٍرِ سِنفٍ رَ.</para>
  <para style="q" vid="DEU 33:17">مَنَسِ شَ دِ وُيَشِيٍ نَن عَ قٍرِ قِرِن ندٍ رَ.»<verse eid="DEU 33:17"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="18" style="v" sid="DEU 33:18"/>عَننَبِ مُنسَ يِ مَسٍنيِ نَن تِ سَبُلٌن بْنسْي شَ قٍ رَ،</para>
  <para style="q" vid="DEU 33:18">«سَبُلٌن بْنسْي، وٌ شَ سّيوَ يُلّيَ نَن كُي.</para>
  <para style="q" vid="DEU 33:18">عِسَكَرِ بْنسْي، وٌ شَ سّيوَ وٌ شَ كِرِ بَنشِ نَن كُي.<verse eid="DEU 33:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="DEU 33:19"/>وٌ وٌ دْشْبٌورٍيٍ شِلِمَ نّ،</para>
  <para style="q" vid="DEU 33:19">وٌ سّرّشّ بَ فٍيَ قَرِ عَلَ وَ شْن كِ مَ،</para>
  <para style="q" vid="DEU 33:19">بَرِ مَ وٌ وٌ بَلٌي سْتْمَ قْشْ يٍ نّ،</para>
  <para style="q" vid="DEU 33:19">عَ نُن هّيرِ نَشَن نَ مّيّنيِ كُي.»<verse eid="DEU 33:19"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="20" style="v" sid="DEU 33:20"/>عَننَبِ مُنسَ يِ مَسٍنيِ نَن تِ فَدِ شَ قٍ رَ،</para>
  <para style="q" vid="DEU 33:20">«عَلَ شَ بَرَكّ سَ مِشِ شَ قٍ،</para>
  <para style="q" vid="DEU 33:20">نَشَن فَدِ شَ قٍ فبٌمَ.</para>
  <para style="q" vid="DEU 33:20">فَدِ مَلَبُمَ نّ،</para>
  <para style="q" vid="DEU 33:20">عَلْ يّتّ نَشَن عَ شَ سُبٍ عِبْوشِ دٌنمَ.<verse eid="DEU 33:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="DEU 33:21"/>فَدِ بَرَ بْشِ قَنيِ قِندِ عَ فبٍ رَ،</para>
  <para style="q" vid="DEU 33:21">عَلْ مَنفّ نَشَن عَ حّرّ مَ حَمَ يَ رَ.</para>
  <para style="q" vid="DEU 33:21">عَ بَرَ عَلَتَلَ شَ نَتّ رَكَمَلِ،</para>
  <para style="q" vid="DEU 33:21">عَ مَن بَرَ عَلَ شَ كِيتِ سَ عِسِرَيِلَ مَ.»<verse eid="DEU 33:21"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="22" style="v" sid="DEU 33:22"/>عَننَبِ مُنسَ يِ مَسٍنيِ نَن تِ دَنَ بْنسْي شَ قٍ رَ،</para>
  <para style="q" vid="DEU 33:22">«دَنَ لُشِ نّ عَلْ يّتّ يْرّ،</para>
  <para style="q" vid="DEU 33:22">نَشَن تُفَنمَ بَسَن بْشِ مَ.»<verse eid="DEU 33:22"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="23" style="v" sid="DEU 33:23"/>عَننَبِ مُنسَ يِ مَسٍنيِ نَن تِ نَقَتَلِ بْنسْي شَ قٍ رَ،</para>
  <para style="q" vid="DEU 33:23">«شُننَقَنيِ فبٍفبٍ نَ نَقَتَلِ نَن بّ.</para>
  <para style="q" vid="DEU 33:23">عَلَتَلَ عَ رَكَمَلِشِ قٍ قَنيِ رَ.</para>
  <para style="q" vid="DEU 33:23">عَ شَ بْشِ شَ فبٌ يّ سٌفٍفٌرٌدٍ نُن يِرٍقَنيِ.»<verse eid="DEU 33:23"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="24" style="v" sid="DEU 33:24"/>عَننَبِ مُنسَ يِ مَسٍنيِ نَن تِ عَسٍرِ بْنسْي شَ قٍ رَ،</para>
  <para style="q" vid="DEU 33:24">«عَلَتَلَ شَ بَرَكّ سَ عَسٍرِ، يَشُبَ شَ دِيٍ تَفِ.</para>
  <para style="q" vid="DEU 33:24">عَ نفَشَكٍرٍنيِيٍ شَ هِننّ عَ رَ.</para>
  <para style="q" vid="DEU 33:24">عَ شَ تُرٍ شَ فبٌ هَن.<verse eid="DEU 33:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="DEU 33:25"/>عَ شَ نَادّيٍ شَ يَءِلَن وُرٍ نُن وُرٍ فبٍيلِ رَ.</para>
  <para style="q" vid="DEU 33:25">عَ سّنبّ شَ بُ عَلْ عَ شَ سِمَيَ.»<verse eid="DEU 33:25"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="26" style="v" sid="DEU 33:26"/>«عِسِرَيِلَ، عَلَ مَنِيّ يٌ مُ نَ.</para>
  <para style="q" vid="DEU 33:26">عَ عَ حّرّ مَ كٌورٍ مَ قَقٍ رَ عِ مَلِدٍ.</para>
  <para style="q" vid="DEU 33:26">عَ نُشُي عِفِرِ مَ نْرّ رَ.<verse eid="DEU 33:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="DEU 33:27"/>عَلَ، قْلّ مُ نَشَن بّ، نَ نَن عِ كَنتَمَ رَ،</para>
  <para style="q" vid="DEU 33:27">عَ بّلّشّ نَ عِ بُن كَبِ قٍ قْلْ قْلّ.</para>
  <para style="q" vid="DEU 33:27">عَ تَن نَن عِ يَشُييٍ كٍرِ مَ عِ يَ رَ،</para>
  <para style="q" vid="DEU 33:27">عَ مَن قَ عَ مَسٍن عِ بّ عِ شَ عٍ هَلَكِ.<verse eid="DEU 33:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="DEU 33:28"/>عِسِرَيِلَ سَبَتِمَ كَنتَرِ نَن كُي.</para>
  <para style="q" vid="DEU 33:28">يَشُبَ بْنسْي لُمَ عَلَ نِينِ نَن بُن مَ.</para>
  <para style="q" vid="DEU 33:28">مّنفِ نُن وّنِ فبٌمَ نّ نَ بْشِ كُي،</para>
  <para style="q" vid="DEU 33:28">يٍ قَن كٍلِمَ نّ كٌورٍ مَ.<verse eid="DEU 33:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="DEU 33:29"/>سّيوّ نَ وٌ بّ، عِسِرَيِلَكَيٍ.</para>
  <para style="q" vid="DEU 33:29">وٌ مَنِيّ يٌ مُ نَ سِيٍ تَفِ،</para>
  <para style="q" vid="DEU 33:29">عَلَتَلَ نَشَن كِسِشِ،</para>
  <para style="q" vid="DEU 33:29">عَ نَشَن كَنتَشِ،</para>
  <para style="q" vid="DEU 33:29">عَ نَشَن شُن نَكٍلِشِ.</para>
  <para style="q" vid="DEU 33:29">وٌ يَشُييٍ قَمَ نّ عٍ مَفٌرٌدٍ وٌ يَ رَ،</para>
  <para style="q" vid="DEU 33:29">وٌ قَن عٍ شَ بَتُدٍيٍ كَنَمَ نّ.»<verse eid="DEU 33:29"/></para>
  <chapter eid="DEU 33"/>
  <chapter number="34" style="c" sid="DEU 34"/>
  <para style="s">عَننَبِ مُنسَ شَ قَشّ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 34:1"/>عَننَبِ مُنسَ نَشَ تٍ نٍبٌ فٍيَ قَرِ، مٌوَبَ بْشِ مَ، هَن ثِسِفَ فٍيَ، نَشَن نَ يٍرِكٌ سٌفٍتٍدٍ. عَلَتَلَ نَشَ بْشِ بِرِن مَسٍن عَ بّ، كٍلِ فَلَدِ عَ سَ دْشْ دَنَ رَ، <verse eid="DEU 34:1"/><verse number="2" style="v" sid="DEU 34:2"/>نَقَتَلِ بْشِ، عٍقِرَ مِ نُن مَنَسِ شَ بْشِ، يُدَ شَ بْشِ هَن بَا مَ نَشَن نَ سٌفٍفٌرٌدٍ، <verse eid="DEU 34:2"/><verse number="3" style="v" sid="DEU 34:3"/>نٍفٍوِ بْشِ، عَ سَ رَحْن يُرُدّن لٌنفٌرِيٍ رَ، يٍرِكٌ لَنبَنيِ، تُفِ بِلِ تَا، هَن سٌوَرِ. <verse eid="DEU 34:3"/><verse number="4" style="v" sid="DEU 34:4"/>عَلَتَلَ نَشَ عَ مَسٍن عَ بّ، «عِ يَ تِ بْشِ رَ ﭑ نَشَن سَاتّ تٌنفٌشِ عِبُرَهِمَ، عِسِيَفَ، نُن يَشُبَ بّ. ﭑ نَشَ عَ قَلَ عٍ بّ، ‹ﭑ يِ بْشِ قِمَ وٌ بْنسْي نَن مَ.› ﭑ شَ نَ بْشِ مَسٍن عِ بّ، كْنْ عِ مُ سٌمَ نَا.»<verse eid="DEU 34:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="DEU 34:5"/>عَننَبِ مُنسَ، عَلَتَلَ شَ كٌنيِ، نَشَ لَاشِرَ مّننِ، مٌوَبَ بْشِ مَ، عَلْ عَلَتَلَ عَ مَسٍن كِ نَشّ. <verse eid="DEU 34:5"/><verse number="6" style="v" sid="DEU 34:6"/>عَلَتَلَ نَشَ عَ رَفَتَ مٌوَبَ بْشِ مَ فُلُنبَ كُي بٍتِ ثٍيٌرِ يَ تَفِ. مِشِ يٌ مُ نْشِ عَ شَ فَبُرِ يِرٍ كٌلٌندٍ هَن تٌ. <verse eid="DEU 34:6"/><verse number="7" style="v" sid="DEU 34:7"/>عَننَبِ مُنسَ لَاشِرَشِ عَ حّ كّمّ حّ مْشْحّن نَن مَ. نَ بِرِن عَ يَ نُ سٍ تٌمَ عَ قَنيِ رَ، عَ سّنبّ قَن نُ فبٌ. <verse eid="DEU 34:7"/><verse number="8" style="v" sid="DEU 34:8"/>عِسِرَيِلَكَيٍ نَشَ عَ وَ مٌوَبَ بْشِ مَ شِ تٌنفٌ سَشَن بُن مَ. عٍ عَننَبِ مُنسَ شَ حْن قٍ رَبَ نَ كِ نّ.<verse eid="DEU 34:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 34:9"/>عَننَبِ مُنسَ نُ بَرَ عَ بّلّشّ سَ عَننَبِ يٌسُوٍ مَ، نُنُ شَ دِ، عَ قَ رَقٍ شَشِلِمَيَ رَ. عِسِرَيِلَكَيٍ نَشَ يٌسُوٍ شُي رَبَتُ بِرَقٍ عَننَبِ مُنسَ شَ يَامَرِيٍ قْشْ رَ، عَلَتَلَ نَشٍيٍ قِشِ عَ مَ.<verse eid="DEU 34:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 34:10"/>عِسِرَيِلَ بْشِ مَ، نَمِحْنمّ يٌ مُ نُ نَ نَ نَشَن مَنِيَمَ عَننَبِ مُنسَ رَ. عَ وْيّن عَلَ رَ يَ نُن يَ. <verse eid="DEU 34:10"/><verse number="11" style="v" sid="DEU 34:11"/>عَلَ عَ شّي نّ مِسِرَ قٍ كَابَنَكٌي رَبَدٍ قِرَوُنَ، عَ شَ يَرٍرَتِيٍ، نُن عَ شَ مِشِ بِرِن شِلِ مَ. <verse eid="DEU 34:11"/><verse number="12" style="v" sid="DEU 34:12"/>عَننَبِ مُنسَ وَلِشِ سّنبّ مَفَاشُشِ نَن نَ عِسِرَيِلَكَيٍ بِرِن يَ شْرِ.<verse eid="DEU 34:12"/></para>
  <chapter eid="DEU 34"/>
</usx>
