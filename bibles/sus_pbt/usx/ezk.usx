<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="EZK" style="id"/>
  <para style="h">عَننَبِ عٍسٍكِيٍلِ</para>
  <para style="toc1">عَلَ شَ مَسٍنيِ عَننَبِ عٍسٍكِيٍلِ بّ</para>
  <para style="toc2">عَننَبِ عٍسٍكِيٍلِ</para>
  <para style="toc3">عٍسٍ</para>
  <para style="mt">عَلَ شَ مَسٍنيِ عَننَبِ عٍسٍكِيٍلِ بّ</para>
  <para style="imt">مَسٍنيِ ندٍ يِ كِتَابُي شَ قٍ رَ</para>
  <para style="ip">عَننَبِ عٍسٍكِيٍلِ قِندِشِ عَلَ شَ نَمِحْنمّ نَن نَ يُدَيَ بْشِ مَ. عَلَ نُ بَرَ نَتّ تٌنفٌ يُدَيَكَيٍ بِرِن شَ شَنِن كٌنيِيَ كُي بَبِلْن بْشِ مَ، عَلْ عَ نَشَن نَبَ عِسِرَيِلَكَيٍ رَ نَشٍيٍ نُ سَبَتِشِ كْولَ مَبِرِ. نَ بِرِن قَتَنشِ عٍ شَ يُنُبِيٍ نَن مَ.</para>
  <para style="ip">عَلَ مُ نَ رَبَشِ تّمُي كٍرٍن شَ رَ. عَ نَشَ عَ رَفِرِ بَبِلْنكَيٍ شَ حَمَ سَشَن شَنِن حّ قُ نُن سٌلٌقٍرٍ بُن مَ، بٍينُن عٍ شَ دَرِ سَلَمُ كَنَ كٍرٍنيِ رَ. عَننَبِ عٍسٍكِيٍلِ نُ نَ حَمَ قِرِن ندٍ يَ مَ، نَشَن سَبَتِ بَبِلْن.</para>
  <para style="ip">نَ حَمَ عَ مَحْشُن نّ عَ عٍ مُ بُمَ كٌنيِيَ كُي. عٍ شَ دِينّ مِشِيٍ نُ عَ قَلَمَ نّ عٍ بّ، عَ عٍ فبِلٍنمَ نّ عٍ شْنيِ هّيرِ كُي. كْنْ عَلَ نَشَ عَ مَسٍن عٍ بّ عَننَبِ عٍسٍكِيٍلِ سَابُي رَ، عَ عٍ مُ فبِلٍنمَ مَقُرٍن مَقُرٍن عٍ شَ يُنُبِيٍ شَ قٍ رَ. عٍ شَ كُيٍ بَتُي نَن عَ نِيَشِ عٍ شَ شَنِن بَبِلْن بْشِ مَ، عٍ شَ عَلَ شَ حَشَنكَتّ شُنفبٍ سْتْ كٌنيِيَ كُي.</para>
  <para style="ip">كْنْ عَلَ شَ نَمِحْنمّ شَ مَسٍنيِ مُ دَنمَ مّننِ شّ. عَننَبِ عٍسٍكِيٍلِ نَشَ عَ مَسٍن عٍ بّ عَ عَلَ قَمَ نّ كَابَنَكٌي رَبَدٍ عٍ رَفبِلٍنقٍ رَ دَرِ سَلَمُ. عَ نَشّ عَلَتَلَ شَشِلِ سّنِيّنشِ قَمَ نّ فٌرٌدٍ عٍ مَ، عَ عَ نِيَ عٍ شَ تُوبِ، عٍ مَن شَ عَلَ شَ مَرَقَنيِ كٌلٌن عٍ بْحّ كُي. عَ نفَشَكٍرٍنيِيٍ فبٍفبٍ مُ نُ لَشِ نَ مَسٍنيِ رَ، كْنْ ندٍيٍ نَشَ عٍ شَشِلِ تِ نَ شِبَارُ قَنيِ رَ، عٍ عٍ تُننَبّشِ نَ كُي.</para>
  <para style="ip">عَننَبِ عٍسٍكِيٍلِ نَشَ عَ مَسٍن عٍ بّ، عَلَ قَمَ عَ شَ هْرْ مْبَنشِ تِدٍ عَ قِرِن ندٍ رَ كِ نَشّ. نَ تِدٍ نُ فبٌ عِسِرَيِلَكَيٍ بّ. بَبِلْنكَيٍ تٌ عٍ شَ سَلِدٍ شُنفبٍ كَنَ، عٍ نَشَ عَ مَحْشُن عَلَ نُ بَرَ عَ رَبٌلٌ. يِ كِتَابُي نُ عَ مَسٍنمَ نّ عٍ بّ عَ عَلَ نُ بَرَ عٍ رَبٌلٌ عٍ شَ يُنُبِيٍ شَ قٍ رَ، كْنْ عَ مُ تٌندِ مَ عٍ رَ مِنِدٍ نَ حَشَنكَتّ كُي، عَ عٍ رَكِسِ. عَلَ تَنتُ، مِشِ نَشَن عَلَ شَ هّيرِ قٍنمَ، عَ عَ تٌمَ نّ. عَلَ سَفٌ نَن نَ كِ.</para>
  <para style="ip">عَلَ شَ وٌن مَلِ بِرَدٍ عَ شَ كِرَ قْشْ رَ، كِرَ نَشَن وٌن شَنِنمَ عَرِيَننَ. عَمِنَ.</para>
  <para style="imte">عَلَ شَ مَسٍنيِ عَننَبِ عٍسٍكِيٍلِ بّ</para>
  <chapter number="1" style="c" sid="EZK 1"/>
  <para style="s">عَلَ عَ يّتّ مَسٍنقٍ عَننَبِ عٍسٍكِيٍلِ بّ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 1:1"/>حّ تٌنفٌ سَشَن ندٍ، عَ كِكٍ نَانِ ندٍ، شِ سُولِ ندٍ رَ، ﭑ نُ نَ عِسِرَيِلَكَ سُشُشِيٍ يَ مَ كٍبَرَ شُرٍ قّ مَ. كٌورٍ نَشَ رَبِ، ﭑ نَشَ عَلَ شَ لَامَتُنيِ تٌ. <verse eid="EZK 1:1"/><verse number="2" style="v" sid="EZK 1:2"/>نَ حّ نُ قِندِشِ يُدَيَ مَنفّ يٍهٌيَكِنِ شَ حّ سُولِ ندٍ نَن نَ كٌنيِيَ كُي. نَ شِ سُولِ ندٍ <verse eid="EZK 1:2"/><verse number="3" style="v" sid="EZK 1:3"/>عَلَتَلَ نَشَ مَسٍنيِ تِ ﭑ تَن سّرّشّدُبّ عٍسٍكِيٍلِ بّ، بُسِ شَ دِ. ﭑ نُ نَ كَلِدِ بْشِ نَن مَ كٍبَرَ شُرٍ قّ مَ. عَلَتَلَ شْنيّ نُ نَ ﭑ مَ.<verse eid="EZK 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 1:4"/>ﭑ نَشَ تُرُننَادّ تٌ كٍلِقٍ كْولَ مَبِرِ، نُشُي شُنفبٍ يَنبَمَ نَشَن نَبِلِنشِ نَءِيَلَنيِ مَفَاشُشِ رَ. عَ شْرِ نُ لُشِ نّ عَلْ وُرٍ رَشُنُشِ. <verse eid="EZK 1:4"/><verse number="5" style="v" sid="EZK 1:5"/>دَالِسٍ نَانِ نُ نَ نَ تّ شْورَ. عٍ نُ مَنِيَشِ شّمّيٍ نَن نَ، <verse eid="EZK 1:5"/><verse number="6" style="v" sid="EZK 1:6"/>كْنْ يَتَفِ نَانِ نُن فَبُتٍنيِ نَانِ نَن نُ نَ كَنكَن مَ. <verse eid="EZK 1:6"/><verse number="7" style="v" sid="EZK 1:7"/>عٍ سَنوُرِيٍ نُ تِنشِن، عٍ سَنبْنبْلَيٍ نُ مَنِيَشِ نِنفٍ تٌرٍيٍ نَن نَ نَشٍيٍ يَنبَشِ عَلْ وُرٍ فبٍيلِ. <verse eid="EZK 1:7"/><verse number="8" style="v" sid="EZK 1:8"/>مِشِ بّلّشّيٍ نُ نَ عٍ بّ عٍ فَبُتٍنيِيٍ بُن مَ عٍ سّيتِ نَانِيٍ مَ. يَتَفِيٍ نُن فَبُتٍنيِيٍ نُ نَ عٍ نَانِ بِرِن مَ، <verse eid="EZK 1:8"/><verse number="9" style="v" sid="EZK 1:9"/>عٍ فَبُتٍنيِيٍ نُ دْشْشِ عٍ بٌرٍ رَ. نَ كِ عٍ مُ نُ عٍ يَ رَفبِلٍنمَ سِفَقٍ رَ، عٍ نُ سِفَ يَرٍ تُن.<verse eid="EZK 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 1:10"/>عٍ يَتَفِيٍ نُ نَ يِ كِ نّ؛ يَتَفِ عَدَ مَ دَاشِ، يَتَفِ يّتّ دَاشِ، يَتَفِ نِنفٍ دَاشِ، نُن يَتَفِ سّفّ دَاشِ نَن نُ نَ كَنكَن بّ. <verse eid="EZK 1:10"/><verse number="11" style="v" sid="EZK 1:11"/>عٍ يَتَفِيٍ نُ نَ نَ كِ نّ. فَبُتٍنيِ نَانِ نُ نَ كَنكَن مَ. قِرِن نَ سّيتِ كٍرٍن مَ، نَشٍيٍ نُ عِتَلَشِ عٍ بٌرٍ قّ مَ. فَبُتٍنيِ قِرِن نَن قَن نُ عٍ قَتٍيٍ مَكٌتٌشِ.<verse eid="EZK 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 1:12"/>كَنكَن نُ بِرَشِ عَلَ شَشِلِ نَن قْشْ رَ. نَ كُي، عٍ مُ نُ عٍ يَ رَفبِلٍنمَ، عٍ نُ قَ سِفَ يَرٍ تُن. <verse eid="EZK 1:12"/><verse number="13" style="v" sid="EZK 1:13"/>نَ دَالِسٍيٍ لَهَلّ نُ لُشِ نّ عَلْ تّ وٌلٍيٍ نُن تّ قُلٍقُلٍيٍ. نَ تّ يَنبَشِ نُ عَ لِنتَنمَ نَ دَالِسٍيٍ لٌنفٌرِ رَ عَلْ سٍيَمَكْنيِيٍ. <verse eid="EZK 1:13"/><verse number="14" style="v" sid="EZK 1:14"/>نَ دَالِسٍيٍ نُ سِفَ عٍ فِ رَ، عٍ شُلُن عَلْ سٍيَمَكْنيِ.<verse eid="EZK 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 1:15"/>ﭑ تٌ نُ يِ دَالِسٍيٍ مَتٌقٍ، ﭑ نَشَ سَنيِ رَدِفِلِنشِ كٍرٍن تٌ بْشِ مَ كَنكَن سّيتِ مَ. <verse eid="EZK 1:15"/><verse number="16" style="v" sid="EZK 1:16"/>نٍيٍ نُ يَنبَمَ عَلْ دِيَمَن، عٍ بِرِن نُ مَنِيَ. عٍ رَقَلَ كِ نُ لُشِ نّ عَلْ سَنيِ رَدِفِلِنشِ نُ نَ سَنيِ رَدِفِلِنشِ فبّتّ كُي. <verse eid="EZK 1:16"/><verse number="17" style="v" sid="EZK 1:17"/>عٍ نّ سِفَمَ، عٍ نُ عٍ حّرّ مَ عٍ سّيتِ نَانِ نَن مَ، عٍ مُ نُ عٍ مَقِندِ مَ عٍ شَ حّرّ كُي. <verse eid="EZK 1:17"/><verse number="18" style="v" sid="EZK 1:18"/>عٍ نُ عِتٍ، عٍ تٌقَن، عٍ لُشِ عَلْ يَيٍ نُ نَ عٍ بّ.<verse eid="EZK 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 1:19"/>دَالِسٍيٍ نَ عٍ حّرّ، عٍ سَنيِيٍ قَن عٍ حّرّ. عٍ نَ تٍ كٌورٍ مَ، عٍ سَنيِيٍ قَن تٍ. <verse eid="EZK 1:19"/><verse number="20" style="v" sid="EZK 1:20"/>عَلَ شَشِلِ نُ سِفَ دّدّ، عٍ قَن نُ بِرَ مَ نّ عَ قْشْ رَ، عَ نُن عٍ سَنيِيٍ، بَرِ مَ نَ دَالِسٍيٍ شَشِلِ نُ نَ عٍ سَنيِيٍ نَن كُي. <verse eid="EZK 1:20"/><verse number="21" style="v" sid="EZK 1:21"/>نَ دَالِسٍيٍ نَ سِفَ، عٍ سَنيِيٍ قَن سِفَ. دَالِسٍيٍ نَ تِ، عٍ سَنيِيٍ قَن تِ. دَالِسٍيٍ نَ تٍ كٌورٍ مَ، عٍ سَنيِ قَن تٍ، بَرِ مَ نَ دَالِسٍيٍ شَشِلِ نُ نَ عٍ سَنيِيٍ نَن كُي.<verse eid="EZK 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 1:22"/>كٌورٍ وَلَشّ تٌقَنيِ عَلْ دِيَمَن نُ عِتَلَشِ عٍ شُن مَ. <verse eid="EZK 1:22"/><verse number="23" style="v" sid="EZK 1:23"/>نَ دَالِسٍيٍ فَبُتٍنيِ قِرِن نُ عِتَلَشِ عٍ بٌرٍ سّيتِ مَ، فَبُتٍنيِ قِرِن نُ عٍ قَتٍ مَكٌتٌشِ. <verse eid="EZK 1:23"/><verse number="24" style="v" sid="EZK 1:24"/>عٍ عٍ حّرّ تّمُي نَشّ، شُي ندٍ نُ مِنِمَ عَلْ بَا مْرْنيِ شُي، عَلْ عَلَ سّنبّمَ شُي، عَلْ سْورِ فَالِ شُي. دَالِسٍيٍ نَ تِ، عٍ نُ قَ عٍ فَبُتٍنيِيٍ عِسٌ.<verse eid="EZK 1:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 1:25"/>نَ تّمُي شُي ندٍ نَشَ مِنِ كٌورٍ وَلَشّ قَرِ نَشَن نُ نَ دَالِسٍيٍ شُن مَ، عٍ فَبُتٍنيِيٍ عِسٌشِ. <verse eid="EZK 1:25"/><verse number="26" style="v" sid="EZK 1:26"/>سٍ ندٍ نُ نَ نَ كٌورٍ وَلَشّ قَرِ نَشَن نُ لُشِ عَلْ كِبَنيِ نَشَن يَءِلَنشِ دِيَمَن نَ. سٍ ندٍ نُ نَ كِبَنيِ كُي نَشَن نُ مَنِيَشِ عَدَ مَدِ ندٍ رَ. <verse eid="EZK 1:26"/><verse number="27" style="v" sid="EZK 1:27"/>عَ كَنكٍ نُ يَنبَمَ عَلْ وُرٍ رَشُنُشِ، عَ سَنيِيٍ قَن نُ يَنبَ عَلْ تّ. نَءِيَلَنيِ مَفَاشُشِ نُ نَ عَ رَبِلِنيِ بِرِن مَ. <verse eid="EZK 1:27"/><verse number="28" style="v" sid="EZK 1:28"/>عَ يَنبّ نُ لُشِ نّ عَلْ سٍنكُي نَشَن مِنِمَ كٌورٍ مَ تُنّ قُرُ تّمُي. ﭑ تٌ نَ تٌ، ﭑ نَشَ بِرَ ﭑ نَ ﭑ يَتَفِ رَقٍلٍن بْشِ مَ، ﭑ نَشَ شُي ندٍ مّ.<verse eid="EZK 1:28"/></para>
  <chapter eid="EZK 1"/>
  <chapter number="2" style="c" sid="EZK 2"/>
  <para style="s">عَلَتَلَ عَننَبِ عٍسٍكِيٍلِ شّيقٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 2:1"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، «عَدَ مَدِ، كٍلِ، ﭑ شَ مَسٍنيِ تِ عِ بّ.» <verse eid="EZK 2:1"/><verse number="2" style="v" sid="EZK 2:2"/>عَ قّقّ نَ وْيّنيِ قَلَ ﭑ بّ، شَشِلِ سّنِيّنشِ نَشَ فٌرٌ ﭑ مَ، عَ ﭑ تِ ﭑ سَنيِيٍ شُن مَ. ﭑ نَشَ عَ شُي مّ عَ قَلَقٍ رَ ﭑ بّ، <verse eid="EZK 2:2"/><verse number="3" style="v" sid="EZK 2:3"/>«عِ تَن عَدَ مَدِ، ﭑ تَن نَن عِ شّيقٍ عِسِرَيِلَكَيٍ مَ، نَشٍيٍ بَرَ مُرُتَ ﭑ مَ، كٍلِقٍ عٍ بٍنبَيٍ شَ تّمُي مَ هَن يِ وَشَتِ. <verse eid="EZK 2:3"/><verse number="4" style="v" sid="EZK 2:4"/>ﭑ عِ شّيمَ نَشٍيٍ شْن، عٍ تُلِ شْرْشْ. عِ شَ عَ قَلَ عٍ بّ، ‹عَلَتَلَ يِ مَسٍنيِ نَن تِشِ.› <verse eid="EZK 2:4"/><verse number="5" style="v" sid="EZK 2:5"/>بْنسْي مُرُتَشِ نَن عٍ رَ، كْنْ عٍ قَمَ نّ عَ كٌلٌندٍ نَمِحْنمّ ندٍ بَرَ لُ عٍ يَ مَ، هَلِ عٍ تٌندِ عِ شُي سُشُدٍ. <verse eid="EZK 2:5"/><verse number="6" style="v" sid="EZK 2:6"/>عِ تَن عَدَ مَدِ، عِ نَشَ فَاشُ عٍ يَ رَ، عِ نَشَ كْنتْقِلِ عٍ شَ وْيّنيِ شَ قٍ رَ، هَلِ نَ بِرِن قَ قِندِ تْورّ رَ عِ بّ، عٍ قَ لُ عَلْ تَلِيٍ. عِ نَشَ فَاشُ نَ بْنسْي مُرُتَشِ يَ رَ. <verse eid="EZK 2:6"/><verse number="7" style="v" sid="EZK 2:7"/>قٌ عِ شَ ﭑ مَ مَسٍنيِ تِ عٍ بّ، هَلِ عٍ تٌندِ عٍ تُلِ مَتِدٍ عِ رَ عٍ شَ مَتَندِ كُي. <verse eid="EZK 2:7"/><verse number="8" style="v" sid="EZK 2:8"/>كْنْ عِ تَن عَدَ مَدِ، عِ شَ عِ تُلِ مَتِ ﭑ شُي رَ، عِ نَشَ مُرُتَ عَلْ يِ بْنسْي عَ رَبَمَ كِ نَشّ. عِ شَ عِ دّ رَبِ، عِ شَ دٌنسٍ دٌن ﭑ نَشَن سٌمَ عِ يِ رَ.»<verse eid="EZK 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 2:9"/>نَ تّمُي ﭑ نَشَ بّلّشّ عِتَلَشِ ندٍ تٌ ﭑ يَ عِ، كّيدِ مَقِلِنشِ نُ نَ عَ كُي. <verse eid="EZK 2:9"/><verse number="10" style="v" sid="EZK 2:10"/>عَ نَشَ عَ عِتَلَ ﭑ يَ عِ، سّبّلِ نُ تِشِ عَ كُي نُن عَ قَرِ نَشَن تْورّ شْرْشْي شَ قٍ مَسٍنمَ.<verse eid="EZK 2:10"/></para>
  <chapter eid="EZK 2"/>
  <chapter number="3" style="c" sid="EZK 3"/>
  <para style="s">عَننَبِ عٍسٍكِيٍلِ شَ شّيرَيَ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 3:1"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، «عَدَ مَدِ، عِ شَ يِ كّيدِ دٌن، عِ سَ مَسٍنيِ تِقٍ عِسِرَيِلَ بْنسْي بّ.» <verse eid="EZK 3:1"/><verse number="2" style="v" sid="EZK 3:2"/>عَوَ، ﭑ نَشَ ﭑ دّ رَبِ، عَ نَشَ نَ كّيدِ رَ سٌ ﭑ دّ كُي. <verse eid="EZK 3:2"/><verse number="3" style="v" sid="EZK 3:3"/>عَ مَن نَشَ عَ مَسٍن ﭑ بّ، «عَدَ مَدِ، عِ شَ يِ كّيدِ بِرِن دٌن ﭑ نَشَن سٌشِ عِ يِ رَ.» ﭑ تٌ عَ دٌن، عَ نُ حْشُن ﭑ دّ عِ عَلْ كُمِ.<verse eid="EZK 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 3:4"/>نَ تّمُي عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، «عَدَ مَدِ، سِفَ عِسِرَيِلَ بْنسْي يِرٍ، عِ سَ ﭑ مَ مَسٍنيِ تِ عٍ بّ. <verse eid="EZK 3:4"/><verse number="5" style="v" sid="EZK 3:5"/>ﭑ مُ نَ عِ شّيقٍ حَمَ شَ مَ، عِ مُ نَشَن شَ شُي شْرْشْي مّمَ. ﭑ بَرَ عِ شّي عِسِرَيِلَ بْنسْي نَن مَ. <verse eid="EZK 3:5"/><verse number="6" style="v" sid="EZK 3:6"/>ﭑ مُ نَ عِ شّيقٍ بْنسْي وُيَشِ شَ مَ، عِ مُ نَشٍيٍ شَ شُي قَلَمَ، عِ مُ نَشٍيٍ شَ شُي مّمَ. شَ عَ سَ لِ ﭑ عِ شّي نّ نٍيٍ قَن مَ نُ، عٍ عِ شُي سُشُمَ نّ كٍرٍن نَ. <verse eid="EZK 3:6"/><verse number="7" style="v" sid="EZK 3:7"/>كْنْ عِسِرَيِلَ تَن مُ وَ مَ عَ تُلِ مَتِقٍ عِ رَ، بَرِ مَ عٍ مُ تِنمَ ﭑ مَ مَسٍنيِ رَ. عٍ شَشِلِ شْرْشْ، مَتَندِ بَرَ عٍ بْحّ سُشُ. <verse eid="EZK 3:7"/><verse number="8" style="v" sid="EZK 3:8"/>كْنْ ﭑ عِ يَ شْرْشْمَ نّ دَنفِقٍ عٍ تَن نَ، ﭑ عِ شَ لِمَنِيَ شُن مَسَمَ نّ. <verse eid="EZK 3:8"/><verse number="9" style="v" sid="EZK 3:9"/>ﭑ عَ نِيَمَ نّ عِ شَ عِ تُننَبّشِ عَلْ قَنيٍ، عِ شَ سّنبّ سْتْ نَشَن شْرْشْ عَلْ فّمّ. عِ نَشَ فَاشُ عٍ يَ رَ، عِ نَشَ عِقُ عٍ يَ عِ دٍ، هَلِ عٍ تٌ قِندِشِ بْنسْي مُرُتَشِ رَ.»<verse eid="EZK 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 3:10"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، «عَدَ مَدِ، عِ تُلِ مَتِ ﭑ مَ مَسٍنيِ رَ ﭑ نَشَن مَسٍنقٍ عِ بّ. عِ شَ عٍ رَفَتَ عِ بْحّ مَ. <verse eid="EZK 3:10"/><verse number="11" style="v" sid="EZK 3:11"/>يَكْسِ عِ شَ سِفَ عِ شَ حَمَ يِرٍ، نَشَن نَ كٌنيِيَ كُي، عِ سَ وْيّن عٍ رَ. عِ شَ عَ قَلَ عٍ بّ، ‹عَلَ شَ مَسٍنيِ نَن يَ.› شَ عٍ سَ عٍ تُلِ مَتِ بَ، شَ عٍ مُ عٍ تُلِ مَتِ بَ، عِ تَن شَ ﭑ مَ مَسٍنيِ تِ.»<verse eid="EZK 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 3:12"/>نَ تّمُي عَلَتَلَ شَشِلِ نَشَ ﭑ تٌنفٌ، ﭑ نَشَ شُي ندٍ مّ ﭑ شَنبِ رَ عَ قَلَقٍ رَ، «مَتْشْي نَ عَلَتَلَ نْرّ كَنيِ بّ عَ سَبَتِشِ دّننَشّ!» <verse eid="EZK 3:12"/><verse number="13" style="v" sid="EZK 3:13"/>ﭑ نَشَ نَ دَالِسٍيٍ فَبُتٍنيِيٍ شُي مّ عٍ فَرِنقٍ عٍ بٌرٍ رَ، عَ نُن عٍ سَنيِ دِفِلِنشِيٍ شُي. نَ سّنبّ فبٌ. <verse eid="EZK 3:13"/><verse number="14" style="v" sid="EZK 3:14"/>عَلَ شَشِلِ نَشَ ﭑ نَتٍ كٌورٍ مَ، عَ ﭑ شَنِن. شْنّ نُ بَرَ ﭑ بْحّ رَتٍ، كْنْ عَلَ شْنيّ نَشَ نْ ﭑ نَ. <verse eid="EZK 3:14"/><verse number="15" style="v" sid="EZK 3:15"/>نَ كُي ﭑ نَشَ ﭑ مَ حَمَ لِ نَشَن نُ نَ كٌنيِيَ كُي تٍلِ عَبِبِ تَا كُي كٍبَرَ شُرٍ قّ مَ. ﭑ نَشَ شِ سٌلٌقٍرٍ رَبَ عٍ تَفِ، ﭑ نَكٌرِشِ كْقُ.<verse eid="EZK 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 3:16"/>شِ سٌلٌقٍرٍ تٌ دَنفِ، عَلَتَلَ نَشَ يِ مَسٍنيِ تِ ﭑ بّ، عَ نَشّ، <verse eid="EZK 3:16"/><verse number="17" style="v" sid="EZK 3:17"/>«عَدَ مَدِ، ﭑ بَرَ عِ قِندِ عِسِرَيِلَ بْنسْي كَنتَمَ رَ. عِ نَ ﭑ مَ مَسٍنيِ مّ، عِ شَ نَ قَلَ عٍ بّ. <verse eid="EZK 3:17"/><verse number="18" style="v" sid="EZK 3:18"/>ﭑ نَ عَ مَسٍن مِشِ حَاشِ بّ، ‹عِ قَشَمَ نّ،› شَ عِ مُ عَ رَ سِ عَ شَ فبِلٍن قٍ حَاشِ قْشْ رَ عَلَكٌ عَ شَ كِسِ، ﭑ عَ قَشَمَ نّ عَ شَ يُنُبِ شَ قٍ رَ. نَ كُي ﭑ عَ نِي سَرٍ مَشْرِنمَ عِ تَن نَن مَ. <verse eid="EZK 3:18"/><verse number="19" style="v" sid="EZK 3:19"/>كْنْ شَ عِ بَرَ عَ رَ سِ، عَ قَ لُ عَ مُ عَ يّتّ رَفبِلٍن ﭑ مَ، عَ قَشَمَ نّ عَ شَ يُنُبِ كُي، كْنْ عَ لِمَ نّ عِ تَن نِي بَرَ رَكِسِ.»<verse eid="EZK 3:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 3:20"/>«شَ تِنشِنتْي ندٍ سَ فبِلٍن تِنشِنيِ قْشْ رَ، عَ كِرَ فبّتّ سُشُ، ﭑ عَ تْورْ مَ نّ نَ كِرَ شْن، عَلَكٌ عَ نَشَ قَ قَشَ. شَ عِ مُ عَ رَ سِ، عَ قَشَمَ نّ عَ شَ يُنُبِ كُي. عَ شَ وَلِ قَنيِيٍ بِرِن لُمَ نّ قُ. نَ كُي ﭑ عَ نِي سَرٍ مَشْرِنمَ عِ تَن نَن مَ. <verse eid="EZK 3:20"/><verse number="21" style="v" sid="EZK 3:21"/>كْنْ شَ عِ بَرَ عَ رَ سِ عَلَكٌ عَ نَشَ يُنُبِ رَبَ، عَ قَ عَ تُلِ مَتِ عِ رَ، عَ كِسِمَ عِ تَن نَن سَابُي رَ. نَ كُي عِ بَرَ عِ يّتّ قَن نَكِسِ.»<verse eid="EZK 3:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 3:22"/>عَلَتَلَ شْنيّ نُ نَ ﭑ مَ مّننِ، عَ قَ عَ مَسٍن ﭑ بّ، «كٍلِ، مِنِ قِيلِ مَ. ﭑ سَ وْيّنمَ عِ بّ مّننِ نّ.» <verse eid="EZK 3:22"/><verse number="23" style="v" sid="EZK 3:23"/>ﭑ نَشَ كٍلِ، ﭑ سِفَ قِيلِ مَ. مّننِ ﭑ نَشَ عَلَتَلَ شَ نْرّ تٌ، عَلْ ﭑ عَ تٌشِ كٍبَرَ شُرٍ دّ رَ كِ نَشّ. ﭑ نَشَ ﭑ يَتَفِ رَقٍلٍن بْشِ مَ. <verse eid="EZK 3:23"/><verse number="24" style="v" sid="EZK 3:24"/>عَلَتَلَ شَشِلِ نَشَ سٌ ﭑ بْحّ كُي، عَ نَشَ ﭑ نَكٍلِ. عَ نَشَ عَ مَسٍن ﭑ بّ، «سِفَ عِ شْنيِ، عِ سٌ بَنشِ، عِ نَادّ بَلَن عِ يّتّ شُن نَ. <verse eid="EZK 3:24"/><verse number="25" style="v" sid="EZK 3:25"/>عِ تَن عَدَ مَدِ، عٍ عِ شِرِ مَ نّ لُوتِ رَ عَلَكٌ عِ نَشَ سٌ حَمَ يَ مَ. <verse eid="EZK 3:25"/><verse number="26" style="v" sid="EZK 3:26"/>ﭑ عِ نّنيِ شِرِ مَ نّ، عَلَكٌ عِ نَشَ نْ سٍسٍ قَلَدٍ نَ بْنسْي مُرُتَشِ بّ. <verse eid="EZK 3:26"/><verse number="27" style="v" sid="EZK 3:27"/>كْنْ ﭑ نّ وْيّنمَ عِ بّ، ﭑ عِ نّنيِ قُلُنمَ نّ، عَلَكٌ عِ شَ عَ قَلَ عٍ بّ، ‹وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ وٌ بّ.› شَ عَ نَشَن كّنّن، عَ شَ نَ رَ مّ. شَ عَ مُ نَشَن كّنّن، عَ شَ نَ لُ نَ. بْنسْي مُرُتَشِ نَن عٍ رَ.»<verse eid="EZK 3:27"/></para>
  <chapter eid="EZK 3"/>
  <chapter number="4" style="c" sid="EZK 4"/>
  <para style="s">دَرِ سَلَمُ سُشُشِ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 4:1"/>«عِ تَن عَدَ مَدِ، عِ شَ وَلَشّ بّندّ دَاشِ تٌنفٌ، عِ قَ ثِرِنتِ كٌرِن عَ مَ نَشَن مِسَالِشِ دَرِ سَلَمُ تَا رَ. <verse eid="EZK 4:1"/><verse number="2" style="v" sid="EZK 4:2"/>عِ شَ سٍ ندٍيٍ يَءِلَن نَ وَلَشّ رَبِلِنيِ مَ نَشَن مِسَالِشِ فٍرٍ رَ دَرِ سَلَمُ شِلِ مَ. بّندّ ندٍ مَلَن مِسَالِ رَ يَشُييٍ قَمَ تٍدٍ تّتّ رَ نَشَن قَرِ. وُرِ دِيٍ تٌنفٌ نَشٍيٍ مِسَالِشِ وُرِيٍ رَ يَشُييٍ نَشٍيٍ رَوَلِمَ نَادّ كَنَقٍ رَ. يٌنكِندٍيٍ يَءِلَن مِسَالِ رَ يَشُييٍ لُمَ دّننَشّ. <verse eid="EZK 4:2"/><verse number="3" style="v" sid="EZK 4:3"/>وُرٍ ندٍ تِ عِ تَن نُن نَ وَلَشّ تَفِ. نَ شَ قِندِ مِسَالِ رَ دَرِ سَلَمُ سُشُمَ كِ نَشّ. عَ شَ قِندِ تْنشُمَ رَ عِسِرَيِلَ بْنسْي بّ.»<verse eid="EZK 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 4:4"/>«عِ شَ عِ سَ عِ كْولَ سّيتِ مَ نَ وَلَشّ يَ عِ. نَ مِسَالِمَ عِسِرَيِلَ شَ يُنُبِيٍ نَن نَ، نَشٍيٍ لُمَ عِ مَ عِ شَ شِ شَسَبِ. <verse eid="EZK 4:4"/><verse number="5" style="v" sid="EZK 4:5"/>عِ شَ شِ شَسَبِ لَنمَ عٍ شَ يُنُبِ رَبَ حّ شَسَبِ نَن مَ. نَ قِندِشِ شِ كّمّ سَشَن شِ تٌنفٌ سٌلٌمَنَانِ نَن نَ. عِسِرَيِلَكَيٍ شَ يُنُبِ كٌتٍ دْشْمَ عِ شُن مَ نَ كِ نّ.»<verse eid="EZK 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 4:6"/>«عِ نَ فّ نَ رَبَدٍ، عِ مَن شَ عِ سَ عِ يِرٍقَنيِ سّيتِ مَ. نَ كُي عِ شَ يُدَ بْنسْي شَ يُنُبِ كٌتٍ تٌنفٌ شِ تٌنفٌ نَانِ بُن مَ، نَشَن عَ مَسٍنمَ عٍ لُ يُنُبِ رَبَ رَ نَ حّ نَن نَ. <verse eid="EZK 4:6"/><verse number="7" style="v" sid="EZK 4:7"/>عِ شَ عِ يَ تِ نَ وَلَشّ رَ، عِ عِ بّلّشّ عِتَلَ، عِ وْيّن دَرِ سَلَمُ بّ ﭑ شِلِ رَ. <verse eid="EZK 4:7"/><verse number="8" style="v" sid="EZK 4:8"/>ﭑ عِ شِرِ مَ نّ لُوتِيٍ رَ عَلَكٌ عِ نَشَ قَ عِ مَقِندِ عِ سّيتِ ندٍ مَ، هَن عِ فّ نَ وَشَتِ رَكَمَلِدٍ.»<verse eid="EZK 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 4:9"/>«مّنفِ شْرِيٍ، تٌفٍ، تٍنفٍ، نُن نَ مَنِيّ تٌنفٌ، عِ عٍ سَ سٍ سَسٍ كُي تَامِ يَءِلَنقٍ رَ عِ بّ نَ وَشَتِ. عِ قَمَ نّ نَ دٌندٍ عِ سَشِ عِ سّيتِ مَ نَ شِ كّمّ سَشَن شِ تٌنفٌ سٌلٌمَنَانِ بُن مَ. <verse eid="EZK 4:9"/><verse number="10" style="v" sid="EZK 4:10"/>عِ شَ نَ دٌنسٍ مَنِيَ فِرَ مُ كّمّ قِرِن، كّمّ قِرِن مَ، عِ نَشَن دٌنمَ لْشْ يٌ لْشْ عَ وَشَتِ مَ. <verse eid="EZK 4:10"/><verse number="11" style="v" sid="EZK 4:11"/>عِ شَ يٍ قَن لِتِرِ تَفِ مَنِيَ، عِ نَشَن مِنمَ لْشْ يٌ لْشْ عَ وَشَتِ. <verse eid="EZK 4:11"/><verse number="12" style="v" sid="EZK 4:12"/>عِ شَ تَامِ يَءِلَن نَ مّنفِ رَ حَمَ يَ شْرِ. عِ نَ فَن مِشِ فبِ رَ.»<verse eid="EZK 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 4:13"/>نَ تّمُي عَلَتَلَ نَشَ عَ مَسٍن، «نَ كُي عِسِرَيِلَكَيٍ قَمَ نّ تَامِ سّنِيّنتَرٍ دٌندٍ حَمَنّ فبّتّيٍ تَفِ، ﭑ عٍ رَيٍنسٍنمَ دّننَشّ.» <verse eid="EZK 4:13"/><verse number="14" style="v" sid="EZK 4:14"/>ﭑ نَشَ عَ يَابِ، «ﭑ مَرِفِ عَلَتَلَ عَستْقُلَهِ! ﭑ تَن لُمَ سّنِيّنيِ نَن كُي. كَبِ ﭑ دِ مّدِ تّمُي ﭑ مُ سٍسٍ رَهَرَ مُشِ دٌن، عَلْ سُبٍ نَشَن قَشَشِ عَ يّتّ مَ، شَ نَ مُ عَ رَ سُبٍ نَشَن عِبْوشِ سُبٍ شَاحّ ندٍ سَابُي رَ.» <verse eid="EZK 4:14"/><verse number="15" style="v" sid="EZK 4:15"/>نَ نَن عَ رَ، عَ نَشَ عَ قَلَ ﭑ بّ، «عَوَ يِرٍ، عِ عِ شَ تَامِ فَنمَ نِنفٍ حَحّ نَن قَرِ، ﭑ بَرَ مِشِ فبِ قٍ لُ نَ.»<verse eid="EZK 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 4:16"/>نَ تّمُي عَ نَشَ عَ قَلَ ﭑ بّ، «عَدَ مَدِ، ﭑ مُ تِنمَ بَلٌي شَ دَرِ سَلَمُ لِ. تَاكَيٍ قَمَ دٌنسٍ نُن يٍ سْتْدٍ عَ شُرِ شُرِ نَن نَ، عٍ قَ لُ تْورّ نُن كْنتْقِلِ كُي. <verse eid="EZK 4:16"/><verse number="17" style="v" sid="EZK 4:17"/>بَلٌي نُن يٍ شُرُنمَ نّ عٍ يِ، عٍ قَتٍ حْن عٍ فَاشُ عٍ بٌرٍ تٌقٍ رَ. نَ بِرِن عٍ لِمَ عٍ شَ يُنُبِ نَن شَ قٍ رَ.»<verse eid="EZK 4:17"/></para>
  <chapter eid="EZK 4"/>
  <chapter number="5" style="c" sid="EZK 5"/>
  <para style="s">عِسِرَيِلَ شَ حَشَنكَتّ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 5:1"/>«عِ تَن عَدَ مَدِ، عِ شَ عِ شُنيِ نُن عِ دّشَبٍ بِ. عِ نَ فّ نَ رَبَدٍ، عِ شَ نَ شُنسّشّ نُن نَ دّشَبٍ عِتَشُن دْشْ سَشَن نَ. <verse eid="EZK 5:1"/><verse number="2" style="v" sid="EZK 5:2"/>دَرِ سَلَمُ شَ سُشُي شِ كْنتِ نَ فّ كَمَلِدٍ، عِ شُنسّشّ نُن دّشَبٍ دْشْ كٍرٍن فَن تَا ثِرِنتِ مَ. عِ شَ دْشْ كٍرٍن مَشَبَ سَنتِدّفّمَ رَ ثِرِنتِ رَبِلِنيِ مَ. عِ شَ دْشْ كٍرٍن وٌلِ كٌورٍ مَ، قٌيٍ شَ عَ رَيٍنسٍن. نَ بِرِن عَ مَسٍنمَ نّ ﭑ قَمَ عِ كٍرِدٍ سَنتِدّفّمَ رَ كِ نَشّ. <verse eid="EZK 5:2"/><verse number="3" style="v" sid="EZK 5:3"/>كْنْ عِ شَ شُنسّشّ دٌندٌرٌنتِ تٌنفٌ، عِ نٍيٍ نْشُن عِ شَ دُفِ كُي. <verse eid="EZK 5:3"/><verse number="4" style="v" sid="EZK 5:4"/>عِ مَن شَ شُنسّشّ ندٍ وٌلِ تّ شْورَ، نَشَن عَ مَسٍنمَ يِ حَشَنكَتّ قَمَ نّ دِندٍ عِسِرَيِلَ بْنسْي بِرِن نَ.»<verse eid="EZK 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 5:5"/>«ﭑ تَن مَرِفِ عَلَتَلَ نَن يِ مَسٍنشِ؛ دَرِ سَلَمُ نَن يَ ﭑ نَشَن دْشْ سِيٍ تَفِ. حَمَنّيٍ نَن نَ عَ رَبِلِنيِ بِرِن مَ. <verse eid="EZK 5:5"/><verse number="6" style="v" sid="EZK 5:6"/>كْنْ عَ بَرَ مُرُتَ ﭑ مَ سّرِيّ نُن ﭑ مَ يَامَرِيٍ مَ عَ شَ حَاشُحَ كُي. عَ بَرَ عَ كٌبٍ رَ سٌ ﭑ نَ، عَ فبِلٍن ﭑ قْشْ رَ.»<verse eid="EZK 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 5:7"/>«ﭑ تَن مَرِفِ عَلَتَلَ نَن يِ مَسٍنشِ؛ وٌ بَرَ حَاشُ دَنفِقٍ وٌ دْشْبٌورٍيٍ بِرِن نَ. وٌ تٌ مُ تِنشِ بِرَدٍ ﭑ مَ كِرَ قْشْ رَ، وٌ مُ ﭑ مَ سّرِيّ سُشُ. هَلِ وٌ دْشْبٌورٍيٍ شَ سّرِيّ، وٌ مُ عَ بِنيَمَ.»<verse eid="EZK 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 5:8"/>«ﭑ تَن مَرِفِ عَلَتَلَ نَن يِ مَسٍنشِ؛ ﭑ تَن بَرَ تِ وٌ كَنكٍ دَرِ سَلَمُكَيٍ. ﭑ قَمَ نّ وٌ حَشَنكَتَدٍ سِيٍ يَ شْرِ. <verse eid="EZK 5:8"/><verse number="9" style="v" sid="EZK 5:9"/>وٌ تٌ بِرَ كُيٍ شْنشِيٍ بَتُقٍ رَ، ﭑ قٍ رَبَمَ نّ وٌ رَ ﭑ مُ نَشَن سِنفٍ رَبَشِ، ﭑ مُ نَشَن نَبَمَ يَرٍ. <verse eid="EZK 5:9"/><verse number="10" style="v" sid="EZK 5:10"/>وٌ بَبَيٍ قَمَ نّ عٍ شَ دِيٍ دٌندٍ، وٌ شَ دِيٍ قَمَ نّ عٍ بَبَيٍ دٌندٍ. ﭑ وٌ حَشَنكَتَمَ نَ كِ نّ، نَشٍيٍ لُشِ ﭑ قَ عٍ رَيٍنسٍن حَمَنّيٍ مَ.»<verse eid="EZK 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 5:11"/>«ﭑ تَن مَرِفِ عَلَتَلَ ﭑ بَرَ ﭑ كَلِ؛ وٌ تٌ ﭑ مَ هْرْ مْبَنشِ رَقٍ كُيٍ حَاشِيٍ رَ، وٌ قَ بَتُي رَبَ ﭑ نَشَن شْنشِ، ﭑ نَ ﭑ مَ هِننّ بَمَ نّ وٌ يِ رَ، ﭑ مُ كِنِكِنِمَ وٌ مَ، ﭑ مُ وٌ رَكِسِمَ قٍقٍ مَ. <verse eid="EZK 5:11"/><verse number="12" style="v" sid="EZK 5:12"/>وٌ شَ حَمَ دْشْ كٍرٍن قَشَمَ نّ وُفَنيِ نُن كَامّ رَ. عَ دْشْ قِرِن ندٍ قَشَمَ سَنتِدّفّمَ نَن نَ تَا قَرِ مَ. عَ دْشْ سَشَن ندٍ رَيٍنسٍن يّ حَمَنّيٍ مَ، ﭑ عٍ كٍرِ سَنتِدّفّمَ رَ.»<verse eid="EZK 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 5:13"/>«نَ تّمُي، ﭑ مَ شْنّ دَنمَ نّ. ﭑ فبٍ قَمَ نّ حْشْدٍ نَ كُي. ﭑ نَ شْنْ عٍ مَ نَ كِ، عٍ قَمَ نّ عَ كٌلٌندٍ ﭑ تَن عَلَتَلَ بْحّ نَ كِ نَشّ. <verse eid="EZK 5:13"/><verse number="14" style="v" sid="EZK 5:14"/>ﭑ عِ قِندِ مَ يِرٍ كَنَشِ نَن نَ، سِ فبّتّيٍ نَ نَا تٌ، عٍ قَ وٌ مَبٍرٍ. <verse eid="EZK 5:14"/><verse number="15" style="v" sid="EZK 5:15"/>ﭑ نَ فّ وٌ حَشَنكَتَدٍ ﭑ مَ شْنّ كُي، عٍ قٍ حَاشِ قَلَمَ نّ وٌ شُن مَ، عٍ وٌ كٌنبِ. وٌ قِندِ مَ مَسٍنيِ مَفَاشُشِ نَن نَ سِيٍ بّ نَشٍيٍ نَ وٌ رَبِلِنيِ. وٌ مَرِفِ عَلَتَلَ شُي نَن نَ كِ.»<verse eid="EZK 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 5:16"/>«ﭑ نَ ﭑ مَ شَلِ قَشَتِسٍ وٌلِمَ نّ وٌ مَ، نَشَن لَنشِ كَامّ مَ. نٍيٍ وٌلِمَ نّ عَلَكٌ ﭑ شَ وٌ سْنتْ. ﭑ لُمَ نّ وٌ شَ كَامّ شُن مَسَ رَ، وٌ شَ بَلٌي شَ حْن قٍوٌ. <verse eid="EZK 5:16"/><verse number="17" style="v" sid="EZK 5:17"/>ﭑ كَامّ رَدِنمَ نّ وٌ مَ، ﭑ سُبٍ شَاحّيٍ شّيمَ نّ وٌ يِرٍ. نَ بِرِن وٌ شَ دِيٍ سْنتْمَ نّ. وُفَنيِ، قَشّ، نُن فٍرٍ مُ حْنمَ وٌ تَفِ. وٌ مَرِفِ عَلَتَلَ شُي نَن نَ كِ.»<verse eid="EZK 5:17"/></para>
  <chapter eid="EZK 5"/>
  <chapter number="6" style="c" sid="EZK 6"/>
  <para style="s">حَشَنكَتّ فٍيَيٍ قَرِ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 6:1"/>عَلَتَلَ نَشَ يِ مَسٍنيِ تِ ﭑ بّ، <verse eid="EZK 6:1"/><verse number="2" style="v" sid="EZK 6:2"/>«عَدَ مَدِ، عِ يَ رَقِندِ عِسِرَيِلَ فٍيَيٍ مَ، عِ شَ ﭑ شُي رَدَنفِ عٍ مَ. <verse eid="EZK 6:2"/><verse number="3" style="v" sid="EZK 6:3"/>عِ شَ عَ قَلَ، ‹عِسِرَيِلَكَيٍ، وٌ وٌ تُلِ مَتِ وٌ مَرِفِ عَلَتَلَ شَ مَسٍنيِ رَ. ﭑ نَشّ وٌ تَن نَشٍيٍ نَ فٍيَيٍ قَرِ نُن فُلُنبَيٍ كُي، ﭑ قَمَ نّ وٌ سْنتْدٍ سَنتِدّفّمَ رَ، ﭑ وٌ شَ كُيٍ بَتُدٍيٍ كَنَ. <verse eid="EZK 6:3"/><verse number="4" style="v" sid="EZK 6:4"/>وٌ شَ سّرّشّبَدٍيٍ كَنَمَ نّ، وٌ شَ سُرَيِ سّرّشّبَدٍيٍ يٍنسٍن، وٌ قَشَ وٌ شَ كُيٍيٍ يَ شْرِ. <verse eid="EZK 6:4"/><verse number="5" style="v" sid="EZK 6:5"/>ﭑ وٌ تَن عِسِرَيِلَكَيٍ بِنبِيٍ لُمَ نّ نَ سّرّشّبَدٍيٍ رَبِلِنيِ، وٌ شْرِيٍ رَيٍنسٍنمَ نّ نَا. <verse eid="EZK 6:5"/><verse number="6" style="v" sid="EZK 6:6"/>وٌ سَبَتِ دّدّ، وٌ شَ تَايٍ نُن وٌ شَ بَتُدٍيٍ كَنَمَ نّ. وٌ شَ سّرّشّبَدٍيٍ نُن وٌ شَ كُيٍيٍ بُتُشُنمَ نّ، وٌ شَ سُرَيِ سّرّشّبَدٍيٍ رَبِرَ. وٌ شَ وَلِ بِرِن شُن نَكَنَمَ نّ. <verse eid="EZK 6:6"/><verse number="7" style="v" sid="EZK 6:7"/>مِشِ فبٍفبٍ نَ قَشَ وٌ يَ مَ، وٌ قَمَ عَ كٌلٌندٍ عَ عَلَتَلَ نَ ﭑ تَن نَن نَ.›»<verse eid="EZK 6:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 6:8"/>«كْنْ ﭑ وٌ دْنشْييٍ رَتَنفَمَ نّ سَنتِدّفّمَ مَ، ﭑ قَ وٌ لُ حَمَنّيٍ مَ. <verse eid="EZK 6:8"/><verse number="9" style="v" sid="EZK 6:9"/>نَ تّمُي وٌ شَ مِشِ نَشٍيٍ شَنِنشِ كٌنيِيَ كُي، عٍ قَمَ نّ رَتُدٍ ﭑ مَ. عٍ قَ عٍ شَ يَنقَنتٍيَ كٌلٌن ﭑ مَبِرِ، عٍ شَ بِرّ كُيٍيٍ قْشْ رَ، نَ بِرِن بَرَ ﭑ بْحّ تْورْ. عٍ نَ قَهَامُي سْتْ عٍ شَ حَاشُحَ مَ، عٍ بْحّ قَن تْورْ مَ نّ. <verse eid="EZK 6:9"/><verse number="10" style="v" sid="EZK 6:10"/>نَ تّمُي عٍ عَ كٌلٌنمَ نّ عَ عَلَتَلَ نَ ﭑ تَن نَن نَ. ﭑ مُ وْيّنشِ قُقَقُ رَ ﭑ تٌ يِ فبَلٌي قٍ قَلَ عٍ بّ.»<verse eid="EZK 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 6:11"/>«وٌ مَرِفِ عَلَتَلَ شَ مَسٍنيِ نَن يَ؛ وٌ وٌ بّلّشّ بْنبْ، وٌ وٌ سَنيِ رَ مَشَ، عَ قَلَقٍ رَ، ‹عِسِرَيِلَ بْنسْي شَ حَاشُحَ بِرِن بَرَ عَ نِيَ عٍ شَ قَشَ فٍرٍ، كَامّ، نُن وُفَنيِ رَ. <verse eid="EZK 6:11"/><verse number="12" style="v" sid="EZK 6:12"/>نَشٍيٍ مَكُيَ، وُفَنيِ نَن نٍيٍ قَشَمَ. نَشٍيٍ مَكْرّ، نٍيٍ قَشَمَ فٍرٍ نَن كُي. نَشٍيٍ نَ رَتَنفَ نَ فبَلٌي مَ، كَامّ نَن نٍيٍ قَن قَشَمَ. ﭑ نَ ﭑ مَ شْنّ قُلُنمَ نّ عٍ شِلِ مَ. <verse eid="EZK 6:12"/><verse number="13" style="v" sid="EZK 6:13"/>عٍ نَ عٍ شَ مِشِ بِنبِيٍ تٌ عٍ شَ كُيٍيٍ سّيتِ مَ نَ سّرّشّبَدٍيٍ يِرٍ فٍيَيٍ قَرِ وُرِيٍ بُن مَ عٍ نُ سُرَيِ قَنيِ فَنمَ دّننَشّ سّرّشّ رَ عٍ شَ كُيٍيٍ بّ، عٍ عَ كٌلٌنمَ نّ عَ ﭑ تَن نَن نَ عَلَتَلَ رَ. <verse eid="EZK 6:13"/><verse number="14" style="v" sid="EZK 6:14"/>ﭑ قَمَ نّ ﭑ بّلّشّ عِتَلَدٍ عٍ شِلِ مَ، عٍ شَ بْشِ قَ كَنَ كٍلِقٍ فبٍنفبٍرٍنيِ مَ هَن دِبِلَ. نَ كُي عٍ عَ كٌلٌنمَ نّ عَ ﭑ تَن نَن نَ عَلَتَلَ رَ.›»<verse eid="EZK 6:14"/></para>
  <chapter eid="EZK 6"/>
  <chapter number="7" style="c" sid="EZK 7"/>
  <para style="s">عِسِرَيِلَ شَ قٍ رَحْنيِ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 7:1"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، عَ نَشّ، <verse eid="EZK 7:1"/><verse number="2" style="v" sid="EZK 7:2"/>«عِ تَن عَدَ مَدِ، وٌ مَرِفِ عَلَتَلَ شُي نَن يِ كِ عِسِرَيِلَ بْنسْي بّ، ‹وٌ شَ قٍ رَحْنيِ بَرَ وٌ شَ بْشِ تُنشُن نَانِ بِرِن لِ! <verse eid="EZK 7:2"/><verse number="3" style="v" sid="EZK 7:3"/>عَ فبٍ مُ لُشِ ﭑ شَ ﭑ مَ شْنّ رَدِن وٌ مَ، وٌ شَ وٌ شَ وَلِ حَاشِ سَرٍ سْتْ، وٌ شَ قٍ شَ حْن. <verse eid="EZK 7:3"/><verse number="4" style="v" sid="EZK 7:4"/>ﭑ مُ كِنِكِنِمَ وٌ مَ قٍقٍ مَ. ﭑ وٌ شَ وَلِ كٌبِ بِرِن نَفبِلٍنمَ نّ وٌ مَ. نَ كُي وٌ قَمَ نّ عَ كٌلٌندٍ ﭑ تَن نَن نَ عَلَتَلَ رَ.›»<verse eid="EZK 7:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 7:5"/>«وٌ مَرِفِ عَلَتَلَ شُي نَن يِ كِ، وٌ شَ فبَلٌي مَفَاشُشِ بَرَ وٌ لِ. <verse eid="EZK 7:5"/><verse number="6" style="v" sid="EZK 7:6"/>وٌ شَ قٍ رَحْنيِ بَرَ قَ، عَ بَرَ وٌ يِرٍ لِ، عَ بَرَ كٍلِ وٌ شِلِ مَ! <verse eid="EZK 7:6"/><verse number="7" style="v" sid="EZK 7:7"/>قٍ شْرْشْي بَرَ وٌ لِ، وٌ تَن نَشٍيٍ سَبَتِشِ عِسِرَيِلَ بْشِ مَ. ﭑ مَ كِيتِ لْشْي بَرَ قَ. سّيوّ بَرَ مَسَرَ كْنتْقِلِ رَ وٌ شَ فٍيَيٍ قَرِ. <verse eid="EZK 7:7"/><verse number="8" style="v" sid="EZK 7:8"/>عَ فبٍ مُ لُشِ ﭑ شَ ﭑ مَ شْنّ رَدِن وٌ مَ عَ حَاشِ رَ. ﭑ وٌ مَكِيتِمَ نّ وٌ شَ وَلِ حَاشِ شَ قٍ رَ، ﭑ وٌ شَ يُنُبِيٍ سَرٍ رَفبِلٍن وٌ مَ. <verse eid="EZK 7:8"/><verse number="9" style="v" sid="EZK 7:9"/>ﭑ مُ كِنِكِنِمَ وٌ مَ قٍقٍ مَ. ﭑ وٌ شَ وَلِ كٌبِ بِرِن نَفبِلٍنمَ نّ وٌ مَ. نَ كُي وٌ قَمَ نّ عَ كٌلٌندٍ ﭑ تَن نَن نَ عَلَتَلَ رَ.»<verse eid="EZK 7:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 7:10"/>«نَ لْشْي نَن يِ كِ! فبَلٌي بَرَ رَ مِنِ عَلْ قُفٍ مِنِمَ سَنسِ وُرِ مَ كِ نَشّ. وٌ شَ يّتّ عِفبٌحَ بَرَ دَنفّ. <verse eid="EZK 7:10"/><verse number="11" style="v" sid="EZK 7:11"/>وٌ شَ قٍ كٌبِ بَرَ قِندِ لُشُسِنيِ رَ ﭑ بّلّشّ كُي. حَمَ يٌ مُ لُمَ وٌ شْنيِ، عٍ هَرِفٍ بِرِن حْنمَ نّ. <verse eid="EZK 7:11"/><verse number="12" style="v" sid="EZK 7:12"/>كِيتِ وَشَتِ بَرَ قَ، نَ لْشْي بَرَ عَ لِ. سَرٍ سٌي نَشَ سّيوَ، سَرٍ مَتِ نَشَ سُننُن، بَرِ مَ عَلَتَلَ شَ شْنّ نَ تٍقٍ حَمَ بِرِن شِلِ مَ. <verse eid="EZK 7:12"/><verse number="13" style="v" sid="EZK 7:13"/>سَرٍ سٌي مُ سٍسٍ قِمَ سَرٍ مَتِيٍ مَ عٍ شَ دُنِحّءِفِرِ كُي، بَرِ مَ عَلَ شَ نَتّ مُ مَسَرَ مَ. عٍ بِرِن قَشَمَ نّ عٍ شَ يُنُبِيٍ شَ قٍ رَ. <verse eid="EZK 7:13"/><verse number="14" style="v" sid="EZK 7:14"/>هَلِ عٍ سَرَ قٍ، عٍ فٍرٍ قٍ يَءِلَن، مِشِ يٌ مُ سِفَمَ فٍرٍ سٌدٍ بَرِ مَ ﭑ مَ شْنّ بَرَ دِن عٍ بِرِن نَ سِننَنيِ مَ.»<verse eid="EZK 7:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 7:15"/>«فٍرٍ نَ تَا قَرِ مَ، وُفَنيِ نُن كَامّ نَ تَا كُي. نَشَن نَ دَاشَ نَ قَشَمَ فٍرٍ نَن كُي، نَشَن نَ تَا كُي نَ كَنيِ قَشَ كَامّ نُن وُفَنيِ رَ. <verse eid="EZK 7:15"/><verse number="16" style="v" sid="EZK 7:16"/>نَشٍيٍ نَ رَتَنفَ نَ مَ، نٍيٍ سَ عٍ نْشُنمَ فٍيَيٍ نَن قَرِ. عٍ وَ مَ نّ عَلْ كٌلٌكٌندٍ عٍ شَ يُنُبِيٍ شَ قٍ رَ. <verse eid="EZK 7:16"/><verse number="17" style="v" sid="EZK 7:17"/>عٍ سّنبّ حْنمَ نّ، عٍ شِنبِيٍ رَكٌرِ. <verse eid="EZK 7:17"/><verse number="18" style="v" sid="EZK 7:18"/>عٍ سُننُنيِ دُفِ نَن نَفٌرٌ مَ عٍ مَ، عٍ عٍ شُنيِ نُن عٍ دّشَبٍ بِ يَافِ كُي. <verse eid="EZK 7:18"/><verse number="19" style="v" sid="EZK 7:19"/>عٍ فبٍتِ نُن شّيمَ وٌلِمَ نّ تَندٍ عَلْ سٍ سّنِيّنتَرٍ، كْنْ نَ سٍسٍ مُ قِندِ مَ كِسِ رَ عٍ بّ عَلَ شَ شْنّ لْشْي. نَ نَاقُلِ مُ قِندِ مَ دٌنسٍ رَ عٍ بّ، بَرِ مَ عَ قِندِ نّ عٍ رَتَنتَنسٍ رَ. <verse eid="EZK 7:19"/><verse number="20" style="v" sid="EZK 7:20"/>عٍ نُ بَرَ حّلّشِن عٍ شَ شُنمَسٍ قَنيِيٍ رَ، عٍ نَشٍيٍ رَوَلِشِ كُيٍ حَاشِيٍ يَءِلَنقٍ رَ. نَ كُي ﭑ نٍيٍ قِندِ مَ نّ سٍ سّنِيّنتَرٍيٍ رَ، <verse eid="EZK 7:20"/><verse number="21" style="v" sid="EZK 7:21"/>ﭑ نٍيٍ سٌ عٍ يَشُي حَاشِيٍ يِ رَ نَشٍيٍ عٍ رَوَلِمَ قٍ كٌبِ رَ حَمَنّ مَ. <verse eid="EZK 7:21"/><verse number="22" style="v" sid="EZK 7:22"/>ﭑ نَ ﭑ كٌبٍ سٌمَ نّ عٍ رَ. عٍ قَمَ نّ سٌدٍ ﭑ مَ هْرْ مْبَنشِ كُي، عٍ قٍ سّنِيّنتَرٍ رَبَ نَا، عٍ ﭑ مَ سٍيٍ مُحَ.»<verse eid="EZK 7:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 7:23"/>«يْلْنشْنيِيٍ شَ يَءِلَن، بَرِ مَ وٌ شَ بْشِ رَقٍشِ سُوتٍ نُن قَشّتِيٍ نَن نَ. <verse eid="EZK 7:23"/><verse number="24" style="v" sid="EZK 7:24"/>ﭑ مِشِ حَاشِيٍ نَن نَقَمَ كٍلِقٍ حَمَنّيٍ مَ، عَلَكٌ عٍ شَ وٌ شَ بَنشِيٍ تٌنفٌ، عٍ شَ وٌ رَيَافِ، عٍ شَ وٌ شَ بَتُدٍيٍ مَبٍرٍ. <verse eid="EZK 7:24"/><verse number="25" style="v" sid="EZK 7:25"/>قٍ شْرْشْي نَ وٌ لِ، وٌ بْحّسَ قٍنمَ نّ، كْنْ وٌ مُ نَ تٌمَ قٍقٍ مَ. <verse eid="EZK 7:25"/><verse number="26" style="v" sid="EZK 7:26"/>فبَلٌي لُمَ قَ رَ نّ عَ بٌرٍ قْشْ رَ. وٌ لُمَ نّ قٍ شْرْشْي مّ رَ. وٌ شِبَارُ قَنيِ قٍنمَ نّ نَمِحْنمّ رَ، كْنْ مَرَ سِ يٌ مُ لُمَ سّرّشّدُبّيٍ نُن قٌرِيٍ يِ رَ. <verse eid="EZK 7:26"/><verse number="27" style="v" sid="EZK 7:27"/>مَنفّ لُمَ نّ سُننُن نَ، عَ شَ كُنتِفِيٍ نِمِسَ، عَ شَ حَمَ بِرِن سّرّن فَاشُي كُي. ﭑ عٍ مَكِيتِمَ عٍ حّرّ كِ نَن مَ، عَلْ عٍ دَرِشِ عَ رَ كِ نَشّ. نَ تّمُي عٍ عَ كٌلٌنمَ نّ ﭑ تَن نَن نَ عَلَتَلَ رَ.»<verse eid="EZK 7:27"/></para>
  <chapter eid="EZK 7"/>
  <chapter number="8" style="c" sid="EZK 8"/>
  <para style="s">كُيٍ بَتُقٍ عَلَ شَ هْرْ مْبَنشِ كُي</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 8:1"/>عَ حّ سٍننِ ندٍ، كِكٍ سٍننِ، شِ سُولِ ندٍ رَ، ﭑ نُ دْشْشِ ﭑ مَ بَنشِ نَن كُي، يُدَ قٌرِيٍ قَن نُ نَ ﭑ سّيتِ مَ. نَ تّمُي مُشُ مَرِفِ عَلَتَلَ نَشَ عَ سّنبّ مَسٍن ﭑ بّ. <verse eid="EZK 8:1"/><verse number="2" style="v" sid="EZK 8:2"/>ﭑ نَشَ لَامَتُنيِ تٌ نَشَن لَنشِ شّمّ ندٍ مَ نَشَن سَنيِيٍ نُ لُشِ عَلْ تّ، عَ كَنكٍ نُ يَنبَمَ عَلْ بَقَتَ رَشُنُشِ. <verse eid="EZK 8:2"/><verse number="3" style="v" sid="EZK 8:3"/>عَ نَشَ عَ بّلّشّ عِتَلَ، عَ ﭑ شُنسّشّ سُشُ. عَلَ شَشِلِ سّنِيّنشِ نَشَ ﭑ تٌنفٌ، عَ ﭑ عِتٍ كٌورٍ نُن بْشِ تَفِ، عَ قَ لَامَتُنيِ مَسٍن ﭑ بّ. ﭑ نَشَ عَلَ شَ هْرْ مْبَنشِ تٌ دَرِ سَلَمُ. ﭑ تٌ نَ سٌدٍ دّ لِ نَشَن نُ نَ كْولَ مَ، ﭑ نَشَ كُيٍ ندٍ تٌ نَا نَشَن عَلَ رَشْنْمَ. <verse eid="EZK 8:3"/><verse number="4" style="v" sid="EZK 8:4"/>عِسِرَيِلَ مَرِفِ عَلَ شَ نْرّ قَن نُ نَ مّننِ، عَلْ ﭑ عَ تٌ كِ نَشّ عَ سِنفٍ رَ قِيلِ مَ.<verse eid="EZK 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 8:5"/>عَلَ نَشَ عَ مَسٍن ﭑ بّ، «عِ تَن عَدَ مَدِ، عِ يَ تِ كْولَ بِرِ رَ.» ﭑ تٌ ﭑ يَ رَ سِفَ نَا، ﭑ نَشَ نَ كُيٍ تٌ هْرْ مْبَنشِ سٌدٍ دّ كْولَ بِرِ رَ، نَشَن عَلَتَلَ رَشْنْمَ. <verse eid="EZK 8:5"/><verse number="6" style="v" sid="EZK 8:6"/>عَلَ نَشَ عَ مَسٍن ﭑ بّ، «عَدَ مَدِ، عِ بَرَ عِسِرَيِلَ بْنسْي شَ وَلِ حَاشِ تٌ، وَلِ نَشَن عَ نِيَمَ ﭑ شَ ﭑ مَكُيَ ﭑ مَ هْرْ مْبَنشِ رَ؟ عِ قَمَ نّ قٍ فبّتّ تٌدٍ نَشٍيٍ حَاشُ نَ بّ.»<verse eid="EZK 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 8:7"/>عَلَ نَشَ ﭑ شَنِن هْرْ مْبَنشِ سٌدٍ دّ فبّتّ رَ. مّننِ ﭑ نَشَ يَلٍ ندٍ تٌ تّتّ مَ. <verse eid="EZK 8:7"/><verse number="8" style="v" sid="EZK 8:8"/>عَ نَشَ عَ مَسٍن ﭑ بّ، «عَدَ مَدِ، عِ شَ نَ يَلٍ رَشُنفبٌ.» ﭑ تٌ نَ رَبَ، ﭑ نَشَ نَادّ ندٍ تٌ. <verse eid="EZK 8:8"/><verse number="9" style="v" sid="EZK 8:9"/>عَ نَشَ عَ مَسٍن ﭑ بّ، «عِ شَ سٌ نَا حَمَ شَ وَلِ حَاشِ مَتٌدٍ.» <verse eid="EZK 8:9"/><verse number="10" style="v" sid="EZK 8:10"/>ﭑ تٌ سٌ مّننِ كُي، ﭑ نَشَ بُبُسٍيٍ، سُبٍ رَهَرَ مُشِيٍ، نُن عِسِرَيِلَ بْنسْي شَ كُيٍ بِرِن شَ ثِرِنتِ تٌ نَ بَنشِ شَلّ رَبِلِنيِ مَ. <verse eid="EZK 8:10"/><verse number="11" style="v" sid="EZK 8:11"/>عِسِرَيِلَ قٌرِ تٌنفٌ سٌلٌقٍرٍ نُن سَقَن شَ دِ يَاسَنِيَ نُ نَ مّننِ، سُرَيِ فَنسٍ سُشُشِ كَنكَن يِ رَ، تُورِ نُ قَ تٍ عَ قَ مّننِ رَقٍ.<verse eid="EZK 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 8:12"/>عَلَ نَشَ عَ مَسٍن ﭑ بّ، «عَدَ مَدِ، عِ بَرَ عِسِرَيِلَ بْنسْي قٌرِيٍ شَ وَلِ تٌ، عٍ نَشَن نَبَقٍ دِ مِ كُي عٍ شَ كُيٍيٍ رَ؟ عٍ نَشّ، ‹عَلَتَلَ مُ وٌن تٌشِ قٍوٌ. عَ بَرَ وٌن مَ بْشِ رَبٌلٌ.›» <verse eid="EZK 8:12"/><verse number="13" style="v" sid="EZK 8:13"/>عَلَ مَن نَشَ عَ مَسٍن ﭑ بّ، «عِ قَمَ نّ قٍ فبّتّ تٌدٍ نَشٍيٍ حَاشُ نَ بّ.»<verse eid="EZK 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 8:14"/>نَ تّمُي عَ نَشَ ﭑ شَنِن عَلَتَلَ شَ هْرْ مْبَنشِ سٌدٍ دّ رَ كْولَ مَبِرِ. ﭑ نَشَ فِنّ ندٍيٍ لِ مّننِ، عٍ دْشْشِ، عٍ حْنقٍ رَبَقٍ كُيٍ ندٍ بّ نَشَن شِلِ تَمُسُ. <verse eid="EZK 8:14"/><verse number="15" style="v" sid="EZK 8:15"/>عَ نَشَ عَ مَسٍن ﭑ بّ، «عَدَ مَدِ، عِ بَرَ عَ تٌ؟ عِ قَمَ نّ قٍ فبّتّ تٌدٍ نَشٍيٍ حَاشُ نَ بّ.»<verse eid="EZK 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 8:16"/>عَ نَشَ ﭑ نَسٌ عَلَتَلَ شَ هْرْ مْبَنشِ شَ تّتّ كُي. ﭑ نَشَ مِشِ مْشْحّن نُن سُولِ تٌ هْرْ مْبَنشِ سٌدٍ دّ رَ، فبُتُنيِ نُن سّرّشّبَدٍ تَفِ، عٍ كٌبٍ سٌشِ عَلَتَلَ شَ بَنشِ رَ، عٍ يَ رَقِندِشِ سٌفٍتٍدٍ مَ عٍ نُ سُيِدِ سٌفٍ بّ. <verse eid="EZK 8:16"/><verse number="17" style="v" sid="EZK 8:17"/>عَلَ نَشَ عَ مَسٍن ﭑ بّ، «عَدَ مَدِ، عِ بَرَ عَ تٌ؟ قٍ شُرِ دِ نَن يِ رَ يُدَيَكَيٍ نَ نَشٍيٍ رَبَقٍ بٍ؟ عٍ مَن نَ قٍ حَاشِ نَن نَبَمَ بْشِ بِرِن كُي، قٍ نَشَن ﭑ نَشْنْمَ هَن. عَ مَتٌ عٍ نَ كُيٍ سَلٌنسٍيٍ سُنبُقٍ كِ نَشّ. <verse eid="EZK 8:17"/><verse number="18" style="v" sid="EZK 8:18"/>نَ كُي ﭑ نَ ﭑ فبٍ حْشْمَ ﭑ مَ شْنّ كُي. ﭑ مُ كِنِكِنِمَ عٍ مَ، ﭑ مُ فبِلٍنمَ نَ حَشَنكَتّ قْشْ رَ. هَلِ عٍ ﭑ مَشَندِ عٍ شُي عِتٍشِ رَ، ﭑ مُ ﭑ تُلِ مَتِمَ عٍ رَ قٍقٍ مَ.»<verse eid="EZK 8:18"/></para>
  <chapter eid="EZK 8"/>
  <chapter number="9" style="c" sid="EZK 9"/>
  <para style="s">كُيٍ بَتُييٍ شَ قَشّ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 9:1"/>نَ تّمُي ﭑ نَشَ عَلَ شُي عِتٍشِ مّ، عَ نَشّ، «تَا كَنتَمَيٍ، وٌ شَ قَ وٌ شَ فٍرٍ سٌسٍيٍ رَ!» <verse eid="EZK 9:1"/><verse number="2" style="v" sid="EZK 9:2"/>شّمّ سٍننِ نَشَ مِنِ نَادّ قُفٍ بِرِ رَ، نَادّ نَشَن يَ رَقِندِشِ كْولَ مَ، بِرِن نُن عَ شَ فٍرٍ سٌسٍ رَ عَ بّلّشّ عِ. شّمّ فبّتّ نُ نَ عٍ يَ مَ، دُفِ قِيشّ رَفٌرٌشِ عَ مَ، سّبّلِ تِ سٍ نُ نَ عَ بّلّشّ عِ. عٍ نَشَ قَ، عٍ تِ سّرّشّبَدٍ قّ مَ، نَشَن يَءِلَنشِ وُرٍ فبٍيلِ رَ.<verse eid="EZK 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 9:3"/>عِسِرَيِلَ مَرِفِ عَلَ شَ نْرّ نَشَ كٍلِ مَلٍكّيٍ سَوُرّيٍ شُن، عَ نُ مَفٌرٌشِ نَشٍيٍ قَرِ، عَ عَ شُن تِ بَنشِ سٌدٍ دّ رَ. عَلَتَلَ نَشَ نَ شّمّ شِلِ دُفِ قِيشّ رَفٌرٌشِ نَشَن مَ، سّبّلِ تِ سٍ نُ نَ نَشَن بّلّشّ، <verse eid="EZK 9:3"/><verse number="4" style="v" sid="EZK 9:4"/>عَ عَ مَسٍن عَ بّ، «عِ شَ عِ حّرّ دَرِ سَلَمُ تَا كُي تْنشُمَ سَقٍ رَ شّمّيٍ بِرِن تِفِ رَ، نَشٍيٍ نَ تْورْقٍ، نَشٍيٍ نَ وَقٍ يِ قٍ حَاشِيٍ شَ قٍ رَ نَشٍيٍ رَبَمَ دَرِ سَلَمُ.»<verse eid="EZK 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 9:5"/>عَ مَن نَشَ عَ مَسٍن عَ بٌورٍيٍ بّ ﭑ يَ شْرِ، «وٌ بِرَ يِ شّمّ قْشْ رَ، وٌ شَ قَشّ تِ كِنِكِنِتَرٍحَ كُي! <verse eid="EZK 9:5"/><verse number="6" style="v" sid="EZK 9:6"/>وٌ شَ مِشِ بِرِن قَشَ، قٌرِيٍ، سّفّتَلَيٍ، سُنفبُتُنيِيٍ، فِنّيٍ نُن دِ مّدِيٍ. كْنْ تْنشُمَ نَ نَشٍيٍ تِفِ مَ، وٌ نٍيٍ لُ نَ! وٌ شَ يِ وَلِ قْلْ ﭑ مَ هْرْ مْبَنشِ سّنِيّنشِ يِرٍ.» نَ كُي عٍ نَشَ نَ قٌرِيٍ قَشَ نَشٍيٍ نُ تِشِ هْرْ مْبَنشِ يَ رَ. <verse eid="EZK 9:6"/><verse number="7" style="v" sid="EZK 9:7"/>عَ مَن نَشَ عَ مَسٍن عٍ بّ، «هَلِ عَ قِندِشِ قٍ سّنِيّنتَرٍ نَن نَ، وٌ شَ ﭑ مَ هْرْ مْبَنشِ شَ تّتّ رَقٍ بِنبِيٍ رَ! يَكْسِ، وٌ سِفَ!» نَ كُي عٍ نَشَ مِنِ، عٍ قَشّ بٍلٍبٍلٍ تِ تَا كُي.<verse eid="EZK 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 9:8"/>عٍ نُ قَشّ تِمَ تّمُي نَشّ، ﭑ نَشَ ﭑ قٍلٍن بْشِ مَ ﭑ كٍرٍن. ﭑ نُ ﭑ مَوَقٍ عَلَ بّ عَ قَلَقٍ رَ، «ﭑ مَرِفِ عَلَتَلَ، عِ وَ مَ عِسِرَيِلَ بْنسْي بِرِن سْنتْقٍ نّ عِ شَ شْنّ كُي نَشَن نَ تٍقٍ دَرِ سَلَمُ تَا كُي؟» <verse eid="EZK 9:8"/><verse number="9" style="v" sid="EZK 9:9"/>عَ نَشَ ﭑ يَابِ، «عِسِرَيِلَ نُن يُدَ بْنسْي شَ يُنُبِ فبٌ! عٍ لُمَ قَشّ تِ رَ تّمُي بِرِن، عٍ قٍ تِنشِنتَرٍيٍ رَبَ بْشِ بِرِن كُي. عٍ نَشّ، ‹عَلَتَلَ بَرَ يِ بْشِ رَبٌلٌ، عَ مُ وٌن مَ قٍ تٌمَ سْنْن.› <verse eid="EZK 9:9"/><verse number="10" style="v" sid="EZK 9:10"/>نَ كُي ﭑ مُ كِنِكِنِمَ عٍ مَ قٍقٍ مَ. ﭑ عٍ شَ وَلِ حَاشِ سَرٍ رَفبِلٍنمَ نّ عٍ مَ عَ شْرْشْي رَ.»<verse eid="EZK 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 9:11"/>نَ تّمُي نَ شّمّ دُفِ قِيشّ رَفٌرٌشِ نَشَن مَ، سّبّلِ تِ سٍ سُشُشِ نَشَن يِ رَ، عَ نَشَ فبِلٍن، عَ دّنتّفّ سَ عَ شّيمَ بّ، «ﭑ بَرَ فّ عِ شَ يَامَرِ رَبَدٍ.»<verse eid="EZK 9:11"/></para>
  <chapter eid="EZK 9"/>
  <chapter number="10" style="c" sid="EZK 10"/>
  <para style="s">عَلَ شَ نْرّ شَ كٍلِ عَ شَ هْرْ مْبَنشِ شُن</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 10:1"/>نَ لَامَتُنيِ كُي ﭑ نَشَ كِبَنيِ ندٍ تٌ مَلٍكّيٍ شُن مَ نَشَن نُ لُشِ عَلْ دِيَمَن مَنِيّ. <verse eid="EZK 10:1"/><verse number="2" style="v" sid="EZK 10:2"/>عَلَتَلَ نَشَ عَ مَسٍن شّمّ بّ دُفِ قِيشّ نُ رَفٌرٌشِ نَشَن مَ، «عِ شَ سٌ مَلٍكّيٍ بُن مَ، سَنيِ رَدِفِلِنشِيٍ نَ دّننَشّ، عِ شَ تّ وٌلٍيٍ تٌنفٌ، عِ عٍ رَيٍنسٍن تَا مَ.» عَ نَشَ نَ رَبَ ﭑ يَ شْرِ.<verse eid="EZK 10:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 10:3"/>نَ مَلٍكّيٍ نُ تِشِ هْرْ مْبَنشِ يِرٍقَنيِ مَ نَ شّمّ سٌ تّمُي نَشّ. كُندَ نُ نَ هْرْ مْبَنشِ تّتّ كُي. <verse eid="EZK 10:3"/><verse number="4" style="v" sid="EZK 10:4"/>عَلَتَلَ شَ نْرّ نَشَ كٍلِ نَ مَلٍكّيٍ شُن مَ، عَ سِفَ هْرْ مْبَنشِ سٌدٍ دّ رَ. كُندَ نَشَ هْرْ مْبَنشِ رَقٍ، عَلَتَلَ شَ نْرّ شَ يَنبّ قَنيِ نُ نَ تّتّ بِرِن كُي. <verse eid="EZK 10:4"/><verse number="5" style="v" sid="EZK 10:5"/>نَ مَلٍكّيٍ فَبُتٍنيِيٍ شُي نُ مّمَ بٌورٍ تّتّ كُي، عَ نُ فبٌ عَلْ عَلَ سّنبّمَ وْيّن شُي.<verse eid="EZK 10:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 10:6"/>عَلَتَلَ تٌ شّمّ يَمَرِ، دُفِ قِيشّ نُ رَفٌرٌشِ نَشَن مَ، عَ شَ تّ وٌلٍيٍ تٌنفٌ سٍ دِفِلِنشِيٍ تَفِ مَلٍكّيٍ بُن مَ، عَ نَشَ سٌ، عَ سَ تِ نَا. <verse eid="EZK 10:6"/><verse number="7" style="v" sid="EZK 10:7"/>نَ مَلٍكّ كٍرٍن نَشَ تّ وٌلٍ ندٍيٍ كْ، عَ عَ سَ نَ شّمّ بّلّشّ عِ. نَ نَشَ عَ رَ سُشُ، عَ مِنِ. <verse eid="EZK 10:7"/><verse number="8" style="v" sid="EZK 10:8"/>مِشِ بّلّشّ مَنِيّ نَن نُ مِنِمَ نَ مَلٍكّيٍ فَبُتٍنيِيٍ بُن مَ.<verse eid="EZK 10:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 10:9"/>ﭑ نَشَ سَنيِ رَدِفِلِنشِ نَانِ تٌ مَلٍكّيٍ قّ مَ، كٍرٍن كٍرٍن نُ نَ كَنكَن بُن مَ. عٍ نُ مَيَنبَمَ عَلْ دِيَمَن مَنِيّ. <verse eid="EZK 10:9"/><verse number="10" style="v" sid="EZK 10:10"/>نَ سَنيِ رَدِفِلِنشِ نَانِ بِرِن نُ مَنِيَ، كَنكَن لُشِ عَلْ عَ نُ نَ سَنيِ رَدِفِلِنشِ فبّتّ نَن كُي. <verse eid="EZK 10:10"/><verse number="11" style="v" sid="EZK 10:11"/>عٍ نّ سِفَمَ، مَلٍكّ يَتَفِ نُ تِشِ دّننَشّ رَ عٍ نُ عٍ حّرّ مَ مّننِ بِرِ نّ، هَلِ نَ سَنيِ تٌ نُ عَ مَقِندِ مَ. <verse eid="EZK 10:11"/><verse number="12" style="v" sid="EZK 10:12"/>يَيٍ نُ نَ نَ مَلٍكّ نَانِيٍ بِرِن قَتٍيٍ مَ، عَ نُن عٍ قَرِيٍ مَ، عٍ بّلّشّيٍ مَ، عٍ فَبُتٍنيِيٍ مَ، نُن عٍ سَنيِ رَدِفِلِنشِ نَانِيٍ مَ <verse eid="EZK 10:12"/><verse number="13" style="v" sid="EZK 10:13"/>ﭑ نَشَ عَ مّ، عٍ نَ سَنيِ رَدِفِلِنشِيٍ شِلِمَ «سَنيِ قِرِ قِرِ.» <verse eid="EZK 10:13"/><verse number="14" style="v" sid="EZK 10:14"/>يَتَفِ نَانِ نَن نُ نَ نَ مَلٍكّيٍ بِرِن بّ. كٍرٍن نُ لُشِ نّ عَلْ مَلٍكّ يَتَفِ، عَ قِرِن ندٍ نُ لُشِ نّ عَلْ مِشِ يَتَفِ، عَ سَشَن ندٍ نُ لُشِ نّ عَلْ يّتّ يَتَفِ، عَ نَانِ ندٍ نُ لُشِ نّ عَلْ سّفّ يَتَفِ.<verse eid="EZK 10:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 10:15"/>نَ تّمُي نَ مَلٍكّيٍ نَشَ كٍلِ. عٍ نُ مَنِيَشِ نَ دَالِسٍيٍ نَن نَ ﭑ نُ بَرَ نَشٍيٍ تٌ كٍبَرَ شُرٍ دّ رَ. <verse eid="EZK 10:15"/><verse number="16" style="v" sid="EZK 10:16"/>نَ مَلٍكّيٍ نّ عٍ حّرّ مَ، عٍ نُن نَ سَنيِ رَدِفِلِنشِيٍ نَن عَ رَ. عٍ نَ عٍ فَبُتٍنيِيٍ عِتَلَ عٍ شَ كٍلِ، عٍ نُن نَ سَنيِيٍ نَن عَ رَ. <verse eid="EZK 10:16"/><verse number="17" style="v" sid="EZK 10:17"/>عٍ نَ تِ، عٍ نُن عٍ سَنيِيٍ نَن عَ رَ، عٍ نَ تٍ، عٍ نُن عٍ سَنيِيٍ نَن عَ رَ، بَرِ مَ نَ دَالِسٍيٍ نِي نُ نَ عٍ سَنيِ رَدِفِلِنشِيٍ نَن كُي.<verse eid="EZK 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 10:18"/>نَ تّمُي عَلَتَلَ شَ نْرّ نَشَ كٍلِ هْرْ مْبَنشِ سٌدٍ دّ رَ، عَ سَ عَ مَفٌرٌ نَ مَلٍكّيٍ شُن مَ. <verse eid="EZK 10:18"/><verse number="19" style="v" sid="EZK 10:19"/>عٍ نَشَ عٍ فَبُتٍنيِيٍ عِتَلَ، عٍ كٍلِ بْشِ مَ ﭑ يَ شْرِ عٍ نُن عٍ سَنيِ رَدِفِلِنشِيٍ رَ. عٍ نَشَ عٍ سَ تِ عَلَتَلَ شَ هْرْ مْبَنشِ دّ رَ سٌفٍتٍدٍ بِرِ رَ. عِسِرَيِلَ مَرِفِ عَلَ شَ نْرّ نُ نَ عٍ شُن مَ.<verse eid="EZK 10:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 10:20"/>عَ رَحْنيِ ﭑ نَشَ عَ كٌلٌن ﭑ نَ دَالِسٍ نَانِ ﭑ نَشٍيٍ تٌشِ كٍبَرَ شُرٍ دّ رَ، عٍ نُ مَنِيَشِ مَلٍكّيٍ نَن نَ. <verse eid="EZK 10:20"/><verse number="21" style="v" sid="EZK 10:21"/>يَتَفِ نَانِ نُن فَبُتٍنيِ نَانِ نُ نَ عٍ بِرِن مَ. بّلّشّيٍ قَن نُ نَ عٍ فَبُتٍنيِيٍ بُن مَ. <verse eid="EZK 10:21"/><verse number="22" style="v" sid="EZK 10:22"/>عٍ يَتَفِيٍ نُ مَنِيَشِ يَتَفِيٍ نَن نَ ﭑ نَشٍيٍ تٌ كٍبَرَ شُرٍ دّ رَ. عٍ بِرِن نُ سِفَمَ يَرٍ نَن تُن.<verse eid="EZK 10:22"/></para>
  <chapter eid="EZK 10"/>
  <chapter number="11" style="c" sid="EZK 11"/>
  <para style="s">دَرِ سَلَمُ شَ حَشَنكَتّ نُن عِسِرَيِلَ شَ بْحّ مَسَرّ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 11:1"/>نَ تّمُي عَلَ شَشِلِ سّنِيّنشِ نَشَ ﭑ تٌنفٌ مّننِ، عَ ﭑ شَنِن عَلَتَلَ شَ هْرْ مْبَنشِ نَادّ رَ، نَشَن نَ سٌفٍتٍدٍ بِرِ رَ. شّمّ مْشْحّن نُن سُولِ نُ نَ مّننِ. حَمَ كُنتِفِيٍ عَسُرُ شَ دِ يَاسَنِيَ نُن بّنَيَ شَ دِ ثّلَتَيَ قَن نُ نَ عٍ يَ مَ. <verse eid="EZK 11:1"/><verse number="2" style="v" sid="EZK 11:2"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، «عَدَ مَدِ، يِ مِشِيٍ نَ قٍ حَاشِ كُي. عٍ وَ مَ حَمَ رَتَنتَنقٍ عٍ شَ مَرَ سِ رَ. <verse eid="EZK 11:2"/><verse number="3" style="v" sid="EZK 11:3"/>عٍ نَشّ، ‹هَلِ وٌن مُ بَنشِ تِ، بَرِ مَ يِ تَا لُشِ نّ عَلْ تُندٍ وٌن حِنمَ نَشَن كُي.› <verse eid="EZK 11:3"/><verse number="4" style="v" sid="EZK 11:4"/>نَ كُي عِ تَن عَدَ مَدِ، عِ شَ ﭑ مَ وْيّنيِ رَدَنفِ عٍ مَ.»<verse eid="EZK 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 11:5"/>نَ تّمُي عَلَتَلَ شَشِلِ سّنِيّنشِ نَشَ فٌرٌ ﭑ مَ، عَ يِ مَسٍنيِ تِ ﭑ بّ ﭑ شَ عَ رَدَنفِ عٍ مَ، «عَلَتَلَ شَ مَسٍنيِ نَن يَ؛ وٌ تَن عِسِرَيِلَ بْنسْي، ﭑ وٌ شَ مَحْشُنيِ كٌلٌن. <verse eid="EZK 11:5"/><verse number="6" style="v" sid="EZK 11:6"/>وٌ بَرَ مِشِ فبٍفبٍ قَشَ يِ تَا كُي، وٌ بَرَ عٍ بِنبِيٍ لُ كِرَ رَ. <verse eid="EZK 11:6"/><verse number="7" style="v" sid="EZK 11:7"/>نَ كُي ﭑ تَن، وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛ وٌ بِنبِيٍ نَشٍيٍ وٌلِشِ كِرَ رَ، عٍ قِندِشِ سُبٍيٍ نَن نَ نَشَن قَمَ فَندٍ يِ تُندٍ كُي، كْنْ ﭑ وٌ تَن كٍرِ مَ نّ. <verse eid="EZK 11:7"/><verse number="8" style="v" sid="EZK 11:8"/>وٌ تٌ فَاشُشِ فٍرٍ يَ رَ، ﭑ فٍرٍ رَقَمَ نّ وٌ مَ! ﭑ تَن عَلَتَلَ شُي نَن يَ. <verse eid="EZK 11:8"/><verse number="9" style="v" sid="EZK 11:9"/>ﭑ وٌ رَ مِنِمَ نّ تَا كُي، ﭑ وٌ سَ سِ فبّتّ سَفٌي. نَ نَن قِندِ مَ وٌ شَ حَشَنكَتّ رَ. <verse eid="EZK 11:9"/><verse number="10" style="v" sid="EZK 11:10"/>وٌ قَشَمَ فٍرٍ نَن كُي عِسِرَيِلَ نَانِنيِ رَ. نَ كُي وٌ عَ كٌلٌنمَ نّ عَ ﭑ تَن نَن نَ عَلَتَلَ رَ. <verse eid="EZK 11:10"/><verse number="11" style="v" sid="EZK 11:11"/>يِ تَا مُ قِندِ مَ وٌ بّ تُندٍ رَ، وٌ تَن مُ قِندِ مَ سُبٍ رَ نَشَن فَنمَ بٍ تَا كُي. ﭑ وٌ تَن مَكِيتِمَ عِسِرَيِلَ نَانِنيِ نَن نَ. <verse eid="EZK 11:11"/><verse number="12" style="v" sid="EZK 11:12"/>وٌ عَ كٌلٌنمَ نّ عَ ﭑ تَن نَن نَ عَلَتَلَ رَ، وٌ تٌندِ بِرَدٍ نَشَن شَ يَامَرِيٍ قْشْ رَ. وٌ بَرَ ﭑ مَ سّرِيّ رَبٌلٌ، وٌ بِرَ سِ فبّتّيٍ شَ سّرِيّ قْشْ رَ.»<verse eid="EZK 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 11:13"/>ﭑ تٌ فّ نَ مَسٍنيِ قَلَدٍ، بّنَيَ شَ دِ ثّلَتَيَ نَشَ قَشَ. ﭑ نَشَ ﭑ يَتَفِ رَقٍلٍن بْشِ مَ كٍرٍن نَ، ﭑ قَ عَ قَلَ ﭑ شُي عِتٍشِ رَ، «ﭑ مَرِفِ عَلَتَلَ، عِ وَ مَ عِسِرَيِلَ مِشِ دْنشْي بِرِن سْنتْقٍ نّ؟» <verse eid="EZK 11:13"/><verse number="14" style="v" sid="EZK 11:14"/>عَلَتَلَ نَشَ ﭑ يَابِ، <verse eid="EZK 11:14"/><verse number="15" style="v" sid="EZK 11:15"/>«عَدَ مَدِ، دَرِ سَلَمُكَيٍ نَ عَ قَلَقٍ عِ بَرِبٌورٍيٍ نُن عِسِرَيِلَ بْنسْي بِرِن بّ عٍ شَ عٍ مَكُيَ عَلَتَلَ رَ، بَرِ مَ عٍ نَشّ يِ بْشِ قِندِشِ عٍ فبٍ نَن نَ. <verse eid="EZK 11:15"/><verse number="16" style="v" sid="EZK 11:16"/>نَ كُي عِ شَ عَ قَلَ عٍ بّ، ‹عَلَتَلَ شَ مَسٍنيِ نَن يَ. هَلِ ﭑ عٍ مَكُيَ، ﭑ عٍ شَنِن حَمَنّيٍ مَ، ﭑ لُمَ نّ عٍ سّيتِ مَ مّننِ قَن.›»<verse eid="EZK 11:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 11:17"/>«عِ شَ يِ مَسٍنيِ تِ؛ ‹وٌ مَرِفِ عَلَتَلَ شَ مَسٍنيِ نَن يَ. ﭑ وٌ مَلَنمَ نّ كٍلِقٍ حَمَنّيٍ تَفِ وٌ يٍنسٍنشِ دّننَشّ، ﭑ مَن عِسِرَيِلَ بْشِ سٌ وٌ يِ رَ.›»<verse eid="EZK 11:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 11:18"/>«عٍ فبِلٍنمَ نّ عٍ شَ بْشِ مَ، عٍ قَ كُيٍ حَاشِيٍ بِرِن بَ نَا. <verse eid="EZK 11:18"/><verse number="19" style="v" sid="EZK 11:19"/>ﭑ عٍ بْحّ قِندِ مَ بْحّ كٍرٍن نَن نَ. ﭑ شَشِلِ نّينّ سٌ عٍ يِ رَ. ﭑ عٍ شَ بْحّ شْرْشْي بَمَ نّ، ﭑ بْحّ قَنيِ سٌ عٍ يِ رَ، <verse eid="EZK 11:19"/><verse number="20" style="v" sid="EZK 11:20"/>عَلَكٌ عٍ شَ بِرَ ﭑ مَ يَامَرِيٍ قْشْ رَ، عٍ شَ ﭑ مَ سّرِيّ بِنيَ. عٍ قِندِ مَ ﭑ مَ حَمَ نَن نَ قَ، ﭑ تَن قِندِ عٍ مَرِفِ عَلَ رَ. <verse eid="EZK 11:20"/><verse number="21" style="v" sid="EZK 11:21"/>كْنْ مِشِ نَشٍيٍ بِرَ مَ عٍ شَ كُيٍ بَتُقٍ قْشْ رَ، ﭑ عٍ شَ وَلِ حَاشِ سَرٍ رَفبِلٍنمَ نّ عٍ مَ. عَلَتَلَ شُي نَن نَ كِ.»<verse eid="EZK 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 11:22"/>نَ تّمُي نَ مَلٍكّيٍ نَشَ عٍ فَبُتٍنيِيٍ عِتَلَ نُن عٍ سَنيِ رَدِفِلِنشِيٍ، عِسِرَيِلَ مَرِفِ عَلَتَلَ شَ نْرّ نُ نَ عٍ شُن مَ. <verse eid="EZK 11:22"/><verse number="23" style="v" sid="EZK 11:23"/>عَلَتَلَ شَ نْرّ نَشَ كٍلِ تَا كُي، عَ سَ عَ مَفٌرٌ فٍيَ قَرِ نَشَن نُ نَ سٌفٍتٍدٍ. <verse eid="EZK 11:23"/><verse number="24" style="v" sid="EZK 11:24"/>نَ لَامَتُنيِ كُي، عَلَ شَشِلِ سّنِيّنشِ نَشَ ﭑ تٌنفٌ مّننِ، عَ ﭑ شَنِن عِسِرَيِلَ بْنسْي يِرٍ نَشَن نُ نَ كٌنيِيَ كُي كَلِدٍ بْشِ مَ. لَامَتُنيِ تٌ حْن، <verse eid="EZK 11:24"/><verse number="25" style="v" sid="EZK 11:25"/>ﭑ نَشَ عَلَتَلَ شَ مَسٍنيِ بِرِن نَدَنفِ عٍ مَ، عَ نَشٍيٍ مَسٍن ﭑ بّ.<verse eid="EZK 11:25"/></para>
  <chapter eid="EZK 11"/>
  <chapter number="12" style="c" sid="EZK 12"/>
  <para style="s">تَالِ كٌنيِيَ شَ قٍ رَ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 12:1"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، عَ نَشّ، <verse eid="EZK 12:1"/><verse number="2" style="v" sid="EZK 12:2"/>«عَدَ مَدِ، عِ نَ بْنسْي مُرُتَشِ نَن تَفِ يِ كِ. عٍ يَ نَ نَ، كْنْ عٍ مُ سٍ تٌمَ. عٍ تُلِ نَ نَ، كْنْ عٍ مُ قٍ مّمَ، بَرِ مَ بْنسْي مُرُتّلَ نَن عٍ رَ. <verse eid="EZK 12:2"/><verse number="3" style="v" sid="EZK 12:3"/>عَدَ مَدِ، عِ نَشَن نَبَمَ، عِ شَ كٌتٍ يَءِلَن عَلْ عِ نَ سِفَقٍ كٌنيِيَ نَن كُي. عِ شَ مِنِ عٍ يَ شْرِ يَنيِ شَرٍ رَ عَلْ مِشِ سُشُشِ نَشَن شَنِنقٍ حَمَنّ مَ. نَ كُي، هَلِ عٍ قِندِشِ بْنسْي مُرُتَشِ نَن نَ، عٍ قَمَ نّ قَهَامُي سْتْدٍ عِ شَ تَالِ كُي. <verse eid="EZK 12:3"/><verse number="4" style="v" sid="EZK 12:4"/>عِ شَ عِ شَ كٌتٍ يَءِلَن يَنيِ رَ عٍ يَ شْرِ. نُنمَرٍ تّمُي عِ شَ مِنِ تَا كُي عٍ يَ شْرِ عَلْ عِ نَ سِفَقٍ كٌنيِيَ نَن كُي حَمَنّ مَ. <verse eid="EZK 12:4"/><verse number="5" style="v" sid="EZK 12:5"/>عِ شَ يَلٍ تِ تَا تّتّ مَ عٍ يَ شْرِ، عِ قَ مِنِ نَ كُي عَ نُن عِ شَ كٌتٍ. <verse eid="EZK 12:5"/><verse number="6" style="v" sid="EZK 12:6"/>عِ شَ عِ شَ كٌتٍ دْشْ عِ تُنكِ مَ عٍ يَ شْرِ، عِ مِنِ نُنمَرٍ تّمُي. عِ شَ عِ يَتَفِ مَكٌتٌ عَلَكٌ عِ نَشَ نْ بْشِ تٌدٍ. نَ بِرِن بَرَ قِندِ تْنشُمَ رَ عِسِرَيِلَ بْنسْي بّ.»<verse eid="EZK 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 12:7"/>ﭑ نَشَ نَ رَبَ عَلْ عَلَ عَ مَسٍن ﭑ بّ كِ نَشّ. ﭑ نَشَ ﭑ مَ كٌتٍ يَءِلَن يَنيِ شَرٍ رَ. نُنمَرٍ رَ، ﭑ نَشَ يَلٍ تِ تَا تّتّ مَ ﭑ بّلّشّ رَ، ﭑ قَ مِنِ ﭑ مَ كٌتٍ رَ عٍ يَ شْرِ. <verse eid="EZK 12:7"/><verse number="8" style="v" sid="EZK 12:8"/>نَ كُيٍ عِبَ، عَلَتَلَ نَشَ ﭑ مَشْرِن، <verse eid="EZK 12:8"/><verse number="9" style="v" sid="EZK 12:9"/>«عَدَ مَدِ، يِ بْنسْي مُرُتَشِ مُ عِ مَشْرِن نُ، عِ نَ قٍ نَشَن نَبَقٍ؟ <verse eid="EZK 12:9"/><verse number="10" style="v" sid="EZK 12:10"/>عَ قَلَ عٍ بّ، ‹عَلَتَلَ يِ نَن مَسٍنشِ؛ يِ كِيتِ سَشِ دَرِ سَلَمُ مَنفّيٍ نُن عِسِرَيِلَ بْنسْي نَن بِرِن مَ نَشٍيٍ سَبَتِشِ بٍ.› <verse eid="EZK 12:10"/><verse number="11" style="v" sid="EZK 12:11"/>عَ قَلَ عٍ بّ، ‹ﭑ تَن قِندِشِ وٌ بّ تْنشُمَ نَن نَ. ﭑ نَشَن نَبَشِ نَ كِ، نَ نَن قَمَ رَبَدٍ وٌ قَن نَ. عٍ وٌ سُشُمَ نّ، عٍ وٌ شَنِن كٌنيِيَ كُي حَمَنّ مَ.›»<verse eid="EZK 12:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 12:12"/>«مَنفّ نَشَن نَ عٍ شُن مَ، عَ عَ شَ كٌتٍ دْشْمَ عَ تُنكِ نَن مَ نُنمَرٍ تّمُي، عَ عَ فِ. عٍ يَلٍ تِمَ نّ تَا تّتّ مَ عَلَكٌ عَ شَ مِنِ نَ رَ. عَ عَ يَتَفِ مَكٌتٌمَ نّ عَلَكٌ عَ نَشَ بْشِ تٌ. <verse eid="EZK 12:12"/><verse number="13" style="v" sid="EZK 12:13"/>ﭑ نَ ﭑ مَ يّلّ عِتَلَمَ نّ عَ شُن مَ، ﭑ مَ فَنتَنيِ عَ سُشُ. ﭑ عَ شَنِنمَ نّ بَبِلْن، كَلِدِ بْنسْي شَ بْشِ مَ، كْنْ عَ مُ مّننِ تٌمَ عَ يَ رَ. عَ قَشَمَ نَا. <verse eid="EZK 12:13"/><verse number="14" style="v" sid="EZK 12:14"/>ﭑ قَمَ نّ عَ شَ مِشِ بِرِن نَيٍنسٍندٍ، عَ شَ كُنتِفِيٍ نُن عَ شَ سْورِيٍ. ﭑ عٍ بِرِن نَكٍرِ مَ نّ سَنتِدّفّمَ رَ.»<verse eid="EZK 12:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 12:15"/>«ﭑ نَ عٍ كٍرِ حَمَنّيٍ مَ دُنِحَ يِرٍ بِرِن، عٍ عَ كٌلٌنمَ نّ نَ كُي عَ ﭑ تَن نَن نَ عَلَتَلَ رَ. <verse eid="EZK 12:15"/><verse number="16" style="v" sid="EZK 12:16"/>كْنْ ﭑ مِشِ ندٍيٍ رَتَنفَمَ نّ عٍ يَ مَ فٍرٍ كُي، ﭑ عٍ رَتَنفَ كَامّ نُن وُفَنيِ مَ، عَلَكٌ عٍ شَ نْ عٍ شَ وَلِ كٌبِيٍ مَتَالِدٍ سِ فبّتّيٍ بّ عٍ نَ لُ دّننَشّ. عٍ عَ كٌلٌنمَ نّ عَ ﭑ تَن نَن نَ عَلَتَلَ رَ.»<verse eid="EZK 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 12:17"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، عَ نَشّ، <verse eid="EZK 12:17"/><verse number="18" style="v" sid="EZK 12:18"/>«عَدَ مَدِ، عِ نّ عِ دّفٍمَ تّمُي نَشّ، عِ شَ سّرّن فَاشُي رَ. عِ نّ يٍ مِنمَ تّمُي نَشّ، عِ عِمَشَ كْنتْقِلِ رَ. <verse eid="EZK 12:18"/><verse number="19" style="v" sid="EZK 12:19"/>عَ قَلَ حَمَ بّ، ‹وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ دَرِ سَلَمُكَيٍ نُن عِسِرَيِلَكَيٍ شَ قٍ رَ. عَ نَشّ عٍ عٍ دّفٍمَ فَاشُي نَن كُي، عٍ يٍ مِن كْنتْقِلِ رَ، بَرِ مَ فبَلٌي حَاشِ عَ نِيَمَ نّ هَرِفٍ بِرِن بَ عٍ شَ بْشِ مَ. <verse eid="EZK 12:19"/><verse number="20" style="v" sid="EZK 12:20"/>تَايٍ كَنَمَ نّ، بْشِ شَرَ. نَ كُي وٌ عَ كٌلٌنمَ نّ عَ ﭑ تَن نَن نَ عَلَتَلَ رَ.›»<verse eid="EZK 12:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 12:21"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، عَ نَشّ، <verse eid="EZK 12:21"/><verse number="22" style="v" sid="EZK 12:22"/>«عَدَ مَدِ، مُنسٍ نَ يِ تَالِ وْيّنيِ رَ، نَشَن نَ قَلَقٍ وٌ تَفِ عِسِرَيِلَ بْشِ مَ؟ نَ تَالِ نَشّ، ‹لْشْييٍ نَ عٍ عِكُيَقٍ دٍ، كْنْ عَلَتَلَ شَ لَامَتُنيِ مُ كَمَلِشِ قٍقٍ مَ.› <verse eid="EZK 12:22"/><verse number="23" style="v" sid="EZK 12:23"/>عَ قَلَ عٍ بّ، ‹عَلَتَلَ يِ نَن مَسٍنشِ؛ ﭑ قَمَ نّ نَ تَالِ وْيّنيِ عِقَلّ دَندٍ. مِشِ يٌ مُ نَ قَلَمَ سْنْن عِسِرَيِلَ بْشِ مَ.› عَ قَلَ عٍ بّ، ‹عَ فبٍ مُ لُشِ لَامَتُنيِ بِرِن شَ كَمَلِ. <verse eid="EZK 12:23"/><verse number="24" style="v" sid="EZK 12:24"/>وُلٍ لَامَتُنيِ نُن وُلٍ مَسٍنيِ حْنمَ نّ سٍمَتٌي يِ رَ عِسِرَيِلَ بْنسْي يَ مَ. <verse eid="EZK 12:24"/><verse number="25" style="v" sid="EZK 12:25"/>كْنْ ﭑ تَن عَلَتَلَ نَ نَشَن مَسٍن، نَ كَمَلِمَ نّ عَ وَشَتِ مَ. ﭑ قَمَ ﭑ مَ مَسٍنيِ رَكَمَلِدٍ وٌ تَن مُرُتّلَيٍ نَن بّ. عَلَتَلَ شُي نَن نَ كِ.›»<verse eid="EZK 12:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="EZK 12:26"/>عَلَتَلَ نَشَ عَ مَسٍن بّ، عَ نَشّ، <verse eid="EZK 12:26"/><verse number="27" style="v" sid="EZK 12:27"/>«عَدَ مَدِ، عِسِرَيِلَ بْنسْي لُمَ نّ عَ قَلَ رَ عِ شَ لَامَتُنيِ قٍ مَسٍن نَشَن بُمَ عَ قَ رَبَ. عَ نَشّ نَمِحْنمّ شَ مَسٍنيِ مُ كَمَلِمَ قٌ حّ وُيَشِ نَ دَنفِ. <verse eid="EZK 12:27"/><verse number="28" style="v" sid="EZK 12:28"/>نَ كُي، عَ قَلَ عٍ بّ، ‹عَلَتَلَ يِ نَن مَسٍنشِ؛ ﭑ مُ دُفُندِ مَ ﭑ مَ مَسٍنيِ رَكَمَلِدٍ سْنْن. ﭑ نَشَن مَسٍنشِ، نَ قَمَ نّ رَبَدٍ. عَلَتَلَ شُي نَن نَ كِ.›»<verse eid="EZK 12:28"/></para>
  <chapter eid="EZK 12"/>
  <chapter number="13" style="c" sid="EZK 13"/>
  <para style="s">سٍمَتٌي وُلٍ قَلّيٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 13:1"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، عَ نَشّ، <verse eid="EZK 13:1"/><verse number="2" style="v" sid="EZK 13:2"/>«عَدَ مَدِ، عِ شَ مَسٍنيِ تِ ﭑ شِلِ رَ عِسِرَيِلَ نَمِحْنمّيٍ بّ. عَ قَلَ عٍ بّ، نَشٍيٍ مَسٍنيِ تِمَ عٍ يّتّ بْحّ مَ قٍ مَ، عِ نَشّ، ‹وٌ وٌ تُلِ مَتِ عَلَتَلَ شَ مَسٍنيِ رَ! <verse eid="EZK 13:2"/><verse number="3" style="v" sid="EZK 13:3"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛ حَشَنكَتّ نَ نَمِحْنمّ وُلٍ قَلّيٍ بّ، نَشٍيٍ بِرَ مَ عٍ يّتّ شَشِلِ قْشْ رَ، عٍ مُ لَامَتُنيِ يٌ تٌشِ. <verse eid="EZK 13:3"/><verse number="4" style="v" sid="EZK 13:4"/>عِسِرَيِلَ، وٌ شَ نَمِحْنمّ وُلٍ قَلّيٍ لُمَ نّ عَلْ شُلُمَسٍيٍ بَنشِ كَنَشِ كُي. <verse eid="EZK 13:4"/><verse number="5" style="v" sid="EZK 13:5"/>وٌ مُ عِسِرَيِلَ شَ تّتّ يَءِلَنشِ عَلَكٌ عَ شَ تِ فٍرٍ كُي عَلَتَلَ شَ لْشْي. <verse eid="EZK 13:5"/><verse number="6" style="v" sid="EZK 13:6"/>عٍ شَ لَامَتُنيِيٍ قِندِشِ وُلٍ نَن نَ. عٍ شَ مَسٍنيِ مُ قِندِشِ نْندِ رَ قٍقٍ مَ. عٍ نَشّ، عَلَتَلَ شُي نَن نَ كِ، عَ قَ لِ عَلَتَلَ شَ مُ عٍ شّيشِ. عٍ وَ مَ نَ شَ كَمَلِ تُن. <verse eid="EZK 13:6"/><verse number="7" style="v" sid="EZK 13:7"/>قُ شَ مُ نَ وٌ شَ لَامَتُنيِيٍ نُن وٌ شَ مَسٍنيِيٍ رَ؟ وٌ عَ قَلَمَ، عَلَ شُي نَن نَ كِ، عَ قَ لِ ﭑ تَن عَلَ شَ شُي مُ عَ رَ!›»<verse eid="EZK 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 13:8"/>«وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ وٌ شَ قٍ رَ، عَ نَشّ؛ ‹ﭑ بَرَ كٍلِ وٌ شِلِ مَ وٌ شَ وُلٍ مَسٍنيِيٍ نُن وٌ شَ وُلٍ لَامَتُنيِيٍ شَ قٍ رَ. عَلَتَلَ شُي نَن نَ كِ. <verse eid="EZK 13:8"/><verse number="9" style="v" sid="EZK 13:9"/>ﭑ نَ ﭑ بّلّشّ عِتَلَمَ نّ نَمِحْنمّ وُلٍ قَلّيٍ بّ، نَشٍيٍ وُلٍ لَامَتُنيِيٍ نُن وُلٍ مَسٍنيِيٍ شَ قٍ قَلَمَ. عٍ مُ لُمَ ﭑ مَ حَمَ كُنتِفِيٍ يَ مَ، عٍ شِلِ بَمَ نّ عِسِرَيِلَ شَ تَرُشُي كُي، عٍ مُ سٌمَ عِسِرَيِلَ بْشِ مَ سْنْن. نَ كُي وٌ عَ كٌلٌنمَ نّ عَ ﭑ تَن نَن نَ عَلَتَلَ رَ.›»<verse eid="EZK 13:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 13:10"/>«عٍ تٌ قَ نَ ﭑ مَ حَمَ رَلْيقٍ نّ نَ كِ عَ قَلَقٍ رَ، ‹وٌ بْحّ شَ سَ،› كْنْ عَ قَ لِ فبَلٌي نَ نَ. عٍ تّتّ كٌبِ نَن تِ، عٍ قَ عَ ثّنتِ عَ قِيشّ رَ. <verse eid="EZK 13:10"/><verse number="11" style="v" sid="EZK 13:11"/>عَ قَلَ عٍ بّ نَ تّتّ بِرَ مَ نّ. تُرُننَادّ نُن تُنّ شُنفبٍ نَ قَ، بَلَبَلَنيِ فٌرٌ مَ نّ. <verse eid="EZK 13:11"/><verse number="12" style="v" sid="EZK 13:12"/>نَ تّتّ نَ بِرَ، عَ مُ قَلَمَ شّ وٌ بّ، ‹وٌ مُ عَ ثّنتِشِ شّ؟ مُنسٍ قَ نِيَشِ؟›»<verse eid="EZK 13:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 13:13"/>«وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛ ‹ﭑ تُرُننَادّ شُنفبٍ رَدِنمَ نّ وٌ مَ ﭑ مَ شْنّ كُي، تُنّ بٍلٍبٍلٍ نُن بَلَبَلَنيِ سِنمَ نّ وٌ مَ سّنبّ رَ، عَ كَسَرّ تِ. <verse eid="EZK 13:13"/><verse number="14" style="v" sid="EZK 13:14"/>ﭑ تّتّ رَبِرَ مَ نّ، وٌ نَشَن ثّنتِشِ، ﭑ عَ سَنبُنيِ مَبَ. عَ نَ بِرَ وٌ مَ، وٌ قَشَ عَ بُن مَ. نَ تّمُي، وٌ عَ كٌلٌنمَ نّ عَ ﭑ تَن نَن نَ عَلَتَلَ رَ. <verse eid="EZK 13:14"/><verse number="15" style="v" sid="EZK 13:15"/>ﭑ نَ ﭑ مَ شْنّ بِرِن نَمِنِمَ نّ نَ تّتّ مَ، نُن مِشِ نَشٍيٍ عَ ثّنتِشِ. ﭑ عَ قَلَمَ نّ وٌ بّ، تّتّ مُ نَ سْنْن، نَشٍيٍ قَن عَ ثّنتِشِ، نٍيٍ قَن مُ نَ سْنْن. <verse eid="EZK 13:15"/><verse number="16" style="v" sid="EZK 13:16"/>نٍيٍ قِندِشِ نَ نَمِحْنمّ وُلٍ قَلّيٍ نَن نَ، نَشٍيٍ نُ وْيّنمَ دَرِ سَلَمُ شَ قٍ رَ، عَ بْحّسَ شَ قٍ قَلَ عٍ بّ، عَ قَ لِ فبَلٌي نَن تُن نُ نَ قَقٍ عٍ مَ. عَلَتَلَ شُي نَن نَ كِ.›»<verse eid="EZK 13:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 13:17"/>«يَكْسِ عَدَ مَدِ، عِ يَ رَقِندِ عِ شَ حَمَ شَ فِنّ دِ مّدِيٍ مَ، نَشٍيٍ نَمِحْنمّ مَسٍنيِ تِمَ عٍ يّتّ بْحّ مَ قٍ مَ. عِ شَ مَسٍنيِ تِ عٍ شِلِ مَ، <verse eid="EZK 13:17"/><verse number="18" style="v" sid="EZK 13:18"/>عَ قَلَقٍ رَ، ‹عَلَتَلَ يِ نَن مَسٍنشِ عٍ بّ، «حَشَنكَتّ نَ فِنّيٍ بّ نَشٍيٍ بّلّشّكْننَسٌي يَءِلَنمَ كَرَقِلِ رَ، شَ نَ مُ عَ رَ عٍ مَقٍلٍنيِيٍ يَءِلَن مِشِ رَتَنتَنقٍ رَ. وٌ عَ مَحْشُنشِ نّ عَ وٌ نَ ﭑ مَ مِشِيٍ رَتَنتَن، وٌ مُ تْورّ سْتْمَ نَ كُي؟ <verse eid="EZK 13:18"/><verse number="19" style="v" sid="EZK 13:19"/>وٌ بَرَ ﭑ مَبٍرٍ دٌنسٍ دِ شَ قٍ رَ. وٌ تٌ وُلٍ قَلَ ﭑ مَ حَمَ بّ نَشَن عَ تُلِ مَتِمَ وُلٍ رَ، وٌ بَرَ مِشِ قَشَ نَشَن مُ نُ لَنمَ عَ شَ قَشَ، وٌ بَرَ مِشِ لُ نَا نَشَن مُ نُ لَنمَ عَ شَ لُ نَا.»›»<verse eid="EZK 13:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 13:20"/>«وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛ ‹وٌ شَ كَرَقِلِيٍ مُ رَقَن ﭑ مَ، وٌ مِشِ رَتَنتَنمَ نَشَن نَ عَلْ فَنتَنيِ سَمَ شْنِيٍ بّ كِ نَشّ. ﭑ نَ كَرَقِلِيٍ بَمَ نّ وٌ بّلّشّيٍ رَ، ﭑ شْرّيَ قِمَ نّ مِشِ مَ وٌ نَشَن سُشُ فَنتَنيِ كُي عَلْ شْنِيٍ. <verse eid="EZK 13:20"/><verse number="21" style="v" sid="EZK 13:21"/>ﭑ وٌ شَ مَقٍلٍنيِيٍ بَمَ نّ وٌ مَ، ﭑ نَ ﭑ مَ حَمَ بَ وٌ شَ نْي بُن مَ. نَ كُي وٌ عَ كٌلٌنمَ نّ عَ ﭑ تَن نَن نَ عَلَتَلَ رَ. <verse eid="EZK 13:21"/><verse number="22" style="v" sid="EZK 13:22"/>وٌ بَرَ لِمَنِيَ بَ تِنشِنتْييٍ يِ رَ وٌ شَ وُلٍيٍ رَ، ﭑ نُ وَ مَ نَشَن مَلِقٍ. وٌ بَرَ تِنشِنتَرٍ رَ سِ عٍ شَ لُ عٍ شَ قٍ حَاشِيٍ كُي، ﭑ نُ وَ مَ نَشَن نَكِسِقٍ. <verse eid="EZK 13:22"/><verse number="23" style="v" sid="EZK 13:23"/>وٌ تٌ نَ مْولِ رَبَ، وٌ مُ وُلٍ مَسٍنيِ تِقٍ سْنْن، وٌ مُ لُمَ سٍمَتٌي شَ وَلِ كُي. ﭑ قَمَ نّ ﭑ مَ حَمَ رَتَنفَدٍ وٌ بّلّشّ. نَ كُي وٌ عَ كٌلٌنمَ نّ عَ ﭑ تَن نَن نَ عَلَتَلَ رَ.›»<verse eid="EZK 13:23"/></para>
  <chapter eid="EZK 13"/>
  <chapter number="14" style="c" sid="EZK 14"/>
  <para style="s">عَلَ شَ كَتّ عِسِرَيِلَ بْحّ رَفبِلٍنقٍ عَ مَ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 14:1"/>عِسِرَيِلَ قٌرِ ندٍيٍ نَشَ قَ ﭑ شْنيِ. عٍ تٌ دْشْ، <verse eid="EZK 14:1"/><verse number="2" style="v" sid="EZK 14:2"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، <verse eid="EZK 14:2"/><verse number="3" style="v" sid="EZK 14:3"/>«عَدَ مَدِ، يِ مِشِيٍ بَرَ كُيٍيٍ قٍ تٌنفٌ عٍ عَ سَ عٍ نِي رَ، عٍ قٍ حَاشِيٍ سُشُ نَشٍيٍ عٍ رَبِرَ مَ. عَ لَنمَ ﭑ شَ تِن عٍ شَ ﭑ مَشَندِ؟ <verse eid="EZK 14:3"/><verse number="4" style="v" sid="EZK 14:4"/>عَ قَلَ عٍ بّ، ‹وٌ مَرِفِ عَلَتَلَ شَ مَسٍنيِ نَن يَ؛ عِسِرَيِلَكَ نَشَن يٌ كُيٍ قٍ سَ عَ نِي رَ، عَ قٍ حَاشِ سُشُ نَشَن عَ رَبِرَ مَ، عَ نَ سِفَ نَمِحْنمّ يِرٍ عَلَ مَشَندِدٍ، ﭑ عَ شَ دُبَ مَقِندِ مَ عَ شَ يُنُبِ رَبَ شَسَبِ نَن مَ. <verse eid="EZK 14:4"/><verse number="5" style="v" sid="EZK 14:5"/>ﭑ يِ رَبَمَ نّ عَلَكٌ ﭑ شَ عِسِرَيِلَ بْنسْي بْحّ رَقِندِ ﭑ مَ، هَلِ عٍ تٌ بَرَ عٍ مَكُيَ ﭑ نَ عٍ شَ كُيٍ بَتُقٍ رَ.›»<verse eid="EZK 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 14:6"/>«عَ قَلَ عِسِرَيِلَ بْنسْي بّ، ‹وٌ مَرِفِ عَلَتَلَ شَ مَسٍنيِ نَن يَ؛ وٌ تُوبِ، وٌ فبِلٍن وٌ شَ كُيٍ بَتُقٍ قْشْ رَ، وٌ وٌ كٌبٍ سٌ وٌ شَ قٍ حَاشِيٍ رَ! <verse eid="EZK 14:6"/><verse number="7" style="v" sid="EZK 14:7"/>عِسِرَيِلَكَيٍ بِرِن، شَ نَ مُ عَ رَ وٌ شَ شْحّيٍ، مِشِ يٌ نَشَن كُيٍ قٍ سَمَ عَ نِي رَ، عَ قٍ حَاشِ سُشُ نَشَن عَ رَبِرَ مَ، نَ كَنيِ نَ سِفَ نَمِحْنمّ يِرٍ ﭑ مَشَندِقٍ رَ، ﭑ تَن عَلَتَلَ يَتِ قَمَ نَ كَنيِ يَابِدٍ. <verse eid="EZK 14:7"/><verse number="8" style="v" sid="EZK 14:8"/>ﭑ تِمَ نّ عَ كَنكٍ، ﭑ عَ قِندِ مَ مِسَالِ نَن نَ حَمَ بّ، عَ شِلِ قِندِ كٌنبِ رَ عٍ يَ مَ. ﭑ عَ كٍرِ مَ نّ ﭑ مَ حَمَ يَ مَ. نَ كُي وٌ عَ كٌلٌنمَ نّ عَ ﭑ تَن نَن نَ عَلَتَلَ رَ.›»<verse eid="EZK 14:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 14:9"/>«شَ نَ نَمِحْنمّ قَ تِن مَسٍنيِ قَلَدٍ ﭑ شِلِ رَ، ﭑ تَن يَتِ بَرَ عَ مَدَشُ عَ شَ نَ رَبَ. نَ كُي ﭑ نَ ﭑ بّلّشّ عِتَلَ عَ شِلِ مَ، ﭑ عَ شَ قٍ شُن نَكَنَ ﭑ مَ حَمَ عِسِرَيِلَ يَ مَ. <verse eid="EZK 14:9"/><verse number="10" style="v" sid="EZK 14:10"/>عٍ بَرَ يُنُبِ سْتْ نَ كُي، نَمِحْنمّ يٌ، نُن مِشِ يٌ نَشَن مَشَندِ تِمَ عَ سَابُي رَ. <verse eid="EZK 14:10"/><verse number="11" style="v" sid="EZK 14:11"/>نَ تّمُي عِسِرَيِلَ بْنسْي مُ لُمَ عٍ مَكُيَ رَ ﭑ نَ، عٍ سّنِيّنتَرٍحَ بّحِنمَ نّ. عٍ قِندِ مَ نّ ﭑ مَ حَمَ رَ، ﭑ قَن قِندِ عٍ مَرِفِ عَلَ رَ. عَلَتَلَ شُي نَن نَ كِ.»<verse eid="EZK 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 14:12"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، عَ نَشّ، <verse eid="EZK 14:12"/><verse number="13" style="v" sid="EZK 14:13"/>«عَدَ مَدِ، شَ حَمَ ندٍ ﭑ بّحِن عٍ شَ يُنُبِيٍ شَ قٍ رَ، ﭑ قَمَ نّ ﭑ بّلّشّ عِتَلَدٍ عٍ شِلِ مَ، ﭑ عٍ شَ بَلٌي حْن، ﭑ كَامّ رَدِن عٍ مَ، ﭑ عٍ شَ مِشِيٍ نُن عٍ شَ شُرُ سٍيٍ قَشَ. <verse eid="EZK 14:13"/><verse number="14" style="v" sid="EZK 14:14"/>هَلِ عَننَبِ نُهَ، عَننَبِ دَنِيّلِ، نُن عَننَبِ عَيُبَ نُ نَ عٍ يَ مَ نُ، حَمَ نْمَ كِسِدٍ عٍ شَ تِنشِنيِ فبَنسَن نَن سَابُي رَ. عَلَتَلَ شُي نَن نَ كِ.»<verse eid="EZK 14:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 14:15"/>«شَ ﭑ سُبٍ شَاحّيٍ رَدِن نَ بْشِ مَ عٍ شَ دِ مّيٍ قَشَ، مِشِ بِرِن شَ كٍلِ نَا نَ سُبٍيٍ شَ قٍ رَ، <verse eid="EZK 14:15"/><verse number="16" style="v" sid="EZK 14:16"/>هَلِ نَ نَمِحْنمّ سَشَن سَ لُ نَا، ﭑ تَن وٌ مَرِفِ عَلَتَلَ بَرَ ﭑ كَلِ، حَمَ مُ نْمَ عٍ شَ دِيٍ رَكِسِدٍ. نَ نَمِحْنمّيٍ فبَنسَن نَن كِسِمَ، بْشِكَيٍ تَن لْي.»<verse eid="EZK 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 14:17"/>«شَ ﭑ فٍرٍ رَبُلَ نَ بْشِ مَ، ﭑ قَ عَ قَلَ ‹سَنتِدّفّمَ شَ بٍ كَنَ،› ﭑ قَ عَ نِيَ نَ بْشِكَيٍ نُن عٍ شَ شُرُ سٍيٍ بِرِن شَ سْنتْ، <verse eid="EZK 14:17"/><verse number="18" style="v" sid="EZK 14:18"/>هَلِ نَ نَمِحْنمّ سَشَن سَ لُ نَا، ﭑ تَن وٌ مَرِفِ عَلَتَلَ بَرَ ﭑ كَلِ، حَمَ مُ نْمَ عٍ شَ دِيٍ رَكِسِدٍ. نَ نَمِحْنمّيٍ فبَنسَن نَن كِسِمَ.»<verse eid="EZK 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 14:19"/>«شَ ﭑ وُفَنيِ رَدِن نَ بْشِ مَ عٍ شَ مِشِ بِرِن نُن عٍ شَ شُرُ سٍيٍ قَشَ قٍ رَ ﭑ مَ شْنّ شَ قٍ مَ، <verse eid="EZK 14:19"/><verse number="20" style="v" sid="EZK 14:20"/>هَلِ عَننَبِ نُهَ، عَننَبِ دَنِيّلِ، نُن عَننَبِ عَيُبَ سَ لُ نَا، ﭑ تَن وٌ مَرِفِ عَلَتَلَ بَرَ ﭑ كَلِ، حَمَ مُ نْمَ عٍ شَ دِيٍ رَكِسِدٍ. حَمَ نْمَ كِسِدٍ عٍ شَ تِنشِنيِ فبَنسَن نَن سَابُي رَ.»<verse eid="EZK 14:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 14:21"/>«وٌ مَرِفِ عَلَتَلَ شَ مَسٍنيِ نَن يَ؛ وٌ شَ قٍ شْرْشْمَ نّ دَنفِقٍ نَ تَن نَ ﭑ نَ ﭑ مَ كَسَرّ نَانِ تِ وٌ بّ، نَشٍيٍ قِندِشِ فٍرٍ، كَامّ، سُبٍ شَاحّيٍ، نُن وُفَنيِ رَ. نَ بِرِن وٌ شَ مِشِيٍ نُن وٌ شَ شُرُ سٍيٍ سْنتْمَ نّ. <verse eid="EZK 14:21"/><verse number="22" style="v" sid="EZK 14:22"/>كْنْ وٌ شَ دِ ندٍيٍ قَمَ نّ رَتَنفَدٍ نَ مَ. عٍ قَمَ نّ وٌ يِرٍ، وٌ قَ سّيوَ عٍ حّرّ كِ مَتٌقٍ رَ، وٌ قَ مَدُندُ فبَلٌي شَ قٍ رَ ﭑ نَشَن نَفِرِشِ دَرِ سَلَمُ مَ. <verse eid="EZK 14:22"/><verse number="23" style="v" sid="EZK 14:23"/>وٌ مَدُندُي سْتْمَ نّ عٍ حّرّ كِ مَتٌقٍ رَ، بَرِ مَ وٌ قَمَ نّ عَ كٌلٌندٍ عَ ﭑ نَ بِرِن نَبَ قٍ ندٍ نَن مَ. وٌ مَرِفِ عَلَتَلَ شُي نَن نَ كِ.»<verse eid="EZK 14:23"/></para>
  <chapter eid="EZK 14"/>
  <chapter number="15" style="c" sid="EZK 15"/>
  <para style="s">دَرِ سَلَمُ شَ حَشَنكَتّ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 15:1"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، عَ نَشّ؛ <verse eid="EZK 15:1"/><verse number="2" style="v" sid="EZK 15:2"/>«عَدَ مَدِ، وّنِ بِلِ قَن قْتْنيِ وُرِ سَلٌنيِ بّ؟ <verse eid="EZK 15:2"/><verse number="3" style="v" sid="EZK 15:3"/>وّنِ بِلِ وُرِ رَوَلِمَ عَ شَ قِندِ سٍ فبَكُ سٍ رَ، شَ نَ مُ عَ رَ سٍ فبّتّ نَشَن تِدٍ نَ نَ؟ <verse eid="EZK 15:3"/><verse number="4" style="v" sid="EZK 15:4"/>نَ وُرِ مْولِ نَ فَن، كٍلِ عَ شُنيِ مَ هَن عَ سَ دْشْ عَ شْرّ رَ، عَ نْمَ رَوَلِدٍ سٍ ندٍ رَ قَ؟ <verse eid="EZK 15:4"/><verse number="5" style="v" sid="EZK 15:5"/>شَ عَ مُ نُ نْمَ رَوَلِدٍ سٍ ندٍ رَ عَ تٌ نُ سِشِ، عَ نَ فَن، تِدٍ يٌ مُ لُمَ عَ مَ سْنْن.»<verse eid="EZK 15:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 15:6"/>«نَ كُي، وٌ مَرِفِ عَلَتَلَ شَ مَسٍنيِ نَن يَ؛ ﭑ قٍ رَبَمَ نّ دَرِ سَلَمُكَيٍ رَ، عَلْ ﭑ قٍ نَشَن نَبَ نَ وّنِ بِلِ وُرِ رَ ﭑ نَشَن فَنشِ. <verse eid="EZK 15:6"/><verse number="7" style="v" sid="EZK 15:7"/>ﭑ تِمَ نّ عٍ كَنكٍ. هَلِ عٍ مِنِ تّ عِ، نَ تّ قَنمَ عٍ دٌندٍ. ﭑ نَ تِ عٍ كَنكٍ مَ، وٌ عَ كٌلٌنمَ نّ عَ ﭑ تَن نَن نَ عَلَتَلَ رَ. <verse eid="EZK 15:7"/><verse number="8" style="v" sid="EZK 15:8"/>ﭑ عٍ شَ بْشِ شُن نَكَنَمَ نّ، بَرِ مَ عٍ بَرَ ﭑ يَنقَ. عَلَتَلَ شُي نَن نَ كِ.»<verse eid="EZK 15:8"/></para>
  <chapter eid="EZK 15"/>
  <chapter number="16" style="c" sid="EZK 16"/>
  <para style="s">عِسِرَيِلَ شَ يّنّ عَلَ مَبِرِ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 16:1"/>عَلَتَلَ نَشَ يِ مَسٍنيِ تِ ﭑ بّ، عَ نَشّ؛ <verse eid="EZK 16:1"/><verse number="2" style="v" sid="EZK 16:2"/>«عَدَ مَدِ، دَرِ سَلَمُ رَكٌلٌن عَ شَ قٍ كٌبِيٍ رَ. <verse eid="EZK 16:2"/><verse number="3" style="v" sid="EZK 16:3"/>عَ قَلَ عَ بّ، ‹عِ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛ عِ بَرِشِ كَنَان بْشِ نَن مَ، عَمٌرِكَ نَن نُ نَ عِ بَبَ رَ، عِ نفَ قِندِشِ شِتِكَ نَن نَ. <verse eid="EZK 16:3"/><verse number="4" style="v" sid="EZK 16:4"/>عِ بَرِشِ لْشْي نَشّ، مِشِ يٌ مُ وٌ قُرِشُلِ شَبَ، عٍ مُ عِ مَشَ يٍ نُن قْشّ رَ عَلَكٌ عِ شَ سّنِيّن، عٍ مُ عِ مَقِلِن دُفِ كُي. <verse eid="EZK 16:4"/><verse number="5" style="v" sid="EZK 16:5"/>مِشِ يٌ مُ كِنِكِنِ عِ مَ نَ قٍ مْولِ رَبَقٍ رَ. عٍ عِ وْلِ بُرُنيِ، بَرِ مَ عِ نُ مَحَاشِن بِرِن بّ.›»<verse eid="EZK 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 16:6"/>«ﭑ نُ نَ دَنفِقٍ عِ يِرٍ تّمُي نَشّ، ﭑ نَشَ عِ تٌ عِ نَ عِ نِي مَفَفَقٍ عِ سَشِ وُلِ شْورَ. ﭑ نَشَ عَ قَلَ عِ بّ، ‹عِ شَ كِسِ.› <verse eid="EZK 16:6"/><verse number="7" style="v" sid="EZK 16:7"/>ﭑ نَشَ عِ رَ مْ عَلْ سَنسِ مْمَ كِ نَشّ. عِ بَرَ قِندِ فِنّدِ مّدِ تٌقَنيِ رَ. عِ قَتٍ بَرَ مْ، عِ شُنسّشّ بَرَ كُيَ، كْنْ هَن نَ تّمُي دُفِ مُ نُ رَفٌرٌشِ عِ مَ. عِ مَفٍلِ نَن نُ عَ رَ.»<verse eid="EZK 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 16:8"/>«تّمُي ندٍ تٌ دَنفِ، ﭑ نَشَ عَ تٌ عِ قِندِشِ سُنفبُتُنيِ رَ. نَ كُي ﭑ نَشَ ﭑ مَ دُفِ سَنبُنيِ قٍلٍن عِ مَ عِ سُتُرَقٍ رَ، عَ قِندِ سَاتّ رَ وٌن تَفِ. نَ كُي عِ قِندِشِ ﭑ تَن نَن فبٍ رَ، عِ مَرِفِ عَلَتَلَ.»<verse eid="EZK 16:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 16:9"/>«ﭑ نَشَ عِ مَشَ يٍ رَ، ﭑ وُلِ بَ عِ مَ، ﭑ قَ تُرٍ شِرِ قَنيِ سٌ عِ مَ. <verse eid="EZK 16:9"/><verse number="10" style="v" sid="EZK 16:10"/>ﭑ نَشَ دُفِ قَنيِ دّفّ عِ بّ، ﭑ نَ رَفٌرٌ عِ مَ. ﭑ نَشَن سَنكِرِ قَنيِ سٌ عِ سَنيِ. <verse eid="EZK 16:10"/><verse number="11" style="v" sid="EZK 16:11"/>ﭑ نَشَ عِ رَشُنمَ بّلّشّ رَ سٌي نُن كْنمَفٌرٍ رَ. <verse eid="EZK 16:11"/><verse number="12" style="v" sid="EZK 16:12"/>ﭑ نَشَ شُرُندّ سَ عِ حْي رَ، ﭑ تُلِرَ سٌي سَ عِ تُلِيٍ رَ، ﭑ مَنفّ تْنشُمَ دُ سُ عِ شُن نَ. <verse eid="EZK 16:12"/><verse number="13" style="v" sid="EZK 16:13"/>عِ نُ رَشُنمَشِ شّيمَ نُن فبٍتِ نَن نَ، عِ نُ مَشِرِشِ دُفِ تٌقَنيِيٍ نَن نَ، عِ نُ دٌنسٍ قَنيِ دٌنمَ نَشَن قِندِ كُمِ نُن تُرٍ رَ. عِ شَ تٌقَنيِ شُن نُ قَ مَسَ تُن، مَنفّيَ نَشَ رَدَشَ عِ بّ. <verse eid="EZK 16:13"/><verse number="14" style="v" sid="EZK 16:14"/>عِ شِلِ نَشَ دِن حَمَنّيٍ رَ عِ شَ تٌقَنيِ شَ قٍ رَ، بَرِ مَ تٌقَنيِ كَمَلِشِ نَن نُ عَ رَ عِ شَ نْرّ سَابُي رَ ﭑ نَشَن قِشِ عِ مَ. عَلَتَلَ شُي نَن نَ كِ.»<verse eid="EZK 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 16:15"/>«كْنْ نَ تّمُي عِ نَشَ لَ قْلْ عِ شَ تٌقَنيِ نُن عِ شِلِ قَنيِ رَ، عِ قَ سٌ لَنفٌيحَ رَبَقٍ. عِ نُ عِ يّتّ سٌمَ مِشِ بِرِن يِ رَ، عِ لُ عٍ سَفٌي. <verse eid="EZK 16:15"/><verse number="16" style="v" sid="EZK 16:16"/>عِ نَشَ عِ شَ دُفِ تٌقَنيِيٍ عِتَلَ فٍيَ قَرِ عِ لَنفٌيحَ رَبَ دّننَشّ. نَ قٍ مْولِ مُ لَنمَ قٍوٌ. نَ رَبَقٍ مُ قَن. <verse eid="EZK 16:16"/><verse number="17" style="v" sid="EZK 16:17"/>عِ نَشَ عِ شَ شُنمَسٍ شّيمَ نُن فبٍتِ دَاشِيٍ تٌنفٌ، ﭑ نَشٍيٍ قِشِ عِ مَ، عِ عٍ يَءِلَن كُيٍ شّمّيٍ رَ، عِ قَ لَنفٌيحَ رَبَ نٍيٍ رَ. <verse eid="EZK 16:17"/><verse number="18" style="v" sid="EZK 16:18"/>عِ نَشَ عِ شَ دُفِ تٌقَنيِيٍ رَفٌرٌ عٍ مَ، عِ قَ ﭑ مَ تُرٍ نُن ﭑ مَ سُرَيِ بَ سّرّشّ رَ عٍ بّ. <verse eid="EZK 16:18"/><verse number="19" style="v" sid="EZK 16:19"/>ﭑ دٌنسٍ نَشَن سٌ عِ يِ رَ، عِ بَرَ نَ تَامِ قَنيِ، نَ تُرٍ، نُن نَ كُمِ بِرِن بَ سّرّشّ فَن دَاشِ رَ عٍ بّ. عِ نَ نَن نَبَشِ. عَلَتَلَ شُي نَن نَ كِ.»<verse eid="EZK 16:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 16:20"/>«عِ نَشَ عِ شَ دِيٍ تٌنفٌ، ﭑ نَشٍيٍ قِشِ عِ مَ، عِ عٍ قَن بَ سّرّشّ رَ نَ كُيٍيٍ بّ. عِ شَ لَنفٌيحَ مُ نُ عِ وَ سَمَ نُ؟ <verse eid="EZK 16:20"/><verse number="21" style="v" sid="EZK 16:21"/>عِ بَرَ ﭑ مَ دِيٍ كْن نَشَبَ، عِ عٍ بَ سّرّشّ رَ كُيٍيٍ بّ! <verse eid="EZK 16:21"/><verse number="22" style="v" sid="EZK 16:22"/>عِ شَ قٍ كٌبِيٍ نُن عِ شَ لَنفٌيحَ بِرِن كُي، عِ مُ رَتُ عَ مَ ﭑ نَشَن نَبَشِ عِ بّ عِ مَفٍلِ تٌ نُ عَ رَ، عِ نُ عِ نِي مَفَفَقٍ عِ وُلِ شْورَ تّمُي نَشّ؟»<verse eid="EZK 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 16:23"/>«حَشَنكَتّ نَ عِ بّ! عَلَتَلَ شُي نَن نَ كِ. سَقٍ عِ شَ وَلِ حَاشِ شُن مَ، عِ بَرَ قٍ فبّتّ قَن نَبَ. <verse eid="EZK 16:23"/><verse number="24" style="v" sid="EZK 16:24"/>عِ بَرَ يِرٍيٍ تِ تَا تَفِ كِرَ دّ رَ، <verse eid="EZK 16:24"/><verse number="25" style="v" sid="EZK 16:25"/>عِ قَ عِ قَتٍ شَ تٌقَنيِ مَسٍن حَمَ بّ كّنّ مَ، عَلْ لَنفٌي نَشَن وَ مَ شّمّ مَبّندُنقٍ عَ مَ. <verse eid="EZK 16:25"/><verse number="26" style="v" sid="EZK 16:26"/>عِ بَرَ لَنفٌيحَ رَبَ مِسِرَكَيٍ رَ، عِ دْشْبٌورٍ نَشٍيٍ شَ فِنّ قٍ شْرْشْ. عِ شَ لَنفٌيحَ رَدَنفِشِ بَرَ ﭑ نَشْنْ. <verse eid="EZK 16:26"/><verse number="27" style="v" sid="EZK 16:27"/>نَ كُي ﭑ بَرَ ﭑ بّلّشّ عِتَلَ عِ شِلِ مَ، ﭑ قَ ندٍ بَ عِ شَ بْشِ رَ، ﭑ عَ سَ عِ يَشُييٍ قِلِسِتَكَيٍ سَفٌي، عِ شَ وَلِ كٌبِيٍ شَ قٍ رَ نَشٍيٍ بَرَ عٍ رَتّرّننَ. <verse eid="EZK 16:27"/><verse number="28" style="v" sid="EZK 16:28"/>عِ بَرَ لَنفٌيحَ رَبَ عَسِرِيَكَيٍ قَن نَ، بَرِ مَ سٍسٍ مُ عِ وَ سَمَ. <verse eid="EZK 16:28"/><verse number="29" style="v" sid="EZK 16:29"/>نَ دَنفِ شَنبِ عِ بَرَ لَنفٌيحَ رَبَ بَبِلْن يُلّيٍ رَ، كْنْ نٍيٍ قَن مُ عِ وَ سَ.»<verse eid="EZK 16:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 16:30"/>«عِ بْحّ كٌبِ! عَلَتَلَ شُي نَن نَ كِ. عِ يِ لَنفٌيحَ مْولِ رَبَمَ دِ؟ <verse eid="EZK 16:30"/><verse number="31" style="v" sid="EZK 16:31"/>عِ تٌ عِ شَ لَنفٌي يِرٍيٍ تِ تَا كُي كِرَ دّ رَ، عِ مُ نُ لُشِ عَلْ لَنفٌي يَتِ بَرِ مَ عِ نُ لَنفٌيحَ رَبَقٍ نّ تُن كْبِرِ شَنبِ!»<verse eid="EZK 16:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="EZK 16:32"/>«يّنّ فِنّ، شْحّيٍ رَقَن عِ مَ دَنفِقٍ عِ شَ مْرِ رَ. <verse eid="EZK 16:32"/><verse number="33" style="v" sid="EZK 16:33"/>لَنفٌي بِرِن وَ مَ لَنفٌي سَرٍ شْن، كْنْ عِ تَن نَن لُمَ عِ حّنفّيٍ كِ رَ، عَلَكٌ عِ شَ عٍ مَبّندُن عِ مَ عَ مْولِ بِرِن نَ. <verse eid="EZK 16:33"/><verse number="34" style="v" sid="EZK 16:34"/>عِ مُ لُشِ عَلْ لَنفٌي فبّتّيٍ. مِشِ يٌ مُ عِ مَيَندِ مَ عِ شَ وَلِ رَ. عِ تَن نَن عٍ مَيَندِ مَ، عِ قَ عٍ سَرٍ قِ، عِ مُ سٍ سْتْ.»<verse eid="EZK 16:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="EZK 16:35"/>«عِ تَن لَنفٌي فِنّ، عِ تُلِ مَتِ عَلَتَلَ شَ مَسٍنيِ رَ! <verse eid="EZK 16:35"/><verse number="36" style="v" sid="EZK 16:36"/>عِ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛ عِ تٌ عِ شَ نَاقُلِ بَ عَلَكٌ عِ شَ لَنفٌيحَ رَبَ عِ حّنفّيٍ رَ، عِ تٌ كُيٍيٍ مْولِ بِرِن تِ، عِ قَ عِ شَ دِيٍ وُلِ بَ سّرّشّ رَ عٍ بّ، <verse eid="EZK 16:36"/><verse number="37" style="v" sid="EZK 16:37"/>ﭑ قَمَ نّ عِ حّنفّيٍ بِرِن مَلَندٍ، نَشٍيٍ نُ رَقَن عِ مَ نُن نَشٍيٍ مُ نُ رَقَن عِ مَ، ﭑ عِ حَءِبْي مَسٍن عٍ بّ عَ كّنّ مَ، عِ شَ يَافِ. <verse eid="EZK 16:37"/><verse number="38" style="v" sid="EZK 16:38"/>ﭑ عِ مَكِيتِمَ نّ عَلْ فِنّ يّنّلَ نُن قَشّتِ مَكِيتِمَ كِ نَشّ. ﭑ نَن ﭑ فبٍ حْشْمَ نّ عِ مَ ﭑ مَ شْنّ نُن ﭑ مَ تْونّ شْرْشْي رَ. <verse eid="EZK 16:38"/><verse number="39" style="v" sid="EZK 16:39"/>نَ تّمُي ﭑ عِ سَمَ نّ عِ حّنفّيٍ سَفٌي، عٍ عِ شَ لَنفٌي يِرٍيٍ كَنَ، عٍ عِ شَ دُفِيٍ نُن عِ شَ شُنمَسٍيٍ بَ عِ مَ، عٍ قَ عِ لُ عِ مَفٍلِ رَ قْين. <verse eid="EZK 16:39"/><verse number="40" style="v" sid="EZK 16:40"/>عٍ عٍ مَلَنمَ نّ عِ شِلِ مَ، عٍ عِ مَفْنْ فّمّيٍ رَ، عٍ عِ مَسْشْ عٍ شَ سَنتِدّفّمَيٍ رَ. <verse eid="EZK 16:40"/><verse number="41" style="v" sid="EZK 16:41"/>عٍ عِ شَ بَنشِيٍ فَنمَ نّ، عٍ عِ حَشَنكَتَ فِنّ فبٍفبٍ يَ شْرِ. ﭑ عِ شَ لَنفٌيحَ دَنمَ نّ، عِ مُ عِ حّنفّيٍ كِمَ سْنْن. <verse eid="EZK 16:41"/><verse number="42" style="v" sid="EZK 16:42"/>ﭑ نَ فّ نَ رَبَدٍ عِ رَ، ﭑ مَ شْنّ فٌرٌ مَ نّ عِ شَ يَنقَنتٍيَ شَ قٍ رَ.»<verse eid="EZK 16:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="EZK 16:43"/>«ﭑ قَمَ نّ عِ شَ وَلِ سَرٍ بِرِن نَفبِلٍندٍ عِ مَ، بَرِ مَ عِ مُ عِ رَتُ عِ قٌنِكٍ تّمُي مَ. عِ مَرِفِ عَلَتَلَ شُي نَن نَ كِ. عِ مُ لَنفٌيحَ شَ سَ عِ شَ قٍ كٌبِ فبّتّيٍ قَرِ؟»<verse eid="EZK 16:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="EZK 16:44"/>«تَالِ قَلّيٍ قَمَ يِ تَالِ قَلَدٍ عِ شُن مَ، ‹نفَ لُ كِ يٌ كِ، عَ شَ دِ فِنّ قَن لُمَ نَ كِ نّ!› <verse eid="EZK 16:44"/><verse number="45" style="v" sid="EZK 16:45"/>عِ نفَ شَ دِ يَتِ نَن عِ رَ، نَشَن مّ عَ شَ مْرِ نُن عَ شَ دِيٍ رَ. عِ تَارَ فِنّمَيٍ قَن مّ نّ عٍ شَ مْرِيٍ رَ، نُن عٍ شَ دِيٍ رَ. عِ نفَ قِندِشِ شِتِكَ نَن نَ، عِ بَبَ قِندِشِ عَمٌرِكَ نَن نَ. <verse eid="EZK 16:45"/><verse number="46" style="v" sid="EZK 16:46"/>سَمَرِ قِندِشِ عِ تَارَ فِنّمَ نَن نَ نَشَن سَبَتِشِ عِ كْولَ مَ، عَ نُن عَ شَ تَا فبّتّيٍ كُي. سٌدٌ مَ نَن قِندِشِ عِ شُنيَ فِنّمَ رَ نَشَن سَبَتِشِ عِ يِرٍقَنيِ مَ، عَ نُن عَ شَ تَا فبّتّيٍ رَ. <verse eid="EZK 16:46"/><verse number="47" style="v" sid="EZK 16:47"/>عِ بَرَ بِرَ عٍ شَ وَلِ حَاشِ قْشْ رَ، عِ مَن بَرَ حَاشُ دَنفِقٍ عٍ تَن نَ. <verse eid="EZK 16:47"/><verse number="48" style="v" sid="EZK 16:48"/>ﭑ بَرَ ﭑ كَلِ، سٌدٌ مَ نُن عَ شَ تَايٍ مُ عِ شَ حَاشُحَ لِشِ. عَلَتَلَ شُي نَن نَ كِ.»<verse eid="EZK 16:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="EZK 16:49"/>«عِ شُنيَ سٌدٌ مَ شَ يُنُبِيٍ قِندِشِ يِ نَن نَ؛ يّتّ عِفبٌحَ، بَننَيَ، نُن كِنِكِنِتَرٍحَ تْورْ مِشِيٍ مَبِرِ. <verse eid="EZK 16:49"/><verse number="50" style="v" sid="EZK 16:50"/>عٍ دّ عِفبٌ، عٍ قٍ حَاشِيٍ رَبَمَ ﭑ يَ شْرِ. نَ كُي، ﭑ نَشَ عٍ شَ قٍ حْن! <verse eid="EZK 16:50"/><verse number="51" style="v" sid="EZK 16:51"/>سَمَرِ مُ يُنُبِ رَبَ عَلْ عِ تَن. عِ شَ قٍ كٌبِ رَبَ فبٌ دَنفِ عَ فبٍ رَ ثٌن! نَ تَا حَاشِ تِنشِن عِ بّ. <verse eid="EZK 16:51"/><verse number="52" style="v" sid="EZK 16:52"/>عِ شَ يَافِ تُن! عِ شَ حَاشُحَ كُي، عَ لُشِ نّ عَلْ عِ شُنيَيٍ نَ قِسَ عِ بّ. عِ شَ نَ كٌتٍ شَنِن.»<verse eid="EZK 16:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="EZK 16:53"/>«كْنْ عَ رَحْنيِ، ﭑ قَمَ نّ سٌدٌ مَ نُن عَ شَ تَايٍ نُن سَمَرِ نُن عَ شَ تَايٍ شَ قٍ شُن نَكٍلِدٍ. عِ قَن لُمَ نّ نَ شُننَكٍلِ كُي. <verse eid="EZK 16:53"/><verse number="54" style="v" sid="EZK 16:54"/>عِ بَرَ يَافِ سْتْ عِ شَ وَلِ كٌبِ شَ قٍ رَ. نَ بَرَ عَ نِيَ سٌدٌ مَ نُن سَمَرِ شِلِ شَ قَن دٌندٌرٌنتِ. <verse eid="EZK 16:54"/><verse number="55" style="v" sid="EZK 16:55"/>عِ شُنيَ سٌدٌ مَ نُن عَ شَ تَايٍ نُن عِ تَارَ سَمَرِ نُن عَ شَ تَايٍ شُن نَكٍلِمَ نّ عَلْ سِنفٍ. عِ قَن نُن عِ شَ تَايٍ لُمَ نَ شُننَكٍلِ نَن كُي. <verse eid="EZK 16:55"/><verse number="56" style="v" sid="EZK 16:56"/>عِ نُ عِ يّتّ عِفبٌمَ تّمُي نَشّ، عِ مُ تِن قٍ قَنيِ قَلَدٍ عِ شُنيَ سٌدٌ مَ شَ قٍ رَ، <verse eid="EZK 16:56"/><verse number="57" style="v" sid="EZK 16:57"/>بٍينُن عِ شَ حَاشُحَ شَ سَ كّنّ مَ. يَكْسِ عٍدٌن نُن عَ شَ تَايٍ نُن قِلِسِتَ نُن عَ شَ تَايٍ، عٍ بِرِن عِ مَبٍرٍ مَ. <verse eid="EZK 16:57"/><verse number="58" style="v" sid="EZK 16:58"/>نَ لَنفٌيحَ نُن قٍ كٌبِيٍ يَافِ لُمَ نّ عِ مَ. عَلَتَلَ شُي نَن نَ كِ.»<verse eid="EZK 16:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="EZK 16:59"/>«عِ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛ ﭑ عِ سَرٍ رَفبِلٍنمَ نّ عِ مَ سّرِيّ كِ مَ، بَرِ مَ عِ بَرَ ﭑ مَ كَلِ مَبٍرٍ ﭑ مَ سَاتّ كَنَقٍ رَ. <verse eid="EZK 16:59"/><verse number="60" style="v" sid="EZK 16:60"/>كْنْ ﭑ تَن مُ نّيمُمَ وٌن مَ سَاتّ مَ، وٌن نَشَن تٌنفٌ عِ قٌنِكٍ تّمُي. ﭑ قَمَ نّ سَاتّ تٌنفٌدٍ عِ بّ نَشَن مُ حْنمَ عَبَدَن. <verse eid="EZK 16:60"/><verse number="61" style="v" sid="EZK 16:61"/>نَ كُي، عِ تَارَ نُن عِ شُنيَ نَ فبِلٍن عِ مَ، عِ رَتُمَ نّ عِ شَ كِرَ حَاشِ مَ يَافِ رَ. ﭑ عٍ قِمَ نّ عِ مَ، كْنْ نَ قٍ مُ نَ وٌن مَ سَاتّ سِنفٍ كُي. <verse eid="EZK 16:61"/><verse number="62" style="v" sid="EZK 16:62"/>ﭑ سَاتّ تٌنفٌمَ نّ عِ بّ، عِ عَ كٌلٌنمَ نّ عَ ﭑ تَن نَن نَ عَلَتَلَ رَ. <verse eid="EZK 16:62"/><verse number="63" style="v" sid="EZK 16:63"/>ﭑ نَ فّ عِ شُن سَرَدٍ عِ شَ يُنُبِيٍ شَ قٍ رَ، عِ قَمَ نّ رَتُدٍ قٍ دَنفِشِيٍ مَ يَافِ كُي، عِ قَ عِ دّ رَفَلِ عِ شَ يَافِ شَ قٍ رَ. عَلَتَلَ شُي نَن نَ كِ.»<verse eid="EZK 16:63"/></para>
  <chapter eid="EZK 16"/>
  <chapter number="17" style="c" sid="EZK 17"/>
  <para style="s">تَالِ وْيّنيِ عِسِرَيِلَ بّ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 17:1"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، عَ نَشّ، <verse eid="EZK 17:1"/><verse number="2" style="v" sid="EZK 17:2"/>«عَدَ مَدِ، عِ شَ يِ تَالِ قَلَ عِسِرَيِلَ بْنسْي بّ. <verse eid="EZK 17:2"/><verse number="3" style="v" sid="EZK 17:3"/>عَ قَلَ عٍ بّ، ‹وٌن مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛ سّفّ شُنفبٍ، فَبُتٍنيِ سّنبّمَيٍ، شَبٍ كُيٍ تٌقَنشِيٍ، نَشَ قَ لِبَن، عَ سّدِرِ بِلِ سَلٌنيِ بٌلٌن عَ كْن نَ. <verse eid="EZK 17:3"/><verse number="4" style="v" sid="EZK 17:4"/>عَ نَشَ نَ شَنِن يُلّ بْشِ مَ، عَ عَ سِ عٍ شَ تَا كُي.›»<verse eid="EZK 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 17:5"/>«عَ نَشَ سَنسِ شْرِ ندٍ تٌنفٌ عِسِرَيِلَ بْشِ مَ، عَ سَ نَ سِ بْشِ قَنيِ مَ، يٍ فبٌشِ دّننَشّ. <verse eid="EZK 17:5"/><verse number="6" style="v" sid="EZK 17:6"/>نَ سَنسِ شْرِ نَشَ بُلَ، عَ قِندِ وّنِ سَنسِ دُنكٍ رَ نَشَن سَلٌنيِيٍ نُ كُيَمَ عَ فبٍ رَ. عَ سَلٌنيِيٍ نُ قَ عٍ رَ مَشَ كٌورٍ مَ، عَ سَنكٍ نُ فٌرٌ يٍ قٍنقٍ رَ. نَ سَنسِيٍ نَشَ قَن، عَ سَلٌنيِيٍ نَشَ وُيَ عَ بُرّشّيٍ نَشَ قَن.»<verse eid="EZK 17:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 17:7"/>«سّفّ شُنفبٍ فبّتّ نَشَ مِنِ نَا رَ، عَ فَبُتٍنيِيٍ شُنفبٌ، عَ شَبٍيٍ وُيَ. وّنِ بِلِ نَشَ عَ سَنكٍيٍ نُن عَ سَلٌنيِيٍ رَحّرّ كٍلِقٍ بْشِ مَ عَ نُ سِشِ دّننَشّ، سِفَقٍ رَ سّفّ مَبِرِ يٍ سْتْقٍ رَ. <verse eid="EZK 17:7"/><verse number="8" style="v" sid="EZK 17:8"/>عَ نُ سِشِ بْشِ قَنيِ نَن مَ، يٍ فبٍفبٍ نُ نَ دّننَشّ، عَلَكٌ عَ شَ قِندِ عَ رَ، عَ وّنِ بٌفِ قَنيِ رَ مِنِ.»<verse eid="EZK 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 17:9"/>«عَ قَلَ عٍ بّ، ‹وٌن مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛ نَ وّنِ بِلِ قَنمَ؟ عَ مُ قَمَ عَ عِتَلَدٍ، عَ بٌفِ بِرَ، عَ شَرَ؟ عَ سَلٌنيِيٍ نُن عَ بُرّشّ كَنَمَ نّ. عَ عِتَلَقٍ مُ شْرْشْ. <verse eid="EZK 17:9"/><verse number="10" style="v" sid="EZK 17:10"/>هَلِ عَ عِتَلَ، عَ سِ يِرٍ فبّتّ، قٌيٍ نَشَن كٍلِمَ سٌفٍتٍدٍ مَبِرِ عَ مُ عَ شَرَ مَ شّ فبِكِ؟›»<verse eid="EZK 17:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 17:11"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، عَ نَشّ، <verse eid="EZK 17:11"/><verse number="12" style="v" sid="EZK 17:12"/>«عَ قَلَ يِ بْنسْي مُرُتَشِ بّ، ‹وٌ مُ نَ تَالِ قَهَامُشِ؟ بَبِلْن مَنفّ بَرَ سِفَ دَرِ سَلَمُ، عَ نَا مَنفّ نُن عَ كُنتِفِيٍ سُشُ، عَ عٍ شَنِن بَبِلْن. <verse eid="EZK 17:12"/><verse number="13" style="v" sid="EZK 17:13"/>عَ بَرَ مِشِ كٍرٍن سُفَندِ مَنفّ بْنسْي يَ مَ، عَ سَاتّ شِرِ عَ نُن نَ تَفِ، عَ عَ تِ مَنفّيَ رَ كَلِ رَ. عَ مَن بَرَ بْشِ كُنتِفِيٍ تَن شَنِن، <verse eid="EZK 17:13"/><verse number="14" style="v" sid="EZK 17:14"/>عَلَكٌ بْشِ سّنبّ شَ شُرُن، هَن عَ مُ نْ عَ عِكٍلِدٍ سْنْن، قٌ عَ نُ سَاتّ رَبَتُ تُن.›»<verse eid="EZK 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 17:15"/>«كْنْ نَ مَنفّ سُفَندِشِ قَن نَشَ مُرُتَ، عَ شّيرَيٍ رَ سِفَ مِسِرَ مَنفّ مَ سٌييٍ نُن سْورِيٍ قٍندٍ. نَ قٍ مْولِ سْونّيَمَ؟ نَشَن مَتَندِ تِمَ نَ كِ، عَ مُ تْورْ مَ يَرٍ؟ <verse eid="EZK 17:15"/><verse number="16" style="v" sid="EZK 17:16"/>ﭑ بَرَ ﭑ كَلِ، ﭑ تَن عَلَتَلَ نَن شُي عَ رَ، عَ قَشَمَ بَبِلْن بْشِ نَن مَ، مَنفّ قّ مَ نَشَن مَنفّيَ سٌشِ عَ يِ رَ، عَ نَشَن شَ سَاتّ مَبٍرٍشِ، عَ عَ كَنَ. <verse eid="EZK 17:16"/><verse number="17" style="v" sid="EZK 17:17"/>مِسِرَ مَنفّ مُ نْمَ عَ مَلِدٍ فٍرٍ كُي، عَ يَشُييٍ سٍيٍ يَءِلَنمَ تَا تّتّ كَنَقٍ رَ تّمُي نَشّ. <verse eid="EZK 17:17"/><verse number="18" style="v" sid="EZK 17:18"/>عَ تٌ عَ شَ كَلِ مَبٍرٍ سَاتّ كَنَقٍ رَ، عَ قَمَ نّ نَ سَرٍ سْتْدٍ.»<verse eid="EZK 17:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 17:19"/>نَ شَ قٍ رَ، عَلَتَلَ يِ نَن مَسٍنشِ، عَ نَشّ، «ﭑ بَرَ ﭑ كَلِ ﭑ يّتّ رَ، عَ تٌ ﭑ مَ كَلِ مَبٍرٍ، عَ تٌ ﭑ مَ سَاتّ كَنَ، ﭑ نَ سَرٍ رَفبِلٍنمَ نّ عَ مَ. <verse eid="EZK 17:19"/><verse number="20" style="v" sid="EZK 17:20"/>ﭑ نَ ﭑ مَ يّلّ عِتَلَمَ نّ عَ يَ رَ، ﭑ عَ سُشُ ﭑ مَ فَنتَنيِ رَ. ﭑ عَ شَنِنمَ نّ بَبِلْن بْشِ مَ، ﭑ قَ عَ حَشَنكَتَ عَ شَ يَنقَنتٍيَ شَ قٍ رَ مّننِ، عَ نَشَن نَبَشِ ﭑ نَ. <verse eid="EZK 17:20"/><verse number="21" style="v" sid="EZK 17:21"/>عَ شَ سْورِيٍ سْنتْمَ نّ سَنتِدّفّمَ رَ، مِشِ دْنشْي يٍنسٍنمَ نّ. وٌ عَ كٌلٌنمَ نّ نَ كُي عَ ﭑ تَن عَلَتَلَ نَن نَ نَتّ تٌنفٌشِ.»<verse eid="EZK 17:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 17:22"/>وٌن مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ، عَ نَشّ، «ﭑ سّدِرِ سَلٌنيِ بَمَ نّ عَ كْن نَ، سَلٌنيِ قَنيِ نَشَن نَ كٌورٍ مَ، ﭑ قَ عَ سِ فٍيَ عِتٍشِ قَرِ. <verse eid="EZK 17:22"/><verse number="23" style="v" sid="EZK 17:23"/>ﭑ عَ سِمَ نّ عِسِرَيِلَ فٍيَ مَ، عَ سَلٌنيِيٍ قَن، عٍ بٌفِ فبٍفبٍ رَ مِنِ. عَ قِندِ مَ نّ سّدِرِ وُرِ بِلِ تٌقَنيِ رَ. شْنِ مْولِ بِرِن قَمَ نّ عٍ مَلَبُدٍ، عَ سَلٌنيِيٍ نِينِ بُن مَ عَ كْن نَ. <verse eid="EZK 17:23"/><verse number="24" style="v" sid="EZK 17:24"/>نَ كُي وُرِ بِلِ بِرِن عَ كٌلٌنمَ نّ، عَ ﭑ تَن عَلَتَلَ نَن وُرِ بِلِ عِتٍشِ عِفٌرٌ مَ، ﭑ وُرِ بِلِ عِفٌرٌشِ عِتٍ. ﭑ وُرِ شِندٍ شَرَ، ﭑ وُرِ شَرٍ رَقَن. ﭑ تَن عَلَتَلَ شُي نَن نَ كِ. ﭑ قَمَ نّ نَ رَكَمَلِدٍ.»<verse eid="EZK 17:24"/></para>
  <chapter eid="EZK 17"/>
  <chapter number="18" style="c" sid="EZK 18"/>
  <para style="s">يُنُبِتْي سَرٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 18:1"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، عَ نَشّ، <verse eid="EZK 18:1"/><verse number="2" style="v" sid="EZK 18:2"/>«وٌ يِ تَالِ وْيّنيِ قَلَمَ نّ عِسِرَيِلَ بْشِ مَ. وٌ نَشّ،</para>
  <para style="q" vid="EZK 18:2">‹قٌرِيٍ نَ مَنفٌي يْشْي دٌن،</para>
  <para style="q" vid="EZK 18:2">عٍ شَ دِيٍ نَن حِنيِيٍ مُلُشُنمَ.›</para>
  <para style="m" vid="EZK 18:2">وٌ نَ قَلَمَ مُنقٍ رَ؟ <verse eid="EZK 18:2"/><verse number="3" style="v" sid="EZK 18:3"/>ﭑ بَرَ ﭑ كَلِ ﭑ يّتّ رَ، عَ مُ لَنمَ وٌ شَ يِ تَالِ قَلَ عِسِرَيِلَ بْشِ مَ سْنْن. <verse eid="EZK 18:3"/><verse number="4" style="v" sid="EZK 18:4"/>ﭑ تَن نَن فبٍ نَ نِي بِرِن نَ، بَبّ بَ، دِ بَ. ﭑ تَن نَن فبٍ عٍ بِرِن نَ. نِي نَشَن نَ يُنُبِ رَبَ، نَ نِي نَن بْنْمَ.»<verse eid="EZK 18:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="EZK 18:5"/>«مِشِ نَشَن تِنشِن،</para>
  <para style="q" vid="EZK 18:5">نَشَن قٍ قَنيِ رَبَمَ،<verse eid="EZK 18:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="EZK 18:6"/>نَشَن مُ سّرّشّ دٌنمَ كُيٍ بّ فٍيَيٍ قَرِ،</para>
  <para style="q" vid="EZK 18:6">نَشَن مُ عَ يَ تِمَ عِسِرَيِلَ شَ كُيٍيٍ رَ،</para>
  <para style="q" vid="EZK 18:6">نَشَن مُ يّنّ رَبَمَ عَ دْشْبٌورٍ فِنّ رَ،</para>
  <para style="q" vid="EZK 18:6">نَشَن مُ فِنّ مَسَمَ عَ شَ كِكٍ وَلِ كُي،<verse eid="EZK 18:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="EZK 18:7"/>نَشَن مُ مِشِ رَوَلِمَ عَ يّتّ شَ فٍينِ شَ قٍ رَ،</para>
  <para style="q" vid="EZK 18:7">نَشَن دٌنِقَ شَ سّيكّ رَفبِلٍنمَ عَ مَ،</para>
  <para style="q" vid="EZK 18:7">نَشَن مُ مُحّ تِمَ،</para>
  <para style="q" vid="EZK 18:7">كْنْ عَ قَ سٍتَرٍ كِ، عَ دُفِ قِ مِسِكِينّ مَ،<verse eid="EZK 18:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="EZK 18:8"/>نَشَن مُ فٍينِ مْولِ يٌ قٍنمَ دٌنِ كُي،</para>
  <para style="q" vid="EZK 18:8">نَشَن عَ يّتّ سُشُمَ قٍ حَاشِ رَبَقٍ رَ،</para>
  <para style="q" vid="EZK 18:8">نَشَن كِيتِ تِنشِنشِ سَمَ مِشِيٍ تَفِ،<verse eid="EZK 18:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="EZK 18:9"/>نَشَن ﭑ مَ يَامَرِيٍ رَبَمَ، عَ ﭑ مَ سّرِيّ رَبَتُ،</para>
  <para style="q" vid="EZK 18:9">نَ كَنيِ قِندِشِ تِنشِنتْي نَن نَ.</para>
  <para style="q" vid="EZK 18:9">نَ كِسِمَ نّ.</para>
  <para style="m" vid="EZK 18:9">عَلَتَلَ شُي نَن نَ كِ.»<verse eid="EZK 18:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 18:10"/>كْنْ شَ عَ سَ لِ عَ شَ دِ ندٍ نَ نَ، نَشَن مِشِ بْنبْمَ، عَ قَشّ تِمَ، عَ قٍ حَاشِ فبّتّ رَبَ <verse eid="EZK 18:10"/><verse number="11" style="v" sid="EZK 18:11"/>عَ بَبَ مُ دَرِشِ نَشَن نَ، عَ شَ قٍ نَ دِ؟</para>
  <para style="q" vid="EZK 18:11">عَ سّرّشّ دٌنمَ كُيٍ بّ فٍيَ قَرِ،</para>
  <para style="q" vid="EZK 18:11">عَ يّنّ رَبَ عَ دْشْبٌورٍ شَ فِنّ رَ،<verse eid="EZK 18:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="EZK 18:12"/>عَ سٍتَرٍ نُن مِسِكِينّ تْورْ مَ،</para>
  <para style="q" vid="EZK 18:12">عَ مُحّ تِمَ،</para>
  <para style="q" vid="EZK 18:12">عَ تٌندِ سّيكّ رَفبِلٍندٍ،</para>
  <para style="q" vid="EZK 18:12">عَ عَ يَيٍ تِمَ كُيٍيٍ رَ،</para>
  <para style="q" vid="EZK 18:12">عَ قٍ حَاشِيٍ رَبَمَ،<verse eid="EZK 18:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="EZK 18:13"/>عَ فٍينِ قٍنمَ دٌنِ كُي.</para>
  <para style="m" vid="EZK 18:13">نَ مِشِ مْولِ كِسِمَ؟ عَدٍ، عَ عَ يّتّ نِي سَرٍ قِمَ نّ قَشّ رَ عَ شَ قٍ حَاشِيٍ مَ!<verse eid="EZK 18:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 18:14"/>«كْنْ شَ نَ دِ حَاشِ دِ ندٍ سْتْ، نَشَن بَرَ عَ بَبَ شَ يُنُبِيٍ تٌ، عَ قَ لُ عَ مُ تِن نَ وَلِ مْولِ رَبَدٍ، عَ شَ قٍ لُمَ دِ؟<verse eid="EZK 18:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="EZK 18:15"/>عَ مُ سّرّشّ دٌنمَ كُيٍ بّ فٍيَ قَرِ.</para>
  <para style="q" vid="EZK 18:15">عَ مُ عَ يَ تِمَ عِسِرَيِلَ كُيٍيٍ رَ.</para>
  <para style="q" vid="EZK 18:15">عَ مُ يّنّ رَبَمَ عَ دْشْبٌورٍ فِنّ رَ.<verse eid="EZK 18:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="EZK 18:16"/>عَ مُ مِشِ رَوَلِمَ عَ يّتّ شَ فٍينِ شَ قٍ رَ.</para>
  <para style="q" vid="EZK 18:16">عَ مُ سّيكّ مَشْرِنمَ.</para>
  <para style="q" vid="EZK 18:16">عَ مُ مُحّ تِمَ،</para>
  <para style="q" vid="EZK 18:16">كْنْ عَ سٍتَرٍ كِمَ، عَ دُفِ قِمَ مِسِكِينّ مَ،<verse eid="EZK 18:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="EZK 18:17"/>عَ عَ يّتّ سُشُمَ قٍ حَاشِ رَبَقٍ رَ،</para>
  <para style="q" vid="EZK 18:17">عَ مُ فٍينِ مْولِ يٌ قٍنمَ دٌنِ كُي.</para>
  <para style="m" vid="EZK 18:17">نَ دِ مُ بْنْمَ عَ بَبَ شَ قٍ حَاشِ شَ قٍ رَ. عَ كِسِمَ نّ. <verse eid="EZK 18:17"/><verse number="18" style="v" sid="EZK 18:18"/>كْنْ عَ بَبَ تَن، نَشَن قِندِ قُنمَلَ رَ، نَشَن عَ بٌورٍ مُحَ، نَشَن قٍ حَاشِيٍ رَبَ عَ شَ مِشِيٍ تَفِ، عَ تَن نَن بْنْمَ عَ شَ يُنُبِيٍ شَ قٍ رَ.»<verse eid="EZK 18:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 18:19"/>«كْنْ وٌ ﭑ مَشْرِنمَ، ‹مُنقٍرَ نَ دِ مُ عَ بَبَ شَ يُنُبِ كٌتٍ تٌنفٌمَ؟› ﭑ شَ عَ قَلَ وٌ بّ، نَ دِ تِنشِنتْي، نَشَن بَرَ ﭑ مَ سّرِيّ رَبَتُ، عَ كِسِمَ نّ. <verse eid="EZK 18:19"/><verse number="20" style="v" sid="EZK 18:20"/>نَشَن نَ يُنُبِ رَبَ، نَ نَن بْنْمَ. دِ مُ عَ بَبَ شَ يُنُبِ كٌتٍ شَنِنمَ. بَبَ قَن مُ عَ شَ دِ شَ يُنُبِ كٌتٍ شَنِنمَ. تِنشِنتْي قَمَ نّ تِنشِنيِ سَرٍ سْتْدٍ. يُنُبِتْي تَن قَمَ يُنُبِ سَرٍ سْتْدٍ.»<verse eid="EZK 18:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 18:21"/>«كْنْ شَ يُنُبِتْي فبِلٍن عَ شَ يُنُبِيٍ قْشْ رَ، عَ بِرَ عَلَ شَ سّرِيّ قْشْ رَ تِنشِنيِ كُي، عَ كِسِمَ نّ، عَ مُ بْنْمَ. <verse eid="EZK 18:21"/><verse number="22" style="v" sid="EZK 18:22"/>عَ قٍ كٌبِ نَشٍيٍ بِرِن نَبَ، نَ بِرِن بَمَ نّ عَ مَ، عَ قَ كِسِ عَ شَ تِنشِنيِ سَابُي رَ. <verse eid="EZK 18:22"/><verse number="23" style="v" sid="EZK 18:23"/>ﭑ تَن وٌ مَرِفِ عَلَتَلَ حّلّشِنمَ يُنُبِتْي شَ حَشَنكَتّ رَ؟ عَ شَ فبِلٍن عَ شَ يُنُبِ قْشْ رَ، عَ شَ كِسِ، نَ نَن نَقَن ﭑ مَ.»<verse eid="EZK 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 18:24"/>«كْنْ شَ تِنشِنتْي فبِلٍن عَ شَ تِنشِنيِ قْشْ رَ، عَ قَ قٍ حَاشِ رَبَ عَلْ يُنُبِتْي عَ رَبَمَ كِ نَشّ، عَ كِسِمَ؟ عَ قٍ قَنيِ نَشٍيٍ بِرِن نَبَ، نَ بِرِن بَمَ نّ عَ مَ، عَ يُنُبِ سْتْ، عَ قَ بْنْ عَ شَ قٍ حَاشِيٍ سَابُي رَ.»<verse eid="EZK 18:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 18:25"/>«وٌ نَشّ، ‹مَرِفِ شَ كِرَ مُ تِنشِن.› عِسِرَيِلَ بْنسْي، وٌ وٌ تُلِ مَتِ ﭑ نَ. ﭑ مَ كِرَ مُ تِنشِنشِ شّ، كَ وٌ تَن نَن شَ كِرَ مُ تِنشِن؟ <verse eid="EZK 18:25"/><verse number="26" style="v" sid="EZK 18:26"/>شَ تِنشِنتْي عَ كٌبٍ سٌ قٍ قَنيِ رَبَقٍ رَ، عَ بْنْمَ عَ شَ يُنُبِيٍ نَن مَ قٍ رَ. <verse eid="EZK 18:26"/><verse number="27" style="v" sid="EZK 18:27"/>كْنْ شَ تِنشِنتَرٍ عَ كٌبٍ سٌ قٍ حَاشِ رَبَقٍ رَ، عَ بِرَ تِنشِنيِ قْشْ رَ، عَ كِسِمَ نّ. <verse eid="EZK 18:27"/><verse number="28" style="v" sid="EZK 18:28"/>عَ تٌ عَ شَ وَلِ كٌبِيٍ بِرِن مَتٌ، عَ نَتّ تٌنفٌ عَ شَ فبِلٍن نٍيٍ قْشْ رَ، نَ نَن عَ رَ عَ كِسِمَ، عَ مُ بْنْمَ. <verse eid="EZK 18:28"/><verse number="29" style="v" sid="EZK 18:29"/>كْنْ عِسِرَيِلَ بْنسْي نَشّ، ‹عَلَ شَ كِرَ مُ تِنشِن.› ﭑ تَن نَن مَ كِرَ مُ تِنشِن بَ، كَ وٌ تَن نَن شَ كِرَ مُ تِنشِن؟»<verse eid="EZK 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 18:30"/>«نَ كُي عِسِرَيِلَ بْنسْي، ﭑ وٌ كَنكَن مَكِيتِمَ عَ شَ قٍ رَبَشِ بّرّ نَن مَ. وٌ شَ تُوبِ! وٌ فبِلٍن وٌ شَ يُنُبِيٍ رَبَقٍ قْشْ رَ، عَلَكٌ نٍيٍ نَشَ وٌ بْنْ. <verse eid="EZK 18:30"/><verse number="31" style="v" sid="EZK 18:31"/>وٌ شَ وٌ مَكُيَ وٌ شَ يُنُبِيٍ رَ وٌ نَشٍيٍ رَبَشِ، وٌ وٌ بْحّ مَسَرَ، وٌ شَشِلِ نّينّ تٌنفٌ. عِسِرَيِلَ بْنسْي، وٌ تِمَ بْنْي كِرَ رَ مُنقٍ رَ؟ <verse eid="EZK 18:31"/><verse number="32" style="v" sid="EZK 18:32"/>ﭑ مُ وَ مَ مِشِ يٌ شَ بْنْ. وٌ تُوبِ عَلَكٌ وٌ شَ كِسِ! وٌ مَرِفِ عَلَتَلَ شُي نَن نَ كِ.»<verse eid="EZK 18:32"/></para>
  <chapter eid="EZK 18"/>
  <chapter number="19" style="c" sid="EZK 19"/>
  <para style="s">عِسِرَيِلَ مَنفّيٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 19:1"/>وٌ شَ كِنِكِنِ عِسِرَيِلَ مَنفّ سُوكِبَيٍ مَ يِ كِ؛<verse eid="EZK 19:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="EZK 19:2"/>«وٌ نفَ قِندِ يّتّ فِنّ قَنيِ نَن نَ يّتّيٍ تَفِ.</para>
  <para style="q" vid="EZK 19:2">عَ سَشِ عَ شَ دِيٍ تَفِ، عَ عٍ شُرُ.<verse eid="EZK 19:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="EZK 19:3"/>عَ نَشَ عَ شَ دِ ندٍ رَ مْ، عَ قِندِ سّنبّمَ رَ.</para>
  <para style="q" vid="EZK 19:3">نَ دِ نَشَ قَتَ عَ بَلٌي قٍندٍ، عَ مِشِيٍ يَتِ قَشَ.<verse eid="EZK 19:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="EZK 19:4"/>حَمَنّيٍ تٌ عَ شَ قٍ مّ،</para>
  <para style="q" vid="EZK 19:4">عٍ نَشَ عَ سُشُ عٍ شَ فَنتَنيِ رَ،</para>
  <para style="q" vid="EZK 19:4">عٍ عَ شَنِن مِسِرَ وُرٍ رَ عَ حْي كُي.»<verse eid="EZK 19:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="EZK 19:5"/>«نَ يّتّ فِنّ تٌ عَ تٌ، عَ شَ قٍ مُ سْونّيَشِ،</para>
  <para style="q" vid="EZK 19:5">عَ نَشَ عَ شَ دِ فبّتّ تٌنفٌ،</para>
  <para style="q" vid="EZK 19:5">عَ عَ قِندِ يّتّ سّنبّمَ رَ.<verse eid="EZK 19:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="EZK 19:6"/>نَ دِ نُ عَ حّرّ مَ يّتّيٍ تَفِ عَ سّنبّ مَ.</para>
  <para style="q" vid="EZK 19:6">عَ نَشَ قَتَ عَ بَلٌي قٍندٍ، عَ مِشِيٍ قَشَ.<verse eid="EZK 19:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="EZK 19:7"/>عَ نَشَ نٍيٍ شَ تّتّيٍ كَنَ، عَ تَاكَيٍ قَشَ.</para>
  <para style="q" vid="EZK 19:7">حَمَ بِرِن نُ بَرَ فَاشُ عَ شَ يِرِندِنيِ يَرَ.<verse eid="EZK 19:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="EZK 19:8"/>حَمَنّيٍ مَن نَشَ كٍلِ عَ رَبِلِنيِ،</para>
  <para style="q" vid="EZK 19:8">عٍ نَشَ عٍ شَ يّلّيٍ عِتَلَ، عٍ عَ سُشُ فَنتَنيِ رَ.<verse eid="EZK 19:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="EZK 19:9"/>عٍ نَشَ عَ رَ سٌ كُلّ كُي وُرٍيٍ رَ،</para>
  <para style="q" vid="EZK 19:9">عٍ عَ شَنِن بَبِلْن مَنفّ شْن مَ.</para>
  <para style="q" vid="EZK 19:9">مّننِ عٍ نَشَ عَ رَ سٌ فٍيلِ كُي.</para>
  <para style="q" vid="EZK 19:9">عَ يِرِندِن شُي مُ مّ عِسِرَيِلَ فٍيَيٍ قَرِ سْنْن.»<verse eid="EZK 19:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="EZK 19:10"/>«وٌ نفَ نُ لُشِ نّ عَلْ وّنِ بِلِ نَشَن سِشِ شُرٍ دّ رَ.</para>
  <para style="q" vid="EZK 19:10">عَ نُ بٌفِمَ، عَ سَلٌنيِيٍ نُ وُيَ،</para>
  <para style="q" vid="EZK 19:10">بَرِ مَ يٍ نُ فبٌ عَ يِرٍ.<verse eid="EZK 19:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="EZK 19:11"/>سَلٌن قَنيِيٍ نُ نَ عَ بّ،</para>
  <para style="q" vid="EZK 19:11">نَشٍيٍ قَن مَنفّ سَوُرِ رَ.</para>
  <para style="q" vid="EZK 19:11">عَ نُ تِشِ سَنسِيٍ بِرِن شُن مَ</para>
  <para style="q" vid="EZK 19:11">عَ شَ مَءِتٍ نُن عَ سَلٌن وُيَشِيٍ شَ قٍ رَ.<verse eid="EZK 19:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="EZK 19:12"/>كْنْ عَ بَرَ تَلَ شْنّ كُي، عَ رَبِرَ بْشِ مَ.</para>
  <para style="q" vid="EZK 19:12">سٌفٍتٍدٍ قٌيٍ نَشَ عَ شَرَ، عَ بٌفِيٍ كَنَ.</para>
  <para style="q" vid="EZK 19:12">عَ سَلٌن قَنيِيٍ نَشَ لِسِ، تّ نَشَ عٍ فَن.<verse eid="EZK 19:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="EZK 19:13"/>يَكْسِ عَ سِشِ فبٍنفبٍرٍنيِ نَن مَ،</para>
  <para style="q" vid="EZK 19:13">بْشِ شْرْشْي، يٍ مُ نَ دّننَشّ.<verse eid="EZK 19:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="EZK 19:14"/>تّ بَرَ مِنِ عَ سَلٌنيِ ندٍ كُي، عَ عَ بٌفِيٍ فَن.</para>
  <para style="q" vid="EZK 19:14">سَلٌن قَنيِ يٌ مُ نَ عَ بّ سْنْن،</para>
  <para style="q" vid="EZK 19:14">نَشَن قِندِ مَ مَنفّ سَوُرِ رَ.»</para>
  <para style="m" vid="EZK 19:14">كِنِكِنِ سُوكِ نَن نَ كِ نَشَن بَمَ نِمِسّ كُي.<verse eid="EZK 19:14"/></para>
  <chapter eid="EZK 19"/>
  <chapter number="20" style="c" sid="EZK 20"/>
  <para style="s">عِسِرَيِلَ بْنسْي شَ مَتَندِ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 20:1"/>عَ حّ سٌلٌقٍرٍ ندٍ، كِكٍ سُولِ، شِ قُ ندٍ رَ، عِسِرَيِلَ قٌرِ ندٍيٍ نَشَ قَ ﭑ يِرٍ، عٍ شَ عَلَتَلَ شَ مَرَ سِ قٍن. <verse eid="EZK 20:1"/><verse number="2" style="v" sid="EZK 20:2"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، عَ نَشّ، <verse eid="EZK 20:2"/><verse number="3" style="v" sid="EZK 20:3"/>«عَدَ مَدِ، عِسِرَيِلَ قٌرِيٍ مَشْرِن مُنقٍ رَ عٍ قَشِ ﭑ مَ مَرَ سِ قٍندٍ، ﭑ تٌ عَ قَلَ عٍ بّ ﭑ مُ تِن عٍ شَ ﭑ مَشَندِ نَ كِ. عَلَتَلَ شُي نَن نَ كِ.»<verse eid="EZK 20:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 20:4"/>«عَدَ مَدِ، عِ شَ عٍ مَكِيتِ عٍ شَ قٍ حَاشِيٍ نُن عٍ بٍنبَيٍ شَ قٍ حَاشِيٍ شَ قٍ رَ. <verse eid="EZK 20:4"/><verse number="5" style="v" sid="EZK 20:5"/>عَ قَلَ عٍ بّ، ‹وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛ ﭑ عِسِرَيِلَ سُفَندِ تّمُي نَشّ، ﭑ نَ ﭑ كَلِ نّ ﭑ بّلّشّ عِتٍشِ رَ يَشُبَ بْنسْي بّ عَ ﭑ تَن نَن نَ عٍ مَرِفِ عَلَتَلَ رَ. ﭑ نَ ﭑ يّتّ مَسٍن عٍ بّ مِسِرَ بْشِ مَ، <verse eid="EZK 20:5"/><verse number="6" style="v" sid="EZK 20:6"/>ﭑ قَ ﭑ كَلِ عٍ بّ عَ ﭑ عٍ رَ مِنِمَ نّ مّننِ سِفَقٍ رَ بْشِ قَنيِ مَ، ﭑ دّننَشّ سُفَندِشِ عٍ بّ، كُمِ نُن شِحّ شّلّمَ بْشِ نَشَن مَ. <verse eid="EZK 20:6"/><verse number="7" style="v" sid="EZK 20:7"/>ﭑ عَ مَسٍن عٍ بّ، عٍ شَ مِسِرَ كُيٍيٍ وْلّ، عَلَكٌ عٍ نَشَ قَ عٍ يّتّ قِندِ سّنِيّنتَرٍيٍ رَ. ﭑ تَن نَن نَ عٍ مَرِفِ عَلَتَلَ رَ.›»<verse eid="EZK 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 20:8"/>«كْنْ عٍ نَشَ ﭑ شُي مَتَندِ. عٍ مُ مِسِرَ كُيٍيٍ وْلّ، عٍ مُ فبِلٍن نٍيٍ قْشْ رَ. نَ كُي ﭑ نَشَ عَ مَسٍن عٍ بّ عَ ﭑ قَمَ نّ ﭑ مَ شْنّ رَدِندٍ عٍ مَ مِسِرَ بْشِ مَ. <verse eid="EZK 20:8"/><verse number="9" style="v" sid="EZK 20:9"/>نَ دَنفِ شَنبِ، ﭑ نَشَ نَتّ تٌنفٌ ﭑ شَ عٍ رَ مِنِ نَا، عَلَكٌ ﭑ شِلِ نَشَ قَ مَبٍرٍ حَمَنّيٍ تَفِ عٍ نُ دّننَشّ. <verse eid="EZK 20:9"/><verse number="10" style="v" sid="EZK 20:10"/>ﭑ نَشَ عٍ رَ مِنِ مِسِرَ بْشِ رَ، ﭑ قَ عٍ شُن تِ فبٍنفبٍرٍنيِ رَ. <verse eid="EZK 20:10"/><verse number="11" style="v" sid="EZK 20:11"/>مّننِ ﭑ نَشَ ﭑ مَ يَامَرِيٍ سٌ عٍ يِ رَ، ﭑ عٍ رَكٌلٌن ﭑ مَ سّرِيّ رَ. مِشِ نَشٍيٍ بِرَ مَ نٍيٍ قْشْ رَ، عٍ كِسِمَ نّ. <verse eid="EZK 20:11"/><verse number="12" style="v" sid="EZK 20:12"/>ﭑ نَشَ مَلَبُي لْشْي شَ يَامَرِ قَن قِ عٍ مَ تْنشُمَ رَ ﭑ تَن نُن عٍ تَن تَفِ، عَلَكٌ عٍ شَ عَ كٌلٌن ﭑ تَن عَلَتَلَ نَن عٍ رَ سّنِيّنمَ.»<verse eid="EZK 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 20:13"/>«كْنْ عِسِرَيِلَ بْنسْي نَشَ عٍ كٌبٍ رَ سٌ ﭑ نَ فبٍنفبٍرٍنيِ مَ. عٍ ﭑ مَ مَلَبُي لْشْي شَ يَامَرِ مَبٍرٍ. عٍ مُ بِرَ ﭑ مَ يَامَرِيٍ قْشْ رَ، عٍ مُ ﭑ مَ سّرِيّ سُشُ، نَشٍيٍ نُ نْمَ عٍ رَكِسِدٍ. نَ كُي ﭑ نَشَ عَ نَتّ، ﭑ شَ ﭑ مَ شْنّ بِرِن نَمِنِ عٍ مَ، ﭑ شَ عٍ سْنتْ فبٍنفبٍرٍن يِرٍ. <verse eid="EZK 20:13"/><verse number="14" style="v" sid="EZK 20:14"/>هَلِ ﭑ مُ نَ رَبَ، عَلَكٌ ﭑ شِلِ نَشَ قَ مَبٍرٍ حَمَنّيٍ تَفِ، ﭑ عٍ رَ مِنِ نَشٍيٍ يَ شْرِ مِسِرَ بْشِ رَ، <verse eid="EZK 20:14"/><verse number="15" style="v" sid="EZK 20:15"/>ﭑ نَشَ ﭑ كَلِ ﭑ بّلّشّ عِتٍشِ رَ فبٍنفبٍرٍنيِ مَ، عَ ﭑ مُ عٍ شَنِنمَ نَ بْشِ قَنيِ مَ سْنْن، ﭑ نُ بَرَ نَشَن قِ عٍ مَ، شِحّ نُن كُمِ شّلّمَ دّننَشّ. <verse eid="EZK 20:15"/><verse number="16" style="v" sid="EZK 20:16"/>ﭑ نَ نَتّ تٌنفٌ نّ، بَرِ مَ عٍ نُ ﭑ مَ يَامَرِيٍ نُن ﭑ مَ سّرِيّ نَن مَبٍرٍ مَ، عٍ تٌندِ ﭑ مَ مَلَبُي لْشْي شَ يَامَرِ سُشُدٍ عَ كِ مَ. عٍ شَ كُيٍ قٍ نَن نُ نَ عٍ بْحّ مَ. <verse eid="EZK 20:16"/><verse number="17" style="v" sid="EZK 20:17"/>كْنْ ﭑ نَشَ كِنِكِنِ عٍ مَ، ﭑ مُ عٍ سْنتْ فبٍنفبٍرٍنيِ مَ. <verse eid="EZK 20:17"/><verse number="18" style="v" sid="EZK 20:18"/>ﭑ نَشَ عَ مَسٍن عٍ شَ دِيٍ بّ مّننِ، ﭑ نَشّ، ‹وٌ نَشَ بِرَ وٌ بٍنبَيٍ شَ يَامَرِيٍ نُن عٍ شَ سّرِيّ قْشْ رَ دٍ. وٌ نَشَ وٌ يّتّ قِندِ سّنِيّنتَرٍيٍ رَ عٍ شَ كُيٍيٍ بَتُقٍ رَ. <verse eid="EZK 20:18"/><verse number="19" style="v" sid="EZK 20:19"/>ﭑ تَن نَن نَ وٌ مَرِفِ عَلَتَلَ رَ. وٌ شَ بِرَ ﭑ تَن نَن مَ يَامَرِيٍ قْشْ رَ، وٌ شَ ﭑ مَ سّرِيّ سُشُ. <verse eid="EZK 20:19"/><verse number="20" style="v" sid="EZK 20:20"/>وٌ شَ ﭑ مَ مَلَبُي لْشْي رَ سّنِيّن، عَلَكٌ نَ شَ قِندِ تْنشُمَ رَ وٌن تَفِ. نَ كُي وٌ عَ كٌلٌنمَ نّ عَ ﭑ تَن نَن نَ وٌ مَرِفِ عَلَتَلَ رَ.›»<verse eid="EZK 20:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 20:21"/>«كْنْ عِسِرَيِلَ دِيٍ نَشَ مُرُتَ ﭑ مَ، عٍ مُ ﭑ مَ يَامَرِيٍ رَبَتُ، عٍ مُ عٍ حْشْ سَ ﭑ مَ سّرِيّ شْن مَ نَشَن مِشِ رَكِسِمَ، عٍ قَ ﭑ مَ مَلَبُي لْشْي شَ يَامَرِ مَبٍرٍ. نَ كُي ﭑ نَشَ عَ مَسٍن، ﭑ شَ ﭑ مَ شْنّ بِرِن نَمِنِ عٍ مَ فبٍنفبٍرٍن يِرٍ. <verse eid="EZK 20:21"/><verse number="22" style="v" sid="EZK 20:22"/>كْنْ ﭑ مُ نَ رَبَ، عَلَكٌ ﭑ شِلِ نَشَ قَ مَبٍرٍ حَمَنّيٍ تَفِ، ﭑ عٍ رَ مِنِ نَشٍيٍ يَ شْرِ مِسِرَ بْشِ رَ. <verse eid="EZK 20:22"/><verse number="23" style="v" sid="EZK 20:23"/>كْنْ ﭑ نَ ﭑ كَلِ ﭑ بّلّشّ عِتٍشِ نَن نَ فبٍنفبٍرٍنيِ مَ، ﭑ شَ عٍ رَيٍنسٍن يّ حَمَنّيٍ تَفِ، <verse eid="EZK 20:23"/><verse number="24" style="v" sid="EZK 20:24"/>بَرِ مَ عٍ مُ ﭑ مَ سّرِيّ رَبَتُ، عٍ ﭑ مَ يَامَرِيٍ مَتَندِ، عٍ ﭑ مَ مَلَبُي لْشْي شَ يَامَرِ مَبٍرٍ، عٍ مَن قَ عٍ يَ رَقِندِ عٍ بٍنبَيٍ شَ كُيٍيٍ مَ. <verse eid="EZK 20:24"/><verse number="25" style="v" sid="EZK 20:25"/>ﭑ نَشَ عٍ لُ عٍ شَ بِرَ عٍ يّتّ شَ يَامَرِ حَاشِيٍ قْشْ رَ، سّرِيّ مْولِ ندٍ نَشَن مُ نْمَ سْونّيَدٍ. <verse eid="EZK 20:25"/><verse number="26" style="v" sid="EZK 20:26"/>ﭑ نَشَ عَ لُ عٍ شَ قِندِ سّنِيّنتَرٍيٍ رَ سّرّشّ مْولِ ندٍ شَ قٍ رَ، مِشِ شَ دِ سِنفٍ قَشَمَ سّرّشّ نَشَن مَ قٍ رَ. ﭑ نُ وَ مَ نّ عٍ شَ نَ قْشِ مَفَاشُشِ تٌ، عَلَكٌ عٍ شَ عَ كٌلٌن عَ ﭑ تَن نَن نَ عَلَتَلَ رَ.»<verse eid="EZK 20:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EZK 20:27"/>«عَدَ مَدِ، عِ شَ عَ قَلَ عِسِرَيِلَ بْنسْييٍ بّ، عِ نَشّ، ‹وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛ وٌ بٍنبَيٍ بَرَ ﭑ قِنسِرِوَلِ، عٍ بَرَ ﭑ يَنقَ. <verse eid="EZK 20:27"/><verse number="28" style="v" sid="EZK 20:28"/>ﭑ تٌ بَرَ عٍ رَ سٌ بْشِ مَ، ﭑ نَ ﭑ كَلِ نَشَن نَ قِقٍ رَ عٍ مَ، عٍ نَشَ سّرّشّيٍ بَ قْلْ كُيٍيٍ بّ فٍيَيٍ قَرِ نُن وُرِيٍ بُن مَ. عٍ نُ سُرَيِ فَنمَ عٍ بّ، عٍ مِنسٍ قَن بَ سّرّشّ رَ. نَ بِرِن نَشَ نَ شْنْ كِ قَنيِ رَ، <verse eid="EZK 20:28"/><verse number="29" style="v" sid="EZK 20:29"/>ﭑ قَ عٍ مَشْرِن، مُنسٍ نَ يِ يِرٍ عِتٍشِ رَ وٌ سِفَقٍ دّننَشّ؟ هَن يَ نَ بَتُدٍيٍ شِلِ قَلَمَ يِرٍ عِتٍشِيٍ.›»<verse eid="EZK 20:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 20:30"/>«نَ نَن عَ رَ، عَ قَلَ عِسِرَيِلَ بْنسْي بّ، ‹وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛ وٌ وَ مَ قِندِقٍ سّنِيّنتَرٍيٍ رَ عَلْ وٌ بٍنبَيٍ، وٌ قَ بِرَ عٍ شَ كُيٍ حَاشِيٍ قْشْ رَ؟ <verse eid="EZK 20:30"/><verse number="31" style="v" sid="EZK 20:31"/>وٌ نَ وٌ شَ دِيٍ بَ سّرّشّ رَ تّ شْورَ، وٌ نَ وٌ شَ سّنِيّنيِ نَن كَنَقٍ نَ كِ. عَ لَنمَ ﭑ شَ تِن وٌ شَ ﭑ مَشَندِ؟ ﭑ تَن وٌ مَرِفِ عَلَتَلَ، ﭑ بَرَ ﭑ كَلِ ﭑ مُ وٌ لُمَ وٌ شَ ﭑ مَشَندِ.›»<verse eid="EZK 20:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="EZK 20:32"/>«وٌ نَشّ وٌ وَ مَ نّ لُقٍ عَلْ دُنِحَ حَمَنّيٍ، نَشٍيٍ وُرِ نُن فّمّ بَتُمَ. <verse eid="EZK 20:32"/><verse number="33" style="v" sid="EZK 20:33"/>ﭑ تَن وٌ مَرِفِ عَلَتَلَ، ﭑ بَرَ ﭑ كَلِ عَ ﭑ نَ ﭑ مَ مَنفّيَ رَحّرّ مَ نّ وٌ شُن مَ سّنبّ رَ، ﭑ نَ ﭑ مَ شْنّ بِرِن نَمِنِ وٌ مَ. <verse eid="EZK 20:33"/><verse number="34" style="v" sid="EZK 20:34"/>ﭑ وٌ رَ مِنِمَ نّ حَمَنّيٍ يَ مَ سّنبّ رَ، ﭑ وٌ مَلَن يِرٍ كٍرٍن ﭑ مَ شْنّ كُي. <verse eid="EZK 20:34"/><verse number="35" style="v" sid="EZK 20:35"/>ﭑ وٌ شَنِنمَ نّ فبٍنفبٍرٍنيِ مَ حَمَنّيٍ تَفِ، ﭑ وٌ حَشَنكَتَ مّننِ. <verse eid="EZK 20:35"/><verse number="36" style="v" sid="EZK 20:36"/>ﭑ نَشَن نَبَشِ وٌ بٍنبَيٍ رَ مِسِرَ فبٍنفبٍرٍنيِ مَ، ﭑ نَ قَن نَبَمَ نّ وٌ قَن نَ. وٌ مَرِفِ عَلَتَلَ شُي نَن نَ كِ. <verse eid="EZK 20:36"/><verse number="37" style="v" sid="EZK 20:37"/>ﭑ وٌ رَدَنفِمَ نّ ﭑ مَ يِسُشُوُرِ بُن مَ، ﭑ قَ وٌ رَحّرّ ﭑ مَ سَاتّ رَ. <verse eid="EZK 20:37"/><verse number="38" style="v" sid="EZK 20:38"/>ﭑ مُرُتّلَيٍ نُن مَتَندِلَيٍ بَمَ نّ وٌ يَ مَ، نَشٍيٍ نَ ﭑ فٍرٍقٍ. ﭑ عٍ رَ مِنِمَ نّ بْشِ رَ عٍ سَبَتِشِ دّننَشّ كٌنيِيَ كُي، كْنْ ﭑ مُ عٍ شَنِنمَ عِسِرَيِلَ بْشِ مَ. نَ كُي وٌ قَمَ نّ عَ كٌلٌندٍ عَ ﭑ تَن نَن نَ عَلَتَلَ رَ.»<verse eid="EZK 20:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="EZK 20:39"/>«وٌ تَن عِسِرَيِلَ بْنسْي، وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ وٌ بّ؛ ‹شَ وٌ وَ مَ سِفَقٍ وٌ شَ كُيٍيٍ بَتُدٍ، عَوَ يِرٍ، كْنْ شَ عَ سَ لِ وٌ وٌ تُلِ مَتِمَ ﭑ شِلِ سّنِيّنشِ نَن نَ، وٌ نَشَ ﭑ مَبٍرٍ سْنْن وٌ شَ كُيٍ بَتُي رَ. <verse eid="EZK 20:39"/><verse number="40" style="v" sid="EZK 20:40"/>وٌ مَرِفِ عَلَتَلَ شُي نَن يِ كِ؛ عِسِرَيِلَ بْنسْي قَمَ نّ ﭑ بَتُدٍ يِ فٍيَ عِتٍشِ سّنِيّنشِ قَرِ. ﭑ عٍ رَ سّنّمَ نّ عَ قَنيِ رَ، ﭑ عٍ شَ سّرّشّ سّنِيّنشِيٍ تٌنفٌ عَ نُن عٍ شَ هَدِيَ بِرِن. <verse eid="EZK 20:40"/><verse number="41" style="v" sid="EZK 20:41"/>ﭑ نَ وٌ رَ مِنِ حَمَنّيٍ تَفِ وٌ رَيٍنسٍنشِ دّننَشّ، ﭑ وٌ رَ سّنّمَ نّ عَ قَنيِ رَ، عَلْ سُرَيِ شِرِ قَنيِ. ﭑ نَ ﭑ مَ سّنِيّنيِ مَسٍنمَ نّ حَمَنّيٍ بّ وٌ سَابُي رَ. <verse eid="EZK 20:41"/><verse number="42" style="v" sid="EZK 20:42"/>ﭑ نَ وٌ رَفبِلٍن وٌ شَ بْشِ مَ عِسِرَيِلَ، ﭑ نَ ﭑ كَلِشِ نَشَن قِقٍ رَ وٌ بٍنبَيٍ مَ، وٌ قَمَ نّ عَ كٌلٌندٍ عَ ﭑ تَن نَن نَ عَلَتَلَ رَ. <verse eid="EZK 20:42"/><verse number="43" style="v" sid="EZK 20:43"/>مّننِ، وٌ وٌ رَتُمَ نّ وٌ شَ قٍ حَاشِيٍ بِرِن مَ، نَشٍيٍ وٌ قِندِ مِشِ سّنِيّنتَرٍيٍ رَ، وٌ قَ لُ نَ يَافِ كُي تُن. <verse eid="EZK 20:43"/><verse number="44" style="v" sid="EZK 20:44"/>ﭑ نَ وٌ رَكِسِ ﭑ شِلِ شَ قٍ رَ، ﭑ مُ وٌ شَ وَلِ حَاشِيٍ سَرٍ قِ وٌ مَ، وٌ قَمَ نّ عَ كٌلٌندٍ عَ ﭑ تَن نَن نَ عَلَتَلَ رَ. عِسِرَيِلَ بْنسْي، وٌ مَرِفِ عَلَتَلَ شُي نَن نَ كِ.›»<verse eid="EZK 20:44"/></para>
  <chapter eid="EZK 20"/>
  <chapter number="21" style="c" sid="EZK 21"/>
  <para style="s">حَشَنكَتّ نٍفٍوِ بْشِ بّ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 21:1"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، عَ نَشّ، <verse eid="EZK 21:1"/><verse number="2" style="v" sid="EZK 21:2"/>«عَدَ مَدِ، عِ يَ رَقِندِ عِ يِرٍقَنيِ مَ، عِ كَوَندِ تِ نٍفٍوِ قْتْنيِ بّ. <verse eid="EZK 21:2"/><verse number="3" style="v" sid="EZK 21:3"/>عَ قَلَ؛ ‹نٍفٍوِ قْتْنيِ، عِ عِ تُلِ مَتِ عِ مَرِفِ عَلَتَلَ شَ مَسٍنيِ رَ. عَ شُي نَن يَ؛ ﭑ تّ رَدّشّمَ نّ عِ شْنيِ، نَشَن عِ شَ وُرِ شِندٍيٍ نُن وُرِ شَرٍيٍ بِرِن فَنمَ. نَ تّ مُ تُمَ. عَ قْشِ تٌمَ نّ كٍلِ يِرٍقَنيِ مَ هَن كْولَ مَ. <verse eid="EZK 21:3"/><verse number="4" style="v" sid="EZK 21:4"/>مِشِ بِرِن عَ كٌلٌنمَ نّ عَ ﭑ تَن عَلَتَلَ نَن نَ تّ رَدّشّشِ. عَ مُ تُمَ.›»<verse eid="EZK 21:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 21:5"/>نَ تّمُي ﭑ نَشَ عَ قَلَ عَ بّ، «ﭑ مَرِفِ عَلَتَلَ، حَمَ نَشّ، عَ ﭑ تَالِ وْيّنيِ نَن تُن قَلَمَ.» <verse eid="EZK 21:5"/><verse number="6" style="v" sid="EZK 21:6"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، <verse eid="EZK 21:6"/><verse number="7" style="v" sid="EZK 21:7"/>«عَدَ مَدِ، عِ يَ رَقِندِ دَرِ سَلَمُ مَ، عِ شَ كَوَندِ تِ هْرْ مْلِنفِرَ شَ قٍ رَ. عِ شَ مَسٍنيِ تِ ﭑ شِلِ رَ عِسِرَيِلَ شِلِ مَ. <verse eid="EZK 21:7"/><verse number="8" style="v" sid="EZK 21:8"/>عَ قَلَ عِسِرَيِلَ حَمَ بّ؛ ‹عَلَتَلَ يِ نَن مَسٍنشِ؛ ﭑ تِشِ وٌ كَنكٍ. ﭑ نَ ﭑ مَ سَنتِدّفّمَ بَمَ نّ عَ تّي عِ، ﭑ قَ وٌ شَ تِنشِنتْييٍ نُن وٌ شَ تِنشِنتَرٍيٍ قَشَ. <verse eid="EZK 21:8"/><verse number="9" style="v" sid="EZK 21:9"/>ﭑ تٌ نَتّ تٌنفٌ تِنشِنتْييٍ نُن تِنشِنتَرٍيٍ شِلِ مَ، ﭑ مَ سَنتِدّفّمَ بَمَ نّ عَ تّي عِ يِ حَمَ بِرِن شَ قٍ رَ، نَشٍيٍ نَ يِرٍقَنيِ نُن كْولَ مَ. <verse eid="EZK 21:9"/><verse number="10" style="v" sid="EZK 21:10"/>نَ كُي، بِرِن عَ كٌلٌنمَ نّ، عَ ﭑ تَن نَن ﭑ مَ سَنتِدّفّمَ رَ مِنِشِ عَ تّي عِ وٌ شِلِمَ. ﭑ مُ عَ رَ سٌمَ سْنْن.›»<verse eid="EZK 21:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 21:11"/>«عَدَ مَدِ، عِ شَ عِ وَ شُي رَ مِنِ عِ بْحّ تْورْشِ سُننُنشِ شْرْشْي شَ قٍ رَ. <verse eid="EZK 21:11"/><verse number="12" style="v" sid="EZK 21:12"/>عٍ نَ عِ مَشْرِن عِ وَقٍ قٍ نَشَن مَ، عِ شَ عٍ يَابِ، ‹شِبَارُ شْرْشْي بَرَ ﭑ لِ. لِمَنِيَ بَمَ نّ مِشِ بِرِن يِ رَ نَ شَ قٍ رَ. مِشِ بِرِن بْحّ كْنتْقِلِمَ نّ، مِشِ بِرِن سَنيِ سّرّن فَاشُي كُي.› ﭑ شَ عَ قَلَ عِ بّ، عَ نَ قَقٍ. عِ مَرِفِ عَلَتَلَ شُي نَن نَ كِ.»<verse eid="EZK 21:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 21:13"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، <verse eid="EZK 21:13"/><verse number="14" style="v" sid="EZK 21:14"/>«عَدَ مَدِ، ﭑ مَ شّيرَ عِبَ، عَ قَلَقٍ رَ، ‹وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ، عَ نَشّ؛</para>
  <para style="q" vid="EZK 21:14">سَنتِدّفّمَ قَنيِ، سَنتِدّفّمَ شَحّنشِ!<verse eid="EZK 21:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="EZK 21:15"/>سَنتِدّفّمَ نَشَن فبَلٌي رَبَمَ،</para>
  <para style="q" vid="EZK 21:15">سَنتِدّفّمَ نَشَن دَنفِمَ عَلْ سٍيَمَكْنيِ.</para>
  <para style="q" vid="EZK 21:15">وٌن نْمَ حّلّشِندٍ ﭑ مَ دِ شَ مَنفّ سَ وُرِ رَ؟</para>
  <para style="q" vid="EZK 21:15">عَدٍ، سَنتِدّفّمَ قَمَ نّ بِرِن شُن نَكَنَدٍ.<verse eid="EZK 21:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="EZK 21:16"/>سَنتِدّفّمَ قَشِ نّ عَ قٍ شَ سْونّيَ،</para>
  <para style="q" vid="EZK 21:16">عَ شَحّن، عَ سُشُشِ قَشّتِ يِ رَ.<verse eid="EZK 21:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="EZK 21:17"/>عَدَ مَدِ، عِ وَ شُي عِتٍ،</para>
  <para style="q" vid="EZK 21:17">بَرِ مَ نَ سَنتِدّفّمَ تِمَ نّ ﭑ مَ حَمَ كَنكٍ،</para>
  <para style="q" vid="EZK 21:17">عَ عِسِرَيِلَ مَنفّيٍ قَشَ، عَ نُن ﭑ مَ حَمَ.</para>
  <para style="q" vid="EZK 21:17">نَ كُي، عِ كَنكٍ مَدِن سُننُنيِ كُي.›»<verse eid="EZK 21:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="EZK 21:18"/>«مَتٌي نَن عَ رَ.</para>
  <para style="q" vid="EZK 21:18">مُنسٍ قَمَ رَبَدٍ شَ يُدَيَ مَنفّيَ مُ قَ نْ تِدٍ يِ سَنتِدّفّمَ يَرَ؟</para>
  <para style="q" vid="EZK 21:18">وٌ مَرِفِ عَلَتَلَ شُي نَن نَ كِ.»<verse eid="EZK 21:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="EZK 21:19"/>«عَدَ مَدِ، عِ شَ مَسٍنيِ تِ ﭑ شِلِ رَ.</para>
  <para style="q" vid="EZK 21:19">عِ شَ عِ بّلّشّيٍ بْنبْ كٍرٍن.</para>
  <para style="q" vid="EZK 21:19">سَنتِدّفّمَ مَن شَ بْنبْ قِرِن، عَ شَ بْنبْ سَشَن.</para>
  <para style="q" vid="EZK 21:19">سَنتِدّفّمَ نَن عَ رَ نَشَن فبَلٌي رَبَمَ،</para>
  <para style="q" vid="EZK 21:19">نَشَن قَشّ تِمَ يِرٍ بِرِن.<verse eid="EZK 21:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="EZK 21:20"/>نَ كُي لِمَنِيَ بَمَ نّ مِشِيٍ يِ رَ،</para>
  <para style="q" vid="EZK 21:20">مِشِ فبٍفبٍ سْنتْ.</para>
  <para style="q" vid="EZK 21:20">ﭑ مَ سَنتِدّفّمَ تِمَ نّ نَادّيٍ بِرِن نَ قَشّ تِقٍ رَ.</para>
  <para style="q" vid="EZK 21:20">عَ دَنفِمَ نّ عَلْ سٍيَمَكْنيِ.<verse eid="EZK 21:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="EZK 21:21"/>سَنتِدّفّمَ شَبّ تِمَ نّ يِرٍقَنيِ مَ،</para>
  <para style="q" vid="EZK 21:21">عَ شَبّ تِ كْولَ مَ،</para>
  <para style="q" vid="EZK 21:21">عَ دّ يَ رَقِندِشِ يِرٍ بِرِن مَ.<verse eid="EZK 21:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="EZK 21:22"/>نَ تّمُي، ﭑ تَن عَلَتَلَ قَمَ نّ ﭑ بّلّشّيٍ بْنبْدٍ،</para>
  <para style="q" vid="EZK 21:22">ﭑ مَ شْنّ قَ دَن.</para>
  <para style="q" vid="EZK 21:22">عَلَتَلَ شُي نَن نَ كِ.»<verse eid="EZK 21:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 21:23"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، عَ نَشّ، <verse eid="EZK 21:23"/><verse number="24" style="v" sid="EZK 21:24"/>«عَدَ مَدِ، عِ نَشَن نَبَمَ، عِ شَ كِرَ قِرِن نَبْو بَبِلْن مَنفّ شَ سَنتِدّفّمَ حّرّ مَ نَشٍيٍ رَ. عٍ قِرِن شَ كٍلِ يِرٍ كٍرٍن، تْنشُمَ شَ تِ يِرٍ ندٍ عٍ قَتَنمَ دّننَشّ. <verse eid="EZK 21:24"/><verse number="25" style="v" sid="EZK 21:25"/>كِرَ كٍرٍن شَ سِفَ عَمٌرِكَيٍ شْنيِ نَشَن شِلِ رَابَ. كِرَ قِرِن ندٍ شَ سِفَ يُدَيَ شَ تَا مَكَنتَشِ نَشَن شِلِ دَرِ سَلَمُ. <verse eid="EZK 21:25"/><verse number="26" style="v" sid="EZK 21:26"/>بَبِلْن مَنفّ تِمَ نّ نَ كِرَ قِرِن شُنيِ رَ، عَ شَ سٍمَتٌي وَلِ رَبَ عَلْ شَلِيٍ مَوٌلِقٍ، كُيٍيٍ مَشْرِنقٍ، نُن سُبٍ بْحّ مَتٌقٍ. <verse eid="EZK 21:26"/><verse number="27" style="v" sid="EZK 21:27"/>نَ سٍمَتٌي وَلِ عَ مَسٍنمَ نّ عَ بّ عَ شَ سِفَ دَرِ سَلَمُ مَبِرِ، عَ شَ فٍرٍ سٌسٍيٍ تٌنفٌ تّتّ لٌنفٌرِ رَ، عَ شَ نَ نَادّيٍ رَبِرَ، عَ قَ فبَلٌي تِ تَا كُي. <verse eid="EZK 21:27"/><verse number="28" style="v" sid="EZK 21:28"/>دَرِ سَلَمُكَيٍ تٌ سَاتّ شِرِ عٍ نُن بَبِلْن مَنفّ رَ، عٍ نَ سٍمَتٌي وَلِ تٌمَ وُلٍ نَن نَ. كْنْ بَبِلْن مَنفّ مُ عَ تُلِ مَتِمَ عٍ رَ، بَرِ مَ عَ نَشّ عٍ قَن بَرَ هَاكّ سْتْ عَ مَبِرِ. نَ نَن عَ رَ، عَ عٍ شَنِنمَ كٌنيِيَ كُي.»<verse eid="EZK 21:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EZK 21:29"/>«وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛ وٌ شَ وَلِ حَاشِ بَرَ عَ نِيَ ﭑ شَ رَتُ وٌ شَ يُنُبِ دَنفِشِيٍ مَ، ﭑ شَ وٌ شَنِن كٌنيِيَ كُي. <verse eid="EZK 21:29"/><verse number="30" style="v" sid="EZK 21:30"/>عِ تَن عِسِرَيِلَ مَنفّ تِنشِنتَرٍ، عِ شَ حَشَنكَتّ لْشْي بَرَ عَ لِ. <verse eid="EZK 21:30"/><verse number="31" style="v" sid="EZK 21:31"/>عِ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ، عَ نَشّ، ‹مَنفّ تْنشُمَ بَ عِ شُنيِ مَ! مَنفّيَ بَرَ بَ عِ يِ رَ. مِشِ مَفٌرٌشِ شَ قٍ عِتٍمَ نّ، مِشِ مَتٍشِ شَ قٍ مَفٌرٌ. <verse eid="EZK 21:31"/><verse number="32" style="v" sid="EZK 21:32"/>عِ شَ مَنفّيَ شُن نَكَنَمَ نّ، عَ حْن. نَ مَنفّيَ مُ فبِلٍنمَ عَ رَ قٌ مِشِ قَ، عَ لَن عَ شَ سٌ نَشَن يِ رَ. نَ قِمَ نَ كَنيِ نَن مَ.›»<verse eid="EZK 21:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EZK 21:33"/>«عَدَ مَدِ، عِ شَ مَسٍنيِ تِ ﭑ شِلِ رَ عَ قَلَقٍ رَ، ‹عَلَتَلَ يِ نَن مَسٍنشِ عَمٌنِكَيٍ شَ كٌنبِيٍ شَ قٍ رَ، عَ نَشّ؛</para>
  <para style="q" vid="EZK 21:33">سَنتِدّفّمَ بَرَ بَ عَ تّي عِ فبَلٌي شَ قٍ رَ.</para>
  <para style="q" vid="EZK 21:33">عَ بَرَ رَشَحّن عَلَكٌ عَ شَ قَشّ تِ عَلْ سٍيَمَكْنيِ.<verse eid="EZK 21:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="EZK 21:34"/>وٌ بَرَ لَ وُلٍ لَامَتُنيِيٍ رَ،</para>
  <para style="q" vid="EZK 21:34">وٌ بَرَ وٌ تُلِ مَتِ سٍمَتٌي وُلٍ قَلّيٍ رَ.</para>
  <para style="q" vid="EZK 21:34">نَ كُي نَ سَنتِدّفّمَ تِمَ نّ تِنشِنتَرٍيٍ كْن نَ،</para>
  <para style="q" vid="EZK 21:34">نَشٍيٍ لَنمَ عٍ شَ حَشَنكَتَ عٍ شَ يُنُبِ كَمَلِشِيٍ شَ قٍ رَ.<verse eid="EZK 21:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="EZK 21:35"/>وٌ شَ وٌ شَ سَنتِدّفّمَ رَفبِلٍن عَ تّي عِ.</para>
  <para style="q" vid="EZK 21:35">ﭑ وٌ مَكِيتِمَ نّ وٌ شَ بْشِ مَ وٌ دَاشِ دّننَشّ.<verse eid="EZK 21:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="EZK 21:36"/>ﭑ نَ ﭑ مَ شْنّ شْرْشْي رَ مِنِمَ نّ وٌ مَ،</para>
  <para style="q" vid="EZK 21:36">ﭑ وٌ سٌ شّمّ حَاشِيٍ يِ رَ نَشٍيٍ قَتَ فبَلٌي رَ.<verse eid="EZK 21:36"/></para>
  <para style="q">
    <verse number="37" style="v" sid="EZK 21:37"/>وٌ لُمَ نّ عَلْ يٍفٍ تّ شْورَ،</para>
  <para style="q" vid="EZK 21:37">وٌ وُلِ عِقِلِ وٌ شَ بْشِ مَ،</para>
  <para style="q" vid="EZK 21:37">وٌ شِلِ حْن قٍوٌ.</para>
  <para style="q" vid="EZK 21:37">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.›»<verse eid="EZK 21:37"/></para>
  <chapter eid="EZK 21"/>
  <chapter number="22" style="c" sid="EZK 22"/>
  <para style="s">دَرِ سَلَمُ شَ يُنُبِيٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 22:1"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، عَ نَشّ، <verse eid="EZK 22:1"/><verse number="2" style="v" sid="EZK 22:2"/>«عَدَ مَدِ، عَ مُ لَنمَ شّ عِ شَ يِ تَا قَشّتِ مَكِيتِ، عِ شَ عَ رَكٌلٌن عَ شَ وَلِ كٌبِيٍ بِرِن نَ؟ <verse eid="EZK 22:2"/><verse number="3" style="v" sid="EZK 22:3"/>عَ قَلَ عَ بّ، ‹وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛ تَا نَن يِ كِ، نَشَن شُن نَكَنَمَ عَ شَ قَشّ تِقٍ رَ، نَشَن عَ قِندِ مَ تَا سّنِيّنتَرٍ رَ عَ شَ كُيٍ بَتُقٍ رَ. <verse eid="EZK 22:3"/><verse number="4" style="v" sid="EZK 22:4"/>وٌ بَرَ يُنُبِ سْتْ نَ قَشّ تِقٍ كُي، وٌ بَرَ سّنِيّنتَرٍحَ سْتْ نَ كُيٍيٍ بَتُقٍ رَ، وٌ نَشٍيٍ يَءِلَنشِ وٌ بّلّشّ رَ. عَ فبٍ مُ لُشِ وٌ شَ سِمَيَ شَ حْن، سِ فبّتّيٍ شَ وٌ شِلِ مَبٍرٍ. <verse eid="EZK 22:4"/><verse number="5" style="v" sid="EZK 22:5"/>سِ نَشٍيٍ نَ رَبِلِنيِ نُن سِ نَشٍيٍ نَ يِرٍ مَكُيٍ، عٍ بِرِن وٌ مَيٍلٍمَ نّ وٌ شَ يُنُبِيٍ شَ قٍ رَ. وٌ شَ قٍ شْرْشْ!›»<verse eid="EZK 22:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 22:6"/>«وٌ شَ مَنفّيٍ قَشّ تِمَ عٍ شَ نْي سَابُي رَ، <verse eid="EZK 22:6"/><verse number="7" style="v" sid="EZK 22:7"/>عٍ مِشِيٍ بَبَ نُن عٍ نفَ مَبٍرٍ مَ، عٍ وٌ شَ شْحّ نُن وٌ شَ كِرِدِيٍ تْورْ مَ. <verse eid="EZK 22:7"/><verse number="8" style="v" sid="EZK 22:8"/>وٌ ﭑ مَ سٍ سّنِيّنشِيٍ بْتّ بَشِ، وٌ ﭑ مَ مَلَبُي لْشْييٍ مَبٍرٍ مَ. <verse eid="EZK 22:8"/><verse number="9" style="v" sid="EZK 22:9"/>تْوحّفّلَيٍ نَ وٌ يَ مَ نَشٍيٍ قَشّ تِمَ. كُيٍ بَتُيٍ نَ وٌ يَ مَ نَشٍيٍ سّرّشّ بَمَ فٍيَ قَرِ، عٍ قَ يّنّ حَاشِ رَبَ نَا. <verse eid="EZK 22:9"/><verse number="10" style="v" sid="EZK 22:10"/>شّمّيٍ نَ نَ نَشٍيٍ سَمَ عٍ بَبَ شَ فِنّ قّ مَ، عٍ فِنّ مَسَمَ نَشَن مُ سّنِيّنشِ عَ شَ كِكٍ وَلِ شَ قٍ رَ، <verse eid="EZK 22:10"/><verse number="11" style="v" sid="EZK 22:11"/>عٍ يّنّ رَبَمَ عٍ دْشْبٌورٍ شَ فِنّ رَ، عٍ يّنّ رَبَمَ عٍ شَ دِ شَ فِنّ رَ، عٍ يّنّ رَبَمَ عٍ مَافِنّ يَتِ رَ عٍ نُن نَشَن بَبَ كٍرٍن. <verse eid="EZK 22:11"/><verse number="12" style="v" sid="EZK 22:12"/>مِشِيٍ نَ وٌ يَ مَ نَشٍيٍ سَرٍ رَ سُشُمَ مِشِ قَشَقٍ مَ. ندٍيٍ نَ نَ نَشٍيٍ فٍينِ سَمَ دٌنِ قَرِ، عٍ قُمَ عٍ نفَشَكٍرٍنيِ مَ. وٌ بَرَ نّيمُ ﭑ تَن مَ! عَلَتَلَ شُي نَن نَ كِ.»<verse eid="EZK 22:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 22:13"/>«ﭑ نَ ﭑ بّلّشّ بْنبْمَ نّ شْنّ كُي وٌ شَ نَاقُلِ تِنشِنتَرٍ نُن وٌ شَ قَشّ تِقٍ شَ قٍ رَ <verse eid="EZK 22:13"/><verse number="14" style="v" sid="EZK 22:14"/>سّنبّ لُمَ وٌ بّ ﭑ مَ كِيتِ سَ لْشْي؟ وٌ سُو سَمَ ﭑ نَ؟ ﭑ شَ عَ قَلَ وٌ بّ، ﭑ وٌ حَشَنكَتَمَ نّ. عَلَتَلَ شُي نَن نَ كِ. <verse eid="EZK 22:14"/><verse number="15" style="v" sid="EZK 22:15"/>ﭑ وٌ رَيٍنسٍنمَ نّ حَمَنّيٍ مَ، ﭑ وٌ رَيٍنسٍن يّ بْشِ بِرِن مَ. ﭑ وٌ شَ سّنِيّنتَرٍحَ حْنمَ نّ. <verse eid="EZK 22:15"/><verse number="16" style="v" sid="EZK 22:16"/>وٌ نَ لُ يَافِ كُي حَمَنّيٍ تَفِ، وٌ قَمَ نّ عَ كٌلٌندٍ عَ ﭑ تَن نَن نَ عَلَتَلَ رَ.»<verse eid="EZK 22:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 22:17"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، عَ نَشّ، <verse eid="EZK 22:17"/><verse number="18" style="v" sid="EZK 22:18"/>«عَدَ مَدِ، عِسِرَيِلَ بْنسْي بَرَ لُ ﭑ بّ عَلْ فبٍتِ فبِ شَبُدٍ. عٍ مَنِيَشِ نَ وُرٍ فبٍيلِ نَن نَ، يْشُي، وُرٍ، نُن سُنبُي نَشَن بَمَ فبٍتِ رَشُنُشِ رَ. <verse eid="EZK 22:18"/><verse number="19" style="v" sid="EZK 22:19"/>نَ كُي، مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛ ‹وٌ تٌ بَرَ لُ عَلْ فبٍتِ فبِ، ﭑ وٌ مَلَنمَ نّ دَرِ سَلَمُ، <verse eid="EZK 22:19"/><verse number="20" style="v" sid="EZK 22:20"/>ﭑ مَ شْنّ قَ وٌ رَشُنُ عَلْ فبٍتِ، وُرٍ فبٍيلِ، وُرٍ، يْشُي، نُن سُنبُي رَشُنُمَ كِ نَشّ تّ رَ. <verse eid="EZK 22:20"/><verse number="21" style="v" sid="EZK 22:21"/>ﭑ وٌ مَلَنمَ نّ ﭑ مَ بْحّتٍ كُي، ﭑ قَ وٌ رَشُنُ دَرِ سَلَمُ تَا كُي. <verse eid="EZK 22:21"/><verse number="22" style="v" sid="EZK 22:22"/>وٌ نَ رَشُنُ نَا، وٌ عَ كٌلٌنمَ نّ عَ ﭑ تَن نَن نَ عَلَتَلَ رَ، نَشَن عَ شَ شْنّ رَدِنشِ وٌ مَ.›»<verse eid="EZK 22:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 22:23"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، عَ نَشّ، <verse eid="EZK 22:23"/><verse number="24" style="v" sid="EZK 22:24"/>«عَدَ مَدِ، عَ قَلَ عِسِرَيِلَ بْشِ بّ، عِ نَشّ؛ ‹بْشِ نَن عِ رَ، نَشَن مُ تُنّ تٌمَ ﭑ مَ شْنّ لْشْي. <verse eid="EZK 22:24"/><verse number="25" style="v" sid="EZK 22:25"/>عِ شَ مَنفّيٍ شَشِلِ لُمَ نّ عَلْ يّتّ شَاحّ نَشَن سُبٍ عِبْو مَ. عٍ نَ نَ مْولِ رَبَقٍ مِشِيٍ رَ. فِنّيٍ نَ قِندِقٍ كَاحّيٍ رَ عٍ شَ قَشّ تِقٍ شَ قٍ رَ. عٍ نَ مُحّ تِقٍ عَلْ قٍ. <verse eid="EZK 22:25"/><verse number="26" style="v" sid="EZK 22:26"/>عِ شَ سّرّشّدُبّيٍ ﭑ مَ سّرِيّ مَتَندِ مَ، عٍ سٍيٍ سّنِيّنشِ قِندِ مَ سٍ سّنِيّنتَرٍ رَ. عٍ مُ سٍ سّنِيّنشِ نُن سٍ سّنِيّنتَرٍ تَفِ رَ سَمَ، عٍ مُ مِشِيٍ قَن نَكٌلٌنمَ نَ تَفِ رَ سَ رَ. عٍ مُ ﭑ مَ مَلَبُي لْشْي شَ يَامَرِ سُشُمَ. نَ بِرِن كُي، عٍ ﭑ شِلِ مَبٍرٍ مَ عٍ يَ مَ. <verse eid="EZK 22:26"/><verse number="27" style="v" sid="EZK 22:27"/>عِ شَ كُنتِفِيٍ لُشِ نّ عَلْ وُلَءِ بَرٍ نَشٍيٍ سُبٍ عِبْو مَ. عٍ مِشِيٍ قَشَ مُحّ تِقٍ مَ. <verse eid="EZK 22:27"/><verse number="28" style="v" sid="EZK 22:28"/>عِ شَ نَمِحْنمّيٍ دُفِ قٍلٍنمَ نَ بِرِن مَ عٍ شَ وُلٍ لَامَتُنيِيٍ نُن عٍ شَ وُلٍ مَسٍنيِيٍ رَ. عٍ نَشّ، «عَلَ نَن عَ مَسٍنشِ،» عَ قَ لِ عَلَ مُ سٍسٍ مَسٍنشِ عٍ بّ. <verse eid="EZK 22:28"/><verse number="29" style="v" sid="EZK 22:29"/>بْشِكَيٍ عٍ بٌرٍ رَوَلِمَ تِنشِنتَرٍيَ كُي. عٍ مُحّ تِمَ، عٍ سٍتَرٍيٍ نُن شْحّيٍ تْورْ مَ. عٍ مُ تِنشِن قٍوٌ.›»<verse eid="EZK 22:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 22:30"/>«ﭑ بَرَ مِشِ ندٍ قٍن عٍ يَ مَ، نَشَن نْمَ تّتّ رَكٍلِدٍ، عَ قَ تِ نَادّ يَ رَ ﭑ يَ عِ، عَلَكٌ نَ بْشِ نَشَ كَنَ. كْنْ ﭑ مُ نَ مِشِ سْتْ. <verse eid="EZK 22:30"/><verse number="31" style="v" sid="EZK 22:31"/>نَ نَن عَ رَ، ﭑ قَمَ ﭑ مَ شْنّ رَ مِنِدٍ عٍ مَ عَلْ تّ، ﭑ عٍ سْنتْ عٍ شَ وَلِ حَاشِ سَرٍ مَ. مَرِفِ عَلَتَلَ شُي نَن نَ كِ.»<verse eid="EZK 22:31"/></para>
  <chapter eid="EZK 22"/>
  <chapter number="23" style="c" sid="EZK 23"/>
  <para style="s">دِ فِنّ قِرِن</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 23:1"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، عَ نَشّ، <verse eid="EZK 23:1"/><verse number="2" style="v" sid="EZK 23:2"/>«عَدَ مَدِ، فِنّ قِرِن شَ تَرُشُي نَن يِ كِ، عٍ بِرِن نفَ كٍرٍن. <verse eid="EZK 23:2"/><verse number="3" style="v" sid="EZK 23:3"/>عٍ قٌنِكٍ تّمُي، عٍ نَشَ عٍ يّتّ قِندِ لَنفٌي فِنّيٍ رَ مِسِرَ بْشِ مَ. نَ فِنّدِ مّدِيٍ نَشَ تِن شّمّيٍ شَ عٍ شِحّيٍ مَسُشُ. <verse eid="EZK 23:3"/><verse number="4" style="v" sid="EZK 23:4"/>فِنّ نَشَن قٌرِ، عَ نُ شِلِ عٌهٌلَ، عَ شُنيَ شِلِ عٌهٌلِبَ. عٍ نُ نَ ﭑ مَ حَمَ نَن يَ مَ، عٍ قَ دِيٍ بَرِ. عٌهٌلَ مِسَالِشِ سَمَرِ نَن نَ، عٌهٌلِبَ مِسَالِشِ دَرِ سَلَمُ نَن نَ.»<verse eid="EZK 23:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 23:5"/>«عٌهٌلَ نَشَ عَ يّتّ مَتِ لَنفٌيحَ رَ عَ نُ نَ ﭑ مَ نِينِ بُن مَ تّمُي نَشّ. عَ نَشَ عَ حّنفّ مَشَنُ نَشٍيٍ قِندِ عَسِرِيَكَيٍ رَ، سْورِ تٌقَنيِ نَشٍيٍ <verse eid="EZK 23:5"/><verse number="6" style="v" sid="EZK 23:6"/>فّرّ دُفِ رَفٌرٌ مَ عٍ مَ، عٍ قِندِ مَنفّيٍ رَ، عٍ قِندِ سٌي رَفِيٍ رَ. <verse eid="EZK 23:6"/><verse number="7" style="v" sid="EZK 23:7"/>عَ نَشَ عَ يّتّ قِ عٍ مَ لَنفٌيحَ رَ عٍ تِدٍ تٌ نُ فبٌ، عَ مَن قَ بِرَ عٍ شَ كُيٍيٍ قْشْ رَ. <verse eid="EZK 23:7"/><verse number="8" style="v" sid="EZK 23:8"/>عَ مُ عَ شَ لَنفٌي قٍ لُ نَ، عَ نَشَن قْلْشِ مِسِرَ بْشِ مَ، شّمّيٍ شَ عَ شِحّ قَنيِيٍ مَسُشُ، عٍ عٍ وَشْنقٍ رَبَ عَ رَ.»<verse eid="EZK 23:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 23:9"/>«نَ نَن عَ تٌ، ﭑ نَشَ عَ لُ عَ حّنفّ عَسِرِيَكَيٍ سَفٌي، عَ نَشٍيٍ مَشَنُ. <verse eid="EZK 23:9"/><verse number="10" style="v" sid="EZK 23:10"/>نٍيٍ نَن عَ رَفٍلِ تِ، عٍ نَشَ عَ شَ دِيٍ تٌنفٌ، عٍ عَ قَن قَشَ سَنتِدّفّمَ رَ. عَ شِلِ نَشَ قِندِ كٌنبِ رَ فِنّيٍ تَفِ عَ شَ حَشَنكَتّ شَ قٍ رَ.»<verse eid="EZK 23:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 23:11"/>«عَ شُنيَ عٌهٌلِبَ نَشَ نَ تٌ، كْنْ عَ تَن شَ حّنفّ سُشُقٍ نُ شْرْشْ عَ تَارَ بّ، عَ نَشَ بُ لَنفٌيحَ كُي. <verse eid="EZK 23:11"/><verse number="12" style="v" sid="EZK 23:12"/>عَ قَن نُ وَ مَ سْورِ عَسِرِيَكَيٍ شْن، نَشٍيٍ قِندِ مَنفّ رَ، نَشٍيٍ قِندِ سٌي رَفِيٍ رَ. عٍ بِرِن تٌقَن عٍ شَ سْورِ دُفِ كُي. <verse eid="EZK 23:12"/><verse number="13" style="v" sid="EZK 23:13"/>ﭑ نَشَ عَ تٌ عَ قَن نُ نَ سّنِيّنتَرٍحَ كُي عَلْ عَ تَارَ.»<verse eid="EZK 23:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 23:14"/>«كْنْ عَ تَن بَرَ قٍ فبّتّ سَ نَ قَرِ. عَ تٌ كَلِدِكَيٍ شَ ثِرِنتِ فبٍيلِ تٌ بَنشِ شَلّ ندٍ مَ، <verse eid="EZK 23:14"/><verse number="15" style="v" sid="EZK 23:15"/>بّلّتِ شِرِشِ عٍ تَفِ، شُن سَسٍ دْشْشِ عٍ شُن، نَشٍيٍ قِندِ سْورِ مَنفّ كَلِدِكَيٍ رَ، نَشٍيٍ سْورِ رَفِسٍ رَفِمَ، <verse eid="EZK 23:15"/><verse number="16" style="v" sid="EZK 23:16"/>عَ نَشَ شّيرَيٍ شّي كَلِدِ بْشِ مَ عٍ شِلِدٍ بَرِ مَ عَ نُ وَ مَ عٍ شْن. <verse eid="EZK 23:16"/><verse number="17" style="v" sid="EZK 23:17"/>عٍ تٌ قَ عَ يِرٍ، عٍ نَشَ سَ عٍ بٌرٍ قّ مَ، عٍ عٍ سَفٌ رَبَ. عٍ تٌ نَ قٍ سّنِيّنتَرٍ رَبَ، عٍ شَ قٍ نَشَ رَحَاشُ عَ مَ، عَ فبِلٍن عٍ قْشْ رَ. <verse eid="EZK 23:17"/><verse number="18" style="v" sid="EZK 23:18"/>عَ تٌ نُ نَ نَ لَنفٌيحَ يَافِتَرٍيَ كُي، عَ نَشَ رَحَاشُ ﭑ قَن مَ، ﭑ قَ عَ رَبٌلٌ عَلْ ﭑ نَ رَبَشِ عَ شُنيَ رَ كِ نَشّ. <verse eid="EZK 23:18"/><verse number="19" style="v" sid="EZK 23:19"/>عَ تٌ رَتُ عَ شَ قٌنِكٍيَ سّنِيّنتَرٍيَ مَ مِسِرَ بْشِ مَ، عَ نَشَ لُ لَنفٌيحَ رَبَ رَ دَنفِقٍ عَ سِنفٍ رَ. <verse eid="EZK 23:19"/><verse number="20" style="v" sid="EZK 23:20"/>عَ حّنفّ شَ قٍ نُ شْرْشْ عَ مَ. عٍ سّنبّ تٌ فبٌشِ يّنّ رَبَدٍ عَلْ سٌقَلٍيٍ نُن سٌييٍ. <verse eid="EZK 23:20"/><verse number="21" style="v" sid="EZK 23:21"/>نَ نَن نَ كِ، وٌ شَ لَنفٌيحَ وٌ قٌنِكٍ رَ نَ شْلِ بَرَ وٌ سُشُ عَلْ عَ سِنفٍ رَ، مِسِرَ شّمّيٍ نُ وٌ شِحّ مَسُشُمَ تّمُي نَشّ.»<verse eid="EZK 23:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 23:22"/>«عٌهٌلِبَ، عَلَتَلَ يِ نَن مَسٍنشِ نَ شَ قٍ رَ؛ ‹ﭑ عِ حّنفّيٍ بْحّ رَتٍمَ نّ عِ فٍرٍقٍ مَ، عِ مّشِ نَشٍيٍ رَ. ﭑ عٍ رَكٍلِمَ يِرٍ بِرِن قَقٍ رَ عِ فٍرٍدٍ. <verse eid="EZK 23:22"/><verse number="23" style="v" sid="EZK 23:23"/>بَبِلْنكَيٍ كَلِدِكَيٍ، ثٍكٌدِكَيٍ، سٌوَكَيٍ، كٌوَكَيٍ، نُن عَسِرِيَكَيٍ شَ سْورِ سّنبّمَيٍ، مَنفّيٍ نُن سٌي رَفِيٍ، <verse eid="EZK 23:23"/><verse number="24" style="v" sid="EZK 23:24"/>عٍ بِرِن قَمَ نّ عِ شِلِ مَ نُن عٍ شَ فٍرٍ سٌسٍيٍ رَ، عٍ شَ سْورِ رَفِسٍيٍ رَ، عٍ شَ كٌتٍ شَنِن سٍيٍ رَ، نُن عٍ شَ سْورِ فَالِ رَ. عٍ عِ رَبِلِنمَ نّ، وُرٍ لٍقَيٍ نَ عٍ بّلّشّيٍ، مَكَنتَسٍيٍ نَ عٍ شُنيِ مَ. ﭑ عِ سٌمَ نّ عٍ يِ رَ، عَلَكٌ عٍ شَ عِ حَشَنكَتَ عٍ فبٍ كِ مَ. <verse eid="EZK 23:24"/><verse number="25" style="v" sid="EZK 23:25"/>ﭑ ﭑ مَ شْنّ رَ مِنِمَ نّ عِ مَ، عٍ قَن عِ فٍرٍ مَ نّ عٍ شَ شْنّ رَ. عٍ عِ شَ مِشِيٍ حْي نُن تُلِيٍ شَبَمَ نّ. نَشٍيٍ لُشِ، عٍ عٍ تَن قَشَمَ نّ سَنتِدّفّمَ رَ. عٍ عِ شَ دِيٍ شَنِنمَ نّ. نَشٍيٍ لُشِ، عٍ عٍ تَن فَنمَ نّ. <verse eid="EZK 23:25"/><verse number="26" style="v" sid="EZK 23:26"/>عٍ عِ شَ سٌسٍيٍ نُن عِ شَ شُنمَسٍيٍ تٌقَنيِيٍ شَنِنمَ نّ. <verse eid="EZK 23:26"/><verse number="27" style="v" sid="EZK 23:27"/>ﭑ عِ شَ لَنفٌيحَ دَنمَ نّ، عِ نَشَن قْلْشِ مِسِرَ. عِ مُ عِ حْشْ رَ سِفَمَ نَ مَ سْنْن.›»<verse eid="EZK 23:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 23:28"/>«عِ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛ ‹عَ فبٍ مُ لُشِ ﭑ شَ عِ سَ عِ يَشُييٍ سَفٌي، نَشٍيٍ نُ رَحَاشُ عِ مَ عَ سِنفٍ رَ، عِ قَ فبِلٍن عٍ قْشْ رَ. <verse eid="EZK 23:28"/><verse number="29" style="v" sid="EZK 23:29"/>عٍ عِ فٍرٍ مَ نّ، عٍ عِ هَرِفٍ بِرِن بَ عِ يِ رَ. عٍ عِ لُمَ عِ مَفٍلِ نَن نَ عِ شَ لَنفٌيحَ شَ يَافِ كُي. <verse eid="EZK 23:29"/><verse number="30" style="v" sid="EZK 23:30"/>عِ شَ وَلِ سّنِيّنتَرٍ بَرَ يِ فبَلٌي قِ عِ مَ، بَرِ مَ سِ فبّتّيٍ شْلِ نُ نَ عِ مَ، عِ قَ قٍ حَاشِ رَبَ عٍ شَ كُيٍيٍ رَ. <verse eid="EZK 23:30"/><verse number="31" style="v" sid="EZK 23:31"/>عِ تٌ عِحّرّ عِ تَارَ شَ كِرَ شْن مَ، ﭑ عَ شَ حَشَنكَتّ تْنبِلِ نَن سٌمَ عِ يِ رَ.›»<verse eid="EZK 23:31"/></para>
  <para style="q">
    <verse number="32" style="v" sid="EZK 23:32"/>«عَلَتَلَ يِ نَن مَسٍنشِ؛</para>
  <para style="q" vid="EZK 23:32">‹عِ عِ تَارَ شَ حَشَنكَتّ تْنبِلِ شُنفبٍ تٌنفٌمَ نّ،</para>
  <para style="q" vid="EZK 23:32">عِ قَ حَشَنكَتّ فبٍفبٍ سْتْ، نَشَن نَ عَ كُي،</para>
  <para style="q" vid="EZK 23:32">عَ قَ قِندِ يَافِ بٍلٍبٍلٍ رَ عِ بّ.<verse eid="EZK 23:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="EZK 23:33"/>نَ حَشَنكَتّ نَن عَ نِيَمَ عِ قَ لُ عَلْ سِيسِلَ نِمِسَشِ.</para>
  <para style="q" vid="EZK 23:33">نَ قِندِ مَ كَسَرّ نُن كَنَرِ نَن نَ عِ بّ،</para>
  <para style="q" vid="EZK 23:33">عَلْ عَ نُ نَ كِ نَشّ عِ شُنيَ سَمَرِ بّ.<verse eid="EZK 23:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="EZK 23:34"/>عِ قَمَ نّ نَ بِرِن سْتْدٍ هَن عَ دَنفِ عَ عِ،</para>
  <para style="q" vid="EZK 23:34">عِ قَ عِ يّتّ شِحّ عِبْو سُننُنيِ كُي.</para>
  <para style="q" vid="EZK 23:34">عِ مَرِفِ عَلَتَلَ شُي نَن نَ كِ.›»<verse eid="EZK 23:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="EZK 23:35"/>«عَلَتَلَ يِ نَن مَسٍنشِ نَ شَ قٍ رَ؛ ‹عِ تٌ بَرَ نّيمُ ﭑ مَ، عِ قَ عِ كٌبٍ رَ سٌ ﭑ نَ، عَ لَنمَ نّ عِ شَ عِ شَ لَنفٌيحَ كٌتٍ شَنِن.›»<verse eid="EZK 23:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="EZK 23:36"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، عَ نَشّ، «عَدَ مَدِ، عِ عٌهٌلَ نُن عٌهٌلِبَ مَكِيتِمَ نّ؟ عٍ رَكٌلٌن عٍ شَ وَلِ حَاشِيٍ رَ. <verse eid="EZK 23:36"/><verse number="37" style="v" sid="EZK 23:37"/>عٍ بَرَ يّنّ رَبَ، عٍ بَرَ قَشّ تِ، عٍ بَرَ يّنّ رَبَ عٍ شَ كُيٍيٍ رَ، عٍ بَرَ عٍ شَ دِيٍ قَن فَن سّرّشّ رَ نَ كُيٍيٍ بّ. نَ دِيٍ نُ قِندِشِ ﭑ تَن نَن فبٍ رَ. <verse eid="EZK 23:37"/><verse number="38" style="v" sid="EZK 23:38"/>عٍ مَن يِ نَن نَبَشِ ﭑ نَ؛ عٍ بَرَ ﭑ مَ هْرْ مْبَنشِ قِندِ يِرٍ سّنِيّنتَرٍ رَ، عٍ ﭑ مَ مَلَبُي لْشْييٍ قَن مَبٍرٍ. <verse eid="EZK 23:38"/><verse number="39" style="v" sid="EZK 23:39"/>عٍ تٌ نُ عٍ شَ دِيٍ بَمَ سّرّشّ رَ عٍ شَ كُيٍيٍ بّ لْشْي نَشّ، عٍ مَن سٌ نّ ﭑ مَ هْرْ مْبَنشِ كُي، عٍ عَ قِندِ يِرٍ سّنِيّنتَرٍ رَ. عٍ نَ نَن نَبَشِ ﭑ مَ بَنشِ كُي.»<verse eid="EZK 23:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="EZK 23:40"/>«عٍ نَشَ شّيرَيٍ شّي يِرٍ مَكُيٍ، عَلَكٌ مِشِيٍ شَ قَ. عٍ تٌ عِ يِرٍ لِ، عِ نَشَ عِ مَشَ، عِ لِنِ تِ عِ يَيٍ رَ، عِ عِ شَ شُنمَسٍ تٌقَنيِ فبَكُ عِ كْن مَ عَلَكٌ عِ شَ رَقَن عٍ مَ. <verse eid="EZK 23:40"/><verse number="41" style="v" sid="EZK 23:41"/>عِ نَشَ عٍ رَ سّنّ سَدٍ قَنيِ مَ، عِ ﭑ مَ سُرَيِ نُن تُرٍ دْشْ تٍيبِلِ رَ.»<verse eid="EZK 23:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="EZK 23:42"/>«حَمَ نُ نَ عِ رَبِلِنيِ. سٍبَكَيٍ قَن نُ نَ نَشٍيٍ كٍلِ فبٍنفبٍرٍنيِ مَ. عٍ نُ بّلّشّرَ سٌي سٌمَ عِ تَن نُن عِ شُنيَ بّلّشّ رَ، عٍ قَ مَنفّ نِمِتّ تٌقَنيِ دُ سُ وٌ شُنيِيٍ مَ. <verse eid="EZK 23:42"/><verse number="43" style="v" sid="EZK 23:43"/>نَ تّمُي ﭑ نَشَ عَ قَلَ نَ فِنّ شَ قٍ رَ نَشَن نُ بَرَ تَفَن عَ شَ لَنفٌيحَ رَبَقٍ رَ، ‹وٌ شَ عَ تٌنفٌ لَنفٌي فِنّ رَ، بَرِ مَ عَ نَ فبَنسَن نَن كٌلٌن.› <verse eid="EZK 23:43"/><verse number="44" style="v" sid="EZK 23:44"/>عٍ نَشَ سَ نَ فِنّ قّ مَ لَنفٌي كِ مَ. عٍ عٍ سَ عٌهٌلَ نُن عٌهٌلِبَ قّ مَ نَ كِ نّ. <verse eid="EZK 23:44"/><verse number="45" style="v" sid="EZK 23:45"/>كْنْ تِنشِنتْي عٍ مَكِيتِمَ نّ عٍ شَ يّنّ شَ قٍ رَ، عَ نُن عٍ شَ قَشّ تِقٍ شَ قٍ رَ.»<verse eid="EZK 23:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="EZK 23:46"/>«وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛ ‹فَلِ ندٍ شَ تٍ عٍ شِلِ مَ، عٍ شَ عٍ شُن نَكَنَ، عٍ هَرِفٍ بِرِن شَنِن. <verse eid="EZK 23:46"/><verse number="47" style="v" sid="EZK 23:47"/>نَ فَلِ عٍ مَفْنْمَ نّ فّمّيٍ رَ، عَ عٍ قَشَ عٍ شَ سَنتِدّفّمَيٍ رَ. عَ عٍ شَ دِيٍ قَشَ، عَ عٍ شَ بَنشِيٍ فَن تّ رَ.›»<verse eid="EZK 23:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="EZK 23:48"/>«ﭑ لَنفٌيحَ حْنمَ نَ كِ نّ وٌ شَ بْشِ كُي، عَلَكٌ فِنّيٍ شَ عَ كٌلٌن عَ مُ لَنمَ عٍ شَ حّرّ وٌ فبٍ كِ مَ. <verse eid="EZK 23:48"/><verse number="49" style="v" sid="EZK 23:49"/>وٌ شَ يّنّ كٌتٍ نُن وٌ شَ كُيٍ بَتُي كٌتٍ نَ دْشْ وٌ شُن مَ، وٌ عَ كٌلٌنمَ نّ عَ ﭑ تَن نَن نَ وٌ مَرِفِ عَلَتَلَ رَ.»<verse eid="EZK 23:49"/></para>
  <chapter eid="EZK 23"/>
  <chapter number="24" style="c" sid="EZK 24"/>
  <para style="s">تُندٍ تَالِ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 24:1"/>عَ حّ سٌلٌمَنَانِ ندٍ، كِكٍ قُ، شِ قُ ندٍ رَ، عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، عَ نَشّ، <verse eid="EZK 24:1"/><verse number="2" style="v" sid="EZK 24:2"/>«عَدَ مَدِ، عِ شَ يِ حّ، يِ كِكٍ، نُن يِ لْشْي سّبّ، بَرِ مَ تٌ بَبِلْن مَنفّ فٍرٍ قْلْمَ نّ دَرِ سَلَمُ. <verse eid="EZK 24:2"/><verse number="3" style="v" sid="EZK 24:3"/>عِ شَ يِ تَالِ وْيّنيِ قَلَ يِ بْنسْي مُرُتَشِ بّ. عَ قَلَ عٍ بّ؛</para>
  <para style="q" vid="EZK 24:3">‹عَلَتَلَ يِ نَن مَسٍنشِ؛</para>
  <para style="q" vid="EZK 24:3">يٍ سَ تُندٍ كُي، تُندٍ دْشْ تّ مَ.<verse eid="EZK 24:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="EZK 24:4"/>سُبٍ شُتِ قَنيِيٍ سَ عَ كُي،</para>
  <para style="q" vid="EZK 24:4">شُتِيٍ نَشٍيٍ قَن عَ بِرِن بّ عَلْ تَبٍ نُن تُنكِ سُبٍ،<verse eid="EZK 24:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="EZK 24:5"/>نَشَن شَبَشِ شُرُ سٍ قَتٍ قَنيِ رَ.</para>
  <para style="q" vid="EZK 24:5">يٍفٍ سَ تّ هَن تُندٍ شَ سَتُن، سُبٍ شَ حِن.›»<verse eid="EZK 24:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="EZK 24:6"/>«وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛</para>
  <para style="q" vid="EZK 24:6">فبَلٌي بَرَ يِ بْشِ لِ.</para>
  <para style="q" vid="EZK 24:6">يٍ بَرَ سٌ سُبٍ رَ تُندٍ كُي.</para>
  <para style="q" vid="EZK 24:6">سُبٍ شُتِ بِرِن بَ كٍرٍن كٍرٍنيِ رَ.<verse eid="EZK 24:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="EZK 24:7"/>مِشِ كْن تٌ رَشَبَ، عَ رَبَ قَنيٍ نَن قَرِ.</para>
  <para style="q" vid="EZK 24:7">شَ عَ سَ رَبَ بْشِ نّ نُ، بّندّ نُ نْمَ عَ مَكٌتٌدٍ.<verse eid="EZK 24:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="EZK 24:8"/>ﭑ قَن قَمَ نّ وٌ وُلِ رَقِلِدٍ ﭑ فبٍحْشْي رَ قَنيٍ قَرِ،</para>
  <para style="q" vid="EZK 24:8">عَلَكٌ عَ نَشَ مَكٌتٌ.»<verse eid="EZK 24:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="EZK 24:9"/>«وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛</para>
  <para style="q" vid="EZK 24:9">‹حَشَنكَتّ نَ يِ تَا قَشّتِ بّ.</para>
  <para style="q" vid="EZK 24:9">ﭑ يٍفٍ فبٍفبٍ سَمَ نّ نَ تّ شْورَ.<verse eid="EZK 24:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="EZK 24:10"/>وٌ قَن يٍفٍ سَ تّ، عَ شَ شُنفبٌ.</para>
  <para style="q" vid="EZK 24:10">سُبٍ حِن عَ قَنيِ رَ، بْرّ سٍ سَ عَ قَرِ، عَ شْرِيٍ شَ فَن قٍوٌ.<verse eid="EZK 24:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="EZK 24:11"/>نَ دَنفِ شَنبِ، تُندٍ عِفٍلِ شَ دْشْ تِفٍ وٌلٍنشِ قَرِ،</para>
  <para style="q" vid="EZK 24:11">هَن تُندٍ شَ قُرَ عَلْ وُرٍ فبٍيلِ نَشَن وَ مَ رَشُنُقٍ،</para>
  <para style="q" vid="EZK 24:11">عَلَكٌ سٍ بِرِن نَشَن لُشِ تُندٍ كُي عَ شَ حْن.<verse eid="EZK 24:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="EZK 24:12"/>كْنْ نَ مُ سْونّيَمَ.</para>
  <para style="q" vid="EZK 24:12">تّ مُ نْمَ سٍ بِرِن شْرِدٍ نَشَن لُمَ تُندٍ كُي.›»<verse eid="EZK 24:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 24:13"/>«وٌ بَرَ قِندِ سّنِيّنتَرٍيٍ رَ وٌ شَ يّنّ شَ قٍ رَ. ﭑ بَرَ كَتَ وٌ رَ سّنِيّندٍ، كْنْ وٌ مُ تِن. نَ كُي وٌ مُ سّنِيّنيِ سْتْمَ هَن ﭑ فّ ﭑ مَ شْنّ بِرِن نَمِنِدٍ وٌ مَ. <verse eid="EZK 24:13"/><verse number="14" style="v" sid="EZK 24:14"/>ﭑ تَن عَلَتَلَ شَ عَ قَلَ وٌ بّ، نَ وَشَتِ بَرَ عَ لِ. ﭑ مُ كِنِكِنِمَ وٌ مَ، ﭑ مُ فبِلٍنمَ ﭑ مَ نَتّ مَ. ﭑ وٌ مَكِيتِمَ وٌ حّرّ كِ نُن وٌ شَ وَلِ نَن مَ. وٌ مَرِفِ عَلَتَلَ شُي نَن نَن كِ.»<verse eid="EZK 24:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 24:15"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، عَ نَشّ، <verse eid="EZK 24:15"/><verse number="16" style="v" sid="EZK 24:16"/>«عَدَ مَدِ، عَ فبٍ مُ لُشِ ﭑ شَ عَ نِيَ عَ نَشَن نَقَن عِ مَ دَنفِقٍ عِ يَيٍ يَتِ رَ، ﭑ قَمَ نّ نَ رَلْيدٍ عِ مَ كٍرٍن نَ. كْنْ عِ نَشَن نَبَمَ، عِ نَشَ وَ شُي يٌ رَ مِنِ، عِ نَشَ يَ يٍ كٍرٍن نَمِنِ. <verse eid="EZK 24:16"/><verse number="17" style="v" sid="EZK 24:17"/>عِ شَ عِ سَبَرِ عِ شَ سُننُنيِ كُي، عِ نَشَ عِ شُي رَ مِنِ عَلْ مِشِيٍ دَرِشِ عَ رَبَ رَ قَشَ مِشِيٍ بّ كِ نَشّ. عِ نَشَ عِ شُنيِ مَفٍلِ تِ، عِ نَشَ سَنكِرِ بَ عِ سَنيِ، عِ نَشَ عِ يَتَفِ مَكٌتٌ، عِ نَشَ دٌنسٍ دٌن مِشِيٍ دَرِشِ نَشَن دٌن نَ حْن قٍ تّمُي.»<verse eid="EZK 24:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 24:18"/>ﭑ مَ فِنّ نَشَ قَشَ نَ نُنمَرٍ رَ. نَ كُيٍ عِبَ فّيسّفّ، ﭑ نَشَ عَ رَبَ عَلْ عَلَتَلَ نُ بَرَ ﭑ يَمَرِ كِ نَشّ. <verse eid="EZK 24:18"/><verse number="19" style="v" sid="EZK 24:19"/>حَمَ نَشَ ﭑ مَشْرِن، «عِ نَ يِ حْن قٍ رَبَقٍ كِ نَشّ، نَ مُنسٍ مَسٍنمَ مُشُ تَن بّ؟» <verse eid="EZK 24:19"/><verse number="20" style="v" sid="EZK 24:20"/>ﭑ نَشَ عٍ يَابِ، «عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، عَ نَشّ، <verse eid="EZK 24:20"/><verse number="21" style="v" sid="EZK 24:21"/>‹عَ قَلَ عِسِرَيِلَ بْنسْي بّ، وٌ مَرِفِ عَلَتَلَ نَشّ، عَ فبٍ مُ لُشِ ﭑ شَ عَ نِيَ ﭑ مَ هْرْ مْبَنشِ شَ قِندِ يِرٍ سّنِيّنتَرٍ رَ، نَ بَنشِ نَشَن نَقَن وٌ مَ كِ قَنيِ رَ. وٌ شَ دِيٍ مَن قَشَمَ نّ سَنتِدّفّمَ رَ.› <verse eid="EZK 24:21"/><verse number="22" style="v" sid="EZK 24:22"/>نَ تّمُي وٌ قَمَ نَ حْن قٍ سُشُدٍ عَلْ ﭑ عَ سُشُ كِ نَشّ. وٌ مُ وٌ يَتَفِ مَكٌتٌمَ، وٌ مُ حْن قٍ دٌنسٍ دٌنمَ، <verse eid="EZK 24:22"/><verse number="23" style="v" sid="EZK 24:23"/>وٌ مُ وٌ شُنيِ مَفٍلِ تِمَ، وٌ مُ سَنكِرِ بَمَ وٌ سَنيِ. وٌ مُ حْن قٍ رَبَمَ وَ شُي رَ. وٌ شَ يُنُبِيٍ نَن تُن وٌ شُن نَكَنَمَ. <verse eid="EZK 24:23"/><verse number="24" style="v" sid="EZK 24:24"/>عَلَ مَن نَشّ، ‹عَننَبِ عٍسٍكِيٍلِ قِندِ مَ وٌ بّ مِسَالِ نَن نَ. عَ نَشَن نَبَشِ، وٌ قَن قَمَ نَ نَن نَبَدٍ. نَ قٍيٍ نَ رَبَ، وٌ عَ كٌلٌنمَ نّ عَ ﭑ تَن نَن نَ وٌ مَرِفِ عَلَتَلَ رَ.›»<verse eid="EZK 24:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 24:25"/>«عَدَ مَدِ، ﭑ شَ عَ قَلَ عِ بّ، ﭑ عٍ شَ هْرْ مْبَنشِ، نَشَن نَقَنشِ عٍ مَ كِ قَنيِ رَ، عَ نُن عٍ شَ دِيٍ، ﭑ نٍيٍ بَمَ عٍ يِ رَ لْشْي نَشّ، <verse eid="EZK 24:25"/><verse number="26" style="v" sid="EZK 24:26"/>نَ لْشْي يَتِ مِشِ رَتَنفَشِ قَمَ نّ عِ يِرٍ، عَ نَ شِبَارُي قَلَ عِ بّ. <verse eid="EZK 24:26"/><verse number="27" style="v" sid="EZK 24:27"/>نَ لْشْي، عِ نّنيِ قُلُنمَ نّ نَ مِشِ رَتَنفَشِ يَ شْرِ، عِ مُ قِندِ مَ بٌبٌي رَ سْنْن. نَ بِرِن قِندِ مَ مِسَالِ نَن نَ حَمَ بّ، عٍ قَ عَ كٌلٌندٍ عَ ﭑ تَن نَن نَ عَلَتَلَ رَ.»<verse eid="EZK 24:27"/></para>
  <chapter eid="EZK 24"/>
  <chapter number="25" style="c" sid="EZK 25"/>
  <para style="s">عَمٌن، مٌوَبَ، عٍدٌن، نُن قِلِسِتَ شَ حَشَنكَتّ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 25:1"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، عَ نَشّ، <verse eid="EZK 25:1"/><verse number="2" style="v" sid="EZK 25:2"/>«عَدَ مَدِ، عِ شَ ﭑ مَ مَسٍنيِ تِ عَمٌنِكَيٍ شِلِ مَ. <verse eid="EZK 25:2"/><verse number="3" style="v" sid="EZK 25:3"/>عَ قَلَ عٍ بّ، ‹وٌ وٌ تُلِ مَتِ وٌ مَرِفِ عَلَتَلَ شُي رَ. عَ يِ نَن مَسٍنشِ؛ وٌ تٌ يٍلٍ ﭑ مَ هْرْ مْبَنشِ شَ سّنِيّنيِ كَنَقٍ رَ، عَ نُن عِسِرَيِلَ شَ بْشِ شَ كَنَرِ، عَ نُن يُدَ بْنسْي سِفَقٍ رَ كٌنيِيَ كُي، <verse eid="EZK 25:3"/><verse number="4" style="v" sid="EZK 25:4"/>ﭑ وٌ سَمَ نّ سٌفٍتٍدٍكَيٍ سَفٌي. عٍ يٌنكِنمَ نّ وٌ تَفِ، عٍ وٌ شَ دٌنسٍ دٌن، عٍ وٌ شَ شِحّ مِن. <verse eid="EZK 25:4"/><verse number="5" style="v" sid="EZK 25:5"/>ﭑ رَابَ قِندِ مَ حْشْمّ فْورّ نَن نَ، ﭑ عَمٌنِ بْشِ قِندِ يّشّي مَلَبُدٍ رَ. وٌ عَ كٌلٌنمَ نّ عَ ﭑ تَن نَن نَ عَلَتَلَ رَ.›»<verse eid="EZK 25:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 25:6"/>«وٌ مَرِفِ عَلَتَلَ يِ مَسٍنشِ، عَ نَشّ، ‹وٌ تَن بْحّ حَاشِيٍ تٌ قَرٍ بٌرٌن حّلّشِنيِ كُي ﭑ مَ حَمَ شَ فبَلٌي شَ قٍ رَ، <verse eid="EZK 25:6"/><verse number="7" style="v" sid="EZK 25:7"/>ﭑ قَمَ نّ ﭑ بّلّشّ عِتَلَدٍ وٌ شِلِ مَ، ﭑ وٌ سَ سِ فبّتّيٍ سَفٌي. ﭑ وٌ سِ حْنمَ نّ دُنِحَ مَ. ﭑ نَ فّ نَ رَبَدٍ، وٌ عَ كٌلٌنمَ نّ عَ ﭑ تَن نَن نَ عَلَتَلَ رَ.›»<verse eid="EZK 25:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 25:8"/>«وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ، عَ نَشّ، ‹مٌوَبَ نُن سٍيِرِ تٌ بَرَ عَ قَلَ عَ يُدَ بْنسْي لُشِ نّ عَلْ حَمَنّيٍ بِرِن، <verse eid="EZK 25:8"/><verse number="9" style="v" sid="EZK 25:9"/>ﭑ قَمَ نّ عَ نِيَدٍ عَ شَ بْشِ قَنيِ كٍلِ بٍتِ يٍسِمٌتِ مَ، بَلِ مٍيٌنِ، هَن كِرِيَتَيِمِ، بِرِن شَ لُ عَ يَشُييٍ سَفٌي. <verse eid="EZK 25:9"/><verse number="10" style="v" sid="EZK 25:10"/>ﭑ عَ قِمَ نّ سٌفٍتٍدٍكَيٍ مَ، عَ نُن عَمٌنِ بْشِ ﭑ قَمَ نَشَن شِلِ حْندٍ دُنِحَ مَ. <verse eid="EZK 25:10"/><verse number="11" style="v" sid="EZK 25:11"/>ﭑ نَ فّ مٌوَبَ حَشَنكَتَدٍ، عٍ عَ كٌلٌنمَ نّ عَ ﭑ تَن نَن نَ عَلَتَلَ رَ.›»<verse eid="EZK 25:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 25:12"/>«وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ، عَ نَشّ، ‹عٍدٌن بْنسْي تٌ عَ فبٍحْشْ يُدَ بْنسْي مَ، عٍ بَرَ هَاكّ سْتْ. <verse eid="EZK 25:12"/><verse number="13" style="v" sid="EZK 25:13"/>نَ كُي، عَلَتَلَ يِ نَن مَسٍنشِ؛ ﭑ عٍدٌن فٍرٍ مَ نّ سَنتِدّفّمَ رَ، ﭑ مِشِ نُن شُرُ سٍ بِرِن سْنتْ كٍلِقٍ تٍمَن مَ هَن دٍدَن. <verse eid="EZK 25:13"/><verse number="14" style="v" sid="EZK 25:14"/>ﭑ نَ ﭑ فبٍحْشْمَ نّ عٍدٌن مَ ﭑ مَ حَمَ عِسِرَيِلَ سَابُي رَ ﭑ مَ شْنّ بّرّ رَ. عٍ قَمَ نّ فبٍحْشْي كٌلٌندٍ. وٌ مَرِفِ عَلَتَلَ شُي نَن نَ كِ.›»<verse eid="EZK 25:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 25:15"/>«وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ، عَ نَشّ، ‹قِلِسِتَكَيٍ تٌ عٍ فبٍحْشْ يُدَيَ مَ عٍ نَشَن شْنشِ كَبِ تّمُي شْنكُيٍ، <verse eid="EZK 25:15"/><verse number="16" style="v" sid="EZK 25:16"/>ﭑ تَن وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛ ﭑ قِلِسِتَكَيٍ فٍرٍ مَ نّ، ﭑ كٍرِتِ بْنسْي حْن، ﭑ مِشِيٍ سْنتْ نَشٍيٍ سَبَتِشِ بَا دّ رَ. <verse eid="EZK 25:16"/><verse number="17" style="v" sid="EZK 25:17"/>ﭑ نَ ﭑ فبٍحْشْمَ نّ عٍ مَ ﭑ مَ شْنّ كُي. نَ تّمُي عٍ عَ كٌلٌنمَ نّ عَ ﭑ تَن نَن نَ عَلَتَلَ رَ.›»<verse eid="EZK 25:17"/></para>
  <chapter eid="EZK 25"/>
  <chapter number="26" style="c" sid="EZK 26"/>
  <para style="s">تِرٍ شَ حَشَنكَتّ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 26:1"/>عَ حّ قُ نُن كٍرٍن ندٍ، كِكٍ شِ سِنفٍ رَ، عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، عَ نَشّ، <verse eid="EZK 26:1"/><verse number="2" style="v" sid="EZK 26:2"/>«عَدَ مَدِ، تِرٍ تٌ بَرَ عَ كٌلٌن عَ دَرِ سَلَمُ نَ سَقٍ سِ فبّتّيٍ سَفٌي، عَ قَ عَ مَحْشُن عَ نْمَ نَاقُلِ سْتْدٍ نَ فبَلٌي رَبَ شَ قٍ رَ، <verse eid="EZK 26:2"/><verse number="3" style="v" sid="EZK 26:3"/>وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ، ‹تِرٍ، ﭑ تِشِ وٌ كَنكٍ! ﭑ قَمَ نّ سِ فبّتّيٍ رَ وٌ يِرٍ، عٍ دِن وٌ رَ عَلْ بَا مْرْنيِيٍ. <verse eid="EZK 26:3"/><verse number="4" style="v" sid="EZK 26:4"/>عٍ تِرٍ تّتّيٍ بِرِن يٍنسٍنمَ نّ، عٍ وٌ شَ يِرٍ مَكَنتَشِيٍ كَنَ، وٌ شْنيِ قَ قِندِ قَنيٍ مَفٍلِ رَ، <verse eid="EZK 26:4"/><verse number="5" style="v" sid="EZK 26:5"/>يّشّسُشُييٍ عٍ شَ يّلّيٍ رَشَرَ مَ دّننَشّ. عَلَتَلَ شُي نَن نَ كِ. ﭑ عَ شَ نَاقُلِ قِمَ نّ سِ فبّتّيٍ مَ، <verse eid="EZK 26:5"/><verse number="6" style="v" sid="EZK 26:6"/>عَ شَ مِشِيٍ قَشَمَ نّ سَنتِدّفّمَ رَ. نَ كُي، عٍ عَ كٌلٌنمَ نّ عَ ﭑ تَن نَن نَ عَلَتَلَ رَ.›»<verse eid="EZK 26:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 26:7"/>«وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ، عَ نَشّ، ‹ﭑ قَمَ نّ بَبِلْن مَنفّ شُنفبٍ نٍبُكَدَنسَرِ رَ كٍلِقٍ كْولَ مَ، عَ شَ وٌ تَن تِرٍكَيٍ فٍرٍ عَ شَ سْورِ فَلِ نُن عَ شَ سٌي رَفِ فَلِ رَ. <verse eid="EZK 26:7"/><verse number="8" style="v" sid="EZK 26:8"/>عَ وٌ شَ مِشِيٍ سْنتْمَ نّ سَنتِدّفّمَ رَ. عَ يِرٍيٍ مَتٍ وٌ شَ تّتّيٍ سّيتِ مَ عَلَكٌ عَ شَ نَا كَنَ. وٌ مُ نْمَ عَ تْورْدٍ عَ شَ وُرٍ لٍقَيٍ شَ قٍ رَ. <verse eid="EZK 26:8"/><verse number="9" style="v" sid="EZK 26:9"/>عَ دِنمَ نّ وٌ شَ نَادّيٍ نُن وٌ شَ يِرٍ مَكَنتَشِيٍ رَ عَ شَ فٍرٍ سٌسٍيٍ رَ، هَن عٍ بِرَ. <verse eid="EZK 26:9"/><verse number="10" style="v" sid="EZK 26:10"/>عَ شَ سٌي فَلِ شُبٍ رَتٍمَ نّ هَن. وٌ شَ تّتّ سّرّنمَ نّ عٍ شَ سٌي، عٍ شَ سْورِ رَفِسٍيٍ، نُن عٍ شَ سٍ شَنِن سٍيٍ شُي رَ، عٍ نَ سٌ وٌ شَ تّتّ بِرَشِ تَفِ تّمُي نَشّ. <verse eid="EZK 26:10"/><verse number="11" style="v" sid="EZK 26:11"/>عٍ وٌ شَ كِرَيٍ بٌرٌنمَ نّ، عٍ وٌ شَ مِشِيٍ قَشَ سَنتِدّفّمَ رَ، عٍ وٌ شَ بَنشِ قَنيِيٍ رَبِرَ. <verse eid="EZK 26:11"/><verse number="12" style="v" sid="EZK 26:12"/>عٍ وٌ شَ نَاقُلِ شَنِنمَ نّ، عٍ وٌ هَرِفٍ شُن نَكَنَ. عٍ وٌ شَ تّتّ رَبِرَ، عٍ وٌ شَ بَنشِيٍ كَنَ، نَشَن نَ لُ، عٍ نَ وْلّ بَا مَ. <verse eid="EZK 26:12"/><verse number="13" style="v" sid="EZK 26:13"/>ﭑ وٌ شَ سِفِ سَ دَنمَ نّ، وٌ شَ كْرَ شُي مُ مّمَ سْنْن. <verse eid="EZK 26:13"/><verse number="14" style="v" sid="EZK 26:14"/>ﭑ عِ قِندِ مَ قَنيٍ مَبَشِ نَن نَ، يّلّ رَشَرَ مَ دّننَشّ. وٌ شَ تَا مُ فبِلٍنمَ تِ رَ سْنْن، بَرِ مَ ﭑ شُي نَن نَ كِ. وٌ مَرِفِ عَلَتَلَ نَ نَن مَسٍنشِ.›»<verse eid="EZK 26:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 26:15"/>«وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ تِرٍ بّ، عَ نَشّ، ‹سِ فبّتّ نَشٍيٍ سَبَتِشِ بَا دّ رَ، عٍ قَمَ نّ وٌ وَ شُي مّدٍ يِ فبَلٌي شَ قٍ رَ. <verse eid="EZK 26:15"/><verse number="16" style="v" sid="EZK 26:16"/>عٍ شَ مَنفّيٍ فٌرٌ مَ نّ عٍ شَ كِبَنيِيٍ كُي، عٍ عٍ شَ دُفِ قَنيِيٍ بَ عٍ مَ، عٍ قَ سُننُن دُفِ رَفٌرٌ عٍ مَ، عَلَكٌ عٍ شَ دْشْ وٌ سّيتِ مَ بْشِ مَ يَرَفَاشُي كُي. <verse eid="EZK 26:16"/><verse number="17" style="v" sid="EZK 26:17"/>عٍ سُننُن سُوكِ ندٍ شَبُمَ نّ وٌ شُن مَ، نَشَن عَ قَلَمَ،</para>
  <para style="q" vid="EZK 26:17">وٌ شَ قٍ شُن بَرَ رَكَنَ،</para>
  <para style="q" vid="EZK 26:17">وٌ تَن تَا سّنبّمَ كُنكُي رَحّرّيٍ.</para>
  <para style="q" vid="EZK 26:17">وٌ سّنبّ نُ فبٌ بَا مَ،</para>
  <para style="q" vid="EZK 26:17">بِرِن نُ فَاشُمَ وٌ يَ رَ.<verse eid="EZK 26:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="EZK 26:18"/>كْنْ يَكْسِ سِ نَشٍيٍ سَبَتِشِ بَا دّ رَ،</para>
  <para style="q" vid="EZK 26:18">عٍ بَرَ فَاشُ عَ قَنيِ رَ وٌ شَ فبَلٌي شَ قٍ رَ.›»<verse eid="EZK 26:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 26:19"/>«وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ، عَ نَشّ، ‹ﭑ نَ وٌ شَ تَا كَنَ، مِشِ يٌ مُ لُ نَا سْنْن، بَا يٍ قَ دِن نَ يِرٍ مَ، <verse eid="EZK 26:19"/><verse number="20" style="v" sid="EZK 26:20"/>نَ لُمَ نّ عَلْ مِشِ دَنفِشِ نَشٍيٍ بَرَ سِفَ عَلِفِيَمَ. ﭑ وٌ نْشُنمَ نّ بْشِ بُن مَ، وٌ مُ فبِلٍن دُنِحَ مَ سْنْن. <verse eid="EZK 26:20"/><verse number="21" style="v" sid="EZK 26:21"/>ﭑ وٌ رَحْنمَ نّ يِ فبَلٌي كُي قٍوٌ. مِشِ نَشَن وٌ قٍنمَ، عَ مُ وٌ تٌمَ سْنْن. وٌ مَرِفِ عَلَتَلَ شُي نَن نَ كِ.›»<verse eid="EZK 26:21"/></para>
  <chapter eid="EZK 26"/>
  <chapter number="27" style="c" sid="EZK 27"/>
  <para style="s">سُننُن سُوكِ تِرٍ بّ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 27:1"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، عَ نَشّ، <verse eid="EZK 27:1"/><verse number="2" style="v" sid="EZK 27:2"/>«عَدَ مَدِ، سُننُن سُوكِ بَ تِرٍ بّ. <verse eid="EZK 27:2"/><verse number="3" style="v" sid="EZK 27:3"/>عِ شَ عَ قَلَ يِ بْنسْي بّ، نَشَن سَبَتِشِ بَا دّ رَ، نَشَن يُلّيَ رَبَ دُنِحَ بِرِن، ‹عَلَتَلَ يِ نَن مَسٍنشِ؛</para>
  <para style="q" vid="EZK 27:3">وٌ تَن تِرٍ، وٌ نَشّ وٌ تٌقَن دَنفِ بِرِن نَ.<verse eid="EZK 27:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="EZK 27:4"/>وٌ سّنبّ نُ فبٌ بَا مَ،</para>
  <para style="q" vid="EZK 27:4">وٌ شَ كُنكُي يَءِلَنيِيٍ نُ وَلِمَ عَ قَنيِ رَ.<verse eid="EZK 27:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="EZK 27:5"/>عٍ نُ سِثِرّ وُرِ رَوَلِمَ كٍلِقٍ سٍنِرِ بْشِ مَ،</para>
  <para style="q" vid="EZK 27:5">عٍ نُ سّدِرِ وُرِ رَوَلِ كٍلِقٍ لِبَن بّلَ رَ.<verse eid="EZK 27:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="EZK 27:6"/>عٍ نُ كٌندٍ وُرِ يَءِلَن لَالَ رَ نَشَن كٍلِشِ بَسَن.</para>
  <para style="q" vid="EZK 27:6">عٍ نُ سَنتَلِ وُرِ رَوَلِ كٍلِقٍ سِثِرِ بْشِ مَ كُنكُي رَشُنمَسٍ رَ،</para>
  <para style="q" vid="EZK 27:6">عٍ قَ فّمّ تٌقَنيِيٍ رَ سٌ نَ وُرِ كُي.<verse eid="EZK 27:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="EZK 27:7"/>عِ شَ بّلَ يَءِلَنشِ تَسْشْي تٌقَنيِ نَن نَ كٍلِقٍ مِسِرَ.</para>
  <para style="q" vid="EZK 27:7">دُفِ فبّتّيٍ قَن نُ فبَكُمَ وٌ شَ كُنكُييٍ رَ</para>
  <para style="q" vid="EZK 27:7">نَشٍيٍ قِندِشِ فَرّ دُفِ رَ كٍلِقٍ عٍلِسَهَ بْشِ مَ.<verse eid="EZK 27:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="EZK 27:8"/>سِدْنكَيٍ نُن عَرَوَدَكَيٍ نَن نُ نَ وٌ شَ لَالَبَيٍ رَ،</para>
  <para style="q" vid="EZK 27:8">تِرٍكَيٍ نَن نُ نَ وٌ شَ كُنكُي رَحّرّيٍ رَ.<verse eid="EZK 27:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="EZK 27:9"/>فٍبَلِكَيٍ نَن نُ نَ وٌ شَ كُنكُي يَءِلَنيِيٍ رَ.</para>
  <para style="q" vid="EZK 27:9">كُنكُييٍ نُ قَمَ وٌ يِرٍ كٍلِقٍ دُنِحَ بِرِن مَ يُلّيَ رَبَدٍ.›»<verse eid="EZK 27:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="EZK 27:10"/>«ثٍرِ سٍكَيٍ، لِدِكَيٍ، نُن ثُتِكَيٍ نَن نُ نَ وٌ شَ سْورِ فَلِيٍ رَ،</para>
  <para style="q" vid="EZK 27:10">عٍ شَ فٍرٍ سٌسٍيٍ نُن عٍ شَ مَكَنتَسٍيٍ نُ فبَكُمَ وٌ شْنيِ نّ.</para>
  <para style="q" vid="EZK 27:10">نَ بِرِن قِندِشِ شِلِ قَنيِ نَن نَ وٌ بّ.<verse eid="EZK 27:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="EZK 27:11"/>عَرَوَدَ نُن هٍلٍشِ سْورِيٍ نَن نُ وٌ شَ تّتّ مَكَنتَمَ،</para>
  <para style="q" vid="EZK 27:11">فَمَدِكَيٍ نَن نُ مّينِمَ وٌ شَ يِرٍ مَكَنتَشِيٍ مَ،</para>
  <para style="q" vid="EZK 27:11">عٍ شَ فٍرٍ سٌسٍيٍ نُن عٍ شَ مَكَنتَسٍيٍ نُ فبَكُمَ وٌ شْنيِ نّ.</para>
  <para style="q" vid="EZK 27:11">نَ بِرِن قِندِشِ شِلِ قَنيِ نَن نَ وٌ بّ.»<verse eid="EZK 27:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 27:12"/>تَرَ سِسِكَيٍ نُ فبٍتِ، وُرٍ، يْشُي، نُن سُنبُي نَن مَسَرَ مَ وٌ شَ يِرَبَسٍيٍ رَ.<verse eid="EZK 27:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 27:13"/>فِرّكِكَيٍ، تُبَلِكَيٍ، نُن مٍسٍكِكَيٍ نُ كٌنيِيٍ نُن وُرٍ فبٍيلِ نَن مَسَرَ مَ وٌ شَ يِرَبَسٍيٍ رَ.<verse eid="EZK 27:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 27:14"/>تٌفَرَ مَكَيٍ نُ سٌي نُن سٌقَلٍ مْولِ بِرِن نَن مَسَرَ مَ وٌ شَ يِرَبَسٍيٍ رَ.<verse eid="EZK 27:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 27:15"/>دٍدَنكَيٍ نُ سَرٍ سٌمَ وٌ شْنيِ سِلِ حِنيِيٍ نُن وُرِ قَنيِ نَن نَ.<verse eid="EZK 27:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 27:16"/>وٌ تَن نُن عَرَ مِكَيٍ نُ يُلّيَ رَبَمَ وٌ بٌرٍ تَفِ. عٍ نُ فّمّ تٌقَنيِ، فَرّ دُفِ، دُفِ رَوَلِشِ، دُفِ مَسْشْشِيٍ، بَا بُن مَ فّمّ، نُن فّمّ تٌقَنيِ فبٍيلِيٍ نَن مَسَرَ مَ وٌ شَ يِرَبَسٍيٍ رَ.<verse eid="EZK 27:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 27:17"/>يُدَكَيٍ نُن عِسِرَيِلَكَيٍ نُ مّنفِ نُن قُندٍنيِ مَنِيّ نَشٍيٍ كٍلِشِ مِنِتِ بْشِ مَ، دٌنسٍ حْشُنمّيٍ، كُمِ، تُرٍ، نُن سٍرِ نَن مَسَرَ مَ وٌ شَ يِرَبَسٍيٍ رَ.<verse eid="EZK 27:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 27:18"/>دَ مَسِكَيٍ نُ قَمَ وّنِ نَن نَ كٍلِقٍ شٍلٍبٌن نُن يّشّي شَبٍ كٍلِقٍ سَشَرُ، عٍ نُ عٍ مَسَرَ مَ وٌ شَ يِرَبَسٍيٍ رَ.<verse eid="EZK 27:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 27:19"/>دَنَكَيٍ نُن يَوَنِكَيٍ نَشٍيٍ كٍلِشِ عُسَلِ، عٍ نُ وُرٍ، كَسِيَ وُرِ، نُن سٍرِ نَن مَسَرَ مَ وٌ شَ يِرَبَسٍيٍ رَ.<verse eid="EZK 27:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 27:20"/>دٍدَنكَيٍ نُ قَمَ سٌي مَشِرِ دُفِيٍ نَن نَ.<verse eid="EZK 27:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 27:21"/>عَرَبِكَيٍ نُن كٍدَرِ مَنفّيٍ نُ يُلّيَ رَبَمَ وٌ شْنيِ يّشّييٍ، سِ كٌنتٌنيِيٍ، نُن سِيٍ نَن نَ. <verse eid="EZK 27:21"/><verse number="22" style="v" sid="EZK 27:22"/>سٍيبَ نُن رَ مَ يُلّيٍ نُ سٍ شِرِ حْشُنمّ، فّمّ تٌقَنيِيٍ، نُن شّيمَ نَن مَسَرَ مَ وٌ شَ يِرَبَسٍيٍ رَ.<verse eid="EZK 27:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 27:23"/>«شَرَنِكَيٍ، كَننٍكَيٍ، عٍدٍنكَيٍ، سٍيبَكَيٍ، عَسِرِيَكَيٍ، نُن كِلِمَدَكَيٍ بِرِن نُ يُلّيَ رَبَمَ وٌ شْنيِ نّ. <verse eid="EZK 27:23"/><verse number="24" style="v" sid="EZK 27:24"/>عٍ نُ قَمَ دُفِ تٌقَنيِيٍ، فَرّ دُفِيٍ، دُفِ تَسْشْييٍ، نُن دُفِ مَسْشْشِيٍ مْولِ بِرِن نَن نَ.»<verse eid="EZK 27:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="EZK 27:25"/>«تَرَ سِسِ كُنكُييٍ نَن وٌ شَ يُلّيَ سٍيٍ مَشَنِنمَ وٌ بّ.</para>
  <para style="q" vid="EZK 27:25">وٌ شَ كٌتٍ فبٌ نَشَن حّرّ مَ بَا مَ.<verse eid="EZK 27:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="EZK 27:26"/>وٌ شَ لَالَ بَيٍ وٌ شَنِنمَ يِرٍ مَكُيٍ بَا مَ،</para>
  <para style="q" vid="EZK 27:26">كْنْ قٌيٍ نَشَن كٍلِمَ سٌفٍتٍدٍ مَبِرِ، عَ وٌ مَدُلَمَ نّ بَا مَ.<verse eid="EZK 27:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="EZK 27:27"/>وٌ شَ نَاقُلِ، وٌ شَ يُلّيَ سٍيٍ، وٌ شَ يِرَبَسٍيٍ،</para>
  <para style="q" vid="EZK 27:27">وٌ شَ كُنكُي رَفِيٍ، وٌ شَ كُنكُي يَءِلَنيِيٍ، وٌ شَ سْورِيٍ، وٌ شَ يُلّيٍ،</para>
  <para style="q" vid="EZK 27:27">مِشِ بِرِن نَشٍيٍ نَ وٌ شَ كُنكُييٍ كُي،</para>
  <para style="q" vid="EZK 27:27">عٍ مَدُلَمَ نّ نَ فبَلٌي لْشْي.<verse eid="EZK 27:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="EZK 27:28"/>كُنكُي رَحّرّيٍ فبٍلٍفبٍلٍ شُي مّمَ نّ كٍلِقٍ بَا دّ رَ.<verse eid="EZK 27:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="EZK 27:29"/>لَالَ بَيٍ، كُنكُي رَحّرّيٍ بِرِن تِمَ بَا دّ رَ نَ قٍ مَ.<verse eid="EZK 27:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="EZK 27:30"/>عٍ وَ مَ، عٍ شَ سُننُنيِ شُي رَتٍمَ وٌ شَ فبَلٌي شَ قٍ رَ،</para>
  <para style="q" vid="EZK 27:30">عٍ شُبٍ سٌ عٍ شُنيِيٍ مَ وٌ شَ حْن قٍ تّمُي.<verse eid="EZK 27:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="EZK 27:31"/>عٍ عٍ شُنيِيٍ بِمَ نّ سُننُنيِ كُي، عٍ سُننُن دُفِيٍ رَفٌرٌ عٍ مَ.</para>
  <para style="q" vid="EZK 27:31">عٍ وَ عٍ شُي عِتٍشِ رَ، عٍ بْحّ تْورْ مَ نّ كِ قَنيِ رَ.»<verse eid="EZK 27:31"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="32" style="v" sid="EZK 27:32"/>«نَ بِرِن كُي عٍ سُننُن سُوكِ ندٍ بَمَ نّ وٌ بّ، عَ قَلَقٍ رَ،</para>
  <para style="q" vid="EZK 27:32">‹سِ مُندُن حْنمَ يِ كِ عَلْ تِرٍ حْنشِ كِ نَشّ؟›<verse eid="EZK 27:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="EZK 27:33"/>وٌ شَ يُلّيَ كٌتٍ تٌ حّرّ مَ بَا مَ،</para>
  <para style="q" vid="EZK 27:33">حَمَنّيٍ نُ حّلّشِنمَ نّ وٌ شَ يِرَبَسٍيٍ رَ.</para>
  <para style="q" vid="EZK 27:33">وٌ شَ نَاقُلِ نُن وٌ هَرِفٍ نَن نُ عَ نِيَمَ دُنِحَ مَنفّيٍ شَ بَننَيَ سْتْ.<verse eid="EZK 27:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="EZK 27:34"/>كْنْ يَكْسِ بَا تَن بَرَ وٌ شُن نَكَنَ،</para>
  <para style="q" vid="EZK 27:34">عَ بَرَ وٌ شَ كٌتٍ نُن وٌ شَ مِشِيٍ دٌن فبِكِ.<verse eid="EZK 27:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="EZK 27:35"/>مِشِ نَشٍيٍ سَبَتِشِ بَا دّ، عٍ بَرَ فَاشُ،</para>
  <para style="q" vid="EZK 27:35">هَلِ مَنفّيٍ دّ بَرَ عِشَرَ.<verse eid="EZK 27:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="EZK 27:36"/>يُلّ نَشٍيٍ نَ دُنِحَ،</para>
  <para style="q" vid="EZK 27:36">عٍ بِرِن بَرَ كَابَ وٌ شَ فبَلٌي شَ قٍ رَ.</para>
  <para style="q" vid="EZK 27:36">وٌ شَ قٍ بَرَ حْن كٍرٍنيِ رَ.»<verse eid="EZK 27:36"/></para>
  <chapter eid="EZK 27"/>
  <chapter number="28" style="c" sid="EZK 28"/>
  <para style="s">مَسٍنيِ تِرٍ مَنفّ نُن سِدْن بّ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 28:1"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، عَ نَشّ، <verse eid="EZK 28:1"/><verse number="2" style="v" sid="EZK 28:2"/>«عَدَ مَدِ، عَ قَلَ تِرٍ مَنفّ بّ، ‹عِ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛</para>
  <para style="q" vid="EZK 28:2">عِ بَرَ لَ عِ يّتّ رَ عَ قَلَقٍ رَ، «عَلَ نَن ﭑ تَن نَ!</para>
  <para style="q" vid="EZK 28:2">ﭑ دْشْشِ عَلَيٍ شَ كِبَنيِ نَن كُي بَا دّ رَ!»</para>
  <para style="q" vid="EZK 28:2">كْنْ عِ مُ قِندِشِ عَلَ يٌ رَ،</para>
  <para style="q" vid="EZK 28:2">هَلِ عِ تٌ عَ مَحْشُنشِ عَ عِ شَشِلِ لُشِ نّ عَلْ عَلَ فبٍ.</para>
  <para style="q" vid="EZK 28:2">عِبُنَدَ مَ تُن نَن نَ عِ رَ.<verse eid="EZK 28:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="EZK 28:3"/>عِ حْشْ عَ مَ عَ عِ شَشِلِ قَن دَنفِ عَننَبِ دَنِيّلِ فبٍ رَ؟</para>
  <para style="q" vid="EZK 28:3">عِ فُندٌ قٍ بِرِن كٌلٌن؟<verse eid="EZK 28:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="EZK 28:4"/>عِ شَ شَشِلِمَيَ بَرَ عَ نِيَ عِ شَ بَننَيَ سْتْ،</para>
  <para style="q" vid="EZK 28:4">شّيمَ نُن فبٍتِ فبٌشِ عِ شَ نَاقُلِ يَ مَ.<verse eid="EZK 28:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="EZK 28:5"/>عِ قَتَ يُلّيَ رَبَدٍ.</para>
  <para style="q" vid="EZK 28:5">نَ بَرَ قِندِ بَننَيَ رَ عِ بّ،</para>
  <para style="q" vid="EZK 28:5">كْنْ عَ مَن بَرَ عَ نِيَ عِ شَ قِندِ يّتّ عِفبٌي رَ.›»<verse eid="EZK 28:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="EZK 28:6"/>«نَ قٍ مَ، عِ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛</para>
  <para style="q" vid="EZK 28:6">عِ حْشْ عَ مَ عِ شَشِلِ لُشِ نّ عَلْ عَلَ فبٍ،<verse eid="EZK 28:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="EZK 28:7"/>ﭑ عِ يَشُي كٌبِيٍ رَدِنمَ نّ عِ مَ،</para>
  <para style="q" vid="EZK 28:7">عَلَكٌ عٍ شَ عٍ شَ سَنتِدّفّمَيٍ بَ عٍ تّي كُي،</para>
  <para style="q" vid="EZK 28:7">عٍ شَ وٌ شَ تٌقَنيِ نُن وٌ شَشِلِمَيَ رَفٌرٌ،</para>
  <para style="q" vid="EZK 28:7">عِ شَ قٍ قَنيِ شُن قَ رَكَنَ.<verse eid="EZK 28:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="EZK 28:8"/>عٍ عِ مَدُلَمَ نّ بَا مَ، عِ قَ قَشّ شْرْشْي سْتْ، عِ فٌرٌ عَلِفِيَمَ.<verse eid="EZK 28:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="EZK 28:9"/>عِ قَمَ نّ عَ قَلَدٍ قَشّتِيٍ يَ عِ، ‹عَلَ نَ ﭑ نَ›؟</para>
  <para style="q" vid="EZK 28:9">مِشِ نَن تُن نَ عِ رَ نَشَن قَشَمَ مِشِيٍ بّلّشّ رَ.<verse eid="EZK 28:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="EZK 28:10"/>عِ قَشَمَ نّ يَافِ كُي عَلْ بِلَكْرّ.</para>
  <para style="q" vid="EZK 28:10">عِ مَرِفِ عَلَتَلَ شُي نَن نَن كِ.»<verse eid="EZK 28:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 28:11"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، عَ نَشّ، <verse eid="EZK 28:11"/><verse number="12" style="v" sid="EZK 28:12"/>«عَدَ مَدِ، سُننُن سُوكِ ندٍ بَ تِرٍ مَنفّ بّ، عَ قَلَقٍ رَ،</para>
  <para style="q" vid="EZK 28:12">‹عِ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛</para>
  <para style="q" vid="EZK 28:12">عِ نُ كَمَلِشِ شَشِلِمَيَ نُن تٌقَنيِ نَن نَ.<verse eid="EZK 28:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="EZK 28:13"/>عَ نُ لُشِ نّ عَلْ عِ سَبَتِشِ عَلَ شَ يِرٍ قَنيِ نَن كُي نَشَن شِلِ عٍدٍن بْشِ.</para>
  <para style="q" vid="EZK 28:13">فّمّ تٌقَنيِ نَشٍيٍ سَرٍ فبٌ عٍ نُ نَ عِ يِ رَ.</para>
  <para style="q" vid="EZK 28:13">عٍ شِلِ نُ قَلَمَ؛ سَرِدُوَنِ، تٌثَسِ، دِيَمَن، كِرٌ سٌلِتٍ، عٌنِشِ، يَسَثٍ، سَقِرِ، عٍسِكَرِبُكُلُ، نُن عٍمٍرٌدٍ.</para>
  <para style="q" vid="EZK 28:13">نٍيٍ نُ سَشِ شّيمَ رَشُنمَسٍيٍ نَن تَفِ، عٍ قِندِ شُرُندّ، بّلّشّرَ سٌي، نُن كْنمَفٌرٍيٍ رَ.</para>
  <para style="q" vid="EZK 28:13">عَلَ نَ نَن بِرِن رَقَلَشِ عِ بّ عِ دَا تّمُي.<verse eid="EZK 28:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="EZK 28:14"/>ﭑ تٌ عِ تِ مَنفّ رَ، ﭑ مَلٍكّ سّنبّ سٌ عِ يِ رَ.</para>
  <para style="q" vid="EZK 28:14">عِ نُ حّرّ مَ تّ نَن تَفِ ﭑ مَ فٍيَ قَرِ.<verse eid="EZK 28:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="EZK 28:15"/>عِ نُ سّنِيّن كَبِ عِ دَا لْشْي،</para>
  <para style="q" vid="EZK 28:15">كْنْ تِنشِنتَرٍيَ بَرَ عِ سُشُ.<verse eid="EZK 28:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="EZK 28:16"/>عِ شَ يُلّيَ شَ فبٌي بَرَ عِ قِندِ يُنُبِتْي حَاشِ رَ.</para>
  <para style="q" vid="EZK 28:16">نَ كُي ﭑ نَشَ عِ كٍرِ عَلَ شَ فٍيَ قَرِ،</para>
  <para style="q" vid="EZK 28:16">ﭑ نَشَ مَلٍكّ سّنبّ بَ عِ يِ.<verse eid="EZK 28:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="EZK 28:17"/>عِ شَ تٌقَنيِ نَن عَ نِيَ عِ شَ قِندِ يّتّ عِفبٌي رَ.</para>
  <para style="q" vid="EZK 28:17">عِ شَ قٍ كٌلٌنيِ نَن عَ نِيَ عِ شُن شَ رَكَنَ.</para>
  <para style="q" vid="EZK 28:17">نَ كُي ﭑ نَشَ عِ شَ قٍ مَفٌرٌ بْشِ مَ عَلَكٌ مَنفّيٍ شَ عِ تٌ.<verse eid="EZK 28:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="EZK 28:18"/>عِ شَ يُنُبِيٍ نُن عِ شَ تِنشِنتَرٍيَ عِ شَ يُلّيَ كُي،</para>
  <para style="q" vid="EZK 28:18">نَ بَرَ عِ شَ سَلِدٍيٍ قِندِ يِرٍ سّنِيّنتَرٍيٍ رَ.</para>
  <para style="q" vid="EZK 28:18">ﭑ بَرَ تّ رَ مِنِ عِ شِلِ مَ نَشَن عِ شُن نَكَنَمَ،</para>
  <para style="q" vid="EZK 28:18">ﭑ بَرَ عِ قِندِ شُبٍ رَ حَمَ يَ شْرِ.<verse eid="EZK 28:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="EZK 28:19"/>مَنفّ نَشٍيٍ نُ عِ كٌلٌن،</para>
  <para style="q" vid="EZK 28:19">عٍ بِرِن بَرَ مَكَابَ عِ شَ فبَلٌي شَ قٍ رَ.</para>
  <para style="q" vid="EZK 28:19">عِ شَ قٍ بَرَ حْن كٍرٍنيِ رَ.›»<verse eid="EZK 28:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="EZK 28:20"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، عَ نَشّ،<verse eid="EZK 28:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="EZK 28:21"/>«عَدَ مَدِ، عِ شَ تِ سِدْن كَنكٍ، عِ شَ مَسٍنيِ تِ عَ بّ ﭑ شِلِ رَ، عَ قَلَقٍ رَ،<verse eid="EZK 28:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="EZK 28:22"/>‹وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛</para>
  <para style="q" vid="EZK 28:22">ﭑ بَرَ كٍلِ عِ شِلِ مَ سِدْن!</para>
  <para style="q" vid="EZK 28:22">ﭑ نَ ﭑ مَ نْرّ مَسٍنمَ نّ وٌ تَفِ.</para>
  <para style="q" vid="EZK 28:22">ﭑ نَ وٌ حَشَنكَتَ، مِشِيٍ عَ كٌلٌنمَ نّ عَ ﭑ تَن نَن نَ عَلَتَلَ رَ.</para>
  <para style="q" vid="EZK 28:22">نَ لْشْي ﭑ نَ ﭑ مَ سّنِيّنيِ مَسٍنمَ نّ وٌ يَ مَ.<verse eid="EZK 28:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="EZK 28:23"/>ﭑ وُفَنيِ رَدِنمَ نّ وٌ مَ، مِشِ فبٍفبٍ شَ قَشَ تَا كُي.</para>
  <para style="q" vid="EZK 28:23">ﭑ سَنتِدّفّمَ رَوَلِمَ نّ وٌ شِلِ مَ، مِشِ فبٍفبٍ شَ سْنتْ يِرٍ بِرِن.</para>
  <para style="q" vid="EZK 28:23">نَ كُي مِشِيٍ عَ كٌلٌنمَ نّ عَ ﭑ تَن نَن نَ عَلَتَلَ رَ.›»<verse eid="EZK 28:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 28:24"/>«نَ تّمُي وٌ مُ لُمَ عَلْ تُنبٍيٍ عِسِرَيِلَ بْنسْي سّيتِ مَ سْنْن، عٍ قَ عَ كٌلٌن عَ ﭑ تَن نَن نَ عٍ مَرِفِ عَلَتَلَ رَ.»<verse eid="EZK 28:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 28:25"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، عَ نَشّ، «ﭑ نَ فّ عِسِرَيِلَ بْنسْييٍ بِرِن تٌنفٌدٍ حَمَنّيٍ تَفِ عٍ رَيٍنسٍنشِ دّننَشّ، ﭑ نَ ﭑ مَ سّنِيّنيِ مَسٍنمَ نّ عٍ بّ حَمَنّيٍ يَ شْرِ. نَ تّمُي عٍ سَبَتِمَ نّ قَ عٍ شَ بْشِ مَ، ﭑ نَشَن قِشِ ﭑ مَ كٌنيِ يَشُبَ مَ. <verse eid="EZK 28:25"/><verse number="26" style="v" sid="EZK 28:26"/>عٍ لُمَ نّ نَا شَشِلِسَ كُي، عٍ بَنشِيٍ تِ، عٍ سَنسِيٍ سِ. عٍ دْشْ نَا شَشِلِسَ كُي، ﭑ نَ عٍ دْشْبٌورٍيٍ حَشَنكَتَمَ تّمُي نَشّ، نَشٍيٍ نُ بَرَ عٍ تْورْ كِ قَنيِ رَ. نَ تّمُي، عٍ عَ كٌلٌنمَ نّ عَ ﭑ تَن نَن عٍ مَرِفِ عَلَتَلَ رَ.»<verse eid="EZK 28:26"/></para>
  <chapter eid="EZK 28"/>
  <chapter number="29" style="c" sid="EZK 29"/>
  <para style="s">مِسِرَ شَ حَشَنكَتّ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 29:1"/>عَ حّ قُ ندٍ، كِكٍ قُ، شِ قُ نُن قِرِن ندٍ رَ، عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، عَ نَشّ، <verse eid="EZK 29:1"/><verse number="2" style="v" sid="EZK 29:2"/>«عَدَ مَدِ، عِ شَ ﭑ مَ مَسٍنيِ تِ مِسِرَ مَنفّ نُن عَ شَ حَمَ بّ. <verse eid="EZK 29:2"/><verse number="3" style="v" sid="EZK 29:3"/>عَ قَلَ عَ بّ، ‹عَلَتَلَ يِ نَن مَسٍنشِ؛</para>
  <para style="q" vid="EZK 29:3">ﭑ بَرَ كٍلِ عِ شِلِ مَ، عِ تَن مِسِرَ قِرَوُنَ،</para>
  <para style="q" vid="EZK 29:3">نَشَن لُشِ عَلْ سْحّ مَفَاشُشِ شُرٍ سّنكِنّيٍ مَ.</para>
  <para style="q" vid="EZK 29:3">عِ نَشّ، «ﭑ بَرَ نِلِ شُرٍ دَا ﭑ يّتّ بّ.»<verse eid="EZK 29:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="EZK 29:4"/>كْنْ ﭑ كْنيِ بٍلٍبٍلٍ سْتِمَ نّ عِ بَنفَنيِيٍ كُي،</para>
  <para style="q" vid="EZK 29:4">ﭑ عَ نِيَمَ نّ يّشّيٍ شَ بْنِ عِ شَلٍيٍ مَ،</para>
  <para style="q" vid="EZK 29:4">ﭑ قَ عِ رَتٍ شُرٍ كُي، عِ تَن نُن نَ يّشّيٍ بِرِن نَ.<verse eid="EZK 29:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="EZK 29:5"/>ﭑ عِ لُمَ فبٍنفبٍرٍنيِ نَن مَ،</para>
  <para style="q" vid="EZK 29:5">عِ تَن نُن نَ يّشّيٍ بِرِن.</para>
  <para style="q" vid="EZK 29:5">وٌ لُمَ نَا، مِشِ يٌ مُ وٌ مَكْمَ.</para>
  <para style="q" vid="EZK 29:5">وٌ قِندِ مَ دٌنسٍ نَن نَ وُلَءِ سُبٍيٍ نُن شْنِيٍ بّ.<verse eid="EZK 29:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="EZK 29:6"/>نَ تّمُي مِسِرَكَيٍ بِرِن عَ كٌلٌنمَ نّ عَ ﭑ تَن نَن نَ عَلَتَلَ رَ.›»</para>
  <para style="b" vid="EZK 29:6"/>
  <para style="q" vid="EZK 29:6">«وٌ بَرَ لُ عَلْ كَلٍ عِسِرَيِلَ بْنسْي نَشَن سُشُ مَلِ سٍ رَ،<verse eid="EZK 29:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="EZK 29:7"/>كْنْ وٌ قَ عِبْو عَ بّلّشّ كُي، وٌ عَ تُنكِ سْشْ.</para>
  <para style="q" vid="EZK 29:7">عٍ تٌ عٍ شَشِلِ تِ وٌ رَ، وٌ عٍ يَنقَ نّ، عٍ قَ لُ تْورّ كُي.<verse eid="EZK 29:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="EZK 29:8"/>وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛</para>
  <para style="q" vid="EZK 29:8">ﭑ قَمَ نّ سَنتِدّفّمَ رَ وٌ شَ مِشِيٍ نُن وٌ شَ شُرُ سٍ قَشَقٍ رَ.<verse eid="EZK 29:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="EZK 29:9"/>مِسِرَ بْشِ نَ قِندِ يِرٍ مَشَرَشِ رَ نَشَن نَبّحِنشِ،</para>
  <para style="q" vid="EZK 29:9">عٍ عَ كٌلٌنمَ نّ عَ ﭑ تَن نَن نَ عَلَتَلَ رَ.»</para>
  <para style="b" vid="EZK 29:9"/>
  <para style="q" vid="EZK 29:9">«وٌ تٌ عَ قَلَ، ‹ﭑ بَرَ نِلِ شُرٍ دَا ﭑ يّتّ بّ،›<verse eid="EZK 29:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="EZK 29:10"/>ﭑ كٍلِمَ نّ وٌ شِلِ مَ نُن وٌ شَ شُرٍيٍ شِلِ مَ.</para>
  <para style="q" vid="EZK 29:10">ﭑ مِسِرَ بْشِ رَشَرَ مَ نّ، ﭑ عَ رَبّحِن،</para>
  <para style="q" vid="EZK 29:10">كٍلِقٍ مِفِدٌلِ مَ، هَن عَ سَ دْشْ عَسُوَن رَ، هَن كُسِ نَانِنيِ رَ.<verse eid="EZK 29:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="EZK 29:11"/>مِشِيٍ مُ دَنفِمَ نَا، سُبٍيٍ مُ دَنفِمَ نَا.</para>
  <para style="q" vid="EZK 29:11">مِشِ يٌ مُ سَبَتِمَ نَا هَن حّ تٌنفٌ نَانِ.<verse eid="EZK 29:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="EZK 29:12"/>ﭑ مِسِرَ بْشِ رَبّحِنمَ عَلْ يِرٍ فبّتّيٍ،</para>
  <para style="q" vid="EZK 29:12">ﭑ عَ شَ تَايٍ شُن نَكَنَمَ نّ عَلْ تَا فبّتّيٍ.</para>
  <para style="q" vid="EZK 29:12">ﭑ مِسِرَكَيٍ رَيٍنسٍنمَ نّ دُنِحَ يِرٍ بِرِن.»<verse eid="EZK 29:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 29:13"/>كْنْ وٌ مَرِفِ عَلَتَلَ مَن يِ نَن مَسٍنشِ؛ «حّ تٌنفٌ نَانِ دَنفِ شَنبِ، ﭑ مَن مِسِرَكَيٍ مَلَنمَ نّ، كٍلِقٍ حَمَنّيٍ مَ ﭑ عٍ رَيٍنسٍن دّننَشّ. <verse eid="EZK 29:13"/><verse number="14" style="v" sid="EZK 29:14"/>ﭑ عٍ رَفبِلٍنمَ نّ عٍ شْنيِ ثَتِرٌ سِ مَبِرِ كٍلِقٍ كٌنيِيَ كُي. ﭑ عٍ لُمَ نّ عٍ شَ عٍ يّتّ يَمَرِ، كْنْ عٍ شَ مَنفّيَ مُ سّنبّ فبٍفبٍ سْتْمَ. <verse eid="EZK 29:14"/><verse number="15" style="v" sid="EZK 29:15"/>عٍ مُ عٍ شُنيِ عِتٍمَ بْشِ فبّتّ يٌ شُن مَ سْنْن. ﭑ عٍ مَفٌرٌ مَ نّ، عَلَكٌ عٍ نَشَ نْ حَمَنّيٍ رَ. <verse eid="EZK 29:15"/><verse number="16" style="v" sid="EZK 29:16"/>عٍ مُ لِمَنِيَ قِمَ عِسِرَيِلَ مَ سْنْن. عِسِرَيِلَ نَ مِسِرَ قٍ مَحْشُن، عٍ رَتُمَ عٍ شَ يُنُبِيٍ نَن تُن مَ، عٍ تٌ عٍ شَشِلِ تِ عٍ رَ. نَ تّمُي، عٍ عَ كٌلٌنمَ نّ عَ ﭑ تَن نَن نَ عٍ مَرِفِ عَلَتَلَ رَ.»<verse eid="EZK 29:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 29:17"/>عَ حّ مْشْحّن ندٍ، كِكٍ سِنفٍ، شِ سِنفٍ رَ، عَلَتَلَ نَشَ مَسٍن ﭑ بّ، عَ نَشّ، <verse eid="EZK 29:17"/><verse number="18" style="v" sid="EZK 29:18"/>«عَدَ مَدِ، بَبِلْن مَنفّ نٍبُكَدَنسَرِ نُن عَ شَ سْورِيٍ بَرَ كَتَ تِرٍ رَفٌرٌدٍ، كْنْ عٍ مُ نْ عَ رَ قٍقٍ مَ. عٍ تْورْ نّ تُن، عٍ مُ نَاقُلِ يٌ سْتْ نَ كُي. <verse eid="EZK 29:18"/><verse number="19" style="v" sid="EZK 29:19"/>نَ نَن عَ رَ، وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛ ﭑ مِسِرَ بْشِ تَن قِمَ نّ بَبِلْن مَنفّ نٍبُكَدَنسَرِ مَ، عَ شَ عٍ شَ نَاقُلِ بِرِن شَنِن عَ شَ سْورِ فَلِ سَرٍ رَ. <verse eid="EZK 29:19"/><verse number="20" style="v" sid="EZK 29:20"/>ﭑ نَ بِرِن قِمَ نّ عَ مَ، بَرِ مَ عَ تَن نُن عَ شَ سْورِيٍ نَ نَن نَبَشِ ﭑ تَن بّ. وٌ مَرِفِ عَلَتَلَ شُي نَن نَ كِ. <verse eid="EZK 29:20"/><verse number="21" style="v" sid="EZK 29:21"/>نَ لْشْي، ﭑ عِسِرَيِلَ بْنسْي سّنبّ فبٌمَ نّ، ﭑ عِ شّيمَ مَسٍنيِ تِدٍ عٍ بّ. نَ تّمُي، عٍ عَ كٌلٌنمَ نّ عَ ﭑ تَن نَن نَ عَلَتَلَ رَ.»<verse eid="EZK 29:21"/></para>
  <chapter eid="EZK 29"/>
  <chapter number="30" style="c" sid="EZK 30"/>
  <para style="s">سُننُن سُوكِ مِسِرَ بّ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 30:1"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، عَ نَشّ، <verse eid="EZK 30:1"/><verse number="2" style="v" sid="EZK 30:2"/>«عَدَ مَدِ، عِ شَ يِ مَسٍنيِ تِ ﭑ شِلِ رَ؛ ‹وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛</para>
  <para style="q" vid="EZK 30:2">وٌ فبٍلٍفبٍلٍ! فبَلٌي لْشْي بَرَ قَ!<verse eid="EZK 30:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="EZK 30:3"/>عَلَتَلَ شَ لْشْي بَرَ مَكْرّ،</para>
  <para style="q" vid="EZK 30:3">دِ مِ بَرَ قَ فبَلٌي لْشْي رَ حَمَنّيٍ بّ.<verse eid="EZK 30:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="EZK 30:4"/>سَنتِدّفّمَ قَمَ نّ مِسِرَ شِلِ مَ،</para>
  <para style="q" vid="EZK 30:4">تْورّ دِنمَ نّ كُسِكَيٍ رَ.</para>
  <para style="q" vid="EZK 30:4">مِسِرَكَيٍ قَشَمَ نّ، عٍ شَ نَاقُلِ شَنِن، عٍ شَ تّتّيٍ بِرَ.›»<verse eid="EZK 30:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 30:5"/>كُسِ، ثُتِ، لُدُ، عَرَبُ، لِبِيَ، نُن عَلَ شَ حَمَ عَ سَاتّ تٌنفٌشِ نَشَن بّ، عٍ بِرِن قَشَمَ نّ سَنتِدّفّمَ رَ عَ نُن مِسِرَ.<verse eid="EZK 30:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="EZK 30:6"/>«عَلَتَلَ يِ نَن مَسٍنشِ؛</para>
  <para style="q" vid="EZK 30:6">‹مِسِرَ مَلِمَيٍ بِرَ مَ نّ،</para>
  <para style="q" vid="EZK 30:6">عَ يّتّ سّنبّ حْنمَ نّ، عَ نُ لَشِ نَشَن نَ.</para>
  <para style="q" vid="EZK 30:6">كٍلِقٍ مِفِدٌلِ، هَن عَسُوَن، عٍ قَشَمَ نّ سَنتِدّفّمَ رَ.</para>
  <para style="q" vid="EZK 30:6">وٌ مَرِفِ عَلَتَلَ شُي نَن نَ كِ.›»<verse eid="EZK 30:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="EZK 30:7"/>«ﭑ مِسِرَ بْشِ رَبّحِنمَ نّ عَلْ يِرٍ فبّتّيٍ،</para>
  <para style="q" vid="EZK 30:7">ﭑ عَ شَ تَايٍ شُن نَكَنَ عَلْ تَا فبّتّيٍ.<verse eid="EZK 30:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="EZK 30:8"/>ﭑ نَ تّ سٌ مِسِرَ رَ، ﭑ نَ نْ عٍ مَلِمَيٍ رَ،</para>
  <para style="q" vid="EZK 30:8">عٍ عَ كٌلٌنمَ نّ عَ ﭑ تَن نَن نَ عَلَتَلَ رَ.»<verse eid="EZK 30:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 30:9"/>«نَ لْشْي، ﭑ شّيرَيٍ شّيمَ نّ كُنكُييٍ كُي، عٍ شَ كُسِكَيٍ مَفَاشُ، عَلَكٌ عَ شَ بِرَ ﭑ قْشْ رَ. كْنتْقِلِ دُ سُمَ نّ عٍ شُن نَ مِسِرَكَيٍ شَ فبَلٌي لْشْي نَشَن قَقٍ، عَ مُ كَنَمَ.»<verse eid="EZK 30:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="EZK 30:10"/>«وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛</para>
  <para style="q" vid="EZK 30:10">‹ﭑ مِسِرَ شَ حَمَ وُيَشِ سْنتْمَ نّ بَبِلْن مَنفّ نٍبُكَدَنسَرِ سّنبّ رَ.<verse eid="EZK 30:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="EZK 30:11"/>عَ تَن نُن عَ شَ سْورِ فَلِ، نَشَن مَفَاشُشِ سْورِ فَلِ بِرِن بّ،</para>
  <para style="q" vid="EZK 30:11">ﭑ عٍ قَمَ نّ نَ بْشِ شُن نَكَنَدٍ.</para>
  <para style="q" vid="EZK 30:11">عٍ مِسِرَكَيٍ قَشَمَ نّ سَنتِدّفّمَ رَ،</para>
  <para style="q" vid="EZK 30:11">عٍ بْشِ رَقٍمَ نّ نَ بِنبِيٍ رَ.<verse eid="EZK 30:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="EZK 30:12"/>ﭑ نِلِ شُرٍ شْرِ مَ نّ،</para>
  <para style="q" vid="EZK 30:12">ﭑ عَ بْشِ مَتِ مِشِ حَاشِيٍ مَ،</para>
  <para style="q" vid="EZK 30:12">نَشٍيٍ عَ نِيَ نَ بْشِ بِرِن شُن شَ رَكَنَ.</para>
  <para style="q" vid="EZK 30:12">عَلَتَلَ شُي نَن نَ كِ.›»<verse eid="EZK 30:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="EZK 30:13"/>«وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛</para>
  <para style="q" vid="EZK 30:13">ﭑ وٌ شَ كُيٍيٍ كَنَمَ نّ،</para>
  <para style="q" vid="EZK 30:13">ﭑ وٌ شَ كُيٍيٍ رَحْنمَ نّ نٌقِ تَا كُي.</para>
  <para style="q" vid="EZK 30:13">مَنفّ يٌ مُ لُمَ مِسِرَ بْشِ مَ سْنْن.</para>
  <para style="q" vid="EZK 30:13">ﭑ فَاشُي لُمَ نّ نَ بْشِ بِرِن مَ.<verse eid="EZK 30:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="EZK 30:14"/>ﭑ ثَتِرٌ سِ شُن نَكَنَمَ نّ،</para>
  <para style="q" vid="EZK 30:14">ﭑ تّ دِن سٌوَن نَ،</para>
  <para style="q" vid="EZK 30:14">ﭑ تٍبٍسٍ حَشَنكَتَ.<verse eid="EZK 30:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="EZK 30:15"/>ﭑ نَ ﭑ مَ شْنّ رَ مِنِمَ نّ سِنِ مَ، مِسِرَ سّنبّ نَ دّننَشّ،</para>
  <para style="q" vid="EZK 30:15">ﭑ تٍبٍسٍ شَ حَمَ بِرِن سْنتْ.<verse eid="EZK 30:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="EZK 30:16"/>ﭑ تّ سٌمَ نّ مِسِرَ رَ،</para>
  <para style="q" vid="EZK 30:16">ﭑ سِنِ رَ سّرّن تْورّ كُي،</para>
  <para style="q" vid="EZK 30:16">ﭑ تٍبٍسٍ شُن نَكَنَ،</para>
  <para style="q" vid="EZK 30:16">ﭑ نٌقِ سٌ عَ يَشُييٍ يِ رَ.<verse eid="EZK 30:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="EZK 30:17"/>عٌنِ نُن ثِ بّسّتِ سْورِيٍ بِرِن قَشَمَ نّ سَنتِدّفّمَ رَ،</para>
  <para style="q" vid="EZK 30:17">تَاكَيٍ شَنِنمَ نّ كٌنيِيَ كُي.<verse eid="EZK 30:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="EZK 30:18"/>تَثَنشّسِ بِرَ لْشْي شْرْشْمَ نّ مِسِرَ بّ،</para>
  <para style="q" vid="EZK 30:18">بَرِ مَ نَ تّمُي، عَ سّنبّ حْنمَ نّ،</para>
  <para style="q" vid="EZK 30:18">عَ سّنبّ عَ نُ لَشِ نَشَن نَ.<verse eid="EZK 30:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="EZK 30:19"/>ﭑ مِسِرَ حَشَنكَتَمَ نّ،</para>
  <para style="q" vid="EZK 30:19">عٍ قَ عَ كٌلٌن عَ ﭑ تَن نَن عَلَتَلَ رَ.»<verse eid="EZK 30:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 30:20"/>عَ حّ قُ نُن كٍرٍن ندٍ، كِكٍ سِنفٍ، شِ سٌلٌقٍرٍ ندٍ رَ، عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، عَ نَشّ، <verse eid="EZK 30:20"/><verse number="21" style="v" sid="EZK 30:21"/>«عَدَ مَدِ، ﭑ بَرَ مِسِرَ قِرَوُنَ بّلّشّ فِرَ. عَ مُ مَشِرِ مَ، سٍرِ مُ سَمَ عَ مَ، سٍسٍ مُ رَبَمَ عَ يَلَنقٍ رَ، عَ قَ نْ سَنتِدّفّمَ تٌنفٌدٍ. <verse eid="EZK 30:21"/><verse number="22" style="v" sid="EZK 30:22"/>وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛ ﭑ قَقٍ مِسِرَ قِرَوُنَ شِلِ مَ، ﭑ شَ عَ بّلّشّ قِرِنيِيٍ فِرَ، عَ بّلّشّ قَنيِ نُن عَ بّلّشّ كَنَشِ، عَلَكٌ عَ شَ سَنتِدّفّمَ لُ نَا عَبَدَن. <verse eid="EZK 30:22"/><verse number="23" style="v" sid="EZK 30:23"/>ﭑ مِسِرَكَيٍ رَيٍنسٍنمَ نّ دُنِحَ بِرِن مَ. <verse eid="EZK 30:23"/><verse number="24" style="v" sid="EZK 30:24"/>ﭑ نَ ﭑ مَ سَنتِدّفّمَ سٌمَ نّ بَبِلْن مَنفّ يِ، ﭑ سّنبّ قِ عَ مَ، كْنْ ﭑ قِرَوُنَ بّلّشّيٍ فِرَ مَ نّ، عَ نُونُ عَ يَ عِ عَلْ مِشِ نَشَن نَ قَشَقٍ. <verse eid="EZK 30:24"/><verse number="25" style="v" sid="EZK 30:25"/>ﭑ سّنبّ قِمَ نّ بَبِلْن مَنفّ مَ، كْنْ ﭑ قِرَوُنَ تَن بّلّشّيٍ عِفٌرٌ. ﭑ نَ ﭑ مَ سَنتِدّفّمَ سَ بَبِلْن مَنفّ بّلّشّ تّمُي نَشّ، عَ نَشَ عَ عِتٍ مِسِرَ شِلِ مَ، عٍ عَ كٌلٌنمَ نّ عَ ﭑ تَن نَن نَ عَلَتَلَ رَ. <verse eid="EZK 30:25"/><verse number="26" style="v" sid="EZK 30:26"/>ﭑ مِسِرَكَيٍ رَيٍنسٍنمَ نّ دُنِحَ بِرِن مَ. نَ تّمُي، عٍ عَ كٌلٌنمَ نّ عَ ﭑ تَن نَن نَ عَلَتَلَ رَ.»<verse eid="EZK 30:26"/></para>
  <chapter eid="EZK 30"/>
  <chapter number="31" style="c" sid="EZK 31"/>
  <para style="s">تَالِ وْيّنيِ مِسِرَ شَ قٍ رَ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 31:1"/>عَ حّ قُ نُن كٍرٍن ندٍ، كِكٍ سَشَن، شِ سِنفٍ رَ، عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، عَ نَشّ، <verse eid="EZK 31:1"/><verse number="2" style="v" sid="EZK 31:2"/>«عَدَ مَدِ، عَ قَلَ مِسِرَ قِرَوُنَ نُن عَ شَ حَمَ بّ،</para>
  <para style="q" vid="EZK 31:2">‹وٌ مَنِيّ نَ مِندٍن؟<verse eid="EZK 31:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="EZK 31:3"/>عَسِرِيَ بْشِ نُ لُشِ نّ عَلْ سّدِرِ وُرِ بِلِ ندٍ نَشَن نُ نَ لِبَن وٌندِ.</para>
  <para style="q" vid="EZK 31:3">عَ سَلٌنيِيٍ نُ تٌقَن، عَ نِينِ فبٌ، عَ عِتٍ دَنفِ وُرِ بِرِن نَ.<verse eid="EZK 31:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="EZK 31:4"/>تُنّ يٍ نُ بَرَ عَ رَ مْ،</para>
  <para style="q" vid="EZK 31:4">يٍ نَشَن نَ بْشِ بُن، نَ نُ بَرَ عَ رَكُيَ.</para>
  <para style="q" vid="EZK 31:4">عَ نُ يٍ رَدِنمَ عَ سَنكٍيٍ مَ،</para>
  <para style="q" vid="EZK 31:4">عَ قَ يٍ شَنِن قْتْنيِ بِرِن كُي.<verse eid="EZK 31:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="EZK 31:5"/>نَ نَن عَ نِيَ، عَ تَن نُ عِتٍ نَ قْتْنيِ وُرِ بِلِيٍ بِرِن بّ،</para>
  <para style="q" vid="EZK 31:5">عَ سَلٌنيِيٍ نُ بَرَ وُيَ،</para>
  <para style="q" vid="EZK 31:5">عٍ نُ قَ كُيَ رَ نَ يٍ سَابُي رَ.<verse eid="EZK 31:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="EZK 31:6"/>شْنِيٍ نُ عٍ شّلّيٍ سَمَ عَ سَلٌنيِيٍ مَ،</para>
  <para style="q" vid="EZK 31:6">بُرُنيِ سُبٍيٍ نُ دِ بَرِ مَ عَ نِينِ بُن مَ،</para>
  <para style="q" vid="EZK 31:6">حَمَنّيٍ نُ سَبَتِشِ عَ سّيتِ مَ.<verse eid="EZK 31:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="EZK 31:7"/>عَ نُ تٌقَن عَ شَ شُنفبٍ شَ قٍ رَ،</para>
  <para style="q" vid="EZK 31:7">عَ سَلٌنيِيٍ نُ كُيَ هَن، عَ سَنكٍ نُ بِرِشِ بْشِ بُن مَ ثٌن يٍ قٍنقٍ رَ.<verse eid="EZK 31:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="EZK 31:8"/>سّدِرِ بِلِ نَشٍيٍ نُ نَ عَلَ شَ بْشِ مَ عٍدٍن مَبِرِ،</para>
  <para style="q" vid="EZK 31:8">نٍيٍ مُ عَ شَ كُيّ سْتْ.</para>
  <para style="q" vid="EZK 31:8">عَ سَلٌنيِيٍ نُ كُيَ سِثِرِ سَلٌنيِيٍ بّ، عٍ كُيَ وُرِ مْولِ بِرِن بّ.</para>
  <para style="q" vid="EZK 31:8">عَ تٌقَنيِ مَنِيّ يٌ مُ نُ نَ عَلَ شَ بْشِ مَ.<verse eid="EZK 31:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="EZK 31:9"/>ﭑ تَن نَن عَ رَتٌقَن، ﭑ تَن نَ عَ سَلٌنيِيٍ وُيَ،</para>
  <para style="q" vid="EZK 31:9">دَنفِقٍ وُرِ بِلِ بِرِن نَ عَلَ شَ بْشِ مَ عٍدٍن مَبِرِ.›»<verse eid="EZK 31:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 31:10"/>«نَ نَن عَ تٌ، وٌ مَرِفِ عَلَتَلَ نَشَ يِ مَسٍن؛ عَ تٌ نُ عِتٍ دَنفِ وُرِ بِرِن نَ، يّتّ عِفبٌحَ قَ لُ عَ بْحّ كُي، <verse eid="EZK 31:10"/><verse number="11" style="v" sid="EZK 31:11"/>ﭑ عَ سَشِ حَمَنّيٍ شَ مَنفّيٍ سَفٌي نَ نَن مَ، عٍ شَ عَ حَشَنكَتَ عَ شَ حَاشُحَ بّرّ رَ. ﭑ تٌ عَ بّحِن، <verse eid="EZK 31:11"/><verse number="12" style="v" sid="EZK 31:12"/>مَنفّ ندٍ نَشَن كٌبِ عَ بِرِن بّ، عَ بَرَ عَ قْن، عَ قَ عَ لُ نَا. عَ سَلٌنيِيٍ بَرَ بِرَ فٍيَيٍ قَرِ نُن فُلُنبَيٍ كُي. عَ سَلٌنيِ فِرَشِيٍ نُ نَ بْشِ بِرِن مَ. حَمَنّيٍ نَشَ كٍلِ عَ نِينِ بُن مَ. <verse eid="EZK 31:12"/><verse number="13" style="v" sid="EZK 31:13"/>شْنِيٍ نُن بُرُنيِ سُبٍيٍ فبَنسَن نَن نُ لُشِ عَ سَلٌنيِيٍ تَفِ. <verse eid="EZK 31:13"/><verse number="14" style="v" sid="EZK 31:14"/>نَ كُي، عَ مُ لَنمَ وُرِ يٌ شَ كُيَ نَ كِ دَنفِ وُرِ بِرِن نَ. وُرِ نَشٍيٍ يٍ سْتْ عَ قَنيِ رَ، عَ مُ لَن عٍ شَ نَ كُيّيَ لِ. سّرِيّ كِ مَ، عٍ شَ قَشَ عَلْ عِبُنَدَ مَ نَشَن سِفَمَ عَلِفِيَمَ.»<verse eid="EZK 31:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 31:15"/>«وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛ عَ قَشَ لْشْي نَشّ، ﭑ عَ حْن قٍ رَبَ نّ يٍ بِرِن نَ، يٍ قَ شْرِ. ﭑ نَشَ دِ مِ رَ سِن لِبَن مَ عَ شَ قٍ رَ، قْتْنيِ نَشَ شَرَ. <verse eid="EZK 31:15"/><verse number="16" style="v" sid="EZK 31:16"/>ﭑ نَشَ حَمَنّيٍ رَفَاشُ عَ بِرَ شُي مَ، ﭑ تٌ عَ قَشَ عَلْ مِشِ نَشٍيٍ قَشَشِ سِفَمَ عَلِفِيَمَ. نَ تّمُي عٍدٍن وُرِ بِلِيٍ بِرِن، نَشٍيٍ قَن لِبَن وُرِ بِلِيٍ بِرِن بّ، نَشٍيٍ يٍ سْتْ عَ قَنيِ رَ، نٍيٍ نَشَ رَشَرَ. <verse eid="EZK 31:16"/><verse number="17" style="v" sid="EZK 31:17"/>مِشِ نَشٍيٍ نُ سَبَتِشِ نَ وُرِ شُنفبٍ نِينِ بُن مَ، عٍ نُن نَشٍيٍ نُ سَاتَشِ، عٍ قَن نَشَ سِفَ عَلِفِيَمَ، عٍ قَ مِشِيٍ لِ عٍ نُ بَرَ نَشٍيٍ قَشَ سَنتِدّفّمَ رَ.»<verse eid="EZK 31:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 31:18"/>«عٍدٍن وُرِ مُندُن مَنِيَمَ وٌ شَ تٌقَنيِ نُن وٌ شَ سّنبّ رَ؟ هَلِ وٌ تَن فٌرٌ عَلِفِيَمَ، وٌ قَ لُ سُننَتَرٍيٍ يَ مَ نَشٍيٍ قَشَمَ سَنتِدّفّمَ رَ. نَ بِرِن مِسَالِشِ مِسِرَ مَنفّ قِرَوُنَ نُن عَ شَ سْورِ فَلِ نَن نَ. وٌ مَرِفِ عَلَتَلَ شُي نَن نَ كِ.»<verse eid="EZK 31:18"/></para>
  <chapter eid="EZK 31"/>
  <chapter number="32" style="c" sid="EZK 32"/>
  <para style="s">سُننُن سُوكِ قِرَوُنَ بّ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 32:1"/>عَ حّ قُ نُن قِرِن ندٍ، كِكٍ قُ نُن قِرِن، شِ سِنفٍ رَ، عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، عَ نَشّ، <verse eid="EZK 32:1"/><verse number="2" style="v" sid="EZK 32:2"/>«عَدَ مَدِ سُوكِ ندٍ سَ مِسِرَ مَنفّ قِرَوُنَ بّ، عَ قَلَقٍ رَ؛</para>
  <para style="q" vid="EZK 32:2">‹عِ لُشِ نّ عَلْ يّتّ حَمَنّيٍ تَفِ،</para>
  <para style="q" vid="EZK 32:2">عَلْ يّشّ مَفَاشُشِ بَا مَ،</para>
  <para style="q" vid="EZK 32:2">نَشَن يٍ عِمَشَمَ عَ بّلّ رَ هَن عَ دُندَ.<verse eid="EZK 32:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="EZK 32:3"/>عِ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ، عَ نَشّ؛</para>
  <para style="q" vid="EZK 32:3">ﭑ نَ ﭑ مَ يّلّ دُ سُمَ نّ عِ شُن نَ،</para>
  <para style="q" vid="EZK 32:3">فَلِ قَ عِ بّندُن ﭑ مَ.<verse eid="EZK 32:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="EZK 32:4"/>ﭑ عِ رَتٍمَ نّ شَرٍ مَ،</para>
  <para style="q" vid="EZK 32:4">ﭑ عِ وٌلِ قِيلِ مَ، شْنِيٍ نُن بُرُنيِ سُبٍيٍ لُفَ عِ رَ.<verse eid="EZK 32:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="EZK 32:5"/>ﭑ عِ سُبٍ سَمَ نّ فٍيَيٍ قَرِ،</para>
  <para style="q" vid="EZK 32:5">عِ شُنتُنيِيٍ لُ فُلُنبَيٍ كُي،<verse eid="EZK 32:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="EZK 32:6"/>بْشِ بُندَ عِ وُلِ رَ هَن فٍيَيٍ قَرِ،</para>
  <para style="q" vid="EZK 32:6">عِ سُبٍ تٌ قٌلٍيٍ كُي.<verse eid="EZK 32:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="EZK 32:7"/>ﭑ نَ عِ شُن نَكَنَ،</para>
  <para style="q" vid="EZK 32:7">ﭑ كٌورٍ مَكٌتٌمَ نّ، ﭑ تُنبُييٍ شَ يَنبّ بَ.</para>
  <para style="q" vid="EZK 32:7">ﭑ سٌفٍ مَكٌتٌمَ نّ نُشُي رَ، كِكٍ قَن مُ يَنبَمَ.<verse eid="EZK 32:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="EZK 32:8"/>ﭑ يَنبَسٍيٍ بِرِن مَكٌتٌمَ نّ عِ شَ قٍ رَ،</para>
  <para style="q" vid="EZK 32:8">ﭑ دِ مِ رَ سِن عِ شَ بْشِ مَ.</para>
  <para style="q" vid="EZK 32:8">عِ مَرِفِ عَلَتَلَ شُي نَن نَن كِ.›»<verse eid="EZK 32:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="EZK 32:9"/>«ﭑ نَ عِ شَ كَنَرِ مَسٍن حَمَنّيٍ مَ،</para>
  <para style="q" vid="EZK 32:9">ﭑ حَمَ فبٍفبٍ رَشْنْمَ نّ عِ شِلِ مَ،</para>
  <para style="q" vid="EZK 32:9">عِ مُ نَشٍيٍ كٌلٌن.<verse eid="EZK 32:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="EZK 32:10"/>ﭑ نَ ﭑ مَ سَنتِدّفّمَ بَ عَ تّي كُي،</para>
  <para style="q" vid="EZK 32:10">ﭑ سِ فبٍفبٍ رَتّرّننَمَ نّ عِ شَ قٍ رَ،</para>
  <para style="q" vid="EZK 32:10">عٍ شَ مَنفّيٍ قَ فَاشُ.</para>
  <para style="q" vid="EZK 32:10">عٍ نَ عِ شَ بِرّ تٌ،</para>
  <para style="q" vid="EZK 32:10">عٍ بِرِن فَاشُمَ نّ عٍ يّتّ شَ قٍ رَ.<verse eid="EZK 32:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="EZK 32:11"/>عٍ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ، عَ نَشّ؛</para>
  <para style="q" vid="EZK 32:11">بَبِلْن مَنفّ شَ سَنتِدّفّمَ عِ لِمَ نّ.<verse eid="EZK 32:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="EZK 32:12"/>ﭑ عِ شَ سْورِ فَلِيٍ رَفٌرٌ مَ نّ حَلَمَيٍ شَ سَنتِدّفّمَ رَ،</para>
  <para style="q" vid="EZK 32:12">حَلَمَيٍ نَشٍيٍ حَاشُ سْورِيٍ بِرِن بّ.</para>
  <para style="q" vid="EZK 32:12">عٍ مِسِرَكَيٍ شَ يّتّ عِفبٌحَ كَنَمَ نّ،</para>
  <para style="q" vid="EZK 32:12">عٍ عٍ شَ سْورِ فَلِيٍ سْنتْ.<verse eid="EZK 32:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="EZK 32:13"/>ﭑ عِ شَ شُرُ سٍيٍ قَشَمَ نّ نِلِ شُرٍ دّ رَ.</para>
  <para style="q" vid="EZK 32:13">مِشِ يٌ، شُرُ سٍ يٌ، سٍسٍ مُ لُ نَ يٍ دُندَ رَ.<verse eid="EZK 32:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="EZK 32:14"/>ﭑ نَ يٍ رَشَرَ مَ نّ، عَ شّلّ عَلْ تُرٍ.</para>
  <para style="q" vid="EZK 32:14">عِ مَرِفِ عَلَتَلَ شُي نَن نَ كِ.»<verse eid="EZK 32:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="EZK 32:15"/>«ﭑ نَ مِسِرَ بْشِ قِندِ يِرٍ مَشَرَشِ رَ،</para>
  <para style="q" vid="EZK 32:15">ﭑ نَ عَ هَرِفٍ بِرِن بَ نَا،</para>
  <para style="q" vid="EZK 32:15">ﭑ نَ عَ شَ مِشِيٍ بِرِن قَشَ،</para>
  <para style="q" vid="EZK 32:15">نَ تّمُي، عٍ عَ كٌلٌنمَ نّ عَ ﭑ تَن نَن نَ عٍ مَرِفِ عَلَتَلَ رَ.»<verse eid="EZK 32:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 32:16"/>«سُننُن سُوكِ نَن نَ كِ، حَمَنّيٍ قَمَ نَشَن بَدٍ مِسِرَ نُن عَ شَ سْورِ فَلِيٍ بّ. وٌ مَرِفِ عَلَتَلَ شُي نَن نَ كِ.»<verse eid="EZK 32:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 32:17"/>عَ حّ قُ نُن قِرِن ندٍ، كِكٍ قُ نُن قِرِن، شِ قُ نُن سُولِ ندٍ رَ، عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، عَ نَشّ، <verse eid="EZK 32:17"/><verse number="18" style="v" sid="EZK 32:18"/>«عَدَ مَدِ، وَ شُي رَتٍ مِسِرَ شَ سْورِ فَلِيٍ نُن حَمَنّيٍ شَ قٍ رَ، نَشٍيٍ بِرِن سِفَمَ عَلِفِيَمَ. <verse eid="EZK 32:18"/><verse number="19" style="v" sid="EZK 32:19"/>عَ قَلَ عٍ بّ، ‹وٌ تَن شَ قٍ دَنفِ وٌ بٌورٍيٍ رَ؟ وٌ قَشَمَ نّ، وٌ نُن سُننَتَرٍيٍ رَفَتَ يِرٍ كٍرٍن.› <verse eid="EZK 32:19"/><verse number="20" style="v" sid="EZK 32:20"/>مِسِرَ نُن عَ شَ سْورِ فَلِيٍ قَشَمَ سَنتِدّفّمَ نَن سَابُي رَ. <verse eid="EZK 32:20"/><verse number="21" style="v" sid="EZK 32:21"/>عٍ حَمَنّ مَنفّ حَلَمَيٍ لِمَ نّ عَلِفِيَمَ، نَشٍيٍ عَ قَلَمَ مِسِرَ شَ قٍ رَ، ‹عٍ قَن بَرَ سِفَ عَلِفِيَمَ، عٍ قَ لُ سُننَتَرٍيٍ قّ مَ نَشٍيٍ مَن قَشَشِ سَنتِدّفّمَ رَ.›»<verse eid="EZK 32:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 32:22"/>«عَسِرِيَ نُن عَ شَ سْورِ فَلِ بِرِن نَ مّننِ فَبُرِيٍ تَفِ، عَ شَ مِشِيٍ بِرِن نَشٍيٍ قَشَشِ سَنتِدّفّمَ رَ. <verse eid="EZK 32:22"/><verse number="23" style="v" sid="EZK 32:23"/>عَسِرِيَكَيٍ رَفَتَشِ عَلِفِيَمَ، عٍ شَ سْورِ فَلِيٍ سَشِ عٍ سّيتِ مَ، عٍ تَن نَشٍيٍ بِرِن فبَلٌي رَدِن دُنِحَ مَ عٍ شَ سَنتِدّفّمَ سَابُي رَ.»<verse eid="EZK 32:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 32:24"/>«عٍلَمَ نُن عَ شَ سْورِ فَلِيٍ قَن نَ عٍ شَ فَبُرِيٍ سّيتِ مَ. عٍ قَن قَشَشِ سَنتِدّفّمَ نَن نَ، عٍ تَن نَشٍيٍ فبَلٌي رَدِن دُنِحَ مَ، عٍ قَن سَمَ نّ سُننَتَرٍيٍ سّيتِ مَ عَلِفِيَمَ، يَافِ نَ عٍ قْشْ رَ. <verse eid="EZK 32:24"/><verse number="25" style="v" sid="EZK 32:25"/>عَ تَن نُن عَ شَ سْورِ فَلِيٍ بِرِن سَشِ مِشِ قَشَشِيٍ يَ مَ مّننِ، عٍ فَبُرِيٍ عَ رَبِلِنشِ. نَ سُننَتَرٍيٍ بِرِن قَشَشِ سَنتِدّفّمَ نَن نَ. عٍ تٌ فبَلٌي رَدِن دُنِحَ مَ، عٍ قَن سِفَمَ نّ عَلِفِيَمَ يَافِ كُي، عٍ قَ لُ مِشِ قَشَشِيٍ يَ مَ.»<verse eid="EZK 32:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="EZK 32:26"/>«مٍسٍكِ نُن تُبَلِ شَ سْورِ فَلِيٍ قَن نَ نَا فَبُرِيٍ كُي. نَ سُننَتَرٍيٍ بِرِن قَشَشِ سَنتِدّفّمَ نَن نَ، بَرِ مَ عٍ نُ فبَلٌي رَدِنمَ دُنِحَ مَ. <verse eid="EZK 32:26"/><verse number="27" style="v" sid="EZK 32:27"/>عٍ مُ سَشِ سْورِ سُننَتَرٍ فبّتّيٍ قّ مَ، نَشٍيٍ سِفَشِ عَلِفِيَمَ عٍ شَ فٍرٍ سٌسٍيٍ رَ، عٍ شَ سَنتِدّفّمَ سَشِ عٍ شُنيِ بُن مَ؟ عٍ شَ يُنُبِ سَرٍ بَرَ فبِلٍن عٍ شْرِيٍ مَ فبَلٌي شَ قٍ رَ، عٍ نَشَن نَبَشِ دُنِحَ مَ.»<verse eid="EZK 32:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 32:28"/>«مِسِرَ مَنفّ قِرَوُنَ قَن بِرَ مَ نّ، عَ قَ سَ سُننَتَرٍيٍ يَ مَ نَشٍيٍ قَشَشِ سَنتِدّفّمَ رَ.»<verse eid="EZK 32:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EZK 32:29"/>«عٍدٌن شَ مَنفّيٍ نُن عَ شَ كُنتِفِيٍ قَن نَ نَا. هَلِ عٍ سّنبّ نُ فبٌ، يَكْسِ عٍ سَشِ سُننَتَرٍيٍ يَ مَ نَشٍيٍ قَشَشِ سَنتِدّفّمَ رَ.»<verse eid="EZK 32:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 32:30"/>«مَنفّ نَشٍيٍ كٍلِشِ كْولَ مَبِرِ رَ، نُن سِدْنكَيٍ قَن نَ نَا. هَلِ عٍ سّنبّ نُ فبٌ، عٍ قَ فبَلٌي رَبَ دُنِحَ مَ، عٍ قَن سَشِ سُننَتَرٍيٍ يَ مَ نَشٍيٍ قَشَشِ سَنتِدّفّمَ رَ. نَ يَافِ نَ عٍ شُن مَ عَلِفِيَمَ.»<verse eid="EZK 32:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="EZK 32:31"/>«مِسِرَ شَ قِرَوُنَ نُن عَ شَ سْورِ فَلِيٍ نٍيٍ تٌمَ نّ، عٍ قَ مَدُندُ عٍ شَ سْورِيٍ شَ قٍ رَ نَشٍيٍ قَشَشِ سَنتِدّفّمَ رَ. وٌ مَرِفِ عَلَتَلَ شُي نَن نَ كِ. <verse eid="EZK 32:31"/><verse number="32" style="v" sid="EZK 32:32"/>هَلِ ﭑ تٌ عَ لُ عَ فبَلٌي رَبَ دُنِحَ مَ، قِرَوُنَ نُن عَ شَ سْورِ فَلِيٍ سَمَ نّ سُننَتَرٍيٍ قّ مَ نَشٍيٍ قَشَشِ سَنتِدّفّمَ رَ. وٌ مَرِفِ عَلَتَلَ شُي نَن نَ كِ.»<verse eid="EZK 32:32"/></para>
  <chapter eid="EZK 32"/>
  <chapter number="33" style="c" sid="EZK 33"/>
  <para style="s">مَكَنتَمَ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 33:1"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، عَ نَشّ، <verse eid="EZK 33:1"/><verse number="2" style="v" sid="EZK 33:2"/>«عَدَ مَدِ، عَ قَلَ عِ نفَشَكٍرٍنيِيٍ بّ، ‹ﭑ نَ قَ سَنتِدّفّمَ رَ وٌ شَ بْشِ شِلِ مَ، نَ عَ لِمَ نّ وٌ حَن بَرَ مِشِ ندٍ سُفَندِ تَا مَكَنتَمَ رَ. <verse eid="EZK 33:2"/><verse number="3" style="v" sid="EZK 33:3"/>شَ نَ تَا مَكَنتَمَ يَشُييٍ تٌ قَ رَ، عَ لَنمَ عَ شَ سَرَ قٍ حَمَ رَكٌلٌنقٍ رَ. <verse eid="EZK 33:3"/><verse number="4" style="v" sid="EZK 33:4"/>شَ عَ نَ رَبَ، كْنْ مِشِ ندٍ قَ عَ بْتّ رَبَ نَ مَرَكٌلٌنيِ شُي مَ، عَ قَ قَشَ فٍرٍ كُي، عَ بَرَ نَ قَشّ رَفِرِ عَ يّتّ مَ. <verse eid="EZK 33:4"/><verse number="5" style="v" sid="EZK 33:5"/>عَ تٌ سَرَ قٍ شُي مّ، كْنْ عَ قَ عَ بْتّ رَبَ، عَ نِي كٌتٍ نَ عَ يّتّ نَن شُن مَ. كْنْ مِشِ نَشَن نَ مَرَكٌلٌنيِ مّ، عَ قَ عَ سُشُ سْوبّ رَ، نَ كَنيِ عَ نِي رَكِسِمَ نّ. <verse eid="EZK 33:5"/><verse number="6" style="v" sid="EZK 33:6"/>كْنْ شَ تَا مَكَنتَمَ يَشُييٍ تٌ قَ رَ، عَ مُ سَرَ قٍ عَ شَ مِشِيٍ رَكٌلٌن، نَ تّمُي مِشِ نَشَن قَشَمَ نَ فٍرٍ كُي، هَلِ عٍ شَ يُنُبِيٍ بَرَ عَ نِيَ عٍ شَ سْنتْ، ﭑ عٍ نِي كٌتٍ سَمَ تَا مَكَنتَمَ نَن شُن مَ.›»<verse eid="EZK 33:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 33:7"/>«عَدَ مَدِ، ﭑ بَرَ عِ سُفَندِ تَا مَكَنتَمَ رَ عِسِرَيِلَ بْنسْي بّ. عِ شَ عِ تُلِ مَتِ ﭑ مَ مَسٍنيِ رَ، عِ قَ عٍ رَكٌلٌن عَ رَ ﭑ تَن شِلِ رَ. <verse eid="EZK 33:7"/><verse number="8" style="v" sid="EZK 33:8"/>ﭑ نَ عَ قَلَ مِشِ كٌبِ بّ عَ قَشَمَ نّ، شَ عِ مُ عَ رَكٌلٌن عَ شَ فبِلٍن عَ شَ كِرَ كٌبِ قْشْ رَ، نَ مِشِ حَاشِ قَشَمَ نّ عَ شَ يُنُبِ شَ قٍ رَ، كْنْ ﭑ نَ نِي كٌتٍ سَمَ عِ تَن شُن مَ. <verse eid="EZK 33:8"/><verse number="9" style="v" sid="EZK 33:9"/>كْنْ شَ عِ عَ رَكٌلٌن عَ شَ فبِلٍن عَ شَ كِرَ كٌبِ قْشْ رَ، عَ قَ لُ عَ مُ تِن نَ رَ، عَ قَشَمَ عَ شَ يُنُبِ شَ قٍ نَن نَ، كْنْ عِ تَن بَرَ عِ نِي رَكِسِ.»<verse eid="EZK 33:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 33:10"/>«عَدَ مَدِ، عَ قَلَ عِسِرَيِلَ بْنسْي بّ، عِ نَشّ، ‹وٌ يّتّ عَ قَلَمَ، وٌ وٌ شَ مُرُتّ نُن وٌ شَ يُنُبِيٍ كٌلٌن وٌ بْحّ كُي. وٌ وَ مَ عَ كٌلٌنقٍ نّ وٌ كِسِ سْتْمَ كِ نَشّ. <verse eid="EZK 33:10"/><verse number="11" style="v" sid="EZK 33:11"/>وٌ مَرِفِ عَلَتَلَ نَشّ، «ﭑ بَرَ ﭑ كَلِ ﭑ يّتّ رَ، ﭑ مُ وَ مَ مِشِ كٌبِ شَ قَشَ، ﭑ وَ مَ نّ عَ شَ فبِلٍن عَ شَ كِرَ كٌبِ نَن قْشْ رَ، عَ شَ كِسِ. يَندِ، وٌ شَ فبِلٍن وٌ شَ كِرَ كٌبِيٍ قْشْ رَ. عِسِرَيِلَ بْنسْي، وٌ بُمَ قَشّ كِرَ شْن مَ مُنقٍ رَ؟»›»<verse eid="EZK 33:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 33:12"/>«عَدَ مَدِ، عَ قَلَ عِ نفَشَكٍرٍنيِيٍ بّ، ‹تِنشِنتْي شَ تِنشِنيِ مُ عَ رَكِسِمَ عَ نَ مُرُتَ لْشْي نَشّ. مِشِ تِنشِنتَرٍ شَ تِنشِنتَرٍيَ مُ عَ رَلْيمَ عَ نَ فبِلٍن عَ شَ كِرَ كٌبِ قْشْ رَ لْشْي نَشّ. تِنشِنتْي مُ عَ يّتّ رَكِسِمَ عَ شَ تِنشِنيِ دَنفِشِ سَابُي رَ، شَ عَ بِرَ قٍ كٌبِ قْشْ رَ. <verse eid="EZK 33:12"/><verse number="13" style="v" sid="EZK 33:13"/>ﭑ نَ عَ مَسٍن تِنشِنتْي ندٍ بّ عَ كِسِمَ نّ، كْنْ عَ قَ لَ عَ شَ تِنشِنيِ دَنفِشِ رَ، عَ سٌ قٍ كٌبِ رَبَقٍ، عَ شَ تِنشِنيِ لُمَ نّ عَ مَ قُ. يَكْسِ عَ قَشَمَ نّ عَ شَ قٍ كٌبِ شَ قٍ رَ. <verse eid="EZK 33:13"/><verse number="14" style="v" sid="EZK 33:14"/>ﭑ نَ عَ مَسٍن مِشِ كٌبِ ندٍ بّ عَ مُ كِسِمَ، كْنْ عَ قَ فبِلٍن عَ شَ يُنُبِ قْشْ رَ، عَ سٌ قٍ تِنشِنشِيٍ رَبَقٍ، <verse eid="EZK 33:14"/><verse number="15" style="v" sid="EZK 33:15"/>عَلْ سّيكّ رَفبِلٍنقٍ دٌنِمَ مَ، سٍ مُحَشِ رَفبِلٍنقٍ عَ كَنيِ مَ، حّرّقٍ سّرِيّ كُي، فبِلٍنقٍ قٍ كٌبِ قْشْ رَ، نَ تّمُي عَ كِسِمَ نّ، عَ مُ قَشَمَ. <verse eid="EZK 33:15"/><verse number="16" style="v" sid="EZK 33:16"/>عَ يُنُبِ نَشَن بِرِن نَبَ تّمُي دَنفِشِ، نَ بِرِن شَقَرِ مَ نّ. شَ عَ بَرَ حّرّ سّرِيّ نُن تِنشِنيِ رَ، عَ كِسِمَ نّ.›»<verse eid="EZK 33:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 33:17"/>«عِ نفَشَكٍرٍنيِيٍ عَ قَلَمَ، ‹مَرِفِ مُ تِنشِن.› كْنْ ﭑ شَ عَ قَلَ عِ بّ، عٍ تَن نَن مُ تِنشِن. <verse eid="EZK 33:17"/><verse number="18" style="v" sid="EZK 33:18"/>شَ تِنشِنتْي عَ كٌبٍ سٌ عَ شَ تِنشِنيِ رَ، عَ سٌ تِنشِنتَرٍيَ رَبَقٍ، عَ قَشَمَ نّ. <verse eid="EZK 33:18"/><verse number="19" style="v" sid="EZK 33:19"/>شَ مِشِ تِنشِنتَرٍ فبِلٍن عَ شَ قٍ كٌبِيٍ قْشْ رَ، عَ سٌ قٍ تِنشِنشِيٍ رَبَقٍ، عَ كِسِمَ نّ نَ سَابُي رَ. <verse eid="EZK 33:19"/><verse number="20" style="v" sid="EZK 33:20"/>ﭑ شَ عَ قَلَ عٍ بّ، ‹عِسِرَيِلَ بْنسْي نَشّ ﭑ مُ تِنشِن، كْنْ ﭑ قَمَ نّ وٌ تَن مَكِيتِدٍ، كَنكَن شَ عَ حّرّ كِ سَرٍ قِ.›»<verse eid="EZK 33:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 33:21"/>عَ حّ قُ نُن قِرِن ندٍ رَ، كِكٍ قُ، شِ قُ نُن سُولِ ندٍ رَ مُشُ شَ كٌنيِيَ كُي، مِشِ ندٍ كٍلِقٍ فٍرٍ يِرٍ، عَ نَشَ قَ، عَ قَلَ ﭑ بّ، عَ عٍ بَرَ دَرِ سَلَمُ سُشُ. <verse eid="EZK 33:21"/><verse number="22" style="v" sid="EZK 33:22"/>نَ كْي رَ بٍينُن نَ مِشِ شَ قَ، عَلَتَلَ نُ بَرَ عَ بّلّشّ سَ ﭑ دّ مَ، عَ ﭑ نّنيِ رَقُلُن عَلَكٌ ﭑ شَ نْ وْيّندٍ، ﭑ نَشَ لُ بٌبٌيَ كُي سْنْن.<verse eid="EZK 33:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 33:23"/>نَ تّمُي عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، عَ نَشّ، <verse eid="EZK 33:23"/><verse number="24" style="v" sid="EZK 33:24"/>«عَدَ مَدِ، حَمَ دْنشْي نَشٍيٍ سَبَتِشِ دَرِ سَلَمُ كَنَشِ تَفِ، نٍيٍ نَ عَ قَلَقٍ، ‹عِبُرَهِمَ نَشَ نْ يِ بْشِ سْتْدٍ عَ كٍرٍن. وٌن تَن نَشَن قِندِشِ حَمَ رَ، عَلَ تٌندِ مَ يِ بْشِ قِدٍ وٌن مَ؟› <verse eid="EZK 33:24"/><verse number="25" style="v" sid="EZK 33:25"/>نَ كُي عَ لَنمَ عِ شَ عَ قَلَ عٍ بّ، ‹وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛ وٌ تٌ سُبٍ دٌنمَ وُلِ نَ عَ كُي، وٌ تٌ كُيٍ بَتُمَ، وٌ تٌ قَشّ تِمَ، عَ لَنمَ يِ بْشِ شَ قِندِ وٌ فبٍ رَ؟ <verse eid="EZK 33:25"/><verse number="26" style="v" sid="EZK 33:26"/>وٌ لَشِ وٌ شَ سَنتِدّفّمَ فبَنسَن نَن نَ، وٌ قٍ حَاشِيٍ رَبَمَ تّمُي بِرِن، وٌ يّنّ رَبَمَ وٌ دْشْبٌورٍ شَ فِنّ رَ. هَلِ وٌ تٌ نَ بِرِن نَبَمَ، وٌ وَ مَ نّ يِ بْشِ مَن شَ قِندِ وٌ فبٍ رَ؟›»<verse eid="EZK 33:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EZK 33:27"/>«عَ قَلَ عٍ بّ، ‹وٌ مَرِفِ عَلَ يِ نَن مَسٍنشِ؛ ﭑ بَرَ ﭑ كَلِ ﭑ يّتّ رَ، نَشٍيٍ لُشِ دَرِ سَلَمُ كَنَشِ تَفِ، نٍيٍ قَشَمَ نّ سَنتِدّفّمَ رَ. مِشِ نَشٍيٍ لُشِ وُلَءِ، بُرُنيِ سُبٍيٍ نٍيٍ قَشَمَ نّ. مِشِ نَشٍيٍ عٍ نْشُنشِ فٍيَ قَرِ فّمّيٍ لٌنفٌرِ رَ، نٍيٍ قَشَمَ نّ وُفَنيِ رَ. <verse eid="EZK 33:27"/><verse number="28" style="v" sid="EZK 33:28"/>ﭑ نَ بْشِ قِندِ مَ نّ يِرٍ مَشَرَشِ رَ، ﭑ يّتّ عِفبٌي شَ قٍ شُن نَكَنَ، ﭑ عَ نِيَمَ نّ سِ فبّتّ مِشِيٍ مُ دَنفِ عِسِرَيِلَ فٍيَيٍ رَ. <verse eid="EZK 33:28"/><verse number="29" style="v" sid="EZK 33:29"/>ﭑ نَ نَ بْشِ كَنَ عٍ شَ قٍ حَاشِيٍ شَ قٍ رَ، عٍ عَ كٌلٌنمَ نّ عَ ﭑ تَن نَن عَلَتَلَ رَ.›»<verse eid="EZK 33:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 33:30"/>«عَدَ مَدِ، عِ تَن تٌ عَ رَ، عِ نفَشَكٍرٍنيِيٍ نَ عَ مَكْيِكْيِقٍ عٍ شْنيِ عَ قَلَقٍ رَ، ‹وٌ قَ، وٌ قَ وٌ تُلِ مَتِ. عَلَتَلَ نَ مَسٍنيِ مُندُن تِقٍ يِ كِ؟› <verse eid="EZK 33:30"/><verse number="31" style="v" sid="EZK 33:31"/>ﭑ مَ حَمَ قَمَ نّ عِ يِرٍ، عٍ عٍ تُلِ مَتِ عِ شَ مَسٍنيِ رَ، كْنْ عٍ مُ عَ رَبَتُمَ قٍوٌ. عٍ عَ قَلَمَ عٍ وَ مَ ﭑ مَ قٍ شْن، كْنْ عٍ بْحّ بِرَشِ نَاقُلِ تِنشِنتَرٍ نَن قْشْ رَ. <verse eid="EZK 33:31"/><verse number="32" style="v" sid="EZK 33:32"/>عِ لُشِ نّ عٍ بّ عَلْ سِفِسَ شُي حْشُنمّ، نَشَن قٍ قَنيِيٍ قَلَمَ. عٍ عِ شَ مَسٍنيِ مّمَ، كْنْ عٍ مُ تِنمَ بِرَدٍ عَ قْشْ رَ.»<verse eid="EZK 33:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EZK 33:33"/>«ﭑ مَ مَسٍنيِ بِرِن نَ كَمَلِ نْندِ كِ مَ تّمُي نَشّ، عٍ عَ كٌلٌنمَ نّ عَ نَمِحْنمّ ندٍ نُ نَ عٍ يَ مَ.»<verse eid="EZK 33:33"/></para>
  <chapter eid="EZK 33"/>
  <chapter number="34" style="c" sid="EZK 34"/>
  <para style="s">شُرُ سٍيٍ نُن عَ دّ مَدٌنيِ شَ تَالِ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 34:1"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، عَ نَشّ، <verse eid="EZK 34:1"/><verse number="2" style="v" sid="EZK 34:2"/>«عَدَ مَدِ، عِ شَ ﭑ مَ مَسٍنيِ تِ عِسِرَيِلَ يَرٍرَتِيٍ بّ نَشٍيٍ لُشِ عَلْ شُرُ سٍ دّ مَدٌنيِيٍ، عَ قَلَقٍ رَ، ‹وٌ مَرِفِ عَلَ يِ نَن مَسٍنشِ؛ حَشَنكَتّ نَ وٌ بّ، وٌ تَن عِسِرَيِلَ شُرُ سٍ دّ مَدٌنيِيٍ. وٌ وٌ حْشْ سَمَ وٌ يّتّ نَن تُن شْن مَ. شُرُ سٍ دّ مَدٌنيِ مُ لَنمَ شّ عَ شَ شُرُ سٍيٍ مَكَنتَ؟ <verse eid="EZK 34:2"/><verse number="3" style="v" sid="EZK 34:3"/>وٌ شُرُ سٍيٍ شِحّ مِنمَ، وٌ عٍ شَبٍ يَءِلَنمَ دُفِ رَ، وٌ عٍ سُبٍ دٌنمَ، كْنْ وٌ مُ وٌ حْشْ سَمَ عٍ شْن مَ. <verse eid="EZK 34:3"/><verse number="4" style="v" sid="EZK 34:4"/>وٌ مُ شُرُ سٍ سّنبّتَرٍ رَلِمَنِيَمَ، وٌ مُ شُرُ سٍ قُرَشِ دَندَنمَ، وٌ مُ شُرُ سٍ مَشْنْشِ مَشِرِ مَ سٍرِ رَ. وٌ مُ شُرُ سٍ لْيشِيٍ قٍنمَ، عٍ شَ فبِلٍن فْورّ كُي. وٌ عٍ يَمَرِ مَ نْي شْرْشْي نَن تُن نَ. <verse eid="EZK 34:4"/><verse number="5" style="v" sid="EZK 34:5"/>عٍ يٍنسٍنشِ، بَرِ مَ شُرُ سٍ دّ مَدٌنيِ مُ نُ نَ عٍ قْشْ رَ. نَ كُي وُلَءِ سُبٍ بَرَ ندٍيٍ عِبْو. <verse eid="EZK 34:5"/><verse number="6" style="v" sid="EZK 34:6"/>ﭑ مَ شُرُ سٍ فَلِ بَرَ يٍنسٍن يّ فٍيَ عِتٍشِيٍ مَ، عٍ لْي دُنِحَ بِرِن مَ، كْنْ مِشِ يٌ مُ مِنِ عٍ قٍندٍ.›»<verse eid="EZK 34:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 34:7"/>«شُرُ سٍ دّ مَدٌنيِيٍ، وٌ وٌ تُلِ مَتِ عَلَتَلَ شَ مَسٍنيِ رَ؛ <verse eid="EZK 34:7"/><verse number="8" style="v" sid="EZK 34:8"/>ﭑ تَن وٌ مَرِفِ عَلَتَلَ، ﭑ بَرَ ﭑ كَلِ ﭑ يّتّ رَ، وٌ تٌ ﭑ مَ شُرُ سٍيٍ رَبّحِن، عٍ قِندِ وُلَءِ سُبٍيٍ شَ بَلٌي رَ، وٌ تٌ مُ وٌ حْشْ سَشِ عٍ شْن مَ، وٌ مّينِ وٌ يّتّ فبَنسَن مَ، <verse eid="EZK 34:8"/><verse number="9" style="v" sid="EZK 34:9"/>وٌ تَن شُرُ سٍ دّ مَدٌنيِيٍ شَ وٌ تُلِ مَتِ عَلَتَلَ شَ كِيتِ رَ. <verse eid="EZK 34:9"/><verse number="10" style="v" sid="EZK 34:10"/>وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛ ﭑ قَقٍ نَ شُرُ سٍ دّ مَدٌنيِيٍ نَن شِلِ مَ، عٍ شَ ﭑ سَرٍ قِ فْورّ شَ قٍ رَ. ﭑ عٍ بَمَ نّ شُرُ سٍ دّ مَدٌنيِ وَلِ كُي، عَلَكٌ عٍ نَشَ نَ رَبَ عٍ يّتّ شَ فٍينِ فبَنسَن مَ. ﭑ نَ ﭑ مَ شُرُ سٍيٍ رَتَنفَمَ نّ عٍ مَ، عَلَكٌ عٍ نَشَ ﭑ مَ شُرُ سٍيٍ تْورْ.»<verse eid="EZK 34:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 34:11"/>«وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛ ﭑ تَن يَتِ سِفَمَ نّ ﭑ مَ شُرُ سٍيٍ قٍندٍ، <verse eid="EZK 34:11"/><verse number="12" style="v" sid="EZK 34:12"/>عَلْ شُرُ سٍ دّ مَدٌنيِ عَ رَبَمَ عَ شَ شُرُ سٍ رَيٍنسٍنشِيٍ بّ كِ نَشّ. ﭑ عٍ رَفبِلٍنمَ نّ يِرٍ بِرِن عٍ لْيشِ دّننَشّ نَ لْشْي. <verse eid="EZK 34:12"/><verse number="13" style="v" sid="EZK 34:13"/>ﭑ عٍ رَ مِنِمَ نّ حَمَنّيٍ بِرِن لٌنفٌرِ رَ، ﭑ عٍ شَنِن عٍ شْنيِ. ﭑ مّينِمَ نّ عٍ مَ عٍ شَ فٍيَيٍ قَرِ نُن عٍ شَ فُلُنبَيٍ كُي، عٍ شَ لُ عٍ يّتّ شَ بْشِ مَ. <verse eid="EZK 34:13"/><verse number="14" style="v" sid="EZK 34:14"/>ﭑ عٍ دّ مَدٌنمَ نّ قِيلِ قَنيِيٍ مَ عِسِرَيِلَ فٍيَيٍ قَرِ. مّننِ عٍ عٍ مَلَبُمَ نّ يِرٍ قَنيِ مَ، عٍ بَلٌ عِسِرَيِلَ فٍيَيٍ قَرِ. <verse eid="EZK 34:14"/><verse number="15" style="v" sid="EZK 34:15"/>ﭑ تَن نَن يَتِ ﭑ مَ شُرُ سٍيٍ دّ مَدٌنمَ، ﭑ مَلَبُي قِمَ عٍ مَ. وٌ مَرِفِ عَلَتَلَ شُي نَن نَن كِ. <verse eid="EZK 34:15"/><verse number="16" style="v" sid="EZK 34:16"/>ﭑ شُرُ سٍ لْيشِ قٍنمَ نّ، ﭑ شُرُ سٍ مَشْنْشِ دَندَنمَ نّ، ﭑ شُرُ سٍ سّنبّتَرٍ رَلِمَنِيَمَ نّ. كْنْ شُرُ سٍ نَشٍيٍ بَرَ شُنفبٌ، نَشٍيٍ بَرَ نْ بٌورٍيٍ رَ، ﭑ نٍيٍ تَن قَشَمَ نّ كِيتِ تِنشِنشِ رَ.»<verse eid="EZK 34:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 34:17"/>«وٌ تَن ﭑ مَ شُرُ سٍيٍ، وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛ ﭑ كِيتِ سَمَ نّ شُرُ سٍيٍ تَفِ، يّشّي كٌنتٌنيِيٍ نُن سِكْتّيٍ تَفِ. <verse eid="EZK 34:17"/><verse number="18" style="v" sid="EZK 34:18"/>وٌ نَ سّشّ قَنيِ دٌن قِيلِ مَ، نَ مُ وٌ وَ سَمَ، قٌ وٌ شَ عَ دْنشْي قَن عِبٌرٌن؟ وٌ نَ يٍ تِنسٍشِ مِن، نَ مُ وٌ وَ سَمَ، قٌ وٌ شَ عَ دْنشْي دُندَ؟ <verse eid="EZK 34:18"/><verse number="19" style="v" sid="EZK 34:19"/>عَ لَنمَ ﭑ مَ شُرُ سٍيٍ شَ سّشّ دٌن وٌ نَشَن عِبٌرٌنشِ؟ عَ لَنمَ عٍ شَ يٍ مِن، وٌ نَشَن دُندَشِ؟»<verse eid="EZK 34:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 34:20"/>«نَ كُي وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ نٍيٍ شَ قٍ رَ؛ ﭑ يّتّ يَتِ نَن قَمَ كِيتِ سَدٍ شُرُ سٍ شُنفبٍيٍ نُن عَ لَنمَيٍ تَفِ. <verse eid="EZK 34:20"/><verse number="21" style="v" sid="EZK 34:21"/>وٌ بَرَ دِن ﭑ مَ شُرُ سٍ سّنبّتَرٍيٍ رَ وٌ قٍرِيٍ رَ، هَن عٍ بَرَ مِنِ فْورّ كُي. <verse eid="EZK 34:21"/><verse number="22" style="v" sid="EZK 34:22"/>ﭑ قَمَ نّ ﭑ مَ شُرُ سٍيٍ رَكِسِدٍ، عَلَكٌ مِشِ نَشَ قُ عٍ مَ سْنْن. ﭑ كِيتِ سَمَ نّ شُرُ سٍيٍ تَفِ. <verse eid="EZK 34:22"/><verse number="23" style="v" sid="EZK 34:23"/>ﭑ شُرُ سٍ دّ مَدٌنيِ ندٍ تِمَ نّ ﭑ مَ شُرُ سٍيٍ شُن مَ، نَشَن قَمَ عٍ دّ مَدٌندٍ عَ كِ مَ. ﭑ مَ كٌنيِ دَوُدَ نَن نَ كِ. <verse eid="EZK 34:23"/><verse number="24" style="v" sid="EZK 34:24"/>ﭑ تَن قِندِ مَ نّ عٍ مَرِفِ عَلَ رَ، ﭑ مَ كٌنيِ دَوُدَ قِندِ مَنفّ رَ عٍ تَفِ. ﭑ تَن عَلَتَلَ شُي نَن نَ كِ.»<verse eid="EZK 34:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 34:25"/>«ﭑ بْحّسَ سَاتّ تٌنفٌمَ نّ عٍ بّ. ﭑ وُلَءِ سُبٍ شَاحّيٍ حْنمَ نّ بْشِ مَ، عَلَكٌ مِشِ شَ نْ سَبَتِدٍ يِرٍ بِرِن بْحّسَ كُي. <verse eid="EZK 34:25"/><verse number="26" style="v" sid="EZK 34:26"/>ﭑ بَرَكَ رَفٌرٌ مَ نّ عٍ مَ. ﭑ تُنّ رَقَمَ نّ عَ وَشَتِ، عَلَكٌ بْشِ شَ قَن ﭑ مَ فٍيَ سّنِيّنشِ رَبِلِنيِ. <verse eid="EZK 34:26"/><verse number="27" style="v" sid="EZK 34:27"/>وُرِيٍ بٌفِمَ نّ، بْشِ شّيٍ قَن. ﭑ مَ حَمَ سَبَتِمَ نّ بْحّسَ كُي عَ شَ بْشِ مَ. نَ تّمُي، عٍ عَ كٌلٌنمَ نّ عَ ﭑ تَن نَن نَ عَلَتَلَ رَ، عَ ﭑ تَن نَن يْلْنشْنيِيٍ بٌلٌنمَ، ﭑ عٍ رَتَنفَ عٍ يَشُييٍ مَ. <verse eid="EZK 34:27"/><verse number="28" style="v" sid="EZK 34:28"/>حَمَنّيٍ مُ عٍ تْورْ مَ سْنْن، سُبٍ شَاحّيٍ قَن مُ عٍ دٌنمَ سْنْن. عٍ سَبَتِمَ شَشِلِسَ نَن كُي، مِشِ يٌ مُ عٍ مَفَاشُمَ. <verse eid="EZK 34:28"/><verse number="29" style="v" sid="EZK 34:29"/>ﭑ عٍ شَ سَنسِ بِلِيٍ رَقَنمَ نّ حَمَنّيٍ يَ شْرِ. كَامّ مُ عٍ سُشُمَ سْنْن، عٍ شَ يَافِ عٍ شَ سٍتَرٍحَ كُي. <verse eid="EZK 34:29"/><verse number="30" style="v" sid="EZK 34:30"/>نَ تّمُي، عٍ عَ كٌلٌنمَ نّ عَ ﭑ تَن عٍ مَرِفِ عَلَتَلَ نَ عٍ قْشْ رَ، عٍ مَن عَ كٌلٌن عَ عٍ تَن عِسِرَيِلَ بْنسْي قِندِشِ ﭑ مَ حَمَ نَن نَ. وٌ مَرِفِ عَلَتَلَ شُي نَن نَ كِ. <verse eid="EZK 34:30"/><verse number="31" style="v" sid="EZK 34:31"/>وٌ تَن ﭑ مَ شُرُ سٍيٍ، ﭑ نَشٍيٍ دّ مَدٌنمَ، عَدَ مَدِ نَن وٌ رَ. ﭑ تَن نَن نَ وٌ مَرِفِ رَ. وٌ مَرِفِ عَلَتَلَ شُي نَن نَ كِ.»<verse eid="EZK 34:31"/></para>
  <chapter eid="EZK 34"/>
  <chapter number="35" style="c" sid="EZK 35"/>
  <para style="s">حَشَنكَتّ نَ عٍدٌن بّ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 35:1"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، عَ نَشّ، <verse eid="EZK 35:1"/><verse number="2" style="v" sid="EZK 35:2"/>«عَدَ مَدِ، عِ شَ ﭑ مَ مَسٍنيِ تِ ﭑ شِلِ رَ عٍدٌنكَيٍ بّ، نَشٍيٍ سَبَتِشِ سٍيِرِ فٍيَ مَ، <verse eid="EZK 35:2"/><verse number="3" style="v" sid="EZK 35:3"/>عَ قَلَ عٍ بّ، ‹وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛ ﭑ قَمَ نّ وٌ تَن عٍدٌنكَيٍ شِلِ مَ، ﭑ نَ ﭑ سّنبّ رَ مِنِ وٌ مَ، ﭑ سٍيِرِ فٍيَ قِندِ يِرٍ مَشَرَشِ رَ. <verse eid="EZK 35:3"/><verse number="4" style="v" sid="EZK 35:4"/>ﭑ وٌ شَ تَايٍ شُن نَكَنَمَ نّ، نٍيٍ شَ قِندِ يِرٍ رَبّحِنشِ رَ. نَ تّمُي، وٌ عَ كٌلٌنمَ نّ عَ ﭑ تَن نَن نَ عَلَتَلَ رَ.›»<verse eid="EZK 35:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 35:5"/>«وٌ تٌ عِسِرَيِلَكَيٍ شْن كَبِ تّمُي شْنكُيٍ، هَن وٌ بَرَ عٍ يَنقَ، وٌ عٍ سَ وٌ يَشُييٍ سَفٌي عٍ شَ حَشَنكَتّ وَشَتِ، <verse eid="EZK 35:5"/><verse number="6" style="v" sid="EZK 35:6"/>ﭑ تَن وٌ مَرِفِ عَلَتَلَ نَشّ، ‹ﭑ بَرَ ﭑ كَلِ ﭑ يّتّ رَ، ﭑ عَ نِيَمَ نّ وٌ شَ بُ فٍرٍ كُي. وٌ تٌ فبَتَ وُلِ رَ مِنِدٍ، ﭑ عَ رَفِرِ مَ نّ نَ قٍ مْولِ شَ بِرَ وٌ قْشْ رَ تّمُي بِرِن. <verse eid="EZK 35:6"/><verse number="7" style="v" sid="EZK 35:7"/>ﭑ سٍيِرِ فٍيَ قِندِ مَ نّ يِرٍ مَشَرَشِ رَ مِشِ مُ سِفَمَ دّننَشّ. <verse eid="EZK 35:7"/><verse number="8" style="v" sid="EZK 35:8"/>بِنبِيٍ لُمَ نّ وٌ شَ بْشِ بِرِن مَ، نَشٍيٍ قَشَشِ سَنتِدّفّمَ رَ وٌ شَ فٍيَيٍ قَرِ، وٌ شَ فُلُنبَيٍ كُي، نُن وٌ شَ قٌلٍيٍ لٌنفٌرِ رَ. <verse eid="EZK 35:8"/><verse number="9" style="v" sid="EZK 35:9"/>ﭑ وٌ شَ بْشِ قِندِ مَ نّ يِرٍ مَشَرَشِ رَ، مِشِ يٌ مُ سَبَتِمَ وٌ شَ تَايٍ كُي. نَ تّمُي، وٌ عَ كٌلٌنمَ نّ عَ ﭑ تَن نَن نَ عَلَتَلَ رَ.›»<verse eid="EZK 35:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 35:10"/>«وٌ تٌ عَ قَلَ يُدَيَ نُن عِسِرَيِلَ قِندِ مَ نّ وٌ فبٍ رَ، هَلِ ﭑ نُ نَ عٍ قْشْ رَ، <verse eid="EZK 35:10"/><verse number="11" style="v" sid="EZK 35:11"/>ﭑ بَرَ ﭑ كَلِ ﭑ يّتّ رَ، ﭑ تَن وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛ ‹ﭑ قَن وٌ فٍرٍ مَ نّ وٌ شَ شْنّ نُن تْونّ بّرّ مَ، نَشَن نُ نَ وٌ بْحّ كُي عٍ تَن مَبِرِ. ﭑ نَ وٌ مَكِيتِ تّمُي نَشّ، ﭑ نَ ﭑ يّتّ مَسٍنمَ نّ عٍ تَن بّ. <verse eid="EZK 35:11"/><verse number="12" style="v" sid="EZK 35:12"/>نَ كُي، وٌ عَ كٌلٌنمَ نّ عَ ﭑ تَن عَلَتَلَ بَرَ وٌ شَ كٌنبِيٍ بِرِن مّ، وٌ نَشٍيٍ عِلَنشِ عِسِرَيِلَ شَ فٍيَيٍ رَ. وٌ نُ بَرَ عَ قَلَ، مّننِكَيٍ شُن بَرَ رَكَنَ، عَلَكٌ نَ بْشِ شَ قِندِ مُشُ فبٍ رَ. <verse eid="EZK 35:12"/><verse number="13" style="v" sid="EZK 35:13"/>وٌ شَ يّتّ عِفبٌيَ كُي، وٌ بَرَ ﭑ مَبٍرٍ ﭑ مَ يَرَفَاشُيتَرٍحَ كُي. ﭑ نَ بِرِن مّ نّ.›»<verse eid="EZK 35:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 35:14"/>«وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛ دُنِحَ بِرِن نَ لُ سّيوّ كُي، ﭑ وٌ شُن نَكَنَمَ نّ عَ حَاشِ رَ. <verse eid="EZK 35:14"/><verse number="15" style="v" sid="EZK 35:15"/>سٍيِرِ فٍيَ نُن عٍدٌنكَيٍ بِرِن، ﭑ وٌ شُن نَكَنَمَ نّ قٍوٌ. نَ تّمُي وٌ عَ كٌلٌنمَ نّ، عَ ﭑ تَن نَن نَ عَلَتَلَ رَ!»<verse eid="EZK 35:15"/></para>
  <chapter eid="EZK 35"/>
  <chapter number="36" style="c" sid="EZK 36"/>
  <para style="s">مَسٍنيِ عِسِرَيِلَ بْشِ بّ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 36:1"/>«عَدَ مَدِ، عِ شَ مَسٍنيِ تِ ﭑ شِلِ رَ عِسِرَيِلَ شَ فٍيَيٍ بّ، عِ نَشّ، ‹عِسِرَيِلَ فٍيَيٍ، وٌ وٌ تُلِ مَتِ عَلَتَلَ شَ مَسٍنيِ رَ. <verse eid="EZK 36:1"/><verse number="2" style="v" sid="EZK 36:2"/>وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ، عَ نَشّ؛ وٌ يَشُييٍ بَرَ عَ قَلَ وٌ شَ فٍيَيٍ قِندِ مَ نّ عٍ فبٍ رَ. <verse eid="EZK 36:2"/><verse number="3" style="v" sid="EZK 36:3"/>نَ كُي، عِ شَ مَسٍنيِ تِ ﭑ شِلِ رَ، عَ قَلَقٍ رَ، وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛ عٍ تٌ بَرَ وَ وٌ شُن نَكَنَقٍ، عٍ وٌ رَشّتّن عَلَكٌ وٌ شَ لُ سِ فبّتّيٍ سَفٌي نَشٍيٍ وٌ مَبٍرٍ مَ، عٍ وٌ مَقَلَ، <verse eid="EZK 36:3"/><verse number="4" style="v" sid="EZK 36:4"/>ﭑ تَن وٌ مَرِفِ عَلَتَلَ ﭑ شَ عَ مَسٍن وٌ بّ، وٌ تَن فٍيَيٍ، فُلُنبَيٍ، قٌلٍيٍ، تَا كَنَشِ نَشٍيٍ هَرِفٍ بِرِن بَرَ شَنِن سِ فبّتّيٍ سَابُي رَ، <verse eid="EZK 36:4"/><verse number="5" style="v" sid="EZK 36:5"/>ﭑ بَرَ نَتّ تٌنفٌ ﭑ مَ شْنّ كُي سِ فبّتّيٍ نُن عٍدٌن شِلِ مَ، بَرِ مَ عٍ تَن بَرَ ﭑ مَ بْشِ قِندِ عٍ فبٍ رَ سّيوّ بِرِن نَ عٍ بْحّ حَاشِ كُي، عَلَكٌ عٍ شَ عٍ شَ شُرُ سٍيٍ دّ مَدٌن نَا.›»<verse eid="EZK 36:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 36:6"/>«نَ كُي، عِ شَ مَسٍنيِ تِ ﭑ شِلِ رَ عِسِرَيِلَ بْشِ بّ. عَ قَلَ فٍيَيٍ، قٌلٍيٍ، نُن فُلُنبَيٍ بّ، عِ نَشّ، ‹وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛ ﭑ نَ مَسٍنيِ تِقٍ شْنّ نُن تْونّ نَن كُي، بَرِ مَ سِ فبّتّيٍ بَرَ يٌ وٌ مَ. <verse eid="EZK 36:6"/><verse number="7" style="v" sid="EZK 36:7"/>نَ شَ قٍ رَ، وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛ ﭑ بَرَ ﭑ كَلِ ﭑ بّلّشّ عِتٍشِ رَ، حَمَنّ نَشٍيٍ وٌ رَبِلِنشِ، عٍ شَ مَرَ سْتْييٍ فبِلٍنمَ نّ عٍ مَ.›»<verse eid="EZK 36:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 36:8"/>«وٌ تَن عِسِرَيِلَ فٍيَيٍ، وٌ قَمَ نّ وُرِ بِلِيٍ رَ مِنِدٍ، نَشٍيٍ سَلٌنيِيٍ بٌفِ قَنيِيٍ قِمَ ﭑ مَ حَمَ عِسِرَيِلَ مَ، بَرِ مَ عَ فبٍ مُ لُشِ عٍ شَ فبِلٍن عٍ شْنيِ. <verse eid="EZK 36:8"/><verse number="9" style="v" sid="EZK 36:9"/>ﭑ مّينِمَ نّ وٌ مَ. ﭑ هِننّمَ نّ وٌ شَ شّ سَقٍ مَ، <verse eid="EZK 36:9"/><verse number="10" style="v" sid="EZK 36:10"/>نُن وٌ شَ تَا تِقٍ رَ. ﭑ وٌ شَ مِشِيٍ رَوُيَمَ نّ، عِسِرَيِلَ بْنسْي شَ سَبَتِ نَا. <verse eid="EZK 36:10"/><verse number="11" style="v" sid="EZK 36:11"/>ﭑ مِشِ نُن شُرُ سٍ رَوُيَمَ نّ وٌ بّ، عٍ قِندِ دِ بَرِيٍ رَ دَنفِ عَ سِنفٍ رَ. نَ تّمُي، وٌ عَ كٌلٌنمَ نّ عَ ﭑ تَن نَن نَ عَلَتَلَ رَ. <verse eid="EZK 36:11"/><verse number="12" style="v" sid="EZK 36:12"/>ﭑ مَ حَمَ عِسِرَيِلَ عَ شَ نْي رَحّرّ مَ نّ وٌ قَرِ، وٌ قِندِ عٍ كّ رَ، وٌ مُ عٍ شَ دِيٍ بَ عٍ يِ رَ سْنْن.»<verse eid="EZK 36:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 36:13"/>«وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ، عَ نَشّ؛ ‹مِشِيٍ تٌ عَ قَلَمَ، عَ وٌ تَن عِسِرَيِلَ بْشِ مِشِيٍ دٌنمَ، وٌ عَ نِيَ عٍ شَ شَنِن كٌنيِيَ كُي، <verse eid="EZK 36:13"/><verse number="14" style="v" sid="EZK 36:14"/>ﭑ عَ نِيَمَ نّ نَ مِشِ دٌنقٍ مُ قَلَ وٌ شُن سْنْن، نٍيٍ بِرِن قَشَ. وٌ مَرِفِ عَلَتَلَ شُي نَن نَ كِ. <verse eid="EZK 36:14"/><verse number="15" style="v" sid="EZK 36:15"/>ﭑ سِ فبّتّيٍ شَ مَرَ سْتْي دَنمَ نّ وٌ مَبِرِ، عٍ مُ يٌ وٌ مَ سْنْن، وٌ مُ وٌ سَبَتِ بٌورٍ رَبِرَ سْنْن. وٌ مَرِفِ عَلَتَلَ شُي نَن نَ كِ.›»<verse eid="EZK 36:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 36:16"/>عَلَتَلَ مَن نَشَ عَ مَسٍن ﭑ بّ، عَ نَشّ، <verse eid="EZK 36:16"/><verse number="17" style="v" sid="EZK 36:17"/>«عَدَ مَدِ، عِسِرَيِلَ بْنسْي تٌ نُ سَبَتِشِ عَ شَ بْشِ مَ، عَ حّرّ كِ نَشَ عَ قِندِ سّنِيّنتَرٍ رَ ﭑ يَ عِ، عَلْ فِنّ نَشَن نَ عَ شَ كِكٍ وَلِ تٌقٍ. <verse eid="EZK 36:17"/><verse number="18" style="v" sid="EZK 36:18"/>ﭑ نَشَ ﭑ مَ شْنّ دُ سُ عٍ شُن نَ عٍ شَ قَشّ تِقٍ نُن عٍ شَ كُيٍ بَتُقٍ شَ قٍ رَ. <verse eid="EZK 36:18"/><verse number="19" style="v" sid="EZK 36:19"/>ﭑ نَشَ عٍ رَيٍنسٍن يّ حَمَنّيٍ مَ عٍ حّرّ كِ شَ قٍ رَ. <verse eid="EZK 36:19"/><verse number="20" style="v" sid="EZK 36:20"/>عٍ سِفَ دّننَشّ دُنِحَ مَ، مِشِيٍ بَرَ ﭑ شِلِ سّنِيّنشِ مَبٍرٍ عٍ شَ قٍ رَ، عَ قَلَقٍ رَ، ‹عَلَ شَ حَمَ نَن يِ كِ، نَشَن كٍلِشِ عَ شَ بْشِ مَ!› <verse eid="EZK 36:20"/><verse number="21" style="v" sid="EZK 36:21"/>ﭑ نُ وَ مَ نّ ﭑ شِلِ سّنِيّنشِ مَتَنفَقٍ، عِسِرَيِلَ بْنسْي نُ نَشَن مَبٍرٍقٍ حَمَنّيٍ تَفِ.»<verse eid="EZK 36:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 36:22"/>«نَ نَن عَ رَ، عِ شَ عَ قَلَ عِسِرَيِلَ بْنسْييٍ بّ، ‹وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛ ﭑ قَمَ نّ قٍ ندٍ رَبَدٍ، كْنْ ﭑ مُ عَ رَبَمَ وٌ تَن بّ، ﭑ عَ رَبَمَ ﭑ شِلِ سّنِيّنشِ نَن شَ قٍ رَ، وٌ بَرَ نَشَن مَبٍرٍ حَمَنّيٍ مَ. <verse eid="EZK 36:22"/><verse number="23" style="v" sid="EZK 36:23"/>ﭑ نَ ﭑ شِلِ شُنفبٍ شَ سّنِيّنيِ مَسٍنمَ نّ، وٌ نَشَن مَبٍرٍشِ. ﭑ نَ ﭑ مَ سّنِيّنيِ مَسٍنمَ وٌ سَابُي رَ عٍ يَ شْرِ، دُنِحَ حَمَنّيٍ عَ كٌلٌنمَ نّ عَ عَلَتَلَ نَن ﭑ نَ. وٌ مَرِفِ عَلَتَلَ شُي نَن نَ كِ.›»<verse eid="EZK 36:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 36:24"/>«ﭑ وٌ تٌنفٌمَ نّ حَمَنّيٍ تَفِ، ﭑ وٌ رَفبِلٍن وٌ شَ بْشِ مَ. <verse eid="EZK 36:24"/><verse number="25" style="v" sid="EZK 36:25"/>ﭑ يٍ سّنِيّنشِ كَسَنمَ نّ وٌ مَ وٌ رَ سّنِيّنقٍ رَ. ﭑ وٌ شَ سّنِيّنتَرٍحَ بِرِن بَمَ نّ وٌ مَ نَشٍيٍ قَتَنشِ وٌ شَ وَلِ كٌبِيٍ نُن وٌ شَ كُيٍ بَتُقٍ رَ. <verse eid="EZK 36:25"/><verse number="26" style="v" sid="EZK 36:26"/>ﭑ بْحّ نّينّ نُن شَشِلِ نّينّ قِمَ نّ وٌ مَ. ﭑ وٌ شَ بْحّ شْرْشْي مَسَرَ بْحّ قَنيِ رَ. <verse eid="EZK 36:26"/><verse number="27" style="v" sid="EZK 36:27"/>ﭑ نَ ﭑ شَشِلِ سَمَ نّ وٌ بْحّ مَ، ﭑ قَ عَ نِيَ وٌ شَ ﭑ مَ يَامَرِيٍ رَبَتُ، وٌ شَ بِرَ ﭑ مَ سّرِيّ قْشْ رَ. <verse eid="EZK 36:27"/><verse number="28" style="v" sid="EZK 36:28"/>وٌ سَبَتِمَ نّ بْشِ مَ، ﭑ نَشَن قِ وٌ بٍنبَيٍ مَ. وٌ قِندِ مَ نّ ﭑ مَ حَمَ رَ، ﭑ قَن قِندِ وٌ مَرِفِ عَلَ رَ. <verse eid="EZK 36:28"/><verse number="29" style="v" sid="EZK 36:29"/>ﭑ وٌ رَكِسِمَ نّ وٌ شَ سّنِيّنتَرٍحَ مَ، ﭑ بَلٌي رَوُيَمَ نّ وٌ بّ، عَلَكٌ وٌ نَشَ لُ كَامّ كُي سْنْن. <verse eid="EZK 36:29"/><verse number="30" style="v" sid="EZK 36:30"/>ﭑ وُرِ بٌفِيٍ نُن شّ سَنسِيٍ رَوُيَمَ نّ، عَلَكٌ كَامّ نَشَ وٌ رَيَرَبِ حَمَنّيٍ تَفِ سْنْن. <verse eid="EZK 36:30"/><verse number="31" style="v" sid="EZK 36:31"/>نَ تّمُي، وٌ وٌ رَتُمَ نّ وٌ حّرّ كِ حَاشِيٍ مَ، وٌ نِمِسَ وٌ شَ يُنُبِيٍ شَ قٍ رَ. <verse eid="EZK 36:31"/><verse number="32" style="v" sid="EZK 36:32"/>وٌ شَ عَ كٌلٌن عَ ﭑ مُ يِ رَبَمَ وٌ تَن شَ قٍ شَ رَ. وٌ مَرِفِ عَلَتَلَ شُي نَن نَ كِ. عِسِرَيِلَ بْنسْي، وٌ وٌ شُن سِن، وٌ شَ يَافِ وٌ شَ قٍ حَاشِ رَبَشِيٍ رَ.»<verse eid="EZK 36:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EZK 36:33"/>«وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ، عَ نَشّ؛ ﭑ نَ وٌ رَ سّنِيّن وٌ شَ يُنُبِيٍ مَ لْشْي نَشّ، ﭑ وٌ شَ تَايٍ رَقٍمَ نّ حَمَ رَ، ﭑ وٌ شَ يِرٍ كَنَشِيٍ يَءِلَن. <verse eid="EZK 36:33"/><verse number="34" style="v" sid="EZK 36:34"/>شّيٍ قَمَ نّ سَدٍ بْشِ مَ، نَشَن نُ بَرَ شَرَ دَنفِ مِشِيٍ يَ تٌدٍ رَ. <verse eid="EZK 36:34"/><verse number="35" style="v" sid="EZK 36:35"/>عٍ مَن عَ قَلَمَ نّ، ‹يِ بْشِ نَشَن نُ شَرَشِ، نَ مَن بَرَ لُ عَلْ عٍدٍن سَنسِ يِرٍ. عَ تَا كَنَشِيٍ مَن بَرَ تِ سّنبّ رَ، مِشِيٍ بَرَ سَبَتِ عٍ كُي.› <verse eid="EZK 36:35"/><verse number="36" style="v" sid="EZK 36:36"/>نَ تّمُي، حَمَنّ نَشٍيٍ لُمَ وٌ رَبِلِنيِيٍ، نٍيٍ عَ كٌلٌنمَ نّ عَ ﭑ تَن عَلَتَلَ بَرَ يِرٍ كَنَشِ يَءِلَن، ﭑ بَرَ شّيٍ سَ بْشِ مَ نَشَن نُ بَرَ شَرَ. ﭑ تَن عَلَتَلَ شُي نَن نَ كِ. ﭑ نَشَن قَلَ، ﭑ نَ نَن نَبَمَ.»<verse eid="EZK 36:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="EZK 36:37"/>«وٌ مَرِفِ عَلَ يِ نَن مَسٍنشِ، عَ نَشّ؛ ﭑ مَن عِسِرَيِلَ شَ مَشَندِ سُشُمَ نّ يِ قٍ رَبَقٍ رَ عٍ بّ. ﭑ عٍ رَوُيَمَ نّ عَلْ شُرُ سٍ فَلِ <verse eid="EZK 36:37"/><verse number="38" style="v" sid="EZK 36:38"/>نَشَن تٌمَ دَرِ سَلَمُ سَلِ لْشْييٍ. عِسِرَيِلَ تَا كَنَشِيٍ رَقٍمَ نّ مِشِ فَلِ رَ، عٍ قَ عَ كٌلٌندٍ عَ ﭑ تَن نَن نَ عَلَتَلَ رَ.»<verse eid="EZK 36:38"/></para>
  <chapter eid="EZK 36"/>
  <chapter number="37" style="c" sid="EZK 37"/>
  <para style="s">شْرِ شَرَشِيٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 37:1"/>عَلَتَلَ سّنبّ نَشَ فٌرٌ ﭑ مَ، عَ شَشِلِ سّنِيّنشِ نَشَ ﭑ تٌنفٌ، عَ سَ ﭑ تِ فُلُنبَ ندٍ تَفِ شْرِيٍ فبٍفبٍ نُ نَ دّننَشّ. <verse eid="EZK 37:1"/><verse number="2" style="v" sid="EZK 37:2"/>عَ نَشَ ﭑ نَحّرّ نَ شْرِيٍ لٌنفٌرِ رَ، عٍ بِرِن شَرَشِ فبٍن. <verse eid="EZK 37:2"/><verse number="3" style="v" sid="EZK 37:3"/>عَ نَشَ ﭑ مَشْرِن، عَ نَشّ، «عَدَ مَدِ، يِ شْرِيٍ مَن نْمَ بَلٌدٍ؟» ﭑ نَشَ عَ يَابِ، «ﭑ مَرِفِ عَلَتَلَ، عِ كٍرٍن نَن عَ كٌلٌن!»<verse eid="EZK 37:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 37:4"/>نَ تّمُي عَ نَشَ عَ مَسٍن ﭑ بّ، «عِ شَ مَسٍنيِ تِ يِ شْرِيٍ بّ ﭑ شِلِ رَ. عِ شَ عَ قَلَ عٍ بّ، ‹شْرِ شَرَشِيٍ، وٌ وٌ تُلِ مَتِ عَلَتَلَ شَ مَسٍنيِ رَ. <verse eid="EZK 37:4"/><verse number="5" style="v" sid="EZK 37:5"/>وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ وٌ تَن شْرِ شَرَشِيٍ بّ، عَ نَشّ؛ ﭑ شَ نِي قٌيٍ رَقَ وٌ مَ، وٌ مَن شَ بَلٌ. <verse eid="EZK 37:5"/><verse number="6" style="v" sid="EZK 37:6"/>ﭑ قَسّيٍ يَءِلَنمَ نّ وٌ بّ، ﭑ قَتٍ سُبٍ نُن قَتٍ كِرِ سَ وٌ مَ، ﭑ حّنفِ رَ سٌ وٌ قَتٍ عِ، وٌ قَ فبِلٍن بَلٌ رَ. نَ تّمُي، وٌ عَ كٌلٌنمَ نّ عَ ﭑ تَن نَن نَ عَلَتَلَ رَ.›»<verse eid="EZK 37:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 37:7"/>ﭑ نَشَ عَ شَ مَسٍنيِ رَدَنفِ عَلْ عَ ﭑ يَمَرِ عَ رَ كِ نَشّ. ﭑ تٌ نُ وْيّنمَ عَ نَمِحْنمّ كِ مَ، شُي ندٍ نَشَ مِنِ شْرِيٍ تَفِ، عٍ وُندُ، عٍ قَ سٌ عٍ مَسٌقٍ عٍ بٌرٍ رَ. <verse eid="EZK 37:7"/><verse number="8" style="v" sid="EZK 37:8"/>ﭑ نَشَ قَسّيٍ، سُبٍ، نُن كِرِ تٌ عٍ مَ، كْنْ نِي قٌيٍ مُ نُ رَ سٌشِ عٍ قَتٍ.<verse eid="EZK 37:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 37:9"/>نَ تّمُي عَ نَشَ عَ مَسٍن ﭑ بّ، عَ نَشّ، «عَدَ مَدِ، عِ شَ ﭑ مَ مَسٍنيِ تِ نِي قٌيٍ بّ عَ قَلَقٍ رَ، ‹عِ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛ عِ تَن نِي قٌيٍ، عِ شَ كٍلِ دُنِحَ تُنشُن نَانِيٍ رَ، عِ شَ سٌ يِ مِشِ قَشَشِيٍ قَتٍيٍ، عٍ شَ كٍلِ قَشّ مَ، عٍ شَ بَلٌ!› <verse eid="EZK 37:9"/><verse number="10" style="v" sid="EZK 37:10"/>عَوَ، ﭑ نَشَ نَ مَسٍنيِ رَدَنفِ عَلْ عَ ﭑ يَمَرِ كِ نَشّ. ﭑ تٌ نَ رَبَ، نِي قٌيٍ نَشَ سٌ عٍ قَتٍ عِ، عٍ نَشَ بَلٌ، عٍ كٍلِ، عٍ تِ عٍ سَنيِ شُن نَ. حَمَ فبٍفبٍ نَن نُ نٍيٍ رَ.»<verse eid="EZK 37:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 37:11"/>نَ تّمُي عَ نَشَ عَ مَسٍن ﭑ بّ، عَ نَشّ، «عَدَ مَدِ، يِ شْرِيٍ مِسَالِشِ عِسِرَيِلَ بْنسْي نَن نَ. عٍ نَشّ، ‹مُشُ شْرِيٍ بَرَ شَرَ، مُشُ شَشِلِ تِدٍيٍ بَرَ حْن، مُشُ بَرَ رَبٌلٌ.› <verse eid="EZK 37:11"/><verse number="12" style="v" sid="EZK 37:12"/>عِ شَ يِ مَسٍنيِ تِ عٍ بّ ﭑ شِلِ رَ، ‹وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛ ﭑ مَ حَمَ، ﭑ وٌ شَ فَبُرِيٍ رَبِمَ نّ، ﭑ وٌ رَتٍ عٍ كُي، ﭑ وٌ شَنِن عِسِرَيِلَ بْشِ مَ. <verse eid="EZK 37:12"/><verse number="13" style="v" sid="EZK 37:13"/>ﭑ نَ فّ نَ رَبَدٍ، وٌ تَن ﭑ مَ حَمَ، وٌ عَ كٌلٌنمَ نّ عَ عَلَتَلَ نَن ﭑ نَ. <verse eid="EZK 37:13"/><verse number="14" style="v" sid="EZK 37:14"/>ﭑ نَ ﭑ شَشِلِ سّنِيّنشِ رَفٌرٌ مَ نّ وٌ مَ، وٌ مَن فبِلٍن بَلٌ رَ، ﭑ وٌ رَ سَبَتِ وٌ شَ بْشِ مَ. نَ تّمُي، وٌ عَ كٌلٌنمَ نّ عَ ﭑ تَن عَلَتَلَ بَرَ وْيّن، عَ ﭑ تَن عَلَتَلَ بَرَ نَ رَكَمَلِ. عَلَتَلَ شُي نَن نَ كِ.›»<verse eid="EZK 37:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 37:15"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، عَ نَشّ، <verse eid="EZK 37:15"/><verse number="16" style="v" sid="EZK 37:16"/>«عَدَ مَدِ، عِ شَ وُرِ ندٍ تٌنفٌ، عِ عَ سّبّ عَ مَ، ‹يُدَ نُن عَ مَلَن بٌورٍ عِسِرَيِلَكَيٍ فبٍ.› عِ شَ وُرِ فبّتّ تٌنفٌ، عِ عَ سّبّ نَ تَن مَ، ‹يُسُقُ شَ دِ عٍقِرَ مِ نُن عَ مَلَن بٌورٍ عِسِرَيِلَ بْنسْي فبٍ.› <verse eid="EZK 37:16"/><verse number="17" style="v" sid="EZK 37:17"/>نَ تّمُي عِ شَ عٍ سُشُ عِ بّلّشّ رَ، عٍ شَ لُ عَلْ وُرِ كٍرٍن.»<verse eid="EZK 37:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 37:18"/>«عِ نفَشَكٍرٍنيِيٍ نَ عِ مَشْرِن نَ قَتَنقَسِقٍ رَ عٍ بّ، <verse eid="EZK 37:18"/><verse number="19" style="v" sid="EZK 37:19"/>عِ شَ عٍ يَابِ، ‹وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛ ﭑ يُسُقُ شَ وُرِ تٌنفٌمَ نّ، نَشَن نَ عٍقِرَ مِ نُن عَ مَلَن بٌورٍ عِسِرَيِلَ بْنسْييٍ يِ رَ، ﭑ شَ دْشْ يُدَ شَ وُرِ رَ، عٍ شَ قِندِ كٍرٍن نَ ﭑ بّلّشّ كُي. <verse eid="EZK 37:19"/><verse number="20" style="v" sid="EZK 37:20"/>عِ شَ نَ وُرِيٍ عِتَلَ عٍ مَبِرِ، سّبّلِ تِشِ نَشٍيٍ مَ، <verse eid="EZK 37:20"/><verse number="21" style="v" sid="EZK 37:21"/>عِ عَ قَلَ عٍ بّ، وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛ ﭑ عِسِرَيِلَكَيٍ تٌنفٌمَ نّ حَمَنّيٍ كُي، ﭑ عٍ رَفبِلٍن عٍ شَ بْشِ مَ. <verse eid="EZK 37:21"/><verse number="22" style="v" sid="EZK 37:22"/>ﭑ عٍ بِرِن قِندِ سِ كٍرٍن نَ عِسِرَيِلَ فٍيَيٍ قَرِ. مَنفّ كٍرٍن نَن عٍ بِرِن يَمَرِ مَ. عٍ مُ مّيمَ عٍ بٌرٍ رَ سْنْن قِندِقٍ سِ قِرِن نَ. <verse eid="EZK 37:22"/><verse number="23" style="v" sid="EZK 37:23"/>عٍ مُ قِندِ مَ سّنِيّنتَرٍيٍ رَ سْنْن، كُيٍ بَتُقٍ رَ نُن قٍ حَاشِ رَبَقٍ رَ. ﭑ عٍ رَتَنفَمَ نّ نَ بِرِن مَ، ﭑ عٍ رَ سّنِيّن. عٍ قِندِ مَ نّ ﭑ مَ حَمَ رَ، ﭑ قَن قِندِ عٍ مَرِفِ عَلَ رَ.›»<verse eid="EZK 37:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 37:24"/>«ﭑ مَ كٌنيِ دَوُدَ نَن قِندِ مَ عٍ شَ مَنفّ رَ، شُرُ سٍ كَنتّ كٍرٍن لُ عٍ بِرِن بّ. عٍ بِرَ مَ نّ ﭑ مَ يَامَرِيٍ قْشْ رَ، عٍ ﭑ مَ سّرِيّ رَبَتُ عَ كِ مَ. <verse eid="EZK 37:24"/><verse number="25" style="v" sid="EZK 37:25"/>عٍ سَبَتِمَ نّ بْشِ مَ، ﭑ نَشَن قِ ﭑ مَ كٌنيِ يَشُبَ مَ، وٌ بٍنبَيٍ سَبَتِ دّننَشّ. عٍ تَن، عٍ شَ دِيٍ نُن عٍ شَ مَمَدِيٍ سَبَتِمَ نّ مّننِ، ﭑ مَ كٌنيِ دَوُدَ نَن قِندِ مَ عٍ شَ مَنفّ رَ عَبَدَن. <verse eid="EZK 37:25"/><verse number="26" style="v" sid="EZK 37:26"/>ﭑ بْحّسَ سَاتّ تٌنفٌمَ نّ عٍ بّ، نَشَن مُ كَنَمَ عَبَدَن. ﭑ عٍ رَ سَبَتِمَ نّ نَا، ﭑ عٍ بْنسْي رَوُيَ. ﭑ مَ هْرْ مْلِنفِرَ لُمَ نّ عٍ تَفِ عَبَدَن. <verse eid="EZK 37:26"/><verse number="27" style="v" sid="EZK 37:27"/>عٍ قِندِ مَ نّ ﭑ مَ حَمَ رَ، ﭑ قَن قِندِ عٍ مَرِفِ عَلَ رَ، ﭑ مَ هْرْ مْلِنفِرَ قَ لُ عٍ يَ مَ. <verse eid="EZK 37:27"/><verse number="28" style="v" sid="EZK 37:28"/>ﭑ مَ هْرْ مْلِنفِرَ نَ سَبَتِ عٍ تَفِ عَبَدَن، سِ فبّتّيٍ عَ كٌلٌنمَ نّ عَ ﭑ تَن عَلَتَلَ نَن عِسِرَيِلَ رَ سّنِيّنشِ.»<verse eid="EZK 37:28"/></para>
  <chapter eid="EZK 37"/>
  <chapter number="38" style="c" sid="EZK 38"/>
  <para style="s">عَلَ شَ مَسٍنيِ مَنفّ فٌفٌ بّ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 38:1"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، عَ نَشّ، <verse eid="EZK 38:1"/><verse number="2" style="v" sid="EZK 38:2"/>«عَدَ مَدِ، عِ شَ ﭑ مَ مَسٍنيِ تِ مَفٌفٌ بْشِ مَنفّ فٌفٌ بّ، نَشَن رٌ سِ، مٍسٍكِ، نُن تُبَلِ تَايٍ يَمَرِ مَ. <verse eid="EZK 38:2"/><verse number="3" style="v" sid="EZK 38:3"/>عَ قَلَ عَ بّ، ‹مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛ رٌ سِ، تُبَلِ نُن مٍسٍكِ شَ مَنفّ فٌفٌ، ﭑ قَقٍ عِ شِلِ مَ. <verse eid="EZK 38:3"/><verse number="4" style="v" sid="EZK 38:4"/>ﭑ وُرٍ رَ سٌمَ نّ عِ بَنفَنيِيٍ كُي، ﭑ عِ رَ مِنِ، عِ تَن نُن عِ شَ سْورِ فَلِيٍ بِرِن؛ عِ شَ سٌييٍ، عٍ رَفِمَ تٌقَنيِيٍ، عِ شَ سْورِيٍ نُن عٍ شَ وُرٍ لٍقَ يَنبَشِيٍ، <verse eid="EZK 38:4"/><verse number="5" style="v" sid="EZK 38:5"/>سْورِ ثٍرِ سٍكَيٍ، سْورِ كُسِكَيٍ، سْورِ ثُتِكَيٍ، عٍ بِرِن نُن عٍ شَ وُرٍ لٍقَيٍ نُن عٍ شُن مَكَنتَ سٍيٍ، <verse eid="EZK 38:5"/><verse number="6" style="v" sid="EZK 38:6"/>فٌمٍرِ نُن عَ شَ سْورِ فَلِ، تٌفَرَ مَ نُن عَ شَ سْورِ فَلِ كٍلِقٍ كْولَ مَ.›»<verse eid="EZK 38:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 38:7"/>«عِ شَ نَ سْورِ فَلِيٍ بِرِن يَءِلَن عَ قَنيِ رَ عِ شَ يَامَرِ بُن مَ. <verse eid="EZK 38:7"/><verse number="8" style="v" sid="EZK 38:8"/>تّمُي شْنكُيٍ نَ دَنفِ، ﭑ عِ شِلِمَ نّ فٍرٍ تِقٍ رَ. عِ قَمَ نّ سِفَدٍ بْشِ ندٍ مَ نَشَن بَرَ فٍرٍ رَبَ، عٍ شَنِن كٌنيِيَ كُي حَمَنّ مَ، عٍ قَ فبِلٍن عٍ شْنيِ، عٍ سَبَتِ بْحّسَ كُي عِسِرَيِلَ فٍيَيٍ قَرِ. <verse eid="EZK 38:8"/><verse number="9" style="v" sid="EZK 38:9"/>عِ مّننِ لِمَ نّ عَلْ تُرُننَادّ، عِ تَن نُن عِ شَ سْورِ فَلِيٍ نَشٍيٍ كٍلِشِ دُنِحَ بِرِن مَ. وٌ لُمَ نّ عَلْ نُشُي عِقْورْشِ نَشَن تِمَ بْشِ شُن نَ.»<verse eid="EZK 38:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 38:10"/>«مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ، عَ نَشّ؛ نَ لْشْي، عِ نَتّ حَاشِ تٌنفٌمَ نّ. <verse eid="EZK 38:10"/><verse number="11" style="v" sid="EZK 38:11"/>عِ عَ قَلَمَ نّ، ‹ﭑ سِفَمَ نّ بْشِ شِلِ مَ، تّتّ مُ نَشَن نَبِلِنشِ. نَاكَيٍ مُ يَءِلَنشِ فٍرٍ تِقٍ رَ، عٍ بِرِن سَبَتِشِ بْحّسَ كُي. تّتّ مُ نَ عٍ شَ تَايٍ رَبِلِنيِ، نَادّ بَلَنشِيٍ مُ نَ عٍ شْنيِ. <verse eid="EZK 38:11"/><verse number="12" style="v" sid="EZK 38:12"/>ﭑ عٍ هَرِفٍ بِرِن تٌنفٌمَ نّ عٍ شَ تَا يَءِلَنشِيٍ كُي، عٍ فبِلٍنشِ دّننَشّ كٍلِقٍ حَمَنّ مَ. نَاقُلِ نُن شُرُ سٍ فبٍفبٍ نَ مّننِ بْشِ تَفِ.› <verse eid="EZK 38:12"/><verse number="13" style="v" sid="EZK 38:13"/>سٍيبَكَيٍ، دٍدَنكَيٍ، تَرَ سِسِ يُلّيٍ، نُن عٍ شَ مِشِيٍ بِرِن عِ مَشْرِنمَ نّ، ‹عِ نَ سِفَقٍ نَاقُلِ نَن تٌنفٌدٍ؟ عِ بَرَ سْورِ فَلِيٍ شِلِ وٌ شَ مُحّ بٍلٍبٍلٍ تِ، عَلْ شّيمَ، فبٍتِ، شُرُ سٍيٍ، نُن سٍ قَنيِ فبّتّيٍ؟›»<verse eid="EZK 38:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 38:14"/>«نَ نَن عَ رَ، عَدَ مَدِ، عِ شَ ﭑ مَ مَسٍنيِ تِ فٌفٌ بّ، عِ نَشّ، ‹مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛ ﭑ مَ حَمَ عِسِرَيِلَ نَ سَبَتِ شَشِلِسَ كُي لْشْي نَشّ، عِ قَمَ نَ تٌدٍ. <verse eid="EZK 38:14"/><verse number="15" style="v" sid="EZK 38:15"/>عِ كٍلِمَ نّ عِ شْنيِ كْولَ مَبِرِ، عِ تَن نُن سْورِ فَلِ وُيَشِيٍ كٍلِقٍ دُنِحَ بِرِن مَ، عٍ بِرِن تِشِ سٌييٍ قَرِ، عٍ بِرَ عِ قْشْ رَ. <verse eid="EZK 38:15"/><verse number="16" style="v" sid="EZK 38:16"/>عِ قَمَ نّ ﭑ مَ حَمَ عِسِرَيِلَ شِلِ مَ، عَلْ نُشُي عِقْورْشِ نَشَن دُ سُمَ بْشِ شُن نَ. نَ تّمُي ﭑ عِ رَقَمَ نّ ﭑ مَ بْشِ شِلِ مَ، عَلَكٌ دُنِحَ شَ ﭑ مَ سّنِيّنيِ كٌلٌن عِ سَابُي رَ.›»<verse eid="EZK 38:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 38:17"/>«مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ، عَ نَشّ؛ تّمُي دَنفِشِ ﭑ مَ كٌنيِ نَمِحْنمّ عِسِرَيِلَكَيٍ نُ بَرَ عِ شَ قٍ قَلَ، ﭑ عِ شّيمَ عٍ فٍرٍدٍ كِ نَشّ. <verse eid="EZK 38:17"/><verse number="18" style="v" sid="EZK 38:18"/>يِ نَن قَمَ رَبَدٍ نَ لْشْي؛ فٌفٌ نَ دِن عِسِرَيِلَ رَ، ﭑ مَ شْنّ تٍمَ نّ عَلْ تّ. <verse eid="EZK 38:18"/><verse number="19" style="v" sid="EZK 38:19"/>عِسِرَيِلَ بْشِ سّرّنمَ نّ ﭑ مَ شْنّ شُنفبٍ كُي. <verse eid="EZK 38:19"/><verse number="20" style="v" sid="EZK 38:20"/>يّشّيٍ، شْنِيٍ، وُلَءِ سُبٍيٍ، بُبُسٍيٍ، نُن عَدَ مَدِيٍ بِرِن، عٍ فَاشُمَ نّ ﭑ يَ رَ. فٍيَيٍ نُن تٍنتٍنيِيٍ بِرَ مَ نّ، بَنشِيٍ شَلّيٍ كَنَ. <verse eid="EZK 38:20"/><verse number="21" style="v" sid="EZK 38:21"/>ﭑ فٍرٍ يَ رَقِندِ مَ نّ فٌفٌ مَ ﭑ مَ فٍيَيٍ بِرِن قَرِ! مَرِفِ عَلَتَلَ شُي نَن نَ كِ. عَ شَ سْورِيٍ عٍ شَ سَنتِدّفّمَ رَ مِنِمَ نّ عٍ تّي كُي عٍ نفَشَكٍرٍنيِيٍ شِلِ مَ. <verse eid="EZK 38:21"/><verse number="22" style="v" sid="EZK 38:22"/>ﭑ فٌفٌ شُن نَكَنَمَ نّ وُفَنيِ نُن قَشّ تِقٍ رَ. ﭑ تُنّ شْرْشْي، بَلَبَلَنيِ، نُن تّ رَفٌرٌ مَ نّ عَ مَ، عَ نُن عَ شَ سْورِ فَلِيٍ مَ كٍلِقٍ دُنِحَ بِرِن مَ. <verse eid="EZK 38:22"/><verse number="23" style="v" sid="EZK 38:23"/>نَ كُي، ﭑ نَ ﭑ مَ مَنفّيَ نُن ﭑ مَ سّنِيّنيِ مَسٍنمَ نّ دُنِحَ سِ بِرِن بّ. نَ تّمُي، عٍ عَ كٌلٌنمَ نّ عَ عَلَتَلَ نَن ﭑ نَ.»<verse eid="EZK 38:23"/></para>
  <chapter eid="EZK 38"/>
  <chapter number="39" style="c" sid="EZK 39"/>
  <para style="s">مَنفّ فٌفٌ رَحْنيِ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 39:1"/>«عَدَ مَدِ، ﭑ مَ مَسٍنيِ شْرْشْي تِ مَنفّ فٌفٌ بّ، عَ قَلَقٍ رَ، ‹مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛ مٍسٍكِ نُن تُبَلِ مَنفّ فٌفٌ، ﭑ بَرَ تِ عِ كَنكٍ! <verse eid="EZK 39:1"/><verse number="2" style="v" sid="EZK 39:2"/>ﭑ عِ مَقِندِ مَ نّ عَلْ ﭑ وَ مَ عَ شْن كِ نَشّ. ﭑ عِ رَكٍلِمَ عِ شْنيِ كْولَ مَ، ﭑ قَ عِ رَ عِسِرَيِلَ فٍيَيٍ مَ فٍرٍ تِقٍ رَ. <verse eid="EZK 39:2"/><verse number="3" style="v" sid="EZK 39:3"/>مّننِ ﭑ عِ شَ شَلِ نُن عِ شَ شَلِ وٌلِ سٍ رَبِرَ مَ نّ. <verse eid="EZK 39:3"/><verse number="4" style="v" sid="EZK 39:4"/>عِ تَن نُن عِ شَ سْورِيٍ بِرِن قَشَمَ نّ نَ فٍيَيٍ لٌنفٌرِ. ﭑ وٌ قِندِ مَ يُبّيٍ نُن بُرُنيِ سُبٍيٍ شَ دٌنسٍ نَن نَ، <verse eid="EZK 39:4"/><verse number="5" style="v" sid="EZK 39:5"/>وٌ بِنبِيٍ قَ لُ كّنّ مَ. مَرِفِ عَلَتَلَ شُي نَن نَ كِ. <verse eid="EZK 39:5"/><verse number="6" style="v" sid="EZK 39:6"/>ﭑ تّ سٌمَ نّ مَفٌفٌ رَ، نُن يِرٍ رَشَرَشِ بَا دّ رَ. نَ تّمُي، عٍ عَ كٌلٌنمَ نّ عَ ﭑ تَن نَن نَ عَلَتَلَ رَ.›»<verse eid="EZK 39:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 39:7"/>«ﭑ نَ ﭑ شِلِ سّنِيّنشِ مَسٍنمَ نّ ﭑ مَ حَمَ عِسِرَيِلَ بّ، ﭑ مَن مُ تِنمَ سْنْن عٍ شَ ﭑ مَبٍرٍ. سِ فبّتّيٍ قَمَ نّ عَ كٌلٌندٍ، عَ ﭑ تَن عَلَتَلَ نَن نَ عِسِرَيِلَ شَ سّنِيّنتْي رَ. <verse eid="EZK 39:7"/><verse number="8" style="v" sid="EZK 39:8"/>نَ قٍ بِرِن قَمَ نّ رَبَدٍ. مَرِفِ عَلَتَلَ شُي نَن نَ كِ. لْشْي نَ عَ رَ، ﭑ نَشَن شَ قٍ قَلَ.»<verse eid="EZK 39:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 39:9"/>«عِسِرَيِلَكَ نَشٍيٍ سَبَتِشِ تَايٍ كُي، عٍ مِنِمَ فٍرٍ سٌسٍيٍ مَتٌنفٌدٍ بْشِ مَ، عَلْ وُرٍ لٍقَيٍ، شَلِيٍ، شَلِيٍ وٌلِ سٍيٍ، تَنبّيٍ، نُن وُرِ قَشّتِ سٍيٍ، عٍ قَ عٍ فَن يٍفٍ قَرِ. نَ عٍ هَيِ قَنمَ حّ سٌلٌقٍرٍ نَن بُن مَ. <verse eid="EZK 39:9"/><verse number="10" style="v" sid="EZK 39:10"/>عٍ مُ يٍفٍ قٍنمَ قِيلِ نُن قْتْنيِ مَ سْنْن، بَرِ مَ فٍرٍ سٌسٍيٍ نَن قِندِ مَ يٍفٍ رَ عٍ بّ. نَشٍيٍ بَرَ وَ هَرِفٍ بَقٍ عٍ يِ رَ، عٍ تَن نَن قَمَ هَرِفٍ بَدٍ نٍيٍ يِ رَ. مَرِفِ عَلَتَلَ شُي نَن نَ كِ.»<verse eid="EZK 39:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 39:11"/>«نَ لْشْي، ﭑ عَ نِيَمَ نّ فٌفٌ شَ رَفَتَ عِسِرَيِلَ بْشِ مَ، فُلُنبَ ندٍ كُي مِشِيٍ دَنفِمَ دّننَشّ سِفَقٍ رَ بَا دّ رَ سٌفٍتٍدٍ مَبِرِ. نَ فُلُنبَ كِرَ عِبٌلٌنمَ نّ فٌفٌ نُن عَ شَ سْورِيٍ رَفَتَدٍ شَ قٍ رَ. عٍ مّننِ شِلِ سَمَ نّ ‹فٌفٌ شَ حَمَ شَ فُلُنبَ.›»<verse eid="EZK 39:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 39:12"/>«عِسِرَيِلَ بْنسْي كِكٍ سٌلٌقٍرٍ نَن نَبَمَ نَ مِشِيٍ رَفَتَقٍ رَ، عَلَكٌ عٍ شَ بْشِ شَ سّنِيّن. <verse eid="EZK 39:12"/><verse number="13" style="v" sid="EZK 39:13"/>حَمَ بِرِن لُمَ نّ نَ وَلِ رَبَ رَ. ﭑ مَ نْرّ تٌ لْشْي قِندِ مَ قٍ بٍلٍبٍلٍ نَن نَ عٍ بّ. وٌ مَرِفِ عَلَتَلَ شُي نَن نَ كِ. <verse eid="EZK 39:13"/><verse number="14" style="v" sid="EZK 39:14"/>عٍ مِشِيٍ سُفَندِ مَ نّ بْشِ رَ سّنِيّندٍ. نٍيٍ تَن نُن عٍ بٌورٍيٍ لُمَ نّ بْشِ بِرِن عِحّرّ رَ بِنبِيٍ رَفَتَقٍ رَ. نَ وَلِ بُمَ نّ حّ سٌلٌقٍرٍ. <verse eid="EZK 39:14"/><verse number="15" style="v" sid="EZK 39:15"/>عٍ نَ فّ نَ رَ، عٍ مَن بْشِ عِحّرّ مَ نّ مِشِ شْرِيٍ قٍندٍ. عٍ نَ ندٍ تٌ، عٍ تْنشُمَ ندٍ تِ نَا عَلَكٌ فَبُرِ فٍمَيٍ شَ عَ تٌ، عٍ شَ نَ شْرِيٍ شَنِن فٌفٌ شَ حَمَ شَ فُلُنبَ يِرٍ. <verse eid="EZK 39:15"/><verse number="16" style="v" sid="EZK 39:16"/>عٍ بْشِ رَ سّنِيّنمَ نَ كِ نّ. تَا ندٍ تِمَ نَا، نَشَن شِلِمَ هَمٌنَ. شِلِ نَن نَ كِ نَشَن عَ قَلَمَ ‹حَمَ› عٍ فبٍ شُي رَ.»<verse eid="EZK 39:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 39:17"/>«عَدَ مَدِ، عِ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛ عَ قَلَ وُلَءِ شْنِيٍ نُن سُبٍ مْولِ بِرِن بّ، ‹وٌ بِرِن شَ قَ بٍ، ﭑ شَ ﭑ مَ سّرّشّ شُنفبٍ رَقَلَ عِسِرَيِلَ فٍيَيٍ مَ. مّننِ وٌ سُبٍ نُن وُلِ دٌنمَ نّ. <verse eid="EZK 39:17"/><verse number="18" style="v" sid="EZK 39:18"/>وٌ سّنبّمَيٍ سُبٍ دٌنمَ نّ، وٌ بْشِ مَنفّيٍ وُلِ مِن عَلْ شُرُ سٍ نَشٍيٍ رَتُرَشِ بَسَن بْشِ مَ. <verse eid="EZK 39:18"/><verse number="19" style="v" sid="EZK 39:19"/>نَ سّرّشّ تّمُي، وٌ وَ سَمَ نّ عٍ سُبٍ رَ، وٌ سِيسِ عٍ وُلِ رَ. <verse eid="EZK 39:19"/><verse number="20" style="v" sid="EZK 39:20"/>وٌ لُفَمَ نّ سٌي نُن عَ رَفِمَيٍ سُبٍ رَ، مَنفّيٍ نُن سْورِ مْولِ بِرِن سُبٍ. وٌ مَرِفِ عَلَتَلَ شُي نَن نَ كِ.›»<verse eid="EZK 39:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 39:21"/>«ﭑ نَ ﭑ مَ نْرّ مَسٍنمَ نّ دُنِحَ بِرِن بّ فٌفٌ حَمَ شَ حَشَنكَتّ سَابُي رَ. <verse eid="EZK 39:21"/><verse number="22" style="v" sid="EZK 39:22"/>كٍلِ نَ لْشْي مَ، عِسِرَيِلَ بْنسْي عَ كٌلٌنمَ نّ عَ ﭑ تَن نَن نَ عٍ مَرِفِ عَلَتَلَ رَ. <verse eid="EZK 39:22"/><verse number="23" style="v" sid="EZK 39:23"/>سِ فبّتّيٍ عَ كٌلٌنمَ نّ عَ عِسِرَيِلَ شَ يُنُبِيٍ نَن عَ نِيَ عٍ شَ سِفَ كٌنيِيَ كُي. عٍ تٌ ﭑ يَنقَ، ﭑ نَشَ ﭑ كٌبٍ رَ سٌ عٍ رَ، ﭑ قَ عٍ سَ عٍ يَشُييٍ سَفٌي. نَ نَن عَ رَ، عٍ نَشَ قَشَ سَنتِدّفّمَ رَ. <verse eid="EZK 39:23"/><verse number="24" style="v" sid="EZK 39:24"/>ﭑ عٍ حَشَنكَتَشِ عٍ شَ يُنُبِيٍ نُن عٍ شَ سّنِيّنتَرٍحَ نَن مَ. نَ نَن عَ نِيَشِ ﭑ شَ ﭑ كٌبٍ سٌ عٍ رَ.»<verse eid="EZK 39:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 39:25"/>«عَوَ، عِ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ، عَ نَشّ؛ يَكْسِ، ﭑ يَشُبَ بْنسْي رَفبِلٍنمَ نّ كٍلِقٍ كٌنيِيَ كُي. ﭑ كِنِكِنِمَ نّ عِسِرَيِلَ بْنسْييٍ مَ، ﭑ قَ عَ رَفِرِ ﭑ شِلِ شَ بِنيَ. <verse eid="EZK 39:25"/><verse number="26" style="v" sid="EZK 39:26"/>عٍ نَ سَبَتِ عٍ شْنيِ شَشِلِسَ كُي، مِشِ يٌ مُ عٍ تْورْ، يَافِ مَن لُمَ نّ عٍ مَ عٍ شَ يَنقَنتٍيَ شَ قٍ رَ ﭑ تَن مَبِرِ. <verse eid="EZK 39:26"/><verse number="27" style="v" sid="EZK 39:27"/>ﭑ نَ عٍ رَ مِنِمَ نّ حَمَنّيٍ كُي، ﭑ قَ عٍ رَ عٍ شْنيِ، حَمَنّيٍ قَ ﭑ مَ سّنِيّنيِ تٌدٍ نَ سَابُي رَ. <verse eid="EZK 39:27"/><verse number="28" style="v" sid="EZK 39:28"/>نَ تّمُي، عِسِرَيِلَ بْنسْي عَ كٌلٌنمَ نّ عَ ﭑ تَن نَن نَ عٍ مَرِفِ عَلَتَلَ رَ، بَرِ مَ هَلِ ﭑ تٌ عٍ رَ سِفَ كٌنيِيَ كُي حَمَنّيٍ تَفِ، ﭑ مَن بَرَ عٍ بِرِن نَفبِلٍن، مِشِ يٌ مُ لُ عٍ شَنبِ رَ. <verse eid="EZK 39:28"/><verse number="29" style="v" sid="EZK 39:29"/>ﭑ مُ ﭑ كٌبٍ سٌمَ عٍ رَ سْنْن، بَرِ مَ ﭑ نَ ﭑ شَشِلِ لُمَ نّ عِسِرَيِلَ بْنسْي مَ. عِ مَرِفِ عَلَتَلَ شُي نَن نَ كِ.»<verse eid="EZK 39:29"/></para>
  <chapter eid="EZK 39"/>
  <chapter number="40" style="c" sid="EZK 40"/>
  <para style="s">هْرْ مْبَنشِ نّينّ شَ تّتّيٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 40:1"/>مُشُ شَ كٌنيِيَ حّ مْشْحّن نُن سُولِ ندٍ رَ، حّ كِكٍ سِنفٍ رَ، شِ قُ ندٍ رَ، نَشَن نُ عِلَنشِ دَرِ سَلَمُ شَ كَنّ دَنفِ شَنبِ حّ قُ نُن نَانِ ندٍ مَ، نَ لْشْي يَتِ يَتِ، عَلَتَلَ سّنبّ نَشَ فٌرٌ ﭑ مَ، <verse eid="EZK 40:1"/><verse number="2" style="v" sid="EZK 40:2"/>عَ ﭑ شَنِن لَامَتُنيِ كِ مَ عِسِرَيِلَ فٍيَ عِتٍشِ ندٍ قَرِ. ﭑ نَشَ تَا ندٍ تٌ كْولَ مَبِرِ. <verse eid="EZK 40:2"/><verse number="3" style="v" sid="EZK 40:3"/>عَلَتَلَ تٌ ﭑ شَنِن نَا، ﭑ نَشَ شّمّ ندٍ تٌ، نَشَن قَتٍ نُ يَنبَقٍ عَلْ وُرٍ فبٍيلِ. عَ نُ تِشِ سٌدٍ دّ رَ، لُوتِ نُن مَنِيَ سٍ وُرِ سُشُشِ عَ يِ رَ. <verse eid="EZK 40:3"/><verse number="4" style="v" sid="EZK 40:4"/>نَ شّمّ نَشَ عَ قَلَ ﭑ بّ، عَ نَشّ، «عَدَ مَدِ، عِ يَ تِ عَ قَنيِ رَ، عِ تُلِ مَتِ ﭑ شُي رَ. ﭑ قٍ نَشَن بِرِن مَسٍنمَ عِ بّ، عِ شَ عِ حْشْ سَ عَ شْن مَ، بَرِ مَ عِ رَقَشِ نّ بٍ عَلَكٌ عِ شَ نَ كٌلٌن، عِ شَ نَ بِرِن تَفِ رَبَ عِسِرَيِلَ بْنسْي بّ.»<verse eid="EZK 40:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 40:5"/>ﭑ نَشَ تّتّ ندٍ تٌ نَشَن هْرْ مْبَنشِ رَبِلِنشِ. وُرِ مَنِيَ سٍ نُ نَ نَ شّمّ يِ رَ، نَشَن كُيَ نْنفْن يَ سٍننِ عَ نُن سُشُي سٍننِ. عَ نَشَ تّتّ شّلّ شَ مَءِفبٌي نُن عَ شَ مَءِتٍ مَنِيَ، عٍ قِرِنيِ بِرِن لَن نَ وُرِ مَنِيَسٍ يَ كٍرٍن نَن مَ.<verse eid="EZK 40:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 40:6"/>عَ نَشَ سِفَ سٌدٍ دّ رَ، نَشَن يَ رَقِندِشِ سٌفٍتٍدٍ مَ. عَ نَشَ تٍ نَ تٍدٍ رَ نَشٍيٍ نُ نَ عَ يَ رَ، عَ سٌدٍ دّ شَ مَءِتٍ مَنِيَ، نَشَن لَن نَ وُرِ مَنِيَسٍ يَ كٍرٍن مَ. <verse eid="EZK 40:6"/><verse number="7" style="v" sid="EZK 40:7"/>هْرْ مْلِنفِرَ كَنتَمَيٍ شَ تٍدٍ نُ نَ سٌدٍ دّ سّيتِ مَ، كَنكَن شَ مَءِتٍ نُن مَءِفبٌي لَن نَ وُرِ مَنِيَسٍ يَ كٍرٍن نَن مَ. شّلّ نَشَن نُ نَ عٍ تَفِ، نَ لَن نْنفْن يَ سُولِ نَن مَ. بُنتُنيِ سٌدٍ دّ شَ مَءِتٍ قَن لَن نَ وُرِ مَنِيَسٍ يَ كٍرٍن نَن مَ، نَشَن يَ نُ رَقِندِشِ هْرْ مْبَنشِ مَ.<verse eid="EZK 40:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 40:8"/>عَ نَشَ بُنتُنيِ مَنِيَ، <verse eid="EZK 40:8"/><verse number="9" style="v" sid="EZK 40:9"/>نَشَن شَ كُيّ لَن نْنفْن يَ سٌلٌمَسَشَن مَ، عَ كِنكِيٍ لَن نْنفْن يَ قِرِن مَ. نَ بُنتُنيِ يَ نُ رَقِندِشِ هْرْ مْبَنشِ نَن مَ تّتّ كُي.<verse eid="EZK 40:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 40:10"/>هْرْ مْبَنشِ كَنتَمَيٍ تِدٍ سٍننِ نُ نَ سٌفٍتٍدٍ سٌدٍ دّ سّيتِيٍ مَ، سّيتِ كٍرٍن سَشَن، سّيتِ بٌورٍ قَن سَشَن. نٍيٍ بِرِن شَ مَنِيّ شَسَبِ لَن، عٍ كِنكِيٍ قَن بِرِن شَ مَنِيّ شَسَبِ لَن. <verse eid="EZK 40:10"/><verse number="11" style="v" sid="EZK 40:11"/>عَ نَشَ سٌدٍ دّ شَ مَءِفبٌي مَنِيَ، نَشَن لَن نْنفْن قُ مَ، عَ شَ مَءِتٍ لَن نْنفْن قُ نُن سَشَن نَن مَ. <verse eid="EZK 40:11"/><verse number="12" style="v" sid="EZK 40:12"/>شّلّ دِ نُ نَ هْرْ مْبَنشِ كَنتَمَيٍ شَ تِدٍيٍ يَ رَ، نَشَن نُ عِتٍ نْنفْن يَ كٍرٍن. نَ تِدٍيٍ شَ مَءِفبٌي نُن عٍ شَ مَءِتٍ لَن نْنفْن يَ سٍننِ نَن مَ. <verse eid="EZK 40:12"/><verse number="13" style="v" sid="EZK 40:13"/>عَ نَشَ عَ مَنِيَ كٍلِقٍ كَنتَمَ سِنفٍ شَ تِدٍ شَنبِ رَ، هَن بٌورٍ كَنتَمَ شَ تِدٍ شَنبِ رَ، نَ قَ لَن نْنفْن يَ مْشْحّن نُن سُولِ مَ، كٍلِقٍ يِرٍ قَنيِ مَ، هَن كْولَ مَ. <verse eid="EZK 40:13"/><verse number="14" style="v" sid="EZK 40:14"/>عَ نَشَ شّلّ بِرِن مَنِيَ نَ سٌدٍ دّ لٌنفٌرِ هَن تّتّ كُي، نَ لَن نْنفْن يَ تٌنفٌ سٍننِ نَن مَ. <verse eid="EZK 40:14"/><verse number="15" style="v" sid="EZK 40:15"/>كٍلِقٍ سٌدٍ دّ رَ، هَن تّتّ كُي بُنتُنيِ شَنبِ رَ، نَ لَن نْنفْن يَ تٌنفٌ سُولِ نَن مَ. <verse eid="EZK 40:15"/><verse number="16" style="v" sid="EZK 40:16"/>وُندّرِيٍ نُ نَ نَ شَلّيٍ مَ سٌدٍ دّ مَبِرِ، عَلْ وُندّرِ فبّتّيٍ تٌ نُ نَ شَلّيٍ مَ هْرْ مْبَنشِ مَبِرِ. تُفِ قّنسّيٍ نُ مَسٌلِشِ نَ لٌنفٌرِ بِرِن.<verse eid="EZK 40:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 40:17"/>عَ تٌ ﭑ نَسٌ تّتّ كُي، ﭑ نَشَ يِرٍ تٌنفٌ سَشَن تٌ نَشٍيٍ قَتُشِ تّتّ مَ. <verse eid="EZK 40:17"/><verse number="18" style="v" sid="EZK 40:18"/>بْشِ نُ يَءِلَنشِ فّمّ قَنيِيٍ نَن نَ نَشَن شَ مَءِتٍ لَن تّتّ سٌدٍ دّ مَ. <verse eid="EZK 40:18"/><verse number="19" style="v" sid="EZK 40:19"/>نَ شّمّ نَشَ عَ مَنِيَ كٍلِقٍ سٌدٍ دّ قْلّ مَ، هَن تّتّ فبّتّ سٌدٍ دّ رَ نَشَن نُ نَ نَ تّتّ سِنفٍ كُي. نَ لَن نْنفْن كّمّ نَن مَ سٌفٍتٍدٍ مَبِرِ نُن كْولَ مَبِرِ.<verse eid="EZK 40:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 40:20"/>نَ تّمُي، نَ شّمّ نَشَ تّتّ سٌدٍ دّ مَنِيَ نَشَن نُ نَ كْولَ مَبِرِ. <verse eid="EZK 40:20"/><verse number="21" style="v" sid="EZK 40:21"/>هْرْ مْبَنشِ كَنتَمَيٍ تِدٍيٍ قَن نُ نَ مّننِ عَلْ بٌورٍ سٌدٍ دّيٍ رَ. سَشَن نُ نَ سّيتِ كٍرٍن، سَشَن نُ نَ بٌورٍ سّيتِ. نَ شَ مَءِتٍ لَن نْنفْن تٌنفٌ سُولِ نَن مَ، عَ مَءِفبٌي لَن نْنفْن مْشْحّن نُن سُولِ نَن مَ. <verse eid="EZK 40:21"/><verse number="22" style="v" sid="EZK 40:22"/>عَ شَ وُندّرِيٍ، عَ شَ بُنتُنيِ، عَ شَ تُفِ قّنسّ نَشٍيٍ مَسٌلِشِ عَ مَ، نٍيٍ نُن سٌفٍتٍدٍ سٌدٍ دّ شَ مَنِيّ شَسَبِ لَن. سَنتِدٍ سٌلٌقٍرٍ نَن نُ نَ عَ بّ تٍدٍ رَ، عَ شَ بُنتُنيِ نُ نَ نٍيٍ نَن يَ عِ. <verse eid="EZK 40:22"/><verse number="23" style="v" sid="EZK 40:23"/>تّتّ قِرِن ندٍ سٌدٍ دّ نُ نَ تّتّ سِنفٍ سٌدٍ دّ نَن يَ رَ كْولَ نُن سٌفٍتٍدٍ مَبِرِ. نْنفْن يَ كّمّ نُ نَ عٍ تَفِ.<verse eid="EZK 40:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 40:24"/>نَ تّمُي، نَ شّمّ نَشَ ﭑ شَنِن تّتّ سٌدٍ دّ يِرٍقَنيِ مَبِرِ. مّننِ شَ مَنِيّ شَسَبِ لَن بٌورٍ سٌدٍ دّيٍ شَ مَنِيّ نَن مَ. <verse eid="EZK 40:24"/><verse number="25" style="v" sid="EZK 40:25"/>وُندّرِيٍ نُ نَ نَ سٌدٍ دّ نُن عَ شَ بُنتُنيِ بّ عٍ رَبِلِنيِ بِرِن مَ، عَلْ بٌورٍ سٌدٍ دّيٍ. نَ سٌدٍ دّ نُ عِتٍ نْنفْن يَ تٌنفٌ سُولِ، عَ نُ عِفبٌ نْنفْن يَ مْشْحّن نُن سُولِ. <verse eid="EZK 40:25"/><verse number="26" style="v" sid="EZK 40:26"/>سَنتِدٍ سٌلٌقٍرٍ نَن نُ نَ عَ بّ تٍدٍ رَ، عَ شَ بُنتُنيِ نُ نَ نٍيٍ نَن يَ عِ. تُفِ قّنسّيٍ نُ مَسٌلِشِ عَ كِنكِيٍ سّيتِ بِرِن مَ. <verse eid="EZK 40:26"/><verse number="27" style="v" sid="EZK 40:27"/>تّتّ قِرِن ندٍ سٌدٍ دّ قَن نُ نَ يِرٍقَنيِ مَبِرِ. كٍلِقٍ نَ سٌدٍ دّ مَ هَن نَ تّتّ سِنفٍ سٌدٍ دّ يِرٍقَنيِ مَبِرِ، عَ لَن نْنفْن يَ كّمّ نَن مَ.<verse eid="EZK 40:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 40:28"/>نَ تّمُي، نَ شّمّ نَشَ ﭑ شَنِن نَ تّتّ قِرِن ندٍ كُي نَشَن نُ نَ بٌورٍ تّتّ كُي. عَ نَشَ ﭑ نَسٌ نَ يِرٍقَنيِ سٌدٍ دّ رَ. عَ نَشَ نَ مَنِيَ. عَ تَن نُن سٌدٍ دّ بٌورٍيٍ بِرِن نُ لَن. <verse eid="EZK 40:28"/><verse number="29" style="v" sid="EZK 40:29"/>عَ كَنتَمَيٍ تِدٍيٍ، عَ شَ كِنكِيٍ، نُن عَ شَ بُنتُنيِ شَ مَنِيّ شَسَبِ لَن بٌورٍيٍ شَسَبِ نَن مَ. وُندّرِيٍ نُ نَ نَ سٌدٍ دّ نُن عَ شَ بُنتُنيِ بِرِن نَبِلِنيِ رَ. كٍلِقٍ نَ سٌدٍ دّ قْلّ مَ، هَن تّتّ كُي لَن نْنفْن يَ تٌنفٌ سُولِ نَن مَ، عَ عِفبٌي لَن نْنفْن يَ مْشْحّن نُن سُولِ نَن مَ. <verse eid="EZK 40:29"/><verse number="30" style="v" sid="EZK 40:30"/>بُنتُنيِ نَشٍيٍ نُ نَ نَ تّتّ قِرِن ندٍ كُي، عٍ شَ مَءِفبٌي لَن نْنفْن يَ مْشْحّن نُن سُولِ نَن مَ، عٍ شَ مَءِتٍ لَن نْنفْن يَ سُولِ نَن مَ. <verse eid="EZK 40:30"/><verse number="31" style="v" sid="EZK 40:31"/>نَ بُنتُنيِ يَ نُ رَقِندِشِ تّتّ سِنفٍ نَن مَ. تُفِ قّنسّيٍ نُ مَسٌلِشِ عٍ كِنكِيٍ مَ، تٍدٍ سٌلٌمَسَشَن نَن نُ نَ عٍ بّ.<verse eid="EZK 40:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="EZK 40:32"/>نَ تّمُي، نَ شّمّ نَشَ ﭑ شَنِن يِ تّتّ قِرِن ندٍ سٌدٍ دّ رَ نَشَن نُ نَ سٌفٍتٍدٍ مَبِرِ. عَ نَشَ نَ مَنِيَ. عَ تَن نُن سٌدٍ دّ بٌورٍيٍ بِرِن نُ لَن. <verse eid="EZK 40:32"/><verse number="33" style="v" sid="EZK 40:33"/>عَ كَنتَمَيٍ تِدٍيٍ، عَ شَ كِنكِيٍ، نُن عَ شَ بُنتُنيِ شَ مَنِيّ نُ لَنشِ بٌورٍيٍ شَ مَنِيّ نَن مَ. وُندّرِيٍ نُ نَ نَ سٌدٍ دّ نُن عَ شَ بُنتُنيِ رَبِلِنيِ بِرِن مَ. عَ شَ مَءِفبٌي لَن نْنفْن يَ مْشْحّن نُن سُولِ نَن مَ، عَ شَ مَءِتٍ لَن نْنفْن يَ سُولِ نَن مَ. <verse eid="EZK 40:33"/><verse number="34" style="v" sid="EZK 40:34"/>نَ بُنتُنيِ يَ نُ رَقِندِشِ تّتّ سِنفٍ نَن مَ. تُفِ قّنسّيٍ نُ مَسٌلِشِ عٍ كِنكِيٍ مَ، تٍدٍ سٌلٌمَسَشَن نَن نُ نَ عٍ بّ.<verse eid="EZK 40:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="EZK 40:35"/>نَ تّمُي، نَ شّمّ نَشَ ﭑ شَنِن يِ تّتّ قِرِن ندٍ سٌدٍ دّ رَ، نَشَن نُ نَ كْولَ مَبِرِ. عَ نَشَ نَ مَنِيَ. عَ تَن نُن سٌدٍ دّ بٌورٍيٍ بِرِن نُ لَن. <verse eid="EZK 40:35"/><verse number="36" style="v" sid="EZK 40:36"/>عَ كَنتَمَيٍ تِدٍيٍ، عَ شَ كِنكِيٍ، نُن عَ شَ بُنتُنيِ شَ مَنِيّ نُ لَنشِ بٌورٍيٍ شَ مَنِيّ نَن مَ. وُندّرِيٍ نُ نَ نَ سٌدٍ دّ نُن عَ شَ بُنتُنيِ رَبِلِنيِ بِرِن مَ. عَ شَ مَءِفبٌي لَن نْنفْن يَ مْشْحّن نُن سُولِ نَن مَ، عَ شَ مَءِتٍ لَن نْنفْن يَ سُولِ نَن مَ. <verse eid="EZK 40:36"/><verse number="37" style="v" sid="EZK 40:37"/>نَ بُنتُنيِ يَ نُ رَقِندِشِ تّتّ سِنفٍ نَن مَ. تُفِ قّنسّيٍ نُ مَسٌلِشِ عٍ كِنكِيٍ مَ، تٍدٍ سٌلٌمَسَشَن نَن نُ نَ عٍ بّ.<verse eid="EZK 40:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="EZK 40:38"/>يِرٍ ندٍ نُ نَ كَنكَن شَ سٌدٍ دّ رَ، شُرُ سٍ نَشٍيٍ بَمَ سّرّشّ فَن دَاشِ رَ، نٍيٍ نُ مَشَمَ مّننِ نّ. <verse eid="EZK 40:38"/><verse number="39" style="v" sid="EZK 40:39"/>تٍيبِلِيٍ نُ نَ سٌدٍ دّ بُنتُن قِرِنيِ كُي، قِرِن نُ نَ سّيتِ كٍرٍن مَ، قِرِن نُ نَ بٌورٍ سّيتِ قَن مَ. شُرُ سٍيٍ كْن نَشَبَمَ نَ تٍيبِلِيٍ نَن قَرِ، نَشٍيٍ قِندِ سّرّشّ فَن دَاشِ رَ، يُنُبِ شَقَرِ سّرّشّ رَ. <verse eid="EZK 40:39"/><verse number="40" style="v" sid="EZK 40:40"/>تٍيبِلِ فبّتّيٍ نُ نَ سٌدٍ دّ تٍدٍ سّيتِيٍ مَ، قِرِن سّيتِ كٍرٍن، قِرِن بٌورٍ سّيتِ قَن مَ، تّتّ قَرِ مَ بُنتُنيِ كُي. <verse eid="EZK 40:40"/><verse number="41" style="v" sid="EZK 40:41"/>نَ نَن عَ رَ تٍيبِلِ نَانِ نُ نَ سٌدٍ دّ سّيتِ كٍرٍن نَ، نَانِ نُ نَ بٌورٍ سّيتِ رَ. شُرُ سٍيٍ نُ رَقَلَمَ نَ تٍيبِلِيٍ نَن قَرِ بٍينُن عٍ شَ بَ سّرّشّ رَ. <verse eid="EZK 40:41"/><verse number="42" style="v" sid="EZK 40:42"/>نَ تٍيبِلِ نَانِيٍ نُ يَءِلَنشِ فّمّيٍ نَن نَ، عٍ نُ كُيَ نْنفْن يَ كٍرٍن نُن عَ تَفِ، عٍ نُ عِفبٌ نْنفْن يَ كٍرٍن. يِرَبَسٍيٍ نُ سَمَ نٍيٍ نَن قَرِ، نَشٍيٍ نُ لَنمَ عٍ شَ رَوَلِ شُرُ سٍ رَقَلَقٍ رَ نَشٍيٍ نُ قِندِ مَ سّرّشّ فَن دَاشِيٍ نُن سّرّشّ مْولِ فبّتّيٍ رَ. <verse eid="EZK 40:42"/><verse number="43" style="v" sid="EZK 40:43"/>وُرٍيٍ نُ نَ بَنشِ شّلّ مَ شُرُ سٍيٍ نُ فبَكُمَ دّننَشّ، عٍ سُبٍ سَ تٍيبِلِيٍ قَرِ.<verse eid="EZK 40:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="EZK 40:44"/>تّتّ قِرِن ندٍ سٌدٍ دّ سّيتِ قِرِنيِيٍ مَ، يِرٍ ندٍ نُ نَ نَشَن يَ رَقِندِشِ يِرٍقَنيِ مَ، يِرٍ ندٍ قَن نُ نَ نَشَن يَ رَقِندِشِ كْولَ مَ. <verse eid="EZK 40:44"/><verse number="45" style="v" sid="EZK 40:45"/>نَ شّمّ نَشَ عَ قَلَ ﭑ بّ، عَ نَشّ؛ «يِرٍ نَشَن يَ رَقِندِشِ يِرٍقَنيِ مَ، نَ قِندِشِ سّرّشّدُبّيٍ فبٍ نَن نَ، نَشٍيٍ هْرْ مْبَنشِ مَكَنتَمَ. <verse eid="EZK 40:45"/><verse number="46" style="v" sid="EZK 40:46"/>يِرٍ نَشَن يَ رَقِندِشِ كْولَ مَ، نَ قِندِشِ سّرّشّدُبّيٍ فبٍ نَن نَ، نَشٍيٍ سّرّشّبَدٍ مَكَنتَمَ. نٍيٍ قِندِ سَدْكِ شَ دِيٍ نَن نَ، نَشٍيٍ قِندِ لٍوِ بْنسْي مِشِ رَ، نَشٍيٍ فبَنسَن لَن عٍ شَ مَكْرّ عَلَتَلَ يِرٍ رَ عٍ شَ وَلِ كُي.»<verse eid="EZK 40:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="EZK 40:47"/>نَ شّمّ نَشَ تّتّ مَنِيَ. عَ شَ كُيّ لَن نْنفْن يَ كّمّ نَن مَ، عَ شَ فبٌي قَن لَن نْنفْن يَ كّمّ نَن مَ. سّرّشّبَدٍ نُ تِشِ هْرْ مْبَنشِ نَن يَتَفِ.<verse eid="EZK 40:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="EZK 40:48"/>نَ شّمّ نَشَ ﭑ شَنِن هْرْ مْبَنشِ شَ بُنتُنيِ رَ. عَ نَشَ بُنتُنيِ شّلّ بُن سٍ مَنِيَ. كٍرٍن لَن نْنفْن يَ سُولِ نَن مَ، بٌورٍ قَن نَشَ لَن نْنفْن يَ سُولِ مَ. سٌدٍ دّ شَ فبٌي لَن نْنفْن يَ قُ نُن نَانِ نَن مَ. بَنشِ شّلّ نَشٍيٍ نُ نَ نَ سّيتِ قِرِنيِيٍ مَ لَن نْنفْن يَ سَشَن نَن مَ. <verse eid="EZK 40:48"/><verse number="49" style="v" sid="EZK 40:49"/>نَ بُنتُنيِ شَ مَءِفبٌي لَن نْنفْن يَ مْشْحّن نَن مَ، عَ شَ مَءِتٍ لَن نْنفْن يَ قُ نُن قِرِن نَن مَ. تٍدٍيٍ نُ نَ عَ بّ. كِنكِ قِرِن نُ تِشِ بُنتُنيِ شّلّ سّيتِيٍ مَ.<verse eid="EZK 40:49"/></para>
  <chapter eid="EZK 40"/>
  <chapter number="41" style="c" sid="EZK 41"/>
  <para style="s">هْرْ مْبَنشِ نّينّ شَلّيٍ نُن نَادّيٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 41:1"/>نَ شّمّ نَشَ ﭑ شَنِن هْرْ مْبَنشِ يِرٍ سّنِيّنشِ كُي. عَ نَشَ عَ كِنكِيٍ مَنِيَ نَشٍيٍ نُ نَ نَادّ سّيتِيٍ مَ. كَنكَن شَ فبٌي نَشَ لَن نْنفْن يَ سٍننِ مَ. <verse eid="EZK 41:1"/><verse number="2" style="v" sid="EZK 41:2"/>سٌدٍ دّ شَ فبٌي لَن نْنفْن يَ قُ نَن مَ. بَنشِ شّلّ نَشٍيٍ نُ نَ نَ سّيتِ قِرِنيِيٍ مَ، عٍ لَن نْنفْن يَ سُولِ نَن مَ. عَ نَشَ نَ هْرْ مْبَنشِ مَنِيَ. عَ شَ كُيّ لَن نْنفْن يَ تٌنفٌ نَانِ نَن مَ، عَ شَ فبٌي لَن نْنفْن يَ مْشْحّن نَن مَ.<verse eid="EZK 41:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 41:3"/>نَ تّمُي، نَ شّمّ نَشَ سٌ هْرْ مْبَنشِ يِرٍ سّنِيّنشِ قِسَمَنتٍ كُي. عَ نَشَ عَ كِنكِيٍ مَنِيَ نَشٍيٍ نُ نَ نَادّ سّيتِيٍ مَ. كَنكَن شَ فبٌي نَشَ لَن نْنفْن يَ قِرِن مَ. عَ سٌدٍ دّ لَن نْنفْن يَ سٍننِ نَن مَ. بَنشِ شّلّ نَشٍيٍ نُ نَ نَ سّيتِ قِرِنيِيٍ مَ، عٍ لَن نْنفْن يَ سٌلٌقٍرٍ نَن مَ. <verse eid="EZK 41:3"/><verse number="4" style="v" sid="EZK 41:4"/>عَ نَشَ عَ شَ كُيّ نُن عَ شَ فبٌي مَنِيَ، كَنكَن نَشَ لَن نْنفْن يَ مْشْحّن مَ. عَ نَشَ عَ قَلَ ﭑ بّ، «يِرٍ سّنِيّنشِ قِسَمَنتٍ نَن يِ كِ.»<verse eid="EZK 41:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 41:5"/>عَ نَشَ هْرْ مْبَنشِ شّلّ مَنِيَ. عَ شَ مَرَبِنيٍ نَشَ لَن نْنفْن يَ سٍننِ مَ. يِرٍ نَشٍيٍ نُ نَ هْرْ مْبَنشِ رَبِلِنيِ مَ، كَنكَن شَ فبٌي لَن نْنفْن يَ نَانِ نَن مَ. <verse eid="EZK 41:5"/><verse number="6" style="v" sid="EZK 41:6"/>نَ يِرٍيٍ نُ دْشْشِ عٍ بٌرٍ نَن كْن نَ دّكِ سَشَن نَ. كٌنكٌي تٌنفٌ سَشَن نَن نُ نَ نَ دّكِ كٍرٍن كٍرٍن بِرِن مَ. بُن سٍ نُ نَ هْرْ مْبَنشِ رَبِلِنيِ، كْنْ عٍ مُ نُ رَ سٌشِ هْرْ مْبَنشِ شّلّ تَن كُي. <verse eid="EZK 41:6"/><verse number="7" style="v" sid="EZK 41:7"/>دّكِيٍ نُ تٍ عِفبٌ رَ عٍ بٌرٍ بّ عَلَكٌ نَشَن نَ كٌورٍ مَ نَشَ عِفبٌ دَنفِ لَنبَنيِ دَاشِ رَ. تٍدٍيٍ نُ نَ كٍلِ لَنبَنيِ مَ عَ سَ دْشْ دّكِ دْنشْي رَ.<verse eid="EZK 41:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 41:8"/>ﭑ نَشَ عَ رَبّن، سَنبُنيِ نُ نَ هْرْ مْبَنشِ رَبِلِنيِ مَ، نَشَن كُيَ نْنفْن يَ سٍننِ. نَ يِرٍ نَشٍيٍ نُ نَ هْرْ مْبَنشِ رَبِلِنيِ، عٍ نُ تِشِ نَ سَنبُنيِ قَرِ. <verse eid="EZK 41:8"/><verse number="9" style="v" sid="EZK 41:9"/>نَ يِرٍيٍ شّلّ شَ مَرَبِنيٍ لَن نْنفْن يَ سُولِ نَن مَ. كّنّ نَشَن نُ نَ هْرْ مْبَنشِ <verse eid="EZK 41:9"/><verse number="10" style="v" sid="EZK 41:10"/>نُن سّرّشّدُبّيٍ شَ كٌنكٌي تَفِ، عَ لَن نْنفْن يَ مْشْحّن نَن مَ، عَ رَبِلِنيِ بِرِن نَ. <verse eid="EZK 41:10"/><verse number="11" style="v" sid="EZK 41:11"/>نَ يِرٍ نَشٍيٍ نُ نَ هْرْ مْبَنشِ رَبِلِنيِ، عٍ سٌدٍ دّ كٍرٍن نُ نَ كْولَ مَ، كٍرٍن قَن نُ نَ يِرٍقَنيِ مَ. كّنّ نُ نَ عٍ رَبِلِنيِ مَ، نَشَن لَن نْنفْن يَ سُولِ مَ.<verse eid="EZK 41:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 41:12"/>بَنشِ فبّتّ ندٍ نُ نَ هْرْ مْبَنشِ سٌفٍفٌرٌدٍ مَبِرِ، نَشَن شَ مَءِفبٌي نُ لَنشِ نْنفْن يَ تٌنفٌ سٌلٌقٍرٍ مَ، عَ شَ كُيّ نُ لَنشِ نْنفْن يَ تٌنفٌ سٌلٌمَنَانِ نَن مَ. عَ شّلّ شَ مَرَبِنيٍ نُ لَنشِ نْنفْن يَ سُولِ نَن مَ.<verse eid="EZK 41:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 41:13"/>نَ شّمّ نَشَ هْرْ مْبَنشِ مَنِيَ. عَ شَ كُيّ لَن نْنفْن يَ كّمّ نَن مَ. كّنّ، بَنشِ، نُن عَ شّلّ، نٍيٍ قَن شَ كُيّ لَن نْنفْن يَ كّمّ نَن مَ. <verse eid="EZK 41:13"/><verse number="14" style="v" sid="EZK 41:14"/>كّنّ نَشَن نُ نَ هْرْ مْبَنشِ سٌفٍتٍدٍ مَبِرِ، عَ لَن نْنفْن يَ كّمّ نَن مَ.<verse eid="EZK 41:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 41:15"/>نَ شّمّ نَشَ بَنشِ مَنِيَ، نَشَن نُ نَ هْرْ مْبَنشِ شَنبِ رَ، نُن دَنفِدٍ نَشٍيٍ نُ نَ عَ سّيتِ قِرِنيِ مَ، نَ لَن نْنفْن يَ كّمّ نَن مَ.</para>
  <para style="p" vid="EZK 41:15">هْرْ مْبَنشِ، عَ شَ بُنتُنيِ، <verse eid="EZK 41:15"/><verse number="16" style="v" sid="EZK 41:16"/>عَ سٌدٍ دّيٍ، نُن عَ وُندّرِيٍ، نَ بِرِن نُ رَتٌقَنشِ وُرِ قَنيِ نَن نَ، كٍلِقٍ لَنبَنيِ مَ هَن كٌورٍ. <verse eid="EZK 41:16"/><verse number="17" style="v" sid="EZK 41:17"/>سٌدٍ دّ شُن مَ نُن بَنشِ شّلّ بِرِن نَبِلِنيِ، عَ كُي نُن عَ قَرِ، <verse eid="EZK 41:17"/><verse number="18" style="v" sid="EZK 41:18"/>مَلٍكّيٍ نُن تُفِ قّنسّيٍ نَن نُ مَسٌلِشِ عَ مَ عَ رَشُنمَسٍ رَ. تُفِ قّنسّ كٍرٍن نَن نُ مَسٌلِشِ مَلٍكّ قِرِن تَفِ. يَتَفِ قِرِن نَن نُ نَ نَ مَلٍكّ بِرِن بّ، <verse eid="EZK 41:18"/><verse number="19" style="v" sid="EZK 41:19"/>عَ مِشِ دَاشِ نُن عَ يّتّ دَاشِ. نَ مِشِ يَتَفِ نُ رَقِندِشِ تُفِ قّنسّ نَن مَ، نَ يّتّ يَتَفِ نُ رَقِندِشِ تُفِ قّنسّ نَن مَ بٌورٍ سّيتِ مَبِرِ. <verse eid="EZK 41:19"/><verse number="20" style="v" sid="EZK 41:20"/>مَلٍكّيٍ نُن تُفِ قّنسّيٍ نُ مَسٌلِشِ كٍلِقٍ هْرْ مْبَنشِ لَنبَنيِ مَ هَن كٌورٍ.<verse eid="EZK 41:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 41:21"/>سٌدٍ دّ نُ نَ هْرْ مْبَنشِ شَ يِرٍ سّنِيّنشِ مَ، عَ مَنِيّ قَن نُ نَ عَ شَ يِرٍ سّنِيّنشِ قِسَمَنتٍ مَ. <verse eid="EZK 41:21"/><verse number="22" style="v" sid="EZK 41:22"/>سّرّشّبَدٍ ندٍ نُ نَ مّننِ، نَشَن نُ رَقَلَشِ وُرِ رَ، عَ شَ مَءِتٍ لَن نْنفْن يَ سَشَن نَن مَ، عَ شَ كُيّ لَن نْنفْن يَ قِرِن نَن مَ، عَ شَ مَءِفبٌي نُ لَنشِ نْنفْن يَ قِرِن نَن مَ. عَ تُنشُنيِيٍ، عَ دّ كِرِيٍ، نُن عَ سّيتِيٍ بِرِن نُ يَءِلَنشِ وُرِ نَن نَ. نَ شّمّ نَشَ عَ قَلَ ﭑ بّ، «يِ تٍيبِلِ نَن نَ عَلَتَلَ يَ عِ.» <verse eid="EZK 41:22"/><verse number="23" style="v" sid="EZK 41:23"/>نَادّ قِرِن نَن نُ نَ هْرْ مْبَنشِ يِرٍ سّنِيّنشِ سٌدٍ دّ رَ، نَادّ قِرِن نَن نُ نَ هْرْ مْبَنشِ يِرٍ سّنِيّنشِ قِسَمَنتٍ سٌدٍ دّ رَ. <verse eid="EZK 41:23"/><verse number="24" style="v" sid="EZK 41:24"/>نَادّ بّلَ قِرِن نَن نُ نَ نَ سٌدٍ دّ قِرِنيِ، نَشٍيٍ نُ رَفَلِمَ سٌدٍ دّ مَ. <verse eid="EZK 41:24"/><verse number="25" style="v" sid="EZK 41:25"/>مَلٍكّيٍ نُن تُفِ قّنسّيٍ نُ مَسٌلِشِ هْرْ مْبَنشِ نَادّيٍ مَ، عَلْ عَ نُ مَسٌلِشِ عَ شّلّيٍ مَ كِ نَشّ. وُرِيٍ قَن نُ نَ بُنتُنيِ مَ كٌورٍ مَ. <verse eid="EZK 41:25"/><verse number="26" style="v" sid="EZK 41:26"/>وُندّرِيٍ نُ نَ بُنتُنيِ شّلّ مَ عَ سّيتِيٍ مَ، تُفِ قّنسّيٍ نُ مَسٌلِشِ وُندّرِيٍ سّيتِيٍ مَ. وُرِيٍ قَن نُ نَ نَ يِرٍيٍ شُن نَ، نَشٍيٍ نُ تِشِ هْرْ مْبَنشِ رَبِلِنيِ.<verse eid="EZK 41:26"/></para>
  <chapter eid="EZK 41"/>
  <chapter number="42" style="c" sid="EZK 42"/>
  <para style="s">سّرّشّدُبّيٍ شَ بَنشِ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 42:1"/>نَ دَنفِ شَنبِ، نَ شّمّ نَشَ ﭑ نَمِنِ نَ تّتّ سِنفٍ كُي كْولَ مَ. عَ نَشَ ﭑ شَنِن بَنشِ يِرٍ، نَشَن نُ نَ تّتّ سِنفٍ شّلّ كْولَ مَبِرِ نُن هْرْ مْبَنشِ تَفِ. <verse eid="EZK 42:1"/><verse number="2" style="v" sid="EZK 42:2"/>نَ بَنشِ شَ سٌدٍ دّ يَ نُ رَقِندِشِ كْولَ نَن مَ. نَ بَنشِ نُ كُيَ نْنفْن يَ كّمّ، عَ نُ عِفبٌ نْنفْن يَ تٌنفٌ سُولِ. <verse eid="EZK 42:2"/><verse number="3" style="v" sid="EZK 42:3"/>سّيتِ نَشَن نُ كُيَ تّتّ مَبِرِ نْنفْن يَ مْشْحّن، عَ نُن سّيتِ نَشَن نُ نَ هْرْ مْبَنشِ مَبِرِ، كٌنكٌييٍ يِرٍ دّكِ سَشَن ندٍ نُ تِشِ نَ يِرٍ قِرِنيِ مَ. <verse eid="EZK 42:3"/><verse number="4" style="v" sid="EZK 42:4"/>حّرّدٍيٍ نُ نَ نَ سّيتِ قِرِنيِ مَ نَشٍيٍ نُ عِفبٌ نْنفْن يَ قُ، عٍ نُ كُيَ نْنفْن يَ كّمّ عَلْ بَنشِ. كٌنكٌييٍ سٌدٍ دّيٍ نُ رَقِندِشِ كْولَ نَن مَ. <verse eid="EZK 42:4"/><verse number="5" style="v" sid="EZK 42:5"/>كٌنكٌي نَشٍيٍ نُ نَ كٌورٍ دّكِ سَشَن ندٍ مَ، نٍيٍ نُ عِشُتُ دَنفِقٍ بٌورٍ رَ لَنبَنيِ. <verse eid="EZK 42:5"/><verse number="6" style="v" sid="EZK 42:6"/>كِنكِ يٌ مُ نُ نَ نَ دّكِ سَشَن ندٍ بّ، عٍ عِشُتُشِ نَ نَن مَ. <verse eid="EZK 42:6"/><verse number="7" style="v" sid="EZK 42:7"/>شّلّ نُ تِشِ كٌنكٌي نُن تّتّ سِنفٍ تَفِ، عَ نُ كُيَ نْنفْن يَ تٌنفٌ سُولِ. <verse eid="EZK 42:7"/><verse number="8" style="v" sid="EZK 42:8"/>بٌورٍ سّيتِ هْرْ مْبَنشِ مَبِرِ عَ نُ كُيَ نْنفْن يَ كّمّ. <verse eid="EZK 42:8"/><verse number="9" style="v" sid="EZK 42:9"/>كٌنكٌي نَشٍيٍ نُ نَ لَنبَنيِ، عٍ سٌدٍ دّيٍ نُ نَ سٌفٍتٍدٍ مَبِرِ.<verse eid="EZK 42:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 42:10"/>كٌنكٌي فبّتّيٍ نُ نَ يِرٍقَنيِ مَبِرِ تّتّ سِنفٍ شّلّ لٌنفٌرِ رَ هْرْ مْبَنشِ يَ عِ. <verse eid="EZK 42:10"/><verse number="11" style="v" sid="EZK 42:11"/>حّرّدٍ ندٍ نُ نَ عٍ يَ رَ. نَ كٌنكٌي نُ مَنِيَشِ كٌنكٌي نَن نَ نَشٍيٍ نُ نَ كْولَ مَبِرِ. عٍ قِرِن نَقَلَ كِ، عٍ شَ كُيّ نُن عٍ شَ فبٌي، نَ بِرِن لَن. <verse eid="EZK 42:11"/><verse number="12" style="v" sid="EZK 42:12"/>عٍ شَ سٌدٍ دّيٍ نُ نَ يِرٍقَنيِ نَن مَ. نَادّ شُنفبٍ ندٍ نُ نَ سٌفٍتٍدٍ مَبِرِ.<verse eid="EZK 42:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 42:13"/>نَ شّمّ نَشَ عَ قَلَ ﭑ بّ، عَ نَشّ، «كٌنكٌي نَشٍيٍ نَ يِرٍقَنيِ نُن كْولَ مَ تّتّ يَ عِ، نٍيٍ قِندِشِ يِرٍ سّنِيّنشِيٍ نَن نَ، عَلَتَلَ شَ سّرّشّدُبّيٍ سّرّشّ سُبٍ دٌنمَ دّننَشّ. عٍ سّرّشّ سّنِيّنشِيٍ رَفَتَمَ مّننِ نّ نَشٍيٍ قِندِشِ سَنسِ شْرِ سّرّشّيٍ، يُنُبِ شَقَرِ سّرّشّيٍ رَ. يِرٍ سّنِيّنشِ نَن مّننِ رَ. <verse eid="EZK 42:13"/><verse number="14" style="v" sid="EZK 42:14"/>سّرّشّدُبّيٍ نَ سٌ يِرٍ سّنِيّنشِيٍ، عَ مُ لَنمَ عٍ شَ مِنِ حَمَ يَ مَ تّتّ كُي، قٌ عٍ شَ عٍ شَ دُفِ سّنِيّنشِيٍ بَ.»<verse eid="EZK 42:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 42:15"/>نَ شّمّ تٌ فّ هْرْ مْبَنشِ يِرٍ مَنِيَدٍ، عَ نَشَ ﭑ نَمِنِ سٌفٍتٍدٍ سٌدٍ دّ رَ، عَ قَ نَ تّتّ رَبِلِنيِ بِرِن مَنِيَ. <verse eid="EZK 42:15"/><verse number="16" style="v" sid="EZK 42:16"/>عَ نَشَ عَ قْلْ سٌفٍتٍدٍ مَبِرِ. نَ سّيتِ شَ كُيّ لَن نْنفْن يَ كّمّ سُولِ نَن مَ. <verse eid="EZK 42:16"/><verse number="17" style="v" sid="EZK 42:17"/>نَ تّمُي، عَ نَشَ كْولَ سّيتِ مَنِيَ، نَشَن شَ كُيّ قَن لَن عَ يَ كّمّ سُولِ مَ. <verse eid="EZK 42:17"/><verse number="18" style="v" sid="EZK 42:18"/>نَ تّمُي، عَ نَشَ يِرٍقَنيِ سّيتِ مَنِيَ، نَشَن شَ كُيّ قَن لَن عَ يَ كّمّ سُولِ مَ. <verse eid="EZK 42:18"/><verse number="19" style="v" sid="EZK 42:19"/>عَ رَحْنيِ، عَ نَشَ سٌفٍفٌرٌدٍ سّيتِ مَنِيَ، نَشَن شَ كُيّ قَن لَن عَ يَ كّمّ سُولِ مَ. <verse eid="EZK 42:19"/><verse number="20" style="v" sid="EZK 42:20"/>عَ نَشَ تّتّ رَبِلِنيِ بِرِن مَنِيَ عَ شَ وُرِ مَنِيَسٍ رَ. تّتّ سّيتِ نَانِيٍ بِرِن لَن وُرِ يَ كّمّ سُولِ نَن مَ. نَ تّتّ نُ تِشِ يِرٍ سّنِيّنشِ نُن يِرٍ سّنِيّنتَرٍ نَن تَفِ.<verse eid="EZK 42:20"/></para>
  <chapter eid="EZK 42"/>
  <chapter number="43" style="c" sid="EZK 43"/>
  <para style="s">عَلَتَلَ شَ نْرّ فبِلٍنقٍ هْرْ مْبَنشِ كُي</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 43:1"/>نَ تّمُي، نَ شّمّ نَشَ ﭑ شَنِن سٌفٍتٍدٍ سٌدٍ دّ رَ. <verse eid="EZK 43:1"/><verse number="2" style="v" sid="EZK 43:2"/>ﭑ نَشَ عِسِرَيِلَ مَرِفِ عَلَ شَ نْرّ تٌ قَقٍ رَ كٍلِقٍ سٌفٍتٍدٍ مَبِرِ. عَ نُ شُي نَشَن نَمِنِمَ، نَ نُ لُشِ نّ عَلْ بَا شُنفبٍ مْرْنيِيٍ، بْشِ قَن نُ عِيَلَنمَ عَ يَنبّ رَ. <verse eid="EZK 43:2"/><verse number="3" style="v" sid="EZK 43:3"/>ﭑ لَامَتُنيِ نَشَن تٌ، نَ نُ لُشِ نّ عَلْ ﭑ نَشَن تٌ مَرِفِ قَ لْشْي دَرِ سَلَمُ كَنَدٍ. عَ نُ لُشِ نّ عَلْ ﭑ نَشَن تٌ كٍبَرَ شُرٍ دّ رَ. ﭑ تٌ عَ تٌ، ﭑ نَشَ ﭑ يَتَفِ رَقٍلٍن بْشِ مَ. <verse eid="EZK 43:3"/><verse number="4" style="v" sid="EZK 43:4"/>عَلَتَلَ شَ نْرّ نَشَ سٌ هْرْ مْبَنشِ كُي سٌفٍتٍدٍ سٌدٍ دّ رَ. <verse eid="EZK 43:4"/><verse number="5" style="v" sid="EZK 43:5"/>نَ تّمُي، عَلَ شَشِلِ سّنِيّنشِ نَشَ ﭑ تٌنفٌ، عَ ﭑ شَنِن هْرْ مْبَنشِ تّتّ قِرِن ندٍ كُي، عَلَتَلَ شَ نْرّ نُ بَرَ فبٌ دّننَشّ.<verse eid="EZK 43:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 43:6"/>ﭑ نُ نَ نَ شّمّ سّيتِ مَ، كْنْ ﭑ نَشَ شُي ندٍ مّ وْيّنقٍ ﭑ نَ كٍلِقٍ هْرْ مْبَنشِ كُي. <verse eid="EZK 43:6"/><verse number="7" style="v" sid="EZK 43:7"/>نَ شُي نَشَ عَ مَسٍن ﭑ بّ، عَ نَشّ، «عَدَ مَدِ، ﭑ مَ كِبَنيِ يِرٍ نَن يَ، ﭑ سَنيِ تِمَ دّننَشّ. ﭑ سَبَتِمَ نّ بٍ عِسِرَيِلَكَيٍ يَ مَ عَبَدَن. عِسِرَيِلَ بْنسْي نُن عَ شَ مَنفّيٍ مُ ﭑ شِلِ سّنِيّنشِ مَبٍرٍ مَ سْنْن عٍ شَ لَنفٌيحَ رَ، نُن عٍ شَ فَبُرِ تِقٍ رَ عٍ شَ سَلِدٍ عِتٍشِيٍ مَ. <verse eid="EZK 43:7"/><verse number="8" style="v" sid="EZK 43:8"/>مَنفّيٍ نَ عٍ شَ بَنشِ سٌدٍ دّيٍ نُن عٍ شَ بَنشِ شَلّيٍ تِ ﭑ فبٍيٍ سّيتِ مَ، عٍ ﭑ شِلِ سّنِيّنشِ مَبٍرٍشِ نَ كِ نّ عٍ شَ وَلِ كٌبِ رَ. ﭑ عٍ سْنتْشِ ﭑ مَ شْنّ كُي نَ نَن مَ. <verse eid="EZK 43:8"/><verse number="9" style="v" sid="EZK 43:9"/>يَكْسِ قَ، عٍ شَ عٍ شَ كُيٍ بَتُي نُن عٍ شَ مَنفّيٍ قُرٍيٍ مَكُيَ ﭑ نَ، عَلَكٌ ﭑ شَ لُ عٍ يَ مَ عَبَدَن.»<verse eid="EZK 43:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 43:10"/>«عَدَ مَدِ، عِ شَ يِ هْرْ مْبَنشِ شَ قٍ مَسٍن عِسِرَيِلَكَيٍ بّ، عَلَكٌ عٍ شَ يَافِ عٍ شَ يُنُبِيٍ رَ. عٍ شَ يِ بَنشِ تِ كِ مَتٌ. <verse eid="EZK 43:10"/><verse number="11" style="v" sid="EZK 43:11"/>شَ عٍ بَرَ يَافِ عٍ شَ وَلِ كٌبِيٍ رَ، يِ بَنشِ شَ قٍ رَكٌلٌن عٍ رَ، عَ تِشِ مْولِ نَشَن نَ، عَ سٌدٍ دّيٍ نُن عَ مِنِدٍ دّيٍ نَ كِ نَشّ، نُن عَ شَ قٍ رَبَ كّحَ، عَلَكٌ عٍ شَ بِرَ نَ يَامَرِيٍ قْشْ رَ.»<verse eid="EZK 43:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 43:12"/>«هْرْ مْبَنشِ شَ سّرِيّ نَن يَ؛ بْشِ نَشَن بِرِن نَ يِ فٍيَ قَرِ، نَ بِرِن سّنِيّنشِ. هْرْ مْبَنشِ شَ سّرِيّ نَن نَ كِ.»<verse eid="EZK 43:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 43:13"/>«سّرّشّبَدٍ شَ مَنِيّ شَسَبِ نَن يِ كِ، نَشَن مَنِيَشِ مَنِيَسٍ رَ سِنفٍ مَنِيَسٍ نُ دَنفِ نَشَن نَ بّلّشّ سُشُ كٍرٍن. قٌلٍ نَشَن فٍشِ سّرّشّبَدٍ رَبِلِنيِ، عَ تِلِن نْنفْن يَ كٍرٍن، عَ عِفبٌ نْنفْن يَ كٍرٍن. عَ دّ كِرِ عِفبٌي لَنشِ نْنفْن تَفِ نَن مَ. سّرّشّبَدٍ شَ مَءِتٍ <verse eid="EZK 43:13"/><verse number="14" style="v" sid="EZK 43:14"/>كٍلِقٍ نَ قٌلٍ مَ هَن سّرّشّبَدٍ بُنيِ، عَ لَنشِ نْنفْن يَ قِرِن نَن مَ. عَ عِفبٌي لَنشِ نْنفْن يَ كٍرٍن نَن مَ. سّرّشّبَدٍ شَ مَءِتٍ كٍلِقٍ عَ بُنيِ مَ هَن عَ كٌورٍ، نَ لَنشِ نْنفْن يَ نَانِ نَن مَ، عَ عِفبٌي لَنشِ نْنفْن يَ كٍرٍن نَن مَ. <verse eid="EZK 43:14"/><verse number="15" style="v" sid="EZK 43:15"/>سّرّشّبَدٍ شَ تّ سَدٍ تِلِنيِ لَنشِ نْنفْن يَ نَانِ نَن مَ. قٍرِ نَانِ تِشِ سّرّشّبَدٍ تُنشُنيِيٍ مَ. <verse eid="EZK 43:15"/><verse number="16" style="v" sid="EZK 43:16"/>نَ تّ سَدٍ شَ كُيّ لَنشِ نْنفْن يَ قُ نُن قِرِن نَن مَ. عَ عِفبٌي قَن لَنشِ نْنفْن يَ قُ نُن قِرِن نَن مَ. <verse eid="EZK 43:16"/><verse number="17" style="v" sid="EZK 43:17"/>عَ دّ رَبِلِنيِ شَ كُيّ لَنشِ نْنفْن يَ قُ نُن نَانِ نَن مَ، عَ عِفبٌي قَن لَنشِ نْنفْن يَ قُ نُن نَانِ نَن مَ. نَ دّ رَبِلِنيِ دّ كِرِ لَنشِ نْنفْن تَفِ نَن مَ، عَ دّننَشّ كُي عِفٍشِ عَ لَنشِ نْنفْن يَ كٍرٍن نَن مَ. سّرّشّبَدٍ سَنتِدٍيٍ يَ نُ رَقِندِشِ سٌفٍتٍدٍ نَن مَ.»<verse eid="EZK 43:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 43:18"/>نَ تّمُي، نَ شّمّ نَشَ عَ قَلَ ﭑ بّ، عَ نَشّ، «عَدَ مَدِ، عِ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛ ‹سّرِيّ نَن يِ كِ سّرّشّ فَن دَاشِ شَ قٍ رَ نُن وُلِ كَسَنقٍ شَ قٍ رَ يِ سّرّشّبَدٍ بّ عَ تِ تّمُي. <verse eid="EZK 43:18"/><verse number="19" style="v" sid="EZK 43:19"/>عَ لَنمَ عِ شَ تُورَ كٍرٍن سٌ لٍوِ سّرّشّدُبّيٍ سَدْكِ بْنسْي يِ رَ، نَشٍيٍ نَ بَمَ يُنُبِ شَقَرِ سّرّشّ رَ. وٌ مَرِفِ عَلَتَلَ شُي نَن نَ كِ. <verse eid="EZK 43:19"/><verse number="20" style="v" sid="EZK 43:20"/>عٍ شَ نَ وُلِ دِ سَ سّرّشّبَدٍ قٍرِيٍ مَ، عَ تُنشُن نَانِ بِرِن مَ لَنبَنيِ، نُن عَ دّ رَبِلِنيِ بِرِن مَ. سّرّشّبَدٍ رَ سّنِيّنمَ نَ كِ نّ، عَ قِندِ شُنسَرٍ رَ عَ بّ. <verse eid="EZK 43:20"/><verse number="21" style="v" sid="EZK 43:21"/>عٍ شَ نَ تُورَ تٌنفٌ، نَشَن بَمَ يُنُبِ شَقَرِ سّرّشّ رَ، عَ شَ فَن هْرْ مْبَنشِ تّتّ كُي عَ لَنمَ عَ شَ فَن دّننَشّ سّرِيّ كِ مَ.›»<verse eid="EZK 43:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 43:22"/>«نَ لْشْي كُيٍ عِبَ، عٍ شَ سِكْتّ كٍرٍن تٌنفٌ، لَنيُرُ يٌ مُ نَ نَشَن مَ، عٍ شَ عَ بَ يُنُبِ شَقَرِ سّرّشّ رَ سّرّشّبَدٍ رَ سّنِيّنقٍ رَ، عَلْ عٍ عَ رَبَ كِ نَشّ تُورَ رَ. <verse eid="EZK 43:22"/><verse number="23" style="v" sid="EZK 43:23"/>عٍ نَ فّ سّرّشّبَدٍ رَ سّنِيّندٍ نَ كِ، عٍ مَن شَ تُورَ كٍرٍن نُن يّشّي كٌنتٌنيِ كٍرٍن تٌنفٌ، لَنيُرُ يٌ مُ نَشٍيٍ مَ، <verse eid="EZK 43:23"/><verse number="24" style="v" sid="EZK 43:24"/>عٍ شَ نٍيٍ بَ عَلَتَلَ بّ سّرّشّ فَن دَاشِ رَ. سّرّشّدُبّيٍ لَنمَ عٍ شَ قْشّ كَسَن نَ بِرِن مَ.»<verse eid="EZK 43:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 43:25"/>«لْشْ يٌ لْشْ هَن شِ سٌلٌقٍرٍ، عٍ شَ سِكْتّ كٍرٍن بَ يُنُبِ شَقَرِ سّرّشّ رَ، عَ نُن تُورَ نُن يّشّي كٌنتٌنيِ، لَنيُرُ يٌ مُ نَ نَشٍيٍ مَ. <verse eid="EZK 43:25"/><verse number="26" style="v" sid="EZK 43:26"/>هَن شِ سٌلٌقٍرٍ بُن مَ، يِ سّرّشّبَدٍ رَ سّنِيّنمَ نَ كِ نّ، عَ شَ قِندِ وٌ شَ سّرّشّبَدٍ رَ. <verse eid="EZK 43:26"/><verse number="27" style="v" sid="EZK 43:27"/>نَ لْشْييٍ نَ بَ عَ رَ، كٍلِ عَ شِ سٌلٌمَسَشَن ندٍ مَ، سّرّشّدُبّيٍ لُمَ وٌ شَ سّرّشّ فَن دَاشِيٍ نُن وٌ شَ سّرّشّ حَنِفٍشِيٍ بَ رَ نّ مّننِ قَ. نَ كُي، ﭑ وٌ رَ سّنّمَ نّ. وٌ مَرِفِ عَلَتَلَ شُي نَن نَ كِ.»<verse eid="EZK 43:27"/></para>
  <chapter eid="EZK 43"/>
  <chapter number="44" style="c" sid="EZK 44"/>
  <para style="s">نَادّ بَلَنشِ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 44:1"/>نَ شّمّ نَشَ ﭑ شَنِن هْرْ مْبَنشِ تّتّ سٌدٍ دّ رَ، نَشَن نُ نَ سٌفٍتٍدٍ مَبِرِ. نَ نَادّ نُ بَلَنشِ. <verse eid="EZK 44:1"/><verse number="2" style="v" sid="EZK 44:2"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، «نَ نَادّ بَلَنشِ، عَ مُ رَبِمَ. عِبُنَدَ مَ يٌ مُ سٌمَ نَا، بَرِ مَ، ﭑ تَن عِسِرَيِلَ مَرِفِ عَلَتَلَ نَن سٌشِ مّننِ رَ. <verse eid="EZK 44:2"/><verse number="3" style="v" sid="EZK 44:3"/>كْنْ عِسِرَيِلَ مَنفّ نَن فبَنسَن نْمَ دْشْدٍ نَ سٌدٍ دّ رَ عَ سّرّشّ دٌن ﭑ يَ عِ. عَ سٌمَ بُنتُنيِ سٌدٍ دّ نَن نَ، عَ مَن مِنِ مّننِ رَ.»<verse eid="EZK 44:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 44:4"/>نَ دَنفِ شَنبِ، نَ شّمّ نَشَ ﭑ شَنِن هْرْ مْبَنشِ تّتّ سٌدٍ دّ كْولَ بِرِ رَ هْرْ مْبَنشِ يَ عِ. مّننِ ﭑ نَشَ عَلَتَلَ شَ نْرّ تٌ سٌ رَ عَ شَ هْرْ مْبَنشِ كُي، ﭑ قَ ﭑ يَتَفِ رَقٍلٍن بْشِ مَ. <verse eid="EZK 44:4"/><verse number="5" style="v" sid="EZK 44:5"/>عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ، عَ نَشّ، «عَدَ مَدِ، عِ شَ عِ تُلِ مَتِ ﭑ مَ مَسٍنيِ رَ عَ فبٍنفبٍنيِ، ﭑ تَن عَلَتَلَ نَشَن مَسٍنمَ عِ بّ ﭑ مَ هْرْ مْبَنشِ شَ قٍ رَ. عِ شَ عِ حْشْ سَ نَ سٌدٍ دّيٍ نُن عَ مِنِدٍيٍ شْن مَ. <verse eid="EZK 44:5"/><verse number="6" style="v" sid="EZK 44:6"/>عِ شَ عَ قَلَ عِسِرَيِلَ مَتَندِلَيٍ بّ، ‹ﭑ تَن مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛ نَ لَن. وٌ شَ قٍ حَاشِيٍ بَرَ دَنفِ عَ عِ! <verse eid="EZK 44:6"/><verse number="7" style="v" sid="EZK 44:7"/>وٌ مَن بَرَ عَ شُنمَسَ، سُننَتَرٍيٍ رَ سٌقٍ ﭑ مَ هْرْ مْبَنشِ سّنِيّنشِ كُي، نَشٍيٍ بْحّ مَكُيَ ﭑ نَ. نَ كُي وٌ بَرَ قٍ رَهَرَ مُشِ رَبَ ﭑ مَ بَنشِ رَ، هَلِ وٌ تٌ نُ دٌنسٍ، تُرٍ، نُن وُلِ بَقٍ سّرّشّ رَ عَ كُي. وٌ بَرَ ﭑ مَ سّرِيّ كَنَ نَ مْولِ رَ. <verse eid="EZK 44:7"/><verse number="8" style="v" sid="EZK 44:8"/>وٌ بَرَ تٌندِ ﭑ مَ وَلِ سّنِيّنشِ رَبَدٍ، وٌ قَ نَ وَلِ سٌ مِشِ فبّتّ يِ رَ. <verse eid="EZK 44:8"/><verse number="9" style="v" sid="EZK 44:9"/>مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛ سُننَتَرٍ يٌ نَشَ سٌ ﭑ مَ هْرْ مْبَنشِ كُي، نَشَن بْحّ مَكُيَ ﭑ نَ، هَلِ عٍ سَبَتِشِ عِسِرَيِلَكَيٍ يَ مَ.›»<verse eid="EZK 44:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 44:10"/>«لٍوِ بْنسْي تٌ عٍ مَكُيَ ﭑ نَ، عٍ بِرَ عٍ شَ كُيٍيٍ قْشْ رَ، عَ نُن عِسِرَيِلَ حَمَ، ﭑ نٍيٍ سَرٍ رَفبِلٍنمَ نّ عٍ مَ. <verse eid="EZK 44:10"/><verse number="11" style="v" sid="EZK 44:11"/>ﭑ عٍ لُمَ نّ عٍ شَ وَلِ كُي ﭑ مَ هْرْ مْبَنشِ يِرٍ، عٍ شَ نَ سٌدٍ دّيٍ كَنتَ، عٍ شَ سّرّشّ فَن دَاشِ نُن سّرّشّ فبّتّيٍ بَ حَمَ بّ. <verse eid="EZK 44:11"/><verse number="12" style="v" sid="EZK 44:12"/>كْنْ عٍ تٌ ﭑ مَ وَلِ رَبَ عٍ شَ كُيٍيٍ يَ عِ، عٍ عَ نِيَ عِسِرَيِلَ بْنسْي قَن شَ بِرَ يُنُبِ قْشْ رَ، ﭑ بَرَ ﭑ كَلِ ﭑ بّلّشّ عِتٍشِ رَ، عٍ قَمَ نّ نَ سَرٍ سْتْدٍ. وٌ مَرِفِ عَلَتَلَ شُي نَن نَن كِ. <verse eid="EZK 44:12"/><verse number="13" style="v" sid="EZK 44:13"/>يَكْسِ ﭑ مُ تِنمَ عٍ شَ عٍ مَسٌ ﭑ نَ سّرّشّ بَدٍ، ﭑ مُ تِنمَ عٍ شَ عٍ مَسٌ ﭑ مَ سٍ سّنِيّنشِيٍ رَ، ﭑ مُ تِنمَ عٍ شَ عٍ مَسٌ ﭑ مَ سٍ سّنِيّنشِ قِسَمَنتٍيٍ رَ. عَ لَنمَ عٍ شَ يَافِ سْتْ عٍ شَ قٍ حَاشِيٍ شَ قٍ رَ. <verse eid="EZK 44:13"/><verse number="14" style="v" sid="EZK 44:14"/>كْنْ ﭑ عٍ لُمَ نّ عٍ شَ وَلِ ندٍ رَبَ ﭑ مَ هْرْ مْبَنشِ يِرٍ، عٍ شَ عٍ حْشْ سَ نَا شْن مَ.»<verse eid="EZK 44:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 44:15"/>«عِسِرَيِلَكَيٍ تٌ نُ عٍ مَكُيَمَ ﭑ نَ، لٍوِ بْنسْي سّرّشّدُبّيٍ تَن، سَدْكِ شَ مِشِيٍ، عٍ نُ بَرَ عٍ تُننَبّشِ ﭑ مَ هْرْ مْبَنشِ شَ وَلِ كُي. نَ نَن عَ رَ، ﭑ نَشَ عَ لُ نٍيٍ ثٍتِ شَ عٍ مَسٌ ﭑ نَ، عٍ شَ تُرٍ نُن وُلِ بَ سّرّشّ رَ ﭑ بّ. مَرِفِ عَلَتَلَ شُي نَن نَ كِ. <verse eid="EZK 44:15"/><verse number="16" style="v" sid="EZK 44:16"/>نٍيٍ نَن فبَنسَن سٌمَ ﭑ مَ يِرٍ سّنِيّنشِ كُي، عٍ قَ ﭑ مَ وَلِ رَبَ ﭑ مَ تٍيبِلِ يَ عِ.»<verse eid="EZK 44:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 44:17"/>«عٍ نَ سٌ ﭑ مَ هْرْ مْبَنشِ شَ تّتّ كُي نَشَن نَ نَ تّتّ سِنفٍ كُي، عَ لَنمَ عٍ شَ سُوَ دُفِ رَفٌرٌ عٍ مَ. عٍ نَشَ دُفِ بِنيٍ رَفٌرٌ عٍ مَ عٍ نّ وَلِمَ هْرْ مْبَنشِ تّتّ سٌدٍ دّيٍ يِرٍ تّمُي نَشّ، شَ نَ مُ عَ رَ هْرْ مْبَنشِ كُي. <verse eid="EZK 44:17"/><verse number="18" style="v" sid="EZK 44:18"/>عَ لَنمَ عٍ شَ سُوَ دُفِ نَن شِرِ عٍ شُنيِ عٍ رَشُنمَسٍ رَ، عٍ مَن شَ سُوَ دُفِ شِرِ عٍ تَفِ. عٍ نَشَ سٍسٍ رَفٌرٌ عٍ مَ، نَشَن كُيٍقُرٍ رَ مِنِمَ عٍ قَتٍ مَ. <verse eid="EZK 44:18"/><verse number="19" style="v" sid="EZK 44:19"/>بٍينُ عٍ شَ مِنِ بٌورٍ تّتّ كُي حَمَ تِشِ دّننَشّ، عٍ شَ عٍ شَ سٌسٍ سّنِيّنشِيٍ بَ عٍ مَ، عٍ شَ عٍ لُ عٍ شَ كٌنكٌي كُي هْرْ مْبَنشِ يِرٍ. نَ كِ عٍ مُ مِشِ رَ سّنِيّنمَ عٍ شَ دُفِيٍ رَ.»<verse eid="EZK 44:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 44:20"/>«عَ مُ لَنمَ عٍ شَ عٍ شُنيِ بِ، عَ مُ لَنمَ عٍ شَ عٍ شُنسّشّ رَكُيَ. عٍ شَ عَ مَشَبَ عَ سّرِيّ كِ مَ. <verse eid="EZK 44:20"/><verse number="21" style="v" sid="EZK 44:21"/>عَ مُ لَنمَ سّرّشّدُبّيٍ شَ بٍرٍ يٌ مِن، عٍ نَ سٌ هْرْ مْبَنشِ تّتّ كُي تّمُي نَشّ. <verse eid="EZK 44:21"/><verse number="22" style="v" sid="EZK 44:22"/>سّرّشّدُبّيٍ مُ لَن عٍ شَ كَاحّ فِنّ دْشْ، عَ مُ لَن عٍ شَ فِنّ دْشْ، شّمّ ندٍ مّشِ نَشَن نَ. عٍ شَ عِسِرَيِلَ فِنّ دِ مّدِ فبَنسَن نَن دْشْ، شَ نَ مُ سّرّشّدُبّ ندٍ شَ كَاحّ فِنّ. <verse eid="EZK 44:22"/><verse number="23" style="v" sid="EZK 44:23"/>عٍ شَ ﭑ مَ حَمَ شَرَن سٍ رَدَشَشِ نُن سٍ رَهَرَ مُشِ تَفِ رَبَ كٌلٌندٍ. عٍ شَ عَ مَسٍن عٍ بّ نَشَن قِندِ سٍ سّنِيّنشِ نُن سٍ سّنِيّنتَرٍ رَ.»<verse eid="EZK 44:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 44:24"/>«حْشْنسْسْي نَ مِنِ حَمَ تَفِ، سّرّشّدُبّيٍ نَن كِيتِ سَمَ ﭑ مَ سّرِيّ كِ مَ. عٍ شَ ﭑ مَ يَامَرِيٍ سُشُ، عٍ شَ ﭑ مَ سَلِيٍ رَبَ، عٍ شَ ﭑ مَ مَلَبُي لْشْييٍ بِنيَ.»<verse eid="EZK 44:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 44:25"/>«سّرّشّدُبّ نَشَ عَ مَسٌ قُرٍ رَ، شَ نَ مُ عَ رَ عَ قِندِ مَ نّ سّنِيّنتَرٍ رَ. كْنْ شَ عَ بَبَ، عَ نفَ، عَ شَ دِ شّمّمَ، شَ نَ مُ عَ رَ فِنّمَ سَ قَشَ، نَ تّمُي عَ نْمَ عَ مَسٌدٍ نٍيٍ تَن قُرٍ رَ. <verse eid="EZK 44:25"/><verse number="26" style="v" sid="EZK 44:26"/>نَ دَنفِ شَنبِ، عَ شَ عَ يّتّ رَ سّنِيّن، عَ قَ مَمّ تِ شِ سٌلٌقٍرٍ بُن مَ. <verse eid="EZK 44:26"/><verse number="27" style="v" sid="EZK 44:27"/>عَ نَ سٌ هْرْ مْبَنشِ تّتّ كُي عَ شَ وَلِ سّنِيّنشِ رَبَدٍ، عَ شَ قْلْ يُنُبِ شَقَرِ سّرّشّ مَ عَ يّتّ بّ. مَرِفِ عَلَتَلَ شُي نَن نَ كِ.»<verse eid="EZK 44:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 44:28"/>«ﭑ تَن نَن قِندِشِ سّرّشّدُبّيٍ كّ رَ. وٌ نَشَ بْشِ قِ عٍ مَ عِسِرَيِلَ بْشِ مَ، بَرِ مَ ﭑ تَن نَن قِندِشِ عٍ كّ رَ. <verse eid="EZK 44:28"/><verse number="29" style="v" sid="EZK 44:29"/>عٍ بَلٌمَ سّرّشّيٍ نَن نَ، عَلْ سَنسِ شْرِ سّرّشّ، يُنُبِ شَقَرِ سّرّشّ، يُنُبِ سْتْي سّرّشّ، نُن سٍ بِرِن نَشٍيٍ قِشِ عَلَ مَ عِسِرَيِلَ بْشِ مَ. <verse eid="EZK 44:29"/><verse number="30" style="v" sid="EZK 44:30"/>عٍ فبٍ نَن سَنسِ بٌفِ سِنفٍ رَ، عَ نُن هَدِيَ بِرِن نَشٍيٍ قِمَ وٌ يَ مَ. عَ مَن لَنمَ وٌ شَ تَامِ قِ عٍ مَ سّرّشّ رَ، عَلَكٌ وٌ شَ دٍنبَيَ شَ بَرَكَ سْتْ. <verse eid="EZK 44:30"/><verse number="31" style="v" sid="EZK 44:31"/>سّرّشّدُبّيٍ مُ لَنمَ عٍ شَ شْنِ نُن شُرُ سٍ سُبٍ يٌ دٌن نَشَن قَشَ عَ يّتّ مَ، شَ نَ مُ عَ رَ، وُلَءِ سُبٍ نَشَن عِبْوشِ.»<verse eid="EZK 44:31"/></para>
  <chapter eid="EZK 44"/>
  <chapter number="45" style="c" sid="EZK 45"/>
  <para style="s">بْشِ سّنِيّنشِ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 45:1"/>«وٌ نَ عِسِرَيِلَ بْشِ عِتَشُن عِسِرَيِلَ بْنسْييٍ مَ تّمُي نَشّ، وٌ شَ يِرٍ ندٍ رَفَتَ عَ شَتِ مَ عَلَتَلَ بّ، عَ شَ قِندِ عَ شَ يِرٍ سّنِيّنشِ رَ. نَ يِرٍ شَ كُيّ لَنمَ نْنفْن يَ وُلُ مْشْحّن نُن سُولِ نَن مَ، عَ شَ فبٌي لَن نْنفْن يَ وُلُ قُ مَ. <verse eid="EZK 45:1"/><verse number="2" style="v" sid="EZK 45:2"/>نَ كُي، يِرٍ فبّتّ شَ مَنِيَ هْرْ مْبَنشِ تِمَ دّننَشّ. نَ شَ كُيّ لَنمَ نْنفْن يَ كّمّ سُولِ نَن مَ، عَ شَ فبٌي قَن لَن نْنفْن يَ كّمّ سُولِ مَ، نُن يِرٍ ندٍ نَشَن شَ تِلِنيِ نْنفْن يَ تٌنفٌ سُولِ لِمَ، نَ شَ لُ نَ رَبِلِنيِ. <verse eid="EZK 45:2"/><verse number="3" style="v" sid="EZK 45:3"/>وٌ شَ عَلَتَلَ شَ هْرْ مْبَنشِ سّنِيّنشِ تِ نَ يِرٍ كُي، نَشَن شَ كُيّ نْنفْن يَ وُلُ مْشْحّن نُن سُولِ لِمَ، عَ عِفبٌي نْنفْن يَ وُلُ قُ. <verse eid="EZK 45:3"/><verse number="4" style="v" sid="EZK 45:4"/>يِرٍ سّنِيّنشِ نَ عَ رَ، نَشَن بَمَ عِسِرَيِلَ بْشِ رَ سّرّشّدُبّيٍ بّ، نَشٍيٍ تِمَ عَلَتَلَ يَ عِ عَ شَ وَلِ رَبَقٍ رَ عَ شَ هْرْ مْبَنشِ كُي. عٍ شَ بَنشِيٍ قَن تِمَ نَا نّ عَلَتَلَ شَ يِرٍ سّنِيّنشِ سّيتِ مَ. <verse eid="EZK 45:4"/><verse number="5" style="v" sid="EZK 45:5"/>نَ بْشِ نَشَن شَ كُيّ نْنفْن يَ وُلُ مْشْحّن نُن سُولِ لِمَ، نَشَن شَ فبٌي نْنفْن يَ وُلُ قُ لِمَ، نَ قِندِ مَ لٍوِ بْنسْي فبٍ نَن نَ، نَشٍيٍ وَلِمَ هْرْ مْبَنشِ كُي. عٍ سَبَتِدٍ نَن نَ كِ.»<verse eid="EZK 45:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 45:6"/>«وٌ شَ يِرٍ فبّتّ مَنِيَ يِرٍ سّنِيّنشِ قّ مَ، نَشَن قِندِ مَ تَا فبٍ رَ. عَ شَ كُيَ نْنفْن يَ وُلُ مْشْحّن نُن سُولِ، عَ عِفبٌي نْنفْن يَ وُلُ سُولِ. عِسِرَيِلَ بْنسْي بِرِن فبٍ نَن نَ كِ.»<verse eid="EZK 45:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 45:7"/>«عِسِرَيِلَ مَنفّ شَ بْشِ لُمَ نَ يِرٍ سّنِيّنشِ نُن تَا شَ بْشِ سّيتِيٍ نَن مَ سٌفٍتٍدٍ نُن سٌفٍفٌرٌدٍ مَبِرِ، هَن عِسِرَيِلَ بْنسْييٍ نَانِنيِيٍ رَ. <verse eid="EZK 45:7"/><verse number="8" style="v" sid="EZK 45:8"/>نَ بْشِ قِندِ مَ عَ فبٍ نَن نَ. عَ هَيِ مُ نَ سْنْن عِسِرَيِلَ بْنسْييٍ تْورْقٍ مَ عٍ شَ بْشِ شَ قٍ رَ. عِسِرَيِلَ بْنسْي بِرِن شَ عٍ فبٍ سْتْ.»<verse eid="EZK 45:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 45:9"/>«وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ؛ ‹عِسِرَيِلَ مَنفّيٍ، نَ شَ وٌ وَ سَ! وٌ نَشَ ﭑ مَ حَمَ تْورْ، وٌ نَشَ قٍ شْرْشْي رَبَ عٍ رَ! وٌ شَ بِرَ سّرِيّ نُن تِنشِنيِ قْشْ رَ! وٌ شَ بَ ﭑ مَ حَمَ كّ مُحَقٍ! وٌ مَرِفِ عَلَتَلَ شُي نَن نَ كِ.›»<verse eid="EZK 45:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 45:10"/>«وٌ شَ مَنِيَسٍيٍ شَ كَمَلِ. وٌ شَ بُسَلِ شَ قِندِ بُسَلِ يَتِ نَن نَ. وٌ شَ قِقَ شَ قِندِ قِقَ يَتِ نَن نَ. <verse eid="EZK 45:10"/><verse number="11" style="v" sid="EZK 45:11"/>نَ قِرِنيِيٍ شَ لَن، هَلِ كٍرٍن تٌ رَوَلِمَ سَنسِ شْرِ مَنِيَقٍ نَن نَ، بٌورٍ رَوَلِ تُرٍ مَنِيَقٍ رَ. نَ بُسَلِ نُن نَ قِقَ، عٍ بِرِن شَ مَنِيَسٍ ندٍ يَ قُ لِ عَ سّرِيّ كِ مَ. <verse eid="EZK 45:11"/><verse number="12" style="v" sid="EZK 45:12"/>كْبِرِ كٌلٍ نَشَن شِلِ ‹سِكِلِ،› نَ شَ لَن مَنِيَسٍ ندٍ يَ مْشْحّن مَ، نَشَن شِلِ ‹فٍرَ.› سِكِلِ تٌنفٌ سٍننِ لَنشِ مَنِيَسٍ ندٍ نَن مَ، نَشَن شِلِ ‹مِنَ.›»<verse eid="EZK 45:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 45:13"/>«وٌ شَ هَدِيَيٍ شَ قِندِ يِ سٍيٍ نَن نَ؛ مّنفِ مَنِيّ شْرِ كٌنبٌ يَ مْشْحّن كُي، وٌ شَ كٌنبٌ يَ سَشَن بَ عَ رَ، قُندٍنيِ مَنِيّ شْرِ كٌنبٌ يَ مْشْحّن كُي، وٌ شَ كٌنبٌ يَ سَشَن بَ عَ رَ، <verse eid="EZK 45:13"/><verse number="14" style="v" sid="EZK 45:14"/>تُرٍ قِقَ كٍرٍن كُي، وٌ شَ لِتِرِ قِرِن بَ عَ رَ قِقَ كٍرٍن قِندِ لِتِرِ كّمّ قِرِن لِتِرِ مْشْحّن نَن نَ، <verse eid="EZK 45:14"/><verse number="15" style="v" sid="EZK 45:15"/>يّشّي كّمّ قِرِن يَ مَ، وٌ شَ يّشّي كٍرٍن بَ عَ رَ عِسِرَيِلَ بْشِ قَنيِ بِرِن مَ. يِيٍ نَن بَمَ سَنسِ شْرِ سّرّشّيٍ رَ، سّرّشّ فَن دَاشِيٍ رَ، شَنُنتٍيَ سّرّشّيٍ رَ حَمَ شُنسَرٍ شَ قٍ رَ. وٌ مَرِفِ عَلَتَلَ شُي نَن نَ كِ. <verse eid="EZK 45:15"/><verse number="16" style="v" sid="EZK 45:16"/>عِسِرَيِلَ حَمَ بِرِن شَ لُ نَ قٍ كُي عٍ شَ مَنفّ مَلِقٍ رَ. <verse eid="EZK 45:16"/><verse number="17" style="v" sid="EZK 45:17"/>مَنفّ لَنمَ عَ شَ سّرّشّ فَن دَاشِيٍ نُن سَنسِ شْرِ نُن مِنسٍ سّرّشّيٍ بَ كِكٍ سَلِيٍ نُن مَلَبُي لْشْي سَلِ تّمُي. عَ مَن شَ يُنُبِ شَقَرِ سّرّشّيٍ، سَنسِ شْرِ هَدِيَيٍ، سّرّشّ فَن دَاشِيٍ، نُن شَنُنتٍيَ سّرّشّيٍ بَ عِسِرَيِلَ بْنسْي شُنسَرٍ شَ قٍ رَ.»<verse eid="EZK 45:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 45:18"/>«وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ، عَ نَشّ، ‹كِكٍ سِنفٍ، شِ سِنفٍ، وٌ شَ تُورَ كٍرٍن بَ سّرّشّ رَ، لَنيُرُ يٌ مُ نَ نَشَن مَ، هْرْ مْبَنشِ رَ سّنِيّنقٍ رَ. <verse eid="EZK 45:18"/><verse number="19" style="v" sid="EZK 45:19"/>سّرّشّدُبّ ندٍ شَ شُرُ سٍ وُلِ تٌنفٌ، نَشَن بَشِ يُنُبِ شَقَرِ شَ قٍ رَ، عَ عَ مَسٌ هْرْ مْبَنشِ سٌدٍ دّ سّيتِيٍ رَ، سّرّشّبَدٍ تُنشُي نَانِ رَ، عَ نُن هْرْ مْبَنشِ تّتّ سٌدٍ دّ سّيتِيٍ رَ. <verse eid="EZK 45:19"/><verse number="20" style="v" sid="EZK 45:20"/>وٌ مَن شَ نَ رَبَ نَ كِكٍ شِ سٌلٌقٍرٍ ندٍ رَ، بَرِ مَ شَ مِشِ ندٍ بَرَ يُنُبِ رَبَ عَ مُ نَشَن كٌلٌن، نَ سّرّشّ هْرْ مْبَنشِ رَ سّنِيّنمَ نّ.›»<verse eid="EZK 45:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 45:21"/>«كِكٍ سِنفٍ، شِ قُ نُن نَانِ ندٍ رَ، وٌ شَ سَيَمَلٍكّ دَنفِ سَلِ رَبَ شِ سٌلٌقٍرٍ بُن مَ. وٌ نَشَ تَامِ لّبِنِتَرٍ يٌ دٌن نَ تّمُي. <verse eid="EZK 45:21"/><verse number="22" style="v" sid="EZK 45:22"/>نَ سَلِ لْشْي، مَنفّ شَ تُورَ كٍرٍن بَ يُنُبِ شَقَرِ سّرّشّ رَ عَ يّتّ بّ عَ نُن حَمَ بّ. <verse eid="EZK 45:22"/><verse number="23" style="v" sid="EZK 45:23"/>نَ سَلِ شِ سٌلٌقٍرٍ بُن مَ لْشْ يٌ لْشْ، مَنفّ شَ تُورَ سٌلٌقٍرٍ بَ سّرّشّ فَن دَاشِ رَ، عَ نُن يّشّي كٌنتٌنيِ سٌلٌقٍرٍ لَنيُرُ يٌ مُ نَ نَشٍيٍ مَ. عَ مَن شَ سِكْتّ كٍرٍن بَ يُنُبِ شَقَرِ سّرّشّ رَ لْشْ يٌ لْشْ نَ شِ سٌلٌقٍرٍ بُن مَ. <verse eid="EZK 45:23"/><verse number="24" style="v" sid="EZK 45:24"/>عَ مَن شَ سَنسِ شْرِ كٌنبٌ يَ سَشَن نُن تُرٍ لِتِرِ يَ نَانِ بَ سّرّشّ رَ نَ تُورَيٍ نُن نَ يّشّي كٌنتٌنيِيٍ بِرِن سّيتِ مَ.»<verse eid="EZK 45:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 45:25"/>«نَ سَلِ وَشَتِ، نَ شِ سٌلٌقٍرٍ بُن مَ، عَ مَن شَ نَ مْولِ بَ سّرّشّ رَ يُنُبِ شَقَرِ سّرّشّيٍ سّيتِ مَ، عَ نُن سّرّشّ فَن دَاشِيٍ سّيتِ مَ، عَ نُن سَنسِ شْرِ نُن تُرٍ هَدِيَيٍ سّيتِ مَ. نَ سَلِ قْلْمَ كِكٍ سٌلٌقٍرٍ، شِ قُ نُن سُولِ ندٍ نَن نَ.»<verse eid="EZK 45:25"/></para>
  <chapter eid="EZK 45"/>
  <chapter number="46" style="c" sid="EZK 46"/>
  <para style="s">سّرّشّيٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 46:1"/>وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ، عَ نَشّ؛ «سٌدٍ دّ شَ نَادّ، نَشَن نَ هْرْ مْبَنشِ تّتّ كُي سٌفٍتٍدٍ بِرِ رَ، نَ بَلَنمَ نّ شِ سٍننِ بُن مَ، كْنْ عَ رَبِمَ مَلَبُ لْشْي نُن كِكٍ نّينّ سَلِ تّمُي نّ. <verse eid="EZK 46:1"/><verse number="2" style="v" sid="EZK 46:2"/>مَنفّ عَ مَسٌ نَا بُنتُنيِ سٌدٍ دّ رَ، عَ تِ مّننِ. سّرّشّدُبّ عَ شَ سّرّشّ فَن دَاشِ نُن عَ شَ شَنُنتٍيَ سّرّشّيٍ بَمَ تّمُي نَشّ، عَ شَ عَ شِنبِ سِن. عَ نَ فّ نَ رَبَدٍ، عَ شَ مِنِ. سٌدٍ دّ نَادّ مُ بَلَنمَ، قٌ نُنمَرٍ. <verse eid="EZK 46:2"/><verse number="3" style="v" sid="EZK 46:3"/>حَمَ عٍ شِنبِ سِنمَ نّ نَا عَلَتَلَ يَ عِ مَلَبُي لْشْي نُن كِكٍ نّينّ سَلِ لْشْييٍ رَ. <verse eid="EZK 46:3"/><verse number="4" style="v" sid="EZK 46:4"/>مَنفّ تَن شَ يّشّي شّمّ سٍننِ نُن يّشّي كٌنتٌنيِ كٍرٍن بَ سّرّشّ رَ مَلَبُي لْشْي. لَنيُرُ يٌ نَشَ لُ عٍ مَ. <verse eid="EZK 46:4"/><verse number="5" style="v" sid="EZK 46:5"/>سَنسِ شْرِ بُسَلِ كٍرٍن شَ بَ هَدِيَ رَ يّشّي كٌنتٌنيِ سّيتِ مَ. عَ مَن شَ سَنسِ شْرِ ندٍ بَ هَدِيَ رَ يّشّي بٌورٍيٍ سّيتِ مَ، عَ وَ مَ شَسَبِ نَشَن شْن، عَ نُن تُرٍ لِتِرِ نَانِ سَنسِ شْرِ بُسَلِ كٍرٍن بّ. <verse eid="EZK 46:5"/><verse number="6" style="v" sid="EZK 46:6"/>كِكٍ نّينّ شِ سِنفٍ، عَ شَ تُورَ كٍرٍن، يّشّي شّمّ سٍننِ، نُن يّشّي كٌنتٌنيِ كٍرٍن نَن بَ سّرّشّ رَ، لَنيُرُ يٌ مُ نَ نَشٍيٍ مَ. <verse eid="EZK 46:6"/><verse number="7" style="v" sid="EZK 46:7"/>عَ شَ سَنسِ شْرِ بُسَلِ كٍرٍن بَ تُورَ بّ، عَ شَ كٍرٍن بَ يّشّي كٌنتٌنيِ بّ، عَ نُن عَ وَ مَ نَشَن شْن يّشّي شّمّ بٌورٍيٍ قَن بّ. عَ شَ تُرٍ لِتِرِ نَانِ سَ بُسَلِ كٍرٍن كٍرٍن سّيتِ مَ. <verse eid="EZK 46:7"/><verse number="8" style="v" sid="EZK 46:8"/>مَنفّ شَ سٌ بُنتُنيِ سٌدٍ دّ رَ، عَ مَن شَ مِنِ مّننِ نَن نَ.»<verse eid="EZK 46:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 46:9"/>«حَمَ نَ قَ تّمُي نَشّ عَلَتَلَ بَتُدٍ سَلِ لْشْييٍ مَ، نَشَن نَ سٌ كْولَ سٌدٍ دّ رَ، عَ شَ مِنِ يِرٍقَنيِ سٌدٍ دّ رَ. نَشَن نَ سٌ يِرٍقَنيِ سٌدٍ دّ رَ، عَ شَ مِنِ كْولَ سٌدٍ دّ رَ. مِشِ يٌ نَشَ مِنِ عَ سٌشِ دّننَشّ رَ. عَ شَ مِنِ نَادّ فبّتّ رَ. <verse eid="EZK 46:9"/><verse number="10" style="v" sid="EZK 46:10"/>مَنفّ قَن شَ لُ عٍ يَ مَ، عٍ سٌ تّمُي نُن عٍ مِنِ تّمُي.»<verse eid="EZK 46:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 46:11"/>«سَلِ لْشْييٍ نُن لْشْي سُفَندِشِيٍ، مَنفّ شَ سَنسِ شْرِ بُسَلِ كٍرٍن بَ تُورَ بّ، عَ شَ كٍرٍن بَ يّشّي كٌنتٌنيِ بّ، عَ نُن عَ وَ مَ نَشَن شَسَبِ شْن يّشّي شّمّ بٌورٍيٍ بّ. عَ شَ تُرٍ لِتِرِ نَانِ سَ بُسَلِ كٍرٍن كٍرٍن سّيتِ مَ. <verse eid="EZK 46:11"/><verse number="12" style="v" sid="EZK 46:12"/>مَنفّ نَ وَ سّرّشّ حَنِفٍشِ بَقٍ عَلَتَلَ بّ، نَشَن قِندِشِ سّرّشّ فَن دَاشِ، شَ نَ مُ عَ رَ، شَنُنتٍيَ سّرّشّ، عَ لَنمَ سٌفٍتٍدٍ نَادّ شَ رَبِ عَ بّ. عَ شَ عَ شَ سّرّشّيٍ بَ عَلْ عَ عَ بَمَ كِ نَشّ مَلَبُي لْشْي. عَ نَ فّ نَ رَ، عَ شَ مِنِ، نَادّ قَ بَلَن.»<verse eid="EZK 46:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 46:13"/>«فّيسّفّ بِرِن وٌ شَ يّشّي حّ كٍرٍن دَاشِ بَ سّرّشّ رَ، لَنيُرُ مُ نَ نَشَن مَ. <verse eid="EZK 46:13"/><verse number="14" style="v" sid="EZK 46:14"/>وٌ شَ سَنسِ شْرِ كٌنبٌ يَ سَشَن نُن تُرٍ لِتِرِ كٍرٍن بَ نَ يّشّي سّيتِ مَ فّيسّفّ بِرِن. يَامَرِ نَ عَ رَ نَشَن مُ كَنَمَ عَبَدَن. <verse eid="EZK 46:14"/><verse number="15" style="v" sid="EZK 46:15"/>نَ كُي فّيسّفّ بِرِن، يّشّي، سَنسِ شْرِ، نُن تُرٍ شَ بَ سّرّشّ فَن دَاشِ رَ.»<verse eid="EZK 46:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 46:16"/>«مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ، عَ نَشّ؛ شَ مَنفّ بْشِ ندٍ قِمَ عَ شَ دِ ندٍ مَ، نَ قِندِ مَ عَ شَ دِ بّ كّ نَن نَ، عَ قَ لُ عَ شَ دِ شَ دِيٍ بّ. <verse eid="EZK 46:16"/><verse number="17" style="v" sid="EZK 46:17"/>كْنْ شَ عَ بْشِ ندٍ قِ عَ شَ كٌنيِ ندٍ مَ، نَ لُمَ نّ نَ يِ رَ هَن شْرّيَ حّ وَشَتِ. نَ تّمُي، نَ بْشِ مَن فبِلٍنمَ مَنفّ نَن مَ. مَنفّ شَ بْشِ قِندِ مَ عَ شَ دِيٍ كّ نَن فبَنسَن نَ. <verse eid="EZK 46:17"/><verse number="18" style="v" sid="EZK 46:18"/>مَنفّ مُ لَنمَ عَ شَ مِشِ يٌ كّ بَ عَ يِ رَ حَمَ يَ مَ، عَ عَ كٍرِ عَ شْنيِ. عَ شَ عَ يّتّ كّ قِ عَ شَ دِيٍ مَ، عَلَكٌ ﭑ مَ حَمَ نَشَ قَ مَكُيَ عٍ شَ بْشِ رَ.»<verse eid="EZK 46:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 46:19"/>نَ تّمُي، نَ شّمّ نَشَ ﭑ شَنِن هْرْ مْبَنشِ تّتّ سٌدٍ دّ رَ، نَشَن نَ كْولَ بِرِ رَ، عَ سّرّشّدُبّيٍ شْنيِ مَسٍن ﭑ بّ. عَ نَشَ يِرٍ ندٍ مَسٍن ﭑ بّ مّننِ سٌفٍفٌرٌدٍ مَبِرِ، <verse eid="EZK 46:19"/><verse number="20" style="v" sid="EZK 46:20"/>عَ عَ قَلَ ﭑ بّ؛ «سّرّشّدُبّيٍ شَ شُرُ سٍ سُبٍ حِنمَ بٍ نّ، نَشَن بَمَ يُنُبِ شَقَرِ سّرّشّيٍ رَ، نُن يُنُبِ سْتْي سّرّشّ رَ. عٍ مَن سَنسِ شْرِ سّرّشّ فَنمَ بٍ نّ، عَلَكٌ نَ سٍ سّنِيّنشِيٍ نَشَ حَمَ تَن نَسّنِيّن.»<verse eid="EZK 46:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 46:21"/>نَ شّمّ نَشَ ﭑ نَمِنِ تّتّ شُنفبٍ كُي، عَ عَ تُنشُن نَانِيٍ بِرِن مَسٍن ﭑ بّ. تّتّ فبّتّيٍ نُ نَ نَ تُنشُن نَانِ بِرِن نَ، <verse eid="EZK 46:21"/><verse number="22" style="v" sid="EZK 46:22"/>نَشٍيٍ شَ كُيّ نْنفْن يَ تٌنفٌ نَانِ لِمَ، عٍ عِفبٌي نْنفْن يَ تٌنفٌ سَشَن. نَ تّتّ نَانِ بِرِن نُ لَن. <verse eid="EZK 46:22"/><verse number="23" style="v" sid="EZK 46:23"/>تٍيبِلِ فّمّ دَاشِيٍ نُ قَتُشِ نَ تّتّيٍ شّلّيٍ مَ. يِرٍيٍ نُ نَ نَ تٍيبِلِيٍ بُن مَ تّ نُ شُرُ مَ دّننَشّ. <verse eid="EZK 46:23"/><verse number="24" style="v" sid="EZK 46:24"/>نَ شّمّ نَشَ عَ قَلَ ﭑ بّ، عَ نَشّ، «كُرِ نَن يَ، سّرّشّدُبّيٍ حَمَ شَ سّرّشّيٍ حِنمَ دّننَشّ.»<verse eid="EZK 46:24"/></para>
  <chapter eid="EZK 46"/>
  <chapter number="47" style="c" sid="EZK 47"/>
  <para style="s">شُرٍ نَشَن مِنِمَ هْرْ مْبَنشِ يِرٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 47:1"/>نَ شّمّ نَشَ ﭑ نَفبِلٍن هْرْ مْبَنشِ سٌدٍ دّ رَ سٌفٍتٍدٍ مَبِرِ، بَنشِ يَ نُ رَقِندِشِ دّننَشّ مَ. مّننِ ﭑ نَشَ يٍ تٌ مِنِ رَ. نَ يٍ نُ كٍلِمَ سّرّشّبَدٍ كْولَ مَبِرِ نّ. <verse eid="EZK 47:1"/><verse number="2" style="v" sid="EZK 47:2"/>نَ شّمّ نَشَ ﭑ نَمِنِ كْولَ سٌدٍ دّ رَ، مُشُ تّتّ مَبِلِن تَندٍ بِرِ رَ، هَن تّتّ سٌدٍ دّ رَ سٌفٍتٍدٍ مَبِرِ. يٍ نُ شَلّمَ سٌدٍ دّ يِرٍقَنيِ بِرِ رَ.<verse eid="EZK 47:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 47:3"/>نَ شّمّ تٌ مِنِ سٌفٍتٍدٍ بِرِ رَ، لُوتِ نُ نَ عَ يِ رَ، عَ نَشَ نْنفْن يَ وُلُ كٍرٍن مَنِيَ مّننِ. عَ قَ ﭑ نَفِرِ يٍ مَ، نَشَن نُ بَرَ تٍ هَن ﭑ سَن كْنيِ. <verse eid="EZK 47:3"/><verse number="4" style="v" sid="EZK 47:4"/>عَ مَن نَشَ نْنفْن يَ وُلُ كٍرٍن مَنِيَ، عَ ﭑ نَفِرِ يٍ مَ، نَشَن نُ بَرَ تٍ هَن ﭑ شِنبِ. عَ مَن نَشَ نْنفْن يَ وُلُ كٍرٍن مَنِيَ، عَ ﭑ نَفِرِ يٍ مَ، نَشَن نُ بَرَ تٍ هَن ﭑ تَفِ. <verse eid="EZK 47:4"/><verse number="5" style="v" sid="EZK 47:5"/>عَ تٌ نْنفْن يَ وُلُ كٍرٍن فبّتّ مَنِيَ، نَ يٍ نُ بَرَ قِندِ شُرٍ رَ مِشِ مُ نُ نْمَ نَشَن عِفِرِدٍ، قٌ عَ شَ يٍ مَسَ. <verse eid="EZK 47:5"/><verse number="6" style="v" sid="EZK 47:6"/>نَ تّمُي عَ نَشَ ﭑ مَشْرِن، «عَدَ مَدِ، عِ بَرَ يِ قٍ تٌ عَ قَنيِ رَ؟ عَ نَشَ ﭑ شَنِن شُرٍ دّ رَ. <verse eid="EZK 47:6"/><verse number="7" style="v" sid="EZK 47:7"/>مّننِ ﭑ نَشَ وُرِ بِلِ فبٍفبٍ تٌ، عٍ تِشِ شُرٍ دّ قِرِن نَ.» <verse eid="EZK 47:7"/><verse number="8" style="v" sid="EZK 47:8"/>نَ شّمّ نَشَ عَ قَلَ ﭑ بّ، «يِ شُرٍ شُن تِشِ سٌفٍتٍدٍ نَن نَ، عَ سَ فٌرٌ يُرُدّن قَرّ مَ، عَ سَ سِن بَا مَ، نَشَن يٍ مُ قَنشِ. شُرٍ يٍ نَ بَا لِ دّننَشّ، بَا يٍ قَنمَ نّ عَ قَنيِ رَ، <verse eid="EZK 47:8"/><verse number="9" style="v" sid="EZK 47:9"/>يّشّيٍ قَ بَلٌ. يّشّ وُيَمَ نّ مّننِ نَ شُرٍ يٍ شَ قٍ رَ، نَشَن بَا يٍ قَنمَ. نَ شُرٍ يٍ نَ لُ دّننَشّ، نِمَسٍيٍ بَلٌمَ نّ عَ قَنيِ رَ. <verse eid="EZK 47:9"/><verse number="10" style="v" sid="EZK 47:10"/>كٍلِ عٍن فٍدِ مَ، هَن عَ سَ دْشْ عٍفٍلَيِمِ رَ، يّشّسُشُييٍ دِنمَ نّ مّننِ بِرِن نَ، عٍ عٍ شَ يّلّيٍ سَ. يّشّ مْولِ بِرِن نَن سُشُمَ نَا، عَلْ نَشٍيٍ تٌمَ بَا شُنفبٍ مَ. <verse eid="EZK 47:10"/><verse number="11" style="v" sid="EZK 47:11"/>يٍ يِرٍ ندٍيٍ مُ قَنمَ، عَلَكٌ قْشْي شَ لُ نَا. <verse eid="EZK 47:11"/><verse number="12" style="v" sid="EZK 47:12"/>وُرِ بِلِ مْولِ بِرِن نَن بُلَمَ نَ شُرٍ دّ قِرِنيِ مَ. عٍ بُرّشّ مُ لِسِمَ، عٍ بٌفِ قَن. كِكٍ يٌ كِكٍ عٍ بٌفِمَ نّ عَ قَنيِ رَ نَ شُرٍ يٍ شَ قٍ رَ نَشَن كٍلِمَ هْرْ مْبَنشِ كُي. عٍ بٌفِ قِندِ مَ بَلٌي نَن نَ، عٍ بُرّشّ قِندِ سٍرِ رَ.»<verse eid="EZK 47:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 47:13"/>«وٌ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ، عَ نَشّ؛ وٌ شَ يِ بْشِ عِتَشُن عِسِرَيِلَ بْنسْي قُ نُن قِرِنيِيٍ مَ، عَ شَ قِندِ عٍ كّ رَ. ﭑ شَ نَ نَانِنيِيٍ مَسٍن وٌ بّ. يُسُقُ بْنسْي بْشِ عِتَشُنشِ قِرِن نَن سْتْمَ، <verse eid="EZK 47:13"/><verse number="14" style="v" sid="EZK 47:14"/>نَشٍيٍ بِرِن لَن. عِسِرَيِلَ بْشِ قِندِ مَ وٌ بِرِن كّ نَن نَ، عَلْ ﭑ نَ ﭑ كَلِ وٌ بٍنبَيٍ بّ كِ نَشّ.»<verse eid="EZK 47:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 47:15"/>بْشِ نَانِنيِيٍ نَن يَ؛ عَ كْولَ سّيتِ قْلْمَ بَا شُنفبٍ نَن مَ، عَ سِفَ شٍتٍلٌن كِرَ رَ، عَ دَنفِ لٍبٌ شَمَتَ رَ، تِسٍدَدِ، <verse eid="EZK 47:15"/><verse number="16" style="v" sid="EZK 47:16"/>بٍرٌتَ، سِبِرَيِمَ، نَشَن نَ دَ مَسِ نُن شَمَتَ تَفِ، هَن عَ سَ دْشْ شَسٍرِ تِكٌنِ رَ، نَشَن نَ شَوُرَن نَانِنيِ رَ. <verse eid="EZK 47:16"/><verse number="17" style="v" sid="EZK 47:17"/>نَ كُي، نَ نَانِنيِ كٍلِمَ بَا شُنفبٍ نَن مَ، عَ سِفَ هَن شَسَرِ عٍنَن، نَشَن نَ دَ مَسِ كْولَ مَبِرِ. تِسَقٌنِ بْشِ نَ كْولَ نَن مَ. عِسِرَيِلَ نَانِنيِ نَن نَ كِ كْولَ مَبِرِ.<verse eid="EZK 47:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 47:18"/>عِسِرَيِلَ بْشِ نَانِنيِ سٌفٍتٍدٍ مَبِرِ كٍلِمَ دَ مَسِ نّ، عَ سِفَ شَوُرَن. يُرُدّن شُرٍ قِندِشِ نَانِنيِ نَن نَ فَلَدِ بْشِ نُن عِسِرَيِلَ بْشِ تَفِ، عَ سَ بَا لِ سٌفٍتٍدٍ بِرِ رَ. عِسِرَيِلَ نَانِنيِ نَن نَ كِ سٌفٍتٍدٍ مَبِرِ.<verse eid="EZK 47:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 47:19"/>عِسِرَيِلَ بْشِ نَانِنيِ يِرٍقَنيِ مَبِرِ كٍلِمَ تَمَرِ، عَ سِفَ هَن مٍرِبَ كَدٍ سِ، هَن مِسِرَ شُرٍ نُن بَا شُنفبٍ مَ. عِسِرَيِلَ نَانِنيِ نَن نَ كِ يِرٍقَنيِ مَبِرِ.<verse eid="EZK 47:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 47:20"/>عِسِرَيِلَ بْشِ نَانِنيِ سٌفٍفٌرٌدٍ مَبِرِ كٍلِمَ بَا شُنفبٍ نَن مَ، هَن لٍبٌ شَمَتَ لٌنفٌرِ. عِسِرَيِلَ نَانِنيِ نَن نَ كِ سٌفٍفٌرٌدٍ مَبِرِ.<verse eid="EZK 47:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 47:21"/>«وٌ شَ يِ بْشِ عِتَشُن وٌ بٌرٍ مَ عِسِرَيِلَ بْنسْييٍ كِ نَن مَ. <verse eid="EZK 47:21"/><verse number="22" style="v" sid="EZK 47:22"/>عَ شَ قِندِ وٌ كّ رَ، عَ نُن مِشِيٍ كّ رَ نَشٍيٍ سَبَتِشِ وٌ شْنيِ عَ نُن عٍ شَ دِيٍ. وٌ شَ عٍ تٌنفٌ عَلْ عِسِرَيِلَ لَسِرِ، نَشٍيٍ كّ سْتْمَ عِسِرَيِلَ بْشِ مَ وٌ يَ مَ. <verse eid="EZK 47:22"/><verse number="23" style="v" sid="EZK 47:23"/>نَ شْحّيٍ سَبَتِشِ بْنسْي نَشَن يَ مَ، عٍ شَ عٍ كّ سْتْ مّننِ نّ. وٌ مَرِفِ عَلَتَلَ شُي نَن نَ كِ.»<verse eid="EZK 47:23"/></para>
  <chapter eid="EZK 47"/>
  <chapter number="48" style="c" sid="EZK 48"/>
  <para style="s">عِسِرَيِلَ بْنسْييٍ نَانِنيِيٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 48:1"/>«بْنسْييٍ شِلِيٍ نَن يَ؛ دَنَ بْنسْي شَ بْشِ نَ كْولَ مَبِرِ نّ شٍتٍلٌن كِرَ رَ، كٍلِقٍ لٍبٌ شَمَتَ، عَ سَ دْشْ شَسَرِ عٍنَن رَ، نَشَن نَ دَ مَسِ نُن شَمَتَ نَانِنيِ رَ كْولَ مَبِرِ. عَ كٍلِ نَانِنيِ رَ نَشَن نَ سٌفٍتٍدٍ مَبِرِ هَن بَا شُنفبٍ.»<verse eid="EZK 48:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="EZK 48:2"/>«عَسٍرِ بْنسْي شَ بْشِ نَ دَنَ بْنسْي شَ بْشِ نَانِنيِ سّيتِ نَن نَ، كٍلِقٍ سٌفٍتٍدٍ نَانِنيِ مَ هَن سٌفٍفٌرٌدٍ نَانِنيِ.»<verse eid="EZK 48:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 48:3"/>«نَقَتَلِ بْنسْي شَ بْشِ نَ عَسٍرِ بْنسْي شَ بْشِ نَانِنيِ سّيتِ نَن نَ، كٍلِقٍ سٌفٍتٍدٍ هَن سٌفٍفٌرٌدٍ.»<verse eid="EZK 48:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 48:4"/>«مَنَسِ بْنسْي شَ بْشِ نَ نَقَتَلِ بْنسْي شَ بْشِ نَانِنيِ سّيتِ نَن نَ، كٍلِقٍ سٌفٍتٍدٍ هَن سٌفٍفٌرٌدٍ.»<verse eid="EZK 48:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 48:5"/>«عٍقِرَ مِ بْنسْي شَ بْشِ نَ مَنَسِ بْنسْي شَ بْشِ نَانِنيِ سّيتِ نَن نَ، كٍلِقٍ سٌفٍتٍدٍ هَن سٌفٍفٌرٌدٍ.»<verse eid="EZK 48:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 48:6"/>«رُبٍن بْنسْي شَ بْشِ نَ عٍقِرَ مِ بْنسْي شَ بْشِ نَانِنيِ سّيتِ نَن نَ، كٍلِقٍ سٌفٍتٍدٍ هَن سٌفٍفٌرٌدٍ.»<verse eid="EZK 48:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 48:7"/>«يُدَ بْنسْي شَ بْشِ نَ رُبٍن بْنسْي شَ بْشِ نَانِنيِ سّيتِ نَن نَ، كٍلِقٍ سٌفٍتٍدٍ هَن سٌفٍفٌرٌدٍ.»<verse eid="EZK 48:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 48:8"/>«يِرٍ سّنِيّنشِ نَ يُدَ بْنسْي شَ بْشِ نَانِنيِ سّيتِ نَن نَ، كٍلِقٍ سٌفٍتٍدٍ هَن سٌفٍفٌرٌدٍ. نَ بْشِ شَ فبٌي نْنفْن يَ وُلُ مْشْحّن نُن سُولِ، عَ كُيَ كٍلِقٍ سٌفٍتٍدٍ نَانِنيِ هَن سٌفٍفٌرٌدٍ نَانِنيِ. عَلَتَلَ شَ هْرْ مْبَنشِ تِشِ عَ تَفِ.»<verse eid="EZK 48:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 48:9"/>«نَ يِرٍ سّنِيّنشِ نَشَن سَمَ عَ شَتِ مَ عَلَتَلَ بّ، عَ شَ كُيّ لَنمَ نْنفْن يَ وُلُ مْشْحّن نُن سُولِ نَن مَ، عَ شَ فبٌي لَنمَ نْنفْن يَ وُلُ قُ نَن مَ. <verse eid="EZK 48:9"/><verse number="10" style="v" sid="EZK 48:10"/>سّرّشّدُبّيٍ لُمَ نَ يِرٍ سّنِيّنشِ نَن كُي، نَشَن شَ كُيّ لَنمَ نْنفْن يَ وُلُ مْشْحّن نُن سُولِ مَ كْولَ بِرِ رَ، عَ شَ فبٌي نْنفْن يَ وُلُ قُ سٌفٍفٌرٌدٍ بِرِ رَ، عَ شَ فبٌي سٌفٍتٍدٍ بِرِ رَ نْنفْن يَ وُلُ قُ، عَ شَ كُيّ يِرٍقَنيِ بِرِ رَ نْنفْن يَ وُلُ مْشْحّن نُن سُولِ. عَلَتَلَ شَ هْرْ مْبَنشِ تِمَ نَ يِرٍ سّنِيّنشِ نَن تَفِ. <verse eid="EZK 48:10"/><verse number="11" style="v" sid="EZK 48:11"/>مّننِ قِندِ مَ سّرّشّدُبّيٍ نَن فبٍ رَ، نَشٍيٍ سُفَندِشِ سَدْكِ بْنسْي يَ مَ. عٍ نُ ﭑ نَبَتُمَ عَ قَنيِ رَ، عٍ مُ ﭑ يَنقَ عَلْ لٍوِ بْنسْي مِشِ فبّتّ نَشٍيٍ عٍ مَكُيَ ﭑ نَ عِسِرَيِلَكَيٍ مُرُتَ تّمُي. <verse eid="EZK 48:11"/><verse number="12" style="v" sid="EZK 48:12"/>نَ يِرٍ سّنِيّنشِ سَشِ عَ شَتِ مَ عٍ تَن نَن بّ لٍوِ بْنسْي شَ يِرٍ سّيتِ مَ.»<verse eid="EZK 48:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 48:13"/>«نَ يِرٍ شَ كُيّ نْنفْن يَ وُلُ مْشْحّن نُن سُولِ، عَ شَ فبٌي نْنفْن يَ وُلُ قُ، سّرّشّدُبّيٍ شَ بْشِ. <verse eid="EZK 48:13"/><verse number="14" style="v" sid="EZK 48:14"/>عَ مُ لَنمَ عٍ شَ نَ بْشِ مَتِ، عَ مُ لَنمَ عٍ شَ نَ مَسَرَ بْشِ فبّتّ رَ، عَ مُ لَنمَ عٍ شَ نَ قِ مِشِ يٌ مَ، بَرِ مَ بْشِ هَفِفّ نَ عَ رَ نَشَن سّنِيّنشِ عَلَتَلَ بّ.»<verse eid="EZK 48:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 48:15"/>«بْشِ نَشَن لُشِ، نَشَن شَ فبٌي لَنمَ نْنفْن يَ وُلُ سُولِ مَ، عَ شَ كُيّ نْنفْن يَ وُلُ مْشْحّن نُن سُولِ، نَ قِندِ مَ تَا فبٍ نَن نَ بَنشِيٍ نُن مّرّ لُمَ دّننَشّ. تَا يَتِ لُمَ نّ نَ بْشِ تَفِ. <verse eid="EZK 48:15"/><verse number="16" style="v" sid="EZK 48:16"/>نَ بْشِ سّيتِ نَانِيٍ بِرِن لَن نْنفْن يَ وُلُ نَانِ يَ كّمّ سُولِ نَن مَ، عَ كْولَ سّيتِ، عَ يِرٍقَنيِ سّيتِ، عَ سٌفٍتٍدٍ سّيتِ، نُن عَ سٌفٍفٌرٌدٍ سّيتِ. <verse eid="EZK 48:16"/><verse number="17" style="v" sid="EZK 48:17"/>نَ بْشِ نَشَن لُمَ تَا سّيتِ رَ، نَ بْشِ سّيتِ نَانِيٍ قَن بِرِن لَن نْنفْن يَ كّمّ قِرِن يَ تٌنفٌ سُولِ نَن مَ، عَ كْولَ سّيتِ، عَ يِرٍقَنيِ سّيتِ، عَ سٌفٍتٍدٍ سّيتِ، نُن عَ سٌفٍفٌرٌدٍ سّيتِ. <verse eid="EZK 48:17"/><verse number="18" style="v" sid="EZK 48:18"/>بْشِ دْنشْي نَشَن لُمَ بْشِ سّنِيّنشِ شَ كُيّ سّيتِ قِرِنيِ رَ، نَشَن نْنفْن يَ وُلُ قُ لِمَ عَ سٌفٍتٍدٍ نُن عَ سٌفٍفٌرٌدٍ، نَ قِندِ مَ مّرّ نَن نَ تَا وَلِكّيٍ بّ، <verse eid="EZK 48:18"/><verse number="19" style="v" sid="EZK 48:19"/>نَشٍيٍ كٍلِمَ عِسِرَيِلَ بْنسْييٍ بِرِن مَ. <verse eid="EZK 48:19"/><verse number="20" style="v" sid="EZK 48:20"/>نَ بْشِ بِرِن شَ كُيّ لَنمَ نْنفْن يَ وُلُ مْشْحّن يَ وُلُ سُولِ نَن مَ، عَ شَ فبٌي قَن لَنمَ نْنفْن يَ وُلُ مْشْحّن يَ وُلُ سُولِ نَن مَ. نَ بِرِن سَشِ عَ شَتِ نَن مَ تَا نُن هْرْ مْبَنشِ شَ قٍ رَ.»<verse eid="EZK 48:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 48:21"/>«بْشِ نَشَن نَ يِرٍ سّنِيّنشِ نُن تَا سّيتِ رَ، نَ قِندِ مَ مَنفّ نَن فبٍ رَ. عَ كٍلِمَ بْشِ سّنِيّنشِ نّ، نَشَن كُيَ نْنفْن يَ وُلُ مْشْحّن نُن سُولِ سٌفٍتٍدٍ مَبِرِ، عَ سِفَ هَن عِسِرَيِلَ نَانِنيِ سٌفٍتٍدٍ مَبِرِ. عَ مَن كٍلِمَ بْشِ سّنِيّنشِ نّ نَشَن كُيَ نْنفْن يَ وُلُ مْشْحّن نُن سُولِ سٌفٍفٌرٌدٍ مَبِرِ، عَ سِفَ هَن عِسِرَيِلَ نَانِنيِ سٌفٍتٍدٍ مَبِرِ. نَ بْشِ لُمَ عِسِرَيِلَ بْنسْييٍ شَ بْشِ سّيتِ نَن نَ. يِرٍ سّنِيّنشِ نُن هْرْ مْبَنشِ لُمَ نَ بْشِ نَن تَفِ. <verse eid="EZK 48:21"/><verse number="22" style="v" sid="EZK 48:22"/>نَ كُي، تَا يِرٍ نُن لٍوِ بْنسْي شَ بْشِ لُمَ مَنفّ شَ بْشِ نَن تَفِ، نَشَن نَ يُدَ بْنسْي نُن بُنيَمِن بْنسْي شَ نَانِنيِيٍ سّيتِ رَ.»<verse eid="EZK 48:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 48:23"/>«بُنيَمِن بْنسْي شَ بْشِ نَ يُدَ بْنسْي شَ بْشِ نَانِنيِ سّيتِ نَن نَ، كٍلِقٍ سٌفٍتٍدٍ هَن سٌفٍفٌرٌدٍ.»<verse eid="EZK 48:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 48:24"/>«سِمٍيْن بْنسْي شَ بْشِ نَ بُنيَمِن بْنسْي شَ بْشِ نَانِنيِ سّيتِ نَن نَ، كٍلِقٍ سٌفٍتٍدٍ هَن سٌفٍفٌرٌدٍ.»<verse eid="EZK 48:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 48:25"/>«عِسَكَرِ بْنسْي شَ بْشِ نَ سِمٍيْن بْنسْي شَ بْشِ نَانِنيِ سّيتِ نَن نَ، كٍلِقٍ سٌفٍتٍدٍ هَن سٌفٍفٌرٌدٍ.»<verse eid="EZK 48:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="EZK 48:26"/>«سَبُلٌن بْنسْي شَ بْشِ نَ عِسَكَرِ بْنسْي شَ بْشِ نَانِنيِ سّيتِ نَن نَ، كٍلِقٍ سٌفٍتٍدٍ هَن سٌفٍفٌرٌدٍ.»<verse eid="EZK 48:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EZK 48:27"/>«فَدِ بْنسْي شَ بْشِ نَ سَبُلٌن بْنسْي شَ بْشِ نَانِنيِ سّيتِ نَن نَ، كٍلِقٍ سٌفٍتٍدٍ هَن سٌفٍفٌرٌدٍ.»<verse eid="EZK 48:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 48:28"/>«فَدِ بْنسْي شَ بْشِ شَ نَانِنيِ يِرٍقَنيِ مَبِرِ، عَ كٍلِمَ تَمَرِ نّ هَن مٍرِبَ كَدٍ سِ شَ يٍ يِرٍ، مِسِرَ شُرٍ فٌرٌ مَ بَا شُنفبٍ مَ دّننَشّ.»<verse eid="EZK 48:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="EZK 48:29"/>«بْشِ نَن يِ كِ، وٌ قَمَ نَشَن عِتَشُندٍ عِسِرَيِلَ بْنسْييٍ مَ، عَ شَ قِندِ عٍ كّ رَ. وٌ مَرِفِ عَلَتَلَ شُي نَن نَ كِ.»<verse eid="EZK 48:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 48:30"/>«تَا سٌدٍ دّيٍ شِلِيٍ نَن يِ كِ؛ نَادّ نَشٍيٍ نَ تَا كْولَ سّيتِ، نَشَن كُيَ نْنفْن يَ وُلُ نَانِ كّمّ سُولِ، <verse eid="EZK 48:30"/><verse number="31" style="v" sid="EZK 48:31"/>عِسِرَيِلَ بْنسْي رُبٍن، يُدَ، نُن لٍوِ شِلِيٍ نَن سَمَ عٍ شُن مَ.»<verse eid="EZK 48:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="EZK 48:32"/>«نَادّ نَشٍيٍ نَ تَا سٌفٍتٍدٍ سّيتِ، نَشَن كُيَ نْنفْن يَ وُلُ نَانِ كّمّ سُولِ، عِسِرَيِلَ بْنسْي يُسُقُ، بُنيَمِن، نُن دَنَ شِلِيٍ نَن سَمَ نَ نَادّ سَشَنيِ شُن مَ.»<verse eid="EZK 48:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EZK 48:33"/>«نَادّ نَشٍيٍ نَ تَا يِرٍقَنيِ سّيتِ، نَشَن كُيَ نْنفْن يَ وُلُ نَانِ كّمّ سُولِ، عِسِرَيِلَ بْنسْي سِمٍيْن، عِسَكَرِ، نُن سَبُلٌن شِلِيٍ نَن سَمَ نَ نَادّ سَشَنيِ شُن مَ.»<verse eid="EZK 48:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="EZK 48:34"/>«نَادّ نَشٍيٍ نَ تَا سٌفٍفٌرٌدٍ سّيتِ، نَشَن كُيَ نْنفْن يَ وُلُ نَانِ كّمّ سُولِ، عِسِرَيِلَ بْنسْي فَدِ، عَسٍرِ، نُن نَقَتَلِ شِلِيٍ نَن سَمَ نَ نَادّ سَشَنيِ شُن مَ.»<verse eid="EZK 48:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="EZK 48:35"/>«تَا رَبِلِنيِ لَنمَ نْنفْن يَ وُلُ قُ نُن سٌلٌمَسَشَن نَن مَ. قْلْقٍ نَ لْشْي مَ، نَ تَا شِلِ قَلَمَ نّ، ‹عَلَتَلَ نَ مّننِ.›»<verse eid="EZK 48:35"/></para>
  <chapter eid="EZK 48"/>
</usx>
