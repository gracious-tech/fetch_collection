<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1KI" style="id"/>
  <para style="h">عِسِرَيِلَ مَنفّيٍ ١</para>
  <para style="toc1">عِسِرَيِلَ مَنفّيٍ شَ تَرُشُي سّنِيّنشِ سِنفٍ</para>
  <para style="toc2">عِسِرَيِلَ مَنفّيٍ ١</para>
  <para style="toc3">مَن١</para>
  <para style="mt">عِسِرَيِلَ مَنفّيٍ شَ تَرُشُي سّنِيّنشِ سِنفٍ</para>
  <para style="imt1">مَسٍنيِ ندٍ يِ كِتَابُي شَ قٍ رَ</para>
  <para style="ip">يِ كِتَابُي قِندِشِ عِسِرَيِلَ مَنفّيٍ شَ تَرُشُي سِنفٍ نَن نَ. عَننَبِ سَمُوٍلِ شَ كِتَابُي رَحْنمَ مَنفّ دَوُدَ شَ تَرُشُي نَن نَ. يِ كِتَابُي قْلْمَ بٌورٍ رَحْنشِ دّننَشّ.</para>
  <para style="ip">عَلَتَلَ نَن دَوُدَ تِشِ مَنفّ رَ عَ شَ حَمَ عِسِرَيِلَ شُن مَ. عَ شَ حَمَ نُ رَقَن عَ مَ، عَ نُ وَ مَ عٍ شَ بِرَ عَ شَ سّرِيّ قْشْ رَ عَلَكٌ دُنِحَ شَ نَ مِسَالِ تٌ. دَوُدَ تٌ تِن بِرَدٍ عَلَ قْشْ رَ، عَلَ نَشَ لَايِدِ تٌنفٌ عَ بْنسْي بّ، عٍ شَ لُ كِبَنيِ كُي عَبَدَن.</para>
  <para style="ip">دَوُدَ تٌ لَاشِرَ، عَ شَ دِ سُلٍمَنِ نَشَ تِ عِسِرَيِلَ مَنفّ رَ. عَلَ نَشَ بَرَكَ سَ عَ شَ قٍ مَ عَ قَنيِ رَ، عَ قِندِ مَنفّ لْننِشِ بَننَ رَ. عَ نَشَ عَلَتَلَ شَ هْرْ مْبَنشِ تِ دَرِ سَلَمُ، حَمَ نُ سّرّشّيٍ بَمَ دّننَشّ. كْنْ عَ مُ بُ، عَ نَشَ مَكُيَ قْلْ عَلَ شَ سّرِيّ رَ، عَ قَ كُيٍ بَتُي مَسُنبُ عَلَ بَتُي رَ.</para>
  <para style="ip">مَنفّ سُلٍمَنِ تٌ فبِلٍن عَلَ شَ سّرِيّ قْشْ رَ، عَلَتَلَ نَشَ عَ شَ تِنشِنيِ مَسٍن، عَ قَ دَوُدَ بْنسْي شُرُ قْلْ. عَ نَشَ عَ لُ عٍ شَ عٍ حّرّ كِرَ حَاشِ شْن مَ، كْنْ عَ نَشَ عَ مَسٍن عٍ بّ نَ كِرَ حَاشِ عٍ شُن تِمَ دّننَشّ رَ. مَنفّ ندٍ بَرَ نَ قَهَامُ، عَ قَ فبِلٍن عَلَتَلَ شَ كِرَ مَ، كْنْ بٌورٍ مُ نَ مّ، عَ شَ قٍ قَ رَحْن فبَلٌي مَ.</para>
  <para style="ip">مَنفّ دَوُدَ شَ وَشَتِ عِسِرَيِلَكَيٍ نُ عِتَشُنشِ بْنسْي قُ نُن قِرِن نَن نَ، نَشٍيٍ قَتَنشِ عَننَبِ يَشُبَ شَ دِ قُ نُن قِرِنيِ رَ. عَلَ نُ بَرَ عَننَبِ يَشُبَ شِلِ مَسَرَ «عِسِرَيِلَ» رَ، عَ كَنَان بْشِ قِ عٍ مَ كّ رَ، عٍ شِلِ نَشَ قَلَ «عِسِرَيِلَكَيٍ.» كْنْ عَلَتَلَ تٌ دَوُدَ بْنسْي حَشَنكَتَ عٍ شَ قِلَنكَقُيحَ شَ قٍ رَ، عَ نَشَ بْنسْي قُ بَ عٍ شَ يَامَرِ بُن مَ، بْنسْي قِرِن فبَنسَن نَشَ لُ عٍ يِ رَ.</para>
  <para style="ip">نَ بْنسْي قِرِنيِ قِندِشِ يُدَيَ نُن بُنيَمِن بْنسْي نَن نَ. يُدَيَ تٌ شُنفبٌ بٌورٍ بّ، عٍ بِرِن شِلِ نَشَ سَ «يُدَيَ.» نَ بْنسْي قُ نَشَن بَشِ دَوُدَ بْنسْي شَ يَامَرِ بُن مَ، عٍ قَن شِلِ نَشَ سَ نَ وَشَتِ «عِسِرَيِلَ.» مَنفّيَ قِرِن نُ نَ نَ تّمُي، يُدَيَ نُ نَ يِرٍقَنيِ مَ، عِسِرَيِلَ نُ نَ كْولَ مَ.</para>
  <para style="ip">يُدَيَ مَنفّيٍ كَتَ نّ عٍ شَ حَمَ شَ بِرَ عَلَ شَ سّرِيّ قْشْ رَ. كْنْ عِسِرَيِلَ مَنفّيٍ مُ تِن نَ رَ، عٍ قَ كُيٍيٍ تِ عٍ شَ مِشِيٍ بّ عٍ شَ نَ بَتُ. مَنفّ يٍرٌبٌوَ مِ نَشَ نَ وَلِ كٌبِ قْلْ بٍتٍلِ نُن دَنَ، عَ قَ يٍنسٍن بْشِ بِرِن مَ. مَنفّ عَشَبِ نَشَ سَمَرِ قِندِ عِسِرَيِلَ مَنفَتَا رَ. عٍ نَ بِرِن نَبَ نّ عَلَكٌ حَمَ نَشَ لُ سِفَ رَ دَرِ سَلَمُ سّرّشّيٍ بَدٍ عَلْ عَلَتَلَ عَ يَمَرِشِ كِ نَشّ.</para>
  <para style="ip">مَنفّ عَكَبُ شَ وَشَتِ، عَلَ نَشَ نَمِحْنمّ ندٍ رَكٍلِ نَشَن شِلِ عَننَبِ عٍلِيَ. عَ شَ قٍ مُ نُ رَقَن مَنفّ مَ قٍقٍ مَ، كْنْ عَلَ نَشَ عَ مَلِ عَ شَ كَابَنَكٌي بٍلٍبٍلٍيٍ رَبَ عِسِرَيِلَكَيٍ يَ مَ، عَلَكٌ عٍ شَ فبِلٍن عَلَ وَشْنقٍ مَ. نَ كُي عَلَتَلَ مُ تِن عَ شَ حَمَ رَبٌلٌدٍ هَلِ عٍ تٌ نُ بِرَ مَ يُنُبِيٍ قْشْ رَ. عَ نَشَ قٍ بِرِن نَبَ عَلَكٌ عٍ مَن شَ تِن لُدٍ عَ شَ مَنفّيَ بُن مَ، عٍ قَ عَ سَفٌ رَبَ.</para>
  <para style="ip">عَلَ شَ قٍ رَبَ كِ نَن نَ كِ. عَ عَ شَ حَمَ حَشَنكَتَمَ عَلَكٌ عٍ شَ فبِلٍن عَ مَ. عَ هِننّمَ عٍ رَ تّمُي بِرِن، هَلِ عٍ نَ كِرَ حَاشِ شْن مَ عَلَكٌ عَ رَحْنيِ عٍ شَ كِسِ سْتْ. عَ نَ قٍ مْولِ قَن نَبَمَ تٌ مِشِيٍ رَ. عَلَ شَ وٌن مَلِ نَ قَهَامُدٍ. عَمِنَ.</para>
  <para style="imte">عِسِرَيِلَ مَنفّيٍ شَ تَرُشُي سّنِيّنشِ سِنفٍ</para>
  <chapter number="1" style="c" sid="1KI 1"/>
  <para style="s">دَوُدَ شَ مَنفّيَ رَحْنيِ</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 1:1"/>مَنفّ دَوُدَ شَ سِمَيَ نُ بَرَ عَ عِكُيَ. شِنبٍلِ نُ نَ عَ قَتٍ عِ تّمُي بِرِن، هَلِ دُفِيٍ تٌ نُ قٍلٍنمَ عَ مَ عَ قَنيِ رَ. <verse eid="1KI 1:1"/><verse number="2" style="v" sid="1KI 1:2"/>نَ كُي، عَ شَ مِشِيٍ نَشَ عَ قَلَ عَ بّ، «فِنّدِ مّدِ ندٍ شَ قٍن عِ بّ، نَشَن مّينِمَ عِ مَ، عَ نُ قَ عَ سَ عِ قّ مَ عَلَكٌ شِنبٍلِ شَ بَ عِ مَ.» <verse eid="1KI 1:2"/><verse number="3" style="v" sid="1KI 1:3"/>عٍ نَشَ فِنّدِ مّدِ تٌقَنيِ ندٍ قٍن عِسِرَيِلَ بْشِ مَ، هَن عٍ سَ عَبِسَفَ سُنَمِكَ تٌ. عٍ نَشَ نَ شَنِن مَنفّ شْن مَ. <verse eid="1KI 1:3"/><verse number="4" style="v" sid="1KI 1:4"/>نَ تّمّدِ نُ تٌقَن كِ قَنيِ. عَ نُ مّينِ مَنفّ مَ، عَ نُ وَلِ بِرِن نَبَ عَ بّ. كْنْ نَ كُي مَنفّ مُ عَ كٌلٌن فِنّ رَ.<verse eid="1KI 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 1:5"/>نَ تّمُي شَفِتِ شَ دِ عَدٌنِيَ نَشَ عَ يّتّ عِتٍ قْلْ، عَ نُ قَ عَ قَلَ، «ﭑ تَن نَن قِندِ مَ عِسِرَيِلَ مَنفّ رَ.» عَ نَشَ سٌي نُن كُنتِفِ مَحّرّ سٍ تٌنفٌ، عَ نُن كٌرٌفبَ تٌنفٌ سُولِ. <verse eid="1KI 1:5"/><verse number="6" style="v" sid="1KI 1:6"/>عَ شَ سِمَيَ كُي، عَ بَبَ دَوُدَ نُ عَ لُشِ عَ يّتّ نَن يِ، عَ مُ نُ عَ قَلَمَ عَ بّ، «يِ لُ، يِ مُ قَن؟» عَدٌنِيَ قَتٍ نُ تٌقَن كِ قَنيِ. عَبِسَلٌمِ شَنبِرَتٌي نَن نُ عَ رَ.<verse eid="1KI 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 1:7"/>عَ تَن نُن سٍرُيَ شَ دِ يٌوَبَ نُن عَبِيَتَرِ سّرّشّدُبّ نَشَ لَن قٍ كٍرٍن مَ، عٍ شَ كَقُ عَ مَ عَدٌنِيَ شَ مَنفّيَ مَسْتْ. <verse eid="1KI 1:7"/><verse number="8" style="v" sid="1KI 1:8"/>كْنْ سَدْكِ سّرّشّدُبّ، يٍهٌيَدَ شَ دِ بّنَيَ، عَننَبِ نَتَن، سِمٍيِ، رٍيِ، نُن دَوُدَ شَ سْورِ سّنبّمَيٍ نَشَ تٌندِ بِرَدٍ عَدٌنِيَ قْشْ رَ.<verse eid="1KI 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 1:9"/>عَدٌنِيَ نَشَ نِنفٍيٍ نُن يّشّي بْرْفّشِيٍ بَ سّرّشّ رَ سٌشٍلٍتِ قَنيٍ قّ مَ، دّننَشّ نَ عٍن رٌفٍلِ سّيتِ مَ. عَ نَشَ عَ نفَشَكٍرٍنيِيٍ، مَنفّ شَ دِيٍ، نُن مَنفّ شَ مِشِيٍ بِرِن شِلِ. <verse eid="1KI 1:9"/><verse number="10" style="v" sid="1KI 1:10"/>كْنْ عَ مُ عَننَبِ نَتَن، بّنَيَ، مَنفّ شَ سْورِ سّنبّمَيٍ، نُن عَ شُنيَ سُلٍمَنِ تَن شِلِ.<verse eid="1KI 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 1:11"/>نَتَن نَشَ عَ قَلَ سُلٍمَنِ نفَ بَتِسٍبَ بّ، «عِ مُ عَ مّشِ عَ شَفِتِ شَ دِ عَدٌنِيَ بَرَ قِندِ مَنفّ رَ، عَ قَ لِ وٌن مَرِفِ دَوُدَ مُ قٍقٍ كٌلٌنشِ نَ قٍ كُي؟ <verse eid="1KI 1:11"/><verse number="12" style="v" sid="1KI 1:12"/>يَكْسِ عِ نَشَن نَبَمَ، عِ عِ تُلِ مَتِ ﭑ مَ مَرَ سِ رَ، عَلَكٌ عِ شَ عِ تَن نُن عِ شَ دِ سُلٍمَنِ نِي رَتَنفَ. <verse eid="1KI 1:12"/><verse number="13" style="v" sid="1KI 1:13"/>عِ شَ سِفَ مَنفّ دَوُدَ يِرٍ، عِ عَ قَلَ عَ بّ، ‹مَنفّ ﭑ مَرِفِ، عِ مُ لَايِدِ تٌنفٌ شّ ﭑ تَن عِ شَ كٌنيِ فِنّ بّ، قَ عَ قَلَ ﭑ مَ دِ سُلٍمَنِ قَمَ مَنفّيَ سْتْدٍ عِ حْشْي رَ، عَ دْشْ عِ شَ كِبَنيِ كُي؟ مُنقٍ رَ عَدٌنِيَ نَ قِندِقٍ مَنفّ رَ يَكْسِ؟› <verse eid="1KI 1:13"/><verse number="14" style="v" sid="1KI 1:14"/>عِ نُن مَنفّ وْيّنمَ تّمُي نَشّ، ﭑ قَن سٌ تّمُي نَن نَ كِ وٌ يِرٍ، ﭑ قَ عِ شَ وْيّنيِ رَكَمَلِ.»<verse eid="1KI 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 1:15"/>بَتِسٍبَ نَشَ سٌ مَنفّ شَ كٌنكٌي كُي. مَنفّ نُ بَرَ قٌرِ كِ قَنيِ. عَبِسَفَ سُنَمِكَ نُ نَ مّينِقٍ عَ مَ. <verse eid="1KI 1:15"/><verse number="16" style="v" sid="1KI 1:16"/>بَتِسٍبَ نَشَ سُيِدِ، عَ عَ مَفٌرٌ مَنفّ يَ عِ. مَنفّ نَشَ عَ مَشْرِن، «مُنسٍ نِيَشِ؟» <verse eid="1KI 1:16"/><verse number="17" style="v" sid="1KI 1:17"/>بَتِسٍبَ نَشَ عَ يَابِ، «ﭑ مَرِفِ، عِ بَرَ عِ كَلِ عِ مَرِفِ عَلَتَلَ شِلِ رَ، عَ قَلَقٍ رَ عَ ﭑ مَ دِ نَن قِندِ مَ مَنفّ رَ عِ حْشْي رَ، عَ دْشْ عِ شَ كِبَنيِ كُي. <verse eid="1KI 1:17"/><verse number="18" style="v" sid="1KI 1:18"/>كْنْ مَنفّ ﭑ مَرِفِ، يَكْسِ عَدٌنِيَ نَن قَ قِندِقٍ مَنفّ رَ، عَ قَ لِ عِ مُ قٍقٍ كٌلٌن نَ كُي. <verse eid="1KI 1:18"/><verse number="19" style="v" sid="1KI 1:19"/>عَ بَرَ نِنفٍ نُن يّشّي تُرَشِ فبٍفبٍ بَ سّرّشّ رَ. عَ بَرَ مَنفّ شَ دِيٍ بِرِن شِلِ، قٌ ﭑ مَ دِ سُلٍمَنِ، نَشَن قِندِشِ عِ شَ كٌنيِ قَنيِ رَ. عَ بَرَ عَبِيَتَرِ سّرّشّدُبّ نُن يٌوَبَ سْورِ مَنفّ قَن شِلِ. <verse eid="1KI 1:19"/><verse number="20" style="v" sid="1KI 1:20"/>مَنفّ ﭑ مَرِفِ، عِسِرَيِلَ حَمَ تُلِ مَتِشِ عِ تَن نَن نَ، عَلَكٌ عِ شَ عَ مَسٍن نَشَن دْشْمَ عِ شَ كِبَنيِ كُي عِ حْشْي رَ. <verse eid="1KI 1:20"/><verse number="21" style="v" sid="1KI 1:21"/>شَ نَ مُ عَ رَ، عِ نَ بّلّ تّمُي نَشّ عِ بٍنبَيٍ قّ مَ، يِ حَمَ قَمَ ﭑ تَن نُن ﭑ مَ دِ سُلٍمَنِ شَ قٍ شُن نَكَنَدٍ نّ عَلْ كَاقِرِيٍ.»<verse eid="1KI 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 1:22"/>عَ وْيّن تّمُي، عَننَبِ نَتَن نَشَ مَنفّ شْنيِ لِ. <verse eid="1KI 1:22"/><verse number="23" style="v" sid="1KI 1:23"/>مِشِ ندٍ نَشَ عَ رَ سٌ مَنفّ شَ كٌنكٌي كُي، عَ عَ قَلَ، «عَننَبِ نَتَن بَرَ قَ.» نَتَن نَشَ عَ مَفٌرٌ بْشِ مَ مَنفّ يَ عِ. <verse eid="1KI 1:23"/><verse number="24" style="v" sid="1KI 1:24"/>نَ تّمُي عَ نَشَ عَ مَسٍن مَنفّ بّ، «مَنفّ ﭑ مَرِفِ، عِ تَن نَن عَ قَلَشِ، ‹عَدٌنِيَ نَن قِندِ مَ مَنفّ رَ ﭑ حْشْي رَ، عَ دْشْ ﭑ مَ كِبَنيِ كُي؟› <verse eid="1KI 1:24"/><verse number="25" style="v" sid="1KI 1:25"/>ﭑ عِ مَشْرِنشِ نّ نَ مَ بَرِ مَ عَدٌنِيَ حَن بَرَ نِنفٍيٍ نُن يّشّي بْرْفّشِ فبٍفبٍ بَ سّرّشّ رَ. عَ بَرَ مَنفّ شَ دِيٍ بِرِن، سْرِ مَنفّيٍ، نُن عَبِيَتَرِ سّرّشّدُبّ شِلِ. عٍ بِرِن نَ عٍ دّفٍقٍ يِرٍ كٍرٍن، عٍ عَ قَلَمَ، ‹كِسِ نَ مَنفّ عَدٌنِيَ بّ!› <verse eid="1KI 1:25"/><verse number="26" style="v" sid="1KI 1:26"/>كْنْ، عَ مُ ﭑ تَن شِلِشِ، ﭑ تَن نَشَن قِندِشِ عِ شَ كٌنيِ قَنيِ رَ. عَ مُ سَدْكِ سّرّشّدُبّ شِلِشِ، عَ مُ يٍهٌيَدَ شَ دِ بّنَيَ شِلِشِ، عَ مُ عِ شَ دِ سُلٍمَنِ شِلِشِ، نَشَن قَن قِندِشِ عِ شَ كٌنيِ رَ. <verse eid="1KI 1:26"/><verse number="27" style="v" sid="1KI 1:27"/>نَ قٍ كٍلِشِ عِ تَن نَ مَ، مَنفّ ﭑ مَرِفِ؟ مُنقٍ رَ عِ مُ عَ قَلَ ﭑ تَن عِ شَ كٌنيِ قَنيِ بّ، مِشِ نَشَن قَمَ دْشْدٍ عِ شَ كِبَنيِ كُي؟»<verse eid="1KI 1:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1KI 1:28"/>مَنفّ دَوُدَ نَشَ عَ قَلَ، «وٌ بَتِسٍبَ شِلِ ﭑ بّ.» عَ تٌ سٌ مَنفّ يِرٍ، <verse eid="1KI 1:28"/><verse number="29" style="v" sid="1KI 1:29"/>مَنفّ نَشَ عَ كَلِ عَ بّ، «ﭑ بَرَ ﭑ كَلِ عَلَتَلَ رَ، نَشَن ﭑ نَتَنفَشِ ﭑ مَ تْورّ بِرِن كُي، <verse eid="1KI 1:29"/><verse number="30" style="v" sid="1KI 1:30"/>عَلْ ﭑ نَن ﭑ كَلِ عَلَتَلَ رَ كِ نَشّ عَ قَلَقٍ رَ، ‹عِ شَ دِ سُلٍمَنِ نَن قِندِ مَ مَنفّ رَ ﭑ حْشْي رَ، عَ تَن نَن دْشْمَ ﭑ مَ كِبَنيِ كُي،› تٌ يَتِ ﭑ قَمَ نّ نَ لَايِدِ رَكَمَلِدٍ.» <verse eid="1KI 1:30"/><verse number="31" style="v" sid="1KI 1:31"/>بَتِسٍبَ نَشَ عَ مَفٌرٌ، عَ سُيِدِ مَنفّ يَ عِ، عَ قَ عَ قَلَ «مَنفّ ﭑ مَرِفِ دَوُدَ شَ كِسِ عَبَدَن!»<verse eid="1KI 1:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="1KI 1:32"/>مَنفّ دَوُدَ نَشَ عَ قَلَ عَ شَ مِشِيٍ بّ عٍ شَ سَدْكِ سّرّشّدُبّ، عَننَبِ نَتَن، نُن يٍهٌيَدَ شَ دِ بّنَيَ شِلِ. نٍيٍ تٌ قَ مَنفّ يِرٍ، <verse eid="1KI 1:32"/><verse number="33" style="v" sid="1KI 1:33"/>عَ نَشَ عَ مَسٍن عٍ بّ، عَ نَشّ، «وٌ شَ ﭑ مَ مِشِيٍ تٌنفٌ، وٌ شَ ﭑ مَ دِ سُلٍمَنِ دْشْ ﭑ مَ سٌقَلٍ قَرِ، وٌ فٌرٌ عَ رَ فِشٌن. <verse eid="1KI 1:33"/><verse number="34" style="v" sid="1KI 1:34"/>مّننِ، سّرّشّدُبّ سَدْكِ نُن عَننَبِ نَتَن شَ تُرٍ سُرُ سُرُ عَ شُنيِ مَ، عَ تِقٍ رَ عِسِرَيِلَ مَنفّ رَ. وٌ نَ فّ نَ رَبَدٍ، وٌ شَ قٍرِ قٍ، وٌ قَ عَ قَلَ وٌ شُي عِتٍشِ رَ، ‹كِسِ نَ مَنفّ سُلٍمَنِ بّ!› <verse eid="1KI 1:34"/><verse number="35" style="v" sid="1KI 1:35"/>نَ تّمُي وٌ بِرِن شَ فبِلٍن، وٌ شَ عَ دْشْ ﭑ مَ كِبَنيِ كُي. عَ تَن نَن قِندِ مَ مَنفّ رَ ﭑ حْشْي رَ. ﭑ بَرَ عَ تِ عِسِرَيِلَ نُن يُدَيَ مَنفّ رَ.»<verse eid="1KI 1:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="1KI 1:36"/>يٍهٌيَدَ شَ دِ بّنَيَ نَشَ مَنفّ يَابِ، «ﭑ مَ مَنفّ، عَ شَ رَبَ نَ كِ! عَ شَ قِندِ عِ مَرِفِ عَلَتَلَ سَفٌي رَ! <verse eid="1KI 1:36"/><verse number="37" style="v" sid="1KI 1:37"/>عَلَتَلَ نُ نَ ﭑ مَ مَنفّ بّ كِ نَشّ، عَ شَ لُ سُلٍمَنِ قَن بّ نَ كِ. سُلٍمَنِ شَ مَنفّيَ شَ فبٌ دَنفِ ﭑ مَرِفِ مَنفّ دَوُدَ فبٍ رَ.»<verse eid="1KI 1:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="1KI 1:38"/>سَدْكِ سّرّشّدُبّ، عَننَبِ نَتَن، يٍهٌيَدَ شَ دِ بّنَيَ، كٍرٍتِكَيٍ، نُن ثٍلٍتَكَيٍ نَشَ سُلٍمَنِ رَتٍ مَنفّ دَوُدَ شَ سٌقَلٍ قَرِ، عٍ سِفَ عَ رَ فِشٌن. <verse eid="1KI 1:38"/><verse number="39" style="v" sid="1KI 1:39"/>سَدْكِ سّرّشّدُبّ نَشَ سٌ هْرْ مْلِنفِرَ كُي، عَ قٍرِ تٌنفٌ تُرٍ سّنِيّنشِ نُ نَ نَشَن كُي. عَ نَشَ نَ تُرٍ سُرُ سُرُ سُلٍمَنِ شُنيِ مَ. نَ تّمُي عٍ نَشَ سَرَ قٍ، حَمَ بِرِن نَشَ عَ قَلَ عٍ شُي عِتٍشِ رَ، «كِسِ نَ مَنفّ سُلٍمَنِ بّ!» <verse eid="1KI 1:39"/><verse number="40" style="v" sid="1KI 1:40"/>حَمَ بِرِن نَشَ بِرَ عَ قْشْ رَ حّلّشِنيِ كُي. عٍ نُ شُلٍ قٍ، عٍ نُ عٍ شُي عِتٍ هَن بْشِ نَشَ سّرّن نَ شُي مَ.<verse eid="1KI 1:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="1KI 1:41"/>عَدٌنِيَ نُن عَ شَ حَمَ تٌ فّ عٍ دّفّدٍ، عٍ نَشَ نَ شُي مّ. يٌوَبَ تٌ نَ سَرَ شُي مّ، عَ نَشَ عَ قَلَ، «سْنشْي مُندُن نَ تَا كُي نَ كِ؟» <verse eid="1KI 1:41"/><verse number="42" style="v" sid="1KI 1:42"/>نَ تّمُي يَتِ، عَبِيَتَرِ سّرّشّدُبّ شَ دِ يٌنَتَن نَشَ سٌ. عَدٌنِيَ نَشَ عَ شِلِ، عَ نَشّ، «مِشِ هَفِفّ نَن عِ رَ، نَشَن قَشِ شِبَارُ قَنيِ رَ.» <verse eid="1KI 1:42"/><verse number="43" style="v" sid="1KI 1:43"/>كْنْ يٌنَتَن نَشَ عَدٌنِيَ يَابِ، «وٌن مَرِفِ مَنفّ دَوُدَ بَرَ سُلٍمَنِ تِ مَنفّ رَ. <verse eid="1KI 1:43"/><verse number="44" style="v" sid="1KI 1:44"/>مَنفّ بَرَ سَدْكِ سّرّشّدُبّ، عَننَبِ نَتَن، يٍهٌيَدَ شَ دِ بّنَيَ، ثٍلٍتَكَيٍ، نُن كٍرٍتِكَيٍ شّي سُلٍمَنِ مَتِدٍ مَنفّ شَ سٌقَلٍ قَرِ. <verse eid="1KI 1:44"/><verse number="45" style="v" sid="1KI 1:45"/>سَدْكِ سّرّشّدُبّ نُن عَننَبِ نَتَن بَرَ تُرٍ سّنِيّنشِ سُرُ سُرُ عَ شُنيِ مَ فِشٌن، عَ شَ قِندِ مَنفّ رَ. عٍ بِرِن بَرَ كٍلِ مّننِ سّيوّ كُي. نَ حّلّشِنيِ بَرَ دِن تَا بِرِن نَ. وٌ نَ شُي نَن مّقٍ يِ كِ. <verse eid="1KI 1:45"/><verse number="46" style="v" sid="1KI 1:46"/>سُلٍمَنِ حَن بَرَ عَ مَفٌرٌ مَنفّ كِبَنيِ كُي. <verse eid="1KI 1:46"/><verse number="47" style="v" sid="1KI 1:47"/>مَنفّ شَ مِشِيٍ بِرِن بَرَ قَ وٌن مَرِفِ مَنفّ دَوُدَ يِرٍ، عٍ شَ دُبَ عَ بّ عَ قَلَقٍ رَ، ‹عِ مَرِفِ عَلَ شَ سُلٍمَنِ شِلِ عِتٍ دَنفِ عِ تَن نَ، عَ شَ مَنفّيَ شَ فبٌ دَنفِ عِ فبٍ رَ!› مَنفّ نَشَ سُيِدِ عَ شَ سَدٍ مَ. <verse eid="1KI 1:47"/><verse number="48" style="v" sid="1KI 1:48"/>عَ نَشَ يِ مَسٍنيِ تِ، عَ نَشّ، ‹تَنتُي نَ عِسِرَيِلَ مَرِفِ عَلَتَلَ بّ، نَشَن مِشِ ندٍ دْشْشِ ﭑ مَ كِبَنيِ كُي ﭑ يَ شْرِ.›»<verse eid="1KI 1:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="1KI 1:49"/>عَدٌنِيَ شَ مِشِيٍ عَ نَشٍيٍ شِلِ، نٍيٍ بِرِن نَشَ سٌ سّرّنقٍ فَاشُي رَ. عٍ نَشَ كٍلِ، كَنكَن نَشَ سِفَ عَ شْنيِ. <verse eid="1KI 1:49"/><verse number="50" style="v" sid="1KI 1:50"/>عَدٌنِيَ قَن نَشَ فَاشُ، عَ سِفَ هْرْ مْلِنفِرَ، عَ سّرّشّبَدٍ قٍرِيٍ سُشُ. <verse eid="1KI 1:50"/><verse number="51" style="v" sid="1KI 1:51"/>مِشِ ندٍ نَشَ عَ قَلَ سُلٍمَنِ بّ عَ عَدٌنِيَ تٌ فَاشُشِ سُلٍمَنِ يَ رَ، عَ سٌشِ هْرْ مْلِنفِرَ نَن كُي، عَ سّرّشّبَدٍ قٍرِيٍ سُشُ، عَ عَ قَلَ، «قٌ مَنفّ سُلٍمَنِ شَ عَ كَلِ ﭑ بّ تٌ، عَ مُ ﭑ تَن عَ شَ كٌنيِ قَشَمَ سَنتِدّفّمَ رَ.» <verse eid="1KI 1:51"/><verse number="52" style="v" sid="1KI 1:52"/>سُلٍمَنِ نَشَ يِ يَابِ قِ، عَ نَشّ، «شَ عَ سَ قِندِ مِشِ قَنيِ نَن نَ، سٍسٍ مُ عَ تٌمَ. كْنْ شَ عَ سَ قِندِ مِشِ كٌبِ نَن نَ، عَ قَشَمَ نّ!» <verse eid="1KI 1:52"/><verse number="53" style="v" sid="1KI 1:53"/>نَ كُي مَنفّ سُلٍمَنِ نَشَ مِشِيٍ شّي، عٍ شَ عَ رَفٌرٌ سّرّشّبَدٍ قَرِ. عَدٌنِيَ نَشَ سِفَ مَنفّ يِرٍ، عَ سُيِدِ عَ بّ. سُلٍمَنِ نَشَ عَ قَلَ عَ بّ، «سِفَ عِ شْنيِ.»<verse eid="1KI 1:53"/></para>
  <chapter eid="1KI 1"/>
  <chapter number="2" style="c" sid="1KI 2"/>
  <para style="s">دَوُدَ شَ حُنفُي نُن عَ لَاشِرَ تّمُي</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 2:1"/>دَوُدَ تٌ عَ كٌلٌن عَ نُ قَ نَ سَيَ كِرَ نَن شْن، عَ نَشَ يِ مَسٍنيِ تِ عَ شَ دِ سُلٍمَنِ بّ، عَ نَشّ، <verse eid="1KI 2:1"/><verse number="2" style="v" sid="1KI 2:2"/>«ﭑ نَ سَيَ كِرَ نَن شْن مَ يِ كِ عَلْ عِبُنَدَ مَ بِرِن. عِ شَ عِ سّنبّ سٌ، عِ شَ تِ فبٍن. <verse eid="1KI 2:2"/><verse number="3" style="v" sid="1KI 2:3"/>عِ شَ عِ حْشْ سَ عِ مَرِفِ عَلَتَلَ شَ يَامَرِيٍ شْن مَ، عِ شَ بِرَ عَ شَ كِرَ قْشْ رَ. عِ شَ عَ شَ سّرِيّ رَبَتُ، عِ شَ عَ شَ يَامَرِيٍ رَتِنمّ. عِ شَ بِرَ عَ شَ لْننِ قْشْ رَ، عِ شَ عَ شُي سُشُ عَلْ عَ سّبّشِ كِ نَشّ تَوُرٍتَ مُنسَ كُي، عَلَكٌ قٍ بِرِن شَ سْونّيَ عِ بّ عِ سِفَ دّدّ. <verse eid="1KI 2:3"/><verse number="4" style="v" sid="1KI 2:4"/>نَ نَن عَ تٌمَ، عَلَتَلَ عَ شَ مَسٍنيِ رَكَمَلِمَ، عَ نَشَن مَسٍن ﭑ بّ عَ تٌ عَ قَلَ، ‹شَ عِ شَ دِيٍ قٍ بِرِن نَبَمَ عَلَكٌ عٍ شَ عٍ حّرّ ﭑ مَ كِرَ شْن عٍ بْحّ بِرِن نَ، عٍ نِي بِرِن نَ، عِسِرَيِلَ مَنفّيَ لُمَ عٍ يِ رَ عَبَدَن.›»<verse eid="1KI 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 2:5"/>«عِ عَ كٌلٌن سٍرُيَ شَ دِ يٌوَبَ نَشَن نَبَ ﭑ نَ، عِ عَ كٌلٌن عَ نَشَن نَبَ عِسِرَيِلَ سْورِيٍ شَ مَنفّيٍ، عَبٍنٍرِ، نُن عَمَسَ رَ. عَ نَشَ عٍ قَشَ بْحّسَ وَشَتِ، عَ عٍ وُلِ مَسٌ عَ شَ بّلّتِ نُن عَ شَ سَنكِرِيٍ مَ. <verse eid="1KI 2:5"/><verse number="6" style="v" sid="1KI 2:6"/>نَ كُي عِ شَ قّيرّ قٍن عَلَكٌ عَ نَشَ سِفَ عَلِفِيَمَ بْحّسَ كُي. <verse eid="1KI 2:6"/><verse number="7" style="v" sid="1KI 2:7"/>عِ شَ عِ حْشْ سَ بَرَ سِلَيِ فَلَدِكَ شَ دِيٍ شْن مَ، عَلَكٌ عٍ شَ عٍ دّفٍ عِ شَ تٍيبِلِ رَ، بَرِ مَ عٍ نَ مْولِ نَن نَبَ ﭑ بّ ﭑ نُ نَ ﭑ فِقٍ عِ تَارَ عَبِسَلٌمِ مَ تّمُي نَشّ. <verse eid="1KI 2:7"/><verse number="8" style="v" sid="1KI 2:8"/>قٌ عِ شَ فٍرَ شَ دِ سِمٍيِ بَشُرِ مِ شَ قٍ قَن مَتٌ، نَشَن قَتَنشِ بُنيَمِن بْنسْي رَ. عَ ﭑ دَنكَ نّ عَ حَاشِ رَ، ﭑ نُ سِفَقٍ مَشَنَيِمِ لْشْي نَشّ. ﭑ تٌ فبِلٍن، عَ نَشَ ﭑ نَلَن يُرُدّن شُرٍ بِرِ. مّننِ ﭑ نَشَ ﭑ كَلِ عَلَتَلَ رَ عَ ﭑ مُ عَ قَشَمَ سَنتِدّفّمَ رَ. <verse eid="1KI 2:8"/><verse number="9" style="v" sid="1KI 2:9"/>يَكْسِ عِ نَشَ دِحّ عَ مَ دٍ. شَشِلِمَ نَن عِ رَ، عِ عَ كٌلٌن عَ لَنمَ عِ شَ عَ رَ سِفَ عَلِفِيَمَ كِ نَشّ.»<verse eid="1KI 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 2:10"/>نَ تّمُي دَوُدَ نَشَ لَاشِرَ، عَ نَشَ بّلّ عَ بٍنبَيٍ قّ مَ عَ شَ تَا كُي. <verse eid="1KI 2:10"/><verse number="11" style="v" sid="1KI 2:11"/>عَ حّ تٌنفٌ نَانِ مَنفّيَ نَن نَبَ عِسِرَيِلَ شُن مَ. عَ نَشَ حّ سٌلٌقٍرٍ رَبَ شٍبِرٌن، عَ حّ تٌنفٌ سَشَن نُن سَشَن نَبَ دَرِ سَلَمُ. <verse eid="1KI 2:11"/><verse number="12" style="v" sid="1KI 2:12"/>عَ شَ دِ سُلٍمَنِ نَشَ مَفٌرٌ عَ شَ كِبَنيِ كُي، عَ شَ مَنفّيَ نَشَ مَبَنبَن.<verse eid="1KI 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 2:13"/>شَفِتِ شَ دِ عَدٌنِيَ نَشَ سِفَ سُلٍمَنِ نفَ بَتِسٍبَ يِرٍ. بَتِسٍبَ نَشَ عَ مَشْرِن، «عِ قَشِ بْحّسَ كُي؟» عَ نَشَ عَ يَابِ، «عِيٌ، ﭑ قَشِ بْحّسَ كُي.» <verse eid="1KI 2:13"/><verse number="14" style="v" sid="1KI 2:14"/>عَدٌنِيَ نَشَ عَ قَلَ عَ بّ، «ﭑ وَ مَ وْيّن كٍرٍن نَن قَلَقٍ عِ بّ.» بَتِسٍبَ نَشَ عَ يَابِ، «نَ قَلَ ﭑ بّ.» <verse eid="1KI 2:14"/><verse number="15" style="v" sid="1KI 2:15"/>عَدٌنِيَ نَشَ يِ مَسٍنيِ تِ عَ بّ، «عِ عَ كٌلٌن عَ نُ لَنمَ ﭑ تَن نَن شَ قِندِ مَنفّ رَ. عِسِرَيِلَ بِرِن يَ نُ رَقِندِشِ ﭑ تَن نَن مَ ﭑ شَ قِندِ مَنفّ رَ. كْنْ عَلَتَلَ نَشَ عَ نِيَ مَنفّيَ شَ سٌ ﭑ شُنيَ يِ رَ. <verse eid="1KI 2:15"/><verse number="16" style="v" sid="1KI 2:16"/>يَكْسِ، ﭑ وَ مَ قٍ كٍرٍن فبَنسَن نَن شْن مَ عِ يِ، عِ نَشَ تٌندِ ﭑ بّ.» بَتِسٍبَ نَشّ، «نَ قَلَ ﭑ بّ.» <verse eid="1KI 2:16"/><verse number="17" style="v" sid="1KI 2:17"/>عَدٌنِيَ نَشَ عَ قَلَ، «يَندِ، عِ شَ عَ قَلَ مَنفّ سُلٍمَنِ بّ عَ شَ عَبِسَفَ سُنَمِكَ قِ ﭑ مَ فِنّ رَ. عَ مُ تٌندِ مَ عِ بّ.» <verse eid="1KI 2:17"/><verse number="18" style="v" sid="1KI 2:18"/>بَتِسٍبَ نَشَ عَ يَابِ، «عَوَ، ﭑ وْيّنمَ مَنفّ بّ عِ شَ قٍ رَ.»<verse eid="1KI 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 2:19"/>بَتِسٍبَ نَشَ سِفَ مَنفّ سُلٍمَنِ يِرٍ، عَ شَ سَ عَدٌنِيَ شَ قٍ قَلَ عَ بّ. مَنفّ تٌ عَ نفَ تٌ، عَ نَشَ كٍلِ عَ شَ كِبَنيِ، عَ سِفَ عَ رَلَندٍ. عَ نَشَ عَ عِفٌرٌ عَ نفَ بّ، عَ كِبَنيِ فبّتّ مَشِلِ. سُلٍمَنِ نفَ نَشَ عَ مَفٌرٌ عَ يِرٍقَنيِ مَ. <verse eid="1KI 2:19"/><verse number="20" style="v" sid="1KI 2:20"/>نَ تّمُي عَ نفَ نَشَ عَ قَلَ عَ بّ، «ﭑ وَ مَ قٍ ندٍ نَن شْن. عِ نَشَ تٌندِ ﭑ بّ.» مَنفّ نَشَ عَ يَابِ، «نفَ، عِ شَ نَ قَلَ ﭑ بّ، ﭑ مُ تٌندِ مَ عِ بّ.» <verse eid="1KI 2:20"/><verse number="21" style="v" sid="1KI 2:21"/>عَ نفَ نَشَ عَ قَلَ عَ بّ، «عِ شَ عَبِسَفَ سُنَمِكَ قِ فِنّ رَ عِ تَارَ عَدٌنِيَ مَ.» <verse eid="1KI 2:21"/><verse number="22" style="v" sid="1KI 2:22"/>مَنفّ سُلٍمَنِ نَشَ عَ نفَ يَابِ، «مُنقٍ رَ عِ عَبِسَفَ مَشْرِنمَ عَدٌنِيَ بّ؟ نَ لُشِ عَلْ عِ وَ مَ ﭑ مَ مَنفّيَ نَن سٌقٍ عَ يِ رَ، عَ تٌ قِندِشِ ﭑ تَارَ رَ. عِ شَ عَ سٌ عَبِيَتَرِ سّرّشّدُبّ نُن سٍرُيَ شَ دِ يٌوَبَ قَن يِ رَ.»<verse eid="1KI 2:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 2:23"/>نَ كُي مَنفّ سُلٍمَنِ نَشَ عَ كَلِ عَلَتَلَ رَ، عَ نَشّ، «عَلَ شَ ﭑ شُن نَكَنَ شَ عَدٌنِيَ مُ قَشَمَ عَ شَ وْيّنيِ شَ قٍ رَ! <verse eid="1KI 2:23"/><verse number="24" style="v" sid="1KI 2:24"/>يَكْسِ، ﭑ بَرَ ﭑ كَلِ عَلَتَلَ شِلِ رَ، نَشَن ﭑ دْشْشِ ﭑ بَبَ دَوُدَ شَ مَنفّ كِبَنيِ كُي، تٌ يَتِ عَدٌنِيَ قَشَمَ نّ. ﭑ بَرَ ﭑ كَلِ عَلَتَلَ رَ نَشَن ﭑ مَ قٍ بِرِن سْونّيَمَ، نَشَن بْنسْي قِمَ ﭑ مَ.» <verse eid="1KI 2:24"/><verse number="25" style="v" sid="1KI 2:25"/>مَنفّ سُلٍمَنِ نَشَ يٍهٌيَدَ شَ دِ بّنَيَ يَمَرِ، عَ شَ سَ عَدٌنِيَ قَشَ. عَ رَبَ نَ كِ نّ.<verse eid="1KI 2:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 2:26"/>نَ دَنفِ شَنبِ، مَنفّ نَشَ عَ قَلَ عَبِيَتَرِ سّرّشّدُبّ بّ، «سِفَ عِ شْنيِ عَنَتْتِ بْشِ مَ. عَ لَن عِ شَ قَشَ، كْنْ ﭑ بَرَ دِحّ بَرِ مَ عِ عَلَ شَ سَاتّ كَنكِرَ شَنِن نّ ﭑ بَبَ دَوُدَ يَ عِ، عِ مَن تْورْ نّ ﭑ بَبَ شَ تْورّ.» <verse eid="1KI 2:26"/><verse number="27" style="v" sid="1KI 2:27"/>سُلٍمَنِ عَبِيَتَرِ كٍرِ نَ كِ نّ. نَ كُي عَلَتَلَ شَ مَسٍنيِ نَشَ كَمَلِ، عَلَ نَشَن مَسٍن عٍلِ بْنسْي شَ قٍ رَ سِلٌ.<verse eid="1KI 2:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1KI 2:28"/>يٌوَبَ نُ بَرَ عَدٌنِيَ مَلِ مَنفّ مَتَندِدٍ، كْنْ عَ مُ نُ نَ عَبِسَلٌمِ تَن شَ مَنفّ مَتَندِقٍ كُي. نَ كُي، عَ تٌ قٍ مّ سُلٍمَنِ نَشَن نَبَ، عَ نَشَ عَ فِ، عَ سِفَ هْرْ مْلِنفِرَ كُي، عَ سَ سّرّشّبَدٍ قٍرِيٍ سُشُ. <verse eid="1KI 2:28"/><verse number="29" style="v" sid="1KI 2:29"/>مِشِيٍ تٌ عَ قَلَ مَنفّ سُلٍمَنِ بّ، عَ يٌوَبَ بَرَ عَ فِ عَ سِفَ هْرْ مْلِنفِرَ كُي سّرّشّبَدٍ يِرٍ، مَنفّ سُلٍمَنِ نَشَ يٍهٌيَدَ شَ دِ بّنَيَ يَمَرِ، «سَ عَ قَشَ!» <verse eid="1KI 2:29"/><verse number="30" style="v" sid="1KI 2:30"/>بّنَيَ نَشَ سِفَ عَلَتَلَ شَ هْرْ مْلِنفِرَ، عَ عَ قَلَ عَ بّ، «مَنفّ نَشّ عِ شَ مِنِ.» عَ نَشَ عَ يَابِ، «ﭑ تٌندِ! ﭑ شَ قَشَ بٍ!» بّنَيَ نَشَ سَ يٌوَبَ شَ وْيّنيِ دّنتّفّ مَنفّ بّ. <verse eid="1KI 2:30"/><verse number="31" style="v" sid="1KI 2:31"/>مَنفّ نَشَ عَ قَلَ بّنَيَ بّ، «عِ شَ عَ رَبَ عَلْ عَ عَ قَلَشِ كِ نَشّ. عِ نَ عَ قَشَ، عَ رَفَتَ. نَ كُي عِ قَمَ ﭑ تَن نُن ﭑ مَ دٍنبَيَ رَتَنفَدٍ يٌوَبَ شَ وُلِ رَ مِنِشِ قُقَقُي مَ. <verse eid="1KI 2:31"/><verse number="32" style="v" sid="1KI 2:32"/>عَلَتَلَ قَمَ نَ يُنُبِ سَرٍ رَفبِلٍندٍ عَ تَن نَن مَ، بَرِ مَ عَ مِشِ قِرِن قَشَ نّ نَشٍيٍ نُ تِنشِن عَ تَن بّ، نَشٍيٍ شَ قٍ بِنيّ نُ دَنفِ عَ تَن فبٍ رَ. ﭑ بَبَ دَوُدَ مُ نُ عَ كٌلٌن عَ نٍرِ شَ دِ عَبٍنٍرِ نُن يٍتٍرِ شَ دِ عَمَسَ، عِسِرَيِلَ سْورِيٍ شَ مَنفّيٍ قَشَ يٌوَبَ شَ سَنتِدّفّمَ نَن سَابُي رَ. <verse eid="1KI 2:32"/><verse number="33" style="v" sid="1KI 2:33"/>عٍ وُلِ سَرٍ دْشْمَ يٌوَبَ نُن عَ بْنسْي نَن شُن مَ عَبَدَن، كْنْ عَلَتَلَ شَ هِننّ نَن لُمَ دَوُدَ، عَ بْنسْييٍ، عَ شَ دٍنبَيَ نُن عَ شَ مَنفّيَ مَ.» <verse eid="1KI 2:33"/><verse number="34" style="v" sid="1KI 2:34"/>يٍهٌيَدَ شَ بّنَيَ نَشَ سِفَ، عَ سَ يٌوَبَ قَشَ، عَ عَ رَفَتَ عَ شْنيِ فبٍنفبٍرٍنيِ مَ.<verse eid="1KI 2:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="1KI 2:35"/>مَنفّ نَشَ يٍهٌيَدَ شَ دِ بّنَيَ قِندِ سْورِيٍ شَ مَنفّ رَ. عَ نَشَ سَدْكِ سّرّشّدُبّ تِ عَبِيَتَرِ حْشْي رَ.<verse eid="1KI 2:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="1KI 2:36"/>مَنفّ نَشَ شّيرَ تِ سِمٍيِ مَ، عَ عَ قَلَ عَ بّ، «بَنشِ ندٍ تِ دَرِ سَلَمُ، عِ لُمَ دّننَشّ. عِ نَشَ مِنِ تَا كُي دٍ. <verse eid="1KI 2:36"/><verse number="37" style="v" sid="1KI 2:37"/>عِ نَ سٍدِرٌن شُرٍ عِفِرِ لْشْي نَشّ مِنِقٍ رَ تَا كُي، عِ قَشَمَ نَ لْشْي يَتِ نّ.» <verse eid="1KI 2:37"/><verse number="38" style="v" sid="1KI 2:38"/>سِمٍيِ نَشَ مَنفّ يَابِ، عَ نَشّ، «عَوَ يِرٍ، عِ تَن ﭑ مَرِفِ نَشَن قَلَشِ، ﭑ نَ نَن نَبَمَ.» سِمٍيِ نَشَ بُ دَرِ سَلَمُ كِ قَنيِ، <verse eid="1KI 2:38"/><verse number="39" style="v" sid="1KI 2:39"/>كْنْ حّ سَشَن تٌ دَنفِ، عَ شَ كٌنيِ قِرِن نَشَ عٍ فِ عٍ سِفَ مَاكَ شَ دِ عَكِسِ شْنيِ، فَتِ مَنفّ. مِشِ ندٍيٍ تٌ عَ قَلَ عَ بّ، «عِ شَ كٌنيِ قِرِن نَ فَتِ،» <verse eid="1KI 2:39"/><verse number="40" style="v" sid="1KI 2:40"/>عَ نَشَ تٍ عَ شَ سٌقَلٍ قَرِ، عَ سِفَ عَ شَ كٌنيِيٍ قْشْ رَ فَتِ، عَكِسِ شْنيِ. عَ تٌ عٍ مَسْتْ، عَ نَشَ عٍ رَفبِلٍن.<verse eid="1KI 2:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="1KI 2:41"/>مِشِ ندٍ نَشَ سَ نَ قَلَ مَنفّ بّ، عَ سِمٍيِ مِنِ نّ دَرِ سَلَمُ، عَ سِفَ فَتِ، عَ مَن فبِلٍن. <verse eid="1KI 2:41"/><verse number="42" style="v" sid="1KI 2:42"/>مَنفّ نَشَ سِمٍيِ شِلِ، عَ عَ قَلَ عَ بّ، «ﭑ مُ ﭑ كَلِ عَلَتَلَ رَ شّ عِ يَ شْرِ، قَ عَ قَلَ، ‹شَ عِ مِنِ دَرِ سَلَمُ تَا كُي، ﭑ عِ قَشَمَ نّ نَ لْشْي يَتِ؟› عِ مُ عَ قَلَ شّ ﭑ بّ عَ عِ ﭑ شُي سُشُمَ نّ عَ قَنيِ رَ؟ <verse eid="1KI 2:42"/><verse number="43" style="v" sid="1KI 2:43"/>مُنقٍ رَ عِ مُ تِن نَ لَايِدِ رَكَمَلِدٍ عِ نَشَن تٌنفٌ عَلَتَلَ بّ؟ مُنقٍ رَ عِ مُ ﭑ مَ يَامَرِ سُشُ؟» <verse eid="1KI 2:43"/><verse number="44" style="v" sid="1KI 2:44"/>مَنفّ نَشَ عَ قَلَ سِمٍيِ بّ، «عِ عَ كٌلٌن عِ قٍ حَاشِ نَشَن بِرِن نَبَ ﭑ بَبَ رَ، مَنفّ دَوُدَ، عَلَتَلَ قَمَ نَ سَرٍ رَفبِلٍندٍ عِ مَ، <verse eid="1KI 2:44"/><verse number="45" style="v" sid="1KI 2:45"/>كْنْ عَ بَرَ بَرَكّ سَ مَنفّ سُلٍمَنِ مَ. دَوُدَ شَ مَنفّيَ مَبَنبَنشِ عَ قَنيِ رَ عَلَتَلَ يَ عِ.» <verse eid="1KI 2:45"/><verse number="46" style="v" sid="1KI 2:46"/>نَ تّمُي مَنفّ نَشَ يٍهٌيَدَ شَ دِ بّنَيَ يَمَرِ عَ شَ سِمٍيِ قَشَ. عَ نَشَ نَ رَبَ. سُلٍمَنِ شَ مَنفّيَ مَبَنبَن نَ كِ نّ.<verse eid="1KI 2:46"/></para>
  <chapter eid="1KI 2"/>
  <chapter number="3" style="c" sid="1KI 3"/>
  <para style="s">سُلٍمَنِ شَ شَشِلِمَيَ</para>
  <para style="r">يُدَيَ مَنفّيٍ عِِ ١‏؛٢ ٬ ١٣</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 3:1"/>سُلٍمَنِ نَشَ لَنيِ شِرِ عَ تَن نُن مِسِرَ مَنفّ قِرَوُنَ تَفِ قُتِ رَ، عَ نَ شَ دِ فِنّ دْشْ. عَ نَشَ نَ فِنّ يِفِيَ «دَوُدَ شَ تَا» كُي، بَرِ مَ عَ مُ نُ فّشِ عَ شَ مَنفّ بَنشِ، عَلَتَلَ شَ هْرْ مْبَنشِ، نُن دَرِ سَلَمُ تّتّ تِدٍ. <verse eid="1KI 3:1"/><verse number="2" style="v" sid="1KI 3:2"/>حَمَ نُ سّرّشّ بَمَ فٍيَيٍ نَن قَرِ، بَرِ مَ عَلَتَلَ شَ بَنشِ مُ نُ تِشِ سِندٍن. <verse eid="1KI 3:2"/><verse number="3" style="v" sid="1KI 3:3"/>سُلٍمَنِ نُ عَلَتَلَ شَنُمَ، عَ مَن نُ بِرَ مَ عَ بَبَ دَوُدَ شَ يَامَرِيٍ قْشْ رَ، كْنْ عَ قَن نُ سّرّشّ نُن سُرَيِ بَمَ فٍيَيٍ نَن قَرِ عَلْ بٌورٍيٍ.<verse eid="1KI 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1KI 3:4"/>مَنفّ نَشَ سِفَ فَبَيٌن سّرّشّ بَدٍ، بَرِ مَ نَ فٍيَ تِدٍ نُ فبٌ. سُلٍمَنِ نَشَ سّرّشّ فَن دَاشِ وُلُ كٍرٍن بَ مّننِ نَ سّرّشّبَدٍ قَرِ. <verse eid="1KI 3:4"/><verse number="5" style="v" sid="1KI 3:5"/>عَلَتَلَ نَشَ مِنِ سُلٍمَنِ مَ شِيٍ كُي فَبَيٌن كْي رَ. عَلَ نَشَ عَ قَلَ عَ بّ، «عِ وَ مَ قٍ نَشَن يٌ شْن، عَ قَلَ ﭑ بّ ﭑ شَ عَ قِ عِ مَ.» <verse eid="1KI 3:5"/><verse number="6" style="v" sid="1KI 3:6"/>سُلٍمَنِ نَشَ عَ يَابِ، عَ نَشّ، «عِ بَرَ هِننّنتٍيَ بٍلٍبٍلٍ رَبَ عِ شَ كٌنيِ ﭑ بَبَ دَوُدَ بّ، بَرِ مَ عَ عَ حّرّ نّ عِ يَ عِ نْندِ رَ، تِنشِنيِ رَ، نُن حَنِفٍ قِيشّ رَ. عِ بَرَ هِننّ عَ رَ، عِ دِ قِ عَ مَ، نَشَن مَفٌرٌشِ عَ شَ كِبَنيِ كُي. نَ نَن عَ نِيَشِ ﭑ بّ تٌ. <verse eid="1KI 3:6"/><verse number="7" style="v" sid="1KI 3:7"/>يَكْسِ، ﭑ مَرِفِ عَلَتَلَ، عِ تَن نَن ﭑ مَفٌرٌشِ مَنفّ كِبَنيِ كُي ﭑ بَبَ دَوُدَ حْشْي رَ. ﭑ لُشِ عَلْ دِ مّدِ يِ مَنفّيَ كُي. <verse eid="1KI 3:7"/><verse number="8" style="v" sid="1KI 3:8"/>ﭑ نَ عِ شَ حَمَ سُفَندِشِ تَفِ، نَشَن وُيَ هَن عٍ كْنتِ مُ نْمَ كْنتِدٍ. <verse eid="1KI 3:8"/><verse number="9" style="v" sid="1KI 3:9"/>شَشِلِمَيَ قِ ﭑ مَ، عَلَكٌ ﭑ شَ نْ حَمَ رَحّرّدٍ عَ قَنيِ رَ، ﭑ شَ نْ قٍ قَنيِ نُن قٍ حَاشِ تَفِ رَ سَدٍ. شَ نَ مُ، ندٍ قَتَ يِ حَمَ رَحّرّدٍ؟»<verse eid="1KI 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 3:10"/>سُلٍمَنِ شَ مَشَندِ نَشَ رَقَن مَرِفِ مَ. <verse eid="1KI 3:10"/><verse number="11" style="v" sid="1KI 3:11"/>نَ كُي، عَلَ نَشَ عَ مَسٍن سُلٍمَنِ بّ، «عِ تٌ وَشِ شَشِلِمَيَ نَن شْن يِ حَمَ رَحّرّقٍ رَ، عِ مُ سِمَيَ شْنكُيٍ شَ مَشْرِنشِ، عِ مُ بَننَيَ شَ مَشْرِنشِ، عِ مُ عِ يَشُييٍ قَشَقٍ شَ مَشْرِنشِ، <verse eid="1KI 3:11"/><verse number="12" style="v" sid="1KI 3:12"/>ﭑ بَرَ عِ شَ مَشَندِ سُشُ. ﭑ شَشِلِمَيَ قَنيِ قِمَ نّ عِ مَ، نَشَن مَنِيّ مُ تٌشِ سِندٍن، عَ مَن مُ تٌمَ تّمُييٍ مَ نَشٍيٍ سَ قَمَ. <verse eid="1KI 3:12"/><verse number="13" style="v" sid="1KI 3:13"/>ﭑ بَننَيَ نُن بِنيّ قِمَ نّ عِ مَ، نَشٍيٍ مَنِيّ مُ تٌمَ مَنفّ فبّتّيٍ يِ عِ شَ وَشَتِ، هَلِ عِ تٌ مُ عٍ مَشْرِنشِ. <verse eid="1KI 3:13"/><verse number="14" style="v" sid="1KI 3:14"/>شَ عِ بِرَ ﭑ مَ كِرَ قْشْ رَ، عِ ﭑ مَ سّرِيّ نُن ﭑ مَ يَامَرِ رَتِنمّ، عَلْ عِ بَبَ دَوُدَ عَ رَبَ كِ نَشّ، ﭑ عِ شَ سِمَيَ عِكُيَمَ نّ.»<verse eid="1KI 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 3:15"/>نَ تّمُي سُلٍمَنِ نَشَ شُنُ نَ شِيٍ مَ. عَ نَشَ فبِلٍن دَرِ سَلَمُ عَلَتَلَ شَ سَاتّ كَنكِرَ يِرٍ. عَ نَشَ سّرّشّ فَن دَاشِيٍ نُن شَنُنتٍيَ سّرّشّيٍ بَ، عَ قَ نَ دٌن عَ تَن نُن عَ شَ مِشِيٍ بِرِن نَ.<verse eid="1KI 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1KI 3:16"/>لَنفٌي فِنّ قِرِن نَشَ سِفَ مَنفّ يِرٍ كِيتِ قٍنقٍ رَ عَ يِ. <verse eid="1KI 3:16"/><verse number="17" style="v" sid="1KI 3:17"/>نَ فِنّ ندٍ نَشَ عَ قَلَ عَ بّ، عَ نَشّ، «ﭑ مَرِفِ عِ شَ عِ هَاكّ تٌ ﭑ بّ. ﭑ نُن يِ فِنّ، مُشُ بِرِن نَن نَ بَنشِ كٍرٍن كُي. ﭑ نَشَ دِ بَرِ عَ يَ شْرِ. <verse eid="1KI 3:17"/><verse number="18" style="v" sid="1KI 3:18"/>شِ سَشَن تٌ دَنفِ، عَ قَن نَشَ دِ بَرِ. مُشُ دٌرٌ نَن تُن نُ عَ رَ، مِشِ فبّتّ يٌ مُ نُ نَ بَنشِ كُي قٌ مُشُ قِرِن ثٍتِ. <verse eid="1KI 3:18"/><verse number="19" style="v" sid="1KI 3:19"/>كْي ندٍ كُي، يِ فِنّ نَشَ عَ سَ عَ شَ دِ قَرِ، عَ شَ دِ نَشَ قَشَ. <verse eid="1KI 3:19"/><verse number="20" style="v" sid="1KI 3:20"/>عَ تٌ نَ تٌ، عَ نَشَ ﭑ مَ دِ تٌنفٌ ﭑ سّيتِ مَ، عَ قَ عَ شَ دِ قَشَشِ سَ ﭑ تَن قّ مَ. ﭑ نُ شِقٍ، ﭑ مُ نُ نَ سٍسٍ كٌلٌن. <verse eid="1KI 3:20"/><verse number="21" style="v" sid="1KI 3:21"/>فّيسّفّ ﭑ تٌ كٍلِ ﭑ شَ شِحّ قِ ﭑ مَ دِ مَ، ﭑ نَشَ عَ تٌ نَ دِ بَرَ قَشَ. كْنْ ﭑ تٌ عَ عِفبّ قَ عَ قَنيِ رَ، ﭑ نَشَ عَ تٌ ﭑ مَ دِ مُ عَ رَ، ﭑ نَشَن بَرِشِ.»<verse eid="1KI 3:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 3:22"/>بٌورٍ فِنّ نَشَ وْيّنيِ تٌنفٌ، عَ عَ قَلَ، «عَ مُ نَ نَ كِ شّ. ﭑ مَ دِ نَن بَلٌشِ، عِ تَن نَن شَ دِ قَشَشِ.» فِنّ سِنفٍ نَشَ بٌورٍ مَتَندِ عَ قَلَقٍ رَ، «عِ وُلٍ! ﭑ مَ دِ شَ مُ قَشَشِ، ﭑ فبٍ نَن بَلٌشِ.» عٍ نُ وْيّنمَ نَ كِ نّ مَنفّ يَ شْرِ. <verse eid="1KI 3:22"/><verse number="23" style="v" sid="1KI 3:23"/>نَ كُي مَنفّ نَشَ يِ مَسٍنيِ تِ عٍ بّ، «ندٍ نَشّ، ‹ﭑ مَ دِ نَن بَلٌشِ، عِ فبٍ نَن قَشَشِ.› بٌورٍ نَشّ، ‹عِ وُلٍ. ﭑ فبٍ نَن بَلٌشِ، عِ فبٍ نَن قَشَشِ.›»<verse eid="1KI 3:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1KI 3:24"/>نَ وْيّنيِ دَنفِ شَنبِ، مَنفّ نَشَ مِشِيٍ يَمَرِ، «وٌ قَ سَنتِدّفّمَ رَ ﭑ بّ بَ.» عٍ تٌ قَ نَ سَنتِدّفّمَ رَ عَ شْن مَ، <verse eid="1KI 3:24"/><verse number="25" style="v" sid="1KI 3:25"/>عَ نَشَ عَ قَلَ عٍ بّ، «وٌ يِ دِيْرّ بَلٌشِ عِبٌلٌن عَ تَفِ، وٌ سّيتِ ندٍ سٌ يِ فِنّ يِ رَ، وٌ بٌورٍ سّيتِ سٌ نَ بٌورٍ فِنّ يِ رَ.»<verse eid="1KI 3:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 3:26"/>نَ تّمُي فِنّ نَشَن شَ دِ بَلٌشِ، نَ بْحّ نَشَ عَ شَبَ عَ شَ دِ شَ قٍ شَنُنتٍيَ شَقٍ رَ، هَن عَ عَ قَلَ مَنفّ بّ، «يَندِ، ﭑ بَرَ عِ مَشَندِ ﭑ مَرِفِ، وٌ دِ بَلٌشِ سٌ عَ يِ رَ، وٌ نَشَ يِ دِ قَشَ.» كْنْ بٌورٍ فِنّ تَن نَشَ عَ قَلَ، «يِ دِ نَشَ لُ ﭑ يِ رَ، عَ نَشَ لُ عِ قَن يِ رَ. وٌ عَ عِبٌلٌن!» <verse eid="1KI 3:26"/><verse number="27" style="v" sid="1KI 3:27"/>مَنفّ تٌ نَ مّ، عَ نَشَ عَ مَسٍن، «وٌ نَشَ دِيْرّ قَشَ. وٌ شَ يِ دِ بَلٌشِ سٌ نَ فِنّ سِنفٍ يِ رَ، عَ نفَ نَن نَ كِ.»<verse eid="1KI 3:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1KI 3:28"/>عِسِرَيِلَ حَمَ تٌ مَنفّ شَ كِيتِ مّ، عٍ نَشَ فَاشُ عَ يَ رَ، بَرِ مَ عٍ نُ بَرَ عَ كٌلٌن عَلَ شَشِلِ نَن نَ عَ بْحّ مَ مَنفّيَ رَحّرّقٍ رَ تِنشِنيِ كُي.<verse eid="1KI 3:28"/></para>
  <chapter eid="1KI 3"/>
  <chapter number="4" style="c" sid="1KI 4"/>
  <para style="s">سُلٍمَنِ شَ كُنتِفِ شُنفبٍيٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 4:1"/>مَنفّ سُلٍمَنِ نُ عِسِرَيِلَ بْشِ بِرِن يَمَرِ مَ. <verse eid="1KI 4:1"/><verse number="2" style="v" sid="1KI 4:2"/>عَ شَ كُنتِفِ شُنفبٍيٍ نَن يِ كِ؛</para>
  <para style="q" vid="1KI 4:2">سَدْكِ شَ دِ عَسَرَيَ، نَشَن قِندِ سّرّشّدُبّ رَ.<verse eid="1KI 4:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="1KI 4:3"/>سِقَ شَ دِ عٍلِشٌرٍقَ نُن عَهِيَ، نَشٍيٍ قِندِ سّبّلِتِيٍ رَ.</para>
  <para style="q" vid="1KI 4:3">عَشِلُدُ شَ دِ يٍهٌسَقَتِ، نَشَن قِندِ كّيدِ رَفَتّ رَ.<verse eid="1KI 4:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="1KI 4:4"/>يٍهٌيَدَ شَ دِ بّنَيَ، نَشَن قِندِ سْورِيٍ شَ مَنفّ رَ.</para>
  <para style="q" vid="1KI 4:4">سَدْكِ نُن عَبِيَتَرِ، نَشٍيٍ قِندِ سّرّشّدُبّيٍ رَ.<verse eid="1KI 4:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="1KI 4:5"/>نَتَن شَ دِ عَسَرِيَهُ، نَشَن قِندِ فٌمِنَيٍ شَ مَنفّ رَ.</para>
  <para style="q" vid="1KI 4:5">نَتَن شَ دِ سَبَدِ، نَشَن قِندِ مَنفّ شَ سّرّشّدُبّ رَ.<verse eid="1KI 4:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="1KI 4:6"/>عَهِسَرِ، نَشَن قِندِ مَنفّ شَ بَنشِ وَلِكّيٍ شُنيِ رَ.</para>
  <para style="q" vid="1KI 4:6">عَبٍدَ شَ دِ عَدٌنِرَ مِ، نَشَن قِندِ كٌنيِيٍ شُنيِ رَ.<verse eid="1KI 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 4:7"/>مَنفّ سُلٍمَنِ نُ بَرَ فٌمِنَ قُ نُن قِرِن تِ عِسِرَيِلَ بْشِ شُن مَ. كِكٍ يٌ كِكٍ حّ كُي، فٌمِنَ كٍرٍن نُ قَمَ بَلٌي رَ مَنفّ نُن عَ شَ دٍنبَيَ بّ. <verse eid="1KI 4:7"/><verse number="8" style="v" sid="1KI 4:8"/>عٍ شِلِيٍ نَن يَ؛</para>
  <para style="q" vid="1KI 4:8">شُرُ شَ دِ، نَشَن نُ فٌمِنَ رَ عٍقِرَ مِ بْنسْي شَ فٍيَ بْشِ شُن مَ.<verse eid="1KI 4:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="1KI 4:9"/>دٍكٍرِ شَ دِ، نَشَن نُ فٌمِنَ رَ مَكَسَ، سَالَبِمِ، بٍتِ سٍمٍسِ، عٍلٌن، نُن بٍتِ هَنَن تَايٍ شُن مَ.<verse eid="1KI 4:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="1KI 4:10"/>شٍسٍدَ شَ دِ، نَشَن نُ فٌمِنَ رَ عَرُبٌتُ، سٌكٌ، نُن شٍقٍرِ بْشِ شُن مَ.<verse eid="1KI 4:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="1KI 4:11"/>عَبِنَدَبٌ شَ دِ، نَشَن نُ فٌمِنَ رَ دْرْ بْشِ شُن مَ،</para>
  <para style="q" vid="1KI 4:11">نَشَن مَنفّ سُلٍمَنِ شَ دِ فِنّ تَقَتِ دْشْ.<verse eid="1KI 4:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="1KI 4:12"/>عَشِلُدُ شَ دِ بَنَ، نَشَن نُ فٌمِنَ رَ تَانَكِ، مٍفِدٌ، نُن بٍتِ سَان شُن مَ،</para>
  <para style="q" vid="1KI 4:12">دّننَشّ نَ سَرَتَن سّيتِ مَ.</para>
  <para style="q" vid="1KI 4:12">عَ تَن نَن نُ فٌمِنَ رَ يِسِرٍيلِ قَن شُن مَ، كٍلِقٍ بٍتِ سَان هَن عَبٍلِ مٍشٌلَ، هَن يٌكِنٍيَمِ شَنبِ رَ.<verse eid="1KI 4:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="1KI 4:13"/>فٍبٍرِ شَ دِ، نَشَن نُ فٌمِنَ رَ رَ مٌتِ، فَلَدِ بْشِ مَ.</para>
  <para style="q" vid="1KI 4:13">عَ تَن نَن نُ فٌمِنَ رَ مَنَسِ شَ دِ يَيِرِ شَ تَايٍ شُن مَ، فَلَدِ بْشِ مَ.</para>
  <para style="q" vid="1KI 4:13">عَ تَن نَن نُ فٌمِنَ رَ نَ بْشِ شُن مَ، كٍلِقٍ عَرَفٌبٌ هَن بَسَن،</para>
  <para style="q" vid="1KI 4:13">تَا شُنفبٍ مَكَنتَشِ تٌنفٌ سٍننِ نُ نَ دّننَشّ.<verse eid="1KI 4:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="1KI 4:14"/>عِدٌ شَ دِ عَشِنَدَبٌ نَن نُ فٌمِنَ رَ مَشَنَيِمِ شُن مَ.<verse eid="1KI 4:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="1KI 4:15"/>عَشِمَاسِ نَن نُ فٌمِنَ رَ نَقَتَلِ بْشِ شُن مَ،</para>
  <para style="q" vid="1KI 4:15">نَشَن مَنفّ سُلٍمَنِ شَ دِ فِنّ بَسَمَتِ دْشْ.<verse eid="1KI 4:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="1KI 4:16"/>شُسَيِ شَ دِ بَنَ نَن نُ فٌمِنَ رَ عَسٍرِ نُن بٍيَلٌتِ شُن مَ.<verse eid="1KI 4:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="1KI 4:17"/>ثَرُوَ شَ دِ يٍهٌسَقَتِ نَن نُ فٌمِنَ رَ عِسَكَرِ بْشِ شُن مَ.<verse eid="1KI 4:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="1KI 4:18"/>عٍلَ شَ دِ سِمٍيِ نَن نُ فٌمِنَ رَ بُنيَمِن بْشِ شُن مَ.<verse eid="1KI 4:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="1KI 4:19"/>عُرِ شَ دِ فٍبٍرِ نَن نُ فٌمِنَ رَ فَلَدِ بْشِ شُن مَ،</para>
  <para style="q" vid="1KI 4:19">عَ عَمٌرِكَيٍ شَ مَنفّ سِشْن شَ بْشِ،</para>
  <para style="q" vid="1KI 4:19">نُن بَسَنكَيٍ شَ مَنفّ عٌفٌ شَ بْشِ.</para>
  <para style="q" vid="1KI 4:19">فٍبٍرِ كٍرٍن نَن نُ نَ بْشِ بِرِن فٌمِنَ رَ.<verse eid="1KI 4:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1KI 4:20"/>يُدَيَكَيٍ نُن عِسِرَيِلَكَيٍ نُ وُيَ عَلْ بَا دّ رَ مّيّنيِ. عٍ نُ عٍ دّفٍمَ، عٍ نُ عٍ مِنمَ سّيوّ كُي.<verse eid="1KI 4:20"/></para>
  <chapter eid="1KI 4"/>
  <chapter number="5" style="c" sid="1KI 5"/>
  <para style="s">سُلٍمَنِ شَ مَنفّيَ</para>
  <para style="r">يُدَيَ مَنفّيٍ عِِ ٢‏؛١ ٬ ١٦</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 5:1"/>مَنفّ سُلٍمَنِ نُ بْشِ بِرِن يَمَرِ مَ، كٍلِقٍ عٍقِرَتِ شُرٍ مَ، هَن قِلِسِتَ بْشِ، هَن مِسِرَ نَانِنيِ رَ. نَ مِشِ بِرِن نُ دُوتِ قِمَ مَنفّ سُلٍمَنِ مَ عَ شَ سِمَيَ بِرِن كُي.<verse eid="1KI 5:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1KI 5:2"/>مَنفّ سُلٍمَنِ نُن عَ شَ مِشِيٍ بَلٌي قِندِ يِ نَن نَ لْشْي كٍرٍن كُي؛ قَرِن قُحِ دَاشِ بُسَلِ كّمّ تٌنفٌ سَشَن، حْيرَبَ بُسَلِ كّمّ قِرِن تٌنفٌ نَانِ، <verse eid="1KI 5:2"/><verse number="3" style="v" sid="1KI 5:3"/>نِنفٍ بْرْفّشِ قُ، نِنفٍ دّ مَدٌن دَاشِ مْشْحّن، شُرُ سٍ لَنمَ كّمّ، بٌلٍيٍ، شٍلِيٍ، بُرُنيِ سِيٍ، نُن شْنِ بْرْفّشِيٍ.<verse eid="1KI 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1KI 5:4"/>مَنفّ سُلٍمَنِ نَن نُ بْشِ بِرِن يَمَرِ مَ نَشٍيٍ نُ نَ عٍقِرَتِ شُرٍ يِرٍقَنيِ مَ، كٍلِقٍ تِقِسَ هَن فَسَ. نَ بْشِ مَنفّيٍ نُن عٍ شَ مِشِيٍ نُ سَبَتِشِ بْحّسَ نَن كُي. <verse eid="1KI 5:4"/><verse number="5" style="v" sid="1KI 5:5"/>يُدَيَكَيٍ نُن عِسِرَيِلَكَيٍ بِرِن، كٍلِقٍ دَنَ هَن بٍرِ سٍيبَ، نُ سَبَتِشِ بْحّسَ نَن كُي عٍ شَ وّنِ بِلِيٍ نُن عٍ شَ شْرّ بِلِيٍ تَفِ سُلٍمَنِ شَ مَنفّيَ بُن مَ.<verse eid="1KI 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 5:6"/>سٌي فْورّ وُلُ تٌنفٌ نَانِ نُ نَ سُلٍمَنِ يِ رَ، نَشٍيٍ نُ عَ شَ سْورِ رَفِسٍيٍ بّندُنمَ. سٌي رَفِ مِشِ وُلُ قُ نُن قِرِن نَن نُ نَ سُلٍمَنِ يِ رَ. <verse eid="1KI 5:6"/><verse number="7" style="v" sid="1KI 5:7"/>سُلٍمَنِ شَ فٌمِنَ قُ نُن قِرِنيِيٍ نُ قَمَ بَلٌي رَ عَ بّ نُن عَ شَ مِشِيٍ بّ. كِكٍ يٌ كِكٍ فٌمِنَ ندٍ نُ قَمَ مَنفّ هَيِ بِرِن نَ. <verse eid="1KI 5:7"/><verse number="8" style="v" sid="1KI 5:8"/>عٍ نُ قَمَ مّنفِ نُن سّشّ رَ سٌي بِرِن بّ فْورّيٍ كُي.<verse eid="1KI 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 5:9"/>عَلَ شَشِلِمَيَ، لْننِ، نُن قَهَامُي فبٍفبٍ نَن سٌ سُلٍمَنِ يِ رَ. عٍ نُ فبٌ عَلْ بَا دّ رَ مّيّنيِ. <verse eid="1KI 5:9"/><verse number="10" style="v" sid="1KI 5:10"/>سُلٍمَنِ شَ شَشِلِمَيَ نُ دَنفِ قُفٍرَكَيٍ نُن مِسِرَكَيٍ شَ شَشِلِمَيَ بِرِن نَ. <verse eid="1KI 5:10"/><verse number="11" style="v" sid="1KI 5:11"/>عَ شَ شَشِلِمَيَ نُ دَنفِ مِشِ بِرِن نَ، هَلِ عٍتَنِ عٍسِرَكَ، مَشٌلٌ شَ دِيٍ هٍمَن، كَلِكْلِ، نُن دَرَدَ. عَ شِلِ نَشَ دِن بْشِ بِرِن نَ نَشٍيٍ نُ عِسِرَيِلَ رَبِلِنيِ. <verse eid="1KI 5:11"/><verse number="12" style="v" sid="1KI 5:12"/>عَ تَالِ وُلُ سَشَن نَن قَلَ، عَ نُن بّيتِ وُلُ كٍرٍن نُن سُولِ. <verse eid="1KI 5:12"/><verse number="13" style="v" sid="1KI 5:13"/>عَ وُرِ فبٍفبٍيٍ شَ قٍ قَلَ، عَ قْلْقٍ لِبَن وُرِ شُنفبٍ مَ نَشَن شِلِ سّدِرِ، عَ سَ هِسٌثِ سَنسِ شُنشُرِ لِ نَشَن بُلَمَ بَنشِ شَلّ مَ. عَ سُبٍيٍ، شْنِيٍ، بُبُسٍيٍ، نُن يّشّيٍ قَن شَ قٍ قَلَ. <verse eid="1KI 5:13"/><verse number="14" style="v" sid="1KI 5:14"/>دُنِحَ مَنفّيٍ نُ لُمَ مِشِيٍ شّي رَ عٍ شَ قَ مَنفّ سُلٍمَنِ شَ لْننِ نُن شَشِلِمَيَ رَ مّ.<verse eid="1KI 5:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 5:15"/>تِرٍ مَنفّ شِرَ مِ نَشَ كُنتِفِيٍ شّي مَنفّ سُلٍمَنِ شْن، بَرِ مَ عَ نُ بَرَ عَ مّ عَ عَ تَن نَن تِشِ مَنفّ رَ عَ بَبَ حْشْي رَ. شِرَ مِ نُ بَرَ سُلٍمَنِ بَبَ دَوُدَ شَنُ كَبِ عَ رَكُيَ. <verse eid="1KI 5:15"/><verse number="16" style="v" sid="1KI 5:16"/>سُلٍمَنِ نَشَ شِرَ مِ يَابِ، <verse eid="1KI 5:16"/><verse number="17" style="v" sid="1KI 5:17"/>«عِ نُ ﭑ بَبَ دَوُدَ كٌلٌن، عَ مُ نْ بَنشِ تِدٍ عَ مَرِفِ عَلَتَلَ بّ فٍرٍ شَ قٍ رَ، نَشَن نُ نَ عَ يِرٍ بِرِن هَن عَلَتَلَ نَشَ عَ يَشُييٍ سَ عَ سَنيِ بُن مَ. <verse eid="1KI 5:17"/><verse number="18" style="v" sid="1KI 5:18"/>يَكْسِ عَلَتَلَ بَرَ عَ رَفِرِ ﭑ شَ لُ بْحّسَ كُي. فٍرٍ نُن قٍ شْنّ بَرَ حْن. <verse eid="1KI 5:18"/><verse number="19" style="v" sid="1KI 5:19"/>نَ كُي ﭑ بَرَ عَ حَنِفٍ ﭑ شَ بَنشِ تِ ﭑ مَرِفِ عَلَتَلَ بّ عَلْ عَ عَ يِتَشِ كِ نَشّ ﭑ بَبَ دَوُدَ بّ. عَ نَشَ عَ مَسٍن عَ بّ، ‹عِ شَ دِ، ﭑ نَشَن دْشْمَ عِ شَ كِبَنيِ كُي عِ حْشْي رَ، نَ نَن قَمَ بَنشِ تِدٍ ﭑ بّ.› <verse eid="1KI 5:19"/><verse number="20" style="v" sid="1KI 5:20"/>عِ نَشَن نَبَمَ، عِ شَ يَامَرِ قِ لِبَن سّدِرِ وُيَشِيٍ شَ شَبَ ﭑ بّ. ﭑ مَ وَلِكّيٍ كَقُمَ نّ عِ شَ وَلِكّيٍ مَ. ﭑ عٍ شَ وَلِ سَرٍ قِمَ نّ عَلْ عِ وَ مَ عَ شْن كِ نَشّ. مِشِ يٌ مُ نَ نَشَن قَتَ وُرِ شَبَدٍ عَلْ سِدْنكَيٍ.»<verse eid="1KI 5:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1KI 5:21"/>مَنفّ شِرَ مِ تٌ سُلٍمَنِ شَ وْيّنيِ مّ، عَ نَشَ سّيوَ كِ قَنيِ رَ، عَ قَ عَ قَلَ، «عَلَتَلَ تَنتُ. عَ بَرَ دِ شَشِلِمَ قِ دَوُدَ مَ نَشَن نْمَ يِ حَمَ شُنفبٍ رَحّرّدٍ.» <verse eid="1KI 5:21"/><verse number="22" style="v" sid="1KI 5:22"/>شِرَ مِ نَشَ سُلٍمَنِ يَابِ، عَ نَشّ، «ﭑ بَرَ عِ شَ مَسٍنيِ مّ. ﭑ عِ وَشْنقٍ بِرِن نَبَمَ نّ، سّدِرِ وُرِيٍ نُن سِثِرّ وُرِيٍ شَ قٍ رَ. <verse eid="1KI 5:22"/><verse number="23" style="v" sid="1KI 5:23"/>ﭑ مَ وَلِكّيٍ وُرِيٍ رَفٌرٌ مَ نّ كٍلِقٍ لِبَن هَن بَا دّ رَ. ﭑ عٍ شِرِ مَ عٍ بٌورٍ رَ، عَلَكٌ ﭑ شَ عٍ رَحّرّ بَا قَرِ هَن عِ وَ مَ دّننَشّ شْن. مّننِ ﭑ عٍ رَقُلُنمَ، عِ قَ عٍ شَنِن. ﭑ تَن وَ مَ نَشَن شْن نَ وَلِ سَرٍ رَ، عِ شَ بَلٌي قِ ﭑ تَن نُن ﭑ مَ مِشِيٍ مَ.»<verse eid="1KI 5:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1KI 5:24"/>مَنفّ شِرَ مِ نَشَ سّدِرِ وُرِ نُن سِثِرّ وُرِ بِرِن سٌ مَنفّ سُلٍمَنِ يِ رَ، عَ نُ وَ مَ نَشَن شْن. <verse eid="1KI 5:24"/><verse number="25" style="v" sid="1KI 5:25"/>حّ يٌ حّ، مَنفّ سُلٍمَنِ نُ قَرِن بُسَلِ وُلُ تٌنفٌ سٌلٌمَسَشَن نُن تُرٍ قِقَ مْشْحّن قِمَ نّ شِرَ مِ مَ عَ شَ بَنشِ بَلٌي شَ قٍ رَ. <verse eid="1KI 5:25"/><verse number="26" style="v" sid="1KI 5:26"/>عَلَتَلَ شَشِلِمَيَ قِ نّ سُلٍمَنِ مَ عَلْ عَ عَ قَلَ عَ بّ كِ نَشّ. دّقَنيِ نَشَ لُ شِرَ مِ نُن سُلٍمَنِ تَفِ، عٍ قَ سَاتّ شِرِ عٍ بٌورٍ بّ.<verse eid="1KI 5:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1KI 5:27"/>مَنفّ سُلٍمَنِ نَشَ عِسِرَيِلَكَ وُلُ تٌنفٌ سَشَن يَمَرِ عٍ شَ وَلِ عَ بّ. <verse eid="1KI 5:27"/><verse number="28" style="v" sid="1KI 5:28"/>كِكٍ يٌ كِكٍ، عَ نَشَ مِشِ وُلُ قُ رَ سِفَ لِبَن بْشِ مَ، عٍ شَ وَلِ كِكٍ كٍرٍن مّننِ، عٍ قَ كِكٍ قِرِن نَبَ عٍ شْنيِ. عَدٌنِرَ مِ نَن نُ نَ نَ قٍ شُنيِ رَ. <verse eid="1KI 5:28"/><verse number="29" style="v" sid="1KI 5:29"/>مِشِ وُلُ تٌنفٌ سٌلٌقٍرٍ نَن نُ كٌتٍ مَشَنِنمَ، مِشِ وُلُ تٌنفٌ سٌلٌمَسَشَن نَن نُ فّمّ مَسٌلِمَ مَنفّ سُلٍمَنِ بّ فٍيَيٍ كْن نَ لِبَن. <verse eid="1KI 5:29"/><verse number="30" style="v" sid="1KI 5:30"/>سُلٍمَنِ شَ فٌمِنَيٍ نُ بَرَ مِشِ وُلُ سَشَن كّمّ سَشَن سُفَندِ نَشٍيٍ نُ وَلِ شُن مَتٌمَ عَ رَ. <verse eid="1KI 5:30"/><verse number="31" style="v" sid="1KI 5:31"/>مَنفّ نُ بَرَ يَامَرِ قِ، عَ وَلِكّيٍ شَ فّمّ شُنفبٍ تٌقَنيِيٍ مَسٌلِ نَشٍيٍ قِندِ مَ عَلَ شَ بَنشِ سَنبُنيِ رَ. <verse eid="1KI 5:31"/><verse number="32" style="v" sid="1KI 5:32"/>سُلٍمَنِ نُن شِرَ مِ شَ بَنشِتِيٍ نُن فٍبَلَكَيٍ نَشَ فّمّيٍ مَسٌلِ.</para>
  <para style="p" vid="1KI 5:32">وُرِيٍ نُن فّمّيٍ يَءِلَن نَ كِ نّ عَلَ شَ بَنشِ شَ قٍ رَ.<verse eid="1KI 5:32"/></para>
  <chapter eid="1KI 5"/>
  <chapter number="6" style="c" sid="1KI 6"/>
  <para style="s">عَلَتَلَ شَ هْرْ مْبَنشِ تِقٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 6:1"/>حّ كّمّ نَانِ حّ تٌنفٌ سٌلٌمَسَشَن تٌ دَنفِ كٍلِقٍ عِسِرَيِلَ مِنِ مِسِرَ بْشِ رَ تّمُي نَشّ، مَنفّ سُلٍمَنِ نَشَ عَلَتَلَ شَ هْرْ مْبَنشِ تِ قْلْ سِوِ كِكٍ كُي. نَ حّ قِندِشِ عَ شَ مَنفّيَ حّ نَانِ ندٍ نَن نَ عِسِرَيِلَ بْشِ شُن مَ. <verse eid="1KI 6:1"/><verse number="2" style="v" sid="1KI 6:2"/>سُلٍمَنِ عَلَ شَ بَنشِ تِ يِ مَنِيّ شَسَبِ نَن نَ؛ عَ كُيّ حْنفْن يَ تٌنفٌ سٍننِ، عَ فبٌي حْنفْن يَ مْشْحّن، عَ عِتٍ حْنفْن يَ تٌنفٌ سَشَن. <verse eid="1KI 6:2"/><verse number="3" style="v" sid="1KI 6:3"/>عَ يَتَفِ بُنتُنيِ شَ كُيّ نُ لَنشِ حْنفْن يَ مْشْحّن نَن مَ، عَلْ بَنشِ شَ كُيّ نَ كِ نَشّ. عَ فبٌي قَن قِندِ حْنفْن يَ مْشْحّن نَن نَ.<verse eid="1KI 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1KI 6:4"/>عَ وُندّرِيٍ نُ يَءِلَنشِ بَنشِ شَلّ نَن كُي، وُرِيٍ قَن نُ يَءِلَنشِ عٍ قَرِ. <verse eid="1KI 6:4"/><verse number="5" style="v" sid="1KI 6:5"/>عَ نَشَ كٌنكٌي قَتُ هْرْ مْبَنشِ شَلّ رَبِلِنيِ. <verse eid="1KI 6:5"/><verse number="6" style="v" sid="1KI 6:6"/>كٌنكٌي سِنفٍيٍ شَ فبٌي نُ لَنشِ حْنفْن يَ سُولِ نَن مَ. نٍيٍ قَرِ كٌنكٌي فبّتّيٍ نَشَ دْشْ نَشٍيٍ شَ فبٌي نُ لَنشِ حْنفْن يَ سٍننِ مَ. نٍيٍ قَن قَرِ كٌنكٌي فبّتّيٍ نَشَ دْشْ نَشٍيٍ شَ فبٌي نُ لَنشِ حْنفْن يَ سٌلٌقٍرٍ مَ. هْرْ مْبَنشِ شَلّ شَ مَرَبِنيٍ نُ رَشُرُنشِ عَ قُفٍ بِرِ رَ، عَلَكٌ كٌنكٌييٍ مَسَ وُرِيٍ مُ سٌمَ بَنشِ شَلّ كُي كِ نَشّ. <verse eid="1KI 6:6"/><verse number="7" style="v" sid="1KI 6:7"/>عٍ تٌ نُ هْرْ مْبَنشِ تِمَ، عٍ نُ فّمّيٍ رَوَلِمَ نَشٍيٍ حَن نُ بَرَ مَسٌلِ فٍيَ يِرٍ عٍ تٌنفٌشِ دّننَشّ. نَ كِ وَلِسٍ يٌ شُي مُ نُ مّمَ هْرْ مْبَنشِ يِرٍ، عَلْ دّرّ مَ، بٍرَ، شَ نَ مُ عَ رَ وَلِسٍ فبّتّ نَشَن يَءِلَنشِ وُرٍ رَ. <verse eid="1KI 6:7"/><verse number="8" style="v" sid="1KI 6:8"/>نَادّ ندٍ نُ نَ بَنشِ يِرٍقَنيِ مَ نَشَن مِنِمَ كٌنكٌييٍ يِرٍ مَ. تٍدٍ سَمّ دَاشِ ندٍ نُ يَءِلَنشِ بَنشِ كُي مَ، نَشَن نُ كٌنكٌييٍ كُي مَسْتْمَ كٌورٍ رَ. <verse eid="1KI 6:8"/><verse number="9" style="v" sid="1KI 6:9"/>عٍ تٌ فّ بَنشِ تِدٍ، سُلٍمَنِ نَشَ عَ رَشُنمَ سّدِرِ وُرِيٍ رَ. <verse eid="1KI 6:9"/><verse number="10" style="v" sid="1KI 6:10"/>كٌنكٌي نَشٍيٍ نُ تِشِ هْرْ مْبَنشِ سّيتِيٍ مَ، عٍ عِتٍ حْنفْن يَ سُولِ. نَ بِرِن نُ شِرِشِ بَنشِ مَ سّدِرِ وُرِيٍ رَ.<verse eid="1KI 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 6:11"/>عَلَتَلَ نَشَ عَ مَسٍن مَنفّ سُلٍمَنِ بّ، عَ نَشّ، <verse eid="1KI 6:11"/><verse number="12" style="v" sid="1KI 6:12"/>«ﭑ شَ عَ قَلَ عِ بّ يِ بَنشِ تِقٍ شَ قٍ رَ، شَ عِ سَ عِ حّرّ ﭑ مَ كِرَ شْن مَ، شَ عِ سَ ﭑ مَ سّرِيّ رَبَتُ، شَ عِ سَ ﭑ مَ يَامَرِيٍ سُشُ، ﭑ نَن ﭑ مَ لَايِدِ رَكَمَلِمَ نّ عِ بّ، ﭑ نَشَن قَلَ عِ بَبَ دَوُدَ بّ. <verse eid="1KI 6:12"/><verse number="13" style="v" sid="1KI 6:13"/>نَ كُي ﭑ لُمَ نّ ﭑ مَ حَمَ تَفِ، ﭑ مُ عِ بّحِنمَ عَبَدَن.»<verse eid="1KI 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1KI 6:14"/>سُلٍمَنِ نَشَ عَلَ شَ هْرْ مْبَنشِ تِ، عَ وَلِ رَحْن. <verse eid="1KI 6:14"/><verse number="15" style="v" sid="1KI 6:15"/>عَ نَشَ سّدِرِ وُرِ شٍبٍنيِيٍ مَقَتُ بَنشِ شَلّيٍ مَ عَ كُي، كٍلِقٍ عَ شَلّ قْلّ مَ هَن بَنشِ شُنيِ رَ. عَ نَشَ سِثِرّ وُرِ شٍبٍنيِيٍ مَقَتُ بَنشِ فبَاتَ مَ. <verse eid="1KI 6:15"/><verse number="16" style="v" sid="1KI 6:16"/>عَ نَشَ سّدِرِ وُرِ شٍبٍنيِيٍ مَقَتُ كٌنكٌي حْنفْن يَ مْشْحّن دَاشِ مَ بَنشِ كُي دُنشُي رَ، كٍلِقٍ عَ فبَاتَ مَ هَن قُفٍ. نَ نُ قِندِشِ يِرٍ سّنِيّنشِ قِسَمَنتٍ نَن نَ. <verse eid="1KI 6:16"/><verse number="17" style="v" sid="1KI 6:17"/>بَنشِ ثَلَا دْنشْي نَشَن نُ نَ نَ يَتَفِ، نُ كُيَ حْنفْن يَ تٌنفٌ نَانِ. نَ نُ قِندِشِ يِرٍ سّنِيّنشِ نَن نَ. <verse eid="1KI 6:17"/><verse number="18" style="v" sid="1KI 6:18"/>سّدِرِ وُرِ شٍبٍنيِيٍ نَشٍيٍ نُ قَتُشِ بَنشِ شَلّيٍ مَ ثَلَا مَ، سَنسِ بٌفِيٍ نُن سَنسِ قُفٍيٍ قَن نُ مَسٌلِشِ عٍ مَ. نَ كِ، فّمّ مُ نُ تٌمَ بَنشِ كُي مَ قٍقٍ مَ.<verse eid="1KI 6:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 6:19"/>سُلٍمَنِ نَشَ يِرٍ سّنِيّنشِ قِسَمَنتٍ يَءِلَن هْرْ مْبَنشِ كُي، عَلَتَلَ شَ سَاتّ كَنكِرَ دْشْمَ دّننَشّ. <verse eid="1KI 6:19"/><verse number="20" style="v" sid="1KI 6:20"/>نَ يِرٍ كُيَ حْنفْن يَ مْشْحّن، عَ عِفبٌ حْنفْن يَ مْشْحّن، عَ عِتٍ حْنفْن يَ مْشْحّن. شّيمَ نُ مَسٌشِ نَ كٌنكٌي شَلّيٍ بِرِن مَ، عَ نُن سّرّشّبَدٍ مَ نَشَن يَءِلَنشِ سّدِرِ وُرِ رَ. <verse eid="1KI 6:20"/><verse number="21" style="v" sid="1KI 6:21"/>مَنفّ سُلٍمَنِ نَشَ شّيمَ مَسٌ نَ يِرٍ سّنِيّنشِ قِسَمَنتٍ شَلّيٍ مَ. عَ نَشَ يْلْنشْنيِ شُنشُرِ شّيمَ دَاشِيٍ فبَكُ نَا سٌدٍ دّ رَ. <verse eid="1KI 6:21"/><verse number="22" style="v" sid="1KI 6:22"/>بَ نَ رَ، عَ نُ بَرَ شّيمَ مَسٌ نَ هْرْ مْبَنشِ شَلّيٍ بِرِن مَ، عَ نُن سّرّشّبَدٍ مَ نَشَن نُ نَ نَا.<verse eid="1KI 6:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 6:23"/>عَ نَشَ مَلٍكّ قِرِن مِسَالِ مَسٌلِ وُلَءِ عٌلِوِ وُرِ رَ. عٍ عِتٍ حْنفْن يَ قُ. <verse eid="1KI 6:23"/><verse number="24" style="v" sid="1KI 6:24"/>مَلٍكّ سِنفٍ فَبُتٍنيِ كٍرٍن شَ كُيّ حْنفْن يَ سُولِ، عَ فَبُتٍنيِ قِرِن ندٍ قَن شَ كُيّ حْنفْن يَ سُولِ، نَشَن لَنمَ نْنفْن قُ مَ كٍلِقٍ عَ كْولَ مَ هَن عَ يِرٍقَنيِ مَ. <verse eid="1KI 6:24"/><verse number="25" style="v" sid="1KI 6:25"/>بٌورٍ مَلٍكّ قَن فبٍيٍ لَنشِ حْنفْن يَ قُ نَن مَ. عٍ قِرِنيِ نُ يَءِلَنشِ كّحَ كٍرٍن نَن نَ. <verse eid="1KI 6:25"/><verse number="26" style="v" sid="1KI 6:26"/>عٍ قِرِنيِ عِتٍ حْنفْن يَ قُ. <verse eid="1KI 6:26"/><verse number="27" style="v" sid="1KI 6:27"/>سُلٍمَنِ نَشَ نَ مَلٍكّيٍ تِ يِرٍ سّنِيّنشِ قِسَمَنتٍ تَفِ، عَلَكٌ مَلٍكّيٍ فَبُتٍنيِيٍ شَ بَنشِ شَلّيٍ لِ، عٍ قَن شَ عٍ بٌورٍ لِ بَنشِ تَفِ. <verse eid="1KI 6:27"/><verse number="28" style="v" sid="1KI 6:28"/>سُلٍمَنِ نَشَ شّيمَ مَسٌ نَ مَلٍكّ قِرِنيِيٍ بِرِن مَ.<verse eid="1KI 6:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 6:29"/>عَ نَشَ يَامَرِ قِ، عَ عٍ شَ مَلٍكّيٍ، تُفِ بِلِيٍ، نُن وُرِ قُفٍ تٌقَنيِ مِسَالِيٍ مَسٌلِ بَنشِ شَلّيٍ مَ، نَشٍيٍ نُ نَ يِرٍ سّنِيّنشِ قِسَمَنتٍ نُن يِرٍ سّنِيّنشِ كُي. <verse eid="1KI 6:29"/><verse number="30" style="v" sid="1KI 6:30"/>عَ نَشَ شّيمَ مَسٌ بَنشِ فبَاتَ مَ نَ يِرٍ قِرِنيِيٍ كُي. <verse eid="1KI 6:30"/><verse number="31" style="v" sid="1KI 6:31"/>عَ نَشَ هْرْ مْبَنشِ شَ نَادّيٍ يَءِلَن وُلَءِ عٌلِوِ وُرِ رَ. عَ عٍ فبَكُ عٌلِوِ وُرِ شٍبٍنيِيٍ رَ نَشٍيٍ شَ مَرَبِنيٍ مُ نُ بَنشِ شَلّ فبٍ لِمَ، قٌ دْشْ نَانِ. <verse eid="1KI 6:31"/><verse number="32" style="v" sid="1KI 6:32"/>نَ نَادّ قِرِنيِيٍ نُ يَءِلَنشِ وُلَءِ عٌلِوِ وُرِ نَن نَ. مَلٍكّ، تُفِ بِلِ، نُن وُرِ قُفٍ تٌقَنيِيٍ مِسَالِيٍ نُ مَسٌلِشِ نَ نَادّيٍ مَ. شّيمَ نُ مَسٌشِ نَ نَادّيٍ نُن نَ مِسَالِيٍ مَ <verse eid="1KI 6:32"/><verse number="33" style="v" sid="1KI 6:33"/>عَ نَشَ نَ مْولِ رَبَ نَادّيٍ مَ نَشٍيٍ نُ نَ يِرٍ سّنِيّنشِ مَ. عٍ يَءِلَنشِ عٌلِوِ وُرِ رَ، عٍ فبَكُشِ وُرِ شٍبٍنيِيٍ رَ نَشٍيٍ مُ نُ بَنشِ شَلّ شَ مَرَبِنيٍ لِمَ قٌ دْشْ سَشَن. <verse eid="1KI 6:33"/><verse number="34" style="v" sid="1KI 6:34"/>نَادّ قِرِنيِ فبّتّ نُ يَءِلَنشِ سِثِرّ وُرِ رَ. <verse eid="1KI 6:34"/><verse number="35" style="v" sid="1KI 6:35"/>عَ نَشَ يَامَرِ قِ عٍ شَ مَلٍكّيٍ، تُفِيٍ، نُن سَنسِ قُفٍ تٌقَنيِ مِسَالِيٍ مَسٌلِ عٍ مَ. نَ دَنفِ شَنبِ عَ نَشَ شّيمَ مَسٌ نَادّيٍ نُن نَ مِسَالِيٍ مَ.<verse eid="1KI 6:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="1KI 6:36"/>عَ نَشَ بُنتُنيِ يَءِلَن فّمّ مَسٌلِشِيٍ رَ، نَشٍيٍ نُ دْشْشِ سَقّ سَشَن نَ، عَ نُن سّدِرِ وُرِ سَقّ كٍرٍن نَ.<verse eid="1KI 6:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="1KI 6:37"/>عَلَتَلَ شَ بَنشِ دْشْ قْلْ سِوِ كِكٍ نَن نَ، سُلٍمَنِ شَ مَنفّيَ حّ نَانِ ندٍ. <verse eid="1KI 6:37"/><verse number="38" style="v" sid="1KI 6:38"/>عَ نَشَ حْن بُلُ كِكٍ رَ، كِكٍ سٌلٌمَسَشَن ندٍ، سُلٍمَنِ شَ مَنفّيَ حّ قُ نُن كٍرٍن ندٍ. نَ بَنشِ بِرِن تِ حّ سٌلٌقٍرٍ نَن بُن مَ، عَ قَ لُ عَلْ عَلَ نُ وَ مَ عَ شْن مَ كِ نَشّ.<verse eid="1KI 6:38"/></para>
  <chapter eid="1KI 6"/>
  <chapter number="7" style="c" sid="1KI 7"/>
  <para style="s">مَنفّ بَنشِ تِقٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 7:1"/>سُلٍمَنِ بُ نّ حّ قُ نُن سَشَن عَ يّتّ شَ بَنشِيٍ تِقٍ رَ. <verse eid="1KI 7:1"/><verse number="2" style="v" sid="1KI 7:2"/>عَ بَنشِ نَشَن سِنفٍ تِ عَ عَ شِلِ سَ نّ «لِبَن قْتْنيِ بَنشِ.» عَ نُ كُيَ حْنفْن يَ كّمّ، عَ عِفبٌ حْنفْن يَ تٌنفٌ سُولِ، عَ عِتٍ حْنفْن يَ تٌنفٌ سَشَن. عَ شُنيِ وُرِيٍ نُ دْشْشِ كِنكِ سَقّ نَانِ نَشٍيٍ شُن، نٍيٍ نُ يَءِلَنشِ سّدِرِ وُرِ نَن نَ. <verse eid="1KI 7:2"/><verse number="3" style="v" sid="1KI 7:3"/>نَ كِنكِيٍ قَرِ نُ مَكٌتٌشِ سّدِرِ شٍبٍنيِ تٌنفٌ نَانِ نُن سُولِ نَن نَ عَ سَقّ كِ مَ، قُ نُن سُولِ سَقّ كٍرٍن. <verse eid="1KI 7:3"/><verse number="4" style="v" sid="1KI 7:4"/>بَنشِ سّيتِيٍ مَ، وُندّرِ سَقّ سَشَن نُ نَ عٍ مَ، عٍ يَ رَقِندِشِ عٍ بٌورٍ مَ. <verse eid="1KI 7:4"/><verse number="5" style="v" sid="1KI 7:5"/>نَادّ سَشَن قَن نُ نَ وُندّرِيٍ يَ تَفِ. <verse eid="1KI 7:5"/><verse number="6" style="v" sid="1KI 7:6"/>بُنتُنيِ نُ نَ نَشَن شَ كُيّ حْنفْن يَ تٌنفٌ سُولِ لِمَ، عَ عِفبٌي حْنفْن يَ تٌنفٌ سَشَن. <verse eid="1KI 7:6"/><verse number="7" style="v" sid="1KI 7:7"/>بَنشِ ثَلَ نَشَن قَن نُ يَءِلَنشِ سّدِرِ وُرِ رَ كٍلِ عَ فبَتَ مَ هَن قُفٍ، نَن نُ قِندِشِ عَ شَ كِيتِ سَدٍ رَ.<verse eid="1KI 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 7:8"/>عَ بَنشِ فبّتّ تِ نّ نَ شَنبِ رَ عَ نُ لُمَ دّننَشّ. عَ عَ يَءِلَن عَلْ بٌورٍ. نَ شَنبِ رَ، عَ نَشَ بَنشِ فبّتّ تِ قِرَوُنَ شَ دِ فِنّ بّ عَ نَشَن دْشْ. <verse eid="1KI 7:8"/><verse number="9" style="v" sid="1KI 7:9"/>نٍيٍ بِرِن تِ فّمّ مَسٌلِشِيٍ نَن نَ نَشٍيٍ شَبَشِ سّرَ رَ عَ كُي نُن عَ قَرِ، كٍلِقٍ عَ بُنيِ مَ هَن قُفٍ. <verse eid="1KI 7:9"/><verse number="10" style="v" sid="1KI 7:10"/>بَنشِ سَنبُنيِ دْشْ فّمّ تٌقَنيِ شُنفبٍيٍ نَن نَ، نَشٍيٍ شَبَشِ حْنفْن يَ قُ شَ نَ مُ عَ رَ حْنفْن يَ سٌلٌمَسَشَن مَ. <verse eid="1KI 7:10"/><verse number="11" style="v" sid="1KI 7:11"/>عَ قُفٍ رَ، سّدِرِ وُرِ نُن فّمّ تٌقَنيِيٍ نُ نَ نَشٍيٍ شَبَشِ عَ قَنيِ رَ. <verse eid="1KI 7:11"/><verse number="12" style="v" sid="1KI 7:12"/>نَ تّتّ شُنفبٍ نُ يَءِلَنشِ فّمّ شَبَشِ سَقّ سَشَن نَ، سّدِرِ وُرِ قَن نُ سَشِ نَ قَرِ، عَلْ عَلَتَلَ شَ بَنشِ نُن عَ فبُتُنيِ.<verse eid="1KI 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 7:13"/>مَنفّ سُلٍمَنِ نَشَ مِشِ ندٍ قٍن تِرٍ، نَشَن شِلِ شِرَ مِ. <verse eid="1KI 7:13"/><verse number="14" style="v" sid="1KI 7:14"/>كَاحّ فِنّ ندٍ شَ دِ نَن نُ عَ رَ قَتَنقٍ نَقَتَلِ بْنسْي رَ. تِرٍكَ نَن نُ عَ بَبَ رَ، نَشَن نُ وُرٍ فبٍيلِ رَوَلِمَ. عَ لْننِشِ، عَ شَشِلِ قَن، عَ قَتَ وُرٍ فبٍيلِ رَوَلِدٍ عَ مْولِ بِرِن نَ. عَ سِفَ نّ مَنفّ سُلٍمَنِ يِرٍ، عَ نَ وَلِ مْولِ رَبَ.<verse eid="1KI 7:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 7:15"/>عَ كِنكِ قِرِن شَبُ وُرٍ فبٍيلِ رَ، نَشٍيٍ عِتٍ حْنفْن يَ قُ نُن سٌلٌمَسَشَن، نَشٍيٍ شَ رَدِفِلِنيِ لَنشِ حْنفْن يَ قُ نُن قِرِن مَ. <verse eid="1KI 7:15"/><verse number="16" style="v" sid="1KI 7:16"/>عَ شُنيِ قِرِن شَبُ نَ كِنكِ قِرِنيِيٍ بّ، نَشٍيٍ عِتٍ حْنفْن يَ سُولِ. <verse eid="1KI 7:16"/><verse number="17" style="v" sid="1KI 7:17"/>عَ سٍ رَشُنمَسٍ قُ نُن نَانِ شَبُ نَ شُنيِ قِرِنيِيٍ بّ، شُنيِ كٍرٍن سٌلٌقٍرٍ. <verse eid="1KI 7:17"/><verse number="18" style="v" sid="1KI 7:18"/>عَ مَنفٌي بٌفِ مَنِيّيٍ يَءِلَن سَقّ قِرِن نَ نَ سٍ رَشُنمَسٍ رَدْشْشِ قِرِنيِيٍ مَ. <verse eid="1KI 7:18"/><verse number="19" style="v" sid="1KI 7:19"/>عَ قُفٍ مَنِيّيٍ مَسٌلِ نَ كِنكِ شُنيِ قِرِنيِيٍ مَ نَشٍيٍ نُ نَ بُنتُنيِ رَ. عٍ عِتٍ حْنفْن يَ نَانِ. <verse eid="1KI 7:19"/><verse number="20" style="v" sid="1KI 7:20"/>عَ مَنفٌي بٌفِ مَنِيّيٍ كّمّ قِرِن مَسٌلِ نَ كِنكِ شُنيِ قِرِنيِيٍ مَ. <verse eid="1KI 7:20"/><verse number="21" style="v" sid="1KI 7:21"/>عَ نَ كِنكِيٍ تِ بُنتُنيِ يَ تَفِ. نَشَن نُ نَ عَ يِرٍقَنيِ مَ، عَ شِلِ نَشَ سَ يَكِن، نَشَن نُ نَ عَ كْولَ مَ، نَ شِلِ نَشَ سَ بٌو سُ. <verse eid="1KI 7:21"/><verse number="22" style="v" sid="1KI 7:22"/>نَ كِنكِيٍ كٌندٍ رَ، قُفٍيٍ نُ مَسٌلِشِ مّننِيٍ مَ.<verse eid="1KI 7:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 7:23"/>عَ نَشَ يٍ سَسٍ شُنفبٍ دِفِلِنشِ يَءِلَن يْشُي رَ. عَ دّ عِفبٌي حْنفْن يَ قُ، عَ عِتٍ حْنفْن يَ سُولِ، عَ شَ رَدِفِلِنيِ حْنفْن يَ تٌنفٌ سَشَن. <verse eid="1KI 7:23"/><verse number="24" style="v" sid="1KI 7:24"/>نَ يٍ سَسٍ دّ رَبِلِنيِ بُنيِ، نِنفٍ مَنِيّ نُ مَسٌلِشِ عَ مَ عٍ رَدْشْشِ عٍ بٌورٍ رَ عَ رَبِلِنيِ بِرِن مَ. نِنفٍ قُ نَ حْنفْن يَ كٍرٍن مَ، سُولِ عَ قَرِ، سُولِ عَ بُن. نِنفٍيٍ يٌ، يٍ سَسٍ يٌ، نَ بِرِن يَءِلَنشِ كٍرٍنيِ نَن نَ.<verse eid="1KI 7:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 7:25"/>نَ يٍ سَسٍ نُ دْشْشِ نِنفٍ مَنِيّ فبّتّ قُ نُن قِرِن قَرِ. سَشَن يَ رَقِندِشِ كْولَ بِرِ، سَشَن يَ رَقِندِشِ سٌفٍفٌرٌدٍ بِرِ، سَشَن يَ رَقِندِشِ يِرٍقَنيِ بِرِ، سَشَن يَ رَقِندِشِ سٌفٍتٍدٍ بِرِ. نَ يٍ سَسٍ نَشَن نُ شِلِ «بَا» نُ دْشْشِ نَ نِنفٍيٍ قَرِ، عٍ يَ رَقِندِشِ تَندٍ مَ. <verse eid="1KI 7:25"/><verse number="26" style="v" sid="1KI 7:26"/>نَ يٍ سَسٍ شَ مَرَبِنيٍ نُ قِندِشِ سُشُ كٍرٍن نَن نَ. عَ دّ كِرِ مَسٌلِشِ مَنِيّ سَنسِ قُفٍ تٌقَنيِ رَ. يٍ قِقَ كّمّ سٌلٌقٍرٍ قِقَ تٌنفٌ سُولِ نُ نْمَ سَدٍ عَ كُي.<verse eid="1KI 7:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1KI 7:27"/>عَ نَشَ عٍ سَنبُنيِ قُ يَءِلَن. عٍ بِرِن نُ كُيَ حْنفْن يَ نَانِ، عٍ عِفبٌ حْنفْن يَ نَانِ، عَ عِتٍ حْنفْن يَ سَشَن. <verse eid="1KI 7:27"/><verse number="28" style="v" sid="1KI 7:28"/>عٍ نَ سَنبُنيِيٍ رَقَلَ كِ نَشّ، وُرٍ رَلّنقّتّنشِيٍ نُ نَ وُرٍ فبّتّ نَانِ تَفِ. <verse eid="1KI 7:28"/><verse number="29" style="v" sid="1KI 7:29"/>يّتّ مِسَالِيٍ، نِنفٍ مِسَالِيٍ، نُن مَلٍكّ مِسَالِيٍ نُ يَءِلَنشِ نَ وُرٍ رَلّنقّتّنشِيٍ مَ، عَ نُن ثِرِنتِ فبّتّيٍ. <verse eid="1KI 7:29"/><verse number="30" style="v" sid="1KI 7:30"/>وُرٍ دِفِلِنشِ نَانِ نُ نَ سَنبُنيِ كٍرٍن كٍرٍن مَ بّ عَ تِ سٍ رَ، نَشٍيٍ نُ شِرِشِ عٍ بٌورٍ رَ وُرٍ فبٍيلِ قِرِن نَ. وُرٍ ندٍ نُ نَ نَ تُشُي نَانِيٍ مَ يٍ سَسٍ بُن مَ. نَ بِرِن نُ يَءِلَنشِ تّمُي كٍرٍنيِ نَن نَ. <verse eid="1KI 7:30"/><verse number="31" style="v" sid="1KI 7:31"/>سٍ دِفِلِنشِ ندٍ نُ نَ يٍ سَسٍ نُ دْشْشِ نَشَن كُي. نَ عِتٍ حْنفْن يَ كٍرٍن سَنبُنيِ بّ، عَ عِفبٌ حْنفْن يَ كٍرٍن نُن عَ تَفِ. سٍ ندٍيٍ نُ مَسٌلِشِ نَ مَ. نَ وُرٍ رَلّنقّتّنشِيٍ مُ نُ دِفِلِنشِ، عٍ سّيتِ نَانِيٍ بِرِن شَ مَنِيّ نُ لَن. <verse eid="1KI 7:31"/><verse number="32" style="v" sid="1KI 7:32"/>نَ وُرٍ دِفِلِنشِ نَانِ نَشٍيٍ نُ نَ عَ يٍ مَشَنِن سٍ تُشُي نَانِيٍ رَ، عٍ عِتٍ حْنفْن يَ كٍرٍن نُن عَ تَفِ، قِرِن نُ شِرِشِ عٍ بٌورٍ رَ وُرٍ فبٍيلِ رَ. <verse eid="1KI 7:32"/><verse number="33" style="v" sid="1KI 7:33"/>نَ وُرٍ دِفِلِنشِيٍ مَنِيّ سْورِ رَفِسٍ سَنيِيٍ رَ. عٍ بِرِن نُ يَءِلَنشِ وُرٍ فبٍيلِ رَ تّمُي كٍرٍنيِ رَ.<verse eid="1KI 7:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="1KI 7:34"/>سٍ ندٍ نُ نَ تُشُي نَانِيٍ بِرِن نَ نَشٍيٍ نُ سّنبّ قِمَ عٍ مَ. <verse eid="1KI 7:34"/><verse number="35" style="v" sid="1KI 7:35"/>سٍ دِفِلِنشِ ندٍ نُ نَ يٍ سَسٍ دْشْدٍ كُي. نَ عِتٍ سَنبُنيِ بّ حْنفْن يَ كٍرٍن. سَنبُنيِيٍ قُفٍ، عَ كِلْندٍيٍ نُن عَ وُرٍ رَلّنقّتّنشِيٍ بِرِن نُ يَءِلَنشِ وُرٍ فبٍيلِ نَن نَ تّمُي كٍرٍنيِ رَ. <verse eid="1KI 7:35"/><verse number="36" style="v" sid="1KI 7:36"/>مَلٍكّ مِسَالِيٍ، يّتّ مِسَالِيٍ، نُن تُفِ مِسَالِيٍ نُ يَءِلَنشِ نَ كٍبٍلَيٍ مَ، نُن سٍ فبّتّيٍ. <verse eid="1KI 7:36"/><verse number="37" style="v" sid="1KI 7:37"/>يٍ مَشَنِن سٍ قُ نُ يَءِلَنشِ كِ كٍرٍنيِ رَ نَ كِ نّ وُرٍ فبٍيلِ رَ. عٍ بِرِن نُ لَن.<verse eid="1KI 7:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="1KI 7:38"/>شِرَ مِ يٍ سَسٍ قُ يَءِلَن نّ وُرٍ فبٍيلِ رَ، نَشٍيٍ نُ دْشْشِ نَ يٍ مَشَنِن سٍ قُ قَرِ. يٍ لِتِرِ وُلُ كٍرٍن كّمّ سٍننِ حْندْن نُ سَمَ كَنكَن كُي. يٍ سَسٍ نُ عِفبٌ حْنفْن يَ نَانِ. <verse eid="1KI 7:38"/><verse number="39" style="v" sid="1KI 7:39"/>عَ نَشَ يٍ مَشَنِن سٍيٍ دْشْ عَلَتَلَ شَ هْرْ مْبَنشِ سّيتِيٍ مَ، سُولِ كْولَ بِرِ، سُولِ يِرٍقَنيِ بِرِ. نَ يٍ سَسٍ بٍلٍبٍلٍ نَشَن نُ شِلِ «بَا،» عَ نَشَ نَ دْشْ بَنشِ يِرٍقَنيِ مَ، عَ مَكْرّ عَ سٌفٍتٍدٍ بِرِ رَ. <verse eid="1KI 7:39"/><verse number="40" style="v" sid="1KI 7:40"/>شُرَ مِ نَشَ يٍ سَسٍيٍ، تّ شُبٍ كْ سٍيٍ نُن تُندٍيٍ يَءِلَن.</para>
  <para style="p" vid="1KI 7:40">نَ كُي، شُرَ مِ نَشَ فّ مَنفّ سُلٍمَنِ شَ وَلِيٍ رَ عَلَ شَ هْرْ مْبَنشِ شَ قٍ رَ. نَ وَلِيٍ نَن يَ؛ <verse eid="1KI 7:40"/><verse number="41" style="v" sid="1KI 7:41"/>كِنكِ قِرِنيِيٍ، عٍ شُنيِ تٌقَنشِيٍ، سٍ رَشُنمَسٍ نَشٍيٍ عٍ قَرِ، <verse eid="1KI 7:41"/><verse number="42" style="v" sid="1KI 7:42"/>كْوبّ بٌفِ مَنِيّ كّمّ نَانِ فبَكُشِ عٍ رَ، كْوبّ بٌفِ مَنِيّ سَقّ قِرِن سٍ رَشُنمَسٍ كٍرٍن مَ كِنكِيٍ شُنيِ رَ، <verse eid="1KI 7:42"/><verse number="43" style="v" sid="1KI 7:43"/>سُنبُي مَشَنِن سٍ قُ، <verse eid="1KI 7:43"/><verse number="44" style="v" sid="1KI 7:44"/>يٍ سَسٍ شُنفبٍ نَشَن شِلِ «بَا،» نِنفٍ قُ نُن قِرِن مِسَالِ نَشٍيٍ نَ يٍ سَسٍ شُنفبٍ بُن مَ، <verse eid="1KI 7:44"/><verse number="45" style="v" sid="1KI 7:45"/>تُندٍيٍ، ثٍلِيٍ، ثَانِيٍ. شُرَ مِ سٍ نَشٍيٍ بِرِن يَءِلَن مَنفّ سُلٍمَنِ بّ عَلَتَلَ شَ بَنشِ شَ قٍ رَ، عَ عٍ يَءِلَن وُرٍ فبٍيلِ رَشُنُشِ نَن نَ. <verse eid="1KI 7:45"/><verse number="46" style="v" sid="1KI 7:46"/>مَنفّ نُ نَ يْشُي رَشُنُ يُرُدّن مّرّ يِرٍ نّ، سُكْتِ نُن سَرَتَن تَفِ. <verse eid="1KI 7:46"/><verse number="47" style="v" sid="1KI 7:47"/>مَنفّ سُلٍمَنِ نَ بِرِن يَءِلَن وُرٍ فبٍيلِ نَن نَ، نَشَن شَ فبٌي شَسَبِ مُ نُ نْمَ كٌلٌندٍ.<verse eid="1KI 7:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="1KI 7:48"/>سُلٍمَنِ سٍ فبٍفبٍ يَءِلَن نّ عَلَ شَ بَنشِ بّ، عَلْ سّرّشّبَدٍ شّيمَ دَاشِ، تٍيبِلِ شّيمَ دَاشِ ندٍ تَامِ سّرّشّ سَمَ دّننَشّ، <verse eid="1KI 7:48"/><verse number="49" style="v" sid="1KI 7:49"/>لَنثُي دْشْ سٍ شّيمَ دَاشِيٍ نَشٍيٍ دّشّمَ يِرٍ سّنِيّنشِ كُي سّرِيّ كِ مَ، عَ قُفٍ مِسَالِشِيٍ، لَنثُييٍ، تّ شُبٍ كْ سٍ شّيمَ دَاشِيٍ، <verse eid="1KI 7:49"/><verse number="50" style="v" sid="1KI 7:50"/>ثَانِيٍ، قِنّيٍ، ثْوتِ تٌقَنيِيٍ، ثِلٍتِيٍ، كٌلٌثْوتِ شّيمَ قَنيِ دَاشِيٍ، عَلَ شَ هْرْ مْبَنشِ شَ نَادّيٍ فبَكُ سٍ شّيمَ دَاشِيٍ، نَشٍيٍ نُ نَ يِرٍ سّنِيّنشِ قِسَمَنتٍ سٌدٍ دّ رَ نُن هْرْ مْبَنشِ سٌدٍ دّ رَ.<verse eid="1KI 7:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="1KI 7:51"/>سُلٍمَنِ عَلَتَلَ شَ هْرْ مْبَنشِ شَ سٍيٍ يَءِلَن شّيمَ رَ نَ كِ نّ. عَ تٌ فّ نَ رَ، عَ نَشَ سٍ بِرِن نَسٌ عَلَتَلَ شَ هْرْ مْبَنشِ شَ نَاقُلِ رَفَتَدٍ كُي، عَ بَبَ دَوُدَ نَشٍيٍ قِشِ عَلَ مَ.<verse eid="1KI 7:51"/></para>
  <chapter eid="1KI 7"/>
  <chapter number="8" style="c" sid="1KI 8"/>
  <para style="s">سَاتّ كَنكِرَ دْشْقٍ هْرْ مْبَنشِ كُي</para>
  <para style="r">يُدَيَ مَنفّيٍ عِِ ٥‏؛٢ ٬ ٦‏؛١١</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 8:1"/>نَ تّمُي، سُلٍمَنِ نَشَ عِسِرَيِلَ قٌرِيٍ، بْنسْي شُنيِيٍ، نُن عِسِرَيِلَ دٍنبَيَ شُنيِيٍ مَشِلِ عَلَكٌ عٍ شَ تٍ عَلَتَلَ شَ سَاتّ كَنكِرَ رَ كٍلِقٍ سِيٌن، دَوُدَ شَ تَا. <verse eid="1KI 8:1"/><verse number="2" style="v" sid="1KI 8:2"/>عِسِرَيِلَكَ بِرِن نَشَ عٍ مَلَن مَنفّ يِرٍ عَلَكٌ عٍ شَ كِكٍ سٌلٌقٍرٍ سَلِ رَبَ. <verse eid="1KI 8:2"/><verse number="3" style="v" sid="1KI 8:3"/>عِسِرَيِلَ قٌرِيٍ بِرِن تٌ مّننِ لِ، لٍوِكَيٍ نَشَ سَاتّ كَنكِرَ تٌنفٌ، <verse eid="1KI 8:3"/><verse number="4" style="v" sid="1KI 8:4"/>عٍ عَ شَنِن عَ نُن عَلَ شَ نَرَلَندٍ كِرِ بَنشِ، عَ نُن سٍ سّنِيّنشِ نَشٍيٍ نُ نَ عَ كُي. لٍوِكَ سّرّشّدُبّيٍ نَن نَ وَلِ رَبَ.<verse eid="1KI 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 8:5"/>مَنفّ سُلٍمَنِ نُن عِسِرَيِلَ حَمَ نَشٍيٍ بِرِن نُ مَشِلِشِ، نَشَ تِ سَاتّ كَنكِرَ يَ رَ. عٍ نَشَ شُرُ سٍ لَنمَيٍ نُن عَ شُنفبٍ فبٍفبٍ بَ سّرّشّ رَ، نَشَن كْنتِ مُ نُ نْمَ كٌلٌندٍ. <verse eid="1KI 8:5"/><verse number="6" style="v" sid="1KI 8:6"/>سّرّشّدُبّيٍ نَشَ عَلَتَلَ شَ سَاتّ كَنكِرَ دْشْ عَ دْشْدٍ عَلَ شَ هْرْ مْبَنشِ، يِرٍ سّنِيّنشِ قِسَمَنتٍ كُي. عٍ عَ دْشْ مَلٍكّيٍ فَبُتٍنيِيٍ بُن مَ. <verse eid="1KI 8:6"/><verse number="7" style="v" sid="1KI 8:7"/>مَلٍكّيٍ فَبُتٍنيِيٍ نُ عِتَلَشِ سَاتّ كَنكِرَ نُن عَ مَشَنِن سٍيٍ شُن مَ. <verse eid="1KI 8:7"/><verse number="8" style="v" sid="1KI 8:8"/>سَاتّ كَنكِرَ مَشَنِن سٍيٍ قِندِشِ وُرِ كُيٍيٍ نَن نَ، نَشٍيٍ حْييٍ نُ تٌمَ كَقِ ثَلَ مَ يِرٍ سّنِيّنشِ كُي، كْنْ عٍ مُ نُ نْمَ تٌدٍ هْرْ مْبَنشِ تَندٍ تَن مَ. هَن تٌ سَاتّ كَنكِرَ نَ مّننِ. <verse eid="1KI 8:8"/><verse number="9" style="v" sid="1KI 8:9"/>سٍسٍ مُ نُ نَ نَ سَاتّ كَنكِرَ كُي، قٌ نَ وَلَشّ قِرِنيِ عَننَبِ مُنسَ نَشٍيٍ سَ عَ كُي. عَ نَ رَبَ شٌرٍبٍ فٍيَ يِرٍ نّ، عَلَتَلَ سَاتّ شِرِ لْشْي عٍ نُن عِسِرَيِلَكَيٍ تَفِ، عٍ مِنِ تّمُي مِسِرَ.<verse eid="1KI 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 8:10"/>سّرّشّدُبّيٍ تٌ مِنِ يِرٍ سّنِيّنشِ كُي، نُشُي ندٍ نَشَ فٌرٌ عَلَتَلَ شَ بَنشِ مَ، عَ عَ رَقٍ. <verse eid="1KI 8:10"/><verse number="11" style="v" sid="1KI 8:11"/>سّرّشّدُبّيٍ مُ نْ لُدٍ مّننِ عٍ شَ عٍ شَ وَلِ رَبَ، بَرِ مَ نَ نُشُي نُ نَ نَا، عَلَتَلَ شَ نْرّ نُ بَرَ لُ بَنشِ بِرِن مَ. <verse eid="1KI 8:11"/><verse number="12" style="v" sid="1KI 8:12"/>نَ كُي، سُلٍمَنِ نَشَ عَ قَلَ،</para>
  <para style="q" vid="1KI 8:12">«عَلَتَلَ عَ مَسٍن نّ،</para>
  <para style="q" vid="1KI 8:12">عَ عَ سَبَتِمَ نُشُي قْورّ نَن كُي.<verse eid="1KI 8:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="1KI 8:13"/>نَ كُي ﭑ بَرَ لِنفِرَ تِ عِ بّ،</para>
  <para style="q" vid="1KI 8:13">عِ سَبَتِمَ دّننَشّ عَبَدَن.»<verse eid="1KI 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1KI 8:14"/>مَنفّ نَشَ عَ يَ رَقِندِ، عَ دُبَ عِسِرَيِلَ حَمَ بِرِن بّ. عٍ بِرِن نُ تِشِ. <verse eid="1KI 8:14"/><verse number="15" style="v" sid="1KI 8:15"/>عَ نَشَ عَ مَسٍن، «تَنتُي نَ عِسِرَيِلَ مَرِفِ عَلَتَلَ بّ، نَشَن وْيّن ﭑ بَبَ دَوُدَ بّ عَ كّرّ رَ. عَ قٍ نَشَن بِرِن مَسٍن عَ بّ، عَ نَ بِرِن نَكَمَلِشِ نّ. <verse eid="1KI 8:15"/><verse number="16" style="v" sid="1KI 8:16"/>عَ نَشّ، ‹كَقِ ﭑ نَن ﭑ مَ حَمَ رَ مِنِ مِسِرَ بْشِ رَ، ﭑ مُ نُ تَا سُفَندِشِ عِسِرَيِلَ بْنسْييٍ تَفِ ﭑ بَنشِ تِمَ دّننَشّ. ﭑ مَن مُ شّمّ سُفَندِشِ نَشَن قِندِ مَ ﭑ مَ عِسِرَيِلَ حَمَ يَرٍرَتِ رَ. كْنْ ﭑ بَرَ دَرِ سَلَمُ نَن سُفَندِ عَلَكٌ ﭑ شِلِ شَ لُ نَا. ﭑ مَن بَرَ دَوُدَ سُفَندِ عَلَكٌ عَ شَ قِندِ ﭑ مَ عِسِرَيِلَ حَمَ شُنيِ رَ.›»<verse eid="1KI 8:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1KI 8:17"/>«ﭑ بَبَ دَوُدَ نَشَ نَتّ تٌنفٌ عَ بْحّ كُي، عَ قٌ عَ شَ بَنشِ تِ عِسِرَيِلَ مَرِفِ عَلَتَلَ بّ. <verse eid="1KI 8:17"/><verse number="18" style="v" sid="1KI 8:18"/>عَلَتَلَ نَشَ عَ قَلَ ﭑ بَبَ دَوُدَ بّ، ‹عِ تٌ نَتّ تٌنفٌ عِ بْحّ كُي ﭑ مَ بَنشِ شَ قٍ رَ، نَ بَرَ قِندِ حَنِفٍ قَنيِ رَ. <verse eid="1KI 8:18"/><verse number="19" style="v" sid="1KI 8:19"/>كْنْ عِ تَن شَ مُ نَ بَنشِ تِمَ. عِ شَ دِ نَن نَ تِمَ. عِ نَشَن بَرِشِ، نَ نَن ﭑ مَ بَنشِ تِمَ.› <verse eid="1KI 8:19"/><verse number="20" style="v" sid="1KI 8:20"/>عَلَتَلَ بَرَ عَ شَ مَسٍنيِ رَكَمَلِ. ﭑ تَن بَرَ تِ ﭑ بَبَ دَوُدَ حْشْي رَ عِسِرَيِلَ مَنفّ كِبَنيِ كُي، عَلْ عَلَتَلَ عَ مَسٍن كِ نَشّ. ﭑ مَن بَرَ بَنشِ تِ عِسِرَيِلَ مَرِفِ عَلَتَلَ بّ. <verse eid="1KI 8:20"/><verse number="21" style="v" sid="1KI 8:21"/>ﭑ بَرَ عَلَتَلَ شَ سَاتّ كَنكِرَ دْشْ نَا، عَ شَ سَاتّ وَلَشّ نَ نَ كُي. عَ نَ سَاتّ شِرِ عَ نُن عِسِرَيِلَكَيٍ نَن تَفِ.»<verse eid="1KI 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 8:22"/>مَنفّ سُلٍمَنِ نَشَ تِ سّرّشّبَدٍ يَ عِ حَمَ بِرِن يَ شْرِ، عَ نَشَ عَ بّلّشّ عِتَلَ كٌورٍ مَ، عَ قَ عَ قَلَ، <verse eid="1KI 8:22"/><verse number="23" style="v" sid="1KI 8:23"/>«عِسِرَيِلَ مَرِفِ عَلَتَلَ، عِ مَنِيّ مُ نَ كٌورٍ نُن بْشِ مَ. عِ دُفُتّفّشِ عِ شَ سَاتّ نُن عِ شَ هِننّ شَ قٍ نَن نَ عِ شَ كٌنيِيٍ مَبِرِ، نَشٍيٍ حّرّ مَ عِ يَ تٌدٍ رَ عٍ بْحّ قِيشّ رَ. <verse eid="1KI 8:23"/><verse number="24" style="v" sid="1KI 8:24"/>نَ نَ عَ رَ، تٌ لْشْي عِ بَرَ عِ شَ لَايِدِ رَكَمَلِ عِ شَ كٌنيِ ﭑ بَبَ دَوُدَ بّ. <verse eid="1KI 8:24"/><verse number="25" style="v" sid="1KI 8:25"/>يَكْسِ، عِسِرَيِلَ مَرِفِ عَلَتَلَ، عِ لَايِدِ نَشَن تٌنفٌشِ عِ شَ كٌنيِ ﭑ بَبَ دَوُدَ بّ، عِ شَ نَ رَكَمَلِ. عِ بَرَ عَ مَسٍن عَ بّ، ‹شَ عِ بْنسْي قّنتّن عٍ حّرّ كِ مَ عَلْ عِ عَ رَبَشِ كِ نَشّ، عٍ نَشَ ﭑ مَ سّرِيّ بِنيَ، مِشِ ندٍ نَ عٍ بْنسْي يَ مَ نَشَن قَمَ لُدٍ عِسِرَيِلَ كِبَنيِ كُي عَبَدَن.› <verse eid="1KI 8:25"/><verse number="26" style="v" sid="1KI 8:26"/>يَكْسِ، عِسِرَيِلَ مَرِفِ عَلَتَلَ، عِ شَ عِ شَ مَسٍنيِ رَكَمَلِ، عِ نَشَن مَسٍن عِ شَ كٌنيِ دَوُدَ بّ.»<verse eid="1KI 8:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1KI 8:27"/>«كْنْ عَلَ تَن نْمَ سَبَتِدٍ دُنِحَ بّندّ قُحِ قَرِ عَدَ مَدِيٍ تَفِ؟ كٌورٍ نُن عَ شَ فبٌي شُرُن عِ بّ. ﭑ بَنشِ نَشَن تِشِ عِ بّ عَ شُرُن كٌورٍ بّ. عِ لُمَ مّننِ دِ؟ <verse eid="1KI 8:27"/><verse number="28" style="v" sid="1KI 8:28"/>ﭑ مَرِفِ عَلَتَلَ، عِ شَ عِ شَ كٌنيِ شَ دُبّ سُشُ، عِ شَ عَ شَ مَشَندِ تٌنفٌ، عِ شَ عِ تُلِ مَتِ عِ شَ كٌنيِ وَ شُي رَ. <verse eid="1KI 8:28"/><verse number="29" style="v" sid="1KI 8:29"/>عِ شَ عِ حّنفِ سَ يِ بَنشِ شْن مَ كْي نُن يَنيِ رَ، بَرِ مَ عِ شِلِ مَتْشْمَ بٍ. عِ شَ عِ شَ كٌنيِ شَ مَشَندِ سُشُ يِ بَنشِ كُي. <verse eid="1KI 8:29"/><verse number="30" style="v" sid="1KI 8:30"/>عِ شَ عِ تُلِ مَتِ عِ شَ كٌنيِ نُن عِ شَ حَمَ وَ شُي رَ، عٍ عِ مَشَندِ مَ بٍ تّمُي نَشّ. كٍلِقٍ كٌورٍ مَ عِ دْشْشِ دّننَشّ، عِ شَ عِ تُلِ مَتِ مُشُ رَ، عِ مَن شَ دِحّ.»<verse eid="1KI 8:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="1KI 8:31"/>«شَ مِشِ ندٍ سَ يُنُبِ رَبَ عَ بٌورٍ رَ، عٍ قَ عَ قَلَ عَ بّ عَ شَ كَلِ ندٍ تِ سّرّشّبَدٍ يِرٍ يِ بَنشِ كُي، <verse eid="1KI 8:31"/><verse number="32" style="v" sid="1KI 8:32"/>عِ شَ نَ قٍ مَتٌ كٍلِقٍ كٌورٍ مَ، عِ شَ كِيتِ سَ نْندِ رَ عَلَكٌ قٍ كَنّ نُن تِنشِنتْي بِرِن شَ عٍ سَرٍ سْتْ.»<verse eid="1KI 8:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="1KI 8:33"/>«شَ عِ شَ حَمَ عِسِرَيِلَ سَ يُنُبِ رَبَ عِ رَ، عٍ يَشُييٍ قَ نْ عٍ رَ نَ شَ قٍ رَ، شَ عٍ بَرَ تِن فبِلٍنقٍ رَ عِ يِرٍ، عٍ عِ شِلِ مَتْشْ، عٍ عِ مَشَندِ يِ هْرْ مْبَنشِ كُي، <verse eid="1KI 8:33"/><verse number="34" style="v" sid="1KI 8:34"/>عِ شَ نَ قٍ مَتٌ كٍلِقٍ كٌورٍ مَ، عِ شَ عِ شَ حَمَ عِسِرَيِلَ شَ يُنُبِيٍ شَقَرِ، عِ قَ عٍ رَفبِلٍن بْشِ مَ، عِ دّننَشّ قِشِ عٍ تَن نُن عٍ بَبَيٍ مَ.»<verse eid="1KI 8:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="1KI 8:35"/>«شَ كٌورٍ سَ بَلَن، تُنّ يٌ مُ قَ، بَرِ مَ عٍ بَرَ يُنُبِ رَبَ عِ رَ، شَ عٍ قَ عِ مَشَندِ بٍ، عٍ عِ شِلِ مَتْشْ، عٍ فبِلٍن عٍ شَ يُنُبِ قْشْ رَ عِ عٍ رَيَافِشِ نَشَن مَ، <verse eid="1KI 8:35"/><verse number="36" style="v" sid="1KI 8:36"/>عِ شَ نَ قٍ مَتٌ كٍلِقٍ كٌورٍ مَ، عِ شَ عِ شَ كٌنيِيٍ، عِ شَ حَمَ عِسِرَيِلَ شَ يُنُبِيٍ شَقَرِ، عِ شَ عِ شَ سّرِيّ قَنيِ مَسٍن عٍ بّ عَلَكٌ عٍ شَ نَ حّرّ كِ كٌلٌن، عِ قَ تُنّ رَفٌرٌ عِ شَ بْشِ مَ، عِ نَشَن قِندِ عٍ فبٍ رَ.»<verse eid="1KI 8:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="1KI 8:37"/>«شَ كَامّ سَ سِن يِ بْشِ مَ، شَ نَ مُ قُرٍ، شَ نَ مُ بَلٌي كَنّ، شَ نَ مُ فٍرٍ، شَ نَ مُ فبَلٌي فبّتّ، <verse eid="1KI 8:37"/><verse number="38" style="v" sid="1KI 8:38"/>شَ مِشِ ندٍ سَ عِ مَشَندِ، شَ عِ شَ حَمَ عِسِرَيِلَ عَ مَوَ عِ شْن، بَرِ مَ عٍ بَرَ عَ كٌلٌن عٍ شَ تْورّ كٍلِشِ قٍ نَشَن مَ، عٍ قَ عٍ بّلّشّ عِتَلَ يِ بَنشِ مَبِرِ، <verse eid="1KI 8:38"/><verse number="39" style="v" sid="1KI 8:39"/>عِ شَ نَ قٍ مَتٌ كٍلِقٍ كٌورٍ مَ عِ مَفٌرٌشِ دّننَشّ، عِ شَ دِحّ، عِ شَ مِشِ بِرِن سَرٍ قِ عَ شَ وَلِ رَ، عِ تَن نَشَن عَدَ مَ بِرِن بْحّ مَ قٍ كٌلٌن. عِ كٍرٍن ثٍتِ نَن عِبُنَدَ مَ بِرِن سٌندٌن مَ قٍ كٌلٌن. <verse eid="1KI 8:39"/><verse number="40" style="v" sid="1KI 8:40"/>نَ كُي عٍ قَمَ فَاشُدٍ عِ يَ رَ، عٍ حّرّ عِ شَ كِرَ شْن عٍ شَ سِمَيَ بِرِن كُي يِ بْشِ مَ، عِ نَشَن قِشِ مُشُ بَبَيٍ مَ.»<verse eid="1KI 8:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="1KI 8:41"/>«شَ شْحّ ندٍ سَ قَ كٍلِقٍ حَمَنّ مَ، نَشَن مُ قِندِ عِ شَ حَمَ عِسِرَيِلَ مِشِ ندٍ رَ، <verse eid="1KI 8:41"/><verse number="42" style="v" sid="1KI 8:42"/>عَ قَ عِ شِلِ شُنفبٍ نُن عِ سّنبّ شَ قٍ رَ، عَ عِ مَشَندِ يِ بَنشِ كُي، <verse eid="1KI 8:42"/><verse number="43" style="v" sid="1KI 8:43"/>عِ شَ نَ قٍ مَتٌ كٍلِقٍ كٌورٍ مَ عِ عِ مَفٌرٌشِ دّننَشّ، عِ شَ عَ شَ مَشَندِ سُشُ عَلَكٌ سِ بِرِن شَ فَاشُ عِ شِلِ يَ رَ دُنِحَ، عَلْ عِ شَ حَمَ عِسِرَيِلَ. عٍ شَ عَ كٌلٌن عِ تَن نَن شِلِ مَشَندِ مَ يِ بَنشِ كُي ﭑ نَشَن تِشِ.»<verse eid="1KI 8:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="1KI 8:44"/>«شَ عِ شَ حَمَ سَ مِنِ عَ يَشُييٍ فٍرٍدٍ عَلْ عِ عَ مَسٍن عٍ بّ كِ نَشّ، شَ عٍ عِ مَشَندِ يِ تَا مَبِرِ رَ عِ دّننَشّ سُفَندِشِ، شَ عٍ عِ مَشَندِ يِ بَنشِ مَبِرِ رَ ﭑ نَشَن تِشِ عِ شِلِ رَ، <verse eid="1KI 8:44"/><verse number="45" style="v" sid="1KI 8:45"/>عِ شَ نَ قٍ مَتٌ، عِ شَ عٍ شَ دُبّ سُشُ، عِ شَ كِيتِ تِنشِنشِ سَ عٍ بّ.»<verse eid="1KI 8:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="1KI 8:46"/>«شَ عٍ سَ يُنُبِ رَبَ عِ رَ، عَلْ عَدَ مَدِ بِرِن دَرِشِ نَشَن نَ، شَ عِ بْحّ تٍ عٍ شِلِ مَ، عِ قَ عٍ سَ عٍ يَشُييٍ سَفٌي، عٍ قِندِ فٍيلِمَنِيٍ رَ يِرٍ مَكُيٍ، شَ نَ مُ عَ رَ يِرٍ مَكْرّشِ، <verse eid="1KI 8:46"/><verse number="47" style="v" sid="1KI 8:47"/>شَ عٍ بَرَ شَشِلِ سْتْ نَ كٌنيِيَ كُي، عٍ قَ عِ مَشَندِ عٍ شَ فٍيلِ كُي، ‹مُشُ بَرَ يُنُبِ رَبَ، مُشُ بَرَ قٍ حَاشِ رَبَ، مُشُ بَرَ كٌبِ،› <verse eid="1KI 8:47"/><verse number="48" style="v" sid="1KI 8:48"/>شَ عٍ مَن عٍ يّتّ رَفبِلٍن عِ مَ عٍ بْحّ قِيشّ رَ، عٍ نِي بِرِن نَ، عٍ قَ عِ مَشَندِ حَمَنّ مَ كٌنيِيَ كُي يِ بْشِ مَبِرِ، عِ نَشَن قِشِ عٍ بَبَيٍ مَ، عَ نُن يِ تَا مَبِرِ، عِ نَشَن سُفَندِشِ، عَ نُن يِ بَنشِ مَبِرِ، ﭑ نَشَن تِشِ عِ بّ، <verse eid="1KI 8:48"/><verse number="49" style="v" sid="1KI 8:49"/>عِ شَ نَ قٍ مَتٌ كٍلِقٍ كٌورٍ مَ عِ مَفٌرٌشِ دّننَشّ، عِ شَ عِ تُلِ مَتِ عٍ شَ مَشَندِ نُن عٍ وَ شُي رَ، عِ شَ كِيتِ تِنشِنشِ سَ عٍ بّ، <verse eid="1KI 8:49"/><verse number="50" style="v" sid="1KI 8:50"/>عِ شَ دِحّ عِ شَ حَمَ مَ نَشَن يُنُبِ رَبَشِ عِ رَ. عِ شَ عٍ شَ يُنُبِيٍ شَقَرِ عٍ نَشَن نَبَشِ عِ رَ. عِ شَ هِننّ عٍ رَ عٍ يَشُييٍ يَ شْرِ، عَلَكٌ عٍ يَشُييٍ قَن شَ هِننّ عٍ رَ. <verse eid="1KI 8:50"/><verse number="51" style="v" sid="1KI 8:51"/>عٍ قِندِشِ عِ شَ حَمَ نَن نَ، عِ كّ تٌنفٌي، عِ نَشٍيٍ رَ مِنِ مِسِرَ بْشِ رَ كٌنيِيَ كُي.»<verse eid="1KI 8:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="1KI 8:52"/>«يَكْسِ، ﭑ مَرِفِ عَلَ، عِ شَ مُشُ شَ مَشَندِ مَتٌ، عِ شَ عَ رَ مّ، مُشُ نَشَن نَبَشِ يِ بَنشِ كُي، <verse eid="1KI 8:52"/><verse number="53" style="v" sid="1KI 8:53"/>بَرِ مَ عِ تَن نَن مُشُ بَ دُنِحَ بْنسْي تَفِ مُشُ شَ قِندِ عِ كّ تٌنفٌي رَ، عَلْ عِ عَ مَسٍن عِسِرَيِلَ بّ كِ نَشّ عِ شَ كٌنيِ مُنسَ سَابُي رَ، عَ تٌ مُشُ بٍنبَيٍ رَ مِنِ مِسِرَ بْشِ رَ.»<verse eid="1KI 8:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="1KI 8:54"/>مَنفّ سُلٍمَنِ تٌ فّ نَ مَشَندِ تِدٍ عَلَتَلَ بّ، عَ نَشَ كٍلِ عَلَتَلَ شَ سّرّشّبَدٍ يِرٍ، عَ شِنبِ نُ سِنشِ دّننَشّ عَ بّلّشّيٍ عِتٍشِ كٌورٍ مَ. <verse eid="1KI 8:54"/><verse number="55" style="v" sid="1KI 8:55"/>نَ تّمُي عَ نَشَ تِ عِسِرَيِلَ حَمَ يَ شْرِ، عَ دُبَ عٍ بّ عَ شُي عِتٍشِ رَ. عَ نَشّ، <verse eid="1KI 8:55"/><verse number="56" style="v" sid="1KI 8:56"/>«تَنتُي نَ عَلَتَلَ بّ، نَشَن بَرَ مَلَبُي قِ عَ شَ حَمَ عِسِرَيِلَ مَ، عَلْ عَ عَ مَسٍن كِ نَشّ. عَ مَسٍنيِ نَشٍيٍ تِ عَ شَ كٌنيِ عَننَبِ مُنسَ سَابُي رَ، كٍرٍن مُ نَ عَ مُ نَشَن نَكَمَلِ. <verse eid="1KI 8:56"/><verse number="57" style="v" sid="1KI 8:57"/>وٌن مَرِفِ عَلَتَلَ شَ لُ وٌن سّيتِ مَ عَلْ عَ رَبَ وٌن بٍنبَيٍ بّ كِ نَشّ. عَلَ نَشَ وٌن نَبٌلٌ، عَ نَشَ وٌن نَبّحِن. <verse eid="1KI 8:57"/><verse number="58" style="v" sid="1KI 8:58"/>عَلَ شَ وٌن بْحّ يَ مَقِندِ عَ مَ، عَلَكٌ وٌن شَ وٌن حّرّ عَ شَ كِرَ شْن مَ، وٌن شَ عَ شَ يَامَرِ بِرِن نَبَتُ، وٌن شَ فبِلٍن قٍيٍ قْشْ رَ عَ تْنيِ دْشْشِ نَشٍيٍ رَ، وٌن شَ بِرَ عَ شَ سّرِيّ قْشْ رَ عَ نَشَن سٌ وٌن بٍنبَيٍ يِ رَ. <verse eid="1KI 8:58"/><verse number="59" style="v" sid="1KI 8:59"/>عَلَ شَ رَتُ ﭑ مَ مَشَندِ مَ كْي نُن يَنيِ. وٌن مَرِفِ عَلَتَلَ شَ ﭑ تَن عَ شَ كٌنيِ نُن عَ شَ حَمَ عِسِرَيِلَ مَكَنتَ قٍ حَاشِ مَ لْشْي بِرِن، <verse eid="1KI 8:59"/><verse number="60" style="v" sid="1KI 8:60"/>عَلَكٌ دُنِحَ بِرِن شَ عَ كٌلٌن عَ عَلَتَلَ نَن نَ عَلَ رَ. عَلَ فبّتّ مُ نَ. <verse eid="1KI 8:60"/><verse number="61" style="v" sid="1KI 8:61"/>وٌ بْحّ بِرِن شَ لُ وٌن مَرِفِ عَلَتَلَ نَن بّ، عَلَكٌ وٌن شَ عَ شَ يَامَرِيٍ رَتِنمّ، وٌن شَ وٌن حّرّ عَ شَ سّرِيّ مَ عَلْ وٌ دَرِشِ عَ رَ كِ نَشّ.»<verse eid="1KI 8:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="1KI 8:62"/>مَنفّ نُن عِسِرَيِلَ حَمَ بِرِن نَشَ سّرّشّ بَ عَلَتَلَ بّ. <verse eid="1KI 8:62"/><verse number="63" style="v" sid="1KI 8:63"/>مَنفّ سُلٍمَنِ نَشَ نِنفٍ وُلُ مْشْحّن نُن قِرِن بَ شَنُنتٍيَ سّرّشّ رَ، عَ نُن يّشّي وُلُ كّمّ مْشْحّن. نَ دَنفِ شَنبِ، مَنفّ نُن حَمَ نَشَ عَلَ شَ بَنشِ رَبِ. <verse eid="1KI 8:63"/><verse number="64" style="v" sid="1KI 8:64"/>سُلٍمَنِ نَشَ تّتّ يِرٍ رَ سّنِيّن سّرّشّ رَ عَلَتَلَ شَ هْرْ مْبَنشِ يَ رَ. عَ نَشَ سّرّشّ فَن دَاشِيٍ بَ نَا، عَ نُن شَنُنتٍيَ سّرّشّيٍ تُرٍ نُن سَنسِ شْرِ رَ، بَرِ مَ سّرّشّبَدٍ يْشُي دَاشِ، سُلٍمَنِ نَشَن يَءِلَن، نَ نُ شُرُن نَ سّرّشّ بِرِن بّ.<verse eid="1KI 8:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="1KI 8:65"/>سُلٍمَنِ نُن عِسِرَيِلَكَيٍ بِرِن سَلِ رَبَ نّ وٌن مَرِفِ عَلَتَلَ يَ شْرِ شِ سٌلٌقٍرٍ بُن مَ. حَمَ فبٍفبٍ قَ نّ كٍلِقٍ شَمَتَ هَن مِسِرَ شُرٍ. عٍ تٌ فّ نَ سَلِ رَ، عٍ مَن نَشَ سَلِ شِ سٌلٌقٍرٍ فبّتّ بُن مَ، عَ قِندِ شِ قُ نُن نَانِ رَ. <verse eid="1KI 8:65"/><verse number="66" style="v" sid="1KI 8:66"/>عَ شِ قُ نُن سُولِ ندٍ، مَنفّ نَشَ حَمَ بّحِن عٍ شَ فبِلٍن عٍ شْنيِ. عٍ نَشَ دُبَ مَنفّ بّ، عٍ قَ فبِلٍن عٍ شْنيِ سّيوّ كُي، عَلَتَلَ شَ هِننّ شَ قٍ رَ عَ شَ كٌنيِ دَوُدَ نُن عَ شَ حَمَ عِسِرَيِلَ مَبِرِ.<verse eid="1KI 8:66"/></para>
  <chapter eid="1KI 8"/>
  <chapter number="9" style="c" sid="1KI 9"/>
  <para style="s">عَلَ شَ مَسٍنيِ سُلٍمَنِ بّ</para>
  <para style="r">يُدَيَ مَنفّيٍ عِِ ٧‏؛١١ ٬ ٢٢</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 9:1"/>مَنفّ سُلٍمَنِ تٌ فّ عَلَتَلَ شَ بَنشِ نُن عَ يّتّ شَ بَنشِ تِدٍ، عَ عَ وَشْنقٍ بِرِن نَبَ نَ شَ قٍ رَ، <verse eid="1KI 9:1"/><verse number="2" style="v" sid="1KI 9:2"/>عَلَتَلَ مَن نَشَ مِنِ عَ مَ عَلْ عَ رَبَ فَبَيٌن كِ نَشّ. <verse eid="1KI 9:2"/><verse number="3" style="v" sid="1KI 9:3"/>عَلَتَلَ نَشَ عَ قَلَ عَ بّ، «ﭑ بَرَ عِ شُي مّ، ﭑ بَرَ عِ شَ مَشَندِ سُشُ. ﭑ بَرَ تِن يِ بَنشِ شَ قِندِ ﭑ فبٍ رَ، عِ نَشَن تِشِ. ﭑ شِلِ شَ لُ عَ مَ عَبَدَن، ﭑ نَن ﭑ حّنفِ سَمَ نّ عَ شْن مَ. <verse eid="1KI 9:3"/><verse number="4" style="v" sid="1KI 9:4"/>شَ عِ سَ عِ حّرّ ﭑ مَ كِرَ شْن مَ بْحّ تِنشِنشِ رَ، عَلْ عِ بَبَ دَوُدَ، عِ قَ ﭑ مَ يَامَرِيٍ، ﭑ مَ سّرِيّ، نُن ﭑ مَ شَرَنيِ سُشُ عَ قَنيِ رَ، <verse eid="1KI 9:4"/><verse number="5" style="v" sid="1KI 9:5"/>ﭑ عِ شَ مَنفّ كِبَنيِ مَبَنبَنمَ نّ، عَلْ ﭑ عَ سَاتَشِ عِ بَبَ دَوُدَ بّ كِ نَشّ. ﭑ عَ مَسٍن نّ عَ بّ، ‹عِسِرَيِلَ مَنفّيَ مُ بَمَ عِ بْنسْي يِ رَ.› <verse eid="1KI 9:5"/><verse number="6" style="v" sid="1KI 9:6"/>كْنْ شَ وٌ وٌ كٌبٍ رَتٌمَ، وٌ قَ فبِلٍن ﭑ مَ سّرِيّ نُن ﭑ مَ يَامَرِيٍ قْشْ رَ، شَ وٌ سَ تُوبِ عَلَ فبّتّ بّ، <verse eid="1KI 9:6"/><verse number="7" style="v" sid="1KI 9:7"/>ﭑ وٌ تَلَمَ نّ ﭑ مَ بْشِ مَ، ﭑ نَشَن قِشِ وٌ مَ، ﭑ يِ بَنشِ رَكَسَنحّ، ﭑ نَشَن قِندِشِ ﭑ شِلِ قَلَدٍ رَ. نَ تّمُي سِ بِرِن قَمَ نّ يٍلٍدٍ عِسِرَيِلَ شَ قٍ مَ، عٍ يٌ وٌ مَ. <verse eid="1KI 9:7"/><verse number="8" style="v" sid="1KI 9:8"/>نَ تّمُي مِشِ نّ دَنفِمَ يِ بَنشِ رَ، نَشَن بَرَ شِلِ قَنيِ سْتْ، عٍ دّ عِشَرَ مَ نّ، عٍ عَ قَلَ، ‹مُنقٍ رَ عَلَتَلَ يِ بْشِ نُن يِ بَنشِ شَ قٍ شُن نَكَنَشِ يِ كِ؟› <verse eid="1KI 9:8"/><verse number="9" style="v" sid="1KI 9:9"/>عٍ عَ يَابِمَ نّ، ‹عَلَ يِ بِرِن نِيَشِ عٍ رَ نّ بَرِ مَ عٍ بَرَ فبِلٍن عٍ بَبَيٍ مَرِفِ عَلَتَلَ قْشْ رَ، نَشَن عٍ رَ مِنِ مِسِرَ بْشِ رَ. عٍ بَرَ عٍ تَفِ عِشِرِ عَلَ فبّتّيٍ رَ، عٍ عٍ بَتُ، عٍ تُوبِ عٍ بّ. عٍ يِ تْورّ سْتْشِ نَ نَن مَ.›»<verse eid="1KI 9:9"/></para>
  <para style="s">مَنفّ سُلٍمَنِ شَ وَلِ ندٍيٍ</para>
  <para style="r">يُدَيَ مَنفّيٍ عِِ ٨‏؛١ ٬ ١٨</para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 9:10"/>مَنفّ سُلٍمَنِ نُ بَرَ عَلَتَلَ شَ بَنشِ نُن عَ يّتّ شَ بَنشِ تِ حّ مْشْحّن بُن مَ. <verse eid="1KI 9:10"/><verse number="11" style="v" sid="1KI 9:11"/>تِرٍ مَنفّ شِرَ مِ تٌ بَرَ نُ سّدِرِ نُن سِثِرّ وُرِيٍ، نُن شّيمَ سٌ سُلٍمَنِ يِ رَ، عَ نُ وَ مَ نَشَن شَسَبِ شْن، عَ نَشَ تَا مْشْحّن قِ شِرَ مِ مَ فَلِلٍ بْشِ مَ. <verse eid="1KI 9:11"/><verse number="12" style="v" sid="1KI 9:12"/>شِرَ مِ تٌ مِنِ نَ تَايٍ مَتٌدٍ، نٍيٍ مُ رَقَن عَ مَ. <verse eid="1KI 9:12"/><verse number="13" style="v" sid="1KI 9:13"/>عَ نَشَ عَ قَلَ سُلٍمَنِ بّ، «ﭑ نفَشَكٍرٍنيِ، عِ تَا مْولِ مُندُن قِشِ ﭑ مَ يِ كِ؟» شِرَ مِ نَشَ نَ تَايٍ شِلِ سَ «تَا قُقَقُ.» نَ شِلِ نَن نَ عٍ شُن مَ هَن تٌ. <verse eid="1KI 9:13"/><verse number="14" style="v" sid="1KI 9:14"/>كْنْ شِرَ مِ نَشَ شّيمَ كِلٌ وُلُ نَانِ رَ سَنبَ مَنفّ سُلٍمَنِ مَ.<verse eid="1KI 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 9:15"/>مَنفّ سُلٍمَنِ نُ بَرَ تٍكُ وَلِ رَكٍلِ بَنشِيٍ نُن تَايٍ تِقٍ رَ، عَلْ عَلَتَلَ شَ بَنشِ، مَنفّ سُلٍمَنِ شَ بَنشِ، مِلٌ تَا، دَرِ سَلَمُ تّتّ، شَسٌرِ تَا، مٍفِدٌ تَا، نُن فٍسٍرِ تَا. <verse eid="1KI 9:15"/><verse number="16" style="v" sid="1KI 9:16"/>قِرَوُنَ، مِسِرَ مَنفّ، دُ سُ نّ فٍسٍرِ تَا شُن نَ، عَ تّ سٌ نَ رَ، نَ كَنَانكَيٍ بِرِن قَشَ. نَ دَنفِ شَنبِ عَ نَ قِ عَ شَ دِ فِنّ مَ، نَشَن دْشْ مَنفّ سُلٍمَنِ شْن مَ.<verse eid="1KI 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1KI 9:17"/>مَنفّ سُلٍمَنِ يِ تَا بِرِن تِ نّ؛ فٍسٍرِ تَا، بٍتِ شٌرٌن لَبٍ، <verse eid="1KI 9:17"/><verse number="18" style="v" sid="1KI 9:18"/>بَالَتِ نُن تَمَرِ نَشٍيٍ نُ نَ فبٍنفبٍرٍنيِ مَ، <verse eid="1KI 9:18"/><verse number="19" style="v" sid="1KI 9:19"/>نُن تَا فبّتّ سْورِ رَفِسٍيٍ نُن سٌييٍ نُ رَفَتَمَ دّننَشّ. سُلٍمَنِ نُ بَرَ بَنشِ نُن تَا فبٍفبٍ تِ دَرِ سَلَمُ، لِبَن بْشِ، نُن عَ شَ بْشِ بِرِن مَ، عَلْ عَ نُ وَ مَ عَ شْن مَ كِ نَشّ.<verse eid="1KI 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1KI 9:20"/>شِتِكَيٍ، عَمٌرِكَيٍ، ثٍرٍ سِكَيٍ، هِوِكَيٍ، نُن يٍبُسُكَيٍ نَشٍيٍ لُ عِسِرَيِلَ بْشِ مَ، كْنْ عٍ مُ قِندِ عِسِرَيِلَكَيٍ رَ. <verse eid="1KI 9:20"/><verse number="21" style="v" sid="1KI 9:21"/>عٍ بَبَيٍ مُ قَشَ عِسِرَيِلَ شَ سَنتِدّفّمَ سَابُي رَ عِسِرَيِلَكَيٍ سٌ تّمُي. نَ كُي سُلٍمَنِ نَ مِشِيٍ قِندِ نّ كٌنيِيٍ رَ. هَن تٌ عٍ نَ كٌنيِيَ كُي. <verse eid="1KI 9:21"/><verse number="22" style="v" sid="1KI 9:22"/>كْنْ سُلٍمَنِ مُ تِن عِسِرَيِلَ دِ يٌ شَ قِندِ كٌنيِ رَ. عِسِرَيِلَكَيٍ نُ قِندِشِ عَ شَ سْورِيٍ، سّبّلِتِيٍ، سْورِ شُنيِيٍ، نُن سٌي رَفِ شُنيِيٍ نَن نَ. <verse eid="1KI 9:22"/><verse number="23" style="v" sid="1KI 9:23"/>مَنفّ سُلٍمَنِ مِشِ كّمّ سُولِ مِشِ تٌنفٌ سُولِ نَن تِ شُنيِيٍ رَ كٌنيِيٍ شُن مَ نَشٍيٍ نُ عَ شَ وَلِ رَبَمَ.<verse eid="1KI 9:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1KI 9:24"/>سُلٍمَنِ قِرَوُنَ شَ دِ فِنّ تٌنفٌ نّ دَوُدَ شَ تَا كُي، عَ عَ رَتُنُ بَنشِ فبّتّ كُي، عَ نَشَن تِ عَ بّ. نَ تّمُي قَ عَ نَشَ مِلٌ تَا تِ.<verse eid="1KI 9:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 9:25"/>مَنفّ سُلٍمَنِ نُ سّرّشّ فَن دَاشِيٍ نُن شَنُنتٍيَ سّرّشّيٍ بَمَ سَنيَ سَشَن حّ يٌ حّ سّرّشّبَدٍ قَرِ، عَ نَشَن يَءِلَن عَلَتَلَ بّ. عَ نُ سُرَيِ بَمَ سّرّشّ رَ سّرّشّبَدٍ ندٍ قَرِ نَشَن نُ نَ عَلَتَلَ يَ عِ. عَ عَلَتَلَ شَ هْرْ مْبَنشِ رَحْن.<verse eid="1KI 9:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 9:26"/>مَنفّ سُلٍمَنِ كُنكُييٍ يَءِلَن نّ عٍسِيٌن فٍبٍرِ، عٍلَتَ قّ مَ، بَا دّ رَ نَشَن نُ نَ عٍدٌن بْشِ مَ. <verse eid="1KI 9:26"/><verse number="27" style="v" sid="1KI 9:27"/>مَنفّ شِرَ مِ وَلِكّ ندٍيٍ سٌ نّ سُلٍمَنِ يِ رَ، نَشٍيٍ نُ بَكِمَ نَ كُنكُييٍ كُي سُلٍمَنِ شَ وَلِكّيٍ سّيتِ مَ. عٍ نُ كُنكُي وَلِ كٌلٌن عَ قَنيِ رَ. <verse eid="1KI 9:27"/><verse number="28" style="v" sid="1KI 9:28"/>نَ كُنكُييٍ سِفَ نّ عٌقِرِ بْشِ مَ شّيمَ كِلٌ وُلُ قُ نُن نَانِ تٌنفٌدٍ مَنفّ سُلٍمَنِ بّ.<verse eid="1KI 9:28"/></para>
  <chapter eid="1KI 9"/>
  <chapter number="10" style="c" sid="1KI 10"/>
  <para style="s">سٍيبَ مَنفّ فِنّ قَقٍ مَنفّ سُلٍمَنِ شّيبُدٍ</para>
  <para style="r">يُدَيَ مَنفّيٍ عِِ ٩‏؛١ ٬ ١٢</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 10:1"/>سٍيبَ مَنفّ فِنّ تٌ سُلٍمَنِ شِلِ فبٍ مّ عَلَتَلَ شِلِ شَ قٍ رَ، عَ نَشَ سِفَ مَشْرِنيِ شْرْشْييٍ تِدٍ عَ مَ. <verse eid="1KI 10:1"/><verse number="2" style="v" sid="1KI 10:2"/>عَ نَشَ سِفَ دَرِ سَلَمُ، عَ سَنبَسٍ فبٍفبٍ شَنِن عَ شُن مَ حْشْمّيٍ قَرِ عَلْ لَبُندّ، شّيمَ، نُن فّمّ تٌقَنيِيٍ. عَ نَشَ عَ شَ مَشْرِنيِ بِرِن تِ سُلٍمَنِ مَ. <verse eid="1KI 10:2"/><verse number="3" style="v" sid="1KI 10:3"/>مَنفّ سُلٍمَنِ نَشَ عَ شَ مَشْرِنيِيٍ بِرِن يَابِ، نَ بِرِن نَشَ سْونّيَ عَ بّ.<verse eid="1KI 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1KI 10:4"/>سٍيبَ مَنفّ فِنّ تٌ فّ سُلٍمَنِ شَ لْننِ تٌدٍ، عَ نُن عَ شَ بَنشِيٍ عَ نَشٍيٍ تِ، <verse eid="1KI 10:4"/><verse number="5" style="v" sid="1KI 10:5"/>عَ شَ دٌنسٍيٍ، عَ شَ وَلِكّيٍ نُن عٍ وَلِ كِ، عٍ شَ دُفِيٍ، عٍ لُدٍيٍ، نَ قٍ بِرِن نَشَ عَ دّ عِشَرَ. <verse eid="1KI 10:5"/><verse number="6" style="v" sid="1KI 10:6"/>عَ نَشَ عَ قَلَ مَنفّ بّ، «ﭑ قٍ نَشٍيٍ بِرِن مّشِ ﭑ مَ بْشِ مَ عِ شَ مَسٍنيِيٍ نُن عِ شَ لْننِ شَ قٍ رَ، نَ بِرِن قِندِشِ نْندِ نَن نَ. <verse eid="1KI 10:6"/><verse number="7" style="v" sid="1KI 10:7"/>بٍينُن ﭑ شَ بٍ تٌ ﭑ يّتّ رَ، ﭑ مُ لَ عٍ شَ مَسٍنيِ رَ. كْنْ يَكْسِ ﭑ بَرَ عَ كٌلٌن عِ شَ لْننِ فبٌ دَنفِقٍ عٍ نَشَن مَسٍنشِ ﭑ بّ. عِ قٍ نَشَن بِرِن تَفِ رَبَشِ ﭑ بّ نُن عِ شَ نَاقُلِ، نَ دَنفِ عِ شِلِ رَ. <verse eid="1KI 10:7"/><verse number="8" style="v" sid="1KI 10:8"/>حّلّشِنيِ نَ عِ شَ مِشِيٍ بّ، حّلّشِنيِ نَ عِ شَ كٌنيِيٍ بّ، بَرِ مَ عٍ نَ عِ سّيتِ مَ تّمُي بِرِن عِ شَ لْننِ رَ مّقٍ رَ. <verse eid="1KI 10:8"/><verse number="9" style="v" sid="1KI 10:9"/>تَنتُي نَ عِ مَرِفِ عَلَتَلَ بّ، نَشَن هِننّشِ عِ رَ، عَ قَ عِ دْشْ عِسِرَيِلَ مَنفّ كِبَنيِ كُي. عِ مَرِفِ عَلَ نَ رَبَ نّ بَرِ مَ عِسِرَيِلَ رَقَن عَ مَ عَبَدَن. عَ عِ قِندِشِ نّ عٍ شَ مَنفّ رَ عَلَكٌ عِ شَ عٍ يَمَرِ تِنشِنيِ نُن نْندِ رَ.» <verse eid="1KI 10:9"/><verse number="10" style="v" sid="1KI 10:10"/>عَ نَشَ شّيمَ كِلٌ وُلُ نَانِ قِ مَنفّ مَ، عَ نُن لَبُندّ فبٍفبٍ، نُن فّمّ تٌقَنيِيٍ. كَبِ نَ تّمُي، سٍيبَ مَنفّ فِنّ لَبُندّ شَسَبِ نَشَن قِ مَنفّ سُلٍمَنِ مَ نَ حْندْن مُ تٌ عِسِرَيِلَ بْشِ مَ سْنْن.<verse eid="1KI 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 10:11"/>شِرَ مِ نُن سُلٍمَنِ شَ وَلِكّيٍ نَشٍيٍ قَ شّيمَ رَ كٍلِقٍ عٌقِرِ بْشِ مَ، نٍيٍ مَن نَشَ قَ وُرِ نُن فّمّ تٌقَنيِيٍ رَ. <verse eid="1KI 10:11"/><verse number="12" style="v" sid="1KI 10:12"/>مَنفّ نَشَ نَ وُرِ رَوَلِ عَلَتَلَ شَ هْرْ مْبَنشِ سٌدٍ دّ رَ، عَ نُن مَنفّ شَ بَنشِ سٌدٍ دّ رَ. عَ مَن نَشَ نَ وُرِ رَوَلِ كْرَيٍ يَءِلَنقٍ رَ بّيتِبَيٍ بّ. نَ وُرِ مْولِ مُ نُ تٌشِ يُدَيَ سِندٍن.<verse eid="1KI 10:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 10:13"/>مَنفّ سُلٍمَنِ نَشَ سٍيبَ مَنفّ فِنّ وَشْنسٍ بِرِن سٌ عَ يِ رَ دَنفِقٍ عَ نَشَن نَسَنبَشِ عَ مَ. نَ شَنبِ، عَ نَشَ فبِلٍن عَ شَ بْشِ مَ، عَ تَن نُن عَ شَ مِشِيٍ.<verse eid="1KI 10:13"/></para>
  <para style="s">مَنفّ سُلٍمَنِ شَ نَاقُلِ</para>
  <para style="r">يُدَيَ مَنفّيٍ عِِ ١‏؛١٤ ٬ ١٧، ٩‏؛١٣ ٬ ٢٨</para>
  <para style="p">
    <verse number="14" style="v" sid="1KI 10:14"/>حّ يٌ حّ سُلٍمَنِ نُ شّيمَ كِلٌ وُلُ مْشْحّن نُن قِرِن، كِلٌ كّمّ سٍننِ تٌنفٌ نَانِ نُن نَانِ سْتْمَ، <verse eid="1KI 10:14"/><verse number="15" style="v" sid="1KI 10:15"/>بَقٍ عَ نَشَن سْتْ يُلّيَ دُوتِ رَ. عَ مَن نُ شّيمَ نُن فبٍتِ سْتْمَ مَنفّيٍ نُن فٌمِنَيٍ رَ عَرَبُ بْشِ مَ.<verse eid="1KI 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1KI 10:16"/>مَنفّ سُلٍمَنِ نَشَ سْورِ مَكَنتَسٍ كّمّ قِرِن يَءِلَن شّيمَ رَ، كَنكَن يَءِلَنشِ شّيمَ كِلٌ سٌلٌقٍرٍ نَن نَ. <verse eid="1KI 10:16"/><verse number="17" style="v" sid="1KI 10:17"/>عَ مَن نَشَ سْورِ مَكَنتَسٍ شُنشُرِ كّمّ سَشَن يَءِلَن شّيمَ رَ، كَنكَن يَءِلَنشِ شّيمَ كِلٌ سَشَن نَن نَ. عَ نَشَ عٍ فبَكُ بَنشِ كُي نَشَن شِلِ قَلَمَ لِبَن قْتْن بَنشِ. <verse eid="1KI 10:17"/><verse number="18" style="v" sid="1KI 10:18"/>مَنفّ نَشَ كِبَنيِ شُنفبٍ يَءِلَن سِلِ حِنيِ رَ، عَ قَ شّيمَ قَنيِ مَسٌ عَ مَ. <verse eid="1KI 10:18"/><verse number="19" style="v" sid="1KI 10:19"/>سَنتِدٍ سٍننِ نُ نَ نَ كِبَنيِ مَ. عَ شَنبِ رَدِفِلِنشِ، بّلّشّ سَدٍ قِرِن نُ نَ عَ سّيتِيٍ مَ، يّتّ مَسٌلِشِ قِرِن قَن نُ نَ عَ سّيتِيٍ مَ. <verse eid="1KI 10:19"/><verse number="20" style="v" sid="1KI 10:20"/>يّتّ قُ نُن قِرِن قَن مَسٌلِشِ نُ نَ سَنتِدٍيٍ سّيتِيٍ مَ، سٍننِ نُ نَ يِرٍقَنيِ مَ، سٍننِيٍ نُ نَ كْولَ مَ. نَ كِبَنيِ مَنِيّ مُ نُ نَ مَنفَتَا يٌ كُي سِندٍن. <verse eid="1KI 10:20"/><verse number="21" style="v" sid="1KI 10:21"/>مَنفّ سُلٍمَنِ شَ ثْوتِ بِرِن نُن لِبَن قْتْن بَنشِ شَ ثِلٍتِ بِرِن نُ يَءِلَنشِ شّيمَ نَن نَ. عَ مُ نُ فبٍتِ رَوَلِمَ قٍقٍ مَ، عَ تِدٍ مُ فبٌ عَ بّ. <verse eid="1KI 10:21"/><verse number="22" style="v" sid="1KI 10:22"/>كُنكُييٍ نُ نَ مَنفّ يِ رَ نَشٍيٍ نُ سِفَمَ تَرَ سِسِ حّ سَشَن يٌ حّ سَشَن شّيمَ، فبٍتِ، سِلِ حِنيِ، كُلٍ، نُن شْنِ تٌقَنيِيٍ تٌنفٌدٍ. شِرَ مِ شَ وَلِكّيٍ نُ عَ مَلِمَ نَ وَلِ كُي.<verse eid="1KI 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 10:23"/>مَنفّ سُلٍمَنِ شَ بَننَيَ نُن عَ شَ لْننِ نَشَ فبٌ يّ دَنفِ بْشِ مَنفّ بِرِن نَ. <verse eid="1KI 10:23"/><verse number="24" style="v" sid="1KI 10:24"/>بْشِ مَنفّ بِرِن نُ وَ مَ سُلٍمَنِ شَ لْننِ رَ مّقٍ عَلَ نَشَن سَشِ عَ شَشِلِ مَ. <verse eid="1KI 10:24"/><verse number="25" style="v" sid="1KI 10:25"/>نٍيٍ بِرِن نُ مَنفّ سَنبَمَ فبٍتِ، شّيمَ، دُفِيٍ، فٍرٍ سٌسٍيٍ، لَبُندّيٍ، سٌي، نُن سٌقَلٍيٍ رَ حّ يٌ حّ.<verse eid="1KI 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 10:26"/>سُلٍمَنِ نَشَ سْورِ رَفِسٍيٍ نُن سٌي رَفِيٍ مَلَن. سْورِ رَفِسٍ وُلُ كٍرٍن كّمّ نَانِ، نُن سٌي رَفِيٍ وُلُ قُ نُن قِرِن نَن نُ نَ مَنفَتَا دَرِ سَلَمُ نُن تَا مَكَنتَشِ فبّتّيٍ. <verse eid="1KI 10:26"/><verse number="27" style="v" sid="1KI 10:27"/>مَنفّ نَشَ عَ نِيَ فبٍتِ شَ وُيَ دَرِ سَلَمُ دَنفِقٍ فّمّ شْرِ رَ. وُرِ قَنيِ قَن نَشَن شِلِ سّدِرِ نَشَ وُيَ دَنفِقٍ سِكٌمٌرٌ وُرِ رَ نَشٍيٍ نَ سٍقٍلَ بْشِ مَ. <verse eid="1KI 10:27"/><verse number="28" style="v" sid="1KI 10:28"/>سُلٍمَنِ نُ سٌي سَرَ مَ مِسِرَ نُن كٌوَ بْشِ نَن مَ. مَنفّ شَ يُلّيٍ نُ سِفَمَ عٍ تٌنفٌدٍ. <verse eid="1KI 10:28"/><verse number="29" style="v" sid="1KI 10:29"/>عٍ سْورِ رَفِسٍ سَرَ فبٍتِ كِلٌ سٌلٌقٍرٍ رَ، عٍ سٌي سَرَ فبٍتِ كِلٌ كٍرٍن نُن عَ تَفِ. عٍ نَ مْولِ سَرَ شِتِ نُن عَرَ مِ مَنفّيٍ قَن بّ.<verse eid="1KI 10:29"/></para>
  <chapter eid="1KI 10"/>
  <chapter number="11" style="c" sid="1KI 11"/>
  <para style="s">سُلٍمَنِ فبِلٍنقٍ عَلَتَلَ قْشْ رَ</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 11:1"/>مَنفّ سُلٍمَنِ نَشَ فِنّ فبٍفبٍ دْشْ نَشٍيٍ مُ قِندِشِ عِسِرَيِلَكَيٍ رَ، عَلْ قِرَوُنَ شَ دِ فِنّ، مٌوَبَ فِنّيٍ، عَمٌنِ فِنّيٍ، عٍدٌن فِنّيٍ، سِدْن فِنّيٍ، نُن شِتِ فِنّيٍ. <verse eid="1KI 11:1"/><verse number="2" style="v" sid="1KI 11:2"/>عَلَتَلَ نُ بَرَ عَ قَلَ عِسِرَيِلَكَيٍ بّ نَ سِيٍ شَ قٍ رَ، «وٌ نَشَ سِفَ عٍ شْنيِ، عٍ قَن نَشَ قَ وٌ شْنيِ. شَ نَ مُ، عٍ وٌ بْحّيٍ يَ رَقِندِ مَ نّ عٍ شَ عَلَيٍ مَبِرِ.» كْنْ سُلٍمَنِ تَن بِرَ نَ مِشِيٍ نَن قْشْ رَ، فِنّيٍ مَشَنُقٍ رَ. <verse eid="1KI 11:2"/><verse number="3" style="v" sid="1KI 11:3"/>عَ مَنفّ دِ فِنّ كّمّ سٌلٌقٍرٍ نَن دْشْ، عَ كٌنيِ فِنّ كّمّ سَشَن قَن تٌنفٌ. نَ فِنّيٍ نَشَ عَ بْحّ مَقِندِ.<verse eid="1KI 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1KI 11:4"/>عَ تٌ قٌرِ، نَ فِنّيٍ نُ بَرَ عَ بْحّ بِرِن مَقِندِ عَلَ فبّتّيٍ مَ، عَ مُ بِرَ عَ مَرِفِ عَلَتَلَ قْشْ رَ عَلْ عَ بَبَ دَوُدَ. <verse eid="1KI 11:4"/><verse number="5" style="v" sid="1KI 11:5"/>مَنفّ سُلٍمَنِ نُ سِدْنكَيٍ شَ عَلَ عَسِتٍرٌتِ نُن عَمٌنِكَيٍ شَ عَلَ مْلْكْ قَن بَتُمَ. <verse eid="1KI 11:5"/><verse number="6" style="v" sid="1KI 11:6"/>مَنفّ سُلٍمَنِ نَشَ قٍ رَبَ، نَشَن مُ رَقَن عَلَتَلَ مَ، عَ مُ عَ شُي رَكَمَلِ عَلَتَلَ بّ عَلْ عَ بَبَ دَوُدَ. <verse eid="1KI 11:6"/><verse number="7" style="v" sid="1KI 11:7"/>نَ كُي سُلٍمَنِ نَشَ سّرّشّبَدٍ يَءِلَن مٌوَبَ شَ عَلَ كٍمٌسِ بّ، عَ نُن عَمٌنِكَيٍ شَ عَلَ مْلْكْ بّ فٍيَ قَرِ، نَشَن نُ نَ دَرِ سَلَمُ يَ رَ. <verse eid="1KI 11:7"/><verse number="8" style="v" sid="1KI 11:8"/>عَ نُ نَ مْولِ رَبَمَ عَ شَ فِنّيٍ بِرِن بّ، نَشٍيٍ نُ قَتَنشِ سِ فبّتّيٍ رَ، نَشٍيٍ نُ سُرَيِ نُن سّرّشّيٍ بَمَ عٍ شَ عَلَيٍ بّ.<verse eid="1KI 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 11:9"/>عَلَتَلَ نَشَ شْنْ مَنفّ سُلٍمَنِ مَ، بَرِ مَ عَ نُ بَرَ عَ كٌبٍ سٌ عِسِرَيِلَ مَرِفِ عَلَتَلَ رَ، نَشَن مِنِ عَ مَ سَنيَ قِرِن. <verse eid="1KI 11:9"/><verse number="10" style="v" sid="1KI 11:10"/>عَلَتَلَ نُ بَرَ تْنيِ دْشْ عَلَ فبّتّ بَتُقٍ رَ، كْنْ سُلٍمَنِ مُ عَلَتَلَ شَ يَامَرِ سُشُ. <verse eid="1KI 11:10"/><verse number="11" style="v" sid="1KI 11:11"/>نَ كُي عَلَتَلَ نَشَ عَ قَلَ سُلٍمَنِ بّ، «عِ تٌ بَرَ نَ مْولِ رَبَ، عِ مُ بِرَ ﭑ مَ يَامَرِيٍ قْشْ رَ ﭑ نَشٍيٍ بِرِن مَسٍن عِ بّ، عِ ﭑ مَ سَاتّ كَنَ، ﭑ عِ شَ مَنفّيَ بَمَ نّ عِ يِ رَ، ﭑ قَ عَ سٌ عِ شَ كٌنيِ ندٍ يِ رَ. <verse eid="1KI 11:11"/><verse number="12" style="v" sid="1KI 11:12"/>كْنْ عِ بَبَ دَوُدَ شَ قٍ رَ، ﭑ مُ نَ رَبَمَ عِ شَ سِمَيَ كُي، ﭑ مَنفّيَ بَمَ نّ عِ شَ دِ شّمّ يِ رَ. <verse eid="1KI 11:12"/><verse number="13" style="v" sid="1KI 11:13"/>ﭑ مُ مَنفّيَ بِرِن بَمَ عَ يِ رَ، ﭑ بْنسْي كٍرٍن نَن لُمَ عِ شَ دِ بّ ﭑ مَ كٌنيِ دَوُدَ شَ قٍ رَ، نُن دَرِ سَلَمُ شَ قٍ رَ ﭑ نَشَن سُفَندِشِ.»<verse eid="1KI 11:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1KI 11:14"/>عَلَتَلَ نَشَ سُلٍمَنِ فٍرٍقَ ندٍ رَ مِنِ، نَشَن نُ شِلِ هَدَدَ. عٍدٌن مَنفّ شَ دِ نَن نُ عَ رَ. <verse eid="1KI 11:14"/><verse number="15" style="v" sid="1KI 11:15"/>دَوُدَ عٍدٌن بْشِ فٍرٍ تّمُي نَشّ، عَ شَ سْورِ مَنفّ يٌوَبَ نُ بَرَ تٍ نَا عِسِرَيِلَ سْورِيٍ قُرٍيٍ رَفَتَدٍ. نَ تّمُي عَ مَن نَشَ عٍدٌن شّمّ بِرِن قَشَ. <verse eid="1KI 11:15"/><verse number="16" style="v" sid="1KI 11:16"/>يٌوَبَ نُن عَ شَ سْورِيٍ نَشَ لُ نَا كِكٍ سٍننِ، هَن عٍ فّ شّمّ بِرِن قَشَدٍ <verse eid="1KI 11:16"/><verse number="17" style="v" sid="1KI 11:17"/>هَدَدَ نُن عَ بَبَ شَ كٌنيِ عٍدٌنكَ ندٍيٍ نُ بَرَ عٍ فِ، عٍ سِفَ مِسِرَ. نَ رَبَ هَدَدَ دِ مّدِ تّمُي نّ. <verse eid="1KI 11:17"/><verse number="18" style="v" sid="1KI 11:18"/>عٍ تٌ كٍلِ مَدِيَن، عٍ نَشَ سِفَ ثَرَن. عٍ نَشَ مِشِيٍ تٌنفٌ مّننِ، عٍ قَ سِفَ مِسِرَ قِرَوُنَ يِرٍ. مِسِرَ مَنفّ نَشَ بَنشِ سٌ عَ يِ رَ، عَ عَ حْشْ سَ عَ شَ دٌنسٍ قٍ شْن مَ، عَ بْشِ قَن قِ عَ مَ.<verse eid="1KI 11:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 11:19"/>هَدَدَ نَشَ رَقَن قِرَوُنَ مَ، هَن عَ عَ شَ مَنفّ فِنّ شُنيَ قِ عَ مَ فِنّ رَ. <verse eid="1KI 11:19"/><verse number="20" style="v" sid="1KI 11:20"/>مَنفّ فِنّ تَثٍنٍسِ شُنيَ نَشَ دِ شّمّ بَرِ عَ بّ، نَشَن نُ شِلِ فٍنُبَتِ. تَثٍنٍسِ نَ دّ بَ قِرَوُنَ شْنيِ نّ، عَ قَ لُ مّننِ قِرَوُنَ شَ دِيٍ يَ مَ.<verse eid="1KI 11:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1KI 11:21"/>هَدَدَ تٌ عَ مّ عَ دَوُدَ نُن عَ شَ سْورِ مَنفّ يٌوَبَ بَرَ قَشَ، عَ نَشَ عَ قَلَ قِرَوُنَ بّ، عَ شَ دِحّ عَ مَ عَ شَ فبِلٍن عَ شْنيِ. <verse eid="1KI 11:21"/><verse number="22" style="v" sid="1KI 11:22"/>قِرَوُنَ نَشَ عَ يَابِ، «مُنقٍ رَ عِ وَ مَ فبِلٍنقٍ عِ شْنيِ؟ عِ وَشْنقٍ بِرِن نَ بٍ.» عَ نَشَ عَ يَابِ، «عِ نْندِ، كْنْ دِحّ ﭑ شَ فبِلٍن.»<verse eid="1KI 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 11:23"/>عَلَ نَشَ فٍرٍقَ فبّتّ رَ مِنِ مَنفّ سُلٍمَنِ بّ، نَشَن قِندِشِ عٍلِيَدَ شَ دِ رٍ سٌن نَ، نَشَن نُ بَرَ عَ فِ كٍلِقٍ سٌبَ مَنفّ هَدَدٍ سٍرِ شْنيِ، <verse eid="1KI 11:23"/><verse number="24" style="v" sid="1KI 11:24"/>دَوُدَ نُ نَ عٍ فٍرٍقٍ تّمُي نَشّ. رٍ سٌن شَ سْورِيٍ نَن مَلَن عَ قّ مَ، عٍ قَ لُ دَ مَسِ، عٍ مَنفّيَ سْتْ مّننِ. <verse eid="1KI 11:24"/><verse number="25" style="v" sid="1KI 11:25"/>رٍ سٌن نُن هَدَدَ قِندِ سُلٍمَنِ يَشُييٍ نَن نَ عَ شَ سِمَيَ بِرِن كُي. عَرَ مِ مَنفّ رٍ سٌن نُ عِسِرَيِلَ حَمَ شْنشِ.<verse eid="1KI 11:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 11:26"/>نٍبَتِ شَ دِ يٍرٌبٌوَ مِ نُ كٍلِشِ سٍرٍدَ نّ عٍقِرَ مِ بْشِ مَ. عَ نفَ نَشَ قِندِ كَاحّ فِنّ ندٍ رَ، نَشَن شِلِ سٍرُيَ. عَ نُ وَلِمَ مَنفّ سُلٍمَنِ شَ مِشِيٍ يَ مَ، كْنْ مَنفّ شَ قٍ مُ نُ رَقَن عَ مَ. <verse eid="1KI 11:26"/><verse number="27" style="v" sid="1KI 11:27"/>نَ رَكٍلِ يِ قٍ نَن مَ؛ مَنفّ سُلٍمَنِ نُ نَ مِلٌ تِقٍ، عَ نُن عَ بَبَ شَ تَا تّتّ يِرٍ ندٍ. <verse eid="1KI 11:27"/><verse number="28" style="v" sid="1KI 11:28"/>يٍرٌبٌوَ مِ تٌ قِندِ فبَنفبَلَنيِ قَنيِ نَن نَ، سُلٍمَنِ نَشَ عَ قِندِ تٍكُ وَلِ شُنيِ رَ يُسُقُ بْنسْي شُن مَ.<verse eid="1KI 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 11:29"/>لْشْي ندٍ يٍرٌبٌوَ مِ نَشَ مِنِ دَرِ سَلَمُ، عَ عَننَبِ عَهِيَ سِلٌكَ لِ كِرَ شْن مَ عٍ دٌرٌ. دٌنمَ شُنفبٍ نّينّ نُ رَفٌرٌشِ نَمِحْنمّ مَ. <verse eid="1KI 11:29"/><verse number="30" style="v" sid="1KI 11:30"/>عَننَبِ عَهِيَ نَشَ عَ شَ دٌنمَ نّينّ عِبْو شُنتُن قُ نُن قِرِن نَ، <verse eid="1KI 11:30"/><verse number="31" style="v" sid="1KI 11:31"/>عَ قَ عَ قَلَ يٍرٌبٌوَ مِ بّ، «شُنتُن قُ تٌنفٌ، بَرِ مَ عِسِرَيِلَ مَرِفِ عَلَتَلَ يِ نَن مَسٍنشِ ﭑ بّ، ‹ﭑ قَمَ نّ مَنفّيَ بَدٍ سُلٍمَنِ يِ رَ، ﭑ قَ بْنسْي قُ سَ عِ تَن شَ يَامَرِ بُن مَ. <verse eid="1KI 11:31"/><verse number="32" style="v" sid="1KI 11:32"/>ﭑ بْنسْي كٍرٍن لُمَ نّ سُلٍمَنِ بُن مَ ﭑ مَ كٌنيِ دَوُدَ شَ قٍ رَ نُن دَرِ سَلَمُ شَ قٍ رَ، ﭑ تَا نَشَن سُفَندِشِ عِسِرَيِلَ بْنسْي يَ مَ. <verse eid="1KI 11:32"/><verse number="33" style="v" sid="1KI 11:33"/>ﭑ نَ رَبَمَ نّ بَرِ مَ عٍ بَرَ عٍ كٌبٍ سٌ ﭑ نَ، عٍ سِدْن شَ عَلَ عَسِتٍرٌتِ، نُن مٌوَبَ شَ عَلَ كٍمٌسِ، نُن عَمٌنِ شَ عَلَ مْلْكْ بَتُ. عٍ مُ عٍ حّرّ مَ ﭑ مَ كِرَ شْن مَ، عٍ مُ ﭑ مَ يَامَرِيٍ رَتِنمّمَ عَلْ سُلٍمَنِ بَبَ دَوُدَ عَ رَبَ نّ كِ نَشّ. <verse eid="1KI 11:33"/><verse number="34" style="v" sid="1KI 11:34"/>ﭑ مُ مَنفّيَ بِرِن بَمَ سُلٍمَنِ يِ رَ، عَ شَ لُ مَنفّيَ كُي عَ شَ سِمَيَ بِرِن نَ ﭑ مَ كٌنيِ سُفَندِشِ دَوُدَ شَ قٍ رَ، نَشَن بَرَ ﭑ مَ يَامَرِيٍ نُن ﭑ وَشْنقٍ رَبَتُ. <verse eid="1KI 11:34"/><verse number="35" style="v" sid="1KI 11:35"/>كْنْ ﭑ مَنفّيَ بَمَ نّ دَوُدَ شَ دِ سُلٍمَنِ يِ رَ، ﭑ بْنسْي قُ قِ عِ مَ. <verse eid="1KI 11:35"/><verse number="36" style="v" sid="1KI 11:36"/>ﭑ بْنسْي كٍرٍن نَن لُمَ عَ شَ دِ يِ رَ، عَلَكٌ ﭑ مَ كٌنيِ دَوُدَ قْشِ شَ لُ دَرِ سَلَمُ عَبَدَن، ﭑ دّننَشّ سُفَندِشِ ﭑ شِلِ شَ قٍ رَ. <verse eid="1KI 11:36"/><verse number="37" style="v" sid="1KI 11:37"/>ﭑ عِ تٌنفٌمَ نّ، ﭑ عِ قِندِ مَنفّ رَ عِسِرَيِلَ شُن نَ. عِ لُمَ عِ وَشْندٍ نّ. <verse eid="1KI 11:37"/><verse number="38" style="v" sid="1KI 11:38"/>شَ عِ سَ عِ تُلِ مَتِ ﭑ نَ، شَ عِ سَ عِ حّرّ ﭑ مَ كِرَ شْن، شَ عِ سَ وَلِ ﭑ بّ، عِ ﭑ مَ يَامَرِيٍ رَتِنمّ، عِ ﭑ مَ سّرِيّ رَبَتُ، عَلْ ﭑ مَ كٌنيِ دَوُدَ عَ رَبَ كِ نَشّ، ﭑ لُمَ نّ عِ سّيتِ مَ تّمُي بِرِن، ﭑ عِ بْنسْي رَ سَبَتِمَ نّ، عَلْ ﭑ نَشَن نَبَشِ ﭑ مَ كٌنيِ مَنفّ دَوُدَ بّ، ﭑ عِسِرَيِلَ قِمَ نّ عِ مَ. <verse eid="1KI 11:38"/><verse number="39" style="v" sid="1KI 11:39"/>ﭑ مَنفّ دَوُدَ بْنسْييٍ رَيَافِمَ نّ، كْنْ كُدّ شَ مُ عَ رَ.›» <verse eid="1KI 11:39"/><verse number="40" style="v" sid="1KI 11:40"/>مَنفّ سُلٍمَنِ نَشَ وَ يٍرٌبٌوَ مِ قَشَقٍ. نَ نَن عَ نِيَ، يٍرٌبٌوَ مِ نَشَ عَ فِ، عَ سَ عَ شُنيِ تَشُ سِسَكِ رَ مِسِرَ مَنفّ. عَ نَشَ لُ مّننِ هَن مَنفّ سُلٍمَنِ نَشَ قَشَ.<verse eid="1KI 11:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="1KI 11:41"/>سُلٍمَنِ شَ تَرُشُي دْنشْي، عَ قْلّ نُن عَ رَحْنيِ، عَ سّبّشِ سُلٍمَنِ شَ تَرُشُي كُي. <verse eid="1KI 11:41"/><verse number="42" style="v" sid="1KI 11:42"/>سُلٍمَنِ شَ مَنفّيَ نَشَ بُ حّ تٌنفٌ نَانِ دَرِ سَلَمُ نُن عِسِرَيِلَ شُن مَ. <verse eid="1KI 11:42"/><verse number="43" style="v" sid="1KI 11:43"/>نَ شَنبِ، سُلٍمَنِ نَشَ لَاشِرَ. عٍ نَشَ عَ رَفَتَ عَ بَبَيٍ سّيتِ مَ عَ بَبَ دَوُدَ شَ تَا كُي. عَ شَ دِ رٌبٌوَ مِ نَشَ لُ عَ حْشْي رَ.<verse eid="1KI 11:43"/></para>
  <chapter eid="1KI 11"/>
  <chapter number="12" style="c" sid="1KI 12"/>
  <para style="s">رٌبٌوَ مِ نُن يٍرٌبٌوَ مِ</para>
  <para style="r">يُدَيَ مَنفّيٍ عِِ ١٠‏؛١ ٬ ١٥</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 12:1"/>رٌبٌوَ مِ نَشَ سِفَ سِكٍمِ، بَرِ مَ عِسِرَيِلَكَيٍ بِرِن نُ مَلَنشِ نَا، عٍ شَ عَ تِ مَنفّ رَ. <verse eid="1KI 12:1"/><verse number="2" style="v" sid="1KI 12:2"/>نٍبَتِ شَ دِ يٍرٌبٌوَ مِ نَشَ نَ قٍ مّ مِسِرَ، عَ تٌ عَ فِ سُلٍمَنِ مَ عَ سِفَ دّننَشّ. <verse eid="1KI 12:2"/><verse number="3" style="v" sid="1KI 12:3"/>مِشِ ندٍيٍ نَشَ عَ شِلِ عَ شَ قَ عِسِرَيِلَ بْشِ مَ. يٍرٌبٌوَ مِ نُن عِسِرَيِلَكَيٍ بِرِن نَشَ سِفَ رٌبٌوَ مِ يِرٍ، عٍ عَ قَلَ عَ بّ، <verse eid="1KI 12:3"/><verse number="4" style="v" sid="1KI 12:4"/>«عِ بَبَ مُشُ سُشُ نّ عَلْ كٌنيِيٍ. يَكْسِ تَن، عِ شَ ندٍ بَ مُشُ شَ كٌتٍ رَ عِ بَبَ نَشَن سَشِ مُشُ قَرِ. نَ كُي مُشُ قَمَ عِ شَ يَامَرِ رَبَتُدٍ.» <verse eid="1KI 12:4"/><verse number="5" style="v" sid="1KI 12:5"/>عَ نَشَ عٍ يَابِ، «شِ سَشَن نَ دَنفِ، وٌ شَ قَ.» حَمَ نَشَ سِفَ.<verse eid="1KI 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 12:6"/>مَنفّ رٌبٌوَ مِ نَشَ مَرَ سِ قٍن قٌرِيٍ رَ، نَشٍيٍ نُ نَ عَ بَبَ سُلٍمَنِ قّ مَ عَ شَ سِمَيَ كُي، عَ قَ عٍ مَشْرِن، «وٌ مَرَ سِ مُندُن قِمَ ﭑ مَ ﭑ نَن ﭑ مَ حَمَ يَابِمَ نَشَن نَ؟» <verse eid="1KI 12:6"/><verse number="7" style="v" sid="1KI 12:7"/>عٍ نَشَ عَ يَابِ، «شَ عِ قٍ قَنيِ رَبَمَ حَمَ بّ، شَ عِ تِن عٍ وَشْنقٍ رَ، شَ عِ وْيّن قَنيِ قَلَ عٍ بّ، عٍ لُمَ نّ عِ شَ يَامَرِ بُن مَ تّمُي بِرِن.»<verse eid="1KI 12:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 12:8"/>كْنْ رٌبٌوَ مِ مُ تِن قٌرِيٍ شَ مَرَ سِ رَ. عَ نَشَ عَ لَنقَنمَ بٌورٍيٍ مَشْرِن عَ لَنمَ عَ شَ نَشَن نَبَ. <verse eid="1KI 12:8"/><verse number="9" style="v" sid="1KI 12:9"/>عَ نَشَ عٍ مَشْرِن، «وٌ مَرَ سِ مُندُن قِمَ ﭑ مَ ﭑ نَ ﭑ مَ حَمَ يَابِمَ نَشَن نَ، حَمَ نَشَن ﭑ مَيَندِ مَ ﭑ شَ ندٍ بَ عٍ شَ كٌتٍ رَ ﭑ بَبَ نَشَن سَشِ عٍ قَرِ.» <verse eid="1KI 12:9"/><verse number="10" style="v" sid="1KI 12:10"/>عَ لَنقَنمَيٍ نَشَ عَ يَابِ، «عِ شَ يِ حَمَ يَابِ يِ كِ، نَشٍيٍ عِ مَيَندِشِ عِ شَ ندٍ بَ عٍ شَ كٌتٍ رَ عِ بَبَ نَشَن سَشِ عٍ قَرِ. عِ شَ عَ قَلَ عٍ بّ، ‹ﭑ بّلّشّ سٌلٍ لَنمَدِ شُنفبٌ ﭑ بَبَ تَفِ بّ. <verse eid="1KI 12:10"/><verse number="11" style="v" sid="1KI 12:11"/>يَكْسِ، ﭑ بَبَ شَ كٌتٍ شْرْشْ عَ نَشَن دْشْ وٌ مَ، ﭑ تَن نَ شُن مَسَمَ نّ. ﭑ بَبَ وٌ بْنبْ لُشُسِنيِيٍ نَن نَ، كْنْ ﭑ تَن قَمَ وٌ بْنبْدٍ تَلِيٍ نَن نَ.›»<verse eid="1KI 12:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1KI 12:12"/>شِ سَشَن تٌ دَنفِ، يٍرٌبٌوَ مِ نُن حَمَ نَشَ سِفَ رٌبٌوَ مِ يِرٍ، نَشَن نُ بَرَ عَ قَلَ، «شِ سَشَن نَ دَنفِ، وٌ شَ قَ.» <verse eid="1KI 12:12"/><verse number="13" style="v" sid="1KI 12:13"/>مَنفّ رٌبٌوَ مِ نَشَ عٍ يَابِ عَ شْرْشْي رَ، عَ مُ قٌرِيٍ شَ مَرَ سِ تٌنفٌ. <verse eid="1KI 12:13"/><verse number="14" style="v" sid="1KI 12:14"/>عَ نَشَ عٍ يَابِ عَ لَنقَنمَيٍ شَ مَرَ سِ رَ، «ﭑ نَ ﭑ بَبَ شَ كٌتٍ شْرْشْي شُن مَ سَمَ نّ عَ نَشَن دْشْ وٌ مَ. ﭑ بَبَ وٌ بْنبْ لُشُسِنيِيٍ نَن نَ، كْنْ ﭑ تَن قَمَ وٌ بْنبْدٍ تَلِيٍ نَن نَ.» <verse eid="1KI 12:14"/><verse number="15" style="v" sid="1KI 12:15"/>نَ كُي، مَنفّ مُ تِن عَ تُلِ مَتِدٍ حَمَ رَ. مَرِفِ عَلَتَلَ نُ بَرَ نَ رَفِرِ عَلَكٌ عَ شَ عَ شَ مَسٍنيِ رَكَمَلِ عَ نَشَن قَلَ نٍبَتِ شَ دِ يٍرٌبٌوَ مِ بّ عَننَبِ عَهِيَ سِلٌكَ سَابُي رَ.<verse eid="1KI 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1KI 12:16"/>عِسِرَيِلَكَيٍ تٌ عَ كٌلٌن مَنفّ مُ تِن عَ تُلِ مَتِدٍ عٍ رَ، عٍ نَشَ عَ يَابِ،</para>
  <para style="q" vid="1KI 12:16">«مُنسٍ نَ وٌن نُن دَوُدَ بْنسْي تَفِ؟</para>
  <para style="q" vid="1KI 12:16">كّ مُ نَ مُشُ بّ يِسَيِ شَ دِيٍ تَفِ.</para>
  <para style="q" vid="1KI 12:16">عِسِرَيِلَ شَ فبِلٍن عٍ شْنيِ.</para>
  <para style="q" vid="1KI 12:16">يَكْسِ دَوُدَ، عِ شَ مّينِ عِ شَ بَنشِ مَ عِ يّتّ رَ.»</para>
  <para style="m" vid="1KI 12:16">نَ كُي، عِسِرَيِلَ بِرِن نَشَ فبِلٍن عٍ شْنيِ.<verse eid="1KI 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1KI 12:17"/>عِسِرَيِلَكَ نَشٍيٍ نُ سَبَتِشِ يُدَيَ تَايٍ كُي، نٍيٍ نَشَ لُ رٌبٌوَ مِ شَ يَامَرِ بُن مَ. <verse eid="1KI 12:17"/><verse number="18" style="v" sid="1KI 12:18"/>نَ دَنفِ شَنبِ، مَنفّ رٌبٌوَ مِ نَشَ عَدٌرَ مِ شّي، نَشَن حّنفِ نُ سَشِ تٍكُ وَلِ شْن مَ، كْنْ عِسِرَيِلَكَيٍ نَشَ عَ مَفْنْ هَن عَ قَشَ. مَنفّ رٌبٌوَ مِ نَشَ عَ فِ كٍرٍن نَ سِفَقٍ رَ دَرِ سَلَمُ عَ شَ سْورِ رَفِسٍ كُي. <verse eid="1KI 12:18"/><verse number="19" style="v" sid="1KI 12:19"/>عِسِرَيِلَ دَوُدَ شَبِلّ مَتَندِ نَ كِ نّ. هَن تٌ عٍ مُ لَنشِ.<verse eid="1KI 12:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1KI 12:20"/>عِسِرَيِلَكَ بِرِن تٌ عَ مّ عَ يٍرٌبٌوَ مِ بَرَ قَ، عٍ نَشَ عٍ مَلَن، عٍ عَ شِلِ، عٍ عَ قِندِ مَنفّ رَ عِسِرَيِلَ بِرِن شُن مَ. يُدَيَ نَن كٍرٍن سَ دَوُدَ بْنسْي دّ رَ.<verse eid="1KI 12:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1KI 12:21"/>رٌبٌوَ مِ تٌ سٌ دَرِ سَلَمُ، عَ نَشَ يُدَ نُن بُنيَمِن بْنسْي سْورِيٍ مَلَن، فٍرٍ سٌي قَنيِ وُلُ كّمّ تٌنفٌ سٌلٌمَسَشَن، عَلَكٌ عٍ شَ عِسِرَيِلَ فٍرٍ، عِسِرَيِلَ شَ فبِلٍن رٌبٌوَ مِ شَ مَنفّيَ بُن مَ. <verse eid="1KI 12:21"/><verse number="22" style="v" sid="1KI 12:22"/>كْنْ عَلَتَلَ نَشَ عَ مَسٍن عَ شَ مِشِ سٍمَيَ بّ، <verse eid="1KI 12:22"/><verse number="23" style="v" sid="1KI 12:23"/>«عَ قَلَ سُلٍمَنِ شَ دِ رٌبٌوَ مِ بّ، يُدَيَ مَنفّ، عَ نُن عِسِرَيِلَكَيٍ بِرِن نَشٍيٍ نَ يُدَيَ نُن بُنيَمِن بْشِ مَ، <verse eid="1KI 12:23"/><verse number="24" style="v" sid="1KI 12:24"/>عَلَتَلَ شَ مَسٍنيِ نَن يِ كِ؛ ‹وٌ نَشَ تٍ دٍ سِفَقٍ رَ وٌن نفَشَكٍرٍنيِيٍ فٍرٍدٍ. وٌ بِرِن شَ فبِلٍن وٌ شْنيِ، بَرِ مَ ﭑ تَن نَن يِ قٍ رَفِرِشِ.›» عٍ نَشَ عَلَتَلَ شَ مَسٍنيِ رَبَتُ، عٍ نَشَ فبِلٍن، عٍ مُ سِفَ يٍرٌبٌوَ مِ فٍرٍدٍ سْنْن.<verse eid="1KI 12:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 12:25"/>يٍرٌبٌوَ مِ نَشَ سِكٍمِ تَا تِ عٍقِرَ مِ فٍيَيٍ يِرٍ، عَ سَبَتِ نَا. نَ دَنفِ شَنبِ، عَ مَن نَشَ سِفَ، عَ ثٍنِيٍلِ تِ. <verse eid="1KI 12:25"/><verse number="26" style="v" sid="1KI 12:26"/>يٍرٌبٌوَ مِ نَشَ عَ قَلَ عَ بْحّ مَ، «تّمُندٍ يِ حَمَ قَمَ فبِلٍندٍ، عٍ لُ دَوُدَ بْنسْي شَ يَامَرِ بُن مَ، <verse eid="1KI 12:26"/><verse number="27" style="v" sid="1KI 12:27"/>شَ عٍ لُمَ تٍ رَ سّرّشّيٍ بَدٍ عَلَتَلَ شَ بَنشِ كُي دَرِ سَلَمُ. يِ حَمَ بْحّ يَ قَمَ نّ رَقِندِدٍ عٍ مَرِفِ رٌبٌوَ مِ يُدَيَ مَنفّ مَ، عٍ ﭑ تَن قَشَ، عٍ قَ فبِلٍن يُدَيَ مَنفّ رٌبٌوَ مِ مَ.»<verse eid="1KI 12:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1KI 12:28"/>عَ تٌ فّ مَرَ سِ قٍندٍ، مَنفّ نَشَ نِنفٍ مِسَالِ قِرِن يَءِلَن شّيمَ رَ، عَ قَ عَ قَلَ حَمَ بّ، «وٌ شَ سِفّ دَرِ سَلَمُ مُ لَنمَ سْنْن. عِسِرَيِلَ، وٌ شَ عَلَيٍ نَن يِ كِ نَشٍيٍ وٌ رَ مِنِ مِسِرَ بْشِ مَ.» <verse eid="1KI 12:28"/><verse number="29" style="v" sid="1KI 12:29"/>عَ نَشَ كٍرٍن تِ بٍتٍلِ، عَ كٍرٍن تِ دَنَ. <verse eid="1KI 12:29"/><verse number="30" style="v" sid="1KI 12:30"/>نَ نَن قِندِشِ يُنُبِ رَ عٍ بّ. حَمَ نُ لُمَ سِفَ رَ نَ كُيٍيٍ بَتُدٍ بٍتٍلِ، شَ نَ مُ عَ رَ دَنَ. <verse eid="1KI 12:30"/><verse number="31" style="v" sid="1KI 12:31"/>يٍرٌبٌوَ مِ نَشَ سَلِدٍيٍ تِ يِرٍ عِتٍشِ، عَ قَ مِشِيٍ تِ سّرّشّدُبّ رَ نَشٍيٍ مُ قِندِ لٍوِ دِيٍ رَ.<verse eid="1KI 12:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="1KI 12:32"/>يٍرٌبٌوَ مِ نَشَ سَلِ ندٍ رَبَ كِكٍ سٌلٌمَسَشَن ندٍ شِ قُ نُن سُولِ ندٍ رَ، عَلْ سَلِ نَشَن مْولِ نُ رَبَمَ يُدَيَ. عَ يّتّ يَتِ نَشَ سّرّشّيٍ بَ نَ كُيٍ نِنفٍ دَاشِيٍ بّ، عَ نَشٍيٍ يَءِلَن بٍتٍلِ. عَ نَشَ سّرّشّدُبّيٍ دْشْ بٍتٍلِ نَ سَلِدٍ يِرٍيٍ، عَ نَشٍيٍ تِ فٍيَيٍ كْن. <verse eid="1KI 12:32"/><verse number="33" style="v" sid="1KI 12:33"/>عَ نَشَ سّرّشّ بَ نَ سَلِدٍ كُي، عَ نَشَن يَءِلَن بٍتٍلِ. عَ نَ رَبَ كِكٍ سٌلٌمَسَشَن ندٍ شِ قُ نُن سُولِ ندٍ نّ. عَ نُ بَرَ نَ كِكٍ سُفَندِ عَ يّتّ كَن وَشْنكِ رَ. عَ نَشَ سَلِ شُنفبٍ رَبَ عِسِرَيِلَكَيٍ بّ، عَ سُرَيِ فَن سّرّشّ رَ بٍتٍلِ سّرّشّبَدٍ قَرِ.<verse eid="1KI 12:33"/></para>
  <chapter eid="1KI 12"/>
  <chapter number="13" style="c" sid="1KI 13"/>
  <para style="s">نَمِحْنمّ شَ مَسٍنيِ يٍرٌبٌوَ مِ بّ</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 13:1"/>عَلَتَلَ شَ شّيرَ ندٍ نَشَ قَ بٍتٍلِ كٍلِقٍ يُدَيَ بْشِ مَ. يٍرٌبٌوَ مِ نُ تِشِ سّرّشّبَدٍ قَرِ، عَ نَ سُرَيِ فَنقٍ سّرّشّ رَ. <verse eid="1KI 13:1"/><verse number="2" style="v" sid="1KI 13:2"/>عَلَتَلَ شَ شّيرَ نَشَ عَ شُي عِتٍ سّرّشّبَدٍ عَ شْرْشْ رَ عَ عَلَتَلَ شَ مَسٍنيِ قَلَ عَ شُي عِتٍشِ رَ. عَ نَشّ، «سّرّشّبَدٍ، سّرّشّبَدٍ! عَلَتَلَ شَ مَسٍنيِ نَن يَ؛ ‹دِ شّمّ ندٍ بَرِ مَ نّ مَنفّ دَوُدَ بْنسْي يَ مَ، عَ شِلِ يٌسِيَ. عَ عِ شَ سّرّشّدُبّيٍ قِندِ سّرّشّ رَ عِ قَرِ، نَشٍيٍ سُرَيِ بَمَ سّرّشّ رَ سَلِدٍ فٍيَيٍ قَرِ. مِشِ شْرِيٍ نَن يَتِ فَنمَ عِ قَرِ!›» <verse eid="1KI 13:2"/><verse number="3" style="v" sid="1KI 13:3"/>نَ لْشْي عَ نَشَ تْنشُمَ قِ عٍ مَ، عَ نَشَ عَ قَلَ عٍ بّ، «تْنشُمَ نَن يَ عَلَكٌ وٌ شَ عَ كٌلٌن عَ ﭑ تَن عَلَتَلَ شُي يَتِ نَن قَلَشِ وٌ بّ. يِ سّرّشّبَدٍ قَمَ نّ عِبْودٍ، عَ شُبٍ عِبْفٌنمَ بْشِ مَ.»<verse eid="1KI 13:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1KI 13:4"/>مَنفّ يٍرٌبٌوَ مِ تٌ عَلَ شَ شّيرَ شَ مَسٍنيِ مّ، عَ نَشَن قَلَ عَ شُي عِتٍشِ رَ بٍتٍلِ سّرّشّبَدٍ شَ قٍ رَ، عَ نَشَ عَ بّلّشّ عِتَلَ نَ سّرّشّبَدٍ قَرِ، عَ قَ عَ قَلَ، «نَ شّمّ سُشُ.» عَ تٌ نَ رَبَ، عَ بّلّشّ نَشَ شْرْشْ عَ رَ، عَ مُ نْ عَ رَ مَشَدٍ سْنْن. <verse eid="1KI 13:4"/><verse number="5" style="v" sid="1KI 13:5"/>نَ سّرّشّبَدٍ نَشَ عِبْو كٍرٍن نَ، عَ شُبٍ نَشَ عِبْفٌن بْشِ مَ، عَلْ عَلَتَلَ شَ شّيرَ عَ قَلَ كِ نَشّ.<verse eid="1KI 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 13:6"/>نَ كُي مَنفّ نَشَ عَ قَلَ عَلَ شَ شّيرَ بّ، «عِ مَرِفِ عَلَتَلَ مَشَندِ ﭑ بّ، عَلَكٌ ﭑ بّلّشّ شَ يَلَن.» عَلَ شَ شّيرَ نَشَ عَلَ مَشَندِ عَ بّ، يٍرٌبٌوَ مِ بّلّشّ نَشَ يَلَن عَلْ عَ سِنفٍ. <verse eid="1KI 13:6"/><verse number="7" style="v" sid="1KI 13:7"/>مَنفّ نَشَ عَ قَلَ عَلَ شَ شّيرَ بّ، «قَ ﭑ شْنيِ عِ شَ عِ مَلَبُ، ﭑ بُحَ ندٍ قِمَ عِ مَ.» <verse eid="1KI 13:7"/><verse number="8" style="v" sid="1KI 13:8"/>عَلَ شَ شّيرَ نَشَ مَنفّ يَابِ، «هَلِ عِ نَاقُلِ فبٍفبٍ قِمَ ﭑ مَ، ﭑ مُ سٌمَ عِ شْنيِ. ﭑ مُ سٍسٍ دٌنمَ، ﭑ مُ سٍسٍ مِنمَ بٍ، <verse eid="1KI 13:8"/><verse number="9" style="v" sid="1KI 13:9"/>بَرِ مَ عَلَتَلَ ﭑ يَمَرِشِ يِ نَن نَ، ‹عِ نَشَ سٍسٍ دٌن، عِ نَشَ سٍسٍ مِن نَ يِرٍ. عِ شَ فبِلٍن عِ شْنيِ كِرَ فبّتّ رَ.›» <verse eid="1KI 13:9"/><verse number="10" style="v" sid="1KI 13:10"/>عَ نَشَ فبِلٍن كِرَ فبّتّ رَ، عَ مُ فبِلٍن كِرَ رَ عَ قَ نَشَن شْن مَ عَ سِنفٍ.<verse eid="1KI 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 13:11"/>نَمِحْنمّ شّمْشِ ندٍ نُ نَ بٍتٍلِ تَا كُي. عَ شَ دِ ندٍ نَشَ نَ قٍ يَ مَشَرَن عَ بّ، عَلَ شَ شّيرَ نَشَن بِرِن نَبَ بٍتٍلِ نَ لْشْي، نُن عَ وْيّنيِ نَشٍيٍ قَلَ مَنفّ بّ. عَ شَ دِ تٌ فّ نَ قٍ بِرِن مَسٍندٍ عَ بّ، <verse eid="1KI 13:11"/><verse number="12" style="v" sid="1KI 13:12"/>عَ نَشَ عَ تَن نُن عَ شُنيَيٍ مَشْرِن، «عَ فبِلٍن كِرَ مُندُن نَ؟» عَ شَ دِيٍ نُ بَرَ عَ كٌلٌن نَ شّيرَ فبِلٍن كِرَ نَشَن نَ. عٍ تٌ نَ قَلَ عٍ بَبَ بّ، <verse eid="1KI 13:12"/><verse number="13" style="v" sid="1KI 13:13"/>عَ نَشَ عَ قَلَ عٍ بّ، «وٌ قَ ﭑ مَ سٌقَلٍ رَ.» عٍ تٌ عَ يَءِلَن، عَ نَشَ تٍ عَ قَرِ، <verse eid="1KI 13:13"/><verse number="14" style="v" sid="1KI 13:14"/>عَ بِرَ عَلَ شَ شّيرَ قْشْ رَ، هَن عَ سَ عَ لِ وُرِ ندٍ بُن مَ.</para>
  <para style="p" vid="1KI 13:14">عَ نَشَ عَ قَلَ عَ بّ، «عَلَ شَ شّيرَ نَ عِ تَن نَن نَ نَشَن كٍلِ يُدَيَ؟» عَ نَشَ عَ يَابِ، «عِيٌ، ﭑ تَن نَن عَ رَ.» <verse eid="1KI 13:14"/><verse number="15" style="v" sid="1KI 13:15"/>نَمِحْنمّ شّمْشِ نَشَ عَ قَلَ عَ بّ، «وٌن شَ فبِلٍن ﭑ شْنيِ، وٌن شَ وٌن دّفٍ.» <verse eid="1KI 13:15"/><verse number="16" style="v" sid="1KI 13:16"/>عَلَ شَ شّيرَ نَشَ عَ يَابِ، «ﭑ مُ نْمَ فبِلٍندٍ، ﭑ مُ نْمَ سٌدٍ عِ شْنيِ. ﭑ مُ سٍسٍ دٌنمَ، ﭑ مُ سٍسٍ مِنمَ يِ يِرٍ، <verse eid="1KI 13:16"/><verse number="17" style="v" sid="1KI 13:17"/>بَرِ مَ عَلَتَلَ عَ مَسٍنشِ نّ ﭑ بّ، ‹عِ نَشَ سٍسٍ دٌن، عِ نَشَ سٍسٍ مِن، عِ نَشَ فبِلٍن كِرَ رَ عِ قَ قَمَ قَشِ نَشَن شْن مَ.›»<verse eid="1KI 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1KI 13:18"/>شّمْشِ نَشَ عَ قَلَ عَ بّ، «ﭑ تَن قَن قِندِشِ نَمِحْنمّ نَن نَ عَلْ عِ تَن. مَلٍكّ ندٍ نَن فٌرٌشِ ﭑ مَ، عَ عَلَ شَ مَسٍنيِ تِ ﭑ بّ، عَ قَلَقٍ رَ، ‹نَ مِشِ رَفبِلٍن عِ شْنيِ، عَ شَ عَ دّفٍ، عَ شَ عَ مِن.›» عَ نُ وُلٍ نَن قَلَقٍ عَ بّ. <verse eid="1KI 13:18"/><verse number="19" style="v" sid="1KI 13:19"/>نَ كُي عَلَ شَ شّيرَ نَشَ فبِلٍن، عٍ نَشَ عٍ دّفٍ، عٍ نَشَ عٍ مِن.<verse eid="1KI 13:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1KI 13:20"/>عٍ نُ دْشْشِ تٍيبِلِ رَ تّمُي نَشّ، عَلَ شَ مَسٍنيِ نَشَ فٌرٌ نَ نَمِحْنمّ شّمْشِ مَ، <verse eid="1KI 13:20"/><verse number="21" style="v" sid="1KI 13:21"/>عَ نَشَ عَ شُي عِتٍ عَلَ شَ شّيرَ بّ نَشَن كٍلِ يُدَيَ بْشِ مَ. عَ نَشَ عَ قَلَ عَ بّ، «عَلَ شَ مَسٍنيِ نَن يَ؛ ‹عِ تٌ عِ مَرِفِ عَلَتَلَ شَ يَامَرِ مَتَندِ، عِ مُ عَ شُي سُشُ، <verse eid="1KI 13:21"/><verse number="22" style="v" sid="1KI 13:22"/>عَ قَلَقٍ رَ عِ نَشَ سٍسٍ دٌن، عِ نَشَ سٍسٍ مِن بٍ، عِ قُرٍ مُ رَفَتَمَ عِ بٍنبَيٍ شَ فَبُرِ يِرٍ.›»<verse eid="1KI 13:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 13:23"/>عَلَ شَ نَمِحْنمّ تٌ فّ عَ دّفٍدٍ، نَ شّمْشِ نَشَ قَ عَ شَ سٌقَلٍ رَ عَلَكٌ بٌورٍ شَ سِفَ. <verse eid="1KI 13:23"/><verse number="24" style="v" sid="1KI 13:24"/>عَ تٌ سِفَ، عَ شَ بِيَاسِ كُي يّتّ ندٍ نَشَ دُتُن عَ مَ كِرَ شْن مَ، عَ عَ قَشَ. عَ قُرٍ نَشَ سَ كِرَ شْن مَ، عَ شَ سٌقَلٍ نُن نَ يّتّ نَشَ تِ عَ قّ مَ. <verse eid="1KI 13:24"/><verse number="25" style="v" sid="1KI 13:25"/>دَنفِ مِشِيٍ نَشَ عَ قُرٍ تٌ كِرَ دّ رَ، يّتّ تِشِ عَ قّ مَ. عٍ تٌ بٍتٍلِ لِ، نَمِحْنمّ شّمْشِ نُ نَ دّننَشّ، عٍ نَشَ نَ قٍ قَلَ مِشِيٍ بّ.<verse eid="1KI 13:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 13:26"/>نَمِحْنمّ شّمْشِ نَشَن عَلَ شَ شّيرَ رَفبِلٍن عَ شْنيِ عَ تٌ نَ قٍ مّ، عَ نَشَ عَ قَلَ، «نَ عَلَ شَ شّيرَ نَن عَ رَ، نَشَن عَلَتَلَ شَ يَامَرِ مَتَندِشِ. عَلَتَلَ بَرَ عَ نِيَ يّتّ شَ عَ عِبْو، عَ شَ عَ قَشَ، عَلْ عَ مَسٍنشِ عَ بّ كِ نَشّ.» <verse eid="1KI 13:26"/><verse number="27" style="v" sid="1KI 13:27"/>نَ تّمُي عَ نَشَ عَ قَلَ عَ شَ دِيٍ بّ، «وٌ قَ ﭑ مَ سٌقَلٍ رَ.» عٍ نَشَ نَ رَبَ. <verse eid="1KI 13:27"/><verse number="28" style="v" sid="1KI 13:28"/>عَ تٌ سِفَ، عَ نَشَ عَلَ شَ شّيرَ قُرٍ تٌ كِرَ شْن مَ، يّتّ نُن سٌقَلٍ تِشِ عَ قّ مَ. يّتّ مُ قُرٍ دٌنشِ، عَ مُ سٌقَلٍ عِبْوشِ. <verse eid="1KI 13:28"/><verse number="29" style="v" sid="1KI 13:29"/>نَمِحْنمّ شّمْشِ نَشَ عَلَ شَ شّيرَ قُرٍ تٌنفٌ، عَ عَ سَ عَ شَ سٌقَلٍ قَرِ، عَ فبِلٍن عَ رَ. نَمِحْنمّ شّمْشِ نَشَ عَ رَ سٌ تَا كُي، عَ عَ كَسَنفٍ، عَ عَ شَ حْن قٍ رَبَ. <verse eid="1KI 13:29"/><verse number="30" style="v" sid="1KI 13:30"/>عَ تٌ عَ قُرٍ سَ فَبُرِ كُي، عَ نَشَ عَ قَلَ، «ﭑ نفَشَكٍرٍنيِ، عِ نُ تْورْ.»<verse eid="1KI 13:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="1KI 13:31"/>نَ تٌ بَ عَ رَ، شّمْشِ نَشَ عَ قَلَ عَ شَ دِيٍ بّ، «ﭑ نَ قَشَ، وٌ شَ ﭑ سَ يِ فَبُرِ كُي عَلَ شَ شّيرَ قُرٍ سَشِ دّننَشّ. وٌ شَ ﭑ شْرِيٍ سَ عَ شْرِيٍ قّ مَ. <verse eid="1KI 13:31"/><verse number="32" style="v" sid="1KI 13:32"/>عَ نَشَن قَلَ عَلَتَلَ شِلِ رَ بٍتٍلِ نُن يِ سّرّشّبَدٍ نَشٍيٍ نَ فٍيَيٍ مَ سَمَرِ بْشِ مَ، عَ قَمَ نّ كَمَلِدٍ.»<verse eid="1KI 13:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="1KI 13:33"/>نَ قٍيٍ تٌ دَنفِ، يٍرٌبٌوَ مِ مُ فبِلٍن عَ شَ قٍ حَاشِيٍ قْشْ رَ. عَ مِشِ مْولِ بِرِن تِ سّرّشّدُبّ رَ نَ سَلِدٍيٍ كُي فٍيَيٍ قَرِ، نَشٍيٍ نَ تِن نَ رَ. <verse eid="1KI 13:33"/><verse number="34" style="v" sid="1KI 13:34"/>نَ نَن قِندِ يٍرٌبٌوَ مِ بْنسْي شَ يُنُبِ رَ. عَلَ عٍ سْنتْ نّ، عَ عٍ قَ عٍ رَلْي دُنِحَ مَ.<verse eid="1KI 13:34"/></para>
  <chapter eid="1KI 13"/>
  <chapter number="14" style="c" sid="1KI 14"/>
  <para style="s">يٍرٌبٌوَ مِ شَ مَنفّيَ رَحْنيِ</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 14:1"/>نَ تّمُي يٍرٌبٌوَ مِ شَ دِ عَبِيَ نَشَ قُرَ. <verse eid="1KI 14:1"/><verse number="2" style="v" sid="1KI 14:2"/>يٍرٌبٌوَ مِ نَشَ عَ قَلَ عَ شَ فِنّ بّ، «عِ شَ عِ مَشِرِ كّحَ ندٍ رَ، عَلَكٌ مِشِ نَشَ عَ كٌلٌن عَ يٍرٌبٌوَ مِ شَ فِنّ نَن عِ رَ. عِ سِفَ سِلٌ عَننَبِ عَبِيَ شْن مَ، نَشَن عَ قَلَ ﭑ بّ، عَ ﭑ قِندِ مَ نّ يِ بْشِ مَنفّ رَ. <verse eid="1KI 14:2"/><verse number="3" style="v" sid="1KI 14:3"/>عِ شَ تَامِ قُ، سٍ حْشُنمّ ندٍيٍ، نُن كُمِ ندٍ شَنِن عَ شْن. عَ عَ قَلَمَ نّ عِ بّ، قٍ نَشَن قَمَ وٌن مَ دِ لِدٍ.»<verse eid="1KI 14:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1KI 14:4"/>يٍرٌبٌوَ مِ شَ فِنّ نَشَ عَ رَبَ نَ كِ، عَ نَشَ سِفَ سِلٌ، عَ سَ سٌ عَهِيَ شْنيِ. عَهِيَ نُ بَرَ قٌرِ، عَ يَ مُ نُ سٍ عِفبّمَ سْنْن. <verse eid="1KI 14:4"/><verse number="5" style="v" sid="1KI 14:5"/>عَلَتَلَ نُ بَرَ عَ قَلَ عَهِيَ بّ، «يٍرٌبٌوَ مِ شَ فِنّ نَن قَقٍ يِ كِ، عَ قَشِ عِ مَشْرِندٍ عَ شَ دِ شَ قٍ مَ، بَرِ مَ نَ مُ يَلَنشِ. عِ شَ ﭑ مَ مَسٍنيِ تِ عَ بّ. عَ قَمَ فُندٌ كِ نَن مَ، عَلَكٌ مِشِ مُ عَ كٌلٌنمَ كِ نَشّ يٍرٌبٌوَ مِ شَ فِنّ نَ عَ رَ.»<verse eid="1KI 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 14:6"/>عَهِيَ تٌ عَ سَنيِ شُي مّ عَ بَرَ مَكْرّ نَادّ رَ، عَ نَشَ عَ قَلَ عَ بّ، «سٌ، يٍرٌبٌوَ مِ شَ فِنّ. عِ قَشِ عَ فُندٌ كِ مَ مُنقٍ رَ؟ مَسٍنيِ شْرْشْي نَن يِ رَ عِ بّ. <verse eid="1KI 14:6"/><verse number="7" style="v" sid="1KI 14:7"/>سِفَ، عِ سَ عَ قَلَ يٍرٌبٌوَ مِ بّ، عِسِرَيِلَ مَرِفِ عَلَتَلَ نَشّ، ‹ﭑ بَرَ عِ شَ قٍ عِتٍ حَمَ تَفِ، ﭑ بَرَ عِ تِ مَنفّ رَ ﭑ مَ حَمَ عِسِرَيِلَ شُن مَ، <verse eid="1KI 14:7"/><verse number="8" style="v" sid="1KI 14:8"/>ﭑ بَرَ مَنفّيَ بَ دَوُدَ بْنسْي يِ رَ، ﭑ عَ قِ عِ تَن مَ. كْنْ عِ مُ لُشِ عَلْ ﭑ مَ كٌنيِ دَوُدَ، نَشَن ﭑ مَ سّرِيّ رَبَتُ، عَ بِرَ ﭑ قْشْ رَ عَ بْحّ بِرِن نَ ﭑ وَشْنقٍ رَبَدٍ. <verse eid="1KI 14:8"/><verse number="9" style="v" sid="1KI 14:9"/>عِ وَلِ كِ حَاشُ دَنفِ مِشِ بِرِن نَ. عِ بَرَ ﭑ نَشْنْ عِ شَ كُيٍيٍ بَتُقٍ رَ، نَشٍيٍ يَءِلَنشِ وُرٍ رَشُنُشِ رَ. عِ بَرَ عِ كٌبٍ رَ سٌ ﭑ نَ. <verse eid="1KI 14:9"/><verse number="10" style="v" sid="1KI 14:10"/>نَ نَن عَ تٌشِ، ﭑ فبَلٌي رَفٌرٌ مَ عِ تَن يٍرٌبٌوَ مِ بْنسْي، عِ شَ كٌنيِيٍ، نُن عِ شَ مِشِ شْرّيَشِيٍ مَ. عٍ بِرِن سْنتْمَ نّ. ﭑ قٍ حَاشِ بَمَ نّ وٌ تَفِ، عَلْ فِنّ بَنشِ مَكْمَ كِ نَشّ. <verse eid="1KI 14:10"/><verse number="11" style="v" sid="1KI 14:11"/>يٍرٌبٌوَ مِ بْنسْي نَشَن نَ قَشَ تَا كُي، بَرٍيٍ نَن نَ قُرٍ دٌنمَ. نَشَن نَ قَشَ وُلَ عِ، شْنِيٍ نَن نَ دٌنمَ.› عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.»<verse eid="1KI 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1KI 14:12"/>عَهِيَ مَن نَشَ عَ قَلَ نَ فِنّ بّ، «يَكْسِ عِ شَ فبِلٍن عِ شْنيِ. عِ نّقّ عِ سَنيِ تِ تَا كُي، وٌ شَ دِ قَشَمَ نّ. <verse eid="1KI 14:12"/><verse number="13" style="v" sid="1KI 14:13"/>عِسِرَيِلَكَيٍ بِرِن عَ حْن قٍ رَبَ، عٍ عَ رَفَتَ فَبُرِ كُي. عَ كٍرٍن نَن سَمَ فَبُرِ كُي يٍرٌبٌوَ مِ شَ دٍنبَيَ يَ مَ، بَرِ مَ عَ كٍرٍن نَن قٍ قَنيِ رَبَشِ عِسِرَيِلَ مَرِفِ عَلَتَلَ بّ يٍرٌبٌوَ مِ شَ مِشِيٍ تَفِ. <verse eid="1KI 14:13"/><verse number="14" style="v" sid="1KI 14:14"/>عَ فبٍ مُ لُشِ سْنْن عَلَتَلَ شَ قَ مَنفّ دْشْ عِسِرَيِلَ شُن مَ يٍرٌبٌوَ مِ حْشْي رَ. <verse eid="1KI 14:14"/><verse number="15" style="v" sid="1KI 14:15"/>عَلَتَلَ شَ شْنّ سِنمَ نّ عِسِرَيِلَ مَ، عَلْ قٌيٍ شُنفبٍ سِنمَ كَلٍيٍ مَ شُرٍ دّ رَ كِ نَشّ. عَ عِسِرَيِلَ تَلَمَ نّ يِ بْشِ قَنيِ مَ، عَ نَشَن قِ عَ بٍنبَيٍ مَ، عَ قَ عٍ رَيٍنسٍن يّ شُرٍ كِرِ مَ، بَرِ مَ عٍ بَرَ كُيٍيٍ يَءِلَن. <verse eid="1KI 14:15"/><verse number="16" style="v" sid="1KI 14:16"/>عَ عِسِرَيِلَ سَمَ نّ عَ يَشُييٍ بّلّشّ عِ يُنُبِ شَ قٍ رَ، عِسِرَيِلَ نَشَن نَبَ يٍرٌبٌوَ مِ قْشِ رَ.»<verse eid="1KI 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1KI 14:17"/>يٍرٌبٌوَ مِ شَ فِنّ نَشَ سِفَ. عَ تٌ سٌ تِرِ سَ، عَ بَرَ مَكْرّ نَادّ رَ عَ شْنيِ، عَ شَ دِ نَشَ قَشَ. <verse eid="1KI 14:17"/><verse number="18" style="v" sid="1KI 14:18"/>عٍ نَشَ عَ رَفَتَ، عِسِرَيِلَ بِرِن قَ عَ حْن قٍ رَبَ، عَلْ عَلَتَلَ عَ مَسٍن كِ نَشّ عَ شَ كٌنيِ عَننَبِ عَهِيَ بّ.<verse eid="1KI 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 14:19"/>يٍرٌبٌوَ مِ شَ تَرُشُي دْنشْي نَ عِسِرَيِلَ مَنفّيٍ شَ تَرُشُي كُي. عَ شَ فٍرٍيٍ نُن عَ شَ مَنفّيَ شَ قٍ بِرِن سّبّشِ عَ كُي. <verse eid="1KI 14:19"/><verse number="20" style="v" sid="1KI 14:20"/>يٍرٌبٌوَ مِ مَنفّيَ رَبَ نّ حّ مْشْحّن نُن قِرِن. نَ تّمُي عَ نَشَ قَشَ، عَ شَ دِ شّمّ نَدَبٌ نَشَ تِ مَنفّ رَ عَ حْشْي رَ.<verse eid="1KI 14:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1KI 14:21"/>سُلٍمَنِ شَ دِ رٌبٌوَ مِ قِندِ يُدَيَ مَنفّ رَ تّمُي نَشّ، عَ شَ سِمَيَ نُ نَ حّ تٌنفٌ نَانِ نُن كٍرٍن. عَ حّ قُ نُن سٌلٌقٍرٍ مَنفّيَ نَن نَبَ دَرِ سَلَمُ، عَلَتَلَ تَا نَشَن سُفَندِ عَ شِلِ شَ قٍ رَ عِسِرَيِلَ بْنسْي بِرِن تَفِ. عَ نفَ عَمٌنِكَ نُ شِلِ نّ نَامَ.<verse eid="1KI 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 14:22"/>يُدَيَكَيٍ قَن نَشَ عَلَتَلَ رَشْنْ عٍ شَ يُنُبِيٍ رَ، عٍ بٍنبَيٍ مُ نُ دَرِشِ نَشٍيٍ مْولِ رَ. <verse eid="1KI 14:22"/><verse number="23" style="v" sid="1KI 14:23"/>عٍ قَن نَشَ سّرّشّبَدٍيٍ يَءِلَن يِرٍ عِتٍشِ بِرِن قَرِ وُرِيٍ قّ مَ، عٍ قَ فّمّ مَسٌلِشِيٍ نُن عَسٍرِ وُرِ مَسٌلِشِيٍ تِ نَا. <verse eid="1KI 14:23"/><verse number="24" style="v" sid="1KI 14:24"/>لَنفٌييٍ قَن نُ نَ نَا. عٍ نُ قٍ حَاشِيٍ رَبَمَ نَ سَلِ مْولِ كُي، عَلْ سِيٍ، عَلَ نَشٍيٍ كٍرِ نَ بْشِ مَ، نٍيٍ نُ عَ رَبَمَ كِ نَشّ بٍينُن عِسِرَيِلَكَيٍ شَ سَبَتِ نَا.<verse eid="1KI 14:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 14:25"/>نَ بَرَ عَ نِيَ رٌبٌوَ مِ شَ مَنفّيَ حّ سُولِ ندٍ رَ، مِسِرَ مَنفّ سِسَكِ شَ دَرِ سَلَمُ فٍرٍ. <verse eid="1KI 14:25"/><verse number="26" style="v" sid="1KI 14:26"/>عَ نَشَ نَاقُلِ بِرِن تٌنفٌ نَشَن نُ نَ عَلَتَلَ شَ بَنشِ نُن مَنفّ شَ بَنشِ كُي. عَ نَشَ وُرٍ لٍقَيٍ قَن تٌنفٌ، سُلٍمَنِ نُ بَرَ نَشٍيٍ مَسٌ شّيمَ رَ. <verse eid="1KI 14:26"/><verse number="27" style="v" sid="1KI 14:27"/>مَنفّ رٌبٌوَ مِ نَشَ عٍ حْشْي يَءِلَن يْشُي رَ، عَ عٍ تَشُ سْورِ مَنفّيٍ رَ نَشٍيٍ مَنفّ شَ بَنشِ نَادّيٍ مَكَنتَمَ. <verse eid="1KI 14:27"/><verse number="28" style="v" sid="1KI 14:28"/>مَنفّ نُ سِفَمَ عَلَ شَ بَنشِ كُي تّمُي نَشّ، سْورِيٍ نُ نَ وُرٍ لٍقَيٍ رَوَلِمَ. مَنفّ نَ فبِلٍن، عٍ مَن قَ نَ وُرٍ لٍقَيٍ رَفبِلٍن سْورِ بَنشِ كُي.<verse eid="1KI 14:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 14:29"/>رٌبٌوَ مِ شَ تَرُشُي دْنشْي سّبّشِ يُدَيَ مَنفّيٍ شَ تَرُشُي نَن كُي. <verse eid="1KI 14:29"/><verse number="30" style="v" sid="1KI 14:30"/>تّمُي بِرِن، رٌبٌوَ مِ نُن يٍرٌبٌوَ مِ نُ لُمَ عٍ بٌورٍ فٍرٍ رَ. <verse eid="1KI 14:30"/><verse number="31" style="v" sid="1KI 14:31"/>رٌبٌوَ مِ تٌ لَاشِرَ، عٍ نَشَ عَ رَفَتَ عَ بٍنبَيٍ سّيتِ مَ دَوُدَ شَ تَا كُي. عَ شَ دِ عَبِيَ نَشَ تِ عَ حْشْي رَ. عَ نفَ عَمٌنِكَ نُ شِلِ نّ نَامَ.<verse eid="1KI 14:31"/></para>
  <chapter eid="1KI 14"/>
  <chapter number="15" style="c" sid="1KI 15"/>
  <para style="s">عَبِيَمِ قِندِقٍ يُدَيَ مَنفّ رَ</para>
  <para style="r">يُدَيَ مَنفّيٍ عِِ ١٣‏؛١ ٬ ٢٢</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 15:1"/>يٍرٌبٌوَ مِ شَ مَنفّيَ حّ قُ نُن سٌلٌمَسَشَن ندٍ رَ، نٍبَتِ شَ دِ عَبِيَمِ نَشَ تِ مَنفّ رَ يُدَيَ. <verse eid="1KI 15:1"/><verse number="2" style="v" sid="1KI 15:2"/>عَ شَ مَنفّيَ بُ نّ حّ سَشَن دَرِ سَلَمُ. عَ نفَ نُ شِلِ نّ مَاكَ، عَبِسَالٌن شَ دِ. <verse eid="1KI 15:2"/><verse number="3" style="v" sid="1KI 15:3"/>عَ قَن نَشَ بِرَ يُنُبِ قٍيٍ قْشْ رَ، عَ بَبَ نُ نَشٍيٍ رَبَمَ. عَ بْحّ بِرِن مُ نُ نَ عَ مَرِفِ عَلَتَلَ بّ، عَلْ عَ بٍنبَ دَوُدَ فبٍ نُ نَ كِ نَشّ. <verse eid="1KI 15:3"/><verse number="4" style="v" sid="1KI 15:4"/>كْنْ عَلَتَلَ نَشَ عَ تِ مَنفّ رَ دَرِ سَلَمُ عَ بَبَ دَوُدَ شَ قٍ رَ، <verse eid="1KI 15:4"/><verse number="5" style="v" sid="1KI 15:5"/>بَرِ مَ دَوُدَ نُ بَرَ عَلَتَلَ وَشْنقٍ رَبَ، عَ بِرَ عَ شَ سّرِيّ قْشْ رَ عَ شَ دُنِحّءِفِرِ بِرِن كُي، قٌ عُرِ شِتِكَ شَ قٍ. <verse eid="1KI 15:5"/><verse number="6" style="v" sid="1KI 15:6"/>رٌبٌوَ مِ نُن يٍرٌبٌوَ مِ نُ عٍ بٌورٍ فٍرٍ مَ عٍ شَ سِمَيَ بِرِن كُي.<verse eid="1KI 15:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 15:7"/>عَبِيَمِ شَ تَرُشُي دْنشْي سّبّشِ يُدَيَ مَنفّيٍ شَ تَرُشُي كُي. عَبِيَمِ نُن يٍرٌبٌوَ مِ نُ عٍ بٌورٍ فٍرٍ مَ تّمُي بِرِن. <verse eid="1KI 15:7"/><verse number="8" style="v" sid="1KI 15:8"/>عَ نَشَ لَاشِرَ، عٍ عَ رَفَتَ عَ بٍنبَيٍ سّيتِ مَ دَوُدَ شَ تَا كُي. عَ شَ دِ عَسَ نَشَ تِ مَنفّ رَ عَ حْشْي رَ.<verse eid="1KI 15:8"/></para>
  <para style="s">عَسَ قِندِقٍ يُدَيَ مَنفّ رَ</para>
  <para style="r">يُدَيَ مَنفّيٍ عِِ ١٤‏؛١ ٬ ٢، ١٥‏؛١٦ ٬ ١٦‏؛٦‏،١١ ٬ ١٤</para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 15:9"/>عِسِرَيِلَ مَنفّ يٍرٌبٌوَ مِ شَ مَنفّيَ حّ مْشْحّن ندٍ رَ، عَسَ نَشَ تِ مَنفّ رَ يُدَيَ. <verse eid="1KI 15:9"/><verse number="10" style="v" sid="1KI 15:10"/>عَ حّ تٌنفٌ نَانِ نُن كٍرٍن نَن نَبَ مَنفّيَ كُي دَرِ سَلَمُ. عَ نفَ نُ شِلِ نّ مَاكَ، عَبِسَالٌن شَ دِ. <verse eid="1KI 15:10"/><verse number="11" style="v" sid="1KI 15:11"/>عَسَ نَشَ عَلَ وَشْنقٍ رَبَ عَلْ عَ بٍنبَ دَوُدَ عَ رَبَ كِ نَشّ. <verse eid="1KI 15:11"/><verse number="12" style="v" sid="1KI 15:12"/>عَ نَشَ كُيٍ قٍ كَنَ، عَ بَبَيٍ نَشٍيٍ قْلْ، عَ لَنفٌييٍ كٍرِ نَ سّرّشّبَدٍيٍ شُن مَ.<verse eid="1KI 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 15:13"/>عَ نَشَ مَنفّ فِنّ بِنيّ بَ عَ نفَ مَاكَ مَ، بَرِ مَ عَ نُ عَسٍرَ كُيٍ بَتُمَ. عَ نَشَ نَ كُيٍ رَبِرَ، عَ عَ فَن، عَ عَ شُبٍ وٌلِ سٍدِرٌن شُرٍ كُي. <verse eid="1KI 15:13"/><verse number="14" style="v" sid="1KI 15:14"/>هَلِ عَسَ بْحّ بِرِن تٌ نُ نَ عَلَتَلَ نَن بّ عَ شَ سِمَيَ بِرِن كُي، عَ مُ فّ كُيٍ سّرّشّبَدٍيٍ بِرِن كَنَدٍ يِرٍ عِتٍشِيٍ يُدَيَ بْشِ مَ. <verse eid="1KI 15:14"/><verse number="15" style="v" sid="1KI 15:15"/>عَسَ نَشَ شّيمَ، فبٍتِ، نُن سٍ قَنيِيٍ رَ سٌ عَلَتَلَ شَ بَنشِ كُي، عَ تَن نُن عَ بَبَ نَشٍيٍ بَ عَلَتَلَ بّ.<verse eid="1KI 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1KI 15:16"/>عَسَ نُن عِسِرَيِلَ مَنفّ بَاسَ نُ عٍ بٌورٍ فٍرٍ مَ عٍ شَ سِمَيَ بِرِن كُي. <verse eid="1KI 15:16"/><verse number="17" style="v" sid="1KI 15:17"/>عِسِرَيِلَ مَنفّ بَاسَ نَشَ تٍ يُدَيَ فٍرٍ شِلِ مَ. عَ نَشَ رَ مَ تَا تِ، عَلَكٌ عَ شَ كِرَ عِبٌلٌن يُدَيَ مَنفّ عَسَ يَ رَ. <verse eid="1KI 15:17"/><verse number="18" style="v" sid="1KI 15:18"/>عَسَ نَشَ فبٍتِ نُن شّيمَ تٌنفٌ عَلَتَلَ شَ بَنشِ نُن مَنفّ شَ بَنشِ كُي، عَ عَ سٌ شّيرَيٍ يِ رَ، عَ عٍ شّي دَ مَسِ تَا، عَرَ مِ مَنفّ بٍن هَدَدَ يِرٍ يِ مَسٍنيِ رَ؛ <verse eid="1KI 15:18"/><verse number="19" style="v" sid="1KI 15:19"/>«وٌن شَ سَاتّ شِرِ وٌن تَفِ عَلْ ﭑ بَبَ نُن عِ بَبَ عَ رَبَ كِ نَشّ. سَنبَسٍ نَن يَ، شّيمَ نُن فبٍتِ. سَاتّ كَنَ نَشَن نَ عِ نُن عِسِرَيِلَ مَنفّ بَاسَ تَفِ، عَلَكٌ عَ شَ مَكُيَ ﭑ نَ.»<verse eid="1KI 15:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1KI 15:20"/>بٍن هَدَدَ نَشَ تِن مَنفّ عَسَ شَ مَسٍنيِ رَ. عَ نَشَ عَ شَ سْورِ شُنيِيٍ شّي عِسِرَيِلَ تَايٍ سُشُدٍ. عٍ نَشَ عِيٌنٌ، دَنَ، عَبٍلِ بٍتِ مَاكَ، كِنٍرٍتِ، نُن نَقَتَلِ بْشِ سُشُ. <verse eid="1KI 15:20"/><verse number="21" style="v" sid="1KI 15:21"/>بَاسَ تٌ نَ قٍ مّ، عَ نَشَ رَ مَ تِقٍ وَلِ رَتِ، عَ لُ تِرِ سَ تَا كُي. <verse eid="1KI 15:21"/><verse number="22" style="v" sid="1KI 15:22"/>نَ وَلِ تٌ تِ، مَنفّ عَسَ نَشَ يُدَيَكَيٍ بِرِن شِلِ، عٍ شَ قَ تٍكُ فّمّيٍ نُن وُرِيٍ تٌنفٌدٍ بَاسَ نُ نَشٍيٍ رَوَلِمَ رَ مَ. عٍ نَشَ نَ بِرِن شَنِن، عٍ عَ رَوَلِ فٍبَ نُن مِسِثَ تِقٍ رَ.<verse eid="1KI 15:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 15:23"/>عَسَ شَ تَرُشُي دْنشْي، عَ شَ فٍرٍيٍ شَ قٍ، عَ شَ تَا تِقٍ شَ قٍ، نُن عَ شَ قٍ بِرِن سّبّشِ يُدَيَ نُن عِسِرَيِلَ مَنفّيٍ شَ تَرُشُي كُي. عَسَ تٌ قٌرِ، قُرٍ ندٍ نَشَ عَ سَنيِيٍ سُشُ. <verse eid="1KI 15:23"/><verse number="24" style="v" sid="1KI 15:24"/>عَسَ نَشَ لَاشِرَ. عٍ نَشَ عَ رَفَتَ فَبُرِ كُي عَ بٍنبَ دَوُدَ شَ تَا عَ بٍنبَيٍ قّ مَ. عَ شَ دِ يٍهٌسَقَتِ نَشَ تِ مَنفّ رَ عَ حْشْي رَ.<verse eid="1KI 15:24"/></para>
  <para style="s">نَدَبٌ قِندِقٍ عِسِرَيِلَ مَنفّ رَ</para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 15:25"/>يٍرٌبٌوَ مِ شَ دِ نَدَبٌ نَشَ تِ عِسِرَيِلَ مَنفّ رَ يُدَيَ مَنفّ عَسَ شَ مَنفّيَ حّ قِرِن ندٍ رَ. نَدَبٌ نَشَ مَنفّيَ شَنِن حّ قِرِن عِسِرَيِلَ بْشِ مَ. <verse eid="1KI 15:25"/><verse number="26" style="v" sid="1KI 15:26"/>عَ نَشَ قٍ رَبَ نَشَن مُ رَقَن عَلَتَلَ مَ، عَ عَ حّرّ عَ بَبَ شَ كِرَ شْن مَ، نَشَن عَ نِيَ عِسِرَيِلَ شَ يُنُبِ رَبَ. <verse eid="1KI 15:26"/><verse number="27" style="v" sid="1KI 15:27"/>عَهِيَ شَ دِ بَاسَ، قَتَنقٍ عِسَكَرِ بْنسْي رَ، نَشَ يَنقَنتٍيَ مَشِرِ عَ شُن مَ. بَاسَ نَشَ عَ قَشَ فِبّتْن، عَ تَن نَدَبٌ نُن عِسِرَيِلَكَيٍ نُ نَ قِلِسِتَكَيٍ فٍرٍقٍ تّمُي نَشّ. <verse eid="1KI 15:27"/><verse number="28" style="v" sid="1KI 15:28"/>بَاسَ عَ قَشَ يُدَيَ مَنفّ عَسَ شَ مَنفّيَ حّ سَشَن ندٍ نّ، عَ تِ عِسِرَيِلَ مَنفّ رَ عَ حْشْي رَ. <verse eid="1KI 15:28"/><verse number="29" style="v" sid="1KI 15:29"/>عَ تٌ قِندِ مَنفّ رَ، عَ نَشَ يٍرٌبٌوَ مِ بْنسْي بِرِن قَشَ. عَ مُ كٍرٍن لُ، عَ عٍ بِرِن سْنتْ نّ، عَلْ عَلَتَلَ نُ بَرَ عَ مَسٍن كِ نَشّ عَننَبِ عَهِيَ سَابُي رَ، نَشَن نُ نَ سِلٌ. <verse eid="1KI 15:29"/><verse number="30" style="v" sid="1KI 15:30"/>عَ قَشَ يٍرٌبٌوَ مِ شَ يُنُبِ نَن مَ قٍ رَ، نَشَن عَ نِيَ عِسِرَيِلَ قَن شَ عٍ كٌبٍ رَ سٌ عٍ مَرِفِ عَلَتَلَ رَ.<verse eid="1KI 15:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="1KI 15:31"/>نَدَبٌ شَ تَرُشُي دْنشْي نُن عَ قٍ نَشَن بِرِن نَبَ، نَ سّبّشِ عِسِرَيِلَ مَنفّيٍ شَ تَرُشُي كُي. <verse eid="1KI 15:31"/><verse number="32" style="v" sid="1KI 15:32"/>عَسَ نُن عِسِرَيِلَ مَنفّ بَاسَ نُ عٍ بٌورٍ فٍرٍ مَ عٍ شَ سِمَيَ بِرِن كُي.<verse eid="1KI 15:32"/></para>
  <para style="s">بَاسَ قِندِقٍ عِسِرَيِلَ مَنفّ رَ</para>
  <para style="p">
    <verse number="33" style="v" sid="1KI 15:33"/>يُدَيَ مَنفّ عَسَ شَ مَنفّيَ حّ سَشَن ندٍ رَ، عَهِيَ شَ دِ بَاسَ نَشَ تِ عِسِرَيِلَ مَنفّ رَ تِرِ سَ. عَ بُ نّ مَنفّيَ كُي حّ مْشْحّن نُن نَانِ. <verse eid="1KI 15:33"/><verse number="34" style="v" sid="1KI 15:34"/>عَ نَشَ قٍ رَبَ نَشَن مُ رَقَن عَلَتَلَ مَ، عَ بِرَ يٍرٌبٌوَ مِ شَ كِرَ قْشْ رَ، نَشَن عَ نِيَ عِسِرَيِلَ قَن شَ يُنُبِ رَبَ.<verse eid="1KI 15:34"/></para>
  <chapter eid="1KI 15"/>
  <chapter number="16" style="c" sid="1KI 16"/>
  <para style="s">بَاسَ شَ مَنفّيَ</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 16:1"/>عَلَتَلَ نَشَ يِ مَسٍنيِ رَفٌرٌ شَنَنِ شَ دِ يٍهُ مَ بَاسَ بّ؛ <verse eid="1KI 16:1"/><verse number="2" style="v" sid="1KI 16:2"/>«ﭑ بَرَ عِ تٌنفٌ دُنِحَ بّندّ قُحِ قَرِ، ﭑ عِ قِندِ ﭑ مَ حَمَ شَ مَنفّ رَ. كْنْ عِ تَن بَرَ بِرَ يٍرٌبٌوَ مِ شَ كِرَ قْشْ رَ، عِ ﭑ مَ عِسِرَيِلَ حَمَ تِ يُنُبِ رَبَقٍ رَ، نَشَن بَرَ ﭑ نَشْنْ عَ حَاشِ رَ. <verse eid="1KI 16:2"/><verse number="3" style="v" sid="1KI 16:3"/>نَ كُي ﭑ عِ تَن بَاسَ بَمَ نّ مَنفّ رَ، عَلْ فِنّ عَ شَ بَنشِ كُي مَكْمَ كِ نَشّ. ﭑ عِ بْنسْي لُمَ نّ، عَلْ ﭑ نٍبَتِ شَ دِ يٍرٌبٌوَ مِ بْنسْي لُشِ كِ نَشّ. <verse eid="1KI 16:3"/><verse number="4" style="v" sid="1KI 16:4"/>بَاسَ بْنسْي نَشَن نَ قَشَ تَا كُي، بَرٍيٍ نَن نَ دٌنمَ. نَشَن نَ قَشَ وُلَ عِ، شْنِيٍ نَن نَ دٌنمَ.»<verse eid="1KI 16:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 16:5"/>بَاسَ شَ تَرُشُي دْنشْي نُن عَ شَ فٍرٍ كِ قَنيِ، بِرِن سّبّشِ عِسِرَيِلَ مَنفّيٍ شَ تَرُشُي كُي. <verse eid="1KI 16:5"/><verse number="6" style="v" sid="1KI 16:6"/>بَاسَ نَشَ لَاشِرَ، عَ نَشَ رَفَتَ تِرِ سَ. عَ شَ دِ عٍلَ نَشَ تِ مَنفّ رَ عَ حْشْي رَ. <verse eid="1KI 16:6"/><verse number="7" style="v" sid="1KI 16:7"/>عَلَتَلَ عَ شَ مَسٍنيِ تِ نّ بَاسَ نُن عَ بْنسْي بّ، شَنَنِ شَ دِ عَننَبِ يٍهُ سَابُي رَ. نَ مَسٍنيِ تِ عَ شَ قٍ حَاشِيٍ نَن مَ قٍ رَ، نَشٍيٍ مُ رَقَنشِ عَلَتَلَ مَ. عَ نُ بَرَ مَنِيَ يٍرٌبٌوَ مِ بْنسْي رَ، عَ نَشَن سْنتْ.<verse eid="1KI 16:7"/></para>
  <para style="s">عٍلَ قِندِقٍ عِسِرَيِلَ مَنفّ رَ</para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 16:8"/>عَسَ شَ مَنفّيَ حّ مْشْحّن نُن سٍننِ ندٍ رَ، بَاسَ شَ دِ عٍلَ نَشَ تِ عِسِرَيِلَ مَنفّ رَ. عَ شَ مَنفّيَ بُ نّ حّ قِرِن. <verse eid="1KI 16:8"/><verse number="9" style="v" sid="1KI 16:9"/>سِمِرِ، عَ شَ سْورِ مَنفّ ندٍ، نَشَن نُ قِندِشِ عَ شَ سْورِ رَفِسٍيٍ سّيتِ كٍرٍن شُنيِ رَ، نَشَ يَنقَنتٍيَ شِرِ عَ شُن. لْشْي ندٍ عٍلَ نُ نَ تِرِ سَ عَ سِيسِقٍ عَرِ سَ شْنيِ، نَشَن قِندِ نَ مَنفّ شَ بَنشِ كَنتّ رَ. <verse eid="1KI 16:9"/><verse number="10" style="v" sid="1KI 16:10"/>سِمِرِ نَشَ سٌ نَا، عَ عَ قَشَ. يُدَيَ مَنفّ عَسَ شَ مَنفّيَ حّ مْشْحّن نُن سٌلٌقٍرٍ ندٍ رَ، سِمِرِ نَشَ تِ عِسِرَيِلَ مَنفّ رَ عٍلَ حْشْي رَ.<verse eid="1KI 16:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 16:11"/>عَ تٌ قِندِ مَنفّ رَ، عَ نَشَ دْشْ كِبَنيِ، عَ بَاسَ بْنسْي بِرِن قَشَ نّ. عَ مُ نَ شَ مِشِ يٌ لُ، نَ بٌورٍ ندٍ بَ، نَ حْشْي بَ. <verse eid="1KI 16:11"/><verse number="12" style="v" sid="1KI 16:12"/>سِمِرِ بَاسَ بْنسْي بِرِن سْنتْ نّ، عَلْ عَلَتَلَ عَ مَسٍن كِ نَشّ بَاسَ شِلِ مَ عَننَبِ يٍهُ سَابُي رَ. <verse eid="1KI 16:12"/><verse number="13" style="v" sid="1KI 16:13"/>بَاسَ نُن عَ شَ دِ عٍلَ قَشَ عٍ شَ يُنُبِ قُقَقُيٍ نَن مَ قٍ رَ، عٍ عِسِرَيِلَ مَرِفِ عَلَتَلَ رَشْنْشِ نَشٍيٍ رَ. <verse eid="1KI 16:13"/><verse number="14" style="v" sid="1KI 16:14"/>عٍلَ شَ تَرُشُي دْنشْي بِرِن سّبّشِ عِسِرَيِلَ مَنفّيٍ شَ تَرُشُي كُي.<verse eid="1KI 16:14"/></para>
  <para style="s">سِمِرِ قِندِقٍ عِسِرَيِلَ مَنفّ رَ</para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 16:15"/>يُدَيَ مَنفّ عَسَ شَ مَنفّيَ حّ مْشْحّن نُن سٌلٌقٍرٍ ندٍ رَ، سِمِرِ نَشَ مَنفّيَ رَبَ شِ سٌلٌقٍرٍ بُن مَ تِرِ سَ. عِسِرَيِلَ حَمَ نُ نَ فِبّتْن قِلِسِتَكَيٍ فٍرٍدٍ. <verse eid="1KI 16:15"/><verse number="16" style="v" sid="1KI 16:16"/>حَمَ تٌ عَ مّ، عَ سِمِرِ بَرَ مَنفّ يَنقَ، عَ عَ قَشَ، عٍ نَشَ سْورِ شُنيِ عٌمِرِ تِ عِسِرَيِلَ مَنفّ رَ كٍرٍن نَ. <verse eid="1KI 16:16"/><verse number="17" style="v" sid="1KI 16:17"/>نَ تّمُي عٌمِرِ نُن عِسِرَيِلَ سْورِيٍ نَشَ كٍلِ فِبّتْن، عٍ سَ تِرِ سَ رَبِلِن.<verse eid="1KI 16:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1KI 16:18"/>سِمِرِ تٌ عَ تٌ، تَا بِرِن نَبِلِنشِ، عَ نَشَ سٌ مَنفّ بَنشِ كُي، عَ نَ فَن عَ يّتّ شُن مَ. <verse eid="1KI 16:18"/><verse number="19" style="v" sid="1KI 16:19"/>عَ قَشَ عَ شَ يُنُبِيٍ نَن مَ قٍ رَ، نَشٍيٍ نُ بَرَ عَلَتَلَ رَشْنْ. عَ نُ بَرَ بِرَ يٍرٌبٌوَ مِ شَ كِرَ قْشْ رَ، عَ عَ نِيَ عِسِرَيِلَ حَمَ قَن شَ يُنُبِ رَبَ.<verse eid="1KI 16:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1KI 16:20"/>سِمِرِ شَ تَرُشُي دْنشْي نُن عَ شَ يَنقَنتٍيَ سّبّشِ عِسِرَيِلَ مَنفّيٍ شَ تَرُشُي كُي.<verse eid="1KI 16:20"/></para>
  <para style="s">عٌمِرِ قِندِقٍ عِسِرَيِلَ مَنفّ رَ</para>
  <para style="p">
    <verse number="21" style="v" sid="1KI 16:21"/>نَ تّمُي عِسِرَيِلَ حَمَ سّيتِ نُ وَ مَ فِنَتِ شَ دِ تِبِنِ تِقٍ مَنفّ رَ، بٌورٍ سّيتِ نُ وَ مَ عٌمِرِ نَن شْن. <verse eid="1KI 16:21"/><verse number="22" style="v" sid="1KI 16:22"/>حَمَ سّيتِ نَشَن نُ نَ عٌمِرِ قْشْ رَ، نٍيٍ نَشَ نْ فِنَتِ شَ دِ تِبِنِ شَ حَمَ رَ. عٍ نَشَ تِبِنِ قَشَ، عٍ عٌمِرِ تِ مَنفّ رَ.<verse eid="1KI 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 16:23"/>يُدَيَ مَنفّ عَسَ شَ مَنفّيَ حّ تٌنفٌ سَشَن نُن كٍرٍن ندٍ رَ، عٌمِرِ نَشَ قِندِ عِسِرَيِلَ مَنفّ رَ، عَ بُ نَ كُي حّ قُ نُن قِرِن. عَ تٌ فّ حّ سٍننِ رَبَدٍ تِرِ سَ، <verse eid="1KI 16:23"/><verse number="24" style="v" sid="1KI 16:24"/>عَ نَشَ سَمَرِ فٍيَ سَرَ سٍمٍرِ مَ فبٍتِ كِلٌ تٌنفٌ سٌلٌقٍرٍ رَ. عَ نَشَ تَا تِ نَا قَرِ، عَ نَ تَا شِلِ سَ سَمَرِ، بَرِ مَ نَ فٍيَ كَنيِ نُ شِلِ نّ سٍمٍرِ.<verse eid="1KI 16:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 16:25"/>عٌمِرِ نُ قٍ حَاشِيٍ رَبَمَ، نَشٍيٍ مُ رَقَن عَلَتَلَ مَ. عَ شَ قٍ حَاشِيٍ نُ دَنفِ عِسِرَيِلَ مَنفّ سِنفٍيٍ فبٍيٍ رَ. <verse eid="1KI 16:25"/><verse number="26" style="v" sid="1KI 16:26"/>عَ نٍبَتِ شَ دِ يٍرٌبٌوَ مِ قْشِ بِرِن نَبَ نّ، عَ عَ نِيَ عِسِرَيِلَ حَمَ قَن شَ عٍ مَرِفِ عَلَتَلَ رَشْنْ عٍ شَ قٍ قُقَقُيٍ رَ.<verse eid="1KI 16:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1KI 16:27"/>عٌمِرِ شَ تَرُشُي، نُن عَ شَ فٍرٍ كِ قَنيِ، نَ بِرِن سّبّشِ عِسِرَيِلَ مَنفّيٍ شَ تَرُشُي كُي. <verse eid="1KI 16:27"/><verse number="28" style="v" sid="1KI 16:28"/>عٌمِرِ نَشَ لَاشِرَ، عَ رَفَتَ عَ بٍنبَيٍ سّيتِ مَ سَمَرِ. عَ شَ دِ عَكَبُ نَشَ تِ مَنفّ رَ عَ حْشْي رَ.<verse eid="1KI 16:28"/></para>
  <para style="s">عَكَبُ قِندِقٍ عِسِرَيِلَ مَنفّ رَ</para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 16:29"/>يُدَيَ مَنفّ عَسَ شَ مَنفّيَ حّ تٌنفٌ سَشَن نُن سٌلٌمَسَشَن ندٍ رَ، عٌمِرِ شَ دِ نَشَ قِندِ عِسِرَيِلَ مَنفّ رَ. عَ بُ نّ مَنفّيَ كُي عِسِرَيِلَ شُن مَ سَمَرِ حّ مْشْحّن نُن قِرِن. <verse eid="1KI 16:29"/><verse number="30" style="v" sid="1KI 16:30"/>عَكَبُ نَشَ قٍ حَاشِيٍ رَبَ، نَشٍيٍ مُ رَقَن عَلَتَلَ مَ، دَنفِ مَنفّ سِنفٍيٍ رَ. <verse eid="1KI 16:30"/><verse number="31" style="v" sid="1KI 16:31"/>بَقٍ نٍبَتِ شَ دِ يٍرٌبٌوَ مِ شَ يُنُبِ رَ، عَ نَشَ سِدْن مَنفّ عٍتِبَالِ شَ دِ يٍسَبٍلَ قَن تٌنفٌ فِنّ رَ، عَ قَ نَ شَ كُيٍ بَلِ بَتُ، عَ عَ شِنبِ سِن نَ بُن مَ. <verse eid="1KI 16:31"/><verse number="32" style="v" sid="1KI 16:32"/>عَ نَشَ سّرّشّبَدٍ يَءِلَن بَلِ كُيٍ بّ بَلِ شَ بَنشِ كُي، نَشَن نُ تِشِ سَمَرِ. <verse eid="1KI 16:32"/><verse number="33" style="v" sid="1KI 16:33"/>عَكَبُ نَشَ عَسٍرِ وُرِ مَسٌلِشِيٍ قَن يَءِلَن، نَشٍيٍ نُ شِلِ عَسٍرَ. عَكَبُ نَشَ عَلَتَلَ رَشْنْ نَ قٍ مْولِيٍ رَ، دَنفِقٍ عِسِرَيِلَ مَنفّ سِنفٍيٍ رَ.<verse eid="1KI 16:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="1KI 16:34"/>عَ شَ وَشَتِ، شِيٍلِ بٍتٍلِكَ نَشَ فبِلٍن يٍرِكٌ تَا تِ رَ. عَ نَا تِ قْلْ عَ شَ دِ سِنفٍ عَبِرَ مِ سَرٍ نَن نَ، عَ وَلِ رَحْن نَادّيٍ تِقٍ نَن مَ عَ شَ دِ سٍفُبُ سَرٍ رَ، عَلْ عَلَتَلَ نُ بَرَ عَ مَسٍن كِ نَشّ نُنُ شَ دِ عَننَبِ يٌسُوٍ سَابُي رَ.<verse eid="1KI 16:34"/></para>
  <chapter eid="1KI 16"/>
  <chapter number="17" style="c" sid="1KI 17"/>
  <para style="s">عَننَبِ عٍلِيَ</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 17:1"/>عٍلِيَ تِسِبٍكَ، نَشَن قِندِ فَلَدِ بْشِ مِشِ ندٍ رَ نَشَ عَ قَلَ مَنفّ عَكَبُ بّ، «ﭑ شَ عَ قَلَ عِ بّ عِسِرَيِلَ مَرِفِ عَلَتَلَ شِلِ رَ، ﭑ نَشَن نَبَتُمَ، تٌوقَرٍ تُنّ نُن شِنِ يٌ مُ قَمَ، قٌ ﭑ عَلَ مَشَندِ.» <verse eid="1KI 17:1"/><verse number="2" style="v" sid="1KI 17:2"/>عَلَتَلَ يِ نَن مَسٍن عَننَبِ عٍلِيَ بّ، <verse eid="1KI 17:2"/><verse number="3" style="v" sid="1KI 17:3"/>عَ نَشّ، «كٍلِ بٍ، عِ شَ سِفَ سٌفٍتٍدٍ بِرِ رَ، عِ سَ عِ نْشُن كٍرِتِ شُرٍ يِرٍ. <verse eid="1KI 17:3"/><verse number="4" style="v" sid="1KI 17:4"/>عِ شُرٍ يٍ نَن مِنمَ، ﭑ دٌنسٍ رَ سَنبَمَ نّ عِ مَ شَشَيٍ سَابُي رَ.»<verse eid="1KI 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 17:5"/>عَ نَشَ سِفَ، عَ عَ رَبَ عَلْ عَلَتَلَ عَ قَلَ عَ بّ كِ نَشّ، عَ سَ سَبَتِ كٍرِتِ شُرٍ يِرٍ يُرُدّن سٌفٍتٍدٍ بِرِ. <verse eid="1KI 17:5"/><verse number="6" style="v" sid="1KI 17:6"/>شَشَيٍ نُ قَمَ تَامِ نُن سُبٍ رَ عَ شْن مَ فّيسّفّ نُن نُنمَرٍ. عَ نُ شُرٍ يٍ نَن مِنمَ. <verse eid="1KI 17:6"/><verse number="7" style="v" sid="1KI 17:7"/>كْنْ تّمُي ندٍ تٌ دَنفِ، نَ شُرٍ نَشَ شْرِ، بَرِ مَ تُنّ مُ نُ قَمَ نَ بْشِ مَ نَ وَشَتِ.<verse eid="1KI 17:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 17:8"/>نَ تّمُي عَلَتَلَ نَشَ عَ مَسٍن عَ بّ، عَ نَشّ، <verse eid="1KI 17:8"/><verse number="9" style="v" sid="1KI 17:9"/>«كٍلِ، عِ شَ سِفَ سَرٍثٍتَ نَشَن نَ سِدْن بْشِ مَ. عِ شَ لُ نَا. ﭑ بَرَ يَامَرِ قِ كَاحّ فِنّ ندٍ مَ، عَ شَ عِ بَلٌ.» <verse eid="1KI 17:9"/><verse number="10" style="v" sid="1KI 17:10"/>عَ نَشَ كٍلِ، عَ سِفَ سَرٍثٍتَ. عَ تٌ سٌ نَ تَا كُي، عَ نَشَ كَاحّ فِنّ ندٍ تٌ، عَ يٍفٍ مَتٌنفٌقٍ. عَ نَشَ نَ فِنّ شِلِ، عَ عَ قَلَ عَ بّ، «يَندِ، ﭑ كِ يٍ رَ ﭑ شَ عَ مِن.» <verse eid="1KI 17:10"/><verse number="11" style="v" sid="1KI 17:11"/>فِنّ تٌ نُ سِفَقٍ يٍ قْشْ رَ عَ بّ، عَ مَن نَشَ عَ شِلِ، عَ عَ قَلَ عَ بّ، «يَندِ، عِ شَ قَ تَامِ شُنتُنيِ قَن نَ ﭑ بّ.»<verse eid="1KI 17:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1KI 17:12"/>فِنّ نَشَ عَ يَابِ، «ﭑ شَ عَ قَلَ عِ بّ عِ مَرِفِ عَلَتَلَ شِلِ رَ، تَامِ يٌ مُ نَ ﭑ يِ رَ، قٌ قَرِن ثْوتِ يَ كٍرٍن، عَ نُن تُرٍ دٌندٌرٌنتِ كُندِ كُي. ﭑ نَ يٍفٍ دِ مَتٌنفٌقٍ نَ نَن مَ، ﭑ شَ سَ نَ يَءِلَن ﭑ تَن نُن ﭑ مَ دِ بّ. مُشُ نَ فّ نَ دٌندٍ، مُشُ قَمَ قَشَدٍ نّ.»<verse eid="1KI 17:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 17:13"/>عٍلِيَ نَشَ عَ قَلَ عَ بّ، «هَلِ عِ مُ فَاشُ، سَ عَ رَبَ عَلْ ﭑ عَ قَلَشِ عِ بّ كِ نَشّ. كْنْ عِ نَشَن نَبَمَ، عِ شَ ﭑ مَ تَامِ نَن سِنفٍ يَءِلَن، عِ قَ عَ رَ. نَ دَنفِ شَنبِ، عِ شَ عِ فبٍ نُن عِ شَ دِ فبٍ يَءِلَن. <verse eid="1KI 17:13"/><verse number="14" style="v" sid="1KI 17:14"/>عِسِرَيِلَ مَرِفِ عَلَتَلَ عَ مَسٍن نّ، ‹قَرِن مُ حْنمَ ثْوتِ كُي، تُرٍ مُ حْنمَ كُندِ كُي، بٍينُن عَلَتَلَ تُنّ رَقَمَ بْشِ مَ تّمُي نَشّ.›»<verse eid="1KI 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 17:15"/>نَ كُي فِنّ نَشَ سِفَ، عَ عَ رَبَ عَلْ عَلَتَلَ عَ يَمَرِشِ كِ نَشّ عَننَبِ عٍلِيَ سَابُي رَ. نَ وَشَتِ بُن مَ بَلٌي نُ نَ عَ تَن، عَ شَ دِ، نُن عَننَبِ عٍلِيَ يِ. <verse eid="1KI 17:15"/><verse number="16" style="v" sid="1KI 17:16"/>قَرِن مُ نُ حْنمَ ثْوتِ كُي، تُرٍ مُ نُ حْنمَ كُندِ كُي عَلْ عَلَتَلَ عَ مَسٍن كِ نَشّ عَننَبِ عٍلِيَ سَابُي رَ.<verse eid="1KI 17:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1KI 17:17"/>نَ قٍيٍ تٌ دَنفِ، نَ كَاحّ فِنّ شَ دِ نَشَ قُرَ. نَ قُرٍ سّنبّ نَشَ فبٌ، هَن عَ حّنفِ نَشَ حْن عَ قَتٍ عِ. <verse eid="1KI 17:17"/><verse number="18" style="v" sid="1KI 17:18"/>فِنّ نَشَ عَ قَلَ عَننَبِ عٍلِيَ بّ، «مُنسٍ نَ وٌن تَفِ، عِ تَن عَلَ شَ مِشِ؟ عِ قَشِ نّ ﭑ شْنيِ عِ شَ قَ ﭑ نَتُ ﭑ مَ يُنُبِيٍ رَ، عِ مَن شَ ﭑ مَ دِ قَشَ؟» <verse eid="1KI 17:18"/><verse number="19" style="v" sid="1KI 17:19"/>عٍلِيَ نَشَ عَ يَابِ، «عِ شَ دِ سٌ ﭑ يِ رَ.» عَ نَشَ دِ مّدِ تٌنفٌ عَ نفَ يِ رَ، عَ عَ شَنِن عَ شَ كٌنكٌي كُي نَشَن نُ نَ بَنشِ كُي كٌورٍ كْن نَ. عَ تٌ عَ سَ سَدٍ مَ، <verse eid="1KI 17:19"/><verse number="20" style="v" sid="1KI 17:20"/>عَ نَشَ عَلَتَلَ مَشَندِ عَ بّ، عَ نَشّ، «ﭑ مَرِفِ عَلَتَلَ، عِ وَ مَ ﭑ يَتِفِ كَاحّ فِنّ تْورْقٍ يِ كِ نّ، عَ شَ دِ شَ قَشَ؟» <verse eid="1KI 17:20"/><verse number="21" style="v" sid="1KI 17:21"/>عَ نَشَ عَ يّتّ عِتَلَ دِ مّدِ قَتٍ قَرِ سَنيَ سَشَن، عَ عَلَتَلَ مَشَندِ مَ عَ قَلَقٍ رَ، «ﭑ مَرِفِ عَلَتَلَ، ﭑ بَرَ عِ مَشَندِ، عِ شَ يِ دِ حّنفِ رَفبِلٍن عَ قَتٍ عِ.» <verse eid="1KI 17:21"/><verse number="22" style="v" sid="1KI 17:22"/>عَلَتَلَ نَشَ عَننَبِ عٍلِيَ شَ مَشَندِ سُشُ، دِ مّدِ حّنفِ نَشَ فبِلٍن عَ قَتٍ عِ. <verse eid="1KI 17:22"/><verse number="23" style="v" sid="1KI 17:23"/>عٍلِيَ نَشَ عَ تٌنفٌ، عَ فٌرٌ عَ رَ عَ نفَ شْن، عَ عَ قَلَ عَ بّ، «عِ شَ دِ مَتٌ، عَ كِسِشِ.» <verse eid="1KI 17:23"/><verse number="24" style="v" sid="1KI 17:24"/>فِنّ نَشَ عَ قَلَ عٍلِيَ بّ، «يَكْسِ ﭑ بَرَ عَ كٌلٌن عَ عَلَ شَ مِشِ نَن عِ رَ، نَشَن عَلَتَلَ شَ مَسٍنيِ تِنشِنشِ مَسٍنمَ.»<verse eid="1KI 17:24"/></para>
  <chapter eid="1KI 17"/>
  <chapter number="18" style="c" sid="1KI 18"/>
  <para style="s">عَننَبِ عٍلِيَ نُن مَنفّ عَكَبُ</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 18:1"/>تّمُي شْن تٌ كُيَ، عَلَتَلَ نَشَ عَ مَسٍن عَننَبِ عٍلِيَ بّ عَ حّ سَشَن ندٍ رَ، عَ نَشّ، «سِفَ عَكَبُ يِرٍ، ﭑ تُنّ رَقَمَ نّ بْشِ مَ قَ.» <verse eid="1KI 18:1"/><verse number="2" style="v" sid="1KI 18:2"/>عٍلِيَ نَشَ سِفَ عَكَبُ يِرٍ. <verse eid="1KI 18:2"/><verse number="3" style="v" sid="1KI 18:3"/>كَامّ نُ بَرَ سّنبّ سْتْ سَمَرِ بْشِ مَ. عَكَبُ نَشَ عَبَدِيَسِ شِلِ، نَشَن نُ وَلِمَ مَنفّ بَنشِ كُي. عَ نُ فَاشُمَ عَلَتَلَ يَ رَ كِ قَنيِ رَ. <verse eid="1KI 18:3"/><verse number="4" style="v" sid="1KI 18:4"/>يٍسَبٍلَ نُ عَلَتَلَ شَ نَمِحْنمّيٍ قَشَمَ تّمُي نَشّ، عَبَدِيَسِ نَمِحْنمّ كّمّ تٌنفٌ نّ، عَ سَ عٍ نْشُن مِشِ تٌنفٌ سُولِ سُولِ مَ قْنمّ قِرِن كُي، عَ عٍ بَلٌ يٍ نُن تَامِ رَ.<verse eid="1KI 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 18:5"/>عَكَبُ نَشَ عَ قَلَ عَبَدِيَسِ بّ، عَ نَشّ، «عِ شَ بْشِ بِرِن عِسَ مّرّ قٍندٍ وٌن مَ سٌييٍ نُن وٌن مَ سٌقَلٍيٍ نْمَ حٌوفٍ سْتْدٍ دّننَشّ، عَلَكٌ عٍ نَشَ قَشَ.» <verse eid="1KI 18:5"/><verse number="6" style="v" sid="1KI 18:6"/>عَكَبُ نُن عَبَدِيَسِ نَشَ بْشِ عِتَشُن عٍ بٌرٍ مَ، عٍ شَ عَ عِسَ. عَكَبُ نَشَ سِفَ كِرَ ندٍ شْن، عَبَدِيَسِ نَشَ سِفَ كِرَ فبّتّ شْن.<verse eid="1KI 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 18:7"/>عَبَدِيَسِ نَشَ نَرَلَن عَننَبِ عٍلِيَ رَ كِرَ شْن. عَبَدِيَسِ تٌ عَ تٌ، عَ نَشَ عَ قٍلٍن عَ بُن مَ، عَ عَ قَلَ عَ بّ، «ﭑ مَرِفِ عٍلِيَ، عِ تَن يَتِ نَن عَ رَ؟» <verse eid="1KI 18:7"/><verse number="8" style="v" sid="1KI 18:8"/>عٍلِيَ نَشَ عَ يَابِ، «عِيٌ، ﭑ تَن نَن عَ رَ. سَ عَ قَلَ عِ شَ مَنفّ بّ، عِ بَرَ عَننَبِ عٍلِيَ تٌ.» <verse eid="1KI 18:8"/><verse number="9" style="v" sid="1KI 18:9"/>عَبَدِيَسِ نَشَ عَ قَلَ، «ﭑ هَاكّ مُندُن نَبَشِ عِ رَ نَشَن عَ نِيَمَ عِ شَ يِ مْولِ رَبَ ﭑ نَ؟ يِ قِندِ مَ قَشّ نَن نَ ﭑ بّ عَكَبُ مَبِرِ. <verse eid="1KI 18:9"/><verse number="10" style="v" sid="1KI 18:10"/>ﭑ شَ عَ قَلَ عِ بّ عِ مَرِفِ عَلَتَلَ شِلِ رَ، حَمَنّ نُن بْشِ يٌ مُ نَ، ﭑ مَ مَنفّ مُ عِ قٍنشِ دّننَشّ. مّننِكَيٍ نَ عَ قَلَ عِ مُ نَ، عَكَبُ عٍ رَكَلِمَ شَ عٍ مُ عِ تٌشِ. <verse eid="1KI 18:10"/><verse number="11" style="v" sid="1KI 18:11"/>يَكْسِ عِ نَشّ، ‹سَ عَ قَلَ مَنفّ بّ عِ بَرَ عَننَبِ عٍلِيَ تٌ.› <verse eid="1KI 18:11"/><verse number="12" style="v" sid="1KI 18:12"/>كْنْ ﭑ نَ كٍلِ عِ شُن مَ يَ، عَلَتَلَ شَشِلِ سّنِيّنشِ قَمَ عِ شَنِندٍ يِرٍ ندٍ. نَ كُي، ﭑ نَ فّ شّيرَ عِبَدٍ عَكَبُ بّ، عَ لِمَ مُشُ مُ عِ تٌمَ بٍ سْنْن، عَ قَ ﭑ قَشَ نَ مَ. ﭑ تَن بَرَ فَاشُ عَلَتَلَ يَ رَ كَبِ ﭑ دِ مّدِ تّمُي. <verse eid="1KI 18:12"/><verse number="13" style="v" sid="1KI 18:13"/>ﭑ مَرِفِ، عٍ مُ عَ قَلَشِ عِ بّ، ﭑ نَشَن نَبَ يٍسَبٍلَ نُ عَلَتَلَ شَ نَمِحْنمّيٍ قَشَمَ تّمُي نَشّ؟ ﭑ عَلَتَلَ شَ نَمِحْنمّ كّمّ نَن نْشُن قْنمّ كُي تٌنفٌ سُولِ سُولِ مَ. ﭑ نُ قَ عٍ بَلٌ تَامِ نُن يٍ رَ. <verse eid="1KI 18:13"/><verse number="14" style="v" sid="1KI 18:14"/>كْنْ يَكْسِ، شَ عِ ﭑ شّي ﭑ مَ مَنفّ شْن مَ، ﭑ شَ عَ قَلَ عَ بّ ﭑ بَرَ عَننَبِ عٍلِيَ تٌ، عَ ﭑ قَشَمَ نّ!» <verse eid="1KI 18:14"/><verse number="15" style="v" sid="1KI 18:15"/>عَننَبِ عٍلِيَ نَشَ عَ يَابِ، «ﭑ بَرَ ﭑ كَلِ ﭑ مَرِفِ عَلَتَلَ رَ، تٌ ﭑ نَن ﭑ يّتّ مَسٍنمَ نّ عَكَبُ بّ.»<verse eid="1KI 18:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1KI 18:16"/>عَبَدِيَسِ نَشَ سِفَ عَكَبُ يِرٍ، عَ قَ دّنتّفّ سَ عَ بّ. عَكَبُ نَشَ سِفَ عٍلِيَ قْشْ رَ. <verse eid="1KI 18:16"/><verse number="17" style="v" sid="1KI 18:17"/>عَ تٌ سَ عٍلِيَ تٌ، عَكَبُ نَشَ عَ قَلَ عَ بّ، «عِ تَن نَن عِسِرَيِلَ يَ عِسٌشِ يِ كِ؟» <verse eid="1KI 18:17"/><verse number="18" style="v" sid="1KI 18:18"/>عَننَبِ عٍلِيَ نَشَ عَ يَابِ، «ﭑ تَن شَ مُ عِسِرَيِلَ يَ عِسٌشِ. عِ تَن نُن عِ بَبَ بْنسْي نَن عِسِرَيِلَ يَ عِسٌشِ، بَرِ مَ وٌ بَرَ عَلَتَلَ شَ يَامَرِيٍ رَبٌلٌ، عِ بِرَ بَلِ كُيٍ قْشْ رَ. <verse eid="1KI 18:18"/><verse number="19" style="v" sid="1KI 18:19"/>يَكْسِ، عِ شَ عِسِرَيِلَ حَمَ بِرِن مَلَن كَرٍ مٍلٍ فٍيَ مَ، عَ نُن وٌ شَ بَلِ كُيٍ شَ نَمِحْنمّ كّمّ نَانِ تٌنفٌ سُولِيٍ، عَ نُن عَسٍرَ كُيٍ شَ نَمِحْنمّ كّمّ نَانِيٍ، عِ شَ فِنّ يٍسَبٍلَ نَشٍيٍ رَبَلٌمَ.»<verse eid="1KI 18:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1KI 18:20"/>عَكَبُ نَشَ مِشِيٍ شّي عِسِرَيِلَكَيٍ شِلِدٍ. عَ نَشَ نَ نَمِحْنمّيٍ مَلَن كَرٍ مٍلٍ فٍيَ قَرِ. <verse eid="1KI 18:20"/><verse number="21" style="v" sid="1KI 18:21"/>نَ تّمُي عٍلِيَ نَشَ عَ مَسٌ حَمَ بِرِن نَ، عَ قَ يِ مَسٍنيِ تِ عٍ بّ، «وٌ تَن لُمَ قِلَنكَقُيحَ كُي هَن مُن تّمُي؟ شَ عَلَتَلَ نَن عَلَ رَ، وٌ بِرَ عَ قْشْ رَ. شَ بَلِ نَن عَلَ رَ، وٌ بِرَ عَ تَن بَلِ قْشْ رَ.» حَمَ مُ عَ يَابِ.<verse eid="1KI 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 18:22"/>عَننَبِ عٍلِيَ مَن نَشَ عَ قَلَ عٍ بّ، «ﭑ كٍرٍن نَن بٍ عَلَتَلَ شَ نَمِحْنمّ رَ. بَلِ شَ نَمِحْنمّيٍ مِشِ كّمّ نَانِ تٌنفٌ سُولِ نَ بٍ. <verse eid="1KI 18:22"/><verse number="23" style="v" sid="1KI 18:23"/>وٌ شَ تُورَ قِرِن سٌ مُشُ يِ رَ. بَلِ نَمِحْنمّيٍ شَ عٍ فبٍ سُفَندِ، عٍ شَ عَ عِبٌلٌن، عٍ عَ سَ يٍفٍ قَرِ، كْنْ تّ مُ دْشْمَ عَ رَ. ﭑ تَن قَن شَ تُورَ بٌورٍ عِبٌلٌن، ﭑ عَ سَ يٍفٍ فبّتّ قَرِ، ﭑ قَن مُ تّ دْشْمَ عَ رَ. <verse eid="1KI 18:23"/><verse number="24" style="v" sid="1KI 18:24"/>مُشُ نَ فّ نَ رَبَدٍ، بَلِ نَمِحْنمّيٍ شَ وٌ مَرِفِ عَلَ مَشَندِ. ﭑ تَن قَن شَ عَلَتَلَ مَشَندِ. عَلَ نَشَن نَ تّ رَفٌرٌ سّرّشّ مَ، نَ نَن قِندِ مَ حَمَ بِرِن مَرِفِ عَلَ رَ.» حَمَ بِرِن نَشَ تِن نَ قٍ رَ.<verse eid="1KI 18:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 18:25"/>عٍلِيَ نَشَ عَ قَلَ بَلِ شَ نَمِحْنمّيٍ بّ، «وٌ تُورَ كٍرٍن سُفَندِ، وٌ سِنفٍ شَ عَ عِبٌلٌن، بَرِ مَ وٌ تَن نَن فبٌ. وٌ وٌ مَرِفِ عَلَ مَشَندِ، كْنْ وٌ نَشَ تّ سَ.» <verse eid="1KI 18:25"/><verse number="26" style="v" sid="1KI 18:26"/>عٍ نَشَ تُورَ كٍرٍن تٌنفٌ، عٍ عَ عِبٌلٌن، عٍ عَ سَ يٍفٍ قَرِ، عٍ قَ بَلِ مَشَندِ قْلْ. كٍلِ فّيسّفّ مَ، هَن يَنيِ تَفِ، عٍ عَ قَلَمَ، «بَلِ، مُشُ يَابِ.» كْنْ يَابِ يٌ مُ قَ، شُي ندٍ يٌ مُ مّ. عٍ نَشَ تُفَن تُفَن قْلْ عٍ شَ سّرّشّبَدٍ يَ عِ. <verse eid="1KI 18:26"/><verse number="27" style="v" sid="1KI 18:27"/>يَنيِ تَفِ تٌ عَ لِ، عَننَبِ عٍلِيَ نَشَ يٌ عٍ مَ، عَ قَلَقٍ رَ، «وٌ وٌ شُي عِتٍ دٍ، بَرِ مَ عَ تٌ قِندِشِ عَلَ رَ، قٍيٍ وُيَ عَ يِ. تّمُندٍ عَ نَ بِيَاسِ كُي، شَ نَ مُ عَ رَ عَ نَ شِقٍ. وٌ شَ عَ رَشُنُ.»<verse eid="1KI 18:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1KI 18:28"/>عٍ مَن نَشَ عٍ شُي عِتٍ سّنبّ رَ. عٍ نَشَ عٍ قَتٍ مَشَبَ سَنتِدّفّمَيٍ نُن تَنبّيٍ رَ، هَن عٍ وُلِ مِنِ. <verse eid="1KI 18:28"/><verse number="29" style="v" sid="1KI 18:29"/>يَنيِ تٌ دَنفِ، عٍ نَشَ بَلِ كُيٍ مَشَندِ عَ نَمِحْنمّ دَاشِ هَن نُنمَرٍ سّرّشّ بَ تّمُي. كْنْ يَابِ يٌ مُ قَ، شُي ندٍ يٌ مُ مّ، تْنشُمَ ندٍ يٌ مُ تٌ.<verse eid="1KI 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="1KI 18:30"/>نَ تّمُي عَننَبِ عٍلِيَ نَشَ عَ قَلَ حَمَ بّ، عَ نَشّ، «وٌ وٌ مَسٌ ﭑ نَ.» حَمَ تٌ نَ رَبَ، عٍلِيَ نَشَ عَلَتَلَ شَ سّرّشّبَدٍ يَءِلَن، نَشَن نُ بَرَ كَنَ مّننِ تّمُي دَنفِشِ. <verse eid="1KI 18:30"/><verse number="31" style="v" sid="1KI 18:31"/>عٍلِيَ نَشَ فّمّ قُ نُن قِرِن تٌنفٌ، نَشَن لَنشِ يَشُبَ شَ دِيٍ كْنتِ مَ، عَلَتَلَ عَ مَسٍن نَشَن بّ، «عِ شِلِ قَلَمَ نّ عِسِرَيِلَ.» <verse eid="1KI 18:31"/><verse number="32" style="v" sid="1KI 18:32"/>عَ نَشَ سّرّشّبَدٍ يَءِلَن نَ فّمّ قُ نُن قِرِنيِ رَ عَلَتَلَ شِلِ رَ. عَ نَشَ قٌلٍ فٍ نَ سّرّشّبَدٍ رَبِلِنيِ، يٍ كٌنبٌ يَ نَانِ نْمَ نَشَن نَقٍدٍ. <verse eid="1KI 18:32"/><verse number="33" style="v" sid="1KI 18:33"/>عَ نَشَ يٍفٍ سَ نَ قَرِ، عَ تُورَ عِبٌلٌن، عَ نَ سَ نَ يٍفٍ قَرِ.<verse eid="1KI 18:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="1KI 18:34"/>عَ تٌ فّ نَ رَ، عَ نَشَ مِشِيٍ يَمَرِ، «وٌ يِ قّحّ نَانِ رَقٍ يٍ رَ، وٌ عَ عِقِلِ يِ يٍفٍ نُن يِ سّرّشّ مَ.» عٍ تٌ فّ نَ رَبَدٍ، عَ مَن نَشَ عَ قَلَ عٍ بّ، «وٌ مَن شَ عَ رَبَ.» عٍ تٌ عَ رَبَ عَ قِرِن ندٍ، عٍلِيَ مَن نَشَ عَ قَلَ، «وٌ مَن شَ يٍ سَ.» عٍ نَشَ عَ رَبَ عَ سَشَن ندٍ. <verse eid="1KI 18:34"/><verse number="35" style="v" sid="1KI 18:35"/>يٍ نُ سْلِ سّرّشّبَدٍ رَ، قٌلٍ قَ رَقٍ يٍ رَ.<verse eid="1KI 18:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="1KI 18:36"/>نُنمَرٍ سّرّشّ بَ تّمُي، عَننَبِ عٍلِيَ نَشَ عَ مَسٌ سّرّشّبَدٍ رَ، عَ عَ قَلَ، «عِبُرَهِمَ، عِسِيَفَ، نُن عِسِرَيِلَ مَرِفِ عَلَتَلَ، بِرِن شَ عَ كٌلٌن تٌ عَ عِ تَن نَن نَ عَلَ رَ عِسِرَيِلَ. بِرِن شَ عَ كٌلٌن عَ ﭑ تَن نَن نَ عِ شَ كٌنيِ رَ، نَشَن يِ قٍ بِرِن نَبَشِ عِ شُي مَ! <verse eid="1KI 18:36"/><verse number="37" style="v" sid="1KI 18:37"/>عَلَتَلَ، عِ شَ ﭑ مَ مَشَندِ سُشُ. يَندِ، عِ شَ عَ سُشُ، عَلَكٌ يِ حَمَ شَ عَ كٌلٌن عَ عِ تَن عَلَتَلَ نَن نَ عَلَ رَ، نَشَن نْمَ عٍ بْحّ رَفبِلٍندٍ عِ مَ.»<verse eid="1KI 18:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="1KI 18:38"/>نَ كُي عَلَتَلَ نَشَ تّ رَفٌرٌ، عَ سّرّشّ فَن، عَ يٍفٍ فَن، هَلِ فّمّيٍ نُن بْشِ فَن نّ. يٍ نَشَن نُ قٌلٍ كُي، عَ بِرِن نَشَ شَرَ قٍوٌ. <verse eid="1KI 18:38"/><verse number="39" style="v" sid="1KI 18:39"/>حَمَ تٌ نَ تٌ، عٍ نَشَ عٍ يَتَفِ رَقٍلٍن بْشِ مَ، عٍ قَ عَ قَلَ، «عَلَتَلَ نَن عَلَ رَ! عَلَتَلَ نَن عَلَ رَ!» <verse eid="1KI 18:39"/><verse number="40" style="v" sid="1KI 18:40"/>عَننَبِ عٍلِيَ نَشَ عَ قَلَ عٍ بّ، «وٌ بَلِ شَ نَمِحْنمّيٍ سُشُ. عَ كٍرٍن نَشَ عَ فِ.» حَمَ نَشَ عٍ سُشُ، عٍلِيَ نَشَ عٍ شَنِن كِسٌن شُرٍ يِرٍ، عَ عٍ بِرِن كْن نَشَبَ.<verse eid="1KI 18:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="1KI 18:41"/>نَ تّمُي عٍلِيَ نَشَ عَ قَلَ عَكَبُ بّ، «سِفَ عِ شْنيِ. عِ شَ عِ دّفٍ، عِ شَ عِ مِن، بَرِ مَ نَ شُي عِ نَشَن مّشِ يِ كِ نَ قَمَ تُنّ نَن نَ.» <verse eid="1KI 18:41"/><verse number="42" style="v" sid="1KI 18:42"/>عَكَبُ نَشَ تٍ عَ شْنيِ عَ دّفٍدٍ نُن عَ مِندٍ، كْنْ عَننَبِ عٍلِيَ تَن نَشَ تٍ كَرٍ مٍلٍ فٍيَ قَرِ، عَ قَ عَ قٍلٍن بْشِ مَ، عَ يَتَفِ قَ لُ عَ سَنيِيٍ تَفِ. <verse eid="1KI 18:42"/><verse number="43" style="v" sid="1KI 18:43"/>عَ نَشَ عَ قَلَ عَ شَ كٌنيِ بّ، «تٍ يِرٍ عِتٍشِ، عِ شَ بَا مَبِرِ مَتٌ.» كٌنيِ تٌ تٍ نَا، عَ نَشَ بَا مَتٌ، عَ مُ سٍسٍ فبّتّ تٌ. عٍلِيَ نَشَ عَ رَفبِلٍن نَ يِرٍ عِتٍشِ سَنيَ سٌلٌقٍرٍ بَا مَتٌدٍ. <verse eid="1KI 18:43"/><verse number="44" style="v" sid="1KI 18:44"/>عَ سَنيَ سٌلٌقٍرٍ ندٍ، كٌنيِ نَشَ عَ قَلَ، «نُشُي دِ نَن تٍقٍ بَا شُن مَ. عَ نُن بّلّشّ مْندّ لَن.» عٍلِيَ نَشَ عَ قَلَ عَ بّ، «سِفَ، عِ شَ سَ عَ قَلَ عَكَبُ بّ، عَ شَ بَكِ عَ شَ سْورِ رَفِسٍ كُي، عَ شَ فٌرٌ فٍيَ قَرِ مَقُرٍن مَقُرٍن عَلَكٌ عَ نَشَ بِرِ بٌورَ. تُنّ نَ قَقٍ!»<verse eid="1KI 18:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="1KI 18:45"/>نُشُييٍ نَشَ كٌورٍ بِرِن عِقْورْ، قٌيٍ نَشَ كٍلِ، تُنّ بٍلٍبٍلٍ نَشَ سِن بْشِ مَ. عَكَبُ نَشَ تٍ عَ شَ سْورِ رَفِسٍ كُي، عَ سِفَ يِسِرٍيلِ. <verse eid="1KI 18:45"/><verse number="46" style="v" sid="1KI 18:46"/>عَلَتَلَ نَشَ سّنبّ قِ عٍلِيَ مَ، عَ قَ عَ فِ عَ سَنيِ رَ، عَ دَنفِ عَكَبُ يَ رَ هَن يِسِرٍيلِ سٌدٍ دّ رَ.<verse eid="1KI 18:46"/></para>
  <chapter eid="1KI 18"/>
  <chapter number="19" style="c" sid="1KI 19"/>
  <para style="s">عَننَبِ عٍلِيَ فَاشُقٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 19:1"/>عَكَبُ نَشَ سَ دّنتّفّ سَ يٍسَبٍلَ بّ، عٍلِيَ نَشَن بِرِن نَبَشِ، عَ عَ شَ نَمِحْنمّيٍ قَشَشِ سَنتِدّفّمَ رَ كِ نَشّ. <verse eid="1KI 19:1"/><verse number="2" style="v" sid="1KI 19:2"/>يٍسَبٍلَ نَشَ شّيرَ شّي عٍلِيَ مَ، عَ عَ قَلَ عَ بّ، «شَ ﭑ لُ مُ عِ قَشَ بٍينُن تِنَ يِ وَشَتِ عَلْ عِ ﭑ مَ نَمِحْنمّيٍ قَشَ كِ نَشّ، عَلَيٍ شَ ﭑ دَنكَ.»<verse eid="1KI 19:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1KI 19:3"/>عَننَبِ عٍلِيَ تٌ نَ مّ، عَ نَشَ عَ فِ عَ شَ عَ نِي رَتَنفَ. عَ نَشَ سٌ بٍرِ سٍيبَ يُدَيَ بْشِ مَ، عَ نَشَ عَ شَ كٌنيِ لُ مّننِ. <verse eid="1KI 19:3"/><verse number="4" style="v" sid="1KI 19:4"/>عَ تَن نَشَ سِفَ فبٍنفبٍرٍنيِ مَ عَ قّيحّن كٍرٍن حّرّ رَبَ، عَ دْشْ وُرِ ندٍ بُن مَ، عَ عَلَ مَشَندِ قَشّ رَ. عَ نَشّ، «عَلَتَلَ، ﭑ مَ تْورّ بَرَ دَنفِ عَ عِ. ﭑ نِي تٌنفٌ، بَرِ مَ ﭑ مُ قِسَ ﭑ بٍنبَيٍ بّ.»<verse eid="1KI 19:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 19:5"/>نَ تّمُي عَ نَشَ عَ سَ، عَ شِ نَ وُرِ بُن مَ. مَلٍكّ ندٍ نَشَ فٌرٌ عَ مَ، عَ دِن عَ رَ، عَ عَ قَلَ عَ بّ، «كٍلِ عِ شَ عِ دّفٍ.» <verse eid="1KI 19:5"/><verse number="6" style="v" sid="1KI 19:6"/>تَامِ حِنشِ نُ نَ مّننِ فّمّ قُرٍيٍ قَرِ، عَ نُن يٍ قّحّ. عَ نَشَ عَ دّفٍ، عَ يٍ مِن، عَ مَن نَشَ عَ سَ. <verse eid="1KI 19:6"/><verse number="7" style="v" sid="1KI 19:7"/>عَلَ شَ مَلٍكّ نَشَ قَ عَ مَ عَ قِرِن ندٍ، عَ دِن عَ رَ، عَ عَ قَلَ عَ بّ، «كٍلِ عِ شَ عِ دّفٍ، بَرِ مَ بِيَاسِ شْنكُيٍ نَ عِ يَ رَ.» <verse eid="1KI 19:7"/><verse number="8" style="v" sid="1KI 19:8"/>عَ نَشَ كٍلِ، عَ عَ دّفٍ، عَ يٍ مِن. عَ سّنبّ نَشَن سْتْ نَ دٌنسٍيٍ رَ، نَ نَشَ عَ نِيَ عَ شَ نْ عَ حّرّدٍ شِ تٌنفٌ نَانِ، كْي تٌنفٌ نَانِ بُن مَ، هَن عَ عَلَ شَ شٌرٍبٍ فٍيَ لِ.<verse eid="1KI 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 19:9"/>مّننِ عَ نَشَ كْي رَدَنفِ قْنمّ ندٍ كُي. نَ تّمُي عَ نَشَ يِ مَسٍنيِ مّ؛ «عِ نَ مُنسٍ رَبَقٍ بٍ عٍلِيَ؟» <verse eid="1KI 19:9"/><verse number="10" style="v" sid="1KI 19:10"/>عَ نَشَ عَ يَابِ. «ﭑ بَرَ ﭑ يّتّ قِ عِ تَن عَلَتَلَ سّنبّمَ مَ. عِسِرَيِلَكَيٍ بَرَ عِ شَ سَاتّ رَبٌلٌ، عٍ بَرَ عِ شَ سّرّشّبَدٍيٍ كَنَ، عٍ بَرَ عِ شَ نَمِحْنمّيٍ قَشَ سَنتِدّفّمَ رَ. ﭑ كٍرٍن نَن قَ لُشِ، عٍ نَ كَتَقٍ ﭑ قَن قَشَدٍ.» <verse eid="1KI 19:10"/><verse number="11" style="v" sid="1KI 19:11"/>عَلَتَلَ نَشَ عَ مَسٍن عَ بّ، «مِنِ تَندٍ عَلَتَلَ يَ عِ، عِ كٍلِ قْنمّ كُي.» عَ تٌ مِنِ، عَلَتَلَ نَشَ دَنفِ عَ يَ عِ. قٌيٍ شُنفبٍ سّنبّمَ ندٍ نَشَ عَ شُن سَ فٍيَ مَ، عَ فّمّيٍ عِبْو مَ، عَ قَنيٍيٍ عِبُتُشُنمَ، كْنْ عَلَتَلَ مُ نُ نَ نَ قٌيٍ كُي. نَ تّمُي بْشِ قَن نَشَ سّرّن، كْنْ عَلَتَلَ مُ نُ نَ نَ بْشِ سّرّنيِ كُي. <verse eid="1KI 19:11"/><verse number="12" style="v" sid="1KI 19:12"/>نَ دَنفِ شَنبِ، تّ قَن نَشَ مِنِ، كْنْ عَلَتَلَ مُ نُ نَ نَ تّ شْورَ.</para>
  <para style="p" vid="1KI 19:12">نَ تٌ بَ عَ رَ، شُي حْشُنمّ ندٍ نَشَ مِنِ دْيِ دْيِ رَ. <verse eid="1KI 19:12"/><verse number="13" style="v" sid="1KI 19:13"/>عَننَبِ عٍلِيَ تٌ نَ مّ، عَ نَشَ عَ يَتَفِ مَكٌتٌ عَ شَ دٌنمَ رَ، عَ نَشَ مِنِ قْنمّ كُي، عَ تِ قْنمّ دّ رَ. عَ مُ بُ، شُي ندٍ نَشَ مِنِ عَ مَ، عَ نَشّ، «عِ نَ مُنسٍ رَبَقٍ بٍ عٍلِيَ؟» <verse eid="1KI 19:13"/><verse number="14" style="v" sid="1KI 19:14"/>عَ نَشَ عَ يَابِ، «ﭑ بَرَ ﭑ يّتّ قِ عِ تَن عَلَتَلَ سّنبّمَ مَ. عِسِرَيِلَكَيٍ بَرَ عِ شَ سَاتّ رَبٌلٌ، عٍ بَرَ عِ شَ سّرّشّبَدٍيٍ كَنَ، عٍ بَرَ عِ شَ نَمِحْنمّيٍ قَشَ سَنتِدّفّمَ رَ. ﭑ كٍرٍن نَن قَ لُشِ، عٍ نَ كَتَقٍ ﭑ قَن قَشَدٍ.» <verse eid="1KI 19:14"/><verse number="15" style="v" sid="1KI 19:15"/>عَلَتَلَ نَشَ عَ مَسٍن عَ بّ، «عِ شَ فبِلٍن فبٍنفبٍرٍنيِ كِرَ شْن مَ سِفَقٍ رَ دَ مَسِ. عِ نَ سٌ نَا، عِ شَ تُرٍ سّنِيّنشِ سَ شَسَيٍلِ شُنيِ عَ مَسٍنقٍ رَ، عَ شَ قِندِ عَرَ مِ مَنفّ رَ. <verse eid="1KI 19:15"/><verse number="16" style="v" sid="1KI 19:16"/>عِ شَ تُرٍ سّنِيّنشِ سَ نِمِسِ شَ دِ يٍهُ قَن مَ، عَ شَ قِندِ عِسِرَيِلَ مَنفّ رَ. نَ دَنفِ شَنبِ عِ شَ تُرٍ سَ عٍلِسٍ شُنيِ، سَقَتِ شَ دِ، عَبٍلِ مٍشٌلَكَ شَ مَمَدِ، عَ تَن شَ قِندِ نَمِحْنمّ رَ عِ حْشْي رَ. <verse eid="1KI 19:16"/><verse number="17" style="v" sid="1KI 19:17"/>نَشَن نَ تَنفَ شَسَيٍلِ شَ سَنتِدّفّمَ مَ، يٍهُ عَ قَشَمَ نّ. شَ نَشَن تَنفَ يٍهُ شَ سَنتِدّفّمَ مَ، عٍلِسٍ عَ قَشَمَ نّ. <verse eid="1KI 19:17"/><verse number="18" style="v" sid="1KI 19:18"/>كْنْ ﭑ مِشِ وُلُ سٌلٌقٍرٍ لُمَ نّ عِسِرَيِلَ، نَشٍيٍ مُ سُيِدِشِ بَلِ كُيٍ بّ، عٍ دّ مُ عَ سُنبُشِ.»<verse eid="1KI 19:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 19:19"/>عٍلِيَ نَشَ كٍلِ مّننِ، عَ سَ سَقَتِ شَ دِ عٍلِسٍ لِ، عَ نَ بْشِ بُشَقٍ. نِنفٍ مْشْحّن نُن نَانِ نَن نُ حّرّقٍ عَ يَ رَ، عَ نُ قِرِنيِ نَن نَوَلِقٍ عٍ شَنبِ رَ. عٍلِيَ نَشَ دَنفِ عَ قّ مَ، عَ نَشَ عَ شَ دٌنمَ وٌلِ عَ مَ. <verse eid="1KI 19:19"/><verse number="20" style="v" sid="1KI 19:20"/>عٍلِسٍ نَشَ عَ شَ نِنفٍيٍ رَبٌلٌ، عَ عَ فِ عٍلِيَ قْشْ رَ، عَ عَ قَلَ عَ بّ، «يَندِ، عِ شَ دِحّ ﭑ شَ سَ ﭑ حُنفُ نفَ نُن ﭑ بَبَ مَ. نَ تّمُي ﭑ بِرَ مَ نّ عِ قْشْ رَ.» عٍلِيَ نَشَ عَ قَلَ عَ بّ، «فبِلٍن عِ شَ وَلِ رَ. عِ مُنسٍ مّشِ ﭑ نَ؟» <verse eid="1KI 19:20"/><verse number="21" style="v" sid="1KI 19:21"/>عَ تٌ عَ مَكُيَ عٍلِيَ رَ، عَ نَشَ نِنفٍ قِرِن تٌنفٌ، عَ عٍ بَ سّرّشّ رَ. عَ نَشَ وُرِيٍ قِندِ يٍفٍ رَ عٍ نُ مَشِرِشِ نَشٍيٍ رَ، عَ سُبٍ حِن حَمَ بّ. نَ دَنفِ شَنبِ، عَ نَشَ بِرَ عَننَبِ عٍلِيَ قْشْ رَ، عَ قِندِ عَ شَ بَتُلَ رَ.<verse eid="1KI 19:21"/></para>
  <chapter eid="1KI 19"/>
  <chapter number="20" style="c" sid="1KI 20"/>
  <para style="s">عَرَ مِ مَنفّ سَمَرِ تَا فٍرٍقٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 20:1"/>عَرَ مِ مَنفّ بٍن هَدَدَ نَشَ عَ شَ سْورِيٍ بِرِن مَلَن. مَنفّ تٌنفٌ سَشَن نُن قِرِن نَن نُ عٍ يَ مَ، سٌي نُن سْورِ رَفِسٍيٍ نُ نَ عٍ يِ رَ. عٍ نَشَ سَمَرِ رَبِلِن، عٍ قَ فٍرٍ تِ عٍ بّ.<verse eid="1KI 20:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1KI 20:2"/>نَ كُي بٍن هَدَدَ نَشَ شّيرَيٍ شّي عِسِرَيِلَ مَنفّ عَكَبُ شْن. <verse eid="1KI 20:2"/><verse number="3" style="v" sid="1KI 20:3"/>عَ نَشَ عَ قَلَ عَ بّ، «عَ لَنمَ عِ شَ عِ شَ فبٍتِ، عِ شَ شّيمَ، عِ شَ فِنّ تٌقَنيِيٍ، نُن عِ شَ دِيٍ بِرِن قِندِ ﭑ فبٍ رَ.» <verse eid="1KI 20:3"/><verse number="4" style="v" sid="1KI 20:4"/>عِسِرَيِلَ مَنفّ نَشَ عَ يَابِ، «مَنفّ، ﭑ بَرَ قِندِ عِ شَ كٌنيِ رَ، ﭑ بَرَ ﭑ هَرِفٍ بِرِن قِ عِ مَ.»<verse eid="1KI 20:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 20:5"/>نَ دَنفِ شَنبِ مَنفّ نَشَ شّيرَ فبّتّيٍ شّي عَ قَلَقٍ رَ، «مَنفّ بٍن هَدَدَ نَشّ، ‹عَ لَنمَ عِ شَ عِ شَ فبٍتِ، عِ شَ شّيمَ، عِ شَ فِنّ تٌقَنيِيٍ، نُن عِ شَ دِيٍ بِرِن قِندِ ﭑ فبٍ رَ. <verse eid="1KI 20:5"/><verse number="6" style="v" sid="1KI 20:6"/>تِنَ يِ وَشَتِ، ﭑ مِشِيٍ شّيمَ نّ عِ شْنيِ، عٍ شَ سَ عِ شَ بَنشِ كُي مَتٌ، عَ نُن عِ شَ مِشِيٍ شَ بَنشِيٍ، عٍ شَ سٍ بِرِن تٌنفٌ نَشَن تِدٍ فبٌ عِ بّ.›»<verse eid="1KI 20:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 20:7"/>عِسِرَيِلَ مَنفّ نَشَ تَا كُنتِفِيٍ شِلِ، عَ عَ قَلَ عٍ بّ، «وٌ شَ عَ كٌلٌن، عَ يِ مِشِ وَ مَ وٌن تْورْقٍ نّ. ﭑ نُ بَرَ عَ قَلَ عَ بّ عَ ﭑ نَن ﭑ مَ فِنّيٍ، ﭑ مَ دِيٍ، ﭑ مَ شّيمَ، نُن ﭑ مَ فبٍتِ بِرِن قِمَ نّ عَ مَ. ﭑ مُ نُ تٌندِشِ نَ سٍسٍ رَ.» <verse eid="1KI 20:7"/><verse number="8" style="v" sid="1KI 20:8"/>كُنتِفِيٍ نُن حَمَ بِرِن نَشَ عَ يَابِ، «عِ نَشَ عِ تُلِ مَتِ عَ رَ، عِ نَشَ عَ دَنشُن.»<verse eid="1KI 20:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 20:9"/>نَ كُي عَكَبُ نَشَ عَ قَلَ بٍن هَدَدَ شَ شّيرَيٍ بّ، «وٌ سَ عَ قَلَ وٌن مَ مَنفّ بّ عَ عَ نَشَن سِنفٍ قَلَ، ﭑ بَرَ تِن نَ رَ، كْنْ عَ نَشَن سَشِ نَ قَرِ، ﭑ مُ نَ رَبَمَ.» شّيرَيٍ نَشَ فبِلٍن نَ قَلَدٍ مَنفّ بٍن هَدَدَ بّ. <verse eid="1KI 20:9"/><verse number="10" style="v" sid="1KI 20:10"/>بٍن هَدَدَ نَشَ شّيرَيٍ شّي مَنفّ عَكَبُ مَ عَ قَلَقٍ رَ، «شَ ﭑ مُ سَمَرِ شُن نَكَنَ، سٍسٍ مُ لُ يِ تَا كُي قَ، مِشِ نْمَ نَشَن مَتٌنفٌدٍ عَ بّلّشّسٌلٍ رَ، عَلَيٍ شَ ﭑ دَنكَ.» <verse eid="1KI 20:10"/><verse number="11" style="v" sid="1KI 20:11"/>كْنْ عِسِرَيِلَ مَنفّ نَشَ عَ يَابِ، «سْورِ نَشَن نَ سِفَقٍ فٍرٍ سٌدٍ، عَ مُ لَن عَ شَ عَ يّتّ مَتْشْ، عَلْ سْورِ نَشَن بَرَ فّ فٍرٍ سٌدٍ.» <verse eid="1KI 20:11"/><verse number="12" style="v" sid="1KI 20:12"/>بٍن هَدَدَ تٌ نَ وْيّنيِ مّ، عَ نُ نَ بٍرٍ مِنقٍ نّ عَ نُن مَنفّ فبّتّيٍ عٍ شَ لٍيلٍيٍ بُن مَ. عَ نَشَ عَ قَلَ عَ شَ سْورِيٍ بّ، «وٌن شّي فٍرٍ سٌدٍ.» نَ كُي عٍ نَشَ عٍ يَ رَقِندِ سَمَرِ تَا مَ.<verse eid="1KI 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 20:13"/>نَ تّمُي نَمِحْنمّ ندٍ نَشَ عَ مَسٌ عِسِرَيِلَ مَنفّ عَكَبُ رَ، عَ نَشَ عَ مَسٍن عَ بّ، «عَلَتَلَ نَشّ، ‹عِ يِ سْورِ فَلِ تٌ؟ تٌ يَتِ ﭑ عٍ بِرِن سَمَ نّ عِ سَفٌي، عَلَكٌ عِ شَ عَ كٌلٌن عَ ﭑ تَن نَن نَ عَلَتَلَ رَ.›» <verse eid="1KI 20:13"/><verse number="14" style="v" sid="1KI 20:14"/>عَكَبُ نَشَ عَ مَشْرِن، «عَ قَمَ نَ رَبَدٍ ندٍ سَابُي رَ؟» نَمِحْنمّ نَشَ عَ قَلَ عَ بّ، «عَلَتَلَ نَشّ عِ قَمَ نَ رَبَدٍ فٌمِنَيٍ شَ سّفّتَلَيٍ نَن سَابُي رَ.» عَكَبُ نَشَ عَ مَشْرِن، «ندٍ قِندِ مَ عٍ شَ يَرٍرَتِ رَ نَ فٍرٍ كُي؟» عَ نَشَ عَ يَابِ، «عِ تَن.» <verse eid="1KI 20:14"/><verse number="15" style="v" sid="1KI 20:15"/>نَ كُي عَكَبُ نَشَ فٌمِنَيٍ شَ سّفّتَلَيٍ مَلَن، عٍ قِندِ مِشِ كّمّ قِرِن مِشِ تٌنفٌ سَشَن نُن قِرِن نَ. عِسِرَيِلَ حَمَ نَشَن نُ نَ عٍ شَنبِ رَ، عٍ قِندِ مِشِ وُلُ سٌلٌقٍرٍ نَن نَ.<verse eid="1KI 20:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1KI 20:16"/>عٍ نَشَ مِنِ فٍرٍ سٌدٍ يَنيِ تَفِ. عَ لِشِ بٍن هَدَدَ نُن عَ مَلِمَ مَنفّ تٌنفٌ سَشَن نُن قِرِن نُ نَ بٍرٍ مِنقٍ عٍ شَ لٍيلٍيٍ بُن مَ. <verse eid="1KI 20:16"/><verse number="17" style="v" sid="1KI 20:17"/>فٌمِنَيٍ شَ سّفّتَلَيٍ سِنفٍ نَشَ مِنِ فٍرٍ سٌدٍ. مِشِيٍ نَشَ عَ قَلَ بٍن هَدَدَ بّ، «سْورِيٍ بَرَ مِنِ سَمَرِ تَا كُي.» <verse eid="1KI 20:17"/><verse number="18" style="v" sid="1KI 20:18"/>عَ نَشَ عٍ يَابِ، «شَ نَ سْورِيٍ قَقٍ لَنيِ نَن قٍندٍ، شَ نَ مُ عَ رَ عٍ وَ مَ فٍرٍ سٌدٍ، وٌ شَ عٍ سُشُ كْنْ وٌ نَشَ عٍ قَشَ دٍ.»<verse eid="1KI 20:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 20:19"/>عِسِرَيِلَ فٌمِنَيٍ شَ سّفّتَلَيٍ نَشَ مِنِ، عٍ نُن عِسِرَيِلَ سْورِ حَمَ. <verse eid="1KI 20:19"/><verse number="20" style="v" sid="1KI 20:20"/>عٍ تٌ فٍرٍ سٌ، كَنكَن نَشَ مِشِ ندٍ قَشَ. عَرَ مِكَيٍ نَشَ عٍ فِ كٍرٍن نَ، عِسِرَيِلَكَيٍ قَ بِرَ عٍ قْشْ رَ. عَرَ مِ مَنفّ بٍن هَدَدَ قَن نَشَ عَ فِ عَ شَ سٌي قَرِ، عَ نُن سْورِ ندٍ نَشٍيٍ نُ نَ سْورِ رَفِسٍيٍ كُي. <verse eid="1KI 20:20"/><verse number="21" style="v" sid="1KI 20:21"/>عِسِرَيِلَ مَنفّ نَشَ مِنِ، عَ عَرَ مِكَيٍ شَ سٌييٍ قَشَ، عَ عٍ شَ سْورِ رَفِسٍيٍ كَنَ. نَ قِندِ نّ فبَلٌي رَ عَرَ مِكَيٍ بّ. <verse eid="1KI 20:21"/><verse number="22" style="v" sid="1KI 20:22"/>نَ نَمِحْنمّ مَن نَشَ عَ مَسٌ عِسِرَيِلَ مَنفّ رَ، عَ عَ قَلَ عَ بّ، «عِ شَ وَكِلِ، عِ شَ قٍيٍ رَقَلَ، بَرِ مَ تَمُنَ عَرَ مِ مَنفّ مَن قَمَ نّ عِ فٍرٍدٍ.»<verse eid="1KI 20:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 20:23"/>عَرَ مِ سْورِيٍ نَشَ عَ قَلَ عٍ شَ مَنفّ بّ، «عِسِرَيِلَكَيٍ شَ عَلَ سّنبّ فبٌ فٍيَ نَن قَرِ. نَ نَن عَ تٌشِ عٍ وٌن بْنبْشِ. شَ وٌن سَ عٍ فٍرٍ قِلِ نَن مَ نُ، وٌن نْمَ نّ عٍ رَ. <verse eid="1KI 20:23"/><verse number="24" style="v" sid="1KI 20:24"/>عِ نَشَن نَبَمَ، عِ شَ نَ مَنفّيٍ بَ نَشٍيٍ نَ عِ شَ مِشِيٍ يَ مَ، عِ قَ فٌمِنَيٍ تِ عٍ حْشْي رَ. <verse eid="1KI 20:24"/><verse number="25" style="v" sid="1KI 20:25"/>عِ شَ سْورِ فبّتّيٍ قٍن سْورِ قَشَشِيٍ حْشْي رَ، عِ شَ سٌي نُن سْورِ رَفِسٍيٍ قٍن عَ كَنَشِيٍ حْشْي رَ. نَ تّمُي، وٌن مَن سِفَمَ عٍ فٍرٍدٍ قِلِ نَن مَ، وٌن قَمَ نّ نْدٍ عٍ رَ عَ قَنيِ رَ.» مَنفّ نَشَ نَ بِرِن نَبَ، عَلْ عٍ عَ قَلَ عَ بّ كِ نَشّ.<verse eid="1KI 20:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 20:26"/>نَ حّ عِفبِلٍنيِ، بٍن هَدَدَ نَشَ عَ شَ سْورِيٍ مَلَن، عَ عٍ شَنِن عَقٍكِ بِرِ رَ، عٍ شَ عِسِرَيِلَ فٍرٍ. <verse eid="1KI 20:26"/><verse number="27" style="v" sid="1KI 20:27"/>عِسِرَيِلَكَيٍ قَن نَشَ عٍ شَ سْورِيٍ مَلَن، عٍ قَندّ سْتْ، عٍ سِفَ عٍ رَلَندٍ. عِسِرَيِلَكَيٍ تٌ يٌنكِن عَرَ مِ حَمَ يَ عِ، عٍ لُ نّ عَلْ سِ فْورّ لَنمَدِ قِرِن عَرَ مِكَيٍ شَ فبٌي شَ قٍ رَ.<verse eid="1KI 20:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1KI 20:28"/>عَلَ شَ مِشِ نَشَ عَ مَسٌ عِسِرَيِلَ مَنفّ رَ، عَ عَ مَسٍن عَ بّ، «عَلَتَلَ شُي نَن يِ كِ؛ عَرَ مِكَيٍ تٌ عَ قَلَ عَ عَلَتَلَ سّنبّ فبٌ فٍيَ نَن قَرِ عَ مُ قِندِشِ عَلَ رَ قِلِ تَن مَ، ﭑ عٍ سَمَ نّ عِ سَفٌي، عَلَكٌ عِ شَ عَ كٌلٌن ﭑ تَن نَن عَلَتَلَ رَ.» <verse eid="1KI 20:28"/><verse number="29" style="v" sid="1KI 20:29"/>عٍ نَشَ يٌنكِن عٍ بٌورٍ يَ عِ شِ سٌلٌقٍرٍ بُن مَ. نَ تّمُي فٍرٍ نَشَ قْلْ، عِسِرَيِلَكَيٍ قَ عَرَ مِ سْورِيٍ مِشِ وُلُ كّمّ قَشَ. <verse eid="1KI 20:29"/><verse number="30" style="v" sid="1KI 20:30"/>عَ دْنشْييٍ نَشَ مِنِ عٍ فِ رَ عَقٍكِ تّتّ كُي، كْنْ تّتّ قَن يَتِ نَشَ بِرَ عٍ مَ، عَ مِشِ وُلُ مْشْحّن نُن سٌلٌقٍرٍ قَشَ. بٍن هَدَدَ تَن نُ بَرَ عَ فِ، عَ سَ عَ نْشُن كٌنكٌي ندٍ كُي.<verse eid="1KI 20:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="1KI 20:31"/>عَ شَ سْورِيٍ نَشَ عَ قَلَ عَ بّ، «مُشُ عَ مّ نّ، عَ عِسِرَيِلَكَيٍ شَ مَنفّيٍ بْحّ قَن. مُشُ شَ بّكِ دُفِ شِرِ مُشُ تَفِ، مُشُ شَ لُوتِ شِرِ مُشُ شُنيِيٍ سُننُنيِ تْنشُمَ رَ، مُشُ شَ مُشُ يّتّ دّنتّفّ عِسِرَيِلَ مَنفّ بّ. تّمُندٍ عَ دِحّمَ عِ قَشَقٍ مَ.» <verse eid="1KI 20:31"/><verse number="32" style="v" sid="1KI 20:32"/>عٍ نَشَ بّكِ دُفِ شِرِ عٍ تَفِ، عٍ لُوتِيٍ شِرِ عٍ شُنيِيٍ سُننُنيِ تْنشُمَ رَ، عٍ قَ عٍ يّتّ دّنتّفّ عِسِرَيِلَ مَنفّ بّ، عٍ قَ عَ قَلَ، «عِ شَ كٌنيِ بٍن هَدَدَ بَرَ عِ مَيَندِ عِ نَشَ عَ قَشَ.» عَكَبُ نَشَ عٍ يَابِ، «عَ مَن بَلٌشِ؟ ﭑ نفَشَكٍرٍنيِ نَن عَ رَ.» <verse eid="1KI 20:32"/><verse number="33" style="v" sid="1KI 20:33"/>نَ مِشِيٍ تٌ نَ مّ، عٍ نَشَ عَ مَحْشُن قٍ قَنيِ نَ عَ رَ. عٍ نَشَ مَنفّ يَابِ، «عِيٌ، بٍن هَدَدَ عِ نفَشَكٍرٍنيِ نَن عَ رَ!» عَكَبُ نَشَ عٍ يَمَرِ، «وٌ سَ قَ عَ رَ.»</para>
  <para style="p" vid="1KI 20:33">بٍن هَدَدَ نَشَ مِنِ عَ نُ نَ دّننَشّ، عَ سِفَ عَكَبُ يِرٍ. عَكَبُ نَشَ عَ بَكِ عَ شَ سْورِ رَفِسٍ كُي. <verse eid="1KI 20:33"/><verse number="34" style="v" sid="1KI 20:34"/>بٍن هَدَدَ نَشَ عَ قَلَ عَ بّ، «ﭑ تَايٍ رَفبِلٍنمَ نّ عِ مَ، ﭑ بَبَ نَشٍيٍ بَ عِ بَبَ يِ رَ. عِ نْمَ عِ شَ مَكِتِ تِدٍ دَ مَسِ، عَلْ ﭑ بَبَ فبٍ تٌ نُ نَ سَمَرِ.» عَكَبُ نَشَ عَ قَلَ عَ بّ، «وٌن شَ سَاتّ شِرِ، ﭑ قَ عِ بّحِن.» عٍ تٌ سَاتّ شِرِ، عَ نَشَ عَ بّحِن.<verse eid="1KI 20:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="1KI 20:35"/>نَمِحْنمّ ندٍ نَشَ عَ قَلَ عَ حّرّ بٌورٍ بّ عَلَتَلَ شُي رَ، «ﭑ بْنبْ.» كْنْ عَ حّرّ بٌورٍ مُ تِن عَ بْنبْدٍ. <verse eid="1KI 20:35"/><verse number="36" style="v" sid="1KI 20:36"/>نَ كُي، عَ نَشَ عَ قَلَ عَ حّرّ بٌورٍ بّ، «عِ تٌ مُ تِنشِ عِ تُلِ مَتِدٍ عَلَتَلَ شَ مَسٍنيِ رَ، يّتّ ندٍ قَمَ نّ عِ قَشَدٍ.» عَ تٌ كٍلِ مّننِ، يّتّ نَشَ دُتُن عَ مَ، عَ عَ قَشَ. <verse eid="1KI 20:36"/><verse number="37" style="v" sid="1KI 20:37"/>نَ نَمِحْنمّ نَشَ سِفَ مِشِ فبّتّ قَن يِرٍ، عَ عَ قَلَ عَ بّ، «ﭑ بْنبْ.» نَ كَنيِ نَشَ عَ بْنبْ هَن عَ عَ مَشْنْ.<verse eid="1KI 20:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="1KI 20:38"/>نَمِحْنمّ نَشَ سَ تِ كِرَ رَ مَنفّ نُ دَنفِمَ دّننَشّ. عَ نَشَ عَ يَتَفِ مَشِرِ دُفِ ندٍ رَ عَ قِ دَاشِ. <verse eid="1KI 20:38"/><verse number="39" style="v" sid="1KI 20:39"/>مَنفّ تٌ دَنفِ نَا، نَمِحْنمّ نَشَ عَ قَلَ مَنفّ بّ عَ شُي عِتٍشِ رَ، «ﭑ تَن عِ شَ سْورِ، ﭑ نُ نَ فٍرٍ يِرٍ نّ. سْورِ ندٍ نَشَ مِنِ فٍرٍ يَ مَ، عَ قَ وٌن يَشُي سُشُشِ ندٍ تَشُ ﭑ نَ، عَ عَ قَلَ ﭑ بّ، ‹يِ شّمّ سُشُ فبٍن. شَ عَ عَ بَ عِ يِ، عِ نِي نَن قِندِ مَ عَ سَرٍ رَ، شَ نَ مُ عِ كْبِرِ بَ.› <verse eid="1KI 20:39"/><verse number="40" style="v" sid="1KI 20:40"/>كْنْ ﭑ نُ يَنقَشِ وَلِ ندٍ كُي، نَ شّمّ سُشُشِ نَشَ نْ عَ فِدٍ.» مَنفّ نَشَ عَ قَلَ عَ بّ، «عِ بَرَ عِ يّتّ مَكِيتِ. عَ لَنمَ عِ شَ قَشَ.»<verse eid="1KI 20:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="1KI 20:41"/>نَ تّمُي نَمِحْنمّ نَشَ دُفِ بَ عَ يَتَفِ مَ، عِسِرَيِلَ مَنفّ نَشَ عَ كٌلٌن قَ نَمِحْنمّ ندٍ نَن عَ رَ. <verse eid="1KI 20:41"/><verse number="42" style="v" sid="1KI 20:42"/>عَ نَشَ عَ قَلَ مَنفّ بّ، «عِ تٌ بَرَ عِ يَشُي بّحِن ﭑ نَشَن سَشِ عِ بّلّشّ عِ، ﭑ مِشِ نَشَن نَتْنشِ، عِ نِي نَن قِندِ مَ عَ سَرٍ رَ، عِ شَ حَمَ قِندِ مَ عَ شَ حَمَ سَرٍ نَن نَ.» <verse eid="1KI 20:42"/><verse number="43" style="v" sid="1KI 20:43"/>نَ كُي عِسِرَيِلَ مَنفّ نَشَ فبِلٍن عَ شْنيِ سَمَرِ سُننُنيِ نُن بْحّ مَحَاشُي كُي.<verse eid="1KI 20:43"/></para>
  <chapter eid="1KI 20"/>
  <chapter number="21" style="c" sid="1KI 21"/>
  <para style="s">نَبٌتِ شَ سَنسِ يِرٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 21:1"/>يِسِرٍيلِكَ ندٍ نُ نَ نَشَن شِلِ نَبٌتِ. سَنسِ يِرٍ نُ نَ عَ يِ رَ سَمَرِ مَنفّ عَكَبُ شَ بْشِ قّ مَ. <verse eid="1KI 21:1"/><verse number="2" style="v" sid="1KI 21:2"/>عَكَبُ نَشَ عَ قَلَ نَبٌتِ بّ، «عِ شَ عِ شَ سَنسِ يِرٍ سٌ ﭑ يِ رَ، ﭑ شَ عَ قِندِ ﭑ مَ لَاكْي يِرٍ رَ، بَرِ مَ عَ مَكْرّ ﭑ مَ بَنشِ رَ. ﭑ سَنسِ يِرٍ فبّتّ سٌمَ عِ يِ رَ عَ حْشْي رَ نَشَن قَن نَ بّ، شَ نَ مُ عَ رَ، ﭑ شَ عَ سَرَ كْبِرِ رَ.» <verse eid="1KI 21:2"/><verse number="3" style="v" sid="1KI 21:3"/>نَبٌتِ نَشَ عَكَبُ يَابِ، عَ نَشّ، «عَلَتَلَ شَ ﭑ نَتَنفَ ﭑ بٍنبَيٍ كّ سٌقٍ رَ عِ يِ.»<verse eid="1KI 21:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1KI 21:4"/>عَكَبُ نَشَ سٌ عَ شْنيِ، عَ سُننُنشِ رَ، عَ بْحّ مَحَاشُشِ يِسِرٍيلِكَ نَبٌتِ شَ مَسٍنيِ شَ قٍ رَ، عَ قَلَقٍ رَ، «ﭑ مُ ﭑ بٍنبَيٍ كّ سٌمَ عِ يِ رَ.» عَ نَشَ عَ سَ، عَ عَ كٌبٍ رَ سٌ مِشِيٍ رَ، عَ مُ تِن دٌنسٍ دٌندٍ. <verse eid="1KI 21:4"/><verse number="5" style="v" sid="1KI 21:5"/>عَ شَ فِنّ يٍسَبٍلَ نَشَ سِفَ عَ يِرٍ، عَ عَ مَشْرِن، «مُنقٍ رَ عِ بْحّ مَحَاشُشِ، عِ مُ تِن عِ دّفٍدٍ؟» <verse eid="1KI 21:5"/><verse number="6" style="v" sid="1KI 21:6"/>عَ نَشَ عَ يَابِ، «ﭑ بَرَ عَ قَلَ يِسِرٍيلِكَ نَبٌتِ بّ عَ شَ عَ شَ سَنسِ يِرٍ سٌ ﭑ يِ رَ، ﭑ شَ عَ سَرَ، شَ نَ مُ عَ رَ، ﭑ شَ سَنسِ يِرٍ فبّتّ سٌ عَ يِ رَ، كْنْ عَ مُ تِن نَ رَ قٍقٍ مَ.» <verse eid="1KI 21:6"/><verse number="7" style="v" sid="1KI 21:7"/>نَ كُي، عَ شَ فِنّ يٍسَبٍلَ نَشَ عَ قَلَ عَ بّ. «ثٍ، عِ تَن شَ مُ قِندِشِ عِسِرَيِلَ مَنفّ رَ؟ عَوَ، مَنفّ، كٍلِ، عِ شَ عِ دّفٍ حّلّشِنيِ كُي. ﭑ تَن يِسِرٍيلِكَ نَبٌتِ شَ سَنسِ يِرٍ سٌمَ نّ عِ يِ رَ!»<verse eid="1KI 21:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 21:8"/>عَ شَ فِنّ نَشَ بَتَاشّ سّبّ عَكَبُ شِلِ رَ، عَ مَنفّ عَكَبُ شَ تْنشُمَ سَ عَ مَ، عَ قَ عَ رَ سَنبَ قٌرِيٍ نُن كُنتِفِيٍ مَ، نَشٍيٍ نُ سَبَتِشِ نَبٌتِ شَ تَا كُي. <verse eid="1KI 21:8"/><verse number="9" style="v" sid="1KI 21:9"/>عَ سّبّشِ بَتَاشّ كُي، «وٌ سُنيِ نُن سَلِ رَبَقٍ تِ حَمَ بّ، نَبٌتِ شَ دْشْ حَمَ بِرِن يَ عِ. <verse eid="1KI 21:9"/><verse number="10" style="v" sid="1KI 21:10"/>وٌ شَ قُيَنتٍ قِرِن دْشْ عَ يَ عِ، نَشٍيٍ عَ تْوحّفّمَ، عَ قَلَقٍ رَ عَ بَرَ عَلَ نُن مَنفّ كٌنبِ. نَ كُي وٌ شَ عَ رَ مِنِ تَا كُي، وٌ عَ مَفْنْ فّمّ رَ هَن عَ شَ قَشَ.»<verse eid="1KI 21:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 21:11"/>نَبٌتِ شَ تَا مِشِيٍ، قٌرِيٍ نُن كُنتِفِيٍ نَشَ عَ رَبَ، عَلْ يٍسَبٍلَ عَ يَمَرِشِ كِ نَشّ نَ بَتَاشّ كُي. <verse eid="1KI 21:11"/><verse number="12" style="v" sid="1KI 21:12"/>عٍ نَشَ سُن عٍ سَلِ، عٍ نَبٌتِ دْشْ حَمَ بِرِن يَ تٌدٍ رَ، <verse eid="1KI 21:12"/><verse number="13" style="v" sid="1KI 21:13"/>عٍ قَ قُيَنتٍ قِرِنيِ رَدْشْ عَ يِرٍ. نَ قُيَنتٍ قِرِنيِيٍ نَشَ نَبٌتِ تْوحّفّ حَمَ يَ عِ، عَ قَلَقٍ رَ، «نَبٌتِ بَرَ عَلَ نُن مَنفّ كٌنبِ.» حَمَ نَشَ نَبٌتِ شَنِن تَا قَرِ مَ، عٍ عَ مَفْنْ هَن عَ قَشَ. <verse eid="1KI 21:13"/><verse number="14" style="v" sid="1KI 21:14"/>عٍ نَشَ شّيرَيٍ شّي يٍسَبٍلَ مَ، عَ قَلَقٍ رَ، «نَبٌتِ بَرَ مَفْنْ فّمّ رَ، عَ بَرَ قَشَ.»<verse eid="1KI 21:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 21:15"/>يٍسَبٍلَ تٌ عَ مّ عَ نَبٌتِ بَرَ مَفْنْ فّمّ رَ هَن عَ بَرَ قَشَ، عَ نَشَ سِفَ عَكَبُ يِرٍ، عَ عَ قَلَ عَ بّ، «يَكْسِ كٍلِ، عِ شَ نَبٌتِ شَ سَنسِ يِرٍ تٌنفٌ، نَبٌتِ يِسِرٍيلِكَ تٌندِ نَشَن سَرَدٍ عِ مَ كْبِرِ رَ. نَبٌتِ عَ مُ نَ سْنْن، عَ بَرَ قَشَ.» <verse eid="1KI 21:15"/><verse number="16" style="v" sid="1KI 21:16"/>عَكَبُ تٌ عَ مّ، عَ نَبٌتِ بَرَ قَشَ، عَ نَشَ كٍلِ كٍرٍن نَ، عَ سَ نَبٌتِ شَ سَنسِ يِرٍ قِندِ عَ فبٍ رَ.<verse eid="1KI 21:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1KI 21:17"/>عَلَتَلَ نَشَ عَ مَسٍن عَننَبِ عٍلِيَ تِسِبٍكَ بّ، عَ نَشّ، <verse eid="1KI 21:17"/><verse number="18" style="v" sid="1KI 21:18"/>«سِفَ عِسِرَيِلَ مَنفّ عَكَبُ يِرٍ سَمَرِ. عَ نَ نَبٌتِ شَ سَنسِ يِرٍ، عَ نَشَن قِندِشِ عَ فبٍ رَ. <verse eid="1KI 21:18"/><verse number="19" style="v" sid="1KI 21:19"/>عِ شَ عَ قَلَ عَ بّ، ‹عَلَتَلَ شَ مَسٍنيِ نَن يَ؛ «عِ بَرَ قَشّ تِ، عِ بَرَ مِشِ كّ مُحَ! بَرٍيٍ قَمَ عِ وُلِ مَكْندٍ، عٍ نَبٌتِ وُلِ مَكْنشِ دّننَشّ.»›» <verse eid="1KI 21:19"/><verse number="20" style="v" sid="1KI 21:20"/>عَكَبُ نَشَ عٍلِيَ يَابِ، «عِ تَن ﭑ يَشُي، عِ بَرَ ﭑ تٌ؟» عَ نَشَ عَ قَلَ عَ بّ، «عِيٌ، ﭑ بَرَ عِ تٌ. عِ تٌ عِ يّتّ قِ قٍ حَاشِ رَبَقٍ مَ، نَشَن مُ رَقَنشِ عَلَتَلَ مَ، <verse eid="1KI 21:20"/><verse number="21" style="v" sid="1KI 21:21"/>ﭑ فبَلٌي رَفٌرٌ مَ نّ عِ مَ، ﭑ عِ بَمَ نّ عِسِرَيِلَ، ﭑ شّمّ بِرِن قَشَ شْرّ نُن كٌنيِ عِ بْنسْي يَ مَ عِسِرَيِلَ. <verse eid="1KI 21:21"/><verse number="22" style="v" sid="1KI 21:22"/>ﭑ عِ شَ قْشّ لُمَ نّ، عَلْ نٍبَتِ شَ دِ يٍرٌبٌوَ مِ نُن عَهِيَ شَ دِ بَاسَ شَ قْشّيٍ، بَرِ مَ عِ بَرَ ﭑ نَشْنْ، عِ مَن بَرَ عِسِرَيِلَ حَمَ بِرِن نَحّرّ يُنُبِ كُي.»<verse eid="1KI 21:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 21:23"/>«عَلَتَلَ شَ مَسٍنيِ نَن يَ يٍسَبٍلَ شَ قٍ رَ، عَ نَشّ، ‹بَرٍيٍ قَمَ نّ يٍسَبٍلَ دٌندٍ يِسِرٍيلِ تّتّ قّ مَ. <verse eid="1KI 21:23"/><verse number="24" style="v" sid="1KI 21:24"/>عَكَبُ شَ مِشِ نَشَن نَ قَشَ تَا كُي، بَرٍيٍ نَن نَ دٌنمَ. نَشَن نَ قَشَ وُلَ عِ، يُبّيٍ نَن نَ دٌنمَ.›»<verse eid="1KI 21:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 21:25"/>مِشِ يٌ مُ نَ نَشَن عَ يّتّ قِ قٍ حَاشِ رَبَقٍ مَ عَلْ عَكَبُ. عَ شَ فِنّ يٍسَبٍلَ نُ عَ بْحّ رَتٍمَ نَ قٍ كُي. <verse eid="1KI 21:25"/><verse number="26" style="v" sid="1KI 21:26"/>عَ نُ قٍ حَاشِ رَبَمَ دَنفِ مِشِ بِرِن نَ. عَ نُ كُيٍيٍ بَتُمَ عَلْ عَمٌرِكَيٍ، عَلَتَلَ نَشٍيٍ كٍرِ عِسِرَيِلَكَيٍ يَ رَ.<verse eid="1KI 21:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1KI 21:27"/>عَكَبُ تٌ عَننَبِ عٍلِيَ شَ مَسٍنيِ مّ، عَ نَشَ عَ شَ دٌنمَ عِبْو سُننُنيِ كُي، عَ نَشَ سُننُن دُفِ رَفٌرٌ عَ مَ، عَ سُنيِ سُشُ. عَ نُ عَ سَمَ سَدٍ مَ، نَ سُننُن دُفِ رَفٌرٌشِ عَ مَ، شَ نَ مُ عَ نُ حّرّ دْيِ دْيِ عَ سُننُنشِ رَ. <verse eid="1KI 21:27"/><verse number="28" style="v" sid="1KI 21:28"/>عَلَتَلَ نَشَ عَ مَسٍن عٍلِيَ تِسِبٍكَ بّ، عَ نَشّ، <verse eid="1KI 21:28"/><verse number="29" style="v" sid="1KI 21:29"/>«عِ بَرَ عَ تٌ عَكَبُ عَ يّتّ مَفٌرٌشِ ﭑ بّ كِ نَشّ؟ عَ تٌ بَرَ عَ يّتّ مَفٌرٌ ﭑ بّ، ﭑ مُ فبَلٌي رَفٌرٌ مَ عَ مَ قَننِ عَ بَلٌشِ. ﭑ فبَلٌي رَفٌرٌ مَ عَ بْنسْي مَ عَ شَ دِ شَ وَشَتِ نّ.»<verse eid="1KI 21:29"/></para>
  <chapter eid="1KI 21"/>
  <chapter number="22" style="c" sid="1KI 22"/>
  <para style="s">عَكَبُ شَ فٍرٍيٍ</para>
  <para style="r">يُدَيَ مَنفّيٍ عِِ ١٨‏؛٢ ٬ ٢٧</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 22:1"/>حّ سَشَن نَشَ دَنفِ، فٍرٍ يٌ مُ لُ عَرَ مِ نُن عِسِرَيِلَ تَفِ. <verse eid="1KI 22:1"/><verse number="2" style="v" sid="1KI 22:2"/>عَ حّ سَشَن ندٍ رَ، يُدَيَ مَنفّ يٍهٌسَقَتِ نَشَ فٌرٌ عِسِرَيِلَ مَنفّ يِرٍ. <verse eid="1KI 22:2"/><verse number="3" style="v" sid="1KI 22:3"/>عِسِرَيِلَ مَنفّ نَشَ عَ قَلَ عَ شَ مِشِيٍ بّ، «وٌ عَ كٌلٌن عَ رَ مٌتِ، نَشَن نَ فَلَدِ بْشِ مَ، وٌن تَن نَن فبٍ عَ رَ. وٌن نَشَ سِيكّ عَ رَ سُشُدٍ عَرَ مِ مَنفّ يِ رَ.» <verse eid="1KI 22:3"/><verse number="4" style="v" sid="1KI 22:4"/>عِسِرَيِلَ مَنفّ عَكَبُ نَشَ عَ قَلَ يُدَيَ مَنفّ يٍهٌسَقَتِ بّ، «وٌن بِرِن نَ عَ رَ سِفَقٍ رَ مٌتِ فَلَدِ بْشِ مَ؟» يٍهٌسَقَتِ نَشَ عَ يَابِ، «عِيٌ، عِ تَن يٌ ﭑ تَن يٌ، وٌن بِرِن كٍرٍن. وٌن مَ حَمَيٍ نُن وٌن مَ سٌي قَن عَ بِرِن كٍرٍن.»<verse eid="1KI 22:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 22:5"/>يٍهٌسَقَتِ نَشَ عَ قَلَ عِسِرَيِلَ مَنفّ بّ، «ﭑ بَرَ عِ مَشَندِ، وٌن شَ عَلَتَلَ سَفٌ قٍن يِ قٍ كُي يَكْسِ.» <verse eid="1KI 22:5"/><verse number="6" style="v" sid="1KI 22:6"/>عِسِرَيِلَ مَنفّ نَشَ نَمِحْنمّ كّمّ نَانِ مَلَن، عَ عٍ مَشْرِن، «عَ لَنمَ كَ عَ مُ لَنمَ وٌن شَ سِفَ رَ مٌتِ فٍرٍدٍ فَلَدِ بْشِ مَ؟» عٍ نَشَ عَ يَابِ، «وٌ تٍ، عَلَ قَمَ عٍ سَدٍ عِ سَفٌي مَنفّ.» <verse eid="1KI 22:6"/><verse number="7" style="v" sid="1KI 22:7"/>كْنْ يٍهٌسَقَتِ نَشَ مَنفّ مَشْرِن، «عَلَتَلَ شَ نَمِحْنمّ ندٍ مُ نَ بٍ، وٌن نْمَ نَشَن مَشْرِندٍ؟» <verse eid="1KI 22:7"/><verse number="8" style="v" sid="1KI 22:8"/>عِسِرَيِلَ مَنفّ نَشَ يٍهٌسَقَتِ يَابِ، «شّمّ كٍرٍن ثٍتِ نَن بٍ، وٌن نْمَ عَلَتَلَ مَشْرِندٍ نَشَن سَابُي رَ، كْنْ عَ مُ رَقَن ﭑ مَ، بَرِ مَ عَ شُننَكَنّ قٍ نَن فبَنسَن قَلَمَ ﭑ مَ قٍ رَ. عَ مُ شُننَكٍلِ قٍ يٌ قَلَمَ ﭑ بّ. عَ شِلِ مِكٍ. يِمِلَ شَ دِ نَ عَ رَ.» يٍهٌسَقَتِ نَشَ عَ قَلَ، «عَ مُ لَنمَ مَنفّ شَ نَ وْيّن مْولِ قَلَ.» <verse eid="1KI 22:8"/><verse number="9" style="v" sid="1KI 22:9"/>نَ كُي، عِسِرَيِلَ مَنفّ نَشَ عَ شَ بَتُلَ كٍرٍن شِلِ، عَ عَ قَلَ عَ بّ، «قَ يِمِلَ شَ دِ مِكٍ رَ ﭑ بّ كٍرٍن نَ.»<verse eid="1KI 22:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 22:10"/>عِسِرَيِلَ مَنفّ نُن يُدَيَ مَنفّ يٍهٌسَقَتِ نُ دْشْشِ عٍ شَ كِبَنيِيٍ كُي، مَنفّ دٌنمَيٍ رَفٌرٌشِ عٍ مَ. عٍ نُ نَ لٌنيِ مَ، سَمَرِ تَا سٌدٍ دّ رَ. نَمِحْنمّيٍ نُ نَ عٍ شَ مَسٍنيِيٍ تِقٍ عٍ بّ. <verse eid="1KI 22:10"/><verse number="11" style="v" sid="1KI 22:11"/>كٍنَانَ شَ دِ سٍدٍكِيَ نُ بَرَ قٍرِ وُرٍ دَاشِيٍ يَءِلَن، عَ قَ عَ قَلَ مَنفّيٍ بّ، «عَلَتَلَ شَ مَسٍنيِ نَن يَ؛ ‹وٌ عَرَ مِكَيٍ بْنبْمَ يِ قٍرِيٍ نَن نَ هَن عٍ سْنتْ.›» <verse eid="1KI 22:11"/><verse number="12" style="v" sid="1KI 22:12"/>نَمِحْنمّ بِرِن نُ نَ مَسٍنيِ مْولِ قَلَمَ عٍ بّ. عٍ نَشَ عَ قَلَ، «وٌ تٍ رَ مٌتِ فَلَدِ بْشِ مَ. وٌ شُننَكٍلِ نَن سْتْمَ، عَلَتَلَ قَمَ نّ عٍ سَدٍ مَنفّ سَفٌي.»<verse eid="1KI 22:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 22:13"/>شّيرَ نَشَن سِفَ مِكٍ شِلِدٍ، نَ نَشَ عَ قَلَ عَ بّ، «عِ بَرَ عَ تٌ، نَمِحْنمّ بِرِن بَرَ لَن عٍ شَ قٍ قَنيِ قَلَ مَنفّ بّ. عِ قَن شَ كَتَ، وٌ شُي شَ لُ كٍرٍن، عِ شَ قٍ قَنيِ قَلَ مَنفّ بّ.» <verse eid="1KI 22:13"/><verse number="14" style="v" sid="1KI 22:14"/>مِكٍ نَشَ عَ قَلَ، «عَلَتَلَ حِحّ نَ عَ رَ. ﭑ مَرِفِ عَلَتَلَ نَ نَشَن يٌ مَسٍن، ﭑ نَ نَن قَلَمَ.»<verse eid="1KI 22:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 22:15"/>عَ تٌ مَنفّ يِرٍ لِ، مَنفّ نَشَ عَ قَلَ عَ بّ، «مِكٍ، عَ لَنمَ كَ عَ مُ لَنمَ مُشُ شَ سِفَ فٍرٍ سٌدٍ رَ مٌتِ فَلَدِ بْشِ مَ؟» مِكٍ نَشَ عَ يَابِ، «وٌ تٍ، وٌ شُننَكٍلِ نَن سْتْمَ. عَلَتَلَ قَمَ نّ عٍ سَدٍ وٌ سَفٌي.» <verse eid="1KI 22:15"/><verse number="16" style="v" sid="1KI 22:16"/>كْنْ مَنفّ نَشَ عَ قَلَ عَ بّ، «ﭑ حَن بَرَ عَ قَلَ عِ بّ سَنيَ وُيَشِ، عِ شَ عِ كَلِ نْندِ يَتِ نَن قَلَدٍ ﭑ بّ عَلَتَلَ شِلِ رَ.»<verse eid="1KI 22:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1KI 22:17"/>مِكٍ نَشَ عَ يَابِ،</para>
  <para style="q" vid="1KI 22:17">«ﭑ بَرَ عِسِرَيِلَ بِرِن تٌ،</para>
  <para style="q" vid="1KI 22:17">عٍ يٍنسٍنشِ فٍيَيٍ قَرِ،</para>
  <para style="q" vid="1KI 22:17">عَلْ شُرُ سٍ رَبّحِنشِيٍ.</para>
  <para style="q" vid="1KI 22:17">عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="1KI 22:17">مَرِفِ مُ نَ يِ حَمَ بّ.</para>
  <para style="q" vid="1KI 22:17">كَنكَن شَ فبِلٍن عَ شْنيِ بْحّسَ كُي.»<verse eid="1KI 22:17"/></para>
  <para style="m">
    <verse number="18" style="v" sid="1KI 22:18"/>عِسِرَيِلَ مَنفّ نَشَ عَ قَلَ يٍهٌسَقَتِ بّ، «ﭑ مُ عَ قَلَ شّ عِ بّ، عَ مُ نْمَ قٍ قَنيِ مَسٍندٍ ﭑ مَ قٍ رَ، قٌ قٍ حَاشِ تُن؟»<verse eid="1KI 22:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 22:19"/>نَ تّمُي مِكٍ نَشَ عَ قَلَ عٍ بّ، «يَكْسِ، وٌ وٌ تُلِ مَتِ عَلَتَلَ شَ مَسٍنيِ رَ. ﭑ بَرَ عَلَتَلَ تٌ عَ شَ كِبَنيِ كُي، عَ شَ مَلٍكّ فَلِ نُ تِشِ عَ يِرٍقَنيِ مَ نُن عَ كْولَ مَ. <verse eid="1KI 22:19"/><verse number="20" style="v" sid="1KI 22:20"/>عَلَتَلَ نَشَ عَ قَلَ، ‹ندٍ وَ مَ سِفَقٍ شَشِلِ كٌبِ رَ سٌدٍ عِسِرَيِلَ مَنفّ عَكَبُ شُنيِ، عَ شَ سَ رَ مٌتِ فٍرٍ فَلَدِ بْشِ مَ عَلَكٌ عَ شَ قَشَ؟› ندٍ نَشَ عَ يَابِ شَشِلِ ندٍ رَ، ندٍ قَن نَشَ عَ يَابِ شَشِلِ فبّتّ رَ. <verse eid="1KI 22:20"/><verse number="21" style="v" sid="1KI 22:21"/>نَ كُي حِننّ ندٍ نَشَ مِنِ، عَ تِ عَلَتَلَ يَ عِ، عَ عَ قَلَ، ‹ﭑ تَن نْمَ نّ عَ رَ.› عَلَتَلَ نَشَ عَ مَشْرِن، ‹عِ نْمَ دِ؟› <verse eid="1KI 22:21"/><verse number="22" style="v" sid="1KI 22:22"/>عَ نَشَ عَ يَابِ، ‹ﭑ سِفَمَ نّ، ﭑ قَ وُلٍ قَلَ مَنفّ بّ عَ شَ نَمِحْنمّيٍ سَابُي رَ.› عَلَتَلَ نَشَ عَ قَلَ عَ بّ، ‹عِ قَمَ نّ عَ نْدٍ، نَ سْونّيَمَ نّ. سِفَ، عِ شَ سَ نَ رَبَ.› <verse eid="1KI 22:22"/><verse number="23" style="v" sid="1KI 22:23"/>يَكْسِ، عَلَتَلَ بَرَ وُلٍ سَ عِ شَ نَمِحْنمّيٍ دّ عِ. عَلَ بَرَ نَتّ حَاشِ تٌنفٌ عِ شَ قٍ رَ.»<verse eid="1KI 22:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1KI 22:24"/>نَ تّمُي، كٍنَانَ شَ دِ سٍدٍكِيَ نَشَ عَ مَسٌ، عَ مِكٍ دّ رَفَرِن، عَ قَ عَ قَلَ، «عَلَتَلَ شَشِلِ مِنِشِ كِرَ مُندُن نَ ﭑ مَ ﭑ شَ وْيّن عِ بّ؟» <verse eid="1KI 22:24"/><verse number="25" style="v" sid="1KI 22:25"/>مِكٍ نَشَ عَ يَابِ، «عِ قَمَ نَ تٌدٍ، عِ عِ فِمَ عِ نْشُندٍ قٍندٍ تّمُي نَشّ.» <verse eid="1KI 22:25"/><verse number="26" style="v" sid="1KI 22:26"/>عِسِرَيِلَ مَنفّ نَشَ عَ قَلَ، «وٌ مِكٍ شَنِن تَا مَنفّ عَمٌن نُن مَنفّ شَ دِ يٌوَ سِ شْن مَ. <verse eid="1KI 22:26"/><verse number="27" style="v" sid="1KI 22:27"/>وٌ شَ عَ قَلَ عٍ بّ، ‹مَنفّ نَشّ، عَ وٌ شَ يِ شّمّ سَ فٍيلِ كُي، عَ وٌ نَشَ دٌنسٍ سٌ عَ يِ رَ، قٌ تَامِ شَرٍ نُن يٍ، هَن ﭑ سَ قَمَ تّمُي نَشّ شُننَكٍلِ كُي.›» <verse eid="1KI 22:27"/><verse number="28" style="v" sid="1KI 22:28"/>مِكٍ نَشَ عَ يَابِ، «شَ عِ سَ فبِلٍن شُننَكٍلِ كُي، ﭑ مَ مَسٍنيِ مُ كٍلِشِ عَلَتَلَ مَ.» عَ مَن نَشَ عَ قَلَ حَمَ يَ شْرِ، «حَمَ بِرِن، وٌ شَ وٌ تُلِ مَتِ ﭑ مَ مَسٍنيِ رَ عَ قَنيِ رَ!»<verse eid="1KI 22:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 22:29"/>عِسِرَيِلَ مَنفّ نُن يُدَيَ مَنفّ يٍهٌسَقَتِ نَشَ تٍ رَ مٌتِ فَلَدِ بْشِ مَ. <verse eid="1KI 22:29"/><verse number="30" style="v" sid="1KI 22:30"/>عِسِرَيِلَ مَنفّ نَشَ عَ قَلَ يٍهٌسَقَتِ بّ، «عِ شَ سٌ فٍرٍ كُي مَنفّ دٌنمَ رَفٌرٌشِ عِ مَ.» عِسِرَيِلَ مَنفّ تَن نَشَ مَنفّ دُفِ بَ عَ مَ، عَ سْورِ دٌنمَ فبَنسَن نَفٌرٌ عَ مَ، عَ سِفَ فٍرٍ سٌدٍ. <verse eid="1KI 22:30"/><verse number="31" style="v" sid="1KI 22:31"/>عَرَ مِ مَنفّ نُ بَرَ عَ قَلَ عَ شَ سْورِ تٌنفٌ سَشَن نُن قِرِنيِ بّ، نَشٍيٍ قِندِشِ سْورِ رَفِسٍ شَ سْورِيٍ يَرٍرَتِيٍ رَ، «وٌ شَ كَتّ بِرِن نَبَ وٌ شَ عِسِرَيِلَ مَنفّ فبَنسَن نَن قٍن، وٌ عَ قَشَ.» <verse eid="1KI 22:31"/><verse number="32" style="v" sid="1KI 22:32"/>سْورِ رَفِسٍ شَ سْورِيٍ يَرٍرَتِيٍ تٌ يٍهٌسَقَتِ تٌ، عٍ نَشَ عَ مَحْشُن تّمُندٍ عِسِرَيِلَ مَنفّ نَن عَ رَ. عٍ نَشَ عٍ شُن تِ عَ رَ، عٍ شَ سَ عَ فٍرٍ. يٍهٌسَقَتِ نَشَ عَ مَلِمَيٍ شِلِ. <verse eid="1KI 22:32"/><verse number="33" style="v" sid="1KI 22:33"/>سْورِ رَفِسٍ شَ سْورِيٍ يَرٍرَتِيٍ نَشَ عَ كٌلٌن عِسِرَيِلَ مَنفّ شَ مُ عَ رَ، عٍ قَ فبِلٍن عَ قْشْ رَ.<verse eid="1KI 22:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="1KI 22:34"/>نَ تّمُي سْورِ ندٍ نَشَ شَلِ وٌلِ نَ كِ تُن. تَنبّ نَشَ سَ عِسِرَيِلَ مَنفّ سْشْ عَ كَنكٍ مَكَنتَسٍ لٍنبٍيٍ تَفِ. مَنفّ نَشَ عَ قَلَ عَ شَ سْورِ رَفِسٍ رَفِمَ بّ، «فِسٍ مَقِندِ، عِ شَ ﭑ نَمِنِ فٍرٍ قَرِ مَ، بَرِ مَ ﭑ بَرَ مَشْنْ.» <verse eid="1KI 22:34"/><verse number="35" style="v" sid="1KI 22:35"/>فٍرٍ نَشَ شْرْشْ نَ لْشْي كِ قَنيِ رَ. مَنفّ نُ تِشِ عَ شَ سْورِ رَفِسٍ كُي، عَ يَ رَقِندِشِ عَرَ مِكَيٍ مَ. عَ نَشَ قَشَ نَ نُنمَرٍ رَ، عَ وُلِ فبٍفبٍ نُ نَ عَ شَ سْورِ رَفِسٍ كُي. <verse eid="1KI 22:35"/><verse number="36" style="v" sid="1KI 22:36"/>سٌفٍ فٌرٌ تّمُي، يَامَرِ نَشَ قِ، «بِرِن شَ فبِلٍن عٍ شْنيِ، بِرِن شَ سِفَ عٍ شَ بْشِ مَ.»<verse eid="1KI 22:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="1KI 22:37"/>مَنفّ قَشَ نَ كِ نّ، عَ نَشَ رَفَتَ سَمَرِ تَا كُي. <verse eid="1KI 22:37"/><verse number="38" style="v" sid="1KI 22:38"/>عٍ تٌ مَنفّ شَ سْورِ رَفِسٍ كُي عِشَ سَمَرِ يٍ يِرٍ، بَرٍيٍ نَشَ عَكَبُ وُلِ مَكْن، لَنفٌي فِنّيٍ قَن نَشَ عٍ مَشَ نَا، عَلْ عَلَتَلَ عَ مَسٍن كِ نَشّ.<verse eid="1KI 22:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="1KI 22:39"/>عَكَبُ شَ تَرُشُي دْنشْي، نُن عَ قٍ نَشَن بِرِن نَبَ، نُن عَ بَنشِ تِشِ كِ نَشّ سِلِ حِنيِيٍ رَ، نُن عَ تَا نَشٍيٍ تِ، نَ بِرِن سّبّشِ عِسِرَيِلَ مَنفّيٍ شَ تَرُشُي كُي. <verse eid="1KI 22:39"/><verse number="40" style="v" sid="1KI 22:40"/>عَكَبُ نَشَ رَفَتَ عَ بٍنبَيٍ قّ مَ. عَ شَ دِ عَشَسِيَ نَشَ قِندِ مَنفّ رَ عَ حْشْي رَ.<verse eid="1KI 22:40"/></para>
  <para style="s">يٍهٌسَقَتِ قِندِقٍ يُدَيَ مَنفّ رَ</para>
  <para style="r">يُدَيَ مَنفّيٍ عِِ ٢٠‏؛٣١ ٬ ٢١‏؛١</para>
  <para style="p">
    <verse number="41" style="v" sid="1KI 22:41"/>عَسَ شَ دِ يٍهٌسَقَتِ قِندِ يُدَيَ مَنفّ رَ، عِسِرَيِلَ مَنفّ عَكَبُ شَ مَنفّيَ حّ نَانِ ندٍ نّ. <verse eid="1KI 22:41"/><verse number="42" style="v" sid="1KI 22:42"/>حّ تٌنفٌ سَشَن نُن سُولِ نُ نَ يٍهٌسَقَتِ بّ، عَ تٌ نُ قِندِ مَ مَنفّ رَ دَرِ سَلَمُ. عَ نفَ نُ نَ سِلِ شَ دِ عَسُبَ نَن نَ. <verse eid="1KI 22:42"/><verse number="43" style="v" sid="1KI 22:43"/>يٍهٌسَقَتِ نَشَ حّرّ عَ بَبَ عَسَ شَ كِرَ شْن مَ، عَ مُ عَ مَكُيَ عَلَتَلَ شَ كِرَ رَ. <verse eid="1KI 22:43"/><verse number="44" style="v" sid="1KI 22:44"/>كْنْ كُيٍ بَتُقٍ يِرٍ عِتٍشِيٍ مَ، نَ مُ دَن يُدَيَ بْشِ مَ. مِشِيٍ مُ تَفَن سّرّشّ بَقٍ رَ نَا، عَ نُن سُرَيِ فَنقٍ سّرّشّ رَ. <verse eid="1KI 22:44"/><verse number="45" style="v" sid="1KI 22:45"/>لَنيِ نُ نَ يٍهٌسَقَتِ نُن عِسِرَيِلَ مَنفّ تَفِ.<verse eid="1KI 22:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="1KI 22:46"/>يٍهٌسَقَتِ شَ تَرُشُي دْنشْي، نُن عَ شَ فٍرٍ كِ قَنيِ، نَ سّبّشِ يُدَيَ مَنفّيٍ شَ تَرُشُي كُي. <verse eid="1KI 22:46"/><verse number="47" style="v" sid="1KI 22:47"/>عَ نَشَ تْنيِ دْشْ لَنفٌي شَ وَلِ مَ كُيٍ بَتُدٍيٍ، نَشٍيٍ نُ نَ كَبِ عَ بَبَ عَسَ وَشَتِ. <verse eid="1KI 22:47"/><verse number="48" style="v" sid="1KI 22:48"/>مَنفّ نُ نَ عٍدٌن، يُدَيَ مَنفّ فٌمِنَ ندٍ نَن تِ نَا. <verse eid="1KI 22:48"/><verse number="49" style="v" sid="1KI 22:49"/>يٍهٌسَقَتِ نَشَ كُنكُييٍ يَءِلَن تَرَ سِسِ، عَلَكٌ عٍ شَ سِفَ شّيمَ قٍندٍ عٌقِرِ، كْنْ كُنكُييٍ نَشَ كَنَ عٍسِيٌن فٍبٍرِ. <verse eid="1KI 22:49"/><verse number="50" style="v" sid="1KI 22:50"/>نَ كُي عَكَبُ شَ دِ عَشَسِيَ نَشَ عَ قَلَ يٍهٌسَقَتِ بّ، «ﭑ مَ مِشِيٍ نُن عِ عِ شَ مِشِيٍ بِرِن شَ سِفَ نَ وَلِ رَبَدٍ كُنكُييٍ كُي.» كْنْ يٍهٌسَقَتِ مُ تِن نَ قٍ رَ. <verse eid="1KI 22:50"/><verse number="51" style="v" sid="1KI 22:51"/>يٍهٌسَقَتِ نَشَ بّلّ عَ بٍنبَيٍ قّ مَ، عَ رَفَتَ عَ بٍنبَ دَوُدَ شَ تَا كُي. عَ شَ دِ يٍهٌرَ مِ نَشَ تِ مَنفّ رَ عَ حْشْي رَ.<verse eid="1KI 22:51"/></para>
  <para style="s">عِسِرَيِلَ مَنفّ عَشَسِيَ</para>
  <para style="p">
    <verse number="52" style="v" sid="1KI 22:52"/>عَكَبُ شَ دِ عَشَسِيَ نَشَ قِندِ مَنفّ رَ سَمَرِ، عِسِرَيِلَ بْشِ شُن مَ، يُدَيَ مَنفّ يٍهٌسَقَتِ شَ مَنفّيَ حّ قُ نُن سٌلٌقٍرٍ ندٍ رَ. عَ بُ نّ مَنفّيَ كُي حّ قِرِن عِسِرَيِلَ شُن مَ. <verse eid="1KI 22:52"/><verse number="53" style="v" sid="1KI 22:53"/>عَ نَشَ قٍ رَبَ، نَشَن مُ رَقَن عَلَتَلَ مَ، عَ نَشَ عَ حّرّ عَ بَبَ نُن عَ نفَ شَ كِرَ شْن مَ. عَ نَشَ قٍ رَبَ عَلْ نٍبَتِ شَ دِ يٍرٌبٌوَ مِ، نَشَن عَ نِيَ عِسِرَيِلَ بِرِن شَ يُنُبِ رَبَ. <verse eid="1KI 22:53"/><verse number="54" style="v" sid="1KI 22:54"/>عَ نَشَ بَلِ كُيٍ بَتُ، عَ عَ شِنبِ سِن عَ بّ. نَ كُي عَ نَشَ عِسِرَيِلَ مَرِفِ عَلَتَلَ رَشْنْ، عَلْ عَ بَبَ عَ رَبَ كِ نَشّ.<verse eid="1KI 22:54"/></para>
  <chapter eid="1KI 22"/>
</usx>
