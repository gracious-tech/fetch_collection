<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="LAM" style="id"/>
  <para style="h">عَننَبِ يٍرٍ مِ قِرِن ندٍ</para>
  <para style="toc1">عَلَ شَ مَسٍنيِ قِرِن ندٍ عَننَبِ يٍرٍ مِ بّ</para>
  <para style="toc2">عَننَبِ يٍرٍ مِ قِرِن ندٍ</para>
  <para style="toc3">٢يٍ</para>
  <para style="mt">عَلَ شَ مَسٍنيِ قِرِن ندٍ عَننَبِ يٍرٍ مِ بّ</para>
  <para style="imt">مَسٍنيِ ندٍ يِ كِتَابُي شَ قٍ رَ</para>
  <para style="ip">عَننَبِ يٍرٍ مِ نَشَ كِتَابُي قِرِن سّبّ. كٍرٍن شِلِ «عَلَ شَ مَسٍنيِ عَننَبِ يٍرٍ مِ بّ.» بٌورٍ شِلِ، «عَلَ شَ مَسٍنيِ قِرِن ندٍ عَننَبِ يٍرٍ مِ بّ.» عٍ شَ مَسٍنيِ مَنِيَ. عٍ سّبّ وَشَتِ، عِسِرَيِلَ يَشُييٍ نُ نَ نْقٍ يُدَيَ نُن عَ شَ مَنفّ تَا دَرِ سَلَمُ رَ. عَلَتَلَ يَتِ نُ بَرَ نَ رَفِرِ عٍ شَ يُنُبِيٍ شَ قٍ رَ. نَ حَشَنكَتّ نُ شْرْشْ عَ فبٍ رَ بَرِ مَ عَ نُ قَتَنشِ عَلَ شَ شْنّ نَن نَ.</para>
  <para style="ip">نَ كُي وٌن نْمَ سّرِيّ سَشَن تٌدٍ. عَ سِنفٍ، يُنُبِ مُ رَقَن عَلَ مَ. عَلَ تٌ سّنِيّنشِ، عَ مُ نْمَ لَندٍ سّنِيّنتَرٍحَ مَ. قٌ عَدَ مَ شَ عَ قَهَامُ عَ يُنُبِ رَحَاشُ عَلَ مَ، بَرِ مَ عَ مُ قِندِشِ عَ يُفٍ سّنِيّنشِ رَ.</para>
  <para style="ip">عَ قِرِن ندٍ، عَلَ يُنُبِ سَرٍ رَفبِلٍنمَ نّ يُنُبِتْي مَ. عَلَ تٌ تِنشِنشِ، عَ مُ نْمَ عَ لُدٍ يُنُبِتْي مُ عَ شَ قٍ حَاشِ سَرٍ سْتْ. عَلَتَلَ شَ تِنشِنيِ عَ نِيَمَ نّ مِشِ شَ عٍ يُنُبِ سَرٍ سْتْ. عَلَ مُ نْمَ فبِلٍندٍ نَ تِنشِنيِ قْشْ رَ.</para>
  <para style="ip">عَ سَشَن ندٍ، عَلَ وَ مَ يُنُبِتْي رَكِسِقٍ. عَلَ تٌ مِشِ شَنُشِ، عَ قٍ بِرِن نَبَمَ نّ عَلَكٌ عَ شَ عَدَ مَ مَتِنشِن، عَ شَ عَ شَ يُنُبِيٍ شَقَرِ، عَ شَ عَ رَكِسِ عَ شَ شَنُنتٍيَ سَابُي رَ. يِ مَسٍنيِ، نَشَن تٌمَ عَننَبِ يٍرٍ مِ شَ سّبّلِ تَفِ سٌرَ ٣‏؛٢١ ٬ ٣٢، عَ سّنبّ فبٌ.</para>
  <para style="ip">عَلَ شَ وٌن مَلِ نَ سّرِيّ بِرِن قَهَامُدٍ. عَمِنَ.</para>
  <para style="imte">عَلَ شَ مَسٍنيِ قِرِن ندٍ عَننَبِ يٍرٍ مِ بّ</para>
  <chapter number="1" style="c" sid="LAM 1"/>
  <para style="s">دَرِ سَلَمُ شَ حْنيِ بّيتِ</para>
  <para style="sp">عَننَبِ يٍرٍ مِ شَ مَسٍنيِ</para>
  <para style="q">
    <verse number="1" style="v" sid="LAM 1:1"/>مُنسٍ دَرِ سَلَمُ سْتْشِ؟</para>
  <para style="q" vid="LAM 1:1">سِنفٍ مِشِ نُ وُيَ،</para>
  <para style="q" vid="LAM 1:1">كْنْ يَكْسِ عٍ مُ وُيَ.</para>
  <para style="q" vid="LAM 1:1">عَ بَرَ لُ عَلْ كَاحّ فِنّ.</para>
  <para style="q" vid="LAM 1:1">سِنفٍ عَ شِلِ نُ شُنفبٌ حَمَنّيٍ تَفِ،</para>
  <para style="q" vid="LAM 1:1">عَ قِندِ مَنفّ تَا نَن نَ عٍ يَ مَ،</para>
  <para style="q" vid="LAM 1:1">كْنْ يَكْسِ عَ نَ كٌنيِيَ كُي.<verse eid="LAM 1:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="LAM 1:2"/>كْي بِرِن عَ وَقٍ،</para>
  <para style="q" vid="LAM 1:2">عَ يَيٍ نُ عَ شّرّيٍ مَشَ.</para>
  <para style="q" vid="LAM 1:2">عَ شَنُنتٍنيِيٍ مُ نَ سْنْن نَشٍيٍ عَ مَدُندُ مَ.</para>
  <para style="q" vid="LAM 1:2">عَ بٌورٍيٍ بِرِن بَرَ عَ يَنقَ، عٍ قِندِ عَ يَشُييٍ رَ.<verse eid="LAM 1:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="LAM 1:3"/>عٍ بَرَ يُدَ بْنسْي شَنِن كٌنيِيَ كُي،</para>
  <para style="q" vid="LAM 1:3">عٍ عَ رَيَافِ.</para>
  <para style="q" vid="LAM 1:3">يَكْسِ عَ دْشْشِ سِيٍ تَفِ، مَلَبُي يٌ مُ نَ عَ بّ.</para>
  <para style="q" vid="LAM 1:3">عَ يَشُييٍ عَ تْورْ مَ.<verse eid="LAM 1:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="LAM 1:4"/>مِشِ يٌ مُ نَ سِيٌن كِرَيٍ شْن مَ سْنْن، سِفَقٍ سَلِدٍ.</para>
  <para style="q" vid="LAM 1:4">سِيٌن شَ نَادّيٍ بِرِن بَرَ كَنَ،</para>
  <para style="q" vid="LAM 1:4">عَ شَ سّرّشّدُبّيٍ تْورْقٍ،</para>
  <para style="q" vid="LAM 1:4">عَ شَ فِنّدِ مّدِيٍ سُننُنقٍ.</para>
  <para style="q" vid="LAM 1:4">سِيٌن نَ قٍ شْنّ نَن كُي.<verse eid="LAM 1:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="LAM 1:5"/>عَ يَشُييٍ بَرَ نْ عَ رَ، عٍ قَ لُ بْحّسَ كُي.</para>
  <para style="q" vid="LAM 1:5">عَلَتَلَ نَ رَفِرِشِ، سِيٌن شَ قٍ حَاشِيٍ نَن مَ قٍ رَ.</para>
  <para style="q" vid="LAM 1:5">عَ فٍرٍقَيٍ بَرَ عَ شَ دِيٍ شَنِن كٌنيِيَ كُي.<verse eid="LAM 1:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="LAM 1:6"/>سِيٌن سّنبّ بِرِن بَرَ كَنَ.</para>
  <para style="q" vid="LAM 1:6">عَ شَ كُنتِفِيٍ بَرَ لُ عَلْ شٍلِ،</para>
  <para style="q" vid="LAM 1:6">نَشٍيٍ مُ حٌوفٍ تٌمَ،</para>
  <para style="q" vid="LAM 1:6">نَشٍيٍ بَرَ تَفَن كٌيِنمَ يَ رَ.<verse eid="LAM 1:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="LAM 1:7"/>دَرِ سَلَمُ شَ يَافِ نُن عَ شَ كُي عِقُي كُي،</para>
  <para style="q" vid="LAM 1:7">عَ بَرَ عَ مَحْشُن عَ شَ سٍ قَنيِيٍ بِرِن شَ قٍ،</para>
  <para style="q" vid="LAM 1:7">نَشٍيٍ نُ نَ عَ يِ رَ تّمُي دَنفِشِ.</para>
  <para style="q" vid="LAM 1:7">عَ شَ حَمَ تٌ سَ عَ فٍرٍقَيٍ بّلّشّ،</para>
  <para style="q" vid="LAM 1:7">عَ مَلِمَ يٌ مُ نُ نَ.</para>
  <para style="q" vid="LAM 1:7">عَ يَشُييٍ نَشَ يٍلٍ عَ شَ كَسَرّ مَ.<verse eid="LAM 1:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="LAM 1:8"/>دَرِ سَلَمُ شَ يُنُبِ بَرَ فبٌ،</para>
  <para style="q" vid="LAM 1:8">عَ بَرَ قِندِ سّنِيّنتَرٍ رَ.</para>
  <para style="q" vid="LAM 1:8">نَشٍيٍ بِرِن نُ عَ مَتْشْمَ،</para>
  <para style="q" vid="LAM 1:8">عٍ نَ يٌقٍ عَ مَ يَكْسِ.</para>
  <para style="q" vid="LAM 1:8">عَ بَرَ لُ عَلْ مِشِ مَفٍلِ،</para>
  <para style="q" vid="LAM 1:8">عَ يَافِ، عَ قَ عَ يّتّ نْشُن.<verse eid="LAM 1:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="LAM 1:9"/>نْشْي نُ نَ عَ شَ دُفِ مَ،</para>
  <para style="q" vid="LAM 1:9">كْنْ عَ مُ عَ مَحْشُن عَ شَ قٍ رَحْنيِ مَ.</para>
  <para style="q" vid="LAM 1:9">كَسَرّ نَشَن عَ مَسْتْ، عَ مَفَاشُ.</para>
  <para style="q" vid="LAM 1:9">مِشِ يٌ مُ نَ، نَشَن عَ مَدُندُ مَ.</para>
  <para style="sp" vid="LAM 1:9">سِيٌن شَ مَسٍنيِ</para>
  <para style="q" vid="LAM 1:9">«عَلَتَلَ، ﭑ مَ مَرَيَافِ مَتٌ،</para>
  <para style="q" vid="LAM 1:9">بَرِ مَ ﭑ يَشُييٍ بَرَ شُننَكٍلِ سْتْ.»<verse eid="LAM 1:9"/></para>
  <para style="sp">عَننَبِ يٍرٍ مِ شَ مَسٍنيِ</para>
  <para style="q">
    <verse number="10" style="v" sid="LAM 1:10"/>عَ يَشُييٍ بَرَ عَ شَ سٍ قَنيِ بِرِن تٌنفٌ.</para>
  <para style="q" vid="LAM 1:10">عَ سِ فبّتّيٍ تٌ نّ سٌ رَ عَ شَ سَلِدٍ كُي،</para>
  <para style="q" vid="LAM 1:10">نَشٍيٍ مُ دَشَ عٍ شَ سٌ نَا.<verse eid="LAM 1:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="LAM 1:11"/>عَ شَ حَمَ بِرِن بَرَ كْنتْقِلِ بَلٌي قٍندٍ.</para>
  <para style="q" vid="LAM 1:11">عٍ بَرَ عٍ شَ نَاقُلِ بِرِن مَسَرَ دٌنسٍ رَ، عَلَكٌ عٍ شَ بَلٌ.</para>
  <para style="sp" vid="LAM 1:11">سِيٌن شَ مَسٍنيِ</para>
  <para style="q" vid="LAM 1:11">«عَلَتَلَ، ﭑ مَ يَافِ مَتٌ.<verse eid="LAM 1:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="LAM 1:12"/>عَلَ شَ دَنفِ مِشِ رَتَنفَ نَ قٍ مْولِ مَ.</para>
  <para style="q" vid="LAM 1:12">وٌ عَ مَتٌ شَ ﭑ مَ تْورّ مَنِيّ نَ قٍ رَ،</para>
  <para style="q" vid="LAM 1:12">عَلَتَلَ نَشَن دْشْشِ ﭑ مَ عَ شَ شْنّ كُي.<verse eid="LAM 1:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="LAM 1:13"/>عَ بَرَ تّ رَفٌرٌ كٍلِقٍ كٌورٍ، نَشَن بَرَ ﭑ قَتٍ فَن.</para>
  <para style="q" vid="LAM 1:13">عَ بَرَ فَنتَنيِ تِ ﭑ بّ، عَ يّلّ عِتَلَ ﭑ سَنتِدٍ.</para>
  <para style="q" vid="LAM 1:13">عَ بَرَ ﭑ نَبِرَ بْشِ، عَ ﭑ هَلَكِشِ لُ نَا.<verse eid="LAM 1:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="LAM 1:14"/>عَ بَرَ ﭑ مَ يُنُبِيٍ سَرٍ سَ ﭑ كْن مَ عَلْ كَرَقٌي.</para>
  <para style="q" vid="LAM 1:14">عَ بَرَ ﭑ سّنبّ شُن نَكَنَ.</para>
  <para style="q" vid="LAM 1:14">عَلَتَلَ بَرَ ﭑ سَ ﭑ يَشُييٍ بّلّشّ، نَشٍيٍ سّنبّ فبٌ ﭑ بّ.<verse eid="LAM 1:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="LAM 1:15"/>عَ بَرَ ﭑ مَ فٍرٍ سٌي بِرِن مَتُتُن، نَشٍيٍ نُ نَ ﭑ بّ.</para>
  <para style="q" vid="LAM 1:15">عَ بَرَ ﭑ يَشُييٍ مَشِلِ،</para>
  <para style="q" vid="LAM 1:15">عَلَكٌ عٍ شَ ﭑ مَ قٌنِكٍيٍ سّنبّ كَنَ.</para>
  <para style="q" vid="LAM 1:15">عَلَتَلَ بَرَ يُدَ بْنسْي شَ دِ هَلَكِ عَ حَاشِ رَ.<verse eid="LAM 1:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="LAM 1:16"/>ﭑ نَ وَقٍ يِ تْورّ نَن مَ، ﭑ يَيٍ رَ مِنِمَ عٍ بّ.</para>
  <para style="q" vid="LAM 1:16">نَشَن ﭑ مَدُندُ مَ، عَ فبِلٍن لِمَنِيَ قِ رَ ﭑ مَ.</para>
  <para style="q" vid="LAM 1:16">نَ بَرَ مَكُيَ ﭑ نَ.</para>
  <para style="q" vid="LAM 1:16">ﭑ مَ دِيٍ بَرَ هَلَكِ،</para>
  <para style="q" vid="LAM 1:16">بَرِ مَ يَشُي سّنبّ نُ فبٌ ﭑ بّ.<verse eid="LAM 1:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="LAM 1:17"/>سِيٌن بَرَ عَ بّلّشّيٍ عِتَلَ،</para>
  <para style="q" vid="LAM 1:17">كْنْ مِشِ يٌ مُ نَ نَشَن عَ مَدُندُ مَ.</para>
  <para style="q" vid="LAM 1:17">عَلَتَلَ بَرَ يَامَرِ قِ يَشُبَ دْشْبٌورٍيٍ شَ قِندِ عَ فٍرٍقَيٍ رَ.</para>
  <para style="q" vid="LAM 1:17">دَرِ سَلَمُ بَرَ قِندِ سّنِيّنتَرٍ رَ عٍ تَفِ.<verse eid="LAM 1:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="LAM 1:18"/>عَلَتَلَ شَ مَرَفِرِ تِنشِن،</para>
  <para style="q" vid="LAM 1:18">بَرِ مَ ﭑ بَرَ عَ شَ يَامَرِيٍ مَتَندِ.</para>
  <para style="q" vid="LAM 1:18">وٌ تَن سِ بِرِن، وٌ وٌ تُلِ مَتِ،</para>
  <para style="q" vid="LAM 1:18">وٌ شَ ﭑ مَ تْورّ مَتٌ.</para>
  <para style="q" vid="LAM 1:18">ﭑ مَ فِنّدِ مّدِيٍ نُن ﭑ مَ قٌنِكٍ شّمّيٍ بِرِن بَرَ شَنِن كٌنيِيَ كُي.<verse eid="LAM 1:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="LAM 1:19"/>ﭑ بَرَ ﭑ شَنُنتٍنيِيٍ شِلِ، كْنْ عٍ بَرَ ﭑ يَنقَ.</para>
  <para style="q" vid="LAM 1:19">ﭑ مَ سّرّشّدُبّيٍ نُن ﭑ مَ قٌرِيٍ بَرَ قَشَ تَا كُي.</para>
  <para style="q" vid="LAM 1:19">عٍ قَشِ دٌنسٍ قٍندٍ نَشَن نْمَ سّنبّ دِ قِدٍ عٍ مَ.<verse eid="LAM 1:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="LAM 1:20"/>عَلَتَلَ، ﭑ مَ تْورّ مَتٌ.</para>
  <para style="q" vid="LAM 1:20">ﭑ بْحّ مُ رَقَنشِ ﭑ مَ،</para>
  <para style="q" vid="LAM 1:20">بَرِ مَ ﭑ عَ كٌلٌن ﭑ مّي نّ عِ شَ سّرِيّ رَ،</para>
  <para style="q" vid="LAM 1:20">ﭑ قِندِ مَتَندِلَ يَتِ نَن نَ.</para>
  <para style="q" vid="LAM 1:20">سَنتِدّفّمَ مِشِ سْنتْ تَا قَرِ مَ،</para>
  <para style="q" vid="LAM 1:20">قُرٍ حَاشِ مِشِ قَشَمَ تَا كُي.<verse eid="LAM 1:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="LAM 1:21"/>مِشِيٍ بَرَ ﭑ وَ شُي مّ،</para>
  <para style="q" vid="LAM 1:21">كْنْ مِشِ يٌ مُ نَ نَشَن ﭑ مَدُندُ مَ.</para>
  <para style="q" vid="LAM 1:21">ﭑ يَشُييٍ بِرِن بَرَ ﭑ مَ تْورّ شَ قٍ مّ،</para>
  <para style="q" vid="LAM 1:21">عٍ بَرَ حّلّشِن عِ بّلّشّ قْشِ رَ.</para>
  <para style="q" vid="LAM 1:21">عِ بَرَ قَ لْشْي رَ، عِ لْشْي نَشَن مَ قٍ قَلَ.</para>
  <para style="q" vid="LAM 1:21">عَ نِيَ ﭑ يَشُييٍ قَن شَ لُ عَلْ ﭑ تَن.<verse eid="LAM 1:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="LAM 1:22"/>عِ شَ عٍ شَ حَاشُحَ بِرِن مَتٌ.</para>
  <para style="q" vid="LAM 1:22">عِ شَ عَ نِيَ عٍ قَن نَ عَلْ عِ عَ نِيَشِ ﭑ نَ كِ نَشّ،</para>
  <para style="q" vid="LAM 1:22">ﭑ مَ قٍ كٌبِ رَبَشِ مَ.</para>
  <para style="q" vid="LAM 1:22">ﭑ مَ كْنتْقِلِ وُيَ، ﭑ بْحّ تْورْشِ عَ فبٍ رَ.»<verse eid="LAM 1:22"/></para>
  <chapter eid="LAM 1"/>
  <chapter number="2" style="c" sid="LAM 2"/>
  <para style="s">هْرْ مْبَنشِ شَ كَنّ</para>
  <para style="sp">عَننَبِ يٍرٍ مِ شَ مَسٍنيِ</para>
  <para style="q">
    <verse number="1" style="v" sid="LAM 2:1"/>عَلَتَلَ شَ شْنّ بَرَ عَ نِيَ</para>
  <para style="q" vid="LAM 2:1">كُيٍ شَ عِقْورْ دَرِ سَلَمُ شُن مَ.</para>
  <para style="q" vid="LAM 2:1">عَ بَرَ بَرَكّ بَ عِسِرَيِلَ مَ.</para>
  <para style="q" vid="LAM 2:1">عَ تٌ شْنْ، عَ نَشَ عِسِرَيِلَ رَبٌلٌ،</para>
  <para style="q" vid="LAM 2:1">عَ نُ حّرّ مَ حَمَ نَشَن يَ مَ.<verse eid="LAM 2:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="LAM 2:2"/>مَرِفِ مُ كِنِكِنِ عٍ مَ.</para>
  <para style="q" vid="LAM 2:2">عَ بَرَ يَشُبَ شَ بَنشِ بِرِن كَنَ،</para>
  <para style="q" vid="LAM 2:2">عَ بَرَ يُدَيَ تَا مَكَنتَشِيٍ رَبِرَ،</para>
  <para style="q" vid="LAM 2:2">عَ عٍ شَ مَنفّيَ مَسَرَ يَافِ رَ عَ شَ شْنّ كُي.<verse eid="LAM 2:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="LAM 2:3"/>عَ تٌ شْنْ عٍ مَ، عَ بَرَ عِسِرَيِلَ سّنبّ بِرِن كَنَ.</para>
  <para style="q" vid="LAM 2:3">عٍ يَشُييٍ تٌ نُ عٍ عِشّتّنقٍ،</para>
  <para style="q" vid="LAM 2:3">عَلَ بَرَ تٌندِ عِسِرَيِلَ مَلِدٍ.</para>
  <para style="q" vid="LAM 2:3">نَ شُننَكَنّ بَرَ لُ عَلْ تّ سٌشِ،</para>
  <para style="q" vid="LAM 2:3">عَ يَشُبَ شَ بْشِ بِرِن فَن.<verse eid="LAM 2:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="LAM 2:4"/>عَ بَرَ عَ شَ شَلِ سُشُ وٌن شِلِ مَ</para>
  <para style="q" vid="LAM 2:4">عَلْ وٌن يَشُي عَ رَبَمَ كِ نَشّ.</para>
  <para style="q" vid="LAM 2:4">عَ بَرَ وٌن بْنبْ سّنبّ رَ</para>
  <para style="q" vid="LAM 2:4">عَلْ عَ قِندِ وٌن فٍرٍقَ نَن نَ.</para>
  <para style="q" vid="LAM 2:4">عَ بَرَ وٌن مَ مِشِ بِرِن قَشَ،</para>
  <para style="q" vid="LAM 2:4">وٌن نُ حّلّشِنمَ نَشٍيٍ رَ.</para>
  <para style="q" vid="LAM 2:4">عَ شَ شْنّ بَرَ لُ عَلْ تّ</para>
  <para style="q" vid="LAM 2:4">نَشَن بَرَ سٌ دَرِ سَلَمُ هْرْ مْبَنشِ كُي.<verse eid="LAM 2:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="LAM 2:5"/>عَلَتَلَ بَرَ لُ عَلْ وٌن يَشُي.</para>
  <para style="q" vid="LAM 2:5">عَ بَرَ عِسِرَيِلَ نُن عَ شَ بَنشِ قَنيِيٍ بِرِن كَنَ.</para>
  <para style="q" vid="LAM 2:5">عَ بَرَ عَ شَ يِرٍ مَكَنتَشِيٍ رَبِرَ.</para>
  <para style="q" vid="LAM 2:5">عَ بَرَ يُدَيَ شَ كِنِكِنِ نُن سُننُنيِ شُنمَسَ.<verse eid="LAM 2:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="LAM 2:6"/>عَ بَرَ عَ سّنبّ رَ مِنِ نَ مَ،</para>
  <para style="q" vid="LAM 2:6">عَ عَ شَ مِشِيٍ مَلَندٍ كَنَ.</para>
  <para style="q" vid="LAM 2:6">عَلَتَلَ بَرَ عَ نِيَ</para>
  <para style="q" vid="LAM 2:6">سَلِ شُنفبٍ نُن مَلَبُي لْشْي سَلِ شَ نّيمُ سِيٌن نَ.</para>
  <para style="q" vid="LAM 2:6">عَ بَرَ مَنفّ نُن سّرّشّدُبّ رَيَافِ عَ شَ شْنّ كُي.<verse eid="LAM 2:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="LAM 2:7"/>عَلَتَلَ بَرَ مَكُيَ عَ شَ سّرّشّبَدٍ رَ،</para>
  <para style="q" vid="LAM 2:7">عَ مّي عَ شَ يِرٍ سّنِيّنشِ رَ.</para>
  <para style="q" vid="LAM 2:7">عَ بَرَ سِيٌن بَنشِ قَنيِيٍ سَ وٌن يَشُي بّلّشّ.</para>
  <para style="q" vid="LAM 2:7">وٌن يَشُييٍ بَرَ فٍرٍ سْنشْي رَتٍ عَلَتَلَ شَ بَنشِ كُي.</para>
  <para style="q" vid="LAM 2:7">نَ شُي نُ فبٌ عَلْ شُي نَشَن عِتٍمَ سَلِ لْشْي.<verse eid="LAM 2:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="LAM 2:8"/>عَلَتَلَ نَن عَ حَنِفٍ عَ شَ سِيٌن تّتّ رَبِرَ.</para>
  <para style="q" vid="LAM 2:8">عَ مُ سِيكّ عَ رَبَقٍ مَ.</para>
  <para style="q" vid="LAM 2:8">عَ بَرَ تّتّ قَرِ نُن عَ بُنيِ بِرِن نَبِرَ.<verse eid="LAM 2:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="LAM 2:9"/>عَ بَرَ تَا نَادّيٍ رَبِرَ بْشِ،</para>
  <para style="q" vid="LAM 2:9">عٍ بَلَندٍيٍ بِرِن بَرَ كَنَ.</para>
  <para style="q" vid="LAM 2:9">مَنفّيٍ نُن كُنتِفِيٍ بَرَ شَنِن حَمَنّ فبّتّ مَ.</para>
  <para style="q" vid="LAM 2:9">سّرِيّ رَبَتُقٍ مُ نَ،</para>
  <para style="q" vid="LAM 2:9">شّيرَيَ قَن مُ نَ نَمِحْنمّيٍ بّ.<verse eid="LAM 2:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="LAM 2:10"/>سِيٌن قٌرِيٍ دْشْشِ بْشِ، عٍ دّ بَرَ بٌبٌ،</para>
  <para style="q" vid="LAM 2:10">عٍ بَرَ شُبٍ مَسٌ عٍ شُنيِيٍ مَ سُننُنيِ شَ قٍ رَ،</para>
  <para style="q" vid="LAM 2:10">عٍ بَرَ سُننُن دٌنمَيٍ رَفٌرٌ عٍ مَ.</para>
  <para style="q" vid="LAM 2:10">دَرِ سَلَمُ فِنّدِ مّدِيٍ بَرَ عٍ شُن سِن بْشِ.<verse eid="LAM 2:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="LAM 2:11"/>ﭑ يَيٍ بَرَ مِنِ هَن، ﭑ بْحّ بَرَ ﭑ تْورْ،</para>
  <para style="q" vid="LAM 2:11">ﭑ سٌندٌنيِ بَرَ سُننُن ﭑ مَ حَمَ شَ فبَلٌي شَ قٍ رَ.</para>
  <para style="q" vid="LAM 2:11">دِ مّيٍ نُن دِيْرّيٍ نَ قَشَقٍ تَا كُي.<verse eid="LAM 2:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="LAM 2:12"/>دِ مّيٍ عَ قَلَمَ عٍ نفَيٍ بّ،</para>
  <para style="q" vid="LAM 2:12">«دٌنسٍ نُن مِنسٍ سْتْمَ مِندٍن؟»</para>
  <para style="q" vid="LAM 2:12">عٍ نُ سِفَ تُشُنسَن نَ عَلْ مِشِ مَشْنْشِيٍ،</para>
  <para style="q" vid="LAM 2:12">عٍ بِرَ تَا كُي كِرَيٍ رَ،</para>
  <para style="q" vid="LAM 2:12">عٍ حّنفِ بٌلٌن عٍ نفَيٍ بّلّشّ.<verse eid="LAM 2:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="LAM 2:13"/>ﭑ قَ مُنسٍ قَلَمَ عِ بّ كْرّ؟</para>
  <para style="q" vid="LAM 2:13">سِيٌن، عِ مَنِيّ مُ نَ ﭑ بّ.</para>
  <para style="q" vid="LAM 2:13">ﭑ عِ مَدُندُ مَ دِ؟</para>
  <para style="q" vid="LAM 2:13">عِ شَ حَشَنكَتّ بَرَ فبٌ دَنفِ بَا رَ.</para>
  <para style="q" vid="LAM 2:13">ندٍ نْمَ عِ رَيَلَندٍ؟<verse eid="LAM 2:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="LAM 2:14"/>عِ شَ نَمِحْنمّيٍ بَرَ وُلٍ لَامَتُنيِيٍ مَسٍن،</para>
  <para style="q" vid="LAM 2:14">عٍ مُ عِ شَ يُنُبِ قِيشّ عِ بّ،</para>
  <para style="q" vid="LAM 2:14">عَلَكٌ عِ نَشَ قَ لُ كٌنيِيَ كُي.</para>
  <para style="q" vid="LAM 2:14">عٍ بَرَ وٌ مَدَشُ وُلٍ لَامَتُنيِيٍ رَ.<verse eid="LAM 2:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="LAM 2:15"/>دَنفِ مِشِ بِرِن عٍ بّلّشّ بْنبْمَ عِ مَ،</para>
  <para style="q" vid="LAM 2:15">عٍ كٌلِنمَ، عٍ عٍ شُنيِيٍ مَلِنتَنمَ دَرِ سَلَمُ شَ قٍ رَ.</para>
  <para style="q" vid="LAM 2:15">عٍ عَ قَلَمَ، «سِنفٍ يِ تَا تٌقَنيِ مَنِيّ مُ نُ نَ دُنِحَ،</para>
  <para style="q" vid="LAM 2:15">كْنْ يَكْسِ فٌ؟»<verse eid="LAM 2:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="LAM 2:16"/>عِ يَشُييٍ بِرِن نَ وٌ مَقَلَقٍ،</para>
  <para style="q" vid="LAM 2:16">عٍ كٌلِنمَ، عٍ عٍ حِنيِيٍ مَشِنمَ وٌ شَ قٍ رَ،</para>
  <para style="q" vid="LAM 2:16">عٍ نُ عَ قَلَ، «وٌن بَرَ عٍ شُن نَكَنَ</para>
  <para style="q" vid="LAM 2:16">عَلْ وٌن نُ وَ مَ عَ شْن مَ كِ نَشّ.</para>
  <para style="q" vid="LAM 2:16">نَ بَرَ سْونّيَ وٌن بّ.»<verse eid="LAM 2:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="LAM 2:17"/>عَلَتَلَ نَشَن حَنِفٍ، عَ نَ نَن نَبَشِ.</para>
  <para style="q" vid="LAM 2:17">عَ بَرَ عَ شَ وْيّنيِ رَكَمَلِ،</para>
  <para style="q" vid="LAM 2:17">عَ نَشَن مَسٍن تّمُي شْننَكُيٍ.</para>
  <para style="q" vid="LAM 2:17">عَ بَرَ كَنَرِ رَبَ، عَ مُ كِنِكِنِ.</para>
  <para style="q" vid="LAM 2:17">عَ بَرَ عَ نِيَ عِ يَشُييٍ شَ عِ مَيٍلٍ.</para>
  <para style="q" vid="LAM 2:17">عَ بَرَ عِ فٍرٍقَيٍ سّنبّ رَفبٌ يّ.<verse eid="LAM 2:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="LAM 2:18"/>مِشِيٍ نَ وَقٍ مَرِفِ رَ عٍ بْحّ بِرِن نَ.</para>
  <para style="q" vid="LAM 2:18">سِيٌن حَمَ، يَيٍ رَ مِنِ عَلْ شُرٍ.</para>
  <para style="q" vid="LAM 2:18">عِ نَشَ عِ مَلَبُ، عِ شَ وَ تُن.<verse eid="LAM 2:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="LAM 2:19"/>كٍلِ، سْنشْي رَتٍ كْي رَ.</para>
  <para style="q" vid="LAM 2:19">عِ بْحّ رَيٍنسٍن يّ عَلْ يٍ، مَرِفِ يَ تٌدٍ رَ.</para>
  <para style="q" vid="LAM 2:19">عِ بّلّشّ تِ عَ بّ عِ شَ دِيٍ شَ سِمَيَ شَ قٍ رَ،</para>
  <para style="q" vid="LAM 2:19">بَرِ مَ عٍ نَ هَلَكِقٍ كَامّ رَ تُنشُنيِيٍ بِرِن نَ.<verse eid="LAM 2:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="LAM 2:20"/>عَلَتَلَ، عِ يَ تِ عِ بَرَ يِ نِيَ نَشٍيٍ رَ.</para>
  <para style="q" vid="LAM 2:20">عَ لَن فِنّيٍ شَ عٍ شَ دِيٍ دٌن، عٍ نَشٍيٍ بَرِ؟</para>
  <para style="q" vid="LAM 2:20">عَ لَن سّرّشّدُبّيٍ نُن نَمِحْنمّيٍ شَ قَشَ مَرِفِ شَ هْرْ مْبَنشِ كُي؟<verse eid="LAM 2:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="LAM 2:21"/>قٌنِكٍيٍ نُن شّمْشِيٍ، عٍ بِرِن لَنتَنشِ بْشِ مَ تَا تُنشُنيِيٍ رَ.</para>
  <para style="q" vid="LAM 2:21">ﭑ مَ فِنّدِ مّدِيٍ نُن ﭑ مَ سّفّتَلَيٍ، سَنتِدّفّمَ بَرَ عٍ بِرِن قَشَ.</para>
  <para style="q" vid="LAM 2:21">عِ بَرَ قَشّ تِ عِ شْنْ لْشْي.</para>
  <para style="q" vid="LAM 2:21">عِ بَرَ عٍ كْن نَشَبَ، عِ مُ كِنِكِنِ.<verse eid="LAM 2:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="LAM 2:22"/>عِ بَرَ ﭑ يَشُييٍ مَلَن ﭑ شِلِ مَ،</para>
  <para style="q" vid="LAM 2:22">عَلْ مِشِيٍ مَلَنمَ كِ نَشّ سَلِ لْشْي.</para>
  <para style="q" vid="LAM 2:22">عَلَتَلَ شْنْ لْشْي، مِشِ يٌ مُ لُ، مِشِ قَن مُ عَ عِمِنِ.</para>
  <para style="q" vid="LAM 2:22">ﭑ نَشٍيٍ شَنُ، ﭑ نَشٍيٍ رَ مْ،</para>
  <para style="q" vid="LAM 2:22">ﭑ يَشُييٍ بَرَ عٍ بِرِن قَشَ.<verse eid="LAM 2:22"/></para>
  <chapter eid="LAM 2"/>
  <chapter number="3" style="c" sid="LAM 3"/>
  <para style="s">تْورّ نُن عَلَ شَ مَرَقَنيِ</para>
  <para style="sp">عَننَبِ يٍرٍ مِ شَ مَسٍنيِ</para>
  <para style="q">
    <verse number="1" style="v" sid="LAM 3:1"/>مِشِ نَن ﭑ نَ، نَشَن بَرَ تْورّ كٌلٌن عَلَ شَ شْنّ سَابُي رَ.<verse eid="LAM 3:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="LAM 3:2"/>عَ بَرَ ﭑ تٌنفٌ كُيٍ عِيَلَنشِ،</para>
  <para style="q" vid="LAM 3:2">عَ ﭑ نَحّرّ دِ مِ كُي.<verse eid="LAM 3:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="LAM 3:3"/>عَ ﭑ تْورْ مَ لْشْي بِرِن.</para>
  <para style="q" vid="LAM 3:3">دَنيِ يٌ مُ نَ ﭑ مَ تْورّ مَ<verse eid="LAM 3:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="LAM 3:4"/>عَ بَرَ ﭑ نَشْسِ كٍلِقٍ ﭑ شُنيِ مَ سَ دْشْقٍ ﭑ سَنيِيٍ رَ.</para>
  <para style="q" vid="LAM 3:4">عَ بَرَ ﭑ شْرِيٍ بِرِن مَفِرَ.<verse eid="LAM 3:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="LAM 3:5"/>عَ بَرَ ﭑ تْورْ، عَ ﭑ نَبِلِن حَشَنكَتّ رَ.<verse eid="LAM 3:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="LAM 3:6"/>عَ بَرَ ﭑ لُ دِ مِ كُي عَلْ سِنفٍ رَ مِشِ قَشَشِيٍ.<verse eid="LAM 3:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="LAM 3:7"/>عَ بَرَ ﭑ نَبِلِن سَنسَنيِ رَ،</para>
  <para style="q" vid="LAM 3:7">عَ يْلْنشْنيِ سَ ﭑ مَ، عَلَكٌ ﭑ نَشَ قَ مِنِ.<verse eid="LAM 3:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="LAM 3:8"/>ﭑ بَرَ فبٍلٍفبٍلٍ، ﭑ بَرَ شِلِ تِ دّ مّرِ رَ،</para>
  <para style="q" vid="LAM 3:8">كْنْ عَ بَرَ نَادّ بَلَن ﭑ مَ مَشَندِ مَ.<verse eid="LAM 3:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="LAM 3:9"/>عَ بَرَ كِرَ بَلَن ﭑ يَ رَ فّمّ بٍلٍبٍلٍيٍ رَ،</para>
  <para style="q" vid="LAM 3:9">عَ ﭑ تِ تْورّ كِرَ شْن مَ.<verse eid="LAM 3:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="LAM 3:10"/>عَ بَرَ لُ عَلْ سُبٍ شَاحّ نَشَن ﭑ مَمّقٍ بُرُنيِ،</para>
  <para style="q" vid="LAM 3:10">عَلْ يّتّ نَشَن عَ نْشُنشِ ﭑ يَ رَ.<verse eid="LAM 3:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="LAM 3:11"/>عَ بَرَ دُنِحَ عِشُتُ ﭑ مَ، عَ بَرَ ﭑ كَنَ.<verse eid="LAM 3:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="LAM 3:12"/>عَ بَرَ عَ شَ شَلِ عِتَلَ عَ عَ شَ تَنبّيٍ تِ ﭑ نَ.<verse eid="LAM 3:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="LAM 3:13"/>عَ تٌ عَ شَ تَنبّيٍ بّحِن، عٍ نَشَ ﭑ بْحّ سْشْ.<verse eid="LAM 3:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="LAM 3:14"/>ﭑ بَرَ قِندِ ﭑ مَ مِشِ بِرِن مَ مَيٍلٍ سٍ رَ،</para>
  <para style="q" vid="LAM 3:14">لْشْي بِرِن، عٍ ﭑ قِندِ مَ عٍ شَ سِفِيٍ رَ.<verse eid="LAM 3:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="LAM 3:15"/>عَ بَرَ ﭑ نَلُفَ حٌوفٍ شْنّ رَ،</para>
  <para style="q" vid="LAM 3:15">عَ بَرَ شْنّ قِندِ ﭑ مَ دٌنسٍ رَ.<verse eid="LAM 3:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="LAM 3:16"/>عَ بَرَ عَ نِيَ ﭑ شَ فّمّ شْرِيٍ مَشِن،</para>
  <para style="q" vid="LAM 3:16">هَن ﭑ حِنيِيٍ بِرِن بَرَ مَفِرَ.</para>
  <para style="q" vid="LAM 3:16">عَ بَرَ ﭑ مَبٌرٌن شُبٍ شْورَ.<verse eid="LAM 3:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="LAM 3:17"/>عَ بَرَ بْحّسَ مَكُيَ ﭑ نَ</para>
  <para style="q" vid="LAM 3:17">هَن قٍ قَنيِ مْولِ بِرِن بَرَ نّيمُ ﭑ نَ.<verse eid="LAM 3:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="LAM 3:18"/>نَ نَن عَ تٌشِ ﭑ بَرَ عَ قَلَ،</para>
  <para style="q" vid="LAM 3:18">«ﭑ مَ قٍ بَرَ كَنَ.</para>
  <para style="q" vid="LAM 3:18">عَلَتَلَ بَرَ ﭑ كُمَ سٍ بِرِن نَ ﭑ شَشِلِ نُ تِشِ نَشٍيٍ رَ.»<verse eid="LAM 3:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="LAM 3:19"/>ﭑ بَرَ ﭑ مَحْشُن ﭑ مَ مَرَيَافِ مَ،</para>
  <para style="q" vid="LAM 3:19">ﭑ بَرَ ﭑ مَحْشُن ﭑ مَ سِمَيَ نَشَسِشِ مَ.<verse eid="LAM 3:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="LAM 3:20"/>ﭑ مُ نْمَ نّيمُدٍ ﭑ مَ تْورّ مَ.</para>
  <para style="q" vid="LAM 3:20">عَ شُن بَرَ مَسَ هَن عَ بَرَ فّ ﭑ كُنتِندٍ.<verse eid="LAM 3:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="LAM 3:21"/>كْنْ نَ بِرِن كُي، ﭑ نَن ﭑ شَشِلِ تِمَ قٍ نَشَن نَ، عَ تَن نَن يَ؛<verse eid="LAM 3:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="LAM 3:22"/>عَلَتَلَ شَ هِننّ مُ حْنمَ،</para>
  <para style="q" vid="LAM 3:22">دَنيِ يٌ مُ نَ عَ شَ شَنُنتٍيَ مَ.<verse eid="LAM 3:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="LAM 3:23"/>عَ فبِلٍنمَ عَ رَ فّيسّفّ يٌ فّيسّفّ.</para>
  <para style="q" vid="LAM 3:23">«عَلَتَلَ، عِ مُ مّيمَ عِ شَ مِشِيٍ رَ عَبَدَن!»<verse eid="LAM 3:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="LAM 3:24"/>ﭑ عَ كٌلٌن ﭑ بْحّ كُي،</para>
  <para style="q" vid="LAM 3:24">عَلَتَلَ نَن نَ ﭑ هَرِفٍ رَ.</para>
  <para style="q" vid="LAM 3:24">ﭑ شَشِلِ تِشِ عَ تَن نَن نَ.<verse eid="LAM 3:24"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="25" style="v" sid="LAM 3:25"/>عَلَتَلَ قٍ قَنيِ رَبَمَ عَ قٍنمَ بّ،</para>
  <para style="q" vid="LAM 3:25">نَشَن شَشِلِ تِشِ عَ رَ.<verse eid="LAM 3:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="LAM 3:26"/>مِشِ لَن عَ شَ سَبَرِ عَلَتَلَ يَ عِ نَشَن قَمَ عَ رَكِسِدٍ.<verse eid="LAM 3:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="LAM 3:27"/>عَ لَنمَ عَدَ مَ شَ تْورّ كٌلٌن عَ قٌنِكٍ تّمُي.<verse eid="LAM 3:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="LAM 3:28"/>عَ شَ دُندُ، عَ شَ دْشْ عَ شَتِ مَ،</para>
  <para style="q" vid="LAM 3:28">بَرِ مَ عَلَتَلَ نَن عَ رَفِرِشِ عَ مَ.<verse eid="LAM 3:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="LAM 3:29"/>عَ شَ عَ شُن سِن بْشِ، تّمُندٍ عَلَ قَمَ نّ عَ شَ دُبّ سُشُدٍ.<verse eid="LAM 3:29"/></para>
  <para style="q">
    <verse number="30" style="v" sid="LAM 3:30"/>عَ شَ عَ شّرّ تِ مِشِ بّ، نَشَن عَ رَفَرِنمَ،</para>
  <para style="q" vid="LAM 3:30">عَ شَ تِن نَ يَافِ رَ.<verse eid="LAM 3:30"/></para>
  <para style="q">
    <verse number="31" style="v" sid="LAM 3:31"/>مَرِفِ مُ مِشِ رَتُتُنمَ عَبَدَن.<verse eid="LAM 3:31"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="32" style="v" sid="LAM 3:32"/>عَ نَ مِشِ ندٍ تْورْ، عَ مَن قَمَ نّ هِننّدٍ عَ رَ عَ شَ قٌنِسِرٍيَ كُي.<verse eid="LAM 3:32"/></para>
  <para style="q">
    <verse number="33" style="v" sid="LAM 3:33"/>عَ وَشْنقٍ شَ مُ عَ رَ،</para>
  <para style="q" vid="LAM 3:33">عَ شَ مِشِ رَيَافِ، عَ شَ عِبُنَدَ مَ تْورْ.<verse eid="LAM 3:33"/></para>
  <para style="q">
    <verse number="34" style="v" sid="LAM 3:34"/>مِشِ نَ فٍيلِمَنِيٍ تْورْ عَ حَاشِ رَ بْشِ كُي،<verse eid="LAM 3:34"/></para>
  <para style="q">
    <verse number="35" style="v" sid="LAM 3:35"/>عٍ نَ تِنشِنتَرٍيَ رَبَ مِشِ رَ عَلَ شُنفبٍ يَ عِ،<verse eid="LAM 3:35"/></para>
  <para style="q">
    <verse number="36" style="v" sid="LAM 3:36"/>عٍ نَ مِشِ تْوحّفّ عَ مَكِيتِ تّمُي،</para>
  <para style="q" vid="LAM 3:36">عَلَتَلَ مُ عَ بِرِن تٌمَ شّ؟<verse eid="LAM 3:36"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="37" style="v" sid="LAM 3:37"/>ندٍ نْمَ قٍ رَ، شَ عَلَ شَ مُ عَ رَفِرِشِ؟<verse eid="LAM 3:37"/></para>
  <para style="q">
    <verse number="38" style="v" sid="LAM 3:38"/>قٍ قَنيِ نُن قٍ حَاشِ، عَ بِرِن مُ كٍلِمَ عَلَ شُنفبٍ شُي شَ مَ؟<verse eid="LAM 3:38"/></para>
  <para style="q">
    <verse number="39" style="v" sid="LAM 3:39"/>مُنقٍ رَ عِبُنَدَ مَ عَ مَوَ مَ،</para>
  <para style="q" vid="LAM 3:39">شَ عَ تْورّ سْتْ عَ يّتّ شَ يُنُبِ سَابُي رَ؟<verse eid="LAM 3:39"/></para>
  <para style="q">
    <verse number="40" style="v" sid="LAM 3:40"/>وٌن شَ وٌن حّرّ كِ مَتٌ، وٌن شَ عَ عِفبّ،</para>
  <para style="q" vid="LAM 3:40">وٌن شَ فبِلٍن عَلَتَلَ مَ.<verse eid="LAM 3:40"/></para>
  <para style="q">
    <verse number="41" style="v" sid="LAM 3:41"/>وٌن شَ عَلَ مَشَندِ وٌن بْحّ بِرِن نَ،</para>
  <para style="q" vid="LAM 3:41">وٌن شَ وٌن بّلّشّ عِتٍ عَلَ بّ نَشَن نَ كٌورٍ مَ.<verse eid="LAM 3:41"/></para>
  <para style="sp">حَمَ شَ عَلَ مَشَندِ</para>
  <para style="q">
    <verse number="42" style="v" sid="LAM 3:42"/>«مُشُ شَ يُنُبِ نُن مَتَندِ بَرَ فبٌ،</para>
  <para style="q" vid="LAM 3:42">عِ قَن مُ دِحّشِ مُشُ مَ.<verse eid="LAM 3:42"/></para>
  <para style="q">
    <verse number="43" style="v" sid="LAM 3:43"/>عِ شَ بْحّ شْنّ بَرَ لُ مُشُ قْشْ رَ،</para>
  <para style="q" vid="LAM 3:43">عِ بَرَ قَشّ تِ، عِ مُ كِنِكِنِ.<verse eid="LAM 3:43"/></para>
  <para style="q">
    <verse number="44" style="v" sid="LAM 3:44"/>عِ بَرَ نُشُي تِ وٌن تَفِ،</para>
  <para style="q" vid="LAM 3:44">عَلَكٌ مُشُ شَ مَشَندِ نَشَ عِ لِ.<verse eid="LAM 3:44"/></para>
  <para style="q">
    <verse number="45" style="v" sid="LAM 3:45"/>عِ بَرَ مُشُ قِندِ سُوتِ رَ حَمَنّيٍ تَفِ.<verse eid="LAM 3:45"/></para>
  <para style="q">
    <verse number="46" style="v" sid="LAM 3:46"/>مُشُ يَشُييٍ بِرِن بَرَ عٍ دّ عِبِ مُشُ شِلِ مَ.<verse eid="LAM 3:46"/></para>
  <para style="q">
    <verse number="47" style="v" sid="LAM 3:47"/>فَاشُي نُن بْحّ مِنِ بَرَ نْ مُشُ رَ،</para>
  <para style="q" vid="LAM 3:47">مُشُ شَ قٍ قِندِشِ كَنَرِ نُن فبَلٌي نَن تُن نَ.<verse eid="LAM 3:47"/></para>
  <para style="q">
    <verse number="48" style="v" sid="LAM 3:48"/>ﭑ يَ سُو سَمَ يَيٍ رَ، ﭑ مَ مِشِيٍ شَ فبَلٌي شَ قٍ رَ.<verse eid="LAM 3:48"/></para>
  <para style="q">
    <verse number="49" style="v" sid="LAM 3:49"/>دَنيِ يٌ مُ نَ ﭑ وَقٍ مَ، مَلَبُي يٌ مُ نَ ﭑ بّ،<verse eid="LAM 3:49"/></para>
  <para style="q">
    <verse number="50" style="v" sid="LAM 3:50"/>هَن بٍينُن عَلَتَلَ شَ عَ يَ رَفٌرٌ وٌن مَ.<verse eid="LAM 3:50"/></para>
  <para style="q">
    <verse number="51" style="v" sid="LAM 3:51"/>ﭑ بَرَ كِنِكِنِ فِنّدِ مّدِيٍ شَ تْورّ مَ.»<verse eid="LAM 3:51"/></para>
  <para style="sp">عَننَبِ يٍرٍ مِ شَ عَلَ مَشَندِ</para>
  <para style="b"/>
  <para style="q">
    <verse number="52" style="v" sid="LAM 3:52"/>مِشِيٍ بَرَ ﭑ كٍرِ عَلْ شْنِ،</para>
  <para style="q" vid="LAM 3:52">هَلِ ﭑ مُ قٍ حَاشِ يٌ رَبَشِ عٍ رَ.<verse eid="LAM 3:52"/></para>
  <para style="q">
    <verse number="53" style="v" sid="LAM 3:53"/>عٍ بَرَ ﭑ نَفٌرٌ كْلْنيِ كُي،</para>
  <para style="q" vid="LAM 3:53">عٍ نُ قَ فّمّيٍ رَفٌرٌ ﭑ مَ.<verse eid="LAM 3:53"/></para>
  <para style="q">
    <verse number="54" style="v" sid="LAM 3:54"/>يٍ تٌ دِن ﭑ شُن نَ،</para>
  <para style="q" vid="LAM 3:54">ﭑ نَشَ عَ قَلَ، «ﭑ بَرَ لْي!»<verse eid="LAM 3:54"/></para>
  <para style="q">
    <verse number="55" style="v" sid="LAM 3:55"/>ﭑ نَشَ عِ تَن عَلَتَلَ شِلِ كْلْنيِ فبَاتَ مَ.<verse eid="LAM 3:55"/></para>
  <para style="q">
    <verse number="56" style="v" sid="LAM 3:56"/>عِ قَن نَشَ ﭑ شُي مّ ﭑ تٌ عَ قَلَ،</para>
  <para style="q" vid="LAM 3:56">«عِ نَشَ تٌندِ ﭑ شُي رَ مّدٍ. يَندِ، ﭑ مَلِ.»<verse eid="LAM 3:56"/></para>
  <para style="q">
    <verse number="57" style="v" sid="LAM 3:57"/>ﭑ تٌ عِ مَشَندِ، عِ نَشَ عِ مَسٌ ﭑ نَ، عِ عَ قَلَ ﭑ بّ،</para>
  <para style="q" vid="LAM 3:57">«عِ نَشَ فَاشُ.»<verse eid="LAM 3:57"/></para>
  <para style="q">
    <verse number="58" style="v" sid="LAM 3:58"/>عَلَتَلَ، عِ بَرَ ﭑ مَ قٍ سُشُ، عِ بَرَ ﭑ نِي رَكِسِ.<verse eid="LAM 3:58"/></para>
  <para style="q">
    <verse number="59" style="v" sid="LAM 3:59"/>عَلَتَلَ، عِ عَ تٌشِ عٍ قٍ نَشٍيٍ نِيَشِ ﭑ نَ.</para>
  <para style="q" vid="LAM 3:59">عِ شَ ﭑ مَ نْندِ مَكّنّن.<verse eid="LAM 3:59"/></para>
  <para style="q">
    <verse number="60" style="v" sid="LAM 3:60"/>عِ بَرَ عَ تٌ عٍ كْنكْشِ ﭑ مَ كِ نَشّ،</para>
  <para style="q" vid="LAM 3:60">عٍ يَنقَنتٍيَ نَشَن بِرِن شِرِ مَ ﭑ شُن مَ.<verse eid="LAM 3:60"/></para>
  <para style="q">
    <verse number="61" style="v" sid="LAM 3:61"/>عَلَتَلَ، عِ بَرَ عٍ شُي مّ كٌنبِ تِ رَ،</para>
  <para style="q" vid="LAM 3:61">عٍ يَنقَنتٍيَ نَشَن بِرِن شِرِ مَ ﭑ شُن مَ.<verse eid="LAM 3:61"/></para>
  <para style="q">
    <verse number="62" style="v" sid="LAM 3:62"/>ﭑ فٍرٍقَيٍ شَ وْيّنيِ نُن عٍ شَ مَحْشُنيِ نَ ﭑ تَن نَن قْشْ رَ لْشْي بِرِن.<verse eid="LAM 3:62"/></para>
  <para style="q">
    <verse number="63" style="v" sid="LAM 3:63"/>عَ مَتٌ، شَ عٍ دْشْشِ، شَ عٍ تِشِ،</para>
  <para style="q" vid="LAM 3:63">عٍ ﭑ تَن نَن قِندِشِ عٍ شَ سِفِيٍ رَ.<verse eid="LAM 3:63"/></para>
  <para style="q">
    <verse number="64" style="v" sid="LAM 3:64"/>عَلَتَلَ، عِ شَ ﭑ فبٍحْشْ عٍ مَ.</para>
  <para style="q" vid="LAM 3:64">عٍ نَشَن نِيَشِ ﭑ نَ، عِ شَ نَ رَفبِلٍن عٍ مَ.<verse eid="LAM 3:64"/></para>
  <para style="q">
    <verse number="65" style="v" sid="LAM 3:65"/>عِ شَ عٍ شَشِلِ دْنشُ، عِ عٍ دَنكَ، بَرَكَتَرٍحَ شَ بِرَ عٍ قْشْ رَ.<verse eid="LAM 3:65"/></para>
  <para style="q">
    <verse number="66" style="v" sid="LAM 3:66"/>عَلَتَلَ، عِ شَ بْحّ شْنّ شَ لُ عٍ قْشْ رَ،</para>
  <para style="q" vid="LAM 3:66">عِ شَ عٍ بَ دُنِحَ بّندّ قُحِ قَرِ.<verse eid="LAM 3:66"/></para>
  <chapter eid="LAM 3"/>
  <chapter number="4" style="c" sid="LAM 4"/>
  <para style="s">دَرِ سَلَمُ حَمَ شَ حَشَنكَتّ</para>
  <para style="q">
    <verse number="1" style="v" sid="LAM 4:1"/>شّيمَ مُ يِلٍنمَ سْنْن، عَ مُ سّنِيّن.</para>
  <para style="q" vid="LAM 4:1">فّمّ تٌقَنيِيٍ بَرَ رَلَنتَن يّ تَا تُنشُنيِيٍ بِرِن نَ.<verse eid="LAM 4:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="LAM 4:2"/>سِيٌن دِيٍ تِدٍ نُ فبٌ عَلْ شّيمَ،</para>
  <para style="q" vid="LAM 4:2">كْنْ يَكْسِ عٍ تِدٍ بَرَ شُرُن</para>
  <para style="q" vid="LAM 4:2">عَلْ قّحّيٍ نَشٍيٍ يَءِلَنشِ بّندّ رَ.<verse eid="LAM 4:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="LAM 4:3"/>هَلِ وُلَبَرٍ فِنّ شِحّ قِمَ عَ شَ دِيٍ مَ،</para>
  <para style="q" vid="LAM 4:3">كْنْ ﭑ مَ حَمَ بَرَ لُ عَلْ دِنفّ نَشٍيٍ مُ مِشِحَ رَكَمَلِشِ.</para>
  <para style="q" vid="LAM 4:3">عٍ كٌبِ عَلْ سّفّ.<verse eid="LAM 4:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="LAM 4:4"/>كَامّ بَرَ عَ نِيَ، دِيْرّ نّنيِ بَرَ كَنكَن عَ نَشَرٍ.</para>
  <para style="q" vid="LAM 4:4">دِ مّيٍ تَامِ مَشْرِنمَ، كْنْ مِشِ يٌ مُ عٍ كِمَ.<verse eid="LAM 4:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="LAM 4:5"/>نَشٍيٍ نُ دٌنسٍ قَنيِ دٌنمَ، كَامّ بَرَ عٍ رَبِرَ تَا كُي.</para>
  <para style="q" vid="LAM 4:5">نَشٍيٍ رَ مْشِ قٍ قَنيِ كُي،</para>
  <para style="q" vid="LAM 4:5">عٍ قَ نَ حٌوفٍ نَن يٍفٍلٍنقٍ عٍ بّلّشّيٍ رَ.<verse eid="LAM 4:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="LAM 4:6"/>ﭑ مَ حَمَ شَ حَشَنكَتّ بَرَ فبٌ دَنفِقٍ سٌدٌ مَكَيٍ فبٍ رَ،</para>
  <para style="q" vid="LAM 4:6">نَشٍيٍ هَلَكِ يَ مَفِرّ كٍرٍن كُي،</para>
  <para style="q" vid="LAM 4:6">مِشِ كٍرٍن بّلّشّ مُ دِن عٍ رَ.<verse eid="LAM 4:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="LAM 4:7"/>عٍ شَ مَنفّدِيٍ نُ تٌقَن دَنفِ شّيمَ رَ،</para>
  <para style="q" vid="LAM 4:7">عٍ نُ قِيشّ دَنفِ شِحّ رَ.</para>
  <para style="q" vid="LAM 4:7">عٍ قَتٍ رَيَبُ عَلْ يٍ شْورَ سِنبٌنيِ،</para>
  <para style="q" vid="LAM 4:7">عٍ يَتَفِ نُ لُشِ نّ عَلْ دِيَمَن.<verse eid="LAM 4:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="LAM 4:8"/>كْنْ يَكْسِ عٍ قَتٍ بَرَ قْورْ دَنفِ تِفٍ رَ،</para>
  <para style="q" vid="LAM 4:8">عٍ مُ كٌلٌنمَ تَا كُي سْنْن.</para>
  <para style="q" vid="LAM 4:8">عٍ كِرِ قَتُشِ عٍ شْرِيٍ مَ، عَ بَرَ شَرَ عَلْ بٌلٍ.<verse eid="LAM 4:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="LAM 4:9"/>نَشٍيٍ قَشَ سَنتِدّفّمَ رَ،</para>
  <para style="q" vid="LAM 4:9">عٍ تَن نَن شُن نُ رَقَن دَنفِ مِشِ بِرِن نَ كَامّ نَشٍيٍ حَشَنكَتَقٍ.</para>
  <para style="q" vid="LAM 4:9">كَامّتْييٍ بَرَ شْسِ، عٍ تَفَنشِ،</para>
  <para style="q" vid="LAM 4:9">عٍ مُ دٌنسٍ يٌ سْتْمَ كْرّ.<verse eid="LAM 4:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="LAM 4:10"/>دِنفّيٍ، مَرَقَنيِ نُ نَ نَشٍيٍ بّ،</para>
  <para style="q" vid="LAM 4:10">عٍ بَرَ عٍ يّتّ شَ دِيٍ حِن، عٍ عٍ دٌن،</para>
  <para style="q" vid="LAM 4:10">عَلَكٌ عٍ شَ بَلٌ عَلِبَلَوِ كُي.<verse eid="LAM 4:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="LAM 4:11"/>عَلَتَلَ شَ شْنّ بَرَ كَمَلِ.</para>
  <para style="q" vid="LAM 4:11">عَ بَرَ عَ رَلَنتَن يّ، عَ تّ شُرُ سِيٌن،</para>
  <para style="q" vid="LAM 4:11">نَشَن بَرَ يِرٍ تِشِيٍ بِرِن فَن.<verse eid="LAM 4:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="LAM 4:12"/>بْشِ مَنفّيٍ مُ لَ عَ رَ،</para>
  <para style="q" vid="LAM 4:12">دُنِحَ مِشِيٍ سٍسٍ قَن مُ لَ عَ رَ،</para>
  <para style="q" vid="LAM 4:12">شَ يَشُييٍ نْمَ سٌدٍ دَرِ سَلَمُ نَادّيٍ رَ.<verse eid="LAM 4:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="LAM 4:13"/>يِ فبَلٌي كٍلِشِ عَ شَ نَمِحْنمّيٍ شَ يُنُبِيٍ نَن مَ،</para>
  <para style="q" vid="LAM 4:13">عَ نُن عَ شَ سّرّشّدُبّيٍ شَ قٍ كٌبِ رَبَشِيٍ مَ،</para>
  <para style="q" vid="LAM 4:13">عٍ تَن نَشٍيٍ تِنشِنتْييٍ نِي بَشِ.<verse eid="LAM 4:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="LAM 4:14"/>كْنْ يَكْسِ عٍ حّرّ مَ تَا كُي عَلْ دْنشُييٍ،</para>
  <para style="q" vid="LAM 4:14">مِشِ يٌ مُ عَ بّلّشّ دِنمَ عٍ رَ</para>
  <para style="q" vid="LAM 4:14">بَرِ مَ وُلِ نَشَن فٌرٌ مَ عٍ مَ،</para>
  <para style="q" vid="LAM 4:14">عَ بَرَ عٍ قِندِ سّنِيّنتَرٍيٍ رَ.<verse eid="LAM 4:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="LAM 4:15"/>مِشِيٍ لُمَ فبٍلٍفبٍلٍ رَ،</para>
  <para style="q" vid="LAM 4:15">«وٌ كٍلِ بٍ! وٌ تَن مِشِ سّنِيّنتَرٍيٍ!</para>
  <para style="q" vid="LAM 4:15">وٌ كٍلِ بٍ، وٌ كٍلِ بٍ! وٌ وٌ مَكُيَ مُشُ رَ!»</para>
  <para style="q" vid="LAM 4:15">نَ كُي عٍ نَشَ عٍ فِ سِفَقٍ رَ حَمَنّيٍ مَ.</para>
  <para style="q" vid="LAM 4:15">نَاكَيٍ قَن بَرَ عَ قَلَ،</para>
  <para style="q" vid="LAM 4:15">«عٍ مُ لُمَ مُشُ شْنيِ كْرّ!»<verse eid="LAM 4:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="LAM 4:16"/>عَلَتَلَ يّتّ يَتِ نَن عٍ رَيٍنسٍن يّ،</para>
  <para style="q" vid="LAM 4:16">عَ مُ قَ عَ حْشْ سَشِ عٍ شْن مَ سْنْن.</para>
  <para style="q" vid="LAM 4:16">عَ بَرَ بِنيّ بَ سّرّشّدُبّيٍ يِ،</para>
  <para style="q" vid="LAM 4:16">شُننَكٍلِ مُ نَ قٌرِيٍ بّ سْنْن.<verse eid="LAM 4:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="LAM 4:17"/>مُشُ بَرَ مَلِ ندٍ مَمّ،</para>
  <para style="q" vid="LAM 4:17">كْنْ مِشِ يٌ مُ قَ.</para>
  <para style="q" vid="LAM 4:17">مُشُ بَرَ مُشُ يَ تِ كِرَ رَ هَن مُشُ يَ بَرَ رَقْورْ،</para>
  <para style="q" vid="LAM 4:17">كْنْ سِ يٌ مُ قَ مُشُ رَتَنفَدٍ.<verse eid="LAM 4:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="LAM 4:18"/>مُشُ يَشُييٍ نُ مُشُ حّرّ كِ بِرِن تٌشِ،</para>
  <para style="q" vid="LAM 4:18">عَلَكٌ مُشُ نَشَ قَ مِنِ تَا كُي.</para>
  <para style="q" vid="LAM 4:18">مُشُ شَ قٍ دَنيِ نُ بَرَ مَكْرّ،</para>
  <para style="q" vid="LAM 4:18">لْشْي فبٍفبٍ مُ نُ لُشِ مُشُ بّ سْنْن،</para>
  <para style="q" vid="LAM 4:18">بَرِ مَ مُشُ شَ قٍ دَنيِ نُ بَرَ فّ عَ لِدٍ.<verse eid="LAM 4:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="LAM 4:19"/>مُشُ كٍرِ مَيٍ نُ شُلُن دَنفِ سّفّيٍ رَ،</para>
  <para style="q" vid="LAM 4:19">نَشٍيٍ نَ كٌورٍ مَ.</para>
  <para style="q" vid="LAM 4:19">عٍ نَشَ مُشُ كٍرِ هَن فٍيَيٍ قَرِ،</para>
  <para style="q" vid="LAM 4:19">عٍ عٍ نْشُن مُشُ يَ رَ، عٍ مُشُ مَمّ بُرُنيِ.<verse eid="LAM 4:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="LAM 4:20"/>عٍ نَشَ مُشُ رَكِسِمَ قَن سُشُ، عَلَ شَ مِشِ سُفَندِشِ.</para>
  <para style="q" vid="LAM 4:20">وٌن نُ بَرَ عَ قَلَ عَ شَ قٍ رَ،</para>
  <para style="q" vid="LAM 4:20">«مُشُ يِرِوَ مَ نّ عَ نِينِ بُن مَ حَمَنّيٍ تَفِ.»<verse eid="LAM 4:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="LAM 4:21"/>عِ تَن عٍدٌن حَمَ نَشَن سَبَتِشِ عُسُ بْشِ مَ حّلّشِن يِرٍ،</para>
  <para style="q" vid="LAM 4:21">يَكْسِ عِ نَ سّيوّ كُي،</para>
  <para style="q" vid="LAM 4:21">كْنْ عِ قَن شَ كِيتِ وَشَتِ نَ قَقٍ.</para>
  <para style="q" vid="LAM 4:21">عِ قَمَ نّ حَشَنكَتّ نُن يَافِ سْتْدٍ.<verse eid="LAM 4:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="LAM 4:22"/>سِيٌن حَمَ، عَ فبٍ مُ لُشِ عِ شَ حَشَنكَتّ شَ دَن.</para>
  <para style="q" vid="LAM 4:22">عَلَ مُ عِ شَ كٌنيِيَ رَبُمَ،</para>
  <para style="q" vid="LAM 4:22">كْنْ عِ تَن عٍدٌن حَمَ،</para>
  <para style="q" vid="LAM 4:22">عَلَتَلَ قَمَ نّ عِ مَكِيتِدٍ عِ شَ يُنُبِيٍ مَ،</para>
  <para style="q" vid="LAM 4:22">عَ شَ عِ حَشَنكَتَ نٍيٍ شَ قٍ رَ.<verse eid="LAM 4:22"/></para>
  <chapter eid="LAM 4"/>
  <chapter number="5" style="c" sid="LAM 5"/>
  <para style="s">حَمَ حَشَنكَتَشِ شَ سَلِ</para>
  <para style="sp">حَمَ شَ عَلَ مَشَندِ</para>
  <para style="q">
    <verse number="1" style="v" sid="LAM 5:1"/>عَلَتَلَ، مُشُ شَ تْورّ مَتٌ، مُشُ شَ يَافِ عِفبّ!<verse eid="LAM 5:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="LAM 5:2"/>شْحّيٍ بَرَ مُشُ كّ تٌنفٌ.</para>
  <para style="q" vid="LAM 5:2">مِشِيٍ بَرَ سَبَتِ مُشُ شَ بَنشِيٍ كُي،</para>
  <para style="q" vid="LAM 5:2">مُشُ كٌلٌنمَيٍ مُ نَشٍيٍ رَ.<verse eid="LAM 5:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="LAM 5:3"/>مُشُ بَرَ قِندِ مِسِكِينّ بَبَتَرٍيٍ رَ،</para>
  <para style="q" vid="LAM 5:3">مُشُ نفَيٍ بَرَ لُ عَلْ كَاحّ فِنّيٍ.<verse eid="LAM 5:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="LAM 5:4"/>مُشُ مُ نْمَ مُشُ شَ يٍ مِندٍ،</para>
  <para style="q" vid="LAM 5:4">قٌ مُشُ شَ عَ سَرَ كْبِرِ رَ.</para>
  <para style="q" vid="LAM 5:4">مُشُ مُ نْمَ مُشُ شَ يٍفٍ قَن فَندٍ،</para>
  <para style="q" vid="LAM 5:4">قٌ مُشُ شَ عَ سَرَ.<verse eid="LAM 5:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="LAM 5:5"/>مُشُ حَشَنكَتَمَيٍ دْشْشِ مُشُ قَرِ.</para>
  <para style="q" vid="LAM 5:5">مُشُ بَرَ تَفَن، مَلَبُي يٌ مُ نَ.<verse eid="LAM 5:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="LAM 5:6"/>مُشُ بَرَ مُشُ بّلّشّ عِتَلَ مِسِرَ نُن عَسِرِيَ بِرِ رَ،</para>
  <para style="q" vid="LAM 5:6">عَلَكٌ عٍ شَ مُشُ كِ تَامِ رَ.<verse eid="LAM 5:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="LAM 5:7"/>مُشُ بَبَيٍ بَرَ يُنُبِ رَبَ،</para>
  <para style="q" vid="LAM 5:7">كْنْ عٍ مُ نَ دُنِحَ سْنْن.</para>
  <para style="q" vid="LAM 5:7">مُشُ تَن نَن قَ عٍ شَ قٍ كٌبِيٍ تْرُحْي شَنِنقٍ.<verse eid="LAM 5:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="LAM 5:8"/>كٌنيِيٍ نَن قَ تِشِ مُشُ شُن مَ،</para>
  <para style="q" vid="LAM 5:8">مِشِ يٌ مُ نَ نَشَن مُشُ بَمَ عٍ يِ رَ.<verse eid="LAM 5:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="LAM 5:9"/>مُشُ بَلٌي قٍنمَ وُلَ عِ فَاشُي كُي،</para>
  <para style="q" vid="LAM 5:9">بَرِ مَ سَنتِدّفّمَ كَنيِيٍ نَ يِرٍ بِرِن.<verse eid="LAM 5:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="LAM 5:10"/>كَامّ بَرَ مُشُ سُشُ.<verse eid="LAM 5:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="LAM 5:11"/>مُشُ يَشُييٍ بَرَ عٍ وَشْنقٍ رَبَ سِيٌن نُن يُدَيَ فِنّدِ مّدِيٍ رَ.<verse eid="LAM 5:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="LAM 5:12"/>عٍ بَرَ كُنتِفِيٍ فبَكُ وُرِيٍ مَ، عٍ بِنيّ بَ قٌرِيٍ يِ.<verse eid="LAM 5:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="LAM 5:13"/>قٌنِكٍيٍ مّنفِ دِنمَ،</para>
  <para style="q" vid="LAM 5:13">عٍ يٍفٍ مَشَنِن هَن يٍفٍ كٌتٍ بَرَ بِرَ عٍ مَ.<verse eid="LAM 5:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="LAM 5:14"/>قٌرِيٍ بَرَ بَ عٍ مَلَنقٍ،</para>
  <para style="q" vid="LAM 5:14">قٌنِكٍيٍ قَن بَرَ بَ حَشَحَشَقٍ.<verse eid="LAM 5:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="LAM 5:15"/>مُشُ بْحّيٍ بَرَ بَ سّيوَقٍ،</para>
  <para style="q" vid="LAM 5:15">مُشُ شَ شُلُنيِ بَرَ مَسَرَ سُننُنيِ رَ.<verse eid="LAM 5:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="LAM 5:16"/>شُننَكٍلِ بَرَ بَ مُشُ يِ،</para>
  <para style="q" vid="LAM 5:16">مُشُ بَرَ مَكِنِكِنِ مُشُ شَ يُنُبِيٍ شَ قٍ رَ.<verse eid="LAM 5:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="LAM 5:17"/>نَ نَن عَ تٌشِ، مُشُ بْحّيٍ تْورْشِ،</para>
  <para style="q" vid="LAM 5:17">مُشُ يَ قَن بَرَ رَقْورْ.<verse eid="LAM 5:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="LAM 5:18"/>سِيٌن فٍيَ بَرَ قِندِ فبٍنفبٍرٍنيِ رَ،</para>
  <para style="q" vid="LAM 5:18">عَ بَرَ قِندِ شُلُمَسٍيٍ مَحّرّدٍ رَ.<verse eid="LAM 5:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="LAM 5:19"/>كْنْ عِ تَن، مَرِفِ عَلَتَلَ، عِ تَن نَن مَنفّ رَ تّمُي بِرِن.</para>
  <para style="q" vid="LAM 5:19">دَنيِ مُ نَ عِ شَ مَنفّيَ مَ،</para>
  <para style="q" vid="LAM 5:19">كٍلِ لَنقَنمَيٍ مَ، سَ دْشْ لَنقَنمَيٍ بِرِن نَ.<verse eid="LAM 5:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="LAM 5:20"/>مُنقٍ رَ، عِ قَ نّيمُشِ مُشُ مَ يِ مْولِ رَ،</para>
  <para style="q" vid="LAM 5:20">كَ عِ مُشُ رَبّحِنمَ نّ مُشُ شَ سِمَيَ بِرِن كُي؟<verse eid="LAM 5:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="LAM 5:21"/>عَلَتَلَ، مُشُ رَفبِلٍن عِ مَ،</para>
  <para style="q" vid="LAM 5:21">مُشُ شَ قَ عِ مَ عَلْ عَ سِنفٍ.<verse eid="LAM 5:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="LAM 5:22"/>عِ مّيشِ نّ مُشُ رَ كٍرٍنيِ رَ؟</para>
  <para style="q" vid="LAM 5:22">عِ شْنْمَ نّ مُشُ مَ عَبَدَن؟<verse eid="LAM 5:22"/></para>
  <chapter eid="LAM 5"/>
</usx>
