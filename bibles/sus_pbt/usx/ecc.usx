<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ECC" style="id">- Susu Translation</book>
  <para style="h">كَوَندِلَ</para>
  <para style="toc1">كَوَندِلَ شَ كِتَابُي</para>
  <para style="toc2">كَوَندِلَ</para>
  <para style="toc3">كَو</para>
  <para style="mt">كَوَندِلَ شَ كِتَابُي</para>
  <para style="imt">مَسٍنيِ ندٍ يِ كِتَابُي شَ قٍ رَ</para>
  <para style="ip">عَننَبِ سُلٍمَنِ يِ كِتَابُي نَن سّبّشِ عَ شَ بَننَيَ، عَ شَ نْي، نُن عَ شَ لْننِ بٍلٍبٍلٍ نَن شَ قٍ رَ. نَ بِرِن قِندِشِ مَسٍنيِ هَفِفّ نَن نَ عَ بّ عَلَتَلَ شَ مَرَفِرِ كُي. عَ نَشَ عَ قَهَامُ نَ بِرِن قِندِشِ «قٍ قُقَقُ» نَن نَ. بِرَقٍ نَ قٍ مْولِ قْشْ رَ، نَ لُشِ عَلْ مِشِ «نَشَن بِرَ مَ قٌيٍ قْشْ رَ.» قٌيٍ نَ نَ، كْنْ عَ سِفَمَ نّ، عَ مُ بُمَ. عَ سُشُقٍ مُ سْونّيَمَ. عَ نَ نَ كِ نّ وٌن مَ دُنِحّءِفِرِ كُي.</para>
  <para style="ip">يِ كِتَابُي شَ مَسٍنيِ تِدٍ فبٌ بَرِ مَ تٌ مِشِيٍ مُ تَفَنمَ بِرَدٍ قٍ وُيَشِ قْشْ رَ نَشَن مُ قِندِشِ عَلَتَلَ شَ سّرِيّ رَ. عٍ بِرِن كَتَمَ نّ نَاقُلِ سْتْدٍ. عٍ لْننِ قٍنمَ عَلَكٌ نَ تَن قَن شَ قِندِ كْبِرِ رَ. نَ كِرَ شْن مَ عٍ قٍ مْولِ بِرِن نَبَمَ نَشٍيٍ نْمَ رَقَندٍ عٍ قَتٍ مَ. نَ حّرّ كِ كُي عَدَ مَدِ لُمَ يُنُبِ رَبَ رَ.</para>
  <para style="ip">عَلَتَلَ نَشَن مَسٍنمَ وٌن بّ عَننَبِ سُلٍمَنِ سَابُي رَ عَ قِندِشِ يِ نَن نَ؛ عَ لَنمَ عَدَ مَدِ شَ بِرَ عَلَتَلَ شَ سّرِيّ قْشْ رَ يِ دُنِحَ بّندّ قُحِ قَرِ. عَلَ دُنِحَ نَشَن دَاشِ عَ قَن عَدَ مَ بّ، كْنْ عَ مُ لَنمَ عَ شَ قِندِ عَ شَ عَلَ رَ. عَلَتَلَ حّلّشِنيِ قِمَ مِشِ مَ، كْنْ عَ وَ مَ نّ عٍ شَ عَ كٌلٌن عَ تَن نَن قِندِشِ عٍ مَرِفِ رَ. عَ لَنمَ عَدَ مَ شَ دُنِحَ عِفِرِ، عَ يَ تِشِ عَلَ نَن نَ. عَ شَ عَ كٌلٌن دُنِحَ سٍيٍ مُ بُمَ، عٍ لُشِ نّ عَلْ «قٌيٍ» نَشَن لْيمَ يٍن.</para>
  <para style="ip">يِ كِتَابُي عَ مَسٍنمَ نّ وٌن بّ عَ لَنمَ وٌن مَرِفِ شَ قِندِ عَلَتَلَ دَالِ مَنفّ نَن نَ، عَ نَشَ قِندِ دَالِ سٍ ندٍ رَ. عَلَ شَ وٌن مَلِ نَ كٌلٌنقٍ رَ وٌن بْحّ كُي. عَمِنَ.</para>
  <para style="imte">كَوَندِلَ شَ كِتَابُي</para>
  <chapter number="1" style="c" sid="ECC 1"/>
  <para style="s">دُنِحَ قُ نَ عَ رَ!</para>
  <para style="d">
    <verse number="1" style="v" sid="ECC 1:1"/>دَوُدَ شَ دِ دَرِ سَلَمُ مَنفّ شَ كَوَندِ نَن يَ؛<verse eid="ECC 1:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ECC 1:2"/>دُنِحَ قِندِشِ قٍ قُقَقُ نَن نَ.</para>
  <para style="q" vid="ECC 1:2">دُنِحَ قٍيٍ تِدٍ يٌ مُ نَ،</para>
  <para style="q" vid="ECC 1:2">نَ بِرِن قِندِشِ قُيَن نَن نَ.</para>
  <para style="q" vid="ECC 1:2">ﭑ تَن كَوَندِلَ شَ مَسٍنيِ نَن نَن كِ.<verse eid="ECC 1:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="ECC 1:3"/>عَدَ مَدِ فٍينِ مُندُن سْتْمَ عَ شَ وَلِ مَ سٌفٍ بُن مَ؟<verse eid="ECC 1:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ECC 1:4"/>ندٍيٍ قَشَمَ، ندٍيٍ بَرِ مَ، دُنِحَ قَن نَ كّحَ كٍرٍن لْشْي بِرِن.<verse eid="ECC 1:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ECC 1:5"/>سٌفٍ تٍمَ، عَ فٌرٌ مَ، عَ مَن فبِلٍن عَ تٍشِ دّننَشّ.<verse eid="ECC 1:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ECC 1:6"/>قٌيٍ قَن مِنِمَ، عَ سِفَمَ يِرٍقَنيِ مَ، عَ عَ مَقِندِ مَ كْولَ مَ.</para>
  <para style="q" vid="ECC 1:6">عَ نَ فّ مَقِندِدٍ، عَ مَن فبِلٍن عَ كٍلِدٍ.<verse eid="ECC 1:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="ECC 1:7"/>شُرٍ بِرِن شُن تِشِ بَا نَن نَ، كْنْ بَا مُ رَقٍمَ.</para>
  <para style="q" vid="ECC 1:7">شُرٍيٍ كٍلِمَ دّننَشّ، عٍ مَن فبِلٍنمَ مّننِ نّ.<verse eid="ECC 1:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ECC 1:8"/>قٍ بِرِن حّرّ مَ، عَ مُ تَفَنمَ، عَ مُ مَسَرَ مَ.</para>
  <para style="q" vid="ECC 1:8">عَدَ مَ يَ مُ وَ سَمَ قٍ مَتٌدٍ،</para>
  <para style="q" vid="ECC 1:8">عَ تُلِ قَن مُ لُفَمَ قٍ رَ مّدٍ.<verse eid="ECC 1:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ECC 1:9"/>نَشَن بَرَ دَنفِ نُ،</para>
  <para style="q" vid="ECC 1:9">نَ نَن مَن فبِلٍنمَ عَ رَ.</para>
  <para style="q" vid="ECC 1:9">نَشَن بَرَ رَبَ نُ، نَ نَن مَن نَبَمَ.</para>
  <para style="q" vid="ECC 1:9">قٍ نّينّ مُ رَبَمَ دُنِحَ مَ نَشَن حْندْن مُ نُ رَبَ.<verse eid="ECC 1:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ECC 1:10"/>قٍ نّينّ يٌ مُ نَ نَشَن عَ نِيَمَ مِشِ شَ عَ قَلَ،</para>
  <para style="q" vid="ECC 1:10">«يِ مَتٌ، قٍ نّينّ نَ عَ رَ!»</para>
  <para style="q" vid="ECC 1:10">ﭑ شَ عَ قَلَ وٌ بّ، نَ قٍ مْولِ حَن نُ نَ بٍينُن وٌن تَن شَ بَرِ.<verse eid="ECC 1:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ECC 1:11"/>حَمَ مُ رَتُمَ قٍ دَنفِشِ مَ،</para>
  <para style="q" vid="ECC 1:11">قٍ نَشَن سَ قَمَ رَبَدٍ، حَمَ نّيمُمَ نّ نَ قَن نَ.<verse eid="ECC 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 1:12"/>ﭑ تَن كَوَندِلَ، ﭑ بَرَ قِندِ مَنفّ رَ عِسِرَيِلَ بْشِ مَ دَرِ سَلَمُ. <verse eid="ECC 1:12"/><verse number="13" style="v" sid="ECC 1:13"/>ﭑ نَتّ تٌنفٌشِ نّ، قٍ نَشٍيٍ بِرِن نَبَقٍ يِ دُنِحَ مَ، ﭑ شَ عٍ مَتٌ عَ قَنيِ رَ. نَ كُي ﭑ عَ تٌ نّ عَ عَلَ كٌتٍ شْرْشْي نَن سَشِ عَدَ مَدِيٍ قَرِ. <verse eid="ECC 1:13"/><verse number="14" style="v" sid="ECC 1:14"/>ﭑ بَرَ وَلِ بِرِن مَتٌ نَشَن نَبَمَ يِ دُنِحَ مَ. قُقَقُ نَ عَ بِرِن نَ! بِرَقٍ نَ وَلِ قْشْ رَ، عَ لُشِ نّ عَلْ مِشِ نَ بِرَقٍ قٌيٍ نَن قْشْ رَ.<verse eid="ECC 1:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="ECC 1:15"/>نَشَن كُنتِنشِ، نَ مُ نْمَ مَتِنشِندٍ،</para>
  <para style="q" vid="ECC 1:15">نَشَن لُشِ، نَ مُ نْمَ كَمَلِدٍ.<verse eid="ECC 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 1:16"/>ﭑ نَشَ عَ مَحْشُن ﭑ يّتّ مَ، عَ ﭑ تَن بَرَ لْننِ قٍن دَنفِ دَرِ سَلَمُ مَنفّ بِرِن نَ، نَشٍيٍ سِنفٍ قَ ﭑ تَن يَرَ. ﭑ بَرَ لْننِ نُن قٍ كٌلٌنيِ فبٍفبٍ سْتْ دُنِحَ شَ قٍ مَ. <verse eid="ECC 1:16"/><verse number="17" style="v" sid="ECC 1:17"/>ﭑ نَشَ نَتّ تٌنفٌ ﭑ شَ شَشِلِمَيَ نُن شَشِلِتَرٍحَ قَن مَتٌ. كْنْ ﭑ بَرَ عَ تٌ نَ قَن لُشِ عَلْ بِرَقٍ قٌيٍ نَن قْشْ رَ.<verse eid="ECC 1:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="ECC 1:18"/>شَشِلِمَيَ نُن كْنتْقِلِ نَن حّرّ مَ كِرَ كٍرٍن شْن مَ.</para>
  <para style="q" vid="ECC 1:18">قٍ كٌلٌنيِ فبٌمَ كِ نَشّ، تْورّ قَن فبٌمَ نَ كِ نّ.<verse eid="ECC 1:18"/></para>
  <chapter eid="ECC 1"/>
  <chapter number="2" style="c" sid="ECC 2"/>
  <para style="s">عَدَ مَدِ وَشْنقٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 2:1"/>ﭑ عَ قَلَ نّ ﭑ يّتّ بّ، «ﭑ شَ حّلّشِنيِ مَتٌ، ﭑ شَ عَ كٌلٌن نَشَن قَن.» ﭑ نَشَ عَ تٌ عَ حّلّشِنيِ قَن مُ بُمَ. <verse eid="ECC 2:1"/><verse number="2" style="v" sid="ECC 2:2"/>ﭑ نَشَ ﭑ يّتّ مَشْرِن، «يٍلٍقٍ تُن مُ قِندِشِ قٍ كَمَلِشِ رَ. حّلّشِنيِ تِدٍ نَ مُنسٍ رَ؟» <verse eid="ECC 2:2"/><verse number="3" style="v" sid="ECC 2:3"/>ﭑ نَشَ نَتّ تٌنفٌ ﭑ مَ لْننِ قٍنقٍ كُي، ﭑ شَ حّلّشِنيِ قٍن وّنِ رَ. ﭑ نُ وَ مَ عَ كٌلٌنقٍ مُنسٍ مُنَقَنيِ فبٌ عَدَ مَدِيٍ بّ عٍ شَ دُنِحّءِفِرِ كُي.<verse eid="ECC 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 2:4"/>ﭑ نَشَ وَلِ شُنفبٍ ندٍيٍ سُشُ عَلْ بَنشِ تِقٍ نُن شّ سَقٍ. <verse eid="ECC 2:4"/><verse number="5" style="v" sid="ECC 2:5"/>ﭑ نَشَ يِرٍ تٌقَنيِيٍ يَءِلَن نَاقُلِ كَنيِ عٍ مَلَبُمَ دّننَشّ سَنسِ تٌقَنيِيٍ يَ مَ. <verse eid="ECC 2:5"/><verse number="6" style="v" sid="ECC 2:6"/>ﭑ نَشَ يٍ يِرٍ فٍ نَشٍيٍ عَ نِيَمَ يٍ شَ سَ ﭑ مَ سَنسِيٍ مَ. <verse eid="ECC 2:6"/><verse number="7" style="v" sid="ECC 2:7"/>ﭑ نَشَ كٌنيِيٍ سَرَ، نَشٍيٍ بَرَ دِيٍ سْتْ نَشٍيٍ قِندِشِ ﭑ فبٍ رَ، عٍ قَ لُ ﭑ شْنيِ. ﭑ نَشَ شُرُ سٍ فبٍفبٍ سْتْ، دَنفِ دَرِ سَلَمُكَيٍ بِرِن نَ نَشٍيٍ نُ نَ بٍينُ ﭑ شَ بَرِ. <verse eid="ECC 2:7"/><verse number="8" style="v" sid="ECC 2:8"/>ﭑ نَشَ فبٍتِ، شّيمَ، نُن نَاقُلِ مْولِ بِرِن سْتْ. ﭑ نَشَ يٍلِبَيٍ سْتْ، عَ نُن فِنّ فَلِ عَدَ مَ وَشْنقٍ شَ قٍ رَ. <verse eid="ECC 2:8"/><verse number="9" style="v" sid="ECC 2:9"/>ﭑ نَشَ قِندِ مِشِ شُنفبٍ رَ دَنفِقٍ دَرِ سَلَمُكَيٍ بِرِن نَ نَشٍيٍ نُ نَ بٍينُ ﭑ شَ بَرِ. ﭑ نَشَ نَ بِرِن نَبَ لْننِ قٍنقٍ رَ.<verse eid="ECC 2:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ECC 2:10"/>ﭑ نَشَ ﭑ وَشْنقٍ مْولِ بِرِن قٍن،</para>
  <para style="q" vid="ECC 2:10">ﭑ مُ تٌندِ سٍسٍ رَ نَشَن نُ رَقَنشِ ﭑ مَ.</para>
  <para style="q" vid="ECC 2:10">ﭑ مَ وَلِ يَتِ نُ رَقَنشِ ﭑ مَ،</para>
  <para style="q" vid="ECC 2:10">نَ نَن قِندِشِ ﭑ مَ فٍينِ رَ.<verse eid="ECC 2:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ECC 2:11"/>كْنْ ﭑ تٌ ﭑ مَ وَلِ بِرِن مَتٌ،</para>
  <para style="q" vid="ECC 2:11">ﭑ نَشَن نَبَشِ تْورّ كُي،</para>
  <para style="q" vid="ECC 2:11">ﭑ نَشَ عَ تٌ نَ بِرِن قُقَقُ.</para>
  <para style="q" vid="ECC 2:11">عَ نُ لُشِ نّ عَلْ مِشِ نَشَن بِرَ مَ قٌيٍ قْشْ رَ</para>
  <para style="q" vid="ECC 2:11">عَ مُ سٍسٍ سُشُ.<verse eid="ECC 2:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="ECC 2:12"/>نَ تّمُي ﭑ نَشَ ﭑ حْشْ سَ شَشِلِمَيَ نُن شَشِلِتَرٍحَ شْن مَ.</para>
  <para style="q" vid="ECC 2:12">نَشَن تِمَ مَنفّ رَ ﭑ حْشْي رَ،</para>
  <para style="q" vid="ECC 2:12">نَ قَمَ مُنسٍ رَبَدٍ؟<verse eid="ECC 2:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="ECC 2:13"/>ﭑ نَشَ عَ تٌ شَشِلِمَيَ قَن دَنفِ شَشِلِتَرٍحَ رَ،</para>
  <para style="q" vid="ECC 2:13">عَلْ نَءِيَلَنيِ قَن تٌ قَنشِ دِ مِ بّ.<verse eid="ECC 2:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="ECC 2:14"/>شَشِلِمَ سٍ تٌمَ عَ يَ رَ،</para>
  <para style="q" vid="ECC 2:14">شَشِلِتَرٍ تَن عَ حّرّ مَ دِ مِ نَن كُي.</para>
  <para style="q" vid="ECC 2:14">كْنْ عٍ قِرِن بِرِن قَشَمَ نّ.<verse eid="ECC 2:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="ECC 2:15"/>نَ نَن عَ رَ ﭑ نَشَ عَ مَحْشُن،</para>
  <para style="q" vid="ECC 2:15">شَ ﭑ تَن نُن شَشِلِتَرٍ بِرِن قَشَمَ نّ،</para>
  <para style="q" vid="ECC 2:15">ﭑ مَ شَشِلِمَيَ تِدٍ قَ نَ مُنسٍ رَ؟</para>
  <para style="q" vid="ECC 2:15">ﭑ نَشَ عَ قَلَ ﭑ يّتّ بّ، «شَشِلِمَيَ قَن قٍ قُقَقُ نَن عَ رَ.»<verse eid="ECC 2:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="ECC 2:16"/>شَشِلِمَ نُن شَشِلِتَرٍ شَ قٍ مُ رَتُمَ مِشِيٍ رَ،</para>
  <para style="q" vid="ECC 2:16">عٍ نّيمُمَ نّ عٍ قِرِن بِرِن مَ، عٍ قِرِن بِرِن قَشَمَ نّ.<verse eid="ECC 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ECC 2:17"/>نَ كُي دُنِحّءِفِرِ نَشَ رَحَاشُ ﭑ مَ، بَرِ مَ ﭑ بَرَ عَ كٌلٌن ﭑ مَ وَلِ مُ بُمَ. عَ لُشِ نّ عَلْ مِشِ نَشَن بِرَ مَ قٌيٍ قْشْ رَ، عٍ مُ عَ سُشُ. <verse eid="ECC 2:17"/><verse number="18" style="v" sid="ECC 2:18"/>ﭑ مَ وَلِ نَشَ رَحَاشُ ﭑ مَ، بَرِ مَ ﭑ بَرَ عَ كٌلٌن قٌ ﭑ شَ نَ بِرِن لُ مِشِ فبّتّ يِ رَ. <verse eid="ECC 2:18"/><verse number="19" style="v" sid="ECC 2:19"/>نَ مِشِ قِندِ مَ شَشِلِمَ نَن نَ، كَ شَشِلِتَرٍ رَ؟ ندٍ نْمَ نَ كٌلٌندٍ؟ كْنْ عَ تَن يَتِ نْي سْتْمَ نّ ﭑ مَ وَلِ بِرِن شُن مَ! قٍ قُقَقُ نَن نَ كِ. <verse eid="ECC 2:19"/><verse number="20" style="v" sid="ECC 2:20"/>نَ كُي ﭑ نَشَ نِمِسَ وَلِ بِرِن شَ قٍ رَ ﭑ نَشَن نَبَ يِ دُنِحَ مَ.<verse eid="ECC 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ECC 2:21"/>مِشِ نَشَن وَلِشِ لْننِ نُن قَتّ رَ، عَ قَ نَ وَلِ لُ مِشِ ندٍ يِ رَ نَشَن مُ سٍسٍ رَبَ نَ وَلِ كُي، نَ قِندِشِ قٍ قُقَقُ نَن نَ نَشَن شْرْشْ كِ قَنيِ رَ. <verse eid="ECC 2:21"/><verse number="22" style="v" sid="ECC 2:22"/>مِشِ فٍينِ مُندُن سْتْمَ عَ شَ وَلِ نُن عَ شَ كَتّ كُي عَ نَشَن نَبَشِ يِ دُنِحَ مَ؟ <verse eid="ECC 2:22"/><verse number="23" style="v" sid="ECC 2:23"/>عَ شَ وَلِ قِندِشِ تْورّ شْرْشْي نَن نَ عَ بّ. هَلِ كْي رَ عَ بْحّ مُ مَلَبُمَ. قٍ قُقَقُ نَن نَ كِ.<verse eid="ECC 2:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ECC 2:24"/>عَ لَنمَ مِشِ شَ عَ دّفٍ، عَ شَ عَ مِن، عَ شَ عَ شَ وَلِ رَبَ سّيوّ كُي. ﭑ بَرَ عَ كٌلٌن نَ بِرِن كٍلِشِ عَلَ نَن مَ. <verse eid="ECC 2:24"/><verse number="25" style="v" sid="ECC 2:25"/>مِشِ مُ نْمَ عَ دّفٍدٍ، عَ قٍ قَنيِ كٌلٌن شَ عَلَ مُ عَ مَلِ؟ <verse eid="ECC 2:25"/><verse number="26" style="v" sid="ECC 2:26"/>مِشِ نَشَن نَقَن عَلَ مَ، عَلَ عَ كِمَ شَشِلِ قَنيِ، قَهَامُي، نُن سّيوّ نَن نَ. كْنْ شَشِلِتَرٍ تَن، عَلَ عَ نِيَمَ نّ عَ شَ عَ هَرِفٍ بِرِن سٌ مِشِ فبّتّ يِ رَ نَشَن نَقَن عَلَ مَ. يِ قَن قِندِشِ قٍ قُقَقُ نَن نَ، عَلْ مِشِ نَشَن بِرَ مَ قٌيٍ قْشْ رَ.<verse eid="ECC 2:26"/></para>
  <chapter eid="ECC 2"/>
  <chapter number="3" style="c" sid="ECC 3"/>
  <para style="s">تّمُي نَ قٍ بِرِن مَ</para>
  <para style="q">
    <verse number="1" style="v" sid="ECC 3:1"/>تّمُي نَ قٍ بِرِن مَ،</para>
  <para style="q" vid="ECC 3:1">قٍ بِرِن دُنِحَ مَ، عَ شَ وَشَتِ نَ نَ.<verse eid="ECC 3:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ECC 3:2"/>وَشَتِ ندٍ نَ دِ بَرِقٍ مَ،</para>
  <para style="q" vid="ECC 3:2">وَشَتِ ندٍ نَ قَشَقٍ مَ.</para>
  <para style="q" vid="ECC 3:2">وَشَتِ ندٍ نَ سَنسِ سِقٍ مَ،</para>
  <para style="q" vid="ECC 3:2">وَشَتِ ندٍ نَ سَنسِ شَبَقٍ مَ.<verse eid="ECC 3:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ECC 3:3"/>وَشَتِ ندٍ نَ قَشّ تِقٍ مَ،</para>
  <para style="q" vid="ECC 3:3">وَشَتِ ندٍ نَ دَندَن تِقٍ مَ.</para>
  <para style="q" vid="ECC 3:3">وَشَتِ ندٍ نَ سٍ كَنَقٍ مَ،</para>
  <para style="q" vid="ECC 3:3">وَشَتِ ندٍ نَ سٍ يَءِلَنقٍ مَ.<verse eid="ECC 3:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ECC 3:4"/>وَشَتِ ندٍ نَ وَقٍ مَ،</para>
  <para style="q" vid="ECC 3:4">وَشَتِ ندٍ نَ يٍلٍقٍ مَ.</para>
  <para style="q" vid="ECC 3:4">وَشَتِ ندٍ نَ يَيٍ رَ مِنِقٍ مَ،</para>
  <para style="q" vid="ECC 3:4">وَشَتِ ندٍ نَ قَرٍ بٌرٌنقٍ مَ.<verse eid="ECC 3:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ECC 3:5"/>وَشَتِ ندٍ نَ فّمّيٍ رَيٍنسٍنقٍ مَ،</para>
  <para style="q" vid="ECC 3:5">وَشَتِ ندٍ نَ فّمّيٍ مَلَنقٍ مَ.</para>
  <para style="q" vid="ECC 3:5">وَشَتِ ندٍ نَ سُنبُ تِقٍ مَ،</para>
  <para style="q" vid="ECC 3:5">وَشَتِ ندٍ نَ عَ تِتَرٍيَ مَ.<verse eid="ECC 3:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ECC 3:6"/>وَشَتِ ندٍ نَ سٍ قٍنقٍ مَ،</para>
  <para style="q" vid="ECC 3:6">وَشَتِ ندٍ نَ عَ لُقٍ مَ.</para>
  <para style="q" vid="ECC 3:6">وَشَتِ ندٍ نَ سٍ رَفَتَقٍ مَ،</para>
  <para style="q" vid="ECC 3:6">وَشَتِ ندٍ نَ عَ وْلّقٍ مَ.<verse eid="ECC 3:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="ECC 3:7"/>وَشَتِ ندٍ نَ سٍ عِبْوقٍ مَ،</para>
  <para style="q" vid="ECC 3:7">وَشَتِ ندٍ نَ عَ دّفّقٍ مَ.</para>
  <para style="q" vid="ECC 3:7">وَشَتِ ندٍ نَ وْيّنقٍ مَ،</para>
  <para style="q" vid="ECC 3:7">وَشَتِ ندٍ نَ دُندُقٍ مَ.<verse eid="ECC 3:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ECC 3:8"/>وَشَتِ ندٍ نَ شَنُ تِقٍ مَ،</para>
  <para style="q" vid="ECC 3:8">وَشَتِ ندٍ نَ شْن تِقٍ مَ.</para>
  <para style="q" vid="ECC 3:8">وَشَتِ ندٍ نَ فٍرٍ سٌقٍ مَ،</para>
  <para style="q" vid="ECC 3:8">وَشَتِ ندٍ نَ سَاتَقٍ مَ.<verse eid="ECC 3:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 3:9"/>وَلِكّ فٍينِ مُندُن سْتْمَ عَ شَ كَتّ كُي؟ <verse eid="ECC 3:9"/><verse number="10" style="v" sid="ECC 3:10"/>ﭑ بَرَ كٌتٍ تٌ عَلَ نَشَن دْشْشِ عَدَ مَدِيٍ شُن. <verse eid="ECC 3:10"/><verse number="11" style="v" sid="ECC 3:11"/>عَ بَرَ سٍ بِرِن نَتٌقَن عَ وَشَتِ مَ. عَ بَرَ عَ نِيَ عَدَ مَدِ شَشِلِ شَ سِفَ عَبَدَن قٍ مَ، هَلِ عَ مُ نْ عَلَ شَ وَلِيٍ كٌلٌندٍ كٍلِ عَ قْلّ مَ هَن عَ رَحْنيِ. <verse eid="ECC 3:11"/><verse number="12" style="v" sid="ECC 3:12"/>ﭑ عَ كٌلٌن قٍقٍ مُ نَ نَشَن قَن عَدَ مَدِ بّ، قٌ عَ سّيوَ، عَ قٍ قَنيِ رَبَ عَ شَ دُنِحّءِفِرِ كُي. <verse eid="ECC 3:12"/><verse number="13" style="v" sid="ECC 3:13"/>مِشِ عَ دّفٍقٍ، عَ عَ مِن، عَ سّيوَ عَ شَ وَلِ كُي، نَ نَن قِندِشِ عَلَ شَ كِ رَ عَدَ مَدِ بّ. <verse eid="ECC 3:13"/><verse number="14" style="v" sid="ECC 3:14"/>ﭑ عَ كٌلٌن عَلَ شَ وَلِ بِرِن بُمَ نّ عَبَدَن. سٍسٍ مُ سَمَ عَ شُن مَ، سٍسٍ مُ بَمَ عَ رَ. عَلَ قٍ رَبَمَ نّ عَلَكٌ عَدَ مَدِ شَ فَاشُ عَ يَ رَ.<verse eid="ECC 3:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="ECC 3:15"/>نَشَن نَ نَ، نَ حَن نُ نَ نُ.</para>
  <para style="q" vid="ECC 3:15">نَشَن قَمَ رَبَدٍ، نَ حَن نُ نَ نُ.</para>
  <para style="q" vid="ECC 3:15">عَدَ مَدِ نَشَن نَبَشِ، عَلَ قَمَ نّ نَ مَكِيتِدٍ.<verse eid="ECC 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 3:16"/>ﭑ بَرَ قٍ فبّتّ قَن تٌ يِ دُنِحَ مَ؛</para>
  <para style="q" vid="ECC 3:16">نْندِ مَقِندِ مَ وُلٍ رَ،</para>
  <para style="q" vid="ECC 3:16">تِنشِنيِ مَقِندِ مَ تِنشِنتَرٍيَ رَ.<verse eid="ECC 3:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="ECC 3:17"/>ﭑ نَشَ عَ مَحْشُن ﭑ شَشِلِ كُي،</para>
  <para style="q" vid="ECC 3:17">عَلَ تِنشِنتْي نُن تِنشِنتَرٍ مَكِيتِمَ نّ،</para>
  <para style="q" vid="ECC 3:17">بَرِ مَ قٍ بِرِن عَ وَشَتِ نَ نَ.<verse eid="ECC 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ECC 3:18"/>ﭑ مَن نَشَ عَ مَحْشُن ﭑ شَشِلِ كُي، عَلَ نَ مِشِيٍ مَتٌقٍ نّ، عَلَكٌ عٍ شَ عَ كٌلٌن دَالِسٍ نَن لَنشِ عٍ مَ عَلْ وُلَءِ سُبٍيٍ. <verse eid="ECC 3:18"/><verse number="19" style="v" sid="ECC 3:19"/>عٍ قِرِن بِرِن قَمَ نّ رَحْندٍ يِرٍ كٍرٍن، عٍ قِرِن بِرِن قَشَمَ نّ. عٍ قِرِن بِرِن حّنفِمَ كِ كٍرٍن، عَدَ مَ يٌ سُبٍ يٌ، عٍ بِرِن لَن. قٍ قُقَقُ نَ نَ بِرِن نَ. <verse eid="ECC 3:19"/><verse number="20" style="v" sid="ECC 3:20"/>عٍ بِرِن سِفَدٍ كٍرٍن. عٍ كٍلِشِ بّندّ نّ، عٍ مَن فبِلٍنمَ بّندّ نّ. <verse eid="ECC 3:20"/><verse number="21" style="v" sid="ECC 3:21"/>ندٍ عَ كٌلٌن شَ مِشِ قَشَشِ شَشِلِ تٍمَ كٌورٍ نّ، شَ سُبٍ قَشَشِ شَشِلِ فٌرٌ مَ بْشِ نّ؟<verse eid="ECC 3:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ECC 3:22"/>ﭑ عَ كٌلٌن قٍقٍ مُ نَ نَشَن قَن عَدَ مَدِ بّ، قٌ عَ سّيوَ عَ شَ وَلِ كُي. نَ نَن قِندِشِ عَلَ شَ مَرَفِرِ رَ عَدَ مَدِ بّ. ندٍ نْمَ عَ مَسٍندٍ عَ بّ نَشَن قَمَ رَبَدٍ عَ دَنفِ شَنبِ؟<verse eid="ECC 3:22"/></para>
  <chapter eid="ECC 3"/>
  <chapter number="4" style="c" sid="ECC 4"/>
  <para style="s">قَشَقٍ نُن بَلٌقٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 4:1"/>ﭑ مَن بَرَ ﭑ شَشِلِ رَ سِفَ حَشَنكَتّ بِرِن مَ، نَشَن نَ رَبَقٍ يِ دُنِحَ مَ.</para>
  <para style="q" vid="ECC 4:1">مِشِ حَشَنكَتَشِ نَ وَقٍ،</para>
  <para style="q" vid="ECC 4:1">عٍ مَدُندُ مَ يٌ مُ نَ.</para>
  <para style="q" vid="ECC 4:1">نْي نَ مِشِيٍ بّ نَشٍيٍ نَ عٍ حَشَنكَتَقٍ.</para>
  <para style="q" vid="ECC 4:1">عٍ مَدُندُ مَ يٌ مُ نَ.<verse eid="ECC 4:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ECC 4:2"/>ﭑ بَرَ عَ مَحْشُن، مِشِ قَشَشِ نَن سّيوَشِ دَنفِقٍ مِشِ بَلٌشِ رَ.<verse eid="ECC 4:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ECC 4:3"/>مِشِ نَشَن مُ بَرِشِ سِندٍن،</para>
  <para style="q" vid="ECC 4:3">نٍيٍ شَ هّيرِ دَنفِ مِشِ قَشَشِ نُن مِشِ بَلٌشِ رَ،</para>
  <para style="q" vid="ECC 4:3">بَرِ مَ عٍ مُ حَشَنكَتّ كٌلٌن نَشَن نَ رَبَقٍ يِ دُنِحَ مَ.<verse eid="ECC 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 4:4"/>ﭑ بَرَ عَ تٌ، مِشِ وَلِمَ عٍ شُننَكٍلِ قٍنمَ مِلّ كُي. يِ قَن قِندِشِ قٍ قُقَقُ نَن نَ، عَلْ بِرَقٍ قٌيٍ قْشْ رَ.<verse eid="ECC 4:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ECC 4:5"/>شَشِلِتَرٍ عَ بّلّشّيٍ قِندِفِلِنشِ عَ مَ، عَ مُ وَلِمَ،</para>
  <para style="q" vid="ECC 4:5">هَن عَ شُن نَكَنَ.<verse eid="ECC 4:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ECC 4:6"/>بْحّسَ دٌندٌرٌنتِ قِسَ كَتّ فبٍفبٍ بّ.</para>
  <para style="q" vid="ECC 4:6">نَ كَتّ لُشِ نّ عَلْ مِشِ نَشَن بِرَ مَ قٌيٍ قْشْ رَ.<verse eid="ECC 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 4:7"/>ﭑ بَرَ قٍ قُقَقُ فبّتّ قَن تٌ يِ دُنِحَ مَ.<verse eid="ECC 4:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ECC 4:8"/>شّمّ ندٍ نُ نَ نَشَن نُ نَ عَ كٍرٍنيِ مَ،</para>
  <para style="q" vid="ECC 4:8">مِشِ يٌ مُ نُ نَ عَ بّ.</para>
  <para style="q" vid="ECC 4:8">عَ نُ وَلِمَ تّمُي بِرِن، كْنْ عَ مُ وَ سَ عَ شَ نَاقُلِ رَ.</para>
  <para style="q" vid="ECC 4:8">عَ نَشَ عَ يّتّ مَشْرِن،</para>
  <para style="q" vid="ECC 4:8">«ﭑ نَ وَلِقٍ تْورّ كُي ندٍ بّ؟»</para>
  <para style="q" vid="ECC 4:8">يِ مْولِ قَن قِندِشِ قٍ قُقَقُ نَن نَ.<verse eid="ECC 4:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="ECC 4:9"/>مِشِ قِرِن مَلَنشِ سْونّيَ دَنفِقٍ مِشِ رَ نَشَن لُمَ عَ كٍرٍن.</para>
  <para style="q" vid="ECC 4:9">نَ قِرِنيِيٍ شَ وَلِ دَنفِ نَ مِشِ كٍرٍنيِ فبٍ رَ.<verse eid="ECC 4:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ECC 4:10"/>شَ عَ سَ لِ كٍرٍن بِرَ، عَ بٌورٍ عَ رَكٍلِمَ نّ.</para>
  <para style="q" vid="ECC 4:10">كْنْ مِشِ نَشَن بِرَ مَ، عَ مَلِمَ مُ نَ،</para>
  <para style="q" vid="ECC 4:10">نَ تْورْ مَ نّ عَ حَاشِ رَ.<verse eid="ECC 4:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ECC 4:11"/>نَ مَنِيَشِ مِشِ قِرِن نَن نَ،</para>
  <para style="q" vid="ECC 4:11">نَشٍيٍ سَشِ عٍ بٌورٍ قّ مَ شِنبٍلِ تّمُي،</para>
  <para style="q" vid="ECC 4:11">عٍ نُ وُيٍنيِ سْتْ عٍ بٌورٍ سَابُي رَ.</para>
  <para style="q" vid="ECC 4:11">كْنْ مِشِ نَشَن نَ عَ كٍرٍنيِ مَ، نَ شِنبٍلِ بَمَ دِ؟<verse eid="ECC 4:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="ECC 4:12"/>مِشِ حَاشِ نْمَ نّ مِشِ كٍرٍن نَ،</para>
  <para style="q" vid="ECC 4:12">كْنْ مِشِ قِرِن تَن تِمَ نّ عَ كَنكٍ.</para>
  <para style="q" vid="ECC 4:12">لُوتِ شْرِ سَشَن مَلَنشِ مُ بٌلٌنمَ مَقُرٍن.<verse eid="ECC 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 4:13"/>مِسِكِينّ شَ دِ نَشَن شَشِلِ قَن، عَ سّنبّ فبٌ مَنفّ بّ نَشَن مُ قَتَ مَرَ سِ قَنيِ نُن عَ حَاشِ تَفِ رَ سَدٍ. <verse eid="ECC 4:13"/><verse number="14" style="v" sid="ECC 4:14"/>نَ مِشِ مْولِ نْمَ مِنِدٍ فٍيلِ كُي، عَ قِندِ مَنفّ رَ. عَ بَرِشِ سٍتَرٍحَ نَن كُي، عَ قَ مَنفّيَ سْتْ. <verse eid="ECC 4:14"/><verse number="15" style="v" sid="ECC 4:15"/>دُنِحَ مِشِ بِرِن سَشَنيِ نَن نَبَمَ، عِ نَ دَنفِ مِشِ فبّتّ قَ تِ عِ حْشْي رَ. <verse eid="ECC 4:15"/><verse number="16" style="v" sid="ECC 4:16"/>مِشِ وُيَشِ دَنفِشِ نّ بٍينُن نَ كَنيِ شَ بَرِ. مِشِ نَشٍيٍ قَمَ عَ شَنبِ رَ، عَ شَ قٍ مُ قَمَ رَقَندٍ عٍ مَ. نَ قَن قِندِشِ قٍ قُقَقُ نَن نَ، عَلْ مِشِ نَشَن بِرَقٍ قٌيٍ قْشْ رَ.<verse eid="ECC 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ECC 4:17"/>عِ نَ سِفَ سَلِدٍ عَلَ شَ بَنشِ، عِ شَ عِ يّتّ مَتٌ عَ قَنيِ رَ. عِ نَ سِفَ، عِ شَ عِ تُلِ مَتِ مَسٍنيِ رَ نَشَن تِمَ نَا. نَ تِدٍ فبٌ دَنفِقٍ سّرّشّ بَقٍ رَ نَشَن نَبَمَ شَشِلِتَرٍحَ كُي، بَرِ مَ شَشِلِتَرٍيٍ مُ عَ كٌلٌن، عَ عٍ نَ قٍ كٌبِ نَن شُن مَ نَ كِ.<verse eid="ECC 4:17"/></para>
  <chapter eid="ECC 4"/>
  <chapter number="5" style="c" sid="ECC 5"/>
  <para style="s">لَايِدِ تٌنفٌقٍ عَلَ بّ</para>
  <para style="q">
    <verse number="1" style="v" sid="ECC 5:1"/>عِ نَشَ فبَتَ عِ دّ رَبِدٍ وْيّنيِ شِلِ مَ،</para>
  <para style="q" vid="ECC 5:1">عِ نَشَ فبَتَ لَايِدِ تٌنفٌدٍ عَلَ بّ،</para>
  <para style="q" vid="ECC 5:1">بَرِ مَ عَلَ تَن نَ كٌورٍ نّ، كْنْ عِ تَن نَ بْشِ نَن مَ.</para>
  <para style="q" vid="ECC 5:1">عَوَ، عِ شَ وْيّنيِ نَشَ وُيَ.<verse eid="ECC 5:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ECC 5:2"/>عَلْ شِيٍ تٌ كٍلِمَ مَحْشُنيِ فبٍفبٍ مَ،</para>
  <para style="q" vid="ECC 5:2">شَشِلِتَرٍحَ قَن كٍلِمَ دّ وُيَ نَن مَ.<verse eid="ECC 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 5:3"/>شَ عِ بَرَ لَايِدِ تٌنفٌ عَلَ بّ، عِ نَشَ دُفُندِ عَ رَكَمَلِدٍ. شَشِلِتَرٍحَ مُ رَقَن عَلَ مَ. عَ لَنمَ عِ شَ عِ شَ لَايِدِ رَكَمَلِ. <verse eid="ECC 5:3"/><verse number="4" style="v" sid="ECC 5:4"/>لَايِدِ تٌنفٌتَرٍحَ قِسَ لَايِدِ رَكَمَلِتَرٍحَ بّ. <verse eid="ECC 5:4"/><verse number="5" style="v" sid="ECC 5:5"/>عِ نَشَ تِن عِ شَ وْيّنيِ شَ قِندِ يُنُبِ رَ. عِ نَشَ عَ قَلَ عَلَ شَ شّيرَ بّ، «ﭑ مُ نُ وَ مَ لَايِدِ يَتِ تٌنفٌقٍ.» نَ قٍ مْولِ عَلَ رَشْنْمَ نّ، عَ عَ نِيَ عِ شَ وَلِ شُن شَ رَكَنَ. <verse eid="ECC 5:5"/><verse number="6" style="v" sid="ECC 5:6"/>شِيٍ وُيَشِ سَقٍ نُن وْيّنيِ تِقٍ قِندِشِ قٍ قُقَقُ نَن نَ. نَ كُي عَ لَنمَ عِ شَ فَاشُ عَلَ يَ رَ.<verse eid="ECC 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 5:7"/>عِ نَشَ تّرّننَ شَ عَ سَ لِ عِ مِشِيٍ تٌمَ تَا كُي نَشٍيٍ قُمَ مِسِكِينّيٍ مَ، عٍ سّرِيّ كَنَ، عٍ كِيتِ حَاشِ سَ تِنشِنتْييٍ مَ. مَنفّ عَ بٌورٍ مَنفّ نَن مَلِمَ، هَن عَ مَنفّيَ شُنفبٍ سْتْ. <verse eid="ECC 5:7"/><verse number="8" style="v" sid="ECC 5:8"/>عٍ بِرِن فٍينِمَ شّ سَمَيٍ نَن سَابُي رَ، هَلِ مَنفّ شُنفبٍ.<verse eid="ECC 5:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ECC 5:9"/>كْبِرِ رَقَن مِشِ نَشَن مَ، عَ مُ وَ سَمَ.</para>
  <para style="q" vid="ECC 5:9">بَننَيَ رَقَن نَشَن مَ، عَ نَاقُلِ مُ عَ رَلِمَ.</para>
  <para style="q" vid="ECC 5:9">قٍ قُقَقُ نَن نَ كِ.<verse eid="ECC 5:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="ECC 5:10"/>هَرِفٍ فبٌمَ كِ نَشّ، عَ دٌنمَيٍ قَن فبٌمَ نَ كِ نّ.</para>
  <para style="q" vid="ECC 5:10">نَ كُي مُنَقَنيِ مُندُن نَ هَرِفٍ كَنيِ بّ،</para>
  <para style="q" vid="ECC 5:10">بَ عَ يَ تِقٍ رَ عَ هَرِفٍ رَ؟<verse eid="ECC 5:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="ECC 5:11"/>وَلِكّ لُفَ بَ، عَ مُ لُفَ بَ، عَ شِشْلِ قَنيِ رَبَمَ نّ.</para>
  <para style="q" vid="ECC 5:11">كْنْ بَننَ شَ نَاقُلِ عَ نِيَمَ نّ عَ مُ شِشْلِ قَنيِ رَبَ.<verse eid="ECC 5:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="ECC 5:12"/>ﭑ قٍ مَفَاشُشِ ندٍ رَكْرْ سِشِ يِ دُنِحَ مَ؛</para>
  <para style="q" vid="ECC 5:12">كَنكَنقٍ بَننَيَ مَ هَن عَ بَننَ تْورْ،<verse eid="ECC 5:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="ECC 5:13"/>شَ نَ مُ عَ رَ، بَننَيَ لْيقٍ تْورّ ندٍ سَابُي رَ،</para>
  <para style="q" vid="ECC 5:13">عَ قَ لِ بَننَ شَ دِ مُ كّ سْتْ.<verse eid="ECC 5:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="ECC 5:14"/>عَدَ مَدِ مِنِ كِ نَشّ عَ نفَ تّفّ،</para>
  <para style="q" vid="ECC 5:14">عَ مَن فبِلٍنمَ بّندّ عَ مَفٍلِ رَ نَ كِ نّ.</para>
  <para style="q" vid="ECC 5:14">عَ مُ سٍسٍ شَنِنمَ عَ شُن مَ عَ نَشَن سْتْ عَ شَ وَلِ كُي.<verse eid="ECC 5:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="ECC 5:15"/>يِ قٍ شْرْشْ.</para>
  <para style="q" vid="ECC 5:15">عَدَ مَدِ قَ كِ نَشّ يِ دُنِحَ مَ،</para>
  <para style="q" vid="ECC 5:15">عَ مَن سِفَمَ نَ كِ نّ.</para>
  <para style="q" vid="ECC 5:15">عَ شَ كَتّ قِندِشِ قٍ قُقَقُ نَن نَ.<verse eid="ECC 5:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="ECC 5:16"/>عَ دُنِحَ عِفِرِ مَ دِ مِ نَن كُي،</para>
  <para style="q" vid="ECC 5:16">كْنتْقِلِ، تْورّ، نُن بْحّ مَحَاشُي كُي.<verse eid="ECC 5:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ECC 5:17"/>نَ كُي ﭑ نَشَ عَ قَهَامُ عَ قَن عَدَ مَ بّ شَ عَ عَ دّفٍ، عَ عَ مِن، عَ سّيوَ عَ شَ وَلِ رَ، عَ نَشَن نَبَمَ دُنِحَ مَ عَ شَ سِمَيَ كُي، عَلَ نَشَن نَفِرِشِ عَ مَ نَ نَن قِندِشِ عَ شَ فٍينِ رَ. <verse eid="ECC 5:17"/><verse number="18" style="v" sid="ECC 5:18"/>شَ عَلَ عَ رَفِرِ مِشِ مَ عَ شَ هَرِفٍ سْتْ، عَ قَ سّيوَ نَ رَ هَن عَ وَ سَ، نَ بَرَ قِندِ عَلَ شَ كِ نَن نَ. <verse eid="ECC 5:18"/><verse number="19" style="v" sid="ECC 5:19"/>نَ كُي، عَ مُ كْنتْقِلِمَ عَ شَ سِمَيَ شَ دُنكٍ شَ قٍ رَ، بَرِ مَ عَلَ بَرَ عَ نِيَ عَ بْحّ شَ لُ سّيوّ كُي تُن.<verse eid="ECC 5:19"/></para>
  <chapter eid="ECC 5"/>
  <chapter number="6" style="c" sid="ECC 6"/>
  <para style="s">بَننَيَ نُن سّيوّ</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 6:1"/>ﭑ قٍ شْرْشْي فبّتّ نَن تٌ يِ دُنِحَ مَ؛ <verse eid="ECC 6:1"/><verse number="2" style="v" sid="ECC 6:2"/>عَلَ بَننَيَ نُن بِنيّ رَفِرِشِ مِشِ ندٍ مَ هَن عَ وَ سَ نَ بِرِن نَ، كْنْ عَلَ قَ عَ نِيَ عَ مُ شَن عَ يِ، عَ قَ عَ لُ مِشِ فبّتّ يِ رَ. قٍ قُقَقُ نَن نَ كِ نَشَن شْرْشْ عَ فبٍ رَ.<verse eid="ECC 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 6:3"/>هَلِ مِشِ دِ كّمّ سْتْ، عَ نَشَ سِمَيَ شْن كُيٍ سْتْ، شَ عَ مُ نْمَ سّيوَدٍ عَ هَرِفٍ رَ، حَمَ مُ قَ عَ رَفَتَ فَبُرِ كُي عَ رَفَتَ كِ مَ، دِيْرّ نَشَن بَشِ عَ نفَ قُرِ، نَ قِسَ نَ كَنيِ بّ. <verse eid="ECC 6:3"/><verse number="4" style="v" sid="ECC 6:4"/>نَ دِيْرّ مُ قِندِ مَ عَ رَ، عَ كٍلِمَ دِ مِ نَن كُي، عَ شِلِ يَتِ مُ قَلَمَ. <verse eid="ECC 6:4"/><verse number="5" style="v" sid="ECC 6:5"/>عَ مُ سٌفٍ شَ نَءِيَلَنيِ تٌشِ، عَ مُ سٍسٍ كٌلٌنشِ، كْنْ عَ شَ قٍ قِسَ نَ نَاقُلِ كَنيِ بّ، <verse eid="ECC 6:5"/><verse number="6" style="v" sid="ECC 6:6"/>هَلِ نَاقُلِ كَنيِ قَ لُ دُنِحَ مَ حّ وُلُ قِرِن سّيوّتَرٍحَ كُي. عٍ بِرِن مُ سِفَمَ عَلِفِيَمَ شّ؟<verse eid="ECC 6:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="ECC 6:7"/>مِشِ شَ كَتّ بِرِن نَبَمَ قُرِ قٍ نَن مَ قٍ رَ،</para>
  <para style="q" vid="ECC 6:7">كْنْ عَ مُ وَ سَمَ قٍوٌ.<verse eid="ECC 6:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ECC 6:8"/>مُنسٍ لُمَ شَشِلِمَ يِ رَ نَشَن مُ نَ شَشِلِتَرٍ يِ رَ؟</para>
  <para style="q" vid="ECC 6:8">مُنسٍ لُمَ مِسِكِينّ بّ شَ عَ حّرّ كِ قَن عَ بٌورٍ يَ شْرِ؟<verse eid="ECC 6:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ECC 6:9"/>سٍ تٌشِ قِسَ مَحْشُنيِ بّ؟</para>
  <para style="q" vid="ECC 6:9">قٍ قُقَقُ نَن نَ كِ</para>
  <para style="q" vid="ECC 6:9">نَشَن لُشِ عَلْ مِشِ نَشَن بِرَقٍ قٌيٍ قْشْ رَ.<verse eid="ECC 6:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="ECC 6:10"/>دَالِسٍ بِرِن حَن بَرَ شِلِ سْتْ،</para>
  <para style="q" vid="ECC 6:10">عَدَ مَ نَشَن نُ نَ، عَ حَن بَرَ كٌلٌن.</para>
  <para style="q" vid="ECC 6:10">عَدَ مَ مُ نْمَ مِشِ رَ نَشَن سّنبّ فبٌ عَ بّ.<verse eid="ECC 6:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ECC 6:11"/>وْيّنيِ نَ فبٌ، قٍ قُقَقُ قَن فبٌمَ نّ.</para>
  <para style="q" vid="ECC 6:11">عَ مُ مِشِ يٌ مَلِمَ.<verse eid="ECC 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 6:12"/>ندٍ عَ كٌلٌن قٍ نَشَن قَن عَدَ مَدِ بّ عَ شَ دُنِحّءِفِرِ كُي، نَشَن دَنفِمَ مَقُرٍن مَقُرٍن عَلْ نِينِ؟ ندٍ نْمَ عَ قَلَدٍ عَ بّ قٍ نَشَن نَبَمَ عَ قَشَ شَنبِ؟<verse eid="ECC 6:12"/></para>
  <chapter eid="ECC 6"/>
  <chapter number="7" style="c" sid="ECC 7"/>
  <para style="s">شَشِلِ قَنيِ</para>
  <para style="q">
    <verse number="1" style="v" sid="ECC 7:1"/>شِلِ قَنيِ قَن دَنفِ لَبُندّ قَنيِ رَ.</para>
  <para style="q" vid="ECC 7:1">عِ قَشَ لْشْي قَن دَنفِ عِ بَرِ لْشْي رَ.<verse eid="ECC 7:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ECC 7:2"/>سٌقٍ كَاحّ بَنشِ قِسَ سٌقٍ شُلُن بَنشِ بّ،</para>
  <para style="q" vid="ECC 7:2">بَرِ مَ قَشّ رَفِرِشِ عَدَ مَ بِرِن بّ.</para>
  <para style="q" vid="ECC 7:2">عَ لَنمَ مِشِ بَلٌشِ شَ رَتُ نَ مَ.<verse eid="ECC 7:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ECC 7:3"/>سُننُنيِ قِسَ يٍلٍ بّ،</para>
  <para style="q" vid="ECC 7:3">بَرِ مَ مِشِ بْحّ قَنيِ سْتْمَ نّ سُننُنيِ كُي.<verse eid="ECC 7:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ECC 7:4"/>شَشِلِمَ عَ حْشْ رَ سِفَمَ نّ قَشّ مَ،</para>
  <para style="q" vid="ECC 7:4">شَشِلِتَرٍ تَن نَ يٍلٍقٍ نَن تُي.<verse eid="ECC 7:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ECC 7:5"/>شَشِلِمَ شَ شُرُي قِسَ شَشِلِتَرٍ شَ مَتْشْي بّ.<verse eid="ECC 7:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ECC 7:6"/>شَشِلِتَرٍ شَ يٍلٍ لُشِ نّ</para>
  <para style="q" vid="ECC 7:6">عَلْ بٌلٍيٍ نَشٍيٍ مَبُلَمَ تُندٍ بُن مَ.</para>
  <para style="q" vid="ECC 7:6">قٍ قُقَقُ نَن نَ كِ.<verse eid="ECC 7:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="ECC 7:7"/>كْبِرِ تِنشِنتَرٍ عَ نِيَمَ نّ شَشِلِمَ شَ قِندِ شَشِلِتَرٍ رَ،</para>
  <para style="q" vid="ECC 7:7">يٍ دْشْي عَ بْحّ مَقِندِ مَ نّ.<verse eid="ECC 7:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="ECC 7:8"/>قٍ رَحْنيِ قِسَ عَ قْلّ بّ.</para>
  <para style="q" vid="ECC 7:8">مِشِ سَبَرِشِ قِسَ يّتّ عِفبٌي بّ.<verse eid="ECC 7:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ECC 7:9"/>عِ بْحّ نَشَ فبَتَ تٍدٍ،</para>
  <para style="q" vid="ECC 7:9">بَرِ مَ شَشِلِتَرٍيٍ بْحّ نَن تٍمَ.<verse eid="ECC 7:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="ECC 7:10"/>عِ نَشَ لُ عَ قَلَ رَ، «سِنفٍ دَنفِ يَكْسِ رَ.»</para>
  <para style="q" vid="ECC 7:10">شَشِلِمَيَ وْيّنيِ مُ نَ نَ رَ.<verse eid="ECC 7:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="ECC 7:11"/>شَشِلِمَيَ لُشِ نّ عَلْ كّ،</para>
  <para style="q" vid="ECC 7:11">عَ مُنَقَنيِ نَ دُنِحَ مِشِ بِرِن بّ.<verse eid="ECC 7:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="ECC 7:12"/>شَشِلِمَيَ قِندِشِ مِشِ شَ كَنتَرِ نَن نَ،</para>
  <para style="q" vid="ECC 7:12">كْبِرِ قَن قِندِشِ مِشِ شَ كَنتَرِ نَن نَ،</para>
  <para style="q" vid="ECC 7:12">كْنْ شَشِلِمَيَ نَن قِسَ،</para>
  <para style="q" vid="ECC 7:12">بَرِ مَ عَ شَشِلِمَ رَكِسِمَ.<verse eid="ECC 7:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="ECC 7:13"/>عَلَ شَ وَلِ مَتٌ.</para>
  <para style="q" vid="ECC 7:13">عَ نَشَن مَدَلِن، ندٍ نْمَ نَ مَتِنشِندٍ؟<verse eid="ECC 7:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="ECC 7:14"/>عِ شَ سّيوَ هّيرِ تّمُي.</para>
  <para style="q" vid="ECC 7:14">تْورّ تّمُي نَ عَ لِ، عِ شَ رَتُ عَ مَ،</para>
  <para style="q" vid="ECC 7:14">عَ عَلَ نَن نَ قِرِنيِ بِرِن دَاشِ.</para>
  <para style="q" vid="ECC 7:14">نَ كُي عَدَ مَدِ مُ نْمَ عَ شَ تِنَ كٌلٌندٍ.<verse eid="ECC 7:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="ECC 7:15"/>ﭑ مَ سِمَيَ قُقَقُ كُي،</para>
  <para style="q" vid="ECC 7:15">ﭑ عَ تٌشِ نّ تِنشِنتْي ندٍ قَشَ سِمَيَ دُنكٍ كُي هَلِ عَ تٌ تِنشِنشِ،</para>
  <para style="q" vid="ECC 7:15">تِنشِنتَرٍ ندٍ بُ دُنِحَ هَلِ عَ تٌ مُ تِنشِن.<verse eid="ECC 7:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="ECC 7:16"/>عِ نَشَ عِ يّتّ قِندِ تِنشِنتْي رَ،</para>
  <para style="q" vid="ECC 7:16">عِ نَشَ عِ يّتّ قِندِ لْننِلَ رَ،</para>
  <para style="q" vid="ECC 7:16">شَ نَ مُ عَ رَ عِ عِ يّتّ كَنَمَ نّ.<verse eid="ECC 7:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="ECC 7:17"/>عِ نَشَ قِندِ تِنشِنتَرٍ رَ،</para>
  <para style="q" vid="ECC 7:17">شَ نَ مُ عَ رَ عِ قَشَمَ نّ بٍينُ عِ شَ وَشَتِ شَ عَ لِ.<verse eid="ECC 7:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="ECC 7:18"/>عَ لَنمَ عِ شَ عِ حْشْ سَ نَ مَرَ سِ قِرِنيِ شْن مَ.</para>
  <para style="q" vid="ECC 7:18">عَلَ شَ يَرَفَاشُي شَ قٍ سْونّيَمَ نّ نَ بِرِن كُي.<verse eid="ECC 7:18"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="19" style="v" sid="ECC 7:19"/>شَشِلِمَ شَ شَشِلِمَيَ عَ سّنبّ فبٌمَ نّ دَنفِ تَا مَنفّ قُ رَ.<verse eid="ECC 7:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="ECC 7:20"/>تِنشِنتْي مُ نَ يِ دُنِحَ مَ،</para>
  <para style="q" vid="ECC 7:20">نَشَن قٍ قَنيِ تُن نَبَمَ، عَ مُ يُنُبِ يٌ رَبَ.<verse eid="ECC 7:20"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="21" style="v" sid="ECC 7:21"/>عِ نَشَ عِ تُلِ مَتِ مِشِ شَ وْيّنيِ بِرِن نَ،</para>
  <para style="q" vid="ECC 7:21">شَ نَ مُ عَ رَ عِ قَمَ عِ شَ كٌنيِ شُي مّدٍ عَ عِ دَنكَمَ،<verse eid="ECC 7:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="ECC 7:22"/>عَلْ عِ تَن يَتِ بَرَ عَ رَبَ سَنيَ وُيَشِ مِشِيٍ رَ.<verse eid="ECC 7:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="ECC 7:23"/>ﭑ نَ بِرِن عِفبّشِ نّ شَشِلِمَيَ رَ.</para>
  <para style="q" vid="ECC 7:23">ﭑ نَشَ عَ قَلَ، «ﭑ شَ قِندِ شَشِلِمَ رَ،»</para>
  <para style="q" vid="ECC 7:23">كْنْ ﭑ مُ نْ.<verse eid="ECC 7:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="ECC 7:24"/>شَشِلِمَيَ تَن تِلِن، عَ مَكُيَ وٌن نَ،</para>
  <para style="q" vid="ECC 7:24">ندٍ نْمَ عَ قَهَامُدٍ؟<verse eid="ECC 7:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="ECC 7:25"/>نَ كُي ﭑ نَشَ كَتَ نَ كٌلٌندٍ،</para>
  <para style="q" vid="ECC 7:25">ﭑ شَ سٌ شَشِلِمَيَ كُي، ﭑ شَ قَهَامُي سْتْ،</para>
  <para style="q" vid="ECC 7:25">ﭑ شَ عَ كٌلٌن تِنشِنتَرٍيَ قِندِشِ شَشِلِتَرٍحَ نَن نَ،</para>
  <para style="q" vid="ECC 7:25">شَشِلِتَرٍحَ قَن قِندِشِ دَشُحَ نَن نَ.<verse eid="ECC 7:25"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="26" style="v" sid="ECC 7:26"/>ﭑ بَرَ قٍ ندٍ تٌ نَشَن شْنْ دَنفِ قَشّ رَ.</para>
  <para style="q" vid="ECC 7:26">فِنّ نَ عَ رَ نَشَن قِندِشِ يّلّ رَ،</para>
  <para style="q" vid="ECC 7:26">نَشَن بْحّ قِندِشِ فَنتَنيِ رَ،</para>
  <para style="q" vid="ECC 7:26">نَشَن بّلّشّيٍ لُشِ عَلْ لُوتِ بَلَنشِ.</para>
  <para style="q" vid="ECC 7:26">مِشِ نَشَن نَقَن عَلَ مَ،</para>
  <para style="q" vid="ECC 7:26">عَ كٍلِمَ نّ نَ فِنّ شُن مَ،</para>
  <para style="q" vid="ECC 7:26">كْنْ نَ فِنّ يُنُبِتْي نَن مَسْتْمَ.<verse eid="ECC 7:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="ECC 7:27"/>ﭑ تَن كَوَندِلَ يِ نَن تٌ ﭑ مَ قٍ مَتٌشِ بِرِن كُي؛<verse eid="ECC 7:27"/></para>
  <para style="q">
    <verse number="28" style="v" sid="ECC 7:28"/>ﭑ نَشَ شّمّ تِنشِنشِ كٍرٍن تٌ شّمّ وُلُ يَ مَ،</para>
  <para style="q" vid="ECC 7:28">ﭑ نَشَ عَ قٍن هَن،</para>
  <para style="q" vid="ECC 7:28">كْنْ ﭑ مُ فِنّ يٌ تٌ حَمَ يَ مَ نَشَن تِنشِن.<verse eid="ECC 7:28"/></para>
  <para style="q">
    <verse number="29" style="v" sid="ECC 7:29"/>ﭑ يِ نَن فبَنسَن تٌ كْرّ؛</para>
  <para style="q" vid="ECC 7:29">عَلَ عَدَ مَدِيٍ دَاشِ نّ عٍ تِنشِنشِ،</para>
  <para style="q" vid="ECC 7:29">كْنْ عٍ تَن نَشَ عٍ يّتّ مَدَشُ.<verse eid="ECC 7:29"/></para>
  <chapter eid="ECC 7"/>
  <chapter number="8" style="c" sid="ECC 8"/>
  <para style="s">شَشِلِمَيَ نُن مَنفّيَ</para>
  <para style="q">
    <verse number="1" style="v" sid="ECC 8:1"/>شَشِلِمَ مَنِيّ مُ نَ.</para>
  <para style="q" vid="ECC 8:1">ندٍ قَتَ قٍ تِلِنشِ قَتَنقَسِدٍ؟</para>
  <para style="q" vid="ECC 8:1">شَشِلِمَ يَتَفِ نْرْ مَ عَ شَ شَشِلِمَيَ سَابُي نَن نَ،</para>
  <para style="q" vid="ECC 8:1">عَ لَهَلّ مَسَرَ مَ نّ.<verse eid="ECC 8:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ECC 8:2"/>ﭑ شَ عَ قَلَ وٌ بّ، عَ لَنمَ وٌ شَ مَنفّ شَ يَامَرِ رَبَتُ، بَرِ مَ وٌ بَرَ وٌ رَكَلِ عَلَ يَ شْرِ. <verse eid="ECC 8:2"/><verse number="3" style="v" sid="ECC 8:3"/>عِ نَشَ فبَتَ كٍلِدٍ مَنفّ يَ شْرِ. عِ نَشَ تِ قٍقٍ شَنبِ رَ نَشَن مُ قَن. مَنفّ عَ وَشْنقٍ نَن نَبَمَ. <verse eid="ECC 8:3"/><verse number="4" style="v" sid="ECC 8:4"/>عَ لُ كِ يٌ كِ، نْي نَ مَنفّ نَن يِ. ندٍ نْمَ عَ مَتَندِدٍ؟<verse eid="ECC 8:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ECC 8:5"/>مِشِ نَشَن مَنفّ شَ يَمَرِ رَبَتُمَ،</para>
  <para style="q" vid="ECC 8:5">قٍ حَاشِ يٌ مُ عَ سْتْمَ.</para>
  <para style="q" vid="ECC 8:5">شَشِلِمَ عَ حّرّ كِ نُن حّرّ وَشَتِ كٌلٌن.<verse eid="ECC 8:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ECC 8:6"/>قٍ بِرِن لَنمَ عَ شَ رَبَ عَ وَشَتِ نُن عَ كّحَ مَ،</para>
  <para style="q" vid="ECC 8:6">هَلِ نَ قَ قِندِ مَ قٍ شْرْشْي رَ مِشِ بّ.<verse eid="ECC 8:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="ECC 8:7"/>مِشِ تٌ مُ عَ كٌلٌن قٍ نَشٍيٍ قَمَ رَبَدٍ،</para>
  <para style="q" vid="ECC 8:7">ندٍ نْمَ نٍيٍ تَفِ رَبَدٍ عَ بّ؟<verse eid="ECC 8:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ECC 8:8"/>مِشِ يٌ مُ نْمَ عَ حّنفِ يَمَرِدٍ،</para>
  <para style="q" vid="ECC 8:8">مِشِ يٌ مُ نْمَ عَ قَشَ لْشْي سُفَندِدٍ.</para>
  <para style="q" vid="ECC 8:8">مِشِ مُ نْمَ كٍلِدٍ فٍرٍ شُن مَ،</para>
  <para style="q" vid="ECC 8:8">تِنشِنتَرٍيَ مُ قٍ كٌبِ رَبَيٍ بّحِنمَ.<verse eid="ECC 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 8:9"/>ﭑ بَرَ يِ بِرِن رَكْرْ سِ دُنِحَ مَ. ﭑ نَشَ مِشِ تٌ عَ نَ عَ بٌورٍ يَمَرِقٍ، عَ قَ عَ يّتّ تْورْ نَ كُي. <verse eid="ECC 8:9"/><verse number="10" style="v" sid="ECC 8:10"/>ﭑ نَشَ مِشِ حَاشِيٍ تٌ نَشٍيٍ رَفَتَمَ بِنيّ كُي، مِشِيٍ نُ نَشٍيٍ مَتْشْمَ هْرْ مْلِنفِرَ يِرٍ تَا كُي. قٍ قُقَقُ نَن نَ كِ.<verse eid="ECC 8:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 8:11"/>شَ قٍ كٌبِ رَبَيٍ مُ حَشَنكَتّ سْتْ عَ تّمُي، حَمَ قَن قَمَ نّ بِرَدٍ عٍ وَشْنقٍ حَاشِيٍ قْشْ رَ. <verse eid="ECC 8:11"/><verse number="12" style="v" sid="ECC 8:12"/>ﭑ عَ كٌلٌن هَلِ قٍ كٌبِ رَبَيٍ فبِلٍن قٍ حَاشِ رَبَقٍ رَ هَن سَنمَيَ كّمّ، سْونّيَ تَن نَبَمَ نّ مِشِ بّ نَشَن فَاشُمَ عَلَ يَ رَ، نَشَن لُمَ عَ بَتُ رَ. <verse eid="ECC 8:12"/><verse number="13" style="v" sid="ECC 8:13"/>كْنْ قٍ مُ سْونّيَمَ مِشِ حَاشِيٍ بّ نَشٍيٍ مُ فَاشُمَ عَلَ يَ رَ، عٍ شَ سِمَيَ شْن مُ كُيَمَ عَلْ مِشِ نِينِ.<verse eid="ECC 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ECC 8:14"/>قٍ قُقَقُ فبّتّ نَ نَ يِ دُنِحَ مَ؛ قٍ شْرْشْي نَشَن لَن عَ شَ دْشْ مِشِ حَاشِ مَ، نَ نَن دْشْمَ تِنشِنتْي مَ. قٍ قَنيِ نَشَن لَن عَ شَ رَبَ تِنشِنتْي بّ، نَ نَن نَبَمَ مِشِ حَاشِ بّ. ﭑ شَ عَ قَلَ وٌ بّ، نَ قٍ مْولِ قِندِشِ قٍ قُقَقُ نَن نَ. <verse eid="ECC 8:14"/><verse number="15" style="v" sid="ECC 8:15"/>نَ كُي عَ لَنمَ عَدَ مَ شَ سّيوَ عَ شَ دُنِحّءِفِرِ كُي. قٍ يٌ مُ نَ نَشَن قِسَ يِ بّ؛ مِشِ لَنمَ عٍ شَ عٍ دّفٍ، عٍ شَ عٍ مِن، عٍ شَ سّيوَ. نَ كِ عَ سّيوَ مَ نّ عَ شَ وَلِ رَ عَ شَ دُنِحّءِفِرِ كُي، عَلَ نَشَن قِشِ عَ مَ دُنِحَ بّندّ قُحِ قَرِ.<verse eid="ECC 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 8:16"/>ﭑ تٌ نَتّ تٌنفٌ ﭑ شَ قَهَامُي سْتْ عَدَ مَدِ شَ وَلِ شَ قٍ رَ، عَ نَشَن نَبَمَ كْي نُن يَنيِ، <verse eid="ECC 8:16"/><verse number="17" style="v" sid="ECC 8:17"/>ﭑ نَشَ عَلَ شَ وَلِ مَتٌ. مِشِ يٌ مُ نْمَ سٌدٍ قٍ بِرِن كُي نَشَن نَبَمَ دُنِحَ مَ. هَلِ عَ كَتَ هَن، عَ مُ عَ كٌلٌنمَ قٍوٌ. هَلِ شَشِلِمَ نَشَن عَ قَلَمَ عَ بَرَ فّ نَ كٌلٌندٍ، عَ مُ نْمَ نَ كٌلٌندٍ يَتِ يَتِ.<verse eid="ECC 8:17"/></para>
  <chapter eid="ECC 8"/>
  <chapter number="9" style="c" sid="ECC 9"/>
  <para style="s">عَدَ مَدِ مُ يَرٍ كٌلٌن</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 9:1"/>ﭑ تٌ ﭑ مَحْشُن نَ قٍ بِرِن مَ، ﭑ عَ تٌشِ نّ تِنشِنتْييٍ، شَشِلِمَيٍ، نُن عٍ شَ كَتّ بِرِن كٍلِمَ عَلَ نَن مَ. عَدَ مَدِ مُ عَ كٌلٌن عَ قَمَ نَشَن لِدٍ عَ يَرَ، شَنُنتٍيَ شَ نَ مُ عَ رَ شْننَنتٍيَ. نَ بِرِن نَ عَلَ نَن يِ. <verse eid="ECC 9:1"/><verse number="2" style="v" sid="ECC 9:2"/>عَدَ مَدِ بِرِن سِفَمَ نّ عَلِفِيَمَ. تِنشِنتْي بَ، تِنشِنتَرٍ بَ، سّنِيّنتْي بَ، سّنِيّنتَرٍ بَ، سّرّشّبَ بَ، سّرّشّبَتَرٍ بَ.</para>
  <para style="q" vid="ECC 9:2">مِشِ قَنيِ بَ، مِشِ حَاشِ بَ</para>
  <para style="q" vid="ECC 9:2">عٍ بِرِن سِفَمَ نّ عَلِفِيَمَ.</para>
  <para style="q" vid="ECC 9:2">مِشِ نَشَن لَايِدِ تٌنفٌمَ بَ،</para>
  <para style="q" vid="ECC 9:2">مِشِ نَشَن مُ سُو سَمَ نَ تٌنفٌدٍ بَ،</para>
  <para style="q" vid="ECC 9:2">عٍ بِرِن سِفَمَ نّ عَلِفِيَمَ.<verse eid="ECC 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 9:3"/>قٍ شْرْشْي نَن يِ كِ قٍ بِرِن يَ مَ دُنِحَ مَ؛ مَرَحْن كِ كٍرٍن نَن نَ نٍيٍ بِرِن بّ. عَدَ مَدِيٍ بْحّ رَقٍشِ قٍ حَاشِ نَن نَ، عٍ وَلِمَ شَشِلِتَرٍحَ نَن نَ عٍ شَ دُنِحّءِفِرِ كُي. نَ دَنفِ شَنبِ، عٍ قَشَمِشِيٍ لِمَ نّ عَلِفِيَمَ. <verse eid="ECC 9:3"/><verse number="4" style="v" sid="ECC 9:4"/>مِشِ بَلٌشِ فبَنسَن نْمَ عَ شَشِلِ تِدٍ قٍ ندٍ مَ. بَرٍ حِحّ قِسَ يّتّ قَشَشِ بّ.<verse eid="ECC 9:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ECC 9:5"/>نَشٍيٍ بَلٌشِ، نٍيٍ عَ كٌلٌن عَ عٍ قَشَمَ نّ،</para>
  <para style="q" vid="ECC 9:5">كْنْ مِشِ قَشَشِيٍ تَن مُ قٍقٍ كٌلٌن.</para>
  <para style="q" vid="ECC 9:5">سَرٍ قِ يٌ مُ نَ عٍ بّ سْنْن،</para>
  <para style="q" vid="ECC 9:5">عٍ شَ قٍ يَتِ بَرَ نّيمُ مِشِيٍ رَ.<verse eid="ECC 9:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ECC 9:6"/>عٍ شَ شَنُنتٍيَ، عٍ شَ شْننَنتٍيَ، عٍ وَشْنقٍ، نٍيٍ بِرِن بَرَ حْن.</para>
  <para style="q" vid="ECC 9:6">عٍ تَن فبٍ يٌ مُ نَ يِ دُنِحَ قٍيٍ تَن يَ مَ سْنْن.<verse eid="ECC 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 9:7"/>سِفَ، عِ عِ دّفٍ سّيوّ كُي، عِ عِ شَ وّنِ مِن بْحّ قَنيِ كُي. عَلَ وَ مَ نَ نَن شْن عِ بّ. <verse eid="ECC 9:7"/><verse number="8" style="v" sid="ECC 9:8"/>عِ شَ سٌسٍ قِيشّ رَفٌرٌ عِ مَ، عِ شَ لَبُندّ قَنيِ سَ عِ قَتٍ مَ. <verse eid="ECC 9:8"/><verse number="9" style="v" sid="ECC 9:9"/>عِ شَ دُنِحَ عِفِرِ سّيوّ كُي وٌ نُن عِ شَنُنتٍنيِ فِنّ. عَلَ بَرَ يِ سِمَيَ نَن قِ عِ مَ. هَلِ عَ تٌ دَنفِمَ عَلْ قٌيٍ، هَلِ عَ شْرْشْ، عَلَ شَ مَرَفِرِ نَ عَ رَ عِ بّ. <verse eid="ECC 9:9"/><verse number="10" style="v" sid="ECC 9:10"/>عِ نْمَ وَلِ نَشَن نَ، عِ شَ نَ رَبَ عِ سّنبّ بِرِن نَ، بَرِ مَ عِ نَشَن نَبَمَ دُنِحَ مَ، عَلْ وَلِقٍ، قٍ مَتٌقٍ، قٍ قَهَامُقٍ، نُن قٍ كٌلٌنقٍ، نَ سٍسٍ مُ نَ عَلِفِيَمَ عِ سِفَقٍ دّننَشّ.<verse eid="ECC 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 9:11"/>ﭑ مَن بَرَ قٍ فبّتّ تٌ يِ دُنِحَ مَ؛</para>
  <para style="q" vid="ECC 9:11">نَشَن شُلُن دَنفِ عَ بٌورٍ رَ، عَ مُ فبَتَ فٍينِمَ تّمُي بِرِن شّ،</para>
  <para style="q" vid="ECC 9:11">نَشَن سّنبّ فبٌ دَنفِ عَ بٌورٍ رَ، عَ مُ فٍرٍ فٍينِمَ تّمُي بِرِن شّ،</para>
  <para style="q" vid="ECC 9:11">نَشَن شَشِلِ قَن عَ بٌورٍ بّ، عَ مُ دٌنسٍ سْتْمَ تّمُي بِرِن شّ،</para>
  <para style="q" vid="ECC 9:11">نَشَن مَ لْننِ دَنفِ عَ بٌورٍ رَ، عَ مُ نَاقُلِ سْتْمَ تّمُي بِرِن شّ،</para>
  <para style="q" vid="ECC 9:11">نَشَن شَ قَهَامُي فبٌ عَ بٌورٍ بّ، عَ مُ هِننّ سْتْمَ تّمُي بِرِن شّ.</para>
  <para style="q" vid="ECC 9:11">عَلَ شَ مَرَفِرِ تَن قٍ بِرِن نَبَمَ عَ وَشَتِ نّ.<verse eid="ECC 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 9:12"/>مِشِ يٌ مُ عَ كٌلٌن قٍ قَمَ عَ لِدٍ تّمُي نَشّ؛</para>
  <para style="q" vid="ECC 9:12">يّشّ سُشُمَ نّ يّلّ شْرْشْي كُي،</para>
  <para style="q" vid="ECC 9:12">شْنِ سُشُمَ نّ فَنتَنيِ رَ.</para>
  <para style="q" vid="ECC 9:12">نَ كِ قٍ شْرْشْي عَدَ مَدِ تّرّننَمَ نّ كٍرٍنيِ رَ.<verse eid="ECC 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 9:13"/>ﭑ مَن بَرَ يِ شَشِلِمَيَ مِسَالِ تٌ دُنِحَ مَ نَشَن تِدٍ فبٌ. <verse eid="ECC 9:13"/><verse number="14" style="v" sid="ECC 9:14"/>تَا شُرِ ندٍ نُ نَ، مِشِ مُ نُ فبٌ دّننَشّ. مَنفّ سّنبّمَ ندٍ نَشَ نَ تَا فٍرٍ، عَ قَ تٍدٍ يَءِلَن نَ تَا تّتّ بُنيِ. <verse eid="ECC 9:14"/><verse number="15" style="v" sid="ECC 9:15"/>نَ تَاكَ ندٍ نُ نَ، نَشَن قِندِشِ سٍتَرٍ شَشِلِمَ رَ. عَ نَشَ نَ تَا رَكِسِ عَ شَ شَشِلِمَيَ سَابُي رَ، كْنْ نَ دَنفِ شَنبِ مِشِ يٌ مُ رَتُ عَ شَ قٍ مَ. <verse eid="ECC 9:15"/><verse number="16" style="v" sid="ECC 9:16"/>نَ كُي ﭑ نَشّ،</para>
  <para style="q" vid="ECC 9:16">شَشِلِمَيَ قِسَ حَلَمَيَ بّ،</para>
  <para style="q" vid="ECC 9:16">كْنْ سٍتَرٍ شَ شَشِلِمَيَ مَبٍرٍ مَ نّ،</para>
  <para style="q" vid="ECC 9:16">مِشِ مُ عَ شَ مَسٍنيِ سُشُمَ.<verse eid="ECC 9:16"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="17" style="v" sid="ECC 9:17"/>شَشِلِمَ شَ مَسٍنيِ رَشَرَشِ رَ مّقٍ،</para>
  <para style="q" vid="ECC 9:17">نَ قِسَ مَنفّ شَ سْنشْي رَتٍ بّ شَشِلِتَرٍيٍ تَفِ.<verse eid="ECC 9:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="ECC 9:18"/>شَشِلِمَيَ قِسَ فٍرٍ سٌسٍيٍ بّ،</para>
  <para style="q" vid="ECC 9:18">كْنْ يُنُبِتْي كٍرٍن فبَنسَن نْمَ قٍ قَنيِ فبٍفبٍ شُن نَكَنَدٍ.<verse eid="ECC 9:18"/></para>
  <chapter eid="ECC 9"/>
  <chapter number="10" style="c" sid="ECC 10"/>
  <para style="s">تَالِ وْيّنيِ</para>
  <para style="q">
    <verse number="1" style="v" sid="ECC 10:1"/>تُفِتُفِ نَ قَشَ لَبُندّ شُن مَ، لَبُندّ شِرِ كَنَمَ نّ.</para>
  <para style="q" vid="ECC 10:1">شَشِلِتَرٍحَ نَن شُي مّمَ دَنفِقٍ شَشِلِمَيَ شُي رَ.<verse eid="ECC 10:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="ECC 10:2"/>شَشِلِمَ بْحّ مَتِنسٍ،</para>
  <para style="q" vid="ECC 10:2">شَشِلِتَرٍ بْحّ حَاشُ.<verse eid="ECC 10:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ECC 10:3"/>شَشِلِتَرٍ عَ شَ شَشِلِتَرٍحَ مَسٍنمَ نّ بِرِن بّ عَ شَ حّرّ كُي.<verse eid="ECC 10:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ECC 10:4"/>شَ عِ شَ مَنفّ شْنْ عِ مَ، عِ نَشَ كٍلِ عِ شَ وَلِ شُن مَ،</para>
  <para style="q" vid="ECC 10:4">عِ شَ سَبَرِ قٍ شْرْشْي رَبْرْشْمَ.<verse eid="ECC 10:4"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="5" style="v" sid="ECC 10:5"/>ﭑ قٍ شْرْشْي ندٍ قَن تٌشِ يِ دُنِحَ مَ نَشَن كٍلِشِ مَنفّ مَ؛<verse eid="ECC 10:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ECC 10:6"/>عَ نْي قِمَ نّ شَشِلِتَرٍ ندٍ مَ،</para>
  <para style="q" vid="ECC 10:6">بَننَ ندٍ تَن مُ نْي يٌ سْتْ.<verse eid="ECC 10:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="ECC 10:7"/>ﭑ بَرَ كٌنيِ ندٍ تٌ عَ سٌي رَفِمَ،</para>
  <para style="q" vid="ECC 10:7">مَنفّ ندٍ قَ عَ حّرّ عَ سَنيِ رَ.<verse eid="ECC 10:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="ECC 10:8"/>يِلِ فٍ نْمَ بِرَدٍ عَ شَ يِلِ فٍشِ كُي،</para>
  <para style="q" vid="ECC 10:8">مِشِ نَشَن يَلٍ تِمَ تّتّ مَ، بْشِمَسٍ نْمَ نَ قَن شِندٍ.<verse eid="ECC 10:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="ECC 10:9"/>مِشِ نَشَن فّمّ مَسٌلِمَ، عَ نْمَ عَ مَشْنْدٍ فّمّ رَ.</para>
  <para style="q" vid="ECC 10:9">مِشِ نَشَن يٍفٍ بْو مَ، عَ نْمَ عَ مَشْنْدٍ يٍفٍ رَ.<verse eid="ECC 10:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ECC 10:10"/>شَ بٍيرَ كٌلٍ تٌرِشِ، عَ مُ رَلُفَن، نَ عَ نِيَمَ نّ وَلِ شَ شْرْشْ.</para>
  <para style="q" vid="ECC 10:10">شَشِلِمَيَ شُننَكٍلِ قِمَ مِشِ مَ نَ كِ نّ.<verse eid="ECC 10:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="ECC 10:11"/>شَ بْشِمَسٍ مِشِ شِن بٍينُن بْشِمَسٍ سُشُمَ شَ عَ سُشُ،</para>
  <para style="q" vid="ECC 10:11">مِشِ نَشَن بْشِمَسٍ سُشُمَ، عَ مُ فٍينِمَ.<verse eid="ECC 10:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="ECC 10:12"/>هِننّ فبٍفبٍ نَ شَشِلِمَ شَ مَسٍنيِ كُي،</para>
  <para style="q" vid="ECC 10:12">كْنْ شَشِلِتَرٍ تَن شَ وْيّنيِ عَ يّتّ بْنْمَ نّ.<verse eid="ECC 10:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="ECC 10:13"/>عَ شَ مَسٍنيِ قْلْمَ لْننِتَرٍحَ رَ،</para>
  <para style="q" vid="ECC 10:13">عَ رَحْن دَشُحَ رَ.<verse eid="ECC 10:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="ECC 10:14"/>شَشِلِتَرٍ شَ وْيّنيِ وُيَ.</para>
  <para style="b" vid="ECC 10:14"/>
  <para style="q" vid="ECC 10:14">عَدَ مَدِ مُ عَ كٌلٌن قٍ نَشَن قَمَ قَدٍ.</para>
  <para style="q" vid="ECC 10:14">ندٍ عَ رَكٌلٌنمَ قٍ رَ نَشَن قَمَ عَ لِدٍ؟<verse eid="ECC 10:14"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="15" style="v" sid="ECC 10:15"/>شَشِلِتَرٍ عَ يّتّ رَتَفَنمَ،</para>
  <para style="q" vid="ECC 10:15">هَلِ تَا كِرَ، عَ مُ عَ كٌلٌن.<verse eid="ECC 10:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="ECC 10:16"/>حَشَنكَتّ نَ تَا بّ نَشَن شَ مَنفّ قِندِشِ قٌنِكٍ يْرّ رَ،</para>
  <para style="q" vid="ECC 10:16">نَشَن شَ كُنتِفِيٍ كُرُنمَ شُلُنيِ تِقٍ رَ.<verse eid="ECC 10:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="ECC 10:17"/>حّلّشِنيِ نَ تَا بّ نَشَن شَ مَنفّ قَتَنشِ مَنفّ بْنسْي رَ،</para>
  <para style="q" vid="ECC 10:17">نَشَن شَ كُنتِفِيٍ عٍ دّفٍمَ عَ وَشَتِ مَ سّنبّ سْتْقٍ رَ، عٍ مُ سِيسِ.<verse eid="ECC 10:17"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="18" style="v" sid="ECC 10:18"/>شَ بَنشِ كَنيِ تُننَشْنْ، بَنشِ شُنيِ بِرَ مَ نّ،</para>
  <para style="q" vid="ECC 10:18">شَ عَ مُ عَ قِندِ تُننَبّشِ رَ، عَ شَ بَنشِ قَمَ نّ مِنِدٍ.<verse eid="ECC 10:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="ECC 10:19"/>مِشِ دٌنسٍ رَقَلَمَ نّ عَلَكٌ عَ شَ حّلّشِن،</para>
  <para style="q" vid="ECC 10:19">عَ وّنِ مِنمَ نّ عَلَكٌ عَ شَ سّيوَ،</para>
  <para style="q" vid="ECC 10:19">عَ كْبِرِ سْتْمَ نّ عَلَكٌ عَ هَيِ بِرِن شَ قَن.<verse eid="ECC 10:19"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="20" style="v" sid="ECC 10:20"/>عِ نَشَ مَنفّ دَنكَ هَلِ عِ شَ مَحْشُنيِ كُي،</para>
  <para style="q" vid="ECC 10:20">عِ نَشَ بَننَ دَنكَ هَلِ عِ شَ كٌنكٌي كُي،</para>
  <para style="q" vid="ECC 10:20">بَرِ مَ شْنِ ندٍ عِ شُي شَنِنمَ نّ، عَ نَ قَلَ مِشِ ندٍ بّ.<verse eid="ECC 10:20"/></para>
  <chapter eid="ECC 10"/>
  <chapter number="11" style="c" sid="ECC 11"/>
  <para style="s">وَكِلِقٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 11:1"/>تَالِ ندٍيٍ نَن يِ كِ؛</para>
  <para style="q" vid="ECC 11:1">شَ عِ تَامِ وٌلِ يٍ مَ،</para>
  <para style="q" vid="ECC 11:1">عِ قَمَ نّ عَ مَسْتْدٍ لْشْي ندٍ.<verse eid="ECC 11:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ECC 11:2"/>عِ شَ عِ شَ سْتْسٍ تَشُ مِشِ سٌلٌقٍرٍ رَ، شَ نَ مُ عَ رَ، مِشِ سٌلٌمَسَشَن،</para>
  <para style="q" vid="ECC 11:2">بَرِ مَ عِ مُ عَ كٌلٌن حَشَنكَتّ نَشَن قَمَ دُنِحَ لِدٍ.<verse eid="ECC 11:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="ECC 11:3"/>شَ نُشُي رَقٍشِ يٍ رَ،</para>
  <para style="q" vid="ECC 11:3">تُنّ قَمَ نّ بِرَدٍ بْشِ مَ.</para>
  <para style="q" vid="ECC 11:3">شَ وُرِ بِرَ يِرٍ قَنيِ مَ، شَ عَ بِرَ كْولَ مَ،</para>
  <para style="q" vid="ECC 11:3">عَ لُمَ نَا نّ.<verse eid="ECC 11:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ECC 11:4"/>مِشِ يٌ بْنبْ قٌيٍ رَبّنقٍ رَ، نَ مُ سَنسِ سِمَ.</para>
  <para style="q" vid="ECC 11:4">مِشِ يٌ بْنبْ نُشُي مَتٌقٍ رَ، نَ مُ قَمَ سَنسِ شَبَدٍ.<verse eid="ECC 11:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="ECC 11:5"/>عِ مُ حّنفِ نُن شْرِيٍ رَقَلَ كِ كٌلٌن قُرِ فِنّ قُرِ كُي،</para>
  <para style="q" vid="ECC 11:5">عِ مَن مُ عَلَ دَالِ مَنفّ شَ وَلِ قَن كٌلٌن.<verse eid="ECC 11:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="ECC 11:6"/>عِ شَ وَكِلِ كٍلِقٍ فّيسّفّ هَن نُنمَرٍ سَنسِ سِقٍ رَ،</para>
  <para style="q" vid="ECC 11:6">بَرِ مَ عِ مُ عَ كٌلٌن عِ شَ وَلِ مُندُن قَمَ سْونّيَدٍ.<verse eid="ECC 11:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="ECC 11:7"/>نَءِيَلَنيِ تٌقٍ حْشُن.<verse eid="ECC 11:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="ECC 11:8"/>عَ لَنمَ مِشِ شَ سّيوَ عَ شَ سِمَيَ رَ،</para>
  <para style="q" vid="ECC 11:8">كْنْ عَ نَشَ نّيمُ دِ مِ مَ نَشَن نُ نَ عَ شَ سِمَيَ كُي.</para>
  <para style="q" vid="ECC 11:8">قٍ نَشَن بِرِن قَمَ، قٍ قُقَقُ نَ عَ رَ.<verse eid="ECC 11:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="ECC 11:9"/>قٌنِكٍ، عِ شَ حّلّشِن عِ شَ قٌنِكٍيَ كُي،</para>
  <para style="q" vid="ECC 11:9">عِ سٌندٌنيِ شَ سّيوَ عِ شَ قٌنِكٍيَ وَشَتِ كُي.</para>
  <para style="q" vid="ECC 11:9">عِ شَ بِرَ عِ بْحّ نُن عِ وَشْنقٍ قْشْ رَ،</para>
  <para style="q" vid="ECC 11:9">كْنْ عِ شَ عَ كٌلٌن عَ عَلَ عِ مَكِيتِمَ نّ نَ بِرِن مَ.<verse eid="ECC 11:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="ECC 11:10"/>نَ كُي كْنتْقِلِ مَكُيَ عِ رَ،</para>
  <para style="q" vid="ECC 11:10">تْورّ كٍرِ عِ قْشْ رَ.</para>
  <para style="q" vid="ECC 11:10">قٌنِكٍيَ قِندِشِ قٍ قُقَقُ نَن نَ.<verse eid="ECC 11:10"/></para>
  <chapter eid="ECC 11"/>
  <chapter number="12" style="c" sid="ECC 12"/>
  <para style="s">قَشّ مَكْرّ</para>
  <para style="q">
    <verse number="1" style="v" sid="ECC 12:1"/>عِ شَ رَتُ عِ دَالِ مَرِفِ مَ عِ شَ قٌنِكٍيَ كُي،</para>
  <para style="q" vid="ECC 12:1">بٍينُن عِ نِمِسَ لْشْي شَ قَ،</para>
  <para style="q" vid="ECC 12:1">بٍينُن تْورّ وَشَتِ شَ عِ لِ، عِ قَ عَ قَلَ،</para>
  <para style="q" vid="ECC 12:1">«سّيوّ يٌ مُ نَ ﭑ بّ سْنْن.»<verse eid="ECC 12:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="ECC 12:2"/>عِ شَ رَتُ عَ مَ بٍينُن سٌفٍ شَ دِ مِ،</para>
  <para style="q" vid="ECC 12:2">بٍينُن كِكٍ نُن تُنبُييٍ شَ عِقْورْ،</para>
  <para style="q" vid="ECC 12:2">بٍينُن نُشُي شَ سِفَ تُنّ بِرَ شَنبِ.<verse eid="ECC 12:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="ECC 12:3"/>نَ تّمُي بَنشِ كَنتّيٍ سّرّنمَ نّ،</para>
  <para style="q" vid="ECC 12:3">شّمّ حَلَمَيٍ عٍ قٍلٍنمَ نّ،</para>
  <para style="q" vid="ECC 12:3">مَالٍ دِنمَيٍ شُرُنمَ نّ،</para>
  <para style="q" vid="ECC 12:3">مِشِ نَشٍيٍ سٍ عِفبّمَ عٍ لُمَ نّ دِ مِ كُي،<verse eid="ECC 12:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="ECC 12:4"/>بَنشِ نَادّيٍ بَلَنمَ نّ،</para>
  <para style="q" vid="ECC 12:4">مَالٍ دِن شُي دَنمَ نّ،</para>
  <para style="q" vid="ECC 12:4">شْنِ شُي دُندُ مَ نّ نَشَن نُ مِشِيٍ رَشُنُمَ،<verse eid="ECC 12:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="ECC 12:5"/>شّمّ قَمَ نّ فَاشُدٍ يِرٍ عِتٍشِ رَ،</para>
  <para style="q" vid="ECC 12:5">عٍ قَمَ نّ فَاشُدٍ قٍ شْرْشْي رَ كِرَ شْن مَ،</para>
  <para style="q" vid="ECC 12:5">شّمْشِ شُنسّشّ قَمَ نّ قِيشّدٍ،</para>
  <para style="q" vid="ECC 12:5">كَتٌي بَمَ نّ كَسَرّ تِقٍ،</para>
  <para style="q" vid="ECC 12:5">سٍرِ مُ دَندَنيِ تِمَ سْنْن.</para>
  <para style="b" vid="ECC 12:5"/>
  <para style="q" vid="ECC 12:5">نَ تّمُي مِشِ سِفَمَ نّ عَ شَ لِنفِرَ دْنشْي،</para>
  <para style="q" vid="ECC 12:5">وَ شُي مِنِمَ نّ كِرَيٍ شْن مَ.<verse eid="ECC 12:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="ECC 12:6"/>نَ رَبَمَ نّ بٍينُن فبٍتِ شَ بٌلٌن،</para>
  <para style="q" vid="ECC 12:6">بٍينُن شّيمَ تْنبِلِ شَ كَنَ،</para>
  <para style="q" vid="ECC 12:6">بٍينُن قّحّ شَ عِبْو دُلٌنيِ مَ،</para>
  <para style="q" vid="ECC 12:6">بٍينُن يٍ بّندُن سٍ شَ كَنَ كٌلٌنيِ يِرٍ،<verse eid="ECC 12:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="ECC 12:7"/>بٍينُن عَدَ مَدِ شَ فبِلٍن بّندّ عَ دَاشِ نَشّ،</para>
  <para style="q" vid="ECC 12:7">عَ نِي قَن شَ فبِلٍن عَلَ مَ نَشَن عَ رَ سٌ عَ قَتٍ عِ.<verse eid="ECC 12:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="ECC 12:8"/>ﭑ تَن كَوَندِلَ شَ عَ قَلَ وٌ بّ،</para>
  <para style="q" vid="ECC 12:8">«قٍ قُقَقُ نَن نَ نَ بِرِن نَ. عَ بِرِن لُشِ نّ عَلْ قٌيٍ!»<verse eid="ECC 12:8"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="9" style="v" sid="ECC 12:9"/>وٌ شَ عَ كٌلٌن يِ كَوَندِلَ قِندِشِ شَشِلِمَ نَن نَ، نَشَن بَرَ حَمَ شَرَن. عَ بَرَ تَالِيٍ مَتٌ، عَ عٍ يَءِلَن. <verse eid="ECC 12:9"/><verse number="10" style="v" sid="ECC 12:10"/>يِ كَوَندِلَ كَتَ نّ عَ شَ مَسٍنيِ قَنيِيٍ نُن سّبّلِ تِنشِنشِيٍ سْتْ نَشٍيٍ نْندِ مَسٍنمَ. <verse eid="ECC 12:10"/><verse number="11" style="v" sid="ECC 12:11"/>شَشِلِمَيٍ شَ مَسٍنيِيٍ لُشِ نّ عَلْ وُرِ رَ مٍلُشِ نَشٍيٍ شُرُ سٍيٍ رَحّرّ مَ. نَ مَسٍنيِيٍ مَلَنشِ لُشِ نّ عَلْ لَنتُمَ نَشٍيٍ مَبَنبَنشِ وُرِ مَ. نَ بِرِن قَتَنشِ شُرُ سٍ دّ مَدٌنيِ كٍرٍن نَن نَ.<verse eid="ECC 12:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 12:12"/>ﭑ مَ دِ، نَشَن دَنفِ نَ مَسٍنيِيٍ رَ، عِ شَ عِ يّتّ رَتَنفَ نَ مَ. دَنيِ مُ نَ سّبّلِ يَءِلَنقٍ مَ. شَرَنيِ فبٍفبٍ مِشِ رَتَفَنمَ نّ.<verse eid="ECC 12:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="ECC 12:13"/>عَ بِرِن شُندُ سُشِ يِ مَسٍنيِ نَن نَ؛</para>
  <para style="q" vid="ECC 12:13">وٌن شَ فَاشُ عَلَ يَ رَ، وٌن شَ عَ شَ يَامَرِيٍ رَبَتُ،</para>
  <para style="q" vid="ECC 12:13">بَرِ مَ عَدَ مَدِ شَ وَلِ لَنمَ عَ شَ قِندِ نَ نَن نَ.<verse eid="ECC 12:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="ECC 12:14"/>وٌن شَ فَاشُ عَلَ يَ رَ بَرِ مَ عَ تَن نَن مِشِ شَ وَلِ بِرِن مَكِيتِمَ،</para>
  <para style="q" vid="ECC 12:14">هَلِ قٍ نَشَن بِرِن نْشُنشِ،</para>
  <para style="q" vid="ECC 12:14">عَ قِندِ عَ قَنيِ رَ بَ، عَ قِندِ عَ حَاشِ رَ بَ.<verse eid="ECC 12:14"/></para>
  <chapter eid="ECC 12"/>
</usx>
