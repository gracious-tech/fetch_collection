<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="MIC" style="id"/>
  <para style="h">عَننَبِ مِكَ</para>
  <para style="toc1">عَلَ شَ مَسٍنيِ عَننَبِ مِكَ بّ</para>
  <para style="toc2">عَننَبِ مِكَ</para>
  <para style="toc3">مِك</para>
  <para style="mt">عَلَ شَ مَسٍنيِ عَننَبِ مِكَ بّ</para>
  <para style="imt">مَسٍنيِ ندٍ يِ كِتَابُي شَ قٍ رَ</para>
  <para style="ip">عَننَبِ مِكَ شَ كِتَابُي نْندِ هَفِفّ مَسٍنمَ تٌ مِشِيٍ بّ. عَلَ مُ وَ مَ قٍ حَاشِ شْن، عَ يُنُبِ بِرِن شْنمَ عَ بْحّ بِرِن نَ. نَ كُي عِبُنَدَ مَ نَ كٍلِ عَلَ شَ كِرَ شْن مَ، عَلَ شَ تِنشِنيِ عَ نِيَمَ نّ عَ شَ نَ مِشِيٍ حَشَنكَتَ عٍ شَ قٍ رَبَشِ مَ. عٍ نَ قِندِ عَ شَ حَمَ رَ، عٍ نَ قِندِ حَمَ رَ نَشَن مُ عَ كٌلٌن، عٍ بِرِن هَلَكِمَ نّ نَ يُنُبِيٍ شَ قٍ رَ.</para>
  <para style="ip">نَ قَهَامُقٍ مُ شْرْشْ عَدَ مَدِيٍ بّ، بَرِ مَ عٍ قَن نَ قٍ حَاشِ ندٍ تٌ، عٍ بْحّ تٍمَ نّ هَن. عٍ نَ عَ تٌ عٍ شَ مَنفّيٍ نَ سٍتَرٍيٍ تْورْقٍ عَلَكٌ ندٍ شَ سَ عٍ يّتّ شَ نَاقُلِ شْن مَ، عٍ شْنْمَ نّ. نَ شْنّ مَنِيَ عَلَ شَ شْنّ تِنشِنشِ رَ. قٍ نَشَن مُ رَقَن عَلَ مَ، قٍ قَنيِ مُ عَ رَ. عَ مِشِ تْورْ مَ نّ!</para>
  <para style="ip">كْنْ عَلَ شَ شْنّ قَتَنشِ عَ شَ بْحّ قَنيِ نَن نَ. عَ تٌ وَ عِبُنَدَ مَ شَ قٍ شَ سْونّيَ، عَ نَ سٍنتَنّ شَ كَسَرّ وَلِ تٌ، عَ شْنْمَ نّ، عَ مَن فٍرٍ تِ نَ شِلِ مَ. يُنُبِ رَبَ حَشَنكَتَقٍ كٍلِشِ نَ نَن مَ. كْنْ نَ بْحّ قَنيِ مَن عَ نِيَمَ نّ عَلَتَلَ شَ كَتّ بِرِن نَبَ عَلَكٌ عَ شَ عِبُنَدَ مَ رَفبِلٍن عَ شَ كِرَ قَنيِ مَ. عَ مُ وَ مَ عٍ حَشَنكَتَقٍ تُن. عَ وَ مَ نّ عٍ شَ فبِلٍن عَ مَ، عٍ شَ كِسِ سْتْ كِرَ قَنيِ شْن مَ.</para>
  <para style="ip">عَننَبِ مِكَ نُ عَلَ شَ مَسٍنيِ تِقٍ عِسِرَيِلَ نُن عٍ يَشُييٍ بّ، كْنْ عَ تِدٍ فبٌ تٌ مِشِيٍ قَن بّ. وٌن قَن شَ قَهَامُي سْتْ يِ مَسٍنيِ كُي؛ عَ يُنُبِ مُ رَقَن عَلَ مَ، عَ قَمَ يُنُبِتْييٍ حَشَنكَتَدٍ، عَ نُن عَ وَ مَ مِشِ رَكِسِقٍ عٍ شَ يُنُبِيٍ مَ عَلَكٌ عٍ شَ حّرّ عَ وَشْنقٍ قَنيِ كُي. عَلَ شَ وٌن مَلِ نَ كِسِ تِنشِنشِ سْتْقٍ رَ. عَمِنَ.</para>
  <para style="imte">عَلَ شَ مَسٍنيِ عَننَبِ مِكَ بّ</para>
  <chapter number="1" style="c" sid="MIC 1"/>
  <para style="s">عَلَ شَ شْنّ عِسِرَيِلَ نُن يُدَيَ بّ</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 1:1"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ عَ نَشَن تِ عَننَبِ مِكَ مٌرٍ سٍتِكَ بّ سَمَرِ نُن دَرِ سَلَمُ شَ قٍ رَ. عَ عَ تِ عَ بّ يُدَيَ مَنفّ يٌتَمِ، عَشَسِ، نُن شٍسٍكِيَ شَ وَشَتِ نّ.<verse eid="MIC 1:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="MIC 1:2"/>دُنِحَ سِ بِرِن، وٌ شَ وٌ تُلِ مَتِ ﭑ نَ.</para>
  <para style="q" vid="MIC 1:2">عِبُنَدَ مَ بِرِن نَشٍيٍ نَ يِ بّندّ قُحِ قَرِ،</para>
  <para style="q" vid="MIC 1:2">وٌ شَ ﭑ مَ مَسٍنيِ رَ مّ،</para>
  <para style="q" vid="MIC 1:2">وٌن مَرِفِ عَلَتَلَ قَمَ وٌ كَلَمُدٍ نَشَن نَ،</para>
  <para style="q" vid="MIC 1:2">كٍلِقٍ عَ شَ هْرْ مْبَنشِ سّنِيّنشِ كُي.<verse eid="MIC 1:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="MIC 1:3"/>وٌ شَ عَ مَتٌ، عَلَتَلَ نَ قَقٍ كٍلِقٍ عَ شَ لِنفِرَ،</para>
  <para style="q" vid="MIC 1:3">عَ نَ فٌرٌقٍ فٍيَيٍ قَرِ، عَ عَ حّرّ.<verse eid="MIC 1:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="MIC 1:4"/>فٍيَيٍ نَ شُنُقٍ عَ سَنيِ بُن مَ،</para>
  <para style="q" vid="MIC 1:4">عَلْ كُمِ دٌلٍ نَشَن سَمَ تّ قّ مَ،</para>
  <para style="q" vid="MIC 1:4">عَلْ يٍ نَشَن سُسُقٍ كٍلِقٍ يِرٍ عِتٍشِ.</para>
  <para style="q" vid="MIC 1:4">فٍيَيٍ نَ عِبْوقٍ، عٍ قِندِ فُلُنبَيٍ رَ.<verse eid="MIC 1:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="MIC 1:5"/>نَ بِرِن كٍلِشِ يَشُبَ بْنسْي شَ مُرُتّ نَن مَ،</para>
  <para style="q" vid="MIC 1:5">عَ قَتَنشِ عِسِرَيِلَ حَمَ شَ يُنُبِيٍ نَن مَ.</para>
  <para style="q" vid="MIC 1:5">ندٍ يَشُبَ بْنسْييٍ رَ مُرُتَشِ؟</para>
  <para style="q" vid="MIC 1:5">سَمَرِ شَ مُ عَ رَ؟</para>
  <para style="q" vid="MIC 1:5">ندٍ كُيٍ بَتُدٍ تِشِ يِرٍ عِتٍشِ قَرِ يُدَيَ؟</para>
  <para style="q" vid="MIC 1:5">دَرِ سَلَمُ شَ مُ عَ رَ؟<verse eid="MIC 1:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="MIC 1:6"/>نَ كُي ﭑ قَمَ سَمَرِ قِندِدٍ فّمّ مَلَنشِيٍ نَن نَ،</para>
  <para style="q" vid="MIC 1:6">ﭑ عَ قِندِ وّنِ سَنسِ سِدٍ رَ.</para>
  <para style="q" vid="MIC 1:6">ﭑ عَ شَ فّمّ بِلِيٍ رَبِرَ، ﭑ عٍ رَدِن فُلُنبَيٍ كُي،</para>
  <para style="q" vid="MIC 1:6">هَن عَ شَ بَنشِيٍ بُنيِ لُ كّنّ مَ.<verse eid="MIC 1:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="MIC 1:7"/>ﭑ عَ شَ كُيٍيٍ بُتُشُنمَ نّ،</para>
  <para style="q" vid="MIC 1:7">ﭑ عَ شَ بَتُ سٍيٍ فَنمَ نّ تّ رَ،</para>
  <para style="q" vid="MIC 1:7">ﭑ عَ شَ عَلَ مَسٌلِشِيٍ شُن نَكَنَمَ نّ.</para>
  <para style="q" vid="MIC 1:7">نٍيٍ قْلْشِ بَقَتَ نَن نَ نَشَن نَوَلِشِ لَنفٌي سَرٍ رَ،</para>
  <para style="q" vid="MIC 1:7">نٍيٍ مَن قِندِ مَ بَقَتَ نَن نَ لَنفٌي سَرٍ قِمَ نَشَن نَ.<verse eid="MIC 1:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="MIC 1:8"/>ﭑ قَمَ سُننُندٍ نَ نَن مَ، ﭑ نَ ﭑ كُي عِوَ.</para>
  <para style="q" vid="MIC 1:8">ﭑ نَ ﭑ حّرّ مَ نّ ﭑ سَنيِ نُن ﭑ قَتٍ مَفٍلِ رَ،</para>
  <para style="q" vid="MIC 1:8">ﭑ نَ ﭑ فبٍلٍفبٍلٍ شُي عِتٍمَ نّ عَلْ وُلَءِ بَرٍ،</para>
  <para style="q" vid="MIC 1:8">ﭑ نَ ﭑ كُي عِوَ عَلْ شُندِ.<verse eid="MIC 1:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="MIC 1:9"/>سَمَرِ شَ قُرٍ حَاشِ مُ نْمَ دَندَندٍ،</para>
  <para style="q" vid="MIC 1:9">عَ مَن بَرَ دِن يُدَيَ بْشِ رَ،</para>
  <para style="q" vid="MIC 1:9">هَن عَ بَرَ دَرِ سَلَمُ مَسْتْ ﭑ مَ حَمَ سَبَتِشِ دّننَشّ.<verse eid="MIC 1:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="MIC 1:10"/>وٌ نَشَ نَ قٍ رَكٌلٌن فَتِكَيٍ رَ دٍ وٌ وَ شُي رَ.</para>
  <para style="q" vid="MIC 1:10">ﭑ دْشْشِ شُبٍ شْورَ سُننُنيِ كُي بٍتِ لٍيَقٍرَ.<verse eid="MIC 1:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="MIC 1:11"/>سَقِرِكَيٍ، وٌ شَ دَنفِ وٌ مَفٍلِ رَ يَافِ كُي.</para>
  <para style="q" vid="MIC 1:11">سَانَن حَمَ مُ سُو سَمَ مِنِدٍ.</para>
  <para style="q" vid="MIC 1:11">وٌ مُ نْمَ وٌ شَشِلِ تِدٍ بٍتِ عٍسٍلِ رَ، عٍ قَن نَ وَقٍ.<verse eid="MIC 1:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="MIC 1:12"/>مَرٌتِكَيٍ بَرَ لُ كْنتْقِلِ كُي،</para>
  <para style="q" vid="MIC 1:12">بَرِ مَ فبَلٌي بَرَ فٌرٌ كٍلِقٍ عٍ مَرِفِ عَلَتَلَ مَ،</para>
  <para style="q" vid="MIC 1:12">عَ دَرِ سَلَمُ نَادّ لِ.<verse eid="MIC 1:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="MIC 1:13"/>لَكِسِكَيٍ، وٌ شَ سْورِ رَفِسٍيٍ يَءِلَن.</para>
  <para style="q" vid="MIC 1:13">وٌ بَرَ عَ نِيَ سِيٌنِكَيٍ شَ مُرُتَ عَلَ مَ،</para>
  <para style="q" vid="MIC 1:13">عِسِرَيِلَ بَرَ بِرَ وٌ شَ يُنُبِيٍ قْشْ رَ.<verse eid="MIC 1:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="MIC 1:14"/>عِ تَن نُن مٌرٍ سٍتِ فَتِكَيٍ قَتَنمَ نَ نَن مَ،</para>
  <para style="q" vid="MIC 1:14">عَكِسِبُكَيٍ قَمَ نّ عِسِرَيِلَ مَنفّيٍ يَنقَدٍ.<verse eid="MIC 1:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="MIC 1:15"/>مَرٍ سَكَيٍ، ﭑ فٍرٍقَ فبّتّ شّيمَ نّ عَ شَ وٌ فٍرٍ.</para>
  <para style="q" vid="MIC 1:15">عِسِرَيِلَ مَنفّ حَلَمَ سِفَمَ نّ عَدُلَمَ.<verse eid="MIC 1:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="MIC 1:16"/>وٌ وٌ شُنيِيٍ بِ عَلْ يُبّ، سُننُنيِ شَ قٍ رَ،</para>
  <para style="q" vid="MIC 1:16">بَرِ مَ وٌ شَ دِ شَنُشِيٍ قَمَ شَنِندٍ كٌنيِيَ كُي حَمَنّ مَ.<verse eid="MIC 1:16"/></para>
  <chapter eid="MIC 1"/>
  <chapter number="2" style="c" sid="MIC 2"/>
  <para style="s">حَشَنكَتّ نُن كِسِ</para>
  <para style="q">
    <verse number="1" style="v" sid="MIC 2:1"/>حَشَنكَتّ نَ مِشِيٍ بّ،</para>
  <para style="q" vid="MIC 2:1">نَشٍيٍ عٍ مَحْشُنمَ مَءِقُيَ نُن قٍ حَاشِ رَبَقٍ مَ عٍ سَ تّمُي،</para>
  <para style="q" vid="MIC 2:1">كُيٍ نّقّ عِبَ، عٍ قَ قٍ كٌبِيٍ رَبَ،</para>
  <para style="q" vid="MIC 2:1">بَرِ مَ نَ نْي نَ عٍ يِ رَ.<verse eid="MIC 2:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="MIC 2:2"/>عٍ نَ مِلّ شّيٍ مَ، عٍ نٍيٍ بَ عٍ كَنيِيٍ يِ رَ.</para>
  <para style="q" vid="MIC 2:2">عٍ نَ مِلّ بَنشِيٍ مَ، عٍ نٍيٍ تٌنفٌ عٍ سّنبّ رَ.</para>
  <para style="q" vid="MIC 2:2">عٍ قُ مِشِ مَ، عٍ عَ شَ بَنشِ مُحَ.</para>
  <para style="q" vid="MIC 2:2">عٍ قُ مِشِ مَ، عٍ عَ كّ رَ سُشُ عَ يِ.<verse eid="MIC 2:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="MIC 2:3"/>نَ شَ قٍ رَ، مَرِفِ عَلَتَلَ نَشّ،</para>
  <para style="q" vid="MIC 2:3">«ﭑ حَشَنكَتّ دْشْمَ نّ نَ مِشِ مْولِ مَ،</para>
  <para style="q" vid="MIC 2:3">وٌ مُ نْمَ وٌ رَتَنفَدٍ نَشَن مَ.</para>
  <para style="q" vid="MIC 2:3">ﭑ قَمَ وٌ شُن فٌرٌدٍ نَ حَشَنكَتّ تّمُي.<verse eid="MIC 2:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="MIC 2:4"/>عٍ وٌ شَ قٍ عِقَلَمَ تَالِ دَاشِ نّ نَ لْشْي،</para>
  <para style="q" vid="MIC 2:4">عٍ وٌ مَسِفِ عَ مَيٍلٍ كِ مَ، عٍ نُ قَ عَ قَلَ،</para>
  <para style="q" vid="MIC 2:4">‹مُشُ شَ قٍ بَرَ كَنَ قٍوٌ.</para>
  <para style="q" vid="MIC 2:4">مُشُ شَ بْشِيٍ بَرَ بَ مُشُ يِ رَ.</para>
  <para style="q" vid="MIC 2:4">عَ بَرَ عٍ بَ مُشُ يِ، عَ عٍ سٌ مُشُ يَشُييٍ يِ رَ.›»<verse eid="MIC 2:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="MIC 2:5"/>نَ نَن عَ رَ، وٌ مُ مِشِ يٌ سْتْمَ عَلَتَلَ شَ حَمَ يَ مَ،</para>
  <para style="q" vid="MIC 2:5">نَشَن نْمَ بْشِ عِتَشُندٍ وٌ بّ عَلَ شَ تْنشُمَيٍ سَابُي رَ.<verse eid="MIC 2:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="MIC 2:6"/>عٍ شَ نَمِحْنمّيٍ عَ قَلَمَ،</para>
  <para style="q" vid="MIC 2:6">«بَ يِ مَسٍنيِ مْولِ تِقٍ،</para>
  <para style="q" vid="MIC 2:6">نَمِحْنمّ مُ لَنمَ عَ شَ نَ قَلَ.</para>
  <para style="q" vid="MIC 2:6">وٌن مُ قَمَ لُدٍ يَافِ يٌ كُي.<verse eid="MIC 2:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="MIC 2:7"/>يَشُبَ بْنسْي، عَ لَنمَ عَ شَ قَلَ،</para>
  <para style="q" vid="MIC 2:7">عَلَتَلَ شْنْمَ عَ بْحّ مَ؟</para>
  <para style="q" vid="MIC 2:7">عَ دَرِشِ نَ وَلِ مْولِ رَبَ رَ؟»</para>
  <para style="b" vid="MIC 2:7"/>
  <para style="q" vid="MIC 2:7">عَلَتَلَ نَشَ عٍ يَابِ،</para>
  <para style="q" vid="MIC 2:7">«ﭑ مَ مَسٍنيِيٍ مُ قَنشِ شّ تِنشِنتْييٍ بّ؟<verse eid="MIC 2:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="MIC 2:8"/>يِ وَشَتِ ﭑ مَ حَمَ بَرَ لُ عَلْ ﭑ يَشُي.</para>
  <para style="q" vid="MIC 2:8">وٌ دٌنمَ قَنيِ بَمَ دَنفِ مِشِيٍ مَ،</para>
  <para style="q" vid="MIC 2:8">نَشٍيٍ قَقٍ بْحّسَ كُي كٍلِقٍ فٍرٍ سٌدٍ.<verse eid="MIC 2:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="MIC 2:9"/>وٌ ﭑ مَ حَمَ شَ فِنّيٍ كٍرِ مَ عٍ شَ بَنشِ قَنيِيٍ كُي،</para>
  <para style="q" vid="MIC 2:9">وٌ عٍ شَ دِيٍ شَ شُننَكٍلِ بَمَ عٍ يِ رَ ﭑ نَشَن قِ عٍ مَ.<verse eid="MIC 2:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="MIC 2:10"/>وٌ كٍلِ، وٌ سِفَ،</para>
  <para style="q" vid="MIC 2:10">ﭑ بَرَ يِ بْشِ بَ وٌ يِ رَ سَبَتِدٍ رَ،</para>
  <para style="q" vid="MIC 2:10">بَرِ مَ عَ مُ سّنِيّن، عَ بَرَ كَنَ كٍرٍنيِ رَ.<verse eid="MIC 2:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="MIC 2:11"/>شَ وُلٍ قَلّ نُن مِشِ مَدَشُي قَ عَ قَلَ وٌ بّ،</para>
  <para style="q" vid="MIC 2:11">‹وٌ قَمَ بٍيرٍ نُن وّنِ سْتْدٍ›،</para>
  <para style="q" vid="MIC 2:11">نَ مِشِ مْولِ نَن نَقَن وٌ مَ نَمِحْنمّ رَ.»<verse eid="MIC 2:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="MIC 2:12"/>«يَشُبَ بْنسْي، ﭑ وٌ بِرِن مَلَنمَ نّ.</para>
  <para style="q" vid="MIC 2:12">عِسِرَيِلَ مِشِ دْنشْييٍ، ﭑ وٌ شُن لَنمَ نّ.</para>
  <para style="q" vid="MIC 2:12">ﭑ وٌ مَلَنمَ نّ، عَلْ يّشّييٍ نَشٍيٍ مَلَنمَ فْورّ كُي،</para>
  <para style="q" vid="MIC 2:12">عَلْ شُرُ سٍيٍ نَشٍيٍ نَ قِيلِ مَ عٍ دّ مَدٌندٍ.</para>
  <para style="q" vid="MIC 2:12">حَمَ فبٍفبٍ سَبَتِمَ نّ نَا.<verse eid="MIC 2:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="MIC 2:13"/>عٍ شَ مَنفّ قَمَ نّ تَا تّتّ عِبْودٍ،</para>
  <para style="q" vid="MIC 2:13">عَ قَ تِ حَمَ يَ رَ،</para>
  <para style="q" vid="MIC 2:13">عَ عٍ بِرِن نَمِنِمَ نّ نَا.</para>
  <para style="q" vid="MIC 2:13">عَلَتَلَ نَن قِندِ عٍ شُنيِ رَ.»<verse eid="MIC 2:13"/></para>
  <chapter eid="MIC 2"/>
  <chapter number="3" style="c" sid="MIC 3"/>
  <para style="s">عِسِرَيِلَ يَرٍرَتِيٍ شَ يُنُبِيٍ</para>
  <para style="q">
    <verse number="1" style="v" sid="MIC 3:1"/>ﭑ نَشّ، «يَشُبَ بْنسْي مَنفّيٍ،</para>
  <para style="q" vid="MIC 3:1">عِسِرَيِلَ يَرٍرَتِيٍ، وٌ شَ وٌ تُلِ مَتِ.</para>
  <para style="q" vid="MIC 3:1">وٌ تَن شَ مُ دَشَ وٌ شَ سّرِيّ كٌلٌن؟<verse eid="MIC 3:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="MIC 3:2"/>كْنْ وٌ قٍ قَنيِيٍ شْنمَ، قٍ حَاشِيٍ نَن نَقَن وٌ مَ.</para>
  <para style="q" vid="MIC 3:2">وٌ مِشِيٍ تْورْ مَ هَن،</para>
  <para style="q" vid="MIC 3:2">عَ لُشِ نّ عَلْ وٌ عٍ شَ كِرِ نُن سُبٍ بَمَ عٍ قَتٍيٍ مَ،<verse eid="MIC 3:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="MIC 3:3"/>وٌ نَ عِبٌلٌن عَ شُنتُنيِيٍ رَ، وٌ عَ حِن تُندٍ كُي، وٌ قَ عَ دٌن.»<verse eid="MIC 3:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="MIC 3:4"/>نَ مِشِ مْولِ قَمَ نّ عَلَتَلَ شِلِدٍ،</para>
  <para style="q" vid="MIC 3:4">كْنْ عَ مُ عٍ يَابِمَ.</para>
  <para style="q" vid="MIC 3:4">نَ لْشْي عَ عَ كٌبٍ سٌمَ نّ عٍ رَ،</para>
  <para style="q" vid="MIC 3:4">بَرِ مَ عٍ حّرّ كِ مُ قَن.<verse eid="MIC 3:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="MIC 3:5"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ،</para>
  <para style="q" vid="MIC 3:5">«وٌ تَن نَمِحْنمّ نَشٍيٍ ﭑ مَ حَمَ رَتَنتَنمَ،</para>
  <para style="q" vid="MIC 3:5">نَشٍيٍ بْحّسَ مَسٍنمَ مِشِيٍ بّ نَشٍيٍ وٌ كِمَ،</para>
  <para style="q" vid="MIC 3:5">كْنْ وٌ مِشِيٍ تَن فٍرٍ نَشٍيٍ وٌ كُمَ.<verse eid="MIC 3:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="MIC 3:6"/>نَ شَ قٍ رَ، كْي سٌمَ نّ وٌ شُن،</para>
  <para style="q" vid="MIC 3:6">وٌ مُ تٌي تِمَ، وٌ مُ لَامَتُنيِيٍ سْتْمَ، وٌ لُمَ دِ مِ نَن كُي تُن.</para>
  <para style="q" vid="MIC 3:6">سٌفٍ دُلَمَ نّ نَ نَمِحْنمّيٍ شُن،</para>
  <para style="q" vid="MIC 3:6">يَنيِ قَن عِقْورْ عٍ بّ.<verse eid="MIC 3:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="MIC 3:7"/>سٍ مَتٌي يَافِمَ نّ،</para>
  <para style="q" vid="MIC 3:7">نَشٍيٍ يَرٍ تٌمَ، عٍ شُن سِنمَ نّ،</para>
  <para style="q" vid="MIC 3:7">عٍ عٍ يَتَفِ نْشُن،</para>
  <para style="q" vid="MIC 3:7">بَرِ مَ ﭑ تَن عَلَ مُ عٍ يَابِمَ.»<verse eid="MIC 3:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="MIC 3:8"/>كْنْ عَلَ شَشِلِ سّنِيّنشِ بَرَ سّنبّ قِ ﭑ مَ،</para>
  <para style="q" vid="MIC 3:8">تِنشِنيِ نُن لِمَنِيَ بَرَ لُ ﭑ يِ رَ،</para>
  <para style="q" vid="MIC 3:8">عَلَكٌ ﭑ شَ يَشُبَ بْنسْييٍ رَكٌلٌن عٍ شَ مُرُتّ رَ،</para>
  <para style="q" vid="MIC 3:8">ﭑ شَ عِسِرَيِلَ شَ يُنُبِيٍ مَسٍن عَ بّ.<verse eid="MIC 3:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="MIC 3:9"/>وٌ تَن يَشُبَ بْنسْييٍ يَرٍرَتِيٍ،</para>
  <para style="q" vid="MIC 3:9">وٌ تَن عِسِرَيِلَ حَمَ شَ مَنفّيٍ،</para>
  <para style="q" vid="MIC 3:9">وٌ شَ وٌ تُلِ مَتِ ﭑ نَ.</para>
  <para style="q" vid="MIC 3:9">وٌ نَ تِنشِنيِ شْنقٍ، وٌ عَ مَقِندِ.<verse eid="MIC 3:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="MIC 3:10"/>وٌ نَ مِشِيٍ نِي بَقٍ سِيٌنِ تِقٍ رَ،</para>
  <para style="q" vid="MIC 3:10">وٌ نَ دَرِ سَلَمُ تِقٍ تِنشِنتَرٍيَ كُي.<verse eid="MIC 3:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="MIC 3:11"/>عٍ شَ مَنفّيٍ كِيتِ سَمَ كْبِرِ سْتْقٍ نَن مَ.</para>
  <para style="q" vid="MIC 3:11">عٍ شَ سّرّشّدُبّيٍ شَرَنيِ تِمَ نَاقُلِ شَ قٍ نَن نَ.</para>
  <para style="q" vid="MIC 3:11">عٍ شَ نَمِحْنمّيٍ مَسٍنيِيٍ تِمَ عٍ شَ فٍينِ نَن مَ.</para>
  <para style="q" vid="MIC 3:11">كْنْ عٍ بِرِن عٍ يَ تِمَ عَلَتَلَ رَ، عٍ نُ عَ قَلَ مِشِيٍ بّ،</para>
  <para style="q" vid="MIC 3:11">«عَلَتَلَ مُ نَ شّ وٌن يَ مَ؟</para>
  <para style="q" vid="MIC 3:11">حَشَنكَتّ يٌ مُ وٌن لِمَ.»<verse eid="MIC 3:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="MIC 3:12"/>وٌ شَ قٍ نَن يَتِ عَ نِيَمَ سِيٌنِ قَمَ بُشَدٍ عَلْ شّ،</para>
  <para style="q" vid="MIC 3:12">دَرِ سَلَمُ قِندِ مَ نّ فّمّ مَلَنشِيٍ رَ،</para>
  <para style="q" vid="MIC 3:12">قْتْنيِ قَ بُلَ هْرْ مْبَنشِ رَبِلِنيِ مَ.<verse eid="MIC 3:12"/></para>
  <chapter eid="MIC 3"/>
  <chapter number="4" style="c" sid="MIC 4"/>
  <para style="s">عَلَتَلَ شَ شُننَكٍلِ</para>
  <para style="q">
    <verse number="1" style="v" sid="MIC 4:1"/>تّمُي قَمَ عَ لِدٍ،</para>
  <para style="q" vid="MIC 4:1">عَلَتَلَ شَ بَنشِ تِشِ فٍيَ نَشَن قَرِ،</para>
  <para style="q" vid="MIC 4:1">نَ قَمَ نّ تِدٍ فٍيَ بِرِن شُن مَ.</para>
  <para style="q" vid="MIC 4:1">عَ عِتٍمَ نّ تٍنتٍنيِ بِرِن بّ،</para>
  <para style="q" vid="MIC 4:1">حَمَيٍ لُمَ نّ سِفَ رَ مّننِ.<verse eid="MIC 4:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="MIC 4:2"/>سِ فبٍفبٍ عٍ شُن تِمَ نّ نَا رَ، عٍ عَ قَلَ،</para>
  <para style="q" vid="MIC 4:2">«وٌن شَ سِفَ عَلَتَلَ شَ فٍيَ قَرِ،</para>
  <para style="q" vid="MIC 4:2">يَشُبَ مَرِفِ عَلَ شَ بَنشِ.</para>
  <para style="q" vid="MIC 4:2">عَ وٌن شَرَنمَ نّ عَ شَ سّرِيّ رَ،</para>
  <para style="q" vid="MIC 4:2">عَلَكٌ وٌن شَ وٌن حّرّ عَ شَ كِرَ شْن مَ.»</para>
  <para style="b" vid="MIC 4:2"/>
  <para style="q" vid="MIC 4:2">سّرِيّ قَتَنمَ سِيٌنِ نَن نَ،</para>
  <para style="q" vid="MIC 4:2">عَلَتَلَ شَ مَسٍنيِ كٍلِمَ دَرِ سَلَمُ نَن كُي.<verse eid="MIC 4:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="MIC 4:3"/>عَ قِندِ مَ نّ كِيتِسَ رَ سِ فبٍفبٍ تَفِ،</para>
  <para style="q" vid="MIC 4:3">عَ قَ سِ سّنبّمَيٍ شَ فٍرٍ رَحْندٍ دُنِحَ بِرِن كُي.</para>
  <para style="q" vid="MIC 4:3">عٍ عٍ شَ سَنتِدّفّمَيٍ شَبُمَ سَرِ شَ كٍرِيٍ نَن نَ،</para>
  <para style="q" vid="MIC 4:3">عٍ عٍ شَ وْرْتّيٍ يَءِلَن تَنبّيٍ رَ.</para>
  <para style="q" vid="MIC 4:3">سِ يٌ مُ عَ شَ سَنتِدّفّمَ عِتٍمَ سِ فبّتّ شِلِ مَ سْنْن.</para>
  <para style="q" vid="MIC 4:3">نَ وَشَتِ، مِشِيٍ مُ فٍرٍ مْولِ يٌ مَتِنكَنمَ.<verse eid="MIC 4:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="MIC 4:4"/>عٍ تِمَ عٍ شَ وّنِ سَنسِ نَن سّيتِ مَ،</para>
  <para style="q" vid="MIC 4:4">عٍ دْشْ عٍ شَ شْرّ بِلِ نِينِ بُن مَ.</para>
  <para style="q" vid="MIC 4:4">مِشِ يٌ مُ قَمَ عٍ بْحّ رَ مِنِدٍ،</para>
  <para style="q" vid="MIC 4:4">بَرِ مَ عَلَتَلَ سّنبّمَ بَرَ وْيّن.<verse eid="MIC 4:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="MIC 4:5"/>سِ بِرِن نْمَ حّرّدٍ عٍ شَ عَلَيٍ وَشْن كِ نّ،</para>
  <para style="q" vid="MIC 4:5">كْنْ وٌن تَن وٌن حّرّ مَ عَلَتَلَ نَن وَشْن كِ عَبَدَن.<verse eid="MIC 4:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="MIC 4:6"/>عَلَتَلَ نَشَ عَ مَسٍن،</para>
  <para style="q" vid="MIC 4:6">«لْشْي ندٍ قَمَ، ﭑ لَنيُرُتْييٍ مَلَنمَ نّ.</para>
  <para style="q" vid="MIC 4:6">ﭑ مِشِيٍ شُنلَنمَ نّ، ﭑ نَشٍيٍ رَيٍنسٍنشِ تْورّ كُي.<verse eid="MIC 4:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="MIC 4:7"/>ﭑ لَنيُرُتْييٍ قِندِ مَ نّ مِشِ كِسِشِ دْنشْييٍ رَ،</para>
  <para style="q" vid="MIC 4:7">ﭑ مِشِ رَيٍنسٍنشِيٍ قِندِ مَ نّ سِ سّنبّمَ رَ.</para>
  <para style="q" vid="MIC 4:7">عَلَتَلَ نَن تِمَ عٍ شُن مَ سِيٌنِ فٍيَ قَرِ عَبَدَن.<verse eid="MIC 4:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="MIC 4:8"/>عِ تَن سِيٌنِ، نَشَن عَ حْشْ سَمَ حَمَ شْن مَ،</para>
  <para style="q" vid="MIC 4:8">نَشَن قِندِشِ تَا مَكَنتَ شِ رَ،</para>
  <para style="q" vid="MIC 4:8">نْي قِسَمَنتٍ فبِلٍنمَ عِ تَن نَن مَ،</para>
  <para style="q" vid="MIC 4:8">مَنفّيَ قَ لُ دَرِ سَلَمُ يِ رَ.»<verse eid="MIC 4:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="MIC 4:9"/>وٌ قَ فبٍلٍفبٍلٍمَ مُنقٍ رَ؟</para>
  <para style="q" vid="MIC 4:9">مَنفّ مُ نَ وٌ شْنيِ سْنْن؟</para>
  <para style="q" vid="MIC 4:9">وٌ رَ سِمَ بَرَ قَشَ؟</para>
  <para style="q" vid="MIC 4:9">نَ بَرَ عَ نِيَ وٌ شَ تْورْ عَلْ فِنّ نَشَن نَ دِتِنيِ رَ؟<verse eid="MIC 4:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="MIC 4:10"/>سِيٌنِكَيٍ، وٌ قُرِيٍ شَ وٌ مَتٌلِن عَلْ قُرِ فِنّ،</para>
  <para style="q" vid="MIC 4:10">بَرِ مَ عٍ وٌ رَ مِنِمَ نّ تَا كُي، وٌ قَ شِ بُرُنيِ.</para>
  <para style="q" vid="MIC 4:10">عٍ وٌ شَنِنمَ بَبِلْن كٌنيِيَ كُي،</para>
  <para style="q" vid="MIC 4:10">كْنْ مّننِ وٌ قَمَ نّ قُلُندٍ.</para>
  <para style="q" vid="MIC 4:10">عَلَتَلَ وٌ بَمَ نّ وٌ يَشُييٍ بّلّشّ عِ.<verse eid="MIC 4:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="MIC 4:11"/>كْنْ يَكْسِ سِ فبٍفبٍ تِشِ وٌ شِلِ مَ،</para>
  <para style="q" vid="MIC 4:11">عَ قَلَقٍ رَ، «سِيٌنِ شَ يَافِ وٌن يَ شْرِ!»<verse eid="MIC 4:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="MIC 4:12"/>نٍيٍ مُ عَلَتَلَ شَ مَحْشُنيِ كٌلٌنشِ،</para>
  <para style="q" vid="MIC 4:12">عٍ مُ عَ شَ وَلِ قَهَامُشِ.</para>
  <para style="q" vid="MIC 4:12">عَلَتَلَ بَرَ عٍ مَلَن لٌنيِ مَ مَالٍ بْنبْمَ دّننَشّ.<verse eid="MIC 4:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="MIC 4:13"/>سِيٌنِكَيٍ، وٌ كٍلِ وٌ شَ عٍ بْنبْ.</para>
  <para style="q" vid="MIC 4:13">ﭑ وٌ سّنبّ فبٌمَ نّ عَلْ تُورَ،</para>
  <para style="q" vid="MIC 4:13">نَشَن قٍرِيٍ يَءِلَنشِ وُرٍ رَ، نَشَن تٌرٍ قِندِشِ وُرٍ فبٍيلِ رَ.</para>
  <para style="q" vid="MIC 4:13">نَ كُي وٌ حَمَنّ وُيَشِ بُتُشُنمَ نّ،</para>
  <para style="q" vid="MIC 4:13">وٌ عٍ شَ نَاقُلِ قِندِ مَ ﭑ تَن دُنِحَ مَرِفِ عَلَتَلَ نَن فبٍ رَ.<verse eid="MIC 4:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="MIC 4:14"/>يَكْسِ وٌ شَ وٌ قَتٍيٍ مَبْو سُننُنيِ مَ،</para>
  <para style="q" vid="MIC 4:14">بَرِ مَ عٍ نَ وٌن مَ تَا سُشُقٍ،</para>
  <para style="q" vid="MIC 4:14">عٍ نَ عِسِرَيِلَ حَمَ شَ مَنفّ بْنبْقٍ عَ يَتَفِ مَ وُرِ رَ.<verse eid="MIC 4:14"/></para>
  <chapter eid="MIC 4"/>
  <chapter number="5" style="c" sid="MIC 5"/>
  <para style="s">عِسِرَيِلَ نَكِسِمَ</para>
  <para style="q">
    <verse number="1" style="v" sid="MIC 5:1"/>«عِ تَن، بّتّلّيمُ عٍقَرَتَ، نَشَن شُرُن يُدَ شَبِلّيٍ يَ مَ،</para>
  <para style="q" vid="MIC 5:1">مِشِ ندٍ مِنِمَ نّ عِ يَ مَ نَشَن عِسِرَيِلَ يَمَرِ مَ ﭑ بّ.</para>
  <para style="q" vid="MIC 5:1">عَ شَ قٍ قْلْشِ تّمُي دَنفِشِ نّ نَشَن مَكُيَ ثٌن.»<verse eid="MIC 5:1"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="2" style="v" sid="MIC 5:2"/>نَ نَ عَ تٌمَ، عَلَتَلَ عِسِرَيِلَ رَبٌلٌمَ،</para>
  <para style="q" vid="MIC 5:2">هَن قُرِ فِنّ قَ عَ شَ دِ بَرِدٍ.</para>
  <para style="q" vid="MIC 5:2">نَ تّمُي، نَ دِ نفَشَكٍرٍنيِيٍ دْنشْييٍ قَمَ نّ فبِلٍندٍ عِسِرَيِلَ.<verse eid="MIC 5:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="MIC 5:3"/>عَ كٍلِمَ نّ، عَ تِ عَ شَ شُرُ سٍيٍ يَ رَ،</para>
  <para style="q" vid="MIC 5:3">عَ عٍ دّ مَدٌن عَ مَرِفِ عَلَتَلَ شِلِ شُنفبٍ كَنيِ سّنبّ رَ.</para>
  <para style="q" vid="MIC 5:3">عٍ سَبَتِمَ نّ عَ قَنيِ رَ،</para>
  <para style="q" vid="MIC 5:3">بَرِ مَ عَ شَ شُننَكٍلِ دُنِحَ بِرِن لِمَ نّ.<verse eid="MIC 5:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="MIC 5:4"/>عَ تَن نَن قِندِ مَ وٌن مَ بْحّسَ رَ.</para>
  <para style="q" vid="MIC 5:4">عَسِرِيَكَيٍ نَ قَ وٌن مَ بْشِ مَ،</para>
  <para style="q" vid="MIC 5:4">عٍ سٌ وٌن مَ يِرٍ مَكَنتَشِيٍ كُي،</para>
  <para style="q" vid="MIC 5:4">وٌن كَنتَمَ سٌلٌقٍرٍ نُن مَنفّ سٌلٌمَسَشَن نَن كٍلِمَ عٍ شِلِ مَ.<verse eid="MIC 5:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="MIC 5:5"/>عٍ عَسِرِيَ بْشِ يَمَرِ مَ نّ سَنتِدّفّمَ رَ،</para>
  <para style="q" vid="MIC 5:5">عٍ دْشْ نِمِرٌدِ شَ بْشِ شُن مَ تَنبّ رَ.</para>
  <para style="q" vid="MIC 5:5">وٌن مَ مَنفّ وٌن بَمَ نّ عَسِرِيَكَيٍ يِ رَ،</para>
  <para style="q" vid="MIC 5:5">عٍ نَ تُفَن وٌن مَ نَانِنيِ شُن مَ، عٍ سٌ وٌن مَ بْشِ كُي.<verse eid="MIC 5:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="MIC 5:6"/>يَشُبَ بْنسْي دْنشْييٍ لُمَ نّ دُنِحَ سِيٍ يَ مَ،</para>
  <para style="q" vid="MIC 5:6">عَلْ شِنِ نَشَن كٍلِمَ عَلَتَلَ مَ،</para>
  <para style="q" vid="MIC 5:6">عَلْ تُنّ يٍ نَشَن دْشْمَ بُرّشّ رَ.</para>
  <para style="q" vid="MIC 5:6">عٍ مُ عٍ شَشِلِ تِمَ عِبُنَدَ مَ رَ،</para>
  <para style="q" vid="MIC 5:6">عٍ مُ عٍ يّتّ تَشُمَ مِشِ يٌ رَ.<verse eid="MIC 5:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="MIC 5:7"/>يَشُبَ بْنسْي دْنشْييٍ لُمَ نّ دُنِحَ سِ فبٍفبٍ يَ مَ،</para>
  <para style="q" vid="MIC 5:7">عَلْ يّتّ نَشَن تِمَ وُلَءِ سُبٍيٍ تَفِ،</para>
  <para style="q" vid="MIC 5:7">عَلْ يّتّ يْرّ نَشَن حّرّ مَ شُرُ سٍيٍ يَ مَ،</para>
  <para style="q" vid="MIC 5:7">عَ قَ دُتُن ندٍيٍ مَ، عَ عٍ عِبْو، مِشِ يٌ مُ نْمَ عٍ بَدٍ عَ يِ رَ.<verse eid="MIC 5:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="MIC 5:8"/>عِ شُن نَكٍلِمَ نّ عِ يَشُييٍ يَ عِ، عٍ بِرِن سْنتْ.<verse eid="MIC 5:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="MIC 5:9"/>عَلَتَلَ نَشَ عَ مَسٍن،</para>
  <para style="q" vid="MIC 5:9">«لْشْ ندٍ قَمَ عَ لِدٍ،</para>
  <para style="q" vid="MIC 5:9">ﭑ وٌ شَ سٌييٍ نُن وٌ شَ سْورِ رَفِسٍيٍ شَ قٍ كَنَمَ نّ.<verse eid="MIC 5:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="MIC 5:10"/>ﭑ وٌ شَ بْشِ شَ تَايٍ كَنَمَ نّ،</para>
  <para style="q" vid="MIC 5:10">ﭑ وٌ شَ يِرٍ مَكَنتَشِيٍ رَبِرَ.<verse eid="MIC 5:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="MIC 5:11"/>ﭑ وٌ شَ دُورٍيَ كَنَمَ نّ،</para>
  <para style="q" vid="MIC 5:11">ﭑ وٌ شَ سٍ مَتٌي رَيٍنسٍن يّ.<verse eid="MIC 5:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="MIC 5:12"/>ﭑ وٌ شَ كُيٍيٍ نُن وٌ شَ فّمّ مَسٌلِشِ بِرِن كَنَمَ نّ.</para>
  <para style="q" vid="MIC 5:12">نَ تّمُي، وٌ مُ سُيِدِ مَ سٍ يَءِلَنشِيٍ بّ سْنْن.<verse eid="MIC 5:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="MIC 5:13"/>ﭑ وٌ شَ عَسٍرِ وُرِ مَسٌلِشِيٍ تَلَمَ نّ وٌ تَفِ،</para>
  <para style="q" vid="MIC 5:13">ﭑ وٌ شَ تَايٍ كَنَمَ نّ،<verse eid="MIC 5:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="MIC 5:14"/>ﭑ ﭑ فبٍحْشْمَ شْنّ نَن كُي، سِيٍ مَ</para>
  <para style="q" vid="MIC 5:14">نَشٍيٍ مُ تِن ﭑ شُي سُشُدٍ.»<verse eid="MIC 5:14"/></para>
  <chapter eid="MIC 5"/>
  <chapter number="6" style="c" sid="MIC 6"/>
  <para style="s">عَلَتَلَ شَ كَلَمُي</para>
  <para style="q">
    <verse number="1" style="v" sid="MIC 6:1"/>وٌ وٌ تُلِ مَتِ عَلَتَلَ شَ مَسٍنيِ رَ؛</para>
  <para style="q" vid="MIC 6:1">«كٍلِ، وٌ شَ وٌ شَ كَلَمُي تِ فٍيَيٍ يَ شْرِ،</para>
  <para style="q" vid="MIC 6:1">دُنِحَ بِرِن شَ عِ شُي مّ.<verse eid="MIC 6:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="MIC 6:2"/>فٍيَ نَشٍيٍ نَ دُنِحَ مَ كَبِ عَ قْلّ،</para>
  <para style="q" vid="MIC 6:2">وٌ شَ ﭑ تَن عَلَتَلَ شَ كَلَمُي مّ،</para>
  <para style="q" vid="MIC 6:2">ﭑ نَشَن تِمَ ﭑ مَ حَمَ عِسِرَيِلَ شِلِ مَ.»<verse eid="MIC 6:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="MIC 6:3"/>«ﭑ مَ حَمَ، ﭑ مُنسٍ رَبَشِ وٌ رَ؟</para>
  <para style="q" vid="MIC 6:3">ﭑ كٌتٍ مُندُن دْشْشِ وٌ شُن مَ؟</para>
  <para style="q" vid="MIC 6:3">وٌ شَ ﭑ يَابِ.<verse eid="MIC 6:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="MIC 6:4"/>ﭑ وٌ رَ مِنِشِ نّ مِسِرَ بْشِ رَ،</para>
  <para style="q" vid="MIC 6:4">ﭑ وٌ شُن سَرَ كٌنيِيَ كُي.</para>
  <para style="q" vid="MIC 6:4">ﭑ نَشَ مُنسَ، هَرُنَ، نُن مَرِيَمَ شّي وٌ رَ مِنِدٍ.<verse eid="MIC 6:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="MIC 6:5"/>ﭑ مَ حَمَ، وٌ شَ وٌ رَتُ عَ مَ،</para>
  <para style="q" vid="MIC 6:5">مٌوَبَ مَنفّ بَلَكِ نُ وَ مَ نَشَن نَبَقٍ وٌ رَ،</para>
  <para style="q" vid="MIC 6:5">عَ نُن بٍيٌرِ شَ دِ بَلَمِ شَ يَابِ.</para>
  <para style="q" vid="MIC 6:5">وٌ شَ وٌ رَتُ وٌ شَ بِيَاسِ مَ كٍلِقٍ سِتِمِ هَن فِلِفَلِ،</para>
  <para style="q" vid="MIC 6:5">عَلَتَلَ شَ قٍ تِنشِنشِيٍ عَ نَشٍيٍ رَبَشِ وٌ بّ.»<verse eid="MIC 6:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="MIC 6:6"/>ﭑ قَمَ مُنسٍ رَ عَلَتَلَ بّ ﭑ شَ مَنفّ عَلَ بَتُ؟</para>
  <para style="q" vid="MIC 6:6">عَ لَنمَ ﭑ شَ قَ سّرّشّ نَن نَ عَ بّ،</para>
  <para style="q" vid="MIC 6:6">سّرّشّ فَن دَاشِ عَلْ نِنفٍ نَشٍيٍ بَرَ حّ كٍرٍن سْتْ؟<verse eid="MIC 6:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="MIC 6:7"/>عَلَتَلَ وَ مَ يّشّي كٌنتٌنيِ فَلِ نَن شْن مَ،</para>
  <para style="q" vid="MIC 6:7">شَ نَ مُ عَ رَ، تُرٍ فبٍفبٍ نَشَن مُ حْنمَ؟</para>
  <para style="q" vid="MIC 6:7">عَ لَنمَ ﭑ شَ ﭑ مَ دِ سِنفٍ بَ سّرّشّ رَ ﭑ مَ يُنُبِ سَرٍ رَ؟</para>
  <para style="q" vid="MIC 6:7">ﭑ دِ نَشَن سْتْ، نَ نْمَ قِندِدٍ نَ شَقَرِ سٍ رَ؟<verse eid="MIC 6:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="MIC 6:8"/>عَلَ بَرَ عَدَ مَدِ رَكٌلٌن قٍ رَ نَشَن قَن،</para>
  <para style="q" vid="MIC 6:8">عَ وَ مَ عِ شَ نَشَن نَبَ؟</para>
  <para style="q" vid="MIC 6:8">عَ وَ مَ نّ عِ شَ تِنشِن،</para>
  <para style="q" vid="MIC 6:8">دُفُتّفّيَ شَ رَقَن عِ مَ،</para>
  <para style="q" vid="MIC 6:8">عِ مَن شَ بِرَ عَلَتَلَ قْشْ رَ يّتّ مَفٌرٍ كُي.<verse eid="MIC 6:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="MIC 6:9"/>عَلَتَلَ نَ تَاكَيٍ شِلِقٍ.</para>
  <para style="q" vid="MIC 6:9">شَشِلِمَ قَمَ نَ تٌدٍ، عَ قَ فَاشُ عَلَ يَ رَ.</para>
  <para style="q" vid="MIC 6:9">«وٌ وٌ تُلِ مَتِ عَ شَ كِيتِ رَ، وٌ نَشَ وٌ كٌبٍ سٌ نَ كِيتِسَ رَ.<verse eid="MIC 6:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="MIC 6:10"/>نَاقُلِ نَ وٌ شْنيِ وٌ نَشَن سْتْ تِنشِنتَرٍيَ كُي؟</para>
  <para style="q" vid="MIC 6:10">مَنِيَ سٍ كَمَلِتَرٍيٍ نَ وٌ شْنيِ ﭑ نَشٍيٍ شْنشِ؟<verse eid="MIC 6:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="MIC 6:11"/>ﭑ نْمَ دِحّدٍ مَنِيَ سٍ تِنشِنتَرٍيٍ كَنيِ مَ؟<verse eid="MIC 6:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="MIC 6:12"/>تَا بَننَيٍ قِندِشِ قٍ كٌبِ رَبَيٍ نَن نَ،</para>
  <para style="q" vid="MIC 6:12">تَاكَيٍ وُلٍ نَن تُن قَلَمَ، عٍ مِشِيٍ مَدَشُ.»<verse eid="MIC 6:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="MIC 6:13"/>«نَ كُي ﭑ بَرَ وٌ تْورْ قْلْ،</para>
  <para style="q" vid="MIC 6:13">ﭑ شَ وٌ هَلَكِ وٌ شَ يُنُبِيٍ شَ قٍ رَ.<verse eid="MIC 6:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="MIC 6:14"/>وٌ وٌ دّفٍمَ نّ، كْنْ وٌ مُ قَمَ لُفَدٍ،</para>
  <para style="q" vid="MIC 6:14">وٌ دٌنسٍ رَفَتَمَ نّ، كْنْ عَ مُ لُمَ نَا.</para>
  <para style="q" vid="MIC 6:14">نَ بَمَ نّ وٌ يِ رَ سَنتِدّفّمَ رَ.<verse eid="MIC 6:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="MIC 6:15"/>وٌ شّ سَمَ نّ، كْنْ وٌ مُ عَ شَبَمَ،</para>
  <para style="q" vid="MIC 6:15">وٌ عٌلِوِ بٌفِ بُندُ مَ نّ، كْنْ وٌ مُ عَ تُرٍ دٌنمَ،</para>
  <para style="q" vid="MIC 6:15">وٌ وّنِ بٌفِ دُندُ مَ نّ، كْنْ وٌ مُ عَ مِنمَ.<verse eid="MIC 6:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="MIC 6:16"/>وٌ بِرَ نّ عٌمِرِ شَ يَامَرِيٍ قْشْ رَ،</para>
  <para style="q" vid="MIC 6:16">وٌ عَكَبُ شَ نَامُنيِيٍ قِندِ وٌ فبٍ رَ.</para>
  <para style="q" vid="MIC 6:16">ﭑ وٌ سْنتْمَ نَ نَن مَ،</para>
  <para style="q" vid="MIC 6:16">ﭑ وٌ شَ حَمَ قِندِ مَ نّ مَيٍلٍ سٍ رَ دُنِحَ يَ شْرِ،</para>
  <para style="q" vid="MIC 6:16">ﭑ وٌ لُمَ نّ يَافِ كُي سِيٍ تَفِ.»<verse eid="MIC 6:16"/></para>
  <chapter eid="MIC 6"/>
  <chapter number="7" style="c" sid="MIC 7"/>
  <para style="s">عَلَ شَ حَشَنكَتّ نُن عَ شَ كِسِ</para>
  <para style="q">
    <verse number="1" style="v" sid="MIC 7:1"/>ﭑ نَ تْورْقٍ يِ كِ!</para>
  <para style="q" vid="MIC 7:1">ﭑ لُشِ نّ عَلْ مِشِ نَشَن سِفَمَ سَنسِ بٌفِ بَدٍ عَ بَ تّمُي،</para>
  <para style="q" vid="MIC 7:1">كْنْ عَ مُ وّنِ بٌفِ تٌمَ نَا،</para>
  <para style="q" vid="MIC 7:1">عَ مُ شْرّ قَنيِ لِمَ وُرِ كْن نَ عَلْ عَ وَ مَ عَ شْن مَ كِ نَشّ.<verse eid="MIC 7:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="MIC 7:2"/>عَلَ شَنُنتٍنيِيٍ بَرَ حْن بْشِ مَ،</para>
  <para style="q" vid="MIC 7:2">تِنشِنتْي كٍرٍن مُ لُمَ نَا.</para>
  <para style="q" vid="MIC 7:2">عٍ بِرِن نَ عٍ بٌورٍ تْورْقٍ عَ حَاشِ رَ،</para>
  <para style="q" vid="MIC 7:2">كَنكَن فَنتَنيِ تٍمَ عَ نفَشَكٍرٍنيِ بّ.<verse eid="MIC 7:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="MIC 7:3"/>عٍ بِرِن قَتَ قٍ حَاشِ رَبَدٍ.</para>
  <para style="q" vid="MIC 7:3">مَنفّيٍ، نٍيٍ وَ مَ بُحَ تِنشِنتَرٍ شْن مَ.</para>
  <para style="q" vid="MIC 7:3">كِيتِسَيٍ، نٍيٍ كِيتِ سَمَ كْبِرِ نَن تُن مَ قٍ رَ.</para>
  <para style="q" vid="MIC 7:3">كُنتِفِيٍ، نٍيٍ قَن عٍ شَ وَ سَبَلِيَ مَسٍنمَ.</para>
  <para style="q" vid="MIC 7:3">عٍ بِرِن نَ قٍ كٍرٍن نّ.<verse eid="MIC 7:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="MIC 7:4"/>نَشَن نَ قِسَمَنتٍ رَ وٌ يَ مَ،</para>
  <para style="q" vid="MIC 7:4">نَ تَن لُمَ نّ عَلْ تُنبٍ شْنّ.</para>
  <para style="b" vid="MIC 7:4"/>
  <para style="q" vid="MIC 7:4">عَلَ شَ كِيتِ لْشْي بَرَ عَ لِ،</para>
  <para style="q" vid="MIC 7:4">عَلْ حَمَ مَكَنتّ عَ قَلَ كِ نَشّ.</para>
  <para style="q" vid="MIC 7:4">حَمَ بْحّ مِنِ تّمُي بَرَ قَ.<verse eid="MIC 7:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="MIC 7:5"/>وٌ نَشَ لَ وٌ دّ قَن بٌورٍ رَ،</para>
  <para style="q" vid="MIC 7:5">وٌ نَشَ لَ وٌ شَنُنتٍنيِ رَ،</para>
  <para style="q" vid="MIC 7:5">هَلِ وٌ شَ فِنّ نَشَن عَ سَمَ وٌ قّ مَ،</para>
  <para style="q" vid="MIC 7:5">وٌ نَشَ وٌ شَ فُندٌ بِرِن مَسٍن عَ بّ.<verse eid="MIC 7:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="MIC 7:6"/>نَ وَشَتِ دِ شّمّ عَ بَبَ مَبٍرٍ مَ نّ،</para>
  <para style="q" vid="MIC 7:6">دِ فِنّ تِ عَ نفَ كَنكٍ عِ،</para>
  <para style="q" vid="MIC 7:6">مَمَدِ نُن عَ شَ مْرِ نفَ كْنحّمَ نّ.</para>
  <para style="q" vid="MIC 7:6">كَنكَن يَشُي قِندِ مَ عَ بَرِ بٌورٍ يَتِ نَن نَ.<verse eid="MIC 7:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="MIC 7:7"/>كْنْ ﭑ تَن، ﭑ يَ تِمَ عَلَتَلَ نَن نَ،</para>
  <para style="q" vid="MIC 7:7">ﭑ نَ ﭑ شَشِلِ تِمَ ﭑ نَكِسِمَ عَلَ نَن نَ،</para>
  <para style="q" vid="MIC 7:7">بَرِ مَ ﭑ مَرِفِ ﭑ شُي سُشُمَ نّ.<verse eid="MIC 7:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="MIC 7:8"/>عِ تَن عِسِرَيِلَ يَشُي،</para>
  <para style="q" vid="MIC 7:8">عِ نَشَ حّلّشِن ﭑ مَ تْورّ رَ.</para>
  <para style="q" vid="MIC 7:8">هَلِ ﭑ بِرَ نّ، ﭑ مَن كٍلِمَ نّ.</para>
  <para style="q" vid="MIC 7:8">هَلِ ﭑ لُ نّ دِ مِ شْورَ، عَلَتَلَ نَن نَ ﭑ مَ يَنبّ رَ.<verse eid="MIC 7:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="MIC 7:9"/>ﭑ تٌ يُنُبِ رَبَ عَلَتَلَ رَ،</para>
  <para style="q" vid="MIC 7:9">ﭑ قَمَ نّ عَ شَ شْنّ سْتْدٍ هَن عَ كَمَلِ،</para>
  <para style="q" vid="MIC 7:9">عَ قَ ﭑ شُن مَقَلَدٍ، عَ عَ شَ تِنشِنيِ مَسٍن ﭑ بّ.<verse eid="MIC 7:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="MIC 7:10"/>ﭑ يَشُييٍ نَ نَ تٌ، عٍ يَافِمَ نّ.</para>
  <para style="q" vid="MIC 7:10">سِنفٍ عٍ نُ عَ قَلَمَ، «عِ مَرِفِ عَلَتَلَ نَ مِندٍن؟»</para>
  <para style="q" vid="MIC 7:10">كْنْ نَ تّمُي ﭑ تَن نَن عٍ شَ بِرّ تٌمَ،</para>
  <para style="q" vid="MIC 7:10">عٍ مَبٌرٌن سَنيِ رَ عَلْ بٌورَ نَشَن نَ كِرَ رَ.<verse eid="MIC 7:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="MIC 7:11"/>عِ تَن عِسِرَيِلَ، وٌ شَ تّتّ رَكٍلِ لْشْي قَمَ نّ،</para>
  <para style="q" vid="MIC 7:11">وٌ شَ نَانِنيِيٍ عِفبٌمَ نّ.<verse eid="MIC 7:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="MIC 7:12"/>نَ لْشْي مِشِيٍ قَمَ نّ وٌ يِرٍ،</para>
  <para style="q" vid="MIC 7:12">كٍلِقٍ عَسِرِيَ نُن مِسِرَ تَايٍ كُي،</para>
  <para style="q" vid="MIC 7:12">كٍلِقٍ مِسِرَ بْشِ هَن عٍقِرَتِ شُرٍ،</para>
  <para style="q" vid="MIC 7:12">كٍلِقٍ بَا ندٍ مَ عَ سَ دْشْ بَا فبّتّ رَ،</para>
  <para style="q" vid="MIC 7:12">كٍلِقٍ فٍيَ ندٍ مَ عَ سَ دْشْ فٍيَ فبّتّ رَ.<verse eid="MIC 7:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="MIC 7:13"/>دُنِحَ بْشِ قَمَ نّ كَنَدٍ مِشِيٍ شَ وَلِ حَاشِيٍ شَ قٍ رَ.<verse eid="MIC 7:13"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="14" style="v" sid="MIC 7:14"/>مّينِ عِ شَ حَمَ مَ،</para>
  <para style="q" vid="MIC 7:14">بَرِ مَ عٍ قِندِشِ عِ كّ نَن نَ،</para>
  <para style="q" vid="MIC 7:14">نَشٍيٍ سَبَتِشِ عٍ كٍرٍنيِ مَ قْتْنيِ كُي قِيلِ قَنيِ سّيتِ مَ.</para>
  <para style="q" vid="MIC 7:14">عٍ شَ عٍ دّ مَدٌن عَ قَنيِ رَ،</para>
  <para style="q" vid="MIC 7:14">عَلْ عٍ نُ عَ رَبَشِ بَسَن نُن فَلَدِ بْشِ مَ تّمُي دَنفِشِ كِ نَشّ.<verse eid="MIC 7:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="MIC 7:15"/>ﭑ كَابَنَكٌي مَسٍنمَ نّ عٍ بّ،</para>
  <para style="q" vid="MIC 7:15">عَلْ عٍ مِنِ مِسِرَ بْشِ رَ لْشْي نَشّ.<verse eid="MIC 7:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="MIC 7:16"/>سِيٍ نَ وٌ سّنبّ تٌ، عٍ يَافِمَ نّ عٍ شَ سّنبّتَرٍيَ كُي.<verse eid="MIC 7:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="MIC 7:17"/>عٍ شُبٍ دٌنمَ نّ عَلْ بْشِمَسٍ،</para>
  <para style="q" vid="MIC 7:17">عٍ لُمَ فَاشُي نَن كُي وٌن مَرِفِ عَلَتَلَ يَ رَ، عٍ قَ سّرّن.<verse eid="MIC 7:17"/></para>
  <para style="q">
    <verse number="18" style="v" sid="MIC 7:18"/>عَلَ مُندُن نَ نَشَن مَنِيَ عِ رَ،</para>
  <para style="q" vid="MIC 7:18">نَشَن يُنُبِ شَقَرِ مَ،</para>
  <para style="q" vid="MIC 7:18">نَشَن دِحّمَ عَ شَ كّ تٌنفٌمَيٍ دْنشْييٍ مَ؟</para>
  <para style="q" vid="MIC 7:18">عِ مُ شْنّ رَفَتَمَ عَبَدَن،</para>
  <para style="q" vid="MIC 7:18">بَرِ مَ دُفُتّفّيَ مَسٍنقٍ مُشُ بّ عَ رَقَن عِ مَ.<verse eid="MIC 7:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="MIC 7:19"/>عِ مَن كِنِكِنِمَ نّ مُشُ مَ،</para>
  <para style="q" vid="MIC 7:19">عِ قَمَ نّ مُشُ شَ يُنُبِيٍ لُدٍ نَا،</para>
  <para style="q" vid="MIC 7:19">عِ قَ عٍ وٌلِ بَا بْتِنِ مَ.<verse eid="MIC 7:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="MIC 7:20"/>عِ عِ شُي رَكَمَلِمَ نّ يَشُبَ بْنسْي بّ،</para>
  <para style="q" vid="MIC 7:20">عِ هِننّمَ نّ عِبُرَهِمَ بْنسْي رَ،</para>
  <para style="q" vid="MIC 7:20">عَلْ عِ عِ كَلِ عَ رَ مُشُ بٍنبَيٍ بّ كِ نَشّ تّمُي دَنفِشِ.<verse eid="MIC 7:20"/></para>
  <chapter eid="MIC 7"/>
</usx>
