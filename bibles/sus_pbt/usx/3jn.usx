<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="3JN" style="id"/>
  <para style="h">يَيَ عِِِ</para>
  <para style="toc1">عَلَ شَ مَسٍنيِ سَشَن ندٍ عَننَبِ يَيَ نَشَن سّبّ</para>
  <para style="toc2">يَيَ عِِِ</para>
  <para style="mt">عَلَ شَ مَسٍنيِ سَشَن ندٍ</para>
  <para style="mt">عَننَبِ يَيَ نَشَن سّبّ</para>
  <para style="imt">مَسٍنيِ ندٍ يِ كِتَابُي شَ قٍ رَ</para>
  <para style="ip">عَننَبِ يَيَ نَن يِ بَتَاشّ سَشَن ندٍ سّبّ دَنشَنِيَتْي ندٍ مَ، نَشَن شِلِ فَيُ. عَ نَشَ عَ مَتْشْ بَرِ مَ عَ نُ حّرّ مَ نْندِ نَن كُي، عَ تٌندِ نّ نَ وُلٍ شَرَنيِ رَ نَشَن نُ يٍنسٍنشِ نَ وَشَتِ.</para>
  <para style="ip">كَرَ مْشْ قَنيِيٍ تٌ سِفَ فَيُ شْنيِ، عَ نَشَ عٍ رَ سّنّ شَنُنتٍيَ رَ. نَ قٍ نَشَ رَقَن عَننَبِ يَيَ مَ. مِشِ نَشَن لُمَ نَ مْولِ رَبَ رَ، عَ بَرَ نْندِ نُن شَنُنتٍيَ كٌلٌن. ندٍيٍ نُ نَ دَنشَنِيَتْييٍ يَ مَ نَشٍيٍ مُ نُ وَ مَ نَ مْولِ رَبَقٍ.</para>
  <para style="ip">عَلَ شَ وٌن مَلِ عَلَكٌ وٌن بْحّ نَشَ بَلَن عَلَ شَ مِشِيٍ مَبِرِ. عَمِنَ.</para>
  <para style="imte">عَلَ شَ مَسٍنيِ سَشَن ندٍ</para>
  <para style="imte">عَننَبِ يَيَ نَشَن سّبّ</para>
  <para style="cl">سٌرَ</para>
  <chapter number="1" style="c" sid="3JN 1"/>
  <para style="s">نْندِ كٌلٌنيِيٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1"/>ﭑ تَن دَنشَنِيَتْي حَمَ شَ كُنتِفِ، ﭑ بَرَ عِ شّيبُ، ﭑ شَنُنتٍنيِ فَيُ، ﭑ نَشَن شَنُشِ نْندِ شَ قٍ رَ. <verse eid="3JN 1:1"/><verse number="2" style="v" sid="3JN 1:2"/>ﭑ شَنُنتٍنيِ، عَلَ شَ قٍ بِرِن سْونّيَ عِ بّ. عِ قَتٍ شَ لُ يَلَنيِ كُي عَلْ عِ شَ دَنشَنِيَ يَلَنشِ كِ نَشّ.<verse eid="3JN 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="3JN 1:3"/>وٌن بٌورٍ دَنشَنِيَتْي ندٍيٍ تٌ قَ ﭑ يِرٍ، عٍ نَشَ عَ قَلَ ﭑ بّ عِ حّرّ مَ نْندِ كُي. ﭑ نَشَ سّيوَ كِ قَنيِ رَ. <verse eid="3JN 1:3"/><verse number="4" style="v" sid="3JN 1:4"/>سّيوّ يٌ مُ دَنفِمَ نَ مْولِ رَ، عَ كٌلٌنقٍ رَ عَ ﭑ مَ دِيٍ نَ نْندِ كِرَ نَن شْن مَ.<verse eid="3JN 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5"/>ﭑ شَنُنتٍنيِ، عِ مّينِمَ شْحّ دَنشَنِيَتْييٍ مَ هَلِ وٌ مُ وٌ بٌرٍ كٌلٌن. <verse eid="3JN 1:5"/><verse number="6" style="v" sid="3JN 1:6"/>ندٍيٍ بَرَ عِ شَ شَنُنتٍيَ شَ قٍ دّنتّفّ سَ دَنشَنِيَتْي حَمَ بّ. دَنشَنِيَتْي نَشَن يٌ دَنفِمَ عِ شْنيِ، عِ شَ عٍ مَلِ عٍ شَ بِيَاسِ كُي، عَلْ عَلَ وَ مَ عَ شْن مَ كِ نَشّ. <verse eid="3JN 1:6"/><verse number="7" style="v" sid="3JN 1:7"/>عٍ نَ عَلَ شَ وَلِ نَن كُي، دَنشَنِيَتَرٍيٍ تَن مُ عٍ كِمَ. <verse eid="3JN 1:7"/><verse number="8" style="v" sid="3JN 1:8"/>وٌن لَن وٌن شَ كَقُ نَ مِشِ مْولِ مَ، عَلَكٌ وٌن قَن شَ وٌن فبٍ رَبَ عَلَ شَ نْندِ شَ قٍ رَ.<verse eid="3JN 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9"/>ﭑ بَرَ بَتَاشّ ندٍ سّبّ دَنشَنِيَتْي حَمَ مَ، كْنْ دِيٌتٍرٍقِ مُ تِنشِ مُشُ رَ سّنّدٍ بَرِ مَ عَ وَ مَ قِندِقٍ شُنيِ رَ. <verse eid="3JN 1:9"/><verse number="10" style="v" sid="3JN 1:10"/>ﭑ نَ قَ وٌ يِرٍ، ﭑ دّنتّفّ سَمَ نّ وٌ بّ عَ شَ كّوَلِ شَ قٍ رَ. عَ مُشُ شِلِ كَنَمَ، عَ مَن مُ تِنمَ دَنشَنِيَتْييٍ يِفِيَدٍ. هَلِ نَشٍيٍ وَ مَ عٍ يِفِيَقٍ، عَ تْنيِ دْشْمَ نٍيٍ قَن مَ، عَ عٍ كٍرِ دَنشَنِيَتْييٍ يَ مَ.<verse eid="3JN 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11"/>ﭑ شَنُنتٍنيِ، عِ قٍ حَاشِ نَشَن تٌمَ، عِ نَشَ بِرَ نَ مْولِ قْشْ رَ. عِ قٍ قَنيِ نَشَن تٌمَ، عِ شَ بِرَ نَ نَن قْشْ رَ. قٍ قَنيِ رَبَيٍ نَ عَلَ نَن بّ، كْنْ قٍ حَاشِ رَبَيٍ تَن مُ عَلَ كٌلٌن. <verse eid="3JN 1:11"/><verse number="12" style="v" sid="3JN 1:12"/>بِرِن قٍ قَنيِ قَلَمَ دٍ مٍتِرِ شَ قٍ رَ. نْندِ يَتِ عَ يّتّ كَن سٍيدٍ بَشِ. هَلِ مُشُ تَن مُشُ نْمَ عَ شَ قٍ سٍيدٍ بَدٍ. عِ عَ كٌلٌن مُشُ مُ وُلٍ قَلَمَ.<verse eid="3JN 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13"/>ﭑ وَ مَ قٍ فبٍفبٍ قَلَقٍ عِ بّ، كْنْ ﭑ مُ وَ مَ نَ رَبَقٍ سّبّلِ رَ. <verse eid="3JN 1:13"/><verse number="14" style="v" sid="3JN 1:14"/>عَ فبٍ مُ لُشِ وٌن شَ لُ يِرٍ كٍرٍن، وٌن شَ سُمُن. <verse eid="3JN 1:14"/><verse number="15" style="v" sid="3JN 1:15"/>عَلَ شَ بْحّسَ قِ عِ مَ. مُشُ بٌورٍيٍ بَرَ عِ شّيبُ. عِ قَن شَ وٌن شَنُنتٍنيِيٍ شّيبُ مُشُ بّ كٍرٍن كٍرٍن.<verse eid="3JN 1:15"/></para>
  <chapter eid="3JN 1"/>
</usx>
