<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JAS" style="id">Sara rough draft. Reworked May 2002.</book>
  <para style="h">يَكِ</para>
  <para style="toc1">عَلَ شَ مَسٍنيِ عَننَبِ يَكِ نَشَن سّبّ</para>
  <para style="toc2">يَكِ</para>
  <para style="mt">عَلَ شَ مَسٍنيِ</para>
  <para style="mt">عَننَبِ يَكِ نَشَن سّبّ</para>
  <para style="imt">مَسٍنيِ ندٍ يِ كِتَابُي شَ قٍ رَ</para>
  <para style="ip">يِ كِتَابُي قِندِشِ بَتَاشّ نَن نَ عَننَبِ يَكِ نَشَن سّبّ يُوِقِ دَنشَنِيَتْييٍ مَ نَشٍيٍ نُ يٍنسٍنشِ حَمَنّيٍ كُي. نَ وَشَتِ، قٍيٍ نُ شْرْشْشِ عِسَيَنكَيٍ مَ. هَلِ مَنفَسَنيِ، عَ نُ عٍ حَشَنكَتَمَ. عَلَ شَشِلِ سّنِيّنشِ نَشَ يِ مَسٍنيِ قِ عَننَبِ يَكِ مَ عَلَكٌ عَ شَ عَ سّبّ، عَ شَ قِندِ لِمَنِيَ رَ دَنشَنِيَتْييٍ بّ، عٍ شَ عٍ تُننَبّشِ عَلَ شَ نْندِ كِرَ شْن.</para>
  <para style="ip">يِ كِتَابُي مَرَ سِ فبٍفبٍ نَن قِمَ دَنشَنِيَتْي بِرِن مَ. عَ عَ مَسٍنمَ نّ وٌن بّ عَ عَلَ شَ قٍ قَلَقٍ، عَ نُن عَ شَ سّرِيّ رَبَتُقٍ، عٍ سٍسٍ كٍرٍن مُ عَ رَ. دَنشَنِيَ مُ قِندِ مَ نْندِ رَ، شَ عَ كَنيِ مُ بِرَ مَ عَلَ شَ يَامَرِيٍ قْشْ رَ عَ شَ دُنِحّءِفِرِ كُي. يِ كِتَابُي نَشّ عَ دَنشَنِيَ نُن كّوَلِ قَنيِ نَن حّرّ مَ كِرَ كٍرٍن شْن مَ. عٍ مُ نْمَ قَتَندٍ عٍ بٌرٍ رَ.</para>
  <para style="ip">يِ كِتَابُي وٌن نَسِمَ عَ لَنمَ وٌن شَ حّرّ كِ نَشّ وٌن مَ دَنشَنِيَ كُي. عَ مُ لَنمَ وٌن شَ مِشِيٍ رَقِسَ عٍ بٌورٍ بّ. وٌن شَ وٌن بٌرٍ مَلِ، وٌن شَ وٌن بٌرٍ بِنيَ، وٌن شَ وٌن بٌرٍ شَنُ. وٌن شَ وٌن دّ سُشُ، وْيّن كٌبِ نَشَ مِنِ وٌن دّ عِ. وٌن شَ وٌن تُننَبّشِ تْورّ كُي، وٌن مَن نَشَ وٌن يّتّ عِفبٌ. وٌن نَشَ وٌن شَشِلِ تِ يِ دُنِحَ رَ. قٍ بِرِن كُي، وٌن شَ وٌن شَشِلِ تِ عَلَتَلَ نَن نَ.</para>
  <para style="ip">عَلَ شَ وٌن مَلِ عَلَكٌ وٌن بِرِن شَ يِ سّرِيّ سُشُ عَ سُشُ كِ مَ. عَمِنَ.</para>
  <para style="imte">عَلَ شَ مَسٍنيِ</para>
  <para style="imte">عَننَبِ يَكِ نَشَن سّبّ</para>
  <para style="cl">سٌرَ</para>
  <chapter number="1" style="c" sid="JAS 1"/>
  <para style="s">تُننَبّشِيَ، دَنشَنِيَ، نُن عَلَ شَ سّرِيّ رَبَتُقٍ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 1:1"/>ﭑ تَن يَكِ نَن يِ كِ، عَلَ نُن عَ شَ مِشِ سُفَندِشِ مَرِفِ عِسَ شَ كٌنيِ. ﭑ بَرَ وٌ شّيبُ، وٌ تَن عِسِرَيِلَ بْنسْي قُ نُن قِرِنيِ نَشٍيٍ يٍنسٍنشِ حَمَنّيٍ مَ.<verse eid="JAS 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JAS 1:2"/>ﭑ نفَشَكٍرٍنيِيٍ، وٌ شَ سّيوَ تْورّ مْولِ بِرِن كُي، <verse eid="JAS 1:2"/><verse number="3" style="v" sid="JAS 1:3"/>بَرِ مَ وٌ عَ كٌلٌن عَ وٌ تْورّ نَشَن سْتْمَ دَنشَنِيَ كُي، عَ وٌ دُلُشْتْمَ نّ. <verse eid="JAS 1:3"/><verse number="4" style="v" sid="JAS 1:4"/>وٌ شَ دُلُشْتْ هَن عَ رَحْنيِ عَلَكٌ وٌ شَ دَنشَنِيَ شَ تِلِن، وٌ شَ قِندِ مِشِ كَمَلِشِيٍ رَ، قٍقٍ مُ لُشِ نَشٍيٍ شَ قٍ رَ.<verse eid="JAS 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 1:5"/>شَ قَهَامُي مُ نَ مِشِ ندٍ يِ رَ وٌ يَ مَ، عَ كَنيِ شَ عَلَ مَشَندِ. عَ عَ سْتْمَ نّ، بَرِ مَ عَلَ مِشِ بِرِن كِمَ عَ يِرِوَشِ رَ عَ شَ قٌنِسِرٍيَ مَ. <verse eid="JAS 1:5"/><verse number="6" style="v" sid="JAS 1:6"/>كْنْ قٌ مِشِ شَ عَلَ مَشَندِ دَنشَنِيَ رَ، عَ نَشَ سِيكّ، بَرِ مَ مِشِ سِيكّشِ لُمَ نّ عَلْ مْرْنيِ، قٌيٍ نَشَن بْنبْمَ، عَ عَ مَتُتُن. <verse eid="JAS 1:6"/><verse number="7" style="v" sid="JAS 1:7"/>نَ كَنيِ نَشَ عَ مَحْشُن عَ عَ سٍ ندٍ سْتْمَ عَلَ رَ، <verse eid="JAS 1:7"/><verse number="8" style="v" sid="JAS 1:8"/>بَرِ مَ عَ شَشِلِ مُ تِشِ عَلَ فبَنسَن شَ رَ، عَ سَنيِيٍ نَ كِرَ وُيَشِ نَن شْن.<verse eid="JAS 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 1:9"/>دَنشَنِيَتْي سٍتَرٍ شَ سّيوَ بَرِ مَ عَلَ بَرَ عَ شَ قٍ عِتٍ. <verse eid="JAS 1:9"/><verse number="10" style="v" sid="JAS 1:10"/>كْنْ بَننَ تَن شَ سّيوَ عَلَ تٌ بَرَ عَ شَ قٍ مَفٌرٌ، بَرِ مَ عَ شَ قٍ حْنمَ نّ عَلْ سَنسِ قُفٍ تٌقَنيِ. <verse eid="JAS 1:10"/><verse number="11" style="v" sid="JAS 1:11"/>سٌفٍ شْنّ نَ تٍ، سَنسِ لِسِمَ نّ هَن عَ قُفٍ بِرَ، عَ شَ تٌقَنيِ حْن. عَ نَ نَ كِ نّ بَننَ قَن بّ. عَ نَ عَ شَ وَلِيٍ كُي تّمُي نَشّ، عَ بِرِ مَ نَ لّيرِ نّ.<verse eid="JAS 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 1:12"/>حّلّشِنيِ نَ مِشِ بّ نَشَن عَ تُننَبّشِمَ تْورّ كُي، بَرِ مَ شَ عَ بَرَ فّ نَ تْورّ رَشَندٍ، عَلَ كِسِ شُننَكٍلِ قِمَ نّ عَ مَ. عَلَ نَ نَن لَايِدِشِ عَ شَنُنتٍنيِيٍ بّ.<verse eid="JAS 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 1:13"/>مِشِ نّ وَ مَ تَنتَنقٍ، عَ نَشَ عَ قَلَ عَ عَلَ نَن عَ رَتَنتَنقٍ، بَرِ مَ عَلَ مُ بِرَ مَ قٍ حَاشِ قْشْ رَ، عَ مَن مُ عَدَ مَ يٌ رَتَنتَنمَ قٍ حَاشِ رَ. <verse eid="JAS 1:13"/><verse number="14" style="v" sid="JAS 1:14"/>عَدَ مَ يّتّ وَشْنقٍ حَاشِ نَن عَ رَتَنتَنمَ. نَ نَن عَ مَبّندُنمَ هَن عَ عَ رَبِرَ. <verse eid="JAS 1:14"/><verse number="15" style="v" sid="JAS 1:15"/>عَدَ مَ وَشْنقٍ حَاشِ شَ دِ قِندِشِ يُنُبِ نَن نَ. يُنُبِ قَن نَ رَبَ، عَ شَ دِ قِندِ مَ قَشّ نَن نَ.<verse eid="JAS 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JAS 1:16"/>ﭑ نفَشَكٍرٍنيِ شَنُشِيٍ، وٌ نَشَ لَ وُلٍ رَ. <verse eid="JAS 1:16"/><verse number="17" style="v" sid="JAS 1:17"/>كِ هَفِفّ بِرِن قَتَنشِ دَالِ مَنفّ نَن نَ نَشَن نَ كٌورٍ، نَشَن سٌفٍ، كِكٍ، نُن تُنبُييٍ دَاشِ، نَشَن مُ مَسَرَ مَ عَبَدَن. <verse eid="JAS 1:17"/><verse number="18" style="v" sid="JAS 1:18"/>عَ يّتّ سَفٌي مَ، عَلَ بَرَ وٌن نَكِسِ عَ شَ نْندِ مَسٍنيِ سَابُي رَ، عَ وٌن قِندِ عَ شَ دِيٍ رَ، عَلَكٌ وٌن شَ بِنيّ سْتْ دَنفِقٍ عَ شَ دَالِسٍ بِرِن نَ.<verse eid="JAS 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 1:19"/>ﭑ نفَشَكٍرٍنيِ شَنُشِيٍ، وٌ شَ يِ وْيّنيِ مّ؛ وٌ بِرِن شَ وٌ تُلِ مَتِ وٌ بٌرٍ رَ، وٌ نَشَ فبَتَ وْيّنيِ رَ، وٌ بْحّ نَشَ تٍ مَقُرٍن نَ، <verse eid="JAS 1:19"/><verse number="20" style="v" sid="JAS 1:20"/>بَرِ مَ عَدَ مَدِ شَ شْنّ مُ عَ تُتُنمَ عَلَ شَ تِنشِنيِ مَ. <verse eid="JAS 1:20"/><verse number="21" style="v" sid="JAS 1:21"/>نَ نَ عَ رَ، وٌ شَ تٌندِ قٍ حَاشِ نُن قٍ كٌبِ مْولِ بِرِن نَبَدٍ. وٌ شَ وٌ يّتّ مَفٌرٌ، وٌ شَ نْندِ سُشُ نَشَن بَرَ مَسٍن وٌ بّ، بَرِ مَ نَ نَن نْمَ وٌ رَكِسِدٍ.<verse eid="JAS 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JAS 1:22"/>وٌ شَ عَلَ شَ مَسٍنيِ رَبَتُ. شَ وٌ عَ رَ مّ فبَنسَن كْنْ وٌ مُ عَ رَبَ، وٌ بَرَ وٌ يّتّ مَدَشُ. <verse eid="JAS 1:22"/><verse number="23" style="v" sid="JAS 1:23"/>شَ مِشِ ندٍ عَلَ شَ مَسٍنيِ رَ مّ، كْنْ عَ مُ بِرَ عَ قْشْ رَ، عَ لُمَ نّ عَلْ مِشِ نَشَن عَ يَتَفِ مَتٌمَ كِكٍ مَ، <verse eid="JAS 1:23"/><verse number="24" style="v" sid="JAS 1:24"/>عَ قَ سِفَ، عَ نّيمُ عَ يَتَفِ مَ عَ نَ كِ نَشّ. <verse eid="JAS 1:24"/><verse number="25" style="v" sid="JAS 1:25"/>كْنْ مِشِ نَشَن عَلَ شَ سّرِيّ كَمَلِشِ مَتٌمَ عَ قَنيِ رَ، عَ عَ تُننَبّشِ، عَ مُ نّيمُ سّرِيّ مَ كْنْ عَ عَ رَبَتُ، نَ كَنيِ بَرَكَمَ نّ. عَلَ شَ سّرِيّ شْرّيَ قِمَ نّ عَدَ مَدِيٍ مَ.<verse eid="JAS 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 1:26"/>مِشِ يٌ عَ يّتّ مَحْشُن دِينّلَ رَ، كْنْ عَ مُ عَ دّ نْشِ، نَ كَنيِ نَ عَ يّتّ مَدَشُقٍ نّ. عَ شَ دِينّ تِدٍ يٌ مُ نَ. <verse eid="JAS 1:26"/><verse number="27" style="v" sid="JAS 1:27"/>دِينّ قِيشّ نَشَن نَقَن بَبَ عَلَ مَ، عَ تَن نَن يَ؛ وٌن شَ مّينِ كِرِدِيٍ نُن كَاحّ فِنّيٍ مَ عٍ شَ تْورّ كُي، دُنِحَ قٍ مَن نَشَ وٌ مَدَشُ.<verse eid="JAS 1:27"/></para>
  <chapter eid="JAS 1"/>
  <chapter number="2" style="c" sid="JAS 2"/>
  <para style="s">مِشِ رَقِسَقٍ عَ بٌورٍ بّ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 2:1"/>ﭑ نفَشَكٍرٍنيِيٍ، وٌ نَشَ مِشِيٍ رَقِسَ عٍ بٌورٍ بّ، بَرِ مَ وٌ دَنشَنِيَشِ وٌن مَرِفِ عِسَ نْرّ كَنيِ نَن مَ، عَلَ شَ مِشِ سُفَندِشِ. <verse eid="JAS 2:1"/><verse number="2" style="v" sid="JAS 2:2"/>وٌ شَ وٌ مَحْشُن يِ مَ؛ مِشِ ندٍ نَشَ قَ وٌ مَلَنشِ دّننَشّ، شُرُندّ شّيمَ دَاشِ نَ عَ بّلّشّ رَ، دُفِ تٌقَنيِ رَفٌرٌشِ عَ مَ. سٍتَرٍ قَن نَشَ قَ، دُفِ قٌرِ تٌحَاشِ رَفٌرٌشِ عَ مَ. <verse eid="JAS 2:2"/><verse number="3" style="v" sid="JAS 2:3"/>شَ وٌ دُفِ تٌقَنيِ كَنيِ شّيبُ عَ قَنيِ رَ، وٌ قَ عَ قَلَ عَ بّ، «عِ مَفٌرٌدٍ قَنيِ نَن يِ كِ،» كْنْ وٌ قَ عَ قَلَ سٍتَرٍ تَن بّ، «تِ مّننِ،» شَ نَ مُ عَ رَ، «دْشْ بْشِ، ﭑ بُن مَ بٍ،» <verse eid="JAS 2:3"/><verse number="4" style="v" sid="JAS 2:4"/>وٌ مُ مِشِ رَقِسَشِ عَ بٌورٍ بّ شّ نَ كِ؟ وٌ مُ حّرّشِ مَحْشُن كٌبِ شَ رَ نَ كِ؟<verse eid="JAS 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 2:5"/>ﭑ نفَشَكٍرٍنيِ شَنُشِيٍ، وٌ وٌ تُلِ مَتِ ﭑ نَ. عَلَ بَرَ مِشِيٍ سُفَندِ نَشٍيٍ قِندِشِ سٍتَرٍيٍ رَ دُنِحَ كِ مَ، عَلَكٌ عٍ شَ قِندِ بَننَمِشِيٍ رَ دَنشَنِيَ كِ مَ. عَلَ بَرَ عٍ سُفَندِ عَلَكٌ عٍ شَ قِندِ كّتٌنفٌي رَ عَ شَ مَنفّيَ كُي. نَ نَن لَايِدِشِ مِشِيٍ بّ نَشٍيٍ عَلَ شَنُشِ. <verse eid="JAS 2:5"/><verse number="6" style="v" sid="JAS 2:6"/>كْنْ وٌ تَن، وٌ بَرَ سٍتَرٍيٍ مَبٍرٍ. بَننَمِشِيٍ شَ مُ وٌ تْورْ مَ، عٍ وٌ شَنِن كِيتِسَ شْن مَ؟ <verse eid="JAS 2:6"/><verse number="7" style="v" sid="JAS 2:7"/>عٍ تَن شَ مُ وٌ مَرِفِ شِلِ قَنيِ رَ سْتْمَ؟<verse eid="JAS 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JAS 2:8"/>وٌ شَ مَنفّ عَلَتَلَ شَ سّرِيّ نَن نَبَتُ، عَلْ عَ سّبّشِ كِتَابُي كُي كِ نَشّ، «عِ شَ عِ بٌورٍ شَنُ عَلْ عِ يّتّ كَن فُندِ.» شَ وٌ نَ رَبَ، وٌ بَرَ بِرَ قٍ قَنيِ قْشْ رَ. <verse eid="JAS 2:8"/><verse number="9" style="v" sid="JAS 2:9"/>كْنْ شَ وٌ مِشِ ندٍيٍ رَقِسَ عٍ بٌورٍ بّ، وٌ بَرَ يُنُبِ رَبَ. سّرِيّ نَن وٌ مَكِيتِمَ، بَرِ مَ وٌ بَرَ قِندِ سّرِيّ مَتَندِلَيٍ رَ. <verse eid="JAS 2:9"/><verse number="10" style="v" sid="JAS 2:10"/>شَ مِشِ سّرِيّ بِرِن نَبَتُ كْنْ عَ يِرٍ كٍرٍن مَتَندِ، نَ كَنيِ بَرَ سّرِيّ بِرِن مَتَندِ، <verse eid="JAS 2:10"/><verse number="11" style="v" sid="JAS 2:11"/>بَرِ مَ نَشَن عَ قَلَشِ، «عِ نَشَ يّنّ رَبَ،» عَ تَن نَن مَن عَ قَلَشِ، «عِ نَشَ قَشّ تِ.» هَلِ عِ مُ يّنّ رَبَ، كْنْ شَ عِ قَشّ تِ، عِ قِندِشِ عَلَ شَ سّرِيّ مَتَندِلَ نَن نَ.<verse eid="JAS 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 2:12"/>نَ كُي، وٌ شَ وْيّن، وٌ مَن شَ وٌ حّرّ عَلْ نَشٍيٍ قَمَ مَكِيتِدٍ سّرِيّ رَ نَشَن شْرّيَ قِمَ مِشِ مَ. <verse eid="JAS 2:12"/><verse number="13" style="v" sid="JAS 2:13"/>كِيتِ لْشْي، عَلَ مُ كِنِكِنِمَ مِشِ مَ نَشَن مُ كِنِكِنِ عَ بٌورٍ عَدَ مَ مَ. كِنِكِنِ سّنبّ فبٌ كِيتِ بّ.<verse eid="JAS 2:13"/></para>
  <para style="s">دَنشَنِيَ نُن عَ كّوَلِ</para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 2:14"/>ﭑ نفَشَكٍرٍنيِيٍ، عَ تِدٍ يٌ مُ نَ شَ مِشِ عَ قَلَ عَ عَ دَنشَنِيَشِ، كْنْ عَ مُ كّوَلِ قَنيِ رَبَمَ. يِ دَنشَنِيَ مْولِ نْمَ مِشِ رَكِسِدٍ؟ <verse eid="JAS 2:14"/><verse number="15" style="v" sid="JAS 2:15"/>شَ وٌ نفَشَكٍرٍنيِ مَفٍلِ نَ عَ رَ، لْشْي كٍرٍن بَلٌي مُ نَ عَ يِ رَ، <verse eid="JAS 2:15"/><verse number="16" style="v" sid="JAS 2:16"/>مِشِ ندٍ قَ لُ وٌ يَ مَ عَ عَ قَلَ عَ بّ، «سِفَ، عِ نَشَ كْنتْقِلِ، عِ شَ دُفِ ندٍ رَفٌرٌ عِ مَ، عِ شَ عِ دّفٍ،» كْنْ عَ قَ لُ عَ مُ عَ شَ كْنتْقِلِ بَ، نَ كَنيِ شَ وْيّنيِ تِدٍ يٌ مُ نَ. <verse eid="JAS 2:16"/><verse number="17" style="v" sid="JAS 2:17"/>دَنشَنِيَ نَ نَ كِ نّ. شَ عَ مُ مِشِ تُتُنمَ وَلِ قَنيِيٍ رَبَقٍ مَ، عَ تِدٍ يٌ مُ نَ.<verse eid="JAS 2:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JAS 2:18"/>كْنْ مِشِ ندٍ نْمَ عَ قَلَدٍ، «عِ تَن، دَنشَنِيَ كَنيِ نَن عِ رَ، كْنْ ﭑ تَن قٍ قَنيِ رَبَ نَن ﭑ نَ.» كَتَ عِ شَ عِ شَ دَنشَنِيَ مَسٍن ﭑ بّ وَلِ قَنيِ شَنبِ. ﭑ تَن ﭑ مَ دَنشَنِيَ مَسٍنمَ عِ بّ ﭑ مَ كّوَلِ قَنيِ نَن سَابُي رَ. <verse eid="JAS 2:18"/><verse number="19" style="v" sid="JAS 2:19"/>عِ لَشِ عَ رَ، عَ عَلَ كٍرٍن نَ عَ رَ. نَ قَن كِ قَنيِ، كْنْ هَلِ حِننّيٍ لَشِ نَ رَ، عٍ سّرّن فَاشُي رَ. <verse eid="JAS 2:19"/><verse number="20" style="v" sid="JAS 2:20"/>عِ تَن شَشِلِتَرٍ، عِ مُ عَ كٌلٌن دَنشَنِيَ نَشَن مُ كّوَلِ قَنيِ رَ مِنِمَ، عَ تِدٍ يٌ مُ نَ؟ <verse eid="JAS 2:20"/><verse number="21" style="v" sid="JAS 2:21"/>مُنقٍ عَ نِيَ وٌن بَبَ عِبُرَهِمَ نَشَ قِندِ تِنشِنتْي رَ عَلَ يَ عِ؟ عَ مُ قَتَن عَ شَ كّوَلِيٍ شَ مَ، عَ تٌ عَ شَ دِ عِسِيَفَ قِ عَلَ مَ سّرّشّبَدٍ قَرِ؟ <verse eid="JAS 2:21"/><verse number="22" style="v" sid="JAS 2:22"/>عِ بَرَ عَ تٌ، دَنشَنِيَ نُ وَلِقٍ نّ عَ نُن عَ شَ كّوَلِ. كّوَلِ نَن دَنشَنِيَ رَكَمَلِمَ. <verse eid="JAS 2:22"/><verse number="23" style="v" sid="JAS 2:23"/>نَ كُي، عَ نَشَ رَبَ عَلْ عَ سّبّشِ كِتَابُي كُي كِ نَشّ، «عِبُرَهِمَ نَشَ لَ عَلَ رَ. عَلَتَلَ قَن نَشَ نَ قِندِ تِنشِنيِ رَ عَ بّ.» عِبُرَهِمَ شِلِ نَشَ قَلَ «عَلَ شَنُنتٍنيِ». <verse eid="JAS 2:23"/><verse number="24" style="v" sid="JAS 2:24"/>وٌ بَرَ عَ تٌ، عَدَ مَدِ شَ كّوَلِ قِندِ مَ تِنشِنيِ نَن نَ عَ بّ، عَ شَ دَنشَنِيَ فبَنسَن شَ مُ عَ رَ.<verse eid="JAS 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JAS 2:25"/>لَنفٌي فِنّ رَشَبِ قَن شَ كّوَلِ شَ مُ قِندِ تِنشِنيِ رَ عَ بّ، عَ تٌ شّيرَيٍ رَ سّنّ عَ شْنيِ، عَ كِرَ مَسٍن عٍ بّ عٍ عٍ فِمَ نَشَن نَ؟ <verse eid="JAS 2:25"/><verse number="26" style="v" sid="JAS 2:26"/>مِشِ نِي نَ سِفَ، عَ قَتٍ قَشَمَ نّ. نَ كُي، شَ كّوَلِ قَنيِ مُ نَ، دَنشَنِيَ قَن حْنمَ نّ.<verse eid="JAS 2:26"/></para>
  <chapter eid="JAS 2"/>
  <chapter number="3" style="c" sid="JAS 3"/>
  <para style="s">عَدَ مَ وْيّن كِ</para>
  <para style="s">نُن شَشِلِمَيَ نَشَن كٍلِمَ كٌورٍ مَ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 3:1"/>ﭑ نفَشَكٍرٍنيِيٍ، عَ مُ لَنمَ مِشِ وُيَشِ شَ قِندِ كَرَ مْشْ رَ وٌ يَ مَ، بَرِ مَ كَرَ مْشْيٍ قَمَ مَكِيتِدٍ نّ عَ شْرْشْي رَ دَنفِ مِشِ فبّتّيٍ رَ. <verse eid="JAS 3:1"/><verse number="2" style="v" sid="JAS 3:2"/>وٌن بِرِن تَنتَنمَ قٍ وُيَشِ مَ. شَ مِشِ ندٍ مُ تَنتَنمَ عَ شَ وْيّنيِ كُي، عَ مُ تَنتَنمَ دّدّ. نَ كَنيِ نْمَ عَ يّتّ بِرِن سُشُدٍ تِنشِنيِ كُي. <verse eid="JAS 3:2"/><verse number="3" style="v" sid="JAS 3:3"/>مِشِ نَ وَ سٌي شَ عَ وَشْنقٍ رَبَ، عَ كَرَقٌي نَن نَسٌمَ عَ دّ عِ. نَ نَن نْمَ عَ قَتٍ بِرِن نَحّرٍدٍ. <verse eid="JAS 3:3"/><verse number="4" style="v" sid="JAS 3:4"/>كُنكُي قَن نَ نَ كِ نّ. هَلِ كُنكُي بٍلٍبٍلٍ، قٌيٍ شُنفبٍ نَشَن تُتُنمَ، مِشِ عَ رَحّرّ مَ قٍيَ شُرُدِ نَن نَ، عَ عَ رَفِ عَ نَ وَ سِفَقٍ دّننَشّ. <verse eid="JAS 3:4"/><verse number="5" style="v" sid="JAS 3:5"/>نّنيِ قَن شُرُن، كْنْ عَ قٍ عِفبٌمَ.</para>
  <para style="p" vid="JAS 3:5">وٌ عَ مَتٌ، تّ دٌندٌرٌنتِ دِ نْمَ وٌندِ بٍلٍبٍلٍ فَندٍ. <verse eid="JAS 3:5"/><verse number="6" style="v" sid="JAS 3:6"/>تّ نَن نَ نّنيِ قَن نَ، نَشَن قِندِشِ دُنِحَ قٍ كٌبِ رَ. قَتٍ بِرِن نْشْمَ قٍ حَاشِ رَ عَ شَ وَلِ سَابُي نَن نَ. مِشِ نّنيِ نْمَ تّ سٌدٍ عَ شَ دُنِحّءِفِرِ بِرِن نَ، بَرِ مَ تّ نَن نَ نّنيِ رَ، تّ نَشَن كٍلِمَ يَهَننَمَ. <verse eid="JAS 3:6"/><verse number="7" style="v" sid="JAS 3:7"/>عَدَ مَدِ نْمَ دَالِسٍ مْولِ بِرِن شُرُدٍ. سُبٍ شَاحّيٍ، شْنِيٍ، بُبُسٍيٍ، نُن بَا مَ يّشّيٍ، عَدَ مَدِ بَرَ عٍ بِرِن شُرُ، <verse eid="JAS 3:7"/><verse number="8" style="v" sid="JAS 3:8"/>كْنْ مِشِ يٌ مُ نْمَ عَدَ مَدِ نّنيِ شُرُدٍ. شْنّ نَ عَ رَ نَشَن مَ لِنتَنيِ مُ دَنمَ، نَشَن شَ كَسَرّ مُ حْنمَ. <verse eid="JAS 3:8"/><verse number="9" style="v" sid="JAS 3:9"/>وٌن وٌن بَبَ، وٌن مَرِفِ، بَتُمَ نّنيِ كٍرٍنيِ نَشَن نَ، وٌن مَن عَدَ مَدِ دَنكَمَ عَ تَن نَن نَ، عَلَ نَشَن دَاشِ عَ يّتّ مِسَالِ رَ. <verse eid="JAS 3:9"/><verse number="10" style="v" sid="JAS 3:10"/>ﭑ نفَشَكٍرٍنيِيٍ، دُبّ نُن دَنكّ مِنِقٍ دّ كٍرٍن نَ، عَ مُ قَن. <verse eid="JAS 3:10"/><verse number="11" style="v" sid="JAS 3:11"/>يٍ شْنّ نُن يٍ بّشِ نْمَ مِنِدٍ دُلٌنيِ كٍرٍن نَ؟ <verse eid="JAS 3:11"/><verse number="12" style="v" sid="JAS 3:12"/>ﭑ نفَشَكٍرٍنيِيٍ، شْرّ بِلِ نْمَ تُفِ بٌفِ رَ مِنِدٍ؟ مَنفٌي بِلِ نْمَ شْرّ بٌفِ رَ مِنِدٍ؟ قْشّ يٍ مِنِمَ دُلٌنيِ نَشَن نَ، يٍ بّشِ مُ مِنِمَ مّننِ رَ.<verse eid="JAS 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 3:13"/>ندٍ قِندِشِ قَهَامُلَ نُن شَشِلِمَ رَ وٌ يَ مَ؟ عَ شَ نَ مَسٍن عَ حّرّ كِ قَنيِ نُن عَ شَ كّوَلِيٍ رَ، عَ نَشٍيٍ رَبَمَ بْحّ بّشِ كُي، نَشَن قَتَنشِ قَهَامُي رَ. <verse eid="JAS 3:13"/><verse number="14" style="v" sid="JAS 3:14"/>شَ تْونّ حَاشِ نُن مِلّ نَ وٌ بْحّ كُي، وٌ نَشَ وٌ يّتّ عِفبٌ نَ قٍيٍ كُي، وٌ نَشَ نْندِ مَسَرَ وُلٍ رَ. <verse eid="JAS 3:14"/><verse number="15" style="v" sid="JAS 3:15"/>نَ شَشِلِ مْولِ مُ كٍلِشِ كٌورٍ شّ. عَ كٍلِشِ دُنِحَ نّ، عَلَ كٌلٌنتَرٍيَ، نُن عِبُلِسَ مَ. <verse eid="JAS 3:15"/><verse number="16" style="v" sid="JAS 3:16"/>تْونّ نُن مِلّ نَ دّننَشّ، يَ عِسٌي نُن قٍ كٌبِ مْولِ بِرِن تٌمَ نَ نّ. <verse eid="JAS 3:16"/><verse number="17" style="v" sid="JAS 3:17"/>كْنْ قَهَامُي نَشَن كٍلِشِ كٌورٍ مَ، عَ سّنِيّن، عَ مِشِ بْحّ سَمَ، عَ دِحّمَ، عَ كِنِكِنِمَ، عَ كّوَلِ قَنيِ رَ مِنِمَ، عَ مُ مِشِ رَقِسَمَ عَ بٌورٍ بّ، عَ مُ قِلَنكَقُيحَ رَبَمَ. <verse eid="JAS 3:17"/><verse number="18" style="v" sid="JAS 3:18"/>مَالٍ بٌفِ مِنِمَ عَ فَرَنسَنمَ بّ كِ نَشّ، تِنشِنيِ قَن مِنِمَ مِشِ بّ نَ كِ نّ نَشَن بِرَ مَ لَنيِ نُن بْحّسَ قْشْ رَ.<verse eid="JAS 3:18"/></para>
  <chapter eid="JAS 3"/>
  <chapter number="4" style="c" sid="JAS 4"/>
  <para style="s">وَشْنقٍ نُن يّتّ عِفبٌحَ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 4:1"/>وٌ سْنشْمَ، وٌ فٍرٍ مَ. نَ رَكٍلِمَ مُن مَ؟ عَ مُ كٍلِمَ وٌ وَشْنقٍ كٌبِيٍ شَ مَ نَشٍيٍ عٍ بٌورٍ فٍرٍ مَ وٌ بْحّ كُي؟ <verse eid="JAS 4:1"/><verse number="2" style="v" sid="JAS 4:2"/>وٌ وَ مَ سٍ ندٍ شْن، كْنْ وٌ مُ عَ سْتْمَ. وٌ قَشّ تِمَ، وٌ مِلَ وٌ بٌورٍ شَ سٍ مَ، كْنْ وٌ مُ نْمَ وٌ وَشْنقٍ سْتْدٍ. وٌ سْنشْمَ، وٌ فٍرٍ مَ، كْنْ نَ بِرِن، وٌ مُ سٍسٍ سْتْمَ بَرِ مَ وٌ مُ عَلَ مَشَندِ مَ. <verse eid="JAS 4:2"/><verse number="3" style="v" sid="JAS 4:3"/>وٌ نَ عَلَ مَشَندِ قَن، وٌ مَن مُ سٍسٍ سْتْمَ، بَرِ مَ وٌ شَ مَشَندِ مُ قَن. وٌ مَشَندِ تِمَ عَلَكٌ وٌ نَ نَشَن يٌ سْتْ وٌ شَ عَ رَوَلِ وٌ وَشْنقٍ كٌبِيٍ كُي. <verse eid="JAS 4:3"/><verse number="4" style="v" sid="JAS 4:4"/>وٌ تَن دَنشَنِيَتَرٍيٍ، وٌ مُ عَ كٌلٌن نَشَن دُنِحَ مَشَنُمَ نَ بَرَ عَلَ قِندِ عَ يَشُي رَ؟ دُنِحَ شَنُنتٍنيِ قِندِشِ مِشِ نَن نَ نَشَن عَلَ شْنشِ. <verse eid="JAS 4:4"/><verse number="5" style="v" sid="JAS 4:5"/>وٌ مُ عَلَ شَ كِتَابُي شَ مَسٍنيِ كٌلٌن؟ عَلَ وَ مَ نّ وٌن شَشِلِ، عَ بَرَ نَشَن قِ وٌن مَ، عَ شَ بِرَ عَ تَن كٍرٍن نَن قْشْ رَ. <verse eid="JAS 4:5"/><verse number="6" style="v" sid="JAS 4:6"/>كْنْ نَ بِرِن كُي، عَلَ شَ هِننّ فبٌ دَنفِ قٍ بِرِن نَ. كِتَابُي عَ مَسٍنمَ،</para>
  <para style="q" vid="JAS 4:6">«عَلَ مُ تِنمَ يّتّ عِفبٌي رَ،</para>
  <para style="q" vid="JAS 4:6">كْنْ عَ هِننّمَ يّتّ مَفٌرٍ رَ.»<verse eid="JAS 4:6"/></para>
  <para style="m">
    <verse number="7" style="v" sid="JAS 4:7"/>نَ كُي، وٌ شَ وٌ يّتّ مَفٌرٌ عَلَ بّ. وٌ تٌندِ عِبُلِسَ بّ، عَ قَن عَ فِمَ نّ وٌ يَ رَ. <verse eid="JAS 4:7"/><verse number="8" style="v" sid="JAS 4:8"/>وٌ وٌ مَسٌ عَلَ رَ، عَ قَن عَ مَسٌمَ نّ وٌ رَ. يُنُبِتْييٍ، وٌ وٌ يّتّ رَ سّنِيّن. قِلَنكَقُييٍ، وٌ وٌ بْحّ رَقِيشّ. <verse eid="JAS 4:8"/><verse number="9" style="v" sid="JAS 4:9"/>وٌ وَ، وٌ سُننُن، وٌ نِمِسَ. وٌ شَ يٍلٍ شَ قِندِ وٌ بّ وَ رَ، وٌ شَ سّيوّ شَ قِندِ سُننُنيِ رَ. <verse eid="JAS 4:9"/><verse number="10" style="v" sid="JAS 4:10"/>وٌ وٌ مَفٌرٌ مَرِفِ بّ، عَ قَن وٌ شَ قٍ عِتٍمَ نّ.<verse eid="JAS 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JAS 4:11"/>ﭑ نفَشَكٍرٍنيِيٍ، وٌ نَشَ قٍ كٌبِ قَلَ وٌ بٌرٍ شَ قٍ رَ. مِشِ نَشَن قٍ كٌبِ قَلَمَ عَ نفَشَكٍرٍنيِ شَ قٍ رَ، عَ عَ يّتّ رَقِسَ عَ بّ، نَ كَنيِ بَرَ عَلَ شَ سّرِيّ مَتَندِ. عَ عَ يّتّ رَقِسَشِ عَلَ شَ سّرِيّ نَن بّ نَ كِ. شَ عِ بَرَ نَ رَبَ، عِ مُ نَ عَلَ شَ سّرِيّ رَبَتُقٍ شّ، عِ نَ عَ مَتَندِقٍ نّ. <verse eid="JAS 4:11"/><verse number="12" style="v" sid="JAS 4:12"/>سّرِيّسَ كٍرٍن ثٍتِ نَ عَ رَ، كِيتِسَ قَن كٍرٍن ثٍتِ نَ عَ رَ. عَ تَن نَن نْمَ مِشِ رَكِسِدٍ، عَ تَن نَن نْمَ مِشِ رَلْيدٍ. كْنْ عِ تَن، ندٍ نَ عِ رَ، عِ تٌ عِ يّتّ قِندِشِ عِ بٌورٍ مَكِيتِمَ رَ؟<verse eid="JAS 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 4:13"/>وٌ وٌ تُلِ مَتِ، وٌ تَن نَشٍيٍ عَ قَلَمَ، «تٌ، شَ نَ مُ تِنَ، مُشُ سِفَمَ نّ تَا ندٍ، مُشُ حّ كٍرٍن تِ نَ يُلّيَ رَبَ كُي، مُشُ فٍينِ سْتْ.» <verse eid="JAS 4:13"/><verse number="14" style="v" sid="JAS 4:14"/>وٌ نَ قٍ مْولِ قَلَمَ كْنْ وٌ حَن مُ عَ كٌلٌن نَشَن قَمَ رَبَدٍ تِنَ. وٌ شَ دُنِحّءِفِرِ قِندِشِ مُنسٍ رَ؟ وٌ لُشِ نّ عَلْ وُيّنفَ نَشَن تٌمَ دٌندٌرٌنتِ، عَ قَ لْي. <verse eid="JAS 4:14"/><verse number="15" style="v" sid="JAS 4:15"/>عَ لَنمَ نّ وٌ شَ يِ نَن قَلَ، «شَ عَلَ تِن، مُشُ تِنَ تٌمَ نّ، مُشُ يِ نُن يِ رَبَ.» <verse eid="JAS 4:15"/><verse number="16" style="v" sid="JAS 4:16"/>كْنْ يّتّ عِفبٌي نَن نَ وٌ رَ. نَ مُ قَن. <verse eid="JAS 4:16"/><verse number="17" style="v" sid="JAS 4:17"/>نَ كُي، شَ مِشِ قٍ قَنيِ كٌلٌن عَ لَنمَ عَ شَ نَشَن نَبَ كْنْ عَ مُ عَ رَبَمَ، نَ بَرَ قِندِ نَ كَنيِ بّ يُنُبِ رَ.<verse eid="JAS 4:17"/></para>
  <chapter eid="JAS 4"/>
  <chapter number="5" style="c" sid="JAS 5"/>
  <para style="s">بَننَيَ كٌبِ</para>
  <para style="s">تُننَبّشِيَ تْورّ كُي</para>
  <para style="s">عَلَ مَشَندِقٍ دَنشَنِيَ رَ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 5:1"/>يَكْسِ وٌ وٌ تُلِ مَتِ، وٌ تَن بَننَيٍ. وٌ شَ وٌ وَ شُي عِتٍ، بَرِ مَ فبَلٌي نَن قَقٍ وٌ مَ. <verse eid="JAS 5:1"/><verse number="2" style="v" sid="JAS 5:2"/>وٌ شَ بَننَيَ شُن بَرَ رَكَنَ، وٌ شَ دُفِيٍ بَرَ بْرْ. <verse eid="JAS 5:2"/><verse number="3" style="v" sid="JAS 5:3"/>وٌ شَ شّيمَ نُن فبٍتِ بَرَ شْرِشْرِ. نَ قِندِ مَ سٍيدٍ نَن نَ وٌ شِلِ مَ، عَ عَ نِيَ وٌ قَتٍ شَ فَن تّ رَ. وٌ بَرَ نَاقُلِ مَلَن يِ وَشَتِ، كْنْ وَشَتِ دْنشْي نَ عَ رَ. <verse eid="JAS 5:3"/><verse number="4" style="v" sid="JAS 5:4"/>وٌ وٌ تُلِ مَتِ، وٌ تَن نَشٍيٍ تٌندِشِ وٌ شَ شّ شَبَيٍ سَرٍ قِدٍ. وٌ شَ وَلِكّيٍ وَ شُي بَرَ عَلَ، دَالِ مَنفّ، تُلِ لِ. <verse eid="JAS 5:4"/><verse number="5" style="v" sid="JAS 5:5"/>وٌ شَ دُنِحّءِفِرِ كُي، وٌ مُ تْنيِ دْشْشِ وٌ وَشْنقٍ سٍسٍ مَ. وٌ وٌ يّتّ نَن تُن نَلُفَمَ. وٌ قَ لُشِ نّ عَلْ شُرُ سٍ تُرَشِ عَ كْن نَشَبَ لْشْي مَ. <verse eid="JAS 5:5"/><verse number="6" style="v" sid="JAS 5:6"/>وٌ بَرَ كِيتِ حَاشِ سَ تِنشِنتْييٍ مَ نَشٍيٍ مُ نُ تِشِ وٌ كَنكٍ، وٌ عٍ قَشَ.<verse eid="JAS 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 5:7"/>نَ كُي، ﭑ نفَشَكٍرٍنيِيٍ، وٌ شَ دِحّ هَن مَرِفِ قَ لْشْي. وٌ شَ عَ رَبَ عَلْ شّسَ عَ رَبَمَ كِ نَشّ. عَ دِحّ هَن تُنّبِرّ، نَشَن عَ نِيَمَ سَنسِ شَ مْ، عَ بٌفِ. <verse eid="JAS 5:7"/><verse number="8" style="v" sid="JAS 5:8"/>وٌ قَن شَ دِحّ. وٌ شَ لِمَنِيَ، بَرِ مَ مَرِفِ قَ لْشْي بَرَ مَكْرّ. <verse eid="JAS 5:8"/><verse number="9" style="v" sid="JAS 5:9"/>ﭑ نفَشَكٍرٍنيِيٍ، وٌ نَشَ قٍ كٌبِ قَلَ وٌ بٌرٍ شَ قٍ رَ، شَ نَ مُ عَ رَ كِيتِ نَ سَ، عَ مُ قَنمَ وٌ بّ. عَ فبٍ مُ لُشِ كِيتِسَ شَ قَ. <verse eid="JAS 5:9"/><verse number="10" style="v" sid="JAS 5:10"/>ﭑ نفَشَكٍرٍنيِيٍ، وٌ شَ لُ عَلْ نَمِحْنمّ نَشٍيٍ كَوَندِ تِ مَرِفِ شِلِ رَ، عٍ عٍ تُننَبّشِ تْورّ كُي. <verse eid="JAS 5:10"/><verse number="11" style="v" sid="JAS 5:11"/>وٌن عَ كٌلٌن بَرَكّ نَ مِشِ بّ نَشَن عَ تُننَبّشِمَ تْورّ كُي. وٌ بَرَ عَ مّ عَيُبَ عَ تُننَبّشِ كِ نَشّ. وٌ مَن بَرَ عَ تٌ مَرِفِ نَشَن نَبَشِ عَ بّ عَ شَ تْورّ دَنفِ شَنبِ. مَرِفِ شَ شَنُنتٍيَ نُن عَ شَ كِنِكِنِ فبٌ.<verse eid="JAS 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 5:12"/>ﭑ نفَشَكٍرٍنيِيٍ، نَشَن دَنفِ قٍ بِرِن نَ، وٌ نَشَ وٌ كَلِ كٌورٍ رَ، وٌ نَشَ وٌ كَلِ بْشِ رَ، وٌ نَشَ وٌ كَلِ سٍسٍ رَ. وٌ نَ «عِيٌ» قَلَ، عَ شَ قِندِ نْندِ رَ. وٌ نَ «عَدٍ» قَلَ، عَ شَ قِندِ نْندِ رَ. شَ نَ مُ عَ رَ كِيتِ نَ سَ، عَ مُ قَنمَ وٌ بّ.<verse eid="JAS 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 5:13"/>مِشِ نَ وٌ يَ مَ نَشَن تْورْشِ؟ عَ كَنيِ شَ عَلَ مَشَندِ. مِشِ نَ وٌ يَ مَ نَشَن حّلّشِنشِ؟ عَ كَنيِ شَ عَلَ تَنتُ بّيتِ رَ. <verse eid="JAS 5:13"/><verse number="14" style="v" sid="JAS 5:14"/>مِشِ نَ وٌ يَ مَ نَشَن قُرَشِ؟ عَ كَنيِ شَ دَنشَنِيَتْي حَمَ كُنتِفِيٍ شِلِ، عٍ شَ عَلَ مَشَندِ عَ بّ، عٍ شَ تُرٍ ندٍ مَسٌ عَ مَ مَرِفِ شِلِ رَ. <verse eid="JAS 5:14"/><verse number="15" style="v" sid="JAS 5:15"/>عَلَ مَشَندِ نَشَن قَتَنشِ دَنشَنِيَ رَ، عَ قُرٍ مَ رَيَلَنمَ نّ. مَرِفِ قُرٍ مَ رَكٍلِمَ نّ. شَ عَ بَرَ يُنُبِ رَبَ، مَرِفِ عَ شَقَرِ مَ نّ. <verse eid="JAS 5:15"/><verse number="16" style="v" sid="JAS 5:16"/>نَ كُي، وٌ شَ وٌ شَ يُنُبِيٍ قَلَ وٌ بٌرٍ بّ، وٌ شَ عَلَ مَشَندِ وٌ بٌرٍ بّ، عَلَكٌ وٌ شَ يَلَن. تِنشِنتْي عَلَ مَشَندِ نَشَن تِمَ، نَ عَلَ مَشَندِ شَ وَلِ سّنبّ فبٌ. <verse eid="JAS 5:16"/><verse number="17" style="v" sid="JAS 5:17"/>عٍلِيَ نُ قِندِشِ عَدَ مَدِ نَن نَ عَلْ وٌن تَن. عَ تٌ عَلَ مَشَندِ عَ بْحّ بِرِن نَ عَلَكٌ تُنّ نَشَ قَ، عَلَ نَشَ عَ شَ دُبّ سُشُ. تُنّ مُ قَ بْشِ حّ سَشَن كِكٍ سٍننِ. <verse eid="JAS 5:17"/><verse number="18" style="v" sid="JAS 5:18"/>نَ دَنفِ شَنبِ، عٍلِيَ مَن نَشَ عَلَ مَشَندِ تُنّ مَن شَ قَ. كٌورٍ نَشَ تُنّ بّحِن، بْشِ سَنسِيٍ نَشَ بٌفِيٍ رَ مِنِ.<verse eid="JAS 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 5:19"/>ﭑ نفَشَكٍرٍنيِيٍ، شَ مِشِ ندٍ وٌ يَ مَ عَ بَرَ نْندِ كِرَ بّحِن، كْنْ مِشِ فبّتّ قَ عَ تِ كِرَ قَنيِ شْن مَ، <verse eid="JAS 5:19"/><verse number="20" style="v" sid="JAS 5:20"/>وٌ شَ عَ كٌلٌن، مِشِ نَشَن يُنُبِتْي بَمَ عَ شَ يُنُبِ قٍ مَ، عَ بَرَ عَ نِيَ يُنُبِتْي شَ كِسِ، عَ شَ يُنُبِ بِرِن بَرَ شَقَرِ.<verse eid="JAS 5:20"/></para>
  <chapter eid="JAS 5"/>
</usx>
