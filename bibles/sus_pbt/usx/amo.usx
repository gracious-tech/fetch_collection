<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="AMO" style="id"/>
  <para style="h">عَننَبِ عَمٌسِ</para>
  <para style="toc1">عَلَ شَ مَسٍنيِ عَننَبِ عَمٌسِ بّ</para>
  <para style="toc2">عَننَبِ عَمٌسِ</para>
  <para style="toc3">عَمٌ</para>
  <para style="mt">عَلَ شَ مَسٍنيِ عَننَبِ عَمٌسِ بّ</para>
  <para style="imt">مَسٍنيِ ندٍ يِ كِتَابُي شَ قٍ رَ</para>
  <para style="ip">عَننَبِ عَمٌسِ نَمِحْنمّ نَن نُ عَ رَ نَشَن كَوَندِ تِ يُدَيَ مَنفّ يُسِيَ شَ وَشَتِ. نَ تّمُي عِسِرَيِلَ بْشِ، عَلَ نَشَن قِشِ عَ شَ حَمَ مَ كَبِ عَننَبِ مُنسَ شَ تّمُي، عَ نُ بَرَ تَشُن دْشْ قِرِن. عَ يِرٍقَنيِ سّيتِ شِلِ يُدَيَ، عَ كْولَ سّيتِ شِلِ عِسِرَيِلَ. مَنفّ يٍرٌبٌوَ مِ نُ نَ عِسِرَيِلَ بْشِ مَ. عَ مُ تِن بِرَدٍ عَلَ شَ سّرِيّ قْشْ رَ، عَ شَ حَمَ قَن مُ لُ كِرَ قَنيِ شْن مَ.</para>
  <para style="ip">عَننَبِ عَمٌسِ نَشَ كَوَندِ تِ عِسِرَيِلَكَيٍ بّ، عَلَكٌ عٍ شَ فبِلٍن عٍ شَ يُنُبِيٍ قْشْ رَ. عَ نَشَ تْنيِ دْشْ كُيٍيٍ بَتُقٍ رَ. عٍ مُ عَلَتَلَ بَتُقٍ رَبّحِن، كْنْ عٍ نُ بَرَ كُيٍ بَتُي قَن سَ نَ قَرِ. نَ نَن عَ رَ عَلَ نَشَ عَ مَسٍن عٍ بّ عَننَبِ عَمٌسِ سَابُي رَ، عَ عٍ شَ سَلِ بِرِن بَرَ قِندِ سَلِ قُقَقُ رَ. عَلَ مُ وَ مَ عَ قِرِن ندٍ شْن مَ.</para>
  <para style="ip">نَ وَشَتِ عِسِرَيِلَكَ وُيَشِيٍ نُ بَرَ نَاقُلِ فبٍفبٍ سْتْ. عٍ نَشَ عَ مَحْشُن عَ نَ بِرِن قِندِشِ عَلَ شَ بَرَكّ نَن نَ عٍ تَن مَبِرِ. عَننَبِ عَمٌسِ نَشَ عَ مَسٍن عٍ بّ عَ نَ نَاقُلِ مُ نُ كٍلِشِ عَلَ شَ مَ، عَ كٍلِشِ عٍ شَ قٍ كٌبِيٍ نَن مَ عٍ نَشٍيٍ رَبَشِ سٍتَرٍيٍ رَ.</para>
  <para style="ip">عَننَبِ عَمٌسِ تٌ فّ عٍ كَلَمُدٍ نَ قٍ مَ، عَ نَشَ عَ قَلَ عٍ بّ عَ عَلَتَلَ قَمَ نّ عٍ حَشَنكَتَدٍ عَ حَاشِ رَ عٍ شَ يُنُبِيٍ شَ قٍ رَ. عِسِرَيِلَكَيٍ نُ عَ مَحْشُنشِ نّ عَ قٍ شْرْشْي يٌ مُ نْمَ عٍ لِدٍ، كْنْ عَمٌسِ نَشَ عٍ مَيَندِ عٍ شَ فبِلٍن عَلَ شَ سّرِيّ مَ، شَ نَ مُ عَ رَ عٍ بِرِن قَمَ نّ هَلَكِدٍ.</para>
  <para style="ip">عَلَتَلَ نَشَ عِسِرَيِلَكَيٍ حَشَنكَتَ عَلْ عَننَبِ عَمٌسِ عَ قَلَ عٍ بّ كِ نَشّ. عٍ يَشُييٍ نَشَ عٍ فٍرٍ عَ حَاشِ رَ. عِسِرَيِلَكَ نَشٍيٍ مُ قَشَ سَنتِدّفّمَ رَ، عٍ نَشَ لُ كٌنيِيَ كُي حَمَنّ مَ. عَلَتَلَ شَ مَسٍنيِ بِرِن نَشَ كَمَلِ.</para>
  <para style="ip">يِ كِتَابُي شَ مَسٍنيِ تِدٍ فبٌ تٌ مِشِيٍ بّ. عَ لَنمَ وٌن شَ وٌن تُلِ مَتِ يِ كَوَندِ رَ عَلَكٌ وٌن شَ دَنشَنِيَ عَلَ مَ عَلْ عَ وَ مَ عَ شْن مَ كِ نَشّ. شَ نَ مُ عَ رَ وٌن قَن قَمَ نّ حَشَنكَتّ سْتْدٍ عَلْ عِسِرَيِلَكَيٍ. عَلَ شَ وٌن نَتَنفَ نَ مَ. عَمِنَ.</para>
  <para style="imte">عَلَ شَ مَسٍنيِ عَننَبِ عَمٌسِ بّ</para>
  <chapter number="1" style="c" sid="AMO 1"/>
  <para style="s">عَننَبِ عَمٌسِ شَ مَسٍنيِ</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 1:1"/>عَننَبِ عَمٌسِ، تٍكٌوَكَ شُرُ سٍ كَنيِ، نَشَ لَامَتُنيِ تٌ عِسِرَيِلَ شَ قٍ رَ يُدَيَ مَنفّ يُسِيَ نُن عِسِرَيِلَ مَنفّ يٍرٌبٌوَ مِ، يٌوَ سِ شَ دِ شَ وَشَتِ، حّ قِرِن بٍينُن بْشِ شَ سّرّن.</para>
  <para style="q" vid="AMO 1:1">عَننَبِ عَمٌسِ شَ مَسٍنيِ نَن يَ؛<verse eid="AMO 1:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="AMO 1:2"/>«عَلَتَلَ عَ شَاحّ شُي رَ مِنِمَ سِيٌنِ مَ عَلْ يّتّ،</para>
  <para style="q" vid="AMO 1:2">عَ عَ شُي عِتٍشِ رَ مِنِمَ كٍلِ دَرِ سَلَمُ.</para>
  <para style="q" vid="AMO 1:2">سّشّ مُ نَ قِيلِيٍ مَ شُرُ سٍيٍ نَشَن دٌنمَ،</para>
  <para style="q" vid="AMO 1:2">كَرٍ مٍلٍ فٍيَ قَن بَرَ شَرَ.»<verse eid="AMO 1:2"/></para>
  <para style="s">دَ مَسِ شَ يُنُبِ سَرٍ</para>
  <para style="q">
    <verse number="3" style="v" sid="AMO 1:3"/>عَلَتَلَ نَشَ عَ مَسٍن،</para>
  <para style="q" vid="AMO 1:3">«دَ مَسِ شَ يُنُبِ رَبَشِ سَشَنيِ،</para>
  <para style="q" vid="AMO 1:3">شَ نَ مُ عَ رَ نَانِ شَ قٍ رَ،</para>
  <para style="q" vid="AMO 1:3">ﭑ مُ فبِلٍنمَ ﭑ مَ نَتّ قْشْ رَ.</para>
  <para style="q" vid="AMO 1:3">عٍ بَرَ فَلَدِ كَنَ عَ حَاشِ رَ،</para>
  <para style="q" vid="AMO 1:3">عَلْ بْشِ بُشَمَ كِ نَشّ.<verse eid="AMO 1:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="AMO 1:4"/>ﭑ تّ دِنمَ شَسَيٍلِ شَ بَنشِ رَ نَ نَن مَ.</para>
  <para style="q" vid="AMO 1:4">نَ تّ نَن قَمَ بٍن هَدَدَ شَ يِرٍ مَكَنتَشِيٍ فَندٍ.<verse eid="AMO 1:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="AMO 1:5"/>ﭑ دَ مَسِ شَ نَادّ بَلَن سٍ فِرَ مَ نّ.</para>
  <para style="q" vid="AMO 1:5">ﭑ عَوٍنِكَيٍ هَلَكِمَ نّ فُلُنبَ كُي،</para>
  <para style="q" vid="AMO 1:5">عَ نُن مَنفّ نَشَن نَ بٍتِ عٍدٍن.</para>
  <para style="q" vid="AMO 1:5">سِرِيَ حَمَ شَنِنمَ نّ كِرِيَ كٌنيِيَ كُي.»</para>
  <para style="q" vid="AMO 1:5">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="AMO 1:5"/></para>
  <para style="s">فَسَ شَ يُنُبِ سَرٍ</para>
  <para style="q">
    <verse number="6" style="v" sid="AMO 1:6"/>عَلَتَلَ نَشَ عَ مَسٍن،</para>
  <para style="q" vid="AMO 1:6">«فَسَ شَ يُنُبِ رَبَشِ سَشَنيِ،</para>
  <para style="q" vid="AMO 1:6">شَ نَ مُ عَ رَ نَانِ شَ قٍ رَ،</para>
  <para style="q" vid="AMO 1:6">ﭑ مُ فبِلٍنمَ ﭑ مَ نَتّ قْشْ رَ.</para>
  <para style="q" vid="AMO 1:6">عٍ بَرَ تَا ندٍيٍ شَ حَمَ بِرِن شَنِن عٍدٌن كٌنيِيَ كُي.<verse eid="AMO 1:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="AMO 1:7"/>ﭑ تّ دِنمَ فَسَ تّتّ رَ نَ نَن مَ.</para>
  <para style="q" vid="AMO 1:7">نَ قَمَ نّ عَ يِرٍ مَكَنتَشِيٍ فَندٍ.<verse eid="AMO 1:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="AMO 1:8"/>ﭑ عَسِدٌدِكَيٍ هَلَكِمَ نّ،</para>
  <para style="q" vid="AMO 1:8">عَ نُن مَنفّ نَشَن نَ عَسِكَلْن.</para>
  <para style="q" vid="AMO 1:8">ﭑ عٍكِرٌن حَشَنكَتَمَ نّ،</para>
  <para style="q" vid="AMO 1:8">قِلِسِتَكَيٍ بِرِن قَشَمَ نّ.»</para>
  <para style="q" vid="AMO 1:8">مَرِفِ عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="AMO 1:8"/></para>
  <para style="s">تِرٍ شَ يُنُبِ سَرٍ</para>
  <para style="q">
    <verse number="9" style="v" sid="AMO 1:9"/>عَلَتَلَ نَشَ عَ مَسٍن،</para>
  <para style="q" vid="AMO 1:9">«تِرٍ شَ يُنُبِ رَبَشِ سَشَنيِ،</para>
  <para style="q" vid="AMO 1:9">شَ نَ مُ عَ رَ نَانِ شَ قٍ رَ،</para>
  <para style="q" vid="AMO 1:9">ﭑ مُ فبِلٍنمَ ﭑ مَ نَتّ قْشْ رَ.</para>
  <para style="q" vid="AMO 1:9">عٍ بَرَ تَا ندٍيٍ شَ حَمَ بِرِن شَنِن عٍدٌن كٌنيِيَ كُي،</para>
  <para style="q" vid="AMO 1:9">عٍ سَاتّ كَنَ عٍ نَشَن تٌنفٌ عٍ نُن عٍ نفَشَكٍرٍنيِ عِسِرَيِلَكَيٍ تَفِ.<verse eid="AMO 1:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="AMO 1:10"/>ﭑ تّ دِنمَ تِرٍ تّتّ رَ نَ نَن مَ.</para>
  <para style="q" vid="AMO 1:10">نَ تّ قَمَ نّ عَ يِرٍ مَكَنتَشِيٍ فَندٍ.»<verse eid="AMO 1:10"/></para>
  <para style="s">عٍدٌن شَ يُنُبِ سَرٍ</para>
  <para style="q">
    <verse number="11" style="v" sid="AMO 1:11"/>عَلَتَلَ نَشَ عَ مَسٍن،</para>
  <para style="q" vid="AMO 1:11">«عٍدٌن شَ يُنُبِ رَبَشِ سَشَنيِ،</para>
  <para style="q" vid="AMO 1:11">شَ نَ مُ عَ رَ نَانِ شَ قٍ رَ،</para>
  <para style="q" vid="AMO 1:11">ﭑ مُ فبِلٍنمَ ﭑ مَ نَتّ قْشْ رَ.</para>
  <para style="q" vid="AMO 1:11">عٍ بَرَ عٍ نفَشَكٍرٍنيِيٍ فٍرٍ سَنتِدّفّمَ رَ.</para>
  <para style="q" vid="AMO 1:11">عٍ مُ كِنِكِنِ عٍ مَ،</para>
  <para style="q" vid="AMO 1:11">عٍ شَ شْنّ شُن نَن تُن مَسَمَ.<verse eid="AMO 1:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="AMO 1:12"/>ﭑ تّ دِنمَ نّ تٍمَن نَ.</para>
  <para style="q" vid="AMO 1:12">نَ تّ نَن قَمَ بٌسَرَ يِرٍ مَكَنتَشِيٍ فَندٍ.»<verse eid="AMO 1:12"/></para>
  <para style="s">عَمٌنِ شَ يُنُبِ سَرٍ</para>
  <para style="q">
    <verse number="13" style="v" sid="AMO 1:13"/>عَلَتَلَ نَشَ عَ مَسٍن،</para>
  <para style="q" vid="AMO 1:13">«عَمٌنِكَيٍ شَ يُنُبِ رَبَشِ سَشَنيِ،</para>
  <para style="q" vid="AMO 1:13">شَ نَ مُ عَ رَ نَانِ شَ قٍ رَ،</para>
  <para style="q" vid="AMO 1:13">ﭑ مُ فبِلٍنمَ ﭑ مَ نَتّ قْشْ رَ.</para>
  <para style="q" vid="AMO 1:13">عٍ بَرَ فَلَدِ فِنّ قُرُشِيٍ قُرِيٍ رَبْو سَنتِدّفّمَ رَ،</para>
  <para style="q" vid="AMO 1:13">عَلَكٌ عٍ شَ بْشِ شُن شَ مَسَ.<verse eid="AMO 1:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="AMO 1:14"/>ﭑ تّ رَدّشّمَ رَابَ تّتّ رَ نَ نَن مَ.</para>
  <para style="q" vid="AMO 1:14">نَ تّ نَن قَمَ عَ يِرٍ مَكَنتَشِيٍ فَندٍ.<verse eid="AMO 1:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="AMO 1:15"/>عٍ شَ مَنفّ نُن عَ شَ كُنتِفِيٍ قَمَ نّ شَنِندٍ كٌنيِيَ كُي،</para>
  <para style="q" vid="AMO 1:15">فٍرٍ سْنشْي رَتٍ فٍرٍ سٌ لْشْي،</para>
  <para style="q" vid="AMO 1:15">تُرُننَادّ قٌيٍ مِنِ شُي لْشْي.»</para>
  <para style="q" vid="AMO 1:15">عَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="AMO 1:15"/></para>
  <chapter eid="AMO 1"/>
  <chapter number="2" style="c" sid="AMO 2"/>
  <para style="s">مٌوَبَ شَ يُنُبِ سَرٍ</para>
  <para style="q">
    <verse number="1" style="v" sid="AMO 2:1"/>عَلَتَلَ نَشَ عَ مَسٍن،</para>
  <para style="q" vid="AMO 2:1">«مٌوَبَ شَ يُنُبِ رَبَشِ سَشَنيِ،</para>
  <para style="q" vid="AMO 2:1">شَ نَ مُ عَ رَ نَانِ شَ قٍ رَ،</para>
  <para style="q" vid="AMO 2:1">ﭑ مُ فبِلٍنمَ ﭑ مَ نَتّ قْشْ رَ.</para>
  <para style="q" vid="AMO 2:1">عٍ بَرَ عٍدٌن مَنفّ شْرِيٍ فَن هَن عٍ بَرَ قِندِ شُبٍ رَ.<verse eid="AMO 2:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="AMO 2:2"/>ﭑ تّ دِنمَ مٌوَبَ رَ نَ نَن مَ.</para>
  <para style="q" vid="AMO 2:2">نَ تّ قَمَ نّ كٍرِيٌتِ يِرٍ مَكَنتَشِيٍ فَندٍ.</para>
  <para style="q" vid="AMO 2:2">مٌوَبَ شَ قٍ حْنمَ فٍرٍ سْنشْي نَن كُي،</para>
  <para style="q" vid="AMO 2:2">فٍرٍ قٍرِ قٍ شُي كُي.<verse eid="AMO 2:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="AMO 2:3"/>ﭑ عٍ شَ كِيتِسَ شُنفبٍ هَلَكِمَ نّ</para>
  <para style="q" vid="AMO 2:3">نُن عَ شَ كُنتِفِيٍ رَ.»</para>
  <para style="q" vid="AMO 2:3">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="AMO 2:3"/></para>
  <para style="s">يُدَيَ شَ يُنُبِ سَرٍ</para>
  <para style="q">
    <verse number="4" style="v" sid="AMO 2:4"/>عَلَتَلَ نَشَ عَ مَسٍن،</para>
  <para style="q" vid="AMO 2:4">«يُدَيَ شَ يُنُبِ رَبَشِ سَشَنيِ،</para>
  <para style="q" vid="AMO 2:4">شَ نَ مُ عَ رَ نَانِ شَ قٍ رَ،</para>
  <para style="q" vid="AMO 2:4">ﭑ مُ فبِلٍنمَ ﭑ مَ نَتّ قْشْ رَ.</para>
  <para style="q" vid="AMO 2:4">عٍ بَرَ ﭑ مَ سّرِيّ مَتَندِ،</para>
  <para style="q" vid="AMO 2:4">عٍ مُ ﭑ مَ يَامَرِيٍ سُشُ،</para>
  <para style="q" vid="AMO 2:4">بَرِ مَ عٍ بَرَ عٍ يّتّ رَلْي لَقٍ رَ عَلَ وُلٍ دَاشِيٍ رَ،</para>
  <para style="q" vid="AMO 2:4">عٍ بَبَيٍ لَ نَشٍيٍ رَ.<verse eid="AMO 2:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="AMO 2:5"/>ﭑ تّ دِنمَ يُدَيَ رَ نَ نَن مَ.</para>
  <para style="q" vid="AMO 2:5">نَ تّ نَن قَمَ دَرِ سَلَمُ يِرٍ مَكَنتَشِيٍ فَندٍ.»<verse eid="AMO 2:5"/></para>
  <para style="s">عِسِرَيِلَ شَ يُنُبِ سَرٍ</para>
  <para style="q">
    <verse number="6" style="v" sid="AMO 2:6"/>عَلَتَلَ نَشَ عَ مَسٍن،</para>
  <para style="q" vid="AMO 2:6">«عِسِرَيِلَ شَ يُنُبِ رَبَشِ سَشَنيِ،</para>
  <para style="q" vid="AMO 2:6">شَ نَ مُ عَ رَ نَانِ شَ قٍ رَ،</para>
  <para style="q" vid="AMO 2:6">ﭑ مُ فبِلٍنمَ ﭑ مَ نَتّ قْشْ رَ.</para>
  <para style="q" vid="AMO 2:6">عٍ تِنشِنتْي مَتِمَ كْبِرِ رَ،</para>
  <para style="q" vid="AMO 2:6">عٍ مِسِكِينّ مَتِمَ سَنكِرِ سَرٍ شَ قٍ رَ.<verse eid="AMO 2:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="AMO 2:7"/>عٍ تْورْ مِشِيٍ شَ قٍ مَيٌ،</para>
  <para style="q" vid="AMO 2:7">عٍ تٌندِ سٍتَرٍ شَ كِيتِ سَدٍ.</para>
  <para style="q" vid="AMO 2:7">بَبّ نُن عَ شَ دِ، فِنّدِ مّدِ كٍرٍن مَسَمَ.</para>
  <para style="q" vid="AMO 2:7">نَ كُي عٍ بَرَ ﭑ شِلِ سّنِيّنشِ رَ سْتْ.<verse eid="AMO 2:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="AMO 2:8"/>عٍ دُفِ عِتَلَمَ عٍ نَشَن نَسُشُشِ سّيكّ رَ،</para>
  <para style="q" vid="AMO 2:8">عٍ عٍ سَ نَ مَ سّرّشّبَدٍ قّ مَ.</para>
  <para style="q" vid="AMO 2:8">عٍ وّنِ سْتْمَ تِنشِنتَرٍيَ رَ،</para>
  <para style="q" vid="AMO 2:8">عٍ نَ مِن عٍ شَ عَلَيٍ شَ بَنشِيٍ كُي.»<verse eid="AMO 2:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="AMO 2:9"/>«عٍ نَ قِنسِرِوَلِيَ بِرِن نَبَمَ ﭑ يَ عِ،</para>
  <para style="q" vid="AMO 2:9">ﭑ تَن نَشَن عَمٌرِكَيٍ هَلَكِ عٍ بّ،</para>
  <para style="q" vid="AMO 2:9">عَمٌرِكَيٍ نَشٍيٍ شُنفبٌ عٍ سّنبّ فبٌ عَلْ كٌندٍ بِلِ.</para>
  <para style="q" vid="AMO 2:9">ﭑ نَشَ عَمٌرِكَيٍ قْشِ بِرِن بَ نَا،</para>
  <para style="q" vid="AMO 2:9">عَلَكٌ عٍ نَشَ نْ سّنبّ سْتْدٍ سْنْن.<verse eid="AMO 2:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="AMO 2:10"/>ﭑ مَن نَشَ وٌ رَ مِنِ مِسِرَ بْشِ رَ،</para>
  <para style="q" vid="AMO 2:10">ﭑ قَ وٌ رَحّرّ حّ تٌنفٌ نَانِ بُن مَ فبٍنفبٍرٍنيِ مَ،</para>
  <para style="q" vid="AMO 2:10">عَلَكٌ وٌ شَ عَمٌرِ بْشِ سْتْ.<verse eid="AMO 2:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="AMO 2:11"/>ﭑ نَشَ نَمِحْنمّيٍ رَكٍلِ وٌ يَ مَ،</para>
  <para style="q" vid="AMO 2:11">عَ نُن نَسَرِ سّفّتَلَيٍ نَشٍيٍ بَرَ قِ ﭑ مَ.</para>
  <para style="q" vid="AMO 2:11">عِسِرَيِلَكَيٍ، عَ مُ نَ نَ كِ شّ؟»</para>
  <para style="q" vid="AMO 2:11">عَلَتَلَ شَ وْيّنيِ نَن نَ كِ.<verse eid="AMO 2:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="AMO 2:12"/>«كْنْ وٌ تَن بَرَ بٍيرٍ سٌ نَسَرِ مِشِيٍ يِ رَ.</para>
  <para style="q" vid="AMO 2:12">وٌ بَرَ تْنيِ دْشْ نَمِحْنمّيٍ رَ</para>
  <para style="q" vid="AMO 2:12">عَ عٍ نَشَ عَلَ شَ مَسٍنيِ مَسٍن.»<verse eid="AMO 2:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="AMO 2:13"/>«ﭑ قَمَ وٌ بُتُشُندٍ نَ نَن مَ،</para>
  <para style="q" vid="AMO 2:13">عَلْ كٌتٍ بِنيٍ عَ مَشَنِن سٍ بُتُشُنمَ كِ نَشّ.<verse eid="AMO 2:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="AMO 2:14"/>مِشِ شُلُنشِ مُ نْمَ عَ فِدٍ.</para>
  <para style="q" vid="AMO 2:14">سّنبّمَ سّنبّ بَمَ نّ عَ يِ رَ.</para>
  <para style="q" vid="AMO 2:14">فٍرٍ سٌي قَشَمَ نّ فٍرٍ كُي.<verse eid="AMO 2:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="AMO 2:15"/>تَنبّ وٌلِ مُ تِمَ.</para>
  <para style="q" vid="AMO 2:15">نَشَن شُلُن عَ فِدٍ نَ سَنيِ مُ عَ بَمَ عٍ عِ.</para>
  <para style="q" vid="AMO 2:15">سٌي رَفِ مُ كِسِمَ.<verse eid="AMO 2:15"/></para>
  <para style="q">
    <verse number="16" style="v" sid="AMO 2:16"/>نَ لْشْي فٍرٍ سٌي سُو سَشِ عَ فِمَ عَ مَفٍلِ نَن نَ.»</para>
  <para style="q" vid="AMO 2:16">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="AMO 2:16"/></para>
  <chapter eid="AMO 2"/>
  <chapter number="3" style="c" sid="AMO 3"/>
  <para style="s">عَلَ نَشَن حَنِفٍشِ عِسِرَيِلَ بّ</para>
  <para style="q">
    <verse number="1" style="v" sid="AMO 3:1"/>وٌ وٌ تُلِ مَتِ يِ مَسٍنيِ رَ،</para>
  <para style="q" vid="AMO 3:1">عَلَتَلَ نَشَن مَسٍنمَ عِسِرَيِلَكَيٍ بّ،</para>
  <para style="q" vid="AMO 3:1">عَ شَبِلّ نَشَن نَمِنِ مِسِرَ بْشِ رَ.<verse eid="AMO 3:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="AMO 3:2"/>«ﭑ وٌ تَن نَن فبَنسَن سُفَندِ دُنِحَ شَبِلّيٍ بِرِن يَ مَ.</para>
  <para style="q" vid="AMO 3:2">نَ نَن عَ رَ، ﭑ عَ حَنِفٍشِ وٌ شَ حَشَنكَتّ سْتْ وٌ شَ يُنُبِيٍ شَ قٍ رَ.»<verse eid="AMO 3:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="AMO 3:3"/>مِشِ قِرِن نْمَ حّرّ رَلَندٍ</para>
  <para style="q" vid="AMO 3:3">شَ عٍ مُ لَنشِ نَ مَ؟<verse eid="AMO 3:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="AMO 3:4"/>يّتّ عَ شُي رَ مِنِمَ وُلَ عِ</para>
  <para style="q" vid="AMO 3:4">شَ عَ مُ سُبٍ ندٍ سْتْشِ؟<verse eid="AMO 3:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="AMO 3:5"/>شْنِ فٌرٌ مَ يّلّ كُي</para>
  <para style="q" vid="AMO 3:5">شَ دٌنسٍ مُ نَ يّلّ رَ؟</para>
  <para style="q" vid="AMO 3:5">فَنتَنيِ نْمَ قُلَدٍ</para>
  <para style="q" vid="AMO 3:5">شَ شْنِ مُ سُشُشِ عَ رَ؟<verse eid="AMO 3:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="AMO 3:6"/>قٍرِ قٍمَ تَا ندٍ كُي حَمَ كُي مُ عِقُ؟</para>
  <para style="q" vid="AMO 3:6">فبَلٌي تَا ندٍ لِمَ، شَ عَلَتَلَ شَ مُ عَ رَفِرِ؟<verse eid="AMO 3:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="AMO 3:7"/>مَرِفِ عَلَتَلَ مُ قٍقٍ رَبَمَ،</para>
  <para style="q" vid="AMO 3:7">عَ مُ عَ شَ فُندٌ مَسٍن عَ شَ كٌنيِ نَمِحْنمّيٍ بّ.<verse eid="AMO 3:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="AMO 3:8"/>يّتّ نَ عَ شُي رَ مِنِ، ندٍ مُ فَاشُمَ؟</para>
  <para style="q" vid="AMO 3:8">مَرِفِ عَلَتَلَ نَ وْيّن، ندٍ تٌندِ مَ نَ مَسٍندٍ؟<verse eid="AMO 3:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="AMO 3:9"/>وٌ شَ يِ قَلَ عَسِدٌدِ يِرٍ مَكَنتَشِيٍ كُي،</para>
  <para style="q" vid="AMO 3:9">وٌ مَن شَ يِ قَلَ مِسِرَ يِرٍ مَكَنتَشِيٍ كُي،</para>
  <para style="q" vid="AMO 3:9">«وٌ شَ وٌ مَلَن سَمَرِ فٍيَيٍ قَرِ،</para>
  <para style="q" vid="AMO 3:9">وٌ شَ عَ مَتٌ مّننِكَيٍ كْنتْقِلِشِ كِ نَشّ،</para>
  <para style="q" vid="AMO 3:9">عَ نُن عٍ عٍ بٌورٍ تْورْ مَ كِ نَشّ.»<verse eid="AMO 3:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="AMO 3:10"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="AMO 3:10">«عٍ مُ تِنشِنيِ يٌ كٌلٌن،</para>
  <para style="q" vid="AMO 3:10">عٍ شَ قٍ حَاشِ نُن مُحّ شُن نَن تُن مَسَقٍ.</para>
  <para style="q" vid="AMO 3:10">عٍ نَشَن سْتْمَ، عٍ نَ مَلَنمَ عٍ شَ يِرٍ مَكَنتَشِيٍ نَن كُي.»<verse eid="AMO 3:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="AMO 3:11"/>مَرِفِ عَلَتَلَ نَشَن مَسٍن، نَ نَن يِ كِ.</para>
  <para style="q" vid="AMO 3:11">«وٌ وٌ يَ رَبِ، وٌ يَشُي نَ قَقٍ وٌ شَ بْشِ كَنَدٍ.</para>
  <para style="q" vid="AMO 3:11">عٍ قَمَ نّ وٌ شُن نَكَنَدٍ،</para>
  <para style="q" vid="AMO 3:11">عٍ قَ وٌ شَ يِرٍ مَكَنتَشِيٍ كَنَ.»<verse eid="AMO 3:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="AMO 3:12"/>عَلَتَلَ نَشَ عَ مَسٍن،</para>
  <para style="q" vid="AMO 3:12">«يّتّ نَ يّشّي عِبْو،</para>
  <para style="q" vid="AMO 3:12">شُرُ سٍ دّ مَدٌنيِ نْمَ يّشّي سَنيِ قِرِن،</para>
  <para style="q" vid="AMO 3:12">شَ نَ مُ عَ رَ عَ تُلِ شُنتُنيِ رَكِسِدٍ يّتّ مَ.</para>
  <para style="q" vid="AMO 3:12">عِسِرَيِلَكَيٍ قَن كِسِمَ نَ كِ نّ.</para>
  <para style="q" vid="AMO 3:12">سَمَرِكَ نَشٍيٍ عٍ مَلَبُمَ سَدٍ مَ،</para>
  <para style="q" vid="AMO 3:12">نَشٍيٍ عٍ مَفٌرٌ مَ دَ مَسِ مَفٌرٌ سٍيٍ كُي،</para>
  <para style="q" vid="AMO 3:12">وٌ تَن مُ كِسِمَ.»<verse eid="AMO 3:12"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="13" style="v" sid="AMO 3:13"/>مَنفّ عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="AMO 3:13">«وٌ وٌ تُلِ مَتِ ﭑ نَ،</para>
  <para style="q" vid="AMO 3:13">وٌ نَ مَسٍن يَشُبَ بْنسْي بّ.<verse eid="AMO 3:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="AMO 3:14"/>ﭑ نَ عِسِرَيِلَ حَشَنكَتَ</para>
  <para style="q" vid="AMO 3:14">عَ شَ يُنُبِيٍ شَ قٍ رَ تّمُي نَشّ،</para>
  <para style="q" vid="AMO 3:14">ﭑ مَن عٍ حَشَنكَتَمَ نّ عٍ شَ سّرّشّبَدٍيٍ شَ قٍ رَ نَشٍيٍ نَ بٍتٍلِ.</para>
  <para style="q" vid="AMO 3:14">نَ سّرّشّبَدٍ سُشُسٍيٍ بِرَ مَ نّ بْشِ.<verse eid="AMO 3:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="AMO 3:15"/>ﭑ مَن عٍ شَ بَنشِ تٌقَنيِيٍ رَبِرَ مَ نّ،</para>
  <para style="q" vid="AMO 3:15">حّمّ نُن سٌفٌقُرٍ بَنشِ بِرِن،</para>
  <para style="q" vid="AMO 3:15">نَشٍيٍ رَتٌقَنشِ سِلِ حِنيِ رَ.</para>
  <para style="q" vid="AMO 3:15">ﭑ نَ بِرِن كَنَمَ نّ.»</para>
  <para style="q" vid="AMO 3:15">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="AMO 3:15"/></para>
  <chapter eid="AMO 3"/>
  <chapter number="4" style="c" sid="AMO 4"/>
  <para style="s">عَلَ نَشَن نَبَشِ عَلَكٌ عِسِرَيِلَ شَ فبِلٍن عَ مَ</para>
  <para style="q">
    <verse number="1" style="v" sid="AMO 4:1"/>وٌ وٌ تُلِ مَتِ يِ مَسٍنيِ رَ،</para>
  <para style="q" vid="AMO 4:1">وٌ تَن فِنّ نَشٍيٍ لُشِ عَلْ نِنفٍيٍ،</para>
  <para style="q" vid="AMO 4:1">نِنفٍ تٌقَنيِيٍ نَشٍيٍ نَ بَسَن بْشِ مَ.</para>
  <para style="q" vid="AMO 4:1">وٌ تَن نَشٍيٍ سَبَتِشِ سَمَرِ فٍيَ قَرِ،</para>
  <para style="q" vid="AMO 4:1">وٌ تَن نَشٍيٍ مِسِكِينّ تْورْ مَ،</para>
  <para style="q" vid="AMO 4:1">وٌ تَن نَشٍيٍ تِمَ سٍتَرٍيٍ قَرِ.</para>
  <para style="q" vid="AMO 4:1">وٌ نُ قَ عَ قَلَمَ وٌ شَ مْرِيٍ بّ،</para>
  <para style="q" vid="AMO 4:1">«وٌ قَ بٍيرٍ رَ، وٌن نَشَن مِنمَ.»<verse eid="AMO 4:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="AMO 4:2"/>مَرِفِ عَلَتَلَ بَرَ عَ كَلِ عَ شَ سّنِيّنيِ رَ،</para>
  <para style="q" vid="AMO 4:2">«كِيتِ لْشْي نَ قَقٍ.</para>
  <para style="q" vid="AMO 4:2">عٍ قَمَ نّ وٌ سُشُدٍ وُرٍ كْنكْرْنشِيٍ رَ،</para>
  <para style="q" vid="AMO 4:2">عٍ وٌ نُن وٌ شَ دِيٍ شَنِن.<verse eid="AMO 4:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="AMO 4:3"/>وٌ مِنِمَ نّ وٌ شَ تّتّ كَنَشِ كُي،</para>
  <para style="q" vid="AMO 4:3">كَنكَن تِشِ عَ بٌورٍ شَنبِ رَ.</para>
  <para style="q" vid="AMO 4:3">عٍ وٌ شَنِنمَ نّ يِرٍ مَكَنتَشِ.»</para>
  <para style="q" vid="AMO 4:3">عَلَتَلَ شَ وْيّنيِ نَن نَ كِ.<verse eid="AMO 4:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="AMO 4:4"/>«وٌ سِفَ بٍتٍلِ، عَلَكٌ وٌ شَ يُنُبِ رَبَ نَا.</para>
  <para style="q" vid="AMO 4:4">وٌ سِفَ فِلِفَلِ، عَلَكٌ وٌ مَن شَ يُنُبِ سْتْ.</para>
  <para style="q" vid="AMO 4:4">وٌ شَ سّرّشّ بَ فّيسّفّ بِرِن،</para>
  <para style="q" vid="AMO 4:4">وٌ مَن شَ قَرِلّ بَ حّ سَشَن يٌ حّ سَشَن.<verse eid="AMO 4:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="AMO 4:5"/>وٌ لّبِنِ تَامِ بَ تَنتُي سّرّشّ رَ.</para>
  <para style="q" vid="AMO 4:5">وٌ وٌ شَ حَنِفٍ سّرّشّ مَسٍن بِرِن بّ،</para>
  <para style="q" vid="AMO 4:5">بَرِ مَ نَ قٍ مْولِيٍ رَقَن وٌ مَ، وٌ تَن عِسِرَيِلَكَيٍ.»</para>
  <para style="q" vid="AMO 4:5">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="AMO 4:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="AMO 4:6"/>«ﭑ نُ بَرَ كَامّ رَ سٌ وٌ شَ تَايٍ كُي.</para>
  <para style="q" vid="AMO 4:6">تَامِ يٌ مُ لُ وٌ شْنيِ.</para>
  <para style="q" vid="AMO 4:6">كْنْ هَلِ ﭑ تٌ نَ بِرِن نَبَ، وٌ مُ تُوبِ ﭑ بّ.»</para>
  <para style="q" vid="AMO 4:6">عَلَتَلَ شَ وْيّنيِ نَن نَ كِ.<verse eid="AMO 4:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="AMO 4:7"/>«كِكٍ سَشَن تٌ نُ لُشِ شّ شَ شَبَ،</para>
  <para style="q" vid="AMO 4:7">ﭑ تٌندِ نّ تُنّ رَفٌرٌدٍ وٌ مَ.</para>
  <para style="q" vid="AMO 4:7">ﭑ بَرَ عَ نِيَ تَا ندٍيٍ شَ تُنّ سْتْ،</para>
  <para style="q" vid="AMO 4:7">تَا ندٍيٍ نَشَ عَ سْتْ.</para>
  <para style="q" vid="AMO 4:7">ﭑ بَرَ عَ رَفِرِ ندٍيٍ شَ تُنّ سْتْ،</para>
  <para style="q" vid="AMO 4:7">شّ ندٍيٍ نَشَ تُنّ سْتْ.<verse eid="AMO 4:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="AMO 4:8"/>مِشِيٍ بَرَ كٍلِ تَا ندٍيٍ،</para>
  <para style="q" vid="AMO 4:8">عٍ سِفَ يٍ قٍندٍ تَا فبّتّ كُي،</para>
  <para style="q" vid="AMO 4:8">كْنْ يٍ شْلِ مُ بَ عٍ مَ.</para>
  <para style="q" vid="AMO 4:8">هَلِ ﭑ تٌ نَ بِرِن نَبَ، وٌ مُ تُوبِ ﭑ بّ.»</para>
  <para style="q" vid="AMO 4:8">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="AMO 4:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="AMO 4:9"/>«ﭑ بَرَ قُرٍ رَفٌرٌ وٌ شَ سَنسِيٍ مَ،</para>
  <para style="q" vid="AMO 4:9">ﭑ بَرَ عٍ شَرَ قٌيٍ رَ.</para>
  <para style="q" vid="AMO 4:9">كَتٌييٍ بَرَ وٌ شَ لَاكْي كَنَ،</para>
  <para style="q" vid="AMO 4:9">عَ نُن وٌ شَ وّنِ سَنسِيٍ، وٌ شَ شْرّ سَنسِيٍ، نُن وٌ شَ عٌلِوِ سَنسِيٍ.</para>
  <para style="q" vid="AMO 4:9">هَلِ ﭑ تٌ نَ بِرِن نَبَ، وٌ مُ تُوبِ ﭑ بّ.»</para>
  <para style="q" vid="AMO 4:9">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="AMO 4:9"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="10" style="v" sid="AMO 4:10"/>«ﭑ بَرَ قُرٍ حَاشِيٍ رَفٌرٌ وٌ مَ،</para>
  <para style="q" vid="AMO 4:10">عَلْ ﭑ عَ رَبَشِ مِسِرَ بْشِ مَ كِ نَشّ.</para>
  <para style="q" vid="AMO 4:10">ﭑ بَرَ وٌ شَ سّفّتَلَيٍ قَشَ سَنتِدّفّمَ رَ،</para>
  <para style="q" vid="AMO 4:10">عٍ بْرْ شِرِ نَشَ تٍ وٌ رَ.</para>
  <para style="q" vid="AMO 4:10">وٌ يَشُييٍ بَرَ عٍ شَ سٌييٍ تٌنفٌ.</para>
  <para style="q" vid="AMO 4:10">هَلِ ﭑ تٌ نَ بِرِن نَبَ، وٌ مُ تُوبِ ﭑ بّ.»</para>
  <para style="q" vid="AMO 4:10">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="AMO 4:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="AMO 4:11"/>«ﭑ بَرَ وٌ حَشَنكَتَ،</para>
  <para style="q" vid="AMO 4:11">عَلْ ﭑ سٌدٌ مَ نُن فٌمٌرَ حَشَنكَتَشِ كِ نَشّ.</para>
  <para style="q" vid="AMO 4:11">وٌ لُشِ نّ عَلْ وُرِ نَشَن نَمِنِشِ تّ.</para>
  <para style="q" vid="AMO 4:11">هَلِ ﭑ تٌ نَ بِرِن نَبَ، وٌ مُ تُوبِ ﭑ بّ.»</para>
  <para style="q" vid="AMO 4:11">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="AMO 4:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="AMO 4:12"/>«ﭑ قَمَ عِ تَن عِسِرَيِلَ حَشَنكَتَدٍ نَ نَن مَ.</para>
  <para style="q" vid="AMO 4:12">ﭑ نَ يِ رَبَ عِ رَ، عِ قَمَ نّ عِ مَرِفِ عَلَ كٌلٌندٍ.»<verse eid="AMO 4:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="AMO 4:13"/>نَشَن فٍيَيٍ نُن قٌيٍ دَاشِ،</para>
  <para style="q" vid="AMO 4:13">نَشَن عَدَ مَ شَ مَحْشُنيِ بِرِن كٌلٌن،</para>
  <para style="q" vid="AMO 4:13">نَشَن سُبَشّ قِندِ مَ كْي رَ،</para>
  <para style="q" vid="AMO 4:13">نَشَن حّرّ مَ يِرٍ عِتٍشِ قَرِ،</para>
  <para style="q" vid="AMO 4:13">عَ شِلِ مَنفّ عَلَتَلَ.<verse eid="AMO 4:13"/></para>
  <chapter eid="AMO 4"/>
  <chapter number="5" style="c" sid="AMO 5"/>
  <para style="s">عَلَ وَ مَ نَشَن شْن</para>
  <para style="q">
    <verse number="1" style="v" sid="AMO 5:1"/>وٌ وٌ تُلِ مَتِ يِ مَسٍنيِ رَ.</para>
  <para style="q" vid="AMO 5:1">ﭑ بَرَ يِ بّيتِ بَ عِسِرَيِلَ بْنسْي حْن قٍ مَ.<verse eid="AMO 5:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="AMO 5:2"/>«عِسِرَيِلَ سّنِيّنتْي بَرَ قَشَ، عَ مُ كٍلِمَ سْنْن،</para>
  <para style="q" vid="AMO 5:2">عَ بَرَ بِرَ، مِشِ يٌ مُ عَ رَكٍلِمَ.»<verse eid="AMO 5:2"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="3" style="v" sid="AMO 5:3"/>مَرِفِ عَلَتَلَ نَشَ عَ مَسٍن،</para>
  <para style="q" vid="AMO 5:3">«عِسِرَيِلَ بْنسْي،</para>
  <para style="q" vid="AMO 5:3">تَا نَشَن شّمّ وُلُ كٍرٍن شّيمَ فٍرٍ سٌدٍ،</para>
  <para style="q" vid="AMO 5:3">عَ شّمّ كّمّ نَن فبَنسَن تٌمَ فبِلٍن نَ.</para>
  <para style="q" vid="AMO 5:3">تَا نَشَن شّمّ كّمّ شّيمَ فٍرٍ سٌدٍ،</para>
  <para style="q" vid="AMO 5:3">عَ شّمّ قُ نَن فبَنسَن تٌمَ فبِلٍن نَ.»<verse eid="AMO 5:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="AMO 5:4"/>عَلَتَلَ نَشَ عَ مَسٍن عِسِرَيِلَ بْنسْي بّ،</para>
  <para style="q" vid="AMO 5:4">«وٌ قَ ﭑ قٍن عَلَكٌ وٌ شَ كِسِ.<verse eid="AMO 5:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="AMO 5:5"/>وٌ نَشَ ﭑ قٍن بٍتٍلِ،</para>
  <para style="q" vid="AMO 5:5">وٌ نَشَ سِفَ فِلِفَلِ،</para>
  <para style="q" vid="AMO 5:5">شَ نَ مُ عَ رَ بٍرِ سٍيبَ،</para>
  <para style="q" vid="AMO 5:5">بَرِ مَ فِلِفَلِكَ بِرِن سِفَمَ نّ كٌنيِيَ كُي،</para>
  <para style="q" vid="AMO 5:5">بٍتٍلِ قَن هَلَكِمَ نّ.»<verse eid="AMO 5:5"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="6" style="v" sid="AMO 5:6"/>وٌ عَلَتَلَ قٍن عَلَكٌ وٌ شَ كِسِ.</para>
  <para style="q" vid="AMO 5:6">شَ نَ مُ عَ رَ، يُسُقُ بْنسْي،</para>
  <para style="q" vid="AMO 5:6">عَلَتَلَ وٌ سْنتْمَ نّ تّ رَ.</para>
  <para style="q" vid="AMO 5:6">بٍتٍلِكَ يٌ مُ نَ نَشَن نَ تّ رَشُبٍنمَ.<verse eid="AMO 5:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="AMO 5:7"/>وٌ تَن بَرَ تِنشِنيِ مَقِندِ ﭑ نَشْنقٍ رَ،</para>
  <para style="q" vid="AMO 5:7">وٌ بَرَ يٌ سّرِيّ مَ.<verse eid="AMO 5:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="AMO 5:8"/>عَلَتَلَ نَن تُنبُييٍ سَ كٌورٍ مَ،</para>
  <para style="q" vid="AMO 5:8">عَ دِ مِ عِيَلَن سُبَشّ مَ،</para>
  <para style="q" vid="AMO 5:8">عَ سٌفٍ رَدُلَ، كْي شَ سٌ،</para>
  <para style="q" vid="AMO 5:8">عَ يٍ تٌنفٌ بَا مَ،</para>
  <para style="q" vid="AMO 5:8">عَ نَ قِندِ تُنّ رَ، عَ فٌرٌ بْشِ مَ.</para>
  <para style="q" vid="AMO 5:8">نَشَن نَ بِرِن نَبَمَ، عَ شِلِ نّ عَلَتَلَ.<verse eid="AMO 5:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="AMO 5:9"/>عَلَتَلَ مِشِ شُنفبٍيٍ هَلَكِمَ نّ،</para>
  <para style="q" vid="AMO 5:9">عَ عٍ شَ يِرٍ مَكَنتَشِيٍ كَنَ.<verse eid="AMO 5:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="AMO 5:10"/>عٍ مِشِ شْنمَ نَشَن كِيتِ سَمَ سّرِيّ رَ،</para>
  <para style="q" vid="AMO 5:10">نْندِ قَلّ مُ رَقَن عٍ مَ.<verse eid="AMO 5:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="AMO 5:11"/>وٌ مِسِكِينّ تْورْ مَ،</para>
  <para style="q" vid="AMO 5:11">وٌ بَلٌي بَمَ عٍ يِ رَ دُوتِ رَ.</para>
  <para style="q" vid="AMO 5:11">وٌ بَرَ بَنشِ تٌقَنيِيٍ تِ فّمّيٍ رَ،</para>
  <para style="q" vid="AMO 5:11">كْنْ وٌ مُ قَمَ سَبَتِدٍ نٍيٍ كُي.</para>
  <para style="q" vid="AMO 5:11">وٌ بَرَ وّنِ سَنسِ قَنيِيٍ سِ،</para>
  <para style="q" vid="AMO 5:11">كْنْ وٌ مُ قَمَ نَ وّنِ مِندٍ.<verse eid="AMO 5:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="AMO 5:12"/>ﭑ عَ كٌلٌن وٌ شَ هَاكّ نُن وٌ شَ يُنُبِ فبٌ.</para>
  <para style="q" vid="AMO 5:12">وٌ تِنشِنتْي تْورْ مَ،</para>
  <para style="q" vid="AMO 5:12">وٌ سّرِيّ بّحِنمَ كْبِرِ شَ قٍ رَ،</para>
  <para style="q" vid="AMO 5:12">وٌ مُ سٍتَرٍيٍ مَكِيتِمَ نْندِ رَ.<verse eid="AMO 5:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="AMO 5:13"/>نَ نَن عَ تٌشِ شَشِلِمَ دُندُ مَ،</para>
  <para style="q" vid="AMO 5:13">بَرِ مَ يِ وَشَتِ مُ قَن.<verse eid="AMO 5:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="AMO 5:14"/>وٌ قٍ قَنيِ قٍن، وٌ وٌ يِ بَ قٍ حَاشِ رَ،</para>
  <para style="q" vid="AMO 5:14">عَلَكٌ وٌ شَ كِسِ، مَنفّ عَلَتَلَ شَ لُ وٌ سّيتِ مَ،</para>
  <para style="q" vid="AMO 5:14">عَلْ وٌ عَ قَلَمَ كِ نَشّ.<verse eid="AMO 5:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="AMO 5:15"/>وٌ شَ قٍ حَاشِ شْن.</para>
  <para style="q" vid="AMO 5:15">قٍ قَنيِ شَ رَقَن وٌ مَ.</para>
  <para style="q" vid="AMO 5:15">وٌ شَ كِيتِ شَ تِنشِن.</para>
  <para style="q" vid="AMO 5:15">شَ وٌ نَ رَبَ، تّمُندٍ،</para>
  <para style="q" vid="AMO 5:15">مَنفّ عَلَتَلَ كِنِكِنِمَ نّ وٌ تَن يُسُقُ بْنسْي دْنشْييٍ مَ.<verse eid="AMO 5:15"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="16" style="v" sid="AMO 5:16"/>نَ نَن عَ تٌشِ وٌن مَرِفِ عَلَتَلَ،</para>
  <para style="q" vid="AMO 5:16">دُنِحَ دَا مَنفّ نَشَ عَ مَسٍن،</para>
  <para style="q" vid="AMO 5:16">«عٍ عٍ وَ شُي عِتٍمَ نّ تَا كُي،</para>
  <para style="q" vid="AMO 5:16">عٍ عٍ وَ شُي عِتٍمَ نّ كِرَ شْن مَ.</para>
  <para style="q" vid="AMO 5:16">عٍ شّ سَ شِلِمَ نّ عٍ شَ عٍ وَ شُي عِتٍ حْن قٍ مَ،</para>
  <para style="q" vid="AMO 5:16">عٍ بّيتِبَيٍ شِلِمَ نّ عٍ شَ قَشّ بّيتِ بَ.<verse eid="AMO 5:16"/></para>
  <para style="q">
    <verse number="17" style="v" sid="AMO 5:17"/>ﭑ نّ دَنفِمَ شّ رَ تّمُي نَشّ،</para>
  <para style="q" vid="AMO 5:17">ﭑ وَ شُي نَن تُن مّمَ.»</para>
  <para style="q" vid="AMO 5:17">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="AMO 5:17"/></para>
  <para style="s">حَشَنكَتّ دِينّلَيٍ بّ</para>
  <para style="q">
    <verse number="18" style="v" sid="AMO 5:18"/>حَشَنكَتّ نَ مِشِ بّ</para>
  <para style="q" vid="AMO 5:18">نَشَن وَ مَ عَلَتَلَ شَ كِيتِ لْشْي شَ قَ.</para>
  <para style="q" vid="AMO 5:18">وٌ وَ مَ مُنسٍ شْن مَ نَ لْشْي؟</para>
  <para style="q" vid="AMO 5:18">نَ قِندِ مَ دِ مِ نَن نَ وٌ بّ،</para>
  <para style="q" vid="AMO 5:18">نَ مُ قِندِ مَ نَءِيَلَنيِ شَ رَ.<verse eid="AMO 5:18"/></para>
  <para style="q">
    <verse number="19" style="v" sid="AMO 5:19"/>نَ لُمَ نّ عَلْ مِشِ نَشَن عَ فِمَ يّتّ يَ رَ،</para>
  <para style="q" vid="AMO 5:19">عَ قَ سْحّ لِ.</para>
  <para style="q" vid="AMO 5:19">عَ نَ سٌ بَنشِ كُي، عَ عَ كِلْن بَنشِ رَ،</para>
  <para style="q" vid="AMO 5:19">بْشِمَسٍ قَ عَ شِن.<verse eid="AMO 5:19"/></para>
  <para style="q">
    <verse number="20" style="v" sid="AMO 5:20"/>عَلَتَلَ شَ كِيتِ لْشْي مُ قِندِشِ دِ مِ شَ رَ؟</para>
  <para style="q" vid="AMO 5:20">نَءِيَلَنيِ يٌ مُ نَ وٌ بّ نَ لْشْي.<verse eid="AMO 5:20"/></para>
  <para style="q">
    <verse number="21" style="v" sid="AMO 5:21"/>«ﭑ بَرَ وٌ شَ سَلِ شْن،</para>
  <para style="q" vid="AMO 5:21">عٍ مُ رَقَن ﭑ مَ قٍقٍ مَ.</para>
  <para style="q" vid="AMO 5:21">ﭑ مُ وَ مَ عٍ شْن قٍوٌ.<verse eid="AMO 5:21"/></para>
  <para style="q">
    <verse number="22" style="v" sid="AMO 5:22"/>وٌ شَ سّرّشّ فَن دَاشِ يٌ،</para>
  <para style="q" vid="AMO 5:22">وٌ شَ قَرِلّ سّرّشّ يٌ،</para>
  <para style="q" vid="AMO 5:22">وٌ شَ شَنُنتٍيَ سّرّشّ يٌ،</para>
  <para style="q" vid="AMO 5:22">عٍ سٍسٍ مُ رَقَن ﭑ مَ.</para>
  <para style="q" vid="AMO 5:22">ﭑ مُ تِنمَ عٍ رَ سُشُدٍ، هَلِ كٍرٍن.<verse eid="AMO 5:22"/></para>
  <para style="q">
    <verse number="23" style="v" sid="AMO 5:23"/>وٌ بّيتِ شُي مَكُيَ ﭑ نَ.</para>
  <para style="q" vid="AMO 5:23">ﭑ مُ وَ مَ وٌ شَ كْرَ بّيتِ شُي رَ مّقٍ.<verse eid="AMO 5:23"/></para>
  <para style="q">
    <verse number="24" style="v" sid="AMO 5:24"/>ﭑ وَ مَ نَشَن شْن،</para>
  <para style="q" vid="AMO 5:24">تِنشِنتْييٍ شَ فبٌ وٌ يَ مَ عَلْ يٍ نَشَن نَ بَا مَ.</para>
  <para style="q" vid="AMO 5:24">وٌ شَ قٍ قَنيِ شَ لُ عَلْ شُرٍ نَشَن مُ شْرِ مَ.<verse eid="AMO 5:24"/></para>
  <para style="q">
    <verse number="25" style="v" sid="AMO 5:25"/>وٌ تٌ نُ نَ فبٍنفبٍرٍن يِرٍ حّ تٌنفٌ نَانِ بُن مَ،</para>
  <para style="q" vid="AMO 5:25">وٌ سّرّشّيٍ بَ نّ؟ عَدٍ.<verse eid="AMO 5:25"/></para>
  <para style="q">
    <verse number="26" style="v" sid="AMO 5:26"/>وٌ كُيٍ مَشَنِن نّ،</para>
  <para style="q" vid="AMO 5:26">عَلْ وٌ شَ مَنفّ عَلَ، نَشَن شِلِ سِكٌتِ،</para>
  <para style="q" vid="AMO 5:26">شَ نَ مُ عَ رَ وٌ شَ تُنبُي عَلَ، نَشَن شِلِ كِيُن،</para>
  <para style="q" vid="AMO 5:26">وٌ نَشٍيٍ يَءِلَنشِ وٌ يّتّ رَ؟ عَدٍ.<verse eid="AMO 5:26"/></para>
  <para style="q">
    <verse number="27" style="v" sid="AMO 5:27"/>ﭑ قَمَ نّ وٌ شَنِندٍ كٌنيِيَ كُي دَ مَسِ شَنبِ رَ.»</para>
  <para style="q" vid="AMO 5:27">مَنفّ عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="AMO 5:27"/></para>
  <chapter eid="AMO 5"/>
  <chapter number="6" style="c" sid="AMO 6"/>
  <para style="s">حَشَنكَتّ بَننَ مِشِيٍ بّ</para>
  <para style="q">
    <verse number="1" style="v" sid="AMO 6:1"/>حَشَنكَتّ نَ وٌ بّ،</para>
  <para style="q" vid="AMO 6:1">وٌ تَن نَشٍيٍ لَشِ وٌ يّتّ رَ سِيٌنِ نُن سَمَرِ فٍيَيٍ قَرِ،</para>
  <para style="q" vid="AMO 6:1">عِسِرَيِلَ بْنسْي عَ شَشِلِ تِمَ وٌ تَن نَشٍيٍ رَ.<verse eid="AMO 6:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="AMO 6:2"/>وٌ سَ كَلٍنٍ مَتٌ، عَ نُن شَمَتَ، نَ تَا شُنفبٍيٍ.</para>
  <para style="q" vid="AMO 6:2">وٌ مَن شَ فٌرٌ قِلِسِتَ بْشِ مَ فَتِ مَتٌدٍ.</para>
  <para style="q" vid="AMO 6:2">نٍيٍ قِسَ وٌ بّ؟</para>
  <para style="q" vid="AMO 6:2">عٍ شَ بْشِ فبٌ وٌ فبٍ بّ؟<verse eid="AMO 6:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="AMO 6:3"/>وٌ عَ مَحْشُنشِ نّ عَ حَشَنكَتّ لْشْي مُ وٌ لِمَ،</para>
  <para style="q" vid="AMO 6:3">كْنْ وٌ عَ نِيَمَ نّ قٍ حَاشِ شَ وٌ سْتْ.<verse eid="AMO 6:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="AMO 6:4"/>وٌ وٌ مَلَبُمَ سَدٍ تٌقَنيِ مَ،</para>
  <para style="q" vid="AMO 6:4">وٌ يّشّي نُن نِنفٍ قَنيِ دٌنمَ،<verse eid="AMO 6:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="AMO 6:5"/>وٌ سِفِ سَ كْرَ رَ.</para>
  <para style="q" vid="AMO 6:5">وٌ حْشْ عَ مَ عَ وٌ قَتَ نَ رَبَدٍ عَلْ عَننَبِ دَوُدَ.<verse eid="AMO 6:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="AMO 6:6"/>وٌ وّنِ فبٍفبٍ مِنمَ،</para>
  <para style="q" vid="AMO 6:6">وٌ تُرٍ قَنيِ مَسٌ وٌ قَتٍ مَ.</para>
  <para style="q" vid="AMO 6:6">نَ كُي، وٌ مُ كْنتْقِلِمَ يُسُقُ بْنسْي شَ حَشَنكَتّ شَ قٍ رَ.<verse eid="AMO 6:6"/></para>
  <para style="q">
    <verse number="7" style="v" sid="AMO 6:7"/>نَ نَن عَ تٌشِ، وٌ سِنفٍ سِفَمَ كٌنيِيَ كُي.</para>
  <para style="q" vid="AMO 6:7">وٌ شَ شُلُنيِيٍ دَنمَ نّ.<verse eid="AMO 6:7"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="8" style="v" sid="AMO 6:8"/>مَرِفِ عَلَتَلَ بَرَ عَ كَلِ عَ يّتّ رَ.</para>
  <para style="q" vid="AMO 6:8">مَنفّ عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="AMO 6:8">«ﭑ يَشُبَ بْنسْي شَ يّتّ عِفبٌحَ شْنشِ.</para>
  <para style="q" vid="AMO 6:8">عٍ شَ يِرٍ مَكَنتَشِيٍ مُ رَقَن ﭑ مَ.</para>
  <para style="q" vid="AMO 6:8">ﭑ قَمَ نّ عٍ بِرِن هَلَكِدٍ.»<verse eid="AMO 6:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="AMO 6:9"/>شَ شّمّ قُ نَ بَنشِ ندٍ كُي،</para>
  <para style="q" vid="AMO 6:9">عٍ بِرِن قَمَ نّ قَشَدٍ.<verse eid="AMO 6:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="AMO 6:10"/>عٍ بَرٍنيِ نَ سٌ نَ بَنشِ كُي عٍ قُرٍيٍ تٌنفٌدٍ، عَ شَ عٍ فَن،</para>
  <para style="q" vid="AMO 6:10">عَ قَمَ نّ مِشِ مَشْرِندٍ نَشَن نْشُنشِ بَنشِ كُي،</para>
  <para style="q" vid="AMO 6:10">«مِشِ فبّتّ نَ بٍ بَقٍ عِ تَن نَ؟»</para>
  <para style="q" vid="AMO 6:10">عَ عَ يَابِمَ نّ، «عَدٍ.»</para>
  <para style="q" vid="AMO 6:10">عَ مَن فبِلٍنمَ نّ عَ قَلَ رَ، «عِ سَبَرِ،</para>
  <para style="q" vid="AMO 6:10">عَ مُ لَنمَ عَلَتَلَ شِلِ شَ قَلَ،<verse eid="AMO 6:10"/></para>
  <para style="q">
    <verse number="11" style="v" sid="AMO 6:11"/>بَرِ مَ عَلَتَلَ نَن يَامَرِ قِمَ</para>
  <para style="q" vid="AMO 6:11">عَ بَنشِ شُنفبٍ يٌ، بَنشِ لَنمَ يٌ،</para>
  <para style="q" vid="AMO 6:11">عٍ بِرِن شَ رَبِرَ، عٍ شَ كَنَ.»<verse eid="AMO 6:11"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v" sid="AMO 6:12"/>سٌييٍ نْمَ عٍ فِدٍ فّمّ يِرٍ؟</para>
  <para style="q" vid="AMO 6:12">نِنفٍيٍ نْمَ مّننِ بُشَدٍ؟</para>
  <para style="q" vid="AMO 6:12">عَوَ، مُنقٍ رَ وٌ تِنشِنيِ مَقِندِ مَ تِنشِنتَرٍيَ رَ،</para>
  <para style="q" vid="AMO 6:12">وٌ سّرِيّ مَقِندِ قٍ حَاشِ رَ؟<verse eid="AMO 6:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="AMO 6:13"/>وٌ سّيوَ مَ قٍ قُقَقُ رَ.</para>
  <para style="q" vid="AMO 6:13">وٌ نَشّ عَ وٌ شَ قٍ بَرَ سْونّيَ وٌ يّتّ سّنبّ رَ.<verse eid="AMO 6:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="AMO 6:14"/>مَنفّ عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="AMO 6:14">«نَ نَن عَ تٌشِ، ﭑ قَمَ كٍلِدٍ وٌ شِلِ مَ، عِسِرَيِلَ بْنسْي.</para>
  <para style="q" vid="AMO 6:14">وٌ تَن نَشٍيٍ نَ شَمَتَ هَن عَرَبَ شُرٍ،</para>
  <para style="q" vid="AMO 6:14">سِ ندٍ قَمَ نّ وٌ تْورْدٍ.»<verse eid="AMO 6:14"/></para>
  <chapter eid="AMO 6"/>
  <chapter number="7" style="c" sid="AMO 7"/>
  <para style="s">عَلَ شَ لَامَتُنيِ سِنفٍ عَننَبِ عَمٌسِ بّ</para>
  <para style="q">
    <verse number="1" style="v" sid="AMO 7:1"/>مَرِفِ عَلَتَلَ نَشَ يِ لَامَتُنيِ مَسٍن ﭑ بّ؛</para>
  <para style="q" vid="AMO 7:1">شّ تٌ شَبَ، مَنفّ شَ سَنسِ نّينّ قَن نُ نَ مِنِقٍ،</para>
  <para style="q" vid="AMO 7:1">عَلَتَلَ نَشَ كَتٌي رَ مِنِ.<verse eid="AMO 7:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="AMO 7:2"/>عٍ تٌ فّ سَنسِ بِرِن دٌندٍ بْشِ مَ،</para>
  <para style="q" vid="AMO 7:2">ﭑ نَشَ عَ قَلَ،</para>
  <para style="q" vid="AMO 7:2">«مَرِفِ عَلَتَلَ، ﭑ بَرَ عِ مَيَندِ،</para>
  <para style="q" vid="AMO 7:2">عِ شَ عٍ شَ يُنُبِ شَقَرِ،</para>
  <para style="q" vid="AMO 7:2">شَ نَ مُ عَ رَ يَشُبَ بْنسْي قَ بَلٌمَ دِ؟</para>
  <para style="q" vid="AMO 7:2">عَ سّنبّ مُ فبٌ.»<verse eid="AMO 7:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="AMO 7:3"/>عَلَتَلَ نَشَ كِنِكِنِ عٍ مَ، عَ قَ عَ مَسٍن،</para>
  <para style="q" vid="AMO 7:3">«عَوَ، يِ مُ رَبَمَ كْرّ.»</para>
  <para style="q" vid="AMO 7:3">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="AMO 7:3"/></para>
  <para style="s">عَلَ شَ لَامَتُنيِ قِرِن ندٍ عَننَبِ عَمٌسِ بّ</para>
  <para style="q">
    <verse number="4" style="v" sid="AMO 7:4"/>مَرِفِ عَلَتَلَ نَشَ يِ لَامَتُنيِ مَسٍن ﭑ بّ؛</para>
  <para style="q" vid="AMO 7:4">مَرِفِ عَلَتَلَ نَشَ عَ حَنِفٍ تّ شَ دّشّ.</para>
  <para style="q" vid="AMO 7:4">تّ نَشَ بْشِ بِرِن فَن، بْشِ يٍ بِرِن نَشَ شَرَ.<verse eid="AMO 7:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="AMO 7:5"/>ﭑ نَشَ عَ قَلَ،</para>
  <para style="q" vid="AMO 7:5">«مَرِفِ عَلَتَلَ، ﭑ بَرَ عِ مَيَندِ، دَن مّننِ،</para>
  <para style="q" vid="AMO 7:5">شَ نَ مُ عَ رَ يَشُبَ بْنسْي قَ بَلٌمَ دِ؟</para>
  <para style="q" vid="AMO 7:5">عَ سّنبّ مُ فبٌ.»<verse eid="AMO 7:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="AMO 7:6"/>عَلَتَلَ نَشَ كِنِكِنِ عٍ مَ، عَ قَ عَ قَلَ،</para>
  <para style="q" vid="AMO 7:6">«عَوَ، يِ مُ رَبَمَ كْرّ.»</para>
  <para style="q" vid="AMO 7:6">مَرِفِ عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="AMO 7:6"/></para>
  <para style="s">عَلَ شَ لَامَتُنيِ سَشَن ندٍ عَننَبِ عَمٌسِ بّ</para>
  <para style="q">
    <verse number="7" style="v" sid="AMO 7:7"/>مَرِفِ عَلَتَلَ نَشَ يِ لَامَتُنيِ مَسٍن ﭑ بّ؛</para>
  <para style="q" vid="AMO 7:7">مَرِفِ نُ تِشِ بِلِشِ تِنشِنشِ قَرِ،</para>
  <para style="q" vid="AMO 7:7">بِرِكِ مَتِنشِن سٍ نُ سُشُشِ عَ يِ رَ.<verse eid="AMO 7:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="AMO 7:8"/>عَلَتَلَ نَشَ ﭑ مَشْرِن،</para>
  <para style="q" vid="AMO 7:8">«عَمٌسِ، عِ مُنسٍ تٌشِ؟»</para>
  <para style="q" vid="AMO 7:8">ﭑ نَشَ عَ يَابِ، «بِرِكِ مَتِنشِن سٍ.»</para>
  <para style="q" vid="AMO 7:8">مَرِفِ نَشَ عَ مَسٍن،</para>
  <para style="q" vid="AMO 7:8">«ﭑ وَ مَ ﭑ مَ حَمَ شَ مَتِنشِن.</para>
  <para style="q" vid="AMO 7:8">ﭑ مُ دِحّمَ سْنْن.<verse eid="AMO 7:8"/></para>
  <para style="q">
    <verse number="9" style="v" sid="AMO 7:9"/>كُيٍ بَتُدٍيٍ كَنَمَ نّ عِسِيَفَ شَ بْشِ مَ.</para>
  <para style="q" vid="AMO 7:9">عِسِرَيِلَ شَ سَلِدٍيٍ رَبِرَ مَ نّ.</para>
  <para style="q" vid="AMO 7:9">ﭑ كٍلِمَ نّ يٍرٌبٌوَ مِ بْنسْي شِلِ مَ سَنتِدّفّمَ رَ.»<verse eid="AMO 7:9"/></para>
  <para style="s">عَمٌسِ نُن عَمَسِيَ</para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 7:10"/>بٍتٍلِ سّرّشّدُبّ عَمَسِيَ، نَشَ عَ مَسٍن عِسِرَيِلَ مَنفّ يٍرٌبٌوَ مِ بّ، «عَمٌسِ نَ عِ يَنقَقٍ عِسِرَيِلَ بْنسْي يَ مَ. عَ نَشَن قَلَمَ عَ مُ قَن بْشِ بّ. <verse eid="AMO 7:10"/><verse number="11" style="v" sid="AMO 7:11"/>عَمٌسِ نَشّ، ‹يٍرٌبٌوَ مِ قَمَ نّ قَشَدٍ سَنتِدّفّمَ رَ. عِسِرَيِلَ سِفَمَ نّ كٌنيِيَ كُي حَمَنّ مَ.›»<verse eid="AMO 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 7:12"/>عَمَسِيَ نَشَ عَ قَلَ عَمٌسِ بّ، «عِ تَن نَشَن لَامَتُنيِ تٌمَ، كٍلِ بٍ عِ سِفَ يُدَيَ. عِ شَ سَ عِ بَلٌي قٍن مّننِ نَمِحْنمّ وَلِ كُي، <verse eid="AMO 7:12"/><verse number="13" style="v" sid="AMO 7:13"/>كْنْ عِ نَشَ نَمِحْنمّ مَسٍنيِ تِ بٍتٍلِ دٍ، بَرِ مَ مَنفّ شَ سَلِدٍ نَ مّننِ نّ، عَ شَ مَنفَتَا نَن نَا رَ.»<verse eid="AMO 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 7:14"/>عَمٌسِ نَشَ عَمَسِيَ يَابِ، «نَمِحْنمّ مُ نَ ﭑ نَ. ﭑ بَبَ قَن نَمِحْنمّ مُ عَ رَ. شُرُ سٍ كَنيِ نَن ﭑ نَ. ﭑ سِكٌمٌرٌ سَنسِ قَن نَوَلِمَ. <verse eid="AMO 7:14"/><verse number="15" style="v" sid="AMO 7:15"/>عَلَتَلَ نَشَ ﭑ شِلِ شُرُ سٍيٍ تَفِ، عَ قَ عَ مَسٍن ﭑ بّ، ‹سِفَ، عِ سَ نَمِحْنمّ مَسٍنيِ تِ ﭑ مَ حَمَ عِسِرَيِلَ بّ.› <verse eid="AMO 7:15"/><verse number="16" style="v" sid="AMO 7:16"/>يَكْسِ، عِ تُلِ مَتِ عَلَتَلَ شَ مَسٍنيِ رَ، عِ تَن نَشَن عَ قَلَمَ ﭑ بّ، ‹عِ نَشَ نَمِحْنمّ مَسٍنيِ تِ عِسِرَيِلَ بّ، عِ نَشَ وْيّن عِسِيَفَ بْنسْي بّ.› <verse eid="AMO 7:16"/><verse number="17" style="v" sid="AMO 7:17"/>نَ وْيّنيِ مَ، عَلَتَلَ نَشّ، ‹عِ شَ فِنّ قِندِ مَ نّ لَنفٌي رَ تَا كُي. عِ شَ دِيٍ قَشَمَ نّ سَنتِدّفّمَ رَ. عِ شَ بْشِ بَمَ نّ عِ يِ رَ، عَ عِتَشُن مِشِ فبّتّيٍ مَ. عِ تَن، عِ قَشَمَ نّ بْشِ سّنِيّنتَرٍ مَ. عِسِرَيِلَ قَن شَنِنمَ نّ يِرٍ، نَشَن مَكُيَ عَ شَ بْشِ رَ.›»<verse eid="AMO 7:17"/></para>
  <chapter eid="AMO 7"/>
  <chapter number="8" style="c" sid="AMO 8"/>
  <para style="s">عَلَ شَ لَامَتُنيِ نَانِ ندٍ عَننَبِ عَمٌسِ بّ</para>
  <para style="q">
    <verse number="1" style="v" sid="AMO 8:1"/>مَرِفِ عَلَتَلَ نَشَ يِ لَامَتُنيِ مَسٍن ﭑ بّ؛</para>
  <para style="q" vid="AMO 8:1">دٍبٍ نَن نُ عَ رَ نَشَن نَقٍشِ سَنسِ بٌفِ مْشِ رَ.<verse eid="AMO 8:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="AMO 8:2"/>عَ نَشَ ﭑ مَشْرِن،</para>
  <para style="q" vid="AMO 8:2">«عَمٌسِ، عِ مُنسٍ تٌشِ بٍ؟»</para>
  <para style="q" vid="AMO 8:2">ﭑ نَشَ عَ يَابِ،</para>
  <para style="q" vid="AMO 8:2">«دٍبٍ رَقٍشِ سَنسِ بٌفِ مْشِ رَ.»</para>
  <para style="q" vid="AMO 8:2">عَلَتَلَ نَشَ عَ مَسٍن ﭑ بّ،</para>
  <para style="q" vid="AMO 8:2">«ﭑ مَ حَمَ عِسِرَيِلَ قَن بَرَ مْ.</para>
  <para style="q" vid="AMO 8:2">ﭑ مُ دِحّمَ سْنْن.»<verse eid="AMO 8:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="AMO 8:3"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="AMO 8:3">«نَ لْشْييٍ سِفِ نَشَن سَمَ مَنفّ شَ بَنشِ كُي،</para>
  <para style="q" vid="AMO 8:3">نَ مَسَرَ مَ نّ وَ شُي رَ.</para>
  <para style="q" vid="AMO 8:3">قُرٍيٍ رَلَنتَنمَ نّ يِرٍ بِرِن،</para>
  <para style="q" vid="AMO 8:3">بِرِن دُندُ مَ نّ نَ لْشْي.»<verse eid="AMO 8:3"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="4" style="v" sid="AMO 8:4"/>وٌ وٌ تُلِ مَتِ يِ مَسٍنيِ رَ،</para>
  <para style="q" vid="AMO 8:4">وٌ تَن نَشٍيٍ سٍتَرٍ تْورْ مَ،</para>
  <para style="q" vid="AMO 8:4">وٌ تَن نَشٍيٍ تْورْ مِشِ حَشَنكَتَمَ.<verse eid="AMO 8:4"/></para>
  <para style="q">
    <verse number="5" style="v" sid="AMO 8:5"/>وٌ نَشّ، «كِكٍ نّينّ سَلِ حْنمَ مُن تّمُي،</para>
  <para style="q" vid="AMO 8:5">عَلَكٌ وٌن شَ سَرٍ مَتِ؟</para>
  <para style="q" vid="AMO 8:5">مَلَبُي لْشْي حْنمَ مُن تّمُي،</para>
  <para style="q" vid="AMO 8:5">عَلَكٌ وٌن شَ مَالٍ مَتِ؟</para>
  <para style="q" vid="AMO 8:5">وٌن شَ ندٍ بَ وٌن مَ سٍ مَنِيَ سٍيٍ رَ،</para>
  <para style="q" vid="AMO 8:5">وٌن شَ ندٍ سَ وٌن مَ سَرٍ سٌي شُن مَ.</para>
  <para style="q" vid="AMO 8:5">وٌن شَ سِكٍيلِ كَمَلِتَرٍ يَءِلَن.<verse eid="AMO 8:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="AMO 8:6"/>وٌن شَ مِسِكِينّ مَتِ كْبِرِ رَ،</para>
  <para style="q" vid="AMO 8:6">وٌن سٍتَرٍ مَتِ سَنكِرِ سَرٍ رَ.</para>
  <para style="q" vid="AMO 8:6">وٌن شَ مَالٍ شْرِ مَتِ عَ لَفِ رَ عَ شُن مَ.»<verse eid="AMO 8:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="AMO 8:7"/>عَلَتَلَ نَشَ عَ كَلِ عَ يّتّ رَ،</para>
  <para style="q" vid="AMO 8:7">يَشُبَ بْنسْي عَ يّتّ عِفبٌمَ عَلَ نَشَن نَ؛</para>
  <para style="q" vid="AMO 8:7">«ﭑ مُ نّيمُمَ عٍ رَبَ قٍيٍ مَ،</para>
  <para style="q" vid="AMO 8:7">هَن دُنِحَ حْن.<verse eid="AMO 8:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="AMO 8:8"/>يِ بْشِ قَمَ كَنَدٍ نَ نَن مَ.</para>
  <para style="q" vid="AMO 8:8">بٍكَيٍ بِرِن لُمَ سُننُنيِ نَن كُي.</para>
  <para style="q" vid="AMO 8:8">بْشِ سّرّنمَ نّ عَلْ مِسِرَ شُرٍ،</para>
  <para style="q" vid="AMO 8:8">نَشَن بَنبَرَنمَ، عَ مَن فبِلٍن.»<verse eid="AMO 8:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="AMO 8:9"/>مَرِفِ عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="AMO 8:9">«ﭑ قَمَ نّ عَ رَفِرِدٍ نَ لْشْي،</para>
  <para style="q" vid="AMO 8:9">سٌفٍ فٌرٌ عَ فٌرٌ تّمُي مُ عَ لِشِ،</para>
  <para style="q" vid="AMO 8:9">دِ مِ سِن بْشِ مَ يَنيِ رَ.<verse eid="AMO 8:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="AMO 8:10"/>وٌ شَ سَلِيٍ مَسَرَ مَ حْن سٌي نَن نَ،</para>
  <para style="q" vid="AMO 8:10">وٌ شَ سِفِيٍ مَسَرَ مَ وَ شُي نَن نَ.</para>
  <para style="q" vid="AMO 8:10">ﭑ سُننُن دٌنمَ رَفٌرٌ مَ نّ وٌ مَ،</para>
  <para style="q" vid="AMO 8:10">ﭑ وٌ شُنيِ بِ سُننُن قٍ مَ.</para>
  <para style="q" vid="AMO 8:10">ﭑ قَمَ نّ سُننُنيِ شُنفبٍ رَفٌرٌدٍ بْشِ مَ،</para>
  <para style="q" vid="AMO 8:10">عَلْ دِ كٍرٍنيِ نَ قَشَ.</para>
  <para style="q" vid="AMO 8:10">نَ شْنّ مُ بَمَ وٌ مَ عَبَدَن.»<verse eid="AMO 8:10"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="11" style="v" sid="AMO 8:11"/>مَرِفِ عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="AMO 8:11">«نَ لْشْييٍ كَامّ سِنمَ نّ بْشِ مَ،</para>
  <para style="q" vid="AMO 8:11">كْنْ دٌنيِ كَامّ مُ عَ رَ، يٍ شْلِ قَن مُ عَ رَ.</para>
  <para style="q" vid="AMO 8:11">وٌ كَامّمَ عَلَتَلَ شَ مَسٍنيِ نَن مَ قٍ رَ.<verse eid="AMO 8:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="AMO 8:12"/>وٌ بْشِ بِرِن عِفِرِ مَ نّ، كٍلِقٍ كْولَ مَ هَن سٌفٍتٍدٍ،</para>
  <para style="q" vid="AMO 8:12">عَلَتَلَ شَ مَسٍنيِ قٍندٍ،</para>
  <para style="q" vid="AMO 8:12">كْنْ وٌ مُ عَ تٌمَ.<verse eid="AMO 8:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="AMO 8:13"/>نَ لْشْي وٌ شَ فِنّدِ مّدِيٍ نُن وٌ شَ سّفّتَلَيٍ قَشَمَ نّ نَ كَامّ مَ.<verse eid="AMO 8:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="AMO 8:14"/>سِنفٍ، عٍ نُ عٍ كَلِمَ سَمَرِ شَ عَلَ وُلٍ دَاشِ نَن نَ.</para>
  <para style="q" vid="AMO 8:14">عٍ نُ عَ قَلَ، ‹ﭑ بَرَ ﭑ كَلِ دَنَ شَ عَلَ رَ.›</para>
  <para style="q" vid="AMO 8:14">‹ﭑ بَرَ ﭑ كَلِ بٍرِ سٍيبَ شَ عَلَ رَ.›</para>
  <para style="q" vid="AMO 8:14">كْنْ عٍ قَمَ نّ بِرَدٍ، عٍ مُ كٍلِمَ عَبَدَن.»<verse eid="AMO 8:14"/></para>
  <chapter eid="AMO 8"/>
  <chapter number="9" style="c" sid="AMO 9"/>
  <para style="s">عَلَ شَ لَامَتُنيِ دْنشْي عَننَبِ عَمٌسِ بّ</para>
  <para style="q">
    <verse number="1" style="v" sid="AMO 9:1"/>ﭑ نَشَ لَامَتُنيِ ندٍ تٌ،</para>
  <para style="q" vid="AMO 9:1">مَرِفِ نُ نَ سّرّشّبَدٍ قَرِ.</para>
  <para style="q" vid="AMO 9:1">عَ نَشَ عَ يَمَرِ،</para>
  <para style="q" vid="AMO 9:1">«سَلِدٍ شُنيِ رَبِرَ،</para>
  <para style="q" vid="AMO 9:1">سَلِدٍ سَنيِ عِتَلَ.</para>
  <para style="q" vid="AMO 9:1">عَ بِرِن شَ بِرَ مِشِيٍ شُن مَ.</para>
  <para style="q" vid="AMO 9:1">ﭑ عٍ شَ دِيٍ هَلَكِمَ نّ سَنتِدّفّمَ رَ.</para>
  <para style="q" vid="AMO 9:1">مِشِ كٍرٍن مُ كِسِمَ.</para>
  <para style="q" vid="AMO 9:1">مِشِ كٍرٍن مُ عَ نْشُنمَ ﭑ مَ.<verse eid="AMO 9:1"/></para>
  <para style="q">
    <verse number="2" style="v" sid="AMO 9:2"/>هَلِ عٍ فٌرٌ عَلِفِيَمَ، ﭑ نٍيٍ سُشُمَ نّ.</para>
  <para style="q" vid="AMO 9:2">شَ عٍ تٍ كٌورٍ مَ، ﭑ نٍيٍ رَفٌرٌ مَ نّ.<verse eid="AMO 9:2"/></para>
  <para style="q">
    <verse number="3" style="v" sid="AMO 9:3"/>شَ عٍ عٍ نْشُن ﭑ مَ كَرٍ مٍلٍ فٍيَ قَرِ،</para>
  <para style="q" vid="AMO 9:3">ﭑ عٍ قٍنمَ نّ، ﭑ عٍ سُشُ.</para>
  <para style="q" vid="AMO 9:3">شَ عٍ عٍ نْشُن ﭑ مَ بَا بُن مَ،</para>
  <para style="q" vid="AMO 9:3">ﭑ بْشِمَسٍيٍ يَمَرِ مَ نّ عَ شَ عٍ شِن.<verse eid="AMO 9:3"/></para>
  <para style="q">
    <verse number="4" style="v" sid="AMO 9:4"/>شَ عٍ يَشُييٍ عٍ شَنِن كٌنيِيَ كُي،</para>
  <para style="q" vid="AMO 9:4">ﭑ يَامَرِ قِمَ نّ عٍ شَ عٍ قَشَ سَنتِدّفّمَ رَ.</para>
  <para style="q" vid="AMO 9:4">ﭑ نَن ﭑ يَ تِمَ نّ عٍ رَ،</para>
  <para style="q" vid="AMO 9:4">كْنْ نَ مُ قِندِ مَ مُنَقَنيِ رَ عٍ بّ،</para>
  <para style="q" vid="AMO 9:4">عَ قِندِ مَ حَشَنكَتّ نَن نَ عٍ بّ.»<verse eid="AMO 9:4"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="5" style="v" sid="AMO 9:5"/>مَرِفِ عَلَتَلَ، نَشَن نَ مَنفّ رَ،</para>
  <para style="q" vid="AMO 9:5">شَ عَ عَ حَنِفٍ عَ شَ دِن بْشِ رَ،</para>
  <para style="q" vid="AMO 9:5">بْشِ سّرّنمَ نّ،</para>
  <para style="q" vid="AMO 9:5">مِشِ بِرِن لُ سُننُنيِ كُي،</para>
  <para style="q" vid="AMO 9:5">عَ عِتٍمَ نّ، عَ مَن عَ عِفٌرٌ عَلْ مِسِرَ شُرٍ نِلِ نَ بَنبَرَن حّ.<verse eid="AMO 9:5"/></para>
  <para style="q">
    <verse number="6" style="v" sid="AMO 9:6"/>عَ بَرَ عَ شَ لِنفِرَ تِ كٌورٍ مَ.</para>
  <para style="q" vid="AMO 9:6">عَ بَرَ كٌورٍ وَلَشّ لُ بْشِ شُن مَ.</para>
  <para style="q" vid="AMO 9:6">عَ يٍ رَكٍلِمَ بَا مَ، عَ رَدِن بْشِ مَ.</para>
  <para style="q" vid="AMO 9:6">عَ شِلِ نّ عَلَتَلَ.<verse eid="AMO 9:6"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="7" style="v" sid="AMO 9:7"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="AMO 9:7">«عِسِرَيِلَكَيٍ، وٌ تِدٍ مُ فبٌ ﭑ بّ عَلْ عٍتِيٌثِكَيٍ؟</para>
  <para style="q" vid="AMO 9:7">ﭑ مُ وٌ رَ مِنِ شّ مِسِرَ بْشِ رَ،</para>
  <para style="q" vid="AMO 9:7">عَلْ ﭑ قِلِسِتَكَيٍ رَ مِنِ كَقَتٌرٌ كِ نَشّ؟</para>
  <para style="q" vid="AMO 9:7">ﭑ مُ وٌ رَ مِنِ شّ مِسِرَ بْشِ رَ،</para>
  <para style="q" vid="AMO 9:7">عَلْ ﭑ سِرِيَكَيٍ رَ مِنِ كِرٌ كِ نَشّ؟<verse eid="AMO 9:7"/></para>
  <para style="q">
    <verse number="8" style="v" sid="AMO 9:8"/>وٌ وٌ يَيٍ رَبِ؛</para>
  <para style="q" vid="AMO 9:8">مَرِفِ عَلَتَلَ بَرَ يُنُبِتْييٍ شَ مَنفّيَ تٌ،</para>
  <para style="q" vid="AMO 9:8">عَ قَمَ نّ نَ هَلَكِدٍ يِ دُنِحّ بّندّ قُحِ قَرِ.»<verse eid="AMO 9:8"/></para>
  <para style="b"/>
  <para style="q">
    <verse number="9" style="v" sid="AMO 9:9"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="AMO 9:9">«كْنْ ﭑ مُ يَشُبَ بْنسْي بِرِن هَلَكِمَ.</para>
  <para style="q" vid="AMO 9:9">ﭑ يَامَرِ قِمَ نّ عَلَكٌ عِسِرَيِلَ بْنسْي شَ مَيٍفٍتِ.</para>
  <para style="q" vid="AMO 9:9">ﭑ عَ عِقٍمَ نّ عَلْ مَالٍ عِقٍمَ كِ نَشّ،</para>
  <para style="q" vid="AMO 9:9">عَلَكٌ شْرِ قَنيِ كٍرٍن نَشَ بِرَ.<verse eid="AMO 9:9"/></para>
  <para style="q">
    <verse number="10" style="v" sid="AMO 9:10"/>كْنْ يُنُبِتْييٍ نَشٍيٍ بِرِن نَ ﭑ مَ حَمَ يَ مَ،</para>
  <para style="q" vid="AMO 9:10">ﭑ عٍ قَشَمَ نّ سَنتِدّفّمَ رَ،</para>
  <para style="q" vid="AMO 9:10">عٍ تَن نَشٍيٍ عَ قَلَمَ،</para>
  <para style="q" vid="AMO 9:10">‹عِ مُ قَمَ مُشُ حَشَنكَتَدٍ،</para>
  <para style="q" vid="AMO 9:10">نَ حَشَنكَتّ مُ مُشُ لِمَ.›»<verse eid="AMO 9:10"/></para>
  <para style="s">عِسِرَيِلَ شَ كِسِ</para>
  <para style="q">
    <verse number="11" style="v" sid="AMO 9:11"/>«نَ لْشْي ﭑ دَوُدَ شَ مَنفّيَ كَنَشِ عِتٍمَ نّ.</para>
  <para style="q" vid="AMO 9:11">ﭑ قَمَ نّ نَ يَءِلَندٍ،</para>
  <para style="q" vid="AMO 9:11">ﭑ قَمَ نّ عَ رَكٍلِدٍ عَلْ عَ سِنفٍ.<verse eid="AMO 9:11"/></para>
  <para style="q">
    <verse number="12" style="v" sid="AMO 9:12"/>عٍ مَن عٍدٌن مَسْتْمَ نّ،</para>
  <para style="q" vid="AMO 9:12">عَ نُن سِ بِرِن ﭑ شِلِ سَشِ نَشٍيٍ شُن مَ.»</para>
  <para style="q" vid="AMO 9:12">عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ،</para>
  <para style="q" vid="AMO 9:12">عَ قَمَ نّ نَ بِرِن نَكَمَلِدٍ.<verse eid="AMO 9:12"/></para>
  <para style="q">
    <verse number="13" style="v" sid="AMO 9:13"/>عَلَتَلَ شَ مَسٍنيِ نَن يَ؛</para>
  <para style="q" vid="AMO 9:13">«وٌ وٌ يَيٍ رَبِ؛</para>
  <para style="q" vid="AMO 9:13">لْشْييٍ قَمَ عَ لِدٍ،</para>
  <para style="q" vid="AMO 9:13">شّ سَيٍ نُن شّ شَبَيٍ وَلِمَ وَشَتِ كٍرٍن نّ.</para>
  <para style="q" vid="AMO 9:13">وّنِ بَيٍ نُن شّ سَيٍ، قَن وَلِمَ وَشَتِ كٍرٍن نّ.</para>
  <para style="q" vid="AMO 9:13">وّنِ فبٌمَ نّ فٍيَيٍ قَرِ،</para>
  <para style="q" vid="AMO 9:13">هَن فٍيَيٍ بِرِن بُندَ.<verse eid="AMO 9:13"/></para>
  <para style="q">
    <verse number="14" style="v" sid="AMO 9:14"/>ﭑ نَن ﭑ مَ حَمَ رَفبِلٍنمَ نّ عَ شْنيِ كٍلِقٍ رَ كٌنيِيَ كُي.</para>
  <para style="q" vid="AMO 9:14">عٍ قَمَ نّ تَا كَنَشِيٍ تِدٍ، عٍ سَبَتِمَ دّننَشّ.</para>
  <para style="q" vid="AMO 9:14">عٍ وّنِ بِلِيٍ سِمَ نّ، عٍ عَ وّنِ مِن.</para>
  <para style="q" vid="AMO 9:14">عٍ لَاكْي سَمَ نّ، عٍ عَ بٌفِ دٌن.<verse eid="AMO 9:14"/></para>
  <para style="q">
    <verse number="15" style="v" sid="AMO 9:15"/>ﭑ مَن عٍ رَ سَبَتِمَ نّ عٍ شَ بْشِ مَ.</para>
  <para style="q" vid="AMO 9:15">عٍ مُ كٍلِمَ بْشِ مَ سْنْن</para>
  <para style="q" vid="AMO 9:15">ﭑ دّننَشّ قِشِ عٍ مَ.»</para>
  <para style="q" vid="AMO 9:15">وٌ مَرِفِ عَلَتَلَ شَ مَسٍنيِ نَن نَ كِ.<verse eid="AMO 9:15"/></para>
  <chapter eid="AMO 9"/>
</usx>
