<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="DAN" style="id" />
  <para style="h">Dan</para>
  <para style="toc1">kitabu danyal</para>
  <para style="toc2">Dani</para>
  <para style="toc3">DAN</para>
  <para style="mt1">kitabu danyal</para>
  <para style="ip">elγerD:esexni n elyehuwd imumnen elli edderen g ellesr d esexni n elquwweθ n erreb f elqeεεeθ. w erreb nette elli yetwejjeh g elquwweθ n eTTebiyεeθ d elmeSiyr n ellummaθ w nette elli yettelhe s ecceεbes. elli yuri:danyal yemmeryasen:lesre elkul g babel d leεbaδ n erreb g kul blase elweqθ d elHal n tires: yemmeTTef danyal yemmayi y babel yexδem settiyn esne g elεehδ n nebuxeδneSSer d belceSSer d daryuws d kuwrec.</para>
  <chapter number="1" style="c" sid="DAN 1" />
  <para style="s">danyal d eSSuHHebes letlaθe g elqSer n babel</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 1:1" />g usukkes eθθaleθ seg elHukm n yuwyaqiym elmlek n yehuwδa, yuli nebuwxeδneSSer elmlek n babel y uwrceliym yHeSert. <verse eid="DAN 1:1" /><verse number="2" style="v" sid="DAN 1:2" />yuwc erreb y ifesnes yuwyaqiym elmlek n yehuwδa d lebHaD seg elmeεεuwn n elHuwc n rebbi, yaγeδ elmlek n babel elmeεεuwn y elqeεεeθes ysuwδef elmeεεuwn y θexzent n elHuwc n errebbes. <verse eid="DAN 1:2" /><verse number="3" style="v" sid="DAN 1:3" />yen elmlek y emeqqar n ixeddemnes, w esmiθes ecfenezu, esedyaγ leεbaδ seg bni israYiyl elεileθ n elmlek d imeqqaren, <verse eid="DAN 1:3" /><verse number="4" style="v" sid="DAN 1:4" />elεzerre w eddiysen Hette elεiyb, elmenDrensen yebhe, essenen elHekmaθ elkul, w fehmen kul cey, elli e tgedden exeδmen g elqSer n elmlek, usinc entiseHfeD ecfenezu elqrayeθ n ibebiliyyen d elluγθensen. <verse eid="DAN 1:4" /><verse number="5" style="v" sid="DAN 1:5" />yegeyasen elmlek elHeSSeθ n kul yuwm, seg eče n elmlek d ecrebes, bac e mrebben tlaθe sniyn, w beεεeδ exeδmen elmlek. <verse eid="DAN 1:5" /><verse number="6" style="v" sid="DAN 1:6" />w ykan essisen seg bni yehuwδa, danyal d Henenya d miycaYiyl d εezerya. <verse eid="DAN 1:6" /><verse number="7" style="v" sid="DAN 1:7" />yucasen eccaf ellesami ettijdidin, ysemme danyal belTecaSer, w Henenya cedrex, w miycaYiyl miycex, w εezerya εebdeneγuw.<verse eid="DAN 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 1:8" />yemenni yeεzem danyal g ules bac liθeč seg eče n elmlek d ecrebes, bac yetxelifc ecceriyεeθ, yeĎleb seg emeqqar n ixeddemnes bac e θyeεfe seg ečaye nette d iSHibnes. <verse eid="DAN 1:8" /><verse number="9" style="v" sid="DAN 1:9" />w rebbi yuce y danyal enneεmeθ d erreHmeθ bac e yaf elqeδres γer eccaf, <verse eid="DAN 1:9" /><verse number="10" style="v" sid="DAN 1:10" />yen eccaf y danyal:&lt;&lt;ettekkaδe seg siydiy elmlek elli yHuTTi δ emeshuwl f ečewwem d eswewwem lukan eyezr uδmewnewwem elli eDεef n uδmawen n idrari n eljilewwem, elweqθes eθirarem s ixfiyw γer elmlek.&gt;&gt; <verse eid="DAN 1:10" /><verse number="11" style="v" sid="DAN 1:11" />yen danyal y eεessas elli yHuTTi eccaf f danyal d Henenya d micaYiyl d εezerya, <verse eid="DAN 1:11" /><verse number="12" style="v" sid="DAN 1:12" />&lt;&lt;jerreb ixeddemnex ya siydiy εecre eyyam eneč δiysen kan δ elxuDreθ nesw kan δ amen, <verse eid="DAN 1:12" /><verse number="13" style="v" sid="DAN 1:13" />w elbeεεeδ erqeb twelinne d idrari elli θetten seg eče n elmlek θεemelδane emmax i θzerreδ&gt;&gt;. <verse eid="DAN 1:13" /><verse number="14" style="v" sid="DAN 1:14" />eyendeγ yesl edwinsen yjerrebθen εecre eyyam. <verse eid="DAN 1:14" /><verse number="15" style="v" sid="DAN 1:15" />w beεεeδ εecre eyyam teδwel elheyθensen xiyr w eqwe n idrari elkul elli θetten seg eče n elmlek. <verse eid="DAN 1:15" /><verse number="16" style="v" sid="DAN 1:16" />eyendeγ yeδwel eεessas e yqam ečensen d ecrebensen yucasen elxuDreθ.<verse eid="DAN 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 1:17" />yuc rebbi y idrariδin lerbεe elmeεrfeθ n elqrayeθ elkul d etterbyeθ d elHekmeθ, emme ykan danyal yfehhem belgde g ezre d tirjiyθin. <verse eid="DAN 1:17" /><verse number="18" style="v" sid="DAN 1:18" />w max i θuwqe elmuddeθ elli yHeddeteθ elmlek nebuwxeδneSSer, yuγetten eccaf ezzeθes. <verse eid="DAN 1:18" /><verse number="19" style="v" sid="DAN 1:19" />yuθley elmlek iδsen w elyufic δwiyn δiysen elkul m danyal d Henenya d miycaYiyl d εezerya, eyendeγ yexθarin bac e θexeδmen. <verse eid="DAN 1:19" /><verse number="20" style="v" sid="DAN 1:20" />kul merreθ yenceδten elmlek yafin γersen exθer n εecre merraθ seg wessen d elHikmeθ elli γer iseHHaren d imejuwsiyyen elli g elmemlekθes elkul. <verse eid="DAN 1:20" /><verse number="21" style="v" sid="DAN 1:21" />yeqqiym danyal diyn, g elqSer n elmlek, seg essukkes iglewwel seg elεehδ n elmlek kuwrec.<verse eid="DAN 1:21" /></para>
  <chapter eid="DAN 1" />
  <chapter number="2" style="c" sid="DAN 2" />
  <para style="s">tirjiθ n nebuwxeδneSSer f eSSembeθ</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 2:1" />w g usukkes eθθani seg elεehδ n elmlek nebuwxeδneSSer, yettirjiyθ elmlek tirjiyθin elli qelleqnet egget, serwelneθ felles enuddem. <verse eid="DAN 2:1" /><verse number="2" style="v" sid="DAN 2:2" />emmale yuzen yuγeδ iseHHaren d imejuwsiyyen d iεerrafen d imunejmen bac e sfesren tirjiyθines, eyendeγ esδen bedden ezzeθes. <verse eid="DAN 2:2" /><verse number="3" style="v" sid="DAN 2:3" />yenneyasen:&lt;&lt;zriyγ tirjiyθ θqelqiyδ, w exse δ esne elmeεnas&gt;&gt;. <verse eid="DAN 2:3" /><verse number="4" style="v" sid="DAN 2:4" />jewbenti imunejmen s elluwγeθ n elleremiyyeθ:&lt;&lt;eneθmenne eθedreδ diyme ey elmlek, ennane s met i θettirjiyθeδ bac e nged enfesser&gt;&gt;. <verse eid="DAN 2:4" /><verse number="5" style="v" sid="DAN 2:5" />yenneyasen elmlek:&lt;&lt;exennedjulle elli iδekan eltgeddemc e yeθfesrem θirjiyθiyw exenfeθerce erre leHwecewwem δ elγbaraθ, <verse eid="DAN 2:5" /><verse number="6" style="v" sid="DAN 2:6" />emme iδekan θgeddem θfessermiyδ θirjiyθiyw exennuwce elhδaye δ timeqqarin egget d elqδer. emmale f essermiyδ tenmi f θirjiyθiniyw&gt;&gt;. <verse eid="DAN 2:6" /><verse number="7" style="v" sid="DAN 2:7" />jewbent elmerreθ xlaf ennanes:&lt;&lt;ennane f θirjiyθex w nečin e xettenfesser.&gt;&gt; <verse eid="DAN 2:7" /><verse number="8" style="v" sid="DAN 2:8" />yenneyasen elmlek:&lt;&lt;essene b elHeq elli xenyum texsem e θerbHem elweqθ max i θezriym elli edwiyw eddiyc erjaε. <verse eid="DAN 2:8" /><verse number="9" style="v" sid="DAN 2:9" />iδekan eltessinemc efesser elεuqebθewwem netteθ iceθ, εlexaTer θemfahmem jmiyε f edwi δ elfaseδ w muc δ uSHiyH ezzeθiyw, bac e θerbHem elweqθ. heδakeεlac yelzemkum e yθennem θirjiyθiyw bac e sne elli xenyum e tgeddem belgde efesser.&gt;&gt; <verse eid="DAN 2:9" /><verse number="10" style="v" sid="DAN 2:10" />ennen imunejmen y elmlek:&lt;&lt;leHebbe Hette iyjen eyged e yfesser elli yenne felles siydiy, w eHebbe Hette elmlek δ emeqqar yenceδ eseHHar ziyγ δ emejuwsi ziyγ δ imunejjem f elHajeθ m tah. <verse eid="DAN 2:10" /><verse number="11" style="v" sid="DAN 2:11" />w elHajeθe elli ynecceδ felles elmlek θuεer egget, w elyetged Hette Hed etyesxen y elmlek kan δ elYilahaθ emme elεemrenc d leεbaδ.&gt;&gt; <verse eid="DAN 2:11" /><verse number="12" style="v" sid="DAN 2:12" />elweqθes yeθγeccec elmlek egget, yeĎleb enγe n elεuqqal elkul g babel. <verse eid="DAN 2:12" /><verse number="13" style="v" sid="DAN 2:13" />w sahen yeffeγ δiysen elHukm n wenγe, w essisen danyal d eSSuHHebes.<verse eid="DAN 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="DAN 2:14" />heδake εlac ymelleg danyal s elheqmeθ y eryuwx elqayeδ n elHers n elmlek, elli yeffeγ δ eyenγ elεuqqal g babel. <verse eid="DAN 2:14" /><verse number="15" style="v" sid="DAN 2:15" />emmax i syenne elmlek, yennes danyal:&lt;&lt;imat elmlek yeHkem fellane sah?&gt;&gt; yen eryuwx y danyal f kul ciy. <verse eid="DAN 2:15" /><verse number="16" style="v" sid="DAN 2:16" />w elbeεεeδ yeĎleb danyal seg elmlek elweqθ bac e syen f efesser n tirjiyθ.<verse eid="DAN 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 2:17" />yemreq danyal y elHuwces yen y Henenya d miycaYiyl d εezerya iSHibnes f elHkayeθ, <verse eid="DAN 2:17" /><verse number="18" style="v" sid="DAN 2:18" />bac e Ďelben seg erreb n esme entyerHem elkul usinc entiεawen f essen n esserre w entineqqec elmlek nihnin d elbaqi n εuqqal g babel. <verse eid="DAN 2:18" /><verse number="19" style="v" sid="DAN 2:19" />elweqθes yemmekcef esser y danyal yeθjellayes g δeggiyδ, ybarex erreb n esme. <verse eid="DAN 2:19" /><verse number="20" style="v" sid="DAN 2:20" />ysebbeH yen:&lt;&lt;eyembarex ellesm n rebbi seg elbδu n eddunyeθ y ellexres. y nette elHekmeθ d elquwweθ, <verse eid="DAN 2:20" /><verse number="21" style="v" sid="DAN 2:21" />nette elli yetγeyyer g luwqaθ d lezman, e yHuT lemluwk yeεzelten, e yuc elHekmeθ y iθbebes w elmeεrfeθ y elli fehmenteθ. <verse eid="DAN 2:21" /><verse number="22" style="v" sid="DAN 2:22" />nette e yekcef lesrar elli γreqneθ, w yessen elli g eθsellesθ, w eltbeεεeδc felles θefuθ. <verse eid="DAN 2:22" /><verse number="23" style="v" sid="DAN 2:23" />exeHemde ya erreb n midniyw. w y cex esebHe, εlexaTer θuciyδi elHekmeθ d elquδreθ, tendi f elli neĎlebθi essix, teεlemdane s elli δ eθnen y elmlek.&gt;&gt;<verse eid="DAN 2:23" /></para>
  <para style="s">danyal yefesser y elmlek f tirjiyθes</para>
  <para style="p">
    <verse number="24" style="v" sid="DAN 2:24" />w elbeεεeδ yemreq danyal y eryuwx elli yeĎleb essis elmlek δ ayenγ elεuqqal n babel yennes:&lt;&lt;eθenγec elεuqqal n babel. suδfi y elmlek bac e senne f θirjiyθes.&gt;&gt;<verse eid="DAN 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 2:25" />eyendeγ ysuδefθi fiyseε y elmlek yennes:&lt;&lt;ufiyγ iyjen seg elli emmetfen seg bni yehuwδa, e xyen f elmeεne n tirjiyθ.&gt;&gt; <verse eid="DAN 2:25" /><verse number="26" style="v" sid="DAN 2:26" />yen elmlek y danyal elli ellesmes belTecaser:&lt;&lt;eθgeddeδ cex e yθenneδ f θirjiyθ elli zrixt usinc e yetfesreδ?&gt;&gt; <verse eid="DAN 2:26" /><verse number="27" style="v" sid="DAN 2:27" />yer felles danyal:&lt;&lt;esser elli θnecδeδ felles ya elmlek, elyetged Hed exettifessser la δ εuqqal w la δ elmejuws w la δ iseHHaren w la δ imunejmen. <verse eid="DAN 2:27" /><verse number="28" style="v" sid="DAN 2:28" />yemenni g esme erreb yessen e yekcef lesrar, e xenne ey elmlek nebuwxeneSSer f elli δ ySar g liyyameθ e jeyyin. θirjiyθ elli θezritteθ w cex θenεeseδ, tay elmeεnas: <verse eid="DAN 2:28" /><verse number="29" style="v" sid="DAN 2:29" />tuseδex ey elmlek w cex θettekkeδ g esrirex, elfekreθ g elli δ ySar beεεeδ liyyameθ w rebbi elli yessen e yekcef lesrar yeεlemex s elli δ ySar: <verse eid="DAN 2:29" /><verse number="30" style="v" sid="DAN 2:30" />w esserre yemmekcfiyδ, muc εlexaTer γeri elHekmeθ exθer n iddiyn, emme bac e xeεlme ey elmlek f efesser n tirjiyθex d elli yHus essis ulex.<verse eid="DAN 2:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="DAN 2:31" />cex θezriyδ, ey elmlek, eSSembeθ ettemeqqarθ egget, θkan θbed ezzeθex eteĎewwe egget w elmenδres yessekkeδ. <verse eid="DAN 2:31" /><verse number="32" style="v" sid="DAN 2:32" />ykan ixfes δ uwreγ δ eSSafi, iδmernes d iγelnes δ elfeTTeθ, w θeδisθes d lefxeδes seg enHas, <verse eid="DAN 2:32" /><verse number="33" style="v" sid="DAN 2:33" />emme essigenes seg uzzal w ikreεnes lewse seg uzzal w lewse seg elfuxxar. <verse eid="DAN 2:33" /><verse number="34" style="v" sid="DAN 2:34" />elweqθ elli cex θnedziyδ δiys, tuDe θγaγet seg eddehreθ, menγiyr ettilemmes Hette Hed tewweθ eSSembeθ f ikreεnes elli nihnin seg uzzal d elfuxxar, tkesserθen qiqqi qiqqi. <verse eid="DAN 2:34" /><verse number="35" style="v" sid="DAN 2:35" />eyendeγ yemreq uzzal d elfuxxar d enHas d elfeTTeθ d uwreγ mεe beεDhum, eδwlen elkulhum m eluwm n ennar g enebδu, yewit aDu w esθeqqiymc ejjerreθ. yemenni θγaγet elli θewweθ eSSembeθ teδwel δ eddehreθ δ temeqqarθ θεebbe elqeεεeθ elkul.<verse eid="DAN 2:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="DAN 2:36" />θahen θirjiyθex. emme efesres exenne felles ey elmlek: <verse eid="DAN 2:36" /><verse number="37" style="v" sid="DAN 2:37" />cex δ elmlek n lemluwk, erreb n esme yucayex elmelk d elquδreθ d elεez d elmejδ, <verse eid="DAN 2:37" /><verse number="38" style="v" sid="DAN 2:38" />w elli εemren δiys leεbaδ d elhwayec n elqeεεeθ d iciciywen n esme, yuceyexθi y cex yegex δ eSSulTan felles elkul, cex eyendeγ iyxef elli yemmeg s uwreγ. <verse eid="DAN 2:38" /><verse number="39" style="v" sid="DAN 2:39" />w beεδex ettas elmemlxeθ xlaf eSγer n elmemlexθex, w elbeεεeδ elmemlxeθ teθθalet m enHas e θesselleT f elqeεεeθ elkul. <verse eid="DAN 2:39" /><verse number="40" style="v" sid="DAN 2:40" />w elbeεεeδ elmemlxeθ terrabeεθ teqSeH m uzzal, εlexaTer uzzal e ykesser yemHeq kul ciy. m sah uzzal yetkesser elmemlxeθe e θemHeq elmemlxaθ tiddiyn elkul. <verse eid="DAN 2:40" /><verse number="41" style="v" sid="DAN 2:41" />w emmax i θezriδ elli lebHaD n ikreεεen d iDuDan seg elfuxxar w lebHaD seg uzzal, m sah e θkuwn elmemlxeθ θemzuwn, yemenni θeqSeH m uzzal εlexaTer emmax i θezriδ uzzal yemsesr s elfuxxar. <verse eid="DAN 2:41" /><verse number="42" style="v" sid="DAN 2:42" />w εlexaTer iDuDan n ikreεεen lebHaD seg uzzal w lebHaD seg elfuxxar, e θkuwn elmemlxeθ δiys lebHaD qwan w lebHaD Dεaf. <verse eid="DAN 2:42" /><verse number="43" style="v" sid="DAN 2:43" />w max i θezriδ elli uzzal yemsesr s elfuxxar, meεnethe elli ecceεb n elmemlxaθdiyn msesren mεe beεDhum, yemenni ettemweHδenc emmax uzzal yettemsesric s elfuxxar. <verse eid="DAN 2:43" /><verse number="44" style="v" sid="DAN 2:44" />w g liyyam n lemluwke iyh ayeg erreb n esme elmemlxeθ eltxelliyc xlaS, w eltmerreqc y Hette ecceεb xlaf, usinc e θesHeq elmemlxaθdiyn elkul, w netteθ e θeqqiym diyme. <verse eid="DAN 2:44" /><verse number="45" style="v" sid="DAN 2:45" />θezriyδ zaδe elli θγaγet θuDe seg eddehreθ menγiyr ettilemmes afus, θemHeq uzzal d enHas d elfuxxar d elfeTTeθ d uwreγ, wah elmeεntes elli erreb yeεlem elmlek s mat δ yejre beεεeδ liyyemaθdiyn. tirjiyθ ettuSHiHθ w efesres δ eSSaδeq.<verse eid="DAN 2:45" /></para>
  <para style="s">elmlek e yjaze danyal</para>
  <para style="p">
    <verse number="46" style="v" sid="DAN 2:46" />elweqθes yuDe elmlek nebuwxeδneSSer f uδmes yesjeδ y danyal yeĎleb e segen elweεδeθ d elbxuwr. <verse eid="DAN 2:46" /><verse number="47" style="v" sid="DAN 2:47" />yen elmlek y danyal:&lt;&lt;errebbewwem δ erreb n lerbuwb b elHeq w δ erreb n lemluwk, w nette elli ykeccef lesrar εlexaTer θgeddeδ θekcefeδiδ esserre.&gt;&gt; <verse eid="DAN 2:47" /><verse number="48" style="v" sid="DAN 2:48" />ymejjeδ elmlek danyal yuces elhδaye egget yHuTTi f ecciyreθ n babel elkul, yerri δ emeqqar f elHukkemes elkul. <verse eid="DAN 2:48" /><verse number="49" style="v" sid="DAN 2:49" />yeĎleb danyal seg elmlek e yHuT cedrex d miycex d εebdeneγuw f elxeδmeθ n ecciyreθ n babel elkul. yemenni danyal yeqqiym g elqSer n elmlek.<verse eid="DAN 2:49" /></para>
  <chapter eid="DAN 2" />
  <chapter number="3" style="c" sid="DAN 3" />
  <para style="s">elmlek yeĎleb y eεbaδ n eSSembeθ n uwreγ</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 3:1" />yeSneε elmlek nebuwxeδneSSer eSSembeθ s uwreγ, eTTules settiyn δraε w elεerDes sette δraε, yHuTTi g teHmiylt n duwra g elwilayeθ n babel. <verse eid="DAN 3:1" /><verse number="2" style="v" sid="DAN 3:2" />usiyn yuzen elmlek ylemmeδ elwullay d elHukkam d imeqqaren d elεuqqal d imeqqaren n elxziyneθ d imuεelmen n ecceriyεeθ, d imeqqaren elkul elli g ecciyreθdiyn bac e δecnen eSSembeθ elli yegi. <verse eid="DAN 3:2" /><verse number="3" style="v" sid="DAN 3:3" />w max i mlemden ezzaθ n eSSembeθ bac e δecnen, <verse eid="DAN 3:3" /><verse number="4" style="v" sid="DAN 3:4" />yzeεweg iyjen seg yih n elmlek s eSSuwθ yeεle:&lt;&lt;eDelbe essiywem leεbaδ elli usiden seg temurθ elkul edukken luγaθ elkul <verse eid="DAN 3:4" /><verse number="5" style="v" sid="DAN 3:5" />elli max e θeslem eSSuwθ n elbuwq d ennay d elgitar d erbab d elbendiyr d elγiyDeθ d lenwaε n elmeεεuwn n temuwsiqθ elkul e θesjδem y eSSembeθ n uwreγ elli yegi elmlek n ebuwxeδneSSer. <verse eid="DAN 3:5" /><verse number="6" style="v" sid="DAN 3:6" />w elli lisejjeδc e yemmeHδef g elεafyeθ čeεel egget.&gt;&gt; <verse eid="DAN 3:6" /><verse number="7" style="v" sid="DAN 3:7" />max i sliyn leεbaδ elkul eSSuwθ n elmeεεuwn n temuwsiqθ elkul, sjeδen y eSSembeθ n uwreγ elli yegi elmlek.<verse eid="DAN 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 3:8" />emrqen lebHaD n ibebiliyyen qewDen s elyeHuwd. <verse eid="DAN 3:8" /><verse number="9" style="v" sid="DAN 3:9" />ennen y elmlek:&lt;&lt;e θedreδ ey elmlek diyme. <verse eid="DAN 3:9" /><verse number="10" style="v" sid="DAN 3:10" />cex ey elmlek teĎlebeδ: elli eysel eSSuwθ n elbuwq d ezzef d elgitar d erbab d elbendiyr d elγiyDeθ d lenwaε n elmeεεuwn n temuwsiqθ elkul eyesjeδ y eSSembeθ n uwreγ elli yegi elmlek nebuwxeδneSSer. <verse eid="DAN 3:10" /><verse number="11" style="v" sid="DAN 3:11" />w elli lisejjeδc e yemmeHδef g elεafyeθ čeεel egget. <verse eid="DAN 3:11" /><verse number="12" style="v" sid="DAN 3:12" />yemenni ellan iryazen δ iyhuwdiyyen θHuTTetten f elwilayeθ n babel, w nihnin cedrex d miycex d εebdeneγuw. Hqernex w elleεbiδenc errebbex w ellesjiδenc y eSSembeθ n uwreγ elli θegit.&gt;&gt;<verse eid="DAN 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 3:13" />yeθγeccec egget elmlek yeĎleb eddaγem cedrex d miycex d εebdeneγuw, eγδenten yetwali elmlek. <verse eid="DAN 3:13" /><verse number="14" style="v" sid="DAN 3:14" />yencetten: &lt;&lt;endre belHeq cedrex d miycex d εebdeneγuw xenyum elteqqilemc eθεebδem errebbiw w eθesjdem y eSSembeθ n uwreγ elli egixθ? <verse eid="DAN 3:14" /><verse number="15" style="v" sid="DAN 3:15" />ture δ θeslem y eSSuwθ n elbuwq d ennay d elgitar d erbab d elbendiyr d elγiyDeθ d lenwaε n elmeεεuwn n temuwsiqθ elkul, w max e θeslem e θesjδem y eSSembeθ elli egixθ. emme iδekan eltesjiδemc exenlewHe g elεafyeθ čeεel egget, w exenyetmenneε Hette erreb seg efesniyw.&gt;&gt; <verse eid="DAN 3:15" /><verse number="16" style="v" sid="DAN 3:16" />jewbenti cedrex d miycex d εebdeneγuw:&lt;&lt;muc lazem exenjaweb f elmuDuwεe ey elmlek. <verse eid="DAN 3:16" /><verse number="17" style="v" sid="DAN 3:17" />εlexaTer errebbenne elli nεebbeδ δiys eyged exenisuwfeγ seg elεafyeθ čeεel egget d ifesnex. <verse eid="DAN 3:17" /><verse number="18" style="v" sid="DAN 3:18" />w Hette exenimenneεc tesneδ elli nečin nεebbeδc errebbex w ensejjeδc y eSSembeθ n uwreγ elli θegit.&gt;&gt;<verse eid="DAN 3:18" /></para>
  <para style="s">eSHab n danyal θleθa e yemmeHkem fellasen s ujafi</para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 3:19" />yeθγeccec egget elmlek elmi yembeddel uδmes f cedrex d miycex d εebdeneγuw, yeĎleb bac e yeδwel eceεεel n elεafyeθ sebεe merraθ exθer n qebl. <verse eid="DAN 3:19" /><verse number="20" style="v" sid="DAN 3:20" />yeĎleb zade seg iryeznes elεuttay e qnen cedrex d miycex d εebdeneγuw e Hδfenten g elεafyeθ čeεel egget. <verse eid="DAN 3:20" /><verse number="21" style="v" sid="DAN 3:21" />elweqθes eqnenten u nihnin ireDen ibernas d iserwalen d elleHfaθ d edbac xlaf eHδfenten g elεafyeθ čeεel egget. <verse eid="DAN 3:21" /><verse number="22" style="v" sid="DAN 3:22" />w εlexaTer i yeTTef elmlek eSbiyH emmax i yenne qebl, yenγe elehlab n elεafyeθ iryezendiyn elli qamen cedrex d miycex d εebdeneγuw, <verse eid="DAN 3:22" /><verse number="23" style="v" sid="DAN 3:23" />wDan iryezendiyn letlaθe g elεafyeθ čeεel egget w nihnin δ imketfen.<verse eid="DAN 3:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="DAN 3:24" />g elweqθes yeθHeyyer egget elmlek nebuwxeδneSSer ybed fiyseε yenceδ elwezres:&lt;&lt;endre muc neHδef b elHeq tlaθe δ iryazen δ imketfen g elεafyeθ?&gt;&gt; jewbenti:&lt;&lt;wa ey elmlek.&gt;&gt; <verse eid="DAN 3:24" /><verse number="25" style="v" sid="DAN 3:25" />yen:&lt;&lt;yemenni neč zerre g erbεe δ iryazen δ imseyben egguwren g emmes n elεafyeθ lebas εliyhum, w uwδem n errabeε yetcebbeh y emersal seg lerbuwb.&gt;&gt;<verse eid="DAN 3:25" /></para>
  <para style="s">iryaz letlaθe mseyben emqedren</para>
  <para style="p">
    <verse number="26" style="v" sid="DAN 3:26" />w elbeεεeδ yeqreb nebuwxeδneSSer y elbab n elεafyeθ yen:&lt;&lt;ha cedrex d miycex d εebdeneγuw, ixδiymen n rebbi elli lennej, efγeθ tesδem!&gt;&gt; efγen seg emmes n elεafyeθ. <verse eid="DAN 3:26" /><verse number="27" style="v" sid="DAN 3:27" />emlemden elwullay d elHukkam d imeqqaren d iwziren n elmlek, ezren elli elquwweθ n elεafyeθ eltegi Hette ciy y iryazendiyn, w elteHriqc Hette δ ecceεreθ seg ixfewnensen, w ellembedlenc ibernasnensen w eltelsiqc δiysen erriyHeθ n elεafyeθ.<verse eid="DAN 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="DAN 3:28" />yen nebuwxeδneSSer:&lt;&lt;tbark elleh erreb n cedrex d miycex d εebdeneγuw, elli yuzen elmlayxeθes ysemneε ixeddemnes elli θweklen felles eεSan tuθleyθ n elmlek f elxeĎres, uwcen elbeδnensen y elεafyeθ bac e lεebδenc w elsejδwnc y erreb b xlaf errebensen. <verse eid="DAN 3:28" /><verse number="29" style="v" sid="DAN 3:29" />heδake εlac ture exennenne elli ayen seg timuwra elkul d luγaθ elkul edwi yuHec f erreb n cedrex d miycex d εebdeneγuw, emmebyen δ leĎraf w leHwecensen eδuwlen δ elγbaraθ. εlexaTer elyetged Hette erreb entisemneε emmax i yege errebbensen.&gt;&gt; <verse eid="DAN 3:29" /><verse number="30" style="v" sid="DAN 3:30" />eyendeγ yriygel elmlek elHal n cedrex d miycex d εebdeneγuw g elwilayeθ n babel.<verse eid="DAN 3:30" /></para>
  <chapter eid="DAN 3" />
  <chapter number="4" style="c" sid="DAN 4" />
  <para style="p">
    <verse number="1" style="v" sid="DAN 4:1" />seg elmlek nebuwxeδneser, y leεbaδ elkul seg lecεuwb d ellummaθ d elluγaθ elli g elεalem elkul. eslam fellawem. <verse eid="DAN 4:1" /><verse number="2" style="v" sid="DAN 4:2" />eferHe max exenxebre f ellayaθ d muεjzaθ elli yegiyneθ iyδi rebbi elεali.<verse eid="DAN 4:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="DAN 4:3" />ellayaθes ma ekberhum! w muεjzaθes ma eqwahum! elmelkes e yeqqiym diyme w eSSultanes e yeqqiym eljiyl beεεeδ eljiyl.<verse eid="DAN 4:3" /></para>
  <para style="s">tirjiyθ n nebuwxeδneSSer f eccejreθ</para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 4:4" />neč nebuwxeδneSSer kane imeθhenni g elHuciyw, imweffeq g elqaSriyw. <verse eid="DAN 4:4" /><verse number="5" style="v" sid="DAN 4:5" />elweqθes zriyγ tirjiyθ θqelqiyδ, tHeyriyδ w neč nεese g esririyw. <verse eid="DAN 4:5" /><verse number="6" style="v" sid="DAN 4:6" />eyendeγ eDelbe bac e yeddaγen elεuqqal elkul g babel bac e yfesren θirjiyθiyw. <verse eid="DAN 4:6" /><verse number="7" style="v" sid="DAN 4:7" />asδen iseHHaren d imejuwsiyyen d imunejmen, eHkiγasen θirjiyθiyw, w elgeddenc eyetfesren. <verse eid="DAN 4:7" /><verse number="8" style="v" sid="DAN 4:8" />g ellexxer yaδef f elle danyal elli ellesmes belTecaSSer m ellesm n errebbiw w δiys erruwH n lerbuwb diqeddiysen eHkiyγes θirjiyθiyw enγes: <verse eid="DAN 4:8" /><verse number="9" style="v" sid="DAN 4:9" />ha belTecaSSer siyδiys n iseHHaren, sliyγ elli δiyx erruwH n iqeddiysen w elyetteSεab fellax Hette ciy, fesriyδ tirjiyθe elli zrixt: <verse eid="DAN 4:9" /><verse number="10" style="v" sid="DAN 4:10" />zriyγ w neč nεese g esririyw, tay eccejreθ g emmes n elqeεεeθ teεle egget. <verse eid="DAN 4:10" /><verse number="11" style="v" sid="DAN 4:11" />tekbar eccejreθ teqwe yaweD elεelwes y esme w etmezre seg ellexxer n elqeεεeθ. <verse eid="DAN 4:11" /><verse number="12" style="v" sid="DAN 4:12" />lureqes bhaneθ w elγeltes egget, w δiys eče y leεbaδ elkul, seddu eTTelles eyeqqiym elhwayec n essewweθ, w g leεrefes eεececen izenniywen n esme w essis esθqaθen elli edderen elkul. <verse eid="DAN 4:12" /><verse number="13" style="v" sid="DAN 4:13" />&lt;&lt;w elweqθelli neč etteqiyγ w zerre g erruYeθe, yeggez fella elmlax δ eTTaher yetεus seg esme <verse eid="DAN 4:13" /><verse number="14" style="v" sid="DAN 4:14" />yzeεweg s eSSuwθ yeqwe: ebyeθ eccejreθdiyn tquSSem leεrefes. ferθeθ lureqes teksem γeltes tγ elbem elhweyc seg sedwes w izenniywen seg leεrefes. <verse eid="DAN 4:14" /><verse number="15" style="v" sid="DAN 4:15" />emme edjeθ elεeθgeθ d leεruwqes g elqeεεeθ θeqnemten s esselsleθ n uzzal d enHas g emmes n elHciyc n essewweθ, θedjemti e yellexs s enneδweθ n esme w elbeyes eykuwn d elhwayec n essewweθ δ elHciyc n elqeεεeθ, <verse eid="DAN 4:15" /><verse number="16" style="v" sid="DAN 4:16" />w e yembeddel ules seg uwl n elεebδ y uwl n elweHc elmi θεedden felles sebεe sniyn. <verse eid="DAN 4:16" /><verse number="17" style="v" sid="DAN 4:17" />elHukme wah eDlbent elmlayxe elli etεusen ennen felles y iqeddiysen, bac e snen elli edderen elli rebbi elεali iθuč essulTeθ f leεbaδ, elli nette yθučiθ y elli yexs w yetHuT felles leεbaδ imeθweDεen. <verse eid="DAN 4:17" /><verse number="18" style="v" sid="DAN 4:18" />θahen eyendeγ tirjiyθ elli zrixt neč elmlek nebuwxeδneSSer, w cex ha belTecaSSer en f efesres εlexaTer elεuqqal elkul g elmemlexθiyw elkul elgeddenc eθfesren. yemenni cex eθgeddeδ e tfesreδ εlexaTer δiyx erruwH n lerbuwb imqedsen.&gt;&gt;<verse eid="DAN 4:18" /></para>
  <para style="s">danyal e yfesser tirjiyθ teθθaniθ</para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 4:19" />yeqqiym danyal elli ellesmes belTecaSSer yeθHeyyer esseεεeθ yeqleq seg uxemmem, yennes elmlek:&lt;&lt;ha belTecaSSer, eθedjec exiqelleq la δ tirjiyθ w la δ efesres.&gt;&gt; yjewebθi belTecaSSer:&lt;&lt;la ya siydiy, eθmenniγ tirjiyθ y elli exγisenc w efesres y elεδewwex. <verse eid="DAN 4:19" /><verse number="20" style="v" sid="DAN 4:20" />eccejreθ elli θezritteθ etteεle etteqwe w i θaweD eTTules y esme w etmezre seg elqeεεeθ elkul, <verse eid="DAN 4:20" /><verse number="21" style="v" sid="DAN 4:21" />elli lureqes bhaneθ w elγeltes egget w δiys eče y elkul, w sedwes etqiymen elhwayec n essewweθ, w g leεrefes εemren izenniywen n esme <verse eid="DAN 4:21" /><verse number="22" style="v" sid="DAN 4:22" />netteθ δ cex ey elmlek. εlexaTer cex θekbareδ teqwiyδ terni elqewθex elmi θiyweD y esme w eSSulTanex y ellexxer n elqeεεeθ. <verse eid="DAN 4:22" /><verse number="23" style="v" sid="DAN 4:23" />max i θezriyδ elli elmlax eTTaher yetεus yeggez seg esme yen: ebyeθ eccejreθ temeHqemteθ, yemenni edjeθ elεeθgeθes d leεruwqes g elqeεεeθ teqnemteθ s uzzal d enHas g emmes n elHciyc n essewweθ θedjemti eyellexs s enneδweθ n esme, w elbeyes eykuwn d elhwayec n essewweθ elmi θεedden felles sebεe sniyn. <verse eid="DAN 4:23" /><verse number="24" style="v" sid="DAN 4:24" />wah efesres ey elmlek w wah eyendeγ elHukm n rebbi elεali fellax ha siydiy elmlek: <verse eid="DAN 4:24" /><verse number="25" style="v" sid="DAN 4:25" />δ θemgelbeδ lebεiyδ f leεbaδ teεmreδ d elhwayec n essewweθ tečeδ elHciyc m ifunasen tellexseδ s enneδweθ n esme, θεedden fellax sebεe sniyn elmi θesneδ elli rebbi elli lennej iθuč essulTeθ f elmemlxeθ n leεbaδ w yθučiyθ y elli yexs. <verse eid="DAN 4:25" /><verse number="26" style="v" sid="DAN 4:26" />emme elli yeĎleb elmlax bac e yeqqiym seg elεeθgeθ n eccejreθ d leεruwqes, elmeεntes elli elmelx δ yeqqiym y cex beεεeδ n elli e θesneδ elli eSSulTan y erreb n esme. <verse eid="DAN 4:26" /><verse number="27" style="v" sid="DAN 4:27" />heδake εlac exenSHe ey elmlek bac e θkefreδ f elxĎeyax s eSlaH tegeδ erreHmeθ f iqelliylen, bac e yeTwal elhnax. eθmenniγ eθeqebleδ enSeyeHe.&gt;&gt;<verse eid="DAN 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="DAN 4:28" />wah elkul ySar y nebuwxeδneSSer elmlek. <verse eid="DAN 4:28" /><verse number="29" style="v" sid="DAN 4:29" />beεεeδ i θεeddan θnac chuwr ykan yegguwr f esqef n elqSer n babel, <verse eid="DAN 4:29" /><verse number="30" style="v" sid="DAN 4:30" />yen, &lt;&lt;enzi mesmeHha babel elli bniγt s elquδerθiyw d elmejδiyw eγext δ elεSmeθ n elmelxiyw.&gt;&gt; <verse eid="DAN 4:30" /><verse number="31" style="v" sid="DAN 4:31" />w elweqθ elli edwiye elyuwc g imis, yeggez eSSuwθ seg esme:&lt;&lt;y cex ey elmlek nebuwxeδneSSer enne: yemreq fellax elmelx, <verse eid="DAN 4:31" /><verse number="32" style="v" sid="DAN 4:32" />w e θemgelbeδ seg jar leεbaδ teεmreδ d elhwayec n essewweθ tečeδ elHciyc m ifunasen, θεeddan fellax sebεe sniyn elmi θesneδ elli erreb elli lennej iθuč essulTeθ f elmemlxeθ n leεbaδ w yθučiθ y elli yexs.&gt;&gt; <verse eid="DAN 4:32" /><verse number="33" style="v" sid="DAN 4:33" />g elweqθdiyn yemmeHkem f nebuwxeδneSSer, yemgelleb seg emmes n leεbaδ, yeč elHciyc m ifunasen, yellexs elbeδnes s enneδweθ n esme, elmi yeTwal ezewes m erriyc n ennesr w iccernes m iccaren n izenniywen.<verse eid="DAN 4:33" /></para>
  <para style="s">nebuwxeδneSSer eyemdeH rebbi</para>
  <para style="p">
    <verse number="34" style="v" sid="DAN 4:34" />yen elmlek nebuwxeδneSSer:&lt;&lt;w beεεeδ iδuqan sebεe sniyn qame ixfiyw y esme yerjεiyδ elεeqliyw, berke y rebbi elli lennej, sebHe εeĎme elli yedder diyme, elli eSSulTanes diyme w elmelkes s eljiyl y eljiyl, <verse eid="DAN 4:34" /><verse number="35" style="v" sid="DAN 4:35" />w elli yεemmer g elqeεεeθ elkul yetmeHseb Hette ciy, w yetteSSerraf g eleεsaker nesme d elli εemren g elqeεεeθ emmax i yexs, w elyetged Hette Hed esyen mat i ttegeδ <verse eid="DAN 4:35" /><verse number="36" style="v" sid="DAN 4:36" />g elweqθdiyn yerjεiyδ elεeqliyw, yemmerriδ elmelxiyw d elmejδiyw d elqeδriyw, eĎlebniyδ elwezraw d imeqqerniyw erniyδ y elmelxiyw, yekbar ecceniyw exθer n qebl. <verse eid="DAN 4:36" /><verse number="37" style="v" sid="DAN 4:37" />w ture neč elmlek nebuwxeδneSSer, etsebHe w etεeĎme w etmejδe g elli ymellex esme. elli yθeg δiys elkul δ elHeq w ebriδes eddiyc elHiyleθ, w eyged eyδul elli γers ennefxeθ.<verse eid="DAN 4:37" /></para>
  <chapter eid="DAN 4" />
  <chapter number="5" style="c" sid="DAN 5" />
  <para style="s">emensi n belceSSer elmlek</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 5:1" />yeg belceSSer elmlek emensi δ emeqqar y elf seg imeqqernes yesw ezzeθensen ecrab. <verse eid="DAN 5:1" /><verse number="2" style="v" sid="DAN 5:2" />w elweqθ elli ykan belceSSer ymeddi g ecrab, yeĎleb eseddaγen elmeεεuwn n uwreγ d elfeTTeθ elli yessufeγθ daddes nebuwxeδneSSer seg elheykel elli g urceliym bac e yesw essis nette d imeqqernes d elwecunes timeTTutines. <verse eid="DAN 5:2" /><verse number="3" style="v" sid="DAN 5:3" />eyendeγ yeHDer elmeεεuwn n uwreγ elli yemsuwfeγ seg elheykel n rebbi eswen essis elkul, <verse eid="DAN 5:3" /><verse number="4" style="v" sid="DAN 5:4" />swiyn ecrab sebHen y elYilahaθ n uwreγ d elfeTTeθ d enHas d uzzal d elluH d elkurδ.<verse eid="DAN 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 5:5" />elweqθes effeγen iDuDan n efuws n elεebδ tari ezzaθ n elgaz f erriys n elHiyĎ n elqSer n elmlek, w elmlek ynedzi y efus elli yθari. <verse eid="DAN 5:5" /><verse number="6" style="v" sid="DAN 5:6" />yembeddel uδmes yeθqelleq egget yefcel erεcen ifednes, <verse eid="DAN 5:6" /><verse number="7" style="v" sid="DAN 5:7" />ynabe s eSSuwθ yeεle e suδfen imejuwsiyyen d imunejmen d elεuqqal. yen elmlek y elεuqqal g babel:&lt;&lt;elli e yeqre θiraye yfesrit e yireD edbac sellerjwan, d teglet n uwreγ g θexrumtes, yeTTef elblaSeθ teθθalet g elmemlxeθ.&gt;&gt; <verse eid="DAN 5:7" /><verse number="8" style="v" sid="DAN 5:8" />elweqθes eδfen elεuqqal elkul, w eliged Hette iyjen essisen e yeqre θiraye ziyγ e ttifesser y elmlek. <verse eid="DAN 5:8" /><verse number="9" style="v" sid="DAN 5:9" />yerni elqleq n elmlek belceSSer yeθbeddel uδmes, w imeqqernes eqelqen zaδe.<verse eid="DAN 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="DAN 5:10" />θesl yemmes n elmlek s elli yejre y elmlek d imeqqernes, taδef y tezeqqe n umensi ten:&lt;&lt;e θedreδ diyme ey elmlek eθeqelqec w eθeθHeyrec. <verse eid="DAN 5:10" /><verse number="11" style="v" sid="DAN 5:11" />g elmemlexθex eryaz δiys erruwH n iqeddiysen, w g liyyam n daddex ufiyn γers elfehm d eδke d elHikmeθ tebhe m elHikmeθ n elYilaheθ. heδake εlac δaddex elmlek nebuwxeδneSSer yegiθ emeqqer n iseHHaren d imejuwsiyyen d iεerrafen d imunejmen. <verse eid="DAN 5:11" /><verse number="12" style="v" sid="DAN 5:12" />danyal wah isemmaθi elmlek belTecaSSer γers elHekmeθ d elεaqel δ emeqqar g umiyri n lelγaz d efesser n tirjiyθin, w ture nabeθi bac e xifesser θiraye&gt;&gt;.<verse eid="DAN 5:12" /></para>
  <para style="s">danyal eyfesser tiyre</para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 5:13" />eyendeγ yaseδ danyal twali elmlek, yennes elmlek:&lt;&lt;endre δ cex danyal elli yuseδ seg bni yehuwδa elli w emmerhnen elli yuγeδten dadde elmlek seg yehuwδa? <verse eid="DAN 5:13" /><verse number="14" style="v" sid="DAN 5:14" />esliyγ elli δiyx erruwH n lerbuwb, w yemmaf δiyx elfehm d eδke d elHekmeθ δ temeqqerθ. <verse eid="DAN 5:14" /><verse number="15" style="v" sid="DAN 5:15" />uδefen tweliyw elεuqqal d imejuwsiyyen bac e yeqran θiraye usinc e yennen f efesres w elgeddenc. <verse eid="DAN 5:15" /><verse number="16" style="v" sid="DAN 5:16" />yemenni esliyγ elli cex etgeddeδ efesser d emiyri n elmecakel, w ture iδekan eθgeddeδ e yθeqriyδ θiraye tendi f ufesres e θirDeD edbac s ellerjwan d teglet n uwreγ g θexrumtex, teTfeδ elblaSeθ teθθalet g elmemlxeθ.&gt;&gt;<verse eid="DAN 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 5:17" />yen danyal ezzaθ n elmlek:&lt;&lt;edj ewcex y cex, tuwceδ elhδayex y elγiriyw. emme θiyre e xetteqriyγ enγax f ufesres: <verse eid="DAN 5:17" /><verse number="18" style="v" sid="DAN 5:18" />ey elmlek, yuce erreb elεali y δaddex nebuwxeδneSSer elmelx elkul d elquwweθ d elmejδ d elεez. <verse eid="DAN 5:18" /><verse number="19" style="v" sid="DAN 5:19" />w s elqewθes elli rebbi yucayes ykan ecceεb elkul d ellummaθ elkul d elluγaθ elkul θukkaδen essis, w ykan yneq elli yexs yedj elli yexs, ysuwli elli yexs ysuggez elli yexs. <verse eid="DAN 5:19" /><verse number="20" style="v" sid="DAN 5:20" />emme max i yeqSaH ules texyab ennefses yeθjebber yeggez seg elεerc n elmelxes yemmekkes felles eljlales, <verse eid="DAN 5:20" /><verse number="21" style="v" sid="DAN 5:21" />yemgelleb seg jar leεbaδ yeδwel m elhayceθ, yeεmer d iγyal n essewweθ, yeč elHciyc m ifunasen yellexs elbeδnes s enneδweθ n esme, elmi yessen elli erreb elεali iθuč essulTeθ f elmemlxeθ n leεbaδ yHuT felles elli yexs. <verse eid="DAN 5:21" /><verse number="22" style="v" sid="DAN 5:22" />w cex e belceSSer memmis, reγm elli fibalek s kul ciy elterric elbalex, <verse eid="DAN 5:22" /><verse number="23" style="v" sid="DAN 5:23" />emme θqameδ elxecmex f erreb n esme, teγδeδ twalix elmeεεuwn n elheykeles tesweδ δiys ecrab cex d imeqqernex d elwecunex d timeTTuθinex xeddeminex. tsebHeδ y lerbuwb n elfeTTeθ d uwreγ d enHas d uzzal d elluH d elkurδ, w netteθ elli eltnedzi w eltsel w eltessiyn. emme erreb elli g efuses erruHex d ibriδnex elkul etεeĎmec. <verse eid="DAN 5:23" /><verse number="24" style="v" sid="DAN 5:24" />heδakeεlac yuzenex efusδiyn elli turiyex θiraye. <verse eid="DAN 5:24" /><verse number="25" style="v" sid="DAN 5:25" />w θah θiyre elli temmari: mena mena teqiyl w fersiyn <verse eid="DAN 5:25" /><verse number="26" style="v" sid="DAN 5:26" />mena elmeεneha yemmeHseb εlexaTer erreb yeHseb leyyam n elmelxex ysuqaθen. <verse eid="DAN 5:26" /><verse number="27" style="v" sid="DAN 5:27" />teqiyl elmeεneha temmuwzen εlexaTer erreb yuzenex s elmiyzan teffeγeδ δ ennaqez. <verse eid="DAN 5:27" /><verse number="28" style="v" sid="DAN 5:28" />fersi elmeεneha temzuwn εlexaTer erreb eyzun elmemlexθex jar maday d fares:<verse eid="DAN 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="DAN 5:29" />yeĎleb belceSSer e DirDen y danyal edbac s ellerjwan d teglet n uwreγ g θexrumtes nebenti eθθaleθ g elmemlxeθ.<verse eid="DAN 5:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="DAN 5:30" />g iDes yemmeneγ belceSSer elmlek n ibebiliyyen. <verse eid="DAN 5:30" /><verse number="31" style="v" sid="DAN 5:31" />yureθ elmemlxeθ daryuws elmadiy, w nette δ emmis n eθniyn w settiyn esne.<verse eid="DAN 5:31" /></para>
  <chapter eid="DAN 5" />
  <chapter number="6" style="c" sid="DAN 6" />
  <para style="s">leεδe n danyal eθethmen</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 6:1" />yexθar daryuws e yHuT miyye w εicriyn elwullay f elmemlxeθ elkul, <verse eid="DAN 6:1" /><verse number="2" style="v" sid="DAN 6:2" />w yHuT fellasen tlaθe δ elwezre iyjen essisen δ danyal, esennawyen elHsab bac e tDurrenc elmlek. <verse eid="DAN 6:2" /><verse number="3" style="v" sid="DAN 6:3" />yeγleb danyal elwezre d elwullay εlexaTer ykan δiys erruwH tebhe, elmi yfekker elmlek δ θiHuT δ elHakem f elmemlexθes elkul. <verse eid="DAN 6:3" /><verse number="4" style="v" sid="DAN 6:4" />eqqiymen elwezre d elwullay etHewmen g elγeldeθ f danyal, yemenni elluwfin felles Hette ciy, w elleTTiyfen felles Hette elγeldeθ εlexaTer ykan δ eθθiyqeθ. <verse eid="DAN 6:4" /><verse number="5" style="v" sid="DAN 6:5" />ennen:&lt;&lt;w entaf f danyal elγeldeθ kan max enenzi g ecceriyεeθ n errebbes.&gt;&gt; <verse eid="DAN 6:5" /><verse number="6" style="v" sid="DAN 6:6" />eyendeγ emlemden γer elmlek ennanes:&lt;&lt;e θedreδ diyme ey elmlek daryuws, <verse eid="DAN 6:6" /><verse number="7" style="v" sid="DAN 6:7" />mcawren elwezre elkul n elmemlxeθ d elHukkam d elwullay d elquDDay d imeqqaren elli yelzem e θessuwfγeδ elHukm n elmlek, teDelbeδ eĎlab yetmerriyc. g elHukme eθenneδ el tleθiyn yuwm iδa kan ijen eyeĎleb elHajeθ seg erreb ziyγ seg elεebδ umuc essix e yemmeHδef g eHriyc n leSyuwδ: <verse eid="DAN 6:7" /><verse number="8" style="v" sid="DAN 6:8" />w ture ey elmlek eεlen ellemr elyettembeddilc, emmax ettembeddilc ecceriyεeθ n maday d fares elli elyetteθεeddi felles Hed.&gt;&gt; <verse eid="DAN 6:8" /><verse number="9" style="v" sid="DAN 6:9" />yessuwfeγ elmlek ellemr yemmari.<verse eid="DAN 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="DAN 6:10" />max i yesle danyal f eSeHHeH n emexTuwT, yerjeε y elHuwces, w kanen ecbabex n θγurfettes miyren y ecciyreθ n urceliym, w ykan yrekkeε f ifednes tlaθ merraθ g as w yetzalle yHemmeδ g errebbes emmax yθeg qebl. <verse eid="DAN 6:10" /><verse number="11" style="v" sid="DAN 6:11" />esδen iryazendiyn tweliys efent yetzalle w yetmelleg y errebbes. <verse eid="DAN 6:11" /><verse number="12" style="v" sid="DAN 6:12" />elweqθes emerqen y elmlek eHkanes f elli yejre, ennanes:&lt;&lt;muc θessufγeδ ellemr el tleθiyn yuwm iδa kan ijen eyeĎleb elHajeθ seg erreb ziyγ seg elεebδ umuc essix e yemmeHδef g eHriyc n leSyuwδ?&gt;&gt; yjaweb elmlek:&lt;&lt;elli θeqqarem δiys SHiyH, elli eĎlbexθ nette m ecceriyεeθ n maday d fares w elyetged Hette Hed eθibeddel.&gt;&gt; <verse eid="DAN 6:12" /><verse number="13" style="v" sid="DAN 6:13" />ennanes:&lt;&lt;danyal elli seg bniy yehuwδa yeHqerex cex d eSeHeHex, εlexaTer yetzalle tlaθ merraθ g as w yĎelleb g errebbes.&gt;&gt; <verse eid="DAN 6:13" /><verse number="14" style="v" sid="DAN 6:14" />max i yesle elmlek yeHzen egget yebδe yexs e ysemneε danyal, yeTTef eSHiyH el weggaz n θefuθ. <verse eid="DAN 6:14" /><verse number="15" style="v" sid="DAN 6:15" />w max i mlemden iryazendiyn γer elmlek ennen:&lt;&lt;tesseneδ ey elmlek elli ecceriyεeθ n maday d fares netteθ elli kul ellemr ziyγ δ elHukm eθyessuwfeγ elmlek yettembeddilc.&gt;&gt;<verse eid="DAN 6:15" /></para>
  <para style="s">danyal g eHriyc n leSyuwδ</para>
  <para style="p">
    <verse number="16" style="v" sid="DAN 6:16" />yeĎleb elmlek e γδen danyal eHδfent g eHriyc n leSyuwδ. yen elmlek y danyal:&lt;&lt;eθmenniγ errebbex elli diyme θεebδeδ δiys exisemneε.&gt;&gt; <verse eid="DAN 6:16" /><verse number="17" style="v" sid="DAN 6:17" />eγδen elHegfeθ HuTTenteθ f iymi n eHriyc, yeĎbeεθ elmlek s eTTabεes d eTTabeε n imeqqernes bac e lyettembeddilc elHukm f danyal. <verse eid="DAN 6:17" /><verse number="18" style="v" sid="DAN 6:18" />yrewweH elmlek y elqeSres yεedde iDes yzuwm, w ykezzem w yerwel felles enuddem.<verse eid="DAN 6:18" /></para>
  <para style="s">danyal elyemmijemc w elmlek eytab</para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 6:19" />g elfjer yekker elmlek yemreq yθezzel y eHriyc n leSyuwδ, <verse eid="DAN 6:19" /><verse number="20" style="v" sid="DAN 6:20" />w max i yeqreb seg eHriyc ynabe f danyal s eSSuwθ Hziyn yennes:&lt;&lt;ha danyal elεebδ n erreb elli yedder, zeεme erreb elli θεebδeδ δiys diyme yged ysemenεex seg leSyuwδ?&gt;&gt; <verse eid="DAN 6:20" /><verse number="21" style="v" sid="DAN 6:21" />yjewebθi danyal:&lt;&lt;eθedreδ diyme ey elmlek, <verse eid="DAN 6:21" /><verse number="22" style="v" sid="DAN 6:22" />errebbiw yuzeni elmlexes ySekker imewwen n leSyuwδ, w eyyegin Hette ciy εlexaTer emmef ellegiγ Hette ciy ezzeθ erreb d ezzeθex cex ey elmlek. <verse eid="DAN 6:22" /><verse number="23" style="v" sid="DAN 6:23" />yefreH elmlek egget, yeĎleb eθessuwfγen seg weHriyc, yeffeγ lebas εliyh, εlexaTer yemmen s errebbes. <verse eid="DAN 6:23" /><verse number="24" style="v" sid="DAN 6:24" />yeĎleb elmlek eddaγen iryazendiyn elli themen danyal eHδfenten g eHriyc n leSyuwδ, nihnin d idrarinsen d elwacunensen, w γiyr i DiwDen g eHriyc hjemen fellasen leSyuwδ ebleεnasen iγsenensen.<verse eid="DAN 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 6:25" />w elbeεεeδ yuri daryuws elmlek y leεbaδ elkul seg ellummaθ elkul d elluwγaθ elkul:&lt;&lt;eθeqqiymem salmiyn. <verse eid="DAN 6:25" /><verse number="26" style="v" sid="DAN 6:26" />essufγe ellemr y leεbaδ g elmemlexθiyw elkul ekδen seg erreb n danyal, εlexaTer</para>
  <para style="q" vid="DAN 6:26">nette elli yedder diyme elmelxes liweqqiyc w eSSulTanes diyme.<verse eid="DAN 6:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="DAN 6:27" />nette elli yessemnaε w yetnejje yθeg elmuεjzaθ d elεjayeb g esmawaθ d elqeεεeθ, w nette elli ysemneε danyal seg imewwen n leSyuwδ.&gt;&gt; <verse eid="DAN 6:27" /><verse number="28" style="v" sid="DAN 6:28" />eyendeγ rebbiy eθyeg iθiged danyal g essukkes n elmlek daryuws we elmlek kuwrec g fares<verse eid="DAN 6:28" /></para>
  <chapter eid="DAN 6" />
  <chapter number="7" style="c" sid="DAN 7" />
  <para style="s">tirjiyθin n danyal f erbεe δ elhwayec</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 7:1" />g usukkes iglewwel n belceSSer elmlek n babel, ykan danyal f esrires, yettirjiyθ tirjiyθ yezr erruYeyeθ g elbales. yari tirjiyθ yxebber fellas. <verse eid="DAN 7:1" /><verse number="2" style="v" sid="DAN 7:2" />yen:&lt;&lt;tay zriyγ g enudmiyw g δeggiyδ, esδen eDuwwaθ seg eccireθ elkul ehjemen f elbHer emeqqar, <verse eid="DAN 7:2" /><verse number="3" style="v" sid="DAN 7:3" />elyen seg elbHer erbεe δ elhwayec δ imeqqaren ečebbehnec y beεDhum. <verse eid="DAN 7:3" /><verse number="4" style="v" sid="DAN 7:4" />iglewwel m eSSiyδ w γers ifriywen n ennesr. w elweqθ elli neč nedziyγ δiys emmeqlεen ifriwnes, yembeεεeδ f elqeεεeθ ybed f ikreεnes m elεebδ, yemmuces uwl n elεebδ <verse eid="DAN 7:4" /><verse number="5" style="v" sid="DAN 7:5" />tay elhayceθ xlaf ečebbeh y eddeb, θbed f iyjen n eljneb w jer isennuwqenes tlaθe δ ixsan n eDluwε. yemmennes: ekker eč exsuwm egget. <verse eid="DAN 7:5" /><verse number="6" style="v" sid="DAN 7:6" />w elbeεεeδ nziyγ eSbiyH ezre iyjen xlaf m ennemr, γers erbεe δ ifriywen m ifriywen uciciw f exrumes. w ykan y elhayceθ erbεe δ ixfawen w yemmuces eSSulTan. <verse eid="DAN 7:6" /><verse number="7" style="v" sid="DAN 7:7" />ezre g θirjiyθiyw g δeggiyδ, tay elhayceθ terrabeεθ δ tessekkaδ teqwe egget. w γers isennuwqen δ imeqqaren egget seg uzzal, w θkan ettet w tseHHeq w treffes g elbaqi s ikreεnes. w netteθ muc m elhwayec elli qebles, w γers εecre δ legruwn. <verse eid="DAN 7:7" /><verse number="8" style="v" sid="DAN 7:8" />θebθe g legruwn, ezre elgren xlaf δ emezyan yuli jerasen, emmeqlεen tlaθe δ legruwn seg imezwaren elli ezzeθes, effeγneθ g elgrendiyn θiTTawin m θiTTawin n elεebδ d iymi elli yetteθfuxar.<verse eid="DAN 7:8" /></para>
  <para style="s">ezre f elli yedder diyme</para>
  <para style="p">
    <verse number="9" style="v" sid="DAN 7:9" />w neč nedziyγ, emmenSben leεruwc, yeqqiym elli yedder diyme yireD edbac δ imellalen m ettelj, w ezewes m teDufθ δ tundifθ, w elεerces δ elehlab n elεefyeθ, w elεejlaθ n elεerces δ elεefyeθ čeεεel. <verse eid="DAN 7:9" /><verse number="10" style="v" sid="DAN 7:10" />w seg ezzeθes yθeffeγ w yθezzel essuf n elεefyeθ w δ laluf d laluf xedmen elli yedder diyme w bedden jar ifesnes δ imelyan. eqqiymen elquDDay emmiyren imujelden. <verse eid="DAN 7:10" /><verse number="11" style="v" sid="DAN 7:11" />w kane zerre w selle g edwi elli yetteθfuxar w elli yeqqar δiys elgren, elmi θemmenγ elhayceθ terrabeεθ yemmemHeq elbeδnes yemmuwc y elεafyeθ. <verse eid="DAN 7:11" /><verse number="12" style="v" sid="DAN 7:12" />emme elhwayec θiddiyn yemmunkes eSSulTanes, yemenni yemmuces eddar δ iTwiyl y elweqθ δ imεeyyen.<verse eid="DAN 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 7:13" />w zriyγ g enεesiyw g δeggiddiyn, emmax bnaδem yuseδ f esHab n ejenne, yeqreb y elli yedder diyme, yemqerreb tweliys. <verse eid="DAN 7:13" /><verse number="14" style="v" sid="DAN 7:14" />yemmuces eSSulTan d elmejδ d elmelx w sah e θeεbδen leεbaδ seg ellummaθ elkul d elluwγaθ elkul w eSSulTanes e ykuwn diyme w elimerreqc, w elmelxes yetteθεeddiyc felles elweqθ.<verse eid="DAN 7:14" /></para>
  <para style="s">efesser n erruYyeθ</para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 7:15" />&lt;&lt;eθDaq ennefsiyw neč danyal yqelqiyδ ezraw g enudmiyw, <verse eid="DAN 7:15" /><verse number="16" style="v" sid="DAN 7:16" />eqrbe y iyjen seg elli bedden encδexθi f elHqiyqeθ n wah elkul, yenniδ f efesser n weδiyn elkul. <verse eid="DAN 7:16" /><verse number="17" style="v" sid="DAN 7:17" />wah elmeεntes elli elhweyecδiyn lerbεe θimeqqarin nihenti erbεe δ lemluwk δ efγen y elqeεεeθ, <verse eid="DAN 7:17" /><verse number="18" style="v" sid="DAN 7:18" />emme elbeεεeδ eddasen iqeddiysen n erreb elli lennej yemmawi elmelk etwelinsen yemmawi diyme y diyme.&gt;&gt; <verse eid="DAN 7:18" /><verse number="19" style="v" sid="DAN 7:19" />&lt;&lt;w kane exse esne elHqiyqeθ n elhayceθ terrabeεθ elli eltkenc m elhwayec θiddiyn, w θkan tessekaδ egget, w γers isennuqen seg uzzal, w iccernes seg enHas, w terfes tsHeq elbaqi s ikreεnes, <verse eid="DAN 7:19" /><verse number="20" style="v" sid="DAN 7:20" />w f legruwn elεecre elli g ixfes, zade f elgren elli yekbar uDan seg ezzeθes tlaθe δ legruwn, w ykan γers TiTTawin d iymi yetteθfuxar, w elmenDres ekber n iddiyn. <verse eid="DAN 7:20" /><verse number="21" style="v" sid="DAN 7:21" />enziyγ y elgren yetHarab g iqeddiysen w yγellebθen. <verse eid="DAN 7:21" /><verse number="22" style="v" sid="DAN 7:22" />yemenni yuseδ elli yedder diyme, yeHkem s elHeq y iqeddiysen n erreb elεali, w yiweD elweqθ elli yelzem eHazen δiys elmelk.<verse eid="DAN 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="DAN 7:23" />yfesriδ elmeεneε yenniyδ: elhayceθ terrabeεθ e θkuwn elmemlxeθ terrabeεθ f elqeεεeθ, w eθkun muc m elmemlkaθ tiddiyn, usinc e θeč elqeεεeθ elkul terfest tesHeqt. <verse eid="DAN 7:23" /><verse number="24" style="v" sid="DAN 7:24" />w εecre δ legruwn elli δ efγen seg elmemlxeθdiyn, nihnin εecre δ lemluwk, w elbeεeδensen edyes elmlek xlaf muc m nihnin usinc e ysender tlaθe δ lemluwk, <verse eid="DAN 7:24" /><verse number="25" style="v" sid="DAN 7:25" />usinc ayen edwi f erreb yeθselleT iqeddisnes, w yeθHawel δ ybeddel luqaθ d ecceriyεeθ, w δ mselmen iqeddiysen y ifesnes y tlaθe sniyn d ezyen. <verse eid="DAN 7:25" /><verse number="26" style="v" sid="DAN 7:26" />w elbeεεeδ eqqiymen elquDDay, usinc e yemmekkes eSSulTanes yemmemHeq diyme. <verse eid="DAN 7:26" /><verse number="27" style="v" sid="DAN 7:27" />yemmuwc elmelk d eSSulTan d elmejδ n lemluwk elkul elli eddu esme y ecceεb n iqeddiysen n erreb elεali, w δ ykuwn elmelkensen diyme, exδmenten eSSulTanaθ elkul eslnasen. <verse eid="DAN 7:27" /><verse number="28" style="v" sid="DAN 7:28" />eldah e yuwqe elli zrixθ yqelqi, ybedli uδmiyw eHfĎe wah elkul g uliyw.&gt;&gt;<verse eid="DAN 7:28" /></para>
  <chapter eid="DAN 7" />
  <chapter number="8" style="c" sid="DAN 8" />
  <para style="s">ezre n danyal f elkebc d ijδeε</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 8:1" />g usukkes eθθaleθ seg elεaheδ n elmlek belceSSer zriyγ neč danyal tirjiyθin xlaf. <verse eid="DAN 8:1" /><verse number="2" style="v" sid="DAN 8:2" />zriyγ imeniyw g cuwcan elεaSmeθ n elwilayeθ n εilam, w kane bedde f eccefeθ n esuwf n ulay. <verse eid="DAN 8:2" /><verse number="3" style="v" sid="DAN 8:3" />qame TiTTawiniyw lennej tay ezre elkebc ybed f eccefeθ n esuwf w γers sen δ legruwn εlan egget, iyjen eεle n wissen, w elli yeεle yenbeθ beεδes <verse eid="DAN 8:3" /><verse number="4" style="v" sid="DAN 8:4" />w zriyγ elkebc yneddeH y elγerb d elcemal d eljenuwb, w elibed ezzeθes Hette elhayceθ yeg elli yexs yeδwel δ emeqqar.<verse eid="DAN 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 8:5" />w elweqθ elli neč etθebθe, tay zriyγ ijδeε yuseδ seg elγerb yeθεedde f uwδem n elqeεεeθ elkul minγiyr ettilemmes. w ykan γers elgren yetban belgde jar TiTTawines. <verse eid="DAN 8:5" /><verse number="6" style="v" sid="DAN 8:6" />yuseδ yetwali elkebc elli γers sen δ legruwn w elli ykan ybed f eccefeθ n esuwf yehjem felles s elγuc δ emeqqar. <verse eid="DAN 8:6" /><verse number="7" style="v" sid="DAN 8:7" />ezrexθi yiweD yetwali elkebc δ imeθγecc yendeHθi ykesres legrunes lessen. w eligedc elkebc eybed ezzeθes, yessenderθi f elqeεεeθ yerfesθ, w eliged Hed e θisemneε seg efuses. <verse eid="DAN 8:7" /><verse number="8" style="v" sid="DAN 8:8" />yekbar ijδeε egget. w max i yeqwe yerrez elgren emeqqar, efγen seg sedwes erbεe δ legruwn etbanen belgde δ imeθlefθen y ecciyraθ lerbεe.<verse eid="DAN 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="DAN 8:9" />yeffeγ seg iyjen seg legruwn lerbεe elgren δ emezyan, w elbeεεeδ yebδe yettekbar egget y ecciyreθ n eljenuwb d eccerq d temurθ tebehheyθ. <verse eid="DAN 8:9" /><verse number="10" style="v" sid="DAN 8:10" />yekbar Hette f eljiyc n esme, yessender f elqeεεeθ lebHaD n eljiyc d elkwakeb yerfesθen. <verse eid="DAN 8:10" /><verse number="11" style="v" sid="DAN 8:11" />yekbar imenes Hette f emeqqar n eljiyc yeεni erreb, yeksas θimeHreqθ n diyme ydennes elmeqdses yemHeqθ, <verse eid="DAN 8:11" /><verse number="12" style="v" sid="DAN 8:12" />meni ykanen leεbaδ tegen g elmeεSyeθ g elεuδ elli eqerben θimeHreqθ n diyme, ysuggez eddiyn n elHeq f elqeεεeθ. yenjeH elgren g elli yegi elkul, <verse eid="DAN 8:12" /><verse number="13" style="v" sid="DAN 8:13" />esle elmlax d eTTaher yeδukke w elmlax d eTTaher xlaf ynecceδ δiys: el lemmi eyeqqiym elli zerre δiys g tirjiyθ? el lemmi eθeqqiym elmeεSyeθ g elεuwD n θimeHreqθ n diyme? w ellemmi eyemmerfes elheykel d eljiyc? <verse eid="DAN 8:13" /><verse number="14" style="v" sid="DAN 8:14" />yjewebi: elfiyn w tlaθe miyye dugges d eggiyd, usinc e yerjeε elmeqdes y Taherθes.<verse eid="DAN 8:14" /></para>
  <para style="s">elmlax jibriyl eyfesser erruYyeθ</para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 8:15" />w max i zriyγ neč danyal tirjiyθe, eĎlebe efhemes, tay neč siyn w elxyal n eryaz ybed ezzeθiyw, <verse eid="DAN 8:15" /><verse number="16" style="v" sid="DAN 8:16" />esle eSSuwθ n elεebδ seg emmas n esuwf n ulay yetnabe w yeqqar: ya jibriyl fehhem eryaze g elli yezre. <verse eid="DAN 8:16" /><verse number="17" style="v" sid="DAN 8:17" />yaseδ meni ibedde, emmerεbe esjδe f uδmiyw. yenniyδ: efhem ey bnaδem. tirjiyθe netteθ f ellexxer n eddunyeθ. <verse eid="DAN 8:17" /><verse number="18" style="v" sid="DAN 8:18" />w elweqθ elli yδukkayi ySaDi enuddem δ emeqqar w uδmiyw f elqeεεeθ, ylemsiyδ yesbeddi f ikreεniyw, <verse eid="DAN 8:18" /><verse number="19" style="v" sid="DAN 8:19" />yenniyδ: tay exenne f elli δ ySar max e yaweD elγuc n erreb y ellexres. εlexaTer tirjiyθe teqqar f ewqe n elweqθ. <verse eid="DAN 8:19" /><verse number="20" style="v" sid="DAN 8:20" />elkebc elli θezrit, w γers sen δ legruwn, nette lemluwk n maday d fares. <verse eid="DAN 8:20" /><verse number="21" style="v" sid="DAN 8:21" />w ijδeε imceεεer nette elmlek n elyuwnan. w elgren emeqqar elli jar TiTTawines nette elmlek iglewwel δiysen. <verse eid="DAN 8:21" /><verse number="22" style="v" sid="DAN 8:22" />emme ekesres d effeγ n erbεe seg sedwes, elmeεntes erbεe δ lemluwk efγen seg ellumθes, emme muc g elqewθes. <verse eid="DAN 8:22" /><verse number="23" style="v" sid="DAN 8:23" />w g ellexxer n leyyames, max exeθren egget elmεaSi egliys, eyekker seg jar leεbaδ elmlek δ eddehyeθ, <verse eid="DAN 8:23" /><verse number="24" style="v" sid="DAN 8:24" />e θekbar elqewθes, emme muc s γers. e ysuggez elhlax emeqqar usinc e yenjeH g elli yθeg δiys usinc e yehlex imeqqaren d ecceεb n erreb. <verse eid="DAN 8:24" /><verse number="25" style="v" sid="DAN 8:25" />w s elHiyltes d elmekres ayeg kul ciy w g ules e yεeĎĎem imenes. eysender egget δ midden w nihnin δ imeTmanen. e yekker f errayes n erruyyas. usinc e yerrez emme muc f efus n elbecer. <verse eid="DAN 8:25" /><verse number="26" style="v" sid="DAN 8:26" />w elli zriyxθ ezre n deggiyδ d dugges nette δ elHeq. w eθenneδ ciy fellas. εlexaTer wetSar kan beεεeδ leyyam egget. <verse eid="DAN 8:26" /><verse number="27" style="v" sid="DAN 8:27" />eDεafe neč danyal, eDne leyyamaθ, w elbeεεeδ ekkere kemle xedme g elmlek w kane mebhuwθ g elli zriyγ w elgeddexc eθefhme.<verse eid="DAN 8:27" /></para>
  <chapter eid="DAN 8" />
  <chapter number="9" style="c" sid="DAN 9" />
  <para style="s">tzalliθ n danyal y ceεbeθes</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 9:1" />g esukkas iglewwel seg elεehδ n daryuws ben Hecwiyr, elmaday s ennesl, elli yemHuT δ elmlek f babel, <verse eid="DAN 9:1" /><verse number="2" style="v" sid="DAN 9:2" />fheme neč danyal seg elqrayeθ n imujelden elεδeδ n isukkasen elli yenne erreb y enbi ermiya bac e θemmexle urceliym, w netteθ sebεiyn esne.<verse eid="DAN 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="DAN 9:3" />eĎlbe erreb s θzalliθ d edεe d ezuwmi d ariD n elmsuwH d teqiymiθ f iγeδ. <verse eid="DAN 9:3" /><verse number="4" style="v" sid="DAN 9:4" />ezzelle y erreb siydiy eεθerfe enne: ey erreb εĎiym w elli yetmekkeδ, etteTfeδ elεehδ d erreHmeθ y elli exsnax w xedmen s elwSayax, <verse eid="DAN 9:4" /><verse number="5" style="v" sid="DAN 9:5" />nečin neγleĎ neθmerreδ neg eccer nebεeδ f elwSayax d leHkamex, <verse eid="DAN 9:5" /><verse number="6" style="v" sid="DAN 9:6" />d elli nesli seg lenbyax elli uθlayen s ellesmex y lemlukenne d imeqqernenne d lejdadenne d leεbaδ elkul n temurθenne. <verse eid="DAN 9:6" /><verse number="7" style="v" sid="DAN 9:7" />ya rebbi, γerx elHeq g elli θegit, w y nečin esse leεbaδ tezeδfi n uwδem, nečin iryazen n yehuwδa d elli nεemmer g urceliym d ecceεb n israYiyl elkul, elli qreben d elli bεeδen, g lemden elkul elli θgelbetten tweliys f elxyentensen. <verse eid="DAN 9:7" /><verse number="8" style="v" sid="DAN 9:8" />y nečin zaδe tezeδfi n uwδem w ilemlukenne d imeqqernenne d daddeθne, εlexaTer neγleĎ ezzeθex, <verse eid="DAN 9:8" /><verse number="9" style="v" sid="DAN 9:9" />w y cex erreb siydiy erreHmeθ d esmaH εlexaTer neθmerreδ fellax, <verse eid="DAN 9:9" /><verse number="10" style="v" sid="DAN 9:10" />w ennesliyc edwi n erreb siydiyθne, w ennuyurc g ebriδ n eccriεθex elli θHuTTettent ezzeθenne s ifessen n lenbyax. <verse eid="DAN 9:10" /><verse number="11" style="v" sid="DAN 9:11" />ecceεb n israYiyl elkul yeθεedde eccriεθex, w elleslinc edwiyx, eyendeγ θeggez fellane elleεneθ elli θemmari g ecceriyεeθ n elεbδex muwse εlexaTer neγleĎ ezzeθex. <verse eid="DAN 9:11" /><verse number="12" style="v" sid="DAN 9:12" />tegeδ edwi elli tuθlayeδ essis fellane d elHukkamenne elli Hekmen δiyne, tsugseδ fellane ennekbeθ δ temeqqarθ εlexaTer elli ySar g urceliym liSarc m nette seddu esme. <verse eid="DAN 9:12" /><verse number="13" style="v" sid="DAN 9:13" />w emmax i yemmari g ecceriyεeθ n muwse, teggez fellane ennekbeθe emeqqar menγiyr eneĎleb essix esmaH entab f eδnubenne, nessen elHeqqex. <verse eid="DAN 9:13" /><verse number="14" style="v" sid="DAN 9:14" />heδakeεlac θessugzeδ fellane ennekbeθe, εlexatrek δ eHeqqi g elli ettegeδ δiys elkul, w nečin ennesliyc edwiyx. <verse eid="DAN 9:14" /><verse number="15" style="v" sid="DAN 9:15" />w ture ey erreb siydiy cex θessufγeδ ecceεbex seg elqeεεeθ n miSr s elquδreθ δ temeqqerθ, tegeδ y imenex ellesm el asse, emme nečin neγleD neg eccer. <verse eid="DAN 9:15" /><verse number="16" style="v" sid="DAN 9:16" />w emmax i θkaneδ δ eHeqqi g elli ettegeδ δiys elkul, ekkes elγuccex f elmdintex urceliym, eddehrθex timqeddesθ, f elxaĎer n elxĎeyenne d elleθm n midnenne δwelen elli enneDen essiyne elkul etεeyaren g urceliym d ecceεbex. <verse eid="DAN 9:16" /><verse number="17" style="v" sid="DAN 9:17" />w ture esl y θzalliθ n elεebδex d edεes, tenziyδ s TiT n erreHmeθ y elmeqdsex elli yemmexreb, w wah elkul f elxeĎrex ya siydiy. <verse eid="DAN 9:17" /><verse number="18" style="v" sid="DAN 9:18" />uwc temedjiθex tesleδ. miyr TiTTawinex θenziyδ elxerbeθenne d elmdiyneθ elli elesmex yemmemdeHe δiys. w nečin exenδeεεu muc εlexaTer nečin δ eSSullaH, emme εlexaTer erreHmtex δ temeqqerθ. <verse eid="DAN 9:18" /><verse number="19" style="v" sid="DAN 9:19" />ya siydiy esl. ya siydiy sameH. ya siydiy esl tegeδ, eθεeTlec, w wah elkul f elxeĎrex ya siydiy, εlexaTer ellesmex yemsemme f elmdintex d elceεbex.<verse eid="DAN 9:19" /></para>
  <para style="s">jibriyl eyfesser ennubuwweθ</para>
  <para style="p">
    <verse number="20" style="v" sid="DAN 9:20" />&lt;&lt;w elweqθ elli neč δukkiyγ w etzalliγ w etteεθerfe s elxĎayaw d elxĎaye n ecceεb n israYiyl, w δeεεuwγ ezzaθ n erreb f elxaĎer n eddehrθes timqeddesθ, <verse eid="DAN 9:20" /><verse number="21" style="v" sid="DAN 9:21" />neč siyn w elmlax jibriyl elli zrixθ g ellewwel n eθheyyeY, yessiylel fiyseε ylemsi g elweqθ n ewce y rebbi g eθsemsiyn, <verse eid="DAN 9:21" /><verse number="22" style="v" sid="DAN 9:22" />yfehmiyδ yenniyδ: ha, danyal effeγe w tay usiyγd bac e xerre tfehmeδ eθheyyeY. <verse eid="DAN 9:22" /><verse number="23" style="v" sid="DAN 9:23" />seg ellewwel n tzalliθex yerre rebbi, w usiγd neč bac e xeddeγe eljwab n rebbi εlexaTer nette yexsex egget. emmale esseγδ tefhmeδ eljwab f eθheyyeY. <verse eid="DAN 9:23" /><verse number="24" style="v" sid="DAN 9:24" />yHuT erreb sebεiyn merre sebεe sniyn f ecceεbex d elmdintex timqeddesθ bac e ykemmel elmeεSyeθ d eδδemb, yeγfarsen, yeHellel elHeq diyme, ytemmem eθheyyeY d ennubuwweθ, eqeddus n leqdas eyemmemseH. <verse eid="DAN 9:24" /><verse number="25" style="v" sid="DAN 9:25" />emmale esl tefhmeδ seg elli yeffeγ ellemr s eεaweδ n ebne n urceliym el waseδ n elmesiyH elmlek, w δ yeθεεedde sebε sniyn sebε merraθ d sebε sniyn θniyn w settiyn merre, usinc eθemεaweδ eθemmebne elmdiyneθ δiys essaHeθ d essur, emme g elweqθ δiys eddiyq. <verse eid="DAN 9:25" /><verse number="26" style="v" sid="DAN 9:26" />w beεεeδ sebε sniyn θniyn w settiyn merre e yemmenγ elmesiyH reGmelli nette elyegi ciy yuHec, usinc edyes errayes s eljices yxerreb elmdiyneθ d elmeqdes. usiync ettas elexreθ m eTTuwfan, usinc edyes elHerb d elxrab emmax i yenne fellasen rebbi. <verse eid="DAN 9:26" /><verse number="27" style="v" sid="DAN 9:27" />w g sebε sniyn ayeg erreyse y egget δ leεbaδ elεehδ δ eθθabet, w g emmas n elmuddeθ e ybeTTel eγras d ewce, w g eccefeθ n elheykel eyeg enjasaθ n elxrab, usinc e θeqqiym δiyn elmi yeggez elγuc n erreb felles.&gt;&gt;<verse eid="DAN 9:27" /></para>
  <chapter eid="DAN 9" />
  <chapter number="10" style="c" sid="DAN 10" />
  <para style="s">eθheyyeY n danyal g esuwf n dejle</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 10:1" />g esukkas eθθaleθ seg elεehδ n kuwrec elmlek n fares temmekcef elkelmeθ y danyal elli yemsemme belTecaSSer, elkelmeθ δ elHeq f elHerb emeqqar, w ykan efhemes y elkelmeθ g tirjiyθ. <verse eid="DAN 10:1" /><verse number="2" style="v" sid="DAN 10:2" />g liyyemeθdiyn neč danyal newHe tlaθe jemεaθ, <verse eid="DAN 10:2" /><verse number="3" style="v" sid="DAN 10:3" />w ellečixc eče yebhe w elyuδifc g imiw exsuwm ziyγ δ ecrab, w ellegixc erriyHeθ elmi uqaneθ tlaθe jemεaθ. <verse eid="DAN 10:3" /><verse number="4" style="v" sid="DAN 10:4" />w g as n erbεe w εicriyn seg eyyuwr iglewwel, kane g eccafeθ n esuwf emeqqar elli nette δ dejle, <verse eid="DAN 10:4" /><verse number="5" style="v" sid="DAN 10:5" />qame TiTTawiniyw ezre tay eryaz yireD elkettan, w g elHzemes essebθeθ seg uwreγ elxaleS, <verse eid="DAN 10:5" /><verse number="6" style="v" sid="DAN 10:6" />elbeδnes m elHjer unfis w uδmes m elberg, w TiTTawines m elεefyeθ, elmenDer n iγelnes d ikreεnes m enHas yemmeSqel, w eSSuwθes m eSSuwθ n eljemhuwr. <verse eid="DAN 10:6" /><verse number="7" style="v" sid="DAN 10:7" />w ezriyγ eθheyyeY kan enneč weHδi, w iryazen elli iyδi ettezriync, emme yeggez fellasen elxuwf δ emeqqar erwlen eεglen. <verse eid="DAN 10:7" /><verse number="8" style="v" sid="DAN 10:8" />eqqiyme neč weHδi zerre g erruYyeθe temeqqarθ, w elteqqimc δiyyi elquwweθ, eδbalneθ TiTTawiniyw, efcle. <verse eid="DAN 10:8" /><verse number="9" style="v" sid="DAN 10:9" />w max i sliyγ edwis uDiyγ f uδmiyw w enεese g enuddem δ emeqqar, w uδmiyw yelSeq y elqeεεeθ.<verse eid="DAN 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="DAN 10:10" />tay neč siyn w afus ylemsi yesqiymi f ifedniyw d ifesniyw w neč reεce. <verse eid="DAN 10:10" /><verse number="11" style="v" sid="DAN 10:11" />yenniyδ:&lt;&lt;ha danyal, ey meHbuwb, efhem edwi elli δukkiyγex essis, ekker bed, neč emmezne tweliyx.&gt;&gt; max i yuθlay s edwiye bedde w elluciyγ reεce. <verse eid="DAN 10:11" /><verse number="12" style="v" sid="DAN 10:12" />yenniyδ: eθukδc edanyal, seg ewwel nhar θwejheδ ulex y efham d eδulli n imenex ezzaθ n errebbex, yesle erreb edwiyx esδe neč f elxaĎer n weδiyn. <verse eid="DAN 10:12" /><verse number="13" style="v" sid="DAN 10:13" />ybed ezzaθ n uδmiyw errayes n elmemlxeθ n fares wahed w εicriyn yuwm, yaseδ bac e yεawen, mixaYiyl, errayes seg erruyyas n elmlayxe, εlexaTer immeTfe δiyn g elmemlxeθ n fares, <verse eid="DAN 10:13" /><verse number="14" style="v" sid="DAN 10:14" />yemenni usiγd bac e xbiyne mat δ ySar y ecceεbex g liyyam ejjeyyiyn εlexaTer erruYyeθ netteθ elli δ ySer g liyyemeθdiyn. <verse eid="DAN 10:14" /><verse number="15" style="v" sid="DAN 10:15" />w elweqθ elli nette yδukkayi s edwiye sunde uδmiyw y elqeεεeθ essusme, <verse eid="DAN 10:15" /><verse number="16" style="v" sid="DAN 10:16" />tay iyjen yečebbeh y elεebδ ylemmes ecfeyfiyw, w elbeεεeδ miyre imiw enne y elli ybed ezzeθiyw:&lt;&lt;ya siydiy rahu seg erruYyeθ yenneqleb elli γeri eljaj w meεεač γeri ejjehδ, <verse eid="DAN 10:16" /><verse number="17" style="v" sid="DAN 10:17" />endre max egedde neč elεebδex, ya siydiy, exuθlaye w neč elγeric ejjehδ w eddiyyic ennesmeθ.&gt;&gt;<verse eid="DAN 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 10:18" />yerjeε elli yečebbeh y elεebδ ylemsiyδ yqewwayi. <verse eid="DAN 10:18" /><verse number="19" style="v" sid="DAN 10:19" />yen eθukδc ey eryaz meHbuwb, eslam fellax eθqewwe exθer. w max i yyuθlay eθqewwiyγ, enne: uθlay ya siydiy εlexaTer θqewwiyδi. <verse eid="DAN 10:19" /><verse number="20" style="v" sid="DAN 10:20" />neč δ rejεe bac e Herbe errayes n elmemlxeθ n fares, w beεεeδ n emreqiyw edyes errayes n elyuwnan. <verse eid="DAN 10:20" /><verse number="21" style="v" sid="DAN 10:21" />yen: endre ture θesseneδ ymat ixddusiyγ? usiγd bac e xxebre s elli yemmari g elxθab n elHeq, w eHebbe Hette Hed e yyεawen f leεδe kan δ mixaYiyl errayes seg erruyyas n elmlayxe,<verse eid="DAN 10:21" /></para>
  <chapter eid="DAN 10" />
  <chapter number="11" style="c" sid="DAN 11" />
  <para style="p">
    <verse number="1" style="v" sid="DAN 11:1" />elli neč ebedde iyδes qewwixθi εewnexθi g esukkas iglewwel seg elεehδ n daryuws elmaday.<verse eid="DAN 11:1" /></para>
  <para style="s">elmemlxeθ n miSr d suwriyye</para>
  <para style="p">
    <verse number="2" style="v" sid="DAN 11:2" />w ture exenne f elHeq: tay tlaθe δ lemluwk δ eddasen g fares, w errabeε δ ykuwn eγnensen elkul egget, w max e yeθqewwe s elγnas, e yheyyej leεbaδ elkul f elmemlxeθ n elyunan. <verse eid="DAN 11:2" /><verse number="3" style="v" sid="DAN 11:3" />w edyes elmlek δ imeθjebber eykuwn δ eSSulTan δ emeqqar usinc ayeg elli yexs. <verse eid="DAN 11:3" /><verse number="4" style="v" sid="DAN 11:4" />w netteθ g elqewθes temeqqerθ e θerrez elmemlekθes θemzuwn y ecciyreθ lerbε n elqeεεeθ, w etkunc y ezzerriεθes w elγrec elquwweθ m qebl, w e tzuwnen y elγires.<verse eid="DAN 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 11:5" />w e yeθqewwe elmlek n eljenuwb, yemenni iyjen seg elquyyeδes e yeθqewwe felles usinc e yeθsellaT w e ykuwn eSSulTanes δ emeqqar. <verse eid="DAN 11:5" /><verse number="6" style="v" sid="DAN 11:6" />w beεεeδ leεwam e θHalfen taseδ yellis n elmlek n eljenuwb y elmlek n elcemal bac e mSalHen, yemenni elqewθes etqimic w ezzerriεθes zaδe, usinc e θehlex netteθ d elli uγδenteθ d daddes d elli yeawent elweqθes.<verse eid="DAN 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 11:7" />w g elweqθdiyn edyes iyjen seg midnes eyawi emxan n δaddes usinc yaδef f eljiyc n elmlek n eccemal, usinc entyeγleb, <verse eid="DAN 11:7" /><verse number="8" style="v" sid="DAN 11:8" />usinc eyawi leSnam n elYileheθensen elli emmegen s uzzal y miSr yawi elmeεεuwnensen elli yeγle seg elfeTTeθ d uwreγ. w e yebεeδ elmlek n eccemal lebHaD n leεwam. <verse eid="DAN 11:8" /><verse number="9" style="v" sid="DAN 11:9" />usinc e yezHef elmlek n eccemal f elmemlxeθ n elmlek n eljenuwb, yemenni e yexser usinc e yerjeε y temurθes.<verse eid="DAN 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="DAN 11:10" />usinc e lemδen idrari n elmlek n eccemal eljiyc δ emeqqar, usinc e hejmen f elmlek n eljenuwb m eTTufan w g erjeεensen ehejmen f elεaSmeθ n elmlek n eljenuwb. <verse eid="DAN 11:10" /><verse number="11" style="v" sid="DAN 11:11" />usinc e yeθγeccec elmlek n eljenuwb yeffeγ eyHareb elmlek n eccemal w reγm elli elmlek n eccemal edyaγ eljiyc δ emeqqer, emme e yexser. <verse eid="DAN 11:11" /><verse number="12" style="v" sid="DAN 11:12" />w max e yerbeε e yeθkebber yenγ laluf, yemenni elyetqimiyc diyme yrebbeH. <verse eid="DAN 11:12" /><verse number="13" style="v" sid="DAN 11:13" />usinc e yεaweδ elmlek n eccemal ayeg eljiyc ekber n eljiyc iglewwel w beεεeδ leεwam e yezHef s eljiyc δ emeqqar d elmeεεuwn egget. <verse eid="DAN 11:13" /><verse number="14" style="v" sid="DAN 11:14" />w g elweqθdiyn eθmerδen egget δ leεbaδ f elmlek n eljenuwb, ekren ifellagen seg ecceεbex e Heqeqen erruYyeθ w etgeddenc. <verse eid="DAN 11:14" /><verse number="15" style="v" sid="DAN 11:15" />usinc edyes elmlek n eccemal edyeγ eljiyc yHaSer elmdiyneθ egen ebriδ m eddehreθ s eccal e δefnas eHθellenteθ, w elyetbeddiyc ezzeθes eljiyc n eljenuwb Hette δ iryeznes ibhhayen, εlexaTer welγersenc elquwweθ bac e θwejhen. <verse eid="DAN 11:15" /><verse number="16" style="v" sid="DAN 11:16" />usinc ayeg elmlek n eccemal g ecceεb n eljenuwb elli yexs, w elyetbeddi ezzeθes Hed, usinc edyes y temurθ tebehheyθ yehlext. <verse eid="DAN 11:16" /><verse number="17" style="v" sid="DAN 11:17" />usinc e yemreq elmlek n eccemal s elqewθes elkul y elqeεεeθ n elεδuwwes, usinc emsemHen yuces yellis w g enniyθes e sifesseδ elmemlekθes, yemenni weδiyn elyetSerc. <verse eid="DAN 11:17" /><verse number="18" style="v" sid="DAN 11:18" />w elbeεεeδ e yelhe s ecciyreθ n essaHel yawi essis egget, yemenni iyjen seg elquyyaδ e θyeqher yesbeddi, usinc e syekkes eθkebres. <verse eid="DAN 11:18" /><verse number="19" style="v" sid="DAN 11:19" />usinc e yettelhe s leHsun n timures, yemenni e yuwDe w esetqimic ejjerreθ.<verse eid="DAN 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="DAN 11:20" />usinc e yeTTef elbleSθes δwiyn eyazen ijen yetlemmeδ g eljezyeθ usiync e ySender elmejδ n elmemlxeθ, yemenni beεεeδ elweqθ iqSeyyer e yerrez menγiyr elfetneθ w la δ elHerb. <verse eid="DAN 11:20" /><verse number="21" style="v" sid="DAN 11:21" />e yeTTef elbleSθes iyjen yemmeHqer liSelleHc y elmemlxeθ, yemenni eyawi elHukm s elHiyleθ d elquwweθ elweqθ elli leεbeδ imeTmanen. <verse eid="DAN 11:21" /><verse number="22" style="v" sid="DAN 11:22" />usinc e ykesser eljiyc δ emmeqer m eTTufan, usinc emkesren ezzeθes w ayenγ errayes n ecceεb n elεaheδ. <verse eid="DAN 11:22" /><verse number="23" style="v" sid="DAN 11:23" />w max ayeg iδes elεehδ eyxuwn, usinc e yali s lebHaD n leεbaδ. <verse eid="DAN 11:23" /><verse number="24" style="v" sid="DAN 11:24" />w elweqθ n salem e yeHθel eljihaθ timuγniyyin n temurθ yeg elli eθeginc midnes w la δ lejdades. usinc e yferreq f eljmeεθes seg elli yiwiθ, usinc e yHeDDer imenes y uγari elmerreθ xlaf emme wah yetqimiyc kan elfetreθ. <verse eid="DAN 11:24" /><verse number="25" style="v" sid="DAN 11:25" />usinc e yhajem elmlek n eljenuwb s eljiyc δ emeqqar. w elmlek n eljenuwb e θiHareb s eljiyc δ emeqqar w yeqwe egget, emme liθebbeθc εlexaTer leabeδ xlaf HeDDernas imenensen. <verse eid="DAN 11:25" /><verse number="26" style="v" sid="DAN 11:26" />w elli θetten seg elmittes eθxuwnen, usinc e yerrez eljices emmuwθen essis egget. <verse eid="DAN 11:26" /><verse number="27" style="v" sid="DAN 11:27" />emme lemluwke essen eqqiymen ulewnensen δ izeTTafen, esxerxsen elweqθ elli nihnin f elmiyδeθ icθ emme ennedjHenc. εlexaTer ellexerθensen temHedded. <verse eid="DAN 11:27" /><verse number="28" style="v" sid="DAN 11:28" />usinc e yerjeε elmlek n eccemal y elqeεθes s eθθerweθ δ temeqqarθ, w g ules enniyyeθ tuHec f ecceεb n elεehδ imqeddes. usinc ayeg elli yexs y ecceεb yerjeε y elqeεθes.<verse eid="DAN 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="DAN 11:29" />w g elweqθ ellazem e yerjε elmlek n eccemal e yaδef y eljenuwb, emme e yeθbeddel elHal, <verse eid="DAN 11:29" /><verse number="30" style="v" sid="DAN 11:30" />εlexaTer elflayek seg elγerb ehjemneθ fellas, e yukkeδ yerjeε δ imeθγeccec f ecceεb n elεehδ imqeddes yeg elli yexs. w g erjeεes e ySaHeb elli bεeδen f elεehδ imqeddes. <verse eid="DAN 11:30" /><verse number="31" style="v" sid="DAN 11:31" />w edyes seg eljices elli eyδennes elHeSn imqeddes, yekkes θimeHreqθ n diyme, yeg enjaseθ d elxrab, <verse eid="DAN 11:31" /><verse number="32" style="v" sid="DAN 11:32" />yessender s edwi yebhe elli e beεδen f elεaheδ, emme ecceεb elli yessen errebbes e θcededen g elmuεemeltensen iyδes. <verse eid="DAN 11:32" /><verse number="33" style="v" sid="DAN 11:33" />w elli γersen elheqmeθ seg ecceεb e biynen ellemr y egget, yemenni e ĎuĎan seddu essiyf d elεefyeθ d elHebs d ennehb, y elmuddeθ. <verse eid="DAN 11:33" /><verse number="34" style="v" sid="DAN 11:34" />w max e ĎuĎan e δafen δwiyn entiεawen kan lewse, w eδuwlen iδsen leεbaδ egget s enafeq. <verse eid="DAN 11:34" /><verse number="35" style="v" sid="DAN 11:35" />usinc e ĎuĎan lebHaD seg elli γersen elheqmeθ w eykuwn ewDensen δ esbeb g neDDef elmi edyes elweqθ ellexxer elli yHeDDedθi rebbi.<verse eid="DAN 11:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="DAN 11:36" />w ayeg elmlek n eccamal elli yexs w e yeθreffeε f elYilahaθ elkul. yuθlay s elbaDel f erreb n elYilahaθ, w e yenjeH elmi edyes elweqθ n essuxT, alexaTer yqerrer erreb eθyeg. <verse eid="DAN 11:36" /><verse number="37" style="v" sid="DAN 11:37" />w elyettesθeεrifc elmlek s erreb n midnensen w la s erreb elli exsnett timeTTuwθin, w la s Hette erreb εlexaTer eyeθεelle f elkul. <verse eid="DAN 11:37" /><verse number="38" style="v" sid="DAN 11:38" />emme e ykerrem erreb n leHSuwn elli eθessinenc midnes, e θikerrem s uwreγ d elfeTTeθ d elHjer unfis. <verse eid="DAN 11:38" /><verse number="39" style="v" sid="DAN 11:39" />usinc e yehjem f temur timHesnen elli qwan s ellesm n erreb uγrib, w elli eθeqblen e senyerni g elmejδ, w entiselleT f egget δ leεbaδ, w e yzuwn elqeεεeθ f elxeĎrensen δ errecweθ.<verse eid="DAN 11:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="DAN 11:40" />w max e yaweD elweqθ e θiHareb elmlek n eljenuwb, usinc e sedyas elmlek n eccemal s tikerriytin d elfursan d tiflak egget eyaδef lemdenes m ezzubεeθ yeHθelliθ yeθεeddet, <verse eid="DAN 11:40" /><verse number="41" style="v" sid="DAN 11:41" />usinc e yaδef temurθ tebehheyθ wDaneθ lemden egget emme emneεneθ tiyh: eduwm d muwab d elquyyaD n elqeεεeθ n bniy εemmuwn. <verse eid="DAN 11:41" /><verse number="42" style="v" sid="DAN 11:42" />w e yHuT eddu ifesnes egget d timuwre w elqeεεeθ n miSr eltmenneεc. <verse eid="DAN 11:42" /><verse number="43" style="v" sid="DAN 11:43" />w e yγar f leknuwz n uwreγ d elfeTTeθ d kul ciy yeγle g miSr, w g ebriδes e θeθbεen ilibiyyen d ikuciyyen. <verse eid="DAN 11:43" /><verse number="44" style="v" sid="DAN 11:44" />usinc e θerεben lexbar seg eccerq d eccemal, usinc e yeffeγ seg temurθ δ imeθγeccec egget bac e ydemmer egget δ leεbaδ. <verse eid="DAN 11:44" /><verse number="45" style="v" sid="DAN 11:45" />usinc e yenSeb elximtes n elmlek jar elbHer d eddehreθ n elquds, usinc e yaweD elHeddes w eθineSSer Hed.<verse eid="DAN 11:45" /></para>
  <chapter eid="DAN 11" />
  <chapter number="12" style="c" sid="DAN 12" />
  <para style="s">liyyameθ igluxren</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 12:1" />w g liyyameθdiyn e yekker mixaYiyl, errayes n elmlayxe emeqqar elli yetεemmel felles ecceεbex, w eykuwn elweqθ n eddiyq liSerc qebl seg elbδu n elεebδ el ellexxer, elweqθes eyemneε seg ecceεbex elli ellesmes yemmari g elxθab, <verse eid="DAN 12:1" /><verse number="2" style="v" sid="DAN 12:2" />w egget seg elli nεesen seddu ecal ekren, lebHaD y eddar diyme w lebHaD y elεar d elεδab diyme. <verse eid="DAN 12:2" /><verse number="3" style="v" sid="DAN 12:3" />elli γersen elheqmeθ e Dewwan m θefuθ g esme, w elli ehδan egget δ leεbaδ y elHeq eDewwan m iθran diyme. <verse eid="DAN 12:3" /><verse number="4" style="v" sid="DAN 12:4" />emme cex danyal eHfeD eserre tsekker elxθab texθmetti el ellexxer, egget leεbaδ e merqen e sden bac e rniyn elmeεrfeθ.<verse eid="DAN 12:4" /></para>
  <para style="s">ezre n sen elmlayxe f ecceT n esuwf.</para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 12:5" />w tay ezriyγ neč danyal sen xlaf bedden, iyjen esyah w iyjen esyiyn, f ecceT n esuwf. <verse eid="DAN 12:5" /><verse number="6" style="v" sid="DAN 12:6" />enne y eryaz elli yireD elkettan, elli ybed f amen n esuwf: lemmi e Duqaneθ elhajeθ elli g ezre? <verse eid="DAN 12:6" /><verse number="7" style="v" sid="DAN 12:7" />yqam eryaz elli yireD elkettan w ybed f amen n esuf, efuses elimin d efuses elyser y esme w yetjelle s elli yedder diyme: yetlaθe sniyn d ezyen, max e ySar ekesser n elquweθ n ecceεb imqeddes e ytem wah elkul.<verse eid="DAN 12:7" /></para>
  <para style="s">efesser n ezre n elmlayxe</para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 12:8" />sliyγ weδiyn w eθefhimexc, enne: ya siydiy, δme ellexxer n wah elkul? <verse eid="DAN 12:8" /><verse number="9" style="v" sid="DAN 12:9" />yen: emreq ha danyal, kul ciy yemmeHrez w yemsekker elmi edyes elweqθ. <verse eid="DAN 12:9" /><verse number="10" style="v" sid="DAN 12:10" />egget δ leεbaδ etteTTehharen w ettendafen, w icerriyren tegen g eccer yemenni Hette iyjen essisen welifehhem, emme elli γersen elHeqmeθ fehmen. <verse eid="DAN 12:10" /><verse number="11" style="v" sid="DAN 12:11" />w seg ekkes n θimeHreqθ n diyme d age n enjaseθ n elxrab elf w miytiyn w tesεiyn yuwm. <verse eid="DAN 12:11" /><verse number="12" style="v" sid="DAN 12:12" />SeHHe y elli e yraje yaweD y elf w tleθmiyye w xemse w tleθiyn yuwm. <verse eid="DAN 12:12" /><verse number="13" style="v" sid="DAN 12:13" />w cex, berre terθaHeδ elmi yaweD elweqθ, usinc e θekreδ bac e θewyeδ elbayex.&gt;&gt;<verse eid="DAN 12:13" /></para>
  <chapter eid="DAN 12" />
</usx>