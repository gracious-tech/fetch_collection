<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="GEN" style="id" />
  <para style="h">Gen</para>
  <para style="toc1">kitabu elttekwyn</para>
  <para style="toc2">Gene</para>
  <para style="toc3">GEN</para>
  <para style="mt1">kitabu elttekwyn</para>
  <chapter number="1" style="c" sid="GEN 1" />
  <para style="s">axleq</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 1:1" />g elbδu, rebbi yexleq esmawaθ d elqeεεeθ, <verse eid="GEN 1:1" /><verse number="2" style="v" sid="GEN 1:2" />elqeεεeθ tkan δ elxerbeθ δ telxaliθ, w essellesθ tiyreδ uwδem n wamen, w erruwH n rebbi tesseylel δenyes<verse eid="GEN 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 1:3" />yen rebbi: «edj eθeδwel telle tefuwθ.» teδwel telle tefuwθ, <verse eid="GEN 1:3" /><verse number="4" style="v" sid="GEN 1:4" />yezer rebbi elli tefuwθ tebhe, ibeεεeδt f eθsellesθ. <verse eid="GEN 1:4" /><verse number="5" style="v" sid="GEN 1:5" />ysemme rebbi tefuwθ dugges, w eθsellesθ δeggiyδ. temreq tisemsiyn w beεδes talji, as emezwar.<verse eid="GEN 1:5" /></para>
  <para style="p">
    <verse number="6-7" style="v" sid="GEN 1:6-7" />yen rebbi: «edj eyeδwel yelle eferDawi eyHuz biyn amen uggeddayen d amen uggenjen.» <verse eid="GEN 1:6-7" /><verse number="8" style="v" sid="GEN 1:8" />ysemme rebbi eferDawi esme. temreq tisemsiyn, teseδ talji, as eθθani.<verse eid="GEN 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 1:9" />yen rebbi: «edj amen elli seddu esme emlaymen uggemxan iyjen, edj eθeffeγ elqeεεeθ teqquwr.» yeδwel siyn. <verse eid="GEN 1:9" /><verse number="10" style="v" sid="GEN 1:10" />ysemme rebbi elqeεεeθ eθeqquwr elqeεεeθ, w meni imlaymen amen ysemmaθ iylel. rebbi yezre wediyn elkul yebhe. <verse eid="GEN 1:10" /><verse number="11" style="v" sid="GEN 1:11" />usiyn yenne rebbi: «edj elqeεεeθ eθessuwfeγ elxDar: elHec δiys ezzerriyεeθ d eccejer yettaru elγelleθ kul icθ δiys ennuεes n ezzerriyεeθ.» ySar siyn, <verse eid="GEN 1:11" /><verse number="12" style="v" sid="GEN 1:12" />tessuwfeγ elqeεεeθ elxDar: elHec δiys ezzerriyεeθ d eccejer yettaru elγelleθ kul icθ δiys ennuεes n ezzerriyεeθ. rebbi yezre wediyn elkul yebhe. <verse eid="GEN 1:12" /><verse number="13" style="v" sid="GEN 1:13" />temreq tisemsiyn, teseδ talji, as eθθaleθ.<verse eid="GEN 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 1:14" />yen rebbi: «edj effeγneθ tifawin g esme bac e beyyenneθ dugges seg δeggiyδ, w edj ebδaneθ y uεellem n leεyaδ, liyyam d isukkasen. <verse eid="GEN 1:14" /><verse number="15" style="v" sid="GEN 1:15" />edj elmeεneθ g esme bac e Dewwaneθ f elqeεεeθ.» yeδwel siyn, <verse eid="GEN 1:15" /><verse number="16" style="v" sid="GEN 1:16" />yexleq rebbi sent δ tifawin δ timeqqarin, temeqqerθensent eθeHkem dugges w temezyent eθeHkem δeggiyδ, yexleq zade iθran. <verse eid="GEN 1:16" /><verse number="17" style="v" sid="GEN 1:17" />iHuTTiyneθ rebbi g esme bac e Dewwaneθ f elqeεεeθ, <verse eid="GEN 1:17" /><verse number="18" style="v" sid="GEN 1:18" />eHkemneθ dugges d δeggiyδ, eHuzneθ tefuwθ seg etsallesθ. yezer rebbi elli wediyn elkul yebhe. <verse eid="GEN 1:18" /><verse number="19" style="v" sid="GEN 1:19" />temreq tisemsiyn, teseδ talji, as errabeε.<verse eid="GEN 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 1:20" />yen rebbi: «edj eεebben amen s elHajaθ edderneθ, w izenniywen essiyllen g esme.» <verse eid="GEN 1:20" /><verse number="21" style="v" sid="GEN 1:21" />yexleq rebbi elhwayec n iylel timeqqarin d lenwaε n elhuwc elkul elli yettedder g wamen d lenwaε n izenniywen elkul. yezer rebbi elli wediyn elkul yebhe. <verse eid="GEN 1:21" /><verse number="22" style="v" sid="GEN 1:22" />yaxi ibarex δiysen yennasen: «arweθ, tεebbem iylel, edj izenniywen exeθren g elqeεεeθ.» <verse eid="GEN 1:22" /><verse number="23" style="v" sid="GEN 1:23" />temreq tisemsiyn, teseδ talji, as elxames.<verse eid="GEN 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 1:24" />yen rebbi: «edj elqeεεeθ eθessuwfeγ elHajaθ edderneθ seg lenwaε elkul: esεi d ezwayel d elli yegguwr f teδisθes kul icθ emennuwεes.» ySar siyn. <verse eid="GEN 1:24" /><verse number="25" style="v" sid="GEN 1:25" />yexleq rebbi elhuwc n elqeεεeθ d esεi d ezwayel d elli yegguwr f teδisθes kul icθ emennuwεes, yezer rebbi elli wediyn elkul yebhe. <verse eid="GEN 1:25" /><verse number="26" style="v" sid="GEN 1:26" />yen rebbi: «w ture δenexleq elεebδ, δeyebδe emnečin, δeyθHekkem g elHuwθ n iylel, d izenniwen n esme, d esεi d ezwayel, d elhwayec n elqeεεeθ d elli yegguwr f teδisθes elkul.» <verse eid="GEN 1:26" /><verse number="27" style="v" sid="GEN 1:27" />yexleq rebbi leεbaδ leδxuwr d ellenaθi m nette, <verse eid="GEN 1:27" /><verse number="28" style="v" sid="GEN 1:28" />ibarex δiysen yennasen: «arweθ, texθrem, tεebbem elqeεεeθ, eθHekmeθ g elHuwθ n iylel d izenniwen n esme d elli yegguwr f elqeεεeθ elkul.» <verse eid="GEN 1:28" /><verse number="29" style="v" sid="GEN 1:29" />rebbi yenne xlaf: «tay uciγawem lenwaε n ezzerriyεeθ d elγelleθ δiys iyγeS elli θedder f uwδem n elqeεεeθ elkul y xenyum bac e ttečem, <verse eid="GEN 1:29" /><verse number="30" style="v" sid="GEN 1:30" />emme elhwayec d izenniwen d elli yegguwr f elqeεεeθ elkul uciγasen elHec bac e θečen.» ySar siyn. <verse eid="GEN 1:30" /><verse number="31" style="v" sid="GEN 1:31" />yerqeb rebbi y elli yegi elkul, yeεjebθ. temreq tisemsiyn, teseδ talji, as essades.<verse eid="GEN 1:31" /></para>
  <chapter eid="GEN 1" />
  <chapter number="2" style="c" sid="GEN 2" />
  <para style="s">as essabeε</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 2:1" />w sahen yekmel exlaq n esmawaθ d elqeεεeθ d elli δiysen elkul <verse eid="GEN 2:1" /><verse number="2" style="v" sid="GEN 2:2" />uggas essades ykemmel rebbi elli ykan yθeg δiys, uggas essabeε yerθaH. <verse eid="GEN 2:2" /><verse number="3" style="v" sid="GEN 2:3" />ybarex rebbi as essabeε yqeddesθ, εlexaTer ykemmel δiys elli yexleqθ elkul. yerθaH essis seg w exlaq.<verse eid="GEN 2:3" /></para>
  <para style="s">tejnint n εeden</para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 2:4" />sahen esmawaθ d elqeεεeθ emmexleqneθ. <verse eid="GEN 2:4" /><verse number="5" style="v" sid="GEN 2:5" />leHebbe la eccejer la elHec g elqeεεeθ, εlexaTer rebbi elyuwc elyuziync amzer, uleHebbac δ wiyn δeyexδem elqeεεeθ. <verse eid="GEN 2:5" /><verse number="6" style="v" sid="GEN 2:6" />emme eθkan telle telmuyθ ettali seg elqeεεeθ tesseswe kul cey. <verse eid="GEN 2:6" /><verse number="7" style="v" sid="GEN 2:7" />yeg rebbi elεebδ seg ecal yenfex g elxecmes ennesmeθ n weddar, yeδwel adem δ elεebδ yedder. <verse eid="GEN 2:7" /><verse number="8" style="v" sid="GEN 2:8" />yeg rebbi ejjenneθ g εeden yetwali aqqes n tefuwθ, iHuT d iyn adem elli yexleqθ. <verse eid="GEN 2:8" /><verse number="9" style="v" sid="GEN 2:9" />yexleq rebbi lenwaε elkul n eccjer g elqeεεeθ elmenDrensen yebhe w ettarwen elγelleθ teHle, uggemmes n ejjenneθ yexleq eccejreθ n weddar d eccejreθ n wassen n elxiyr d eccer. <verse eid="GEN 2:9" /><verse number="10" style="v" sid="GEN 2:10" />ykan yelle esuwf yeffeγ seg εeden bac e yessesw ejjenneθ, esyiyn eyemzuwn f erbεe. <verse eid="GEN 2:10" /><verse number="11" style="v" sid="GEN 2:11" />emezwar ellesmes fiycuwn, esuwf elli yenneD f elqeεεeθ n eHwiyle elli δiys uwreγ. <verse eid="GEN 2:11" /><verse number="12" style="v" sid="GEN 2:12" />uwreγ n elqeεεeθdiyn yebhe, yelle zade ejjuwher d elεqiyq. <verse eid="GEN 2:12" /><verse number="13" style="v" sid="GEN 2:13" />esuwf eθθani ellesmes jiyHuwn, wahen yenneD f elqeεεeθ n kuwc elkul. <verse eid="GEN 2:13" /><verse number="14" style="v" sid="GEN 2:14" />esuwf eθθaleθ ellesmes dejle, yegguwr g eccerq n cuwr. esuwf errabeε δ elfuwrat.<verse eid="GEN 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 2:15" />yawi rebbi adem iHuTTi g ejjenneθ n εeden bac e tyexδem yelhe essis. <verse eid="GEN 2:15" /><verse number="16" style="v" sid="GEN 2:16" />yennes: «eθgeddeδ eθečeδ seg eccejreθ elkul elli texseδ, <verse eid="GEN 2:16" /><verse number="17" style="v" sid="GEN 2:17" />kan d eccejreθ n assen n elxiyr d eccer, as elli eθečeδ essis rahu eθemmuwθeδ.»<verse eid="GEN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 2:18" />yen rebbi: «elyebhiyc edje adem yedder weHδes, yelzem esexlqe iyjen m nette bac e θiεawen.» <verse eid="GEN 2:18" /><verse number="19" style="v" sid="GEN 2:19" />yawi rebbi ecal yeg essis elhuwc d izanniwen elkul. w beεεeδ yexleq adem yewiyθen y etweliys bac e yerqeb max δennisemme, usahen iwiyen elkul elliseminsen. <verse eid="GEN 2:19" /><verse number="20" style="v" sid="GEN 2:20" />inabe adem elhuwc d izanniwen d elhwayec elkul s elliseminsen. yaxi elyufiyc essisen bac e θiεawen. <verse eid="GEN 2:20" /><verse number="21" style="v" sid="GEN 2:21" />yessenεes rebbi adem g enuddem δ emeqqar, yawi iyjen seg iγesγisnes iεebbe uggemxenes exsum. <verse eid="GEN 2:21" /><verse number="22" style="v" sid="GEN 2:22" />yeg seg eγesγisdiyn elli yiwiθi seg adem temeTTuwθ, yeγet y etwali adem. <verse eid="GEN 2:22" /><verse number="23" style="v" sid="GEN 2:23" />yen adem: «θahen ture δ iyγeS seg ixseniyw d wexsum seg exsumiyw. θahen δ eθemsemme temeTTuwθ<note caller="+" style="f"><char style="fr" closed="false">2.23 </char><char style="ft" closed="false">bilεibriye elkelmeθ n weryaz &lt;ish&gt; w elkelmeθ n temeTTuwθ &lt;isha&gt;.</char></note> εlexaTer temmawi seg eryaz.» <verse eid="GEN 2:23" /><verse number="24" style="v" sid="GEN 2:24" />heδake εlac eryaz eyedj daddes d yemmes yelSeq g liweces eδwlen iyjen. <verse eid="GEN 2:24" /><verse number="25" style="v" sid="GEN 2:25" />adem d liweces kanen lessen δ iεeryanen, w elleθHecmenc.<verse eid="GEN 2:25" /></para>
  <chapter eid="GEN 2" />
  <chapter number="3" style="c" sid="GEN 3" />
  <para style="s">ewDa</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 3:1" />w eθkan telefse exbeθ Haje yexleqt rebbi. tenceδ temeTTuwθ: «endre mbelHeq yenneyawem rebbi eθečemc elγelleθ seg Hette eccejreθ gejjenneθ.» <verse eid="GEN 3:1" /><verse number="2" style="v" sid="GEN 3:2" />ter felles temeTTuwθ: «enged eneč seg elγelleθ n eccjer n ejjenneθ, <verse eid="GEN 3:2" /><verse number="3" style="v" sid="GEN 3:3" />kan deccejretdiyn elli gwemmes n ejjenneθ, yenneyane rebbi eθečemc essis wetlemsemc bac e tjefemc.» <verse eid="GEN 3:3" /><verse number="4" style="v" sid="GEN 3:4" />tennes telefse: «etjefemc, <verse eid="GEN 3:4" /><verse number="5" style="v" sid="GEN 3:5" />emme rebbi yessen elli max eθečem essis emiyrneθ tiTTewinennum, usinc eθeδewlem m nette, tessenem elxiyr deccer.» <verse eid="GEN 3:5" /><verse number="6" style="v" sid="GEN 3:6" />yaxi tezr temeTTuwθ elli elγelleθ n eccejreθ teHle utebhe w ettuč elHekmaθ y elli eyeč essis, tekkes essis θeč tuwc y weryazes yeč zade. <verse eid="GEN 3:6" /><verse number="7" style="v" sid="GEN 3:7" />yaxi mirneθ tiTTewinensen, faqen s imenensen δiεeryanen, inyen jmiyε tifray n temečiyθ irDen imenensen.<verse eid="GEN 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 3:8" />g tisemsiyn eslen elHes n rebbi g ejjenneθ, eεglen seg rebbi δeffer eccejer. <verse eid="GEN 3:8" /><verse number="9" style="v" sid="GEN 3:9" />inabe rebbi adem yennes: «meniy cex?» <verse eid="GEN 3:9" /><verse number="10" style="v" sid="GEN 3:10" />yer felles: «sliyγex (tegguwreδ) g ejjenneθ, ukδe eεgle, εlexaTer kane δeεeryan.» <verse eid="GEN 3:10" /><verse number="11" style="v" sid="GEN 3:11" />yenceδt rebbi: «δ wiyn ixyenne elli cex δeεeryan? endre θečiyδ seg elγelleθ n eccejreθ elli n ebbehγex eθečec essis.» <verse eid="GEN 3:11" /><verse number="12" style="v" sid="GEN 3:12" />yennes adem: «temeTTuwθ elli tHuTTet dahen iyδi, tucayiyδ essis eče.» <verse eid="GEN 3:12" /><verse number="13" style="v" sid="GEN 3:13" />yenceδ rebbi temeTTuwθ: «imette iθegiδ wahen.» tennes: «tluzziyδ telefse, eče.» <verse eid="GEN 3:13" /><verse number="14" style="v" sid="GEN 3:14" />yennes rebbi y telefse: «εlexaTer θegiyδ wahen, δemεeqbe: δtemelεuwnt cem menduwm elhwayec delhuwc elkul, f teδisθem δeθeδewleδ tmerδeδ, uδeθεeddiyδ g ecal leHyeθem elkul. <verse eid="GEN 3:14" /><verse number="15" style="v" sid="GEN 3:15" />δemedje cem ettmeTTuwθ timeθεarxin diyme, Hette δidreriynnum zade, nette eyfeccex ixfem ucem etteldγeδ seg elεerqubes.»<verse eid="GEN 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 3:16" />yennes y temeTTuwθ: «δemerniyye etεeb delεδab max eθebδiyδ δtemeεδurθ delwjayeε n warew. δeθebδiyδ ettesθeHaceδ g weryazem, unette yHekkem δiym.» <verse eid="GEN 3:16" /><verse number="17" style="v" sid="GEN 3:17" />yen y adem: «εlexaTer tesliyδ edwi n liwecex θečeδ seg eccejreθ elli enniyγex eθečec essis, δetemmelεen elqeεεeθ, teθεeddiyδ elHyeθex elkul txedmeδ δiys bac e xθuc mette δeθečeδ. <verse eid="GEN 3:17" /><verse number="18" style="v" sid="GEN 3:18" />δeθessuwfeγ eccuwk delHsek, cex δeθečeδ elHec n ijiyman. <verse eid="GEN 3:18" /><verse number="19" style="v" sid="GEN 3:19" />s tiδiyx δeθečeδ teneεnuyθex elδeθerjεeδ y ecal, seg ecal exleqγex uyecal δeθerjεeδ.» <verse eid="GEN 3:19" /><verse number="20" style="v" sid="GEN 3:20" />ysemme adem liweces Hewwe εlexaTer δyemmes n kul iyjen yedder. <verse eid="GEN 3:20" /><verse number="21" style="v" sid="GEN 3:21" />yeg rebbi edbac seg weylim y adem dliweces y irDesenten.<verse eid="GEN 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 3:22" />yen rebbi: «tay elεebδ yeδwel yessen elxiyr deccer emiyjen essiyne, ture mayelzemc eyeweD eccejreθ n weddar usiyn eyeč essis umeεεač eyjaf belkul.» <verse eid="GEN 3:22" /><verse number="23" style="v" sid="GEN 3:23" />yessufeγθen rebbi seg ejjenneθ n εeden, bac e xeδmen elqeεεeθ elli emmexlqen essis. <verse eid="GEN 3:23" /><verse number="24" style="v" sid="GEN 3:24" />beεεeδ igelleb adem, iHuT elmleyxaθ n keruwbiym g eccerq n ejjenneθ n εeden, dessiyf iceεεel yettenneD bac e yεus f eccejreθ n weddar.<verse eid="GEN 3:24" /></para>
  <chapter eid="GEN 3" />
  <chapter number="4" style="c" sid="GEN 4" />
  <para style="s">qayiyn dhabiyl</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 4:1" />yεacer adem liweces Hewwe tarwes qayiyn. ten: «yucayiyδ rebbi efruwx.» <verse eid="GEN 4:1" /><verse number="2" style="v" sid="GEN 4:2" />usinc taru enjes habiyl. habiyl yeδwel δeniylti n esεi, uqayiyn δefellaH. <verse eid="GEN 4:2" /><verse number="3" style="v" sid="GEN 4:3" />beεεeδ liyyam yuwce qayiyn seg elγelleθ n elqeεθes y rebbi. <verse eid="GEN 4:3" /><verse number="4" style="v" sid="GEN 4:4" />yuwc habiyl seg esεiys emenzu delli γers elliyyeθ. yeqbel rebbi habiyl dweγliys. <verse eid="GEN 4:4" /><verse number="5" style="v" sid="GEN 4:5" />emme elyeqbiylc qayiyn dweγliys. yeθγeccec qayiyn egget elmi yezDaf uδmes. <verse eid="GEN 4:5" /><verse number="6" style="v" sid="GEN 4:6" />yenceδ rebbi qayiyn: «imette iθeθγecceceδ? ecbiyh uδmex δezeTTaf? <verse eid="GEN 4:6" /><verse number="7" style="v" sid="GEN 4:7" />lukan θegiyδ elHajeθ tebhe, telliyδ ferHan. emme iδekan eltegiyc elxiyr, eδnuwb yetraje g elbab δimeθlehhef icex, emme yelzem eθeθHekmeδ δiys.» <verse eid="GEN 4:7" /><verse number="8" style="v" sid="GEN 4:8" />yen qayiyn y enjes habiyl: «est edj enexDem y ujiymi.» max i bδen g ujiymi, yehjem qayiyn f enjes habiyl yenγi. <verse eid="GEN 4:8" /><verse number="9" style="v" sid="GEN 4:9" />yenceδ rebbi qayiyn: «mani enjex habiyl.» yennes: «ellessinac, endre neč δeεessas n enje.» <verse eid="GEN 4:9" /><verse number="10" style="v" sid="GEN 4:10" />yennes rebbi: «mette iθegiδ? iδammen n enjex etzeεwegniyδ seg elqeεεeθ. <verse eid="GEN 4:10" /><verse number="11" style="v" sid="GEN 4:11" />seg ture cex δemelεuwn seg elqeεεeθ elli tmiyr imiys y iδammen n enjes seg ifesnex. <verse eid="GEN 4:11" /><verse number="12" style="v" sid="GEN 4:12" />max eθexδmeδ elqeεεeθ, meεεač exθuc elxires. δeθeδewleδ δelhamel g elqeεεeθ.» <verse eid="GEN 4:12" /><verse number="13" style="v" sid="GEN 4:13" />yen qayiyn y rebbi: «elεqubθiyw exθer n elli egedde eθeHmle. <verse eid="GEN 4:13" /><verse number="14" style="v" sid="GEN 4:14" />tay cex tgellebδiyδ asse seg elqeεεeθ useg ezzeθex. δeδuwle δelhamel g elqeεεeθ, elli eyyef δeyyenγ.» <verse eid="GEN 4:14" /><verse number="15" style="v" sid="GEN 4:15" />y axi yennayes rebbi: «la, elli δexyenγ sebεe merraθ δeyemεaqeb.» iHuT rebbi elεlameθ f qayiyn, bac elli eθyaf eθineqc.<verse eid="GEN 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 4:16" />yexDem qayiyn seg ezzaθ n rebbi yedder g elqeεεeθ ennuwd g eccerq n εeden.<verse eid="GEN 4:16" /></para>
  <para style="s">ezzerriyεeθ n qabiyl</para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 4:17" />yεacer qayiyn liweces taru Henuwk. yebne θemuwreθ ysemmat f ellesm n memmis, Henuwk. <verse eid="GEN 4:17" /><verse number="18" style="v" sid="GEN 4:18" />Henuwk yemmerwes εiyrad, uεiyrad ykan δdaddes n meHuwyaYiyl, meHuwyaYiyl ddaddes n metuwcaYiyl, metuwcaYiyl ddaddes n lamek. <verse eid="GEN 4:18" /><verse number="19" style="v" sid="GEN 4:19" />yeγ lamek sent δelwacun, εade dSile. <verse eid="GEN 4:19" /><verse number="20" style="v" sid="GEN 4:20" />εade taru yabal, eljed n ihelli εemren g tixyamin esrHen esεi. <verse eid="GEN 4:20" /><verse number="21" style="v" sid="GEN 4:21" />w enjes yuwbal emezwar g wewweθ f elεuwδ dezzef. <verse eid="GEN 4:21" /><verse number="22" style="v" sid="GEN 4:22" />Sile taru tuwbalqayiyn emezwar g wexδam n elmeεεuwn elkul n enHas duzzal. weltmas δniεme. <verse eid="GEN 4:22" /><verse number="23" style="v" sid="GEN 4:23" />yen lamek y elwacunes: «εade dSile, eslemtiyδ elwacun n lamek, esseγδeθ tuθleyiniyw. enγiyγ eryaz εlexaTer y kesriyδ, w eεezri εlexaTer yizemiyδ. <verse eid="GEN 4:23" /><verse number="24" style="v" sid="GEN 4:24" />iδekan elli δeyenγ qayiyn δeyemεaqeb sebεe merraθ, neč sebεe usebεiyn merre.»<verse eid="GEN 4:24" /></para>
  <para style="s">ezzerriyεeθ n ciyθ</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 4:25" />yεacer adem dliweces tikkelt xlaf, taru efruwx tsemmaθ ciyθ, ten: «yucayiyδ rebbi efruwx uggemxan n habiyl elli yenγi qayiyn.» <verse eid="GEN 4:25" /><verse number="26" style="v" sid="GEN 4:26" />ciyθ yemmerwes efruwx ysemmaθ enuwc, g elweqtdiyn bδan leεbaδ etnaben s ellesm n rebbi.<verse eid="GEN 4:26" /></para>
  <chapter eid="GEN 4" />
  <chapter number="5" style="c" sid="GEN 5" />
  <para style="s">idrari n adem</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 5:1" />tah elHkayeθ n elεiyleθ n adem. as elli yexleq rebbi bnaδem yegin m nette. <verse eid="GEN 5:1" /><verse number="2" style="v" sid="GEN 5:2" />yexleqθen edxer dennaθi. w as elli yexleqθen ibarexθen ysemmaθen adem. <verse eid="GEN 5:2" /><verse number="3" style="v" sid="GEN 5:3" />ykan elεmer n adem miyye utleθiyn sne elweqθelli yirew engluws yečebahes ysemmaθi ciyθ. <verse eid="GEN 5:3" /><verse number="4" style="v" sid="GEN 5:4" />liyyameθ n adem beεεeδ yirew ciyθ kanneθ θmenye miyye sne, yirew δiysen idrari ettengluwsin. <verse eid="GEN 5:4" /><verse number="5" style="v" sid="GEN 5:5" />ukanneθ liyyameθ elkul elli yedderθent adem tesεe miyye utleθiyn sne, yemmuwθ.<verse eid="GEN 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 5:6" />yedder ciyθ miyye uxemse sniyn, yaru enuwc. <verse eid="GEN 5:6" /><verse number="7" style="v" sid="GEN 5:7" />yedder ciyθ beεεeδ iyyiru enuwc θmenye miyye usebεe sniyn, yiru δiysen idrari ettengluwsin. <verse eid="GEN 5:7" /><verse number="8" style="v" sid="GEN 5:8" />ukanneθ liyyam n ciyθ elkul tesε miyye w eθnac n esne yemmuwθ. <verse eid="GEN 5:8" /><verse number="9" style="v" sid="GEN 5:9" />yedder enuwc tesεiyn esne yaru qiynan. <verse eid="GEN 5:9" /><verse number="10" style="v" sid="GEN 5:10" />yedder enuwc beεεeδ iyyiru qiynan xemse miyye uxemsTac n esne yaru δiysen idrari ettengluwsin. <verse eid="GEN 5:10" /><verse number="11" style="v" sid="GEN 5:11" />ukanneθ liyyam ennuwc elkul tesεe miyye uxemse sniyn yemmuwθ. <verse eid="GEN 5:11" /><verse number="12" style="v" sid="GEN 5:12" />yedder qiynan sebεiyn esne yaru mehlelliyl. <verse eid="GEN 5:12" /><verse number="13" style="v" sid="GEN 5:13" />yedder qiynan beεεeδ iyyiru mehlelliyl θmenye miyye w erbεiyn esne yaru δiysen idrari ettengluwsin, <verse eid="GEN 5:13" /><verse number="14" style="v" sid="GEN 5:14" />ukanneθ liyyam n qiynan elkul tesεe miyye uεecre sniyn yemmuwθ. <verse eid="GEN 5:14" /><verse number="15" style="v" sid="GEN 5:15" />yedder mehlelliyl xemse usettiyn esne, yaru yared. <verse eid="GEN 5:15" /><verse number="16" style="v" sid="GEN 5:16" />yedder mehlelliyl beεεeδ iyyiru yared θmenye miyye utleθiyn esne yaru δiysen idrari ettengluwsin. <verse eid="GEN 5:16" /><verse number="17" style="v" sid="GEN 5:17" />ukanneθ liyyam n mehlelliyl θmenye miyye uxemse utesεiyn esne yemmuwθ. <verse eid="GEN 5:17" /><verse number="18" style="v" sid="GEN 5:18" />yedder yared miyye w eθniyn usettiyn esne yaru exnuwx. <verse eid="GEN 5:18" /><verse number="19" style="v" sid="GEN 5:19" />yedder yared beεεeδ iyyiru exnuwx θmenye miyye esne yaru δiysen idrari ettengluwsin. <verse eid="GEN 5:19" /><verse number="20" style="v" sid="GEN 5:20" />ukanneθ liyyam n yared elkul tesεe miyye w eθniyn usettiyn esne yemmuwθ. <verse eid="GEN 5:20" /><verse number="21" style="v" sid="GEN 5:21" />yedder exnuwx xemse usettiyn esne yaru metuwcalex. <verse eid="GEN 5:21" /><verse number="22" style="v" sid="GEN 5:22" />yedder exnuwx beεεeδ iyyiru metuwcalex tlaθe miyye esne yaru δiysen idrari ettengluwsin. <verse eid="GEN 5:22" /><verse number="23" style="v" sid="GEN 5:23" />ukanneθ liyyam n exnuwx elkul tlaθe miyye uxemse usettiyn esne. <verse eid="GEN 5:23" /><verse number="24" style="v" sid="GEN 5:24" />yedder exnuwx w elbeεεeδ yemreq εlexaTer erreb yiwiθ tweliys. <verse eid="GEN 5:24" /><verse number="25" style="v" sid="GEN 5:25" />yedder metuwcalex miyye usebεe uθmenyiyn esne, yaru lamek. <verse eid="GEN 5:25" /><verse number="26" style="v" sid="GEN 5:26" />yedder metuwcalex beεεeδ iyyiru lamek sebεe miyye w eθniyn uθmenyiyn esne yaru δiysen idrari ettengluwsin. <verse eid="GEN 5:26" /><verse number="27" style="v" sid="GEN 5:27" />ukanneθ liyyam n metuwcalex elkul tesεe miyye utesεe usettiyn esne yemmuwθ. <verse eid="GEN 5:27" /><verse number="28" style="v" sid="GEN 5:28" />yelle eryaz esmiθes &lt;lamek&gt;. yuwγeδ engluws elweqθelli yiweD elεemres miyye w eθniyn w eθmenyiyn. <verse eid="GEN 5:28" /><verse number="29" style="v" sid="GEN 5:29" />«engluwse wahen semmiyxθi &lt;n uwH&gt; εlexaTer nette δexenyεezze g elqeεεeθ elli entezzel δefres, unetteθ eθrukkel sifesnenne εlexaTer rebbi yfud seg leεbeδes emuwHac.» <verse eid="GEN 5:29" /><verse number="30" style="v" sid="GEN 5:30" />yedder lamek xemse miyye uxemse utesεiyn εam beεδ iyemmaru nuwH. yirew δiys idrari egget. <verse eid="GEN 5:30" /><verse number="31" style="v" sid="GEN 5:31" />yemmuwθ lamek unette elεemres sebεe miyye usebεe usebεiyn εam. <verse eid="GEN 5:31" /><verse number="32" style="v" sid="GEN 5:32" />max i yiweD elεmer ennuwH xemse myat εam yeδwel γers tlaθe δidrari: sam, Ham dyafeθ.<verse eid="GEN 5:32" /></para>
  <chapter eid="GEN 5" />
  <chapter number="6" style="c" sid="GEN 6" />
  <para style="s">idrari n erreb dyessis n leεbaδ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 6:1" />max i xeθren leεbaδ, yrewen tingluwsin egget. <verse eid="GEN 6:1" /><verse number="2" style="v" sid="GEN 6:2" />esmaHneθ tingluwsin n leεbaδ g TiTTawin n idrari n imeqqaren elweqθes, egiyn delwacunensen max i xsen. <verse eid="GEN 6:2" /><verse number="3" style="v" sid="GEN 6:3" />yenne rebbi: «erruHiyw etqimiyc diyme etterre g leεbaδ f elli yuwHec, nihnin δemmuwθen uliyyemensen eltrenniyc exθer n miyye uεicriyn.» <verse eid="GEN 6:3" /><verse number="4" style="v" sid="GEN 6:4" />g elweqtdiyn wediyn yelle iryazen δelεuttay egget. beεδ iδuwδfen idrari n imeqqaren f tingluwsin n leεbaδ yemmerwasen idrari, eδwlen idreriye iyhen eyendeγ imeqqaren n elqeεεeθ. leεbaδ elkul esnenten.<verse eid="GEN 6:4" /></para>
  <para style="s">eTTuwfan</para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 6:5" />yezre rebbi elli elεmayel n leεbaδ xθerneθ g eddunyeθ w elli ettuxmemensen δettuxmem n ecciyĎan. <verse eid="GEN 6:5" /><verse number="6" style="v" sid="GEN 6:6" />ikezzem rebbi yendem egget εlexaTer yexleq leεbaδ. <verse eid="GEN 6:6" /><verse number="7" style="v" sid="GEN 6:7" />yenne rebbi: «δemeHqe elεebδ elli exelqexθi s uwδem n elqeεεeθ w iyδes leεbaδ elkul delhuwc emeqqar dumezyen detεaben diciciywen lexeTerni endeme elli exelqexθi.» <verse eid="GEN 6:7" /><verse number="8" style="v" sid="GEN 6:8" />yemenni rebbi yeqqiym yexs nuwH.<verse eid="GEN 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 6:9" />utahen δelHkayeθ ennuwH: ykan nuwH δenbi δeSSaleH uyessen rebbi egget. <verse eid="GEN 6:9" /><verse number="10" style="v" sid="GEN 6:10" />yirew nuwH tlaθe δidrari unihnin sam, Ham dyafeθ. <verse eid="GEN 6:10" /><verse number="11" style="v" sid="GEN 6:11" />max i xθerneθ elεmayel n leεbaδ, <verse eid="GEN 6:11" /><verse number="12" style="v" sid="GEN 6:12" />yezre rebbi elli eddunyeθ tefseδ lexaTer leεbaδ ebδen ečaθen g beεDhum. <verse eid="GEN 6:12" /><verse number="13" style="v" sid="GEN 6:13" />yenne rebbi y nuwH: «ellaxreθ n leεbaδ tiweD, lexeTerhum εebben eddunyeθ selεmeylensen ture δentemeHqe s elqeεεeθ. <verse eid="GEN 6:13" /><verse number="14" style="v" sid="GEN 6:14" />eg y imenex tefluwkθ δtemeqqarθ egget seg elluwH n esserwel tegeδ δiys tizeqwin enteδhneδ s ezzeft s ejjaj desberre. <verse eid="GEN 6:14" /><verse number="15" style="v" sid="GEN 6:15" />tegeδ max exenneγ: eTTules tlaθe myat δraε w elεerDes xemsiyn δraε w elεelwes tleθiyn δraε. <verse eid="GEN 6:15" /><verse number="16" style="v" sid="GEN 6:16" />eges eccebbax eγil s eddu n esqef delbab g eljneb n tefluwkθ. utefluwkθe θahen egiθ f etlaθe δeTTiyqen eTTeq elweddey w eTTeq g wemmes w eTTeq lennej. <verse eid="GEN 6:16" /><verse number="17" style="v" sid="GEN 6:17" />rahu neč δeseγerqe eddunyeθ s eTTuwfan n wamen bac e meHqe elli yetteθneffes s eddu ejenne usinc enγe elli yedder enni elqeεεeθ elkul. <verse eid="GEN 6:17" /><verse number="18" style="v" sid="GEN 6:18" />yemenni neč δemεahδe iyδex: aδef cex didreriyx dliwecex delwacun n idreriyx y tefluwkθ. <verse eid="GEN 6:18" /><verse number="19" style="v" sid="GEN 6:19" />awi iyδex g tefluwkθ elzuwz edxer dennaθi seg elhuwc elkul bac e θemneε usinc eθedder beεδ eTTuwfan. <verse eid="GEN 6:19" /><verse number="20" style="v" sid="GEN 6:20" />suwδef iyδex sen seg kul ennuwε s lenwaε n elhuwc usen seg kul ennuwε s lenwaε n etεaben usen seg kul ennuwε s lenwaε n iciciywen bac e ntmenεeδ iyδex usinc edderneθ diyme. <verse eid="GEN 6:20" /><verse number="21" style="v" sid="GEN 6:21" />teHrzeδ y imenex delli iyδex eče. texznetti γerx bac e ttegeδ δelεwin.» <verse eid="GEN 6:21" /><verse number="22" style="v" sid="GEN 6:22" />yege nuwH max i syenne rebbi.<verse eid="GEN 6:22" /></para>
  <chapter eid="GEN 6" />
  <chapter number="7" style="c" sid="GEN 7" />
  <para style="s">iĎlab n uεebbi n tefluwkθ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 7:1" />yenne rebbi y nuwH: «eyye, aδef cex delli ennex y tefluwkθ lexaTer ufiyγex cex w eHδex δeSSaleH g leεbaδ. <verse eid="GEN 7:1" /><verse number="2" style="v" sid="GEN 7:2" />awi iyδex seg kul ennuwε n elhuwc δeTTaher sebεe δedxuwr dsebεe δenwaθi, dsen edxer dennaθi seg kul ennuwε n elhuwc emenzuws, <verse eid="GEN 7:2" /><verse number="3" style="v" sid="GEN 7:3" />tawyeδ iyδex zade sebεe δedxuwr dsebεe δenwaθi seg kul ennuwε n iciciywen bac e θedder usinc eθexθer g elqeεεeθ. <verse eid="GEN 7:3" /><verse number="4" style="v" sid="GEN 7:4" />beεδ sebεe eyyam eseybe amzer erbεiyn yuwm δeggiyδ ddugges bac e meHqe kul cey yetteθneffes f uwδem n elqeεεeθ.» <verse eid="GEN 7:4" /><verse number="5" style="v" sid="GEN 7:5" />yege nuwH max i yenne rebbi.<verse eid="GEN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 7:6" />ykan elεmer ennuwH sette myat εam elweqθelli yewweθ eTTuwfan n wamen elqeεεeθ. <verse eid="GEN 7:6" /><verse number="7" style="v" sid="GEN 7:7" />yuwδef nuwH dliweces didreriys delwacunensen y tefluwkθ bac e menεen seg wamen n eTTuwfan <verse eid="GEN 7:7" /><verse number="8" style="v" sid="GEN 7:8" />uzade elhuwc diciciywen detεaben emenzuws deTTaher. <verse eid="GEN 7:8" /><verse number="9" style="v" sid="GEN 7:9" />uδefen dnuwH y tefluwkθ sen sen edxer dennaθi max i yenne rebbi y nuwH.<verse eid="GEN 7:9" /></para>
  <para style="s">eTTuwfan</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 7:10" />beεδ sebεe eyyam yfaD amen f elqeεεeθ elkul. <verse eid="GEN 7:10" /><verse number="11" style="v" sid="GEN 7:11" />g usukkes sette miyye s elεmer ennuwH, g weyyuwr eθθani g was sebeεtac, teqqeS θaδisθ n elqeεεeθ seg wamen, yewweθ amzer egget seg ejenne. <verse eid="GEN 7:11" /><verse number="12" style="v" sid="GEN 7:12" />yeqqiym eTTuwfan siyn erbεiyn yuwm δeggiyδ ddugges. <verse eid="GEN 7:12" /><verse number="13" style="v" sid="GEN 7:13" />g wasdiyn elli yersem δiys eTTuwfan, yuwδef nuwH dliweces didreriys sam, Ham dyafeθ delwacunensen y tefluwkθ. <verse eid="GEN 7:13" /><verse number="14" style="v" sid="GEN 7:14" />yaδef iyδsen elhuwc diciciywen detεaben seg lenwaε elkul. <verse eid="GEN 7:14" /><verse number="15" style="v" sid="GEN 7:15" />yuseδ elhuwc s lenwaε elkul y tefluwkθ yaδef dnuwH sen sen, <verse eid="GEN 7:15" /><verse number="16" style="v" sid="GEN 7:16" />edxer dennaθi uδefen max i syenne rebbi w elbeεδ isuwδef rebbi nuwH yer felles elbab n tefluwkθ.<verse eid="GEN 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 7:17" />yeqqiym eTTuwfan erbεiyn yuwm g elqeεεeθ, yexθer amen elmi ysuwli tefluwkθ lennej. <verse eid="GEN 7:17" /><verse number="18" style="v" sid="GEN 7:18" />yexθer amen yerni yuwli lennej elmi teδwel tefluwkθ ettesellef enni amen. <verse eid="GEN 7:18" /><verse number="19" style="v" sid="GEN 7:19" />amen yeδwel egget enni elqeεεeθ elmi yireD edhari elkul. <verse eid="GEN 7:19" /><verse number="20" style="v" sid="GEN 7:20" />yiweD elεelwes xemstac n eδraε enni edhari. <verse eid="GEN 7:20" /><verse number="21" style="v" sid="GEN 7:21" />elweqθes yemmuwθ kul cey yetteθneffes g eddunyeθ seg elhuwc diciciywen detεaben dleεbaδ. <verse eid="GEN 7:21" /><verse number="22" style="v" sid="GEN 7:22" />yemmuwθ kul cey eθedder g elqeεεeθ. <verse eid="GEN 7:22" /><verse number="23" style="v" sid="GEN 7:23" />yemHeq eTTuwfan seg uwδem n elqeεεeθ kul cey yetteθneffes leεbaδ, elhuwc, iciciywen detεaben. elkulhum emmuwθen w elyeqqiym kan nuwH delli iyδes g tefluwkθ. <verse eid="GEN 7:23" /><verse number="24" style="v" sid="GEN 7:24" />yeqqiym amen enni elqeεεeθ iθezzel miyye uxemsiyn yuwm.<verse eid="GEN 7:24" /></para>
  <chapter eid="GEN 7" />
  <chapter number="8" style="c" sid="GEN 8" />
  <para style="s">ennihayeθ n eTTuwfan</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 8:1" />yerni isekker rebbi nuwH delli iyδes s elhuwc g tefluwkθ iseyyeb aDu f edduwnyeθ bac e nqezen amen. <verse eid="GEN 8:1" /><verse number="2" style="v" sid="GEN 8:2" />emsekkerneθ tiHnayin elli tseyyebneθ g wamen delmizabeθ n ujenne elweqθes ibed amzer. <verse eid="GEN 8:2" /><verse number="3" style="v" sid="GEN 8:3" />yersem ineqqez amen s lewse s lewse. ubeεδ miyye uxemsiyn yuwm yenqez amen egget. <verse eid="GEN 8:3" /><verse number="4" style="v" sid="GEN 8:4" />g was sebeεtac g weyyuwr essabeε seg eTTuwfan eθbed θefluwktdiyn temeqqarθ f edhari n eraraT. <verse eid="GEN 8:4" /><verse number="5" style="v" sid="GEN 8:5" />yeqqiym amen ineqqez s lewse s lewse eliyyuwr elεacer g was emezwar s eyyuwr elεacer banen ixfawen n edhari.<verse eid="GEN 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 8:6" />beεδ erbεiyn yuwm xlaf imiyr nuwH eccebbax elli yegi qebl g tefluwkθ. <verse eid="GEN 8:6" /><verse number="7" style="v" sid="GEN 8:7" />iseyyeb nuwH elγreb, yeffeγ yesseylel yeqqiym ymerreq yθaseδ y tefluwkθ elmi icceH elqeεεeθ seg wamen. <verse eid="GEN 8:7" /><verse number="8" style="v" sid="GEN 8:8" />welbeεδ iseyyeb nuwH eδbiyr seg tefluwkθ bac e yenzi amen enqezen seg uwδem n elqeεεeθ ziyγ la. <verse eid="GEN 8:8" /><verse number="9" style="v" sid="GEN 8:9" />yemenni eδbiyr elyufiyc meni eyHuT ekreεes elweqθes yrewweH y nuwH g tefluwkθ lexaTer amen elluciyn yreDen uwδem n elqeεεeθ, yezzel nuwH efuses yewiθ ysuwδefθ iyδes y tefluwkθ. <verse eid="GEN 8:9" /><verse number="10" style="v" sid="GEN 8:10" />yraje nuwH sebεe eyyam xlaf welbeεδ yseyyeb eδbiyrdiyn elmerreθ xlaf seg tefluwkθ. <verse eid="GEN 8:10" /><verse number="11" style="v" sid="GEN 8:11" />g tisemsiyn yrewHes eδbiyr ugelmenqeres tefreyθ δteziyzewθ n uzemmuwr, elweqθes yefhem nuwH elli amen enqezen f uwδem elqeεεeθ. <verse eid="GEN 8:11" /><verse number="12" style="v" sid="GEN 8:12" />yeqqiym nuwH sebεe eyyam xlaf welbeεδ iseyyeb eδbiyrdiyn yemenni elmerreθe eseθrewweHc.<verse eid="GEN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 8:13" />g was emezwar s eyyuwr emezwar g usukkes iyjen dsette miyye s elεmer ennuwH eccaH elqeεεeθ seg wamen. yqam nuwH esqef n tefluwkθ yenzi y eddunyeθ, elweqθes yezre elli uwδem n elqeεεeθ yersem yečaH. <verse eid="GEN 8:13" /><verse number="14" style="v" sid="GEN 8:14" />yemenni elqeεεeθ elčaHc elkul kan g was sebεe uεicriyn s eyyuwr eθθani.<verse eid="GEN 8:14" /></para>
  <para style="s">effaγ seg tefluwkθ</para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 8:15" />yufley rebbi y nuwH yennayes: <verse eid="GEN 8:15" /><verse number="16" style="v" sid="GEN 8:16" />«effeγ s tefluwkθ cex dliwecex didreriyx delwacunensen. <verse eid="GEN 8:16" /><verse number="17" style="v" sid="GEN 8:17" />essuwfγeδ iyδex elli yetteθneffes elkul s elhuwc diciciywen detεaben bac e δarwen usinc exeθren g elqeεεeθ.» <verse eid="GEN 8:17" /><verse number="18" style="v" sid="GEN 8:18" />yeffeγ nuwH dliweces didreriys delwacunensen. <verse eid="GEN 8:18" /><verse number="19" style="v" sid="GEN 8:19" />yeffeγ iyδes kul cey yetteθneffes s elhuwc diciciywen detεaben dkul cey yetteθHerrex f elqeεεeθ. kul elmerreθ eyeffeγ ennuwε s elhuwc.<verse eid="GEN 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 8:20" />yebne nuwH elmeδbeH s elkurδ meni δeyeγres elhuwc y rebbi welbeεδ yexθar lewse n elhuwc diciciywen δeTThareθ. yeγresθent nuwH, iceεεel δiysneθ elεafyeθ beεδ intyuwyel f elmeδbeH. <verse eid="GEN 8:20" /><verse number="21" style="v" sid="GEN 8:21" />yeqbeltent rebbi unette δerraDi yenne g ules: &lt;meεεač eleεne eddunyeθ f elxaĎer n elεebδ lexaTer nette yetxemmem emecciyĎan s elli δemezyen, umeεεač emeHqe kul cey yetteθneffes max i giyγ. <verse eid="GEN 8:21" /><verse number="22" style="v" sid="GEN 8:22" />usinc eθeδwel liyyameθ n eddunyeθ elkulhi δazreε dwamjer, esemmiyδ desxaneθ, enebδu ettejresθ, as dδeggiyδ, uδeθeqqiym sah diyme.&gt;<verse eid="GEN 8:22" /></para>
  <chapter eid="GEN 8" />
  <chapter number="9" style="c" sid="GEN 9" />
  <para style="s">enniĎam δejδiyδ y elεalem</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 9:1" />ibarex rebbi nuwH didreriys yenneyasen: «arweθ, texθrem, tεebbem eddunyeθ <verse eid="GEN 9:1" /><verse number="2" style="v" sid="GEN 9:2" />rahu δeyukkeδ essiywem elhuwc n elqeεεeθ diciciywen n ujenne dkul cey yetteθHerrex f elqeεεeθ delHuwθ n iylel. uδeθeδwel elkulhe yxenyum. <verse eid="GEN 9:2" /><verse number="3" style="v" sid="GEN 9:3" />usinc eyeδwel kul cey yetteθHerrex δeče y xenyum, eθečem kul cey max i ttetem ezzerriyεeθ delxuDreθ teziyzewθ elli uciγawem. <verse eid="GEN 9:3" /><verse number="4" style="v" sid="GEN 9:4" />yemenni eθečemc exsum s iδemnes. <verse eid="GEN 9:4" /><verse number="5" style="v" sid="GEN 9:5" />uneč eHamiyγ fellawem s leεbaδ delhuwc uzade enecδe elεebδ f erruwH n yuwwes. <verse eid="GEN 9:5" /><verse number="6" style="v" sid="GEN 9:6" />welli eyenγ texrumt, eyemmenγ lexaTer erruwH n elεebδ δegliyw uneč elli exelqexθi. <verse eid="GEN 9:6" /><verse number="7" style="v" sid="GEN 9:7" />xenyum arweθ, texθrem, tεebbem eddunyeθ.»<verse eid="GEN 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 9:8" />yufley rebbi y nuwH didreriys iyδes yenneyasen: <verse eid="GEN 9:8" /><verse number="9" style="v" sid="GEN 9:9" />«neč δexenεahδe xenyum didreriywwem. <verse eid="GEN 9:9" /><verse number="10" style="v" sid="GEN 9:10" />uzade eεahδe iyδwem kul cey yetteθHerrex f elqeεεeθ seg iciciywen delhuwc delli yeffeγ iyδwem s tefluwkθ. <verse eid="GEN 9:10" /><verse number="11" style="v" sid="GEN 9:11" />exenεahδe elli eTTuwfan meεεač eyemHeq Hette iyjen, umeεεač eseybe eTTuwfan eyemHeq elqeεεeθ.» <verse eid="GEN 9:11" /><verse number="12" style="v" sid="GEN 9:12" />yenne rebbi: «wahen δellemareθ n elεehδiyw elli egiyxθi iyδwem delhuwc zade ellemareθ θahen δeθeqqiym diyme. <verse eid="GEN 9:12" /><verse number="13" style="v" sid="GEN 9:13" />eHuTTe elquws n erxe g ujenne δellemareθ n elεehδiyw iyδwem. <verse eid="GEN 9:13" /><verse number="14" style="v" sid="GEN 9:14" />max eyγeyyem esHab. usinc ayben elquws n erxe. <verse eid="GEN 9:14" /><verse number="15" style="v" sid="GEN 9:15" />rahu ettesfekkare g elεehδiyw iyδwem delhuwc elkul zade, elweqθes liδukkelc amen δeTTuwfan eyemHeq kul cey yetteθneffes g elqeεεeθ. <verse eid="GEN 9:15" /><verse number="16" style="v" sid="GEN 9:16" />max eyeffeγ elquws n erxe g esHab, eθezre esfekkre elεehδiyw elli δeyeqqiym diyme iyδwem dkul cey yetteθHerrex f elqeεεeθ.» <verse eid="GEN 9:16" /><verse number="17" style="v" sid="GEN 9:17" />yenne rebbi y nuwH: «θahen δellemareθ n elεehδiyw elli egiyxθi iyδwem dkul cey yetteθneffes f elqeεεeθ zade.»<verse eid="GEN 9:17" /></para>
  <para style="s">nuwH didreriys</para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 9:18" />idrari ennuwH elli effeγen iyδes s tefluwkθ nihnin sam, Ham dyafeθ. Ham wahen eyendeγ daddes n kenεan. <verse eid="GEN 9:18" /><verse number="19" style="v" sid="GEN 9:19" />iyhen δidrari ennuwH tlaθe elli usiynd essisen leεbaδ elkul.<verse eid="GEN 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 9:20" />yexδem nuwH g elflaHeθ yezzu elεneb. <verse eid="GEN 9:20" /><verse number="21" style="v" sid="GEN 9:21" />yeg sah yeswe ecrab elmi yesxer, yemεerre g wexyemes. <verse eid="GEN 9:21" /><verse number="22" style="v" sid="GEN 9:22" />yezre Ham daddes n ikenεaniyyen nuwH δeεeryan, yeffeγ yen y ewmeθnes elli elberre. <verse eid="GEN 9:22" /><verse number="23" style="v" sid="GEN 9:23" />elweqθes yqam sam dyafeθ edbac HuTTenti f lekθefensen ebδen egguwren timδefriyn etwali exyem, irDen daddensen welsundenc uδmewnensen bac e θzerrenc δeεeryan. <verse eid="GEN 9:23" /><verse number="24" style="v" sid="GEN 9:24" />max i yekker nuwH yesle mat iyege δiys memmis emezyen. <verse eid="GEN 9:24" /><verse number="25" style="v" sid="GEN 9:25" />yenne: «rebbi eyelεen kenεan, memmis n Ham, usinc eyeδwel exemmes n ixemmasen n ewmeθnes.» <verse eid="GEN 9:25" /><verse number="26" style="v" sid="GEN 9:26" />welbeεδ yenne: «eybarex rebbi sam, usinc eyeδwel kenεan δexemmes n sam. <verse eid="GEN 9:26" /><verse number="27" style="v" sid="GEN 9:27" />rebbi eywesseε f yafeθ usinc eyeεmer g ixyamen n sam ukenεan eyeδwel δexemmes n yafeθ.» <verse eid="GEN 9:27" /><verse number="28" style="v" sid="GEN 9:28" />yedder nuwH beεδ eTTuwfan tlaθe miyye uxemsiyn εam. <verse eid="GEN 9:28" /><verse number="29" style="v" sid="GEN 9:29" />yemmuwθ nuwH welεemres tesεe miyye uxemsiyn εam.<verse eid="GEN 9:29" /></para>
  <chapter eid="GEN 9" />
  <chapter number="10" style="c" sid="GEN 10" />
  <para style="s">elli εemren g elqeεεeθ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 10:1" />iyhen idrari n sam dHam dyafeθ idrari ennuwH delli yemmerwasen beεδ eTTuwfan. <verse eid="GEN 10:1" /><verse number="2" style="v" sid="GEN 10:2" />idrari n yafeθ: juwmer dmajuwj dmaday dyawan dtuwbal dmacek dtiyrasu. <verse eid="GEN 10:2" /><verse number="3" style="v" sid="GEN 10:3" />widrari n juwmer: eckenawu driyfaθu dtuwjermeh <verse eid="GEN 10:3" /><verse number="4" style="v" sid="GEN 10:4" />widrari n yawan: eliyceh dterciyc dkittiym dduwdaniym. <verse eid="GEN 10:4" /><verse number="5" style="v" sid="GEN 10:5" />seg iyh mferreqneθ ellummaθ n elbHer g timurensen delqbeylensen, kul eljmeεεeθ f elHseb n elluγθensen.<verse eid="GEN 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 10:6" />widrari n ham: kuwc dmirayem dfuwT dkenεan. <verse eid="GEN 10:6" /><verse number="7" style="v" sid="GEN 10:7" />widrari n kuwc seba deHwiyle dsebteh dreεmeh dseteka. widrari n reεmeh: ceba ddedanu. <verse eid="GEN 10:7" /><verse number="8" style="v" sid="GEN 10:8" />ukuwc yiru nimruwd, ewwel meθjebber g elqeεεeθ. <verse eid="GEN 10:8" /><verse number="9" style="v" sid="GEN 10:9" />w ykan deSeyyaδ dejebbar ezzaθ n erreb, heδake εlac eqqaren emnemruwd, eSeyyaδ δejebbar ewwaθ n erreb. <verse eid="GEN 10:9" /><verse number="10" style="v" sid="GEN 10:10" />ebδaneθ elmemlkaθ n babel dYarek dYaked, welkulhum g elqeεεeθ n cenεar. <verse eid="GEN 10:10" /><verse number="11" style="v" sid="GEN 10:11" />seg lqeεεetdiyn yeffeγ yecuwr debni niynwi dreHbuwt εiyr dkaleH <verse eid="GEN 10:11" /><verse number="12" style="v" sid="GEN 10:12" />dresen elli jar niynwi dkaleH, unetteθ θemuwreθ temeqqarθ. <verse eid="GEN 10:12" /><verse number="13" style="v" sid="GEN 10:13" />umiSrayem yiru bni luwd dεenam dlehab dneftuwH <verse eid="GEN 10:13" /><verse number="14" style="v" sid="GEN 10:14" />dfetruws dkesluwj, yaru keftuwr elli effeγen essisen ifilesTiniyyen. <verse eid="GEN 10:14" /><verse number="15" style="v" sid="GEN 10:15" />ukenεan yiru Siyduwn emenzuyes, dHiθθe <verse eid="GEN 10:15" /><verse number="16" style="v" sid="GEN 10:16" />diyyebuwsiyyen dimuriyyen dijerjeciyyen <verse eid="GEN 10:16" /><verse number="17" style="v" sid="GEN 10:17" />diHiwwiyyen diεerqeyyen disenniyyen <verse eid="GEN 10:17" /><verse number="18" style="v" sid="GEN 10:18" />diYirwediyyen diSimmariyyen diHimmatiyyen. welbeεεeδ mferreθneθ elqbayel n ikenεaniyyen. <verse eid="GEN 10:18" /><verse number="19" style="v" sid="GEN 10:19" />weθkan elqeεεeθ n ikenεaniyyen seg Siyduwn y ecciyreθnejrar dγezze, welbeεεeδ y ecciyreθ n seduwm deεmuwre dYedme deSbuwyiym ellaceε. <verse eid="GEN 10:19" /><verse number="20" style="v" sid="GEN 10:20" />iyh didrari n Ham etmurensen delqbeylensen kul eljmeεεeθ f elHesb n elluγθensen.<verse eid="GEN 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 10:21" />yuγeδ sam zade idrari, unette ddaddes n ebni εaber elkul weδyuwwes n yafeθ emeqqar. <verse eid="GEN 10:21" /><verse number="22" style="v" sid="GEN 10:22" />widrari n sam: εiylam dYecuwr dYerfekcad dluwd dYeram. <verse eid="GEN 10:22" /><verse number="23" style="v" sid="GEN 10:23" />widrari n Yeram: εuwS dHuwl djaθer dmacu. <verse eid="GEN 10:23" /><verse number="24" style="v" sid="GEN 10:24" />uYerfekcad yiru caleH, ucaleH yiru εaber. <verse eid="GEN 10:24" /><verse number="25" style="v" sid="GEN 10:25" />yaγeδ εaber sen δidrari iyjen essisen esmiθes falij, εlexaTer g liyyemestemzuwn lqeεεeθ, wellesm n yuwwes yeqTan. <verse eid="GEN 10:25" /><verse number="26" style="v" sid="GEN 10:26" />uyeqTan yiru elmuwdad dcalef dHeDremuwt dyareH <verse eid="GEN 10:26" /><verse number="27" style="v" sid="GEN 10:27" />dheduwram dYewzal ddiqle <verse eid="GEN 10:27" /><verse number="28" style="v" sid="GEN 10:28" />dεuwbal dYebiymayil dceba <verse eid="GEN 10:28" /><verse number="29" style="v" sid="GEN 10:29" />uYuwfiyr deHwiyle dyuwbab. iyh elkul debni yeqTan. <verse eid="GEN 10:29" /><verse number="30" style="v" sid="GEN 10:30" />ukanen εemren seg miyca y ecciyreθ n sefar y eddehreθ n eccerq. <verse eid="GEN 10:30" /><verse number="31" style="v" sid="GEN 10:31" />iyh debni sam s eθmurensen delqbeylensen kul eljmeεεeθ f elHesb n elluγθensen. <verse eid="GEN 10:31" /><verse number="32" style="v" sid="GEN 10:32" />θiyhen δelqbayel elli useδneθ s idrari ennuwH essisneθ xθerneθ timuwre g elqeεεeθ beεδ eTTuwfan.<verse eid="GEN 10:32" /></para>
  <chapter eid="GEN 10" />
  <chapter number="11" style="c" sid="GEN 11" />
  <para style="s">elburj n babel</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 11:1" />ukanen leεbaδ n eddunyeθ elkul γersen elluwγeθ icθ d edwi iyjen. <verse eid="GEN 11:1" /><verse number="2" style="v" sid="GEN 11:2" />w max i reHlen seg elmecreq ufiyn θbuqεet g elqeεεeθ n cinεar, eεmren diyn. <verse eid="GEN 11:2" /><verse number="3" style="v" sid="GEN 11:3" />ennen y beεDhum: «eyye eneSneε ellebne usinc eθnecwe.» egen ellebne g elεuwD n elkurδ wecal ezukkaγ g elεuwD n eTTiyn. <verse eid="GEN 11:3" /><verse number="4" style="v" sid="GEN 11:4" />ennen: «eyye enebne y imenenne elmdiyneθ delburj ixfes g ujenne. neg y imenenne ellesm w en-nettemferriθ-c f uwδem n elqeεεeθ elkulhe.» <verse eid="GEN 11:4" /><verse number="5" style="v" sid="GEN 11:5" />yeggew erreb eyenzi elmdiyneθ d elburj elli kanen idrari n Yadem bennan δiys, <verse eid="GEN 11:5" /><verse number="6" style="v" sid="GEN 11:6" />yen erreb «Tay nihnin ecceεb iyjen, γersen elluwγeθ icθ! wah elli θegen δiys d elbδu, w meεεač eyeSεab fellasen ci seg elli exsen eθegen! <verse eid="GEN 11:6" /><verse number="7" style="v" sid="GEN 11:7" />edj eneggez n suδef elluγθensen g beεDhe, bac Hette Hed wel-ifehhem elluwγeθ n wissen.» <verse eid="GEN 11:7" /><verse number="8" style="v" sid="GEN 11:8" />yferretten erreb esyiyn f uwδem n elqeεεeθ elkulhe, beTlen seg elbni n elmdiyneθ. <verse eid="GEN 11:8" /><verse number="9" style="v" sid="GEN 11:9" />heδake εlac θemsemme babel, εlexaTer diyn erreb y belbel elluwγeθ n leεbaδ elkul, w esyiyn yferretten f uwδem n elqeεεeθ elkul.<verse eid="GEN 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 11:10" />iyh idrari n sam: max i ykan sam δ emmiys n myat esne yiru erfekcad beεεeδ eTTuwfan s εemiyn. <verse eid="GEN 11:10" /><verse number="11" style="v" sid="GEN 11:11" />yedder sam beεεeδ i yiru erfekcad xemse miyye esne, yaru idrari ettengluws-in. <verse eid="GEN 11:11" /><verse number="12" style="v" sid="GEN 11:12" />yedder erfekcad xemse w tleθiyn esne yaru caleH. <verse eid="GEN 11:12" /><verse number="13" style="v" sid="GEN 11:13" />yedder erfekcad beεεeδ i yiru caleH erbεe miyye w tlaθe sniyn, yaru idrari ettengluws-in. <verse eid="GEN 11:13" /><verse number="14" style="v" sid="GEN 11:14" />yedder caleH tleθiyn esne yaru εaber. <verse eid="GEN 11:14" /><verse number="15" style="v" sid="GEN 11:15" />yedder caleH beεεeδ i yiru εaber erbεe miyye w tlaθe sniyn yaru idrari ettengluws-in. <verse eid="GEN 11:15" /><verse number="16" style="v" sid="GEN 11:16" />yedder εaber erbεe utleθiyn esne yaru falej. <verse eid="GEN 11:16" /><verse number="17" style="v" sid="GEN 11:17" />yedder εaber beεεeδ i yiru falej erbεe miyye w tleθiyn esne yaru idrari ettengluws-in. <verse eid="GEN 11:17" /><verse number="18" style="v" sid="GEN 11:18" />yedder falej tleθiyn esne yaru reεuw. <verse eid="GEN 11:18" /><verse number="19" style="v" sid="GEN 11:19" />yedder falej beεεeδ i yiru reεuw miytiyn w tesεe sniyn yaru idrari ettengluws-in. <verse eid="GEN 11:19" /><verse number="20" style="v" sid="GEN 11:20" />yedder reεuw θniyn w tleθiyn esne yaru seruwj. <verse eid="GEN 11:20" /><verse number="21" style="v" sid="GEN 11:21" />yedder reεuw beεεeδ i yiru seruwj miytiyn w sebεe sniyn yaru idrari ettengluws-in. <verse eid="GEN 11:21" /><verse number="22" style="v" sid="GEN 11:22" />yedder seruwj tleθiyn esne yaru naHuwr. <verse eid="GEN 11:22" /><verse number="23" style="v" sid="GEN 11:23" />yedder seruwj beεεeδ i yiru naHuwr miytiyn esne, yaru idrari ettengluws-in. <verse eid="GEN 11:23" /><verse number="24" style="v" sid="GEN 11:24" />yedder naHuwr tesεe uεicriyn esne yaru tareH. <verse eid="GEN 11:24" /><verse number="25" style="v" sid="GEN 11:25" />yedder naHuwr beεεeδ i yiru tareH miyye w tesεtac esne, yaru idrari ettengluws-in. <verse eid="GEN 11:25" /><verse number="26" style="v" sid="GEN 11:26" />yedder tareH sebεiyn esne yaru ebram d naHuwr d haran.<verse eid="GEN 11:26" /></para>
  <para style="s">idrari n tareH</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 11:27" />θahen δ elHkayeθ n elεiyleθ n tareH. tareH yuwγeδ ebram d naHuwr d haran. haran yuwγeδ luwT. <verse eid="GEN 11:27" /><verse number="28" style="v" sid="GEN 11:28" />haran yjaf qebl daddes tareH g uwr n ikeldaniy-en meni I yemmaru. <verse eid="GEN 11:28" /><verse number="29" style="v" sid="GEN 11:29" />ebram d naHuwr uγiyn kul iyjen temeTTuwθ. liwec n ebram ellesmes saray. w liwec ennaHuwr ellesmes milkeh yellis n haran daddes n iskeh zade. <verse eid="GEN 11:29" /><verse number="30" style="v" sid="GEN 11:30" />saray eθkan etteruwc. <verse eid="GEN 11:30" /><verse number="31" style="v" sid="GEN 11:31" />tareH yiwi memmis ebram d luwT memmis n memmis haran d saray tesliθ-es liwec n memmis ebram. yerHel essis-en seg uwr n ikeldaniy-en y elqeεεeθ n kenεan yaxi max i δiwDen g Haran eqqiymen diyn. <verse eid="GEN 11:31" /><verse number="32" style="v" sid="GEN 11:32" />tareH yjaf diyn w elεemres myet-in w xemse.<verse eid="GEN 11:32" /></para>
  <chapter eid="GEN 11" />
  <chapter number="12" style="c" sid="GEN 12" />
  <para style="s">erreb yetnabe g seyyedne ibrahiym</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 12:1" />rebbi (elli diyme nette) yennayes y ebram: «qam imenex tedjeδ elqeεθex d midnex delHuwc n daddex. temreqeδ y elqeεεeθ elli δxessexne. <verse eid="GEN 12:1" /><verse number="2" style="v" sid="GEN 12:2" />δege essix midden egget uδebarxe δiyx edje ellesmex δemeqqarθ ufelxaĎrex δebarxe g leεbaδ xlaf. <verse eid="GEN 12:2" /><verse number="3" style="v" sid="GEN 12:3" />δebarxe g ihelli etberexnex uδeleεne ihelli etsubben δiyx, wessix δcex δebarxe g leεbaδ n eddunyeθ elkul.» <verse eid="GEN 12:3" /><verse number="4" style="v" sid="GEN 12:4" />yerHel ebram emmax i syenne rebbi, elweqθes ebram γers xemse usebεiyn sne max i yeffeγ seg Haran. <verse eid="GEN 12:4" /><verse number="5" style="v" sid="GEN 12:5" />yawi iyδes saray liweces dluwT memmis enjenjwes delli layment elkul dleεbaδ elli γersen g Haran. exDmen y elqeεεeθ n kenεan. max i θiwDen diyn, <verse eid="GEN 12:5" /><verse number="6" style="v" sid="GEN 12:6" />ebram yuyuwr g elqeεεeθ eδeyaweδ y eccejreθ temeqqarθ n muwre g eckiym. elweqθes ikenεaniyyen εemren g elqeεεetdiyn. <verse eid="GEN 12:6" /><verse number="7" style="v" sid="GEN 12:7" />yeffeγes rebbi y ebram y ennes: «y idreriyx δeθuwce elqeεεeθ.» yebne ebram emxan n waγres y rebbi g wemxan elli yeθheyYes δiys. <verse eid="GEN 12:7" /><verse number="8" style="v" sid="GEN 12:8" />esyiyn yexDem y edhari g eccerq n biytiyl. yenSeb exyemes mabiyn biytiyl seg eggaz n tefuwθ uεay seg aqqes. yebne diyn elmeδbeH y rebbi. yeδεu s ellesmes.<note caller="+" style="x"><char style="xo" closed="false">12.8 </char><char style="xt" closed="false"><ref loc="GEN 4:26">4.26</ref>; <ref loc="GEN 13:4">13.4</ref>.</char></note> <verse eid="GEN 12:8" /><verse number="9" style="v" sid="GEN 12:9" />yeqqiym yreHHel y etwali eSSeHreθ n enneqeb.<verse eid="GEN 12:9" /></para>
  <para style="s">seyyedne ibrahiym g miSr</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 12:10" />teseδ elmejaεeθ g kenεan, yeggez ebram y etwali miSr bac e yedder lewse diyn εlexaTer elmejaεeθ teqSeH egget. <verse eid="GEN 12:10" /><verse number="11" style="v" sid="GEN 12:11" />max i yiweD y etwali miSr y ennayes y liweces saray: «tesseneδ elli cem tebhiyδ. <verse eid="GEN 12:11" /><verse number="12" style="v" sid="GEN 12:12" />umax emezren imiSriyyen δennen, &lt;θahen δliweces.&gt; usiyn δeyyenγen edjnem cem <verse eid="GEN 12:12" /><verse number="13" style="v" sid="GEN 12:13" />eg elmziyyeθ ennasen elli cem δweltme<note caller="+" style="f"><char style="fr" closed="false">12.13 </char><char style="ft" closed="false">20.12</char></note> f elxeĎrem δeyyedjen eddere uδeyεamlen belgde.» <verse eid="GEN 12:13" /><verse number="14" style="v" sid="GEN 12:14" />max i yuwδef y miSr, imiSriyyen zriyn elli netteθ δtemeTTuwθ tebhe egget. <verse eid="GEN 12:14" /><verse number="15" style="v" sid="GEN 12:15" />ixeddamen n ferεuwn zrint zade ecxerent y etweliys ewyent y elHuces. <verse eid="GEN 12:15" /><verse number="16" style="v" sid="GEN 12:16" />f elxeĎres ferεuwn yεamel ebram belgde yeδwel γers esεi difunasen diγyal ettiγyal dixeddamen etxeddamin dileγman. <verse eid="GEN 12:16" /><verse number="17" style="v" sid="GEN 12:17" />emme rebbi yesebben egget ferεuwn dmidden n elHuces f elxaĎer n saray liwec n ebram. <verse eid="GEN 12:17" /><verse number="18" style="v" sid="GEN 12:18" />inabe ferεuwn ebram yennes: «δmette iθegiδ? imette eyθenniyc elli netteθ δliwecex? <verse eid="GEN 12:18" /><verse number="19" style="v" sid="GEN 12:19" />imette iθenniyδ elli netteθ δweltmax? ewiyt bac e θeδwel δliweciyw. tayet liwecex ewiyt texDmeδ.» <verse eid="GEN 12:19" /><verse number="20" style="v" sid="GEN 12:20" />yweSSe ferεuwn ixeddemnes f ebram ceyεent nette dliweces delli γers elkul.<verse eid="GEN 12:20" /></para>
  <chapter eid="GEN 12" />
  <chapter number="13" style="c" sid="GEN 13" />
  <para style="s">efareq n seyyedne ibrahiym dluwT</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 13:1" />yali ebram seg miSr y etwali eSSeHreθ n enneqeb, nette dliweces dluwT delli γers elkul. <verse eid="GEN 13:1" /><verse number="2" style="v" sid="GEN 13:2" />w ykan ebram δemuγni, γers egget esεi delfeTTeθ duwreγ. <verse eid="GEN 13:2" /><verse number="3" style="v" sid="GEN 13:3" />y eqqiym yetHewwel seg wemxan y wemxan eδeyaweδ meni iykan yenSeb exyemes mabiyn biytiyl dεay. <verse eid="GEN 13:3" /><verse number="4" style="v" sid="GEN 13:4" />uyebne elmeδbeH y rebbi. udiyn yeδεu s ellesmes.<verse eid="GEN 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 13:5" />uluwT elli yexDem iyδes ykan γers Hette nette esεi difunasen dixyamen. <verse eid="GEN 13:5" /><verse number="6" style="v" sid="GEN 13:6" />tεebbe elqeεθes essisen jmiyε εlexaTer ykan γersen egget elmelx. <verse eid="GEN 13:6" /><verse number="7" style="v" sid="GEN 13:7" />ikenεaniyyen diferziyyen kanen εemren g elqeεεetdiyn zade emεarxen iniylten n ebram diniylten n luwT. <verse eid="GEN 13:7" /><verse number="8" style="v" sid="GEN 13:8" />yen ebram y luwT: «nečin neqreb ibeεDne mayelzemc eySar elεerx mabinatne ziyγ mabiyn inilteniyw diniltenex. <verse eid="GEN 13:8" /><verse number="9" style="v" sid="GEN 13:9" />elqeεεeθ elkulhe ezzeθex. berre felle emmale. kan δeθexDmeδ y elisar, exemme y elimiyn. ukan δeθexDmeδ y elimiyn, exemme y elisar.» <verse eid="GEN 13:9" /><verse number="10" style="v" sid="GEN 13:10" />max i yqam luwT tiTTewines yezr teHmiylt n esuwf n elurdun δiys egget amen y etwali Suwγer, emtejnint n rebbi, emenniyl n miSr. wahen ykan qebl eyxerreb rebbi seduwm deεmuwreh. <verse eid="GEN 13:10" /><verse number="11" style="v" sid="GEN 13:11" />yexθar luwT teHmiylt n elurdun elkulhe yqebbel y etwali aqqes n tefuwθ. usahen emfarqen f beεDhum. <verse eid="GEN 13:11" /><verse number="12" style="v" sid="GEN 13:12" />yeεmer ebram g elqeεεeθ n kenεan, uluwT g timuwre n teHmiylt iHewwel exyemes y etwali seduwm. <verse eid="GEN 13:12" /><verse number="13" style="v" sid="GEN 13:13" />elweqθes leεbaδ n seduwm kanen uHecen egget γer rebbi y erδayel elli ettegen δiysneθ.<verse eid="GEN 13:13" /></para>
  <para style="s">seyyedne ibrahiym g Hebruwn</para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 13:14" />rebbi yennayes y ebram beεεeδ i yexDem felles luwT: «qam tiTTewinex, terqbeδ seg emxan elli δiys cex, cemal jenuwb, aqqes dweggaz n tefuwθ. <verse eid="GEN 13:14" /><verse number="15" style="v" sid="GEN 13:15" />elqeεεeθ elli tzerreδ δiys elkul δexettuwce icex didreriyx baqi. <verse eid="GEN 13:15" /><verse number="16" style="v" sid="GEN 13:16" />uδedje idreriyx emelHebbaθ n ecal. wiδekan yelle iyjen iged eyeHseb elHebbaθ n ecal rahu iged eyeHseb idreriyx. <verse eid="GEN 13:16" /><verse number="17" style="v" sid="GEN 13:17" />uwreδ g eTTuwl n elqeεεeθ delεerDes εlexaTer icex δettuwce icex.» <verse eid="GEN 13:17" /><verse number="18" style="v" sid="GEN 13:18" />iHewwel ebram exyemes yenSebθ g teHmiylt n memra g Hebruwn. yebne diyn elmeδbeH y rebbi.<verse eid="GEN 13:18" /></para>
  <chapter eid="GEN 13" />
  <chapter number="14" style="c" sid="GEN 14" />
  <para style="s">seyyedne ibrahiym ysemneε luwT</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 14:1" />g elweqtdiyn, emrafel elmlek n cenεar deryuwk elmlek n alasar dkederleεewmer elmlek n εiylam ettedεal elmlek n juwyiym. <verse eid="GEN 14:1" /><verse number="2" style="v" sid="GEN 14:2" />xDemen δeHarben bareε elmlek n seduwm dbercaε elmlek n eεmuwreh dcinab elmlek n edmeh dcemiber elmlek n eSbuwyiym delmlek n baleε elli teδwel δSuwγer. <verse eid="GEN 14:2" /><verse number="3" style="v" sid="GEN 14:3" />y iyhen elkul emlaymen g esuwf n esseddiym elli nette δiylel n tisent. <verse eid="GEN 14:3" /><verse number="4" style="v" sid="GEN 14:4" />eqqiymen eθnac n esne xeδmen g kederleεewmer ugusukkes θleTTac enneDen felles. <verse eid="GEN 14:4" /><verse number="5" style="v" sid="GEN 14:5" />usiyn g usukkes erbeεtac emlaymen kederleεewmer dlemluwk elli iyδes eγelben ireffiyyen g εectaruwθ qernayim, dizuwziyyen g ham, dimiyyen g teHmiylt n qiryetayim. <verse eid="GEN 14:5" /><verse number="6" style="v" sid="GEN 14:6" />diHuwriyyen g eddehrθensen sεiyr eθbεenten y teHmiylt n faran g elHed n eSSeHreθ. <verse eid="GEN 14:6" /><verse number="7" style="v" sid="GEN 14:7" />g webriδ n warjeε θεedden f εiyn micfaT, elli teδwel δqadec, exlen θemuwreθ n elεemalqe elkul delemuwriyiyn elli εemren g HeSSuwn tamar. <verse eid="GEN 14:7" /><verse number="8" style="v" sid="GEN 14:8" />yeffeγ elmlek n seduwm delmlek n eεmuwreh delmlek n edmeh delmlek n eSbuwyiym delmlek n baleε elli teδwel δSuwγer. emHarben g esuwf n esseddiym. <verse eid="GEN 14:8" /><verse number="9" style="v" sid="GEN 14:9" />nihnin dkederleεewmer elmlek n εiylam ettedεal elmlek n juwyiym demrafel elmlek n cenεar deryuwk elmlek n alasar, g eSSed n erbεe δlemluwk δimeqqaren, xemse δlemluwk δimezyanen efγen δeHarben. <verse eid="GEN 14:9" /><verse number="10" style="v" sid="GEN 14:10" />esuwf n esseddiym ykan iεebbe anu n ezzeft, max i ruwlen lemluwk n seduwm deεmuwreh, negzen bac e εeglen. emme elbaqi erwelen y edhari. <verse eid="GEN 14:10" /><verse number="11" style="v" sid="GEN 14:11" />lemluwk lerbεe iwiyen kul cey seg seduwm deεmuwreh Hette δeče, exeDmen. <verse eid="GEN 14:11" /><verse number="12" style="v" sid="GEN 14:12" />iwiyen zade luwT memmis n yuwwes n ebram elli iεemmer g esduwm. ewyen elli γers elkul exDmen. <verse eid="GEN 14:12" /><verse number="13" style="v" sid="GEN 14:13" />iyjen seg ihelli mneεen yuseδ y ebram elεibrani elli elyuwc iεemmer y etwali eccejreθ n elbeluwT egli n memra elemuwri yuwwes n eckuwl dεaner elli θfahmen δeεewnen beεDhum g elHerb. <verse eid="GEN 14:13" /><verse number="14" style="v" sid="GEN 14:14" />max i yesle ebram elli memmis n yuwwes iwyent, inabe elεzerre imδerben elli emmarwen g elHuces elkul welεδeδensen tlaθe miyye uθemenTac yeθbeεθen eδeyaweδ y dan. <verse eid="GEN 14:14" /><verse number="15" style="v" sid="GEN 14:15" />g δeggiyδ, ebram izuwn elli iyδes eγlbenten HaSrenten elHuwbe cemal dimecq. <verse eid="GEN 14:15" /><verse number="16" style="v" sid="GEN 14:16" />yaγeδ elli iwyent elkul dluwT memmis n yuwwes delli ywinasθ elkul delwacun dleεbaδ elkul.<verse eid="GEN 14:16" /></para>
  <para style="s">melkiSadeq</para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 14:17" />beεεeδ iyeγleb kederleεewmer dlemluwk elli iyδes, ebram yrewweH elmeniy iykan iεemmer. g webriδes yeffeγes elmlek n seduwm bac e θilaqe g esuwf n ecwe elli yeδwel δesuwf n elmlek. <verse eid="GEN 14:17" /><verse number="18" style="v" sid="GEN 14:18" />usiyn yuγeδes melkiSadeq elmlek n saliym elli ykan iδukke f ellesm n midden ezzaθ n rebbi elli kamel eεle, eγrum decrab. <verse eid="GEN 14:18" /><verse number="19" style="v" sid="GEN 14:19" />ibarexθ yennes: «eybarex δiyx rebbi elli kamel eεle elli yexleq esmawaθ delqeεεeθ. <verse eid="GEN 14:19" /><verse number="20" style="v" sid="GEN 14:20" />wetbark elleh elli yuγeδ elεδewwex y etwali ifesnex.» yuwces ebram elεcer n elli yiwiθ. <verse eid="GEN 14:20" /><verse number="21" style="v" sid="GEN 14:21" />yaxi elmlek n seduwm yennayes y ebram: «uciyδ leεbaδ berk, tedjeδ elbaqi icex.» <verse eid="GEN 14:21" /><verse number="22" style="v" sid="GEN 14:22" />yennes ebram: «eθjulle y rebbi elli kamel eεle elli yexleq esmawaθ delqeεεeθ <verse eid="GEN 14:22" /><verse number="23" style="v" sid="GEN 14:23" />elli elliwiyac Hette δtilelli n eSSebbaĎ δegliyx bac e lteqqarec, &lt;neč erriyγ ebram δemuγni.&gt; <verse eid="GEN 14:23" /><verse number="24" style="v" sid="GEN 14:24" />δeθewye kan δmette ečen elεzerre δelbay n iryazen elli xDemen iyδi, εaner deckuwl dmemra yelzem eδewyen elbeyensen.»<verse eid="GEN 14:24" /></para>
  <chapter eid="GEN 14" />
  <chapter number="15" style="c" sid="GEN 15" />
  <para style="s">elweεδ n erreb y seyyedne ibrahiym</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 15:1" />beεεeδ wahen elkul rebbi yuseδes y ebram emtirjiyθ yennes: «eθukδec, ebram, δeεusse fellex, ellejrex δemeqqar egget.» <verse eid="GEN 15:1" /><verse number="2" style="v" sid="GEN 15:2" />yennes ebram: «ya rebbi siydiy, δmette δeyθuwceδ w neč elγriyc idrari welli δeyuwreθ nette δeliyεazer eddimecqiy?» <verse eid="GEN 15:2" /><verse number="3" style="v" sid="GEN 15:3" />yennayes xlaf: «eyθuwciyδ Hette efruwx, utay exeddam yemmaru g elHuciyw ennette δeyuwreθ beεδ emmuwθe.» <verse eid="GEN 15:3" /><verse number="4" style="v" sid="GEN 15:4" />yennes rebbi: «eryaz exywerreθc, emme elli δexyemmaru nette elli δexyuwreθ.» <verse eid="GEN 15:4" /><verse number="5" style="v" sid="GEN 15:5" />yessufeγθ rebbi elberre yennes: «erqeb lennej teHsbeδ iθran, iδekan eθgeddeδ enteHsbeδ. idreriyx δekuwnen siyn.» <verse eid="GEN 15:5" /><verse number="6" style="v" sid="GEN 15:6" />yuwce eθθiyqeθ y rebbi elli yeHsbest δelHesneθ. <verse eid="GEN 15:6" /><verse number="7" style="v" sid="GEN 15:7" />yennes: «neč δerreb elli yuγeδex seg uwr n ikeldaniyyen bac e xuwce elqeεεeθe bac e ttemlxeδ.» <verse eid="GEN 15:7" /><verse number="8" style="v" sid="GEN 15:8" />yaxi yenceδt: «ya rebbi siydiy, max δesne elli neč δettemlxe?» <verse eid="GEN 15:8" /><verse number="9" style="v" sid="GEN 15:9" />ijewebθ rebbi: «eγδiyδ teyenduwzθ ettixsi delkebc elεemrensen tlaθe sniyn etmelle etteδbiyrθ temezyent.» <verse eid="GEN 15:9" /><verse number="10" style="v" sid="GEN 15:10" />yeγetten yeγresθen elkul yzuwnin f sen yHuT kul ezyen yqabel wissen. kan δizenniwen ennizuwnc. <verse eid="GEN 15:10" /><verse number="11" style="v" sid="GEN 15:11" />umax i bδen elεgabaθ ettegzen bac e čen, ygellebθen ebram. <verse eid="GEN 15:11" /><verse number="12" style="v" sid="GEN 15:12" />umax i θebδe tefuwθ δeθeggez, ebram yeγlebθ enuddem, usiyn tireDt tsellesθ δtimδellemt egget uθessekkeδ. <verse eid="GEN 15:12" /><verse number="13" style="v" sid="GEN 15:13" />yennes rebbi: «yelzem eθesneδ elli idreriyx δeθγerben g elqeεεeθ muc δeglinsen uδebδan δixδiymen diyn uδagen δiysen erbεe myat sne. <verse eid="GEN 15:13" /><verse number="14" style="v" sid="GEN 15:14" />uδesubbe ihelli sθeεbδenten, usiyn δefγen s elmelx egget. <verse eid="GEN 15:14" /><verse number="15" style="v" sid="GEN 15:15" />emme cex eθedreδ egget, ubeεεeδ i θjafeδ usiyn etemmerδmeδ merθaH. <verse eid="GEN 15:15" /><verse number="16" style="v" sid="GEN 15:16" />unihnin δeδuwlen eldahen g eljiyl errabeε εlexaTer elγeldeθ n leεbaδ elli edderen dah eltuwc eltuqiyc bac e ntHakme.» <verse eid="GEN 15:16" /><verse number="17" style="v" sid="GEN 15:17" />ubeεδ iθeggez tefuwθ tessulles eddunyeθ, yaxi ebram yezre elxanuwn dulehlab n elεafyeθ ečuwq g leĎruwfdiyn. <verse eid="GEN 15:17" /><verse number="18" style="v" sid="GEN 15:18" />esses yeθfahem rebbi debram yennes: «δeδuwce y idreriyx elqeεεeθ seg esuwf n miSr (n elεeriyc) elwesuwf emeqqar, esuwf n elfuwrat: <verse eid="GEN 15:18" /><verse number="19" style="v" sid="GEN 15:19" />elqeεεeθ elli εmeren δiys iqeyniyyen diqenziyyen diqedmuwniyyen <verse eid="GEN 15:19" /><verse number="20" style="v" sid="GEN 15:20" />diHeθθiyyen diferziyyen direffiyyen <verse eid="GEN 15:20" /><verse number="21" style="v" sid="GEN 15:21" />dimuwriyyen dikenεeniyyen dijerjeciyyen dibuwsiyyen.»<verse eid="GEN 15:21" /></para>
  <chapter eid="GEN 15" />
  <chapter number="16" style="c" sid="GEN 16" />
  <para style="s">arew n ismaεiyl</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 16:1" />saray liwec n ebram tkan etteruwc. weθkan γers texeddamt temiSriθ esmiθes hajer. <verse eid="GEN 16:1" /><verse number="2" style="v" sid="GEN 16:2" />saray tennayes y ebram: «esseγδ ture, rebbi yeHremi seg idrari. aδef f eθxeddemtiyw balek eyθaru idrari.» ebram yesle edwiys. <verse eid="GEN 16:2" /><verse number="3" style="v" sid="GEN 16:3" />usahen saray tuwce texeddemtes temiSriθ hajer y weryazes ebram beεεeδ yedder εecre sniyn g elqeεεeθ n kenεan.<verse eid="GEN 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 16:4" />yxaleδ ebram hajer umax i θfeq s imenes δeθaru teHqer lelles. <verse eid="GEN 16:4" /><verse number="5" style="v" sid="GEN 16:5" />saray tennayes y ebram: «cex δemeshul f elliheneθe elli tejrayiδ. uciyγex texeddemtiyw umax i θezre imenes δeθaru teHqriyδ. rebbi eyeHkem mabinatne.» <verse eid="GEN 16:5" /><verse number="6" style="v" sid="GEN 16:6" />y er felles ebram: «texeddemtem uggefusem eg δiys mette iθexseδ.» teδwel saray etteg g texeddemtes elδeθerwel sγers.<verse eid="GEN 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 16:7" />tiweD g eSSeHreθ y etwali elεiyn n wamen uggebriδ elli yettawi ycuwr. yafiθ elmlax n rebbi. <verse eid="GEN 16:7" /><verse number="8" style="v" sid="GEN 16:8" />yennes: «hajer, texeddamt n saray, s meniys eθedduwsiδ? welmani δeθexDmeδ?» tennes: «erwele seg lelle saray.» <verse eid="GEN 16:8" /><verse number="9" style="v" sid="GEN 16:9" />yennes elmlax n rebbi: «eδwel y lellem teqqiymeδ eddu efuses.» <verse eid="GEN 16:9" /><verse number="10" style="v" sid="GEN 16:10" />yennes xlaf: «δerre idreriym egget Hette iyjen weliged enyeHseb.» <verse eid="GEN 16:10" /><verse number="11" style="v" sid="GEN 16:11" />yerniyyes xlaf: «tay cem δeθerweδ efruwx uδetsemmiyδ ismaεiyl εlexaTer rebbi yesle elli etεaniδ. <verse eid="GEN 16:11" /><verse number="12" style="v" sid="GEN 16:12" />Hette iyjen welyetged eθyesθeεbeδ g elεeks n leεbaδ elkul, uleεbaδ elkul g elεekses. δeyedder δimeθεerex nette demmeθnes elkul.» <verse eid="GEN 16:12" /><verse number="13" style="v" sid="GEN 16:13" />tnabe ellesm n rebbi elli yuθlayes, «cex δrebbi elli izer δiyye.» εlexaTer tenne: «endre mbelHeq ezriyγ elli izer δiyye?» <verse eid="GEN 16:13" /><verse number="14" style="v" sid="GEN 16:14" />usahen yemsemme esuγ, &lt;biyr leHeyruYiy&gt;<note caller="+" style="f"><char style="fr" closed="false">16.14 </char><char style="ft" closed="false">meεnahe esuγ n elli yedder wizer δiyye</char></note>. mabiyn qadec dbared. <verse eid="GEN 16:14" /><verse number="15" style="v" sid="GEN 16:15" />taru hajer efruwx y ebram. ysemme ebram memmis, ismaεiyl. <verse eid="GEN 16:15" /><verse number="16" style="v" sid="GEN 16:16" />max i θiru hajer ismaεiyl ebram ykan elεemres sette weθmenyiyn.<verse eid="GEN 16:16" /></para>
  <chapter eid="GEN 16" />
  <chapter number="17" style="c" sid="GEN 17" />
  <para style="s">elεaheδ duĎehher</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 17:1" />max i yeδwel ebram elεemres tesεe utesεiyn yeffeγes rebbi yennes: «neč δerreb elqader, seferHiyδ eθkuwneδ δeSSaleh, <verse eid="GEN 17:1" /><verse number="2" style="v" sid="GEN 17:2" />welεehδiyw binatne neč dcex, uδedje ezzerriεθex egget egget.» <verse eid="GEN 17:2" /><verse number="3" style="v" sid="GEN 17:3" />yesjeδ ebram yennes rebbi: <verse eid="GEN 17:3" /><verse number="4" style="v" sid="GEN 17:4" />«wahen δelεehδiyw iyδex. δeθeδewleδ δeljed n midden egget, <verse eid="GEN 17:4" /><verse number="5" style="v" sid="GEN 17:5" />meεεač ellesmex <note caller="+" style="f"><char style="fr" closed="false">17.5 </char><char style="ft" closed="false">meεnahe eljed eεellay</char></note>ebram δeθeδwel ibrahiym εlexaTer erriyγex δeljed n midden egget. <verse eid="GEN 17:5" /><verse number="6" style="v" sid="GEN 17:6" />uδexerre etterweδ egget, uδage midden essix, Hette lemluwk δefγen essix. <verse eid="GEN 17:6" /><verse number="7" style="v" sid="GEN 17:7" />δege elεehδiyw iyδex usiyn didreriyx beεδex eljiyl beεεeδ eljiyl uδeyeqqiym diyme, δekuwne δerreb icex uyidreriyx beεδex. <verse eid="GEN 17:7" /><verse number="8" style="v" sid="GEN 17:8" />uδexuwce cex didreriyx beεδex elqeεεeθ n kenεan elkul elli teεmereδ δiys emuberrani, δewce baqi, uδekuwne δerrebbensen.» <verse eid="GEN 17:8" /><verse number="9" style="v" sid="GEN 17:9" />yennes rebbi y ibrahiym: «emme cex yelzmex eθetfeĎ elεehδiyw iyδex didreriyx beεδex eljiyl beεεeδ eljiyl. <verse eid="GEN 17:9" /><verse number="10" style="v" sid="GEN 17:10" />utay elεehδiyw elli yelzmex eθetfeĎ binatne didreriyx beεδex &lt;kul edxer essiywem yelzem eyemĎehher<note caller="+" style="f"><char style="fr" closed="false">17.10 </char><char style="ft" closed="false">emxenes iyxef n etbecelt</char></note>.&gt; <verse eid="GEN 17:10" /><verse number="11" style="v" sid="GEN 17:11" />eĎehher δeykuwn ellemareθ n elεehδiyw iyδwem. <verse eid="GEN 17:11" /><verse number="12-13" style="v" sid="GEN 17:12-13" />kul edxer γers θmenye eyyam kul iyjen seg ixeddemnex elli emmarwen γerx dixeddamen elli tesγitten s leflusex s γer iberreniyyen yelzem eyemĎehher eljiyl beεεeδ eljiyl. <verse eid="GEN 17:12-13" /><verse number="14" style="v" sid="GEN 17:14" />kul edxer elyemĎehherc yelzem eyemgelleb seg midnes εlexaTer elyettiyfc elεehδiyw.» <verse eid="GEN 17:14" /><verse number="15" style="v" sid="GEN 17:15" />yennes rebbi y ibrahiym: «emme liwecex saray meεεač etsemmiyδ saray, δeyeδwel ellesmes sarreh. <verse eid="GEN 17:15" /><verse number="16" style="v" sid="GEN 17:16" />δebarxe δiys uzade δexuwce efruwx essis. δebarxe δiys uδeθerre δyemme n midden egget Hette lemluwk δefγen essis.» <verse eid="GEN 17:16" /><verse number="17" style="v" sid="GEN 17:17" />ibrahiym yesjeδ, yen y imenes, &lt;eyemmaru efruwx y weryaz γers myat sne? weθged sarreh elli γers tesεiyn sne eθaru efruwx?&gt; y eS. <verse eid="GEN 17:17" /><verse number="18" style="v" sid="GEN 17:18" />yennes ibrahiym y rebbi: «imette muc δismaεiyl eyyuwreθ?» <verse eid="GEN 17:18" /><verse number="19" style="v" sid="GEN 17:19" />yer felles rebbi: «la, sarreh liwecex netteθ elli δexθaru efruwx uδetsemmiyδ isHaq. uδage elεehδiyw iyδes didreriys beεδes uδeyeqqiym diyme. <verse eid="GEN 17:19" /><verse number="20" style="v" sid="GEN 17:20" />wismaεiyl tay sliyγex uδebarxe δiys uδeθerre yettaru egget egget, δeyeδwel δdadde n eθnac δlejduwd, uδeθerre n midden egget. <verse eid="GEN 17:20" /><verse number="21" style="v" sid="GEN 17:21" />emme elεehδiyw δeθege disHaq elli δettaru sarreh esukkes ejjay emelweqθe wah.» <verse eid="GEN 17:21" /><verse number="22" style="v" sid="GEN 17:22" />max i ykemmel edwiys, rebbi yedje ibrahiym yexDem. <verse eid="GEN 17:22" /><verse number="23" style="v" sid="GEN 17:23" />esses ibrahiym yuγeδ ismaεiyl memmis dixeddamen elli emmarwen g elHuces elkul, delli emmesγen s lefluses, kul edxer seg elHuces iĎehherθen emmax i syenne rebbi. <verse eid="GEN 17:23" /><verse number="24-25" style="v" sid="GEN 17:24-25" />ibrahiym ykan elεemres tesεe utesεiyn umemmis ismaεiyl θleTTac elweqθelli emĎehren. <verse eid="GEN 17:24-25" /><verse number="26" style="v" sid="GEN 17:26" />uggas iyjen emĎehren lessen: dadde dmemmis. <verse eid="GEN 17:26" /><verse number="27" style="v" sid="GEN 17:27" />leδxuwr n elHuwc n ibrahiym elli emmarwen diyn delli emmesγen s lefluws elkulhum emĎehren iyδes.<verse eid="GEN 17:27" /></para>
  <chapter eid="GEN 17" />
  <chapter number="18" style="c" sid="GEN 18" />
  <para style="s">effaγ n erreb g memra</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 18:1" />ykan ibrahiym ygeεmez g iymi n wexyemes y etwali elbaluT n memra elweqθelli ibanes rebbi ykan as yesxen. <verse eid="GEN 18:1" /><verse number="2" style="v" sid="GEN 18:2" />yqam tiTTewines yaxi yezre tlaθe δiryazen bedden ezzeθes, yexDem yettezzel seg iymi n texyamt etwelinsen yesjeδ g elqeεεeθ. <verse eid="GEN 18:2" /><verse number="3" style="v" sid="GEN 18:3" />yenne iyjen essisen: «ya siydiy, neč g elxeδmtex eg felle elmziyyeθ eθeθεeddiyc. <verse eid="GEN 18:3" /><verse number="4" style="v" sid="GEN 18:4" />edj exenneddaγe qiqqi n wamen eθessirδem essis ikreεnennum tettekkam s eddu eccejreθ, <verse eid="GEN 18:4" /><verse number="5" style="v" sid="GEN 18:5" />usiyn exenneddaγe eTTerf n weγrum eθsuddem essis erriqennum, usiyn eθeθεeddem. εlexaTer etteθεeddamc siyn f elHuciyw.» erren f elles: «bahi, emmax i θenniyδ.» <verse eid="GEN 18:5" /><verse number="6" style="v" sid="GEN 18:6" />yezzel ibrahiym y liweces sarreh g texyamt yennes: «fiyseε! qam tlaθe δelkiylaθ seg aren ebehhay eεjenti tegeδ eγrum.» <verse eid="GEN 18:6" /><verse number="7" style="v" sid="GEN 18:7" />ubeεεeδ yuzzel ibrahiym y etwali esεiys yexθar eyenduwz yebhe yuwci y uxeddam elli yezreb iHeDDerθi. <verse eid="GEN 18:7" /><verse number="8" style="v" sid="GEN 18:8" />elweqθelli iĎab eyenduwz yewyesenti nette dweγi delHliyb, iHuTTiyn ezzeθensen ibed y etwelinsen s eddu eccejreθ bac e nyexδem unihnin tetten. <verse eid="GEN 18:8" /><verse number="9" style="v" sid="GEN 18:9" />usiyn encδent: «mani liwecex sarreh?» y er fellasen: «tenniθ g texyamt.» <verse eid="GEN 18:9" /><verse number="10" style="v" sid="GEN 18:10" />yennes iyjen essisen: «δexerjεe esukkes ejjay emelweqθe wahen ettewθes eθkuwn sarreh liwecex tirew efruwx.» sarreh tkan δefres y etwali elbab n texyamt tesl edwiys. <verse eid="GEN 18:10" /><verse number="11" style="v" sid="GEN 18:11" />ibrahiym dsarreh kanen δiwessaren δimkemmlen usarreh teθεedde elεmer n warew. <verse eid="GEN 18:11" /><verse number="12" style="v" sid="GEN 18:12" />teS g ules ten: &lt;endre beεεeδ iyexDem elεemriyw yeδwel eryaziyw δewesser eyeddes elxiyre elkul?&gt; <verse eid="GEN 18:12" /><verse number="13" style="v" sid="GEN 18:13" />yen rebbi y ibrahiym: «imette eteSSe sarreh ten: &lt;zeεme mbelHeq eδerwe efruwx uneč δtewessarθ?&gt; <verse eid="GEN 18:13" /><verse number="14" style="v" sid="GEN 18:14" />endre telle Haje tuεer f erreb? δexerjεe esukkes ejjay emelweqθe wahen ettewθes eθkuwn sarreh tiru efruwx.» <verse eid="GEN 18:14" /><verse number="15" style="v" sid="GEN 18:15" />tekkuδ sarreh tenker: «ellessixc.» yennes: «la, teSSiyδ.»<verse eid="GEN 18:15" /></para>
  <para style="s">elwSayeθ n seyyedne ibrahiym</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 18:16" />usiyn ekkeren iryazen eTfen ebriδ qeblen y etwali seduwm. yexDem ibrahiym iyδsen bac e nniceyyeε. <verse eid="GEN 18:16" /><verse number="17" style="v" sid="GEN 18:17" />yen rebbi g ules: «zeεme ejeHδe f ebrahiym δme δege? <verse eid="GEN 18:17" /><verse number="18" style="v" sid="GEN 18:18" />wibrahiym yelzem eyeδwel θemuwreθ temeqqarθ uteqwe umidden n elqeεεeθ elkul δeθberxen essis <verse eid="GEN 18:18" /><verse number="19" style="v" sid="GEN 18:19" />εlexaTer neč exθeraθ bac e yweSSe idreriys dmidnes beεδes bac e sθeHfDen uffebriδiyw s wage n elxiyr, usahen yumken ege elli uεeδe essis.» <verse eid="GEN 18:19" /><verse number="20" style="v" sid="GEN 18:20" />ubeεεeδ yenne rebbi: «ecθxe esseduwm deεmuwreh yeδwel belHeq egget weccerrensen yexθer egget (uleδnubensen xθeren), <verse eid="GEN 18:20" /><verse number="21" style="v" sid="GEN 18:21" />δegze bac e reqbe elεmeylensen emmax i cθxen ziyγ la. wiδekan la ture essene.» <verse eid="GEN 18:21" /><verse number="22" style="v" sid="GEN 18:22" />exDmen iryazendiyn lessen elli iyδes esyiyn y etwali seduwm, emme rebbi yeqqiym dibrahiym. <verse eid="GEN 18:22" /><verse number="23" style="v" sid="GEN 18:23" />yeqreb ibrahiym lezzaθ yen: «δeθehelxeδ ebehhay (elli yetDeweε) dumuwHac (delli yetDewiεc) jmiyε? <verse eid="GEN 18:23" /><verse number="24" style="v" sid="GEN 18:24" />zeεme lukan θemuwreθ δiys xemsiyn waHed δibehhayen endre δettehlxeδ wettetedjiyc f elxaĎer n xemsindiyn elli δiys? <verse eid="GEN 18:24" /><verse number="25" style="v" sid="GEN 18:25" />Hacak kan δeθehelxeδ ebehhay dumuwHac jmiyε, ebehhay eyeδwel emumuwHac! Hacak! endre elHakem n eddunyeθ elkul liHekkemc δimseggem?» <verse eid="GEN 18:25" /><verse number="26" style="v" sid="GEN 18:26" />yennes rebbi: «kan ufiyγ xemsiyn δibehhayen g esduwm δedje emxan elkul f elxeĎrensen.» <verse eid="GEN 18:26" /><verse number="27" style="v" sid="GEN 18:27" />iεaweδ ibrahiym yenne: «ecbiyni dukkiyγ y rebbi sahen uneč kan δecal diyγeD. <verse eid="GEN 18:27" /><verse number="28" style="v" sid="GEN 18:28" />lukan xemsiyndiyn enqezen essisen xemse? δeθehelxeδ θemuwreθ elkul f xemsadiyn yneqSen?» yer felles: «ethelxac iδekan ufiyγ xemse werbεiyn diyn.» <verse eid="GEN 18:28" /><verse number="29" style="v" sid="GEN 18:29" />yennes ibrahiym xlaf: «lukan eθafeδ erbεiyn diyn?» yer felles: «ethelxac f elxaĎer n erbεiyndiyn.» <verse eid="GEN 18:29" /><verse number="30" style="v" sid="GEN 18:30" />yennes ibrahiym: «eg elmziyyeθ eθeθγeccec, edjiyδ eθuθlaye. lukan eθafeδ tleθiyn diyn?» yer felles: «ethelxac iδekan ufiyγ tleθiyn diyn.» <verse eid="GEN 18:30" /><verse number="31" style="v" sid="GEN 18:31" />yen ibrahiym: «rebbi, samHiyδ eθseybe g edwi. lukan eθafeδ εicriyn diyn?» yennes: «ethelxac f elxaĎer n εicriyn.» <verse eid="GEN 18:31" /><verse number="32" style="v" sid="GEN 18:32" />yen ibrahiym: «eg elmziyyeθ eθeθγeccec, δeθuθleye exxer merre. lukan eθafeδ εecre diyn?» yennes: «ethelxac f elxaĎer n εecre.» <verse eid="GEN 18:32" /><verse number="33" style="v" sid="GEN 18:33" />umax i ykemmel rebbi seg edwiys dibrahiym yexDem f imenes. wibrahiym yeδwel y wemxenes.<verse eid="GEN 18:33" /></para>
  <chapter eid="GEN 18" />
  <chapter number="19" style="c" sid="GEN 19" />
  <para style="s">axle n seduwm</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 19:1" />elmleyxaθ lessen ewDen g esduwm g tisemsiyn. luwT ykan ygeεmez g iymi n seduwm. max i nyezre yekker bac enyeεreD, yesjeδ s uδmes y elqeεεeθ, <verse eid="GEN 19:1" /><verse number="2" style="v" sid="GEN 19:2" />yen: «ya syadiy, esδeθ tessirδem ikreεnewwem, tεeddem iDennum y etwali elεebδennum, utalji bekri kemleθ ebriδennum.» yaxi yennes: «la, δenεedde iDe g essaHeθ.» <verse eid="GEN 19:2" /><verse number="3" style="v" sid="GEN 19:3" />yeTTef eSHiyH δiysen elδexemmen iyδes y elHuces, yeεreD fellasen iĎeybasen tifĎiyrin ečen. <verse eid="GEN 19:3" /><verse number="4" style="v" sid="GEN 19:4" />emme qebl exeDmen eneεsen, iryazen n seduwm elkul, imezyanen diwessaren, enneDen f elHuwc. <verse eid="GEN 19:4" /><verse number="5" style="v" sid="GEN 19:5" />naben luwT: «mani iryazen elli teεreDeδ fellasen iDe? sufγenaθen bac e nεedde essisen elweqθ.» <verse eid="GEN 19:5" /><verse number="6" style="v" sid="GEN 19:6" />yefγasen luwT beεεeδ isekker δefres elbab. <verse eid="GEN 19:6" /><verse number="7" style="v" sid="GEN 19:7" />yen: «emmeθniyw, eθegemc elHajeθ tuwHec. <verse eid="GEN 19:7" /><verse number="8" style="v" sid="GEN 19:8" />tay eθegem elmziyyeθ γeri sent δtifrax ellenεisneθ dHed qebl edjmiyδ exennenteddaγe tegem essisneθ mette iθexsem, emme iryazene lessen esentegem Hette cey εlexaTer eεgelen g elHuciyw.» <verse eid="GEN 19:8" /><verse number="9" style="v" sid="GEN 19:9" />ennen: «ebεeδ!» ernin: «cex elli tuseδ emuberrani y etwelinne, utay ture eθeθHekmeδ δiyne. ture δeneg δiyx eccer exθrensen.» emεarxen beεδen luwT eSbiyH, exeDmen y elbab. <verse eid="GEN 19:9" /><verse number="10" style="v" sid="GEN 19:10" />yaxi iryazen lessen elli ljaj ezzelen ifesnensen enzγen luwT sekren elbab. <verse eid="GEN 19:10" /><verse number="11" style="v" sid="GEN 19:11" />usiyn ewweθen iryazen s elεme, elli bedden ezzaθ n elbab n elHuwc, emezyenensen dumeqqerensen, eδwlen elgeddenc eδafen elbab. <verse eid="GEN 19:11" /><verse number="12" style="v" sid="GEN 19:12" />ennen iryazendiyn lessen y luwT: «elγrexc δ wiyn yeqrebex g temuwreθe? idrari ziyγ δtifrax ziyγ insiyben ziyγ ey waHed yeqrebex? essufeγθen seg elberre. <verse eid="GEN 19:12" /><verse number="13" style="v" sid="GEN 19:13" />εlexaTer elεyaĎ n eccerres yexθer y etwali rebbi, yaxi yeznane bac e θnexle.» <verse eid="GEN 19:13" /><verse number="14" style="v" sid="GEN 19:14" />yexDem luwT yuθley insibnes elli δeθaγen tifrexes, yennasen: «heyye, ekreθ tefγem seg emxane εlexaTer rebbi δeyexle θemuwreθe.» iban emmax yetbeSSer f insibnes. <verse eid="GEN 19:14" /><verse number="15" style="v" sid="GEN 19:15" />umax i εellem elfjer ebδen elmleyxaθ lessen etmelgen y luwT: «heyye, ekker tawyeδ liwecex ettifrexex lessent elli dah. bac e lthellexc max eθemHaseb θemuwreθe f leδnubes.» <verse eid="GEN 19:15" /><verse number="16" style="v" sid="GEN 19:16" />max i yeqqiym luwT yetmerxe, eTTefen elmleyxaθ efuses difessen n liweces ettifrexes lessent g ewδenten elberre n temuwreθ. εlexaTer rebbi yesxef fellasen. <verse eid="GEN 19:16" /><verse number="17" style="v" sid="GEN 19:17" />max i beεδen essisen yenneyasen iyjen seg elmleyxaθ: «menneε imenex! eθebernec eldeffer weθbeddec gθeHmiylt. y edhari yelzem eθerwel y edhari bac e lthellexc.» <verse eid="GEN 19:17" /><verse number="18" style="v" sid="GEN 19:18" />yennes luwT: «muc sah ya siydiy. <verse eid="GEN 19:18" /><verse number="19" style="v" sid="GEN 19:19" />tay erbeHe erDax, utay cex eθkebreδ elleTfex max i θmenεeδ leHyeθiyw, emme elgeddac eruwle y eddehreθ belekc eyyejre Haje usiyn ejafe. <verse eid="GEN 19:19" /><verse number="20" style="v" sid="GEN 19:20" />tay θemuwreθ teqreb erwel y etweliys yeshel. netteθ ettemuwreθ temezyent edjiyδ erewle eldiyn elthellexc mahi θemuwreθ temezyent? emenεe δiys.» <verse eid="GEN 19:20" /><verse number="21" style="v" sid="GEN 19:21" />yennes elmlax: «eqbele eTTelbθex θahen zade welxelliyγc θemuwreθ elli tenniyδ. <verse eid="GEN 19:21" /><verse number="22" style="v" sid="GEN 19:22" />ezzel erwel y etweliys, εlexaTer elgeddac ege Hette cey elδeθewDeδ eldiyn.» usahen temsemme θemuwretdiyn Suwγer (meεnahe temezyent). <verse eid="GEN 19:22" /><verse number="23" style="v" sid="GEN 19:23" />tefuwθ teqqeS max i yiweD luwT g Suwγer. <verse eid="GEN 19:23" /><verse number="24" style="v" sid="GEN 19:24" />yessuggez rebbi n elkebriyt delεafyeθ s γers seg esme f esduwm deεmuwreh, <verse eid="GEN 19:24" /><verse number="25" style="v" sid="GEN 19:25" />yeqleb timuwrediyn delli εemren δiysneθ etteHmiylt elli tenneD essisneθ delli yemmezzu g elqeεεeθ. <verse eid="GEN 19:25" /><verse number="26" style="v" sid="GEN 19:26" />tebren liwec n luwT elli tegguwr δefrensen, teδwel δelεerSeθ n tisent. <verse eid="GEN 19:26" /><verse number="27" style="v" sid="GEN 19:27" />yexDem ibrahiym taljidiyn bekri y wemxan elli rebbi yuθlayes δiys. <verse eid="GEN 19:27" /><verse number="28" style="v" sid="GEN 19:28" />yerqeb y etwali seduwm deεmuwreh delqeεεeθ n teHmiylt elkul yezer edduxxan yettali essis emmax yettali seg tunnurθ temeqqarθ egget. <verse eid="GEN 19:28" /><verse number="29" style="v" sid="GEN 19:29" />usahen max i yexle rebbi timuwre n teHmiylt yesfekker ibrahiym, ysuwfeγ luwT qebl elkarθeθ max i yeqleb timuwre elli yeεmer δiysneθ luwT.<verse eid="GEN 19:29" /></para>
  <para style="s">elleSl n imuwabiyyen debni εemmuwn</para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 19:30" />yukkeδ luwT eyeεmer g Suwγer yeffeγ nette ettifrexes esyiyn yerwel y tiyriθ g eddehreθ diyn. <verse eid="GEN 19:30" /><verse number="31" style="v" sid="GEN 19:31" />yelle as tefruwxθ temeqqarθ tennayes yweltmas temezyent: «daddeθne yuwser uleHebbac g elqeεεeθ elli yetwelinne eryaz exenyeγ emleεbaδ elkul. <verse eid="GEN 19:31" /><verse number="32" style="v" sid="GEN 19:32" />heyye, eθnessesxer nenεes iyδes usahen elweqqiync idrari n daddeθne.» <verse eid="GEN 19:32" /><verse number="33" style="v" sid="GEN 19:33" />g δeggiyδdiyn esseswneθ daddesneθ ecrab, teseδ yelliys temeqqarθ tenεes iyδes welifaqc la s wenεeses la s wekkeres. <verse eid="GEN 19:33" /><verse number="34" style="v" sid="GEN 19:34" />uggas eθθani tenne tefruwxθ temeqqarθ y weltmas temezyent: «enεese ddadde iDennat, heyye, eθnessesw ecrab iDe xlaf usiyn aδef tenεseδ iyδes usahen enessikker seg daddeθne idrari.» <verse eid="GEN 19:34" /><verse number="35" style="v" sid="GEN 19:35" />g δeggiyδdiyn xlaf esseswneθ daddesneθ ecrab teseδ yelliys temezyent tenεes iyδes welifaqc la s wenεeses la s wekkeres. <verse eid="GEN 19:35" /><verse number="36" style="v" sid="GEN 19:36" />usahen δwelneθ tifrax n luwT lessent δeθeruwneθ seg daddesneθ. <verse eid="GEN 19:36" /><verse number="37" style="v" sid="GEN 19:37" />taru temeqqarθ efruwx tsemmaθ <note caller="+" style="f"><char style="fr" closed="false">19.37 </char><char style="ft" closed="false">ellesm icebbeh &lt;s γer dadde&gt;</char></note>muwab, unette δeljed n imuwabiyyen elwasse. <verse eid="GEN 19:37" /><verse number="38" style="v" sid="GEN 19:38" />utemezyent tiru Hette ennetteθ efruwx tsemmaθ <note caller="+" style="f"><char style="fr" closed="false">19.38 </char><char style="ft" closed="false">memmis n εemmi</char></note>ben εemmiy, unette δeljed n ebni εemmuwn elwasse.<verse eid="GEN 19:38" /></para>
  <chapter eid="GEN 19" />
  <chapter number="20" style="c" sid="GEN 20" />
  <para style="s">seyyedne ibrahiym g ejrar</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 20:1" />esyiyn yerHel ibrahiym y etwali elqeεεeθ n enneqeb yeεmer mabiyn qadec dcuwr yeθγerreb g ejrar. <verse eid="GEN 20:1" /><verse number="2" style="v" sid="GEN 20:2" />yen yleεbaδ f sarreh liweces elli netteθ δweltmas. y axi yuzenes ebiymalek elmlek n ejrar yeγet y etweliys. <verse eid="GEN 20:2" /><verse number="3" style="v" sid="GEN 20:3" />yesδes rebbi y ebiymalek g tirjiyθ g δeggiyδdiyn yennes: «δeθjafeδ f elxaĎer n temeTTuwθ elli tiwyet, rahi δliwec n weryaz.» <verse eid="GEN 20:3" /><verse number="4" style="v" sid="GEN 20:4" />ebiymalek elyuwc ettilemmesc, yen: «ya, siydiy! δeθehelxeδ leεbaδ ellegiyn Hette cey? <verse eid="GEN 20:4" /><verse number="5" style="v" sid="GEN 20:5" />eyyenniyc elli netteθ δweltmas? unetteθ biyδhe eyθenniyc elli nette δyuwwes? enniyθiyw etteSSafiθ wellegiyγ Hette cey yuwHec.» <verse eid="GEN 20:5" /><verse number="6" style="v" sid="GEN 20:6" />yer felles rebbi: «neč biyδi essene elli θegiyδ wediyn s enniyyeθ etteSSafiθ. wenneč elli exedjixc eθeγldeδ g elHeqqiyw. wahen εlac exedjixc etlemseδ. <verse eid="GEN 20:6" /><verse number="7" style="v" sid="GEN 20:7" />ture, rejjeε y weryaz liweces εlexaTer nette δenbi uδeyezzal f elxeĎrex uδeθedreδ. urahu δeθjafeδ cex delli δegliyx elkul iδekan etetrejεec.» <verse eid="GEN 20:7" /><verse number="8" style="v" sid="GEN 20:8" />talji bekri ebiymalek inabe ixeddemnes elkul yeHkeyasen kul cey. ukδen egget iryazen. <verse eid="GEN 20:8" /><verse number="9" style="v" sid="GEN 20:9" />ubeεεeδ ebiymalek inabe ibrahiym yennes: «mette ixentegiyδ? mette ixegiyγ bac e θeddaγeδ elγeldeθ ettemeqqarθ y neč ettemurθiyw? θegiyδ g elHeqqiyw elHajaθ mayelzemc emmegneθ.» <verse eid="GEN 20:9" /><verse number="10" style="v" sid="GEN 20:10" />yenceδt ebiymalek: «g mette iθkaneδ etxememeδ bac e θegeδ elHajeθ emtah?» <verse eid="GEN 20:10" /><verse number="11" style="v" sid="GEN 20:11" />yennes ibrahiym: «egiyγ wahen εlexaTer etteεlake leHebbac e lxuwf seg rebbi g wemxane elkul. ukδe eyyenγen f elxaĎer n liweciyw. <verse eid="GEN 20:11" /><verse number="12" style="v" sid="GEN 20:12" />unetteθ <note caller="+" style="f"><char style="fr" closed="false">20.12 </char><char style="ft" closed="false">enzi tk 12:13</char></note>δweltme mbelHeq, yelliys <note caller="+" style="f"><char style="fr" closed="false">20.12 </char><char style="ft" closed="false">gelεibriyye dadde dyemme mumken meεnahe zade babe dnanne</char></note>ndadde, umuc δyelliys n yemme, eγet. <verse eid="GEN 20:12" /><verse number="13" style="v" sid="GEN 20:13" />umax i ysuwfeγ rebbi seg elHuwc n dadde enniyγes &lt;elmeniy enexDem en elli neč δyuwwem, θahen elHajeθ tebehhayθ eyettegeδ.&gt;» <verse eid="GEN 20:13" /><verse number="14" style="v" sid="GEN 20:14" />yeTTef ebiymalek esεi difunasen dixeddamen etxeddamin yuwcin y ibrahiym yerres sarreh liweces. <verse eid="GEN 20:14" /><verse number="15" style="v" sid="GEN 20:15" />yennes: «tay elqeεθiyw ezzeθex, eqqiym meni exyeεjeb.» <verse eid="GEN 20:15" /><verse number="16" style="v" sid="GEN 20:16" />yennes y sarreh: «tay δesuwce yuwwem <note caller="+" style="f"><char style="fr" closed="false">20.16 </char><char style="ft" closed="false">yuwsef yemmenz s εicriyn qeTεe berk (tk 37:28)</char></note>elf qeTεe n elfeTTeθ bac e snen leεbaδ elli iyδem elkul elli cem eltegiyδ Hette cey yuwHec. welHeqqem yerjeεem.» <verse eid="GEN 20:16" /><verse number="17-18" style="v" sid="GEN 20:17-18" />rebbi ykan yerre elwacun n elHuwc n ebiymalek etteruwnec f elxaĎer n sarreh liwec n ibrahiym. yeδεu ibrahiym rebbi ysebre ebiymalek dliweces ettixeddamines δwelneθ etteruwneθ.<verse eid="GEN 20:17-18" /></para>
  <chapter eid="GEN 20" />
  <chapter number="21" style="c" sid="GEN 21" />
  <para style="s">arew n isHaq</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 21:1" />yesfekker rebbi sarreh emmax i yenne, yeges elli yuεeδt essis. <verse eid="GEN 21:1" /><verse number="2" style="v" sid="GEN 21:2" />taru sarreh efruwx y ibrahiym unette δewesser, g elweqθ elli yennayes felles rebbi. <verse eid="GEN 21:2" /><verse number="3" style="v" sid="GEN 21:3" />ysemme ibrahiym memmis elli tirwasθ sarreh &lt;isHaq&gt;. <verse eid="GEN 21:3" /><verse number="4" style="v" sid="GEN 21:4" />iĎehherθ uggas eθθamen emmax i syenne rebbi. <verse eid="GEN 21:4" /><verse number="5" style="v" sid="GEN 21:5" />ibrahiym ykan elεemres miyye max i syemmaru isHaq. <verse eid="GEN 21:5" /><verse number="6" style="v" sid="GEN 21:6" />ten sarreh: «yessessiyδ rebbi. elli eyesl eyeS iyδi.» <verse eid="GEN 21:6" /><verse number="7" style="v" sid="GEN 21:7" />terni xlaf: «δ wiyn ykan esyen y ibrahiym elli sarreh δeθessesf idrari? tay iruwγes efruwx max i yuwser.»<verse eid="GEN 21:7" /></para>
  <para style="s">egelleb n hajer dismaεiyl</para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 21:8" />yekber efruwx efeDment. as n wefĎemes yege ibrahiym elfĎuwr δemeqqar. <verse eid="GEN 21:8" /><verse number="9" style="v" sid="GEN 21:9" />tezr sarreh elli memmis n hajer temiSriθ elli tiruθ y ibrahiym yδeS<note caller="+" style="f"><char style="fr" closed="false">21.9 </char><char style="ft" closed="false">sγer LXX</char></note> f memmis isHaq, <verse eid="GEN 21:9" /><verse number="10" style="v" sid="GEN 21:10" />ten y ibrahiym: «gelleb texeddamte dmemmis, memmis n texeddamt liwerreθc dmemmi, memmi isHaq.» <verse eid="GEN 21:10" /><verse number="11" style="v" sid="GEN 21:11" />ibrahiym eθyeεjiybc egget edwiye εlexaTer ismaεiyl zade kan δmemmis. <verse eid="GEN 21:11" /><verse number="12" style="v" sid="GEN 21:12" />yennes rebbi: «eθxememec f wefruwx ziyγ f eθxeddemtex, tesleδ edwi n sarreh g elli exetten elkul εlexaTer s isHaq δeδuwlen γerx idrari. <verse eid="GEN 21:12" /><verse number="13" style="v" sid="GEN 21:13" />useg memmis n texeddamt zade δege θemuwreθ εlexaTer Hette nette seg ezzerriεθex.» <verse eid="GEN 21:13" /><verse number="14" style="v" sid="GEN 21:14" />yekker ibrahiym talji bekri yawi eγrum etteyeddit n wamen yezzelten y hajer, yegin f elkeθfes, igellebt netteθ dmemmis, tehmel g eSSeHreθ n biyr sebεe. <verse eid="GEN 21:14" /><verse number="15" style="v" sid="GEN 21:15" />umax i kemlen amen tedje memmis s eddu tezuwre. <verse eid="GEN 21:15" /><verse number="16" style="v" sid="GEN 21:16" />texDem tgeεmez tqabelt, myat mitr εelleqel, εlexaTer tenne g ules: «elHeTrac ejafi n wefruwx.» teqqiym tebδe etεeyyeĎ. <verse eid="GEN 21:16" /><verse number="17" style="v" sid="GEN 21:17" />yesl rebbi efruwx yetεeyyeĎ n wefruwx, inabe elmlax n rebbi hajer seg esme yennes: «mette imiqelleq ehajer? eθukδc εlexaTer rebbi yesle eεeyyeĎ n wefruwx meni iyemmedj. <verse eid="GEN 21:17" /><verse number="18" style="v" sid="GEN 21:18" />berre tessikreδ memmiym, teTfet eSbiyH εlexaTer δeθerre ettemuwreθ temeqqarθ.» <verse eid="GEN 21:18" /><verse number="19" style="v" sid="GEN 21:19" />usiyn ymiyres tiTTewines tezr esuγ n wamen, texDem tεebbe teyeddit tessesw efruwx. <verse eid="GEN 21:19" /><verse number="20-21" style="v" sid="GEN 21:20-21" />yelhe rebbi esefruwx yekber, yeεmer g eSSeHreθ n faran, yeδwel iged egget eHδaf n ennebleθ. taγes yemmes temeTTuwθ seg miSr.<verse eid="GEN 21:20-21" /></para>
  <para style="s">seyyedne ibrahiym debiymalek g biyr sebεe</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 21:22" />g elweqtdiyn ebiymalek delqayeδ n eljices fiykuwl yuseδ y ibrahiym yennes: «ture rebbi iyδex g elli ettegeδ δiys elkul, <verse eid="GEN 21:22" /><verse number="23" style="v" sid="GEN 21:23" />eθjul s rebbi elli eltγedrec essi ula s idreriyw ula s idrari n idreriyw, welli δeyθegeδ elxiyr y neč dleεbeδiyw elli θeddereδ mabinathum lewse, emmax i giyγ elxiyr δiyx.» <verse eid="GEN 21:23" /><verse number="24" style="v" sid="GEN 21:24" />yen ibrahiym: «eθjulle.» <verse eid="GEN 21:24" /><verse number="25" style="v" sid="GEN 21:25" />usiyn yeεrex ebiymalek f elxaĎer n wanu elli iwyent ixeddamen n ebiymalek. <verse eid="GEN 21:25" /><verse number="26" style="v" sid="GEN 21:26" />yen ebiymalek: «ellessinac δ wiyn iyege wahen, ucex eyθenniyc, wellesliyγ essis kan asse.» <verse eid="GEN 21:26" /><verse number="27" style="v" sid="GEN 21:27" />usiyn yuwce ibrahiym y ebiymalek esεi difunasen egen elmiθaq. <verse eid="GEN 21:27" /><verse number="28" style="v" sid="GEN 21:28" />yefrez ibrahiym sebεe ettifĎiymin weHδesneθ seg esεiys. <verse eid="GEN 21:28" /><verse number="29" style="v" sid="GEN 21:29" />yennes ebiymalek: «δmette iθexseδ eθenneδ essebεeye n tifĎiymin intefrzeδ weHδesneθ?» <verse eid="GEN 21:29" /><verse number="30" style="v" sid="GEN 21:30" />yer felles: «θiyhen sebεe exse entewyeδ ettifĎiymin exenttuwce δeccehδeθ s γeri elli neč eHfere enuwe.» <verse eid="GEN 21:30" /><verse number="31" style="v" sid="GEN 21:31" />usahen elεebδ eysemme emxandiyn <note caller="+" style="f"><char style="fr" closed="false">21.31 </char><char style="ft" closed="false">anu n eθjulli</char></note>biyr sebεe εlexaTer ibrahiym debiymalek eθjullen diyn lessen. <verse eid="GEN 21:31" /><verse number="32" style="v" sid="GEN 21:32" />ubeεεeδ egiyn elmiθaq g biyr sebεe, yekker ebiymalek dfiykuwl elqayeδ n eljices erjεen y elqeεεeθ n ifilesTiyniyyen. <verse eid="GEN 21:32" /><verse number="33" style="v" sid="GEN 21:33" />yezzu ibrahiym eccejreθ neθθel g biyr sebεe, yeδεu s ellesmes rebbi elli diyme yedder. <verse eid="GEN 21:33" /><verse number="34" style="v" sid="GEN 21:34" />yedder g elqeεεeθ n ifilesTiyniyyen elfetreθ tiTwilt.<verse eid="GEN 21:34" /></para>
  <chapter eid="GEN 21" />
  <chapter number="22" style="c" sid="GEN 22" />
  <para style="s">isHaq δeδbiHeθ yerreb</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 22:1" />beεεeδ wahen elkul rebbi ijerreb ibrahiym. inebaθ: «ibrahiym!» yer felles: «enεem.» <verse eid="GEN 22:1" /><verse number="2" style="v" sid="GEN 22:2" />yennes: «awi memmiyx isHaq elli elγrexc kan ennette welli texset. qam imenex texDmeδ y elqeεεeθ n elmureyye teγrset<note caller="+" style="f"><char style="fr" closed="false">22.2 </char><char style="ft" closed="false">tk 8:20</char></note> teHrqet emecwiyheθ f icθ seg edhari elli δexentessexne.» <verse eid="GEN 22:2" /><verse number="3" style="v" sid="GEN 22:3" />elweječe ibrahiym yekker bekri yquS isγaren yweHreq iberδeε f eγyules yawi sen seg ixeddemnes dmemmis isHaq yersem δeyexDem y wemxan elli yuθlayes felles rebbi. <verse eid="GEN 22:3" /><verse number="4" style="v" sid="GEN 22:4" />uggas eθθaleθ yqam ibrahiym tiTTewines yezer emxan seg lebεiyδ. <verse eid="GEN 22:4" /><verse number="5" style="v" sid="GEN 22:5" />yen ibrahiym y ixeddemnes: «eqqiymeθ dweγyul dahen, neč dwefruwx δenali enezzal y rebbi usiyn exennerjeε.» <verse eid="GEN 22:5" /><verse number="6" style="v" sid="GEN 22:6" />yqam ibrahiym isγaren n weHraq f memmis isHaq, yawi nette elεafyeθ ettesferθ. exeDmen essenniyn jmiyε. <verse eid="GEN 22:6" /><verse number="7" style="v" sid="GEN 22:7" />yennes isHaq y daddes: «dadde!» yer felles: «enεem, memmi.» yenceδt: «tay elεafyeθ disγaren, umani eεelluc elli δeθneγres, n eHreqθ?» <verse eid="GEN 22:7" /><verse number="8" style="v" sid="GEN 22:8" />yer felles ibrahiym: «δrebbi δeyδebber eεelluc n weHraq, emmi.» exeDmen essenniyn jmiyε. <verse eid="GEN 22:8" /><verse number="9" style="v" sid="GEN 22:9" />max i θiwDen y wemxan elli y ennayes felles rebbi, ibrahiym yebne elmeδbeHdiyn iHeDDer isγaren, yeqqen memmis isHaq iHuTTi f elmeδbeH δenni isγaren. <verse eid="GEN 22:9" /><verse number="10" style="v" sid="GEN 22:10" />yezzel ibrahiym efuses yqam tesferθ bac e yeγres memmis. <verse eid="GEN 22:10" /><verse number="11" style="v" sid="GEN 22:11" />yaxi inebaθ elmlax n rebbi seg esme yennes: «ibrahiym! ibrahiym!» yer felles: «enεem.» <verse eid="GEN 22:11" /><verse number="12" style="v" sid="GEN 22:12" />yennes: «eθlemsec memmiyx! esθegeδ Hette cey! εlexaTer ture essene elli cex ettekkaδeδ seg rebbi welterriyc felle memmiyx elli elγrexc kan ennette.» <verse eid="GEN 22:12" /><verse number="13" style="v" sid="GEN 22:13" />yqam ibrahiym tiTTewines yezer elkebc weHδes, yuHel seg legrunes g eθzuwre, yexDem ibrahiym yeγet yeγresθi yeHreqθi g wemxan n memmis. <verse eid="GEN 22:13" /><verse number="14" style="v" sid="GEN 22:14" />ysemme ibrahiym emxandiyn<note caller="+" style="f"><char style="fr" closed="false">22.14 </char><char style="ft" closed="false">yehweh yerYh</char></note> «rebbi yetδebber.» welluciyn eqqaren elture: «g eddehreθ n rebbi yetδebber.» <verse eid="GEN 22:14" /><verse number="15" style="v" sid="GEN 22:15" />inabe elmlax n rebbi ibrahiym seg esme tikkelt xlaf, <verse eid="GEN 22:15" /><verse number="16" style="v" sid="GEN 22:16" />yennes: «yenne rebbi, εlexaTrek θegiyδ wahen welterriyc felle memmiyx elli elγrexc kan ennette, eθjulle s imeniyw, <verse eid="GEN 22:16" /><verse number="17" style="v" sid="GEN 22:17" />tay rebbi mat iyenne, rahu δebarxe δiyx uδerre ezzerriεθex emiθran n esme dermel n ecceT, uδeγelben elεδunsen ewyen timuransen. <verse eid="GEN 22:17" /><verse number="18" style="v" sid="GEN 22:18" />uleεbaδ n eddunyeθ elkul δesθbarxen s idreriyx εlexaTer tesliyδ edwiyw.» <verse eid="GEN 22:18" /><verse number="19" style="v" sid="GEN 22:19" />yeδwel ibrahiym y etwali ixeddemnes ersmen δexeDmen elkul ibiyr sebεe meni δeyedder ibrahiym.<verse eid="GEN 22:19" /></para>
  <para style="s">ezzerriyεeθ ennaHuwr</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 22:20" />beεεeδ wahen yemmennes yibrahiym: «milkeh zade tiru idrari y enjenjwex n aHuwr.» <verse eid="GEN 22:20" /><verse number="21" style="v" sid="GEN 22:21" />εuwSa emeqqar denjenjwes buwza dgemuwYiyl daddes n eram <verse eid="GEN 22:21" /><verse number="22" style="v" sid="GEN 22:22" />dkased dHezwa dfildac dyedlaf dbetuwYiyl <verse eid="GEN 22:22" /><verse number="23" style="v" sid="GEN 22:23" />elli yuγeδ rifqeh, eθmenyaye tiruθen milkeh y n aHuwr enjenjwes n ibrahiym. <verse eid="GEN 22:23" /><verse number="24" style="v" sid="GEN 22:24" />tarwes rewuwmeh liweces g esser, TabeH, jaHem, taHec dmeεkeh.<verse eid="GEN 22:24" /></para>
  <chapter eid="GEN 22" />
  <chapter number="23" style="c" sid="GEN 23" />
  <para style="s">temettent n serreh dwerδemes</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 23:1" />sarreh θedder miyye usebεe uεicriyn sne. <verse eid="GEN 23:1" /><verse number="2" style="v" sid="GEN 23:2" />usiyn eθjaf <note caller="+" style="f"><char style="fr" closed="false">23.2 </char><char style="ft" closed="false">qeryeθ erbεe</char></note>gθemuwreθ n erbεe, meεnahe Hebruwn, g elqeεεeθ n kenεan, yaseδ ibrahiym δeyendeb iεeyyeĎ felles. <verse eid="GEN 23:2" /><verse number="3" style="v" sid="GEN 23:3" />yekker ibrahiym seg ezzaθ n sarreh yexDem y iHeθθiyyen yennasen: <verse eid="GEN 23:3" /><verse number="4" style="v" sid="GEN 23:4" />«neč δeberrani g wemmesennum, ezzenzmiyδ elqeεεeθ ereδme δiys elmeytiyw.» <verse eid="GEN 23:4" /><verse number="5" style="v" sid="GEN 23:5" />erren felles: <verse eid="GEN 23:5" /><verse number="6" style="v" sid="GEN 23:6" />«eg elmziyyeθ tesseγδane esiydiy. cex δerrayes s γer rebbi g wemmesenne, erδem elmeytex g tiriθenne<note caller="+" style="f"><char style="fr" closed="false">23.6 </char><char style="ft" closed="false">gelweqtdiyn imuγniyyen ettegen ettiyriθ emtjebbentensen</char></note> n warδem tebehhayθ, Hette iyjen welyθerri fellex tiriθes.» <verse eid="GEN 23:6" /><verse number="7" style="v" sid="GEN 23:7" />yekker ibrahiym iTebbeS ezzaθ n iHeθθiyyen midden n temuwreθ <verse eid="GEN 23:7" /><verse number="8" style="v" sid="GEN 23:8" />yen: «iδekan teqbelem ereδme elmeytiyw, esseγδeθ s γeri tuθlayem y εefruwn memmis n SuwHer, <verse eid="GEN 23:8" /><verse number="9" style="v" sid="GEN 23:9" />eyyezzenz tiyriθ elli g temekfiylt elli g eccafeθ n ujimiys, ettesγe s γers s essumes elkul, ezzaθ n memminnum ettege ettejebbent.» <verse eid="GEN 23:9" /><verse number="10" style="v" sid="GEN 23:10" />εefruwn y kan ygeεmez g wemmes n iHeθθiyyen, yen ezzeθensen elkul, ezzaθ n ihelli HDeren g elmiεaδ n temurθes: <verse eid="GEN 23:10" /><verse number="11" style="v" sid="GEN 23:11" />«la, ya siydiy. esseγδiyδ, tay ejimiyw exettuwce ettiyriθ elli δiys exettuwce ezzaθ n midden n temuwreθ elkul exennuwce, ewiyt terδmeδ δiys elmeytex.» <verse eid="GEN 23:11" /><verse number="12" style="v" sid="GEN 23:12" />iTebbeS ibrahiym tikkelt xlaf ezzaθ midden n temuwreθ, <verse eid="GEN 23:12" /><verse number="13" style="v" sid="GEN 23:13" />yen yεefruwn ezzaθ n leεbaδ elkul: «iδekan texseδ esseγδiyδ cex. neč δeδefεe essuwm n ujiymi. eqbelt s γeri bac e reδme ilemmittaw diyn.» <verse eid="GEN 23:13" /><verse number="14" style="v" sid="GEN 23:14" />yer εefruwn f ebrahiym: <verse eid="GEN 23:14" /><verse number="15" style="v" sid="GEN 23:15" />esseγδiyδ esiydiy, elqeεεeθ essumes erbεe myat cagil (εuddi xemse kiylu n elfeTTeθ) wessuwme elγres Hette elqiymeθ mabinatne. erδem elmeytex.» <verse eid="GEN 23:15" /><verse number="16" style="v" sid="GEN 23:16" />yeqbel ibrahiym yeznes elfeTTeθ elli yenne felles ezzaθ n iHeθθiyyen, erbεe myat cagil xeδmen essisen iHwentiyyen. <verse eid="GEN 23:16" /><verse number="17" style="v" sid="GEN 23:17" />usahen yeδwel ejiymi n εefruwn elli g temekfiylt ezzaθ n memra seg aqqes n tefuwθ, s tiriθes decjer elli yenneD felles elkul, <verse eid="GEN 23:17" /><verse number="18" style="v" sid="GEN 23:18" />δegli n ibrahiym, s echaδeθ n iHeθθiyyen, midden elkul elli HDeren g elmiεaδ n temuwreθ. <verse eid="GEN 23:18" /><verse number="19" style="v" sid="GEN 23:19" />usiyn yerδem ibrahiym liweces sarreh g tiyriθ n temekfiylt ezzaθ n memra seg aqqes n tefuwθ, Hebruwn g elqeεεeθ n kenεan. <verse eid="GEN 23:19" /><verse number="20" style="v" sid="GEN 23:20" />usahen ejiymi ettiyriθ elli δiys eδwlen δegli n ibrahiym seg iHeθθiyyen emtjebbent ynette.<verse eid="GEN 23:20" /></para>
  <chapter eid="GEN 23" />
  <chapter number="24" style="c" sid="GEN 24" />
  <para style="s">enjef n isHaq</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 24:1" />yekber ibrahiym yuwser egget ibarxes rebbi g kul cey. <verse eid="GEN 24:1" /><verse number="2" style="v" sid="GEN 24:2" />yen ibrahiym yeccaf n ixeddemnes elli yelhayes s kul cey: «HuT efusex s eddu elfexδiyw. <verse eid="GEN 24:2" /><verse number="3" style="v" sid="GEN 24:3" />teθjulleδ s rebbi, erreb n esme delqeεεeθ elli etteγec y memmi temeTTuwθ seg tifrax n ikenεaniyyen elli eddere uggemmesensen. <verse eid="GEN 24:3" /><verse number="4" style="v" sid="GEN 24:4" />emme berre y temurθiyw dmidniyw, taγeδ temeTTuwθ y memmi isHaq.» <verse eid="GEN 24:4" /><verse number="5" style="v" sid="GEN 24:5" />yennes exeddemes: «umax etqeliyc temeTTuwθ eθeddes iyδi y elqeεεeθ, eδuwle s memmiyx y elqeεεeθ elli tuseδeδ essis?» <verse eid="GEN 24:5" /><verse number="6" style="v" sid="GEN 24:6" />y er felles ibrahiym: «er elbalex eθeδwleδ s memmi eldiyn, <verse eid="GEN 24:6" /><verse number="7" style="v" sid="GEN 24:7" />rebbi, erreb n esme, elli yiwiyiyδ seg elHuwc n dadde delqeεεeθ n midniyw, yuθleyiyδ yedjul, &lt;yidreriyx δeθuwce elqeεεeθe.&gt;, δeyezen elmlexes ezzeθex bac e θaγeδ temeTTuwθ y memmi esyiyn. <verse eid="GEN 24:7" /><verse number="8" style="v" sid="GEN 24:8" />iδekan temeTTuwtdiyn elteqqiylc exθeθbeε, elweqθes eθkuwneδ makec melzuwm s weθjulliyw wahen, emme memmi er elbalex eθeδwleδ essis eldiyn.» <verse eid="GEN 24:8" /><verse number="9" style="v" sid="GEN 24:9" />iHuT elεebδ efuses seddu elfexδ n siydiys ibrahiym yeθjul f elHkeyettin.<verse eid="GEN 24:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 24:10" />usiyn yiwi εecre δileγman yεebbaθen s elxiyraθ elkul s γer siydiys, yekker yemreq yeram ennehriyn y temuwreθ ennaHuwr enjenjwes n ibrahiym. <verse eid="GEN 24:10" /><verse number="11" style="v" sid="GEN 24:11" />yesgeεmez ileγmenes elberre n temuwreθ yetwali elεiyn n wamen tisemsiyn, elweqθ n waseδ n elwacun bac e θuwreδneθ. <verse eid="GEN 24:11" /><verse number="12" style="v" sid="GEN 24:12" />yen: «ya rebbi, erreb n siydiy ibrahiym, wefqiyδ asse tegeδ elli tεahδeδ essis siydiy ibrahiym. <verse eid="GEN 24:12" /><verse number="13" style="v" sid="GEN 24:13" />tay neč y etwali elεiyn n wamen utifrax n leεbaδ n temuwreθ effeγneθ δeθuwreδneθ, <verse eid="GEN 24:13" /><verse number="14" style="v" sid="GEN 24:14" />δenne y icθ essisneθ, &lt;eg elmziyyeθ HuT teqliltem bac e swe.&gt; max eθer felle, &lt;esw! tay δesseswe ileγmenex.&gt; tediyn elli texθaret y elεebδex isHaq usahen esne elli θegiyδ elli tuεeδeδ essis siydiy.»<verse eid="GEN 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 24:15" />qebl eykemmel eθzalliθes yezre tefruwxθ jayye uteqliltes f elkeθfes, tkan tebhe egget, weltuwc eltuγiyc. eθkan δrifqeh yelliys n betuwYiyl memmis n milkeh liwec ennaHuwr enjes n ibrahiym. <verse eid="GEN 24:15" /><verse number="16" style="v" sid="GEN 24:16" />teggez y elεiyn tεebbe teqliltes tali. <verse eid="GEN 24:16" /><verse number="17" style="v" sid="GEN 24:17" />yezzel elεebδ y etweliys yennes: «eg elmziyyeθ esseswiyδ qiqqi n wamen seg teqliltem.» <verse eid="GEN 24:17" /><verse number="18" style="v" sid="GEN 24:18" />ter felles: «esw siydiy.» tessuggez teqliltes liyhliyh tesseswi. <verse eid="GEN 24:18" /><verse number="19" style="v" sid="GEN 24:19" />max i yeswe tennayes: «δesseswe ileγmenex zade.» <verse eid="GEN 24:19" /><verse number="20" style="v" sid="GEN 24:20" />texDem ettezzel tenγel teqliltes g eθyenjuwrθ n wamen tezzel y wanu teγref y ileγmenes elkul. <verse eid="GEN 24:20" /><verse number="21" style="v" sid="GEN 24:21" />yeqqiym eryazdiyn ireqqeb δiys unette yesger yetxemmem iδekan rebbi yweffeqθ ziyγ la.<verse eid="GEN 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 24:22" />max i rwan ileγman yenzeγ eryazdiyn texzemt twedzen ezyen n ecciykel (εuddi sette gram) dsen δeswaraθ n uwreγ wedznen εecre ciykel (εuddi miyye uεicriyn gram). <verse eid="GEN 24:22" /><verse number="23" style="v" sid="GEN 24:23" />yenceδt: «enniyδ δyelliys n wiyn cem? elyelliyc elfDe g elHuwc n daddem enenεes δiys?» <verse eid="GEN 24:23" /><verse number="24" style="v" sid="GEN 24:24" />ter felles: «neč δyelliys n betuwYiyl memmis n milkeh elli tiruθ y naHuwr, <verse eid="GEN 24:24" /><verse number="25" style="v" sid="GEN 24:25" />γenne egget eluwm delεelfeθ dwemxan eθenεsem δiys.» <verse eid="GEN 24:25" /><verse number="26" style="v" sid="GEN 24:26" />y esjeδ eryaz y rebbi yeHmedθi. <verse eid="GEN 24:26" /><verse number="27" style="v" sid="GEN 24:27" />yen: «tbark erreb n siydiy ibrahiym elli yege elli yuεeδ essis siydiy. emme neč yehδayiyδ rebbi y webriδ n elHuwc n emmaθen n siydiy.»<verse eid="GEN 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 24:28" />tezzel tefruwxtdiyn y elHuwc tennes y yemmes elli ySar. <verse eid="GEN 24:28" /><verse number="29-30" style="v" sid="GEN 24:29-30" />rifqeh ykan γers enjes esmiθes laban, yezre texzemt deswaraθ g wafus n weltmas yesl edwiys f weryaz, yezzel y weryaz y etwali elεiyn n wamen, yafi ibed ezzaθ n ileγman y etwali elεiyn. <verse eid="GEN 24:29-30" /><verse number="31" style="v" sid="GEN 24:31" />y en: «heyye, iyδi y elHuwc eyemebruwx seg erreb. ecbiyk eθbeddeδ elberre? HeDre elHuwc dwemxan y ileγman.» <verse eid="GEN 24:31" /><verse number="32" style="v" sid="GEN 24:32" />yaδef eryaz y elHuwc yennasen laban eHuTTen f ileγman ucnasen eluwm delεelfeθ. yeγδes amen bac e ysiyreδ ikreεnes dikraεen n elli iyδes. <verse eid="GEN 24:32" /><verse number="33" style="v" sid="GEN 24:33" />usiyn HuTTnes eče. yaxi yen exeddam: «eltette kan enne elli yelzem eθenne.» yennes laban: «uθlay.»<verse eid="GEN 24:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 24:34" />yen: «neč δexeddam n ibrahiym. <verse eid="GEN 24:34" /><verse number="35" style="v" sid="GEN 24:35" />urebbi yucayes elxiyr elkul yeδwel δemuγni, yucayes esεi difunasen delfeTTeθ duwreγ dixeddamen etxeddamin dileγman diγyal, <verse eid="GEN 24:35" /><verse number="36" style="v" sid="GEN 24:36" />taru sarreh liwec n siydiy beεεeδ i θuser efruwx δeyuwreθ lefluses elkul. <verse eid="GEN 24:36" /><verse number="37" style="v" sid="GEN 24:37" />yesθeHlfiyδ siydiy esetteγac y memmis tefruwxθ seg tifrax n ikenεaniyyen elli iεemmer g elqeεθensen <verse eid="GEN 24:37" /><verse number="38" style="v" sid="GEN 24:38" />emme exemme y elHuwc n daddes dmidnes eγe tefruwxθ essisen y memmis, <verse eid="GEN 24:38" /><verse number="39" style="v" sid="GEN 24:39" />enγes y siydiy, &lt;balek etqeliyc eyθeθbeε y elqeεεeθe.&gt; <verse eid="GEN 24:39" /><verse number="40" style="v" sid="GEN 24:40" />yer felle, &lt;enniyθiyw diyme essefraHe δiys δeyazen iyδex elmlexes δexiweffeq g webriδex usiyn δeθeγeδ tefruwxθ ymemmi seg midniyw delHuwc n dadde. <verse eid="GEN 24:40" /><verse number="41" style="v" sid="GEN 24:41" />umax eθewDeδ y etwali midniyw usiyn etqeliync exuwcen tefruwxθ elweqθes makec melzuwm s elyminiyw.&gt;<verse eid="GEN 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="GEN 24:42" />esδe asse y etwali elεiyn enne, &lt;ya rebbi, erreb n siydiy ibrahiym eg elmziyyeθ wefqiyδ g elli f elxeĎres egiyγ erreHleθe.&gt; <verse eid="GEN 24:42" /><verse number="43" style="v" sid="GEN 24:43" />tay neč bedde f wanu n wamen, tefruwxθ elli eθeddes δeθuwreδ welli esenne eyθessesw qiqqi n wamen s teqliltes. <verse eid="GEN 24:43" /><verse number="44" style="v" sid="GEN 24:44" />usiyn eyθen, &lt;cex esw uneč esseswe ileγmenex zade, ennetteθ δeθkuwn ettefruwxθ elli yexθariθ rebbi y memmis n siydiy.&gt; <verse eid="GEN 24:44" /><verse number="45" style="v" sid="GEN 24:45" />elluciyγ elkemlexc edwiyw, tay rifqeh tuseδ tqam teqliylt f elkeθfes teggez y elεiyn tuwreδ enγes, &lt;esseswiyδ eθegeδ elmziyyeθ.&gt; <verse eid="GEN 24:45" /><verse number="46" style="v" sid="GEN 24:46" />eθHuT teqliltes liyhliyh tenniyδ, &lt;esw! utay δesseswe ileγmenex zade.&gt; eswe tessesw ileγman zade. <verse eid="GEN 24:46" /><verse number="47" style="v" sid="GEN 24:47" />usiyn encδat, &lt;δyelliys n wiyn cem?&gt; ter felle, &lt;δyelliys n betuwYiyl ben naHuwr elli tirwasθ milkeh.&gt; egγes texzemt g elxecmes deswaraθ g ifesnes, <verse eid="GEN 24:47" /><verse number="48" style="v" sid="GEN 24:48" />usiyn sjeδe eHemde rebbi erreb n siydiy ibrahiym elli y ehδayiyδ y webriδ uSHiyH bac e δaγe y elliys enjenjwes n siydiy y memmis. <verse eid="GEN 24:48" /><verse number="49" style="v" sid="GEN 24:49" />uture iδekan etεezzem belHeq siydiy eqbleθ ziyγ enniyδ bac e sne mat ege.»<verse eid="GEN 24:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="GEN 24:50" />erren felles laban dbetuwYiyl: «wahen elkul s γer rebbi unečin engeddec exnen wa ziyγ la. <verse eid="GEN 24:50" /><verse number="51" style="v" sid="GEN 24:51" />tay rifqeh ezzeθex, ewiyt temerqeδ. netteθ y memmis n siydiyx emmax i yenne rebbi.» <verse eid="GEN 24:51" /><verse number="52" style="v" sid="GEN 24:52" />max i yesle exeddam n ibrahiym edwiynsen y esjeδ f elqeεεeθ y rebbi. <verse eid="GEN 24:52" /><verse number="53" style="v" sid="GEN 24:53" />yenzeγ elfeTTeθ duwreγ dedbac yuwcin y rifqeh y uwc zade elhδaye eγlaneθ y enjenjwes dyemmes. <verse eid="GEN 24:53" /><verse number="54" style="v" sid="GEN 24:54" />usiyn yeč yesw nette diryeznes. ubeεδ ensen iDensen diyn ekren talji yenneyasen: «seyyebmiyδ bac e δuwle y siydiy.» <verse eid="GEN 24:54" /><verse number="55" style="v" sid="GEN 24:55" />ziyγ erren felles enjenjwes dyemmes: «edj tefruwxθ eθeqqiym iyδne εelleqel εecre eyyam xlaf, usiyn eθemreq.» <verse eid="GEN 24:55" /><verse number="56" style="v" sid="GEN 24:56" />yennasen: «eyeθεeTlemc εlexaTer rebbi yweffeq erreHlθiyw. edj eδuwle y siydiy.» <verse eid="GEN 24:56" /><verse number="57" style="v" sid="GEN 24:57" />erren felles: «ennabe tefruwxθ nencet.» <verse eid="GEN 24:57" /><verse number="58" style="v" sid="GEN 24:58" />naben rifqeh encδenteθ: «texseδ eθemerqeδ dweryaze ture.» ter fellasen: «emerqe.» <verse eid="GEN 24:58" /><verse number="59" style="v" sid="GEN 24:59" />seyben rifqeh weltmansen ettmeTTuwθ elli tessesfiyθ duxeddam n ibrahiym diryeznes, <verse eid="GEN 24:59" /><verse number="60" style="v" sid="GEN 24:60" />barxen y rifqeh ennanes: «cem δweltmeθne, aru egget teδwleδ δelaluwf egget widreriym eθurθen timuwre n ihelli enγiycenc.» <verse eid="GEN 24:60" /><verse number="61" style="v" sid="GEN 24:61" />tekker rifqeh etxeddemines erkebneθ f ileγman bac e θbeεneθ iryazen. elweqθes exeddam yawi rifqeh yemreq uggebriδes.»<verse eid="GEN 24:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="GEN 24:62" />elweqθes isHaq elli ykan iεemmer g elqeεεeθ eltebεiδc f biyr leHeyruYi g enneqeb. <verse eid="GEN 24:62" /><verse number="63" style="v" sid="GEN 24:63" />tisemsiyn yeffeγ yetHewwes g ujiymi, yqam tiTTewines, tay yezer ileγman jayyiyn, <verse eid="GEN 24:63" /><verse number="64" style="v" sid="GEN 24:64" />rifqeh tqam zade tiTTewines tezri, teggez seg elγem, <verse eid="GEN 24:64" /><verse number="65" style="v" sid="GEN 24:65" />tenceδ exeddam: «δ wiyn eryaz elli yegguwr g ujiymi ujay etwelinne?» yer exeddam: «δsiydiy.» tqam elxmar tiyreδ imenes. <verse eid="GEN 24:65" /><verse number="66" style="v" sid="GEN 24:66" />ubeεδ yeHke exeddam yisHaq elli yegi elkul. <verse eid="GEN 24:66" /><verse number="67" style="v" sid="GEN 24:67" />yessuwδef isHaq rifqeh ytexyamt n yemmes sarreh, yaγiθ yexsiθ. elweqθes yeθεezzat isHaq beεεeδ ejafi n yemmes.<verse eid="GEN 24:67" /></para>
  <chapter eid="GEN 24" />
  <chapter number="25" style="c" sid="GEN 25" />
  <para style="s">ezzerriyεeθ n eqTuwreh</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 25:1" />yeδwel ibrahiym yaγ temeTTuwθ ellesmes qTuwreh. <verse eid="GEN 25:1" /><verse number="2" style="v" sid="GEN 25:2" />taγδes zimran deyeqcan demdan demedyan deyecbaq <verse eid="GEN 25:2" /><verse number="3" style="v" sid="GEN 25:3" />uyeqcan yuγeδ caba δdedan. wezzerriyεeθ n dedan: iccuwriyyen dilTuwciyyen dilimmiyyen. <verse eid="GEN 25:3" /><verse number="4" style="v" sid="GEN 25:4" />widrari n midyan nihnin: εeyfeh diεifr deHnuwk debiydaε deldeεeh. wiyhen elkul usiynd seg qTuwreh. <verse eid="GEN 25:4" /><verse number="5" style="v" sid="GEN 25:5" />yuwc ibrahiym elli γers elkul yisHaq. <verse eid="GEN 25:5" /><verse number="6" style="v" sid="GEN 25:6" />emme idreriys seg hajer deqTuwreh yuceyasen elhδaye yezenten max elyuwc yedder y etwali elqeεεeθ n eccerq y ebεeδ f memmis isHaq.<verse eid="GEN 25:6" /></para>
  <para style="s">temettent n seyyedne ibrahiym</para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 25:7" />yedder ibrahiym miyye uxemse usebεiyn sne. <verse eid="GEN 25:7" /><verse number="8" style="v" sid="GEN 25:8" />beεεeδ i yedder egget, yjaf merθaH yaweD f ihelli esebqent. <verse eid="GEN 25:8" /><verse number="9" style="v" sid="GEN 25:9" />erδment idreriys isHaq dismaεiyl g tiyriθ n temekfiylt g ujiymi n εefruwn memmis n SuwHer elHeθθi g weqqeS n tefuwθ n memra. <verse eid="GEN 25:9" /><verse number="10" style="v" sid="GEN 25:10" />ejimidiyn wediyn elli yesγi ibrahiym seg iHeθθiyyen uδiys yemmerδem ibrahiym dliweces sarreh. <verse eid="GEN 25:10" /><verse number="11" style="v" sid="GEN 25:11" />beεεeδ ejafi n ibrahiym ibarex rebbi isHaq memmis, yedder isHaq yetwali biyr leHeyruYiy.<verse eid="GEN 25:11" /></para>
  <para style="s">idrari n Yismaεiyl</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 25:12" />emme idrari n Yismaεiyl emmiys n Yibrahiym elli θiruθi hajer θemiSriyθ texeddemt n sarreh, <verse eid="GEN 25:12" /><verse number="13" style="v" sid="GEN 25:13" />iyh elliseminsen seg umeqqar yumezyan: nbayuwt emenzu n Yismeεiyl, dqiydar dYedebYiyl dmibSam <verse eid="GEN 25:13" /><verse number="14" style="v" sid="GEN 25:14" />dmicmaε dduwme dmesse <verse eid="GEN 25:14" /><verse number="15" style="v" sid="GEN 25:15" />dHidar dtiyma dyeTuwr dnafiyc dqidme. <verse eid="GEN 25:15" /><verse number="16" style="v" sid="GEN 25:16" />iyh eyendeγ idrari n Yismeεiyl wiyh elliseminsen f elHseb n leHwecensen, unihnin eθnac δerruyyas g elqbeylensen. <verse eid="GEN 25:16" /><verse number="17" style="v" sid="GEN 25:17" />ukanen leεwam elli yedderθen Yismeεiyl miyye usebεe utleθiyn esne, welbeεεeδ yemmuwθ yexleĎ f midnes. <verse eid="GEN 25:17" /><verse number="18" style="v" sid="GEN 25:18" />ukanen εemren seg Hwiyle y cuwr, g eccerq n miSr g webriδ y cuwr usah yeεmer Yismeεiyl twali ewmeθnes.<verse eid="GEN 25:18" /></para>
  <para style="s">arew n εiysuw dyeεquwb</para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 25:19" />tah elHkayeθ n elεiyleθ n isHaq memmis n ibrahiym. <verse eid="GEN 25:19" /><verse number="20" style="v" sid="GEN 25:20" />w ykan isHaq γers erbεiyn sne max i yuγe rifqeh yelliys n ebtuwiyl elerami, uweltmas n laban, seg teHmiylt n eram. <verse eid="GEN 25:20" /><verse number="21" style="v" sid="GEN 25:21" />εlexaTer rifqeh tkan ettelεagerθ, isHaq yezzal y rebbi f elxeĎres. yeqbel rebbi s γers teδwel rifqeh δeθaru. <verse eid="GEN 25:21" /><verse number="22" style="v" sid="GEN 25:22" />emεarxen etwame g teδisθes ten: «kan elHkayeθ sahen, imette neč eHeble εaδ?» texDem δeθenceδ rebbi. <verse eid="GEN 25:22" /><verse number="23" style="v" sid="GEN 25:23" />yennes rebbi: «teδisθem δiys sent ettimuwre, δeyeffeγ essis sen δlenwaε n leεbaδ, iyjen δeyeδwel eqwe n wissen, emeqqar deyexδem emezyen.» <verse eid="GEN 25:23" /><verse number="24" style="v" sid="GEN 25:24" />as n warew tuγeδ etwame. <verse eid="GEN 25:24" /><verse number="25" style="v" sid="GEN 25:25" />emezwar yuseδ dezukkeγ welbeδnes emnuwber, emmale semmant εiysuw. (meεnahe imceεεer.) <verse eid="GEN 25:25" /><verse number="26" style="v" sid="GEN 25:26" />ubeεεeδ yeffeγ enjes yeTTef g elεerqubes, emmale semmant yeεquwb. max i θiru rifqeh, isHaq ykan δmemmis n settiyn sne.<verse eid="GEN 25:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 25:27" />ekebren idrari, yeδwel εiysuw δeSeyyeδ yessen egget uyexs ijiyman, uyeεquwb ykan δelεaqel yexs kan δexyam. <verse eid="GEN 25:27" /><verse number="28" style="v" sid="GEN 25:28" />yeδwel isHaq yexs εiysuw εlexaTer yeεjebθ elli yetteSSaD δiys, emme rifqeh texs yeεquwb.<verse eid="GEN 25:28" /></para>
  <para style="s">εiysuw eyuc temenzuyθes</para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 25:29" />yelle as yeεquwb iĎeyyeb eče, yrewweH εiysuw seg ijiyman unette yelluwz egget <verse eid="GEN 25:29" /><verse number="30" style="v" sid="GEN 25:30" />yennes yyeεquwb: «uciyδ eče seg eliδame ezukkaγ εlexaTerni elluwze egget.» emmale yeδwel etnebanes eduwm. <verse eid="GEN 25:30" /><verse number="31" style="v" sid="GEN 25:31" />yennes yeεquwb: «ezzenziyδ qebl temenzuyθex.» <verse eid="GEN 25:31" /><verse number="32" style="v" sid="GEN 25:32" />yer felles εiysuw: «neč εuddi δejafe s elez, δme δeyθeg temenzuyθiyw?» <verse eid="GEN 25:32" /><verse number="33" style="v" sid="GEN 25:33" />yennes yeεquwb: «eθjulli qebl.» yeθjulles, yezzenzes temenzuyθes. <verse eid="GEN 25:33" /><verse number="34" style="v" sid="GEN 25:34" />yuwces yeεquwb y εiysuw eγrum delεδe n tiniyfin, yeč yesw yekker yexDem. usah yeHqer εiysuw temenzuyθes.<verse eid="GEN 25:34" /></para>
  <chapter eid="GEN 25" />
  <chapter number="26" style="c" sid="GEN 26" />
  <para style="s">isHaq g ejrar</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 26:1" />teseδ ezzemmeθ bexlaf ezzemmeθ temezwarθ g liyyam n ibrahiym. yexDem isHaq y temuwreθ n ebiymalek, elmlek n ifilesTiyniyyen g ejrar. <verse eid="GEN 26:1" /><verse number="2" style="v" sid="GEN 26:2" />yeffeγes rebbi yennes: «eθexeDmec y miSr, eεmer g elqeεεeθ elli δexittessexne. <verse eid="GEN 26:2" /><verse number="3" style="v" sid="GEN 26:3" />eqqiym g elqeεεeθe, uneč δekuwne iyδex uδebarxe δiyx, icex didreriyx δeθuwce elqeεεeθe elkul, emmax i θjulle y daddex ibrahiym. <verse eid="GEN 26:3" /><verse number="4" style="v" sid="GEN 26:4" />δerre idreriyx egget emiθran n esme ucγasen elqeεεeθe elkul. leεbaδ n eddunyeθ elkul δesθbarxen s idreriyx. <verse eid="GEN 26:4" /><verse number="5" style="v" sid="GEN 26:5" />εlexaTer ibrahiym yesle edwiyw, yedj elwSeyθiyw delfreyδiyw delqweniniyw.» <verse eid="GEN 26:5" /><verse number="6" style="v" sid="GEN 26:6" />usah yeεmer isHaq g ejrar. <verse eid="GEN 26:6" /><verse number="7" style="v" sid="GEN 26:7" />max i θencδen leεbaδ n temuwreθ f liweces yenneyasen: «δweltme.» εlexaTer yukkeδ eyen: «δliweciyw.» yetεilak balek eθenγen f elxeĎres, εlexaTer tkan tebhe egget. <verse eid="GEN 26:7" /><verse number="8" style="v" sid="GEN 26:8" />max i yeεmer egget diyn, ebiymalek elmlek n ifilesTiyniyyen yTul seg eccebbexes yezer isHaq yettirar dliweces rifqeh. <verse eid="GEN 26:8" /><verse number="9" style="v" sid="GEN 26:9" />inebaθ yennes: «δliwecex, ecbiyk ziyγ tenniyδ δweltme?» yer felles isHaq: «enniyγ balek ejafe f elxeĎres.» <verse eid="GEN 26:9" /><verse number="10" style="v" sid="GEN 26:10" />yen ebiymalek: «δme wahen ittegiyδ δiyne? ykan yeshel iyjen seg iryeznenne yumken eyenεes dliwecex, usahen exenttaγeδ eδδemb.» <verse eid="GEN 26:10" /><verse number="11" style="v" sid="GEN 26:11" />inebbeh ebiymalek leεbaδ elkul yennasen: «elli eylemmes eryaze ziyγ liweces δeyemmenγ.»<verse eid="GEN 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 26:12" />yezreε isHaq elqeεεeθdiyn, yemjer g usukkesdiyn myat merre elli yezreεθi, εlexaTer rebbi ibarex δiys, <verse eid="GEN 26:12" /><verse number="13" style="v" sid="GEN 26:13" />yeδwel δemuγni egget yekber eccenes. <verse eid="GEN 26:13" /><verse number="14" style="v" sid="GEN 26:14" />yeδwel γers esεi difunasen dixeddamen egget. eHsδent ifilesTiyniyyen.<verse eid="GEN 26:14" /></para>
  <para style="s">enuwyeθ jar jrar dbiyr sebεe</para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 26:15" />yaxi erδmen ifilesTiyniyyen isaqqen elkul elli eHfrenten ixeddamen n daddes ibrahiym g liyyemes, εebbenten s ecal. <verse eid="GEN 26:15" /><verse number="16" style="v" sid="GEN 26:16" />yen ebiymalek yisHaq: «erHel s γenne εlexaTer teδweleδ eqwanne.» <verse eid="GEN 26:16" /><verse number="17" style="v" sid="GEN 26:17" />yaxi yeffeγ isHaq esyiyn yenSeb ixyemnes g esuwf n ejrar yeεmer diyn. <verse eid="GEN 26:17" /><verse number="18" style="v" sid="GEN 26:18" />iεaweδ isHaq yeHfer isaqqen elli emmeHfren g liyyam n daddes ibrahiym welli erδmenten ifilesTiyniyyen beεεeδ ejefis. ysemmaθen emmax i nnisemme daddes. <verse eid="GEN 26:18" /><verse number="19" style="v" sid="GEN 26:19" />max i Hefren ixeddamen n isHaq g esuwf efen diyn elεiyn n wamen, <verse eid="GEN 26:19" /><verse number="20" style="v" sid="GEN 26:20" />mεarxen f elles iniylten n ejrar diniylten n isHaq ennen iniylten n ejrar: «emane δegliynne.» yaxi ysemme isHaq esuγ εiseq εlexaTer mεarxen felles. <verse eid="GEN 26:20" /><verse number="21" style="v" sid="GEN 26:21" />eHfren esuγ xlaf mεarxen felles zade, yaxi ysemmat siTne. (meεnahe elεδaweθ.) <verse eid="GEN 26:21" /><verse number="22" style="v" sid="GEN 26:22" />iHewwel esyiyn eHfren esuγ xlaf ellemεarxenc felles, yaxi ysemmaθ reHbuwt, yen: «ture yefreH essiyne rebbi yucane emxan uwseε, yelzem enexθer g elqeεεeθ.»<verse eid="GEN 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 26:23" />esyiyn yuwli ibiyr sebεe, <verse eid="GEN 26:23" /><verse number="24" style="v" sid="GEN 26:24" />g δeggiyδdiyn yeffeγes rebbi yen: «neč δerreb n daddex ibrahiym, eθukδec, neč iyδex δebarxe δiyx edje idreriyx egget f elxaĎer n elεebδiyw ibrahiym.» <verse eid="GEN 26:24" /><verse number="25" style="v" sid="GEN 26:25" />yebne isHaq diyn elmeδbeH yeδεu s ellesm n rebbi. yenSeb texyemtes diyn eHfren ixeddemnes esuγ.<verse eid="GEN 26:25" /></para>
  <para style="s">elHelf jar isHaq debiymalek</para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 26:26" />yesδes ebiymalek seg jrar dimuεewnes eHuzzat dfiykuwl elqayeδ n eljices. <verse eid="GEN 26:26" /><verse number="27" style="v" sid="GEN 26:27" />yennasen isHaq: «ecbiykum tuseδmiyδ uxenyum tekrehmiyδ eθgellebmiyδ s γerwem?» <verse eid="GEN 26:27" /><verse number="28" style="v" sid="GEN 26:28" />ennen: «nezre belgde elli erreb iyδex, nen edj eyeδwel mabinatne elHelf wedj enemεaheδ <verse eid="GEN 26:28" /><verse number="29" style="v" sid="GEN 26:29" />elli exenttegeδ Hette cey, emmax i xnegi kan δelxiyr enseybax menγiyr Hette cey. cex ture ibarex δiyx rebbi.» <verse eid="GEN 26:29" /><verse number="30" style="v" sid="GEN 26:30" />yeεreD f ellasen isHaq, ečen eswen, <verse eid="GEN 26:30" /><verse number="31" style="v" sid="GEN 26:31" />elweječe ekkeren bekri eθHalfen meεe beεDhum. iceyyeεθen isHaq, exDmen salmiyn. <verse eid="GEN 26:31" /><verse number="32" style="v" sid="GEN 26:32" />esses esδen ixeddamen n isHaq ennanes f esuγ elli eHfrent: «nufe amen!» <verse eid="GEN 26:32" /><verse number="33" style="v" sid="GEN 26:33" />ysemmaθ isHaq cibεe. (meεnahe eθjulli.) heδake εlac yeδwel ellesm n temuwreθ biyr sebεe elwasse.<verse eid="GEN 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 26:34" />max i yeδwel εiysuw γers erbεiyn sne yuγe yehuwdiyt yelliys n biyri eHeθθi yaγ xlaf besme yelliys n iluwn eHeθθiy, <verse eid="GEN 26:34" /><verse number="35" style="v" sid="GEN 26:35" />neγγesneθ elεiyceθ n isHaq drifqe.<verse eid="GEN 26:35" /></para>
  <chapter eid="GEN 26" />
  <chapter number="27" style="c" sid="GEN 27" />
  <para style="s">isHaq eybarex yeεquwb</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 27:1" />max i yekber isHaq yeDεaf enneĎres inabe memmis emeqqar εiysuw yennes: «emmi!» yer felles: «tay neč dah.» <verse eid="GEN 27:1" /><verse number="2" style="v" sid="GEN 27:2" />yen isHaq: «tay tzerreδ δiyye ekbare wellessinac lemmi δejafe. <verse eid="GEN 27:2" /><verse number="3" style="v" sid="GEN 27:3" />awi esleHex denneblex delqusex, texDmeδ y ijiyman teSθeddiyδ Haje, <verse eid="GEN 27:3" /><verse number="4" style="v" sid="GEN 27:4" />tHeDDerδiyδ eče ebehhay elli exsaθ, teγeddiyδ eče, bac e barxe δiyx qebl ejafe.»<verse eid="GEN 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 27:5" />rifqeh tkan tesseγδe y edwi n isHaq y memmis εiysuw. max i yeffeγ εiysuw y ijiyman bac e yeSSaD Haje y daddes, <verse eid="GEN 27:5" /><verse number="6" style="v" sid="GEN 27:6" />ten rifqeh y memmis y eεquwb: «esliyγ daddex yeqqar y enjex εiysuw, <verse eid="GEN 27:6" /><verse number="7" style="v" sid="GEN 27:7" />eγδiyδ Haje edĎeyyebδiyδ eče yebhe bac e če usiyn ebarxe δiyx ezzaθ n rebbi qebl ejafe. <verse eid="GEN 27:7" /><verse number="8" style="v" sid="GEN 27:8" />ture esl edwiyw, emmi, tegeδ elli δexiθenne. <verse eid="GEN 27:8" /><verse number="9" style="v" sid="GEN 27:9" />berre y esεi, texθareδ sen δiγayδen eqwan bac e Ďeybe y daddex eče yebhe emmax i yexs. <verse eid="GEN 27:9" /><verse number="10" style="v" sid="GEN 27:10" />tewiδasθen bac e yeč, usiyn eybarex δiyx qebl eyjaf.» <verse eid="GEN 27:10" /><verse number="11" style="v" sid="GEN 27:11" />yen yeεquwb irifqeh yemmes: «tay enjew εiysuw δiys ezew uneč eddiyac <verse eid="GEN 27:11" /><verse number="12" style="v" sid="GEN 27:12" />balek eyyilemmes dadde ifaq essi? maw δeyyisub welyetbariyxec δiyye.» <verse eid="GEN 27:12" /><verse number="13" style="v" sid="GEN 27:13" />tennes yemmes: «edj eyyisub enneč, emmi. esl edwiyw berk texDmeδ eγδiyδ iγayδen.» <verse eid="GEN 27:13" /><verse number="14" style="v" sid="GEN 27:14" />yexDem yeγδasθen, tĎeyyeb eče elli yexs daddes. <verse eid="GEN 27:14" /><verse number="15" style="v" sid="GEN 27:15" />welbeεεeδ tawi rifqeh edbac ibehhayen n memmis emenzu εiysuw elli γers g elHuces tirDasθen yyeεquwb memmis emezyen, <verse eid="GEN 27:15" /><verse number="16" style="v" sid="GEN 27:16" />tirDes iγelnes etbuqεet elli eddiyc ezew seg texrumtes s iliymen n iγayδen. <verse eid="GEN 27:16" /><verse number="17" style="v" sid="GEN 27:17" />tezles eče elli eθĎeyyebeθ deγrum, <verse eid="GEN 27:17" /><verse number="18" style="v" sid="GEN 27:18" />yaδef f daddes yennes: «dadde!» yer felles: «enεem! δ wiyn cex emmi?» <verse eid="GEN 27:18" /><verse number="19" style="v" sid="GEN 27:19" />yennes yeεquwb: «neč εiysuw emenzuwx, egiyγ elli tenniδiyδ felles, eg elmziyyeθ ekker fiyseε, geεmez, θečeδ seg elli eSSeDaθ, tbarxeθ δiyye.» <verse eid="GEN 27:19" /><verse number="20" style="v" sid="GEN 27:20" />yennes isHaq: «max i θuwfiδ Haje sahen liyhliyh emmi?» yer felles: «siydiyx rebbi ywefqiyδ.» <verse eid="GEN 27:20" /><verse number="21" style="v" sid="GEN 27:21" />yen isHaq: «est edj exlemse emmi bac e sne elli δcex εiysuw ziyγ la.» <verse eid="GEN 27:21" /><verse number="22" style="v" sid="GEN 27:22" />yeqreb yeεquwb ydaddes, ilemmesθ yen: «eSSuθ δeSSuθ n yeεquwb emme ifassen δifassen n εiysuw.» <verse eid="GEN 27:22" /><verse number="23" style="v" sid="GEN 27:23" />eθyuxiyzc εlexaTer ifesnes kanen δimceεren emεiysuw enjes. yaxi yeqbel eybarex δiys. <verse eid="GEN 27:23" /><verse number="24" style="v" sid="GEN 27:24" />yen: «mbelHeq cex δmemmi εiysuw?» yennes: «wah enneč.» <verse eid="GEN 27:24" /><verse number="25" style="v" sid="GEN 27:25" />yennes: «uciyδ eče seg exsum bac e barxe δiyx.» yezles exsum yeč, yeγδes ecrab yesw. <verse eid="GEN 27:25" /><verse number="26" style="v" sid="GEN 27:26" />yennes daddes isHaq: «eqreb eθkubδiyδ, emmi!» <verse eid="GEN 27:26" /><verse number="27" style="v" sid="GEN 27:27" />yeqreb ikubbi, icum erriyHeθ n edbeces ibarex δiys yennes: «erriyHeθ n memmi emerriyHeθ n ujiymi elli ibarex δiys rebbi. <verse eid="GEN 27:27" /><verse number="28" style="v" sid="GEN 27:28" />exyuwc rebbi seg enneδweθ n esme delxiyr n elqeεεeθ, iyrδen decrab egget. <verse eid="GEN 27:28" /><verse number="29" style="v" sid="GEN 27:29" />edj leεbaδ exexδmen, utimuwre exerkεen, eHkem g emmeθnex, edj idrari n yemmex exerkεen. eyemSab elli δexiSab, eyembarex elli δeybarex δiyx.» <verse eid="GEN 27:29" /><verse number="30" style="v" sid="GEN 27:30" />max i ykemmel isHaq seg ubarex n memmis yeεquwb, yeffeγ yeεquwb s γers, yrewweH εiysuw enjes seg elmeSyδes. <verse eid="GEN 27:30" /><verse number="31" style="v" sid="GEN 27:31" />yHeDDer zade eče yebhe yewiθ ydaddes yennes: «ekker edda eč seg elli eSSeDaθ tbarxeθ δiyye.» <verse eid="GEN 27:31" /><verse number="32" style="v" sid="GEN 27:32" />yennes daddes: «δ wiyn cex?» yennes: «neč δmemmiyx emenzu εiysuw.» <verse eid="GEN 27:32" /><verse number="33" style="v" sid="GEN 27:33" />yerεec isHaq egget yemmerεeb yen: «δ wiyn ziyγ yeSSaD yeγδiyδ ečiyγ qebl eθeddaseδ ubarxe δiys? wa, uδemebruwx δeykuwn.» <verse eid="GEN 27:33" /><verse number="34" style="v" sid="GEN 27:34" />max i yesle εiysuw edwi ndaddes yerw izeεweg eSbiyH yen: «barex δiyye Hette neč edda zade.» <verse eid="GEN 27:34" /><verse number="35" style="v" sid="GEN 27:35" />yer felles: «yuseδ enjex yawi s elHiyleθ elberxθex.» <verse eid="GEN 27:35" /><verse number="36" style="v" sid="GEN 27:36" />yen εiysuw: «eθensemmac yeεquwb? yHayel felle merθiyn: yiwi temenzuyθiyw, uture yiwi elberxθiyw.» yenceδt: «eyθedjiyc elberxeθ y neč?» <verse eid="GEN 27:36" /><verse number="37" style="v" sid="GEN 27:37" />yer felles isHaq: «tay erriyxθ δsiydiyx, wuciyγes emmeθnes elkul δixeddamen, ucγes iyrδen decrab, endre δmette δexege emmi?» <verse eid="GEN 27:37" /><verse number="38" style="v" sid="GEN 27:38" />yennes εiysuw: «endre edda γerx elberxeθ icθ berk? barex δiyye Hette neč zade edda.» yqam s uεeyyeĎ. <verse eid="GEN 27:38" /><verse number="39" style="v" sid="GEN 27:39" />yer felles daddes: «tay δeθeεmreδ g elqeεεeθ teqquwr, elyettuweθc felles amzer, <verse eid="GEN 27:39" /><verse number="40" style="v" sid="GEN 27:40" />δeθedreδ s essifex, y enjex δeθeδewleδ δexeddam, emme max eθeθmerδeδ eθkesreδ emnus seg θexrumtex.»<verse eid="GEN 27:40" /></para>
  <para style="s">yeεquwb eyerwel seg εiysuw</para>
  <para style="p">
    <verse number="41" style="v" sid="GEN 27:41" />yeHqeδ εiysuw f yeεquwb f elxaĎer nelberxeθ elli yuceyast daddes. yen g ules: &lt;liyyam n elHzen f dadde qrebneθ, usiyn δenγe enjew yeεquwb.&gt; <verse eid="GEN 27:41" /><verse number="42" style="v" sid="GEN 27:42" />yaxi tuθlayin n εiysuw iweDneθ y rifqeh, tnabe yeεquwb tennes: «esl! enjex yexs exyenγ bac e yawi eθθeres essix, <verse eid="GEN 27:42" /><verse number="43" style="v" sid="GEN 27:43" />uture esl edwiyw, emmi: ekker erwel yetwali enjew laban g Haran, <verse eid="GEN 27:43" /><verse number="44" style="v" sid="GEN 27:44" />teqqiymeδ γers liyyam elδeyebreδ enjex. <verse eid="GEN 27:44" /><verse number="45" style="v" sid="GEN 27:45" />max eyebreδ enjex yettu elli θegit δiys, elweqθes δexezne bac e θerjεeδ esyiyn. imette exennexsre uggas iyjen?»<verse eid="GEN 27:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="GEN 27:46" />usiyn tenne rifqeh yisHaq: «exrehe leHyeθiyw seg elwacun tiHeθθiyyin n εiysuw, lukan yeεquwb ayeγ icθ seg tifrax n Heθ ziyγ icθ seg tifrax n elqeεεeθe, imette leHyeθiyw εaδ?»<verse eid="GEN 27:46" /></para>
  <chapter eid="GEN 27" />
  <chapter number="28" style="c" sid="GEN 28" />
  <para style="s">yeεquwb γer laban</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 28:1" />inabe isHaq yeεquwb ibarex δiys yweSSaθ: «eθeγec seg tifrax n kenεan. <verse eid="GEN 28:1" /><verse number="2" style="v" sid="GEN 28:2" />ekker berre y teHmiylt n eram, y elHuwc n betuwYiyl daddes n yemmex, taγeδ temeTTuwθ esyiyn, seg tifrax n laban enjes n yemmex. <verse eid="GEN 28:2" /><verse number="3" style="v" sid="GEN 28:3" />eybarex δiyx rebbi elqader yxeθθer ezzerriεθex usinc eθeδewleδ egget ettimuwre. <verse eid="GEN 28:3" /><verse number="4" style="v" sid="GEN 28:4" />yuwcex elberxeθ n ibrahiym, icex didreriyx beεδex, bac e θurθeδ elqeεεeθ elli cex ture δeberrani, elli yuciθ rebbi y ibrahiym.» <verse eid="GEN 28:4" /><verse number="5" style="v" sid="GEN 28:5" />usiyn yuzen isHaq yeεquwb yexDem y teHmiylt n eram, y etwali laban memmis n betuwYiyl lerami enjes n rifqeh y emmes n yeεquwb dεiysuw.<verse eid="GEN 28:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 28:6" />max i yezre εiysuw elli isHaq ibarex g yeεquwb yezent y teHmiylt n eram bac e yeγ esyiyn, welli max i barex δiys yweSSaθ yennes: «eθeγec seg tifrax n kenεan.» <verse eid="GEN 28:6" /><verse number="7" style="v" sid="GEN 28:7" />welli yeεquwb yesle edwi n daddes dyemmes yexDem y teHmiylt n eram, <verse eid="GEN 28:7" /><verse number="8" style="v" sid="GEN 28:8" />yexez εiysuw elli tifrax n kenεan uHecneθ g tiT n daddes isHaq. <verse eid="GEN 28:8" /><verse number="9" style="v" sid="GEN 28:9" />yexDem y ismaεiyl memmis n ibrahiym yaγ yelliys meHelle weltmas ennebayuwt f elwecunes tiddiyn.<verse eid="GEN 28:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 28:10" />elweqθes yeffeγ yeεquwb seg biyr sebεe yexDem y Haran, <verse eid="GEN 28:10" /><verse number="11" style="v" sid="GEN 28:11" />yeweD g weggez n tefuwθ ywemxan yqam tγaγet esyiyn iHuTTiθ seddu ixfes yenεes diyn, <verse eid="GEN 28:11" /><verse number="12" style="v" sid="GEN 28:12" />yezer g tirjiyθ esselluwm yemmerxez g elqeεεeθ wellexres g esme, utay elmleyxaθ n rebbi ettelyen ettegzen felles. <verse eid="GEN 28:12" /><verse number="13" style="v" sid="GEN 28:13" />rebbi ykan ibed δenyes yennes: «neč δrebbi erreb n ibrahiym daddex derreb n isHaq! elqeεεeθ elli tettekkiyδ felles δettuwce icex didreriyx. <verse eid="GEN 28:13" /><verse number="14" style="v" sid="GEN 28:14" />uδeθexθer ezzerriεθex emecal n elqeεεeθ, uδeθeθwesεeδ yelγerb deccerq yecmal deljenuwb, δesθbarxen essix didreriyx leεbaδ n elqeεεeθ elkul, <verse eid="GEN 28:14" /><verse number="15" style="v" sid="GEN 28:15" />tay neč iyδex, δeεusse fellex elmeniy eθexDmeδ, rejjeεγex y elqeεεeθe. exettedjiyγc elδexege elli uεeδγex essis.» <verse eid="GEN 28:15" /><verse number="16" style="v" sid="GEN 28:16" />ifaq yeεquwb seg enuddemes yen g ules: «rahu rebbi dahen uneč mefibeliyc.» <verse eid="GEN 28:16" /><verse number="17" style="v" sid="GEN 28:17" />yukkeδ yen: «yessekkeδ emxane! wahen mbelHeq δelHuwc n rebbi delbab n esme.» <verse eid="GEN 28:17" /><verse number="18" style="v" sid="GEN 28:18" />elweječe yekker yeεquwb bekri, yesbed tγaγet elli yenεes felles, yenγel felles uwδi, <verse eid="GEN 28:18" /><verse number="19" style="v" sid="GEN 28:19" />ysemme emxandiyn biytiyl (meεnahe elHuwc n rebbi), weθkan ettemsemme qebl luwz <verse eid="GEN 28:19" /><verse number="20" style="v" sid="GEN 28:20" />yuεeδ yeεquwb elweεδeθ, yen: «iδekan rebbi iyδi eyεus felle uggebriδ elli δeθuyuwre δiys, yuwciyδ eγrum eθeče dedbac n wariD, <verse eid="GEN 28:20" /><verse number="21" style="v" sid="GEN 28:21" />erejεe labas y elHuwc n dadde, elweqθes eykuwn erreb δrebbi y neč. <verse eid="GEN 28:21" /><verse number="22" style="v" sid="GEN 28:22" />weθγaγette elli sbeddat δeθkuwn δelHuwc n rebbi, welli δeyettuwceδ elkul δexuwce essis elεcer.»<verse eid="GEN 28:22" /></para>
  <chapter eid="GEN 28" />
  <chapter number="29" style="c" sid="GEN 29" />
  <para style="s">yeεquwb eyemlaqe draHiyl</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 29:1" />welbeεδ ykemmel yeεquwb teyuriθes eδeyaweδ elqeεεeθ n leεbaδ elli εemren g eccerq. <verse eid="GEN 29:1" /><verse number="2" style="v" sid="GEN 29:2" />max i yerqeb yezre anu g ujiymi enneDen felles tlaθe δicellagen n esεi. esεi ykan ises g wanudiyn elli yemmemsel s eθγaγet temeqqarθ. <verse eid="GEN 29:2" /><verse number="3" style="v" sid="GEN 29:3" />max emlaymen icellagen elkul diyn, ebeεδen iniylten tγaγet seg iymi n wanu, esseswen esεi usiyn etterren uggemxenes. <verse eid="GEN 29:3" /><verse number="4" style="v" sid="GEN 29:4" />yenceδten yeεquwb: «s meniys xenyum eyemmeθniyw?» erren felles: «seg Haran.» <verse eid="GEN 29:4" /><verse number="5" style="v" sid="GEN 29:5" />yenceδten: «tessenem laban memmis ennaHuwr?» erren felles: «n essent.» <verse eid="GEN 29:5" /><verse number="6" style="v" sid="GEN 29:6" />yenceδten: «nette labas?» erren felles: «labas, tay raHiyl yelliys jayye s esεiys.» <verse eid="GEN 29:6" /><verse number="7" style="v" sid="GEN 29:7" />yennasen: «as elyuwc δiTwiyl, wesεi elyuwc yettemleyiymc ture, essesweθ esεi tewyemt eyerθeε.» <verse eid="GEN 29:7" /><verse number="8" style="v" sid="GEN 29:8" />ennen: «enged enessesw esεi kan max emlaymen elkul enbeεεeδ tγaγet seg iymi n wanu.» <verse eid="GEN 29:8" /><verse number="9" style="v" sid="GEN 29:9" />elweqθelli ykan yHekke iyδsen tuseδ raHiyl s esεi n daddes εlexaTer tkan teniyltiθ. <verse eid="GEN 29:9" /><verse number="10" style="v" sid="GEN 29:10" />max i tyezre yeεquwb s esεi n xalis, izewweδ ibeεεeδ tγaγet seg iymi n wanu yessesw esεi. <verse eid="GEN 29:10" /><verse number="11" style="v" sid="GEN 29:11" />welbeεδ ikub yeεquwb raHiyl yqam s uεeyyeĎ, <verse eid="GEN 29:11" /><verse number="12" style="v" sid="GEN 29:12" />yennes elli nette yeqreb ydaddes welli nette δmemmis n rifqeh. tezzel tennes y daddes. <verse eid="GEN 29:12" /><verse number="13" style="v" sid="GEN 29:13" />max i yesle laban elli yeεquwb memmis n weltmas yuseδ, yezzel bac e θyeεreD. yeγemmerθ ikubbi yewiθ y elHuces. yeHke yeεquwb ylaban elli yejre elkul, <verse eid="GEN 29:13" /><verse number="14" style="v" sid="GEN 29:14" />yennes laban: «mbelHeq, cex seg exsumiyw diδemniyw.» yeqqiym yeεquwb γers eyyuwr.<verse eid="GEN 29:14" /></para>
  <para style="s">enjef n yeεquwb</para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 29:15" />usiyn yennayes laban y yeεquwb: «εlexaTer teqrebδiyδ, eyθexδmeδ blac? enniyδ menyeθ tejernetex.» <verse eid="GEN 29:15" /><verse number="16" style="v" sid="GEN 29:16" />laban kanneθ γers sent ettifrax, temeqqarθ ellesmes leyye utemezyent raHiyl. <verse eid="GEN 29:16" /><verse number="17" style="v" sid="GEN 29:17" />leyye tkan tiTTewines δεefnet, emme raHiyl tkan tebhe egget. <verse eid="GEN 29:17" /><verse number="18" style="v" sid="GEN 29:18" />yexs yeεquwb raHiyl, yennes y laban: «exexδme sebεe sniyn tucδiyδ yelliyx temezyent raHiyl.» <verse eid="GEN 29:18" /><verse number="19" style="v" sid="GEN 29:19" />yennes laban: «etteγeδ cex, xiyr n elγirex. eqqiym iyδi.» <verse eid="GEN 29:19" /><verse number="20" style="v" sid="GEN 29:20" />yexδem yeεquwb sebεe sniyn bac e yeγ raHiyl, kanen δruws εlexaTer ykan yexs raHiyl.<verse eid="GEN 29:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 29:21" />ubeεδ yennes yeεquwb y laban: «sebεe sniyn kmelen uciyδ raHiyl etteγe.» <verse eid="GEN 29:21" /><verse number="22" style="v" sid="GEN 29:22" />ilayem laban leεbaδ n haran elkul y egasen emensi, <verse eid="GEN 29:22" /><verse number="23" style="v" sid="GEN 29:23" />g elmeγreb yuγeδ leyye g elεuwD n raHiyl yuciθ y yeεquwb yaδef essis. <verse eid="GEN 29:23" /><verse number="24" style="v" sid="GEN 29:24" />yuwces laban texeddemtes zilfeh y yelliys leyye bac e θeδwel ettexeddamt γers. <verse eid="GEN 29:24" /><verse number="25" style="v" sid="GEN 29:25" />max i θuwli tefuwθ tay ifaq yeεquwb elli netteθ δleyye, yennes y laban: «δmette wah ittegiyδ δiyye? xδemγex bac e yθuwceδ raHiyl, SHiyH? imette iyθexδεeδ?» <verse eid="GEN 29:25" /><verse number="26" style="v" sid="GEN 29:26" />y er felles laban: «muc g eSSebrenne temezyent aθeγ qebl temeqqarθ. <verse eid="GEN 29:26" /><verse number="27" style="v" sid="GEN 29:27" />kemmel esbuwε n leyye usiyn axneγ raHiyl zade kan texδemdiyδ sebεe sniyn xlaf.» <verse eid="GEN 29:27" /><verse number="28" style="v" sid="GEN 29:28" />yeqbel yeεquwb ykemmel esbuwε n leyye, yuwces laban yelliys raHiyl temeTTuwθ xlaf. <verse eid="GEN 29:28" /><verse number="29" style="v" sid="GEN 29:29" />yuwc laban texeddemtes belheh yyelliys raHiyl bac e θeδwel ettexeddamt γers. <verse eid="GEN 29:29" /><verse number="30" style="v" sid="GEN 29:30" />yaδef yeεquwb s raHiyl zade yexsiθ exθer n leyye. yexδem γer laban sebεe sniyn xlaf.<verse eid="GEN 29:30" /></para>
  <para style="s">idrari n yeεquwb</para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 29:31" />max i yezre rebbi elli leyye temmexreh yerriθ ettaru, emme raHiyl etteruwc. <verse eid="GEN 29:31" /><verse number="32" style="v" sid="GEN 29:32" />taru leyye efruwx tsemmaθ rawbiyn (meεnahe enzi memmi.) εlexaTer tenne: «rebbi yezre eεeniyw, uture eryaziyw δeyyexs.» <verse eid="GEN 29:32" /><verse number="33" style="v" sid="GEN 29:33" />taru efruwx xlaf ten: «εlexaTer rebbi yesle elli nette eyyexsiyc, yuwciyδ wahen xlaf.» tsemmaθ cemεuwn. <verse eid="GEN 29:33" /><verse number="34" style="v" sid="GEN 29:34" />taru efruwx xlaf ten: «ture eryaziyw δeyeδwel yemmeqqen δiyye exθer εlexaTer iruwγes tlaθe δidrari.» heδake εlac tsemmaθ lawiy. <verse eid="GEN 29:34" /><verse number="35" style="v" sid="GEN 29:35" />taru efruwx xlaf ten: «ture δeHemde rebbi.» heδake εlac tsemmaθ yehuwδa, ubeεδ tbeTTel arew.<verse eid="GEN 29:35" /></para>
  <chapter eid="GEN 29" />
  <chapter number="30" style="c" sid="GEN 30" />
  <para style="s">idrari n yeεquwb</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 30:1" />max i θezre raHiyl elli netteθ etteruwc yyeεquwb tenγar seg weltmas ten y yeεquwb: «uciyδ idrari ziyγ ejafe!» <verse eid="GEN 30:1" /><verse number="2" style="v" sid="GEN 30:2" />yeθγeccec yeεquwb f raHiyl yennes: «endre neč uggemxan n rebbi? ennette elli eyged emyuwci idrari.» <verse eid="GEN 30:2" /><verse number="3" style="v" sid="GEN 30:3" />tennes: «tay texeddemtiyw belheh, aδef felles balek eθged eyθaru idrari ege elεiyleθ s γers.» <verse eid="GEN 30:3" /><verse number="4" style="v" sid="GEN 30:4" />tuwces y yeεquwb texeddemtes belheh yaγiθ yaδef essis. <verse eid="GEN 30:4" /><verse number="5" style="v" sid="GEN 30:5" />taru belheh yyeεquwb efruwx. <verse eid="GEN 30:5" /><verse number="6" style="v" sid="GEN 30:6" />elweqθes ten raHiyl: «yeHkem iyδi rebbi, yesl eSSutiyw yuwciyδ efruwx.» heδake εlac tsemmaθ dan. <verse eid="GEN 30:6" /><verse number="7" style="v" sid="GEN 30:7" />taru belheh texeddamt n raHiyl efruwx xlaf y yeεquwb, <verse eid="GEN 30:7" /><verse number="8" style="v" sid="GEN 30:8" />ten raHiyl: «mεarxe dweltme elεerxeθ temeqqarθ eγelbat.» heδake εlac tsemmaθ neftaliy.<verse eid="GEN 30:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 30:9" />max i θezre leyye imenes tbeTTel arew, tuwce texeddemtes zelfeh y yeεquwb bac e tyaγ. <verse eid="GEN 30:9" /><verse number="10" style="v" sid="GEN 30:10" />taru zelfeh texeddamt n leyye efruwx y yeεquwb. <verse eid="GEN 30:10" /><verse number="11" style="v" sid="GEN 30:11" />ten leyye: «ya seεdiy.» tsemmaθ jad. <verse eid="GEN 30:11" /><verse number="12" style="v" sid="GEN 30:12" />taru zelfeh efruwx xlaf y yeεquwb, <verse eid="GEN 30:12" /><verse number="13" style="v" sid="GEN 30:13" />ten leyye: «ya f erHtiy, elwacun elkul δeybarexneθ.» tsemmaθ eciyr.<verse eid="GEN 30:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 30:14" />yeffeγ rawbiyn elweqθ n wamjer n iyrδen yaf elHec yetεawen f warew yeγet y yemmes leyye. tennes raHiyl y leyye: «uciyδ lewse seg elHec elli yuγet memmiym.» <verse eid="GEN 30:14" /><verse number="15" style="v" sid="GEN 30:15" />tennes: «emyezziyc eθewyeδ eryaziyw uθexseδ eθewyeδ elHec n memmi?» ten raHiyl: «emmale, eyenεes yeεquwb γerm iDe, tucδiyδ elHec n memmiym.» <verse eid="GEN 30:15" /><verse number="16" style="v" sid="GEN 30:16" />max i yerjeε yeεquwb seg ejiymi g tisemsiyn teffeγ leyye bac e tteεreD tennes: «aδef felle iDe g elεuwD n elHec n memmi!» eyendeγ yenεes γers iddiyn. <verse eid="GEN 30:16" /><verse number="17" style="v" sid="GEN 30:17" />yesl rebbi eddeεweθ n leyye taru y yeεquwb efruwx δelxames, <verse eid="GEN 30:17" /><verse number="18" style="v" sid="GEN 30:18" />ten leyye: «yxelSiyδ rebbi εlexaTer uciyγ texeddemtiyw y weryaziyw.» tsemmaθ yessaker. <verse eid="GEN 30:18" /><verse number="19" style="v" sid="GEN 30:19" />taru leyye efruwx δessades y yeεquwb, <verse eid="GEN 30:19" /><verse number="20" style="v" sid="GEN 30:20" />ten leyye: «y erzeqiyδ rebbi s elxiyr elkul, ture δeyyeqbel eryaziyw εlexaTer iruwγes sette δidrari.» tsemmaθ zebuwluwn. <verse eid="GEN 30:20" /><verse number="21" style="v" sid="GEN 30:21" />usiyn tiru tefruwxθ tsemmat diyna. <verse eid="GEN 30:21" /><verse number="22" style="v" sid="GEN 30:22" />usiyn yesfekker rebbi raHiyl yerriθ ettaru, <verse eid="GEN 30:22" /><verse number="23" style="v" sid="GEN 30:23" />taru efruwx ten: «rebbi yekkes felle elεeriyw.» <verse eid="GEN 30:23" /><verse number="24" style="v" sid="GEN 30:24" />tsemmaθ yuwsef ten: «balek eyyerni rebbi efruwx xlaf.»<verse eid="GEN 30:24" /></para>
  <para style="s">max i yeδwel yeεquwb δemuγni</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 30:25" />max i θiru raHiyl yuwsef yenne yeεquwb y laban: «edjiyδ exeDme y temurθiyw δelqeεθiyw. <verse eid="GEN 30:25" /><verse number="26" style="v" sid="GEN 30:26" />uciyδ idreriyw delwacuniyw elli xδemγex essisneθ tedjδiyδ exeDme. εlexaTer tesseneδ menyeθ ixexδme.» <verse eid="GEN 30:26" /><verse number="27" style="v" sid="GEN 30:27" />yennes laban: «kan δeθeqebleδ s γeri, eqqiym iyδi. uδmex yebhe felle, utegze elli rebbi ibarex δiyye essix, <verse eid="GEN 30:27" /><verse number="28" style="v" sid="GEN 30:28" />enniyδ menyeθ tejernetex bac e xuwce.» <verse eid="GEN 30:28" /><verse number="29" style="v" sid="GEN 30:29" />yer felles yeεquwb: «cex tesseneδ max i xexδme, umax i yeδwel esεiyx iyδi, <verse eid="GEN 30:29" /><verse number="30" style="v" sid="GEN 30:30" />elli ykan δruws yeδwel egget, ibarex δiyx rebbi beεεeδ eseδiyw. uture lemmi δexeDme y elHuciyw?» <verse eid="GEN 30:30" /><verse number="31" style="v" sid="GEN 30:31" />y en: «δme δexuwce?» yer felles yeεquwb: «eyθuwceδ Hette cey, emme δekemle exesrHe esεiyx kan teqbeleδ s elli δexiθenne: <verse eid="GEN 30:31" /><verse number="32" style="v" sid="GEN 30:32" />edjiyδ asse eθuyuwre g esεiyx elkul, ewye essis imneqqeĎ duzeTTef seg iεellec delmaεez elkul, δeθeδwel tediyn tejernetiyw. <verse eid="GEN 30:32" /><verse number="33" style="v" sid="GEN 30:33" />weječe eθechδeδ elli neč δeSSadeq iyδex, max eθeddaseδ tθebθeδ tejernetiyw, kan tufiyδ icθ muc ettimneqqeĎt ziyγ muc ettezeTTafθ eθkuwn temmaxer γeri.» <verse eid="GEN 30:33" /><verse number="34" style="v" sid="GEN 30:34" />yen laban: «emmax i θenniyδ.» <verse eid="GEN 30:34" /><verse number="35" style="v" sid="GEN 30:35" />esses yefrez laban seg ijeδεan imneqĎen elkul delHiwan timneqĎin elkul. dijeδεen izeTTafen diεellec imellalen yuwcin y idreriys, <verse eid="GEN 30:35" /><verse number="36" style="v" sid="GEN 30:36" />yedj jeres dyeεquwb teyuwriθ n etlaθe eyyam, yeqqiym yeεquwb iserreH g esεi n laban elbaqi.<verse eid="GEN 30:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 30:37" />yawi yeεquwb iqecqac δizizawen n ellebne delluwz deddelb yqeccer δiysen lexTuwT δimellalen. <verse eid="GEN 30:37" /><verse number="38" style="v" sid="GEN 30:38" />yesbeddiyn ezzaθ n esεi max eyebδe yses g leHwaD n wamen <verse eid="GEN 30:38" /><verse number="39" style="v" sid="GEN 30:39" />δwelneθ etteθweHHamneθ f iqecqacdiyn, eruwneθ imneqĎen dimxeTTeTen. <verse eid="GEN 30:39" /><verse number="40" style="v" sid="GEN 30:40" />yefrez yeεquwb tetten iHewwel uδmawen n esεi imxeTTeT duzeTTef elkul n laban, yerri δesεiys ennette. yemHuz f esεi n laban. <verse eid="GEN 30:40" /><verse number="41" style="v" sid="GEN 30:41" />ykan yeεquwb max eyeθweHHem esεi eqewway eyHuT iqecqac imxeTTeTen ezzeθensen g leHwaD bac e yeθweHHem fellasen. <verse eid="GEN 30:41" /><verse number="42" style="v" sid="GEN 30:42" />umax eyebδe esεi Dεiyf elyetHuč ezzeθes iqecqac, usahen δwelneθ tuDεiyfin elkul y laban utiqewwayin elkul y yeεquwb. <verse eid="GEN 30:42" /><verse number="43" style="v" sid="GEN 30:43" />y eδwel sahen δeryaz δemuγni egget, γers esεi egget dixeddamen etxeddamin dileγman diγyal.<verse eid="GEN 30:43" /></para>
  <chapter eid="GEN 30" />
  <chapter number="31" style="c" sid="GEN 31" />
  <para style="s">yeεquwb eyfekker g werwel</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 31:1" />yesl yeεquwb elli idrari n laban eqqaren: «yeεquwb yawi elli γer daddeθne elkul, wahen elkul yegi seg egli n daddeθne.» <verse eid="GEN 31:1" /><verse number="2" style="v" sid="GEN 31:2" />yezre yeεquwb elli elmuεamleθ n laban iyδes teθbeddel f qebl. <verse eid="GEN 31:2" /><verse number="3" style="v" sid="GEN 31:3" />elweqθes yen rebbi yyeεquwb: «erjeε yelqeεεeθ n midnex dleεbeδex uneč iyδex.» <verse eid="GEN 31:3" /><verse number="4" style="v" sid="GEN 31:4" />yezen yeεquwb y raHiyl dleyye bac e seddasneθ y ijiyman meni iyeqqiym s esεiys, <verse eid="GEN 31:4" /><verse number="5" style="v" sid="GEN 31:5" />yennasneθ: «daddexmeθ yembeddel f elli ykan qebl, emme erreb n dadde ykan iyδi. <verse eid="GEN 31:5" /><verse number="6" style="v" sid="GEN 31:6" />uxemmiyθi tessenmeθ elli xδeme daddexmeθ s ejjehδiyw elkul, <verse eid="GEN 31:6" /><verse number="7" style="v" sid="GEN 31:7" />yemenni daddexmeθ yeγδer essi ibeddel tejernetiyw εecre merraθ. emme rebbi eθyedjiyc eyyeg Haje. <verse eid="GEN 31:7" /><verse number="8" style="v" sid="GEN 31:8" />max eyen: &lt;imneqĎen tejernetex.&gt; eδeruwneθ elkul δimneqĎen, ziyγ eyen, &lt;imxeTTeTen tejernetex.&gt; eδeruwneθ elkul δimxeTTeTen. <verse eid="GEN 31:8" /><verse number="9" style="v" sid="GEN 31:9" />yawi rebbi esεi n daddexmeθ yucintiyδ y neč. <verse eid="GEN 31:9" /><verse number="10" style="v" sid="GEN 31:10" />g elweqθ n eTriyδeθ ettirjiyθe ijeδεan lefHuwl elkul δimxeTTeTen udimneqĎen. <verse eid="GEN 31:10" /><verse number="11" style="v" sid="GEN 31:11" />yenniyδ elmlax n rebbi g unuddem: &lt;yeεquwb.&gt; enγes: &lt;enεem.&gt; <verse eid="GEN 31:11" /><verse number="12" style="v" sid="GEN 31:12" />yen: &lt;qam tiTTewinex terqbeδ. ijeδεan elkul δimxeTTeTen dimneqĎen, εlexaTer zriyγ elli yegi δiyx laban elkul. <verse eid="GEN 31:12" /><verse number="13" style="v" sid="GEN 31:13" />neč δerreb n biytiyl meni iθesbeddeδ tγaγet tenγleδ felles uwδi y neč, tuεeddiyδ s elweεδeθ. uture ekker effeγ seg elqeεεeθe teδwleδ y elqeεεeθ meni iθemmarweδ.&gt;» <verse eid="GEN 31:13" /><verse number="14" style="v" sid="GEN 31:14" />erreneθ felles raHiyl dleyye: «endre yeqqimane elbay g etterxeθ n daddeθne? <verse eid="GEN 31:14" /><verse number="15" style="v" sid="GEN 31:15" />exenyeHsiybc ettiberreniyyin γers, yezzenzane yeč essumenne? <verse eid="GEN 31:15" /><verse number="16" style="v" sid="GEN 31:16" />erzi elkul elli yekkesθi rebbi seg daddeθne yuwcin icex δegliynne nečin didreriynne. eg emmax i xyenne rebbi.»<verse eid="GEN 31:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 31:17" />yekker yeεquwb yessin idreriys delwacunes f ileγman, <verse eid="GEN 31:17" /><verse number="18" style="v" sid="GEN 31:18" />ysuq esεiys elkul d elli yemlexθ ylemmeδti g teHmiylt n eram elkul, yexDem yetwali daddes isHaq g elqeεεeθ n kenεan. <verse eid="GEN 31:18" /><verse number="19" style="v" sid="GEN 31:19" />laban ykan yexDem ylessi g tettnes diεelleces, taxer raHiyl leSnam n daddes. <verse eid="GEN 31:19" /><verse number="20" style="v" sid="GEN 31:20" />yexδeε yeεquwb laban elerami wesyenniyc s werweles. <verse eid="GEN 31:20" /><verse number="21" style="v" sid="GEN 31:21" />yerwel s elli γers elkul, yeqĎeε elfuwrat yexDem yeddehreθ n jilεad.<verse eid="GEN 31:21" /></para>
  <para style="s">laban eyexleĎ f yeεquwb</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 31:22" />beεεeδ tlaθe eyyam yesle laban s warwel n yeεquwb, <verse eid="GEN 31:22" /><verse number="23" style="v" sid="GEN 31:23" />yawi ewmeθnes yexDem δefres teyuwriθ n sebεe eyyam eδeyaweδ felles g eddehreθ enjilεad, <verse eid="GEN 31:23" /><verse number="24" style="v" sid="GEN 31:24" />yeseδ rebbi y laban elerami g tirjiyθ g δeggiyδ yennes: «er elbalex esθuθlayeδ y yeεquwb s elxiyr ziyγ s eccer.» <verse eid="GEN 31:24" /><verse number="25" style="v" sid="GEN 31:25" />max i yiweD laban f yeεquwb yafi yenSeb texyemtes g tiwni, yenSeb laban Hette nette dewmeθnes ixyemnensen diyn. <verse eid="GEN 31:25" /><verse number="26" style="v" sid="GEN 31:26" />yen laban y yeεquwb: «δmette wahen ittegiyδ? texδeεδiyδ tsuqqeδ tifrexiyw emmax g elHerb, <verse eid="GEN 31:26" /><verse number="27" style="v" sid="GEN 31:27" />wimette iθerwleδ bejjeHde weyθenniyc kanhake elliyγ ceyyeεγex s tiγraθin eTTebbelt etγeyyeT? <verse eid="GEN 31:27" /><verse number="28" style="v" sid="GEN 31:28" />eyθedjiyc Hette ekubbe tifrexiyw didrarinsneθ, teθSerfeδ beγbawe. <verse eid="GEN 31:28" /><verse number="29" style="v" sid="GEN 31:29" />uture egedde exDurre emme erreb n daddeθwem yuθleyiyδ iDennat δeggiyδ yenniyδ: &lt;er elbalex eθuθlayeδ y yeεquwb s elxiyr ziyγ s eccer.&gt; <verse eid="GEN 31:29" /><verse number="30" style="v" sid="GEN 31:30" />ucex texDemeδ s γeri εlexaTer tesθaHceδ elHuwc n daddex, emme imette iθuxreδ leSnemiyw?» <verse eid="GEN 31:30" /><verse number="31" style="v" sid="GEN 31:31" />yer f elles yeεquwb: «εlexaTer ukkuδe eyeθfukkeδ tifrexex, <verse eid="GEN 31:31" /><verse number="32" style="v" sid="GEN 31:32" />emme leSnemex, iδekan tufiyt δiyjen essiyne yelzem eyjaf. θebbeθ δmette iγerx γeri ezzaθ n ewmeθnenne tewyet.» ture yeεquwb elyessiync elli raHiyl tuxer erreb n laban. <verse eid="GEN 31:32" /><verse number="33" style="v" sid="GEN 31:33" />yaδef laban texyamt n yeεquwb ettexyamt n leyye ettexyamt n tixeddamin lessent, yemenni welyuwfi Hette cey. yeffeγ seg texyamt n leyye yaδef y texyamt n raHiyl. <verse eid="GEN 31:33" /><verse number="34" style="v" sid="GEN 31:34" />raHiyl tkan tiwi leSneb tHuTTiyneθ g eθHawiθ n welγem teqqiym felles. iferkes laban texyamt elkul welyuwfi cey, <verse eid="GEN 31:34" /><verse number="35" style="v" sid="GEN 31:35" />ten raHiyl y daddes: «eθeθγeccec felle y a siydiy, εlexaTer felle eTriyq n weyyuwr welgeddac ekre ezzeθex.» welyufiyc laban leSnemes elli yHewwem fellasneθ. <verse eid="GEN 31:35" /><verse number="36" style="v" sid="GEN 31:36" />yeθγeccec yeεquwb yemεarex dlaban yennes: «mette igiyγ bac e yθeθbεeδ sahen liyhliyh? <verse eid="GEN 31:36" /><verse number="37" style="v" sid="GEN 31:37" />tferkseδ edbeciyw elkul, mette iθuwfiδ seg elbegaj n elHucex? kan tufiyδ Haje HuTTi dahen ezzaθ n ewmeθniyw diryeznex bac e Hekmen binatne. <verse eid="GEN 31:37" /><verse number="38" style="v" sid="GEN 31:38" />γeri εicriyn sne iyδex, la ettetnex δreHneθ ula δelHiwanex, wellečiyγc seg lekbecex <verse eid="GEN 31:38" /><verse number="39" style="v" sid="GEN 31:39" />elli kanneθ elhwayec tetneθ δiys exedduwγiyγ felles Hette elεlameθ, kane etteθHemmale elxsareθ weHδi, ucex tkaneδ etĎelabeδ deyye essisen, yemmaxer g dugges ziyγ g δeggiyδ. <verse eid="GEN 31:39" /><verse number="40" style="v" sid="GEN 31:40" />θečayiyδ esxaneθ g dugges, weSqiyε g δeggiyδ, wenuddem yerwel seg tiTTewiniyw. <verse eid="GEN 31:40" /><verse number="41" style="v" sid="GEN 31:41" />γeri εicriyn sne g elHucex, xδemγex erbeεtac sne bac e yθuwceδ tifrexex lessentiyn usette sniyn bac e yθuwceδ esεiyx, weθbeddeldiyδ tejernetiyw εecre merraθ. <verse eid="GEN 31:41" /><verse number="42" style="v" sid="GEN 31:42" />ulukan muc erreb n dadde, erreb n ibrahiym delxuwf seg isHaq kanen iyδi, rahu telliyδ ture tgellebδiyδ menγiyr eyθuwceδ Hette cey. emme rebbi yerqeb yetteεbiyw decqe n ifesniyw yeεrxax iDennat δeggiyδ.»<verse eid="GEN 31:42" /></para>
  <para style="s">elεaheδ jar yeεquwb dlaban</para>
  <para style="p">
    <verse number="43" style="v" sid="GEN 31:43" />yer felles laban: «tifrax ettifrexiyw widrari δidreriyw wesεi δesεiyw welli tzerreδ δiys elkul δegliyw, w meδemni elgedde ege Hette cey bac e rre tifrexiyw didrarinsneθ elli irwentent? <verse eid="GEN 31:43" /><verse number="44" style="v" sid="GEN 31:44" />est enemεaheδ, neč dcex, enHuT eccaheδ mabinatne.» <verse eid="GEN 31:44" /><verse number="45" style="v" sid="GEN 31:45" />eyendeγ yqam yeεquwb tγaγet yegiθ δezeεnuwn. <verse eid="GEN 31:45" /><verse number="46" style="v" sid="GEN 31:46" />yen y iryeznes: «laymeθ tiγuwγe.» laymen tiγuwγe egentent δelkuδes ečen δenyes. <verse eid="GEN 31:46" /><verse number="47" style="v" sid="GEN 31:47" />ysemmaθ laban yejer sehduwθe, wisemmaθ yeεquwb jelεiyd. (meεnahe elkuδs n eccehδeθ binatne s elluwγeθ n eram delluwγeθ n εibriyye.) <verse eid="GEN 31:47" /><verse number="48" style="v" sid="GEN 31:48" />yen laban: elkuδse δeyeδwel δeccaheδ mabinatne asse.» heδake εlac yemsemme jelεiyd. <verse eid="GEN 31:48" /><verse number="49" style="v" sid="GEN 31:49" />uyemsemme xlaf elmiSfat, εlexaTer laban yenne: «eySafe rebbi mabinatne max enemtegge f beεDne.» <verse eid="GEN 31:49" /><verse number="50" style="v" sid="GEN 31:50" />iδekan tmermδeδ tifrexiyw ziyγ tuγiyδ fellasneθ, exyzer Hette Hed essiyne, emme rebbi δeccaheδ mabinatne. <verse eid="GEN 31:50" /><verse number="51" style="v" sid="GEN 31:51" />yen xlaf: «wahen δelkuδes uwahen δezeεnuwn elli θegit mabinatne <verse eid="GEN 31:51" /><verse number="52" style="v" sid="GEN 31:52" />lessen elkuδs duzeεnuwn δeccuhhaδ bac e tteθεeddiyγc fellex, ucex etteθεeddiyc felle. <verse eid="GEN 31:52" /><verse number="53" style="v" sid="GEN 31:53" />erreb n ibrahiym derreb ennaHuwr eHekmen mabinatne.» yeθjul yeεquwb s elxuwf n daddes isHaq, <verse eid="GEN 31:53" /><verse number="54" style="v" sid="GEN 31:54" />yeγres ecwiyheθ g eddehreθ, inabe y iryeznes ečen enεsen g eddehreθ. <verse eid="GEN 31:54" /><verse number="55" style="v" sid="GEN 31:55" />elweječe bekri ikub laban tifrexes didrarinsneθ ibarexθen yrewweH y elHuces.<verse eid="GEN 31:55" /></para>
  <chapter eid="GEN 31" />
  <chapter number="32" style="c" sid="GEN 32" />
  <para style="s">yeεquwb eyHeDDer y ulaqi n εiysuw</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 32:1" />yexDem yeεquwb uggebriδes leqant elmleyxaθ n rebbi. <verse eid="GEN 32:1" /><verse number="2" style="v" sid="GEN 32:2" />yen yeεquwb max i nyezre: «wahen δeljiyc n rebbi.» eyendeγ ysemme emxandiyn meHenayem.<verse eid="GEN 32:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 32:3" />yezen yeεquwb imersal bac e θesbqen y enjes εiysuw g elqeεεeθ n esεiyr g temuwreθ eduwm,<verse eid="GEN 32:3" /></para>
  <para style="s">yeεquwb eyHeDDer imenes y ulaqi n εiysuw</para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 32:4" />iweSSaθen: «wahen elli δettennem y siydiy εiysuw: exeddemex yeεquwb yeqqar, kane γer laban weqqiyme γers elture. <verse eid="GEN 32:4" /><verse number="5" style="v" sid="GEN 32:5" />uyeδwel γeri ifunasen diγyal desεi dixeddamen etxeddamin. enniyγ exezne δ wiyn exyen, ya siydiy, bac e θerDiyδ felle.» <verse eid="GEN 32:5" /><verse number="6" style="v" sid="GEN 32:6" />max i rejεen imersal y yeεquwb ennanes: «nexDem y enjex εiysuw utay g webriδ δeyeddes bac e xyeεreD wiyδes erbεe myat rajel.» <verse eid="GEN 32:6" /><verse number="7" style="v" sid="GEN 32:7" />yeqleq yeεquwb yukkeδ egget izuwn eljmaεθes elli iyδes desεi difunasen dileγman f sen <verse eid="GEN 32:7" /><verse number="8" style="v" sid="GEN 32:8" />yen g ules: &lt;iδekan εiysuw yehjem f eljmaεeθ temezwarθ, eljmaεeθ teθθaniθ balek eθerwel.&gt; <verse eid="GEN 32:8" /><verse number="9" style="v" sid="GEN 32:9" />yen yeεquwb: «ya rebb n dadde ibrahiym derreb n dadde isHaq, ya rebbi elli tenniδiyδ: eδwel yelqeεθex dmidnex uneč exege elxiyr elkul, <verse eid="GEN 32:9" /><verse number="10" style="v" sid="GEN 32:10" />neč ettesθehilac elxiyr elli θegiδiyθi elkul, eqDeεe esuwf n elurdun welγri kan etteγriθiyw, emme ture yeδwel γeri sent δelferqaθ. <verse eid="GEN 32:10" /><verse number="11" style="v" sid="GEN 32:11" />menεiyδ seg ifassen n enjew εiysuw, neč ettekkaδe eyeddes exenyenγ elkul, neč delwacun didrari, <verse eid="GEN 32:11" /><verse number="12" style="v" sid="GEN 32:12" />ucex tenniδiyδ: &lt;neč δege δiyx elxiyr erre idreriyx emerremleθ n iylel elli etmeHsibc.&gt;»<verse eid="GEN 32:12" /></para>
  <para style="s">elhδiyyeθ n yeεquwb y εiysuw</para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 32:13" />yenεes yeεquwb iddiyn diyn, yexθar seg elli γers elhδiyyeθ y enjes εiysuw: <verse eid="GEN 32:13" /><verse number="14" style="v" sid="GEN 32:14" />miytiyn εenz uεicriyn tiys, miytiyn neεje uεicriyn kebc, <verse eid="GEN 32:14" /><verse number="15" style="v" sid="GEN 32:15" />dtleθiyn nage essesfaneθ didrarinsneθ derbεiyn begle dεecre δifunasen, εicriyn bhime dεecre δiγyal. <verse eid="GEN 32:15" /><verse number="16" style="v" sid="GEN 32:16" />yuwcin y ixeddemnes kul Haje weHδes, yennasen: «uyuwreθ ezzeθiyw tedjem elfDe mabiyn kul ecellag ducellag.» <verse eid="GEN 32:16" /><verse number="17" style="v" sid="GEN 32:17" />yennes y umezwar: «kan yeεreDex enje εiysuw yencδex, &lt;δ wiyn cex, welmani maci, wiwiyn wahen elli ezzeθex?&gt; <verse eid="GEN 32:17" /><verse number="18" style="v" sid="GEN 32:18" />en, &lt;y uxeddemex yeεquwb, utahen δelhδiyyeθ ysiydiy εiysuw, unette biyδe tayeθ δefrenne.&gt;» <verse eid="GEN 32:18" /><verse number="19" style="v" sid="GEN 32:19" />yen yeθθani deθθaleθ delli etsuqqen g icellagen elkul: «enneθ sahen Hette δxenyum max exenyeεreD εiysuw, <verse eid="GEN 32:19" /><verse number="20" style="v" sid="GEN 32:20" />tennem: &lt;tay exeddemex yeεquwb δefrenne zade.&gt;» εlexaTer yenne g ules: «eθerbHe s elhδiyyeθ elli ezzeθiyw, usiyn ereqbe uδmes balek eyyisameH.» <verse eid="GEN 32:20" /><verse number="21" style="v" sid="GEN 32:21" />texDem elhδiyyeθ ezzeθes, emme nette yense iddiyn uggexyam. <verse eid="GEN 32:21" /><verse number="22" style="v" sid="GEN 32:22" />yekker g δeggiyδdiyn yawi elwacunes lessent etxeddemines lessent didreriys leHdac, yeqĎeε esuwf n yebbuwq,<verse eid="GEN 32:22" /></para>
  <para style="s">emεarex n yeεquwb derreb</para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 32:23" />yiwiθen yεeddaθen esuwf delli γers elkul. <verse eid="GEN 32:23" /><verse number="24" style="v" sid="GEN 32:24" />yeqqiym yeεquwb weHδes, yemεarex iyδes eryaz elelfjer. <verse eid="GEN 32:24" /><verse number="25" style="v" sid="GEN 32:25" />max i yezre eryazdiyn elli nette eθyeγliybc, yewwet f elfexδes yemmexleε elmefSel n elfexδes. <verse eid="GEN 32:25" /><verse number="26" style="v" sid="GEN 32:26" />yen yyeεquwb: «seybiyδ elfjer iεellem.» yennes: «exetseybac kan eθbarxeδ δiyye.» <verse eid="GEN 32:26" /><verse number="27" style="v" sid="GEN 32:27" />yennes: «max ellesmex?» yennes: «yeεquwb.» <verse eid="GEN 32:27" /><verse number="28" style="v" sid="GEN 32:28" />yennes: «meεεač ellesmex yeεquwb, emme israYiyl, εlexaTer temεarxeδ drebbi dleεbaδ teγlbetten.» <verse eid="GEN 32:28" /><verse number="29" style="v" sid="GEN 32:29" />yenceδt yeεquwb: «eθegeδ elmziyyeθ enniyδ f ellesmex.» yennes: «imat tnecδeδ f ellesmiyw?» ibarex δiys diyn. <verse eid="GEN 32:29" /><verse number="30" style="v" sid="GEN 32:30" />ysemme yeεquwb emxandiyn f eniYiyl, yen «ezriyγ rebbi uwδem yuwδem, wemneεe.» <verse eid="GEN 32:30" /><verse number="31" style="v" sid="GEN 32:31" />teqqeS tefuwθ max i yeθεedde f eniYiyl unette yetrekkeH seg elfexδes. <verse eid="GEN 32:31" /><verse number="32" style="v" sid="GEN 32:32" />heδake εlac eltettenc bni israYiyl elεerq n ense elli g elmefSel n elfxeδ εlexaTer eryazdiyn yewweθ elmefSel n yeεquwb g elεerq n ense.<verse eid="GEN 32:32" /></para>
  <chapter eid="GEN 32" />
  <chapter number="33" style="c" sid="GEN 33" />
  <para style="s">emlaqi n yeεquwb dεiysuw</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 33:1" />yqam yeεquwb ixfes yezer εiysuw jay wiyδes erbεe myat rajel, izuwn idreriys f leyye draHiyl etxeddamin lessent. <verse eid="GEN 33:1" /><verse number="2" style="v" sid="GEN 33:2" />iHuT tixeddamin didrarinsneθ δimezwaren, usiyn leyye didreriys, usiyn raHiyl dyuwsef δellexren. <verse eid="GEN 33:2" /><verse number="3" style="v" sid="GEN 33:3" />emme nette yesbeqθen yesjeδ f elqeεεeθ sebεe merraθ elδeyeqreb yenjes. <verse eid="GEN 33:3" /><verse number="4" style="v" sid="GEN 33:4" />yezzel εiysuw yeεreDt yeθHemmelt ikubbi. ekkeren tεeyĎen lessen. <verse eid="GEN 33:4" /><verse number="5" style="v" sid="GEN 33:5" />yqam εiysuw tiTTewines yezer elwacun didrari yen: «δ wiyn iyhen?» yer felles yeεquwb: «iyhen δidrari elli yenεem essisen rebbi felle neč elεebδex.» <verse eid="GEN 33:5" /><verse number="6" style="v" sid="GEN 33:6" />elweqθes zewweδneθ tixeddamin didrarinsneθ esejδen. <verse eid="GEN 33:6" /><verse number="7" style="v" sid="GEN 33:7" />usiyn tzewweδ leyye didreriys esejδen usiyn izewweδ yuwsef draHiyl esejδen. <verse eid="GEN 33:7" /><verse number="8" style="v" sid="GEN 33:8" />yen εiysuw yyeεquwb: «δmette iθexseδ eθenneδ s icellagene elli eεrDaθen?» yennes: «bac e θerDiyδ felle ya siydiy.» <verse eid="GEN 33:8" /><verse number="9" style="v" sid="GEN 33:9" />yen εiysuw: «γeri egget eyenje. edj γerx egliyx.» <verse eid="GEN 33:9" /><verse number="10" style="v" sid="GEN 33:10" />yen yeεquwb: «la, kan terDiyδ felle eqbel elhδiyyeθiyw. εlexaTer max i zriyγ uδmex emmax zriyγ uwδem n rebbi terDiyδ felle. <verse eid="GEN 33:10" /><verse number="11" style="v" sid="GEN 33:11" />eqbel s γeri elhδiyyeθiyw elli useδγex essis. rebbi yenεem felle uγeri kul cey.» imelges elδeyeqbel.<verse eid="GEN 33:11" /></para>
  <para style="s">efareq n yeεquwb dεiysuw</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 33:12" />yen εiysuw: «edj enerHel jmiyε, tay δeθuyuwre ezzeθex.» <verse eid="GEN 33:12" /><verse number="13" style="v" sid="GEN 33:13" />yer felles yeεquwb: «ya, siydiy tesseneδ elli idrari Dεefen, wesεi difunasen essesfan, kan esseεyiyxθen s teyuwriθ Hette as berk δejafen elkul. <verse eid="GEN 33:13" /><verse number="14" style="v" sid="GEN 33:14" />esbqiyδ ya siydiy, uneč δexeθbεe f teyuwriθ n esεi elli tsuqqe δiys etteyuwriθ n idrari, elδeθewDe fellex g esεiyr.» <verse eid="GEN 33:14" /><verse number="15" style="v" sid="GEN 33:15" />yennes εiysuw: «emmale δedje iyδex qiqqi n iryazen elli iyδi.» yen yeεquwb: «imette? eθerDiyδ felle yezzi.» <verse eid="GEN 33:15" /><verse number="16" style="v" sid="GEN 33:16" />esses yeδwel εiysuw y sεiyr. <verse eid="GEN 33:16" /><verse number="17" style="v" sid="GEN 33:17" />yerHel yeεquwb y sekkuwt, yebne elHuwc y imenes, yeg tigriycin yesεi. heδake εlac yemsemme emxandiyn sekkuwt.<verse eid="GEN 33:17" /></para>
  <para style="s">aweD n yeεquwb y eckiym</para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 33:18" />max i yedduwse seg teHmiylt n eram, yiweD yeεquwb labas y temuwreθ n eckiym elli g elqeεεeθ n kenεan. yenSeb tixyemines elberre n temuwreθ. <verse eid="GEN 33:18" /><verse number="19" style="v" sid="GEN 33:19" />yeseγ elqeεεeθ elli yenSeb δiys s emyat qeTεe n elfeTTeθ s γer idrari n eHmuwr daddes n eckiym. <verse eid="GEN 33:19" /><verse number="20" style="v" sid="GEN 33:20" />yeg diyn elmeδbeH ysemmaθ iyl, erreb n israYiyl. (meεnahe erreb n yeεquwb.)<verse eid="GEN 33:20" /></para>
  <chapter eid="GEN 33" />
  <chapter number="34" style="c" sid="GEN 34" />
  <para style="s">esθefεel g diyna</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 34:1" />as iyjen, teffeγ diyna yelliys n yeεquwb seg leyye bac e θerqeb elwacun n elqeεεetdiyn, <verse eid="GEN 34:1" /><verse number="2" style="v" sid="GEN 34:2" />yezriθ ckiym memmis n Hamuwr elHiwiy, elHakem n temuwretdiyn, yewit yesθefεel essis, ywessext. <verse eid="GEN 34:2" /><verse number="3" style="v" sid="GEN 34:3" />yeδwel yexsiθ uyebhe iyδes. <verse eid="GEN 34:3" /><verse number="4" style="v" sid="GEN 34:4" />yen y daddes Hamuwr: «eγiyδ tefruwxθe.» <verse eid="GEN 34:4" /><verse number="5" style="v" sid="GEN 34:5" />yesl essis yeεquwb elli nette iwessex yelliys, yemenni yesger elδeddasen idreriys elli kanen serHen g esεi g ujiymi.<verse eid="GEN 34:5" /></para>
  <para style="s">enaseb n ebni ckiym</para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 34:6" />yeffeγ Hamuwr daddes n eckiym bac e yuθley y yeεquwb. <verse eid="GEN 34:6" /><verse number="7" style="v" sid="GEN 34:7" />idrari n yeεquwb kanen mrewHiyn seg ijiyman y axi sliyn s elli ySar. eθγececen egget εlexaTer ckiym yege elHajeθ tuwHec egget g israYiyl y weltmensen, elHajeθ mayelzemc etemmeg. <verse eid="GEN 34:7" /><verse number="8" style="v" sid="GEN 34:8" />yennasen Hamuwr: «memmi ckiym yexs yelliθwem, egeθ elmziyyeθ ucmast, <verse eid="GEN 34:8" /><verse number="9" style="v" sid="GEN 34:9" />nesebmane, enaγ tifrexennum taγem tifrexenne, <verse eid="GEN 34:9" /><verse number="10" style="v" sid="GEN 34:10" />teεmrem iyδne. tay elqeεεeθ ezzeθennum eεmreθ ettajrem temlxem δiys.» <verse eid="GEN 34:10" /><verse number="11" style="v" sid="GEN 34:11" />yen ckiym y daddes n diyna demmeθnes: «eqebleθ essi welli etteDelbem exenyθuwce, <verse eid="GEN 34:11" /><verse number="12" style="v" sid="GEN 34:12" />ecerĎeθ felle emmax i θexsem γiyr ucmiyδ yelliθwem.» <verse eid="GEN 34:12" /><verse number="13" style="v" sid="GEN 34:13" />erren idrari n yeεquwb f eckiym ddaddes Hamuwr bexbaθe εlexaTer ckiym iwessex weltmansen diyna. <verse eid="GEN 34:13" /><verse number="14" style="v" sid="GEN 34:14" />ennasen: «engeddec enuc weltmaθne y weryaz muc δimdehher, δ elεar γenne, <verse eid="GEN 34:14" /><verse number="15" style="v" sid="GEN 34:15" />enqebbel kan eθeδewlem emnečin, eθĎehrem leδxurennum elkul, <verse eid="GEN 34:15" /><verse number="16" style="v" sid="GEN 34:16" />usahen exennuc tifrexenne nawi tifrexennum neεmer iyδwem neδwel ecceεb iyjen. <verse eid="GEN 34:16" /><verse number="17" style="v" sid="GEN 34:17" />yemenni iδekan eltesliymc edwinne eθĎehrem enawi yelliθne nexDem.»<verse eid="GEN 34:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 34:18" />yeεjeb edwiynsen Hamuwr dmemmis ckiym. <verse eid="GEN 34:18" /><verse number="19" style="v" sid="GEN 34:19" />yeg elli eDelbent liyhliyh εlexaTer ykan yexs egget yelliys n yeεquwb, w ykan exθer waHed δemqedder seg elεiltes. <verse eid="GEN 34:19" /><verse number="20" style="v" sid="GEN 34:20" />max i δuwδfen Hamuwr dmemmis ckiym elbab n temurθensen ennen ymidnensen: <verse eid="GEN 34:20" /><verse number="21" style="v" sid="GEN 34:21" />«leεbaδe δeSSuHHabenne, edj eεemren g elqeεεeθe, exeδmen δiys, elqeεεeθ tuseε egget Hette y nihnin. edj enaγ tifrexensen neγasen tifrexenne. <verse eid="GEN 34:21" /><verse number="22" style="v" sid="GEN 34:22" />emme etwefaqen bac e εemren iyδne neδwel ecceεb iyjen kan max eyemĎehher kul edxer essiyne emnihnin. <verse eid="GEN 34:22" /><verse number="23" style="v" sid="GEN 34:23" />usahen esεiynsen delli γersen elkul eyeδwel δegliynne, γiyr eneqbel nečin eεemren iyδne.» <verse eid="GEN 34:23" /><verse number="24" style="v" sid="GEN 34:24" />eslen leεbaδ n temuwreθ elkul edwi n Hamuwr dmemmis ckiym, Ďehren leδxurensen elkul. <verse eid="GEN 34:24" /><verse number="25" style="v" sid="GEN 34:25" />beεεeδ tlaθe eyyam, elweqθelli kanen elkulhum etteθwejjaεen, qamen emmaθen n diyna lessen, cemεuwn dlawiy, lesyufensen eδfen y temuwreθ s tiT ettuSHiyHθ enγen leδxuwr elkul, <verse eid="GEN 34:25" /><verse number="26" style="v" sid="GEN 34:26" />enγen Hamuwr dmemmis ckiym, ewyen diyna seg elHuwc n eckiym efγen. <verse eid="GEN 34:26" /><verse number="27" style="v" sid="GEN 34:27" />usiyn uδefen idrari n yeεquwb f inemmitte ewyen elli g temuwreθ elkul enteqmen y uwessex n weltmansen, <verse eid="GEN 34:27" /><verse number="28" style="v" sid="GEN 34:28" />ewinasen esεiynsen difunesnensen diγyelensen delli g temuwreθ dijiyman elkul. <verse eid="GEN 34:28" /><verse number="29" style="v" sid="GEN 34:29" />ewinasen leflusensen elkul delwacunensen didreriynsen elkul delli γersen g leHwecensen elkul. <verse eid="GEN 34:29" /><verse number="30" style="v" sid="GEN 34:30" />yen yeεquwb y cemεuwn dlawiy: «tuγeδmiyδ elmcakel, ture ikenεaniyyen diferziyyen dleεbaδ n elqeεεeθ elkul δexennekrhen. γeri δruws iryazen lukan emlaymen ehjmen felle, elεiltiyw elkul etemmehlex.» <verse eid="GEN 34:30" /><verse number="31" style="v" sid="GEN 34:31" />erren felles: «texset eyεamel weltmaθne emtezzaniθ?»<verse eid="GEN 34:31" /></para>
  <chapter eid="GEN 34" />
  <chapter number="35" style="c" sid="GEN 35" />
  <para style="s">yeεquwb g biytiyl</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 35:1" />yen rebbi yyeεquwb: «ekker ali ibiytiyl teεmreδ diyn, tebniyδ diyn elmeδbeH y rebbi elli yeffeγex max i θerwleδ seg uwδem n enjex εiysuw.» <verse eid="GEN 35:1" /><verse number="2" style="v" sid="GEN 35:2" />yen yeεquwb y midnes delli iyδes elkul: «lewHeθ leSneb elli γerwem elkul tneĎfem imenennum tbedlem edbecennum. <verse eid="GEN 35:2" /><verse number="3" style="v" sid="GEN 35:3" />tekrem enali ibiytiyl, diyn δebniyγ elmeδbeH y rebbi elli yεawniyδ as elli HSele, w ykan iyδi uggebriδ elli uyuwre δiys.» <verse eid="GEN 35:3" /><verse number="4" style="v" sid="GEN 35:4" />ucnes y yeεquwb leSneb tiγriybin elli g ifesnensen etbelluwTin elli g timedjinensen, yerδemθent yeεquwb seddu eccejreθ n eSnuwber elli g eckiym. <verse eid="GEN 35:4" /><verse number="5" style="v" sid="GEN 35:5" />erHlen, isuggez rebbi elxuwf s γers f timuwre elli enneDneθ fellasen elkul, usahen enyeθbiyε Hette Hed. <verse eid="GEN 35:5" /><verse number="6" style="v" sid="GEN 35:6" />yeseδ yeεquwb dleεbaδ elli iyδes elkul y luwz, elli esmiθes biytiyl, g elqeεεeθ n kenεan. <verse eid="GEN 35:6" /><verse number="7" style="v" sid="GEN 35:7" />yebne diyn elmeδbeH ysemme emxandiyn iyl biytiyl εlexaTer rebbi yeffeγes diyn max i yerwel seg enjes. <verse eid="GEN 35:7" /><verse number="8" style="v" sid="GEN 35:8" />eθjaf debbuwre θehelli tessesfe irifqeh erδment seddu eccejreθ n eSnuwber seddu biytiyl, yemsemme emxandiyn eluwn bakuwt meεnahe eSnuwber n uεeyyeĎ.<verse eid="GEN 35:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 35:9" />usahen yeffeγ rebbi y yeεquwb elmerreθ xlaf max i yedduwse seg teHmiylt n eram ibarex δiys. <verse eid="GEN 35:9" /><verse number="10" style="v" sid="GEN 35:10" />yennes rebbi: «ellesmex yeεquwb, seg ture meεεač eθemsemmiyδ yeεquwb, δeθemsemmiyδ israYiyl.» eyendeγ ysemmaθ israYiyl. <verse eid="GEN 35:10" /><verse number="11" style="v" sid="GEN 35:11" />yennes rebbi: «neč δerreb elqader. aru texθreδ. θemuwreθ ettimuwre egget δeffeγneθ essix, lemluwk δefγen essix, <verse eid="GEN 35:11" /><verse number="12" style="v" sid="GEN 35:12" />elqeεεeθ elli uciyγet y ibrahiym disHaq δettuwce icex didreriyx beεδex.» <verse eid="GEN 35:12" /><verse number="13" style="v" sid="GEN 35:13" />y ali rebbi seg emxan elli yuθlayes δiys. <verse eid="GEN 35:13" /><verse number="14" style="v" sid="GEN 35:14" />yeg yeεquwb ezeεnuwn n elkurδ diyn, yenγel felles ecrab duwδi y rebbi. <verse eid="GEN 35:14" /><verse number="15" style="v" sid="GEN 35:15" />y semme emxandiyn elli yuθlayes δiys rebbi biytiyl.<verse eid="GEN 35:15" /></para>
  <para style="s">arew n benyamiyn ettemettent n raHiyl</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 35:16" />erHlen seg biytiyl. nihnin elluciyn bεeδen f efrat tebδe raHiyl ettaru yuεer felles arew. <verse eid="GEN 35:16" /><verse number="17" style="v" sid="GEN 35:17" />max i yuεar felles arew tennayes θehelli tessaru δiys: «eθukδec, wahen δefruwx xlaf.» <verse eid="GEN 35:17" /><verse number="18" style="v" sid="GEN 35:18" />qebl eθali erruHes tsemmaθ raHiyl ben uwniy (meεnahe memmis n weHzeniyw). yemenni daddes ysemmaθ benyamiyn. <verse eid="GEN 35:18" /><verse number="19" style="v" sid="GEN 35:19" />eθjaf raHiyl erδment uggebriδ n efrat elli netteθ dbiytleHm. <verse eid="GEN 35:19" /><verse number="20" style="v" sid="GEN 35:20" />yeg yeεquwb ezeεnuwn f weniles, yeqqiym elture δezeεnuwn n wenil n raHiyl. <verse eid="GEN 35:20" /><verse number="21" style="v" sid="GEN 35:21" />yerHel yeεquwb esyiyn yenSeb texyemtes g teme tissent n mejdel n εidr. <verse eid="GEN 35:21" /><verse number="22" style="v" sid="GEN 35:22" />elweqθelli nette iεemmer g elqeεεetdiyn yexDem rawbiyn yenεes dbelheh, texeddamt elli yuγit daddes, yesl essis yeεquwb yeθγeccec felles egget. idrari n yeεquwb kanen eθnac: <verse eid="GEN 35:22" /><verse number="23" style="v" sid="GEN 35:23" />idrari n leyye: rawbiyn, emenzu n yeεquwb dcemεuwn dlawi dyehuwδa dyessaker dzebuwluwn, <verse eid="GEN 35:23" /><verse number="24" style="v" sid="GEN 35:24" />widrari n raHiyl: yuwsef dbenyamiyn, <verse eid="GEN 35:24" /><verse number="25" style="v" sid="GEN 35:25" />widrari n belheh texeddamt n raHiyl: dan dneftaliy, <verse eid="GEN 35:25" /><verse number="26" style="v" sid="GEN 35:26" />widrari n zelfeh texeddamt n leyye: jad daciyr. iyhen kanen idrari n yeεquwb elli emmeruwnes g teHmiylt n eram.<verse eid="GEN 35:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 35:27" />yeseδ yeεquwb y daddes isHaq g memra y etwali qeryeθ erbεe elli netteθ δHebruwn meni iεemren ibrahiym disHaq. <verse eid="GEN 35:27" /><verse number="28" style="v" sid="GEN 35:28" />isHaq ykan elεemres miyye uθmenyiyn sne. <verse eid="GEN 35:28" /><verse number="29" style="v" sid="GEN 35:29" />tali erruwH n isHaq yjaf δewesser δimeθhenni yeweD f midnes, erδment idreriys εiysuw dyeεquwb.<verse eid="GEN 35:29" /></para>
  <chapter eid="GEN 35" />
  <chapter number="36" style="c" sid="GEN 36" />
  <para style="s">idrari n εiysuw</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 36:1" />iyh idrari n εiysuw, elli eqqernes zade eduwm: <verse eid="GEN 36:1" /><verse number="2" style="v" sid="GEN 36:2" />yiwi εiysuw lwecunes seg yessis n kenεan: εedeh yelliys n Yiyluwn eHeθθi, dYehuwliybameh yelliys n Sebεuwn elHiwiy, <verse eid="GEN 36:2" /><verse number="3" style="v" sid="GEN 36:3" />dbesme yelliys n Yismaεiyl weltmes n nebayuwt. <verse eid="GEN 36:3" /><verse number="4" style="v" sid="GEN 36:4" />θaru εedeh eliyfaz, ubesme θiru reεuwYiyl, <verse eid="GEN 36:4" /><verse number="5" style="v" sid="GEN 36:5" />θaru ehuwliybameh yeεuwc dyeεlam dquwreε. iyh emmerwen y εiysuw g elqeεεeθ n kenεan. <verse eid="GEN 36:5" /><verse number="6" style="v" sid="GEN 36:6" />welbeεεeδ yiwi εiysuw lwecunes didreriys dyessis delli g elHuces elkul desseεyes diγyeles delli yesγi elkul seg lqeεεeθ n kenεan, yebεeδ f yeεquwb yerHel yelqeεεeθ xlaf. <verse eid="GEN 36:6" /><verse number="7" style="v" sid="GEN 36:7" />εlexaTer lqeεεeθ elli kanen εemren δiys jmiyε, θkan teDyeq f ellasen seg lkeθreθ n esεi elli δiys. <verse eid="GEN 36:7" /><verse number="8" style="v" sid="GEN 36:8" />yeεmer εiysuw g eddehreθ n esεiyr. <verse eid="GEN 36:8" /><verse number="9" style="v" sid="GEN 36:9" />wiyh idrari n εiysuw g eddehreθ n esεiyr: <verse eid="GEN 36:9" /><verse number="10" style="v" sid="GEN 36:10" />elfaz emmiys n εedeh, dreεuwYiyl emmiys n besme. <verse eid="GEN 36:10" /><verse number="11" style="v" sid="GEN 36:11" />ukanen idrari n elfaz: tiyman dYewmar dSefwe djeεθam dεenaz <verse eid="GEN 36:11" /><verse number="12" style="v" sid="GEN 36:12" />dεemaliyq elli θirwesθi timnaε θexeddemtes. <verse eid="GEN 36:12" /><verse number="13" style="v" sid="GEN 36:13" />wiyh idrari n reεuwYiyl: neHθ dzareH dcemme dmizze. <verse eid="GEN 36:13" /><verse number="14" style="v" sid="GEN 36:14" />iyh idrari n Yehuwliybameh yelliys n εeneh yelliys n Sibεuwn liwec n εiysuw: yeεuwc dyeεlam dquwreH. <verse eid="GEN 36:14" /><verse number="15" style="v" sid="GEN 36:15" />wiyh lHukkam seg bni εiysuw: idrari n Yelfaz emenzu n εiysuw: tiyman dYuwmar dSefw dqenaz <verse eid="GEN 36:15" /><verse number="16" style="v" sid="GEN 36:16" />dquwreH djeεθam dεemaliyq. iyh idrari n εedeh liwec n εiysuw <verse eid="GEN 36:16" /><verse number="17" style="v" sid="GEN 36:17" />wiyh seg reεuwYiyl seg εiysuw: neHθ dzareH dcimme dmizze. iyh idrari n besme liwec n εiysuw. <verse eid="GEN 36:17" /><verse number="18" style="v" sid="GEN 36:18" />wiyh idrari n Yehuwliybameh yelliys n εeneh liwec n εiysuw: yeεuwc dyeεlam dquwreH. <verse eid="GEN 36:18" /><verse number="19" style="v" sid="GEN 36:19" />iyh elHukkam n ebni εiysuw, esmiθes zade eduwm. <verse eid="GEN 36:19" /><verse number="20" style="v" sid="GEN 36:20" />iyh elHukkam n ebni sεiyr elHuwri g elqeεεeθ n eduwm: luwTan dcuwbal dSibεuwn dεeneh <verse eid="GEN 36:20" /><verse number="21" style="v" sid="GEN 36:21" />ddiycuwn dYiySer ddiycan. <verse eid="GEN 36:21" /><verse number="22" style="v" sid="GEN 36:22" />widrari n luwTan: Huwri dheymam. weθkan timnaε dweltmes n luwTan. <verse eid="GEN 36:22" /><verse number="23" style="v" sid="GEN 36:23" />yih idrari n cuwbal: εelwan dmenaHeh dεiybal dcefuw dYuwnam. <verse eid="GEN 36:23" /><verse number="24" style="v" sid="GEN 36:24" />uyih idrari n Sibεuwn: eyyeh dεenne. εenne wah elli yufe amen Hman g eSSeHreθ unette yesreH s esεi n deddes Sibεuwn. <verse eid="GEN 36:24" /><verse number="25" style="v" sid="GEN 36:25" />yah emmiys n εeneh: diycuwn. uYehuwliybameh netteθ yelliys n εeneh. <verse eid="GEN 36:25" /><verse number="26" style="v" sid="GEN 36:26" />wiyh idrari n diycan: Himdan decban dyeθran dkeran. <verse eid="GEN 36:26" /><verse number="27" style="v" sid="GEN 36:27" />iyh idrari n YiySer: belhan dzeεwan dεeqqan. <verse eid="GEN 36:27" /><verse number="28" style="v" sid="GEN 36:28" />iyh idrari n diycan: εuwS dYeran. <verse eid="GEN 36:28" /><verse number="29" style="v" sid="GEN 36:29" />iyh lHukkam n iHuwriyyen g elqeεεeθ n esεiyr: luwTan dcuwbal dSibεuwn dεeneh <verse eid="GEN 36:29" /><verse number="30" style="v" sid="GEN 36:30" />ddiycuwn dYiySer ddiycan. iyh lHukkam n iHuwriyyen g elqeεεeθ n esεiyr. <verse eid="GEN 36:30" /><verse number="31" style="v" sid="GEN 36:31" />iyh lemluwk elli mlexen g elqeεεeθ n eduwm, qebl n elli eδuwlen dlemluwx g ebni YisraYiyl: <verse eid="GEN 36:31" /><verse number="32" style="v" sid="GEN 36:32" />baleε emmiys n beεuwr wellesm n temurθes denhabe. <verse eid="GEN 36:32" /><verse number="33" style="v" sid="GEN 36:33" />yemmuwθ baleε. yeTTef emxenes yuwbab ben zareH seg buSre. <verse eid="GEN 36:33" /><verse number="34" style="v" sid="GEN 36:34" />yemmuwθ yuwbab, yeTTef emxenes Huwcam g elqeεεeθ n ettiymaniy. <verse eid="GEN 36:34" /><verse number="35" style="v" sid="GEN 36:35" />yemmuwθ Huwcam, yeTTef emxenes hedad ben bedad elli yeγleb imedyeniyyen g elqeεεeθ n muYab, wellesm n temurθes εwiyt. <verse eid="GEN 36:35" /><verse number="36" style="v" sid="GEN 36:36" />yemmuwθ hedad, yeTTef emxenes selme ben mesriyqe. <verse eid="GEN 36:36" /><verse number="37" style="v" sid="GEN 36:37" />yemmuwθ selme, yeTTef emxenes cawul seg reHuwbuwt f esuwf. <verse eid="GEN 36:37" /><verse number="38" style="v" sid="GEN 36:38" />yemmuwθ cawul, yeTTef emxenes beεl Hanan ben εekbuwr. <verse eid="GEN 36:38" /><verse number="39" style="v" sid="GEN 36:39" />yemmuwθ Hanan ben εekbuwr yeTTef emxenes hedad, wellesm n temurθes faεuw, wellesm n liweces mehyTebiYiyl yelliys n meTred yelliysnmiyzehebe. <verse eid="GEN 36:39" /><verse number="40" style="v" sid="GEN 36:40" />wiyh ellisami n elHukkam n ebni εiysuw: s elqbeylensen etmurensen: timnaε dεelwe dyetiyt <verse eid="GEN 36:40" /><verse number="41" style="v" sid="GEN 36:41" />dYehuwliybameh dYiyle dfiynuwn <verse eid="GEN 36:41" /><verse number="42" style="v" sid="GEN 36:42" />dqenaz dtiyman dmibSar. <verse eid="GEN 36:42" /><verse number="43" style="v" sid="GEN 36:43" />dmejdeYiyl dεiyram. iyh lHukkam n eduwm, meεnahe εiysuw deddas n iYeduwmiyyen, s leHwecensen g elqeεεeθ n elmelxensen.<verse eid="GEN 36:43" /></para>
  <chapter eid="GEN 36" />
  <chapter number="37" style="c" sid="GEN 37" />
  <para style="s">yuwsef dewmeθnes</para>
  <para style="p">yelle eryaz esmiθes yeεquwb. yuwγeδ engluws ysemmaθi yuwsef.</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 37:1" />yeεmer yeεquwb g elqeεεeθ n kenεan, meni iyeεmer daddes. <verse eid="GEN 37:1" /><verse number="2" style="v" sid="GEN 37:2" />utah elHkayeθ n elεiyleθ n yeεquwb. ykan yuwsef δeεezri elεemres sebeεtac n εam ykan iserreH esεi dyeθmes idrari n belheh dzelfeh elwacun n daddes. iHerrec yuwsef f eyeθmes y daddes f elli tegen δiys. <verse eid="GEN 37:2" /><verse number="3" style="v" sid="GEN 37:3" />ykan yeεquwb yexs yuwsef exθer n idreriys iddiyn εlexaTer yuwγeδti g elkebres, yegayes ekebbuwĎ δimzeyyen. <verse eid="GEN 37:3" /><verse number="4" style="v" sid="GEN 37:4" />max i zriyn eyeθmes elli daddensen yexsi exθrensen elkul eδwlen eθγisenc ernin dukken felles s edwi yuwHec.<verse eid="GEN 37:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 37:5" />yezre yuwsef as iyjen tirjiyθ δeggiyδ yeHkat f eyeθmes, eδwlen eθγisenc exθer n eqbel. <verse eid="GEN 37:5" /><verse number="6" style="v" sid="GEN 37:6" />yenneyasen: «esleθ θahen tirjiyθ elli ezriyxt, <verse eid="GEN 37:6" /><verse number="7" style="v" sid="GEN 37:7" />ezriyγ emelli n teqqen g tixniyqin g ujiymi. tay eθbed elxenqθiyw, enneDneθ felles elxenqeθewwem welbeεδ erkeεentes.» <verse eid="GEN 37:7" /><verse number="8" style="v" sid="GEN 37:8" />ennanes eyeθmes: «etterriyδ imenex δexentemlxeδ uδeθeHkmeδ δiyne.» seg tirjiyθines dedwiys ernin eθγisenc exθer n eqbel. <verse eid="GEN 37:8" /><verse number="9" style="v" sid="GEN 37:9" />yettirjiyθ tirjiyθ xlaf yeHkat f eyeθmes yenne: «ezriyγ tirjiyθ xlaf, emelli tefuwθ etteziyri deHdac δiθran erkeεniyδ.» <verse eid="GEN 37:9" /><verse number="10" style="v" sid="GEN 37:10" />max i tyeHke f daddes dyeθmes yeθγeccec felles daddes yennayes: «δmat tirjiyθe θahen elli tezriyδ! δednes neč dyemmex deyeθmex δexnerkeε g elqeεεeθ?» <verse eid="GEN 37:10" /><verse number="11" style="v" sid="GEN 37:11" />enγaren essis eyeθmes yemenni daddes yeHrez edwiye g ules.<verse eid="GEN 37:11" /></para>
  <para style="s">yuwsef eθezzenzen ewmeθnes</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 37:12" />emreqen eyeθmes serHen g esεi n daddensen ezzaθ ckiym. <verse eid="GEN 37:12" /><verse number="13" style="v" sid="GEN 37:13" />yenne yeεquwb y yuwsef: «eyeθmex serHen g esεi g eckiym. est exazne etwelinsen.» yerrayes yenne: «wa, δemerqe.» <verse eid="GEN 37:13" /><verse number="14" style="v" sid="GEN 37:14" />yennayes yeεquwb: «emreq tenziyδ eyeθmex desεi welbeεδ eδwel θendiyδ mat leHwelensen.» yemreq seg wesuwf Hebruwn, elmi iyiweD yeckiym. <verse eid="GEN 37:14" /><verse number="15" style="v" sid="GEN 37:15" />yeεreDti eryaz yuwfi δerrayeH g essewweθ. yenceδti: «f mat itHewmeδ?» <verse eid="GEN 37:15" /><verse number="16" style="v" sid="GEN 37:16" />yerrayes: «etHewme f eyeθme. eθegeδ elmziyyeθ, enniyδ meni yserHen g esεiynsen.» <verse eid="GEN 37:16" /><verse number="17" style="v" sid="GEN 37:17" />yennayes eryaz: «rahu emreqen esyah. esliyxθen eqqaren, &lt;eyye, enemreq yduwθan.&gt;» εaδ yemreq yuwsef δeffer eyeθmes elmi intyuwfe. <verse eid="GEN 37:17" /><verse number="18" style="v" sid="GEN 37:18" />eddebelli zrinti s lebεiyδ weqbel esenyaweδ, emfahmen felles δeθenγen. <verse eid="GEN 37:18" /><verse number="19" style="v" sid="GEN 37:19" />ennan jerasen: «taye iθbab n tirjiyθin yuseδ. <verse eid="GEN 37:19" /><verse number="20" style="v" sid="GEN 37:20" />eyye eθnenγ eθenĎeyyec g wanu. usinc enen &lt;θeči elhayceθ yuwsef.&gt;, usinc enenzi δmat δesegneθ tirjiyθines.»<verse eid="GEN 37:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 37:21" />max i yesle ruwban edwiynsen yekker δeθimenneε s ifesnensen yenne: «ettenγemc <verse eid="GEN 37:21" /><verse number="22" style="v" sid="GEN 37:22" />bac wetwesxemc ifesnenne s iδemnes yemenni lewHemti g wenuwye g essewweθ.» yenne ruwban sah bac eθisemneε seg ifesnensen usinc eθyer y daddes. <verse eid="GEN 37:22" /><verse number="23" style="v" sid="GEN 37:23" />max i yiweD yuwsef y eyeθmes, ekkesnes ekebbuĎes imzeyyen elli yireDti. <verse eid="GEN 37:23" /><verse number="24" style="v" sid="GEN 37:24" />iwyenti δeycenti g wanu. anu ykan δelfareγ seg wamen.<verse eid="GEN 37:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 37:25" />welbeεεeδ nihnin tetten, qamen ixfewnensen, zriyn elqafleθ n ismaεiyliyyen lebεiyδ tuseδ seg jilεad g webriδes y miSr wileγmenensen εebben s elfeH duwδi dlaδen. <verse eid="GEN 37:25" /><verse number="26" style="v" sid="GEN 37:26" />yenne yehuwδa y eyeθmes: «imat enenγ yuwweθne usinc eneqqiym enHerrez g iδemnes? <verse eid="GEN 37:26" /><verse number="27" style="v" sid="GEN 37:27" />eyye, eθnezzenz y ismaεiyliyyen unetwessexc ifesnenne s iδemnes εlexaTer nette δyuwweθne useg iδemnenne.» elweqθes sliyn eyeθmes edwiys. <verse eid="GEN 37:27" /><verse number="28" style="v" sid="GEN 37:28" />max i qerben essisen ibeyyaεen imedyaniyyen wesmiθensen zade ismaεiyliyyen, sulyen yuwsef seg wanu welbeεδ zenzenti seg εicriyn δelfeTTeθ ewyenti ymiSr.<verse eid="GEN 37:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 37:29" />max i yeδwel ruwban y wanu yemenni elyufiyc yuwsef g wanu. icerrex edbeces. <verse eid="GEN 37:29" /><verse number="30" style="v" sid="GEN 37:30" />yeδwel y eyeθmes yenneyasen: «engluws eHebbec. uneč ture elmani δemerqe umax δeqable dadde?» <verse eid="GEN 37:30" /><verse number="31" style="v" sid="GEN 37:31" />qamen ekebbuwĎ n yuwsef, eγersen iyγiδ egen sah γeTsen ekebbuwĎ g iδammen. <verse eid="GEN 37:31" /><verse number="32" style="v" sid="GEN 37:32" />iwyenti y daddensen ennanes: «rahu n ufaθ ekebbuwĎe. enzi δegli n memmiyx uneγ ehhe?» <verse eid="GEN 37:32" /><verse number="33" style="v" sid="GEN 37:33" />yuxezθi yeεquwb yen: «wah δekebbuwĎ n memmi. elhayceθ θeči. θebbiyθi δleδraf.» <verse eid="GEN 37:33" /><verse number="34" style="v" sid="GEN 37:34" />icerrex edbeces, welbeεδ yireD ezeTTaf f lejnebes, ikezzem f memmis liyyameθ egget. <verse eid="GEN 37:34" /><verse number="35" style="v" sid="GEN 37:35" />max i kren idreriys elkul δeθεezzen, elyeqqiylc eyεezze yen: «δemerqe ymemmi y elli emmuwθen etεeyĎeγ f memmi.» yerw felles yeεquwb.<verse eid="GEN 37:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 37:36" />g ellexxer zenzen ibeyyaεen yuwsef g miSr y fuwTiyfar errayes n iεessasen n ferεuwn.<verse eid="GEN 37:36" /></para>
  <chapter eid="GEN 37" />
  <chapter number="38" style="c" sid="GEN 38" />
  <para style="s">enjef n yehuwδa s tamar</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 38:1" />elweqθes yebεeδ yehuwδa f eyeθmes yeεmer γer eryaz δeεedlami esmiθes Hiyre. <verse eid="GEN 38:1" /><verse number="2" style="v" sid="GEN 38:2" />teεjebθi diyn yelliys n iyjen δkenεaniy, esmiθes cuwεe, yaγiθ. <verse eid="GEN 38:2" /><verse number="3" style="v" sid="GEN 38:3" />tiwi are tarwes engluws ysemmaθi εiyr. <verse eid="GEN 38:3" /><verse number="4" style="v" sid="GEN 38:4" />welbeεδ tiwi are xlaf taru engluws ysemmaθi uwnan. <verse eid="GEN 38:4" /><verse number="5" style="v" sid="GEN 38:5" />welbeεδ tεaweδ tirew g keziyb engluws ysemmaθi ciyla. <verse eid="GEN 38:5" /><verse number="6" style="v" sid="GEN 38:6" />yaγ yehuwδa y εiyr memmis emenzu temeTTuwθ esmiθes tamar. <verse eid="GEN 38:6" /><verse number="7" style="v" sid="GEN 38:7" />yemenni εiyr emenzu n yehuwδa yenγi rebbi lexaTer ykan yuwHec g tiTTewines. <verse eid="GEN 38:7" /><verse number="8" style="v" sid="GEN 38:8" />yenne yehuwδa yuwnan memmis eθθani: «aδef f liwec n yuwwex teγetteθ taγδeδ y yuwwex idrari.» <verse eid="GEN 38:8" /><verse number="9" style="v" sid="GEN 38:9" />yessen uwnan elli ezzerriyεeθ ettekkerc y nette, elweqθes yeδwel uwnan lemmi eyxaleδ liwec n yuwwes eywezzeε f elqeεεeθ bac liθeγeδc idrari y yuwwes. <verse eid="GEN 38:9" /><verse number="10" style="v" sid="GEN 38:10" />yezre rebbi elli elεemeltes θahen tuwHec, yenγi zade. <verse eid="GEN 38:10" /><verse number="11" style="v" sid="GEN 38:11" />yenne yehuwδa y tamar tesliθes: «eqqiym ettehejjelt g elHuwc n daddem elmeyekber memmi ciyla.» lexaTer yukkeδ f ciyla δeyemmuwθ max i mmuwθen eyeθmes. temreq tamar yelHuwc n daddes teqqiym diyn.<verse eid="GEN 38:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 38:12" />beεδ elmuddeθ θemmuwθ liwec n yehuwδa yelliys n cuwεe. beεδ iyiywi yehuwδa elεze, yemreq y leεbaδ δelesyen esεiys g temne nette dHiyrE emeddukles eεedlami. <verse eid="GEN 38:12" /><verse number="13" style="v" sid="GEN 38:13" />tamar tesle elli ewesseres δeyemreq y θemne δeyelsi esseεyes. <verse eid="GEN 38:13" /><verse number="14" style="v" sid="GEN 38:14" />elweqθes tekkes edbac n tihejjalin teHfel eθγembez welbeεδ teqqiym g iymi n εiynayim f webriδ n temne. lexaTer tessen elli ciyla yekber yemenni netteθ eddukkelc δliweces. <verse eid="GEN 38:14" /><verse number="15" style="v" sid="GEN 38:15" />elweqθelli yezrit yehuwδa yetεilekiθ δicθ δ telfaseδt lexaTer eθkan eθγembez. <verse eid="GEN 38:15" /><verse number="16" style="v" sid="GEN 38:16" />ymaH etweliys g eljneb n webriδ yen: «edji eneεse iyδem.» unette elyessiync elli netteθ ettesliθes. tenne: «δmat eyθuwceδ elqulli eθenεseδ iyδi?» <verse eid="GEN 38:16" /><verse number="17" style="v" sid="GEN 38:17" />yenne: «emazne iyγiδ s esεiyw.» tenne: «eyθuwceδ erhen elmettezneδ.» <verse eid="GEN 38:17" /><verse number="18" style="v" sid="GEN 38:18" />yenceδteθ: «δmat iθexseδ emuwce?» tennayes: «elxusθex dessebθex etteγriθex.» yuwces δmat iθexs. yenεes iyδes tawi are essis. <verse eid="GEN 38:18" /><verse number="19" style="v" sid="GEN 38:19" />welbeεδ tekker temreq, tekkes elHfeles tiyreδ edbac n tihejjalin xlaf.<verse eid="GEN 38:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 38:20" />max i yuzen iyγiδ dweSHibes eεedlami bac ayer erhen seg wafus n temeTTuwθ, etyufiyc. <verse eid="GEN 38:20" /><verse number="21" style="v" sid="GEN 38:21" />yenceδ leεbaδ elli εemren diyn: «mani θelfasetdiyn elli tkan teqqiym g eljneb n webriδ n εiynayim?» ennan: «eltkanc dah θelfasedt.» <verse eid="GEN 38:21" /><verse number="22" style="v" sid="GEN 38:22" />yeδwel etwali yehuwδa yen: «ettufixc uzade ennan leεbaδ elli εemren diyn, eHebbec θelfasedt dah.» <verse eid="GEN 38:22" /><verse number="23" style="v" sid="GEN 38:23" />yenne yehuwδa: «edj eθedj elli γers. neč elγisexc eSSen felle leεbaδ. neč uzenγes iγiyδe yemenni cex ettufiyc.»<verse eid="GEN 38:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 38:24" />max i θεedden tlaθe chuwr yesle yehuwδa elli tamar tesliθes θelfasedt tezne tawi are. yenne yehuwδa: «sufγemteθ etneHreq. enceεεel δiys elεafyeθ.» <verse eid="GEN 38:24" /><verse number="25" style="v" sid="GEN 38:25" />max i ttessuwfγen tuzen yuwesseres tennayes: «neč ettemeεδurθ seg iθbab niyh. enzi δegli n wiyn elxuwseθe dessebθeθe etteγriyθe.» <verse eid="GEN 38:25" /><verse number="26" style="v" sid="GEN 38:26" />yehuwδa yuxezθen yen: «netteθ emmenjed xiriyw lexaTer neč ettucixc ymemmi ciyla emmax i yeqqar elqanuwn.» welbeεδ ettixeleδc. <verse eid="GEN 38:26" /><verse number="27" style="v" sid="GEN 38:27" />max i dyuwse elweqθ n terwas, yelle etwame g teδisθes. <verse eid="GEN 38:27" /><verse number="28" style="v" sid="GEN 38:28" />max i θebδe ettaru ysuwfeγ iyjen essisen efuses. teqqenti temeTTuwθ elli tessaru δiys seg tilelli ettezukkaγθ. ten: «wahen yeffeγ igmezwer.» <verse eid="GEN 38:28" /><verse number="29" style="v" sid="GEN 38:29" />yemenni wahen yenzeγ efuses yeffeγ yuwwes. tenne: «mat effaγe, tefγetti qebles!» emmale semmanti fareS. <verse eid="GEN 38:29" /><verse number="30" style="v" sid="GEN 38:30" />welbeεδ yeffeγ yuwwes iθbab n elxumseθ temsuwneδ s tilelli ettezukkaγθ. emmale semmanti zareH.<verse eid="GEN 38:30" /></para>
  <chapter eid="GEN 38" />
  <chapter number="39" style="c" sid="GEN 39" />
  <para style="s">yuwsef g miSr</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 39:1" />elweqθes iwiyen ismaεiyliyyen yuwsef y miSr. yesγi essisen iyjen δemiSri esmiθes fuwTiyfar. nette δexeddam n ferεuwn uδerrayes n iεessesnes. <verse eid="GEN 39:1" /><verse number="2" style="v" sid="GEN 39:2" />ykan rebbi dyuwsef welli eθyeg eθiyged. yeεmer dumiSri iθbab n elHuwc. <verse eid="GEN 39:2" /><verse number="3" style="v" sid="GEN 39:3" />yezre siydiys elli rebbi iyδes uyetgeddes elli egneθ ifesnes. <verse eid="GEN 39:3" /><verse number="4" style="v" sid="GEN 39:4" />yufe yuwsef elqeδres γer fuwTiyfar eyendeγ yegi δerrayes f elHuces delli ymellex elkul. <verse eid="GEN 39:4" /><verse number="5" style="v" sid="GEN 39:5" />seg elweqθes rebbi ibarex elHuwc n umiSri delli δiys delli g ujiymi f elxaĎer n yuwsef. <verse eid="GEN 39:5" /><verse number="6" style="v" sid="GEN 39:6" />yedje fuwTiyfar elli γers elkul yyuwsef. elyettelhiyc seg Hette cey kan seg wexθari n wečes. yuwsef δiyjen δecbeb egget.<verse eid="GEN 39:6" /></para>
  <para style="s">ejerreb n wezne dyuwsef</para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 39:7" />fiyseε fiyseε tebδe liwec n siydiys eddukkayes seg tiTTewines, tebδe teqqares: «est enεes iyδi.» <verse eid="GEN 39:7" /><verse number="8" style="v" sid="GEN 39:8" />elyeqqiylc, yerni yennayes: «siydiy wah yedje g ifesniyw elli γers elkul g elHuwce welyettelhiyc seg Hette cey. <verse eid="GEN 39:8" /><verse number="9" style="v" sid="GEN 39:9" />eHebbec g elHuwce δ wiyn emneč. welyekkiysec felle Hette cey kan δcemdiyn lexaTrek δliweces. max ege elεemleθe temeqqarθ usinc eγelĎe ezzaθ n rebbi?» <verse eid="GEN 39:9" /><verse number="10" style="v" sid="GEN 39:10" />yuwsef elyeqqiylc eyesl edwi n liwec n fuwTiyfar yemenni netteθ eθkan ettezzel δefres diyme.<verse eid="GEN 39:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 39:11" />as iyjen yuwδef y elHuwc enzi δmat δayeg. yemenni elHuwc ykan δelfareγ welδiys Hette iyjen. <verse eid="GEN 39:11" /><verse number="12" style="v" sid="GEN 39:12" />netteθ teTTefθi seg texmisθes tennayes: «asse δeθenεseδ iyδi.» elweqθes yerwel elberre yedj texmisθes g ifesnes. <verse eid="GEN 39:12" /><verse number="13" style="v" sid="GEN 39:13" />max i θezre elli nette elyeqqiylc yerwel elberre yedj texmisθes g ifesnes, <verse eid="GEN 39:13" /><verse number="14" style="v" sid="GEN 39:14" />tnabe yleεbaδ n elHuces tenne: «enziθ δmat iyege. eεibranidiyn elli yuwγeδti eryaziyw yelHuwc. rahu yuseδ bac e yzul fellane. yuseδiyδ y ezzeqqaw yexs eyyixaleδ embessiyf. elweqθes εeyĎe eSbiyH. <verse eid="GEN 39:14" /><verse number="15" style="v" sid="GEN 39:15" />max i yesle εeyĎe eSbiyH, yedje texmisθes iyδi yerwel elberre.» <verse eid="GEN 39:15" /><verse number="16" style="v" sid="GEN 39:16" />edĎeyyec texmisθes g eljenbes elmi idyuwse fuwTiyfar y elHuwc <verse eid="GEN 39:16" /><verse number="17" style="v" sid="GEN 39:17" />teHkayes edwiye wah tennayes: «y uwδef exemmes eεibrani elli tuγeddane y ezzeqqaw yexs eyeθfiysex felle embessiyf. <verse eid="GEN 39:17" /><verse number="18" style="v" sid="GEN 39:18" />max i εeyδe eSbiyH, yedje texmisθes g eljenbiyw yerwel elberre.» <verse eid="GEN 39:18" /><verse number="19" style="v" sid="GEN 39:19" />max i yesle fuwTiyfar edwi n liweces, uδmat iθenne felles tecεel δiys elεafyeθ. <verse eid="GEN 39:19" /><verse number="20" style="v" sid="GEN 39:20" />yeTTef yuwsef iHuTTi g elHebs meni iqqiymen imeHbas n elmlek. <verse eid="GEN 39:20" /><verse number="21" style="v" sid="GEN 39:21" />yemenni rebbi yeqqiym diyme dyuwsef, yucayes egget seg erreHmtes. elweqθes yufe yuwsef elqeδres γer errayes n elHebs. <verse eid="GEN 39:21" /><verse number="22" style="v" sid="GEN 39:22" />elmi isyuwce elεesseθ f elHebs delli yetteθHerrex diyn elkul. <verse eid="GEN 39:22" /><verse number="23" style="v" sid="GEN 39:23" />ykan rebbi dyuwsef derrayes n elHebs eθyetHesiybc f Hette cey welli eθyeg iθiged diyme.<verse eid="GEN 39:23" /></para>
  <chapter eid="GEN 39" />
  <chapter number="40" style="c" sid="GEN 40" />
  <para style="s">yuwsef dufesser n tirjiyθin</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 40:1" />telle elmerreθ essaqi duxebbaz eγleĎen g siydiynsen elmlek n miSr. <verse eid="GEN 40:1" /><verse number="2" style="v" sid="GEN 40:2" />yeθγeccec ferεuwn egget f ixeddemnes lessenniyn, errayes n essuqqay derrayes n ixebbazen. <verse eid="GEN 40:2" /><verse number="3" style="v" sid="GEN 40:3" />iHuTTiyn g elHebs n errayes n iεessasen meni iykan yuwsef yemmeHbes. <verse eid="GEN 40:3" /><verse number="4" style="v" sid="GEN 40:4" />ykellef errayes n iεessasen yuwsef δentyexδem. eqqiymen lessenniyn liyyameθ g elHebs. <verse eid="GEN 40:4" /><verse number="5" style="v" sid="GEN 40:5" />as iyjen g δeggiyδ yezre essaqi n ferεuwn duxebbezes unihnin g elHebs kul iyjen essisen tirjiyθ. <verse eid="GEN 40:5" /><verse number="6" style="v" sid="GEN 40:6" />max i yuwδef fellasen yuwsef talji bekri yuwfin kezmen. <verse eid="GEN 40:6" /><verse number="7" style="v" sid="GEN 40:7" />yenceδten: «imat asse uδmewnewwem jehmen?» <verse eid="GEN 40:7" /><verse number="8" style="v" sid="GEN 40:8" />ennanes: «yezre kul iyjen essiyne tirjiyθ. weHebbac δ wiyn exentifesser.» yenneyasen yuwsef: «efesser n tirjiyθin δegli n rebbi. enmi fellasen.»<verse eid="GEN 40:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 40:9" />yeHke errayes n essuqqay tirjiyθes f yuwsef. yennayes: «ezriyγ g terjiθiyw teεenbeyθ ezzeθiyw. <verse eid="GEN 40:9" /><verse number="10" style="v" sid="GEN 40:10" />δiys tlaθe δleεref. tege tifray eθnewwer ufiyseε fiyseε Ďaben icermexes. <verse eid="GEN 40:10" /><verse number="11" style="v" sid="GEN 40:11" />elkas n ferεuwn eθkan g wefusiyw. qame elεneb eεeSrexθi g elkas n ferεuwn welbeεδ uciyγ elkas y ferεuwn.» <verse eid="GEN 40:11" /><verse number="12" style="v" sid="GEN 40:12" />yennayes yuwsef: «tirjiyθex tenne: tlaθe δleεref n ihnin tlaθe eyyam. <verse eid="GEN 40:12" /><verse number="13" style="v" sid="GEN 40:13" />beεδ tlaθe eyyam exyqam ferεuwn ixfex usinc exyer emqebl elweqθelli tkaneδ ettezzelδes g elkas. <verse eid="GEN 40:13" /><verse number="14" style="v" sid="GEN 40:14" />max eθeθHessen leHwelex ereHmiyδ eyθetwec θendas y ferεuwn felle bac e yimenneε s elHebse. <verse eid="GEN 40:14" /><verse number="15" style="v" sid="GEN 40:15" />lexaTer ywiyni s elqeεεeθ n iεibraniyyen embessiyf welbeεδ emHuTTe g elHebs uneč wellegiyγ Hette cey.» <verse eid="GEN 40:15" /><verse number="16" style="v" sid="GEN 40:16" />max i yezre errayes n ixebbazen elli efesser n yuwsef yebhe yennayes: «ezriyγ neč zade tirjiyθ, tlaθe ettisiyfes n weγrum emellal enni ixfiyw. <verse eid="GEN 40:16" /><verse number="17" style="v" sid="GEN 40:17" />eθkan tisiyfesθ tiglennejθ tεebbe seg weče elli yegi exebbaz y ferεuwn, yemenni iciciywen kanen tetten δiys seg essiyfesθ enni ixfiyw.» <verse eid="GEN 40:17" /><verse number="18" style="v" sid="GEN 40:18" />yennayes yuwsef: «tirjiyθex tenne: tlaθe ettisifiysin n ihenti tlaθe eyyam. <verse eid="GEN 40:18" /><verse number="19" style="v" sid="GEN 40:19" />qebl tlaθe eyyam eyebbi ferεuwn ixfex usinc exyayel f weγru usinc ečen iciciywen exsumex.»<verse eid="GEN 40:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 40:20" />as eθθaleθ yekker as elli yemmaru δiys ferεuwn. ferεuwn yege elHefleθ y ixeddemnes elkul. yaγeδ s elHebs errayes n essuqqay derrayes n ixebbazen ezzaθ n ixemmesnes. <verse eid="GEN 40:20" /><verse number="21" style="v" sid="GEN 40:21" />yerre ferεuwn errayes n essuqqay y elxeδmtes yeδwel iθezzel g elkas y wafus n ferεuwn. <verse eid="GEN 40:21" /><verse number="22" style="v" sid="GEN 40:22" />yemenni errayes n ixebbazen yuyelti ferεuwn f weγru max i yenne yuwsef. <verse eid="GEN 40:22" /><verse number="23" style="v" sid="GEN 40:23" />yemenni errayes n essuqqay yettu yuwsef welyufleyc y ferεuwn felles.<verse eid="GEN 40:23" /></para>
  <chapter eid="GEN 40" />
  <chapter number="41" style="c" sid="GEN 41" />
  <para style="s">tirjiyθ n ferεuwn</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 41:1" />beεδ iθεedden εamiyn y ettirjiyθ ferεuwn elli nette ibed f eccafeθ n wesuwf n enniyl. <verse eid="GEN 41:1" /><verse number="2" style="v" sid="GEN 41:2" />utay sebεe ettifunasin bhaneθ weqwaneθ uliyneθ seg wesuwf ebδaneθ retteεneθ g weγniym. <verse eid="GEN 41:2" /><verse number="3" style="v" sid="GEN 41:3" />welbeεδ yezre sebεe ettifunasin xlaf uHecneθ weDεaf egget uliyneθ seg wesuwf welbeεδ bedneθ g eljneb n timezwarin. <verse eid="GEN 41:3" /><verse number="4" style="v" sid="GEN 41:4" />ečneθ tifunasin timuwHac essebεe elli Dεaf tifunasin tibehhayin essebεe elli qwaneθ welbeεδ yekker ferεuwn. <verse eid="GEN 41:4" /><verse number="5" style="v" sid="GEN 41:5" />iεaweδ ferεuwn yenεes yettirjiyθ elmerreθ xlaf elli sebεe ettiyeδrin effeγneθ s iyjen n eljδer (n elεerq) unihenti εebbaneθ egget. <verse eid="GEN 41:5" /><verse number="6" style="v" sid="GEN 41:6" />welbeεδ yezre sebεe ettiyeδrin xlaf eqquwrneθ seg waDu n wecihiyli effeγneθ δeffer timezwarindiyn. <verse eid="GEN 41:6" /><verse number="7" style="v" sid="GEN 41:7" />ebleεneθ tiyeδrin essebεe elli eqquwrneθ tiyeδrin essebεe elli εebbaneθ, yekker ferεuwn yefhem elli tkan ettirjiyθ. <verse eid="GEN 41:7" /><verse number="8" style="v" sid="GEN 41:8" />max i θeffeγ talji yekker ferεuwn unette δimjehhem seg elli yejrayes δeggiyδ. yeg sahen, yazen yuwγeδ iseHHaren diqerrayen n temuwreθ elkul. yeHkeyasen δmat iyettirjiyθ δeggiyδ yemenni Hette iyjen iged yefhem tirjiyθ n ferεuwn. <verse eid="GEN 41:8" /><verse number="9" style="v" sid="GEN 41:9" />elweqθes yenne errayes n essuqqay yferεuwn: «asse esfekkre elγelTiyw. <verse eid="GEN 41:9" /><verse number="10" style="v" sid="GEN 41:10" />elweqθelli yeθγeccec siydiy ferεuwn felle neč derrayes n ixebbazen, yeg sah, iHuTTane g elHebs n errayes n iεessasen. <verse eid="GEN 41:10" /><verse number="11" style="v" sid="GEN 41:11" />yezre kul iyjen essiyne tirjiyθ g icθ n elliyleθ, ukul tirjiyθ γers elmeεnas. <verse eid="GEN 41:11" /><verse number="12" style="v" sid="GEN 41:12" />ykan iyδne eεezri δεibraniy, δexeddam n errayes n iεessasen. yeHkayes kul iyjen f terjiθes, ifesrenexθent kul iyjen max i syenne. <verse eid="GEN 41:12" /><verse number="13" style="v" sid="GEN 41:13" />welli yenneyane felles ySar. yerrayi siydiy ferεuwn y elxeδmtiyw yemenni wissen yuyelti f weγru yenγi.»<verse eid="GEN 41:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 41:14" />yazen ferεuwn δeseddaγen yuwsef. eγδenti s elHebs fiyseε fiyseε. beεδ iHejjem ixfes duδmes yireD edbac xlaf, yuwδef ibed ezzaθ n ferεuwn. <verse eid="GEN 41:14" /><verse number="15" style="v" sid="GEN 41:15" />yenne ferεuwn y yuwsef: «ezriyγ δeggiyδ tirjiyθ weHebbac δ wiyn yefhemt. neč esliyγ fellex elli cexdiyn etgeddeδ etfesreδ tirjiyθin.» <verse eid="GEN 41:15" /><verse number="16" style="v" sid="GEN 41:16" />yerre yuwsef efferεuwn yennayes: «neč ellessinexc. wahen seg rebbi, nette δexyen f mat iθexseδ.» <verse eid="GEN 41:16" /><verse number="17" style="v" sid="GEN 41:17" />yenne ferεuwn y yuwsef: «ezriyγ imeniyw g terjiθ bedde g eccafeθ n wesuwf n enniyl. <verse eid="GEN 41:17" /><verse number="18" style="v" sid="GEN 41:18" />usebεe ettifunasin bhaneθ weqwaneθ uliyneθ seg wesuwf ebδaneθ retteεneθ. <verse eid="GEN 41:18" /><verse number="19" style="v" sid="GEN 41:19" />usebεe ettifunasin xlaf uHecneθ weDεaf uliyneθ seg wesuwf δeffer timezwarindiyn. neč ellezrixc xlaf tifunasin uHecneθ emnihenti g elqeεεeθ nmiSr elkul. <verse eid="GEN 41:19" /><verse number="20" style="v" sid="GEN 41:20" />ečneθ tifunasin timuwHac essebεe elli Dεaf tifunasin tibehhayin essebεe elli qwaneθ. <verse eid="GEN 41:20" /><verse number="21" style="v" sid="GEN 41:21" />yemenni eqqiymneθ eqquwrneθ s etεef kunc εliyhum entečiync. yeqqiym errehĎensneθ yuwHec max i ykan. elweqθes ekkere s unuddem. <verse eid="GEN 41:21" /><verse number="22" style="v" sid="GEN 41:22" />welbeεδ ezriyγ g terjiθiyw elli sebεe ettiyeδrin bhaneθ uεebbaneθ effeγneθ s iyjen n eljδer. <verse eid="GEN 41:22" /><verse number="23" style="v" sid="GEN 41:23" />usebεe ettiyeδrin xlaf eqquwrneθ seg waDu n wecihiyli effeγneθ δeffer timezwarin. <verse eid="GEN 41:23" /><verse number="24" style="v" sid="GEN 41:24" />ebleεneθ tiyeδrin timuwHac elli eqquwrneθ tiyeδrin tibehhayin elli εebbaneθ. enniyγ y iseHHaren f terjiθiyw, yemenni weHebbac δ wiyn ifesriyt.»<verse eid="GEN 41:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 41:25" />yenne yuwsef y ferεuwn: «tirjiyθin n ferεuwn nihenti icθ n tirjiyθ. urebbi ysexn yferεuwn δmat iyenwe δayeg. <verse eid="GEN 41:25" /><verse number="26" style="v" sid="GEN 41:26" />tifunasin essebεe elli bhaneθ nihenti sebεe sniyn utiyeδrin essebεe elli bhaneθ nihenti zade sebεe sniyn n eSSabeθ. tirjiyθin essentiyn nihenti icθ n terjiθ. <verse eid="GEN 41:26" /><verse number="27" style="v" sid="GEN 41:27" />tifunasin essebεe timuwHac elli uliyneθ δeffer timezwarin nihenti sebεe sniyn. usebεe tiyeδrin θelfuwrraγ elli eqquwrneθ seg waDu n eccerq nihenti zade sebεe sniyn n ezzemmeθ. <verse eid="GEN 41:27" /><verse number="28" style="v" sid="GEN 41:28" />usah rebbi ysexnex δmat δayeg max i xenniyγ. <verse eid="GEN 41:28" /><verse number="29" style="v" sid="GEN 41:29" />f elqeεεeθ n miSr elkul δeddesen sebεe sniyn δiysen eSSabeθ ettemeqqarθ. <verse eid="GEN 41:29" /><verse number="30" style="v" sid="GEN 41:30" />welbeεδ eddasneθ sebεe sniyn n ezzemmeθ. esetwen leεbaδ g eSSabeθ elli zrinteθ g miSr lexaTer ezzemmeθ δeθefreδ elqeεεeθ usinc ettedj teqquwr. <verse eid="GEN 41:30" /><verse number="31" style="v" sid="GEN 41:31" />uleεbaδ etwen liyyameθ n eSSabeθ lexaTer ezzemmeθ δettes teqwe egget f temuwreθ. <verse eid="GEN 41:31" /><verse number="32" style="v" sid="GEN 41:32" />ucex tezriyδ tirjiyθ merθiyn lexaTer rebbi δayeg qriyb δmat iyenwe. <verse eid="GEN 41:32" /><verse number="33" style="v" sid="GEN 41:33" />uture, enzi eryaz δelεaqel uyessen etHuTTeδ f miSr. <verse eid="GEN 41:33" /><verse number="34" style="v" sid="GEN 41:34" />tHuTTeδ elHukkam f elqeεεeθ n miSr elkul, elemδen elxmus n eSSabeθ g sebεe sniyn imezwaren. <verse eid="GEN 41:34" /><verse number="35" style="v" sid="GEN 41:35" />ennasen elemδen eče n sebεe sniyn δeSSabeθ, usinc exeznen iyrδen delmuwneθ y leεbaδ, welbeεδ eθeHrzen g timuwre seddu ifassen n ferεuwn. <verse eid="GEN 41:35" /><verse number="36" style="v" sid="GEN 41:36" />usinc eθegem ečaye wahen δelmuwneθ y sebεe sniyn n ezzemmeθ elli δewwin elqeεεeθ n miSr bac θemuwreθ etmettiyc.»<verse eid="GEN 41:36" /></para>
  <para style="s">etterqyeθ n yuwsef</para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 41:37" />yezre ferεuwn dixeddemnes elli edwi n yuwsef yebhe. <verse eid="GEN 41:37" /><verse number="38" style="v" sid="GEN 41:38" />yenneyasen ferεuwn: «n etgeddec anef eryaz δiys erruwH n rebbi emwah.» <verse eid="GEN 41:38" /><verse number="39" style="v" sid="GEN 41:39" />yenne ferεuwn y yuwsef: «beεδ ixyuwce rebbi elqreyeθe elkul, eHebbec δ wiyn δelεaqel uyessen emcex. <verse eid="GEN 41:39" /><verse number="40" style="v" sid="GEN 41:40" />neč δexege δewkiyl f elqeSriyw usinc edje leεbaδ n miSr elkul eδuyuwren δeffer tufleyθex. uneč meniyc xirex kan s elkursiye emeqqar.» <verse eid="GEN 41:40" /><verse number="41" style="v" sid="GEN 41:41" />welbeεδ yenne f erεuwn y yuwsef: «taye δexHuTTe δelHakem f elqeεεeθ n miSr elkul.» <verse eid="GEN 41:41" /><verse number="42" style="v" sid="GEN 41:42" />yekkes ferεuwn elxusθes n elHkum seg weDeDes, yegi g waDeD n yuwsef. yirDes edbac s tekettent tebhe yeyles tesemsmiθ n uwreγ f elεunqes. <verse eid="GEN 41:42" /><verse number="43" style="v" sid="GEN 41:43" />yserkebθi f eθkerrittes teθθaniθ welbeεδ inabe f iεessesnes yenneyasen: «erkεeθ y yuwsef!» usah yegi δelHakem f elqeεεeθ n miSr elkul. <verse eid="GEN 41:43" /><verse number="44" style="v" sid="GEN 41:44" />yenne ferεuwn y yuwsef: «neč δferεuwn uδeqqiyme δferεuwn. yemenni eHebbec δ wiyn δeyufley beεδex g elqeεεeθ n miSr elkul.» ubeεεeδ yeδwel yuwsef δelHakem f miSr elkul. <verse eid="GEN 41:44" /><verse number="45" style="v" sid="GEN 41:45" />ysemme ferεuwn yuwsef &lt;Sefnat feεniyH&gt;. yaγes &lt;esnat&gt; yelliys n fuwTiyfariε elkahen ennuwn. <verse eid="GEN 41:45" /><verse number="46" style="v" sid="GEN 41:46" />max i yiweD yuwsef tleθiyn εam, ibed ezzaθ n ferεuwn elHakem n miSr. welbeεδ yeffeγ yuwsef yemreq yθenneD ynedzi g temuwreθ n miSr elkul. <verse eid="GEN 41:46" /><verse number="47" style="v" sid="GEN 41:47" />tuγeδ elqeεεeθ g sebεe sniyn imezwaren eSSabeθ ettemeqqarθ. <verse eid="GEN 41:47" /><verse number="48" style="v" sid="GEN 41:48" />ilemmeδ yuwsef eSSabeθ n sebεe sniyn s elqeεεeθ n miSr yexzent δeče seg ijiyman elli enneDen s timuwre elkul. <verse eid="GEN 41:48" /><verse number="49" style="v" sid="GEN 41:49" />yexzen yuwsef iyrδen egget emerremleθ n iylel elmi yeδwel litgeddec etyeHseb.<verse eid="GEN 41:49" /></para>
  <para style="s">idrari n yuwsef</para>
  <para style="p">
    <verse number="50" style="v" sid="GEN 41:50" />tiru esnat liwec n yuwsef sen δidrari qebl eyaδef esukkes emezwar n ezzemmeθ. <verse eid="GEN 41:50" /><verse number="51" style="v" sid="GEN 41:51" />ysemme yuwsef memmis emenzu &lt;menesse&gt; εlexaTer yenne: «ysetwi rebbi g etteεbiyw elkul dleεbaδ n elHuwc n dadde.» <verse eid="GEN 41:51" /><verse number="52" style="v" sid="GEN 41:52" />yemenni eθθani ysemmaθi &lt;ifrayim&gt; lexaTer yenne: «rebbi yucayiyδ idrari g temuwreθ zriyγ δiys etεeb egget.» <verse eid="GEN 41:52" /><verse number="53" style="v" sid="GEN 41:53" />welbeεδ uqan sebεe sniyn n eSSabeθ elli tuseδ g elqeεεeθ n miSr. <verse eid="GEN 41:53" /><verse number="54" style="v" sid="GEN 41:54" />eseδneθ sebεe sniyn n ezzemmeθ max i yenne yuwsef, elweqθes yewweθ elez timuwre elkul kan δelqeεεeθ n miSr, esyexliyδc eleze wahen lexaTer ykan δiys eče yemmexzen. <verse eid="GEN 41:54" /><verse number="55" style="v" sid="GEN 41:55" />max i θewweθ ezzemmeθ elqeεεeθ n miSr elkul ebδen leεbaδ zeggen efferεuwn eqqarnes: «uwcane eγrum!» yenneyasen ferεuwn: «emerqeθ y yuwsef welli exenyen egemt.» <verse eid="GEN 41:55" /><verse number="56" style="v" sid="GEN 41:56" />terni ezzemmeθ teθqewwe g elqeεεeθ n miSr elkul. elweqθes imiyr yuwsef elmxazen yebδe yezzenze gweče y leεbaδ n miSr. <verse eid="GEN 41:56" /><verse number="57" style="v" sid="GEN 41:57" />usiynd leεbaδ seg elblayeS elkul bac e sγen iyrδen seg yuwsef lexaTer leεbaδ ellufinc δmat δečen.<verse eid="GEN 41:57" /></para>
  <chapter eid="GEN 41" />
  <chapter number="42" style="c" sid="GEN 42" />
  <para style="s">ewwel merre yuwsef dewmeθnes emlaqen</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 42:1" />max i yesle yeεquwb elli yelle iyrδen g miSr yenne y idreriys: «imat teqqiymem sah iyjen inedzi g iyjen?» <verse eid="GEN 42:1" /><verse number="2" style="v" sid="GEN 42:2" />yenne: «esliyγ, yelle iyrδen g miSr, berreθ eldiyn eseγmane iyrδen bac e neqqiym nedder wentmettiyc.» <verse eid="GEN 42:2" /><verse number="3" style="v" sid="GEN 42:3" />yaxi eggezen ewmaθen n yuwsef elεecre y miSr δesγen iyrδen. <verse eid="GEN 42:3" /><verse number="4" style="v" sid="GEN 42:4" />yemenni yeεquwb elyuziync benyamiyn yuwwes n yuwsef iyδsen lexaTer yθekkaδ felles esyejre ecceHaje. <verse eid="GEN 42:4" /><verse number="5" style="v" sid="GEN 42:5" />usiynd idrari n israYiyl g wemmes n leεbaδ elli δesγen iyrδen lexaTer elez yewweθ elqeεεeθ n kenεan elkul.<verse eid="GEN 42:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 42:6" />ykan yuwsef eyendeγ elHakem g elqeεεeθ n miSr unette elli yezzenze g iyrδen y leεbaδ n timuwre elkul. usiynd ewmaθen n yuwsef emmeHδfen ezzeθes wuδmewnensen g elqeεεeθ. <verse eid="GEN 42:6" /><verse number="7" style="v" sid="GEN 42:7" />max i ntyezre yuxezθen yemenni yege imenes entyessiync yerni yufleyasen unette izegge fellasen yenneyasen: «meniys ittuwsim?» ennan: «seg elqeεεeθ n kenεan δenseγ eče.» <verse eid="GEN 42:7" /><verse number="8" style="v" sid="GEN 42:8" />yuwsef yuxez ewmeθnes yemenni n ihnin eθuxizenc. <verse eid="GEN 42:8" /><verse number="9" style="v" sid="GEN 42:9" />yesfekker yuwsef mat eyettirjiyθ f eyeθmes welbeεδ yenneyasen: «xenyum tusiymd δeθenzim elbiyban n temurθenne bac e θeδfem esyiyn usinc exentenγem.» <verse eid="GEN 42:9" /><verse number="10" style="v" sid="GEN 42:10" />ennanes: «la, ya siydiy, la, nečin ixeddemnex nuseδ δenseγ eče. <verse eid="GEN 42:10" /><verse number="11" style="v" sid="GEN 42:11" />nečin δidrari n weryaz iyjen. nečin nebhaθ wendaf wenγedder Hette iyjen.» <verse eid="GEN 42:11" /><verse number="12" style="v" sid="GEN 42:12" />yenneyasen: «la, xenyum tusiymd δeθenzim elbiybenenne elli miyren.» <verse eid="GEN 42:12" /><verse number="13" style="v" sid="GEN 42:13" />ennanes: «nečin eθnac δewmaθen, δidrari n weryaz iyjen iεemmer g kenεan. emezyenenne yeqqiym ddaddeθne uwissen iraH.» <verse eid="GEN 42:13" /><verse number="14" style="v" sid="GEN 42:14" />yenneyasen yuwsef: «la, yemenni max i xennenniyγ xenyum tusiymd δeθenzim θemurθenne. <verse eid="GEN 42:14" /><verse number="15" style="v" sid="GEN 42:15" />s iyxef n ferεuwn, elle wettefγem esyah kan max eyettaγem yuwweθwem emezyen. elweqθes esne elli xenyum eltesxerxusemc felle. <verse eid="GEN 42:15" /><verse number="16" style="v" sid="GEN 42:16" />azneθ iyjen essiywem edyeγ yuwweθwem, yemenni iddiyn eqqiymen g elHebs elmesne elli xenyum tesxerxuwsem uneγ la.» <verse eid="GEN 42:16" /><verse number="17" style="v" sid="GEN 42:17" />iHuTTiyn jmiyε g elHebs tlaθe eyyam.<verse eid="GEN 42:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 42:18" />g was eθθaleθ yennasen: «egeθ δmat exennenne, eθedrem. εlexaTer neč δeryaz essene rebbi uθekkaδe essis. <verse eid="GEN 42:18" /><verse number="19" style="v" sid="GEN 42:19" />wiδekan xenyum belHeq eltesxerxusemc edj eyeqqiym iyjen essiywem g elHebs, widdiyn eδawyen iyrδen y leHwecewwem bac midnewwem etmettanc s elez. <verse eid="GEN 42:19" /><verse number="20" style="v" sid="GEN 42:20" />eγeδmi yuwweθwem emezyen bac e xennesne f elHeq usiyn exenneqqexc.» egen emmax i senyenne. <verse eid="GEN 42:20" /><verse number="21" style="v" sid="GEN 42:21" />ennan y beεDhum: «nečin belHeq nege eδnuwb g yuwweθne. elqulli yetmelgane unečin ennesxiyfc f elles yuDe δiyne eδnubenne.» <verse eid="GEN 42:21" /><verse number="22" style="v" sid="GEN 42:22" />yenneyasen ruwban: «enniγawem eθegemc timuwHac yyuwweθne yemenni xenyum elteqqilemc eθeslem edwiye. ture iδemnes g eθxerminenne. uyelzem enxelleS.» <verse eid="GEN 42:22" /><verse number="23" style="v" sid="GEN 42:23" />elweqθes nihnin ellessinenc elli yuwsef yefhem edwiynsen elkul lexaTer ykan iδukkeyasen ujares iyδsen iyjen yetfesrasen g edwiynsen. <verse eid="GEN 42:23" /><verse number="24" style="v" sid="GEN 42:24" />yebεeδ fellasen yekker iθerw menγiyr eθezren welbeεδ yeδwel yufleyasen. yeTTef cemεuwn essisen yeqqenti ezzaθ n tiTTewinensen.<verse eid="GEN 42:24" /></para>
  <para style="s">arjeε y elqeεεeθ n kenεan</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 42:25" />yenne yuwsef yixeddemnes: «εebbeθ tisnayin n ewmaθen n cemεuwn δiyrδen termasen elfeTθensen elkul tucmasen elεwin y webriδ.» egen max i senyenne.<verse eid="GEN 42:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 42:26" />qamen irδnensen f iγyelensen eTfen ebriδ δerewHen. <verse eid="GEN 42:26" /><verse number="27" style="v" sid="GEN 42:27" />max i bedden δenenεsen imiyr iyjen essisen tisniθes bac e yeεlef y weγyules. yeθlameH elfeTθes lexaTer eθkan g iymi n tisniθ θemHuT. <verse eid="GEN 42:27" /><verse number="28" style="v" sid="GEN 42:28" />yenne yewmeθnes: «neč erriyni elfeTθiyw. enziyθ taye, enziyθ g tisniθiyw!» yeθbeddel uδmewnensen serreεbeθ eδwlen reεcen enzin ibeεDhum ennen: «rebbi ysender δiyne elfeεlenne!» <verse eid="GEN 42:28" /><verse number="29" style="v" sid="GEN 42:29" />max i DiwDen γer daddensen eHkanes δmat iyejre δiysen. ennan: <verse eid="GEN 42:29" /><verse number="30" style="v" sid="GEN 42:30" />«elHakem n miSr yufleyane unette izegge f ellane. yerni yetεilekane δleεbaδ nuHec unuδef miSr bac enessen elbiybenes. <verse eid="GEN 42:30" /><verse number="31" style="v" sid="GEN 42:31" />nennayes: &lt;nečin δleεbaδ nebhaθ wenγedder Hette iyjen. <verse eid="GEN 42:31" /><verse number="32" style="v" sid="GEN 42:32" />nečin eθnac δewmaθen, δidrari n weryaz iyjen. iyjen iraH wemezyenenne yeqqiym ture ddaddeθne g elqeεεeθ n kenεan.&gt; <verse eid="GEN 42:32" /><verse number="33" style="v" sid="GEN 42:33" />yenneyane: &lt;sahen δesne elli xenyum teqqarem g elHeq uneγ la. edjeθ iyjen essiywem γeri. tawyem δmat exenyezze δeče y leHwecewwem temerqem f imenewwem. <verse eid="GEN 42:33" /><verse number="34" style="v" sid="GEN 42:34" />eγeδmi yuwweθwem emezyen bac e sne elli xenyum f elHeq w δ leεbaδ tebham. elweqθes exennuwce yuwweθwem. usinc eθgeddem eθeqqiymem dah weθuyuwrem g temuwreθe max i θexsem.&gt;»<verse eid="GEN 42:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 42:35" />max i bδen etferγen g tisneynensen yufe kul iyjen essisen teSriyrθ n elfeTθes g tisniθes. max i zriyn tiSriyrin n elfeTTeθ, ukδen nihnin ddaddensen. <verse eid="GEN 42:35" /><verse number="36" style="v" sid="GEN 42:36" />yenneyasen daddensen yeεquwb: «θenγiymi idreriyw. yuwsef iraH ucemεuwn eHebbec utaye δeθawyem benyamiyn. wah elkul yeggez felle.» <verse eid="GEN 42:36" /><verse number="37" style="v" sid="GEN 42:37" />yufley ruwban y daddes yennes: «enγ sen idreriyw iδekan elleδwilexc essis. uciyθi uneč eDemne elli δexetterre.» <verse eid="GEN 42:37" /><verse number="38" style="v" sid="GEN 42:38" />yemenni yeεquwb yenne: «memmi limerreqc iyδwem, lexaTer yuwwes yemmuwθ unette weHδes yeqqiym. lukan esyejre ecceHaje g webriδ, uneč δeryaz δewesser emmuwθe s uliyw.»<verse eid="GEN 42:38" /></para>
  <chapter eid="GEN 42" />
  <chapter number="43" style="c" sid="GEN 43" />
  <para style="s">arjeε n idrari n yeεquwb wiyδsen benyamiyn</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 43:1" />elweqθes yewweθ elez θemuwreθ elkul. <verse eid="GEN 43:1" /><verse number="2" style="v" sid="GEN 43:2" />max i δuwqen iyrδen elli uγδenten seg miSr, yenneyasen daddensen: «eδwleθ eseγmane lewse n weče.» <verse eid="GEN 43:2" /><verse number="3" style="v" sid="GEN 43:3" />yerrayes yehuwδa: «elHakem n miSr ysukδane egget uyenneyane, &lt;eltzerremc uδmiyw iδekan etteγδemc yuwweθwem iyδwem.&gt; <verse eid="GEN 43:3" /><verse number="4" style="v" sid="GEN 43:4" />iδekan eθazneδ iyδne yuwweθne, enemreq usinc exnesγ eče. <verse eid="GEN 43:4" /><verse number="5" style="v" sid="GEN 43:5" />yemenni iδekan ettetteznec, enmerreqc lexaTer elHakem n miSr yenneyane, &lt;weltzerrem uδmiyw kan max ettaγem yuwweθwem iyδwem.&gt;» <verse eid="GEN 43:5" /><verse number="6" style="v" sid="GEN 43:6" />yenne yeεquwb: «imat θegiymi θemuwHacθ, tennem y elHakem n miSr elli γerwem yuwweθwem xlaf?» <verse eid="GEN 43:6" /><verse number="7" style="v" sid="GEN 43:7" />ennanes: «elHakem n miSr yencδane egget. yenceδ fellane dfelεercenne. yenneyane, &lt;daddeθwem elyuwc yedder? γerwem ewmaθ xlaf?&gt; elweqθes nennayes. δ wiyn exenyenne elli nette δexenyen, &lt;eγδeθ yuwweθwem eldah.&gt;?» <verse eid="GEN 43:7" /><verse number="8" style="v" sid="GEN 43:8" />yenne yehuwδa ydaddes: «azen engluws iyδi, ture enekker usinc enemreq bac e neqqiym nedder nečin dcex didreriynne elkul. <verse eid="GEN 43:8" /><verse number="9" style="v" sid="GEN 43:9" />neč eθeDemne. seg wefusiyw ettawyeδ. iδekan eθetteγδexc usinc eθesbedde ezzeθex eqqiyme leHyeθiyw elkul δelγaleĎ δiyx. <verse eid="GEN 43:9" /><verse number="10" style="v" sid="GEN 43:10" />lukan enneqqiymc enδukke sah, rane nemreq neδwel seg miSr sent δelmerraθ.» <verse eid="GEN 43:10" /><verse number="11" style="v" sid="GEN 43:11" />yenneyasen daddensen yeεquwb: «maδame elHkayeθ sah, egeθ elli texsem. yemenni ewyeθ elhδiyyeθ y elHakem n miSr iyδwem, lewse n uwδi ettamemt dlewse n elfeH dlaδen dlewse n elfusduq delluwz. <verse eid="GEN 43:11" /><verse number="12" style="v" sid="GEN 43:12" />ewyeθ iyδwem elfeTTeθ xlaf welfeTTeθ elli tuγδemteθ g tisneynewwem erremteθ. belekc eshan felles etwenteθ γerwem. <verse eid="GEN 43:12" /><verse number="13" style="v" sid="GEN 43:13" />tawyem yuwweθwem iyδwem tekrem emerqeθ y elHakem n miSr. <verse eid="GEN 43:13" /><verse number="14" style="v" sid="GEN 43:14" />rebbi exenyεawen γer elHakem n miSr uture exenyseyyeb yuwweθwem wissen dbenyamiyn. lukan neč entexsre lessenniyn, elweqθes eTfe g elquδreθ n rebbi, unette eyiseSber.»<verse eid="GEN 43:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 43:15" />qamen idrari n yeεquwb elhδiyyeθ n elHakem, ewyen elfeTTeθ xlaf ubenyamiyn iyδsen, ekren eggezen y miSr bedden ezzaθ n yuwsef. <verse eid="GEN 43:15" /><verse number="16" style="v" sid="GEN 43:16" />max i yezre yuwsef benyamiyn iyδsen yenne yerrayes n ixeddemnes: «suwδef iryazen y elHuwc teγrseδ ecwiyheθ eθHeDretteθ lexaTer iryazen δečen iyδi g elfĎuwr n elqayleθ.» <verse eid="GEN 43:16" /><verse number="17" style="v" sid="GEN 43:17" />essuδefθen y elHuwc max i syenne yuwsef. <verse eid="GEN 43:17" /><verse number="18" style="v" sid="GEN 43:18" />ukδen idrari n yeεquwb eddebelli uδefen y elHuwc n yuwsef. ennen: «yuγδane eldah bac e xenyHeSSel usinc exenyer δixeddemnes usinc eyawi iγyelenne lexaTer elfeTTeθ temezwarθ temmer iyδne.» <verse eid="GEN 43:18" /><verse number="19" style="v" sid="GEN 43:19" />yaxi emreqen y uxeddame emezwar n elHuwc n yuwsef eqqiymen dukkanes ezzaθ n iymi n elbab. <verse eid="GEN 43:19" /><verse number="20" style="v" sid="GEN 43:20" />ennen: «y a siydiy, eslane nečin nuseδ elmerreθ temezwarθ eldah bac e nseγ eče. <verse eid="GEN 43:20" /><verse number="21" style="v" sid="GEN 43:21" />max i nbed δenenεes unečin g webriδenne y elHuwc nmiyr tisneynenne yaf kul iyjen essiyne elfeTθes g iymi n tisniθes. taye nerriyt iyδne. <verse eid="GEN 43:21" /><verse number="22" style="v" sid="GEN 43:22" />unuγeδ iyδne elfeTTeθ xlaf bac e nseγ eče unečin ennessiync δ wiyn iHuT elfeTθenne g tisneynenne.» <verse eid="GEN 43:22" /><verse number="23" style="v" sid="GEN 43:23" />yenne eryaz: «ellamen fellawem, eθukδemc, rebbiθwem drebbi n daddeθwem yuceyawem elkenz gθisneynewwem welfeTθewwem rahu tiweDi.» welbeεδ yessufγasen cemεuwn. <verse eid="GEN 43:23" /><verse number="24" style="v" sid="GEN 43:24" />isuwδef eryazdiyn idrari n yeεquwb y elHuwc n yuwsef welbeεδ yuceyasen amen bac e siyrδen ikreεnensen delεelfeθ y iγyelensen. <verse eid="GEN 43:24" /><verse number="25" style="v" sid="GEN 43:25" />HeDren elhδiyyeθ elmedyes yuwsef elqeyleθ esettuwcen lexaTer sliyn elli nihnin δečen iyδes.<verse eid="GEN 43:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 43:26" />max i dyuwse yuwsef y elHuwc ucines elhδiyyeθ elli iyδsen unihnin erkeεnes f elqeεεeθ. <verse eid="GEN 43:26" /><verse number="27" style="v" sid="GEN 43:27" />yenceδten f leHwelensen welbeεδ yenneyasen: «δmat leHwal n daddeθwem ewesser elli tennami felles? welyuwc yedder uneγ la?» <verse eid="GEN 43:27" /><verse number="28" style="v" sid="GEN 43:28" />ennanes: «exeddemex daddeθne labas unette elyuwc yedder.» erkeεnes elmerreθ xlaf. <verse eid="GEN 43:28" /><verse number="29" style="v" sid="GEN 43:29" />yqam tiTTewines yenzi y yuwwes benyamiyn memmis n yemmes yen: «eyendeγ wahen yuwweθwem emezyen elli teHkami felles?» welbeεδ yennayes: «rebbi exyedj emmi.» <verse eid="GEN 43:29" /><verse number="30" style="v" sid="GEN 43:30" />yeffeγ yuwsef iθezzel elberre lexaTer nette yecθaHec y yuwwes egget elmi igzen imeTTewnes yaδef yezzeqqas iθerw diyn. <verse eid="GEN 43:30" /><verse number="31" style="v" sid="GEN 43:31" />beεδ iysireδ uδmes yeTTef imenes, yeffeγ yen: «eγδeθ eče!» <verse eid="GEN 43:31" /><verse number="32" style="v" sid="GEN 43:32" />uzade uγeδnes ynette weHδes unihnin weHδasen wimiSriyyen elli tetten iyδes uγeδnasen weHδasen εlexaTer Hesben g imenensen xiyr n leεbaδ iddiyn ugesber n imiSriyyen elli eyeč dεibrani eyeδwel δemenzuws. <verse eid="GEN 43:32" /><verse number="33" style="v" sid="GEN 43:33" />eqqiymen ezzaθ n yuwsef iyjen g eljneb n iyjen seg emenzu elumezyen δiysen. enzin ibeεDhum uθiTTewinensen effeγneθ. <verse eid="GEN 43:33" /><verse number="34" style="v" sid="GEN 43:34" />yuwce yuwsef y eyeθmes kul iyjen eče seg elmiδtes yemenni elbay n benyamiyn ykan exθer s xemse merraθ. eswen eferHen meεe beεDhum.<verse eid="GEN 43:34" /></para>
  <chapter eid="GEN 43" />
  <chapter number="44" style="c" sid="GEN 44" />
  <para style="s">elkas n yuwsef g tisniθ n benyamiyn</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 44:1" />ubeεεeδ yenne yuwsef y errayes n ixeddamen n elHuces: «εebbe tisnayin n iryazen seg weče egget egget tHuTTeδ elfeTTeθ n kul iyjen essisen g iymi n tisniθes. <verse eid="GEN 44:1" /><verse number="2" style="v" sid="GEN 44:2" />tHuTTeδ elkesiyw n elfeTTeθ dlefluws n iyrδen g iymi n tisniθ n umezyenensen.» yeg exeddamdiyn max i syenne yuwsef. <verse eid="GEN 44:2" /><verse number="3" style="v" sid="GEN 44:3" />max i θeqqeS tefuwθ, uzenen iryazen nihnin diγyelensen. <verse eid="GEN 44:3" /><verse number="4" style="v" sid="GEN 44:4" />eddebelli bεeδen lewse f elmdiyneθ yufley yuwsef y uxeddam n elHuces yennes: «ezzel δefrensen weddebelli entewδeδ ennasen, imat θenberem afus tezlawem elxiyr? <verse eid="GEN 44:4" /><verse number="5" style="v" sid="GEN 44:5" />imat tesreqem elkas n elfeTTeθ elli ises δiys siydiy? eyendeγ elkas yetberrej essis. s elεemleθe xenyum θegiymes θemuwHacθ.»<verse eid="GEN 44:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 44:6" />max i ntyiweD yenneyasen max i θiweSSe yuwsef. <verse eid="GEN 44:6" /><verse number="7" style="v" sid="GEN 44:7" />elweqθes erren felles ennanes: «imat siydiyθne iδukke sah? nečin entegc elεemleθ emtah. <verse eid="GEN 44:7" /><verse number="8" style="v" sid="GEN 44:8" />nečin, δelfeTTeθ elli nufiyt g tisneynenne, nerriyt iyδne s elqeεεeθ n kenεan. imat enesreq ture elfeTTeθ uneγ δuwreγ s elHuwc n siydiyx? <verse eid="GEN 44:8" /><verse number="9" style="v" sid="GEN 44:9" />elli eθafeδ iyδes elkas enγi unečin eneδwel δixeddamen y siydiyθne.» <verse eid="GEN 44:9" /><verse number="10" style="v" sid="GEN 44:10" />yenne: «neč δege s edwiyx yemenni elli eδafe iyδes elkas eθerre δexeddemiyw widdiyn entseybe erewHen.» <verse eid="GEN 44:10" /><verse number="11" style="v" sid="GEN 44:11" />isuggez kul iyjen essisen fiyseε fiyseε tisniθes g elqeεεeθ welbeεδ imiyr kul iyjen essisen tisniθes. <verse eid="GEN 44:11" /><verse number="12" style="v" sid="GEN 44:12" />yebδe yetferkes δiysen s iyjen s iyjen, seg emeqqar elumezyen elmi iθyuwfe g tisniθ n benyamiyn. <verse eid="GEN 44:12" /><verse number="13" style="v" sid="GEN 44:13" />elweqθes cerxen edbecensen welbeεδ qamen tisneynensen f iγyelensen eδwlen y elmdiyneθ.<verse eid="GEN 44:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 44:14" />max i yiweD yehuwδa dewmeθnes y elHuwc n yuwsef unette diyn erkεen ezzeθes f elqeεεeθ. <verse eid="GEN 44:14" /><verse number="15" style="v" sid="GEN 44:15" />yenneyasen yuwsef: «imat θegiym sah? eltessinemc elli neč δeryaz yetged yetberrej.» <verse eid="GEN 44:15" /><verse number="16" style="v" sid="GEN 44:16" />yenne yehuwδa: «δmat δexnen? nečin welγernexc δmat δenen? δmat δenen beεδ ixenyefDeH rebbi? nečin delli tufiym γers elkas neδwel δixeddemnex.» <verse eid="GEN 44:16" /><verse number="17" style="v" sid="GEN 44:17" />yenne yuwsef: «wahen Hram. neč etgeddexc ege sah. yemenni eryaz elli ufiyγ γers elkas δeyeδwel δexeddemiyw widdiyn neč wesentege Hette cey heδake εlac δemerqen erewHen y daddensen labas.»<verse eid="GEN 44:17" /></para>
  <para style="s">elwSateθ n yehuwδa</para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 44:18" />yeqreb yehuwδa y yuwsef yennes: «ya siydiy, samHiyδ. edji exuflaye weθeθγececec felle εlexaTer cex emferεuwn. <verse eid="GEN 44:18" /><verse number="19" style="v" sid="GEN 44:19" />cex tenceddane, yendre γerwem daddeθwem dyuwweθwem uneγ la. <verse eid="GEN 44:19" /><verse number="20" style="v" sid="GEN 44:20" />nennayex, γenne daddeθne δewesser dwengluws δemezyen yiruθi g elkebres. yuwwes yemmuwθ unette yeqqiym weHδes seg yemmes udaddes yexsi egget. <verse eid="GEN 44:20" /><verse number="21" style="v" sid="GEN 44:21" />yaxi tenniδane ha siydiy, eγδemti bac e θenziyγ. <verse eid="GEN 44:21" /><verse number="22" style="v" sid="GEN 44:22" />nennayex ha siydiy, litgeddec engluws eyedj daddes lexaTer lukan ebeεδen f beεDhum eyemmuwθ daddeθne. <verse eid="GEN 44:22" /><verse number="23" style="v" sid="GEN 44:23" />yemenni cex tenniδane, eltzerremc uδmiyw lukan etteγδemc yuwweθwem emezyen iyδwem. <verse eid="GEN 44:23" /><verse number="24" style="v" sid="GEN 44:24" />max i nrewweH y daddeθne exeddemex nennayes δmat ixentenniyδ. <verse eid="GEN 44:24" /><verse number="25" style="v" sid="GEN 44:25" />umax i xenyenne daddeθne, emerqeθ elmerreθ xlaf tesγmane lewse n weče, <verse eid="GEN 44:25" /><verse number="26" style="v" sid="GEN 44:26" />nennaθ, netgeddec eneggez lexaTer nečin netgeddec enzer uwδem n elHakem n miSr kan max enawi yuwweθne emezyen iyδne. <verse eid="GEN 44:26" /><verse number="27" style="v" sid="GEN 44:27" />yenneyane elweqθes exeddemex daddeθne, xenyum tessenem elli liweciyw, raHiyl tiyrewi sen δidrari berk. <verse eid="GEN 44:27" /><verse number="28" style="v" sid="GEN 44:28" />exsere iyjen essisen egeγ g elbeliyw elli yeči elhuwc g essewweθ. s elweqθes elture eθezrixc. <verse eid="GEN 44:28" /><verse number="29" style="v" sid="GEN 44:29" />wiδekan eθewyem wahen essi zade usinc esyejre ecceHaje, uneč δeryaz δewesser emmuwθe s uliyw. <verse eid="GEN 44:29" /><verse number="30-31" style="v" sid="GEN 44:30-31" />wiδekan nečin enrewweH weHδane, daddeθne eyemmuwθ unette ikezzem usinc eθnerδem g weniles. lexaTer nette yexs memmis exθer n imenes. <verse eid="GEN 44:30-31" /><verse number="32" style="v" sid="GEN 44:32" />neč εahδe dadde elli δeserre memmis labas wenniyγes, iδekan eθetteγδexc eltweliyx, eqqiyme leHyeθiyw elkul δelγaleĎ δiyx. <verse eid="GEN 44:32" /><verse number="33" style="v" sid="GEN 44:33" />billehi egi neč δexeddemex g elεuDes. tedjetti nette eyrewweH dyeθmes. <verse eid="GEN 44:33" /><verse number="34" style="v" sid="GEN 44:34" />iδekan litrewweHc iyδi benyamiyn neč etgeddexc emerqe ydadde usinc ebδiyγ nedziyγ δiys unette yetmette ezzeθiyw.»<verse eid="GEN 44:34" /></para>
  <chapter eid="GEN 44" />
  <chapter number="45" style="c" sid="GEN 45" />
  <para style="s">yuwsef eyesθeεref y ewmeθnes</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 45:1" />ligeddec yuwsef eyeTTef imenes ezzaθ n ixeddemnes. elweqθes yezge fellasen yen: «efγeθ felle elkul.» welyeqqiym Hette iyjen diyn max i senyenne yuwsef f elHqiqθes. <verse eid="GEN 45:1" /><verse number="2" style="v" sid="GEN 45:2" />yekker yuwsef iθerw eSbiyH elmi iθesliyn imiSriyyen delli g elHuwc n ferεuwn elkul. <verse eid="GEN 45:2" /><verse number="3" style="v" sid="GEN 45:3" />welbeεδ yenne yuwsef y eyeθmes: «neč dyuwsef, elyuwc dadde yedder?» yemenni eyeθmes elgeddenc esuθlayen lexeTerhum ukkeδen essis. <verse eid="GEN 45:3" /><verse number="4" style="v" sid="GEN 45:4" />yenne yuwsef y eyeθmes: «esδeθ etweliyw.» eqrebnes. elweqθes yenne: «neč yuwweθwem yuwsef elli ezzenzemti y miSr. <verse eid="GEN 45:4" /><verse number="5" style="v" sid="GEN 45:5" />uture eθukδemc weθeθHecmemc lexeTerkum ezzenzmi y miSr. δrebbi yexs sah unette elli yuzeniyδ eldah qeblewwem bac e xenmenεe xenyum dleεbaδ s temettent. <verse eid="GEN 45:5" /><verse number="6" style="v" sid="GEN 45:6" />ture θεedden εamiyn δezzemmeθ fellane welluciyn xemse sniyn xlaf welδiysen la δexrez ula δamjer. <verse eid="GEN 45:6" /><verse number="7" style="v" sid="GEN 45:7" />yuzeniyδ rebbi y elqeεεeθe qeblewwem bac e θafem δ wiyn exenymenneε s temettent usinc eqqiymen idreriywwem edderen. <verse eid="GEN 45:7" /><verse number="8" style="v" sid="GEN 45:8" />eyθuzinemc δxenyum eldah, yemenni δrebbi yegeyiyδ δennayeb n ferεuwn weyendeγ ewkiles f elHuces uδelHakem n miSr elkul. <verse eid="GEN 45:8" /><verse number="9" style="v" sid="GEN 45:9" />rewHeθ fiyseε ydadde tenmes, yennayex memmiyx yuwsef. rahu rebbi yegeyiyδ δelHakem f miSr elkul. est etweliyw fiyseε w eθεeTlec. <verse eid="GEN 45:9" /><verse number="10" style="v" sid="GEN 45:10" />bac e θeδewlem etweliyw usinc eθeεmreδ cex didreriyx didrari n idreriyx delHucewwem elkul g elqeεεeθ n jasan. <verse eid="GEN 45:10" /><verse number="11" style="v" sid="GEN 45:11" />uture exεawne diyn lexaTer elluciyn xemse sniyn δezzemmeθ usinc wetteHθajeδ Hette cey cex didreriyx delli iyδex elkul. <verse eid="GEN 45:11" /><verse number="12" style="v" sid="GEN 45:12" />utaye tezriymi seg tiTTewinewwem xenyum dbenyamiyn elli eryaze elli iδukkeyawem ture eyendeγ yuwsef yuwweθwem. <verse eid="GEN 45:12" /><verse number="13" style="v" sid="GEN 45:13" />emerqeθ enneθ y dadde f elqeδriyw g miSr. tenmes f elli tezriymti elkul. teγδemti fiyseε fiyseε eldah.»<verse eid="GEN 45:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 45:14" />iγemmer yuwsef yuwwes benyamiyn, yekker benyamiyn iθerw unette f texrumt n yuwsef. <verse eid="GEN 45:14" /><verse number="15" style="v" sid="GEN 45:15" />ubeεδ ikub eyeθmes elkul yekker yuwsef iθerw iyδsen, ebδen dukkanes.<verse eid="GEN 45:15" /></para>
  <para style="s">enabi n ferεuwn</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 45:16" />yiweD elxber y elqSer n ferεuwn elli ewmaθen n yuwsef usiynd. yefreH ferεuwn dixeddamen n elqeSres s edwiye elli slinti. <verse eid="GEN 45:16" /><verse number="17" style="v" sid="GEN 45:17" />yenne ferεuwn y yuwsef: «en y eyeθmex eεebben iγyelensen siyrδen usinc eδuwlen y elqeεεeθ n kenεan. <verse eid="GEN 45:17" /><verse number="18" style="v" sid="GEN 45:18" />taγδem daddeθwem delli ennewwem tesδem etweliyw taye δexennuwce elqeεεeθ tebhe egget g miSr bac eθečem seg elxireθes. <verse eid="GEN 45:18" /><verse number="19" style="v" sid="GEN 45:19" />θendasen zade: awyeθ iyδwem tikerriytin seg elqeεεeθ n miSr ettaγem δiysneθ idreriywwem delwacunewwem weθetwemc ettaγem daddeθwem iyδwem. <verse eid="GEN 45:19" /><verse number="20" style="v" sid="GEN 45:20" />weθendmemc f egliywwem elli δettedjem g elqeεεeθ n kenεan lexaTer elxiyraθ n elqeεεeθ n miSr elkul y xenyum.»<verse eid="GEN 45:20" /></para>
  <para style="s">arjeε y elqeεεeθ n kenεan</para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 45:21" />egen idrari n yeεquwb max i senyenne ferεuwn. yuceyasen yuwsef tikerriytin δelεwin y webriδ. <verse eid="GEN 45:21" /><verse number="22" style="v" sid="GEN 45:22" />yuwce ikul iyjen essisen elkesweθ ettejδiyt yemenni benyamiyn yucayes tlaθe myat δelfeTTeθ dxemse δelksawi. <verse eid="GEN 45:22" /><verse number="23" style="v" sid="GEN 45:23" />yazen y daddes εecre δiγyal εebben s elxiyraθ n miSr uεecre ettiγyal εebbaneθ δiyrδen dweγrum δelεwin y daddes g webriδ. <verse eid="GEN 45:23" /><verse number="24" style="v" sid="GEN 45:24" />welbeεδ yuzen eyeθmes δerewHen yemenni iweSSaθen yenneyasen: «erbellewwem eθemεarxem g webriδ.» <verse eid="GEN 45:24" /><verse number="25" style="v" sid="GEN 45:25" />efγen seg miSr egguwren δerewHen elmi δiwDen daddensen yeεquwb g elqeεεeθ n kenεan.<verse eid="GEN 45:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 45:26" />ennanes: «yuwsef elyuwc yedder unette eyendeγ elHakem n miSr elkul ture.» yettusemmer yeεquwb geθbuqεettes weligeddec eySeddeq δmat iyesle. <verse eid="GEN 45:26" /><verse number="27" style="v" sid="GEN 45:27" />welbeεδ ennanes δmat isenyenne yuwsef. umax i yezre yeεquwb tikerriytin elli yuzentent yuwsef bac eθewiyneθ y miSr, uzzelen iδammen g uδmes elmerreθ xlaf. <verse eid="GEN 45:27" /><verse number="28" style="v" sid="GEN 45:28" />yenneyasen: «neč yezziyi elli memmi yuwsef elyuwc yedder. neč exse emerqe eθenziyγ qebl n elli emmuwθe.»<verse eid="GEN 45:28" /></para>
  <chapter eid="GEN 45" />
  <chapter number="46" style="c" sid="GEN 46" />
  <para style="s">yeεquwb yerHel y miSr</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 46:1" />yerHel yeεquwb nette delli ennes delli γersen elkul umax i yiweD g biyr sebεe yeγres eDHeyyeθ y rebbis endaddes isHaq. <verse eid="GEN 46:1" /><verse number="2" style="v" sid="GEN 46:2" />yennayes rebbi δeggiyδ g elmnam: «yeεquwb! yeεquwb!» yerrayes yenne: «taye neč dah.» <verse eid="GEN 46:2" /><verse number="3" style="v" sid="GEN 46:3" />yen rebbi: «neč δrebbi, rebbi n daddex. eθukδc seg wemreq y miSr. neč δexerre cex didreriyx ettemuwreθ ettemeqqarθ. <verse eid="GEN 46:3" /><verse number="4" style="v" sid="GEN 46:4" />neč δemerqe iyδex y miSr uneč elli δexerre y temurθex uyuwsef δexiγemmeD tiTTewinex max eθemmuwθeδ.» <verse eid="GEN 46:4" /><verse number="5" style="v" sid="GEN 46:5" />yekker yeεquwb seg biyr sebεe. qamenti idreriys emmax i qamen idreriynsen δelwacunensen f eθkerriytin elli yuzentent ferεuwn bac e ntewyen. <verse eid="GEN 46:5" /><verse number="6" style="v" sid="GEN 46:6" />ewiyen iyδsen elhucensen delli exsbenti elkul g elqeεεeθ n kenεan emerqen elkulhum y miSr. <verse eid="GEN 46:6" /><verse number="7" style="v" sid="GEN 46:7" />yemreq nette didreriys didrari n idreriys dyessis dyessis n idreriys y miSr.<verse eid="GEN 46:7" /></para>
  <para style="s">idrari n yeεquwb</para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 46:8" />θiyhen δellisami n idrari n yeεquwb elli usiynd y miSr. yeεquwb didreriys, ruwban eyendeγ emenzu n yeεquwb.<verse eid="GEN 46:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 46:9" />wiyhen δidrari n ruwban: Henuwk, felluw dHeSruwn dkermiy. <verse eid="GEN 46:9" /><verse number="10" style="v" sid="GEN 46:10" />wiyhen δidrari n cemεuwn: yemaYiyl dyamiyn duwhed dyakiyn dSuwHer dcawuwl memmis n tekenεaniθ. <verse eid="GEN 46:10" /><verse number="11" style="v" sid="GEN 46:11" />wiyhen δidrari n lawiy: jircuwn dqehat dmerariy. <verse eid="GEN 46:11" /><verse number="12" style="v" sid="GEN 46:12" />wiyhen δidrari n yehuwδa: εiyr duwnan dciyla dfareS dzareH. yemmuwθ εiyr duwnan g elqeεεeθ n kenεan. yemenni idrari n fareS eyendeγ HeSruwn dHamuwl. <verse eid="GEN 46:12" /><verse number="13" style="v" sid="GEN 46:13" />wiyhen δidrari n yessaker: tuwlaε dfuwwe dyuwb dcemruwn. <verse eid="GEN 46:13" /><verse number="14" style="v" sid="GEN 46:14" />wiyhen δidrari n zebuwluwn: sarid diyluwn dyeHliyl. <verse eid="GEN 46:14" /><verse number="15" style="v" sid="GEN 46:15" />wiyhen δidrari n leyye elli tiruθen y yeεquwb g ijiyman n eram wiyδes yelliys diyna. unihnin elkulhum tlaθe wetleθiyn.<verse eid="GEN 46:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 46:16" />wiyhen δidrari n jad: Sefyuwn dHejji dcuwni deSbuwn dεiyri deruwdi deriyliy. <verse eid="GEN 46:16" /><verse number="17" style="v" sid="GEN 46:17" />wiyhen δidrari n eciyr: yemenna dyecwe dyecwi dberiyεe dweltmensen sareH. wiyhen δidrari n beriyεe: Habir dmelkiyyil. <verse eid="GEN 46:17" /><verse number="18" style="v" sid="GEN 46:18" />wiyhen δidrari n zelfeh elli yuwcit laban y yelliys leyye. unihnin elkulhum settac.<verse eid="GEN 46:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 46:19" />idrari n raHiyl liwec n yeεquwb: yuwsef dbenyamiyn. <verse eid="GEN 46:19" /><verse number="20" style="v" sid="GEN 46:20" />yuwγeδ yuwsef: menesse defrayim g miSr. tirwasθen esnat yelliys n fuwTiyfar elkahen ennuwn. <verse eid="GEN 46:20" /><verse number="21" style="v" sid="GEN 46:21" />wiyhen δidrari n benyamiyn: baleε dbaker decbiyl djiyra dneεman diyHi druwc dmuffiym dHuffiym derd. <verse eid="GEN 46:21" /><verse number="22" style="v" sid="GEN 46:22" />wiyhen δidrari n yeεquwb seg raHiyl: unihnin elkulhum erbeεtac.<verse eid="GEN 46:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 46:23" />uHuwciym eyendeγ memmis n dan. <verse eid="GEN 46:23" /><verse number="24" style="v" sid="GEN 46:24" />wiyhen δidrari enneftaliy: yeHSayil djuwni dyeSr dcelliym. <verse eid="GEN 46:24" /><verse number="25" style="v" sid="GEN 46:25" />wiyhen δidrari n yeεquwb elli tirwasθen belheh texeddamt n raHiyl elli yuwcit daddes laban y yelliys. unihnin elkulhum sebεe.<verse eid="GEN 46:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 46:26" />tiweD elεiyleθ n yeεquwb elli temreq y miSr sette usettiyn menγiyr elwacun n idreriys. <verse eid="GEN 46:26" /><verse number="27" style="v" sid="GEN 46:27" />uyuwsef yuwγeδ g miSr sen δidrari usah tiweD elεiyleθ n yeεquwb elli temreq y miSr sebεiyn.<verse eid="GEN 46:27" /></para>
  <para style="s">yuwsef dyeεquwb emlaqen</para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 46:28" />yuzen yeεquwb yehuwδa qebles y yuwsef bac e ntilaqe g elqeεεeθ n jasan. <verse eid="GEN 46:28" /><verse number="29" style="v" sid="GEN 46:29" />umax i DiwDen yerkeb yuwsef f eθkerrittes yemreq δeyeεreδ daddes g jasan. umax i θyezre yeqqiym elberceθ iθerw unihnin emγemmren. <verse eid="GEN 46:29" /><verse number="30" style="v" sid="GEN 46:30" />yenne yeεquwb y yuwsef: «edj emmuwθe ture beεδ izriyγ uδmex ucex eltuciyδ θeddereδ.»<verse eid="GEN 46:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 46:31" />yenne yuwsef y ewmeθnes delbaqi n elεiyleθ n daddes, «neč δemerqe ture y ferεuwn bac e senne, ewmeθniyw delεiyleθ n dadde elkul elli kanen εmeren g elqeεεeθ n kenεan useδen etweliyw. <verse eid="GEN 46:31" /><verse number="32" style="v" sid="GEN 46:32" />unihnin δessurraH n esεi uγersen elhuwc egget. nihnin uγiynd esεiynsen difunesnensen delli γersen elkul. <verse eid="GEN 46:32" /><verse number="33" style="v" sid="GEN 46:33" />elweqθelli exenynabe ferεuwn usinc exenyenceδ &lt;δmat iθxedmem?&gt; <verse eid="GEN 46:33" /><verse number="34" style="v" sid="GEN 46:34" />enmes, ixeddemnex δessurraH n esεi s elli δimezyanen elture. nečin dmidnenne. usahen ykan daddeθne dbabeθne. bac e θeεmreδ g elqeεεeθ n jasan lexaTer imiSriyyen Heqren essurreH n esεi.»<verse eid="GEN 46:34" /></para>
  <chapter eid="GEN 46" />
  <chapter number="47" style="c" sid="GEN 47" />
  <para style="s">yuwsef eyeHDer γer ferεuwn</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 47:1" />ibed yuwsef ezzaθ n ferεuwn yennes: «rahu dadde dewmeθniyw usiynd seg kenεan nihnin desεiynsen delhucensen delli γersen elkul g elqeεεeθ n kenεan. unihnin ture g elqeεεeθ n jasan.» <verse eid="GEN 47:1" /><verse number="2" style="v" sid="GEN 47:2" />yiwi xemse s ewmeθnes iyδes ysexniyn y ferεuwn. <verse eid="GEN 47:2" /><verse number="3" style="v" sid="GEN 47:3" />yenceδten ferεuwn yenneyasen: «δmat iθxedmem?» ennanes: «nečin ddaddeθne dbabeθne δessurraH n esεi. <verse eid="GEN 47:3" /><verse number="4" style="v" sid="GEN 47:4" />unuseδ δeneθγerreb dah lexaTer esεiynne elyufiyc δmat δeyeč g elqeεεeθ n kenεan s ezzemmeθ. edjane eneεmer dah g elqeεεeθ n jasan.» <verse eid="GEN 47:4" /><verse number="5" style="v" sid="GEN 47:5" />yenne ferεuwn y yuwsef: «daddex dewmeθnex useδnex, <verse eid="GEN 47:5" /><verse number="6" style="v" sid="GEN 47:6" />welqeεεeθ n miSr elkul ezzeθex, HuT daddex dewmeθnex g elqeεεeθ tebehhayθ. edjin eεemren g elqeεεeθ n jasan. wiδekan δiysen δ wiyn egget etgedden egiyn δerruwyyes f essurraH n esεi.»<verse eid="GEN 47:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 47:7" />welbeεδ yuwγeδ yuwsef daddes yeεquwb yesbeddi ezzaθ n ferεuwn. elweqθes ibarex yeεquwb ferεuwn. <verse eid="GEN 47:7" /><verse number="8" style="v" sid="GEN 47:8" />yenceδ ferεuwn yeεquwb yennayes: «menyeθ elεemrex?» <verse eid="GEN 47:8" /><verse number="9" style="v" sid="GEN 47:9" />yerrayes yeεquwb yenne: «yiweD elεemriyw miyye utleθiyn εam, δruws yemenni eεyiyγ uneč elliwiDexc elεmer n lejdediyw.» <verse eid="GEN 47:9" /><verse number="10" style="v" sid="GEN 47:10" />welbeεδ ybarex yeεquwb ferεuwn yeffeγ f imenes. <verse eid="GEN 47:10" /><verse number="11" style="v" sid="GEN 47:11" />yseεmer yuwsef daddes dewmeθnes g miSr yerni yuceyasen elqeεεeθ tebehhayθ g reεemsis max i syenne ferεuwn <verse eid="GEN 47:11" /><verse number="12" style="v" sid="GEN 47:12" />yeqqiym yuwsef iθuč g weče ydaddes dewmeθnes dleεbaδ n elHuwc n daddes f elεδeδ n idreriynsen.<verse eid="GEN 47:12" /></para>
  <para style="s">yuwsef eyeg elxutteθ n wezreε</para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 47:13" />yuqe eγrum g temuwreθ elkul s elez. elqeεεeθ n miSr delqeεεeθ n kenεan tewwettent elmejaεeθ. <verse eid="GEN 47:13" /><verse number="14" style="v" sid="GEN 47:14" />izenz yuwsef iyrδen s elfeTTeθ elli tkan g temuwreθ n miSr ettemuwreθ n kenεan welbeεδ yiwit y elxziyneθ n ferεuwn. <verse eid="GEN 47:14" /><verse number="15" style="v" sid="GEN 47:15" />elweqθelli tuqe elfeTTeθ seg θemuwreθ n miSr ettemuwreθ n kenεan usiynd imiSriyyen elkul y yuwsef ennanes: «uwcane eγrum, imat exentedjeδ enemmuwθ ezzaθ n tiTTewinex? rahu elfeTθenne tuqe.» <verse eid="GEN 47:15" /><verse number="16" style="v" sid="GEN 47:16" />yenneyasen: «max i θuqe elfeTθewwem, eγδeθ esεiywwem exennuwce g elεuDes eče.» <verse eid="GEN 47:16" /><verse number="17" style="v" sid="GEN 47:17" />yaxi emreqen uγiynd esεiynsen. yzenzasen yuwsef eγrum yawi elHeqqes δelHSenne desεi difunasen diγyal. g usukkesdiyn zenzen leεbaδ esεiynsen elkul f elxaĎer n weγrum. <verse eid="GEN 47:17" /><verse number="18" style="v" sid="GEN 47:18" />max i yuqe esukkesdiyn, useδnes g usukkesdiyn elli beεδes ennanes: «nečin enHerrezc fellex. rahu elfeTθenne tuqe wesεinne dezwaylenne enzenzexθen ture welyeqqiym γenne kan δlebδenenne dijiymenenne. <verse eid="GEN 47:18" /><verse number="19" style="v" sid="GEN 47:19" />taye nečin delqeεθenne ezzeθex γiyr exentedjec enemmuwθ. uwcane eγrum tewiδane nečin delqeεθenne usinc eneδwel nečin delqeεθenne δixeddamen y ferεuwn. uwcane ezzerriyεeθ etnezzu bac e nedder wentmettiyc weltxelliyc elqeεθenne.»<verse eid="GEN 47:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 47:20" />ekehew yesγe yuwsef y ferεuwn elqeεεeθ n miSr elkul lexaTer imiSriyyen elkul zenzen ijimenensen s ezzemmeθ elli tewwetten. elweqθes teδwel elqeεεeθ n miSr elkul y ferεuwn. <verse eid="GEN 47:20" /><verse number="21" style="v" sid="GEN 47:21" />welbeεδ yuwγeδ leεbaδ seg eθbuqεaθin n miSr elkul yejmelten g timuwre timeqqarin. <verse eid="GEN 47:21" /><verse number="22" style="v" sid="GEN 47:22" />yemenni elyesγiyc elqeεεeθ n elkuhhan lexeTerhum kanen tetten s elbay n weče elli yθučasen δiys ferεuwn. welkuhhan elzenzenc elqeεθensen zade. <verse eid="GEN 47:22" /><verse number="23" style="v" sid="GEN 47:23" />welbeεδ yenne yuwsef y leεbaδ elkul: «taye esγiγawem asse xenyum delqeεθewwem. teδwlem elkulkum δixeddamen n ferεuwn. awyeθ ezzerriyεeθe bac e ttezwem g ijiyman. <verse eid="GEN 47:23" /><verse number="24" style="v" sid="GEN 47:24" />ugelweqθ n wamjer uwceθ y ferεuwn elbay tedjem y xenyum erbεe δelbeyeθ δezzerriyεeθ y ijiyman uδeče y xenyum dleHwecewwem didreriywwem.» <verse eid="GEN 47:24" /><verse number="25" style="v" sid="GEN 47:25" />ennanes: «cex eθmenneεδane seg temettent. besTe erDe fellane unečin eneδwel δixeddamen n ferεuwn.» <verse eid="GEN 47:25" /><verse number="26" style="v" sid="GEN 47:26" />s elweqθes elture yege yuwsef elbay n elxums g elqeεεeθ n miSr y ferεuwn kan δelqeεεeθ n elkuhhan ettuč yferεuwn.<verse eid="GEN 47:26" /></para>
  <para style="s">elwSayeθ n yeεquwb qebl n temettentes</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 47:27" />eyendeγ yeεmer yeεquwb didreriys g elqeεεeθ n jasan emelxen diyn arwen exeθren zade. <verse eid="GEN 47:27" /><verse number="28" style="v" sid="GEN 47:28" />yedder yeεquwb sebeεtac n εam g miSr elmi yiweD elεemres miyye usebεe werbεiyn. <verse eid="GEN 47:28" /><verse number="29" style="v" sid="GEN 47:29" />max i dyuwse δeyemmuwθ inabe y memmis yuwsef yennes: «iδekanek δerraDi felle, HuT efusex seddu elfexδiyw, tedjuwlleδ elli eyeθreδmec g miSr. <verse eid="GEN 47:29" /><verse number="30" style="v" sid="GEN 47:30" />yemenni HuTTi g eljneb n midniyw. awyi seg miSr terδemδi g eθjebbentensen.» yenne: «neč δege max i θenniyδ.» <verse eid="GEN 47:30" /><verse number="31" style="v" sid="GEN 47:31" />yemenni yeεquwb yennayes: «edjul.» yedjul yuwsef, yerkeε yeεquwb f iyxef n esriyr iHemmeδ g rebbi.<verse eid="GEN 47:31" /></para>
  <chapter eid="GEN 47" />
  <chapter number="48" style="c" sid="GEN 48" />
  <para style="s">yeεquwb eybarex idrari n yuwsef</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 48:1" />beεδ liyyameθ xlaf ennanes y yuwsef: «daddex δmaDun.» yawi yuwsef idreriys essenniyn menesse defrayim iyδes yemreq. <verse eid="GEN 48:1" /><verse number="2" style="v" sid="GEN 48:2" />ennan y yeεquwb: «memmiyx yuwsef yuseδex.» yeθHemmel eTTen yekker yeqqiym f esriyr. <verse eid="GEN 48:2" /><verse number="3" style="v" sid="GEN 48:3" />yenne yeεquwb y yuwsef: «rahu rebbi yeθheyYiyδ g luwz g elqeεεeθ n kenεan wibarxi. <verse eid="GEN 48:3" /><verse number="4" style="v" sid="GEN 48:4" />ubeεδ yennayi, taye δesexeθre ezzerriεθex usinc esuwfγe s iδemnex leεbaδ egget usinc eδuwce y idreriyx elqeεεeθe θahen diyme. <verse eid="GEN 48:4" /><verse number="5" style="v" sid="GEN 48:5" />uture, mani idreriyx efrayim dmenesse elli tirwetten g miSr qebl n elli exeddase nihnin δidreriyw uδeyyuwrθen emruwban dcemεuwn. <verse eid="GEN 48:5" /><verse number="6" style="v" sid="GEN 48:6" />yemenni idreriyx elli δentarweδ beεδ iyhen, emmeHsben δidreriyx cex weHδex. usinc eδuwrθen ewmeθnensen menesse defrayim. <verse eid="GEN 48:6" /><verse number="7" style="v" sid="GEN 48:7" />lexaTer elweqθelli neč rajeε s ijiyman n aram θemmuwθ raHiyl g elqeεεeθ n kenεan g webriδ ezzaθ n efrat. elweqθes erδmext diyn g webriδ elli yettawi y efrat elli etsemmanteθ ture &lt;biytleHm&gt;»<verse eid="GEN 48:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 48:8" />yenzi yeεquwb y idrari n yuwsef welbeεδ yenceδti: «δ wiyn iyhen?» <verse eid="GEN 48:8" /><verse number="9" style="v" sid="GEN 48:9" />yennayes yuwsef: «nihnin δidreriyw elli yuceyiyθen rebbi dah.» yenne yeεquwb: «esqerrebθen etweliyw entbarxe.» <verse eid="GEN 48:9" /><verse number="10" style="v" sid="GEN 48:10" />elweqθes ebδaneθ TiTTawin n yeεquwb eεyaneθ s elkber ulitgeddec eyenzi belgde. yeg sah yuwsef yqerrebθen etweliys, ykubbin yeεquwb yγemmerθen. <verse eid="GEN 48:10" /><verse number="11" style="v" sid="GEN 48:11" />welbeεδ yenne yeεquwb yyuwsef: «etεilekexc elli δedyes as usinc exezreγ yemenni rebbi isexni idreriyx zade.»<verse eid="GEN 48:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 48:12" />welbeεδ ysikkerθen yuwsef s elεeb n daddes yerkeε nette ezzeθes f elqeεεeθ. <verse eid="GEN 48:12" /><verse number="13" style="v" sid="GEN 48:13" />yeTTef yuwsef efrayim s elymines yesbeddi f elysar n yeεquwb welbeεδ yeTTef menesse s elyseres yesbeddi f elymiyn n yeεquwb. <verse eid="GEN 48:13" /><verse number="14" style="v" sid="GEN 48:14" />yemenni yezzel yeεquwb ifesnes δimxalfen belεani iHuT y elimines f iyxef n efrayim emezyen welyseres iHuTTiθ f iyxef n menesse emenzu. <verse eid="GEN 48:14" /><verse number="15" style="v" sid="GEN 48:15" />ibarex yuwsef yenne: «rebbi elli Ďewεenti lejδeδiyw ibrahiym disHaq, rebbi elli yettelhe essi s elli emmarwe elwasse, <verse eid="GEN 48:15" /><verse number="16" style="v" sid="GEN 48:16" />rebbi elli imenεi s elmlax seg timuHacin elkul, δeybarex idreriye lessenniyn. esemmen f ellesmiyw dellesm n lejdediyw ibrahiym disHaq usinc entisexθer g elqeεεeθ egget.»<verse eid="GEN 48:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 48:17" />yemenni yuwsef eθyeεjiybc elli daddes iHuT efuses n elymiyn f iyxef n efrayim. elweqθes yeTTef afus n daddes δettibeddel s iyxef n efrayim y iyxef n menesse. <verse eid="GEN 48:17" /><verse number="18" style="v" sid="GEN 48:18" />yenne yuwsef y daddes: «eθegec sah edadde. rahu wahen eyendeγ emenzu. HuT efusex n elymiyn f ixfes.» <verse eid="GEN 48:18" /><verse number="19" style="v" sid="GEN 48:19" />yemenni daddes elyeqqiylc yen: «neč essene wah ememmiy. neč essene Hette δwahen. δeyeδwel ettemuwreθ ettemeqqarθ yemenni yuwwes emezyen δeyeδwel ekebres widreriys δeδuwlen ettemuwreθ ettemeqqarθ egget.»<verse eid="GEN 48:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 48:20" />ybarexθen yeεquwb esses yen: «xenyum δeθexeθrem egget, uleεbaδ δeδuwlen eqqaren &lt;rebbi exyer emefrayim dmenesse.&gt;» usahen ysebbeq yeεquwb efrayim f menesse. <verse eid="GEN 48:20" /><verse number="21" style="v" sid="GEN 48:21" />welbeεδ yenne yeεquwb y yuwsef: «neč qriyb emmuwθe yemenni rebbi δeyeqqiym iyδwem usinc δexenyer yelqeεεeθ n midnewwem. <verse eid="GEN 48:21" /><verse number="22" style="v" sid="GEN 48:22" />utaye neč uciyγex elbay n elqeεεeθ δezzayeδ f ewmeθnex. iwyexθi s essifiyw delqusiyw seg imuwriyyen.»<verse eid="GEN 48:22" /></para>
  <chapter eid="GEN 48" />
  <chapter number="49" style="c" sid="GEN 49" />
  <para style="s">elberxeθ n yeεquwb</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 49:1" />inabe yeεquwb y idreriys welbeεδ yenneyasen: «asδeθ etweliyw exennenne δmat δexenyejre g edduniθewwem. <verse eid="GEN 49:1" /><verse number="2" style="v" sid="GEN 49:2" />lemδeθ imenewwem teslem ha y idrari n yeεquwb, esleθ y daddeθwem yeεquwb. <verse eid="GEN 49:2" /><verse number="3" style="v" sid="GEN 49:3" />ruwban cex memmi emezwar. cex elqewθiyw. essix bane δeryaz ezzaθ n leεbaδ. δeθeqqiymeδ teεliyδ welqeδrex exθer n iddiyn. <verse eid="GEN 49:3" /><verse number="4" style="v" sid="GEN 49:4" />yemenni maδamek emwamen eθheddreδ eltγelbec diyme lexaTrek θezniyδ dzelfeh liweciyw g esririyw. <verse eid="GEN 49:4" /><verse number="5" style="v" sid="GEN 49:5" />cemεuwn dlawi δewmaθen teĎlemem s lesyufennum leεbaδ. <verse eid="GEN 49:5" /><verse number="6" style="v" sid="GEN 49:6" />ha yeεquwb! eθeδfec yelmejles n erδiltensen weθemrqec meni itqiymen. lexaTer max i θγeccecen enγiyn eryaz welqulli tiraren s ezeHfen efunes. <verse eid="GEN 49:6" /><verse number="7" style="v" sid="GEN 49:7" />elleεneθ f elγuccensen lexaTer yuwHec witDur. entbeεδe f beεDhum g temuwreθ n yeεquwb usinc entferqe zade f beεDhum g temuwreθ n israYiyl. <verse eid="GEN 49:7" /><verse number="8" style="v" sid="GEN 49:8" />yehuwδa, ewmeθnex etqeddernex egget widrari n daddex δexerkεen icex lexaTer essifex diyme f texrumt n elεδewwex. <verse eid="GEN 49:8" /><verse number="9" style="v" sid="GEN 49:9" />yehuwδa δmemmis n uyerniz. f elfrisθex tekkereδ ha memmi, welbeεδ tesbeleδ tenεseδ emuyerniz. δ wiyn eyged exyHareb? <verse eid="GEN 49:9" /><verse number="10" style="v" sid="GEN 49:10" />elHukmeθ δeθeqqiym diyme g ifassen n yehuwδa elmedyes ciyluh elli δeθĎewεen leεbaδ egget. <verse eid="GEN 49:10" /><verse number="11" style="v" sid="GEN 49:11" />uδeyeqqen eγyules g eθεenbeyθ usinc eyeqqen ejjeHces g eθεenbeyθ tebehhayθ. s ecrab eysiyreδ edbeces useg wamen n elεneb eysiyreδ imeryeles. <verse eid="GEN 49:11" /><verse number="12" style="v" sid="GEN 49:12" />tiTTewines ettizukkaγin emecrab wisennuqnes δimellalen emelHliyb.<verse eid="GEN 49:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 49:13" />cex zebuwluwn δeθeεmreδ g eccafeθ n iylel. etweliyx δeddesneθ tifluwkin bac e rθaHneθ. δeθezleδ ifesnex elmeδewδen Seyda. <verse eid="GEN 49:13" /><verse number="14" style="v" sid="GEN 49:14" />yessaker δeγyuwl yeqwe yesbel g elkuwri. <verse eid="GEN 49:14" /><verse number="15" style="v" sid="GEN 49:15" />max eyzer eSSabeθ n elqeεθes tebhe eyεerreD exrumes yuqami n eδqel usinc eyeδwel δelεebδ n elxeδmeθ bessiyf. <verse eid="GEN 49:15" /><verse number="16" style="v" sid="GEN 49:16" />dan δelqaDi f ecceεbes emiyjin seg leεruwc n israYiyl. <verse eid="GEN 49:16" /><verse number="17" style="v" sid="GEN 49:17" />dan δetεaben g eccafeθ n webriδ wettelefse g elmesreb eθenber eεerqub n elHSan bac e ssender errekbes eldeffer. <verse eid="GEN 49:17" /><verse number="18" style="v" sid="GEN 49:18" />neč etrajiyγ δiyx, ha rebbi bac e yeθmenεeδ. <verse eid="GEN 49:18" /><verse number="19" style="v" sid="GEN 49:19" />jad, δeγaren felles leεδas, yemenni δentyeγleb usinc entiHaSer. <verse eid="GEN 49:19" /><verse number="20" style="v" sid="GEN 49:20" />eče n eciyr yebhe wexsenti elHukkam egget. <verse eid="GEN 49:20" /><verse number="21" style="v" sid="GEN 49:21" />n eftali etteγzelt ettimseyyebθ eθaru ezzerriyεeθ tebhe. <verse eid="GEN 49:21" /><verse number="22" style="v" sid="GEN 49:22" />yuwsef emteεenbeyθ temmezzu g eljneb n tiT n wamen, etteεenbeyθ ettaru egget uleεrefes uliyen f elHiyĎ. <verse eid="GEN 49:22" /><verse number="23" style="v" sid="GEN 49:23" />leεδas exsen eθenγen unihnin diyme ečaθen δiys s elγuc. <verse eid="GEN 49:23" /><verse number="24" style="v" sid="GEN 49:24" />yemenni iγelnes δeqqiymen emmezlen ezzaθ n leεδas uδeyerni eyeqwe lexaTer elquδreθ n rebbi n yeεquwb iyδes uδeyeδwel δeniylti uδelHegfeθ n israYiyl. <verse eid="GEN 49:24" /><verse number="25" style="v" sid="GEN 49:25" />rebbi δexibarex uδexyuwc amzer s ujenne wamen s isaffen usinc δeyerni eybarex ezzerriεθex. <verse eid="GEN 49:25" /><verse number="26" style="v" sid="GEN 49:26" />elberxeθ n daddex eεle n edhari uxiyr n eddunyeθ. elberxeθ θahen elkul δeθeggez f yuwsef, yuwsef eSSaleH g ewmeθnes. <verse eid="GEN 49:26" /><verse number="27" style="v" sid="GEN 49:27" />benyamiyn δuccen yuεer, talji eyeč eDHeyθes uδeggiyδ ettiyzun.»<verse eid="GEN 49:27" /></para>
  <para style="s">elwSayeθ n yeεquwb ettemettentes</para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 49:28" />iyhen elkulhum eyendeγ elHukkam leθnac egli n israYiyl. uwahen eyendeγ edwi elli yenneyesenti daddensen wibarexθen essis. ukul iyjen ibarexθi max i yettesθahel. <verse eid="GEN 49:28" /><verse number="29" style="v" sid="GEN 49:29" />welbeεδ iweSSaθen yenneyasen: «neč qriyb erewHe y midniyw. erδemmi g eljenbensen g weHric n ujiymi n εefruwn elHeθθi. <verse eid="GEN 49:29" /><verse number="30" style="v" sid="GEN 49:30" />elli g ujiymi n elmekfiyle elli tqabel memra g elqeεεeθ n kenεan. elmraH elli y esγi ibrahiym nette n ujiymi seg εefruwn elHeθθi bac e yeδwel ettejebbent n elεiyleθ. <verse eid="GEN 49:30" /><verse number="31" style="v" sid="GEN 49:31" />δiys yemmerδem ibrahiym dliweces sarreh welbeεδ isHaq dliweces rifqeh uzade erδeme diyn leyye. <verse eid="GEN 49:31" /><verse number="32" style="v" sid="GEN 49:32" />uyesγe ibrahiym ejiymi delmraH elli δiys seg iHeθθiyyen.»<verse eid="GEN 49:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 49:33" />max i ykemmel yeεquwb seg eweSSi n idreriys yemmezzel f esriyr, yeg sah ilemmeδ ikreεnes ibeεDhum tali erruHes yexleδ f midnes.<verse eid="GEN 49:33" /></para>
  <chapter eid="GEN 49" />
  <chapter number="50" style="c" sid="GEN 50" />
  <para style="s">eznazeθ n yeεquwb dedfintes</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 50:1" />yeHδef yuwsef imenes f daddes yeqqiym iθerw yetkub δiys. <verse eid="GEN 50:1" /><verse number="2" style="v" sid="GEN 50:2" />welbeεδ yufley yuwsef yixeddemnes iĎbiyben bac e sHenĎen daddes. <verse eid="GEN 50:2" /><verse number="3" style="v" sid="GEN 50:3" />ekehew eqqiymen etHenĎen δiys erbεiyn yuwm elmi kemlen. eqqiymen imiSriyyen terwen felles sebεiyn yuwm. <verse eid="GEN 50:3" /><verse number="4" style="v" sid="GEN 50:4" />umax i δuwqen liyyam n ukezzem yenne yuwsef y elHuwc n ferεuwn: «iδekan texsmi belHeq uflayeθ y ferεuwn tenmes, <verse eid="GEN 50:4" /><verse number="5" style="v" sid="GEN 50:5" />rahu dadde yesθedjuwlli uyenne, neč qriyb emmuwθe werδmi g wenil elli eHfrexθi y imeniyw g elqeεεeθ n kenεan. edji emerqe ereδme dadde welbeεδ eδuwle.» <verse eid="GEN 50:5" /><verse number="6" style="v" sid="GEN 50:6" />yenne ferεuwn: «emreq terδmeδ daddex max i yesθedjuwllex.» <verse eid="GEN 50:6" /><verse number="7" style="v" sid="GEN 50:7" />ubeεεeδ yemreq yuwsef δeyerδem daddes. yemreq iyδes elHuwc n ferεuwn elkul dleεbaδ imeqqaren n miSr. <verse eid="GEN 50:7" /><verse number="8" style="v" sid="GEN 50:8" />emreqen iyδes leεyeles zade ewmeθnes dleεyelensen delHuwc n daddes. welledjiyn δefrensen g elqeεεeθ n jasan kan δidreriynsen desεiynsen. <verse eid="GEN 50:8" /><verse number="9" style="v" sid="GEN 50:9" />emreqneθ iyδes tikerriytin s elεesker dixeyyalen eglinsneθ elmi iδuwlen emeljiyc. <verse eid="GEN 50:9" /><verse number="10" style="v" sid="GEN 50:10" />umax i DiwDen ibeyder n eTad g eljneb n eccerq n wesuwf n elurdun eruwiyn felles egget uyegayes yuwsef eznazeθ edzuwγeb. eqqiymen etnewHen felles sebεe eyyam. <verse eid="GEN 50:10" /><verse number="11" style="v" sid="GEN 50:11" />umax i zriyn ikenεaniyyen elli εmeren diyn eznazeθ g beyder n eTad ennan: «eznazeθe temeqqarθ θahen δegli n imiSriyyen.» heδake εlac semman elqeεεeθ elli g eljneb n elurdun &lt;miSrayim&gt;. (meεnahe eznazeθ n imiSriyyen.) <verse eid="GEN 50:11" /><verse number="12" style="v" sid="GEN 50:12" />usahen egiyn idrari n yeεquwb max i ntiweSSe daddensen. <verse eid="GEN 50:12" /><verse number="13" style="v" sid="GEN 50:13" />iwyenti y elqeεεeθ n kenεan welbeεδ erδmenti g elmraH n ujiymi n elmekfiyle elli iqabel memra welli yesγi ibrahiym n ette dujiymi n εefruwn elHeθθi bac e θeδwel ettejebbent n elεiyleθ. <verse eid="GEN 50:13" /><verse number="14" style="v" sid="GEN 50:14" />ubeεδ iyerδem yuwsef daddes, yeδwel nette dewmeθnes delli mreqen iyδsen elkul y miSr.<verse eid="GEN 50:14" /></para>
  <para style="s">temettent n yuwsef</para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 50:15" />umax i zriyn ewmaθen n yuwsef elli daddensen yemmuwθ ennan: «belekc yuwsef yebδe ykerreh δiyne ture usinc exenyer temeεfunt elli negeyast qebl.» <verse eid="GEN 50:15" /><verse number="16" style="v" sid="GEN 50:16" />welbeεδ uzennes emersul ennanes: «daddex yweSSe qebl eyemmuwθ yenne, <verse eid="GEN 50:16" /><verse number="17" style="v" sid="GEN 50:17" />sah enneθ y yuwsef, sameH eyeθmex f eδnubensen delγelTensen lexaTer nihnin eginex θemuwHacθ. uture sameH ixeddamen n rebbis n daddex f elγelTTensen.» max i yiweD edwiye y yuwsef yekker iθerw. <verse eid="GEN 50:17" /><verse number="18" style="v" sid="GEN 50:18" />esδen ewmeθnes erkεen ezzeθes ennen: «rahu nečin δixeddemnex.» <verse eid="GEN 50:18" /><verse number="19" style="v" sid="GEN 50:19" />yemenni yenneyasen: «eθukδemc yaxi neč δrebbi? <verse eid="GEN 50:19" /><verse number="20" style="v" sid="GEN 50:20" />xenyum θenwami eccer, yemenni rebbi yerre eccer δelxiyr bac e yeg δmat iyejre asse usinc eysedder leεbaδ egget. <verse eid="GEN 50:20" /><verse number="21" style="v" sid="GEN 50:21" />eθukδemc rahu neč δexenεawen xenyum didreriywwem.» yεezzaθen yTeyyeb elxeĎrensen. <verse eid="GEN 50:21" /><verse number="22" style="v" sid="GEN 50:22" />yeεmer yuwsef g miSr nette delHuwc n daddes. yedder yuwsef miyye uεecre sniyn <verse eid="GEN 50:22" /><verse number="23" style="v" sid="GEN 50:23" />elmi yezre idrari n idrari n efrayim didrari zade n makiyr memmis n menesse elli yγemmerθen yessuδefθen g elwerθes emidreriys max i mmarwen. <verse eid="GEN 50:23" /><verse number="24" style="v" sid="GEN 50:24" />yenne yuwsef yewmeθnes: «neč qriyb emmuwθe yemenni rahu rebbi δexenyesfekker usinc exenysuwfeγ seg elqeεεeθe welbeεδ δexenyer yelqeεεeθ elli yedjul δetyuc y ibrahiym disHaq dyeεquwb.» <verse eid="GEN 50:24" /><verse number="25" style="v" sid="GEN 50:25" />yufley yuwsef y idrari n yeεquwb yenneyasen: «edjulmi elqulli exenyesfekker rebbi usinc exenyazen ytemuwreθ xlaf eθawyem iγSeniyw iyδwem.» <verse eid="GEN 50:25" /><verse number="26" style="v" sid="GEN 50:26" />yemmuwθ yuwsef max i yiweD elεemres miyye uεecre sniyn. HenĎenti welbeεδ HuTTenti g ettabuwt g miSr.<verse eid="GEN 50:26" /></para>
  <chapter eid="GEN 50" />
</usx>