<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="3JN" style="id" />
  <para style="h">3 John</para>
  <para style="toc1">eljwab eθθaliθ n yuwHenne</para>
  <para style="toc2">3Jhn</para>
  <para style="toc3">3JN</para>
  <para style="mt1">eljwab eθθaliθ n yuwHenne</para>
  <para style="ip">elγerD: emdaH n γayus f eDyefθes y iγriyben, d ecejεes g leHyeθes tebehheyθ g elmesiyH elli yuri: emersal yuHenne. elli yemmeryasen: y γayus elli nette δ iyjen seg elli emmesnen g icθ seg elknayes elli emmesneθ y yuHenne. esbeb n tires: kanen elquyyaδ n elkeniseθ etHewlen seg temuwreθ y temuwreθ bac agen elknayes δ tijδiyδin, w etεemlen f eDyafeθ n ewmeθnensen imumnen g lemdendiyn. w ykan γayus yferreH s ewmaθen elkul g elHuces.</para>
  <chapter number="1" style="c" sid="3JN 1" />
  <para style="s">etteHiyyeθ</para>
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1" />s γeri neč emeqqar y γayus eHbiyb elli exsexθi g elHeq. <verse eid="3JN 1:1" /><verse number="2" style="v" sid="3JN 1:2" />a eHbiyb, etteθmenniyγ eθkuwneδ lebas g kul ciy, m eSSeHHeθ n elbδen d eSSeHHeθ n erruwH. <verse eid="3JN 1:2" /><verse number="3" style="v" sid="3JN 1:3" />w geddac iysefreH max i ddusiyn lebHaD n ewmaθen ecehδen elli cex cedd g elHeq w θegguwreδ g ebriδes. <verse eid="3JN 1:3" /><verse number="4" style="v" sid="3JN 1:4" />w eHebbe ciy eyyessefreH exθer n elli esle elli edreriyw egguwren g webriδ n elHeq.<verse eid="3JN 1:4" /></para>
  <para style="s">ecxar n γayus</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5" />a eHbiyb, cex δ eθθiyqeθ g kul ciy ettegeδ δiys f elxaĎer n ewmaθen Hette iδekanhum δ iγriyben, <verse eid="3JN 1:5" /><verse number="6" style="v" sid="3JN 1:6" />w nihnin echeδen γer elkeniyseθ s elmHebθex d elxiyr. yelzm entεewneδ f eθbaε n ebriδensen s elli eysefreH rebbi <verse eid="3JN 1:6" /><verse number="7" style="v" sid="3JN 1:7" />εlexaTerhum effeγen y esafer f elxaĎer n ellesm n elmesiyH w elleqbiylen Hette ciy seg elli muc δ imumnen. <verse eid="3JN 1:7" /><verse number="8" style="v" sid="3JN 1:8" />w yelzemne nečin enefreH s elli m iyh bac e nkuwn δ icrixnensen g elxeδmeθ n elHeq.<verse eid="3JN 1:8" /></para>
  <para style="s">dyuwtriyfes diymetryuws</para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9" />wriye θuθleyθ y elkeniyseθ, yemenni dyuwtriyfus elli yexs eykuwn δ errayes δiysen, liqebbelc edwinne. <verse eid="3JN 1:9" /><verse number="10" style="v" sid="3JN 1:10" />w iδekan wsiγd, ture exennenne mat iyege w max i yeqqar fellane g edwi yuHec. wah elkul eθyezzic, yemenni liqebbelc ewmeθnenne w elyedjic elli exsen entqeblen w yetgelleb δiysen seg elkeniyseθ. <verse eid="3JN 1:10" /><verse number="11" style="v" sid="3JN 1:11" />ha eShiyb eθeθbεec eccer. yemenni eθbeε elxiyr. elli ayeg elxiyr rahu seg rebbi, w elli ayeg eccer elyessinc rebbi. <verse eid="3JN 1:11" /><verse number="12" style="v" sid="3JN 1:12" />yemenni diymetryuws, leεbaδ elkul esechδen. Hette δ elHeq biyδe esyecheδ. w nečin zade esnecheδ, w cex θesseneδ elli echeδtenne δ teSSadeqθ.<verse eid="3JN 1:12" /></para>
  <para style="s">elxatmeθ</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13" />γeri egget δ edwi exse exettenne, yemenni elγisexc δeykuwn s elqlem d elHbar. <verse eid="3JN 1:13" /><verse number="14" style="v" sid="3JN 1:14" />w etteθmenniyγ exezre εla qriyb, usinc eneHke uwδem y uwδem. <verse eid="3JN 1:14" /><verse number="15" style="v" sid="3JN 1:15" />eslam fellax. etselmen fellax leHbebex. sellem cex f kul iyjen seg leHbab, iyjen s iyjen.<verse eid="3JN 1:15" /></para>
  <chapter eid="3JN 1" />
</usx>