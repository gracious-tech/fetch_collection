<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHP" style="id" />
  <para style="h">Phil</para>
  <para style="toc1">eljwab ala fiylibbiy</para>
  <para style="toc2">Phlp</para>
  <para style="toc3">PHP</para>
  <para style="mt1">eljwab ala fiylibbiy</para>
  <para style="ip">elmuqedmeθ elli yuri:emersal buwlus. elli yemmeryasen:imumnen elkul elli g filibbi delblayeS elkul. esbeb n tires:bac e yecxer(thank) imumnen g filibbi f elxaĎer nelhδiyyeθ elli uzennest, ubac e ntiqewwe max eseniYekkeδ elli elferH eHeqqani yθaseδ kan seg yesuwε elmesiyH . ykewwen emersal buwlus diSHibnes eljmeεεeθ nimumnen g filibbi g erriHltes teθθaniθ, weθkan elkeniyseθ tiglewwelt elli eθemmeg g elqerreθ nurubba. tuzen lkeniyseθ elli g filibbi elhδiyyeθ δebfruwdiytus(iyjen seg leεDas)yumersal buwlus elli ykan elweqθes yemmeHbes g ruwma, yazen eljwabe bac e ntyecxer f wewcensen usinc eycejjeε elimenensen. elHajaθ elli biyhum elfeyde: kuwneθ elεeql iyjen s weθwaDeε deddar g elmesiyH defraH.</para>
  <chapter number="1" style="c" sid="PHP 1" />
  <para style="s">tHeyyet</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 1:1" />seg buwlus dtiymuwθawus ixeddamen n yesuwε elmesiyH, yelli ettemnen elkul s yesuwε elmesiyH, elli εemren g fiylibbiy, wiδsen imesHal dimuεawnen neljemεεeθ nimumnen. <verse eid="PHP 1:1" /><verse number="2" style="v" sid="PHP 1:2" />exenyuc esseHHeθ delxiyr seg rebbi deddaθne d seyδne yesuwε elmesiyH.<verse eid="PHP 1:2" /></para>
  <para style="s">θzalliθ dweHmeδ</para>
  <para style="p">
    <verse number="3" style="v" sid="PHP 1:3" />eHemde rebbi f elxeĎrewwem g ezzaliθiyw, <verse eid="PHP 1:3" /><verse number="4" style="v" sid="PHP 1:4" />udiyme deεεuγewem uneč ferHan. <verse eid="PHP 1:4" /><verse number="5" style="v" sid="PHP 1:5" />f elxaĎer nuεewnewwem g uεerfiyw selYinjiyl s eg was iglewwel elwesse <verse eid="PHP 1:5" /><verse number="6" style="v" sid="PHP 1:6" />uγeri eθiyqeθ egwah: rebbi elli yebδe elxeδmeθ etteSSaleHθ δiwem ettikemmel elwas n yesuwε elmesiyH. <verse eid="PHP 1:6" /><verse number="7" style="v" sid="PHP 1:7" />uselHaq eHusse s uHussiye wah etweliwwem elkul, uxenyum diyme g uliyw, welkulkum d icriyxen iyδi g enneεmeθ enrebbi, sewe kane g elHebs welle etδefaεe f elbcareθ wetYiyδe δiys. <verse eid="PHP 1:7" /><verse number="8" style="v" sid="PHP 1:8" />urebbi eyecheδ elli neč etHenγawem elkul s elHniyn enyesuwε elmesiyH <verse eid="PHP 1:8" /><verse number="9" style="v" sid="PHP 1:9" />utahen eyendeγ ezzalliθiyw bac e yerni exsewwem yelmeεrfeθ delfehm, <verse eid="PHP 1:9" /><verse number="10" style="v" sid="PHP 1:10" />usinc eθexθarem ebehhay usinc eθeδwlem endaf elwas n yesuwε elmesiyH, <verse eid="PHP 1:10" /><verse number="11" style="v" sid="PHP 1:11" />usinc eθεebbem s elγelleθ nelHeq seg yesuwε elmesiyH yumejjeδ nrebbi dweHmeδes.<verse eid="PHP 1:11" /></para>
  <para style="s">eHbas nbuwlus eyεawen f wencar n elmesiyH</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 1:12" />wexse eθesnem eyewmeθniyw, elli yejrayi yεawen f wencar nelbcareθ, <verse eid="PHP 1:12" /><verse number="13" style="v" sid="PHP 1:13" />eδefiyw yelHebs f elxaĎer n elmesiyH yiweD yelHers nelHakem delqeSres elkul. <verse eid="PHP 1:13" /><verse number="14" style="v" sid="PHP 1:14" />welmexθer newmaθen ecejjeεθen γer erreb emnuweθiyw, erniyn g elquwweθ nubeccer selkelmeθ nrebbi menγiyr ekkaδ. <verse eid="PHP 1:14" /><verse number="15" style="v" sid="PHP 1:15" />belHeq lebHaD etbecren s elmesiyH s elHesδ duxaSem, emme lebHaD s enniyyeθ tebhe. <verse eid="PHP 1:15" /><verse number="16" style="v" sid="PHP 1:16" />wiyhen etδuz δiysen exse, εlexaTerhum essenen elli neč etδefaεe f ellinjiyl. <verse eid="PHP 1:16" /><verse number="17" style="v" sid="PHP 1:17" />w iddiyn yetδuz δiysen eθHazeb, wetbecrenc yelmesiyH s elHeq, etεilaken siyn δerniyn g etteεbiyw uneč g elHebs. <verse eid="PHP 1:17" /><verse number="18" style="v" sid="PHP 1:18" />wilekan? elmuhem elmesiyH etnaben essis s elHeq welle s elbaTel. s wah neč ferHan uδeferHe embeεδ. <verse eid="PHP 1:18" /><verse number="19" style="v" sid="PHP 1:19" />uneč essene elli yejrayi elkul g ellexxer δeyferrej felle, f elxaĎer nezzalliθewwem dεawen nerruwH nyesuwε elmesiyH, <verse eid="PHP 1:19" /><verse number="20" style="v" sid="PHP 1:20" />ukul elli etteθmenniγ δiys enni elfeclexc g Hette cey emme elkul quwwe welkul merre welmerreθe zade δeyekber essi elmesiyH, sewe s wedder welle s temettent. <verse eid="PHP 1:20" /><verse number="21" style="v" sid="PHP 1:21" />εlexaTer yneč eddar eyendeγ elmesiyH utemettent δerrebH. <verse eid="PHP 1:21" /><verse number="22" style="v" sid="PHP 1:22" />emme iδekan s leHyeθiyw ege elxeδmeθ tebhe, mat exθare? ellessinexc! <verse eid="PHP 1:22" /><verse number="23" style="v" sid="PHP 1:23" />uneč meHSuwr jar Hejθiyn: exse edje eddunyeθe, bac e kuwne delmesiyH, uwahen xiyr. <verse eid="PHP 1:23" /><verse number="24" style="v" sid="PHP 1:24" />emme θeqimiθiyw eddere xiyr f elxaĎrewwem. <verse eid="PHP 1:24" /><verse number="25" style="v" sid="PHP 1:25" />w meδam γeri eθθiyqeθ g wah, essene elli δeqqiyme eεmere iyδwem elkul, f elxaĎer nweθqedmewwem g liman dwefreHewwem δiys <verse eid="PHP 1:25" /><verse number="26" style="v" sid="PHP 1:26" />bac e θerniym eθeθfuxrem s elli yegeyiθi elmesiyH s weHDeriyw binetkum menjdiyd.<verse eid="PHP 1:26" /></para>
  <para style="s">kuwneθ elεeql iyjen s weθwaDeε emmax i yeθwaDeε elmesiyH</para>
  <para style="p">
    <verse number="27" style="v" sid="PHP 1:27" />yemenni edreθ bac e θerniym g umejjeδ nelYinjiyl n elmesiyH. Hette iδe useδe ezriγawem welle eqqiyme δelγayeb fellawem, selle g lexberewwem wessene elli xenyum teθbeθem g erruwH iyjen. wessen zade etjehaδem s ennefes iyjen jmiyε bac leεbaδ iddiyn emnen s elli yemmeεlen g elYinjiyl. <verse eid="PHP 1:27" /><verse number="28" style="v" sid="PHP 1:28" />weθukδemc seγ elεδuwwem g Hette cey. uwediyn δelburhan f ehlexensen ufwexleSewwem uwahen seγ rebbi <verse eid="PHP 1:28" /><verse number="29" style="v" sid="PHP 1:29" />εlexaTer yenεem fellawem bac e θeθwejεem f elxaĎer n elmesiyH, muc eθemnem essis berk. <verse eid="PHP 1:29" /><verse number="30" style="v" sid="PHP 1:30" />eθezriym max i θwejεe seg ejaheδ weθsellem elli eqqiyme etjehaδe. uxenyum zade jahδeθ emneč.<verse eid="PHP 1:30" /></para>
  <chapter eid="PHP 1" />
  <chapter number="2" style="c" sid="PHP 2" />
  <para style="s">kuwneθ elεeql iyjen s weθwaDeε emmax i yeθwaDeε elmesiyH</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 2:1" />wiδe yelle eθcejjeε g elmesiyH, seg elhne d elmHebbeθ, ducarex g erruwH delHnan dwesxaf, <verse eid="PHP 2:1" /><verse number="2" style="v" sid="PHP 2:2" />rahu eθkemlem elferHiyw max eykuwn γerwem erray iyjen wexse icθ, ennefs icθ welfekr iyjen. <verse eid="PHP 2:2" /><verse number="3" style="v" sid="PHP 2:3" />elyetkuwnc jerawem eθHazeb detfuwxiyr elfareγ, ukul iyjen essiywem eyeHseb elγires xires, <verse eid="PHP 2:3" /><verse number="4" style="v" sid="PHP 2:4" />welilehhiyc kan s elmesleHθes emme s elmeslHeθ nelγires zade. <verse eid="PHP 2:4" /><verse number="5" style="v" sid="PHP 2:5" />w elfekrewwem eykuwn emelfekr n yesuwε elmesiyH. <verse eid="PHP 2:5" /><verse number="6" style="v" sid="PHP 2:6" />nette g kul cey emeTTebiyεeθ n erreb yemenni elyeHsibc ekunwnes iyjen drebbi δelheqq eykebbec δiys. <verse eid="PHP 2:6" /><verse number="7" style="v" sid="PHP 2:7" />yerni yedje elli γers elkul yawi eTTebiyεeθ n elεebδ max i yeδwel emijen essiyne. <verse eid="PHP 2:7" /><verse number="8" style="v" sid="PHP 2:8" />yeθwaDeε iĎaweε elθemettent, θemettent f eSSeliyb. <verse eid="PHP 2:8" /><verse number="9" style="v" sid="PHP 2:9" />heδake εlac ysuliyθ rebbi, yuces zade ellesm emeqqar g ellesami elkul. <verse eid="PHP 2:9" /><verse number="10" style="v" sid="PHP 2:10" />bac e yesjeδ eyyesuwε kul iyjen yedder g esme welle g elqeεεeθ welle seddu elqeεεeθ, <verse eid="PHP 2:10" /><verse number="11" style="v" sid="PHP 2:11" />usinc eyesθeεref kul iyles elli yesuwε elmesiyH δerreb usinc emejδen rebbi deddaθne.<verse eid="PHP 2:11" /></para>
  <para style="s">Dewwaθ g elεalem</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 2:12" />eyendeγ eyewmeθniyw elli exsexθen, diyme etĎawεem diyye uneč iδwem. zaδe muhem exθer eyeθĎawεem g elγyebiyw. usahen tegem ywemneεwwem s elxuwf derrehbeθ, <verse eid="PHP 2:12" /><verse number="13" style="v" sid="PHP 2:13" />εlexaTer rebbi yθeg δiywem bac e xenyuwc enniyeθ δelquδreθ bac e tsefrHem. <verse eid="PHP 2:13" /><verse number="14" style="v" sid="PHP 2:14" />tegem kul cey menγir exernen ula δelεrax, <verse eid="PHP 2:14" /><verse number="15" style="v" sid="PHP 2:15" />bac e θkuwnem endaf weHebbac e lluwm fellawem emidrari nrebbi g eljiyl deDDayeε delfaseδ, etDewwam δiys m elkwakeb g elkuwn, <verse eid="PHP 2:15" /><verse number="16" style="v" sid="PHP 2:16" />ceddiyn eSHiyH g <note caller="+" style="f"><char style="fr" closed="false">2.16 </char><char style="ft" closed="false">meεnehe elxθab imqeddes, elkelimeθ n yesuwε</char></note>elkelimeθ n weddar, bac e θfuxre g was n elmesiyH essiywem δelli ellegixc welletεibexc g elbaTel. <verse eid="PHP 2:16" /><verse number="17" style="v" sid="PHP 2:17" />Hette eδuwce iδemniyw δeDHiyyeθ f elxaĎer nelimenewwem delxeδmtes, eferHe iyδwem elkul, <verse eid="PHP 2:17" /><verse number="18" style="v" sid="PHP 2:18" />xenyum zade efrHeθ iyδi.<verse eid="PHP 2:18" /></para>
  <para style="s">buwlus esenyen eqebleθ tiymuwθawus debfruwdiytus</para>
  <para style="p">
    <verse number="19" style="v" sid="PHP 2:19" />wetteθmenniγ g seyyedne yesuwε eδazne tweliwwem tiymuwθawus qriyb bac e sne leHwelewwem usinc eyeĎman uliyw. <verse eid="PHP 2:19" /><verse number="20" style="v" sid="PHP 2:20" />εlexaTer leγriyc δ wiyn m nette eyelhe essiywem belgde. <verse eid="PHP 2:20" /><verse number="21" style="v" sid="PHP 2:21" />ukul iyjen essyiwem ixeddem yimenes muc iyesuwε elmesiyH, <verse eid="PHP 2:21" /><verse number="22" style="v" sid="PHP 2:22" />uxenyum tessenem ettejrebθes umax i yexδem elbcareθ iyδi emelxeδmeθ enwenglus ydaddes. <verse eid="PHP 2:22" /><verse number="23" style="v" sid="PHP 2:23" />eθmenniγ eθazne etweliwwem max eyeθbeyyen elmeSiriyw, <verse eid="PHP 2:23" /><verse number="24" style="v" sid="PHP 2:24" />uγeri eθθiyqeθ g rebbi elli neč δerejεe tweliwwem beεδ lewse.<verse eid="PHP 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PHP 2:25" />wezriyγ elli lazem eδazne tweliwwem ebfruwdiytus, yewwe wimuεewniyw werfiqiyw g ujaheδ welli θuznemti tweliyw bac e yyexδem, <verse eid="PHP 2:25" /><verse number="26" style="v" sid="PHP 2:26" />unette yecθeHcawem elkul uδimeθqelleq εlexaTer nette yessen elli xenyum tesliym s weTTenes. <verse eid="PHP 2:26" /><verse number="27" style="v" sid="PHP 2:27" />ykan δmaDuwn egget elqriyb δeyemmuwθ, yemenni rebbi yerHemti nette enneč zade, bac e rrennixc eHzan f weHzan. <verse eid="PHP 2:27" /><verse number="28" style="v" sid="PHP 2:28" />uwahen elli yedjayi ezerbe g wezenes tweliwwem bac max ettezrem eyerjeε elferH tweliwwem usinc eyenqez eHzeniyw. <verse eid="PHP 2:28" /><verse number="29" style="v" sid="PHP 2:29" />θeqblemti g erreb s elferH θkermem elli m nette, <verse eid="PHP 2:29" /><verse number="30" style="v" sid="PHP 2:30" />εlexaTer qriyb eyemmuwθ g elxeδmeθ n elmesiyH ixaTer s imenes bac e ykemmel elli δennaqeS g elxeδmtewwem ineč.<verse eid="PHP 2:30" /></para>
  <chapter eid="PHP 2" />
  <chapter number="3" style="c" sid="PHP 3" />
  <para style="s">max exeniberrer erreb</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 3:1" />uture eyewmeθniyw eferHeθ g erreb. elqelqexc max eεewδe exennerye, εlexaTer g uεaweδ eslam yxenyum. <verse eid="PHP 3:1" /><verse number="2" style="v" sid="PHP 3:2" />erreθ elbelewwem seg eyDan, erreθ elbelewwem s elli θegen g eθmuHacθ, erreθ elbelewwem seg idiyn elli yezmen g elbδen, <verse eid="PHP 3:2" /><verse number="3" style="v" sid="PHP 3:3" />unečin midden nuĎehher eHeqqani εlexaTerne nεebbeδ g rebbi s erruwH unečin netteθfuwxer s elli ygeyenexθi yesuwε elmesiyH unetεemmelc f lumuwr nelbδen, <verse eid="PHP 3:3" /><verse number="4" style="v" sid="PHP 3:4" />egedde eεemle felles neč zade. wiδekan eyetεilak elγiriyw elli s elHeqqes δeyεemmel f lumuwr nelbδen, neč eHeqqes. <verse eid="PHP 3:4" /><verse number="5" style="v" sid="PHP 3:5" />εlexaTerni mδehre beεδ immerwe s eθmenye iyyam uneč seg bni israYiyl, seg elεerc nbenyamiyn, δeεibrani seg iεibraniyyen w f elHesb nceriyεeθ neč δefariysiy, <verse eid="PHP 3:5" /><verse number="6" style="v" sid="PHP 3:6" />w f elHesb nelγiyreθ θemeqqerθ Dleme egget elkeniyseθ, ugetteqwe f elHseb necceriyεeθ neč blac elluwm. <verse eid="PHP 3:6" /><verse number="7" style="v" sid="PHP 3:7" />yemenni elli erbHexθi, Hsebe imeniyw exsrexθi f elxaĎer n elmesiyH, <verse eid="PHP 3:7" /><verse number="8" style="v" sid="PHP 3:8" />yemenni erniyγ eHesbe kul cey δelxsareθ f elxaĎer n errebH emeqqar, unette elmeεrfeθ n yesuwε elmesiyH. f elxeĎres nette eqbele exesre kul cey eHesbexθi δelwsex bac e rebHe elmesiyH, <verse eid="PHP 3:8" /><verse number="9" style="v" sid="PHP 3:9" />usinc eyyikuwn δiys emxan, wetkunexc δ eTTaher s ecceriyεeθ, emme s eliman s elmesiyH, unetteθ eThareθ elli iθučiyθ rebbi f elxaĎer neliman <verse eid="PHP 3:9" /><verse number="10" style="v" sid="PHP 3:10" />bac e sne elmesiyH delquwweθ elli teθjelle g wekkeres usinc eθcarxe g elwjeyεes bane m nette g temettentes, <verse eid="PHP 3:10" /><verse number="11" style="v" sid="PHP 3:11" />eδewDe iwekkar seg θemettent reγmelli ellessinexc ebriδ.<verse eid="PHP 3:11" /></para>
  <para style="s">esseεi y elγayeθ</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 3:12" />welHesbexc imeniyw iwyexθi δwele δelkamel, yemenni δejehδe bac e rebHe elli f elxeĎres yerbeHi yesuwε elmesiyH. <verse eid="PHP 3:12" /><verse number="13" style="v" sid="PHP 3:13" />ey ewmaθen, elHesbexc imeniyw erbeHe, yemenni ethemmiyδ elHajeθ icθ unetteθ elli ethemle elli δefriyw usinc ejahδe lezδaθ, <verse eid="PHP 3:13" /><verse number="14" style="v" sid="PHP 3:14" />eδezle y elγerδiyw, bac e rebHe eddeεweθ nrebbi s yesuwε elmesiyH. <verse eid="PHP 3:14" /><verse number="15" style="v" sid="PHP 3:15" />uyelzemne elkulne. nečin elli ennuDaj, enuyuwr g webriδe wiδekan γerwem erray xlaf, rebbi exentinewwer. <verse eid="PHP 3:15" /><verse number="16" style="v" sid="PHP 3:16" />yemenni θuwre edj enkebbec s elHqiyqeθ g webriδ elli negguwr δiys.<verse eid="PHP 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHP 3:17" />εaneδmi ey ewmaθen, terqbem yelli egguwren emmax i xennesexne. <verse eid="PHP 3:17" /><verse number="18" style="v" sid="PHP 3:18" />enniγawem g eddac nmerre, wexennenne ture s imettawen g tiTTewiniyw, elli ellan eljmeεεeθ egget egguwren g webriδ nelεδu neSSeliyb n elmesiyH. <verse eid="PHP 3:18" /><verse number="19" style="v" sid="PHP 3:19" />iyhen ellexerθensen tuwHec, εlexaTer etfekren kan g tiδeswinensen, elmejδensen g elεerensen, welhemmensen g eddunyeθ. <verse eid="PHP 3:19" /><verse number="20" style="v" sid="PHP 3:20" />yemenni nečin elHukmenne enedder g esme, elli δeneθlehhef g uraji seyyedne yesuwε elmesiyH elli exenimenneε essis, <verse eid="PHP 3:20" /><verse number="21" style="v" sid="PHP 3:21" />unette elli δeybeddel elbeδnenne emuwHec usinc eθyer emelmejδes uγers elquδreθ f kul cey.<verse eid="PHP 3:21" /></para>
  <chapter eid="PHP 3" />
  <chapter number="4" style="c" sid="PHP 4" />
  <para style="s">efrHeθ g erreb diyme</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 4:1" />emmale eyewmeθniyw elli exsγawem wettecθeHecγawem, uxenyum elferHiyw delεezziyw, eθbθeθ f wah elkul teθbεem erreb, ey iεezzezniyw.<verse eid="PHP 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 4:2" />eyekδe f efuwdiyye dsentiyxe bac e mfahmem f elfekreθ icθ g erreb. <verse eid="PHP 4:2" /><verse number="3" style="v" sid="PHP 4:3" />ucex zade eyemeddukliyw eSHiyb nellemaneθ, exsγax entεawneδ εlexaTer nihenti εewentiyδ g elxeδmeθ nelbcareθ, nihenti dikliymenduws delli εewenni elkul welli elliseminsen g elxθab nwedder diyme.<verse eid="PHP 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PHP 4:4" />efrHeθ diyme g erreb, wexennenne zade efrHeθ. <verse eid="PHP 4:4" /><verse number="5" style="v" sid="PHP 4:5" />eykuwn eSSebrewwem yemmessen γer leεbaδ elkul. asaδ n erreb yeqreb. <verse eid="PHP 4:5" /><verse number="6" style="v" sid="PHP 4:6" />eθeqlqemc xlaS, yemenni eDelbeθ diyme elHejθewwem seg rebbi s ezzalliθ dumelleg dweHmaδ, <verse eid="PHP 4:6" /><verse number="7" style="v" sid="PHP 4:7" />weslam nrebbi elli eyfaθ leεquwl elkul, eyeHfeĎ ulewnewwem dleεqulewwem bac e mleymen dyesuwε elmesiyH.<verse eid="PHP 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PHP 4:8" />ugellexxer ey ewmaθen, ettelhaθ s kul cey δelHeq uδucriyf uδelεaδel uδeTTaher, w s kul cey δimesθHeb wessirθes tebhe w efDiyl w eyemmemdeH, <verse eid="PHP 4:8" /><verse number="9" style="v" sid="PHP 4:9" />kemleθ exδmeθ s elli teHfĎemt essi delli θiwyemt seg γeri delli teslimt essi uθezrimt diyye rebbi elli exenyuc eslem eykuwn iyδwem.<verse eid="PHP 4:9" /></para>
  <para style="s">ecxar f uεawen</para>
  <para style="p">
    <verse number="10" style="v" sid="PHP 4:10" />freHe egget max i xennezriyγ θerjeεem θettelham essi. rahu essenne elli θkan γerwem ellehweθe, yemenni eltkanc γerwem elfurSeθ seg qebl. <verse eid="PHP 4:10" /><verse number="11" style="v" sid="PHP 4:11" />welqaSδexc elli neč kane meHθaj, εlexaTer θεelme ekuwne diyme δeqnuwεi s elli neč δiys. <verse eid="PHP 4:11" /><verse number="12" style="v" sid="PHP 4:12" />uneč essene edre δemendaq, wessene edre δimeθferheδ. wegleHwal elkul qbele ecbaε delaz, w elfrej deDDiq, <verse eid="PHP 4:12" /><verse number="13" style="v" sid="PHP 4:13" />wetgedde kul cey s elmesiyH elli iθuči elquwweθ. <verse eid="PHP 4:13" /><verse number="14" style="v" sid="PHP 4:14" />emme θegiym elxiyr max i yeccarxem g elmeHntiyw.<verse eid="PHP 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHP 4:15" />uxenyum tessenem, emidden nfiylibbiy, elli weqθelli bδiyγ elxeδmtiyw yellinjiyl, weqθelli djiyγ maqduwniyye, weHebbe Hette elkeniyseθ θcarex iyδi g elHsab nwewce dwaway kan δxenyum weHδawem. <verse eid="PHP 4:15" /><verse number="16" style="v" sid="PHP 4:16" />Hette uneč g tsaluwniykiy, tuzenmi elmerreθ usent elli elHejθiyw essis. <verse eid="PHP 4:16" /><verse number="17" style="v" sid="PHP 4:17" />w g elHeq neč meniyc θezle f wewce, yemenni exse eθerniym eθegem elfayδeθ yxenyum. <verse eid="PHP 4:17" /><verse number="18" style="v" sid="PHP 4:18" />uture γeri elli eyyelzem, wexθer. δwele δimbeHbeH max i yedyuwγe ebefruwdiytus elli θuciymi δeSSeδqeθ. etyeqbel rebbi yefreH essis. <verse eid="PHP 4:18" /><verse number="19" style="v" sid="PHP 4:19" />urebbi δexenyuc seg elxires emeqqar elli elHejθewwem essis elkul s elmejδ enyesuwε elmesiyH. <verse eid="PHP 4:19" /><verse number="20" style="v" sid="PHP 4:20" />elmejδ yrebbi deddaθne elellexxer neddunyeθ. emiyn!<verse eid="PHP 4:20" /></para>
  <para style="s">etteHiyyeθ δwexθam</para>
  <para style="p">
    <verse number="21" style="v" sid="PHP 4:21" />selmeθ f elli ettemnen elkul s yesuwε elmesiyH. eselmen fellawem ewmaθen elli iyδi. <verse eid="PHP 4:21" /><verse number="22" style="v" sid="PHP 4:22" />eselmen fellawem imumnen elli δah elkul, wexSuwSi elli seg eljmeεεeθ nelqeySer.<verse eid="PHP 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PHP 4:23" />eθkuwn enneεmeθ n seyyedne yesuwε elmesiyH iyδwem.<verse eid="PHP 4:23" /></para>
  <chapter eid="PHP 4" />
</usx>