<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JAS" style="id" />
  <para style="h">Jas</para>
  <para style="toc1">eljwab n yeεquwb</para>
  <para style="toc2">Jams</para>
  <para style="toc3">JAS</para>
  <para style="mt1">eljwab n yeεquwb</para>
  <para style="ip">elmuqedmeθ elli yuri:yeεquwb yewwes n erreb yesuwε unette δelqayeδ g elkeniyseθ nurceliym. elli yemmeryasen:θemmari yimumnen seg elleSl δyehuwdi g elqern iglewwel miladi, elli εemren lberre nfilisTiyn. uθemmari zade yimumnen elkul g elblayes elkul. elweqθ ntires:yumken θemmari g usukkes 49 miladi qebl nelli eyemmeg elmejmeε nurceliym g usukkes 50 miladi. esbeb ntires:ykeccef eljwabe ege nelfseδ dumuwHac uyeSSeHfaD δiysen ebriδ ebehhay nimumnen. yessexne yetεebber eljwabe f wettelhi nyeεquwb s imumnen elli seddu eDDeγT delεδab welli kanen qebl tebεiyn elkeniyseθ nurceliym. elHajaθ elli bihum elfeyde: eliman eHeqqani dettejrbaθ delwSayeθ nexse dedwi nelHikmeθ deHeδδer seg eHayel denδer nimuγniyyen.</para>
  <chapter number="1" style="c" sid="JAS 1" />
  <para style="s">etteHiyyeθ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 1:1" />sγiyr yeεquwb, exeddam nrebbi derreb yesuwε elmesiyH, yelεcayer leθnac nebni sraYiyl imeθferqen g eddunyeθ: selam.<verse eid="JAS 1:1" /></para>
  <para style="s">eliman yθeγeδ elHekmeθ</para>
  <para style="p">
    <verse number="2" style="v" sid="JAS 1:2" />emmeθniyw efrHeθ belgde max eθeθεeddam f elmHayen egget, <verse eid="JAS 1:2" /><verse number="3" style="v" sid="JAS 1:3" />εlexaTer θessenem elli ejerreb nelimenennum yθaγeδ eSSebr. <verse eid="JAS 1:3" /><verse number="4" style="v" sid="JAS 1:4" />edjeθ eSSebr eykemmel lxeδmtes bac e θeδwlem tekmelem g kul cey umuc δennuqqaS g Hette cey.<verse eid="JAS 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 1:5" />iδekan yelle iyjen essiywem dennaqeS g elHekmeθ, edj etyeĎleb seg rebbi elli yettuwc egget yleεbaδ elkul menγiyr elluwm, uture esetyuc. <verse eid="JAS 1:5" /><verse number="6" style="v" sid="JAS 1:6" />emme yelzem max etyeĎleb eyemmen welyečukkec, εlexaTer elli yečuk icebbeh yelmuwj niylel max eyenfex felles aDu iheyyejθ. <verse eid="JAS 1:6" /><verse number="7" style="v" sid="JAS 1:7" />welli yečuk eyexDemc g elbeles elli δesyeweδ Haje sγiyr rebbi, <verse eid="JAS 1:7" /><verse number="8" style="v" sid="JAS 1:8" />εlexaTer elγrec erray iyjen weligeddec eyexθar elHajeθ icθ.<verse eid="JAS 1:8" /></para>
  <para style="s">efqiyr δumuγni</para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 1:9" />wedj enje eqelliyl eyeθfuxer s wemxenes eεellay, <verse eid="JAS 1:9" /><verse number="10" style="v" sid="JAS 1:10" />wemuγni s wemxenes uggedday, εlexaTre δyeqquwr emennewwar nelHec. <verse eid="JAS 1:10" /><verse number="11" style="v" sid="JAS 1:11" />max eθeqqes tefuwθ s esxentes eθesquwr elHec, ennewweres eyuwDe, webhas eyexDem. usahen δeyexDem emuγni unette yelhe g elxeδmtes.<verse eid="JAS 1:11" /></para>
  <para style="s">elmeHneθ δujerreb</para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 1:12" />SeHHe liyh elli eyeSber f elmeHneθ, εlexaTer max eyeθεedde f elmeHneθ δeyawi ettaj nweddar elli rebbi yuεeδ essis ihelli exsent. <verse eid="JAS 1:12" /><verse number="13" style="v" sid="JAS 1:13" />max eθeθεedde lmeHneθ f iyjen essiywem, mayelzemc eyen: «rebbi yetjerreb δiyye.» εlexaTer rebbi yettemjerribc s eccer unette biyδe lyetjerreb Hette Hed, <verse eid="JAS 1:13" /><verse number="14" style="v" sid="JAS 1:14" />emme elεebδ yettemjerreb max eyemmexδeε s eTmeε yeθbeεθ. <verse eid="JAS 1:14" /><verse number="15" style="v" sid="JAS 1:15" />weTmeε yθaru elγeldeθ, welγeldeθ eθekbar eθaru ejafi. <verse eid="JAS 1:15" /><verse number="16" style="v" sid="JAS 1:16" />erreθ elbalennum eθemmexδεem, emmeθniyw elli exesγawem egget. <verse eid="JAS 1:16" /><verse number="17" style="v" sid="JAS 1:17" />kul elhδiyyeθ tebhe wettelkamelt etteggez s lennej, sγiyr dadde entifawiyn elli elyettembeddilc welyettegc eTTel δimeθγeyyer εlexaTer elyettenneDc. <verse eid="JAS 1:17" /><verse number="18" style="v" sid="JAS 1:18" />yirwane s tuθleyθ nelHeq, elγeyθes eneδwel delγelleθ temezwarθ nelli yexleq elkul.<verse eid="JAS 1:18" /></para>
  <para style="s">esleθ tegem</para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 1:19" />esneθ wahen, emmeθniyw elli exsγawem egget, edj kul iyjen essiywem eyesl liyhliyh, eyuθlay s qiqqi, yetteθγecciycec liyhliyh, <verse eid="JAS 1:19" /><verse number="20" style="v" sid="JAS 1:20" />εlexaTer elγuc nelεebδ lixeddemc g elHeq nrebbi. <verse eid="JAS 1:20" /><verse number="21" style="v" sid="JAS 1:21" />usahen, lewHeθ enjaseθ delbqiyyeθ neccer, teqblem s elferHeθ tuθleyθ elli θemmezzu δiywem welli eθged eθmenneε lerweHennum. <verse eid="JAS 1:21" /><verse number="22" style="v" sid="JAS 1:22" />emme eθexδεemc imenennum teslem kan ettuθleyθ, egeθ elli θeqqar δiys. <verse eid="JAS 1:22" /><verse number="23" style="v" sid="JAS 1:23" />εlexaTer elli eyesl tuθleyθ welyettegc elli θeqqar δiys eyeδwel icebbeh yelli ireqqeb yuδmes g temreyθ, <verse eid="JAS 1:23" /><verse number="24" style="v" sid="JAS 1:24" />beεεeδ eyerqeb imenes, eyexDem yettu liyhliyh max i ykan. <verse eid="JAS 1:24" /><verse number="25" style="v" sid="JAS 1:25" />welli ireqqeb g ecceriyεeθ telkamelt, ecceriyεeθ nelHurriyyeθ, yeθbeθ felles, muc eyesl yettu emme eyexδem essis, rebbi δesibarex g elli yetteg δiys elkul. <verse eid="JAS 1:25" /><verse number="26" style="v" sid="JAS 1:26" />welli yetεilak imenes δimeddiyyen welyetteTTefc ilses, yxeddeε g imenes weddiyynes δ elbaTel. <verse eid="JAS 1:26" /><verse number="27" style="v" sid="JAS 1:27" />eddiyyen eTTaher eSSafi γer rebbi nette δwahen: eTulli f iytiymen ettidjaliyn g eddiqensen, dwerre nelbal seg elwsex neddunyeθ.<verse eid="JAS 1:27" /></para>
  <chapter eid="JAS 1" />
  <chapter number="2" style="c" sid="JAS 2" />
  <para style="s">eHeδδer seg eHayel</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 2:1" />eyemmeθniyw, meδam ettemnem s errebbenne yesuwε elmesiyH eyemmejjeδ, eθHayelem f Hette Hed. <verse eid="JAS 2:1" /><verse number="2" style="v" sid="JAS 2:2" />max eyaδef yelmejmeεwwem eryaz δemuγni yireD tixuθam nuwreγ dedbac bhan, usiyn eyaδef eryaz δeqelliyl yireD edbac uHecen, <verse eid="JAS 2:2" /><verse number="3" style="v" sid="JAS 2:3" />kan telham s elli yireD edbac bhan tenmas: «eqqiym dahen, uggemmas.» tennem yuqelliyl: «bed diyn.» ziyγ: «eqqiym dahen yeθwali ikreεnenne.», <verse eid="JAS 2:3" /><verse number="4" style="v" sid="JAS 2:4" />eθkuwnem tbejlem iyjen essisen f wissen, teδwlem delHukkam s uxemmem δelfaseδ? <verse eid="JAS 2:4" /><verse number="5" style="v" sid="JAS 2:5" />esseγδeθ, emmeθniyw elli exesγawem egget: elyexθarc rebbi iqelliylen neddunyeθe bac e δuwlen dimuγniyyen seliman urθen elmemlxeθ elli yuεeδ essis ihelli exsent? <verse eid="JAS 2:5" /><verse number="6" style="v" sid="JAS 2:6" />emme xenyum tHeqrem iqelliylen. muc δimuγniyyen Delmen diywem, wettawyen diywem y elmHakem? <verse eid="JAS 2:6" /><verse number="7" style="v" sid="JAS 2:7" />muc ennihnin elli DeSSen f ellesm ebehhay elli yemmucawem? <verse eid="JAS 2:7" /><verse number="8" style="v" sid="JAS 2:8" />kan texδemem s ecceriyεeθ teεellayθ elli g elxθab, «exs eljirenex emmax i θexseδ imenex.» eθegem elHajeθ tebhe. <verse eid="JAS 2:8" /><verse number="9" style="v" sid="JAS 2:9" />emme kan tHaylem f Hed, δeθegem elγeldeθ, teHkum fellawem ecceriyεeθ emihelli γelden. <verse eid="JAS 2:9" /><verse number="10" style="v" sid="JAS 2:10" />εlexaTer elli eyexδem s ecceriyεeθ elkulhe yedj icθ eyeδwel emmax yedjiyt elkulhe. <verse eid="JAS 2:10" /><verse number="11" style="v" sid="JAS 2:11" />εlexaTer elli yenne: «eθezniyc.» yenne zaδe: «eθenγec.» iδekan eltezniyc emme θenγiyδ, eθeδwleδ dimxalef yecceriyεeθ. <verse eid="JAS 2:11" /><verse number="12" style="v" sid="JAS 2:12" />emmale uθlayeθ texδmem emihelli δemHakmen s ecceriyεeθ nelHurriyyeθ. <verse eid="JAS 2:12" /><verse number="13" style="v" sid="JAS 2:13" />εlexaTer eHakem lireHHemc ihelli erreHmenc, erHam eyeγleb eHakem.<verse eid="JAS 2:13" /></para>
  <para style="s">eliman dwege</para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 2:14" />emmeθniyw, s mette δeyesθenfeε elεebδ elli yeqqar γers emman weleγrec lxeδmeθ? eyged emmenes eθimenneε? <verse eid="JAS 2:14" /><verse number="15" style="v" sid="JAS 2:15" />θSewreθ enjeθwem ziyγ weltmeθwem δiεeryanen welγersenc δmette δečen, <verse eid="JAS 2:15" /><verse number="16" style="v" sid="JAS 2:16" />s mette δesθenefεen max esentennem: «berraθ s eslam, eddeffaθ tecbεem.» menγiyr esentuwcem elli ettesθHeqqen δiys? <verse eid="JAS 2:16" /><verse number="17" style="v" sid="JAS 2:17" />eliman sahen, menγiyr elxeδmeθ nette biyδe ijaf. <verse eid="JAS 2:17" /><verse number="18" style="v" sid="JAS 2:18" />iyjen essiywem iged eyen: «γerex eliman uγeri elxeδmeθ. essexniyδ elimenex menγiyr elxeδmeθ, uneč ture exessexne s elxeδmeθiyw elimeniyw.» <verse eid="JAS 2:18" /><verse number="19" style="v" sid="JAS 2:19" />cex ettemneδ elli rebbi iyjen, tegiyδ elHajeθ tebhe. Hette δecyaĎen ettemnen ureglen s elxuwf. <verse eid="JAS 2:19" /><verse number="20" style="v" sid="JAS 2:20" />texseδ exessexne ey ejjahel elli menγiyr elxeδmeθ eliman Hette cey? <verse eid="JAS 2:20" /><verse number="21" style="v" sid="JAS 2:21" />muc daddeθne ibrahiym yucayes rebbi elHeq s elxeδmtes max i yyuwce memmis isHaq f elmeδbeH? <verse eid="JAS 2:21" /><verse number="22" style="v" sid="JAS 2:22" />tezriyδ elli elimenes yban s elxeδmtes, welli elimenes yeδwel delkamel s elxeδmtes, <verse eid="JAS 2:22" /><verse number="23" style="v" sid="JAS 2:23" />yekmel edwi nelxθab: «yemmen ibrahiym s rebbi, yeHsebθ f elHeq.» yemsemme eSSaHeb nrebbi. <verse eid="JAS 2:23" /><verse number="24" style="v" sid="JAS 2:24" />tzerrem elli elεebδ yetban f elHeq s elxeδmeθ muc s wemman berk. <verse eid="JAS 2:24" /><verse number="25" style="v" sid="JAS 2:25" />usahen zade, raHab θezzaniyθ yucayes rebbi elHeq s elxeδmtes max i θeεreD imersal tezenten eggubriδ xlaf bac e ntmenneε? <verse eid="JAS 2:25" /><verse number="26" style="v" sid="JAS 2:26" />εlexaTer emmax elbδen menγiyr erruwH ijaf, emman zade menγiyr elxeδmeθ etjaf.<verse eid="JAS 2:26" /></para>
  <chapter eid="JAS 2" />
  <chapter number="3" style="c" sid="JAS 3" />
  <para style="s">eccer niles</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 3:1" />emmeθniyw, eθemsabqemc bac e θeδewlem dimuεelmen, εlexaTer θessenem nečin elli nesseqre elHsebenne δeykuwn yuεer egget. <verse eid="JAS 3:1" /><verse number="2" style="v" sid="JAS 3:2" />εlexaTer elkulne nγelleĎ, welli liγelleĎc g edwiys rahu δiyjen delkamel eyged eyeHkum g imenes. <verse eid="JAS 3:2" /><verse number="3" style="v" sid="JAS 3:3" />netlejjem elHSenne bac e slen edwiynne, enged engewweδ elkul. <verse eid="JAS 3:3" /><verse number="4" style="v" sid="JAS 3:4" />erqbeθ yelflayek zade, ferreγm nelkebrensneθ delquwweθ nwaDu elli yetδuz δiysent, ettemsuqqaneθ s eddeffeθ ettemezyent egget elmani iyyexs elqayeδ. <verse eid="JAS 3:4" /><verse number="5" style="v" sid="JAS 3:5" />usahen iles zade, δemezzyen emme iged eyeHke f elHajaθ ettimeqqarin. mekberhe elγabeθ elli etmeHraq s elεafyeθ ettemezyent! <verse eid="JAS 3:5" /><verse number="6" style="v" sid="JAS 3:6" />wiles δelεafyeθ zade, iles yεebbe δeccer uyetwessex g elbδen, yetwessex δiys elkul wiHerreq g edduwreθ neddunyeθ elkulhe s elεafyeθ seg jhennem. <verse eid="JAS 3:6" /><verse number="7" style="v" sid="JAS 3:7" />webnaδem iged eyeθHekkem f elhuwc dizenniywen etlefsiwiyn delHuwθ, <verse eid="JAS 3:7" /><verse number="8" style="v" sid="JAS 3:8" />emme ligedc eyeθHekkem g ilses, nette δeccer elyetmeTTifc, iεebbe δessem ineq. <verse eid="JAS 3:8" /><verse number="9" style="v" sid="JAS 3:9" />essis nHemmeδ g rebbi, wessis netsub g leεbaδ elli emmexelqen f ecbeh nrebbi. <verse eid="JAS 3:9" /><verse number="10" style="v" sid="JAS 3:10" />seg iymi iyjen yeteffeγ eHmaδ dusubbi. emmeθniyw, wahen meyelzemc eySar. <verse eid="JAS 3:10" /><verse number="11" style="v" sid="JAS 3:11" />telle elεiyn etwerwer s wamen eHlan dwamen melHen? <verse eid="JAS 3:11" /><verse number="12" style="v" sid="JAS 3:12" />emmeθniyw, tged temečiyθ eθaru ezemmur, ziyγ θeεembeyθ imečen? kiyfkiyf amen melHen elgeddenc essufγen amen Hlan.<verse eid="JAS 3:12" /></para>
  <para style="s">elHekmeθ nesme</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 3:13" />δ wiyn δelεaqel wifehhem essiywem? edj eyesxen elεaqeltes dwefhemes s etterbeyyθes tebehheyθ. <verse eid="JAS 3:13" /><verse number="14" style="v" sid="JAS 3:14" />emme g ulewnennum eHsaδ delleneniyyeθ, eθeθfuxremc f elHekmeθ weθesxerxsemc f elHeq. <verse eid="JAS 3:14" /><verse number="15" style="v" sid="JAS 3:15" />elHekmeθ emtah etteggezc s lennej, θahen δelεqaleθ seg elqeεεeθ, sγiyr leεbaδ, sγiyr ecyaĎen. <verse eid="JAS 3:15" /><verse number="16" style="v" sid="JAS 3:16" />εlexaTer mani iyyelle elHseδ delleneniyyeθ rahu yelle eferreθ deccer. <verse eid="JAS 3:16" /><verse number="17" style="v" sid="JAS 3:17" />emme elHekmeθ elli etteggez s lennej qebl kul cey etteSSafiθ wettimsameHθ utebhe wettimĎaweεθ weθεebbe δerreHmeθ delγelleθ tebehhayθ menγiyr ebejjel ula θixerxas. <verse eid="JAS 3:17" /><verse number="18" style="v" sid="JAS 3:18" />welli ettegen g eslam zerεen s eslam g elγelleθ nelHeq.<verse eid="JAS 3:18" /></para>
  <chapter eid="JAS 3" />
  <chapter number="4" style="c" sid="JAS 4" />
  <para style="s">erreθ elbelennum seg eSaHeb nelεalem</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 4:1" />s meniys elmecakel delεrax mabinetkum? muc seg eTmeε elli ettemεerexneθ uggemmesennum? <verse eid="JAS 4:1" /><verse number="2" style="v" sid="JAS 4:2" />eθecθham wettewyemc, usahen eθeδwlem HaDriyn ywenγe. eθeHsδem weltgeddemc eθawyem, usahen eθegem elmecakel temεarxem temHarbem. elγerwemc εlexaTer eltĎelbemc. <verse eid="JAS 4:2" /><verse number="3" style="v" sid="JAS 4:3" />umax eθeDelbem ettawyemc εlexaTer teDelbem s enniyyeθ tuwHec, bac e tteSerfem f eccehweθennum. <verse eid="JAS 4:3" /><verse number="4" style="v" sid="JAS 4:4" />eyelxuyyan! eltessinemc elli eSaHeb neddunyeθ nette δelεerx drebbi? elli yexs essiywem eySaHeb eddunyeθ eyemεarex drebbi. <verse eid="JAS 4:4" /><verse number="5" style="v" sid="JAS 4:5" />ziyγ etεilakem elli yemmari g elxθab delγaled, «elγiyreθ tεebbe erruwH elli yegiyt rebbi δiyne.»? <verse eid="JAS 4:5" /><verse number="6" style="v" sid="JAS 4:6" />urebbi yettuč enneεmeθ ekber, usahen yeqqar: «rebbi yetrejjeε g imeθkebren wineεεem f imeθwaDεen.» <verse eid="JAS 4:6" /><verse number="7" style="v" sid="JAS 4:7" />Hutteθ imanennum seddu rebbi tqewmem ecciyĎan, uture eyerwel fellawem. <verse eid="JAS 4:7" /><verse number="8" style="v" sid="JAS 4:8" />eqrbeθ yrebbi, uture eyeqreb yetwelinnum. neDfeθ ifesnennum eyelli θγelĎem, tneDfem ulewnennum eyelli elγerwemc erray iyjen. <verse eid="JAS 4:8" /><verse number="9" style="v" sid="JAS 4:9" />eHzneθ tεeyĎem. edjeθ teSSennum eθeδwel δeεeyyeĎ welferHennum δelγem. <verse eid="JAS 4:9" /><verse number="10" style="v" sid="JAS 4:10" />eθwaDεeθ ezzaθ nrebbi uture exeniqam.<verse eid="JAS 4:10" /></para>
  <para style="s">eθeDlmemc eqribennum</para>
  <para style="p">
    <verse number="11" style="v" sid="JAS 4:11" />emmeθniyw, eθeqrDemc beεDkum. elli eyeqreD unjes ziyγ eθyethem eyeqreD ecceriyεeθ yethemt. umax eθethmem ecceriyεeθ, mekumc δixeddamen essis emme δelHukkam felles. <verse eid="JAS 4:11" /><verse number="12" style="v" sid="JAS 4:12" />iyjen berk yečerreε wiHekkem, unette elli yged eymenneε yehlex. δ wiyn cex bac e θethmeδ elli yeqrebex?<verse eid="JAS 4:12" /></para>
  <para style="s">eθwekkel f rebbi</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 4:13" />esδeθ ture, xenyum elli θeqqarem: «esse ziyγ eječe δenexDem iθemuwrθe ziyγ θeδint enεedde esukkes diyn nezzenz nerbeH.» <verse eid="JAS 4:13" /><verse number="14" style="v" sid="JAS 4:14" />xenyum eltessinem Hette cey uffeječe, dmette netteθ elHyaθennum? xenyum ettelmuyθ eθban qiqqi usiyn eθexDem. <verse eid="JAS 4:14" /><verse number="15" style="v" sid="JAS 4:15" />yelzem eθennem: «kan rebbi yexs, ture enedder neg wahen ziyγ wediyn.» <verse eid="JAS 4:15" /><verse number="16" style="v" sid="JAS 4:16" />emme xenyum ture etteθbaham s uθkebrennum, weθbahiye elkulle δeccer. <verse eid="JAS 4:16" /><verse number="17" style="v" sid="JAS 4:17" />elli yessen elxiyr weθyettegc, yeγleĎ.<verse eid="JAS 4:17" /></para>
  <chapter eid="JAS 4" />
  <chapter number="5" style="c" sid="JAS 5" />
  <para style="s">enδer nimuγniyyen</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 5:1" />esδeθ ture eyimuγniyyen, εeyĎeθ tendbem f elemSayeb elli δeggezneθ fellawem. <verse eid="JAS 5:1" /><verse number="2" style="v" sid="JAS 5:2" />leflusennum fseδen wedbecennum herran. <verse eid="JAS 5:2" /><verse number="3" style="v" sid="JAS 5:3" />urγennum delfeTTeθennum SeddeĎen, weSĎiddiyn δeyecheδ fellawem yeč exsumennum emelεafyeθ. teknezem iliyyam tellexriyn, <verse eid="JAS 5:3" /><verse number="4" style="v" sid="JAS 5:4" />wetejernat nixeddamen elli emjeren ijiyman elli θfukkemten, yuli ezeεwges. wezeεweg niHeSSaδen yiweD yerreb neleεsaker nesme. <verse eid="JAS 5:4" /><verse number="5" style="v" sid="JAS 5:5" />tedderem g elqeεεeθ g weθneεεem decciyxaθ, tessecebεem imenennum emufuwnes iwas nweγras. <verse eid="JAS 5:5" /><verse number="6" style="v" sid="JAS 5:6" />teHkumem f elli xaTiyh tenγemt wexeniqewemc.<verse eid="JAS 5:6" /></para>
  <para style="s">eSbar etzalliθ</para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 5:7" />eSebreθ, emmeθniyw, elδeyeddes erreb. erqbeθ max i ySebber efellaH unette yetraje g elγelleθ temeγlaweθ nelqeεεeθ, iSebber felles elδeyeggez emzar nelxriyf derbiyε. <verse eid="JAS 5:7" /><verse number="8" style="v" sid="JAS 5:8" />xenyum zaδe eSbreθ tqewwam ulewnennum, εlexaTer aseδ n erreb yeqreb. <verse eid="JAS 5:8" /><verse number="9" style="v" sid="JAS 5:9" />eθneγenγemc f beεDkum, emmeθniyw, bac e xenyetHesiybc rebbi. tayeθ, ibed f elbab. <verse eid="JAS 5:9" /><verse number="10" style="v" sid="JAS 5:10" />emmeθniyw, eθbεeθ lenbye elli uθlayen s ellesm nrebbi mεeδben eSbren. <verse eid="JAS 5:10" /><verse number="11" style="v" sid="JAS 5:11" />uSeHHe liyhum yihelli eSbren. tesliym s weSbar neyyuwb uθezriym max i θixelleS rebbi. rebbi rew'uwf reHiym.<verse eid="JAS 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 5:12" />emme qebl kul cey, emmeθniyw, eθeθjullemc la s esme la s elqeεεeθ la s Hette cey xelaf. max eθennem wa, wa umax eθennem la, la, bac e ttemεeqiybemc.<verse eid="JAS 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 5:13" />diywem iyjen yetεane? edj eyezzal. diywem iyjen ferHan? edj eysebbeH yrebbi. <verse eid="JAS 5:13" /><verse number="14" style="v" sid="JAS 5:14" />diywem iyjen δmaDun? edj eynabe imeqqaren nleεbaδ nelkeniyseθ bac e zzallen felles, eδhenent s uδi s ellesm nrebbi. <verse eid="JAS 5:14" /><verse number="15" style="v" sid="JAS 5:15" />tzalliθ s wemman etmenneε maDun, urebbi δeθyessikker. wiδekan yeγleĎ eθisameH. <verse eid="JAS 5:15" /><verse number="16" style="v" sid="JAS 5:16" />eHkaθ elγeldeθennum ibeεDkum tezzallem f elxaĎer nbeεDkum bac e θebram. tzalliθ niHeqqiyyen γers elquwweθ ettemeqqarθ. <verse eid="JAS 5:16" /><verse number="17" style="v" sid="JAS 5:17" />iliyya ykan δelεebδ emnečin g kul cey, yezzal bac e lyettuwweθc emzar, yeqqiym tlaθe sniyn usette chuwr elyewwiyθc g elqeεεeθ. <verse eid="JAS 5:17" /><verse number="18" style="v" sid="JAS 5:18" />yezzal xlaf yewweθ emzar tuwc elqeεεeθ elxiyres.<verse eid="JAS 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 5:19" />emmeθniyw, max eyebεeδ iyjen essiywem f elHeq usiyn eθyer iyjen xlaf, <verse eid="JAS 5:19" /><verse number="20" style="v" sid="JAS 5:20" />edj eyessen wahen: elli eyer elγaleĎ seg webriδ nuraHi eymenneε erruwH seg ujafi ysehles eγfar nelγeldaθ egget.<verse eid="JAS 5:20" /></para>
  <chapter eid="JAS 5" />
</usx>