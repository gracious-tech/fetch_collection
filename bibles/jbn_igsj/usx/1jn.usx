<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1JN" style="id" />
  <para style="h">1 John</para>
  <para style="toc1">eljwab eglewwel n yuwHenne</para>
  <para style="toc2">1Jhn</para>
  <para style="toc3">1JN</para>
  <para style="mt1">eljwab eglewwel n yuwHenne</para>
  <para style="ip">elmuqedmeθ eljwab n yuwHenne iglewwel γers sent elγayaθ: ecejjeε f wedder erreb d memmis yesuwε elmesiyH, d uHeδδer seg elHwayej n elbaTel elli eθheddem eddare, εlexaTer elHwayeje eqqarneθ elli eccer yθaseδ seg eddar g eddunyeθ, heδake εlac yetgedc elmesiyH eykuwn δ elbecer. w elxlaS nette ekkas n lehmum n eddunyeθe, w elγrec elεelaqeθ s lexlaq d exse n ebnaδem y ebnaδem. w g erres f edwiye elbatel yenne yuHenne, elli yesuwε belHeq ySar δ ebnaδem, emme elli emnen s yesuwε w exsen rebbi yelzem exsen beεDhum.</para>
  <para style="ip">elγerD: eaawen n imumnen g eθbaθ n elimenensen s elmesiyH, d ewejeh n imuεelmen imzeyfen. elli yuri: emersal yuHenne. elli yemmeryasen: eljwabe blac elεelwan. elyemmeriyc y elkeniyseθ ettimεeyyent, yemenni y elberceθ δ elknayes d elmjameε, wθemmari zade y imumnen elkul g kul blace. esbeb n tires: ykan yuHenne δ ewessar, w kan ennette seg imersal elli yeqqiym yedder, w ykan δ eccaheδ d yesuwε elmesiyH. heδake εlac yuri yeljiyl ejδiδ seg imumnen bac e θebθen terni eθθiqθensen g rebbi d eliman.</para>
  <chapter number="1" style="c" sid="1JN 1" />
  <para style="s">elmesiyH, elkelmeθ n eddar</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 1:1" />exennari f elmuwDuwε n elkelmeθ n eddar, elli ykan seg emezwar, elli nesli, w elli nezri s θiTTewinenne, w elli nerqebθ enlemmesθ s ifesnenne <verse eid="1JN 1:1" /><verse number="2" style="v" sid="1JN 1:2" />eddare yban, nezri w esnecheδ, enbecrawem s eddar diyme elli ykan γer dadde w ybenane. <verse eid="1JN 1:2" /><verse number="3" style="v" sid="1JN 1:3" />nečin exenneHke elli nezri d elli nesli bac e θebδem Hette δ xenwuwm δ icriyxen iyδne emmax nečin d dadde d memmis yesuwε elmesiyH. <verse eid="1JN 1:3" /><verse number="4" style="v" sid="1JN 1:4" />w enteryawem g wahen bac e yeδwel elferHenne δ elkamel.<verse eid="1JN 1:4" /></para>
  <para style="s">rebbi δennuwr</para>
  <para style="p">
    <verse number="5" style="v" sid="1JN 1:5" />tay elbcareθ elli nesliyt s γers exentneHke, elli rebbi δtefuwθ eddiyc Hette eθsellesθ. <verse eid="1JN 1:5" /><verse number="6" style="v" sid="1JN 1:6" />max anen elli nečin iyδes w nečin negguwr g eθsellesθ raw nesxerxuws w entebbeεc g elHeq, <verse eid="1JN 1:6" /><verse number="7" style="v" sid="1JN 1:7" />emma max enuyuwr g θefuθ, emmax nette g θefuθ, eneδwel δ icriyxen d beεDne, w iδammen n memmis yesuwε etneĎfen δiyne seg elxĎaye elkul. <verse eid="1JN 1:7" /><verse number="8" style="v" sid="1JN 1:8" />max anen elli elγennac elxĎaye, enexδeε imenenne w elHeq muc δiyne. <verse eid="1JN 1:8" /><verse number="9" style="v" sid="1JN 1:9" />w max enesθeεref s elxĎeyenne raw nette liDellemc w δ elHeqq, w δexenyeγfer yneĎfane seg eccer elkul. <verse eid="1JN 1:9" /><verse number="10" style="v" sid="1JN 1:10" />max anen elli enneγliĎc, eθner yesxerxuws w θuθleyθes muc δiyne.<verse eid="1JN 1:10" /></para>
  <chapter eid="1JN 1" />
  <chapter number="2" style="c" sid="1JN 2" />
  <para style="s">elmesiyH ecfiεenne</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 2:1" />a idreriyw, tay δexennarye wahen bac e ltγeldemc, w max eyeγled iyjen essiyne, γenne yesuwε elmesiyH eSSaleH ecfiεenne γiyr dadde. <verse eid="1JN 2:1" /><verse number="2" style="v" sid="1JN 2:2" />nette δeDHiyyeθ n eγfar n elxĎeyenne, muc kan y nečin berk, emme y eddunyeθ elkul. <verse eid="1JN 2:2" /><verse number="3" style="v" sid="1JN 2:3" />w sahen enged eneδwel nessent mbelHeq, max eneTTef g elwSayeθes. <verse eid="1JN 2:3" /><verse number="4" style="v" sid="1JN 2:4" />elli ayen: "esnaθ" w elixeddemc s elwSayeθes yesxerwus, w elHeq muc δiys. <verse eid="1JN 2:4" /><verse number="5" style="v" sid="1JN 2:5" />emme elli eyeTTef g edwis, exse n rebbi eyekmel δiys mbelHeq. sahen enessen mbelHeq elli nečin g rebbi. <verse eid="1JN 2:5" /><verse number="6" style="v" sid="1JN 2:6" />elli ayen nette iyδes yelzem eyuwyur emmax i yyuwyur elmesiyH. <verse eid="1JN 2:6" /><verse number="7" style="v" sid="1JN 2:7" />emmeθniyw, exenteryac elwSiyyeθ ettejδit, emme elwSiyyeθ etteqδimt γerwem seg umezwar, elwSiyyeθe θeqδimt netteθ δ edwi elli θeslimt. <verse eid="1JN 2:7" /><verse number="8" style="v" sid="1JN 2:8" />w reγm wah, exennerye elwSiyyeθ ettejδit, yetban elHeqqes g elmesiyH w δiywem, εlexaTer eθsellesθ etteθεedde w θefuwθ teHeqqaniθ etDewwe. <verse eid="1JN 2:8" /><verse number="9" style="v" sid="1JN 2:9" />elli ayen nette g θefuwθ w eyeHqed enjes, elyuwc g eθsellesθ. <verse eid="1JN 2:9" /><verse number="10" style="v" sid="1JN 2:10" />w elli yexs enjes eyeθbet g θefuwθ, w δiyn eHebbec mat eθiseεθer. <verse eid="1JN 2:10" /><verse number="11" style="v" sid="1JN 2:11" />emme elli liγic enjes nette g eθsellesθ, w yegguwr g eθsellesθ, w elyessinc elmani δeyexDem εelexaTer eθsellesθ teεmayes θiTTewines. <verse eid="1JN 2:11" /><verse number="12" style="v" sid="1JN 2:12" />edreriw, y xenyum eθarye εelexaTer rebbi yeγfer elxĎeyennuwm f elxaĎer n elmesiyH. <verse eid="1JN 2:12" /><verse number="13" style="v" sid="1JN 2:13" />y iryazen, y xenwem eθerye εlexaTer θessenem elli ykan seg umezwar. elεzerre, y xenwem eθerye εlexaTer θeγlebem elli yege eccer. <verse eid="1JN 2:13" /><verse number="14" style="v" sid="1JN 2:14" />idreriw, y xenwem eθerye εlexaTer θessenem dadde. y iryazen, y xenwem eθerye εlexaTer θessenem elli ykan seg umezwar. elεzerre, y xenwem eθerye εlexaTer θeqwam w tuθleyθ n rebbi θeqwe δiywem w εlexaTer θeγlebem elli yege eccer. <verse eid="1JN 2:14" /><verse number="15" style="v" sid="1JN 2:15" />eθexsemc eddunyeθ d elli δiys, εlexaTer elli yexs eddunyeθ eddiyc exse n rebbi. <verse eid="1JN 2:15" /><verse number="16" style="v" sid="1JN 2:16" />elli g eddunyeθ elkul, eccehweθ n elbδen d eccehweθ n TiT d eθkebber g eddunyeθ, muc seg rebbi emme seg eddunyeθ. <verse eid="1JN 2:16" /><verse number="17" style="v" sid="1JN 2:17" />eddunyeθ δeθexDem s eccehweθes, emme elli ixeddem s edwi n rebbi e yeqqiym diyme. <verse eid="1JN 2:17" /><verse number="18" style="v" sid="1JN 2:18" />edreriw, essaεeθ teneggaruθ tuseδ, emmax i θesliym δeddasen leεδe n elmesiyH, w ture ellan egget leεδe, δ elεlameθ elli δ essaεeθ teneggaruθ. <verse eid="1JN 2:18" /><verse number="19" style="v" sid="1JN 2:19" />effeγen essiyne w elkanenc uggammesenne, εlexaTer lukan kanen uggammesenne raw ellan eqqiymen iδne, emme effeγensen fellane eybiyyen elli nihnin elkulhum elkanenc essiyne. <verse eid="1JN 2:19" /><verse number="20" style="v" sid="1JN 2:20" />emme xenyum temmesHem seg erruwH elqudus w θessenem elkul. <verse eid="1JN 2:20" /><verse number="21" style="v" sid="1JN 2:21" />eθerye y xenwem muc εlexaTer eltessinemc elHqiyqeθ emme εlexaTer θesnemt w θessenem elli θixerxas etteffeγnec seg elHeq. <verse eid="1JN 2:21" /><verse number="22" style="v" sid="1JN 2:22" />dwiyn ekeδδab? kan d elli eyenker elli yesuwε δ elmesiyH. d wahen elεδu elli inekker g dadde d memmis. <verse eid="1JN 2:22" /><verse number="23" style="v" sid="1JN 2:23" />w elli eyenker yesuwε eyenker erreb εlexaTer yesuwε δ memmis w erreb δ deddes. w elli eyesθεref s yesuwε γers δedde. <verse eid="1JN 2:23" /><verse number="24" style="v" sid="1JN 2:24" />edjeθ elli θeslimt seg emezwar eyeθbeθ diywem. max eyeθbeθ diywem elli θeslimt g emezwar, eθeθebθem g efrux d dadde. <verse eid="1JN 2:24" /><verse number="25" style="v" sid="1JN 2:25" />d wahen elli yuεδane essis, eddar diyme. <verse eid="1JN 2:25" /><verse number="26" style="v" sid="1JN 2:26" />eδerye wahen y xenwem f iddiynni elli etHewalen exennexδεen, <verse eid="1JN 2:26" /><verse number="27" style="v" sid="1JN 2:27" />emme y xenwem elmesHeθ elli tusδawem s γers teθbeθ diywem w ettesθHeqqimc δ wiyn exenyesseqre, εlexaTer elmesHθes tesseqre δiywem, w netteθ δ elHeq muc ettixerxas, w emmax i xentesseqre eθebθeθ diys. <verse eid="1JN 2:27" /><verse number="28" style="v" sid="1JN 2:28" />w ture, idrari, eθbθeθ δiys w max eyeffeγ elmesiyH enebδe emθebθiyn seg imenenne w ennetteθHeccimc essis max eyeddas. <verse eid="1JN 2:28" /><verse number="29" style="v" sid="1JN 2:29" />iδekan tessenem elli elmesiyH δ elHeq, esneθ elli kul iyjen yetteg g elHeq yemmaru esγiyr rebbi.<verse eid="1JN 2:29" /></para>
  <chapter eid="1JN 2" />
  <chapter number="3" style="c" sid="1JN 3" />
  <para style="s">yexs n rebbi yerreyane idrari n rebbi</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 3:1" />ereqbeθ menyeθ ixenyexes rebbi deddaθne bac e nemnabe edrari n rebbi, w nečin δ idreriys. iδekan eddunyeθ exentessinc raw εelexaTer edduwnyeθ eltessinc rebbi. <verse eid="1JN 3:1" /><verse number="2" style="v" sid="1JN 3:2" />a y elli exesγawem, nečin ture δ idrari n rebbi, w elyuci elibanc δ mette δeneδwel, emma nessen elli max eyeffeγ elmesiyH eneδwel m nette. εlexaTer δeθnezr f elHqiqθes. <verse eid="1JN 3:2" /><verse number="3" style="v" sid="1JN 3:3" />elli yetteθmenne g elmesiyH eyneĎĎef imenes emmax elmesiyH δundif. <verse eid="1JN 3:3" /><verse number="4" style="v" sid="1JN 3:4" />elli eyeγleĎ, ykesser ecceriyεeθ n rebbi, εelexaTer eγlaĎ δ eccer. <verse eid="1JN 3:4" /><verse number="5" style="v" sid="1JN 3:5" />tessenem elli elmesiyH yeffeγ bac e yekkes elγeldaθ, w nette eddiyc Hette elγeldeθ. <verse eid="1JN 3:5" /><verse number="6" style="v" sid="1JN 3:6" />elli eyeθbeθ felles liγelleĎc, elli eyeγleĎ, eyeδwel eθyezriyc w eθyessinc. <verse eid="1JN 3:6" /><verse number="7" style="v" sid="1JN 3:7" />edrariw, eθedjem Hette Hed exeniγuwc. elli ayeg elHeq raw nette f elHeq, emmax elmesiyH f elHeq. <verse eid="1JN 3:7" /><verse number="8" style="v" sid="1JN 3:8" />elli ayeg eccer raw seg ecciyĎan, εelexaTer ecciyĎan yeγleĎ seg emezwar. bac e yxerreb elli yegi ecciyĎan δ wah elli memmis n rebbi yused f elxeĎres. <verse eid="1JN 3:8" /><verse number="9" style="v" sid="1JN 3:9" />elli yemmaru g rebbi liγelleĎc, εelexaTer leHyeθ n rebbi teθbeθ diys, w eligeddec eyeγleĎ εelexaTer yemmaru g rebbi. <verse eid="1JN 3:9" /><verse number="10" style="v" sid="1JN 3:10" />elli elyettegc elHeq muc esγiyr rebbi Hette δ elli eliγic emmeθnes, w sahen emmesnen idrari n rebbi d idrari n ecciyĎan:<verse eid="1JN 3:10" /></para>
  <para style="s">exseθ beεDkum beεeD</para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 3:11" />w elewSiyyeθ elli θesliymteθ seg emezwar elli yelzem anexs beεeĎne. <verse eid="1JN 3:11" /><verse number="12" style="v" sid="1JN 3:12" />meyelzemc enkun emqabiyl elli ykan seg ecciyĎan yenγ enjes. w imette iθyenγe? εelexaTer yege eccer w enjes yege elHeq. <verse eid="1JN 3:12" /><verse number="13" style="v" sid="1JN 3:13" />emmeθniyw, eθesθeγrbemc max exennekrhen leεbaδ elkul. <verse eid="1JN 3:13" /><verse number="14" style="v" sid="1JN 3:14" />nessen elli nečin neθεedde seg ejafi y eddar εelexaTer nexs emmeθnenne. elli eliγic eyeqqiym g ejafi. <verse eid="1JN 3:14" /><verse number="15" style="v" sid="1JN 3:15" />elli eliγic emmeθnes δ eseffaH, w θessenem elli eseffaH liθebbeθc δiys eddar diyme. <verse eid="1JN 3:15" /><verse number="16" style="v" sid="1JN 3:16" />w nečin nessen exse max i DeHHe yesuwε s imenes f elxaĎrenne, heδake εlac yelzem enDeHHe s imenenne f elxaĎer n emmeθnenne. <verse eid="1JN 3:16" /><verse number="17" style="v" sid="1JN 3:17" />iδekan iyjen γers elxiyraθ n edduwnyeθ yezr enjes elγrec usiyn eysekker ules felles, max δeθeθbeθ δiys exse n rebbi? <verse eid="1JN 3:17" /><verse number="18" style="v" sid="1JN 3:18" />idrariw, eθexsemc s edwi ziyγ s iyles, yemenni exseθ s elfεel d elHeq.<verse eid="1JN 3:18" /></para>
  <para style="s">eθθiqaθ ezzeθ n rabbiy</para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 3:19" />w sahen enessen elli nečin seg elHeq, enriyyeH ulewnenne ezzaθ n rebbi, <verse eid="1JN 3:19" /><verse number="20" style="v" sid="1JN 3:20" />Hette max exenneεrxen ulewnenne, εelexaTer rebbi ekber n ulawnenne w yessen kul cey. <verse eid="1JN 3:20" /><verse number="21" style="v" sid="1JN 3:21" />a yelli exesγawem, iδekan ulawnenne exenεerxenc, γenne eθθiyqeθ ezzaθ n rebbi, <verse eid="1JN 3:21" /><verse number="22" style="v" sid="1JN 3:22" />w δenawi seg γers elli eneĎleb, εelexaTer neHfeD elwSiyyeθes w netteg elli yetreDDe δiys. <verse eid="1JN 3:22" /><verse number="23" style="v" sid="1JN 3:23" />w elewSiyyeθes, enemmen s ellessem n memmis yesuwε elmesiyH, nexs beεeĎne emmax i xeniweSSe. <verse eid="1JN 3:23" /><verse number="24" style="v" sid="1JN 3:24" />elli eyexδem s elwSiyyeθ n rebbi eyeθbeθ g rebbi w rebbi eyeθbeθ δiys. w s erruwH elli yuceyenext enessen elli nette yeθbeθ δiyne.<verse eid="1JN 3:24" /></para>
  <chapter eid="1JN 3" />
  <chapter number="4" style="c" sid="1JN 4" />
  <para style="s">erruH n elHeq d erruH n elbaTel</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 4:1" />a y elli exesγawem, eθSedqemc lerwaH elkul, emma jerbemten bac e θesnem esγiyr rebbi ziyγ la, εelexaTer egget lenebya elli esxerxuwsen useδen y edduwnyeθe. <verse eid="1JN 4:1" /><verse number="2" style="v" sid="1JN 4:2" />erruwH n rebbi ettesnem s wahen: kul erruwH eθesθeεref elli yesuwε elmesiyH raw yuseδ g elebδen esγiyr rebbi, <verse eid="1JN 4:2" /><verse number="3" style="v" sid="1JN 4:3" />w kul erruwH ettesθeεriyfc s yesuwε, raw muc seg rebbi emma δ erruwH n elεδu elli θesliym δeyeddes, w ture nette g edduwnyeθ. <verse eid="1JN 4:3" /><verse number="4" style="v" sid="1JN 4:4" />idrariw, xenwem esγiyr rebbi, w θeγlebem leεδe εelexaTer rebbi elli δiywem eqwe n ecciyĎan elli g edduwnyeθ. <verse eid="1JN 4:4" /><verse number="5" style="v" sid="1JN 4:5" />niyhniyn seg edduwnyeθ, w elli eqqaren δiys seg edduwnyeθ, w edduwnyeθ tessaγDe δiysen. <verse eid="1JN 4:5" /><verse number="6" style="v" sid="1JN 4:6" />nečin esγiyr rebbi, elli yessen rebbi exenyesseγeD, elli elyessiynec rebbi exenyesseγDiyc. s wahen enessen erruwH n elHeq seg erruwH n elbaTel.<verse eid="1JN 4:6" /></para>
  <para style="s">rebbi δ exse</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 4:7" />a y elli exesγawem, edj anexs beεeĎne εelexaTer exse seg rebbi, elli yexs yemmaru seg rebbi w yessen rebbi. <verse eid="1JN 4:7" /><verse number="8" style="v" sid="1JN 4:8" />elli eliγic elyessiynec rebbi, εelexaTe rebbi δ exse. <verse eid="1JN 4:8" /><verse number="9" style="v" sid="1JN 4:9" />w sahen yessexnane rebbi exsas: yuzen memmis elli γers kan ennette y nečin bac e nedder essis. <verse eid="1JN 4:9" /><verse number="10" style="v" sid="1JN 4:10" />tay exse, nečin ennexsiyc rebbi yemenni ennette elli yexsane yazen memmis δ eĎHeyyeθ bac e yefδe leγlaĎenne.<verse eid="1JN 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 4:11" />a y elli exesγawem, iδekan rebbi sahen yexsane, nečin zade yelzem enexs beεeĎne. <verse eid="1JN 4:11" /><verse number="12" style="v" sid="1JN 4:12" />Hette elεebδ elyezri rebbi. max anexs beεeĎne eyeθbeθ rebbi δiyne yekmel exsas δiyne. <verse eid="1JN 4:12" /><verse number="13" style="v" sid="1JN 4:13" />w sahen enessen elli nečin neθbeθ g rebbi w rebbi yeθbeθ diyne, εelexaTer yuceyane erruHes. <verse eid="1JN 4:13" /><verse number="14" style="v" sid="1JN 4:14" />w nečin nezre w encehheδ elli dadde yuzen memmis bac e ymenneε edduwnyeθ. <verse eid="1JN 4:14" /><verse number="15" style="v" sid="1JN 4:15" />elli eyesθeεref s yesuwε δ memmis n rebbi, eyeθbeθ δiys rebbi w nette eyeθbeθ g rebbi. <verse eid="1JN 4:15" /><verse number="16" style="v" sid="1JN 4:16" />nečin nessen w nettemmen s exse n rebbi y nečin. rebbi δ exse, elli eyeθbeθ g exse eyeθbeθ g rebbi w rebbi eyeθbeθ diys. <verse eid="1JN 4:16" /><verse number="17" style="v" sid="1JN 4:17" />εelexaTer nečin g edduwnyeθe emmax elmesiyH siyn, enebδe weθqiyn g as n eleHsab. w sahen eyekmel exse δiyne. <verse eid="1JN 4:17" /><verse number="18" style="v" sid="1JN 4:18" />leHebbac e lxuwf g exse, emma exse elkamel yetgelleb elxuwf. elxuwf seg elεquwbeθ, elli yettekeδ exsas elyekmilc. <verse eid="1JN 4:18" /><verse number="19" style="v" sid="1JN 4:19" />nečin nexs εelexaTer nette yexsane qebl. <verse eid="1JN 4:19" /><verse number="20" style="v" sid="1JN 4:20" />iδekan iyjen ayen: "neč exse rebbi." w nette eliγic enjes, yesxerxus, εelexaTer elli eliγic enjes elli yzer δiys, eligeddec ayexs rebbi elli eθizerrec. <verse eid="1JN 4:20" /><verse number="21" style="v" sid="1JN 4:21" />w elewSiyyeθe seg elmesiyH y nečin: elli yexs rebbi yelzem ayexs enjes zade.<verse eid="1JN 4:21" /></para>
  <chapter eid="1JN 4" />
  <chapter number="5" style="c" sid="1JN 5" />
  <para style="s">eliman yθuč eθγelleb f elεelem</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 5:1" />kul iyjen yettemmen elli yesuwε nette δ elmesiyH, yemmaru seg rebbi, elli yexs daddeθne ayexs memmis zade. <verse eid="1JN 5:1" /><verse number="2" style="v" sid="1JN 5:2" />w nečin nessen elli nexs idrari n rebbi max enebδe nexs rebbi w nxeddem s elewSiyyeθes. <verse eid="1JN 5:2" /><verse number="3" style="v" sid="1JN 5:3" />δ wahen exse n rebbi: enexδem s elewSiyyeθes. w elewSiyyeθes elteδqilnec, <verse eid="1JN 5:3" /><verse number="4" style="v" sid="1JN 5:4" />εelexaTer elli yemmaru g rebbi iγelleb g edduwnyeθ. w emmenenne nette δeγlab n edduwnyeθ. <verse eid="1JN 5:4" /><verse number="5" style="v" sid="1JN 5:5" />δ wiyn eyeγleb edduwnyeθ? kan δ elli yettemmen elli yesuwε δ memmis n rebbi.<verse eid="1JN 5:5" /></para>
  <para style="s">echδeθ y yesuwε elmesiyH</para>
  <para style="p">
    <verse number="6" style="v" sid="1JN 5:6" />wahen elli yuseδ nette δ yesuwε elmesiyH, yuseδ s amen d iδemmen, muc s amen berk emma s amen d iδemmen. w erruwH netteθ elli eθecheδ s elmesiyH. <verse eid="1JN 5:6" /><verse number="7" style="v" sid="1JN 5:7" />w ellan tlaθe δ eccuwhhaδ: <verse eid="1JN 5:7" /><verse number="8" style="v" sid="1JN 5:8" />erruwH d amen d iδemmen, w letlaθe δ imeθfahmen. <verse eid="1JN 5:8" /><verse number="9" style="v" sid="1JN 5:9" />kan neqbel echaδeθ n leεbaδ, echaδeθ n rebbi ekber. w θahen δ echaδeθ n rebbi f memmis. <verse eid="1JN 5:9" /><verse number="10" style="v" sid="1JN 5:10" />elli yettemmen g memmis n rebbi γers echaδetdiyn. elli elyettemmenc g rebbi eθyer δ elkaδeb, εelexaTer elyemminc g echaδeθ elli yucit y memmis. <verse eid="1JN 5:10" /><verse number="11" style="v" sid="1JN 5:11" />w echaδeθ δ tahen: rebbi yuceyane eddar y diyme, w eddare g memmis. <verse eid="1JN 5:11" /><verse number="12" style="v" sid="1JN 5:12" />elli γers efrux γers eddar, elli elγrec memmis n rebbi elγrec eddar diyme.<verse eid="1JN 5:12" /></para>
  <para style="s">eddar diyme</para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 5:13" />ettarye g wahen y xenwem elli ettemnem g ellesem n memmis n rebbi, bac e θesnem elli γerwem eddar y diyme. <verse eid="1JN 5:13" /><verse number="14" style="v" sid="1JN 5:14" />w δ tahen eθθiqθenne δiys: max eneĎleb Haje eθwate enniyyeθ n rebbi, eysel. <verse eid="1JN 5:14" /><verse number="15" style="v" sid="1JN 5:15" />w iδekan nessen elli nette ysel diyne g elli eneĎleb elkul, enessen elli δenawi elli neĎlebθ s γers.<verse eid="1JN 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 5:16" />elli eyzer essiywem enjes yetteg g elγeldeθ eltneqqec, yelzem eyeĎleb seg rebbi bac e syuwc eddar. usinc esyuwc. wahen y iyh elli ettegen g elγeldaθ enneqnec. emma telle elγeldeθ tneq, exenneqqerac ezzalleθ f elxaĎrensen. <verse eid="1JN 5:16" /><verse number="17" style="v" sid="1JN 5:17" />kul ege δ elγaleδ δ elγeldeθ, emma ellaneθ elγeldaθ enneqnec. <verse eid="1JN 5:17" /><verse number="18" style="v" sid="1JN 5:18" />nessen elli kul iyjen yemmaru g rebbi elyettegc elγeldaθ, elli yemmaru g rebbi yetεus felles w eccer eligeddec esyeqreb.<verse eid="1JN 5:18" /></para>
  <para style="s">elxatmeθ</para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 5:19" />nessen elli nečin seg rebbi, w elli edduwnyeθ elkul seddu elquwweθ n eccer. <verse eid="1JN 5:19" /><verse number="20" style="v" sid="1JN 5:20" />w nessen elli memmis n rebbi yuseδ w yuceyane efham bac e nessen essis elHeq. w nečin g elHeq, g memmis yesuwε elmesiyH. δ wahen rebbi mbelHeq d eddar diyme. <verse eid="1JN 5:20" /><verse number="21" style="v" sid="1JN 5:21" />idrariw, erreθ elbalennum seg leSneb.<verse eid="1JN 5:21" /></para>
  <chapter eid="1JN 5" />
</usx>