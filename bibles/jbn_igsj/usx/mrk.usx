<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MRK" style="id" />
  <para style="h">Mark</para>
  <para style="toc1">kitabu merqus</para>
  <para style="toc2">Mark</para>
  <para style="toc3">MRK</para>
  <para style="mt1">kitabu merqus</para>
  <chapter number="1" style="c" sid="MRK 1" />
  <para style="s">yeffeγ yuwHenna elmeεmdan</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1" />tebδe elbcareθ s yesuwε elmesiyH<note caller="+" style="f"><char style="fr" closed="false">1.1 </char><char style="ft" closed="false">elmesiyH - yeεni elli yemmenγel felles uwδi. emelmlek elli yexθari rebbi yemmenγel felles uwδi seg enbi nrebbi (1 Sm 10:1).</char></note> memmis nrebbi<note caller="+" style="f"><char style="fr" closed="false">1.1 </char><char style="ft" closed="false">memmis nrebbi - meεnahe γer iyehuwdiyyen ezzerriyεeθ ndawud uγer elli muc δyehuwdi meεnahe eryaz elli δimqeddes seg rebbi (1 Sm 7:8; mz 2:7)</char></note>, <verse eid="MRK 1:1" /><verse number="2" style="v" sid="MRK 1:2" />max i yuri enbi icεiyya: «tay δeθezne ezzaθ nuδmex emerseliyw, elli δexiged ebriδex. <verse eid="MRK 1:2" /><verse number="3" style="v" sid="MRK 1:3" />elziwiyn yetzeεweg g essewweθ, &lt;geddeθ ebriδ n erreb, egmas ikeyyesnes δimsegmen.&gt;» <verse eid="MRK 1:3" /><verse number="4" style="v" sid="MRK 1:4" />yeffeγ yuwHenna elmeεmdan g essewweθ yetnabe g leεbaδ yeθmeεmuwdiyyeθ<note caller="+" style="f"><char style="fr" closed="false">1.4 </char><char style="ft" closed="false">meεmuwdiyyeθ muc δelfekreθ ettejδiyt. max i yjen muc δyehuwdi eyerjeε yeddiyn eyehuwdiy, yelzem eyεemmeδ imenes ezzaθ neccuhhaδ. yemenni elHajeθ tejδiyt utuγribθ yiyehuwdiyyen netteθ elli iyehuwdiyyen elli emmexθaren seg rebbi yelzemhum zade enedmen eθεemden.</char></note>, ellemareθ nettuwbeθ bac e mmeγferneθ leδnubensen. <verse eid="MRK 1:4" /><verse number="5" style="v" sid="MRK 1:5" />ukanen etteffeγnas seg θemuwreθ nyehuwdiyye duwrceliym elkul usiyn eniεemmeδ g esuwf nelurdun unihnin eqqaren g leδnubensen. <verse eid="MRK 1:5" /><verse number="6" style="v" sid="MRK 1:6" />yuwHenna ykan iraδ edbac s unuwber nileγman, wessebθeθ nwiliym f elHzemes, uyedder f buwrγas ettamemt teberriyθ. <verse eid="MRK 1:6" /><verse number="7" style="v" sid="MRK 1:7" />w ykan yeqqar: «δeyeddes beεδiyw δ wiyn eqwaw, δ wiyn ettesθehilac Hette etebSe miyrγas tilelli neSSendeles. <verse eid="MRK 1:7" /><verse number="8" style="v" sid="MRK 1:8" />neč eεmeδγawem s wamen, yemenni nette δexenyεemmeδ s erruwH nelqudus.»<verse eid="MRK 1:8" /></para>
  <para style="s">yuwHenna yεemmeδ yesuwε</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9" />g liyyametdiyn yuseδ yesuwε seg ennaSreh elli g eljliyl yeθεemmeδ f wafus nyuwHenna g esuwf nelurdun. <verse eid="MRK 1:9" /><verse number="10" style="v" sid="MRK 1:10" />g elweqθelli yuwli yesuwε seg amen yezre esmawaθ mirneθ werruwH nelqudus etteggez felles emteδbiyrθ. <verse eid="MRK 1:10" /><verse number="11" style="v" sid="MRK 1:11" />yeggez eSSuwθ seg esme: «cex δmemmi elli exsγex, wessix efreHe egget.»<verse eid="MRK 1:11" /></para>
  <para style="s">ecciyĎan eyjerreb yesuwε</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12" />elweqθes tessuwfeγθ erruwH nelqudus yessewweθ, <verse eid="MRK 1:12" /><verse number="13" style="v" sid="MRK 1:13" />yeqqiym diyn erbεiyn yuwm yetjerreb δiys ecciyĎan, elhwayec kanneθ iyδes, welmlayxe kanneθ xeddemneθ δiys.<verse eid="MRK 1:13" /></para>
  <para style="s">yesuwε g eljliyl: etlamδe iglewlen</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14" />max i yemmeTTef yuwHenna, yuseδ yesuwε yeljliyl yetbeccer s elbcareθ nrebbi, <verse eid="MRK 1:14" /><verse number="15" style="v" sid="MRK 1:15" />uyeqqar: «yiweD elweqθ, teqreb elmemlxeθ nrebbi<note caller="+" style="f"><char style="fr" closed="false">1.15 </char><char style="ft" closed="false">meεnahe rebbi dah bac e yeHkem kul Hed.</char></note>, tuwbeθ, temnem s elYinjiyl.»<verse eid="MRK 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16" />unette yegguwr f eccafeθ niylel neljliyl yezer sen δiSeyyaδen semεan dunjes endrawus etlewHen g eccebkθensen g iylel, <verse eid="MRK 1:16" /><verse number="17" style="v" sid="MRK 1:17" />yennasen yesuwε: «eθbeεmiyδ ture exennerre ettetfem g leεbaδ.» <verse eid="MRK 1:17" /><verse number="18" style="v" sid="MRK 1:18" />elweqθes seyben lecbekensen eθbεent <verse eid="MRK 1:18" /><verse number="19" style="v" sid="MRK 1:19" />yuyuwr qiqqi yezer yeεquwb dunjes yuwHenna, idrari nzebediy, g elfluwkθensen etgedden g lecbekensen. <verse eid="MRK 1:19" /><verse number="20" style="v" sid="MRK 1:20" />inebaθen liyhliyh, edjen daddensen zebedi g elfluwkeθ nette dixeddemnes eθbεent.<verse eid="MRK 1:20" /></para>
  <para style="s">yesuwε eygelleb erruwH ettemenzuwsθ</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21" />eδfen θemuwreθ nkefernaHuwm, elweqθes yaδef yelmejmeε g essebθ<note caller="+" style="f"><char style="fr" closed="false">1.21 </char><char style="ft" closed="false">essebθ - as nerraHeθ elli iyehuwdiyyen tegen δiys kan δelεaδeθ.</char></note> yebδe yetseqre. <verse eid="MRK 1:21" /><verse number="22" style="v" sid="MRK 1:22" />esθeγerben seg eseqriys, εlexaTer ykan yetseqre δiysen emelziwiyn γer-s eSSulTan, muc emimuεelmen necceriyεeθ. <verse eid="MRK 1:22" /><verse number="23" style="v" sid="MRK 1:23" />elweqθes ykan g elmejmeε eryaz δiys erruwH temenzuwsθ, yebδe yetzeεweg: <verse eid="MRK 1:23" /><verse number="24" style="v" sid="MRK 1:24" />«ac ihemmek δiyne, eyesuwε ennaSriy? endre tuseδeδ bac e xentehlxeδ? neč essene δ wiyn cex, eqedduws nrebbi!» <verse eid="MRK 1:24" /><verse number="25" style="v" sid="MRK 1:25" />yenzer felles yesuwε yennes: «esger, tefγeδ seg weryaz!» <verse eid="MRK 1:25" /><verse number="26" style="v" sid="MRK 1:26" />tessender erruwH temenzuwsθ eryazdiyn. izeεweg etzeεwiygeθ temeqqarθ teffeγ essis. <verse eid="MRK 1:26" /><verse number="27" style="v" sid="MRK 1:27" />esθeγerben leεbaδ elkul encδen beεDhum: «δme wahen? eseqri δejδiyδ s eSSulTan! Hette δlerwaH timenzas selneθ g edwiys!» <verse eid="MRK 1:27" /><verse number="28" style="v" sid="MRK 1:28" />elweqθes yemmencer elxebres g eljliyl elkul.<verse eid="MRK 1:28" /></para>
  <para style="s">ebre ntensiybeθ nbuTrus</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29" />max i fγen seg elmejmeε, yuwδef nette dyeεquwb dyuwHenna yelHuwc nsemεan dendrawus. <verse eid="MRK 1:29" /><verse number="30" style="v" sid="MRK 1:30" />tewessarθ nsemεan tkan tenεes s esxaneθ, elweqθes ennanes felles. <verse eid="MRK 1:30" /><verse number="31" style="v" sid="MRK 1:31" />yeqreb yetweliys yeTTeft seg wefuses yessikkert. texDem felles esxaneθ tekker txeddem δiysen.<verse eid="MRK 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32" />g tisemsiyn, beεεeδ eggaz ntefuwθ, uγeδnes imuwDan elkul delli δiysen ecyaĎen. <verse eid="MRK 1:32" /><verse number="33" style="v" sid="MRK 1:33" />temlayem θemuwreθ elkul f elbab, <verse eid="MRK 1:33" /><verse number="34" style="v" sid="MRK 1:34" />ysebre leεbaδ egget kul Hed s weTTenes, igelleb ecyaĎen egget, welyedjiyc ecyaĎen eδuθleyen εlexaTer esnent.<verse eid="MRK 1:34" /></para>
  <para style="s">ebeccer g eljliyl</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35" />yekker qebl elfjer yexDem yelxle, yebδe yetzalle diyn. <verse eid="MRK 1:35" /><verse number="36" style="v" sid="MRK 1:36" />Hewmen felles semεan dimeddukeles, <verse eid="MRK 1:36" /><verse number="37" style="v" sid="MRK 1:37" />max i θuwfin ennanes: «leεbaδ elkul etHewmen δiyx.» <verse eid="MRK 1:37" /><verse number="38" style="v" sid="MRK 1:38" />yennasen: «heyyeθ, enexDem ytimuwre tiddiynni bac e becre δiysneθ zade, εlexaTer neč effeγe ywahen.» <verse eid="MRK 1:38" /><verse number="39" style="v" sid="MRK 1:39" />yenneD g eljliyl elkul, yetbeccer g elmjemεensen uyetgelleb g ecyaĎen.<verse eid="MRK 1:39" /></para>
  <para style="s">ebre nunebraS</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40" />yesδes iyjen γer-s eTTen δemeqqar g eljildes<note caller="+" style="f"><char style="fr" closed="false">1.40 </char><char style="ft" closed="false">eTTen δemeqqar g eljildes - elli eyaDen essis eθgelben elberre ntemuwreθ εlexaTer muc δundif uδimuεδi</char></note> yetmelges, yesjeδ yennes: «kan texseδ, eθgeddeδ eyeθneĎfeδ.» <verse eid="MRK 1:40" /><verse number="41" style="v" sid="MRK 1:41" />yesxef felles yesuwε yezzel efuses ilemmesθ yennes: «exse, endaf!» <verse eid="MRK 1:41" /><verse number="42" style="v" sid="MRK 1:42" />liyhliyh yebre ebreSes yendaf. <verse eid="MRK 1:42" /><verse number="43" style="v" sid="MRK 1:43" />inebbeh felles yesuwε eSbiyH yezent, <verse eid="MRK 1:43" /><verse number="44" style="v" sid="MRK 1:44" />yennes: «esliyδ, eθenneδ Hette cey yHette Hed, emme berre yelkahen<note caller="+" style="f"><char style="fr" closed="false">1.44 </char><char style="ft" closed="false">elkahen - nette δeryaz elli yettelhe s elheykel wiγerres g elheykel. yedzalle s leεbaδ uyetεawen leεbaδ bac e snen rebbi webriδ nrebbi.</char></note> tessexndes imenex, tuwceδ elweεδeθ n webrax elli yweSSat muwse, δelHejjeθ yleεbaδ.» <verse eid="MRK 1:44" /><verse number="45" style="v" sid="MRK 1:45" />yaxi yeffeγ eryazdiyn yebδe yeqqar yleεbaδ g imxanen elkul. yeδwel yesuwε eligeddec eyaδef ytemuwreθ ezzaθ nleεbaδ. yeεmer g elxle. uleεbaδ kanen etteseδnes seg imxanen elkul.<verse eid="MRK 1:45" /></para>
  <chapter eid="MRK 1" />
  <chapter number="2" style="c" sid="MRK 2" />
  <para style="s">ebre nelεayeb g kefernaHuwm</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1" />beεεeδ liyyam yeδwel yesuwε ykefernaHuwm, eslen leεbaδ elli nette g elHuwc. <verse eid="MRK 2:1" /><verse number="2" style="v" sid="MRK 2:2" />emlaymen leεbaδ egget εebben emxan eliymi nelHuwc, yesseqraθen s edwi nrebbi. <verse eid="MRK 2:2" /><verse number="3" style="v" sid="MRK 2:3" />eseδnes erbεe δiryazen qamen iyjen δelεayeb. <verse eid="MRK 2:3" /><verse number="4" style="v" sid="MRK 2:4" />max elgeddenc eθewDen essis εlexaTer leεbaδ egget, snuqben esqef elli δenni yesuwε essugzen esyiyn elεayebdiyn g eθjerreyθes. <verse eid="MRK 2:4" /><verse number="5" style="v" sid="MRK 2:5" />max i yezre yesuwε elimenensen yennayes yelεayebdiyn: «emmi, leδnubex elkul emmeγferneθ!» <verse eid="MRK 2:5" /><verse number="6" style="v" sid="MRK 2:6" />uggemmes nleεbaδdiyn kanen ellan imuεelmen necceriyεeθ, ennen g ulewnensen: <verse eid="MRK 2:6" /><verse number="7" style="v" sid="MRK 2:7" />«ecbiyh eryaze iδukke sahen? wahen δelkeffer! δ wiyn iged eyeγfer leδnuwb bexlaf rebbi weHδes?» <verse eid="MRK 2:7" /><verse number="8" style="v" sid="MRK 2:8" />elweqθes yexez yesuwε g ules elli etxememen δiys, yennasen: «ecbiykum etxememem f elHajaθe g ulewnennum? <verse eid="MRK 2:8" /><verse number="9" style="v" sid="MRK 2:9" />esyemmen yelεayebe &lt;leδnubex emmeγferneθ.&gt; eshel nelli esyemmen &lt;ekker qam tejerreyθex tuyuwreδ.&gt;. <verse eid="MRK 2:9" /><verse number="10" style="v" sid="MRK 2:10" />tay δexennessexne elli neč bnaδem<note caller="+" style="f"><char style="fr" closed="false">2.10 </char><char style="ft" closed="false">bnaδem - enzi daniyal 7:13-14. yesuwε yumken yesθeεmel elkelmeθ bnaδem bac e ysexn elli nette δeryaz nesme elli g tirjiyθ nenbi daniyal.</char></note> γeri elquδreθ bac e γefre leδnuwb g elqeεεeθ.» yennes yelεayeb: <verse eid="MRK 2:10" /><verse number="11" style="v" sid="MRK 2:11" />«enniyγex ekker tqameδ tejerreyθex trewHeδ yelHucex!» <verse eid="MRK 2:11" /><verse number="12" style="v" sid="MRK 2:12" />yekker yqam tejerreyθes liyhliyh yeffeγ ezzaθ nleεbaδ elkul. esθeγerben usiyn mejδen rebbi ennen: «elεemrenne wennezri elHajeθ emtah!»<verse eid="MRK 2:12" /></para>
  <para style="s">yesuwε inabe lawiy</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13" />yeδwel yesuwε elmerreθ xlaf yecceT niylel neljliyl. eseδnes leεbaδ egget yebδe yetseqre δiysen.<verse eid="MRK 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 2:14" />unette meθεeddi yezre lawi memmis nHelfe ygeεmez g elbiyt neljbayeθ. yennes yesuwε: «eθbεiyδ!» yekker yeθbeεθ. <verse eid="MRK 2:14" /><verse number="15" style="v" sid="MRK 2:15" />elweqθelli ykan yesuwε iθet g elHuwc nlawiy, eqqiymen egget seg eljmaεeθ neljbayeθ dihelli muc SaleH iyδes nette detlemδas, εlexaTer egget essisen kanen diyn exelden f elles. <verse eid="MRK 2:15" /><verse number="16" style="v" sid="MRK 2:16" />max i θezriyn imuεelmen necceriyεeθ seg ifarisiyyen<note caller="+" style="f"><char style="fr" closed="false">2.16 </char><char style="ft" closed="false">ifarisiyyen - nihnin seg uδayen d iryazen n elHezb n ecceriyεeθ d esyaseθ. etxememen elli nihnin δuSHiHen exθer nelεebδ iddiyn εlexaTerhum θebεen egget elεaδeθ nlejdad.</char></note> iθet deljmaεeθ neljbayeθ dihelli muc SaleH, ennen yetlemδas: «ecbiyh iθet wises deljmaεeθ neljbayeθ delli muc SaleH?» <verse eid="MRK 2:16" /><verse number="17" style="v" sid="MRK 2:17" />yesliyn yesuwε, yennasen: «ihelli δuSHiHen ettesθHeqqiync eĎbiyb, emme imuwDan ettesθHeqqen. useδe bac e nabiyγ elli γleĎen muc eSSuwlleH.»<verse eid="MRK 2:17" /></para>
  <para style="s">ezuwmi</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18" />ukanen etlamδe nyuwHenna elmeεmdan difarisiyyen zuwmen, esδen leεbaδ yyesuwε ennanes: «ecbiyhum etlamδe nyuwHenna elmeεmdan difarisiyyen etzuwmen yemenni etlemδax etzuwmenc?» <verse eid="MRK 2:18" /><verse number="19" style="v" sid="MRK 2:19" />yennasen: «egedden iθbab nislan ezuwmen maδame elεriys uggemmesensen? maδame elεriys uggemmesensen elgeddenc ezuwmen. <verse eid="MRK 2:19" /><verse number="20" style="v" sid="MRK 2:20" />emme δeyeddes as eyemqam elεriys seg wemmesensen elweqθes ezuwmen. <verse eid="MRK 2:20" /><verse number="21" style="v" sid="MRK 2:21" />midden etreqεenc edbac δiqδiymen stekettent ettejδiyt bac e ltxemmecec tekkes qiqqi s eg weqδiym twesseε ecerrex. <verse eid="MRK 2:21" /><verse number="22" style="v" sid="MRK 2:22" />wenneqlenc ecrab δejδiyδ g elmezweδ δeqδiym bac e θyečerrexc. yexDem ecrab delmezweδ zade. emme ecrab ejδiyδ yelzme elmezweδ δejδiyδ!»<verse eid="MRK 2:22" /></para>
  <para style="s">essebθ</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23" />yeθεedde as nessebθ uggemmes nimendi, ebδen etlemδas etteksen g tisbal unihnin egguwren. <verse eid="MRK 2:23" /><verse number="24" style="v" sid="MRK 2:24" />ennanes ifarisiyyen: «erqeb, ecbiyhum etlemδax ettegen elHajaθ etHelnec as nessebθ?» <verse eid="MRK 2:24" /><verse number="25" style="v" sid="MRK 2:25" />yennasen: «endre elteqriymc δmette iyege dawud max i yelluwz nette diryeznes? <verse eid="MRK 2:25" /><verse number="26" style="v" sid="MRK 2:26" />max i yuwδef yelHuwc nrebbi, max i ykan ebyatar δemeqqar nelkuhhan, yeč eγrum nelqurban yuwc essis yiryeznes, welyetHellec ečen essis kan δelkuhhan.» <verse eid="MRK 2:26" /><verse number="27" style="v" sid="MRK 2:27" />yen yesuwε: «rebbi yege essebθ yleεbaδ, muc leεbaδ yessebθ. <verse eid="MRK 2:27" /><verse number="28" style="v" sid="MRK 2:28" />bnaδem δsiydiys nessebθ zade.»<verse eid="MRK 2:28" /></para>
  <chapter eid="MRK 2" />
  <chapter number="3" style="c" sid="MRK 3" />
  <para style="s">esebri g essebθ</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1" />yeδwel yesuwε yelmejmeε, yaf diyn eryaz efuses yeqquwr. <verse eid="MRK 3:1" /><verse number="2" style="v" sid="MRK 3:2" />ebδen leεbaδ elli diyn etεusnas kan δeθysebre g essebθ δeθettehmen. <verse eid="MRK 3:2" /><verse number="3" style="v" sid="MRK 3:3" />yennes yweryaz elli efuses yeqquwr: «bed uggemmes!» <verse eid="MRK 3:3" /><verse number="4" style="v" sid="MRK 3:4" />yennasen: «mat iθenne ecceriyεeθ? as nessebθ eneg elxiyr ziyγ δeccer? enmenneε ennefs ziyγ etnehlex?» yemenni esegren. <verse eid="MRK 3:4" /><verse number="5" style="v" sid="MRK 3:5" />yerqbasen δimeθγeccec Hziyn seg elqSaHeθ nulewnensen, yennes yweryazdiyn: «ezzel efusex!» yezzelt yebre emwissen. <verse eid="MRK 3:5" /><verse number="6" style="v" sid="MRK 3:6" />efγen ifarisiyyen θfahmen nihnin delHezb nhiyruwdus<note caller="+" style="f"><char style="fr" closed="false">3.6 </char><char style="ft" closed="false">delHezb nhiyruwdus - leεbaδ elli θebεen elHakem hiyruwdus</char></note> max δenγen yesuwε.<verse eid="MRK 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7" />yexDem nette detlemδas yiylel neljliyl, eθbεent leεbaδ egget seg eljliyl dyehuwdiyye, <verse eid="MRK 3:7" /><verse number="8" style="v" sid="MRK 3:8" />duwrceliym decciyreθ neduwmiyye decciyreθ elli δeffer esuwf nelurdun delmdiyneθ nSuwr dSeyda. iyhen elkulhum sliyn s elli yegi yesuwε elkul, eseδnes. <verse eid="MRK 3:8" /><verse number="9" style="v" sid="MRK 3:9" />yennasen yetlemδas esHeDren elfluwkeθ bac e ttemleyimenc felles, <verse eid="MRK 3:9" /><verse number="10" style="v" sid="MRK 3:10" />εlexaTer ysebre leεbaδ egget, ebδen imuwDan elkul exsen eθlemsen. <verse eid="MRK 3:10" /><verse number="11" style="v" sid="MRK 3:11" />welli kanen δiysen lerwaH timenzas sjeδen max i θezriyn zeεwgen: «cex dmemmis nrebbi!» <verse eid="MRK 3:11" /><verse number="12" style="v" sid="MRK 3:12" />yenzer fellasen bac e θfeDHenc ezzaθ nleεbaδ.<verse eid="MRK 3:12" /></para>
  <para style="s">exθari nimersal leθnac</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13" />yali yeddehreθ inabe elli yexsiyn eseδnes. <verse eid="MRK 3:13" /><verse number="14" style="v" sid="MRK 3:14" />yexθar eθnac essisen bac e qqiymen iyδes yezenten δimubecren, <verse eid="MRK 3:14" /><verse number="15" style="v" sid="MRK 3:15" />uγer-sen elquwweθ egelben essis ecyaĎen. <verse eid="MRK 3:15" /><verse number="16" style="v" sid="MRK 3:16" />weθnac elli yexθarin nihnin: semεan ysemmaθ buTrus, <verse eid="MRK 3:16" /><verse number="17" style="v" sid="MRK 3:17" />dyeεquwb dyuwHenna idrari nzebedi ysuliyasen tεuyyerθ buwanerjes, meεnahe idrari nidje, <verse eid="MRK 3:17" /><verse number="18" style="v" sid="MRK 3:18" />dendrawus dfiylibbus dberθuwluwmawus dmetta dtuwma dyeεquwb memmis nHelfe etteddawus dsemεan elli yettenγar f temurθes <verse eid="MRK 3:18" /><verse number="19" style="v" sid="MRK 3:19" />dyehuwδa esxeryuwTi elli yzenzi.<verse eid="MRK 3:19" /></para>
  <para style="s">yesuwε δbeεlzbuwl</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20" />usiyn yexDem yelHuces. emlaymen felles leεbaδ xlaf egget yeδwel eligeddec eyeč nette detlemδas. <verse eid="MRK 3:20" /><verse number="21" style="v" sid="MRK 3:21" />eslen essis midnes, emerqen bac e θewyen εlexaTer leεbaδ ennen: «yehbel!» <verse eid="MRK 3:21" /><verse number="22" style="v" sid="MRK 3:22" />wimuεelmen necceriyεeθ elli eggezen seg uwrceliym ennen: «yeεmerθ beεlzbuwl, usumeqqar necyaĎen yetgelleb g ecyaĎen.» <verse eid="MRK 3:22" /><verse number="23" style="v" sid="MRK 3:23" />heδake εlac inebaθen yuθleyasen s lemθal: «max i bliys eyged eygelleb ibliys? <verse eid="MRK 3:23" /><verse number="24" style="v" sid="MRK 3:24" />elmemlxeθ iδekan eθemzuwn etqimiyc, <verse eid="MRK 3:24" /><verse number="25" style="v" sid="MRK 3:25" />welHuwc iδekan eyemzuwn yetqimiyc. <verse eid="MRK 3:25" /><verse number="26" style="v" sid="MRK 3:26" />wibliys iδekan eyenneqleb f imenes eyemzuwn, eyexDem welyetqimiyc. <verse eid="MRK 3:26" /><verse number="27" style="v" sid="MRK 3:27" />eliged Hed eyehjem elHuwc nweryaz yeqwe yfukkes egliys kan max eykettef eryaze elli yeqwe qebl usiyn esyekkes elHuces.<verse eid="MRK 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 3:28" />tay δexennenne elHeq: rebbi yetsameH elεebδ f elli eθyeg elkul Hette max eyekfer. <verse eid="MRK 3:28" /><verse number="29" style="v" sid="MRK 3:29" />emme elli eyeγleĎ derruwH nelqudus, eθyetsemiyHc rebbi belkul.» <verse eid="MRK 3:29" /><verse number="30" style="v" sid="MRK 3:30" />usahen yerre f elli ennan: «yemmeεmer s erruwH temenzuwsθ!»<verse eid="MRK 3:30" /></para>
  <para style="s">yemmes nyesuwε dewmeθnes</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31" />elweqθes teseδ yemmes demmeθnes, eqqiymen elberre eznen etnaben δiys. <verse eid="MRK 3:31" /><verse number="32" style="v" sid="MRK 3:32" />ukanen leεbaδ egget g eεmzen iyδes, ennanes: «yemmex demmeθnex temmeθinex etrajen δiyx elberre.» <verse eid="MRK 3:32" /><verse number="33" style="v" sid="MRK 3:33" />yer fellasen: «δ wiyn netteθ yemme weδwiyn emmeθniyw?» <verse eid="MRK 3:33" /><verse number="34" style="v" sid="MRK 3:34" />yerqeb yihelli g eεmzen iyδes yen: «enzi, δiyhen yemme demmeθniyw! <verse eid="MRK 3:34" /><verse number="35" style="v" sid="MRK 3:35" />εlexaTer elli eyexδem s elquδreθ nrebbi δenje weδweltme weδyemme.»<verse eid="MRK 3:35" /></para>
  <chapter eid="MRK 3" />
  <chapter number="4" style="c" sid="MRK 4" />
  <para style="s">elmθel nezzareε</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1" />yeδwel xlaf yuseqri f eccafeθ niylel, emlaymen felles leεbaδ egget, yali yeqqiym g elfluwkeθ g iylel uleεbaδ elkul f ecceT. <verse eid="MRK 4:1" /><verse number="2" style="v" sid="MRK 4:2" />yesseqraθen elberceθ δelHajaθ s lemθal. yennasen g useqriys: <verse eid="MRK 4:2" /><verse number="3" style="v" sid="MRK 4:3" />«esseγδeθ! yesreH eryaz bac e yezreε. <verse eid="MRK 4:3" /><verse number="4" style="v" sid="MRK 4:4" />unette izerreε tuĎe lewse nezzerriyεeθ f eccafeθ nwebriδ, ečentent izenniywen. <verse eid="MRK 4:4" /><verse number="5" style="v" sid="MRK 4:5" />lewse uDaneθ f elqeεεeθ δisli eddiyc egget ecal, nebbeθneθ liyhliyh εlexaTer eceles elyeγriyqc. <verse eid="MRK 4:5" /><verse number="6" style="v" sid="MRK 4:6" />umax i θeqqeS tefuwθ yeHreq, uεlexaTer eddiyc leεruwq yeqquwr. <verse eid="MRK 4:6" /><verse number="7" style="v" sid="MRK 4:7" />ellaneθ lewse uDaneθ g eccuwk, yali eccuwk yexneqθent welliriwnec. <verse eid="MRK 4:7" /><verse number="8" style="v" sid="MRK 4:8" />ulewse uDaneθ f elqeεεeθ tebhe, nebbeθneθ ekberneθ egeneθ tisbal nbuwtleθiyn dbuwsettiyn dbuwmiyye.» <verse eid="MRK 4:8" /><verse number="9" style="v" sid="MRK 4:9" />yen yesuwε: «elli γer-s timedjiyn selneθ eyesseγδ!»<verse eid="MRK 4:9" /></para>
  <para style="s">elmeεne elmθel</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10" />max i yeδwel weHδes, encδent elli iyδes dimersal leθnac f elmeεne nelmθel, <verse eid="MRK 4:10" /><verse number="11" style="v" sid="MRK 4:11" />yennasen: «yxenyum yemmucawem essan nesser nelmemlxeθ nrebbi, emme iberreniyyen sellen kul cey s lemθal, <verse eid="MRK 4:11" /><verse number="12" style="v" sid="MRK 4:12" />bac e reqben welzerrenc, eslen welfehmenc, bac e ttabenc emmeγfren leδnubensen.»<verse eid="MRK 4:12" /></para>
  <para style="s">efesser nelmθel nezzareε</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13" />usiyn yenne yetlemδas: «eltefhiymemc elmθele? max δeθefehmem emmale lemθal iddiyn elkul? <verse eid="MRK 4:13" /><verse number="14" style="v" sid="MRK 4:14" />eryaz izerreε tuθleyθ, <verse eid="MRK 4:14" /><verse number="15" style="v" sid="MRK 4:15" />wellan leεbaδ emezzerriyεeθ elli tweTTe f eccafeθ nwebriδ, max eslen edwi esenyeddes ibliys liyhliyh yeksasen edwi elli yemmezreε δiysen. <verse eid="MRK 4:15" /><verse number="16" style="v" sid="MRK 4:16" />wellan leεbaδ emezzerriyεeθ g isli, max eslen edwi eθeqblen unihnin ferHeniyn, <verse eid="MRK 4:16" /><verse number="17" style="v" sid="MRK 4:17" />emme elθebθenc f elHal εlexaTerhum ezzerriyεeθ eddiyc leεruwq, γiyr emmeγSren f elxaĎer nedwidiyn eδuwlen f elles. <verse eid="MRK 4:17" /><verse number="18" style="v" sid="MRK 4:18" />wellan leεbaδ emezzerriyεeθ g eccuwk, eslen edwi, <verse eid="MRK 4:18" /><verse number="19" style="v" sid="MRK 4:19" />emme lehmuwm neddunyeθ dwexse nlefluws decciyxaθ tiddiynni eyaδef g ulewnensen yexneq edwi welyθeruwc. <verse eid="MRK 4:19" /><verse number="20" style="v" sid="MRK 4:20" />emme ellan leεbaδ emezzerriyεeθ g elqeεεeθ tebhe, eslen edwi eqblent arwen: elli tleθiyn, welli settiyn, welli miyye.»<verse eid="MRK 4:20" /></para>
  <para style="s">elmθel nelgaz</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21" />yennasen: «endre eyeddeγ iyjen elgaz bac e θiHuT seddu elkiyleθ ziyγ seddu esriyr? maw δeθiHuT g wemxan yeεle. <verse eid="MRK 4:21" /><verse number="22" style="v" sid="MRK 4:22" />kul cey yemmeHrez δeyban welli yemmejHeδ δeyemmessen. <verse eid="MRK 4:22" /><verse number="23" style="v" sid="MRK 4:23" />elli γer-s timedjiyn selneθ eyesseγδ!»<verse eid="MRK 4:23" /></para>
  <para style="s">elmθel nelkiyleθ</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24" />yennasen: «erreθ elbelennum yelli δetteslem! s elkiyleθ elli etkeylem essis δexenyemkeyyel wexθer zade, <verse eid="MRK 4:24" /><verse number="25" style="v" sid="MRK 4:25" />εlexaTer elli γer-s Haje, δesyemmerni. welγres Hette cey, Hette δlewse elli γer-s δesyemmekkes.»<verse eid="MRK 4:25" /></para>
  <para style="s">elmθel nimendi elli yettekber</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26" />yen: «elmemlxeθ nrebbi čebbeh eryaz izerreε g ujimiys. <verse eid="MRK 4:26" /><verse number="27" style="v" sid="MRK 4:27" />eyenεes δeggiyδ yekker dugges, wimendi yetteffeγ wikebber, yemenni nette elyessiync max. <verse eid="MRK 4:27" /><verse number="28" style="v" sid="MRK 4:28" />elqeεεeθ seg imenes eθessuwfeγ elqsil qebl, usiyn ettisbal, usiyn δiyrδen elli δeεebben tisbal. <verse eid="MRK 4:28" /><verse number="29" style="v" sid="MRK 4:29" />max eĎaben iyrδen, eyawi emjeres εlexaTer θemiyre tebδe.»<verse eid="MRK 4:29" /></para>
  <para style="s">elmθel nelHebbeθ nelxerdel</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30" />yen: «sme δencebbeh elmemlxeθ nrebbi wesmanten elmθel δeθenmeθθel? <verse eid="MRK 4:30" /><verse number="31" style="v" sid="MRK 4:31" />nette emelHebbeθ nelxerdel, max ettezrεeδ eSγer Haje g ezzerriyεeθ nelqeεεeθ, <verse eid="MRK 4:31" /><verse number="32" style="v" sid="MRK 4:32" />yemenni max eθnebbeθ eθali teδwel ekber Haje δiysneθ, tezzel εuddi menyeθ δleεraf, esδen izenniywen nesme εececen g eTTelles.»<verse eid="MRK 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33" />w ykan yesuwε yetxeθθer seg lemθal bac e yseqre leεbaδ edwi nrebbi s elli etgedden f ehment. <verse eid="MRK 4:33" /><verse number="34" style="v" sid="MRK 4:34" />weseniHekki kan s lemθal, umax eyebδe nette detlemδas weHδasen ennifehhem kul cey.<verse eid="MRK 4:34" /></para>
  <para style="s">yesuwε eyhedde elεaSfeθ</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35" />esses max i θedduwse tisemsiyn, yenneyasen yetlemδas: «heyyeθ, eneqDeε yetwali ecceT elli yqeblane.» <verse eid="MRK 4:35" /><verse number="36" style="v" sid="MRK 4:36" />edjen leεbaδ exeDmen dyesuwε g elfluwkeθ elli ykan δiys, ukanneθ ellaneθ iyδes elflayek xlaf. <verse eid="MRK 4:36" /><verse number="37" style="v" sid="MRK 4:37" />yekker aDu yeqwe egget yebδe elmuwj yettewweθ g elfluwkeθ εuddi δettiεebbe. <verse eid="MRK 4:37" /><verse number="38" style="v" sid="MRK 4:38" />yesuwε ykan yenεes s δeffer wixfes f elmxeddeθ. sikrent ennanes: «eyimuεellem, mayhemmekc elli δenjaf?» <verse eid="MRK 4:38" /><verse number="39" style="v" sid="MRK 4:39" />yekker yenzer f waDu yennes yiylel: «erkeH! eqqiym rayeD!» yenεes aDu tehδe eddunyeθ. <verse eid="MRK 4:39" /><verse number="40" style="v" sid="MRK 4:40" />yen yesuwε yetlemδas: «ecbiykum ettekkaδem? eltuciym ettemnemc?» <verse eid="MRK 4:40" /><verse number="41" style="v" sid="MRK 4:41" />emme nihnin kanen merεubiyn egget, ennen ibeεDhum: «δ wiyn wahen? Hette δaDu diylel sellen g edwiys!»<verse eid="MRK 4:41" /></para>
  <chapter eid="MRK 4" />
  <chapter number="5" style="c" sid="MRK 5" />
  <para style="s">egelleb nlerwaH imenzas dweγraq nixenziyren</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1" />ewDen yeccafeθ tissent niylel neljliyl, g ecciyreθ nijerrasiyyen. <verse eid="MRK 5:1" /><verse number="2" style="v" sid="MRK 5:2" />max i yeggez seg elfluwkeθ yeεreDt eryaz yeffeγ seg tejebbent, weθkan δiys erruwH temenzuwsθ. <verse eid="MRK 5:2" /><verse number="3" style="v" sid="MRK 5:3" />w ykan iεemmer diyn weliged Hed eθyeqqen Hette s esselsleθ. <verse eid="MRK 5:3" /><verse number="4" style="v" sid="MRK 5:4" />menyeθ nmerre eθeqnen g imne deslasel yemenni ykan diyme inekkeD g imne uyetkesser g eslasel weliged Hed eθyeTTef. <verse eid="MRK 5:4" /><verse number="5" style="v" sid="MRK 5:5" />w ykan δeggiyδ ddugges g tijebbanin dedhari, yetzeεweg uyečelleH yečeθ g imenes s elkurδ. <verse eid="MRK 5:5" /><verse number="6" style="v" sid="MRK 5:6" />max i yezre yesuwε seg lebεiyδ, yuzzel yetweliys yesjδes, <verse eid="MRK 5:6" /><verse number="7" style="v" sid="MRK 5:7" />izeεweg: «ecihemmek δiyye yesuwε memmis nrebbi elεali? eθjul eyetεeδbec.» <verse eid="MRK 5:7" /><verse number="8" style="v" sid="MRK 5:8" />εlexaTer yesuwε yennayes: «eyerruwH temenzuwsθ effeγ seg weryaze!» <verse eid="MRK 5:8" /><verse number="9" style="v" sid="MRK 5:9" />yenceδt yesuwε: «max ellesmex?» yer felles: «ellesmiyw eljiyc, εlexaTer nečin egget.» <verse eid="MRK 5:9" /><verse number="10" style="v" sid="MRK 5:10" />imelges egget yyesuwε bac yetgellebc essis lerwaH timenzas elberre necciyrettin. <verse eid="MRK 5:10" /><verse number="11" style="v" sid="MRK 5:11" />w ykan yelle eccebεeθ δixenziyren retεen yetwali eddehreθ. <verse eid="MRK 5:11" /><verse number="12" style="v" sid="MRK 5:12" />mellegneθ lerwaH timenzas yyesuwε ennentes: «eznane yixenziyrendiyn bac e naδef δiysen.» <verse eid="MRK 5:12" /><verse number="13" style="v" sid="MRK 5:13" />yedjiyneθ. effeγneθ lerwaH timenzas eδefneθ g ixenziyren. exeDmen ettezlen seg tiwni yiylel, w ykan elεδeδensen εuddi elfiyn, eγerqen δiys.<verse eid="MRK 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14" />erwlen iniylten encren elxber g temuwreθ dijiyman, efγen leεbaδ bac e reqben δme iyejre. <verse eid="MRK 5:14" /><verse number="15" style="v" sid="MRK 5:15" />max i DiwDen yyesuwε, zriyn eryaz elli ykan δiys eljiyc necyaĎen ygeεmez diyn yireD edbac labas εliyh, ukδen. <verse eid="MRK 5:15" /><verse number="16" style="v" sid="MRK 5:16" />eHkenasen eccuhhaδ selli yejre yweryaz elli kanen δiys ecyaĎen uselli yejre yixenziyren. <verse eid="MRK 5:16" /><verse number="17" style="v" sid="MRK 5:17" />ennanes yyesuwε eyexDem seg θemurθensen. <verse eid="MRK 5:17" /><verse number="18" style="v" sid="MRK 5:18" />unette yerkeb g elfluwkeθ, imelges elli kanen δiys ecyaĎen bac e θyawi iyδes. <verse eid="MRK 5:18" /><verse number="19" style="v" sid="MRK 5:19" />yemenni eθyedjiyc, yennes: «eδwel yelHucex dmidnex teHkiδasen s elli yegeyaxθ rebbi umax i xyerHem.» <verse eid="MRK 5:19" /><verse number="20" style="v" sid="MRK 5:20" />yexDem eryazdiyn yebδe yHekke s elli yegeyasθ yesuwε g lemden elεecre, uleεbaδ elkul ettesθeγraben.<verse eid="MRK 5:20" /></para>
  <para style="s">yelliys nyayrus ettmeTTuwθ elli tlemmes yesuwε seg edbeces</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21" />umax i yerjeε yesuwε yteme tissent g elfluwkeθ, emlaymen felles leεbaδ egget g ecceT. <verse eid="MRK 5:21" /><verse number="22" style="v" sid="MRK 5:22" />yeseδ eryaz seg imeqqaren nelmejmeε ellesmes yayrus, max i yezre yesuwε yuDe f ikreεn-es, <verse eid="MRK 5:22" /><verse number="23" style="v" sid="MRK 5:23" />imelges eSbiyH yennes: «yelli temezyent εuddi eθjaf, est HuT felles efusex, bac e θebre tekker!» <verse eid="MRK 5:23" /><verse number="24" style="v" sid="MRK 5:24" />yexDem iyδes eθbεent leεbaδ egget ukanen etzeHamen δiys.<verse eid="MRK 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 5:25" />weθkan telle temeTTuwθ γer-s enziyf niδammen<note caller="+" style="f"><char style="fr" closed="false">5.25 </char><char style="ft" closed="false">enziyf niδammen - temeTTuwθ Hesben δiys ettemenzuwsθ seg eθnac nesne εlexaTer γer-s enziyf niδammen. elli ettilemmes eθeδwel Hette ennette δemenzuws.</char></note> seg eθnac nesne, <verse eid="MRK 5:25" /><verse number="26" style="v" sid="MRK 5:26" />εedden felles iĎbiyben egget, teδfeε elli γer-s elkul, welterbiyH Hette cey, teqqiym diyme ettexyab. <verse eid="MRK 5:26" /><verse number="27" style="v" sid="MRK 5:27" />max i θesle s elxber nyesuwε, taδef uggemmes nleεbaδ s δeffer tlemmes edbeces, <verse eid="MRK 5:27" /><verse number="28" style="v" sid="MRK 5:28" />εlexaTer tenne g ules: «max elemse edbeces yezziyiyδ bac e briγ.» <verse eid="MRK 5:28" /><verse number="29" style="v" sid="MRK 5:29" />yuqe enziyf niδammen g elweqθes, eθHus g elbeδnes elli netteθ tebre. <verse eid="MRK 5:29" /><verse number="30" style="v" sid="MRK 5:30" />yHus yesuwε g elweqθes elli elquwweθ teffeγ essis yebren yleεbaδ yen: «δ wiyn ylemmes edbeciyw?» <verse eid="MRK 5:30" /><verse number="31" style="v" sid="MRK 5:31" />ennanes etlemδas: «tzerreδ g leεbaδ tδuzzen δiyx weθnecδeδ: δ wiyn iylemmes?» <verse eid="MRK 5:31" /><verse number="32" style="v" sid="MRK 5:32" />yeqqiym iberren bac e yzer δ wiyn iθilemmes. <verse eid="MRK 5:32" /><verse number="33" style="v" sid="MRK 5:33" />tukkeδ temeTTuwtdiyn max i θessen elli yejrayes, teseδ treεεec tesjδes tennes elHqiyqeθ elkul. <verse eid="MRK 5:33" /><verse number="34" style="v" sid="MRK 5:34" />yennes: «elimenem yeSSebrayem eyelli. berre weθukδec, tebriδ seg weTTenem.»<verse eid="MRK 5:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35" />unette elyuwc iδukke useδen iryazen seg elHuwc numeqqar nelmejmeε unihnin eqqarnes: «yelliyx eθjaf, eθerniyc eθqelqeδ imuεellem.» <verse eid="MRK 5:35" /><verse number="36" style="v" sid="MRK 5:36" />yer yesuwε imenes elyesliyc, yennes yumeqqar nelmejmeε: «eθukδec, yezzi eθemneδ berk.» <verse eid="MRK 5:36" /><verse number="37" style="v" sid="MRK 5:37" />welyedji Hed eθyeθbeε kan δbuTrus dyeεquwb dyuwHenna enjes nyeεquwb. <verse eid="MRK 5:37" /><verse number="38" style="v" sid="MRK 5:38" />max i θiwDen yelHuwc numeqqar nelmejmeε, yesle yesuwε elHes d εeyyeĎ nleεbaδ duzeεwgensen. <verse eid="MRK 5:38" /><verse number="39" style="v" sid="MRK 5:39" />yaδef yennasen: «ecbiykum etzeεwgem wetεeyĎem? tefruwxθe eltjafc, emme tenεes!» <verse eid="MRK 5:39" /><verse number="40" style="v" sid="MRK 5:40" />eSSen felles. yemenni nette yessufeγθen elkul, yaδef nette ddaddes ntefruwxθ dyemmes delli iyδes yetwali tefruwxθ. <verse eid="MRK 5:40" /><verse number="41" style="v" sid="MRK 5:41" />yeTTeft seg wefuses yennes: «Teliyθa quwmiy!» meεnahe: «eθefruwxθ, enniyγem ekker!» <verse eid="MRK 5:41" /><verse number="42" style="v" sid="MRK 5:42" />tekker g elweqθes tebδe tegguwr, weθkan δyelliys neθnac nesne, esθeγerben egget elkulhum. <verse eid="MRK 5:42" /><verse number="43" style="v" sid="MRK 5:43" />iweSSaθen yesuwε eSbiyH bac e lleqqaren yHette Hed, yennasen ettessečen.<verse eid="MRK 5:43" /></para>
  <chapter eid="MRK 5" />
  <chapter number="6" style="c" sid="MRK 6" />
  <para style="s">ennaSreh eltqabbelc yesuwε</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1" />yeffeγ esyiyn yeseδ ytemurθes eθbεent etlemδas. <verse eid="MRK 6:1" /><verse number="2" style="v" sid="MRK 6:2" />as nessebθ yebδe yetseqre g elmejmeε. esθeγerben leεbaδ max i θesliyn ennen: «s meniys iyedduwγe wahen? δmette elHekmeθe isθemmuwce? uδmat elmuεjzaθe elli yθeg δiysneθ elkul? <verse eid="MRK 6:2" /><verse number="3" style="v" sid="MRK 6:3" />muc δwahen enejjar emmiys nmeryem, enjes nyeεquwb dyuwsi dyehuwδa dsemεan? δwahen elli temmeθines γenne dah?» welleqqilenc eθeqblen. <verse eid="MRK 6:3" /><verse number="4" style="v" sid="MRK 6:4" />yennasen yesuwε: «eHebbec Hette enbi γer-s elqiymeθ g temurθes uggemmes niεcirnes dmidnes.» <verse eid="MRK 6:4" /><verse number="5" style="v" sid="MRK 6:5" />weliged eyeg Hette elmuεjzeθ diyn, kan qiqqi nleεbaδ δimuwDan iHuT fellasen efuses ebran. <verse eid="MRK 6:5" /><verse number="6" style="v" sid="MRK 6:6" />w ykan yetteθεejjeb seg elqelleθ nelimenensen. yexDem ytimuwre tiddiynni yetseqre.<verse eid="MRK 6:6" /></para>
  <para style="s">yesuwε eyazen etlamδe leθnac</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 6:7" />inabe etlamδe leθnac yebδe yettazen δiysen zwaz bac e becren, yucasen elquδreθ f lerwaH timenzas. <verse eid="MRK 6:7" /><verse number="8" style="v" sid="MRK 6:8" />iweSSaθen yennasen: «eθewyem Hette cey ywebriδennum kan etteγriyθ: la δeγrum, la ettecxarθ, ula δlefluws g lejyebennum, <verse eid="MRK 6:8" /><verse number="9" style="v" sid="MRK 6:9" />emme irδeθ eSSebbaĎ, weθewyemc sent δelksawi.» <verse eid="MRK 6:9" /><verse number="10" style="v" sid="MRK 6:10" />yennasen: «meni eθeδfem elHuwc, eqqiymeθ diyn elδeθerHlem essin. <verse eid="MRK 6:10" /><verse number="11" style="v" sid="MRK 6:11" />umax eθexeDmem ywemxan wexenqeblenc δiys midnes welsellenc edwinnum, erHleθ esyiyn teferDem tγuwbret seg eSbabĎennum emunebbeh fellasen!» <verse eid="MRK 6:11" /><verse number="12" style="v" sid="MRK 6:12" />efγen etnaben leεbaδ yettuwbeθ, <verse eid="MRK 6:12" /><verse number="13" style="v" sid="MRK 6:13" />g elben ecyaĎen egget, eδehnen s uwδi egget leεbaδ δimuwDan ebran.<verse eid="MRK 6:13" /></para>
  <para style="s">temettent nyuwHenna elmeεmdan</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14" />yesl elmlek hiyruwdus<note caller="+" style="f"><char style="fr" closed="false">6.14 </char><char style="ft" closed="false">wahen hiyruwdus antibas yemεeyyen seg embraTuwr nerruwman, elmlek neljliyl deriyHa, memmis nelmlek hiyruwdus emeqqar. (enzi mette 2)</char></note> s yesuwε, εlexaTer yeδwel yemmessen egget. ukanen ellan leεbaδ eqqaren: «yuwHenna elmeεmdan yekker seg ilemmitte, uwahen imette elmuεjzaθ ekkerneθ f ifesnes.» <verse eid="MRK 6:14" /><verse number="15" style="v" sid="MRK 6:15" />emme ennen xlaf: «δiliyya», uleεbaδ xlaf ennen: «δenbi seg lenbye iqδiymen.» <verse eid="MRK 6:15" /><verse number="16" style="v" sid="MRK 6:16" />max i yesle hiyruwdus yen: «wahen δyuwHenna elli qusγes neč ixfes, yekker seg ilemmitte!» <verse eid="MRK 6:16" /><verse number="17" style="v" sid="MRK 6:17" />w ykan hiyruwdus yeTTef yuwHenna yeqqent g elHebs f elxaĎer nhiyruwdiyya elli yuγit unetteθ δliwec nenjes f iylibbus. <verse eid="MRK 6:17" /><verse number="18" style="v" sid="MRK 6:18" />w ykan yuwHenna yeqqeres: «exyetHiylec eθewyeδ liwec nenjex.» <verse eid="MRK 6:18" /><verse number="19" style="v" sid="MRK 6:19" />weθkan hiyruwdiyya tenqem f yuwHenna uθexs ettenγ yemenni eltgeddec, <verse eid="MRK 6:19" /><verse number="20" style="v" sid="MRK 6:20" />εlexaTer hiyruwdus ykan yettekkaδ essis w yetεus felles εlexaTer yessent δeryaz δ eSSaleH w δ eqeddiys. w ykan yexs egget esyesseγδ, reγmelli iHeyyerθ egget. <verse eid="MRK 6:20" /><verse number="21" style="v" sid="MRK 6:21" />twete tikkelt yhiyruwdiyya max i yege hiyruwdus g εiyd miylade emensi yelquyyaδ neljiyc dimeqqaren neljliyl. <verse eid="MRK 6:21" /><verse number="22" style="v" sid="MRK 6:22" />taδef yelliys nhiyruwdiyya terqeS, teεjeb hiyruwdus delli diyn elkul. yennes elmlek: «eĎleb elli texseδ emettuwce.» <verse eid="MRK 6:22" /><verse number="23" style="v" sid="MRK 6:23" />yeθjulles yen: «emuwce elli eθeDelbeδ, Hette δezyen nelmemlexθiyw!» <verse eid="MRK 6:23" /><verse number="24" style="v" sid="MRK 6:24" />teffeγ tenceδ yemmes: «δmette δeDelbe?» ter felles: «iyxef nyuwHenna elmeεmdan!» <verse eid="MRK 6:24" /><verse number="25" style="v" sid="MRK 6:25" />tezzel fiyseε yelmlek tennes: «exse eyθuwceδ ture iyxef nyuwHenna elmeεmdan f eTbeq!» <verse eid="MRK 6:25" /><verse number="26" style="v" sid="MRK 6:26" />yeHzen elmlek egget, yemenni elyeqqiylc etyer f elxaĎer nelimiyn elli yeθjulli ezzaθ nleεbaδ. <verse eid="MRK 6:26" /><verse number="27" style="v" sid="MRK 6:27" />yezen g elweqθes eεeskri yennes esyeddeγ iyxef nyuwHenna. yexDem iquSSes ixfes g elHebs, <verse eid="MRK 6:27" /><verse number="28" style="v" sid="MRK 6:28" />yeγet f eTbeq yuwci ytefruwxθ tewiyθ yyemmes. <verse eid="MRK 6:28" /><verse number="29" style="v" sid="MRK 6:29" />eslen etlamδe nyuwHenna, esδen ewyen ejjeθeθes erδmenteθ.<verse eid="MRK 6:29" /></para>
  <para style="s">yesuwε eyceč xemse laf rajel</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30" />beεδ erejεen imersal emlaymen γer yesuwε, eHkanes f elli egint delli esseqrant elkul. <verse eid="MRK 6:30" /><verse number="31" style="v" sid="MRK 6:31" />yennasen: «esδeθ xenyum weHδawem ywemxan δelxali terθaHem lewse.» εlexaTer egget leεbaδ kanen xeTmen ettesδen, wesennedjiync elweqθ Hette yweče. <verse eid="MRK 6:31" /><verse number="32" style="v" sid="MRK 6:32" />exeDmen weHδasen g elfluwkeθ ywemxan δelxali. <verse eid="MRK 6:32" /><verse number="33" style="v" sid="MRK 6:33" />ezrenten leεbaδ, esnen elmani δexeDmen, efγen seg timuwre elkul f ikreεnensen esebqenten eldiyn. <verse eid="MRK 6:33" /><verse number="34" style="v" sid="MRK 6:34" />max i yeggez yesuwε seg elfluwkeθ, yezre leεbaδ egget, yesxef f ellasen, εlexaTer kanen emesεi blac eniylti, yesseqraθen elHajaθ egget. <verse eid="MRK 6:34" /><verse number="35" style="v" sid="MRK 6:35" />max i yeδwel meεεač bekri, useδnes etlemδas ennanes: «wahen δemxan δelxali, w elweqθ meεεač bekri. <verse eid="MRK 6:35" /><verse number="36" style="v" sid="MRK 6:36" />ezenten erewHen yeswani ettimuwre bac e sγen δme δečen.» <verse eid="MRK 6:36" /><verse number="37" style="v" sid="MRK 6:37" />yer fellasen yesuwε: «ucmasen δxenyum δme δečen.» ennanes: «s meniys? yelzemne tmaliθ<note caller="+" style="f"><char style="fr" closed="false">6.37 </char><char style="ft" closed="false">meεnahe miytiyn diynar, tejernat neθmenye chuwr δelxeδmeθ yweryaz.</char></note> bac e nged essenneγ mat δečen?» <verse eid="MRK 6:37" /><verse number="38" style="v" sid="MRK 6:38" />yennasen yesuwε: «menyeθ iγerwem ettineεne? berreθ erqbeθ.» max i reqben elli γer-sen, ennanes: «xemse ettineεne dsent ettiHwiyθin.» <verse eid="MRK 6:38" /><verse number="39" style="v" sid="MRK 6:39" />yennasen esgeεmzen leεbaδ δeljmaεeθ δeljmaεeθ f elHec eziyzew. <verse eid="MRK 6:39" /><verse number="40" style="v" sid="MRK 6:40" />eqqiymen δleSfuwf δleSfuwf, δiysen egli nmiyye uδiysen egli exxemsiyn. <verse eid="MRK 6:40" /><verse number="41" style="v" sid="MRK 6:41" />ubeεδ yawi yesuwε xemsediyn ettineεne dsentediyn ntiHwiyθin yqam tiTTewines yesme, ybarex, ykesser tineεne yezlasen yetlemδas bac e ferqen f leεbaδ, yzuwn sentadiyn ntiHwiyθin fellasen elkul. <verse eid="MRK 6:41" /><verse number="42" style="v" sid="MRK 6:42" />ečen elkulhum elδecebεen. <verse eid="MRK 6:42" /><verse number="43" style="v" sid="MRK 6:43" />usiyn qamen eθnac ettisiyfes εebbaneθ δeleεqab nweγrum etteHwiyθin. <verse eid="MRK 6:43" /><verse number="44" style="v" sid="MRK 6:44" />ukanen elli ečiyn seg tineεne εuddi xemse laf rajel.<verse eid="MRK 6:44" /></para>
  <para style="s">yesuwε yegguwr f wamen</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45" />elweqθes yen yesuwε yetlemδas eθinen g elfluwkeθ esbqent ibiytSeyda, f ecceT elli iqabel, elδeygelleb leεbaδ. <verse eid="MRK 6:45" /><verse number="46" style="v" sid="MRK 6:46" />max i xeDmen yuwli yeddehreθ bac e yezzal. <verse eid="MRK 6:46" /><verse number="47" style="v" sid="MRK 6:47" />g tisemsiyn elfluwkeθ tkan uggemmes niylel uyesuwε weHδes f elber. <verse eid="MRK 6:47" /><verse number="48" style="v" sid="MRK 6:48" />yezer yesuwε elli etlemδas etεanen g ujeddef εlexaTer aDu ykan yεerreD δiysen. yesδasen qebl elfjer yegguwr f iylel, ykan εuddi δenyesbeq. <verse eid="MRK 6:48" /><verse number="49" style="v" sid="MRK 6:49" />max i θezriyn yegguwr f iylel etteεlakent δelxyal zeεwgen, <verse eid="MRK 6:49" /><verse number="50" style="v" sid="MRK 6:50" />εlexaTer zrint elkul emmerεben. yemenni elweqθes yuθleyasen yennasen: «etemmerεbemc, eθhenneθ enneč!» <verse eid="MRK 6:50" /><verse number="51" style="v" sid="MRK 6:51" />yelyasen g elfluwkeθ, yehδe aDu. eqqiymen Heyriyn egget, <verse eid="MRK 6:51" /><verse number="52" style="v" sid="MRK 6:52" />εlexaTer elmuεjzeθ nweγrum ettefhimenc, ukanen ulewnensen eqseHen.<verse eid="MRK 6:52" /></para>
  <para style="s">yesuwε eysebre seg weTTaneθ egget</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53" />θεedden yecciyreθ njenniysaret eqnen elfluwkeθensen diyn. <verse eid="MRK 6:53" /><verse number="54" style="v" sid="MRK 6:54" />elluciyn max i gzen uwxezen leεbaδ yesuwε. <verse eid="MRK 6:54" /><verse number="55" style="v" sid="MRK 6:55" />enden elberdiyn elkul ebδen etqamen g imuwDan f essewensen ikul blaSe eslen essis diyn. <verse eid="MRK 6:55" /><verse number="56" style="v" sid="MRK 6:56" />ukanen meni eyaδef, ylemden, ytimuwre ziyγ yeswani, eHuTTen imuwDan g elbeĎHaθ ennanes eylemmes Hette δeTTeref nedbeces. w ykan elli eθilemmes elkul eyebre.<verse eid="MRK 6:56" /></para>
  <chapter eid="MRK 6" />
  <chapter number="7" style="c" sid="MRK 7" />
  <para style="s">ekebbec g elεaδeθ nqebl</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1" />flexemlaymen f elles ifarisiyyen dlebHaD nimuεelmen necceriyεeθ elli useδen seg uwrceliym. <verse eid="MRK 7:1" /><verse number="2" style="v" sid="MRK 7:2" />ezren eljmaεeθ seg etlemδas tetten s ifassen δimenjas, ellemmessirδenc. <verse eid="MRK 7:2" /><verse number="3" style="v" sid="MRK 7:3" />εlexaTer ifarisiyyen delbeqiyyeθ uδayen elkul θebεen elεaδeθ n lejdad, eltettenc kan max esiyrδen ifesnensen belgde. <verse eid="MRK 7:3" /><verse number="4" style="v" sid="MRK 7:4" />umax erewHen seg essuwq eltetten Hette cey kan eθessiyrδen. wellaneθ elHajaθ egget xlaf θebεen δiysneθ, emussiyreδ nelkiysan diberraδen delmaεuwn nenHas desriyraθ.* <verse eid="MRK 7:4" /><verse number="5" style="v" sid="MRK 7:5" />encδent ifarisiyyen dimuεelmen necceriyεeθ: «imette etlemδax esseHfiĎenc f elεaδeθ nlejdad, yemenni tetten s ifassen δimwesxen ellemmessirδenc?» <verse eid="MRK 7:5" /><verse number="6" style="v" sid="MRK 7:6" />yer fellasen: «eyelli tesxerxuwsem! yeSδeq icεiyya g ennubuwθes fellawem, emmax i yemmari, &lt;ecceεbe yetbejjel deyye s imiys, emme ules yebεeδ egget felle. <verse eid="MRK 7:6" /><verse number="7" style="v" sid="MRK 7:7" />uεebδen δiyye s tixerxas, esseqren g edwi nleεbaδ.&gt; <verse eid="MRK 7:7" /><verse number="8" style="v" sid="MRK 7:8" />tseybem elwSaye nrebbi tetfem elεaδeθ nleεbaδ.»<verse eid="MRK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9" />yennasen: «xenyum tlewHem ecceriyεeθ nrebbi bac e θesθeHfĎem f elεeδeθennum! <verse eid="MRK 7:9" /><verse number="10" style="v" sid="MRK 7:10" />muwse yenne, &lt;elhe s daddex dyemmex, welli eysubb daddes ziyγ δyemmes yelzem eyjaf.&gt; <verse eid="MRK 7:10" /><verse number="11" style="v" sid="MRK 7:11" />emme xenyum teqqarem, &lt;iδekan iyjen γer-s mat eyεawen essis daddes dyemmes, yemenni esenyen wah δelqurban (meεnahe yrebbi)&gt; <verse eid="MRK 7:11" /><verse number="12" style="v" sid="MRK 7:12" />yemεafe seg eεawen ndaddes dyemmes, <verse eid="MRK 7:12" /><verse number="13" style="v" sid="MRK 7:13" />usahen eθkesrem edwi nrebbi s elεaδeθ elli twerθem δiysneθ, wellaneθ elHajeθ egget xlaf emtah ettegem δiysneθ.»<verse eid="MRK 7:13" /></para>
  <para style="s">mat eyenjes bnaδem</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14" />inabe etweliys leεbaδ elmerreθ xlaf yennasen: «eslmiyδ elkul tefhemmiyδ: <verse eid="MRK 7:14" /><verse number="15" style="v" sid="MRK 7:15" />leHebbe Hette cey eyaδef g elεebδ s berre usiyn eθyenjes. emme elli eyeffeγ seg elεebδ ennette elli δeθyenjes. <verse eid="MRK 7:15" /><verse number="16" style="v" sid="MRK 7:16" />welli γer-s timedjiyn ywesle edj eyesl.» <verse eid="MRK 7:16" /><verse number="17" style="v" sid="MRK 7:17" />max i yedje leεbaδ yeδwel yelHuwc encδent etlemδas f elmθel elli yenni. <verse eid="MRK 7:17" /><verse number="18" style="v" sid="MRK 7:18" />yennasen: «Hette δxenyum zade eltefhiymemc? eltessinemc elli eyaδef g elεebδ s berre elyetgedc eθyenjes, <verse eid="MRK 7:18" /><verse number="19" style="v" sid="MRK 7:19" />εlexaTer yettaδef yteδisθes, muc yules, usiyn eyeffeγ?» usahen yedje yesuwε eče elkul δ eTTaher. <verse eid="MRK 7:19" /><verse number="20" style="v" sid="MRK 7:20" />yennasen: «elli yetteffeγ seg elεebδ ennette elli δeθyenjes, <verse eid="MRK 7:20" /><verse number="21" style="v" sid="MRK 7:21" />εlexaTer s ejjaj, seg ulawen n leεbaδ, yetteffeγ exemmem elfaseδ: elfesq d exar d enγe <verse eid="MRK 7:21" /><verse number="22" style="v" sid="MRK 7:22" />dezne deTmeε delxubθ duγucci decciyxeθ dweHsaδ denmiymeθ duθkebber d ejjehl. <verse eid="MRK 7:22" /><verse number="23" style="v" sid="MRK 7:23" />elfsaδe elkul yetteffeγ seg wemmes nelεebδ usiyn eθyenjes.»<verse eid="MRK 7:23" /></para>
  <para style="s">eliman ntemeTTuwθ θekenεaniθ</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24" />yexDem esyiyn yetwali ecciyreθ nSuwr. yaδef elHuwc, w ykan eliγic eyesl essis Hette Hed, yaxi eligeddec eyeHrez imenes. <verse eid="MRK 7:24" /><verse number="25" style="v" sid="MRK 7:25" />eθkan telle temeTTuwθ γer-s yelliys δiys erruwH ettemenzuwsθ. max i θesle essis texDmes ettezzel tneggez f ikreεn-es, <verse eid="MRK 7:25" /><verse number="26" style="v" sid="MRK 7:26" />tennes eyessuwfeγ ecciyĎan seg yelliys. weθkan temeTTuwθe muc ettuδayθ, ettesuwriθ ettefiniyqiθ. <verse eid="MRK 7:26" /><verse number="27" style="v" sid="MRK 7:27" />yer felles yesuwε: «edj idrari ecebεen qebl, mayjiyc eθekseδ eγrum yidrari tuwcet yeyDan.» <verse eid="MRK 7:27" /><verse number="28" style="v" sid="MRK 7:28" />ter felles: «SHiyH ya, siydiy, Hette δeyDan tetten seg elεqab nidrari seddu eTTawleθ!» <verse eid="MRK 7:28" /><verse number="29" style="v" sid="MRK 7:29" />yennes: «berre, f elxaĎer nedwiym wahen yeffeγ ecciyĎan seg yelliym.» <verse eid="MRK 7:29" /><verse number="30" style="v" sid="MRK 7:30" />teδwel temeTTuwtdiyn yelHuces, taf yelliys f esriyr wecciyĎan yeffeγ essis.<verse eid="MRK 7:30" /></para>
  <para style="s">ebre nileĎrec</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31" />yeffeγ yesuwε seg Suwr, yeθεedde f Seyda g webriδes yiylel neljliyl, s etwali elqeεεeθ ntimuwre elεecre. <verse eid="MRK 7:31" /><verse number="32" style="v" sid="MRK 7:32" />eγeδnes iyjen δileĎrec wilses yemmeqqen, mellegnes bac e yHuT efuses f elles. <verse eid="MRK 7:32" /><verse number="33" style="v" sid="MRK 7:33" />yebεeδ essis yesuwε f leεbaδ, iHuT iDuDenes g timedjiyn nweryaz yeskuwfes ilemses ilses. <verse eid="MRK 7:33" /><verse number="34" style="v" sid="MRK 7:34" />yqam tiTTewines lennej yeθnehheδ yennes yweryaz: «iffaθa!» (meεnahe miyr) <verse eid="MRK 7:34" /><verse number="35" style="v" sid="MRK 7:35" />g elweqtdiyn emmiyrneθ timedjiyn nweryaz yemseyyeb ilses, yuθley δimserreH. <verse eid="MRK 7:35" /><verse number="36" style="v" sid="MRK 7:36" />iweSSaθen yesuwε bac e lleqqaren yHette Hed. yemenni ykan kul max enniweSSe ernin eseHke. <verse eid="MRK 7:36" /><verse number="37" style="v" sid="MRK 7:37" />ukanen eqqaren unihnin δimeθεejben: «mesmeH elεmayel elkul elli yθeg δiysneθ! yerre ileĎrec isel webekkuwc iδukke.» *iyehuwdiyyen etxememen elli nihnin xiyr nleεbaδ iddiyn. ettesemman imenensen idrari uleεbaδ iddiyn eyDan. uyesuwε yennayes siyn bac e ttijerreb muc bac e ttisub.<verse eid="MRK 7:37" /></para>
  <chapter eid="MRK 7" />
  <chapter number="8" style="c" sid="MRK 8" />
  <para style="s">yesuwε eyceč erbεe laf rajel</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1" />g liyyametdiyn, max i mlaymen leεbaδ egget elmerreθ xlaf, welγer-senc δme δečen, inabe yesuwε etlemδas yennasen: <verse eid="MRK 8:1" /><verse number="2" style="v" sid="MRK 8:2" />«ecfeqe f leεbaδe, εlexaTer γer-sen iyδi tlaθe eyyam wellečiyn Hette cey. <verse eid="MRK 8:2" /><verse number="3" style="v" sid="MRK 8:3" />ukan uznaθen yleHwecensen unihnin zuwmen, δeεyan uggebriδ, uδiysen leεbaδ useδen seg lebεiyδ.» <verse eid="MRK 8:3" /><verse number="4" style="v" sid="MRK 8:4" />erren f elles etlemδas: «max eyged iyjen eyeccecbeε leεbaδe elkul eseγrum dahen g elxle?» <verse eid="MRK 8:4" /><verse number="5" style="v" sid="MRK 8:5" />yenceδten: «menyeθ iγerwem ettineεne?» ennen: «sebεe.» <verse eid="MRK 8:5" /><verse number="6" style="v" sid="MRK 8:6" />yennasen yleεbaδ egeεmzen f elqeεεeθ, yeTTef sebεediyn ntineεne yecxer ykesserθent yuciyneθ yetlemδas bac e ntferqen fellasen, ferqentent. <verse eid="MRK 8:6" /><verse number="7" style="v" sid="MRK 8:7" />ukanen γer-sen zade lewse ntiHwiyθin ettimezyanin, ibarex δiysneθ yesuwε yennasen yetlemδas entferqen Hette ennihenti. <verse eid="MRK 8:7" /><verse number="8" style="v" sid="MRK 8:8" />ečen leεbaδ elδecebεen, laymen seg elli yefDel eyεebbe sebεe ettisiyfes. <verse eid="MRK 8:8" /><verse number="9" style="v" sid="MRK 8:9" />kanen εuddi erbεe laf rajel, yezenten rewHen. <verse eid="MRK 8:9" /><verse number="10" style="v" sid="MRK 8:10" />elweqθes yini g elfluwkeθ detlemδas yexDem yetwali ecciyreθ delmanuwθe.<verse eid="MRK 8:10" /></para>
  <para style="s">ifarisiyyen eDelben ellayeθ</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11" />emlaymen felles ifarisiyyen ebδen etεenaδen δiys eĎlben essis elHejjeθ seg esme bac e θjerben. <verse eid="MRK 8:11" /><verse number="12" style="v" sid="MRK 8:12" />yeθnehheδ eSbiyH yen: «imette iĎelleb eljiyle g elHejjeθ? exennenne elHeq: eljiyle esettaseδ Hette elHejjeθ.» <verse eid="MRK 8:12" /><verse number="13" style="v" sid="MRK 8:13" />yedjiyn yeδwel g elfluwkeθ yecceT elli iqabel.<verse eid="MRK 8:13" /></para>
  <para style="s">elxmiyreθ nifarisiyyen delxmiyreθ nhiyruwdus</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14" />etwen etlemδas eddaγen eγrum, weθkan γer-sen g elfluwkeθ kan teneεnuwyθ icθ. <verse eid="MRK 8:14" /><verse number="15" style="v" sid="MRK 8:15" />iweSSaθen yesuwε yennasen: «erreθ elbelennum seg elxmiyreθ<note caller="+" style="f"><char style="fr" closed="false">8.15 </char><char style="ft" closed="false">enzi mette 16:6, luqas 12:1</char></note> nifarisiyyen delxmiyr nhiyruwdus!» <verse eid="MRK 8:15" /><verse number="16" style="v" sid="MRK 8:16" />eqqiymen ettemεenaδen meεe beεDhum eqqaren: «yenneyane sah εlexaTer elγennac eγrum?» <verse eid="MRK 8:16" /><verse number="17" style="v" sid="MRK 8:17" />ifaq essisen yesuwε yennasen: «ecbiykum ettemεenaδem εlexaTer elγerwemc eγrum? endre eltefhiymemc elture? endre εman ulewnennum? <verse eid="MRK 8:17" /><verse number="18" style="v" sid="MRK 8:18" />ziyγ γerwem TiTTawin weltzerremc ettmedjiyn weltsellemc? eltesfekkiremc? <verse eid="MRK 8:18" /><verse number="19" style="v" sid="MRK 8:19" />max i kesre xemse ettineεne yxemse laf, menyeθ ettisiyfes εebbaneθ s weγrum iθlaymem?» erren felles: «eθnac.» <verse eid="MRK 8:19" /><verse number="20" style="v" sid="MRK 8:20" />yen: «umax i kesre sebεe ettineεne yerbεe laf, menyeθ ettisiyfes iθlaymem?» ennen: «sebεe.» <verse eid="MRK 8:20" /><verse number="21" style="v" sid="MRK 8:21" />yennasen: «weltefhimemc elture?»<verse eid="MRK 8:21" /></para>
  <para style="s">ebre nileεmi g biytSeyda</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22" />ewDen ibiytSeyda, eγeδnes lebHaD nleεbaδ ileεmi mellegnes bac e θilemmes. <verse eid="MRK 8:22" /><verse number="23" style="v" sid="MRK 8:23" />igewwet yeffeγ essis elberre ntemuwreθ, yeskuwfes g tiTTewines, iHuT ifesnes felles yenceδt: «endre tzerreδ g Haje?» <verse eid="MRK 8:23" /><verse number="24" style="v" sid="MRK 8:24" />yerqeb yen: «zerre g leεbaδ, emme emeccejer egguwren.» <verse eid="MRK 8:24" /><verse number="25" style="v" sid="MRK 8:25" />iHuT yesuwε ifesnes tikkelt xlaf f TiTTawin nweryaz, yeδwel izer belgde yeδwel δuSHiH izer kul cey. <verse eid="MRK 8:25" /><verse number="26" style="v" sid="MRK 8:26" />yezent yelHuces yennes: «eθerjεec ytemuwreθ.»<verse eid="MRK 8:26" /></para>
  <para style="s">buTrus eyecheδ s elHqiyqeθ nyesuwε</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27" />yexDem yesuwε detlemδas ytimuwre nqeySeriyyeθ fiylibbus, weggebriδ yenceδten: «δ wiyn neč γer leεbaδ?» <verse eid="MRK 8:27" /><verse number="28" style="v" sid="MRK 8:28" />erren felles: «yuwHenna elmeεmdan, wellan xlaf elli eqqaren: iliyya. wellan zade elli eqqaren: iyjen seg lenbye.» <verse eid="MRK 8:28" /><verse number="29" style="v" sid="MRK 8:29" />yenceδten: «uγerwem xenyum, δ wiyn neč?» yen buTrus: «cex δelmesiyH<note caller="+" style="f"><char style="fr" closed="false">8.29 </char><char style="ft" closed="false">enzi luqas 1:1</char></note>!» <verse eid="MRK 8:29" /><verse number="30" style="v" sid="MRK 8:30" />ynebbeh fellasen bac e lleqqaren yHette Hed felles.<verse eid="MRK 8:30" /></para>
  <para style="s">yesuwε eyeθnebbe ewwel merre s temettentes dwekkeres</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31" />yebδe yesuwε yetseqre δiysen elli bnaδem<note caller="+" style="f"><char style="fr" closed="false">8.31 </char><char style="ft" closed="false">enzi luqas 2:10</char></note> yelzem eyeθwejjeε egget, weθqeblenc wiwessaren dimeqqaren nelkuhhan dimuεelmen necceriyεeθ, yjaf yemmenγ, ubeεεeδ tlaθe eyyam eyekker. <verse eid="MRK 8:31" /><verse number="32" style="v" sid="MRK 8:32" />w ykan yeqqar g edwiye eSbiyH uggemmes etlemδas. eyendeγ yewiθ buTrus yebδe yetlum δiys. <verse eid="MRK 8:32" /><verse number="33" style="v" sid="MRK 8:33" />yebren yezer etlemδas, yeεrex buTrus yennes: «ebεeδ felle eyecciyĎan! exememex δexemmem nleεbaδ muc nrebbi.»<verse eid="MRK 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34" />inabe leεbaδ detlemδas yennasen: «elli yexs eyyeθbeε, yelzem elyetxemmemc imenes yqam eSlibes<note caller="+" style="f"><char style="fr" closed="false">8.34 </char><char style="ft" closed="false">eSlab nette δeTTeriyqeθ nweεδam. ettemettent twedjeε egget welli eyemmuwθ essis δemelεuwn. eyqam eSlibes yeθbεiyδ meεnahe eyeqbel eyeθwejjeε elmeyemmuwθ f elxaĎer nweθbeεiyw.</char></note> yeθbεiyδ. <verse eid="MRK 8:34" /><verse number="35" style="v" sid="MRK 8:35" />εlexaTer elli yexs eymenneε imenes etyexser, emme elli eyexser imenes f elxeĎriyw delxaĎer nelbcareθ ettimenneε. <verse eid="MRK 8:35" /><verse number="36" style="v" sid="MRK 8:36" />δmette δeyenfeε elεebδ max eyerbeH eddunyeθ elkulhe yexser imenes? <verse eid="MRK 8:36" /><verse number="37" style="v" sid="MRK 8:37" />wesmette elεebδ eyefδe imenes? <verse eid="MRK 8:37" /><verse number="38" style="v" sid="MRK 8:38" />εlexaTer elli eyesθεar essi dedwiyw g eljiyle elxayen elfaseδ, δeyesθεar essis bnaδem max eyeddes g elmejδ ndaddes delemlayxe unĎiyfen.»<verse eid="MRK 8:38" /></para>
  <chapter eid="MRK 8" />
  <chapter number="9" style="c" sid="MRK 9" />
  <para style="s">eθjelli</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1" />yennasen: «tay δexennenne elHeq: ellan seg ihelli dahen δ wiyn yetjafc kan ezren elmlax nrebbi yuseδ s elquwweθ.» <verse eid="MRK 9:1" /><verse number="2" style="v" sid="MRK 9:2" />ubeεεeδ sette eyyam yiwi yesuwε buTrus dyeεquwb dyuwHenna, elyen eqqiymen weHδasen g eddehreθ teεle, yeθjelle ezzeθensen. <verse eid="MRK 9:2" /><verse number="3" style="v" sid="MRK 9:3" />eδwlen edbeces lemεen δimellalen elli eliged Hette Hed enyer siyn. <verse eid="MRK 9:3" /><verse number="4" style="v" sid="MRK 9:4" />effeγnasen iliyya dmuwse<note caller="+" style="f"><char style="fr" closed="false">9.4 </char><char style="ft" closed="false">muwse diliyya etmeθlen ettuwreθ δelxθabaθ nlenbye iddiyn elli yecheδ f ellasen elmesiyH.</char></note>, ukanen dukkan yyesuwε. <verse eid="MRK 9:4" /><verse number="5" style="v" sid="MRK 9:5" />yen buTrus yyesuwε: «siydiy, mesmHe lukan eneqqiym dahen. edj eneg tlaθe ettiĎelliylin: icθ icex, wicθ ymuwse, wicθ yiliyya.» <verse eid="MRK 9:5" /><verse number="6" style="v" sid="MRK 9:6" />w ykan elyessiync δme iyeqqar seg elxuwf elli yeTTefθen nette deSSuHHabes. <verse eid="MRK 9:6" /><verse number="7" style="v" sid="MRK 9:7" />teseδ esHabeθ teg fellasen eTTel, yesδasen eSSuwθ esyiyn: «δwahen memmi elli exsaθ, esleθ edwiys.» <verse eid="MRK 9:7" /><verse number="8" style="v" sid="MRK 9:8" />ebernen liyhliyh yaxi ufiyn iyδsen kan δyesuwε.<verse eid="MRK 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9" />max i bδen δegzen seg eddehreθ iweSSaθen yesuwε bac e lleqqaren yHette Hed elli zrint kan max eyekker bnaδem seg ejafi. <verse eid="MRK 9:9" /><verse number="10" style="v" sid="MRK 9:10" />eTfen elwSiyyeθes, emme eqqiymen necδen g beεDhum: «δmette nette ekkar seg ejafi?» <verse eid="MRK 9:10" /><verse number="11" style="v" sid="MRK 9:11" />usiyn enceδent: «imette imuεelmen necceriyεeθ eqqaren: yelzem eyeddes iliyya qebl?» <verse eid="MRK 9:11" /><verse number="12" style="v" sid="MRK 9:12" />yer fellasen: «mbelHeq, eyeddes iliyya qebl ySelleH kul cey, yemenni emmax i yemmari g elxθab elli bnaδem yelzem eyεane egget eHqrent leεbaδ. <verse eid="MRK 9:12" /><verse number="13" style="v" sid="MRK 9:13" />emme tay δexennenne: iliyya yuseδ, egen δiys elli exsen, emmax i yemmari felles g elxθab.»<verse eid="MRK 9:13" /></para>
  <para style="s">yesuwε eysebre efruwx δiys erruwH ettemenzuwsθ</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14" />umax i δuwlen yetlamδe iddiyn zriyn leεbaδ egget enneDen fellasen wimuεelmen necceriyεeθ etεenaδen δiysen. <verse eid="MRK 9:14" /><verse number="15" style="v" sid="MRK 9:15" />max i θezriyn eθHeyren elkul exeDmen etselmen felles. <verse eid="MRK 9:15" /><verse number="16" style="v" sid="MRK 9:16" />yenceδten: «f mette itεenaδem δiysen?» <verse eid="MRK 9:16" /><verse number="17" style="v" sid="MRK 9:17" />yer felles eryaz essisen: «ya siydiy, uγeδγex memmi εlexaTer δiys erruwH ettemenzuwsθ ettedjaθ δebekkuwc, <verse eid="MRK 9:17" /><verse number="18" style="v" sid="MRK 9:18" />umax etteTTef, ettessender, yeg tixecxac yreSSe isennuqnes yemmekbes. mellegγasen yetlemδax eθgelben yaxi elgeddenc.» <verse eid="MRK 9:18" /><verse number="19" style="v" sid="MRK 9:19" />yer fellasen: «eyeljiyl elli liθemmenc, ellemmi δeqqiyme iyδwem? ellemmi δexenneHmle? eγeδmiyδ efruwx.» <verse eid="MRK 9:19" /><verse number="20" style="v" sid="MRK 9:20" />eγeδnesθ yyesuwε. max i ttezre erruwH temenzuwsθ elweqθes tessenderθ f elqeεεeθ, yetmerreγ utixecxac etteffeγneθ seg imiys. <verse eid="MRK 9:20" /><verse number="21" style="v" sid="MRK 9:21" />yenceδ yesuwε daddes nwefruwx: «seg lemmi elHeltes sahen?» yennes: «seg max δemezyen. <verse eid="MRK 9:21" /><verse number="22" style="v" sid="MRK 9:22" />umenyeθ nmerre etlewweH g elεafyeθ ziyγ uggamen bac e ttenγ. kan eθgeddeδ eθegeδ Haje esxef fellane tεewendane.» <verse eid="MRK 9:22" /><verse number="23" style="v" sid="MRK 9:23" />yennes yesuwε: «imat teqqarδiyδ kan eθgeddeδ. emmen εlexaTer rebbi yetged eyeg kul cey yimuwmnen.» <verse eid="MRK 9:23" /><verse number="24" style="v" sid="MRK 9:24" />elweqθes izeεweg daddes nwefruwx: «ettemne, εawniyδ bac e rniyye!» <verse eid="MRK 9:24" /><verse number="25" style="v" sid="MRK 9:25" />yezer yesuwε elli leεbaδ ettemleyamen, yenzer f erruwH temenzuwsθ yennes: «eyerruwH tileĎrecθ tebekkuwcθ! enniyγem effeγ seg wefruwx umeεεač esθeδwleδ xlaf.» <verse eid="MRK 9:25" /><verse number="26" style="v" sid="MRK 9:26" />θzeεweg erruwH temenzuwsθ texbeĎ efruwx elxebĎeθ teqwe teffeγ essis, yeδwel efruwxdiyn eminemmitte, elennen leεbaδ egget: «yjaf.» <verse eid="MRK 9:26" /><verse number="27" style="v" sid="MRK 9:27" />yeTTefθ yesuwε seg wefuses yessikkerθ, yekker ibed. <verse eid="MRK 9:27" /><verse number="28" style="v" sid="MRK 9:28" />max i yuwδef yelHuwc encδent etlemδas weHδasen: «imette engeddec nečin enessufeγ erruwH temenzuwsθ?» <verse eid="MRK 9:28" /><verse number="29" style="v" sid="MRK 9:29" />yer fellasen: «ennuwεe yettemgelleb kan s tzalliθ.»<verse eid="MRK 9:29" /></para>
  <para style="s">yesuwε eyeθnebbe elmerreθ xlaf s temettentes dwekkeres</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30" />efγen esyiyn eθεeddan seg eljliyl. w ykan yesuwε eliγic Hed eyesl essis, <verse eid="MRK 9:30" /><verse number="31" style="v" sid="MRK 9:31" />εlexaTer ykan yetseqre g etlemδas, yeqqerasen: «δeyemmuwc bnaδem yleεbaδ, usiyn δeθenγen ubeεεeδ enγas s etlaθe eyyam eyekker.» <verse eid="MRK 9:31" /><verse number="32" style="v" sid="MRK 9:32" />yemenni ellefhimenc edwiye, ukδen eθencδen.<verse eid="MRK 9:32" /></para>
  <para style="s">δ wiyn nette emeqqar?</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33" />ewDen ykefernaHuwm. max i δuwδfen yelHuwc yenceδten: «f mat iθkanem ettemxeSamem uggebriδ?» <verse eid="MRK 9:33" /><verse number="34" style="v" sid="MRK 9:34" />yemenni esegren, εlexaTer kanen ettemεenaδen uggebriδ δ wiyn emeqqar δiysen. <verse eid="MRK 9:34" /><verse number="35" style="v" sid="MRK 9:35" />yeqqiym inabe etlamδe leθnac yennasen: «elli yexs eyeδwel δemezwar, yelzem eykuwn δeneggaru nelkul yexδemten elkul.» <verse eid="MRK 9:35" /><verse number="36" style="v" sid="MRK 9:36" />welbeεδ yeTTef efruwx, iHuT uggemmesensen, yeγemmerθ yennasen: <verse eid="MRK 9:36" /><verse number="37" style="v" sid="MRK 9:37" />«elli eyeqbel efruwx emwah f ellesmiyw eyyeqbel, welli eyyeqbel eyyiqebbelc kan enneč emme elli yuzeniyδ zade.»<verse eid="MRK 9:37" /></para>
  <para style="s">elli muc fellane rahu iyδne</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38" />yennes yuwHenna: «imuεellem, nezre eryaz yetgelleb g ecyaĎen s ellesmex weθnedjiyc, εlexaTer muc essiyne.» <verse eid="MRK 9:38" /><verse number="39" style="v" sid="MRK 9:39" />yennasen yesuwε: «edjemt! leHebbe Hette Hed eyeg elHajeθ s ellesmiyw usiyn eyged eyen felle edwi yuwHec. <verse eid="MRK 9:39" /><verse number="40" style="v" sid="MRK 9:40" />elli muc fellane iyδne. <verse eid="MRK 9:40" /><verse number="41" style="v" sid="MRK 9:41" />wexennenne elHeq, elli exenyuc elkas nwamen εlexaTer xenyum tebεiyn elmesiyH, ellejres yetraHc.»<verse eid="MRK 9:41" /></para>
  <para style="s">enebbeh f elli etsebeben g eδnuwb</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42" />yen yesuwε: «elli eysender iyjen seg idreriye elli ettemnen essi g elfsaδ, esθemmayel tγaγet ntesiyreθ g texrumtes yemmeHδef g iylel xires. <verse eid="MRK 9:42" /><verse number="43" style="v" sid="MRK 9:43" />wiδekan yessendrax efusex g elfsaδ quSSi, εlexaTer eθeδfeδ elmemlxeθ nrebbi s wafus iyjen xiyr nelli ebδen γerx sen δifassen texDmeδ yelεafyeθ, <verse eid="MRK 9:43" /><verse number="44" style="v" sid="MRK 9:44" />[mani tixečawin etjefnec welεafyeθ eltnessiyc.]<note caller="+" style="f"><char style="fr" closed="false">9.44 </char><char style="ft" closed="false">[] meεnahe elyelliyc g ennusxeθ. teqδiymt. enzi ellayeθ 48.</char></note> <verse eid="MRK 9:44" /><verse number="45" style="v" sid="MRK 9:45" />wiδekan yessendrax ekreεex g elfsaδ quSSi, εlexaTer eθeδfeδ elmemlxeθ nrebbi s wekreε iyjen xiyr nelli eθebδiyδ γerx sen dikraεen texDmeδ yelεafyeθ. <verse eid="MRK 9:45" /><verse number="46" style="v" sid="MRK 9:46" />[mani tixečawin etjefnec welεafyeθ eltnessiyc.] <verse eid="MRK 9:46" /><verse number="47" style="v" sid="MRK 9:47" />wiδekan tessendrex tiTTex g elfsaδ eqleεt, εlexaTer eθeδfeδ elmemlxeθ nrebbi s tiT icθ xiyr nelli eθkuwneδ γerx sent eTTiTTawin texDmeδ yelεafyeθ. <verse eid="MRK 9:47" /><verse number="48" style="v" sid="MRK 9:48" />mani tixečawin etjefnec welεafyeθ eltnessiyc. <verse eid="MRK 9:48" /><verse number="49" style="v" sid="MRK 9:49" />kul iyjen δeyemmelleH s elεafyeθ. <verse eid="MRK 9:49" /><verse number="50" style="v" sid="MRK 9:50" />tisent tebhe, emme max eθeδwel meεεač eθmelleH, max eθgeddem etterrem tmelleH? edjeθ tisent δiywem, texsem beεDkum.»<verse eid="MRK 9:50" /></para>
  <chapter eid="MRK 9" />
  <chapter number="10" style="c" sid="MRK 10" />
  <para style="s">eγe dwellef</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1" />yekker yesuwε esyiyn yexDem yecciyreθ nelyehuwdiyyeθ yeqĎeε esuwf nelurdun, emlaymen felles leεbaδ yebδe yetseqre δiysen emelεaδeθ. <verse eid="MRK 10:1" /><verse number="2" style="v" sid="MRK 10:2" />eqrebnes ifarisiyyen encδent bac e θjerben: «mat iθenne ecceriyεeθ? iged eryaz eyellef yliweces ziyγ la?» <verse eid="MRK 10:2" /><verse number="3" style="v" sid="MRK 10:3" />yer fellasen: «s mette ixeniweSSe muwse?» <verse eid="MRK 10:3" /><verse number="4" style="v" sid="MRK 10:4" />ennen: «yenne elli eryaz iged esyari yliweces tefreyθ nwellefes usiyn eθellef.» <verse eid="MRK 10:4" /><verse number="5" style="v" sid="MRK 10:5" />yemenni yennasen yesuwε: «εlexaTer ulewnennum eqSeHen yuryawem muwse elwSiyyeθe. <verse eid="MRK 10:5" /><verse number="6" style="v" sid="MRK 10:6" />seg emezwar yexleqθen rebbi edxer dellenθe. <verse eid="MRK 10:6" /><verse number="7" style="v" sid="MRK 10:7" />uwahen yme eyedj eryaz daddes dyemmes yeqqiym dliweces, <verse eid="MRK 10:7" /><verse number="8" style="v" sid="MRK 10:8" />lessen eδwlen iyjen. meεεač sen, emme iyjen. <verse eid="MRK 10:8" /><verse number="9" style="v" sid="MRK 10:9" />welli eθilayem rebbi, eθyetbeεεeδc elεebδ.»<verse eid="MRK 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10" />umax i δuwδfen yelHuwc encδent etlamδe f elHkayeθe, <verse eid="MRK 10:10" /><verse number="11" style="v" sid="MRK 10:11" />yennasen: «elli eyellef yliweces usinc ayeγ icθ xlaf, yezne felles, <verse eid="MRK 10:11" /><verse number="12" style="v" sid="MRK 10:12" />welli eθellef yweryazes taγ iyjen xlaf tezne felles.»<verse eid="MRK 10:12" /></para>
  <para style="s">yesuwε eybarex idrari</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13" />eseδnes leεbaδ s idreriynsen bac e yHuT efuses fellasen, yemenni etlamδe εrxenten. <verse eid="MRK 10:13" /><verse number="14" style="v" sid="MRK 10:14" />yezer yesuwε wediyn yeθγeccec yennasen: «edjeθ idrari eyyeddasen wenterremc, εlexaTer γer-sen elmlax nrebbi. <verse eid="MRK 10:14" /><verse number="15" style="v" sid="MRK 10:15" />tay δexennenne elHeq: elli liqebbelc elmlax nrebbi emmufruwx δemezyen, eθyetteδefc.» <verse eid="MRK 10:15" /><verse number="16" style="v" sid="MRK 10:16" />welbeεδ iγemmerθen iHuT ifesnes fellasen ibarexθen.<verse eid="MRK 10:16" /></para>
  <para style="s">eryaz emuγni</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17" />yeffeγ ywebriδ, yaseδ eryaz yettezzel yesjδes yenceδt: «eyimuεellem eSSaleH, δmette δege bac e θurθe edder diyme?» <verse eid="MRK 10:17" /><verse number="18" style="v" sid="MRK 10:18" />yennes yesuwε: «imette etnabiyδ δiyye eyeSSaleH? eSSaleH kan δrebbi weHδes. <verse eid="MRK 10:18" /><verse number="19" style="v" sid="MRK 10:19" />cex tesseneδ elwSaye: eθenγec, eθezniyc, eθexrec, eθecehδc s ezzuwr, eθeDelmec, kerrem s daddex dyemmex.» <verse eid="MRK 10:19" /><verse number="20" style="v" sid="MRK 10:20" />yer felles eryazdiyn: «eyimuεellem, seg max neč δemezyen uneč θebεe g elwSayaθe elkul.» <verse eid="MRK 10:20" /><verse number="21" style="v" sid="MRK 10:21" />yerqbes yesuwε yeεjebθ yennes: «yelzmex elHajeθ xlaf: berre ezzenz elli γerx elkul tferqeδ essumes f iqelliylen, usahen eyeδwel γerx elkenz γer rebbi, tekreδ eθbεiyδ.» <verse eid="MRK 10:21" /><verse number="22" style="v" sid="MRK 10:22" />yujeεθ edwi nyesuwε, yexDem Hziyn, εlexaTer ykan γer-s egget erzi.<verse eid="MRK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23" />yerqeb yesuwε yetlemδas yen: «muwεer aδef nimuγniyyen yelmelx nrebbi!» <verse eid="MRK 10:23" /><verse number="24" style="v" sid="MRK 10:24" />esθeγerben edwiys, yerni yennasen xlaf: «eyidreriyw, muwεer aδef yelmemlxeθ nrebbi! <verse eid="MRK 10:24" /><verse number="25" style="v" sid="MRK 10:25" />aδef nwelγem g tiT ntissiyniθ eshel nwaδef numuγni yelmelx nrebbi.» <verse eid="MRK 10:25" /><verse number="26" style="v" sid="MRK 10:26" />ernin esθeγerben exθer encδen beεDhum: «δ wiyn δeyemneε ziyγ?» <verse eid="MRK 10:26" /><verse number="27" style="v" sid="MRK 10:27" />yerqebθen yesuwε yen: «leεbaδ eθetgeddenc egen wahen, emme rebbi yetged eyeg kul cey.» <verse eid="MRK 10:27" /><verse number="28" style="v" sid="MRK 10:28" />yennes buTrus: «tay nečin nedje kul cey neθbεax.» <verse eid="MRK 10:28" /><verse number="29" style="v" sid="MRK 10:29" />yer f elles yesuwε: «tay δexennenne elHeq, leHebbe Hed yedje elHuwc ziyγ δemmaθen ziyγ ettemmaθin ziyγ δyemme ziyγ δdadde ziyγ δidrari ziyγ δijiyman f elxeĎriyw delbcareθ, <verse eid="MRK 10:29" /><verse number="30" style="v" sid="MRK 10:30" />kan eyawi g eddunyeθe myat merre seg leHwac demmaθen ettemmaθin deθyemme d idrari d ijiyman d εeδδeb, yawi g ellaxreθ edder diyme. <verse eid="MRK 10:30" /><verse number="31" style="v" sid="MRK 10:31" />wegget seg imezwaren eδuwlen δellexren, wegget seg ellexren eδwlen δimezwaren.»<verse eid="MRK 10:31" /></para>
  <para style="s">yesuwε eyeθnebbe elmerreθ teθθalet s temettentes dwekkeres</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32" />ukanen uggebriδ δeδelyen yuwrceliym uyesuwε yegguwr ezzeθensen. ukanen etlemδas dleεbaδ elli θebεen δiys merεubiyn uxayfiyn. yawi eθnacdiyn weHδasen elmerreθ xlaf yebδe yHekkeyasen f elli δesyejre, <verse eid="MRK 10:32" /><verse number="33" style="v" sid="MRK 10:33" />yen: «tay nečin δenali yuwrceliym, ubnaδem δeyemmuwc yelkuhhan imeqqaren dimuεelmen necceriyεeθ, usiyn δeHukmen felles s ujafi uwcent yelHukkam δiγriyben, <verse eid="MRK 10:33" /><verse number="34" style="v" sid="MRK 10:34" />elli δeSSen felles, eskufsen felles, ewθent, enγent, ubeεεeδ tlaθe eyyam eyekker.»<verse eid="MRK 10:34" /></para>
  <para style="s">eĎlab nyeεquwb dyuwHenna</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35" />elweqθes eqerben yetweliys yeεquwb dyuwHenna, idrari nzebediy, ennanes: «eyimuεellem, nexs exentegeδ elli δexnen.» <verse eid="MRK 10:35" /><verse number="36" style="v" sid="MRK 10:36" />yenceδten: «δmette iθexsem exennege?» <verse eid="MRK 10:36" /><verse number="37" style="v" sid="MRK 10:37" />erren felles: «edjane eneqqiym, iyjen f elyminex wiyjen f eliserex g elmemlexθex.» <verse eid="MRK 10:37" /><verse number="38" style="v" sid="MRK 10:38" />yennasen yesuwε: «xenyum eltessinemc δmette iddelbem: endre eθgeddem eθeswem seg elkas elli δeswe essis, weθeqblem temeεmuwdiyyeθ nelwjayeε elli δetteqeble?» <verse eid="MRK 10:38" /><verse number="39" style="v" sid="MRK 10:39" />erren felles: «enged.» yennasen: «emmale elkas elli δeθeswe δeθeswem essis, utemeεmuwdiyyeθ nelwjayeε elli δetteqeble δetteqeblem. <verse eid="MRK 10:39" /><verse number="40" style="v" sid="MRK 10:40" />emme egeεmez f elyminiyw deliseriyw, elgeddac exenyθuwce εlexaTer yelli iHeDresenten rebbi.» <verse eid="MRK 10:40" /><verse number="41" style="v" sid="MRK 10:41" />eslen etlamδe elεecre edwiye, eθγececen f yeεquwb dyuwHenna. <verse eid="MRK 10:41" /><verse number="42" style="v" sid="MRK 10:42" />inebaθen yesuwε yennasen: «tessenem elli erruwyyes ntimuwre Hekmen δiysneθ, welli imeqqarnensneθ etteθsellaten fellasneθ. <verse eid="MRK 10:42" /><verse number="43" style="v" sid="MRK 10:43" />eθedjemc wahen δiywem, welli yexs eykuwn δemeqqar δiywem yelzem eykuwn δexeddemennum. <verse eid="MRK 10:43" /><verse number="44" style="v" sid="MRK 10:44" />welli yexs eykuwn δemezwar δiywem yelzem eykuwn δelεebδ nelkul. <verse eid="MRK 10:44" /><verse number="45" style="v" sid="MRK 10:45" />εlexaTer bnaδem elyeddusiyc bac e θexeδmen leεbaδ emme bac e nyexδem yuwc leHyeθes δelfeδyeθ f elberceθ.»<verse eid="MRK 10:45" /></para>
  <para style="s">esebri nbertiymawus ileεmi</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46" />ewDen yeriyHa. unette δeyeffeγ seg eriyHa wiyδes etlemδas dleεbaδ egget, bertiymawus, memmis ntiymawus, eĎellab δileεmi, ykan ygeεmez f eccafeθ nwebriδ. <verse eid="MRK 10:46" /><verse number="47" style="v" sid="MRK 10:47" />max i yesle elli δeyeθεedde esyiyn nette δyesuwε ennaSriy, yebδe yetzeεweg: «yesuwε, emmiys ndawud, ereHmiyδ!» <verse eid="MRK 10:47" /><verse number="48" style="v" sid="MRK 10:48" />enzren felles leεbaδ bac e yesger, yaxi yerni izeεweg exθer: «emmiys ndawud, ereHmiyδ!» <verse eid="MRK 10:48" /><verse number="49" style="v" sid="MRK 10:49" />ibed yesuwε yen: «nebameθ!» naben ileεmi ennanes: «eθcejjeε tekreδ, tay yetnabe δiyx.» <verse eid="MRK 10:49" /><verse number="50" style="v" sid="MRK 10:50" />ylewweH ebernuwses yekker yexDem yyesuwε. <verse eid="MRK 10:50" /><verse number="51" style="v" sid="MRK 10:51" />yennes yesuwε: «δmette iθexseδ exege?» yennes: «exse ezre, ya siydiy!» <verse eid="MRK 10:51" /><verse number="52" style="v" sid="MRK 10:52" />yennes yesuwε: «berre! elimenex yeSSebrayex.» elweqθes yeδwel izer yeθbeε yesuwε uggebriδes.<verse eid="MRK 10:52" /></para>
  <chapter eid="MRK 10" />
  <chapter number="11" style="c" sid="MRK 11" />
  <para style="s">yesuwε eyaδef uwrceliym</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1" />max i Tullen f uwrceliym ewDen ibiytfaji dbiytεenya, g eddehreθ nuzemmuwr, yuzen yesuwε sen seg etlemδas. <verse eid="MRK 11:1" /><verse number="2" style="v" sid="MRK 11:2" />yennasen: «berreθ ytemuwreθ elli ezzeθennum, umax etteδfem δeθefem ejjeHc yemmeqqen elyiyni felles Hette Hed, miremt teγδemt. <verse eid="MRK 11:2" /><verse number="3" style="v" sid="MRK 11:3" />umax exenyenceδ Hed: &lt;imette ittegem g wahen, enmes yeseθHeqqi rebbi, ture eθner liyhliyh.&gt;» <verse eid="MRK 11:3" /><verse number="4" style="v" sid="MRK 11:4" />exeDmen sennadiyn efen ejjeHc yemmeqqen g elbab f webriδ, mirent. <verse eid="MRK 11:4" /><verse number="5" style="v" sid="MRK 11:5" />encδenten elli kanen diyn: «ecbiykum etmarem g ejjeHc?» <verse eid="MRK 11:5" /><verse number="6" style="v" sid="MRK 11:6" />ennenasen emmax i nniweSSe yesuwε, edjenten. <verse eid="MRK 11:6" /><verse number="7" style="v" sid="MRK 11:7" />ewyen ejjeHc y yesuwε, HuTTen edbecensen felles<note caller="+" style="f"><char style="fr" closed="false">11.7 </char><char style="ft" closed="false">enzi zk 9:9</char></note> yini. <verse eid="MRK 11:7" /><verse number="8" style="v" sid="MRK 11:8" />w egget leεbaδ essewen edbecensen f ebriδ, w lebHaD ettireĎwiyn ebyenten seg ijiyman. <verse eid="MRK 11:8" /><verse number="9" style="v" sid="MRK 11:9" />w kanen elli egguwren ezzaθ nyesuwε welli θebεen δiys etzeεwgen: «uSenna<note caller="+" style="f"><char style="fr" closed="false">11.9 </char><char style="ft" closed="false">meεnahe bilεibriye &lt;eyemneε!&gt; utah δeTTeriyqeθ elli ettesθeqbalen essis elmlek. enzi mz 118:25</char></note>! eyembarex elli yeseδ s ellesm nrebbi! <verse eid="MRK 11:9" /><verse number="10" style="v" sid="MRK 11:10" />eθembarex elmemlxeθ elli δeθeddes, elmemlxeθ ndaddeθne dawud! uSenna g elεlaliy!»<verse eid="MRK 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11" />yaδef yesuwε uwrceliym elmi yiweD yelheykel, yerqeb kul cey δiys. w ykan meεεač bekri, yeffeγ ibiytεenya nette detlemδas leθnac.<verse eid="MRK 11:11" /></para>
  <para style="s">yesuwε eyelεen temečiyθ</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12" />umax i fγen elweječe seg biytεenya yHus s elez. <verse eid="MRK 11:12" /><verse number="13" style="v" sid="MRK 11:13" />yezer seg lebεiyδ temečiyθ δiys tifray, yexDmes balek ayef δiys Haje. max i tyiweD elyuwfi δiys kan ettifray, εlexaTer elyuwc muc δelweqθ nimečan. <verse eid="MRK 11:13" /><verse number="14" style="v" sid="MRK 11:14" />yennes: «meεεač eyeč Hette Hed imečan essim.» eslen etlemδas elli yenni.<verse eid="MRK 11:14" /></para>
  <para style="s">yesuwε eygelleb ibeyyaεen seg elheykel</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15" />ewDen yuwrceliym, yaδef yelheykel yebδe yetgelleb g elli ezzenzen wessaγen diyn. yeqleb etwawel nelli etbedlen g lefluws delkrasi nelli ezzenzen g iδbiyren, <verse eid="MRK 11:15" /><verse number="16" style="v" sid="MRK 11:16" />welyedjiyc elli qamen esselεeθ θεedden yelheykel. <verse eid="MRK 11:16" /><verse number="17" style="v" sid="MRK 11:17" />yebδe yetseqre δiysen: «elyemmeriyc: &lt;elHuciyw δelHuwc netzalliθ yleεbaδ elkul?&gt; yemenni xenyum terriymt δedduγreθ nixennaben.» <verse eid="MRK 11:17" /><verse number="18" style="v" sid="MRK 11:18" />eslen erruwyyes nelkuhhan dimuεelmen necceriyεeθ edwiye, emcawren max δeθenγen, ukanen ettekkaδen essis εlexaTer leεbaδ elkul yeεjebθen eseqriys. <verse eid="MRK 11:18" /><verse number="19" style="v" sid="MRK 11:19" />g tisemsiyn efγen seg θemuwreθ.<verse eid="MRK 11:19" /></para>
  <para style="s">edders ntemečiyθ</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20" />max i θεedden esyiyn g talji, zriyn temečiyθ teqquwr seg leεruwqes. <verse eid="MRK 11:20" /><verse number="21" style="v" sid="MRK 11:21" />yesfekker buTrus edwi nyesuwε yennes: «erqeb, ya siydiy! temečiyθ elli telεnetteθ teqquwr.» <verse eid="MRK 11:21" /><verse number="22" style="v" sid="MRK 11:22" />yennasen yesuwε: «emneθ s rebbi. <verse eid="MRK 11:22" /><verse number="23" style="v" sid="MRK 11:23" />exennenne elHeq, elli esyen yeddehreθe, &lt;ekker temmeĎrHeδ g iylel.&gt; unette g ules yečukkec uyettemmen elli yeqqar δiys δeySar, eyeδwel siyn ynette. <verse eid="MRK 11:23" /><verse number="24" style="v" sid="MRK 11:24" />utay δexennenne: elli etteDelbem g eθzalliθennum, emneθ elli tiwyemt uture eyeδwel yxenyum. <verse eid="MRK 11:24" /><verse number="25" style="v" sid="MRK 11:25" />umax eθekrem yeθzalliθ samHeθ elli γerwem felles Haje, bac e xenysameH daddeθwem elli lennej zade g elli θegiymt. <verse eid="MRK 11:25" /><verse number="26" style="v" sid="MRK 11:26" />[wiδekan etsamiHemc beεDkum, exenyetsemiyHc daddeθwem elli lennej g elli θegiymt.»]<note caller="+" style="f"><char style="fr" closed="false">11.26 </char><char style="ft" closed="false">enzi mt 6:15</char></note><verse eid="MRK 11:26" /></para>
  <para style="s">eSSulteθ elli θemmuwc yyesuwε</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27" />eδwlen yuwrceliym. unette yegguwr g elheykel useδnes erruwyyes nelkuhhan dimuεelmen necceriyεeθ delmcayex ntemuwreθ. <verse eid="MRK 11:27" /><verse number="28" style="v" sid="MRK 11:28" />ennanes: «δmette elquwweθ elli ettegeδ essis wahen elkul? weδwiyn ixtyuwce?» <verse eid="MRK 11:28" /><verse number="29" style="v" sid="MRK 11:29" />yer fellasen yesuwε: «uneč δexennencδe f elHajeθ icθ, terrem felle usiyn δexennenne f elquwweθ elli ettege essis wahen elkul. <verse eid="MRK 11:29" /><verse number="30" style="v" sid="MRK 11:30" />yuwHenna, δ wiyn isyuwce elquwweθ netmeεmuwdiyyeθ? s γer rebbi ziyγ s γer leεbaδ? jewebmiy!» <verse eid="MRK 11:30" /><verse number="31" style="v" sid="MRK 11:31" />cewren beεDhum ennen: «kan nenne s γer rebbi, δexenyen &lt;ecbiykum eltemminemc essis?&gt; <verse eid="MRK 11:31" /><verse number="32" style="v" sid="MRK 11:32" />enen ziyγ s γer leεbaδ?» emme kanen ettekkaδen seg leεbaδ, εlexaTer leεbaδ elkul kanen muqtenεiyn s elli yuwHenna δenbi belHeq. <verse eid="MRK 11:32" /><verse number="33" style="v" sid="MRK 11:33" />erren f yesuwε: «ennessiync!» yennasen yesuwε: «uneč exenneqqerac δ menten elquwweθ elli ettege essis wahen elkul.»<verse eid="MRK 11:33" /></para>
  <chapter eid="MRK 11" />
  <chapter number="12" style="c" sid="MRK 12" />
  <para style="s">elmθel nifellaHen nelεneb</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1" />yebδe yHekkeyasen s lemθal yennasen: «yezzu eryaz elεneb, yessuwneD f elles essuwr, yeHfer δiys timeεSerθ yebne elburj, yuwci yixemmasen yexDem ytemuwreθ xlaf. <verse eid="MRK 12:1" /><verse number="2" style="v" sid="MRK 12:2" />max i yedduwse elweqθ nwekkas nelεneb, yeznasen exeddam bac e syeddeγ elbeyes nelεneb. <verse eid="MRK 12:2" /><verse number="3" style="v" sid="MRK 12:3" />eTfen ewθent rejεent wifesnes δelfurraγ. <verse eid="MRK 12:3" /><verse number="4" style="v" sid="MRK 12:4" />yazen exeddam xlaf, ewθent f ixfes izment, εezrent usiyn rejεent. <verse eid="MRK 12:4" /><verse number="5" style="v" sid="MRK 12:5" />yazen iyjen xlaf, uwahen enγint. yazen egget xlaf, ewθen elli ewweθen essisen, wenγiyn elli enγiyn. <verse eid="MRK 12:5" /><verse number="6" style="v" sid="MRK 12:6" />wesyeqqiym kan δmemmis elli yexsi egget, g ellexxer yeznesent yen, &lt;δeqedderen memmi.&gt; <verse eid="MRK 12:6" /><verse number="7" style="v" sid="MRK 12:7" />yaxi ennen ixemmasendiyn y beεDhum, &lt;tay elli δeyuwreθ elqeεεeθe, heyyeθ, edj eθnenγ, usinc enawi nečin elwerθes.&gt; <verse eid="MRK 12:7" /><verse number="8" style="v" sid="MRK 12:8" />eTfen enγent lewHent elberre nelqeεεeθ nelεneb. <verse eid="MRK 12:8" /><verse number="9" style="v" sid="MRK 12:9" />δmette δeyeg iθbab nelεneb? eyeddes yenγ ixemmasen yuwc elεneb yelγirensen.<note caller="+" style="f"><char style="fr" closed="false">12.9 </char><char style="ft" closed="false">enzi ic 5:1-7. icεiyya yqaren leεbaδ nrebbi ejiymi nelεneb urebbi s iθbab nujiymi nelεneb. wifellaHen nelεneb s elquyyaδ nelyehuwdiyyen.</char></note> <verse eid="MRK 12:9" /><verse number="10" style="v" sid="MRK 12:10" />elteqriymc ellayeθe: elkurδ elli lewHent ibennayen nette biyδe yeδwel δelkurδ nessas? <verse eid="MRK 12:10" /><verse number="11" style="v" sid="MRK 12:11" />rebbi yege wahen, unette δeεjiyb g tiTTewinenne!»<verse eid="MRK 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12" />Hewlen elquyyaδ niyehuwdiyyen δeθeTfen, εlexaTer uwxezen elli yenne elmθele fellasen. yemenni ukkeδen seg leεbaδ. edjent exDmen.<verse eid="MRK 12:12" /></para>
  <para style="s">eδfaε neljezyeθ yelqeySer</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13" />ezennes eljmaεeθ seg ifarisiyyen delHezb nhiyruwdus bac e θeTfen s θuθleyθ, <verse eid="MRK 12:13" /><verse number="14" style="v" sid="MRK 12:14" />eseδnes ennanes: «ey imuεellem, nessen elli cex eltesxerxusec, wettekkaδeδ s Hette Hed, εlexaTer eltlehhiyc s elmneSbensen, uselHeq tesseqriyδ edwi nrebbi. mat iθenne ecceriyεeθ? eδfaε neljezyeθ yelqeySer ziyγ la? yelzem etneδfeε ziyγ la?» <verse eid="MRK 12:14" /><verse number="15" style="v" sid="MRK 12:15" />ifaq yesuwε s elHiyltensen, yennasen: «imette iθexsem eyeθHeSlem? ezleθ eddiynar bac e θezre.» <verse eid="MRK 12:15" /><verse number="16" style="v" sid="MRK 12:16" />ezzelnes eddiynar, yennasen: «etteSwiyreθe nwiyn wellesme nwiyn?» ennen: «nelqeySer!» <verse eid="MRK 12:16" /><verse number="17" style="v" sid="MRK 12:17" />yennasen: «uwceθ egli nqeySer yqeySer, wegli nrebbi yrebbi.» esθeγerben.<verse eid="MRK 12:17" /></para>
  <para style="s">ekker nilemmitte</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18" />eseδnes iSedduwqiyyen, elli etSedqenc s elqyameθ, encδent: <verse eid="MRK 12:18" /><verse number="19" style="v" sid="MRK 12:19" />«eyimuεellem, yuryane muwse: max eyjaf enjes nweryaz yedj liweces welyedduγiyc idrari, yelzem eryaze etyaγ yaγeδ idrari yenjes. <verse eid="MRK 12:19" /><verse number="20" style="v" sid="MRK 12:20" />ukanen ellan sebεe δemmaθen: yenjef emezwar, yjaf welyedjiyc idrari. <verse eid="MRK 12:20" /><verse number="21" style="v" sid="MRK 12:21" />yaγiθ eθθani, yjaf welyedjiyc idrari usiyn eθθaleθ d iddiynni elkul, <verse eid="MRK 12:21" /><verse number="22" style="v" sid="MRK 12:22" />welyedji Hette iyjen essisen idrari. usiyn eθjaf Hette temeTTuwtdiyn beεδensen. <verse eid="MRK 12:22" /><verse number="23" style="v" sid="MRK 12:23" />δliwec nwiyn essisen δeθeδwel as nelqyameθ? εlexaTer eθkan δliwecensen elkul.»<verse eid="MRK 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24" />yer fellasen yesuwε: «mebεeδkum f elHqiyqeθ! eltessinem la δelxθabeθ imqedsen la δelquδreθ nrebbi. <verse eid="MRK 12:24" /><verse number="25" style="v" sid="MRK 12:25" />εlexaTer as nelqyameθ leHebbac e γe, δeδuwlen emelmleyxaθ g esmawaθ. <verse eid="MRK 12:25" /><verse number="26" style="v" sid="MRK 12:26" />ufekker nilemmitte, elteqriymc g elxθab nmuwse g ellayeθ nteεulliygθ, max i syuθley rebbi yennes: neč δrebbis nibrahiym disHaq dyeεquwb? <verse eid="MRK 12:26" /><verse number="27" style="v" sid="MRK 12:27" />mehuwwac δerreb nilemmitte, emme δerreb nihelli edderen. teγleĎem egget!»<verse eid="MRK 12:27" /></para>
  <para style="s">elwSaye tiglewlin</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28" />w ykan iyjen seg imuεelmen necceriyεeθ diyn. yesliyn ettemεenaδen. yezer elli yesuwε yerre belgde f iSedduqiyyiyn, yeqreb yetweliys yenceδt: «δ menten temezwarθ g elwSaye elkul?» <verse eid="MRK 12:28" /><verse number="29" style="v" sid="MRK 12:29" />yer felles yesuwε: «elwSayeθ temezwarθ: israYiyl esseγδ, rebbinne iyjen weHδes. <verse eid="MRK 12:29" /><verse number="30" style="v" sid="MRK 12:30" />exs rebbi elli yexleqex s ulex elkul derruHex elkul delεeqlex elkul, uselli eθgeddeδ elkul. <verse eid="MRK 12:30" /><verse number="31" style="v" sid="MRK 12:31" />utahen elwSayeθ teθθaniθ: exs eljiyrenex emmax i θexseδ imenex. leHebbac e lwSaye xiyr nsentaye.» <verse eid="MRK 12:31" /><verse number="32" style="v" sid="MRK 12:32" />yennes imuεellem necceriyεeθ: «SeHHiyt, teSδeqeδ max i θenniyδ elli rebbi iyjen weHδes, <verse eid="MRK 12:32" /><verse number="33" style="v" sid="MRK 12:33" />uyelzem eθyexs elεebδ s ules elkul delεeqles elkul delquδreθes elkul, uyexs eljeres emmax i yexs imenes, xiyr neDHaye elkul.» <verse eid="MRK 12:33" /><verse number="34" style="v" sid="MRK 12:34" />yezer yesuwε elli eryazdiyn yerre belgde, yennes: «eltebεiδc f elmemlxeθ nrebbi.» seg elweqθes weliged Hette iyjen essisen eθyenceδ.<verse eid="MRK 12:34" /></para>
  <para style="s">elmesiyH ddawud</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35" />umax i ykan yesuwε yetseqre g elheykel, yenne: «max ennen imuεelmen necceriyεeθ elli elmesiyH δmemmis ndawud? <verse eid="MRK 12:35" /><verse number="36" style="v" sid="MRK 12:36" />udawud biyδe yenne s elweHy seg erruwH nelqudus, &lt;yenne rebbi yrebbi, geεmez f elyminiyw, elδeHuTTe elεδu egliyx seddu ikreεnex.&gt; <verse eid="MRK 12:36" /><verse number="37" style="v" sid="MRK 12:37" />udawud biyδe yetnabe gelmesiyH rebbi, emmale max δeykuwn elmesiyH δmemmis?» ukanen leεbaδ egget esseγδan g yesuwε unihnin ferHeniyn.<verse eid="MRK 12:37" /></para>
  <para style="s">yesuwε yetnebbeh seg imuεelmen necceriyεeθ</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 12:38" />yennasen g useqriys: «erreθ elbelennum seg imuεelmen necceriyεeθ, exsen ebanen s edbac δiTwiylen duHeyyi g elbeĎHaθ. <verse eid="MRK 12:38" /><verse number="39" style="v" sid="MRK 12:39" />wexsen zade elkrasi imezwure g eljwameε delεerDaθ. <verse eid="MRK 12:39" /><verse number="40" style="v" sid="MRK 12:40" />yemenni etγaren f leHwac ntidjalin, wessexnan elli etĎewlen g eθzelliθensen. δeyeggez fellasen elεqab δemeqqar.»<verse eid="MRK 12:40" /></para>
  <para style="s">eddiynar ntehejjelt</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41" />yeqqiym yesuwε g elheykel, δimqabel eSSenduwq nuSeddeq, ireqqeb g leεbaδ etHuTTen g lefluws δiys. HuTTen imuγniyyen egget lefluws egget. <verse eid="MRK 12:41" /><verse number="42" style="v" sid="MRK 12:42" />teseδ tedjalt ettefqiyreθ, eθHuT diyn sen δelfrenkaθ. <verse eid="MRK 12:42" /><verse number="43" style="v" sid="MRK 12:43" />inabe etlemδas yennasen: «δexennenne elHeq, tedjalte tefqiyrθ tHuT g eSSenduwq exθer nelli HuTTenti leεbaδ elkul. <verse eid="MRK 12:43" /><verse number="44" style="v" sid="MRK 12:44" />εlexaTer nihnin HuTTen ezzayeδ f elHajθensen, emme netteθ tHuT elli γer-s elkul reγmelli netteθ etteqelliylt.»<verse eid="MRK 12:44" /></para>
  <chapter eid="MRK 12" />
  <chapter number="13" style="c" sid="MRK 13" />
  <para style="s">yesuwε eyeθnebbe s waxle nelheykel</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1" />max i yeffeγ seg elheykel, yennayes iyjen seg etlemδas: «erqeb eyimuεellem mesmeH elkurδe delbniye!» <verse eid="MRK 13:1" /><verse number="2" style="v" sid="MRK 13:2" />yer f elles yesuwε: «tezriyδ elbniye emeqqar? elyetqimiyc essis elkurδ f beεDe, δeyemheddem elkul.»<verse eid="MRK 13:2" /></para>
  <para style="s">elεlameθ nwewqe neddunyeθ</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3" />unette ygeεmez g eddehreθ nuzemmuwr, δimqabel elheykel, encδent buTrus dyeεquwb dyuwHenna dendrawus weHδasen: <verse eid="MRK 13:3" /><verse number="4" style="v" sid="MRK 13:4" />«ennene lemmi δeyeddes elxrabe, uδmette elεlemθes ulemmi wahen elkul δeyekmel?» <verse eid="MRK 13:4" /><verse number="5" style="v" sid="MRK 13:5" />yer fellasen yesuwε: «erreθ elbelennum exenyesraH la δHed. <verse eid="MRK 13:5" /><verse number="6" style="v" sid="MRK 13:6" />δeddasen leεbaδ egget s ellesmiyw, uδennen &lt;neč δelmesiyH!&gt; uδexeδεen leεbaδ egget. <verse eid="MRK 13:6" /><verse number="7" style="v" sid="MRK 13:7" />umax eθeslem s leHruwb dlexbar nleHruwb etemmerεbemc, εlexaTer wahen yelzem eySar, emme muc ennetteθ ellaxreθ. <verse eid="MRK 13:7" /><verse number="8" style="v" sid="MRK 13:8" />δemεarexneθ timuwre ettimuwre, welmemlxaθ δelmemlxaθ, asδen ezlazel g elblayeS egget, eseδneθ elmejaεaθ, uwahen delbδu nelwjayeε.<verse eid="MRK 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9" />emme xenyum erreθ elbelennum. δexennuwcen y elmHakem, uwweθnawem g elmjameε, uδexennawyen yelHukkam dlemluwk bac e θecehδem felle γer-sen, <verse eid="MRK 13:9" /><verse number="10" style="v" sid="MRK 13:10" />εlexaTer elbcareθ yelzem eθembeccer yleεbaδ elkul qebl ellaxreθ. <verse eid="MRK 13:10" /><verse number="11" style="v" sid="MRK 13:11" />umax exennewyen bac e θecehδem eθelhiymc max δeθeHkiym, emme eHkaθ s elli δeyeggez fellawem g elweqθes, εlexaTer δerruwH nelqudus δeθuθley muc δxenyum. <verse eid="MRK 13:11" /><verse number="12" style="v" sid="MRK 13:12" />enje δeyuc enjes yujafi, weryaz δeyuc memmis, ekren idrari f daddensen enγenten, <verse eid="MRK 13:12" /><verse number="13" style="v" sid="MRK 13:13" />uleεbaδ δexennexrhen f elxaĎer nellesmiyw. yemenni elli δeyeqqiym yellexxer δeyemneε.<verse eid="MRK 13:13" /></para>
  <para style="s">axle emeqqar</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14" />umax eθezrem &lt;enjaseθ nelxrab&gt;<note caller="+" style="f"><char style="fr" closed="false">13.14 </char><char style="ft" closed="false">yesuwε eyeθnebbe elli δedyes iyjen eysender elheykel g uwrceliym elmerreθ xlaf. enzi daniyal 11:31.</char></note> meni mayelzemc eθkuwn, (efhem yelli tqerriyδ), eyerwel yeddehreθ elli ykan g elyehuwdiyyeθ. <verse eid="MRK 13:14" /><verse number="15" style="v" sid="MRK 13:15" />welli g esqef, yetteggezc yelHuwc bac e yawi essis Haje. <verse eid="MRK 13:15" /><verse number="16" style="v" sid="MRK 13:16" />welli g ujiymi, liδukkelc bac e yawi edbeces. <verse eid="MRK 13:16" /><verse number="17" style="v" sid="MRK 13:17" />yeHliylhum elli δeθeruwneθ welli essesfaneθ g liyyametdiyn. <verse eid="MRK 13:17" /><verse number="18" style="v" sid="MRK 13:18" />ezzalleθ bac e lxrabe wahen elyetSarc g tejresθ, <verse eid="MRK 13:18" /><verse number="19" style="v" sid="MRK 13:19" />εlexaTer δeθSar ennekbeθ g liyyametdiyn elεemres weltSar seg max i yexleq rebbi eddunyeθ elture, wetSarec xlaf. <verse eid="MRK 13:19" /><verse number="20" style="v" sid="MRK 13:20" />ulukan muc yedje rebbi liyyametdiyn tuqSiyrin, rahu elyemniyε Hette Hed. emme f elxaĎer nelli yexθarin yqeSrane g liyyametdiyn. <verse eid="MRK 13:20" /><verse number="21" style="v" sid="MRK 13:21" />umax exenyen la δHed, &lt;tay elmesiyH dahen!&gt; ziyγ, &lt;tenni γeDiyn!&gt; eθeslemc edwiys. <verse eid="MRK 13:21" /><verse number="22" style="v" sid="MRK 13:22" />εlexaTer δeyeffeγ elmesiyH δ eδejjal dlenbye δ iδejjalen esxerxuwsen egget, ettegen g ellayeθ delmuεjzaθ, ulukan g edden δesraHen elli yexθarin rebbi. <verse eid="MRK 13:22" /><verse number="23" style="v" sid="MRK 13:23" />erreθ elbelennum. tay enniγawem f kul cey qebl eySar.<verse eid="MRK 13:23" /></para>
  <para style="s">aseδ nemmiys nebnaδem</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24" />g liyyametdiyn, beεεeδ elweqθ neDDiyq, δeθessulles tefuwθ uteziyri etDewwiyc.<note caller="+" style="f"><char style="fr" closed="false">13.24 </char><char style="ft" closed="false">enzi ellayeθ elkul ic 13:9-13; 24:21-23; 34:4; Hz 32:7-8; yU 2:10, 31; 3:15; εa 8:9. meεnahe as nelqiyameθ.</char></note> <verse eid="MRK 13:24" /><verse number="25" style="v" sid="MRK 13:25" />uDan iθran seg esme eθHerrexneθ elquwwaθ elli g esme. <verse eid="MRK 13:25" /><verse number="26" style="v" sid="MRK 13:26" />elweqθes δezren leεbaδ bnaδem yuseδ g esHab<note caller="+" style="f"><char style="fr" closed="false">13.26 </char><char style="ft" closed="false">esHab yessexneyasen elli rebbi muwjuwδ ezzeθensen. enzi mr 9:7; 14:62, dan 7:13-14. elleyeθe eqqarneθ max bnaδem δedyes urebbi δesyuc elquwweθ delquδreθ bac e yeHkem diyme.</char></note> γer-s elmejδ delquδreθ temeqqarθ. <verse eid="MRK 13:26" /><verse number="27" style="v" sid="MRK 13:27" />usiyn δeyezen elmlayxeθes g teme nwaDuwwaθ lerbεe bac e ylayem elli yexθarin seg ellexxer nelqeεεeθ yellexxer nesme.<verse eid="MRK 13:27" /></para>
  <para style="s">edders ntemečiyθ</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28" />eHfDeθ seg temečiyθ: max erĎaben leεrefes teg tifray, esneθ elli enebδu εuddi yebδe. <verse eid="MRK 13:28" /><verse number="29" style="v" sid="MRK 13:29" />umax eθezrem wahen elkul δeySar, esneθ elli elweqθ yiweD. <verse eid="MRK 13:29" /><verse number="30" style="v" sid="MRK 13:30" />tay δexennenne elHeq: eljiyle liweqqiyc kan eySar wahen elkul. <verse eid="MRK 13:30" /><verse number="31" style="v" sid="MRK 13:31" />esme delqeεεeθ δexDemneθ, yemenni edwiyw lixeTTemc.<verse eid="MRK 13:31" /></para>
  <para style="s">eshar diyme</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32" />emme asdiyn ziyγ esseεetdiyn eθyessen Hette Hed, la δelmlayxe ndadde g esme ula δmemmis, eθyessen Hette Hed kan δdadde. <verse eid="MRK 13:32" /><verse number="33" style="v" sid="MRK 13:33" />erreθ elbelennum eθεussem, εlexaTer eltessinemc lemmi δeyeddes elweqθ. <verse eid="MRK 13:33" /><verse number="34" style="v" sid="MRK 13:34" />uwediyn emweryaz iγerreb yedj elHuces yuwci yixeddemnes, kul iyjen s elxeδmtes, yweSSe eεessas bac e yεus. <verse eid="MRK 13:34" /><verse number="35" style="v" sid="MRK 13:35" />εusseθ emmale, εlexaTer eltessinemc lemmi δeyeddes iθbab nelHuwc, g tisemsiyn ziyγ uggezyen niyD ziyγ max eyedden eyaziδ ziyγ g talji, <verse eid="MRK 13:35" /><verse number="36" style="v" sid="MRK 13:36" />eyexDemc eyeddes yefawem tenεesem. <verse eid="MRK 13:36" /><verse number="37" style="v" sid="MRK 13:37" />welli enniγewemt δeθenne yleεbaδ elkul, εusseθ emmale!»<verse eid="MRK 13:37" /></para>
  <chapter eid="MRK 13" />
  <chapter number="14" style="c" sid="MRK 14" />
  <para style="s">ejerreb nwenγe nyesuwε</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1" />qebl elfeSH delεiyδ ntifĎiyrin<note caller="+" style="f"><char style="fr" closed="false">14.1 </char><char style="ft" closed="false">nihnin sen δleεyaδ emmegen meεe beεDhum. iyh essenniyn esfekkerenten elweqθ elli rebbi imenneε leεbeδes seg elεubudiyyeθ g miSr g elfetreθ nseyyedne muwse. rebbi yuzen elmlax ntemettent bac e yenγ elli eyemmaru emezwar elkul g miSr. yemenni elmlax ntemettent yeθεedde δenni kul elHuwc yufe elεeθebθes temmeδhen s iδammen nuεelluc (elxuruwj 12). eyendeγ s temettent nuεelluc yemneε kul emezwar g israYiyl.</char></note> s enhariyn, eqqiymen imeqqaren nelkuhhan dimuεelmen necceriyεeθ etHewmen max δeTfen yesuwε s elHiyleθ bac e θenγen. <verse eid="MRK 14:1" /><verse number="2" style="v" sid="MRK 14:2" />emme ennen: «muc g elεiyδ bac leεbaδ etteδfenc beεDhum.» temeTTuwθ eθenγel erriyHeθ f yesuwε<verse eid="MRK 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3" />max i ykan yesuwε g biytεenya, iθet g elHuwc nsemεan enebraS, tuseδ temeTTuwθ g wefuses teδebbuzeθ tebhe nerriyHeθ teγle seg ennardiyn eSSafi, eθkessert tenγel erriHetdiyn f ixfes. <verse eid="MRK 14:3" /><verse number="4" style="v" sid="MRK 14:4" />eθγececen lebHaD nelli kanen diyn ennen ibeεDhum: «imette elxsareθe nerriyHeθ? <verse eid="MRK 14:4" /><verse number="5" style="v" sid="MRK 14:5" />eθkan deθemmezzenz s eθmaliyθ<note caller="+" style="f"><char style="fr" closed="false">14.5 </char><char style="ft" closed="false">dahen tmaliθ netteθ tlaθe myat diynar (enzi mr 6:37)</char></note>, emferqen f iqelliylen!» ebδen εerxen g temeTTuwθ. <verse eid="MRK 14:5" /><verse number="6" style="v" sid="MRK 14:6" />yemenni yen yesuwε: «edjemt, imette itqelqem δiys? θahen δelmziyyeθ tegeyiyttiyδ. <verse eid="MRK 14:6" /><verse number="7" style="v" sid="MRK 14:7" />iqelliylen iyδwem kul yuwm ulemmi iθexsem eθgeddem eθeθsedqem fellasen. emme neč muc diyme iyδwem. <verse eid="MRK 14:7" /><verse number="8" style="v" sid="MRK 14:8" />w temeTTuwθe tege elli eθged etteg, teδhen erriyHeθ felle bac e mHeĎre ywerδem. <verse eid="MRK 14:8" /><verse number="9" style="v" sid="MRK 14:9" />exennenne elHeq: meni eθembeccer elbcareθ g eddunyeθ elkulhe, δeHkan s elli θegi bac e tmettiwc.»<verse eid="MRK 14:9" /></para>
  <para style="s">elxiyaneθ nyehuwδa</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10" />welbeεδ yexDem yehuwδa esxeryuwTiy, iyjen seg etlamδe leθnac, yimeqqaren nelkuhhan bac e senyezzenz yesuwε. <verse eid="MRK 14:10" /><verse number="11" style="v" sid="MRK 14:11" />eferHen max i sliyn edwiys, uεδent s lefluws. yeqqiym yetxemmem lemmi δeθyezzenz.<verse eid="MRK 14:11" /></para>
  <para style="s">emensi nelfeSH detlamδe</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12" />as emezwar g elεiyδ ntifĎiyrin, uδiys γer-sen iεellec yelfeSH, encδent etlemδas: «elmeniy iθexseδ enexDem bac e xenHeDDer emensi nelfeSH bac e ttečeδ?» <verse eid="MRK 14:12" /><verse number="13" style="v" sid="MRK 14:13" />yezen sen seg etlemδas yennasen: «berreθ taδfem ytemuwreθ, δexenyeεreD eryaz yqam teqliylt nwamen, eθebεemt. <verse eid="MRK 14:13" /><verse number="14" style="v" sid="MRK 14:14" />umeni eyaδef enneθ yiθbab nelHuwc: imuεellem yeqqar, &lt;mani tezeqqaw elli δeče δiys emensi nelfeSH neč detlemδaw?&gt; <verse eid="MRK 14:14" /><verse number="15" style="v" sid="MRK 14:15" />δexenyesxen δenni elHuwc tezeqqe tuseε wettimHeDDerθ, HeDDermane diyn kul cey.» <verse eid="MRK 14:15" /><verse number="16" style="v" sid="MRK 14:16" />efγen sennadiyn netlamδe eδfen θemuwreθ, afen kul cey emmax i senyenne, HeDren emensi nelfeSH.<verse eid="MRK 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17" />g tisemsiyn, yuseδ nette detlemδas leθnac. <verse eid="MRK 14:17" /><verse number="18" style="v" sid="MRK 14:18" />max i bδen tetten g umensi, yenneyasen yesuwε: «exennenne elHeq: iyjen essiywem δeyezzenz, unette iθet iyδi.» <verse eid="MRK 14:18" /><verse number="19" style="v" sid="MRK 14:19" />eHznen etlamδe ebδen necδen δiys iyjen s iyjen: «enneč?» <verse eid="MRK 14:19" /><verse number="20" style="v" sid="MRK 14:20" />yennasen: «nette δiyjen seg eθnac, unette yetneqqeε iyδi g iyjen neSHen. <verse eid="MRK 14:20" /><verse number="21" style="v" sid="MRK 14:21" />ubnaδem δeyjaf emmax i yemmari felles g elxθabaθ imqedsen, emme yeHliyle elli δeyezzenz bnaδem! lukan elyemmeruwc xiyr.»<note caller="+" style="f"><char style="fr" closed="false">14.21 </char><char style="ft" closed="false">enzi mr 9:12</char></note><verse eid="MRK 14:21" /></para>
  <para style="s">emensi n erreb</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22" />unihnin tetten yiwi eγrum ibarex δiys ikesserθ yezlesent yen: «ewyeθ, tay elbeδniyw.» <verse eid="MRK 14:22" /><verse number="23" style="v" sid="MRK 14:23" />yawi elkas necrab yecxer yezlasen, eswen essis elkul, <verse eid="MRK 14:23" /><verse number="24" style="v" sid="MRK 14:24" />yennasen: «tay iδemniyw, iδammen nelεaheδ<note caller="+" style="f"><char style="fr" closed="false">14.24 </char><char style="ft" closed="false">elεaheδ nette emelmiθaq nesselm, muhem egget uδiys lecruwδ dweεeδ. elεaheδ eqδiym yetmage s iδammen nelhayceθ. yesuwε yenne s iδemnes eyemmeg elεaheδ ejδiyδ elli yegi rebbi dleεbaδ. (enzi ruw 6:10, εb 7:27; 9:12; 10:1-10, 1 bT 3:18)</char></note> elli δeyemwezzeε f elxaĎer nleεbaδ egget. <verse eid="MRK 14:24" /><verse number="25" style="v" sid="MRK 14:25" />δexennenne elHeq: seg asse elsessac elεeSiyr nelεneb, elδeyeddes as eθeswe δiys δejδiyδ g elmelx nrebbi.»<verse eid="MRK 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26" />usiyn sebHen efγen yeddehreθ nuzemmuwr.<verse eid="MRK 14:26" /></para>
  <para style="s">yesuwε eyeθnebbe s wenker nbuTrus</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27" />yennasen yesuwε: «δeyθedjem elkul, εlexaTer elxθab yeqqar: &lt;δewθe eniylti eruwlen iεellec.&gt; <verse eid="MRK 14:27" /><verse number="28" style="v" sid="MRK 14:28" />emme beεεeδ ekkeriyw δexennesbqe yeljliyl.» <verse eid="MRK 14:28" /><verse number="29" style="v" sid="MRK 14:29" />yennes buTrus: «lukan exedjen elkul, neč exettedjixc!» <verse eid="MRK 14:29" /><verse number="30" style="v" sid="MRK 14:30" />yer felles yesuwε: «exenne elHeq, δeggiyδe, qebl eyedden eyaziδ merθiyn, δeyθenkreδ tlaθe merraθ.» <verse eid="MRK 14:30" /><verse number="31" style="v" sid="MRK 14:31" />yeTTef buTrus eSHiyH yen: «exnekrac Hette lukan δejafe iyδex!» usahen ennen etlamδe elkul.<verse eid="MRK 14:31" /></para>
  <para style="s">yesuwε yetzalle g jetsiymaniy</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32" />exeDmen ywemxan ellesmes jetsiymaniy, yen yetlemδas: «eqqiymeθ dahen, elmezzalle.» <verse eid="MRK 14:32" /><verse number="33" style="v" sid="MRK 14:33" />yawi iyδes buTrus dyeεquwb dyuwHenna, yebδe yetHus s elxuwf umuc merθaH. <verse eid="MRK 14:33" /><verse number="34" style="v" sid="MRK 14:34" />yennasen: «neč Hziyn εuddi jafe. rajeθ dahen teshrem!» <verse eid="MRK 14:34" /><verse number="35" style="v" sid="MRK 14:35" />yebεeδ qiqqi yeggez f elqeεεeθ yetzalle bac e θeθεedde essaεeθ nelwjiyεeθ, kan iged. <verse eid="MRK 14:35" /><verse number="36" style="v" sid="MRK 14:36" />yen: «ibba, dadde! cex eθgeddeδ eθegeδ kul cey, beεεeδ felle elkase, muc emmax i xse neč emme emmax i θexseδ cex.» <verse eid="MRK 14:36" /><verse number="37" style="v" sid="MRK 14:37" />yeδwel yafin enεesen, yennes ybuTrus: «endre tenεeseδ esemεan? eltgeddec eθeshreδ essaεeθ icθ? <verse eid="MRK 14:37" /><verse number="38" style="v" sid="MRK 14:38" />esehreθ tezzallem, bac e ltHeslemc g ujerreb, erruwH texs yemenni elbδen Dεiyf.» <verse eid="MRK 14:38" /><verse number="39" style="v" sid="MRK 14:39" />yebεeδ tikkelt xlaf yezzal, iεaweδ edwi biyδe. <verse eid="MRK 14:39" /><verse number="40" style="v" sid="MRK 14:40" />yeδwel xlaf yafin enεesen, εlexaTer enuddem yeγlebθen, wellessinenc δmette δesennen. <verse eid="MRK 14:40" /><verse number="41" style="v" sid="MRK 14:41" />yeδwel tikkelt teθθalet yennasen: «eltuciym tenεesem umerθeHiyn? yezzi! yuseδ elweqθ. tay bnaδem δeyemmuwc yifassen nelli γleĎen. <verse eid="MRK 14:41" /><verse number="42" style="v" sid="MRK 14:42" />ekreθ bac e nexDem! elli δeyyezzenz yeqreb.»<verse eid="MRK 14:42" /></para>
  <para style="s">aTTef nyesuwε</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43" />unette elyuwc iδukke yeweD yehuwδa, iyjen seg eθnacdiyn, wiyδes eljmaεeθ qamen lesyuwf etγeryiyn, uznenten imeqqaren nelkuhhan dimuεelmen necceriyεeθ diwessaren. <verse eid="MRK 14:43" /><verse number="44" style="v" sid="MRK 14:44" />w ykan elli yezzenzi yuceyasen elεlameθ yennasen: «elli δeθkubbe eyendeγ nette, eTfemt tewyemt eθεussem felles belgde.» <verse eid="MRK 14:44" /><verse number="45" style="v" sid="MRK 14:45" />max i yiweD yehuwδa, yeqreb yyesuwε yennes: «ya siydiy!» ikubbi. <verse eid="MRK 14:45" /><verse number="46" style="v" sid="MRK 14:46" />ezlen ifesnensen felles eTfent. <verse eid="MRK 14:46" /><verse number="47" style="v" sid="MRK 14:47" />yemenni yenzeγ iyjen seg elli diyn essifes yewweθ exeddam numeqqar nelkuhhan iquSSes θemedjiθes. <verse eid="MRK 14:47" /><verse number="48" style="v" sid="MRK 14:48" />yennasen yesuwε: «endre f uxennab teffeγem s lesyuwf etγeryiyn bac e yθewyem? <verse eid="MRK 14:48" /><verse number="49" style="v" sid="MRK 14:49" />kane kul yuwm iyδwem esseqrγ g elheykel weyθeTTifemc, emme wahen ySar bac e kemlen elxθabaθ imqedsen.» <verse eid="MRK 14:49" /><verse number="50" style="v" sid="MRK 14:50" />edjent elkul erwlen.<verse eid="MRK 14:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51" />yeθbeεθ eεezri iHuT f imenes kan δejjebbeθ, eTfent. <verse eid="MRK 14:51" /><verse number="52" style="v" sid="MRK 14:52" />yemenni yedj ejjebθes yerwel δ eεeryan.<verse eid="MRK 14:52" /></para>
  <para style="s">yesuwε g elmejles nelyehuwd</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53" />ewyen yesuwε yumeqqar nelkuhhan, emlaymen imeqqaren nelkuhhan elkul diwessaren dimuεelmen necceriyεeθ elkul. <verse eid="MRK 14:53" /><verse number="54" style="v" sid="MRK 14:54" />yeθbeεθ buTrus seg lebεiyδ ywemmes nelHuwc numeqqar nelkuhhan, yaδef yeqqiym diεessasen yetteddeffe f elεafyeθ. <verse eid="MRK 14:54" /><verse number="55" style="v" sid="MRK 14:55" />ukanen imeqqaren nelkuhhan diyh nelmejles<note caller="+" style="f"><char style="fr" closed="false">14.55 </char><char style="ft" closed="false">elmejles ettemsemme Senhedriyn nette elmejles nelquyyaδ elli Hekmen iyehuwdiyyen.</char></note> elkul etHewmen g echaδeθ f yesuwε bac e θenγen yemenni wellufiync, <verse eid="MRK 14:55" /><verse number="56" style="v" sid="MRK 14:56" />εlexaTer leεbaδ egget cheδen f elles s ezzuwr, yaδef edwiynsen g beεDe. <verse eid="MRK 14:56" /><verse number="57" style="v" sid="MRK 14:57" />ekkeren eljmaεeθ essisen echδen felles s ezzuwr, ennen: <verse eid="MRK 14:57" /><verse number="58" style="v" sid="MRK 14:58" />«nečin nesli yeqqar, &lt;δessendre elheykele elli yemmebne s ifassen, ebniyγ g etlaθe eyyam elheykel elyetmebniyc s ifassen.&gt;» <verse eid="MRK 14:58" /><verse number="59" style="v" sid="MRK 14:59" />udahen zade yuwδef edwiynsen g beεDe. <verse eid="MRK 14:59" /><verse number="60" style="v" sid="MRK 14:60" />yekker emeqqar nelkuhhan uggemmes nelmejles yenceδ yesuwε: «elγrexc mette δeθerreδ fellasen? δmette wahen elli cehδen essis fellex?» <verse eid="MRK 14:60" /><verse number="61" style="v" sid="MRK 14:61" />yemenni yeqqiym yesger, elyeqqar Hette cey. yenceδt emeqqar nelkuhhan tikkelt xlaf: «δcex elmesiyH memmis nrebbi emebruwx?» <verse eid="MRK 14:61" /><verse number="62" style="v" sid="MRK 14:62" />yer felles yesuwε: «enneč nette. uδeθezrem bnaδem yeqqiym f elymiyn nrebbi elqader, uyuseδ s esHab nesme!» <verse eid="MRK 14:62" /><verse number="63" style="v" sid="MRK 14:63" />icerxes emeqqar nelkuhhan edbeces yennes: «meεεač elHajeθenne s eccuhhaδ? <verse eid="MRK 14:63" /><verse number="64" style="v" sid="MRK 14:64" />tesliym ywekferes, δmette iθenniym?» eHkmen felles elkulhum elli yettesθahel ejafi. <verse eid="MRK 14:64" /><verse number="65" style="v" sid="MRK 14:65" />ebδen eljmaεeθ essisen eskufasen felles, uraDnes g uδmes wettewθen δiys s lexfuwf unihnin eqqarnes: «essuwli δwiyn.» Hette δiεessasen kanen ettewθen δiys.<verse eid="MRK 14:65" /></para>
  <para style="s">buTrus eyenker yesuwε</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66" />max i ykan buTrus g elHuwc elweddey, teθεedde texeddamt seg etxeddamin numeqqar nelkuhhan s ezzeθes. <verse eid="MRK 14:66" /><verse number="67" style="v" sid="MRK 14:67" />max i θezre buTrus yetteddeffe, terqebθ tennes: «cex zade tkaneδ dyesuwε ennaSriy!» <verse eid="MRK 14:67" /><verse number="68" style="v" sid="MRK 14:68" />yemenni yenker, yen: «ellessinac wellefhimac δmette iθeqqareδ!» yeffeγ ytesqifθ, yedden eyaziδ.<note caller="+" style="f"><char style="fr" closed="false">14.68 </char><char style="ft" closed="false">enzi mr 14:30</char></note> <verse eid="MRK 14:68" /><verse number="69" style="v" sid="MRK 14:69" />tezri texeddamt, tebδe teqqar yelli diyn elmerreθ xlaf: «wahen essisen!» <verse eid="MRK 14:69" /><verse number="70" style="v" sid="MRK 14:70" />yenker xlaf. beεεeδ qiqqi, ennen elli diyn ybuTrus elmerreθ xlaf: «lazem cex essisen, εlexaTer cex seg eljliyl.» <verse eid="MRK 14:70" /><verse number="71" style="v" sid="MRK 14:71" />yebδe yetsubb uyetteθjul: «neč ellessinac eryaze elli tHekkem felles.» <verse eid="MRK 14:71" /><verse number="72" style="v" sid="MRK 14:72" />g elweqθes yedden eyaziδ tikkelt xlaf, yesfekker buTrus edwi nyesuwε: «qebl eyedden eyaziδ merθiyn, eyθenkreδ tlaθe merraθ.» yebδe yetεeyyeĎ.<verse eid="MRK 14:72" /></para>
  <chapter eid="MRK 14" />
  <chapter number="15" style="c" sid="MRK 15" />
  <para style="s">yesuwε γer biylaTus</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1" />max i θuwli talji eθcawren imeqqaren nelkuhhan diwessaren dimuεelmen necceriyεeθ delquyyaδ nelmejles elkul, usiyn eqqenen yesuwε ewyent uwcent ibiylaTus<note caller="+" style="f"><char style="fr" closed="false">15.1 </char><char style="ft" closed="false">ellembraTuwr nerruwman yεeyyen biylaTus δelHakem f yehuwdiyye. erruwman uciyn yiyehuwdiyyen elHurriyyeθ ettemeqqarθ bac e Hekmen imenensen. yemenni esennuciync elHeq bac e nγen la δiyjen. heδake εlac elquyyaδ niyehuwdiyyen yelzem eδafen ettuhmeθ eqenεen essis biylaTus elli yesuwε yelzem eyemmenγ.</char></note>. <verse eid="MRK 15:1" /><verse number="2" style="v" sid="MRK 15:2" />yenceδt biylaTus: «endre δcex elmlek n uδayen?» yer felles: «δcex tenniyδ.» <verse eid="MRK 15:2" /><verse number="3" style="v" sid="MRK 15:3" />etehment imeqqaren nelkuhhan ettehmaθ egget. <verse eid="MRK 15:3" /><verse number="4" style="v" sid="MRK 15:4" />yenceδt biylaTus tikkelt xlaf: «elγrexc s mette δeθerreδ? esl menyeθ δettehmaθ!» <verse eid="MRK 15:4" /><verse number="5" style="v" sid="MRK 15:5" />yemenni yesuwε elyerriyc, heδake εlac yesθeγreb biylaTus.<verse eid="MRK 15:5" /></para>
  <para style="s">eHkam f yesuwε s temettent</para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6" />w ykan biylaTus g kul elεiyδ eyseyyeb iyjen seg imeHbas eθexθaren leεbaδ. <verse eid="MRK 15:6" /><verse number="7" style="v" sid="MRK 15:7" />w ykan eryaz ellesmes barabas yemmeqqen nette deljmaεeθ δimeθmerδen, enγiyn leεbaδ g elweqθ nelfetneθ. <verse eid="MRK 15:7" /><verse number="8" style="v" sid="MRK 15:8" />mlaymen leεbaδ ebδen Ďelben seg biylaTus elli mesθensiyn ettawyen δiys, <verse eid="MRK 15:8" /><verse number="9" style="v" sid="MRK 15:9" />yennasen: «texsem exenseybe elmlek nuδayen?» <verse eid="MRK 15:9" /><verse number="10" style="v" sid="MRK 15:10" />εlexaTer yessen elli imeqqaren nelkuhhan selmen yesuwε elli nγaren essis. <verse eid="MRK 15:10" /><verse number="11" style="v" sid="MRK 15:11" />heyjen imeqqaren nelkuhhan leεbaδ bac e xθaren barabas. <verse eid="MRK 15:11" /><verse number="12" style="v" sid="MRK 15:12" />yennasen biylaTus tikkelt xlaf: «δmette δege ziyγ s elli etsemmem δiys elmlek nuδayen?» <verse eid="MRK 15:12" /><verse number="13" style="v" sid="MRK 15:13" />zeεwgen xlaf: «eSlebθ!» <verse eid="MRK 15:13" /><verse number="14" style="v" sid="MRK 15:14" />yennasen: «δmette eccer elli yegi?» yemenni ernin zeεwgen eSbiyH: «eSlebθ!» <verse eid="MRK 15:14" /><verse number="15" style="v" sid="MRK 15:15" />biylaTus ykan yexs eyreDDe leεbaδ elkul, iseyyeb barabas. yuwc yesuwε bac e θeSlben beεεeδ eθewθen.<verse eid="MRK 15:15" /></para>
  <para style="s">leHrus etteθfisaxen f yesuwε</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16" />ewyent iεeskriyyen eljaj nelHuwc elli δelqSer nelHakem laymen elεesker elkul. <verse eid="MRK 15:16" /><verse number="17" style="v" sid="MRK 15:17" />ireDnes ejjebbeθ ettezukkaγθ emelmlek, egnes ettaj s eccuwk HuTTent f ixfes, <verse eid="MRK 15:17" /><verse number="18" style="v" sid="MRK 15:18" />ebδen etHeyyen δiys: «esselam εliyk, elmlek nuδayen!» <verse eid="MRK 15:18" /><verse number="19" style="v" sid="MRK 15:19" />wettewθen δiys s teγriθ f ixfes weskufasen felles, usejjeδnes. <verse eid="MRK 15:19" /><verse number="20" style="v" sid="MRK 15:20" />ubeεεeδ iθfisxen felles, ekkesnes ejjebbeθ tezukkaγθ ireDnes edbeces efγen essis bac e θeSlben.<verse eid="MRK 15:20" /></para>
  <para style="s">yesuwε f eSliyb</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21" />ykan yelle eryaz jay seg ejimiys, ellesmes semεan eqerwiy, daddes niskender druwfus, ennanes bac e yqam eSliyb bessiyf. <verse eid="MRK 15:21" /><verse number="22" style="v" sid="MRK 15:22" />eγδen yesuwε ywemxan ellesmes juljuθθe, meεnahe emxan neljumjmeθ, <verse eid="MRK 15:22" /><verse number="23" style="v" sid="MRK 15:23" />ucnes ecrab yemsesr s laδen yaxi elyeqqiylc eθyesw. <verse eid="MRK 15:23" /><verse number="24" style="v" sid="MRK 15:24" />usiyn mesmernas ifesnes dikreεn-es f eSliyb, zuwnen edbeces mabinathum s uqerreε. <verse eid="MRK 15:24" /><verse number="25" style="v" sid="MRK 15:25" />max i θeSelben eθkan δettesεe ntalji. <verse eid="MRK 15:25" /><verse number="26" style="v" sid="MRK 15:26" />eryen f elluwHeθ nelHukmes: «elmlek nuδayen.» <verse eid="MRK 15:26" /><verse number="27" style="v" sid="MRK 15:27" />eSlben iyδes sen δixennaben, iyjen f elymines wiyjen f eliseres. <verse eid="MRK 15:27" /><verse number="28" style="v" sid="MRK 15:28" />[usah yekmel edwi nelxθab: «eHsbent seg imujrmen.»]<note caller="+" style="f"><char style="fr" closed="false">15.28 </char><char style="ft" closed="false">enzi luw 22:37; ic 53:12</char></note> <verse eid="MRK 15:28" /><verse number="29" style="v" sid="MRK 15:29" />ukanen elli etteθεeddan esyiyn etδewHen ixfewnensen subbent ennen: «yelli δeθessendreδ elheykel uδettebniyδ g etlaθe eyyam, <verse eid="MRK 15:29" /><verse number="30" style="v" sid="MRK 15:30" />fuk imenex tegzeδ seg eSliyb!» <verse eid="MRK 15:30" /><verse number="31" style="v" sid="MRK 15:31" />Hette δimeqqaren nelkuhhan dimuεelmen necceriyεeθ kanen etteθfisaxen felles, weqqaren ibeεDhum: «ifuk elγires yemenni eligeddec eyfuk imenes! <verse eid="MRK 15:31" /><verse number="32" style="v" sid="MRK 15:32" />edj eyeggez ture elmesiyH elmlek nisraYiyl seg eSliyb, bac e nzer nemmen!» ukanen ixennaben elli emmeSlben iyδes etεezren δiys Hette ennihnin.<verse eid="MRK 15:32" /></para>
  <para style="s">temettent nyesuwε</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33" />seg wezyen nwas, tessulles eddunyeθ elkulhe elmaDi tlaθe. <verse eid="MRK 15:33" /><verse number="34" style="v" sid="MRK 15:34" />egmaDi tlaθe izeεweg yesuwε: «ilwiy, ilwiy, lema cebeqteniy?» meεnahe: «ya rebbi, ya rebbi, imette iyθedjiδ?» <verse eid="MRK 15:34" /><verse number="35" style="v" sid="MRK 15:35" />ennen lebHaD nelli kanen bedden diyn, max i sliyn wediyn: «tayeθ yetnabe g iliyya!» <verse eid="MRK 15:35" /><verse number="36" style="v" sid="MRK 15:36" />yezzel iyjen essisen yeTTef θeneccafθ yneffext g elxel yegiθ g teγriyθ yezlest bac balek eyeqqel eysu unette yeqqar: «rajeθ bac e nerqeb δeyeddes iliyya bac e θyessuggez ziyγ la.» <verse eid="MRK 15:36" /><verse number="37" style="v" sid="MRK 15:37" />izeεweg yesuwε etzeεwiygeθ siyn teqwe yjaf. <verse eid="MRK 15:37" /><verse number="38" style="v" sid="MRK 15:38" />yemcuq ecεer nelheykel<note caller="+" style="f"><char style="fr" closed="false">15.38 </char><char style="ft" closed="false">ecεer wah izuwn emxan imqeddes f wemxan elli δimqeddes egget g elheykel. kan δelkahen emeqqar γer-s elHeq eyaδef ywemxan elli δimqeddes egget. ecuqqi necεer yeεni elli meεεač yelle mat eyHuz jar rebbi dleεbaδ. elli ettemnen elkul egedden ture eqerben yrebbi. (enzi εb 6:19-20; 9:1-15; 10:19-22)</char></note> f sen, s lennej yelweddey. <verse eid="MRK 15:38" /><verse number="39" style="v" sid="MRK 15:39" />w ykan elqayeδ nelHers ibed δimqabel eSliyb, max i yezre max i yjaf yesuwε, yenne: «mbelHeq, eryaze ykan δmemmis nrebbi.»<verse eid="MRK 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40" />ukanneθ ellaneθ elwacun etteθferrajneθ seg lebεiyδ, essisneθ meryem θemejdeliyθ dmeryem yemmes nyeεquwb emezyen dyuwsi dsaluwme, <verse eid="MRK 15:40" /><verse number="41" style="v" sid="MRK 15:41" />wennihenti elli eθbeεneθ yesuwε wexδemnet max i ykan g eljliyl, wegget elwacun xlaf uliyneθ iyδes yuwrceliym.<verse eid="MRK 15:41" /></para>
  <para style="s">erδem nyesuwε</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42" />max i yeqreb δeggiyδ, umax i ykan δas nuHeDDer, as elli qebl nessebθ. <verse eid="MRK 15:42" /><verse number="43" style="v" sid="MRK 15:43" />yuseδ yuwsef elli seg ramiy, w ykan δimqedder g elmejles, useg elli etrajen g elmemlxeθ nrebbi, yeθcejjeε yaδef f biylaTus yeĎleb ejjeθθeθ nyesuwε. <verse eid="MRK 15:43" /><verse number="44" style="v" sid="MRK 15:44" />yesθeγreb biylaTus seg ejefis fiyseε. inabe elqayeδ nelHers yenceδt: «endre yjaf seg bekri?» <verse eid="MRK 15:44" /><verse number="45" style="v" sid="MRK 15:45" />max i yesle elxber seg elqayeδ nelHers, yedje yuwsef eyawi ejjeθθeθ nyesuwε. <verse eid="MRK 15:45" /><verse number="46" style="v" sid="MRK 15:46" />yeseγ elkfen, usiyn yessuggez ejjeθθeθ f eSSliyb ikeffent iHuTTi uggunil elli yemmeHfer g elHegfeθ, igergeb tγaγet f iymi nwenil. <verse eid="MRK 15:46" /><verse number="47" style="v" sid="MRK 15:47" />ezerneθ meryem θemejdeliyθ dmeryem yemmes nyuwsi meni iθiyHuT.<verse eid="MRK 15:47" /></para>
  <chapter eid="MRK 15" />
  <chapter number="16" style="c" sid="MRK 16" />
  <para style="s">ekker nyesuwε</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1" />max i yeθεedde essebθ, tesγe meryem θemejdeliyθ dmeryem yemmes nyeεquwb dsaluwme elffeHaθ bac e θenγelneθ f yesuwε. <verse eid="MRK 16:1" /><verse number="2" style="v" sid="MRK 16:2" />g talji nwas iglewwel nelimeθ, max i θeqqeS tefuwθ, exDemneθ ywenil. <verse eid="MRK 16:2" /><verse number="3" style="v" sid="MRK 16:3" />ukanneθ eqqarneθ ibeεDhum: «δ wiyn δexenygergeb tγaγet seg iymi nwenil?» <verse eid="MRK 16:3" /><verse number="4" style="v" sid="MRK 16:4" />max i Tulneθ ufiyneθ tγaγet temgergeb, weθkan ettemeqqarθ egget. <verse eid="MRK 16:4" /><verse number="5" style="v" sid="MRK 16:5" />eδefneθ enil, ezrneθ eεezri ygeεmez f elymiyn, felles edbac δimellalen, emmerεbneθ. <verse eid="MRK 16:5" /><verse number="6" style="v" sid="MRK 16:6" />yennasneθ: «etemmerεebmec! xemmiyθi eddellebmeθ g yesuwε ennaSri emeSluwb. leHebbac dahen, yekker. weδwahen emxan elli HuTTent δiys. <verse eid="MRK 16:6" /><verse number="7" style="v" sid="MRK 16:7" />berremeθ tenmeθ yetlemδas dbuTrus: rahu yesbqawem yeljliyl, udiyn δettezrem emmax i xenyenne.» <verse eid="MRK 16:7" /><verse number="8" style="v" sid="MRK 16:8" />erwelneθ seg enil merεubaθ. wellenniyneθ yHette Hed εlexaTer kanneθ xeyfaθ.<note caller="+" style="f"><char style="fr" closed="false">16.8 </char><char style="ft" closed="false">gimexTaT iqδiymen yuqe dah g ellayeθ 8. ulebHaD xlaf yuqe g ellayeθ elli s eddwes.</char></note><verse eid="MRK 16:8" /></para>
  <para style="s">yesuwε eyeffeγ ymeryem θemejdeliyθ</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9" />[max i yekker yesuwε g talji nwas iglewwel nelimeθ, g umezwar yeffeγ ymeryem θemejdeliyθ elli ysuwfeγ essis sebεe δecyaĎen. <verse eid="MRK 16:9" /><verse number="10" style="v" sid="MRK 16:10" />texDem tennasen yetlemδas, ukanen etnewHen wetεeyĎen, <verse eid="MRK 16:10" /><verse number="11" style="v" sid="MRK 16:11" />wetSedqenc max i sliyn elli nette yedder uθezri.<verse eid="MRK 16:11" /></para>
  <para style="s">yesuwε eyeffeγ ysen δetlamδe</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12" />ubeεεeδ yeffeγ yesuwε g elheyyeθ xlaf ysen seg etlemδas unihnin uggebriδ yijiyman. <verse eid="MRK 16:12" /><verse number="13" style="v" sid="MRK 16:13" />eδwlen ennen yiddiynni, yemenni enSedqenc.<verse eid="MRK 16:13" /></para>
  <para style="s">yesuwε eyeffeγ yimersal leHdac</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14" />g ellexxer yeffeγ yetlemδas leHdac, unihnin tetten, yeεrexθen felqelleθ nelimenensen etteqsuwHi nulewnensen, εlexaTer elSedqenc elli zrint beεεeδ iyekker. <verse eid="MRK 16:14" /><verse number="15" style="v" sid="MRK 16:15" />yennasen: «berreθ yeddunyeθ elkul, tbecrem elbcareθ yleεbaδ elkul. <verse eid="MRK 16:15" /><verse number="16" style="v" sid="MRK 16:16" />elli eyemmen yeθεemmeδ δeyemneε, yemenni elli elyettemmenc δeyehlex. <verse eid="MRK 16:16" /><verse number="17" style="v" sid="MRK 16:17" />welli amnen, ellayeθe δeθeqqiym iyδsen diyme: δegelben ecyaĎen s ellesmiyw, uθlayen elleγwaθ ettejδiyt, <verse eid="MRK 16:17" /><verse number="18" style="v" sid="MRK 16:18" />eTfen s ifesnensen tilefsiywin. umax eswen essem esenijerri Hette cey, umax eHuTTen ifesnensen f imuwDan enneSSebran.»<verse eid="MRK 16:18" /></para>
  <para style="s">elay nyesuwε yesma</para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19" />beεδ iyuθley erreb yesuwε yetlemδas, yemsuwli yesme ygeεmez f elymiyn nrebbi. <verse eid="MRK 16:19" /><verse number="20" style="v" sid="MRK 16:20" />wetlamδe xDemen etbecren g kul blaSe, urebbi yetεawen δiysen uyetSeddeq g edwiynsen s ellayeθes elli etSarneθ.]<verse eid="MRK 16:20" /></para>
  <chapter eid="MRK 16" />
</usx>