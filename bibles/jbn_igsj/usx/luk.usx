<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="LUK" style="id" />
  <para style="h">Luke</para>
  <para style="toc1">kitabu luwqa</para>
  <para style="toc2">Luka</para>
  <para style="toc3">LUK</para>
  <para style="mt1">kitabu luwqa</para>
  <chapter number="1" style="c" sid="LUK 1" />
  <para style="s">elγayeθ seg θiyre n elxθabe</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 1:1" />max i resmen egget δleεbaδ θaryen g elHkayeθ elli ySar γenne welli neslit seg leεbaδ imezwaren <verse eid="LUK 1:1" /><verse number="2" style="v" sid="LUK 1:2" />welli kanen taryen δiys wesseqran δiys yelγirensen. <verse eid="LUK 1:2" /><verse number="3" style="v" sid="LUK 1:3" />elweqθes enwiyγ δexetterye ha siydiy θawfiylus, s elli tersem elmi tuqe <verse eid="LUK 1:3" /><verse number="4" style="v" sid="LUK 1:4" />bac e θesneδ elHkayeθ tuSHiyHθ seg telγaleT.<verse eid="LUK 1:4" /></para>
  <para style="s">elbcareθ s warew nyuwHenna</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 1:5" />ykan yelle g elweqθ nhiyruwdus eSSulTan nyehuwdiyye elkahen esmiθes zekeriyya. nette ykan s elεerc nlenbye uliweces tkan s ezzerriyεeθ nharuwn, wesmiθes iliyzabat. <verse eid="LUK 1:5" /><verse number="6" style="v" sid="LUK 1:6" />kanen lessenniyn essenen rebbi uθebεen g tufleyθes wegguwren kan s edwiys. <verse eid="LUK 1:6" /><verse number="7" style="v" sid="LUK 1:7" />yemenni kanen elγersenc idrari lexaTer iliyzabat eθkan δtelεagerθ ulessenniyn kanen δimeqqaren g elεmer.<verse eid="LUK 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 1:8" />max i dyuwse edduwr nzekeriyya δeyexδem δelkahen ezzaθ nrebbi, <verse eid="LUK 1:8" /><verse number="9" style="v" sid="LUK 1:9" />tekker felles elqurεeθ elli eginteθ elkuhhan bac e yaδef yelHuwc nelqudus usinc eyceεεel elbxuwr. <verse eid="LUK 1:9" /><verse number="10" style="v" sid="LUK 1:10" />elweqθ nuceεεel nelbxuwr kanen leεbaδ elkul etzellen elberre. <verse eid="LUK 1:10" /><verse number="11" style="v" sid="LUK 1:11" />elweqθes yeffeγes iyjen s elmleyxaθ nrebbi ibed f elymiyn nelxanuwn emeqqar meni itHuTTen g elbxuwr. <verse eid="LUK 1:11" /><verse number="12" style="v" sid="LUK 1:12" />max i θyezre zekeriyya yukkeδ yeδwel elyessiync δmat δayeg. <verse eid="LUK 1:12" /><verse number="13" style="v" sid="LUK 1:13" />yemenni elmlaxdiyn yennayes: «eθukδc ha zekeriyya, rahu rebbi yesle edεax uliwecex iliyzabat δexθaru engluws δetsemmiyδ yuwHenna.<verse eid="LUK 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 1:14" />uδeθefrHeδ essis egget cex dleεbaδ iddiyn seg esserwes. <verse eid="LUK 1:14" /><verse number="15" style="v" sid="LUK 1:15" />uδeyekber g TiTTawin nrebbi uleεemre δeysu ecrab, uselli g teδisθ nyemmes δesyuc rebbi seg erruHes. <verse eid="LUK 1:15" /><verse number="16" style="v" sid="LUK 1:16" />uδayer egget δebni israYiyl ywebriδ nrebbi. <verse eid="LUK 1:16" /><verse number="17" style="v" sid="LUK 1:17" />usinc edyes qebl memmis nrebbi, unette g erruHes delqewθes emenbi iliyya bac leεbaδ exsen idreriynsen usinc edren iyδsen δimeθfahmen usinc ayer elfussaδ y webriδ uSHiyH, usinc eyenzeγ leεbaδ y edwi n rebbi.»<verse eid="LUK 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 1:18" />yenceδ zekeriyya elmlax yennayes: «max δeyeδwel wahen belHeq uneč δeryaz δemeqqar uliweciyw δtewessarθ.» <verse eid="LUK 1:18" /><verse number="19" style="v" sid="LUK 1:19" />yerrayes elmlax yenne: «neč δjebriyl etbedde ezzaθ nrebbi. nette yuzeniyδ bac e xuflaye usinc exsefrHe.» <verse eid="LUK 1:19" /><verse number="20" style="v" sid="LUK 1:20" />utaye δeθeδewleδ δebekkuwc wetgeddec eθufleyeδ elmeyeδwel wahen elkul belHeq lexaTer cexdiyn eltSedqec edwiyw uwahen elkul δeySar g elweqθes. <verse eid="LUK 1:20" /><verse number="21" style="v" sid="LUK 1:21" />elweqtdiyn wediyn kanen leεbaδ etrajen g zekeriyya unihnin mesθeγrbiyn lexaTer nette iεeTTel g elHuwc nelqudus. <verse eid="LUK 1:21" /><verse number="22" style="v" sid="LUK 1:22" />yemenni max i yeffeγ ligeddec esenyufley, elweqθes efhemen elli nette enzi δmat iyezre g wemmes nelHuwc nelqudus yersem ywemmeyasen s ifesnes, yeqqiym siyn δebekkuwc. <verse eid="LUK 1:22" /><verse number="23" style="v" sid="LUK 1:23" />max i yεedde eddures nelxeδmeθ g elHuwc nelqudus yeδwel yelHuces yrewweH.<verse eid="LUK 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 1:24" />beεδ liyyameθ tiwi iliyzabat liweces are yemenni eltenni yHette Hed felles xemse chuwr. eθkan teqqar: <verse eid="LUK 1:24" /><verse number="25" style="v" sid="LUK 1:25" />«rahu rebbi iqami ixfiyw ezzaθ nleεbaδ max i yesfekker.»<verse eid="LUK 1:25" /></para>
  <para style="s">elbcareθ s warew nyesuwε</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 1:26" />g weyyures essades yuzen rebbi elmlax jibraYiyl ytemuwreθ g eljliyl esmiθes ennaSreh, <verse eid="LUK 1:26" /><verse number="27" style="v" sid="LUK 1:27" />yicθ esmiθes meryem, eltuwc δteqeyyerθ yemenni temmexĎeb yweryaz esmiθes yuwsef s ezzerriyεeθ ndawud. <verse eid="LUK 1:27" /><verse number="28" style="v" sid="LUK 1:28" />yuwδef felles elmlax yennes: «eslam fellem, efreH rebbi yexθarem cem, rebbi ibarxem cem unette rahu iyδem.» <verse eid="LUK 1:28" /><verse number="29" style="v" sid="LUK 1:29" />tekkuδ s edwi nelmlax tufley g ules: «δmat edwiye wahen!» <verse eid="LUK 1:29" /><verse number="30" style="v" sid="LUK 1:30" />yennayes elmlax: «eθukδc ha meryem, rahu rebbi yexsem egget. <verse eid="LUK 1:30" /><verse number="31" style="v" sid="LUK 1:31" />utaye δeθeδewleδ δtemeεδurθ usinc eθarweδ engluws etsemmiyδ yesuwε. <verse eid="LUK 1:31" /><verse number="32" style="v" sid="LUK 1:32" />uδayef elqδer δemeqqar g eddunyeθe uδeθsemman δmemmis nelεali uδesyuwc rebbi elmemlxeθ ndawud, babes emezwar. <verse eid="LUK 1:32" /><verse number="33" style="v" sid="LUK 1:33" />weHebbac δ wiyn δeyeδwel δelmlek f elHuwc nyeεquwb usinc δeyHuT kul cey seddu efuses yellexxer neddunyeθ m nette.» <verse eid="LUK 1:33" /><verse number="34" style="v" sid="LUK 1:34" />tenne meryem yelmlaxdiyn: «max δeySar wahen? uneč welxalde Hette eryaz.» <verse eid="LUK 1:34" /><verse number="35" style="v" sid="LUK 1:35" />yerrayes elmlax yennes: «erruwH elqudus δeyemmazen δiym urebbi δemyuc elquwweθ. wengluwse eTTaher elli δetterweδ δeyemsemme memmis n rebbi. <verse eid="LUK 1:35" /><verse number="36" style="v" sid="LUK 1:36" />utaye teqribθem iliyzabat δeθawi are usinc δeθaru engluws unetteθ δtewessarθ. utediyn elli semmanteθ leεbaδ δtelεagerθ taye teδwel g weyyures essades. <verse eid="LUK 1:36" /><verse number="37" style="v" sid="LUK 1:37" />rahu weHebbe Hette cey yuεer f rebbi.» <verse eid="LUK 1:37" /><verse number="38" style="v" sid="LUK 1:38" />tenne meryem: «neč δtexeddamt nrebbi umeδebiyye edwiyx eyeδwel belHeq.» elweqθes yedjiyt elmlaxdiyn yemreq f imenes.<verse eid="LUK 1:38" /></para>
  <para style="s">meryem γer eliSabat</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 1:39" />g liyyametdiyn tekker meryem temreq fiyseε fiyseε yecciyreθ nedhari g webriδes ytemuwreθ nyehuwδa. <verse eid="LUK 1:39" /><verse number="40" style="v" sid="LUK 1:40" />tuδef yelHuwc nzekeriyya welbeεδ essellem f iliyzabat. <verse eid="LUK 1:40" /><verse number="41" style="v" sid="LUK 1:41" />max i θesle iliyzabat eslam nmeryem yeθHerrex memmis eSbiyH g wemmes nteδisθes. yerni yucayes rebbi s erruHes bac e θged eθufley. <verse eid="LUK 1:41" /><verse number="42" style="v" sid="LUK 1:42" />welbeεδ tenne s eSSuwθ yeεle: «ettimbarexθ cem g timeTTuwθin elkul, uδimbarex memmiym unette elyuwc g teδisθem. <verse eid="LUK 1:42" /><verse number="43" style="v" sid="LUK 1:43" />δ wiyn neč bac e yettes meryem yemmes nmemmis nrebbi! <verse eid="LUK 1:43" /><verse number="44" style="v" sid="LUK 1:44" />rahu eddebelli sliyγ eslemem, yeθHerrex memmi g teδisθiyw s elferHeθ. <verse eid="LUK 1:44" /><verse number="45" style="v" sid="LUK 1:45" />SeHHe liyk, lexaTer cem temmeneδ belHeq s edwi nrebbi uselmexθubem.»<verse eid="LUK 1:45" /></para>
  <para style="s">elγne nmeryem</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 1:46" />tenne meryem: «uliyw yetsebbeH yrebbi. <verse eid="LUK 1:46" /><verse number="47" style="v" sid="LUK 1:47" />werruHiyw tefreH seg rebbi elli imenεi seg jhennem. <verse eid="LUK 1:47" /><verse number="48" style="v" sid="LUK 1:48" />lexaTer nette yexθari, neč δtexeddemt nrebbi uyelliys ntemuwreθ. seg wasse yellexxer neddunyeθ δennen leεbaδ elkul elli rebbi ibarxi seg wemmes nelwacun elkul. <verse eid="LUK 1:48" /><verse number="49" style="v" sid="LUK 1:49" />ulexaTer rebbi yege iyδi elli weθyegi Hette iyjen. nette δelεaliy. <verse eid="LUK 1:49" /><verse number="50" style="v" sid="LUK 1:50" />werreHmtes diyme f leεbaδ elli tekkaδen essis. <verse eid="LUK 1:50" /><verse number="51" style="v" sid="LUK 1:51" />γers elquwweθ δtemeqqarθ, yeγleb essis imeθkebren. <verse eid="LUK 1:51" /><verse number="52" style="v" sid="LUK 1:52" />isuggez elHukkam imeθkebren elweddey wisuwli imeθwaDεen lennej. <verse eid="LUK 1:52" /><verse number="53" style="v" sid="LUK 1:53" />s elxires icecbeε leεbeδes uselqewθes yedje imurkentiyyen δiεeryanen. <verse eid="LUK 1:53" /><verse number="54" style="v" sid="LUK 1:54" />yεawen ezzerriyεeθ nyeεquwb bac e nesfekker erreHmtes, (yeεquwb eqqarnes zade israYiyl wellesme wahen yuceyasti rebbi.) <verse eid="LUK 1:54" /><verse number="55" style="v" sid="LUK 1:55" />max i yege yen ibrahiym dezzerriεθes yellexxer neddunyeθ.» <verse eid="LUK 1:55" /><verse number="56" style="v" sid="LUK 1:56" />teqqiym meryem γer iliyzabat eyeg siyn tlaθe chuwr welbeεδ trewweH yelHuces.<verse eid="LUK 1:56" /></para>
  <para style="s">arew nyuwHenna elmeεmdan</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 1:57" />max i yiweD elweqθ netserwas, tirew taγeδ engluws. <verse eid="LUK 1:57" /><verse number="58" style="v" sid="LUK 1:58" />elweqθelli sliyn eljirenes delleqerbes elli rebbi isuggez felles erreHmtes, efreHen iyδes. <verse eid="LUK 1:58" /><verse number="59" style="v" sid="LUK 1:59" />g was eθθamen usiynd δeDehren englusdiyn wetεilaken δeθsemmen zekeriyya f ellesm ndaddes. <verse eid="LUK 1:59" /><verse number="60" style="v" sid="LUK 1:60" />yemenni yemmes tenneyasen: «ehhe! δeθensemme yuwHenna.» <verse eid="LUK 1:60" /><verse number="61" style="v" sid="LUK 1:61" />ennanes: «yemenni elγerwemc δ wiyn yemsemme g elHucewwem s ellesme wahen.» <verse eid="LUK 1:61" /><verse number="62" style="v" sid="LUK 1:62" />welbeεδ uman ydaddes encδenti δmat iyexs eθisemme. <verse eid="LUK 1:62" /><verse number="63" style="v" sid="LUK 1:63" />esθeγerben leεbaδdiyn lexaTer yuri f elluwHeθ elli yeĎlebt &lt;semmamti yuwHenna.&gt; <verse eid="LUK 1:63" /><verse number="64" style="v" sid="LUK 1:64" />g elweqθes yeθHerrex ilses yeδwel iδukke yebδe yetsebbeH yrebbi. <verse eid="LUK 1:64" /><verse number="65" style="v" sid="LUK 1:65" />max i sliyn leεbaδ s edwiye ukδen essis teδwel elHkayeθe f imawwen nleεbaδ elkul g edhari ntemuwreθ nyehuwδa. <verse eid="LUK 1:65" /><verse number="66" style="v" sid="LUK 1:66" />welli etyesl, ettiHuT g ules usinc eyen: «yendre δmat δeyeδwel engluwse?» lexaTer uwxezen elli rebbi iyδes.<verse eid="LUK 1:66" /></para>
  <para style="s">elγne nzekeriyya</para>
  <para style="p">
    <verse number="67" style="v" sid="LUK 1:67" />isuggez rebbi erruwH elqudus f zekeriyya daddes nyuwHenna bac e yufley usinc eyen δmat δeySar elbeεδ. <verse eid="LUK 1:67" /><verse number="68" style="v" sid="LUK 1:68" />«δimbarex rebbi, rebbi nyeεquwb lexaTer yesfekker leεbeδes yeγδasen δ wiyn δeyqam fellasen eδnubensen. <verse eid="LUK 1:68" /><verse number="69" style="v" sid="LUK 1:69" />yuznane eryaz weHebbac m nette s elHuwc nuxeddemes dawud, eryaz δexenymenneε s elεafyeθ. <verse eid="LUK 1:69" /><verse number="70" style="v" sid="LUK 1:70" />max i yenne f iymi nlenbye elli yuzenten s elli yexleq eddunyeθ. <verse eid="LUK 1:70" /><verse number="71" style="v" sid="LUK 1:71" />yufley f iyjen δexenymenneε s leεδanne usifassen nleεbaδdiyn elli exenγisenc. <verse eid="LUK 1:71" /><verse number="72" style="v" sid="LUK 1:72" />bac e θeggez erreHmeθ f midnenne usinc eyesfekker rebbi elεehδes eTTaher. <verse eid="LUK 1:72" /><verse number="73" style="v" sid="LUK 1:73" />max i yεaheδ seyyedne ibrahiym. <verse eid="LUK 1:73" /><verse number="74" style="v" sid="LUK 1:74" />nette δexenymenneε s leεδanne bac e θneεbeδ wentekkiyδc s leεbaδ iddiyn. <verse eid="LUK 1:74" /><verse number="75" style="v" sid="LUK 1:75" />yemenni enukkeδ essis nette usinc aneg δmat eyeĎleb essiyne elmenemmuwθ. <verse eid="LUK 1:75" /><verse number="76" style="v" sid="LUK 1:76" />ucex, ha engluws, taye δeθeδewleδ enbi nelεali lexaTrek δeθmiyreδ ebriδ δexenysiweD etwali rebbi, ebriδ yeshel welδiys la δulkurδ ula δeccuwk. <verse eid="LUK 1:76" /><verse number="77" style="v" sid="LUK 1:77" />usinc esnen leεbaδ elli wetgedden emenεen s elεafyeθ kan elqulli entisameH rebbi, <verse eid="LUK 1:77" /><verse number="78" style="v" sid="LUK 1:78" />uwah elkul lexaTer rebbi ysexxef f leεbaδ wentiθettuwc emtefuwθe elqulli eθeqqeS fellane, <verse eid="LUK 1:78" /><verse number="79" style="v" sid="LUK 1:79" />bac e DDewwe eddunyeθ f elli eqqiymen g essellesθ useddu eTTel ntemettent, usinc exentsexn ebriδ welδiys la δesubbi ula δelεrex.» <verse eid="LUK 1:79" /><verse number="80" style="v" sid="LUK 1:80" />ykan englusdiyn yettekber werruHes etteθqewwe seg rebbi, yeqqiym yeεmer g essewweθ elmi idyuwse as yeffeγ δiys yuδayen.<verse eid="LUK 1:80" /></para>
  <chapter eid="LUK 1" />
  <chapter number="2" style="c" sid="LUK 2" />
  <para style="s">arew nyesuwε</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 2:1" />g elweqtdiyn wediyn, inabe elqeySer uγusTus yixeddamen nelqeSres welbeεδ yenneyasen: «eHsbeθ leεbaδ elkul g temurθiyw temeqqarθ.» <verse eid="LUK 2:1" /><verse number="2" style="v" sid="LUK 2:2" />θahen tikkelt tigmezwerθ eySar δiys eHsab nleεbaδ elweqθelli ykan kiyriynyuws δelHakem f suwriyye. <verse eid="LUK 2:2" /><verse number="3" style="v" sid="LUK 2:3" />elweqθes yrewweH kul iyjen ytemurθes meni emmarwen midnes bac e yqeyyeδ imenes. <verse eid="LUK 2:3" /><verse number="4" style="v" sid="LUK 2:4" />yuwli yuwsef seg θemuwreθ ennaSreh g eljliyl yemreq ibiytleHm θemuwreθ ndawud g yehuwδa, <verse eid="LUK 2:4" /><verse number="5" style="v" sid="LUK 2:5" />bac e yqeyyeδ imenes nette dmeryem texĎibθes elli tkan ettemeεδurθ. <verse eid="LUK 2:5" /><verse number="6" style="v" sid="LUK 2:6" />unihnin g biytleHm, eθHus s esserwe tuseδes, taru <verse eid="LUK 2:6" /><verse number="7" style="v" sid="LUK 2:7" />taγeδ memmis emenzu, teg sah eθqemmeti welbeεδ essenεesθi g elgurmeθ εlexaTer ellufinc meni eneεsen.<verse eid="LUK 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 2:8" />ykan g ecciyretdiyn iniylten nessen g elεre enni edhari. kanen etεussen f esεiynsen. <verse eid="LUK 2:8" /><verse number="9" style="v" sid="LUK 2:9" />g δeggiyδ yefγasen elmlax, teg sah θeDDewwe eddunyeθ fellasen seg rebbi elmi twerεben iniyltendiyn. <verse eid="LUK 2:9" /><verse number="10" style="v" sid="LUK 2:10" />yemenni elmlaxdiyn yenneyasen: «eθukδemc, rahu usiyγd δexennenne edwi δexenysefreH usinc eysefreH leεbaδ neddunyeθ elkul. <verse eid="LUK 2:10" /><verse number="11" style="v" sid="LUK 2:11" />g temuwreθ ndawud yemmerwawem asse engluws δexenymenneε s ejhennem unette δelmesiyH memmis nrebbi. <verse eid="LUK 2:11" /><verse number="12" style="v" sid="LUK 2:12" />θahen δellemareθ yxenyum, berreθ emerqeθ ibiytleHm uture eθafem engluws δimqemmeδ uyenεes g elgurmeθ.» <verse eid="LUK 2:12" /><verse number="13" style="v" sid="LUK 2:13" />unihnin siyn yeffeγ δeffer elmlaxdiyn eljiyc δemeqqar s elmleyxaθ unihnin etsebHen yrebbi eqqaren: <verse eid="LUK 2:13" /><verse number="14" style="v" sid="LUK 2:14" />«rebbi diyme δelεaliy, rahu eHebbec elεerx g elqeεεeθ elli ibarext rebbi.»<verse eid="LUK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 2:15" />max i δuwlen elmleyxaθ yujenne, ennan essurreHdiyn jerasen: «eyye enemreq ibeytleHm usinc enenzi δmat elHkayeθ elli yenneyane felles rebbi.» <verse eid="LUK 2:15" /><verse number="16" style="v" sid="LUK 2:16" />emerqen tezlen, afen meryem dyuwsef dwengluwsdiyn yenεes g elgurmeθ. <verse eid="LUK 2:16" /><verse number="17" style="v" sid="LUK 2:17" />max i θezriyn, ennen essurraHdiyn ymeryem dyuwsef delli HDeren diyn δmat isliyn f wengluwsdiyn. <verse eid="LUK 2:17" /><verse number="18" style="v" sid="LUK 2:18" />elweqθes esθeγerben leεbaδ elkul s edwiye. <verse eid="LUK 2:18" /><verse number="19" style="v" sid="LUK 2:19" />yemenni meryem tHuTTi g ules teqqiym etxemmem δiys. <verse eid="LUK 2:19" /><verse number="20" style="v" sid="LUK 2:20" />welbeεδ eδwlen essurraHdiyn f imenensen unihnin etsebHen yrebbi f elli zriyn eslen lexaTer kul cey ySar max i yenne elmlax.<verse eid="LUK 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 2:21" />max i yiweD elεemres θmenye eyyam δehrentiy, usemmanti yesuwε max i θisemme elmlax qebl nelli eθeδwel yemmes ettemeεδurθ essis. <verse eid="LUK 2:21" /><verse number="22" style="v" sid="LUK 2:22" />beεδ yθekker meryem, iwyenti etwali elquds, θemuwreθ nrebbi, bac e yemĎehher diyn max i dyuwse g elxθab nmuwse. <verse eid="LUK 2:22" /><verse number="23" style="v" sid="LUK 2:23" />max i yemmari g elxθab nrebbi: «engluws emezwar δeTTaher uδeyali δeSSaleH γer rebbi.» <verse eid="LUK 2:23" /><verse number="24" style="v" sid="LUK 2:24" />usinc eγersen yrebbi sen δiδbiyren δimeqqaren uneγ sen δlefruwx δimezyanen max i yweSSe g elxθebes. <verse eid="LUK 2:24" /><verse number="25" style="v" sid="LUK 2:25" />ykan g temuwreθ nelquds eryaz δeSSaleH uyessen rebbi wesmiθes semεan ykan yetraje g wiyn δeymenneε bni israYiyl, w ykan erruwH nrebbi iyδes. <verse eid="LUK 2:25" /><verse number="26" style="v" sid="LUK 2:26" />as iyjen yuHayes erruwH nrebbi elli nette litmettiyc kan max eyzer elmesiyH. <verse eid="LUK 2:26" /><verse number="27" style="v" sid="LUK 2:27" />yaδef yelHuwc nelqudus beεδ iθyuwzen erruwH nrebbi, elweqθes zade yuwδef yuwsef dmeryem seg memmiynsen bac e δuwcen felles δmat eyeĎleb elqanuwn nrebbi. <verse eid="LUK 2:27" /><verse number="28" style="v" sid="LUK 2:28" />yeg sah yqami g weγiles welbeεδ ysebbeH yrebbi yen, <verse eid="LUK 2:28" /><verse number="29" style="v" sid="LUK 2:29" />«ture, ha rebbi, δeyθedjeδ emmuwθe uneč δ imeθhenni max i θenniyδ. <verse eid="LUK 2:29" /><verse number="30" style="v" sid="LUK 2:30" />lexeTerni ezriyγ δ wiyn δexenymenneε. <verse eid="LUK 2:30" /><verse number="31" style="v" sid="LUK 2:31" />wediyn elli tuznetti yleεbaδ elkul. <verse eid="LUK 2:31" /><verse number="32" style="v" sid="LUK 2:32" />bac e ysexn elHqiyqeθ elεebδ elkul usinc eyεelle uδayen. <verse eid="LUK 2:32" /><verse number="33" style="v" sid="LUK 2:33" />esθeγerben midnes sedwiye elli slinti felles.» <verse eid="LUK 2:33" /><verse number="34" style="v" sid="LUK 2:34" />ibarexθen semεan, yen yyemmes meryem, «wahen yemmazen bac e ysender egget usinc eyεelle egget δleεbaδ s uδayen elmeHaren δiys leεbaδ egget. <verse eid="LUK 2:34" /><verse number="35" style="v" sid="LUK 2:35" />bac e θben elHqiqθensen ezzaθ nrebbi yemenni cem rahu δeθkezmeδ elmeyemmiyzem ulem.» <verse eid="LUK 2:35" /><verse number="36" style="v" sid="LUK 2:36" />eθkan telle temeTTuwθ tessen rebbi egget, eθkan ettemeqqarθ g elεmer wesmiθes Henneh yelliys nfenuwiyl seg sebT eciyr, θedder dweryazes sebεe sniyn. <verse eid="LUK 2:36" /><verse number="37" style="v" sid="LUK 2:37" />welbeεδ teδwel ettedjalt teqqiym siyn elmi tiweD erbεe uθmenyiyn εam. eθkan diyme etqiyme g elHuwc nelqudus tεebbeδ g rebbi g δeggiyδ ddugges s uzuwmi dusebbeH. <verse eid="LUK 2:37" /><verse number="38" style="v" sid="LUK 2:38" />tikkelt temqabel Henneh dyuwsef dmeryem wiyδsen yesuwε g elheykel. elweqθes tebδe etsebbeH eddukke f elmesiyH yuδayen elli etrajen g iyjen eyged entimenneε. <verse eid="LUK 2:38" /><verse number="39" style="v" sid="LUK 2:39" />beεδ ikemlen kul cey max i yenne rebbi g elxθebes, δwelen ytemuwreθ ennaSreh g eljliyl. <verse eid="LUK 2:39" /><verse number="40" style="v" sid="LUK 2:40" />ykan englusdiyn yettekber s lewse s lewse uyetteθqewwe s erruwH nrebbi wules yetεebbe g elHekmeθ. yerni rebbi ykan iyδes.<verse eid="LUK 2:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 2:41" />kanen midnes merqen diyme yelquds g elfeSH, elmuwsem nuδayen elli yettesfekkerθen g was elli γleben imiSriyyen seg seddu ifesnensen. <verse eid="LUK 2:41" /><verse number="42" style="v" sid="LUK 2:42" />max i yiweD elεemres eθnac, uliyen g elmuwsem yelquds emelεaδeθ. <verse eid="LUK 2:42" /><verse number="43" style="v" sid="LUK 2:43" />umax i δuqaneθ liyyameθ nelmuwsem, eδwlen δerewHen yemenni yesuwε iγefelten yeqqiym g elquds δefrensen unihnin ellessinenc, etεilekenti yegguwr g wemmes nleεbaδ. <verse eid="LUK 2:43" /><verse number="44" style="v" sid="LUK 2:44" />beεδ as kamel etteyuwriθ efeqδenti ebδen etHewmen felles jar leqerbensen diSHibnensen. <verse eid="LUK 2:44" /><verse number="45" style="v" sid="LUK 2:45" />elweqθelli eθufiync, eδwlen yelquds etHewmen felles. <verse eid="LUK 2:45" /><verse number="46" style="v" sid="LUK 2:46" />beεδ tlaθe eyyam ufinti g elHuwc nelqudus yeqqiym dimuεelmen isel g mat eqqaren winecceδ δiysen <verse eid="LUK 2:46" /><verse number="47" style="v" sid="LUK 2:47" />esθeγerben leεbaδdiyn elkul s edwiys ulexaTer ifehhem egget. <verse eid="LUK 2:47" /><verse number="48" style="v" sid="LUK 2:48" />elqulli zrinti midnes esθeγerben egget, tennes yemmes: «ha engluws, imat θegiyδ δiyne sah? imat eθεeddebδane tedjδane netHewwem fellex?» <verse eid="LUK 2:48" /><verse number="49" style="v" sid="LUK 2:49" />yenneyasen: «imat itHewmem felle? yendre eltessinemc elli neč welmerqe kan yelHuwc ndadde?» <verse eid="LUK 2:49" /><verse number="50" style="v" sid="LUK 2:50" />yemenni nihnin ellefhimenc edwi elli yenneyesenti. <verse eid="LUK 2:50" /><verse number="51" style="v" sid="LUK 2:51" />welbeεδ yeggez etwali ennaSreh yrewweH iyδsen, useg wesses entiqelleqc siyn lexaTer nette isel g edwiynsen diyme yemenni yemmes eltettuwc edwiys xlaS. <verse eid="LUK 2:51" /><verse number="52" style="v" sid="LUK 2:52" />yesuwε ykan yettekber kul yuwm, yeδwel zade yessen wifehhem egget yerni yucayes rebbi s enneεmθes yaf elqδer δemeqqar γer leεbaδ.<verse eid="LUK 2:52" /></para>
  <chapter eid="LUK 2" />
  <chapter number="3" style="c" sid="LUK 3" />
  <para style="s">elbcareθ nyuwHenna elmeεemden</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 3:1" />g usukkes xemstac s elHukm nellembraTuwr Tiybariywus, welqulli ykan biylaTus elbunTi δelwali f yehuwdiyye uhiyruwdus δelwali f eljliyl w yuwwes fiylibbus δelwali niTuwriyye detraxuwniyts, ulisyanyus δelwali f ibiliyyeh. <verse eid="LUK 3:1" /><verse number="2" style="v" sid="LUK 3:2" />g elweqθ nerrayes nelkahen Hennan dqeyafa tuseδ tufleyθ nrebbi yyuwHenna memmis nzekeriyya unette g essewweθ. <verse eid="LUK 3:2" /><verse number="3" style="v" sid="LUK 3:3" />yemreq yecciyreθ nwesuwf nelurdun. itnabe g leεbaδ bac e seniγeTTes ixfewnensen g wamen nwesuwf bac rebbi yeqbel ettuwbθensen usinc eyettuw<note caller="+" style="f"><char style="fr" closed="false">3.3 </char><char style="ft" closed="false">emmeγferneθ</char></note> leδnubensen. <verse eid="LUK 3:3" /><verse number="4" style="v" sid="LUK 3:4" />max i yemmari g elxθab nenbi icεiyya: «eSSuwθ g essewweθ itnabe: &lt;geddeθ ebriδ nrebbi tedjem teyuriθes teshel.&gt; <verse eid="LUK 3:4" /><verse number="5" style="v" sid="LUK 3:5" />tiHufraθin elkul δemmerδemneθ, wedhari δemmeseθwaneθ wibriyδen imuHacen eδuwlen eshelen wibriyδen imuεaren eδuwlen zade eshelen. <verse eid="LUK 3:5" /><verse number="6" style="v" sid="LUK 3:6" />bac e zren δ wiyn δentimenneε s ejhennem.»<verse eid="LUK 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 3:7" />ykan yuwHenna yeqqar yleεbaδ elli usiynd δeθεemδen f ifesnes: «ha idrari ntelefse, δ wiyn ifeyqawem bac e θemnεem s elγuc elli δedyes? <verse eid="LUK 3:7" /><verse number="8" style="v" sid="LUK 3:8" />eδwleθ yrebbi tukδem essis sexneθ yrebbi ettuwbθewwem weθennemc g ulewnewwem &lt;γenne daddeθne ibrahiym&gt;, lexaTer elweqθes exennenne, &lt;rebbi yetged ayer tiγuγaye θiyhen δidrari nibrahiym.&gt; <verse eid="LUK 3:8" /><verse number="9" style="v" sid="LUK 3:9" />uture taye yelle eqaδum yemHuT f leεruwq nlecjar weccejreθ elli etteruwc elγelleθ tebhe eθemmebbi usinc eθemmeHδef g elεafyeθ.» <verse eid="LUK 3:9" /><verse number="10" style="v" sid="LUK 3:10" />encδenti leεbaδdiyn ennanes: «δmat δaneg?» <verse eid="LUK 3:10" /><verse number="11" style="v" sid="LUK 3:11" />yenneyasen: «elli γers sent δelqeĎεaθ δedbac, eyuc yelli leγrec, welli γers eče eyuc yelli leγrec.» <verse eid="LUK 3:11" /><verse number="12" style="v" sid="LUK 3:12" />usiynd zade ixellaSen elli etlemδen g lefluws s leεbaδ y elHakem bac e mεemδen, encδenti: «unečin δmat δaneg ha siydiy?» <verse eid="LUK 3:12" /><verse number="13" style="v" sid="LUK 3:13" />yenneyasen: «eθewyemc exθer nelli yenneyawem elHakem.» <verse eid="LUK 3:13" /><verse number="14" style="v" sid="LUK 3:14" />encδenti zade leHrus ennanes: «unečin, δmat δaneg?» yenneyasen: «eθewyemc erzi nleεbaδ embessiyf weθesxerxsemc f Hette Hed, tesθeqnεem s eccehreyyeθewwem.»<verse eid="LUK 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 3:15" />kanen leεbaδdiyn elkul necδen g imenensen: &lt;yendre wahen δyuwHenna?&gt; lexaTer nihnin kanen elweqtdiyn wediyn etrajen g elmesiyH. <verse eid="LUK 3:15" /><verse number="16" style="v" sid="LUK 3:16" />yenneyasen: «neč δexenεemδe seg wamen, yemenni δedyes δ wiyn xiriyw δexenyεemmeδ s erruwH elqudus delεafyeθ, uneč ettewδexc Hette esmiyre tilelli neSSebbeĎes. <verse eid="LUK 3:16" /><verse number="17" style="v" sid="LUK 3:17" />unette elli δeyqam ejerwel s ifesnes bac e ySeffe enneres elkul usinc eyawi iyrδen yelmxeznes yemenni eluwm eθyeHreq s elεafyeθ eltnessiyc.»<verse eid="LUK 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 3:18" />ykan yuwHenna yneSSeH g leεbaδ bac e taben wiHekkeyasen f wiyn δeyufley fellasen γer rebbi. <verse eid="LUK 3:18" /><verse number="19" style="v" sid="LUK 3:19" />yemenni yenne edwi yuwHec g elHakem hiyruwdus lexaTer yuγe hiyruwdiyya liwec nyuwwes uyege zade θemuwHacθ egget. <verse eid="LUK 3:19" /><verse number="20" style="v" sid="LUK 3:20" />yerni f wahen elkul iHuT yuwHenna g elHebs.<verse eid="LUK 3:20" /></para>
  <para style="s">elmeεmuwdiyyeθ nyesuwε</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 3:21" />max i mεemδen leεbaδ elkul, yemεemmeδ zade yesuwε welqulli ykan yedzalle imiyr ejenne. <verse eid="LUK 3:21" /><verse number="22" style="v" sid="LUK 3:22" />yeggez felles erruwH elqudus g elxyal nweδbiyr. elweqθes sliyn eSSuwθ iθaseδ s ujenne yeqqar: «cex memmi elli exsexθi, cexdiyn eyendeγ elferHθiyw.»<verse eid="LUK 3:22" /></para>
  <para style="s">elleSl nyesuwε</para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 3:23" />max i yiweD yesuwε eyeg siyn tleθiyn εam iban g TiTTawin nleεbaδ δenbi yemmazen seg rebbi. kanen leεbaδ etεilekenti δmemmis nyuwsef, memmis nhaliy. <verse eid="LUK 3:23" /><verse number="24" style="v" sid="LUK 3:24" />hali memmis nmetθat, metθat memmis nlawiy, lawi memmis nmelkiy, melki memmis nyenna, yenna memmis nyuwsef, <verse eid="LUK 3:24" /><verse number="25" style="v" sid="LUK 3:25" />yuwsef memmis nmettaθiyya, mettaθiyya memmis nεamuwS, εamuwS memmis ennaHuwm, naHuwm memmis nHesliy, Hesli memmis ennejjay, <verse eid="LUK 3:25" /><verse number="26" style="v" sid="LUK 3:26" />nejjay memmis nmeaθ, meaθ memmis nmettaθiyya, mettaθiyya memmis cemεiy, cemεi memmis nyuwsax, yuwsax memmis nyehuwδa, <verse eid="LUK 3:26" /><verse number="27" style="v" sid="LUK 3:27" />yehuwδa memmis nyuwHenna, yuwHenna memmis nriysa, riysa memmis n zerbabel, zerbabel memmis nceltiyl, celtiyl memmis enniyriy, <verse eid="LUK 3:27" /><verse number="28" style="v" sid="LUK 3:28" />niyri memmis nmelkiy, melki memmis neddiy, eddi memmis nquSem, quSem memmis nelmuwdam, elmuwdam memmis nεiyr, <verse eid="LUK 3:28" /><verse number="29" style="v" sid="LUK 3:29" />εiyr memmis nyuwsiy, yuwsi memmis neliyεazer, eliεazer memmis nyuwriym, yuwriym memmis nmetθat, metθat memmis nlawiy, <verse eid="LUK 3:29" /><verse number="30" style="v" sid="LUK 3:30" />lawi memmis ncemεuwn, cemεuwn memmis nyehuwδa, yehuwδa memmis nyuwsef, yuwsef memmis nyuwnan, yuwnan memmis nelyaqiym, <verse eid="LUK 3:30" /><verse number="31" style="v" sid="LUK 3:31" />elyaqiym memmis nmelaya, melaya memmis nmeynan, meynan memmis nmeθθaθa, meθθaθa memmis ennaθan, naθan memmis ndawud, <verse eid="LUK 3:31" /><verse number="32" style="v" sid="LUK 3:32" />dawud memmis nyessa, yessa memmis nεuwbiyd, εuwbiyd memmis nbuwεez, buwεez memmis nselmuwn, selmuwn memmis enneHcuwn, <verse eid="LUK 3:32" /><verse number="33" style="v" sid="LUK 3:33" />neHcuwn memmis nεemmiynadab, εemmiynadab memmis neram, eram memmis nHeSruwn, HeSruwn memmis nfareS, fareS memmis nyehuwδa, <verse eid="LUK 3:33" /><verse number="34" style="v" sid="LUK 3:34" />yehuwδa memmis nyeεquwb, yeεquwb memmis nisHaq, isHaq memmis nibrahiym, ibrahiym memmis ntareH, tareH memmis ennaHuwr, <verse eid="LUK 3:34" /><verse number="35" style="v" sid="LUK 3:35" />naHuwr memmis nsaruwx, saruwx memmis nreεw, reεw memmis nfalex, falex memmis nεaber, εaber memmis ncaleH, <verse eid="LUK 3:35" /><verse number="36" style="v" sid="LUK 3:36" />caleH memmis nqiynan, qiynan memmis nerfekcad, erfekcad memmis nsam, sam memmis ennuwH, nuwH memmis nlamek, <verse eid="LUK 3:36" /><verse number="37" style="v" sid="LUK 3:37" />lamek memmis nmetuwcaleH, metuwcaleH memmis nexnuwx, exnuwx memmis nyared, yared memmis nmehlelliyl, mehlelliyl memmis nqiynan, <verse eid="LUK 3:37" /><verse number="38" style="v" sid="LUK 3:38" />qiynan memmis nenuwc, enuwc memmis nciyθ, ciyθ memmis nadem, adem memmis nrebbi.<verse eid="LUK 3:38" /></para>
  <chapter eid="LUK 3" />
  <chapter number="4" style="c" sid="LUK 4" />
  <para style="s">ecciyĎan eyjerreb yesuwε</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 4:1" />elweqθes yeδwel yesuwε seg ellurdun unette iεebbe s erruwH elqudus, erruwH elli igewwetti etwali essewweθ. <verse eid="LUK 4:1" /><verse number="2" style="v" sid="LUK 4:2" />erbεiyn yuwm wecciyĎan yedjerreb δiys. yerni welyeči δiysneθ Hette cey. max i δuqaneθ liyyametdiyn yHus yelez. <verse eid="LUK 4:2" /><verse number="3" style="v" sid="LUK 4:3" />yennayes ecciyĎan: «iδekan cexdiyn δmemmis nrebbi, ennes yeθγaγette eθeδwel δeγrum.» <verse eid="LUK 4:3" /><verse number="4" style="v" sid="LUK 4:4" />yerre yesuwε felles yennayes: «rahu yemmari, elεebδ liθedderc seg weγrum berk, yemenni yθedder seg tufleyθ nrebbi.» <verse eid="LUK 4:4" /><verse number="5" style="v" sid="LUK 4:5" />welbeεδ ysuliyθi ecciyĎan yeddehreθ teεle, yeg sah ysexnes timuwre neddunyeθ elkul fiyseε fiyseε. <verse eid="LUK 4:5" /><verse number="6" style="v" sid="LUK 4:6" />yennayes: «exedje eθeHkmeδ f timuwraye elkul delli δiysneθ, rahu nihenti elkul seddu efusiyw uneč egedde entuwce yelli exse. <verse eid="LUK 4:6" /><verse number="7" style="v" sid="LUK 4:7" />lukan eyθerkεeδ yneč, exentuwce elkul.» <verse eid="LUK 4:7" /><verse number="8" style="v" sid="LUK 4:8" />yerre f elles yesuwε yennayes: «yemmari kan yrebbi eθerkεeδ ha elεebδ, ukan δrebbi eθeεbδeδ.» <verse eid="LUK 4:8" /><verse number="9" style="v" sid="LUK 4:9" />welbeεδ yiwiθi etwali elquds, yesbeddi f eccafeθ nesqef nelHuwc nelqudus yennes: «iδekan cexdiyn δmemmis nrebbi, Ďeyyec imenex esyah. <verse eid="LUK 4:9" /><verse number="10" style="v" sid="LUK 4:10" />rahu yemmari, rebbi δeyweSSe elmlayxeθes bac e ttelhen essix. <verse eid="LUK 4:10" /><verse number="11" style="v" sid="LUK 4:11" />usinc exqamen s ifesnensen bac e ltεeθrec g elkurδ.» <verse eid="LUK 4:11" /><verse number="12" style="v" sid="LUK 4:12" />yerre felles yesuwε yennayes: «elxθab yenne, ejjerbec rebbi δrebbix.» <verse eid="LUK 4:12" /><verse number="13" style="v" sid="LUK 4:13" />max i ykemmel ecciyĎan s ujerreb nyesuwε yebεeδ felles unette yetraje g tikkelt xlaf bac e yεaweδ eθijerreb.<verse eid="LUK 4:13" /></para>
  <para style="s">ennaSreh eltqabbelc yesuwε</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 4:14" />yeδwel yesuwε yecciyreθ neljliyl s elquδreθ nrebbi, eslen essis leεbaδ ntimuwrediyn elkul. <verse eid="LUK 4:14" /><verse number="15" style="v" sid="LUK 4:15" />ykan yetseqre g eljwameε nuδayen uleεbaδ elkul etsebbeHnes. <verse eid="LUK 4:15" /><verse number="16" style="v" sid="LUK 4:16" />welbeεδ yemreq yennaSreh meni iyekker. yaδef yeljameε nuδayen as nessebθ emelεaδeθ, ybed δeyeqre. <verse eid="LUK 4:16" /><verse number="17" style="v" sid="LUK 4:17" />ucines elxθab nenbi icεiyya welqulli ymiyri yufe eSSefHeθ elli yemmari δiys, <verse eid="LUK 4:17" /><verse number="18" style="v" sid="LUK 4:18" />erruwH nrebbi iyδi lexaTer nette yexθari bac e sefrHe iqelliylen, yuzeniyδ bac e seybe imeHbas usinc edje ileεemyen ezren usinc emenεe imeĎlam s essellesθ, <verse eid="LUK 4:18" /><verse number="19" style="v" sid="LUK 4:19" />yexθari bac e ntsefrHe s usukkes elli δeymenneε δiys rebbi leεbeδes. <verse eid="LUK 4:19" /><verse number="20" style="v" sid="LUK 4:20" />welbeεδ isekker elxθab, yuwci yuxeddam, yeqqiym. elweqθes kanneθ TiTTawin nelli HDeren diyn nedziyneθ δiys. <verse eid="LUK 4:20" /><verse number="21" style="v" sid="LUK 4:21" />yebδe iδukkeyasen yeqqar: «asse yeδwel edwiye wahen belHeq.» <verse eid="LUK 4:21" /><verse number="22" style="v" sid="LUK 4:22" />kanen leεbaδdiyn elkul sellen δiys unihnin ferHeniyn, umesθeγrbiyn zade s edwiye emebruwx elli iθeffeγ s imiys. ebδen eqqaren: «wahen belHeq δmemmis nyuwsef!» <verse eid="LUK 4:22" /><verse number="23" style="v" sid="LUK 4:23" />yenneyasen: «yemenni xenyum δeyθennem asse uneγ eyeče, ha eĎbiyb, sebre imenex! tegeδ dahen g temurθex δmat iθegiδ qebl g kefernaHuwm.» <verse eid="LUK 4:23" /><verse number="24" style="v" sid="LUK 4:24" />welbeεδ yenne: «exennenne elHeq, eHebbec enbi yemmeqbel g temurθes.» <verse eid="LUK 4:24" /><verse number="25" style="v" sid="LUK 4:25" />rahu belHeq, ykan g israYiyl egget ettidjalin g elweqθ nenbi iliyya, bellemare elweqθes yewweθ elez elqeεεeθ elkul lexaTer amzer yeqqiym elyewwiyθc tlaθe sniyn dwezyen. <verse eid="LUK 4:25" /><verse number="26" style="v" sid="LUK 4:26" />urebbi elyuziync iliyya yHette icθ essisneθ, yemenni yuzenti ytemeTTuwθ g Serfeh nSeyda. <verse eid="LUK 4:26" /><verse number="27" style="v" sid="LUK 4:27" />w ykan g israYiyl g elweqθ nenbi eliyceε egget δleεbaδ δimuwDan s elbreS, yemenni nette welysebri Hette iyjen essisen kan δnuεman esuwriy.» <verse eid="LUK 4:27" /><verse number="28" style="v" sid="LUK 4:28" />max i sliyn leεbaδdiyn elli diyn edwiye eθγececen elkulhum egget. <verse eid="LUK 4:28" /><verse number="29" style="v" sid="LUK 4:29" />ekren essufγenti elberre ntemuwreθ elmi itsiywδen yeccafeθ neddehreθ elli temmebne felles θemurθensen bac e θsendren essin. <verse eid="LUK 4:29" /><verse number="30" style="v" sid="LUK 4:30" />yemenni nette yeθεedde jerasen yemreq f imenes.<verse eid="LUK 4:30" /></para>
  <para style="s">ebre nweryaz δiys erruwH ettemenzuwsθ</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 4:31" />yeggez ykefernaHuwm g eljliyl, w ykan yetseqre g leεbaδ as nessebθ diyme. <verse eid="LUK 4:31" /><verse number="32" style="v" sid="LUK 4:32" />kanen imewnensen miyren seg eseqriys lexaTer edwiys δemeqqar uyečaθ g uwl. <verse eid="LUK 4:32" /><verse number="33" style="v" sid="LUK 4:33" />ykan g eljameε nuδayen eryaz γers erruwH necciyĎan. yezge s eSSuwθ yeεle: <verse eid="LUK 4:33" /><verse number="34" style="v" sid="LUK 4:34" />«δmat iθexseδ γenne ha yesuwε ennaSriy, yendre tusiyd bac e xentenγeδ? neč essenγex δwiyn, cex δmemmis n rebbi eTTaher.» <verse eid="LUK 4:34" /><verse number="35" style="v" sid="LUK 4:35" />yeθγeccec felles yesuwε yennes: «essuwsem, ha ecciyĎan! tefγeδ essis.» elweqθes ysenderθi ecciyĎan g wemmesdiyn yeffeγ essis. yemenni wesyegi Hette cey. <verse eid="LUK 4:35" /><verse number="36" style="v" sid="LUK 4:36" />esθeγerben leεbaδdiyn elkul diyn eδwlen dukken jerasen unihnin eqqaren: «δmat tufleyθe θahen? wahen γers elquwweθ ettemeqqarθ, unette yetged yetsuwfeγ g erruwH necciyĎan s elεebδ.» <verse eid="LUK 4:36" /><verse number="37" style="v" sid="LUK 4:37" />eslen essis leεbaδ ntimuwre tiddiyn elkul g eljliyl.<verse eid="LUK 4:37" /></para>
  <para style="s">ebre ntewessarθ nbuTrus</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 4:38" />max i yekker s ezzaθ nleεbaδdiyn, yemreq yelHuwc nsemεan. elweqθes eĎlben essis δeysebre yemmes nliwec nsemεan lexaTer netteθ eθkan etmaDunt egget s esxaneθ. <verse eid="LUK 4:38" /><verse number="39" style="v" sid="LUK 4:39" />ibed ezzaθ numeTreHes, yeg sah &lt;ibeεεeδ felles esxenetdiyn&gt;. yemreq eTTen felles, tekker netteθ eθxeddem δiysen.<verse eid="LUK 4:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 4:40" />max i θeggez tefuwθ uγeδnes leεbaδ elkul imuDenensen. yeg sah iHuT ifesnes f kul iyjen essisen, ebren elkulhum. <verse eid="LUK 4:40" /><verse number="41" style="v" sid="LUK 4:41" />ysuwfeγ lerwaH necyaĎen zade unihnin tεeyĎen eqqaren: «cex δmemmis nrebbi!» yemenni nette ykan yetgelleb δiysen wentiθedjiyc eδufleyen lexaTer uxzenti elli nette δelmesiyH.<verse eid="LUK 4:41" /></para>
  <para style="s">yesuwε yetseqre g elmjameε</para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 4:42" />elweyče talji bekri yeffeγ yesuwε yemreq yelxle. ebδen leεbaδ etHewmen felles elmi tufiyn elweqθes eTfenti bac e yeqqiym iyδsen diyme. <verse eid="LUK 4:42" /><verse number="43" style="v" sid="LUK 4:43" />yemenni yenneyasen: «yelzemni emerqe ytimuwre tiddiyn neč emmazne bac e ntxebre f ejjenneθ nrebbi.» <verse eid="LUK 4:43" /><verse number="44" style="v" sid="LUK 4:44" />yemreq yetsefreH g leεbaδ g eljwameε nuδayen.<verse eid="LUK 4:44" /></para>
  <chapter eid="LUK 4" />
  <chapter number="5" style="c" sid="LUK 5" />
  <para style="s">yesuwε yetnabe g etlamδe iglewlen</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 5:1" />max i mlemδen felles leεbaδ elkul exsen eslen tufleyθ nrebbi, ykan yesuwε ibed g ecceT niylel njenniysaret. <verse eid="LUK 5:1" /><verse number="2" style="v" sid="LUK 5:2" />unette siyn, yezre sent ettiflak bedneθ g eccafeθ niylel wiSeyyaδen elberre esseraδen g elmeεεuwn nuSθaδi. <verse eid="LUK 5:2" /><verse number="3" style="v" sid="LUK 5:3" />yerkeb yesuwε g tefluwkθ nsemεan buTrus yennes: «aδef ywemmes niylel.» welbeεδ yeqqiym f elHerf ntefluwkθ yebδe yetseqre g leεbaδdiyn diyn. <verse eid="LUK 5:3" /><verse number="4" style="v" sid="LUK 5:4" />max i ykemmel s edwiys yennayes ysemεan: «erni aδef yelγriyq niylel. teHδfem eccebkeθewwem bac e θeSθaδem.» <verse eid="LUK 5:4" /><verse number="5" style="v" sid="LUK 5:5" />yerrayes semεan yennes: «ha imuεellem, rahu δeggiyδ elkul unečin netjaheδ yemenni wenneSθeδ cey f elxaĎer ntufleyθex taye δage max i θenniyδ.» <verse eid="LUK 5:5" /><verse number="6" style="v" sid="LUK 5:6" />max i δuwγin s erreyes eSθaδen elHuwθ elmi tebδe eccebkeθensen δetemmenkeδ.» <verse eid="LUK 5:6" /><verse number="7" style="v" sid="LUK 5:7" />elweqθes uman yiSHibnensen g tefluwkθ tissent bac e ddasen usinc entεawnen. esδen εebben tiflak lessentiyn elmi bδaneθ δeγreqneθ. <verse eid="LUK 5:7" /><verse number="8" style="v" sid="LUK 5:8" />max i yezre semεan buTrus elxiyrdiyn elkul yerkeε f ifednes ezzaθ nyesuwε yennes: «ebεeδ felle ha siydiy, lexaTer eγleĎe egget.» <verse eid="LUK 5:8" /><verse number="9" style="v" sid="LUK 5:9" />eqqiymen imewnensen miyren nette delli iyδes, <verse eid="LUK 5:9" /><verse number="10" style="v" sid="LUK 5:10" />zade idrari nzebedi yeεquwb dyuwHenna icriyxen nsemεan lexaTer eSθaδen elHuwθ egget. elweqθes yenne yesuwε ysemεan: «eθukδec, seg ture δeθeδewleδ etteγδeδ leεbaδ yrebbi max i tteγδeδ g elHuwθ s iylel.» <verse eid="LUK 5:10" /><verse number="11" style="v" sid="LUK 5:11" />max i δiweDneθ tiflak lessentiyn yelber, edjin kul cey δefrensen eθbεen yesuwε.<verse eid="LUK 5:11" /></para>
  <para style="s">yesuwε eysebre enebraS</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 5:12" />tikkelt yemreq yesuwε ytemuwreθ ykan δiys iyjen δmaDun s elbreS. eddebelli yezre yesuwε yuDe f uδmes yebδe yetmelges unette yeqqeres: «cex eθgeddeδ eyeSSebriδ iδekan texseδ.» <verse eid="LUK 5:12" /><verse number="13" style="v" sid="LUK 5:13" />yezzel yesuwε efuses yeg sah, ylemmesθi yennes: «wa, exse. ekker cex tebriδ.» g elweqθes yemreq felles elbreS. <verse eid="LUK 5:13" /><verse number="14" style="v" sid="LUK 5:14" />yweSSaθi yennayes: «eθxebrec yeHebbac. emreq sexn uδmex γer elkahen. tuwceδ elHeq nwebrax max i yenne muwse bac e xSedqen leεbaδ.» <verse eid="LUK 5:14" /><verse number="15" style="v" sid="LUK 5:15" />yemenni elxber nyesuwε ykan yesseylel δessiylel elmi sedduwsin leεbaδ egget bac e slen edwiys usinc entisebre seg weTTeneθensen. <verse eid="LUK 5:15" /><verse number="16" style="v" sid="LUK 5:16" />yemenni nette ykan yrukkel yelxle bac e yezzal.<verse eid="LUK 5:16" /></para>
  <para style="s">yesuwε eysebre emecluwl</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 5:17" />as iyjen ykan yetseqre ukanen diyn eqqiymen egget δelHezb nifarisiyyen dimuεelmen necceriyεeθ wiyhen usiynd seg timuwre neljliyl dyehuwdiyye delquds. s elquwweθ nrebbi ykan yesuwε yetsebre g leεbaδ. <verse eid="LUK 5:17" /><verse number="18" style="v" sid="LUK 5:18" />unihnin siyn usiynd leεbaδ qamen iyjen δemecluwl g eθmelHefθ. exsen eδaδfen essis usinc eθHuTTen ezzeθes. <verse eid="LUK 5:18" /><verse number="19" style="v" sid="LUK 5:19" />elqulli elgeddenc eδaδfen lexaTer leεbaδ egget uliyen essis yesqef welbeεδ sugzenti s timelHefθes seg jar iγeryan yekker ezzaθ nyesuwε. <verse eid="LUK 5:19" /><verse number="20" style="v" sid="LUK 5:20" />max i ntyuwxez yesuwε elli nihnin essenen rebbi yenne yumecluwldiyn: «neč sameHγex.» <verse eid="LUK 5:20" /><verse number="21" style="v" sid="LUK 5:21" />elweqθes ebδen imuεelmen delHezb nifarisiyyen etxememen unihnin eqqaren: «δ wiyn wahen elli ykeffer? yendre yelle δ wiyn yetged yetsameH emrebbi?» <verse eid="LUK 5:21" /><verse number="22" style="v" sid="LUK 5:22" />yemenni yesuwε yuxez f mat itxememen. elweqθes yenneyasen: «imat etxememem sahen? <verse eid="LUK 5:22" /><verse number="23" style="v" sid="LUK 5:23" />δmanten eshel? enneγ &lt;neč sameHγex.&gt; uneγ enneγ &lt;ekker uyuwr!&gt; <verse eid="LUK 5:23" /><verse number="24" style="v" sid="LUK 5:24" />yemenni enniyγ sah bac e θesnem bnaδem (elli neč yexθari rebbi) γers elquδreθ f elqeεεeθ wetgedde eqame f ellawem eδnubeθewwem.» welbeεδ yenne yumecluwldiyn: «ekker, qam timelHefθex temerqeδ yelHucex.» <verse eid="LUK 5:24" /><verse number="25" style="v" sid="LUK 5:25" />eddebelli yesle edwiys, yekker s ezzeθensen yqam emeTreHes yrewweH yelHuces unette yetsebbeH yrebbi. <verse eid="LUK 5:25" /><verse number="26" style="v" sid="LUK 5:26" />elweqθes esθeγerben leεbaδdiyn elkul, ukδen ebδen etsebHen yrebbi unihnin eqqaren: «asse nezraθ elγriybeθ.»<verse eid="LUK 5:26" /></para>
  <para style="s">yesuwε inabe lawiy</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 5:27" />max i yeffeγ esyiyn yezre yesuwε lawiy, exellaS nelHakem, yeqqiym g elbiruws, yeg sah yennayes: «eθbεiy!» <verse eid="LUK 5:27" /><verse number="28" style="v" sid="LUK 5:28" />elweqθes yedje kul cey δefres yekker iθebbeε g yesuwε. <verse eid="LUK 5:28" /><verse number="29" style="v" sid="LUK 5:29" />yeεreD lawi f yesuwε g elHuces ukanen iyδsen elberceθ δixellaSen dleεbaδ xlaf. <verse eid="LUK 5:29" /><verse number="30" style="v" sid="LUK 5:30" />ennan imuεelmen nuδayen delHezb nifarisiyyen yetlamδe nyesuwε unihnin δimeθγececen: «imat ettettem wessessem dixellaSen nelHakem dleεbaδ elli ellessinenc rebbi?» <verse eid="LUK 5:30" /><verse number="31" style="v" sid="LUK 5:31" />elweqθes yenneyasen yesuwε: «iyjen litnebiyc eĎbiyb yleεbaδ SHaH, yemenni itnabe eĎbiyb yleεbaδ imuwDan. <verse eid="LUK 5:31" /><verse number="32" style="v" sid="LUK 5:32" />neč eddusixc δenabiyγ leεbaδ eTTuhhar, yemenni usiyγd δegewδe leεbaδ imuwHac ywebriδ nrebbi.»<verse eid="LUK 5:32" /></para>
  <para style="s">ezuwmi</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 5:33" />ennanes: «imat iSHiyben nyuwHenna etzuwmen egget wedzallen egget, uzade etlamδe nelHezb nifarisiyyen tegen siyn, yemenni iSHibnex tetten sessen berk?» <verse eid="LUK 5:33" /><verse number="34" style="v" sid="LUK 5:34" />elweqθes yenneyasen: «yendre xenyum eθgeddem eθedjem leεbaδ nislan ezuwmen welεriys iyδsen? <verse eid="LUK 5:34" /><verse number="35" style="v" sid="LUK 5:35" />yemenni δedyes as δeyemqam δiys elεriys lennej. elweqθes nihnin δezuwmen.» <verse eid="LUK 5:35" /><verse number="36" style="v" sid="LUK 5:36" />yerni yufleyasen s enneHw yenneyasen: «eHebbec δ wiyn eycerrex eTTerf nelqmac s umeryuwl δejδiyδ bac e yreqqeε essis emeryuwl δeqδiym lexaTer eθruqεet elweqθes etwetiyc emeryuwl eqδiym wentgeddec zade eniyreδ emeryuwl ejδiyδ lexaTer yemcerrex. <verse eid="LUK 5:36" /><verse number="37" style="v" sid="LUK 5:37" />weHebbac δ wiyn eyenγel ecrab δejδiyδ g elmezweδ δeqδiym lexaTer elweqθes ecrab ejδiyδ eyenqeb elmezweδ usinc eyemwezzeε, elmezweδ eyherre. <verse eid="LUK 5:37" /><verse number="38" style="v" sid="LUK 5:38" />yemenni ture yelzem enenγel ecrab δejδiyδ g elmezweδ δejδiyδ. <verse eid="LUK 5:38" /><verse number="39" style="v" sid="LUK 5:39" />wettefec δ wiyn ises ecrab δeqδiym yexs eysu ecrab δejδiyδ, lexaTer yessen &lt;ecrab eqδiym xiyr.&gt;»<verse eid="LUK 5:39" /></para>
  <chapter eid="LUK 5" />
  <chapter number="6" style="c" sid="LUK 6" />
  <para style="s">essebθ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 6:1" />tikkelt nessebθ as n erraHeθ ykan yesuwε yegguwr jar ijiyman wetlemδas δefres θebyen g tiyeδrin niyrδen welbeεδ eqecren usinc ečen. <verse eid="LUK 6:1" /><verse number="2" style="v" sid="LUK 6:2" />elweqθes ennanes elHezb nifarisiyyen, «imat ettegem g elHram as nessebθ?» <verse eid="LUK 6:2" /><verse number="3" style="v" sid="LUK 6:3" />yenneyasen yesuwε: «yendre eltessinemc δmat iyege dawud nette diSHibnes elqulli elluwzen. <verse eid="LUK 6:3" /><verse number="4" style="v" sid="LUK 6:4" />rahu yuwδef dawud yelHuwc nelqudus yeč seg weγrum elli diyn yerni yuwce yelli iyδes uxenyum tessenem, eγrum nelHuwc nelqudus tettenti kan δelkuhhan.» <verse eid="LUK 6:4" /><verse number="5" style="v" sid="LUK 6:5" />yerni yenneyasen, «neč, yexθari rebbi bac e xennenne f elqanuwn eHeqqani nwas nessebθ.»<verse eid="LUK 6:5" /></para>
  <para style="s">yesuwε eysebre g essebθ</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 6:6" />essebθ xlaf yuwδef seyyedne yesuwε eljameε nuδayen yebδe yetseqre. ykan diyn eryaz efuses nelymiyn teqquwr litgeddec ettiHerrex. <verse eid="LUK 6:6" /><verse number="7" style="v" sid="LUK 6:7" />ebδen imufesren necceriyεeθ delHezb nifarisiyyen etεussen f yesuwε maδebiyhum eysebre eryazdiyn as nessebθ bac e Tfen felles elHajeθ. <verse eid="LUK 6:7" /><verse number="8" style="v" sid="LUK 6:8" />yemenni seyyedne yesuwε yefhemten f mat etxememen. elweqθes yennayes yweryazdiyn, «ekker eθbeddeδ g wemmes.» yemreq ibed diyn. <verse eid="LUK 6:8" /><verse number="9" style="v" sid="LUK 6:9" />yenneyasen yesuwε: «neč δexennencδe, emexiyr eneg elxiyr as nessebθ uneγ eneg δeccer? enmenneε leεbaδ uneγ entnenγ?» <verse eid="LUK 6:9" /><verse number="10" style="v" sid="LUK 6:10" />beεδ iyenzi yleεbaδdiyn elkul yennayes yweryazdiyn, «ezzel efusex!» yezzel efuses yerjεes iδammen yebδe yetHerrex δiys. <verse eid="LUK 6:10" /><verse number="11" style="v" sid="LUK 6:11" />yemenni nihnin ebδen ettemfehamen felles exsen esegen θemuwHacθ.<verse eid="LUK 6:11" /></para>
  <para style="s">yesuwε yettexθer imersal leθnac</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 6:12" />beεδ liyyameθ yuwli yeddehreθ teεle bac e yezzal. yeqqiym δeggiyδ elkul unette yedzalle yrebbi elmi eyeffeγ felles talji. <verse eid="LUK 6:12" /><verse number="13" style="v" sid="LUK 6:13" />welbeεδ inabe yetlemδas elkul yexθar essisen eθnac iyhen yegin δetlemδas elli δeseqren edwiys beεδes. <verse eid="LUK 6:13" /><verse number="14" style="v" sid="LUK 6:14" />wiyhen: semεan elli ysemmaθi buTrus zade dyuwwes endrawus, yeεquwb dyuwHenna, fiylibbus dberθuwluwmawus. <verse eid="LUK 6:14" /><verse number="15" style="v" sid="LUK 6:15" />metti dtuwma, yeεquwb memmis nHelfe dsemεan emeγyar (elli yettenγar egget f temurθes), <verse eid="LUK 6:15" /><verse number="16" style="v" sid="LUK 6:16" />yehuwδa memmis nyeεquwb dyehuwδa esxeryuwTi elli izenz yesuwε elbeεδ. yesuwε yetseqre uyetsebre <verse eid="LUK 6:16" /><verse number="17" style="v" sid="LUK 6:17" />welbeεδ yeggez iyδsen ibed g ujiymi δemeqqar ezzaθ netlemδas iddiyn dleεbaδ xlaf egget. iyhen usiynd s elyehuwdiyyeθ duwrceliym dessaHel nSuwr dSeyda. <verse eid="LUK 6:17" /><verse number="18" style="v" sid="LUK 6:18" />bac e slen edwi nseyyedne yesuwε usinc entisebre seg weTTeneθensen. yerni isebre leεbaδdiyn imesθaδyen. <verse eid="LUK 6:18" /><verse number="19" style="v" sid="LUK 6:19" />leεbaδdiyn elkul kanen exsen eθlemsen lexaTer nette γers elquwweθ yetged entisebre.<verse eid="LUK 6:19" /></para>
  <para style="s">elberxeθ delleεneθ</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 6:20" />welbeεδ yqam tiTTewines etwali etlemδas yen, «xenyum δimbarxen ha iqelliylen, lexaTer rebbi yuceyawem elmemlexθes. <verse eid="LUK 6:20" /><verse number="21" style="v" sid="LUK 6:21" />xenyum zade elli telluwzem SeHHe liykum taye δeθecebεem uxenyum elli etterwem SeHHe liykum taye δeθeSSem. <verse eid="LUK 6:21" /><verse number="22" style="v" sid="LUK 6:22" />efrHeθ elqulli exennekrhen leεbaδ usinc exengelben. eferHeθ elqulli exensubben usinc exenεayren s ellesmewwem f elxeĎriyw. <verse eid="LUK 6:22" /><verse number="23" style="v" sid="LUK 6:23" />esses eferHeθ eSSefqem lexaTer ellejrewwem γer rebbi δemeqqar lexaTer midnensen kanen tegen sah yellenbye. <verse eid="LUK 6:23" /><verse number="24" style="v" sid="LUK 6:24" />yemenni yeHliylkum ha imurkentiyyen, lexaTer tiwiyem elbeyewwem seg bekri. <verse eid="LUK 6:24" /><verse number="25" style="v" sid="LUK 6:25" />xenyum zade elli θecbeεem yeHliylkum taye δeθelluwzem uxenyum elli eddessem yeHliylkum lexaTer δeθerwem usinc δeθnewHem. <verse eid="LUK 6:25" /><verse number="26" style="v" sid="LUK 6:26" />yeHliylkum elqulli exenneSSen leεbaδ g uδmewnewwem lexaTer midnensen kan tegen sah yellenbye elli esxerxuwsen.<verse eid="LUK 6:26" /></para>
  <para style="s">axse nleεδe</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 6:27" />yemenni neč exennenne, yxenyum elli essellem δiyye, exseθ leεδewwem, eθegemc temeεfunt yelli exenγisenc. <verse eid="LUK 6:27" /><verse number="28" style="v" sid="LUK 6:28" />selmeθ f elli etsubben δiywem ternim ezzalleθ yelli θegnawem g eθmeεfunt bac e ntisameH rebbi. <verse eid="LUK 6:28" /><verse number="29" style="v" sid="LUK 6:29" />welli exyewweθ ha elεebδ f elHenkex, εerDes elHenkex wissen. welli exyekkes emeryulex uwces ettebδiltex. <verse eid="LUK 6:29" /><verse number="30" style="v" sid="LUK 6:30" />welli eyeĎleb essix ecceHaje etterrec welli exyekkes elmelex embessiyf eθezlec δefres. <verse eid="LUK 6:30" /><verse number="31" style="v" sid="LUK 6:31" />umax i θexsem exennegen leεbaδ egmasen xenyum zade siyn. <verse eid="LUK 6:31" /><verse number="32" style="v" sid="LUK 6:32" />xenyum rahu elγerwemc elmziyyeθ elqulli eθexsem elli exsnawem. lexaTer Hette muc SaleH exsen elli exsenten. <verse eid="LUK 6:32" /><verse number="33" style="v" sid="LUK 6:33" />urahu elγerwemc elmziyyeθ elqulli eθkuwnem tebham dleεbaδ elli bhan iyδwem. lexaTer Hette muc SaleH. <verse eid="LUK 6:33" /><verse number="34" style="v" sid="LUK 6:34" />urahu elγerwemc elmziyyeθ elqulli esselfem ecceHaje yiyjen usinc eθeqqiymem lemmi δexenyer elHajθewwem. lexaTer Hette muc SaleH tegen siyn. <verse eid="LUK 6:34" /><verse number="35" style="v" sid="LUK 6:35" />yemenni exseθ leεδewwem weθegemc temeεfunt ternim selfeθ yleεbaδ weθeDmεem g Hette cey. elweqθes eθafem ellejr δemeqqar γer rebbi usinc eθeδewlem δidrari nrebbi elεali lexaTer nette iθuč elxires zade yimeθkebren δimuwHac. <verse eid="LUK 6:35" /><verse number="36" style="v" sid="LUK 6:36" />esxfeθ f leεbaδ max i ysexxef daddeθwem f leεbaδ.<verse eid="LUK 6:36" /></para>
  <para style="s">ettehmeθ nelγiyr</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 6:37" />weθettehmem Hette Hed eθenzγemc leεbaδ uxenyum eddukkem bac wexenynedzeγ Hette Hed. weθecθxam s Hette Hed bac e lyettecθxi essiywem Hette Hed. essamHem leεbaδ bac e θafem δ wiyn exenysameH. <verse eid="LUK 6:37" /><verse number="38" style="v" sid="LUK 6:38" />uwceθ esseybem ifesnewwem bac e θafem δ wiyn exenyuc lexaTer max eθuwcem exenyuc rebbi s elxires.»<verse eid="LUK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 6:39" />welbeεδ yebδe iδukkeyasen s enneHw: «yendre eyged iyjen δileεmi eygewweδ iyjen xlaf δileεmi? mahu δeδuDen lessenniyn g eθHufret. <verse eid="LUK 6:39" /><verse number="40" style="v" sid="LUK 6:40" />eHebbec ettelmiδ iδukkel xiyr nimuεelmes yemenni elqulli iyjen eykemmel elqreyθes eyged eyeδwel emimuεelmes. <verse eid="LUK 6:40" /><verse number="41" style="v" sid="LUK 6:41" />umax eθgeddeδ eθezreδ elgecceθ ettemezyent g tiT nyuwwex wetfeqec s uqecquc δemeqqar g tiTTex. <verse eid="LUK 6:41" /><verse number="42" style="v" sid="LUK 6:42" />umax eθgeddeδ eθenneδ yyuwwex: ha yuwwe, edji exekse elgecceθ temezyent seg tiTTex ucex eltfeqec seg eqecquc δemeqqar g tiTTex. ha ekeδδeb, ekkes qebl eqecquc emeqqar s tiTTex welqulli eθeδwleδ ezzerreδ belgde, ekkes elgecceθ temezyent seg tiT nyuwwex.<verse eid="LUK 6:42" /></para>
  <para style="s">eccejreθ δelγelTes</para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 6:43" />eHebbec tezemmuwrθ tebhe ettaru g uzemmuwr δezδeδ, weHebbac tezemmuwrθ teffuwδ ettaru g uzemmuwr eγliyD. <verse eid="LUK 6:43" /><verse number="44" style="v" sid="LUK 6:44" />kul eccejer γers elγelleθes. imečan etmekkisenc seg eccuwk, welεneb yetmekkiysec seg elεulliyge. <verse eid="LUK 6:44" /><verse number="45" style="v" sid="LUK 6:45" />elεebδ ebehhay seg elkenz ebehhay elli g ules yetsuwfeγ elli yebhe, welεebδ emuwHac seg elkenz emuwHac elli g ules yetsuwfeγ elli yuwHec, εlexaTer seg elli iεebbe ules iδukke.<verse eid="LUK 6:45" /></para>
  <para style="s">elxeδmeθ s edwi n elmesiyH</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 6:46" />imette etnabem δiyye, ya rebb, ya rebb, wellettegemc elli eqqerγawem felles? <verse eid="LUK 6:46" /><verse number="47" style="v" sid="LUK 6:47" />elli eyeddes yesseγδ edwiyw yexδem essis, tay δexennenne ywiyn icebbeh: <verse eid="LUK 6:47" /><verse number="48" style="v" sid="LUK 6:48" />yweryaz yebne elHuwc iγerreq essas elδeyaweD isli, max i yfaD esuwf yewweθ elHuwcdiyn weθiHerrexc εlexaTer yemmebne f eSSeH <verse eid="LUK 6:48" /><verse number="49" style="v" sid="LUK 6:49" />welli eyesseγδ edwiyw welixeddemc essis icebbeh yweryaz yebne elHuces f elqeεεeθ blac essas yewwet esuwf yuDe yemheddem elkul.»<verse eid="LUK 6:49" /></para>
  <chapter eid="LUK 6" />
  <chapter number="7" style="c" sid="LUK 7" />
  <para style="s">ebre nuxeddam niyjen seg eDDubbaT</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 7:1" />max i yeHke yesuwε yleεbaδ, yuwδef g temuwreθ nkefernaHuwm. <verse eid="LUK 7:1" /><verse number="2" style="v" sid="LUK 7:2" />w ykan iyjen seg eDDubbaT neljiyc nerruwman γers exeddam yuDen εuddi δeyjaf, w ykan yexsi egget. <verse eid="LUK 7:2" /><verse number="3" style="v" sid="LUK 7:3" />max i yesle s yesuwε yuzenes elmcayex nuδayen etnaben δiys bac e sysebre exeddemes. <verse eid="LUK 7:3" /><verse number="4" style="v" sid="LUK 7:4" />esδen yyesuwε, mellegnes ennanes: «eryaze yettesθahel etεawneδ, <verse eid="LUK 7:4" /><verse number="5" style="v" sid="LUK 7:5" />εlexaTer yexs leεbeδenne, wennette elli yebneyane elmejmeε.» <verse eid="LUK 7:5" /><verse number="6" style="v" sid="LUK 7:6" />yexDem yesuwε iyδsen. max i yeqreb yetwali elHuwc yuzenes eDDabeT eSSuHHebes bac e syen: «ya siydiy, eθqelqec imenex, neč ettesθehilac eθeδfeδ seddu esqef nelHuciyw, <verse eid="LUK 7:6" /><verse number="7" style="v" sid="LUK 7:7" />wettesθehilac exeddase. emme en tuθleyθ teSSebriδ exeddemiyw. <verse eid="LUK 7:7" /><verse number="8" style="v" sid="LUK 7:8" />neč zade δeryaz Hekmen δiyye uγeri elεesker s eddwiyw, enne ywahen &lt;berre!&gt; eyexDem, uwissen esenne &lt;est!&gt; eyeddes, uyuxeddemiyw &lt;eg wahen!&gt; eyeg.» <verse eid="LUK 7:8" /><verse number="9" style="v" sid="LUK 7:9" />max i yesle yesuwε edwiye, yesθeγreb yebren yelli θebεen δiys yennasen: «exennenne: ellufixc eliman emwah Hette g ebni israYiyl!» <verse eid="LUK 7:9" /><verse number="10" style="v" sid="LUK 7:10" />eδwlen imersal neDDabeT yelHuwc, efen exeddam yebre.<verse eid="LUK 7:10" /></para>
  <para style="s">esedder nemmiys ntehejjelt</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 7:11" />welweječe yexDem yesuwε ytemuwreθ ellesmes nayiyn, wiyδes etlemδas dleεbaδ egget. <verse eid="LUK 7:11" /><verse number="12" style="v" sid="LUK 7:12" />max i yiweD yiymi ntemuwreθ, yufe iyjen yjaf iwyent δeθerδmen, uyemmes ettedjalt uγers kan ennette. uleεbaδ egget seg θemuwreθ kanen θebεen δiys. <verse eid="LUK 7:12" /><verse number="13" style="v" sid="LUK 7:13" />max i tyezre seyyedne yesuwε yesxef felles yennes: «eθεeyĎec!» <verse eid="LUK 7:13" /><verse number="14" style="v" sid="LUK 7:14" />yeqreb yenneεc ilemmesθ, bedden elli qament. yen: «eyeεezri, eqqarγex ekker!» <verse eid="LUK 7:14" /><verse number="15" style="v" sid="LUK 7:15" />yekker elmeyyet yebδe iδukke, yuwci yyemmes. <verse eid="LUK 7:15" /><verse number="16" style="v" sid="LUK 7:16" />ukδen leεbaδ elkul, ennen unihnin etmejδen g rebbi: «yeffeγ uggemmesenne enbi δemeqqar, urebbi yesfekker leεbeδes!» <verse eid="LUK 7:16" /><verse number="17" style="v" sid="LUK 7:17" />eslen leεbaδ nyehuwdiyye elkul ettimuwre elli yetweliys s yesuwε.<verse eid="LUK 7:17" /></para>
  <para style="s">yesuwε dyuwHenna elmeεmdan</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 7:18" />yesl yuwHenna elmeεmdan seg etlemδas s kul cey, <verse eid="LUK 7:18" /><verse number="19" style="v" sid="LUK 7:19" />inabe sen essisen yezenten yseyyedne yesuwε bac e θencδen: «δcex elli δeyeddes ziyγ enraje iyjen xlaf?» <verse eid="LUK 7:19" /><verse number="20" style="v" sid="LUK 7:20" />esδen iryazendiyn yyesuwε ennanes: «yuznane yuwHenna elmeεmdan bac e xnenceδ: δcex elli δeyeddes ziyγ enraje iyjen xlaf?» <verse eid="LUK 7:20" /><verse number="21" style="v" sid="LUK 7:21" />ysebre yesuwε g esseεetdiyn imuwDan egget delli δimeryaH, yrejjeε egget ileεemyen zerren. <verse eid="LUK 7:21" /><verse number="22" style="v" sid="LUK 7:22" />yen yimersal: «eδwleθ teHkem yyuwHenna elli tezriymt delli tesliymt: ileεemyen zerren, welεuyyab egguwren, winebraS bran, wileĎrcen sellen, wilemmitte ekkeren, wiqelliylen ettembeccaren s elxiyr. <verse eid="LUK 7:22" /><verse number="23" style="v" sid="LUK 7:23" />welli δeyemmen essi SeHHe liyh.» <verse eid="LUK 7:23" /><verse number="24" style="v" sid="LUK 7:24" />max i xeDmen imersal nyuwHenna, yeHkeyasen yesuwε yleεbaδ felles, yen: «δmette iθefγem treqbem g elxle? γeniym yettawi δiys aDu? <verse eid="LUK 7:24" /><verse number="25" style="v" sid="LUK 7:25" />δmette iθefγem δeθerqbem? eryaz yireD edbac e rĎeben? emme elli raDen edbac bhan ettedren g leqSuwr nlemluwk! <verse eid="LUK 7:25" /><verse number="26" style="v" sid="LUK 7:26" />enmiyδ: δmette iθefγem treqbem? enbi? exennenne: mbelHeq, uxiyr nenbi. <verse eid="LUK 7:26" /><verse number="27" style="v" sid="LUK 7:27" />nette δemersal elli yemmari g elxθab: tay δeθezne emerseliyw ezzeθex bac e xyged ebriδex. <verse eid="LUK 7:27" /><verse number="28" style="v" sid="LUK 7:28" />exennenne: elwacun elliriwnec maxiyr nyuwHenna, emme emezyen nelli g elmelx nrebbi xires. <verse eid="LUK 7:28" /><verse number="29" style="v" sid="LUK 7:29" />welli sliyn yuwHenna elkul Hette δelli etleyamen g lefluws s leεbaδ y elHakem, Sedqen rebbi, eqeblen temeεmuwdiyyeθ nyuwHenna. <verse eid="LUK 7:29" /><verse number="30" style="v" sid="LUK 7:30" />emme elHezb nifarisiyyen dimuεelmen necceriyεeθ elleqbilenc elli yexsesent rebbi, welleθεemdenc f ifesnes.»<verse eid="LUK 7:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 7:31" />yen erreb yesuwε: «s wiyn δecebhe idrari neljiyle? ywiyn icebhen? <verse eid="LUK 7:31" /><verse number="32" style="v" sid="LUK 7:32" />cebhen yidrari geεmzen g essaHeθ, etzeεwgen ibeεDhum: enγeyĎawem welterqisemc, unendbawem weltεeyĎemc. <verse eid="LUK 7:32" /><verse number="33" style="v" sid="LUK 7:33" />yuseδ yuwHenna elmeεmdan eliθeč eγrum welisessec ecrab tennem: δiys ecciyĎan! <verse eid="LUK 7:33" /><verse number="34" style="v" sid="LUK 7:34" />yeseδ bnaδem (neč, yexθari rebbi) iθet wises tennem: wahen δeryaz iθet wisexxer egget uδemedduwkel nelli etleyamen g lefluws delli muc δeSSaleH. <verse eid="LUK 7:34" /><verse number="35" style="v" sid="LUK 7:35" />welHekmeθ temmesxen s idreriys elkul.»<verse eid="LUK 7:35" /></para>
  <para style="s">yesuwε eysameH temeTTuwθ ettelγalet</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 7:36" />yelle iyjen seg elHezb nifarisiyyen ellesmes semεan inebaθ bac e yeč γers, yaδef elHuwc nufariysi ygeεmez f eTTawleθ. <verse eid="LUK 7:36" /><verse number="37" style="v" sid="LUK 7:37" />g temuwretdiyn eθkan telle temeTTuwθ muc etteSSaleHθ, tesl s yesuwε iθet g elHuwc nufariysi. teseδ taγeδ iyδes teδebbuzeθ nerriyHeθ teγle. <verse eid="LUK 7:37" /><verse number="38" style="v" sid="LUK 7:38" />eθbed δefres yetwali ikreεnes unetteθ etεeyyeĎ, tebδe teslexsayes g ikreεnes s imeTTewnes, usiyn entefreδ s ezewes, eθkubbin, teδhenten s erriyHeθ. <verse eid="LUK 7:38" /><verse number="39" style="v" sid="LUK 7:39" />max i yezre efariysi iθbab nelHuwc elli yejre, yen g ules: &lt;lukan eryaze δenbi rahu yelle yessen δ wiyn temeTTuwθe elli etlemmes δiys uδmette elHeles. rahi muc etteSSaleHθ!&gt; <verse eid="LUK 7:39" /><verse number="40" style="v" sid="LUK 7:40" />yennes yesuwε: «semεan, γeri δmat δexenne.» yennes semεan: «en, eyimuεellem.» <verse eid="LUK 7:40" /><verse number="41" style="v" sid="LUK 7:41" />yennes yesuwε: «ykan yelle eryaz yetsal lefluws ysen δiryazen: iyjen xemse myat elf, uwissen xemsiyn. <verse eid="LUK 7:41" /><verse number="42" style="v" sid="LUK 7:42" />iryazendiyn elgeddenc eδefεen iddiyn elli fellasen. yreyyeHθen essis. δ wiyn δeθyexs exθer?» <verse eid="LUK 7:42" /><verse number="43" style="v" sid="LUK 7:43" />yer felles semεan: «fibali elli yetsali exθer.» yennes yesuwε: «δuSHiH.» <verse eid="LUK 7:43" /><verse number="44" style="v" sid="LUK 7:44" />yebren ytemeTTuwθ yen ysemεan: «tzerreδ g temeTTuwθe? uδefe yelHucex Hette δamen entenγilec f ikreεniyw, unetteθ tessiretten s imeTTewnes tefreDten s ezewes. <verse eid="LUK 7:44" /><verse number="45" style="v" sid="LUK 7:45" />cex eyeθkubbec Hette tikkelt, unetteθ seg max i θuδfe eltbeTTelc seg ekubbi nikreεniyw. <verse eid="LUK 7:45" /><verse number="46" style="v" sid="LUK 7:46" />cex elteδhinec ixfiyw Hette s uwδi, unetteθ teδhen ikreεniyw s erriyHeθ. <verse eid="LUK 7:46" /><verse number="47" style="v" sid="LUK 7:47" />usahen tay δexenne: elxĎayas elkul emmeγferneθ, f elxaĎer nwah texse egget. emme elli yetmeγfares qiqqi, yexs qiqqi.» <verse eid="LUK 7:47" /><verse number="48" style="v" sid="LUK 7:48" />yennes ytemeTTuwθ: «elxĎayam emmeγferneθ elkul!» <verse eid="LUK 7:48" /><verse number="49" style="v" sid="LUK 7:49" />ebδen elli iyδes f eTTawleθ necδen: «δ wiyn nette wahen bac e yeγfer elxĎaye?» <verse eid="LUK 7:49" /><verse number="50" style="v" sid="LUK 7:50" />yen yesuwε ytemeTTuwθ: «elimenem ymenεem, berre g eslam!»<verse eid="LUK 7:50" /></para>
  <chapter eid="LUK 7" />
  <chapter number="8" style="c" sid="LUK 8" />
  <para style="s">yesuwε diSHibnes</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 8:1" />ubeεεeδ yenneD yesuwε g lemden ettimuwre yetseqre uyetbeccer s elmemlxeθ nrebbi. ukanen etlamδe leθnac θebεen δiys. <verse eid="LUK 8:1" /><verse number="2" style="v" sid="LUK 8:2" />delwacun zade elli yeSSebraθent seg lerwaH dweTTaneθ, essisneθ meryem, elli temmessen s temejdeliyθ, welli ysuwfeγ essis sebεe δecyaĎen, <verse eid="LUK 8:2" /><verse number="3" style="v" sid="LUK 8:3" />dyuwwenne liwec nxuwzi ewkiyl nhiyruwdus dsuwsenne delγirensneθ egget elli kanneθ etεawenneθ δiysen s elli γersneθ.<verse eid="LUK 8:3" /></para>
  <para style="s">elmθel nezzareε</para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 8:4" />eseδnes leεbaδ seg timuwre elkul max i mlaymen essisen egget, yeHkeyasen elmθel, yen: <verse eid="LUK 8:4" /><verse number="5" style="v" sid="LUK 8:5" />«yeffeγ ezerraε bac e yezreε. unette izerreε uDaneθ timzin f eccafeθ nwebriδ eεfsentent ikraεεen ečentent izenniywen nesme. <verse eid="LUK 8:5" /><verse number="6" style="v" sid="LUK 8:6" />uDaneθ timzin xlaf f elHegfeθ, max i nebbeθneθ yeqquwr imendi εlexaTer leHebbac e tre. <verse eid="LUK 8:6" /><verse number="7" style="v" sid="LUK 8:7" />uDaneθ elkeεbaθ xlaf f eccuwk, yemmexneq imendi s eccuwk. <verse eid="LUK 8:7" /><verse number="8" style="v" sid="LUK 8:8" />uδiysneθ zade elli uDaneθ g elqeεεeθ tebhe, nebbeθneθ eγeδneθ emnihenti myat merre.» max i yenne yesuwε wahen izeεweg: «elli γers timedjiyn ywesle edj eyesl.»<verse eid="LUK 8:8" /></para>
  <para style="s">elfeyδeθ nelmθel</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 8:9" />encδent etlemδas f elmeεne nelmθele, <verse eid="LUK 8:9" /><verse number="10" style="v" sid="LUK 8:10" />yer fellasen: «xenyum yemmucawem essan nelHajeθ elli leεbaδ entessinenc elmemlxeθ nrebbi. emme elγirennum enHekkeyasen s lemθal: ereqben welzerrenc, eslen welfehmenc.<verse eid="LUK 8:10" /></para>
  <para style="s">efesser nelmθel nezzareε</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 8:11" />uwahen elmeεne nelmθel: &lt;ezzerriyεeθ netteθ δedwi nrebbi. <verse eid="LUK 8:11" /><verse number="12" style="v" sid="LUK 8:12" />elli weTTaneθ f eccafeθ nwebriδ nihnin delli sellen edwi nrebbi usiyn eyeddes ibliys yekkes edwidiyn seg ulewnensen bac e ttemnenc emenεen. <verse eid="LUK 8:12" /><verse number="13" style="v" sid="LUK 8:13" />welli weTTaneθ f leHgef nihnin delli sellen edwi nrebbi eqeblent unihnin ferHeniyn, emme elγersenc leεruwq, amnen qiqqi umax emjerben eθuĎan. <verse eid="LUK 8:13" /><verse number="14" style="v" sid="LUK 8:14" />welli weTTaneθ f eccuwk nihnin delli sellen edwi nrebbi emme θecγelten eddunyeθ s lehmumes dwelhas delεezzes usahen elγeltensen etĎabec. <verse eid="LUK 8:14" /><verse number="15" style="v" sid="LUK 8:15" />emme elli weTTaneθ g elqeεεeθ tebhe nihnin delli sellen g edwi nrebbi eHrzent g ulewnensen ibehhayen, egen elγelleθ eseθbaθensen.&gt;<verse eid="LUK 8:15" /></para>
  <para style="s">elmθel nelgaz</para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 8:16" />leHebbe Hette Hed eyceεεel elgaz yireDt s elmaεuwn ziyγ eθyeg seddu esriyr, emme eθiHuT g wemxan yeεle bac e θezren elli ettaδfen. <verse eid="LUK 8:16" /><verse number="17" style="v" sid="LUK 8:17" />εlexaTer elli yemmeHrez δeyemmezr welli yemmejHeδ δeθesnen leεbaδ. <verse eid="LUK 8:17" /><verse number="18" style="v" sid="LUK 8:18" />erreθ elbelennum max eθeslem edwi nrebbi, εlexaTer elli γers Haje δesyemmerni, welli γers Hette cey δesyemmekkes, Hette δelli yetteεlaki δegliys.»<verse eid="LUK 8:18" /></para>
  <para style="s">yemmes nyesuwε dewmeθnes</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 8:19" />teseδ yemmes nyesuwε demmeθnes, welgeddenc esawDen εlexaTer leεbaδ egget. <verse eid="LUK 8:19" /><verse number="20" style="v" sid="LUK 8:20" />yennes iyjen essisen: «yemmex demmeθnex bedden elberre exsen exezren.» <verse eid="LUK 8:20" /><verse number="21" style="v" sid="LUK 8:21" />yer fellasen: «yemme demmeθniyw nihnin delli sellen g edwi nrebbi exeδmen essis.»<verse eid="LUK 8:21" /></para>
  <para style="s">yesuwε eyhedde elεaSfeθ</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 8:22" />yelle as yini yesuwε g elfluwkeθ wiyδes etlemδas, yennasen: «heyyeθ, eneqDeε yeccafeθ tisent.» ebδen δeqeĎεen. <verse eid="LUK 8:22" /><verse number="23" style="v" sid="LUK 8:23" />yenεes yesuwε uθuyuwr essisen tefluwkθ. yenfex aDu yeqwe yebδe amen εuddi δeεebben elfluwkeθ, eδwlen g elxTer. <verse eid="LUK 8:23" /><verse number="24" style="v" sid="LUK 8:24" />eqerben etlamδe yyesuwε sikrent ennanes: «eyimuεellem! eyimuεellem! εuddi δenjaf!» yekker yenzer f waDu dlemwaj esegren teδwel eddunyeθ siyn tesger. <verse eid="LUK 8:24" /><verse number="25" style="v" sid="LUK 8:25" />yennasen yesuwε: «mani emmanenum?» ukδen esθeγrben, ennen ibeεDhum: «δ wiyn wahen? yetweSSe Hette g waDu delmuwj usellen g edwiys.»<verse eid="LUK 8:25" /></para>
  <para style="s">egelleb necyaĎen dweγraq nixenziyren</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 8:26" />ewDen yetwali ecciyreθ nijerrasiyyen, δimqabel ecceT neljliyl. <verse eid="LUK 8:26" /><verse number="27" style="v" sid="LUK 8:27" />max i yeggez yesuwε yelqeεεeθ yeεreDti eryaz seg θemuwreθ δiys ecyaĎen w ykan elyiriyDc edbac seg bekri, weliεemmerc g elHuwc, emme mabiyn iniylen. <verse eid="LUK 8:27" /><verse number="28" style="v" sid="LUK 8:28" />max i yezre yesuwε, izeεweg yemmeHδef f ikreεnes yen s elquwweθ neSSuθes: «ac ihemmek δiyye eyesuwε emmiys nrebbi eεellay! exmelge eyeθεeδbec.» <verse eid="LUK 8:28" /><verse number="29" style="v" sid="LUK 8:29" />yenne wahen εlexaTer yesuwε yennayes yerruwH temenzuwsθ eθeffeγ seg eryaz. w ykan diyme etteθmellaxi erruwH temenzuwsθ usiyn ebδen leεbaδ δeθeTfen bac e θeqnen s eslasel dimne, emme ykan diyme inekkeD g imne usiyn eθisuq ecciyĎan yelxle. <verse eid="LUK 8:29" /><verse number="30" style="v" sid="LUK 8:30" />yenceδt yesuwε: «max ellesmex?» yer felles: «eljiyc.» εlexaTer uδefen δiys ecyaĎen egget. <verse eid="LUK 8:30" /><verse number="31" style="v" sid="LUK 8:31" />mellegnes yyesuwε bac e nyetgellebc yiddar. <verse eid="LUK 8:31" /><verse number="32" style="v" sid="LUK 8:32" />elweqθes kanen ellan eccebεeθ δiHellef retεen g eddehreθ, cawrent bac e θeδfen δiysen, yedjiyn. <verse eid="LUK 8:32" /><verse number="33" style="v" sid="LUK 8:33" />efγen ecyaĎen seg eryaz eδfen g iHellaf, erwlen iHellaf ettezlen seg iddar yelγδiyr eγerqen diyn. <verse eid="LUK 8:33" /><verse number="34" style="v" sid="LUK 8:34" />max i zriyn iniylten elli ySar, erwelen encren elxber g lemden ettimuwre. <verse eid="LUK 8:34" /><verse number="35" style="v" sid="LUK 8:35" />efγen leεbaδ bac e reqben δmette iySar. esδen yyesuwε, efen eryaz elli effeγen essis ecyaĎen ygeεmez yetwali ikraεεen nyesuwε, yireD, δelεaqel, ukδen. <verse eid="LUK 8:35" /><verse number="36" style="v" sid="LUK 8:36" />eHkenasen leεbaδ elli kanen diyn max i θysebre yesuwε, <verse eid="LUK 8:36" /><verse number="37" style="v" sid="LUK 8:37" />ennanes midden ijerrasiyyen elkulhum yebεeδ fellasen εlexaTer ukkeδen egget. yini g elfluwkeθ yeδwel esyiyn. <verse eid="LUK 8:37" /><verse number="38" style="v" sid="LUK 8:38" />emme eryaz elli effeγen essis ecyaĎen imelges yyesuwε bac e θyawi iyδes. welyeqbiylec yesuwε, yennes: <verse eid="LUK 8:38" /><verse number="39" style="v" sid="LUK 8:39" />«eδwel yelHucex teHkiδasen s elli yegeyaxθ rebbi.» yexDem eryazdiyn yHekke g temuwreθ elkul s elli yegeyasθ yesuwε.<verse eid="LUK 8:39" /></para>
  <para style="s">yelliys nyayrus ettmeTTuwθ elli tlemmes yesuwε seg edbeces</para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 8:40" />max i yeδwel yesuwε eεerDent leεbaδ elkul εlexaTer kanen etrajen δiys. <verse eid="LUK 8:40" /><verse number="41" style="v" sid="LUK 8:41" />nette siyn yesδes eryaz ellesmes yayrus, emeqqar nelmejmeε, yemmeHδef f ikraεen nyesuwε imelges bac e yaδef elHuces, <verse eid="LUK 8:41" /><verse number="42" style="v" sid="LUK 8:42" />εlexaTer γers tefruwxθ icθ elεemres eθnac nesne, εuddi eθjaf. unette maci γaSrent leεbaδ. <verse eid="LUK 8:42" /><verse number="43" style="v" sid="LUK 8:43" />weθkan diyn temeTTuwθ γers enziyf seg eθnac nesne, teSref elli γers elkul f iĎbiyben weliged Hette iyjen etysebre, <verse eid="LUK 8:43" /><verse number="44" style="v" sid="LUK 8:44" />teqreb yyesuwε s δeffer tlemmes eTTerf nedbeces, bedden iδammen g elweqθes. <verse eid="LUK 8:44" /><verse number="45" style="v" sid="LUK 8:45" />yen yesuwε: «δ wiyn eyyilemmes?» enkren elkul, yen buTrus: «eyimuεellem, leεbaδ elkul etγeSaren δiyx uθeqqareδ δ wiyn eyyilemmes?» <verse eid="LUK 8:45" /><verse number="46" style="v" sid="LUK 8:46" />yen yesuwε: «elziwiyn eyyilemmes εlexaTer Husse s elquwweθ teffeγ essi.» <verse eid="LUK 8:46" /><verse number="47" style="v" sid="LUK 8:47" />max i θezre temeTTuwtdiyn elli yesuwε ifaq essis, tuseδes treggel temmeHδef f ikreεnes tennes ezzaθ nleεbaδ elkul imat itlemmes umax i θebre g elweqθes. <verse eid="LUK 8:47" /><verse number="48" style="v" sid="LUK 8:48" />yennes: «eyelli, elimenem ymenεam, berre g eslam.» <verse eid="LUK 8:48" /><verse number="49" style="v" sid="LUK 8:49" />unette iδukke, yuseδ emersal seg emeqqar nelmejmeε yen: «yelliyx eθjaf muc lazem eθqelqeδ imuεellem.» <verse eid="LUK 8:49" /><verse number="50" style="v" sid="LUK 8:50" />yesl yesuwε, yennes yyayrus: «eθukδec! emmen berk uture eθemneε yelliyx.» <verse eid="LUK 8:50" /><verse number="51" style="v" sid="LUK 8:51" />max i yiweD yelHuwc, elyedjiyc leεbaδ eθeδfen, kan δbuTrus dyuwHenna dyeεquwb ddaddes ntefruwxθ dyemmes. <verse eid="LUK 8:51" /><verse number="52" style="v" sid="LUK 8:52" />leεbaδ elkul kanen tεeyĎen unedben f tefruwxθ. yennasen: «eθεeyĎemc, tefruwxθ eltjafc, emme tenεes.» <verse eid="LUK 8:52" /><verse number="53" style="v" sid="LUK 8:53" />eSSen f elles, εlexaTer kanen essenen elli netteθ eθjaf. <verse eid="LUK 8:53" /><verse number="54" style="v" sid="LUK 8:54" />yeTTef tefruwxtdiyn seg wefuses izeεweg felles: «ekker eθefruwxθ!» <verse eid="LUK 8:54" /><verse number="55" style="v" sid="LUK 8:55" />teδwles erruHes tekker g elweqθes, yennasen ettessečen. <verse eid="LUK 8:55" /><verse number="56" style="v" sid="LUK 8:56" />esθeγerben midnes, iweSSaθen bac e lHekken yHette Hed elli ySar.<verse eid="LUK 8:56" /></para>
  <chapter eid="LUK 8" />
  <chapter number="9" style="c" sid="LUK 9" />
  <para style="s">yesuwε eyazen etlemδas leθnac</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 9:1" />usiyn inabe yesuwε etlemδas leθnac yucasen elquwweθ f ecyaĎen elkul delquδreθ f usebri seg eTTaneθ elkul, <verse eid="LUK 9:1" /><verse number="2" style="v" sid="LUK 9:2" />yezenten bac e becren s elmemlxeθ nrebbi eSSebren imuwĎan. <verse eid="LUK 9:2" /><verse number="3" style="v" sid="LUK 9:3" />yennasen: «eθewyem Hette cey ywebriδennum: la etteγriyθ, ziyγ ettecxarθ, ziyγ δeγrum, ziyγ δlefluws, weθegemc sent δelqeĎεaθ ywariδ. <verse eid="LUK 9:3" /><verse number="4" style="v" sid="LUK 9:4" />welHuwc elli etteδfem, eqqiymeθ diyn, elmeθerHlem esyiyn. <verse eid="LUK 9:4" /><verse number="5" style="v" sid="LUK 9:5" />utemuwreθ elli exenqeblenc midnes, efγeθ essis teferDem tγuwbret seg ikreεnennum δeccehδeθ fellasen.» <verse eid="LUK 9:5" /><verse number="6" style="v" sid="LUK 9:6" />efγen etlamδe enden g timuwre etbecren g elbcareθ weSSebran g imuwDan.<verse eid="LUK 9:6" /></para>
  <para style="s">elHiyreθ nhiyruwdus</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 9:7" />yesl hiyruwdus elwali s elli ySar elkul, yeθHerre εlexaTer lebHaD nleεbaδ kanen eqqaren: «yuwHenna yekker seg inemmitte.» <verse eid="LUK 9:7" /><verse number="8" style="v" sid="LUK 9:8" />uleεbaδ xlaf eqqaren: «iliyya yeffeγ elmerreθ xlaf!» welγirensen yeqqar: «enbi seg iqδiymen yekker.» <verse eid="LUK 9:8" /><verse number="9" style="v" sid="LUK 9:9" />yaxi yen hiyruwdus: «yuwHenna neč ebbiyγes ixfes, δ wiyn wahen elli Hekken felles ziyγ?» yeĎleb bac e θyezer.<verse eid="LUK 9:9" /></para>
  <para style="s">yesuwε eyceč xemse laf rajel</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 9:10" />max i δuwlen imersal eHkanes yyesuwε elli egint elkul, yewiyθen ytemuwreθ ellesmes biytSeyda bac e yebεeδ essisen f leεbaδ. <verse eid="LUK 9:10" /><verse number="11" style="v" sid="LUK 9:11" />eslen leεbaδ eθbεent, yeεreDten yeHkeyasen f elmemlxeθ nrebbi, ysebre imuwDan elli iyδsen. <verse eid="LUK 9:11" /><verse number="12" style="v" sid="LUK 9:12" />tebδe tefuwθ etteggez, eqrebnes etlamδe leθnac ennanes: «azen leεbaδe bac e xeDmen ytimuwre dijiyman elli qreben, eneεsen diyn efen δmette δečen, εlexaTer nečin g elxle.» <verse eid="LUK 9:12" /><verse number="13" style="v" sid="LUK 9:13" />yer fellasen: «ucmasen xenyum bac e čen.» ennen: «γenne kan xemse ettineεne dsent ettiHwiyθin, ukan texseδ enexDem nesγ eče yleεbaδe elkul.» <verse eid="LUK 9:13" /><verse number="14" style="v" sid="LUK 9:14" />kanen εuddi xemse laf rajel. yen yesuwε yetlemδas: «esgeεmzenten ettikučaθin ettikučaθin, kul icθ δiys xemsiyn.» <verse eid="LUK 9:14" /><verse number="15" style="v" sid="LUK 9:15" />esgeεmzenten emmax i senyenne. <verse eid="LUK 9:15" /><verse number="16" style="v" sid="LUK 9:16" />yeTTef tineεnediyn dsentediyn ntiHwiyθin yqam tiTTewines lennej ibarex δiysen ikesserθen yuwcin yetlemδas bac e nferqen f leεbaδ elkul. <verse eid="LUK 9:16" /><verse number="17" style="v" sid="LUK 9:17" />ečen elkulhum elδecebεen, laymen etlamδe eθnac ettisiyfes seg elli yefDel.<verse eid="LUK 9:17" /></para>
  <para style="s">buTrus eyecheδ s elHqiyqeθ nyesuwε</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 9:18" />telle tikkelt yesuwε yezzal weHδes wetlamδe iyδes, yenceδten: «δ wiyn izerren δiyye leεbaδ?» <verse eid="LUK 9:18" /><verse number="19" style="v" sid="LUK 9:19" />erren felles: «yuwHenna elmeεmdan. emme ellan elli eqqaren, &lt;iliyya.&gt; wellan xlaf elli eqqaren, enbi seg iqδiymen yekker.» <verse eid="LUK 9:19" /><verse number="20" style="v" sid="LUK 9:20" />yennasen yesuwε: «uγerwem xenyum, δ wiyn neč?» yer felles buTrus: «elmesiyH nrebbi.»<verse eid="LUK 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 9:21" />inebbeh fellasen yesuwε bac e lleqqaren yHette Hed.<verse eid="LUK 9:21" /></para>
  <para style="s">yesuwε eyeθnebbe s temettentes dwekkeres</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 9:22" />yennasen: «bnaδem yelzem eyeθwejjeε egget, wiwessaren dimeqqaren nelkuhhan dimuεelmen necceriyεeθ eθqeblenc, weyemmenγ, usiyn uggas eθθaleθ eyekker seg ilemmitte.» <verse eid="LUK 9:22" /><verse number="23" style="v" sid="LUK 9:23" />yen yleεbaδ elkul: «elli yexs eyyeθbeε yelzem eyenker imenes yqam eSlibes (eyHeDDer imenes Hette ytemettent) kul yuwm yeθbεiyδ. <verse eid="LUK 9:23" /><verse number="24" style="v" sid="LUK 9:24" />εlexaTer elli yexs eymenneε leHyeθes etyexser, welli eyexser leHyeθes f elxeĎriyw ettimenneε. <verse eid="LUK 9:24" /><verse number="25" style="v" sid="LUK 9:25" />δmette δeyerbeH elεebδ max eyerbeH eddunyeθ elkul yexser imenes ziyγ yehlext? <verse eid="LUK 9:25" /><verse number="26" style="v" sid="LUK 9:26" />elli eyesθεar essi dedwiyw, δeyesθεar essis bnaδem as elli eyeddes g elmejδes delmejδ ndadde delmlayxe eTTuhhar. <verse eid="LUK 9:26" /><verse number="27" style="v" sid="LUK 9:27" />exennenne elHeq: yelle essiywem δ wiyn elyetjafc kan eyzer elmemlxeθ nrebbi.»<verse eid="LUK 9:27" /></para>
  <para style="s">eθjelle</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 9:28" />beεεeδ edwiye s eθmenye eyyam yesuwε yiwi iyδes buTrus dyuwHenna dyeεquwb yali yeddehreθ bac e yezzal. <verse eid="LUK 9:28" /><verse number="29" style="v" sid="LUK 9:29" />unette yetzalle yembeddel uδmes eδwlen edbeces δimellalen lemεen. <verse eid="LUK 9:29" /><verse number="30" style="v" sid="LUK 9:30" />ebδen sen δiryazen dukken yyesuwε, muwse diliyya, <verse eid="LUK 9:30" /><verse number="31" style="v" sid="LUK 9:31" />elli effeγen g elmejδ ebδen dukken max yelzem eyjaf yesuwε g uwrceliym bac e θekmel elquδreθ nrebbi. <verse eid="LUK 9:31" /><verse number="32" style="v" sid="LUK 9:32" />buTrus deSSuHHabes yeγlebθen enuddem, emme faqen ezren elmejδes diryazen elli bedden iyδes. <verse eid="LUK 9:32" /><verse number="33" style="v" sid="LUK 9:33" />qebl eθedjen exeDmen yennayes buTrus: «imuεellem, mesmeH eqqiymi iyδex. edj eneg tlaθe ettiĎelliylin, icθ icex wicθ ymuwse wicθ yiliyya.» ykan elyessiync δmette iyeqqar. <verse eid="LUK 9:33" /><verse number="34" style="v" sid="LUK 9:34" />buTrus elyuwc yHekke teseδ esHabeθ teg fellasen eTTel, ukδen etlamδe max i θuδfen g esHabeθ. <verse eid="LUK 9:34" /><verse number="35" style="v" sid="LUK 9:35" />yeffeγ edwi seg esHabeθ, yen: «δwahen memmi elli exθeraθ, esleθ edwiys!» <verse eid="LUK 9:35" /><verse number="36" style="v" sid="LUK 9:36" />beεεeδ edwidiyn zriyn yesuwε weHδes esegren welleHkiyn yHette Hed g liyyamdiyn elli zrint.<verse eid="LUK 9:36" /></para>
  <para style="s">yesuwε eysebre eεezri δiys erruwH ettemenzuwsθ</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 9:37" />elweječe eggezen seg eddehreθ, eεerDent leεbaδ egget. <verse eid="LUK 9:37" /><verse number="38" style="v" sid="LUK 9:38" />izeεweg eryaz essisen: «imuεellem, erqeb memmi elli γeri kan ennette, <verse eid="LUK 9:38" /><verse number="39" style="v" sid="LUK 9:39" />etteθmellaxi erruwH ettemenzuwsθ s etzeεwiygeθ teεle, usiyn ettessender elδayeg tixecxuwcin, wettetseyyeb kan ettesseεye tedji δimreDreD. <verse eid="LUK 9:39" /><verse number="40" style="v" sid="LUK 9:40" />enγasen yetlemδax eθgelben yaxi elgeddenc ettessuwfγen.» <verse eid="LUK 9:40" /><verse number="41" style="v" sid="LUK 9:41" />yer fellasen yesuwε: «melle δeljiyl δelfaseδ elyettemmenc! ellemmi δeqqiyme iyδwem? usinc eSebre fellawem? eγeδ memmiyx eldahen.» <verse eid="LUK 9:41" /><verse number="42" style="v" sid="LUK 9:42" />max i yebδe efruwxdiyn yqerreb yyesuwε, yeSreεθ ecciyĎan yessenderθ. yenzer felles yesuwε, teffeγ erruwH temenzuwsθ yebre efruwxdiyn yuwci ydaddes. <verse eid="LUK 9:42" /><verse number="43" style="v" sid="LUK 9:43" />esθeγerben elli HeDren elkul seg elquδreθ nrebbi temeqqarθ. unihnin δimesθeγerben seg elli yegi yesuwε, elweqθes yenne yetlemδas:<verse eid="LUK 9:43" /></para>
  <para style="s">yesuwε eyeθnebbe elmerreθ xlaf s temettentes</para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 9:44" />«esleθ eSbiyH elli δexentenne, bnaδem δeyemmuwc yifassen nleεbaδ.» <verse eid="LUK 9:44" /><verse number="45" style="v" sid="LUK 9:45" />yemenni ellefhimenc edwiys, ykan yemmeHrez fellasen bac e θfehmenc, wukkeδen eθencδen felles.<verse eid="LUK 9:45" /></para>
  <para style="s">δ wiyn nette emeqqar</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 9:46" />emεanden δ wiyn emeqqar δiysen. <verse eid="LUK 9:46" /><verse number="47" style="v" sid="LUK 9:47" />yexez yesuwε elli g ulewnensen, igewweδ efruwx yesgeεmezθ g eljenbes, <verse eid="LUK 9:47" /><verse number="48" style="v" sid="LUK 9:48" />yennasen: «elli eyeqbel efruwxe f ellesmiyw eyyeqbel, welli eyyeqbel eyeqbel elli yuzeniyδ, εlexaTer imeθwaDeε δiywem ennette emeqqerennum.»<verse eid="LUK 9:48" /></para>
  <para style="s">elli yetkuwnc fellawem rahu iyδwem</para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 9:49" />yen yuwHenna: «imuεellem, nezre eryaz yetgelleb g ecyaĎen s ellesmex weθnedjiyc εlexaTer exyθebbeεc iyδne.» <verse eid="LUK 9:49" /><verse number="50" style="v" sid="LUK 9:50" />yennes yesuwε: «edjemt, εlexaTer elli muc fellawem rahu iyδwem.»<verse eid="LUK 9:50" /></para>
  <para style="s">elqeryeθ ettesamriθ eltqabbelc yesuwε</para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 9:51" />max i yiweD elweqθ elli δeyεali δiys yesme, yeεzem uffaxDem yuwrceliym. <verse eid="LUK 9:51" /><verse number="52" style="v" sid="LUK 9:52" />yuzen imersal ezzeθes, exeDmen eδfen θemuwreθ nisamriyyen (meεnahe muc δyehuwdi δuSHiH) bac e sHeDren elli eθyelzem. <verse eid="LUK 9:52" /><verse number="53" style="v" sid="LUK 9:53" />yaxi midden ntemuwretdiyn elleqqilenc eθeqblen εlexaTer ykan maci yuwrceliym. <verse eid="LUK 9:53" /><verse number="54" style="v" sid="LUK 9:54" />max i zriyn etlemδas, yeεquwb dyuwHenna, wediyn ennan: «ya siydiy, texseδ esnen yelεafyeθ eθeggez seg esme θečiyn?» <verse eid="LUK 9:54" /><verse number="55" style="v" sid="LUK 9:55" />yebren yenzer fellasen, «eltessinemc seg menten erruwH xenyum, <verse eid="LUK 9:55" /><verse number="56" style="v" sid="LUK 9:56" />εlexaTer bnaδem wedyusiyc bac e yehlex ennefs nleεbaδ emme bac e ntiSaleH.» exeDmen ytemuwreθ xlaf.<verse eid="LUK 9:56" /></para>
  <para style="s">yesuwε yemmes neddunyeθ</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 9:57" />unihnin egguwren, yennayes eryaz: «ya siydiy, exeθbεe elmeniy eθexDmeδ.» <verse eid="LUK 9:57" /><verse number="58" style="v" sid="LUK 9:58" />yer felles yesuwε: «eθεaleb γersen lemnaε, wizenniywen nesme γersen leεcuwc, emme bnaδem leγrec meni eyHuT ixfes.» <verse eid="LUK 9:58" /><verse number="59" style="v" sid="LUK 9:59" />yen yesuwε yweryaz xlaf: «eθbεiyδ!» yer felles: «ya siydiy, edjiyδ exeDme ereδme dadde qebl.» <verse eid="LUK 9:59" /><verse number="60" style="v" sid="LUK 9:60" />yennes yesuwε: «edj inemmitte ereδmen inemmittensen, emme cex berre beccer s elmemlxeθ nrebbi.» <verse eid="LUK 9:60" /><verse number="61" style="v" sid="LUK 9:61" />yennes iyjen xlaf: «exeθbεe ya siydiy, emme edjiyδ ebeqqiyγ qebl midniyw s elxiyr.» <verse eid="LUK 9:61" /><verse number="62" style="v" sid="LUK 9:62" />yennes yesuwε: «elli eyHuT ifesnes f elgulli yebren eldeffer liSelleHc yelmelx nrebbi.»<verse eid="LUK 9:62" /></para>
  <chapter eid="LUK 9" />
  <chapter number="10" style="c" sid="LUK 10" />
  <para style="s">yesuwε eyazen essebεiyn</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 10:1" />beεεeδ wahen yexθar seyyedne yesuwε θniyn usebεiyn xlaf yezenten ezzeθes zwaz ikul θemuwreθ dumxan yexs esyexDem. <verse eid="LUK 10:1" /><verse number="2" style="v" sid="LUK 10:2" />yennasen: «imendi egget emme ixeddamen δruws, eDelbeθ seg erreb nimendi eyazen leεbaδ yimendiys. <verse eid="LUK 10:2" /><verse number="3" style="v" sid="LUK 10:3" />berreθ, tay δexennezne emiεellec uggemmes nuccaneθ. <verse eid="LUK 10:3" /><verse number="4" style="v" sid="LUK 10:4" />tqamem la teSriyrθ nlefluws, la δisiyres, la δeSSendal, weθselmem f Hette Hed uggebriδ. <verse eid="LUK 10:4" /><verse number="5" style="v" sid="LUK 10:5" />welHuwc elli etteδfem, enneθ qebl, &lt;esselam f elHuwce.&gt; <verse eid="LUK 10:5" /><verse number="6" style="v" sid="LUK 10:6" />kan δiys δ wiyn yexs esselam, eslemennum eyeggez felles, ukan la, δeyeδwel yxenyum. <verse eid="LUK 10:6" /><verse number="7" style="v" sid="LUK 10:7" />eqqiymeθ g elHuwcdiyn, ettettem eθsessem s elli γersen, εlexaTer exeddam yelzem eyawi elHeqqes, weθbedlemc seg elHuwc yelHuwc. <verse eid="LUK 10:7" /><verse number="8" style="v" sid="LUK 10:8" />utemuwreθ elli etteδfem eqbelnawem midnes, ečeθ seg elli δexennuwcen. <verse eid="LUK 10:8" /><verse number="9" style="v" sid="LUK 10:9" />teSSebrem imuDenensen tennem: elmemlxeθ nrebbi yeqreb yetwelinnum. <verse eid="LUK 10:9" /><verse number="10" style="v" sid="LUK 10:10" />yemenni θemuwreθ elli etteδfem wexenqeblenc midnes, efγeθ ylenhjas tennem: <verse eid="LUK 10:10" /><verse number="11" style="v" sid="LUK 10:11" />&lt;Hette ettγuwbret ntemurθennum elli telseq g ikreεnenne δetnefreδ f uδmewnennum. emme eykuwn f elεelmennum elli elmemlxeθ nrebbi teqreb.&gt; <verse eid="LUK 10:11" /><verse number="12" style="v" sid="LUK 10:12" />exennenne: as xlaf s eduwm δetemmerHem exθer ntemuwretdiyn.<verse eid="LUK 10:12" /></para>
  <para style="s">lemden θelkuwffar</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 10:13" />yeHliylek ekuwrziyn! yeHliylek ebiytSeyda! lukan elmuεjzaθ elli Sarneθ fellaxmeθ Sarneθ f Suwr dSeyda, rahu ellan midnensneθ taben seg bekri irDen elmsuwH eqqiymen f iyγeD. <verse eid="LUK 10:13" /><verse number="14" style="v" sid="LUK 10:14" />emme as xlaf Suwr dSeyda δemmerHemneθ exθrennum. <verse eid="LUK 10:14" /><verse number="15" style="v" sid="LUK 10:15" />ucem ekefernaHuwm! ettelyeδ lennej? yelεafyeθ δeθegzeδ.» <verse eid="LUK 10:15" /><verse number="16" style="v" sid="LUK 10:16" />yen yesuwε yetlemδas: «elli exenyesseγδ yesseγδiyδ, welli exenyqebbelc eyyeqbiylc, welli eyyeqbiylc liqebbelc elli yuzeniyδ.»<verse eid="LUK 10:16" /></para>
  <para style="s">arjeε nsebεiyn</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 10:17" />eδwlen imersal leθniyn usebεiyn ferHeniyn ennen yyesuwε: «ya siydiy, Hette δecyaĎen sellen g edwinne s ellesmex.» <verse eid="LUK 10:17" /><verse number="18" style="v" sid="LUK 10:18" />yennasen: «zriyγ belyes yuDe seg esme emelberg. <verse eid="LUK 10:18" /><verse number="19" style="v" sid="LUK 10:19" />utay δexennuwce elquδreθ eθeεfsem essis f eθlefsiywin ettγuwrδem dkul quwweθ nelεδuwewwem belyes wexenyjerri Hette cey. <verse eid="LUK 10:19" /><verse number="20" style="v" sid="LUK 10:20" />emme eθeferHemc εlexaTer lerwaH selneθ g edwinnum, emme eferHeθ εlexaTer elliseminnum emmaryen g esmawaθ.»<verse eid="LUK 10:20" /></para>
  <para style="s">yesuwε eyefreH</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 10:21" />g esseεetdiyn yefreH yesuwε s erruwH nelqudus, yen: «SeHHiyt edda, rebbi nesme delqeεεeθ, εlexaTer tessexneδ yimezyanen (qelliylen) elli teHrezθ f elεuqqal d elqurray. wa, δwahen, edda, elli texset. <verse eid="LUK 10:21" /><verse number="22" style="v" sid="LUK 10:22" />dadde yucayiyδ kul cey. Hette Hed welyessin δ wiyn efruwx kan δdadde weδwiyn dadde kan δefruwx delli yexs efruwx esθyesxen.» <verse eid="LUK 10:22" /><verse number="23" style="v" sid="LUK 10:23" />yebren yetlemδas yennasen weHδasen: «SeHHe liyh elli eyzer elli tzerrem δiys! <verse eid="LUK 10:23" /><verse number="24" style="v" sid="LUK 10:24" />exennenne: egget lenbye dlemluwk eθmennan ezren elli tzerrem yemenni ellezrinc, weslen elli tsellem yemenni ellesliync.»<verse eid="LUK 10:24" /></para>
  <para style="s">elmθel nusamri eSSaleH</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 10:25" />utay yekker iyjen seg imuεelmen necceriyεeθ yennes bac e θijerreb: «eyimuεellem, δmette δege bac e θurθe edder diyme?» <verse eid="LUK 10:25" /><verse number="26" style="v" sid="LUK 10:26" />yer felles yesuwε: «δmette iθeqqar ecceriyεeθ nmuwse? umax δetfesreδ?» <verse eid="LUK 10:26" /><verse number="27" style="v" sid="LUK 10:27" />yen eryazdiyn: «exs rebbix s ulex elkul derruHex elkul delquδreθ elkul delfekrex elkul, weθexseδ elli yeqrebex emmax i θexseδ imenex.» <verse eid="LUK 10:27" /><verse number="28" style="v" sid="LUK 10:28" />yennes yesuwε: «edwiyx δuSHiH, eg wahen uture eθedreδ.» <verse eid="LUK 10:28" /><verse number="29" style="v" sid="LUK 10:29" />yaxi imuεellem necceriyεeθ yexs yessexne imenes elli nette δeSSaleH, yennes yyesuwε: «weδwiyn nette elli yeqrebiyδ?» <verse eid="LUK 10:29" /><verse number="30" style="v" sid="LUK 10:30" />yer felles yesuwε: «ykan yelle eryaz yeggez seg uwrceliym yeriyHa, eTfent iquδεiyyen, ekkesnes edbeces ewθent, usiyn edjint biyn Hya umuwt. <verse eid="LUK 10:30" /><verse number="31" style="v" sid="LUK 10:31" />beSSudfe yeθεedde elkahen esyiyn, max i θyezre yebεeδ felles ykemmel teyuriθes. <verse eid="LUK 10:31" /><verse number="32" style="v" sid="LUK 10:32" />zade iyjen seg ilawiyyen (meεnahe elli yxeddem g elHuwc nrebbi), yeθεedde umax i θyezre, yebεeδ felles yeθεedde f imenes. <verse eid="LUK 10:32" /><verse number="33" style="v" sid="LUK 10:33" />emme iyjen δsamri δimsafer yeθεedde esyiyn, max i θyezre yesxef felles. <verse eid="LUK 10:33" /><verse number="34" style="v" sid="LUK 10:34" />yeqreb yetweliys yenγles uwδi decrab f iyyezzimnes yeqnesθen, usiyn iqami f ezzeyeltes yewiθ yelfunduq yelhe essis. <verse eid="LUK 10:34" /><verse number="35" style="v" sid="LUK 10:35" />elweječe yenzeγ esamri elfiyn, yuwcin yiθbab nelfunduq yennes, &lt;elhe essis, welli δetteδfεeδ δezzayeδ δexettuwce max erewHe.&gt; <verse eid="LUK 10:35" /><verse number="36" style="v" sid="LUK 10:36" />δ menten seg tlaθaye yeqreb yelli yuDe g ifassen niquδεiyyen?» <verse eid="LUK 10:36" /><verse number="37" style="v" sid="LUK 10:37" />yer felles imuεellem necceriyεeθ: «elli yesxef felles.» yennes yesuwε: «berre eg emmax i yege.»<verse eid="LUK 10:37" /></para>
  <para style="s">yesuwε γer merta dmeryem</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 10:38" />elweqθelli nihnin egguwren, yuwδef yesuwε ytemuwreθ tefreH essis temeTTuwθ g elHuces ellesmes merta. <verse eid="LUK 10:38" /><verse number="39" style="v" sid="LUK 10:39" />weθkan γers weltmas ellesmes meryem, teqqiym yetwali ikraεεen nyesuwε tesseγδ g edwiys. <verse eid="LUK 10:39" /><verse number="40" style="v" sid="LUK 10:40" />merta eθkan ettaγδes g uHeDDer yeDyafeθ, teseδ tennes yyesuwε: «ya siydiy, eltlehhiyc max i yθedje weltme ceqqiyγ weHδi? ennes eyeθεawen.» <verse eid="LUK 10:40" /><verse number="41" style="v" sid="LUK 10:41" />yer felles yesuwε: «merta, merta, cem teγĎeseδ s elHwayej egget, <verse eid="LUK 10:41" /><verse number="42" style="v" sid="LUK 10:42" />yemenni elHajeθ icθ ettemesθHeqqe. meryem texθar elbay emeqqar elli eθyettekkes Hette Hed s γers.»<verse eid="LUK 10:42" /></para>
  <chapter eid="LUK 10" />
  <chapter number="11" style="c" sid="LUK 11" />
  <para style="s">tzalliθ yerreb</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 11:1" />yesuwε ykan yetzalle g wemxan, max i ykemmel yennayes iyjen seg etlemδas: «ya siydiy, esseHfĎane enezzal, emmax i yeSSeHfeD yuwHenna etlemδas.» <verse eid="LUK 11:1" /><verse number="2" style="v" sid="LUK 11:2" />yennasen yesuwε: «max eθezzallem enneθ: edda, eyemqeddes ellesmex, elmemlekθex δeθeddes. <verse eid="LUK 11:2" /><verse number="3" style="v" sid="LUK 11:3" />ucane eγrumenne kul yuwm, <verse eid="LUK 11:3" /><verse number="4" style="v" sid="LUK 11:4" />teγferδane leδnubenne, εlexaTer netsameH kul iyjen eyeγleĎ g elHeqqenne, wexentessuδfec g ucerreb.» <verse eid="LUK 11:4" /><verse number="5" style="v" sid="LUK 11:5" />usiyn yennasen yesuwε: «elli essiywem γers emedduwkel usiyn esyexDem uggezyen niyD yennes, &lt;erĎliyδ tlaθe ettineεne, eyenje, <verse eid="LUK 11:5" /><verse number="6" style="v" sid="LUK 11:6" />εlexaTer γeri emedduwkel yrewweH seg esfer welγriyc eγrum bac e sθHuTTe.&gt; <verse eid="LUK 11:6" /><verse number="7" style="v" sid="LUK 11:7" />ayer felles emeddukles seg wemmes nelHuwc, &lt;eyeθqelqec elbab yemsekker widreriyw iyδi g esriyr, elgeddac ekre bac e xuwce.&gt; <verse eid="LUK 11:7" /><verse number="8" style="v" sid="LUK 11:8" />exennenne: iδekan elyettekkerc bac e syuwc εlexaTer δemeddukles, rahu δeyekker yuwces elli yexs elkul εlexaTer yqelleqθ egget uggeĎleb. <verse eid="LUK 11:8" /><verse number="9" style="v" sid="LUK 11:9" />usahen exennenne: eDelbeθ eθewyem, encδeθ eθafem, δuqqeθ elbab exenyemmiyr. <verse eid="LUK 11:9" /><verse number="10" style="v" sid="LUK 11:10" />εlexaTer elli eyenceδ eyewi, welli eyeĎleb ayef, welli eyδuq elbab esyemmiyr. <verse eid="LUK 11:10" /><verse number="11" style="v" sid="LUK 11:11" />δ wiyn essiywem esyen memmis uciyδ teHwiyt esyuwc g wemxenes telefse? <verse eid="LUK 11:11" /><verse number="12" style="v" sid="LUK 11:12" />ziyγ esyen uciyδ teεDemt esyuwc tγerδemt? <verse eid="LUK 11:12" /><verse number="13" style="v" sid="LUK 11:13" />iδekan xenyum imuHacen tessenem max eθgeddem ewce yidrerinnum, menyeθ exθer daddeθwem elli g esme δeyuc erruwH nelqudus yelli Ďelben δiys?»<verse eid="LUK 11:13" /></para>
  <para style="s">yesuwε δbeεlzbuwl</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 11:14" />w ykan yetgelleb g ecciyĎan δebekkuwc. max i yeffeγ ecciyĎan yuθley eryaz, esθeγerben leεbaδ. <verse eid="LUK 11:14" /><verse number="15" style="v" sid="LUK 11:15" />ennen qiqqi essisen: «nette yetgelleb g ecyaĎen s beεlzbuwl, emeqqar necyaĎen.» <verse eid="LUK 11:15" /><verse number="16" style="v" sid="LUK 11:16" />eĎlben iddiynni ellayeθ seg esme bac e θjerben. <verse eid="LUK 11:16" /><verse number="17" style="v" sid="LUK 11:17" />yexez exememensen, yennasen: «kul elmemlxeθ eθemzuwn eθexreb uDan leHweces iyjen s iyjen. <verse eid="LUK 11:17" /><verse number="18" style="v" sid="LUK 11:18" />teqqarem elli s beεlzbuwl etgelbe g ecyaĎen, max eyemzuwn belyes, max δeθeqqiym elmemlexθes? <verse eid="LUK 11:18" /><verse number="19" style="v" sid="LUK 11:19" />iδekan s beεlzbuwl etgelbe g ecyaĎen, s wiyn δengelben elli δeddasen beεδennum? ecehδen f elγelTTewwem. <verse eid="LUK 11:19" /><verse number="20" style="v" sid="LUK 11:20" />wiδekan s weDaD nrebbi etgelbe g ecyaĎen rahu elmemlxeθ nrebbi tusδawem. <verse eid="LUK 11:20" /><verse number="21" style="v" sid="LUK 11:21" />eryaz elli yeqwe uγers eslaH δelkamel, max eyεus f elHuces, elmelxes ebδen g ellamen. <verse eid="LUK 11:21" /><verse number="22" style="v" sid="LUK 11:22" />emme iδekan ihejemt eryaz eqwas yeγlebθ, esyekkes esleHes elli yetteθεemmeδ f elles iferreq elli yeksesθ. <verse eid="LUK 11:22" /><verse number="23" style="v" sid="LUK 11:23" />elli muc iyδi rahu felle, welli elyetleyiymc iyδi rahu yetneTTer.<verse eid="LUK 11:23" /></para>
  <para style="s">arjeε nerruwH temenzuwsθ</para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 11:24" />max eθeffeγ erruwH temenzuwsθ seg elεebδ eθenneD g elxle etHewwem g erraHeθ. umax ettettafc eθen, &lt;eδuwle yelHuwc elli effeγe essis.&gt; <verse eid="LUK 11:24" /><verse number="25" style="v" sid="LUK 11:25" />umax eθeδwel ettef δimneĎĎef uδimretteb. <verse eid="LUK 11:25" /><verse number="26" style="v" sid="LUK 11:26" />eyexDem yaγeδ iyδes sebεe erwaH uHces, eδfen εemren δiys, teδwel elHal nweryazdiyn g ellexres uwHec numezweres.»<verse eid="LUK 11:26" /></para>
  <para style="s">elferHeθ teHeqqaniθ</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 11:27" />elweqθelli nette iδukke, tzeεweg temeTTuwθ seg eljmaεetdiyn ten: «SeHHe liyhe temeTTuwθ elli tirewex tessesfex.» <verse eid="LUK 11:27" /><verse number="28" style="v" sid="LUK 11:28" />yen yesuwε: «εaδ, SeHHe yelli eyesl edwi nrebbi yexδem essis.»<verse eid="LUK 11:28" /></para>
  <para style="s">eljmaεeθ eDelben ellayeθ</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 11:29" />exeθren leεbaδ, yebδe yeqqar: «eljiyle δeljiyl δelfaseδ, Ďelben g ellemareθ, wesenyemmettuwc kanc δellemareθ nenbi yuwnan. <verse eid="LUK 11:29" /><verse number="30" style="v" sid="LUK 11:30" />w emmax ykan enbi yuwnan δellemareθ ymidden enniynwa, δeyeδwel bnaδem elli neč yexθari rebbi δellemareθ yeljiyle. <verse eid="LUK 11:30" /><verse number="31" style="v" sid="LUK 11:31" />elmelikeθ neljenuwb eθekker δeljiyle as nelHsab teHkem felles, εlexaTer tuseδ seg ellexxer neddunyeθ bac e θesl elHekmeθ nsliyman, uture dahen mekber nsliyman. <verse eid="LUK 11:31" /><verse number="32" style="v" sid="LUK 11:32" />umidden enniynwa ekren δeljiyle as nelHsab eHekmen felles, εlexaTer sliyn enebbeh nyuwnan taben, udahen ture mekber nyuwnan.<verse eid="LUK 11:32" /></para>
  <para style="s">tiT tefuwθ nelbδen</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 11:33" />leHebbe Hette Hed eyceεεel elgaz eθyeHrez welle eθiHuT seddu nelkiyleθ, emme eθiHuT g wemxan yeεle bac e yDewwe f elli ettaδfen. <verse eid="LUK 11:33" /><verse number="34" style="v" sid="LUK 11:34" />tiTTex elgaz nelbeδnex. max eθebδe tiTTex ettuSHiyHθ, eyebδe elbeδnex elkul yetDewwe. umax eθeδwel tiTTex etmaDunt, eyebδe elbeδnex elkul etsallesθ. <verse eid="LUK 11:34" /><verse number="35" style="v" sid="LUK 11:35" />er elbalex bac e ddukkelc tefuwθ elli δiyx etsallesθ. <verse eid="LUK 11:35" /><verse number="36" style="v" sid="LUK 11:36" />kan elbeδnex elkule yetDewwe weddiyc tsellesθ, eyDewwe emmax exyDewwe elgaz.»<verse eid="LUK 11:36" /></para>
  <para style="s">yesuwε eyeεrex ifarisiyyen dimuεelmen necceriyεeθ</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 11:37" />unette iδukke, inebaθ iyjen seg elHezb nifarisiyyen yelfĎuwr γers. yaδef elHuces yeqqiym yweče. <verse eid="LUK 11:37" /><verse number="38" style="v" sid="LUK 11:38" />yesθeγreb efariysi max i yezre yesuwε yeqqiym δeyeč welyessireδc ifesnes. <verse eid="LUK 11:38" /><verse number="39" style="v" sid="LUK 11:39" />yennes seyyedne yesuwε: «xenyum elHezb nifarisiyyen tesseraδem elkas deSHen s berre, welbeδnennum eljaj elkule deTmeε delxubθ. <verse eid="LUK 11:39" /><verse number="40" style="v" sid="LUK 11:40" />eyiδerwiycen, wahen elli yege elli s berre, elyegiyc elli s ejjaj zade? <verse eid="LUK 11:40" /><verse number="41" style="v" sid="LUK 11:41" />uwceθ yiqelliylen seg elli g elkisenennum dleSHnennum, kul cey eyeδwel δundif yxenyum. <verse eid="LUK 11:41" /><verse number="42" style="v" sid="LUK 11:42" />emme yeHliylkum eyelHezb nifarisiyyen! ettuwcem elεcer nenneεnaε dezzeεTer delHcayec elkul, uθettewem aεδel d exse nrebbi. yelzem eθegem wahen menγiyr eθetwem wissen. <verse eid="LUK 11:42" /><verse number="43" style="v" sid="LUK 11:43" />yeHliylkum eyelHezb nifarisiyyen! texsem elblayeS tuggezzaθin g elmjameε detHaye g essaHaθ. <verse eid="LUK 11:43" /><verse number="44" style="v" sid="LUK 11:44" />yeHliylkum! xenyum eminiylen elli etmezriync, leεbaδ egguwren fellasen unihnin ellessinenc.» <verse eid="LUK 11:44" /><verse number="45" style="v" sid="LUK 11:45" />yennes iyjen seg imuεelmen necceriyεeθ: «eyimuεellem, cex s edwiye wahen etsubbeδ δiyne nečin zade.» <verse eid="LUK 11:45" /><verse number="46" style="v" sid="LUK 11:46" />yen: «yeHliylkum xenyum zade eyimuεelmen necceriyεeθ, etεebbem egget f leεbaδ wettezlemc eDaD iyjen bac e ntεawnem g uqeminsen. <verse eid="LUK 11:46" /><verse number="47" style="v" sid="LUK 11:47" />yeHliylkum, tHefrem g iniylen nlenbye weddaddeθwem elli nγinten. <verse eid="LUK 11:47" /><verse number="48" style="v" sid="LUK 11:48" />usahen eθecehδem f daddeθwem twefqemten f elli egint: nihnin enγiyn lenbye uxenyum teHfermasen inilnensen. <verse eid="LUK 11:48" /><verse number="49" style="v" sid="LUK 11:49" />f elxaĎer nsahen tenne elHekmeθ nrebbi, &lt;esennazne lenbye dimersal, enγen essisen εeδben,&gt; <verse eid="LUK 11:49" /><verse number="50" style="v" sid="LUK 11:50" />Hette δiδammen nlenbye elkul elli emmenγen seg elbδu neddunyeθ, δeyemHaseb f ellasen eljiyle, <verse eid="LUK 11:50" /><verse number="51" style="v" sid="LUK 11:51" />seg iδammen nhabiyl eliδammen nzekeriyya elli yemmenγ biyn elmeδbeH ettezeqqe nelqudus. iyh, δeHasbe eljiyle f iδammen niyh elkul! <verse eid="LUK 11:51" /><verse number="52" style="v" sid="LUK 11:52" />yeHliylkum eyimuεelmen necceriyεeθ! tiwiyem tenesθ nwassen, xenyum weltuδiyfem, welγirennum ettedjiymc eyaδef.» <verse eid="LUK 11:52" /><verse number="53" style="v" sid="LUK 11:53" />elweqθelli nette δeyeffeγ esyiyn, ernin elketiybeθ delHezb nifarisiyyen enqemen felles, ebδen necδen f elHwayej egget, <verse eid="LUK 11:53" /><verse number="54" style="v" sid="LUK 11:54" />wetrajen g tuθleyθ seg imiys bac e θetehmen essis.<verse eid="LUK 11:54" /></para>
  <chapter eid="LUK 11" />
  <chapter number="12" style="c" sid="LUK 12" />
  <para style="s">eSdaq delqelleθ ntixerxas</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 12:1" />g elweqtdiyn emlaymen laluf δleεbaδ elδeδuwlen εefsen g beεDhum, yen yesuwε yetlemδas qebl: «erreθ elbelennum seg elxmiyreθ nifarisiyyen elli nette ettixerxas. <verse eid="LUK 12:1" /><verse number="2" style="v" sid="LUK 12:2" />εlexaTer elli yemmeHrez δeyemmezr, welli yemmejHeδ δeyemmessen. <verse eid="LUK 12:2" /><verse number="3" style="v" sid="LUK 12:3" />welli δettennem g eθsellesθ δeθeslen leεbaδ g tefuwθ, welli δettennem s qiqqi g eθzeγwiyn δeberHen essis δenni lesquwf.<verse eid="LUK 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 12:4" />exennenne ha iSHibniyw: eθukδemc seg ihelli neqqen g elbδen usiyn elgedden egen Hette cey. <verse eid="LUK 12:4" /><verse number="5" style="v" sid="LUK 12:5" />emme tay δexennenne s wiyn δeθukδem: ukδeθ seg wehelli iged beεεeδ enγe eylewweH g elεafyeθ. iyh, exennenne, wahen ukδeθ essis. <verse eid="LUK 12:5" /><verse number="6" style="v" sid="LUK 12:6" />muc xemse δizanniwen etmanzen s zuwz suwrdi? leHebbe Hette iyjen essisen yetmettew γer rebbi. <verse eid="LUK 12:6" /><verse number="7" style="v" sid="LUK 12:7" />Hette δezew nixfewnennum yemmeHseb elkul. eθukδemc, xenyum xiyr negget δizanniwen. <verse eid="LUK 12:7" /><verse number="8" style="v" sid="LUK 12:8" />exennenne: elli eyesθeεref essi ezzaθ nleεbaδ, eyesθeεref essis bnaδem ezzaθ nelmlayxe nrebbi. <verse eid="LUK 12:8" /><verse number="9" style="v" sid="LUK 12:9" />yemenni elli elyettesθeεriyfc essi ezzaθ nleεbaδ, elyettesθeεriyfc essis bnaδem ezzaθ nelmlayxe nrebbi. <verse eid="LUK 12:9" /><verse number="10" style="v" sid="LUK 12:10" />welli eyen tuθleyθ f ebnaδem eyemsameH, emme elli δeyekfer f erruwH nelqudus elyettemsemiyHc. <verse eid="LUK 12:10" /><verse number="11" style="v" sid="LUK 12:11" />umax eθemmawyem yelmjameε delHukkam delli γersen elHkum, eθeqelqemc max δeθerrem f imenennum ziyγ δmette δeθennem, <verse eid="LUK 12:11" /><verse number="12" style="v" sid="LUK 12:12" />εlexaTer erruwH nelqudus δexenyen δmette δeθennem g elweqθes.»<verse eid="LUK 12:12" /></para>
  <para style="s">elmθel numuγni imSattek</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 12:13" />yennes eryaz seg leεbaδdiyn: «eyimuεellem ennes yenje eyzuwn iyδi elwerθeθ.» <verse eid="LUK 12:13" /><verse number="14" style="v" sid="LUK 12:14" />yennes: «eyeryaz, δ wiyn iyiHuT δelqaDi f ellawem ziyγ exenniyzun erziwwem?» <verse eid="LUK 12:14" /><verse number="15" style="v" sid="LUK 12:15" />ubeεεeδ yen yleεbaδ: «erreθ elbelennum seg eTmeε, elHyaθ nelεebδ muc g elmelxes egget.» <verse eid="LUK 12:15" /><verse number="16" style="v" sid="LUK 12:16" />yennasen elmθele: «ykan yelle eryaz δemuγni tirewes elqeεθes egget, <verse eid="LUK 12:16" /><verse number="17" style="v" sid="LUK 12:17" />yen yimenes, &lt;max δege, elγriyc meni δeHerze imendiyw?&gt; <verse eid="LUK 12:17" /><verse number="18" style="v" sid="LUK 12:18" />usiyn yenne, &lt;δege sahen: essendre elmxezniyw ebniyγ g wemxenensen elmxazen ekber, usiyn eHuTTe δiysen ireδniyw delxireθiyw. <verse eid="LUK 12:18" /><verse number="19" style="v" sid="LUK 12:19" />enne yimeniyw: γerm elxiyraθ egget emezzaneθ lesniyn xlaf, erθaH θečeδ tesweδ teθneεmeδ!&gt; <verse eid="LUK 12:19" /><verse number="20" style="v" sid="LUK 12:20" />yaxi yennes rebbi, &lt;eyeδerwiyc, iδekan erruHex δetemmekkes essix. ywiyn wahen itHeDreδ elkul?&gt; <verse eid="LUK 12:20" /><verse number="21" style="v" sid="LUK 12:21" />usahen δeyejre yelli δeylayem yimenes umuc δemuγni γer rebbi.»<verse eid="LUK 12:21" /></para>
  <para style="s">eθθiyqeθ g erreb</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 12:22" />yen yetlemδas: «usahen exennenne: eθelhiymc yleHyeθennum δmette δeθečem, uyelbeδnennum δmette δeθirDem. <verse eid="LUK 12:22" /><verse number="23" style="v" sid="LUK 12:23" />εlexaTer edder xiyr nweče, welbδen xiyr nwariD. <verse eid="LUK 12:23" /><verse number="24" style="v" sid="LUK 12:24" />erqbeθ elgrebbe, eltzerreεc weltmedjerc, welγres la δelmxazen la δelgerajaθ, yemenni rebbi yettučasen uxenyum, elqimtewwem xiyr nizenniywen! <verse eid="LUK 12:24" /><verse number="25" style="v" sid="LUK 12:25" />δ wiyn essiywem max eyelhe iged eyerni eγil iyjen yeTTules? <verse eid="LUK 12:25" /><verse number="26" style="v" sid="LUK 12:26" />wiδekan elHajaθ timezyanin entgeddemc, imette iθlehhem s elbaqi? <verse eid="LUK 12:26" /><verse number="27" style="v" sid="LUK 12:27" />erqbeθ eznabeq nijiyman max ekbarneθ: eltεekkiyc welteffalc. exennenne: Hette δesliyman g elεezzes elyiriyDc xiyr nicθ essisneθ. <verse eid="LUK 12:27" /><verse number="28" style="v" sid="LUK 12:28" />wiδekan rebbi iraδ yelHec Haje emtah, elHec elli asse g ujiymi weječe g tunnurθ, menyeθ δexenyiyreD xenyum? yelli elimenewwem δuDεif! <verse eid="LUK 12:28" /><verse number="29" style="v" sid="LUK 12:29" />weθeĎlbemc δmette δeθečem ziyγ δmette δeθeswem weθeqlqemc, <verse eid="LUK 12:29" /><verse number="30" style="v" sid="LUK 12:30" />wahen Ďelben δiys midden neddunyeθ elkul, udaddeθwem elli lennej yessen elli ettesθHeqqent. <verse eid="LUK 12:30" /><verse number="31" style="v" sid="LUK 12:31" />emme Hewmeθ elmemlxeθ nrebbi unette exenyerni wahen elkul. <verse eid="LUK 12:31" /><verse number="32" style="v" sid="LUK 12:32" />eθukδc eyesεi emezyen! daddeθwem elli lennej δeyenεem f ellawem s elmelxes. <verse eid="LUK 12:32" /><verse number="33" style="v" sid="LUK 12:33" />ezzenzeθ elli γerwem tSedqem elHeqqes f iqelliylen, tegem ticxar etherrinec δelkenz g esmawaθ liweqqiyc, meni leHebbe la δessareq yθaxer ula δessuws yetherre. <verse eid="LUK 12:33" /><verse number="34" style="v" sid="LUK 12:34" />εlexaTer meni elkenzennum meni ulewnennum.<verse eid="LUK 12:34" /></para>
  <para style="s">elmθel nixeddamen eθθiyqeθ</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 12:35" />eθHezmeθ diyme čeεlem lebyelennum, <verse eid="LUK 12:35" /><verse number="36" style="v" sid="LUK 12:36" />tebδam emiryazendiyn elli etrajen g siydiynsen seg islan, max eyeddes iδuq esmiyren liyhliyh. <verse eid="LUK 12:36" /><verse number="37" style="v" sid="LUK 12:37" />SeHHe liyhum ixeddamen elli max eyrewweH siydiynsen enyaf elluciyn esheren. exennenne elHeq: δeycemmer f iγelnes yesgeεmezθen f eTTawleθ yexδemten. <verse eid="LUK 12:37" /><verse number="38" style="v" sid="LUK 12:38" />SeHHe liyhum iδekan yuseδ uggezyen eθθani ziyγ eθθaleθ nδeggiyδ yafin HaDriyn. <verse eid="LUK 12:38" /><verse number="39" style="v" sid="LUK 12:39" />emme esneθ wahen: lukan iθbab nelHuwc yessen lemmi δeyeddes exennab elyettedjiyc elHuces eyemmaxer. <verse eid="LUK 12:39" /><verse number="40" style="v" sid="LUK 12:40" />HeDreθ imenennum diyme, εlexaTer bnaδem δeyeddes g elweqθ etrajiymc δiys.»<verse eid="LUK 12:40" /></para>
  <para style="s">elmθel nwewkiyl eθθiyqeθ</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 12:41" />yennes buTrus: «ya siydiy, ennaHwe teqqareδ δiys ynečin ziyγ yleεbaδ elkul?» <verse eid="LUK 12:41" /><verse number="42" style="v" sid="LUK 12:42" />yer felles seyyedne yesuwε: «δ wiyn nette ewkiyl eθθiyqeθ delεaqel elli iHuTTi siydiys bac e yuc yixeddemnes ečensen g elweqθ ellazem? <verse eid="LUK 12:42" /><verse number="43" style="v" sid="LUK 12:43" />SeHHe liyh exeddamdiyn elli eθyaf siydiys max eyrewweH yxeddem g elxeδmtes. <verse eid="LUK 12:43" /><verse number="44" style="v" sid="LUK 12:44" />exennenne elHeq: δeθiHuT elmelxes elkul. <verse eid="LUK 12:44" /><verse number="45" style="v" sid="LUK 12:45" />emme iδekan exeddame yenne g imenes: &lt;siydiy δeywexxer uggeδweles.&gt;, yebδe yettewweθ g ixeddamen, erjal wense, wiθet wises wisexxer, <verse eid="LUK 12:45" /><verse number="46" style="v" sid="LUK 12:46" />siydiys nuxeddamdiyn δeyeδwel uggas eθyetrejiyc δiys dessaεeθ etyessiync, δeθicerrex iHuTTi delxuyyan. <verse eid="LUK 12:46" /><verse number="47" style="v" sid="LUK 12:47" />exeddam elli yessen δmette iyexs siydiys welyetHeDDerc imenes ziyγ elyθegc emmax i syeqqar, yelzem eyemmewweθ egget. <verse eid="LUK 12:47" /><verse number="48" style="v" sid="LUK 12:48" />welli elyessiync δmette iyexs siydiys yeg Haje ettesθehal enγe, eyemmewweθ qiqqi berk. elli yemmuces egget eyemmeĎleb essis egget, welli eyemHuT egget eyemmeĎleb essis exθer.<verse eid="LUK 12:48" /></para>
  <para style="s">yesuwε deddunyeθ</para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 12:49" />useδe bac e lewHe elεafyeθ f elqeεεeθ, wencelleh eθkuwn tecεel! <verse eid="LUK 12:49" /><verse number="50" style="v" sid="LUK 12:50" />uyelzmiyδ eqeble temeεmuwdiyyeθ nelwjayeε, umeDyeq uliyw elδeθekmel. <verse eid="LUK 12:50" /><verse number="51" style="v" sid="LUK 12:51" />endre etteεlakmiyδ useδe bac e ge eslam f elqeεεeθ? exennenne: la, emme δezuwni, <verse eid="LUK 12:51" /><verse number="52" style="v" sid="LUK 12:52" />seg asse δeyeδwel g elHuwc iyjen xemse, tlaθe δemεarxen dsen, usen dtlaθe. <verse eid="LUK 12:52" /><verse number="53" style="v" sid="LUK 12:53" />eyemεarex eryaz dmemmis wefruwx ddaddes, temeTTuwθ dyelliys utefruwxθ dyemmes, temeTTuwθ ettesliθes utesliθ ettewesserθes.»<verse eid="LUK 12:53" /></para>
  <para style="s">elεlameθ nluqaθ</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 12:54" />yen yleεbaδ xlaf: «max eθezrem esHabeθ tuwli seg eggaz ntefuwθ, enneθ elweqθes, &lt;amzer δeyeggez&gt;, uture eyeggez. <verse eid="LUK 12:54" /><verse number="55" style="v" sid="LUK 12:55" />umax eyenfex jenuwbi enneθ, &lt;δeyeδwel dechiyli&gt;, uture eyeδwel siyn. <verse eid="LUK 12:55" /><verse number="56" style="v" sid="LUK 12:56" />eyelli tesxerxuwsem! tessenem max i θeδwel elqeεεeθ desme, yemenni eltessinemc elεlamaθ nelweqθe?<verse eid="LUK 12:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 12:57" />wimette eltessinemc weHδawem δ menten elHeq? <verse eid="LUK 12:57" /><verse number="58" style="v" sid="LUK 12:58" />max eθexDmeδ cex dweγrimex y elHakem, eg elli eθgeddeδ elkul bac e traDiyδ uggebriδ, bac e xyettewiyc y elHakem, yuwcex elHakem yelbuwlis, welbuwlis exylewweH g elHebs. <verse eid="LUK 12:58" /><verse number="59" style="v" sid="LUK 12:59" />exenne: etteffγeδ esyiyn kan eθkemmleδ esuwrdi igluxxer.»<verse eid="LUK 12:59" /></para>
  <chapter eid="LUK 12" />
  <chapter number="13" style="c" sid="LUK 13" />
  <para style="s">yelzem ettuwbeθ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 13:1" />g elweqtdiyn useδen leεbaδ ennen yyesuwε f ijliyliyyen elli yenγiyn biylaTus elwali nerruwman g elHuwc nelqudus yesseser iδemnensen s iδammen necwiheθensen. <verse eid="LUK 13:1" /><verse number="2" style="v" sid="LUK 13:2" />yer f ellasen yesuwε: «etteεlakem elli elγeldeθ nijliyliyyene ekber nelγeldeθ nijliyliyyen iddiynni bac e senyejre wahen elkul? <verse eid="LUK 13:2" /><verse number="3" style="v" sid="LUK 13:3" />exennenne: la, emme iδekan ettabemc δexenyejre emnihnin elkulkum. <verse eid="LUK 13:3" /><verse number="4" style="v" sid="LUK 13:4" />weθmenTacdiyn elli yuDe fellasen elburj g silwam yenγiyn, etεilekemten eγleĎen exθer nmidden nuwrceliym? <verse eid="LUK 13:4" /><verse number="5" style="v" sid="LUK 13:5" />exennenne: la, emme iδekan ettabemc δexenyejre emnihnin elkulkum.»<verse eid="LUK 13:5" /></para>
  <para style="s">elmθel ntemečiyθ elli etteruwc</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 13:6" />yen elmθele: «ykan yelle eryaz γers temečiyθ temmezzu uggemmes eccejreθ nelεneb, yeseδ yetHewwem g imečan welyufiyc. <verse eid="LUK 13:6" /><verse number="7" style="v" sid="LUK 13:7" />yen eryaz elli yxeddem diyn: &lt;γeri tlaθe sniyn uneč ettesδe ytemečiyθe wellettefac δiys imečan, eqleεt! imette ettedjiyδ δiys etεeTTel g elqeεεeθ?&gt; <verse eid="LUK 13:7" /><verse number="8" style="v" sid="LUK 13:8" />yer felles eryazdiyn, &lt;edjiθ, ya siydiy, esukkese xlaf, elδexubre f elxubθes egγes elγbar. <verse eid="LUK 13:8" /><verse number="9" style="v" sid="LUK 13:9" />emme eθaru esukkes xlaf ziyγ eqleεt.&gt;»<verse eid="LUK 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 13:10" />yesuwε ykan yetseqre g iyjen nelmjameε as nessebθ, <verse eid="LUK 13:10" /><verse number="11" style="v" sid="LUK 13:11" />weθkan telle temeTTuwθ ettemeryaHeθ seg θmenTac nesne, yeδwel exrumes δimqewwes eltgeddec eθbed. <verse eid="LUK 13:11" /><verse number="12" style="v" sid="LUK 13:12" />max i tyezre yesuwε ynebat yennes: «etemeTTuwθ, cem tebriδ seg weTTenem!» <verse eid="LUK 13:12" /><verse number="13" style="v" sid="LUK 13:13" />iHuT efuses f elles, tekker eθbed g elweqθes eθmejjeδ rebbi. <verse eid="LUK 13:13" /><verse number="14" style="v" sid="LUK 13:14" />yeθγeccec emeqqar nelmejmeε εlexaTer yesuwε yeSSebrat g essebθ, yen yelli diyn: «γerwem sette eyyam yetmexδem δiysen, esδeθ tεeddem δiysen, muc g essebθ.» <verse eid="LUK 13:14" /><verse number="15" style="v" sid="LUK 13:15" />yer felles seyyedne yesuwε: «eyikeδδaben! muc iyjen essiywem as nessebθ iged eyseyyeb efuneses ziyγ δeγyules seg elmeεlef yawi yesseswi. <verse eid="LUK 13:15" /><verse number="16" style="v" sid="LUK 13:16" />w tahen ettemeTTuwθ seg idrari nibrahiym yeqqent ibliys θmenTac nesne, elykanc mumken eθemmiyr seg eqqenes g essebθ?» <verse eid="LUK 13:16" /><verse number="17" style="v" sid="LUK 13:17" />max i yenne edwiye, eθHecmen elli etεeraDen δiys elkul, eferHen leεbaδ elkul s elεmayel tibehhayin elli ykan yθeg δiysen.<verse eid="LUK 13:17" /></para>
  <para style="s">elmθel nelHebbeθ nelxerdel</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 13:18" />yen yesuwε: «imette ičebbeh elmemlxeθ nrebbi? wesmette δexencebbhe? <verse eid="LUK 13:18" /><verse number="19" style="v" sid="LUK 13:19" />icebbeh elHebbeθ nelxerdel yiwit eryaz yezzut g ujimiys, tekber teδwel deccejreθ etεeccecen izenniywen nesme g leεrefes.»<verse eid="LUK 13:19" /></para>
  <para style="s">elmθel nelxmiyreθ</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 13:20" />yen xlaf: «s mette δecebhe elmemlxeθ nrebbi? <verse eid="LUK 13:20" /><verse number="21" style="v" sid="LUK 13:21" />icebbeh yelxmiyreθ tHuTTiθ temeTTuwθ g etlaθe δelkiylaθ nwaren elδeyexmer elεjiyn.»<verse eid="LUK 13:21" /></para>
  <para style="s">elbab elli yeDyeq</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 13:22" />yuyuwr g lemden ettimuwre, yetseqre uggebriδes yuwrceliym. <verse eid="LUK 13:22" /><verse number="23" style="v" sid="LUK 13:23" />yennes eryaz: «ya siydiy, elli δemenεen δruws?» yer felles: <verse eid="LUK 13:23" /><verse number="24" style="v" sid="LUK 13:24" />«egeθ elmejhuδennum bac e θeδfem seg elbab elli yeDyeq. exennenne: leεbaδ egget δeHawlen eθaδfen yemenni etgeddenc. <verse eid="LUK 13:24" /><verse number="25" style="v" sid="LUK 13:25" />umax i yekker iθbab nelHuwc isekker elbab, teqqiymem elberre etδuqqem g elbab uθeqqarem, &lt;ya rebb! mirane!&gt;, δayer fellawem, &lt;ellessinac s meniys xenyum!&gt; <verse eid="LUK 13:25" /><verse number="26" style="v" sid="LUK 13:26" />elweqθes esθennem, &lt;nečin neče nesw iyδex, tesseqriδane g lenhjenne!&gt; <verse eid="LUK 13:26" /><verse number="27" style="v" sid="LUK 13:27" />yemenni exenyen, &lt;ellessinac s meniys xenyum, ebeεδeθ felle eyicerriyren!&gt; <verse eid="LUK 13:27" /><verse number="28" style="v" sid="LUK 13:28" />diyn δeyebδe eεeyyeĎ duzeryeT nisennuwqen seg endem dweθγeccec, max eθezrem ibrahiym dyeεquwb dlenbye elkul g elmemlxeθ nrebbi, uxenyum elberre temgelbem! <verse eid="LUK 13:28" /><verse number="29" style="v" sid="LUK 13:29" />uδeddasen leεbaδ seg eccerq delγerb, seg eccemal deljenuwb, eqqiymen f elmiyδeθ g elmelx nrebbi. <verse eid="LUK 13:29" /><verse number="30" style="v" sid="LUK 13:30" />eδwlen ellexren δimezwuwre, wimezwuwre δellexren.»<verse eid="LUK 13:30" /></para>
  <para style="s">exse nyesuwε yuwrceliym</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 13:31" />g elweqtdiyn eqreben elHezb nifarisiyyen seg yesuwε ennanes: «erwel esyahen, εlexaTer hiyruwdus yexs exyenγ!» <verse eid="LUK 13:31" /><verse number="32" style="v" sid="LUK 13:32" />yer fellasen: «berreθ enneθ yeθθeεlebdiyn: &lt;tay neč etgelbe g ecyaĎen weSSebriyγ g imuwDan asse dweječe, was eθθaleθ ekemle kul cey. <verse eid="LUK 13:32" /><verse number="33" style="v" sid="LUK 13:33" />emme yelzmiyδ eθuyuwre uggebriδiyw asse dweječe dwas elli beεδes, εlexaTer elyetteseδc eyjaf enbi elberre nuwrceliym.&gt; <verse eid="LUK 13:33" /><verse number="34" style="v" sid="LUK 13:34" />uwrceliym, uwrceliym! yelli tneqqeδ g lenbye wetHejareδ g elli emmezennem. menyeθ nmerre etteεlake δelayme idreriym, emmax eθlayem tyazidt iciciwnes seddu ifriwnes. yemenni elteqqilemc. <verse eid="LUK 13:34" /><verse number="35" style="v" sid="LUK 13:35" />tay elHuwc nelqudus egliwwem yeqqimawem. exennenne: eyeθzerremc elδeyeddes as eθzeεwgem δiys, &lt;δemebruwx elli yuseδ s ellesm nrebbi!&gt;»<verse eid="LUK 13:35" /></para>
  <chapter eid="LUK 13" />
  <chapter number="14" style="c" sid="LUK 14" />
  <para style="s">yesuwε eysebre emaDun</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 14:1" />yaδef as nessebθ elHuwc niyjen seg imeqqaren nifarisiyyen bac e yeč, ukanen etreqaben δiys. <verse eid="LUK 14:1" /><verse number="2" style="v" sid="LUK 14:2" />yaf ezzeθes eryaz δmaDun s usθesqi, ikreεnes entefxen. <verse eid="LUK 14:2" /><verse number="3" style="v" sid="LUK 14:3" />yenceδ yesuwε imuεelmen necceriyεeθ delHezb nifarisiyyen: «γenne elHeq ensebre g essebθ ziyγ la?» <verse eid="LUK 14:3" /><verse number="4" style="v" sid="LUK 14:4" />esegren, yeTTef yesuwε eryazdiyn seg efuses yeSSebraθ yezent yrewweH. <verse eid="LUK 14:4" /><verse number="5" style="v" sid="LUK 14:5" />usiyn yenneyasen: «δ wiyn essiywem esyuDe memmis ziyγ δefuneses g esuγ as nessebθ weθinedzeγc?» <verse eid="LUK 14:5" /><verse number="6" style="v" sid="LUK 14:6" />yaxi elgeddenc erren felles.<verse eid="LUK 14:6" /></para>
  <para style="s">eDyafeθ dweθwaDeε</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 14:7" />yezer elli eljmaεeθ seg ihelli mnaben ettexθaren g elblayeS tuggezzaθin, yen elmθele: <verse eid="LUK 14:7" /><verse number="8" style="v" sid="LUK 14:8" />«max eθemnabiδ yumensi g islan, eθeqqimec g elkursi emezwar. balek yelle δ wiyn xirex g elli mnaben, <verse eid="LUK 14:8" /><verse number="9" style="v" sid="LUK 14:9" />usiyn eyeddes elli ynebeyawem yennex, &lt;uwces emxenex.&gt;, elweqθes eθeθHecmeδ tekreδ ywemxan eldeffer. <verse eid="LUK 14:9" /><verse number="10" style="v" sid="LUK 14:10" />emme max eθemnabiδ, eqqiym g wemxan eldeffer, umax eyeddes iθbab nislan yennex, &lt;ekker lennej eyemeddukliyw&gt;, elweqθes eθkebreδ g TiTTawin nihelli mnaben. <verse eid="LUK 14:10" /><verse number="11" style="v" sid="LUK 14:11" />εlexaTer elli eyεelle imenes eyeggez elweddey, welli eyessuggez imenes eyali lennej.» <verse eid="LUK 14:11" /><verse number="12" style="v" sid="LUK 14:12" />usiyn yenne yesuwε yelli inebaθ: «max eθegeδ elfĎuwr ziyγ δemensi, eθnebiyc imeddukelex ziyγ δemmeθnex ziyγ δiqribnex ziyγ δeljiyranex imuγniyyen, bac e xetnebiync Hette ennihnin, usahen eθewyeδ elHeq nunebiyx. <verse eid="LUK 14:12" /><verse number="13" style="v" sid="LUK 14:13" />emme max eθegeδ emensi, nabe iqelliylen dimuεaqen delεuyyab dileεmyen. <verse eid="LUK 14:13" /><verse number="14" style="v" sid="LUK 14:14" />uSeHHe liyk iδekan θegiyδ siyn εlexaTer elgeddenc exuwcen elHeqqes, δeθewyeδ elHeqqex as nelqiyameθ, as nwekkar niHeqqiyyen.»<verse eid="LUK 14:14" /></para>
  <para style="s">elmθel nelwliymeθ</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 14:15" />max i yesle iyjen essisen edwiye yenne yyesuwε: «SeHHe liyh elli eygeεmez yelmiyδeθ g elmelx nrebbi!» <verse eid="LUK 14:15" /><verse number="16" style="v" sid="LUK 14:16" />yer felles: «yege eryaz tikkelt emensi δemeqqar, inabe leεbaδ egget. <verse eid="LUK 14:16" /><verse number="17" style="v" sid="LUK 14:17" />usiyn yuzen exeddemes g elweqθ nweče yeqqar yelli mnaben, &lt;heyyeθ, kul cey yeHDer!&gt; <verse eid="LUK 14:17" /><verse number="18" style="v" sid="LUK 14:18" />yemenni ebδen elkulhum nedzγen g imenensen. yennes emezwar, &lt;esγiyγ ejiymi uyelzmiyδ exeDme eθerqbe, samHiyδ.&gt; <verse eid="LUK 14:18" /><verse number="19" style="v" sid="LUK 14:19" />yen iyjen xlaf, &lt;esγiyγ xemse zwaz nifunasen, uδexeDme enjerbe, samHiyδ.&gt; <verse eid="LUK 14:19" /><verse number="20" style="v" sid="LUK 14:20" />yen iyjen xlaf, &lt;uγiyγ temeTTuwθ welgeddac eddase.&gt; <verse eid="LUK 14:20" /><verse number="21" style="v" sid="LUK 14:21" />yeδwel exeddamdiyn ysiydiys yennes elli ySar, yeθγeccec iθbab nelHuwc yen yuxeddemes, &lt;effeγ ettezleδ yikeyyasen ntemuwreθ dlezneqes tessuwδfeδ iqelliylen dimuεaqen delεuyyab dileεmyen eldahen.&gt; <verse eid="LUK 14:21" /><verse number="22" style="v" sid="LUK 14:22" />ubeεδ yen exeddam, &lt;egiyγ elli tenniyδ ya siydiy, weqqiymneθ elblayeS ettelfurraγ.&gt; <verse eid="LUK 14:22" /><verse number="23" style="v" sid="LUK 14:23" />yer felles siydiys, &lt;effeγ yikeyyasen delmεaber, tessuwδfeδ leεbaδ embessiyf elδeyεebbe elHuciyw. <verse eid="LUK 14:23" /><verse number="24" style="v" sid="LUK 14:24" />exennenne: elimeddi Hette iyjen seg ihelli nebiyγθen emensiyw!&gt;»<verse eid="LUK 14:24" /></para>
  <para style="s">elHajeθ temeĎlubθ seg weθbeε nyesuwε</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 14:25" />kanen leεbaδ egget θebεen g yesuwε, yebren yennasen: <verse eid="LUK 14:25" /><verse number="26" style="v" sid="LUK 14:26" />«lukan elli eyeddes unette welygeddec eybeHHel f daddes dyemmes, liweces didreriys, emmeθnes ettemmeθines, iyh Hette δimenes, eligeddec eyeδwel δiyjen seg etlemδaw. <verse eid="LUK 14:26" /><verse number="27" style="v" sid="LUK 14:27" />elli elyetqamc eSlibes yeθbεiyδ eligeddec eyeδwel δiyjen seg etlemδaw. <verse eid="LUK 14:27" /><verse number="28" style="v" sid="LUK 14:28" />lukan iyjen essiywem yexs eyebne elburj, elyetgeεmezc qebl yeHseb menyeθ δeyeθkellef bac e yzer iged eθikemmel ziyγ la? <verse eid="LUK 14:28" /><verse number="29" style="v" sid="LUK 14:29" />iδekan yeHfer essas welyetgeddec eθikemmel, eSSen f elles leεbaδ elkul. <verse eid="LUK 14:29" /><verse number="30" style="v" sid="LUK 14:30" />ennen, &lt;eryaze yebδe ibenne weligeddec eykemmel.&gt; <verse eid="LUK 14:30" /><verse number="31" style="v" sid="LUK 14:31" />weδmenten elmlek elli eyeffeγ bac e yHareb elmlek xlaf, qebl eygeεmez icawer imenes eyged eyHareb sεecre laf elli yuseδes s εicriyn elf? <verse eid="LUK 14:31" /><verse number="32" style="v" sid="LUK 14:32" />ziyγ esyazen emersal, maδame elyuwc yebεeδ felles, bac e mSalHen. <verse eid="LUK 14:32" /><verse number="33" style="v" sid="LUK 14:33" />usahen eliged Hette iyjen essiywem weligeddec eyeδwel δettelmiδiyw, kan max eyedj elli γers elkul.<verse eid="LUK 14:33" /></para>
  <para style="s">elmθel ntisent</para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 14:34" />tisent tSelleH, yemenni max eθefseδ tisent δmette δettimelleH? <verse eid="LUK 14:34" /><verse number="35" style="v" sid="LUK 14:35" />eltSelleH la yecal ula yuγebber, ettemlewwaH yebεeδ. elli γers timedjiyn selneθ edj eyesl.»<verse eid="LUK 14:35" /></para>
  <chapter eid="LUK 14" />
  <chapter number="15" style="c" sid="LUK 15" />
  <para style="s">elmθel nuεelluc elli yraH</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 15:1" />ukanen elli etlemδen g lefluws s leεbaδ y elHakem delli muc δeSSuwlleH qreben yyesuwε bac e θeslen. <verse eid="LUK 15:1" /><verse number="2" style="v" sid="LUK 15:2" />ennen elHezb nifarisiyyen dimuεelmen necceriyεeθ unihnin etteθcekken: «eryaze wahen iferreH s ihelli muc δeSSuwlleH wiθet iyδsen!» <verse eid="LUK 15:2" /><verse number="3" style="v" sid="LUK 15:3" />yer fellasen s elmiθale: <verse eid="LUK 15:3" /><verse number="4" style="v" sid="LUK 15:4" />«δ wiyn essiywem max eyebδe γers myat neεje, eθraHes icθ essisneθ, elyettedjiyc tesεe utesεiyndiyn g elxle yexDem yetHewwem g tiyli elli traH elδetyaf? <verse eid="LUK 15:4" /><verse number="5" style="v" sid="LUK 15:5" />max etyaf ettiqam f lexθefes unette ferHan, <verse eid="LUK 15:5" /><verse number="6" style="v" sid="LUK 15:6" />yeδwel yelHuces inabe imeddukeles deljiyrenes yennasen, &lt;eferHeθ iyδi εlexaTer ufiyγ tiliyw elli traH.&gt; <verse eid="LUK 15:6" /><verse number="7" style="v" sid="LUK 15:7" />sahen exennenne: δeferHen g esme s iyjen ykan δelγaleĎ itab exθer nwefreHensen s tesεe utesεiyn δeSSuwlleH eltesθHeqqiync etabi.<verse eid="LUK 15:7" /></para>
  <para style="s">elmθel nedderhem elli yraH</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 15:8" />ziyγ ettemeTTuwθ γers εecre laf δelfeTTeθ tesraH iyjen, maw δeθceεεel elgaz tefreD elHuwc eθHewwemti belgde elδettef. <verse eid="LUK 15:8" /><verse number="9" style="v" sid="LUK 15:9" />max ettef, eθnabe timeddukeles etteljerθes tennasneθ, &lt;efreHmeθ iyδi εlexaTer ufiyγθi elli s reHaθ.&gt; <verse eid="LUK 15:9" /><verse number="10" style="v" sid="LUK 15:10" />sahen exennenne: elmleyxaθ nrebbi δeferHen s iyjen max eyteb.»<verse eid="LUK 15:10" /></para>
  <para style="s">elmθel nwefruwx eDDayeε</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 15:11" />yen yesuwε: «ykan yelle eryaz γers sen δidrari, <verse eid="LUK 15:11" /><verse number="12" style="v" sid="LUK 15:12" />yennes emezyen, &lt;uciyδ elbeyiyw edda.&gt; yzunasen elmelxes elkul. <verse eid="LUK 15:12" /><verse number="13" style="v" sid="LUK 15:13" />beεεeδ liyyam, ilayem efruwx emezyen elli γers elkul, yexDem ytemuwreθ tebεeδ, udiyn iferreθ lefluses menγiyr elHsab. <verse eid="LUK 15:13" /><verse number="14" style="v" sid="LUK 15:14" />max i yesref elli γers elkul, θemuwretdiyn tewwetteθ elmjaεeθ teqSeH, yebδe meHtaj egget. <verse eid="LUK 15:14" /><verse number="15" style="v" sid="LUK 15:15" />heδake εlac yexDem δeyexδem γer iyjen seg iyh ntemuwretdiyn, yezent yujimiys bac e yesreH s iHellaf. <verse eid="LUK 15:15" /><verse number="16" style="v" sid="LUK 15:16" />w ykan yettecθhe eyecbeε seg elxerruwb elli tetten δiys iHellaf, yemenni elyeqqiyl Hette Hed esyuwc. <verse eid="LUK 15:16" /><verse number="17" style="v" sid="LUK 15:17" />ubeεδ yeδwel yimenes yen, &lt;menyeθ δixeddamen γer dadde ifeTlasen eče, uneč dahen etjafe s eccer. <verse eid="LUK 15:17" /><verse number="18" style="v" sid="LUK 15:18" />δekre eδuwle ydadde enγes: dadde eγleĎe g elHeq nesme delHeqqex, <verse eid="LUK 15:18" /><verse number="19" style="v" sid="LUK 15:19" />meεεač ettesθehale eyeθnebiyδ emmi, egiyδ δexeddam γerx.&gt; <verse eid="LUK 15:19" /><verse number="20" style="v" sid="LUK 15:20" />yekker yeδwel ydaddes. yezri daddes jay seg lebεiyδ, yesxef felles yezzel yetweliys yetHemmel yetkub δiys. <verse eid="LUK 15:20" /><verse number="21" style="v" sid="LUK 15:21" />yennes memmis, &lt;dadde, eγleĎe g elHeq nesme delHeqqex, wettesθehilac eyeθnabiyδ emmi.&gt; <verse eid="LUK 15:21" /><verse number="22" style="v" sid="LUK 15:22" />yemenni yen daddes yixeddemnes, &lt;fiyseε, eγδeθ edbac ibehhayen tireDmasθen, tireDmes txaθemt g weDeDes deSSebbaĎ g ukreεes. <verse eid="LUK 15:22" /><verse number="23" style="v" sid="LUK 15:23" />taγδem eyenduwz eqewwey teγrsemt, usiyn eneč nefreH, <verse eid="LUK 15:23" /><verse number="24" style="v" sid="LUK 15:24" />εlexaTer memmi wahen ykan yjaf, yedder, w ykan iraH yemmef.&gt; ebδen ferHen. <verse eid="LUK 15:24" /><verse number="25" style="v" sid="LUK 15:25" />elweqθes memmis emeqqar ykan g ujiymi. max i yeδwel yeqreb seg elHuwc yesl eγenni derqiyS. <verse eid="LUK 15:25" /><verse number="26" style="v" sid="LUK 15:26" />inabe iyjen seg ixeddamen yenceδt δmette iyelle. <verse eid="LUK 15:26" /><verse number="27" style="v" sid="LUK 15:27" />yer felles, &lt;enjex yeδwel labas, yeγres daddex eyenduwz eqewwey.&gt; <verse eid="LUK 15:27" /><verse number="28" style="v" sid="LUK 15:28" />yeθγeccec welyeqqiylec eyaδef. yeffeγes daddes yetmelges bac e yaδef, <verse eid="LUK 15:28" /><verse number="29" style="v" sid="LUK 15:29" />yennes ydaddes, &lt;utay isukkasene elkul uneč xeδme δiyx, Hette tikkelt wexenniyγ la. yemenni eyθuciyc Hette δebercni iyjen bac e ferHe essis dimeddukeliyw. <verse eid="LUK 15:29" /><verse number="30" style="v" sid="LUK 15:30" />umax i yrewweH memmiyx wahen elli yferreθ leflusex elkul f telfuwsset, teγreseδ eyenduwz eqewwey!&gt; <verse eid="LUK 15:30" /><verse number="31" style="v" sid="LUK 15:31" />yer felles daddes, &lt;emmi, cex diyme iyδi welli γeri δegliyx. <verse eid="LUK 15:31" /><verse number="32" style="v" sid="LUK 15:32" />emme yelzem enefreH εlexaTer enjex wahen ykan yjaf yedder, w ykan iraH yemmef.&gt;»<verse eid="LUK 15:32" /></para>
  <chapter eid="LUK 15" />
  <chapter number="16" style="c" sid="LUK 16" />
  <para style="s">elmθel nwuxil elxayen</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 16:1" />yen xlaf yetlemδas: «ykan yelle eryaz δemuγni γers ewkiyl, yeseδ δ wiyn esyenne elli ewkiles yetfesδes g elmelxes, <verse eid="LUK 16:1" /><verse number="2" style="v" sid="LUK 16:2" />inebaθ yennes, &lt;δmette wahen elli selle δiys fellex? uciyδ elHsab nelwkeltex, cex eltSelHec seg asse eθkuwneδ δewkiliyw.&gt; <verse eid="LUK 16:2" /><verse number="3" style="v" sid="LUK 16:3" />yen ewkiyl g imenes, &lt;δmette δege? siydiy δeyyekkes seg elxeδemtiyw. elleqwixc bac e xeδme elflaHeθ, wetteθHeccame eDelbe. <verse eid="LUK 16:3" /><verse number="4" style="v" sid="LUK 16:4" />essene δmette δege, Hette iδekan siydiy igelbiyδ seg elwkaleθ, imeddukeliyw δeferHen essi.&gt; <verse eid="LUK 16:4" /><verse number="5" style="v" sid="LUK 16:5" />elweqθes inabe elli fellasen ledyuwn ysiydiys, yen yumezwar, &lt;menyeθ fellex ysiydiy?&gt; <verse eid="LUK 16:5" /><verse number="6" style="v" sid="LUK 16:6" />yer felles, &lt;myat kiyle ettemeqqarθ δuwδi.&gt; yennes ewkiyl, &lt;ax elbunuwx teqqiymeδ liyhliyh teryeδ xemsiyn.&gt; <verse eid="LUK 16:6" /><verse number="7" style="v" sid="LUK 16:7" />ubeεεeδ yen yiyjen xlaf, &lt;ucex menyeθ fellex.&gt; yer felles, &lt;myat kiyle δiyrδen.&gt; yennes, &lt;ax elbunuwx teryeδ θmenyiyn.&gt; <verse eid="LUK 16:7" /><verse number="8" style="v" sid="LUK 16:8" />yecxer eryazdiyn ewkiles elxayen f eδkewθes, εlexaTer leεbaδ neddunyeθe eδkawθensen exθer nidrari ntefuwθ g uθεemlensen jmiyε. <verse eid="LUK 16:8" /><verse number="9" style="v" sid="LUK 16:9" />uneč exennenne: egeθ imeddukal slefluws n elbaTel, max eθuqan leflusennum etemmeqblem g leHwac ndiyme. <verse eid="LUK 16:9" /><verse number="10" style="v" sid="LUK 16:10" />elli δeθθiyqeθ f eδruws δeθθiyqeθ f egget. welli yuwHec f eδruws yuwHec f egget. <verse eid="LUK 16:10" /><verse number="11" style="v" sid="LUK 16:11" />wiδekan etterriymc elbal f lefluws n elbaTel, δ wiyn δexenyHuT f lefluws nelHeq? <verse eid="LUK 16:11" /><verse number="12" style="v" sid="LUK 16:12" />wiδekan elterriymc elbal f wegli nelγiyr, δ wiyn δexenyuc elli δegliynnum? <verse eid="LUK 16:12" /><verse number="13" style="v" sid="LUK 16:13" />Hette exeddam weliged eyexδem sen δleεbaδ, εlexaTer yaYimme eyexreH iyjen yexs wissen, ziyγ eyeθbeε iyjen yerwel f wissen. weltgeddemc eθexeδmem rebbi dlefluws jmiyε.»<verse eid="LUK 16:13" /></para>
  <para style="s">ecceriyεeθ dwellef</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 16:14" />elHezb nifarisiyyen, elli kanen exsen lefluws, kanen sellen g wahen elkul, ukanen δeSSen felles. <verse eid="LUK 16:14" /><verse number="15" style="v" sid="LUK 16:15" />yennasen yesuwε: «etterrem g imenewwem δeSSuwlleH ezzaθ nleεbaδ, emme rebbi yessen elli g ulewnennum. elli zerren δiys leεbaδ yeεle, γer rebbi elyeεliyc. <verse eid="LUK 16:15" /><verse number="16" style="v" sid="LUK 16:16" />ecceriyεeθ dlenbye eqqiymen yelweqθ nyuwHenna, useg elweqtdiyn tebδe elbcareθ selmemlxeθ nrebbi, ukul iyjen yθeg bessiyf elli iged bac e θyaδef. <verse eid="LUK 16:16" /><verse number="17" style="v" sid="LUK 16:17" />emme axDem nesme delqeεεeθ eshel nwewDe netquTret icθ seg ecceriyεeθ. <verse eid="LUK 16:17" /><verse number="18" style="v" sid="LUK 16:18" />elli eyellef yliweces yaγ icθ xlaf rahu yezne, welli ayeγ temeTTuwθ yellefes eryazes rahu yezne.»<verse eid="LUK 16:18" /></para>
  <para style="s">elmθel numuγni deliyεazer</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 16:19" />yen yesuwε: «ykan yelle eryaz δemuγni iraδ g ellerjwan dedbac e γlan uyθeg g imensiywen kul as. <verse eid="LUK 16:19" /><verse number="20" style="v" sid="LUK 16:20" />w ykan yelle eryaz δeqelliyl ellesmes liyεazer welbeδnes elkule δimqeyyeH, w ykan diyme yettekke f elεaθbeθ nelHuwc numuγnidiyn, <verse eid="LUK 16:20" /><verse number="21" style="v" sid="LUK 16:21" />uyettecθhe eyecbeε seg elεqab nelmittes, Hette δeyDan kanen ettesδen leHsen g iyyezzimnes. <verse eid="LUK 16:21" /><verse number="22" style="v" sid="LUK 16:22" />yjaf eqelliyldiyn qament elmleyxaθ yetwali ibrahiym. yjaf emuγni erδment. <verse eid="LUK 16:22" /><verse number="23" style="v" sid="LUK 16:23" />yqam emuγniydiyn tiTTewines unette yetεane g elεafyeθ, yezer ibrahiym seg lebεiyδ weliyεazer g eljenbes. <verse eid="LUK 16:23" /><verse number="24" style="v" sid="LUK 16:24" />inabe yen, &lt;edda ibrahiym, ereHmiyδ tezendiyδ eliεazer bac e yeslexs eTTerf nweDeDes yessesqεiyδ ilsiyw, εlexaTer etεaniyγ g elεafyeθe.&gt; <verse eid="LUK 16:24" /><verse number="25" style="v" sid="LUK 16:25" />yemenni yennes ibrahiym, &lt;esfekker emmi, cex tiwiyeδ elbeyex seg elxiyr g leHyeθex weliyεazer yiwi elbeyes seg elblaye. tayeθ ture yetteθneεεem dahen ucex etεaniδ diyn. <verse eid="LUK 16:25" /><verse number="26" style="v" sid="LUK 16:26" />wexθer nwahen zade binatne tHuwfret teγreq eliged Hette Hed etyeθεedde esyahen yetwelinnum wesyiyn yetwelinne.&gt; <verse eid="LUK 16:26" /><verse number="27" style="v" sid="LUK 16:27" />yen emuγni, &lt;exsγex edda ibrahiym ziyγ eθazneδ liyεazer yelHuwc ndadde, <verse eid="LUK 16:27" /><verse number="28" style="v" sid="LUK 16:28" />bac e ynebbeh f emmeθniyw elxemse bac e lweTTiync Hette ennihnin g elεδabe wahen.&gt; <verse eid="LUK 16:28" /><verse number="29" style="v" sid="LUK 16:29" />yennes ibrahiym, &lt;γersen muwse dlenbye, edj enneslen.&gt; <verse eid="LUK 16:29" /><verse number="30" style="v" sid="LUK 16:30" />yen emuγni, &lt;la, edda ibrahiym, emme max esenyexDem iyjen seg inemmitte ture etaben.&gt; <verse eid="LUK 16:30" /><verse number="31" style="v" sid="LUK 16:31" />yennes ibrahiym, &lt;iδekan ellesseγδenc ymuwse dlenbye, ettebenc Hette max esenyekker iyjen seg inemmitte.&gt;»<verse eid="LUK 16:31" /></para>
  <chapter eid="LUK 16" />
  <chapter number="17" style="c" sid="LUK 17" />
  <para style="s">eγlaĎ d sameH d eliman</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 17:1" />yen yesuwε yetlemδas: «yelzem eySar elli δeysender leεbaδ g elγleĎ, emme yeHliyle elli δeysender leεbaδ g elγleĎ. <verse eid="LUK 17:1" /><verse number="2" style="v" sid="LUK 17:2" />εlexaTer esθemmayel tesiyrθ g texrumtes yemmeHδef g iylel xiyr nelli eysender iyjen seg imezyanene g elγleĎ. <verse eid="LUK 17:2" /><verse number="3" style="v" sid="LUK 17:3" />erreθ elbelennum. max eyeγleĎ yuwwex webbexθi umax eyteb eγfres. <verse eid="LUK 17:3" /><verse number="4" style="v" sid="LUK 17:4" />max eyeγleĎ g elHeqqex sebεe merraθ uggas, yesδex sebεe merraθ yennex, &lt;tay tabe.&gt; yelzem etsamHeδ.» <verse eid="LUK 17:4" /><verse number="5" style="v" sid="LUK 17:5" />ennen imersal ysiydiy: «erniyane g emmenenne.» <verse eid="LUK 17:5" /><verse number="6" style="v" sid="LUK 17:6" />yer f ellasen seyyedne yesuwε: «lukan γerwem eliman emelkeεbeθ nelxerdel tenmes ytetuwteyθe, &lt;emmeqleε temmezweδ g iylel.&gt; ture eθesl edwinnum.<verse eid="LUK 17:6" /></para>
  <para style="s">eθwaDeε g elxeδmeθ</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 17:7" />lukan γerx emexray yxeddem g elqeεεeθ ziyγ iserreH g esεi, max eyrewweH seg ejiymi estenneδ, &lt;heyye, fiyseε eč.&gt;? <verse eid="LUK 17:7" /><verse number="8" style="v" sid="LUK 17:8" />emme δesθenneδ, &lt;HeDDriyδ emensi, čemreδ f iγelnex texδemdiyδ elδeče eswe, usiyn ture eθečeδ tesweδ.&gt; <verse eid="LUK 17:8" /><verse number="9" style="v" sid="LUK 17:9" />endre δeyemmecxer exeddame εlexaTer yesle edwi nsiydiys? <verse eid="LUK 17:9" /><verse number="10" style="v" sid="LUK 17:10" />sahen Hette δxenyum, max eθegem elli yemmennawem felles elkul, enneθ, &lt;nečin δixeddamen enSelleHc, ennegi kan elli yelzem eθneg.&gt;»<verse eid="LUK 17:10" /></para>
  <para style="s">esebri nεecre δimuwDan</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 17:11" />uggebriδes yuwrceliym yeθεedde f essamreθ deljliyl. <verse eid="LUK 17:11" /><verse number="12" style="v" sid="LUK 17:12" />max i yuwδef icθ seg timuwre eεerDent εecre δinebraS, bedden ebεeδen felles. <verse eid="LUK 17:12" /><verse number="13" style="v" sid="LUK 17:13" />zeεwgen: «yesuwε eyimuεellem, ereHmane!» <verse eid="LUK 17:13" /><verse number="14" style="v" sid="LUK 17:14" />yerqebθen yennasen: «berreθ yelkuhhan bac e xennenzin tebram ziyγ la.» unihnin macyiyn ebran. <verse eid="LUK 17:14" /><verse number="15" style="v" sid="LUK 17:15" />max i yezre iyjen essisen imenes yebre, yeδwel unette yetmejjeδ g rebbi eSbiyH, <verse eid="LUK 17:15" /><verse number="16" style="v" sid="LUK 17:16" />yemmeHδef f uδmes ezzaθ nikraεen nyesuwε yecxerθ, w ykan δsamriy (meεnahe muc δyehuwdi δuSHiH). <verse eid="LUK 17:16" /><verse number="17" style="v" sid="LUK 17:17" />yen yesuwε: «muc εecre elli bran? mani tesεe iddiynni? <verse eid="LUK 17:17" /><verse number="18" style="v" sid="LUK 17:18" />eddisenc δ wiyn eyeδwel imejjeδ rebbi kan δeberraniye wahen?» <verse eid="LUK 17:18" /><verse number="19" style="v" sid="LUK 17:19" />usiyn yennes: «ekker texDmeδ, elimenex ymenεax.»<verse eid="LUK 17:19" /></para>
  <para style="s">aseδ nelmemlxeθ n erreb</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 17:20" />max i θencδen elHezb nifarisiyyen: «lemmi δeθeddes elmemlxeθ nrebbi?» yerre fellasen: «elmemlxeθ nrebbi etteseδc max eθebδem etεussem. <verse eid="LUK 17:20" /><verse number="21" style="v" sid="LUK 17:21" />welyetmenniyc, &lt;tayet dahen!&gt;, ziyγ, &lt;tenni γeDiyn!&gt;, εlexaTer elmemlxeθ nrebbi δiywem.» <verse eid="LUK 17:21" /><verse number="22" style="v" sid="LUK 17:22" />yen yetlemδas: «δeyeddes elweqθ eθebδem etteθmennem eθedrem δiys as iyjen seg liyyam nebnaδem, wettedremc. <verse eid="LUK 17:22" /><verse number="23" style="v" sid="LUK 17:23" />uδexenyemmen, &lt;tayet dahen!&gt; ziyγ, &lt;tenni γeDiyn!&gt; eθexeDmemc weθeθbεem Hette Hed essisen, <verse eid="LUK 17:23" /><verse number="24" style="v" sid="LUK 17:24" />εlexaTer emelberg elli yetDewwe g esme seg θeme yθeme, bnaδem siyn δeyeδwel uggeses. <verse eid="LUK 17:24" /><verse number="25" style="v" sid="LUK 17:25" />emme yelzmes eyeθwejjeε egget qebl, umidden neljiyle eθqeblenc. <verse eid="LUK 17:25" /><verse number="26" style="v" sid="LUK 17:26" />w emmax i ySar g liyyam ennuwH, siyn δeySar g liyyam nebnaδem. <verse eid="LUK 17:26" /><verse number="27" style="v" sid="LUK 17:27" />kanen leεbaδ tetten sessen wettaγen, elwas elli yuwδef nuwH yelfluwkeθ, yeseδ eTTuwfan yenγiyn elkul. <verse eid="LUK 17:27" /><verse number="28" style="v" sid="LUK 17:28" />emmax i ySar g liyyam nluwT: kanen leεbaδ tetten sessen, ezzenzen wessaγen, tezwen ubennan, <verse eid="LUK 17:28" /><verse number="29" style="v" sid="LUK 17:29" />emme as elli yeffeγ luwT seg seduwm yessuggez fellasen rebbi amzer nelεafyeθ delkebriyt seg esme yenγiyn elkul. <verse eid="LUK 17:29" /><verse number="30" style="v" sid="LUK 17:30" />sahen δeySar as elli eyeffeγ bnaδem. <verse eid="LUK 17:30" /><verse number="31" style="v" sid="LUK 17:31" />esses elli g esqef yetteggezc yelHuwc bac e yawi erzis. welli g ujiymi yetwexxerc eldeffer. <verse eid="LUK 17:31" /><verse number="32" style="v" sid="LUK 17:32" />esfekreθ liwec nluwT! <verse eid="LUK 17:32" /><verse number="33" style="v" sid="LUK 17:33" />elli eyHawel eymenneε imenes etyexser welli eyexser imenes etyerbeH. <verse eid="LUK 17:33" /><verse number="34" style="v" sid="LUK 17:34" />exennenne: g δeggiyδdiyn δebδen sen g esriyr iyjen, eyemmawi iyjen yemmedj wissen. <verse eid="LUK 17:34" /><verse number="35" style="v" sid="LUK 17:35" />uδebδaneθ sent δelwacun f tesiyreθ, eθemmawi icθ temmedj tissent. <verse eid="LUK 17:35" /><verse number="36" style="v" sid="LUK 17:36" />uδekuwnen sen g ujiymi, eyemmawi iyjen yemmedj wissen.» <verse eid="LUK 17:36" /><verse number="37" style="v" sid="LUK 17:37" />encδent: «mani erreb?» yer fellasen: «meni iθelle eljiyfeθ diyn emlaymen elεgabaθ.»<verse eid="LUK 17:37" /></para>
  <chapter eid="LUK 17" />
  <chapter number="18" style="c" sid="LUK 18" />
  <para style="s">elmθel ntehejjelt delqaDi</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 18:1" />yeHkeyasen elmθel f eθzalliθ diyme menγiyr eqlaq, <verse eid="LUK 18:1" /><verse number="2" style="v" sid="LUK 18:2" />yen: «ykan g icθ seg timuwre elqaDi elyettekkiyδc s rebbi welyetqedderc leεbaδ. <verse eid="LUK 18:2" /><verse number="3" style="v" sid="LUK 18:3" />weθkan telle g temuwretdiyn tedjalt diyme txeDmes teqqares, &lt;ewyiyδ elHeqqiyw seg eγrimiyw.&gt; <verse eid="LUK 18:3" /><verse number="4" style="v" sid="LUK 18:4" />w ykan elisellec edwiys, yemenni beεεeδ liyyam yen g imenes, &lt;reγmelli ettekkiδc seg rebbi wetqedrec leεbaδ, <verse eid="LUK 18:4" /><verse number="5" style="v" sid="LUK 18:5" />δesewye elHeqqes ytedjalte εlexaTer etqelleq δiyye, bac meεεač eyθeddes eθqelqiyδ.&gt;» <verse eid="LUK 18:5" /><verse number="6" style="v" sid="LUK 18:6" />yen seyyedne yesuwε: «esleθ elli yenni elqaDiye eDDalem, <verse eid="LUK 18:6" /><verse number="7" style="v" sid="LUK 18:7" />endre rebbi esenyθewiyc elHeqqensen elli exθarent welli etεeyyeĎnes δeggiyδ ddugges? wendre δeywexxer g werre fellasen? <verse eid="LUK 18:7" /><verse number="8" style="v" sid="LUK 18:8" />exennenne: δesenyawi elHeqqensen liyhliyh, emme as elli eyeddes bnaδem zeεme δeyaf eliman g elqeεεeθ?»<verse eid="LUK 18:8" /></para>
  <para style="s">elmθel nufariysi delli yetlayem g lefluws</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 18:9" />yen elmθele yleεbaδ kanen γersen eθθiyqeθ g imenensen elli nihnin δeSSuwlleH uHeqren g iddiynni: <verse eid="LUK 18:9" /><verse number="10" style="v" sid="LUK 18:10" />«sen δiryazen uliyen δezzallen g elHuwc nelqudus, iyjen δefariysi w wissen seg ihelli etleyamen g lefluws. <verse eid="LUK 18:10" /><verse number="11" style="v" sid="LUK 18:11" />ibed efariysi yezzal weHδes yen, &lt;SeHHiyt ya rebbi! εlexaTer meniyc emleεbaδ iddiynni, iĎemmaεen, eDDullam ezzanyen, ziyγ meniyc emwah elli yetlayem g lefluws. <verse eid="LUK 18:11" /><verse number="12" style="v" sid="LUK 18:12" />neč etzuwme g elimeθ merθiyn, wessufaγe g elεcer nelli essuδafe δiys elkul.&gt; <verse eid="LUK 18:12" /><verse number="13" style="v" sid="LUK 18:13" />emme wehelli yetlayem g lefluws ibed yebεeδ weligeddec eyqam tiTTewines lennej, emme ykan yetteddi f iδmernes uyeqqar, &lt;ya rebbi, ereHmiyδ neč δelγaleĎ.&gt; <verse eid="LUK 18:13" /><verse number="14" style="v" sid="LUK 18:14" />exennenne: wahen elli yetlayem g lefluws, muc efariysiydiyn, yeggez yelHuces yemmeqbel δeSSaleH γer rebbi. εlexaTer elli eyεelle imenes eyeggez, welli eyessuggez imenes eyali.»<verse eid="LUK 18:14" /></para>
  <para style="s">yesuwε yetbarex yidrari</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 18:15" />eγeδnes leεbaδ idrari Hette δimezyanen bac e yHuT fellasen ifesnes. max i nnezriyn etlamδe enzeren fellasen. <verse eid="LUK 18:15" /><verse number="16" style="v" sid="LUK 18:16" />yaxi inebaθen yesuwε yennasen: «edjeθ idrari eyyeddasen wenterremc, εlexaTer elmemlxeθ nrebbi yelli emnihnin. <verse eid="LUK 18:16" /><verse number="17" style="v" sid="LUK 18:17" />exennenne elHeq: elli liqebbelc elmemlxeθ nrebbi emmufruwx eθyetteδefc.»<verse eid="LUK 18:17" /></para>
  <para style="s">eryaz emuγni</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 18:18" />yenceδt iyjen seg imeqqaren nuδayen erruwyyes: «eyimuεellem eSSaleH δmette δege bac e θurθe edder diyme?» <verse eid="LUK 18:18" /><verse number="19" style="v" sid="LUK 18:19" />yer felles yesuwε: «imette etnabiyδ δiyye eyeSSaleH? eSSaleH kan δrebbi weHδes. <verse eid="LUK 18:19" /><verse number="20" style="v" sid="LUK 18:20" />cex tesseneδ elwSaye, &lt;eθezniyc, eθenγec, eθexrec, eθecehδc s ezzuwr, kerrem daddex dyemmex.&gt;» <verse eid="LUK 18:20" /><verse number="21" style="v" sid="LUK 18:21" />yen eryazdiyn: «seg max δemezyen uneč xeδme essisneθ.» <verse eid="LUK 18:21" /><verse number="22" style="v" sid="LUK 18:22" />max i yesle yesuwε edwiye wahen, yennes: «eltuciyex elHajeθ icθ, ezzenz elli γerx elkul tferqeδ elHeqqes f iqelliylen, usahen eyeδwel γerx elkenz g esmawaθ, tesδeδ eθbεiyδ.» <verse eid="LUK 18:22" /><verse number="23" style="v" sid="LUK 18:23" />yemenni max i yesle eryazdiyn edwiye yeHzen εlexaTer ykan δemuγni egget. <verse eid="LUK 18:23" /><verse number="24" style="v" sid="LUK 18:24" />yezri yesuwε yeHzen yen: «menyeθ yuεer aδef nimuγniyyen g elmelx nrebbi! <verse eid="LUK 18:24" /><verse number="25" style="v" sid="LUK 18:25" />aδef nwelγem g teHneyθ ntissiyniθ eshel nwaδef numuγni g elmelx nrebbi.» <verse eid="LUK 18:25" /><verse number="26" style="v" sid="LUK 18:26" />ennen yihelli sellen: «δ wiyn δeyemneε ziyγ?» <verse eid="LUK 18:26" /><verse number="27" style="v" sid="LUK 18:27" />yer yesuwε: «elli musteHiyl g leεbaδ yeshel γer rebbi.» <verse eid="LUK 18:27" /><verse number="28" style="v" sid="LUK 18:28" />yennes buTrus: «tay nečin nedje elli γenne neθbεax.» <verse eid="LUK 18:28" /><verse number="29" style="v" sid="LUK 18:29" />yer yesuwε: «exennenne elHeq: leHebbe Hette iyjen yedje elHuwc ziyγ ettemeTTuwθ ziyγ δemmaθen ziyγ δmidden ziyγ δidrari f elxaĎer nelmelx nrebbi, <verse eid="LUK 18:29" /><verse number="30" style="v" sid="LUK 18:30" />eyawi g eddunyeθe leDεaf nelli yedje, ugeddunyeθ elli δettes g ellexxer yedder diyme.»<verse eid="LUK 18:30" /></para>
  <para style="s">yesuwε eyeθnebbe elmerreθ xlaf s temettentes dwekkeres</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 18:31" />yawi etlamδe leθnac weHδasen yennasen: «tay nečin δenali yuwrceliym, welli uryent elkul lenbye f ebnaδem δeySar, <verse eid="LUK 18:31" /><verse number="32" style="v" sid="LUK 18:32" />εlexaTer δeyemmuwc ytimuwre tiberreniyyin, eSSen felles ecemten δiys eskufsen felles, <verse eid="LUK 18:32" /><verse number="33" style="v" sid="LUK 18:33" />usiyn δeθewθen s eSSuwT eθenγen, was eθθaleθ eyekker.» <verse eid="LUK 18:33" /><verse number="34" style="v" sid="LUK 18:34" />yemenni ellefhimenc etlamδe Hette cey, edwiye ykan yemmeHrez fellasen weθefhimenc.<verse eid="LUK 18:34" /></para>
  <para style="s">yesuwε eysebre ileεmi</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 18:35" />umax i yeqreb yesuwε seg eriyHa, w ykan yelle eryaz δileεmi ygeεmez f eccafeθ nwebriδ iĎelleb. <verse eid="LUK 18:35" /><verse number="36" style="v" sid="LUK 18:36" />max i yHus s uθεeddi nleεbaδ yenceδ: «δmette wahen?» <verse eid="LUK 18:36" /><verse number="37" style="v" sid="LUK 18:37" />ennanes: «yesuwε ennaSri δeyeθεedde esyah.» <verse eid="LUK 18:37" /><verse number="38" style="v" sid="LUK 18:38" />izeεweg ileεmi: «yesuwε, eyemmiys ndawud elmlek, ereHmiyδ!» <verse eid="LUK 18:38" /><verse number="39" style="v" sid="LUK 18:39" />enzren felles elli s ezzaθ bac e yesger, yaxi yeqqiym yetzeεweg exθer: «eyemmiys ndawud, ereHmiyδ!» <verse eid="LUK 18:39" /><verse number="40" style="v" sid="LUK 18:40" />ibed yesuwε yennasen eθseqerben etweliys. max i yeqreb yenceδt: <verse eid="LUK 18:40" /><verse number="41" style="v" sid="LUK 18:41" />«δmette iθexseδ exege?» yennes: «exse ezre, ya siydiy!» <verse eid="LUK 18:41" /><verse number="42" style="v" sid="LUK 18:42" />yennes yesuwε: «erqeb, elimenex ymenεex.» <verse eid="LUK 18:42" /><verse number="43" style="v" sid="LUK 18:43" />yeδwel izer g elweqθes yeθbeε yesuwε unette iHemmeδ g rebbi. max i zriyn leεbaδdiyn elli ySar mejδen rebbi elkulhum.<verse eid="LUK 18:43" /></para>
  <chapter eid="LUK 18" />
  <chapter number="19" style="c" sid="LUK 19" />
  <para style="s">yesuwε dzekke</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 19:1" />yaδef yeriyHa yuyuwr δiys. <verse eid="LUK 19:1" /><verse number="2" style="v" sid="LUK 19:2" />w ykan yelle diyn eryaz ellesmes zekka, ykan δemeqqar nihelli etleyamen g lefluws, w ykan δemuγni. <verse eid="LUK 19:2" /><verse number="3" style="v" sid="LUK 19:3" />iHawel δeyzer δ wiyn nette yesuwε yaxi eligeddec εlexaTer nette δuqSiyr uleεbaδ egget. <verse eid="LUK 19:3" /><verse number="4" style="v" sid="LUK 19:4" />heδake εlac yezzel lezzaθ yali yeccejreθ nujimiys balek eyzer yesuwε elli δeyeθεedde esyiyn. <verse eid="LUK 19:4" /><verse number="5" style="v" sid="LUK 19:5" />max i yiweD yesuwε ywemxandiyn, yerqeb lennej yezri, yennes: «zekka eggez fiyseε εlexaTer yelzem eqqiyme g elHucex asse.» <verse eid="LUK 19:5" /><verse number="6" style="v" sid="LUK 19:6" />yeggez liyhliyh yefreH essis. <verse eid="LUK 19:6" /><verse number="7" style="v" sid="LUK 19:7" />max i zriyn leεbaδ wediyn ebδen etbecbcen: «yuwδef δeyeqqiym g elHuwc nweryaz elli muc SaleH.» <verse eid="LUK 19:7" /><verse number="8" style="v" sid="LUK 19:8" />ibed zekka yennes yyesuwε: «ya siydiy, tay neč δeθuwce ezyen nelmelxiyw yiqelliylen. w iδekan fukke iHed Haje eserre m netteθ erbεe merraθ.» <verse eid="LUK 19:8" /><verse number="9" style="v" sid="LUK 19:9" />yennes yesuwε: «emnaε yuseδ asse yelHuwce, εlexaTer eryaze δemmiys nibrahiym Hette ennette. <verse eid="LUK 19:9" /><verse number="10" style="v" sid="LUK 19:10" />εlexaTer bnaδem yuseδ bac e yHewwem f elli emmehlxen ymenneεθen.»<verse eid="LUK 19:10" /></para>
  <para style="s">elmθel neddinaraθ nuwreγ</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 19:11" />unihnin esseγδan yedwiye, yebδe δesenyeHke elmθel, εlexaTer yebδe yeqreb seg uwrceliym uleεbaδ etteεlaken elli elmemlxeθ nrebbi δeθeffeγ g elweqtdiyn. <verse eid="LUK 19:11" /><verse number="12" style="v" sid="LUK 19:12" />yen: «eryaz seg elεiyleθ ettemeqqarθ yexDem ytemuwreθ tebεeδ bac e yawi elmemlxeθ yeδwel. <verse eid="LUK 19:12" /><verse number="13" style="v" sid="LUK 19:13" />inabe ixeddemnes elεecre, yucasen elqeĎεaθ nuwreγ yennasen, &lt;tajreθ essisneθ elδeddase.&gt; <verse eid="LUK 19:13" /><verse number="14" style="v" sid="LUK 19:14" />emme leεbaδ ntemurθes kanen eθγisenc, eznen δefres eljmaεeθ bac e nnen, &lt;enγiyc exenyeHkem eryaze.&gt; <verse eid="LUK 19:14" /><verse number="15" style="v" sid="LUK 19:15" />yeδwel δelmlek, yrewweH ytemurθes. ynabe εecrediyn nixeddamen elli yuceyasen lefluws bac e yerqeb δmette yrebHen g tinzinsen. <verse eid="LUK 19:15" /><verse number="16" style="v" sid="LUK 19:16" />yeseδ emezwar yennes, &lt;ya siydiy, elkeεbθex tuγeδ εecre δelkeεbaθ.&gt; <verse eid="LUK 19:16" /><verse number="17" style="v" sid="LUK 19:17" />yennes, &lt;SeHHiyt, eyexeddam ebehhay. εlexaTer tesθeHfĎeδ f qiqqi, δexHuTTe eθeHkmeδ f εecre ettimuwre.&gt; <verse eid="LUK 19:17" /><verse number="18" style="v" sid="LUK 19:18" />yeseδ eθθani yen, &lt;ya siydiy, elkeεbθex tuγeδ xemse δelkeεbaθ.&gt; <verse eid="LUK 19:18" /><verse number="19" style="v" sid="LUK 19:19" />yennes, &lt;ucex δeθeHukmeδ xemse ettimuwre.&gt; <verse eid="LUK 19:19" /><verse number="20" style="v" sid="LUK 19:20" />yeseδ iyjen xlaf yen, &lt;ya siydiy, tay egliyx uDyat g eθmendiylt eHerzat, <verse eid="LUK 19:20" /><verse number="21" style="v" sid="LUK 19:21" />εlexaTer kane ettekkaδe essix, cex δeryaz tuεereδ, etfukkeδ g elli ettuciyc weθmedjreδ g elli ettezriyεec.&gt; <verse eid="LUK 19:21" /><verse number="22" style="v" sid="LUK 19:22" />yennes siydiys, &lt;s edwiyx δeHukme fellex eyexeddam emuwHac! tesseneδ elli neč uεere, etfukke g elli eθuciyγc umedjre g elli eθezriεac. <verse eid="LUK 19:22" /><verse number="23" style="v" sid="LUK 19:23" />emmale imette eltHuTTec ziyγ leflusiyw g elbankeθ, umax eδuwle eθewye s ellentiriys?&gt; <verse eid="LUK 19:23" /><verse number="24" style="v" sid="LUK 19:24" />usiyn yenne yelli bedden diyn, &lt;ewyeθ s γers elkeεbetdiyn tuwcemt yelli γers εecre δelkeεbaθ.&gt; <verse eid="LUK 19:24" /><verse number="25" style="v" sid="LUK 19:25" />ennanes, &lt;ya siydiy, γers εecre δelkeεbaθ!&gt; <verse eid="LUK 19:25" /><verse number="26" style="v" sid="LUK 19:26" />yer fellasen, &lt;enniγawem elli γers esyemmuc exθer, welli γers δruws Hette δelli γers δesyemfuk. <verse eid="LUK 19:26" /><verse number="27" style="v" sid="LUK 19:27" />emme elεδuwwiyw elli eyγisenc enneHkme, eγδemten eldahen teγrsemten ezzeθiyw.&gt;»<verse eid="LUK 19:27" /></para>
  <para style="s">yesuwε eyaδef uwrceliym</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 19:28" />beεεeδ iyenne yesuwε wahen, ykemmel ebriδes yetwali uwrceliym. <verse eid="LUK 19:28" /><verse number="29" style="v" sid="LUK 19:29" />max i yeqreb yetwali biytfaji dbiytεenya, g eddehreθ elli temmessen s eddehreθ nuzemmuwr, yuzen sen seg etlemδas, yennasen: <verse eid="LUK 19:29" /><verse number="30" style="v" sid="LUK 19:30" />«berreθ ytemuwreθ elli eθqablawem, umax etteδfem eθafem ejjeHc yemmeqqen elyiyni felles Hette Hed, miremt teγδemt eldahen. <verse eid="LUK 19:30" /><verse number="31" style="v" sid="LUK 19:31" />umax exenyenceδ la δHed, &lt;imette etmerem δiys?&gt; enmes, &lt;siydiy yeseθHeqqi.&gt;» <verse eid="LUK 19:31" /><verse number="32" style="v" sid="LUK 19:32" />exeDmen etlemδadiyn elli yuzenten afen emmax i senyenne siydiynsen. <verse eid="LUK 19:32" /><verse number="33" style="v" sid="LUK 19:33" />max i bδen etmaren g ejjeHc yenneyasen iθbebes: «imette itmarem g ejjeHc?» <verse eid="LUK 19:33" /><verse number="34" style="v" sid="LUK 19:34" />erren felles: «siydiy yeseθHeqqi.» <verse eid="LUK 19:34" /><verse number="35" style="v" sid="LUK 19:35" />ewyent yyesuwε, HuTTen edbecensen f ejjeHc essiynen yesuwε f elles. <verse eid="LUK 19:35" /><verse number="36" style="v" sid="LUK 19:36" />max i yebδe yegguwr, essewen edbecensen f webriδ. <verse eid="LUK 19:36" /><verse number="37" style="v" sid="LUK 19:37" />max i yeqreb uggeggez neddehreθ nuzemmuwr, ebδen elli eθbεenti elkul etzeεwgen ferHeniyn etmejδen g rebbi f elmuεjzaθ elli zrintent elkul, <verse eid="LUK 19:37" /><verse number="38" style="v" sid="LUK 19:38" />weqqaren: «δemebruwx elmlek elli δeyeddes s ellesm nrebbi! eslam g esme welmejδ g lennej!» <verse eid="LUK 19:38" /><verse number="39" style="v" sid="LUK 19:39" />ennanes eljmaεeθ seg elHezb nifarisiyyen elli diyn: «eyimuεellem, enzer f etlemδax.» <verse eid="LUK 19:39" /><verse number="40" style="v" sid="LUK 19:40" />yer fellasen: «exennenne, lukan esegren iyhen ture eyzeεweg elkurδ.»<verse eid="LUK 19:40" /></para>
  <para style="s">yesuwε iθerw f uwrceliym</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 19:41" />max i yeqreb yezer θemuwreθ, iεeyyeĎ felles. <verse eid="LUK 19:41" /><verse number="42" style="v" sid="LUK 19:42" />yen: «lukan Hette δcem tesseneδ g wessem wahen s mette iyetmage eslam! emme wediyn yemmiyreD f tiTTewinem ture. <verse eid="LUK 19:42" /><verse number="43" style="v" sid="LUK 19:43" />δeyeddes as enDen fellem elεδuwwem isekker fellem εeddayer. <verse eid="LUK 19:43" /><verse number="44" style="v" sid="LUK 19:44" />essendernem cem didreriym elli uggemmesem, wettedjiync δiym Hette tγaγet δenni weltmas, εlexaTer eltessinec elweqθ elli δemedyes δiys rebbi.»<verse eid="LUK 19:44" /></para>
  <para style="s">yesuwε eygelleb elli ezzenzen seg elheykel</para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 19:45" />yaδef yelHuwc nelqudus, yebδe yetgelleb g elli ezzenzen wessaγen uggemmeses, <verse eid="LUK 19:45" /><verse number="46" style="v" sid="LUK 19:46" />unette yeqqerasen: «yemmari: elHuciyw δemxan neθzelliyθ. emme xenyum terriymt ettiyriθ niquδεiyyen.» <verse eid="LUK 19:46" /><verse number="47" style="v" sid="LUK 19:47" />w ykan yetseqre kul yuwm g elHuwc nelqudus. imeqqaren nelkuhhan dimufesren necceriyεeθ diwessaren exsen eθenγen. <verse eid="LUK 19:47" /><verse number="48" style="v" sid="LUK 19:48" />yemenni ellufinc δmette δegen εlexaTer leεbaδ elkul kanen emmeqnen g edwiys.<verse eid="LUK 19:48" /></para>
  <chapter eid="LUK 19" />
  <chapter number="20" style="c" sid="LUK 20" />
  <para style="s">eSSulteθ elli θemmuwc yyesuwε</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 20:1" />yelle as unette yetseqre g leεbaδ g elHuwc nelqudus uyetbeccer g elbcareθ, bednes emeqqar nelkuhhan dimufesren necceriyεeθ wiyδsen iwessaren, <verse eid="LUK 20:1" /><verse number="2" style="v" sid="LUK 20:2" />ennanes: «ennene s mette elquδreθ elli ettegeδ essis elli θegit? ziyγ δ wiyn exyserreH?» <verse eid="LUK 20:2" /><verse number="3" style="v" sid="LUK 20:3" />yer fellasen: «neč zade δexennencδe f elHajeθ. enmiyδ: <verse eid="LUK 20:3" /><verse number="4" style="v" sid="LUK 20:4" />temeεmuwdiyyeθ elli yegin yuwHenna seg esme ziyγ s γer leεbaδ?» <verse eid="LUK 20:4" /><verse number="5" style="v" sid="LUK 20:5" />eθcawren g beεDhum ennen: «kan nenne, &lt;seg esma&gt; δexenyen, &lt;imette eltemminemc essis?&gt; <verse eid="LUK 20:5" /><verse number="6" style="v" sid="LUK 20:6" />emme max enen, &lt;s γer leεbaδ&gt; leεbaδ elkul δexenHajren, εlexaTer δimeqtenεen s elli yuwHenna δenbi.» <verse eid="LUK 20:6" /><verse number="7" style="v" sid="LUK 20:7" />elweqθes erren elli nihnin ellessinenc s meniys. <verse eid="LUK 20:7" /><verse number="8" style="v" sid="LUK 20:8" />yennasen yesuwε: «uneč exenneqqerac s mette elquδreθ elli ettege essis elHwayeje.»<verse eid="LUK 20:8" /></para>
  <para style="s">elmθel nifellaHen n elεneb</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 20:9" />yebδe yHekke yleεbaδ s elmiθale: «yezzu elεebδ elεneb yuwci yifellaHen, yexDem ytemuwreθ iεeTTel egget. <verse eid="LUK 20:9" /><verse number="10" style="v" sid="LUK 20:10" />g elweqθ nwekkas nelεneb yuzen yifellaHendiyn exeddam bac e suwcen elHeSθes nelεneb, yaxi ifellaHen ewθent rejεent wifesnes δelfurraγ. <verse eid="LUK 20:10" /><verse number="11" style="v" sid="LUK 20:11" />yeznasen iyjen xlaf. ewθent Hecment f imenes ezennesθ wifesnes δelfurraγ. <verse eid="LUK 20:11" /><verse number="12" style="v" sid="LUK 20:12" />iεaweδ yuzen iyjen δeθθaleθ, izment gelbent elberre nelεneb. <verse eid="LUK 20:12" /><verse number="13" style="v" sid="LUK 20:13" />elweqθes yen iθbab nelεneb, &lt;δmette δege? δesennezne memmi elli exsaθ balek eθqedren.&gt; <verse eid="LUK 20:13" /><verse number="14" style="v" sid="LUK 20:14" />yemenni max i θezriyn ifellaHen, ennen yimenensen, &lt;δwahen elli δeyuwreθ, edj eθnenγ usahen ennečin enuwreθ ejimiye.&gt; <verse eid="LUK 20:14" /><verse number="15" style="v" sid="LUK 20:15" />usiyn lewHent elberre nelεneb enγent. elweqθes δmette δesenyeg iθbab nelεneb? <verse eid="LUK 20:15" /><verse number="16" style="v" sid="LUK 20:16" />δeyeddes yenγ ifellaHendiyn yuwc elεnebdiyn yleεbaδ xlaf.» elli kanen sellen g wahen, ennan: «Hace!» <verse eid="LUK 20:16" /><verse number="17" style="v" sid="LUK 20:17" />yerqebθen yennasen: «ac meεnahe emmale ellayeθe, &lt;tγaγet elli lewHent ibennayen ennetteθ elli ibed felles essas neccuwkeθ.&gt;? <verse eid="LUK 20:17" /><verse number="18" style="v" sid="LUK 20:18" />elli eyuDe f eθγaγetdiyn etkesser, welli eθuDe felles etterHe.» <verse eid="LUK 20:18" /><verse number="19" style="v" sid="LUK 20:19" />exeDmen emeqqar nelkuhhan dimufesren necceriyεeθ bac e θeTfen g elweqθes εlexaTer yeqSetten s elmiθale, yemenni ukkeδen seg leεbaδ.<verse eid="LUK 20:19" /></para>
  <para style="s">eδfaε neljezyeθ yelqeySer</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 20:20" />elweqθes ebδen etεussen felles, seyben δefres iεessasen elli ettegen g imenensen bhan. bac e θeTfen s tuθleyθ δetyen, uwcent yelquδreθ nelwali nerruwman. <verse eid="LUK 20:20" /><verse number="21" style="v" sid="LUK 20:21" />ennen necδen δiys: «eyimuεellem, nessen elli eddukkiyδ tesseqriyδ s elHeq, weltlehhiyc s elmeDaher nleεbaδ, emme tesseqriyδ uggebriδ nrebbi s elHeq. <verse eid="LUK 20:21" /><verse number="22" style="v" sid="LUK 20:22" />endre yelzemne eneδfeε eljezyeθ yellembratuwr nerruwman ziyγ la?» <verse eid="LUK 20:22" /><verse number="23" style="v" sid="LUK 20:23" />ifaq essis yennasen: <verse eid="LUK 20:23" /><verse number="24" style="v" sid="LUK 20:24" />«essexnmiyδ eddiynar. etteSwiyreθ denqiyceθ, nwiyn?» erren felles: «yqeySer.» <verse eid="LUK 20:24" /><verse number="25" style="v" sid="LUK 20:25" />yennasen: «emmale uwceθ elli yqeySer yqeySer, welli yrebbi yrebbi.» <verse eid="LUK 20:25" /><verse number="26" style="v" sid="LUK 20:26" />welgeddenc eθeTfen s tuθleyθ ezzaθ nleεbaδ, esegren unihnin medhuciyn seg edwiys.<verse eid="LUK 20:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 20:27" />esδen elHezb niSedduwqiyyen elli ettesθeεrifenc s elqyameθ, encδent: <verse eid="LUK 20:27" /><verse number="28" style="v" sid="LUK 20:28" />«eyimuεellem, yuryane muwse, &lt;max eyjaf enjes nweryaz yedj temeTTuwθ menγiyr idrari, eryaze yelzem ayeγ temeTTuwθe bac e yeddeγ essis idrari yenjes.&gt; <verse eid="LUK 20:28" /><verse number="29" style="v" sid="LUK 20:29" />kanen ellan sebεe δemmaθen, emezwar yuγe yjaf welyedjiyc idrari, <verse eid="LUK 20:29" /><verse number="30" style="v" sid="LUK 20:30" />yaγiθ eθθani, <verse eid="LUK 20:30" /><verse number="31" style="v" sid="LUK 20:31" />usiyn δeθθaleθ, elδettaγen elkulhum jafen welledjiync idrari. <verse eid="LUK 20:31" /><verse number="32" style="v" sid="LUK 20:32" />usiyn eθjaf Hette ettemeTTuwθ. <verse eid="LUK 20:32" /><verse number="33" style="v" sid="LUK 20:33" />as xlaf, δliwec n menten essisen δeθeδwel, maδame tuγiyn elkul?» <verse eid="LUK 20:33" /><verse number="34" style="v" sid="LUK 20:34" />yer fellasen yesuwε: «idrari nelweqθe ettaγen wetmaγen, <verse eid="LUK 20:34" /><verse number="35" style="v" sid="LUK 20:35" />emme emmeHsben ettesθehalen emxan g eddunyeθ tissent delqyameθ seg ihelli jafen, etteγenc wetmeγiync, <verse eid="LUK 20:35" /><verse number="36" style="v" sid="LUK 20:36" />elgeddenc ejafen xlaf εlexaTer δeδuwlen emelmleyxaθ. unihnin δidrari nrebbi εlexaTer δidrari nelqyameθ. <verse eid="LUK 20:36" /><verse number="37" style="v" sid="LUK 20:37" />emme inemmitte ettekren, Hette δmuwse yenne edwiye max i yeHke f elεafyeθ nelεelliyge, max i ysemme rebbi erreb nibrahiym derreb nisHaq derreb nyeεquwb. <verse eid="LUK 20:37" /><verse number="38" style="v" sid="LUK 20:38" />muc δerreb ninemmitte emme δerreb nelli edderen, εlexaTer elkulhum etteddernes ynette.» <verse eid="LUK 20:38" /><verse number="39" style="v" sid="LUK 20:39" />ennen lebHaD nimufesren necceriyεeθ: «terriyδ belgde eyimuεellem!» <verse eid="LUK 20:39" /><verse number="40" style="v" sid="LUK 20:40" />seg elweqtdiyn eθyenciyδ Hette Hed.<verse eid="LUK 20:40" /></para>
  <para style="s">elmesiyH ddawud</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 20:41" />yennasen: «max ennen elli elmesiyH δmemmis ndawud? <verse eid="LUK 20:41" /><verse number="42" style="v" sid="LUK 20:42" />εlexaTer dawud biyδe yeqqar g elxθab nelmzamiyr, &lt;yenne rebbi ysiydiyw: geεmez f elyminiyw, <verse eid="LUK 20:42" /><verse number="43" style="v" sid="LUK 20:43" />bac e HuTTe elεδewwex seddu ikreεnex.&gt; <verse eid="LUK 20:43" /><verse number="44" style="v" sid="LUK 20:44" />dawud biyδe yetnabe δiys rebbi. emmale max δeyeδwel δmemmis?»<verse eid="LUK 20:44" /></para>
  <para style="s">yesuwε yetnebbeh seg imuεelmen necceriyεeθ</para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 20:45" />yen yetlemδas uleεbaδ elkul sellen: <verse eid="LUK 20:45" /><verse number="46" style="v" sid="LUK 20:46" />«erreθ elbelennum seg elkuttab elli exsen teyuwriθ sedbac useεen, wexsen emHeyyen g essaHaθ delblayeS tuggezzaθin g elmjameε dimensiywen, <verse eid="LUK 20:46" /><verse number="47" style="v" sid="LUK 20:47" />tetten g werzi ntidjalin wessexnan g imenensen etĎewlen g eθzalliyθ. iyhen δeyeggez fellasen elεδab egget.»<verse eid="LUK 20:47" /></para>
  <chapter eid="LUK 20" />
  <chapter number="21" style="c" sid="LUK 21" />
  <para style="s">eddiynar ntehejjelt</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 21:1" />max i yqam yesuwε ixfes yerqeb yezre imuγniyyen etHuTTen g lefluws g eSSenduwq elli g elHuwc nelqudus. <verse eid="LUK 21:1" /><verse number="2" style="v" sid="LUK 21:2" />yezer tedjalt etteqelliylt eθHuT sen δelfrenkaθ. <verse eid="LUK 21:2" /><verse number="3" style="v" sid="LUK 21:3" />yen: «exennenne elHeq, tedjalte teqelliylt eθHuT exθer niddiynni. <verse eid="LUK 21:3" /><verse number="4" style="v" sid="LUK 21:4" />εlexaTer nihnin HuTTen ezzayeδ f elHajθensen, yemenni netteθ tHuT elli eyezze ywedderes.»<verse eid="LUK 21:4" /></para>
  <para style="s">axreb nelheykel dwaxle neddunyeθ</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 21:5" />max i bδen leεbaδ Hekken f elheykel max δimzeyyen s elkurδ yebhe delli Sedqent leεbaδ, yen yesuwε: <verse eid="LUK 21:5" /><verse number="6" style="v" sid="LUK 21:6" />«wahen elli tzerrem δiys, δesyeddes as etqimiync δiys sent ettiγuwγe δenni beεDhum.» <verse eid="LUK 21:6" /><verse number="7" style="v" sid="LUK 21:7" />encδent: «lemmi δeySar wahen eyimuεellem? uδmette nihenti elεlameθes?» <verse eid="LUK 21:7" /><verse number="8" style="v" sid="LUK 21:8" />yennasen: «erreθ elbelennum bac e tmexδiεemc! εlexaTer δeddasen egget s ellesmiyw ennen, &lt;enneč nette&gt;, &lt;elweqθ yeqreb&gt;, enteθbεemc. <verse eid="LUK 21:8" /><verse number="9" style="v" sid="LUK 21:9" />umax eθeslem s leHruwb duxaDi, etemmerεbemc, εlexaTer wahen yelzem eySar qebl, emme ellaxreθ etteseδc beεδensen gedged.» <verse eid="LUK 21:9" /><verse number="10" style="v" sid="LUK 21:10" />usiyn yenneyasen: «timuwre δelmemlxaθ δekkerneθ f beεDhum, <verse eid="LUK 21:10" /><verse number="11" style="v" sid="LUK 21:11" />δeddasen ezlazel δimeqqaren delmjaεaθ delwbayaθ, effeγneθ elεlamaθ essekkaδneθ dellayeθ ettimeqqarin seg esme. <verse eid="LUK 21:11" /><verse number="12" style="v" sid="LUK 21:12" />emme qebl wahen elkul, leεbaδ δezlen fellawem ifesnensen εeδδebnawem, ucnawem yelmjameε dleHbuws, suqnawem bac e θbeddem ezzaθ nlemluwk delHukkam, uwahen elkul f elxeĎriyw enneč. <verse eid="LUK 21:12" /><verse number="13" style="v" sid="LUK 21:13" />emme wediyn δexenyuc elweqθ bac e θecehδem. <verse eid="LUK 21:13" /><verse number="14" style="v" sid="LUK 21:14" />emmale HuTTeθ g ulewnennum eθHeDremc edwinnum εle bekri. <verse eid="LUK 21:14" /><verse number="15" style="v" sid="LUK 21:15" />εlexaTer δexennuwce edwi delHekmeθ eliged Hette Hed ayer fellasen welle entyeεkes. <verse eid="LUK 21:15" /><verse number="16" style="v" sid="LUK 21:16" />Hette δmidnennum δexenselmen demmeθnennum delli qrebnawem dimeddukelennum, uyelle essiywem δ wiyn δeyemmenγ. <verse eid="LUK 21:16" /><verse number="17" style="v" sid="LUK 21:17" />leεbaδ elkul δexennexrhen f elxaĎer nellesmiyw. <verse eid="LUK 21:17" /><verse number="18" style="v" sid="LUK 21:18" />emme Hette ecceεreθ seg ixfewnennum wetmekkes. <verse eid="LUK 21:18" /><verse number="19" style="v" sid="LUK 21:19" />s weTTefennum eSHiyH δeθerbHem imenennum.<verse eid="LUK 21:19" /></para>
  <para style="s">axle nuwrceliym dwaseδ nemmiys nebnaδem</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 21:20" />umax eθezrem uwrceliym enneDen felles elεsaker, rahu elweqθ nwexlas yeqreb. <verse eid="LUK 21:20" /><verse number="21" style="v" sid="LUK 21:21" />elweqθes elli g yehuwdiyye eruwlen yedhari, welli g elmdiyneθ ereHlen weθedjemc elli g ijiyman eserjεen. <verse eid="LUK 21:21" /><verse number="22" style="v" sid="LUK 21:22" />εlexaTer liyyamdiyn δliyyam nunteqmi δeySar δiysneθ elli yemmari g elxθab. <verse eid="LUK 21:22" /><verse number="23" style="v" sid="LUK 21:23" />emme yeHliylhum elli δeθeruwneθ delli essesfaneθ g liyyamdiyn, εlexaTer elqeεεeθ δeθeδyaq egget welγuc egget δeyeggez f leεbaδe, <verse eid="LUK 21:23" /><verse number="24" style="v" sid="LUK 21:24" />δeθuDan s essiyf emsuqqen δimerbaT ytimuwre elkul, teqqiym uwrceliym εefsen δiys timuwre tiberreniyyin eleyekmel elweqθ ntimuwre tiberreniyyin. <verse eid="LUK 21:24" /><verse number="25" style="v" sid="LUK 21:25" />uδeffeγneθ elεlamaθ g tefuwθ etteziyri diθran, teDyaq elqeεεeθ f leεbaδ elli Heyriyn εlexaTer iylel δeyhaj welmuwj δeyeεle. <verse eid="LUK 21:25" /><verse number="26" style="v" sid="LUK 21:26" />leεbaδ δeδaxen seg elxuwf duraji nelli δeyeddes f elqeεεeθ, εlexaTer elqewwaθ nesme δeδeδefneθ beεDhum. <verse eid="LUK 21:26" /><verse number="27" style="v" sid="LUK 21:27" />elweqθes ezren bnaδem yuseδ g esHab s elquwweθ delmejδ δemeqqar. <verse eid="LUK 21:27" /><verse number="28" style="v" sid="LUK 21:28" />umax eyebδe wahen yetSar, ekreθ tqamem ixfewnennum εlexaTer elfδennum yeqreb.»<verse eid="LUK 21:28" /></para>
  <para style="s">elmθel neccejreθ nelεneb</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 21:29" />yennasen elmθel: «erqbeθ ytemečiyθ deccejreθ tiddiynni, <verse eid="LUK 21:29" /><verse number="30" style="v" sid="LUK 21:30" />max eθeg tifray eθesnem elli enebδu yeqreb. <verse eid="LUK 21:30" /><verse number="31" style="v" sid="LUK 21:31" />sahen xenyum zade, max eθezrem elHajaθe, esneθ elli elmemlxeθ nrebbi teqreb. <verse eid="LUK 21:31" /><verse number="32" style="v" sid="LUK 21:32" />exennenne elHeq: lixeTTemc eljiyle kanc eySar wahen elkul. <verse eid="LUK 21:32" /><verse number="33" style="v" sid="LUK 21:33" />esme delqeεεeθ δexDemneθ, emme edwiyw δeyeqqiym diyme.<verse eid="LUK 21:33" /></para>
  <para style="s">yelzem elhe</para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 21:34" />emme erreθ elbelennum bac e tteδqelenc ulewnennum s ecciyxeθ dwesxar dlehmuwm neddunyeθ, yesδawem asdiyn menγiyr eθfaqem essis, <verse eid="LUK 21:34" /><verse number="35" style="v" sid="LUK 21:35" />rahu emelmendaf δeysekker f elli εemren g elqeεεeθ elkul. <verse eid="LUK 21:35" /><verse number="36" style="v" sid="LUK 21:36" />emmale esehreθ tezzallem diyme, bac e θemnεem s elli δeySar elkul, ubac e θbeddem ezzaθ nebnaδem.» <verse eid="LUK 21:36" /><verse number="37" style="v" sid="LUK 21:37" />g dugges ykan yetseqre g elHuwc nelqudus wegδeggiyδ ykan yetteffeγ elberre yetqiyme g eddehreθ elli temsemme eddehreθ nuzemmuwr. <verse eid="LUK 21:37" /><verse number="38" style="v" sid="LUK 21:38" />wegtalji bekri etteseδnes leεbaδ yelHuwc nelqudus bac e θesseγδen.<verse eid="LUK 21:38" /></para>
  <chapter eid="LUK 21" />
  <chapter number="22" style="c" sid="LUK 22" />
  <para style="s">elmuUemreθ delxiyyeneθ nyehuwδa</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 22:1" />yeqreb elεiyδ nelfĎiyr elli yemmessen s elfeSH. <verse eid="LUK 22:1" /><verse number="2" style="v" sid="LUK 22:2" />wimeqqaren nelkuhhan dimufesren necceriyεeθ elluciyn etHewmen max δenγen yesuwε g esser, εlexaTer ettekkaδen seg leεbaδ. <verse eid="LUK 22:2" /><verse number="3" style="v" sid="LUK 22:3" />elweqθes yaδef ibliys g yehuwδa elli yemmessen s esxeryuwTiy, unette g elεded netlamδe eθnac. <verse eid="LUK 22:3" /><verse number="4" style="v" sid="LUK 22:4" />yexDem yeHke dimeqqaren nelkuhhan dimeshal niεessasen neljiyc max δeyeγδer yesuwε. <verse eid="LUK 22:4" /><verse number="5" style="v" sid="LUK 22:5" />eferHen uεδent elli δesuwcen lefluws. <verse eid="LUK 22:5" /><verse number="6" style="v" sid="LUK 22:6" />yeqbel, yebδe yetraje lemmi δeθyeγδer lebεiyδ f leεbaδ.<verse eid="LUK 22:6" /></para>
  <para style="s">eHeDDer yumensi nelfeSH</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 22:7" />yuseδ as nelfĎiyr elli yelzem emmeγrsen δiys iεellec nelfeSH. <verse eid="LUK 22:7" /><verse number="8" style="v" sid="LUK 22:8" />yezen yesuwε buTrus dyuwHenna yennasen: «berreθ eθHeDDermane elfeSH bac e neč.» <verse eid="LUK 22:8" /><verse number="9" style="v" sid="LUK 22:9" />ennanes: «meni iθexseδ enHeDDer?» <verse eid="LUK 22:9" /><verse number="10" style="v" sid="LUK 22:10" />yennasen: «max eθeδfem θemuwreθ, exenyeεreD elεebδ yqam teqliylt nwamen. eθebεemt yelHuwc elli δeθyaδef, <verse eid="LUK 22:10" /><verse number="11" style="v" sid="LUK 22:11" />tennem yiθbab nelHuwc, &lt;yennayex imuεellem mani tezeqqe nleDyuwf elli δeče δiys elfeSH neč detlemδaw?&gt; <verse eid="LUK 22:11" /><verse number="12" style="v" sid="LUK 22:12" />δexenyesxen tγuwrfet ettemeqqarθ temmessu, HeDreθ diyn.» <verse eid="LUK 22:12" /><verse number="13" style="v" sid="LUK 22:13" />exeDmen afen kul cey emmax i senyenne, HeDren elfeSH.<verse eid="LUK 22:13" /></para>
  <para style="s">emensi n erreb</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 22:14" />umax i yedduwse elweqθ, yettekke f eTTawleθ wimersal leθnac iyδes. <verse eid="LUK 22:14" /><verse number="15" style="v" sid="LUK 22:15" />yennasen: «ecθhiyγ egget eče iyδwem elfeSHe wahen qebl eθwejεe. <verse eid="LUK 22:15" /><verse number="16" style="v" sid="LUK 22:16" />εlexaTer exennenne: eltettac essis elδeyekmel g elmelx nrebbi.» <verse eid="LUK 22:16" /><verse number="17" style="v" sid="LUK 22:17" />elweqθes yqam elkas yecxer, yen: «eTfeθ zuwnemt f beεDkum, <verse eid="LUK 22:17" /><verse number="18" style="v" sid="LUK 22:18" />εlexaTer exennenne elsessac seg ecrabe elδeθeddes elmemlxeθ nrebbi.» <verse eid="LUK 22:18" /><verse number="19" style="v" sid="LUK 22:19" />yerni yqam eγrum, umax i yecxer ykesserθ yezlesent, yennasen: «tay wahen elbeδniyw elli yemmucawem, egeθ sahen diyme bac e yθesfekrem.» <verse eid="LUK 22:19" /><verse number="20" style="v" sid="LUK 22:20" />ukiyfkiyf elkas beεεeδ emensi, yen: «elkase δ elmiθaq δejδiyδ mabinatne s iδemniyw elli δemwezεen f elxeĎrennum. <verse eid="LUK 22:20" /><verse number="21" style="v" sid="LUK 22:21" />emme elli δeyyezzenz efuses tayeθ iyδi f eTTawleθ. <verse eid="LUK 22:21" /><verse number="22" style="v" sid="LUK 22:22" />bnaδem δeyexDem emmax i syemqerrer, emme yeHliyle elεebδ elli δeθyezzenz.» <verse eid="LUK 22:22" /><verse number="23" style="v" sid="LUK 22:23" />ebδen necδen g beεDhum δ wiyn essisen δeyeg wediyn.<verse eid="LUK 22:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 22:24" />emεanden zade δ wiyn δeyemmeHseb emeqqerensen. <verse eid="LUK 22:24" /><verse number="25" style="v" sid="LUK 22:25" />yennasen: «lemluwk nleεbaδ Hekmen δiysen, welli γersen elquδreθ ettemsemman imuHsnen. <verse eid="LUK 22:25" /><verse number="26" style="v" sid="LUK 22:26" />emme xenyum muc kiyfkiyf, edjeθ emeqqerennum emumezyenennum, welli yetsiyyer emuxeddam. <verse eid="LUK 22:26" /><verse number="27" style="v" sid="LUK 22:27" />δ wiyn ekber: elli yettettekke ziyγ δelli yxeddem? muc δelli yettettekke? emme neč uggemmesennum emelli yxeddem. <verse eid="LUK 22:27" /><verse number="28" style="v" sid="LUK 22:28" />δxenyum elli θbeddem iyδi g elmHeyniyw. <verse eid="LUK 22:28" /><verse number="29" style="v" sid="LUK 22:29" />uneč δexennuwce, emmax i yuwce dadde, elmemlxeθ, <verse eid="LUK 22:29" /><verse number="30" style="v" sid="LUK 22:30" />bac e θečem teswem f elmittiyw g elmelxiyw, uδeθeqqiymem f elkrasi eθHekmem lesbuwT nisraYiyl leθnac.<verse eid="LUK 22:30" /></para>
  <para style="s">yesuwε eyeθnebbe s wenker nbuTrus</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 22:31" />semεan, semεan! tay ibliys yeĎleb bac e xenyγerbel emiyrδen, <verse eid="LUK 22:31" /><verse number="32" style="v" sid="LUK 22:32" />emme ezzalle f elxeĎrex bac liweTTiyc elimenex. ucex max eθerjεeδ bed demmeθnex.» <verse eid="LUK 22:32" /><verse number="33" style="v" sid="LUK 22:33" />yennes: «ya siydiy, neč HaDer bac e xeDme iyδex yelHebs dujafi.» <verse eid="LUK 22:33" /><verse number="34" style="v" sid="LUK 22:34" />yen yesuwε: «buTrus, exenne, qebl eyedden eyaziyĎ asse, δeyθenkreδ tlaθe merraθ.»<verse eid="LUK 22:34" /></para>
  <para style="s">eHeDDer yelmeHneθ temeqqarθ</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 22:35" />yennasen: «max i xennuzne menγiyr teSriyrθ nlefluws ula δisiyres ula δeSSendal, tesθHeqqem Haje?» erren felles: «Hette cey.» <verse eid="LUK 22:35" /><verse number="36" style="v" sid="LUK 22:36" />yennasen: «uture elli γers lefluws enyawi, kiyfkiyf elli γers isiyres. welli leγrec essiyf, edj eyezzenz edbeces yeseγ essiyf. <verse eid="LUK 22:36" /><verse number="37" style="v" sid="LUK 22:37" />εlexaTer exennenne: elli yemmari yelzem eySar felle, &lt;uyemmeHseb seg imujrmen.&gt; welli yemmari felle eyeddes elweqθ ySar.» <verse eid="LUK 22:37" /><verse number="38" style="v" sid="LUK 22:38" />ennen: «ya siydiy, tay sen δlesyuwf dahen.» yennasen: «yezzi!»<verse eid="LUK 22:38" /></para>
  <para style="s">yesuwε yetzalle g eddehreθ nuzemmuwr</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 22:39" />yeffeγ yexDem emelεaδeθ yeddehreθ nuzemmuwr, eθbεent etlemδas zade. <verse eid="LUK 22:39" /><verse number="40" style="v" sid="LUK 22:40" />max i yiweD ywemxan yenneyasen: «ezzalleθ bac e xentjerbenc.» <verse eid="LUK 22:40" /><verse number="41" style="v" sid="LUK 22:41" />yebεeδ fellasen eHδaf netγaγet, yerkeε yetzalle. <verse eid="LUK 22:41" /><verse number="42" style="v" sid="LUK 22:42" />yen: «edda, kan texseδ beεεeδ felle elkase nelεδab, muc emmax i xse neč emme emmax i θexseδ cex.» <verse eid="LUK 22:42" /><verse number="43" style="v" sid="LUK 22:43" />yeffeγes elmlax seg esme yetqewwe δiys. <verse eid="LUK 22:43" /><verse number="44" style="v" sid="LUK 22:44" />unette ykan δimeθδayeq yebδe yetzalle eSbiyH, elδeθeδwel tiδiys emiδammen etqeTTer f elqeεεeθ. <verse eid="LUK 22:44" /><verse number="45" style="v" sid="LUK 22:45" />usiyn yekker seg eθzalliθ yeseδ yetlemδas yafin enεesen seg elHzen. <verse eid="LUK 22:45" /><verse number="46" style="v" sid="LUK 22:46" />yennasen: «imette iθenεsem? ekreθ tezzallem bac e tteδfemc g ettejrbeθ.»<verse eid="LUK 22:46" /></para>
  <para style="s">aTTef nyesuwε</para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 22:47" />unette elyuwc iδukke, eseδnes eljmaεeθ ezzeθensen wediyn elli yemsemme yehuwδa, unette δiyjen seg etlamδe eθnac. yeqreb yyesuwε bac e θikub. <verse eid="LUK 22:47" /><verse number="48" style="v" sid="LUK 22:48" />yennes yesuwε: «yehuwδa, tγedreδ g ebnaδem s ukubbi?» <verse eid="LUK 22:48" /><verse number="49" style="v" sid="LUK 22:49" />elli iyδes max i zriyn elli yetSar encδent: «ya siydiy, enuwweθ s essiyf?» <verse eid="LUK 22:49" /><verse number="50" style="v" sid="LUK 22:50" />yewweθ iyjen essisen exeddam nerrayes nelkuhhan yquS θemedjiyθ nelimiyn. <verse eid="LUK 22:50" /><verse number="51" style="v" sid="LUK 22:51" />yemenni yer yesuwε: «meεεač eθerniyyem!» ilemses θemedjiθes tebre. <verse eid="LUK 22:51" /><verse number="52" style="v" sid="LUK 22:52" />usiyn yenne yesuwε yimeqqaren nelkuhhan dimeshal niεessasen nelHuwc nelqudus diwessaren, elli effeγen felles: «endre teffeγem f uxennab, s lesyuwfe etγeryiyne? <verse eid="LUK 22:52" /><verse number="53" style="v" sid="LUK 22:53" />max ykane iyδwem kul yuwm g elHuwc nelqudus, eltezzilemc ifesnennum felle. emme essaεeθe yxenyum, welHkum yeθsellesθ ture.»<verse eid="LUK 22:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 22:54" />emmale eTfent ewyent yelHuwc numeqqar nelkuhhan. yeθbeεθ buTrus seg lebεiyδ.<verse eid="LUK 22:54" /></para>
  <para style="s">buTrus eyenker yesuwε</para>
  <para style="p">
    <verse number="55" style="v" sid="LUK 22:55" />max i ceεlen elεafyeθ uggemmes nelHuwc enden felles, yeqqiym buTrus iyδsen. <verse eid="LUK 22:55" /><verse number="56" style="v" sid="LUK 22:56" />tezri texeddamt ygeεmez yetwali elεafyeθ, tθebbeθ δiys ten: «eryaze zade ykan iyδes.» <verse eid="LUK 22:56" /><verse number="57" style="v" sid="LUK 22:57" />yemenni yenker, yen: «eθessinac etemeTTuwθ.» <verse eid="LUK 22:57" /><verse number="58" style="v" sid="LUK 22:58" />beεεeδ lewse yezri iyjen xlaf yen: «cex iyδsen zade.» yemenni yen buTrus: «la, eyelεebδ.» <verse eid="LUK 22:58" /><verse number="59" style="v" sid="LUK 22:59" />ubeεεeδ εuddi essaεeθ yerni iyjen xlaf iyekkeδ yen: «mbelHeq, wahen zade ykan iyδes, Hette ennette δeljliyliy.» <verse eid="LUK 22:59" /><verse number="60" style="v" sid="LUK 22:60" />yemenni yen buTrus: «eyelεebδ, ellessinac f mette iθHekkiδ!» unette elyuwc iδukke yedden eyaziyĎ. <verse eid="LUK 22:60" /><verse number="61" style="v" sid="LUK 22:61" />yebren seyyedne yerqeb buTrus, yesfekker buTrus edwi nsiydiy max i syenne: «qebl eyedden eyaziyĎ asse, δeyθenkreδ tlaθe merraθ.» <verse eid="LUK 22:61" /><verse number="62" style="v" sid="LUK 22:62" />yeffeγ buTrus elberre iεeyyeĎ eSbiyH.<verse eid="LUK 22:62" /></para>
  <para style="s">yesuwε g elmejles nelyehuwd</para>
  <para style="p">
    <verse number="63" style="v" sid="LUK 22:63" />wiryazen elli kanen etεussen f yesuwε, ebδen δeSSen felles wettewθen δiys. <verse eid="LUK 22:63" /><verse number="64" style="v" sid="LUK 22:64" />esirDen uδmes encδent: «essuwli δ wiyn ixyewweθ?» <verse eid="LUK 22:64" /><verse number="65" style="v" sid="LUK 22:65" />usubbent essebbaθ egget. <verse eid="LUK 22:65" /><verse number="66" style="v" sid="LUK 22:66" />max i yuwli dugges, emlaymen elmcayex necceεb dimeqqaren nelkuhhan dimufesren necceriyεeθ, ewyent yelmejlsensen. <verse eid="LUK 22:66" /><verse number="67" style="v" sid="LUK 22:67" />ennen: «iδekan δcex elmesiyH ennane.» yer fellasen: «max exennenne eyetSedqemc, <verse eid="LUK 22:67" /><verse number="68" style="v" sid="LUK 22:68" />umax exennencδe etterriymc felle. <verse eid="LUK 22:68" /><verse number="69" style="v" sid="LUK 22:69" />emme seg ture bnaδem δeygeεmez f elymiyn nelquwδreθ nrebbi.» <verse eid="LUK 22:69" /><verse number="70" style="v" sid="LUK 22:70" />encδent elkulhum: «cex δmemmis nrebbi?» yer fellasen: «δxenyum tenniym, enneč.» <verse eid="LUK 22:70" /><verse number="71" style="v" sid="LUK 22:71" />ennen: «meεεač δeneseθHeq Hette echaδeθ! elkulne neslit seg imiys.»<verse eid="LUK 22:71" /></para>
  <chapter eid="LUK 22" />
  <chapter number="23" style="c" sid="LUK 23" />
  <para style="s">yesuwε γer biylaTus</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 23:1" />ekkeren eljmaεeθensen elkul, ewyen yesuwε ibiylaTus elwali nerruwman. <verse eid="LUK 23:1" /><verse number="2" style="v" sid="LUK 23:2" />ebδen tettehmen δiys: «enfaq elli eryaze yetheyyej g leεbeδenne, wexenyedjiyc enuc lefluws yelqeySer uyeqqar elli ennette elmesiyH elmlek.» <verse eid="LUK 23:2" /><verse number="3" style="v" sid="LUK 23:3" />yenceδt biylaTus: «endre cex elmlek nuδayen?» yer felles: «δcex tenniyδ.» <verse eid="LUK 23:3" /><verse number="4" style="v" sid="LUK 23:4" />yen biylaTus yimeqqaren nelkuhhan dleεbaδ: «ellufiyγ felles Hette cey.» <verse eid="LUK 23:4" /><verse number="5" style="v" sid="LUK 23:5" />yemenni eTfen eSHiyH: «yetheyyej g leεbaδ, yetseqre g yehuwdiyye elkul, seg eljliyl eldah.»<verse eid="LUK 23:5" /></para>
  <para style="s">yesuwε γer hiyruwdus</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 23:6" />max i yesle biylaTus tuθleyθ neljliyl, yenceδten: «endre eryaz seg eljliyl?» <verse eid="LUK 23:6" /><verse number="7" style="v" sid="LUK 23:7" />max i yesle elli nette iθebbeε elHkum nhiyruwdus, yuzent yhiyruwdus, elli ykan nette biyδe g uwrceliym g liyyametdiyn. <verse eid="LUK 23:7" /><verse number="8" style="v" sid="LUK 23:8" />hiyruwdus max i yezre yesuwε yefreH egget, εlexaTer ykan yetteθmenne seg bekri eθyezer, εlexaTer yesle felles egget, uyexs eyzer ellayeθ seg ifesnes. <verse eid="LUK 23:8" /><verse number="9" style="v" sid="LUK 23:9" />yenceδt f elHajaθ egget, welyerriyc felles. <verse eid="LUK 23:9" /><verse number="10" style="v" sid="LUK 23:10" />ekren imeqqaren nelkuhhan dimufesren necceriyεeθ ettehmenti eSbiyH. <verse eid="LUK 23:10" /><verse number="11" style="v" sid="LUK 23:11" />yeHqerθ hiyruwdus delεsakres, eSSen felles, yirDes edbac lemεen, yerri ibiylaTus. <verse eid="LUK 23:11" /><verse number="12" style="v" sid="LUK 23:12" />g wesses biylaTus dhiyruwdus eδwlen δimeddukal, uqebl eθkan mabinathum elεδaweθ.<verse eid="LUK 23:12" /></para>
  <para style="s">eHkam f yesuwε s temettent</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 23:13" />inabe biylaTus imeqqaren nelkuhhan delHukkam dleεbaδ. <verse eid="LUK 23:13" /><verse number="14" style="v" sid="LUK 23:14" />yennasen: «tuγeδmiyδ eryaze εlexaTer yetheyyej g leεbaδ. utay jerbaθ ezzeθennum wellufiyγ δiys Hette cey. <verse eid="LUK 23:14" /><verse number="15" style="v" sid="LUK 23:15" />heδake εlac Hette δhiyruwdus zade elli yrejεenaθ. utay elyegi Hette cey yettesθHeqqe enγe. <verse eid="LUK 23:15" /><verse number="16" style="v" sid="LUK 23:16" />tay δeθejlde seybaθ.» <verse eid="LUK 23:16" /><verse number="17" style="v" sid="LUK 23:17" />w ykan yetseybasen g kul elεiyδ iyjen seg imerbaT. <verse eid="LUK 23:17" /><verse number="18" style="v" sid="LUK 23:18" />yaxi zeεwgen elkulhum ennen: «awi eryaze eθseyyebδane barabas.» <verse eid="LUK 23:18" /><verse number="19" style="v" sid="LUK 23:19" />wediyn ykan yemmeqqen g elHebs εlexaTer iheyyej θemuwreθ w yenγe texrumt. <verse eid="LUK 23:19" /><verse number="20" style="v" sid="LUK 23:20" />inebaθen biylaTus tikkelt xlaf εlexaTer yexs eyseyyeb yesuwε. <verse eid="LUK 23:20" /><verse number="21" style="v" sid="LUK 23:21" />yemenni zeεwgen felles xlaf: «δuggemti g eSliyb! δuggemti g eSliyb!» <verse eid="LUK 23:21" /><verse number="22" style="v" sid="LUK 23:22" />yenceδten tikkelt teθθalet: «δmette eccer elli yegi? elleTTife felles Hette cey yettesθahel enγe, δeθejelde seybaθ.» <verse eid="LUK 23:22" /><verse number="23" style="v" sid="LUK 23:23" />yemenni ebδen etzeεwgen felles exsen eyemmeSleb. yeγleb ezeεwgensen. <verse eid="LUK 23:23" /><verse number="24" style="v" sid="LUK 23:24" />yeHkem biylaTus emmax i xsen. <verse eid="LUK 23:24" /><verse number="25" style="v" sid="LUK 23:25" />iseyyeb elli ykan g elHebs f elxaĎer nuheyyej nleεbaδ dwenγe, elli enceδen felles. emme yucasen yesuwε emmax i xsen.<verse eid="LUK 23:25" /></para>
  <para style="s">yesuwε f eSliyb</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 23:26" />unihnin etgewδen δiys, eTTefen eryaz seg elqiyrwan ellesmes semεan ykan mrewweH seg ejiymi, HuTTen felles eSliyb bac e θiyqem δeffer yesuwε. <verse eid="LUK 23:26" /><verse number="27" style="v" sid="LUK 23:27" />eθbεent leεbaδ egget seg midden delwacun elli kanneθ etεeyyeĎneθ uneddebneθ. <verse eid="LUK 23:27" /><verse number="28" style="v" sid="LUK 23:28" />yebrnasneθ yesuwε yen: «eθifrax nuwrceliym, eθεeyyeĎmec felle, εeyyeĎmeθ f imenennexmeθ didrarinnexmeθ. <verse eid="LUK 23:28" /><verse number="29" style="v" sid="LUK 23:29" />εlexaTer δeyeddes elweqθ ennen δiys leεbaδ: &lt;SeHHe liyhum telεuggar elli tiδiswinnesneθ elliriwnec wiδmerrennesneθ ellessesfenc!&gt; <verse eid="LUK 23:29" /><verse number="30" style="v" sid="LUK 23:30" />elweqθes δennen yedhari, &lt;uDameθ fellane!&gt; uyeθHecruwfin, &lt;ireDmtane!&gt; <verse eid="LUK 23:30" /><verse number="31" style="v" sid="LUK 23:31" />εlexaTer iδekan egiyn wahen yuqecquc eziyzew, elli yeqquwr δmette δesyejre?» <verse eid="LUK 23:31" /><verse number="32" style="v" sid="LUK 23:32" />eγδen sen δimujermen xlaf bac e nnenγen dyesuwε. <verse eid="LUK 23:32" /><verse number="33" style="v" sid="LUK 23:33" />max i θiwDen ywemxan elli ellesmes eljumjmeθ eSlbent diyn nette δimujermendiyn lessen, iyjen f elymiyn wiyjen f elysar. <verse eid="LUK 23:33" /><verse number="34" style="v" sid="LUK 23:34" />yen yesuwε: «sameHθen edda, ellessinenc δmette ittegen.» qerεen f uzuwni nedbeces. <verse eid="LUK 23:34" /><verse number="35" style="v" sid="LUK 23:35" />bedden leεbaδ reqben, welHukkam eSSiyn felles ennen: «imenneε elγires, edj eymenneε imenes kan nette mbelHeq δelmesiyH nrebbi, elli yexθari!» <verse eid="LUK 23:35" /><verse number="36" style="v" sid="LUK 23:36" />delεsaker zade eSSiyn felles unihnin ettesδen ettečnes g elxel, <verse eid="LUK 23:36" /><verse number="37" style="v" sid="LUK 23:37" />weqqarnes: «kan δcex elmlek nuδayen, menneε imenex!» <verse eid="LUK 23:37" /><verse number="38" style="v" sid="LUK 23:38" />weθkan δenyes elblakeθ yemmari felles s leHruwf f elyuwnaniyyeθ deruwmaniyyeθ delεibriyyeθ: «wahen δelmlek nuδayen.» <verse eid="LUK 23:38" /><verse number="39" style="v" sid="LUK 23:39" />yebδe iyjen seg imujrmendiyn elli emmeSlben yetbehber felles: «muc δcex elmesiyH? menneε imenex eθmenneεδene!» <verse eid="LUK 23:39" /><verse number="40" style="v" sid="LUK 23:40" />yemenni yenzer felles wissen: «Hette δcex ettekkiδc seg rebbi ucex δeθemεaqbeδ m nette? <verse eid="LUK 23:40" /><verse number="41" style="v" sid="LUK 23:41" />nečin s elHeq εlexaTer niwi elli nettesθehali f elεmeylenne, emme eryaze elyegi Hette cey δelγaleĎ.» <verse eid="LUK 23:41" /><verse number="42" style="v" sid="LUK 23:42" />yen: «yesuwε, esfekriyδ max eθewDeδ g elmemlexθex.» <verse eid="LUK 23:42" /><verse number="43" style="v" sid="LUK 23:43" />yer felles yesuwε: «exenne elHeq: asse δeθebδiyδ iyδi g ejjenneθ.»<verse eid="LUK 23:43" /></para>
  <para style="s">temettent nyesuwε</para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 23:44" />elweqθes ykan εuddi δessette (ezyen nwas), tessulles eddunyeθ elettesεe (maDi tlaθe ntisemsiyn), <verse eid="LUK 23:44" /><verse number="45" style="v" sid="LUK 23:45" />tens tefuwθ, yemcuq ecεer n elheykel f sen. <verse eid="LUK 23:45" /><verse number="46" style="v" sid="LUK 23:46" />elweqθes izeεweg yesuwε eSbiyH yen: «erruHiyw g ifesnex edda!» max i yenne wahen tuwli erruHes. <verse eid="LUK 23:46" /><verse number="47" style="v" sid="LUK 23:47" />eDDabeT nerruwman max i yezre elli ySar, imejjeδ rebbi yen: «mbelHeq, eryaze elyegi Hette cey.» <verse eid="LUK 23:47" /><verse number="48" style="v" sid="LUK 23:48" />leεbaδ kanen emlaymen bac e zren eSlab, max i zriyn elli ySar, rewHen ettewθen g iδmernensen. <verse eid="LUK 23:48" /><verse number="49" style="v" sid="LUK 23:49" />welli esnent elkul delwacun elli useδneθ iyδes seg eljliyl, bedden reqben seg lebεiyδ.<verse eid="LUK 23:49" /></para>
  <para style="s">erδem nyesuwε</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 23:50" />ykan yelle eryaz ellesmes yuwsef, seg elmejles, δeryaz yebhe w δ eHeqqi, <verse eid="LUK 23:50" /><verse number="51" style="v" sid="LUK 23:51" />lykanc δimwafeq f elli egint iyh nelmejles, unette seg errameθ icθ seg timuwre nuδayen, w ykan yetraje g elmelx nrebbi. <verse eid="LUK 23:51" /><verse number="52" style="v" sid="LUK 23:52" />yexDem ibiylaTus yeĎleb ejjeθθeθ nyesuwε. <verse eid="LUK 23:52" /><verse number="53" style="v" sid="LUK 23:53" />emmale yessuggezθ ikeffent g eθkettent yessuggezθ g wenil yemmeHfer g elHegfeθ elyemmerδem δiys Hette Hed. <verse eid="LUK 23:53" /><verse number="54" style="v" sid="LUK 23:54" />esses ykan δas nuHeDDer yessebθ elli yeqreb. <verse eid="LUK 23:54" /><verse number="55" style="v" sid="LUK 23:55" />elwacun elli effeγneθ dyesuwε seg eljliyl eθbeεneθ yuwsef ezrneθ enil meniy, umax i θemHuT ejjeθθeθ, <verse eid="LUK 23:55" /><verse number="56" style="v" sid="LUK 23:56" />ubeεεeδ δwelneθ HeDDerneθ elwfaHaθ derriyHeθ yejjeθθeθ. erθaHneθ as nessebθ emmax i yemweSSe g ecceriyεeθ nmuwse.<verse eid="LUK 23:56" /></para>
  <chapter eid="LUK 23" />
  <chapter number="24" style="c" sid="LUK 24" />
  <para style="s">ekker nyesuwε</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 24:1" />emme uggas emezwar g elimeθ, seg elfjer, elwacundiyn ywiyneθ iyδesneθ elwfaHaθ elli HeDDerneθ exDemneθ ywenil. <verse eid="LUK 24:1" /><verse number="2" style="v" sid="LUK 24:2" />efneθ tγaγet temmeqleb f wenil. <verse eid="LUK 24:2" /><verse number="3" style="v" sid="LUK 24:3" />umax i δuδefneθ ellufinc ejjeθθeθ nyesuwε. <verse eid="LUK 24:3" /><verse number="4" style="v" sid="LUK 24:4" />unihenti ettimeθHeyriyn, tay sen δiryazen irDen edbac lemεen bedden ezzeθensneθ. <verse eid="LUK 24:4" /><verse number="5" style="v" sid="LUK 24:5" />ukkeδneθ TebbeSneθ f elqeεεeθ. ennen iryazendiyn: «imette itHewwemmeθ g elli yedder uggemmes nilemmitte? <verse eid="LUK 24:5" /><verse number="6" style="v" sid="LUK 24:6" />leHebbac dahen, yekker! esfekkermeθ max i xenyuθley max i ykan g eljliyl. <verse eid="LUK 24:6" /><verse number="7" style="v" sid="LUK 24:7" />&lt;bnaδem yelzem eyemmuwc yleεbaδ δelγullaĎ, yemmeSleb, usiyn as eθθaleθ eyekker.&gt;» <verse eid="LUK 24:7" /><verse number="8" style="v" sid="LUK 24:8" />wesfekkerneθ edwiys. <verse eid="LUK 24:8" /><verse number="9" style="v" sid="LUK 24:9" />max yrewweHneθ seg enil eHkaneθ yetlamδe leHdacdiyn diddiynni elli ySar elkul. <verse eid="LUK 24:9" /><verse number="10" style="v" sid="LUK 24:10" />ellesmensneθ meryem θemejdeliyθ dyuwwenne dmeryem yemmes nyeεquwb ettiddiynni elli exDemneθ iyδesneθ ennihenti elli eHkaneθ yimersal wahen. <verse eid="LUK 24:10" /><verse number="11" style="v" sid="LUK 24:11" />ezren edwinsneθ emuxerref wentSedqenc. <verse eid="LUK 24:11" /><verse number="12" style="v" sid="LUK 24:12" />emme buTrus yekker yezzel ywenil. iTebbeS yezer elkfen yemHuT weHδes, yexDem δimeθεejjeb seg elli ySar.<verse eid="LUK 24:12" /></para>
  <para style="s">f webriδ nεemwas</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 24:13" />esses ellan sen essisen xDemen ytemuwreθ ellesmes εimwas tebεeδ leqrabeθ neHdac nkiylu f uwrceliym, <verse eid="LUK 24:13" /><verse number="14" style="v" sid="LUK 24:14" />ukanen Hekken f elli ySar. <verse eid="LUK 24:14" /><verse number="15" style="v" sid="LUK 24:15" />unihnin Hekken ettemfehamen, yeqreb yetwelinsen yesuwε biyδe yuyuwr iyδsen. <verse eid="LUK 24:15" /><verse number="16" style="v" sid="LUK 24:16" />emme tiTTewinensen emmireDneθ felles. <verse eid="LUK 24:16" /><verse number="17" style="v" sid="LUK 24:17" />yenceδten: «f mette iθHekkam uxenyum tegguwrem?» bedden δimkecben. <verse eid="LUK 24:17" /><verse number="18" style="v" sid="LUK 24:18" />yer felles iyjen essisen, ellesmes kelyuwbas: «endre δcex berk elli tuseδeδ yuwrceliym weltessiync elli ySar δiys g liyyame?» <verse eid="LUK 24:18" /><verse number="19" style="v" sid="LUK 24:19" />yennasen: «δmette iySar?» erren felles: «elli ySar yyesuwε ennaSri elli ykan δenbi yetged belgde ege dedwi elkul ezzaθ nrebbi dleεbaδ elkul, <verse eid="LUK 24:19" /><verse number="20" style="v" sid="LUK 24:20" />umax i θuwcin imeqqaren nelkuhhan delHukkemenne yelHkum nujafi dweSlab. <verse eid="LUK 24:20" /><verse number="21" style="v" sid="LUK 24:21" />emme enkan netteεlex elli nette δeyefδe israYiyl. uzade asse δeθθaleθ seg elli ySar wediyn. <verse eid="LUK 24:21" /><verse number="22" style="v" sid="LUK 24:22" />ellaneθ elwacun essiyne Heyyerntane, exDemneθ ywenil talji bekri, <verse eid="LUK 24:22" /><verse number="23" style="v" sid="LUK 24:23" />yaxi ellufinc ejjeθeθes, eseδneθ enneneθ elli zriyneθ elmleyxaθ ennan elli elyuwc yedder. <verse eid="LUK 24:23" /><verse number="24" style="v" sid="LUK 24:24" />exeDmen lebHaD kanen iyδne ywenil efen emmax i nnaneθ elwacundiyn, emme nette eθezriync.» <verse eid="LUK 24:24" /><verse number="25" style="v" sid="LUK 24:25" />yennasen: «eyiδerwac elli ulewnennum ettemnenc liyhliyh s elli eHkant lenbye! <verse eid="LUK 24:25" /><verse number="26" style="v" sid="LUK 24:26" />muc ykan lazem eyεane elmesiyH elwjayeεe usiyn eyaδef g elmejδes?» <verse eid="LUK 24:26" /><verse number="27" style="v" sid="LUK 24:27" />usiyn yebδe yetfehhem δiysen, elli yemmari felles elkul seg muwse dlenbye elkul. <verse eid="LUK 24:27" /><verse number="28" style="v" sid="LUK 24:28" />max i θiwDen ytemuwreθ elli sennadiyn netlamδe δesexeDmen, yesuwε yege imenes δeyeθεedde lezzaθ, <verse eid="LUK 24:28" /><verse number="29" style="v" sid="LUK 24:29" />yaxi mellegnes ennanes: «eqqiym γenne, eddunyeθ εuddi tessulles.» yaδef yeqqiym γersen. <verse eid="LUK 24:29" /><verse number="30" style="v" sid="LUK 24:30" />max i ygeεmez δeyeč iyδsen, yqam eγrum ibarex, usiyn ikesserθ yezlasen. <verse eid="LUK 24:30" /><verse number="31" style="v" sid="LUK 24:31" />mirneθ tiTTewinensen exzent, usiyn iraH fellasen. <verse eid="LUK 24:31" /><verse number="32" style="v" sid="LUK 24:32" />yen iyjen essisen ywissen: «elkanenc ulewnenne etmeHraqen g iδmernenne max i ykan yHekkeyane uggebriδ uyetfesrane g elxθabaθ?» <verse eid="LUK 24:32" /><verse number="33" style="v" sid="LUK 24:33" />ekkeren g elweqtdiyn eδwlen yuwrceliym, efen etlemδadiyn leHdac delli iyδsen emlaymen, <verse eid="LUK 24:33" /><verse number="34" style="v" sid="LUK 24:34" />unihnin eqqaren: «mbelHeq, erreb yekker, yeffeγ ysemεan.» <verse eid="LUK 24:34" /><verse number="35" style="v" sid="LUK 24:35" />eHkenasen sennadiyn elli ySar uggebriδ, umax i θuxzen g ukesser nweγrum.<verse eid="LUK 24:35" /></para>
  <para style="s">yesuwε eyeffeγ yetlamδe</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 24:36" />elluciyn Hekken, yesuwε biyδe ibed uggemmesensen yennasen: «esselam εliykum.» <verse eid="LUK 24:36" /><verse number="37" style="v" sid="LUK 24:37" />wemmerεben essis, εlexaTer etteεlakent δelxyal. <verse eid="LUK 24:37" /><verse number="38" style="v" sid="LUK 24:38" />yennasen: «ecbiykum treglem? wimette ulewnennum δiysen eccek? <verse eid="LUK 24:38" /><verse number="39" style="v" sid="LUK 24:39" />erqbeθ ifesniyw dikreεniyw, enneč biyδe, lemmesmiyδ terqbem, elxyal leγrec exsum dixsan emneč.» <verse eid="LUK 24:39" /><verse number="40" style="v" sid="LUK 24:40" />max i yenne wahen yessexnasen ifesnes dikreεnes. <verse eid="LUK 24:40" /><verse number="41" style="v" sid="LUK 24:41" />elluciyn elSedqenc seg elferHeθ, uδimeθεejben, yenceδten: «γerwem Haje dahen yweče?» <verse eid="LUK 24:41" /><verse number="42" style="v" sid="LUK 24:42" />ucnes eTTerf nelHuwθ yemmeHreq, <verse eid="LUK 24:42" /><verse number="43" style="v" sid="LUK 24:43" />yewiθ yeči ezzeθensen. <verse eid="LUK 24:43" /><verse number="44" style="v" sid="LUK 24:44" />usiyn yenneyasen: «δwahen edwi elli enniγewemt elweqθelli kane iyδwem: lazem eyekmel kul cey yemmari felle g ecceriyεeθ nmuwse delxθabeθ nlenbye delmzamiyr.» <verse eid="LUK 24:44" /><verse number="45" style="v" sid="LUK 24:45" />usiyn ymirasen ulewnensen bac e fehmen elxθabaθ, <verse eid="LUK 24:45" /><verse number="46" style="v" sid="LUK 24:46" />yennasen: «sahen yemmari, elmesiyH yelzem eyeθwejjeε was eθθaleθ eyekker seg inemmitte, <verse eid="LUK 24:46" /><verse number="47" style="v" sid="LUK 24:47" />usellesmes δeyembeccer ettuwbeθ dusameH neδnuwb g timuwre elkul, uδeyemmebδe seg uwrceliym. <verse eid="LUK 24:47" /><verse number="48" style="v" sid="LUK 24:48" />uxenyum δeccuhhaδ f elHajaθe. <verse eid="LUK 24:48" /><verse number="49" style="v" sid="LUK 24:49" />utay δexennezne elli yuεδawem essis dadde, emme eqqiymeθ g temuwreθ elδeθeggez fellawem elquwweθ s lennej.»<verse eid="LUK 24:49" /></para>
  <para style="s">elay nyesuwε yesma</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 24:50" />usiyn igewwetten elberre ntemuwreθ ibiytεenya. yqam ifesnes lennej ibarex δiysen. <verse eid="LUK 24:50" /><verse number="51" style="v" sid="LUK 24:51" />elyuwc yetbarex δiysen yexDem fellasen yemqam lennej yesme. <verse eid="LUK 24:51" /><verse number="52" style="v" sid="LUK 24:52" />esjeδnes rewHen yuwrceliym ferHeniyn egget, <verse eid="LUK 24:52" /><verse number="53" style="v" sid="LUK 24:53" />weqqiymen xeTmen diyme yelHuwc nelqudus etsebHen g rebbi.<verse eid="LUK 24:53" /></para>
  <chapter eid="LUK 24" />
</usx>