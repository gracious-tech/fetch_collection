<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1PE" style="id" />
  <para style="h">1 Pet</para>
  <para style="toc1">eljwab eglewwel n buTrus</para>
  <para style="toc2">1Ptr</para>
  <para style="toc3">1PE</para>
  <para style="mt">eljwab eglewwel n buTrus</para>
  <chapter number="1" style="c" sid="1PE 1" />
  <para style="s">etteHaye θiglewlin</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 1:1" />neč buTrus erresuwl n yesuwε elmesiyH eδerye y elli yexθaren erreb imeθγerben w imceteten g bentus d eγlaTiyye d kebbeduwkiyye d asye d biyθiyniyye. <verse eid="1PE 1:1" /><verse number="2" style="v" sid="1PE 1:2" />erreb yexθerawem felHesb n elεelmes essabeq teδwelem imqeddesen s erruwH bac e Dewεen yesuwε elmesiyH emTehren s urucci n iδemnes. fellewem enneεmeθ d islam ettemeqerθ!<verse eid="1PE 1:2" /></para>
  <para style="s">eθmenn n edder diyme</para>
  <para style="p">
    <verse number="3" style="v" sid="1PE 1:3" />eyembarex erreb deddes n seyyedne yesuwε elmesiyH εlexaTer erreHemtes θemeqqerθ tuceyane edder ejdiyd. w yuceyane eθmenni felxaDer n eddar diyme s wekkar n yesuwε elmesiyH seg jar inemmitte. <verse eid="1PE 1:3" /><verse number="4" style="v" sid="1PE 1:4" />w yHeδrane elwerθ lifesseδc w yetmenzisc w elimerreqc, yemmeHrzawem g esmawaθ. <verse eid="1PE 1:4" /><verse number="5" style="v" sid="1PE 1:5" />xenyum elli s eliman, eθεus fellawem elquδreθ n erreb y elxleS elli δeyben g was ellexxer, <verse eid="1PE 1:5" /><verse number="6" style="v" sid="1PE 1:6" />s wah eθeferHem ture, reγmelli yelzmawem eθeHznem ture f elli δexeniSab seg elmHayen, <verse eid="1PE 1:6" /><verse number="7" style="v" sid="1PE 1:7" />elli δejerrebneθ elimenewwem emmax eθjerreb elεefyeθ uwreγ, w nette eγle n uwreγ elfani, usinc eykuwn δiθbab n elmdiH d umejjeδ d wecxar as n weffeγ n yesuwε elmesiyH. <verse eid="1PE 1:7" /><verse number="8" style="v" sid="1PE 1:8" />nette texsemt menγiyr elli ettezrem, w ettemnem essis w etzerremc ture, usinc eθeferHem ture s elferH δ emeqqar etmaHkic felles, <verse eid="1PE 1:8" /><verse number="9" style="v" sid="1PE 1:9" />εlexaTer γerwem eθθiyqeθ g wawaD y elγeyθewwem g elimen netteθ emenneε n ennefsewwem.<verse eid="1PE 1:9" /></para>
  <para style="s">lenbye exbren f wemnaεe</para>
  <para style="p">
    <verse number="10" style="v" sid="1PE 1:10" />f wemnaεe wah Hewmen lenbye, ennen f enneεmeθ elli xenyum δiys. <verse eid="1PE 1:10" /><verse number="11" style="v" sid="1PE 1:11" />Hawlen δ esnen elweqθ d max δettes enneεmeθe elli θenne felles erruwH n elmesiyH δiysen, max i θecheδ seg qebl s elwjayeε n elmesiyH δ elmejδ elli beεδes. <verse eid="1PE 1:11" /><verse number="12" style="v" sid="1PE 1:12" />ibenasen elli nihnin kanen xedmen muc y imenensen yemenni y xenyum, f elHejaθe θiyh elli yennineθ ture y xenyum, elHajeθe elli ennintent y xenyum ennihenti elli ybecrawem essiseneθ ture, s eεawen n erruwH n elqudus elli θemmazen seg esme, Hette δ elmleyxaθ etteθmennen δenzin tweliys.<verse eid="1PE 1:12" /></para>
  <para style="s">enabi y elεiyceθ n elqδaseθ</para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 1:13" />heδakeεlac HeDDerθ leεqulewwem θedjem elhemmewwem elkul g enneεmeθ elli δexenttes max eyeffeγ yesuwε elmesiyH. <verse eid="1PE 1:13" /><verse number="14" style="v" sid="1PE 1:14" />w m idrari δimdewεen, eθeθbεemc eccehweθewwem elli θeθbεemteθ g liyyameθ n eljehlewwem, <verse eid="1PE 1:14" /><verse number="15" style="v" sid="1PE 1:15" />yemenni kuwneθ δ eTTuhar g elli ettegem elkul, εlexaTer erreb elli ynebeyawem δ eTTaher. <verse eid="1PE 1:15" /><verse number="16" style="v" sid="1PE 1:16" />w zaδe elxθab yeqqar: "kuwneθ δ eTTuhar εlexaTer neč δ eTTaher." <verse eid="1PE 1:16" /><verse number="17" style="v" sid="1PE 1:17" />w iδekan tDelbem erreb w tHesbem δis δerrebbewwem w nette elli yθuč menγiyr ejamel y kul iyjen f elHseb n leεmeles, emmale edreθ leHyeθewwem xeyfiyn essis m iγriben δah, <verse eid="1PE 1:17" /><verse number="18" style="v" sid="1PE 1:18" />tesnem elli nette yefδeyawem seg essirθewwem telbaTelt elli θurθemteθ f midnewwem, nette yeδfeε elHajeθ eγla n elfeTTeθ ziyγ uwreγ elfani, <verse eid="1PE 1:18" /><verse number="19" style="v" sid="1PE 1:19" />netteθ iδemmen eTTuhhar n eDHeyyeθ, iδemmen n elmesiyH m iδemmen n elγzal weldiysen Hette elεiyb w Hette eδennes. <verse eid="1PE 1:19" /><verse number="20" style="v" sid="1PE 1:20" />w ykan erreb yexθari qebl n elli ayeg eddunyeθ, yemenni g luqaθe iglexren ybenawem, <verse eid="1PE 1:20" /><verse number="21" style="v" sid="1PE 1:21" />w nette elli yedjeyawem eθemnen s erreb elli yessikkerθi seg jar inemmitte yuces elmejδ, emmale yeδwel elhemmewwem d elimenewwem g erreb. <verse eid="1PE 1:21" /><verse number="22" style="v" sid="1PE 1:22" />w ture beεεeδ iθTehrem imenewwem s uDaweε n elHeq teδwlem texsem ewmeθnewwem belHeq, exseθ beεDkum f elHeq. <verse eid="1PE 1:22" /><verse number="23" style="v" sid="1PE 1:23" />θemmerwem men jdiyd, ezzerriεeθ elli θemmucawem muc ezzerriεeθ n temettent emme ezerriyeθ n edder diyme, wah edwi n erreb elli eyeqqim diyme. <verse eid="1PE 1:23" /><verse number="24" style="v" sid="1PE 1:24" />w elxθab yeqqar: "kul bnaδem m elHciyc welmejδes m eθnewwerθ n elHciyc. elHciyc eyeqquwr wennewweres eyuwDe <verse eid="1PE 1:24" /><verse number="25" style="v" sid="1PE 1:25" />yemenni edwi n erreb eyeqqiym diyme." wah eyendeγ edwi elli n becrawem essis.<verse eid="1PE 1:25" /></para>
  <chapter eid="1PE 1" />
  <chapter number="2" style="c" sid="1PE 2" />
  <para style="s">elkurδ elli yedder d ecceεeb imqeddes</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 2:1" />ekseθ fellewem elHajaθ timuHacen elkul m elxubeθ δ elmeker δ ennifeq δ elHeseδ δ ennemimeθ, <verse eid="1PE 2:1" /><verse number="2" style="v" sid="1PE 2:2" />θexsem m idreri imezyenen eγi n erreb eSSafi bac eθekberem essis y elxleS. <verse eid="1PE 2:2" /><verse number="3" style="v" sid="1PE 2:3" />εlexaTer "θemdeyem mesmeH erreb." emmax iyeqqar elxθab. <verse eid="1PE 2:3" /><verse number="4" style="v" sid="1PE 2:4" />w xenyum esδeθ tweliys εlexaTer nette elkurδ elli yedder elli erfDanti leεbeδ, elli yemmexθer w yebhe γer erreb. <verse eid="1PE 2:4" /><verse number="5" style="v" sid="1PE 2:5" />eqrebeθ twelis, xenyum zaδe m elkureδ yedder, emmale θebnem elHuwc n erruH elqudus, eθkawnem eljmaεeθ δ iqaddisen θemmamrem bac eθucem elγalaθ n erruH m eδbeyaH y erreb emeqbenneθ γers s elquδreθ n yesuwε elmesiyH. <verse eid="1PE 2:5" /><verse number="6" style="v" sid="1PE 2:6" />w elxθeb yeqqar: "tay! neč δ Hutte g Suhyuwn θγaγet n esses θebhe egget w θemmexθar γeri, emme γerelli eyemmen essis elyetxebec." <verse eid="1PE 2:6" /><verse number="7" style="v" sid="1PE 2:7" />w nette yebhe egget γerwem xenyum imumnen. emme yelli muc δimumnen "nette etγeγet elli etteqbilenec ibenneyen teδwel etγeγet n esses.", <verse eid="1PE 2:7" /><verse number="8" style="v" sid="1PE 2:8" />w "nette etγeγet ewweεθer δ wewDe". w nihnin εeθren εlexaTer ettemnenec s elkelmeθ n erreb: wah eyendeγ mat i seniqedder! <verse eid="1PE 2:8" /><verse number="9" style="v" sid="1PE 2:9" />yemenni xenyum δ ezzerriεeθ temmexθer w δ elkuhhen δ lmluwx w δellummeθ θemmexθer w δecceεeb n erreb bac e yesxen elfDeyles, w nette elli yessufγewem seg esselleseθ iθefuθes teSaTεθ. <verse eid="1PE 2:9" /><verse number="10" style="v" sid="1PE 2:10" />w eltkenemec δ ecceεeb qebl yemenni θure θeδwelem δecceεeb n erreb. eθkanem etnewlemec erraHmeθ n erreb yemenni θure etnewlem.<verse eid="1PE 2:10" /></para>
  <para style="s">ebrid n ixδimen n erreb</para>
  <para style="p">
    <verse number="11" style="v" sid="1PE 2:11" />w eDelbe essyiwem eleHbab, w xenyum δ leDyuwf d iγriben g eddunyeθe, ebeεδeθ f ecchawi n elbδen, εlexaTerhe etHereb ennefes. <verse eid="1PE 2:11" /><verse number="12" style="v" sid="1PE 2:12" />w edj eθkun essirθewwem tebhe jar iberraniyen. Hette max exennettehmen elli xenyum tuHecem, enzin y leεmelewwem teSSullaH mejδen erreb as elli entinabe. <verse eid="1PE 2:12" /><verse number="13" style="v" sid="1PE 2:13" />Ďewεeθ y kul elHajeθ etneDDem leεbeδ g dunnyeθ f elxaĎer n erreb, y elmelek εlexaTer nette elHakem emeqqar. <verse eid="1PE 2:13" /><verse number="14" style="v" sid="1PE 2:14" />w y elHukkam εlexaTer elmlek yuceyasen elqudreθ bac eεqben elli eyeγleD w etjezen g elli δeSSaleH, <verse eid="1PE 2:14" /><verse number="15" style="v" sid="1PE 2:15" />εlexaTer erreb yexs eθessessusmem ejjehel n leεbeδ imuHecen s elεmayel θeSSulleH. <verse eid="1PE 2:15" /><verse number="16" style="v" sid="1PE 2:16" />kuwneθ δ iHurreyyen, yemenni eθedjemec elHurriyyeθ iwege n eccer, yemenni kuwneθ m ixδimen n erreb. <verse eid="1PE 2:16" /><verse number="17" style="v" sid="1PE 2:17" />kermeθ leεbeδ elkul, exseθ ewmeθnewwem, ukδeθ seg erreb, kermeθ elmlek.<verse eid="1PE 2:17" /></para>
  <para style="s">eθbaε n elwjeyeε n elmesiyH</para>
  <para style="p">
    <verse number="18" style="v" sid="1PE 2:18" />ey ixeddemen Dawεeθ lesyeδewwem eSbiH, siwe kenen δeSSulleH bhen ziγ δ imuHecen. <verse eid="1PE 2:18" /><verse number="19" style="v" sid="1PE 2:19" />w mesmeH eθHemmel n bnaδem y elwjeyeε max eyebδe meDlum usinc eyebδe yetDaweε g erreb. <verse eid="1PE 2:19" /><verse number="20" style="v" sid="1PE 2:20" />w menten elmejδ y xenyum max eθeθHemlem elεδab elli ettesθehelemt, yemenni max eθegem elxir θeSabrem f eleεδeb, yebhe ezzeθ n erreb. <verse eid="1PE 2:20" /><verse number="21" style="v" sid="1PE 2:21" />felxeDer n wah ynebeyewem erreb, εlexaTer elmesiyH yeθwejjeε f elxeδrewwem yeg imenes δelmiθel bac etteθebεem. <verse eid="1PE 2:21" /><verse number="22" style="v" sid="1PE 2:22" />w elyegi Hette elγeldeθ w imis elyessinec elmekr. <verse eid="1PE 2:22" /><verse number="23" style="v" sid="1PE 2:23" />elyerric f essebbeθ emnetteθ. yeθwejjeε weliheddeδ Hed yemenni isellem ellemres yerreb elli yHekkem s elεδel, <verse eid="1PE 2:23" /><verse number="24" style="v" sid="1PE 2:24" />w nette elli yeθHemmel elxDeyenne g elbeδnes f elluHeθ bac enebεeδ f elxDeye nedder s elHeq. w nette elli s iyezzimnes θebrem. <verse eid="1PE 2:24" /><verse number="25" style="v" sid="1PE 2:25" />θkenem δ iεellec raHen, yemenni θerejεem ture y elli δeyettelhe s ennefsewwem iεus felles.<verse eid="1PE 2:25" /></para>
  <chapter eid="1PE 2" />
  <chapter number="3" style="c" sid="1PE 3" />
  <para style="s">enSayeH y elli uγin</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 3:1" />w xenyumti zade eyelwacun Daweεmeθ iryezennexmeθ. Hette iδekan δisen δwiyn liγic eyemmen s edwi n erreb, entenzγem s elεmeylewwem θibehheyin y elimen men γir edwi, <verse eid="1PE 3:1" /><verse number="2" style="v" sid="1PE 3:2" />max ezren elεmeylewwem θibehheyin. <verse eid="1PE 3:2" /><verse number="3" style="v" sid="1PE 3:3" />etkunc ezzintewwem esberre s weDfer nezaw dweriD nureγ dedbec ibehheyen, <verse eid="1PE 3:3" /><verse number="4" style="v" sid="1PE 3:4" />yemenni eθkun s ejjej s elli g ulewnewwem s ennefes θebhe etterrayet eltfesseδec, w essumes γer erreb δemeqqar. <verse eid="1PE 3:4" /><verse number="5" style="v" sid="1PE 3:5" />εlexaTer sin kenneθ elwacun θiqaddisin elli etteθwekkelneθ f erreb etteθzeyyenneθ qebl wetDaweεneθ iryezennesneθ, <verse eid="1PE 3:5" /><verse number="6" style="v" sid="1PE 3:6" />m serra elli θken etDaweε g ebrahim w θeqqares siδi. w xenyumti θure δ yessis iδekan tesserrefmeθ belgde men γiyr eθukkeδmeθ seg Hette ciy. <verse eid="1PE 3:6" /><verse number="7" style="v" sid="1PE 3:7" />w xenyum, ey iryezen, edreθ δelwecunewwem w xenyum tessenem elli θemettuθ δemexluq eDaεfewwem, θkermemtenet εlexaTer nihenti etticrixinewwem g edder diyme, w sahen exenyetqelleq ciy f ezzelliθewwem.<verse eid="1PE 3:7" /></para>
  <para style="s">eθHemmel n eleεδeb g wege n elxir</para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 3:8" />heδakeεlec yelzem eykuwn γerwem ijen nerray, θHennem beεDkum f beεeD teθweDεem tesxfem f beεeDkum. <verse eid="1PE 3:8" /><verse number="9" style="v" sid="1PE 3:9" />eθerremec eccer s eccer w esubbi s subbi, yemenni berxeθ εlexaTer f elxeδer n wah temnebem w eθurθem elberxeθ. <verse eid="1PE 3:9" /><verse number="10" style="v" sid="1PE 3:10" />w elxθeb yeqqar: "elli yexs eyexes edder yezer liyyameθ bheneθ, eyettef ilses f eccer δ ecwerbes f elxbaθeθ. <verse eid="1PE 3:10" /><verse number="11" style="v" sid="1PE 3:11" />w edj eyeqqim yebεeδ f eccer yeg elxir yeĎleb eslam, <verse eid="1PE 3:11" /><verse number="12" style="v" sid="1PE 3:12" />εlexaTer θiT n erreb f elli δ SullaH w θemedjiθes θesseγδe g edεensen. emme uδmes ybeεεeδ f elli θegen eccer."<verse eid="1PE 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 3:13" />δwiyn δexenyeg eccer iδekan xenyum ettegem g elxir eSbiyH? <verse eid="1PE 3:13" /><verse number="14" style="v" sid="1PE 3:14" />yemenni max eθeθwejεem f elxeδer n elHeq, SeHHe likum! eθukδemec seg leεbaδ elli θegen eccer. <verse eid="1PE 3:14" /><verse number="15" style="v" sid="1PE 3:15" />yemenni qedseθ elmesiyH g ulewnewwem θkermemti δ erreb, θkunem f kul weqt HaDrin bac eθerrem f elli eyeĎleb essiwem ellemareθ f elxir elli g ulewnewwem. <verse eid="1PE 3:15" /><verse number="16" style="v" sid="1PE 3:16" />w edj eykuwn weδin s esyaseθ δelleHtirem, eθegemc elHajeθ eθendmem felles Hette max eθemεemlem s muHec, w emmexzen elli edukken s edwi yuHec f essirθewwem θebehheyeθ g elmesiyH. <verse eid="1PE 3:16" /><verse number="17" style="v" sid="1PE 3:17" />iδekan erreb yexs eθeθwejεem, eθeθwejεem w xenyum ettegem g elxir, xiyr n elli eθeθwejεem w xenyum ettegem g eccer. <verse eid="1PE 3:17" /><verse number="18" style="v" sid="1PE 3:18" />w elmesiyH biδe yemmuwθ elmerreθ iceθ berk f elxeδer n elxaδeye. yemmuθ f elxeδer n lecrer bac exeniqerreb seg erreb. yemmuθ g elbδen, yemenni erreb yessedderθi g erruH, <verse eid="1PE 3:18" /><verse number="19" style="v" sid="1PE 3:19" />w yemreq s erruHδin yetbeccer g lerweh imeHbes <verse eid="1PE 3:19" /><verse number="20" style="v" sid="1PE 3:20" />elli θeθmerreδ qebl, max i yeθmehhel eSSabr n erreb liyyameθ iyebne nuwH elfluwkeθ enjen essis s wamen lewse eleεbaδ, yeεni θmenye δ leεbaδ. <verse eid="1PE 3:20" /><verse number="21" style="v" sid="1PE 3:21" />w ykan wah δerramez n elmeεmudeyyeθ elli θnejjeyewem θure, muc s wekkes n elwsex n elbδen, yemenni s elεehd eθuceδ imenex y erreb s eneyθes etteSSaleHeθ. wah mumkn s wekker n yesuwε elmesiyH <verse eid="1PE 3:21" /><verse number="22" style="v" sid="1PE 3:22" />elli yuli yujenne w nette f elimin n erreb etDaweεen δis elmlayxe δ elqawweθ δ iyh n eSSulTan.<verse eid="1PE 3:22" /></para>
  <chapter eid="1PE 3" />
  <chapter number="4" style="c" sid="1PE 4" />
  <para style="s">iwxilen δ eSSulleH f enneεmeθ n erreb</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 4:1" />emmale iδekan elmesiyH yeθwejjeε g elbδen, Hedreθ xenyum zaδe imenewwem bac eθeθwejεem m nette, εlexaTer elli yeθwejjeε g elbδen eyqaTeε elγeldeθ. <verse eid="1PE 4:1" /><verse number="2" style="v" sid="1PE 4:2" />usinc eyedder elbqiyyeθ n elεemres g elxeδmeθ s elli yenne erreb, muc g echawi n eddunyeθ. <verse eid="1PE 4:2" /><verse number="3" style="v" sid="1PE 4:3" />w yezziyyawem elweqθ elli θεeddemti etεenaδem g iberraniyen, θeTTefem ebriδ n elfsaδ d eccehweθ d wesxar d weεbeδ n leSnam. <verse eid="1PE 4:3" /><verse number="4" style="v" sid="1PE 4:4" />w nihnin ture mesθeγrbiyn essiywem max entetεeniδemc g elfsaδ biyδe usinc exensendren elqeDrewwem, <verse eid="1PE 4:4" /><verse number="5" style="v" sid="1PE 4:5" />yemenni nihnin δ eδuwcen elHsab y erreb elli nette mestεed eyHaseb elli edderen d elli emmuwθen. <verse eid="1PE 4:5" /><verse number="6" style="v" sid="1PE 4:6" />w heδakeεlac θemmen elbcareθ Hette y elli emmuwθen zade bac e mHasben m leεbaδ edderen g elbδen usinc edren γer erreb s erruwH.<verse eid="1PE 4:6" /></para>
  <para style="s">eqrab n ennihayeθ</para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 4:7" />w ture θeqreb ennihayeθ n kulciy, erreθ elbalewwem, eθfaqem y ezzelliθ. <verse eid="1PE 4:7" /><verse number="8" style="v" sid="1PE 4:8" />w edj eθkuwn exse binetkum ettemeqqerθ qebl kulciy εlexaTer exse eθsetter egget δ elxDaye. <verse eid="1PE 4:8" /><verse number="9" style="v" sid="1PE 4:9" />Deyfeθ beεeDkum belgde menγiyr eqlaq, <verse eid="1PE 4:9" /><verse number="10" style="v" sid="1PE 4:10" />w edj eycerix kul iyjen essiywem elli uceyes erreb yiddiyn, m iwxiylen δ eSSullaH f elberkeθ n erreb elkul. <verse eid="1PE 4:10" /><verse number="11" style="v" sid="1PE 4:11" />w iδekan yuθlay iyjen essiywem edj eyuθley sedwi n erreb, w iδekan nette δ exδiym edj eyexδem s elquδreθ elli esetyuc erreb, bac e yeθmejjeδ erreb g kul ciy s yesuwε elmesiyH, γers elmejδ d elεezzeθ diyme. amiyn.<verse eid="1PE 4:11" /></para>
  <para style="s">eθHemmel n elwjayeε</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 4:12" />ey ewmaθen elli exesγawem, eθeθεejbemc s elmHayen elli exennekwaneθ s elεefiθensen bac e xenjerrebneθ, ekeyenni δ elHajeθ ettuγribθ tejreyawem, <verse eid="1PE 4:12" /><verse number="13" style="v" sid="1PE 4:13" />yemenni eferHeθ m elli etceraxem elmesiyH g elwjeyεes, emmale max e yeθjelle elmejδes eθeferHem zade. <verse eid="1PE 4:13" /><verse number="14" style="v" sid="1PE 4:14" />SeHHe liykum, iδekan εeyernawem s ellesm n elmesiyH, εlexaTer erruwH n elmejδ, erruwH n erreb, eyeggez fellawem. <verse eid="1PE 4:14" /><verse number="15" style="v" sid="1PE 4:15" />yetteθwejjiεc iyjen essiywem eθwejjeε n imejrem ziyγ δ essareq ziyγ δ ecerrir ziyγ δ eklufi, <verse eid="1PE 4:15" /><verse number="16" style="v" sid="1PE 4:16" />yemenni iδekan yeθwejjeε εlexaTere δ emesiyHi, eyeθHeccemc w edj eyecxer erreb s ellesme. <verse eid="1PE 4:16" /><verse number="17" style="v" sid="1PE 4:17" />yiweD elweqθ n elqDe w δ eyebde s iθbab n elHuwc n erreb. w iδekan tebδe essiyne max δeθkun ennihayeθ n elli elleqbilenc elYinjiyl n erreb? <verse eid="1PE 4:17" /><verse number="18" style="v" sid="1PE 4:18" />w elxθab yeqqar: "iδekan ibehhayen menεen beεεeδ etεeb max δeθkuwn ellexreθ n elkuffar elγullaĎ?" <verse eid="1PE 4:18" /><verse number="19" style="v" sid="1PE 4:19" />yemenni elli etteθwejjaεen emmax i senyexes erreb, edj ernin agen elxiyr selmen imenensen y elli yexleqθen.<verse eid="1PE 4:19" /></para>
  <chapter eid="1PE 4" />
  <chapter number="5" style="c" sid="1PE 5" />
  <para style="s">erreεiyyeθ n erreb</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 5:1" />w θah elwSayθiw y lecyux elli jerewem, neč δ eccix m nihnin w δecceheδ f elwjeyeε n elmesiyH w δecrix g elmejeδ elli δeyben qriyb, <verse eid="1PE 5:1" /><verse number="2" style="v" sid="1PE 5:2" />esθeHfDeθ f erraεeyyeθ n erreb elli jar ifesnewwem, usinc εusseθ felles s elxeDrewwem muc bessif εlikum emmax eyyexes erreb, muc f elxeDer elleflus emme δ exse. <verse eid="1PE 5:2" /><verse number="3" style="v" sid="1PE 5:3" />w eθeθseltemec f elli jar ifesnewwem, emme kunmesen δelmiθel. <verse eid="1PE 5:3" /><verse number="4" style="v" sid="1PE 5:4" />w lemmi eyeffeγ essulTan n lecyux, eθewyem ettaj n mejd liweqqic. <verse eid="1PE 5:4" /><verse number="5" style="v" sid="1PE 5:5" />zade xenyum imezyanen, Dawεeθ lecyux teθweDεem g weθεemlewwem δbeεeDkum, εlexaTer elxθab yeqqar "erreb eybed y imeθkebren yenεem yimeθweDεen." <verse eid="1PE 5:5" /><verse number="6" style="v" sid="1PE 5:6" />emmele eθweDεeθ eddu ifessen n erreb bac exeniqam max e yaweD elweqθ. <verse eid="1PE 5:6" /><verse number="7" style="v" sid="1PE 5:7" />θHuTTem elhemmewwem felles w nette eyettelhe essiwem. <verse eid="1PE 5:7" /><verse number="8" style="v" sid="1PE 5:8" />faqeθ terrem elbelewwem εlexaTer elεδuwewwem blis yθenneD m eSSiδ yetHewwem g elefriseθ. <verse eid="1PE 5:8" /><verse number="9" style="v" sid="1PE 5:9" />eθebθeθ g elimenewwem θqawmemt, tesnem elli ewmeθnewwem imumnen g eddunyeθ elkul etεenen elwjayeε biδhe. <verse eid="1PE 5:9" /><verse number="10" style="v" sid="1PE 5:10" />w erreb n enneεmeθ elkul erreb elli ynebeyewem bac eθkunem δ ecriyxen s elmejδes n dime g yesuwε elmesiyH, nette elli exenyedj δ elkummel, beεεeδ elli θeθwejεem lewse, usinc exeniθebbet yqawweyewem yedjewem θebtiyn. <verse eid="1PE 5:10" /><verse number="11" style="v" sid="1PE 5:11" />γers elquδreθ δime. emiyn.<verse eid="1PE 5:11" /></para>
  <para style="s">etHaye θigluxrin</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 5:12" />exennerye eljwabe iqSeyyer s wefus n selwanus, w nette γeri δewmeθ δeSSaδeq, bac exencejεe essis ecehδe elli enneεmeθ elli γerwem netteθ δ enneεmeθ n erreb θeHeqqaniθ. eθebθeθ δiys. <verse eid="1PE 5:12" /><verse number="13" style="v" sid="1PE 5:13" />elkeniyseθ n babel, netteθ m xenyum θemmexθar γer erreb, etsellem fellewem. w yetsellem fellewem merqus memmi zaδe. <verse eid="1PE 5:13" /><verse number="14" style="v" sid="1PE 5:14" />selmeθ beεeDkum f beεeD, s ekubbi. eslam fellewem elkul, xenyum elli g elmesiyH.<verse eid="1PE 5:14" /></para>
  <chapter eid="1PE 5" />
</usx>