<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2JN" style="id">- Biblica® Open Finnish Living News New Testament</book>
  <para style="h">2 Johanneksen Kirje</para>
  <para style="toc1">Johanneksen toinen kirje</para>
  <para style="toc2">2. Johanneksen kirje</para>
  <para style="toc3">2 Joh.</para>
  <para style="mt1">Johanneksen Toinen Kirje</para>
  <chapter number="1" style="c" sid="2JN 1"/>
  <para style="p">
    <verse number="1,2" style="v" sid="2JN 1:1,2"/>
    <char style="add">Lähettäjä:</char> Johannes, seurakunnan johtaja<note caller="+" style="f"><char style="fr" closed="false">1:1,2 </char><char style="ft" closed="false">Sananmukaisesti: »vanhin».</char></note>.</para>
  <para style="p" vid="2JN 1:1,2">
    <char style="add">Vastaanottaja:</char> Jumalan omien seurakunta<note caller="+" style="f"><char style="fr" closed="false">1:1,2 </char><char style="ft" closed="false">Sananmukaisesti: »valittu rouva ja hänen lapsensa».</char></note>, jota minä ja muut uskovat vilpittömästi rakastamme yhteisen Vapahtajamme Jeesuksen Kristuksen tähden. <verse eid="2JN 1:1,2"/><verse number="3" style="v" sid="2JN 1:3"/>Isä Jumala ja hänen Poikansa Jeesus Kristus antavat meille armonsa, rauhansa, totuutensa ja rakkautensa.<verse eid="2JN 1:3"/></para>
  <para style="s1">Varokaa niitä, jotka johtavat harhaan</para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4"/>Olen täällä pannut ilokseni merkille, että seuraatte totuutta ja elätte niin kuin Jumala on käskenyt.<verse eid="2JN 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2JN 1:5"/>Ystävät, muistutan teitä vielä vakavasti käskystä, jonka alunpitäen saimme Jumalalta: meidän kristittyjen on rakastettava toisiamme. <verse eid="2JN 1:5"/><verse number="6" style="v" sid="2JN 1:6"/>Jos rakastamme Jumalaa, teemme kaiken mitä hän pyytää. Ja hän on alusta asti käskenyt meidän rakastaa toisiamme. <verse eid="2JN 1:6"/><verse number="7" style="v" sid="2JN 1:7"/>Varokaa niitä monia harhaoppisia, jotka eivät usko, että Jeesus Kristus tuli maan päälle ihmisenä ja että hänellä oli samanlainen ruumis kuin meilläkin. He ovat totuuden ja Kristuksen vastustajia. <verse eid="2JN 1:7"/><verse number="8" style="v" sid="2JN 1:8"/>Pitäkää huolta siitä, ettette anna heidän johtaa itseänne harhaan ja menetä palkintoanne, jonka tähden olemme nähneet paljon vaivaa. Katsokaa, että saatte Herralta täyden palkan. <verse eid="2JN 1:8"/><verse number="9" style="v" sid="2JN 1:9"/>Jos poikkeatte Kristuksen opista, kadotatte yhteyden Jumalaan. Mutta jos olette sille uskollisia, teillä on sekä Isä että Poika.<verse eid="2JN 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2JN 1:10"/>Jos joku haluaa opettaa teitä, vaikkei itse usko sitä mitä Jeesus opetti, älkää kutsuko häntä kotiinne. Älkää millään tavalla rohkaisko häntä. <verse eid="2JN 1:10"/><verse number="11" style="v" sid="2JN 1:11"/>Jos sen tekisitte, osallistuisitte hänen pahoihin tekoihinsa.<verse eid="2JN 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12"/>Minulla olisi paljon sanottavaa. En kuitenkaan halua kirjoittaa enempää, vaan yritän päästä pian tapaamaan teitä. Voimme sitten puhua kaikesta ja nauttia yhdessäolosta.<verse eid="2JN 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2JN 1:13"/>Tämän seurakunnan jäsenet lähettävät teille terveisiä.<verse eid="2JN 1:13"/></para>
  <chapter eid="2JN 1"/>
</usx>
