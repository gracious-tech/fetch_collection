<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="NUM" style="id">- Lugulu Bible Version</book>
  <para style="toc3">Kupet</para>
  <para style="toc2">Kupetighwa</para>
  <para style="toc1">Ichitabu cha Ukupetighwa</para>
  <para style="mt1">UKUPETIGHWA</para>
  <para style="imt">ICHOLONGOLE</para>
  <chapter number="1" style="c" sid="NUM 1" />
  <para style="s">Waisiraeli wopetighwa</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 1:1" />IMNDEWA kalonga na Musa akula kunyika ya Sinai, mng'anda mwa Lihema Lienzeluke, mna litsuwa lya mwanduso lya ghumwetsi ghwa kabili, ghumwaka ghwa kabili kulawa hawalawile mna isi ya Misiri, kalonga, <verse eid="NUM 1:1" /><verse number="2" style="v" sid="NUM 1:2" />“Ghweghwe na Aruni muwapete Waisiraeli wose kwa kulola tsikolo tsawo, tsikaye tsawo na mataghwa ghawo gha chila mmale, <verse eid="NUM 1:2" /><verse number="3" style="v" sid="NUM 1:3" />Awala wose iwodaha ukughenda kwing'ondo mna, wane miyaka ishilini no ukughendelela awo ghweghwe na Aruni muwapete kwa kulola ghamakingili ghao. <verse eid="NUM 1:3" /><verse number="4" style="v" sid="NUM 1:4" />Nimsaghula munu yumwe iyali chilongotsi wa kaye kulawa chila kabila yakwapfile mna ukupeta.”<verse eid="NUM 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 1:5" />Na aghano igho ghamataghwa ghe iwanu walume iwatsokwapfila ing'onde.</para>
  <para style="p" vid="NUM 1:5">Kulawa kabila lya Rubeni, kasaghulighwa Elisuli imwana wa Shedeuri.<verse eid="NUM 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 1:6" />Kulawa kabila lya Simeoni, kasaghulighwa Shelumaeli mwana wa Shumshadai,<verse eid="NUM 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 1:7" />Kulawa kabila lya Yuda, kasaghulighwa Nashoni mwana wa Aminadabu,<verse eid="NUM 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 1:8" />Kulawa kabila lya Isakari, kasaghulighwa Nasanaeli mwana wa Zuari,<verse eid="NUM 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 1:9" />Kulawa kabila lya Zebuloni, kasaghulighwa Eliabu imwana na Heloni,<verse eid="NUM 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 1:10" />Kulawa, kabila lya Efuraimu, kasaghulighwa Elishama imwana wa Amihudi,</para>
  <para style="p" vid="NUM 1:10">Kulawa kabila lya Manase, kasaghulighwa Gamalieli mwana Pedazuri,<verse eid="NUM 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 1:11" />Kulawa kabila lya Benjamini, kasaghulighwa Abidani mwana wa Gidioni,<verse eid="NUM 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 1:12" />Kulawa kabila lya Dani, kasaghulighwa Ahazeri mwana wa Amishadai,<verse eid="NUM 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 1:13" />Kulawa kabila lya Asheri, kasaghulighwa Pagieli mwana wa Okirani,<verse eid="NUM 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 1:14" />Kulawa kabila lya Gadi, kasaghulighwa Eliasafu mwana wa Danieli,<verse eid="NUM 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 1:15" />Kulawa kabila lya Nafutari, kasaghulighwa Ahira mwana wa Emani.<verse eid="NUM 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 1:16" />Awano wawo iwasaghulighwe mna ghumtingano, iwakulu wa ghamakabila gha aba tsao, tsawawalongotsa iwanu wose wa Isiraeli. <verse eid="NUM 1:16" /><verse number="17" style="v" sid="NUM 1:17" />Musa na Aruni wawasola iwanu wano kwa ghamataghwa ghao, <verse eid="NUM 1:17" /><verse number="18" style="v" sid="NUM 1:18" />wawalongela iwanu wose wetingane hamwe mna litsuwa lya mwanduso lya ghumwetsi ghwa kabili. Nao wandikighwa yumweyumwe ka kolo tsao pfatsili na tsikaye tsa aba tsao, kwandusila wane miyaka ishilini na kughendelela, <verse eid="NUM 1:18" /><verse number="19" style="v" sid="NUM 1:19" />ka IMNDEWA pfamlaghitse Musa. Apfo kawapeta kune inyika ya Sinai. <verse eid="NUM 1:19" /><verse number="20" style="v" sid="NUM 1:20" />Na wana wa Rubeni, chaudele wa Yakobu, ipfeleko pfao na tsikolo tsao, ka tsikaye tsa aba tsao pfatsili, awala iwapetighwe kwa mataghwa ghao, chila mmale kwandusila miyaka ishilini no ukughendelela, <verse eid="NUM 1:20" /><verse number="21" style="v" sid="NUM 1:21" />awala wose iwodaha ukughenda kung'ondo, awala iwandikighwe na kabila lya Rubeni tsa elufu alubaini na sita na miya tano. <verse eid="NUM 1:21" /><verse number="22" style="v" sid="NUM 1:22" />Kune iwana wa Simeoni, kolo tsao, na pfeleko, kwa tsikaye tsao, kwa mataghwa gha aba tsao, awala iwapetighwe kwa ghamataghwa, chila mmale yane miyaka ishilini no ukughendelela, wose iwang'ali wodaha kughenda kung'ondo, <verse eid="NUM 1:22" /><verse number="23" style="v" sid="NUM 1:23" />Awala iwapetighwe mna likabila lya Simeoni tsawapfika elufu hamsini na tisa na miya ndatu. <verse eid="NUM 1:23" /><verse number="24" style="v" sid="NUM 1:24" />Kune iwana wa Gadi, kolo tsao, na pfeleko pfao kwa tsikaye tsao, kwa mataghwa gha aba tsao, awala iwapetighwe kwa ghamataghwa, chila mmale yane miyaka ishilini no ukughendelela, wose iwang'ali wodaha kughenda kung'ondo, <verse eid="NUM 1:24" /><verse number="25" style="v" sid="NUM 1:25" />awala iwapetighwe mna iwana wa Gadi tsawapfika elufu alubaini na tano, miya sita na hamsini. <verse eid="NUM 1:25" /><verse number="26" style="v" sid="NUM 1:26" />Na iwana wa Yuda, ipfeleko pfao, kwa tsikolo tsao, kwa tsikaye tsao, kwa mataghwa gha aba tsao, awala iwapetighwe kwa ghamataghwa, chila mmale kwandusila miyaka ishilini no ukughendelela, wose iwang'ali wodaha kughenda kung'ondo, <verse eid="NUM 1:26" /><verse number="27" style="v" sid="NUM 1:27" />wala iwapetighwe mna iwana wa Yuda tsa elufu sabini na nne na miya sita. <verse eid="NUM 1:27" /><verse number="28" style="v" sid="NUM 1:28" />Na wana wa Isakari, ipfeleko pfao, kwa tsikolo tsao, kwa tsikaye tsao, kwa mataghwa gha aba tsao, awala iwapetighwe kwa ghamataghwa, chila mmale kwandusila miyaka ishilini no ukughendelela, wose iwang'ali wodaha kughenda kung'ondo, <verse eid="NUM 1:28" /><verse number="29" style="v" sid="NUM 1:29" />awala iwapetighwe mna iwana wa Isakari tsa elufu hamsini na nne na miya nne. <verse eid="NUM 1:29" /><verse number="30" style="v" sid="NUM 1:30" />Mne iwana wa Zabuloni, ipfeleko pfao, kwa tsikolo tsao, kwa tsikaye tsao, kwa mataghwa gha aba tsao, awala iwapetighwe kwa ghamataghwa, chila mmale kwandusila miyaka ishilini no ukughendelela, wose iwang'ali wodaha kughenda kung'ondo, <verse eid="NUM 1:30" /><verse number="31" style="v" sid="NUM 1:31" />awala iwapetighwe mna likabila lya Zebuloni tsawakala elufu hamsini na saba na miya nne. <verse eid="NUM 1:31" /><verse number="32" style="v" sid="NUM 1:32" />Mne iwana wa Yosefu, iwana wa Efuraimu, ipfeleko pfao, kwa tsikolo tsao, kwa tsikaye tsao, kwa mataghwa gha aba tsao, awala iwapetighwe kwa ghamataghwa, chila mmale kwandusila miyaka ishilini no ukughendelela, wose iwang'ali wodaha kughenda kung'ondo, <verse eid="NUM 1:32" /><verse number="33" style="v" sid="NUM 1:33" />awala iwapetighwe mna likabila lya Efuraimu tsawakala elufu alubaini na miya tano. <verse eid="NUM 1:33" /><verse number="34" style="v" sid="NUM 1:34" />Kabila lya Manase mwana wa Yosefu, ipfeleko pfao, kwa tsikolo tsao, kwa tsikaye tsao, kwa mataghwa gha aba tsao, awala iwapetighwe kwa ghamataghwa, chila mmale kwandusila miyaka ishilini no ukughendelela, wose iwang'ali wodaha kughenda kung'ondo, <verse eid="NUM 1:34" /><verse number="35" style="v" sid="NUM 1:35" />awala iwapetighwe mna likabila lya Manase tsa wakala elufu selasini na mbili na miya mbili. <verse eid="NUM 1:35" /><verse number="36" style="v" sid="NUM 1:36" />Mne iwana wa Benjamini, ipfeleko pfao, kwa tsikolo tsao, kwa tsikaye tsao, kwa mataghwa gha aba tsao, awala iwapetighwe kwa ghamataghwa, chila mmale kwandusila miyaka ishilini no ukughendelela, wose iwang'ali wodaha kughenda kung'ondo, <verse eid="NUM 1:36" /><verse number="37" style="v" sid="NUM 1:37" />awala iwapetighwe mna likabila lya Benjamini tsa wakala elufu selasini na tano na miya nne. <verse eid="NUM 1:37" /><verse number="38" style="v" sid="NUM 1:38" />Mne iwana wa Dani, ipfeleko pfao, kwa tsikolo tsao, kwa tsikaye tsao, kwa mataghwa gha aba tsao, awala iwapetighwe kwa ghamataghwa, chila mmale kwandusila miyaka ishilini no ukughendelela, wose iwang'ali wodaha kughenda kung'ondo, <verse eid="NUM 1:38" /><verse number="39" style="v" sid="NUM 1:39" />awala iwapetighwe mna likabila lya Dani tsawakala elufu sitini na mbili na miya saba. <verse eid="NUM 1:39" /><verse number="40" style="v" sid="NUM 1:40" />Mne iwana wa Asheri, ipfeleko pfao, kwa tsikolo tsao, kwa tsikaye tsao, kwa mataghwa gha aba tsao, awala iwapetighwe kwa ghamataghwa, chila mmale yane miyaka ishilini no ukughendelela, wose iwang'ali wodaha kughenda kung'ondo, <verse eid="NUM 1:40" /><verse number="41" style="v" sid="NUM 1:41" />awala iwapetighwe mna iwana wa Asheri tsawakala elufu alubaini na yumwe na miya tano. <verse eid="NUM 1:41" /><verse number="42" style="v" sid="NUM 1:42" />Mne iwana wa Naftari, ipfeleko pfao, kwa tsikolo tsao, kwa tsikaye tsao, kwa mataghwa gha aba tsao, awala iwapetighwe kwa ghamataghwa, chila mmale kwandusila miyaka ishilini no ukughendelela, wose iwang'ali wodaha kughenda kung'ondo, <verse eid="NUM 1:42" /><verse number="43" style="v" sid="NUM 1:43" />awala iwapetighwe mna iwana wa Naftari tsa elufu hamsini na ndatu na miya nne. <verse eid="NUM 1:43" /><verse number="44" style="v" sid="NUM 1:44" />Awano wawo iwapetighwe na Musa na Aruni, no ukwapfilighwa ne iwakulu wa Isiraeli, wana kumi na weli ka tsikaye tsa aba tsao pfatsili. <verse eid="NUM 1:44" /><verse number="45" style="v" sid="NUM 1:45" />Apfo awala wose iwapetighwe mna iwana wa Isiraeli, kwa tsikaye tsa aba tsawo, kwandusila wane imiyaka ishilini no ukughendelela, wose iwang'ali wodaha kughenda kung'ondo mna Isirael, <verse eid="NUM 1:45" /><verse number="46" style="v" sid="NUM 1:46" />wose tsawapfika laki sita, elufu ndatu, miya tano hamsini. <verse eid="NUM 1:46" /><verse number="47" style="v" sid="NUM 1:47" />Lekeni Walawi wao ng'awapetighwe baye hamwe na wayao. <verse eid="NUM 1:47" /><verse number="48" style="v" sid="NUM 1:48" />Kwaapfila IMNDEWA tsa kalonga na Musa, kalonga, <verse eid="NUM 1:48" /><verse number="49" style="v" sid="NUM 1:49" />“Uleke kuwapeta iwanu wa lukolo lwa Lawi hamwe na iwanu wa kolo tsa Isiraeli. <verse eid="NUM 1:49" /><verse number="50" style="v" sid="NUM 1:50" />Lekeni uweke Walawi mna isang'ano ya kulilolesa lihema lya ukwitinganila na mna ipfombo pfose ipfili mghati na ipfinu pfake pfose. Watsolighala lihema ne ipfinu pfake pfose, kuya watsolilolesa, na kwika indalo walitsunguluke lihema alyo lya kwitinganila. <verse eid="NUM 1:50" /><verse number="51" style="v" sid="NUM 1:51" />Lihema alyo haling'olighwa lyuke, Walawi watsolibomola, na halitsohimikighwa, Walawi watsolitsenga, na imunu yali si mlawi iyatsoliseghelela, ayo yakomighwe yafe. <verse eid="NUM 1:51" /><verse number="52" style="v" sid="NUM 1:52" />Na iwana wa Isiraeli wose watsotsenga chila imunu chibumbulika chake, hane indalo yake, na hane ibendela yake, ka pfaghali ghamakingili ghao ghe ing'ondo. <verse eid="NUM 1:52" /><verse number="53" style="v" sid="NUM 1:53" />Lekeni Walawi watsotsenga kutsunguluka Lihema lya Kwitinganila walilolese ili maya yangu ng'ulu ileke kuwapfikila Waisiraeli.” <verse eid="NUM 1:53" /><verse number="54" style="v" sid="NUM 1:54" />Kuya Waisiraeli watenda ghose ka IMNDEWA ghayamlaghitse Musa, apfo pfipfo pfawatendile.<verse eid="NUM 1:54" /></para>
  <chapter eid="NUM 1" />
  <chapter number="2" style="c" sid="NUM 2" />
  <para style="s">Tsindalo tsa Isiraeli pfatsitsokala</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 2:1" />IMNDEWA kalonga na Musa na Aruni, kalonga, <verse eid="NUM 2:1" /><verse number="2" style="v" sid="NUM 2:2" />Waisiraeli watsotsenga pfibumbulika pfao kutsunguluka lihema lya kwitinganila chila munu katsokala hane ibendela yake na chitango cha tsikaye tsa aba tsao, ukwilolesa na Lihema Lienzeluka. Watsakwika tsindalo kutsunguluka lihema alyo lyo lienzeluke. <verse eid="NUM 2:2" /><verse number="3" style="v" sid="NUM 2:3" />Awala iwatsotsenga ubali wa kwalilawila litsuwa kulolesa ubali wa mashaliki watsakuwa iwanu wa bendela ya Yuda kwa ghamakingili ghao, imkulu we iwanu wa Yuda katsakuwa Nashoni imwana wa Aminadabu. <verse eid="NUM 2:3" /><verse number="4" style="v" sid="NUM 2:4" />Kingili lyake ka pfawapetighwe tsa iwanu elufu sabini na nne na miya sita. <verse eid="NUM 2:4" /><verse number="5" style="v" sid="NUM 2:5" />Wang'amalitsa iwanu wa Yuda watsenge wanu wa lukolo lwa Isakari, na imkulu wao katsakuwa Natanaeli mwana wa Suari, <verse eid="NUM 2:5" /><verse number="6" style="v" sid="NUM 2:6" />Kingili lyake ka pfawapetighwe tsa iwanu elufu hamsini na nne na miya nne. <verse eid="NUM 2:6" /><verse number="7" style="v" sid="NUM 2:7" />Kuya likabila lya Zabuloni, imkulu wao katsakuwa Eliabu imwana wa Heloni. <verse eid="NUM 2:7" /><verse number="8" style="v" sid="NUM 2:8" />Kingili lyake ka pfawapetighwe tsa iwanu elufu hamsini na saba, na miya nne. <verse eid="NUM 2:8" /><verse number="9" style="v" sid="NUM 2:9" />Awala wose iwapetighwe kwa ghamataghwa ghao mna indalo ya Yuda, tsa laki imwe, elufu semanini na sita na miya nne. Awo wawo iwatsolongola mna ghumwanza. <verse eid="NUM 2:9" /><verse number="10" style="v" sid="NUM 2:10" />Kuna ubali wa kusini watsotsenga iwana wa bendela ya Rubeni kwa ghamakingili ghao, imkulu wao katsakuwa Elisuri imwana wa Shedeuri. <verse eid="NUM 2:10" /><verse number="11" style="v" sid="NUM 2:11" />Kingili lyake ka pfawapetighwe tsa iwanu elufu alubaini na sita na miya tano. <verse eid="NUM 2:11" /><verse number="12" style="v" sid="NUM 2:12" />Awala iwatsakwika indalo hambalimbali ha wanu wa Rubeni, watsakuwa iwanu wa lukolo lwa Simioni, na chilongotsi wawo katsakuwa imwana wa Surishadai yakemighwe Shelumieli, <verse eid="NUM 2:12" /><verse number="13" style="v" sid="NUM 2:13" />kingili lyake litsakuwa na wanu elufu hamsini na tisa na miya ndatu. <verse eid="NUM 2:13" /><verse number="14" style="v" sid="NUM 2:14" />Kuya kabila lya Gadi, chilongotsi wawo katsakuwa imwana wa Reueli yakemighwe Eliasafu, <verse eid="NUM 2:14" /><verse number="15" style="v" sid="NUM 2:15" />kingili lyake liisakuwa na wanu elufu alubaini na tano na miya sita hamsini. <verse eid="NUM 2:15" /><verse number="16" style="v" sid="NUM 2:16" />Iwamale wose iwatsakuwa mna ndalo ya Rubeni watsakuwa laki imwe, elufu hamsini na moja miya nne na hamsini. Awano watsakuwa mna kingili lya keli mna ghumwanza.<verse eid="NUM 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 2:17" />Kuya ndalo ya Walawi, awano tsawakala haghatighati he ndalo tsose aku waghala Lihema Lienzeluke, watsakuka kwa kuwinza tsibendela tsao pfatsili.<verse eid="NUM 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 2:18" />Kwa ubali wa kwalikuswela litsuwa litsokala kingili lya bendela ya Efulemu, watsakwika ndalo kwa makingili ghawo, chilongotsi wawo katsakuwa imwana wa Amihudi yakemighwe Elishama, <verse eid="NUM 2:18" /><verse number="19" style="v" sid="NUM 2:19" />kingili lyake litsakuwa na wanu elufu alubaini na miya tano. <verse eid="NUM 2:19" /><verse number="20" style="v" sid="NUM 2:20" />Hawotsolawa Waefulemu, litsokala kabila lya Manase, chilongotsi wawo katsakuwa imwana wa Pedasuri yakemighwe Gamalieli, <verse eid="NUM 2:20" /><verse number="21" style="v" sid="NUM 2:21" />kingili lyake lina wanu elufu selasini na mbili na miya mbili. <verse eid="NUM 2:21" /><verse number="22" style="v" sid="NUM 2:22" />Kuya kabila lya Benyamini, chilongotsi wawo katsakuwa imwana wa Gidioni yakemighwe Abidani, <verse eid="NUM 2:22" /><verse number="23" style="v" sid="NUM 2:23" />kingili lyake litsakuwa na wanu elufu selasini na tano na miya nne.<verse eid="NUM 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 2:24" />Iwanu wose iwatsakuwa mna likingili lya Efulemu watsakuwa laki imwe, elufu nane, na miya imwe. Kingili lino lya Efulemu litsakuwa lya kadatu mna ghumwanza.<verse eid="NUM 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 2:25" />Kwa ubali wa kasikazini, awala iwatsokala mna ndalo watsakuwa iwanu iwolongotsighwa na bendela ya Dani, na chilongotsi wawo katsakuwa imwana wa Amishadai yakemighwe Ahiezeri, <verse eid="NUM 2:25" /><verse number="26" style="v" sid="NUM 2:26" />kingili lyake litsakuwa na wanu elufu sitini na mbili na miya saba. <verse eid="NUM 2:26" /><verse number="27" style="v" sid="NUM 2:27" />Wang'alawa wanu wa Dani, iwatsakwika ndalo watsakuwa wanu wa kabila lya Asheli, chilongotsi wawo katsakuwa imwana wa Okilani yakemighwe Pagieli, <verse eid="NUM 2:27" /><verse number="28" style="v" sid="NUM 2:28" />kingili lyake lina wanu elufu alubaini na moja na miya tano.<verse eid="NUM 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 2:29" />Kuya wanu wa kabila lya Nafutali, chilongotsi wake imwana wa Enani yakemighwe Ahila, <verse eid="NUM 2:29" /><verse number="30" style="v" sid="NUM 2:30" />kingili lyake lina wanu elufu hamsini na ndatu na miya nne. <verse eid="NUM 2:30" /><verse number="31" style="v" sid="NUM 2:31" />Iwanu iwatsakuwa mna kingili lya Dani watsakuwa wanu laki imwe, elufu hamsini na saba na miya sita. Kingili lino litsakuwa lya kane na lya utsighilo ka tsibendela tsawo pfatsili.<verse eid="NUM 2:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 2:32" />Tsahana Waisiraeli laki sita, elufu ndatu, miya tano na hamsini iwapetighwe kwa kuwinza kolo tsawo ne tsindalo tsawo. <verse eid="NUM 2:32" /><verse number="33" style="v" sid="NUM 2:33" />Lekeni Walawi ng'awapetighwe baye hamwe na iwanu wa Isiraeli ka IMNDEWA pfayamlaghitse Musa. <verse eid="NUM 2:33" /><verse number="34" style="v" sid="NUM 2:34" />Apfo pfipfo Waisiraeli pfawatendile chila chinu ka IMNDEWA pfayamlaghitse Musa. Tsaweka tsindalo tsawo na woka, chila yumwe na kolo tsake.<verse eid="NUM 2:34" /></para>
  <chapter eid="NUM 2" />
  <chapter number="3" style="c" sid="NUM 3" />
  <para style="s">Iwana wa Aruni</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 3:1" />Apfino pfipfo ipfeleko pfa Aruni na Musa, ahala IMNDEWA hayalongile na Musa kune chidunda Sinai. <verse eid="NUM 3:1" /><verse number="2" style="v" sid="NUM 3:2" />Aruni tsakana wana wane na mataghwa ghawo aghano hano, mwanaghe chaudele tsakakemighwa Nadabu, wakeli Abihu, na wakadatu Eliazali na wakane Tamali. <verse eid="NUM 3:2" /><verse number="3" style="v" sid="NUM 3:3" />Awano tsawasaghulighwa kwa kughelighwa mapfuta ili wawe watambika. <verse eid="NUM 3:3" /><verse number="4" style="v" sid="NUM 3:4" />Lekeni Nadabu na Abihu tsawafa hambele ha IMNDEWA ahala hawalapfile ghumoto ing'aghubamighwe mna nyika Sinai, na tsawakala ng'aweleke wana wamale baye. Apfo Eleazari na Itamali wang'ali wosang'ana ka watambika ahala aba wawo Aruni hayakalile mghima.<verse eid="NUM 3:4" /></para>
  <para style="s">Walawi wosaghulighwa wawasang'anile iwatambika</para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 3:5" />IMNDEWA kamlongela Musa, <verse eid="NUM 3:5" /><verse number="6" style="v" sid="NUM 3:6" />“Waghale iwanu wa kabila lya Lawi habehi, uweke hambele ha Aruni ili wamsang'anile. <verse eid="NUM 3:6" /><verse number="7" style="v" sid="NUM 3:7" />Watsomsang'anila Aruni ne iwanu wose wa Isiraeli mna Lihema Lienzeluke. <verse eid="NUM 3:7" /><verse number="8" style="v" sid="NUM 3:8" />Watsololesa ipfinu pfose pfa Lihema Lienzeluke na kuwapfila Waisiraeli, ahala hawosang'ana mna Lihema Lienzeluke. <verse eid="NUM 3:8" /><verse number="9" style="v" sid="NUM 3:9" />Walawi awo kutsomwing'a Aruni ne wanaghe ili wawasang'anile. <verse eid="NUM 3:9" /><verse number="10" style="v" sid="NUM 3:10" />Wasaghule Aruni ne Wanaghe ili waitende sang'ano yao ya utambika, na munu wowose iyali muhenza yatsosoghela habehi na Lihema Lienzeluke yakomighwe.”<verse eid="NUM 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 3:11" />IMNDEWA kaghendelela kumlongela Musa, <verse eid="NUM 3:11" /><verse number="12" style="v" sid="NUM 3:12" />“Lola, niwaleka iwana chaudele wamale wose wa Waisiraeli, na niwasaghula Walawi ili wanisang'anille. Walawi watsakuwa wakwangu nene. <verse eid="NUM 3:12" /><verse number="13" style="v" sid="NUM 3:13" />Kwaapfila chila mwana mmale chaudele wa Waisiraeli wangu nene. Ahala haniwakomile iwana chaudele wose wa Misiri tsaniwabaghula awano wanisang'anile nene. Chila mwana chaudele we iwanu hata we iwanyama watsakuwa wangu. Nene yuyo IMNDEWA.”<verse eid="NUM 3:13" /></para>
  <para style="s">Walawi wopetighwa</para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 3:14" />Kuya IMNDEWA kamlongela Musa mna nyika ya Sinai, kalonga, <verse eid="NUM 3:14" /><verse number="15" style="v" sid="NUM 3:15" />“Uwapete iwana wa Lawi kwa kulola kolo tsao, na pfeleko pfao, iwanu wamale kwandusila iwana wadowado wa mwetsi ghumwe na kughendelela.” <verse eid="NUM 3:15" /><verse number="16" style="v" sid="NUM 3:16" />Apfo Musa kawapeta Walawi ka IMNDEWA pfayamlongele.<verse eid="NUM 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 3:17" />Awano wawo iwana wa Lawi, Gerishoni, Kohati, na Melali. <verse eid="NUM 3:17" /><verse number="18" style="v" sid="NUM 3:18" />Gerishoni tsakana wana weli Libini na Shimei. <verse eid="NUM 3:18" /><verse number="19" style="v" sid="NUM 3:19" />Kohati tsakana wana wane wamale, Amurani, Ishari, Heburoni na Uzieli. <verse eid="NUM 3:19" /><verse number="20" style="v" sid="NUM 3:20" />Naye Melali tsakana wana weli, Mahili na Mushi. Apfino tsa pfipfo ipfeleko pfa Lawi kwa tsikolo tsao.<verse eid="NUM 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 3:21" />Lweleko lwa Walibini na Washimei tsawalawa mna lukolo lwa Gerishoni. <verse eid="NUM 3:21" /><verse number="22" style="v" sid="NUM 3:22" />Iwamale wose iwapetighwe kulawa wane mwetsi ghumwe na kughendelela tsawapfikila elufu saba na miya tano. <verse eid="NUM 3:22" /><verse number="23" style="v" sid="NUM 3:23" />Wagerishoni tsaweka indalo ubali wa kwalikuswela litsua wa Lihema Lienzeluke, <verse eid="NUM 3:23" /><verse number="24" style="v" sid="NUM 3:24" />naye Eliasafu mwana wa Laeli tsa chilongotsi wa Wagerishoni. <verse eid="NUM 3:24" /><verse number="25" style="v" sid="NUM 3:25" />Sang'ano yao tsaikala kulilolesa Lihema Lihenzeluke na chighubiko chake, matsabahu, na panzia lya ghumlango ghwa Lihema Lienzeluke, <verse eid="NUM 3:25" /><verse number="26" style="v" sid="NUM 3:26" />mapanziya ghe luwa ighotsunguluka Lihema Lienzeluke, lisanduku, panziya lye ghumlango ghwe luwa na mitsabi yake.<verse eid="NUM 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 3:27" />Pfeleko pfa Kohati tsa Waamrani, Waishali, Waheburoni na Wauzieli. <verse eid="NUM 3:27" /><verse number="28" style="v" sid="NUM 3:28" />Mna pfeleko apfo pfose, iwamale wose iwapetighwe kulawa wane mwetsi ghumwe na kughendelela tsawapfikila elufu nane na miya sita, wose tsawasang'ana mna Lihema Lienzeluke. <verse eid="NUM 3:28" /><verse number="29" style="v" sid="NUM 3:29" />Awano tsawakala ubali wa kusini wa Lihema Lienzeluke, <verse eid="NUM 3:29" /><verse number="30" style="v" sid="NUM 3:30" />na chilongotsi wa iwanu wa Kohati tsa Elisafani. <verse eid="NUM 3:30" /><verse number="31" style="v" sid="NUM 3:31" />Isang'ano yao tsaikala kulilolesa lisanduku lya laghano, imetsa ya kwikila pfighate, chighutso cho kwikila ipfitasa, matsabahu, ipfinu pfawang'ali wotumila watambika, na lipanziya ilibaghula hanu haenzeluke na hanu haenzeluke ng'ani. <verse eid="NUM 3:31" /><verse number="32" style="v" sid="NUM 3:32" />Naye imwana wa mtambika Aruni yakemighwe Eliazari yuyo yatsakuwa mkulu wa iwakulu wa Walawi, naye katsowalolesa awala wose iwasang'ane ka wabetetsi mna Lihema Lihenzeluke. <verse eid="NUM 3:32" /><verse number="33" style="v" sid="NUM 3:33" />Melali tsakana pfeleko pfili, Wamahili na Wamushi. <verse eid="NUM 3:33" /><verse number="34" style="v" sid="NUM 3:34" />Kulawa mna ipfeleko apfo pfili, iwamale wose iwapetighwe kulawa wane mwetsi ghumwe na kughendelela tsawapfikila elufu sita na miya mbili. <verse eid="NUM 3:34" /><verse number="35" style="v" sid="NUM 3:35" />Chilongotsi wawo tsa Surieli mwana wa Abihaili. Awano tsaweka ndalo yao ubali wa kasikazini wa Lihema Lienzeluke. <verse eid="NUM 3:35" /><verse number="36" style="v" sid="NUM 3:36" />Tsaweng'ighwa sang'ano ya ukulolesa tsifulemu tsa Lihema, mifumbati, tsingutso tsake, pfikalilo pfake, ipfinu pfake pfose na sang'ano tsake tsose. <verse eid="NUM 3:36" /><verse number="37" style="v" sid="NUM 3:37" />Pfipfila tsawalolesa tsingutso tse luwa mtsunguluko ghose, pfikalilo pfake, pfighingi pfake, ne mitsabi yake.<verse eid="NUM 3:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 3:38" />Musa na Aruni ne wana wawo watsakwika ndalo hambele ha Lihema Lienzeluke ubali wa kwalilawila litsua. Ing'onde yawo tsaikala ukusang'ana mna Lihema Lienzeluke kwa ajili ya Waisiraeli. Na imunu wowose yatsosoghela habei tsakakomighwa. <verse eid="NUM 3:38" /><verse number="39" style="v" sid="NUM 3:39" />Iwamale wose wa Walawi iwapetighwe na Musa na Aruni kulawa wane mwetsi ghumwe na kughendelela tsa elufu ishilini na mbili.<verse eid="NUM 3:39" /></para>
  <para style="s">Walawi wokinda hanu ha wana chaudele wa Waisiraeli</para>
  <para style="p">
    <verse number="40" style="v" sid="NUM 3:40" />Kuya IMNDEWA kamlongela Musa, “Uwapete kwa ghamataghwa iwana wamale chaudele wose wa Isiraeli kulawa wane mwetsi ghumwe na kughendelela. <verse eid="NUM 3:40" /><verse number="41" style="v" sid="NUM 3:41" />Uwabaghule Walawi wawe wangu nene IMNDEWA hanu ha pfaudele wose wa wana wa Isiraeli, pfipfila uwasole iwanyama wa walawi hanu ha welekighwa wa mwanduso we iwanyama wa Isiraeli.” <verse eid="NUM 3:41" /><verse number="42" style="v" sid="NUM 3:42" />Apfo Musa kawapeta iwana chaudele wa Waisiraeli ka IMNDEWA pfayamlaghitse. <verse eid="NUM 3:42" /><verse number="43" style="v" sid="NUM 3:43" />Wose iwapetighwe kwandusila wane ghumwaka ghumwe na kughendelela tsawapfikila elufu ishilini na mbili miya mbili na sabini na tatu.<verse eid="NUM 3:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 3:44" />IMNDEWA kamlongela Musa, <verse eid="NUM 3:44" /><verse number="45" style="v" sid="NUM 3:45" />“Lelo uwasole Walawi wakinde hanu he imwana chaudele wa chila Muisiraeli, kwaapfila Walawi wose wangu. Pfipfila uwasole iwanyama wa Walawi wakinde hanu he welekighwa wa mwanduso we iwanyama wa Isiraeli. Nene yuyo IMNDEWA. <verse eid="NUM 3:45" /><verse number="46" style="v" sid="NUM 3:46" />Hana wana chaudele miya mbili sabini na tatu wa Waisiraeli iwongetseke mna Walawi waubamighwa kuwakombola. <verse eid="NUM 3:46" /><verse number="47" style="v" sid="NUM 3:47" />Kwa chila yumwe kutsosola pfihande pfitano pfa fetsa ka pfaikighwe mna Lihema lienzeluke, <verse eid="NUM 3:47" /><verse number="48" style="v" sid="NUM 3:48" />na tsifetsa atso tsa kuwakombola iwongetseke, kutsomwing'a Aruni ne wanaghe.” <verse eid="NUM 3:48" /><verse number="49" style="v" sid="NUM 3:49" />Apfo Musa kasola fetsa ya ukombola ya awala iwongetseke kubita Walawi, <verse eid="NUM 3:49" /><verse number="50" style="v" sid="NUM 3:50" />kasola ifetsa ayo kwa iwana chaudele wa Isiraeli pfihande pfa fetsa elufu imwe, miya ndatu, na sitini na tano ka pfapfili ipfinu pfa kulingila mna Lihema Lienzeluke, <verse eid="NUM 3:50" /><verse number="51" style="v" sid="NUM 3:51" />kaweng'a Aruni ne wanaghe ka IMNDEWA pfayamlaghitse.<verse eid="NUM 3:51" /></para>
  <chapter eid="NUM 3" />
  <chapter number="4" style="c" sid="NUM 4" />
  <para style="s">Sang'ano yaweng'ighwe Wakohati</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 4:1" />IMNDEWA kamlongela Musa na Aruni, <verse eid="NUM 4:1" /><verse number="2" style="v" sid="NUM 4:2" />Kulawa lukolo lwa Lawi, uwapete iwana wa Kohati, kwa kulola pfeleko pfawo, na tsikaye tsawo, <verse eid="NUM 4:2" /><verse number="3" style="v" sid="NUM 4:3" />kulawa wane miyaka selasini mbaka wane miyaka hamsini, awala iwodaha kusang'ana kune Lihema Lienzeluke <verse eid="NUM 4:3" /><verse number="4" style="v" sid="NUM 4:4" />Aino iyo sang'ano ya wana wa Kohati kwe pfinu pfihenzeluke ghendo.<verse eid="NUM 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 4:5" />Ahala hawotsakwinuka woke, Aruni ne wanaghe watsakwingila mghati mwe Lihema, watsolihulumsa panziya ilibaghula hanu haenzeluke na ihaenzeluke ng'ani, ilili hambele ha lisanduku lya laghano kuya walighubike lisanduku kwa lipanziya alyo. <verse eid="NUM 4:5" /><verse number="6" style="v" sid="NUM 4:6" />Mchanya mwake watsakwika ngotsi ndekendeke ya mene, kuya watsotandatsa chitambala cha langi ya buluu iliyeka, na kwingitsa imibiki yo kulighalila.<verse eid="NUM 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 4:7" />Mchanya mwe metsa ya kulapfila ipfighate, ipfikwikighwa hambele ha IMNDEWA, watsotandatsa chitambala cha langi ya buluu, na mchanya mwake watsakwika tsisahani, pfisahani pfa ubani, bakuli, na pfikombe pfo kwikila nambiko ya chokunwa. Matsuwa ghose pfighate pfitsokala mchanya mwe imetsa ayo. <verse eid="NUM 4:7" /><verse number="8" style="v" sid="NUM 4:8" />Kuya watsopfighubika ipfinu apfo pfose kwa chitambala chidung'u, na mchanya mwake watsakwika chighubiko cha ngotsi ndekendeke ya mene. Pfipfila watsakwingitsa imibiki ya ukulighalila imetsa ayo.<verse eid="NUM 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 4:9" />Kuya watsosola chitambala cha langi ya buluu, na kughubika ichighutso che pfitasa, makasi ghake, pfisahani pfake na pfinu pfose ipfitumika kughumila ghamapfuta gha nzeituni. <verse eid="NUM 4:9" /><verse number="10" style="v" sid="NUM 4:10" />Watsochika hamwe na pfinu pfake pfose mghati mwe ngotsi ndekendeke ya mene na kuyoha mna imibiki yo kuchighalila.<verse eid="NUM 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 4:11" />Kuya watsotandatsa chitambala cha buluu mchanya mwe lisanduku lya nzahabu lya kudusulila upfumba na kulighubika kwa ngotsi ndekendeke ya mene mchanya mwake. Kuya watsakwingitsa imibiki yake ya ukulighalila. <verse eid="NUM 4:11" /><verse number="12" style="v" sid="NUM 4:12" />Watsosola ipfinu pfose ipfitumika mna Lihema Lienzeluke, watsopfoha kwa chitambala cha langi lya buluu na kupfighubika kwa ngotsi ndekendeke ya mene, kuya watsopfika mchanya mwe imibiki yake yo ukulighalila. <verse eid="NUM 4:12" /><verse number="13" style="v" sid="NUM 4:13" />Watsolapfa lipfu mna matsabahu, na mchanya mwake watsotandatsa chitambala cha langi ya nzambalau. <verse eid="NUM 4:13" /><verse number="14" style="v" sid="NUM 4:14" />Mchanya mwe ichikong'o acho watsakwika ipfinu pfose ipfitumika mna sang'ano. Ipfinu apfo pfitsakuwa, pfihali pfa kuhalila ghumoto, pfinanikilo, tsikoleo tso ukulapfila lipfu na mabakuli. Kuya mchanya mwake watsotandatsa chighubiko cha ngotsi ndekendeke ya mene na kwingitsa imibiki yake ya ukulighalila. <verse eid="NUM 4:14" /><verse number="15" style="v" sid="NUM 4:15" />Aruni ne wanaghe hawotsomalitsa kughubika Lihema Lienzeluke, ipfinu, na ipfinu pfake pfose, na wang'andusa ghumwanza, iwanu wa pfeleko pfa Kohati watsakutsa kupfighala. Lekeni wawo ng'awobamighwa wapfikinde ghendo ipfinu'pfo pfihenzeluke, hela watsakufa. Ayo tsaikala sang'ano ya iwanu wa kabila lya Kohati ahala lihema lihenzeluke halisoghetsighwe. <verse eid="NUM 4:15" /><verse number="16" style="v" sid="NUM 4:16" />Eleazali imwana wa mtambika Aruni yeye kobamighwa yalololesa ghoya mapfuta ghe pfitasa, upfumba unung'ila ghoya, nambiko tse pfijo tsa chila tsuwa, mafuta gha kuhimikighwa na chila chinu ichihimikighwe mghati mwe lihema alyo.<verse eid="NUM 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 4:17" />Kuya IMNDEWA kamlongela Musa na Aruni, <verse eid="NUM 4:17" /><verse number="18" style="v" sid="NUM 4:18" />“Mleke kuwaleka iwanu wa lweleko lwa Kohati wakomighwe. <verse eid="NUM 4:18" /><verse number="19" style="v" sid="NUM 4:19" />Lelo, ili kuwatenda waleke kukomighwa kwa kupfisoghelela ipfinu pfa Lihema Lienzeluke ghendo, kutsotenda pfino, Aruni ne wanaghe watsakwingila na kuwagholela chila munu chayobamighwa kutenda na sang'ano yake. <verse eid="NUM 4:19" /><verse number="20" style="v" sid="NUM 4:20" />Lekeni iwanu wa lweleko lwa Kohati ng'awatsakwingila ghendo kupfilola ipfinu apfo pfienzeluke, wang'atenda apfo watsakufa.”<verse eid="NUM 4:20" /></para>
  <para style="s">Sang'ano tsaweng'ighwe lweleko lwa Gerishoni</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 4:21" />IMNDEWA kamlongela Musa, <verse eid="NUM 4:21" /><verse number="22" style="v" sid="NUM 4:22" />Uwapete wanu wa lweleko lwa Gerishoni kwa kuwinza tsikaye tsawo na kolo tsawo. <verse eid="NUM 4:22" /><verse number="23" style="v" sid="NUM 4:23" />Kutsowapeta iwamale wose kulawa wane miyaka selasini na wane miyaka hamsini iwodaha kusang'ana mna Lihema Lienzeluke. <verse eid="NUM 4:23" /><verse number="24" style="v" sid="NUM 4:24" />Aino itsakuwa sang'ano ya Wagerishoni na ipfinu pfawatsoghala, <verse eid="NUM 4:24" /><verse number="25" style="v" sid="NUM 4:25" />Kughala mapanziya gha Lihema Lienzeluke na chighubiko chake, chighubiko cha ngotsi ndekendeke ya mene ichili mchanya mwake, lipanziya lya ghumlango ghwa Lihema Lenzeluke, <verse eid="NUM 4:25" /><verse number="26" style="v" sid="NUM 4:26" />mapanziya na mitsabi ya luwa itsunguluke Lihema na lisanduku lya kulakatsila nambiko, na ipfinu pfose ipfitumika hamwe ne pfinu pfino. Wawo watsotenda ghose ighobamighwa mna ipfinu pfino. <verse eid="NUM 4:26" /><verse number="27" style="v" sid="NUM 4:27" />Aruni ne wanaghe iwali watambika wawo watsowalaghitsa Wagerishoni ahala hawatsoghala ipfinu na sang'ano tsawotsotenda. Kutsowagholela ipfinu pfose pfawobamighwa kughala. <verse eid="NUM 4:27" /><verse number="28" style="v" sid="NUM 4:28" />Aino iyo sang'ano ya iwanu wa lweleko lwa Gerishoni mna Lihema Lienzeluke, watsolongotsighwa na Itamali imwana wa mtambika Aruni.<verse eid="NUM 4:28" /></para>
  <para style="s">Sang'ano tsaweng'ighwe lweleko lwa Melali</para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 4:29" />Pfipfila kutsowapeta iwanu wa lweleko lwa Melali kwa kuwinza tsikaye tsa aba tsawo na kolo tsawo. <verse eid="NUM 4:29" /><verse number="30" style="v" sid="NUM 4:30" />Kutsowapeta iwamale wose kulawa wane miyaka selasini mbaka wane miyaka hamsini iwodaha kusang'ana mna Lihema Lienzeluke. <verse eid="NUM 4:30" /><verse number="31" style="v" sid="NUM 4:31" />Sang'ano yawo itsakuwa ino, ukughala tsifulemu, imifumbati, tsingutso na ipfikalilo pfake. <verse eid="NUM 4:31" /><verse number="32" style="v" sid="NUM 4:32" />Pfipfila watsoghala tsingutso tse luwa itsitsunguluka, ipfikalilo pfake, pfighingi pfa lihema, mitsabi hamwe na ipfinu pfose ne pfombo pfake pfose. Chila munu katsoghala ka pfayagholelighwe. <verse eid="NUM 4:32" /><verse number="33" style="v" sid="NUM 4:33" />Aino iyo sang'ano ya iwanu wa lweleko lwa Melali mna lihema lya kwitinganila, watsolongotsighwa na Itamali imwana wa mtambika Aruni.<verse eid="NUM 4:33" /></para>
  <para style="s">Ukupetighwa kwa Walawi</para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 4:34" />Apfo Musa na Aruni na pfilongotsi wose wawapeta iwanu wa lukolo lwa Kohati kwa kuwinza pfeleko pfao na tsikaye tsa aba tsawo. <verse eid="NUM 4:34" /><verse number="35" style="v" sid="NUM 4:35" />Tsawawapeta iwanu wose kulawa wane miyaka selasini mbaka wane miyaka hamsini iwodaha kusang'ana mna Lihema Lienzeluke. <verse eid="NUM 4:35" /><verse number="36" style="v" sid="NUM 4:36" />Wose iwapetighwe tsawapfikila elufu mbili, miya saba na hamsini. <verse eid="NUM 4:36" /><verse number="37" style="v" sid="NUM 4:37" />Awano wawo iwanu wa lweleko lwa Kohati iwasang'ane mna Lihema Lienzeluke iwapetighwe na Musa na Aruni ka IMNDEWA pfayamlaghitse Musa.<verse eid="NUM 4:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 4:38" />Iwanu wose wa lweleko lwa Gerishoni iwapetighwe kwa kuwinza pfeleko pfao na tsikaye tsa aba tsawo, <verse eid="NUM 4:38" /><verse number="39" style="v" sid="NUM 4:39" />kulawa wane miyaka selasini mbaka hamsini iwodaha kusang'ana mna Lihema Lienzeluke, <verse eid="NUM 4:39" /><verse number="40" style="v" sid="NUM 4:40" />tsawapfikila wanu elufu mbili, miya sita na selasini. <verse eid="NUM 4:40" /><verse number="41" style="v" sid="NUM 4:41" />Awano wawo iwanu wa lweleko lwa Gerishoni iwasang'ane mna Lihema Lienzeluke iwapetighwe na Musa na Aruni ka IMNDEWA pfayamlaghitse Musa. <verse eid="NUM 4:41" /><verse number="42" style="v" sid="NUM 4:42" />Wose iwapetighwe wa lukolo lwa Melali kwa kuwinza pfeleko pfawo na tsing'anda tsa tsawo, <verse eid="NUM 4:42" /><verse number="43" style="v" sid="NUM 4:43" />kulawa wane miyaka selasini mbaka hamsini, iwadahile kusang'ana mna Lihema Lienzeluke, <verse eid="NUM 4:43" /><verse number="44" style="v" sid="NUM 4:44" />tsawapfikila wanu elufu ndatu na miya mbili. <verse eid="NUM 4:44" /><verse number="45" style="v" sid="NUM 4:45" />Awano wawo iwanu wa lweleko lwa Melali iwapetighwe na Musa na Aruni ka IMNDEWA pfayamlaghitse Musa.<verse eid="NUM 4:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="NUM 4:46" />Apfo Musa, Aruni, na pfilongotsi wose wa Isiraeli wawapeta Walawi kwa kuwinza pfeleko pfao na tsikaye tsa aba tsawo, <verse eid="NUM 4:46" /><verse number="47" style="v" sid="NUM 4:47" />kulawa wane miyaka selasini mbaka hamsini na awala iwatsile kusang'ana na kughala ipfinu mna Lihema Lienzeluke, <verse eid="NUM 4:47" /><verse number="48" style="v" sid="NUM 4:48" />wose tsawawa wanu elufu nane, miya tano na semanini. <verse eid="NUM 4:48" /><verse number="49" style="v" sid="NUM 4:49" />Chila munu tsakeng'ighwa sang'ano yo kutenda na choni cho kughala mna lihema lya kwitinganila ka IMNDEWA pfayamlaghitse Musa.<verse eid="NUM 4:49" /></para>
  <chapter eid="NUM 4" />
  <chapter number="5" style="c" sid="NUM 5" />
  <para style="s">Iwanu iwehile</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 5:1" />IMNDEWA kamlongela Musa, <verse eid="NUM 5:1" /><verse number="2" style="v" sid="NUM 5:2" />“Walongele Waisiraeli wamlapfe kunze kwe ndalo chila munu yane utamu wa ngotsi, yolawa udusi na iyehile hambele he Imulungu kwa kukinda mauti. <verse eid="NUM 5:2" /><verse number="3" style="v" sid="NUM 5:3" />Iwanu wose wano, iwamale ne wapinga mtsowalapfa kunze kwe ndalo, ili waleke kuitenda indalo yangu yanikala ihe.” <verse eid="NUM 5:3" /><verse number="4" style="v" sid="NUM 5:4" />Waisiraeli tsawatenda pfipfila ka IMNDEWA pfayawalaghitse, wawalapfa waweka kunze kwe ndalo ka Imulungu pfayalongile na Musa.<verse eid="NUM 5:4" /></para>
  <para style="s">Waisiraeli wosama</para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 5:5" />Kuya IMNDEWA kamlongela Musa, <verse eid="NUM 5:5" /><verse number="6" style="v" sid="NUM 5:6" />“Walongele Waisiraeli pfino, munu wowose, mmale au pinga yang'amtendela pfihile miyaghe, imunu'yo kakuwa katenda nzambi kwe IMNDEWA. <verse eid="NUM 5:6" /><verse number="7" style="v" sid="NUM 5:7" />Pfipfila kobamighwa yalonge inzambi yake yaitendile na yamlihe chinu chose na yongetse asilimiya ishilini kwe munu yula yamtendele pfihile. <verse eid="NUM 5:7" /><verse number="8" style="v" sid="NUM 5:8" />Lekeni ka imunu'yo kafa na kahela ndughu wa habei wa kusola maliho agho, maliho agho ghatsolapfighwa kwe IMNDEWA ghawe gha mtambika. Maliho agho ighatsolapfighwa ghawe na ng'unzu wa kumleghusila nzambi yake iyaitendile. <verse eid="NUM 5:8" /><verse number="9" style="v" sid="NUM 5:9" />Chila Waisiraeli chawalapfile kwe Mtwatsa Imulungu, chitsakuwa cha mtambika. <verse eid="NUM 5:9" /><verse number="10" style="v" sid="NUM 5:10" />Na chila chinu chochose imunu chayomwing'a mtambika chitsakuwa chake.”<verse eid="NUM 5:10" /></para>
  <para style="s">Maghomba ghe wapinga iwakwanga ne wamale wangi</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 5:11" />IMNDEWA kamlongela Musa, <verse eid="NUM 5:11" /><verse number="12" style="v" sid="NUM 5:12" />Walongele Waisiraeli pfino, ka mwehe we munu kawasa na mmale yungi, <verse eid="NUM 5:12" /><verse number="13" style="v" sid="NUM 5:13" />katenda ughoni bila mmale wake kumanya, ipinga ayo kakuwa keha hambele he IMNDEWA, na wala kuduhu munu yamwonile kwaapfila ng'aghoghighwe baye. <verse eid="NUM 5:13" /><verse number="14" style="v" sid="NUM 5:14" />Lekeni mmale wake yang'amwalangula pfihile mwehe wake iyehile hambele he Imulungu au ka komwonela chepfu hela mwehe wake hata ka ng'ehile baye, <verse eid="NUM 5:14" /><verse number="15" style="v" sid="NUM 5:15" />baho wose weli watsoghenda kwa mtambika, na waghale nambiko iibamighwa, nambiko ayo itsakuwa kimbo limwe lya usaghe wa shayili, lekeni waleke kughuma mapfuta au upfumba kwaapfila ayo nambiko ya usaghe ya mmale yane chepfu kwa mwehe wake, ili yoneke ka pinga katotsa au ng'atotsile baye. <verse eid="NUM 5:15" /><verse number="16" style="v" sid="NUM 5:16" />Naye mtambika katsomsoghetsa ipinga ayo hambele ha IMNDEWA. <verse eid="NUM 5:16" /><verse number="17" style="v" sid="NUM 5:17" />Kuya mtambika katsosola matsi ighaenzeluke mna chia, katsoghela mghati timbwisi lyatsosola hasi ha lihema ili ghawe ghosungu. <verse eid="NUM 5:17" /><verse number="18" style="v" sid="NUM 5:18" />Naye mtambika katsomwika ipinga ayo hambele he IMNDEWA na kumdohola tsimvili tsake, kuya katsomwing'a inambiko ayo ya usaghe iilapfighwa kwa konelighwa chepfu na mmale wake. Na mna ghumwoko ghwake katsokinda ghamatsi ighali usungu ighoghala lana. <verse eid="NUM 5:18" /><verse number="19" style="v" sid="NUM 5:19" />Kuya mtambika katsomlighita ipinga ayo kolonga, Ka ng'uwasile na mmale yungi baye, na ghweghwe kwa mwehe wa munu, ghamatsi ghano ighali usungu ghaleke kukulagha. <verse eid="NUM 5:19" /><verse number="20" style="v" sid="NUM 5:20" />Lekeni ka kwiha kwa kuwasa na mmale yungi aku kuna immale wako, <verse eid="NUM 5:20" /><verse number="21" style="v" sid="NUM 5:21" />IMNDEWA yakulighite kune wanu wako, uleke kweleka na lida lyako lipfuhumke. <verse eid="NUM 5:21" /><verse number="22" style="v" sid="NUM 5:22" />Ghamatsi ghano ighokutenda ulighitighwe ghatsakwingila munda mwako ghakutende uleke kweleka na lida lyako lipfuhumke, Naye ipinga katsakwidika, “Amina, Amina.”<verse eid="NUM 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 5:23" />Kuya mtambika katsakwandika ghamalighito agho mna chitabu na katsotsifuta kwa ghamatsi ighali usungu, <verse eid="NUM 5:23" /><verse number="24" style="v" sid="NUM 5:24" />hambele katsomnwesa ipinga ayo ghamatsi ighali usungu ighoghala malighito, nagho ghatsakwingila munda mwake kuya ghatsomtenda munda mwake mtame ghendo, ka kaghatenda. <verse eid="NUM 5:24" /><verse number="25" style="v" sid="NUM 5:25" />Imtambika katsosola inambiko ila ya usaghe ya chepfu mna ghumoko ghwe ipinga yula, na kuinula hambele he IMNDEWA, kuya katsoighala mchanya mwe matsabahu. <verse eid="NUM 5:25" /><verse number="26" style="v" sid="NUM 5:26" />Pfipfila katsodegha ghao limwe lya nambiko ayo ya usaghe, iwe ya kukumbukagha na katsoilakatsa mna matsabahu, kuya katsomnwesa ghamatsi agho. <verse eid="NUM 5:26" /><verse number="27" style="v" sid="NUM 5:27" />Hayatsakunwa ghamatsi agho, na haitsakwoneka ka kawasa na mmale yungi, ghamatsi agho ighoghala malighito ghatsomtenda munda mwake mtame, na lukuli lwake lutsohumka na ng'atsokinda keli inda baye. Ipinga ayo katsakuwa kana lana kwe wanu wake. <verse eid="NUM 5:27" /><verse number="28" style="v" sid="NUM 5:28" />Lekeni ka ng'awasile na mmale yungi baye, kuya kela hambele he Imulungu, katsakoneka ng'atotsile baye, apfo ng'atsoghaya baye na katsakweleka wana.<verse eid="NUM 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 5:29" />Alino lilyo laghitso lya chepfu, aho imwehe iyali na mmale wake yang'awasa na mmale yungi na kwitenda yehe hambele he Imulungu, <verse eid="NUM 5:29" /><verse number="30" style="v" sid="NUM 5:30" />au immale yang'amwonela chepfu imwehe wake na kompfikitsa pfihile. Katsomghala ipinga ayo yeme hambele he IMNDEWA, na mtambika katsotenda ghose kwa kuwinza laghitso lino. <verse eid="NUM 5:30" /><verse number="31" style="v" sid="NUM 5:31" />Na mmale ayo katsakuwa ng'atotsile baye, lekeni ka katotsa ipinga ayo ighatsompata agho ghake.<verse eid="NUM 5:31" /></para>
  <chapter eid="NUM 5" />
  <chapter number="6" style="c" sid="NUM 6" />
  <para style="s">Malaghitso gha kwika natsili</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 6:1" />Kuya IMNDEWA kamlongela Musa, <verse eid="NUM 6:1" /><verse number="2" style="v" sid="NUM 6:2" />Walongele Waisiraeli malaghitso ghano, imunu mmale au pinga hayatsakwika natsili ng'ulu lya kwihika hambele he IMNDEWA, au kwibaghula ne IMNDEWA, <verse eid="NUM 6:2" /><verse number="3" style="v" sid="NUM 6:3" />yaleke kunwa dipfai wala mbwali, yaleke kunwa sanga ya nzabibu au mbwali ng'ali, yaleke kunwa matsi gha nzabibu wala kuja nzabibu tsipfile wala tsinyalile. <verse eid="NUM 6:3" /><verse number="4" style="v" sid="NUM 6:4" />Matsuwa ghose hayatsakwika natsili yaleke kuja chinu chochose ichilawa mna mnzabibu, kulawa tsimbeghu mbaka imibangu.<verse eid="NUM 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 6:5" />Matsuwa ghose gha natsili yake ya kwibaghula, yaleke kugheta mvili tsake mbaka natsili yake ya kwihika hambele he IMNDEWA itimile, katsokala kahenzeluka, katsotsileka mvili tsake tsikule. <verse eid="NUM 6:5" /><verse number="6" style="v" sid="NUM 6:6" />Matsuwa ghose ghayebaghula yawe we Mtwatsa Imulungu, yaleke kuseghelela mauti, <verse eid="NUM 6:6" /><verse number="7" style="v" sid="NUM 6:7" />hata ka gha aba, mai, ndughu au lumbu lyake, hela katsetenda keha kwaapfila kehika hambele he Mtwatsa Imulungu. <verse eid="NUM 6:7" /><verse number="8" style="v" sid="NUM 6:8" />Matsuwa ghose hayatsakuwa mnatsili, katsakuwa kahenzeluka kwe IMNDEWA.<verse eid="NUM 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 6:9" />Ka munu kakufa kwa kwidukitsa hambele he munu yekile natsili, na kutsitenda tsimvili tsa yekile natsili tsihe, katsotsigheta mna litsuwa lya saba. <verse eid="NUM 6:9" /><verse number="10" style="v" sid="NUM 6:10" />Na mna litsuwa lya nane katsoghala kwa mtambika njiwa weli au makinda meli gha tetele hane ghumlango ghwa Lihema Lienzeluke. <verse eid="NUM 6:10" /><verse number="11" style="v" sid="NUM 6:11" />Mtambika katsomlapfa yumwe yawe wa nambiko ya kuleghusa nzambi, na yungi yawe wa nambiko ya kulakatsighwa, naye katsomleghusila nzambi yake yo kukinda mauti. Mne litsuwa lilyo katsotsigheta tsimvili tsake na kakuwa kaenzeluka, <verse eid="NUM 6:11" /><verse number="12" style="v" sid="NUM 6:12" />na kwitenda yele hambele he IMNDEWA kwa matsuwa ghake ghokwibaghula. Matsuwa agho gha mwanduso ghatsopetighwa kwaapfila tsimvili tsake itsihopfughighwe, tsatsafinala. Katsolapfa ng'olo wa mwaka ghumwe, ili yawe nambiko ya kuleghusa totso.<verse eid="NUM 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 6:13" />Aghano ghagho malaghitso gha imunu yekile natsili ahala hayomalitsa kwiika hambele he IMNDEWA. Katsoghalighwa hane ghumlango ghwa Lihema Lienzeluke, <verse eid="NUM 6:13" /><verse number="14" style="v" sid="NUM 6:14" />na kumlapfila IMNDEWA nambiko tsake, mwanang'olo yumwe wa mwaka ghumwe iyenelele wa nambiko ya kulakatsighwa, mwana weng'olo pinga yumwe wa mwaka ghumwe iyenelele wa nambiko ya kuleghusa nzambi, na ng'olo mmale yumwe wa nambiko ya kukala tseghamba ne Imulungu.<verse eid="NUM 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 6:15" />Pfipfila katsolapfa chiseghe cha pfighate ipfilihela hamila, maandasi gha usaghe utighinike na mapfuta, hamwe na nambiko tse pfijo na pfokunwa.<verse eid="NUM 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 6:16" />Mtambika katsomlapfila IMNDEWA pfinu pfose pfino hamwe na nambiko ya kuleghusa nzambi na nambiko ya kulakatsighwa. <verse eid="NUM 6:16" /><verse number="17" style="v" sid="NUM 6:17" />Katsomlapfila IMNDEWA ing'olo ayo ka nambiko ya kukala tseghamba ne Imulungu, pfipfila katsolapfa chiseghe che pfighate ipfilihela hamila, nambiko ye pfijo na pfokunwa. <verse eid="NUM 6:17" /><verse number="18" style="v" sid="NUM 6:18" />Aho hane ghumlango ghwa Lihema Lienzeluke, imunu ayo yekile natsili katsoghetsa mvili tsake na kutsika mna ghumoto ighuli mna nambiko yo kukala tseghamba ne Imulungu.<verse eid="NUM 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 6:19" />Kuya mtambika katsosola lihegha lye ng'olo mmale ilyambikighwe hamwe na liandatsi limwe ing'alighelighwe hamila na pfighate pfisisili ing'apfighelighwe hamila kulawa mna chiseghe, katsomwing'a imunu yekile natsili mna ghamoko ghake ahala hayomalitsa kugheta tsimvili tsake. <verse eid="NUM 6:19" /><verse number="20" style="v" sid="NUM 6:20" />Pfipfila mtambika katsopfihighisa ipfinu apfo, chidali na lihatsa ka nambiko ya kwinulighwa hambele he IMNDEWA. Pfose pfino pfitsakuwa ka nambiko yenzeluke kwa mtambika. Hayomalitsa kutenda apfo imunu yekile natsili katsakunwa idipfai.<verse eid="NUM 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 6:21" />Aghano ghagho malaghitso gha imunu yekile natsili ahala hayelaha kumlapfila IMNDEWA nambiko. Nambiko yake yomlapfila IMNDEWA, ilinge na apfila pfayelahile hata ka katsolapfa chinu chingi.<verse eid="NUM 6:21" /></para>
  <para style="s">Tsimotelo tse iwanu kubitila watambika</para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 6:22" />IMNDEWA kamlongela Musa, <verse eid="NUM 6:22" /><verse number="23" style="v" sid="NUM 6:23" />Mlongele Aruni ne wanaghe, apfino pfipfo pfamtsowamotetsa Waisiraeli,<verse eid="NUM 6:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="NUM 6:24" />IMNDEWA yawamotetse na kuwalolesa,<verse eid="NUM 6:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="NUM 6:25" />IMNDEWA yawalole kwa uluso na yawatendele ighanoghile,<verse eid="NUM 6:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="NUM 6:26" />IMNDEWA yawalanguse wende wake na yawatende mkale tseghamba.<verse eid="NUM 6:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 6:27" />“Apfi pfipfo pfawatsolikema taghwa lyangu kwa Waisiraeli, na nene nitsowamotetsa.”<verse eid="NUM 6:27" /></para>
  <chapter eid="NUM 6" />
  <chapter number="7" style="c" sid="NUM 7" />
  <para style="s">Tsinambiko tsa pfilongotsi tsa kulihimika Lihema Lienzeluke</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 7:1" />Mne litsuwa Musa hayamalitse kulimitsa wima lihema, tsakalighela mapfuta na kulihimika ili lienzeluke, pfipfila tsakachighela mapfuta na kuchika matsabahu hamwe na pfinu pfake pfose ili pfienzeluke. <verse eid="NUM 7:1" /><verse number="2" style="v" sid="NUM 7:2" />Kuya pfilongotsi wa Isiraeli, iwakulu wa ghamakabila tsawalapfa nambiko tsao. Awano wawo iwamwapfile Musa ahala iwanu hawapetighwe, <verse eid="NUM 7:2" /><verse number="3" style="v" sid="NUM 7:3" />wamlapfila IMNDEWA nambiko tsawo, mituka sita ya kukweghighwa ne wanyama ighaghubikighwe na ng'ombe wamale kumi na weli, mtuka ghumwe kwa chila pfilongotsi weli, na ng'ombe yumwe kwa chila chilongotsi yumwe. Hawamalitse kupfilapfa hambele ha lihema, <verse eid="NUM 7:3" /><verse number="4" style="v" sid="NUM 7:4" />IMNDEWA kamlongela Musa, <verse eid="NUM 7:4" /><verse number="5" style="v" sid="NUM 7:5" />“Ubokele nambiko tsino ili tsitumike mna sang'ano ya Lihema Lihenzeluke, uweng'e Walawi chila yumwe kwa kulola sang'ano yake.” <verse eid="NUM 7:5" /><verse number="6" style="v" sid="NUM 7:6" />Baho Musa kasola imituka, na wang'ombe wamale kaweng'a walawi. <verse eid="NUM 7:6" /><verse number="7" style="v" sid="NUM 7:7" />Wagerishoni tsaweng'ighwa mituka mili na ng'ombe wamale wane kwa ajili ya sang'ano tsawo, <verse eid="NUM 7:7" /><verse number="8" style="v" sid="NUM 7:8" />na Wamelali weng'ighwa mituka mine na ng'ombe wamale wanane ili iwapfile mna sang'ano tsawo tsose. Awo Wagerishoni na Wamelali tsawalongotsighwa na Itamali mwana wa mtambika Aruni. <verse eid="NUM 7:8" /><verse number="9" style="v" sid="NUM 7:9" />Lekeni Musa ng'aweng'ile chinu chochose Wakohati kwaapfila wao tsawana sang'ano ya kulolesa pfinu pfienzeluke ipfibamighwe kughalighwa mmayegha.<verse eid="NUM 7:9" /></para>
  <para style="s">Tsinambiko tsa pfilongotsi tsa kuhimika lisanduku lya tsinambiko</para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 7:10" />Pfilongotsi awo tsawalapfa nambiko tsa kuihimika matsabahu mna litsuwa lila haighelighwe mapfuta, tsawalapfa nambiko tsawo hambele he matsabahu. <verse eid="NUM 7:10" /><verse number="11" style="v" sid="NUM 7:11" />IMNDEWA kamlongela Musa, “Mna chila tsuwa chilongotsi yumwe yalapfe nambiko yake ya kuihimika matsabahu.”<verse eid="NUM 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 7:12" />Ayula yalapfile nambiko mna litsuwa lya mwanduso tsakakala Nashoni imwana wa Aminadabu wa kabila lya Yuda. <verse eid="NUM 7:12" /><verse number="13" style="v" sid="NUM 7:13" />Nambiko yake tsa sahani imwe ya fetsa ine utsito wa kilo imwe na nusu, na bakuli imwe ya fetsa ine utsito wa glamu miya nane ka pfapfikighwe ipfinu pfa kulingila ipfili hane Lihema Lienzeluke, sahani na bilika alyo tsapfimema usaghe utighinike ghendo iuhanganyighwe na mapfuta iwe nambiko ya usaghe. <verse eid="NUM 7:13" /><verse number="14" style="v" sid="NUM 7:14" />Chisahani chimwe cha nzahabu chine utsito wa glamu miya imwe na kumi, ichimemile upfumba, <verse eid="NUM 7:14" /><verse number="15" style="v" sid="NUM 7:15" />ng'ombe mmale yumwe iyali mdodo, ng'olo mmale yumwe, na mwanang'olo yumwe mmale wa mwaka ghumwe yawe wa nambiko ya kulakatsighwa, <verse eid="NUM 7:15" /><verse number="16" style="v" sid="NUM 7:16" />mvulati yumwe wa nambiko ya kuleghusa nzambi, <verse eid="NUM 7:16" /><verse number="17" style="v" sid="NUM 7:17" />na ng'ombe weli wamale, ng'olo wamale watano, mvulati watano na wanang'olo watano wamale wa mwaka ghumwe. Awo watsakuwa wa nambiko ya kukala tseghamba. Ayo tsaikala iyo inambiko ya Nashoni mwana wa Aminadabu.<verse eid="NUM 7:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 7:18" />Ayula iyalapfile nambiko mna litsuwa lya keli tsa Netaneli mwana wa Suari, yeye tsakakala chilongotsi wa kabila lya Isakari, <verse eid="NUM 7:18" /><verse number="19" style="v" sid="NUM 7:19" />naye pfipfila tsakalapfa nambiko tsino, Sahani imwe ya fetsa ine utsito wa kilo imwe na nusu, bakuli lya fetsa lya glamu miya nane, ka pfapfikighwe ipfinu pfa kulingila ipfili hane Lihema Lienzeluke, isahani ne ibakuli ayo tsapfimema usaghe utighinike ghendo uihanganyighwe na mapfuta kwaajili ya nambiko ya usaghe, <verse eid="NUM 7:19" /><verse number="20" style="v" sid="NUM 7:20" />chisahani chimwe cha nzahabu cha glamu miya imwe na kumi ichimemile upfumba, <verse eid="NUM 7:20" /><verse number="21" style="v" sid="NUM 7:21" />ng'ombe mmale yumwe iyali mdodo ng'olo mmale yumwe na mwana we ng'olo mmale wa mwaka ghumwe, awo tsawalapfighwa wawe wa nambiko ya kulakatsighwa. <verse eid="NUM 7:21" /><verse number="22" style="v" sid="NUM 7:22" />Mvulati yumwe wa nambiko ya kuleghusa nzambi, <verse eid="NUM 7:22" /><verse number="23" style="v" sid="NUM 7:23" />ng'ombe wamale weli, ng'olo wamale watano, mvulati watano na wanang'olo wamale watano wa mwaka ghumwe, awo tsawalapfighwa wawe wa nambiko ya kukala tseghamba. Ayo tsaikala nambiko ya Netaneli mwana wa Suari.<verse eid="NUM 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 7:24" />Mne litsuwa lya kadatu yalapfile nambiko tsa Eliabu mwana wa Heloni iyakalile chilongotsi wa kabila lya Zebuluni. <verse eid="NUM 7:24" /><verse number="25" style="v" sid="NUM 7:25" />Yeye tsakalapfa nambiko tsino, sahani imwe ya fetsa ya kilo imwe na nusu, bakuli imwe ya fetsa ya glamu miya nane ka pfapfikighwe ipfinu pfa kulingila ipfili hane Lihema Lienzeluke, tsisahani na bakuli atso tsatsimema usaghe utighinike ghendo uhanganyighwe na mapfuta. Apfo tsapfilapfighwa kwaajili ya nambiko ya tse ipfijo, <verse eid="NUM 7:25" /><verse number="26" style="v" sid="NUM 7:26" />chisahani chimwe cha nzahabu cha glamu miya imwe na kumi ichimemile upfumba, <verse eid="NUM 7:26" /><verse number="27" style="v" sid="NUM 7:27" />ng'ombe mmale yumwe iyali mdodo, ng'olo mmale yumwe na mwana we ng'olo yumwe wa mwaka ghumwe, awo tsawalapfighwa wawe nambiko ya kulakatsighwa, <verse eid="NUM 7:27" /><verse number="28" style="v" sid="NUM 7:28" />mvulati yumwe wa nambiko ya kuleghusa nzambi, <verse eid="NUM 7:28" /><verse number="29" style="v" sid="NUM 7:29" />ng'ombe wamale weli, ng'olo wamale watano, mvulati watano, na wanang'olo wamale watano wa mwaka ghumwe wawe wa nambiko tsa kukala tseghamba. Aino tsakikala nambiko ya Eliabu mwana wa Heloni.<verse eid="NUM 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 7:30" />Mne litsuwa lya kane yalapfile nambiko tsa Elisuri mwana wa Shedeuri, ayuno tsa chilongotsi wa kabila lya Rubeni. <verse eid="NUM 7:30" /><verse number="31" style="v" sid="NUM 7:31" />Yeye tsakalapfa nambiko ino, sahani imwe ya fetsa ya kilo imwe na nusu na bakuli imwe ya fetsa ya glamu miya nane, ka pfapfikighwe ipfinu pfa kulingila ipfili hane Lihema Lienzeluke, sahani na bakuli ino tsapfimema usaghe utighinike uhanganyighwe na mapfuta, apfo tsapfilapfighwa kwaajili ya nambiko ya tse ipfijo, <verse eid="NUM 7:31" /><verse number="32" style="v" sid="NUM 7:32" />chisahani chimwe cha nzahabu cha glamu miya imwe na kumi ichimemile upfumba, <verse eid="NUM 7:32" /><verse number="33" style="v" sid="NUM 7:33" />ng'ombe mmale yumwe iyali mdodo, ng'olo mmale yumwe na mwana we ng'olo yumwe wa mwaka ghumwe, awo walapfighwa wawe wa nambiko ya kulakatsighwa, <verse eid="NUM 7:33" /><verse number="34" style="v" sid="NUM 7:34" />mvulati yumwe wa nambiko ya kuleghusa nzambi, <verse eid="NUM 7:34" /><verse number="35" style="v" sid="NUM 7:35" />ng'ombe wamale weli, ng'olo wamale watano, mvulati watano, na wanang'olo wamale watano wa mwaka ghumwe wawe wa nambiko ya kukala tseghamba. Aino tsaikala nambiko ya Elisuri mwana wa Shedeuri.<verse eid="NUM 7:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 7:36" />Yalapfile nambiko mna litsuwa lya tano, tsa Shelumieli mwana wa Surishadai, chilongotsi wa likabila lya Simioni. <verse eid="NUM 7:36" /><verse number="37" style="v" sid="NUM 7:37" />Aino iyo nambiko iyalapfile, sahani imwe ya fetsa ya kilo imwe na nusu na bakuli imwe ya fetsa lya glamu miya nane, ka pfapfikighwe ipfinu pfa kulingila ipfili hane Lihema Lienzeluke, sahani na bakuli tsatsimema usaghe utighinike ghendo uhanganyighwe na mapfuta, tsapfilapfighwa pfiwe pfa nambiko ya tse pfijo, <verse eid="NUM 7:37" /><verse number="38" style="v" sid="NUM 7:38" />chisahani chimwe cha nzahabu cha glamu miya imwe na kumi ichimemile upfumba, <verse eid="NUM 7:38" /><verse number="39" style="v" sid="NUM 7:39" />ng'ombe mmale yumwe iyali mdodo, ng'olo yumwe mmale na mwana we ng'olo yumwe yane mwaka ghumwe, awo watsakuwa wa nambiko ya kulakatsighwa, <verse eid="NUM 7:39" /><verse number="40" style="v" sid="NUM 7:40" />mvulati yumwe wa nambiko ya kuleghusa nzambi, <verse eid="NUM 7:40" /><verse number="41" style="v" sid="NUM 7:41" />na ng'ombe wamale weli, ng'olo wamale watano, mvulati watano na wanang'olo wamale watano wa mwaka ghumwe wawe wa nambiko ya kukala tseghamba. Aino tsaikala nambiko ya Shelumieli mwana wa Surishadai.<verse eid="NUM 7:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 7:42" />Iyalapfile nambiko mna litsuwa lya sita tsa Eliasafu mwana wa Deueli, iyakalile chilongotsi wa likabila lya Gadi. <verse eid="NUM 7:42" /><verse number="43" style="v" sid="NUM 7:43" />Nambiko yake iyalapfile aino hano, sahani imwe ya fetsa kilo imwe na nusu na bakuli imwe ya fetsa ya glamu miya nane ka pfapfikighwe ipfinu pfa kulingila ipfili hane Lihema Lienzeluke, sahani na bakuli tsapfimema usaghe utighinike ghendo uhanganyighwe na mapfuta, apfino pfilapfighwa ili pfiwe pfa nambiko ye chijo, <verse eid="NUM 7:43" /><verse number="44" style="v" sid="NUM 7:44" />chisahani chimwe cha nzahabu cha glamu miya imwe na kumi ipfimemile upfumba, <verse eid="NUM 7:44" /><verse number="45" style="v" sid="NUM 7:45" />ng'ombe mmale yumwe iyali mdodo, ing'olo yumwe wa mwaka ghumwe, awo wawe nambiko yakulakatsighwa, <verse eid="NUM 7:45" /><verse number="46" style="v" sid="NUM 7:46" />na mvulati yumwe yawe nambiko ya kuleghusa nzambi, <verse eid="NUM 7:46" /><verse number="47" style="v" sid="NUM 7:47" />wang'ombe weli wamale, ng'olo wamale watano, mvulati watano, na wanang'olo wamale watano wa mwaka ghumwe, awo wawe nambiko tsa kukala tseghamba. Atsino tsiso nambiko tsayalapfile Eliasafu mwana wa Deueli.<verse eid="NUM 7:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="NUM 7:48" />Tsuwa lya saba tsa lya Elishama, imwana wa Amihudi, chilongotsi wa likabila lya Efulemu. <verse eid="NUM 7:48" /><verse number="49" style="v" sid="NUM 7:49" />Yeye tsakalapfa pfinu pfino, sahani imwe ya fetsa, tsaina kilo imwe na nusu na ibakuli imwe ya fetsa, nayo tsaina glamu miya nane, kwa kulola ipfinu pfa kulingila ipfili mna Lihema Lihenzeluke. Isahani na ibakuli tsaimema usaghe utighinike ghendo na une ghamapfuta, uwe nambiko ya usaghe. <verse eid="NUM 7:49" /><verse number="50" style="v" sid="NUM 7:50" />Chisahani chimwe cha nzahabu chine glamu miya na kumi tsachimema upfumba, <verse eid="NUM 7:50" /><verse number="51" style="v" sid="NUM 7:51" />ng'ombe mmale yumwe iyali mdodo, na ng'olo yumwe mmale, ne mwana yumwe we ng'olo wa mwaka ghumwe yawe nambiko yakulakatsighwa, <verse eid="NUM 7:51" /><verse number="52" style="v" sid="NUM 7:52" />na mvulati yumwe yawe wa kuleghusa nzambi, <verse eid="NUM 7:52" /><verse number="53" style="v" sid="NUM 7:53" />wang'ombe wamale weli, ng'olo wamale watano, mvulati watano, na wanang'olo wamale watano wa mwaka ghumwe, awo wawe nambiko ya kukala tseghamba. Atsino tsiso nambiko tsayalapfile Elishama mwana wa Amihudi.<verse eid="NUM 7:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="NUM 7:54" />Tsuwa lya nane tsa lya Gamalieli, mwana wa Pedasuli, chilongotsi wa likabila lya Manase. <verse eid="NUM 7:54" /><verse number="55" style="v" sid="NUM 7:55" />Yeye tsakalapfa pfinu pfino, sahani imwe ya fetsa, tsaina kilo imwe na nusu na ibakuli imwe ya fetsa, nayo tsaina glamu miya nane, kwa kulola ipfinu pfa kulingila ipfili mna Lihema Lihenzeluke. Isahani na ibakuli tsapfimema usaghe utighinike ghendo na une ghamapfuta, uwe wa nambiko ya usaghe. <verse eid="NUM 7:55" /><verse number="56" style="v" sid="NUM 7:56" />Chisahani chimwe cha nzahabu chine gilamu miya imwe na kumi ichimemile upfumba, <verse eid="NUM 7:56" /><verse number="57" style="v" sid="NUM 7:57" />ng'ombe mmale yumwe iyali mdodo, na ng'olo yumwe mmale, ne mwana yumwe we ng'olo wa mwaka ghumwe, wawe nambiko ya kulakatsighwa. <verse eid="NUM 7:57" /><verse number="58" style="v" sid="NUM 7:58" />Mvulati yumwe yawe nambiko ya kuleghusa nzambi, <verse eid="NUM 7:58" /><verse number="59" style="v" sid="NUM 7:59" />wang'ombe weli wamale, ng'olo wamale watano, mvulati watano, na wanang'olo wamale watano wa mwaka ghumwe, awo wawe nambiko ya kukala tseghamba. Atsino tsiso nambiko tsayalapfile Gamalieli mwanaghe Pedasuli.<verse eid="NUM 7:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="NUM 7:60" />Tsuwa lya tisa tsa lya Abidani mwana wa Gidioni, chilongotsi wa likabila lya Benjamini. <verse eid="NUM 7:60" /><verse number="61" style="v" sid="NUM 7:61" />Yeye tsakalapfa nambiko tsino, sahani imwe ya fetsa, tsaina kilo imwe na nusu na ibakuli imwe ya fetsa, nayo tsaina gilami miya nane, kwa kulola ipfinu pfakulingila ipfili mna Lihema Lihenzeluke. Isahani na ibakuli tsaimema usaghe utighinike ghendo na une ghamapfuta, uwe nambiko ya usaghe. <verse eid="NUM 7:61" /><verse number="62" style="v" sid="NUM 7:62" />Chisahani chimwe cha nzahabu chine gilamu miya imwe na kumi ichimemile upfumba, <verse eid="NUM 7:62" /><verse number="63" style="v" sid="NUM 7:63" />ng'ombe mmale yumwe iyali mdodo, na ng'olo yumwe mmale, ne mwana yumwe we ng'olo wa mwaka ghumwe, wawe nambiko ya kulakatsighwa. <verse eid="NUM 7:63" /><verse number="64" style="v" sid="NUM 7:64" />Mvulati yumwe yawe wa nambiko ya kuleghusa nzambi, <verse eid="NUM 7:64" /><verse number="65" style="v" sid="NUM 7:65" />wang'ombe weli wamale, ng'olo wamale watano, mvulati watano, na wanang'olo wamale watano wa mwaka ghumwe, awo wawe nambiko ya kukala tseghamba. Atsino tsiso nambiko tsayalapfile.<verse eid="NUM 7:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="NUM 7:66" />Tsuwa lya kumi tsa lya Ahiezeli mwana wa Amishadai, chilongotsi wa likabila lya Dani. <verse eid="NUM 7:66" /><verse number="67" style="v" sid="NUM 7:67" />Yeye tsakalapfa nambiko tsino, sahani imwe ya fetsa, tsaina kilo imwe na nusu na ibakuli imwe ya fetsa, nayo tsaina glamu miya nane, kwa kulola ipfinu pfa kulingila ipfili mna Lihema Lienzeluke. Isahani na ibakuli tsaimema usaghe utighinike ghendo na une ghamapfuta, uwe nambiko ya usaghe. <verse eid="NUM 7:67" /><verse number="68" style="v" sid="NUM 7:68" />Chisahani chimwe cha nzahabu chine glamu miya imwe na kumi ichimemile upfumba, <verse eid="NUM 7:68" /><verse number="69" style="v" sid="NUM 7:69" />ng'ombe mmale yumwe iyali mdodo, na ng'olo yumwe mmale, ne mwana yumwe we ng'olo wa mwaka ghumwe, awo wawe nambiko ya kulakatsighwa. <verse eid="NUM 7:69" /><verse number="70" style="v" sid="NUM 7:70" />Mvulati yumwe yawe wa kuleghusa nzambi, <verse eid="NUM 7:70" /><verse number="71" style="v" sid="NUM 7:71" />wang'ombe weli wamale, ng'olo wamale watano, mvulati watano, na wanang'olo wamale watano wa mwaka ghumwe, awo wawe wa nambiko ya kukala tseghamba. Atsino tsiso nambiko tsayalapfile Ahiezeli mwana wa Amishadai.<verse eid="NUM 7:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="NUM 7:72" />Tsuwa lya kumi na imwe tsa lya Pagieli mwana wa Okilani, chilongotsi wa likabila la Asheli. <verse eid="NUM 7:72" /><verse number="73" style="v" sid="NUM 7:73" />Yeye tsakalapfa nambiko tsino, sahani imwe ya fetsa, tsaina kilo imwe na nusu na ibakuli imwe ya fetsa, nayo tsaina glamu miya nane, kwa kulola ipfinu pfa kulingila ipfili mna Lihema Lienzeluke. Isahani na ibakuli tsaimema usaghe utighinike ghendo na une ghamapfuta, uwe nambiko ya usaghe. <verse eid="NUM 7:73" /><verse number="74" style="v" sid="NUM 7:74" />Chisahani chimwe cha nzahabu chine gilamu miya imwe na kumi ichimemile upfumba, <verse eid="NUM 7:74" /><verse number="75" style="v" sid="NUM 7:75" />ng'ombe mmale yumwe iyali mdodo, na ng'olo yumwe mmale, ne mwana yumwe we ng'olo wa mwaka ghumwe, wawe nambiko yakulakatsighwa, <verse eid="NUM 7:75" /><verse number="76" style="v" sid="NUM 7:76" />Mvulati yumwe yawe wa nambiko ya kuleghusa nzambi, <verse eid="NUM 7:76" /><verse number="77" style="v" sid="NUM 7:77" />wang'ombe weli wamale, ng'olo wamale watano, mvulati watano, na wang'olo wa male watano wa mwaka ghumwe, awo wawe wa nambiko ya kukala tseghamba. Atsino tsiso nambiko tsayalapfile Pagieli mwana wa Okilani.<verse eid="NUM 7:77" /></para>
  <para style="p">
    <verse number="78" style="v" sid="NUM 7:78" />Tsuwa lya kumi na mbili tsa lya Ahila mwana wa Enani, chilongotsi wa likabila lya Nafutali, <verse eid="NUM 7:78" /><verse number="79" style="v" sid="NUM 7:79" />yeye tsakalapfa nambiko tsino, sahani imwe ya fetsa, tsaina kilo imwe na nusu na ibakuli imwe ya shaba, nayo tsaina glamu miya nane, kwa kulola ipfinu pfakulingila ipfili mna Lihema Lihenzeluke. Isahani na ibakuli tsaimema usaghe utighinike ghendo na une ghamapfuta, uwe nambiko ya usaghe. <verse eid="NUM 7:79" /><verse number="80" style="v" sid="NUM 7:80" />Chisahani chimwe cha nzahabu chine gilamu miya imwe na kumi ichimemile upfumba <verse eid="NUM 7:80" /><verse number="81" style="v" sid="NUM 7:81" />ng'ombe mmale yumwe iyali mdodo, na ng'olo yumwe mmale, na mwana yumwe we ng'olo wa mwaka ghumwe, wawe nambiko ya kulakatsighwa, <verse eid="NUM 7:81" /><verse number="82" style="v" sid="NUM 7:82" />mvulati yumwe yawe nambiko ya kuleghusa nzambi, <verse eid="NUM 7:82" /><verse number="83" style="v" sid="NUM 7:83" />wang'ombe weli wamale, wang'olo wamale watano, mvulati watano, na wanang'olo watano wa mwaka ghumwe, awo wawe nambiko ya kukala tseghamba. Atsino tsiso nambiko tsayalapfile Ahila mwanaghe Enamu. <verse eid="NUM 7:83" /><verse number="84" style="v" sid="NUM 7:84" />Ipfinu pfose pfawalapfile pfilongotsi wa Waisiraeli litsuwa lya ukwihimikighwa I matsabahu tsa sahani tsa fetsa kumi na mbili, na tsibakuli tsa fetsa kumi na mbili na pfisahani pfa nzahabu kumi na mbili. <verse eid="NUM 7:84" /><verse number="85" style="v" sid="NUM 7:85" />Chila isahani ya fetsa tsaina kilo imwe na nusu, na chila bakuli tsaina gilamu miya nane, apfo tsisahani na tsibakuli tsa tsina kilo ishilini na saba na gilamu miya sita kwa kulola ipfinu pfa kulingila ipfili mna Lihema Lienzeluke. <verse eid="NUM 7:85" /><verse number="86" style="v" sid="NUM 7:86" />Pfisahani pfila pfa nzahabu kumi na mbili ipfimemile upfumba, chila chimwe tsa china gilamu miya na kumi, apfo pfose tsapfina kilo imwe na glamu miya ndatu na ishilini, kwa kulola ipfinu pfa kulingila ipfili mna Lihema Lienzeluke. <verse eid="NUM 7:86" /><verse number="87" style="v" sid="NUM 7:87" />Iwanyama wose iwalapfighwe wawe nambiko ya kulakatsighwa tsawapfika ng'ombe wamale kumi na weli, na ng'olo wamale tsa kumi na weli, na iwana we ng'olo wamale wane ghumwaka ghumwe tsa kumi na weli, hamwe na nambiko ya usaghe, na mvulati kumi na weli wa nambiko ya kuleghusa nzambi. <verse eid="NUM 7:87" /><verse number="88" style="v" sid="NUM 7:88" />Iwanyama wose iwalapfighwe wawe nambiko yakukala tseghamba tsa ng'ombe wamale ishilini na nne, na wang'olo wamale tsa sitini, na wavulati tsa sitini, na wana we ng'olo wamale wa mwaka ghumwe tsa sitini. Apfo pfipfo pfinu ipfilapfighwe pfiwe nambiko ahala haihimikighwe matsabahu na haighelighwe ghamapfuta.<verse eid="NUM 7:88" /></para>
  <para style="p">
    <verse number="89" style="v" sid="NUM 7:89" />Musa hayengile mghati mwe Lihema Lienzeluke yakalonge na IMNDEWA, kahulika litsi lyolonga mchanya mwe chighubiko cha lisanduku lya laghano, ichikalile mchanya mwa Lisanduku lye laghano, ichikemighwe hanu ha libatsi, lilawa hala hane pfilumbe weli iwakemighwe Makelubi.<verse eid="NUM 7:89" /></para>
  <chapter eid="NUM 7" />
  <chapter number="8" style="c" sid="NUM 8" />
  <para style="s">Aruni kakwika pfitasa saba</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 8:1" />Kuya IMNDEWA kamlongela Musa, <verse eid="NUM 8:1" /><verse number="2" style="v" sid="NUM 8:2" />“Umlongele Aruni pfino, hayatsakwika pfitasa pfila saba mna chighutso che pfitasa, yatsike ili tsilangatse ubali wa hambele he chighutso acho.” <verse eid="NUM 8:2" /><verse number="3" style="v" sid="NUM 8:3" />Aruni katenda ka pfayalaghitsighwe, keka ipfitasa pfila ili pfilangatse ubali wa hambele he chighutso che pfitasa, ka apfila Imulungu pfayamlaghitse Musa. <verse eid="NUM 8:3" /><verse number="4" style="v" sid="NUM 8:4" />Chighutso che pfitasa tsachitengenetsighwa kwa nzahabu ihondighwe kulawa uchanya mbaka hasi, keka ipfitasa pfila ili pfilangatse ubali wa hambele we chighutso che pfitasa, ka apfila Imulungu Pfayamlaghitse Musa.<verse eid="NUM 8:4" /></para>
  <para style="s">Walawi wohimikighwa hambele he Imulungu</para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 8:5" />Kuya IMNDEWA kamlongela Musa, <verse eid="NUM 8:5" /><verse number="6" style="v" sid="NUM 8:6" />“Uwabaghule Walawi kulawa mna iwanu wa Isiraeli kuya uwatende wele. <verse eid="NUM 8:6" /><verse number="7" style="v" sid="NUM 8:7" />Apfino pfipfo pfautsowatenda wele, uwamitsile ghamatsi gho kuwatenda wele, kuya uwaghete lukuli lughima, watsapfe maghwanda ghao na wehopfughe wenyegho wele. <verse eid="NUM 8:7" /><verse number="8" style="v" sid="NUM 8:8" />Kuya watsosola ngo'mbe yumwe mdoghodogho na nambiko ya usaghe, usaghe utighinike ghendo uhanganyighwe ne ghamapfuta, naghwe kutsosola mwana mmale yungi we ng'ombe kwa ajili ya nambiko ya kuleghusa nzambi. <verse eid="NUM 8:8" /><verse number="9" style="v" sid="NUM 8:9" />Kuya kutsowalongela Waisiraeli wetingane hamwe na kuwaghala walawi hane Lihema Lienzeluke. <verse eid="NUM 8:9" /><verse number="10" style="v" sid="NUM 8:10" />Hautsowaghala Walawi hambele hangu, Waisiraeli watsowekila mwitwi Walawi ghamoko ghawo. <verse eid="NUM 8:10" /><verse number="11" style="v" sid="NUM 8:11" />Kuya Aruni katsoweka Walawi hambele hangu ka nambiko ya kwinulighwa kulawa kwa Waisiraeli ili wanitumikile. <verse eid="NUM 8:11" /><verse number="12" style="v" sid="NUM 8:12" />Kuya Walawi watsakwika ghamoko ghawo mwitwi mwe wang'ombe awo, yumwe katsolapfighwa yawe nambiko ya kuleghusa nzambi na yungi yawe nambiko ya kulakatsighwa iilapfighwa kuna nene ili welamlitse ne Imulungu. <verse eid="NUM 8:12" /><verse number="13" style="v" sid="NUM 8:13" />Kuya kutsowemitsa Walawi hambele ha Aruni ne wanaghe na kuweka hambele hangu ka nambiko ya kwinulighwa. <verse eid="NUM 8:13" /><verse number="14" style="v" sid="NUM 8:14" />Apfi pfipfo pfautsowabaghula Walawi kulawa mna Waisiraeli wangi ili wawe wangu. <verse eid="NUM 8:14" /><verse number="15" style="v" sid="NUM 8:15" />Hautsomalitsa kuwatenda Walawi wele na kuwatenda ka nambiko ya kwinulighwa, wodaha kwingila ili wasang'ane tsing'onde tse Lihema Lienzeluke. <verse eid="NUM 8:15" /><verse number="16" style="v" sid="NUM 8:16" />Awa walapfighwa ili wawe wangu ghendo, wakale hanu ha wana chaudele wa Isiraeli. <verse eid="NUM 8:16" /><verse number="17" style="v" sid="NUM 8:17" />Kwaapfila chila mwana chaudele iyali mna Isiraeli, ayo wangu, yawe we munu au we mnyama, kwaaapfila tsaniwatenda wele kwaajili yangu mna litsuwa lyaniwakomile iwana chaudele mna isi ya Misiri. <verse eid="NUM 8:17" /><verse number="18" style="v" sid="NUM 8:18" />Lelo nowasola Walawi wakale hanu ha iwana chaudele wa Waisiraeli. <verse eid="NUM 8:18" /><verse number="19" style="v" sid="NUM 8:19" />Na nimwing'a Aruni ne wanaghe ili wamwapfile kusang'ana mna Lihema Lienzeluke kwa ajili ya Waisiraeli na kuwalamlitsa ne Imulungu ili Waisiraeli waleke kutingwa ahala hawakwingila mna Lihema Lienzeluke.” <verse eid="NUM 8:19" /><verse number="20" style="v" sid="NUM 8:20" />Apfo Musa, Aruni na Waisiraeli wose wawahimika Walawi ka IMNDEWA pfayamlaghitse Musa. <verse eid="NUM 8:20" /><verse number="21" style="v" sid="NUM 8:21" />Kuya Walawi wetenda wela kwa kwimitsila ghamatsi kulangusa ka watsileka nzambi tsawo, watsapfa maghwanda ghao, naye Aruni kawalapfa ka nambiko ya kwinulighwa hambele he IMNDEWA. Pfipfila Aruni kawatenda wele. <verse eid="NUM 8:21" /><verse number="22" style="v" sid="NUM 8:22" />Hawamalitse kutenda apfo, Walawi waghenda kusang'ana ng'onde tsa Lihema Lienzeluke aku Aruni ne wanaghe wowalongotsa ka IMNDEWA pfayamlaghitse Musa.<verse eid="NUM 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 8:23" />IMNDEWA kamlongela Musa, <verse eid="NUM 8:23" /><verse number="24" style="v" sid="NUM 8:24" />“Chila Mlawi yane miyaka ishilini na mitano na kughendelela, katsosang'ana mna Lihema lyangu Lienzeluke. <verse eid="NUM 8:24" /><verse number="25" style="v" sid="NUM 8:25" />Na katsoleka kusang'ana hayatsopfika miyaka hamsini. <verse eid="NUM 8:25" /><verse number="26" style="v" sid="NUM 8:26" />Lekeni kodaha kuwapfila Walawi wayaghe hawosang'ana mna lihema, ila ng'obamighwa baye yatende ng'onde yoyose yaliyeka. Apfi pfipfo pfautsowagholela Walawi tsisang'ano.”<verse eid="NUM 8:26" /></para>
  <chapter eid="NUM 8" />
  <chapter number="9" style="c" sid="NUM 9" />
  <para style="s">Ipasaka ya keli</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 9:1" />Mna mwetsi ghwa mwanduso ghwa mwaka ghwa keli Mtwatsa Imulungu tsakalonga na Musa mna nyika Sinai ahala Waisiraeli hawalawile Misiri. Kalonga, <verse eid="NUM 9:1" /><verse number="2" style="v" sid="NUM 9:2" />“Waisiraeli wadeng'elele chihungo cha Pasaka ka pfaikighwe.” <verse eid="NUM 9:2" /><verse number="3" style="v" sid="NUM 9:3" />Aino itsakuwa nemihe mna litsuwa lya kumi na nne lya ghumwetsi ghuno, ka imiko na malaghitso pfagholonga. <verse eid="NUM 9:3" /><verse number="4" style="v" sid="NUM 9:4" />Apfo Musa kawalongela iwanu wadeng'elele chihungo che Pasaka. <verse eid="NUM 9:4" /><verse number="5" style="v" sid="NUM 9:5" />Na wadeng'elela chihungo cha Pasaka nemihe mna litsuwa lya kumi na nne lya ghumwetsi ghwa mwanduso mna nyika ya Sinai. Waisiraeli watenda ghose ka IMNDEWA pfayamlaghitse Musa. <verse eid="NUM 9:5" /><verse number="6" style="v" sid="NUM 9:6" />Lekeni wamwenga ng'awadeng'elele baye Ipasaka mna litsuwa alyo, kwaapfila tsawakinda mauti, tsaweha hambele he Imulungu. Awo tsawawaghendela Musa na Aruni, <verse eid="NUM 9:6" /><verse number="7" style="v" sid="NUM 9:7" />walonga, “Twetwe twiha kwaapfila tukinda mauti, lekeni ebali tughomighwa tuleke kumlapfila IMNDEWA nambiko tsake ka pfaikighwe hamwe na Waisiraeli wangi?”<verse eid="NUM 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 9:8" />Musa kawedika, “Mbete tanu mbaka ahala hanitsopata malaghitso ghenu kulawa kwe IMNDEWA.”<verse eid="NUM 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 9:9" />Naye IMNDEWA kamlongela Musa, <verse eid="NUM 9:9" /><verse number="10" style="v" sid="NUM 9:10" />“Walongele pfino Waisiraeli, ‘Munu yumwe kulawa mna mwemwe au yumwe wa watsukulu wenu yang'awa keha kwaapfila kakinda mauti au yang'awa ka kutali mna ghumwanza, lekeni kobama yadeng'elele chihungo cha Pasaka, <verse eid="NUM 9:10" /><verse number="11" style="v" sid="NUM 9:11" />imunu ka ayo kobamighwa yatende apfo ahala mwetsi ghumwe haghubita, nemihe ya litsuwa lya kumi na nne lya ghumwetsi ghwa keli. Katsodeng'elela kwa kuja pfighate pfilihela hamila na mbogha tsili usungu. <verse eid="NUM 9:11" /><verse number="12" style="v" sid="NUM 9:12" />Waleke kuleka chijo chochose mbaka nemitondo, wala kubena mpate ghwe mnyama wa Pasaka. Watsotenda chihungo chino che Pasaka kwa kukinda malaghitso na imiko yake yose. <verse eid="NUM 9:12" /><verse number="13" style="v" sid="NUM 9:13" />Lekeni munu wowose yelile au ng'ali mna ghumwanza baye, ka ng'adeng'elele chihungo cha Pasaka, imunu ayo katsobaghulighwa ne wanu wake kwaapfila ng'andapfile nambiko ka pfaikighwe. Ayo yahighighwe kwe nzambi yake iyatendile. <verse eid="NUM 9:13" /><verse number="14" style="v" sid="NUM 9:14" />Ka hana muhenza kokala hamwe namwe na kobama yanendele chihungo cha Pasaka, imunu ayo yatende pfipfo kwa kukinda imiko na malaghitso ghose gha Pasaka. Chila Munu yang'awa muhenza au mwenyekaye yawinze malaghitso ghaghala.’ ”<verse eid="NUM 9:14" /></para>
  <para style="s">Libingu lya Ghumoto</para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 9:15" />Litsuwa alila Lihema Lienzeluke halihimikighwe, libingu lihulumka lighubika Lihema. Nechilo libingu alyo tsalyoneka ka moto mbaka nemitondo. <verse eid="NUM 9:15" /><verse number="16" style="v" sid="NUM 9:16" />Apfo pfipfo tsa pfaili chila tsuwa, libingu halighubike lihema nemisi na nechilo tsalyoneka ka moto. <verse eid="NUM 9:16" /><verse number="17" style="v" sid="NUM 9:17" />Libingu halinulighwe mchanya mwe Lihema, Waisiraeli tsawamwagha indalo na watsenga ndalo ahala libingu halimile. <verse eid="NUM 9:17" /><verse number="18" style="v" sid="NUM 9:18" />Tsawamwagha indalo kwa kuwinza malaghitso gha IMNDEWA, na tsawatsenga keli indalo kwa kuwinza malaghitso ghake. Matsuwa ghose libingu halikalile mchanya mwe Lihema iwanu tsawakala mna indalo ayo. <verse eid="NUM 9:18" /><verse number="19" style="v" sid="NUM 9:19" />Hata ka libingu alyo tsalikala mchanya mwe Lihema kwa matsuwa mengi, Waisiraeli tsawamuhulikitsa IMNDEWA, apfo ng'awokile baye. <verse eid="NUM 9:19" /><verse number="20" style="v" sid="NUM 9:20" />Hata ka libingu alyo tsalikala mchanya mwe Lihema matsuwa chidogho, Waisiraeli tsawakala mna ndalo ka IMNDEWA pfayawalaghitse. <verse eid="NUM 9:20" /><verse number="21" style="v" sid="NUM 9:21" />Matsuwa ghangi libingu alyo tsalikala mna Lihema kulawa nemihe mbaka nemitondo hela. Na halinulighwe tsawandusa ghumwanza. <verse eid="NUM 9:21" /><verse number="22" style="v" sid="NUM 9:22" />Ka libingu tsalikala mchanya mwe Lihema kwa matsuwa meli, mwetsi ghumwe, mwaka ghumwe na kughendelela, Waisiraeli ng'awokile baye, lekeni halinulighwe nawo pfipfila wenuka woka. <verse eid="NUM 9:22" /><verse number="23" style="v" sid="NUM 9:23" />Tsawatsenga indalo na kumwagha indalo kwa kuhulikitsa malaghitso ghe Imulungu ka IMNDEWA pfayawalaghitse kubitila Musa.<verse eid="NUM 9:23" /></para>
  <chapter eid="NUM 9" />
  <chapter number="10" style="c" sid="NUM 10" />
  <para style="s">Tsimalati tsitengenetsighwe kwa fetsa</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 10:1" />Mtwatsa Imulungu kamlongela Musa, <verse eid="NUM 10:1" /><verse number="2" style="v" sid="NUM 10:2" />“Utengenetse malati mbili kwa fetsa ihondighwe. Tsimalati atso kutsotsitumila ahala hautsowakema iwanu na hautsomwagha indalo iwanu woke. <verse eid="NUM 10:2" /><verse number="3" style="v" sid="NUM 10:3" />Tsimalati atso mbili tsing'atowighwa hamwe, iwanu wose watsetingana hamwe habei na ghweghwe hambele ha ghumlango ghwa Lihema Lienzeluke. <verse eid="NUM 10:3" /><verse number="4" style="v" sid="NUM 10:4" />Lekeni ing'atowighwa malati imwe, pfilongotsi waliheka wa kabila lya Isiraeli wawo iwatsetingana hamwe habei na ghweghwe. <verse eid="NUM 10:4" /><verse number="5" style="v" sid="NUM 10:5" />Malati ayo imwe ing'atowighwa ng'ani, itsolangusa chitango cho kuka, iwokala mna tsindalo tsa ubali wa kwalilawila litsuwa wakwandusa ghumwanza. <verse eid="NUM 10:5" /><verse number="6" style="v" sid="NUM 10:6" />Malati ayo imwe ing'atowighwa mala mbili, awala iwokala mna tsindalo tsa ubali wa kusini wakwandusa kuka. Malati ayo haitowighwa, ghumwanza ghwakwandusighwa. <verse eid="NUM 10:6" /><verse number="7" style="v" sid="NUM 10:7" />Lekeni hauwakema iwanu wetingane hamwe tsimalati tsitsotowighwa chidogho. <verse eid="NUM 10:7" /><verse number="8" style="v" sid="NUM 10:8" />Tsimalati atso tsitowighwe na iwana wa Aruni iwali watambika. Mtsotenda apfo mna pfeleko pfenu pfose ipfikutsa. <verse eid="NUM 10:8" /><verse number="9" style="v" sid="NUM 10:9" />Hamtsakuwa ne ng'ondo mna isi yenu, mtsotsitowa ng'ani tsimalati tsino ili IMNDEWA wenu yawapfile na yawakombole na iwanu iwowehila. <verse eid="NUM 10:9" /><verse number="10" style="v" sid="NUM 10:10" />Pfipfila mna matsuwa gha kudeng'elela, ka ghumwetsi haghulawila sambi, na pfihungo pfingi, mtsotowa malati tsino ahala hamtsolapfa nambiko tsenu tsa kulakatsighwa na nambiko tsenu tsa kukala tseghamba ne Imulungu. Aho nene Imulungu wenu nitsowakumbuka mwemwe. Nene yuyo IMNDEWA, Mulungu wenu.”<verse eid="NUM 10:10" /></para>
  <para style="s">Apfi pfipfo Waisiraeli pfawatsakuka</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 10:11" />Mna litsuwa lya ishilini lya mwetsi ghwa keli, mwaka ghwa keli kulawa Waisiraeli hawalawile Misiri, libingu ilikalile mna Lihema Lienzeluke halinulighwe, <verse eid="NUM 10:11" /><verse number="12" style="v" sid="NUM 10:12" />Waisiraeli wandusa ghumwanza kulawa nyika ya Sinai. Libingu alyo tsalinuka lighenda kwima kune nyika ya Parani. <verse eid="NUM 10:12" /><verse number="13" style="v" sid="NUM 10:13" />Nawo tsa wanza kuka kwa laghitso lye IMNDEWA kubitila Musa. <verse eid="NUM 10:13" /><verse number="14" style="v" sid="NUM 10:14" />Iwanu wa kingili lya kabila lya Yuda wawo iwalongole aku wakinda bendela yawo, na chilongotsi wawo tsa imwana wa Aminadabu iyakemighwe Nashoni. <verse eid="NUM 10:14" /><verse number="15" style="v" sid="NUM 10:15" />Netaneli imwana wa Suari tsakawalongotsa iwanu wa kingili lya kabila lya Isakari. <verse eid="NUM 10:15" /><verse number="16" style="v" sid="NUM 10:16" />Naye Eliabu imwana wa Heloni tsakawalongotsa iwanu wa kabila lya Zebuluni. <verse eid="NUM 10:16" /><verse number="17" style="v" sid="NUM 10:17" />Iwanu wa lukolo lwa Gerishoni na Merari iwalighalile lihema, walihulumsa, kuya wandusa kuka. <verse eid="NUM 10:17" /><verse number="18" style="v" sid="NUM 10:18" />Kuya kingili liwinzile hachisogho aku wakinda bendela yawo tsa lya kabila lya Rubeni, chilongotsi wawo tsa imwana wa Shedeuri yakemighwe Elisuri. <verse eid="NUM 10:18" /><verse number="19" style="v" sid="NUM 10:19" />Shelumieli imwana wa Surishadai tsakalilongatsa kingili lya kabila lya Simioni. <verse eid="NUM 10:19" /><verse number="20" style="v" sid="NUM 10:20" />Naye Eliasafu mwana wa Deueli, kalilongotsa kingili lya kabila lya Gadi. <verse eid="NUM 10:20" /><verse number="21" style="v" sid="NUM 10:21" />Kuya iwawinzile keli, iwanu wa lukolo lwa Kohati aku waghala pfinu pfienzeluke. Awo hawapfikile Lihema ma tsalitsengighwa na wayao. <verse eid="NUM 10:21" /><verse number="22" style="v" sid="NUM 10:22" />Hawalawile awo, wawinza iwanu wa kingili lya kabila lya Efulemu aku wakinda bandela yawo, wawo tsawalongotsighwa na Elishama imwana na Amihudi. <verse eid="NUM 10:22" /><verse number="23" style="v" sid="NUM 10:23" />Imwana wa Pedasuri yakemighwe Gamalieli tsakalilongotsa kabila lya Manase, <verse eid="NUM 10:23" /><verse number="24" style="v" sid="NUM 10:24" />naye Abidani imwana wa Gideoni kalilongotsa kabila lya Benyamini. <verse eid="NUM 10:24" /><verse number="25" style="v" sid="NUM 10:25" />Awala wa utsighilo tsa kingili lya kabila lya Dani. Awano wang'ali wowabetetsa wayawo wose. Nawo tsawalongotsighwa na Ahiezeri imwana wa Amishadai. <verse eid="NUM 10:25" /><verse number="26" style="v" sid="NUM 10:26" />Pagieli imwana wa Okilani tsakaliliongotsa kabila lya Asheri. <verse eid="NUM 10:26" /><verse number="27" style="v" sid="NUM 10:27" />Naye imwana wa Enani yakemighwe Ahira tsakalilongotsa kabila lya Nafutali. <verse eid="NUM 10:27" /><verse number="28" style="v" sid="NUM 10:28" />Apfino pfipfo Waisiraeli pfawatendile ahala hawamwaghile indalo na kwandusa ghumwanza keli kingili kwa kingili.<verse eid="NUM 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 10:29" />Musa kamlongela mlamu wake Hobabu imwana wa Reueli, wa kabila lya Wamidiani, iyali mkwe wake, “Twetwe twoghenda hanu hayalongile IMNDEWA ‘Nitsomwing'ani’. Lelo utse tughende hamwe, kwaapfila tutsokutendela ghanoghile, kwaapfila IMNDEWA kelaghana natwe ka katsotwing'a ipfinu pfinoghile.” <verse eid="NUM 10:29" /><verse number="30" style="v" sid="NUM 10:30" />Lekeni Hobabu kedika, “Nene sighenda namwe baye, nitsakuya kune isi yangu na kwa iwanu wangu.” <verse eid="NUM 10:30" /><verse number="31" style="v" sid="NUM 10:31" />Musa kamlongela, “Twokulomba uleke kutuleka, kwaapfila ghweghwe kohamanya hanu hatutsakwika indalo kunyika, na kodaha kuwa mlangulitsi wetu. <verse eid="NUM 10:31" /><verse number="32" style="v" sid="NUM 10:32" />Pfipfila ung'aghenda na twetwe, chochose chinoghile IMNDEWA chayotutendela twetwe, na ghweghwe pfipfila katsokutendela.”<verse eid="NUM 10:32" /></para>
  <para style="s">Waisiraeli wakuka</para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 10:33" />Iwanu woka kulawa Sinai, chidunda che IMNDEWA, kwa ghumwanza ghwa matsuwa madatu. Sanduku lya laghano lye IMNDEWA tsaliwalongolela kwa mwanza ghwa matsuwa madatu ili liwabamile hanu ho kwika indalo. <verse eid="NUM 10:33" /><verse number="34" style="v" sid="NUM 10:34" />Chila hawaghendile kulawa ndalo imwe mbaka ndalo ingi, libingu lye IMNDEWA Imunngu tsalikala mchanya mwao misi yose. <verse eid="NUM 10:34" /><verse number="35" style="v" sid="NUM 10:35" />Aho Lisanduku halighendile hambele, Musa kalonga, “Winuke ghwee IMNDEWA uwapwililise iwehile wako, yang'awokubama uwatende watsume hambele yako.” <verse eid="NUM 10:35" /><verse number="36" style="v" sid="NUM 10:36" />Na chila halimile, Musa kalonga, “Ghwee IMNDEWA uwoyile Waisiraeli wano wengi sideke.”<verse eid="NUM 10:36" /></para>
  <chapter eid="NUM 10" />
  <chapter number="11" style="c" sid="NUM 11" />
  <para style="s">Iwanu womsing'inikila IMNDEWA</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 11:1" />Lelo iwanu wandusa kumsing'inikila IMNDEWA kwa maghayo ghawang'ali wopata. IMNDEWA hayahulike tsakaghudubuka ng'ani, apfo kawaghalila moto. Ghumoto agho tsaghwaka haghati hao na ghulakatsa ubali umwe we ndalo. <verse eid="NUM 11:1" /><verse number="2" style="v" sid="NUM 11:2" />Apfo iwanu wamlilila Musa ili yawapfile. Naye Musa kamlomba IMNDEWA Imungu, na baho ghumoto ghutsimika. <verse eid="NUM 11:2" /><verse number="3" style="v" sid="NUM 11:3" />Apfo ihanu aho tsahakemighwa Tabera, maana yake kulakatsa, kwaapfila aho ghumoto tsaghuwalakatsa iwanu.<verse eid="NUM 11:3" /></para>
  <para style="s">Musa kosaghula pfilongotsi Sabini</para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 11:4" />Tsahana kingili limwe lye iwanu iling'ali likwanga na Waisiraeli. Kingili alyo lye iwanu tsalina batsu kulu lya kuja inyama. Nawo Waisiraeli walila walonga, “Tupata kwani inyama yo kuja?” <verse eid="NUM 11:4" /><verse number="5" style="v" sid="NUM 11:5" />“Twokumbuka iwasomba, ghamaghitsi, ghamatikiti, tsimbogha, ipfitungulu, ne pfitungulu swaumu pfatujile akula Misiri bila kughula! <verse eid="NUM 11:5" /><verse number="6" style="v" sid="NUM 11:6" />Lekeni sambi twahela ngupfu, haduhu chijo chingi ila mana iliyeka!” <verse eid="NUM 11:6" /><verse number="7" style="v" sid="NUM 11:7" />Mana tsa pfaili ka mbeghu ya uhemba, ne langi yake nzelu ihanganyighwe na njano. <verse eid="NUM 11:7" /><verse number="8" style="v" sid="NUM 11:8" />Iwanu tsawatsungulukatsunguluka kuikunga, kuya tsawaisagha kwe ghamabwe au matuli, kuya tsawaitoghosa mna pfiya na kutengenetsa maandatsi. Ung'aja mwidomo ka maandatsi ghatsingighwe kwa mapfuta. <verse eid="NUM 11:8" /><verse number="9" style="v" sid="NUM 11:9" />Nechilo litungwe halilaghale mna ndalo, imana nayo tsailaghala hamwe ne litungwe. <verse eid="NUM 11:9" /><verse number="10" style="v" sid="NUM 11:10" />Musa tsakahulika iwanu wose pfawang'ali wolila, chila munu hane ghumlango ghwa indalo yake. Apfo IMNDEWA tsakaghudubuka ng'ani, naye Musa pfipfila tsakaghudubuka. <verse eid="NUM 11:10" /><verse number="11" style="v" sid="NUM 11:11" />Kuya Musa kamlongela IMNDEWA, “Ebali unitendela pfihile nene mtumighwa wako? Mbona ng'unitoghola baye? Ule ungayile mtsigho gho kuwalela iwanu wose wano? <verse eid="NUM 11:11" /><verse number="12" style="v" sid="NUM 11:12" />Angu yaniweleke nene mbaka unongele niwabape mna mambagha yangu ka apfila mai pfayobapa imwana yoneke sambi, na kuwahilika mbaka kune isi yaulongile koweng'a tsina aba tsao?. <verse eid="NUM 11:12" /><verse number="13" style="v" sid="NUM 11:13" />Nitsopata kwani inyama yo kuweng'a iwanu wose wano? Kwaapfila wonilila wolonga, ‘Utwing'e inyama tuje!’ <verse eid="NUM 11:13" /><verse number="14" style="v" sid="NUM 11:14" />Nene sidaha baye kuwaghala iwanu wose wano niliyeka, aino sang'ano ng'omu ng'ani kuna nene! <verse eid="NUM 11:14" /><verse number="15" style="v" sid="NUM 11:15" />Ka apfino pfipfo pfaunitenda, nokulomba, ng'apfu unikome, ka kombonela libatsi, lekeni uleke kunileka nighendelele kughaya.”<verse eid="NUM 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 11:16" />Kuya IMNDEWA kamlongela Musa, “Uwalongele iwanzehe sabini wa Isiraeli wetingane hamwe, awala wauwona wotogholighwa na wohulikitsighwa ne iwanu, uwaghale hane Lihema lya Kwitinganila, weme habei na ghweghwe. <verse eid="NUM 11:16" /><verse number="17" style="v" sid="NUM 11:17" />Nitsohulumka hasi na kulonga na ghweghwe, nitsosola ghumuhe chidogho ghwanikwing'ile ghweghwe niweng'e iwanu awo. Nawo watsokwapfila kuwalela iwanu wano hamwe naghwe, ili uleke kughala mtsigho ghuno uliyeka. <verse eid="NUM 11:17" /><verse number="18" style="v" sid="NUM 11:18" />Lelo uwalongele iwanu pfino, ‘Ilupfi mwitende mwele kwaapfila mtsakuja inyama. IMNDEWA kahulika pfamng'ali mlila no kulonga, haduhu wo kumwing'ani inyama na ng'apfu mng'akalile Misiri.’ Lelo Mtwatsa Imulungu katsomwing'ani inyama namwe mtsoija. <verse eid="NUM 11:18" /><verse number="19" style="v" sid="NUM 11:19" />Ng'amtsakuja inyama kwa tsuwa limwe, au matsuwa meli, au matsuwa matano, au matsuwa kumi, au matsuwa ishilini, <verse eid="NUM 11:19" /><verse number="20" style="v" sid="NUM 11:20" />ila kwa mwetsi mghima! Mtsakuja mbaka iwabwikitse. Agho ghose ghatsolawila kwaapfila mumlema IMNDEWA iyali hano mna mwemwe, no kulila hambele yake no kulonga, ‘Ebali tulawile Misiri?’”<verse eid="NUM 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 11:21" />Lekeni Musa kamlongela IMNDEWA, “Ahano iwanu iyaniwalongotsa iwoghenda kwa maghulu laki sita, naghwe kolonga, ‘Nitsoweng'a inyama yo kuwenela mwetsi mghima!’ <verse eid="NUM 11:21" /><verse number="22" style="v" sid="NUM 11:22" />Angu wang'ombe na wang'olo wang'achinjighwa watsowenela? Angu lelo iwasomba wose wa mwibahali walowighwe kwaajili yawo?” <verse eid="NUM 11:22" /><verse number="23" style="v" sid="NUM 11:23" />IMNDEWA kamwidika Musa, “Angu nene sidaha baye? Lelo kutsakona ka ghanilonga ka ghatsolawila au baye.” <verse eid="NUM 11:23" /><verse number="24" style="v" sid="NUM 11:24" />Apfo Musa kaghenda kuwalongela aghala ghayalongile IMNDEWA. Kuya kawalongela wanzehe sabini iwali pfilongotsi wetingane hamwe kulawa mna wanzee wala, kaweka walitsunguluke lihema. <verse eid="NUM 11:24" /><verse number="25" style="v" sid="NUM 11:25" />Baho IMNDEWA kahulumka kulawa mna libingu kalonga naye. Kuya kaweng'a wanzee wala sabini Muhe ghughula ghwayamwing'ile Musa. Muhe haghuwengile iwanzehe awala, wandusa kulonga aghala ghayaweng'ile Imuhe, lekeni tsawatenda apfo mala lumwe hela. <verse eid="NUM 11:25" /><verse number="26" style="v" sid="NUM 11:26" />Wanzehe weli iwasaghulighwe na Musa, tsa Elidadi na Medadi, tsawakala kune ndalo, wayao hawaghendile kune Lihema. Muhe ghuwahulumkila ghwandusa kulonga mbuli yawalongele IMNDEWA. <verse eid="NUM 11:26" /><verse number="27" style="v" sid="NUM 11:27" />Msongolo yumwe katsuma kaghenda kumlongela Musa, “Elidadi na Medadi wolonga mbuli tse IMNDEWA kune ndalo.” <verse eid="NUM 11:27" /><verse number="28" style="v" sid="NUM 11:28" />Baho imwana wa Nuni yokemighwa Yoshua iyang'ali yomwapfila Musa kulawa hayakalile mdodo, kamlongela Musa, “Mndewa wangu, uwaghome!” <verse eid="NUM 11:28" /><verse number="29" style="v" sid="NUM 11:29" />Lekeni Musa kedika kalonga, “Pfii kombonela chepfu? Ng'apfu IMNDEWA yang'aweng'ile iwanu wose Muhe ghwake nawo wawe manabii!” <verse eid="NUM 11:29" /><verse number="30" style="v" sid="NUM 11:30" />Kuya Musa na wanzehe awala wa Isiraeli, woya kune ndalo.<verse eid="NUM 11:30" /></para>
  <para style="s">IMNDEWA kotuma wang'wale</para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 11:31" />Hambele IMNDEWA kaghala libeho kwa ukwidukitsa, libeho alyo lighala wang'wale kulawa kune ibahali. Kawatenda waghwe kutsunguluka indalo. Tsawelundika utali wa futi ndatu kulawa hasi mbaka uchanya. Wang'wale awo tsawamema kutsunguluka indalo kwa ghumwanza ghwa tsuwa limwe chila ubali. <verse eid="NUM 11:31" /><verse number="32" style="v" sid="NUM 11:32" />Pfipfila mna litsuwa alyo lyose, iwanu wang'ali woghogha iwang'wale chilo chighima mbaka ilupfi yake. Chila munu tsakaghogha kulawa kilo elufu imwe na kughendelela. Tsawawanzatsa chila hanu hambalimbali he indalo ili wanyale. <verse eid="NUM 11:32" /><verse number="33" style="v" sid="NUM 11:33" />Lekeni inyama haikalile ing'ali nyingi, IMNDEWA kawonela maya iwanu, kaweng'a utamu mkulu. <verse eid="NUM 11:33" /><verse number="34" style="v" sid="NUM 11:34" />Apfo ihanu aho tsahakemighwa Kibroti Hataava, mana yake “Makabuli gha umelo” Kwaapfila ako kuko kwawatsikighwe iwanu wane umelo. <verse eid="NUM 11:34" /><verse number="35" style="v" sid="NUM 11:35" />Kulawa Kibroti Hatava iwanu waghenda mbaka Hazeroti, kuko weka indalo yawo na kukala.<verse eid="NUM 11:35" /></para>
  <chapter eid="NUM 11" />
  <chapter number="12" style="c" sid="NUM 12" />
  <para style="s">Miliamu na Aruni womsing'inikila Musa</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 12:1" />Kuya Miliamu na Aruni wandusa kumlonga pfihile Musa kwaapfila tsakakwela ipinga Mkushi. <verse eid="NUM 12:1" /><verse number="2" style="v" sid="NUM 12:2" />Walonga, “Apfi IMNDEWA kalonga na Musa yaliyeka? Pfii ng'alongile na twetwe pfipfila?” Baho IMNDEWA kahulika aghala ghawalongile. <verse eid="NUM 12:2" /><verse number="3" style="v" sid="NUM 12:3" />Musa tsa mwenyepfale kubita iwanu wose iwakalile muisi. <verse eid="NUM 12:3" /><verse number="4" style="v" sid="NUM 12:4" />Baho IMNDEWA kawalongela Musa, Aruni na Miliamu kwa ukwidukitsa, “Mwemwe wadatu mtse mna Lihema Lienzeluke.” Apfo wose wadatu waghenda mna Lihema Lienzeluke. <verse eid="NUM 12:4" /><verse number="5" style="v" sid="NUM 12:5" />Baho IMNDEWA kahulumka mna ngutso ya libingu, kema hane ghumlango ghwa Lihema, kawakema Aruni na Miliamu. Wose weli tsawasoghela hambele. <verse eid="NUM 12:5" /><verse number="6" style="v" sid="NUM 12:6" />Kuya IMNDEWA kawalongela, “Mtegheletse ghanilonga, mna mwemwe ka hana nabii, nene IMNDEWA nelangusa mna ghamaono kuna yeye na nolonga naye ahala yang'awa mndoto. <verse eid="NUM 12:6" /><verse number="7" style="v" sid="NUM 12:7" />Lekeni kwa mtumighwa wangu Musa, yeye kahake ghendo. Yeye kotogholighwa mna sang'ano yangu yose. <verse eid="NUM 12:7" /><verse number="8" style="v" sid="NUM 12:8" />Nene nolonga naye mwatsimwatsi na simpfisa chinu baye. Yeye kombona nikonekatse. Ebali lelo mwemwe ng'ampfukile baye kumlonga pfihile mtumighwa wangu Musa?” <verse eid="NUM 12:8" /><verse number="9" style="v" sid="NUM 12:9" />Baho IMNDEWA kawonela maya Miliamu na Aruni, kaghudubuka koka. <verse eid="NUM 12:9" /><verse number="10" style="v" sid="NUM 12:10" />Nalyo libingu lilawa mna Lihema Lienzeluke lyuka, baho Miliamu tsakoneka kana utamu wa ngotsi, mtselu chwee!. Aruni hayahunduke na kumlola Miliamu, tsakakangawala hayamwonile kana utamu we ngotsi. <verse eid="NUM 12:10" /><verse number="11" style="v" sid="NUM 12:11" />Kamlongela Musa, “Mndewa wangu, uleke kututenda tughaye kwaapfila ghatutendile ng'aghanoghile baye na tutenda nzambi. <verse eid="NUM 12:11" /><verse number="12" style="v" sid="NUM 12:12" />Uleke kumtenda Miliamu yawe ka imwana yoneke kafa, lukuli lwake lwose luihinyika.” <verse eid="NUM 12:12" /><verse number="13" style="v" sid="NUM 12:13" />Apfo Musa kamlilila IMNDEWA kalonga, “Nokulomba umuhonetse.” <verse eid="NUM 12:13" /><verse number="14" style="v" sid="NUM 12:14" />Lekeni IMNDEWA kamlongela Musa, “Ka aba wake yang'ambwalulile ghamate, kumhigha ghamatotso, tsang'opata chinyala kwa matsuwa saba? Mlapfe kunze kwe ndalo yakale ako kwa matsuwa saba, kuya umuitse mna ndalo.” <verse eid="NUM 12:14" /><verse number="15" style="v" sid="NUM 12:15" />Apfo Miliamu kawingighwa yakale kunze kwe ndalo kwa matsuwa saba. Iwanu ng'awanduse keli ghumwanza mbaka Miliamu hayoile keli mna ndalo. <verse eid="NUM 12:15" /><verse number="16" style="v" sid="NUM 12:16" />Haghamalile agho ghose iwanu wandusa ghumwanza kulawa Haseroti, waghenda watsenga indalo kune nyika ya Parani.<verse eid="NUM 12:16" /></para>
  <chapter eid="NUM 12" />
  <chapter number="13" style="c" sid="NUM 13" />
  <para style="s">Wapelembi</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 13:1" />IMNDEWA kamlongela Musa, <verse eid="NUM 13:1" /><verse number="2" style="v" sid="NUM 13:2" />“Msaghule chilongotsi yumwe kulawa chila kabila mna makabila kumi na meli gha Isiraeli, na uwatume wakaipelembe isi ya Kanaani, yanitsoweng'a Waisiraeli.” <verse eid="NUM 13:2" /><verse number="3" style="v" sid="NUM 13:3" />Musa kawatuma iwanu kulawa kune nyika ya Parani ka IMNDEWA pfayamlaghitse. Iwanu iwatumighwe tsawakala pfilongotsi wa ghamakabila gha Waisiraeli. <verse eid="NUM 13:3" /><verse number="4" style="v" sid="NUM 13:4" />Awano wawo iwanu iwatumighwe, kulawa mna kabila lya Rubeni, Shamua mwana wa Zakuri.<verse eid="NUM 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 13:5" />Kulawa mna kabila lya Simioni, tsakatumighwa Shafati mwana wa Hori.<verse eid="NUM 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 13:6" />Kulawa mna kabila lya Yuda, tsakatumighwa Kalebu mwana wa Yefune.<verse eid="NUM 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 13:7" />Kulawa mna kabila lya Isakari, tsakatumighwa Igali mwana wa Yosefu.<verse eid="NUM 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 13:8" />Kulawa mna kabila lya Efulemu, tsakatumighwa Hoshea mwana wa Nuni.<verse eid="NUM 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 13:9" />Kulawa mna kabila lya Benyamini, tsakatumighwa Paliti mwana wa Rafu.<verse eid="NUM 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 13:10" />Kulawa mna kabila lya Zebuloni, tsakatumighwa Gadieli mwana wa Sodi.<verse eid="NUM 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 13:11" />Kulawa mna kabila lya Manase, tsakatumighwa Gadi mwana wa Susi.<verse eid="NUM 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 13:12" />Kabila mna kabila lya Dani, tsakatumighwa Amieli mwana wa Gemali.<verse eid="NUM 13:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 13:13" />Kulawa mna kabila lya Asheri, tsakatumighwa Seturi mwana wa Mikaeli.<verse eid="NUM 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 13:14" />Kulawa mna kabila lya Nafutali, tsakatumighwa Nabi mwana wa Wofisi.<verse eid="NUM 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 13:15" />Kulawa mna kabila lya Gadi, tsakatumighwa Geueli mwana wa Maki.<verse eid="NUM 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 13:16" />Aghano ghagho mataghwa ghe iwanu iwatumighwe na Musa waghende wakaipelembe isi ya Kanaani. Musa tsakamwing'a taghwa lingi imwana wa Nuni yakemighwe Hoshea, naye tsakamkema Yoshua. <verse eid="NUM 13:16" /><verse number="17" style="v" sid="NUM 13:17" />Hawatumile waghende kuipelemba isi ya Kanaani kawalongela, “Mghende mbaka kune isi ya ubali wa kusini wa Kanaani, kuya mkagheluke kupfidunda, <verse eid="NUM 13:17" /><verse number="18" style="v" sid="NUM 13:18" />mkaipelembe isi pfaili. Mkalole ka iwanu iwokala amwo wana ngupfu au nyondenyonde, wengi au wadodo. <verse eid="NUM 13:18" /><verse number="19" style="v" sid="NUM 13:19" />Mkalole ka isi ayo inogha au iha, na ka imiji yawokala ndalo, au tsing'anda tsitsungulukighwe na maboma. <verse eid="NUM 13:19" /><verse number="20" style="v" sid="NUM 13:20" />Mkalole ka lidongo lyomela pfijo au ng'aimela pfijo, ina mihulo au yahela. Mghangamale na hamtsakuya msole ghamatunda ghe isi ayo.” Mna ghumsimu agho tsinzabibu tsing'ali tsikwipfa. <verse eid="NUM 13:20" /><verse number="21" style="v" sid="NUM 13:21" />Iwanu awo tsawaghenda kuipelemba isi kulawa nyika ya Sini mbaka Rehobu, habehi na nzila ighendile Hamati. <verse eid="NUM 13:21" /><verse number="22" style="v" sid="NUM 13:22" />Tsawaghenda mbaka ubali wa kusini wa Kanaani, wapfosa mbaka kune ghumji ghwa Hebuloni. Amwo tsawawapfika Waahimani, Washeshai na Watalimai, watsukulu wa Anaki. Ghumji ghwa Hebuloni tsaghutsengighwa miyaka saba ng'ana ghumji ghwa Soani ighuli Misiri ghutsengighwe. <verse eid="NUM 13:22" /><verse number="23" style="v" sid="NUM 13:23" />Hawapfikile kune luwala lwa Eshikoli, iwanu awo waghana chikungwi cha mnzabibu line ghamatunda mengi, kuya tsawalighala mnzeghamnzegha. Pfipfila tsawasola makomamanga na tini. <verse eid="NUM 13:23" /><verse number="24" style="v" sid="NUM 13:24" />Ihanu aho tsahakemighwa luwala lwa Eshikoli mana yake chikungwi, kwaapfila chikungwi cha nzabibu tsachighanighwa ihanu aho.<verse eid="NUM 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 13:25" />Hawamalitse kuipelemba isi kwa matsuwa alubaini iwanu'wo tsawoya. <verse eid="NUM 13:25" /><verse number="26" style="v" sid="NUM 13:26" />Wawaghendela Musa, Aruni na iwanu wa Isiraeli ako Kadeshi, kune nyika ya Parani, wawalongela aghala ghose ghawonile na kuwalangusa ghamatunda ghawoyile nagho. <verse eid="NUM 13:26" /><verse number="27" style="v" sid="NUM 13:27" />Wamlongela Musa, “Tsatuipfikila iisi yaututumile tukaipelembe, isi ayo ine lidongo linogha kwa kulima na kwa kufughila na aghano matunda ghake. <verse eid="NUM 13:27" /><verse number="28" style="v" sid="NUM 13:28" />Lekeni wenyekaye wana ngupfu sideke, ne miji yawo mikulu ng'ani na itsungulusighwa maboma. Pfipfila tsatuwona watsukulu wa Anaki watali sideke. <verse eid="NUM 13:28" /><verse number="29" style="v" sid="NUM 13:29" />Waamaleki wokala mna isi ya ubali wa Kusini wa Kanaani. Wahiti, Wayebusi, na Waamori wokala mna isi ine pfidunda, na Wakanaani wokala habehi na bahali ya Meditelania habehi na ghumto ghwa Yoridani.” <verse eid="NUM 13:29" /><verse number="30" style="v" sid="NUM 13:30" />Lekeni Kalebu kawalongela iwanu hambele ya Musa wenyamale, kalonga, “Tukeni tukaisole isi ayo iwe yetu kwaapfila todaha ghendo kuhuma.” <verse eid="NUM 13:30" /><verse number="31" style="v" sid="NUM 13:31" />Lekeni iwanu iwaghendile hamwe naye kuipelemba isi walonga, “Ng'atutsodaha baye kwitowa ne iwanu'wo, kwaapfila wawo wana ngupfu kubita twetwe.” <verse eid="NUM 13:31" /><verse number="32" style="v" sid="NUM 13:32" />Apfo walalatsa mbuli tsihile tse isi yawaipelembe kwa Waisiraeli, walonga, “Isi ayo yowakoma iwanu. Pfipfila iwanu watuwone ako, wakulu sideke. <verse eid="NUM 13:32" /><verse number="33" style="v" sid="NUM 13:33" />Ako twona mitsinu, watsukulu wa Anaki. Twetwe tuwenyegho tsatwibona ka pfidanukila hambele hawo, nawo pfipfila tsawatwona twetwe ka pfidanukila.”<verse eid="NUM 13:33" /></para>
  <chapter eid="NUM 13" />
  <chapter number="14" style="c" sid="NUM 14" />
  <para style="s">Iwanu wa Isiraeli wosing'inika</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 14:1" />Mne chilo chila Waisiraeli wandusa kudadama na walila, <verse eid="NUM 14:1" /><verse number="2" style="v" sid="NUM 14:2" />Wamsing'inikila Musa na Aruni walonga, “Ng'apfu tung'afile Misiri au kukuno kunyika. <verse eid="NUM 14:2" /><verse number="3" style="v" sid="NUM 14:3" />Ebali IMNDEWA yotughala kune isi ayo? Tutsokomighwa kune ng'ondo, wapinga wetu ne wana wetu watsoghoghighwa kwa ngupfu! Ng'apfu tuye Misiri kubita kughenda Kanaani.” <verse eid="NUM 14:3" /><verse number="4" style="v" sid="NUM 14:4" />Kuya welongela, “Tumsaghuleni chilongotsi yungi tuye Misiri.”<verse eid="NUM 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 14:5" />Baho Musa na Aruni wafunama hambele ha Waisiraeli wose. <verse eid="NUM 14:5" /><verse number="6" style="v" sid="NUM 14:6" />Iwanu weli iwaghendile kuipelemba isi, imwana wa Nuni, yakemighwe Joshua na imwana wa Yefune, yakemighwe Kalebu wadegha maghwanda ghawo, <verse eid="NUM 14:6" /><verse number="7" style="v" sid="NUM 14:7" />na wawalongela Waisiraeli wose, “Isi yatughendile kuisaghanisa inogha ng'ani. <verse eid="NUM 14:7" /><verse number="8" style="v" sid="NUM 14:8" />Ka IMNDEWA katsotutoghola, katsotughala ako na kutwing'a isi ayo ine lidongo linoghile kwa kulima na ukupfughila. <verse eid="NUM 14:8" /><verse number="9" style="v" sid="NUM 14:9" />Lekeni mleke kumlemela IMNDEWA, wala mleke kuwapfuka iwanu iwokala mna isi ayo. Kwaapfila awo kuna twetwe twowona ka nyondenyonde na chinu chawekingila chilawa chuka, na IMNDEWA ka hamwe natwe, mleke kuwapfuka.” <verse eid="NUM 14:9" /><verse number="10" style="v" sid="NUM 14:10" />Lekeni Waisiraeli wose wabama kuwatowa ne ghamabwe. Na mng'alo ghwe IMNDEWA ghulawila kwa kwidukitsa mna lihema lya kwitinganila, hambele ha iwanu wose wa Isiraeli.<verse eid="NUM 14:10" /></para>
  <para style="s">Musa kowalombela iwanu</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 14:11" />Kuya IMNDEWA kamlongela Musa, “Angu wanu wano watsoghendelela kunibetsa nene mbaka tsuwachi? Na mbaka tsuwachi woghendelela kuleka kunitoghola nene? Hamwe na ipfihulo pfose pfanitendile kune iwanu wano. <verse eid="NUM 14:11" /><verse number="12" style="v" sid="NUM 14:12" />Nitsoweng'a utamu mkulu nawo utsowakoma, lekeni nitsokutenda ghweghwe uwe aba wa taifa kulu na line ngupfu sideke kubita wawo!”<verse eid="NUM 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 14:13" />Lekeni Musa kamlongela IMNDEWA, “Iwanu wano tsakuwalapfa Misiri kwe ngupfu yako. Wamisiri hawotsohulika ka kuwatenda apfo iwanu wako, <verse eid="NUM 14:13" /><verse number="14" style="v" sid="NUM 14:14" />watsowalongela iwanu iwokala mna isi ino. Kwaapfila iwanu wano ma wahulika ka ghweghwe IMNDEWA kwa hamwe natwe, na kwakoneka mwatsimwatsi ahala libingu lyako halikwima mna twetwe, na ka kotulongolela nemisi kwe ngutso ya libingu na kotulongolela nechilo kwe ngutso ye ghumoto. <verse eid="NUM 14:14" /><verse number="15" style="v" sid="NUM 14:15" />Lelo ung'awakoma iwanu wako wose kwa mala lumwe, iwanu iwahulike mbuli tsako watsolonga, <verse eid="NUM 14:15" /><verse number="16" style="v" sid="NUM 14:16" />‘IMNDEWA kawakoma iwanu wake kunyika kwaapfila ng'adahile baye kuwaghala kune isi yalongile koweng'a.’ <verse eid="NUM 14:16" /><verse number="17" style="v" sid="NUM 14:17" />Lelo nokulomba IMNDEWA, utulanguse ukulu wako kwa kutenda ghautulongele ahala haulongile, <verse eid="NUM 14:17" /><verse number="18" style="v" sid="NUM 14:18" />‘Nene IMNDEWA sisumkagha baye kona maya, na nowonela libatsi awala iwototsa na wane nzambi. Lekeni sitsoleka baye kuwahigha iwana na iwatsukulu kwa nzambi tsa aba tsawo, mbaka lweleko lwa kadatu na lweleko lwa kane,’ <verse eid="NUM 14:18" /><verse number="19" style="v" sid="NUM 14:19" />Kwa uluso wako mkulu uwaleghusile nzambi tsawo iwanu wano ka apfila pfauwaleghusile ahala hawalawile Misiri mbaka sambi.”<verse eid="NUM 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 14:20" />IMNDEWA kalonga, “Niwaleghusila nzambi tsao ka pfaulongile. <verse eid="NUM 14:20" /><verse number="21" style="v" sid="NUM 14:21" />Lekeni nelighita ghendo, ka nene pfanikala matsuwa ghose, na isi pfaitsomema ukulu wangu, <verse eid="NUM 14:21" /><verse number="22" style="v" sid="NUM 14:22" />Mna iwanu iwonile umng'alo wangu na pfihulo pfangu pfanitendile Misiri na kunyika kuya koghendelela kunighetsa mala kumi yose ino bila kunihulikitsa, <verse eid="NUM 14:22" /><verse number="23" style="v" sid="NUM 14:23" />haduhu hata yumwe yatsoyona isi ila yanongile nitsoweng'a wanzehe wawo, na awala iwonibetsa pfipfila ng'awotsoyona baye. <verse eid="NUM 14:23" /><verse number="24" style="v" sid="NUM 14:24" />Lekeni kwaapfila mtumighwa wangu Kalebu kahake, na kanihulikitsa pfinoghile, nitsomghala kune isi'yo yaikanyaghe, ne wanaghe watsoitawala. <verse eid="NUM 14:24" /><verse number="25" style="v" sid="NUM 14:25" />Kwaapfila Waamaleki na Wakanaani wokala mna luwala lwe isi ayo, ilupfi muhunduke kuchughu mghende kunyika kune bahali ya Shamu.” <verse eid="NUM 14:25" /><verse number="26" style="v" sid="NUM 14:26" />Kuya IMNDEWA kamghutsa Aruni na Musa, kalonga, <verse eid="NUM 14:26" /><verse number="27" style="v" sid="NUM 14:27" />“Iwanu wano wehile watsoghendelela kunising'inikila mbaka tsuwachi? Nene nyipfa na Waisiraeli kunising'ikila! <verse eid="NUM 14:27" /><verse number="28" style="v" sid="NUM 14:28" />Lelo muwalongele pfino, ‘Nelighita ghendo nene IMNDEWA, nitsowatendela ghaghala ghanihulike mwolonga. <verse eid="NUM 14:28" /><verse number="29" style="v" sid="NUM 14:29" />Mtsakufa na ng'uli tsenu tsitsakwasighwa kukuno kunyika kwaapfila mnising'inikila nene, haduhu hata yumwe yane miyaka ishilini na kughendelela iyanising'inikile, <verse eid="NUM 14:29" /><verse number="30" style="v" sid="NUM 14:30" />yatsakwingila kune isi yanongile nitsomwing'eni iwe yenu, Kalebu imwana wa Yefune, na Yoshua imwana Nuni. <verse eid="NUM 14:30" /><verse number="31" style="v" sid="NUM 14:31" />Mwemwe tsamlonga ka iwanenu watsoghoghighwa kwa ngupfu, ila nene nitsowahilika iwana wenu kune isi yamuibetsile, ili waimanye na wakale mumo. <verse eid="NUM 14:31" /><verse number="32" style="v" sid="NUM 14:32" />Lekeni mwemwe mtsakufila kukuno kunyika! <verse eid="NUM 14:32" /><verse number="33" style="v" sid="NUM 14:33" />Iwanenu watsoyungayunga ka wadimi, na kughaya kukuno kunyika kwa miyaka alubaini mbaka imunu wenu wa utsighilo hayatsakufa, kwaapfila mwemwe ng'amnitoghole baye. <verse eid="NUM 14:33" /><verse number="34" style="v" sid="NUM 14:34" />Mtsoghendelela kughaya kwa matotso ghenu kwa miyaka alubaini, ka apfila pfamghendile kuipelemba isi kwa matsuwa alubaini, mtsoghaya mwaka ghumwe kwa chila tsuwa, kuya mtsomanya ka ukwisonga na nene chinu chachi.’ <verse eid="NUM 14:34" /><verse number="35" style="v" sid="NUM 14:35" />Nene IMNDEWA nolonga, ‘Nitsowatendela apfo mwemwe wose yamwitingane hano kunilema. Wose mtsakufila kukuno kunyika.’” <verse eid="NUM 14:35" /><verse number="36" style="v" sid="NUM 14:36" />Iwanu wala watumighwe na Musa waghende kuipelemba isi ila, no kwatenda iwanu wamsing'inikile IMNDEWA kwa kuilonga pfihile iisi ila, <verse eid="NUM 14:36" /><verse number="37" style="v" sid="NUM 14:37" />iwanu awo tsawafa kwa utamu wihile hambele he IMNDEWA. <verse eid="NUM 14:37" /><verse number="38" style="v" sid="NUM 14:38" />Lekeni imwana wa Nuni yakemighwe Yoshua na imwana wa Yefune yakemighwe Kalebu, awala iwaghendile kuipelemba isi tsawakala waghima.<verse eid="NUM 14:38" /></para>
  <para style="s">Waisiraeli wolamula kuipfingilila isi</para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 14:39" />Musa hayawalongele Waisiraeli aghala ghayamlongele IMNDEWA, wose tsawalila kwa usungu mkulu. <verse eid="NUM 14:39" /><verse number="40" style="v" sid="NUM 14:40" />Ilupfi yake, tsawalamka lupfilipfili waghenda kune pfidunda, walonga, “Lelo twolamula twoghenda hanu hala IMNDEWA hayatulongele tughende. Twomanya ka tsatutenda nzambi.”<verse eid="NUM 14:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="NUM 14:41" />Lekeni Musa kalonga, “Ule ng'amhulikitsa IMNDEWA? Ng'amtsohuma baye! <verse eid="NUM 14:41" /><verse number="42" style="v" sid="NUM 14:42" />Mleke kughenda ako kuchidunda hela mtsotowighwa na awala iwowehila, kwaapfila IMNDEWA ng'atsakuwa hamwe namwe baye. <verse eid="NUM 14:42" /><verse number="43" style="v" sid="NUM 14:43" />Mng'etowa na Waamaleki na Wakanaani, mtsakufa kune ng'ondo, kwaapfila mumlema IMNDEWA, naye ng'atsakuwa hamwe namwe baye.” <verse eid="NUM 14:43" /><verse number="44" style="v" sid="NUM 14:44" />Wawo tsawananahila kugheluka kuchidunda, ila Musa ng'aghendile baye, wala lisanduku lya laghano lye IMNDEWA kulawa kune ndalo ng'alighendile baye. <verse eid="NUM 14:44" /><verse number="45" style="v" sid="NUM 14:45" />Baho Waamaleki na Wakanaani iwang'ali wokala kune isi ye pfidunda, wahulumka wawatowa na wahuma. Wawawinga mbaka kune ghumji ghwa Horima.<verse eid="NUM 14:45" /></para>
  <chapter eid="NUM 14" />
  <chapter number="15" style="c" sid="NUM 15" />
  <para style="s">Malaghitso ghukulapfa tsinambiko</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 15:1" />Imulumgu tsakamlongela Musa, <verse eid="NUM 15:1" /><verse number="2" style="v" sid="NUM 15:2" />“Walongele Waisiraeli pfino, hampfika mna isi yanimwing'ani mkale, <verse eid="NUM 15:2" /><verse number="3" style="v" sid="NUM 15:3" />na hamnilapfila nene tsinambiko kulawa kune mifugho yenu, au nambiko ya kulakatsighwa, imnyama wa yawilaghane mwenyegho kulapfa au imnyama iyolapfa imunu kwa ukubama mwenyegho, au imnyama iyolapfighwa mna pfihungo pfenu, na ukulakatsighwa kwe iwanyama awo komnung'ila ghoya IMNDEWA. <verse eid="NUM 15:3" /><verse number="4" style="v" sid="NUM 15:4" />Imunu iyolapfa tsinambiko tsino tse wanyama pfipfila yamlapfile nambiko ya usaghe, uwe kimbo limwe utighinike ghendo na iuhanganyike na kimbo limwe lya ghamapfuta. <verse eid="NUM 15:4" /><verse number="5" style="v" sid="NUM 15:5" />Pfipfila yalapfe kimbo limwe lya dipfai, iwe nambiko ya chokunwa kwa chila mwana we ng'olo iyolapfighwa yalakatsighwe. <verse eid="NUM 15:5" /><verse number="6" style="v" sid="NUM 15:6" />Hamlapfa ing'olo mmale yawe nambiko, pfipfila mlapfe makimbo meli gha usaghe ihuhanganyike na kimbo limwe na nusu lya ghamafuta uwe nambiko ya usaghe. <verse eid="NUM 15:6" /><verse number="7" style="v" sid="NUM 15:7" />Hamwe na kimbo limwe lya dipfai, iwe nambiko ya chokunwa, na hayolakatsighwa yamnung'ile ghoya IMNDEWA. <verse eid="NUM 15:7" /><verse number="8" style="v" sid="NUM 15:8" />Hamlapfa imwana mmale we ng'ombe yawe nambiko yakulakatsighwa au yawe nambiko ya chinu choyolaghana imunu, au yawe nambiko ya kukala tseghamba ne Imulungu. <verse eid="NUM 15:8" /><verse number="9" style="v" sid="NUM 15:9" />Imunu iyolapfa tsinambiko tsino tse wanyama pfipfila yamlapfile nambiko ya usaghe, uwe makimbo sita utighinike ghendo na ihuhanganyike na makimbo meli ghe ghamapfuta, <verse eid="NUM 15:9" /><verse number="10" style="v" sid="NUM 15:10" />hamwe na makimbo meli gha dipfai, ghawe nambiko ya chokunwa. Ukulakatsighwa kwe iwanyama wano komnung'ila ghoya IMNDEWA. <verse eid="NUM 15:10" /><verse number="11" style="v" sid="NUM 15:11" />Apfino pfipfo ipfinu ipfibamighwa kulapfighwa ahala hayolapfighwa chila ng'ombe mmale, ing'unzu, mwana we ng'olo mmale, au mvulati. <verse eid="NUM 15:11" /><verse number="12" style="v" sid="NUM 15:12" />Ipfinu apfo ipfilapfighwa pfakongetseka kwa kulola iwanyama iwolapfighwa wali wangapi. <verse eid="NUM 15:12" /><verse number="13" style="v" sid="NUM 15:13" />Chila Muisiraeli yatende apfi chila hayolapfa nambiko yo kulakatsighwa ye mnyama, ukulakala kwake komnung'ila ghoya IMNDEWA. <verse eid="NUM 15:13" /><verse number="14" style="v" sid="NUM 15:14" />Na ka mna muhenza iyokala namwe kwa matsuwa chidogho au kwa matsuwa ghose, naye kobama kulapfa nambiko ya kulakatsighwa, ya ukumnung'ila ghoya IMNDEWA, imunu ayo yatende ka pfamtenda mwemwe. <verse eid="NUM 15:14" /><verse number="15" style="v" sid="NUM 15:15" />Mna pfeleko pfenu pfose ipfikutsa, malaghitso ghaghala ghamkinda mwemwe, imuhenza yamkala naye, naye yaghakinde ghagho, hambele he Imulungu wose mtsolingana. <verse eid="NUM 15:15" /><verse number="16" style="v" sid="NUM 15:16" />Mwemwe na iwahenza wamkala nawo wose mtsakuwa na malaghitso ghamwe na imiko imwe.”<verse eid="NUM 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 15:17" />Kuya IMNDEWA kalonga na Musa, <verse eid="NUM 15:17" /><verse number="18" style="v" sid="NUM 15:18" />“Walongele Waisiraeli pfino, ‘Hampfika mna isi yanimghalani, <verse eid="NUM 15:18" /><verse number="19" style="v" sid="NUM 15:19" />hamkuja ipfijo pfambeta mna isi ayo, mbaghule chijo chidogho, mlapfe nambiko kwa IMNDEWA. <verse eid="NUM 15:19" /><verse number="20" style="v" sid="NUM 15:20" />Mlapfileni chighate ichilawa mna usaghe wa pfijo pfenu pfamlimbule na kupfibeta kulawa hanu hawobetela ipfijo. <verse eid="NUM 15:20" /><verse number="21" style="v" sid="NUM 15:21" />Mtsondapfila nene Imulungu inambiko ino ya chighate chokulimbula mna pfeleko pfenu pfose ipfikutsa. <verse eid="NUM 15:21" /><verse number="22" style="v" sid="NUM 15:22" />Lekeni ka mtsototsa na kuleka kughakinda ghamalaghitso ghano ghanimlongele Musa, <verse eid="NUM 15:22" /><verse number="23" style="v" sid="NUM 15:23" />na ka mna ghamatsuwa ighakutsa iwanu ng'awokinda baye ghose nene Imulungu ghanimlongele Musa, <verse eid="NUM 15:23" /><verse number="24" style="v" sid="NUM 15:24" />ka litotso alyo lyitendeka bila kumanyika wala ghumtingano ghwose ng'aghutangile baye, apfo mtingano ghwose ghwa Isiraeli, watsolapfa ng'ombe yumwe mmale yawe nambiko ya kulakatsighwa, na hayolakala yamnung'ile ghoya IMNDEWA, na walapfe nambiko ya usaghe na nambiko ya chakunwa kwa kuwinza ghamalaghitso ghake. Pfipfila walapfe mvulati yumwe yawe nambiko ya kuwaleghusila nzambi. <verse eid="NUM 15:24" /><verse number="25" style="v" sid="NUM 15:25" />Mtambika katsotenda chihendo chokuwalamlitsa Waisiraeli ne Imulungu, nawo watsoleghusighwa inzambi yawo kwaapfila tsawatenda aku ng'awamanyile baye na wao tsawamghalila IMNDEWA inambiko yakulakatsighwa na ayila nambiko ya kuleghusa nzambi kwa totso lyawatendile. <verse eid="NUM 15:25" /><verse number="26" style="v" sid="NUM 15:26" />Waisiraeli wose hamwe na iwagheni iwokala nawo, watsoleghusighwa inzambi yao kwaapfila wose tsawatotsa. <verse eid="NUM 15:26" /><verse number="27" style="v" sid="NUM 15:27" />Imunu yumwe yang'atenda nzambi aku ng'amanyile abe, ayo yalapfe imene mbughuma yane ghumwaka ghumwe, yawe nambiko yakumleghusila nzambi yake. <verse eid="NUM 15:27" /><verse number="28" style="v" sid="NUM 15:28" />Imtambika katsomlapfa imene ayo, naye komlamlitsa ne Imulungu, naye koleghusighwa izambi yake. <verse eid="NUM 15:28" /><verse number="29" style="v" sid="NUM 15:29" />Mkinde laghitso limwe chila munu iyotenda nzambi aku ng'omanya baye, yawe Muisiraeli au yawe mgheni yamkala naye. <verse eid="NUM 15:29" /><verse number="30" style="v" sid="NUM 15:30" />Munu wowose iyotenda nzambi kwa kubama mwenyegho, yawe Muisiraeli au yawe mgheni, ayo komligha IMNDEWA, na yabaghulighwe yakale kutali ne wanu wake. <verse eid="NUM 15:30" /><verse number="31" style="v" sid="NUM 15:31" />Kwaapfila kalema aghala ghayalongile IMNDEWA na kalema kughakinda ghamalaghitso, ayo yabaghulighwe ghendo, na keyonza mwenyegho hayatsakufa.’”<verse eid="NUM 15:31" /></para>
  <para style="s">Ukulema ukikinda Isabato</para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 15:32" />Waisiraeli hawang'ali wakunyika, wamwona munu yumwe kodondola tsingodi mna litsuwa lya Sabato. <verse eid="NUM 15:32" /><verse number="33" style="v" sid="NUM 15:33" />Iwanu iwamonile kudondola tsingodi wamghala kwa Musa na Haruni na kwa Waisiraeli wose. <verse eid="NUM 15:33" /><verse number="34" style="v" sid="NUM 15:34" />Nawo wamwihindila mng'anda kwapfila nga'awamanyile baye chinu cho kumtenda. <verse eid="NUM 15:34" /><verse number="35" style="v" sid="NUM 15:35" />IMNDEWA kamlongela Musa, “Imunu'yo yakomighwe, Waisiraeli wose wakamtowe ne ghamabwe ako kunze mwe ndalo.” <verse eid="NUM 15:35" /><verse number="36" style="v" sid="NUM 15:36" />Apfo iwanu wose wamsola imunu'yo, wamghala kunze mwe ndalo, na kuko wamtowa na ghamabwe mbaka kafa, ka IMNDEWA pfayamlaghitse Musa.<verse eid="NUM 15:36" /></para>
  <para style="s">Pfifundo ipfilebela mna tsimembe tsa ghamagwanda</para>
  <para style="p">
    <verse number="37" style="v" sid="NUM 15:37" />Kuya IMNDEWA kamlongela Musa, <verse eid="NUM 15:37" /><verse number="38" style="v" sid="NUM 15:38" />“Walongela Waisiraeli, uwalaghitse wapfoghose pfifundo mna tsimembe tsa ghamagwanda ghao, na wadadatsile tsinyutsi tsa langi ya buluu mchanya mwa chila chipfundo. Uwalongele watende apfo mna pfeleko pfao ipfikutsa. <verse eid="NUM 15:38" /><verse number="39" style="v" sid="NUM 15:39" />Pfifundo apfo pfitsowatenda mwemwe mkumbukeghe, chila hampfona mtsoghakinda ghamalaghitso ghangu na kughatenda, hela mleke kutenda aghala ghambama wenyegho na ghala ghamkona kwa nenge tsenu wenyegho. <verse eid="NUM 15:39" /><verse number="40" style="v" sid="NUM 15:40" />Pfifundo apfo pfitsowatenda mkumbuke ghamalaghitso ghangu ghose na kughakinda muwe wenzeluka. <verse eid="NUM 15:40" /><verse number="41" style="v" sid="NUM 15:41" />Nene na IMNDEWA, Imulungu wenu, yaniwapfile mna isi ya Misiri ili niwe mulungu wenu. Nene na IMNDEWA, Imulungu wenu.”<verse eid="NUM 15:41" /></para>
  <chapter eid="NUM 15" />
  <chapter number="16" style="c" sid="NUM 16" />
  <para style="s">Kola, Datani na Abiramu womlema Musa</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 16:1" />Kuya Kola, imwana wa Ishali wa lukolo lwa Kohati, iyolawila mna likabila lya Lawi, kawasola Datani na Abiramu, iwanaghe Eliabu, na kamsola Oni mwanaghe Peleti, iwalawile mna kabila lya Rubeni. <verse eid="NUM 16:1" /><verse number="2" style="v" sid="NUM 16:2" />Iwanu wano hamwe na Waisiraeli, na pfilingotsi miya mbili na hamsini, iwasaghulighwe na iwomanyika na Waisiraeli wose, wamlema Musa. <verse eid="NUM 16:2" /><verse number="3" style="v" sid="NUM 16:3" />Wetingana hamwe kuwalonga Musa na Aruni, wawalonga pfino, “Mwemwe mlumbilila ghendo, Waisiraeli wose wenzeluka, chila yumwe kenzeluka, na Imulungu kahamwe nawo. Ule lelo mwemwe mwitunya kubita mtingano ghwose ghwe IMNDEWA?” <verse eid="NUM 16:3" /><verse number="4" style="v" sid="NUM 16:4" />Musa hayahulike apfo, kafunama. <verse eid="NUM 16:4" /><verse number="5" style="v" sid="NUM 16:5" />Kuya kamlongela Kola na awala iyelongotse nawo, “Nemitondo Imulungu katsotulangusa tsina nani iwali wakwake yeye, na nani iyenzeluke, kwaapfila yeye iyomsaghula yuyo iyatsomsoghelela habehi. <verse eid="NUM 16:5" /><verse number="6" style="v" sid="NUM 16:6" />Lelo mtende apfi, nemitondo ghweghwe Kola na iwanu wako msole pfetetso, <verse eid="NUM 16:6" /><verse number="7" style="v" sid="NUM 16:7" />mwike ghamakala gha ghumoto na mdusule upfumba, kuya mpfighale hambele he IMNDEWA. Kuya tutsolola yuhi yasaghulighwe ne IMNDEWA. Mwemwe wana wa Lawi mlumbilila sideke!” <verse eid="NUM 16:7" /><verse number="8" style="v" sid="NUM 16:8" />Kuya Musa kamlongela Kola, “Tegheletseni mwemwe wana wa Lawi! <verse eid="NUM 16:8" /><verse number="9" style="v" sid="NUM 16:9" />Angu mwemwe mwakona chinu chidodo kwa Imulungu wa Isiraeli kuwasaghula mwemwe kulawa mna Waisiraeli wose, mdahe kumsoghelela na kumsang'anila mna Lihema Lienzeluke lye Imulungu, na kuwatumikila Waisiraeli wose? <verse eid="NUM 16:9" /><verse number="10" style="v" sid="NUM 16:10" />Yeye kawaghala muwe habehi naye, mwemwe na Walawi wayenu wose. Lelo namwe pfipfila mwobama ing'onde yo kutambika? <verse eid="NUM 16:10" /><verse number="11" style="v" sid="NUM 16:11" />Apfo ghweghwe na wayagho mwomsing'inikila Imulungu, Angu Aruni nani mbaka mwomsinikila?” <verse eid="NUM 16:11" /><verse number="12" style="v" sid="NUM 16:12" />Kuya Musa kawakema Datani na Abiramu, wanaghe Eliabu, lekeni wamwidika, “Ng'atukutsa baye”, <verse eid="NUM 16:12" /><verse number="13" style="v" sid="NUM 16:13" />“Angu si chinu chidodo baye kwa ghweghwe kutulapfa Misili, isi ine lidongo linoghile kwa ukulima na ukufugha ili utse utukomele akuno kunyika? Kuya ghweghwe kwetenda kwa mkulu wetu? <verse eid="NUM 16:13" /><verse number="14" style="v" sid="NUM 16:14" />Kuya ghweghwe ng'utughalile baye mna isi ila ine lidongo linoghile na uki wala ng'utwing'ile baye mghunda na mighunda ya mitsabibu iwe yetu. Angu kwodaha kututende twetwe tuwe pfifita? Twetwe ng'atukutsa baye” <verse eid="NUM 16:14" /><verse number="15" style="v" sid="NUM 16:15" />Musa tsakona maya sideke, kamlongela IMNDEWA, “Uleke kutsitoghola tsinambiko tse wanu wano. Nene sisolile ipunda wa munu wowose baye wala simlaghile munu wowose baye. <verse eid="NUM 16:15" /><verse number="16" style="v" sid="NUM 16:16" />Musa kamlongela Kola, Ilupfi mtse ghweghwe na iwanu wako hambele he IMNDEWA. Haruni pfipfila kakuwa kabaho. <verse eid="NUM 16:16" /><verse number="17" style="v" sid="NUM 16:17" />Chila munu yasole chetetso chake na yeke upfumba mghati mwake, na mpfighale hambele ye IMNDEWA, pfetetso pfose pfiwe miya mbili hamsini. Ghweghwe na Aruni wose msole pfetetso pfenu.” <verse eid="NUM 16:17" /><verse number="18" style="v" sid="NUM 16:18" />Apfo chila munu kasola chetetso chake, keka ghumoto na kadusula upfumba. Kuya wose waghenda wema hane libani lya lihema lihenzeluke hamwe na Musa na Haruni. <verse eid="NUM 16:18" /><verse number="19" style="v" sid="NUM 16:19" />Kuya Kola kawalongela Waisiraeli wose iwomuhulikitsa wetingane hamwe hane libani lya Lihema Lienzeluke, Baho ghumng'alo ghwe Imulungu ghuwalawila iwanu wose iwetingane hamwe. <verse eid="NUM 16:19" /><verse number="20" style="v" sid="NUM 16:20" />Kuya IMNDEWA kalonga na Musa na Aruni, kawalongela, <verse eid="NUM 16:20" /><verse number="21" style="v" sid="NUM 16:21" />“Mwibaghule na mkale kutali ne wanu awo ili nene nidahe kuwakomela lumwe iwanu awo.” <verse eid="NUM 16:21" /><verse number="22" style="v" sid="NUM 16:22" />Lekeni Musa na Haruni wafunama, walila kwa kukemelela, walonga, “Ghwe Mulungu, ghwe kwa Mulungu yuweng'a iwanu ughima, angu imunu yumwe yang'atenda nzambi, kowonela maya mtingano ghwose?” <verse eid="NUM 16:22" /><verse number="23" style="v" sid="NUM 16:23" />IMNDEWA kamlongela Musa, <verse eid="NUM 16:23" /><verse number="24" style="v" sid="NUM 16:24" />Uwalongele iwanu iwali hane ghumtingano woke waleke kukala habehi na lihema lya Kola na Datani na Abiramu. <verse eid="NUM 16:24" /><verse number="25" style="v" sid="NUM 16:25" />Apfo Musa kenuka na kawaghendela Datani, Abiramu na pfilongotsi wose wa Isiraeli wamuwinza yeye. <verse eid="NUM 16:25" /><verse number="26" style="v" sid="NUM 16:26" />Hayapfikile kaghulongela mtingano ghwe wanu, “Nowadedetsa mke kulawa hane ghamahema ghe wanu wano wehile wala mleke kukinda chinu chao chochose chila, hela namwe mtsokomighwa hamwe nawo kwa nzambi tsao tsawatendile.” <verse eid="NUM 16:26" /><verse number="27" style="v" sid="NUM 16:27" />Apfo iwanu woka kulawa hane ghamahema gha Kola, Datani na Abiramu. Datani na Abiramu walawa kunze wema hane mibani ya ghamahema ghawo hamwe na wehe tsawo, ne iwana wao iwabala na awala iwakong'a. <verse eid="NUM 16:27" /><verse number="28" style="v" sid="NUM 16:28" />Musa kawalongela iwanu, “Apfi pfipfo iwanu pfawatsomanya ka IMNDEWA yuyo iyanitumile nitende agha ghose, wala nene sitenda baye ka pfanibama nene mwenyegho. <verse eid="NUM 16:28" /><verse number="29" style="v" sid="NUM 16:29" />Ka iwanu wano wakufa ka iwanu wose pfawafagha, au wang'atingwa ka wanu wangi pfawotingwa, apfo mmanye ghendo IMNDEWA ng'anitumile baye. <verse eid="NUM 16:29" /><verse number="30" style="v" sid="NUM 16:30" />Lekeni Imulungu yang'atenda chinu chingi, ng'ana chilawile baye, na lidongo ling'atulika na kuwametsa wose na chila chinu ichili chawo, na wang'ahulumka kutsimu aku wang'ali waghima, baho mtsotanga ghendo ka iwanu wano wambetsa IMNDEWA.” <verse eid="NUM 16:30" /><verse number="31" style="v" sid="NUM 16:31" />Baho hayamalitse kulonga apfo, lidongo lili hasi ha Datani na Abiramu litulika. <verse eid="NUM 16:31" /><verse number="32" style="v" sid="NUM 16:32" />Na liwametsa iwanu wose, ne wanu wa tsikaye tsawo, hamwe na wanu wose iwelongotse na Kola na pfinu pfao pfose. <verse eid="NUM 16:32" /><verse number="33" style="v" sid="NUM 16:33" />Apfo wose wahulumka kutsimu, na chila chinu ichili chao, nalyo lidongo liwaghubika na wahupa kulawa hane ghumtingano ghwe wanu. <verse eid="NUM 16:33" /><verse number="34" style="v" sid="NUM 16:34" />Waisiraeli wose iwakalile habehi nawo hawahulike chililo chao watsuma aku wolonga, “Tutsume hela lidongo litsotumetsa na tuye” <verse eid="NUM 16:34" /><verse number="35" style="v" sid="NUM 16:35" />Kuya ghumoto kulawa kwe IMNDEWA ghuhulumka ghuwalakatsa iwanu wala miya mbili na hamsini iwang'ali wodusula upfumba hane Lihema Lienzeluke.<verse eid="NUM 16:35" /></para>
  <para style="s">Pfetetso pfo kudusulila upfumba</para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 16:36" />Kuya IMNDEWA kamlongela Musa, <verse eid="NUM 16:36" /><verse number="37" style="v" sid="NUM 16:37" />“Mlongele Eliazari, mwana wa mtambika Aruni yapfisole pfetetso apfo, aho hane ghumoto, na yakaghumwaghe kutali ghumoto aghwo, kwaapfila pfetetso apfo pfenzeluka. <verse eid="NUM 16:37" /><verse number="38" style="v" sid="NUM 16:38" />Pfetetso apfo pfiwa pfenzeluka ghendo, kwaaapfila iwanu wano tsawapfighala hambele hangu. Apfo upfisole pfetetso pfa wanu awo iwakomighwe kwa nzambi tsawo, pfihonde honde pfiwe pfisisili, kuya utengenetse chighubiko cha matsabahu, chiwe chitango cha kuwakanya Waisiraeli wose.” <verse eid="NUM 16:38" /><verse number="39" style="v" sid="NUM 16:39" />Apfo Eliazari kapfisola pfetetso apfo pfa shaba ipfighalighwe ham bayele he Imulungu na awala iwalakatsighwe na ghumoto, napfo pfihondighwa pfiwa chighubiko cha ichikong'o. <verse eid="NUM 16:39" /><verse number="40" style="v" sid="NUM 16:40" />Achino chitsakuwa chitango cha kuwakanya Waisiraeli, ka imunu wowose iyali si wa lukolo lwa Aruni yaleke kughenda kumdusulila upfumba IMNDEWA, hela katsokomighwa ka Kola ne wanu wake. Aghano tsaghatendeka ka IMNDEWA pfayamlongele Eleazari kubitila Musa.<verse eid="NUM 16:40" /></para>
  <para style="s">Aruni kowakombola iwanu</para>
  <para style="p">
    <verse number="41" style="v" sid="NUM 16:41" />Lekeni ilupfi yake iwanu wose wa Isiraeli wamsing'inikila Musa na Aruni, walonga, “Mwemwe muwakoma iwanu we Imulungu” <verse eid="NUM 16:41" /><verse number="42" style="v" sid="NUM 16:42" />Iwanu hawetingane kumsining'inikila Musa na Aruni, wahunduka walola kwalili Lihema Lienzeluke, na baho wona libingu lighubika Lihema, na ghumng'alo ghwe IMNDEWA ghwoneka. <verse eid="NUM 16:42" /><verse number="43" style="v" sid="NUM 16:43" />Musa na Aruni tsawaghenda, wema hambele ha Lihema Lienzeluke, <verse eid="NUM 16:43" /><verse number="44" style="v" sid="NUM 16:44" />baho IMNDEWA kamlongela Musa, <verse eid="NUM 16:44" /><verse number="45" style="v" sid="NUM 16:45" />“Mke mkale kutali ne iwanu wano, ili awo niwakomele lumwe.” Lekeni Musa na Aruni wafunama. <verse eid="NUM 16:45" /><verse number="46" style="v" sid="NUM 16:46" />Musa kamlongela Aruni, “Sola chetetso chako, wike ghamakala ighakwaka kulawa hane lisanduku la kulakatsila tsinambiko, na wike upfumba udusuke. Kuya utsume ughende kune ghumtingano ghwe iwanu, na kuko ukatende chihendo cha kuwalamlitsa iwanu. Kwaapfila imaya ye IMNDEWA ma ipfika na sambi utamu wihile wandusa kuwadununza.” <verse eid="NUM 16:46" /><verse number="47" style="v" sid="NUM 16:47" />Apfo Aruni kasola chitetso chake ka Musa pfayamlongele, katsuma kaghenda haghati ghati he ghumtingano, aku iwanu tsawanza kughaya, kadusula upfumba, na baho kawalamlitsa iwanu kwe Imulungu. <verse eid="NUM 16:47" /><verse number="48" style="v" sid="NUM 16:48" />Yeye tsakema haghatighati he wanu iwafile na wanu iwali waghima, na baho utamu ula wihile tsaumala. <verse eid="NUM 16:48" /><verse number="49" style="v" sid="NUM 16:49" />Iwanu iwafile kwa utamu awo ako tsawapfika elufu kumi na nne na miya saba, bila kuwapeta iwanu wala iwafile hamwe na Kola. <verse eid="NUM 16:49" /><verse number="50" style="v" sid="NUM 16:50" />Utamu'wo haumalile, Aruni koya kwayali Musa hane ghumlango ghwa Lihema Lienzeluke.<verse eid="NUM 16:50" /></para>
  <chapter eid="NUM 16" />
  <chapter number="17" style="c" sid="NUM 17" />
  <para style="s">Ing'weku ya Aruni</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 17:1" />IMNDEWA kamlongela Musa, <verse eid="NUM 17:1" /><verse number="2" style="v" sid="NUM 17:2" />“Uwalongele iwanu wa Isiraeli wangalile tsing'weku kumi na mbili, ng'weku imwe kwa chila chilongotsi wa kabila, na wandike chila taghwa lya chilongotsi mna ing'weku yake. <verse eid="NUM 17:2" /><verse number="3" style="v" sid="NUM 17:3" />Na wandike taghwa lya Aruni mna ing'weku kabila lya Walawi. Hobamighwa hawe na ng'weku imwe kwa chila chilongotsi wa kabila. <verse eid="NUM 17:3" /><verse number="4" style="v" sid="NUM 17:4" />Naghwe utsisole tsing'weku atso ukatsike hane Lihema Lienzeluke, aho hane lisanduku lya lilaghano, hanu hanitinganagha na ghweghwe. <verse eid="NUM 17:4" /><verse number="5" style="v" sid="NUM 17:5" />Ing'weku ye munu yanitsomsaghula itsotsuka, kwa kutenda apfo ukusing'inika kwa wanu wa Isiraeli kutsomala, wao kumsing'inikilani mwemwe.” <verse eid="NUM 17:5" /><verse number="6" style="v" sid="NUM 17:6" />Baho Musa kalonga na Waisiraeli, chila chilongotsi wao kaghala ing'weku yake, ing'weku imwe kwa chila kabila, natso tsipfika kumi na mbili. Na ing'weku ya Aruni nayo tsayamumo. <verse eid="NUM 17:6" /><verse number="7" style="v" sid="NUM 17:7" />Kuya Musa katsika tsing'weku atso hambele he IMNDEWA, hane Lihema Lienzeluke. <verse eid="NUM 17:7" /><verse number="8" style="v" sid="NUM 17:8" />Ilupfi yake nemitondo Musa kengila mna Lihema Lienzeluke, kaipfika ing'weku ila ya Aruni wa kabila lya Lawi itsuka, itula, isanula maluwa gha mlotsi na yima ghamatunda ghepfile. <verse eid="NUM 17:8" /><verse number="9" style="v" sid="NUM 17:9" />Kuya Musa katsisola tsing'weku tsose kulawa aho hambele he IMNDEWA, na katsika hambele ya Waisiraeli wose, nao watsilola, na chila chilongotsi kasola ing'weku yake. <verse eid="NUM 17:9" /><verse number="10" style="v" sid="NUM 17:10" />IMNDEWA kamlongela Musa, “Uyuitse ing'weku ya Aruni hambele ha lisanduku lya laghano, muike iwe chitango kwa wanu iwondema, ili kusing'inika kwawonising'inikila nene kumale, hela watsakufa.” <verse eid="NUM 17:10" /><verse number="11" style="v" sid="NUM 17:11" />Musa katenda ka IMNDEWA pfayamlaghitse. <verse eid="NUM 17:11" /><verse number="12" style="v" sid="NUM 17:12" />Waisiraeli wamlongela Musa, “Ulole lelo, twakufa, twohupa, twomala ghendo. <verse eid="NUM 17:12" /><verse number="13" style="v" sid="NUM 17:13" />Chila munu iyosoghela habehi na Lihema Lienzeluke kakufa, pfii ng'atutsomala wose baye?”<verse eid="NUM 17:13" /></para>
  <chapter eid="NUM 17" />
  <chapter number="18" style="c" sid="NUM 18" />
  <para style="s">Sang'ano tsa Iwatambika na Walawi</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 18:1" />Apfo IMNDEWA kamlongela Aruni, “Ghamatotso ghose ghawotenda iwanu hanu henzeluke ghendo ghatsakuwa ghako ghweghwe na wanagho na lukulo lwa aba wako, na ghamatotso ghose igholawila mna ing'onde ya ukutambika ghatsakuwa ghako ghweghwe na wanagho na lukolo lwako lwose. <verse eid="NUM 18:1" /><verse number="2" style="v" sid="NUM 18:2" />Pfipfila waghaleni ndughu tsenu wa kabila lya Lawi watse wamwapfileni ahala ghweghwe na wanagho hamsang'ana hambele ha Lihema Lienzeluke. <verse eid="NUM 18:2" /><verse number="3" style="v" sid="NUM 18:3" />Wao watsosang'ana tsing'onde tsautsoweng'a na atsila tsa lihema, lekeni waleke kupfisoghelela ipfinu pfose pfa hanu haenzeluke ghendo, wala ichikongo, hela watsakufa wao na mwemwe. <verse eid="NUM 18:3" /><verse number="4" style="v" sid="NUM 18:4" />Nawo wetselunga naghwe, na kukwapfila kusang'ana ng'onde tsose itsili mna Lihema Lienzeluke, na munu muhenza yaleke kuwasoghelela habehi. <verse eid="NUM 18:4" /><verse number="5" style="v" sid="NUM 18:5" />Mwemwe wenyegho mtsotenda tsing'onde tsa hanu haenzeluke ghendo na tsing'onde tsa hane matsabahu, hela imaya yangu ileke kuwalawila keli. <verse eid="NUM 18:5" /><verse number="6" style="v" sid="NUM 18:6" />Nene mwenyegho niwasaghula Walawi wayenu kulawa mna Waisiraeli wawe ka ghweko kuna mwemwe, wasang'ane ng'onde tsa Lihema Lienzeluke. <verse eid="NUM 18:6" /><verse number="7" style="v" sid="NUM 18:7" />Lekeni ghweghwe na wanagho mtsosang'ana ng'onde tsose tsa ukutambika tsa matsabahu, na pfose ipfili hanu haenzeluke ng'ani. Nomwing'ani ing'onde ino ya ukutambika ka ghweko. Imunu wowose iyali si mtambika baye yang'asoghelela habehi katsakomighwa.”<verse eid="NUM 18:7" /></para>
  <para style="s">Bughulu lya Iwatambika</para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 18:8" />IMNDEWA kamlongela Aruni, “Nikusaghula ghweghwe wimile ipfinu pfose pfawongaya Waisiraeli, pfose ipfenzeluke pfawongalila iwanu wa Isiraeli. Nokwing'a pfinu pfose ghweghwe na wanagho pfiwe bughulu lyenu, na apfo pfitsakuwa pfenu matsuwa ghose.” <verse eid="NUM 18:8" /><verse number="9" style="v" sid="NUM 18:9" />Ipfinu pfino pfenzeluke ghendo, apfila ing'apfilakatsighwa baye mmoto, apfo pfitsakuwa pfenu ka tsinambiko tsa usaghe, tsinambiko itsilapfighwa tsileghuse nzambi na tsinambiko tsa maliho itsilapfighwa tsileghuse matotso. Chila chinu iwanu chawondapfila chiwe nambiko yenzeluke, chakuwa chakwako na wanagho. <verse eid="NUM 18:9" /><verse number="10" style="v" sid="NUM 18:10" />Mpfije pfinu pfino ka pfinu pfenzeluke ng'ani, iwamale waliyeka wawo iwatsakuja, pfinu apfo pfenzeluka ghendo kuna mwemwe. <verse eid="NUM 18:10" /><verse number="11" style="v" sid="NUM 18:11" />Pfipfila pfinu pfingi pfose Waisiraeli pfawondapfila nene ka nambiko tsa kwinulighwa pfitsakuwa pfenu. Nokwing'a ghweghwe na wanagho wamale na wapinga pfiwe pfenu matsuwa ghose. Munu wowose iyelile mna ing'anda yako kodaha kuja pfinu apfo. <verse eid="NUM 18:11" /><verse number="12" style="v" sid="NUM 18:12" />Nokwing'a pfijo pfose ipfinoghile Waisiraeli pfawolimbula na kundapfila nene ka apfila ghamapfuta, idipfai na ingano. <verse eid="NUM 18:12" /><verse number="13" style="v" sid="NUM 18:13" />Chila chijo ichikwipfa iwanu chawolimbula mna imighunda na kungalila nene, chakuwa chako. Imunu wowose yelile mng'anda mwako kodaha kuja. <verse eid="NUM 18:13" /><verse number="14" style="v" sid="NUM 18:14" />Chila chinu ichibaghulighwe chilapfighwe kwe Imulungu mna isi ya Isiraeli, chose acho chitsakuwa chako. <verse eid="NUM 18:14" /><verse number="15" style="v" sid="NUM 18:15" />“Chila chipfughula inda, yawe we munu au we imnyama, chawomlapfila IMNDEWA, kakuwa wako. Lekeni kobamighwa umghombole imwana chaudele we munu na ayula we imnyama ing'ayelile baye. <verse eid="NUM 18:15" /><verse number="16" style="v" sid="NUM 18:16" />Pfipfughula inda awo woghombolighwa wang'awa na mwetsi ghumwe kulawa hawoneke, ulihe pfihande pfitano pfa fetsa, kwa kulola ipfinu pfa kulingila ipfili mna Lihema Lienzeluke. <verse eid="NUM 18:16" /><verse number="17" style="v" sid="NUM 18:17" />Lekeni iwopfughula inda we ng'ombe na we ng'olo, na ayula we imene waleke kughombolighwa, kwaapfila awo wenzeluka. Idamu yawo uimwaghe hane matsabahu na ghamapfuta ghao ughalakatse ghawe nambiko ya kulakatsighwa, na ukulakatsighwa ako kumnung'ila ghoya IMNDEWA. <verse eid="NUM 18:17" /><verse number="18" style="v" sid="NUM 18:18" />Inyama yawo yakuwa yenu, ka apfila ichidali na lihatsa lya mghulu wa kuchughu ghwa kujilo. <verse eid="NUM 18:18" /><verse number="19" style="v" sid="NUM 18:19" />Nitsokwing'a ghweghwe na wanagho wamale na wapinga ipfinu pfose pfawondapfila iwanu wa Isiraeli, liwe bughulu lyenu matsuwa ghose. Lilaghano lino lyanikwika na ghweghwe ne watsukulu wako litsokala matsuwa ghose.” <verse eid="NUM 18:19" /><verse number="20" style="v" sid="NUM 18:20" />IMNDEWA kamlongela Aruni, “Ghweghwe ng'utsobokela isi yoyose baye iwe yako wala ng'utsohangila nawo baye imali mna wao, nene yuyo libughulu lyako, naghwe kutsonihala nene kune iwana wa Isiraeli.”<verse eid="NUM 18:20" /></para>
  <para style="s">Bughulu lya Walawi</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 18:21" />Nawo Walawi niweng'a tsaka tsose tsawondapfila Waisiraeli tsiwe tsao. Agho maliho kwa sang'ano tsawosaang'ana tsa Lihema Lienzeluke. <verse eid="NUM 18:21" /><verse number="22" style="v" sid="NUM 18:22" />Kulawa sambi iwanu wa Isiraeli waleke kulisoghelela Lihema Lienzeluke, hela wotenda nzambi na wakufa. <verse eid="NUM 18:22" /><verse number="23" style="v" sid="NUM 18:23" />Lekeni Walawi waliyeka wawo iwobamighwa wasang'ane mna Lihema Lienzeluke, na totso ililawila amo, alyo lyenu. Ghumwiko ghuno ghutsakuwa ghwa ghamatsuwa ghose mna pfeleko pfenu pfose ipfikutsa. Nawo ng'awatsobokela isi yoyose baye iwe yao mna Waisiraeli, <verse eid="NUM 18:23" /><verse number="24" style="v" sid="NUM 18:24" />kwaapfila niweng'a tsaka tsose tsawondapfila Waisiraeli tsiwe nambiko ya kwinulighwa. Apfo tsaniwalongela, “Mna iwanu wa Isiraeli, mwemwe ng'amtsobokela isi yoyose baye iwe yenu.”<verse eid="NUM 18:24" /></para>
  <para style="s">Tsaka ya Walawi</para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 18:25" />Kuya IMNDEWA kamlongela Musa, <verse eid="NUM 18:25" /><verse number="26" style="v" sid="NUM 18:26" />Walongele Walawi pfino, “Hamtsobokela itsaka kulawa kwa Waisraeli yaniweng'ileni mwemwe iwe yenu, namwe mwobamighwa mumlapfile IMNDEWA tsaka kulawa mna tsitsaka atso tsambokele tsiwe nambiko. <verse eid="NUM 18:26" /><verse number="27" style="v" sid="NUM 18:27" />Inambiko ayo itsotogholighwa ka nambiko ila ya kulimbula ye pfijo au ka nambiko ya dipfai iyondapfila Muisiraeli yungi. <verse eid="NUM 18:27" /><verse number="28" style="v" sid="NUM 18:28" />Apfo mwobamighwa mumghalile IMNDEWA tsaka kulawa kuna tsisaka tsose tsambokela kulawa kwa Waisiraeli. Itsaka ayo yamndapfila nene mtsomwing'a mtambika Aruni. <verse eid="NUM 18:28" /><verse number="29" style="v" sid="NUM 18:29" />Mghalileni itsaka ibaghulighwe iwe ya IMNDEWA kulawa mna pifnu pfinoghile na pfenzeluke pfamwing'ighwe. <verse eid="NUM 18:29" /><verse number="30" style="v" sid="NUM 18:30" />Apfo uwalongele, ‘Hamtsonilapfila apfila ipfinoghile kubita pfose pfiwe nambiko, apfila ipfitsokala pfitsakuwa pfenu. Nene nitsomanya ka inambiko ayo ilawa mna pfijo pfenu wenyegho na ilawa mna dipfai yenu wenyegho. <verse eid="NUM 18:30" /><verse number="31" style="v" sid="NUM 18:31" />Namwe mtsakuja hanu hohose hala, mwemwe na iwanu wa mng'anda mwenu mwose, agho maliho ghenu kwa sang'ano yamtenda mna Lihema Lienzeluke. <verse eid="NUM 18:31" /><verse number="32" style="v" sid="NUM 18:32" />Ng'amtotsa baye mwemwe mng'aja pfinu apfo ka mumlapfila IMNDEWA ipfinu pfinoghile kubita pfose. Mleke kupfitenda pfiwe pfiha hambele he IMNDEWA pfinu apfo pfawondapfila Waisiraeli hela mtsakufa.’”<verse eid="NUM 18:32" /></para>
  <chapter eid="NUM 18" />
  <chapter number="19" style="c" sid="NUM 19" />
  <para style="s">Lipfu lya ng'ombe mdung'u</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 19:1" />IMNDEWA kamlongela Musa na Aruni, kalonga, <verse eid="NUM 19:1" /><verse number="2" style="v" sid="NUM 19:2" />Alino laghitso lyayatulaghitse IMNDEWA, Uwalongele Waisiraeli wakughalile ing'ombe pinga iyali mdung'u iyenelele na ng'ana yanduse ng'onde yo kulima. <verse eid="NUM 19:2" /><verse number="3" style="v" sid="NUM 19:3" />Namwe mmwing'e mtambika Eliazali ing'ombe ayo, naye yamsole na yamghale kunze kwe ndalo, na munu yumwe yamsubutule hambele hake. <verse eid="NUM 19:3" /><verse number="4" style="v" sid="NUM 19:4" />Kuya Mtambika Eliazali yaditse mna idamu ayo kwa chidole chake, na yaimitse mala saba, kwakulola ubali wa hambele we Lihema lienzeluke. <verse eid="NUM 19:4" /><verse number="5" style="v" sid="NUM 19:5" />Ing'ombe ayo yalakatsighwe aku Imtambika kolola, chila chinu chake chitsolakatsighwa, iwe ngotsi, inyama, idamu au iwe mipfi yake. <verse eid="NUM 19:5" /><verse number="6" style="v" sid="NUM 19:6" />Kuya Imtambika yasole lubiki lwa mweletsi, putila lya hisopo, na nyutsi ndung'u, yapfase mna ghumoto aghwo ighumlakatsa ing'ombe. <verse eid="NUM 19:6" /><verse number="7" style="v" sid="NUM 19:7" />Kuya mtambika yatsapfe maghwanda ghake, na yoghe mmatsi, kuya kodaha kwingila kune ndalo. Naye imtambika katsakuwa keha hambele he Imulungu mbaka nemihe. <verse eid="NUM 19:7" /><verse number="8" style="v" sid="NUM 19:8" />Na imunu iyamlakatse ing'ombe ayo naye yatsapfe magwanda ghake na yoghe mmatsi, naye katsakuwa keha hambele he Imulungu mbaka nemihe. <verse eid="NUM 19:8" /><verse number="9" style="v" sid="NUM 19:9" />Imunu yelile yatsole ilipfu lye ng'ombe ayo, na yalyike ghoya hanu hanoghile kunze mwe ndalo, yawekile Waisiraeli lipfu alyo, nawo watsolihanganya ne ghamatsi, nagho ghakuwa matsi gha kuleghusila inzambi ghumtingano ghwose ghwa Isiraeli. <verse eid="NUM 19:9" /><verse number="10" style="v" sid="NUM 19:10" />Imunu iyotsola ilipfu alyo yatsapfe ghamagwanda ghake, naye katsakuwa keha hambele he Imulungu mbaka nemihe. Laghitso lino liwe lya matsuwa ghose kwa wanu wa Isiraeli, na kwa imhenza iyokala nawo.<verse eid="NUM 19:10" /></para>
  <para style="s">Malaghitso gha ukuwatenda wele</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 19:11" />Imunu yang'akinda lukuli lwa munu yafile kakuwa keha kwa matsuwa saba. <verse eid="NUM 19:11" /><verse number="12" style="v" sid="NUM 19:12" />Naye yehopfughe mna litsuwa lya kadatu na lya saba kwa ghamatsi ghagho ghokuleghusila nzambi, na baho kakuwa kela. Lekeni ka ng'ehopfugha baye mna litsuwa lya kadatu na lya saba, ayo kakuwa keha. <verse eid="NUM 19:12" /><verse number="13" style="v" sid="NUM 19:13" />Imunu wowose iyokinda lukuli lwa munu yafile, naye ng'ehopfugha baye, imunu ayo kolitenda Lihema lya IMNDEWA lihe, ayo yabaghulighwe yakale kutali na wanu Waisiraeli. Munu ayo keha ghendo kwaapfila ng'awammitsile baye ghamatsi ghala gho kuleghusila nzambi.<verse eid="NUM 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 19:14" />Mtende chihendo chino ahala imunu yang'afila mghati mwe chibumbulika, imunu wowose iyakwingila na ayula iyali mumo ahala imunu hayafile, munu ayo katsakuwa keha hambele he Imulungu kwa ghamatsuwa saba. <verse eid="NUM 19:14" /><verse number="15" style="v" sid="NUM 19:15" />Chiya chochosse chili mwatsi, ichilihela chighubiko, acho nacho chakuwa chiha. <verse eid="NUM 19:15" /><verse number="16" style="v" sid="NUM 19:16" />Imunu wowose iyokinda lukuli lwa munu iyakomighwe au ayula iyafile mwenyegho kunze kune mighunda, au yang'akinda imipate ye munu au likabuli, munu ayo keha kwa ghamatsuwa saba. <verse eid="NUM 19:16" /><verse number="17" style="v" sid="NUM 19:17" />Kwa ajili ya iwanu awo wehile watsosola ilipfu lye ing'ombe yula mdung'u iyalakatsighwe yaleghuse tsinzambi, lipfu alyo yalihanganye ne ghamatsi gha kumto ighali mchiya. <verse eid="NUM 19:17" /><verse number="18" style="v" sid="NUM 19:18" />Imunu yelile katsosola putila, na yaliditse mna ghamatsi agho, kuya yachimitsile chibumbulika, pfiya pfose pfili mghati mwe chibumbulika na wanu wose iwali mghati amwo. Pfipfila yammitsile imunu iyakindile imipate ye munu au iyakindile ilukuli lwa imunu iyakomighwe au wa munu iyafile mwenyegho au iyalikindile likabuli. <verse eid="NUM 19:18" /><verse number="19" style="v" sid="NUM 19:19" />Imunu yelile katsommitsila imunu yehile mna litsuwa lya kadatu na lya saba, apfo mna litsuwa lya saba imunu kakuwa kela, naye yatsapfe ghamagwanda ghake na yoghe mna ghamatsi, na nemihe haipfika kakuwa kela. <verse eid="NUM 19:19" /><verse number="20" style="v" sid="NUM 19:20" />Lekeni ka imunu ayo yehile ng'ehopfugha baye, ayo yabaghulighwe yakale kutali na mtingano wa wanu wa Isiraeli, kwaapfila kalitenda Lihema lya lihe. Kwaapfila ng'emitsile baye mwenyegho ghamatsi ghala igholeghusa inzambi, apfo keha. <verse eid="NUM 19:20" /><verse number="21" style="v" sid="NUM 19:21" />Alino litsakuwa laghitso lyao lya ghamatsuwa ghose. “Imunu iyomitsa ghamatsi gho kuleghusila nzambi naye yatsapfe ghamagwanda ghake, na ayula iyokinda ghamatsi agho kakuwa keha hambele he Imulungu mbaka nemihe. <verse eid="NUM 19:21" /><verse number="22" style="v" sid="NUM 19:22" />Na chinu chochose chayokinda munu yehile nacho chakuwa chiha, na imunu yungi wowose iyochikinda ichinu acho, naye kakuwa keha mbaka nemihe.”<verse eid="NUM 19:22" /></para>
  <chapter eid="NUM 19" />
  <chapter number="20" style="c" sid="NUM 20" />
  <para style="s">Ghamatsi gholawa mbambalawe</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 20:1" />Kuya ghumtingano ghwose ghwe iwanu wa Isiraeili ghupfika mna inyika ya Sini mna ghumwetsi ghwa mwanduso, nawo weka indalo yawo ako Kadeshi. Hawang'ali wakuko, Miriamu tsakafa na wamtsika kuko. <verse eid="NUM 20:1" /><verse number="2" style="v" sid="NUM 20:2" />Ihanu hawekile indalo tsahaduhu matsi, apfo iwanu wose wetingana hamwe hambele ha Musa na Aruni. <verse eid="NUM 20:2" /><verse number="3" style="v" sid="NUM 20:3" />Baho iwanu wesonga na Musa na Aruni, walonga, “Ng'apfu ghendo tung'afile hamwe na ndughu tsetu hambele ha Lihema lye IMNDEWA. <verse eid="NUM 20:3" /><verse number="4" style="v" sid="NUM 20:4" />Ule mwemwe mghughala ghumtingano ghwe IMNDEWA mna inyika ino? Mtughala kuno tufe na hamwe na mipfugho yetu. <verse eid="NUM 20:4" /><verse number="5" style="v" sid="NUM 20:5" />Ebali mwemwe mtulapfa mna isi ya Misili na mtughala hanu hano hakame? Haduhu hanu ho kuhanda ingano wala itini wala makomamanga. Kuduhu ghamatsi gho kunwa twetwe” <verse eid="NUM 20:5" /><verse number="6" style="v" sid="NUM 20:6" />Lelo Musa na Aruni woka hanu haghuli ghumtingano ghwe iwanu, na waghenda hane ghumlango ghwa Lihema Lienzeluke, wafunama mbaka pfihanga pfao pfidonza hasi, Baho ghumng'alo ghwe Imulungu ghuwalawila. <verse eid="NUM 20:6" /><verse number="7" style="v" sid="NUM 20:7" />IMNDEWA kamlongela Musa, <verse eid="NUM 20:7" /><verse number="8" style="v" sid="NUM 20:8" />“Sola ing'weku yako iili hane lisanduku lya laghano, kuya ghweghwe na ndughu yako Aruni, muwalongele Waisiraeli wetingane hamwe, naghwe ulilongele libambalawe lilapfe ghamatsi aku wolola kwa tsinenge tsawo wenyegho. Apfo kutsowalapfila ghamatsi kulawa kune libambalawe na uwanwese iwanu wose iwetingane hamwe wa Waisiraeli, hamwe na mifugho yawo.” <verse eid="NUM 20:8" /><verse number="9" style="v" sid="NUM 20:9" />Apfo Musa kaghenda kuisola ing'weku ila hambele ha IMNDEWA ka pfayalaghitsighwe. <verse eid="NUM 20:9" /><verse number="10" style="v" sid="NUM 20:10" />Musa na Aruni wawalongela Waisiraeli iwetingane hamwe hambele ha libambalawe, naye Musa kawalongela, Lelo tegheletseni, mwemwe imtulema, angu tuwalapfileni ghamatsi kulawa mna libambalawe lino? <verse eid="NUM 20:10" /><verse number="11" style="v" sid="NUM 20:11" />Kuya Musa kenula ghumoko ghwake na kalitowa libambalwe mala mbili, ghamatsi ghalawa mengi, ghumtingano ghwose ghwe wanu ghunwa na mifugho yawo nayo inwa. <verse eid="NUM 20:11" /><verse number="12" style="v" sid="NUM 20:12" />IMNDEWA kamlongela Musa na Aruni, “Kwaapfila mwemwe ng'amnitoghole nene baye, na ng'amndekile nilanguse ngupfu tsangu kwa Waisiraeli, wala ng'amnitendile baye mboneke nyenzeluka hambele he tsinenge tsa wanu wa Isiraeli, apfo mwemwe ng'amtsoghughala baye ghumtingano ghuno ghwe wanu kune isi yaniweng'ile.” <verse eid="NUM 20:12" /><verse number="13" style="v" sid="NUM 20:13" />Ghamatsi ghano matsi gha Meriba, kwaapfila iwanu wa Isiraeli tsawesonga na Imulungu, naye kelangusa kenzeluka mna wao.<verse eid="NUM 20:13" /></para>
  <para style="s">Mfalume wa Edomu kowaghoma Waisiraeli waleke kubita</para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 20:14" />Kuya Musa katuma iwanu kulawa Kadeshi, waghende kwa mfalume wa Edomu, na kamlongela “Ghweghwe koghamanya twetwe ndughu tsako Waisiraeli ghamaghayo ghose ghatughanzike, <verse eid="NUM 20:14" /><verse number="15" style="v" sid="NUM 20:15" />apfila wahenga wetu pfawahulumke na kughenda Misiri, na twetwe tukala ako miyaka mingi. Wamisiri tsawatutendela ghehile ng'ani, twetwe na aba tsetu, <verse eid="NUM 20:15" /><verse number="16" style="v" sid="NUM 20:16" />tumlilila IMNDEWA, naye katuhulika, kamtuma imalaika katsa kutulapfa Misiri, na twetwe twahano Kadeshi, ghumji ighubakane na isi yako. <verse eid="NUM 20:16" /><verse number="17" style="v" sid="NUM 20:17" />Lelo tokulomba utulekelele tubite mna isi yako. Ng'atutsobita mna imughunda yenu baye wala ahila ya mitsabibu, wala ng'atukunwa baye ghamatsi gha pfisima pfenu. Tutsowinza nzila ng'ulu ya mfalume, na tutsolumbilila bila kubaghuka kujilo wala kumoso mbaka hatutsolawa mna isi yako.” <verse eid="NUM 20:17" /><verse number="18" style="v" sid="NUM 20:18" />Lekeni imfalume wa Edomu kawedika, “Baye, ng'amtsobita baye mna isi yangu, na ka mobita nitsolawa na kuwatowa.” <verse eid="NUM 20:18" /><verse number="19" style="v" sid="NUM 20:19" />Waisiraeli wamwidika, “Twetwe tutsowinza nzila ng'ulu. Ka imifugho yetu ing'anwa ghamatsi ghenu, twetwe tutsoliha, chatulomba utulekelele tubite kwa ghamaghulu ghetu wala ng'atubama chinu chingi baye.” <verse eid="NUM 20:19" /><verse number="20" style="v" sid="NUM 20:20" />Mndewa wa Edomu kawedika keli, “Ng'atuwalekelela mwang'e baye.” Na baho, Waedomu wane ngupfu walawa waghenda kwitowa nawo. <verse eid="NUM 20:20" /><verse number="21" style="v" sid="NUM 20:21" />Apfo Waedomu tsawalema kuwalekelela Waisiraeli wang'e mna isi yawo, Waisiraeli wahunduka kwang'a nzila ingi.<verse eid="NUM 20:21" /></para>
  <para style="s">Aruni kakufa</para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 20:22" />Waisiraeli wose tsawalawa Kadeshi, na wapfika kuchidunda Hori ichili mna ghumbaka ghwa Edomu. <verse eid="NUM 20:22" /><verse number="23" style="v" sid="NUM 20:23" />IMNDEWA kamlongela Musa na Aruni kune chidunda cha Hori. <verse eid="NUM 20:23" /><verse number="24" style="v" sid="NUM 20:24" />“Aruni katsakufa, ng'atsakwingila baye mna isi yaniweng'ile Waisiraeli, kwaapfila mwemwe weli tsamlema kulikinda laghitso lyangu akula Meriba. <verse eid="NUM 20:24" /><verse number="25" style="v" sid="NUM 20:25" />Umsole Aruni na mwanaghe Eliazali uwaghale akuno kuchanya kune chidunda cha Hori. <verse eid="NUM 20:25" /><verse number="26" style="v" sid="NUM 20:26" />Kuya umtsule Aruni magwanda ghake gho kutambikila, na umpfatse mwanaghe Eliazali. Aruni katsakufila kuchidunda.” <verse eid="NUM 20:26" /><verse number="27" style="v" sid="NUM 20:27" />Musa tsakatenda ka IMNDEWA pfayamlaghitse. Wose wadatu wagheluka kuchidunda aku iwanu wose wowalola. <verse eid="NUM 20:27" /><verse number="28" style="v" sid="NUM 20:28" />Kuko Musa kamtsula Aruni maghwanda ghake gho kutambikila, kampfatsa imwanaghe Eliazali, na Aruni kafa kuko kuhanu ha ukutambikila kwe chidunda. Kuya Musa na Eliazali wahulumka kulawa kuchidunda. <verse eid="NUM 20:28" /><verse number="29" style="v" sid="NUM 20:29" />Ghumtingano ghwose ghwa iwanu haghuhulike ka Aruni kafa, iwani wose wa Isiraeli tsawadomboketsa kwa matsuwa selasini.<verse eid="NUM 20:29" /></para>
  <chapter eid="NUM 20" />
  <chapter number="21" style="c" sid="NUM 21" />
  <para style="s">Waisirael wowatowa Wakanani</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 21:1" />Na mfalume yumwe Mkanani wa isi ya Aladi iyakalile ubali wa kusini wa Kanaani, hayahulike ka Waisiraeli wakutsa kwa kwang'ila inzila ya Atarimu, kaghenda kwitowa na Waisiraeli, kawaghogha wamwenga wao na koka nawo. <verse eid="NUM 21:1" /><verse number="2" style="v" sid="NUM 21:2" />Baho Waisiraeli welighita kwe IMNDEWA, walonga, “Ka ghweghwe kutsotwapfila tuwatowe iwanu wano, twetwe tutsoghenda kuihinya imiji yawo kwaajili yako.” <verse eid="NUM 21:2" /><verse number="3" style="v" sid="NUM 21:3" />IMNDEWA kahulika chililo chawo, naye kawapfila, wawakoma na kuihinya ghendo imiji yawo. Apfo hanu aho tsahakemighwa Horima.<verse eid="NUM 21:3" /></para>
  <para style="s">Inzoka wa shaba</para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 21:4" />Waisiraeli tsawoka kulawa chidunda Hori na wang'ila inzila ya bahali ya shamu ili waitsunguluke isi ya Edomu. Lekeni mnzila iwanu watenyuka ghumoyo. <verse eid="NUM 21:4" /><verse number="5" style="v" sid="NUM 21:5" />Wanza kumsing'inikila Imulungu na Musa, walonga, “Ebali mwemwe mtulapfile mna isi ya Misiri tutse tufile akuno kunyika? Kwaapfila hano haduhu ichijo wala haduhu ghamatsi, na chijo chino twetwe chitubwikitsa” <verse eid="NUM 21:5" /><verse number="6" style="v" sid="NUM 21:6" />IMNDEWA kaghala iwanzoka wane isumu mna iwanu, nawo wawaluma na Waisiraeli wengi tsawafa. <verse eid="NUM 21:6" /><verse number="7" style="v" sid="NUM 21:7" />Iwanu wamghendelela Musa, na wamlongela, “Tutenda nzambi ghendo, kwaapfila tsatumlonga pfihile Imulungu na ghweghwe, utulombele kwe IMNDEWA yawasoghetse iwanzoka wano.” Apfo Musa kawalombela iwanu. <verse eid="NUM 21:7" /><verse number="8" style="v" sid="NUM 21:8" />Naye IMNDEWA kamlongela Musa, “Utende nzoka wa shaba, na umkondeke mna libiki yalebele. Na munu wowose iyolumighwa ne nzoka, yang'amlola inzoka ayo, katsohona.” <verse eid="NUM 21:8" /><verse number="9" style="v" sid="NUM 21:9" />Apfo Musa kafina inzoka we shaba, na kamkondeka mna libiki. Chila munu iyalumighwe ne nzoka hayamlolile inzoka ayo, tsakahona.<verse eid="NUM 21:9" /></para>
  <para style="s">Waisiraeli wopfika Moabu</para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 21:10" />Waisiraeli waghendelelela na ghumwanza ghwao, nao weka indalo yao mna isi ya Oboti. <verse eid="NUM 21:10" /><verse number="11" style="v" sid="NUM 21:11" />Woka hanu aho na waghenda ukwika indalo yao hanu hokemighwa Iye Abarimu, iili mna inyika iilolesa Moabu, ubali wa kwalilawila litsuwa. <verse eid="NUM 21:11" /><verse number="12" style="v" sid="NUM 21:12" />Woka hanu aho na waghenda kune chiwala cha Zeredi, na kuko weka indalo yawo. <verse eid="NUM 21:12" /><verse number="13" style="v" sid="NUM 21:13" />Kulawa aho waghenda kune ghumto ghwa Arinoni, ighulapfa ghamatsi mna is Waamoli na kwang'ila kunyika. Ghumto agho tsaghwamna ghumbaka wa Wamoabu na Waamoli ilili ubali wa kulawila litsuwa, kuko weka indalo yao. <verse eid="NUM 21:13" /><verse number="14" style="v" sid="NUM 21:14" />Apfo yandikighwa mna chitabu cha ing'ondo cha IMNDEWA, “Ghumji ghwa Wahebu ighuli mna isi ya Sufa na lwanda lwa Arinon, <verse eid="NUM 21:14" /><verse number="15" style="v" sid="NUM 21:15" />na mhulumko ghwa lwanda alwo ighuhulumkila mna ghumji ghwa Ari, na kughenda kune ghumbaka ghwa Moabu.” <verse eid="NUM 21:15" /><verse number="16" style="v" sid="NUM 21:16" />Kulawa ako Waisiraeli waghendelela na ghumwanza ghwao mbaka wapfika Beeri, acho chisima IMNDEWA chayamlongele Musa, “Uwatinganitse iwanu hamwe na nene nitsoweng'a ghamatsi.” <verse eid="NUM 21:16" /><verse number="17" style="v" sid="NUM 21:17" />Kuya Waisiraeli wemba wila uno,</para>
  <para style="q" vid="NUM 21:17">“Ghwe chisima, ulapfe ghamatsi, Lelo mchimbile!<verse eid="NUM 21:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="NUM 21:18" />Chisima chawahimbile wakulu,</para>
  <para style="q" vid="NUM 21:18">chisima chawachifukule wakulu we wanu,</para>
  <para style="q" vid="NUM 21:18">kwa ng'weku tsao tsa ukulu na tsing'weku tsao tso kwangila.”</para>
  <para style="p" vid="NUM 21:18">Kulawa kune inyika tsawoka mbaka wapfika Matana, <verse eid="NUM 21:18" /><verse number="19" style="v" sid="NUM 21:19" />na kulawa Matana tsawaghenda Nahalieli, na kulawa Nahalieli tsawaghenda Bamothi, <verse eid="NUM 21:19" /><verse number="20" style="v" sid="NUM 21:20" />na kulawa Bamothi waghenda kune ulwanda ulukwingila mna isi ya Moabu, hane hanu ha ukutambikila cha chidunda Pisiga, ichilola kuhisi mwenyika.<verse eid="NUM 21:20" /></para>
  <para style="s">Waisilaeli wowahuma wafalumea Sihoni na Ogi</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 21:21" />Iwanu wa Isiraeli tsawatuma wanu waghende kwa mfalume Sihoni wa Waamori, wakamlongele pfino, <verse eid="NUM 21:21" /><verse number="22" style="v" sid="NUM 21:22" />“Utulelekelele twang'e mna isi yako, hatutsobaghuka baye wala kwingila mna mighunda yenu au mighunda yenu ya mitsabibu, na ng'atukunwa baye ghamatsi gha pfisima pfenu, twolumbilila kwa kwang'a mna inzila ng'ulu ye imfalume mbaka hatulawa mna isi yako.” <verse eid="NUM 21:22" /><verse number="23" style="v" sid="NUM 21:23" />Lekeni mfalume Sihoni ng'atoghole baye kuwaleka Waisiraeli wabite mna isi yake. Apfo kawakema iwanu wake wetingane hamwe, kaghenda nawo Yahasa ili mnyika na kuko ketowa na Waisiraeli. <verse eid="NUM 21:23" /><verse number="24" style="v" sid="NUM 21:24" />Lekeni Waisiraeli wamkoma kwa kumsubutula na lipanga, waisola isi yake kulawa mto ghwa Arinoni mbaka mto ghwa Yaboki, mbaka isi ya Waamoni, Ghumbaka ghwa isi ya Amoni tsaghung'ali ghukalitsighwa sideke. <verse eid="NUM 21:24" /><verse number="25" style="v" sid="NUM 21:25" />Waisiraeli waisola imiji yawo yose na wakala mna imiji yose ya Waamori mna Hesiboni, na kaye tsake tsose. <verse eid="NUM 21:25" /><verse number="26" style="v" sid="NUM 21:26" />Hesiboni tsaghumji ghwake Sihoni mfalume wa Waamori, yeye tsaketowa na mfalume wa Moabu na kamboka isi yake yose mbaka kolongo Arnoni. <verse eid="NUM 21:26" /><verse number="27" style="v" sid="NUM 21:27" />Apfo iwanu wa ghumwande tsawemba wila uno,</para>
  <para style="q" vid="NUM 21:27">“Itsani Hesiboni na tutsenge,</para>
  <para style="q" vid="NUM 21:27">ghumji kwa Sihoni ghutsengighwe keli.<verse eid="NUM 21:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="NUM 21:28" />Kwaapfila ghumoto tsaghulawa Hesiboni,</para>
  <para style="q" vid="NUM 21:28">na milambi ya ghumoto ilawa mna ghumji ghwa Sihoni,</para>
  <para style="q" vid="NUM 21:28">na ilakatsa ghumji gha Ari wa Moabu,</para>
  <para style="q" vid="NUM 21:28">na ilakatsa pfidunda pfa ghumto ghwa Arinoni.<verse eid="NUM 21:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="NUM 21:29" />Mtsochona mwemwe iwanu wa Moabu,</para>
  <para style="q" vid="NUM 21:29">Mkomighwa, mwemwe wanu yamtambikila imulungu Kemoshi!</para>
  <para style="q" vid="NUM 21:29">Kawatenda wanenu wamale watsumile kuna isi tsingi,</para>
  <para style="q" vid="NUM 21:29">na wanenu mapinga waghoghighwa</para>
  <para style="q" vid="NUM 21:29">na waghalighwa kwa Sihoni,</para>
  <para style="q" vid="NUM 21:29">mfalume wa Amori.<verse eid="NUM 21:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="NUM 21:30" />Lekeni sambi watsukulu wao tuwakoma,</para>
  <para style="q" vid="NUM 21:30">kulawa Hesiboni mbaka Diboni,</para>
  <para style="q" vid="NUM 21:30">kulawa Nasimu mbaka Nofa, habehi na Medeba.”<verse eid="NUM 21:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 21:31" />Apfo Waisiraeli tsawakala mna isi ya Waamori. <verse eid="NUM 21:31" /><verse number="32" style="v" sid="NUM 21:32" />Kuya Musa katuma wanu waghende kughupelemba ghumji ghwa Yazeli ghuli pfihi, awo waghuboka hamwe na pfijiji pfake, na wawawinga Waamori iwakalile aho. <verse eid="NUM 21:32" /><verse number="33" style="v" sid="NUM 21:33" />Waisiraeli wahunduka waghenda ubali wa kasikazini na wakololetsa inzila ighenda Bashani. Mfalume Ogu wa Bashani na wanu wake walawa waghenda kwitowa nawo ako Edirei. <verse eid="NUM 21:33" /><verse number="34" style="v" sid="NUM 21:34" />Lekeni IMNDEWA kamlongela Musa. “Uleke kumpfuka, kwaapfila nene nitsokwapfila umtowe yeye na wanu wake wose na isi yake yose, na umtende ka pfaumtendile mfalume Sihoni wa Waamori iyakalile mna isi ya Heshiboni.” <verse eid="NUM 21:34" /><verse number="35" style="v" sid="NUM 21:35" />Apfo Waisiraeli wamkoma mfalume Ogu, ne wanaghe ne wanu wake wose, tsakuduhu munu iyalekighwe mghima. Na waisola isi yake iwa yawo.<verse eid="NUM 21:35" /></para>
  <chapter eid="NUM 21" />
  <chapter number="22" style="c" sid="NUM 22" />
  <para style="s">Balaamu kokemighwa na mfalume Balaki</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 22:1" />Waisiraeli wanza keli ghumwanza ghwao, na waghenda kwika indalo yawo mna chiwala cha Moabu, kumwambu kwa Yolidani habehi na Yeriko. <verse eid="NUM 22:1" /><verse number="2" style="v" sid="NUM 22:2" />Na mfalume Balaki mwana wa Sipoli, tsakamanya ghose Waisiraeli ghawawatendele Waamoli. <verse eid="NUM 22:2" /><verse number="3" style="v" sid="NUM 22:3" />Yeye hamwe na Wamoabu wose tsawawapfuka sideke Waisiraeli. Tsawawapfuka kwaapfila tsawawengi ng'ani. <verse eid="NUM 22:3" /><verse number="4" style="v" sid="NUM 22:4" />Apfo Wamoabu wawalongela pfilongotsi wa Midiani, “Makingili ghano ghe wanu sambi baha ghatsohinya chila chinu ichitutsunguluka ka apfila ing'ombe mmale pfayakuja imitsani mna ghumghunda.” Balaki mwana wa Sipoli, tsakakala yuyo imfalume wa Moabu matsuwa agho, <verse eid="NUM 22:4" /><verse number="5" style="v" sid="NUM 22:5" />katuma wanu waghende kwa Balamu, mwana wa Beori ako Petoli, habehi na ghumto ghwa Efulati ighuli mna isi ya Amawi. Kamlongela Balamu pfino, “Kuna wanu walawa Misiri, na wenela chila hanu muisi, na wosoghela watse wasole isi yangu. <verse eid="NUM 22:5" /><verse number="6" style="v" sid="NUM 22:6" />Lelo utse, undighitile wanu wano, kwaapfila wao wana ngupfu kubita nene, songaha nodaha kuwatowa na kuwawinga woke muisi. Nene nomanya ghweghe haumotetsa iwanu, nawo womotetsighwa na haulighita iwanu, nawo wolighitighwa.” <verse eid="NUM 22:6" /><verse number="7" style="v" sid="NUM 22:7" />Apfo pfilongotsi wa Moabu na Midiani woka waghenda kwa Balamu, aku wasola tsisendi tso kumliha yawalaghulile. Wapfika na wamlongela chayolonga Balaki. <verse eid="NUM 22:7" /><verse number="8" style="v" sid="NUM 22:8" />Balamu kawalongela, “Chilo chino muwase kuno, na nene nitsowalongela chayatsonongela IMNDEWA.” Apfo pfilongotsi awo wa Moabu wakala na Balamu. <verse eid="NUM 22:8" /><verse number="9" style="v" sid="NUM 22:9" />Kuya Imulungu kamghendela Balamu, kamghutsa, “Awano waukala nawo tsina nani?” <verse eid="NUM 22:9" /><verse number="10" style="v" sid="NUM 22:10" />Balamu kamwidika Imulungu, kalonga, “Balaki mwana wa Sipoli katuma wanu watse wanongele pfino, <verse eid="NUM 22:10" /><verse number="11" style="v" sid="NUM 22:11" />‘Kuna wanu wengi walawa Misiri, nawo wenela chila hanu muisi. Lelo nokulomba, utse uwalighite iwanu awo songaha nodaha kwitowa nawo na kuwawinga.’” <verse eid="NUM 22:11" /><verse number="12" style="v" sid="NUM 22:12" />Imulungu kamlongela Balamu, “Uleke kughenda nawo iwanu wano, na uleke kuwalighita iwanu awo kwaapfila awo wamotetsighwa.” <verse eid="NUM 22:12" /><verse number="13" style="v" sid="NUM 22:13" />Apfo nemitondo Balamu koka, kawalongela pfilongotsi wa Balaki, “Muye mna isi yenu, kwaapfila Imulungu kalema kunileka nighende na mwemwe.” <verse eid="NUM 22:13" /><verse number="14" style="v" sid="NUM 22:14" />Pfilongotsi wa Moabu woka, nawo woya kwa Balaki, wamlongela, “Balamu kalema kutsa na twetwe.”<verse eid="NUM 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 22:15" />Kuya Balaki katuma pfilongotsi wangi, nawo tsawengi ng'ani, na tsawana ukulu kubita awala wa mwanduso. <verse eid="NUM 22:15" /><verse number="16" style="v" sid="NUM 22:16" />Nawo tsawapfika kwa Balamu, wamlongela, “Balaki mwana Sipoli kolonga pfino, ‘Chinu chochose chileke kukutenda uleke kutsa kuna nene,’ <verse eid="NUM 22:16" /><verse number="17" style="v" sid="NUM 22:17" />Nitsokutenda utunyighwe, na chochose chaunilomba nitsotenda, lelo utse undighitile iwanu wano.” <verse eid="NUM 22:17" /><verse number="18" style="v" sid="NUM 22:18" />Lekeni Balamu kawedika iwatumighwa wa Balaki, “Hata ka Balaki katsongaya ing'anda yake imema fetsa na nzahabu, nene sitenda chinu chochose baye kubita achila chayandaghitse IMNDEWA, Imulungu wangu, sihungutsa baye wala sikongetsa baye. <verse eid="NUM 22:18" /><verse number="19" style="v" sid="NUM 22:19" />Namwe mkale hano chilo chino, songaha nodaha kumanya IMNDEWA yonongela choni keli.” <verse eid="NUM 22:19" /><verse number="20" style="v" sid="NUM 22:20" />Apfo Imulungu kamtsila Balamu chilo chicho, kamlongela, “Kwaapfila iwanu wano watsa kukukema, ghenda nawo, lekeni utende achila chanikulongela.”<verse eid="NUM 22:20" /></para>
  <para style="s">Balamu na chihongwe wake</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 22:21" />Balamu kalamka nemitondo, keka chinu cho kukalila mchanya mwe ichihongwe wake, kadina, na kaghenda na pfilongotsi awo wa Moabu. <verse eid="NUM 22:21" /><verse number="22" style="v" sid="NUM 22:22" />Imulungu tsakona maya kwaapfila Balamu katoghola kaghenda, apfo imalaika we Imulungu tsaketingana naye mnzila. Lelo Balamu tsakadina mna ichihongwe wake, naye tsakelongotsa na iwatumwa wake weli. <verse eid="NUM 22:22" /><verse number="23" style="v" sid="NUM 22:23" />Apfo ichihongwe yula tsakamwona imalaika we IMNDEWA kema mnzila aku kakinda limaghe lisomwolighwe mna iyala, ichihongwe kabaghuka, kaghenda mmbalimbali mwe nzila. Balamu kamlapula ichihongwe ayo yoye mnzila. <verse eid="NUM 22:23" /><verse number="24" style="v" sid="NUM 22:24" />Kuya imalaika we IMNDEWA tsakalongola hambele, tsakema hanu hasisili he nzila, mna imighunda ya minzabibu, na chila ubali tsakuna ngema. <verse eid="NUM 22:24" /><verse number="25" style="v" sid="NUM 22:25" />Ichihongwe hayamwonile Imalaika ayo we IMNDEWA, kekunughitsa kune ingema, na kaghubanaghitsa mghulu ghwa Balamu mna ingema. Balamu kamlapula keli ichihongwe. <verse eid="NUM 22:25" /><verse number="26" style="v" sid="NUM 22:26" />Kuya Imalaika we IMNDEWA kalongola keli hambele, kema hanu hasisili ng'ani he nzila, na tsahaduhu hanu ha kubaghukila kujilo wala kumoso. <verse eid="NUM 22:26" /><verse number="27" style="v" sid="NUM 22:27" />Ichihongwe hayamwonile imalaika ayo, kafughama. Balamu kona maya kamlapula ichihongwe ayo na ing'weku yake. <verse eid="NUM 22:27" /><verse number="28" style="v" sid="NUM 22:28" />Baho IMNDEWA katenda lidomo lye wa ichihongwe ayo lilonge, kamlongela Balamu, “Chanikutendile choni mbaka unilapule mala ndatu?” <verse eid="NUM 22:28" /><verse number="29" style="v" sid="NUM 22:29" />Balamu kamlongela ichihongwe, “Ghweghwe kunibetsa, ka ning'awile na limaghe ning'akukomile sambi baha.” <verse eid="NUM 22:29" /><verse number="30" style="v" sid="NUM 22:30" />Ichihongwe kamwidika Balamu, “Angu nene si chihongwe wako baye? Naghwe kunidina ughima wako wose mbaka leloli, pfii tsa ma nikutendela chinu ka achino?” Balamu kedika, “Baye.” <verse eid="NUM 22:30" /><verse number="31" style="v" sid="NUM 22:31" />Baho IMNDEWA kafumbula tsinenge tsa Balamu, naye kamwona Imalaika we IMNDEWA kema mnzila, aku kakinda limaghe ilisomolighwe mna yala yake. Baho Balamu kenama ichihanga chake chidonza hasi. <verse eid="NUM 22:31" /><verse number="32" style="v" sid="NUM 22:32" />Imalaika we IMNDEWA kamlongela Balamu, “Ebali ghweghwe umtowa ichihongwe wako mala ndatu? Nene nitsa kukughoma, kwaapfila inzila yaughenda noyona iha hambele hangu. <verse eid="NUM 22:32" /><verse number="33" style="v" sid="NUM 22:33" />Ichihongwe wako kambona na kanihepa mala ndatu, na ka ng'abaghuke baye yakale kutali na nene, nene ning'akukomile ghweghwe na chihongwe yuno ning'amlekile mghima.” <verse eid="NUM 22:33" /><verse number="34" style="v" sid="NUM 22:34" />Balamu kamlongela imalaika we Imulungu, “Nitenda nzambi kwaapfila simanyile baye ka ghweghwe tsakwima mnzila ungome. Lelo ka ng'ubama baye nene nighende ako, nene nitsakuya ukaye yangu.” <verse eid="NUM 22:34" /><verse number="35" style="v" sid="NUM 22:35" />Lekeni Imalaika we IMNDEWA kamlongela Balamu, “Ghenda ne wanu wano, lekeni kutsolonga achila chanikulongela.” Apfo Balamu kaghenda na pfilongotsi wa Balaki. <verse eid="NUM 22:35" /><verse number="36" style="v" sid="NUM 22:36" />Balaki hayahulike ka Balamu kakutsa, kalawa kaghenda kumbokela mna ghumji ghwa Ari, ghumji ghuno tsaghukala mmbalimbali mwa ghumto ghwa Arinoni, kwaghuli mbaka ghwa Moabu. <verse eid="NUM 22:36" /><verse number="37" style="v" sid="NUM 22:37" />Balaki kamlongela Balamu, “Ule ng'autsile baye mala lumwe ahala hanikukemile? Pfii nene sidaha baye kukutenda utunyighwe?” <verse eid="NUM 22:37" /><verse number="38" style="v" sid="NUM 22:38" />Balamu kamlongela Balaki, “Lelo nitsa, pfii nene nodaha kulonga mbuli yoyose aila? Imbuli yoyose iyonongela Imulungu iyo yanitsolonga.” <verse eid="NUM 22:38" /><verse number="39" style="v" sid="NUM 22:39" />Balamu kaghenda hamwe na Balaki, nawo wapfika Kiriati Husoti. <verse eid="NUM 22:39" /><verse number="40" style="v" sid="NUM 22:40" />Ako Balaki kachinja ng'ombe na ng'olo, inyama ingi kawagholela Balamu na pfilongotsi iwakalile hamwe naye.<verse eid="NUM 22:40" /></para>
  <para style="s">Balaamu kowamotetsa Waisiraeli</para>
  <para style="p">
    <verse number="41" style="v" sid="NUM 22:41" />Ilupfi yake, Balaki kamsola Balamu, kagheluka naye mbaka wapfika hanu hawomtambikila Baali, na kuko, Balamu tsakawona Waisiraeli wangi chila ubali.<verse eid="NUM 22:41" /></para>
  <chapter eid="NUM 22" />
  <chapter number="23" style="c" sid="NUM 23" />
  <para style="p">
    <verse number="1" style="v" sid="NUM 23:1" />Balamu kamlongela Balaki, “Nitsengele hano pfikong'o saba pfo kulakatsila tsinambiko, kuya ungalile wang'ombe wamale saba na wang'olo wamale saba.” <verse eid="NUM 23:1" /><verse number="2" style="v" sid="NUM 23:2" />Balaki katenda ka pfayalongile Balamu. Apfo walapfa ng'ombe yumwe mmale na ng'olo yumwe mmale mchanya mwa chila chikong'o. <verse eid="NUM 23:2" /><verse number="3" style="v" sid="NUM 23:3" />Kuya Balamu kamlongela Balaki, “Wime hano habehi na inambiko yako ya ukulakatsighwa, na undeke ng'ende songaha IMNDEWA katsetingana na nene, na chochose chayonangusa nitsakutsa kukulongela.” Naye kaghenda yaliyeka hanu ha ukutambikila. <verse eid="NUM 23:3" /><verse number="4" style="v" sid="NUM 23:4" />Imulungu ketingana na Balamu, naye Balamu kamlongela, “Tsanitsenga pfikong'o saba na ndapfa ng'ombe yumwe na ng'olo yumwe mchanya mwa chila chikong'o.” <verse eid="NUM 23:4" /><verse number="5" style="v" sid="NUM 23:5" />IMNDEWA kamwing'a Balamu imbuli iyobamighwa kulonga, kamlongela yoye kwa Balaki. <verse eid="NUM 23:5" /><verse number="6" style="v" sid="NUM 23:6" />Balamu koya na kampfika Balaki kema bahala habehi na nambiko yake ya ukulakatsighwa, hamwe na pfilongotsi wose wa Moabu <verse eid="NUM 23:6" /><verse number="7" style="v" sid="NUM 23:7" />Balamu katunga imbuli ino, kalonga,</para>
  <para style="q" vid="NUM 23:7">“Balaki kangala hano kulawa Aramu,</para>
  <para style="q" vid="NUM 23:7">ona mfalume wa Moabu kangala hano kulawa mna pfidunda pfa mashaliki,</para>
  <para style="q" vid="NUM 23:7">‘Utse undighitile iwanu wa Yakobu,</para>
  <para style="q" vid="NUM 23:7">utse uwalonge pfihile iwanu wa Isiraeli!’<verse eid="NUM 23:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="NUM 23:8" />Nitsomlighitatse imunu yula Imulungu yang'amlighite?</para>
  <para style="q" vid="NUM 23:8">Nitsowalongatse pfihile iwanu wala Imulungu ng'awalongile pfihile baye?<verse eid="NUM 23:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="NUM 23:9" />Kulawa mna pfidanando pfe mibambalawe nene nowona,</para>
  <para style="q" vid="NUM 23:9">kulawa mchanya mwe pfidunda nene nowasungulila,</para>
  <para style="q" vid="NUM 23:9">iwanu awo iwokala waliyeka iwebona ka wao ng'aweghala na wanu wangi baye.<verse eid="NUM 23:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="NUM 23:10" />Nani iyodaha kuwapeta iwanu wa Yakobu apfila pfawali wengi ka msanga?</para>
  <para style="q" vid="NUM 23:10">Au iyodaha kupeta hata ilobo imwe ya iwanu wa Isiraeli?</para>
  <para style="q" vid="NUM 23:10">Nene na nife ka pfawafagha iwanu iwanoghile, na hanitsigha nitsighe ka wawo!”<verse eid="NUM 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 23:11" />Baho Balaki kamlongela Balamu, “Lelo utendile choni? Nikughala ahano undighitile awano iwonihila, lekeni ghweghwe kowamotetsa ghendo.” <verse eid="NUM 23:11" /><verse number="12" style="v" sid="NUM 23:12" />Balamu kamwidika Balaki, “Angu nene sibamighwa baye kulonga malonga ghayangaile IMNDEWA?”<verse eid="NUM 23:12" /></para>
  <para style="s">Balamu kolapfa usenga lwa keli</para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 23:13" />Hambele Balaki kamlongela Balamu, “Tuke hanu hangi, ako kutsowona, lekeni kutsowona chidogho wala ng'audaha baye kuwona wose, ukandighitile awo kulawa kuko.” <verse eid="NUM 23:13" /><verse number="14" style="v" sid="NUM 23:14" />Balaki kamsola Balamu kamghala ha chiwala cha Sofimu, kune hanu ha ukutambikila cha chidunda Pisiga. Kuko katsenga masanduku gha kulakatsila tsinambiko saba na kalapfa ng'ombe yumwe mmale na ng'olo yumwe mmale mchanya mwa chila lisanduku lya kulakatsila wawe nambiko. <verse eid="NUM 23:14" /><verse number="15" style="v" sid="NUM 23:15" />Balamu kamlongela Balaki, “Wime hano habehi na inambiko yako ya kulakatsighwa, undeke ng'ende akula kumwambu niketingane na IMNDEWA.” <verse eid="NUM 23:15" /><verse number="16" style="v" sid="NUM 23:16" />IMNDEWA kamwing'a Balamu imbuli iyobamighwa kulonga, kamlongela yoye kwa Balaki. <verse eid="NUM 23:16" /><verse number="17" style="v" sid="NUM 23:17" />Apfo Balamu koya kampfika Balaki kema habehi na inambiko yake ya kulakatsighwa, hamwe na pfilongotsi wose wa Moabu. Balaki kamghutsa, “IMNDEWA yakulongele choni?” <verse eid="NUM 23:17" /><verse number="18" style="v" sid="NUM 23:18" />Baho Balamu kamtungila ng'ungo, kalonga,</para>
  <para style="q" vid="NUM 23:18">“Winuke Balaki utegheletse,</para>
  <para style="q" vid="NUM 23:18">nitegheletse, ghweghwe mwana wa Sipoli,<verse eid="NUM 23:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="NUM 23:19" />Imulungu si munu baye mbaka yaghutsuke,</para>
  <para style="q" vid="NUM 23:19">wala si mwana we munu baye mbaka yaghalambuke,</para>
  <para style="q" vid="NUM 23:19">yang'eka laghano yaleke kulitenda,</para>
  <para style="q" vid="NUM 23:19">na yang'alonga chinu yaleke kuchitenda chilawile? <verse eid="NUM 23:19" /><verse number="20" style="v" sid="NUM 23:20" />Ulole yeye kangaya laghitso lya kumotetsa, naye ma kamotetsa,</para>
  <para style="q" vid="NUM 23:20">na nene sidaha kutenda pfingi baye.<verse eid="NUM 23:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="NUM 23:21" />IMNDEWA ng'onile baye ukwiha kwa wanu wa Yakobu</para>
  <para style="q" vid="NUM 23:21">wala ng'onile ghehile ghe wanu wa Isiraeli.</para>
  <para style="q" vid="NUM 23:21">IMNDEWA kahamwe nawo yeye kotunyighwa ka kwa kutowelighwa lukenze,</para>
  <para style="q" vid="NUM 23:21">yeye kotunyighwa ka mfalume wawo.<verse eid="NUM 23:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="NUM 23:22" />Imulungu iyawalapfile kulawa Misiri.</para>
  <para style="q" vid="NUM 23:22">Yeye kana tsingufu ka tsa mbogho.<verse eid="NUM 23:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="NUM 23:23" />Ukulaghula ng'akudaha baye ghendo kuwabela iwanu wa Yakobu,</para>
  <para style="q" vid="NUM 23:23">wala uhawi kwa wanu wa Isiraeli.</para>
  <para style="q" vid="NUM 23:23">‘Mlole ipfinu pfakukangawatsa Imulungu pfayawatendele Waisiraeli.’<verse eid="NUM 23:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="NUM 23:24" />Ulole Waisiraeli wakwinuka ka isimba ipinga,</para>
  <para style="q" vid="NUM 23:24">na wakwinuka ka simba mmale, ng'owasa baye mbaka yaje mnyama yamkomile,</para>
  <para style="q" vid="NUM 23:24">na mbaka yanwe idaho ye imnyama iyamkomile.”<verse eid="NUM 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 23:25" />Kuya Balaki kamlongela Balamu, “Uleke kuwalighita wala kuwamotetsa ghendo” <verse eid="NUM 23:25" /><verse number="26" style="v" sid="NUM 23:26" />Lekeni Balamu kamwidika Balaki, “Angu sikulongele baye ka nene notenda achila Imulungu chayonongela?”<verse eid="NUM 23:26" /></para>
  <para style="s">Balamu kolapfa usenga lwa kadatu</para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 23:27" />Kuya Balaki kamlongela Balamu, “Lelo utse, nikughale hanu hangi, songaha IMNDEWA katsotoghola ghweghwe undighitile wanu wano kulawa kuko.” <verse eid="NUM 23:27" /><verse number="28" style="v" sid="NUM 23:28" />Apfo Balaki kamghala Balamu mbaka hane hanu ha ukutambikila cha chidunda Peoli, aho imunu yang'ema kolola kunyika. <verse eid="NUM 23:28" /><verse number="29" style="v" sid="NUM 23:29" />Balamu kamlongela Balaki, “Nitsengele masanduku saba gha kulakatsila tsinambiko na unyikile ng'ombe wamale saba na ng'olo wamale saba.” <verse eid="NUM 23:29" /><verse number="30" style="v" sid="NUM 23:30" />Balaki katenda ka Balamu pfayamlongele, kuya kalapfa ing'ombe yumwe mmale na ng'olo yumwe mmale mchanya mwe chilalisanduku wawe nambiko.<verse eid="NUM 23:30" /></para>
  <chapter eid="NUM 23" />
  <chapter number="24" style="c" sid="NUM 24" />
  <para style="p">
    <verse number="1" style="v" sid="NUM 24:1" />Lelo Balamu hayatangile ka IMNDEWA tsakabama kuwamotetsa Waisiraeli, apfo ng'aghendile keli baye kulaghula. Na chihanga chake ching'ali chilola kunyika. <verse eid="NUM 24:1" /><verse number="2" style="v" sid="NUM 24:2" />Naye kalola, kawona Waisiraeli weka indalo yao, wakala lukolo kwa lukolo. <verse eid="NUM 24:2" /><verse number="3" style="v" sid="NUM 24:3" />Katunga ing'ungo aino, kalonga,</para>
  <para style="q" vid="NUM 24:3">“Balamu mwana wa Beoli kolonga pfino,</para>
  <para style="q" vid="NUM 24:3">munu yula iyapfumbulighwe tsinenge kolonga,<verse eid="NUM 24:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="NUM 24:4" />yeye iyohulika ghamalonga ghe Imulungu yane ngupfu,</para>
  <para style="q" vid="NUM 24:4">yakona ghamaono gha Imtwatsa Imulungu</para>
  <para style="q" vid="NUM 24:4">imunu yula hayofughama, tsinenge tsake tsolola.<verse eid="NUM 24:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="NUM 24:5" />Lola pfibumbulika pfako pfipfinoghile,</para>
  <para style="q" vid="NUM 24:5">Ghwee Yakobu, ulole ghendo tsikaye tsenu pfatsinoghile,</para>
  <para style="q" vid="NUM 24:5">Mwemwe wanu wa Isiraeli!<verse eid="NUM 24:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="NUM 24:6" />Ka chiwala ichimwagha ghamatsi, ka konde ilili mmbalimbali mwe ghumto,</para>
  <para style="q" vid="NUM 24:6">ka mishubili iyandighwe ne Imulungu,</para>
  <para style="q" vid="NUM 24:6">ka mieletsi iyotile mmbalimbali mwe ghamatsi.<verse eid="NUM 24:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="NUM 24:7" />Mabigha ghake ghatsomema ghamatsi,</para>
  <para style="q" vid="NUM 24:7">na tsimbeghu tsao tsitsakota hane ghamatsi mengi.</para>
  <para style="q" vid="NUM 24:7">Mfalume wao katsakuwa mkulu kubita Agagi,</para>
  <para style="q" vid="NUM 24:7">na ufalume wake utsotunyighwa sideke.<verse eid="NUM 24:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="NUM 24:8" />Imulungu kamsola kulawa Misiri,</para>
  <para style="q" vid="NUM 24:8">ketowa kwaajili ye wanu wake kwa ngupfu ka tsa mbogho,</para>
  <para style="q" vid="NUM 24:8">katsoibenabena mipate yawo, katsowahoma kwa mishale yake.<verse eid="NUM 24:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="NUM 24:9" />Kenama na kakwembela ka simba, yuhi iyodaha kumlamsa?</para>
  <para style="q" vid="NUM 24:9">Yamotetsighwe ayula iyokumotetsa,</para>
  <para style="q" vid="NUM 24:9">na yalighitighwe ayula iyokulighita.”<verse eid="NUM 24:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 24:10" />Balaki kamwonela maya Balamu, katowa ghamoko ghake hamwe, Balaki kamlongela Balamu, “Nikukema utse undighitile awano iwonihila, lekeni aluno lwakadatu ghweghwe kowamotetsa. <verse eid="NUM 24:10" /><verse number="11" style="v" sid="NUM 24:11" />Lelo uke hano. Nene tsanikulongela nitsokuliha pfinu pfingi, lekeni IMNDEWA ng'abamamile baye ghweghwe upate pfinu apfo.” <verse eid="NUM 24:11" /><verse number="12" style="v" sid="NUM 24:12" />Balamu kamwidika Balaki, “Angu siwalongele baye iwanu wala yuwatumile wanitsile, <verse eid="NUM 24:12" /><verse number="13" style="v" sid="NUM 24:13" />tsaniwalongela hata ung'angaile ing'anda yako imemile fetsa na nzahabu, nene sidaha baye kutenda nzambi kwa kutenda chinu chochose kwa kubama nene mwenyegho, chiwe chinogha au chiha. Achila chayatsolonga IMNDEWA chicho chanitsolonga.”<verse eid="NUM 24:13" /></para>
  <para style="s">Balamu kolapfa usenga lwakane</para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 24:14" />Balamu kamlongela Balaki, “Nene nakuya kwe wanu wangu, lekeni tanu nobama ghweghwe umanye achila Waisiraeli chawachowatendela iwanu wako mna ghamatsuwa ighakutsa.” <verse eid="NUM 24:14" /><verse number="15" style="v" sid="NUM 24:15" />Katunga ing'ungo aino, kalonga,</para>
  <para style="q" vid="NUM 24:15">“Balamu mwana wa Beoli kolonga pfino,</para>
  <para style="q" vid="NUM 24:15">imunu yula iyafumbulighwe tsinenge kolonga,<verse eid="NUM 24:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="NUM 24:16" />yeye iyohulika ghamalonga ghe Imulungu,</para>
  <para style="q" vid="NUM 24:16">yeye iyomanya ighali ghe Imulungu iyali kulanga,</para>
  <para style="q" vid="NUM 24:16">yeye iyakona achila chayakona Imulungu yane ngupfu,</para>
  <para style="q" vid="NUM 24:16">yeye iyakwinama hasi aku tsinenge tsolola.<verse eid="NUM 24:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="NUM 24:17" />Nomwona iyatsakutsa, lekeni si sambi baye, nomlolesa,</para>
  <para style="q" vid="NUM 24:17">lekeni ng'ali habehi baye.</para>
  <para style="q" vid="NUM 24:17">Inondo itsolawila mna lukolo lwa Yakobu,</para>
  <para style="q" vid="NUM 24:17">na ing'weku ya utalawala itsolawila mna Waisiraeli,</para>
  <para style="q" vid="NUM 24:17">na ing'weku ayo itsowatowa pfilongotsi wa Maobu</para>
  <para style="q" vid="NUM 24:17">na kuwakoma iwana wa Seti.<verse eid="NUM 24:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="NUM 24:18" />Isi ya Edomu itsosolighwa iwe yake,</para>
  <para style="q" vid="NUM 24:18">na isi ya Seili nayo itsakuwa yake, Isiraeli itsakuwa na ngupfu ng'ulu.<verse eid="NUM 24:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="NUM 24:19" />Munu yumwe katsolawila mna lukolo lwa Yakobu yawatawale,</para>
  <para style="q" vid="NUM 24:19">naye katsowakoma iwanu wose iwalekighwe waghima mna ghumji.”<verse eid="NUM 24:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="NUM 24:20" />Kuya Balamu kawalola Wamaleki, na kawatungila ing'ungo ino,</para>
  <para style="q" vid="NUM 24:20">“Waamaleki tsa wanu wa mwanduso kuwa na ngupfu kubita wanu wa isi tsose,</para>
  <para style="q" vid="NUM 24:20">lekeni watsohupa kwa ukukomighwa.”<verse eid="NUM 24:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="NUM 24:21" />Kuya Balamu kawalola Wakeni,</para>
  <para style="q" vid="NUM 24:21">na kawatungila ing'ungo ino,</para>
  <para style="q" vid="NUM 24:21">“Ikaye yako ina ngupfu, na chibali chako chitsengighwa mna libambalawe.<verse eid="NUM 24:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="NUM 24:22" />Lekeni mwemwe Wakeni,</para>
  <para style="q" vid="NUM 24:22">mtsokomighwa ahala Ashuru hayatsowaghogha na kuka namwe kutali.”<verse eid="NUM 24:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="NUM 24:23" />Balamu katunga ing'ungo ino, kalonga,</para>
  <para style="q" vid="NUM 24:23">“Mtsochona! Yuhi iyatsokala mghima ahala Imulungu hayatsotenda aghano?<verse eid="NUM 24:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="NUM 24:24" />Tsimeli tsitsakutsa kulawa Kitimu na kuitowa isi ya Ashuru na Ebeli.</para>
  <para style="q" vid="NUM 24:24">Lekeni naye pfipfila katsokomighwa ghendo.”<verse eid="NUM 24:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 24:25" />Apfo Balamu koka, koya ukaye yake, naye Balaki pfipfila koka tsake.<verse eid="NUM 24:25" /></para>
  <chapter eid="NUM 24" />
  <chapter number="25" style="c" sid="NUM 25" />
  <para style="s">Waisiraeli ako Peoli</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 25:1" />Waisiraeli hawang'ali wokala ako Shitimu, iwamale tsa wanza ukutenda ughoni na wapinga wa Moabu. <verse eid="NUM 25:1" /><verse number="2" style="v" sid="NUM 25:2" />Iwapinga awo tsawawakema Waisiraeli wehangile kuitambikila imulungu yawo, nawo Waisiraeli waja ichijo chao, wainamila milungu yawo. <verse eid="NUM 25:2" /><verse number="3" style="v" sid="NUM 25:3" />Apfo Waisiraeli tsawelunga wenyegho na mulungu Baali wa Peoli, na IMNDEWA kawonela maya Waisiraeli. <verse eid="NUM 25:3" /><verse number="4" style="v" sid="NUM 25:4" />Kuya IMNDEWA kamlongela Musa, “Wasole pfilongotsi wose we iwanu wano, uwakome mna lutsuwa lukali, ili imaya yangu imale.” <verse eid="NUM 25:4" /><verse number="5" style="v" sid="NUM 25:5" />Musa kawalongela pfilongotsi wa Isiraeli, “Chila yumwe wenu yamkome munu wowose iyelungile mna ukumtambikila imulungu Baali wa Peoli.” <verse eid="NUM 25:5" /><verse number="6" style="v" sid="NUM 25:6" />Lola, munu yumwe Muisiraeli kamghala pinga yumwe Mmidiani kune chibumbulika chake, aku Musa na Waisiraeli wose wang'ali wodomboketsa hane lghumlango ghwa Lihema Lienzeluke. <verse eid="NUM 25:6" /><verse number="7" style="v" sid="NUM 25:7" />Baho Finehasi, mwanaghe Eliazali, mtsukulu wa mtambika Aruni, hayonile apfo koka aho hane mtingano, kaghenda kusola ghumghoha, <verse eid="NUM 25:7" /><verse number="8" style="v" sid="NUM 25:8" />kamkoleletsa imunu yula Muisiraeli mbaka mghati mwe chibumbulika chake, kawahoma wose weli kwa ghumgoha ghwake munda mwao. Kwa kutenda apfo, utamu wihile iung'ali uwatenda Waisiraeli wafe tsaumala. <verse eid="NUM 25:8" /><verse number="9" style="v" sid="NUM 25:9" />Lekeni utamu awo ma tsauwakoma wanu iwopfika elufu ishilini na nne.<verse eid="NUM 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 25:10" />IMNDEWA kamlongela Musa, <verse eid="NUM 25:10" /><verse number="11" style="v" sid="NUM 25:11" />“Finehasi imwana wa Eliazali, mtsukulu wa mtambika Aruni, kaikinga imaya yangu ileke kuwa mchanya mwa iwanu wa Isiraeli. Yeye yaliyeka kulawa mna mwemwe iyonile chepfu ka chepfu chanikona nene. Apfo nene siwakomile baye Waisiraeli kwa imaya yangu. <verse eid="NUM 25:11" /><verse number="12" style="v" sid="NUM 25:12" />Lelo mlongele pfino, ‘Nene nakwika laghano lya ukukala naye tseghamba.’ <verse eid="NUM 25:12" /><verse number="13" style="v" sid="NUM 25:13" />Lilaghano lyo kumtenda yeye na lweleko lwake lwose wawe watambika wa ghamatsuwa ghose, kwaapfila yeye tsakona chepfu kwaajili yangu nene Imulungu wake, na kawatenda Waisiraeli welamlitse na nene.” <verse eid="NUM 25:13" /><verse number="14" style="v" sid="NUM 25:14" />Muisiraeli ayo iyakomighwe hamwe na pinga wa Midiani tsakakemighwa Simuri, mwana wa Salu, chilongotsi wa lweleko lumwe mna likabila lya Simeoni. <verse eid="NUM 25:14" /><verse number="15" style="v" sid="NUM 25:15" />Na taghwa lya ipinga ayo Mmidiani iyakomighwe tsakakemighwa Kozibi neghe Suri, naye Suri tsachilongotsi wa lukolo lumwe ako Midiani. <verse eid="NUM 25:15" /><verse number="16" style="v" sid="NUM 25:16" />Kuya IMNDEWA kamlongela Musa, <verse eid="NUM 25:16" /><verse number="17" style="v" sid="NUM 25:17" />“Uwaghobole Wamidiani na uwakome, <verse eid="NUM 25:17" /><verse number="18" style="v" sid="NUM 25:18" />kwaapfila wao wawaghobola mwemwe kwa ughutsu wao, wawabugha mwemwe akula Peoli, na ayula kozibi, neghe wa chilongotsi yumwe wa Midiani, iyakomighwe ahala utamu wihile haulawile akula Peoli.”<verse eid="NUM 25:18" /></para>
  <chapter eid="NUM 25" />
  <chapter number="26" style="c" sid="NUM 26" />
  <para style="s">Waisiraeli wopetighwa lwa keli.</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 26:1" />Utamu ula wihile haumalile, IMNDEWA kamlongela Musa na Eliazali, <verse eid="NUM 26:1" /><verse number="2" style="v" sid="NUM 26:2" />Muwapete Waisiraeli wose, chila munu mumpete kwa kulola lweleko lwake, muwapete iwanu wose wane miyaka ishilini na kughendelela, awala wose iwodaha kughenda kwing'ondo. <verse eid="NUM 26:2" /><verse number="3" style="v" sid="NUM 26:3" />Musa na mtambika Eliazali tsawalonga ne wanu mna isi ya chiwala cha Moabu, ihili kumwambu na ghumto Yolidani habehi na Yeliko, wawalongela, <verse eid="NUM 26:3" /><verse number="4" style="v" sid="NUM 26:4" />“Muwapete iwanu, mwanzile na wanu wane miyaka ishilini na kughendelela ka IMNDEWA pfayamlaghitse Musa.” Awala Waisiraeli iwalawile Misiri tsawapetighwa na wapfika wanu wano. <verse eid="NUM 26:4" /><verse number="5" style="v" sid="NUM 26:5" />Tsikolo tsa wana wa Rubeni, imwana chaudele wa Yakobu, tsikolo atso tsa Hanoki, na Palu, <verse eid="NUM 26:5" /><verse number="6" style="v" sid="NUM 26:6" />na Hesiloni na kalimi. <verse eid="NUM 26:6" /><verse number="7" style="v" sid="NUM 26:7" />Atsino tsiso kolo tsa Rubeni itsipetighwe na kupfika wamale elufu alubaini na ndatu na miya saba na salasini. <verse eid="NUM 26:7" /><verse number="8" style="v" sid="NUM 26:8" />Awano iwo iwana wa Palu, Eliabu, <verse eid="NUM 26:8" /><verse number="9" style="v" sid="NUM 26:9" />na wanaghe Eliabu tsa tsina Nemueli, Datani, na Abilamu. Awano wawo Datani na Abilamu iwasaghulighwe na ghumtingano wa wanu Waisiraeli, iwamlemile Musa na Aruni, nawo tsawelunga na wanu wa Kola, ahala hawamlemile IMNDEWA, <verse eid="NUM 26:9" /><verse number="10" style="v" sid="NUM 26:10" />na lidongo litulika na kuwametsa. Tsawafa hamwe na kola na iwanu wake iwamtegheletse, na ghumoto ghuwalakatsa iwanu miya mbili na hamsini, iwawile chitango cho kuwakanya iwanu. <verse eid="NUM 26:10" /><verse number="11" style="v" sid="NUM 26:11" />Lekeni iwana wa Kola ng'awafile baye. <verse eid="NUM 26:11" /><verse number="12" style="v" sid="NUM 26:12" />Awano tsa wana wa Simioni na kolo tsao, Nemueli, tsakana lukolo lwa Wayemueli, Yamini, tsakana lukolo lwa Wayamini, na Yakini tsakana lukolo lwa Wayakini, <verse eid="NUM 26:12" /><verse number="13" style="v" sid="NUM 26:13" />na Sohali, tsakana lukolo lwa Wasohali na Shauli, tsakana lukolo lwa Washauli. <verse eid="NUM 26:13" /><verse number="14" style="v" sid="NUM 26:14" />Atsino tsiso kolo tsa Simioni na tsawapetighwa na kupfika wamale elufu ishilini na mbili na miya mbili.<verse eid="NUM 26:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 26:15" />Awano wana wa Gadi na kolo tsao, Sefoni lukolo lwake Wasifoni, Hagi lukolo lwake Wahagi, na Shuni lukolo lwake Washuni. <verse eid="NUM 26:15" /><verse number="16" style="v" sid="NUM 26:16" />Na Eziboni lukolo lwake Waeziboni, na Eli lukolo lwake Waeli, <verse eid="NUM 26:16" /><verse number="17" style="v" sid="NUM 26:17" />na Alodi lukolo lwake tsa Waalodi, na Aleli lukolo lwake tsa Waaleli. <verse eid="NUM 26:17" /><verse number="18" style="v" sid="NUM 26:18" />Atsino tsiso kola tsa Gadi, tsawapetighwa na kupfika wamale elufu alubaini na miya mitano.<verse eid="NUM 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 26:19" />Iwana wa Yuda tsa tsina Eli na Onani, na awo Eli na Onani tsawafa mna isi ya Kanani. Awano wawo iwana wa Yuda na tsikolo tsao, Shela lukolo lwake tsa Washela, na Pelesi, lukolo lwake tsa Wapelesi, na Zela, lukolo lwake tsa Wazela. Iwanaghe Pelesi tsa Hesloni, lukolo lwake tsa Wahesiloni, na Hamuli, lukolo lwake tsa Wahamuli. <verse eid="NUM 26:19" /><verse number="20" style="v" sid="NUM 26:20" />Na iwana wa Yuda na kolo tsao iwo wano, lukolo lwake tsa Washela, na Pelesi, lukolo lwake tsa Wapelesi, na Zela lukolo lwake tsa Wazela. <verse eid="NUM 26:20" /><verse number="21" style="v" sid="NUM 26:21" />Na iwanaghe Pelesi na kolo tsao wawo wano, Hesiloni lukolo lwake tsa Wahesiloni, na Hamuli lukolo lwake tsa Wahamuli. <verse eid="NUM 26:21" /><verse number="22" style="v" sid="NUM 26:22" />Atsino tsiso kolo tsa Yuda itsipetighwe na wamale wose tsawapfika elufu sabini na sita na miya tano.<verse eid="NUM 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 26:23" />Awano wawo iwana wa Isikali na kolo tsao, Tola lukolo lwake tsa Watola, na Puva lukolo lwake tsa Wapuva, <verse eid="NUM 26:23" /><verse number="24" style="v" sid="NUM 26:24" />na Yashubu lukolo lwake tsa Wayashubu, na Shimloni lukolo lwake tsa Washimloni. <verse eid="NUM 26:24" /><verse number="25" style="v" sid="NUM 26:25" />Atsino tsiso kolo tsa Isikali itsipetighwe na kupfika wamale elufu sitini na nne na miya ndatu.<verse eid="NUM 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 26:26" />Iwana wa Zebuluni na kolo tsao wawo wano, Seledi lukolo lwake tsa Waseledi, na Eloni lukolo lwake tsa Waeloni, na Yaleeli lukolo lwake tsa Wayaleeli. <verse eid="NUM 26:26" /><verse number="27" style="v" sid="NUM 26:27" />Atsino tsiso kolo tsa Zebuluni itsipetighwe na kupfika wamale elufu sitini na miya tano.<verse eid="NUM 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 26:28" />Na awano wawo wanaghe Yusufu, Manasse na Efulemu. <verse eid="NUM 26:28" /><verse number="29" style="v" sid="NUM 26:29" />Manase naye kamweleka Makili, na lukolo lwake tsa Wamakili, na makili naye tsakamweleka Gileadi na ilukolo lwake tsa Wagileadi. <verse eid="NUM 26:29" /><verse number="30" style="v" sid="NUM 26:30" />Naye Gileadi tsakeleka iwana, na tsikolo tsawo atsino hano, Yazeli lukolo lwake tsa Wayazeli, na Heleki lukolo lwake tsa Waheleki, <verse eid="NUM 26:30" /><verse number="31" style="v" sid="NUM 26:31" />na Asilieli lukolo lwake tsa Waasilieli, na Shekemu lukolo lwake tsa Washekemu. <verse eid="NUM 26:31" /><verse number="32" style="v" sid="NUM 26:32" />Na Shemida lukolo lwake tsa Washemida, na Hefeli lukolo lwake tsa Wahefeli. <verse eid="NUM 26:32" /><verse number="33" style="v" sid="NUM 26:33" />Selofehadi mwana wa Hefeli ng'eleke wana wamale baye, lekeni tsakana iwana wapinga waliyeka, na mataghwa ghao ghagho ghano, Mala, Noa, Hogila, Milika, na Tilisa. <verse eid="NUM 26:33" /><verse number="34" style="v" sid="NUM 26:34" />Atsino tsitso tsikolo tsa Manase itsipetighwe na kupfika wamale elufu hamsini na mbili na miya saba.<verse eid="NUM 26:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 26:35" />Iwana wa Efulemu na kolo tsao wawo wano, Shutela, lukolo lwake tsa Washutela, na Beledi lukolo lwake tsa Wabeledi, na Tahati, na lukolo lwake tsa Watahati. <verse eid="NUM 26:35" /><verse number="36" style="v" sid="NUM 26:36" />Iwana wa Shutela na kolo tsao wawo wano, Erani, lukolo lwake tsa Waerani, <verse eid="NUM 26:36" /><verse number="37" style="v" sid="NUM 26:37" />Atsino tsiso kolo tsa Efulemu itsipetighwe na kupfika wamale elufu salasini na mbili na miya tano. Kolo tsose tsino tsa makabila gha Manase na Efulemu na Manase tsilawa kwa Yosefu.<verse eid="NUM 26:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 26:38" />Na iwana wa Benjamini na kolo tsao wawo wano, Bela lukolo lwake tsa Wabela, na Ashibeli lukolo lwake Waashibeli, na Ahilamu lukolo lwake tsa Waahilamu, <verse eid="NUM 26:38" /><verse number="39" style="v" sid="NUM 26:39" />na Shufani lukolo lwake tsa Washufamu, na Hufamu lukolo lwake Wahufamu, <verse eid="NUM 26:39" /><verse number="40" style="v" sid="NUM 26:40" />Na iwana wa Bela tsa Alidi na Naamani, Alidi lukolo lwake tsalukemighwa Waalidi, na Naamani lukolo lwake tsalukemighwa Wanaamani. <verse eid="NUM 26:40" /><verse number="41" style="v" sid="NUM 26:41" />Atsino tsiso tsikolo tsa Benjamini itsipetighwe na kupfika wamale elufu alubaini na tano na miya sita.<verse eid="NUM 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 26:42" />Iwana Dani wawo awano, Shuhamu lukolo lwake tsa Washuhamu, Aluno lulo lukolo lwa Dani. <verse eid="NUM 26:42" /><verse number="43" style="v" sid="NUM 26:43" />Lukolo lwa Shuhamu tsaluna wamale elufu sitini na nne na miya nne.<verse eid="NUM 26:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 26:44" />Iwana wa Asheli na kolo tsao wawo wano, Imuna lukolo lwake tsa Waimuna, na Ishivi, lukolo lwake tsa Waishivi, na Belia, lukolo lwake tsa Wabeli. <verse eid="NUM 26:44" /><verse number="45" style="v" sid="NUM 26:45" />Na Belia tsakana wana weli Hebeli na Malikieli, Hebeli lukolo lwake tsa Wahebeli, na Malikieli lukolo lwake tsa Wamalikieli. <verse eid="NUM 26:45" /><verse number="46" style="v" sid="NUM 26:46" />Asheli tsakana mwana pinga iyakemighwe Sela. <verse eid="NUM 26:46" /><verse number="47" style="v" sid="NUM 26:47" />Atsino tsiso kolo tsa Asheli itsipetighwe na kupfika wamale elufu hamsini na ndatu na miya nne.<verse eid="NUM 26:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="NUM 26:48" />Iwana wa Nafutali na kolo tsao wawo awano, Yaseeli lukolo lwake tsa Wayaseeli, na Guni lukolo lwake tsa Waguni, <verse eid="NUM 26:48" /><verse number="49" style="v" sid="NUM 26:49" />na Yeseli lukolo lwake tsa Wayeseli, na Shilemu lukolo lwake Washilemu. <verse eid="NUM 26:49" /><verse number="50" style="v" sid="NUM 26:50" />Atsino tsiso kolo tsa Nafutali itsipetighwe na kupfika wamale elufu alubaini na tano na miya nne.<verse eid="NUM 26:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="NUM 26:51" />Awano wawo Waisiraeli wamale iwapetighwe na kupfika laki sita na imwe, miya saba na selasini.<verse eid="NUM 26:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="NUM 26:52" />IMNDEWA kamlongela Musa, <verse eid="NUM 26:52" /><verse number="53" style="v" sid="NUM 26:53" />“Uwagholele isi iwanu wano kwa ghamakabila ghao kwa kulola ka wawengi au wachidogho, <verse eid="NUM 26:53" /><verse number="54" style="v" sid="NUM 26:54" />iwanu iwali wengi watsakwing'ighwa isi ng'ulu, na awala iwali chidogho watsakwing'ighwa isi ndodo. Chila kabila litsobokela isi kwa kulola iwanu wake ka wawengi au wachidogho. <verse eid="NUM 26:54" /><verse number="55" style="v" sid="NUM 26:55" />Lekeni isi itsogholeka kwa kwasa tsisimbi mchanya. Chila lukolo lutsobokela isi kwa kulola mataghwa gha aba tsawo. <verse eid="NUM 26:55" /><verse number="56" style="v" sid="NUM 26:56" />Uighole isi kwa kwasa tsisimbi mchanya, chila lukolo lutsobokela isi kwa kulola iwanu wake ka wawengi au wachidogho.”<verse eid="NUM 26:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="NUM 26:57" />Atsino tsiso kolo tsa Lawi itsipetighwe kwa ghamataghwa ghao, Gelisoni lukolo lwake tsa Wagelisoni, na Kohati lukolo lwake tsa Wakohati, na Melali lukolo lwake tsa Wamelali, <verse eid="NUM 26:57" /><verse number="58" style="v" sid="NUM 26:58" />Atsino pfipfila tsa kolo tsa Walawi, lukolo lwa Libini, lwa Hebuloni, lwa Mali, lwa Mushi na lwa Kola. Na Kohati tsakamweleka Amlamu. <verse eid="NUM 26:58" /><verse number="59" style="v" sid="NUM 26:59" />Na pinga wa Amulamu tsakakemighwa Yokebedi, wa kabila lya Walawi, yeye tsakelekighwa Misiri. Pinga yuno tsakamwelekela Amlamu wana weli wamale, Aruni na Musa na lumbu wao Miriamu, <verse eid="NUM 26:59" /><verse number="60" style="v" sid="NUM 26:60" />Naye Aruni tsakana wana wane wamale, Nadabu, Abihu, Eliazali na Itamali. <verse eid="NUM 26:60" /><verse number="61" style="v" sid="NUM 26:61" />Nadabu na Abihu tsawafa ahala hawalapfile inambiko kwa kumdusulila ghumoto ing'aghubamighwa baye. <verse eid="NUM 26:61" /><verse number="62" style="v" sid="NUM 26:62" />Iwalawi wamale iwapetighwe wane mwetsi ghumwe na kughendelela tsawapfika elufu ishilini na tatu. Awano ng'awapetighwe baye hamwe na Waisiraeli wangi, kwaapfila wao ng'aweng'ighwe isi ya ukuhala baye mna Waisiraeli.<verse eid="NUM 26:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="NUM 26:63" />Awano wawo Waisiraeli iwamale wapetighwe na Musa na mtambika Eliazali akula kune chiwala cha Moabu, kumwambu kwa ghumto Yolidani, habehi na Yeliko. <verse eid="NUM 26:63" /><verse number="64" style="v" sid="NUM 26:64" />Tsahaduhu hata munu yumwe iyalekighwe mghima mna iwanu wala iwapetighwe na Musa na mtambika Aruni, ahala hawawapetile iwanu wa Isiraeli mna inyika ya Sinai. <verse eid="NUM 26:64" /><verse number="65" style="v" sid="NUM 26:65" />Kwaapfila IMNDEWA tsakalonga wose watsakufila mna inyika, apfo wose tsa wafa, lekeni Kalebu mwana wa Yefune, na Yoshua, mwana wa Nuni awo wawo ng'awafile baye.<verse eid="NUM 26:65" /></para>
  <chapter eid="NUM 26" />
  <chapter number="27" style="c" sid="NUM 27" />
  <para style="s">Neghe tsa Selofehadi wolomba ukuhala</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 27:1" />Tsuwa limwe neghe watano wa Selofehadi tsawamghendela Musa. Mataghwa ghao tsa aghano hano, Mala, Noa, Hogila, Milika na Tilisa. Naye Selofehadi tsakakala mwana wa Heferi, mwana wa Gileadi, mwana wa Makili, mwana wa Manase, na mwana wa Yosefu. <verse eid="NUM 27:1" /><verse number="2" style="v" sid="NUM 27:2" />Nawo tsawema hambele ha Musa na hambele ha mtambika Eliazali na hambele ha pfilongotsi wose na mtingano ghwose, hane ghumlango ghwa Lihema Lienzeluke, walonga, <verse eid="NUM 27:2" /><verse number="3" style="v" sid="NUM 27:3" />“Aba wetu tsakafila kunyika, na ng'alekile mwana mmale baye. Naye tsa si yumwe baye we iwanu wala wa Kola, iwetingane hamwe wamleme IMNDEWA, lekeni tsimkomile yeye nzambi tsake mwenyegho. <verse eid="NUM 27:3" /><verse number="4" style="v" sid="NUM 27:4" />Ule lelo taghwa lya aba wetu lyaghe mna lukolo lwake, kwaapfila tsakahela imwana mmale? Utwing'e twetwe ulisi wa aba wetu hamwe na wandughu tsake.” <verse eid="NUM 27:4" /><verse number="5" style="v" sid="NUM 27:5" />Apfo Musa kaghala lighomba lyao hambele he IMNDEWA. <verse eid="NUM 27:5" /><verse number="6" style="v" sid="NUM 27:6" />IMNDEWA kamlongela Musa, <verse eid="NUM 27:6" /><verse number="7" style="v" sid="NUM 27:7" />“Neghe tsa Selofehadi wolongesa ghendo, uweng'e ulisi wao wa isi hamwe na wa ndughu tsake aba wao, nawo wasole ulisi wake.” <verse eid="NUM 27:7" /><verse number="8" style="v" sid="NUM 27:8" />Kuya walongele Waisiraeli pfino, “Imunu yang'afa aku ng'alekile baye imwana mmale, ulisi wake katsakwing'ighwa imwana ipinga. <verse eid="NUM 27:8" /><verse number="9" style="v" sid="NUM 27:9" />Na ka kahela imwana ipinga, ulisi wake watsakwing'ighwa ndughu tsake wamale. <verse eid="NUM 27:9" /><verse number="10" style="v" sid="NUM 27:10" />Ka kahela ndughu wamale, ulisi wake weng'ighwe aba tsake wakulu au wadodo. <verse eid="NUM 27:10" /><verse number="11" style="v" sid="NUM 27:11" />Na ka aba wake kahela ndughu tsake wamale, ulisi wake yeng'ighwe imunu wake wahabehi, na yakuwa yake mwenyegho. Alino laghitso kwa Waisiraeli wose, ka apfila nene IMNDEWA pfanikulaghitsa.”<verse eid="NUM 27:11" /></para>
  <para style="s">Yoshua kosaghulighwa yawalongotse Waisiraeli</para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 27:12" />IMNDEWA kamlongela Musa, “Ugheluke kuchanya mwe chidunda chino cha Abarimu, ulole isi yaniweng'ile Waisiraeli. <verse eid="NUM 27:12" /><verse number="13" style="v" sid="NUM 27:13" />Na haumalitsa kuilola, naghwe kutsakufa ka pfayafile ndughu yako Aruni. <verse eid="NUM 27:13" /><verse number="14" style="v" sid="NUM 27:14" />Kwaapfila mwemwe tsamlema kulikinda laghitso lyangu akula kune nyika ya Sini, ahala ghumtingano ghwose haghunising'inikile nene akula Meriba, ng'ambamile baye ukulu wangu woneke hambele hawo ahala hawabamile weng'ighwe ghamatsi wanwe.” Meriba tsa mbwibwi ya ghamatsi ako Kadeshi kune nyika ya Sini. <verse eid="NUM 27:14" /><verse number="15" style="v" sid="NUM 27:15" />Musa kamlongela IMNDEWA, <verse eid="NUM 27:15" /><verse number="16" style="v" sid="NUM 27:16" />“Ghwe IMNDEWA, ghwe kwa Mulungu yuweng'a iwanu ughima, umsaghule munu yungi yawe chilongotsi we ghumtingano ghuno. <verse eid="NUM 27:16" /><verse number="17" style="v" sid="NUM 27:17" />Yeye katsowalongolela na kuwalongotsa ahala hawolawa na ahala hawakuya mkaye, hela waleke koneka ka wang'olo walihela mdimi.” <verse eid="NUM 27:17" /><verse number="18" style="v" sid="NUM 27:18" />IMNDEWA kamlongela Musa, “Umsole Yoshua mwana wa Nuni imunu yane ghomoyo ghunoghile, kuya umwikile ghamoko, <verse eid="NUM 27:18" /><verse number="19" style="v" sid="NUM 27:19" />na umwike yeme hambele ha mtambika Eliazali na mtingano ghwose ghwa Isiraeli, kuya umwing'e ing'onde ayo aku wolola kwa tsinenge tsao. <verse eid="NUM 27:19" /><verse number="20" style="v" sid="NUM 27:20" />Naghwe umwing'e chidogho ukulu wako, ili Waisiraeli wose wamtegheletse. <verse eid="NUM 27:20" /><verse number="21" style="v" sid="NUM 27:21" />Yeye katsakwima hambele ha mtambika Eliazari, mtambika katsomghutsa IMNDEWA yeye yobama choni kwa kutumila libwe lya Urimu na Sumimu. Kwa kutenda pfino Eleazari katsomlongotsa Yoshua na Waisiraeli wose ahala hawolawa na hawakwingila.” <verse eid="NUM 27:21" /><verse number="22" style="v" sid="NUM 27:22" />Musa katenda ka IMNDEWA pfayamlaghitse. Tsakamsola Yoshua kamwika yeme hambele ya mtambika Eleazari na hane iwanu wose wa Isiraeli. <verse eid="NUM 27:22" /><verse number="23" style="v" sid="NUM 27:23" />Kuya kamwikila ghamoko mwitwi na kumwing'a ukulu wa kuwalongotsa iwanu ka IMNDEWA pfayamlaghitse.<verse eid="NUM 27:23" /></para>
  <chapter eid="NUM 27" />
  <chapter number="28" style="c" sid="NUM 28" />
  <para style="s">Nambiko tsa chila litsuwa</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 28:1" />IMNDEWA kamlongela Musa, <verse eid="NUM 28:1" /><verse number="2" style="v" sid="NUM 28:2" />Uwalaghitse Waisiraeli pfino na kuwalongela, Mwemwe mtsondapfila mna chipindi ichibamighwa ipfijo ipfilapfighwa pfilakatsighwe mmoto, apfila ipfininung'ila ghoya nene Imulungu. <verse eid="NUM 28:2" /><verse number="3" style="v" sid="NUM 28:3" />Uwalongele wandapfile nambiko tsino itsilakatsighwa kwa ghumoto, wana ng'olo weli wamale wane ghumwaka ghumwe, iwenelele, awo watsakuwa nambiko ilapfighwa chila tsuwa. <verse eid="NUM 28:3" /><verse number="4" style="v" sid="NUM 28:4" />Ng'olo yumwe kutsomlapfa nemitondo, na yungi kutsomlapfa nemihe. <verse eid="NUM 28:4" /><verse number="5" style="v" sid="NUM 28:5" />Chila yumwe katsolapfighwa hamwe ne nambiko ya usaghe, iwe kimbo limwe lya usaghe iuhanganyike na kimbo limwe lya ghamapfuta gha tseituni ikamighwe. <verse eid="NUM 28:5" /><verse number="6" style="v" sid="NUM 28:6" />Inambiko ino itsolapfighwa chila tsuwa, nayo itsolakatsighwa ghendo mmoto, tsayanza kulapfighwa akula kuchidunda Sinai, iwe nambiko ye chijo, iwe ya kumnung'ila ghoya IMNDEWA. <verse eid="NUM 28:6" /><verse number="7" style="v" sid="NUM 28:7" />Pfipfila mlapfe kimbo limwe lya dipfai liwe nambiko ya chokunwa ahala hamumlapfa mwana we ng'olo yumwe, Muighide inambiko ino ye mbwali Hanu Henzeluke ghendo. <verse eid="NUM 28:7" /><verse number="8" style="v" sid="NUM 28:8" />Na nemihe kutsomlapfa mwana we ng'olo yungi yalakatsighwe mmoto, hamwe na nambiko tsila tse usaghe na ila ye chokunwa ka pfamtendile nemitondo, hatsilakatsighwa tsoninung'ila ghoya nene IMNDEWA.<verse eid="NUM 28:8" /></para>
  <para style="s">Tsinambiko tsa Sabato</para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 28:9" />Mna tsuwa lya sabato, mghale iwang'olo weli wamale, wane ghumwaka ghumwe na iwenelele, hamwe na nambiko ye pfijo, ya makimbo meli gha usaghe utighinike ghendo na iuhanganyighwe na ghamapfuta, na nambiko yake yo chokunwa. <verse eid="NUM 28:9" /><verse number="10" style="v" sid="NUM 28:10" />Inambiko ino itsolapfighwa ilakatsighwe chila haipfika Sabato, bila kuleka kulapfa tsinambiko tsila tse wana weng'olo tsitsolapfighwa chila tsuwa hamwe ne nambiko ila ye chokunwa.<verse eid="NUM 28:10" /></para>
  <para style="s">Tsinambiko itsilapfighwa ahala haghukwanza ghumwetsi</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 28:11" />Chila haghukwanza ghumwetsi, mtsomlapfila IMNDEWA nambiko ya kulakatsighwa mmoto, mtsomlapfila ng'ombe weli wamale, wawe wadowado, na ng'olo yumwe mmale, na wana wamale we ng'olo saba, wawe na ghumwaka ghumwe, na wenelele. <verse eid="NUM 28:11" /><verse number="12" style="v" sid="NUM 28:12" />Mtsolapfa nambiko ya usaghe utighinike ghendo, uwe makimbo madatu ihunganyighwe na ghamapfuta kwa chila hamumlapfa ing'ombe yumwe mmale yalakatsighwe. Na mtsolapfa makimbo meli gha usaghe ihunganyighwe na ghamapfuta kwa chila hayolapfighwa ng'olo yumwe mmale. <verse eid="NUM 28:12" /><verse number="13" style="v" sid="NUM 28:13" />Na kimbo limwe lya usaghe ihunganyighwe na ghamapfuta kwa chila hayolapfighwa mwana we ng'olo. Tsinambiko tsino hatsilakatsighwa, tsoninung'ila ghoya IMNDEWA. <verse eid="NUM 28:13" /><verse number="14" style="v" sid="NUM 28:14" />Nambiko ya chokunwa iwe makimbo meli ghe dipfai kwa chila ng'ombe mmale na kimbo limwe na nusu kwa chila ng'olo yumwe mmale na kimbo limwe kwa chila mwana we ng'olo. Aino nambiko ya kulakatsighwa iilapfighwa chila haghukwanza ghumwetsi mna ghumwaka ghwose. <verse eid="NUM 28:14" /><verse number="15" style="v" sid="NUM 28:15" />Kuya mtsomlapfila IMNDEWA mvulati yumwe, yawe nambiko ya kuleghusa nzambi, bila kwisemwa kulapfa inambiko ila ilapfighwa chila tsuwa ilakatsighwe hamwe na nambiko yake ya chokunwa.<verse eid="NUM 28:15" /></para>
  <para style="s">Tsinambiko itsilapfighwa Pasaka</para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 28:16" />Kuya tsuwa lya kumi na nne mna ghumwetsi ghwa mwanduso, itsakuwa Pasaka. <verse eid="NUM 28:16" /><verse number="17" style="v" sid="NUM 28:17" />Na Tsuwa lya kumi na tano lya ghumwetsi aghwo, litsakuwa chihungo. Mtsakuja pfighate ipfilihela ihamila kwa ghamatsuwa saba. <verse eid="NUM 28:17" /><verse number="18" style="v" sid="NUM 28:18" />Na mna tsuwa lya mwanduso lye chihungo mtsakuwa na mtingano mwenzeluka mnitambikile. Mleke kusang'ana mna litsuwa alyo. <verse eid="NUM 28:18" /><verse number="19" style="v" sid="NUM 28:19" />Mtsomlapfila IMNDEWA wang'ombe weli wamale, wawe wadowado, ng'olo yumwe mmale, na wana we ng'olo saba wamale, wane ghumwaka ghumwe, na wose wenelele. <verse eid="NUM 28:19" /><verse number="20" style="v" sid="NUM 28:20" />Chila ng'ombe yumwe ulapfe hamwe na nambiko ya usaghe ya makimbo madatu iutighinike ghendo na iuhanganyighwe na ghamapfuta chila ng'olo yumwe mmale na makimbo meli chila haulapfa imwana yumwe we ng'olo, <verse eid="NUM 28:20" /><verse number="21" style="v" sid="NUM 28:21" />na kwa chila mwana we ng'olo wa awala saba ulapfe kimbo limwe lya usaghe. <verse eid="NUM 28:21" /><verse number="22" style="v" sid="NUM 28:22" />Pfipfila mlapfe imene yumwe mmale yawe nambiko ya kuwaleghusila nzambi tsenu ili kutenda ulamlitsi. <verse eid="NUM 28:22" /><verse number="23" style="v" sid="NUM 28:23" />Mtsilapfe nambiko tsino bila kuleka inambiko yamlapfa chila litsuwa nemitondo. <verse eid="NUM 28:23" /><verse number="24" style="v" sid="NUM 28:24" />Pfipfila mtsolapfa usaghe uwe nambiko ya kulakatsighwa mna ghamatsuwa agho ghose saba, umnung'ile IMNDEWA ghoya. Mtsolapfa nambiko ino bila kuleka inambiko yamlapfa chila tsuwa na ila ya chokunwa. <verse eid="NUM 28:24" /><verse number="25" style="v" sid="NUM 28:25" />Na mna tsuwa lya saba mtsakuwa na mtingano mwenzeluka mnitambikile, na mleke kusang'ana ng'onde yoyose.<verse eid="NUM 28:25" /></para>
  <para style="s">Tsinambiko itsilapfighwa hamlimbula ipfijo</para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 28:26" />Mna litsuwa lya mwanduso lya chihungo cha mapfuno, mtsolapfila IMNDEWA ipfijo pfamwanzile kulimbula, mwobamighwa mwike mtingano mwenzeluka mnitambikile. Mleke kusang'ana ng'onde yoyose. <verse eid="NUM 28:26" /><verse number="27" style="v" sid="NUM 28:27" />Mndapfile iwana weli we ng'ombe, ing'olo yumwe mmale, na wana we ng'olo saba, wawe wamale na wane ghumwaka ghumwe, wenelele, wawe nambiko ya kulakatsighwa, na hawolakatsighwa waninung'ile ghoya nene Imtwatsa. <verse eid="NUM 28:27" /><verse number="28" style="v" sid="NUM 28:28" />Pfipfila ulapfe hamwe na nambiko ya usaghe utighinike na une ghamapfuta, ulapfe makimbo madatu gha usaghe kwa chila ng'ombe yumwe, makimbo meli kwa chila ng'olo yumwe, <verse eid="NUM 28:28" /><verse number="29" style="v" sid="NUM 28:29" />na kimbo limwe kwa chila mwana we ng'olo ili kuwatendela ulamlitsi. <verse eid="NUM 28:29" /><verse number="30" style="v" sid="NUM 28:30" />Pfipfila mlapfe mvulati yumwe yawe nambiko ya kuwaleghusila nzambi tsenu. <verse eid="NUM 28:30" /><verse number="31" style="v" sid="NUM 28:31" />Mtsolapfa nambiko tsino tsilakatsighwe bila kuleka inambiko ila ilapfighwa chila tsuwa, hamwe na nambiko yake ya chokunwa.<verse eid="NUM 28:31" /></para>
  <chapter eid="NUM 28" />
  <chapter number="29" style="c" sid="NUM 29" />
  <para style="s">Tsinambiko itsilapfighwa mna ghumwaka ghungi</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 29:1" />Mna tsuwa lya kwanza lya ghumwetsi ghwa saba, mwitingane hamwe mnitambikile, mleke kusang'ana ng'onde yoyose ila. Alyo tsuwa lya kutowa tsimati. <verse eid="NUM 29:1" /><verse number="2" style="v" sid="NUM 29:2" />Mtsolapfa tsinambiko tsa kulakatsighwa, na hatsilakatsighwa tsitsoninung'ila ghoya nene IMNDEWA. Mlapfe wang'ombe weli wadowado, ng'unzu weli na iwana wamale we ng'olo saba, wane ghumwaka ghumwe, wose wenelele. <verse eid="NUM 29:2" /><verse number="3" style="v" sid="NUM 29:3" />Pfipfila mtsolapfa nambiko ya usaghe utighinike ghendo na wikighwe ghamapfuta, mlapfe makimbo gha usaghe madatu kwa chila ng'ombe mmale, na makimbo meli kwa chila ng'unzu yumwe, <verse eid="NUM 29:3" /><verse number="4" style="v" sid="NUM 29:4" />na kimbo limwe chila mwana we ng'olo. <verse eid="NUM 29:4" /><verse number="5" style="v" sid="NUM 29:5" />Pfipfila mlapfe mvulati yumwe yawe nambiko ya kuwaleghusila nzambi ili kutenda ulamlitsi. <verse eid="NUM 29:5" /><verse number="6" style="v" sid="NUM 29:6" />Mtsolapfa pfinu pfino bila kuleka tsinambiko tsamlapfagha, ka apfila nambiko ya kulakatsighwa ahala haghulawa ghumwetsi na nambiko yake ya usaghe, na nambiko ila ilapfighwa ilakatsighwe chila nemitondo na nambiko yake ya usaghe, nambiko tsake tsa chokunwa ka apfila pfailaghitsighwe. Na hatsilakatsighwa tsinambiko tsino tsomnung'ila ghoya.<verse eid="NUM 29:6" /></para>
  <para style="s">Tsinambiko itsilapfighwa mna litsuwa lya ulamlitsi</para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 29:7" />Na mna tsuwa lya kumi lya ghumwetsi ghwa Saba, mwike ghumtingano mwenzeluka, litsuwa alyo mtsoleka ukuja na ng'amtsosang'ana baye. <verse eid="NUM 29:7" /><verse number="8" style="v" sid="NUM 29:8" />Mtsomlapfila IMNDEWA nambiko ya kulakatsighwa, na hawolakatsighwa wamnung'ile ghoya Imulungu, mlapfe ng'ombe yumwe mmale, ng'unzu yumwe, na wana wamale we ng'olo saba, wane ghumwaka ghumwe, wose wenelele. <verse eid="NUM 29:8" /><verse number="9" style="v" sid="NUM 29:9" />Mtsolapfa hamwe na nambiko ya usaghe, usaghe utighinike na wikighwe ghamapfuta, mlapfe makimbo madatu kwa ing'ombe ayo mmale, na makimbo meli kwa ing'unzu yula, <verse eid="NUM 29:9" /><verse number="10" style="v" sid="NUM 29:10" />na kimbo limwe kwa chila mwana we ng'olo. <verse eid="NUM 29:10" /><verse number="11" style="v" sid="NUM 29:11" />Pfipfila mtsolapfa mvulati yumwe yawe nambiko ya yakuleghusa nzambi.<verse eid="NUM 29:11" /></para>
  <para style="s">Tsinambiko itsilapfighwa mna chihungo che pfibumbulika</para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 29:12" />Na mna tsuwa lya kumi na tano lya ghumwetsi ghwa Saba, mwike ghumtingano mwenzeluka, na mleke kusang'ana mna litsuwa alyo. Mdeng'elele chihungo chino kwe IMNDEWA kwa ghamatsuwa saba. <verse eid="NUM 29:12" /><verse number="13" style="v" sid="NUM 29:13" />Mlapfe nambiko ya kulakatsighwa, na hawolakatsighwa wamnung'ile ghoya Imulungu, mlapfe wang'ombe wamale wadowado kumi na wadatu, na ng'unzu weli, na iwana we ng'olo wamale kumi na wane, wane ghumwaka ghumwe. Wose wenelele. <verse eid="NUM 29:13" /><verse number="14" style="v" sid="NUM 29:14" />Pfipfila ulapfe nambiko ya usaghe utighinike na wikighwe ghamapfuta, ulapfe makimbo madatu kwa chila ng'ombe mmale, na makimbo meli kwa chila ng'unzu, <verse eid="NUM 29:14" /><verse number="15" style="v" sid="NUM 29:15" />na kimbo limwe kwa chila mwana we ng'olo. <verse eid="NUM 29:15" /><verse number="16" style="v" sid="NUM 29:16" />Pfipfila mtsolapfa mvulati yumwe yawe nambiko ya kuleghusa nzambi bila kuleka inambiko ila ilapfighwa ilakatsighwe chila tsuwa na nambiko ya usaghe na ila ya chokunwa. <verse eid="NUM 29:16" /><verse number="17" style="v" sid="NUM 29:17" />Mna tsuwa lyakeli mtsolapfa iwang'ombe wamale kumi na weli, na ng'unzu weli na iwana we ng'olo wamale kumi na wane, wane ghumwaka ghumwe. Wose wenelele. <verse eid="NUM 29:17" /><verse number="18" style="v" sid="NUM 29:18" />Pfipfila mlapfe nambiko ya usaghe na nambiko tsa chokunwa hamwe na awala wang'ombe, wang'unzu na wana we ng'olo, kwa kulola wali wangapi ka apfila pfailaghitsighwe. <verse eid="NUM 29:18" /><verse number="19" style="v" sid="NUM 29:19" />Pfipfila mtsolapfa mvulati yumwe yawe nambiko ya kuleghusa nzambi bila kuleka inambiko ilapfighwa ilakatsighwe chila tsuwa na nambiko ya usaghe na ila ya chokunwa. <verse eid="NUM 29:19" /><verse number="20" style="v" sid="NUM 29:20" />Tsuwa lya kadatu mtsolapfa ng'ombe wamale kumi na yumwe, ng'unzu weli, na wana wamale we ng'olo kumi na wane, wane ghumwaka ghumwe. Wose wenelele. <verse eid="NUM 29:20" /><verse number="21" style="v" sid="NUM 29:21" />Mtsowalapfa hamwe na nambiko tsa usaghe hamwe na nambiko tsa chokunwa kwa kulola wali wangapi ka apfila pfailaghitsighwe. <verse eid="NUM 29:21" /><verse number="22" style="v" sid="NUM 29:22" />Pfipfila mtsolapfa mvulati yumwe yawe nambiko yakuleghusa nzambi bila kuleka inambiko ilapfighwa ilakatsighwe chila tsuwa na nambiko ya usaghe na ila ya chokunwa. <verse eid="NUM 29:22" /><verse number="23" style="v" sid="NUM 29:23" />Tsuwa lya kane mtsolapfa wang'ombe wamale kumi, na ng'unzu weli, na wana wamale we ng'olo kumi na wane, wane ghumwaka ghumwe, wose wenele. <verse eid="NUM 29:23" /><verse number="24" style="v" sid="NUM 29:24" />Mtsowalapfa hamwe na nambiko tsa usaghe hamwe na nambiko tsa tsokunwa kwa kulola wali wangapi ka apfila pfailaghitsighwe. <verse eid="NUM 29:24" /><verse number="25" style="v" sid="NUM 29:25" />Pfipfila mtsolapfa mvulati yumwe yawe nambiko yakuleghusa nzambi kubita inambiko ilapfighwa ilakatsighwe chila tsuwa na nambiko ya usaghe na ila ya chokunwa. <verse eid="NUM 29:25" /><verse number="26" style="v" sid="NUM 29:26" />Mna tsuwa lya tano mtsolapfa wang'ombe tisa, ng'unzu weli, na wana wamale we ng'olo kumi na wane, na wane ghumwaka ghumwe, na wose wenelele. <verse eid="NUM 29:26" /><verse number="27" style="v" sid="NUM 29:27" />Mtsowalapfa hamwe nambiko tso usaghe na hamwe nambiko tsokunwa kwa kulola wali wangapi ka apfila pfailaghitsighwe. <verse eid="NUM 29:27" /><verse number="28" style="v" sid="NUM 29:28" />Pfipfila mtsolapfa mvulati yumwe yawe nambiko ya kuleghusa nzambi bila kuleka inambiko ilapfighwa ilakatsighwe chila tsuwa na nambiko ya usaghe na ila ya chokunwa. <verse eid="NUM 29:28" /><verse number="29" style="v" sid="NUM 29:29" />Mna tsuwa lya sita mtsolapfa wang'ombe wanane, ng'unzu weli na wana wamale we ng'olo kumi na wane, wane ghumwaka ghumwe. Na iwenelele. <verse eid="NUM 29:29" /><verse number="30" style="v" sid="NUM 29:30" />Mtsowalapfa hamwe na nambiko tsa usaghe hamwe na nambiko tsokunwa kwa kulola wali wangapi ka apfila pfailaghitsighwe. <verse eid="NUM 29:30" /><verse number="31" style="v" sid="NUM 29:31" />Pfipfila mtsolapfa mvulati yumwe yawe nambiko yakuleghusa nzambi bila kuleka inambiko ilapfighwa ilakatsighwe chila tsuwa na namabiko ya usaghe na ila ya chokunwa.<verse eid="NUM 29:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 29:32" />Mna tsuwa lya saba mtsolapfa wang'ombe saba, na ng'unzu wadatu, na iwana wamale we ng'olo kumi na wane, wane ghumwaka ghumwe. Wose wenelele. <verse eid="NUM 29:32" /><verse number="33" style="v" sid="NUM 29:33" />Mtsowalapfa hamwe na nambiko tsa usaghe na hamwe na nambiko tso kunwa kwa kulola wali wangapi ka apfila pfailaghitsighwe. <verse eid="NUM 29:33" /><verse number="34" style="v" sid="NUM 29:34" />Pfipfila mtsolapfa mvulati yumwe yawe nambiko ya kuleghusa nzambi bila kuleka inambiko ilapfighwa ilakatsighwe chila tsuwa na nambiko ya usaghe na ila ya chokunwa.<verse eid="NUM 29:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 29:35" />Mna tsuwa lya nane mwike mtingano mwenzeluka, mnitambikile na mleke kusang'ana ng'onde yoyose. <verse eid="NUM 29:35" /><verse number="36" style="v" sid="NUM 29:36" />Pfipfila mtsolapfa nambiko ya kulakatsighwa, nayo hailakatsighwa ininung'ile ghoya nene IMNDEWA. Mlapfe ing'ombe mmale yumwe, ng'unzu yumwe, wana we ng'olo wa mwaka ghumwe saba iwenelele. <verse eid="NUM 29:36" /><verse number="37" style="v" sid="NUM 29:37" />Mtsolapfa na nambiko yo usaghe hamwe na nambiko ya chokunwa, kwa ayula ing'ombe mmale, na kwa ng'olo yumwe na kwa awala iwana we ng'olo saba, kwa kulola wali wangapi ka pfailaghitsighwe. <verse eid="NUM 29:37" /><verse number="38" style="v" sid="NUM 29:38" />Pfipfila mtsolapfa mvulati yumwe yawe nambiko ya kuleghusa nzambi bila kwisemwa kulapfa nambiko ila ya kulakatsighwa chila litsuwa, na inambiko ila ya usaghe, na inambiko ya chokunwa.<verse eid="NUM 29:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 29:39" />Aghano ghagho ghamalaghitso gha nambiko gha chila chihungo ka pfailaghitsighwe, bila kuleka tsinambiko tsa kulakatsighwa, nambiko tsa usaghe, tsinambiko tsenu tsa ukwika natsili, tsinambiko tsokubama mwenyegho, na atsila tsa chokunwa na atsila tsa kukala tseghemba. <verse eid="NUM 29:39" /><verse number="40" style="v" sid="NUM 29:40" />Apfo Musa kawalongela iwanu wa Isiraeli chila chinu IMNDEWA chayamlaghitse.<verse eid="NUM 29:40" /></para>
  <chapter eid="NUM 29" />
  <chapter number="30" style="c" sid="NUM 30" />
  <para style="s">Malaghitso ahala hawilaha kutenda chinu</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 30:1" />Kuya Musa kawakema pfilongotsi wa makabila gha Isiraeli kawalongela, IMNDEWA katulaghitsa apfino. <verse eid="NUM 30:1" /><verse number="2" style="v" sid="NUM 30:2" />Imunu yang'elaha kumtendela IMNDEWA chinu au yang'elighita na keyoha yeye mwenyegho kwa achila chayalongile kotenda, yatende pfipfila ka pfayalongile kulawa mna mlomo wake.<verse eid="NUM 30:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 30:3" />Ipinga iyokala mng'anda mwa aba wake, ayula ng'ana yakwelighwe baye, yang'elaghana ne Imulungu ka katsomtendela chinu au yang'elighita, kobamighwa yatende achila chayelaghane. <verse eid="NUM 30:3" /><verse number="4" style="v" sid="NUM 30:4" />Na aba wake yang'uhulika chayelaghane ne Imulungu na ukwilighita kwake, naye ng'omghoma baye, aho achila chayalaghane chitsomoha na ukwilighita kwake kutsomoha. <verse eid="NUM 30:4" /><verse number="5" style="v" sid="NUM 30:5" />Lekeni ka aba wake katsohulika na kumghoma achila chayelaghane ne Imulungu, aho ng'achitsomoha baye. IMNDEWA katsomleghusila litotso lyake kwaapfila aba wake kamlemela ukwilighita na ukwilaghana. <verse eid="NUM 30:5" /><verse number="6" style="v" sid="NUM 30:6" />Lekeni ka kakwelighwa na mulume aku ma kelaghana ne Imulungu na ukwilighita, au kalonga bila ukwalangula ghoya, na kwiyoha imwenyegho, <verse eid="NUM 30:6" /><verse number="7" style="v" sid="NUM 30:7" />na mulume wake yang'ahulika, naye ng'omghoma baye, aho chayelaghane na chayelighite chitsomoha. <verse eid="NUM 30:7" /><verse number="8" style="v" sid="NUM 30:8" />Lekeni ka mulume wake komlemela mna tsuwa alyo hayahulike, ipinga ayo ng'obamighwa baye kutenda achila chayelighite na chayelaghane ne Imulungu, na IMNDEWA komleghusila totso lyake. <verse eid="NUM 30:8" /><verse number="9" style="v" sid="NUM 30:9" />Lekeni ka ipinga ka chitsuka au kalekighwa na immale wake, kobamighwa yatende chila chinu chayelaghane na chayelighite. <verse eid="NUM 30:9" /><verse number="10" style="v" sid="NUM 30:10" />Lekeni ka ipinga iyakwelighwe keka laghano lyake au kelighita hayali kokala ukaye kwa imlume wake, <verse eid="NUM 30:10" /><verse number="11" style="v" sid="NUM 30:11" />na imlume wake kamuhulika, naye ng'amlongele chinu chochose baye, wala ng'amghomile baye, aho laghano lyayekile lyakuwa pfipfo na achila chayelighite chakuwa pfipfo. <verse eid="NUM 30:11" /><verse number="12" style="v" sid="NUM 30:12" />Lekeni ka imlume wake kohulika naye ng'obama baye ipinga wake yatende apfo, na komghoma, ipinga ayo yaleke kutenda achila chayelaghane, na Imulungu katsomleghusila litotso lyake. <verse eid="NUM 30:12" /><verse number="13" style="v" sid="NUM 30:13" />Imulume kodaha kumleka ipinga wake yatende achila chayelaghane na chayelighite, au kodaha kumghoma ipinga wake yaleke kuchitenda achila chayelaghane na chayelighte. <verse eid="NUM 30:13" /><verse number="14" style="v" sid="NUM 30:14" />Lekeni ka imlume wake ng'olonga chinu chochose baye kulawa tsuwa lila lyayohulika laghano lyayekile pinga wake au ukwilighita kwake, aho immale katoghola ipinga wake kutenda achila chayelaghane na chayelighite, kwaapfila ng'amghomile baye. <verse eid="NUM 30:14" /><verse number="15" style="v" sid="NUM 30:15" />Lekeni ka mulume wake tsakenyamala ahala hayahulike, kuya ghang'abita matsuwa chidogho komghoma, imulume ayo katsosola totso lye ipinga wake. <verse eid="NUM 30:15" /><verse number="16" style="v" sid="NUM 30:16" />Aghano ghagho ghamalaghitso gha IMNDEWA ghayamwing'ile Musa ghawalongotse mulume ne pinga, na ghawalongotse aba ne mwana ipinga yang'ana yakwelighwe, iyokala ukaye kwa aba wake.<verse eid="NUM 30:16" /></para>
  <chapter eid="NUM 30" />
  <chapter number="31" style="c" sid="NUM 31" />
  <para style="s">Waisirali wowatowa Wamidiani</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 31:1" />IMNDEWA kamlongela Musa, <verse eid="NUM 31:1" /><verse number="2" style="v" sid="NUM 31:2" />“Uwoyitsile Wamidiani aghala ghawawatendele Waisiraeli, kuya ghweghwe hambele kutsohupa.” <verse eid="NUM 31:2" /><verse number="3" style="v" sid="NUM 31:3" />Musa kalonga ne wanu, kawalongela pfino, “Muweke iwanu wakale ghoya kwe ng'ondo, waghende wakawatowe Wamidiani, wakoitse achila Wamidiani chawawatendile hambele he IMNDEWA. <verse eid="NUM 31:3" /><verse number="4" style="v" sid="NUM 31:4" />Chila kabila lya Isiraeli lighale wanu elufu imwe, waghende kung'ondo.” <verse eid="NUM 31:4" /><verse number="5" style="v" sid="NUM 31:5" />Apfo wanu elufu imwe tsawalawa mna chila likabila lya iwanu wa Isiraeli, na wapfika wamale elufu kumi na mbili iwakalile ghoya kwe ng'ondo. <verse eid="NUM 31:5" /><verse number="6" style="v" sid="NUM 31:6" />Kuya Musa kawatuma waghende kung'ondo aku walongotsighwa na Finehasi, mwanaghe mtambika Eliazali. Naye tsakaghenda aku kasola ipfinu pfa hanu henzeluke na tsimalati tsokukemela ing'ondo. <verse eid="NUM 31:6" /><verse number="7" style="v" sid="NUM 31:7" />Tsawawatowa Wamidiani ka IMNDEWA pfayamlaghitse Musa, na wawakoma wamale wose. <verse eid="NUM 31:7" /><verse number="8" style="v" sid="NUM 31:8" />Na wafalume watano wa Midiani tsawakomighwa hamwe na iwanu awo, wafalume awo tsa Ewi, Rekemu, Suri, Huri, na Reba. Pfipfila tsawamkoma Balamu mwana wa Beoli. <verse eid="NUM 31:8" /><verse number="9" style="v" sid="NUM 31:9" />Iwanu wa Isiraeli tsawawaghogha iwapinga wa Midiani na iwana wao, na wawaboka wang'ombe na wang'olo wao, na tsimali tsao tsose, na kuka nawo. <verse eid="NUM 31:9" /><verse number="10" style="v" sid="NUM 31:10" />Walakatsa imiji yawo na tsikaye tsawo tsose tsawang'ali wokala, na pfibumbulika pfao pfose. <verse eid="NUM 31:10" /><verse number="11" style="v" sid="NUM 31:11" />Tsawoka na tsimali tsawabokile, ne wapinga ne wana iwawaghoghile, na tsawasola na mipfugho yawo. <verse eid="NUM 31:11" /><verse number="12" style="v" sid="NUM 31:12" />Tsawawaghala iwapinga ne wana wao, na tsimali tsao na mipfugho yawo kwa Musa na Eliazali na kwe Waisiraeli wose iwekile ndalo yawo mna isi ya chiwala ili Moabu, kumwambu kwa Yoridani ako Yeriko.<verse eid="NUM 31:12" /></para>
  <para style="s">Ukuya kulawa kune ng'ondo</para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 31:13" />Musa na mtambika Eliazali, na pfilongotsi wose wa Waisiraeli tsawalawa mna indalo yao, waghenda kuwabokela iwanu iwalawile kung'ondo. <verse eid="NUM 31:13" /><verse number="14" style="v" sid="NUM 31:14" />Musa kawonela maya wakulu na pfilongotsi iwawemile iwanu wala iwoyile kulawa kwing'ondo. <verse eid="NUM 31:14" /><verse number="15" style="v" sid="NUM 31:15" />Musa kawaghutsa, “Ule mwemwe muwaleka waghima iwapinga wano wose?” <verse eid="NUM 31:15" /><verse number="16" style="v" sid="NUM 31:16" />Mlole, awano tsawawo iwategheletse achila chayalongile Balamu, kuwahonza Waisiraeli wamtendele Imuulungu nzambi akula Peoli, mbaka utamu wihile uwatsila iwanu we IMNDEWA. <verse eid="NUM 31:16" /><verse number="17" style="v" sid="NUM 31:17" />Apfo muwakome iwana wose wamale na chila pinga iyamanyile kuwasa na mmale. <verse eid="NUM 31:17" /><verse number="18" style="v" sid="NUM 31:18" />Lekeni mleke kuwakoma iwapinga wose awala ng'ana wawase na mmale baye, muwaleke waghima, awo wakuwa wenu mwemwe muwenyegho. <verse eid="NUM 31:18" /><verse number="19" style="v" sid="NUM 31:19" />Awala wose iwokomile imunu au iwakindile ilukuli lwe munu yafile wobamighwa wakale kunze kwe ndalo kwa ghamatsuwa saba, mwihopfughe mwemwe muwenyegho hamwe ne wanu wamuwaghoghile, mna litsua lya kadatu na lya saba. <verse eid="NUM 31:19" /><verse number="20" style="v" sid="NUM 31:20" />Pfipfila mghatende maghwanda ghenu ghele, liwe ghwanda litengenetsighwa kwa ngotsi, kwa mighala ya mene, au kwa mighome. <verse eid="NUM 31:20" /><verse number="21" style="v" sid="NUM 31:21" />Kuya imtambika Eliazali kawalongela iwamale wose iwoyile kulawa kung'ondo, “Alino laghitso lila IMNDEWA lyayamwing'ile Musa. <verse eid="NUM 31:21" /><verse number="22" style="v" sid="NUM 31:22" />Lekeni mabwe gha nzahabu, gha fetsa, gha shaba, gha chuma, gha bati, na gha lisasi, <verse eid="NUM 31:22" /><verse number="23" style="v" sid="NUM 31:23" />chochose chila ching'ekighwa mmoto ing'achilakala baye, acho chakuwa chela kwa kulakatsighwa mmoto. Pfipfila pfobamighwa pfihopfughighwe kwa ghamatsi gha ukuleghusila nzambi. Chochose chila ching'ekighwa mmoto cholakala, acho uchihopfughe kwa ghamatsi agho. <verse eid="NUM 31:23" /><verse number="24" style="v" sid="NUM 31:24" />Namwe mtsapfe ghamagwanda ghenu mna litsua lya saba, namwe mwakuwa mwela na mwodaha kwingila kune indalo.”<verse eid="NUM 31:24" /></para>
  <para style="s">Ukwigholela tsimali na iwanu iwaghoghighwe kung'ondo.</para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 31:25" />IMNDEWA kamlongela Musa, <verse eid="NUM 31:25" /><verse number="26" style="v" sid="NUM 31:26" />“Ghweghwe na mtambika Eliazali, na pfilongotsi wa iwanu wa Waisiraeli, mwobamighwa mpete pfinu pfose ipfibokighwe kwing'ondo ne iwanu ne iwanyama wose iwabokighwe. <verse eid="NUM 31:26" /><verse number="27" style="v" sid="NUM 31:27" />Mpfighole pfinu apfo mna mabughulu meli, bughulu limwe liwe lya wamale iwaghendile kung'ondo, na lingi liwe lya wanu wose. <verse eid="NUM 31:27" /><verse number="28" style="v" sid="NUM 31:28" />Kuya kulawa kune libughulu lyaweng'ighwe iwanu iwaghendile kwitowa, ubaghule itsaka iwe ye IMNDEWA, chinu chimwe kulawa mna chila miya tano, wawe wanu, ng'ombe, punda, ng'olo, au mene. <verse eid="NUM 31:28" /><verse number="29" style="v" sid="NUM 31:29" />Umwing'e mtambika Eliazali iwe nambiko kwe IMNDEWA. <verse eid="NUM 31:29" /><verse number="30" style="v" sid="NUM 31:30" />Kulawa mna libughulu lila liwe lya wanu wose, usole yumwe kulawa mna chila hamsini, wawe wanu, ng'ombe, pfihongwe, ng'olo au mene. Awo uweng'e Walawi iwosang'ana kuna lihema lya IMNDEWA.” <verse eid="NUM 31:30" /><verse number="31" style="v" sid="NUM 31:31" />Musa na Mtambika Eliazali tsawatenda ka IMNDEWA pfayamlaghitse Musa. <verse eid="NUM 31:31" /><verse number="32" style="v" sid="NUM 31:32" />Ipfinu pfawabokile iwanu iwaghendile kwing'ondo tsa, mene na ng'olo laki sita na elufu sabini na tano, <verse eid="NUM 31:32" /><verse number="33" style="v" sid="NUM 31:33" />tsa ng'ombe elufu sabini na weli, <verse eid="NUM 31:33" /><verse number="34" style="v" sid="NUM 31:34" />tsa pfihongwe elufu sitini na imwe, <verse eid="NUM 31:34" /><verse number="35" style="v" sid="NUM 31:35" />na pfigholi elufu selasini na weli, awo ng'ana wawase na mmale baye. <verse eid="NUM 31:35" /><verse number="36" style="v" sid="NUM 31:36" />Na libughu lila lyibaghulighwe lyiwe lya iwamale iwaghendile kwitowa, tsalina mene na ng'olo laki ndatu, elufu selasini na saba, na miya tano, <verse eid="NUM 31:36" /><verse number="37" style="v" sid="NUM 31:37" />Ng'olo miya sita na sabini na tano kulawa mna awo tsawalafighwa wawe wa IMNDEWA. <verse eid="NUM 31:37" /><verse number="38" style="v" sid="NUM 31:38" />Kuya tsalina ng'ombe elufu selasini na sita, na ng'ombe sabini na weli tsawalapfighwa wawe wa IMNDEWA. <verse eid="NUM 31:38" /><verse number="39" style="v" sid="NUM 31:39" />Na pfihongwe wao tsa elufu selasini na miya tano, na pfihongwe sitini na yumwe tsawalapfighwa wawe wa IMNDEWA. <verse eid="NUM 31:39" /><verse number="40" style="v" sid="NUM 31:40" />Ne pfigholi elufu kumi na sita, na wanu salasini na weli tsawalafighwa wawe wa IMNDEWA. <verse eid="NUM 31:40" /><verse number="41" style="v" sid="NUM 31:41" />Apfo Musa kamwing'a mtambika Eliazali tsaka ayo ilapfighwe kwe IMNDEWA ka Imulungu pfayamlaghitse Musa. <verse eid="NUM 31:41" /><verse number="42" style="v" sid="NUM 31:42" />Libughulu lila lyaweng'ighwe Waisiraeli tsalilingana na libughulu lya iwanu iwaghendile kung'ondo, <verse eid="NUM 31:42" /><verse number="43" style="v" sid="NUM 31:43" />na libughulu lyaweng'ighwe Waisiraeli tsa mene na ng'olo laki ndatu, elufu selasini na saba na miya tano, <verse eid="NUM 31:43" /><verse number="44" style="v" sid="NUM 31:44" />na ng'ombe elufu salasini na sita, <verse eid="NUM 31:44" /><verse number="45" style="v" sid="NUM 31:45" />na tsa pfihongwe elufu salasini na miya tano, <verse eid="NUM 31:45" /><verse number="46" style="v" sid="NUM 31:46" />na wanu elufu kumi na sita. <verse eid="NUM 31:46" /><verse number="47" style="v" sid="NUM 31:47" />Kulawa mna libughulu lyaweng'ighwe Waisiraeli Musa tsakasola munu yumwe na imnyama yumwe kulawa mna chila wanu hamsini na mna chila wanyama hamsini, kaweng'a Walawi iweng'ighwe ing'onde yo kusang'ana kuna Lihema Lienzeluke ka pfayamlaghitse IMNDEWA. <verse eid="NUM 31:47" /><verse number="48" style="v" sid="NUM 31:48" />Kuya pfilongotsi wose na iwakulu wose we ng'ondo tsawamghendela chalumwe Musa, <verse eid="NUM 31:48" /><verse number="49" style="v" sid="NUM 31:49" />wamlongela, “Twetwe watumighwa wako tsatuwapeta iwanu wose we ng'ondo watuwalongotse, na twona haduhu hata yumwe iyahunguke. <verse eid="NUM 31:49" /><verse number="50" style="v" sid="NUM 31:50" />Apfo tughala pfinu pfa nzahabu, ka tsibangili tsa mmaghulu, na tsa mmoko, tsipete tsa mpfidole, tsa mmaghutwi, tsatupatile kune ng'ondo. Tupfilapfa pfinu kwaapfila IMNDEWA tsakaukinga ughima wetu.” <verse eid="NUM 31:50" /><verse number="51" style="v" sid="NUM 31:51" />Musa na mtambika Eliazali tsawabokela pfinu pfose ipfihambighwe nzahabu. <verse eid="NUM 31:51" /><verse number="52" style="v" sid="NUM 31:52" />Inzahabu yose ilapfighhwe na pfilongotsi wose kwe IMNDEWA tsaipfika kilo miya mbili. <verse eid="NUM 31:52" /><verse number="53" style="v" sid="NUM 31:53" />Bila kupeta ipfinu pfila pfawasolile iwanu we ng'ondo. <verse eid="NUM 31:53" /><verse number="54" style="v" sid="NUM 31:54" />Apfo Musa na Mtambika Eliazali tsawabokela nzahabu ayo kulawa kwe wakulu awo nawo waighala mna Lihema Lienzeluke, chiwe ka chinu cha kukumbukagha Waisiraeli hambele he IMNDEWA ka Imulungu kowalinda.<verse eid="NUM 31:54" /></para>
  <chapter eid="NUM 31" />
  <chapter number="32" style="c" sid="NUM 32" />
  <para style="s">Ghamakabila gha Mashariki ya Yordani</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 32:1" />Iwana wa Rubeni na Gadi tsawana mifugho mingi sideke. Hawonile ka isi ya Yezeri na Gileadi inogha kwa kufughila iwanyama, <verse eid="NUM 32:1" /><verse number="2" style="v" sid="NUM 32:2" />Tsawawaghendela Musa na mtambika Eleazari na pfilongotsi wangi we iwanu Isiraeli, wawalongela, <verse eid="NUM 32:2" /><verse number="3" style="v" sid="NUM 32:3" />“Imiji ya Ataroti, Diboni, Yazeri, Nimra, Heshiboni, Eleale, Sebamu, Nebo na Beoni, <verse eid="NUM 32:3" /><verse number="4" style="v" sid="NUM 32:4" />isi iyaibokile IMNDEWA iwe ya Waisiraeli inogha kwa kufughila iwanyama, natwe tuna mifugho mingi sideke. <verse eid="NUM 32:4" /><verse number="5" style="v" sid="NUM 32:5" />Lelo ka mwotutogholela twowalomba mtwing'e isi ino iwe ulisi yetu, mleke kutulosa kumwambu kwa ghumto ghwa Yordani.”<verse eid="NUM 32:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 32:6" />Musa kawedika iwanu wa Gadi na Rubeni kalonga, “Angu mwobama mkale hano aku wandughu tsenu wakuka kung'ondo? <verse eid="NUM 32:6" /><verse number="7" style="v" sid="NUM 32:7" />Angu ng'amkona baye ka mwowakeng'ena Waisiraeli waleke kughenda kune isi yaweng'ighwe ne IMNDEWA?” <verse eid="NUM 32:7" /><verse number="8" style="v" sid="NUM 32:8" />Apfino pfipfo pfawatendile aba tsenu ahala haniwatumile kulawa Kadeshi Barinea wakaipelembe isi. <verse eid="NUM 32:8" /><verse number="9" style="v" sid="NUM 32:9" />Wapelembi awo tsawaghenda mbaka kune lwanda lwa Eshikoli, wayona isi, lekeni hawoyile wawatenyula Waisiraeli waleke kughenda kune isi yaweng'ile IMNDEWA. <verse eid="NUM 32:9" /><verse number="10" style="v" sid="NUM 32:10" />Mna litsuwa alyo IMNDEWA tsakona maya kelaha, kalonga, <verse eid="NUM 32:10" /><verse number="11" style="v" sid="NUM 32:11" />“Nelaha ghendo! ‘Haduhu hata munu yumwe yalawile misiri yane miyaka ishilini na kughendelela iyatsoyona isi yanilahile kuweng'a Abrahamu, Isaka na Yakobu, kwaapfila ng'awanihulikitse baye kwa mimoyo yao yose.’ <verse eid="NUM 32:11" /><verse number="12" style="v" sid="NUM 32:12" />Wose ng'awatsoyona baye ila Kalebu mwana wa Yefune, wa lukolo lwa Mkenitsi, na Yushua mwana wa Nuni wawo watsoyona kwaapfila wawo wanihulikitsa kwa mimoyo yao yose. <verse eid="NUM 32:12" /><verse number="13" style="v" sid="NUM 32:13" />Na IMNDEWA kawonela maya Waisiraeli, kawatenda wayungeyunge kunyika kwa miyaka alubaini mbaka icheleko chitendile nzambi chose chife. <verse eid="NUM 32:13" /><verse number="14" style="v" sid="NUM 32:14" />Lelo mwemwe lweleko lwa wanu wane nzambi, mwinuka hanu ha wahenga wenu mtsa hano mumtende IMNDEWA yawonele keli maya waisiraeli, <verse eid="NUM 32:14" /><verse number="15" style="v" sid="NUM 32:15" />na mng'alema kumuwinza IMNDEWA katsomlekeni keli kunyika, namwe mtsotenda iwanu wano wose wakomighwe.”<verse eid="NUM 32:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 32:16" />Baho wamsoghelela Musa wamlongela, “Tanu utuleke tuwatsengele pfikwama wang'olo wetu ne wana wetu tuwatsengele imiji. <verse eid="NUM 32:16" /><verse number="17" style="v" sid="NUM 32:17" />Lekeni twetwe twoghenda kwig'ondo hamwe na ndughu tsetu waisiraeli, tutsowapfila mbaka twone hanu hawotsokala. Lekeni iwana wetu watsokala mna imiji itsungulusighwe ubanda ilii iwana wetu waleke kutowighwa ne iwanu we isi ino. <verse eid="NUM 32:17" /><verse number="18" style="v" sid="NUM 32:18" />Ng'atutsakuya ukaye baye mbaka Waisiraeli wose hawatsopata isi ya kukala. <verse eid="NUM 32:18" /><verse number="19" style="v" sid="NUM 32:19" />Wala ng'atutsosola baye chinu chochose kulawa kuna wawo akula kumwambu kwa ghumto Yordani kwaapfila twetwe ma tupata hanu hetu akuno Mashaliki ya ghumto ghwa Yordani.”<verse eid="NUM 32:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 32:20" />Musa kawalongela, “Ka aghano ghamlongile hambele he IMNDEWA mtsoghatenda, lelo soleni pfinu pfenu pfa kwitowela mke kwing'ondo. <verse eid="NUM 32:20" /><verse number="21" style="v" sid="NUM 32:21" />Chila munu yoghenda kwitowa katsoloka ghumto Yordani aku IMNDEWA katsomlongotsa, mtsowakoma awala iwowehila mbaka Imulungu yawahume, <verse eid="NUM 32:21" /><verse number="22" style="v" sid="NUM 32:22" />na kuisola isi iwe yenu. Hamtsomalitsa kutenda apfo, mtsakuya kwaapfila mtenda achila chamumlongele IMNDEWA na ndughu tsenu Waisiraeli. Kuya IMNDEWA katsotoghola isi ino ya ubali wa mashaliki ya Yordani iwe yenu. <verse eid="NUM 32:22" /><verse number="23" style="v" sid="NUM 32:23" />Lekeni nowakanya ghendo, ka ng'amtendile achino chayamlongile, mtsakuwa mtenda nzambi hambele he IMNDEWA, na mtsohighighwa kwa tsinzambi tsenu. <verse eid="NUM 32:23" /><verse number="24" style="v" sid="NUM 32:24" />Lelo watsengeleni iwana wenu imiji na wang'olo wenu muwatsengele pfikwama, kuya mtende ka pfamlongile.”<verse eid="NUM 32:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 32:25" />Kuya iwanu wa Gadi na wa Rubeni wamlongela Musa, “Twetwe watumighwa wako tutsotenda ka pfautulaghitse. <verse eid="NUM 32:25" /><verse number="26" style="v" sid="NUM 32:26" />Wapinga wetu, iwana, na mifugho yetu itsokala hano hane imiji ya Gileadi. <verse eid="NUM 32:26" /><verse number="27" style="v" sid="NUM 32:27" />Lekeni twetwe watumighwa wako tutsoghenda kung'ondo tung'alongotsighwa ne IMNDEWA. Tutsoloka ghumto Yordani na kwitowa ng'ondo ka pfaulongile.”<verse eid="NUM 32:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 32:28" />Apfo Musa kaweng'a malaghitso ghano mtambika Eleazari, Yoshua mwana wa Nuni, na pfilongotsi wose wa Waisiraeli, kalonga, <verse eid="NUM 32:28" /><verse number="29" style="v" sid="NUM 32:29" />“Ka iwanu wa Gadi na wa Rubeni watsoloka ghumto Yordani hamwe namwe aku wakinda pfinu pfa kutowela kulongotsighwa na IMNDEWA kuya muhume na kuisola isi ayo, apfo mtsoweng'a isi ino Gileadi iwe yawo. <verse eid="NUM 32:29" /><verse number="30" style="v" sid="NUM 32:30" />Lekeni ka ng'awotsoloka baye mna ghumto Yoridani hamwe na pfinu pfao pfa kutowela hamwe namwe mwiketowe, ng'awotsobokela baye isi ino, apfo watsoisola chidogho isi ya Kanaani ihili ubali wa kwalikuswela litsua.”<verse eid="NUM 32:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 32:31" />Iwanu wa Gadi na Rubeni wedika walonga, “Twetwe watumighwa wako tutsotenda ka IMNDEWA pfayatulongele. <verse eid="NUM 32:31" /><verse number="32" style="v" sid="NUM 32:32" />Kwa kulongotsighwa na IMNDEWA, tutsoloka hamwe na mighowa yetu mbaka Kanaani, na isi yatwing'ighwe hano mashaliki ya Yordani itsakuwa ulisi wetu.” <verse eid="NUM 32:32" /><verse number="33" style="v" sid="NUM 32:33" />Apfo Musa kaweng'a iwanu wa llikabila lya Gadi na lya Rubeni na iwanu nusu wa likabila lya Manase mwana wa Yosefu isi yose ya Sihoni, mfalume wa Waamori na isi ya mfalume Ogu wa Bashani hamwe na imiji na isi itsunguluke imiji ayo. <verse eid="NUM 32:33" /><verse number="34" style="v" sid="NUM 32:34" />Likabila lya Rubeni tsawatsenga keli imiji ya Diboni, Ataroti, Aroeri, <verse eid="NUM 32:34" /><verse number="35" style="v" sid="NUM 32:35" />Atiroti Shofani, Yazeri, Yogibeha, <verse eid="NUM 32:35" /><verse number="36" style="v" sid="NUM 32:36" />Beti Nimura na Beti Harani, imiji itsungulusighwe ubanda na pfikwama pfa wang'olo. <verse eid="NUM 32:36" /><verse number="37" style="v" sid="NUM 32:37" />Wanu wa kabila lya Rubeni tsawatsenga keli miji ya Heshiboni, Eleale, Kiriataimu, <verse eid="NUM 32:37" /><verse number="38" style="v" sid="NUM 32:38" />Nebo na Baali Meoni, na Sibima. Imiji yawatsengile keli tsawaikema mataghwa ghangi.<verse eid="NUM 32:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 32:39" />Iwanu wa Makili iyali mwana wa Manase tsawaipfamila isi ya Gileadi, waisola na wawawinga Waamori iwang'ali wokala amwo. <verse eid="NUM 32:39" /><verse number="40" style="v" sid="NUM 32:40" />Apfo Musa tsakaweng'a iwanu wa lweleko lwa Makiri iyali imwana wa manase isi ya Gileadi, nawo wakala mumo. <verse eid="NUM 32:40" /><verse number="41" style="v" sid="NUM 32:41" />Wanu wa lukolo lwa Yairi iyali mwana wa Manase tsawetowa na pfijiji pfa Gileadi na kupfisola, kuya kapfing'a taghwa Hawotiyairi, mana yake Pfijiji pfa Yairi. <verse eid="NUM 32:41" /><verse number="42" style="v" sid="NUM 32:42" />Naye Noba tsaketowa na kuisola Keneti na pfijiji pfake ipfitsunguluke, na kapfikema Noba, ka pfalili taghwa lyake.<verse eid="NUM 32:42" /></para>
  <chapter eid="NUM 32" />
  <chapter number="33" style="c" sid="NUM 33" />
  <para style="s">Waisilaeli wolawa Misili na woghenda Moabu</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 33:1" />Atsino hano tsiso isi Waisiraeli tsawemile weke ndalo ahala hawalawile Misili aku wamna ghamakingili ghao gha tsikolo, na kulongotsighwa na Musa na Aruni. <verse eid="NUM 33:1" /><verse number="2" style="v" sid="NUM 33:2" />Na Musa kandika isi tsawemile weke ndalo mna ghumwanza ghwao, ka IMNDEWA pfayamlaghitse, na ghumwanza ghwao ghwima mna isi tsino. <verse eid="NUM 33:2" /><verse number="3" style="v" sid="NUM 33:3" />Waisiraeli tsawoka mna ghumji kwa Ramesesi mna tsuwa lya kumi na tano mna ghumwetsi ghwa kwanza, tsuwa lya keli ahala ichihungo cha Pasaka hachimalile. Tsawoka kwa ingupfu ye Imulungu aku Wamisili wose wolola. <verse eid="NUM 33:3" /><verse number="4" style="v" sid="NUM 33:4" />Aku Wamisiri wang'ali wowatsika iwana wao chaudele, awala IMNDEWA iyawakomile. Pfipfila Imulungu tsakaihinya imilungu yawo.<verse eid="NUM 33:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 33:5" />Apfo Waisiraeli tsawoka Rameseli, wapfika Sukoti, kuko weka indalo yawo. <verse eid="NUM 33:5" /><verse number="6" style="v" sid="NUM 33:6" />Tsawoka kulawa Sukoti waghenda kwika ndalo yawo ako Etamu, ako mmbalimbali mwe inyika. <verse eid="NUM 33:6" /><verse number="7" style="v" sid="NUM 33:7" />Walawa Etamu, wahunduka woya Pi Hahiloti, ubali wa mashaliki wa Baali Sefoni, kuko weka ndalo yao habehi na Migidoli. <verse eid="NUM 33:7" /><verse number="8" style="v" sid="NUM 33:8" />Woka Pi Hahiloti, wang'a mna ibahali ya Shamu mbaka wapfika mna inyika Etamu, tsawaghenda mna inyika ayo kwa matsuwa madatu mbaka wapfika Mala, kuko weka ndalo yao. <verse eid="NUM 33:8" /><verse number="9" style="v" sid="NUM 33:9" />Kulawa Mala, tswaghendelela na ghwamwanza ghwao mbaka wapfika Elimu, kuko Elimu tsakuna mbwibwi kumi na mbili, na mibiki ya mitende sabini, kuko Elimu weka ndalo yawo. <verse eid="NUM 33:9" /><verse number="10" style="v" sid="NUM 33:10" />Woka kulawa Elimu, na waghenda kwika indalo yao habehi na ibahali ya Shamu. <verse eid="NUM 33:10" /><verse number="11" style="v" sid="NUM 33:11" />Kulawa Ibahali ya Shamu, tsawaghenda kwika indalo mna inyika ya Sini. <verse eid="NUM 33:11" /><verse number="12" style="v" sid="NUM 33:12" />Kulawa inyika ya Sini tsawapfika inyika ya Dofika, kuko weka ndalo yawo. <verse eid="NUM 33:12" /><verse number="13" style="v" sid="NUM 33:13" />Kulawa Dofika waghenda kwika ndalo ako Alushi. <verse eid="NUM 33:13" /><verse number="14" style="v" sid="NUM 33:14" />Tsawoka kulawa Alushi na waghenda kwika indalo ya ako Refidimu, ako Refidimu tsakuduhu ghamatsi gho kunwa iwanu. <verse eid="NUM 33:14" /><verse number="15" style="v" sid="NUM 33:15" />Tsawoka Refidimu, waghende kwika indalo yao mna inyika ya Sinai. <verse eid="NUM 33:15" /><verse number="16" style="v" sid="NUM 33:16" />Woka kulawa mna inyika ya Sinai, waghenda kwika indalo yao ako Kibroti Hataava. <verse eid="NUM 33:16" /><verse number="17" style="v" sid="NUM 33:17" />Kulawa Kibroti Hataava, waghenda kwika indalo yawo ako Haseloti. <verse eid="NUM 33:17" /><verse number="18" style="v" sid="NUM 33:18" />Woka Haseloti, na waghenda kwika indalo yao ako Ritima. <verse eid="NUM 33:18" /><verse number="19" style="v" sid="NUM 33:19" />Tsawoka kulawa Ritima na wapfika Limoni Pelezi, kuko weka ndalo yao. <verse eid="NUM 33:19" /><verse number="20" style="v" sid="NUM 33:20" />Kulawa Limoni Pelezi, tsawaghenda kwika ndalo yao ako Libina. <verse eid="NUM 33:20" /><verse number="21" style="v" sid="NUM 33:21" />Kulawa Libina tsawaghenda kwika ndalo yao ako Lisa. <verse eid="NUM 33:21" /><verse number="22" style="v" sid="NUM 33:22" />Tsawoka kulawa Lisa na waghenda kwika indalo yao ako Kehalata. <verse eid="NUM 33:22" /><verse number="23" style="v" sid="NUM 33:23" />Kulawa Kehalata, tsawaghenda kuchidunda Shefeli, na kuko weka ndalo yao. <verse eid="NUM 33:23" /><verse number="24" style="v" sid="NUM 33:24" />Kulawa kuchidunda Shefeli tsawaghenda kwika indalo yao ako Halada. <verse eid="NUM 33:24" /><verse number="25" style="v" sid="NUM 33:25" />Na woka kulawa Halada waghenda Makeloti, ako nako weka indalo yao. <verse eid="NUM 33:25" /><verse number="26" style="v" sid="NUM 33:26" />Kulawa Makeloti waghenda kwika indalo yao ako Tahati. <verse eid="NUM 33:26" /><verse number="27" style="v" sid="NUM 33:27" />Woka kulawa Tahati waghenda kwika indalo yao Tera. <verse eid="NUM 33:27" /><verse number="28" style="v" sid="NUM 33:28" />Kulawa Tera waghenda kwika indalo yao ako Mitika. <verse eid="NUM 33:28" /><verse number="29" style="v" sid="NUM 33:29" />Woka kulawa Mitika, na wapfika Hashimona, kuko weka indalo yao. <verse eid="NUM 33:29" /><verse number="30" style="v" sid="NUM 33:30" />Kulawa Hashimona waghenda kwika ndalo yao ako Moseroti. <verse eid="NUM 33:30" /><verse number="31" style="v" sid="NUM 33:31" />Kulawa Moseroti waghenda kwika indalo yao ako Bene Yakani. <verse eid="NUM 33:31" /><verse number="32" style="v" sid="NUM 33:32" />Woka ako Bene Yakani na wapfika Holi Hagidigadi, kuko weka indalo yao. <verse eid="NUM 33:32" /><verse number="33" style="v" sid="NUM 33:33" />Kulawa Hori Hagidigadi tsawaghenda kwika indalo ako Yoti Bata. <verse eid="NUM 33:33" /><verse number="34" style="v" sid="NUM 33:34" />Kulawa Yoti Bata waghenda kwika indalo yao ako Abirona. <verse eid="NUM 33:34" /><verse number="35" style="v" sid="NUM 33:35" />Woka ako Abirona, waghenda Esioni Geberi, na kuko weka indalo yao. <verse eid="NUM 33:35" /><verse number="36" style="v" sid="NUM 33:36" />Kulawa ako Esioni Geberi tsawaghenda na wapfika Kadeshi iili mna inyika ya Sini, kuko weka indalo yao. <verse eid="NUM 33:36" /><verse number="37" style="v" sid="NUM 33:37" />Kulawa ako Kadeshi tsawoka mbaka wapfika kuchidunda Hori, kune ghumbaka ghwa isi ya Edomu. <verse eid="NUM 33:37" /><verse number="38" style="v" sid="NUM 33:38" />Kwa laghitso lya IMNDEWA mtambika Aruni tsakagheluka kuchidunda Hori, na kuko kafa mna tsuwa lya mwanduso la mwetsi ghwa tano mna ghumwaka ghwa alubaini kulawa Waisiraeli hawalawile mna isi ya Misili. <verse eid="NUM 33:38" /><verse number="39" style="v" sid="NUM 33:39" />Aruni tsakafa aku kana miyaka miya imwe na ishilini na midatu mna chidunda Hori. <verse eid="NUM 33:39" /><verse number="40" style="v" sid="NUM 33:40" />Mfalume wa Aradi, Mkanaani iyakalile ubali wa Kusini wa isi ya Kanaani, tsakahulika ka Waisiraeli wang'ali wakutsa. <verse eid="NUM 33:40" /><verse number="41" style="v" sid="NUM 33:41" />Kulawa chidunda Hori, waghenda kwika indalo yao Salimona. <verse eid="NUM 33:41" /><verse number="42" style="v" sid="NUM 33:42" />Kulawa Salimona waghenda kwika indalo yao ako Punoni. <verse eid="NUM 33:42" /><verse number="43" style="v" sid="NUM 33:43" />Woka ako Punoni na waghenda Oboti, kuko weka ndalo yao. <verse eid="NUM 33:43" /><verse number="44" style="v" sid="NUM 33:44" />Kulawa Oboti waghendelela na ghwamwanza ghwao mbaka wapfika Lye Abarimu, kwaibakane na Moabu, kuko weka indalo yao. <verse eid="NUM 33:44" /><verse number="45" style="v" sid="NUM 33:45" />Kulawa Lye Abaimu tsawaghenda kwika indalo yao Diboni Gadi. <verse eid="NUM 33:45" /><verse number="46" style="v" sid="NUM 33:46" />Kulawa Diboni Gadi tsawaghenda na wapfika Almoni Diblataimu, weka ndalo. <verse eid="NUM 33:46" /><verse number="47" style="v" sid="NUM 33:47" />Kulawa Almoni Diblataimu tsawaghendelela na ghumwanza ghwao mbaka wapfika mna pfidunda pfa Abalimu, habehi na chidunda Nebo, kuko weka ndalo yao. <verse eid="NUM 33:47" /><verse number="48" style="v" sid="NUM 33:48" />Kulawa mna pfidunda pfa Abarimu, tsawaghenda kwika indalo yao mna ichiwala cha Moabu, kumwambu kwa ghumto ghwa Yoridani, habehi na Yeriko. <verse eid="NUM 33:48" /><verse number="49" style="v" sid="NUM 33:49" />Tsaweka indalo habehi na ghumto ghwa Yoridani haghati ya Beti Yesimoti na lwanda lwa Abeli Shitimu.<verse eid="NUM 33:49" /></para>
  <para style="s">Malaghitso ng'ana wengile Kanaani</para>
  <para style="p">
    <verse number="50" style="v" sid="NUM 33:50" />Kuya IMNDEWA kalonga na Musa mna chiwala cha Moabu, kumwambu mwa ghumto Yoridani, habehi na Yeriko, kamlongela, <verse eid="NUM 33:50" /><verse number="51" style="v" sid="NUM 33:51" />“Walongele Waisiraeli hawatsoloka ghumto ghwa Yoridani na kwingila mna isi Kanaani, <verse eid="NUM 33:51" /><verse number="52" style="v" sid="NUM 33:52" />wawingeni wenye kaye wose we isi ayo ili hambele henu, mpfihinye pfinyagho pfao pfose pfa kusongola na apfila pfa kufina hanu hawotambikila. <verse eid="NUM 33:52" /><verse number="53" style="v" sid="NUM 33:53" />Namwe mtsoisola is ayo iwe yenu na mtsokala mumo, kwaapfila niweng'a isi ayo iwe yenu. <verse eid="NUM 33:53" /><verse number="54" style="v" sid="NUM 33:54" />Muighole isi ayo kwa kwasa tsisimbi mchanya tsilamle, lukolo lune wanu wengi lutsobokela hanu hakulu, na alula lune wanu chidogho lutsobokela hanu hadodo, tsisimbi tsing'amlaghalila munu wowose, aho hanu hakwake, mtsoisola isi kwa kulola tsikabila tsa aba tsenu. <verse eid="NUM 33:54" /><verse number="55" style="v" sid="NUM 33:55" />Lekeni ka ng'amuwawinga baye wenyekaye we isi ayo, awala wamtsowaleka watsakuwa ka chibanzi mna tsinenge tsenu na ka mihonga mna tsimbapfu tsenu, nawo watsowasupfa mna isi ayo yamkala. <verse eid="NUM 33:55" /><verse number="56" style="v" sid="NUM 33:56" />Na ka ng'amuwawinga baye nene nitsowatenda ka pfanibamile kuwatenda wao.”<verse eid="NUM 33:56" /></para>
  <chapter eid="NUM 33" />
  <chapter number="34" style="c" sid="NUM 34" />
  <para style="s">Imibaka ye isi</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 34:1" />Imfalume kamlongela Musa, <verse eid="NUM 34:1" /><verse number="2" style="v" sid="NUM 34:2" />“Uwalaghitse Waisiraeli na uwalongele, ‘Hamkwingila mna isi ya Kanani, isi yanimwing'ani iwe yenu, imibaka ye isi yenu iwe pfino, <verse eid="NUM 34:2" /><verse number="3" style="v" sid="NUM 34:3" />ubali wa kusini ghumbaka ghwenu ghutsolawa mna inyika ya Sini, na ghutsobita mmbalimbali mwa Edomu, ghutsakwanzila ubali wa kusini kwaitsigha ibahali ye Munyu. <verse eid="NUM 34:3" /><verse number="4" style="v" sid="NUM 34:4" />Kuya utsohunduka na kughenda Akirabini, na ghutsopfosa Sini na kutsighila kadeshi Barinea, kuya ghutsoghenda, Hazari Adari na kupfika Azimoni, <verse eid="NUM 34:4" /><verse number="5" style="v" sid="NUM 34:5" />na kulawa Azimoni ghutsohunduka na kughenda kune chikolongo cha Misili, na ghutsosigha hane ibahali ya Mediterania. <verse eid="NUM 34:5" /><verse number="6" style="v" sid="NUM 34:6" />Ghumbaka ghwenu ghwa ubali wa maghalibi ghutsakwanzila ibahali ya Mediterania. <verse eid="NUM 34:6" /><verse number="7" style="v" sid="NUM 34:7" />Na ghumbaka ghwenu ghwa ubali wa kasikasini ghutsolawa ibahali ya Mediterania na ghutsopfika hane chidunda Hori. <verse eid="NUM 34:7" /><verse number="8" style="v" sid="NUM 34:8" />Kulawa hane chidunda Hori ghumbaka ghutsopfika hane nzila ighenda Hamati, na ghutsoghenda Sedadi, <verse eid="NUM 34:8" /><verse number="9" style="v" sid="NUM 34:9" />kuko ghutsakwang'ila Zifuloni na kutsighila Hazali Enani. Aghwo ghutsakuwa ghumbaka ghwenu ghwa Kasikazini. <verse eid="NUM 34:9" /><verse number="10" style="v" sid="NUM 34:10" />Ghumbaka ghwenu ghwa ubali wa Mashaliki ghutsakwanzila Hazari Enani na ghutsopfika Sefamu. <verse eid="NUM 34:10" /><verse number="11" style="v" sid="NUM 34:11" />Kulawa Sefamu ghutsohulumka na kughenda Libila, ubali wa mashaliki wa Aini, na ghutsohulumka keli na kupfika kune ibahali ya Kinereti ubali wa Mashaliki. <verse eid="NUM 34:11" /><verse number="12" style="v" sid="NUM 34:12" />Kuya ghutsohulumka na kupfika kune ghumto Yoridani na ghutsotsigha hane ibahali ya Munyu. Aino iyo isi yenu na imibaka yake itsinguluka.’ ” <verse eid="NUM 34:12" /><verse number="13" style="v" sid="NUM 34:13" />Apfo Musa kawalongela Waisiraeli, “Aino iyo isi yamtsosola iwe yenu kwa kwasa sisimbi tsilamle, isi Imfalume iyalaghitse weng'ighwe ghamakabila tisa na nusu. <verse eid="NUM 34:13" /><verse number="14" style="v" sid="NUM 34:14" />Likabila lya Rubeni, na lya Gadi, nusu ya likabila lya Manase tsabokela isi yao kwa kulola kolo tsao tsowolawa. <verse eid="NUM 34:14" /><verse number="15" style="v" sid="NUM 34:15" />Ghamakabila agho meli na nusu tsawabokela isi yao ihili kumwambu kwa ghumto Yolidani, akula kwalilawila Litsuwa.”<verse eid="NUM 34:15" /></para>
  <para style="s">Pfilongotsi iwatsoghola isi</para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 34:16" />Imfalume kamlongela Musa, <verse eid="NUM 34:16" /><verse number="17" style="v" sid="NUM 34:17" />“Mtambika Eliazali na Yoshua mwana wa Nuni wawo iwatsowagholela isi iwe yenu. <verse eid="NUM 34:17" /><verse number="18" style="v" sid="NUM 34:18" />Pfipfila kutsosola chilongotsi yumwe kulawa mna chila kabila yakwapfile mna ukughola isi. <verse eid="NUM 34:18" /><verse number="19" style="v" sid="NUM 34:19" />Aghano ghagho ghamataghwa ghao, Likabila lya Yuda, kasolighwa Kalebu mwana wa Yefune. <verse eid="NUM 34:19" /><verse number="20" style="v" sid="NUM 34:20" />Likabila lya Simeoni, kasolighwa Shemueli mwana wa Amihudi. <verse eid="NUM 34:20" /><verse number="21" style="v" sid="NUM 34:21" />Likabila lya Benjamini, kasolighwa Elidadi mwana wa Kisiloni. <verse eid="NUM 34:21" /><verse number="22" style="v" sid="NUM 34:22" />Likabila la Dani, kasolighwa Buki mwana wa Yogili. <verse eid="NUM 34:22" /><verse number="23" style="v" sid="NUM 34:23" />Likabila la Manase mwana wa Yosefu, kasolighwa Hanieli mwana wa Efodi. <verse eid="NUM 34:23" /><verse number="24" style="v" sid="NUM 34:24" />Likabila lya Efuremu mwana wa Yosefu, kasolighwa Kemueli mwana wa Shifutani. <verse eid="NUM 34:24" /><verse number="25" style="v" sid="NUM 34:25" />Likabila lya Zebuluni, kasolighwa Elisafani mwana wa Parinaki. <verse eid="NUM 34:25" /><verse number="26" style="v" sid="NUM 34:26" />Likabila la Isakari, kasolighwa Palitieli mwana wa Azani. <verse eid="NUM 34:26" /><verse number="27" style="v" sid="NUM 34:27" />Likabila lya Asheri, kasolighwa Alihudi mwana wa Shelomi. <verse eid="NUM 34:27" /><verse number="28" style="v" sid="NUM 34:28" />Likabila lya Nafutali, kasolighwa Pedaheli mwana wa Amihudi. <verse eid="NUM 34:28" /><verse number="29" style="v" sid="NUM 34:29" />Iwanu wano wawo IMNDEWA iyawalaghitse wawagholele iwanu isi Kanani iwe ulisi wawo.”<verse eid="NUM 34:29" /></para>
  <chapter eid="NUM 34" />
  <chapter number="35" style="c" sid="NUM 35" />
  <para style="s">Imiji yaweng'ighwe Walawi</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 35:1" />Kuya IMNDEWA tsakalonga na Musa kune chiwala cha Moabu, kumwambu kwa ghumto Yoridani, habehi na Yeriko, kamlongela, <verse eid="NUM 35:1" /><verse number="2" style="v" sid="NUM 35:2" />“Uwalaghitse Waisiraeli waweng'e Walawi imjiji yo kukala, na mighunda ya kudimila imifugho yawo, iili mmbambali mwe imiji yao, waweng'e kulawa mna isi yaweng'ighwe iwe yao. <verse eid="NUM 35:2" /><verse number="3" style="v" sid="NUM 35:3" />Nawo watsopata imiji yo kukala na mighunda yo kudimila iwang'ombe na mifugho yao na iwanyama wangi. <verse eid="NUM 35:3" /><verse number="4" style="v" sid="NUM 35:4" />Imighuda ya kudimila imifugho yao itsunguluka imiji yao itsakuwa na utali wa futi elufu imwe na miya tano chila ubali kulawa hane ubanda we ghumji. <verse eid="NUM 35:4" /><verse number="5" style="v" sid="NUM 35:5" />Apfo isi ayo ya kudimila itsakuwa na utali wa futi elufu ndatu chila ubali we ghumji, na ghumji ghwenyegho ghutsokala haghati ghati, na isi ayo yakuwa ya kudimila na yokala mmbalimbali mwe ghumji. <verse eid="NUM 35:5" /><verse number="6" style="v" sid="NUM 35:6" />Pfipfila muweng'e Walawi imiji sita yo kutsumila, ahala imunu yang'amkoma miyaghe gila, Muwongetse imiji alubaini na mili. <verse eid="NUM 35:6" /><verse number="7" style="v" sid="NUM 35:7" />Apfo imiji yoseyose yamtsoweng'a Walawi itsopfika alubaini na minane, mtsoweng'a imiji ayo hamwe na mighunda ya kudimila mifugho yao. <verse eid="NUM 35:7" /><verse number="8" style="v" sid="NUM 35:8" />Imjiji yamtsoweng'a Walawi kulawa mna isi yamwing'ighwe ilingane na ukulu wa ghamakabila, likabila line wanu wengi lutsolapfa imiji mingi, na likabila line wanu chidogho litsolapfa imiji chidogho. Chila kabila litsolapfa imiji iwe ya Walawi, kwa kulola ukulu we isi iweng'ighwe pfauli.”<verse eid="NUM 35:8" /></para>
  <para style="s">Imiji ya ukutsumila</para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 35:9" />IMNDEWA kamlongela Musa, <verse eid="NUM 35:9" /><verse number="10" style="v" sid="NUM 35:10" />Uwalongele Waisiraeli pfino, “Hawoloka ghumto Yoridani na kwingila mna isi ya Kanaani, <verse eid="NUM 35:10" /><verse number="11" style="v" sid="NUM 35:11" />msaghule imiji iwe yo kutsumila, imunu yang'amkoma gila miyaghe yadahe kutsumila kuko. <verse eid="NUM 35:11" /><verse number="12" style="v" sid="NUM 35:12" />Imiji ayo yo kutsumila iwe yakumkinga imunu iyamkomile miyaghe ili naye yaleke kukomingwa na ndugu tsake imunu yula iyakomighwe, ng'ana lighomba lyake lihighighwe baye na Waisiraeli. <verse eid="NUM 35:12" /><verse number="13" style="v" sid="NUM 35:13" />Muibaghule imiji ayo sita yo kutsumila. <verse eid="NUM 35:13" /><verse number="14" style="v" sid="NUM 35:14" />Kulawa mna ayo sita, imiji midatu yamtsoweng'a iwe kumwambu kwa Yoridani, na imiji ingi midatu iwe mna isi ya Kanaani. Ayo iwe ya kutsumila. <verse eid="NUM 35:14" /><verse number="15" style="v" sid="NUM 35:15" />Imiji ayo sita iwe ya kutsumila iwanu wa Isiraeli na iwagheni wamkala nawo, ili chila munu iyomkoma miyaghe aku ng'abamile kumkoma baye yatsumile kuko.” <verse eid="NUM 35:15" /><verse number="16" style="v" sid="NUM 35:16" />Lekeni ka imunu komtowa miyaghe kwa chuma mbaka kakufa, ayo kakoma, naye pfipfila yakomighwe. <verse eid="NUM 35:16" /><verse number="17" style="v" sid="NUM 35:17" />Imunu yang'amtowa miyaghe kwa libwe mbaka kakufa, ayo kakoma, naye pfipfila yakomighwe <verse eid="NUM 35:17" /><verse number="18" style="v" sid="NUM 35:18" />Na ka kamtowa miyaghe kwa libiki ilili mmoko mwake mbaka kakufa, ayo kakoma, naye pfipfila yakomighwe <verse eid="NUM 35:18" /><verse number="19" style="v" sid="NUM 35:19" />Ndughu yake wa habehi kobamighwa kumkoma imunu ayo, indughu yake yang'etingana naye, katsomkoma. <verse eid="NUM 35:19" /><verse number="20" style="v" sid="NUM 35:20" />Pfipfila ka imunu komwihila miyaghe kuya komkunughitsa, au komwasila chinu aku komwembela, mbaka kakufa, <verse eid="NUM 35:20" /><verse number="21" style="v" sid="NUM 35:21" />au komtowa kwa ghumoko ghwake mbaka kakufa, ayo iyamtowile miyaghe yakomighwe. Indughu we imunu ayo iyakomighwe katsomkoma ahala hayatsetingana naye. <verse eid="NUM 35:21" /><verse number="22" style="v" sid="NUM 35:22" />Lekeni ka imunu kamkunughitsa miyaghe kwa kwidukitsa aku ng'omwihila baye au komwasila chinu, <verse eid="NUM 35:22" /><verse number="23" style="v" sid="NUM 35:23" />au imunu yang'asa ilibwe ilidaha kumkoma, naye ng'amwihile baye wala ng'abamile baye kumlagha, <verse eid="NUM 35:23" /><verse number="24" style="v" sid="NUM 35:24" />aho wanu wa Isiraeli watsohigha lighomba lya imunu yula iyakomile na ayula iyobama kumkoma iyamkomile ndughu yake kwa kulola ghamalaghitso ghano. <verse eid="NUM 35:24" /><verse number="25" style="v" sid="NUM 35:25" />Ghumtingano ghutsomkombola imunu ayo iyakomile kulawa mna ghamoko ghe ndughu wa imunu yula iyakomighwe, wamuyitse mna ghumji ghwa kutsumila, kwayang'ali yotsumila. Katsokala kuko mbaka hayakufa imtambika iyasaghulighwe kwa kughelighwa ghamapfuta. <verse eid="NUM 35:25" /><verse number="26" style="v" sid="NUM 35:26" />Lekeni ayo iyakomile yang'alawa kunze kwe ghumji agho ghwayatsumilile, <verse eid="NUM 35:26" /><verse number="27" style="v" sid="NUM 35:27" />na ndughu we munu iyakomighwe yang'etingana naye kunze kwe imibaka ye ghumji agho, na yang'amkoma, indughu ayo kahela totso lyo kukoma. <verse eid="NUM 35:27" /><verse number="28" style="v" sid="NUM 35:28" />Kwaapfila imunu iyakomile tsakabamighwa yakale mna ghumji ghwayatsumilile mbaka hayakufa mtambika mkulu, lekeni mtambika mkulu yang'afa aho imunu yula iyakomile miyaghe kodaha kuya kune isi iyeng'ighwe iwe ulisi wake. <verse eid="NUM 35:28" /><verse number="29" style="v" sid="NUM 35:29" />Mghakinde ghamalaghitso ghano mna ipfeleko pfenu pfose na kwokwose kula kwa mtsokala.<verse eid="NUM 35:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 35:30" />“Imunu wowose iyakomile imunu, naye katsokomighwa ka iwanu weli au wengi tsawona chinu acho, munu wowose yaleke kuihighighwa yafe kwa kumtegheletsa munu yumwe. <verse eid="NUM 35:30" /><verse number="31" style="v" sid="NUM 35:31" />Mleke kubokela maliho ghoghose kuukombola ughima we munu iyoneke kakoma miyaghe, ayo kobamighwa yakomighwe. <verse eid="NUM 35:31" /><verse number="32" style="v" sid="NUM 35:32" />Mleke kubokela wala kutoghola maliho ghoghose ghala kulawa kwa munu iyatsumile mna ghumji gho kutsumila, ili yoye mna isi yake aku mtambika mkulu ng'ana yafe baye. <verse eid="NUM 35:32" /><verse number="33" style="v" sid="NUM 35:33" />Mng'atenda apfo namwe mtsoitenda isi yamkala ihe. Ukwikoma koitenda isi ihe, na kuduhu inambiko ilapfighwa iwe ya kuileghusila inzambi isi kwa kumwaghika idamu ila kwa kumkoma imunu ayula iyakomile. <verse eid="NUM 35:33" /><verse number="34" style="v" sid="NUM 35:34" />Nene na IMNDEWA, na nokala mna Waisiraeli, apfo mleke kuitenda isi ihe kwa ukwikoma.”<verse eid="NUM 35:34" /></para>
  <chapter eid="NUM 35" />
  <chapter number="36" style="c" sid="NUM 36" />
  <para style="s">Ulisi wa iwapinga iwakwelighwe</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 36:1" />Pfilongotsi wangi iwolawila mna tsikolo tsa Gilieadi, mwana wa Makili, naye Makili tsamwana wa Manase, naye Manase tsa mwana ya Yosefu, awo wasoghela hambele ha Musa na hambele ha pfilingotsi wa tsikolo tsa Isiraeli <verse eid="NUM 36:1" /><verse number="2" style="v" sid="NUM 36:2" />Walonga, “IMNDEWA kowalaghitsa muwagholele Waisiraeli isi kwa kwasa tsisimbi mchanya tsilamle. Pfipfila kowalaghitsa uweng'e neghe Zelofehadi iyali ndughu yetu, isi ya aba wao. <verse eid="NUM 36:2" /><verse number="3" style="v" sid="NUM 36:3" />Lekeni ka wang'akwelighwa na wamale iwolawila mna ghamakabila ghangi gha Isiraeli, isi yaweng'ighwe iwahenga wa likabila letu itsosolighwa na makabila ghe wamale wao, apfo isi yawapatile iwahenga wa likabila letu itsohunguka. <verse eid="NUM 36:3" /><verse number="4" style="v" sid="NUM 36:4" />Hachipfika chihungo cha miyaka hamsini, ahala tsimali itsihutsighwe hatsikuhitsighwa, isi ya neghe Zelofehadi itsosolighwa na likabila lye wamale wala iwatsowakwela na isi ya ulisi yaweng'ighwe iwahenga wa likabila lyetu itsohunguka.” <verse eid="NUM 36:4" /><verse number="5" style="v" sid="NUM 36:5" />Apfo Musa kaweng'a Waisiraeli laghitso lino kulawa kwe IMNDEWA, kawalongela, “Iwanu wa lukolo lwa Yusufu wolongesa ghengo.” <verse eid="NUM 36:5" /><verse number="6" style="v" sid="NUM 36:6" />Apfi pfipfo IMNDEWA pfayolaghitsa mna lighomba lya neghe tsake Zelofehadi, kalonga, “Wakwelighwe na munu wowose iwombama, lekeni wakwelighwe na munu wa tsikolo tsa aba tsao, <verse eid="NUM 36:6" /><verse number="7" style="v" sid="NUM 36:7" />wang'atenda apfo, isi ya Waisiraeli ng'aitsohamila baye kune likabila lingi, kwaapfila chila Muisiraeli katsokala mna isi ya lukolo lwa aba wake. <verse eid="NUM 36:7" /><verse number="8" style="v" sid="NUM 36:8" />Chila mwana ipinga iyosola isi iwe ulisi wake mna likabila lya Isiraeli kobamighwa yakwelighwe na mmale iyolawa mna likabila lya aba wake, ili chila Muisiraeli yakale mna isi ya ulisi wa aba wake. <verse eid="NUM 36:8" /><verse number="9" style="v" sid="NUM 36:9" />Apfo kutsakuwa kuduhu isi itsolawa likabila limwe na ighende likabila lingi, kwaapfila chila likabila lya wanu wa Isiraeli litsokala kune isi yake.” <verse eid="NUM 36:9" /><verse number="10" style="v" sid="NUM 36:10" />Apfo neghe tsake Zelofehadi tsawatenda ka IMNDEWA pfayamlaghitse Musa. <verse eid="NUM 36:10" /><verse number="11" style="v" sid="NUM 36:11" />Apfo wose Mala, Tilisa, Hogila, Milika na Noa tsawakwelighwa na wana wa aba tsao wadodo na wakulu. <verse eid="NUM 36:11" /><verse number="12" style="v" sid="NUM 36:12" />Tsawakwelighwa mna lukolo lwa likabila lya Manase, imwana wa Yosefu, na isi yawo ighendelela kukala mna likabila lya aba wao. <verse eid="NUM 36:12" /><verse number="13" style="v" sid="NUM 36:13" />IMNDEWA tsakawalaghitsa Waisiraeli ghamalaghitso ghano na imiko ino kubitila Musa mna chiwala cha Moabu, kumwambu kwa ghumto Yoridani habehi na Yeriko.<verse eid="NUM 36:13" /></para>
  <chapter eid="NUM 36" />
</usx>