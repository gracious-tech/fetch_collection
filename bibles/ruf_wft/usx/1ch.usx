<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1CH" style="id">- Lugulu Bible Version 1TH DRAFT</book>
  <para style="h">1 ICHITABU CHA MWANDUSO CHA IGHALAWILE MMATSUWA</para>
  <para style="toc1">Ichitabu cha mwanduso cha ighalawile mmatsuwa</para>
  <para style="toc2">Mmatsuwa</para>
  <para style="toc3">1 Mmats</para>
  <para style="mt1">MMASTUWA</para>
  <para style="imt1">Ichilongole</para>
  <para style="ip">Ipfitabu pfino apfili, cha mwanduso na chakeli cha aghala ighalawile mna imiyaka ghumwande tsachiwa chitabu chimwe chikulu. Tsachanza ukugholeka chiwe pfitabu pfili ahala Ibibilia ya Chiyeburania hayanzile kwandikighwa kwa Chiyunani na kukemighwa Septuajinti. Iwanu wengi iwasomile wotoghola ghendo ka Ezira yuyo iyandike na ukutunga ichitabu cha mwanduso na cha keli cha aghala ighalawile mna imiyaka, na ichitabu cha Ezira na Nehemiya. Imwandishi tsakasola simulitsi itsili mna pfitabu pfa Samweli na wafalume hayandike ipfitabu apfino pfili. Iwanu wengi iwasomile pfipfila wotoghola ghendo ka pfitabu apfino tsapfandikighwa mna inusu ya keli ya ikaline ya tano, ng'ana Yesu yoneke baye, mna miyaka Ezira iyakalile mgima.</para>
  <para style="ip">Ichitabu cha mwanduso na chakeli cha aghala ighalawile mna imiyaka chakwanza kwa kutupetela silimulitsi tsa iwahenga wetu kwanzila Adamu mbaka Aburahamu na ukwanza kwa isi ya wanu wa Isiraeli mbaka ghamatsuwa ghala Waisiraeli hawoyile kulawa kuna isi ya utumwa. Kuya ichitabu choghendelela kutupetela isimo ya Waisiraeli kulawa haumalile utawala wa mfalume Sauli mbaka ukughwa kwa ghumji ghwa Yerusalemu. Mna ichitabu chose, imwandishi kotulongela ing'anda ya Imulungu ili Yerusalemu. Daudi tsakeka pfinu pfa ukutsengela ing'anda ya Imulungu na Selemani imwanaghe tsakapfitsengela ing'anda ayo. Imwandishi pfipfila kotulongela apfila ing'anda ya Imulungu pfaihinyighwe na ipfinu pfake pfapfisolighwe. Mna imistali ghumwe ghwa ichitabu cha keli cha aghala ighalawile mna ghamatsuwa imwandishi komalitsa kwa ukutulongela apfila ing'anda ya Imulungu pfaitsotsengighwa keli.</para>
  <para style="iot">Ighali mna ichitabu cha mwanduso</para>
  <para style="io">Isura 1-9 yotupetela silimulitsi tsa iwahenga wetu kwanzila Adamu mbaka Waisiraeli hawoyile kulawa kuna isi ya utumwa</para>
  <para style="io">Isura ya 10-29 yotulongela apfila Daudi pfayakalile na pfayailongotse isi ya Isiraeli.</para>
  <para style="iot">Ighali mna ichitabu cha keli</para>
  <para style="io">Isura 1-9 yotulongela apfila Solomoni, mfalume wa Isiraeli pfayakalile na pfayatawale</para>
  <para style="io">Isura ya 10-39 tsotulongela apfila iwanu wa isi ya Isiraeli na Yuda pfawagholeke na tsotulongela simulitsi tsa iwafalume iwatawale Yuda kulawa ghamatsuwa aghala mbaka wafalume pfawahumile.</para>
  <chapter number="1" style="c" sid="1CH 1" />
  <para style="s">Kulawa Adamu mbaka Abrahamu</para>
  <para style="r">(<ref loc="GEN 5:1-32">Mwand 5:1-32</ref>; <ref loc="GEN 10:1-32">Mwand 10:1-32</ref>; <ref loc="GEN 11:10-26">Mwand 11:10-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 1:1" />Adamu tsakamweleka Seti, naye Seti tsakamweleka Enoshi, Enoshi tsakamweleka Kenani, <verse eid="1CH 1:1" /><verse number="2" style="v" sid="1CH 1:2" />Kenani tsakamweleka Mahalaleli, Mahalaleli tsakamweleka Yaredi, <verse eid="1CH 1:2" /><verse number="3" style="v" sid="1CH 1:3" />Yaredi tsakamweleka Henoki, Henoki tsakamweleka Metusela, Metusela tsakamweleka Lameki.<verse eid="1CH 1:3" /></para>
  <para style="li">
    <verse number="4" style="v" sid="1CH 1:4" />Lameki tsakamweleka Noa. Noa tsakana wana wadatu: Shemu, Hamu na Yafeti.<verse eid="1CH 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 1:5" />Iwanaghe Yafeti,</para>
  <para style="q" vid="1CH 1:5">tsa Gomeri, Magogu, Madai, Yavani, Tubali, Mesheki na Tirasi.<verse eid="1CH 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="1CH 1:6" />Wanaghe Gomeri</para>
  <para style="q" vid="1CH 1:6">tsa Ashikenasi, Difati na Togama. <verse eid="1CH 1:6" /><verse number="7" style="v" sid="1CH 1:7" />Iwanaghe Yavani,</para>
  <para style="q" vid="1CH 1:7">tsa Elisha, Tarishishi, Kitimu na Rodanimu. <verse eid="1CH 1:7" /><verse number="8" style="v" sid="1CH 1:8" />Iwanaghe Hamu</para>
  <para style="q" vid="1CH 1:8">tsa Kushi, Misri, Puti na Kanaani. <verse eid="1CH 1:8" /><verse number="9" style="v" sid="1CH 1:9" />Iwanaghe Kushi,</para>
  <para style="q" vid="1CH 1:9">tsa Seba, Havila, Sabita, Raama na Sabiteka. Iwanaghe Raama,</para>
  <para style="q" vid="1CH 1:9">tsa Sheba na Dedani.<verse eid="1CH 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 1:10" />Kushi tsakamweleka Nimrodi, imunu iyadahile ukwitowa pfinoghile muisi mwose.<verse eid="1CH 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 1:11" />Misri tsakaweleka iwanu wa lukolo lwa Waludi, Waanamu, Walehabi, Wanafituhi, <verse eid="1CH 1:11" /><verse number="12" style="v" sid="1CH 1:12" />Wapatirusi, Wakasiluhi, na Wakafitori, Wafilisti tsawalawila kuna iwanu awano. <verse eid="1CH 1:12" /><verse number="13" style="v" sid="1CH 1:13" />Iwana wa Kanaani tsa Sidoni iyali chaudele wake, na Heti. <verse eid="1CH 1:13" /><verse number="14" style="v" sid="1CH 1:14" />Pfipfila Kanaani tsa sekulu wawo Wayebusi, Waamori, Wagirigashi, <verse eid="1CH 1:14" /><verse number="15" style="v" sid="1CH 1:15" />Wahivi, Waariki, Wasini, <verse eid="1CH 1:15" /><verse number="16" style="v" sid="1CH 1:16" />Waarivadi, Wasemari, na Wahamati.<verse eid="1CH 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 1:17" />Iwana wa Shemu tsa Elamu, Ashuri, Aripakisadi, Ludi, Aramu, Usi, Huli, Geteri na Mashi. <verse eid="1CH 1:17" /><verse number="18" style="v" sid="1CH 1:18" />Aripakisadi tsakamweleka Shela, naye Shela tsakamweleka Eberi. <verse eid="1CH 1:18" /><verse number="19" style="v" sid="1CH 1:19" />Eberi tsakana wana wamale weli: yumwe tsakakemighwa Pelegi. Taghwa alino mana yake ukugholeka, kwaapfila mna ghamatsuwa ghake isi tsaigholeka, na mdodo wake tsakakemighwa Yokitani. <verse eid="1CH 1:19" /><verse number="20" style="v" sid="1CH 1:20" />Aghuno ghugho mweleko ghwa Yokitani: Alimodadi, Shelefu, Hasarimaweti, Yera, <verse eid="1CH 1:20" /><verse number="21" style="v" sid="1CH 1:21" />Hadoramu, Uzali, Dikila, <verse eid="1CH 1:21" /><verse number="22" style="v" sid="1CH 1:22" />Ebali, Abimaeli, Sheba, <verse eid="1CH 1:22" /><verse number="23" style="v" sid="1CH 1:23" />Ofiri, Havila na Yobabu.<verse eid="1CH 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 1:24" />Aluno lulo lweleko lwa Abrahamu kulawa kwa Shemu: Shemu tsakamweleka Aripakisadi, naye Aripaksadi tsakamweleka Shela. <verse eid="1CH 1:24" /><verse number="25" style="v" sid="1CH 1:25" />Shela tsakamweleka Eberi na Eberi tsakamweleka Pelegi, naye Pelegi tsakamweleka Reu, <verse eid="1CH 1:25" /><verse number="26" style="v" sid="1CH 1:26" />Reu tsakamweleka Serugi na Serugi tsakamweleka Nahori, naye Nahori tsakamweleka Tera, <verse eid="1CH 1:26" /><verse number="27" style="v" sid="1CH 1:27" />na Tera tsakamweleka Abramu, ayo yuyo hambele iyakemighwe Abrahamu.<verse eid="1CH 1:27" /></para>
  <para style="s">Mweleko ghwa Isumaili</para>
  <para style="r">(<ref loc="GEN 25:12-16">Mwand 25:12-16</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 1:28" />Abrahamu tsakana wana wamale weli: Isaka na Isumaili. <verse eid="1CH 1:28" /><verse number="29" style="v" sid="1CH 1:29" />Aluno lulo lweleko lwa Isumaili: Imwanaghe chaudele tsakakemighwa Nebayoti, kuya koneka Kedari, Adibeeli, Mibisamu, <verse eid="1CH 1:29" /><verse number="30" style="v" sid="1CH 1:30" />Mishima, Duma, Masa, Hadadi, Tema, <verse eid="1CH 1:30" /><verse number="31" style="v" sid="1CH 1:31" />Yeturi, Nafishi na Kedema. Awano wawo iwana wa Isumaili.<verse eid="1CH 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 1:32" />Abrahamu tsakana pinga mdodo iyakemighwe Ketura. Ketura tsakamwelekela Abrahamu iwana wano: Zimrani, Yokisani, Medani, Midiani, Ishibaki na Shua. Iwana wa Yokisani tsa Sheba na Dedani. <verse eid="1CH 1:32" /><verse number="33" style="v" sid="1CH 1:33" />Iwana wa Midiani tsa, Efa, Eferi, Hanoki, Abida na Elidaa. Wose awo tsa mweleko ghwa Ketura.<verse eid="1CH 1:33" /></para>
  <para style="s">Mweleko ghwa Esau</para>
  <para style="r">(<ref loc="GEN 36:1-19">Mwand 36:1-19</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 1:34" />Abrahamu tsakamweleka Isaka, na Isaka tsakana wana wamale weli, Esau na Yakobo, iyakemighwe Israeli. <verse eid="1CH 1:34" /><verse number="35" style="v" sid="1CH 1:35" />Iwanaghe Esau tsa Elifazi, Reueli, Yeushi, Yalamu na Kora. <verse eid="1CH 1:35" /><verse number="36" style="v" sid="1CH 1:36" />Iwanaghe Elifazi tsa Temani, Omari, Sefo, Gatamu, Kenazi, na pinga wake mdodo iyakemighwe Timna tsakamwelekela Amaleki. <verse eid="1CH 1:36" /><verse number="37" style="v" sid="1CH 1:37" />Iwanaghe Reueli tsa Nahati, Zera, Shama na Miza.<verse eid="1CH 1:37" /></para>
  <para style="s">Wenyekaye wa Edomu</para>
  <para style="r">(<ref loc="GEN 36:20-30">Mwand 36:20-30</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="1CH 1:38" />Iwanu iwalongole kukala mna isi ya Edomu tsawalawa mna iwana wa Seiri: Lotani, Shobali, Sibeoni, Ana, Dishoni, Eseri na Dishani. <verse eid="1CH 1:38" /><verse number="39" style="v" sid="1CH 1:39" />Iwana wa Lotani tsawaweli: Hori na Homamu. Lotani tsakana lumbu wake iyakemighwe Timna. <verse eid="1CH 1:39" /><verse number="40" style="v" sid="1CH 1:40" />Iwana wa Shobali tsa Alivani, Manahati, Ebali, Shefi na Onamu. Iwana wa Sibeoni tsa Aya na Ana. <verse eid="1CH 1:40" /><verse number="41" style="v" sid="1CH 1:41" />Mwana wa Ana tsa Dishoni, na iwana wa Dishoni tsa Hamrani, Eshibani, Itirani na Kerani. <verse eid="1CH 1:41" /><verse number="42" style="v" sid="1CH 1:42" />Iwana wa Eseri tsa Bilihani, Zaawani, Akani, na iwana wa Dishani, tsa Usi na Arani.<verse eid="1CH 1:42" /></para>
  <para style="s">Wafalume wa Edomu</para>
  <para style="r">(<ref loc="GEN 36:31-39">Mwand 36:31-39</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="1CH 1:43" />Awano wawo iwafalume iwatawale isi ya Edomu ng'ana mfalume wowose yatawale mna isi ya Isiraeli. Bela, mwana wa Beori tsakatawala isi ya Edomu, na ghumji ghwake tsaghukemighwa Dinihaba. <verse eid="1CH 1:43" /><verse number="44" style="v" sid="1CH 1:44" />Bela hayafile, Yobabu mwana wa Sera kulawa Bosira katawala hanu hake. <verse eid="1CH 1:44" /><verse number="45" style="v" sid="1CH 1:45" />Yobabu hayafile, Hushamu wa isi ya Watemani tsakatawala hanu hake. <verse eid="1CH 1:45" /><verse number="46" style="v" sid="1CH 1:46" />Hushamu hayafile, Hadadi mwana Bedadi tsakatawala hanu hake, na ghumji gwake tsaghukemighwa Aviti. Hadadi yuyo iyawatowile na kuwahuma Wamidiani mna isi ya Moabu. <verse eid="1CH 1:46" /><verse number="47" style="v" sid="1CH 1:47" />Hadadi hayafile, Samla kulawa Masireka tsakatawala hanu hake. <verse eid="1CH 1:47" /><verse number="48" style="v" sid="1CH 1:48" />Samla hayafile, Shauli kulawa Rehoboti isi ili habehi na ghumto, tsakatawala hanu hake. <verse eid="1CH 1:48" /><verse number="49" style="v" sid="1CH 1:49" />Shauli hayafile, Baali Hanani mwana wa Akibori tsakatawala hanu hake. <verse eid="1CH 1:49" /><verse number="50" style="v" sid="1CH 1:50" />Baali Hanani hayafile, Hadadi tsakatawala hanu hake kulawa Pai, na mwehe wake tsakakemighwa Mehetabeli, neghe Matiredi, mtsukulu wa Me Zahabu. <verse eid="1CH 1:50" /><verse number="51" style="v" sid="1CH 1:51" />Naye Hadadi tsakafa.</para>
  <para style="p" vid="1CH 1:51">Iwakulu wa ghamakabila gha Edomu tsa Timna, Alifa, Yeteti, <verse eid="1CH 1:51" /><verse number="52" style="v" sid="1CH 1:52" />Oholibama, Ela, Pinoni, <verse eid="1CH 1:52" /><verse number="53" style="v" sid="1CH 1:53" />Kenazi, Temani, Mibusari, <verse eid="1CH 1:53" /><verse number="54" style="v" sid="1CH 1:54" />Magidieli na Iramu. Awano wawo iwakulu wa ghamakabila gha Edomu.<verse eid="1CH 1:54" /></para>
  <chapter eid="1CH 1" />
  <chapter number="2" style="c" sid="1CH 2" />
  <para style="s">Mweleko ghwa Yuda</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 2:1" />Yakobo, iyakemighwe Isiraeli, tsakana wana wamale kumi na weli: Rubeni, Simeoni, Lawi, Yuda, Isakari, Zabuloni, <verse eid="1CH 2:1" /><verse number="2" style="v" sid="1CH 2:2" />Dani, Yosefu, Benjamini, Nafutali, Gadi na Asheri.<verse eid="1CH 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 2:3" />Iwana wa Yuda iyeleke na Betishua, mwehe wake kulawa isi ya Kanaani, tsa Eri, Onani na Shela. Eri, imwana chaudele wa Yuda tsakeha hambele ha IMNDEWA, apfo IMNDEWA kamkoma. <verse eid="1CH 2:3" /><verse number="4" style="v" sid="1CH 2:4" />Na Tamari, mkwe yake Yuda, tsa mwehe wa imwanaghe iyakomighwe, tsakamwelekela Yuda wana weli: Peresi na Zera. Apfo iwana wose wa Yuda tsa watano.<verse eid="1CH 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 2:5" />Peresi tsakana wana weli wamale: Hesironi na Hamuli. <verse eid="1CH 2:5" /><verse number="6" style="v" sid="1CH 2:6" />Zera naye tsakana wana watano wamale: Zimri, Etani, Hemani, Kalikoli na Dara. <verse eid="1CH 2:6" /><verse number="7" style="v" sid="1CH 2:7" />Mwana wa Karimi, tsakakemighwa Akari (Akari mana yake maghayo). Ayuno yuyula iyawaghalile ghamaghayo Waisraeli kwaapfila tsakepfisila ipfinu ipfilapfighwe kwa IMNDEWA. <verse eid="1CH 2:7" /><verse number="8" style="v" sid="1CH 2:8" />Etani tsakana mwana mmale yumwe, naye tsakakemighwa Azariya.<verse eid="1CH 2:8" /></para>
  <para style="s">Lukolo lwa mfalume Daudi</para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 2:9" />Hesironi tsakana wana wadatu: Yerameeli, Ramu, na Kalebu. <verse eid="1CH 2:9" /><verse number="10" style="v" sid="1CH 2:10" />Ramu tsakamweleka Aminadabu, naye Aminadabu tsakamweleka Nashoni, imkulu wa likabila lya Yuda. <verse eid="1CH 2:10" /><verse number="11" style="v" sid="1CH 2:11" />Nashoni tsakamweleka Salimoni, naye Salimoni tsakamweleka Boazi, <verse eid="1CH 2:11" /><verse number="12" style="v" sid="1CH 2:12" />Boazi naye tsakamweleka Obedi, naye Obedi tsakamweleka Yese. <verse eid="1CH 2:12" /><verse number="13" style="v" sid="1CH 2:13" />Yese tsakeleka wana saba: Eliabu, imwanaghe chaudele, wa kabili tsa Abinadabu, wa kadatu Shama, <verse eid="1CH 2:13" /><verse number="14" style="v" sid="1CH 2:14" />wa kane Netaneli, wa tano Radai, <verse eid="1CH 2:14" /><verse number="15" style="v" sid="1CH 2:15" />wa sita Osemu na wa saba Daudi. <verse eid="1CH 2:15" /><verse number="16" style="v" sid="1CH 2:16" />Lumbu tsawo tsa Seruya na Abigaili. Iwana wa Seruya tsa wadatu: Abishai, Yoabu na Asaheli. <verse eid="1CH 2:16" /><verse number="17" style="v" sid="1CH 2:17" />Abigaili tsakamweleka Amasa. Amasa aba wake tsakakemighwa Yeteri, kulawa mna mweleko ghwa Ishimaeli.<verse eid="1CH 2:17" /></para>
  <para style="s">Mweleko ghwa Hesironi</para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 2:18" />Kalebu, mwana wa Hesironi, tsakakwela wehe weli, Asuba na Yerioti, Asuba kamwelekela wana wadatu: Yesheri, Shaobabu na Aridoni. <verse eid="1CH 2:18" /><verse number="19" style="v" sid="1CH 2:19" />Asuba hayafile, Kalebu kamkwela Efurata iyamwelekele Huri. <verse eid="1CH 2:19" /><verse number="20" style="v" sid="1CH 2:20" />Huri kamweleka Uri, naye Uri kamweleka Bezaleli.<verse eid="1CH 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 2:21" />Hesironi hayawile na miyaka sitini, kawasa na neghe Makiri aba wa Gileadi. Pinga ayo kamwelekela mwana mmale, taghwa jake Segubu. <verse eid="1CH 2:21" /><verse number="22" style="v" sid="1CH 2:22" />Segubu tsakamweleka Yairi iyatawale miji ishilini na midatu mna isi ya Gileadi. <verse eid="1CH 2:22" /><verse number="23" style="v" sid="1CH 2:23" />Lekeni wafalume wa Geshuri na Aramu tsawawapfamila na wawaboka miji ya Haroti Yairi na Kenati na pfijiji pfake, yose tsa miji sitini. Awo wose tsa lukolo lwa Makiri, aba wake Gileadi. <verse eid="1CH 2:23" /><verse number="24" style="v" sid="1CH 2:24" />Hesironi hayafile, Kalebu kamkwela Efurata, chitsuka wa Hesironi,<note caller="+" style="f"><char style="fr" closed="false">2:24 </char><char style="ft" closed="false">Mna chiebraniya mana yake ng'aimanyika ghoya baye.</char></note> aba wake. Efurata tsakamwelekela Kalebu mwana, taghwa lyake Ashuri, iyanduse ghumji ghwa Tekoa.<verse eid="1CH 2:24" /></para>
  <para style="s">Mweleko ghwa Yerameeli</para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 2:25" />Yerameeli, imwana chaudele wa Hesironi, tsakana wana watano: mwanaghe chaudele tsakekemighwa Ramu, kuya koneka Buna, Oreni, Osemu na Ahiya. <verse eid="1CH 2:25" /><verse number="26" style="v" sid="1CH 2:26" />Yerameeli tsakana pinga yungi taghwa lyake Atara. Ayuno kamwelekela Yerameeli mwana, taghwa lyake Onamu. <verse eid="1CH 2:26" /><verse number="27" style="v" sid="1CH 2:27" />Ramu, imwana chaudele wa Yerameeli, tsakana wana wamale wadatu: Maasi, Yamini na Ekeri. <verse eid="1CH 2:27" /><verse number="28" style="v" sid="1CH 2:28" />Iwana wa Onamu tsa Shamai na Yada. Nawo wana wa Shamai tsa Nadabu na Abishuri.<verse eid="1CH 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 2:29" />Abishuri tsakakwela pinga, taghwa lyake Abihaili, naye tsakamwelekela wana wamale weli, Abani na Molidi. <verse eid="1CH 2:29" /><verse number="30" style="v" sid="1CH 2:30" />Iwana wa Nadabu tsa Seledi na Apaimu, lekeni Seledi tsakafa bila kweleka wana. <verse eid="1CH 2:30" /><verse number="31" style="v" sid="1CH 2:31" />Apaimu tsakana mwana yumwe iyakemighwe Ishi. Ishi tsakamweleka Sheshani, na Sheshani tsakamweleka Alai.<verse eid="1CH 2:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 2:32" />Yada, ndughu yake Shamai, tsakana wana weli, Yeteri na Yonatani. Lekeni Yeteri tsakafa bila kweleka iwana. <verse eid="1CH 2:32" /><verse number="33" style="v" sid="1CH 2:33" />Yonatani tsakana wana weli: Peleti na Zaza. Wose awo tsamweleko ghwa Yerameeli. <verse eid="1CH 2:33" /><verse number="34" style="v" sid="1CH 2:34" />Sheshani tsakahela wana wamale ila tsakana wana mapinga waliyeka. Lekeni tsakana mtumwa Mmisri, taghwa lyake Yariha. <verse eid="1CH 2:34" /><verse number="35" style="v" sid="1CH 2:35" />Apfo Sheshani kamwing'a Yariha mtumwa wake, neghe wake yumwe yamkwele, naye tsakamwelekela mwana taghwa lyake Atai. <verse eid="1CH 2:35" /><verse number="36" style="v" sid="1CH 2:36" />Atai tsakamweleka Natani, na Natani tsakamweleka Zabadi. <verse eid="1CH 2:36" /><verse number="37" style="v" sid="1CH 2:37" />Zabadi tsakamweleka Efulali, Efulali tsakamweleka Obedi. <verse eid="1CH 2:37" /><verse number="38" style="v" sid="1CH 2:38" />Obedi tsakamweleka Yehu, naye Yehu tsakamweleka Azariya. <verse eid="1CH 2:38" /><verse number="39" style="v" sid="1CH 2:39" />Azariya tsakamweleka Helesi, naye Helesi tsakamweleka Eleasa. <verse eid="1CH 2:39" /><verse number="40" style="v" sid="1CH 2:40" />Eleasa tsakamweleka Sisimai, na Sisimai tsakamweleka Shalumu. <verse eid="1CH 2:40" /><verse number="41" style="v" sid="1CH 2:41" />Shalumu tsakamweleka Yekamia, na Yekamia tsakamweleka Elishama.<verse eid="1CH 2:41" /></para>
  <para style="s">Mweleko ghungi ghwa Kalebu</para>
  <para style="p">
    <verse number="42" style="v" sid="1CH 2:42" />Imwana chaudele wa Kalebu na ndughu yake Yerameeli tsakakemighwa Mesha. Mesha tsakamweleka Zifu, naye Zifu tsakamweleka Maresha, na Maresha tsakamweleka Hebroni.<note caller="+" style="f"><char style="fr" closed="false">2:42 </char></note> <verse eid="1CH 2:42" /><verse number="43" style="v" sid="1CH 2:43" />Hebroni tsakana wana wane, Kora, Tapua, Rekemu na Shema. <verse eid="1CH 2:43" /><verse number="44" style="v" sid="1CH 2:44" />Shema tsakamweleka Rahamu, naye Rahamu tsakamweleka Yorikeamu. Rekemu ndughu yake Shema tsakamweleka Shamai. <verse eid="1CH 2:44" /><verse number="45" style="v" sid="1CH 2:45" />Shamai tsakamweleka Maoni, na Maoni tsakamweleka Betisuri. <verse eid="1CH 2:45" /><verse number="46" style="v" sid="1CH 2:46" />Kalebu tsakana pinga mdodo, taghwa lyake Efa. Naye kamwelekela Kalebu wana wadatu: Harani, Moza na Gazezi. Harani naye keleka mwana iyamkemile Gazezi.<verse eid="1CH 2:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="1CH 2:47" />Yadai tsakana wana sita: Regemu, Yotamu, Geshani, Peleti, Efa na Shaafu.<verse eid="1CH 2:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="1CH 2:48" />Kalebu tsakana pinga yungi mdodo taghwa lyake Maaka. Naye kamwelekela wana weli, Sheberi na Tirihana.<verse eid="1CH 2:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="1CH 2:49" />Maaka tsakamwelekela Kalebu iwana, iwana awo tsa Shaafu iyanduse ghumji ghwa Madimana, na yungi tsa Sheva, iyanduse ghumji ghwa Makibena na Gibea. Pfipfila Kalebu tsakana mwana pinga, taghwa lyake Akisa.<verse eid="1CH 2:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="1CH 2:50" />Kalebu pfipfila tsakana wana wangi kwa mwehe wake Efurata. Huri, imwanaghe chaudele, naye tsakana wana wadatu wamale, imwanaghe chaudele tsakakemighwa Shobali, iyanduse ghumji ghwa Kiriati Yearimu, <verse eid="1CH 2:50" /><verse number="51" style="v" sid="1CH 2:51" />wa kabili tsakakemighwa Salima, iyanduse ghumji ghwa Betilehemu, na wa kadatu tsakakemighwa Herefu, iyanduse ghumji ghwa Beti Gaderi. <verse eid="1CH 2:51" /><verse number="52" style="v" sid="1CH 2:52" />Na Shobali, iyanduse ghumji ghwa Kiriati Yearimu, pfipfila tsa sekulu wawo iwanu wa Haroe, na inusu ya wenye kaye wa ghumji ghwa Menuhoti, <verse eid="1CH 2:52" /><verse number="53" style="v" sid="1CH 2:53" />hamwe na kolo atsino itsikalile Kiriati Yearimu, Waitiri, Waputi, Washumati na Wamishirai. Wazorati na Waeshtaoli tsawalawa mna tsikolo atso.<verse eid="1CH 2:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="1CH 2:54" />Salima, tsa sekulu wawo Wabetilehemu, Wanetofati na Waatroti Beti Yoabu na inusu ya Wamenahati iwo Wasori.<verse eid="1CH 2:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="1CH 2:55" />Tsikolo tsawalawile iwanu iwakwandika itsikalile mna ghumji ghwa Yabesi tsa atsino: Watirati, Washimeati na Wasukati. Awo wawo Wakeni, iwanu iwalawile mna mweleko ghwa Hamati, iyanduse ghumji ghwa Beti Rekabu.<verse eid="1CH 2:55" /></para>
  <chapter eid="1CH 2" />
  <chapter number="3" style="c" sid="1CH 3" />
  <para style="s">Iwana wa mfalume Daudi</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 3:1" />Awano wawo iwana wa mfalume Daudi iwelekighwe mna ghamatsuwa ghayakalile ako Heburoni:</para>
  <para style="p" vid="1CH 3:1">Amnoni, imwanaghe chaudele: wenye wake tsakakemighwa Ahinoamu kulawa isi ya Yezireeli: wa kabili Danieli, mai wake tsakakemighwa Abigaili, kulawa isi ya Karimeli, <verse eid="1CH 3:1" /><verse number="2" style="v" sid="1CH 3:2" />wa kadatu Absalomu, yeye mai wake tsakakemighwa Maaka, neghe Talimai mfalume wa Geshuri, wa kane tsa Adoniya, mai wake tsakakemighwa Hagiti, <verse eid="1CH 3:2" /><verse number="3" style="v" sid="1CH 3:3" />wa tano tsa Shefatia, yeye mai wake tsakakemighwa Abitali, na wa sita tsa Itireamu, mai wake tsakakemighwa Egla.<verse eid="1CH 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 3:4" />Wose sita, tsawelekighwa Heburoni, ako Daudi kwayatawale kwa miyaka saba na miyetsi sita. Ako Yerusalemu, tsakatawala kwa miyaka selasini na midatu.<verse eid="1CH 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 3:5" />Awano tsa iwana wa mfalume Daudi hayakalile Yerusalemu. Mwehe wake Batisheba, neghe Amieli, tsakamwelekela wana wane: Shimea, Shobabu, Natani na Selemani.<verse eid="1CH 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 3:6" />Kuya tsakana wana wangi tisa: Ibihari, Elishua, Elipeleti, <verse eid="1CH 3:6" /><verse number="7" style="v" sid="1CH 3:7" />Noga, Nefegi, Yafia, <verse eid="1CH 3:7" /><verse number="8" style="v" sid="1CH 3:8" />Elishama, Eliada, na Elifeleti, wosewose tsa tisa. <verse eid="1CH 3:8" /><verse number="9" style="v" sid="1CH 3:9" />Awano wose tsawana wa Daudi, bila kulola awala wangi iwelekighwe na mapinga wake wa kunze. Pfipfila Daudi tsakana mwana pinga iyakemighwe Tamari.<verse eid="1CH 3:9" /></para>
  <para style="s">Mweleko ghwa mfalume Selemani</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 3:10" />Aghuno ghugho mweleko ghwa mfalume Selemani: Selemani tsakamweleka Rehoboamu, naye Rehoboamu tsakamweleka Abiya, na Abiya tsakamweleka Asa, naye Asa tsakamweleka Yehoshafati, <verse eid="1CH 3:10" /><verse number="11" style="v" sid="1CH 3:11" />iyamweleke Yehoramu, na Yehoramu tsakamweleka Ahazia, iyamweleke Yoashi, <verse eid="1CH 3:11" /><verse number="12" style="v" sid="1CH 3:12" />Yoashi tsakamweleka Amazia, na Amazia tsakamweleka Uzia, naye Uzia tsakamweleka Yotamu. <verse eid="1CH 3:12" /><verse number="13" style="v" sid="1CH 3:13" />Yotamu tsakamweleka Ahazi naye Ahazi tsakamweleka Hezekia iyamweleke Manase. <verse eid="1CH 3:13" /><verse number="14" style="v" sid="1CH 3:14" />Manase tsakamweleka Amoni, naye Amoni kamweleka Yosia. <verse eid="1CH 3:14" /><verse number="15" style="v" sid="1CH 3:15" />Yosia tsakana wana wane: Yohanani iyali chaudele wake, wa kabili Yehoyakimu, wa kadatu Sedekia, na wa kane Shalumu, pfipfila tsakakemighwa Yoahazi.<verse eid="1CH 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 3:16" />Yehoyakimu tsakana wana weli: Yehoyakini, pfipfila tsaiyakemighwe Yekonia, na Sedekia.<verse eid="1CH 3:16" /></para>
  <para style="s">Mweleko ghwa Yehoyakini</para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 3:17" />Iwana wa Yehoyakini, iyaghoghighwe na kughalighwa Babeli tsa saba: Shealtieli, <verse eid="1CH 3:17" /><verse number="18" style="v" sid="1CH 3:18" />Malikiramu, Pedaya, Shenasari, Yekamia, Hoshama, na Nedabia. <verse eid="1CH 3:18" /><verse number="19" style="v" sid="1CH 3:19" />Iwana wa Pedaya tsa Zerubabeli na Shimei. Zerubabeli tsakana wana wamale weli: Meshulamu na Hanania, na lumbu wao iyakemighwe Shelomiti. <verse eid="1CH 3:19" /><verse number="20" style="v" sid="1CH 3:20" />Zerubabeli pfipfila tsakana wana wangi watano: Hashuba, Oheli, Berekia, Hasadia, Yushabi Hesedi.<verse eid="1CH 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 3:21" />Iwana wa Hanania tsa weli, Pelatia na Yeshaya. Yeshaya tsakamweleka Refaya naye Refaya tsakamweleka Arinani, Arinani tsakamweleka Obadia, naye Obadia tsakamweleka Shekania. <verse eid="1CH 3:21" /><verse number="22" style="v" sid="1CH 3:22" />Shekania tsakamweleka Shemaya. Naye Shemaya tsakana wana watano: Hatushi, Igali, Baria, Nearia, na Shafati. <verse eid="1CH 3:22" /><verse number="23" style="v" sid="1CH 3:23" />Nearia tsakana wana wamale wadatu: Elioenai, Hizikia na Azirikamu. <verse eid="1CH 3:23" /><verse number="24" style="v" sid="1CH 3:24" />Elioenai tsakana wana wamale saba: Hodavia, Eliashibu, Pelaya, Akubu, Yohanani, Delaya na Anani.<verse eid="1CH 3:24" /></para>
  <chapter eid="1CH 3" />
  <chapter number="4" style="c" sid="1CH 4" />
  <para style="s">Mweleko ghwa Yuda</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 4:1" />Awano wawo wamwenga wa mweleko ghwa Yuda: Peresi, Hesironi, Karimi, Huri na Shobali. <verse eid="1CH 4:1" /><verse number="2" style="v" sid="1CH 4:2" />Shobali tsakamweleka Reaya, na Reaya tsakamweleka Yahati, iyakalile aba wake Ahumai na Lahadi. Atso tsatsikala kolo tsa Wasorati. <verse eid="1CH 4:2" /><verse number="3" style="v" sid="1CH 4:3" />Wana wamale wa Etamu tsa Yezireeli, Ishima, na Idibashi. Nawo tsawana lumbu yumwe iyakemighwe Haseleliponi. <verse eid="1CH 4:3" /><verse number="4" style="v" sid="1CH 4:4" />Penueli tsakandusa ghumji ghwa Gedori, na Ezeri tsakandusa ghumji ghwa Husha. Awano wawo iwana wa Huri iyali chaudele wa Efurata, iyanduse ghumji ghwa Betilehemu.<verse eid="1CH 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 4:5" />Ashuru, iyanduse ghumji ghwa Tekoa, tsakana mapinga weli: Hela na Naara. <verse eid="1CH 4:5" /><verse number="6" style="v" sid="1CH 4:6" />Naara tsakamwelekela wana wane: Ahuzamu, Heferi, Temeni na Haahashitari. <verse eid="1CH 4:6" /><verse number="7" style="v" sid="1CH 4:7" />Naye Hela tsakamwelekela wana wadatu: Sereti, Ishari na Etinani. <verse eid="1CH 4:7" /><verse number="8" style="v" sid="1CH 4:8" />Kozi tsakaweleka Anubi na Zobeba, naye pfipfila tsa sekulu wa iwanu wa ilukolo lwa Ahariheli, mwana wa Harumu.<verse eid="1CH 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 4:9" />Tsakuna munu yumwe taghwa lyake Yabesi, imunu ayo tsakahulikitsighwa kubita ndughu tsake wose. Wenye wake tsakamwing'a taghwa Yabesi kwaapfila tsakamweleka kwa usungu. <verse eid="1CH 4:9" /><verse number="10" style="v" sid="1CH 4:10" />Naye Yabesi tsakamlomba Imulungu wa Israeli kalonga, “Ghwe Imulungu, nokulomba unibaliki na uyongetse isi yangu iwe ng'ulu. Ghumoko ghwako ghuwe hamwe na nene, naghwe unikinge chinu chochose chihile chileke kundagha.” Naye Imulungu kamwing'a aghala ghayalombile.<verse eid="1CH 4:10" /></para>
  <para style="s">Mataghwa gha kolo tsingi</para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 4:11" />Kalebu, ndughu yake Shuha, tsakamweleka Mehiri, naye Mehiri tsakamweleka Eshitoni. <verse eid="1CH 4:11" /><verse number="12" style="v" sid="1CH 4:12" />Eshitoni tsakana wana wamale wadatu: Beti Rafa, Pasea na Tehina. Tehina tsakandusa ghumji ghwa Iri Nahashi. Awano tsawakala kuna ghumji ghwa Reka. <verse eid="1CH 4:12" /><verse number="13" style="v" sid="1CH 4:13" />Na iwana wa Kenazi tsa Otinieli na Seraya. Iwana wa Otinieli tsa Hatati na Meonotai.<note caller="+" style="f"><char style="fr" closed="false">4:13 </char><char style="ft" closed="false">Ghumstari ghuno mna chiyeburania imana yake ng'aimanyika.</char></note> <verse eid="1CH 4:13" /><verse number="14" style="v" sid="1CH 4:14" />Meonotai tsakamweleka Ofira, Seraya tsakamweleka Yoabu, iyanduse Likonde lya Mafundi. Tsaling'ighwa taghwa alyo kwaapfila wose iwakalile amwo tsa mafundi. <verse eid="1CH 4:14" /><verse number="15" style="v" sid="1CH 4:15" />Kalebu mwana wa Yefune tsakana wana wadatu: Iru, Ela, na Naamu. Na imwana wa Ela tsakakemighwa Kenazi. <verse eid="1CH 4:15" /><verse number="16" style="v" sid="1CH 4:16" />Na iwana wa Yehaleleli tsa Zifu, Zifa, Tiria na Asareli. <verse eid="1CH 4:16" /><verse number="17" style="v" sid="1CH 4:17" />Iwana wa Ezra tsa Yeteri, Meredi, Eferi na Yaloni. Meredi tsakamkwela Bitia, neghe Farao, mfalume wa Misiri, naye kamwelekela imwana pinga iyakemighwe Miriamu, na wana weli wamale, yumwe Shamai, na wakeli Ishiba iyanduse ghumji ghwa Eshitemoa. <verse eid="1CH 4:17" /><verse number="18" style="v" sid="1CH 4:18" />Meredi tsakakwela pinga yungi Myahudi. Ipinga ayo tsakamweleka Yeredi, iyanduse ghumji ghwa Gedori, na Heberi, iyanduse ghumji ghwa Soko na kamweleka Yekutieli iyanduse ghumji ghwa Zanoa. <verse eid="1CH 4:18" /><verse number="19" style="v" sid="1CH 4:19" />Hodia tsakamkwela lumbu wake Nahamu, na ghumweleko ghwao ghugho ghwanduse ilukolo lwa Garimi iwakalile mna ghumji ghwa Keila, na ilukolo lwa Maakati, ilukalile mna ghumji ghwa Eshitemoa. <verse eid="1CH 4:19" /><verse number="20" style="v" sid="1CH 4:20" />Shimoni tsakana wana wane: Amnoni, Rina, Beni Hanani na Tiloni. Na iwana wa Ishi wawo awano: Zoheti na Beni Zoheti.<verse eid="1CH 4:20" /></para>
  <para style="s">Mweleko ghwa Shela</para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 4:21" />Imwana wa Yuda iyakemighwe Shela, tsakana wana awano: Eri iyanduse ghumji ghwa Leka, Laada iyanduse ghumji ghwa Maresha, na ilukolo lwa iwanu iwofuma tsinguwo tsinzelu tsinoghile iwang'ali wokala mna ghumji ghwa Beti Ashibea, <verse eid="1CH 4:21" /><verse number="22" style="v" sid="1CH 4:22" />Yokimu na iwanu iwang'ali wokala mna ghumji ghwa Kozeba, Yoashi na Sarafi iwatawale Moabu na woya Lehemu. Na tsimbuli atsino tsa ghumwande ng'ani. <verse eid="1CH 4:22" /><verse number="23" style="v" sid="1CH 4:23" />Awano wawo iwafina pfiya iwang'ali wokala mna imiji ya Netaimu na Gedera, iwang'ali wokala na kumsang'anila mfalume.<verse eid="1CH 4:23" /></para>
  <para style="s">Mweleko wa Simeoni</para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 4:24" />Simeoni tsakana wana wamale watano: Nemueli, Yamini, Yaribu, Zera na Shauli. <verse eid="1CH 4:24" /><verse number="25" style="v" sid="1CH 4:25" />Imwana wa Shauli tsakakemighwa Shalumu, Shalumu tsakamweleka Mibisamu, naye Mibisamu tsakamweleka Mishima. <verse eid="1CH 4:25" /><verse number="26" style="v" sid="1CH 4:26" />Mishima tsakamweleka Hamueli, iyamweleke Zakuri, naye Zakuri tsakamweleka Shimei. <verse eid="1CH 4:26" /><verse number="27" style="v" sid="1CH 4:27" />Shimei tsakana wana wamale kumi na sita na wana mapinga sita, lekeni ndughu tsake tsawahela wana wengi, apfo lukolo lwao lose tsalwahela wanu wengi ka iwanu wa Yuda. <verse eid="1CH 4:27" /><verse number="28" style="v" sid="1CH 4:28" />Aino iyo imiji yawang'ali wokala: Beeri Sheba, Molada, Hazari Shuali, <verse eid="1CH 4:28" /><verse number="29" style="v" sid="1CH 4:29" />Biliha, Ezemu, Toladi, <verse eid="1CH 4:29" /><verse number="30" style="v" sid="1CH 4:30" />Betueli, Horima, Sikilagi, <verse eid="1CH 4:30" /><verse number="31" style="v" sid="1CH 4:31" />Beti Marikaboti, Hazari Susimu, Beti Biri na Shaaraimu. Ayo iyo imiji yawo mbaka mfalume Daudi hayatawale. <verse eid="1CH 4:31" /><verse number="32" style="v" sid="1CH 4:32" />Pfipfila tsawakala mna pfijiji pfingi, ipfo pfino: Etamu, Aini, Rimoni, Tokeni na Ashani, <verse eid="1CH 4:32" /><verse number="33" style="v" sid="1CH 4:33" />hamwe na pfijiji pfose ipfitsunguluke imiji ayo ako Baalati. Ayo iyo imiji na ipfijiji pfawakalile. Na ako, kuko kwawekile tsimbuli tsawandike tsa ghumweleko ghwao. <verse eid="1CH 4:33" /><verse number="34" style="v" sid="1CH 4:34" />Awano tsawawa pfilongotsi wa kolo tsawo: Meshobabu, Yamleki, Yosha mwana wa Amazia, <verse eid="1CH 4:34" /><verse number="35" style="v" sid="1CH 4:35" />Yoeli, na Yehu mwana wa Yoshibia, Yoshibia tsamwana wa Seraya, naye Seraya tsamwana wa Asieli, <verse eid="1CH 4:35" /><verse number="36" style="v" sid="1CH 4:36" />na Elioenai, Yaakoba, Yeshohaya, Asaya, Adieli, Yesimieli, Benaya, <verse eid="1CH 4:36" /><verse number="37" style="v" sid="1CH 4:37" />Ziza tsamwana wa Shifi, naye Shifi tsamwana wa Aloni, naye Aloni tsamwana wa Yedaya, na Yedaya tsamwana wa Shimri, naye Shimri tsamwana wa Shemaya. <verse eid="1CH 4:37" /><verse number="38" style="v" sid="1CH 4:38" />Iwanu wa tsikolo tsawo waghendelela ukongetseka ng'ani, <verse eid="1CH 4:38" /><verse number="39" style="v" sid="1CH 4:39" />tsawenela mbaka kuna lilango lya ghumji ghwa Gedori, ubali wa mashaliki wa likonde, ili wawabamile iwanyama wawo imighunda ya ukudimila. <verse eid="1CH 4:39" /><verse number="40" style="v" sid="1CH 4:40" />Ako tsawapata imighunda ina imitsani ideghete ya ukudimila iwanyama, nayo isi tsaiwa ng'ulu na iwanu tsawakala bila ukwitowa na tsaikala tulu. Na ghumwande iwanu wa Hamu tsawakala kuko. <verse eid="1CH 4:40" /><verse number="41" style="v" sid="1CH 4:41" />Mna ghamatsuwa Hezekia hayawile mfalume wa Yuda, iwanu awo iwandikighwe ghamataghwa ghawo tsawaghenda Gedori, wahinya ghamahema gha Wameuni iwang'ali wokala ako, na kuwawinga ghendo mbaka leloli. Tsawakala ako kwaapfila tsakuna imitsani bwelele ya ukudimila imifugho yawo. <verse eid="1CH 4:41" /><verse number="42" style="v" sid="1CH 4:42" />Iwanu wamwenga wa likabila lya Simeoni iwopfika miya tano tsawaghenda mbaka kuna ichidunda cha Seiri. Nawo tsawalongotsighwa na Pelatia, Nearia, Refaya na Uzieli, iwana wa Ishi. <verse eid="1CH 4:42" /><verse number="43" style="v" sid="1CH 4:43" />Wasimioni tsawawakoma Waamaleki iwasighale wagima, na kulawa matsuwa agho Wasimioni wokala ako mbaka leloli aino.<verse eid="1CH 4:43" /></para>
  <chapter eid="1CH 4" />
  <chapter number="5" style="c" sid="1CH 5" />
  <para style="s">Mweleko ghwa Rubeni</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 5:1" />Rubeni tsa mwana chaudele wa Isiraeli. Lelo yang'eng'ighwe aghala ighobamighwa ukwing'ighwa mwana chaudele. Lekeni Rubeni tsakawasa na pinga wa kunze wa aba wake. Apfo aghala ighabamighwe ukwing'ighwa keng'ighwa mdodo wake Yosefu. Na mna ilukolo lwao Rubeni ng'otangika baye ka mwana chaudele, ka pfawali iwana chaudele wangi. <verse eid="1CH 5:1" /><verse number="2" style="v" sid="1CH 5:2" />Hata ka Yuda yuyo iyakalile na ingupfu kubita wayaghe, na iwatawala tsawalawa mna ilukolo alwo, aghala ghabamighwe ukwing'ighwa mwana chaudele tsakeng'ighwa Yosefu. <verse eid="1CH 5:2" /><verse number="3" style="v" sid="1CH 5:3" />Awano wawo iwana wa Rubeni, imwana chaudele wa Isiraeli: Hanoki, Palu, Hesironi na Karimi.<verse eid="1CH 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 5:4" />Watsukulu wa Yoeli wawo awano: Yoeli, Shemeya, Gogi, Shimei, <verse eid="1CH 5:4" /><verse number="5" style="v" sid="1CH 5:5" />Mika, Reaya, Baali, <verse eid="1CH 5:5" /><verse number="6" style="v" sid="1CH 5:6" />Beera hayawile chilongotsi wa Warubeni tsakamghogha Tigilati Pileseri mfalume wa Ashuru, kamghala kuna isi ya utumwa.<verse eid="1CH 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 5:7" />Iwakulu awano wa tsikolo tsawandikighwa kwa kulola tsikolo tsawo mna likabila lya Rubeni: Yeieli, Zakaria, <verse eid="1CH 5:7" /><verse number="8" style="v" sid="1CH 5:8" />Bela, mwana wa Azazi na mtsukulu wa Shema, wa lukolo lwa Yoeli, ilukalile mna ghumji ghwa Aroeri mbaka Nebo na isi yose ubali wa kasikazini mbaka Bela na Baali Meoni. <verse eid="1CH 5:8" /><verse number="9" style="v" sid="1CH 5:9" />Pfipfila kwaapfila wanyama wawo tsawongetseka sideke kuna isi ya Gileadi, tsawenela mbaka kwayandusile inyika iyenele mbaka kuna ghumto Efurate.<verse eid="1CH 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 5:10" />Mna ghamatsuwa gha mfalume Sauli, iwanu wa likabila lya Rubeni wandusa ukwitowa na Wahajiri, wawakoma na waisola isi yawo yose ubali wa mashaliki wa Gileadi, kuya wakala amwo.<verse eid="1CH 5:10" /></para>
  <para style="s">Mweleko ghwa Gadi</para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 5:11" />Ubali wa kasikazini likabila lya Gadi tsalibakana na likabila lya Rubeni mna isi ya Bashani iyenele mashaliki mbaka Saleka. <verse eid="1CH 5:11" /><verse number="12" style="v" sid="1CH 5:12" />Yoeli yuyo imkulu wawo, na wa keli Shafamu. Naye Yanai na Shefati tsawalongotsa kolo tsingi ako Bashani. <verse eid="1CH 5:12" /><verse number="13" style="v" sid="1CH 5:13" />Awano wawo ndughu tsawo saba kwa ukulola tsikolo tsawo pfatsili: Mikaeli, Meshulamu, Sheba, Yorai, Yakani, Zia na Eberi. <verse eid="1CH 5:13" /><verse number="14" style="v" sid="1CH 5:14" />Wose awano tsa wana wa Abihaili, iyakalile mwana wa Huri. Huri tsa mwana wa Yaroa, Yaroa tsa mwana wa Gileadi, Gileadi tsa mwana wa Mikaeli, naye Mikaeli tsa mwana wa Yeshishai, naye Yeshishai tsa mwana wa Yado, naye Yado tsa mwana wa Buzi. <verse eid="1CH 5:14" /><verse number="15" style="v" sid="1CH 5:15" />Ahi tsamwana wa Abidieli, na mtsukulu wa Guni, yeye tsamkulu wa tsikolo atsino. <verse eid="1CH 5:15" /><verse number="16" style="v" sid="1CH 5:16" />Iwanu wa Gadi tsawakala Gileadi, ako Bashani na mna ipfijiji pfake, na mna imighunda yose ya ukudimila iwanyama ako Sharoni, mbaka kuna imibaka. <verse eid="1CH 5:16" /><verse number="17" style="v" sid="1CH 5:17" />Iwanu awo wose tsawandikighwa mna ipfitabu pfa tsikolo, ahala Yotamu mfalume wa Yuda na Yeroboamu mfalume wa Isiraeli hawatawale.<verse eid="1CH 5:17" /></para>
  <para style="s">Maasikali wa mashaliki iwadahile ukwitowa mng'ondo</para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 5:18" />Ghamakabila gha Rubeni, Gadi na nusu ya Manase gha ubali wa mashaliki, tsawana iwanu iwadahile ukwitowa pfinoghile mng'ondo iwopfika elufu alubaini na wane na miya saba na sitini, iwatumile tsingawo na ghamapanga, iwadahile kwitowa pfinoghile kwa tsiminde kung'ondo. <verse eid="1CH 5:18" /><verse number="19" style="v" sid="1CH 5:19" />Tsawetowa na wanu wa lukolo lwa Wahajiri, Yeturi, Nafishi na Nodabu. <verse eid="1CH 5:19" /><verse number="20" style="v" sid="1CH 5:20" />Tsawamlomba Imulungu, naye kawedika kwaapfila tsawamlolela yeye. Apfo wawatowa Wahajiri hamwe na sale tsawo. <verse eid="1CH 5:20" /><verse number="21" style="v" sid="1CH 5:21" />Tsawawaboka ngamiya elufu hamsini, wang'olo laki mbili na elufu hamsini, pfihongwe elufu mbili, na wawaghogha wanu wagima laki imwe. <verse eid="1CH 5:21" /><verse number="22" style="v" sid="1CH 5:22" />Tsawawakoma maaduwi wengi sideke kwaapfila mna ing'ondo ayo Imulungu tsakawapfila. Nawo tsawaghendelela kukala mna isi ayo mbaka chipindi cha ghumuhamo.<verse eid="1CH 5:22" /></para>
  <para style="s">Inusu ya iwanu wa Manase</para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 5:23" />Inusu ya iwanu wa likabila lya Manase wa mashaliki tsawakala mna isi ya Bashani. Tsawongetseka ng'ani, tsawenela kasikazini mwa Baali Herimoni, na kasikazini mwa Seniri na chidunda cha Herimoni. <verse eid="1CH 5:23" /><verse number="24" style="v" sid="1CH 5:24" />Awano wawo iwakulu wa tsikolo tsa ghamakabila agho: Eferi, Ishi, Elieli, Azirieli, Yeremia, Hodavia na Yadieli. Iwakulu wose awano tsa maasikali iwadahile ukwitowa pfinoghile kung'ondo na pfilongotsi iwomanyika ng'ani mna tsikolo tsawo.<verse eid="1CH 5:24" /></para>
  <para style="s">Ghamakabila gha mashaliki ghoghalighwa kuna isi ya utumwa</para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 5:25" />Lekeni iwanu tsawamleka Imulungu wa sekulu tsawo, tsawamleka Imulungu kwa kuitambikila milungu ya iwanu wa isi atso itsihinyighwe na Imulungu hambele hawo. <verse eid="1CH 5:25" /><verse number="26" style="v" sid="1CH 5:26" />Apfo, Imulungu wa Isiraeli tsakamsongeletsa Pulu, mfalume wa Ashuru, pfipfila iyomanyika ka Tigilasi Pileseri, kaipfingilila isi yawo na kuwaghogha Warubeni awo, Wagadi na inusu ya likabila lya Manase lya ubali wa mashaliki, na kawaghala ako Hala, Habori, Hara, na kuna ghumto Gozani, nawo wokala ako mbaka leloli.<verse eid="1CH 5:26" /></para>
  <chapter eid="1CH 5" />
  <chapter number="6" style="c" sid="1CH 6" />
  <para style="s">Mweleko ghwa Lawi</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 6:1" />Lawi tsakana wana wadatu: Gerishomu, Kohati na Merari. <verse eid="1CH 6:1" /><verse number="2" style="v" sid="1CH 6:2" />Kohati tsakana wana wane: Amramu, Ishari, Heburoni na Uzieli.<verse eid="1CH 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 6:3" />Amramu tsakana wana wamale weli: Aruni na Musa, kuya tsakana neghe yumwe iyakemighwe Miriamu. Aruni tsakana wana wane: Nadabu, Abihu, Eleazari na Itimari.<verse eid="1CH 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 6:4" />Watsukulu wa Eleazari kulawa lweleko mbako lweleko iwo wano: Finehasi, Abishua, <verse eid="1CH 6:4" /><verse number="5" style="v" sid="1CH 6:5" />Buki, Uzi, <verse eid="1CH 6:5" /><verse number="6" style="v" sid="1CH 6:6" />Zerahia, Merayoti, <verse eid="1CH 6:6" /><verse number="7" style="v" sid="1CH 6:7" />Merayoti, Amaria, Ahitubu, <verse eid="1CH 6:7" /><verse number="8" style="v" sid="1CH 6:8" />Sadoki, Ahimaasi, <verse eid="1CH 6:8" /><verse number="9" style="v" sid="1CH 6:9" />Ahimaasi, Azariya, Yohanani, <verse eid="1CH 6:9" /><verse number="10" style="v" sid="1CH 6:10" />na Azariya. Azariya yuyo iyatendile sang'ano ya ukutambika mna ing'anda ya Imulungu iyaitsengile mfalume Selemani ako Yerusalemu. <verse eid="1CH 6:10" /><verse number="11" style="v" sid="1CH 6:11" />Azariya tsakamweleka Amaria, Ahitubu, <verse eid="1CH 6:11" /><verse number="12" style="v" sid="1CH 6:12" />Sadoki, Meshulamu, <verse eid="1CH 6:12" /><verse number="13" style="v" sid="1CH 6:13" />Hilikia, Azariya, <verse eid="1CH 6:13" /><verse number="14" style="v" sid="1CH 6:14" />Seraya, na Yehosadaki. <verse eid="1CH 6:14" /><verse number="15" style="v" sid="1CH 6:15" />Mfalume Nebukadineza tsakamghala Yehosadaki ahala IMNDEWA hayawaghalile iwanu wa Yuda na iwanu wa Yerusalemu kuna isi ya utumwa.<verse eid="1CH 6:15" /></para>
  <para style="s">Watsukulu wangi wa Lawi</para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 6:16" />Lawi tsakana wana wadatu: Gerishomu, Kohati na Merari. <verse eid="1CH 6:16" /><verse number="17" style="v" sid="1CH 6:17" />Aghano mataghwa gha iwana wa Gerishomu: Libini na Shimei, na chila yumwe tsakana wanaghe wamale. <verse eid="1CH 6:17" /><verse number="18" style="v" sid="1CH 6:18" />Kohati tsakaweleka Amramu, Ishari, Hebroni, na Uzieli. <verse eid="1CH 6:18" /><verse number="19" style="v" sid="1CH 6:19" />Naye Merari tsakaweleka Mahili na Mushi. Awano wawo iwana wa Walawi kwa ukulola tsikolo tsawo pfatsili. <verse eid="1CH 6:19" /><verse number="20" style="v" sid="1CH 6:20" />Awano wawo iwana wa Gerishomu kulawa lweleko mbaka lweleko, Gerishomu, Libini, Yahati, Zima, <verse eid="1CH 6:20" /><verse number="21" style="v" sid="1CH 6:21" />Yoa, Ido, Sera na Yeaterai.<verse eid="1CH 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 6:22" />Awano wawo iwana wa Kohati kulawa mweleko mbaka mweleko: Aminadabu, Kora, Asiri, <verse eid="1CH 6:22" /><verse number="23" style="v" sid="1CH 6:23" />Elikana Ebiasafu, Asiri. <verse eid="1CH 6:23" /><verse number="24" style="v" sid="1CH 6:24" />Tahati, Urieli, Usia, na Shauli. <verse eid="1CH 6:24" /><verse number="25" style="v" sid="1CH 6:25" />Wana wamale wa Elikana tsa waweli: Amasai na Ahimoti.<verse eid="1CH 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 6:26" />Na awano wawo iwana wa Ahimoti: Elikana, Sofai, Nahati, <verse eid="1CH 6:26" /><verse number="27" style="v" sid="1CH 6:27" />Eliabu, Yerohamu, na Elikana. <verse eid="1CH 6:27" /><verse number="28" style="v" sid="1CH 6:28" />Samweli tsakana wana weli: chaudele wake tsakakemighwa Yoeli, na wa keli tsakakemighwa Abiya.<verse eid="1CH 6:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 6:29" />Na Awano wawo iwana wa Merari kulawa mweleko mbaka mweleko: Uza, <verse eid="1CH 6:29" /><verse number="30" style="v" sid="1CH 6:30" />Shimea, Hagia, na Asaya.<verse eid="1CH 6:30" /></para>
  <para style="s">Iwang'ali wakwimba mna Ing'anda ya Imulungu</para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 6:31" />Awano wawo iwanu mfalume Daudi iyawekile walongotse mna ukwimba mna ing'anda ya IMNDEWA Imulungu, ahala lisanduku lya laghano halikighwe mng'anda. <verse eid="1CH 6:31" /><verse number="32" style="v" sid="1CH 6:32" />Tsawatenda isang'ano yawo ya ukwimba kwa ukwibokelela hambele ha Lihema lienzeluke mbaka mfalume Selemani hayatsengile Ing'anda ya IMNDEWA Imulungu ako Yerusalemu. <verse eid="1CH 6:32" /><verse number="33" style="v" sid="1CH 6:33" />Atsino tsitso tsikolo tsa iwanu iwatendile isang'ano ayo: Kulawa lukolo lwa Kohati, Herimani tsa chilongotsi wa kingili lya mwanduso lya iwakwimba, yeye tsa mwana wa Yoeli mwana nha mtsukulu wa Samweli. Aluno lukolo lwake kulawa kwa Israeli: Herimani iyang'ali yotowa chimbeta, iyakalile imwana wa Yoeli, <verse eid="1CH 6:33" /><verse number="34" style="v" sid="1CH 6:34" />Samweli, Elikana, Yerohamu, Elieli, Toa, <verse eid="1CH 6:34" /><verse number="35" style="v" sid="1CH 6:35" />Sufu, Elikana, Mahati, Amasai, <verse eid="1CH 6:35" /><verse number="36" style="v" sid="1CH 6:36" />Elikana, Yoeli, Azariya, Zefania, <verse eid="1CH 6:36" /><verse number="37" style="v" sid="1CH 6:37" />Tahati, Asiri, Ebiasafu, Kora, <verse eid="1CH 6:37" /><verse number="38" style="v" sid="1CH 6:38" />Ishari, Kohati, Lawi, na Isiraeli.<verse eid="1CH 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CH 6:39" />Asafu, ndughu yake tsakakala ubali wake wa kujilo. Aluno lulo ilukolo lwake kulawa kwa Lawi: Asafu, tsa chilongotsi wa keli wa iwanu iwakwimba: tsakamweleka Berekia, Shimea, <verse eid="1CH 6:39" /><verse number="40" style="v" sid="1CH 6:40" />Mikaeli, Baaseya, Malikiya, <verse eid="1CH 6:40" /><verse number="41" style="v" sid="1CH 6:41" />Malikiya, Esini, Zera, Adaya, <verse eid="1CH 6:41" /><verse number="42" style="v" sid="1CH 6:42" />Etani, Zima, Shimei, <verse eid="1CH 6:42" /><verse number="43" style="v" sid="1CH 6:43" />Yahati, Gerishomu, na Lawi.<verse eid="1CH 6:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="1CH 6:44" />Esani wa lukolo lwa Merari, tsachilongotsi wa kingili lya kadatu lya iwakwimba. Aluno lulo ilukolo lwake ilulawile kwa Lawi: Esani, mwana wa Kishi, Abidi, Maluki, <verse eid="1CH 6:44" /><verse number="45" style="v" sid="1CH 6:45" />Hashabia, Amazia, Hilikia, <verse eid="1CH 6:45" /><verse number="46" style="v" sid="1CH 6:46" />Amsi, Bani, Shemeri, <verse eid="1CH 6:46" /><verse number="47" style="v" sid="1CH 6:47" />Mahili, Mushi, Merari, na Lawi.<verse eid="1CH 6:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="1CH 6:48" />Na Walawi wamwenga tsaweng'ighwa tsing'onde ya ukusang'anila Lihema Lienzeluke.<verse eid="1CH 6:48" /></para>
  <para style="s">Mweleko ghwa Aruni</para>
  <para style="p">
    <verse number="49" style="v" sid="1CH 6:49" />Aruni na mweleko ghwake wawo iwang'ali wolapfa nambiko mna imatsabahu ya nambiko ya ukulakatsighwa na mna imatsabahu ya ukudusulila ubani. Tsawasang'ana tsing'onde tsose tsa Hanu Haenzeluke ng'ani ili Imulungu yawalekele Waisiraeli nzambi tsawo. Aghano ghose waghatenda ka pfayalaghitse Musa, mtumighwa wa Imulungu. <verse eid="1CH 6:49" /><verse number="50" style="v" sid="1CH 6:50" />Aluno lulo lweleko lwa Aruni: Eleazari, Finehasi, Abishua, <verse eid="1CH 6:50" /><verse number="51" style="v" sid="1CH 6:51" />Buki, Uzi, Serahia, <verse eid="1CH 6:51" /><verse number="52" style="v" sid="1CH 6:52" />Merayosi, na Amaria, Ahitubu, <verse eid="1CH 6:52" /><verse number="53" style="v" sid="1CH 6:53" />Sadoki, Ahimaasi.<verse eid="1CH 6:53" /></para>
  <para style="s">Hanu hawakalile Walawi</para>
  <para style="p">
    <verse number="54" style="v" sid="1CH 6:54" />Atsino tsitso tsikaye tsawo tsawakalile kwa ukulola imibaka yake tsaweng'ighwa mweleko ghwa Aruni kulawa kuna lukolo lwa Wakohati kwaapfila isimbi ya mwanduso tsaiwaghwila wawo. <verse eid="1CH 6:54" /><verse number="55" style="v" sid="1CH 6:55" />Awano tsaweng'ighwa ghumji ghwa Heburoni mna isi ya Yuda na imighunda ya ukudimila iwanyama mmbalimbali mwa ghumji agho. <verse eid="1CH 6:55" /><verse number="56" style="v" sid="1CH 6:56" />Lekeni imighunda ya mna ghumji hamwe na ipfijiji tsakeng'ighwa Kalebu mwana wa Yefune. <verse eid="1CH 6:56" /><verse number="57" style="v" sid="1CH 6:57" />Apfo mweleko ghwa Aruni tsaweng'ighwa miji ya Heburoni, Libina, Yatiri na Eshitemoa iwe ya ukutsumila. Na chila mji tsaghuna mighunda yake ya ukudimila iwanyama. <verse eid="1CH 6:57" /><verse number="58" style="v" sid="1CH 6:58" />Hileni na Debiri hamwe na mighunda yake ya ukudimila iwanyama, <verse eid="1CH 6:58" /><verse number="59" style="v" sid="1CH 6:59" />Ashani na Beti Shemeshi hamwe na mighunda ya ukudimila iwanyama. <verse eid="1CH 6:59" /><verse number="60" style="v" sid="1CH 6:60" />Kulawa likabila lya Benjamini wawo tsaweng'ighwa miji ya Geba, Alemeti na Anatoti hamwe na mighunda ya ukudimila iwanyama ha imiji ayo. Imiji yose yaweng'ighwe kwa ukulola tsikolo tsawo pfatsili tsaipfika kumi na midatu. <verse eid="1CH 6:60" /><verse number="61" style="v" sid="1CH 6:61" />Mweleko ghwa Wakohati iwasighale tsaweng'ighwa miji kumi kulawa mna likabila lya Manase lili maghalibi kwa kulola tsikolo tsawo.<verse eid="1CH 6:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="1CH 6:62" />Lukolo lwa Gerishomu, kwa ukulola tsikolo tsawo pfatsili tsalwing'ighwa miji kumi na midatu mna isi ya likabila lya Isakari, na mna isi ya kabila lya Nafutali na mna isi ya kabila lya Manase ako Bashani. <verse eid="1CH 6:62" /><verse number="63" style="v" sid="1CH 6:63" />Pfipfila, miji kumi na mili tsaweng'ighwa lukolo lwa Merari ka pfaili kwa likabila lya Rubeni, Gadi na mna isi ya likabila lya Zabuloni. <verse eid="1CH 6:63" /><verse number="64" style="v" sid="1CH 6:64" />Apfo wanu wa Isiraeli tsawaweng'a Walawi imiji ili wakale amo hamwe na mighunda ya ukudimila iwanyama itsinguluke imiji ayo. <verse eid="1CH 6:64" /><verse number="65" style="v" sid="1CH 6:65" />Imiji yose yatulongole kwandika ili mna isi ya likabila lya Yuda, na likabila lya Simioni, na kabila lya Benjamini tsaweng'ighwa likabila lya Lawi kwa ukwasa simbi.<verse eid="1CH 6:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="1CH 6:66" />Tsikaye tsimwenga tsa lukolo lwa Kohati tsatsing'ighwa imiji hamwe na mighunda yake ya ukudimila iwanyama mna isi ya likabila lya Efremu. <verse eid="1CH 6:66" /><verse number="67" style="v" sid="1CH 6:67" />Shekemu, isi ya pfidunda ya Efremu tsaweng'ighwa Shekemu ghumji ghwa ukutsumila, na Gezeri. <verse eid="1CH 6:67" /><verse number="68" style="v" sid="1CH 6:68" />Yokimeamu na Beti Horoni hamwe na mighunda yawo ya ukudimila iwanyama, <verse eid="1CH 6:68" /><verse number="69" style="v" sid="1CH 6:69" />Aiyaloni na Gati Rimoni hamwe na mighunda yawo ya ukudimila iwanyama. <verse eid="1CH 6:69" /><verse number="70" style="v" sid="1CH 6:70" />Mna inusu ya likabila lya Manase tsaweng'ighwa imiji ya Aneri na Bileamu hamwe na mighunda yawo ya ukudimila iwanyama.<verse eid="1CH 6:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="1CH 6:71" />Kaye tsa lukolo lwa Gerishomu tsaweng'ighwa imiji aino hamwe na mighunda yake ya ukudimila iwanyama, mna inusu ya kabila lya Mashaliki ya Manase tsaweng'ighwa Golani ili mna ghumji ghwa Bashani na Ashitaroti hamwe na imighunda yawo ya ukudimila iwanyama. <verse eid="1CH 6:71" /><verse number="72" style="v" sid="1CH 6:72" />Mna likabila lya Isakari tsaweng'ighwa Kedeshi na Deberati hamwe na imighunda yawo ya ukudimila iwanyama, <verse eid="1CH 6:72" /><verse number="73" style="v" sid="1CH 6:73" />Ramoti na Anemu hamwe na mighunda yawo ya ukudimila iwanyama.<verse eid="1CH 6:73" /></para>
  <para style="p">
    <verse number="74" style="v" sid="1CH 6:74" />Mna likabila lya Asheri tsaweng'ighwa ghumji ghwa Mashali, Abidoni hamwe na mighunda yawo ya ukudimila iwanyama, <verse eid="1CH 6:74" /><verse number="75" style="v" sid="1CH 6:75" />Hukoki na Rehobu, hamwe na mighunda yawo ya ukudimila iwanyama, <verse eid="1CH 6:75" /><verse number="76" style="v" sid="1CH 6:76" />na mna likabila lya Nafutali tsaweng'ighwa Kedeshi ili mna ghumji ghwa Galilaya, na Hamoni na Kiriataimu, hamwe na imighunda yawo ya ukudimila iwanyama. <verse eid="1CH 6:76" /><verse number="77" style="v" sid="1CH 6:77" />Nawo Wamerari iwasighale, tsaweng'ighwa imiji aino hamwe na mighunda yawo ya ukudimila iwanyama itsunguluke imiji ayo, kulawa mna likabila lya Zabuloni tsaweng'ighwa Rimono na Tabori hamwe na mighunda yawo ya ukudimila iwanyama. <verse eid="1CH 6:77" /><verse number="78" style="v" sid="1CH 6:78" />Mna isi ya likabila lya Rubeni, ubali wa mashaliki wa ghumto Yoridani habehi na ghumji ghwa Yeriko tsaweng'ighwa Beseri ghumji ighuli mpfidunda na Yahasa, <verse eid="1CH 6:78" /><verse number="79" style="v" sid="1CH 6:79" />Kedemoti na Mefaati hamwe na mighunda yawo ya ukudimila iwanyama, <verse eid="1CH 6:79" /><verse number="80" style="v" sid="1CH 6:80" />na kulawa mna isi ya kabila lya Gadi tsaweng'ighwa Ramoti ako Gileadi na Mahanaimu, <verse eid="1CH 6:80" /><verse number="81" style="v" sid="1CH 6:81" />Heshiboni na Yazeri, hamwe na mighunda yawo ya ukudimila iwanyama.<verse eid="1CH 6:81" /></para>
  <chapter eid="1CH 6" />
  <chapter number="7" style="c" sid="1CH 7" />
  <para style="s">Mweleko ghwa Isakari</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 7:1" />Wana wa Isakari tsa wawane, nawo iwo awano: Tala, Pua, Yashubu na Shimironi.<verse eid="1CH 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 7:2" />Awano wawo iwana wa Tola: Uzi, Refaya, Yerieli, Yamai, Ibisamu na Shemueli. Awano tsa wakulu wa kaye tsa kolo tsawo, na tsawakala iwanu iwadahile ukwitowa mng'ondo mna ghamatsuwa ghawo. Mweleko ghwa iwanu awo ghamatsuwa gha mfalume Daudi tsa wanu elufu ishilini na mbili na miya sita.<verse eid="1CH 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 7:3" />Uzi tsakana mwana yumwe, taghwa lyake Izirahia. Na iwana wa Izirahia tsa Mikaeli, Obadia, Yoeli na Ishia, wose tsa wane, na wose awo wane tsa wakulu wa tsikaye. <verse eid="1CH 7:3" /><verse number="4" style="v" sid="1CH 7:4" />Kwaapfila iwapinga na iwana wawo tsa wawengi ng'ani, tsahana wamale elufu selasini na sita iwadahile ukwitowa kung'ondo kwa ukulola mweleko ghwao.<verse eid="1CH 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 7:5" />Ndughu tsawo mna tsikolo tsose tsa kabila lya Isakari iwandikighwe kwa ukulola tsikolo, tsawapfika asikali elufu semanini na saba, na wose awo tsawadaha ukwitowa pfinoghile mng'ondo.<verse eid="1CH 7:5" /></para>
  <para style="s">Mweleko ghwa Benjamini na Dani</para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 7:6" />Benjamini tsakana wana wamale wadatu: Bela, Bekeri na Yediaeli. <verse eid="1CH 7:6" /><verse number="7" style="v" sid="1CH 7:7" />Bela tsakana wana watano: Esiboni, Usi, Usieli, Yeremoti na Iri. Awano tsawakala pfilongotsi wa tsikaye tsawo na maasikali iwadahile ukwitowa pfinoghile kung'ondo. Iwanu iwandikighwe kwa kulola tsikolo tsawapfika elufu ishirini na mbili na selasini na wane.<verse eid="1CH 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 7:8" />Bekeri tsakana wana tisa: Zemira, Yoashi, Elieseri, Eliehonai, Omri, Yeremoti, Abiya, Anatoti na Alemeti. Wose awano tsa mweleko ghwa Bekeri. <verse eid="1CH 7:8" /><verse number="9" style="v" sid="1CH 7:9" />Tsawandikighwa kwa tsikolo, na kwa ukulola pfeleko pfawo ka pfilongotsi wa tsikaye tsawo, na pfeleko pfawo tsawapfika elufu ishilini na miya mbili, wose tsawadaha ukwitowa pfinoghile kung'ondo.<verse eid="1CH 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 7:10" />Yediaeli tsakana mwana yumwe, taghwa lyake Bilihani. Naye Bilihani tsakana wana: Yeushi, Benjamini, Ehudi, Kenaana, Zetani, Tarishishi na Ahishahari. <verse eid="1CH 7:10" /><verse number="11" style="v" sid="1CH 7:11" />Wose awano tsa wakulu wa tsikaye mna tsikolo tsawo, na tsawakala watowa ng'ondo iwanoghile. Kulawa mweleko ghwawo, tsawapata iwamale elufu kumi na saba na miya mbili iwakalile ghoya kwa ing'ondo. <verse eid="1CH 7:11" /><verse number="12" style="v" sid="1CH 7:12" />Shupimu na Hupimu pfipfila tsawakala wa kabila alino. Dani tsakakala na mwana yumwe, taghwa lyake Hushimu.<verse eid="1CH 7:12" /></para>
  <para style="s">Mweleko ghwa Nafutali</para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 7:13" />Nafutali tsakana wana wane: Yaasieli, Guni, Yereri na Shalumu. Nafutali mai wake tsa Biliha.<verse eid="1CH 7:13" /></para>
  <para style="s">Mweleko ghwa Manase</para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 7:14" />Manase tsakana wana weli kulawa kwa mapinga wake wa kunze Mwaramu, Asirieli na Makiri. Makiri aba wake tsa Gileadi. <verse eid="1CH 7:14" /><verse number="15" style="v" sid="1CH 7:15" />Makiri tsakawakwelela mapinga Hupimu na Shupimu. Lumbu jake Makiri tsakakemighwa Maaka. Mwana wa kabili wa Makiri tsakakemighwa Selofehadi. Selofehadi tsakana wana mapinga waliyeka.<verse eid="1CH 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 7:16" />Maaka pinga wake Makiri, tsakamweleka mwana taghwa lyake Pereshi. Taghwa lya ndughu yake Pereshi tsa Shereshi. Iwana wa Shereshi tsa Ulamu na Rakemu. <verse eid="1CH 7:16" /><verse number="17" style="v" sid="1CH 7:17" />Rakemu tsakamweleka Bedani. Awano wose walawa mna mweleko ghwa Gileadi, mwana wa Makiri, mtsukulu wa Manase. <verse eid="1CH 7:17" /><verse number="18" style="v" sid="1CH 7:18" />Hamoleketi, lumbu jake Gileadi, tsakaweleka Ishihodi, Abiezeri na Mala. <verse eid="1CH 7:18" /><verse number="19" style="v" sid="1CH 7:19" />Wana wa Shemida tsa Ahiani, Shekemu, Liki na Aniamu.<verse eid="1CH 7:19" /></para>
  <para style="s">Mweleko ghwa Efuremu</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 7:20" />Aghuno mweleko ghwa Efuremu kulawa mweleko mbaka mweleko: Shutela, Beredi, Tahati, Eleada, Tahati, <verse eid="1CH 7:20" /><verse number="21" style="v" sid="1CH 7:21" />Zabadi, na Shutela. Pfipfila Efuremu tsakana wana wangi weli: Ezeri na Eleadi, iwakomighwe na wenyekaye wa isi ya Gati kwaapfila tsawaghenda ako kuwaboka iwanyama wawo. <verse eid="1CH 7:21" /><verse number="22" style="v" sid="1CH 7:22" />Efuremu aba wawo tsakadomboketsa kwa ukufa kwa iwanaghe awo kwa ghamatsuwa mengi, na ndughu tsake tsawaghenda kumkanza. <verse eid="1CH 7:22" /><verse number="23" style="v" sid="1CH 7:23" />Kuya Efuremu kawasa na mwehe wake, naye kakinda inda keleka mwana. Efuremu tsakamkema imwana ayo Beria, kwaapfila iwanaghe tsawakomighwa mna ikaye yake.<verse eid="1CH 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 7:24" />Efuremu tsakana mwana pinga taghwa lyake Sheera. Ayuno yuyo iyaitsengile miji ya Beti Horoni ya kuchanya na Beti Horoni ya kuisi, na Uzeni Sheera. <verse eid="1CH 7:24" /><verse number="25" style="v" sid="1CH 7:25" />Efuremu pfipfila tsakamweleka Refa, Reshefu, Tela, Tahani. <verse eid="1CH 7:25" /><verse number="26" style="v" sid="1CH 7:26" />Ladani, Amihudi, Elishama, <verse eid="1CH 7:26" /><verse number="27" style="v" sid="1CH 7:27" />Nuni, na Yoshua.<verse eid="1CH 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 7:28" />Isi tsawo na tsikaye tsawo tsitso atsino: Beteli na pfijiji pfake, Naraani ikalile ubali wa mashaliki, Gezeri ikalile ubali wa maghalibi hamwe na pfijiji pfake, Shekemu na pfijiji pfake na Aya na pfijiji pfake. <verse eid="1CH 7:28" /><verse number="29" style="v" sid="1CH 7:29" />Pfipfila na mna imibaka ya mweleko ghwa Manase: Beti Sheani na pfijiji pfake, Taanaki na pfijiji pfake, Megido na pfijiji pfake, na Dori na pfijiji pfake. Ayo iyo imiji yawakalile mweleko ghwa Yosefu, mwana wa Isiraeli.<verse eid="1CH 7:29" /></para>
  <para style="s">Mweleko ghwa Asheri</para>
  <para style="p">
    <verse number="30" style="v" sid="1CH 7:30" />Aghuno mweleko ghwa Asheri. Asheri tsakana wana wamale wane: Imina, Ishifa, Ishiri na Beria, na mwana pinga yumwe taghwa lyake Sera. <verse eid="1CH 7:30" /><verse number="31" style="v" sid="1CH 7:31" />Beria tsakana wana weli: Heberi na Malikieli, ayuno aba wake tsa Birizaiti. <verse eid="1CH 7:31" /><verse number="32" style="v" sid="1CH 7:32" />Heberi tsakana wana wamale wadatu: Yafileti, Shomeri na Hotamu, na mwana pinga yumwe taghwa lyake Shua. <verse eid="1CH 7:32" /><verse number="33" style="v" sid="1CH 7:33" />Yafileti pfipfila tsakana wana wadatu: Pasaki, Bimihali na Ashifati. <verse eid="1CH 7:33" /><verse number="34" style="v" sid="1CH 7:34" />Shemeri tsakana wana wadatu: Roga, Yehuba na Aramu. <verse eid="1CH 7:34" /><verse number="35" style="v" sid="1CH 7:35" />Na Helemu, ndughu yake yungi, tsakana wana wane: Sofa, Imina, Sheleshi na Amali. <verse eid="1CH 7:35" /><verse number="36" style="v" sid="1CH 7:36" />Wana wa Sofa tsa Sua, Harineferi, Shuali, Beri, Imira, <verse eid="1CH 7:36" /><verse number="37" style="v" sid="1CH 7:37" />Beseri, Hodu, Shama, Shilisha, Itirani na Beera. <verse eid="1CH 7:37" /><verse number="38" style="v" sid="1CH 7:38" />Wana wa Yeteri tsa Yefune, Pisipa na Ara. <verse eid="1CH 7:38" /><verse number="39" style="v" sid="1CH 7:39" />Wana wa Ula tsa Ara, Hanieli na Risia. <verse eid="1CH 7:39" /><verse number="40" style="v" sid="1CH 7:40" />Awo wose tsa mweleko ghwa Asheri na tsa wakulu wa tsikaye tsawo, iwanu iwasaghulighwe na iwanu iwadahile ukwitowa. Na awala iwandikighwe kwa kulola tsikolo mna kingilili lya masikali tsa elufu ishilini na sita.<verse eid="1CH 7:40" /></para>
  <chapter eid="1CH 7" />
  <chapter number="8" style="c" sid="1CH 8" />
  <para style="s">Mweleko ghwa Benjamini</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 8:1" />Benjamini tsakana wana watano: Bela, mwanaghe chaudele, Ashibeli wa kabili, na Ahara wa kadatu, <verse eid="1CH 8:1" /><verse number="2" style="v" sid="1CH 8:2" />Noha wa kane na Rafa wa tano.<verse eid="1CH 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 8:3" />Bela naye tsakana wana awano: Adari, Gera, Abihudi, <verse eid="1CH 8:3" /><verse number="4" style="v" sid="1CH 8:4" />Abishua, Naamani, Ahoa, <verse eid="1CH 8:4" /><verse number="5" style="v" sid="1CH 8:5" />Gera, Shufamu na Huramu. <verse eid="1CH 8:5" /><verse number="6" style="v" sid="1CH 8:6" />Aghuno tsa mweleko ghwa Ehudi. Awano tsa pfilongotsi wa tsikolo tsa awala iwang'ali wokala Geba, lekeni tsawaghoghighwa na waghalighwa kuna isi ya utumwa ya Manahati, <verse eid="1CH 8:6" /><verse number="7" style="v" sid="1CH 8:7" />Naamani, Ahiya na Gera. Gera, aba wawo tsa Uza na Ahihudi, wawo iyawalongotse ukughenda ako. <verse eid="1CH 8:7" /><verse number="8" style="v" sid="1CH 8:8" />Shaharaimu tsakawawinga wapinga wake, Hushimu na Baara mna isi ya Moabu. Kuya kuko tsakeleka wana wamale. <verse eid="1CH 8:8" /><verse number="9" style="v" sid="1CH 8:9" />Tsakeleka na Hodeshi, naye kamwelekela wana saba: Sibia, Mesha, Malikamu, <verse eid="1CH 8:9" /><verse number="10" style="v" sid="1CH 8:10" />Yeusi, Sakia na Mirima. Kuya iwanaghe wose awano tsawawa wakulu wa tsikolo. <verse eid="1CH 8:10" /><verse number="11" style="v" sid="1CH 8:11" />Shaharaimu kwa mwehe wake Hushimu tsakapata wana wangi weli: Abitubu na Elipaali. <verse eid="1CH 8:11" /><verse number="12" style="v" sid="1CH 8:12" />Wana wamale wa Elipaali tsa wadatu: Eberi, Mishamu na Shemedi, Shemedi iyatsengile ghumji ghwa Ono na Lodi, hamwe na ipfijiji ipfili mmbalimbali mwake.<verse eid="1CH 8:12" /></para>
  <para style="s">Wabenjamini iwakalile kuna ghumji ghwa Gati na Aiyaloni</para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 8:13" />Beria na Shema tsawakala iwanu wa kaye itsing'ali tsikala mna imiji ya Aiyaloni, na kuwawinga wenyekaye wa ghumji ghwa Gati. <verse eid="1CH 8:13" /><verse number="14" style="v" sid="1CH 8:14" />Na iwana wa Beria iwo awano: Ahio, Shashaki, Yeremoti, <verse eid="1CH 8:14" /><verse number="15" style="v" sid="1CH 8:15" />Sebadia, Aradi, Ederi, <verse eid="1CH 8:15" /><verse number="16" style="v" sid="1CH 8:16" />na Mikaeli, Ishipa na Yoha pfipfila tsa wana wangi wa Beria. <verse eid="1CH 8:16" /><verse number="17" style="v" sid="1CH 8:17" />Zebadia, Meshulamu, Hisiki, Heberi, <verse eid="1CH 8:17" /><verse number="18" style="v" sid="1CH 8:18" />Ishinerai, Izilia na Yobabu awano tsa wana wa Epaali. <verse eid="1CH 8:18" /><verse number="19" style="v" sid="1CH 8:19" />Yakimu, Zikiri, Zabidi, <verse eid="1CH 8:19" /><verse number="20" style="v" sid="1CH 8:20" />Elienai, Siletai, Elieli, <verse eid="1CH 8:20" /><verse number="21" style="v" sid="1CH 8:21" />Adaya, Beraya na Shimirati tsa wana wa Shimei. <verse eid="1CH 8:21" /><verse number="22" style="v" sid="1CH 8:22" />Ishipani, Eberi, Elieli, <verse eid="1CH 8:22" /><verse number="23" style="v" sid="1CH 8:23" />Abidoni, Zikiri, Hanani, <verse eid="1CH 8:23" /><verse number="24" style="v" sid="1CH 8:24" />Hanania, Elamu, Antotiya, <verse eid="1CH 8:24" /><verse number="25" style="v" sid="1CH 8:25" />Ifideya, Penueli awano tsa wana wa Shashaki. <verse eid="1CH 8:25" /><verse number="26" style="v" sid="1CH 8:26" />Shamisherai, Sheharia, Atalia, <verse eid="1CH 8:26" /><verse number="27" style="v" sid="1CH 8:27" />Yaareshia, Eliya na Zikri tsa iwana wa Yerohamu. <verse eid="1CH 8:27" /><verse number="28" style="v" sid="1CH 8:28" />Awo tsa wakulu wa tsikolo tsawo kwa ukulola pfeleko pfawo. Tsawawa wakulu na tsawakala Yerusalemu.<verse eid="1CH 8:28" /></para>
  <para style="s">Wabenjamini iwakalile Gibeoni na Yerusalemu</para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 8:29" />Yeieli tsakandusa ukutsenga ghumji ghwa Gibeoni. Mwehe wake tsakakemighwa Maaka. <verse eid="1CH 8:29" /><verse number="30" style="v" sid="1CH 8:30" />Mwanaghe chaudele tsakakemighwa Abidoni. Wanaghe wamwenga tsa Suri, Kishi, Baal, Nadabu, <verse eid="1CH 8:30" /><verse number="31" style="v" sid="1CH 8:31" />Gedori, Ahio, Sekeri, <verse eid="1CH 8:31" /><verse number="32" style="v" sid="1CH 8:32" />na Mikiloti aba wake Shimea. Awano pfipfila tsawakala Yerusalemu habehi na wanu wamwenga wa lukolo lwawo.<verse eid="1CH 8:32" /></para>
  <para style="s">Lukolo lwa mfalume Shauli</para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 8:33" />Neri tsakamweleka Kishi, naye Kishi tsakamweleka Shauli. Shauli tsakana wana wane: Yonatani, Malikishua, Abinadabu, na Eshibaali. <verse eid="1CH 8:33" /><verse number="34" style="v" sid="1CH 8:34" />Yonatani tsakamweleka Meribi Baali, naye Meribi Baali tsakamweleka Mika. <verse eid="1CH 8:34" /><verse number="35" style="v" sid="1CH 8:35" />Mika naye tsakana wana wane: Pitoni, Meleki, Terea na Ahazi. <verse eid="1CH 8:35" /><verse number="36" style="v" sid="1CH 8:36" />Ahazi tsakamweleka Yehoada. Naye Yehoada tsakaweleka Alemeti, Asimaweti, Zimiri. Naye Zimiri tsakamweleka Mosa. <verse eid="1CH 8:36" /><verse number="37" style="v" sid="1CH 8:37" />Mosa tsakamweleka Binea, naye Binea tsakamweleka Rafa, na Rafa tsakamweleka Eleasa, naye Eleasa tsakamweleka Aseli. <verse eid="1CH 8:37" /><verse number="38" style="v" sid="1CH 8:38" />Iwana wa Aseli tsa sita: aghano ghagho mataghwa ghawo: Asirikamu, Bokeru, Isimaeli, Shearia, Obadia na Hanani. Wose awano tsa wana wa Aseli. <verse eid="1CH 8:38" /><verse number="39" style="v" sid="1CH 8:39" />Nawo iwana wa Esheki, ndughu yake Aseli, tsa wadatu. Chaudele wake tsakakemighwa Ulamu, wa kabili Yeushi na wa kadatu Elifeleti. <verse eid="1CH 8:39" /><verse number="40" style="v" sid="1CH 8:40" />Wana wa Ulamu tsawakala iwanu iwadahile ukwitowa pfinoghile kung'ondo, na iwakwasa tsiminde pfinoghile. Tsakana wana na watsukulu wengi, wose tsawapfika miya imwe na hamsini. Awo wose tsawalawa mna lukolo lwa Benjamini.<verse eid="1CH 8:40" /></para>
  <chapter eid="1CH 8" />
  <chapter number="9" style="c" sid="1CH 9" />
  <para style="s">Iwanu iwoyile kulawa Babeli</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 9:1" />Wanu wose wa Isiraeli tsawapetighwa mna tsikolo tsawo, na kwandikighwa mna ichitabu cha wafalume wa Isiraeli. Wanu wa Yuda tsawaghoghighwa mbaka Babeli kwaapfila ng'awamuhulikitse Imulungu baye. <verse eid="1CH 9:1" /><verse number="2" style="v" sid="1CH 9:2" />Wanu iwanduse kuya mmakaye mwawo mna imiji yawo tsa Waisiraeli, watambika, Walawi na iwosang'ana mna ing'anda ya Imulungu. <verse eid="1CH 9:2" /><verse number="3" style="v" sid="1CH 9:3" />Iwanu wamwenga wa likabila lya Yuda, lya Benjamini, lya Efuremu na lya Manase tsawaghenda kukala Yerusalemu.<verse eid="1CH 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 9:4" />Utai tsakamweleka Amihudi, Amihudi tsakamweleka Omiri, naye Omiri tsakamweleka Imri, Imri tsakamweleka Bani, wa lukolo lwa iwana wa Peresi, naye Peresi tsakamweleka Yuda. <verse eid="1CH 9:4" /><verse number="5" style="v" sid="1CH 9:5" />Na iwanu wa mweleko ghwa wa Shilo iwo awano: Asaya iyali chaudele, na iwanaghe. <verse eid="1CH 9:5" /><verse number="6" style="v" sid="1CH 9:6" />Na iwanu wa mweleko lwa Sera, Yeueli, na ndughu tsawo wa Yuda tsa miya sita na tisini. <verse eid="1CH 9:6" /><verse number="7" style="v" sid="1CH 9:7" />Na mweleko ghwa iwanu wa Benjamini iwo awano: Salu tsakamweleka Meshulamu, Meshulamu tsakamweleka Hodafia, Hodafia tsakamweleka Hasenua, <verse eid="1CH 9:7" /><verse number="8" style="v" sid="1CH 9:8" />naye Ibeneya tsakamweleka Yerohamu, Yeroamu tsakamweleka Ela, Ela tsakamweleka Usi, Usi tsakamweleka Mikiri, Makiri tsakamweleka Meshulamu, Meshulamu tsakamweleka Shefatia, Shefatia tsakamweleka Reueli, Reueli tsakamweka Ibiniya: <verse eid="1CH 9:8" /><verse number="9" style="v" sid="1CH 9:9" />na ndughu tsawo, iwanu wa Benjamini ka pfawandikighwe, kulawa mna pfeleko pfawo tsa wanu miya tisa na hamsini na sita. Iwanu wose awo tsawawa wakulu wa tsikolo tsa aba tsawo.<verse eid="1CH 9:9" /></para>
  <para style="s">Iwatambika iwakalile Yerusalemu</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 9:10" />Iwatambika awano tsawakala Yerusalemu: Yedaya, Yehoyaribi, Yakini, <verse eid="1CH 9:10" /><verse number="11" style="v" sid="1CH 9:11" />na Asariya mwana wa Hilikia, iyamweleke Meshulamu, naye Meshulamu tsakamweleka Sadoki, Sadoki tsakamweleka Merayoti, Merayoti tsakamweleka Ahitubu, mkulu wa Ing'anda ya Imulungu. <verse eid="1CH 9:11" /><verse number="12" style="v" sid="1CH 9:12" />Naye Adaya tsakamweleka Yerohamu, Yerohamu tsakamweleka Pashuri, Pashuri tsakamweleka Malikiya, Malikiya tsakamweleka Maasai, Maasi tsakamweleka Adieli, Adieli tsakamweleka Yasera, Yasera tsakamweleka Meshulamu, Meshulamu takamweleka Meshilemiti, Meshilemiti tsakamweleka Imeri, <verse eid="1CH 9:12" /><verse number="13" style="v" sid="1CH 9:13" />Iwatambika, iwakulu wa tsikolo tsa aba tsawo hamwe na ndughu tsawo. Wose tsa wanu elufu imwe na miya saba na sitini. Awano tsawakulu iwodaha ghendo sang'ano yose ya Ing'anda ya Imulungu.<verse eid="1CH 9:13" /></para>
  <para style="s">Walawi iwakalile Yerusalemu</para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 9:14" />Walawi awano tsawakala Yerusalemu: Shemaya, tsakamweleka Hashubu, Hashubu tsakamweleka Azirikamu, Azirikamu tsakamweleka Hashabia, Hashabia tsakamweleka Merari, <verse eid="1CH 9:14" /><verse number="15" style="v" sid="1CH 9:15" />Bakibakari, Hereshi, Galali, Matania, Mataniya tsakamweka Mika, Mika tsakamweleka Zikiri, Zikiri tsakamweleka Asafu, <verse eid="1CH 9:15" /><verse number="16" style="v" sid="1CH 9:16" />naye Obadiya, tsakamweleka Shemaya, Shemaya tsakamweleka Galali, Galali tsakamweleka Yedutuni, Yedutuni tsakamweleka Berekiya, Berikiya tsakamweleka Asa, Asa tsakamweleka Elikana, iwang'ali iwokala mna pfijiji pfa Wanetofati.<verse eid="1CH 9:16" /></para>
  <para style="s">Wabetetsi wa Ing'anda ya Imulungu</para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 9:17" />Awano wabetetsi wa Ing'anda ya Imulungu iwakalile Yerusalemu: Shalumu, Akubu, Talimoni na Ahimani na Walawi weyao. Shalumu tsa yuyo mkulu wawo. <verse eid="1CH 9:17" /><verse number="18" style="v" sid="1CH 9:18" />Iwabetetsi awo iwalawile mna likabila lya Lawi tsawalolesa lilango lya mfalume ubali wa mashaliki wa ghumji. Aho mwanduso wang'ali wololesa imilango ya tsindalo tsa Walawi.<verse eid="1CH 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 9:19" />Shalumu tsakamweleka Kora, naye Kora tsakamweleka Ebiasafu, hamwe na ndughu tsake wa lukolo lwa Kora. Awano tsawana sang'ano ya kuibetetsa ghamalango ya Lihema lya Lenzeluke, ka pfawakalile iwahenga wake hawang'ali wobetetsa indalo ya IMNDEWA. <verse eid="1CH 9:19" /><verse number="20" style="v" sid="1CH 9:20" />Aho ghumwande Finehasi mwana wa Eliazari, tsa mkulu wawo, naye IMNDEWA tsakakala hamwe naye. <verse eid="1CH 9:20" /><verse number="21" style="v" sid="1CH 9:21" />Zekaria mwana wa Meshelemia, pfipfila tsayang'ali yobetetsa lilango lya Lihema lya Lenzeluke. <verse eid="1CH 9:21" /><verse number="22" style="v" sid="1CH 9:22" />Iwanu wose iwasaghulighwe kughubetetsa lilango ghwa ing'anda ya Imulungu tsawapfika wanu miya mbili na kumi na weli. Tsawandikighwa kwa ukulola ipfijiji pfawakalile. Mfalume Daudi na nabii Samweli wawo iwawatoghole mna isang'ano ayo ng'ulu. <verse eid="1CH 9:22" /><verse number="23" style="v" sid="1CH 9:23" />Apfo iwanu awo na lweleko lwawo, tsawaghendelela kuilolesa ghamalango gha ing'anda ya IMNDEWA. <verse eid="1CH 9:23" /><verse number="24" style="v" sid="1CH 9:24" />Iwabetetsi tsawakala chila ubali: mashaliki, maghalibi, kasikazini na kusini. <verse eid="1CH 9:24" /><verse number="25" style="v" sid="1CH 9:25" />Ndughu tsawo iwang'ali wokala mna ipfijiji, wang'ali wakutsagha na kuwapfila tsisang'ano tsawo kwa ukwibokelela kwa matsuwa saba. <verse eid="1CH 9:25" /><verse number="26" style="v" sid="1CH 9:26" />Lekeni iwabetetsi wakulu awala wane, iwakalile Walawi, tsawakala na sang'ano ya ukwimilila ipfiheleto pfa hatsina ya ing'anda ye Imulungu. <verse eid="1CH 9:26" /><verse number="27" style="v" sid="1CH 9:27" />Wawo tsawakala habehi na ing'anda ya Imulungu kwaapfila isang'ano yawo tsa kukalitsa na kupfughula ghamalango ghake chila nemitondo.<verse eid="1CH 9:27" /></para>
  <para style="s">Ng'onde tsa Walawi wamwenga</para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 9:28" />Walawi wangi tsawemilila pfinu ipfitumike mna sang'ano tsa ing'anda ya Imulungu. Tsawabamighwa kupfipeta hapfilapfighwa kunze na ahala hapfikuyitsighwa mng'anda. <verse eid="1CH 9:28" /><verse number="29" style="v" sid="1CH 9:29" />Wangi tsawasaghulighwa kupfimila pfinu pfa ing'anda ye Imulungu, na pfinu pfake pfose pfienzeluka, na usaghe unoghile, dipfai, ghamapfuta gha nzeituni, ubani na ghamapfuta ighonung'ila ghoya. <verse eid="1CH 9:29" /><verse number="30" style="v" sid="1CH 9:30" />Lekeni isang'ano ya kuhanganya ipfilungo tsaisang'anighwa na iwatambika. <verse eid="1CH 9:30" /><verse number="31" style="v" sid="1CH 9:31" />Mlawi yumwe iyakemighwe Metitia, mwana chaudele wa Shalumu, wa lukolo lwa Kora, tsakemilila isang'ano ya ukoka pfighate sisili. <verse eid="1CH 9:31" /><verse number="32" style="v" sid="1CH 9:32" />Nawo ndughu tsawo wangi wa lukolo lwa Kohati tsawana sang'ano ya kupfiandaa pfighate pfa kulangusa kuna ing'anda ya Imulungu chila litsuwa lya Sabato. <verse eid="1CH 9:32" /><verse number="33" style="v" sid="1CH 9:33" />Kolo tsingi tsing'ali tsikwimba mna ing'anda ya Imulungu. Tsawakala mna tsing'anda tsingi tsa ing'anda ya Imulungu, kuya ng'awabamighwe baye ukutenda sang'ano yoyose kwaapfila tsawasang'ana chilo na imisi. <verse eid="1CH 9:33" /><verse number="34" style="v" sid="1CH 9:34" />Iwanu wose awano tsa wawa wakulu wa likabila lya Walawi, kwa ukulola tsikolo tsawo pfatsili. Wawo wang'ali wokala Yerusalemu.<verse eid="1CH 9:34" /></para>
  <para style="s">Mweleko ghwa mfalume Sauli</para>
  <para style="r">(<ref loc="1CH 8:29-38">8:29-38</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="1CH 9:35" />Yeieli tsakandusa ukutsenga ghumji ghwa Gibeoni, ako tsakakala yeye na mwehe wake, taghwa lyake Maaka. <verse eid="1CH 9:35" /><verse number="36" style="v" sid="1CH 9:36" />Chaudele wake tsakakemighwai Abdoni, kuya Suri, Kishi, Baali, Neri, Nadabu, <verse eid="1CH 9:36" /><verse number="37" style="v" sid="1CH 9:37" />Gedori, Ahio, Sekeria na Mikiloti. <verse eid="1CH 9:37" /><verse number="38" style="v" sid="1CH 9:38" />Mikiloti tsakamweleka Shimeamu. Iwana wawo tsawakala Yerusalemu habehi na kaye tsingi tsa ndughu tsawo. <verse eid="1CH 9:38" /><verse number="39" style="v" sid="1CH 9:39" />Neri tsakamweleka Kishi, naye Kishi tsakamweleka Shauli. Shauli tsakana wana wane: Yonatani, Malikishua, Abinadabu na Eshibaali. <verse eid="1CH 9:39" /><verse number="40" style="v" sid="1CH 9:40" />Yonatani tsakamweleka Meribi Baali, naye Meribi Baali tsakamweleka Mika. <verse eid="1CH 9:40" /><verse number="41" style="v" sid="1CH 9:41" />Mika tsakana wana wane: Pitoni, Meleki, Tarea na Ahazi. <verse eid="1CH 9:41" /><verse number="42" style="v" sid="1CH 9:42" />Ahazi tsakamweleka Yara, Yara tsakamweleka Alemeti, Asimaweti na Zimri, naye Zimri tsakamweleka Mosa, <verse eid="1CH 9:42" /><verse number="43" style="v" sid="1CH 9:43" />Mosa tsakamweleka Binea, naye Binea tsakamweleka Refaya, naye Refaya tsakamweleka Eleasa, naye Eleasa tsakamweleka Aseli. <verse eid="1CH 9:43" /><verse number="44" style="v" sid="1CH 9:44" />Aseli tsakana wana sita: Asirikamu, Bokeru, Ishimaeli, Shearia, Obadia na Hamani. Awano wose tsawana wa Aseli.<verse eid="1CH 9:44" /></para>
  <chapter eid="1CH 9" />
  <chapter number="10" style="c" sid="1CH 10" />
  <para style="s">Ukufa kwa mfalume Sauli na iwanaghe</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 10:1" />Apfo Wafilisti tsawetowa na Waisiraeli, nawo Waisiraeli tsawawatsuma Wafilisti na wakomighwa mna ichidunda cha Giliboa. <verse eid="1CH 10:1" /><verse number="2" style="v" sid="1CH 10:2" />Wafilisti tsawaghogha Sauli na iwanaghe, kuya wawakoma Yonasani, Abinadabu na Malikishua, iwana wa Shauli. <verse eid="1CH 10:2" /><verse number="3" style="v" sid="1CH 10:3" />Ing'ondo tsa ng'ulu ng'ani kwa Sauli. Iwakwasa tsiminde hawamwonile tsawamlagha. <verse eid="1CH 10:3" /><verse number="4" style="v" sid="1CH 10:4" />Baho Sauli kamlongela imsongolo ayula iyang'ali yomghalila tsisilaha tsake tsa ing'ondo, “Somola lipanga unihome nife, hela iwanu awano ing'awengile ngoma watsonighela chinyala.” Lekeni imsongolo ayo yamghalile tsisilaha tsakalema, kwaapfila tsakapfuka sideke. Baho Sauli kasola lipanga lyake kalihomeka hasi, kuya kalighwila. <verse eid="1CH 10:4" /><verse number="5" style="v" sid="1CH 10:5" />Kuya imsongolo ayula iyang'ali iyomghalila tsisilaha tsake hayonile Sauli kafa, naye kalighwila lipanga lyake, kuya kafa. <verse eid="1CH 10:5" /><verse number="6" style="v" sid="1CH 10:6" />Apfo pfipfo Sauli pfayafile hamwe na iwanaghe wadatu, na iwanu wa ikaye yake wose. <verse eid="1CH 10:6" /><verse number="7" style="v" sid="1CH 10:7" />Iwanu wose wa Isiraeli iwakalile mlwanda mwa Yezireeli, hawonile maasikali wose watsuma, na Sauli na iwanaghe wafa, waileka imiji yawo, nawo watsuma. Nawo Wafilisti waghenda wakala amwo.<verse eid="1CH 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 10:8" />Ilupfi yake, Wafilisti hawaghendile kuwatsula ipfinu pfawapfalile iwanu awo iwafile, tsawamwona Sauli na wanaghe waghwa mna chidunda cha Giliboa. <verse eid="1CH 10:8" /><verse number="9" style="v" sid="1CH 10:9" />Wamtsula maghwanda, wamghana litwi, na tsisilaha tsake, kuya waghala wasenga waghende isi ya Wafilisti chila hanu, ili walalatse tsimbuli atso kwa ipfinyagho pfawo, na kwa iwanu. <verse eid="1CH 10:9" /><verse number="10" style="v" sid="1CH 10:10" />Watsika tsisilaha tsake mng'anda mwa milungu yawo, kuya litwi lyake walikondeka mna ing'anda ya mlungu wao Dagoni. <verse eid="1CH 10:10" /><verse number="11" style="v" sid="1CH 10:11" />Lekeni iwanu wose wa Yabeshi Gileadi hawahulike agho ghose Wafilisti ghawamtendele Sauli, <verse eid="1CH 10:11" /><verse number="12" style="v" sid="1CH 10:12" />iwanu wose iwalihela wogha, walusola lukuli lwa Sauli na ng'uli tse iwanaghe, waighala Yabeshi. Waitsika imipate yawo hana ghumbiki ighukemighwa mwaloni ako Yabeshi, nawo wafunga ukuja kwa matsuwa saba. <verse eid="1CH 10:12" /><verse number="13" style="v" sid="1CH 10:13" />Sauli tsakafa kwaapfila ng'amtegheletse IMNDEWA baye, kaleka kuwinza aghala ghayalongile IMNDEWA, ila yeye kaghenda kwa mtowa lamli yakalaghule. <verse eid="1CH 10:13" /><verse number="14" style="v" sid="1CH 10:14" />Apfo IMNDEWA tsakamkoma na ufalume wake kamwing'a Daudi mwana wa Yese.<verse eid="1CH 10:14" /></para>
  <chapter eid="1CH 10" />
  <chapter number="11" style="c" sid="1CH 11" />
  <para style="s">Daudi kakuwa mfalume wa Isiraeli na Yuda</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 11:1" />Kuya Waisiraeli wose waghenda kwitingana kwa Daudi ako Heburoni, wamlongela, “Twetwe na ghweghwe twolawa tombo limwe. <verse eid="1CH 11:1" /><verse number="2" style="v" sid="1CH 11:2" />Aho ghumwande, Sauli hayakalile mfalume, ghweghwe yuyo yauwalongotse Waisiraeli mng'ondo, na IMNDEWA, Imulungu wako kakulongela apfino, ‘Kutsowalongotsa iwanu wangu Isiraeli, naghwe kutsakuwa chilongotsi wawo.’” <verse eid="1CH 11:2" /><verse number="3" style="v" sid="1CH 11:3" />Apfo wanzehe wose wa Isiraeli wamghendela mfalume ako Heburoni, naye Daudi keka nawo laghano hambele ha IMNDEWA Imulungu, kuya wamsaghula Daudi kwa kumbaka ghamapfuta yawe mfalume wa Waisiraeli, ka apfila IMNDEWA pfayalongile kubitila Samweli.<verse eid="1CH 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 11:4" />Kuya Daudi na maasikali wa Isiraeli, wose tsawaghenda na waghutowa ghumji ghwa Yerusalemu, ghumwande ghumji agho tsaghukemighwa Yebusi, na iwanu iwang'ali wokala amwo tsawakemighwa Wayebusi. <verse eid="1CH 11:4" /><verse number="5" style="v" sid="1CH 11:5" />Wenyekaye wa Yebusi wamlongela Daudi, “Ng'utsakwingila baye mna ighumji aghuno.” Hata apfo, Daudi tsakaghusola ghumji ghwa Siyoni, ghutsungulusighwe ubanda, ghumji ghwa Daudi. <verse eid="1CH 11:5" /><verse number="6" style="v" sid="1CH 11:6" />Kuya Daudi tsakalonga, “Munu iyatsolongola kuwatowa Wayebusi, katsakuwa mkulu na chilongotsi wa maasikali.” Baho Yohabu, mwana wa Seruya, kalongola kuwatowa, na kawa mkulu wa maasikali. <verse eid="1CH 11:6" /><verse number="7" style="v" sid="1CH 11:7" />Daudi tsakakala mna ghumji agho ghune ubanda, apfo ghumji agho tsaghukemighwa Ghumji ghwa Daudi. <verse eid="1CH 11:7" /><verse number="8" style="v" sid="1CH 11:8" />Tsakaghutsenga keli ghumji agho, kanzila hanu hawasindilile msanga mbaka kuna ubanda utsunguluke ghumji, aku Yoabu naye katsenga keli ghumji ghugho ghwa Yerusalemu. <verse eid="1CH 11:8" /><verse number="9" style="v" sid="1CH 11:9" />Naye Daudi kaghendelela kongetseka tsingupfu ghendo, kwaapfila IMNDEWA yana tsingupfu nyingi tsakahamwe naye.<verse eid="1CH 11:9" /></para>
  <para style="s">Masikali wake Daudi iwadahile ukwitowa.</para>
  <para style="r">(<ref loc="2SA 23:8-39">2 Sam 23:8-39</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 11:10" />Awano iwo maasikali wake Daudi iwadahile ukwitowa kung'ondo, wawo kwa tsingupfu tsawo hamwe na iwanu wose wa Isiraeli tsawamwapfila Daudi hayawile mfalume, ka apfila IMNDEWA pfayawalongele Waisirseli. <verse eid="1CH 11:10" /><verse number="11" style="v" sid="1CH 11:11" />Wa mwanduso taghwa lyake tsa Yashobeamu iyolawa mna ulukolo lwa Hakimoni iyakalile mkulu wa “Awala salasini.” Ayuno tsakawatowa kwa mghoha ghwake, kawakoma wanu miya ndatu kwa mala lumwe mng'ondo. <verse eid="1CH 11:11" /><verse number="12" style="v" sid="1CH 11:12" />Wakeli kulawa mna maasikali awala wana ingupfu, tsa Eleazari mwana wa Dodo, iyolawila mna ulukolo lwa Ahohi. <verse eid="1CH 11:12" /><verse number="13" style="v" sid="1CH 11:13" />Ayo tsakakala hamwe na Daudi ako Pasi Dadimu, ahala Wafilisti hawatingane kwitowa ng'ondo. Ako tsakukala na mghunda ghune shayili ketseketse, nawo Waisiraeli tsawatsuma, wawapfuka Wafilisti. <verse eid="1CH 11:13" /><verse number="14" style="v" sid="1CH 11:14" />Lekeni wawo tsawema haghati ghati ha mghunda aghwo, nawo wetowa ghuleke kusolighwa, na wawakoma Wafilisti. IMNDEWA kawakombola kwa kuwatenda wahume ghendo. <verse eid="1CH 11:14" /><verse number="15" style="v" sid="1CH 11:15" />Kuya iwakulu wadatu wane ngupfu mghati mwe iwakulu selasini wahulumka mbaka hana libambalawe, wamghendela Daudi hana imango ako Adulamu. Ghamatsuwa agho maasikali wa Wafilisti tsaweka indalo yawo mna lwanda lwa Refaimu. <verse eid="1CH 11:15" /><verse number="16" style="v" sid="1CH 11:16" />Naye Daudi ghamatsuwa agho tsakakala mna ingome, nawo maasikali wa Wafilisti tsawakala mna ghumji ghwa Betilehemu. <verse eid="1CH 11:16" /><verse number="17" style="v" sid="1CH 11:17" />Daudi tsakabama yanwe ghamatsi ghendo, kalonga, “Kung'alawile imunu iyodaha kungaya ghamatsi gha ichisima cha Betilehemu ichili habehi na lilango lya ghumji!” <verse eid="1CH 11:17" /><verse number="18" style="v" sid="1CH 11:18" />Maasikali wala wadatu tsawalawa wabita mghati mwe ndalo ya maasikali wa Wafilisiti, waghenda kudegha ghamatsi mna ichisima achila cha Betilehemu, habehi na lilango lya ghumji, wamghalila Daudi. Lekeni Daudi tsakalema kughanwa, kaghaghida hasi ghawe nambiko kwa IMNDEWA Imulungu. <verse eid="1CH 11:18" /><verse number="19" style="v" sid="1CH 11:19" />Kalonga, “Chinu ka achino chikale kutali na nene, sidaha baye kutenda chinu chino hambele ha Imulungu wangu. Apfi nuwe idamu ya iwanu wano iwabamile kwiyonza wenyegho wafe? Kwaapfila waulapfa ugima wawo waghala ghamatsi ghano.” Apfo Daudi ng'aghanwele baye ghamatsi agho. Aghano ghagho ghawatendile maasikali wadatu. <verse eid="1CH 11:19" /><verse number="20" style="v" sid="1CH 11:20" />Abishai, ndughu yake Yoabu, tsa chilongotsi wa maasikali awala salasini iwadahile kwitowa pfinoghile kung'ondo. Yeye tsaketowa na iwanu miya ndatu kwa mghoha ghwake, kawakoma, naye tsakamanyika ka maasikali awala wadatu. <verse eid="1CH 11:20" /><verse number="21" style="v" sid="1CH 11:21" />Apfo kamanyika ghendo ka apfila pfawamanyike maasikali wala salasini, naye kawa chilongotsi wawo, hata ka tsa si yumwe baye mna wala wadatu. <verse eid="1CH 11:21" /><verse number="22" style="v" sid="1CH 11:22" />Naye Benaya, mwana wa Yehoyada, kulawa Kabizeeli, tsa asikali iyadahile kwitowa ghendo kung'ondo, iyatendile pfinu pfingi pfakukangawatsa. Tsakawakoma maasikali weli iwadahile kwitowa wa Moabu, na tsuwa limwe mna ghamatsuwa gha chipfeghetsi, tsakahulumka, kaghenda kumkoma isimba mpondo. <verse eid="1CH 11:22" /><verse number="23" style="v" sid="1CH 11:23" />Pfipfila tsakamkoma Mmisiri yumwe, yane utali ka futi saba na nusu, na iyakindile mghoha mkulu mmoko mwake ighuli ka mfundatsi. Lekeni Benaya tsaghamghendela aku kana chilungu chiliyeka, tsakamboka mghoha aghwo, na kumkoma Mmisiri ayo kwa mghoha ghwake. <verse eid="1CH 11:23" /><verse number="24" style="v" sid="1CH 11:24" />Aghano ghagho ghayatendile Benaya mwana wa Yehoyada yamanyike kubita maasikali awala Salasini. <verse eid="1CH 11:24" /><verse number="25" style="v" sid="1CH 11:25" />Apfo, kamanyika mghati mwe maasikali awala selasini, hata ka ng'amanyike baye ka awala maasikali wadatu. Na Daudi kamwika yawe chilongotsi wa iwanu iwomkalitsa yeye. <verse eid="1CH 11:25" /><verse number="26" style="v" sid="1CH 11:26" />Maasikali iwadahile ukwitowa wa Daudi tsa, Asaheli ndughu yake Yoabu, Elihanani imwana wa Dodo kulawa Betilehemu, <verse eid="1CH 11:26" /><verse number="27" style="v" sid="1CH 11:27" />Shamoti kulawa Harodi, Helesi kulawa Peloni, <verse eid="1CH 11:27" /><verse number="28" style="v" sid="1CH 11:28" />Ira, mwana wa Ikeshi kulawa Tekoa, Abieseri kulawa Anatoti, <verse eid="1CH 11:28" /><verse number="29" style="v" sid="1CH 11:29" />Sibekai kulawa Hushati, Ilai kulawa Ahohi, <verse eid="1CH 11:29" /><verse number="30" style="v" sid="1CH 11:30" />Maharai kulawa Netofai, Heledi, imwana wa Baana kulawa Netofai, <verse eid="1CH 11:30" /><verse number="31" style="v" sid="1CH 11:31" />Itai, mwana wa Ribai, kulawa Gibea, wa likabila la Benjamini, Benaya kulawa Pilatoni, <verse eid="1CH 11:31" /><verse number="32" style="v" sid="1CH 11:32" />Hurai kulawa pfikolongo pfa Gaashi, Abieli kulawa Aibati, <verse eid="1CH 11:32" /><verse number="33" style="v" sid="1CH 11:33" />Asimaweti kulawa Baharumu, Eliaba kulawa Shaaliboni, <verse eid="1CH 11:33" /><verse number="34" style="v" sid="1CH 11:34" />wana wa Yasheni kulawa Giloni, Yonatani, mwana wa Shagee kulawa Harari, <verse eid="1CH 11:34" /><verse number="35" style="v" sid="1CH 11:35" />Ahiamu, mwana wa Sakari Harari, Elifali, mwana wa Uri, <verse eid="1CH 11:35" /><verse number="36" style="v" sid="1CH 11:36" />Heferi kulawa Mekerati, Ahiya kulawa Peloni, <verse eid="1CH 11:36" /><verse number="37" style="v" sid="1CH 11:37" />Hesro kulawa Karimeli, Naarai, mwana wa Esbai, <verse eid="1CH 11:37" /><verse number="38" style="v" sid="1CH 11:38" />Yoeli, ndughu yake Natani kulawa Mibihari, mwana wa Hagiri, <verse eid="1CH 11:38" /><verse number="39" style="v" sid="1CH 11:39" />Seleki kulawa Amoni, Naharai kulawa Beoroti, iyakalile mwihilika pfinu pfa ing'ondo pfa Yoabu, mwana wa Seruya, <verse eid="1CH 11:39" /><verse number="40" style="v" sid="1CH 11:40" />Ira na Garebu wose walawa Yatiri, <verse eid="1CH 11:40" /><verse number="41" style="v" sid="1CH 11:41" />Uria kulawa Hiti, Sabadi, mwana wa Ahilai, <verse eid="1CH 11:41" /><verse number="42" style="v" sid="1CH 11:42" />Adina, mwana wa Shisa mkulu wa likabila lya Rubeni, aku tsakana wanu selasini, <verse eid="1CH 11:42" /><verse number="43" style="v" sid="1CH 11:43" />Hanani, mwana wa Maaka, Yoshafati kulawa Mitina, <verse eid="1CH 11:43" /><verse number="44" style="v" sid="1CH 11:44" />Usia kulawa Ashiterati, Shama na Yeieli, iwana wa Hotamu kulawa Aroeri, <verse eid="1CH 11:44" /><verse number="45" style="v" sid="1CH 11:45" />Yediaeli na Yoha ndughu yake, wana wa Shimri kulawa Tizi, <verse eid="1CH 11:45" /><verse number="46" style="v" sid="1CH 11:46" />Elieli kulawa Mahawi, Yeribai na Yoshafia iwana wa Elinaamu, Itima kulawa Moabu, <verse eid="1CH 11:46" /><verse number="47" style="v" sid="1CH 11:47" />Elieli, Obedi, na Yaasieli Sobai.<verse eid="1CH 11:47" /></para>
  <chapter eid="1CH 11" />
  <chapter number="12" style="c" sid="1CH 12" />
  <para style="s">Iwanu iwamuwinzile Daudi kulawa Benjamini</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 12:1" />Awano iwo iwamale iwamghendele Daudi ako Sikilagi, kwayepfisile kwa ukumpfuka mfalume Shauli, imwana wa Kishi. Awano tsa maasikali iwadahile ukwitowa ghoya iwamwapfile Daudi mng'ondo. <verse eid="1CH 12:1" /><verse number="2" style="v" sid="1CH 12:2" />Iwanu awo wang'ali wolawila mna lukolo lwa Benjamini, lukolo lwayolawa Shauli. Awano tsawadaha pfinoghile kwasa tsiminde, na tsawadaha ukwasa ing'umbewe kwa ghumoko ghwa kujilo na kumoso. <verse eid="1CH 12:2" /><verse number="3" style="v" sid="1CH 12:3" />Mkulu wawo tsakakemighwa Aiseri, na wakeli Yoashi, wose wano weli tsa iwana wa Shemaa kulawa Gibea, wamwenga tsa Yesieli na Peleti iwanaghe Asimaweti, na Beraka na Yehu iwolawila Anatoti. <verse eid="1CH 12:3" /><verse number="4" style="v" sid="1CH 12:4" />Ishimaya kulawa Gibeoni, imunu yane ngupfu kulawa mna wala salasini na iyawile chilongotsi wawo, hamwe na Yeremia, Yahasieli, Yohanani na Yosabadi kulawa Gedera, <verse eid="1CH 12:4" /><verse number="5" style="v" sid="1CH 12:5" />Elusai, Yeremoti, Bealia, na Shemaria, Shefatia kulawa Harufi <verse eid="1CH 12:5" /><verse number="6" style="v" sid="1CH 12:6" />Elikana, Ishia, Asareli, Yoeseri na Yoshobeamu kulawa lukolo lwa Kora, <verse eid="1CH 12:6" /><verse number="7" style="v" sid="1CH 12:7" />na Yoela, Sebadia, iwanaghe Yerohamu iyolawila Gedori.<verse eid="1CH 12:7" /></para>
  <para style="s">Wagadi iwamuwinzile Daudi</para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 12:8" />Kuya iwanu kulawa likabila lya Gadi, tsawamuwinza Daudi akula kwayepfisile kunyika. Awano tsa maasikali iwane ngupfu na iwadahile ukukinda ingawo na ukwasa imighoha. Na pfihanga pfawo pfing'ali pfikoneka ka pfa simba, na wang'ali wotsuma ka dondolo mpfidunda. <verse eid="1CH 12:8" /><verse number="9" style="v" sid="1CH 12:9" />Mkulu wawo tsa Ezeri, wa keli Obadia, na wa kadatu Eliabu, <verse eid="1CH 12:9" /><verse number="10" style="v" sid="1CH 12:10" />wa kane Mishimana na wa tano Yeremia, <verse eid="1CH 12:10" /><verse number="11" style="v" sid="1CH 12:11" />wa sita tsa Atai na wa saba Elieli, <verse eid="1CH 12:11" /><verse number="12" style="v" sid="1CH 12:12" />wa nane tsa Yohanani na wa tisa Elisabadi, <verse eid="1CH 12:12" /><verse number="13" style="v" sid="1CH 12:13" />wa kumi tsa Yeremia na wa kumi na imwe tsa Makibanai. <verse eid="1CH 12:13" /><verse number="14" style="v" sid="1CH 12:14" />Iwanu awano wa likabila lya Gadi tsa pfilongotsi wa maasikali. Chilongotsi iyali mdodo ghendo tsakalongotsa wanu miya imwe, na iyali mkulu tsakalongotsa iwanu elufu imwe <verse eid="1CH 12:14" /><verse number="15" style="v" sid="1CH 12:15" />Awano iwo iwanu awala iwalokile ghumto Yoridani mna ghumwetsi ghwa mwanduso, ghumto haghumemile kumwambu na kumwambu, iwanu awano wawawinga iwanu wose iwakalile mlwanda watsumile mashaliki na maghalibi mwa ghumto.<verse eid="1CH 12:15" /></para>
  <para style="s">Wabenjamini na Wayuda iwamuwinzile Daudi</para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 12:16" />Iwanu wamwenga kulawa kabila lya Benjamini na lya Yuda tsawapfika kuna ingome akula kwayepfisile Daudi. <verse eid="1CH 12:16" /><verse number="17" style="v" sid="1CH 12:17" />Daudi tsakalawa kunze kuwabokela, kawalongela, “Ka mnitsila ka sale tsangu ukunyapfila nowabokela kwa ghumoyo ghose, lekeni ka mtsa mnibiduke kwa awala iwonyihila wangoghe, hata ka sitendile baye chinu chochose chihile, Imulungu wa iwahenga wetu yone na yawamanile.” <verse eid="1CH 12:17" /><verse number="18" style="v" sid="1CH 12:18" />Baho Ghumuhe kamuhulumkila Amasai, mkulu wa iwanu awala selasini, kalonga, “Twetwe twa iwanu wako ghwe Daudi, twa chinu chimwe, ghweghwe mwana wa Yese! Ghweghwe kutsohuma ghendo, na imunu wowose iyokwapfila naye katsohuma! Kwaapfila iyokwapfila ghweghwe yuyo Imulungu wako.” Baho Daudi, kawabokela na kawatenda wawe pfilongotsi mna maasikali wake.<verse eid="1CH 12:18" /></para>
  <para style="s">Wamanase iwamuwinzile Daudi</para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 12:19" />Maasikali wamwega wa likabila lya Manase tsawatsuma welunga na Daudi, ahala hayokile na Wafilisti waghende waketowe na mfalume Shauli. Lekeni Daudi na iwanu wake ng'awawapfile baye Wafilisti. Apfo wakulu wa Wafilisti tsawalamla wamuwinge Daudi yoye Sikilagi, walonga, “Twitsehonza wenyegho tufe kwaapfila ayuno katsotubiduka na katsakuya kwa imkulu wake Shauli.” <verse eid="1CH 12:19" /><verse number="20" style="v" sid="1CH 12:20" />Daudi hayang'ali yakuya Sikilagi, iwanu wa likabila lya Manase tsawamghendela. Iwanu awo tsa, Adina na Yosabadi, Yediedi, Mikaeli, Yosabadi, Elihu na Siletai. Chila munu mna iwanu awano tsa chilongotsi wa maasikali elufu imwe mna likabila lya Manase. <verse eid="1CH 12:20" /><verse number="21" style="v" sid="1CH 12:21" />Iwanu awo tsawamwapfila Daudi ukwitowa na makingili gha iwanu iwabamile kumpfamila, kwaapfila iwamale awo tsa wanu iwadahile ukwitowa ghoya. <verse eid="1CH 12:21" /><verse number="22" style="v" sid="1CH 12:22" />Chila litsuwa iwanu tsawaghenda kumwapfila Daudi mbaka kawa na masikali wengi ka masikali we Imulungu.<verse eid="1CH 12:22" /></para>
  <para style="s">Maasikali wangi womghendela Daudi Heburoni</para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 12:23" />Awano ahano iwo maasikali iwakindile tsisilaha iwamghendele Daudi ako Heburoni. Tsawaghenda wamboka Sauli ufalume na wamwing'a Daudi, ka apfila IMNDEWA pfayalongile. <verse eid="1CH 12:23" /><verse number="24" style="v" sid="1CH 12:24" />Kulawa mna likabila lya Yuda iwakindile mighoha na ngawo kwa kughenda kwitowa, tsa elufu sita na miya nane. <verse eid="1CH 12:24" /><verse number="25" style="v" sid="1CH 12:25" />Kulawa mna likabila lya Simeoni, tsa maasikali elufu saba na mia imwe, wose tsawadaha ukwitowa pfinoghile kung'ondo. <verse eid="1CH 12:25" /><verse number="26" style="v" sid="1CH 12:26" />Kulawa kabila lya Lawi, tsawaghenda wanu maasikali elufu nne na miya sita. <verse eid="1CH 12:26" /><verse number="27" style="v" sid="1CH 12:27" />Tsawaghenda hamwe na Yehoyada, imkulu wa ikaye ya Aruni, iyakalile na iwanu wake elufu tatu na miya saba. <verse eid="1CH 12:27" /><verse number="28" style="v" sid="1CH 12:28" />Kulawa mna ikaye ya Sadoki, msongolo iyadahile ukwitowa mng'ondo, yeye tsakaghenda na pfilongotsi wa maasikali ishilini na weli iwolawa mna lukolo lwa aba wake mwenyegho. <verse eid="1CH 12:28" /><verse number="29" style="v" sid="1CH 12:29" />Kulawa kabila lya Benjamini, kabila lyake Shauli iwanu elufu ndatu. Iwanu wengi tsawaghendelela na wawa chinu chimwe kuna ikaye ya Shauli. <verse eid="1CH 12:29" /><verse number="30" style="v" sid="1CH 12:30" />Kulawa likabila lya Efuraimu, tsawaghenda maasikali elufu ishilini na miya nane iwadahile ukwitowa kung'ondo, na chila yumwe tsakatogholighwa mna lukolo lwake. <verse eid="1CH 12:30" /><verse number="31" style="v" sid="1CH 12:31" />Kulawa mna inusu ya likabila lya Manase, maasikali elufu kumi na nane iwakemighwe kwa ghamataghwa waghende kumwika Daudi yawe mfalume. <verse eid="1CH 12:31" /><verse number="32" style="v" sid="1CH 12:32" />Kulawa likabila lya Isakari, tsawaghenda wakulu miya mbili hamwe na ndughu tsawo iwawalongotse. Iwakulu awo tsawamanya matsuwa ghachi ghanogha na ghachi gheha na tsawamanya choni ichibamighwa Waisiraeli watende. <verse eid="1CH 12:32" /><verse number="33" style="v" sid="1CH 12:33" />Pfipfila tsawaghenda wanu elufu hamsini kulawa likabila lya Zabuloni, wose tsawadaha ukwitowa kung'ondo. Tsawabapa tsisilaha tsose tsa ukumwapfila Daudi. <verse eid="1CH 12:33" /><verse number="34" style="v" sid="1CH 12:34" />Kulawa kabila lya Nafutari wakulu elufu imwe hamwe na maasikali elufu ndatu miya saba iwakindile mighoha na tsingawo. <verse eid="1CH 12:34" /><verse number="35" style="v" sid="1CH 12:35" />Kulawa kabila lya Dani, maasikali elufu ishilini na nane na miya sita iwakindile tsisilaha tsawakala ghoya ukwitowa kung'ondo. <verse eid="1CH 12:35" /><verse number="36" style="v" sid="1CH 12:36" />Kulawa likabila lya Asheri, maasikali alufu alubaini iwadahile ukwitowa kung'ondo, wose tsawakala ghoya kwa ukwitowa. <verse eid="1CH 12:36" /><verse number="37" style="v" sid="1CH 12:37" />Kulawa makabila gha Warubeni, Wagadi na inusu ingi ya likabila lya Manase iwakalile mashaliki mwa ghumto Yoridani, maasikali laki imwe na ishilini iwakindile chila silaha tsawakala ghoya kwa kughenda kung'ondo.<verse eid="1CH 12:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1CH 12:38" />Maasikali wose awo, tsawelapfa wenyegho waketowe kung'ondo, tsawaghenda Heburoni, nawo tsawabama ghendo kumtenda Daudi yawe mfalume wa Isiraeli yose. Nawo waisiraeli wose tsawalangula chinu chimwe cha ukumtenda Daudi yawe mfalume wawo. <verse eid="1CH 12:38" /><verse number="39" style="v" sid="1CH 12:39" />Iwanu awano wakala na Daudi matsuwa madatu, aku wakuja na ukunwa, kwaapfila ndughu tsawo ma tsawawambikila ipfijo. <verse eid="1CH 12:39" /><verse number="40" style="v" sid="1CH 12:40" />Pfipfila ndughu tsawo iwokala habehi na awala iwokala kutali ka ako Isakari, Zaburoni na Nafutari, tsawawaghalila ipfijo ipfidutighwe na pfihongwe, ngamiya, pfihongwe falasi na ng'ombe. Tsawawaghalila usaghe, pfighate pfa tini, nzabibu itsisakale, dipfai na ghamapfuta, wang'ombe na wang'olo wengi, tsakuna ipfijo bwelele, kwaapfila iwanu wang'ali wodeng'elela mna si yose ya Isiraeli.<verse eid="1CH 12:40" /></para>
  <chapter eid="1CH 12" />
  <chapter number="13" style="c" sid="1CH 13" />
  <para style="s">Sanduku lya laghano lyakwiyitsighwa Yerusalemu</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 13:1" />Daudi tsakalonga na pfilongotsi wake, awala iwolongotsa wanu elufu elufu, na awala iwolongotsa wanu miya miya. <verse eid="1CH 13:1" /><verse number="2" style="v" sid="1CH 13:2" />Kuya kawalongela Waisiraeli wose iwatingane hamwe, “Ka mwakona pfinogha, naye IMNDEWA, Imulungu wetu, ka kakona pfinogha, leka tuwatume iwanu waghende wakawakeme ndughu tsetu, iwali habehi na iwali kutali, watuwalekile mna isi yose ya Isiraeli, pfipfila wakatukemele iwatambika na Walawi iwokala mna imiji yawo na iwokala mna imighunda yawo yakudimila, watse wakale na twetwe. <verse eid="1CH 13:2" /><verse number="3" style="v" sid="1CH 13:3" />Kuya tughende tukasole lisanduku lya laghano lye Imulungu wetu, kwaapfila ng'atulilalangitse baye mna ghamatsuwa gha mfalume Shauli.” <verse eid="1CH 13:3" /><verse number="4" style="v" sid="1CH 13:4" />Iwanu wose watoghola achila chayalongile Daudi kwaapfila tsawayona mbuli ayo inogha. <verse eid="1CH 13:4" /><verse number="5" style="v" sid="1CH 13:5" />Apfo Daudi tsakawakema hamwe Waisiraeli wose muisi, kulawa chikolongo cha Shihori ichili kusini mwa Misiri mbaka Lebo Hamati, wakalisole sanduku lye Imulungu kulawa Kiriati Yearimu. <verse eid="1CH 13:5" /><verse number="6" style="v" sid="1CH 13:6" />Daudi, aku kelongotsa na Waisiraeli wose, kaghenda kuna ghumji ghwa Baala, pfipfila ghokemighwa Kiriati Yearimu, ghuli mna isi ya Yudeya, kulisola lisanduku lya Imulungu, ilikemighwa kwa taghwa lya IMNDEWA, iyokala hana ichighoda chake cha ufalume mchanya mwa ipfiumbe wane ghamabawa. <verse eid="1CH 13:6" /><verse number="7" style="v" sid="1CH 13:7" />Apfo walisola lisanduku lye Imulungu kulawa mna ing'anda ya Abinadabu na walidinitsa mna lighadi lya sambi. Uza na Ahio tsawalilongotsa lighadi alyo. <verse eid="1CH 13:7" /><verse number="8" style="v" sid="1CH 13:8" />Daudi na Waisiraeli wose wang'ali wopfina kwa ngupfu tsawo tsose hambele ha Imulungu. Tsawemba aku wotoa pfilimba, pfing'weng'we, pfimbeta, matowasi na malati ipfitendighwe kwa mbiki ghwa mvinje. <verse eid="1CH 13:8" /><verse number="9" style="v" sid="1CH 13:9" />Hawapfikile kuna ichibwalu cha ukubetela ichili Kidoni iwang'ombe tsawekwala, apfo Uza tsakagholosa ghumoko ghwake yalikindilitse lisanduku lya laghano lileke kulaghala. <verse eid="1CH 13:9" /><verse number="10" style="v" sid="1CH 13:10" />Baho IMNDEWA Imulungu kamwonela maya Uza kwa kulikindilitsa lisanduku, kamtowa Uza, na babo kafa hambele ha Imulungu. <verse eid="1CH 13:10" /><verse number="11" style="v" sid="1CH 13:11" />Daudi tsakona maya kwaapfila IMNDEWA tsakamghudubukila Uza na kumkoma, apfo hanu aho mbaka leloli ino hokemighwa Peresi Uza. <verse eid="1CH 13:11" /><verse number="12" style="v" sid="1CH 13:12" />Tangiya litsuwa alyo Daudi tsakampfuka Imulungu, na keghutsa, “Angu nitsodahatse kulighala lisanduku lya Imulungu ukaye yangu?” <verse eid="1CH 13:12" /><verse number="13" style="v" sid="1CH 13:13" />Apfo Daudi ng'alighalile baye lisanduku kuna ghumji ghwa Daudi, lekeni kalighala ukaye kwa Obedi Edomu, iyolawila mna ghumji ghwa Gati. <verse eid="1CH 13:13" /><verse number="14" style="v" sid="1CH 13:14" />Sanduku alyo lye Imulungu tsalikala ako kwa Obedi Edomu kwa miyetsi midatu, naye IMNDEWA Imulungu kaibaliki ing'anda ya Obedi Edomu na chila chinu chayali nacho.<verse eid="1CH 13:14" /></para>
  <chapter eid="1CH 13" />
  <chapter number="14" style="c" sid="1CH 14" />
  <para style="s">Ing'anda ya chifalume ya Daudi na kaye yake</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 14:1" />Kuya mfalume Hilamu wa Tiro katuma wanu waghende kwa Daudi, pfipfila kamghalila mibiki ya miyeletsi na wanu watsenga ng'anda na wasongola mibiki, wakamtsengele ing'anda ya chifalume. <verse eid="1CH 14:1" /><verse number="2" style="v" sid="1CH 14:2" />Apfo Daudi katanga ka IMNDEWA Imulungu kamwika ghendo yeye yawe mfalume wa Isiraeli, na ufalume wake winulighwa uwe wa Isiraeli, iwali iwanu wake. <verse eid="1CH 14:2" /><verse number="3" style="v" sid="1CH 14:3" />Ako Yerusalemu, Daudi tsakakwela mapinga wangi na keleka nawo wana wamale na iwana mapinga. <verse eid="1CH 14:3" /><verse number="4" style="v" sid="1CH 14:4" />Aghano ghagho ghamataghwa gha iwana iyaweleke ako Yerusalemu: Shamua, Shobabu, Natani, Selemani, <verse eid="1CH 14:4" /><verse number="5" style="v" sid="1CH 14:5" />Ibihari, Elishua, Elipeleti, <verse eid="1CH 14:5" /><verse number="6" style="v" sid="1CH 14:6" />Noga, Nefegi, Yafia, <verse eid="1CH 14:6" /><verse number="7" style="v" sid="1CH 14:7" />Elishama, Beeliada na Elifeleti.<verse eid="1CH 14:7" /></para>
  <para style="s">Daudi kowahuma Wafilisti</para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 14:8" />Wafilisti hawahulike ka Daudi wambaka ghamapfuta yawe mfalume wa isi yose ya Isiraeli, wose ghendo tsawalawa waghenda kumbama. Naye Daudi hayahulike apfo, kalawa kaghenda kwitowa nawo. <verse eid="1CH 14:8" /><verse number="9" style="v" sid="1CH 14:9" />Wafilisti tsawapfika wanza ukuwaboka ipfinu mna ulwanda lwa Refaimu. <verse eid="1CH 14:9" /><verse number="10" style="v" sid="1CH 14:10" />Daudi kamghutsa Imulungu kalonga, “Pfihi ng'ende nikawotowe Wafilisti? Pfihi kutsongoghela na kungaya mna ghamoko ghangu?” Naye IMNDEWA kamlongela, “Ghenda nitsokughoghela na kukwing'a mna ghamoko ghako.” <verse eid="1CH 14:10" /><verse number="11" style="v" sid="1CH 14:11" />Apfo Daudi na maasikali wake waghenda ako Baali Perasimu, kuko kawatowa Wafilisti. Kuya kalonga, “Imulungu kabita haghati ghati kwa ngupfu na kawatowa maadui tsangu kwa ghumoko ghwangu, ka ghamatsi ighakimighwe pfaghokina.” Apfo hanu aho hakemighwa Baali Perasimu. <verse eid="1CH 14:11" /><verse number="12" style="v" sid="1CH 14:12" />Wafilisti hawatsumile, tsawaleka pfinyagho pfa imilungu yawo, naye Daudi kalaghitsa pfose pfilakatsighwe mmoto. <verse eid="1CH 14:12" /><verse number="13" style="v" sid="1CH 14:13" />Lekeni hambele Wafilisti wanza keli ukwitowa na Daudi mna lwanda alwo. <verse eid="1CH 14:13" /><verse number="14" style="v" sid="1CH 14:14" />Apfo Daudi kamghutsa keli Imulungu choni cha ukutenda, naye Imulungu kamwidika, “Uleke kuwaghendela kulawila ahano, ila uwatsunguluke na uwatowe kwa kulawila hambele ha mibiki ya miforosadi. <verse eid="1CH 14:14" /><verse number="15" style="v" sid="1CH 14:15" />Na hamtsohulika chisindo cha maasikali iwobita mchanya mwe mibiki ayo ya miforosadi, baho ulawe ughende uketowe. Acho chitsakuwa chitango ka nene Imulungu nilongola ng'enda kuwatowa Wafilisti.” <verse eid="1CH 14:15" /><verse number="16" style="v" sid="1CH 14:16" />Daudi tsakatenda ka pfayalaghitsighwe na Imulungu. Tsakawatowa maasikali wa Wafilisti kwanzila Gibeoni mbaka Geseri. <verse eid="1CH 14:16" /><verse number="17" style="v" sid="1CH 14:17" />Daudi tsayang'ali yomanyika muisi mwose, naye IMNDEWA kawatenda iwanu wa isi tsose wampfuke.<verse eid="1CH 14:17" /></para>
  <chapter eid="1CH 14" />
  <chapter number="15" style="c" sid="1CH 15" />
  <para style="s">Sanduku lyobamighwa kuka Yerusalemu.</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 15:1" />Daudi tsaketsengela tsing'anda mna ghumji ghwa Daudi. Mumo katsenga hanu ha ukukala lisanduku lya Imulungu, kuya kalihimikila lihema. <verse eid="1CH 15:1" /><verse number="2" style="v" sid="1CH 15:2" />Kuya kalonga, “Kuduhu imunu yungi wowose iyatsolighala lisanduku lye Imulungu ila Walawi, kwaapfila IMNDEWA kawasaghula wawo walighale na wamsang'anile yeye ghamatsuwa ghose!” <verse eid="1CH 15:2" /><verse number="3" style="v" sid="1CH 15:3" />Apfo Daudi kawakema Waisiraeli wose iwali Yerusalemu, wakalidute lisanduku lya IMNDEWA na walighale hanu kuyalitsengele. <verse eid="1CH 15:3" /><verse number="4" style="v" sid="1CH 15:4" />Kuya Daudi kawakema iwanu wa lweleko lwa Aruni na Walawi. <verse eid="1CH 15:4" /><verse number="5" style="v" sid="1CH 15:5" />Kulawa mna ulukolo lwa Kohathi, tsawatsa tsina Urieli na ndughu tsake miya na ishilini aku Urieli kowalongotsa: <verse eid="1CH 15:5" /><verse number="6" style="v" sid="1CH 15:6" />Kulawa ma ulukolo lwa Merari katsa Asaya na ndughu tsake miya mbili na ishili iyawalongotse <verse eid="1CH 15:6" /><verse number="7" style="v" sid="1CH 15:7" />Kulawa mna ulukolo lwa Garishom, katsa Yoeli na ndughu tsake miya na salasini iyawalongotse, <verse eid="1CH 15:7" /><verse number="8" style="v" sid="1CH 15:8" />Kulawa mna ulukolo lwa Elisafani, katsa Shemaya na ndughu tsake miya mbili iyawalongotse: <verse eid="1CH 15:8" /><verse number="9" style="v" sid="1CH 15:9" />Kulawa mna ulukolo lwa Hebroni, watsa wanu samanini iyawalongotse Elieli: <verse eid="1CH 15:9" /><verse number="10" style="v" sid="1CH 15:10" />na kulawa mna ulukolo lwa Usieli, katsa Aminadabu na kawalongotsa ndughu tsake miya na kumi na weli. <verse eid="1CH 15:10" /><verse number="11" style="v" sid="1CH 15:11" />Daudi tsakawakema watambika weli. Sadoki na Abiathari, na Walawi sita: Urieli, Asaya, Yoeli, Shemaya, Elieli na Aminadabu, <verse eid="1CH 15:11" /><verse number="12" style="v" sid="1CH 15:12" />kawalongela, “Mwemwe mwa wakulu wa kolo tsa Walawi. Apfo mwemwewe na Walawi wayenu, mwitende mwele na mghende mkalisole lisanduku lya IMNDEWA, Imulungu wa Isiraeli, mbaka hanu hala hanilitsengele. <verse eid="1CH 15:12" /><verse number="13" style="v" sid="1CH 15:13" />Kwaapfila aho mwanduso mwemwe ng'amulidutile baye, apfo IMNDEWA, Imulungu wetu tsakatutowa kwaapfila ng'atulilalangitse baye ka apfila pfayalaghitse.” <verse eid="1CH 15:13" /><verse number="14" style="v" sid="1CH 15:14" />Apfo watambika na walawi wetenda wenyegho wele ili walighala lisanduku lye IMNDEWA Imulungu, Imulungu wa Isiraeli. <verse eid="1CH 15:14" /><verse number="15" style="v" sid="1CH 15:15" />Walawi waliduta lisanduku mmahegha mwao kwa mihini yake, ka Musa pfayalaghitse, na ka apfila imbuli ya Imulungu pfailonga.<verse eid="1CH 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 15:16" />Daudi tsakawalaghitsa wakulu wa Walawi wawasaghule walawi wangi wembe wila tsa ukudeng'elela na watowe kwa kupfu tsingoma na pfing'wengwe, pfilimba na matoatsi. <verse eid="1CH 15:16" /><verse number="17" style="v" sid="1CH 15:17" />Apfo Walawi wawasaghula awano wawe wanu iwakwimba, Hemani mwana wa Yoeli na ndughu yake Asafu mwana wa Berekia: na Ethani mwana wa Kushaia iyolawila mna ulukolo lwa Merari ndughu tsawo, na Ethani mwana wa Kushaya. <verse eid="1CH 15:17" /><verse number="18" style="v" sid="1CH 15:18" />Kuya wawasaghula Walawi wano wawapfile, Sakaria, Yasieli, Shemiramothi, Yehieli, Uni, Eliabu, Benaya, Maaseya, Matithia, Elifelehu, Mikneya, hamwe na wakaliitsa libani, Obededomu na Yeieli, <verse eid="1CH 15:18" /><verse number="19" style="v" sid="1CH 15:19" />Hemani, Asafu, Etani wasaghulighwa wembe na watowe matoatsi gha shaba. <verse eid="1CH 15:19" /><verse number="20" style="v" sid="1CH 15:20" />Sakaria, Asieli, Shemiramothi, Yehieli, Uni, Eliabu, Maaseya na Benaya, tsawasaghulighwa watowe pfilimba kwa kuwinza mdundo ukemighwa Alomothi. <verse eid="1CH 15:20" /><verse number="21" style="v" sid="1CH 15:21" />Lekeni Matitia na Elifelehu na mikneya na Obedi Edomu na Yeieli na Asasia tsawasaghulighwa wawe watowa pfilimbi kwa kuwinza mdundo ukemighwa Sheminithi. <verse eid="1CH 15:21" /><verse number="22" style="v" sid="1CH 15:22" />Naye Kenania tsakasaghulighwa yawe chilongotsi wa iwalawi wakwimba, kwaapfila tsakadaha sideke ukwimba. <verse eid="1CH 15:22" /><verse number="23" style="v" sid="1CH 15:23" />Berekia na Elikana tsawasaghulighwa wakalitse lisanduku lya laghano. <verse eid="1CH 15:23" /><verse number="24" style="v" sid="1CH 15:24" />Watambika Shebania, Yoshafati, Nethaneli, Amasai, Sekaria, Benaya na Eliezeri tawasaghulighwa watowe malati hambele he sanduku lye Imulungu. Obedi edomu na Yehiya pfipfila tsawasaghulighwa wawe wakalitsa lisanduku.<verse eid="1CH 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 15:25" />Apfo Daudi na pfilingotsi wa Waisiraeli na pfilongotsi wemilile maasikali elufu elufu, waghenda kulisola Lisanduku lya IMNDEWA kulawa ukaye kwa Obedi edomu aku wodeng'elela. <verse eid="1CH 15:25" /><verse number="26" style="v" sid="1CH 15:26" />Imulungu tsakawapfila Walawi awala iwalidutile lisanduku lya laghano lye IMNDEWA, apfo Daudi na pfilongotsi wamchinjila wang'ombe wamale saba na ng'unzu saba wawe nambiko. <verse eid="1CH 15:26" /><verse number="27" style="v" sid="1CH 15:27" />Daudi tsakapfala lijoho lyitselu, na Walawi iwalidutile lisanduku alyo, na iwanu iwakwimba na Kenania, chilongotsi wa iwanu iwakwimba pfipfila wose tsawapfala majoho matselu. Daudi tsakapfala lijoho alyo hamwe na chitsibao chitselu. <verse eid="1CH 15:27" /><verse number="28" style="v" sid="1CH 15:28" />Apfo, Waisiraeli wose tsawalighala Yerusalemu lisanduku lya laghano lya IMNDEWA. Wang'ali wodeng'elela kwa ukukemelela, aku wotowa malati, pfimbeta, na matoatsi na litsi kulu lya pfing'weng'we na pfilimba. <verse eid="1CH 15:28" /><verse number="29" style="v" sid="1CH 15:29" />Sanduku lya laghano lya IMNDEWA haling'ali lyakwingila mna ghumji ghwa Daudi, Mikali, neghe Shauli kamsungulila kulawa hana lidilisha lyake, baho kamwona mfalume Daudi kopfina aku kodeng'elela, Mikali kambetsa mmoyo mwake.<verse eid="1CH 15:29" /></para>
  <chapter eid="1CH 15" />
  <chapter number="16" style="c" sid="1CH 16" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 16:1" />Kuya walingitsa lisanduku lye Imulungu walika mghati mwa lihema lyatsengile Daudi: walapfa nambiko tsa ukulakatsighwa na nambiko tsa ukukala tseghamba. <verse eid="1CH 16:1" /><verse number="2" style="v" sid="1CH 16:2" />Daudi hayamalitse kulapfa nambiko atso tsa ukulakatsighwa na tsa ukalala tseghamba na kawabaliki iwanu kwa taghwa lya IMNDEWA. <verse eid="1CH 16:2" /><verse number="3" style="v" sid="1CH 16:3" />Kuya kawagholela Waisiraeli wose, wamale na wapinga, chila munu keng'ighwa chighate na tomo limwe lya nyama na chighate cha nzabibu. <verse eid="1CH 16:3" /><verse number="4" style="v" sid="1CH 16:4" />Daudi tsakawasaghula Walawi wamwenga wemeghe hambele ha lisanduku lya IMNDEWA, wawalongotse iwanu mna ukulonga mighede na mna ukumwimbila IMNDEWA, Imulungu wa Isiraeli. <verse eid="1CH 16:4" /><verse number="5" style="v" sid="1CH 16:5" />Tsakamsaghula Asafu yawe chilongotsi wawo, aku Sakaria komwapfila. Yeieli, Shemiramothi, Yehieli, Matithiya, Eliabu, Benaya, Obedi Edomu, Yeieli. Tsakawasaghua watowe pfing'wengwe na pfilimba aku Asafu yeye tsakatoa matoatsi. <verse eid="1CH 16:5" /><verse number="6" style="v" sid="1CH 16:6" />Nawo iwatambika tsina Benania na Yoharieli, tsawasaghulighwa watowe malati hambele ha lisanduku lya laghano lye Imulungu. <verse eid="1CH 16:6" /><verse number="7" style="v" sid="1CH 16:7" />Apfo mna litsuwa alyo Daudi tsakanza kuwalaghitsa Asafu na weyaghe wembe wila wa kulonga mighede kwa IMNDEWA.<verse eid="1CH 16:7" /></para>
  <para style="s">Wila wa mighede.</para>
  <para style="r">(<ref loc="PSA 105:1-15">Zab 105:1-15</ref>; <ref loc="PSA 96:1-13">Zab 96:1-13</ref>; <ref loc="PSA 106:47-48">Zab 106:47-48</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 16:8" />Mlonge mighede kwa Imulungu,</para>
  <para style="q" vid="1CH 16:8">muwalongele iwanu ukulu wake,</para>
  <para style="q" vid="1CH 16:8">mtsilongele isi tsose ghayatendile Imulungu!<verse eid="1CH 16:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="1CH 16:9" />Mumdeng'elele,</para>
  <para style="q" vid="1CH 16:9">mmwimbile wila tsa kumtogola Imulungu;</para>
  <para style="q" vid="1CH 16:9">muwapetele iwanu ghamatendo ghake ighokangawatsa.<verse eid="1CH 16:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="1CH 16:10" />Mwighodele taghwa lyake lyehenzeluke.</para>
  <para style="q" vid="1CH 16:10">Awala iwompfuka Imulungu walekeni wadeng'elele.<verse eid="1CH 16:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="1CH 16:11" />Mghendeleni IMNDEWA yane ngupfu;</para>
  <para style="q" vid="1CH 16:11">Muubame uhanga wake ghamatsuwa ghose.<verse eid="1CH 16:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="1CH 16:12" />Mkumbuke ipfinu pfakukangawatsa pfayafendile,</para>
  <para style="q" vid="1CH 16:12">pfihulo pfake na ukuhigha kwake kwayalongile,<verse eid="1CH 16:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="1CH 16:13" />Mwemwe watsukulu wa Isiraeli, mtumwa wake.</para>
  <para style="q" vid="1CH 16:13">Mwemwe iwana wa Yakobu, wasaghulighwa wake.<verse eid="1CH 16:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="1CH 16:14" />Yeye yuyo IMNDEWA, Imulungu wetu;</para>
  <para style="q" vid="1CH 16:14">ukuhigha kwake kumanyika muisi mwose.<verse eid="1CH 16:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="1CH 16:15" />Yeye ng'esemwa baye laghano lyake lyayekile,</para>
  <para style="q" vid="1CH 16:15">kotenda aghala ghayalaghitse mna pfeleko elufu imwe.<verse eid="1CH 16:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="1CH 16:16" />Kokinda laghano lyayekile na Abrahamu,</para>
  <para style="q" vid="1CH 16:16">na kwilaha kwayelahile na Isaka.<verse eid="1CH 16:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="1CH 16:17" />Laghano alyo tsakeka na Yakobu liwe laghitso,</para>
  <para style="q" vid="1CH 16:17">tsakeka na Isiraeli likale ghamatsuwa ghose.<verse eid="1CH 16:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="1CH 16:18" />Kalonga; “Nitsomwing'ani isi ya Kanani,</para>
  <para style="q" vid="1CH 16:18">nayo itsakuwa yenu wenyegho.”<verse eid="1CH 16:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="1CH 16:19" />Mwemwe tsamwachidogho,</para>
  <para style="q" vid="1CH 16:19">ona tsamwachidogho ghendo,</para>
  <para style="q" vid="1CH 16:19">na wagheni mna isi ayo ya Kanani.<verse eid="1CH 16:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="1CH 16:20" />Mng'ali mkwanga kwanga kulawa isi aino mbaka isi aila,</para>
  <para style="q" vid="1CH 16:20">kulawa ufalume umwe mbaka ufalume ungi.<verse eid="1CH 16:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="1CH 16:21" />Ng'amlekile baye imunu wowose yawonele;</para>
  <para style="q" vid="1CH 16:21">kwa ukuwakinga wawo, Imulungu tsakawamanila iwafalume;<verse eid="1CH 16:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="1CH 16:22" />Kalonga, “Mleke kuwadolitsa iwanu wangu yaniwasaghule;</para>
  <para style="q" vid="1CH 16:22">mleke kuwalagha manabii tsangu.”<verse eid="1CH 16:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="1CH 16:23" />Isi yose imwimbile IMNDEWA,</para>
  <para style="q" vid="1CH 16:23">chila litsuwa muwalongele iwanu ka yeye katukombola.<verse eid="1CH 16:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="1CH 16:24" />Muwalongele wanu we isi tsingi ukulu wake,</para>
  <para style="q" vid="1CH 16:24">muwalongele iwanu wose ipfinu pfayatendile pfakukangawatsa.<verse eid="1CH 16:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="1CH 16:25" />Kwaapfila IMNDEWA kamkulu, kotunyighwa ng'ani,</para>
  <para style="q" vid="1CH 16:25">yeye wakupfukighwa kubita milungu yose.<verse eid="1CH 16:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="1CH 16:26" />Kwaapfila milungu yose ye isi tsingi si chinu baye;</para>
  <para style="q" vid="1CH 16:26">lekeni IMNDEWA tsakalumba kulanga.<verse eid="1CH 16:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="1CH 16:27" />Utunitso na ukulu pfimtsunguluka yeye,</para>
  <para style="q" vid="1CH 16:27">tsingupfu na ukudeng'elela kumema mna ing'anda yake.<verse eid="1CH 16:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="1CH 16:28" />Mmuhulikitse IMNDEWA Imulungu, mwemwe wanu wa isi tsose,</para>
  <para style="q" vid="1CH 16:28">ulongeni ukulu wake na ghupfu tsake.<verse eid="1CH 16:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="1CH 16:29" />Mmwing'e IMNDEWA Imulungu ukulu wa taghwa lyake,</para>
  <para style="q" vid="1CH 16:29">mghale nambiko, mwingile mng'anda mwake.</para>
  <para style="q" vid="1CH 16:29">Mumtamanile IMNDEWA Imulungu hanu hake haenzeluka,<verse eid="1CH 16:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="1CH 16:30" />udedeme hambele hake, ghwe isi yose!</para>
  <para style="q" vid="1CH 16:30">Yeye kaikindilisa isi yose, ng'aihighisika baye.<verse eid="1CH 16:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="1CH 16:31" />Mdeng'elele mwemwe imli kulanga na muisi!</para>
  <para style="q" vid="1CH 16:31">Mtsilongele tsiisi ka IMNDEWA kotawala!<verse eid="1CH 16:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="1CH 16:32" />Ibahali na ipfume, hamwe na pfose ipfili mumo!</para>
  <para style="q" vid="1CH 16:32">Mdeng'elele mwemwe imighunda na pfose ipfili mumo;<verse eid="1CH 16:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="1CH 16:33" />Baho mibiki yose ye kubagho itsakwimba kwa ukudeng'elela,</para>
  <para style="q" vid="1CH 16:33">itsakwimba hambele ha IMNDEWA,</para>
  <para style="q" vid="1CH 16:33">kwaapfila Yeye katsakutsa kuihigha isi<verse eid="1CH 16:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="1CH 16:34" />Mlonge mighede kwa IMNDEWA,</para>
  <para style="q" vid="1CH 16:34">kwaaapfila yeye kanogha</para>
  <para style="q" vid="1CH 16:34">kotukunda ghamatsuwa ghose!<verse eid="1CH 16:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="1CH 16:35" />Mumlongele Imulungu apfino;</para>
  <para style="q" vid="1CH 16:35">“Utukombole, ghwe Imulungu wa mkombola wetu;</para>
  <para style="q" vid="1CH 16:35">Utwike hamwe na ukutukombola kulawa mna isi tsingi,</para>
  <para style="q" vid="1CH 16:35">na tulitunye taghwa lyako lihenzeluke,</para>
  <para style="q" vid="1CH 16:35">tudeng'elele mna utunitso wako.”<verse eid="1CH 16:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="1CH 16:36" />Yatunyighwe IMNDEWA, Imulungu wa Isiraeli,</para>
  <para style="q" vid="1CH 16:36">kulawa sambi na ghamatsuwa ghose.</para>
  <para style="p" vid="1CH 16:36">Kuya iwanu wose walonga, “Ona!” Kuya wamtunitsa IMNDEWA Imulungu.<verse eid="1CH 16:36" /></para>
  <para style="s">Ukumtambikila Imulungu ako Yerusalemu na Gibeoni</para>
  <para style="p">
    <verse number="37" style="v" sid="1CH 16:37" />Mfalume Daudi kaweka Asafu na ndughu tsake hanu halikalile lisanduku lya laghano lya IMNDEWA, watende chila ng'onde ibamighwa kutendighwa chila litsuwa. <verse eid="1CH 16:37" /><verse number="38" style="v" sid="1CH 16:38" />Pfipfila tsakamwika Obedi Edomu, hamwe na weyaghe sitini na nane wasang'ane hamwe. Obedi Edomu mwana wa Yeduthuni na Hosa tsawakalitsi wa imibani. <verse eid="1CH 16:38" /><verse number="39" style="v" sid="1CH 16:39" />Mfalume Daudi tsakaweka mtambika Sadoki, na watambika weyaghe wasang'ane hambele ha hema lye IMNDEWA ilikalile hanu aho ha ukutambilkila ako Gibeoni, <verse eid="1CH 16:39" /><verse number="40" style="v" sid="1CH 16:40" />wamlapfileghe IMNDEWA nambiko tsa kulakatsighwa mchanya mwa imatsabahu ayo, chila nemitondo na chila nemihe, ka apfila chila chinu ichili mna ghamalaghitso gha Imulungu ghayawalaghitse Waisiraeli pfagholonga. <verse eid="1CH 16:40" /><verse number="41" style="v" sid="1CH 16:41" />Hamwe nawo, tsawa baho tsina Hemani na Yeduthuni na awala wose iwasaghulighwe kwa mataghwa ghawo, wamwimbileghe wila wa mighende IMNDEWA, kwaapfila kowakunda iwanu wake ghamatsuwa ghose. <verse eid="1CH 16:41" /><verse number="42" style="v" sid="1CH 16:42" />Hanami na Yedutuni tsaweng'ighwa ing'onde ya ukwimila tsimalati na matoasi na chila chinu chukwimbila ahala wamwenga hawembile wila wa tsa ukulonga mighede kwa Imulungu. Wana wa Yedutuni tsawasaghuliwa wakalitse ghamalango. <verse eid="1CH 16:42" /><verse number="43" style="v" sid="1CH 16:43" />Kuya chila munu koka ukae yake. Naye Daudi tsakoka ukaye yake kuwabaliki iwanu wa ikaye yake.<verse eid="1CH 16:43" /></para>
  <chapter eid="1CH 16" />
  <chapter number="17" style="c" sid="1CH 17" />
  <para style="s">Imulungu komghalila Daudi usenga</para>
  <para style="r">(<ref loc="2SA 7:1-17">2 Sam 7:1-17</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 17:1" />Mfalume Daudi yang'ali yokala mna ing'anda yake ya chifalume, litsuwa limwe kamkema nabii Nasani, kamlongela, “Lola, nene nokala mna ing'anda inoghile iitsengighwe kwa mieletsi, lekeni lisanduku lya IMNDEWA lyokala mwihema.” <verse eid="1CH 17:1" /><verse number="2" style="v" sid="1CH 17:2" />Natani kamwidika, “Utende chochose choubama mmoyo mwako, kwaapfila Imulungu ka hamwe naghwe.” <verse eid="1CH 17:2" /><verse number="3" style="v" sid="1CH 17:3" />Lekeni chilo chichila, Imulungu kalonga na Nasani, kamlongela, <verse eid="1CH 17:3" /><verse number="4" style="v" sid="1CH 17:4" />“Ghenda ukamlongele mtumighwa wangu Daudi, IMNDEWA kolonga pfino, ‘Ghweghwe ng'autsonitsengela baye ing'anda ya ukukala. <verse eid="1CH 17:4" /><verse number="5" style="v" sid="1CH 17:5" />Kulawa ghamatsuwa ghala ghaniwakombole wanu wa Isiraeli kulawa Misiri mbaka leloli ino, nene sina nikale baye mna ing'anda. Tsaning'ali nikala mna lihema ling'ali lihama, kulawa hanu hamwe mbaka hanu hangi. <verse eid="1CH 17:5" /><verse number="6" style="v" sid="1CH 17:6" />Mna ukwanga kwangu kose hamwe na wanu wa Isiraeli nene simghutsile baye mlamutsi wowose yanimlaghitse kulolesa wanu wangu, hebali ng'aunitsengele baye ing'anda ya mieletsi?’ <verse eid="1CH 17:6" /><verse number="7" style="v" sid="1CH 17:7" />Lelo umlongele Daudi mtumighwa wangu apfino, ‘Nene IMNDEWA wa kulanga iyana ingupfu tsanilkulapfa kumghunda haung'ali udima iwang'olo, na nikusaghula ghweghwe uwe chilongotsi wa iwanu wangu Isiraeli. <verse eid="1CH 17:7" /><verse number="8" style="v" sid="1CH 17:8" />Nene tsaniwa hamwe naghwe hohose ahala haughendile na niwakoma maadui tsako wose iwemile hambele hako. Nitsolitenda taghwa lyako lyimanyike ka iwakulu wangi wa isi. <verse eid="1CH 17:8" /><verse number="9" style="v" sid="1CH 17:9" />Nene nitsowasaghulila wanu wangu wa Isiraeli hanu hao ha ukukala, nitsoweka wakale bila kudesighwa na munu wowose. Ne iwanu wehile ng'awatsowadununza keli baye, ka pfawalongole ukutenda, <verse eid="1CH 17:9" /><verse number="10" style="v" sid="1CH 17:10" />Tsanitenda apfo tangiya haniwasaghule walamutsi wawalongotse iwanu wangu Isiraeli, nene nitsowatowa maadui wako wose. Pfipfila nene IMNDEWA nokulongela apfino iwatsukulu wako watsakuwa wafalume. <verse eid="1CH 17:10" /><verse number="11" style="v" sid="1CH 17:11" />Ghamatsuwa ghako gha kuhupa haghotsopfika, naghwe hautsotsikighwa hamwe na iwabala wako, nitsomsaghula imwanagho yumwe yawe mfalume, na nene nitsoutenda ufalume wake wime ghoya. <verse eid="1CH 17:11" /><verse number="12" style="v" sid="1CH 17:12" />Yeye yuyo yatsonitsengela nene ing'anda, na nene nitsoutenda ufalume wake ukale ghamatsuwa ghose. <verse eid="1CH 17:12" /><verse number="13" style="v" sid="1CH 17:13" />Nene nitsakuwa aba wake, naye katsakuwa mwanangu. Nene sitsoleka baye kumkunda yeye, ka apfila pfandekile kumkunda Sauli iyakulongole. <verse eid="1CH 17:13" /><verse number="14" style="v" sid="1CH 17:14" />Bali nitsomwika yawe mkulu mna iwanu wangu Waisiraeli na mna ufalume wangu wa ghamatsuwa ghose, na chighoda chake cha ufalume chitsakwima ghoya mna ghumatsuwa ghose.’ ” <verse eid="1CH 17:14" /><verse number="15" style="v" sid="1CH 17:15" />Nasani kamlongela Daudi chila chinu chayonile mna ghamaono ghayeng'ighwe na Imulungu.<verse eid="1CH 17:15" /></para>
  <para style="s">Daudi komlongela mighede Imulungu</para>
  <para style="r">(<ref loc="2SA 7:18-29">2 Sam 7:18-29</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 17:16" />Kuya mfalume Daudi kengila mghati mwa lihema Lienzeluke, na kajegha hembele ha Imulungu, kalomba, “Nene nili nani ghwe IMNDEWA Imulungu, na ing'anda yangu chinu chachi mbaka uninule apfino? <verse eid="1CH 17:16" /><verse number="17" style="v" sid="1CH 17:17" />Hata ka alyino dodo mnange mwako, Ghwe Imulungu, pfipfila kulonga ing'anda yautsonitsengela mna ghamatsuwa ighakutsa. Kondola nene ka namunu mkulu kubita iwanu wose. <verse eid="1CH 17:17" /><verse number="18" style="v" sid="1CH 17:18" />Nikulongele choni keli nene mtumighwa wako Daudi, kwa kunyinula apfino? Ghweghwe konimanya nene mtumighwa wako. <verse eid="1CH 17:18" /><verse number="19" style="v" sid="1CH 17:19" />Ghwe IMNDEWA Imulungu, kunitendelela nene mtumighwa ka apfila ghumoyo ghwako pfaghubamile, kughatenda makulu ghose ghano, malaghano ghako ghose agho ghamanyike. <verse eid="1CH 17:19" /><verse number="20" style="v" sid="1CH 17:20" />Kuduhu yungi ka ghweghwe, ghwe IMNDEWA Imulungu, na kuduhu yungi ka ghweghwe Imulungu, ka apfila pfatuhulike kwa ghamaghutwi ghetu. <verse eid="1CH 17:20" /><verse number="21" style="v" sid="1CH 17:21" />Kuya iwanu wachi iwali muisi mwose iwodaha kwighala na iwanu wako wa Isiraeli, wane Imulungu iyaghendile kuwakombola na kuwatenda wawe wanu wake, na iyalitendile litaghwa lyake limanyike? Ghweghwe tsakutenda pfihulo na pfinu pfa ukukangawatsa kwa kuwawinga iwanu wa isi tsingi hambele ha iwanu wako yuwakombole kulawa Misiri. <verse eid="1CH 17:21" /><verse number="22" style="v" sid="1CH 17:22" />Ghweghwe tsakuwatenda iwanu wako wa Isiraeli wawe wanu wako wa ghamatsuwa ghose, naghwe, ghwe IMNDEWA sambi kuwa Imulungu wawo. <verse eid="1CH 17:22" /><verse number="23" style="v" sid="1CH 17:23" />Lelo ghwe IMNDEWA, utende mna ghamatsuwa ghose ighakutsa, achila chaunongele nene mtumighwa wako na iwanu wa ikaya yangu. Utende ka pfaulongile. <verse eid="1CH 17:23" /><verse number="24" style="v" sid="1CH 17:24" />Taghwa lyako litsomanyika mna ghamatsuwa ghose, nawo iwanu watsolonga, ‘IMNDEWA yane ngupfu, Imulungu wa Isiraeli, yuyo Imulungu wa Isiraeli’ Na nene Daudi, na ukulu wako utsakwinulighwa matsuwa ghose. <verse eid="1CH 17:24" /><verse number="25" style="v" sid="1CH 17:25" />Kwaapfila ghwe Imulungu wangu, kungubulila nene mtumighwa wako ka watsukulu wangu watsakuwa wafalume. Apfo nene mtumighwa wako nahela wogha wa kukulomba. <verse eid="1CH 17:25" /><verse number="26" style="v" sid="1CH 17:26" />Ghwe IMNDEWA, ghweghwe kwa Imulungu! Ghweghwe kunongela nene mtumighwa wako chinu achino chinoghile ichikutsa. <verse eid="1CH 17:26" /><verse number="27" style="v" sid="1CH 17:27" />Sambi kona pfinogha kuwabaliki watsukulu wako nene mtumighwa wako, ili wakale ghamatsuwa ghose hambele hako, kwaapfila Ghwe IMNDEWA, kuwabaliki, nawo wabalikighwa ghamatsuwa ghose.”<verse eid="1CH 17:27" /></para>
  <chapter eid="1CH 17" />
  <chapter number="18" style="c" sid="1CH 18" />
  <para style="s">Ukuhuma kwa maasikali wa Daudi</para>
  <para style="r">(<ref loc="2SA 8:1-18">2 Sam 8:1-18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 18:1" />Hambele chidogho mfalume Daudi tsakawatowa Wafilisti na kuwahuma. Kaghusola ghumji ghwa Gati hamwe na tsikaye itsitsunguluka tsawang'ali wokala Wafilisti. <verse eid="1CH 18:1" /><verse number="2" style="v" sid="1CH 18:2" />Pfipfila kawatowa Wamoabu, nawo wawa watumwa wake na wang'ali womliha ikodi. <verse eid="1CH 18:2" /><verse number="3" style="v" sid="1CH 18:3" />Mfalume Hadadezeri wa Soba, hayaghendile kuisola isi ikalile habehi na ghumto Eufrate iwe yake, Daudi ketingana naye mna isi ya Hamati na kamtowela kuko. <verse eid="1CH 18:3" /><verse number="4" style="v" sid="1CH 18:4" />Daudi tsakaboka mituka ya farasi elufu imwe, maasikali wadina farasi elufu saba, na maasikali iwoghenda kwa mghulu elufu ishilini. Kuya Daudi tsakawagana tsinyughe tsa ghamaghulu gha kuchughu gha wafarasi wose iwendese imituka, lekeni kaleka kuwagana tsinyughe wafalasi miya imwe. <verse eid="1CH 18:4" /><verse number="5" style="v" sid="1CH 18:5" />Nawo Waaramu wa Damasko hawaghendile kumwapfila Hadadezeri mfalume wa Soba, Daudi kawatowa, kawakoma iwanu elufu ishilini na mbili. <verse eid="1CH 18:5" /><verse number="6" style="v" sid="1CH 18:6" />Kuya Daudi kaweka maasikali wakale hane ghumji ghwa Shamu ya Damasko. Apfo Waaramu wawa watumwa wake, wamliha ikodi. IMNDEWA kamtenda Daudi yahume kokose kwayaghendile. <verse eid="1CH 18:6" /><verse number="7" style="v" sid="1CH 18:7" />Daudi tsakasola tsingawo atsila tsa nzahabu itsisolighwe na pfilongotsi wakulu wa Hadadezeri, na katsighala Yerusalemu. <verse eid="1CH 18:7" /><verse number="8" style="v" sid="1CH 18:8" />Daudi pfipfila tsakasola Shaba bwelele kulawa kuna ghumji ghwa Tibihati, na ghwa Kuni, imiji yake Hadadezeri. Hambele Selemani tsakafina bigha kulu lya shaba, tsingutso na pfinu pfingi pfa shaba kulawa mna ishaba ayo. <verse eid="1CH 18:8" /><verse number="9" style="v" sid="1CH 18:9" />Mfalume Tou wa Hamati hayulike ka Daudi kawatowa maasikali wose wa Hadadezeri mfalume wa Soba, <verse eid="1CH 18:9" /><verse number="10" style="v" sid="1CH 18:10" />kamtuma mwanaghe iyakemighwe Hodoramu kwa mfalume Daudi, yakamlamse na kumwing'a ihongela yake kwa kumtowa Hadadezeri kung'ondo. Kwaapfila Hadadezeri chila mala yang'ali yetowagha na Tou. Hadoramu tsakamghalila Daudi pfinu pfa nzahabu, pfetsa, na shaba. <verse eid="1CH 18:10" /><verse number="11" style="v" sid="1CH 18:11" />Ipfinu apfo pfeng'ighwe mfalume Daudi tsakapfilapfa pfiwe pfa IMNDEWA, ka apfila pfayatendile kwa ifetsa na nzahabu iyabokile kulawa mna isi tsa Edomu, Moabu, Amoni, Filisti, na Amaleki. <verse eid="1CH 18:11" /><verse number="12" style="v" sid="1CH 18:12" />Abishai mwana wa Seruya, tsakawakoma Waedomu elufu kumi na nane hana ulwanda lwa Munyu. <verse eid="1CH 18:12" /><verse number="13" style="v" sid="1CH 18:13" />Kuya Daudi kaweka maasikali wakale Edomu. Apfo Waedomu wawa watumwa wake, IMNDEWA kamtenda Daudi yahume kokose kwayaghendile. <verse eid="1CH 18:13" /><verse number="14" style="v" sid="1CH 18:14" />Apfo Daudi tsakatawala Isiraeli yose, na tsakatenda ghanoghile na gha haki kwe iwanu wake wose. <verse eid="1CH 18:14" /><verse number="15" style="v" sid="1CH 18:15" />Yoabu mwana wa Seruya tsakakala mkulu wa maasikali, Yehoshafati mwana wa Ahiludi yang'ali yakwika tsikumbukumbu, <verse eid="1CH 18:15" /><verse number="16" style="v" sid="1CH 18:16" />Sadoki mwana wa Ahitubu na Ahimeleki, mwana wa Abiatari, awano tsawatambika, Shausha yang'ali yakwandikagha aghala igholawila. <verse eid="1CH 18:16" /><verse number="17" style="v" sid="1CH 18:17" />Benaya mwana wa Yehoyada tsakawalongotsa Wakereti na Wapeleti, na iwanaghe Daudi tsapfilongotsi wakulu mna ufalume wake.<verse eid="1CH 18:17" /></para>
  <chapter eid="1CH 18" />
  <chapter number="19" style="c" sid="1CH 19" />
  <para style="s">Daudi kowatowa Waamoni wa Waashuru</para>
  <para style="r">(<ref loc="2SA 10:1-19">2 Sam 10:1-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 19:1" />Hambele chidogho, Nahashi mfalume wa Waamoni tsakafa, naye Hanunu imwanaghe kawa mfalume hanu ha aba wake. <verse eid="1CH 19:1" /><verse number="2" style="v" sid="1CH 19:2" />Daudi tsakalonga, “Nitsomtendela ghanoghile Hanunu mwana wa Nahashi, kwaapfila aba wake tsakanendela ighanoghile.” Apfo Daudi kawatuma iwanu wakamkanze Hanuni kwa ukufa kwa aba wake. Iwanu wa Daudi hawapfikile kwa Hanuni mna isi ya Waamoni wakamkanze, <verse eid="1CH 19:2" /><verse number="3" style="v" sid="1CH 19:3" />wakulu wa Waamoni wamlongela mfalume Hanuni, “Apfi koghamba Daudi komnoghela aba wako mbaka kawaghala iwanu watse wakukanze? Iwanu awano ng'awatumighwe baye kuipelemba isi ili waihinye?” <verse eid="1CH 19:3" /><verse number="4" style="v" sid="1CH 19:4" />Apfo Hanuni kawaghogha iwanu awo wa Daudi, kawagheta tsindepfu tsawo, na kaghaghana maghwanda ghawo hane ghamadako, kuya kawaleka woke. <verse eid="1CH 19:4" /><verse number="5" style="v" sid="1CH 19:5" />Munu yumwe kamghendela Daudi kamlongela achila chawatendelighwe iwanu wake, baho Daudi kawatuma iwanu waghende wakatingane nawo, kwaapfila tsawaghelighwa chinyala ghendo. Mfalume Daudi kawalongela, “Mkale Yeriko mbaka ndepfu tsenu tsote keli, kuya muye.” <verse eid="1CH 19:5" /><verse number="6" style="v" sid="1CH 19:6" />Waamoni hawonile ka ichinu acho chimdesa mfalume Daudi, Hanuni na Waamoni wawatuma iwanu wawo aku waweng'a kilo elufu salasini na nne tsa fetsa, wakodi imituka na iwanu iwakwendesa mituka ayo kulawa Mesopotamia na Maaka na kulawa Soba. <verse eid="1CH 19:6" /><verse number="7" style="v" sid="1CH 19:7" />Tsawakodi mituka ya ukukweghighwa elufu selasini na mbili na wamsola mfalume wa Maaka na maasikali wake, watsa kukala habehi na Medeba. Waamoni walawa mna imiji yawo yose, watsa kwitowa. <verse eid="1CH 19:7" /><verse number="8" style="v" sid="1CH 19:8" />Naye Daudi hayahulike apfo, kamtuma Yoabu na maasikali wose. <verse eid="1CH 19:8" /><verse number="9" style="v" sid="1CH 19:9" />Waamoni tsawalawa wakala mna misululu hane lilango lya ukwingililila mna ghumji ghwao, aku iwafalume awala iwatsile tsawakala waliyeka hane ichiwala. <verse eid="1CH 19:9" /><verse number="10" style="v" sid="1CH 19:10" />Yoabu hayonile ka kuna maaduwi wema misululu hambele na kuchughu, kawasaghula maasikali iwadahile ukwitowa mna Isiraeli, kaweka weme hanu hao kwa ukuwatowa Waaramu. <verse eid="1CH 19:10" /><verse number="11" style="v" sid="1CH 19:11" />Kuya maasikali iwasighale kawaleka kwa ndughu yake Abishai yawalongotse, nawo pfipfila tsawakala kwa ukuwatowa Waamoni. <verse eid="1CH 19:11" /><verse number="12" style="v" sid="1CH 19:12" />Yoabu kalonga, “Ka Waaramu wonitowa, mwemwe mtse mnyapfile na ka Waamoni womtowani, twetwe twakutsa kumwapfilani. <verse eid="1CH 19:12" /><verse number="13" style="v" sid="1CH 19:13" />Mgangamale na twitowe ka walume, tuwakinge iwanu wetu na imiji ya Imulungu wetu. Naye IMNDEWA katsotenda achila chayakona chinogha hambele hake.” <verse eid="1CH 19:13" /><verse number="14" style="v" sid="1CH 19:14" />Kuya Yoabu na maasikali wake tsawasoghela hambele waketowe na Waaramu, baho nawo tsawatsuma. <verse eid="1CH 19:14" /><verse number="15" style="v" sid="1CH 19:15" />Waamoni hawonile Waaramu wotsuma, nawo pfipfila watsuma hambele ha Abishai, ndughu yake Yoabu, watsumila mghati mwa ghumji. Kuya Yoabu koya Yerusalemu. <verse eid="1CH 19:15" /><verse number="16" style="v" sid="1CH 19:16" />Lekeni Waaramu hawonile ka watowighwa na Waisiraeli, wawatuma iwanu waghende wakawaghale Waaramu wangi iwakalile kumwambu mwa ghumto, iwalongotsighwe na Shofaki, mkulu wa maasikali wa Hadadeseri. <verse eid="1CH 19:16" /><verse number="17" style="v" sid="1CH 19:17" />Daudi hayahulike mbuli ayo, kawakema hamwe maasikali wose wa Isiraeli, kuya waloka ghumto Yoridani, kawaghendela na kaweka maasikali weme mna misululu kwa ukuwatowa Waaramu. <verse eid="1CH 19:17" /><verse number="18" style="v" sid="1CH 19:18" />Lekeni Waaramu tsawatsuma hambele ha Waisiraeli, naye Daudi kawakoma iwanu iwakwendesa imituka ya ukukweghighwa na falasi elufu saba na masikali iwoghenda kwa maghulu elufu alubaini. Kuya tsakamkoma Shofaki, mkulu wawo. <verse eid="1CH 19:18" /><verse number="19" style="v" sid="1CH 19:19" />Watumwa wa Hadadezeri hawonile Waisiraeli wawatowa, baho wepatana na Daudi, na wawa watumwa wake. Kulawa baho Waaramu ng'awatoghole keli baye kuwapfila Waamoni.<verse eid="1CH 19:19" /></para>
  <chapter eid="1CH 19" />
  <chapter number="20" style="c" sid="1CH 20" />
  <para style="s">Daudi koghusola ghumji ghwa Raba</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 20:1" />Mwanduso wa ghumwaka ghwao ghungi, ghumsimu ghwa iwafalume kughenda kwing'ondo, Yoabu tsakawalongotsa maaskali wake na kaitsingila isi ya Waamoni, Kuya kaghenda kuna ghumji ghwa Raba na kaghutsingila. Lekeni Daudi tsakasighala ako Yerusalem. Naye Yoabu tsakaghutowa ghumji ghwa Raba na kughuhinya ghendo. <verse eid="1CH 20:1" /><verse number="2" style="v" sid="1CH 20:2" />Naye Daudi hayapfikile Raba, tsakalisola litaji lyayapfalile mwitwi, mulungu wawo Milikomu, baho tsakatanga ka litaji alyo tsalina kilo salasini na tano tsa nzahabu na mghati mwake tsamna libwe lya bei ng'ulu. Daudi tsakalisola libwe alyo keka mna litaji lyake. Pfipfila Daudi tsakaboka pfinu pfingi kulawa mna ghumji agho. <verse eid="1CH 20:2" /><verse number="3" style="v" sid="1CH 20:3" />Kuya kawasola iwanu wa ghumji agho kaweka wasang'ane tsing'onde kwa misumeno, kwa tsisululu na kwa tsihoya. Apfo pfipfo Daudi pfayaitendile imiji yose ya Waamoni. Kuya Daudi na iwanu wake wose woya Yerusalemu.<verse eid="1CH 20:3" /></para>
  <para style="s">Ng'ondo na imitsinu ya Wafilisti</para>
  <para style="r">(<ref loc="2SA 21:15-22">2 Sam 21:15-22</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 20:4" />Hambele tsakulawila ng'ondo na Wafilisti ako Gezeri. Sibekai iyolawa Hushati tsakalikoma tsinu kulu likemighwa Sipai, iyawile mtsukulu wa Warefai, nawo Wafilisti tsawatowighwa. <verse eid="1CH 20:4" /><verse number="5" style="v" sid="1CH 20:5" />Tsakulawila keli ing'ondo na Wafilisti, naye Elihamani mwana wa Yairi tsakamkoma Lahimi ndughu yake Goriati kulawa Gati yane mghoha ka ghumbiki ghwa kufumila. <verse eid="1CH 20:5" /><verse number="6" style="v" sid="1CH 20:6" />Kuya hambele tsailawila keli ing'ondo ako Gati, tsakuna tsinu lina pfidole sita, mna ghamoko na mna ghamaghulu, pfose tsapfidole ishilini na pfine. Yeye pfipfila tsakakawila mlukolo lwa mitsinu ya Refai. <verse eid="1CH 20:6" /><verse number="7" style="v" sid="1CH 20:7" />Naye hayawalighile Waisiraeli, Yonasani mwana wa Shimea, ndughu yake Daudi tsakamkoma. <verse eid="1CH 20:7" /><verse number="8" style="v" sid="1CH 20:8" />Awano tsa iwana wa imitsinu ako Gati, nawo tsawakomighwa na Daudi na iwanu wake.<verse eid="1CH 20:8" /></para>
  <chapter eid="1CH 20" />
  <chapter number="21" style="c" sid="1CH 21" />
  <para style="s">Daudi kowapeta Waisiraeli</para>
  <para style="r">(<ref loc="2SA 24:1-5">2 Sam 24:1-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 21:1" />Setani tsakabama yawatende Waisiraeli waghaye, kamtsongetsa Daudi yawapete iwanu wa Isiraeli. <verse eid="1CH 21:1" /><verse number="2" style="v" sid="1CH 21:2" />Apfo Daudi kamlongela Yoabu na pfilongotsi wamwenga wa maasikali, “Ghendeni mkawapete Waisiraeli kulawa Beeri Sheba mbaka Dani. Kuya mtse mnongele na nimanye iwanu wali wangapi.”<verse eid="1CH 21:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 21:3" />Lekeni Yoabu kalonga, “IMNDEWA yawongetse Waisiraeli mala miya imwe kubita pfawali sambi! Mkulu wangu mfalume, angu awa wose si watumwa wako baye? Hebali lelo kobama kutenda chinu achino na kuwahonza Waisiraeli wose watende nzambi?” <verse eid="1CH 21:3" /><verse number="4" style="v" sid="1CH 21:4" />Lekeni chayalongile mfalume tsachiwa na ngupfu kubita Yoabu, apfo Yoabu koka, kaghenda mna isi yose ya Isiraeli, kuya koya Yerusalemu. <verse eid="1CH 21:4" /><verse number="5" style="v" sid="1CH 21:5" />Yoabu kamkongela Daudi ka mna isi yose ya Isiraeli tsamna wamale milioni imwe na laki imwe iwodaha kwitowa na mna isi ya Yuda tsamna wamale laki nne na elufu sabini iwodaha kwitowa kwing'ondo. <verse eid="1CH 21:5" /><verse number="6" style="v" sid="1CH 21:6" />Lekeni Yoabu ng'awapetile baye Walawi na Wabenjamini kwaapfila laghitso lya mfalume tsalimdesa ng'ani. <verse eid="1CH 21:6" /><verse number="7" style="v" sid="1CH 21:7" />Imbuli ya ukupetighwa iwanu yoneka iha hambele ha Imulungu, apfo Imulungu kaitowa Isiraeli. <verse eid="1CH 21:7" /><verse number="8" style="v" sid="1CH 21:8" />Daudi kamlongela Imulungu, “Nitenda nzambi ng'ulu kwa chinu achino chanitendile! Lekeni nokulomba undeghusile nene mtumwa wako inzambi ino, kwaapfila chanendile chinu cha ubotsi ghendo.” <verse eid="1CH 21:8" /><verse number="9" style="v" sid="1CH 21:9" />Apfo IMNDEWA tsakalonga na Gadi, nabii wake Daudi, kamlongela, <verse eid="1CH 21:9" /><verse number="10" style="v" sid="1CH 21:10" />“Ughende ukamlongele apfino Daudi, nene IMNDEWA nomwing'a pfinu pfidatu naye yasaghule chimwe mna apfo pfidatu, na nene nimtsomtendela.” <verse eid="1CH 21:10" /><verse number="11" style="v" sid="1CH 21:11" />Apfo Gadi kamghendela Daudi kamlongela, “IMNDEWA kolonga pfino, ‘Usaghule chinu chimwe, <verse eid="1CH 21:11" /><verse number="12" style="v" sid="1CH 21:12" />nzala ya miyaka midatu, au miyetsi midatu ya kuhingighwa na maadui tsako, iwatsokutowa na mimaghe yawo, au usaghule matsuwa madatu gha IMNDEWA ghayatsowatowa kwa lipanga lyake, na kuwaghalila utamu wihile muisi na kumtuma malaika wake yakome chila chinu mna isi yose ya Isiraeli’ Lelo ulamle na unyidike, kuya nene ng'ende nikamwidike ayula iyanitumile.” <verse eid="1CH 21:12" /><verse number="13" style="v" sid="1CH 21:13" />Daudi tsakamlongela Gadi, “Nina wogha mkulu! Ng'apfu nihighighwe na IMNDEWA, kwaapfila yeye kamema libatsi, lekeni uleke kundeka ngoghighwe na ghamoko gha iwanu.” <verse eid="1CH 21:13" /><verse number="14" style="v" sid="1CH 21:14" />Apfo IMNDEWA kawaghalila Waisiraeli utamu wihile, nawo uwakoma wanu elufu sabini. <verse eid="1CH 21:14" /><verse number="15" style="v" sid="1CH 21:15" />Kuya Imulungu kamtuma malaika wake yakaghuhinye ghumji ghwa Yerusalemu na kuwakoma iwanu wake. Imalaika ayo hayang'ali yoghuhinya ghumji agho, IMNDEWA tsakalola, na kona usungu apfila iwanu pfawakomighwe, baho kamlongela malaika ayula iyang'ali yokoma iwanu, “Wime, yuitsa ghumoko ghwako” Imalaika ayo tsakema habehi na chibwalu cha ukubetela tsimbeghu cha Orinani Myebusi. <verse eid="1CH 21:15" /><verse number="16" style="v" sid="1CH 21:16" />Daudi kenula tsinenge, kamwona malaika kema haghati mwe lilanga na muisi, aku kakinda lipanga mmoko mwake na kaligholosa mchanya mwa Yerusalemu. Baho Daudi na wanzehe wose iwapfalile maghunila, waghwa chiduli. <verse eid="1CH 21:16" /><verse number="17" style="v" sid="1CH 21:17" />Daudi tsakamlongela Imulungu, “Apfi si nene baye yandapfile laghitso iwanu wapetighwe? Nene yuyo yanendile nzambi ng'ulu, na yanitendile ghehile. Lekeni iwanu awano iwali ka ng'olo tsawatendile choni? Nokulomba ghendo, ghwe IMNDEWA, Imulungu wangu, ghumoko ghwako ghundaghe nene na ghuwalaghe iwanu wa ikaye yangu, lekeni utamu auno wihile uleke kuwapata iwanu wako.”<verse eid="1CH 21:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 21:18" />Baho imalaika ayo kamlongela Gadi yakamlongele Daudi yagheluke yakamtsengele IMNDEWA imatsabahu hane ichibwalu cha ukupetela tsimbeghu cha Orinani Myebusi. <verse eid="1CH 21:18" /><verse number="19" style="v" sid="1CH 21:19" />Apfo Daudi katenda laghitso lya Imulungu, kagheluka kuchanya ka apfila IMNDEWA pfayamlongele. <verse eid="1CH 21:19" /><verse number="20" style="v" sid="1CH 21:20" />Orinani hayang'ali yobeta ingano, baho kahunduka kamwona imalaika ayula. Yeye na iwanaghe wane tsawaghenda kwipfisa. <verse eid="1CH 21:20" /><verse number="21" style="v" sid="1CH 21:21" />Kuya Daudi kamghendelela Orinani, naye hayalolile na kumwona Daudi, kalawa hana ichibwalu cha ukubetela, kaghenda ukumwinamila Daudi mbaka uhanga wake udonza hasi. <verse eid="1CH 21:21" /><verse number="22" style="v" sid="1CH 21:22" />Daudi kamlongela, “Niutsile chibwalu chako cha ukubetela nimtsengela IMNDEWA imatsabahu, na utamu aula wihile ukomile iwanu umale.”<verse eid="1CH 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 21:23" />Naye Orinani kamlongela Daudi, “Uchisole chibwalu achino, mkulu wangu mfalume uchitendele pfopfose pfaubama mwenyegho. Kuya nowalapfa ng'ombe wangu wawe nambiko ya ukulakatsighwa, na mibiki yangu ya kubetela iwe ngodi, na nokwing'a ingano iwe nambiko ya tsimbeghu. Pfose apfo nokwing'a.”<verse eid="1CH 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 21:24" />Lekeni mfalume Daudi kamlongela Orinani, “Baye, nitsokuliha chila chinu kwa bei yake, sitsosola baye chinu chako chiwe cha IMNDEWA, au kumlapfila nambiko tsa ukulakatsighwa, bila nene kumlapfila chinu.” <verse eid="1CH 21:24" /><verse number="25" style="v" sid="1CH 21:25" />Apfo Daudi tsakamliha Orinani pfihande miya sita pfa nzahabu kwa kughula ichibwalu acho. <verse eid="1CH 21:25" /><verse number="26" style="v" sid="1CH 21:26" />Kuya Daudi kamtsengela IMNDEWA imatsabahu hanu aho, na kamlapfila nambiko tsa ukulakatsighwa na tsa ukukala tseghamba. Kamlomba IMNDEWA naye katoghola chayamlombile kwa kughala ghumoto kulawa kulanga ghutsilakatse tsinambiko atsila hana imatsabahu. <verse eid="1CH 21:26" /><verse number="27" style="v" sid="1CH 21:27" />Kuya IMNDEWA kamlaghitsa malaika wake, naye koyitsa lipanga hana iyala yake. <verse eid="1CH 21:27" /><verse number="28" style="v" sid="1CH 21:28" />Chipindi acho, Daudi hayonile IMNDEWA katoghola chayamlombile akula kuna ichibwalu cha ukubetela cha Orinani Myebusi, kalapfa nambiko kuko. <verse eid="1CH 21:28" /><verse number="29" style="v" sid="1CH 21:29" />Lihema lyatsengile Musa akula kunyika, na matsabahu ya nambiko tsa ukulakatsighwa, matsuwa agho tsapfing'ali hanu ha ukatambikila ako Gibeoni. <verse eid="1CH 21:29" /><verse number="30" style="v" sid="1CH 21:30" />Lekeni Daudi ng'aghendile baye ako Gibeoni kumlomba Imulungu kwaapfila tsayang'ali yopfuka lipanga lya malaika wa IMNDEWA.<verse eid="1CH 21:30" /></para>
  <chapter eid="1CH 21" />
  <chapter number="22" style="c" sid="1CH 22" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 22:1" />Kuya Daudi kalonga, “Ing'anda ya IMNDEWA Imulungu iwe ahano, na imatsabahu ya ukulapfila tsinambiko tsa ukulakatsighwa ya wanu wa Isiraeli itsakuwa ahano.”<verse eid="1CH 22:1" /></para>
  <para style="s">Ukwitanda kutsenga ing'anda ye Imulungu</para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 22:2" />Daudi tsakalaghitsa iwagheni wose iwali mna isi ya Isiraeli watingane hamwe, kulawa mna wawo kawasaghula iwanu iwadahile kusongola ghamabwe wasongole ghamabwe gha ukutsengela ing'anda ye Imulungu. <verse eid="1CH 22:2" /><verse number="3" style="v" sid="1CH 22:3" />Kuya Daudi kalapfa ichuma bwelele iyekile, katendela misumari na bawaba tsa kuhindila mibani ye ing'anda, pfipfila tsakalapfa ishaba bwelele iyekile, nayo ng'ailingika baye. <verse eid="1CH 22:3" /><verse number="4" style="v" sid="1CH 22:4" />Kuya tsakalapfa tsimbao tsa mieletsi bwelele, kuduhu iyodaha kutsipeta, atsila Wasidoni na Watiro tsawamghalile Daudi. <verse eid="1CH 22:4" /><verse number="5" style="v" sid="1CH 22:5" />Daudi tsakelongela imwenyegho, “Ing'anda yatsotsenga mwanangu Selemani iwe ya IMNDEWA itsonogha ghendo na itsomanyika muisi mwose. Lekeni kwaapfila yang'ali msongolo na yang'ali kumanya pfinu pfingi, ng'apfu nimwikikile ipfinu pfa kutsengela.” Apfo Daudi tsakeka ipfinu pfingi pfa ukutsengela ing'anda ye Imulungu hala ng'ana yafe. <verse eid="1CH 22:5" /><verse number="6" style="v" sid="1CH 22:6" />Kuya Daudi kamkema Selemani imwanaghe, kamlaghitsa yamtsengele ing'anda IMNDEWA, Imulungu wa Isiraeli. <verse eid="1CH 22:6" /><verse number="7" style="v" sid="1CH 22:7" />Daudi tsakamlongela Selemani, “Mwanangu nene tsanibama ghendo mmoyo mwangu nimtsengele ing'anda IMNDEWA, Imulungu wangu ili nilitunye taghwa lyake. <verse eid="1CH 22:7" /><verse number="8" style="v" sid="1CH 22:8" />Lekeni mbuli ye IMNDEWA initsila, inongela, ‘Ghweghwe tsakumwagha sideke idamu muisi, kwitowa ng'ondo ng'ulu, kwaapfila ghweghwe tsakumwagha sideke idamu mna isi hambele hangu, apfo ng'autsonitsengela baye ing'anda likale taghwa lyangu. <verse eid="1CH 22:8" /><verse number="9" style="v" sid="1CH 22:9" />Lekeni kutsopata mwana mmale, imwana ayo katsokala bila kwitowa naye katsobwihila ghendo, yeye ng'atsetowa baye na maadui tsake wose wa habehi iwomtsunguluka. Taghwa lyake katsokemighwa Selemani, kwaapfila mna ghamatsuwa ghake gha ukutawala katsowatenda Waisiraeli wakale tseghamba na wakale tulu ghendo. <verse eid="1CH 22:9" /><verse number="10" style="v" sid="1CH 22:10" />Apfo yeye yuyo iyatsonitsengela ing'anda ili taghwa lyangu litunyighwe. Yeye katsakuwa mwanangu na nene nitsakuwa aba wake. Na lukolo lwake lutsotawala Isiraeli ghamatsuwa ghose.’ <verse eid="1CH 22:10" /><verse number="11" style="v" sid="1CH 22:11" />Lelo mwanangu, IMNDEWA yawe naghwe ili udahe kumtsengela ing'anda IMNDEWA, Imulungu wako ka pfayakulongele umtsengele. <verse eid="1CH 22:11" /><verse number="12" style="v" sid="1CH 22:12" />IMNDEWA yakwing'e ihekima na tsimbutsi ahala hayokwika uilongotse isi ya Isiraeli, ughakinde ghamalaghitso gha IMNDEWA, Imulungu wako. <verse eid="1CH 22:12" /><verse number="13" style="v" sid="1CH 22:13" />Kutsobweda ung'akinda ghoya imiko na ghamalaghitso gha IMNDEWA ghayaweng'ile Waisiraeli kubitila Musa. Lelo Ugangamale na wikinde na uleke kupfuka wala kutenyuka ghumoyo. <verse eid="1CH 22:13" /><verse number="14" style="v" sid="1CH 22:14" />Nisang'ana ng'onde ng'omu nyike ipfinu pfa ukutsengela ing'anda ye Imulungu, nyika tani elufu nne tsa nzahabu, na tani elufu alubaini tsa fetsa, na nyika ishaba na ichuma bwelele, nayo ng'aidahika baye kupetighwa. Pfipfila nyika ghamabwe na tsimbao. Naghwe kodaha ukongetsa mna apfo. <verse eid="1CH 22:14" /><verse number="15" style="v" sid="1CH 22:15" />Kwinawo iwanu wengi wa kusang'ana, kwinawo wasongola ghamabwe, watsenga tsing'anda, wasongola mibiki na kwinawo wanu wengi iwakubuhu mna chila ng'onde, <verse eid="1CH 22:15" /><verse number="16" style="v" sid="1CH 22:16" />kwinawo ghendo iwanu iwodaha kutenda ipfinu kulawa kuna inzahabu na fetsa na shaba na chuma. Lelo wanze isang'ano ya ukutsenga, na IMNDEWA yawe naghwe!” <verse eid="1CH 22:16" /><verse number="17" style="v" sid="1CH 22:17" />Pfipfila Daudi tsakawalaghitsa pfilongotsi wose wa Isiraeli wamwapfile Selemani, imwanaghe, kalonga, <verse eid="1CH 22:17" /><verse number="18" style="v" sid="1CH 22:18" />“IMNDEWA, Imulungu wenu kahamwe na mwemwe ghendo. Yeye kawatenda mkale tseghamba na iwanu iwomtsungulukani. Yeye kawaghoghela iwanu iwakalile mna isi ino, na sambi wa mmoko mwenu, wolongotsighwa na Imulungu na iwanu wake. <verse eid="1CH 22:18" /><verse number="19" style="v" sid="1CH 22:19" />Lelo mtumikileni IMNDEWA, Imulungu wenu kwa ghumoyo ghwose. Mwanze kumtsengela IMNDEWA hanu haenzeluke, ili mwingitse lisanduku lya laghano lya IMNDEWA na ipfinu pfose ipfihenzeluke pfa Imulungu, mghati mwe ing'anda itsengighwe likale litaghwa lya IMNDEWA.”<verse eid="1CH 22:19" /></para>
  <chapter eid="1CH 22" />
  <chapter number="23" style="c" sid="1CH 23" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 23:1" />Daudi hayakalile ka kalala na miyaka yake ifosa ghendo, tsakamsaghula Selemani, imwanaghe yawe mfalume wa Isiraeli.<verse eid="1CH 23:1" /></para>
  <para style="s">Sang'ano tsa Walawi</para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 23:2" />Mfalume Daudi tsakawakema hamwe pfilongotsi wose wa Isiraeli, iwatambika na Walawi. <verse eid="1CH 23:2" /><verse number="3" style="v" sid="1CH 23:3" />Walawi wose iwamale wane miyaka salasini na kubita, tsawapetighwa. Wosewose tsa elufu selasini na nane. <verse eid="1CH 23:3" /><verse number="4" style="v" sid="1CH 23:4" />Kuya Daudi kalonga, “Kulawa mna Walawi wose, Walawi elufu ishilini na nane wemilile isang'ano hana ing'anda ye Imulungu, na Walawi elufu sita wawe wakulu na walamtsi. <verse eid="1CH 23:4" /><verse number="5" style="v" sid="1CH 23:5" />Walawi elufu nne wawe wakalitsi wa ghamalango na Walawi elufu nne wamwimbileghe Imulungu kwa tsingoma na ipfinu pfaniweng'ile wanitowele.” <verse eid="1CH 23:5" /><verse number="6" style="v" sid="1CH 23:6" />Daudi tsakawaghola Walawi wakale mna makingili madatu kwa kulola tsikolo tsawolawa mna likabila lyao lya Walawi: lukolo lwa Gerishoni, lwa Kohatsi na lukolo lwa Merari. <verse eid="1CH 23:6" /><verse number="7" style="v" sid="1CH 23:7" />Iwana wa Gerishoni tsa weli, Ladani na Shimei. <verse eid="1CH 23:7" /><verse number="8" style="v" sid="1CH 23:8" />Ladani tsakana wana wadatu: mwanaghe chaudele tsa Yehieli, wakeli tsa Setamu na wakadatu tsa Yoeli. <verse eid="1CH 23:8" /><verse number="9" style="v" sid="1CH 23:9" />Iwanaghe Shimei tsa wadatu Shelomati na Hasieli na Harani. Awano wadatu tsa pfilongotsi we lukolo lwa Ladani. <verse eid="1CH 23:9" /><verse number="10" style="v" sid="1CH 23:10" />Iwanaghe Shimei tsa wane; Yahati na Sina na Yehushi na Beria. <verse eid="1CH 23:10" /><verse number="11" style="v" sid="1CH 23:11" />Yehati yuyo mkulu wawo, wakeli Ziza. Lekeni Yehushi na Beria tsawahela iwana wengi, apfo wekighwa mna lukolo lumwe. <verse eid="1CH 23:11" /><verse number="12" style="v" sid="1CH 23:12" />Wana wa Kohati tsa wane: Amramu, Ishali, Heburoni na Uzieli. <verse eid="1CH 23:12" /><verse number="13" style="v" sid="1CH 23:13" />Iwanaghe Amramu tsa Aruni na Musa. Aruni tsakabaghulighwa yeye na iwatsukulu wake wose, wapfitende ipfinu pfiwe pfienzeluke ghendo, kuya wamlapfile IMNDEWA tsinambiko na kuwabaliki iwanu kwa kulikema litaghwa lya Imulungu. <verse eid="1CH 23:13" /><verse number="14" style="v" sid="1CH 23:14" />Lekeni wana wa Musa, imunu wa Imulungu tsawekighwa hamwe mna likabila lya Lawi. <verse eid="1CH 23:14" /><verse number="15" style="v" sid="1CH 23:15" />Wana wa Musa tsa Gerishomu na Eriezeri. <verse eid="1CH 23:15" /><verse number="16" style="v" sid="1CH 23:16" />Iwanaghe Garishomu tsa Shebueli, iyakalile mkulu wawo. <verse eid="1CH 23:16" /><verse number="17" style="v" sid="1CH 23:17" />Eliezeri tsakana mwana yumwe yaliyeka, taghwa lyake Rehabia, Lekeni Rehebia tsakana watsukulu wengi. <verse eid="1CH 23:17" /><verse number="18" style="v" sid="1CH 23:18" />Ishari tsakamweleka Shilomiti, imkulu wa kabila lyose. <verse eid="1CH 23:18" /><verse number="19" style="v" sid="1CH 23:19" />Hebroni tsakana wana wane: mwanaghe chaudele tsakakemighwa Yeria, wa keli Amaria na wakadatu Yahosueli na wa kane Yekameamu. <verse eid="1CH 23:19" /><verse number="20" style="v" sid="1CH 23:20" />Uzieli naye tsakana wana weli, mwanaghe chaudele tsakakemighwa Mika na wakabili Ishia.<verse eid="1CH 23:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 23:21" />Merari tsakana wana weli, Mali na Mushi. Naye Mali tsakana wana weli, Eliazali na Kishi. <verse eid="1CH 23:21" /><verse number="22" style="v" sid="1CH 23:22" />Eliazali tsakafa aku kahela mwana mmale, lekeni tsakapata wana wapinga waliyeka. Iwanaghe mapinga wose tsawakwelighwa na lumbu tsawo, awala iwana wa Kishi. <verse eid="1CH 23:22" /><verse number="23" style="v" sid="1CH 23:23" />Mushi yeye tsakana wana wadatu: Mali na Edari na Yeremosi. <verse eid="1CH 23:23" /><verse number="24" style="v" sid="1CH 23:24" />Awo wawo iwana wa Lawi kwa kulola tsikolo tsawo tsawolawa. Chila imunu yana miyaka ishilini na kughendelela, litaghwa lyake tsalyandikighwa, na kasang'ana mna sang'ano tsa Ing'anda ya Imulungu. <verse eid="1CH 23:24" /><verse number="25" style="v" sid="1CH 23:25" />Daudi tsakalonga, “Kwaapfila IMNDEWA, Imulungu wa Isiraeli, kawatenda iwanu wake wakale tseghamba, naye katsa kukala Yerusalemu ghamatsuwa ghose. <verse eid="1CH 23:25" /><verse number="26" style="v" sid="1CH 23:26" />Apfo Walawi ng'awatsoliduta keli baye lihema lienzeluka au pfinu pfake pfenzeluke pfa ukutambikila.” <verse eid="1CH 23:26" /><verse number="27" style="v" sid="1CH 23:27" />Kwa ghamalaghitso gha Daudi, ghayamalitsile, Walawi wose iwane miyaka ishilini tsawandikighwa. <verse eid="1CH 23:27" /><verse number="28" style="v" sid="1CH 23:28" />Walawi awano tsaweng'ighwa ing'onde kuwapfila watambika wa lukolo lwa Aruni mna isang'ano ya Ing'anda ye Imulungu: kusegha mna tsiluwa tsa ing'anda, na mna ipfiheleto, na ukuhopfugha pfinu pfose pfihenzeluke na kusang'ana ng'onde tsingi tsa Ing'anda ye Imulungu. <verse eid="1CH 23:28" /><verse number="29" style="v" sid="1CH 23:29" />Kuya tsawasang'ana mna sang'ano ya pfighate pfienzeluka, usaghe mdekedeke na nambiko ya tsimbeghu, maandatsi ing'aghelighwe hamila, nambiko iyokighwe, nambiko iitipfighwe ghamapfuta. Walawi awo wawo iwalingile utsito na ukulu wa tsinambiko atso. <verse eid="1CH 23:29" /><verse number="30" style="v" sid="1CH 23:30" />Kuya tsawang'ali wakwima kumlongela mighede Imulungu na ukumtunya chila litsuwa, nemitondo na nemihe, <verse eid="1CH 23:30" /><verse number="31" style="v" sid="1CH 23:31" />na chila hatsilapfighwe nambiko tsa kulakatsighwa kwa IMNDEWA mna ghamatsuwa gha kubwihila, na mna pfihungo pfa mlawo wa ghumwetsi, na mna pfihungo ipfisaghulighwe. Tsawalaghitsighwa Walawi wangapi iwobamighwa kumsang'anila IMNDEWA chila tsuwa. <verse eid="1CH 23:31" /><verse number="32" style="v" sid="1CH 23:32" />Apfo tsaikala sang'ano yawo Walawi kutunza Lihema lienzeluke, na kuwapfila ndughu tsawo watambika, iwana wa Aruni, mna tsisang'ano tsa ing'anda ya IMNDEWA.<verse eid="1CH 23:32" /></para>
  <chapter eid="1CH 23" />
  <chapter number="24" style="c" sid="1CH 24" />
  <para style="s">Sang'ano tsa iwatambika</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 24:1" />Apfi pfipfo iwatsukulu wa Aruni pfawagholighwe. Aruni tsakana wana wane, Nadabu na Abihu na Eliesari na Ithamari. <verse eid="1CH 24:1" /><verse number="2" style="v" sid="1CH 24:2" />Nadabu na Abihu tsawafa ng'ana aba wawo yafe baye, nawo tsawahela iwana, apfo ndughu tsawo Eleasari na Ithamani wawa watambika. <verse eid="1CH 24:2" /><verse number="3" style="v" sid="1CH 24:3" />Mfalume Daudi tsakawaghola watsukulu wa Aruni kwa kukulola sang'ano tsawo tsaweng'ighwe, Sadoki, mtsukulu wa Eliazari na Ahimereki, mtsukulu wa Itamari wang'ali womwapfila. <verse eid="1CH 24:3" /><verse number="4" style="v" sid="1CH 24:4" />Tsakuna pfilongotsi wengi iwoneke kulawa mna watsukulu wa Eliazari kubita awala iwatsukulu wa Itamari, apfo tsawasaghulighwa pfilongotsi kumi na sita kulawa kuna watsukulu wa Eliazari na wasaghulighwa pfilongotsi wanane kulawa kwa watsukulu wa Itamari. <verse eid="1CH 24:4" /><verse number="5" style="v" sid="1CH 24:5" />Tsawagholelighwa tsing'onde kwa kwasa tsisimbi tsilamle, kwaapfila mna kolo tsose atso mbili, lukolo lwa Eliezari na lukolo lwa Itamali tsakuna wakulu wa hanu haenzeluke na iwakulu iwosang'ana hana ing'anda ya Imulungu. <verse eid="1CH 24:5" /><verse number="6" style="v" sid="1CH 24:6" />Naye Shemaya mwana wa Nataneli, imwandishi, iyakalile Mlawi tsakaghandika ghamataghwa ghao hambele ha mfalume Daudi, na hambele ha iwakulu wake, kandika hambele ha mtambika Sadoki, Ahimeleki mwana wa Abiatari, na pfilongotsi wa itsikaye tsa iwatambika na tsa Walawi. Ikaya imwe tsaisaghulighwa kulawa kuna lukolo lwa Eliazari na ikaya ingi kulawa kuna ulukolo lwa Itamari. <verse eid="1CH 24:6" /><verse number="7" style="v" sid="1CH 24:7" />Wasa tsisimbi tsilamle na isimbi yanza kumghwila Yehoiaribu, ya kabili imghwila Yedaya, <verse eid="1CH 24:7" /><verse number="8" style="v" sid="1CH 24:8" />ya kadatu imghwila Harimu, na ya kane imghwila Seorimu, <verse eid="1CH 24:8" /><verse number="9" style="v" sid="1CH 24:9" />ya tano imghwila Malkia na ya sita imghwila Miyamini, <verse eid="1CH 24:9" /><verse number="10" style="v" sid="1CH 24:10" />ya saba imghwila Hakosi na ya nane imghwila Abiya, <verse eid="1CH 24:10" /><verse number="11" style="v" sid="1CH 24:11" />ya tisa imghwila Yeshua na ya kumi imghwila Shekania <verse eid="1CH 24:11" /><verse number="12" style="v" sid="1CH 24:12" />na ya kumi na moja imghwila Eliashibu na ya kumi na mbili imghwila Yakimu, <verse eid="1CH 24:12" /><verse number="13" style="v" sid="1CH 24:13" />na ya kumi na tatu imghwila Hupa na ya kumi na wane imghwila Yeshebeabu, <verse eid="1CH 24:13" /><verse number="14" style="v" sid="1CH 24:14" />na ya kumi na tano imghwila Bilga na ya kumi na sita imghwila Imeri, <verse eid="1CH 24:14" /><verse number="15" style="v" sid="1CH 24:15" />na ya kumi na saba imghwila Hesiri, na ya kumi na nane imghwila Hapisesi, <verse eid="1CH 24:15" /><verse number="16" style="v" sid="1CH 24:16" />na ya kumi na tisa imghwila Petahia, na ya ishirini imghwila Yehezkeli, <verse eid="1CH 24:16" /><verse number="17" style="v" sid="1CH 24:17" />na ya ishirini na moja imghwila Yakini, na ya ishirini na mbili imghwila Gamuli, <verse eid="1CH 24:17" /><verse number="18" style="v" sid="1CH 24:18" />na ya ishirini na tatu imghwila Delaya, na ya ishirini na nne imghwila Maasia. <verse eid="1CH 24:18" /><verse number="19" style="v" sid="1CH 24:19" />Awano wawo iwanu iwandikighwe kwa kulola tsing'onde tsawo iwatsokwingila mna ing'anda ya IMNDEWA kumsang'anila, na kukinda imiko iyekile sekulu wawo Aruni, ka apfila IMNDEWA, Imulungu wa Isiraeli pfayamlaghitse.<verse eid="1CH 24:19" /></para>
  <para style="s">Walawi wangi iwandikighwe</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 24:20" />Awano iwo pfilongotsi wa tsikaya kulawa mna ulukolo lwa Lawi: Yedeya tsachilongotsi iyalawile mna watsukulu wa Amramu. <verse eid="1CH 24:20" /><verse number="21" style="v" sid="1CH 24:21" />chilongotsi Ishio kulawa mna watsukulu wa Rehabia. <verse eid="1CH 24:21" /><verse number="22" style="v" sid="1CH 24:22" />Shelomiti tsachilongotsi iyalawile mna iwatsukulu wa Ishali, Yahati tsachilongotsi iyalawile mna watsukulu wa Shelomiti. <verse eid="1CH 24:22" /><verse number="23" style="v" sid="1CH 24:23" />Yeria tsachilongotsi iyalawile mna watsukulu wa Hebroni wakeli Amaria, wakadatu Yohasieli, na wakane Yekameamu. <verse eid="1CH 24:23" /><verse number="24" style="v" sid="1CH 24:24" />Mika tsachilongotsi iyalawile mna watsukulu wa Uzieli. Shamire, Shamili tsachilongotsi iyalawile mna watsukulu wa mika. <verse eid="1CH 24:24" /><verse number="25" style="v" sid="1CH 24:25" />Mdodo wake mika tsa Ishia, Zakaria tsachilongotsi iyalawile mna iwana wa Ishia. <verse eid="1CH 24:25" /><verse number="26" style="v" sid="1CH 24:26" />Iwana wa Merari tsa Mahili, Mushi, Yaasia, <verse eid="1CH 24:26" /><verse number="27" style="v" sid="1CH 24:27" />Beno, Shohamu, Zakuri na Ibri tsapfilongotsi kulawa mna iwana wa Merari kubitila imwanaghe Yaazia. <verse eid="1CH 24:27" /><verse number="28" style="v" sid="1CH 24:28" />Eleazari tsachilongotsi iyalawile mna iwana wa Mahili, lekeni Eleazari tsakahela iwana. <verse eid="1CH 24:28" /><verse number="29" style="v" sid="1CH 24:29" />Yerameeli tsachilongotsi iyalawile mna iwana wa Kishi. <verse eid="1CH 24:29" /><verse number="30" style="v" sid="1CH 24:30" />Mushi tsakana wana wadatu: Mahili, Ederi na Yeremoti. Awano wawo iwana wa Lawi kwa kulola tsikaya tsawo tsawolawa. <verse eid="1CH 24:30" /><verse number="31" style="v" sid="1CH 24:31" />Awo nawo pfipfila tsawatsa tsisimbi tsilamle ka apfila pfawatendile ndughu tsawo, iwana wa Aruni. Watenda apfo aku mfalume Daudi, Sadoki, Ahimeleki na iwakulu wa tsikaye tsa iwatambika na tsa Walawi wololesa. Kaya ya mwana mkulu tsaitendelighwa ka kaye ya mwana mdodo.<verse eid="1CH 24:31" /></para>
  <chapter eid="1CH 24" />
  <chapter number="25" style="c" sid="1CH 25" />
  <para style="s">Iwanu iwakwimba hana ing'anda ya Imulungu</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 25:1" />Mfalume Daudi hamwe na pfilongotsi wa maasikali tsawawasaghula wana wangi wa Asafu, wa Hemani na wa Yudutuni walongotse mna sang'ano ya ukuwapetela iwanu imbuli ya Imulungu na kumwimbila kwa ukutowa pfilimba na pfinanda na matoatsi. Awano wawo iwanu iwasaghulighwe walongotse mna ng'onde ino, na chila wanu tsaweng'ighwa ng'onde yawo, <verse eid="1CH 25:1" /><verse number="2" style="v" sid="1CH 25:2" />Iwanaghe Asafu tsa Sakuri, Yosefu, Netania, na Asharela. Awano wose wang'ali wolongotsighwa na Asafu mna ukuwapetela iwanu imbuli ya Imulungu kwa kulongotsighwa na mfalume. <verse eid="1CH 25:2" /><verse number="3" style="v" sid="1CH 25:3" />Yedutuni naye tsakana wana sita. Nawo tsa Gedalia, Seri, Yeshaya, Shimei, Hashabia na Matithia. Awano wose wang'ali wolongotsighwa na aba wawo Yedutuni, na wang'ali wopetela iwanu aku wotowa pfilimba, na wang'ali wolonga mighede na kumtunya IMNDEWA. <verse eid="1CH 25:3" /><verse number="4" style="v" sid="1CH 25:4" />Iwanaghe Hemani wawo awano: Bukia, Matania, Uzieli, Hebueli, Yeremoti, Hanania, Hanani, Eliata, Gidaliti Romanti Ezeri, Yoshibekasha, Maloti, Hotiri na Mahazioti. <verse eid="1CH 25:4" /><verse number="5" style="v" sid="1CH 25:5" />Imulungu tsakamwing'a Hemani, iyakalile nabii wa mfalume iwana wamale kumi na wane, na wana mapinga wadatu, ili wamwing'e ingupfu, ka pfayalaghane naye. <verse eid="1CH 25:5" /><verse number="6" style="v" sid="1CH 25:6" />Iwanaghe wose awano wang'ali wolongotsighwa na aba wawo mna ukwimba hana ing'anda ya IMNDEWA, aku wotowa matoatsi na pfing'weng'we na pfilimba. Asafu, Yedutuni na Hemani wawo wang'ali wolongotsighwa na mfalume. <verse eid="1CH 25:6" /><verse number="7" style="v" sid="1CH 25:7" />Wanu wose wano hamwe na ndughu tsawo, iwafundighwe na wakubuhu mna ukwimwimbila IMNDEWA, wosewose tsawapfika miya mbili na samanini na nane. <verse eid="1CH 25:7" /><verse number="8" style="v" sid="1CH 25:8" />Iwanu wose wawe wasongolo au wabala, yawe kofunda weyaghe au kofundighwa, tsawasa tsisimbi mna ukwigholela tsing'onde tsa ukutenda.<verse eid="1CH 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 25:9" />Isimbi yamwanduso imghwila Yosefu iyolawa mna ikaye ya Asafu na isimbi ya keli imghwila Gedalia hamwe na ndughu tsake na iwanaghe kumi na weli. <verse eid="1CH 25:9" /><verse number="10" style="v" sid="1CH 25:10" />Isimbi ya kadatu imghwila Sakuri hamwe na iwanaghe na ndughu tsake kumi na weli: <verse eid="1CH 25:10" /><verse number="11" style="v" sid="1CH 25:11" />ya kane imghwila Seri hamwe na iwanaghe na ndughu tsake kumi na weli; <verse eid="1CH 25:11" /><verse number="12" style="v" sid="1CH 25:12" />ya tano imghwila Nethania hamwe na iwanaghe na ndughu tsake kumi na weli, <verse eid="1CH 25:12" /><verse number="13" style="v" sid="1CH 25:13" />ya sita imghwila Bukia hamwe na iwanaghe na ndughu tsake kumi na weli, <verse eid="1CH 25:13" /><verse number="14" style="v" sid="1CH 25:14" />ya saba imghwila Asharela hamwe na wanaghe na ndughu tsake kumi na weli; <verse eid="1CH 25:14" /><verse number="15" style="v" sid="1CH 25:15" />ya nane imghwila Yeshaya, hamwe ne iwanaghe na ndughu tsake kumi na weli; <verse eid="1CH 25:15" /><verse number="16" style="v" sid="1CH 25:16" />ya tisa imghwila Matania; hamwe ne iwanaghe na ndughu tsake kumi na weli, <verse eid="1CH 25:16" /><verse number="17" style="v" sid="1CH 25:17" />ya kumi imghwila Shimei, hamwe na iwanaghe na ndughu tsake kumi na weli, <verse eid="1CH 25:17" /><verse number="18" style="v" sid="1CH 25:18" />ya kumi na imwe imghwila Asareli; hamwe na iwanaghe na ndughu tsake kumi na weli, <verse eid="1CH 25:18" /><verse number="19" style="v" sid="1CH 25:19" />ya kumi na mbili imghwila Hashabia; hamwe na iwanaghe na ndughu tsake kumi na weli, <verse eid="1CH 25:19" /><verse number="20" style="v" sid="1CH 25:20" />ya kumi na tatu imghwila Shebueli, hamwe na iwanaghe na ndughu tsake kumi na weli, <verse eid="1CH 25:20" /><verse number="21" style="v" sid="1CH 25:21" />ya kumi na nne imghwila Matithia; hamwe na iwanaghe na ndughu tsake kumi na weli, <verse eid="1CH 25:21" /><verse number="22" style="v" sid="1CH 25:22" />ya kumi na tano imghwila Yeremothi; hamwe na iwanaghe na ndughu tsake kumi na weli; <verse eid="1CH 25:22" /><verse number="23" style="v" sid="1CH 25:23" />ya kumi na sita imghwila Hanania, hamwe na iwanaghe na ndughu tsake kumi na weli, <verse eid="1CH 25:23" /><verse number="24" style="v" sid="1CH 25:24" />ya kumi na saba imghwila Yoshibekasha, hamwe na iwanaghe na ndughu tsake kumi na weli; <verse eid="1CH 25:24" /><verse number="25" style="v" sid="1CH 25:25" />ya kumi na nane imghwila Hanani hamwe na iwanaghe na ndughu tsake kumi na weli; <verse eid="1CH 25:25" /><verse number="26" style="v" sid="1CH 25:26" />ya kumi na tisa imghwila Maloti, hamwe na iwanaghe na ndughu tsake kumi na weli, <verse eid="1CH 25:26" /><verse number="27" style="v" sid="1CH 25:27" />ya ishilini imghwila Eliata, hamwe ne iwanaghe na ndughu tsake kumi na weli, <verse eid="1CH 25:27" /><verse number="28" style="v" sid="1CH 25:28" />ya ishilini na imwe imghwila Hothiri, hamwe na iwanaghe na ndughu tsake kumi na weli, <verse eid="1CH 25:28" /><verse number="29" style="v" sid="1CH 25:29" />ya ishilini na mbili imghwila Gidaliti; hamwe na iwanaghe na ndughu tsake kumi na weli, <verse eid="1CH 25:29" /><verse number="30" style="v" sid="1CH 25:30" />ya ishilini na tatu imghwila Mahazioti, hamwe na iwanaghe na ndughu tsake kumi na weli, <verse eid="1CH 25:30" /><verse number="31" style="v" sid="1CH 25:31" />ya ishilini na nne imghwila Romamti Ezeri, hamwe na iwanaghe na ndughu tsake kumi na weli.<verse eid="1CH 25:31" /></para>
  <chapter eid="1CH 25" />
  <chapter number="26" style="c" sid="1CH 26" />
  <para style="s">Iwakalitsi wa ing'anda ya Imulungu</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 26:1" />Awano hano wawo Walawi iwagholelighwe sang'ano ya ukukalitsa lilango. Kulawa lukolo lwa Kora, tsakukala Meshemia mwana wa Kore wa kaye ya Asafu. <verse eid="1CH 26:1" /><verse number="2" style="v" sid="1CH 26:2" />Yeye tsakana wana wamale saba; imwanaghe chaudele tsa Zakaria, wa kabili Yedieli, wa kadatu Sebadia, wa kane Yetinieli, <verse eid="1CH 26:2" /><verse number="3" style="v" sid="1CH 26:3" />wa tano Elamu na wa sita Yohanani na wa saba Elihoehoena. <verse eid="1CH 26:3" /><verse number="4" style="v" sid="1CH 26:4" />Kuya Obedi Edomu naye tsakana wana wamale wanane: imwanaghe chaudele tsa Shemaya, wa keli Yehosabadi, wa kadatu Yoa, wa kane Sakari, wa tano Natanaeli, <verse eid="1CH 26:4" /><verse number="5" style="v" sid="1CH 26:5" />wa sita Amieli, wa saba Isakari na wanane Peulethai. <verse eid="1CH 26:5" /><verse number="6" style="v" sid="1CH 26:6" />Shemaya, imwanaghe pfipfila na tsakana wana wamale, nawo tsawawa pfilongotsi mna tsikaye tsa aba wawo, kwaapfila wawo tsa wanu iwotogholeka. <verse eid="1CH 26:6" /><verse number="7" style="v" sid="1CH 26:7" />Shemaya, imwanaghe chaudele Obedi Edomu tsakana iwana sita: Otini, Rafaeli, Odedi, Elizabadi, ndughu tsawo Elihu na Semakia awano wawo tsawana uwetso mkulu. <verse eid="1CH 26:7" /><verse number="8" style="v" sid="1CH 26:8" />Awawo wose iwo wana wa Obedi Edom: wawo na iwana wawo na iwatsukulu wawo, wose tsa sitini na weli. Wose tsawana uwetso mkulu na tsawana bapfu lya ukusang'ana. <verse eid="1CH 26:8" /><verse number="9" style="v" sid="1CH 26:9" />Naye Meshelemia tsakana wana na ndughu tsake kumi na wanane wane uwetso mkulu wa ing'onde ayo. <verse eid="1CH 26:9" /><verse number="10" style="v" sid="1CH 26:10" />Hosa mwana yumwe wa Merari tsakana wana wane: Shimri iyasaghulighwe na aba wake yawe mkulu hata ka si mwana chaudele baye, <verse eid="1CH 26:10" /><verse number="11" style="v" sid="1CH 26:11" />wa kabili Hilikia, wa kadatu Tebalia na wa kane Sakaria. Iwana wose wa Hosa hamwe na ndughu tsake wose tsa kumi na wadatu. <verse eid="1CH 26:11" /><verse number="12" style="v" sid="1CH 26:12" />Iwanu wano iwakalitse ghamalango kubitila iwakulu wawo, pfipfila tsaweng'ighwa tsisang'ano mna ing'anda ya IMNDEWA ka apfila ndungu tsawo Walawi pfawatendile. <verse eid="1CH 26:12" /><verse number="13" style="v" sid="1CH 26:13" />Tsawasa tsisimbi tsilamle ikaya yachi ighenda kukalitsa lilango, na ng'awalolile baye ka ina wanu chidogho au wengi. <verse eid="1CH 26:13" /><verse number="14" style="v" sid="1CH 26:14" />Isimbi ya ukukalitsa lilango lya mashaliki imghwila Shelemia na ikaya yake. Kuya isimbi ya ukukalitsa lilango lya kasikazini imghwila Sakaria mwanaghe yana ihekima. <verse eid="1CH 26:14" /><verse number="15" style="v" sid="1CH 26:15" />Isimbi ya ukukalitsa lilango lya kusini imghwila Obedi Edomu, na isimbi ya ukukalitsa hanu ha ukwikila ipfijo iwaghwila iwanaghe. <verse eid="1CH 26:15" /><verse number="16" style="v" sid="1CH 26:16" />Na isimbi ya ukukalitsa lilango lya maghalibi na lilango lya Shaleketi lili hana inzila yadando iwaghwila Shupimu na Hosa. Nawo tsawakalitsa kwa ukwibokelela. <verse eid="1CH 26:16" /><verse number="17" style="v" sid="1CH 26:17" />Chila tsuwa tsahana Walawi sita iwakalitse lilango lya mashaliki, na Walawi wane iwakalitse lilango lya kasikazini, na wane iwakalitse lilango lya kusini, kuya Walawi weli weli iwakalitse hanu ha ukwikila ipfijo. <verse eid="1CH 26:17" /><verse number="18" style="v" sid="1CH 26:18" />Hana ichibwalu ichilolesa lilango lya maghalibi, tsahana wanu wane iwokalitsa inzila na weli iwokalitsa chibwalu chenyegho. <verse eid="1CH 26:18" /><verse number="19" style="v" sid="1CH 26:19" />Awano wawo iwanu wa ulukolo lwa Kola na lwa Merari iwakalitse ghamalango.<verse eid="1CH 26:19" /></para>
  <para style="s">Sang'ano tsingi mna Ing'anda ya Imulungu</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 26:20" />Walawi wayao, tsawekighwa wawe wakulu wa ihatsina ya Ing'anda ye Imulungu, na hatsina ya ipfinu ipfilapfighwe pfiwe pfa Imulungu. <verse eid="1CH 26:20" /><verse number="21" style="v" sid="1CH 26:21" />Yehieli tsa chilongotsi wa ikaya ya Ladani ili mna lukolo lwa Gerishoni. <verse eid="1CH 26:21" /><verse number="22" style="v" sid="1CH 26:22" />Iwanaghe Yehieli tsa Zetamu na Yoeli, awo tsawang'ali walolesagha ihatsina ya ing'anda ya IMNDEWA. <verse eid="1CH 26:22" /><verse number="23" style="v" sid="1CH 26:23" />Pfipfila sang'ano tsatsigholighwa kwe iwanu wa kolo tsa Wasiria, Waishari, Waeburoni na Wauzieli. <verse eid="1CH 26:23" /><verse number="24" style="v" sid="1CH 26:24" />Shebueli, mwana wa Gerishoni, mtsukulu wa Musa, tsa mkulu wa tsihatsina atso. <verse eid="1CH 26:24" /><verse number="25" style="v" sid="1CH 26:25" />Na ndughu yake tsakakala Eliezari iyakalile aba wa Rehabia, iyamweleke Yeshaya, Yoramu, Zikiri, na Shelomoti. <verse eid="1CH 26:25" /><verse number="26" style="v" sid="1CH 26:26" />Shelomoti na ndughu tsake, wawo wang'ali walolesa ihatsina ya ipfinu ipfikighwe pfiwe pfa Imulungu na mfalume Daudi, na pfilongotsi wa tsikaye, iwakalile pfilongotsi wa masikali elufu na masikali miya, na ipfikighwe na pfilongotsi wangi wa maasikali. <verse eid="1CH 26:26" /><verse number="27" style="v" sid="1CH 26:27" />Ipfinu pfimwenga pfawobokile kung'ondo tsawapfilapfa pfiwe pfa ukutsengela keli ing'anda ya IMNDEWA. <verse eid="1CH 26:27" /><verse number="28" style="v" sid="1CH 26:28" />Na chila chinu chayalapfile nabii Samweli, na Shauli mwana wa Kishi, na Abineri mwanaghe Neri na Yoabu mwana wa Seruya, pfose pfing'ali pfitunzighwa na Shelomiti na ndughu tsake.<verse eid="1CH 26:28" /></para>
  <para style="s">Sang'ano tsa wa Walawi wangi</para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 26:29" />Kulawa kuna lukolo lwa Waishari, Kenenia na iwanaghe tsaweng'ighwa sang'ano tsa ukutawala ka wakulu wa wanu na walamtsi wa Waisiraeli. <verse eid="1CH 26:29" /><verse number="30" style="v" sid="1CH 26:30" />Kulawa kuna lukolo lwa Waeburoni, Hashabia na ndughu tsake elufu imwe na miya saba, wanu wose wano tsawatogholeka na tsaweng'ighwa sang'ano ya ukwimila isi ya Waisiraeli ikalile maghalibi mwa ghumto Yoridani. Tsawemila sang'ano tsose tsa IMNDEWA na sang'ano tsa mfalume Daudi. <verse eid="1CH 26:30" /><verse number="31" style="v" sid="1CH 26:31" />Kulawa kuna lukolo lwa Waeburoni, Yeria tsa mkulu wa tsikolo na tsikaya tsawo, na mna ghumwaka ghwa alubaini ghwa ukutawala mfalume Daudi, iwanu wanza ukubama mna ulukolo lwao na woneka iwamale iwotogholeka mna ulukolo lwa Heburoni ako Yezeri mna isi ya Gileadi. <verse eid="1CH 26:31" /><verse number="32" style="v" sid="1CH 26:32" />Mfalume Daudi tsakamsaghula Yeriya na ndughu tsake elufu mbili na miya saba, iwotogholeka na pfilongotsi wa tsikolo, wemile ghose aghala ighali gha Imulungu na aghala ighali gha mfalume Daudi mna isi tsose tsa Warubeni, Wagadi na nusu ya kabila lya Manase, itsikalile mashaliki mwa ghumto Yoridani.<verse eid="1CH 26:32" /></para>
  <chapter eid="1CH 26" />
  <chapter number="27" style="c" sid="1CH 27" />
  <para style="s">Makingili gha maasikali</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 27:1" />Awano ahano wawo Waisiraeli iwamsang'anile mfalume, pfilongotsi wa tsikaya, pfilongotsi wa maasikali maelufu na maasikali mamia, na wakulu wawo wangi. Tsakuna wanu elufu ishilini na wane iwalongotsighwe na chilongotsi wawo iwasang'ane kwa mwetsi ghumwe mna chila mwaka. <verse eid="1CH 27:1" /><verse number="2" style="v" sid="1CH 27:2" />Yeshobeamu mwana wa Sabidieli tsa mkulu iyalongotse wanu elufu ishilini na wane iwanzile kusang'ana mna ghumwetsi ghwa mwanduso. <verse eid="1CH 27:2" /><verse number="3" style="v" sid="1CH 27:3" />Yeye tsakalawila mna lukolo lwa Peresi, na tsa mkulu wa pfilongotsi wose wa maasikali mna ghumwetsi ghwa mwanduso. <verse eid="1CH 27:3" /><verse number="4" style="v" sid="1CH 27:4" />Dodai, iyolawa mna lukolo lwa Ahoa, naye tsa mkulu wa wanu elufu ishilini na wane iwasang'ane mna ghumwetsi ghwa keli. <verse eid="1CH 27:4" /><verse number="5" style="v" sid="1CH 27:5" />Benaya, imwana wa mtambika Yehoyada tsa mkulu wa wanu elufu ishilini na wane iwasang'ane mna ghumwetsi ghwa kadatu. <verse eid="1CH 27:5" /><verse number="6" style="v" sid="1CH 27:6" />Ayuno yuyo ayula Benaya iyakalile asikali iyadahile ukwitowa ghoya kulawa mna maasikali awala selasini iwanoghile, na iyawile chilongotsi wawo. Naye Amisabadi imwanaghe tsa chilongotsi iyamwapfile. <verse eid="1CH 27:6" /><verse number="7" style="v" sid="1CH 27:7" />Asaeli, ndughu yake Yoabu, tsa mkulu wa kane iyalongotse wanu elufu ishilini na wane iwasang'ane mna ghumwetsi ghwa kane. Kuya na Sebadia, imwanaghe, tsakawa chilongotsi, kakinda hanu hake. <verse eid="1CH 27:7" /><verse number="8" style="v" sid="1CH 27:8" />Shamhuti, Mwisirahi tsa mkulu wa tano iyalongotse wanu elufu ishilini na wane iwasang'ane mna ghumwetsi ghwa tano. <verse eid="1CH 27:8" /><verse number="9" style="v" sid="1CH 27:9" />Imkulu wa sita iyalongotse wanu elufu ishilini na wane iwasang'ane mna ghumwetsi ghwa sita tsa Ira, mwana wa Ikeshi kulawa Tekoa. <verse eid="1CH 27:9" /><verse number="10" style="v" sid="1CH 27:10" />Helesi, mwana wa Efuraimu kulawa Peloni tsa mkulu wa saba iyalongotse wanu elufu ishilini na wane iwasang'ane mna ghumwetsi ghwa saba. <verse eid="1CH 27:10" /><verse number="11" style="v" sid="1CH 27:11" />Sibekai, wa lukolo lwa Zera iyolawila Hushahi tsa mkulu wa nane iyalongotse wanu elufu ishilini na wane iwasang'ane mna ghumwetsi ghwa nane. <verse eid="1CH 27:11" /><verse number="12" style="v" sid="1CH 27:12" />Abiezeri kulawa Anatoti wa likabila lya Benjamini tsa mkulu wa tisa iyalongotse wanu elufu ishilini na wane iwasang'ane mna ghumwetsi ghwa tisa. <verse eid="1CH 27:12" /><verse number="13" style="v" sid="1CH 27:13" />Maharai, wa lukolo lwa Zara iyolawila Netofati tsa mkulu wa kumi iyalongotse wanu elufu ishilini na wane iwasang'ane mna ghumwetsi ghwa kumi. <verse eid="1CH 27:13" /><verse number="14" style="v" sid="1CH 27:14" />Benaya, kulawa Piratoni wa likabila lya Efuraimu, tsa mkulu wa kumi na yumwe iyalongotse wanu elufu ishilini na wane iwasang'ane mna ghumwetsi ghwa kumi na ghumwe <verse eid="1CH 27:14" /><verse number="15" style="v" sid="1CH 27:15" />Helidai, wa lukolo lwa Otinieli, iyolawila Netofati tsa mkulu wa kumi na mbili iyalongotse wanu elufu ishilini na wane iwasang'ane mna ghumwetsi ghwa kumi na mili.<verse eid="1CH 27:15" /></para>
  <para style="s">Pfilongotsi wa ghamakabila gha Isiraeli</para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 27:16" />Awano ahano wawo pfilongotsi wa Waisiraeli: Eliesari mwana wa Sikiri tsa chilongotsi wa likabila lya Rubeni. Shefatia mwana wa Maaka tsa chilongotsi wa likabila lya Simeoni. <verse eid="1CH 27:16" /><verse number="17" style="v" sid="1CH 27:17" />Hashabia, mwana wa Kemueli kawalongotsa Walawi, Sadoki kalilongotsa likabila lya Aruni, <verse eid="1CH 27:17" /><verse number="18" style="v" sid="1CH 27:18" />Elihu, ndughu yake Daudi kalilongotsa likabila lya Yuda, Omri mwana wa Mikaeli kalilongotsa likabila lya isakari, <verse eid="1CH 27:18" /><verse number="19" style="v" sid="1CH 27:19" />Ishimaya mwana wa Obadia kalilongotsa likabila lya Zabuloni na Yeremoti mwana wa Azirieli kalilongotsa likabila lya Nafutali. <verse eid="1CH 27:19" /><verse number="20" style="v" sid="1CH 27:20" />Hosea imwana wa Asasia kalilongotsa likabila lya Efuraimu, na Yoeli mwana wa Pedaya kalongotsa inusu ya likabila lya Manase, <verse eid="1CH 27:20" /><verse number="21" style="v" sid="1CH 27:21" />nusu ingi ya likabila lya Manase walongotsa Gileadi, walongotsighwa na Ido mwana wa Sakaria, na Yaasieli mwana wa Abineri tsakalilongotsa likabila lya Benjamini. <verse eid="1CH 27:21" /><verse number="22" style="v" sid="1CH 27:22" />Likabila lya Dani tsalilongotsighwa na Azareli mwana wa Yeroboamu. Awano wawo pfilongotsi wa ghamakabila gha Isiraeli.<verse eid="1CH 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 27:23" />Mfalume Daudi ng'awapetile baye awala ing'awapfikile miyaka ishilini kwaapfila IMNDEWA tsakalonga kowongetsa Waisiraeli wawe wengi ka tsinondo tsili kulanga. <verse eid="1CH 27:23" /><verse number="24" style="v" sid="1CH 27:24" />Yoabu mwana wa Seruya tsakandusa kuwapeta iwanu lekeni ng'amalitsile baye, apfo imaya ya Imulungu iwatsila Waisiraeli kwaapfila Yoabu tsakawapeta, apfo Waisiraeli wose ng'awandikighwe baye mna ichitabu cha kumbukumbu cha mfalume.<verse eid="1CH 27:24" /></para>
  <para style="s">Iwanu iwemilile tsimali tsa mfalume</para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 27:25" />Iyemilile hatsina tsa mfalume Daudi tsa Azimaweti mwana wa Adieli. Naye Yonatani mwana wa Uzia tsakemila hatsina itsikalile kuna imighunda na kuna imiji na kuna pfijiji na kuna tsingome. <verse eid="1CH 27:25" /><verse number="26" style="v" sid="1CH 27:26" />Iyawemilile iwolima mighunda tsa Eziri mwana wa Kelubu. <verse eid="1CH 27:26" /><verse number="27" style="v" sid="1CH 27:27" />Shimei kulawa Ramati tsakemilila imighunda ya minzabibu ya mfalume, Zabidi iyolawila Shifimi tsakemila ing'onde yose ya ukukamula tsinzabibu tsiwe dipfai. <verse eid="1CH 27:27" /><verse number="28" style="v" sid="1CH 27:28" />Na iyemilile imighunda ya imikuyu na minzeituni ya mfalume iikalile mchiwala ili hasi ha pfidunda pfa maghalibi tsa Baali Hanani iyolawila Gederi, naye Yoashi tsakemila tsighala tsa ghamapfuta. <verse eid="1CH 27:28" /><verse number="29" style="v" sid="1CH 27:29" />Iyemilile iwang'ombe iwadimighwe ako Sharoni tsa Shitirai iyolawila Sharoni, na iyemile iwang'ombe iwadimighwe mlwanda tsa Shafati mwana wa Adilai. <verse eid="1CH 27:29" /><verse number="30" style="v" sid="1CH 27:30" />Na iyemilile ingamiya tsakakala Obili iyolawa mna lukolo lwa Ishimaeli, na iyemilile pfihongwe tsa Yedeya iyolawa kuna ghumji ghwa Meronoti. <verse eid="1CH 27:30" /><verse number="31" style="v" sid="1CH 27:31" />Iyemilile iwang'olo tsa Yazizi iyolawa mna ulukolo lwa Hagiri. Awo wose wawo iwanu iwemilile tsimali tsa mfalume Daudi.<verse eid="1CH 27:31" /></para>
  <para style="s">Waashauri wa mfalume Daudi</para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 27:32" />Naye Yonatani, mtumba wake Daudi tsa mshauli na munu yane tsimbutsi nyingi na iyang'ali yakwandika. Yeye na Yehieli, mwana wa Hakmoni wang'ali wowafunda iwana wa mfalume. <verse eid="1CH 27:32" /><verse number="33" style="v" sid="1CH 27:33" />Ahitofeli tsa mshauli wa mfalume, na Hushai Mwaliki tsa sale yake mfalume. <verse eid="1CH 27:33" /><verse number="34" style="v" sid="1CH 27:34" />Ahitofeli hayafile, Yehoyada mwana wa Benaya, hamwe na Abiatali wawa washauli wa mfalume. Yoabu yeye kawa chilongotsi wa maasikali wa mfalume.<verse eid="1CH 27:34" /></para>
  <chapter eid="1CH 27" />
  <chapter number="28" style="c" sid="1CH 28" />
  <para style="s">Malaghitso gha Daudi gha ukutsenga ing'anda ya Imulungu</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 28:1" />Kuya Daudi kawakema wakulu wose wa Waisiraeli wetingane Yerusalemu. Apfo iwakulu wose wa ghamakabila, na wakulu wose wa masikali iwamsang'anile mfalume, na wakulu wemilile maasikali elufu elufu, na awala iwakulu wemilile maasikali miya miya, na iwakulu wose iwemilile tsimali na iwanyama wa mfalume, na iwanaghe hamwe na iwakulu wose iwemilile ing'anda ya chifalume, na maasikali wose wana ingupfu na awala iwadahile ghoya ukwitowa tsawetingana ako Yerusalemu. <verse eid="1CH 28:1" /><verse number="2" style="v" sid="1CH 28:2" />Mfalume Daudi tsakenuka, kalonga, “Mnihulikitse mwemwe ndughu tsangu na iwanu wangu, nene tsanibama ghendo mmoyo mwangu ukulitsengela ing'anda lisanduku lya laghano lye IMNDEWA ili likaleghe mumo na ili twetwe tughendeghe tukamtambikile IMNDEWA, Imulungu wetu. Apfo tsanyika ghoya ipfinu pfa ukutsengela ing'anda ayo. <verse eid="1CH 28:2" /><verse number="3" style="v" sid="1CH 28:3" />Lekeni Imulungu tsakanongela, ‘Ghweghwe ng'utsolitsengela baye ing'anda litaghwa lyangu, kwaapfila ghweghwe kwa imunu wa ng'ondo, naghwe konung'a tsidamu tse wanu.’ <verse eid="1CH 28:3" /><verse number="4" style="v" sid="1CH 28:4" />Lekeni IMNDEWA, Imulungu wa Isiraeli tsakanisaghula nene kulawa mna ikaye yose ya aba wangu niwe mfalume wa Isiraeli wa ghamatsuwa ghose. Kalisaghula likabila lya Yuda lilongotse, na kulawa mna likabila lilyo lya Yuda, kaisaghula ikaye ya aba wangu, na kulawa mna iwana wa aba wangu, yeye kona pfinogha kunyika nene niwe mfalume wa Isiraeli yose. <verse eid="1CH 28:4" /><verse number="5" style="v" sid="1CH 28:5" />IMNDEWA tsakangaya ghendo iwana wengi, na kulawa mna iwana awo wose, yeye tsakamsaghula Selemani yakale mna ichighoda cha ufalume cha MNDEWA, yailongotse Isiraeli. <verse eid="1CH 28:5" /><verse number="6" style="v" sid="1CH 28:6" />Kanongela, ‘Selemani mwanagho yuyo iyatsonitsengela ing'anda na tsiluwa tsangu, kwaapfila tsanimsaghula yawe mwanangu na nene nitsakuwa aba wake. <verse eid="1CH 28:6" /><verse number="7" style="v" sid="1CH 28:7" />Nitsowika ufalume wake wime ghoya mna ghamatsuwa ghose, ka yang'aghendelela kughakinda ghamalaghitsa ghangu na imiko yangu ka pfayokinda leloli.’ <verse eid="1CH 28:7" /><verse number="8" style="v" sid="1CH 28:8" />Apfo nowalaghitsa hambele he Waisiraeli wose, na hambele ha mtingano wa IMNDEWA, aku naye Imulungu wetu kohulika, mwalangitse kughakinda malaghitso ghose gha IMNDEWA, Imulungu wenu ili isi aino inoghile iwe yenu, kuya muwalekele iwana wenu iwe yawo ghamatsuwa ghose. <verse eid="1CH 28:8" /><verse number="9" style="v" sid="1CH 28:9" />Naghwe Selemani mwanangu, ummanye Imulungu wa aba wako, umtumikile kwa ghumoyo ghwako ghose, na kwa mbutsi tsako tsose, kwaapfila IMNDEWA koilolesa mimoyo yose, na koghamanya ghayakwalangula na ghayobama kutenda imunu, ung'ambama kutsomwona, lekeni ung'amleka, yeye katsokulema matsuwa ghose. <verse eid="1CH 28:9" /><verse number="10" style="v" sid="1CH 28:10" />Lelo walangitse kwaapfila IMNDEWA kakusaghula ghweghwe uitsenge ing'anda yenzeluke, lelo ugangamale utende isang'ano ayo.”<verse eid="1CH 28:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 28:11" />Kuya Daudi kamwing'a Selemani imwanaghe lamani ya ichikuta cha ing'anda ya Imulungu na pfiheleto pfake, na hatsina tsake na gholofa tsake na pfiheleto pfake pfa mghati, na Hanu haenzeluke ng'ani. <verse eid="1CH 28:11" /><verse number="12" style="v" sid="1CH 28:12" />Tsakamwing'a aghala ghose ighekighwe na Ghumuhe mmoyo mwake apfila ing'anda pfaitsakuwa, kwa ipfikuta pfa ing'anda na pfiheleto pfose ipfitsunguluke, kwa hatsina tsa ing'anda ya Imulungu, na kwa hatsina tse ipfinu ipfikighwe pfiwe pfa IMNDEWA. <verse eid="1CH 28:12" /><verse number="13" style="v" sid="1CH 28:13" />Kuya mfalume kamlaghitsa Selemani mna ukuwagholela Watambika na Walawi tsing'onde, na sang'ano tsose tsili mna ing'anda ya IMNDEWA, na walolese ipfinu pfose ipfitumika mna tsisang'ano tse ing'anda ye Imulungu. <verse eid="1CH 28:13" /><verse number="14" style="v" sid="1CH 28:14" />Kuya Daudi kamwing'a inzahabu na fetsa ibamighwa kufinila ipfinu ipfitumika mna chila sang'ano ya ing'anda ya Imulungu, <verse eid="1CH 28:14" /><verse number="15" style="v" sid="1CH 28:15" />nzahahabu ibamighwa ya kufinila pfighutso pfa nzahabu, na pfitasa pfake na pfetsa ibamighwa kutengenetsela pfigutso na pfitasa pfake, kwa kulola chila chigutso pfachitumika, <verse eid="1CH 28:15" /><verse number="16" style="v" sid="1CH 28:16" />na nzahabu tsa ukutengenetsa imetsa ya pfighate ilapfighwe kwa Imulungu, na fetsa ya ukutengenetsela metsa tsa fetsa, <verse eid="1CH 28:16" /><verse number="17" style="v" sid="1CH 28:17" />na nzahabu inoghile itengenetsele tsiuma na ghamabakuli, na ipfikombe, na kalapfa nzahabu inoghile na fetsa itengenetsele ghamabakuli gha nzahabu na gha fetsa, <verse eid="1CH 28:17" /><verse number="18" style="v" sid="1CH 28:18" />pfipfila kalapfa inzahabu inoghile ibamighwa kutenengenetsela hanu ha ukupfukitsila ubani. Pfipfila kamwing'a lilumbo lya chighubiko cha nzahabu chine wasenga wa kulanga iwatandatse ghamabawa ghawo kughubika lisanduku lya laghano lya IMNDEWA. <verse eid="1CH 28:18" /><verse number="19" style="v" sid="1CH 28:19" />Aghano ghose ighali mna ilamani ino tsanighandika aku IMNDEWA Imulungu konyapfila, naye kanenda nimanye chila chinu ichibamighwa kutendeka mna ilamani ino. <verse eid="1CH 28:19" /><verse number="20" style="v" sid="1CH 28:20" />Kuya mfalume Daudi kamlongela Selemani imwanaghe, “Ugangamale, wikinde, uleke kupfuka wala kutenyuka, kwaapfila IMNDEWA Imulungu, iyali Imulungu wangu ka hamwe naghwe. Yeye ng'atsokuleka baye, lekeni katsokala hamwe naghwe mbaka hatsitsomala sang'ano tsose tsa ing'anda ya Imulungu. <verse eid="1CH 28:20" /><verse number="21" style="v" sid="1CH 28:21" />Watambika na Walawi wawo wagholelighwa tsing'onde tsa ukutenda mna ing'anda ya Imulungu. Chila munu iyakubuhu mna chila ng'onde katselapfa mwenyegho yakwapfile na wanu wose hamwe na pfilongotsi wawo watsotegheletsa chila laghitso lyauweng'a.”<verse eid="1CH 28:21" /></para>
  <chapter eid="1CH 28" />
  <chapter number="29" style="c" sid="1CH 29" />
  <para style="s">Ipfinu ipfilapfighwe pfa ukutsengela Ing'anda ya Imulungu.</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 29:1" />Kuya mfalume Daudi kawalongela iwanu wose; “Mwanangu Selemani, iyasaghulighwe na Imulungu, yang'ali kamdodo na ng'amanyile chinu baye. Ing'onde aino ng'ulu kwaapfia ing'anda iyatsoisenga si ya imunu baye, ila ya Imulungu. <verse eid="1CH 29:1" /><verse number="2" style="v" sid="1CH 29:2" />Kulawa mna ipfinu pfangu pfose, nene nilapfa ipfinu pfa ukutsengela ing'anda ya Imulungu, nilapfa nzahabu ya kutendela pfinu pfa nzahabu, na fetsa ya kutendela pfinu pfa fetsa, na shaba ya kutendela pfinu pfa shaba na chuma cha ukutendela pfinu pfa chuma na mibiki ya kutendela pfinu pfa mibiki. Kubita agho, nigheka ghamabwe mengi gha bei ng'ulu na ghamabwe gha kumemesela pfito pfa njumu, ghamabwe gha rangi, ghamabwe gha bei ng'ulu ya chila langi <verse eid="1CH 29:2" /><verse number="3" style="v" sid="1CH 29:3" />Kwa ukongetsa mna pfinu pfose pfanilapfile pfitsenge ing'anda ya Imulungu, nitsolapfa ihatsina yangu mwenyegho ya nzahabu na fetsa, ikatsengele ing'anda ya Imulungu wangu, kwaapfila nene nobama ghendo ing'anda ya Imulungu wangu itsengighwe. <verse eid="1CH 29:3" /><verse number="4" style="v" sid="1CH 29:4" />Nitsolapfa tani miya imwe na kumi na tano tsa nzahabu illawa Ofili, na tani miya mbili sitini na tano tsa fetsa inoghile tsa kukandika mna mibanda ya ing'anda, <verse eid="1CH 29:4" /><verse number="5" style="v" sid="1CH 29:5" />na tsa kutengenetsela ipfinu pfose pfa nzahabu na fetsa pfawatsotengenetsa iwanu. Angu nani lelo iyobama mwenyegho kumlapfila IMNDEWA Imulungu.”<verse eid="1CH 29:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 29:6" />Baho iwakulu wa tsikolo, pfilongotsi wa ghamakabila gha Isiraeli, pfilongotsi wa maasikali elufu na mamiya hamwe na iwanu iwemilile tsing'onde tsa mfalume tsawalapfa kwa ukubama wenyegho. <verse eid="1CH 29:6" /><verse number="7" style="v" sid="1CH 29:7" />Tsawalapfa pfinu pfino pfiwe pfa ukutsengela ing'anda ya Imulungu, walapfa tani miya imwe tisini tsa nzahabu, na tani miya tatu na semanini tsa fetsa, na tani miya sita sabini na tano tsa shaba, na tani elufu tatu miya saba hamsini tsa chuma. <verse eid="1CH 29:7" /><verse number="8" style="v" sid="1CH 29:8" />Awala wana ghamabwe gha bei ng'ulu tsawaghalapfa ghekighwe mna ihatsina ya ing'anda ya IMNDEWA, ing'ali ilolesighwa na Yehieli Mgerishoni. <verse eid="1CH 29:8" /><verse number="9" style="v" sid="1CH 29:9" />Baho iwanu tsawadeng'elela kwaapfila pfilongotsi wawo tsawalapfa kwa ukubama wenyegho, kwaapfila kwa ghumoyo ghwawo ghose tsawamlapfila IMNDEWA Imulungu, naye mfalume Daudi tsakadeng'elela ghendo.<verse eid="1CH 29:9" /></para>
  <para style="s">Daudi komtunya Imulungu</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 29:10" />Kuya Daudi kamtunya IMNDEWA Imulungu hambele ha mtingano ghwose, kalonga, “Utunyighwe ghamatsuwa ghose, Ghwe IMNDEWA, Imulungu wa aba wetu Yakobo. <verse eid="1CH 29:10" /><verse number="11" style="v" sid="1CH 29:11" />Ghwe IMNDEWA, kwa mkulu na kuna ngupfu, ghweghwe kwenzeluka, kohuma na kunogha. Pfinu pfose ipfili kulanga na muisi pfa kwako. Ghwe IMNDEWA, kwa mfalume, naghwe kwinulighwa, kwa mkulu wa pfinu pfose. <verse eid="1CH 29:11" /><verse number="12" style="v" sid="1CH 29:12" />Tsimali na ukotogholighwa pfose pfolawa kuna ghweghwe, pfose kopfilongotsa. Ukudaha na tsingupfu pfa mmwoko mwako, na ghamoko ghodaha kuwenula na kuweng'a tsingupfu iwanu wose. <verse eid="1CH 29:12" /><verse number="13" style="v" sid="1CH 29:13" />Lelo twolonga mighede, Ghwe Imulungu wetu, na twolitunya taghwa lyako kulu.<verse eid="1CH 29:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 29:14" />“Lekeni nene nani, na wanu wangu choni mbaka tudahe kukulapfila ipfinu kwa uluso uno? Kwaapfila ipfinu pfose pfolawa kuna ghweghwe, tukulapfila apfila ipfili pfako umwenyegho. <verse eid="1CH 29:14" /><verse number="15" style="v" sid="1CH 29:15" />Twetwe twa wahenza, na wabita nzila hambele hako, ka apfila pfawakalile wahenga wetu. Ghamatsuwa ghetu ahano muisi gheghala na sisila ilibita, ahano haduhu lolelo lya ukukala. <verse eid="1CH 29:15" /><verse number="16" style="v" sid="1CH 29:16" />Ghwe IMNDEWA Imulungu wetu, pfinu pfose pfino pfingi pfatulapfile pfiwe pfa kutsengela ing'anda, na kwa kulinula taghwa lyako lyienzeluka, napfo ghendo pfolawa mna ghamoko ghako na pfose pfa kwako. <verse eid="1CH 29:16" /><verse number="17" style="v" sid="1CH 29:17" />Nomanya Imulungu wangu ka ghweghwe koghetsa mimoyo ya iwanu, naghwe kowanoghela iwanu iwotogholighwa. Ipfinu apfino pfose nipfilapfa kwa kubama mwenyegho, na kwa ghumoyo ghumwe. Sambi nakwona iwanu wako iwali baha pfawolapfa kwa kudeng'elela na kwa kubama iwenyegho. <verse eid="1CH 29:17" /><verse number="18" style="v" sid="1CH 29:18" />Ghwe IMNDEWA Imulungu, Imulungu wa Abrahamu, Isaka na Yakobo iwabala wetu, wike usongo uno wa kulapfa mna mimoyo ya iwanu wako ukale matsuwa ghose, na uilongotse imimoyo ya iwanu wano ikulole ghweghwe. <verse eid="1CH 29:18" /><verse number="19" style="v" sid="1CH 29:19" />Umwing'e mwanangu Selemani usongo wa kukinda ghamalaghitso ghako, imiko yako na malamutsi ghako, na umwing'e usongo wa kuitsenga ing'anda ino inoghile yaniilapfile ipfinu.”<verse eid="1CH 29:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 29:20" />Kuya, mfalume Daudi kawalongela iwanu wose iwatingane, “Mtunyeni IMNDEWA, Imulungu wetu.” Na iwanu wose iwatingane hamwe wamtunya IMNDEWA, Imulungu wa aba tsawo, wenamitsa ghamatwi ghawo na wafunama hambele ha IMNDEWA na mfalume.<verse eid="1CH 29:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 29:21" />Tsuwa liwinzile wamlapfila IMNDEWA nambiko tsa ukulakatsighwa, ng'ombe wamale elufu imwe, ng'unzu elufu imwe na wana ng'olo elufu imwe na nambiko tsawo tsa pfinu pfa ukunwa na nambiko nyingi tsiwe tsa Waisiraeli wose. <verse eid="1CH 29:21" /><verse number="22" style="v" sid="1CH 29:22" />Tsawaja na wanwa kwa ukedeng'elela ng'ani mna litsuwa alyo hambele ha IMNDEWA Imulungu.</para>
  <para style="p" vid="1CH 29:22">Baho wamwika keli Selemani mwana wa Daudi yawe mfalume. Wambaka ghamapfuta yatawale hambele ha IMNDEWA, na Sadoki yawe mtambika. <verse eid="1CH 29:22" /><verse number="23" style="v" sid="1CH 29:23" />Kuya Selemani kakala hana ichighoda cha ufalume cha IMNDEWA, kakala hanu ha Daudi, aba wake. Naye kebweda mna chila chinu na Waisiraeli wose wamuhulikitsa. <verse eid="1CH 29:23" /><verse number="24" style="v" sid="1CH 29:24" />Wakulu wose na maasikali wose wane ngupfu hamwe na iwanaghe mfalume Daudi welaghana kumuhulikitsa mfalume Selemani. <verse eid="1CH 29:24" /><verse number="25" style="v" sid="1CH 29:25" />IMNDEWA tsakamwinula sideke Selemani hambele ha Waisiraeli wose, kamtenda yawe mfalume mkulu kubita ukulu wa mfalume wowose iyatawale Isiraeli ng'ana yeye yatawale.<verse eid="1CH 29:25" /></para>
  <para style="s">Ukumala kwa ufalume wa Daudi</para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 29:26" />Apfo Daudi, mwana wa Yese, tsakawa mfalume wa isi yose ya Isiraeli. <verse eid="1CH 29:26" /><verse number="27" style="v" sid="1CH 29:27" />Tsakalongotsa Isiraeli kwa miyaka alubaini, miyaka saba ako Heburoni na miyaka salasini na midatu ako Yerusalemu. <verse eid="1CH 29:27" /><verse number="28" style="v" sid="1CH 29:28" />Tsakafa aku kana miyaka mingi, na kakala ghamatsuwa mengi, aku kana mali nyingi na iwanu wose wang'ali womtegheletsa yeye. Kuya mwanaghe Selemani, kawa mfalume hanu hake. <verse eid="1CH 29:28" /><verse number="29" style="v" sid="1CH 29:29" />Ghose ghayatendile Daudi mna ufalume wake, kulawa hayanzile ufalume mbaka hayamalitse ghandikighwa mna ipfitabu pfa kumbukumbu pfa nabii Samweli, Nasani na nabii Gadi, <verse eid="1CH 29:29" /><verse number="30" style="v" sid="1CH 29:30" />hamwe na mbuli tsa utawala wake na ukulu wake na mbuli itsimpatile na Waisiraeli na chila ufalume muisi ya Isiraeli itsimtsunguluke.<verse eid="1CH 29:30" /></para>
  <chapter eid="1CH 29" />
</usx>