<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="SNG" style="id">- Lugulu Bible Version</book>
  <para style="toc3">Wila</para>
  <para style="toc2">Wila unoghile</para>
  <para style="toc1">Ichitabu cha wila unoghile</para>
  <para style="mt1">WILA</para>
  <para style="imt">ICHILONGOLE</para>
  <para style="ip">Wila unoghile cha ichitabu cha ghamashaili cha ukwinoghela kwa ipinga na mmale cha iwanu wa Isiraeli, nacho chandikighwa na wanu wengi, Mna Chiyeburaniya wila unoghile maana yake wila unoghile kubita wila tsose ka apfila ukulonga mfalume kubita wafalume wose. Ichitabu chakwanza ukumlongelela mfalume Selemani 1.1, lekeni ukumkema akuno ng'akulangusa baye ka Solomoni yuyo iyandike ichitabu, pfipfila yodahika ghendo ka ichitabu chandikighwa na munu yungi yamkumbuke Solomoni. Iwani wasomile ng'awamanyile baye ichitabu achino chandikighwe tsuwachi, lekeni chodaha kwandikighwa mna miyaka solomoni hayakalile mgima, miyaka ya (970-931) ng'ana Kiristu yoneke baye chandikighwe ghoya keli mna ghamatsuwa gha hambele.</para>
  <para style="ip">Wila unoghile wosimulila ukwikunda. Mna ichitabu chose cha Wila unoghile twakona ipinga na immale wolonga apfila pfawenoghela, pfipfila twakona sale tsawo nawo wolonga apfila pfawenoghela. Iwanu wasomile wotoghola ghendo ka ichinu chikulu ghendo chili mna ichitabu achino chakoneka mna isula ya 8, 5-7, aho twomwona ipinga kolonga ka ukwinoghela kuna ngupfu ka ngupfu ya ukufa, Ukwikunda kuna ngupfu ng'ani hatufikitsa mna ghumoyo na kuduhu munu iyodaha ukughoma, naye kotukanya mala ndatu iwanu waleke ukwanza ukwinoghela ng'ana matsuwa ghao ghapfike baye (2.7, 3.5, 8.4).</para>
  <para style="iot">Ighali mna ichitabu</para>
  <para style="io">Litaghwa lya ichitabu lyakwandikighwa 1.1</para>
  <para style="io">Lishaili lya kwanza lyolapfighwa 1.2 mbaka 2.7. 3.</para>
  <para style="io">Lishaili lya keli lyolapfighwa 2.8 mbaka 3.5. 4.</para>
  <para style="io">Lishaili lya kadatu lyolapfighwa 3.6 mbaka 5.1. 5</para>
  <para style="io">Lishauli lya kane lyolapfighwa 5.2 mbaka 6.3. 6.</para>
  <para style="io">Lishaili lya tano lyolapfighwa 6.4 mbaka 8.4. 7</para>
  <para style="io">Lishaili lya sita lyolapfighwa 8.5 mbaka 8.14.</para>
  <chapter number="1" style="c" sid="SNG 1" />
  <para style="p">
    <verse number="1" style="v" sid="SNG 1:1" />Wila wa Selemani unoghile kubita wila tsose.<verse eid="SNG 1:1" /></para>
  <para style="s">Wila wa Mwanduso</para>
  <para style="sp">Ipinga kolonga</para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 1:2" />Uninonele kwa milomo yako,</para>
  <para style="q" vid="SNG 1:2">kwaapfila pfaunikunda kudeng'elesa kubita idipfai.<verse eid="SNG 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 1:3" />ghamapfuta ghako gha ukubakala ghonung'ila ghoya,</para>
  <para style="q" vid="SNG 1:3">litaghwa lyako ka ghamapfuta ighonung'ila ghoya ighoghidighwa,</para>
  <para style="q" vid="SNG 1:3">apfo iwali pfawokukunda.<verse eid="SNG 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 1:4" />Nisolee tutsume wose,</para>
  <para style="q" vid="SNG 1:4">ghweghwe kwa imfalume wangu, ungale kuna ipfiheleto pfako,</para>
  <para style="q" vid="SNG 1:4">ako tutsodeng'elela na ukubweda,</para>
  <para style="q" vid="SNG 1:4">tutsotunya ukukunda kwako kubita idipfai.</para>
  <para style="q" vid="SNG 1:4">Apfo si chinu cha kukangawala baye wamapinga kukukunda.<verse eid="SNG 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 1:5" />Nene na mtitu lekeni ninogha, mwemwe mapinga Yerusalemu,</para>
  <para style="q" vid="SNG 1:5">na mtitu ka ghamahema gha Kedari,</para>
  <para style="q" vid="SNG 1:5">lekeni ninogha ka ghamapanzia gha Selemani.<verse eid="SNG 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 1:6" />Mleke kunitsodolela tsinenge apfila pfanili mtitu.</para>
  <para style="q" vid="SNG 1:6">utitu wangu litsuwa linilakatsa,</para>
  <para style="q" vid="SNG 1:6">lumbu tsangu tsawanighudubukila,</para>
  <para style="q" vid="SNG 1:6">wanyika nikalitse mighunda ya minzabibu,</para>
  <para style="q" vid="SNG 1:6">lekeni mghunda ghwangu ghwenyegho sighukalitse baye.<verse eid="SNG 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 1:7" />Lelo unongele ghweghwe yughunoghela ghumoyo ghwangu,</para>
  <para style="q" vid="SNG 1:7">wang'olo wako utsowadimila kwani?</para>
  <para style="q" vid="SNG 1:7">Nemisi wang'olo wako watsobwihila kwani?</para>
  <para style="q" vid="SNG 1:7">Hebali nene niwe ka ipinga iyeghubike uhanga kwa ishela,</para>
  <para style="q" vid="SNG 1:7">habehi na wang'olo wa wayagho?<verse eid="SNG 1:7" /></para>
  <para style="sp">Immale</para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 1:8" />Ghweghwe yunoghile kubita mapinga wose,</para>
  <para style="q" vid="SNG 1:8">ka ng'umnayile baye, tenda apfi,</para>
  <para style="q" vid="SNG 1:8">uwinze ghamatsayo gha wang'olo,</para>
  <para style="q" vid="SNG 1:8">ukawadime wamene wako wadowado habehi na ghamahema gha iwadimi.<verse eid="SNG 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 1:9" />Ghweghwe yuninoghela,</para>
  <para style="q" vid="SNG 1:9">kweghala na falasi pinga iyokangawatsa hayokwegha ghumtuka ghwa Farao.<verse eid="SNG 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 1:10" />Ghamakanza ghako ghanogha ghang'awa na ipfipuli.</para>
  <para style="q" vid="SNG 1:10">na isingo yako inogha kwa mikufu ya Johali yaupfalile.<verse eid="SNG 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 1:11" />Tutsokutengenetsela tsiheleni tsa nzahabu,</para>
  <para style="q" vid="SNG 1:11">ihambighwe hamwe na ifetsa.<verse eid="SNG 1:11" /></para>
  <para style="s">Ipinga iyokwelighwa</para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 1:12" />Mfalume hayakalile mna ichilagho chake,</para>
  <para style="q" vid="SNG 1:12">ghamapfuta ghangu ghang'ali ghonung'ila chila hanu.<verse eid="SNG 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 1:13" />Ghweghwe yuninoghela kweghala ghendo na chikoba cha manemane ighonung'ila,</para>
  <para style="q" vid="SNG 1:13">ighuwasa haghatighati ha ghamatombo ghangu.<verse eid="SNG 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="SNG 1:14" />Ghweghwe yuninoghela kweghala ghendo na ghamaluwa gha mbiki.</para>
  <para style="q" vid="SNG 1:14">ighasanule mna imighunda ya minzabibu akula Engedi.<verse eid="SNG 1:14" /></para>
  <para style="sp">Immale</para>
  <para style="q">
    <verse number="15" style="v" sid="SNG 1:15" />Lola apfila pfaunoghile, mnoghelwa wangu,</para>
  <para style="q" vid="SNG 1:15">ghweghwe kunogha, tsinenge tsako ka tsa njiwa.<verse eid="SNG 1:15" /></para>
  <para style="sp">Ipinga</para>
  <para style="q">
    <verse number="16" style="v" sid="SNG 1:16" />Ghweghwe kunogha, mnoghelwa wangu,</para>
  <para style="q" vid="SNG 1:16">nene nonoghelwa na ghweghwe,</para>
  <para style="q" vid="SNG 1:16">lusatsi lwetu lutsakuwa mitsani mibisi inoghile.<verse eid="SNG 1:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="SNG 1:17" />Tsingutso tsa ing'anda yetu tsitsakuwa tsa mbiki ghwa mkataluba,</para>
  <para style="q" vid="SNG 1:17">na ing'anda ayo itsohaghalighwa na mibiki ya mihangala.<verse eid="SNG 1:17" /></para>
  <chapter eid="SNG 1" />
  <chapter number="2" style="c" sid="SNG 2" />
  <para style="q">
    <verse number="1" style="v" sid="SNG 2:1" />Nene na luwa ililawa Sharoni,</para>
  <para style="q" vid="SNG 2:1">luwa lya yungi yungi ilikota mlwanda.<verse eid="SNG 2:1" /></para>
  <para style="sp">Immale</para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 2:2" />Ka luwa lya yungiyungi haghatighati ha imihonga,</para>
  <para style="q" vid="SNG 2:2">pfipfo pfayali mnoghelwa wangu hayokala hamwe na iwali.<verse eid="SNG 2:2" /></para>
  <para style="sp">Ipinga</para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 2:3" />Ka mbiki ghwa ghamatunda ighalimta haghati ghati ha imibiki ya kubagho,</para>
  <para style="q" vid="SNG 2:3">pfipfo pfayali mnoghelwa wangu hayokala hamwe na iwasongolo wayaghe,</para>
  <para style="q" vid="SNG 2:3">nideng'elela ukukala hasi ha ichimbeho chake,</para>
  <para style="q" vid="SNG 2:3">na nilanza litunda lyake lyamta ng'ani.<verse eid="SNG 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 2:4" />Kanighala kuna ichikuta ichina ichijo,</para>
  <para style="q" vid="SNG 2:4">kanyinulila ibendela ilangusa ka yeye konikunda.<verse eid="SNG 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 2:5" />Ngayeni pfighate pfa tnzabibu ndiye nighute,</para>
  <para style="q" vid="SNG 2:5">ngayeni litunda likemighwa tofaa ndiye nideng'elele,</para>
  <para style="q" vid="SNG 2:5">kwaapfila nene notsilika kwa kumkunda ayuno sideke.<verse eid="SNG 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 2:6" />litwi lyangu liwasila ghumoko ghwangu ghwa kumoso,</para>
  <para style="q" vid="SNG 2:6">na ghumoko ghwake ghwa kujilo ghunihabatila.<verse eid="SNG 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 2:7" />Nomdedetsani mwemwe wamapinga wa Yerusalemu.</para>
  <para style="q" vid="SNG 2:7">akuno iwanyama wa kubagho iwokemigha mbala na dondolo wohulikitsa,</para>
  <para style="q" vid="SNG 2:7">mleke ukwikunda na ukuwasa hamwe,</para>
  <para style="q" vid="SNG 2:7">mbete mbaka ichipindi chenu hachipfika.<verse eid="SNG 2:7" /></para>
  <para style="s">Wila wa keli</para>
  <para style="sp">Ipinga</para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 2:8" />Nohulika litsi lya mnoghelwa wangu, lola kakutsa yotsuma,</para>
  <para style="q" vid="SNG 2:8">kodaluka daluka ipfidunda, na kopfiloka loka ipfighongo.<verse eid="SNG 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 2:9" />Mnoghelwa wangu keghala na mbala,</para>
  <para style="q" vid="SNG 2:9">ka dondolo imwana,</para>
  <para style="q" vid="SNG 2:9">kema kuchughu kwa ubanda wetu,</para>
  <para style="q" vid="SNG 2:9">kolola hana lidilisha,</para>
  <para style="q" vid="SNG 2:9">kosungulila hana ichonzo yone mghati.<verse eid="SNG 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 2:10" />Mnoghelwa wangu kanongela,</para>
  <para style="q" vid="SNG 2:10">Winuke mnoghelwa wangu, ghweghwe yuninoghela, utse tuke.<verse eid="SNG 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 2:11" />Lola msimu ghwa chipfeghetsi ghubita,</para>
  <para style="q" vid="SNG 2:11">naghwo ghumsimu ghwai mvula ghumala.<verse eid="SNG 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 2:12" />Maluwa ghasanula chila hanu muisi,</para>
  <para style="q" vid="SNG 2:12">ghumsimu ghwa ukwimba ghupfika,</para>
  <para style="q" vid="SNG 2:12">iwanjiwa wohulikika wolila mna imighunda yetu.<verse eid="SNG 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 2:13" />Mibiki ya mitini yanza ukweleka ghamatunda ghake,</para>
  <para style="q" vid="SNG 2:13">na iminzabibu yanza kusanula, nayo yonung'ila ghoya,</para>
  <para style="q" vid="SNG 2:13">lelo winuke mnoghelwa wangu, tuke wose.<verse eid="SNG 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="SNG 2:14" />Ghweghwe kweghala na njiwa, yawipfisa mna ghamabambalawe ighakang'asuke,</para>
  <para style="q" vid="SNG 2:14">mmbalimbali mwa ipfidunda,</para>
  <para style="q" vid="SNG 2:14">unanguse chihanga chako, na nihulike litsi lyako,</para>
  <para style="q" vid="SNG 2:14">kwaapfila litsi lyako lyamta na ichihanga chako chinogha.<verse eid="SNG 2:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="SNG 2:15" />Utughoghele wambweha, wambweha awala iwadowado,</para>
  <para style="q" vid="SNG 2:15">awala iwohihinya imighunda yetu ya mitsabibu yetu.</para>
  <para style="q" vid="SNG 2:15">aila minzabibu yetu isanula.<verse eid="SNG 2:15" /></para>
  <para style="sp">Ipinga</para>
  <para style="q">
    <verse number="16" style="v" sid="SNG 2:16" />Mnoghelwa wangu wakwangu nene, na nene nawakwake yeye,</para>
  <para style="q" vid="SNG 2:16">yeye kodima iwang'olo wake hana luwa lya yungiyungi.<verse eid="SNG 2:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="SNG 2:17" />Mbaka hamitondo litsuwa halilawa,</para>
  <para style="q" vid="SNG 2:17">na ichisi hachimala,</para>
  <para style="q" vid="SNG 2:17">uye ghwe mnoghelwa wangu, uwe ka mbala,</para>
  <para style="q" vid="SNG 2:17">na ka dondolo imwana mchanya mwa ipfidunda Beteri.<verse eid="SNG 2:17" /></para>
  <chapter eid="SNG 2" />
  <chapter number="3" style="c" sid="SNG 3" />
  <para style="q">
    <verse number="1" style="v" sid="SNG 3:1" />Chilo chigima mna lusatsi lwangu,</para>
  <para style="q" vid="SNG 3:1">nimbama ayula iyoghunoghela ghumoyo ghwangu,</para>
  <para style="q" vid="SNG 3:1">nimbama immale ayo lekeni simwonile baye.<verse eid="SNG 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 3:2" />Apfo nitsoghenda nikange kange mna ghumji ghose,</para>
  <para style="q" vid="SNG 3:2">nibite mna tsinzila na mna ipfibwalu pfa ukwitinganila,</para>
  <para style="q" vid="SNG 3:2">nimbame ayula iyali mna ghumoyo ghwangu.</para>
  <para style="q" vid="SNG 3:2">Baho nimbama lekeni simwonile baye.<verse eid="SNG 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 3:3" />Iwakalitsi iwang'ali wobita bita kukalitsa ghumji wambona,</para>
  <para style="q" vid="SNG 3:3">na nene niwaghutsa, “Pfihi mmona ayula iyoghunoghela ghumoyo ghwangu?”<verse eid="SNG 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 3:4" />Baho haniwalekile, nimwona ayula iyoghunoghela ghumoyo ghwangu,</para>
  <para style="q" vid="SNG 3:4">nimkinda wala simlekile baye yoke,</para>
  <para style="q" vid="SNG 3:4">nimghala kuna ing'anda ya mame wangu,</para>
  <para style="q" vid="SNG 3:4">mbaka kuna ichumba cha ayula iyanyeleke.<verse eid="SNG 3:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="SNG 3:5" />Nomdedetsani mwemwe wamapinga wa Yerusalemu,</para>
  <para style="q" vid="SNG 3:5">akuno mbala na dondolo wohulikitsa,</para>
  <para style="q" vid="SNG 3:5">mleke ukwanza ukwikunda,</para>
  <para style="q" vid="SNG 3:5">mbete mbaka ichipindi chenu hachipfika.<verse eid="SNG 3:5" /></para>
  <para style="s">Wila wa kadatu</para>
  <para style="sp">Ipinga</para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 3:6" />Angu ayu nani iyakutsa kulawa kunyika,</para>
  <para style="q" vid="SNG 3:6">kakutsa ka yosi limile wima,</para>
  <para style="q" vid="SNG 3:6">iyonung'ila manemane na upfumba,</para>
  <para style="q" vid="SNG 3:6">ipfinu apfo ipfihutsighwa na wachulutsi?<verse eid="SNG 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 3:7" />Lola, Selemani kakutsa,</para>
  <para style="q" vid="SNG 3:7">kadutighwa mna ichighoda chake cha ufalume,</para>
  <para style="q" vid="SNG 3:7">aku maasikali sitini wamtsunguluka,</para>
  <para style="q" vid="SNG 3:7">Maaskali wa Isiraeli iwadahile ukwitowa pfinoghile.<verse eid="SNG 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 3:8" />Chila asikali kakinda limaghe lyake,</para>
  <para style="q" vid="SNG 3:8">wose wodaha ghendo kwitowa kung'ondo,</para>
  <para style="q" vid="SNG 3:8">chila munu kohomeka limaghe lyake mchuno,</para>
  <para style="q" vid="SNG 3:8">wakala ghoya ghendo kwa ukwitowa nechilo.<verse eid="SNG 3:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 3:9" />Mfalume Selemani ketengenetsela chighoda chake cha ufalume,</para>
  <para style="q" vid="SNG 3:9">ketengenetsela kwa tsimbao tsinoghile tsa imibiki ilawa Lebanoni.<verse eid="SNG 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 3:10" />Tsingutso tsake tsitendighwa kwa fetsa,</para>
  <para style="q" vid="SNG 3:10">ghumghongo ghwake ghuhambighwa na nzahabu,</para>
  <para style="q" vid="SNG 3:10">na hanu ha ukukala haghubikighwa na pfitambala pfa nzambalau.</para>
  <para style="q" vid="SNG 3:10">na mtuka ghwake ghudadatsighwa na njumu,</para>
  <para style="q" vid="SNG 3:10">mghati mwake mdadatsighwa pfinoghile na wapinga wa Yerusalemu.<verse eid="SNG 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 3:11" />Mlawe kunze mwemwe iwapinga wa Sayuni, mtse mumlole mfalume Selemani,</para>
  <para style="q" vid="SNG 3:11">kapfala litaji lyayapfatsighwe na mai wake,</para>
  <para style="q" vid="SNG 3:11">mna litsuwa lyayakwelile,</para>
  <para style="q" vid="SNG 3:11">litsuwa ghumoyo ghwake haghudeng'elela ng'ani.<verse eid="SNG 3:11" /></para>
  <chapter eid="SNG 3" />
  <chapter number="4" style="c" sid="SNG 4" />
  <para style="sp">Immale</para>
  <para style="q">
    <verse number="1" style="v" sid="SNG 4:1" />Lola pfaunoghile mnoghelwa wangu,</para>
  <para style="q" vid="SNG 4:1">ghweghwe kunogha ghendo,</para>
  <para style="q" vid="SNG 4:1">nenge tsako itsighubikighwe na lishela tsinogha ka njiwa,</para>
  <para style="q" vid="SNG 4:1">tsimvili tsako tsodimka ka mene iwohulumka mna ichidunda cha Gileadi.<verse eid="SNG 4:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 4:2" />Matsino ghako matselu ka ng'olo mapinga iwatselu iwaganighwe imighala sambi,</para>
  <para style="q" vid="SNG 4:2">iwoyile kulawa ukoghetsighwa,</para>
  <para style="q" vid="SNG 4:2">chila yumwe kakweleka wana weli weli,</para>
  <para style="q" vid="SNG 4:2">na kuduhu hata yumwe ing'akwelaka mwana.<verse eid="SNG 4:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 4:3" />Milomo yako yeghala na utsi mdung'u,</para>
  <para style="q" vid="SNG 4:3">ghumlomo ghwako ghunogha,</para>
  <para style="q" vid="SNG 4:3">ghamakanza ghako ighaghubikighwe na lishela gheghala na tunda ilikemighwa komamanga libatsuke.<verse eid="SNG 4:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 4:4" />Isingo yako inoghile yeghala na ghumnala ghwa Daudi,</para>
  <para style="q" vid="SNG 4:4">ighutsengighwe pfinoghile ghuwe hanu ha ukwikila tsisilaha,</para>
  <para style="q" vid="SNG 4:4">mchanya mwake watundika tsingao elufu, tsose tsa maasikali iwadahile ukwitowa.<verse eid="SNG 4:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 4:5" />Matombo ghako meli ghanogha ka iwana weli wa imbala iwoneke hamwe,</para>
  <para style="q" vid="SNG 4:5">iwakuja imitsani haghatighati ha ghamaluwa gha yungiyungi.<verse eid="SNG 4:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 4:6" />Nitsoghenda kuna ichidunda cha manemane,</para>
  <para style="q" vid="SNG 4:6">na kuna ichighongo cha upfumba,</para>
  <para style="q" vid="SNG 4:6">mbaka kunze kwenzeluke</para>
  <para style="q" vid="SNG 4:6">na ichisi chuke<verse eid="SNG 4:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 4:7" />Ghweghwe mnoghelwa wangu kunogha ghendo,</para>
  <para style="q" vid="SNG 4:7">ghweghwe kwahela chochose ichihunguke.<verse eid="SNG 4:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="SNG 4:8" />Ghwe mwali wangu yanikukwela utse kulawa Lebanoni,</para>
  <para style="q" vid="SNG 4:8">utse tuwe wose kulawa Lebanoni,</para>
  <para style="q" vid="SNG 4:8">uhulumke kulawa chidanando cha ichidunda cha Amana,</para>
  <para style="q" vid="SNG 4:8">uhulumke utse kulawa chidanando cha ichidunda cha Seniri na cha Herimoni,</para>
  <para style="q" vid="SNG 4:8">utse kulawa kuna tsimango tsa simba,</para>
  <para style="q" vid="SNG 4:8">na kulawa kuna ipfudunda pfawokala waduma.<verse eid="SNG 4:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 4:9" />Kughukangawatsa ghendo ghumoyo ghwangu,</para>
  <para style="q" vid="SNG 4:9">ghweghwe mwali wangu, pinga wangu yanikukwela,</para>
  <para style="q" vid="SNG 4:9">kughukangawatsa ghendo ghumoyo ghwangu,</para>
  <para style="q" vid="SNG 4:9">ahala haundolile mala lumwe kwa tsinenge tsako,</para>
  <para style="q" vid="SNG 4:9">na kwa ghumkufu ghumwe ghwaupfalile msingo.<verse eid="SNG 4:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 4:10" />Lola ukukunda kwako pfauli mta,</para>
  <para style="q" vid="SNG 4:10">mwali wangu, pinga wangu,</para>
  <para style="q" vid="SNG 4:10">lola unoghelo wako pfauli mta kubita dipfai,</para>
  <para style="q" vid="SNG 4:10">ghamapfuta ghaubakale ghonung'ila ghoya kubita ghamapfuta ghose ighonung'ila.<verse eid="SNG 4:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 4:11" />Milomo yako yochilika uki, ghwe mwali wangu,</para>
  <para style="q" vid="SNG 4:11">lulimi lwako luna uki na matsiwa,</para>
  <para style="q" vid="SNG 4:11">tsinguwo tsaupfalile tsonung'ila ghoya ka mikataluba ya Lebanoni.<verse eid="SNG 4:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="SNG 4:12" />Pinga wangu, mwali wangu</para>
  <para style="q" vid="SNG 4:12">ghweghwe kweghala na likonde ilipfisike,</para>
  <para style="q" vid="SNG 4:12">kweghala na mbwibwi idiwighwe.<verse eid="SNG 4:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 4:13" />Ghweghwe kweghala na pfipughuti pfa mibiki ya mikomamanga,</para>
  <para style="q" vid="SNG 4:13">haikula yakweleka ghamatunda ighalimta,</para>
  <para style="q" vid="SNG 4:13">na kweghala na mibiki ikweleka hina na nado,<verse eid="SNG 4:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="SNG 4:14" />nado na zafarani, mchai na mdalasini,</para>
  <para style="q" vid="SNG 4:14">hamwe na chila mbiki ghwa upfumba na udi,</para>
  <para style="q" vid="SNG 4:14">na mibiki ingi inung'ila ghoya,<verse eid="SNG 4:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="SNG 4:15" />Ghweghwe kwa mbwibwi ya likonde.</para>
  <para style="q" vid="SNG 4:15">kwa chisima cha ghamatsi ghali na ugima,</para>
  <para style="q" vid="SNG 4:15">ighohulumka kulawa Lebanoni.<verse eid="SNG 4:15" /></para>
  <para style="sp">Ipinga</para>
  <para style="q">
    <verse number="16" style="v" sid="SNG 4:16" />Udume ghwe libeho lya kasikazini,</para>
  <para style="q" vid="SNG 4:16">utse ghwe libeho lya kusini,</para>
  <para style="q" vid="SNG 4:16">mdume mna likonde lyangu,</para>
  <para style="q" vid="SNG 4:16">ghamanukato ghanung'ile ghoya chila hanu,</para>
  <para style="q" vid="SNG 4:16">mlekeni mnoghelwa wangu yatse kwikonde,</para>
  <para style="q" vid="SNG 4:16">yaje ghamatunda ghake ighanoghile.<verse eid="SNG 4:16" /></para>
  <chapter eid="SNG 4" />
  <chapter number="5" style="c" sid="SNG 5" />
  <para style="sp">Immale,</para>
  <para style="q">
    <verse number="1" style="v" sid="SNG 5:1" />Nene ningila mna ibostani yangu,</para>
  <para style="q" vid="SNG 5:1">pinga wangu na mwali wangu,</para>
  <para style="q" vid="SNG 5:1">nokunga hamwe ghamanukato gha manemane na ipfihungo ipfinung'ila ghoya,</para>
  <para style="q" vid="SNG 5:1">ndiya uki wangu uli msegha,</para>
  <para style="q" vid="SNG 5:1">nuwa idipfai yangu na ghamatombo ghangu.</para>
  <para style="sp" vid="SNG 5:1">Ipinga</para>
  <para style="q" vid="SNG 5:1">Mje na mnwe mwemwe sale tsangu,</para>
  <para style="q" vid="SNG 5:1">Mnwe ghendo mwemwe wanoghelwa wangu.<verse eid="SNG 5:1" /></para>
  <para style="s">Wila wa kane,</para>
  <para style="sp">Ipinga</para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 5:2" />Tsaniwasa, lekeni ghumoyo ghwangu ng'aghuwasile baye,</para>
  <para style="q" vid="SNG 5:2">kwaapfila ayula mnoghelwa wangu kogong'onda ghumlango.</para>
  <para style="sp" vid="SNG 5:2">Immale</para>
  <para style="q" vid="SNG 5:2">Nipfughulile ghwe pinga wangu, mnoghelwa wangu,</para>
  <para style="q" vid="SNG 5:2">njiwa wangu, ing'ahungukighwe na chochose baye,</para>
  <para style="q" vid="SNG 5:2">litwi lyangu linyoda litungwe,</para>
  <para style="q" vid="SNG 5:2">mvili tsangu tsipfulumka na ghamawagha gha nechilo.<verse eid="SNG 5:2" /></para>
  <para style="sp">Ipinga</para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 5:3" />Nene ma nitsula ligwanda lyangu,</para>
  <para style="q" vid="SNG 5:3">pfihi nipfale keli?</para>
  <para style="q" vid="SNG 5:3">Nene nighahopfugha ghamaghulu ghangu,</para>
  <para style="q" vid="SNG 5:3">pfihi nifinale keli?<verse eid="SNG 5:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 5:4" />Baho mnoghelwa wangu kengitsa ghumoko ghwake hana ichonzo,</para>
  <para style="q" vid="SNG 5:4">na ghumoyo ghwangu ghumdeng'elela.<verse eid="SNG 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 5:5" />Nyinuka nimpfughulile mnoghelwa wangu,</para>
  <para style="q" vid="SNG 5:5">ghamoko ghangu tsaghamema mapfuta ighonung'ila gha manemane,</para>
  <para style="q" vid="SNG 5:5">hanikindile ghumlango nipfughule,</para>
  <para style="q" vid="SNG 5:5">ipfidole pfangu pfing'ali pfilaghatsa manemane.<verse eid="SNG 5:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 5:6" />Nimpfughulila ghumlango mnoghelwa wangu,</para>
  <para style="q" vid="SNG 5:6">lekeni kumbe tsakahunduka koka,</para>
  <para style="q" vid="SNG 5:6">ghumoyo ghwangu tsaghutenyuka hanitangile koka,</para>
  <para style="q" vid="SNG 5:6">nimbama lekeni simwonile baye,</para>
  <para style="q" vid="SNG 5:6">nimkema lekeni ng'anyidike baye.<verse eid="SNG 5:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 5:7" />Iwakalitsi iwang'ali wotsunguluka ghumji wambona,</para>
  <para style="q" vid="SNG 5:7">wanitowa na wandagha,</para>
  <para style="q" vid="SNG 5:7">na iwakalitsi wa ubanda waniboka ishela yangu.<verse eid="SNG 5:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 5:8" />Lelo nowadedetsa mwemwe wapinga wa Yerusalemu,</para>
  <para style="q" vid="SNG 5:8">mng'amwona mnoghelwa wangu,</para>
  <para style="q" vid="SNG 5:8">mlongeleni koninoghela mbaka nene notsilika.<verse eid="SNG 5:8" /></para>
  <para style="sp">Wapinga wa Yerusalemu</para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 5:9" />Ghwe ipinga yunoghile kubita mapinga wose,</para>
  <para style="q" vid="SNG 5:9">angu ayo mnoghelwa wako yanoghiletsa kuwabita wamale wose?</para>
  <para style="q" vid="SNG 5:9">Angu yanoghiletse mbaka ghweghwe utudedetse apfo ghendo?<verse eid="SNG 5:9" /></para>
  <para style="sp">Ipinga</para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 5:10" />Mnoghelwa wangu komelemeta na kana ngupfu,</para>
  <para style="q" vid="SNG 5:10">kanogha kubita iwamale elufu kumi.<verse eid="SNG 5:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 5:11" />Litwi lyake ka nzahabau inoghile kubita tsose,</para>
  <para style="q" vid="SNG 5:11">tsimvili tsake tsipfoghoseka,</para>
  <para style="q" vid="SNG 5:11">na nitu ka bondwa.<verse eid="SNG 5:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 5:12" />Tsinenge tsake ka njiwa iwakalile mmbambali mwa ichikolongo,</para>
  <para style="q" vid="SNG 5:12">iwoghile ghamatsiwa mmbali mbali mwa ipfikolongo.<verse eid="SNG 5:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 5:13" />Ghamakanza ghake gheghala na likonde linoghile,</para>
  <para style="q" vid="SNG 5:13">ilimemile upfumba unung'ila ghoya,</para>
  <para style="q" vid="SNG 5:13">milomo yake ka maluwa gha yungiyungi,</para>
  <para style="q" vid="SNG 5:13">idononda ghamadone gha manemane.<verse eid="SNG 5:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="SNG 5:14" />Ghamoko ghake ka ng'weku tsa nzahabu,</para>
  <para style="q" vid="SNG 5:14">ikighwe unzolingo kwa ghamabwe ighanoghile gha zabarajadi,</para>
  <para style="q" vid="SNG 5:14">ilukuli lwake ka membe ya nembo,</para>
  <para style="q" vid="SNG 5:14">ikighwe unzolingo wa ghamabwe ighanoghile gha yakuti.<verse eid="SNG 5:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="SNG 5:15" />Imighulu yake ka ngutso tsa malumalu,</para>
  <para style="q" vid="SNG 5:15">itsihimikighwe mna imisingi ya nzahabu,</para>
  <para style="q" vid="SNG 5:15">kema ka chidunda cha Lebanoni,</para>
  <para style="q" vid="SNG 5:15">china imibiki ya mikataluba.<verse eid="SNG 5:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="SNG 5:16" />Ghumlomo ghwake ghumema malonga ghalimta,</para>
  <para style="q" vid="SNG 5:16">apfo yeye kanogha ghendo.</para>
  <para style="q" vid="SNG 5:16">Ayu yuyo mnoghelwa wangu, ayu yuyo sale yangu,</para>
  <para style="q" vid="SNG 5:16">mwemwe mapinga wa Yerusalemu.<verse eid="SNG 5:16" /></para>
  <chapter eid="SNG 5" />
  <chapter number="6" style="c" sid="SNG 6" />
  <para style="sp">Iwapinga woghutsa</para>
  <para style="q">
    <verse number="1" style="v" sid="SNG 6:1" />Ghwe yunoghile kubita wamapinga wose,</para>
  <para style="q" vid="SNG 6:1">yaghendile kwani ayo mnoghelwa wako?</para>
  <para style="q" vid="SNG 6:1">Yahundukile kwani mnoghelwa wako</para>
  <para style="q" vid="SNG 6:1">ili tukwapfile ukumbama?<verse eid="SNG 6:1" /></para>
  <para style="sp">Ipinga kakwidika</para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 6:2" />Moghelwa wangu kaghenda kwikonde kwake,</para>
  <para style="q" vid="SNG 6:2">hanu haimela imibiki ya upfumba,</para>
  <para style="q" vid="SNG 6:2">yeye kodima wang'olo wake kuna likonde,</para>
  <para style="q" vid="SNG 6:2">na kokunga hamwe ghamaluwa gha yungi yungi.<verse eid="SNG 6:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 6:3" />Nene nawakwake mnoghelwa wangu na yeye wakwangu nene,</para>
  <para style="q" vid="SNG 6:3">yeye kowadima wang'olo wake hana ghamaluwa gha yunginyungi.<verse eid="SNG 6:3" /></para>
  <para style="s1">Wila wa tano</para>
  <para style="sp">Immale kakwidika</para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 6:4" />Mnoghelwa wangu, ghweghwe kunogha ka ghumji ghwa Tiliza,</para>
  <para style="q" vid="SNG 6:4">kunogha ka ghumji ghwa Yerusalemu,</para>
  <para style="q" vid="SNG 6:4">kokangawatsa ka maasikali iwenule tsibendela tsawo.<verse eid="SNG 6:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 6:5" />Uhunduke, tsinenge tsako tsilole kumbalimbali,</para>
  <para style="q" vid="SNG 6:5">kwaapfila tsing'andola noyayamka,</para>
  <para style="q" vid="SNG 6:5">tsimvili tsako tseghala na wamene,</para>
  <para style="q" vid="SNG 6:5">iwamene iwohulumka kulawa chidunda Gilaedi.<verse eid="SNG 6:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 6:6" />Matsino ghako matselu ka ng'olo mapinga iwatselu iwaganighwe imighala sambi,</para>
  <para style="q" vid="SNG 6:6">iwoyile kulawa kogha,</para>
  <para style="q" vid="SNG 6:6">chila yumwe kakweleka wana weli weli,</para>
  <para style="q" vid="SNG 6:6">na kuduhu hata yumwe ing'akwelaka mwana.<verse eid="SNG 6:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 6:7" />Ghamakanza ghako ighaghubikighwe na lishela gheghala na likomamanga limwe ilibatsuke.<verse eid="SNG 6:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 6:8" />Hodaha kuwa na malikiya sitini, na mapinga wakunze semanini,</para>
  <para style="q" vid="SNG 6:8">na wali ing'awopeteka baye,<verse eid="SNG 6:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 6:9" />lekeni injiwa wangu iyanoghile yang'ahungukighwe na chochose, yeye kayeka ghendo,</para>
  <para style="q" vid="SNG 6:9">yeye ka mwana nyalimwe kwa mai wake,</para>
  <para style="q" vid="SNG 6:9">na iyomnoghela mai wake iyamweleke,</para>
  <para style="q" vid="SNG 6:9">mapinga wose womwona na womkema kabweda,</para>
  <para style="q" vid="SNG 6:9">Malikiya na mapinga wangi wose wamtunya.<verse eid="SNG 6:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="SNG 6:10" />Angu ayu nani iyakoneka ka ghumwanga ghwa nemitondotondo,</para>
  <para style="q" vid="SNG 6:10">iyomeletseka ka lwetsi na iyong'aika ka tsuwa?<verse eid="SNG 6:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 6:11" />Nihulumka kuna ibostani ya mibiki ya milotsi,</para>
  <para style="q" vid="SNG 6:11">mbone pfibiki ipfitsuka mna ibostani,</para>
  <para style="q" vid="SNG 6:11">mbone ka mitsabibu itula mna ibostani,</para>
  <para style="q" vid="SNG 6:11">mbone ka imikomamanga isanula maluwa.<verse eid="SNG 6:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 6:12" />Ng'ana nitange baye ichilawila,</para>
  <para style="q" vid="SNG 6:12">nibona nimwenyegho ka apfla nakwendesa mtuka ghwa chifalume ighukweghighwa na falasi.<verse eid="SNG 6:12" /></para>
  <para style="sp">Wapinga wa Yerusalemu</para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 6:13" />Uye, uye ghweghwe pinga kulawa Shulamu,</para>
  <para style="q" vid="SNG 6:13">uye tukulole pfaubigha.</para>
  <para style="sp" vid="SNG 6:13">Immale</para>
  <para style="q" vid="SNG 6:13">Hebali mbama kutsodola tsinenge mmwone ipinga ayuno kulawa Shulamu,</para>
  <para style="q" vid="SNG 6:13">ka apfila mwololesa ngoma ya Mahanaimu?<verse eid="SNG 6:13" /></para>
  <chapter eid="SNG 6" />
  <chapter number="7" style="c" sid="SNG 7" />
  <para style="sp">Immale</para>
  <para style="q">
    <verse number="1" style="v" sid="SNG 7:1" />Ghwe neghe mfalume,</para>
  <para style="q" vid="SNG 7:1">lola ghamaghulu ghako ighapfalile mikwabatsa pfaghanoghile,</para>
  <para style="q" vid="SNG 7:1">imighulu yako yeghala ghendo na ghamabwe ghanoghile gha johari,</para>
  <para style="q" vid="SNG 7:1">ing'onde ya ghamoko gha munu iyadahile ghoya.<verse eid="SNG 7:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 7:2" />Chikupfu chako ka ibakuli yampfilingo,</para>
  <para style="q" vid="SNG 7:2">nayo ng'aikala baye bila dipfai ihanganyike,</para>
  <para style="q" vid="SNG 7:2">chuno chako ka lundo la mitsani ya ngano,</para>
  <para style="q" vid="SNG 7:2">chitsungulukighwe na maluwa gha yungiyungi.<verse eid="SNG 7:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 7:3" />Ghamatombo ghako pfaghali ka iwana weli wa mbala iwoneke hamwe,</para>
  <para style="q" vid="SNG 7:3">ka wana weli wa dondolo iwoneke hamwe.<verse eid="SNG 7:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 7:4" />Isingo yako pfaili ka mnala ighutengenetsighwe na tsimembe tsa nembo,</para>
  <para style="q" vid="SNG 7:4">tsinenge tsako ka matsimbu gha Heshiboni,</para>
  <para style="q" vid="SNG 7:4">ighali habehi na lilango lya Beti Rabi,</para>
  <para style="q" vid="SNG 7:4">imula yako ka mnala ghwa Lebanoni,</para>
  <para style="q" vid="SNG 7:4">ighwilolesa na Damasko.<verse eid="SNG 7:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 7:5" />Litwi lyako lima wima ka chidunda Karimeli,</para>
  <para style="q" vid="SNG 7:5">mvili tsako tsili mwitwi tsinoghesa,</para>
  <para style="q" vid="SNG 7:5">natso tsodaha ghendo ukumwonza mfalume.<verse eid="SNG 7:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="SNG 7:6" />Lola apfila pfaunoghile na pfaudeghete,</para>
  <para style="q" vid="SNG 7:6">ghwe mnoghelwa wangu!<verse eid="SNG 7:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 7:7" />Lumbo lyako ka mbiki ghwa mtende,</para>
  <para style="q" vid="SNG 7:7">matombo ghako ka pfikungwi pfa tende.<verse eid="SNG 7:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 7:8" />Nitsoghudina ghumtende aghwo,</para>
  <para style="q" vid="SNG 7:8">na nitsobawa ipfikungwi pfake,</para>
  <para style="q" vid="SNG 7:8">ghamatombo ghako ghawe ka pfikungwi pfa nzabibu,</para>
  <para style="q" vid="SNG 7:8">na ghumuhe ghwako ghwonung'ila ka matunda.<verse eid="SNG 7:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 7:9" />Mlomo ghwako ghweghala na dipfai ilimta.</para>
  <para style="sp" vid="SNG 7:9">Ipinga</para>
  <para style="q" vid="SNG 7:9">Ileke idipfai ihulumke mbaka kuna mnoghelwa wangu,</para>
  <para style="q" vid="SNG 7:9">ibite mchanya mwa ghumlomo ghwake na mna ghamatsino ghake.<verse eid="SNG 7:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 7:10" />Nene na wakwake mnoghelwa wangu, naye konibama ng'ani.<verse eid="SNG 7:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 7:11" />Utse mnoghelwa wangu, tuke kumghunda,</para>
  <para style="q" vid="SNG 7:11">tuke tukawase ako kuna ipfijiji.<verse eid="SNG 7:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 7:12" />Tuke sambi, tughende kuna imighunda ya minzabibu,</para>
  <para style="q" vid="SNG 7:12">tukalole ka iminzabibu itsuka,</para>
  <para style="q" vid="SNG 7:12">na maluwa ghake ka ghasanula,</para>
  <para style="q" vid="SNG 7:12">pfipfila ka imikomanga nayo yanza ukulapfa ghamaluwa,</para>
  <para style="q" vid="SNG 7:12">kuko nitsokulangusa pfanikukunda.<verse eid="SNG 7:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="SNG 7:13" />Iminunguluwala yonung'ila ghoya,</para>
  <para style="q" vid="SNG 7:13">hana imilango yetu hana ghamatunda ighanoghile,</para>
  <para style="q" vid="SNG 7:13">gha sambisambi na ghaghumwande,</para>
  <para style="q" vid="SNG 7:13">agho ghose nikwikila ghweghwe mnoghelwa wangu.<verse eid="SNG 7:13" /></para>
  <para style="b" />
  <chapter eid="SNG 7" />
  <chapter number="8" style="c" sid="SNG 8" />
  <para style="q">
    <verse number="1" style="v" sid="SNG 8:1" />Ka ung'awile ndughu yangu,</para>
  <para style="q" vid="SNG 8:1">iyong'ile ghamatombo gha mai wangu,</para>
  <para style="q" vid="SNG 8:1">ka ning'akonile ako kunze, ning'akunonole,</para>
  <para style="q" vid="SNG 8:1">na kung'awile kuduhu munu wa ukunibetsa nene.<verse eid="SNG 8:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="SNG 8:2" />Twing'elongotse na kupfika kuna ing'anda ya mai wangu,</para>
  <para style="q" vid="SNG 8:2">yeye iyanifundile,</para>
  <para style="q" vid="SNG 8:2">ning'akwing'ile dipfai ikolele ipfiungo,</para>
  <para style="q" vid="SNG 8:2">ning'akwing'ile isanga ya makomamanga ghangu.<verse eid="SNG 8:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="SNG 8:3" />Ghumoko ghwake ghwa kumoso ghwa hasi ha litwi lyangu,</para>
  <para style="q" vid="SNG 8:3">na ghumoko ghwake ghwa kujilo ghunihabatila.<verse eid="SNG 8:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="SNG 8:4" />Nomdedetsani mwemwe wamapinga wa Yerusalemu,</para>
  <para style="q" vid="SNG 8:4">mleke ukwikunda na ukuwasa hamwe,</para>
  <para style="q" vid="SNG 8:4">mbete mbaka ichipindi chenu hachipfika.<verse eid="SNG 8:4" /></para>
  <para style="s">Wila wa sita</para>
  <para style="sp">Sale tsake</para>
  <para style="q">
    <verse number="5" style="v" sid="SNG 8:5" />Angu nani ayuno iyakutsa kulawa kunyika,</para>
  <para style="q" vid="SNG 8:5">iyamwaghamile mnoghelwa wake.</para>
  <para style="sp" vid="SNG 8:5">Ipinga</para>
  <para style="q" vid="SNG 8:5">Nene nikulamsa hasi ha mbiki ghwa ghamatunda ghalimta,</para>
  <para style="q" vid="SNG 8:5">hanu mai wako hayakindile inda,</para>
  <para style="q" vid="SNG 8:5">na baho hayonile usungu hayakweleke ghweghwe.<verse eid="SNG 8:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="SNG 8:6" />Unyike mna ghumoyo ghwako ka muhuli,</para>
  <para style="q" vid="SNG 8:6">ka muhuli mna ghumoko ghwako,</para>
  <para style="q" vid="SNG 8:6">ukwikunda kuna ngupfu ka apfila pfaili ingupfu ya ukufa,</para>
  <para style="q" vid="SNG 8:6">wipfu wake mkali ka apfila pfakuli kutsimu,</para>
  <para style="q" vid="SNG 8:6">kwolakatsa ka ghumoto pfaghulakatsa,</para>
  <para style="q" vid="SNG 8:6">na kwolakatsa ka milambi ya ghumoto.<verse eid="SNG 8:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="SNG 8:7" />Ghamatsi mengi ng'aghodaha baye ukutsima ukwikunda,</para>
  <para style="q" vid="SNG 8:7">wala ghamatsi gha mvula ighokululusa ng'aghodaha baye kughadidimitsa,</para>
  <para style="q" vid="SNG 8:7">imunu iyolapfa tsimali tsake yaghule ukukunda,</para>
  <para style="q" vid="SNG 8:7">ayo katsobetsighwa ghendo.<verse eid="SNG 8:7" /></para>
  <para style="sp">Ndughu tsake ipinga wolonga</para>
  <para style="q">
    <verse number="8" style="v" sid="SNG 8:8" />Twetwe tunaye mdodo wetu pinga,</para>
  <para style="q" vid="SNG 8:8">matombo ghake ng'ana ghakule baye,</para>
  <para style="q" vid="SNG 8:8">lelo tumtendele choni mdodo wetu,</para>
  <para style="q" vid="SNG 8:8">hayolapfighwa tsengele?<verse eid="SNG 8:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="SNG 8:9" />Ka yeye ka ubanda,</para>
  <para style="q" vid="SNG 8:9">tutsotsenga minala ya fetsa mchanya mwake,</para>
  <para style="q" vid="SNG 8:9">na ka yeye kamlango,</para>
  <para style="q" vid="SNG 8:9">tung'aghutengenetse kwa mibiki ya mikataluba.<verse eid="SNG 8:9" /></para>
  <para style="sp">Ipinga kolonga</para>
  <para style="q">
    <verse number="10" style="v" sid="SNG 8:10" />Nene na ubanda,</para>
  <para style="q" vid="SNG 8:10">na matombo ghangu ka minala,</para>
  <para style="q" vid="SNG 8:10">pfipfo pfanili hambele hake,</para>
  <para style="q" vid="SNG 8:10">nomtenda yadeng'elele.<verse eid="SNG 8:10" /></para>
  <para style="sp">Immale</para>
  <para style="q">
    <verse number="11" style="v" sid="SNG 8:11" />Selemani tsakana mghunda ghwa minzabibu,</para>
  <para style="q" vid="SNG 8:11">hanu ihokemighwa Baali Hamoni,</para>
  <para style="q" vid="SNG 8:11">kawapangila iwakalitsi,</para>
  <para style="q" vid="SNG 8:11">chila munu tsakalapfa pfihande elufu pfa fetsa.<verse eid="SNG 8:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="SNG 8:12" />Mghunda ghwa minzabibu ghwa kwangu nene mwenyegho,</para>
  <para style="q" vid="SNG 8:12">apfo pfihande elufu imwe pfa fetsa pfakwako ghweghwe Selemani,</para>
  <para style="q" vid="SNG 8:12">na pfihande miya mbili pfa awala iwokalitsa ghamatunda.<verse eid="SNG 8:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="SNG 8:13" />Ghweghwe yukala kuna ibostani hamwe na sale tsako,</para>
  <para style="q" vid="SNG 8:13">leka nene nihulike litsi lyako.<verse eid="SNG 8:13" /></para>
  <para style="sp">Ipinga</para>
  <para style="q">
    <verse number="14" style="v" sid="SNG 8:14" />Tsuma, mnoghelwa wangu,</para>
  <para style="q" vid="SNG 8:14">tsuma hima ka mbala pfayotsuma kuna ipfidunda ipfinung'ila ipfiungo.<verse eid="SNG 8:14" /></para>
  <chapter eid="SNG 8" />
</usx>