<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JOL" style="id">- Lugulu Bible Version</book>
  <para style="toc3">Yoe</para>
  <para style="toc2">Yoeli</para>
  <para style="toc1">Ichitabu cha Yoeli</para>
  <para style="mt2">Ichitabu cha</para>
  <para style="mt1">JOELI</para>
  <para style="imt">Ichilongole</para>
  <chapter number="1" style="c" sid="JOL 1" />
  <para style="p">
    <verse number="1" style="v" sid="JOL 1:1" />Imtwatsa Imulungu kamlongela Joeli imwana wa Patueli imbuli ino.<verse eid="JOL 1:1" /></para>
  <para style="s">Iwanu wolilila imimeya</para>
  <para style="p">
    <verse number="2" style="v" sid="JOL 1:2" />Tegheletseni ichinu chino tsina sekulu,</para>
  <para style="q" vid="JOL 1:2">muwambe ghamaghutwi iwanu wose wa Yuda!</para>
  <para style="q" vid="JOL 1:2">Apfi ichinu ka achino ma chilawila kulawa hamwoneke</para>
  <para style="q" vid="JOL 1:2">au mne ghamatsuwa ghawakalile tsina sekulu wenu?<verse eid="JOL 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOL 1:3" />Muwasimulile iwanenu imbuli ino</para>
  <para style="q" vid="JOL 1:3">nawo wawasimlile iwana wawo</para>
  <para style="q" vid="JOL 1:3">ne iwana wawo wawalongele iwana iwatsoweleka.<verse eid="JOL 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOL 1:4" />Wanzighe mapfunge kwa mapfunge waipfingilila imimeya,</para>
  <para style="q" vid="JOL 1:4">ichilekighwe na nzige chijighwa ne balangulu,</para>
  <para style="q" vid="JOL 1:4">ichilekighwe ne balangulu chijighwa ne chidanukila,</para>
  <para style="q" vid="JOL 1:4">ichilekighwe ne chidanukila chijighwa ne mbulumundu.<verse eid="JOL 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOL 1:5" />Mwemwe yampatike imbwali, mlamke mlile,</para>
  <para style="q" vid="JOL 1:5">mdomboketse mwemwe yampatika imbwali ya nzabibu!</para>
  <para style="q" vid="JOL 1:5">Kwaapfila nzabibu tsose tso kutenda imbwali ingi tsihinyika.<verse eid="JOL 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOL 1:6" />Maasikali wengi ka lipfunge lye wanzighe lipfingilila isi yetu,</para>
  <para style="q" vid="JOL 1:6">lina ingupfu na kulu ng'ani,</para>
  <para style="q" vid="JOL 1:6">ghamatsino ghake ka ghe simba mmale,</para>
  <para style="q" vid="JOL 1:6">na maghegho ghake ka ghe simba ipinga.<verse eid="JOL 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOL 1:7" />Lihinya mitsabibu yetu,</para>
  <para style="q" vid="JOL 1:7">no kughegheda imibiki yetu ye mitini.</para>
  <para style="q" vid="JOL 1:7">Libandula ghamaghome ghake nokwasa hasi,</para>
  <para style="q" vid="JOL 1:7">na ghamaputila ghake ghalekighwa ghahela chinu.<verse eid="JOL 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOL 1:8" />Mwemwe iwanu, mlile ka imwali yapfalile lighwanda lye ghunila,</para>
  <para style="q" vid="JOL 1:8">pfomlilila immale wake iyafile iyabamile kumkwela.<verse eid="JOL 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOL 1:9" />Kuduhu nambiko tse ipfijo wala nambiko tsa chokunwa tso kulapfa mng'anda mwe Imtwatsa.</para>
  <para style="q" vid="JOL 1:9">Watambika iwomsang'anila Imulungu wonyanyana.<verse eid="JOL 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOL 1:10" />Imighunda tsaikala mahame ghendo,</para>
  <para style="q" vid="JOL 1:10">lidongo likangaluka, apfo ingano tsainyika,</para>
  <para style="q" vid="JOL 1:10">kuduhu tsabibu tso kukama chokunwa,</para>
  <para style="q" vid="JOL 1:10">kuduhu ghamafuta ghe mitseituni.<verse eid="JOL 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOL 1:11" />Mwemwe yamlimagha mlile</para>
  <para style="q" vid="JOL 1:11">mdomboketse mwemwe yamlolesa imitsabibu,</para>
  <para style="q" vid="JOL 1:11">ingano ne shayiri tsihinyika,</para>
  <para style="q" vid="JOL 1:11">ipfijo pfose pfatwihuwile kupfuna pfihinyika.<verse eid="JOL 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOL 1:12" />Imitsabibu inyala,</para>
  <para style="q" vid="JOL 1:12">imibiki yose ye ghamatunda inyala mne imighunda.</para>
  <para style="q" vid="JOL 1:12">Iwanu ng'awodeng'elela keli bae.<verse eid="JOL 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOL 1:13" />Mwemwe watambika, pfaleni ghamaghunila mlile,</para>
  <para style="q" vid="JOL 1:13">mlile mwemwe yamsang'ana hanu ho kutambikila.</para>
  <para style="q" vid="JOL 1:13">Mwingile mne ing'anda ye Imulungu mlile chilo chighima</para>
  <para style="q" vid="JOL 1:13">kwaapfila kuduhu ipfijo wala chokunwa pfo ukulapfa pfikawe nambiko mne ing'anda ye Imulungu wenu.<verse eid="JOL 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOL 1:14" />Muwalaghitse iwanu waleke ukuja.</para>
  <para style="q" vid="JOL 1:14">Muwakeme tsina sekulu ne iwanu wose we isi ya Yuda,</para>
  <para style="q" vid="JOL 1:14">wetingane kune ing'anda ye Imulungu wenu,</para>
  <para style="q" vid="JOL 1:14">na hamwo mkamlilile Imulungu.<verse eid="JOL 1:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOL 1:15" />Tutsoghaya mne litsuwa lila Imulungu lyayatsohigha,</para>
  <para style="q" vid="JOL 1:15">litsuwa alyo lya habehi,</para>
  <para style="q" vid="JOL 1:15">lyakutsa hamwe ne kukomighwa,</para>
  <para style="q" vid="JOL 1:15">kulawa kwe Imulungu iyane ngupfu.<verse eid="JOL 1:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOL 1:16" />Ipfijo pfetu pfihinyika aku twololesa.</para>
  <para style="q" vid="JOL 1:16">Kuduhu imunu iyoseka wala iyodeng'elela kune ing'anda ye Imulungu wetu.<verse eid="JOL 1:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOL 1:17" />Tsimbeghu tsakola mne lidongo,</para>
  <para style="q" vid="JOL 1:17">tsikano tsahela chinu, natso tsihinyika ghendo</para>
  <para style="q" vid="JOL 1:17">kwaapfila mduhu chokwika.<verse eid="JOL 1:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOL 1:18" />Lola iwanyama pfawolila kwa libatsi.</para>
  <para style="q" vid="JOL 1:18">Lukoyogho lwe wang'ombe lohangaika,</para>
  <para style="q" vid="JOL 1:18">kwaapfila wahela ichijo,</para>
  <para style="q" vid="JOL 1:18">nalwo lukoyogho lwe wang'olo lwoghaya.<verse eid="JOL 1:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOL 1:19" />Nokulilila, ghwee Imtwatsa Imulungu,</para>
  <para style="q" vid="JOL 1:19">ghumoto ghumalitsa ghumghina,</para>
  <para style="q" vid="JOL 1:19">imilambi ya ghumoto ilakatsa imibiki yose mne imighunda.<verse eid="JOL 1:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOL 1:20" />Hata iwanyama wa kwibagho wokulilila ghweghwe,</para>
  <para style="q" vid="JOL 1:20">kwaapfila ipfikolongo pfe ghamatsi pfinyala,</para>
  <para style="q" vid="JOL 1:20">na ghumoto ghulakatsa ghumghina ghose.<verse eid="JOL 1:20" /></para>
  <chapter eid="JOL 1" />
  <chapter number="2" style="c" sid="JOL 2" />
  <para style="s">Iwanzighe wopfingilila</para>
  <para style="p">
    <verse number="1" style="v" sid="JOL 2:1" />Mtowe malati hako Siyoni,</para>
  <para style="q" vid="JOL 2:1">mtowe imembe mne chidunda chenzeluke,</para>
  <para style="q" vid="JOL 2:1">mdedeme mwemwe yamkala mne isi ya Yuda,</para>
  <para style="q" vid="JOL 2:1">kwaapfila litsuwa lya kuhigha lye Imulungu lya habei ukupfika.<verse eid="JOL 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOL 2:2" />Litsuwa alyo litsakuwa na ichisi na chililo,</para>
  <para style="q" vid="JOL 2:2">litsakuwa litsuwa lighubikighwe ne liwingu ne ichisi totolo.</para>
  <para style="q" vid="JOL 2:2">Maasikali ka lipfunge likulu lye iwanzighe wa habehi ukutsa</para>
  <para style="q" vid="JOL 2:2">ka ichisi ichitanda mne ipfidunda.</para>
  <para style="q" vid="JOL 2:2">Chinu acho ng'ana chilawile bae</para>
  <para style="q" vid="JOL 2:2">wala ng'achitsolawila keli bae mne lweleko lwose lukutsa.<verse eid="JOL 2:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="JOL 2:3" />Ka ghumoto pfaghulakatsa,</para>
  <para style="q" vid="JOL 2:3">wohinya chila chinu ichili hambele hawo,</para>
  <para style="q" vid="JOL 2:3">no kuleka chila chinu kuchughu cholakala,</para>
  <para style="q" vid="JOL 2:3">hala ng'ana wapfose bae isi tsainogha ka ibostani ya Edeni,</para>
  <para style="q" vid="JOL 2:3">lekeni wang'apfosa isi yakuwa mahame.</para>
  <para style="q" vid="JOL 2:3">Kuduhu ichinu chochose ichidaha kulihepa.<verse eid="JOL 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JOL 2:4" />Wakoneka ka falasi, wotsuma na</para>
  <para style="q" vid="JOL 2:4">wopfingilila ka falasi we ng'ondo.<verse eid="JOL 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JOL 2:5" />Hawoghulukaghuluka mne pfidanando pfe pfidunda,</para>
  <para style="q" vid="JOL 2:5">woduma ka mituka ikweghighwa ne falasi,</para>
  <para style="q" vid="JOL 2:5">wolambila ka imvulu isakale pfailambila mne ghumoto,</para>
  <para style="q" vid="JOL 2:5">wakwoneka ka kingili lye iwanu ilighenda kune ing'ondo.<verse eid="JOL 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JOL 2:6" />Wang'apfika habehi, iwanu wopfuka ghendo,</para>
  <para style="q" vid="JOL 2:6">ipfihanga pfawo pfoyauka.<verse eid="JOL 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JOL 2:7" />Wopfingilila ka iwamaasikali iwadahile kwitowa,</para>
  <para style="q" vid="JOL 2:7">kuya wokwila mwibanda.</para>
  <para style="q" vid="JOL 2:7">Wose wolumbilila woghenda hambele bila kulola kuchugho,</para>
  <para style="q" vid="JOL 2:7">kuduhu hata yumwe iyohunduka na kwang'a nzila ingi.<verse eid="JOL 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JOL 2:8" />Kuduhu yomkunughitsa miyaghe,</para>
  <para style="q" vid="JOL 2:8">chila yumwe kang'a hanu hake.</para>
  <para style="q" vid="JOL 2:8">Wopfosa hata hanu hane maasikali wane tsisilaha,</para>
  <para style="q" vid="JOL 2:8">wala kuduhu ichidaha kuwaghoma.<verse eid="JOL 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JOL 2:9" />Wopfingilila mne mibanda ye ghumji,</para>
  <para style="q" vid="JOL 2:9">wotsipalamila tsing'anda no kwingila,</para>
  <para style="q" vid="JOL 2:9">webenyetsa wengile mne ghamadilisha ka wahitsi.<verse eid="JOL 2:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="JOL 2:10" />Woitenda isi yose ighudeme hambele yawo,</para>
  <para style="q" vid="JOL 2:10">mlanga namwo mwohighitsika.</para>
  <para style="q" vid="JOL 2:10">Lutsuwa na lwetsi pfoghelighwa ichisi,</para>
  <para style="q" vid="JOL 2:10">natso tsinondo tsoleka ukung'aika.<verse eid="JOL 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOL 2:11" />Imtwatsa Imulungu kalikemelela lipfunge lyake lye maasikali,</para>
  <para style="q" vid="JOL 2:11">wa wengi ng'ani na wana ngupfu sideke,</para>
  <para style="q" vid="JOL 2:11">yawomuhulikitsa ng'awopeteka bae.</para>
  <para style="q" vid="JOL 2:11">Litsuwa lye Imulungu kulu ng'ani na lyoghuma wogha,</para>
  <para style="q" vid="JOL 2:11">yuhi yatsodaha ukududumila?<verse eid="JOL 2:11" /></para>
  <para style="s">Ukukemighwa</para>
  <para style="q">
    <verse number="12" style="v" sid="JOL 2:12" />Nene Imtwatsa Imulungu nolonga apfino, “Lekeni hata sambi,</para>
  <para style="q" vid="JOL 2:12">mmbwihile kwa ghumoyo ghose,</para>
  <para style="q" vid="JOL 2:12">kwo ukufunga, kwa ukulila na kwa ukudomboketsa.<verse eid="JOL 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOL 2:13" />Mleke ukudegha ghamabwende ghenu kulangusa ka mwona usungu,</para>
  <para style="q" vid="JOL 2:13">ila mwone usungu mna imimoyo yenu.”</para>
  <para style="b" vid="JOL 2:13" />
  <para style="q" vid="JOL 2:13">Mmwihile IMNDEWA wenu.</para>
  <para style="q" vid="JOL 2:13">Yeye kamluso na kana libatsi,</para>
  <para style="q" vid="JOL 2:13">ng'asumkagha bae kwona maya, yeye ng'epfagha bae kutunoghela,</para>
  <para style="q" vid="JOL 2:13">matsuwa ghose yeye koleka kutuhigha.<verse eid="JOL 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOL 2:14" />Songaa Imtwatsa Imulungu wenu katsotelehula,</para>
  <para style="q" vid="JOL 2:14">naye komwing'ani ipfijo pfingi,</para>
  <para style="q" vid="JOL 2:14">namwe mtsomlapfila yeye nambiko ye ipfijo na chokunwa.<verse eid="JOL 2:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="JOL 2:15" />Mkatowe malati mna chidunda Siyoni!</para>
  <para style="q" vid="JOL 2:15">Muwalaghitse iwanu waleke ukuja,</para>
  <para style="q" vid="JOL 2:15">muwalongele iwanu wetingane hamwe.<verse eid="JOL 2:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOL 2:16" />Wakemeni iwanu wose,</para>
  <para style="q" vid="JOL 2:16">muwahopfughe iwanu wele.</para>
  <para style="q" vid="JOL 2:16">Waghaleni tsinasekulu, na</para>
  <para style="q" vid="JOL 2:16">muwakeme iwana,</para>
  <para style="q" vid="JOL 2:16">na hata iwana iwoghwawa wose.</para>
  <para style="q" vid="JOL 2:16">Wakemeni na awala iwekwelile sambi,</para>
  <para style="q" vid="JOL 2:16">walawe mna pfumba pfawo.<verse eid="JOL 2:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOL 2:17" />Walongele Iwatambika, awala iwosang'ana hanu ha kutambikila,</para>
  <para style="q" vid="JOL 2:17">na hane libani lye ing'anda ye Imulungu,</para>
  <para style="q" vid="JOL 2:17">walile na walombe,</para>
  <para style="q" vid="JOL 2:17">“Ghwee Imulungu wonele libatsi iwanu wako.</para>
  <para style="q" vid="JOL 2:17">Uleke kuwaleka iwanu wangi</para>
  <para style="q" vid="JOL 2:17">watubetse no kulonga,</para>
  <para style="q" vid="JOL 2:17">‘Alikwani lelo Imulungu wawo?’”<verse eid="JOL 2:17" /></para>
  <para style="s">IMNDEWA Imulungu kowonela libatsi iwanu wake</para>
  <para style="p">
    <verse number="18" style="v" sid="JOL 2:18" />Lelo Imulungu kainoghela isi yake,</para>
  <para style="q" vid="JOL 2:18">na kawonela libatsi iwanu wake.<verse eid="JOL 2:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOL 2:19" />Imtwatsa Imulungu kawedika, kaweng'a ghawalombile, kalonga,</para>
  <para style="q" vid="JOL 2:19">“Lelo nitsomwing'eni keli ipfijo, chokunwa na ghamafuta ghe mitseituni.</para>
  <para style="q" vid="JOL 2:19">Sitsowatenda baye mbetsighwe keli ne iwanu we isi tsingi.<verse eid="JOL 2:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOL 2:20" />Nitsolilapfa lipfunge lye iwanzighe ililawa kasikazini,</para>
  <para style="q" vid="JOL 2:20">nitsowatenda watsume mbaka kunyika,</para>
  <para style="q" vid="JOL 2:20">awala iwalongole nitsowasa mne ibahali ya Shamu</para>
  <para style="q" vid="JOL 2:20">na awala iwali kuchugho nitsowasa mne Ibahali ya Mediteraniya.</para>
  <para style="q" vid="JOL 2:20">Kuko watsakufa, watsopfunda no kunung'a.<verse eid="JOL 2:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="JOL 2:21" />Ghwee isi uleke ukupfuka,</para>
  <para style="q" vid="JOL 2:21">ila deng'elela na utowe lukenze</para>
  <para style="q" vid="JOL 2:21">mana Imulungu katenda makulu.<verse eid="JOL 2:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="JOL 2:22" />Mleke ukupfuka mwee iwanyama,</para>
  <para style="q" vid="JOL 2:22">ghumghina ghudegheta,</para>
  <para style="q" vid="JOL 2:22">imibiki yolapfa ghamatunda ghake,</para>
  <para style="q" vid="JOL 2:22">imitsabibu ne mitini yakweleka sideke.<verse eid="JOL 2:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="JOL 2:23" />Deng'eleleni mwemwe iwanu wa Siyoni,</para>
  <para style="q" vid="JOL 2:23">mumtowele lukenze Imulungu, kwaapfila yeye kowaghalila imvula ya chila msimu,</para>
  <para style="q" vid="JOL 2:23">imvula ye ghamasika ne imvula ya mlao ka pfayang'ali yotendagha.<verse eid="JOL 2:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="JOL 2:24" />Hanu ho kubetela hatsomema keli ipfilundo pfe pfijo,</para>
  <para style="q" vid="JOL 2:24">na hanu ha kukamila hatsomema ghamafuta na dipfai.<verse eid="JOL 2:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="JOL 2:25" />Nitsowohitsila ipfinu pfose ipfijighwe ne iwanzighe kwa miyaka yose,</para>
  <para style="q" vid="JOL 2:25">chila chinu ichijighwe ne pfidanukila ne balangulu,</para>
  <para style="q" vid="JOL 2:25">nene iyaniwaghalile lipfunge alyo kulu.<verse eid="JOL 2:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="JOL 2:26" />Namwe mtsopata ipfijo pfingi, mtsakuja mbaka mwoleka,</para>
  <para style="q" vid="JOL 2:26">na mtsolitunya taghwa lye Imulungu wenu,</para>
  <para style="q" vid="JOL 2:26">yeye yawatendeleni pfinu pfa kukangawatsa.</para>
  <para style="q" vid="JOL 2:26">Iwanu wangu ng'awotsobetsighwa keli bae.<verse eid="JOL 2:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="JOL 2:27" />Kuya mwemwe Waisiraeli mtsomanya ka nene na hamwe na mwemwe,</para>
  <para style="q" vid="JOL 2:27">nene Imulungu iyo Imulungu wenu na kuduhu yungi.</para>
  <para style="q" vid="JOL 2:27">Iwanu wangu ng'awotsombetseni keli bae.<verse eid="JOL 2:27" /></para>
  <para style="s">Litsuwa lya IMNDEWA</para>
  <para style="p">
    <verse number="28" style="v" sid="JOL 2:28" />“Nitsowaghalila ghumuwe ghwangu mna iwanu wose.</para>
  <para style="q" vid="JOL 2:28">Iwana wenu iwamale ne iwapinga watsolonga mbuli tsangu,</para>
  <para style="q" vid="JOL 2:28">tsina sekulu wenu watsolota tsindoto,</para>
  <para style="q" vid="JOL 2:28">iwanenu iwalume ne iwapinga watsakona ipfinu ipfitsolawila.<verse eid="JOL 2:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="JOL 2:29" />Pfipfila nitsowaghalila ghumuhe ghwangu kwe iwatumwa wenu,</para>
  <para style="q" vid="JOL 2:29">iwamale ne iwapinga.<verse eid="JOL 2:29" /></para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" sid="JOL 2:30" />Nitsotenda ipfinu pfa kukangawatsa mlanga na mne isi,</para>
  <para style="q" vid="JOL 2:30">kutsakuwa na idamu, ghumoto na lihosi ilitanda ka wingu.<verse eid="JOL 2:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="JOL 2:31" />Lutsuwa lutsakuwa ne ichisi na</para>
  <para style="q" vid="JOL 2:31">ghumwetsi ghutsakuwa mdung'u ka idamu.</para>
  <para style="q" vid="JOL 2:31">Agha ghose ghatsolawila ng'ana litsuwa likulu na lokupfuka lye Imtwatsa Imulungu lipfike.<verse eid="JOL 2:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="JOL 2:32" />Aho iwanu wose iwatsolomba kwa taghwa lye Imulungu watsokombolighwa.</para>
  <para style="q" vid="JOL 2:32">Kwaapfila mne chidunda cha Siyoni na Yerusalemu,</para>
  <para style="q" vid="JOL 2:32">kutsakuwa ne iwanu iwatsohona,</para>
  <para style="q" vid="JOL 2:32">ka pfanongile nene Imtwatsa Imulungu.</para>
  <para style="q" vid="JOL 2:32">Awala waniwasaghule watsakuwa waghima.”<verse eid="JOL 2:32" /></para>
  <chapter eid="JOL 2" />
  <chapter number="3" style="c" sid="JOL 3" />
  <para style="s">Imulungu kowahigha iwanu</para>
  <para style="p">
    <verse number="1" style="v" sid="JOL 3:1" />Imtwatsa Imulungu kalonga,</para>
  <para style="q" vid="JOL 3:1">“Ghamatsuwa agho hanitsotsitenda keli isi tsa Yuda na Yelusalemu tsinoghe keli,<verse eid="JOL 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="JOL 3:2" />nitsowakema iwanu wose,</para>
  <para style="q" vid="JOL 3:2">niwaghale kuluwanda ikukemighwa Imulungu kohigha.</para>
  <para style="q" vid="JOL 3:2">Ako nitsowohigha iwanu awo kwa aghala ghawawatendele iwanu wangu,</para>
  <para style="q" vid="JOL 3:2">awo iwali wangu nene nimwenyegho.</para>
  <para style="q" vid="JOL 3:2">Kwaapfila tsawawapwililisa iwanu wangu mne isi tsingi na</para>
  <para style="q" vid="JOL 3:2">wawaghola iwangu wangu.<verse eid="JOL 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JOL 3:3" />Na kwigholela iwanu wangu kwa ukwasa tsisimbi.</para>
  <para style="q" vid="JOL 3:3">Tsawawautsa iwasongolo ili wapate sendi yo kuwahonga iwapinga pfiweghe,</para>
  <para style="q" vid="JOL 3:3">wawautsa iwali ili waghulile imbwali.<verse eid="JOL 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JOL 3:4" />“Mbama kunitenda choni mwemwe iwanu wa Tiro na Sidoni ne isi tsose tsa Filistia? Nene siwatendele bae chinu chochose chihile, apfo ka mwobama kuhitsa acho chamlonga niwatendela, nene nitsolongola kuhitsa acho chambama kunitendela. <verse eid="JOL 3:4" /><verse number="5" style="v" sid="JOL 3:5" />Msola ifetsa na inzahabu yangu na pfinu pfangu pfinoghile ipfili pfa bei ng'ulu, mpfighala mbaka mne tsing'anda tse imilungu yenu. <verse eid="JOL 3:5" /><verse number="6" style="v" sid="JOL 3:6" />Muwaghala iwanu wa Yuda na Yurusalemu kutali ne isi yawo, muwautsa kwa Wagiriki. <verse eid="JOL 3:6" /><verse number="7" style="v" sid="JOL 3:7" />Lelo nitsowohitsa iwanu wangu wose kulawa ako kwamuwautsile. Nitsowohitsila aghala ghose ghamuwatendele. <verse eid="JOL 3:7" /><verse number="8" style="v" sid="JOL 3:8" />Nitsowatenda iwana wenu iwamale ne iwapinga wautsighwe kwa iwanu wa Yuda, nawo watsowautsila Waasheba, iwanu wokala kutali ghendo. Nene Imtwatsa Imulungu nolonga. <verse eid="JOL 3:8" /><verse number="9" style="v" sid="JOL 3:9" />Muwalongele iwanu we isi tsose imbuli ino,</para>
  <para style="q" vid="JOL 3:9">weyandaye ghoya kwe ing'ondo,</para>
  <para style="q" vid="JOL 3:9">wakemeni iwanu wane ngupfu, na</para>
  <para style="q" vid="JOL 3:9">iwanu iwadahile kwitowa pfinoghile wetingane hamwe,</para>
  <para style="q" vid="JOL 3:9">nawo watemelele.<verse eid="JOL 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="JOL 3:10" />Ghamaghembe ghenu mghanole ghawe mapanga,</para>
  <para style="q" vid="JOL 3:10">tsisengo tsenu tso kupfunila tsiwe mighowa.</para>
  <para style="q" vid="JOL 3:10">Hata iyali nyondenyonde yalonge</para>
  <para style="q" vid="JOL 3:10">‘Nani pfipfila nina ingupfu.’<verse eid="JOL 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="JOL 3:11" />Itsani himahima mwemwe wose yamli habei,</para>
  <para style="q" vid="JOL 3:11">na mwitingane kuluwanda.”</para>
  <para style="q" vid="JOL 3:11">Imulungu hulumsa iwanu wako wane ngupfu wawatowe.<verse eid="JOL 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="JOL 3:12" />“Lelo iwanu wose iwokala habei wehimitse,</para>
  <para style="q" vid="JOL 3:12">watse kuluwanda ukukemighwa Imulungu kohigha.</para>
  <para style="q" vid="JOL 3:12">Ako nene Imtwatsa Imulungu,</para>
  <para style="q" vid="JOL 3:12">nitsokala na kuwahigha.<verse eid="JOL 3:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="JOL 3:13" />Lelo soleni tsisengo,</para>
  <para style="q" vid="JOL 3:13">kwaapfila sambi chipindi cho kupfuna.</para>
  <para style="q" vid="JOL 3:13">Mwingile muwahonde ka nzabibu</para>
  <para style="q" vid="JOL 3:13">itsimemile sideke hanu ho kukamila.</para>
  <para style="q" vid="JOL 3:13">Nzambi tsawo nyingi sideke,</para>
  <para style="q" vid="JOL 3:13">ka mabigha ighamemile.”<verse eid="JOL 3:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="JOL 3:14" />Makingili kwa makingili wamne lwanda lyo kuhighila,</para>
  <para style="q" vid="JOL 3:14">mana litsuwa lye Imtwatsa Imulungu lya habehi.<verse eid="JOL 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JOL 3:15" />Lutsuwa na lwetsi pfoghelighwa ichisi,</para>
  <para style="q" vid="JOL 3:15">na tsinondo tsoleka ukung'aika.<verse eid="JOL 3:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="JOL 3:16" />Imulungu koduma ako Siyoni,</para>
  <para style="q" vid="JOL 3:16">litsi lyake lyopfuma kulawa Yerusalemu,</para>
  <para style="q" vid="JOL 3:16">ililanga ne isi pfoghudema.</para>
  <para style="q" vid="JOL 3:16">Lekeni iwanu wake wotsumila kwe Imulungu,</para>
  <para style="q" vid="JOL 3:16">kwaapfila yeye ka ubanda iuwakinga Waisraeli.<verse eid="JOL 3:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="JOL 3:17" />Aho ghweghwe Isiraeli,</para>
  <para style="q" vid="JOL 3:17">kutsomanya ka nene Imulungu wako,</para>
  <para style="q" vid="JOL 3:17">nokala Siyoni, chidunda changu chenzeluke,</para>
  <para style="q" vid="JOL 3:17">Yerusalemu itsakuwa isi yenzeluke,</para>
  <para style="q" vid="JOL 3:17">ne iwagheni ng'awotsotemelela keli bae.<verse eid="JOL 3:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="JOL 3:18" />Mna litsuwa alyo ipfidunda pfitsomema minzabibu,</para>
  <para style="q" vid="JOL 3:18">na mne ipfidunda iwanyama watsolapfa ghamatsiwa.</para>
  <para style="q" vid="JOL 3:18">Ipfikolongo pfose pfa isi ya Yuda pfitsomema ghamatsi,</para>
  <para style="q" vid="JOL 3:18">imbwibwi itsolawila mne ing'anda ye Imulungu,</para>
  <para style="q" vid="JOL 3:18">no kughelela ghamatsi mne lwanda lwa Shitimu.<verse eid="JOL 3:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="JOL 3:19" />“Lekeni Misiri itsakuwa mahame,</para>
  <para style="q" vid="JOL 3:19">Edomu itsakuwa nyika,</para>
  <para style="q" vid="JOL 3:19">kwaapfila tsawawapfingilila iwanu wa Yuda,</para>
  <para style="q" vid="JOL 3:19">na wawakoma iwanu iwalihela nzambi.<verse eid="JOL 3:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="JOL 3:20" />Lekeni isi ya Yuda itsokalighwa matsuwa ghose,</para>
  <para style="q" vid="JOL 3:20">na Yerusalemu itsokalighwa lweleko mbaka lweleko.<verse eid="JOL 3:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="JOL 3:21" />Nitsowohigha iwanu yawawakomile iwanu wa Yuda,</para>
  <para style="q" vid="JOL 3:21">na sitsowalekelela bae wane tsinzambi.</para>
  <para style="q" vid="JOL 3:21">Nene, Mtwatsa Imulungu nitsokala mna chidunda cha Siyoni.”<verse eid="JOL 3:21" /></para>
  <chapter eid="JOL 3" />
</usx>