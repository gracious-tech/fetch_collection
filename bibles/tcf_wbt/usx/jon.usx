<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JON" style="id">tcfU (32-Jonás) - Me̱ꞌpha̱a̱ Mañúwi̱ín (Malinaltepec) agosto 2007; c4/v48</book>
  <para style="h">Jonás</para>
  <para style="toc3">Jon</para>
  <para style="toc2">Jonás</para>
  <para style="toc1">I̱yu̱u̱ꞌ Jonás</para>
  <para style="mt2">I̱yu̱u̱ꞌ</para>
  <para style="mt">Jonás</para>
  <chapter number="1" style="c" sid="JON 1" />
  <para style="s">Jonás najñaguii ná inuu Ana̱ꞌlóꞌ Mikhuíí</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 1:1" />Mbá mbiꞌi Ana̱ꞌlóꞌ Mikhuíí niꞌthúun Jonás, a̱dée táta̱ Amitái: <verse eid="JON 1:1" /><verse number="2" style="v" sid="JON 1:2" />«Ayu re̱ ná xuajen Níni̱be̱ rí maphú mba̱a̱, jamí arathúún xa̱bo̱ rí ma̱ne̱-gámba̱a xuajen. Numuu rí ra̱máján rí nuni̱i̱ nijráꞌáan asndo ná inuꞌ ge̱jyoꞌ».<verse eid="JON 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JON 1:3" />A̱ꞌkhue̱n Jonás, neꞌne rí magáyuu ná inuu Ana̱ꞌlóꞌ Mikhuíí, ikhaa jngó ni̱tu̱xu̱u̱ꞌ ma̱ꞌgee̱ ná xuajen rí mbiꞌyuu Társi̱s. Ni̱ga̱taa̱ ná Jópe̱ jamí ikhín nixkamaa̱ mbá guꞌwá-rguwa rí na̱ka̱ ná Társi̱s. Neꞌne-numuu̱ ne̱ jamí nitsimuu̱ nijngúu̱n awúun ne̱, rí ma̱ꞌgee̱ gajmíi̱ xa̱bo̱ tsí nagóó ikhín. Xkuaꞌnii naꞌnii̱ magáyuu̱ tsíngua̱ꞌ inuu Ana̱ꞌlóꞌ.<verse eid="JON 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JON 1:4" />Xómáꞌ Ana̱ꞌlóꞌ neꞌne rí maxnúu mbá gíñá rí maphú gakhe̱ ná inuu iya a̱pha̱. A̱ꞌkhue̱n ni̱gi̱ꞌdu̱u̱n nixnúu mi̱ndaꞌkho ruꞌwa gíñá, rí asndo naꞌne rí ma̱ngudi-ri̱ga̱a guꞌwá-rguwa. <verse eid="JON 1:4" /><verse number="5" style="v" sid="JON 1:5" />Jamí xa̱bo̱ tsí nagóó juñu̱ú guꞌwá-rguwa maphú nimíñúu̱, ikhaa jngó mbámbáa naxrígo̱o̱ mbiꞌyuu tsí naꞌne-mba̱a̱ máꞌ jayu, tsí ra̱ꞌkháa Ana̱ꞌlóꞌ ñajuun. Xúꞌkhue̱n máꞌ ni̱stuáꞌée̱n ná awúun iya a̱pha̱ mbá xúgíí ja̱ꞌne rí jago̱ guꞌwá-rguwa kajngó ma̱ꞌne wiphi ne̱ wáa. Xómáꞌ Jonás wapha máꞌ ni̱ga̱taa̱ gíguii̱ ná awúun guꞌwá-rguwa. <verse eid="JON 1:5" /><verse number="6" style="v" sid="JON 1:6" />A̱ꞌkhue̱n rí xa̱bo̱ tsí naꞌthán-ñájun ná guꞌwá-rguwa ni̱ga̱taa ná kri̱ga̱a̱ Jonás jamí niꞌthúu̱n: «Dí ithane̱ kri̱ga̱án nanu guíñaaꞌ ge̱jyoꞌ róꞌ. Araxo̱n re̱, arathán-jáñíí ana̱a̱ꞌ mangáánꞌ. Gáꞌne xí ma̱ñáwíin a̱kuii̱n jaꞌyalóꞌ rí ma̱xámbáanꞌlóꞌ».<verse eid="JON 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JON 1:7" />A̱ꞌkhue̱n nithan-mijná xa̱bo̱ tsí nagóó juñu̱ú guꞌwá-rguwa: «Gu̱ꞌyáálóꞌ tsáa phú aꞌkhúun kajngó na̱ꞌkha̱ rí ra̱máján ríge̱ꞌ inalóꞌ». A̱ꞌkhue̱n nikujma rí ga̱jma̱á numuu aꞌkhúun Jonás ñajuun ne̱. <verse eid="JON 1:7" /><verse number="8" style="v" sid="JON 1:8" />Ikhaa jngó nitháa̱n:</para>
  <para style="p" vid="JON 1:8">―Arathánxo̱ꞌ re̱, náá numuu kajngó xáꞌnii i̱ꞌkha̱ gamiéjun ríge̱ꞌ inalóꞌ róꞌ. Dí ñajwiin ithane̱ kajngó, jamí náá idxa̱ꞌ róꞌ. Náá xuajñaaꞌ jamí tsíin ñajúún xa̱bia̱aꞌ róꞌ.<verse eid="JON 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JON 1:9" />A̱ꞌkhue̱n ikhaa̱ niꞌthúu̱n:</para>
  <para style="p" vid="JON 1:9">―Ikhúúnꞌ ñajunꞌ xa̱bo̱ ebréo̱, jamí na̱ne̱-mba̱a̱ Ana̱ꞌlóꞌ tsí xtáa Mikhuíí, tsí neꞌne-ku̱maa iya a̱pha̱ jamí ju̱ba̱ꞌ.<verse eid="JON 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 1:10" />Numuu rí jmína̱a̱ꞌ máꞌ Jonás niꞌthúu̱n rí nagáyuu̱ inuu Ana̱ꞌlóꞌ Mikhuíí, ikhaa jngó i̱tha̱án xóó nimíñúú xa̱bo̱ tsúꞌkhue̱n jamí nitháa̱n:</para>
  <para style="p" vid="JON 1:10">―Náá numuu kajngó xáꞌnii nithane̱ róꞌ.<verse eid="JON 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JON 1:11" />Xómáꞌ iya a̱pha̱ rígu i̱ka̱-ramangu̱u̱ꞌ ne̱ i̱tha̱án xóó, ikhaa jngó nitháa̱n:</para>
  <para style="p" vid="JON 1:11">―Dí gúne̱xo̱ꞌ ga̱jma̱á nindxa̱a̱ꞌ kajngó ma̱ba̱aꞌ-wíyuu iya a̱pha̱ róꞌ.<verse eid="JON 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JON 1:12" />A̱ꞌkhue̱n ikhaa̱ niꞌthúu̱n:</para>
  <para style="p" vid="JON 1:12">―Gu̱rtuwúúnlaꞌ jamí gu̱xpa̱túꞌúúnlaꞌ ná awúun iya a̱pha̱, kajngó ma̱ba̱aꞌ-wíyuu ne̱. Numuu rí nda̱yo̱o̱ máꞌ rí ga̱jma̱á numuu aꞌkhúnꞌ ikhúúnꞌ na̱ꞌkha̱ ruꞌwa gíñá ríge̱ꞌ inalaꞌ.<verse eid="JON 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JON 1:13" />A̱ꞌkhue̱n rí xa̱bo̱ tsúꞌkhue̱n nene̱-tsiakhe̱-mijná rí magóó juñu̱ú guꞌwá-rguwa ná rawuun iya. I̱ndo̱ó máꞌ numuu rí táꞌngúu̱n, numuu rí iya a̱pha̱ rígu i̱ka̱-ramangu̱u̱ꞌ ne̱ i̱tha̱án xóó jaꞌñúu̱. <verse eid="JON 1:13" /><verse number="14" style="v" sid="JON 1:14" />Ikhaa jngó ni̱gíꞌdíi̱n ni̱ndxa̱ꞌwe̱e̱: «Táta̱ Mikhuíí, nu̱tha̱n-jáñaaꞌxo̱ꞌ rí ma̱xátha̱ne̱ rí ma̱ja̱ñáxo̱ꞌ ga̱jma̱á numuu rí mu̱xíya̱a̱xo̱ꞌ xa̱bo̱ tsíge̱ꞌ. Ni máꞌ ma̱xátrígu aꞌkhán tsu̱da̱ꞌxo̱ꞌ xí rí nda̱a̱ aꞌkhúu̱n. Numuu rí ikháánꞌ, Táta̱, nathane̱ rí ma̱ri̱gá mbá xúgíí ríge̱ꞌ xómá naꞌne a̱kia̱anꞌ ikháánꞌ».<verse eid="JON 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JON 1:15" />A̱ꞌkhue̱n ni̱rtuwii̱n Jonás, jamí ni̱xpa̱tuáꞌáa̱n ná awúun iya a̱pha̱. A̱ꞌkhue̱n iya a̱pha̱ núkho̱ máꞌ nibáa-wíyuu rí namangu̱u̱ꞌ ne̱. <verse eid="JON 1:15" /><verse number="16" style="v" sid="JON 1:16" />Rí xkuaꞌnii ndiyáá xa̱bo̱ tsúꞌkhue̱n, maphú ndiya-makuíi̱ Táta̱ Mikhuíí. Ni̱xna̱xíi̱ tsi̱gi̱jña̱ꞌ ná inuu̱, xúꞌkhue̱n máꞌ ni̱xu̱ꞌdá-mijnée̱ mbá awan ná inuu Ana̱ꞌlóꞌ Mikhuíí.<verse eid="JON 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JON 1:17" />Xómáꞌ Ana̱ꞌlóꞌ Mikhuíí, gíꞌdaa máꞌ xawii mbáa i̱gi̱ꞌ tsí maphú mba̱a̱ tsí ma̱ga̱a̱n-jnguíin Jonás. Jamí Jonás nixtáa ná awúun i̱gi̱ꞌ mbá atsú mbiꞌi jamí atsú mbroꞌon.<verse eid="JON 1:17" /></para>
  <chapter eid="JON 1" />
  <chapter number="2" style="c" sid="JON 2" />
  <para style="s">Jonás naꞌthán-jáñuu Ana̱ꞌlóꞌ</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 2:1" />A̱ꞌkhue̱n rí asndo ná awúun i̱gi̱ꞌ Jonás niꞌthán-jáñuu Anu̱u̱ tsí xtáa Mikhuíí. <verse eid="JON 2:1" /><verse number="2" style="v" sid="JON 2:2" />Xáꞌnii niꞌthée̱n:</para>
  <para style="q" vid="JON 2:2">«Awúun rí xtáá gaꞌkho̱ ni̱tha̱n-jáñaaꞌ, Táta̱,</para>
  <para style="q" vid="JON 2:2">jamí ikháánꞌ nitadxawunꞌ.</para>
  <para style="q" vid="JON 2:2">Awúun rí ku̱ꞌwu̱únꞌ ná iñá-wajíín, ni̱tha̱n-jáñaaꞌ,</para>
  <para style="q" vid="JON 2:2">jamí ikháánꞌ nitadxawíín a̱ꞌwóꞌ.<verse eid="JON 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="JON 2:3" />Nithada-muꞌúún ná phú me̱jno̱ꞌ awúun iya a̱pha̱.</para>
  <para style="q" vid="JON 2:3">I̱ndo̱ó máꞌ iya natuaꞌán ná ku̱ꞌwu̱únꞌ.</para>
  <para style="q" vid="JON 2:3">Mbá xúgíí ski̱yu̱u̱ꞌ iya rí narmbúxe̱-mina̱ꞌ nanújngoo ná tsu̱du̱ꞌ.<verse eid="JON 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="JON 2:4" />Asndo ni̱ndxa̱ꞌwa̱-mína̱ꞌ rí níyaaꞌ máꞌ xtayoꞌ.</para>
  <para style="q" vid="JON 2:4">Maske máꞌ xúꞌkhue̱n, ma̱thangu̱ún máꞌ tsiakhe̱ mba̱yo̱o̱ guꞌwá dxákiaanꞌ.<verse eid="JON 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="JON 2:5" />Ni̱rmúꞌúún mbá jayu ná awúun iya,</para>
  <para style="q" vid="JON 2:5">jamí waꞌdu-muꞌúún mbá jayu ná iñá me̱jno̱ꞌ.</para>
  <para style="q" vid="JON 2:5">I̱ndo̱ó máꞌ mbáꞌwá nimbróꞌoo ná idxu̱ꞌ.<verse eid="JON 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="JON 2:6" />Nigátáa asndo ná xtuun nakhúu júba̱.</para>
  <para style="q" vid="JON 2:6">Mbá jámuu nirugoo ju̱ba̱ꞌ ná tsu̱du̱ꞌ i̱yo̱o̱lo̱ꞌ.</para>
  <para style="q" vid="JON 2:6">Xómáꞌ ikháánꞌ rá, Tátéꞌ, Anu̱ꞌ Mikhuíí, nithane̱-jríñu̱úꞌ rí tájáñuꞌ.<verse eid="JON 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="JON 2:7" />Ído̱ nda̱yo̱o̱ rí na̱ka̱ máꞌ xu̱ꞌ rá,</para>
  <para style="q" vid="JON 2:7">ni̱rmáꞌáan a̱kui̱nꞌ ja̱ya̱a̱ꞌ, Táta̱.</para>
  <para style="q" vid="JON 2:7">Ni̱ga̱nú a̱ꞌwóꞌ asndo ná ñaꞌwaanꞌ ná guꞌwá dxákiaanꞌ.<verse eid="JON 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="JON 2:8" />Xómáꞌ xa̱bo̱ tsí nune̱-mbi̱in tsí ra̱ꞌkháa Ana̱ꞌlóꞌ ñajúún,</para>
  <para style="q" vid="JON 2:8">nu̱ni̱ꞌñáá-ranimbu̱únꞌ juyaaꞌ ikháánꞌ.<verse eid="JON 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="JON 2:9" />Xómáꞌ ikhúúnꞌ ma̱sian ajmúú rí ma̱ne̱-mba̱ánꞌ,</para>
  <para style="q" vid="JON 2:9">xúꞌkhue̱n máꞌ ma̱xna̱xáaꞌ tsi̱gi̱jña̱ꞌ,</para>
  <para style="q" vid="JON 2:9">jamí ma̱ne̱-mbánuu rí ni̱xu̱ꞌdá-mina̱ꞌ ná inaaꞌ.</para>
  <para style="q" vid="JON 2:9">¡I̱ndo̱ó máꞌ ikháánꞌ, Anu̱ꞌ Mikhuíí, na̱ꞌnga̱a̱ꞌ nathane̱-jáwíin xa̱bo̱!».<verse eid="JON 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 2:10" />A̱ꞌkhue̱n rí Ana̱ꞌlóꞌ Mikhuíí niꞌthán-ñájuun i̱gi̱ꞌ, jamí i̱gi̱ꞌ ni̱ka̱ gáxi-ri̱ya̱aꞌ Jonás ná rawuun iya.<verse eid="JON 2:10" /></para>
  <chapter eid="JON 2" />
  <chapter number="3" style="c" sid="JON 3" />
  <para style="s">Xa̱bo̱ Níni̱be̱ nathanga̱a a̱kui̱ín ná inuu Ana̱ꞌlóꞌ</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 3:1" />A̱ꞌkhue̱n ni̱ꞌkha̱ rí riajma̱ nothon ajngáa rawuun Ana̱ꞌlóꞌ Mikhuíí inuu Jonás, xáꞌnii waꞌtháa̱n: <verse eid="JON 3:1" /><verse number="2" style="v" sid="JON 3:2" />«Ayu re̱ ná xuajen Níni̱be̱ rí maphú mba̱a̱, jamí arathán-raꞌa a̱pha̱ ikhín ajngáa rí ma̱tha̱a̱nꞌ».<verse eid="JON 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JON 3:3" />A̱ꞌkhue̱n rí Jonás ni̱ka̱ ná xuajen Níni̱be̱, xómá rí waꞌxná-ñájwíi̱n neꞌne Ana̱ꞌlóꞌ. Níni̱be̱ ñajuun mbá xuajen rí maphú mba̱a̱ mi̱ndaꞌkho, atsú mbiꞌi ma̱ꞌne xa̱bo̱ rí ma̱ꞌga nakhúu ná awúun ne̱ kajngó ma̱nújngoo̱ ne̱. <verse eid="JON 3:3" /><verse number="4" style="v" sid="JON 3:4" />Jonás ni̱to̱ꞌo̱o̱ ná xuajen jamí ni̱ke̱e̱ nakhúu̱ mbá mbiꞌi jayu, a̱ꞌkhue̱n nigíꞌdu̱u̱n niꞌthán-raꞌee̱ gakhe̱ xáꞌnii: «Ana̱ꞌlóꞌ Mikhuíí ma̱ꞌne-gámba̱a xuajen ríge̱ꞌ, ído̱ gárámuu a̱jma̱ skíñú (40) mbiꞌi». <verse eid="JON 3:4" /><verse number="5" style="v" sid="JON 3:5" />A̱ꞌkhue̱n rí mbá xúgíin xa̱bo̱ Níni̱be̱ ninimbu̱únꞌ rí niꞌthán Ana̱ꞌlóꞌ, jamí ni̱ꞌgí-mijnée̱ rí mbuya-miꞌkhíi̱. Asndo xa̱bo̱ tsí júwa̱ꞌ mújúún jamí asndo tsí ngíníi nijúwúún xtíin rí xíni, rí naꞌtsu̱ra̱ꞌa, rí nu̱snga̱jmee̱ rí nathanga̱a a̱kuíi̱n.<verse eid="JON 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JON 3:6" />Ído̱ rí thúngaa drígu̱ún xa̱bo̱ Níni̱be̱ niꞌdxuun ajngáa rúꞌkhue̱n, a̱ꞌkhue̱n mangaa̱ niniñuu̱ ná ꞌgíi̱ naꞌthán-ñájwii̱n. Niríyaa̱ꞌ xtíin rí mitsaan júwuu̱n, nijúwaa̱n xtíin rí xíni rí naꞌtsu̱ra̱ꞌa jamí ni̱gi̱ꞌi̱i̱ mbayíí ná inuu idi. <verse eid="JON 3:6" /><verse number="7" style="v" sid="JON 3:7" />Xúꞌkhue̱n máꞌ nixná-ñájwii̱n rí jámba̱a̱ xa̱bo̱ Níni̱be̱ madxawuun ajngáa rí naꞌthée̱n a̱pha̱ gajmíi̱ xa̱bii̱: «Nimbáa xa̱bo̱ ni máꞌ xu̱kú tsí ñajúún xede̱ jamí xu̱kú mogo̱, mu̱xúpeꞌtso ni máꞌ mu̱xúwa̱a̱n iya. <verse eid="JON 3:7" /><verse number="8" style="v" sid="JON 3:8" />A̱ꞌkhue̱n gakon jámba̱a̱ xa̱bo̱ jamí xu̱kú gajúwúún xtíin rí xíni. Xúꞌkhue̱n máꞌ guthán-jáñíi̱ Ana̱ꞌlóꞌ ga̱jma̱á mbá xúgíí ski̱ñúu̱. Ga̱thanga̱a a̱kui̱in mbámbáa inuu rí xkawe̱ꞌ naꞌne jamí ganiñuu jamba̱a̱ rí ra̱máján ná na̱ka̱. <verse eid="JON 3:8" /><verse number="9" style="v" sid="JON 3:9" />Á gáꞌne xí Ana̱ꞌlóꞌ mandxaꞌwá-mina̱aꞌ jamí maxrígúu̱ a̱kuii̱n rí najiꞌnáa̱, jamí ma̱xáꞌne-gámbáa̱nꞌlóꞌ».<verse eid="JON 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 3:10" />Ído̱ ndiꞌyoo Ana̱ꞌlóꞌ rí xa̱bo̱ Níni̱be̱ ni̱ni̱ꞌñáá-rune̱ rí ra̱máján, a̱ꞌkhue̱n nithanga̱a a̱kuii̱n rí niꞌthée̱n ma̱ꞌñúu̱, jamí na̱nguá máꞌ neꞌne-gámbii̱n.<verse eid="JON 3:10" /></para>
  <chapter eid="JON 3" />
  <chapter number="4" style="c" sid="JON 4" />
  <para style="s">Jonás naꞌne xkujndu ná inuu Ana̱ꞌlóꞌ</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 4:1" />Xómáꞌ Jonás maphú táni̱gu̱u̱ꞌ rí na̱nguá wámbi̱in xa̱bo̱, ikhaa jngó phú nijiꞌnáa̱. <verse eid="JON 4:1" /><verse number="2" style="v" sid="JON 4:2" />A̱ꞌkhue̱n niꞌthúu̱n Ana̱ꞌlóꞌ Mikhuíí xáꞌnii:</para>
  <para style="p" vid="JON 4:2">―Táta̱, Anu̱ꞌ Mikhuíí, á ra̱ꞌkhá ikhaa máꞌ rúꞌkhue̱n xtáá na̱tha̱n-mína̱ꞌ nákhí xtáá ná xuajñuꞌ dxe̱ꞌ. Ikhaa jngó mbá nacha̱ máꞌ ne̱ne̱ rí ma̱ga̱yúꞌ inaaꞌ ná Társi̱s. Numuu rí nda̱yo̱o̱ mújúnꞌ máꞌ rí maphú mba̱a̱ a̱kia̱anꞌ jamí májáan a̱kia̱anꞌ, Táta̱. Tsíjiꞌnáá nacha̱ guéño jamí phú nañáwíin a̱kia̱anꞌ ene̱ xa̱bo̱, xúꞌkhue̱n máꞌ nathanga̱a a̱kia̱anꞌ rí ma̱tha̱ne̱ rí nirathán ma̱tha̱ñu̱ú xa̱bo̱. <verse eid="JON 4:2" /><verse number="3" style="v" sid="JON 4:3" />Ikhaa jngó xúge̱ꞌ rá, Táta̱ Mikhuíí, na̱tha̱n-jáñaaꞌ rí ma̱trígúu̱ mbiꞌyuꞌ. Numuu rí i̱tha̱án máꞌ máján rí ma̱ja̱ñúꞌ xó rí ma̱xtáálo̱ꞌ.<verse eid="JON 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JON 4:4" />A̱ꞌkhue̱n rí Ana̱ꞌlóꞌ Mikhuíí niꞌthúun Jonás:</para>
  <para style="p" vid="JON 4:4">―Á máján ithane̱ rí najiꞌnáá guéño rá.<verse eid="JON 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JON 4:5" />A̱ꞌkhue̱n nigájna̱a Jonás ná xuajen, ni̱ke̱e̱ gági̱ꞌi̱i̱ ná rawuun ne̱, ná na̱ꞌkha̱ a̱kha̱ꞌ. Ikhín niꞌnii̱ mbá guꞌwá iná, ni̱gi̱ꞌi̱i̱ ná xka̱mixoo ne̱ kajngó mba̱ꞌyoo̱ rí ma̱gíꞌnuu xuajen.<verse eid="JON 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JON 4:6" />Xómáꞌ Ana̱ꞌlóꞌ Mikhuíí neꞌne rí mba̱ꞌya mbá iná ajma̱a̱ rí ma̱ꞌne xka̱mixoo ná ꞌgí Jonás, kajngó ma̱ꞌni̱i wáa a̱kuii̱n rí najmúu̱. Jamí Jonás maphú nidxuu̱ rí ndiꞌya iná ajma̱a̱. <verse eid="JON 4:6" /><verse number="7" style="v" sid="JON 4:7" />I̱ndo̱ó máꞌ numuu rí ído̱ na̱ꞌkha̱-ratse rí i̱mba̱ mbiꞌi, a̱ꞌkhue̱n Ana̱ꞌlóꞌ neꞌne rí mbáa ñu̱u̱ mi̱kho̱ ajmu̱u̱ iná ajma̱a̱, a̱ꞌkhue̱n nijndoo ne̱. <verse eid="JON 4:7" /><verse number="8" style="v" sid="JON 4:8" />Jamí ído̱ nixpátri̱ya̱a̱ꞌ máꞌ a̱kha̱ꞌ rá, a̱ꞌkhue̱n Ana̱ꞌlóꞌ neꞌne rí maxnúu gakhe̱ mbá gíñá rí phú mika. Xómáꞌ a̱kha̱ꞌ natsikhá ná idxu̱u̱ Jonás, rí asndo najámíndúu̱ jamí naꞌne a̱kuii̱n rí ma̱ja̱ñúu̱. A̱ꞌkhue̱n niꞌthée̱n: «I̱tha̱án máꞌ máján rí ma̱ja̱ñúꞌ xó rí ma̱xtáálo̱ꞌ».<verse eid="JON 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JON 4:9" />A̱ꞌkhue̱n Ana̱ꞌlóꞌ niꞌthúun Jonás:</para>
  <para style="p" vid="JON 4:9">―Á máján ithane̱ rí najiꞌnáá mi̱ndaꞌkho numuu rí nijndoo iná ajma̱a̱ rá.</para>
  <para style="p" vid="JON 4:9">Jamí ikhaa̱ niriꞌñee̱:</para>
  <para style="p" vid="JON 4:9">―¡Aan, máján e̱ne̱lo̱ꞌ. Najiꞌnúú mi̱ndaꞌkho, rí asndo naꞌne a̱kui̱nꞌ rí ma̱ja̱ñúꞌlo̱ꞌ!<verse eid="JON 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 4:10" />A̱ꞌkhue̱n Ana̱ꞌlóꞌ Mikhuíí niꞌthúun Jonás:</para>
  <para style="p" vid="JON 4:10">―Phú niñáwíin a̱kia̱anꞌ eꞌne iná ajma̱a̱ maske máꞌ tátha̱du ne̱, ni máꞌ tátha̱ne̱ rí mba̱ꞌya ne̱. Mbá mbroꞌon nijráꞌán ne̱, jamí i̱mba̱ mbroꞌon nijndoo ne̱. <verse eid="JON 4:10" /><verse number="11" style="v" sid="JON 4:11" />Á ra̱ꞌkhá i̱tha̱án ma̱ñáwíin a̱kui̱nꞌ ikhúúnꞌ ja̱yo̱o̱ xuajen Níni̱be̱ rá. Numuu rí ná xuajen mba̱a̱ rúꞌkhue̱n nanújngoo rí mbá majun skíñíi míl (120 000) xa̱bo̱ júwa̱ꞌ, tsí tsíma̱ñúú gúra̱ꞌwíí rí máján jamí rí ra̱máján, xúꞌkhue̱n máꞌ phú mbaꞌiin xu̱kú júwa̱ꞌ ikhín.<verse eid="JON 4:11" /></para>
  <para style="b" />
  <chapter eid="JON 4" />
</usx>