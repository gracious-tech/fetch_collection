<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1TH" style="id">tcfU (53-1Tes) - Me̱ꞌpha̱a̱ Mañúwi̱ín (Malinaltepec) PZM 2006, c5/v89;</book>
  <para style="h">1 Xa̱bo̱ Tesalóni̱ka̱</para>
  <para style="toc3">1 Ts</para>
  <para style="toc2">1 Xa̱bo̱ Tesalóni̱ka̱</para>
  <para style="toc1">Timbá i̱yu̱u̱ꞌ Páblo̱ rí ni̱ka̱ inúú xa̱bo̱ Tesalóni̱ka̱</para>
  <para style="mt2">Timbá i̱yu̱u̱ꞌ Páblo̱ rí ni̱ka̱ inúú</para>
  <para style="mt1">Xa̱bo̱ Tesalóni̱ka̱</para>
  <chapter number="1" style="c" sid="1TH 1" />
  <para style="s">Páblo̱ naraxi̱in tsí nanimbu̱únꞌ juyáá Jesús ná xuajen Tesalóni̱ka̱</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 1:1" />Ikhúúnꞌ ñajunꞌ Páblo̱, ga̱jmi̱ꞌ Silbáno̱ jamí Timotéo̱.</para>
  <para style="p" vid="1TH 1:1">Nu̱tháánxo̱ꞌ i̱yi̱i̱ꞌ ríge̱ꞌ ma̱ꞌga ná inúú tsí nanimbu̱únꞌ juyáá Jesús ná xuajen Tesalóni̱ka̱, tsáanꞌ mbá ꞌnduꞌ juwalaꞌ ná inuu Ana̱ꞌlóꞌ xúꞌkhue̱n máꞌ ná inuu Táta̱ Jesukrísto̱.</para>
  <para style="p" vid="1TH 1:1">A̱gu̱ma-tsakun-rámáaꞌlaꞌ jamí ga̱juwalaꞌ tsímáá gáꞌne Ana̱ꞌlóꞌ Mikhuíí jamí Táta̱ Jesukrísto̱.<note caller="+" style="f"><char style="fr" closed="false">1.1 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «gáꞌne Ana̱ꞌlóꞌ Mikhuíí jamí Táta̱ Jesukrísto̱».</char></note><verse eid="1TH 1:1" /></para>
  <para style="s">Xa̱bo̱ Tesalóni̱ka̱ ñajúún mbá xkri̱da</para>
  <para style="p">
    <verse number="2" style="v" sid="1TH 1:2" />Jámba̱ miꞌtsú nu̱rígu̱uxo̱ꞌ gamaku ná inuu Ana̱ꞌlóꞌ ga̱jma̱á numalaꞌ mbá xúgiáanꞌlaꞌ, jamí tsímbumaxo̱ꞌ e̱ne̱laꞌ ído̱ rí nu̱tha̱n-jáñííxo̱ꞌ Ana̱ꞌlóꞌ. <verse eid="1TH 1:2" /><verse number="3" style="v" sid="1TH 1:3" />Na̱rmáꞌáan máꞌ xúꞌkhue̱n a̱kia̱nꞌxo̱ꞌ ná inuu Ana̱ꞌlóꞌ Mikhuíí eꞌne ñajun rí nu̱ne̱laꞌ ga̱jma̱á numuu rí wéje̱ a̱kia̱nꞌlaꞌ ná inuu̱, rí nu̱ne̱laꞌ numuu rí nandalaꞌ ju̱ya̱á Ana̱ꞌlóꞌ, jamí rí kuajún-gúkuálaꞌ numuu rí mbá jañii a̱kia̱nꞌlaꞌ guáꞌthi̱ínlaꞌ ná inuu Táta̱ Jesukrísto̱.<verse eid="1TH 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1TH 1:4" />A̱ngui̱nꞌ, tsáanꞌ phú nandoo Ana̱ꞌlóꞌ jaꞌyalaꞌ, ndu̱ya̱áxo̱ꞌ rí ikhaa̱ niraꞌwáa̱nꞌlaꞌ rí ma̱nindxa̱ꞌlaꞌ xa̱bo̱ xuajñuu̱. <verse eid="1TH 1:4" /><verse number="5" style="v" sid="1TH 1:5" />Numuu rí ajngáa máján rí nu̱tha̱n-ráꞌaxo̱ꞌ tága̱nú ne̱ ná inalaꞌ i̱ndo̱ó máꞌ ga̱jma̱á ajngáa mixoo jayu, rí mangaa máꞌ ni̱snga̱jmáxo̱ꞌ ski̱yu̱u̱ꞌ Xu̱u̱ꞌ Ana̱ꞌlóꞌ, jamí naꞌne jañii a̱kia̱nꞌxo̱ꞌ rí nu̱tha̱nxo̱ꞌ rí gakon. Ikháanꞌlaꞌ ndu̱ya̱á májánlaꞌ xáne nijuwaxo̱ꞌ ná majña̱ꞌlaꞌ, numuu rí nandaxo̱ꞌ ju̱ya̱ꞌlaꞌ. <verse eid="1TH 1:5" /><verse number="6" style="v" sid="1TH 1:6" />Ikhaa jngó phú gagi a̱kia̱nꞌlaꞌ ído̱ rí ni̱drígúlaꞌ ajngáa máján rúꞌkhue̱n neꞌne Xu̱u̱ꞌ Ana̱ꞌlóꞌ, maske máꞌ juwalaꞌ ná awúun jamínu̱ꞌ. Jamí xkuaꞌnii ikháanꞌlaꞌ ndi̱ya̱-ri̱dáanꞌxo̱ꞌ jamí ndi̱ya̱-ri̱dáálaꞌ Táta̱. <verse eid="1TH 1:6" /><verse number="7" style="v" sid="1TH 1:7" />Jamí asndo ninindxa̱ꞌlaꞌ mbá xkri̱da rí mbuyáá mbá xúgíin tsí ninimbu̱únꞌ juyáá Jesús ná numbaa Masedónia̱ jamí ná numbaa Akáya̱. <verse eid="1TH 1:7" /><verse number="8" style="v" sid="1TH 1:8" />Ná xuajñalaꞌ ikháanꞌlaꞌ a̱ꞌkhue̱n ni̱gi̱ꞌdu̱u̱n ni̱dróꞌoo a̱pha̱ ajngóo Táta̱, jamí ra̱ꞌkhá máꞌ i̱ndo̱ó ná Masedónia̱ ga̱jma̱á Akáya̱, rí mangaa máꞌ ni̱dróꞌoo ne̱ ná mbá xúgíí xuajen. Ikhaa jngó mbá xúgíin xa̱bo̱ nduyáá máꞌ rí ikháanꞌlaꞌ wéje̱ a̱kia̱nꞌlaꞌ ná inuu Ana̱ꞌlóꞌ, jamí tsíꞌyóo máꞌ rí ikháanꞌxo̱ꞌ mu̱tha̱nxo̱ꞌ nitháan ga̱jma̱á numalaꞌ. <verse eid="1TH 1:8" /><verse number="9" style="v" sid="1TH 1:9" />Numuu rí ikhii̱n máꞌ nuthee̱n ga̱jma̱á numaxo̱ꞌ, xáne ni̱dxawíi̱n rí ni̱dríguáanꞌxo̱ꞌlaꞌ, jamí nuthee̱n xáne ni̱ni̱ꞌñáálaꞌ rí nu̱ne̱-mba̱ꞌwi̱inlaꞌ tsí ra̱ꞌkháa Ana̱ꞌlóꞌ ñajúún, kajngó mu̱ne̱-mba̱ꞌwi̱i̱laꞌ Ana̱ꞌlóꞌ tsí ndaꞌya jamí tsí phú ikhaa. <verse eid="1TH 1:9" /><verse number="10" style="v" sid="1TH 1:10" />Xúꞌkhue̱n máꞌ nuthee̱n rí ikháanꞌlaꞌ guáꞌthi̱ínlaꞌ rí ma̱ꞌkha̱a ná mikhuíí A̱dée Ana̱ꞌlóꞌ, tsí ikhaa̱ niꞌnii̱ rí mbayáa mbiꞌyuu. Ikhaa̱ ñajuu̱n Jesús tsí naꞌne-jríñáaꞌlóꞌ inuu jamínu̱ꞌ rí ma̱ꞌkha̱ gáꞌne Ana̱ꞌlóꞌ.<verse eid="1TH 1:10" /></para>
  <chapter eid="1TH 1" />
  <chapter number="2" style="c" sid="1TH 2" />
  <para style="s">Ñajun rí neꞌne Páblo̱ nákhí nixtáa ná Tesalóni̱ka̱</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 2:1" />A̱ngui̱nꞌ, jmínáaꞌlaꞌ máꞌ ikháanꞌlaꞌ ndu̱ya̱á májánlaꞌ rí táꞌne xúgi̱í rí nikuáxo̱ꞌ gúya̱ꞌlaꞌ. <verse eid="1TH 2:1" /><verse number="2" style="v" sid="1TH 2:2" />Jamí ndu̱ya̱álaꞌ máꞌ mangaa rí wapha, phú ni̱gu̱ma-ngínáaꞌxo̱ꞌ jamí waꞌthán-xkawia̱ꞌxo̱ꞌ ná xuajen Filípo̱s. Maske máꞌ xúꞌkhue̱n, ná awúun mba̱a̱ jamínu̱ꞌ Ana̱ꞌlóꞌ niꞌnii̱ rí ma̱xámíñaxo̱ꞌ rí mu̱tha̱n-ráꞌalaꞌxo̱ꞌ ajngáa máján drígo̱o̱. <verse eid="1TH 2:2" /><verse number="3" style="v" sid="1TH 2:3" />Numuu rí nákhí ni̱tha̱n-ráꞌalaꞌxo̱ꞌ, jámba̱ miꞌtsú ni̱tha̱nꞌlaꞌxo̱ꞌ rí gakon, nimbá miꞌtsú túꞌgí-mijnáxo̱ꞌ rí mu̱ña̱ꞌlaꞌ rí ra̱máján ni máꞌ rí mu̱ne̱-nduwaaxo̱ꞌ nimbáa. <verse eid="1TH 2:3" /><verse number="4" style="v" sid="1TH 2:4" />A̱ꞌkhue̱n gakon, ikháanꞌxo̱ꞌ nu̱tha̱nxo̱ꞌ numuu rí Ana̱ꞌlóꞌ ñajuun tsí niꞌgiáanꞌxo̱ꞌ jamí nixnángawaxo̱ꞌ rí mu̱tha̱n-ráꞌaxo̱ꞌ ajngáa máján. Tsíꞌyáxo̱ꞌ rí ma̱ni̱gu̱únꞌ xa̱bo̱ gúne̱xo̱ꞌ, rí ndu̱ꞌyáxo̱ꞌ rí ma̱ni̱gu̱u̱ꞌ Ana̱ꞌlóꞌ gúne̱xo̱ꞌ, numuu rí ikhaa̱ ñajuu̱n tsí naꞌne-nuwii̱n a̱kia̱nꞌxo̱ꞌ. <verse eid="1TH 2:4" /><verse number="5" style="v" sid="1TH 2:5" />Xómá ndu̱ya̱á májánlaꞌ ikháanꞌlaꞌ, rí ikháanꞌxo̱ꞌ ni miꞌtsú túne̱-rájáanꞌlaꞌxo̱ꞌ ga̱jma̱á ajngáa mi̱nduwa rí mitsaan iwán, ni máꞌ túne̱-ndúwáanꞌlaꞌxo̱ꞌ kajngó mu̱guaꞌdááxo̱ꞌ guéño mbúkha̱a̱. Ana̱ꞌlóꞌ ndaꞌyoo rí túne̱xo̱ꞌ rúꞌkhue̱n.<verse eid="1TH 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TH 2:6" />Tsíꞌyáxo̱ꞌ rí xa̱bo̱ numbaa mbuya̱-makuaxo̱ꞌ, ni máꞌ tsíꞌyáxo̱ꞌ rí ikháanꞌlaꞌ mbu̱ya̱-makuaxo̱ꞌ, ni máꞌ rí i̱ꞌwíin xa̱bo̱. Maske máꞌ ma̱goo mu̱xna̱-ñájwanlaꞌxo̱ꞌ rí mu̱mbáyáxo̱ꞌ numuu rí tsí waxúngui̱inꞌ drígo̱o̱ Krísto̱ ñajwanxo̱ꞌ,<note caller="+" style="f"><char style="fr" closed="false">2.6 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ ná na̱nguá mbéꞌtháán ná na̱gi̱ꞌdu̱u̱n kíxnuu 7.</char></note> <verse eid="1TH 2:6" /><verse number="7" style="v" sid="1TH 2:7" />a̱ꞌkhue̱n gakon ne̱ne̱-xkáꞌtsalaꞌxo̱ꞌ, xómá eꞌne mbáa a̱ꞌgo̱ tsí na̱ña̱wu̱ún i̱ji̱in. <verse eid="1TH 2:7" /><verse number="8" style="v" sid="1TH 2:8" />Xkuaꞌnii máꞌ mangáanꞌxo̱ꞌ, ra̱ꞌkhá tháán nandaxo̱ꞌ ju̱ya̱ꞌlaꞌ, rí ra̱ꞌkhá máꞌ i̱ndo̱ó ajngáa máján drígo̱o̱ Ana̱ꞌlóꞌ ndiyaxo̱ꞌ rí mu̱tha̱nꞌlaꞌ, rí asndo mangaa máꞌ nijuwaxo̱ꞌ xawi rí mu̱xna̱xálaꞌxo̱ꞌ mbá xúgíí máꞌ rí ñajwanxo̱ꞌ, numuu rí ra̱ꞌkhá tháán nandaxo̱ꞌ ju̱ya̱ꞌlaꞌ.<verse eid="1TH 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 2:9" />A̱ngui̱nꞌ, ikháanꞌlaꞌ na̱rmáꞌáan a̱kia̱nꞌlaꞌ xáne ni̱ñajunxo̱ꞌ jamí neꞌne níꞌnga̱ꞌxo̱ꞌ. Ni̱ñajunxo̱ꞌ mbiꞌíí mbruꞌwíín, kajngó mu̱xúne̱-gajmááxo̱ꞌ asndo nimbáa tsí ikháanꞌlaꞌ ga̱jma̱á numuu rí ndaꞌyáxo̱ꞌ, awúun máꞌ rí nu̱tha̱n-ráꞌalaꞌxo̱ꞌ ajngáa máján drígo̱o̱ Ana̱ꞌlóꞌ. <verse eid="1TH 2:9" /><verse number="10" style="v" sid="1TH 2:10" />Ikháanꞌlaꞌ tsáanꞌ nanimba̱ꞌlaꞌ ju̱ya̱á Ana̱ꞌlóꞌ naꞌne inalaꞌ jamí naꞌne máꞌ inuu Ana̱ꞌlóꞌ mangaa, rí mbá jaꞌwu a̱kia̱nꞌxo̱ꞌ nijuwaxo̱ꞌ ga̱jma̱á nindxa̱ꞌlaꞌ. Ne̱ne̱xo̱ꞌ rí máján, jamí nda̱a̱ nimbá rí ra̱máján mi̱ꞌthán ga̱jma̱á numaxo̱ꞌ. <verse eid="1TH 2:10" /><verse number="11" style="v" sid="1TH 2:11" />Xkuaꞌnii máꞌ mangaa ndu̱ya̱álaꞌ rí mbámbáa tsí ikháanꞌlaꞌ nu̱tha̱n-máꞌáánxo̱ꞌ jamí nu̱xna̱axo̱ꞌ tsiakhe̱ xómá eꞌne mbáa xa̱bo̱ nikhi̱i̱ gajmíí i̱ji̱in.<note caller="+" style="f"><char style="fr" closed="false">2.11 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ ná na̱nguá mbéꞌtháán ná na̱gi̱ꞌdu̱u̱n kíxnuu 12.</char></note> <verse eid="1TH 2:11" /><verse number="12" style="v" sid="1TH 2:12" />Jamí nu̱xna̱-ngáwalaꞌxo̱ꞌ rí ma̱juwalaꞌ xómá gíꞌmaa rí ma̱ju̱wá tsí ñajúún i̱ji̱in Ana̱ꞌlóꞌ, tsí nindxaꞌwálaꞌ rí ma̱nindxa̱ꞌlaꞌ xa̱bo̱ tsí ikhaa̱ naꞌthán-ñájúu̱n jamí ma̱juwalaꞌ ná inuu̱.<verse eid="1TH 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 2:13" />Ikhaa numuu rúꞌkhue̱n, ikháanꞌ mangáanꞌxo̱ꞌ tsíni̱ꞌñááxo̱ꞌ rí nu̱rígu̱uxo̱ꞌ gamaku ná Ana̱ꞌlóꞌ, numuu rí nákhí ikháanꞌlaꞌ ni̱drígúlaꞌ ajngóo Ana̱ꞌlóꞌ rí ni̱tha̱n-ráꞌalaꞌxo̱ꞌ, ni̱drígúlaꞌ ne̱ xómá ajngóo Ana̱ꞌlóꞌ, ra̱ꞌkhá xómá ajngúún xa̱bo̱ numbaa. Jamí gakon máꞌ rí ajngóo Ana̱ꞌlóꞌ ñajuun ne̱, ikhaa ne̱ nambáyálaꞌ tsáanꞌ nanimba̱ꞌlaꞌ ju̱ya̱á Ana̱ꞌlóꞌ. <verse eid="1TH 2:13" /><verse number="14" style="v" sid="1TH 2:14" />Numuu rí ikháanꞌlaꞌ a̱ngui̱nꞌ, ni̱míni̱ílaꞌ xómá ni̱míni̱í mbámbá kuthuun xa̱bi̱i Ana̱ꞌlóꞌ tsí nanimbu̱únꞌ juyáá Jesús ná numbaa Judéa̱. Numuu rí ikháanꞌlaꞌ ni̱míni̱ílaꞌ nene̱ xa̱bo̱ máꞌ xuajñalaꞌ, xómá nigíꞌníi̱ ikhii̱n ne̱ne̱ xa̱bo̱ judío̱. <verse eid="1TH 2:14" /><verse number="15" style="v" sid="1TH 2:15" />Ikhiin máꞌ xa̱bo̱ tsúꞌkhue̱n ni̱xíya̱a̱ Táta̱ Jesús, jamí ni̱radíi̱n tsí ni̱rawíjnga̱a ajngóo Ana̱ꞌlóꞌ, xómáꞌ ikháanꞌxo̱ꞌ ni̱xkawiáanꞌxo̱ꞌ ná xuajñúu̱. Tsíni̱gu̱u̱ꞌ Ana̱ꞌlóꞌ ini̱i̱, jamí nawajún-ꞌthúu̱n mbá xúgíin xa̱bo̱. <verse eid="1TH 2:15" /><verse number="16" style="v" sid="1TH 2:16" />Nu̱rikhaxo̱ꞌ kajngó mu̱xútha̱n-ráꞌaxo̱ꞌ ajngóo Ana̱ꞌlóꞌ ná inúú xa̱bo̱ tsí ra̱ꞌkháa judío̱ ñajúún, kajngó ma̱jáwíi̱n mangii̱n. Rí xkuaꞌnii ini̱i̱ nune̱-ra̱ꞌmáa̱ máꞌ xúꞌkhue̱n aꞌkhúu̱n, ikhaa jngó phú mba̱a̱ jamínu̱ꞌ rí nixuꞌma Ana̱ꞌlóꞌ ni̱dri̱guíi̱.<verse eid="1TH 2:16" /></para>
  <para style="s">Páblo̱ naꞌne a̱kui̱in mba̱ꞌñúú xa̱bo̱ Tesalóni̱ka̱</para>
  <para style="p">
    <verse number="17" style="v" sid="1TH 2:17" />A̱ngui̱nꞌ, maske máꞌ xúge̱ꞌ juwaxo̱ꞌ tsíngua̱ꞌ ná inalaꞌ mbá wátha̱ wáa mbiꞌi , jámba̱ miꞌtsú gíwa̱a̱n a̱kia̱nꞌxo̱ꞌ e̱ne̱laꞌ, jamí phú naꞌne a̱kia̱nꞌxo̱ꞌ rí mu̱ꞌguáxo̱ꞌ gúya̱ꞌlaꞌ. <verse eid="1TH 2:17" /><verse number="18" style="v" sid="1TH 2:18" />Ikhaa jngó ne̱ne̱xo̱ꞌ rí mu̱ꞌguáxo̱ꞌ gúya̱ꞌlaꞌ. Jamí ikhúúnꞌ, Páblo̱, mbaꞌa nothon ne̱ne̱ rí ma̱ꞌgálo̱ꞌ, i̱ndo̱ó máꞌ numuu rí Satanás ni̱we̱je̱-tha̱nꞌxo̱ꞌ. <verse eid="1TH 2:18" /><verse number="19" style="v" sid="1TH 2:19" />Numuu rí ná inuu Tátiálóꞌ Jesukrísto̱ ído̱ rí ma̱ꞌkha̱a, náá lá rí ñajuun rí naꞌne jañii a̱kia̱nꞌxo̱ꞌ ga̱jma̱á numuu o rí naꞌne rí phú ma̱ꞌdxu a̱kia̱nꞌxo̱ꞌ, o gamaku rí ni̱drígúxo̱ꞌ rí phú nu̱xu̱xí-mijnáxo̱ꞌ ga̱jma̱á numuu rá. Á ra̱ꞌkhá ikháanꞌlaꞌ ñajwanlaꞌ rúꞌkhue̱n dxe̱ꞌ. <verse eid="1TH 2:19" /><verse number="20" style="v" sid="1TH 2:20" />Gakon máꞌ rí ikháanꞌlaꞌ ñajwanlaꞌ tsí phú nu̱xu̱xí-mijnáxo̱ꞌ ga̱jma̱á numúú jamí tsí nune̱ rí phú ma̱ꞌdxu a̱kia̱nꞌxo̱ꞌ.<verse eid="1TH 2:20" /></para>
  <chapter eid="1TH 2" />
  <chapter number="3" style="c" sid="1TH 3" />
  <para style="s">Nixuꞌmaa Timotéo̱ ma̱ꞌga ná Tesalóni̱ka̱</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 3:1" />Ikhaa jngó, ído̱ rí nátáꞌngo̱o̱ a̱kia̱nꞌxo̱ꞌ numuu rí tsídxawíínxo̱ꞌ xáne juwalaꞌ, a̱ꞌkhue̱n niguáꞌdááxo̱ꞌ awan rí ma̱nguanáxo̱ꞌ i̱ndo̱ó máꞌ ikháanꞌxo̱ꞌ ná Aténa̱s, <verse eid="1TH 3:1" /><verse number="2" style="v" sid="1TH 3:2" />jamí ni̱xu̱ꞌmáaxo̱ꞌ dxájwalóꞌ Timotéo̱ ma̱ꞌga gáꞌyalaꞌ. Ikhaa̱ ñajuu̱n yumbée Ana̱ꞌlóꞌ tsí nambáyáxo̱ꞌ rí nu̱tha̱n-ráꞌaxo̱ꞌ ajngáa máján ga̱jma̱á numuu Krísto̱. Nu̱xu̱ꞌmáa̱xo̱ꞌ kajngó ma̱ꞌnii̱ rí ma̱wajún-gúkuálaꞌ jamí maꞌthán-máꞌánlaꞌ ga̱jma̱á numuu rí wéje̱ máꞌ a̱kia̱nꞌlaꞌ ju̱ya̱á. <verse eid="1TH 3:2" /><verse number="3" style="v" sid="1TH 3:3" />Kajngó nimbáa ma̱xáwabaa gáꞌne gajmá rí nakua-ranújngalaꞌ, numuu rí ikháanꞌlaꞌ máꞌ ndu̱ya̱álaꞌ rí wéje̱ máꞌ rí mu̱ꞌgua̱-ranújngalóꞌ gajmá rúꞌkhue̱n. <verse eid="1TH 3:3" /><verse number="4" style="v" sid="1TH 3:4" />Nákhí juwaxo̱ꞌ ga̱jma̱á nindxa̱ꞌlaꞌ, wapha máꞌ ni̱tha̱nꞌlaꞌxo̱ꞌ rí ma̱nújngalóꞌ ná awúun gajmá. Jamí xkuaꞌnii máꞌ niríga̱, xómá rí gída̱ꞌ máꞌ idxa̱ꞌlaꞌ. <verse eid="1TH 3:4" /><verse number="5" style="v" sid="1TH 3:5" />Ikhaa numuu rúꞌkhue̱n, ikhúúnꞌ mangúúnꞌ nátáꞌngo̱o̱ a̱kui̱nꞌ rí ma̱gúꞌthu̱u̱n xóó, ikhaa jngó ni̱xu̱ꞌmáa Timotéo̱ kajngó maraxi̱i̱ ga̱jma̱á numuu rí wéje̱ a̱kia̱nꞌlaꞌ ná inuu Ana̱ꞌlóꞌ. Ra̱ꞌkhá ma̱ꞌne rí tsí ra̱májáan ni̱ꞌngo̱o̱ neꞌne-rájáanꞌlaꞌ, jamí ñajun rí ne̱ne̱xo̱ꞌ ga̱jma̱á nindxa̱ꞌlaꞌ ma̱ꞌne rí nda̱a̱ mbá jayu numuu ne̱.<verse eid="1TH 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TH 3:6" />Jamí ído̱ ni̱ꞌkha̱a Timotéo̱ inaxo̱ꞌ rí ni̱ke̱e̱ gáꞌyalaꞌ, phú máján ajngáa rí niꞌthánxo̱ꞌ ga̱jma̱á numuu rí wéje̱ a̱kia̱nꞌlaꞌ ná inuu Ana̱ꞌlóꞌ jamí rí phú nandalaꞌ ju̱ya̱-mijnálaꞌ. Xúꞌkhue̱n máꞌ niꞌthánxo̱ꞌ rí jámba̱ miꞌtsú gíwa̱a̱n a̱kia̱nꞌlaꞌ e̱ne̱xo̱ꞌ, jamí rí phú naꞌne a̱kia̱nꞌlaꞌ rí mbu̱ya̱ꞌxo̱ꞌ, xómá rí ikháanꞌxo̱ꞌ phú naꞌne a̱kia̱nꞌxo̱ꞌ mbu̱ya̱ꞌlaꞌ. <verse eid="1TH 3:6" /><verse number="7" style="v" sid="1TH 3:7" />Ikhaa numuu rúꞌkhue̱n, a̱ngui̱nꞌ, maske máꞌ juwaxo̱ꞌ nu̱míni̱í jamí juwaxo̱ꞌ gaꞌkho̱, ikháanꞌlaꞌ phú nu̱xna̱alaꞌ tsiakhe̱ a̱kia̱nꞌxo̱ꞌ numuu rí kuajún-gúkuálaꞌ ná inuu Ana̱ꞌlóꞌ ga̱jma̱á majñu̱u̱ rí wéje̱ a̱kia̱nꞌlaꞌ ná inuu̱. <verse eid="1TH 3:7" /><verse number="8" style="v" sid="1TH 3:8" />Ído̱ ni̱dxawíínxo̱ꞌ rí kuajún-gúkuálaꞌ ná inuu Táta̱, asndo ndiyáa xu̱u̱ꞌ a̱kia̱nꞌxo̱ꞌ. <verse eid="1TH 3:8" /><verse number="9" style="v" sid="1TH 3:9" />Ikhaa jngó, ído̱ naguáꞌnúxo̱ꞌ ná inuu Ana̱ꞌlóꞌ, ni tsíꞌngo̱o̱ ajngáxo̱ꞌ rí mu̱rígu̱uxo̱ꞌ gamaku ná inuu̱ ga̱jma̱á numalaꞌ, ga̱jma̱á numuu rí nadxu mi̱ndaꞌkho a̱kia̱nꞌxo̱ꞌ e̱ne̱laꞌ. <verse eid="1TH 3:9" /><verse number="10" style="v" sid="1TH 3:10" />Mbiꞌíí mbruꞌwíín nu̱tha̱n-jáñííxo̱ꞌ Ana̱ꞌlóꞌ ga̱jma̱á numalaꞌ, rí ma̱ꞌnii̱ rí mbu̱ꞌya-mijnálóꞌ mbu̱júꞌ, kajngó mu̱ne̱-gáxi̱íxo̱ꞌ rí ndaꞌyóo ma̱ꞌne káxe̱ rí wéje̱ a̱kia̱nꞌlaꞌ ná inuu Ana̱ꞌlóꞌ.<verse eid="1TH 3:10" /></para>
  <para style="s">Páblo̱ naꞌthán-jáñuu Ana̱ꞌlóꞌ ga̱jma̱á numúú tsí nanimbu̱únꞌ juyáá Jesús</para>
  <para style="p">
    <verse number="11" style="v" sid="1TH 3:11" />Ana̱ꞌlóꞌ Mikhuíí jamí Tátiálóꞌ Jesukrísto̱ gúni̱i̱ rí mu̱ꞌguáxo̱ꞌ gúya̱ꞌlaꞌ. <verse eid="1TH 3:11" /><verse number="12" style="v" sid="1TH 3:12" />Xúꞌkhue̱n máꞌ nu̱tha̱n-jáñííxo̱ꞌ Táta̱ rí ikhaa̱ gáꞌnii̱ rí ma̱gaja̱a̱ rí nandalaꞌ ju̱ya̱-mijnálaꞌ, jamí ma̱gaja̱a̱ rí nandalaꞌ ju̱ñu̱ú mbá xúgíin xa̱bo̱ mangaa, xómá rí ikháanꞌxo̱ꞌ nandaxo̱ꞌ ju̱ya̱ꞌlaꞌ ikháanꞌlaꞌ mangaa. <verse eid="1TH 3:12" /><verse number="13" style="v" sid="1TH 3:13" />Mangaa máꞌ nu̱tha̱n-jáñííxo̱ꞌ Ana̱ꞌlóꞌ rí maxnálaꞌ tsiakhe̱ kajngó ma̱wajún-gúkuálaꞌ, xúꞌkhue̱n máꞌ rí ma̱xáríga̱ nimbá rí ra̱máján mi̱ꞌthán ga̱jma̱á numalaꞌ, jamí rí jaꞌwáanꞌlaꞌ gáꞌne ná inuu Ana̱ꞌlóꞌ Mikhuíí, ído̱ rí ma̱ꞌkha̱a Tátiálóꞌ Jesukrísto̱ gajmíí mbá xúgíin xa̱bi̱i.<verse eid="1TH 3:13" /></para>
  <chapter eid="1TH 3" />
  <chapter number="4" style="c" sid="1TH 4" />
  <para style="s">Xáne jaꞌyoo ma̱juwalóꞌ ná inuu Ana̱ꞌlóꞌ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 4:1" />Rí xúge̱ꞌ rá, a̱ngui̱nꞌ, ríga̱ i̱mba̱ rí nandaxo̱ꞌ mu̱tha̱nꞌlaꞌ: phú nu̱tha̱n-jáñalaꞌxo̱ꞌ jamí nu̱nda̱ꞌa̱ꞌlaꞌxo̱ꞌ ga̱jma̱á numuu Táta̱ Jesús, rí ga̱juwalaꞌ ná inuu Ana̱ꞌlóꞌ xómá jaꞌyoo jamí gu̱ne̱laꞌ rí nandoo̱, xómá rí ni̱ma̱ñalaꞌ ga̱jma̱á majña̱ꞌxo̱ꞌ ikháanꞌxo̱ꞌ. Nu̱ne̱laꞌ máꞌ rúꞌkhue̱n jamí gu̱ne̱laꞌ i̱tha̱án xóó. <verse eid="1TH 4:1" /><verse number="2" style="v" sid="1TH 4:2" />Numuu rí ikháanꞌlaꞌ nu̱ne̱-nuwiinlaꞌ máꞌ rí ni̱sngálaꞌxo̱ꞌ ga̱jma̱á numuu Táta̱ Jesús. <verse eid="1TH 4:2" /><verse number="3" style="v" sid="1TH 4:3" />Numuu rí Ana̱ꞌlóꞌ nandoo rí ma̱ꞌne-jaꞌwáanꞌlaꞌ, rí mu̱xúba̱ꞌ gajmiálaꞌ xa̱bo̱ tsí túya̱a̱laꞌ. <verse eid="1TH 4:3" /><verse number="4" style="v" sid="1TH 4:4" />Mbámbáa tsí ikháanꞌlaꞌ ga̱ma̱ñuu ma̱xtáa jaꞌwu ga̱jma̱á a̱ꞌgui̱i jamí gaya-makuu̱. <verse eid="1TH 4:4" /><verse number="5" style="v" sid="1TH 4:5" />Ra̱ꞌkhá rí ma̱juwalaꞌ mu̱ne̱laꞌ rí xkawe̱ꞌ mi̱ndaꞌkho nandoo xuyalaꞌ, xómá nune̱ xa̱bo̱ tsí tsíne̱-nuwiin Ana̱ꞌlóꞌ. <verse eid="1TH 4:5" /><verse number="6" style="v" sid="1TH 4:6" />Jamí nimbáa ma̱xáꞌne-ñawúun ni máꞌ ma̱xáꞌne-nduwaa dxájuu ga̱jma̱á numuu rúꞌkhue̱n. Numuu rí Táta̱ naꞌne rí ma̱grui̱gú mba̱a̱ jamínu̱ꞌ xa̱bo̱ tsí naꞌne aꞌkhán rúꞌkhue̱n, xómá rí ikháanꞌxo̱ꞌ ni̱tha̱nꞌlaꞌ máꞌ mbá jaꞌwu nákhí wapha. <verse eid="1TH 4:6" /><verse number="7" style="v" sid="1TH 4:7" />Numuu rí tándxaꞌwá-ri̱ñáaꞌlóꞌ Ana̱ꞌlóꞌ rí ma̱juwalóꞌ ná awúun rí xkawe̱ꞌ, rí nindxaꞌwá-ri̱ñáaꞌlóꞌ rí ma̱ꞌga-ra̱gu̱ma-jaꞌwáanꞌlóꞌ. <verse eid="1TH 4:7" /><verse number="8" style="v" sid="1TH 4:8" />Ikhaa jngó, xa̱bo̱ tsí na̱nguá iyoo gádxawuun gisngáá ríge̱ꞌ, ra̱ꞌkhá máꞌ ajngóo xa̱bo̱ numbaa tsíyoo̱ gádxawuu̱n, rí tsíyoo̱ gádxawuu̱n ajngóo Ana̱ꞌlóꞌ, tsí nixniálóꞌ Xu̱u̱ꞌ kajngó ma̱xtáa ga̱jma̱á nindxa̱ꞌlóꞌ.<note caller="+" style="f"><char style="fr" closed="false">4.8 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu rí naꞌthán: «tsí nixniálaꞌ Xu̱u̱ꞌ kajngó ma̱xtáa ga̱jma̱á nindxa̱ꞌlaꞌ».</char></note><verse eid="1TH 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 4:9" />Xómáꞌ rí jaꞌyoo rí ma̱galóꞌ juꞌya-mijnálóꞌ rá, tsíꞌyóo máꞌ rí mu̱tháánxo̱ꞌ ga̱jma̱á numuu rúꞌkhue̱n, numuu rí jmína̱a̱ꞌ máꞌ Ana̱ꞌlóꞌ niꞌsngálaꞌ ikháanꞌlaꞌ rí ma̱galaꞌ ju̱ya̱-mijnálaꞌ. <verse eid="1TH 4:9" /><verse number="10" style="v" sid="1TH 4:10" />Jamí mangaa máꞌ nandalaꞌ ju̱ñu̱ú mbá xúgíin a̱ngia̱nꞌlóꞌ tsí júwa̱ꞌ ná numbaa Masedónia̱ a̱ꞌkhue̱n. I̱ndo̱ó máꞌ numuu rí nu̱tha̱n-jáñalaꞌxo̱ꞌ, a̱ngui̱nꞌ, rí ga̱galaꞌ i̱tha̱án xóó ju̱ñúu̱. <verse eid="1TH 4:10" /><verse number="11" style="v" sid="1TH 4:11" />Gu̱ne̱laꞌ rí ma̱juwalaꞌ tsímáá gajmiálaꞌ mbá xúgíin xa̱bo̱. Ga̱juwalaꞌ-ru̱ne̱ rí jaꞌyalaꞌ mu̱ne̱, jamí gu̱ñajunlaꞌ ga̱jma̱á ñawánlaꞌ xómá rí ni̱xna̱-ñájwanlaꞌxo̱ꞌ. <verse eid="1TH 4:11" /><verse number="12" style="v" sid="1TH 4:12" />A̱ꞌkhue̱n rí xa̱bo̱ tsí tsíne̱-nuwiin Ana̱ꞌlóꞌ mbuya-makualaꞌ, jamí ma̱xáꞌyóo rí ma̱mbu̱jmalaꞌ ná inuu nimbáa xa̱bo̱.<verse eid="1TH 4:12" /></para>
  <para style="s">Mbiꞌi rí ma̱ꞌkha̱a Táta̱</para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 4:13" />A̱ngui̱nꞌ, nandaxo̱ꞌ rí ma̱gi̱da̱ꞌ mújúun idxa̱ꞌlaꞌ, dí gáꞌne ga̱jma̱á numúú a̱ngia̱nꞌlóꞌ tsí nijáñúú máꞌ, kajngó ma̱xáꞌdaa a̱kia̱nꞌlaꞌ xómá i̱ꞌwíin xa̱bo̱ tsí na̱nguá guáꞌdáá rí ma̱guáꞌthi̱ín ga̱jma̱á mbá jañii a̱kui̱ín. <verse eid="1TH 4:13" /><verse number="14" style="v" sid="1TH 4:14" />Numuu rí xómá rí nanimba̱ꞌlóꞌ rí Jesús nijáñuu jamí ndiyáa mbiꞌyuu, xkuaꞌnii máꞌ nanimba̱ꞌlóꞌ rí Ana̱ꞌlóꞌ ma̱ꞌkha̱ jagu̱un ga̱jma̱á nindxu̱u̱ Jesús tsí nanimbu̱únꞌ juyáa̱ nákhí nijáñúú. <verse eid="1TH 4:14" /><verse number="15" style="v" sid="1TH 4:15" />Ikhaa jngó, ikháanꞌxo̱ꞌ nu̱tha̱nꞌlaꞌ ríge̱ꞌ, mbá rí jmína̱a̱ꞌ máꞌ Táta̱ niꞌthán: Ikháánꞌlóꞌ tsáánꞌ xóó juwa nduꞌyalóꞌ asndo mbiꞌi rí ma̱ꞌkha̱a Táta̱, mu̱xúꞌgua̱ gináálóꞌ gúxkamaa̱lóꞌ, rí ginuu a̱ngia̱nꞌlóꞌ tsí nijáñúú máꞌ magóó gúxkamaa̱. <verse eid="1TH 4:15" /><verse number="16" style="v" sid="1TH 4:16" />Numuu rí jmína̱a̱ꞌ máꞌ Táta̱ ma̱ga̱taa ná mikhuíí ga̱jma̱á mbá a̱ꞌwá rí naꞌthán-ñájun, ga̱jma̱á a̱ꞌwóo mbáa ánje̱l tsí phú mba̱a̱ ski̱yu̱u̱ꞌ, jamí ga̱jma̱á a̱ꞌwóo e̱ꞌmbi drígo̱o̱ Ana̱ꞌlóꞌ. A̱ꞌkhue̱n rí tsí nanimbu̱únꞌ juyáá Krísto̱ nákhí nijáñúú, mbuya̱a mbiꞌñúú ginuu. <verse eid="1TH 4:16" /><verse number="17" style="v" sid="1TH 4:17" />A̱ꞌkhue̱n rí tsáánꞌ juwa nduꞌyalóꞌ xóó, mbá nacha̱ ma̱ꞌga jiꞌdáanꞌlóꞌ ná du̱u̱n ga̱jma̱á nindxúu̱n ikhii̱n, kajngó mu̱dríguíilóꞌ Táta̱ ná inuu gíñá. A̱ꞌkhue̱n rí ma̱juwalóꞌ jámuu mbiꞌi ga̱jma̱á nindxu̱u̱ Táta̱. <verse eid="1TH 4:17" /><verse number="18" style="v" sid="1TH 4:18" />Ikhaa jngó, gu̱xna̱-míjnálaꞌ tsiakhe̱ ga̱jma̱á ajngáa rúꞌkhue̱n.<verse eid="1TH 4:18" /></para>
  <chapter eid="1TH 4" />
  <chapter number="5" style="c" sid="1TH 5" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 5:1" />Xómáꞌ rí ga̱jma̱á numuu náá mbiꞌi jamí nguáná phú ma̱ri̱gá mbá xúgíí rúꞌkhue̱n rá, a̱ngui̱nꞌ, tsíꞌyóo máꞌ rí mu̱tháánxo̱ꞌ ga̱jma̱á numuu rúꞌkhue̱n. <verse eid="1TH 5:1" /><verse number="2" style="v" sid="1TH 5:2" />Numuu rí ikháanꞌlaꞌ ndu̱ya̱á májánlaꞌ rí Táta̱ ma̱ꞌkha̱a mbá mbiꞌi rí ndawa̱a̱ tsí i̱ju̱mu̱u̱, xómá na̱ꞌkha̱ mbáa ku̱ꞌwá awúun mbroꞌon. <verse eid="1TH 5:2" /><verse number="3" style="v" sid="1TH 5:3" />Ído̱ rí muthan xa̱bo̱: «Mbá xúgíí tsímáá kri̱ga̱ jamí nda̱a̱ ngamí rá», a̱ꞌkhue̱n rí nda̱a̱ ajngóo ma̱mbá-ri̱gii̱n, xómá rí nda̱a̱ ajngóo naxnúu gaꞌkho̱ a̱ꞌgo̱ tsí jago̱-éda. Jamí ma̱xáxóo ma̱jáwíi̱n inuu jamínu̱ꞌ rí ma̱ꞌkha̱ mu̱dríguíi̱.<verse eid="1TH 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1TH 5:4" />Xómáꞌ ikháanꞌlaꞌ rá, a̱ngui̱nꞌ, nánguá máꞌ juwalaꞌ ná mijína, kajngó ma̱ꞌne rí nda̱a̱ ajngóo gáxkama-ri̱gáanꞌlaꞌ mbiꞌi rí ma̱ꞌkha̱a Táta̱, xómá eꞌne rí nda̱a̱ ajngóo na̱ꞌkha̱ ku̱ꞌwá. <verse eid="1TH 5:4" /><verse number="5" style="v" sid="1TH 5:5" />Numuu rí mbá xúgiáanꞌ ikháanꞌlaꞌ nu̱ne̱laꞌ rí máján jamí nu̱ne̱laꞌ rí na̱ni̱gu̱u̱ꞌ Ana̱ꞌlóꞌ, rí jaꞌnii xómá rí juwalaꞌ ná nambiꞌi agu. Tsíꞌne̱lóꞌ rí xkawe̱ꞌ ni máꞌ rí tsíni̱gu̱u̱ꞌ Ana̱ꞌlóꞌ, rí jaꞌnii xómá rí juwalóꞌ ná mijína. <verse eid="1TH 5:5" /><verse number="6" style="v" sid="1TH 5:6" />Ikhaa jngó, mu̱xúꞌnulóꞌ xómá rí nune̱ i̱ꞌwíin xa̱bo̱, rí ga̱juwalóꞌ xawi jamí ga̱xa̱ba̱ꞌlóꞌ. <verse eid="1TH 5:6" /><verse number="7" style="v" sid="1TH 5:7" />Numuu rí xa̱bo̱ tsí nunu, mbroꞌon nunii̱. Jamí xa̱bo̱ tsí naꞌwa̱a̱n iya najnga̱a̱ rá, mbroꞌon nune̱-majnga̱-mijnée̱. <verse eid="1TH 5:7" /><verse number="8" style="v" sid="1TH 5:8" />Xómáꞌ ikháánꞌlóꞌ, tsáánꞌ juwalóꞌ ná nambiꞌi agu rá, ga̱ꞌne rí na̱xa̱ba̱ꞌlóꞌ. Numuu rí wéje̱ máꞌ a̱kia̱nꞌlóꞌ ná inuu Ana̱ꞌlóꞌ jamí nandalóꞌ máꞌ juꞌñúú xa̱bo̱, rí ñajuun xómá ajwa̱nꞌ rí katajmuu ná xo̱xta̱ꞌlóꞌ jamí tsu̱da̱ꞌlóꞌ. Mangaa máꞌ guáꞌthi̱ínlóꞌ ga̱jma̱á mbá jañii a̱kia̱nꞌlóꞌ rí ma̱jríñáaꞌlóꞌ, rí ñajuun xómá xtéde̱ ajwa̱nꞌ rí nambáyúu idxa̱ꞌlóꞌ.<verse eid="1TH 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 5:9" />Numuu rí Ana̱ꞌlóꞌ táraꞌwáa̱nꞌlóꞌ kajngó ma̱ꞌnii̱ rí mu̱drígúlóꞌ jamínu̱ꞌ, rí niraꞌwáa̱nꞌlóꞌ kajngó ma̱jríñáaꞌlóꞌ ga̱jma̱á majñu̱u̱ rí neꞌne Tátiálóꞌ Jesukrísto̱. <verse eid="1TH 5:9" /><verse number="10" style="v" sid="1TH 5:10" />Numuu rí ikhaa̱ nijáñuu̱ ga̱jma̱á numalóꞌ, kajngó ma̱goo ma̱juwalóꞌ jámuu ga̱jma̱á nindxu̱u̱. Tsíꞌñuu máꞌ xí xóó juwa nduꞌyalóꞌ o nijáñalóꞌ máꞌ ído̱ gáthangaa̱. <verse eid="1TH 5:10" /><verse number="11" style="v" sid="1TH 5:11" />Ikhaa jngó, gu̱xna̱-míjnálaꞌ tsiakhe̱ jamí gu̱mbáyú-mijnálaꞌ rí ma̱wajúnlaꞌ xa̱ꞌ, xómá rí nu̱ne̱laꞌ máꞌ.<verse eid="1TH 5:11" /></para>
  <para style="s">Páblo̱ naꞌthán-múꞌúún tsí nanimbu̱únꞌ juyáá Jesús</para>
  <para style="p">
    <verse number="12" style="v" sid="1TH 5:12" />A̱ngui̱nꞌ, nu̱tha̱n-jáñalaꞌxo̱ꞌ rí gu̱ya̱-makúúnlaꞌ xa̱bo̱ ede̱ tsí júwa̱ꞌ nu̱ñajun gakhe̱ ná majña̱ꞌlaꞌ. Ikhii̱n nduye̱e̱ ikhalaꞌ jamí nuthan-maꞌánlaꞌ. <verse eid="1TH 5:12" /><verse number="13" style="v" sid="1TH 5:13" />Ikháanꞌlaꞌ gíꞌmaa mu̱ndxa̱ꞌwa̱-mijnálaꞌ rí ikhii̱n phú gíꞌdoo numúu̱ jamí phú ma̱galaꞌ ju̱ñúu̱ ga̱jma̱á numuu ñajun rí nuni̱i̱. Jamí ga̱juwalaꞌ tsímáá ju̱ya̱-mijnálaꞌ. <verse eid="1TH 5:13" /><verse number="14" style="v" sid="1TH 5:14" />A̱ngui̱nꞌ, mangaa máꞌ nu̱tha̱n-jáñalaꞌxo̱ꞌ rí gu̱xprígúúnlaꞌ tsí trigi̱in naskúún, gu̱xnu̱úlaꞌ tsiakhe̱ tsí na̱nguá jañii a̱kui̱ín, xúꞌkhue̱n máꞌ gu̱mbáñúúlaꞌ tsí wabiin, jamí mba̱a̱ a̱kia̱nꞌlaꞌ gáꞌne ga̱jma̱á nindxu̱ún mbá xúgíin. <verse eid="1TH 5:14" /><verse number="15" style="v" sid="1TH 5:15" />A̱gu̱ya̱álaꞌ rí nimbáa ma̱xárthanga̱a rí xkawe̱ꞌ ná inuu i̱mba̱a̱ꞌ rí xkawe̱ꞌ niꞌñuu̱. A̱ꞌkhue̱n gakon, jámba̱ miꞌtsú gu̱ne̱-mijnálaꞌ rí máján, jamí gajmíí mbá xúgíin xa̱bo̱ mangaa.<verse eid="1TH 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1TH 5:16" />Ga̱juwalaꞌ gagi jámba̱ miꞌtsú. <verse eid="1TH 5:16" /><verse number="17" style="v" sid="1TH 5:17" />Gu̱tha̱n-jáñíílaꞌ máꞌ xúꞌkhue̱n Ana̱ꞌlóꞌ. <verse eid="1TH 5:17" /><verse number="18" style="v" sid="1TH 5:18" />Gu̱rígu̱ulaꞌ gamaku inuu Ana̱ꞌlóꞌ ga̱jma̱á numuu mbá xúgíí, numuu rí rúꞌkhue̱n ñajuun rí nandoo Ana̱ꞌlóꞌ rí mu̱ne̱laꞌ, tsáanꞌ xa̱bi̱i Krísto̱ Jesús ñajwanlaꞌ.<verse eid="1TH 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1TH 5:19" />Mu̱xúsndui̱ꞌyíílaꞌ aguu Xu̱u̱ꞌ Ana̱ꞌlóꞌ ná xo̱xta̱ꞌlaꞌ. <verse eid="1TH 5:19" /><verse number="20" style="v" sid="1TH 5:20" />Gu̱ꞌgíi idxa̱ꞌlaꞌ rí mu̱dxawíínlaꞌ ajngáa rí nagájnanga̱a ná inalaꞌ. <verse eid="1TH 5:20" /><verse number="21" style="v" sid="1TH 5:21" />Gu̱ndxa̱ꞌwa̱-mijná májánlaꞌ ga̱jma̱á numuu mbá xúgíí, jamí gu̱drígúlaꞌ i̱ndo̱ó máꞌ rí máján. <verse eid="1TH 5:21" /><verse number="22" style="v" sid="1TH 5:22" />Gu̱ne̱-janíí-mijnálaꞌ inuu mbá xúgíí inii rí xkawe̱ꞌ.<verse eid="1TH 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1TH 5:23" />Jamí jmína̱a̱ꞌ máꞌ Ana̱ꞌlóꞌ tsí naꞌne rí ma̱juwalóꞌ tsímáá, gáꞌne-jaꞌwáanꞌlaꞌ mbá káxáanꞌlaꞌ jayu. Jamí ikhaa̱ máꞌ gáyánga̱wáanꞌlaꞌ mbá xa̱biáanꞌlaꞌ jayu: a̱kia̱nꞌlaꞌ, nímia̱ꞌlaꞌ jamí xuyalaꞌ. A̱ꞌkhue̱n rí ma̱xáríga̱ nimbá rí ra̱máján mi̱ꞌthán ga̱jma̱á numalaꞌ, ído̱ gáꞌkha̱a Tátiálóꞌ Jesukrísto̱. <verse eid="1TH 5:23" /><verse number="24" style="v" sid="1TH 5:24" />Ana̱ꞌlóꞌ tsí nandxaꞌwálaꞌ phú jmbii̱, jamí ikhaa̱ máꞌ ma̱ꞌne-mbánuu̱ mbá xúgíí rúꞌkhue̱n.<verse eid="1TH 5:24" /></para>
  <para style="s">Naꞌthángoo Páblo̱</para>
  <para style="p">
    <verse number="25" style="v" sid="1TH 5:25" />A̱ngui̱nꞌ, gu̱tha̱n-jáñíílaꞌ Ana̱ꞌlóꞌ ga̱jma̱á numaxo̱ꞌ.<verse eid="1TH 5:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1TH 5:26" />Gu̱ra̱xi̱inlaꞌ mbá xúgíin a̱ngia̱nꞌlóꞌ ga̱jma̱á gamaku.<verse eid="1TH 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1TH 5:27" />Na̱xna̱-ñájwanlaꞌ ga̱jma̱á ski̱yu̱u̱ꞌ ajngóo Táta̱ rí gúꞌdo̱ꞌlo̱ꞌ, rí mu̱raxnuulaꞌ i̱yi̱i̱ꞌ ríge̱ꞌ ná inúú mbá xúgíin a̱ngia̱nꞌlóꞌ.<verse eid="1TH 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1TH 5:28" />Tátiálóꞌ Jesukrísto̱ gáꞌne-tsakun-rámáaꞌlaꞌ mbá xúgiáanꞌlaꞌ, a̱ngui̱nꞌ. Xkuaꞌnii gáꞌne.<note caller="+" style="f"><char style="fr" closed="false">5.28 </char><char style="ft" closed="false">Ríga̱ mbá tikhu i̱yi̱i̱ꞌ griégo̱ rí wayuu ná na̱nguá i̱ꞌkha̱ ajngáa ríge̱ꞌ: «Xkuaꞌnii gáꞌne».</char></note><verse eid="1TH 5:28" /></para>
  <chapter eid="1TH 5" />
</usx>